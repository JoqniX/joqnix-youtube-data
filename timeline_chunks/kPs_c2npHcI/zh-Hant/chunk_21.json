[{"type": "subtitle", "time": 1263.27, "timestamp": "00:21:03", "text": "也打算"}, {"type": "subtitle", "time": 1279.75, "timestamp": "00:21:19", "text": "這麼做。  轉換為代"}, {"type": "subtitle", "time": 1284.07, "timestamp": "00:21:24", "text": "幣。將其設為選單 V4。  V4。  呃，疊加層。覆蓋。  呃，疊加層。用於疊加層的疊加選單。這樣就足夠了。請點擊此處。"}, {"type": "subtitle", "time": 1301.029, "timestamp": "00:21:41", "text": "放在這裡。"}, {"type": "subtitle", "time": 1303.029, "timestamp": "00:21:43", "text": "選單 V4 疊加層。  是的。  嗯，我們可以去這裡，然後"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "我們可以"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "清除一種樣式。  呃，等等，我選的對嗎？  問號。好的，我想我做到了。  等等，我其實還蠻喜歡"}]
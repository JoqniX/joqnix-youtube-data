[{"type": "subtitle", "time": 17105.11, "timestamp": "04:45:05", "text": "鑽石。  等等，等等。為什麼它看起來像鑽石？等等，什麼？不過，它算是"}, {"type": "subtitle", "time": 17111.75, "timestamp": "04:45:11", "text": "明星人物，所以沒關係。  我剛剛"}, {"type": "subtitle", "time": 17118.55, "timestamp": "04:45:18", "text": "意識到一件事。哦，我哦，是的。呃，我的……呃，我的王冠，我的意思是，嗯，我的頭上……元素有類似……嗯，是的，"}, {"type": "subtitle", "time": 17140.39, "timestamp": "04:45:40", "text": "四顆星在王冠上，我想我可以把它說在頭頂上。  我的"}, {"type": "subtitle", "time": 17147.43, "timestamp": "04:45:47", "text": "天哪。用滑鼠畫起來太痛苦了。  是的，它在那裡。呃，這不是要"}, {"type": "subtitle", "time": 17154.15, "timestamp": "04:45:54", "text": "分享罐子後面的東西"}, {"type": "chat", "time": 17159.027, "timestamp": "04:45:59", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "kimono"}]
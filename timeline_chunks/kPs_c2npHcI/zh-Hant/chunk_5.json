[{"type": "subtitle", "time": 306.07, "timestamp": "00:05:06", "text": "另外，我有一個很棒的想法，"}, {"type": "subtitle", "time": 309.11, "timestamp": "00:05:09", "text": "那"}, {"type": "subtitle", "time": 316.39, "timestamp": "00:05:16", "text": "就是，我想擁有自己的"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "待辦事項清單系統。"}, {"type": "subtitle", "time": 322.469, "timestamp": "00:05:22", "text": "好吧，聽我說完。聽我說完。"}, {"type": "subtitle", "time": 325.67, "timestamp": "00:05:25", "text": "好的，我想要一個類似"}, {"type": "subtitle", "time": 328.31, "timestamp": "00:05:28", "text": "待辦事項清單的系統。"}, {"type": "subtitle", "time": 332.71, "timestamp": "00:05:32", "text": "嗯，是的，我可以買一個"}, {"type": "subtitle", "time": 335.67, "timestamp": "00:05:35", "text": "免費的或付費的"}, {"type": "subtitle", "time": 337.27, "timestamp": "00:05:37", "text": "擴充程序，"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "對吧？但我更多的是"}, {"type": "subtitle", "time": 344.07, "timestamp": "00:05:44", "text": "從概念上考慮這麼做。"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "我當時的想法是更多地從 Notion 的角度來做，"}, {"type": "subtitle", "time": 350.629, "timestamp": "00:05:50", "text": "就像我已經可以"}, {"type": "subtitle", "time": 353.99, "timestamp": "00:05:53", "text": "在直播中顯示即時資訊、"}, {"type": "subtitle", "time": 356.23, "timestamp": "00:05:56", "text": "活動狀態和主題狀態一樣。"}, {"type": "subtitle", "time": 358.87, "timestamp": "00:05:58", "text": "是啊，我現在在想把直播內容加入待辦事項"}]
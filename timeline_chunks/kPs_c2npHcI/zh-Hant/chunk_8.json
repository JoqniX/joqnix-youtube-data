[{"type": "subtitle", "time": 481.51, "timestamp": "00:08:01", "text": "我會弄點吃的什麼的"}, {"type": "subtitle", "time": 483.35, "timestamp": "00:08:03", "text": "。  是的"}, {"type": "subtitle", "time": 486.07, "timestamp": "00:08:06", "text": "，就是這樣。  是的"}, {"type": "subtitle", "time": 489.029, "timestamp": "00:08:09", "text": "。今天又回來了。我們要做的事情，就像上次"}, {"type": "subtitle", "time": 493.67, "timestamp": "00:08:13", "text": "我來這裡的時候，"}, {"type": "subtitle", "time": 500.07, "timestamp": "00:08:20", "text": "我們做的，就是我唱歌的那個"}, {"type": "subtitle", "time": 501.99, "timestamp": "00:08:21", "text": "環節，對吧？那是昨天的事了。"}, {"type": "subtitle", "time": 504.55, "timestamp": "00:08:24", "text": "因此，昨天我們"}, {"type": "subtitle", "time": 507.189, "timestamp": "00:08:27", "text": "早上 6 點就完成了關於頁面的內容。"}, {"type": "subtitle", "time": 512.55, "timestamp": "00:08:32", "text": "嗯，就是這樣。第 120 天。"}, {"type": "subtitle", "time": 518.389, "timestamp": "00:08:38", "text": "120。我們當時正在躲在掩體後面做這件事。"}, {"type": "subtitle", "time": 520.389, "timestamp": "00:08:40", "text": "呃，我們做了大概8個小時，對"}, {"type": "subtitle", "time": 523.11, "timestamp": "00:08:43", "text": "吧？我們當時正在做關於"}, {"type": "subtitle", "time": 525.35, "timestamp": "00:08:45", "text": "頁面上的"}, {"type": "chat", "time": 530.022, "timestamp": "00:08:50", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "jhaaaaaaqx"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "那些東西。  所以今天"}]
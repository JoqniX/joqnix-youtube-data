[{"type": "subtitle", "time": 3138.71, "timestamp": "00:52:18", "text": "相似。那個人，也許她最喜歡的動漫就是那個。"}, {"type": "subtitle", "time": 3143.27, "timestamp": "00:52:23", "text": "誰知道呢？哦，fakun。我"}, {"type": "subtitle", "time": 3144.87, "timestamp": "00:52:24", "text": "見過這個人。哦，他們很受歡迎。很受歡迎。哦，天哪。她委託他做的。哇。不錯。不錯。天哪，太貴了。做"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "油管主播真的太貴了。雖然。超級"}, {"type": "subtitle", "time": 3165.03, "timestamp": "00:52:45", "text": "痛苦。[音樂]好吧。 about時，他們會看到所有完整的信息，但如果他們正在瀏覽我的網站，我"}]
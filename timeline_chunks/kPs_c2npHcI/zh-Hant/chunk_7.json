[{"type": "subtitle", "time": 421.83, "timestamp": "00:07:01", "text": "我把它寫下來。"}, {"type": "subtitle", "time": 433.67, "timestamp": "00:07:13", "text": "《住院醫師》"}, {"type": "subtitle", "time": 445.53, "timestamp": "00:07:25", "text": "不，不，這不是網站相關的東西。"}, {"type": "subtitle", "time": 446.79, "timestamp": "00:07:26", "text": "[音樂]"}, {"type": "subtitle", "time": 450.95, "timestamp": "00:07:30", "text": "我可以把它放在這裡。"}, {"type": "subtitle", "time": 458.629, "timestamp": "00:07:38", "text": "嗯，應該可行。"}, {"type": "subtitle", "time": 461.27, "timestamp": "00:07:41", "text": "我忘了買吃的。我"}, {"type": "subtitle", "time": 471.67, "timestamp": "00:07:51", "text": "我本來可以買到一些餅乾的。但"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "我去上廁所的時候沒問題。"}, {"type": "subtitle", "time": 478.629, "timestamp": "00:07:58", "text": "我們當然可以做到。  如果可以的話，"}]
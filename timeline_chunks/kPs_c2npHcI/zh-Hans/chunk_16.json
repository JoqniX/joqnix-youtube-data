[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "这样做最好的方法实际上是"}, {"type": "subtitle", "time": 966.55, "timestamp": "00:16:06", "text": "在这里放置一个菜单设计标识"}, {"type": "subtitle", "time": 969.99, "timestamp": "00:16:09", "text": "章节所以我们看看能不能把它做成这样"}, {"type": "subtitle", "time": 973.59, "timestamp": "00:16:13", "text": "菜单 V4"}, {"type": "subtitle", "time": 975.68, "timestamp": "00:16:15", "text": "V4 呃"}, {"type": "subtitle", "time": 978.639, "timestamp": "00:16:18", "text": "呃 触发按钮"}, {"type": "subtitle", "time": 987.269, "timestamp": "00:16:27", "text": "我们将以此命名。"}, {"type": "subtitle", "time": 990.23, "timestamp": "00:16:30", "text": "关闭它。我把它转换成……"}, {"type": "subtitle", "time": 991.749, "timestamp": "00:16:31", "text": "令牌"}, {"type": "subtitle", "time": 995.189, "timestamp": "00:16:35", "text": "把它放在我那边的按钮下面。"}, {"type": "subtitle", "time": 998.55, "timestamp": "00:16:38", "text": "好的。所以这意味着一切都将……"}, {"type": "subtitle", "time": 1002.79, "timestamp": "00:16:42", "text": "某种程度上是复制的。"}, {"type": "subtitle", "time": 1005.269, "timestamp": "00:16:45", "text": "是的。所有内容都将被复制。我们可以"}, {"type": "subtitle", "time": 1007.749, "timestamp": "00:16:47", "text": "呃，我们开始的时候，我们正在着手做"}, {"type": "subtitle", "time": 1011.11, "timestamp": "00:16:51", "text": "这。我们也可以通过以下方式做同样的事情"}, {"type": "subtitle", "time": 1013.269, "timestamp": "00:16:53", "text": "是的。嗯，我们可以。我们真的可以"}, {"type": "subtitle", "time": 1017.11, "timestamp": "00:16:57", "text": "开始按那个按钮。我们放"}]
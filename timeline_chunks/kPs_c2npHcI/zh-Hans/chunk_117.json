[{"type": "subtitle", "time": 7020.39, "timestamp": "01:57:00", "text": "他们正在制作页面。哦。"}, {"type": "subtitle", "time": 7022.55, "timestamp": "01:57:02", "text": "您的联系页面长什么样？"}, {"type": "subtitle", "time": 7024.709, "timestamp": "01:57:04", "text": "哦，它会从侧边栏弹出来。询问"}, {"type": "subtitle", "time": 7045.189, "timestamp": "01:57:25", "text": "这是喵喵在玩游戏。我无法加入"}, {"type": "subtitle", "time": 7046.709, "timestamp": "01:57:26", "text": "你。"}, {"type": "subtitle", "time": 7055.75, "timestamp": "01:57:35", "text": "滚动。我喜欢那个卷轴装置，"}, {"type": "subtitle", "time": 7063.35, "timestamp": "01:57:43", "text": "她的标志太酷了。现在，它就像一个"}, {"type": "subtitle", "time": 7067.27, "timestamp": "01:57:47", "text": "手写体标志。你看，她的标志是如此"}, {"type": "subtitle", "time": 7069.75, "timestamp": "01:57:49", "text": "凉爽的。"}]
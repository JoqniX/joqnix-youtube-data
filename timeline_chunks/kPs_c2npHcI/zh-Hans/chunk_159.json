[{"type": "subtitle", "time": 9542.469, "timestamp": "02:39:02", "text": "是的，我会把所有事情都放在第一位。"}, {"type": "subtitle", "time": 9544.55, "timestamp": "02:39:04", "text": "然后我们可以检查哪个有效，"}, {"type": "subtitle", "time": 9574.15, "timestamp": "02:39:34", "text": "或许我会让它崩溃。"}, {"type": "subtitle", "time": 9576.469, "timestamp": "02:39:36", "text": "可折叠的"}, {"type": "subtitle", "time": 9578.469, "timestamp": "02:39:38", "text": "或许是这个东西。我不知道。但"}, {"type": "subtitle", "time": 9582.27, "timestamp": "02:39:42", "text": "是啊，这家伙……"}, {"type": "subtitle", "time": 9589.03, "timestamp": "02:39:49", "text": "稍后会进行格式化。不用担心。患病的"}, {"type": "subtitle", "time": 9592.07, "timestamp": "02:39:52", "text": "把呃提高到"}, {"type": "subtitle", "time": 9597.83, "timestamp": "02:39:57", "text": "2021年21日。然后我就……"}, {"type": "subtitle", "time": 9599.83, "timestamp": "02:39:59", "text": "21"}]
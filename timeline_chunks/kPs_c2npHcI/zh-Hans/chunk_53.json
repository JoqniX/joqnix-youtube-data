[{"type": "subtitle", "time": 3181.67, "timestamp": "00:53:01", "text": "未来，对吧？所以我决定这么做。"}, {"type": "subtitle", "time": 3184.309, "timestamp": "00:53:04", "text": "我现在不会担心未来了。但"}, {"type": "subtitle", "time": 3187.75, "timestamp": "00:53:07", "text": "是的，曾经……"}, {"type": "subtitle", "time": 3191.51, "timestamp": "00:53:11", "text": "一旦我能拿到这个……"}, {"type": "subtitle", "time": 3193.829, "timestamp": "00:53:13", "text": "然后，推出新款车型等等。"}, {"type": "subtitle", "time": 3195.829, "timestamp": "00:53:15", "text": "我会负责标志的事情。"}, {"type": "subtitle", "time": 3198.069, "timestamp": "00:53:18", "text": "一切。"}, {"type": "subtitle", "time": 3200.79, "timestamp": "00:53:20", "text": "总之，他们人真的很好。我"}, {"type": "subtitle", "time": 3203.03, "timestamp": "00:53:23", "text": "我确实想这么做。我想要"}, {"type": "subtitle", "time": 3207.67, "timestamp": "00:53:27", "text": "学习他是如何做到的。"}, {"type": "subtitle", "time": 3210.15, "timestamp": "00:53:30", "text": "是的，这真不错。我真的很喜欢"}, {"type": "subtitle", "time": 3213.43, "timestamp": "00:53:33", "text": "也是。"}, {"type": "subtitle", "time": 3217.99, "timestamp": "00:53:37", "text": "非常喜欢。于是，他把文件给了我。"}, {"type": "subtitle", "time": 3220.549, "timestamp": "00:53:40", "text": "我没有，我不能，我不知道怎么做"}, {"type": "subtitle", "time": 3224.39, "timestamp": "00:53:44", "text": "他要我打开它，但他把文件给了我。"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "所以，我可以……嗯……所以我可以……"}, {"type": "subtitle", "time": 3234.87, "timestamp": "00:53:54", "text": "弄清楚如何打开它，这样我才能获取HTML代码。"}, {"type": "subtitle", "time": 3238.549, "timestamp": "00:53:58", "text": "还有那玩意儿，看看，然后学学他是怎么做的"}]
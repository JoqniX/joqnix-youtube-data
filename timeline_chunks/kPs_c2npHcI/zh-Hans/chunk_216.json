[{"type": "subtitle", "time": 12973.99, "timestamp": "03:36:13", "text": "好的。所以，必须这样。好的。"}, {"type": "subtitle", "time": 12977.429, "timestamp": "03:36:17", "text": "我只是放个logo而已。并非如此"}, {"type": "subtitle", "time": 12979.83, "timestamp": "03:36:19", "text": "人们必须点击重新"}, {"type": "subtitle", "time": 12983.59, "timestamp": "03:36:23", "text": "箭。我只是表示“是的”。"}, {"type": "subtitle", "time": 12987.03, "timestamp": "03:36:27", "text": "此文本可点击。我忘了那是"}, {"type": "subtitle", "time": 12991.51, "timestamp": "03:36:31", "text": "一件东西。好的。好的。好的。这"}, {"type": "subtitle", "time": 12995.19, "timestamp": "03:36:35", "text": "我把整个内容都放进去了。"}, {"type": "subtitle", "time": 12998.389, "timestamp": "03:36:38", "text": "堵塞。好的。"}, {"type": "subtitle", "time": 13000.95, "timestamp": "03:36:40", "text": "呃，当它是"}, {"type": "subtitle", "time": 13005.19, "timestamp": "03:36:45", "text": "当鼠标悬停在上面时，我可以设置成这样："}, {"type": "subtitle", "time": 13010.63, "timestamp": "03:36:50", "text": "文本将带有下划线。"}, {"type": "subtitle", "time": 13012.71, "timestamp": "03:36:52", "text": "我该怎么做呢？问题"}, {"type": "subtitle", "time": 13016.229, "timestamp": "03:36:56", "text": "标记。我不知道。呃"}, {"type": "subtitle", "time": 13019.51, "timestamp": "03:36:59", "text": "因为它是一个跨度。不。什么是跨度？我"}]
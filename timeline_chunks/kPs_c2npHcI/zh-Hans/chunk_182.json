[{"type": "subtitle", "time": 10923.51, "timestamp": "03:02:03", "text": "那里的系统对吧？"}, {"type": "subtitle", "time": 10925.99, "timestamp": "03:02:05", "text": "主播机器人。"}, {"type": "subtitle", "time": 10927.99, "timestamp": "03:02:07", "text": "好的。"}, {"type": "subtitle", "time": 10930.309, "timestamp": "03:02:10", "text": "是的。是的。流模式就像“哦”，"}, {"type": "subtitle", "time": 10938.15, "timestamp": "03:02:18", "text": "阿尔法。哦，这是阿尔法版。我不想"}, {"type": "subtitle", "time": 10941.429, "timestamp": "03:02:21", "text": "支付。是啊，新版本太酷了！"}, {"type": "subtitle", "time": 10945.11, "timestamp": "03:02:25", "text": "男人。看看这个旧的。老的那个"}, {"type": "subtitle", "time": 10946.63, "timestamp": "03:02:26", "text": "呜呜。"}, {"type": "subtitle", "time": 10949.03, "timestamp": "03:02:29", "text": "等等，等等。让我来演示一下。老款"}, {"type": "subtitle", "time": 10951.91, "timestamp": "03:02:31", "text": "长这样。但新的那一个是"}, {"type": "subtitle", "time": 10954.63, "timestamp": "03:02:34", "text": "真好。"}, {"type": "subtitle", "time": 10957.349, "timestamp": "03:02:37", "text": "它对Windows系统非常友好。外观"}, {"type": "subtitle", "time": 10962.79, "timestamp": "03:02:42", "text": "就像Windows 11应用程序之类的。"}, {"type": "subtitle", "time": 10966.469, "timestamp": "03:02:46", "text": "他们更新了整个网站。"}, {"type": "subtitle", "time": 10969.349, "timestamp": "03:02:49", "text": "他们竟然把整个网站都更新了。"}, {"type": "subtitle", "time": 10972.389, "timestamp": "03:02:52", "text": "他们什么时候做的？娜蒂来了。"}]
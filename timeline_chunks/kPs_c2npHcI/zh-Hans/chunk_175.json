[{"type": "subtitle", "time": 10500.95, "timestamp": "02:55:00", "text": "爱 pomposan"}, {"type": "subtitle", "time": 10502.63, "timestamp": "02:55:02", "text": "君主。"}, {"type": "subtitle", "time": 10506.79, "timestamp": "02:55:06", "text": "该死。哦，是的。赛塔斯。那种节奏"}, {"type": "subtitle", "time": 10515.19, "timestamp": "02:55:15", "text": "嗯，不错。"}, {"type": "subtitle", "time": 10518.79, "timestamp": "02:55:18", "text": "哦，他们还把混音专辑的内容也放进去了。"}, {"type": "subtitle", "time": 10520.469, "timestamp": "02:55:20", "text": "好的。"}, {"type": "subtitle", "time": 10524.79, "timestamp": "02:55:24", "text": "BTW Fest 2022。"}, {"type": "subtitle", "time": 10532.469, "timestamp": "02:55:32", "text": "哦，冰淇淋系列。"}, {"type": "subtitle", "time": 10536.79, "timestamp": "02:55:36", "text": "呃，神崎节"}, {"type": "subtitle", "time": 10540.71, "timestamp": "02:55:40", "text": "H：我想放图片，但我不知道怎么放。"}, {"type": "subtitle", "time": 10542.71, "timestamp": "02:55:42", "text": "我知道我应该怎么说，因为"}, {"type": "subtitle", "time": 10545.11, "timestamp": "02:55:45", "text": "我把它列成一个要点清单。"}, {"type": "subtitle", "time": 10554.15, "timestamp": "02:55:54", "text": "糟糕。有些日子他们会这样说"}, {"type": "subtitle", "time": 10558.79, "timestamp": "02:55:58", "text": "这一点也适用。 2024年至2039年。"}]
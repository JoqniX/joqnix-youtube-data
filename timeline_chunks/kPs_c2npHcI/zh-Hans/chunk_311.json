[{"type": "subtitle", "time": 18662.47, "timestamp": "05:11:02", "text": "指南页面将包含类似以下内容："}, {"type": "subtitle", "time": 18665.27, "timestamp": "05:11:05", "text": "向我的母语者提出请求"}, {"type": "subtitle", "time": 18667.99, "timestamp": "05:11:07", "text": "指导原则。我需要一份评分草案。"}, {"type": "subtitle", "time": 18671.75, "timestamp": "05:11:11", "text": "所有粉丝相关内容的指导原则，例如"}, {"type": "subtitle", "time": 18676.23, "timestamp": "05:11:16", "text": "同人小说，音乐，呃，插画，"}, {"type": "subtitle", "time": 18679.67, "timestamp": "05:11:19", "text": "呃，视频、媒体、资产"}, {"type": "subtitle", "time": 18681.99, "timestamp": "05:11:21", "text": "片段、视频。"}, {"type": "subtitle", "time": 18684.31, "timestamp": "05:11:24", "text": "是的，视频片段也会包含在这个范围内。"}, {"type": "subtitle", "time": 18686.23, "timestamp": "05:11:26", "text": "游戏"}, {"type": "subtitle", "time": 18689.27, "timestamp": "05:11:29", "text": "以及其他形式的内容。"}, {"type": "subtitle", "time": 18691.75, "timestamp": "05:11:31", "text": "是的，我得好好准备一份。"}, {"type": "subtitle", "time": 18694.55, "timestamp": "05:11:34", "text": "这方面的指导原则。"}, {"type": "subtitle", "time": 18698.39, "timestamp": "05:11:38", "text": "糟了，它已经发布了。好的，让我"}, {"type": "subtitle", "time": 18700.868, "timestamp": "05:11:40", "text": "查看我的手机。"}, {"type": "subtitle", "time": 18702.39, "timestamp": "05:11:42", "text": "呃"}, {"type": "subtitle", "time": 18712.07, "timestamp": "05:11:52", "text": "空间。它打开菜单"}, {"type": "subtitle", "time": 18719.75, "timestamp": "05:11:59", "text": "哦哦，情况还不错。其实挺不错的。"}]
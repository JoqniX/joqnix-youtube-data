[{"type": "subtitle", "time": 13877.75, "timestamp": "03:51:17", "text": "呃，我可以把这段缩短一些。我们不"}, {"type": "subtitle", "time": 13881.51, "timestamp": "03:51:21", "text": "需要加上去。或者还有另一种想法……"}, {"type": "subtitle", "time": 13886.07, "timestamp": "03:51:26", "text": "耳朵，对吧？耳朵可以是我能做的。"}, {"type": "subtitle", "time": 13889.91, "timestamp": "03:51:29", "text": "像背景一样放置，就像边框一样。"}, {"type": "subtitle", "time": 13895.269, "timestamp": "03:51:35", "text": "边框 边框 边框 半径"}, {"type": "subtitle", "time": 13898.87, "timestamp": "03:51:38", "text": "边框宽度。"}, {"type": "subtitle", "time": 13900.63, "timestamp": "03:51:40", "text": "所以那就像耳朵会……"}, {"type": "subtitle", "time": 13902.63, "timestamp": "03:51:42", "text": "文本将分开显示。是吗？"}, {"type": "subtitle", "time": 13905.91, "timestamp": "03:51:45", "text": "这样是不是太过分了？"}]
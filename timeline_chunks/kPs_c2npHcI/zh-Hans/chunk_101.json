[{"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "嗯，你应该紧接着……"}, {"type": "subtitle", "time": 6074.47, "timestamp": "01:41:14", "text": "简短的叙述解释了你的"}, {"type": "subtitle", "time": 6076.55, "timestamp": "01:41:16", "text": "呃，前任主播出错了。这发生在之前"}, {"type": "subtitle", "time": 6083.669, "timestamp": "01:41:23", "text": "嗯。"}, {"type": "subtitle", "time": 6086.149, "timestamp": "01:41:26", "text": "其次，在背景之后，添加一个"}, {"type": "subtitle", "time": 6089.189, "timestamp": "01:41:29", "text": "时间线前的小图"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "或者只是时间线。好的，我们必须把它"}, {"type": "subtitle", "time": 6098.79, "timestamp": "01:41:38", "text": "它像个水平方向的东西。 2023年25月202日"}, {"type": "subtitle", "time": 6106.229, "timestamp": "01:41:46", "text": "我得用虚线的方式写，"}, {"type": "subtitle", "time": 6112.47, "timestamp": "01:41:52", "text": "[音乐]"}, {"type": "subtitle", "time": 6114.95, "timestamp": "01:41:54", "text": "等等，我必须把它放在虚线框里吗？"}]
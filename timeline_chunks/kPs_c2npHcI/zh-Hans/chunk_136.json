[{"type": "subtitle", "time": 8164.31, "timestamp": "02:16:04", "text": "我不明白。我做错了什么？"}, {"type": "subtitle", "time": 8185.589, "timestamp": "02:16:25", "text": "它为什么不喜欢我？为什么会这样？"}, {"type": "subtitle", "time": 8187.83, "timestamp": "02:16:27", "text": "比如我输入百分比时，它不会显示。"}, {"type": "subtitle", "time": 8190.229, "timestamp": "02:16:30", "text": "像我这样的人吗？"}, {"type": "subtitle", "time": 8192.389, "timestamp": "02:16:32", "text": "我的天啊。等等，如果我放"}, {"type": "subtitle", "time": 8196.629, "timestamp": "02:16:36", "text": "这里占多少百分比？啊，它消失了。"}]
[{"type": "subtitle", "time": 1141.669, "timestamp": "00:19:01", "text": "嗯，我觉得没问题。"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "嗯，我可能需要更准确地表达一下。"}, {"type": "subtitle", "time": 1148.39, "timestamp": "00:19:08", "text": "我猜是这样，不过目前来说没问题。"}, {"type": "subtitle", "time": 1149.909, "timestamp": "00:19:09", "text": "是的"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "按钮相关的工作已经完成了，现在我们需要……"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "把这家伙的 Jama 叠加起来。我们如何才能拥有"}, {"type": "subtitle", "time": 1159.59, "timestamp": "00:19:19", "text": "我们的对话叠加层是这样的，对吧？所以"}, {"type": "subtitle", "time": 1162.95, "timestamp": "00:19:22", "text": "我们这就去拿东西。"}, {"type": "subtitle", "time": 1166.39, "timestamp": "00:19:26", "text": "再次。菜单 V4。"}, {"type": "subtitle", "time": 1170.63, "timestamp": "00:19:30", "text": "菜单 V4 触发按钮。正确的。 V4。好的。"}, {"type": "subtitle", "time": 1172.549, "timestamp": "00:19:32", "text": "所以，我们也打算这样做。"}, {"type": "subtitle", "time": 1178.15, "timestamp": "00:19:38", "text": "转换为代币。将其设为菜单 V4。"}, {"type": "subtitle", "time": 1183.029, "timestamp": "00:19:43", "text": "呃"}, {"type": "subtitle", "time": 1194.63, "timestamp": "00:19:54", "text": "覆盖。覆盖"}, {"type": "subtitle", "time": 1196.87, "timestamp": "00:19:56", "text": "用于叠加层的菜单。那会很好"}]
[{"type": "subtitle", "time": 3974.789, "timestamp": "01:06:14", "text": "哦。"}, {"type": "subtitle", "time": 3987.67, "timestamp": "01:06:27", "text": "哦，"}, {"type": "subtitle", "time": 3991.19, "timestamp": "01:06:31", "text": "太多事情了。哇。懂得越多越好。"}, {"type": "subtitle", "time": 3993.75, "timestamp": "01:06:33", "text": "雪茄。"}, {"type": "subtitle", "time": 4003.75, "timestamp": "01:06:43", "text": "是的，我很想联系你。"}, {"type": "subtitle", "time": 4011.349, "timestamp": "01:06:51", "text": "我很想联系他们。他们"}, {"type": "subtitle", "time": 4015.91, "timestamp": "01:06:55", "text": "做塔罗牌。他们做甲状腺卡片之类的东西。我"}, {"type": "subtitle", "time": 4018.87, "timestamp": "01:06:58", "text": "她只想到佐助的索尔，她也"}]
[{"type": "subtitle", "time": 10320.389, "timestamp": "02:52:00", "text": "时间线风格呃"}, {"type": "subtitle", "time": 10324.07, "timestamp": "02:52:04", "text": "搭配围巾看起来还可以，但不太协调。"}, {"type": "subtitle", "time": 10328.53, "timestamp": "02:52:08", "text": "浏览更难进行心理排序"}, {"type": "subtitle", "time": 10330.07, "timestamp": "02:52:10", "text": "[音乐]"}, {"type": "subtitle", "time": 10333.269, "timestamp": "02:52:13", "text": "但问题是，当你……那个东西"}, {"type": "subtitle", "time": 10336.87, "timestamp": "02:52:16", "text": "我们来到这里，仅仅是为了这件事。"}, {"type": "subtitle", "time": 10339.349, "timestamp": "02:52:19", "text": "用文字表达出来，我们并非如此。"}, {"type": "subtitle", "time": 10344.55, "timestamp": "02:52:24", "text": "把小牛咳嗽之类的图片放在这里"}, {"type": "subtitle", "time": 10347.99, "timestamp": "02:52:27", "text": "虽然她放了图片，但她把图片当作"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "它就像一本关于咳嗽的日记和梦境。"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "她会放一些图片之类的东西，"}, {"type": "subtitle", "time": 10357.75, "timestamp": "02:52:37", "text": "正确的？"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "所以我必须这样想。"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "也。比如，如果我有一张图片要放进去的话"}, {"type": "subtitle", "time": 10368.82, "timestamp": "02:52:48", "text": "我该怎么做呢？"}, {"type": "subtitle", "time": 10377.91, "timestamp": "02:52:57", "text": "这是什么？哦，她确实喜欢"}]
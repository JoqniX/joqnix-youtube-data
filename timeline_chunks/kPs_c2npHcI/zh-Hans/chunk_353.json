[{"type": "subtitle", "time": 21182.23, "timestamp": "05:53:02", "text": "哦好的。好的。等待。人们可以查看"}, {"type": "subtitle", "time": 21189.19, "timestamp": "05:53:09", "text": "不，我还没检查，也没展示过。"}, {"type": "subtitle", "time": 21191.35, "timestamp": "05:53:11", "text": "不用担心。不用担心。"}, {"type": "subtitle", "time": 21201.75, "timestamp": "05:53:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 21203.91, "timestamp": "05:53:23", "text": "哦。"}, {"type": "subtitle", "time": 21220.15, "timestamp": "05:53:40", "text": "[音乐]"}, {"type": "subtitle", "time": 21222.708, "timestamp": "05:53:42", "text": "您忘记了您的消费税号。"}]
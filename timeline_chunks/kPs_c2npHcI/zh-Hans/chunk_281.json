[{"type": "subtitle", "time": 16860.868, "timestamp": "04:41:00", "text": "仔细想想，我该怎么添加呢？"}, {"type": "subtitle", "time": 16863.11, "timestamp": "04:41:03", "text": "我的天哪。如果我像我一样，"}, {"type": "subtitle", "time": 16866.628, "timestamp": "04:41:06", "text": "现在列一个要点，就像拥有它一样。"}, {"type": "subtitle", "time": 16870.31, "timestamp": "04:41:10", "text": "图像是另一个令人头疼的问题。"}, {"type": "subtitle", "time": 16874.628, "timestamp": "04:41:14", "text": "就像咳嗽网站那样。不，如果我"}, {"type": "subtitle", "time": 16876.948, "timestamp": "04:41:16", "text": "如果"}, {"type": "subtitle", "time": 16879.03, "timestamp": "04:41:19", "text": "有图片"}, {"type": "subtitle", "time": 16881.11, "timestamp": "04:41:21", "text": "就像这里，我不知道他们放了什么，比如"}, {"type": "subtitle", "time": 16885.27, "timestamp": "04:41:25", "text": "文字，但如果我要放一张图片，不，"}, {"type": "subtitle", "time": 16888.868, "timestamp": "04:41:28", "text": "我很想放一张图片，可是该怎么做呢？"}, {"type": "subtitle", "time": 16893.11, "timestamp": "04:41:33", "text": "我把它放进去？那又是一个麻烦事儿哦。"}, {"type": "subtitle", "time": 16903.83, "timestamp": "04:41:43", "text": "那又是另一副红色牌组，对吧？"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "如何迎合当下的氛围？"}]
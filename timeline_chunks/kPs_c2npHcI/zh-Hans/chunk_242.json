[{"type": "subtitle", "time": 14526.87, "timestamp": "04:02:06", "text": "或许三个。"}, {"type": "subtitle", "time": 14535.189, "timestamp": "04:02:15", "text": "列出物品容器。"}, {"type": "subtitle", "time": 14549.349, "timestamp": "04:02:29", "text": "我收到一条私信。"}, {"type": "subtitle", "time": 14556.79, "timestamp": "04:02:36", "text": "哦。是的，我得去，我有个合作项目。"}, {"type": "subtitle", "time": 14571.11, "timestamp": "04:02:51", "text": "恐怖症？"}, {"type": "subtitle", "time": 14574.15, "timestamp": "04:02:54", "text": "好的。我们三个。我们四个人是"}]
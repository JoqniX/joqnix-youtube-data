[{"type": "subtitle", "time": 7864.709, "timestamp": "02:11:04", "text": "我们可以把它写成 H1 或者嗯"}, {"type": "subtitle", "time": 7866.95, "timestamp": "02:11:06", "text": "H1之类的头像都无所谓。不"}, {"type": "subtitle", "time": 7871.99, "timestamp": "02:11:11", "text": "事情。但我希望制作这个东西"}, {"type": "subtitle", "time": 7876.55, "timestamp": "02:11:16", "text": "所有H都像年份之类的东西，你知道，年份。"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "嗯，或许我们可以晚点再做，但我会……"}, {"type": "subtitle", "time": 7883.189, "timestamp": "02:11:23", "text": "就保留5月20日吧。"}, {"type": "subtitle", "time": 7891.109, "timestamp": "02:11:31", "text": "嗯"}, {"type": "subtitle", "time": 7905.75, "timestamp": "02:11:45", "text": "跨耳线文本，这是一个"}, {"type": "subtitle", "time": 7908.709, "timestamp": "02:11:48", "text": "背景一。是我所想的那样吗？"}, {"type": "subtitle", "time": 7910.87, "timestamp": "02:11:50", "text": "是？就像"}, {"type": "subtitle", "time": 7914.31, "timestamp": "02:11:54", "text": "哦，我大概明白他们做了什么。"}, {"type": "subtitle", "time": 7915.83, "timestamp": "02:11:55", "text": "这里。"}, {"type": "subtitle", "time": 7919.27, "timestamp": "02:11:59", "text": "好的，我来创建一个新元素。"}]
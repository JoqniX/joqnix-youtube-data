[{"type": "subtitle", "time": 6302.87, "timestamp": "01:45:02", "text": "这样我就可以利用它来为自己谋利了。"}, {"type": "subtitle", "time": 6307.51, "timestamp": "01:45:07", "text": "以及历史。是的，他们把所有东西都放进去了。"}, {"type": "subtitle", "time": 6311.109, "timestamp": "01:45:11", "text": "哦，他们这样写"}, {"type": "subtitle", "time": 6315.51, "timestamp": "01:45:15", "text": "我需要学习如何链接各个部分"}, {"type": "subtitle", "time": 6318.07, "timestamp": "01:45:18", "text": "以及所有的一切。我相信你如何才能"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "链接部分就像在链接中一样"}, {"type": "subtitle", "time": 6322.31, "timestamp": "01:45:22", "text": "按钮。"}, {"type": "subtitle", "time": 6324.629, "timestamp": "01:45:24", "text": "我放个链接按钮试试。呃"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "目标。不。"}, {"type": "subtitle", "time": 6340.39, "timestamp": "01:45:40", "text": "它是字母P吗？哦，请选择一个版块。"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "哦。我的天啊。东西太多了。"}, {"type": "subtitle", "time": 6345.59, "timestamp": "01:45:45", "text": "这里。"}, {"type": "subtitle", "time": 6349.59, "timestamp": "01:45:49", "text": "等等，如何添加章节呢？"}, {"type": "subtitle", "time": 6352.709, "timestamp": "01:45:52", "text": "我的天哪，东西真多。什么"}, {"type": "subtitle", "time": 6357.43, "timestamp": "01:45:57", "text": "这是吗？社交网络领域。这是我的部分吗？"}, {"type": "subtitle", "time": 6359.91, "timestamp": "01:45:59", "text": "一个按钮关闭？多少"}]
[{"type": "subtitle", "time": 4980.07, "timestamp": "01:23:00", "text": "我忘了我们得问问查吉。"}, {"type": "subtitle", "time": 4984.229, "timestamp": "01:23:04", "text": "Piti Chan该怎么办？"}, {"type": "subtitle", "time": 4993.43, "timestamp": "01:23:13", "text": "所以，呃，我们从CF那里得到了历史页面。我们"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "可以用那个。但我需要更多历史知识。"}, {"type": "subtitle", "time": 5000.95, "timestamp": "01:23:20", "text": "东西。历史上会有类似的事件发生，"}, {"type": "subtitle", "time": 5004.07, "timestamp": "01:23:24", "text": "一切。我所做的等等，对吧？所以"}, {"type": "subtitle", "time": 5007.91, "timestamp": "01:23:27", "text": "那将在某种程度上发挥媒体的作用"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "成套工具，"}, {"type": "subtitle", "time": 5013.51, "timestamp": "01:23:33", "text": "正确的？为了品牌和一切"}, {"type": "subtitle", "time": 5016.229, "timestamp": "01:23:36", "text": "对广告商和其他所有人来说都是如此。如果我是"}, {"type": "subtitle", "time": 5018.31, "timestamp": "01:23:38", "text": "那样想的话，因为如果"}, {"type": "subtitle", "time": 5021.27, "timestamp": "01:23:41", "text": "如果你是内容创作者，那么你就是。"}, {"type": "subtitle", "time": 5023.91, "timestamp": "01:23:43", "text": "东西，无论你从事什么行业，你"}, {"type": "subtitle", "time": 5027.43, "timestamp": "01:23:47", "text": "肯定得准备一份媒体资料包吧？"}, {"type": "subtitle", "time": 5029.43, "timestamp": "01:23:49", "text": "我意识到了这一点。你必须这样做。"}, {"type": "subtitle", "time": 5032.149, "timestamp": "01:23:52", "text": "制作媒体资料包。"}, {"type": "subtitle", "time": 5036.149, "timestamp": "01:23:56", "text": "让我查一下。"}, {"type": "subtitle", "time": 5039.83, "timestamp": "01:23:59", "text": "我认为查看页面更好。她"}]
[{"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "没有目标或没有目标。法律避免"}, {"type": "subtitle", "time": 18613.91, "timestamp": "05:10:13", "text": "菜单空白处"}, {"type": "subtitle", "time": 18616.31, "timestamp": "05:10:16", "text": "不好。好的。默认。它打开了同样的"}, {"type": "subtitle", "time": 18619.27, "timestamp": "05:10:19", "text": "链接，除非另有说明，否则无需离开。"}, {"type": "subtitle", "time": 18629.11, "timestamp": "05:10:29", "text": "好的。呃，历史，对吧？"}, {"type": "subtitle", "time": 18632.628, "timestamp": "05:10:32", "text": "我打算把它发出去。发布 发布"}, {"type": "subtitle", "time": 18635.27, "timestamp": "05:10:35", "text": "它。它应该在那里。"}, {"type": "subtitle", "time": 18637.11, "timestamp": "05:10:37", "text": "明天"}, {"type": "subtitle", "time": 18641.35, "timestamp": "05:10:41", "text": "我的意思是，今天是星期六。"}, {"type": "subtitle", "time": 18643.99, "timestamp": "05:10:43", "text": "天哪，现在凌晨2点了。好吧。今天是"}, {"type": "subtitle", "time": 18647.67, "timestamp": "05:10:47", "text": "周六。所以，我们将要做"}, {"type": "subtitle", "time": 18649.83, "timestamp": "05:10:49", "text": "是的。我的出生和经历有点……"}, {"type": "subtitle", "time": 18651.75, "timestamp": "05:10:51", "text": "完毕。"}, {"type": "subtitle", "time": 18655.19, "timestamp": "05:10:55", "text": "明天我们可以做信息或"}, {"type": "subtitle", "time": 18657.43, "timestamp": "05:10:57", "text": "指南"}, {"type": "subtitle", "time": 18659.03, "timestamp": "05:10:59", "text": "页。"}]
[{"type": "subtitle", "time": 7327.589, "timestamp": "02:02:07", "text": "我们一直在偷偷摸摸地进行着"}, {"type": "subtitle", "time": 7329.51, "timestamp": "02:02:09", "text": "永久备份您的发布网站。"}, {"type": "subtitle", "time": 7332.79, "timestamp": "02:02:12", "text": "只是忘记了"}, {"type": "subtitle", "time": 7334.95, "timestamp": "02:02:14", "text": "恢复按钮。有一个恢复按钮"}, {"type": "subtitle", "time": 7344.39, "timestamp": "02:02:24", "text": "备份。哦，他们有网站备份。"}, {"type": "subtitle", "time": 7346.149, "timestamp": "02:02:26", "text": "系统。哦，等等，等等，等等，等等。是"}, {"type": "subtitle", "time": 7349.51, "timestamp": "02:02:29", "text": "它在那儿吗？等待。"}, {"type": "subtitle", "time": 7351.03, "timestamp": "02:02:31", "text": "设置。"}, {"type": "subtitle", "time": 7355.589, "timestamp": "02:02:35", "text": "哦，找到了。哦，他们有备用方案。"}, {"type": "subtitle", "time": 7369.109, "timestamp": "02:02:49", "text": "哦，这真不错。"}, {"type": "subtitle", "time": 7372.229, "timestamp": "02:02:52", "text": "我可以恢复到旧版本"}, {"type": "subtitle", "time": 7374.149, "timestamp": "02:02:54", "text": "还有其他一些东西。"}]
[{"type": "subtitle", "time": 21129.99, "timestamp": "05:52:09", "text": "呃，所以我做了那个柔性板。"}, {"type": "subtitle", "time": 21132.788, "timestamp": "05:52:12", "text": "等等"}, {"type": "subtitle", "time": 21136.628, "timestamp": "05:52:16", "text": "因为对于消费税，那个人会来。"}, {"type": "subtitle", "time": 21139.67, "timestamp": "05:52:19", "text": "呃，现在就去核实一下这是否是正规商家。"}, {"type": "subtitle", "time": 21143.19, "timestamp": "05:52:23", "text": "也可能他们现在就到那里来。"}, {"type": "subtitle", "time": 21148.07, "timestamp": "05:52:28", "text": "所以，我做了一个临时的，呃……"}, {"type": "subtitle", "time": 21151.91, "timestamp": "05:52:31", "text": "我门上的柔性板"}, {"type": "subtitle", "time": 21154.31, "timestamp": "05:52:34", "text": "有标志什么的，但是"}, {"type": "subtitle", "time": 21156.948, "timestamp": "05:52:36", "text": "新标志与新标志不匹配"}, {"type": "subtitle", "time": 21159.19, "timestamp": "05:52:39", "text": "现在就做这个模型。所以，我正在想……"}, {"type": "subtitle", "time": 21162.39, "timestamp": "05:52:42", "text": "改变它"}, {"type": "subtitle", "time": 21165.35, "timestamp": "05:52:45", "text": "只有简短的logo部分。"}, {"type": "subtitle", "time": 21168.15, "timestamp": "05:52:48", "text": "我不知道。"}, {"type": "subtitle", "time": 21170.47, "timestamp": "05:52:50", "text": "我需要做的就是，你认为我有"}, {"type": "subtitle", "time": 21174.788, "timestamp": "05:52:54", "text": "要改吗？是吗？"}]
[{"type": "subtitle", "time": 17342.07, "timestamp": "04:49:02", "text": "等等，等等。为什么它看起来像……"}, {"type": "subtitle", "time": 17345.99, "timestamp": "04:49:05", "text": "钻石？等等，什么？但确实如此。"}, {"type": "subtitle", "time": 17350.47, "timestamp": "04:49:10", "text": "一颗星星，所以没问题。"}, {"type": "subtitle", "time": 17353.51, "timestamp": "04:49:13", "text": "我刚刚意识到一件事。哦，我哦，"}, {"type": "subtitle", "time": 17357.19, "timestamp": "04:49:17", "text": "是的。呃，我的……呃，我的皇冠，我的意思是……嗯……我的"}, {"type": "subtitle", "time": 17362.15, "timestamp": "04:49:22", "text": "头部元素有类似的东西"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "是的，四角星就在那里。"}, {"type": "subtitle", "time": 17381.11, "timestamp": "04:49:41", "text": "我的天哪。用鼠标绘制它是"}, {"type": "subtitle", "time": 17390.23, "timestamp": "04:49:50", "text": "是的，它在那里。呃，这不是"}, {"type": "subtitle", "time": 17398.15, "timestamp": "04:49:58", "text": "是的，"}]
[{"type": "subtitle", "time": 3844.549, "timestamp": "01:04:04", "text": "索娜，听起来像个很印度的名字。"}, {"type": "subtitle", "time": 3855.51, "timestamp": "01:04:15", "text": "如果我在这里写上“印度人”，我想那里"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "为什么叫阿库玛？"}, {"type": "subtitle", "time": 3869.19, "timestamp": "01:04:29", "text": "她为什么会出现在这里？等等，让我"}, {"type": "subtitle", "time": 3873.349, "timestamp": "01:04:33", "text": "印度人。她喜欢印度菜。啊，"}, {"type": "subtitle", "time": 3878.23, "timestamp": "01:04:38", "text": "这就是她出现的原因。"}, {"type": "subtitle", "time": 3882.23, "timestamp": "01:04:42", "text": "嗯，还有一个是年奇。"}, {"type": "subtitle", "time": 3885.91, "timestamp": "01:04:45", "text": "大多数日本人都会"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "呃"}]
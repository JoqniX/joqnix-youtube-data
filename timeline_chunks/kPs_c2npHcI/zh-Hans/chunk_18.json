[{"type": "subtitle", "time": 1083.19, "timestamp": "00:18:03", "text": "菜单上的菜品种类这么多吗？"}, {"type": "subtitle", "time": 1095.669, "timestamp": "00:18:15", "text": "啊，短信。模仿这个人。你要去"}, {"type": "subtitle", "time": 1099.35, "timestamp": "00:18:19", "text": "跟我来。跟我回家吧。他们"}, {"type": "subtitle", "time": 1102.789, "timestamp": "00:18:22", "text": "我要把你直接放到里面。"}, {"type": "subtitle", "time": 1110.31, "timestamp": "00:18:30", "text": "文本。"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "文本已关闭，但我们会将其保留为"}, {"type": "subtitle", "time": 1114.549, "timestamp": "00:18:34", "text": "菜单。"}, {"type": "subtitle", "time": 1122.549, "timestamp": "00:18:42", "text": "呃，如果你想知道的话，哦，乔，"}, {"type": "subtitle", "time": 1124.23, "timestamp": "00:18:44", "text": "它的造型设计如何？不要"}, {"type": "subtitle", "time": 1126.71, "timestamp": "00:18:46", "text": "担心。已经"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "在其继承过程中得到照顾"}, {"type": "subtitle", "time": 1134.789, "timestamp": "00:18:54", "text": "尺寸等等。呃，我很担心。"}, {"type": "subtitle", "time": 1138.31, "timestamp": "00:18:58", "text": "关于那件事。呃"}]
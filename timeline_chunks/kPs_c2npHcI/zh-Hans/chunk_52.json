[{"type": "subtitle", "time": 3121.109, "timestamp": "00:52:01", "text": "用下巴到这里。我很好。"}, {"type": "subtitle", "time": 3123.43, "timestamp": "00:52:03", "text": "我觉得我需要的简短标志"}, {"type": "subtitle", "time": 3127.829, "timestamp": "00:52:07", "text": "修改它以适应星座"}, {"type": "subtitle", "time": 3131.19, "timestamp": "00:52:11", "text": "主题。我没有，因为我是虚拟主播。"}, {"type": "subtitle", "time": 3133.75, "timestamp": "00:52:13", "text": "VTuber的标志往往体现个性。"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "以及一切"}, {"type": "subtitle", "time": 3138.71, "timestamp": "00:52:18", "text": "这更像是现代的通用术语。"}, {"type": "subtitle", "time": 3143.27, "timestamp": "00:52:23", "text": "我猜是某种类型。我不知道。嗯，所以我想"}, {"type": "subtitle", "time": 3144.87, "timestamp": "00:52:24", "text": "到"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "我在想我应该做什么"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "短版标志？我想改变它"}, {"type": "subtitle", "time": 3151.51, "timestamp": "00:52:31", "text": "起来，你知道，为了展示，就像"}, {"type": "subtitle", "time": 3153.99, "timestamp": "00:52:33", "text": "星座或者其他类似太空的东西"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "相关的东西，"}, {"type": "subtitle", "time": 3158.549, "timestamp": "00:52:38", "text": "正确的？我觉得我必须这么做。"}, {"type": "subtitle", "time": 3161.27, "timestamp": "00:52:41", "text": "等我展示完新产品后再考虑一下。"}, {"type": "subtitle", "time": 3165.03, "timestamp": "00:52:45", "text": "是模型，对吧？吉尔达，我不用担心"}, {"type": "subtitle", "time": 3168.069, "timestamp": "00:52:48", "text": "想太多了。无论我拥有什么权利"}, {"type": "subtitle", "time": 3177.67, "timestamp": "00:52:57", "text": "我不应该太担心……"}]
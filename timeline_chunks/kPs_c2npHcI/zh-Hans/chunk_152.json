[{"type": "subtitle", "time": 9122.07, "timestamp": "02:32:02", "text": "如果我不想过2020年呢？那又怎样？"}, {"type": "subtitle", "time": 9124.15, "timestamp": "02:32:04", "text": "将会发生"}, {"type": "subtitle", "time": 9126.23, "timestamp": "02:32:06", "text": "短的"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "为什么它使用的是 2001 年的版本？"}, {"type": "subtitle", "time": 9138.469, "timestamp": "02:32:18", "text": "是的，我的想法是，如果我不喜欢……就不……"}, {"type": "subtitle", "time": 9142.469, "timestamp": "02:32:22", "text": "它。或许我只会"}, {"type": "subtitle", "time": 9144.07, "timestamp": "02:32:24", "text": "嗯"}, {"type": "subtitle", "time": 9147.83, "timestamp": "02:32:27", "text": "我觉得我们没必要把……"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "时间装置。我们直接把它以文本形式发送吧。"}, {"type": "subtitle", "time": 9158.79, "timestamp": "02:32:38", "text": "20"}, {"type": "subtitle", "time": 9164.309, "timestamp": "02:32:44", "text": "八月。"}, {"type": "subtitle", "time": 9168.469, "timestamp": "02:32:48", "text": "我应该那样说吗？"}, {"type": "subtitle", "time": 9171.19, "timestamp": "02:32:51", "text": "等待文本和月份日期和月份"}, {"type": "subtitle", "time": 9175.11, "timestamp": "02:32:55", "text": "迟到的信件。你想要什么样的感觉？"}, {"type": "subtitle", "time": 9177.91, "timestamp": "02:32:57", "text": "嗯，好吧，让我给你，我给你对吧"}]
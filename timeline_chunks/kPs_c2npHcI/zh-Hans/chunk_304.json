[{"type": "subtitle", "time": 18253.19, "timestamp": "05:04:13", "text": "呃，打开这个"}, {"type": "subtitle", "time": 18263.83, "timestamp": "05:04:23", "text": "是的，这样我们就差不多完成了。"}, {"type": "subtitle", "time": 18266.31, "timestamp": "05:04:26", "text": "与历史记录页面一起。"}, {"type": "subtitle", "time": 18269.51, "timestamp": "05:04:29", "text": "我唯一需要考虑的例外情况是"}, {"type": "subtitle", "time": 18275.91, "timestamp": "05:04:35", "text": "如果我们有一张图片呢？"}, {"type": "subtitle", "time": 18279.43, "timestamp": "05:04:39", "text": "是的，从某种意义上说，我可以选择不做"}, {"type": "subtitle", "time": 18284.15, "timestamp": "05:04:44", "text": "图片，但图片很好。现在我觉得"}, {"type": "subtitle", "time": 18287.91, "timestamp": "05:04:47", "text": "关于这一点，图片效果不错。"}, {"type": "subtitle", "time": 18290.628, "timestamp": "05:04:50", "text": "正确的？"}, {"type": "subtitle", "time": 18295.11, "timestamp": "05:04:55", "text": "图像是波浪的通道。呃，它会"}, {"type": "subtitle", "time": 18298.47, "timestamp": "05:04:58", "text": "看起来更赏心悦目。我想如果我有一个"}]
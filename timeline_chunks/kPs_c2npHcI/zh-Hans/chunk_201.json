[{"type": "subtitle", "time": 12069.99, "timestamp": "03:21:09", "text": "哦，这对我来说太重要了。"}, {"type": "subtitle", "time": 12076.309, "timestamp": "03:21:16", "text": "哦，谢谢。"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "我要买它。粘贴。"}, {"type": "subtitle", "time": 12082.07, "timestamp": "03:21:22", "text": "哦，不错。当前颜色。好的。好的。"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "现在，我们现在开始谈论这个话题了。耶。"}, {"type": "subtitle", "time": 12091.03, "timestamp": "03:21:31", "text": "好了。我可以改变颜色。它"}, {"type": "subtitle", "time": 12094.63, "timestamp": "03:21:34", "text": "影响颜色。好的。"}, {"type": "subtitle", "time": 12096.95, "timestamp": "03:21:36", "text": "好的。好的。好的。好的。这就是我"}, {"type": "subtitle", "time": 12101.269, "timestamp": "03:21:41", "text": "想从你这里得到。好的。好的。所以，我们得到了"}, {"type": "subtitle", "time": 12103.83, "timestamp": "03:21:43", "text": "就是这个人。那么，我们该如何……"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "把它放在这篇BBC文章的登录信息里吗？"}, {"type": "subtitle", "time": 12117.349, "timestamp": "03:21:57", "text": "哦，不错。哦，它变成了一个跨度。它"}]
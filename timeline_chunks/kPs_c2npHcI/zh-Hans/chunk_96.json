[{"type": "subtitle", "time": 5762.07, "timestamp": "01:36:02", "text": "页"}, {"type": "subtitle", "time": 5767.83, "timestamp": "01:36:07", "text": "内容将来自我的维基百科。"}, {"type": "subtitle", "time": 5770.07, "timestamp": "01:36:10", "text": "历史"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "页。"}, {"type": "subtitle", "time": 5774.79, "timestamp": "01:36:14", "text": "呃"}, {"type": "subtitle", "time": 5784.149, "timestamp": "01:36:24", "text": "令牌访问。对，就是这个。复制它。"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "简单的垂直时间线格式"}, {"type": "subtitle", "time": 5800.39, "timestamp": "01:36:40", "text": "包括年份作为标题横幅，甚至"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "堆叠格式下方的条目。"}, {"type": "subtitle", "time": 5804.39, "timestamp": "01:36:44", "text": "您的搜索可以具有清晰的结构"}, {"type": "subtitle", "time": 5806.79, "timestamp": "01:36:46", "text": "将重新按时间顺序排列并剥离"}, {"type": "subtitle", "time": 5809.51, "timestamp": "01:36:49", "text": "无需搜索网页版。"}, {"type": "subtitle", "time": 5812.07, "timestamp": "01:36:52", "text": "好的。历史"}, {"type": "subtitle", "time": 5814.31, "timestamp": "01:36:54", "text": "或者，如果你想要更浪漫一点，也可以叫它“星际之旅”。"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "所有标题。"}]
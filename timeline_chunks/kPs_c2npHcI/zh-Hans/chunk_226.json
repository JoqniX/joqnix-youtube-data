[{"type": "subtitle", "time": 13560.309, "timestamp": "03:46:00", "text": "嗯，好吧，行。我想我会保留"}, {"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "跨度。太烦人了。哦，"}, {"type": "subtitle", "time": 13568.07, "timestamp": "03:46:08", "text": "跨腿男。 O."}, {"type": "subtitle", "time": 13571.51, "timestamp": "03:46:11", "text": "哦，看来没事了。好的。好的。"}, {"type": "subtitle", "time": 13575.99, "timestamp": "03:46:15", "text": "哦，只要我把那个造型器装上就行了。"}, {"type": "subtitle", "time": 13578.15, "timestamp": "03:46:18", "text": "链接"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "把它放在一个组里就行了。"}, {"type": "subtitle", "time": 13582.79, "timestamp": "03:46:22", "text": "好的。"}, {"type": "subtitle", "time": 13584.55, "timestamp": "03:46:24", "text": "啊，"}, {"type": "subtitle", "time": 13587.75, "timestamp": "03:46:27", "text": "好的。没关系。好的。美好的。美好的。"}, {"type": "subtitle", "time": 13593.91, "timestamp": "03:46:33", "text": "是的。我就像呃，娱乐呃，投入"}, {"type": "subtitle", "time": 13598.229, "timestamp": "03:46:38", "text": "来自 fab wiki 的一切"}, {"type": "subtitle", "time": 13600.87, "timestamp": "03:46:40", "text": "我把它放在我的页面上"}, {"type": "subtitle", "time": 13602.87, "timestamp": "03:46:42", "text": "网站"}, {"type": "subtitle", "time": 13605.75, "timestamp": "03:46:45", "text": "呃，有些事我不能说。"}, {"type": "subtitle", "time": 13609.03, "timestamp": "03:46:49", "text": "我已经把它放到维基百科里了，我会把它放进去。"}, {"type": "subtitle", "time": 13613.99, "timestamp": "03:46:53", "text": "网站，所以呃，如果有人因为现在我"}, {"type": "subtitle", "time": 13616.15, "timestamp": "03:46:56", "text": "已实现的幻影页面不可用"}, {"type": "subtitle", "time": 13618.71, "timestamp": "03:46:58", "text": "在中国，它被屏蔽了，所以我就……"}]
[{"type": "subtitle", "time": 10395.83, "timestamp": "02:53:15", "text": "所以，就像如果我看一下短篇小说"}, {"type": "subtitle", "time": 10399.269, "timestamp": "02:53:19", "text": "好像他们在谈论她似的。"}, {"type": "subtitle", "time": 10404.23, "timestamp": "02:53:24", "text": "外貌、地点以及一切。"}, {"type": "subtitle", "time": 10406.71, "timestamp": "02:53:26", "text": "颁奖典礼。天哪，她得到了好多"}, {"type": "subtitle", "time": 10408.63, "timestamp": "02:53:28", "text": "奖项。"}, {"type": "subtitle", "time": 10417.91, "timestamp": "02:53:37", "text": "布兰登。哦，她在中间。"}, {"type": "subtitle", "time": 10421.19, "timestamp": "02:53:41", "text": "哦，她在那儿。"}, {"type": "subtitle", "time": 10423.11, "timestamp": "02:53:43", "text": "什么？"}, {"type": "subtitle", "time": 10425.82, "timestamp": "02:53:45", "text": "哇。超好的。"}, {"type": "subtitle", "time": 10428.87, "timestamp": "02:53:48", "text": "[音乐]"}, {"type": "subtitle", "time": 10431.11, "timestamp": "02:53:51", "text": "赞助东京电视台的片尾曲"}, {"type": "subtitle", "time": 10433.67, "timestamp": "02:53:53", "text": "日本动画片。呃，黑色五叶草。哦，是的。她"}, {"type": "subtitle", "time": 10437.11, "timestamp": "02:53:57", "text": "在《黑色五叶草》中演唱"}]
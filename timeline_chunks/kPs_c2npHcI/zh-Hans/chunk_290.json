[{"type": "subtitle", "time": 17401.75, "timestamp": "04:50:01", "text": "这一切都是水晶。"}, {"type": "subtitle", "time": 17405.67, "timestamp": "04:50:05", "text": "水晶和舞台。好的。"}, {"type": "subtitle", "time": 17407.83, "timestamp": "04:50:07", "text": "嗯，水晶也是这样。"}, {"type": "subtitle", "time": 17410.788, "timestamp": "04:50:10", "text": "盒子呈菱形"}, {"type": "subtitle", "time": 17418.55, "timestamp": "04:50:18", "text": "是的，一旦新车型上市，我"}, {"type": "subtitle", "time": 17420.948, "timestamp": "04:50:20", "text": "得委托艺术家创作才行。我愿意"}, {"type": "subtitle", "time": 17424.07, "timestamp": "04:50:24", "text": "没钱。我没钱了。"}, {"type": "subtitle", "time": 17426.788, "timestamp": "04:50:26", "text": "是的，将来我会的。"}, {"type": "subtitle", "time": 17430.47, "timestamp": "04:50:30", "text": "喜欢以某种方式委托人"}, {"type": "subtitle", "time": 17432.868, "timestamp": "04:50:32", "text": "为了好的背景等等。哦，"}, {"type": "subtitle", "time": 17434.708, "timestamp": "04:50:34", "text": "这很好。所以当你把鼠标悬停在上面时，"}, {"type": "subtitle", "time": 17440.07, "timestamp": "04:50:40", "text": "线条会被擦掉，但又不会被擦掉。它"}, {"type": "subtitle", "time": 17443.59, "timestamp": "04:50:43", "text": "出现了不同的情况。哦，那个"}, {"type": "subtitle", "time": 17447.27, "timestamp": "04:50:47", "text": "真好。总之，呃，我分心了。"}, {"type": "chat", "time": 17449.457, "timestamp": "04:50:49", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "it's a long road but we'll do it ...slowly but surely"}, {"type": "subtitle", "time": 17454.15, "timestamp": "04:50:54", "text": "呃，还有，"}, {"type": "subtitle", "time": 17456.23, "timestamp": "04:50:56", "text": "我理解得对吗？好的，就是这样。"}, {"type": "subtitle", "time": 17459.19, "timestamp": "04:50:59", "text": "周边商品。好的，抱歉。"}]
[{"type": "subtitle", "time": 2941.03, "timestamp": "00:49:01", "text": "像这样的也一样。这个人参与了布局。"}, {"type": "subtitle", "time": 2945.829, "timestamp": "00:49:05", "text": "也很不错。而且还有类似的东西"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "就像……"}, {"type": "subtitle", "time": 2953.03, "timestamp": "00:49:13", "text": "滚轮，鼠标。"}, {"type": "subtitle", "time": 2956.15, "timestamp": "00:49:16", "text": "真不错。所以我在想，一旦我"}, {"type": "subtitle", "time": 2960.069, "timestamp": "00:49:20", "text": "网站弄好了，我会尝试……"}, {"type": "subtitle", "time": 2963.19, "timestamp": "00:49:23", "text": "呃，我挑战自己，想在这个领域重现这种感觉。"}, {"type": "subtitle", "time": 2966.309, "timestamp": "00:49:26", "text": "这种格式的东西要风格化。"}, {"type": "subtitle", "time": 2969.109, "timestamp": "00:49:29", "text": "就像这样，因为现在我当然是"}, {"type": "subtitle", "time": 2971.19, "timestamp": "00:49:31", "text": "问题是我总可以委托人做"}, {"type": "subtitle", "time": 2973.19, "timestamp": "00:49:33", "text": "返回"}, {"type": "subtitle", "time": 2975.349, "timestamp": "00:49:35", "text": "包括网站相关的一切，但是"}, {"type": "subtitle", "time": 2978.47, "timestamp": "00:49:38", "text": "问题是，因为他把它硬编码进去了，而且"}, {"type": "subtitle", "time": 2980.79, "timestamp": "00:49:40", "text": "现在这一切就意味着我"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "要么得自己托管，要么就得买个服务器。"}, {"type": "subtitle", "time": 2987.109, "timestamp": "00:49:47", "text": "托管服务器以及所有这些东西"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "胡闹，对吧，很多事情，我的意思是"}, {"type": "subtitle", "time": 2993.27, "timestamp": "00:49:53", "text": "这是我们所需要的"}, {"type": "subtitle", "time": 2996.069, "timestamp": "00:49:56", "text": "呃，后端的东西，或者周边产品之类的。"}, {"type": "subtitle", "time": 2998.63, "timestamp": "00:49:58", "text": "未来的电子商务等等是"}]
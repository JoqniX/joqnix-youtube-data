[{"type": "subtitle", "time": 10087.429, "timestamp": "02:48:07", "text": "嗯，3月27日。所以，是2023年。"}, {"type": "subtitle", "time": 10089.51, "timestamp": "02:48:09", "text": "削减"}, {"type": "subtitle", "time": 10092.23, "timestamp": "02:48:12", "text": "我不知道你什么时候会加斜杠，你"}, {"type": "subtitle", "time": 10095.03, "timestamp": "02:48:15", "text": "可以添加任何“哦，那是因为它是……”"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "冷凝物块。好的。好的。"}, {"type": "subtitle", "time": 10101.51, "timestamp": "02:48:21", "text": "这就是为什么内容中的任何内容"}, {"type": "subtitle", "time": 10104.63, "timestamp": "02:48:24", "text": "我没有制作模板。哦，是的。"}, {"type": "subtitle", "time": 10107.67, "timestamp": "02:48:27", "text": "我必须做那些事。不。所以我们可以"}, {"type": "subtitle", "time": 10110.87, "timestamp": "02:48:30", "text": "制作模板。所以如果我曾经有过"}, {"type": "subtitle", "time": 10112.95, "timestamp": "02:48:32", "text": "需要更多人帮我做网站。"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "现在，他们可以登录了。他们不需要"}, {"type": "subtitle", "time": 10117.59, "timestamp": "02:48:37", "text": "登录。他们可以访问一个链接。他们可以"}, {"type": "subtitle", "time": 10121.11, "timestamp": "02:48:41", "text": "添加内容。是的，他们可以添加内容。"}, {"type": "subtitle", "time": 10123.67, "timestamp": "02:48:43", "text": "点击加号图标。他们会添加一个条目"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "像这样的对数点。是的，我可以做一个"}, {"type": "subtitle", "time": 10129.349, "timestamp": "02:48:49", "text": "模板。所以，它复制了所有样式。"}, {"type": "subtitle", "time": 10132.15, "timestamp": "02:48:52", "text": "这是。本节内容将被复制"}, {"type": "subtitle", "time": 10135.349, "timestamp": "02:48:55", "text": "他们可以做那件事。"}, {"type": "subtitle", "time": 10138.389, "timestamp": "02:48:58", "text": "是的，为了将来，我应该考虑一下。"}]
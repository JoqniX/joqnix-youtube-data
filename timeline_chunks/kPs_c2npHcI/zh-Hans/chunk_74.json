[{"type": "subtitle", "time": 4441.99, "timestamp": "01:14:01", "text": "如果我输入网址会发生什么？"}, {"type": "subtitle", "time": 4445.11, "timestamp": "01:14:05", "text": "是的，只有主页会被索引。"}, {"type": "subtitle", "time": 4449.669, "timestamp": "01:14:09", "text": "搜索右侧。比如，如果我输入 doc"}, {"type": "subtitle", "time": 4453.91, "timestamp": "01:14:13", "text": "接下来只有主要的那个会来这里。"}, {"type": "subtitle", "time": 4458.79, "timestamp": "01:14:18", "text": "如果我没记错的话，Onexia 也应该如此。"}, {"type": "subtitle", "time": 4462.47, "timestamp": "01:14:22", "text": "出现。这是什么？这是戏剧吗？"}, {"type": "subtitle", "time": 4465.189, "timestamp": "01:14:25", "text": "这是什么？"}, {"type": "subtitle", "time": 4469.35, "timestamp": "01:14:29", "text": "沃维迪亚。这是一个很棒的角色。世界"}, {"type": "subtitle", "time": 4471.669, "timestamp": "01:14:31", "text": "魔兽世界。"}, {"type": "subtitle", "time": 4481.35, "timestamp": "01:14:41", "text": "厌食症网站。"}, {"type": "subtitle", "time": 4484.07, "timestamp": "01:14:44", "text": "它能显示我的内容吗？它不"}, {"type": "subtitle", "time": 4491.27, "timestamp": "01:14:51", "text": "是的，确实如此。确实如此。主网站"}, {"type": "subtitle", "time": 4493.51, "timestamp": "01:14:53", "text": "确实出现了。"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "剩下的东西都跟我一样。是的，能力"}]
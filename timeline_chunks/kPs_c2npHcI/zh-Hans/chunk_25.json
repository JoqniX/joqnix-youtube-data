[{"type": "subtitle", "time": 1503.269, "timestamp": "00:25:03", "text": "将设计代币"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "内心深处。好的。"}, {"type": "subtitle", "time": 1509.43, "timestamp": "00:25:09", "text": "来这里，我会把它放上去。"}, {"type": "subtitle", "time": 1513.11, "timestamp": "00:25:13", "text": "我大概会把它放进去，当然我会"}, {"type": "subtitle", "time": 1516.07, "timestamp": "00:25:16", "text": "还可以用另一种方法，比如我可以……"}, {"type": "subtitle", "time": 1518.71, "timestamp": "00:25:18", "text": "把它放在这里"}, {"type": "subtitle", "time": 1520.87, "timestamp": "00:25:20", "text": "这样更容易"}, {"type": "subtitle", "time": 1524.31, "timestamp": "00:25:24", "text": "与其让这个人来做，不如就让他来做吧。"}, {"type": "subtitle", "time": 1533.269, "timestamp": "00:25:33", "text": "好了，现在我们有了触发菜单"}, {"type": "subtitle", "time": 1535.669, "timestamp": "00:25:35", "text": "右手边"}, {"type": "subtitle", "time": 1538.149, "timestamp": "00:25:38", "text": "这"}, {"type": "subtitle", "time": 1545.029, "timestamp": "00:25:45", "text": "我们真的需要你"}, {"type": "subtitle", "time": 1547.75, "timestamp": "00:25:47", "text": "而不是这个关闭按钮"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "外面"}, {"type": "subtitle", "time": 1559.669, "timestamp": "00:25:59", "text": "如果这行不通的话，我该怎么办？"}]
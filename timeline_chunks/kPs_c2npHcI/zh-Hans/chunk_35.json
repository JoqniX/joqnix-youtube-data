[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "大概。"}, {"type": "subtitle", "time": 2102.31, "timestamp": "00:35:02", "text": "所以，你不需要向上滚动。你"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "点击这里那个小玩意儿，它会"}, {"type": "subtitle", "time": 2108.55, "timestamp": "00:35:08", "text": "上去，随便哪个部分"}, {"type": "subtitle", "time": 2110.39, "timestamp": "00:35:10", "text": "是。正确的？"}, {"type": "subtitle", "time": 2112.47, "timestamp": "00:35:12", "text": "所以我想到可以做类似的事情。"}, {"type": "subtitle", "time": 2114.55, "timestamp": "00:35:14", "text": "但我不知道具体该怎么做。"}, {"type": "subtitle", "time": 2116.79, "timestamp": "00:35:16", "text": "应该这样做。"}, {"type": "subtitle", "time": 2119.99, "timestamp": "00:35:19", "text": "我们会调查一下，但我相信"}, {"type": "subtitle", "time": 2122.87, "timestamp": "00:35:22", "text": "它现在已经出版了，或者如果我目前"}, {"type": "subtitle", "time": 2126.23, "timestamp": "00:35:26", "text": "它现在做这个，它做这个"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "如果我复制它的话"}, {"type": "subtitle", "time": 2133.27, "timestamp": "00:35:33", "text": "呃"}, {"type": "subtitle", "time": 2136.069, "timestamp": "00:35:36", "text": "它怎么了？是的，如果我是"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "等等，我看到了什么？是"}, {"type": "subtitle", "time": 2156.069, "timestamp": "00:35:56", "text": "而且很奇怪。是的，确实如此。哦，它"}]
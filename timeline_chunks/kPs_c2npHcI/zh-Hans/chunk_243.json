[{"type": "subtitle", "time": 14588.229, "timestamp": "04:03:08", "text": "好的。所以，这家伙必须离篮筐只有一个距离。"}, {"type": "subtitle", "time": 14596.95, "timestamp": "04:03:16", "text": "有人会接着说。你为什么选择"}, {"type": "subtitle", "time": 14599.269, "timestamp": "04:03:19", "text": "这样做？因为我感觉如此。"}, {"type": "subtitle", "time": 14601.75, "timestamp": "04:03:21", "text": "更好"}, {"type": "subtitle", "time": 14606.469, "timestamp": "04:03:26", "text": "总比什么都不做好。或者切掉。也许这就是"}, {"type": "subtitle", "time": 14614.79, "timestamp": "04:03:34", "text": "H：看起来不太好。"}, {"type": "subtitle", "time": 14639.71, "timestamp": "04:03:59", "text": "[笑声]"}]
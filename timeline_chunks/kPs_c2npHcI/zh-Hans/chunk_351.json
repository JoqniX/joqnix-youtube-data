[{"type": "subtitle", "time": 21064.07, "timestamp": "05:51:04", "text": "我当时就想，呃，因为我……我得到了"}, {"type": "subtitle", "time": 21066.23, "timestamp": "05:51:06", "text": "商品及服务税号。"}, {"type": "subtitle", "time": 21075.99, "timestamp": "05:51:15", "text": "我做了。我那样做是为了……"}, {"type": "subtitle", "time": 21079.83, "timestamp": "05:51:19", "text": "活期账户。不，银行说就像"}, {"type": "subtitle", "time": 21083.11, "timestamp": "05:51:23", "text": "呃，你得有消费税那玩意儿。"}, {"type": "subtitle", "time": 21094.628, "timestamp": "05:51:34", "text": "不，上面说他们就像在办公室里那样说的。"}, {"type": "subtitle", "time": 21096.788, "timestamp": "05:51:36", "text": "人们说他们会把《像内尔一样》放上去。"}, {"type": "subtitle", "time": 21106.31, "timestamp": "05:51:46", "text": "我的天啊。"}]
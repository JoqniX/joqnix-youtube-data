[{"type": "subtitle", "time": 4204.79, "timestamp": "01:10:04", "text": "你好。我先……呃，我们现在切换到……"}, {"type": "subtitle", "time": 4208.149, "timestamp": "01:10:08", "text": "我们切换到历史记录页面吧。如果"}, {"type": "subtitle", "time": 4210.79, "timestamp": "01:10:10", "text": "还有什么需要放进去的吗？"}, {"type": "subtitle", "time": 4213.189, "timestamp": "01:10:13", "text": "在“关于”页面的个人资料里，我可以放"}, {"type": "subtitle", "time": 4216.79, "timestamp": "01:10:16", "text": "以后再说。但就像尝试做历史一样。"}, {"type": "subtitle", "time": 4219.51, "timestamp": "01:10:19", "text": "我猜也是。"}, {"type": "subtitle", "time": 4224.07, "timestamp": "01:10:24", "text": "呃，我也很害怕管理员们会……"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "请删除我的页面，因为现在"}, {"type": "subtitle", "time": 4231.11, "timestamp": "01:10:31", "text": "我并没有遵循传统。"}, {"type": "subtitle", "time": 4235.59, "timestamp": "01:10:35", "text": "维基百科的传统格式。"}, {"type": "subtitle", "time": 4239.11, "timestamp": "01:10:39", "text": "我有点像是在做扩展。"}, {"type": "subtitle", "time": 4241.91, "timestamp": "01:10:41", "text": "版本之类的东西。所以如果你"}, {"type": "subtitle", "time": 4246.709, "timestamp": "01:10:46", "text": "比如要查一下Kayagi之类的。"}, {"type": "subtitle", "time": 4250.149, "timestamp": "01:10:50", "text": "就像企业 YouTuber 一样，他们只有"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "现在这里这样的事情不多，但我有点……"}, {"type": "subtitle", "time": 4256.229, "timestamp": "01:10:56", "text": "扩展了一些内容"}, {"type": "subtitle", "time": 4258.229, "timestamp": "01:10:58", "text": "但我加入了自己的部分，"}]
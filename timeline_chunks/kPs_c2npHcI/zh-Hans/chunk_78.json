[{"type": "subtitle", "time": 4680.31, "timestamp": "01:18:00", "text": "向上写就像描述什么什么"}, {"type": "subtitle", "time": 4682.55, "timestamp": "01:18:02", "text": "水烟就是一切。如果您点击"}, {"type": "subtitle", "time": 4685.91, "timestamp": "01:18:05", "text": "关于它的历史"}, {"type": "subtitle", "time": 4691.27, "timestamp": "01:18:11", "text": "他们这样评价她，就像……你可以这么说"}, {"type": "subtitle", "time": 4694.95, "timestamp": "01:18:14", "text": "就像CMS项目一样。它们有过滤功能"}, {"type": "subtitle", "time": 4697.11, "timestamp": "01:18:17", "text": "这边。"}, {"type": "subtitle", "time": 4700.87, "timestamp": "01:18:20", "text": "所以，2028年之前发生的事件"}, {"type": "subtitle", "time": 4704.55, "timestamp": "01:18:24", "text": "等到2028年，而不是2018年"}, {"type": "subtitle", "time": 4706.95, "timestamp": "01:18:26", "text": "将显示在此处。向下滚动时"}, {"type": "subtitle", "time": 4709.75, "timestamp": "01:18:29", "text": "你看，就像不一样"}, {"type": "subtitle", "time": 4711.99, "timestamp": "01:18:31", "text": "不同的"}, {"type": "subtitle", "time": 4716.47, "timestamp": "01:18:36", "text": "东西对。所以就我而言，而不是"}, {"type": "subtitle", "time": 4720.63, "timestamp": "01:18:40", "text": "图片里有文字。"}, {"type": "subtitle", "time": 4722.87, "timestamp": "01:18:42", "text": "哦"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "我没有图片，只有文字。"}, {"type": "subtitle", "time": 4729.35, "timestamp": "01:18:49", "text": "所以"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "是的，我正打算跟进"}, {"type": "subtitle", "time": 4735.669, "timestamp": "01:18:55", "text": "格式相同，但在某种程度上……"}, {"type": "subtitle", "time": 4737.91, "timestamp": "01:18:57", "text": "未来我们可以改变现状。所以不"}]
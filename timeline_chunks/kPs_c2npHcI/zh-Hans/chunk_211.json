[{"type": "subtitle", "time": 12680.15, "timestamp": "03:31:20", "text": "呃，大概一个吧。是的。那就是"}, {"type": "subtitle", "time": 12682.63, "timestamp": "03:31:22", "text": "更好的？"}, {"type": "subtitle", "time": 12690.87, "timestamp": "03:31:30", "text": "你好。考试。"}, {"type": "subtitle", "time": 12704.15, "timestamp": "03:31:44", "text": "我一练习日语，"}, {"type": "subtitle", "time": 12707.51, "timestamp": "03:31:47", "text": "我向TIA询问了课程相关事宜。他们是"}, {"type": "subtitle", "time": 12710.95, "timestamp": "03:31:50", "text": "例如，“我们会通知你。”他们还没有"}, {"type": "subtitle", "time": 12714.55, "timestamp": "03:31:54", "text": "请告诉我。我呃，就像在1号问的"}, {"type": "subtitle", "time": 12718.63, "timestamp": "03:31:58", "text": "七月。没有回应。他们告诉我"}]
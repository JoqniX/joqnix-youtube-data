[{"type": "subtitle", "time": 19037.67, "timestamp": "05:17:17", "text": "2018年、"}, {"type": "subtitle", "time": 19045.11, "timestamp": "05:17:25", "text": "次にドクターに尋ねられたら、"}, {"type": "subtitle", "time": 19049.03, "timestamp": "05:17:29", "text": "君はそれを作るつもりなの？"}, {"type": "subtitle", "time": 19051.43, "timestamp": "05:17:31", "text": "その質問に対する私の答えは「はい」です。"}, {"type": "subtitle", "time": 19054.628, "timestamp": "05:17:34", "text": "知らない。"}]
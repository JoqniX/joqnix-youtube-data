[{"type": "subtitle", "time": 8342.15, "timestamp": "02:19:02", "text": "ああ、確かにそうしました。高さ1倍"}, {"type": "subtitle", "time": 8345.75, "timestamp": "02:19:05", "text": "フレックスプロックスゴー。ああ、マージンが左端に1つあります。"}, {"type": "subtitle", "time": 8347.669, "timestamp": "02:19:07", "text": "わかった。"}, {"type": "subtitle", "time": 8361.19, "timestamp": "02:19:21", "text": "ゼロ。"}, {"type": "subtitle", "time": 8364.549, "timestamp": "02:19:24", "text": "ああ、あなたはここにいたんですね。ああ、なんてことだ、彼は"}, {"type": "subtitle", "time": 8366.549, "timestamp": "02:19:26", "text": "ここ。"}, {"type": "subtitle", "time": 8370.309, "timestamp": "02:19:30", "text": "彼が戻ってきた。わーい。"}, {"type": "subtitle", "time": 8373.27, "timestamp": "02:19:33", "text": "高さ1ピクセル。"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "ああ、フレックスグローをしなくちゃいけない"}]
[{"type": "subtitle", "time": 4320.39, "timestamp": "01:12:00", "text": "だから私は最善を尽くしてそれを書こうとした"}, {"type": "subtitle", "time": 4322.07, "timestamp": "01:12:02", "text": "中立的に。"}, {"type": "subtitle", "time": 4324.55, "timestamp": "01:12:04", "text": "何が大変だったのかさえ分からなかった"}, {"type": "subtitle", "time": 4328.55, "timestamp": "01:12:08", "text": "私の好きなものと嫌いなものは何ですか。かかった"}, {"type": "subtitle", "time": 4332.39, "timestamp": "01:12:12", "text": "しばらく時間がかかりましたが、私はそれを理解して書きました"}, {"type": "subtitle", "time": 4333.91, "timestamp": "01:12:13", "text": "何か。"}, {"type": "subtitle", "time": 4337.03, "timestamp": "01:12:17", "text": "初めてスライスを作ったときに気づいた"}, {"type": "subtitle", "time": 4339.189, "timestamp": "01:12:19", "text": "スライドとかそういうのもあるし、"}, {"type": "subtitle", "time": 4343.51, "timestamp": "01:12:23", "text": "これらを正しく書いて、表示します"}, {"type": "subtitle", "time": 4351.669, "timestamp": "01:12:31", "text": "そうそう。とにかく、歴史について話そう"}, {"type": "subtitle", "time": 4354.39, "timestamp": "01:12:34", "text": "一部。えっと、歴史はどこにあるの？"}, {"type": "subtitle", "time": 4357.99, "timestamp": "01:12:37", "text": "こんにちは。だから、新しいものを作る必要があると思う"}, {"type": "chat", "time": 4359.328, "timestamp": "01:12:39", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "I'll read it after the stream and we'll talk about it"}, {"type": "subtitle", "time": 4360.95, "timestamp": "01:12:40", "text": "ページ。だから、私たちの判断はほぼ正しかったと言えるでしょう。私はしません"}, {"type": "subtitle", "time": 4364.47, "timestamp": "01:12:44", "text": "再現できると思う。だから、私はただ"}, {"type": "subtitle", "time": 4372.149, "timestamp": "01:12:52", "text": "配信が終わったら読みます。こんにちは。えっと、新しい"}, {"type": "subtitle", "time": 4374.95, "timestamp": "01:12:54", "text": "ページは"}]
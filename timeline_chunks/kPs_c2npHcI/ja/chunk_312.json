[{"type": "subtitle", "time": 18723.03, "timestamp": "05:12:03", "text": "実際、とても良いですよ。何てことだ。"}, {"type": "subtitle", "time": 18726.47, "timestamp": "05:12:06", "text": "また、削除する必要があるのは"}, {"type": "subtitle", "time": 18729.11, "timestamp": "05:12:09", "text": "今気づいた"}, {"type": "subtitle", "time": 18731.51, "timestamp": "05:12:11", "text": "段落を削除する必要があります"}, {"type": "subtitle", "time": 18756.15, "timestamp": "05:12:36", "text": "ああ、まだ終わってないよ。私たちは忘れていました"}, {"type": "subtitle", "time": 18759.91, "timestamp": "05:12:39", "text": "2024年と2025年にやらなければならない。"}, {"type": "subtitle", "time": 18774.73, "timestamp": "05:12:54", "text": "新しい芯"}]
[{"type": "subtitle", "time": 14701.75, "timestamp": "04:05:01", "text": "767ブレークポイントにいるときは、"}, {"type": "subtitle", "time": 14720.63, "timestamp": "04:05:20", "text": "幅を持たせたくありません。"}, {"type": "subtitle", "time": 14722.309, "timestamp": "04:05:22", "text": "その代わり"}, {"type": "subtitle", "time": 14726.79, "timestamp": "04:05:26", "text": "私はそれが欲しいし、それを持っていたい"}, {"type": "subtitle", "time": 14729.83, "timestamp": "04:05:29", "text": "である"}, {"type": "subtitle", "time": 14736.389, "timestamp": "04:05:36", "text": "このように中央に切り込んでいく。となることによって"}, {"type": "subtitle", "time": 14739.91, "timestamp": "04:05:39", "text": "つまり、ここではこうなりますが、モバイルではこうなります"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "あるいは、こうできるかもしれない"}, {"type": "subtitle", "time": 14751.67, "timestamp": "04:05:51", "text": "持っている"}]
[{"type": "subtitle", "time": 11102.79, "timestamp": "03:05:02", "text": "私はここにいた。アイコン化する。"}, {"type": "subtitle", "time": 11105.67, "timestamp": "03:05:05", "text": "わかった。リンク。"}, {"type": "subtitle", "time": 11107.99, "timestamp": "03:05:07", "text": "リンク"}, {"type": "subtitle", "time": 11110.23, "timestamp": "03:05:10", "text": "えっと、リンク"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "矢印。"}, {"type": "subtitle", "time": 11132.23, "timestamp": "03:05:32", "text": "いいえ。"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "ああ、ハイパー。わかった。リンクはスキルアイコンかもしれません"}, {"type": "subtitle", "time": 11155.269, "timestamp": "03:05:55", "text": "何てことだ。わかった、いいよ。リンクアイコン"}]
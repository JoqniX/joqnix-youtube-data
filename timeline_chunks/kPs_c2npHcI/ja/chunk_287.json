[{"type": "subtitle", "time": 17220.708, "timestamp": "04:47:00", "text": "ええ、そこにはありません。わかった。えっと"}, {"type": "subtitle", "time": 17222.708, "timestamp": "04:47:02", "text": "ええ、こういうのも追加できます"}, {"type": "subtitle", "time": 17226.07, "timestamp": "04:47:06", "text": "星もね。"}, {"type": "subtitle", "time": 17229.51, "timestamp": "04:47:09", "text": "では、開けてみましょう。"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "そして、それを開けさせてください。"}, {"type": "subtitle", "time": 17233.99, "timestamp": "04:47:13", "text": "えっと"}, {"type": "subtitle", "time": 17236.15, "timestamp": "04:47:16", "text": "ああ、こんな時は、"}, {"type": "subtitle", "time": 17239.35, "timestamp": "04:47:19", "text": "私のモデルを公開するだけですが、"}, {"type": "subtitle", "time": 17241.35, "timestamp": "04:47:21", "text": "できません。"}, {"type": "subtitle", "time": 17246.55, "timestamp": "04:47:26", "text": "ああ、もし私がそうしたら、私はリスクを負うことになる"}, {"type": "subtitle", "time": 17250.708, "timestamp": "04:47:30", "text": "リスクを冒す、つまり、失うことさえ覚悟する。"}, {"type": "subtitle", "time": 17254.55, "timestamp": "04:47:34", "text": "それでいいんです。ポリゴン、"}, {"type": "subtitle", "time": 17256.868, "timestamp": "04:47:36", "text": "4つもらってもいいですか？"}, {"type": "subtitle", "time": 17260.788, "timestamp": "04:47:40", "text": "ああ、そういうのもあるよね。"}, {"type": "subtitle", "time": 17263.27, "timestamp": "04:47:43", "text": "ポリゴンがたくさんあるので"}, {"type": "subtitle", "time": 17266.55, "timestamp": "04:47:46", "text": "そこには。星形。"}, {"type": "subtitle", "time": 17269.19, "timestamp": "04:47:49", "text": "他に何かありますか？"}, {"type": "subtitle", "time": 17276.34, "timestamp": "04:47:56", "text": "えっと"}]
[{"type": "subtitle", "time": 5224.87, "timestamp": "01:27:04", "text": "はぁ。じゃあ、もし私が並べ替えたら"}, {"type": "subtitle", "time": 5228.47, "timestamp": "01:27:08", "text": "ストリーム、これをクリックすると表示されますか"}, {"type": "subtitle", "time": 5234.79, "timestamp": "01:27:14", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 5242.229, "timestamp": "01:27:22", "text": "いや、いや、いや。私は何をしたの？私は何をしたのか"}, {"type": "subtitle", "time": 5246.95, "timestamp": "01:27:26", "text": "する？もし私が8月に行ったらどうなるでしょうか？"}, {"type": "subtitle", "time": 5250.55, "timestamp": "01:27:30", "text": "ああ、スケジュールストリームが表示されているんですね。"}, {"type": "subtitle", "time": 5252.47, "timestamp": "01:27:32", "text": "いいえ、表示されません。わかった。わかった。彼らは私"}, {"type": "subtitle", "time": 5255.51, "timestamp": "01:27:35", "text": "スケジュールを組まなければならない。わかった。わかった。おお、"}, {"type": "subtitle", "time": 5259.11, "timestamp": "01:27:39", "text": "これは良い考えだ。わかった、わかった"}, {"type": "subtitle", "time": 5261.35, "timestamp": "01:27:41", "text": "何をするかアイデアを考えている"}, {"type": "subtitle", "time": 5267.189, "timestamp": "01:27:47", "text": "何ができるか、いくつかアイデアが浮かんできました"}, {"type": "subtitle", "time": 5269.91, "timestamp": "01:27:49", "text": "これで。"}, {"type": "subtitle", "time": 5271.75, "timestamp": "01:27:51", "text": "えっと"}, {"type": "subtitle", "time": 5273.59, "timestamp": "01:27:53", "text": "うん、いくつかアイデアが浮かんでくるよ"}, {"type": "subtitle", "time": 5276.149, "timestamp": "01:27:56", "text": "こういうものには対処する。どちらか私が"}, {"type": "subtitle", "time": 5279.59, "timestamp": "01:27:59", "text": "Notionのカレンダービューを使用できます。"}]
[{"type": "subtitle", "time": 13877.75, "timestamp": "03:51:17", "text": "えっと、これを短くすることもできます。私たちはそうしません"}, {"type": "subtitle", "time": 13881.51, "timestamp": "03:51:21", "text": "それを入れる必要がある。または別のアイデアは"}, {"type": "subtitle", "time": 13886.07, "timestamp": "03:51:26", "text": "耳ですよね？耳は私ができること"}, {"type": "subtitle", "time": 13889.91, "timestamp": "03:51:29", "text": "背景や境界線のように配置されます"}, {"type": "subtitle", "time": 13895.269, "timestamp": "03:51:35", "text": "境界線 境界線 境界線半径 何か"}, {"type": "subtitle", "time": 13898.87, "timestamp": "03:51:38", "text": "枠線の幅。"}, {"type": "subtitle", "time": 13900.63, "timestamp": "03:51:40", "text": "それは耳のようになるでしょう"}, {"type": "subtitle", "time": 13902.63, "timestamp": "03:51:42", "text": "別々に表示され、テキストも別々に表示されます。それは"}, {"type": "subtitle", "time": 13905.91, "timestamp": "03:51:45", "text": "それはやりすぎでしょうか？"}]
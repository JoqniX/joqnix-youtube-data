[{"type": "subtitle", "time": 3300.309, "timestamp": "00:55:00", "text": "ああ、そうだね。これを置かなければならない"}, {"type": "subtitle", "time": 3310.549, "timestamp": "00:55:10", "text": "重要な日を記入しました。ああ、そうだ、"}, {"type": "subtitle", "time": 3312.87, "timestamp": "00:55:12", "text": "コラボレーションみたいな感じで作った"}, {"type": "subtitle", "time": 3315.51, "timestamp": "00:55:15", "text": "これまで一緒に仕事をしてきたすべての人々"}, {"type": "subtitle", "time": 3318.71, "timestamp": "00:55:18", "text": "そういう類のもの。私は変わる必要があると思う"}, {"type": "subtitle", "time": 3322.23, "timestamp": "00:55:22", "text": "そのうちのいくつかは、今では"}, {"type": "subtitle", "time": 3325.03, "timestamp": "00:55:25", "text": "企業系ユーチューバー"}, {"type": "subtitle", "time": 3328.309, "timestamp": "00:55:28", "text": "えーと、ここにいる一部の企業系ユーチューバーは"}, {"type": "subtitle", "time": 3331.99, "timestamp": "00:55:31", "text": "ある意味、独立した存在になった。"}, {"type": "subtitle", "time": 3335.27, "timestamp": "00:55:35", "text": "だから、これは悪い方法だと思う"}, {"type": "subtitle", "time": 3338.15, "timestamp": "00:55:38", "text": "おそらく表現していると思います"}, {"type": "subtitle", "time": 3340.87, "timestamp": "00:55:40", "text": "また、VO YouTuberをここに載せる必要があります"}, {"type": "subtitle", "time": 3344.069, "timestamp": "00:55:44", "text": "まあ、ここはインドのYouTuberにとって良い場所ですね。"}, {"type": "subtitle", "time": 3347.19, "timestamp": "00:55:47", "text": "ええ、私が今これをやった理由は"}, {"type": "subtitle", "time": 3350.87, "timestamp": "00:55:50", "text": "ある意味では、私は期待していた"}, {"type": "subtitle", "time": 3354.87, "timestamp": "00:55:54", "text": "誰かがチェックして、"}, {"type": "subtitle", "time": 3357.27, "timestamp": "00:55:57", "text": "Google検索などで名前が表示されるようになりました。"}]
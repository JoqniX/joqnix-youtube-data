[{"type": "subtitle", "time": 14487.59, "timestamp": "04:01:27", "text": "ああ神様の興味深い質問。"}, {"type": "subtitle", "time": 14493.349, "timestamp": "04:01:33", "text": "面白い。"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "[音楽]"}, {"type": "subtitle", "time": 14499.11, "timestamp": "04:01:39", "text": "面白い。"}, {"type": "subtitle", "time": 14502.71, "timestamp": "04:01:42", "text": "あなたにはそんなことをしてほしくない。ありがとう"}, {"type": "subtitle", "time": 14509.189, "timestamp": "04:01:49", "text": "よしよしよし。リム1本。"}, {"type": "subtitle", "time": 14513.189, "timestamp": "04:01:53", "text": "うん、このリムを1つ付けて。あ、待って。半径"}, {"type": "subtitle", "time": 14519.99, "timestamp": "04:01:59", "text": "えっと、"}]
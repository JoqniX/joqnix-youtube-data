[{"type": "subtitle", "time": 15.99, "timestamp": "00:00:15", "text": "私の声は聞こえていますか？私の声がちゃんと聞こえているといいのですが。"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "えっと、ちょっと待ってください。もう一度確認させてください"}, {"type": "subtitle", "time": 21.349, "timestamp": "00:00:21", "text": "生放送中です。"}, {"type": "subtitle", "time": 24.63, "timestamp": "00:00:24", "text": "そうであるべきでしょう。こんにちは。"}, {"type": "subtitle", "time": 28.95, "timestamp": "00:00:28", "text": "皆さん、こんにちは。ようこそ。ようこそ"}, {"type": "subtitle", "time": 35.43, "timestamp": "00:00:35", "text": "22."}, {"type": "subtitle", "time": 40.069, "timestamp": "00:00:40", "text": "えっと、皆さんお元気ですか？"}, {"type": "subtitle", "time": 42.549, "timestamp": "00:00:42", "text": "皆さん、この素晴らしい状況でいかがお過ごしですか？"}, {"type": "subtitle", "time": 46.15, "timestamp": "00:00:46", "text": "夕方/夜？"}, {"type": "subtitle", "time": 48.389, "timestamp": "00:00:48", "text": "こんにちは。"}, {"type": "subtitle", "time": 55.43, "timestamp": "00:00:55", "text": "今日は、えっと、私はそうじゃない"}, {"type": "subtitle", "time": 57.51, "timestamp": "00:00:57", "text": "気分は良いです。"}]
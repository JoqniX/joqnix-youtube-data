[{"type": "subtitle", "time": 13387.67, "timestamp": "03:43:07", "text": "ああ、また別の問題が発生した。おお、おお"}, {"type": "subtitle", "time": 13412.389, "timestamp": "03:43:32", "text": "ああ、もう本当に頭が痛い。ああ、"}, {"type": "subtitle", "time": 13414.469, "timestamp": "03:43:34", "text": "神。"}, {"type": "subtitle", "time": 13422.79, "timestamp": "03:43:42", "text": "これでそれはスパンになります。"}, {"type": "subtitle", "time": 13424.389, "timestamp": "03:43:44", "text": "なし。"}, {"type": "subtitle", "time": 13427.11, "timestamp": "03:43:47", "text": "君にはスパンになってほしくない。何"}, {"type": "subtitle", "time": 13429.67, "timestamp": "03:43:49", "text": "スパンですか？"}, {"type": "subtitle", "time": 13431.91, "timestamp": "03:43:51", "text": "テキストコンテナであることは分かっていますが、"}, {"type": "subtitle", "time": 13433.75, "timestamp": "03:43:53", "text": "テキストになってほしくない"}, {"type": "subtitle", "time": 13438.229, "timestamp": "03:43:58", "text": "容器。何てことだ。"}]
[{"type": "subtitle", "time": 17284.15, "timestamp": "04:48:04", "text": "ええ、だいたいこんな感じです。ああ、ほとんどの場合は"}, {"type": "subtitle", "time": 17289.03, "timestamp": "04:48:09", "text": "実際はこんな感じです。ああ、神様。わかった。"}, {"type": "subtitle", "time": 17292.07, "timestamp": "04:48:12", "text": "えっと、"}, {"type": "subtitle", "time": 17295.35, "timestamp": "04:48:15", "text": "うーん、これは珍しいですね。これは稀なことだ。ああ、私は"}, {"type": "subtitle", "time": 17298.708, "timestamp": "04:48:18", "text": "それが珍しいことだと今気づいた。ああ、彼らは"}, {"type": "subtitle", "time": 17301.91, "timestamp": "04:48:21", "text": "これを選びました。私の母はオーと一緒に行った、"}, {"type": "subtitle", "time": 17303.99, "timestamp": "04:48:23", "text": "待って、待って、待って。私は作れると思う"}, {"type": "subtitle", "time": 17311.19, "timestamp": "04:48:31", "text": "えっと"}, {"type": "subtitle", "time": 17314.628, "timestamp": "04:48:34", "text": "うん、どちらかというとこんな感じかな"}, {"type": "subtitle", "time": 17317.51, "timestamp": "04:48:37", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 17325.83, "timestamp": "04:48:45", "text": "そう、まるでこのダイヤモンドみたいなものだ。"}, {"type": "subtitle", "time": 17328.788, "timestamp": "04:48:48", "text": "カードでは何て呼ばれてるの？スペード。私"}, {"type": "subtitle", "time": 17331.43, "timestamp": "04:48:51", "text": "わからない。ダイヤモンドですよね？ええ、そうです"}, {"type": "subtitle", "time": 17334.55, "timestamp": "04:48:54", "text": "ダイヤモンドのような。"}, {"type": "subtitle", "time": 17339.03, "timestamp": "04:48:59", "text": "今気づいたんだけど、まるでダイヤモンドみたいだ。"}]
[{"type": "subtitle", "time": 11521.91, "timestamp": "03:12:01", "text": "私に言わないで"}, {"type": "subtitle", "time": 11527.67, "timestamp": "03:12:07", "text": "ああ、彼らはそれを持っている。おお、いいね。彼らは持っている"}, {"type": "subtitle", "time": 11534.63, "timestamp": "03:12:14", "text": "[音楽]"}, {"type": "subtitle", "time": 11536.55, "timestamp": "03:12:16", "text": "ああ、これは無料です。わかりました、これをいただきます。"}, {"type": "subtitle", "time": 11538.309, "timestamp": "03:12:18", "text": "ありがとう。"}, {"type": "subtitle", "time": 11542.07, "timestamp": "03:12:22", "text": "やっとわかった。"}, {"type": "subtitle", "time": 11544.87, "timestamp": "03:12:24", "text": "コピー。"}, {"type": "subtitle", "time": 11564.79, "timestamp": "03:12:44", "text": "彼らは"}]
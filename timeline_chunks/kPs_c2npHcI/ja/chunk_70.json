[{"type": "subtitle", "time": 4204.79, "timestamp": "01:10:04", "text": "こんにちは。とりあえず、"}, {"type": "subtitle", "time": 4208.149, "timestamp": "01:10:08", "text": "履歴ページに切り替えましょうか。もし"}, {"type": "subtitle", "time": 4210.79, "timestamp": "01:10:10", "text": "何か入れるものはありますか"}, {"type": "subtitle", "time": 4213.189, "timestamp": "01:10:13", "text": "プロフィール、概要ページに、"}, {"type": "subtitle", "time": 4216.79, "timestamp": "01:10:16", "text": "それは後で。でも歴史をやってみよう"}, {"type": "subtitle", "time": 4219.51, "timestamp": "01:10:19", "text": "私は推測する。"}, {"type": "subtitle", "time": 4224.07, "timestamp": "01:10:24", "text": "えっと、管理者が"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "私のページを削除してください。"}, {"type": "subtitle", "time": 4231.11, "timestamp": "01:10:31", "text": "私は伝統にあまり従わなかった"}, {"type": "subtitle", "time": 4235.59, "timestamp": "01:10:35", "text": "ウィキの伝統的な形式。"}, {"type": "subtitle", "time": 4239.11, "timestamp": "01:10:39", "text": "私は拡張のようなものを作りました"}, {"type": "subtitle", "time": 4241.91, "timestamp": "01:10:41", "text": "バージョンとか、そういう類のもの。だからもしあなたが"}, {"type": "subtitle", "time": 4246.709, "timestamp": "01:10:46", "text": "例えば、カヤギさんをチェックするところでした"}, {"type": "subtitle", "time": 4250.149, "timestamp": "01:10:50", "text": "まるで企業系YouTuberのように、彼らは"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "今ここにあるものは少ないけど、私は"}, {"type": "subtitle", "time": 4256.229, "timestamp": "01:10:56", "text": "いくつかのことを拡張しました"}, {"type": "subtitle", "time": 4258.229, "timestamp": "01:10:58", "text": "でも私は自分のセクションを追加して"}]
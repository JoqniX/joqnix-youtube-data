[{"type": "subtitle", "time": 16265.67, "timestamp": "04:31:05", "text": "えっと、2つ目を入れてください。そうそう、"}, {"type": "subtitle", "time": 16267.99, "timestamp": "04:31:07", "text": "2つ目はもっと大きいものになるだろう。はい、それは"}, {"type": "subtitle", "time": 16294.07, "timestamp": "04:31:34", "text": "はい、どうぞ。ニース。"}, {"type": "subtitle", "time": 16296.55, "timestamp": "04:31:36", "text": "これは必要ない。"}, {"type": "subtitle", "time": 16299.11, "timestamp": "04:31:39", "text": "つまり、リスト全体は必要ないんです"}, {"type": "subtitle", "time": 16300.95, "timestamp": "04:31:40", "text": "アイテム"}, {"type": "subtitle", "time": 16307.83, "timestamp": "04:31:47", "text": "わーい。 2020年は終わった。たとえあなたが"}, {"type": "subtitle", "time": 16309.75, "timestamp": "04:31:49", "text": "これ、"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "見た目は不自然になるだろうが、修正するつもりだ。"}, {"type": "subtitle", "time": 16315.75, "timestamp": "04:31:55", "text": "心配しないで。"}]
[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "おそらく。"}, {"type": "subtitle", "time": 2102.31, "timestamp": "00:35:02", "text": "だから、上にスクロールする必要はありません。あなた"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "ここにあるボタンをクリックすると、"}, {"type": "subtitle", "time": 2108.55, "timestamp": "00:35:08", "text": "とにかく、そのセクションを上に進んでください"}, {"type": "subtitle", "time": 2110.39, "timestamp": "00:35:10", "text": "は。右？"}, {"type": "subtitle", "time": 2112.47, "timestamp": "00:35:12", "text": "そこで私は次のようなことを考えました"}, {"type": "subtitle", "time": 2114.55, "timestamp": "00:35:14", "text": "でも、具体的にどうすればいいのかわからない"}, {"type": "subtitle", "time": 2116.79, "timestamp": "00:35:16", "text": "そうすべきだ。"}, {"type": "subtitle", "time": 2119.99, "timestamp": "00:35:19", "text": "調べてみますが、ええ、そう思います"}, {"type": "subtitle", "time": 2122.87, "timestamp": "00:35:22", "text": "公開済みか、現在"}, {"type": "subtitle", "time": 2126.23, "timestamp": "00:35:26", "text": "これはこれをします、今はこれをします"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "もし私がそれを複製するとしたら"}, {"type": "subtitle", "time": 2133.27, "timestamp": "00:35:33", "text": "そして、えーと"}, {"type": "subtitle", "time": 2136.069, "timestamp": "00:35:36", "text": "これはどうなったの？ええ、もし私が"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "待って、待って、私は何を見たの？は"}, {"type": "subtitle", "time": 2156.069, "timestamp": "00:35:56", "text": "そして、奇妙だ。ええ、そうですね。ああ、それは"}]
[{"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "目標なし、または目標なし。法律は回避する"}, {"type": "subtitle", "time": 18613.91, "timestamp": "05:10:13", "text": "メニュー欄は空白です。"}, {"type": "subtitle", "time": 18616.31, "timestamp": "05:10:16", "text": "悪い。わかった。デフォルト。同じように開きます"}, {"type": "subtitle", "time": 18619.27, "timestamp": "05:10:19", "text": "リンクして、離れる必要は決してありません"}, {"type": "subtitle", "time": 18629.11, "timestamp": "05:10:29", "text": "わかった。ええと、歴史ですよね？"}, {"type": "subtitle", "time": 18632.628, "timestamp": "05:10:32", "text": "投稿します。公開 公開"}, {"type": "subtitle", "time": 18635.27, "timestamp": "05:10:35", "text": "それ。そこにあるはずだ。"}, {"type": "subtitle", "time": 18637.11, "timestamp": "05:10:37", "text": "明日"}, {"type": "subtitle", "time": 18641.35, "timestamp": "05:10:41", "text": "つまり、今日は土曜日です。"}, {"type": "subtitle", "time": 18643.99, "timestamp": "05:10:43", "text": "ああ、もう午前2時だ。わかった。今日は"}, {"type": "subtitle", "time": 18647.67, "timestamp": "05:10:47", "text": "土曜日。そこで、私たちは"}, {"type": "subtitle", "time": 18649.83, "timestamp": "05:10:49", "text": "うん。私の出生と歴史は、ある意味"}, {"type": "subtitle", "time": 18651.75, "timestamp": "05:10:51", "text": "終わり。"}, {"type": "subtitle", "time": 18655.19, "timestamp": "05:10:55", "text": "明日は情報や"}, {"type": "subtitle", "time": 18657.43, "timestamp": "05:10:57", "text": "ガイドライン"}, {"type": "subtitle", "time": 18659.03, "timestamp": "05:10:59", "text": "ページ。"}]
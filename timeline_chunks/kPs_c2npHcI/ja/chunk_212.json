[{"type": "subtitle", "time": 12730.07, "timestamp": "03:32:10", "text": "[音楽]"}, {"type": "subtitle", "time": 12732.87, "timestamp": "03:32:12", "text": "だって今インドは"}, {"type": "subtitle", "time": 12735.11, "timestamp": "03:32:15", "text": "土曜日に旅行に行くか、"}, {"type": "subtitle", "time": 12745.99, "timestamp": "03:32:25", "text": "ああ、君が字も読めないことは知っているよ。おお、"}, {"type": "subtitle", "time": 12755.83, "timestamp": "03:32:35", "text": "君にはもう希望はない。そんなこと言わないで。"}, {"type": "subtitle", "time": 12759.11, "timestamp": "03:32:39", "text": "私は、パッチをすべて修正します"}]
[{"type": "subtitle", "time": 3422.39, "timestamp": "00:57:02", "text": "YouTuberのリンク？どれ？えっと"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "どれ？どれ？"}, {"type": "subtitle", "time": 3434.71, "timestamp": "00:57:14", "text": "わかった。えっと"}, {"type": "subtitle", "time": 3436.63, "timestamp": "00:57:16", "text": "ただ"}, {"type": "subtitle", "time": 3438.95, "timestamp": "00:57:18", "text": "えっと、仕事中"}, {"type": "chat", "time": 3448.814, "timestamp": "00:57:28", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "If you wish to check out the progress and help me fix bugs here's the site link - https://joqnix.space/ - the pages we working on can be accessed by the menu! "}, {"type": "subtitle", "time": 3449.67, "timestamp": "00:57:29", "text": "わかりました、私のウェブサイトのアドレスをお送りします。私"}, {"type": "subtitle", "time": 3453.43, "timestamp": "00:57:33", "text": "送信するのを忘れていました。じゃあ私は"}, {"type": "subtitle", "time": 3455.67, "timestamp": "00:57:35", "text": "このページを送るだけなら"}, {"type": "subtitle", "time": 3459.43, "timestamp": "00:57:39", "text": "えーと、えーと、欲しいのは"}, {"type": "chat", "time": 3463.747, "timestamp": "00:57:43", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "https://virtualyoutuber.fandom.com/wi..."}, {"type": "subtitle", "time": 3464.789, "timestamp": "00:57:44", "text": "えっと、このページをYouTubeに送ります"}, {"type": "subtitle", "time": 3467.91, "timestamp": "00:57:47", "text": "もしあなたがその物の名前を望むなら"}, {"type": "subtitle", "time": 3471.589, "timestamp": "00:57:51", "text": "一番下までスクロールしてください"}, {"type": "chat", "time": 3471.825, "timestamp": "00:57:51", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "no i meant later you can link them when they have their own fandom pages"}, {"type": "subtitle", "time": 3474.47, "timestamp": "00:57:54", "text": "コラボレーションと共にここに登場します"}, {"type": "subtitle", "time": 3476.71, "timestamp": "00:57:56", "text": "そして、これを最初に固定する必要がある"}]
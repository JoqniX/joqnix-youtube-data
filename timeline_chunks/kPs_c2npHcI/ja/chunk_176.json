[{"type": "subtitle", "time": 10566.55, "timestamp": "02:56:06", "text": "しかし、そこには疑問が生じる。どうすれば"}, {"type": "subtitle", "time": 10576.309, "timestamp": "02:56:16", "text": "ジョアトンのエントリーをここにどうやって入力すればいいですか？"}, {"type": "subtitle", "time": 10580.07, "timestamp": "02:56:20", "text": "私はこれをすることができますハイフンこれ"}, {"type": "subtitle", "time": 10582.87, "timestamp": "02:56:22", "text": "ハイフンと開始日終了日のように"}, {"type": "subtitle", "time": 10601.03, "timestamp": "02:56:41", "text": "[音楽]"}, {"type": "subtitle", "time": 10606.71, "timestamp": "02:56:46", "text": "待って。えっと、北極の話はしましたっけ？待って、"}, {"type": "subtitle", "time": 10619.429, "timestamp": "02:56:59", "text": "いいえ。"}]
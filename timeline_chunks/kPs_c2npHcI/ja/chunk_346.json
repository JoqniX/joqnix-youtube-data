[{"type": "subtitle", "time": 20770.23, "timestamp": "05:46:10", "text": "メインページには何も追加していません。私は必要としている"}, {"type": "subtitle", "time": 20772.868, "timestamp": "05:46:12", "text": "何かを追加する。"}, {"type": "subtitle", "time": 20776.23, "timestamp": "05:46:16", "text": "何を追加すればいいのか迷っています。"}, {"type": "subtitle", "time": 20780.628, "timestamp": "05:46:20", "text": "これらすべて、つまり、"}, {"type": "subtitle", "time": 20790.708, "timestamp": "05:46:30", "text": "うん。ホームページはこれになります。私はただ置いた"}, {"type": "subtitle", "time": 20793.35, "timestamp": "05:46:33", "text": "背景みたいなもの。私は"}, {"type": "subtitle", "time": 20795.43, "timestamp": "05:46:35", "text": "ソーシャルメディアアイコンを"}, {"type": "subtitle", "time": 20797.35, "timestamp": "05:46:37", "text": "底。"}, {"type": "subtitle", "time": 20799.59, "timestamp": "05:46:39", "text": "わからない。"}]
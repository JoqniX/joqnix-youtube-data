[{"type": "subtitle", "time": 17462.948, "timestamp": "04:51:02", "text": "ええ、ゆっくり進めましょう。 Sなので"}, {"type": "subtitle", "time": 17465.67, "timestamp": "04:51:05", "text": "モバイルのブレークポイントは何"}, {"type": "subtitle", "time": 17476.788, "timestamp": "04:51:16", "text": "私のアイデアは最初は私のアイデアは"}, {"type": "subtitle", "time": 17481.19, "timestamp": "04:51:21", "text": "この男は今、"}, {"type": "subtitle", "time": 17496.31, "timestamp": "04:51:36", "text": "そして"}, {"type": "subtitle", "time": 17499.51, "timestamp": "04:51:39", "text": "えーと置く"}, {"type": "subtitle", "time": 17502.868, "timestamp": "04:51:42", "text": "境界線に半径を設定する"}, {"type": "subtitle", "time": 17506.07, "timestamp": "04:51:46", "text": "代わりに、彼をそこに置くことができます"}, {"type": "subtitle", "time": 17508.39, "timestamp": "04:51:48", "text": "底"}]
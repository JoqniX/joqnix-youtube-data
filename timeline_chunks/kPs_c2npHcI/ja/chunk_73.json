[{"type": "subtitle", "time": 4381.59, "timestamp": "01:13:01", "text": "歴史を作り、私たちはそれを"}, {"type": "subtitle", "time": 4383.6, "timestamp": "01:13:03", "text": "それを 歴史"}, {"type": "subtitle", "time": 4386.56, "timestamp": "01:13:06", "text": "歴史 えーと"}, {"type": "subtitle", "time": 4388.08, "timestamp": "01:13:08", "text": "えーと 次は暗い"}, {"type": "subtitle", "time": 4394.79, "timestamp": "01:13:14", "text": "えーと"}, {"type": "subtitle", "time": 4403.99, "timestamp": "01:13:23", "text": "ふむ。そうそう。ページを作成できます"}, {"type": "subtitle", "time": 4406.95, "timestamp": "01:13:26", "text": "検索に含めるか除外するか"}, {"type": "subtitle", "time": 4410.149, "timestamp": "01:13:30", "text": "結果。実は、"}, {"type": "subtitle", "time": 4414.149, "timestamp": "01:13:34", "text": "えっと、私が含めたのは"}, {"type": "subtitle", "time": 4416.95, "timestamp": "01:13:36", "text": "ホームページ、"}, {"type": "subtitle", "time": 4418.95, "timestamp": "01:13:38", "text": "右？公式文書。それはどんな感じでしたか？"}, {"type": "subtitle", "time": 4423.669, "timestamp": "01:13:43", "text": "私を見て、私は自分が"}, {"type": "subtitle", "time": 4426.31, "timestamp": "01:13:46", "text": "とされる"}, {"type": "subtitle", "time": 4432.55, "timestamp": "01:13:52", "text": "えーっと、ページ全体を載せる"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "あるいは何かだけど、えっと"}]
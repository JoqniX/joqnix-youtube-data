[{"type": "subtitle", "time": 1503.269, "timestamp": "00:25:03", "text": "トークンを設計します"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "内側、内側。わかった。"}, {"type": "subtitle", "time": 1509.43, "timestamp": "00:25:09", "text": "ここに来て、ニゲーションに置いてあげる"}, {"type": "subtitle", "time": 1513.11, "timestamp": "00:25:13", "text": "おそらく私は代わりにそれを置くでしょうもちろん私は"}, {"type": "subtitle", "time": 1516.07, "timestamp": "00:25:16", "text": "別の方法でもできます。"}, {"type": "subtitle", "time": 1518.71, "timestamp": "00:25:18", "text": "ここに置いてください"}, {"type": "subtitle", "time": 1520.87, "timestamp": "00:25:20", "text": "そっちの方が簡単"}, {"type": "subtitle", "time": 1524.31, "timestamp": "00:25:24", "text": "この男ではなく、"}, {"type": "subtitle", "time": 1533.269, "timestamp": "00:25:33", "text": "よし、これでトリガーメニューができた"}, {"type": "subtitle", "time": 1535.669, "timestamp": "00:25:35", "text": "右を閉じる"}, {"type": "subtitle", "time": 1538.149, "timestamp": "00:25:38", "text": "これ"}, {"type": "subtitle", "time": 1545.029, "timestamp": "00:25:45", "text": "私たちはあなたを必要としています"}, {"type": "subtitle", "time": 1547.75, "timestamp": "00:25:47", "text": "この閉じるボタンの代わりに"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "外側"}, {"type": "subtitle", "time": 1559.669, "timestamp": "00:25:59", "text": "もしこれがうまくいかなかった場合、私が"}]
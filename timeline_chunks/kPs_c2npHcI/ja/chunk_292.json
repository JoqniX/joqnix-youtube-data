[{"type": "subtitle", "time": 17520.07, "timestamp": "04:52:00", "text": "私"}, {"type": "subtitle", "time": 17525.43, "timestamp": "04:52:05", "text": "悪くないね。私は"}, {"type": "subtitle", "time": 17532.23, "timestamp": "04:52:12", "text": "各間隔"}, {"type": "subtitle", "time": 17562.47, "timestamp": "04:52:42", "text": "うん。三つ。"}, {"type": "subtitle", "time": 17565.59, "timestamp": "04:52:45", "text": "それはうまくいくかもしれない。"}, {"type": "subtitle", "time": 17568.39, "timestamp": "04:52:48", "text": "何かおかしいと思いませんか？うん。私は"}, {"type": "subtitle", "time": 17571.75, "timestamp": "04:52:51", "text": "テキストを挿入します"}, {"type": "subtitle", "time": 17575.19, "timestamp": "04:52:55", "text": "真ん中。耳の部分は"}]
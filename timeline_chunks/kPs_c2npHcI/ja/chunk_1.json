[{"type": "subtitle", "time": 63.11, "timestamp": "00:01:03", "text": "またしても体調を崩してしまった。"}, {"type": "subtitle", "time": 71.83, "timestamp": "00:01:11", "text": "ああ、でも大丈夫です。でも私は好きになりたかった"}, {"type": "subtitle", "time": 74.789, "timestamp": "00:01:14", "text": "えーと、保留中の仕事を終わらせて"}, {"type": "subtitle", "time": 78.31, "timestamp": "00:01:18", "text": "私にとってそこにあるすべて"}, {"type": "subtitle", "time": 80.55, "timestamp": "00:01:20", "text": "仕上げる。"}, {"type": "subtitle", "time": 83.99, "timestamp": "00:01:23", "text": "だから、私は、えっと、平和を手に入れることができる"}, {"type": "subtitle", "time": 86.789, "timestamp": "00:01:26", "text": "心。また、これを"}, {"type": "subtitle", "time": 91.91, "timestamp": "00:01:31", "text": "リラックスする方法。"}, {"type": "subtitle", "time": 95.19, "timestamp": "00:01:35", "text": "うん、リラックスして、"}, {"type": "subtitle", "time": 98.069, "timestamp": "00:01:38", "text": "やりたいことなど"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "それで、"}, {"type": "subtitle", "time": 111.03, "timestamp": "00:01:51", "text": "えっと、ちょっと私にやらせてください。"}, {"type": "subtitle", "time": 112.18, "timestamp": "00:01:52", "text": "えっと、"}]
[{"type": "subtitle", "time": 1681.99, "timestamp": "00:28:01", "text": "えっと、それに基づいて、"}, {"type": "subtitle", "time": 1684.31, "timestamp": "00:28:04", "text": "男"}, {"type": "subtitle", "time": 1687.19, "timestamp": "00:28:07", "text": "天気予報のことですよね？ええ、できます"}, {"type": "subtitle", "time": 1691.59, "timestamp": "00:28:11", "text": "そのまま上に乗せる"}, {"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "この男の外側で。"}, {"type": "subtitle", "time": 1697.19, "timestamp": "00:28:17", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 1699.75, "timestamp": "00:28:19", "text": "だからそれを取得しようとしているのですが、"}, {"type": "subtitle", "time": 1702.07, "timestamp": "00:28:22", "text": "すぐにやります。"}, {"type": "subtitle", "time": 1704.63, "timestamp": "00:28:24", "text": "忘れられた重要なもの"}, {"type": "subtitle", "time": 1707.19, "timestamp": "00:28:27", "text": "それは"}, {"type": "subtitle", "time": 1710.95, "timestamp": "00:28:30", "text": "ボタンのID。"}, {"type": "subtitle", "time": 1713.59, "timestamp": "00:28:33", "text": "そのことを忘れてはいけません。ジョトン、私たちは"}, {"type": "subtitle", "time": 1716.71, "timestamp": "00:28:36", "text": "IDを入力してください"}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": "えっと、閉じるボタンには何が書いてありますか？"}, {"type": "subtitle", "time": 1723.51, "timestamp": "00:28:43", "text": "また？"}, {"type": "subtitle", "time": 1732.789, "timestamp": "00:28:52", "text": "きっと搭載されると思います。うん、これら"}, {"type": "subtitle", "time": 1736.149, "timestamp": "00:28:56", "text": "手に入れるでしょう。"}]
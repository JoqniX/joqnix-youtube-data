[{"type": "subtitle", "time": 2826.95, "timestamp": "00:47:06", "text": "よし、キャッチフレーズの件と"}, {"type": "subtitle", "time": 2831.109, "timestamp": "00:47:11", "text": "今のところ、すべてまあまあ大丈夫そうに見える。"}, {"type": "subtitle", "time": 2833.109, "timestamp": "00:47:13", "text": "キャッチフレーズとそれらの内容すべて、"}, {"type": "subtitle", "time": 2836.47, "timestamp": "00:47:16", "text": "右？問題なさそうですね。"}, {"type": "subtitle", "time": 2838.55, "timestamp": "00:47:18", "text": "えっと"}, {"type": "subtitle", "time": 2840.95, "timestamp": "00:47:20", "text": "うん、後でデザインするよ。でももしあなたが"}, {"type": "subtitle", "time": 2844.95, "timestamp": "00:47:24", "text": "アディチャンが手伝っていたのを見たい"}, {"type": "subtitle", "time": 2847.589, "timestamp": "00:47:27", "text": "実は、ウェブサイトは私が作ったものです。彼は"}, {"type": "subtitle", "time": 2850.47, "timestamp": "00:47:30", "text": "コンセプトみたいなもの。"}, {"type": "subtitle", "time": 2855.51, "timestamp": "00:47:35", "text": "えっと、皆さんにお見せしますね。えっと"}, {"type": "subtitle", "time": 2857.91, "timestamp": "00:47:37", "text": "ブラウザで開く。そして私はこれが本当に好きです"}, {"type": "subtitle", "time": 2861.67, "timestamp": "00:47:41", "text": "デザイン。より未来的だ"}, {"type": "subtitle", "time": 2863.589, "timestamp": "00:47:43", "text": "タイプ。"}, {"type": "subtitle", "time": 2867.27, "timestamp": "00:47:47", "text": "より未来的なタイプですね。右。"}, {"type": "subtitle", "time": 2870.79, "timestamp": "00:47:50", "text": "すごく未来的でかっこいい。私はしなければならない"}, {"type": "subtitle", "time": 2876.47, "timestamp": "00:47:56", "text": "作り方を学びましょう。 1秒。"}]
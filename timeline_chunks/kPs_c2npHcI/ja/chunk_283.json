[{"type": "subtitle", "time": 16981.11, "timestamp": "04:43:01", "text": "彼女のものは私の短いロゴを思い出させる。"}, {"type": "subtitle", "time": 16984.07, "timestamp": "04:43:04", "text": "これはXです。いいえ、"}, {"type": "subtitle", "time": 16987.67, "timestamp": "04:43:07", "text": "丸で囲まれたX。もし私がそれを変えるとしたら"}, {"type": "subtitle", "time": 16992.788, "timestamp": "04:43:12", "text": "上へ、彼女のようなスターを持つ、"}, {"type": "subtitle", "time": 16996.948, "timestamp": "04:43:16", "text": "きっとすごくクールだろうね。"}, {"type": "subtitle", "time": 16999.83, "timestamp": "04:43:19", "text": "わからない。"}, {"type": "subtitle", "time": 17002.23, "timestamp": "04:43:22", "text": "これは本当に素晴らしいウェブサイトですね。私"}, {"type": "subtitle", "time": 17013.35, "timestamp": "04:43:33", "text": "でも私について言えば、私は"}, {"type": "subtitle", "time": 17015.75, "timestamp": "04:43:35", "text": "星座。私は星でできている。それで"}, {"type": "subtitle", "time": 17018.55, "timestamp": "04:43:38", "text": "たぶん、"}, {"type": "subtitle", "time": 17021.43, "timestamp": "04:43:41", "text": "4.8点かな"}, {"type": "subtitle", "time": 17026.07, "timestamp": "04:43:46", "text": "星の模様を集めたもの、といったところでしょうか。"}, {"type": "subtitle", "time": 17029.43, "timestamp": "04:43:49", "text": "うん、大丈夫だと思うよ。ええ、今のところは"}, {"type": "subtitle", "time": 17032.708, "timestamp": "04:43:52", "text": "定型文のようなものを載せているだけです"}, {"type": "subtitle", "time": 17035.67, "timestamp": "04:43:55", "text": "基本的なものみたいな感じですね。テキストを挿入します"}, {"type": "subtitle", "time": 17037.59, "timestamp": "04:43:57", "text": "できるだけ多くのコンテンツ"}]
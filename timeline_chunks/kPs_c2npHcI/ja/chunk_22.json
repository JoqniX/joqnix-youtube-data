[{"type": "subtitle", "time": 1321.19, "timestamp": "00:22:01", "text": "交渉シート。わかった。ナギュエーションと"}, {"type": "subtitle", "time": 1324.07, "timestamp": "00:22:04", "text": "閉じるボタン。わかった。それでは、これから"}, {"type": "subtitle", "time": 1327.59, "timestamp": "00:22:07", "text": "コンテンツを掲載する前に、"}, {"type": "subtitle", "time": 1330.71, "timestamp": "00:22:10", "text": "アニメーショングループを配置する必要があります。"}, {"type": "subtitle", "time": 1333.669, "timestamp": "00:22:13", "text": "だから"}, {"type": "subtitle", "time": 1337.19, "timestamp": "00:22:17", "text": "オーバーレイをここにコピー＆ペーストします。それ"}, {"type": "subtitle", "time": 1341.75, "timestamp": "00:22:21", "text": "エラーが表示されます。いや、そうじゃなかったよ。ニース。"}, {"type": "subtitle", "time": 1345.75, "timestamp": "00:22:25", "text": "面白い。わかった。えっと、削除します"}, {"type": "subtitle", "time": 1347.669, "timestamp": "00:22:27", "text": "実際には、そう言っているのですが。私はただ置くことができます"}, {"type": "subtitle", "time": 1351.43, "timestamp": "00:22:31", "text": "ここに置いてください。そして、"}, {"type": "subtitle", "time": 1358.149, "timestamp": "00:22:38", "text": "これは基本的に"}, {"type": "subtitle", "time": 1360.39, "timestamp": "00:22:40", "text": "世間知らずだったってことだよね？"}, {"type": "subtitle", "time": 1374.07, "timestamp": "00:22:54", "text": "はい、どうぞ。まあ、一応やってみたよ。"}, {"type": "subtitle", "time": 1376.95, "timestamp": "00:22:56", "text": "ここをいくつか直さないといけない。しかし"}]
[{"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "メニューV4のトリガーボタンのようなもの。"}, {"type": "subtitle", "time": 1026.63, "timestamp": "00:17:06", "text": "ここに設置します。大丈夫。そして私たちは"}, {"type": "subtitle", "time": 1030.789, "timestamp": "00:17:10", "text": "えっと、ちょっと待って"}, {"type": "subtitle", "time": 1033.669, "timestamp": "00:17:13", "text": "ホバー時は非表示。えっと、選択してください。うん、同じ"}, {"type": "subtitle", "time": 1037.11, "timestamp": "00:17:17", "text": "もの。はい、スタイルをクリアできます。"}, {"type": "subtitle", "time": 1040.39, "timestamp": "00:17:20", "text": "もっと大きくなるだろうけど、問題ない。我々はできる"}, {"type": "subtitle", "time": 1043.669, "timestamp": "00:17:23", "text": "今は直すべきですね。"}, {"type": "subtitle", "time": 1046.63, "timestamp": "00:17:26", "text": "えっと、テキストを入力できると思います"}, {"type": "subtitle", "time": 1050.39, "timestamp": "00:17:30", "text": "実際、これについては。テキストを入力しなければなりません。"}, {"type": "subtitle", "time": 1053.83, "timestamp": "00:17:33", "text": "はい、わかりました。えっと"}, {"type": "subtitle", "time": 1067.27, "timestamp": "00:17:47", "text": "テキスト要素が必要です。する"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "ええと、どちらか一方が持っているべきだと思います。"}, {"type": "subtitle", "time": 1079.75, "timestamp": "00:17:59", "text": "どこにいるの？待って、私は以前は"}]
[{"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "天候や夜間の時間帯によって異なる。その"}, {"type": "chat", "time": 3062.383, "timestamp": "00:51:02", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "the logo looks supercool"}, {"type": "subtitle", "time": 3064.39, "timestamp": "00:51:04", "text": "このような。よし、これは"}, {"type": "subtitle", "time": 3068.15, "timestamp": "00:51:08", "text": "青みがかった夜のテーマのような"}, {"type": "subtitle", "time": 3071.349, "timestamp": "00:51:11", "text": "星座がちらほら見えたりとか。"}, {"type": "subtitle", "time": 3074.87, "timestamp": "00:51:14", "text": "月の顔のような絵を描いてみてはどうでしょうか。"}, {"type": "subtitle", "time": 3077.03, "timestamp": "00:51:17", "text": "もしかしたら、月の顔も載せられるかもしれませんね。"}, {"type": "subtitle", "time": 3079.589, "timestamp": "00:51:19", "text": "わからない。でも、そうですね、"}, {"type": "subtitle", "time": 3082.47, "timestamp": "00:51:22", "text": "それ。そして"}, {"type": "subtitle", "time": 3085.51, "timestamp": "00:51:25", "text": "午前中の部分では、"}, {"type": "subtitle", "time": 3087.91, "timestamp": "00:51:27", "text": "色は違うかもしれない、パステルカラーかも。これ"}, {"type": "subtitle", "time": 3091.03, "timestamp": "00:51:31", "text": "今は少し暗い。パステルカラーを入れることができます"}, {"type": "subtitle", "time": 3093.75, "timestamp": "00:51:33", "text": "朝のあれこれ"}, {"type": "subtitle", "time": 3095.91, "timestamp": "00:51:35", "text": "そして午後になると、"}, {"type": "subtitle", "time": 3098.79, "timestamp": "00:51:38", "text": "オレンジ色か何か夕方には"}, {"type": "subtitle", "time": 3100.95, "timestamp": "00:51:40", "text": "金色とか、よくわからないけど"}, {"type": "subtitle", "time": 3104.47, "timestamp": "00:51:44", "text": "私たちはそのようなことをたくさんできますが"}, {"type": "subtitle", "time": 3106.309, "timestamp": "00:51:46", "text": "ええ、ウェブサイト関連のものはすべて用意します"}, {"type": "subtitle", "time": 3110.71, "timestamp": "00:51:50", "text": "完了したら、今はそれについて考えます"}, {"type": "subtitle", "time": 3114.71, "timestamp": "00:51:54", "text": "ロゴ、うん、これは私の昔のロゴに似ている"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "えっと、変更したいのですが、実際には大丈夫です"}]
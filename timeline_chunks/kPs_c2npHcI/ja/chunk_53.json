[{"type": "subtitle", "time": 3181.67, "timestamp": "00:53:01", "text": "未来のことですよね？だから、私はそう決めたんです。"}, {"type": "subtitle", "time": 3184.309, "timestamp": "00:53:04", "text": "今は将来のことを心配しないでおこう。しかし"}, {"type": "subtitle", "time": 3187.75, "timestamp": "00:53:07", "text": "ええ、一度"}, {"type": "subtitle", "time": 3191.51, "timestamp": "00:53:11", "text": "一度これを手に入れることができれば"}, {"type": "subtitle", "time": 3193.829, "timestamp": "00:53:13", "text": "新モデルを発表して、それから"}, {"type": "subtitle", "time": 3195.829, "timestamp": "00:53:15", "text": "ロゴについては心配します"}, {"type": "subtitle", "time": 3198.069, "timestamp": "00:53:18", "text": "すべて。"}, {"type": "subtitle", "time": 3200.79, "timestamp": "00:53:20", "text": "まあ、とにかく、彼らは本当にいい人たちです。私"}, {"type": "subtitle", "time": 3203.03, "timestamp": "00:53:23", "text": "実はこれをやりたいんです。したい"}, {"type": "subtitle", "time": 3207.67, "timestamp": "00:53:27", "text": "彼がどうやってそれをやったのかを再現する方法を学ぶ。"}, {"type": "subtitle", "time": 3210.15, "timestamp": "00:53:30", "text": "うん、これは本当に素晴らしいね。私は本当に好きです"}, {"type": "subtitle", "time": 3213.43, "timestamp": "00:53:33", "text": "それも。"}, {"type": "subtitle", "time": 3217.99, "timestamp": "00:53:37", "text": "本当に気に入りました。それで、彼は私にそのファイルを渡してくれた。"}, {"type": "subtitle", "time": 3220.549, "timestamp": "00:53:40", "text": "私は、私は、私は、私は、私は、どのように"}, {"type": "subtitle", "time": 3224.39, "timestamp": "00:53:44", "text": "それを開くために、彼は私にファイルを渡した"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "だから、えっと、だから、私は、"}, {"type": "subtitle", "time": 3234.87, "timestamp": "00:53:54", "text": "HTMLを取得できるように、それを開く方法を教えてください。"}, {"type": "subtitle", "time": 3238.549, "timestamp": "00:53:58", "text": "そして、物事を見て、彼がどのように学ぶかを学びます"}]
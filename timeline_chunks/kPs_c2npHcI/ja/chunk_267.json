[{"type": "subtitle", "time": 16022.389, "timestamp": "04:27:02", "text": "そうそう。私たちはそれをしなければならない。わかった。えっと、"}, {"type": "subtitle", "time": 16024.95, "timestamp": "04:27:04", "text": "わかった。わかった。さあ"}, {"type": "subtitle", "time": 16041.59, "timestamp": "04:27:21", "text": "この人の真似をして、"}, {"type": "subtitle", "time": 16048.95, "timestamp": "04:27:28", "text": "スパムメールは必要ありません。スパン。私たちはそうしません"}, {"type": "subtitle", "time": 16051.59, "timestamp": "04:27:31", "text": "必要だ。必要なのはHTMLとリンクだけです"}, {"type": "subtitle", "time": 16055.03, "timestamp": "04:27:35", "text": "あれだよ、わかるだろ。それで、"}, {"type": "subtitle", "time": 16059.51, "timestamp": "04:27:39", "text": "この件に関する私の考えは"}, {"type": "subtitle", "time": 16062.07, "timestamp": "04:27:42", "text": "私は置くことができます"}, {"type": "subtitle", "time": 16065.91, "timestamp": "04:27:45", "text": "もしそれがリンクである場合、"}, {"type": "subtitle", "time": 16069.349, "timestamp": "04:27:49", "text": "できました"}, {"type": "subtitle", "time": 16071.91, "timestamp": "04:27:51", "text": "あ、待って。さっき私は何をしたんだっけ？"}]
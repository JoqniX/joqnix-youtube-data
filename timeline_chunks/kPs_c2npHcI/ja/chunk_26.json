[{"type": "subtitle", "time": 1566.39, "timestamp": "00:26:06", "text": "実際にできることは、"}, {"type": "subtitle", "time": 1568.23, "timestamp": "00:26:08", "text": "トークン。"}, {"type": "subtitle", "time": 1571.75, "timestamp": "00:26:11", "text": "特性は同じだと思います。"}, {"type": "subtitle", "time": 1574.47, "timestamp": "00:26:14", "text": "目に見えるホバー、"}, {"type": "subtitle", "time": 1577.43, "timestamp": "00:26:17", "text": "右？ここも同じです。"}, {"type": "subtitle", "time": 1580.23, "timestamp": "00:26:20", "text": "ああ、見えるものはそこにはない。はい、それは"}, {"type": "subtitle", "time": 1583.029, "timestamp": "00:26:23", "text": "面白い。はい、大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 1586.87, "timestamp": "00:26:26", "text": "私ができることは、メニューです"}, {"type": "subtitle", "time": 1589.51, "timestamp": "00:26:29", "text": "閉じるボタンがあります。私たちはそうします"}, {"type": "subtitle", "time": 1593.75, "timestamp": "00:26:33", "text": "トークンメニューに変換"}, {"type": "subtitle", "time": 1596.63, "timestamp": "00:26:36", "text": "v4"}, {"type": "subtitle", "time": 1605.59, "timestamp": "00:26:45", "text": "トリガーを設置できます"}, {"type": "subtitle", "time": 1613.75, "timestamp": "00:26:53", "text": "こんにちは。ここにある閉じるボタンに戻ってください。"}, {"type": "subtitle", "time": 1617.029, "timestamp": "00:26:57", "text": "古い方の。"}]
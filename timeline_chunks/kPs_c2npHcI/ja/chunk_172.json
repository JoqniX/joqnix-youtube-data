[{"type": "subtitle", "time": 10320.389, "timestamp": "02:52:00", "text": "タイムラインスタイル"}, {"type": "subtitle", "time": 10324.07, "timestamp": "02:52:04", "text": "スカーフはマッチしていて、見た目は悪くないが、簡単に揃う。"}, {"type": "subtitle", "time": 10328.53, "timestamp": "02:52:08", "text": "ざっと目を通す、精神的に整理する"}, {"type": "subtitle", "time": 10330.07, "timestamp": "02:52:10", "text": "[音楽]"}, {"type": "subtitle", "time": 10333.269, "timestamp": "02:52:13", "text": "でも問題は、"}, {"type": "subtitle", "time": 10336.87, "timestamp": "02:52:16", "text": "私たちがここにいるのは、このためだけです"}, {"type": "subtitle", "time": 10339.349, "timestamp": "02:52:19", "text": "テキストとして表示していますが、"}, {"type": "subtitle", "time": 10344.55, "timestamp": "02:52:24", "text": "子牛の咳のような画像をここに載せる"}, {"type": "subtitle", "time": 10347.99, "timestamp": "02:52:27", "text": "画像がありますが、彼女は画像を"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "それはまるで咳の日記と夢のようだ。"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "彼女は画像などを投稿します。"}, {"type": "subtitle", "time": 10357.75, "timestamp": "02:52:37", "text": "右？"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "だから、そういう風に考えなければならないんだ"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "あまりにも。画像を載せる場合"}, {"type": "subtitle", "time": 10368.82, "timestamp": "02:52:48", "text": "では、どうすればいいのでしょうか？"}, {"type": "subtitle", "time": 10377.91, "timestamp": "02:52:57", "text": "ああ、これは何でしょう？ああ、彼女は"}]
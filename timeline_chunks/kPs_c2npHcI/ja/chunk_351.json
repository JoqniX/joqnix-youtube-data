[{"type": "subtitle", "time": 21064.07, "timestamp": "05:51:04", "text": "そして私は、えーと、私は"}, {"type": "subtitle", "time": 21066.23, "timestamp": "05:51:06", "text": "GST番号。"}, {"type": "subtitle", "time": 21075.99, "timestamp": "05:51:15", "text": "私はそれをしました。私はそれを"}, {"type": "subtitle", "time": 21079.83, "timestamp": "05:51:19", "text": "当座預金口座いいえ、銀行はこう言いました"}, {"type": "subtitle", "time": 21083.11, "timestamp": "05:51:23", "text": "えっと、GST（消費税）の件は必要ですね。"}, {"type": "subtitle", "time": 21094.628, "timestamp": "05:51:34", "text": "いいえ、オフィスで彼らが言ったように"}, {"type": "subtitle", "time": 21096.788, "timestamp": "05:51:36", "text": "人々は、ネルのような名前を入れるだろうと言っていた。"}, {"type": "subtitle", "time": 21106.31, "timestamp": "05:51:46", "text": "何てことだ。"}]
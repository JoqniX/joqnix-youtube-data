[{"type": "subtitle", "time": 4441.99, "timestamp": "01:14:01", "text": "ウェブサイトを掲載したらどうなりますか？"}, {"type": "subtitle", "time": 4445.11, "timestamp": "01:14:05", "text": "はい、メインページのみがインデックスされます"}, {"type": "subtitle", "time": 4449.669, "timestamp": "01:14:09", "text": "右を検索してください。つまり、もし私がdocと入力したら"}, {"type": "subtitle", "time": 4453.91, "timestamp": "01:14:13", "text": "次に、メインのものだけがここに来ます。"}, {"type": "subtitle", "time": 4458.79, "timestamp": "01:14:18", "text": "私が正しければ、onexia も"}, {"type": "subtitle", "time": 4462.47, "timestamp": "01:14:22", "text": "姿を現す。これは何ですか？これはドラマですか？"}, {"type": "subtitle", "time": 4465.189, "timestamp": "01:14:25", "text": "これは何ですか？"}, {"type": "subtitle", "time": 4469.35, "timestamp": "01:14:29", "text": "ウォウェディア。すごいキャラクターだ。世界の"}, {"type": "subtitle", "time": 4471.669, "timestamp": "01:14:31", "text": "ウォークラフト。"}, {"type": "subtitle", "time": 4481.35, "timestamp": "01:14:41", "text": "Anexiaのウェブサイト。"}, {"type": "subtitle", "time": 4484.07, "timestamp": "01:14:44", "text": "私の情報が表示されますか？そうではない"}, {"type": "subtitle", "time": 4491.27, "timestamp": "01:14:51", "text": "ええ、そうですね。そうです。メインウェブサイト"}, {"type": "subtitle", "time": 4493.51, "timestamp": "01:14:53", "text": "現れます。"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "残りは私の好きなもの。ええ、能力"}]
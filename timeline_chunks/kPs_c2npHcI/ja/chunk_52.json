[{"type": "subtitle", "time": 3121.109, "timestamp": "00:52:01", "text": "顎をここまで動かします。元気です。"}, {"type": "subtitle", "time": 3123.43, "timestamp": "00:52:03", "text": "短いロゴは、私が必要としていると思います"}, {"type": "subtitle", "time": 3127.829, "timestamp": "00:52:07", "text": "星座に合わせて変更してください"}, {"type": "subtitle", "time": 3131.19, "timestamp": "00:52:11", "text": "テーマ。私はVTuberなので、特にありません。"}, {"type": "subtitle", "time": 3133.75, "timestamp": "00:52:13", "text": "VTuberのロゴは個性を反映する傾向がある"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "そしてすべて"}, {"type": "subtitle", "time": 3138.71, "timestamp": "00:52:18", "text": "そしてこれはより一般的な現代の"}, {"type": "subtitle", "time": 3143.27, "timestamp": "00:52:23", "text": "タイプだと思います。わからない。えっと、それで私は"}, {"type": "subtitle", "time": 3144.87, "timestamp": "00:52:24", "text": "に"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "私は何をすべきか考えている"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "短いロゴ？変えたい"}, {"type": "subtitle", "time": 3151.51, "timestamp": "00:52:31", "text": "上へ、ほら、見せびらかすように"}, {"type": "subtitle", "time": 3153.99, "timestamp": "00:52:33", "text": "星座とか宇宙みたいなもの"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "関連するもの、"}, {"type": "subtitle", "time": 3158.549, "timestamp": "00:52:38", "text": "右？私はそうしなければならないと思う"}, {"type": "subtitle", "time": 3161.27, "timestamp": "00:52:41", "text": "新しいものをお見せした後で考えてみてください"}, {"type": "subtitle", "time": 3165.03, "timestamp": "00:52:45", "text": "モデルですよね？ギルダ、心配しなくていいよ"}, {"type": "subtitle", "time": 3168.069, "timestamp": "00:52:48", "text": "それについて考えすぎている。私が権利を持っているもの"}, {"type": "subtitle", "time": 3177.67, "timestamp": "00:52:57", "text": "私はあまり心配する必要はない"}]
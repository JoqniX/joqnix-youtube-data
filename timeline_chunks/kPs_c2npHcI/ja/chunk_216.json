[{"type": "subtitle", "time": 12973.99, "timestamp": "03:36:13", "text": "わかった。だから、こうするしかないんだ。わかった。"}, {"type": "subtitle", "time": 12977.429, "timestamp": "03:36:17", "text": "ロゴを貼るだけです。それはまるで"}, {"type": "subtitle", "time": 12979.83, "timestamp": "03:36:19", "text": "人々は、"}, {"type": "subtitle", "time": 12983.59, "timestamp": "03:36:23", "text": "矢印。私はただ「うん」と言っているだけです。"}, {"type": "subtitle", "time": 12987.03, "timestamp": "03:36:27", "text": "このテキストはクリック可能です。それが忘れてた"}, {"type": "subtitle", "time": 12991.51, "timestamp": "03:36:31", "text": "物。わかった。わかった。ええと、わかりました。の"}, {"type": "subtitle", "time": 12995.19, "timestamp": "03:36:35", "text": "全体をインラインで配置しました"}, {"type": "subtitle", "time": 12998.389, "timestamp": "03:36:38", "text": "ブロック。わかった。"}, {"type": "subtitle", "time": 13000.95, "timestamp": "03:36:40", "text": "えっと、"}, {"type": "subtitle", "time": 13005.19, "timestamp": "03:36:45", "text": "マウスオーバーすると、"}, {"type": "subtitle", "time": 13010.63, "timestamp": "03:36:50", "text": "テキストには下線が引かれます。"}, {"type": "subtitle", "time": 13012.71, "timestamp": "03:36:52", "text": "どうすればそれができるだろうか？質問"}, {"type": "subtitle", "time": 13016.229, "timestamp": "03:36:56", "text": "マーク。分かりません。えっと"}, {"type": "subtitle", "time": 13019.51, "timestamp": "03:36:59", "text": "なぜならそれはスパンだから。いいえ。スパンとは何ですか？私"}]
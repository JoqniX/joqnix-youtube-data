[{"type": "subtitle", "time": 16860.868, "timestamp": "04:41:00", "text": "考えてみると、どうやって追加すればいいでしょうか。"}, {"type": "subtitle", "time": 16863.11, "timestamp": "04:41:03", "text": "ああ、神様。もし私がそうなら、"}, {"type": "subtitle", "time": 16866.628, "timestamp": "04:41:06", "text": "箇条書きにすると、"}, {"type": "subtitle", "time": 16870.31, "timestamp": "04:41:10", "text": "画像もまた別の頭痛の種である"}, {"type": "subtitle", "time": 16874.628, "timestamp": "04:41:14", "text": "咳のウェブサイトみたいに。いいえ、もし私が"}, {"type": "subtitle", "time": 16876.948, "timestamp": "04:41:16", "text": "であった"}, {"type": "subtitle", "time": 16879.03, "timestamp": "04:41:19", "text": "画像がある"}, {"type": "subtitle", "time": 16881.11, "timestamp": "04:41:21", "text": "ここに書いてあることは全部わからないけど、"}, {"type": "subtitle", "time": 16885.27, "timestamp": "04:41:25", "text": "テキストですが、画像があればいいのですが"}, {"type": "subtitle", "time": 16888.868, "timestamp": "04:41:28", "text": "画像が欲しいのですが、どうすれば"}, {"type": "subtitle", "time": 16893.11, "timestamp": "04:41:33", "text": "それを置くとしたら、また別の頭痛の種になるわ。"}, {"type": "subtitle", "time": 16903.83, "timestamp": "04:41:43", "text": "それはまた別の赤いデッキですよね？"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "状況に応じて対応する方法"}]
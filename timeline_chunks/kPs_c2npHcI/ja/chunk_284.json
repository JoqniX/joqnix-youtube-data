[{"type": "subtitle", "time": 17041.35, "timestamp": "04:44:01", "text": "デザイン面で。後でやります。"}, {"type": "subtitle", "time": 17043.35, "timestamp": "04:44:03", "text": "右？デザインは私たちが担当します"}, {"type": "subtitle", "time": 17048.948, "timestamp": "04:44:08", "text": "後で。でも今は、えーっと"}, {"type": "chat", "time": 17051.699, "timestamp": "04:44:11", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "oh you'll be using constellation theme ...."}, {"type": "subtitle", "time": 17051.91, "timestamp": "04:44:11", "text": "少なくともそれのようにする"}, {"type": "subtitle", "time": 17054.31, "timestamp": "04:44:14", "text": "訪問可能であり、少なくとも閲覧可能だ。私はできる"}, {"type": "subtitle", "time": 17057.59, "timestamp": "04:44:17", "text": "ウェブサイトをチェックしてください"}, {"type": "subtitle", "time": 17060.47, "timestamp": "04:44:20", "text": "新しいデザインに取り組んでいない、または"}, {"type": "subtitle", "time": 17062.628, "timestamp": "04:44:22", "text": "何か。いいえ。"}, {"type": "subtitle", "time": 17064.15, "timestamp": "04:44:24", "text": "ああ、星座を使うことになるんですね"}, {"type": "subtitle", "time": 17066.47, "timestamp": "04:44:26", "text": "テーマ。私は今、星座だ。だから私は"}, {"type": "subtitle", "time": 17068.39, "timestamp": "04:44:28", "text": "星座のテーマを使わなければならない、"}, {"type": "subtitle", "time": 17071.35, "timestamp": "04:44:31", "text": "右？ある意味で"}, {"type": "subtitle", "time": 17073.99, "timestamp": "04:44:33", "text": "私の理解が正しければ。問題は新しい"}, {"type": "subtitle", "time": 17077.19, "timestamp": "04:44:37", "text": "デザインは、"}, {"type": "subtitle", "time": 17079.59, "timestamp": "04:44:39", "text": "ガーディアン"}, {"type": "subtitle", "time": 17081.19, "timestamp": "04:44:41", "text": "予後因子"}, {"type": "subtitle", "time": 17084.948, "timestamp": "04:44:44", "text": "守護者のように考えてください"}, {"type": "subtitle", "time": 17089.75, "timestamp": "04:44:49", "text": "星座とか星とか、そういうもの。"}, {"type": "subtitle", "time": 17092.55, "timestamp": "04:44:52", "text": "うん。それで"}, {"type": "subtitle", "time": 17096.628, "timestamp": "04:44:56", "text": "えーと、こういうことも含めてだよね"}]
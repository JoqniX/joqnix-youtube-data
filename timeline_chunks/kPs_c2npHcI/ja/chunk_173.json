[{"type": "subtitle", "time": 10395.83, "timestamp": "02:53:15", "text": "つまり、短いものを見ると"}, {"type": "subtitle", "time": 10399.269, "timestamp": "02:53:19", "text": "あれ、まるで彼女について話しているみたい"}, {"type": "subtitle", "time": 10404.23, "timestamp": "02:53:24", "text": "外見、場所、その他すべて。"}, {"type": "subtitle", "time": 10406.71, "timestamp": "02:53:26", "text": "授賞式。わあ、彼女はたくさん手に入れた"}, {"type": "subtitle", "time": 10408.63, "timestamp": "02:53:28", "text": "賞。"}, {"type": "subtitle", "time": 10417.91, "timestamp": "02:53:37", "text": "ブランドン。ああ、彼女は真ん中にいる。"}, {"type": "subtitle", "time": 10421.19, "timestamp": "02:53:41", "text": "ああ、彼女がそこにいる。"}, {"type": "subtitle", "time": 10423.11, "timestamp": "02:53:43", "text": "何？"}, {"type": "subtitle", "time": 10425.82, "timestamp": "02:53:45", "text": "おお。とても良い。"}, {"type": "subtitle", "time": 10428.87, "timestamp": "02:53:48", "text": "[音楽]"}, {"type": "subtitle", "time": 10431.11, "timestamp": "02:53:51", "text": "テレビ東京のエンディングテーマのスポンサーになる"}, {"type": "subtitle", "time": 10433.67, "timestamp": "02:53:53", "text": "アニメ。えっと、ブラッククローバー。そうそう。彼女"}, {"type": "subtitle", "time": 10437.11, "timestamp": "02:53:57", "text": "ブラッククローバーで歌った"}]
[{"type": "subtitle", "time": 6911.669, "timestamp": "01:55:11", "text": "UI要素が見えますか？"}, {"type": "subtitle", "time": 6913.83, "timestamp": "01:55:13", "text": "時間？"}, {"type": "subtitle", "time": 6917.27, "timestamp": "01:55:17", "text": "電流とは？日本は今何時ですか？"}, {"type": "subtitle", "time": 6922.149, "timestamp": "01:55:22", "text": "558年7月11日"}, {"type": "subtitle", "time": 6924.39, "timestamp": "01:55:24", "text": "はぁ？彼らは日本にいる。これはなぜ"}, {"type": "subtitle", "time": 6927.99, "timestamp": "01:55:27", "text": "これ？わかった。クイックリンク集"}, {"type": "subtitle", "time": 6931.03, "timestamp": "01:55:31", "text": "わかった。ニュースはそこにある。もっと見る。わかった。"}, {"type": "subtitle", "time": 6932.79, "timestamp": "01:55:32", "text": "バイオグラフィー。"}, {"type": "subtitle", "time": 6935.75, "timestamp": "01:55:35", "text": "音楽。ライブ。おそらくリアルタイムで更新されるのでしょう"}, {"type": "subtitle", "time": 6937.109, "timestamp": "01:55:37", "text": "ストリーム。わからない。確認する必要がある"}, {"type": "subtitle", "time": 6940.55, "timestamp": "01:55:40", "text": "彼女がライブ配信しているとき。ここに来たらすぐに"}, {"type": "subtitle", "time": 6944.31, "timestamp": "01:55:44", "text": "これは、ああ、という感じだ。"}, {"type": "subtitle", "time": 6947.189, "timestamp": "01:55:47", "text": "ああ、なんてことだ。これはすごくクールだ。"}, {"type": "subtitle", "time": 6950.149, "timestamp": "01:55:50", "text": "これはいいですね。ホバーできます。何が"}, {"type": "subtitle", "time": 6955.669, "timestamp": "01:55:55", "text": "本当に"}, {"type": "subtitle", "time": 6957.43, "timestamp": "01:55:57", "text": "いいね"}]
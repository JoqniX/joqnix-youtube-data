[{"type": "subtitle", "time": 2880.39, "timestamp": "00:48:00", "text": "私は全てを起き上がらせる。"}, {"type": "subtitle", "time": 2884.95, "timestamp": "00:48:04", "text": "ええ、そうですね。これがアディチャンがしたこと"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "自分。これを見てください。このメニュー、すごく素敵じゃない？"}, {"type": "subtitle", "time": 2892.47, "timestamp": "00:48:12", "text": "グラデーションを見てください。その"}, {"type": "chat", "time": 2894.867, "timestamp": "00:48:14", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "it does look futuristic cyberpunk"}, {"type": "subtitle", "time": 2895.75, "timestamp": "00:48:15", "text": "未来的でとてもクール。いや、"}, {"type": "subtitle", "time": 2898.47, "timestamp": "00:48:18", "text": "ここに星座があります。わからない"}, {"type": "subtitle", "time": 2901.51, "timestamp": "00:48:21", "text": "見ればわかりますよ。星座がある"}, {"type": "subtitle", "time": 2904.47, "timestamp": "00:48:24", "text": "ここだ。"}, {"type": "subtitle", "time": 2907.99, "timestamp": "00:48:27", "text": "ええ、手伝ってくれました。彼はハードコーディングした"}, {"type": "subtitle", "time": 2912.549, "timestamp": "00:48:32", "text": "まさにその通り。彼はこれをNex.jsでコーディングしました。"}, {"type": "subtitle", "time": 2914.63, "timestamp": "00:48:34", "text": "私は推測する。"}, {"type": "subtitle", "time": 2917.67, "timestamp": "00:48:37", "text": "うん。そして最新の配信。見てください"}, {"type": "subtitle", "time": 2920.23, "timestamp": "00:48:40", "text": "これ。それはそれを強調している"}, {"type": "subtitle", "time": 2923.589, "timestamp": "00:48:43", "text": "境界線の半径など、すべて。国境"}, {"type": "subtitle", "time": 2926.63, "timestamp": "00:48:46", "text": "光り輝く様子など、全てが。さて、そのガラスは"}, {"type": "subtitle", "time": 2930.069, "timestamp": "00:48:50", "text": "モルフィズムのやつ、たくさん見かける"}, {"type": "subtitle", "time": 2933.99, "timestamp": "00:48:53", "text": "星座も同様に、"}, {"type": "subtitle", "time": 2937.75, "timestamp": "00:48:57", "text": "男。彼はすごくかっこいい。ええ、私も"}]
[{"type": "subtitle", "time": 2524.15, "timestamp": "00:42:04", "text": "うん。時々気づく"}, {"type": "subtitle", "time": 2528.79, "timestamp": "00:42:08", "text": "これらのブロックこれらの単語は取得できません"}, {"type": "subtitle", "time": 2531.03, "timestamp": "00:42:11", "text": "小さい"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "何らかの"}, {"type": "subtitle", "time": 2549.109, "timestamp": "00:42:29", "text": "ああ、これを書かなきゃいけないことに今気づいた"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "すると残りのものも影響する"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "それに応じて。ああ、わかりました。"}]
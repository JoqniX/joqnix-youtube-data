[{"type": "subtitle", "time": 9542.469, "timestamp": "02:39:02", "text": "ええ、私はすべてを最優先します"}, {"type": "subtitle", "time": 9544.55, "timestamp": "02:39:04", "text": "そして、どれが機能するかを確認し、"}, {"type": "subtitle", "time": 9574.15, "timestamp": "02:39:34", "text": "崩壊させてしまうかもしれない"}, {"type": "subtitle", "time": 9576.469, "timestamp": "02:39:36", "text": "折りたたみ式"}, {"type": "subtitle", "time": 9578.469, "timestamp": "02:39:38", "text": "たぶんこれだろう。わからない。しかし"}, {"type": "subtitle", "time": 9582.27, "timestamp": "02:39:42", "text": "うん、この男は"}, {"type": "subtitle", "time": 9589.03, "timestamp": "02:39:49", "text": "後でフォーマットします。心配ない。病気"}, {"type": "subtitle", "time": 9592.07, "timestamp": "02:39:52", "text": "上に置く"}, {"type": "subtitle", "time": 9597.83, "timestamp": "02:39:57", "text": "2021年21日。それから、えっと…"}, {"type": "subtitle", "time": 9599.83, "timestamp": "02:39:59", "text": "21"}]
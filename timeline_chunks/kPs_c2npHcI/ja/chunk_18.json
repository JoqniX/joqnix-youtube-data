[{"type": "subtitle", "time": 1083.19, "timestamp": "00:18:03", "text": "メニューの種類が多すぎる？"}, {"type": "subtitle", "time": 1095.669, "timestamp": "00:18:15", "text": "ああ、テキストか。この男を見習え。あなたは"}, {"type": "subtitle", "time": 1099.35, "timestamp": "00:18:19", "text": "私と来て。私と一緒に家に帰りましょう。彼らは"}, {"type": "subtitle", "time": 1102.789, "timestamp": "00:18:22", "text": "すぐに中へご案内します"}, {"type": "subtitle", "time": 1110.31, "timestamp": "00:18:30", "text": "文章。"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "テキストは閉じられていますが、"}, {"type": "subtitle", "time": 1114.549, "timestamp": "00:18:34", "text": "メニュー。"}, {"type": "subtitle", "time": 1122.549, "timestamp": "00:18:42", "text": "えっと、もしあなたが疑問に思うなら、ああジョー、"}, {"type": "subtitle", "time": 1124.23, "timestamp": "00:18:44", "text": "スタイリングはどうですか？しないでください"}, {"type": "subtitle", "time": 1126.71, "timestamp": "00:18:46", "text": "心配。すでに"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "相続において世話をされる"}, {"type": "subtitle", "time": 1134.789, "timestamp": "00:18:54", "text": "サイズも全て含めて。ああ、心配だ"}, {"type": "subtitle", "time": 1138.31, "timestamp": "00:18:58", "text": "それについて。えっと"}]
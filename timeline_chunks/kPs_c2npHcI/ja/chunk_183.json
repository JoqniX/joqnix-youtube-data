[{"type": "subtitle", "time": 10980.15, "timestamp": "03:03:00", "text": "男。これらの人々もそれを成し遂げた"}, {"type": "subtitle", "time": 10982.07, "timestamp": "03:03:02", "text": "未来的な。ガラスの形態は"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "何か、わかるでしょ。"}, {"type": "subtitle", "time": 10987.03, "timestamp": "03:03:07", "text": "おお。ニース。"}, {"type": "subtitle", "time": 10989.51, "timestamp": "03:03:09", "text": "「サインインさせてください」と表示されました。"}, {"type": "subtitle", "time": 11002.79, "timestamp": "03:03:22", "text": "ああ、Discordが署名設定を変更したんだ。"}, {"type": "subtitle", "time": 11008.79, "timestamp": "03:03:28", "text": "ええと、今はアプリケーションにリダイレクトされます。"}, {"type": "subtitle", "time": 11018.07, "timestamp": "03:03:38", "text": "わかった。"}, {"type": "subtitle", "time": 11034.63, "timestamp": "03:03:54", "text": "統合。え、何？"}, {"type": "subtitle", "time": 11039.59, "timestamp": "03:03:59", "text": "待って。これはベータ版です。"}]
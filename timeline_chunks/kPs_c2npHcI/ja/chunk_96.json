[{"type": "subtitle", "time": 5762.07, "timestamp": "01:36:02", "text": "ページ"}, {"type": "subtitle", "time": 5767.83, "timestamp": "01:36:07", "text": "そしてその内容は私のウィキからのものです"}, {"type": "subtitle", "time": 5770.07, "timestamp": "01:36:10", "text": "歴史"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "ページ。"}, {"type": "subtitle", "time": 5774.79, "timestamp": "01:36:14", "text": "えっと"}, {"type": "subtitle", "time": 5784.149, "timestamp": "01:36:24", "text": "トークンによるアクセス。ああ、これだ。コピーしてください。"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "シンプルな縦型タイムライン形式"}, {"type": "subtitle", "time": 5800.39, "timestamp": "01:36:40", "text": "年をヘッダーバンドとして含め、"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "積み重ね形式の下にエントリが表示されます。"}, {"type": "subtitle", "time": 5804.39, "timestamp": "01:36:44", "text": "検索には明確な構造があります"}, {"type": "subtitle", "time": 5806.79, "timestamp": "01:36:46", "text": "時系列を再フォーマットして削除します"}, {"type": "subtitle", "time": 5809.51, "timestamp": "01:36:49", "text": "ウェブ版を探す手間が省けます。"}, {"type": "subtitle", "time": 5812.07, "timestamp": "01:36:52", "text": "わかった。歴史"}, {"type": "subtitle", "time": 5814.31, "timestamp": "01:36:54", "text": "あるいは、スターズ・ジャーニーを楽しみたいなら"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "すべてのタイトル。"}]
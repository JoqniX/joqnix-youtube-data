[{"type": "subtitle", "time": 3480.39, "timestamp": "00:58:00", "text": "一つこれをピン留めさせてください"}, {"type": "subtitle", "time": 3482.069, "timestamp": "00:58:02", "text": "それらをリンクすると、独自の"}, {"type": "subtitle", "time": 3484.47, "timestamp": "00:58:04", "text": "ファンダム。うん。うん。うん。"}, {"type": "subtitle", "time": 3487.589, "timestamp": "00:58:07", "text": "私はそうしたかったんです。はい。"}, {"type": "subtitle", "time": 3490.069, "timestamp": "00:58:10", "text": "つまり、彼らにはそれぞれ独自のファン層がいるということだ。"}, {"type": "subtitle", "time": 3493.19, "timestamp": "00:58:13", "text": "わかった。私は好きになりたかった"}, {"type": "subtitle", "time": 3506.549, "timestamp": "00:58:26", "text": "過ぎ去った"}, {"type": "subtitle", "time": 3526.87, "timestamp": "00:58:46", "text": "それは良いです。私はコメントを1つ使用しています。 1つ"}, {"type": "subtitle", "time": 3529.91, "timestamp": "00:58:49", "text": "com。とても美味しいです。いいね"}, {"type": "subtitle", "time": 3533.349, "timestamp": "00:58:53", "text": "ご覧のとおり、私はここをクリックするだけで"}, {"type": "subtitle", "time": 3535.829, "timestamp": "00:58:55", "text": "コメント欄。それは、"}, {"type": "subtitle", "time": 3539.91, "timestamp": "00:58:59", "text": "HTML。ページが表示されます。"}]
[{"type": "subtitle", "time": 18662.47, "timestamp": "05:11:02", "text": "ガイドラインページには次のような"}, {"type": "subtitle", "time": 18665.27, "timestamp": "05:11:05", "text": "私の母国へのリクエスト"}, {"type": "subtitle", "time": 18667.99, "timestamp": "05:11:07", "text": "ガイドライン。評価案を作成する必要があります"}, {"type": "subtitle", "time": 18671.75, "timestamp": "05:11:11", "text": "ファン関連のガイドラインなど"}, {"type": "subtitle", "time": 18676.23, "timestamp": "05:11:16", "text": "ファンフィクション、音楽、イラスト、"}, {"type": "subtitle", "time": 18679.67, "timestamp": "05:11:19", "text": "えーと、ビデオ、メディア、アセット、"}, {"type": "subtitle", "time": 18681.99, "timestamp": "05:11:21", "text": "クリップ、ビデオ。"}, {"type": "subtitle", "time": 18684.31, "timestamp": "05:11:24", "text": "ええ、クリップもこの範疇に入ります。"}, {"type": "subtitle", "time": 18686.23, "timestamp": "05:11:26", "text": "ゲーム"}, {"type": "subtitle", "time": 18689.27, "timestamp": "05:11:29", "text": "その他、様々な形式のコンテンツ。"}, {"type": "subtitle", "time": 18691.75, "timestamp": "05:11:31", "text": "ええ、ちゃんと作らなきゃ"}, {"type": "subtitle", "time": 18694.55, "timestamp": "05:11:34", "text": "それに関するガイドライン。"}, {"type": "subtitle", "time": 18698.39, "timestamp": "05:11:38", "text": "ああ、しまった、公開されてしまった。はい、では"}, {"type": "subtitle", "time": 18700.868, "timestamp": "05:11:40", "text": "私の携帯電話を確認してください。"}, {"type": "subtitle", "time": 18702.39, "timestamp": "05:11:42", "text": "えっと"}, {"type": "subtitle", "time": 18712.07, "timestamp": "05:11:52", "text": "空間。メニューが開きます"}, {"type": "subtitle", "time": 18719.75, "timestamp": "05:11:59", "text": "あらら、悪くないですね。実際、いい感じだよ。"}]
[{"type": "subtitle", "time": 13981.51, "timestamp": "03:53:01", "text": "なぜdivのように配置できないのか。いや、いや、いや。"}, {"type": "subtitle", "time": 13984.15, "timestamp": "03:53:04", "text": "どうすればいいですか？なぜここにdivを配置できないのですか？"}, {"type": "subtitle", "time": 13988.469, "timestamp": "03:53:08", "text": "わかった。待って。 divタグ。変更させてください"}, {"type": "subtitle", "time": 13991.59, "timestamp": "03:53:11", "text": "タグ。タグを変更できません。"}, {"type": "subtitle", "time": 13995.429, "timestamp": "03:53:15", "text": "聖なる主よ。ああ、神様。えっと"}, {"type": "subtitle", "time": 13997.67, "timestamp": "03:53:17", "text": "div。"}, {"type": "subtitle", "time": 14001.59, "timestamp": "03:53:21", "text": "来て。私にさせて"}, {"type": "subtitle", "time": 14005.75, "timestamp": "03:53:25", "text": "光あれ。よし、できた。えっと"}, {"type": "subtitle", "time": 14013.83, "timestamp": "03:53:33", "text": "さあさあさあ。"}, {"type": "subtitle", "time": 14016.55, "timestamp": "03:53:36", "text": "はい。"}, {"type": "subtitle", "time": 14019.03, "timestamp": "03:53:39", "text": "うん。ここから先は無理だ。ああ、神様。"}, {"type": "subtitle", "time": 14021.11, "timestamp": "03:53:41", "text": "これはやりすぎだ。"}, {"type": "subtitle", "time": 14028.79, "timestamp": "03:53:48", "text": "それからスタートします"}, {"type": "subtitle", "time": 14032.309, "timestamp": "03:53:52", "text": "シェンダーかもしれない。いや、待って。これは"}, {"type": "subtitle", "time": 14035.99, "timestamp": "03:53:55", "text": "悪い。ああ、神様。いやいや。"}, {"type": "subtitle", "time": 14038.07, "timestamp": "03:53:58", "text": "私はそれを知っています。"}]
[{"type": "subtitle", "time": 5354.229, "timestamp": "01:29:14", "text": "奈良美仁シリーズ。これは何ですか？"}, {"type": "subtitle", "time": 5357.35, "timestamp": "01:29:17", "text": "ナジバディって何？食べ物のようなものですか"}, {"type": "subtitle", "time": 5360.39, "timestamp": "01:29:20", "text": "ブランドの操り人形？"}, {"type": "subtitle", "time": 5363.43, "timestamp": "01:29:23", "text": "ああ、それはまるで"}, {"type": "subtitle", "time": 5367.59, "timestamp": "01:29:27", "text": "彼ら自身のぬいぐるみか何か。"}, {"type": "subtitle", "time": 5370.39, "timestamp": "01:29:30", "text": "えっと"}, {"type": "subtitle", "time": 5373.59, "timestamp": "01:29:33", "text": "ああ、彼らは独自のテーマストアを持っている"}, {"type": "subtitle", "time": 5375.51, "timestamp": "01:29:35", "text": "そして全て。カフェと"}, {"type": "subtitle", "time": 5377.91, "timestamp": "01:29:37", "text": "すべて。"}, {"type": "subtitle", "time": 5381.43, "timestamp": "01:29:41", "text": "ああ、これはいいですね。"}, {"type": "subtitle", "time": 5387.03, "timestamp": "01:29:47", "text": "ニース。えっと、えっと、えっと、"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "気が散っている。よし、見てみよう。えっと、誰"}, {"type": "subtitle", "time": 5393.35, "timestamp": "01:29:53", "text": "どちらを選ぶべきでしょうか？とてもたくさんあります"}, {"type": "subtitle", "time": 5396.149, "timestamp": "01:29:56", "text": "真実。"}, {"type": "subtitle", "time": 5399.91, "timestamp": "01:29:59", "text": "わかりました、私は"}]
[{"type": "subtitle", "time": 10087.429, "timestamp": "02:48:07", "text": "えっと、3月27日。つまり、2023年ですね。"}, {"type": "subtitle", "time": 10089.51, "timestamp": "02:48:09", "text": "スラッシュ"}, {"type": "subtitle", "time": 10095.03, "timestamp": "02:48:15", "text": "どれでも追加できます。ああ、それは"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "圧縮コンテンツブロック。わかった。わかった。"}, {"type": "subtitle", "time": 10101.51, "timestamp": "02:48:21", "text": "だから、コンテンツ内のものは何でも"}, {"type": "subtitle", "time": 10104.63, "timestamp": "02:48:24", "text": "ブロックのテンプレートは作成していません。そうそう、"}, {"type": "subtitle", "time": 10107.67, "timestamp": "02:48:27", "text": "私はそれをやらなければならない。いいえ。だから私たちは"}, {"type": "subtitle", "time": 10110.87, "timestamp": "02:48:30", "text": "テンプレートを作成する。だからもし私が"}, {"type": "subtitle", "time": 10112.95, "timestamp": "02:48:32", "text": "ウェブサイトの作業を手伝ってくれる人を増やしたい"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "これでログインできます。"}, {"type": "subtitle", "time": 10117.59, "timestamp": "02:48:37", "text": "ログイン。彼らはリンクにアクセスできます。彼らはできる"}, {"type": "subtitle", "time": 10121.11, "timestamp": "02:48:41", "text": "コンテンツを追加する。ええ、コンテンツを追加できますよ。"}, {"type": "subtitle", "time": 10123.67, "timestamp": "02:48:43", "text": "プラスアイコンを押してください。エントリーを追加します"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "このようにログポイントを記録します。うん、作れるよ"}, {"type": "subtitle", "time": 10129.349, "timestamp": "02:48:49", "text": "テンプレート。つまり、スタイルをすべてコピーして"}, {"type": "subtitle", "time": 10132.15, "timestamp": "02:48:52", "text": "そうです。このセクション全体がコピーされます"}, {"type": "subtitle", "time": 10135.349, "timestamp": "02:48:55", "text": "そして彼らはそれを実行できる。"}, {"type": "subtitle", "time": 10138.389, "timestamp": "02:48:58", "text": "うん、将来的に考えるべきこと"}]
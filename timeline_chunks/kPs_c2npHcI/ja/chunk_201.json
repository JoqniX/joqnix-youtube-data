[{"type": "subtitle", "time": 12069.99, "timestamp": "03:21:09", "text": "ああ、おかげでうまくいったよ。"}, {"type": "subtitle", "time": 12076.309, "timestamp": "03:21:16", "text": "ああ、ありがとうございます。"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "買います。貼り付けてください。"}, {"type": "subtitle", "time": 12082.07, "timestamp": "03:21:22", "text": "おお、いいね。現在の色。わかった。わかった。"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "今、私たちはそのことについて話し合っている。わーい。"}, {"type": "subtitle", "time": 12091.03, "timestamp": "03:21:31", "text": "はい、どうぞ。色を変えることができます。それ"}, {"type": "subtitle", "time": 12094.63, "timestamp": "03:21:34", "text": "色に影響を与える。ニース。"}, {"type": "subtitle", "time": 12096.95, "timestamp": "03:21:36", "text": "ニース。ニース。ニース。ニース。それが私が"}, {"type": "subtitle", "time": 12101.269, "timestamp": "03:21:41", "text": "あなたに求めているもの。ニース。ニース。それで、私たちは"}, {"type": "subtitle", "time": 12103.83, "timestamp": "03:21:43", "text": "この男は今や。では、私たちはどのように"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "このBBC記事の中にログイン情報を入れますか？"}, {"type": "subtitle", "time": 12117.349, "timestamp": "03:21:57", "text": "おお、いいね。ああ、それはスパンになる。それ"}]
[{"type": "subtitle", "time": 17401.75, "timestamp": "04:50:01", "text": "それは全て、全てが結晶です。"}, {"type": "subtitle", "time": 17405.67, "timestamp": "04:50:05", "text": "クリスタルとステージ。わかった。"}, {"type": "subtitle", "time": 17407.83, "timestamp": "04:50:07", "text": "ああ、クリスタルもこんな感じだよ"}, {"type": "subtitle", "time": 17410.788, "timestamp": "04:50:10", "text": "ダイヤモンド型でボックスと"}, {"type": "subtitle", "time": 17418.55, "timestamp": "04:50:18", "text": "ええ、新しいモデルが発売されたら、"}, {"type": "subtitle", "time": 17420.948, "timestamp": "04:50:20", "text": "アーティストに依頼する必要がある。私はします"}, {"type": "subtitle", "time": 17424.07, "timestamp": "04:50:24", "text": "お金がない。私はお金がない。"}, {"type": "subtitle", "time": 17426.788, "timestamp": "04:50:26", "text": "ええ、将来はそうします"}, {"type": "subtitle", "time": 17430.47, "timestamp": "04:50:30", "text": "何らかの方法で人に依頼するのが好き"}, {"type": "subtitle", "time": 17432.868, "timestamp": "04:50:32", "text": "背景など、すべてにおいて良い。おお、"}, {"type": "subtitle", "time": 17434.708, "timestamp": "04:50:34", "text": "これはいいですね。そのため、カーソルを合わせると、"}, {"type": "subtitle", "time": 17440.07, "timestamp": "04:50:40", "text": "線が消される場合と消されない場合がある。それ"}, {"type": "subtitle", "time": 17443.59, "timestamp": "04:50:43", "text": "何か別のものが現れた。ああ、それ"}, {"type": "subtitle", "time": 17447.27, "timestamp": "04:50:47", "text": "とても素敵です。とにかく、えっと、気が散ってしまいました。"}, {"type": "chat", "time": 17449.457, "timestamp": "04:50:49", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "it's a long road but we'll do it ...slowly but surely"}, {"type": "subtitle", "time": 17454.15, "timestamp": "04:50:54", "text": "えーと、"}, {"type": "subtitle", "time": 17456.23, "timestamp": "04:50:56", "text": "私の読み間違いでしょうか？はい、それは"}, {"type": "subtitle", "time": 17459.19, "timestamp": "04:50:59", "text": "グッズ。はい、すみません。"}]
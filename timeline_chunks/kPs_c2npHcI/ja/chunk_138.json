[{"type": "subtitle", "time": 8282.469, "timestamp": "02:18:02", "text": "どうやら"}, {"type": "subtitle", "time": 8284.07, "timestamp": "02:18:04", "text": "ダッシュ"}, {"type": "subtitle", "time": 8291.03, "timestamp": "02:18:11", "text": "100% にすると線が郊外化される"}, {"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "のように"}, {"type": "subtitle", "time": 8301.99, "timestamp": "02:18:21", "text": "ダッシュウェブ"}, {"type": "subtitle", "time": 8304.549, "timestamp": "02:18:24", "text": "どうすれば直せますか？テキストを使用している場合"}, {"type": "subtitle", "time": 8306.79, "timestamp": "02:18:26", "text": "このような要素"}, {"type": "subtitle", "time": 8308.629, "timestamp": "02:18:28", "text": "そして設定幅によって、"}, {"type": "subtitle", "time": 8310.87, "timestamp": "02:18:30", "text": "テキストブロック全体（ダッシュ記号は含まれません）。それで"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "ダッシュは小さく見えます。"}, {"type": "subtitle", "time": 8318.23, "timestamp": "02:18:38", "text": "フレックスボックスの行を使用します。私はそうしました。"}, {"type": "subtitle", "time": 8326.309, "timestamp": "02:18:46", "text": "右。わかった。 2つの要素。左に書く"}, {"type": "subtitle", "time": 8329.429, "timestamp": "02:18:49", "text": "側。柔軟な線 div または span を記述します"}, {"type": "subtitle", "time": 8331.91, "timestamp": "02:18:51", "text": "枠線付きの背景。作成する"}]
[{"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "そのような日付コンテンツ。日付の内容"}, {"type": "subtitle", "time": 8958.309, "timestamp": "02:29:18", "text": "こいつを削除するよ。私たちは必要としません"}, {"type": "subtitle", "time": 8961.1, "timestamp": "02:29:21", "text": "あの男。"}, {"type": "subtitle", "time": 8963.75, "timestamp": "02:29:23", "text": "[音楽]"}, {"type": "subtitle", "time": 8977.349, "timestamp": "02:29:37", "text": "えーと"}, {"type": "subtitle", "time": 8987.51, "timestamp": "02:29:47", "text": "わかった。歴史"}, {"type": "subtitle", "time": 8990.87, "timestamp": "02:29:50", "text": "データ内容の年。"}, {"type": "subtitle", "time": 8993.51, "timestamp": "02:29:53", "text": "同じことだけどね。"}, {"type": "subtitle", "time": 8996.15, "timestamp": "02:29:56", "text": "でも、どちらが良いか"}, {"type": "subtitle", "time": 8999.349, "timestamp": "02:29:59", "text": "不思議。ええ、ちょっと埋めさせてください"}]
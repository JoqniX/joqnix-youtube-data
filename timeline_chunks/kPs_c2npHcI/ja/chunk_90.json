[{"type": "subtitle", "time": 5401.59, "timestamp": "01:30:01", "text": "に"}, {"type": "subtitle", "time": 5404.31, "timestamp": "01:30:04", "text": "私はアイリスを選びます。それは"}, {"type": "subtitle", "time": 5408.07, "timestamp": "01:30:08", "text": "私が彼女を見つめている間。アイリス・ジャマ。"}, {"type": "subtitle", "time": 5411.43, "timestamp": "01:30:11", "text": "ああ、わかった。ごく普通のものです。低い"}, {"type": "subtitle", "time": 5414.39, "timestamp": "01:30:14", "text": "費用、短いテキスト、紹介ビデオ、"}, {"type": "subtitle", "time": 5416.31, "timestamp": "01:30:16", "text": "ギャラリー、"}, {"type": "subtitle", "time": 5419.03, "timestamp": "01:30:19", "text": "基本データ、情報、アカウント、ショー、"}, {"type": "subtitle", "time": 5433.91, "timestamp": "01:30:33", "text": "ああ、このアカウント機能はいいですね。"}, {"type": "subtitle", "time": 5436.629, "timestamp": "01:30:36", "text": "うん。うん、これを自己紹介に載せてもいいかも"}, {"type": "subtitle", "time": 5440.07, "timestamp": "01:30:40", "text": "実際にはページです。"}, {"type": "subtitle", "time": 5442.629, "timestamp": "01:30:42", "text": "ええ、ここに置いて、その前に"}, {"type": "subtitle", "time": 5445.03, "timestamp": "01:30:45", "text": "そのデータ。"}, {"type": "subtitle", "time": 5447.03, "timestamp": "01:30:47", "text": "ええ、モデルを配置する必要があるので、"}, {"type": "subtitle", "time": 5449.189, "timestamp": "01:30:49", "text": "すべては今。"}, {"type": "subtitle", "time": 5453.189, "timestamp": "01:30:53", "text": "ええ、それは可能です。"}, {"type": "subtitle", "time": 5456.79, "timestamp": "01:30:56", "text": "でも、そう、私には誰もいないんです。えっと"}]
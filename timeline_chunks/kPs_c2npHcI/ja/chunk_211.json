[{"type": "subtitle", "time": 12680.15, "timestamp": "03:31:20", "text": "えっと、1つかな。うん。それは"}, {"type": "subtitle", "time": 12682.63, "timestamp": "03:31:22", "text": "より良い？"}, {"type": "subtitle", "time": 12690.87, "timestamp": "03:31:30", "text": "こんにちは。テスト。"}, {"type": "subtitle", "time": 12704.15, "timestamp": "03:31:44", "text": "日本語を練習し始めるとすぐに、"}, {"type": "subtitle", "time": 12707.51, "timestamp": "03:31:47", "text": "TIAに授業について問い合わせました。彼らはいた"}, {"type": "subtitle", "time": 12710.95, "timestamp": "03:31:50", "text": "「またお知らせします」といった感じ。彼らはそうしていない"}, {"type": "subtitle", "time": 12714.55, "timestamp": "03:31:54", "text": "お知らせ下さい。えっと、1日に聞いたんだけど"}, {"type": "subtitle", "time": 12718.63, "timestamp": "03:31:58", "text": "7月の。応答なし。彼らは私に言った"}]
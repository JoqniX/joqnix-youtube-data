[{"type": "subtitle", "time": 722.31, "timestamp": "00:12:02", "text": "うん。どうやらメニューは"}, {"type": "subtitle", "time": 725.59, "timestamp": "00:12:05", "text": "シートのはずだった。"}, {"type": "subtitle", "time": 728.389, "timestamp": "00:12:08", "text": "シートは、そうあるべきではない"}, {"type": "subtitle", "time": 731.99, "timestamp": "00:12:11", "text": "対話である。ダイアログボックスは、"}, {"type": "subtitle", "time": 736.389, "timestamp": "00:12:16", "text": "ダイアログボックスとは何かを実演してみますか？"}, {"type": "subtitle", "time": 739.35, "timestamp": "00:12:19", "text": "エラーに遭遇したときや"}, {"type": "subtitle", "time": 741.269, "timestamp": "00:12:21", "text": "ダイアログボックスのようなものですね。"}, {"type": "subtitle", "time": 745.35, "timestamp": "00:12:25", "text": "これこそがダイアログボックスの正体だ。"}, {"type": "subtitle", "time": 748.629, "timestamp": "00:12:28", "text": "私のやり方は少し間違っていた。"}, {"type": "subtitle", "time": 750.949, "timestamp": "00:12:30", "text": "もしあなたが気づいたなら"}, {"type": "subtitle", "time": 753.43, "timestamp": "00:12:33", "text": "これは今起こる これは私が思うに"}, {"type": "subtitle", "time": 757.19, "timestamp": "00:12:37", "text": "対話要素。"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "ええ、トランジションで、"}, {"type": "subtitle", "time": 762.55, "timestamp": "00:12:42", "text": "そう、それはそうあるべきではない"}, {"type": "subtitle", "time": 764.87, "timestamp": "00:12:44", "text": "起こる。だから、おそらくそれは"}, {"type": "subtitle", "time": 767.829, "timestamp": "00:12:47", "text": "私が使用したダイアログボックスの。だから私は"}, {"type": "subtitle", "time": 770.629, "timestamp": "00:12:50", "text": "使用することになっている"}, {"type": "subtitle", "time": 773.35, "timestamp": "00:12:53", "text": "メニューシートみたいなもの。これは、"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "モバイル版のハンバーガーメニューみたいなやつ。"}, {"type": "subtitle", "time": 778.55, "timestamp": "00:12:58", "text": "それで、それで"}]
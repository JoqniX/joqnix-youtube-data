[{"type": "subtitle", "time": 17100.788, "timestamp": "04:45:00", "text": "これは、これは、という形で存在します"}, {"type": "subtitle", "time": 17105.11, "timestamp": "04:45:05", "text": "私の金色のような"}, {"type": "subtitle", "time": 17107.91, "timestamp": "04:45:07", "text": "私の服装。こういうことは実際に存在する。"}, {"type": "subtitle", "time": 17111.75, "timestamp": "04:45:11", "text": "この種の星の線とこれらすべて"}, {"type": "subtitle", "time": 17115.91, "timestamp": "04:45:15", "text": "円形のようなデザインがあります。"}, {"type": "subtitle", "time": 17118.55, "timestamp": "04:45:18", "text": "ちょっと待って、スマホを確認するね。思うに"}, {"type": "subtitle", "time": 17120.948, "timestamp": "04:45:20", "text": "正しいですか？うん。うん。そこそこ"}, {"type": "subtitle", "time": 17123.67, "timestamp": "04:45:23", "text": "それは、四つ角のようにそこにあるということですか？"}, {"type": "subtitle", "time": 17125.83, "timestamp": "04:45:25", "text": "星がそこにある"}, {"type": "subtitle", "time": 17129.35, "timestamp": "04:45:29", "text": "どちらかというと長方形に近い。いや、そうじゃない"}, {"type": "subtitle", "time": 17132.31, "timestamp": "04:45:32", "text": "矩形。えっと"}, {"type": "subtitle", "time": 17136.628, "timestamp": "04:45:36", "text": "ええ、長方形を回転させて"}, {"type": "subtitle", "time": 17140.39, "timestamp": "04:45:40", "text": "あれ。いや、四隅みたいな感じ"}, {"type": "subtitle", "time": 17143.43, "timestamp": "04:45:43", "text": "まるで、そこにただ存在する星のように。"}, {"type": "subtitle", "time": 17147.43, "timestamp": "04:45:47", "text": "それは輝きの中にある。それはまるで"}, {"type": "subtitle", "time": 17150.15, "timestamp": "04:45:50", "text": "日本のものみたいな感じ。何をするの？"}, {"type": "subtitle", "time": 17154.15, "timestamp": "04:45:54", "text": "それって何？えーっと"}, {"type": "subtitle", "time": 17156.788, "timestamp": "04:45:56", "text": "ユカタ。うん、ユカタみたいな感じ"}, {"type": "chat", "time": 17159.027, "timestamp": "04:45:59", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "kimono"}]
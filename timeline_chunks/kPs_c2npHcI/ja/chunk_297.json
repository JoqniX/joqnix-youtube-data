[{"type": "subtitle", "time": 17820.31, "timestamp": "04:57:00", "text": "弾丸を変えようと思っていた"}, {"type": "subtitle", "time": 17861.51, "timestamp": "04:57:41", "text": "なぜこの一つだけは例外なのか"}, {"type": "subtitle", "time": 17865.03, "timestamp": "04:57:45", "text": "この変なバカは何なの"}, {"type": "subtitle", "time": 17867.75, "timestamp": "04:57:47", "text": "変わりたくない？"}, {"type": "subtitle", "time": 17872.628, "timestamp": "04:57:52", "text": "何てことだ。はい、箇条書きで。大丈夫。"}, {"type": "subtitle", "time": 17875.83, "timestamp": "04:57:55", "text": "どうすれば"}, {"type": "subtitle", "time": 17879.43, "timestamp": "04:57:59", "text": "箇条書きとテキストを組み合わせると、ごちゃごちゃした印象になることがあります。"}]
[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "この男。ええ、それはシーツです。はい。はい。"}, {"type": "subtitle", "time": 1984.71, "timestamp": "00:33:04", "text": "はい。これでうまくいくはずだ。"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "アニメーション機能が実行されていない。"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "はい、アニメーション機能はありますが"}, {"type": "subtitle", "time": 1996.789, "timestamp": "00:33:16", "text": "メニュー項目に関しては、それは行われません。"}, {"type": "subtitle", "time": 1999.59, "timestamp": "00:33:19", "text": "また。右。だから、もし私が出版するなら"}, {"type": "subtitle", "time": 2002.07, "timestamp": "00:33:22", "text": "今のところは、あなたのところから確認します"}, {"type": "subtitle", "time": 2004.63, "timestamp": "00:33:24", "text": "自宅の電話も全て揃っています。でも、もし"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "誰か確認したい人がいたら、私が載せます"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "コメント。"}, {"type": "subtitle", "time": 2013.669, "timestamp": "00:33:33", "text": "えっと、今は「会社概要」ページを作成中です。"}, {"type": "subtitle", "time": 2015.509, "timestamp": "00:33:35", "text": "現在。"}, {"type": "chat", "time": 2015.746, "timestamp": "00:33:35", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "I was about to ask"}, {"type": "subtitle", "time": 2017.35, "timestamp": "00:33:37", "text": "いくつか情報を追加します"}, {"type": "subtitle", "time": 2020.23, "timestamp": "00:33:40", "text": "モデルなどは後ほど掲載します。まあ、だいたいそんな感じ"}, {"type": "subtitle", "time": 2022.07, "timestamp": "00:33:42", "text": "ページ。"}, {"type": "subtitle", "time": 2027.59, "timestamp": "00:33:47", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 2032.47, "timestamp": "00:33:52", "text": "vlogress をチェックしたい場合は"}, {"type": "subtitle", "time": 2037.11, "timestamp": "00:33:57", "text": "そして私を助けて私を助けて"}]
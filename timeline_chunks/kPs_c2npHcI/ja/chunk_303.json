[{"type": "subtitle", "time": 18180.08, "timestamp": "05:03:00", "text": "歴史 データ"}, {"type": "subtitle", "time": 18181.92, "timestamp": "05:03:01", "text": "データ 文章"}, {"type": "subtitle", "time": 18184.718, "timestamp": "05:03:04", "text": "文章 リスト"}, {"type": "subtitle", "time": 18186.32, "timestamp": "05:03:06", "text": "リスト アイテム"}, {"type": "subtitle", "time": 18194.948, "timestamp": "05:03:14", "text": "年。年とコンテナのリスト項目はありません"}, {"type": "subtitle", "time": 18198.55, "timestamp": "05:03:18", "text": "文章。テキストのように表現できます。わかった、"}, {"type": "subtitle", "time": 18200.948, "timestamp": "05:03:20", "text": "私達はします"}, {"type": "subtitle", "time": 18204.07, "timestamp": "05:03:24", "text": "トークンに変換します。"}, {"type": "subtitle", "time": 18207.27, "timestamp": "05:03:27", "text": "コピーしてください。貼り付けてください。これから私たちは"}, {"type": "subtitle", "time": 18211.11, "timestamp": "05:03:31", "text": "もっと大胆に。それはやや太字になります"}, {"type": "subtitle", "time": 18217.83, "timestamp": "05:03:37", "text": "わかった。今度は手動で入れなければならない"}, {"type": "subtitle", "time": 18219.83, "timestamp": "05:03:39", "text": "すべての"}, {"type": "subtitle", "time": 18222.868, "timestamp": "05:03:42", "text": "H. ああ、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 18225.27, "timestamp": "05:03:45", "text": "騎手は忘れていた。"}, {"type": "subtitle", "time": 18233.67, "timestamp": "05:03:53", "text": "わかった。うん、ここでやるよ。のように"}, {"type": "subtitle", "time": 18235.19, "timestamp": "05:03:55", "text": "これ。"}]
[{"type": "subtitle", "time": 10800.87, "timestamp": "03:00:00", "text": "そして、それを右側に置いてください。"}, {"type": "subtitle", "time": 10804.469, "timestamp": "03:00:04", "text": "最大幅は200～300ピクセルです。"}, {"type": "subtitle", "time": 10807.75, "timestamp": "03:00:07", "text": "待って、どうすればBBCを手に入れられるの？"}, {"type": "subtitle", "time": 10817.91, "timestamp": "03:00:17", "text": "インドのユーチューバー？取得してみましょう"}, {"type": "subtitle", "time": 10839.349, "timestamp": "03:00:39", "text": "ほら、私の言ってることわかるでしょ？のように"}, {"type": "subtitle", "time": 10843.99, "timestamp": "03:00:43", "text": "ここにはBBCのように書いてある"}, {"type": "subtitle", "time": 10847.59, "timestamp": "03:00:47", "text": "こちらのBBCのロゴのようなもの"}, {"type": "subtitle", "time": 10849.429, "timestamp": "03:00:49", "text": "そういう類のもの。"}, {"type": "subtitle", "time": 10852.79, "timestamp": "03:00:52", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 10854.95, "timestamp": "03:00:54", "text": "えーと"}, {"type": "subtitle", "time": 10857.67, "timestamp": "03:00:57", "text": "ファンアートをそのまま載せたくない"}]
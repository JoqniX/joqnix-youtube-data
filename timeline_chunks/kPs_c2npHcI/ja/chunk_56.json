[{"type": "subtitle", "time": 3360.47, "timestamp": "00:56:00", "text": "私のもポップアップするけど、彼らも同じように"}, {"type": "subtitle", "time": 3364.47, "timestamp": "00:56:04", "text": "えっと、私は、えっと、"}, {"type": "subtitle", "time": 3367.349, "timestamp": "00:56:07", "text": "これらのインド人ユーチューバーのどれか1人"}, {"type": "subtitle", "time": 3370.47, "timestamp": "00:56:10", "text": "もし彼らが今自分たちのウィキページを作ったら"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "私がしたように、ここにリンクを貼ることができます"}, {"type": "subtitle", "time": 3377.27, "timestamp": "00:56:17", "text": "エサル・サンのために。彼女には専用のウィキペディアページがある"}, {"type": "subtitle", "time": 3379.43, "timestamp": "00:56:19", "text": "つまり、これです。"}, {"type": "subtitle", "time": 3384.39, "timestamp": "00:56:24", "text": "リンクを貼りたかったんです。"}, {"type": "subtitle", "time": 3385.91, "timestamp": "00:56:25", "text": "えっと"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "リンクを貼ったりしたかったんです。"}, {"type": "subtitle", "time": 3392.39, "timestamp": "00:56:32", "text": "だから、これが良い考えだったのかどうかは分からない。"}, {"type": "subtitle", "time": 3396.069, "timestamp": "00:56:36", "text": "それを実行する。今のところ、誰も編集していません。私"}, {"type": "subtitle", "time": 3400.63, "timestamp": "00:56:40", "text": "つまり、えっと、私は一部の人々が"}, {"type": "subtitle", "time": 3403.829, "timestamp": "00:56:43", "text": "えーっと、歴史を見てみると、何人かの人が"}, {"type": "chat", "time": 3406.902, "timestamp": "00:56:46", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "that's a great idea....later u can link the vtubers link"}, {"type": "subtitle", "time": 3407.349, "timestamp": "00:56:47", "text": "いくつか編集しました"}, {"type": "subtitle", "time": 3410.47, "timestamp": "00:56:50", "text": "この男とこの男、この男たち"}, {"type": "subtitle", "time": 3414.23, "timestamp": "00:56:54", "text": "えっと、参照を修正する"}, {"type": "subtitle", "time": 3418.309, "timestamp": "00:56:58", "text": "えっと、タグとか全部。リンクできますか"}]
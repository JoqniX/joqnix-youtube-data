[{"type": "subtitle", "time": 5538.07, "timestamp": "01:32:18", "text": "これはすごくクールだ。おお。"}, {"type": "subtitle", "time": 5540.709, "timestamp": "01:32:20", "text": "これはすごくおしゃれでクールだ。わからない"}, {"type": "subtitle", "time": 5542.79, "timestamp": "01:32:22", "text": "彼らはどうやってそれを成し遂げたのか。"}, {"type": "subtitle", "time": 5545.91, "timestamp": "01:32:25", "text": "H. わかりました。参考資料がないので、"}, {"type": "subtitle", "time": 5548.629, "timestamp": "01:32:28", "text": "私は咳のレイアウトに従います。私"}, {"type": "subtitle", "time": 5550.31, "timestamp": "01:32:30", "text": "自分のレイアウトを作ろうと思う"}, {"type": "subtitle", "time": 5554.709, "timestamp": "01:32:34", "text": "今。こんにちは。ここに戻ってくる。えっと"}, {"type": "subtitle", "time": 5558.629, "timestamp": "01:32:38", "text": "歴史。タイトルにあるやつだよ。"}, {"type": "subtitle", "time": 5563.91, "timestamp": "01:32:43", "text": "ええと、これはこれを持っています。私ができること"}, {"type": "subtitle", "time": 5567.43, "timestamp": "01:32:47", "text": "計画は、"}, {"type": "subtitle", "time": 5571.189, "timestamp": "01:32:51", "text": "これをもう一度複製してください。"}]
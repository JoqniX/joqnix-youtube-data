[{"type": "subtitle", "time": 4925.83, "timestamp": "01:22:05", "text": "いや、いや、いや、いや、いや、いや、いや。待って、待って、"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "待って、待って。ナビゲーションの警告音を教えてください。おお、"}, {"type": "subtitle", "time": 4932.629, "timestamp": "01:22:12", "text": "神。待って。はい、メニューはこちらです。おお、ありがとう"}, {"type": "subtitle", "time": 4935.99, "timestamp": "01:22:15", "text": "神。ああ、それはそこにある。わかった。わかった。休む"}, {"type": "subtitle", "time": 4939.03, "timestamp": "01:22:19", "text": "物事がOになった。ええと、私たちはやらなければならない"}, {"type": "subtitle", "time": 4946.31, "timestamp": "01:22:26", "text": "ああ、これはそこにある。はい、ここにあります"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "現状のまま。ニース。"}, {"type": "subtitle", "time": 4956.55, "timestamp": "01:22:36", "text": "ああ、わかった。大丈夫です。大丈夫です。私たちは"}, {"type": "subtitle", "time": 4962.87, "timestamp": "01:22:42", "text": "えっと、"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "わかった。"}, {"type": "subtitle", "time": 4967.35, "timestamp": "01:22:47", "text": "公開。念のため公開して"}, {"type": "subtitle", "time": 4970.07, "timestamp": "01:22:50", "text": "念のため。"}]
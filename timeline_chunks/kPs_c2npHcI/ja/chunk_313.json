[{"type": "subtitle", "time": 18781.67, "timestamp": "05:13:01", "text": "2024年。"}, {"type": "subtitle", "time": 18784.31, "timestamp": "05:13:04", "text": "ええ、最初の配信だけです。私はしなかった"}, {"type": "subtitle", "time": 18786.39, "timestamp": "05:13:06", "text": "多くの。"}, {"type": "subtitle", "time": 18791.27, "timestamp": "05:13:11", "text": "えっと、2024年。私は後悔しています"}, {"type": "subtitle", "time": 18794.15, "timestamp": "05:13:14", "text": "えっと、"}, {"type": "subtitle", "time": 18807.43, "timestamp": "05:13:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18810.55, "timestamp": "05:13:30", "text": "そうだったと思います。私は何かをしたと思う。"}, {"type": "subtitle", "time": 18814.39, "timestamp": "05:13:34", "text": "わからない。何も覚えていない"}, {"type": "subtitle", "time": 18816.55, "timestamp": "05:13:36", "text": "実は。"}, {"type": "subtitle", "time": 18819.75, "timestamp": "05:13:39", "text": "2月20日～24日"}, {"type": "subtitle", "time": 18821.27, "timestamp": "05:13:41", "text": "29、"}]
[{"type": "subtitle", "time": 9122.07, "timestamp": "02:32:02", "text": "2020年が嫌だったらどうすればいいの？"}, {"type": "subtitle", "time": 9124.15, "timestamp": "02:32:04", "text": "起こるだろう"}, {"type": "subtitle", "time": 9126.23, "timestamp": "02:32:06", "text": "短い"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "なぜ2001年版を使っているのか"}, {"type": "subtitle", "time": 9138.469, "timestamp": "02:32:18", "text": "ええ、私の考えは、もし私が気に入らなければ"}, {"type": "subtitle", "time": 9142.469, "timestamp": "02:32:22", "text": "それ。たぶん私は"}, {"type": "subtitle", "time": 9144.07, "timestamp": "02:32:24", "text": "えっと"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "時間に関するもの。テキストとして表示します。"}, {"type": "subtitle", "time": 9158.79, "timestamp": "02:32:38", "text": "20"}, {"type": "subtitle", "time": 9164.309, "timestamp": "02:32:44", "text": "8月。"}, {"type": "subtitle", "time": 9168.469, "timestamp": "02:32:48", "text": "そう言うべきか、それとも"}, {"type": "subtitle", "time": 9171.19, "timestamp": "02:32:51", "text": "テキストと月日と月を待って"}, {"type": "subtitle", "time": 9175.11, "timestamp": "02:32:55", "text": "遅れた手紙。どうしたいですか？"}, {"type": "subtitle", "time": 9177.91, "timestamp": "02:32:57", "text": "ええと、では、私があなたに与える権利をあなたに与えましょう"}]
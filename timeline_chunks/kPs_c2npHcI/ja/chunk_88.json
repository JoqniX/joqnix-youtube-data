[{"type": "subtitle", "time": 5283.91, "timestamp": "01:28:03", "text": "右？カレンダーのような概念を使うことができます"}, {"type": "subtitle", "time": 5287.27, "timestamp": "01:28:07", "text": "もし私の理解が正しければ、そういうことです。"}, {"type": "subtitle", "time": 5289.189, "timestamp": "01:28:09", "text": "えっと"}, {"type": "subtitle", "time": 5294.149, "timestamp": "01:28:14", "text": "データベースには、"}, {"type": "subtitle", "time": 5297.51, "timestamp": "01:28:17", "text": "えっと、どこにあるんですか？"}, {"type": "subtitle", "time": 5299.99, "timestamp": "01:28:19", "text": "はい、リスト形式で入力できますよ。そこには"}, {"type": "subtitle", "time": 5303.189, "timestamp": "01:28:23", "text": "カレンダーみたいなやつだよね？これ、"}, {"type": "subtitle", "time": 5307.189, "timestamp": "01:28:27", "text": "右？ブロックをそれぞれに置いたと想像してください"}, {"type": "subtitle", "time": 5311.11, "timestamp": "01:28:31", "text": "などなど、それを取りに行って、"}, {"type": "subtitle", "time": 5314.55, "timestamp": "01:28:34", "text": "この全てをウェブサイトに掲載する。"}, {"type": "subtitle", "time": 5317.11, "timestamp": "01:28:37", "text": "可能だと思うけど問題は"}, {"type": "subtitle", "time": 5324.229, "timestamp": "01:28:44", "text": "どうすればいいのか考えなければならないが"}, {"type": "subtitle", "time": 5327.59, "timestamp": "01:28:47", "text": "大丈夫。ニース。えっと、なぜ私はここにいたの？"}, {"type": "subtitle", "time": 5331.669, "timestamp": "01:28:51", "text": "また？うん。歴史。歴史。はい。"}, {"type": "subtitle", "time": 5334.39, "timestamp": "01:28:54", "text": "歴史。"}, {"type": "subtitle", "time": 5337.91, "timestamp": "01:28:57", "text": "待って、ネイボディって何？"}]
[{"type": "subtitle", "time": 10746.87, "timestamp": "02:59:06", "text": "各イベントは通常、日付、短い"}, {"type": "subtitle", "time": 10749.349, "timestamp": "02:59:09", "text": "サムネイル付きの説明、"}, {"type": "subtitle", "time": 10751.51, "timestamp": "02:59:11", "text": "画像または長方形"}, {"type": "subtitle", "time": 10755.349, "timestamp": "02:59:15", "text": "プロモーション用グラフィックHを右または下へ"}, {"type": "subtitle", "time": 10758.15, "timestamp": "02:59:18", "text": "画面サイズに応じてテキストが変わります。"}, {"type": "subtitle", "time": 10766.07, "timestamp": "02:59:26", "text": "H."}, {"type": "subtitle", "time": 10771.51, "timestamp": "02:59:31", "text": "それを水平スタックフレックスボックスで囲みます。"}, {"type": "subtitle", "time": 10775.67, "timestamp": "02:59:35", "text": "左側は左側っぽい"}, {"type": "subtitle", "time": 10782.07, "timestamp": "02:59:42", "text": "はぁ？"}, {"type": "subtitle", "time": 10784.07, "timestamp": "02:59:44", "text": "それは"}]
[{"type": "subtitle", "time": 11948.469, "timestamp": "03:19:08", "text": "ああ、手動でやらないといけないんだ。ああ、わかった。"}, {"type": "subtitle", "time": 11950.389, "timestamp": "03:19:10", "text": "待って。"}, {"type": "subtitle", "time": 11957.11, "timestamp": "03:19:17", "text": "また一人。ああ、３回だ。今は"}, {"type": "subtitle", "time": 11958.87, "timestamp": "03:19:18", "text": "矢。"}, {"type": "subtitle", "time": 11960.79, "timestamp": "03:19:20", "text": "継承する。"}, {"type": "subtitle", "time": 11966.79, "timestamp": "03:19:26", "text": "それはなくなってしまった。消えた。ああ、わかりました。ここから。"}, {"type": "subtitle", "time": 11968.95, "timestamp": "03:19:28", "text": "地勢学。"}]
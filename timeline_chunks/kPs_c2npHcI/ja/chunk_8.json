[{"type": "subtitle", "time": 481.51, "timestamp": "00:08:01", "text": "私は何か食べ物を手に入れて"}, {"type": "subtitle", "time": 483.35, "timestamp": "00:08:03", "text": "すべて。"}, {"type": "subtitle", "time": 486.07, "timestamp": "00:08:06", "text": "ええ、そういうことです。"}, {"type": "subtitle", "time": 489.029, "timestamp": "00:08:09", "text": "ええ、そうですね。今日は戻ってきます。私たちが"}, {"type": "subtitle", "time": 493.67, "timestamp": "00:08:13", "text": "前回ここに来た時は、"}, {"type": "subtitle", "time": 495.51, "timestamp": "00:08:15", "text": "えーと"}, {"type": "subtitle", "time": 500.07, "timestamp": "00:08:20", "text": "前回は、私が歌った"}, {"type": "subtitle", "time": 501.99, "timestamp": "00:08:21", "text": "あれのことですよね？それは昨日のことだった。"}, {"type": "subtitle", "time": 504.55, "timestamp": "00:08:24", "text": "そのため、昨日私たちは"}, {"type": "subtitle", "time": 507.189, "timestamp": "00:08:27", "text": "午前6時にまさに「概要」ページの内容を投稿した。"}, {"type": "subtitle", "time": 512.55, "timestamp": "00:08:32", "text": "ああ、そうだった。 120日目。"}, {"type": "subtitle", "time": 518.389, "timestamp": "00:08:38", "text": "120. 私たちはカバーからそれをやっていました。"}, {"type": "subtitle", "time": 520.389, "timestamp": "00:08:40", "text": "ええと、8時間くらいやったと思います。"}, {"type": "subtitle", "time": 523.11, "timestamp": "00:08:43", "text": "右？私たちはそれをやっていました、えっと、そのことについて"}, {"type": "subtitle", "time": 525.35, "timestamp": "00:08:45", "text": "ページの内容。"}, {"type": "subtitle", "time": 527.43, "timestamp": "00:08:47", "text": "それでは、本日それを行います。"}, {"type": "chat", "time": 530.022, "timestamp": "00:08:50", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "jhaaaaaaqx"}, {"type": "subtitle", "time": 530.31, "timestamp": "00:08:50", "text": "仕上げとバグ修正はこちら"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "そして、そこに。それらのものはすべて"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "実行中。えっと"}, {"type": "subtitle", "time": 537.509, "timestamp": "00:08:57", "text": "こんにちは"}]
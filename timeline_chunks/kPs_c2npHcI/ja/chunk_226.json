[{"type": "subtitle", "time": 13560.309, "timestamp": "03:46:00", "text": "ええと、わかりました。私は"}, {"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "スパン。あまりにも迷惑だ。おお、"}, {"type": "subtitle", "time": 13568.07, "timestamp": "03:46:08", "text": "スパンガイ。 O."}, {"type": "subtitle", "time": 13571.51, "timestamp": "03:46:11", "text": "ああ、どうやら大丈夫らしい。わかった。わかった。"}, {"type": "subtitle", "time": 13575.99, "timestamp": "03:46:15", "text": "ああ、スタイルを身につける限り"}, {"type": "subtitle", "time": 13578.15, "timestamp": "03:46:18", "text": "リンク"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "グループの下に配置すれば大丈夫です。"}, {"type": "subtitle", "time": 13582.79, "timestamp": "03:46:22", "text": "わかった。"}, {"type": "subtitle", "time": 13584.55, "timestamp": "03:46:24", "text": "ああ、"}, {"type": "subtitle", "time": 13587.75, "timestamp": "03:46:27", "text": "わかった。それはいいです。わかった。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 13593.91, "timestamp": "03:46:33", "text": "うん。私はレクリエーションをしています"}, {"type": "subtitle", "time": 13598.229, "timestamp": "03:46:38", "text": "素晴らしいウィキからのすべて、ウィキ"}, {"type": "subtitle", "time": 13600.87, "timestamp": "03:46:40", "text": "ページ 私はそれを私の"}, {"type": "subtitle", "time": 13602.87, "timestamp": "03:46:42", "text": "Webサイト"}, {"type": "subtitle", "time": 13605.75, "timestamp": "03:46:45", "text": "えーと、いくつかは言えない"}, {"type": "subtitle", "time": 13609.03, "timestamp": "03:46:49", "text": "今はウィキに載せます"}, {"type": "subtitle", "time": 13613.99, "timestamp": "03:46:53", "text": "ウェブサイトなので、もし誰かが今私は"}, {"type": "subtitle", "time": 13616.15, "timestamp": "03:46:56", "text": "幻のページが利用できないことに気づきました"}, {"type": "subtitle", "time": 13618.71, "timestamp": "03:46:58", "text": "中国では中国がそれをブロックしたので私は"}]
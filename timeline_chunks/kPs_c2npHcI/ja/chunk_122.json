[{"type": "subtitle", "time": 7327.589, "timestamp": "02:02:07", "text": "私たちはこっそりと"}, {"type": "subtitle", "time": 7329.51, "timestamp": "02:02:09", "text": "公開サイトを永久にバックアップします。"}, {"type": "subtitle", "time": 7332.79, "timestamp": "02:02:12", "text": "忘れただけ"}, {"type": "subtitle", "time": 7334.95, "timestamp": "02:02:14", "text": "復元ボタン。復元ボタンがあります"}, {"type": "subtitle", "time": 7344.39, "timestamp": "02:02:24", "text": "バックアップ。ああ、彼らはサイトのバックアップを持っている"}, {"type": "subtitle", "time": 7346.149, "timestamp": "02:02:26", "text": "システム。あ、待って、待って、待って、待って。は"}, {"type": "subtitle", "time": 7349.51, "timestamp": "02:02:29", "text": "そこにあるの？待って。"}, {"type": "subtitle", "time": 7351.03, "timestamp": "02:02:31", "text": "設定。"}, {"type": "subtitle", "time": 7355.589, "timestamp": "02:02:35", "text": "ああ、ここにある。ああ、彼らにはバックアップがあるんだ。"}, {"type": "subtitle", "time": 7369.109, "timestamp": "02:02:49", "text": "ああ、これはいいですね。"}, {"type": "subtitle", "time": 7372.229, "timestamp": "02:02:52", "text": "古いバージョンに戻すことができます"}, {"type": "subtitle", "time": 7374.149, "timestamp": "02:02:54", "text": "などなど。"}]
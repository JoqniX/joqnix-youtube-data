[{"type": "subtitle", "time": 18122.868, "timestamp": "05:02:02", "text": "日付は年です"}, {"type": "subtitle", "time": 18124.868, "timestamp": "05:02:04", "text": "日付"}, {"type": "subtitle", "time": 18127.03, "timestamp": "05:02:07", "text": "やや太字"}, {"type": "subtitle", "time": 18131.75, "timestamp": "05:02:11", "text": "なぜなら、そちらの方がより焦点が当てられているからです。"}, {"type": "subtitle", "time": 18134.47, "timestamp": "05:02:14", "text": "はい、できます。"}, {"type": "subtitle", "time": 18136.628, "timestamp": "05:02:16", "text": "それはつまり、私は「ああ神様」と書かなければならないということです。私"}, {"type": "subtitle", "time": 18140.39, "timestamp": "05:02:20", "text": "「ああ」と言わなければならない、"}, {"type": "subtitle", "time": 18143.91, "timestamp": "05:02:23", "text": "わかった。大丈夫。私はこれをやります。"}, {"type": "subtitle", "time": 18147.03, "timestamp": "05:02:27", "text": "そう思った。実際に考えた"}, {"type": "subtitle", "time": 18172.15, "timestamp": "05:02:52", "text": "履歴リスト項目"}, {"type": "subtitle", "time": 18173.67, "timestamp": "05:02:53", "text": "年"}, {"type": "subtitle", "time": 18175.19, "timestamp": "05:02:55", "text": "文章。"}, {"type": "subtitle", "time": 18177.67, "timestamp": "05:02:57", "text": "わかった。歴史"}]
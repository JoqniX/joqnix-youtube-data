[{"type": "subtitle", "time": 21129.99, "timestamp": "05:52:09", "text": "えっと、それで私はフレックスボードを作りました"}, {"type": "subtitle", "time": 21132.788, "timestamp": "05:52:12", "text": "など"}, {"type": "subtitle", "time": 21136.628, "timestamp": "05:52:16", "text": "GST の場合、担当者が来て"}, {"type": "subtitle", "time": 21139.67, "timestamp": "05:52:19", "text": "えっと、それが正当なビジネスかどうか今すぐ確認してください"}, {"type": "subtitle", "time": 21143.19, "timestamp": "05:52:23", "text": "あるいは、彼らは今すぐその場所に来るかもしれない。"}, {"type": "subtitle", "time": 21148.07, "timestamp": "05:52:28", "text": "それで、一時的なものを作りました。"}, {"type": "subtitle", "time": 21151.91, "timestamp": "05:52:31", "text": "ドアにフレックスボードを取り付けました"}, {"type": "subtitle", "time": 21154.31, "timestamp": "05:52:34", "text": "ロゴなど全て揃っているが、"}, {"type": "subtitle", "time": 21156.948, "timestamp": "05:52:36", "text": "新しいロゴは新しいものに合わない"}, {"type": "subtitle", "time": 21159.19, "timestamp": "05:52:39", "text": "現在モデル化中。だから、私はこう考えている"}, {"type": "subtitle", "time": 21162.39, "timestamp": "05:52:42", "text": "それを変更する"}, {"type": "subtitle", "time": 21165.35, "timestamp": "05:52:45", "text": "短いロゴ部分のみ。"}, {"type": "subtitle", "time": 21168.15, "timestamp": "05:52:48", "text": "わからない。"}, {"type": "subtitle", "time": 21170.47, "timestamp": "05:52:50", "text": "私がすべきことは、私が持っていると思いますか"}, {"type": "subtitle", "time": 21174.788, "timestamp": "05:52:54", "text": "それを変更するには？そうなんですか？"}]
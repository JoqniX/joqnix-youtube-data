[{"type": "subtitle", "time": 6302.87, "timestamp": "01:45:02", "text": "だから私はそれを自分の有利に利用できる"}, {"type": "subtitle", "time": 6307.51, "timestamp": "01:45:07", "text": "そして歴史。ええ、彼らは全部入れて"}, {"type": "subtitle", "time": 6311.109, "timestamp": "01:45:11", "text": "ああ、彼らはこう書いた"}, {"type": "subtitle", "time": 6315.51, "timestamp": "01:45:15", "text": "セクションをリンクする方法を学ぶ必要があります"}, {"type": "subtitle", "time": 6318.07, "timestamp": "01:45:18", "text": "そして全て。私はあなたがどのようにできると信じています"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "リンクセクションは、リンクの中にあるようなものです"}, {"type": "subtitle", "time": 6322.31, "timestamp": "01:45:22", "text": "ボタン。"}, {"type": "subtitle", "time": 6324.629, "timestamp": "01:45:24", "text": "リンクボタンを設置して確認してみます。えっと"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "ターゲット。いいえ。"}, {"type": "subtitle", "time": 6340.39, "timestamp": "01:45:40", "text": "それはPですか？ああ、セクションを選んでください。"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "おお。何てことだ。たくさんの物がある"}, {"type": "subtitle", "time": 6345.59, "timestamp": "01:45:45", "text": "ここ。"}, {"type": "subtitle", "time": 6349.59, "timestamp": "01:45:49", "text": "でも待って、どうやってセクションを入れるの？"}, {"type": "subtitle", "time": 6352.709, "timestamp": "01:45:52", "text": "ああ、なんてことだ、ものすごくたくさんある。何"}, {"type": "subtitle", "time": 6357.43, "timestamp": "01:45:57", "text": "これですか？ SNSエリア。これは私のセクションですか？"}, {"type": "subtitle", "time": 6359.91, "timestamp": "01:45:59", "text": "セクションボタンを閉じる？幾つか"}]
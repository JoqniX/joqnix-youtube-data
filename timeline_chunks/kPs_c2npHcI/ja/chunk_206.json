[{"type": "subtitle", "time": 12362.79, "timestamp": "03:26:02", "text": "私たちがすることは、それを"}, {"type": "subtitle", "time": 12367.349, "timestamp": "03:26:07", "text": "フレックスになることができるdiv"}, {"type": "subtitle", "time": 12369.91, "timestamp": "03:26:09", "text": "生のものを持っている。"}, {"type": "subtitle", "time": 12377.269, "timestamp": "03:26:17", "text": "そして"}, {"type": "subtitle", "time": 12379.83, "timestamp": "03:26:19", "text": "スパン"}, {"type": "subtitle", "time": 12381.99, "timestamp": "03:26:21", "text": "その中。"}, {"type": "subtitle", "time": 12385.03, "timestamp": "03:26:25", "text": "今は奇妙に見えるだろう、本当に奇妙に"}, {"type": "subtitle", "time": 12388.55, "timestamp": "03:26:28", "text": "こんな感じだけど、大丈夫。私たちができること"}, {"type": "subtitle", "time": 12390.389, "timestamp": "03:26:30", "text": "は"}, {"type": "subtitle", "time": 12397.349, "timestamp": "03:26:37", "text": "ああ、でもこれだと変に見えるだろうな。"}, {"type": "subtitle", "time": 12399.75, "timestamp": "03:26:39", "text": "待って。"}, {"type": "subtitle", "time": 12410.63, "timestamp": "03:26:50", "text": "フレックスインラインをやって、"}]
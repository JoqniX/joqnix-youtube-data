[{"type": "subtitle", "time": 4140.149, "timestamp": "01:09:00", "text": "もしあなたがウェブサイトを見ているなら、もし私が"}, {"type": "subtitle", "time": 4144.63, "timestamp": "01:09:04", "text": "私もここに載せるつもりですが、短い"}, {"type": "subtitle", "time": 4147.749, "timestamp": "01:09:07", "text": "そのバージョン、短縮版、例えば"}, {"type": "subtitle", "time": 4149.829, "timestamp": "01:09:09", "text": "こんな感じになるだろう"}, {"type": "subtitle", "time": 4156.63, "timestamp": "01:09:16", "text": "ええ、短いバージョンでは、次のようになります"}, {"type": "subtitle", "time": 4159.99, "timestamp": "01:09:19", "text": "私のモデルを小さなモデルとして表示します"}, {"type": "subtitle", "time": 4163.669, "timestamp": "01:09:23", "text": "そして名前のプロフィールのようなものこれこれ"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "そして、これを読むにはクリックする必要があります"}, {"type": "subtitle", "time": 4169.43, "timestamp": "01:09:29", "text": "もっと読むにはリンクがあります"}, {"type": "subtitle", "time": 4172.309, "timestamp": "01:09:32", "text": "こちらをクリックすると"}, {"type": "subtitle", "time": 4175.269, "timestamp": "01:09:35", "text": "概要ページへ"}, {"type": "subtitle", "time": 4179.749, "timestamp": "01:09:39", "text": "ええ、ええ、あなたが見たデータは"}, {"type": "subtitle", "time": 4182.47, "timestamp": "01:09:42", "text": "えーと、一番上に表示されるランディングページ"}, {"type": "subtitle", "time": 4185.11, "timestamp": "01:09:45", "text": "その下にはデータがあります"}, {"type": "subtitle", "time": 4186.07, "timestamp": "01:09:46", "text": "セクション"}, {"type": "subtitle", "time": 4188.55, "timestamp": "01:09:48", "text": "すべてのデータが含まれています"}, {"type": "subtitle", "time": 4191.59, "timestamp": "01:09:51", "text": "ここ。そうですね、"}, {"type": "subtitle", "time": 4195.59, "timestamp": "01:09:55", "text": "そんな感じ。それが私の考えです。"}]
[{"type": "subtitle", "time": 12127.03, "timestamp": "03:22:07", "text": "はい、どうぞ。そしてその層には、"}, {"type": "subtitle", "time": 12130.63, "timestamp": "03:22:10", "text": "それを"}, {"type": "subtitle", "time": 12134.229, "timestamp": "03:22:14", "text": "これをリンクに構築する必要がある、"}, {"type": "subtitle", "time": 12137.75, "timestamp": "03:22:17", "text": "右？わかった。だから、これは"}, {"type": "subtitle", "time": 12146.229, "timestamp": "03:22:26", "text": "そして、リンク要素をその中に配置します"}]
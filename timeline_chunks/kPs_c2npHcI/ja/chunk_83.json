[{"type": "subtitle", "time": 4980.07, "timestamp": "01:23:00", "text": "チャジに聞かなきゃいけないのを忘れてた"}, {"type": "subtitle", "time": 4984.229, "timestamp": "01:23:04", "text": "ピティ・チャン、どうすればいいの？"}, {"type": "subtitle", "time": 4993.43, "timestamp": "01:23:13", "text": "それで、CFから履歴ページを入手しました。私たちは"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "それは使えます。でももっと歴史を知りたい"}, {"type": "subtitle", "time": 5000.95, "timestamp": "01:23:20", "text": "もの。歴史には同様の出来事があり、"}, {"type": "subtitle", "time": 5004.07, "timestamp": "01:23:24", "text": "すべて。私がやったこと、ですよね？それで"}, {"type": "subtitle", "time": 5007.91, "timestamp": "01:23:27", "text": "それはある意味でメディアとして機能するだろう"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "キット、"}, {"type": "subtitle", "time": 5013.51, "timestamp": "01:23:33", "text": "右？ブランドとその他すべて"}, {"type": "subtitle", "time": 5016.229, "timestamp": "01:23:36", "text": "広告主やその他すべての人にとって。もし私が"}, {"type": "subtitle", "time": 5018.31, "timestamp": "01:23:38", "text": "そう考えると、もし"}, {"type": "subtitle", "time": 5021.27, "timestamp": "01:23:41", "text": "あなたがコンテンツクリエイターで、"}, {"type": "subtitle", "time": 5023.91, "timestamp": "01:23:43", "text": "あなたがどんなビジネスをしているかに関わらず、"}, {"type": "subtitle", "time": 5027.43, "timestamp": "01:23:47", "text": "メディアキットみたいなものが必要だよね？"}, {"type": "subtitle", "time": 5029.43, "timestamp": "01:23:49", "text": "それが私が気づいたことです。あなたはそうしなければならない"}, {"type": "subtitle", "time": 5032.149, "timestamp": "01:23:52", "text": "メディアキットを作成する。"}, {"type": "subtitle", "time": 5036.149, "timestamp": "01:23:56", "text": "では、確認してみましょう。"}, {"type": "subtitle", "time": 5039.83, "timestamp": "01:23:59", "text": "チェックページの方が良いと思います。彼女"}]
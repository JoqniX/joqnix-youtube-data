[{"type": "subtitle", "time": 3844.549, "timestamp": "01:04:04", "text": "ソナって、すごくインドっぽい名前だね。"}, {"type": "subtitle", "time": 3855.51, "timestamp": "01:04:15", "text": "ここにインド人を置くと、"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "なぜAKA Akumaなのか？"}, {"type": "subtitle", "time": 3869.19, "timestamp": "01:04:29", "text": "彼女はなぜここに現れたのか？待って、"}, {"type": "subtitle", "time": 3873.349, "timestamp": "01:04:33", "text": "インド人タイプ。彼女はインド料理が好きだ。ああ、"}, {"type": "subtitle", "time": 3878.23, "timestamp": "01:04:38", "text": "だから彼女は姿を現したのだ。"}, {"type": "subtitle", "time": 3882.23, "timestamp": "01:04:42", "text": "えーと、もう1つは年池です。"}, {"type": "subtitle", "time": 3885.91, "timestamp": "01:04:45", "text": "ほとんどの日本人は"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "えっと"}]
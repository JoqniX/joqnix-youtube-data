[{"type": "subtitle", "time": 18253.19, "timestamp": "05:04:13", "text": "えっと、これを開けて"}, {"type": "subtitle", "time": 18263.83, "timestamp": "05:04:23", "text": "ええ、そういう意味ではもうほとんど終わりです"}, {"type": "subtitle", "time": 18266.31, "timestamp": "05:04:26", "text": "履歴ページを参照してください。"}, {"type": "subtitle", "time": 18269.51, "timestamp": "05:04:29", "text": "私が考えなければならない唯一の例外は"}, {"type": "subtitle", "time": 18275.91, "timestamp": "05:04:35", "text": "画像がある場合はどうなるでしょうか。"}, {"type": "subtitle", "time": 18279.43, "timestamp": "05:04:39", "text": "ええ、ある意味では、私は"}, {"type": "subtitle", "time": 18284.15, "timestamp": "05:04:44", "text": "画像ですが、画像は良いものです。今私は思う"}, {"type": "subtitle", "time": 18287.91, "timestamp": "05:04:47", "text": "それについて言えば、画像は良い、"}, {"type": "subtitle", "time": 18290.628, "timestamp": "05:04:50", "text": "右？"}, {"type": "subtitle", "time": 18295.11, "timestamp": "05:04:55", "text": "画像は波を起こす手段だ。ええ、そうなるでしょう"}, {"type": "subtitle", "time": 18298.47, "timestamp": "05:04:58", "text": "より魅力的に見える。もし私が"}]
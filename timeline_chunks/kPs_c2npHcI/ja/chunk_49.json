[{"type": "subtitle", "time": 2941.03, "timestamp": "00:49:01", "text": "これも好きです。このセットアップの男"}, {"type": "subtitle", "time": 2945.829, "timestamp": "00:49:05", "text": "それもいいですね。そして、あることが"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "まるで"}, {"type": "subtitle", "time": 2953.03, "timestamp": "00:49:13", "text": "スクロールボタン、マウスボタン。"}, {"type": "subtitle", "time": 2956.15, "timestamp": "00:49:16", "text": "本当に素晴らしい。だから私は、"}, {"type": "subtitle", "time": 2960.069, "timestamp": "00:49:20", "text": "ウェブサイトが完成したら、"}, {"type": "subtitle", "time": 2963.19, "timestamp": "00:49:23", "text": "えっと、これを再現することに挑戦します"}, {"type": "subtitle", "time": 2966.309, "timestamp": "00:49:26", "text": "この種のフォーマットをスタイル化する"}, {"type": "subtitle", "time": 2969.109, "timestamp": "00:49:29", "text": "こうやって、だって今はもちろん私は"}, {"type": "subtitle", "time": 2971.19, "timestamp": "00:49:31", "text": "問題は、いつでも依頼できることです"}, {"type": "subtitle", "time": 2973.19, "timestamp": "00:49:33", "text": "戻る"}, {"type": "subtitle", "time": 2975.349, "timestamp": "00:49:35", "text": "ウェブサイト関連のことやその他諸々についてですが"}, {"type": "subtitle", "time": 2978.47, "timestamp": "00:49:38", "text": "問題は、彼がそれをハードコーディングして"}, {"type": "subtitle", "time": 2980.79, "timestamp": "00:49:40", "text": "今、それは私が"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "自分でホストするか、購入するか"}, {"type": "subtitle", "time": 2987.109, "timestamp": "00:49:47", "text": "ホスティングサーバーとその他すべて"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "いたずら、本当にたくさんのこと"}, {"type": "subtitle", "time": 2993.27, "timestamp": "00:49:53", "text": "それは私たちの"}, {"type": "subtitle", "time": 2996.069, "timestamp": "00:49:56", "text": "えーと、バックエンド関連のこととか、グッズとか、そういう類のこと"}, {"type": "subtitle", "time": 2998.63, "timestamp": "00:49:58", "text": "将来的にはeコマース関連などは"}]
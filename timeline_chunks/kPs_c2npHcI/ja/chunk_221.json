[{"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "ええ、私の使い方ではうまくいきます。歴史"}, {"type": "subtitle", "time": 13265.83, "timestamp": "03:41:05", "text": "価値のつながり。ええ、カーソルを合わせるとね。"}, {"type": "subtitle", "time": 13268.71, "timestamp": "03:41:08", "text": "ああ、これで十分だ。"}, {"type": "subtitle", "time": 13270.55, "timestamp": "03:41:10", "text": "うん。"}, {"type": "subtitle", "time": 13273.03, "timestamp": "03:41:13", "text": "はい、このスパンを削除します"}, {"type": "subtitle", "time": 13275.99, "timestamp": "03:41:15", "text": "スパン。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 13279.03, "timestamp": "03:41:19", "text": "わかった。これがそれを証明している。私は次のようにできます"}, {"type": "subtitle", "time": 13300.79, "timestamp": "03:41:40", "text": "ああ、このスパム野郎のことだ。ええ、できます"}, {"type": "subtitle", "time": 13302.469, "timestamp": "03:41:42", "text": "この男を排除しろ。実際、私たちは"}, {"type": "subtitle", "time": 13305.269, "timestamp": "03:41:45", "text": "それ。"}, {"type": "subtitle", "time": 13308.87, "timestamp": "03:41:48", "text": "そして最初のものも。えっと、実は"}]
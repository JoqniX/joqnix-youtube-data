[{"type": "subtitle", "time": 13620.55, "timestamp": "03:47:00", "text": "わかりました、私のウェブサイトに掲載します"}, {"type": "subtitle", "time": 13622.229, "timestamp": "03:47:02", "text": "そして"}, {"type": "subtitle", "time": 13626.07, "timestamp": "03:47:06", "text": "えっと、中国のユーザーやその周辺地域の人向け"}, {"type": "subtitle", "time": 13627.67, "timestamp": "03:47:07", "text": "彼らがアクセスできる世界は私の"}, {"type": "subtitle", "time": 13630.15, "timestamp": "03:47:10", "text": "Webサイト。いや、オリジナルみたいな感じ"}, {"type": "subtitle", "time": 13632.55, "timestamp": "03:47:12", "text": "ソースの権利"}, {"type": "subtitle", "time": 13635.189, "timestamp": "03:47:15", "text": "だから私はそう考えた"}, {"type": "subtitle", "time": 13637.51, "timestamp": "03:47:17", "text": "だから、情報を入れることができる"}, {"type": "subtitle", "time": 13641.83, "timestamp": "03:47:21", "text": "私はこれをしたか、あれをしたかなど"}, {"type": "subtitle", "time": 13648.95, "timestamp": "03:47:28", "text": "わかった。だから、クリックしないで"}, {"type": "subtitle", "time": 13652.309, "timestamp": "03:47:32", "text": "スパン上で。待って、"}, {"type": "subtitle", "time": 13655.83, "timestamp": "03:47:35", "text": "参照元を記載する必要があるんですよね？えっと、"}, {"type": "subtitle", "time": 13658.389, "timestamp": "03:47:38", "text": "どこに"}, {"type": "subtitle", "time": 13660.87, "timestamp": "03:47:40", "text": "それ？それを"}, {"type": "subtitle", "time": 13668.63, "timestamp": "03:47:48", "text": "リンクアドレスをコピーしてください。"}, {"type": "subtitle", "time": 13671.51, "timestamp": "03:47:51", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 13675.59, "timestamp": "03:47:55", "text": "ターゲットは空白です。だから、それをクリックすると、"}, {"type": "subtitle", "time": 13678.309, "timestamp": "03:47:58", "text": "これをすると、"}]
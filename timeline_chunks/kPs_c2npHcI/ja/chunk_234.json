[{"type": "subtitle", "time": 14042.79, "timestamp": "03:54:02", "text": "あ、待って。こっちの方が実際は良く見える。"}, {"type": "subtitle", "time": 14045.349, "timestamp": "03:54:05", "text": "中央揃えバージョン。"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "ほら、もっといいと思わない？"}, {"type": "subtitle", "time": 14056.95, "timestamp": "03:54:16", "text": "リスト項目が送信される場合？まるで"}, {"type": "subtitle", "time": 14059.429, "timestamp": "03:54:19", "text": "あなたは電話をしています、あなたは、あなたは持っています"}, {"type": "subtitle", "time": 14061.83, "timestamp": "03:54:21", "text": "これを読むには目を細めなければならない。しかしもし"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "つまり、もしこうなら、"}, {"type": "subtitle", "time": 14069.51, "timestamp": "03:54:29", "text": "ウインク。そっちの方がいいんじゃない？"}, {"type": "subtitle", "time": 14074.87, "timestamp": "03:54:34", "text": "読みやすさのためでしょうか？"}, {"type": "subtitle", "time": 14097.67, "timestamp": "03:54:57", "text": "ああ、そんなやり方はできません。はぁ？"}, {"type": "subtitle", "time": 14099.349, "timestamp": "03:54:59", "text": "えっと、"}]
[{"type": "subtitle", "time": 18301.59, "timestamp": "05:05:01", "text": "良い画像ですね"}, {"type": "subtitle", "time": 18316.628, "timestamp": "05:05:16", "text": "また、"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "すべてのストリームのサムネイル、すべての"}, {"type": "subtitle", "time": 18322.788, "timestamp": "05:05:22", "text": "これまでコラボレーションした人や出演した人"}, {"type": "subtitle", "time": 18325.83, "timestamp": "05:05:25", "text": "オンとか、何か。つまり、ある意味では、これは"}, {"type": "subtitle", "time": 18328.31, "timestamp": "05:05:28", "text": "歴史の一節は"}, {"type": "subtitle", "time": 18331.99, "timestamp": "05:05:31", "text": "そんな感じ。私がどこに現れても"}, {"type": "subtitle", "time": 18335.19, "timestamp": "05:05:35", "text": "テレビ番組で言えば、もし私が"}, {"type": "subtitle", "time": 18337.51, "timestamp": "05:05:37", "text": "正しく記憶している"}, {"type": "subtitle", "time": 18340.23, "timestamp": "05:05:40", "text": "テレビ番組に出演したユーチューバーや"}, {"type": "subtitle", "time": 18342.628, "timestamp": "05:05:42", "text": "プログラムや"}, {"type": "subtitle", "time": 18347.35, "timestamp": "05:05:47", "text": "何かのタレントショーだったか、それが何であれ。"}, {"type": "subtitle", "time": 18349.03, "timestamp": "05:05:49", "text": "u"}, {"type": "subtitle", "time": 18354.788, "timestamp": "05:05:54", "text": "そう、インド風のやつだから、まさにそんな感じ"}, {"type": "chat", "time": 18357.009, "timestamp": "05:05:57", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "we would need their and corp's permission right ?"}, {"type": "subtitle", "time": 18357.99, "timestamp": "05:05:57", "text": "えっと、彼らは言及することもできます"}]
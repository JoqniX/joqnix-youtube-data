[{"type": "subtitle", "time": 18550.55, "timestamp": "05:09:10", "text": "リンクを新しいタブで開きますか？セルフが開く"}, {"type": "subtitle", "time": 18553.83, "timestamp": "05:09:13", "text": "同じタブ内のリンク。パターンは"}, {"type": "subtitle", "time": 18556.55, "timestamp": "05:09:16", "text": "I 内のパターンフレーム内のリンク"}, {"type": "subtitle", "time": 18559.35, "timestamp": "05:09:19", "text": "フレーム。上部が本体全体を開く"}, {"type": "subtitle", "time": 18563.11, "timestamp": "05:09:23", "text": "ウィンドウがネストされた構造を破壊する。はぁ。"}, {"type": "subtitle", "time": 18565.99, "timestamp": "05:09:25", "text": "Blankは新しいタブで開きます。真のセキュリティ"}, {"type": "subtitle", "time": 18568.628, "timestamp": "05:09:28", "text": "特に持続する"}, {"type": "subtitle", "time": 18571.51, "timestamp": "05:09:31", "text": "Iフレームの親要素を使用している場合は、まれなケースです。"}, {"type": "subtitle", "time": 18574.31, "timestamp": "05:09:34", "text": "そしてトップ"}, {"type": "subtitle", "time": 18577.83, "timestamp": "05:09:37", "text": "悪意のあるウェブサイトを防ぐには、なぜ本物のウェブサイトを使用する必要があるのか"}, {"type": "subtitle", "time": 18581.27, "timestamp": "05:09:41", "text": "元のタブにアクセスするには、"}, {"type": "subtitle", "time": 18583.59, "timestamp": "05:09:43", "text": "窓開閉器はセキュリティを向上させ、"}, {"type": "subtitle", "time": 18589.27, "timestamp": "05:09:49", "text": "[音楽]"}]
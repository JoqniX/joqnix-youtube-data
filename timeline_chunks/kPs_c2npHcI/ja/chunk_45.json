[{"type": "subtitle", "time": 2702.71, "timestamp": "00:45:02", "text": "とりあえず、このテキストをコピー＆ペーストしておきます。"}, {"type": "subtitle", "time": 2704.309, "timestamp": "00:45:04", "text": "それから私は自分のために変更を加える"}, {"type": "subtitle", "time": 2707.03, "timestamp": "00:45:07", "text": "ウェブサイトは後で見るから、私が何をしたかは気にしないで"}, {"type": "subtitle", "time": 2712.309, "timestamp": "00:45:12", "text": "2020年、2021年、2022年、2023年、そして24年など"}, {"type": "subtitle", "time": 2714.55, "timestamp": "00:45:14", "text": "それ"}, {"type": "subtitle", "time": 2718.39, "timestamp": "00:45:18", "text": "ええ、とりあえずテキストを入力するだけにします"}, {"type": "subtitle", "time": 2722.15, "timestamp": "00:45:22", "text": "今のところ、ページの中で、"}, {"type": "subtitle", "time": 2726.23, "timestamp": "00:45:26", "text": "それなら、私にできることを考えてみます"}, {"type": "subtitle", "time": 2730.79, "timestamp": "00:45:30", "text": "だって、ある意味、私はただ"}, {"type": "subtitle", "time": 2734.63, "timestamp": "00:45:34", "text": "私のジョックニックに関する私のものについて、私はただ"}, {"type": "subtitle", "time": 2738.23, "timestamp": "00:45:38", "text": "また、オネクシア関連のものも載せたい"}, {"type": "subtitle", "time": 2740.95, "timestamp": "00:45:40", "text": "良い。"}, {"type": "subtitle", "time": 2745.109, "timestamp": "00:45:45", "text": "ある意味、これも歴史だ。"}, {"type": "subtitle", "time": 2748.069, "timestamp": "00:45:48", "text": "でも、待って、ジョック、君は"}, {"type": "subtitle", "time": 2751.67, "timestamp": "00:45:51", "text": "どちらでもここに載せることができます"}, {"type": "subtitle", "time": 2755.19, "timestamp": "00:45:55", "text": "それをOniaのウェブサイトに掲載できます。"}, {"type": "subtitle", "time": 2757.51, "timestamp": "00:45:57", "text": "だから私はこう思った、"}, {"type": "subtitle", "time": 2759.67, "timestamp": "00:45:59", "text": "「ええ、実際にそれを載せることができます"}]
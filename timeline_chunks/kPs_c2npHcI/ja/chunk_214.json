[{"type": "subtitle", "time": 12841.59, "timestamp": "03:34:01", "text": "えーとテキストまたは"}, {"type": "subtitle", "time": 12846.309, "timestamp": "03:34:06", "text": "フレックスボックスと"}, {"type": "subtitle", "time": 12864.07, "timestamp": "03:34:24", "text": "テキストの横に、左右揃えで配置してください。"}, {"type": "subtitle", "time": 12877.429, "timestamp": "03:34:37", "text": "同じ行で、私にとってはより大きなものを使用する"}, {"type": "subtitle", "time": 12880.55, "timestamp": "03:34:40", "text": "フレックス内の単一ラインの整列アイコン"}, {"type": "subtitle", "time": 12886.15, "timestamp": "03:34:46", "text": "テキストからあまりにもかけ離れているように感じるかもしれない"}, {"type": "subtitle", "time": 12893.19, "timestamp": "03:34:53", "text": "テキストに「とてもきれい」と「意図」が含まれている場合は、"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "クリック可能であること。デュアルでモダンな印象"}]
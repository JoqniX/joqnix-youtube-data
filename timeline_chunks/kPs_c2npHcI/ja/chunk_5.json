[{"type": "subtitle", "time": 306.07, "timestamp": "00:05:06", "text": "それと、いいアイデアがあったんだ"}, {"type": "subtitle", "time": 309.11, "timestamp": "00:05:09", "text": "それは"}, {"type": "subtitle", "time": 311.749, "timestamp": "00:05:11", "text": "えっと"}, {"type": "subtitle", "time": 316.39, "timestamp": "00:05:16", "text": "それは、えっと、私は自分のものを持ちたかった"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "やることリスト（ToDoリスト）システム。"}, {"type": "subtitle", "time": 322.469, "timestamp": "00:05:22", "text": "いいですか、私の話を聞いてください。私の話を聞いてください。"}, {"type": "subtitle", "time": 325.67, "timestamp": "00:05:25", "text": "よし、それで、やるべきことリストを作りたかったんだ"}, {"type": "subtitle", "time": 328.31, "timestamp": "00:05:28", "text": "タスク一覧システム。"}, {"type": "subtitle", "time": 332.71, "timestamp": "00:05:32", "text": "ええ、そうですね、購入することでできます"}, {"type": "subtitle", "time": 335.67, "timestamp": "00:05:35", "text": "無料のもののように、または有料のもののように"}, {"type": "subtitle", "time": 337.27, "timestamp": "00:05:37", "text": "拡大、"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "右？でも私はもっと"}, {"type": "subtitle", "time": 344.07, "timestamp": "00:05:44", "text": "Notishを使って作成しています。"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "私はもっ​​とこうしようと思っていました"}, {"type": "subtitle", "time": 350.629, "timestamp": "00:05:50", "text": "すでに持っているような考え"}, {"type": "subtitle", "time": 353.99, "timestamp": "00:05:53", "text": "ストリーム配信のように、ライブ配信の様子が表示されます"}, {"type": "subtitle", "time": 356.23, "timestamp": "00:05:56", "text": "そして、活動状態、トピック状態。"}, {"type": "subtitle", "time": 358.87, "timestamp": "00:05:58", "text": "うん、今はストリームについて考えている"}]
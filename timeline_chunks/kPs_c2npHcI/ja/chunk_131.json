[{"type": "subtitle", "time": 7864.709, "timestamp": "02:11:04", "text": "そして、それをH1またはええとと表記することもできます"}, {"type": "subtitle", "time": 7866.95, "timestamp": "02:11:06", "text": "H1とか何とかは関係ない。そうではない"}, {"type": "subtitle", "time": 7871.99, "timestamp": "02:11:11", "text": "案件。でも、私はこれをやりたい"}, {"type": "subtitle", "time": 7876.55, "timestamp": "02:11:16", "text": "全部Hで始まる年みたいなやつ、ほら、年だよ。"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "えっと、それは後でできるかもしれないけど、"}, {"type": "subtitle", "time": 7883.189, "timestamp": "02:11:23", "text": "5月20日のままにしておいてください"}, {"type": "subtitle", "time": 7891.109, "timestamp": "02:11:31", "text": "えっと"}, {"type": "subtitle", "time": 7905.75, "timestamp": "02:11:45", "text": "スパンイヤーラインテキストとこれは"}, {"type": "subtitle", "time": 7908.709, "timestamp": "02:11:48", "text": "背景1。それは私が思うことですか"}, {"type": "subtitle", "time": 7910.87, "timestamp": "02:11:50", "text": "は？まるで"}, {"type": "subtitle", "time": 7914.31, "timestamp": "02:11:54", "text": "ああ、彼らが何をしたのか、なんとなく理解できる。"}, {"type": "subtitle", "time": 7915.83, "timestamp": "02:11:55", "text": "ここ。"}, {"type": "subtitle", "time": 7919.27, "timestamp": "02:11:59", "text": "よし、新しい要素を作ってみよう。"}]
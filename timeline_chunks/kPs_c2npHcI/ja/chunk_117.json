[{"type": "subtitle", "time": 7020.39, "timestamp": "01:57:00", "text": "彼らはページを作成している。おお。"}, {"type": "subtitle", "time": 7022.55, "timestamp": "01:57:02", "text": "お問い合わせページはどのようなデザインになっていますか？"}, {"type": "subtitle", "time": 7024.709, "timestamp": "01:57:04", "text": "ああ、横に表示されますね。問い合わせ"}, {"type": "subtitle", "time": 7045.189, "timestamp": "01:57:25", "text": "ニャー、ゲームしてるよ。参加できません"}, {"type": "subtitle", "time": 7046.709, "timestamp": "01:57:26", "text": "あなた。"}, {"type": "subtitle", "time": 7055.75, "timestamp": "01:57:35", "text": "スクロール。私はスクロールするものが大好きです"}, {"type": "subtitle", "time": 7063.35, "timestamp": "01:57:43", "text": "彼女のロゴ、すごくかっこいい。今は、"}, {"type": "subtitle", "time": 7067.27, "timestamp": "01:57:47", "text": "手書きのロゴ。ほら、彼女のロゴは"}, {"type": "subtitle", "time": 7069.75, "timestamp": "01:57:49", "text": "いいね。"}]
[{"type": "subtitle", "time": 15328.71, "timestamp": "04:15:28", "text": "ああ、これはまずい。ああ、神様。えっと"}, {"type": "subtitle", "time": 15350.95, "timestamp": "04:15:50", "text": "いいえ、心配しないでください。テキストはありません"}, {"type": "subtitle", "time": 15352.87, "timestamp": "04:15:52", "text": "しかし、それはこうなるでしょう。それ"}, {"type": "subtitle", "time": 15356.79, "timestamp": "04:15:56", "text": "それなら大丈夫です。いいえ。"}]
[{"type": "subtitle", "time": 9061.349, "timestamp": "02:31:01", "text": "うん、こうやって作るよ。私は持っている"}, {"type": "subtitle", "time": 9071.67, "timestamp": "02:31:11", "text": "ええと、ローカライズを追加します。どこ"}, {"type": "subtitle", "time": 9076.55, "timestamp": "02:31:16", "text": "今回のローカライズの時間ですか？えっと、時間のことですね。"}, {"type": "subtitle", "time": 9079.59, "timestamp": "02:31:19", "text": "日付と時刻の属性のことですね。"}, {"type": "subtitle", "time": 9083.51, "timestamp": "02:31:23", "text": "時間は必要ありません。それで"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "8月"}, {"type": "subtitle", "time": 9094.389, "timestamp": "02:31:34", "text": "30日。"}, {"type": "subtitle", "time": 9103.83, "timestamp": "02:31:43", "text": "なぜ2001年なのか？えっと、2020年を変えるにはどうすればいいでしょうか。"}, {"type": "subtitle", "time": 9108.15, "timestamp": "02:31:48", "text": "うん。ここからなら変更できます。"}, {"type": "subtitle", "time": 9111.83, "timestamp": "02:31:51", "text": "右。 2020年日曜日"}, {"type": "subtitle", "time": 9113.99, "timestamp": "02:31:53", "text": "または単に短い"}, {"type": "subtitle", "time": 9116.79, "timestamp": "02:31:56", "text": "そうなるだろう"}, {"type": "subtitle", "time": 9118.95, "timestamp": "02:31:58", "text": "中くらい"}]
[{"type": "subtitle", "time": 2761.99, "timestamp": "00:46:01", "text": "インターネット、"}, {"type": "subtitle", "time": 2764.71, "timestamp": "00:46:04", "text": "右？私は文字通りコピー＆ペーストできます"}, {"type": "subtitle", "time": 2767.75, "timestamp": "00:46:07", "text": "ジョギングの履歴と"}, {"type": "subtitle", "time": 2770.47, "timestamp": "00:46:10", "text": "ええ、変更を加える必要があります"}, {"type": "subtitle", "time": 2774.63, "timestamp": "00:46:14", "text": "Onexiaのウェブサイトの情報によると、そうですよね？"}, {"type": "subtitle", "time": 2779.67, "timestamp": "00:46:19", "text": "ええ、でも、今のところはそれが私の考えです。"}, {"type": "subtitle", "time": 2803.67, "timestamp": "00:46:43", "text": "ええと、時々、そうならないことがあります。"}, {"type": "subtitle", "time": 2805.99, "timestamp": "00:46:45", "text": "クリックするときは、押す必要があります"}, {"type": "subtitle", "time": 2809.99, "timestamp": "00:46:49", "text": "複数回ページに移動して"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "それはまずい。"}, {"type": "subtitle", "time": 2815.91, "timestamp": "00:46:55", "text": "なぜそうなっているのか分かりませんが、"}, {"type": "subtitle", "time": 2819.09, "timestamp": "00:46:59", "text": "でも、でも、変だよね。"}]
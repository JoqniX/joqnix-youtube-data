[{"type": "subtitle", "time": 362.79, "timestamp": "00:06:02", "text": "やることリストみたいなやつだよね？想像してみてください、私たちは"}, {"type": "subtitle", "time": 364.87, "timestamp": "00:06:04", "text": "やるべきことリストを作成する"}, {"type": "subtitle", "time": 369.59, "timestamp": "00:06:09", "text": "アクティビティ、そして私は、えーと、"}, {"type": "subtitle", "time": 371.909, "timestamp": "00:06:11", "text": "完了して、そのステータスに満足している、ということですよね？のように"}, {"type": "subtitle", "time": 375.99, "timestamp": "00:06:15", "text": "データベース全体。私たちはできる、私たちはできる、えっと、私たちは"}, {"type": "subtitle", "time": 378.87, "timestamp": "00:06:18", "text": "これをチェックできます"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "に基づく"}, {"type": "subtitle", "time": 383.59, "timestamp": "00:06:23", "text": "ステータスリストに基づいて。もしそれが"}, {"type": "subtitle", "time": 386.87, "timestamp": "00:06:26", "text": "やるべきことリストって、まだ終わってないってことだよね？それ"}, {"type": "subtitle", "time": 388.79, "timestamp": "00:06:28", "text": "小切手帳ですよね？チェックマーク"}, {"type": "subtitle", "time": 392.39, "timestamp": "00:06:32", "text": "箱ですよね？アイテムの 1 つが"}, {"type": "subtitle", "time": 394.95, "timestamp": "00:06:34", "text": "完了したか何かにチェックを入れる"}, {"type": "subtitle", "time": 397.749, "timestamp": "00:06:37", "text": "完了としてチェックを入れたら、次のようにできます"}, {"type": "subtitle", "time": 402.39, "timestamp": "00:06:42", "text": "それには何か関係がある。実際に"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "ウェブ上で、眉毛の上で、私は"}, {"type": "subtitle", "time": 407.43, "timestamp": "00:06:47", "text": "Web Studio を使用しているので、コード上で"}, {"type": "subtitle", "time": 410.15, "timestamp": "00:06:50", "text": "テキストに取り消し線を引く"}, {"type": "subtitle", "time": 413.11, "timestamp": "00:06:53", "text": "取り消し線を引く。どれだけクールか想像してみて"}, {"type": "subtitle", "time": 415.51, "timestamp": "00:06:55", "text": "そうでしょうね。"}, {"type": "subtitle", "time": 418.469, "timestamp": "00:06:58", "text": "ああ、それは今思いついた新しいアイデアだ。させて"}]
[{"type": "subtitle", "time": 421.83, "timestamp": "00:07:01", "text": "実際に書き留めておきます。"}, {"type": "subtitle", "time": 433.67, "timestamp": "00:07:13", "text": "病院勤務医"}, {"type": "subtitle", "time": 445.53, "timestamp": "00:07:25", "text": "いやいや、これはウェブサイト関連の話じゃないよ。"}, {"type": "subtitle", "time": 446.79, "timestamp": "00:07:26", "text": "[音楽]"}, {"type": "subtitle", "time": 450.95, "timestamp": "00:07:30", "text": "作ってここに置けますよ。"}, {"type": "subtitle", "time": 458.629, "timestamp": "00:07:38", "text": "うん、それでうまくいくはずだ。"}, {"type": "subtitle", "time": 461.27, "timestamp": "00:07:41", "text": "何か食べるものを買うのを忘れてしまった。私は"}, {"type": "subtitle", "time": 471.67, "timestamp": "00:07:51", "text": "ビスケットを買っておけばよかったのに。しかし"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "トイレ休憩を取っても大丈夫です。"}, {"type": "subtitle", "time": 478.629, "timestamp": "00:07:58", "text": "それは間違いなく可能です。"}]
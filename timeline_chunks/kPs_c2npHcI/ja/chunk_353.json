[{"type": "subtitle", "time": 21182.23, "timestamp": "05:53:02", "text": "ああ、わかりました。わかった。待って。人々はチェックできます"}, {"type": "subtitle", "time": 21189.19, "timestamp": "05:53:09", "text": "いいえ、確認していませんし、見せてもいません。"}, {"type": "subtitle", "time": 21191.35, "timestamp": "05:53:11", "text": "心配しないで。心配しないで。"}, {"type": "subtitle", "time": 21201.75, "timestamp": "05:53:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 21203.91, "timestamp": "05:53:23", "text": "おお。"}, {"type": "subtitle", "time": 21220.15, "timestamp": "05:53:40", "text": "[音楽]"}, {"type": "subtitle", "time": 21222.708, "timestamp": "05:53:42", "text": "あなたはGST番号を覚えていません。"}]
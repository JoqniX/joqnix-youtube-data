[{"type": "subtitle", "time": 2644.15, "timestamp": "00:44:04", "text": "特に、本当に小さい大きな"}, {"type": "subtitle", "time": 2654.55, "timestamp": "00:44:14", "text": "少し難しいだろう。えっと、"}, {"type": "subtitle", "time": 2656.39, "timestamp": "00:44:16", "text": "わかった。では、それを公開して様子を見てみよう"}, {"type": "subtitle", "time": 2659.51, "timestamp": "00:44:19", "text": "私の携帯電話のために。"}, {"type": "subtitle", "time": 2662.39, "timestamp": "00:44:22", "text": "確認したいです。"}, {"type": "subtitle", "time": 2667.589, "timestamp": "00:44:27", "text": "でも、今日は終わらせなきゃいけない"}, {"type": "subtitle", "time": 2671.03, "timestamp": "00:44:31", "text": "部品について、そして私は始めなければならない"}, {"type": "subtitle", "time": 2674.309, "timestamp": "00:44:34", "text": "履歴ページ。まずは歴史から始めましょう"}, {"type": "subtitle", "time": 2676.39, "timestamp": "00:44:36", "text": "ページ。これを文字通り複製します"}, {"type": "subtitle", "time": 2679.67, "timestamp": "00:44:39", "text": "現状のままのそのページをそのまま載せる"}, {"type": "subtitle", "time": 2682.47, "timestamp": "00:44:42", "text": "歴史の件ですね。そうですね。えっと、もしあなたが"}, {"type": "subtitle", "time": 2684.309, "timestamp": "00:44:44", "text": "ジョックに何を聞くのか"}, {"type": "subtitle", "time": 2686.23, "timestamp": "00:44:46", "text": "歴史とはどういう意味ですか？私たちは文字通り行く"}, {"type": "subtitle", "time": 2691.43, "timestamp": "00:44:51", "text": "ウィキからこの部分を挿入します"}, {"type": "subtitle", "time": 2694.71, "timestamp": "00:44:54", "text": "こちらのこの歴史セクションは"}, {"type": "subtitle", "time": 2697.51, "timestamp": "00:44:57", "text": "私の背景は何ですか？"}, {"type": "subtitle", "time": 2699.829, "timestamp": "00:44:59", "text": "それらすべて"}]
[{"type": "subtitle", "time": 19920.948, "timestamp": "05:32:00", "text": "そっちの方がいい"}, {"type": "chat", "time": 19923.629, "timestamp": "05:32:03", "author": "@PanditJi.Y", "avatar": "https://yt4.ggpht.com/dbuBEqO3mJ9DX4Uu_LhA4jdzC_POgn5GfeMyztO06j5c73okFxwnXUaKWurMIj0mYXB_y53S_Q=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}, {"type": "subtitle", "time": 19924.708, "timestamp": "05:32:04", "text": "はい、Onexiaサイトについてですが"}, {"type": "subtitle", "time": 19926.868, "timestamp": "05:32:06", "text": "種の"}, {"type": "subtitle", "time": 19929.91, "timestamp": "05:32:09", "text": "えっと、アーカイブしました"}, {"type": "subtitle", "time": 19932.23, "timestamp": "05:32:12", "text": "ある意味、アーカイブしておいたようなものだ。私は全てを入れたわけではありません"}, {"type": "subtitle", "time": 19935.27, "timestamp": "05:32:15", "text": "古いページは非表示になっています。だから私は"}, {"type": "subtitle", "time": 19937.75, "timestamp": "05:32:17", "text": "アーカイブしました。表示できるページは"}, {"type": "subtitle", "time": 19942.07, "timestamp": "05:32:22", "text": "これらは異なる言語です。それでおしまい。"}, {"type": "subtitle", "time": 19945.11, "timestamp": "05:32:25", "text": "だから私は「うん、そうかもね」って感じ。うん、それは"}, {"type": "chat", "time": 19952.746, "timestamp": "05:32:32", "author": "@PanditJi.Y", "avatar": "https://yt4.ggpht.com/dbuBEqO3mJ9DX4Uu_LhA4jdzC_POgn5GfeMyztO06j5c73okFxwnXUaKWurMIj0mYXB_y53S_Q=s64-c-k-c0x00ffffff-no-rj", "message": "Have it all lead it to 1 place"}, {"type": "subtitle", "time": 19954.788, "timestamp": "05:32:34", "text": "探検する。ああ、これは彼らのアイデアだ"}, {"type": "subtitle", "time": 19961.19, "timestamp": "05:32:41", "text": "こちらのリンクをクリックしてください。このリンクとこの物"}, {"type": "subtitle", "time": 19963.19, "timestamp": "05:32:43", "text": "必ず一つの場所にたどり着く。うん、そうするよ"}, {"type": "subtitle", "time": 19969.59, "timestamp": "05:32:49", "text": "超集中力を維持したいなら、"}, {"type": "subtitle", "time": 19972.23, "timestamp": "05:32:52", "text": "また、次のように言うこともできます。"}, {"type": "subtitle", "time": 19974.948, "timestamp": "05:32:54", "text": "わかった"}, {"type": "subtitle", "time": 19978.23, "timestamp": "05:32:58", "text": "側柱。わかった、"}]
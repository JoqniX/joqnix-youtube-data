[{"type": "subtitle", "time": 1141.669, "timestamp": "00:19:01", "text": "ええ、大丈夫だと思います。"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "えっと、ちゃんと説明する必要があると思うんだけど"}, {"type": "subtitle", "time": 1148.39, "timestamp": "00:19:08", "text": "推測ですが、今のところは大丈夫です。"}, {"type": "subtitle", "time": 1149.909, "timestamp": "00:19:09", "text": "うん"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "ボタン関連の作業は完了したので、次に"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "この男にオーバーレイジャマをやれ。どうやって"}, {"type": "subtitle", "time": 1159.59, "timestamp": "00:19:19", "text": "私たちの会話オーバーレイはこんな感じですよね？それで"}, {"type": "subtitle", "time": 1162.95, "timestamp": "00:19:22", "text": "えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 1166.39, "timestamp": "00:19:26", "text": "また。メニューV4。"}, {"type": "subtitle", "time": 1170.63, "timestamp": "00:19:30", "text": "メニューV4トリガーボタン。右。 V4。わかった。"}, {"type": "subtitle", "time": 1172.549, "timestamp": "00:19:32", "text": "だから、私たちも同じことをするつもりです。"}, {"type": "subtitle", "time": 1178.15, "timestamp": "00:19:38", "text": "トークンに変換します。メニューV4として設定してください。"}, {"type": "subtitle", "time": 1183.029, "timestamp": "00:19:43", "text": "えっと"}, {"type": "subtitle", "time": 1194.63, "timestamp": "00:19:54", "text": "かぶせる。かぶせる"}, {"type": "subtitle", "time": 1196.87, "timestamp": "00:19:56", "text": "オーバーレイ用のメニュー。それは良いことだ"}]
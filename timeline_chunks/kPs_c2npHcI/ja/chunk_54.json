[{"type": "subtitle", "time": 3240.87, "timestamp": "00:54:00", "text": "線形グラデーションのようにして、"}, {"type": "subtitle", "time": 3244.39, "timestamp": "00:54:04", "text": "それなど。そうですね。"}, {"type": "subtitle", "time": 3247.109, "timestamp": "00:54:07", "text": "彼がどうやってそれを成し遂げたのか、すべてを学ぶことができる。"}, {"type": "subtitle", "time": 3252.79, "timestamp": "00:54:12", "text": "こんにちは。さて、本題に戻りましょう。えっと、"}, {"type": "subtitle", "time": 3256.15, "timestamp": "00:54:16", "text": "気が散っている。わかった。えーと、終わらせなきゃ"}, {"type": "subtitle", "time": 3258.79, "timestamp": "00:54:18", "text": "いくつかありますよね？私は"}, {"type": "subtitle", "time": 3261.19, "timestamp": "00:54:21", "text": "重要な日付。"}, {"type": "subtitle", "time": 3264.71, "timestamp": "00:54:24", "text": "ウィキペディアで確認してみると。"}, {"type": "subtitle", "time": 3266.87, "timestamp": "00:54:26", "text": "ええと、私たちはカバーしました"}, {"type": "subtitle", "time": 3269.589, "timestamp": "00:54:29", "text": "私たちは現在トリビアをしています"}, {"type": "subtitle", "time": 3272.79, "timestamp": "00:54:32", "text": "部分。名前は私たちが決めたんだと思う。おお、"}, {"type": "subtitle", "time": 3277.27, "timestamp": "00:54:37", "text": "待って。名前を正しく入力していませんでした。"}, {"type": "subtitle", "time": 3280.309, "timestamp": "00:54:40", "text": "いや、待って。トリビア。雑学って"}, {"type": "subtitle", "time": 3283.19, "timestamp": "00:54:43", "text": "情報部分に記載できます"}, {"type": "subtitle", "time": 3285.27, "timestamp": "00:54:45", "text": "それ？"}, {"type": "subtitle", "time": 3289.109, "timestamp": "00:54:49", "text": "わからない。 H どこに置けばいいですか"}, {"type": "subtitle", "time": 3292.71, "timestamp": "00:54:52", "text": "これら？私はクイズ大会から参加しました。私は"}, {"type": "subtitle", "time": 3296.069, "timestamp": "00:54:56", "text": "好き嫌い、キャッチフレーズ、"}, {"type": "subtitle", "time": 3297.75, "timestamp": "00:54:57", "text": "自己顕示欲。"}]
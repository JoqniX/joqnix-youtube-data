[{"type": "subtitle", "time": 1743.99, "timestamp": "00:29:03", "text": "えっと、"}, {"type": "subtitle", "time": 1746.789, "timestamp": "00:29:06", "text": "メニューはどうですか？はい、ボタン"}, {"type": "subtitle", "time": 1752.389, "timestamp": "00:29:12", "text": "ここに置いてください。ああ、私は身分証明書を持っていません"}, {"type": "subtitle", "time": 1755.029, "timestamp": "00:29:15", "text": "ここ。えっと、どうすればいいんですか？私の出来はどうでしたか？"}, {"type": "subtitle", "time": 1756.63, "timestamp": "00:29:16", "text": "それ？"}, {"type": "subtitle", "time": 1764.87, "timestamp": "00:29:24", "text": "もし私にどうするかと聞かれたら"}, {"type": "subtitle", "time": 1767.11, "timestamp": "00:29:27", "text": "ナグベーションの件については、私は"}, {"type": "subtitle", "time": 1769.35, "timestamp": "00:29:29", "text": "知る。"}, {"type": "subtitle", "time": 1775.43, "timestamp": "00:29:35", "text": "また、このトリガーを閉じる必要はありません"}, {"type": "subtitle", "time": 1778.789, "timestamp": "00:29:38", "text": "ボタン男。"}, {"type": "subtitle", "time": 1789.35, "timestamp": "00:29:49", "text": "えっと、こいつらが何者かは知らないけど。"}, {"type": "subtitle", "time": 1791.83, "timestamp": "00:29:51", "text": "これらはナビゲーション項目です。"}, {"type": "subtitle", "time": 1799.99, "timestamp": "00:29:59", "text": "えっと"}]
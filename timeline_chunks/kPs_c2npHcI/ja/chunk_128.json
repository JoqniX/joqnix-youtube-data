[{"type": "subtitle", "time": 7683.83, "timestamp": "02:08:03", "text": "歴史は、おそらく価値を持つでしょう。いやいや待って"}, {"type": "subtitle", "time": 7697.43, "timestamp": "02:08:17", "text": "うん、文字の価値は良いだろう、なぜなら"}, {"type": "subtitle", "time": 7700.87, "timestamp": "02:08:20", "text": "段落を始めましょう。"}, {"type": "subtitle", "time": 7708.709, "timestamp": "02:08:28", "text": "えーと値"}, {"type": "subtitle", "time": 7712.229, "timestamp": "02:08:32", "text": "価値。わかった。これをローカルに変換します"}, {"type": "subtitle", "time": 7713.75, "timestamp": "02:08:33", "text": "もの"}, {"type": "subtitle", "time": 7716.95, "timestamp": "02:08:36", "text": "履歴データ値。"}, {"type": "subtitle", "time": 7722.55, "timestamp": "02:08:42", "text": "では、この話のためにこれを載せます"}, {"type": "subtitle", "time": 7726.149, "timestamp": "02:08:46", "text": "彼ら全員"}, {"type": "subtitle", "time": 7730.229, "timestamp": "02:08:50", "text": "履歴データ値"}, {"type": "subtitle", "time": 7733.669, "timestamp": "02:08:53", "text": "そしてこの男は"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "トークンに変換します。この男はミスターになるでしょう。"}, {"type": "subtitle", "time": 7739.91, "timestamp": "02:08:59", "text": "彼の"}]
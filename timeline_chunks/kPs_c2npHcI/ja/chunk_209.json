[{"type": "subtitle", "time": 12545.83, "timestamp": "03:29:05", "text": "ジョーン、"}, {"type": "subtitle", "time": 12560.389, "timestamp": "03:29:20", "text": "ここに「成長」と書くべきでしょうか？"}, {"type": "subtitle", "time": 12564.229, "timestamp": "03:29:24", "text": "そして文字列をゼロとして扱う？"}, {"type": "subtitle", "time": 12571.32, "timestamp": "03:29:31", "text": "えっと、"}, {"type": "subtitle", "time": 12580.55, "timestamp": "03:29:40", "text": "どちらが良いか、どうすればわかるでしょうか？そう思いますか？"}, {"type": "subtitle", "time": 12585.59, "timestamp": "03:29:45", "text": "ああ、神様。どちらが良いのか分かりません。"}, {"type": "subtitle", "time": 12593.349, "timestamp": "03:29:53", "text": "こうして、あるいはその後"}, {"type": "subtitle", "time": 12595.83, "timestamp": "03:29:55", "text": "文末に「I can」を置く"}]
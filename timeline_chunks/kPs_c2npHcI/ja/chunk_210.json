[{"type": "subtitle", "time": 12622.469, "timestamp": "03:30:22", "text": "うん。どちらが良いですか？これです"}, {"type": "subtitle", "time": 12626.71, "timestamp": "03:30:26", "text": "それともこちら？外に置いて、"}, {"type": "subtitle", "time": 12630.55, "timestamp": "03:30:30", "text": "これとこれ、どっちを入れる？そういう気分だ"}, {"type": "subtitle", "time": 12633.67, "timestamp": "03:30:33", "text": "読みにくくなるだろう。いいえ、"}, {"type": "subtitle", "time": 12635.99, "timestamp": "03:30:35", "text": "読み方"}, {"type": "subtitle", "time": 12643.349, "timestamp": "03:30:43", "text": "えっと、あと、自慢として作らないといけないんだけど、"}, {"type": "subtitle", "time": 12651.67, "timestamp": "03:30:51", "text": "いや。ああ、いやだ。必要ない。わかった。えっと"}]
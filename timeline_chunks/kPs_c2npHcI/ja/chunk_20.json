[{"type": "subtitle", "time": 1204.31, "timestamp": "00:20:04", "text": "十分。ここへ行ってください。ここに置いてください。メニューV4"}, {"type": "subtitle", "time": 1206.15, "timestamp": "00:20:06", "text": "かぶせる。"}, {"type": "subtitle", "time": 1208.07, "timestamp": "00:20:08", "text": "うん。"}, {"type": "subtitle", "time": 1213.51, "timestamp": "00:20:13", "text": "ええと、ここに行って、"}, {"type": "subtitle", "time": 1221.27, "timestamp": "00:20:21", "text": "えっと、待って、これで合ってたかな？"}, {"type": "subtitle", "time": 1224.63, "timestamp": "00:20:24", "text": "疑問符。はい、やったと思います。"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "でも待てよ、古いバージョンも結構好きなんだ。"}, {"type": "subtitle", "time": 1229.669, "timestamp": "00:20:29", "text": "ウィンク。"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "えっと、なんでウインクしちゃったんだろう？"}, {"type": "subtitle", "time": 1237.51, "timestamp": "00:20:37", "text": "ああ、わかった。これは、えーと"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "えーと。わかった。わかった。分かりやすい内容です。"}, {"type": "subtitle", "time": 1248.95, "timestamp": "00:20:48", "text": "もし私が望まなかったら、もし私が望んだら"}, {"type": "subtitle", "time": 1255.59, "timestamp": "00:20:55", "text": "透明性を確保します。わかった。全て"}, {"type": "subtitle", "time": 1258.23, "timestamp": "00:20:58", "text": "右。次にコンテンツシートです"}, {"type": "subtitle", "time": 1259.83, "timestamp": "00:20:59", "text": "コンテンツ。"}]
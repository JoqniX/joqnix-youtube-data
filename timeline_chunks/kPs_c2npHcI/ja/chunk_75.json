[{"type": "subtitle", "time": 4500.87, "timestamp": "01:15:00", "text": "ストリームはここに表示されます。"}, {"type": "subtitle", "time": 4504.47, "timestamp": "01:15:04", "text": "これは何ですか？フランス語、ドイツ語。私はしません"}, {"type": "subtitle", "time": 4508.149, "timestamp": "01:15:08", "text": "知る。オネクシア。そうそう。"}, {"type": "subtitle", "time": 4509.94, "timestamp": "01:15:09", "text": "Onexia.com"}, {"type": "subtitle", "time": 4511.51, "timestamp": "01:15:11", "text": "[音楽]"}, {"type": "subtitle", "time": 4515.59, "timestamp": "01:15:15", "text": "H. ここに表示されます。主に私は"}, {"type": "subtitle", "time": 4519.189, "timestamp": "01:15:19", "text": "これも変更する。オネシアナ。"}, {"type": "subtitle", "time": 4522.47, "timestamp": "01:15:22", "text": "オネクシア。ジョー。ええ、変えなきゃいけませんね"}, {"type": "subtitle", "time": 4524.95, "timestamp": "01:15:24", "text": "これ。"}, {"type": "subtitle", "time": 4527.35, "timestamp": "01:15:27", "text": "なぜ壊れているのですか？"}, {"type": "subtitle", "time": 4530.95, "timestamp": "01:15:30", "text": "なぜあなたは壊れているのですか？ O."}, {"type": "subtitle", "time": 4534.149, "timestamp": "01:15:34", "text": "それも直さなければならない。"}, {"type": "subtitle", "time": 4537.75, "timestamp": "01:15:37", "text": "ああ、とにかく、歴史の話だ。ええと、私たちは"}, {"type": "subtitle", "time": 4540.95, "timestamp": "01:15:40", "text": "履歴ページ。えっと、もう一度「約」のところへ行ってください。"}, {"type": "subtitle", "time": 4544.39, "timestamp": "01:15:44", "text": "私たちがすることは、全体をコピーすることです"}, {"type": "subtitle", "time": 4547.43, "timestamp": "01:15:47", "text": "ここから先は。"}, {"type": "subtitle", "time": 4553.51, "timestamp": "01:15:53", "text": "[音楽]"}, {"type": "subtitle", "time": 4555.99, "timestamp": "01:15:55", "text": "うん。全体をコピーしてください。行く"}, {"type": "subtitle", "time": 4558.149, "timestamp": "01:15:58", "text": "歴史。"}]
[{"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "抵抗する。でも大丈夫。私はそうするだろう、私はできる"}, {"type": "subtitle", "time": 11886.87, "timestamp": "03:18:06", "text": "これをアップグレードすべきだと思います。"}, {"type": "subtitle", "time": 11889.229, "timestamp": "03:18:09", "text": "待って、宝石はどこ？えーと、1つ"}, {"type": "subtitle", "time": 11893.429, "timestamp": "03:18:13", "text": "もっと。私はスコップを持っていません。えっと、これは"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "スペードならできるよね？これだよ。私"}, {"type": "subtitle", "time": 11898.83, "timestamp": "03:18:18", "text": "私の神のためにそれを持っていない"}, {"type": "subtitle", "time": 11902.75, "timestamp": "03:18:22", "text": "弓。これもそうだ。両方とも必要としている"}, {"type": "subtitle", "time": 11905.99, "timestamp": "03:18:25", "text": "スペード。私はこのためにそれを使いました。ああ、私は"}, {"type": "subtitle", "time": 11908.389, "timestamp": "03:18:28", "text": "これを使ってきました。あ、待って。その"}, {"type": "subtitle", "time": 11909.469, "timestamp": "03:18:29", "text": "大丈夫。その"}, {"type": "subtitle", "time": 11912.95, "timestamp": "03:18:32", "text": "大丈夫。私はこれを使っています。クローバー"}, {"type": "subtitle", "time": 11915.349, "timestamp": "03:18:35", "text": "1つ。"}, {"type": "subtitle", "time": 11922.27, "timestamp": "03:18:42", "text": "抵抗する。そして"}, {"type": "subtitle", "time": 11924.99, "timestamp": "03:18:44", "text": "[音楽]"}, {"type": "subtitle", "time": 11927.429, "timestamp": "03:18:47", "text": "ええ、あなたは気分を害したと思っていました"}, {"type": "subtitle", "time": 11930.469, "timestamp": "03:18:50", "text": "カオス。それは本当だ。"}, {"type": "subtitle", "time": 11932.95, "timestamp": "03:18:52", "text": "闇の魔法。ああ、どうやらあるらしい"}, {"type": "subtitle", "time": 11935.229, "timestamp": "03:18:55", "text": "別のタイプの"}, {"type": "subtitle", "time": 11938.19, "timestamp": "03:18:58", "text": "ダークなハイレベルエンドゲーム"}]
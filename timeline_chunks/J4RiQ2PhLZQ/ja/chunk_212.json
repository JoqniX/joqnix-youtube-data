[{"type": "subtitle", "time": 12720.19, "timestamp": "03:32:00", "text": "待って。"}, {"type": "subtitle", "time": 12723.75, "timestamp": "03:32:03", "text": "えっと、CPを獲得するために私がやったことは"}, {"type": "subtitle", "time": 12727.63, "timestamp": "03:32:07", "text": "レベル35で詰まってしまいました。私がやったことは…"}, {"type": "subtitle", "time": 12732.15, "timestamp": "03:32:12", "text": "レベルアップしたか、実績を達成したか"}, {"type": "subtitle", "time": 12735.269, "timestamp": "03:32:15", "text": "実際、私は多くの成果を上げ、"}, {"type": "subtitle", "time": 12736.51, "timestamp": "03:32:16", "text": "コレクション"}, {"type": "subtitle", "time": 12739.469, "timestamp": "03:32:19", "text": "武器を手に入れたり、"}, {"type": "subtitle", "time": 12742.229, "timestamp": "03:32:22", "text": "物など"}, {"type": "subtitle", "time": 12744.79, "timestamp": "03:32:24", "text": "実際、主にレコーディングを担当しました。私はそうしました"}, {"type": "subtitle", "time": 12747.11, "timestamp": "03:32:27", "text": "記録。特定のものを栽培できます"}, {"type": "subtitle", "time": 12751.03, "timestamp": "03:32:31", "text": "ボスの種類は、たくさん獲得するまで"}, {"type": "subtitle", "time": 12756.15, "timestamp": "03:32:36", "text": "星は、ある地域では、"}, {"type": "subtitle", "time": 12759.03, "timestamp": "03:32:39", "text": "私がイースト・ハードランズのためにやったことと同じように。あなた"}, {"type": "subtitle", "time": 12761.83, "timestamp": "03:32:41", "text": "同じ敵を倒すことで6つ星を獲得できます"}, {"type": "subtitle", "time": 12764.51, "timestamp": "03:32:44", "text": "ボスと魂を手に入れる"}, {"type": "subtitle", "time": 12768.15, "timestamp": "03:32:48", "text": "石。そうやってCPを獲得できます。えっと"}, {"type": "subtitle", "time": 12770.03, "timestamp": "03:32:50", "text": "行う"}, {"type": "subtitle", "time": 12772.63, "timestamp": "03:32:52", "text": "タイトル、タイトルを付けるなど、"}, {"type": "subtitle", "time": 12773.87, "timestamp": "03:32:53", "text": "得る"}, {"type": "subtitle", "time": 12777.67, "timestamp": "03:32:57", "text": "CP も宝箱を見つける"}]
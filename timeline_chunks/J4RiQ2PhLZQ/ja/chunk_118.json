[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "戻る。ああ、なんてこった。ああ、私は"}, {"type": "subtitle", "time": 7082.99, "timestamp": "01:58:02", "text": "急いでやらなきゃ"}, {"type": "subtitle", "time": 7087.51, "timestamp": "01:58:07", "text": "生存者。でも、ええ、それで、私たちは"}, {"type": "subtitle", "time": 7089.39, "timestamp": "01:58:09", "text": "トウモロコシ"}, {"type": "subtitle", "time": 7093.27, "timestamp": "01:58:13", "text": "クエスト。ああ、2つの解決策は、ええと、"}, {"type": "subtitle", "time": 7096.75, "timestamp": "01:58:16", "text": "クエストは完了しました。良い。それは"}, {"type": "subtitle", "time": 7099.589, "timestamp": "01:58:19", "text": "良い。彼らにあげよう、私が持っておこう"}, {"type": "subtitle", "time": 7102.189, "timestamp": "01:58:22", "text": "背景に。"}, {"type": "subtitle", "time": 7105.669, "timestamp": "01:58:25", "text": "だから、私たちができることの一つは、"}, {"type": "subtitle", "time": 7108.629, "timestamp": "01:58:28", "text": "エイペックスモバイル。プレイしても問題ありません。そして私は"}, {"type": "subtitle", "time": 7112.229, "timestamp": "01:58:32", "text": "タイトルを変更します。実際、私は"}, {"type": "subtitle", "time": 7115.07, "timestamp": "01:58:35", "text": "急いで行って変えて"}, {"type": "subtitle", "time": 7117.629, "timestamp": "01:58:37", "text": "タイトル。"}, {"type": "subtitle", "time": 7122.669, "timestamp": "01:58:42", "text": "えっと、でもそれはストリームではありません。知っている。"}, {"type": "subtitle", "time": 7124.27, "timestamp": "01:58:44", "text": "しかし"}, {"type": "subtitle", "time": 7128.07, "timestamp": "01:58:48", "text": "でも、実はよくわからないんです。 AFKすべきでしょうか？"}, {"type": "subtitle", "time": 7130.109, "timestamp": "01:58:50", "text": "このような？チャットでどう思いますか？"}, {"type": "subtitle", "time": 7132.669, "timestamp": "01:58:52", "text": "けれど？君たちは何"}, {"type": "subtitle", "time": 7135.75, "timestamp": "01:58:55", "text": "考える？こんな風に放置するべきか、それとも"}]
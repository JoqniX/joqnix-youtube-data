[{"type": "subtitle", "time": 841.189, "timestamp": "00:14:01", "text": "それを落とす原因はそこにある。それを得る。それを得る"}, {"type": "subtitle", "time": 842.829, "timestamp": "00:14:02", "text": "下へ"}, {"type": "subtitle", "time": 846.069, "timestamp": "00:14:06", "text": "それ。あなたが"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "終わり。ちょっと眠い。上部"}, {"type": "subtitle", "time": 853.4, "timestamp": "00:14:13", "text": "角が下がっている。ええ、私のももうすぐ終わります。"}, {"type": "subtitle", "time": 856.43, "timestamp": "00:14:16", "text": "[音楽]"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "やったー。私は自分で作ろうと試みます"}, {"type": "subtitle", "time": 861.79, "timestamp": "00:14:21", "text": "心臓"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "弓。うん、やってみるよ。たとえそうでなくても"}, {"type": "subtitle", "time": 875.35, "timestamp": "00:14:35", "text": "でも、これはちょっとクールだね。のように"}, {"type": "subtitle", "time": 879.87, "timestamp": "00:14:39", "text": "ペーパークラフト。私は決して好きではない"}, {"type": "subtitle", "time": 883.59, "timestamp": "00:14:43", "text": "このように熱心に努力を注ぎましたが、"}, {"type": "subtitle", "time": 890.23, "timestamp": "00:14:50", "text": "それで、スケッチのようなものを買ったので"}, {"type": "subtitle", "time": 894.269, "timestamp": "00:14:54", "text": "パッドとか色々、本当にやらなきゃ"}, {"type": "subtitle", "time": 898.59, "timestamp": "00:14:58", "text": "むしろこういうシムのようなものですね、"}]
[{"type": "subtitle", "time": 12425.51, "timestamp": "03:27:05", "text": "ええと、ダイヤモンドは絶対に使わないでください"}, {"type": "subtitle", "time": 12428.309, "timestamp": "03:27:08", "text": "在庫に空きを作るため。作る"}, {"type": "subtitle", "time": 12430.11, "timestamp": "03:27:10", "text": "サブ"}, {"type": "subtitle", "time": 12433.269, "timestamp": "03:27:13", "text": "キャラクター。サブキャラクターを作成する。レベル"}, {"type": "subtitle", "time": 12436.95, "timestamp": "03:27:16", "text": "レベル20まで上げると、ロックを解除できます"}, {"type": "subtitle", "time": 12440.95, "timestamp": "03:27:20", "text": "クラスアップグレード。そうしてください。わかった。しないでください"}, {"type": "subtitle", "time": 12443.99, "timestamp": "03:27:23", "text": "ダイヤモンドを使ったことがあるか。それは悪いバカだ"}, {"type": "subtitle", "time": 12447.67, "timestamp": "03:27:27", "text": "このゲームでできる最も愚かな行動。"}, {"type": "subtitle", "time": 12452.03, "timestamp": "03:27:32", "text": "ええ、必ず"}, {"type": "subtitle", "time": 12455.99, "timestamp": "03:27:35", "text": "えっと、すべてのアカウントでプレイしてください。わかった、"}, {"type": "subtitle", "time": 12461.11, "timestamp": "03:27:41", "text": "オルタネートサブでプレイしたけど、全部が神じゃない"}, {"type": "subtitle", "time": 12464.469, "timestamp": "03:27:44", "text": "私は何を言っているんだ？すべてのキャラクター"}, {"type": "subtitle", "time": 12466.87, "timestamp": "03:27:46", "text": "その他のクラス"}, {"type": "subtitle", "time": 12469.67, "timestamp": "03:27:49", "text": "サブキャラクター。はい、レベルアップさせるだけです"}, {"type": "subtitle", "time": 12472.229, "timestamp": "03:27:52", "text": "レベル20まで。ただ、スキップすることもできます。"}, {"type": "subtitle", "time": 12474.55, "timestamp": "03:27:54", "text": "セリフとかそういうやつ。ほんの少しの時間で"}, {"type": "subtitle", "time": 12478.95, "timestamp": "03:27:58", "text": "キャラクター1人をレベル20にするのに1時間"}]
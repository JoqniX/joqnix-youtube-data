[{"type": "subtitle", "time": 963.67, "timestamp": "00:16:03", "text": "仕事です。弟が来ます。もっと"}, {"type": "subtitle", "time": 966.4, "timestamp": "00:16:06", "text": "再会する機会。"}, {"type": "subtitle", "time": 984.389, "timestamp": "00:16:24", "text": "これ？何"}, {"type": "subtitle", "time": 988.47, "timestamp": "00:16:28", "text": "内部？内側の両角を太字にする。"}, {"type": "subtitle", "time": 995.269, "timestamp": "00:16:35", "text": "これ。わかった。もうすぐ終わります。私は"}, {"type": "subtitle", "time": 998.629, "timestamp": "00:16:38", "text": "もうすぐ終わるから嬉しい。もうない"}, {"type": "subtitle", "time": 1006.25, "timestamp": "00:16:46", "text": "ジョークは常に苦痛を伴う。"}, {"type": "subtitle", "time": 1007.99, "timestamp": "00:16:47", "text": "[音楽]"}, {"type": "subtitle", "time": 1010.55, "timestamp": "00:16:50", "text": "はい、わかりました。 H. それは"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "簡単。ああ、それほど簡単だったんだ。おお。ああ、それは"}, {"type": "subtitle", "time": 1015.91, "timestamp": "00:16:55", "text": "熱くなってくる。わかった。わかった。わかった。"}]
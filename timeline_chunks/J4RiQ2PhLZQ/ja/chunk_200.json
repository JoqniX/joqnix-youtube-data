[{"type": "subtitle", "time": 12004.95, "timestamp": "03:20:04", "text": "入力。卵を守らなければならない。 A"}, {"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "こういう場所には、馴染みのある巣がある。私"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "それを推奨します。それはもうすぐ起こる。"}, {"type": "subtitle", "time": 12015.51, "timestamp": "03:20:15", "text": "これを自動モードにして待つだけで"}, {"type": "subtitle", "time": 12017.349, "timestamp": "03:20:17", "text": "時計。"}, {"type": "subtitle", "time": 12020.15, "timestamp": "03:20:20", "text": "ほとんどの場合、私たちは回避行動を取る必要がある。私たちは"}, {"type": "subtitle", "time": 12026.87, "timestamp": "03:20:26", "text": "回避して態勢を立て直す。私たちは望んでいません"}, {"type": "subtitle", "time": 12041.03, "timestamp": "03:20:41", "text": "痛み。でも卵はね。ああ、卵だ。私"}, {"type": "subtitle", "time": 12042.429, "timestamp": "03:20:42", "text": "高くする必要がある"}, {"type": "subtitle", "time": 12047.15, "timestamp": "03:20:47", "text": "彼を倒すには、キャラクターのパワーレベルを上げる必要がある。"}, {"type": "subtitle", "time": 12050.429, "timestamp": "03:20:50", "text": "なぜ？私を攻撃してください。ではない"}, {"type": "subtitle", "time": 12052.75, "timestamp": "03:20:52", "text": "卵。"}]
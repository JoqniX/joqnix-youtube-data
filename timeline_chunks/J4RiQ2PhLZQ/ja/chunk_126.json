[{"type": "subtitle", "time": 7562.55, "timestamp": "02:06:02", "text": "ジョー王国はどうですか？調子はどうですか"}, {"type": "subtitle", "time": 7564.87, "timestamp": "02:06:04", "text": "王国が何をしているか？ディアブロの調子はどうですか？えっと"}, {"type": "subtitle", "time": 7567.35, "timestamp": "02:06:07", "text": "ディアブロは今日まで触ってないよね"}, {"type": "subtitle", "time": 7571.31, "timestamp": "02:06:11", "text": "今。最後のストリーム以来"}, {"type": "subtitle", "time": 7572.91, "timestamp": "02:06:12", "text": "ディアブロ。"}, {"type": "subtitle", "time": 7575.75, "timestamp": "02:06:15", "text": "そして王国は順調に発展している。実は、"}, {"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "王国防衛をする必要がある"}, {"type": "subtitle", "time": 7582.39, "timestamp": "02:06:22", "text": "そして間もなく、みんなで王国のダンジョンへ"}, {"type": "subtitle", "time": 7585.589, "timestamp": "02:06:25", "text": "利用可能な人。前回と同じようにソロでやるよ"}, {"type": "subtitle", "time": 7589.43, "timestamp": "02:06:29", "text": "オートフィル機能使用時の時間。"}, {"type": "subtitle", "time": 7596.069, "timestamp": "02:06:36", "text": "うん、背景はそのままにしておこう"}, {"type": "subtitle", "time": 7599.87, "timestamp": "02:06:39", "text": "そして、ロボットの世話も忘れずに"}, {"type": "subtitle", "time": 7603.91, "timestamp": "02:06:43", "text": "ジャクソン・パカ・ナイトボット。待って、ぼかしじゃない。"}, {"type": "subtitle", "time": 7606.91, "timestamp": "02:06:46", "text": "なぜぼかしたのか？ああ、待って"}, {"type": "subtitle", "time": 7609.95, "timestamp": "02:06:49", "text": "待って。私が何をしているかって？私は何者ですか？"}]
[{"type": "subtitle", "time": 2400.75, "timestamp": "00:40:00", "text": "わかった。それでは、おやすみなさい。良い一日を。"}, {"type": "subtitle", "time": 2404.31, "timestamp": "00:40:04", "text": "1つ。バイバイ。どうすればいいですか？どうすればいいですか？"}, {"type": "subtitle", "time": 2409.79, "timestamp": "00:40:09", "text": "いいえ。"}, {"type": "subtitle", "time": 2414.0, "timestamp": "00:40:14", "text": "バイバイ。待って、どうすればいいの？"}, {"type": "subtitle", "time": 2425.87, "timestamp": "00:40:25", "text": "日。バイバイ。良い"}, {"type": "subtitle", "time": 2428.95, "timestamp": "00:40:28", "text": "おやすみなさい。今日は皆さんありがとうございました。あなた"}, {"type": "subtitle", "time": 2430.87, "timestamp": "00:40:30", "text": "ストリームを終了したときは、"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "この手を振る動作"}, {"type": "subtitle", "time": 2436.31, "timestamp": "00:40:36", "text": "えっと、どういうわけか、まるで私が手を振っているかのように"}]
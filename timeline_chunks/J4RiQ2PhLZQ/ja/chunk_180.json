[{"type": "subtitle", "time": 10802.389, "timestamp": "03:00:02", "text": "医師に診てもらって、"}, {"type": "subtitle", "time": 10804.87, "timestamp": "03:00:04", "text": "私の偏頭痛と私の"}, {"type": "subtitle", "time": 10809.429, "timestamp": "03:00:09", "text": "音、感度音のようなもの"}, {"type": "subtitle", "time": 10811.19, "timestamp": "03:00:11", "text": "音のものが"}, {"type": "subtitle", "time": 10813.99, "timestamp": "03:00:13", "text": "今でも着ているから私に影響を与える"}, {"type": "subtitle", "time": 10816.429, "timestamp": "03:00:16", "text": "ヘッドホンのせいで偏頭痛がする"}, {"type": "subtitle", "time": 10819.99, "timestamp": "03:00:19", "text": "頭痛がするけど、影響は出したくない"}, {"type": "subtitle", "time": 10823.51, "timestamp": "03:00:23", "text": "私の音楽制作関連のユーザープロダクション"}, {"type": "subtitle", "time": 10826.389, "timestamp": "03:00:26", "text": "大切なことだから。私はしません"}, {"type": "subtitle", "time": 10829.75, "timestamp": "03:00:29", "text": "死にたい。私は制限されたくない"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "そのためです。ええ、そうですね。それで、彼女は"}, {"type": "subtitle", "time": 10837.63, "timestamp": "03:00:37", "text": "1ヶ月分の点眼薬を処方されました。"}, {"type": "subtitle", "time": 10840.83, "timestamp": "03:00:40", "text": "点眼薬を1つ使用する"}, {"type": "subtitle", "time": 10843.95, "timestamp": "03:00:43", "text": "月。ええ、目薬は2つです。"}, {"type": "subtitle", "time": 10847.59, "timestamp": "03:00:47", "text": "ええと、1日に4回です。 1つは4つです"}, {"type": "subtitle", "time": 10850.23, "timestamp": "03:00:50", "text": "1日に1回、そしてもう1回は2回"}, {"type": "subtitle", "time": 10852.23, "timestamp": "03:00:52", "text": "1日。"}, {"type": "subtitle", "time": 10856.67, "timestamp": "03:00:56", "text": "スキルレベルアップ。ええと、わかりました。レベル"}]
[{"type": "subtitle", "time": 2162.79, "timestamp": "00:36:02", "text": "音楽。それで、えーと、私は、それは、えーと、"}, {"type": "subtitle", "time": 2165.51, "timestamp": "00:36:05", "text": "私自身も、もし私が"}, {"type": "subtitle", "time": 2168.31, "timestamp": "00:36:08", "text": "もし絵を描くとしたら、"}, {"type": "subtitle", "time": 2171.15, "timestamp": "00:36:11", "text": "自分で書いてみよう。私は感じていますか"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "満足しているだろうか、それとも満足していないだろうか"}, {"type": "subtitle", "time": 2176.63, "timestamp": "00:36:16", "text": "満足？そして、もし間違いがあったら、"}, {"type": "subtitle", "time": 2180.87, "timestamp": "00:36:20", "text": "それを改善できる点はありますか？"}, {"type": "subtitle", "time": 2184.31, "timestamp": "00:36:24", "text": "そんな感じのことです。それからメモを取る"}, {"type": "subtitle", "time": 2187.39, "timestamp": "00:36:27", "text": "改善してより良いものにしようと試みる"}, {"type": "subtitle", "time": 2190.71, "timestamp": "00:36:30", "text": "芸術を考慮に入れながら"}, {"type": "subtitle", "time": 2193.43, "timestamp": "00:36:33", "text": "私が改善すべき点。それから"}, {"type": "subtitle", "time": 2195.47, "timestamp": "00:36:35", "text": "評価は私がやります"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "自分自身。でもそれはまるで私たち自身"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "自分自身のことを一番よく知っている"}, {"type": "subtitle", "time": 2207.03, "timestamp": "00:36:47", "text": "そう、私たちは自分たちのことを一番よく知っているから"}, {"type": "subtitle", "time": 2210.069, "timestamp": "00:36:50", "text": "私たちは自分自身に慣れているのだから、それでいいでしょう"}, {"type": "subtitle", "time": 2212.55, "timestamp": "00:36:52", "text": "良い点も悪い点も教えていただければ"}, {"type": "subtitle", "time": 2215.51, "timestamp": "00:36:55", "text": "私たちが犯す間違いと私たちが"}, {"type": "subtitle", "time": 2219.43, "timestamp": "00:36:59", "text": "修正する必要があるなどなど、同じことですよね"}]
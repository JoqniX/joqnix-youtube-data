[{"type": "subtitle", "time": 120.95, "timestamp": "00:02:00", "text": "言葉。作る"}, {"type": "subtitle", "time": 123.59, "timestamp": "00:02:03", "text": "もう一度やってみて。もう一度やってみて。"}, {"type": "subtitle", "time": 127.51, "timestamp": "00:02:07", "text": "えっと、こんな感じですよね？私たちは両方やった"}, {"type": "subtitle", "time": 130.07, "timestamp": "00:02:10", "text": "側面、ですよね？"}, {"type": "subtitle", "time": 133.22899999999998, "timestamp": "00:02:13", "text": "うん。つまり、両方を取るということです。"}, {"type": "subtitle", "time": 134.83, "timestamp": "00:02:14", "text": "側面"}, {"type": "subtitle", "time": 139.19, "timestamp": "00:02:19", "text": "そしてそれらを繋ぎ合わせる。両端と"}, {"type": "subtitle", "time": 140.51, "timestamp": "00:02:20", "text": "接続する"}, {"type": "subtitle", "time": 143.91, "timestamp": "00:02:23", "text": "それ。近づけて置いてください。ええ、そうですね。得る"}, {"type": "subtitle", "time": 147.03, "timestamp": "00:02:27", "text": "真ん中の内側のもの。手を"}, {"type": "subtitle", "time": 149.19, "timestamp": "00:02:29", "text": "何も理解できない。うん。うん。"}, {"type": "subtitle", "time": 152.55, "timestamp": "00:02:32", "text": "えっと、こうやって平らにします。あなたの"}, {"type": "subtitle", "time": 155.43, "timestamp": "00:02:35", "text": "中指はこんな感じです。そしてこれを作る"}, {"type": "subtitle", "time": 168.22899999999998, "timestamp": "00:02:48", "text": "指。うん。うん。うん、君は"}, {"type": "subtitle", "time": 171.35, "timestamp": "00:02:51", "text": "それ。君は理解し始めているね。うん。うん。掴む"}, {"type": "subtitle", "time": 173.55, "timestamp": "00:02:53", "text": "両方を握る"}, {"type": "subtitle", "time": 175.75, "timestamp": "00:02:55", "text": "側面。うん。うん。うん。その通りです。"}, {"type": "subtitle", "time": 178.63, "timestamp": "00:02:58", "text": "それはイエスですね。うん。ええと、接続してください。はい。"}]
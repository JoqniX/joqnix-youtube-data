[{"type": "subtitle", "time": 15360.59, "timestamp": "04:16:00", "text": "くそ？一体どういうことだ？そこには"}, {"type": "subtitle", "time": 15363.469, "timestamp": "04:16:03", "text": "コック。何"}, {"type": "subtitle", "time": 15367.95, "timestamp": "04:16:07", "text": "えっ？一体どういうことだ？ああ、"}, {"type": "subtitle", "time": 15370.63, "timestamp": "04:16:10", "text": "神。通常、コースターを見かけたら、"}, {"type": "subtitle", "time": 15373.59, "timestamp": "04:16:13", "text": "泣き出して逃げ出すだろう。でも、できない"}, {"type": "subtitle", "time": 15382.79, "timestamp": "04:16:22", "text": "それ。私は死にかけている。私は死にかけている。私は死にかけている。"}, {"type": "subtitle", "time": 15383.79, "timestamp": "04:16:23", "text": "私は"}, {"type": "subtitle", "time": 15388.99, "timestamp": "04:16:28", "text": "死にかけている。ええ、待ってください。私は手に入れる必要がある"}, {"type": "subtitle", "time": 15392.309, "timestamp": "04:16:32", "text": "彼が必要だ。"}, {"type": "subtitle", "time": 15401.99, "timestamp": "04:16:41", "text": "あなた？私は本当にあなたのサウンドを聴きます"}, {"type": "subtitle", "time": 15403.469, "timestamp": "04:16:43", "text": "声。"}, {"type": "subtitle", "time": 15412.67, "timestamp": "04:16:52", "text": "はぁ？我々は殺した"}, {"type": "subtitle", "time": 15415.95, "timestamp": "04:16:55", "text": "彼ら。覗き見しているのは誰？私にください"}, {"type": "subtitle", "time": 15418.87, "timestamp": "04:16:58", "text": "MVP。私はMVPを受賞できませんでした。私は"}]
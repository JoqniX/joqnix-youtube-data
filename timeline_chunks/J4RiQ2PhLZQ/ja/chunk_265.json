[{"type": "subtitle", "time": 15914.67, "timestamp": "04:25:14", "text": "[音楽]"}, {"type": "subtitle", "time": 15918.95, "timestamp": "04:25:18", "text": "名前。来て。来て。"}, {"type": "subtitle", "time": 15928.309, "timestamp": "04:25:28", "text": "の上。仕事を与える。騎手に任せる。待って。いいえ。いいえ。"}, {"type": "subtitle", "time": 15929.63, "timestamp": "04:25:29", "text": "ない"}, {"type": "subtitle", "time": 15932.349, "timestamp": "04:25:32", "text": "与える"}, {"type": "subtitle", "time": 15936.269, "timestamp": "04:25:36", "text": "スペア。出来ますか？できた"}, {"type": "subtitle", "time": 15938.11, "timestamp": "04:25:38", "text": "あなた"}, {"type": "subtitle", "time": 15952.91, "timestamp": "04:25:52", "text": "それを見て、"}]
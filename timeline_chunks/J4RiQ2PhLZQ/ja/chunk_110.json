[{"type": "subtitle", "time": 6603.39, "timestamp": "01:50:03", "text": "1つ。そしてプリズムハントをする必要がある、"}, {"type": "subtitle", "time": 6605.87, "timestamp": "01:50:05", "text": "右？えっと"}, {"type": "subtitle", "time": 6617.99, "timestamp": "01:50:17", "text": "私はベストメンバーを選ばないつもりだ。病気"}, {"type": "subtitle", "time": 6627.709, "timestamp": "01:50:27", "text": "[音楽]"}, {"type": "subtitle", "time": 6636.27, "timestamp": "01:50:36", "text": "こんにちは。そして私たちは"}, {"type": "subtitle", "time": 6640.229, "timestamp": "01:50:40", "text": "勝利した。これで130になると思います。"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "良い。そしてあと2つ必要です"}, {"type": "subtitle", "time": 6646.229, "timestamp": "01:50:46", "text": "チケット。だから、あと1人必要だ。これは"}, {"type": "subtitle", "time": 6648.59, "timestamp": "01:50:48", "text": "学年"}, {"type": "subtitle", "time": 6651.709, "timestamp": "01:50:51", "text": "三つ。しかし、私たちはそれを"}, {"type": "subtitle", "time": 6655.709, "timestamp": "01:50:55", "text": "いくつかの。うん。信じる。信頼と"}, {"type": "subtitle", "time": 6658.03, "timestamp": "01:50:58", "text": "信じる。"}]
[{"type": "subtitle", "time": 2762.47, "timestamp": "00:46:02", "text": "少し。それから私は公開するのを忘れた"}, {"type": "subtitle", "time": 2764.87, "timestamp": "00:46:04", "text": "Twitchboard ですが、完了しました。その"}, {"type": "subtitle", "time": 2769.829, "timestamp": "00:46:09", "text": "アップロードしました。それは完全に"}, {"type": "subtitle", "time": 2771.829, "timestamp": "00:46:11", "text": "文字起こしもすべて済ませました。その"}, {"type": "subtitle", "time": 2774.51, "timestamp": "00:46:14", "text": "すべて処理しました。だから私たちは"}, {"type": "subtitle", "time": 2778.19, "timestamp": "00:46:18", "text": "グッチ。もっと柔らかいものはありますか？"}, {"type": "subtitle", "time": 2780.87, "timestamp": "00:46:20", "text": "音楽？どうやらあるようですが、私は"}, {"type": "subtitle", "time": 2782.109, "timestamp": "00:46:22", "text": "しないで"}, {"type": "subtitle", "time": 2785.95, "timestamp": "00:46:25", "text": "知る。私は音楽を選ぶのが苦手です"}, {"type": "subtitle", "time": 2787.71, "timestamp": "00:46:27", "text": "s."}, {"type": "subtitle", "time": 2790.63, "timestamp": "00:46:30", "text": "ええ、あなたは持っているかもしれません"}, {"type": "subtitle", "time": 2792.109, "timestamp": "00:46:32", "text": "気づいた"}, {"type": "subtitle", "time": 2795.589, "timestamp": "00:46:35", "text": "犬よ、なぜ一つの音楽を選んでいるのか"}]
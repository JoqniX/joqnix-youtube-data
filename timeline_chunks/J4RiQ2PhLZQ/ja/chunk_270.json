[{"type": "subtitle", "time": 16201.83, "timestamp": "04:30:01", "text": "帽子。そう、赤い蝶ネクタイがそれを包んでいる。"}, {"type": "subtitle", "time": 16204.269, "timestamp": "04:30:04", "text": "首元がすごく可愛い。"}, {"type": "subtitle", "time": 16212.95, "timestamp": "04:30:12", "text": "かわいい。彼を見て。なんて可愛いんでしょう"}, {"type": "subtitle", "time": 16214.91, "timestamp": "04:30:14", "text": "右側"}, {"type": "subtitle", "time": 16219.429, "timestamp": "04:30:19", "text": "コーナー？写真を撮っておこう。"}, {"type": "subtitle", "time": 16221.71, "timestamp": "04:30:21", "text": "彼をこちらに連れて行かなければならない"}, {"type": "subtitle", "time": 16236.429, "timestamp": "04:30:36", "text": "待って。えっと、"}, {"type": "subtitle", "time": 16252.189, "timestamp": "04:30:52", "text": "私は彼を選ぶことができる"}, {"type": "subtitle", "time": 16253.95, "timestamp": "04:30:53", "text": "上。それ"}]
[{"type": "subtitle", "time": 5941.629, "timestamp": "01:39:01", "text": "右？ビーン"}, {"type": "subtitle", "time": 5944.95, "timestamp": "01:39:04", "text": "ポート。ああ、豆鍋。私が選びます。私"}, {"type": "subtitle", "time": 5953.47, "timestamp": "01:39:13", "text": "または、はい。こんにちは、ムハマダン。いらっしゃいませ。"}, {"type": "subtitle", "time": 5955.79, "timestamp": "01:39:15", "text": "いらっしゃいませ。調子はどうですか？"}, {"type": "subtitle", "time": 5958.51, "timestamp": "01:39:18", "text": "あなた？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 5961.39, "timestamp": "01:39:21", "text": "良い。私たちは手に入れます"}, {"type": "subtitle", "time": 5967.229, "timestamp": "01:39:27", "text": "[音楽]"}, {"type": "subtitle", "time": 5969.55, "timestamp": "01:39:29", "text": "二。"}, {"type": "subtitle", "time": 5973.109, "timestamp": "01:39:33", "text": "これが進化ですよね？私"}, {"type": "subtitle", "time": 5975.35, "timestamp": "01:39:35", "text": "一度も使ったことがない。私はそれを使います"}, {"type": "subtitle", "time": 5976.99, "timestamp": "01:39:36", "text": "1つ"}, {"type": "subtitle", "time": 5979.47, "timestamp": "01:39:39", "text": "日。"}, {"type": "subtitle", "time": 5982.99, "timestamp": "01:39:42", "text": "えっと、どうすれば"}, {"type": "subtitle", "time": 5986.669, "timestamp": "01:39:46", "text": "ビーニー帽のこと？"}, {"type": "subtitle", "time": 5988.05, "timestamp": "01:39:48", "text": "えっと、"}, {"type": "subtitle", "time": 5994.87, "timestamp": "01:39:54", "text": "忘れた。つまり、私たちは王国にいるのです。"}, {"type": "subtitle", "time": 5996.709, "timestamp": "01:39:56", "text": "右？それでね、知ってる？私は買います"}, {"type": "subtitle", "time": 5999.189, "timestamp": "01:39:59", "text": "雑貨屋で買ったもの。だから、私は買います"}]
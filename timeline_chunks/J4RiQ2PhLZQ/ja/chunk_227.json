[{"type": "subtitle", "time": 13620.56, "timestamp": "03:47:00", "text": "うん。"}, {"type": "subtitle", "time": 13638.309, "timestamp": "03:47:18", "text": "ええと、残っているのはストーリークエストだけです。"}, {"type": "subtitle", "time": 13640.229, "timestamp": "03:47:20", "text": "そしてストーリークエストを始める前に、"}, {"type": "subtitle", "time": 13642.97, "timestamp": "03:47:22", "text": "いくつか終わらせる必要がある"}, {"type": "subtitle", "time": 13658.51, "timestamp": "03:47:38", "text": "もの。これ"}, {"type": "subtitle", "time": 13667.79, "timestamp": "03:47:47", "text": "渦。これです。私たちは"}, {"type": "subtitle", "time": 13672.87, "timestamp": "03:47:52", "text": "多く。私のCPSは現在250です。さあ行こう。タイトル"}, {"type": "subtitle", "time": 13674.99, "timestamp": "03:47:54", "text": "月"}, {"type": "subtitle", "time": 13677.99, "timestamp": "03:47:57", "text": "スマッシャー。私はこれらのタイトルをすべて手に入れたい。"}]
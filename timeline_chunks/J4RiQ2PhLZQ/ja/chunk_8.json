[{"type": "subtitle", "time": 480.35, "timestamp": "00:08:00", "text": "1つ目の問題点。私はテトリスの配信をしました"}, {"type": "subtitle", "time": 485.51, "timestamp": "00:08:05", "text": "4月2月14日。それは面白い。"}, {"type": "subtitle", "time": 488.07, "timestamp": "00:08:08", "text": "おお。そうそう。砂テトラがいて、"}, {"type": "subtitle", "time": 490.629, "timestamp": "00:08:10", "text": "そういうことですよね？いいえ。"}, {"type": "subtitle", "time": 494.469, "timestamp": "00:08:14", "text": "まだプレイしていません。"}, {"type": "subtitle", "time": 496.95, "timestamp": "00:08:16", "text": "私の体調は良くありません。だから、私は"}, {"type": "subtitle", "time": 497.95, "timestamp": "00:08:17", "text": "本当に"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "今日は実際に座った日です"}, {"type": "subtitle", "time": 501.869, "timestamp": "00:08:21", "text": "私の"}, {"type": "subtitle", "time": 506.07, "timestamp": "00:08:26", "text": "数日後にはPCが壊れるんだよ。えっと"}, {"type": "subtitle", "time": 508.869, "timestamp": "00:08:28", "text": "ストリーミング配信から撤退する。私は使っていません"}, {"type": "subtitle", "time": 511.99, "timestamp": "00:08:31", "text": "私のPCは、私が"}, {"type": "subtitle", "time": 515.909, "timestamp": "00:08:35", "text": "本当にいつもベッドの上で"}, {"type": "subtitle", "time": 518.509, "timestamp": "00:08:38", "text": "生理のような症状が出ています"}, {"type": "subtitle", "time": 528.31, "timestamp": "00:08:48", "text": "疲れた。親知らずを抜歯しました"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "当時手術を受けていたので、"}, {"type": "subtitle", "time": 534.55, "timestamp": "00:08:54", "text": "正直言って、文字通り何でもいいんです。"}]
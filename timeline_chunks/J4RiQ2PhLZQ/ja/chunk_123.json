[{"type": "subtitle", "time": 7380.27, "timestamp": "02:03:00", "text": "えっと、こんにちはデーモンハンターと"}, {"type": "subtitle", "time": 7383.99, "timestamp": "02:03:03", "text": "世界。うん。こんにちは、夢見る人。私に任せないでください。"}, {"type": "subtitle", "time": 7388.27, "timestamp": "02:03:08", "text": "これは私が、えーと、つまりヌーニの時にすることです"}, {"type": "subtitle", "time": 7390.75, "timestamp": "02:03:10", "text": "AFK。それは"}, {"type": "subtitle", "time": 7393.95, "timestamp": "02:03:13", "text": "この新しいバトルパス。"}, {"type": "subtitle", "time": 7403.43, "timestamp": "02:03:23", "text": "もの。そこで、私は音量を下げます"}, {"type": "subtitle", "time": 7406.95, "timestamp": "02:03:26", "text": "ここ。これは何ですか？ 1000万インストール。"}, {"type": "subtitle", "time": 7413.79, "timestamp": "02:03:33", "text": "ニース。えーと、"}, {"type": "subtitle", "time": 7423.589, "timestamp": "02:03:43", "text": "実は。こんにちは。ええと、私の探求の途中で、"}, {"type": "subtitle", "time": 7424.25, "timestamp": "02:03:44", "text": "話す"}, {"type": "subtitle", "time": 7425.55, "timestamp": "02:03:45", "text": "[音楽]"}, {"type": "subtitle", "time": 7431.109, "timestamp": "02:03:51", "text": "鍛冶屋と話してアップグレードする"}, {"type": "subtitle", "time": 7435.109, "timestamp": "02:03:55", "text": "これに対する武器は一つだけだ。よし、アップグレードしよう。"}, {"type": "subtitle", "time": 7436.27, "timestamp": "02:03:56", "text": "なぜ私が"}]
[{"type": "subtitle", "time": 9727.63, "timestamp": "02:42:07", "text": "えっと、さっき何を話してたんだっけ、"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "えっと、YouTubeで猫の動画をやるため？"}, {"type": "subtitle", "time": 9733.99, "timestamp": "02:42:13", "text": "はい。ありがとう、ドリーミー。"}, {"type": "subtitle", "time": 9737.11, "timestamp": "02:42:17", "text": "それで、えーと、えーと、1つだけ"}, {"type": "subtitle", "time": 9738.99, "timestamp": "02:42:18", "text": "私を幸せにするのは"}, {"type": "subtitle", "time": 9741.59, "timestamp": "02:42:21", "text": "えーと、私が幸せを感じることは"}, {"type": "subtitle", "time": 9745.59, "timestamp": "02:42:25", "text": "昔の話だけど、去年のことなんだけど"}, {"type": "subtitle", "time": 9747.429, "timestamp": "02:42:27", "text": "かつては興味を持っていた唯一の人だった"}, {"type": "subtitle", "time": 9750.79, "timestamp": "02:42:30", "text": "高度なストリーミング関連の"}, {"type": "subtitle", "time": 9753.91, "timestamp": "02:42:33", "text": "主にレオロンボットの配信で"}, {"type": "subtitle", "time": 9757.429, "timestamp": "02:42:37", "text": "Leorbot 毎日いつも私はこう思うだろう"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "ああ、私はこれを理解する必要がある"}, {"type": "subtitle", "time": 9761.99, "timestamp": "02:42:41", "text": "どれだけ時間がかかっても私は"}, {"type": "subtitle", "time": 9764.389, "timestamp": "02:42:44", "text": "ソフトウェアを使いこなせ。すべてのストリーム"}, {"type": "subtitle", "time": 9766.95, "timestamp": "02:42:46", "text": "以前はTwitchで好きだった"}, {"type": "subtitle", "time": 9770.23, "timestamp": "02:42:50", "text": "エフェクトなどを正しく設定して"}, {"type": "subtitle", "time": 9772.87, "timestamp": "02:42:52", "text": "嬉しいことに、私だけでなく"}, {"type": "subtitle", "time": 9777.27, "timestamp": "02:42:57", "text": "それをすぐに行うことは、それを行わないことでもあります"}, {"type": "subtitle", "time": 9779.03, "timestamp": "02:42:59", "text": "えっと、彼はオリーブボードは使ってないけど"}]
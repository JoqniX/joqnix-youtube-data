[{"type": "subtitle", "time": 8280.669, "timestamp": "02:18:00", "text": "C. そしてこの2つは3つになり、"}, {"type": "subtitle", "time": 8284.03, "timestamp": "02:18:04", "text": "4つ。 3つと"}, {"type": "subtitle", "time": 8286.549, "timestamp": "02:18:06", "text": "4つ。私は別のマウスを使うことができたので、"}, {"type": "subtitle", "time": 8289.429, "timestamp": "02:18:09", "text": "お母さんネズミです。私はそうする必要はなかった"}, {"type": "subtitle", "time": 8292.22, "timestamp": "02:18:12", "text": "これは私のメインマウスの設定です。"}, {"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "[音楽]"}, {"type": "subtitle", "time": 8310.75, "timestamp": "02:18:30", "text": "これ。ああ、終わった。変更して"}, {"type": "subtitle", "time": 8312.83, "timestamp": "02:18:32", "text": "これ。近い"}, {"type": "subtitle", "time": 8316.95, "timestamp": "02:18:36", "text": "これ。ここに戻ってください。さあ行こう。"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "だから、私のQの部分、これは"}, {"type": "subtitle", "time": 8323.23, "timestamp": "02:18:43", "text": "攻撃"}, {"type": "subtitle", "time": 8325.95, "timestamp": "02:18:45", "text": "これは地図用で、これは私の"}, {"type": "subtitle", "time": 8329.07, "timestamp": "02:18:49", "text": "在庫を準備し、装備します"}, {"type": "subtitle", "time": 8333.75, "timestamp": "02:18:53", "text": "でも、今すごく力強い気分です"}]
[{"type": "subtitle", "time": 16453.949, "timestamp": "04:34:13", "text": "ダイヤモンド。ああ、もうすぐだ"}, {"type": "subtitle", "time": 16456.709, "timestamp": "04:34:16", "text": "10時15分ですよね？えっと、皆さんは"}, {"type": "subtitle", "time": 16458.029, "timestamp": "04:34:18", "text": "覚えてる？"}, {"type": "subtitle", "time": 16461.109, "timestamp": "04:34:21", "text": "目薬をさした？だから私は、"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "夜を待つ、朝の私は"}, {"type": "subtitle", "time": 16467.349, "timestamp": "04:34:27", "text": "正午に設定する。"}, {"type": "subtitle", "time": 16470.629, "timestamp": "04:34:30", "text": "夕方、いや、正午に5をつけた。"}, {"type": "subtitle", "time": 16474.109, "timestamp": "04:34:34", "text": "夜1日目は8時半に"}, {"type": "subtitle", "time": 16477.949, "timestamp": "04:34:37", "text": "午後初日は12歳まで寝ることができた。"}, {"type": "subtitle", "time": 16480.709, "timestamp": "04:34:40", "text": "推測。ええ、もう1つもそうです。うん、"}, {"type": "subtitle", "time": 16483.269, "timestamp": "04:34:43", "text": "それならできるよ。明日私は"}, {"type": "subtitle", "time": 16486.39, "timestamp": "04:34:46", "text": "6時に起きて、"}, {"type": "subtitle", "time": 16488.91, "timestamp": "04:34:48", "text": "そして私は寂しく思うことはない"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "それ。 1日に4回ですよね？それで、"}, {"type": "subtitle", "time": 16495.91, "timestamp": "04:34:55", "text": "午前6時、正午は"}, {"type": "subtitle", "time": 16499.109, "timestamp": "04:34:59", "text": "12:00、そして夕方はたぶん"}]
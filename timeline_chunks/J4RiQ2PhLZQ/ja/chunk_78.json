[{"type": "subtitle", "time": 4691.79, "timestamp": "01:18:11", "text": "のために"}, {"type": "subtitle", "time": 4713.149, "timestamp": "01:18:33", "text": "持続する。よし。行く"}, {"type": "subtitle", "time": 4715.11, "timestamp": "01:18:35", "text": "また。行くよ"}, {"type": "subtitle", "time": 4716.35, "timestamp": "01:18:36", "text": "[音楽]"}, {"type": "subtitle", "time": 4718.87, "timestamp": "01:18:38", "text": "また。パスワードを入力するのは面倒だ"}, {"type": "subtitle", "time": 4732.63, "timestamp": "01:18:52", "text": "時間。私はダブルが必要だと信じています"}, {"type": "subtitle", "time": 4737.189, "timestamp": "01:18:57", "text": "ぼやけたものの保護。"}]
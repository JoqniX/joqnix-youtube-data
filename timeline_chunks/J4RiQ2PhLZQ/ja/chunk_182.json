[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "スピーカーは追いつくので"}, {"type": "subtitle", "time": 10924.23, "timestamp": "03:02:04", "text": "音声はマイクに拾われるので"}, {"type": "subtitle", "time": 10927.83, "timestamp": "03:02:07", "text": "残念ながらそれは選択肢ではありません。イヤホン"}, {"type": "subtitle", "time": 10930.67, "timestamp": "03:02:10", "text": "それが私が買おうと思っていたものだった"}, {"type": "subtitle", "time": 10936.15, "timestamp": "03:02:16", "text": "でも私は、私はできるだろうかと思いました"}, {"type": "subtitle", "time": 10938.309, "timestamp": "03:02:18", "text": "イヤホン電話が欲しいのですが"}, {"type": "subtitle", "time": 10940.03, "timestamp": "03:02:20", "text": "使用"}, {"type": "subtitle", "time": 10943.95, "timestamp": "03:02:23", "text": "3D空間のような音が聞こえました"}, {"type": "subtitle", "time": 10947.349, "timestamp": "03:02:27", "text": "オーディオ。だから私は「どうすればいいんだろう？」と思ったんです。"}, {"type": "subtitle", "time": 10950.269, "timestamp": "03:02:30", "text": "どうすればいいですか？何をすべきか"}, {"type": "subtitle", "time": 10954.15, "timestamp": "03:02:34", "text": "する？耳に装着するヘッドホンは"}, {"type": "subtitle", "time": 10956.87, "timestamp": "03:02:36", "text": "ヘッドホンを装着した瞬間"}, {"type": "subtitle", "time": 10960.87, "timestamp": "03:02:40", "text": "3Dオーディオに対応しています。そうすれば私は適切に"}, {"type": "subtitle", "time": 10963.91, "timestamp": "03:02:43", "text": "サイクルの最前線で聞き、"}, {"type": "subtitle", "time": 10967.67, "timestamp": "03:02:47", "text": "他のゲームのオーディオ関連。"}, {"type": "subtitle", "time": 10970.87, "timestamp": "03:02:50", "text": "でも、もし私が使ったら心配になるだろう"}, {"type": "subtitle", "time": 10973.91, "timestamp": "03:02:53", "text": "イヤホンをつけて大丈夫でしょうか？私は思った"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "少なくともロジクールGで行くよ。え、何？"}]
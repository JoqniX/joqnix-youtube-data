[{"type": "subtitle", "time": 18061.07, "timestamp": "05:01:01", "text": "おお。私たちは"}, {"type": "subtitle", "time": 18064.31, "timestamp": "05:01:04", "text": "私たちは実際の人と話をします"}, {"type": "subtitle", "time": 18078.15, "timestamp": "05:01:18", "text": "1つ。それは素晴らしいですね。それは実際には"}, {"type": "subtitle", "time": 18080.868, "timestamp": "05:01:20", "text": "いいね。"}, {"type": "subtitle", "time": 18081.788, "timestamp": "05:01:21", "text": "光る"}, {"type": "subtitle", "time": 18084.75, "timestamp": "05:01:24", "text": "輝く。私は愛する"}, {"type": "subtitle", "time": 18093.47, "timestamp": "05:01:33", "text": "より"}, {"type": "subtitle", "time": 18097.19, "timestamp": "05:01:37", "text": "月光？ネイサン・モーが恋しい。私も。私"}, {"type": "subtitle", "time": 18099.23, "timestamp": "05:01:39", "text": "彼が元気でいることを願っています"}, {"type": "subtitle", "time": 18104.07, "timestamp": "05:01:44", "text": "良い。あの男は本当に一生懸命働いている。彼が"}]
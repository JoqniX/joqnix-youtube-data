[{"type": "subtitle", "time": 4985.229, "timestamp": "01:23:05", "text": "[音楽]"}, {"type": "subtitle", "time": 4988.95, "timestamp": "01:23:08", "text": "こんにちは。毎日赤リセットをしたいです。"}, {"type": "subtitle", "time": 4991.75, "timestamp": "01:23:11", "text": "でも、私は貯金しているのでそうしません。"}, {"type": "subtitle", "time": 4993.669, "timestamp": "01:23:13", "text": "私の"}, {"type": "subtitle", "time": 4997.11, "timestamp": "01:23:17", "text": "ええと、買うために"}, {"type": "subtitle", "time": 5000.31, "timestamp": "01:23:20", "text": "えっと、出席チケットなので変更できます"}, {"type": "subtitle", "time": 5003.669, "timestamp": "01:23:23", "text": "私の魔女キャラクターは次の機会に"}, {"type": "subtitle", "time": 5013.35, "timestamp": "01:23:33", "text": "ええ、だからここで何かする必要があるんです。"}, {"type": "subtitle", "time": 5014.91, "timestamp": "01:23:34", "text": "右？私"}, {"type": "subtitle", "time": 5022.75, "timestamp": "01:23:42", "text": "ロボット。ええと、ロボットは持っていません。"}, {"type": "subtitle", "time": 5025.189, "timestamp": "01:23:45", "text": "右？硬い王国を修復できます"}, {"type": "subtitle", "time": 5026.75, "timestamp": "01:23:46", "text": "近く"}, {"type": "subtitle", "time": 5028.83, "timestamp": "01:23:48", "text": "防御。大規模"}, {"type": "subtitle", "time": 5033.629, "timestamp": "01:23:53", "text": "ダメージを与え、近くのシールドを生成します"}, {"type": "subtitle", "time": 5037.149, "timestamp": "01:23:57", "text": "同盟国。はぁ。私たちはできる"}]
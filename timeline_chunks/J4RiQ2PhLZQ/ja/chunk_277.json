[{"type": "subtitle", "time": 16620.869, "timestamp": "04:37:00", "text": "光感受性。それで私は、えっと、"}, {"type": "subtitle", "time": 16624.07, "timestamp": "04:37:04", "text": "犬に尋ねて私の話を締めくくった"}, {"type": "subtitle", "time": 16627.189, "timestamp": "04:37:07", "text": "写真恐怖症みたいなの、と彼女は言った"}, {"type": "subtitle", "time": 16631.67, "timestamp": "04:37:11", "text": "彼女が、ええと、"}, {"type": "subtitle", "time": 16633.949, "timestamp": "04:37:13", "text": "私は光過敏症です"}, {"type": "subtitle", "time": 16639.109, "timestamp": "04:37:19", "text": "明るい光が見えないのが問題です。"}, {"type": "subtitle", "time": 16643.429, "timestamp": "04:37:23", "text": "だから、ほとんどの場合私は"}, {"type": "subtitle", "time": 16646.949, "timestamp": "04:37:26", "text": "これです。オレンジっぽい感じに保っています"}, {"type": "subtitle", "time": 16649.39, "timestamp": "04:37:29", "text": "これは本当に"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "オレンジがかった色。そして私の携帯電話には、"}, {"type": "subtitle", "time": 16655.67, "timestamp": "04:37:35", "text": "明るさを極端に低くして、オンのままにしておく"}, {"type": "subtitle", "time": 16658.709, "timestamp": "04:37:38", "text": "ダークモード。いいえ、暗くするモードです。そうなるだろう"}, {"type": "subtitle", "time": 16660.83, "timestamp": "04:37:40", "text": "もっと"}, {"type": "subtitle", "time": 16664.07, "timestamp": "04:37:44", "text": "より暗い。そう、そんな感じ。だって、明るいから"}, {"type": "subtitle", "time": 16666.47, "timestamp": "04:37:46", "text": "光は痛みであり、蛍光灯をつけていると"}, {"type": "subtitle", "time": 16669.83, "timestamp": "04:37:49", "text": "私の上には時々見上げるようなものがある"}, {"type": "subtitle", "time": 16671.99, "timestamp": "04:37:51", "text": "まっすぐ見ることができず、目が"}, {"type": "subtitle", "time": 16675.07, "timestamp": "04:37:55", "text": "涙ぐんだりするんだけど"}]
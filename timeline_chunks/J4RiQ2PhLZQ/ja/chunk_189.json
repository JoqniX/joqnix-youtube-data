[{"type": "subtitle", "time": 11341.55, "timestamp": "03:09:01", "text": "来週の配信はHollowと共に"}, {"type": "subtitle", "time": 11344.23, "timestamp": "03:09:04", "text": "騎士。しばらくぶり"}, {"type": "subtitle", "time": 11345.95, "timestamp": "03:09:05", "text": "その二人に触れた、"}, {"type": "subtitle", "time": 11348.63, "timestamp": "03:09:08", "text": "右？誰かもっと知っている人がいたら"}, {"type": "subtitle", "time": 11350.75, "timestamp": "03:09:10", "text": "これらの噂は、"}, {"type": "subtitle", "time": 11355.349, "timestamp": "03:09:15", "text": "彼女。こんにちは、作業は完了しました。ええ、そうしますし"}, {"type": "subtitle", "time": 11357.429, "timestamp": "03:09:17", "text": "目立たないようにしておきます。私たちでさえ"}, {"type": "subtitle", "time": 11359.51, "timestamp": "03:09:19", "text": "決して分からない、絶対に分からない、そうでしょう？"}, {"type": "subtitle", "time": 11362.55, "timestamp": "03:09:22", "text": "必要になるかどうかは分からない。そして私たちは"}, {"type": "subtitle", "time": 11366.55, "timestamp": "03:09:26", "text": "その件はもう終わった。"}, {"type": "subtitle", "time": 11369.309, "timestamp": "03:09:29", "text": "私たちは、"}, {"type": "subtitle", "time": 11372.349, "timestamp": "03:09:32", "text": "フェリー。私は"}, {"type": "subtitle", "time": 11375.429, "timestamp": "03:09:35", "text": "立ち往生。ああ、レミー、もし君がまだ"}, {"type": "subtitle", "time": 11378.95, "timestamp": "03:09:38", "text": "パーティーのことですよね？それで、えっと、パーティーに行くよ"}, {"type": "subtitle", "time": 11382.15, "timestamp": "03:09:42", "text": "ボーナスらしい。 2つのパーティー"}, {"type": "subtitle", "time": 11384.87, "timestamp": "03:09:44", "text": "ボーナスポイントは、私たちが2人だからですよね？あなた"}, {"type": "subtitle", "time": 11386.55, "timestamp": "03:09:46", "text": "金相場と価格下落"}, {"type": "subtitle", "time": 11389.429, "timestamp": "03:09:49", "text": "周辺地域にいる場合のみ料金を請求します"}, {"type": "subtitle", "time": 11393.469, "timestamp": "03:09:53", "text": "実際、党員たちと同じだ。"}]
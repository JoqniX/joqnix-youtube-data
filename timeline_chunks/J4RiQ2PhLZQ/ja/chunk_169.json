[{"type": "subtitle", "time": 10142.95, "timestamp": "02:49:02", "text": "超銀色のひげが本当に"}, {"type": "subtitle", "time": 10145.83, "timestamp": "02:49:05", "text": "打ち負かすのは難しいが、多くの人々"}, {"type": "subtitle", "time": 10148.87, "timestamp": "02:49:08", "text": "レベルアップして、ひたすら努力して、"}, {"type": "subtitle", "time": 10152.309, "timestamp": "02:49:12", "text": "さあ、ボス、お気楽にいきましょう。最初のボスと同じように。"}, {"type": "subtitle", "time": 10155.91, "timestamp": "02:49:15", "text": "理由はわからないが、そういうものなのだ。"}, {"type": "subtitle", "time": 10161.19, "timestamp": "02:49:21", "text": "ええ、そうですね。ええと、そうですね、おそらく"}, {"type": "subtitle", "time": 10164.469, "timestamp": "02:49:24", "text": "少なくとも2つは手に入れることができるでしょう"}, {"type": "subtitle", "time": 10167.99, "timestamp": "02:49:27", "text": "これ。彼らは20チャンネルを持っている。ああ、1"}, {"type": "subtitle", "time": 10170.79, "timestamp": "02:49:30", "text": "分。そしてウォルコンは今や楽な上司だ"}, {"type": "subtitle", "time": 10173.11, "timestamp": "02:49:33", "text": "今のところ、実際に勝つのは"}, {"type": "subtitle", "time": 10175.75, "timestamp": "02:49:35", "text": "全員が今や高レベルだ。の"}, {"type": "subtitle", "time": 10179.11, "timestamp": "02:49:39", "text": "全員のキャラクターレベルが高い。それで"}, {"type": "subtitle", "time": 10181.429, "timestamp": "02:49:41", "text": "そのためには、おそらく2つまたは"}, {"type": "subtitle", "time": 10185.87, "timestamp": "02:49:45", "text": "3つ、そして昨日私は"}, {"type": "subtitle", "time": 10188.91, "timestamp": "02:49:48", "text": "巨大。私は1つ作ることができました"}, {"type": "subtitle", "time": 10192.389, "timestamp": "02:49:52", "text": "巨大だから、そうしよう。とにかく私は"}, {"type": "subtitle", "time": 10196.59, "timestamp": "02:49:56", "text": "これを自動設定にしておく。私の中に入って"}, {"type": "subtitle", "time": 10199.91, "timestamp": "02:49:59", "text": "自動戦闘距離を設定します。私はします"}]
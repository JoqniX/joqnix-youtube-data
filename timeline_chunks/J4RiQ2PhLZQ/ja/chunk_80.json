[{"type": "subtitle", "time": 4801.31, "timestamp": "01:20:01", "text": "これ。私はこの水色が欲しかったのですが、痛みがありました。"}, {"type": "subtitle", "time": 4804.91, "timestamp": "01:20:04", "text": "待って、少なくとも壁は変えよう"}, {"type": "subtitle", "time": 4808.91, "timestamp": "01:20:08", "text": "そして水色に変わる。うん。"}, {"type": "subtitle", "time": 4811.79, "timestamp": "01:20:11", "text": "購入。"}, {"type": "subtitle", "time": 4818.11, "timestamp": "01:20:18", "text": "壁。すべての壁が変わるわけではない。それは"}, {"type": "subtitle", "time": 4821.03, "timestamp": "01:20:21", "text": "右。ああ、まだ重ねて塗ることができます"}, {"type": "subtitle", "time": 4828.35, "timestamp": "01:20:28", "text": "えっと"}, {"type": "subtitle", "time": 4831.07, "timestamp": "01:20:31", "text": "壁の青"}, {"type": "subtitle", "time": 4839.149, "timestamp": "01:20:39", "text": "壁"}, {"type": "subtitle", "time": 4841.31, "timestamp": "01:20:41", "text": "カスタマイズ"}, {"type": "subtitle", "time": 4851.42, "timestamp": "01:20:51", "text": "壁は私が残しておきたい3つです、サクラ"}, {"type": "subtitle", "time": 4852.59, "timestamp": "01:20:52", "text": "[音楽]"}, {"type": "subtitle", "time": 4856.03, "timestamp": "01:20:56", "text": "3つしか持っていない"}]
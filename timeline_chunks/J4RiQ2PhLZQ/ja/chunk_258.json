[{"type": "subtitle", "time": 15480.83, "timestamp": "04:18:00", "text": "来る"}, {"type": "subtitle", "time": 15484.07, "timestamp": "04:18:04", "text": "の上。私は彼を監禁した。私は彼を閉じ込めた"}, {"type": "subtitle", "time": 15506.04, "timestamp": "04:18:26", "text": "ネット。外に出て"}, {"type": "subtitle", "time": 15515.189, "timestamp": "04:18:35", "text": "手。彼は逃げ出した。おお、"}, {"type": "subtitle", "time": 15537.389, "timestamp": "04:18:57", "text": "行く。わかった、行かせてあげるよ。君を解放したよ。"}, {"type": "subtitle", "time": 15539.63, "timestamp": "04:18:59", "text": "待って。しないでください"}]
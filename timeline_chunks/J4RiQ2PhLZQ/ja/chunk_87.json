[{"type": "subtitle", "time": 5221.79, "timestamp": "01:27:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5224.709, "timestamp": "01:27:04", "text": "それ。黒曜石を寄付してください。それは実行されるだろう"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "明日までに。明後日"}, {"type": "subtitle", "time": 5230.11, "timestamp": "01:27:10", "text": "信じる。"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "H ダンジョンを３回作成する"}, {"type": "subtitle", "time": 5237.43, "timestamp": "01:27:17", "text": "傭兵。傭兵とは何ですか？私"}, {"type": "subtitle", "time": 5240.229, "timestamp": "01:27:20", "text": "チーム全員のような他の人を信じる"}, {"type": "subtitle", "time": 5242.709, "timestamp": "01:27:22", "text": "ギルドメンバー全員もクリアする必要がある"}, {"type": "subtitle", "time": 5244.43, "timestamp": "01:27:24", "text": "の"}, {"type": "subtitle", "time": 5247.99, "timestamp": "01:27:27", "text": "これをクリアするにはダンジョンを攻略する必要があります。私"}, {"type": "subtitle", "time": 5262.91, "timestamp": "01:27:42", "text": "えっと、ダンジョンを2回"}, {"type": "subtitle", "time": 5267.47, "timestamp": "01:27:47", "text": "黒曜石料理2つの料金"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "座る 一度もやったことがない こんにちは、できます"}]
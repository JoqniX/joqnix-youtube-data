[{"type": "subtitle", "time": 10264.03, "timestamp": "02:51:04", "text": "タイムアウト。待って。ええと、それを変更します"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "異なるものに。ええと、それを次のように変更します。"}, {"type": "subtitle", "time": 10268.99, "timestamp": "02:51:08", "text": "えっと、これ"}, {"type": "subtitle", "time": 10272.07, "timestamp": "02:51:12", "text": "1つ。つまり、私は、ええと、"}, {"type": "subtitle", "time": 10274.75, "timestamp": "02:51:14", "text": "銀色のひげ なぜなら私は持っていないから"}, {"type": "subtitle", "time": 10277.63, "timestamp": "02:51:17", "text": "これ、"}, {"type": "subtitle", "time": 10280.87, "timestamp": "02:51:20", "text": "でも、みんなそれを克服したよ。すでに"}, {"type": "subtitle", "time": 10284.91, "timestamp": "02:51:24", "text": "失せろ。何てことだ。わかった。えーと、チャンネル"}, {"type": "subtitle", "time": 10288.75, "timestamp": "02:51:28", "text": "二。チャンネル2は見られません。満員です。"}, {"type": "subtitle", "time": 10291.63, "timestamp": "02:51:31", "text": "いいえ、"}, {"type": "subtitle", "time": 10294.07, "timestamp": "02:51:34", "text": "いらっしゃいませ。うん、私は必要ない"}, {"type": "subtitle", "time": 10296.309, "timestamp": "02:51:36", "text": "正直に言うと。私"}, {"type": "subtitle", "time": 10299.429, "timestamp": "02:51:39", "text": "実際、料理人は必要ありません。つまり、私は"}, {"type": "subtitle", "time": 10302.07, "timestamp": "02:51:42", "text": "この素晴らしいネックレスが欲しい。私はしません"}, {"type": "subtitle", "time": 10304.79, "timestamp": "02:51:44", "text": "より良いネックレスとより良い"}, {"type": "subtitle", "time": 10307.83, "timestamp": "02:51:47", "text": "指輪。だから、ギガンテをファームする必要がある"}, {"type": "subtitle", "time": 10312.91, "timestamp": "02:51:52", "text": "しかし"}, {"type": "subtitle", "time": 10319.429, "timestamp": "02:51:59", "text": "秒。あと、チャットを忘れてた"}]
[{"type": "subtitle", "time": 17340.91, "timestamp": "04:49:00", "text": "44. こんにちは。とにかく、私たちは行く"}, {"type": "subtitle", "time": 17343.07, "timestamp": "04:49:03", "text": "すぐ戻ります。私はそうします"}, {"type": "subtitle", "time": 17345.23, "timestamp": "04:49:05", "text": "これと"}, {"type": "subtitle", "time": 17348.19, "timestamp": "04:49:08", "text": "これ。 BBに行こう"}, {"type": "subtitle", "time": 17350.43, "timestamp": "04:49:10", "text": "少し。どこ"}, {"type": "subtitle", "time": 17354.07, "timestamp": "04:49:14", "text": "ああ、これについて話さなきゃ"}, {"type": "subtitle", "time": 17358.19, "timestamp": "04:49:18", "text": "えっと、Bのやつ。 YouTube を入手"}, {"type": "subtitle", "time": 17361.91, "timestamp": "04:49:21", "text": "チャット。それでは、少ししたら戻ってきます。"}, {"type": "subtitle", "time": 17364.628, "timestamp": "04:49:24", "text": "無効にします。待って、私たちは"}, {"type": "subtitle", "time": 17367.51, "timestamp": "04:49:27", "text": "猫だけど、ここはTwitchじゃないからね。"}, {"type": "subtitle", "time": 17386.19, "timestamp": "04:49:46", "text": "私はそうすべきだ"}, {"type": "subtitle", "time": 17389.27, "timestamp": "04:49:49", "text": "それ。猫の件については、よくわかりません。"}, {"type": "subtitle", "time": 17396.948, "timestamp": "04:49:56", "text": "えっと、こちら側とこの赤ちゃんとあれ"}, {"type": "subtitle", "time": 17398.91, "timestamp": "04:49:58", "text": "赤ちゃんは"}]
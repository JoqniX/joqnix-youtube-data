[{"type": "subtitle", "time": 15003.469, "timestamp": "04:10:03", "text": "ゲームで遅れている？"}, {"type": "subtitle", "time": 15025.51, "timestamp": "04:10:25", "text": "行くよ。 NPCは「ああ、私は"}, {"type": "subtitle", "time": 15028.07, "timestamp": "04:10:28", "text": "ここから出て行け。次の場所へ行きます。"}, {"type": "subtitle", "time": 15031.11, "timestamp": "04:10:31", "text": "「そこで会おう。」私は「ああ、君は」"}]
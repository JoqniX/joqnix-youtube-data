[{"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "以上。みんな鼓動している。あ、待って。私"}, {"type": "subtitle", "time": 10384.99, "timestamp": "02:53:04", "text": "1つ必要"}, {"type": "subtitle", "time": 10387.91, "timestamp": "02:53:07", "text": "15. みんな素晴らしい活躍をしている。何"}, {"type": "subtitle", "time": 10411.11, "timestamp": "02:53:31", "text": "良い。私は死んだ。何かもらえましたか？ああ、私は"}, {"type": "subtitle", "time": 10414.79, "timestamp": "02:53:34", "text": "何か手に入れた。私は一撃で仕留めた。私はそれを叩いた"}, {"type": "subtitle", "time": 10418.55, "timestamp": "02:53:38", "text": "一度。報酬を受け取りました。良い。さあ行こう"}, {"type": "subtitle", "time": 10421.07, "timestamp": "02:53:41", "text": "ここ。歓迎を受ける"}, {"type": "subtitle", "time": 10428.87, "timestamp": "02:53:48", "text": "右。 78. ああ、私たちには何もできません。"}]
[{"type": "subtitle", "time": 18421.23, "timestamp": "05:07:01", "text": "プリン。うん、彼女にこう言うべきだ"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "いつかプリンを作ってくれるか、作り方を教えてくれる"}, {"type": "subtitle", "time": 18427.83, "timestamp": "05:07:07", "text": "プリン。"}, {"type": "subtitle", "time": 18440.868, "timestamp": "05:07:20", "text": "彼はわざと私の冗談を無視している。待って、"}, {"type": "subtitle", "time": 18442.35, "timestamp": "05:07:22", "text": "何"}, {"type": "subtitle", "time": 18446.37, "timestamp": "05:07:26", "text": "ジョーク？待って、どこで"}, {"type": "subtitle", "time": 18447.788, "timestamp": "05:07:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18452.35, "timestamp": "05:07:32", "text": "ジョーク？待って、ボンガ。"}, {"type": "subtitle", "time": 18454.35, "timestamp": "05:07:34", "text": "いいえ、"}, {"type": "subtitle", "time": 18456.788, "timestamp": "05:07:36", "text": "待って。あなたもプリンが好きですよね。ええ、私は"}, {"type": "subtitle", "time": 18459.99, "timestamp": "05:07:39", "text": "プリンが大好き。バカ、忘れてるよ。私"}, {"type": "subtitle", "time": 18461.99, "timestamp": "05:07:41", "text": "ジョークが理解できない。私はそれらを受け取ります"}]
[{"type": "subtitle", "time": 9422.389, "timestamp": "02:37:02", "text": "丸みを帯びている。私は丸みを帯びたものが好きです。さらに丸みを帯びた。"}, {"type": "subtitle", "time": 9424.55, "timestamp": "02:37:04", "text": "そして、私が"}, {"type": "subtitle", "time": 9438.55, "timestamp": "02:37:18", "text": "右。今でも自分のキャラクターの「ピュー」という音が聞こえる"}, {"type": "subtitle", "time": 9441.11, "timestamp": "02:37:21", "text": "ピューピュー音がするから、まだ続いていると思う"}, {"type": "subtitle", "time": 9443.75, "timestamp": "02:37:23", "text": "クエスト中、そしてあらゆることにおいて、"}, {"type": "subtitle", "time": 9446.71, "timestamp": "02:37:26", "text": "良いですね。"}, {"type": "subtitle", "time": 9449.71, "timestamp": "02:37:29", "text": "そうなってほしくない"}, {"type": "subtitle", "time": 9453.59, "timestamp": "02:37:33", "text": "ポーションが足りないせいで死にそう。する必要がある"}, {"type": "subtitle", "time": 9457.349, "timestamp": "02:37:37", "text": "近いうちにポーションをたくさん買っておきましょう。そして、"}, {"type": "subtitle", "time": 9475.19, "timestamp": "02:37:55", "text": "右。昔が懐かしい。"}, {"type": "subtitle", "time": 9477.469, "timestamp": "02:37:57", "text": "昔の私"}]
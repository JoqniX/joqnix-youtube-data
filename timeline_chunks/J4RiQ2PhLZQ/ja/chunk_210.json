[{"type": "subtitle", "time": 12602.79, "timestamp": "03:30:02", "text": "何回行かなければならないのか"}, {"type": "subtitle", "time": 12604.91, "timestamp": "03:30:04", "text": "これを通して"}, {"type": "subtitle", "time": 12611.59, "timestamp": "03:30:11", "text": "それはあなたが強いということでしょう。したい"}, {"type": "subtitle", "time": 12614.309, "timestamp": "03:30:14", "text": "手伝ってくれませんか？はい。"}, {"type": "subtitle", "time": 12617.269, "timestamp": "03:30:17", "text": "ゴブリンとビッグマッシュルームを教えることはできますか？"}, {"type": "subtitle", "time": 12619.11, "timestamp": "03:30:19", "text": "村の北にある沼地は教訓となるのだろうか？"}, {"type": "subtitle", "time": 12621.59, "timestamp": "03:30:21", "text": "はい。"}, {"type": "subtitle", "time": 12625.71, "timestamp": "03:30:25", "text": "大丈夫。私たちにお任せください。そうします"}, {"type": "subtitle", "time": 12627.35, "timestamp": "03:30:27", "text": "それ。"}, {"type": "subtitle", "time": 12629.469, "timestamp": "03:30:29", "text": "[音楽]"}, {"type": "subtitle", "time": 12633.79, "timestamp": "03:30:33", "text": "ゴブリング。ああ、音は合っている。私"}, {"type": "subtitle", "time": 12636.67, "timestamp": "03:30:36", "text": "忘れた"}, {"type": "subtitle", "time": 12639.95, "timestamp": "03:30:39", "text": "オーディオゲームですよね？"}, {"type": "subtitle", "time": 12643.75, "timestamp": "03:30:43", "text": "音声は日本語です。"}, {"type": "subtitle", "time": 12645.87, "timestamp": "03:30:45", "text": "ダウンロードが完了しました。"}]
[{"type": "subtitle", "time": 14525.03, "timestamp": "04:02:05", "text": "ヒドリーを上げて。彼と私がレベルアップできてラッキーだった"}, {"type": "subtitle", "time": 14527.51, "timestamp": "04:02:07", "text": "私のCP。"}, {"type": "subtitle", "time": 14531.91, "timestamp": "04:02:11", "text": "こんにちは、レベル30ですね。良いですね。私はレベル46メインです"}, {"type": "subtitle", "time": 14535.87, "timestamp": "04:02:15", "text": "レベル。研磨。何？何を磨けばいいですか？"}, {"type": "subtitle", "time": 14539.11, "timestamp": "04:02:19", "text": "ここ？どの武器かは決して教えてくれない"}, {"type": "subtitle", "time": 14541.63, "timestamp": "04:02:21", "text": "磨くか"}, {"type": "subtitle", "time": 14549.189, "timestamp": "04:02:29", "text": "痛み。こんにちは。ええ、すべて完了しました。"}, {"type": "subtitle", "time": 14550.67, "timestamp": "04:02:30", "text": "私たちができること"}, {"type": "subtitle", "time": 14553.99, "timestamp": "04:02:33", "text": "残っているのは次元です"}, {"type": "subtitle", "time": 14557.51, "timestamp": "04:02:37", "text": "これ。そして今度は巣と"}, {"type": "subtitle", "time": 14559.269, "timestamp": "04:02:39", "text": "トイレ。私はまだ"}, {"type": "subtitle", "time": 14562.71, "timestamp": "04:02:42", "text": "トイレ。それでは、"}, {"type": "subtitle", "time": 14565.91, "timestamp": "04:02:45", "text": "休む。私はチケットを7枚持っています。私たちはできる"}, {"type": "subtitle", "time": 14573.63, "timestamp": "04:02:53", "text": "UO。いつロック解除できますか"}, {"type": "subtitle", "time": 14577.269, "timestamp": "04:02:57", "text": "このレベルの要件を満たしていませんか？わかった。それで"}, {"type": "subtitle", "time": 14579.309, "timestamp": "04:02:59", "text": "待って、このフロステンはどうなの？"}]
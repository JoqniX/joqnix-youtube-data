[{"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "去年の自分の行動さえ覚えている。私"}, {"type": "subtitle", "time": 426.99, "timestamp": "00:07:06", "text": "私はそう思っていなかった 何か最後にした"}, {"type": "subtitle", "time": 429.79, "timestamp": "00:07:09", "text": "年？ええと、私は"}, {"type": "subtitle", "time": 433.67, "timestamp": "00:07:13", "text": "前年の日付を確認してください"}, {"type": "subtitle", "time": 435.67, "timestamp": "00:07:15", "text": "チョコレートのサプライズみたいにやった"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "ストリーム。"}, {"type": "subtitle", "time": 438.78, "timestamp": "00:07:18", "text": "ああ"}, {"type": "subtitle", "time": 441.11, "timestamp": "00:07:21", "text": "[音楽]"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "あまり撮影していなかったと思う"}, {"type": "subtitle", "time": 448.87, "timestamp": "00:07:28", "text": "昔の話だけどね。ひっくり返して"}, {"type": "subtitle", "time": 452.15, "timestamp": "00:07:32", "text": "うん、ストリーミング配信はしていなかったと思う"}, {"type": "subtitle", "time": 454.23, "timestamp": "00:07:34", "text": "彼女は悪夢を見るだろう"}, {"type": "subtitle", "time": 456.189, "timestamp": "00:07:36", "text": "今日の"}, {"type": "subtitle", "time": 460.15, "timestamp": "00:07:40", "text": "クラフトはしないよ"}, {"type": "subtitle", "time": 462.79, "timestamp": "00:07:42", "text": "年齢を３つの部分に分けます"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "その期間中に結婚式に出席した"}, {"type": "subtitle", "time": 467.67, "timestamp": "00:07:47", "text": "時間"}, {"type": "subtitle", "time": 470.43, "timestamp": "00:07:50", "text": "h のとき"}, {"type": "subtitle", "time": 476.07, "timestamp": "00:07:56", "text": "えっと、去年のバレンタインデーの頃"}]
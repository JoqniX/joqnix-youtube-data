[{"type": "subtitle", "time": 1265.23, "timestamp": "00:21:05", "text": "お祝い。パーティーを開いて食事を用意してください"}, {"type": "subtitle", "time": 1267.39, "timestamp": "00:21:07", "text": "私たち。"}, {"type": "subtitle", "time": 1269.87, "timestamp": "00:21:09", "text": "おめでとう。その"}, {"type": "subtitle", "time": 1271.45, "timestamp": "00:21:11", "text": "お祝い。"}, {"type": "subtitle", "time": 1272.75, "timestamp": "00:21:12", "text": "[音楽]"}, {"type": "subtitle", "time": 1283.75, "timestamp": "00:21:23", "text": "よし、みんな。私たちはそれをやり遂げました。わーい。"}, {"type": "subtitle", "time": 1286.87, "timestamp": "00:21:26", "text": "それが綺麗かどうかはわからないが、"}, {"type": "subtitle", "time": 1288.83, "timestamp": "00:21:28", "text": "しかし"}, {"type": "subtitle", "time": 1291.75, "timestamp": "00:21:31", "text": "うん。私にやらせてください。私の手は"}, {"type": "subtitle", "time": 1295.669, "timestamp": "00:21:35", "text": "かわいい。分かってるよ、チャド。"}, {"type": "subtitle", "time": 1299.5, "timestamp": "00:21:39", "text": "ちょっと待って、待って、待って。"}, {"type": "subtitle", "time": 1302.63, "timestamp": "00:21:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1307.35, "timestamp": "00:21:47", "text": "ジョーはよくやった。なぜこの穴は"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "私たちはすべての写真を撮るべきです"}, {"type": "subtitle", "time": 1318.07, "timestamp": "00:21:58", "text": "私たちが作った折り紙。それは私のものだけです"}]
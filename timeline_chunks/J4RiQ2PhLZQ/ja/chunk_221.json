[{"type": "subtitle", "time": 13260.03, "timestamp": "03:41:00", "text": "水を入れると自動的に補充されます。私"}, {"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "引き続き入手できると思います"}, {"type": "subtitle", "time": 13266.19, "timestamp": "03:41:06", "text": "農業を続ける限り"}, {"type": "subtitle", "time": 13276.269, "timestamp": "03:41:16", "text": "[音楽]"}, {"type": "subtitle", "time": 13278.95, "timestamp": "03:41:18", "text": "バッジ。彼は時々それを理解できない。"}, {"type": "subtitle", "time": 13287.75, "timestamp": "03:41:27", "text": "ええ、私たちがそれを手に入れなかったということは、"}, {"type": "subtitle", "time": 13290.83, "timestamp": "03:41:30", "text": "明日また来なければならないか、"}, {"type": "subtitle", "time": 13294.309, "timestamp": "03:41:34", "text": "後で。配電盤のところへ行きます"}, {"type": "subtitle", "time": 13314.389, "timestamp": "03:41:54", "text": "ええと、時間はありますよ。ええ、私には"}, {"type": "subtitle", "time": 13316.469, "timestamp": "03:41:56", "text": "貿易ですよね？私は店を開く必要があります"}]
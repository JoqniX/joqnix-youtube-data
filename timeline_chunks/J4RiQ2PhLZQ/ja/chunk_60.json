[{"type": "subtitle", "time": 3602.63, "timestamp": "01:00:02", "text": "それは買わないつもりだった。ありがとう。"}, {"type": "subtitle", "time": 3609.549, "timestamp": "01:00:09", "text": "それ。ほかに何か？バンドル。農場"}, {"type": "subtitle", "time": 3613.87, "timestamp": "01:00:13", "text": "上。もう一つの無料おなじみのレベルアップ"}, {"type": "subtitle", "time": 3618.069, "timestamp": "01:00:18", "text": "あれ。こんにちは。"}, {"type": "subtitle", "time": 3620.87, "timestamp": "01:00:20", "text": "おなじみの贈り物。それでは、ここに行って"}, {"type": "subtitle", "time": 3626.789, "timestamp": "01:00:26", "text": "贈り物。私が好きなのは、"}, {"type": "subtitle", "time": 3632.789, "timestamp": "01:00:32", "text": "みんな入ってきて、私はただfをスパムするのが好きなだけ"}, {"type": "subtitle", "time": 3635.27, "timestamp": "01:00:35", "text": "電話の中で。あなたはこのゲームをプレイしています"}, {"type": "subtitle", "time": 3637.829, "timestamp": "01:00:37", "text": "電話、これはできません。あなたはただスパムしているだけです"}, {"type": "subtitle", "time": 3642.03, "timestamp": "01:00:42", "text": "画面が超高くなるまでこの状態を続けます"}, {"type": "subtitle", "time": 3645.349, "timestamp": "01:00:45", "text": "黒く塗りつぶして入手したアイテムをクリアする"}, {"type": "subtitle", "time": 3655.47, "timestamp": "01:00:55", "text": "右。それが私が"}, {"type": "subtitle", "time": 3659.47, "timestamp": "01:00:59", "text": "考える。さあ、"}]
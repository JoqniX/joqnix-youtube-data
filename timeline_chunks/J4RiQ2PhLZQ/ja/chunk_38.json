[{"type": "subtitle", "time": 2282.39, "timestamp": "00:38:02", "text": "何か。音楽についても同様です。"}, {"type": "subtitle", "time": 2286.39, "timestamp": "00:38:06", "text": "プロデューサーは、"}, {"type": "subtitle", "time": 2289.589, "timestamp": "00:38:09", "text": "99%のプロデューサーは"}, {"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "ヒット曲でもリリースするとか。"}, {"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "それは世間でよく言われることわざみたいなものだ。同じ"}, {"type": "subtitle", "time": 2298.91, "timestamp": "00:38:18", "text": "他のジャンルでは次のように言うことができます"}, {"type": "subtitle", "time": 2302.79, "timestamp": "00:38:22", "text": "良い。ジャンルのニッチではなく、"}, {"type": "subtitle", "time": 2304.79, "timestamp": "00:38:24", "text": "言う。"}, {"type": "subtitle", "time": 2313.03, "timestamp": "00:38:33", "text": "それは私の弦でした、それは私の今日の"}, {"type": "subtitle", "time": 2317.47, "timestamp": "00:38:37", "text": "配信は良いですか？私は携帯電話を使っていました"}, {"type": "subtitle", "time": 2320.47, "timestamp": "00:38:40", "text": "カメラ。私は携帯電話のカメラを使っていました。私"}, {"type": "subtitle", "time": 2322.47, "timestamp": "00:38:42", "text": "良かったかどうかは分からない。それは"}, {"type": "subtitle", "time": 2327.03, "timestamp": "00:38:47", "text": "背面カメラ、つまり2倍ズームのカメラを使用します。いいえ、"}, {"type": "subtitle", "time": 2330.069, "timestamp": "00:38:50", "text": "いいえ、外向きカメラは、"}, {"type": "subtitle", "time": 2334.55, "timestamp": "00:38:54", "text": "遠くにあるカメラだと思う。うん。"}]
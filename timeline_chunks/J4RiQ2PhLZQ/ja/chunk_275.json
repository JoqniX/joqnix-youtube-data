[{"type": "subtitle", "time": 16502.23, "timestamp": "04:35:02", "text": "3か4か6、それから夜はこんな感じになる"}, {"type": "subtitle", "time": 16506.39, "timestamp": "04:35:06", "text": "午前8時から9時、または12時頃。"}, {"type": "subtitle", "time": 16508.51, "timestamp": "04:35:08", "text": "のように"}, {"type": "subtitle", "time": 16512.709, "timestamp": "04:35:12", "text": "それ。こんにちは。ええと、必要なものは"}, {"type": "subtitle", "time": 16518.629, "timestamp": "04:35:18", "text": "する？そうそう。古いものに切り替えましょう"}, {"type": "subtitle", "time": 16522.07, "timestamp": "04:35:22", "text": "技術下請け業者を雇ってクエストを遂行する。"}, {"type": "subtitle", "time": 16524.47, "timestamp": "04:35:24", "text": "あ、待って。手動でスキップする必要があります"}, {"type": "subtitle", "time": 16528.15, "timestamp": "04:35:28", "text": "対話。だから、自動化はできない"}, {"type": "subtitle", "time": 16532.709, "timestamp": "04:35:32", "text": "オフ。痛み。えっと、では私たちはどうすればいいのでしょうか？何"}, {"type": "subtitle", "time": 16536.51, "timestamp": "04:35:36", "text": "私たちにできることはありますか？私たちは何ができるでしょうか"}]
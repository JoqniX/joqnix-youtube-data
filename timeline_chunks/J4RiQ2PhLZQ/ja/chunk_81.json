[{"type": "subtitle", "time": 4861.189, "timestamp": "01:21:01", "text": "4,870個のプリズム。購入するには15,000個のプリズムが必要です"}, {"type": "subtitle", "time": 4871.1, "timestamp": "01:21:11", "text": "痛み。"}, {"type": "subtitle", "time": 4873.31, "timestamp": "01:21:13", "text": "[音楽]"}, {"type": "subtitle", "time": 4876.229, "timestamp": "01:21:16", "text": "えっと、他に何かありますか？変化が必要だ"}, {"type": "subtitle", "time": 4877.55, "timestamp": "01:21:17", "text": "開花"}, {"type": "subtitle", "time": 4881.59, "timestamp": "01:21:21", "text": "正しいこと、そして王国の友。"}, {"type": "subtitle", "time": 4883.149, "timestamp": "01:21:23", "text": "そうですね、次は"}, {"type": "subtitle", "time": 4886.99, "timestamp": "01:21:26", "text": "寄付金はこれに使われます"}, {"type": "subtitle", "time": 4890.35, "timestamp": "01:21:30", "text": "ええと、おそらく私たちは変更します"}, {"type": "subtitle", "time": 4892.79, "timestamp": "01:21:32", "text": "床材。何か方法がありますか？"}, {"type": "subtitle", "time": 4895.35, "timestamp": "01:21:35", "text": "プリズム？ダイヤモンドを使って"}, {"type": "subtitle", "time": 4901.43, "timestamp": "01:21:41", "text": "あなたは寄付をする。えっと、もしあなたが"}, {"type": "subtitle", "time": 4903.83, "timestamp": "01:21:43", "text": "えっと、毎日の寄付のことですが、更新できます。"}, {"type": "subtitle", "time": 4906.79, "timestamp": "01:21:46", "text": "しかし、私はそうしない方が良いと言いたい。"}, {"type": "subtitle", "time": 4912.91, "timestamp": "01:21:52", "text": "[音楽]"}, {"type": "subtitle", "time": 4917.03, "timestamp": "01:21:57", "text": "矢印、そして今これを置くことができます"}]
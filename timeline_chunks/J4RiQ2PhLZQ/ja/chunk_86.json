[{"type": "subtitle", "time": 5164.99, "timestamp": "01:26:04", "text": "いいね。"}, {"type": "subtitle", "time": 5167.669, "timestamp": "01:26:07", "text": "ああ、それで庭が見つかったんですね。"}, {"type": "subtitle", "time": 5171.28, "timestamp": "01:26:11", "text": "はい、その時、庭が見つかりました。"}, {"type": "subtitle", "time": 5181.87, "timestamp": "01:26:21", "text": "香りに焦点を当てる。私は気にしない"}, {"type": "subtitle", "time": 5185.18, "timestamp": "01:26:25", "text": "それ。では"}, {"type": "subtitle", "time": 5188.11, "timestamp": "01:26:28", "text": "[音楽]"}, {"type": "subtitle", "time": 5196.03, "timestamp": "01:26:36", "text": "オークション？ああ、私は"}, {"type": "subtitle", "time": 5205.91, "timestamp": "01:26:45", "text": "けれど。ああ、ロスは積極的に"}, {"type": "subtitle", "time": 5216.91, "timestamp": "01:26:56", "text": "1つ。こんにちは。ということで、イベントです。見てみましょう。さあ"}, {"type": "subtitle", "time": 5218.86, "timestamp": "01:26:58", "text": "見る。私たちは"}]
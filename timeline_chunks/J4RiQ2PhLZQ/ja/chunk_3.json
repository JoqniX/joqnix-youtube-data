[{"type": "subtitle", "time": 181.75, "timestamp": "00:03:01", "text": "はい。はい。はい。はい。はい。わかった。する"}, {"type": "subtitle", "time": 183.869, "timestamp": "00:03:03", "text": "他のものも同様"}, {"type": "subtitle", "time": 186.309, "timestamp": "00:03:06", "text": "側。それは、"}, {"type": "subtitle", "time": 188.91, "timestamp": "00:03:08", "text": "右のように"}, {"type": "subtitle", "time": 198.149, "timestamp": "00:03:18", "text": "最終的には、何かを作る必要があります"}, {"type": "subtitle", "time": 199.47, "timestamp": "00:03:19", "text": "のように"}, {"type": "subtitle", "time": 202.47, "timestamp": "00:03:22", "text": "これ。直角。うん。うん。あなたは"}, {"type": "subtitle", "time": 203.91, "timestamp": "00:03:23", "text": "了解しました。君は理解し始めているね。あなたは"}, {"type": "subtitle", "time": 206.99, "timestamp": "00:03:26", "text": "片側。もう一つの側面"}, {"type": "subtitle", "time": 218.47, "timestamp": "00:03:38", "text": "はい。ああ、折りたたむことができますよ。あなたはできる"}, {"type": "subtitle", "time": 221.67000000000002, "timestamp": "00:03:41", "text": "折りたたんで、押して、"}, {"type": "subtitle", "time": 223.63, "timestamp": "00:03:43", "text": "地面"}, {"type": "subtitle", "time": 226.47, "timestamp": "00:03:46", "text": "ええ、そうです。それが終わったら、それを"}]
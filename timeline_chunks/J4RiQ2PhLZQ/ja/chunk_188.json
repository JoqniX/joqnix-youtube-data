[{"type": "subtitle", "time": 11280.79, "timestamp": "03:08:00", "text": "あなたに必要な強さ。こんにちは。ええと、完了しました"}, {"type": "subtitle", "time": 11283.23, "timestamp": "03:08:03", "text": "それ。待って、1つ"}, {"type": "subtitle", "time": 11285.59, "timestamp": "03:08:05", "text": "Zについてさらに言及。あなたはできるかもしれません"}, {"type": "subtitle", "time": 11291.29, "timestamp": "03:08:11", "text": "薬。"}, {"type": "subtitle", "time": 11293.389, "timestamp": "03:08:13", "text": "[音楽]"}, {"type": "subtitle", "time": 11296.19, "timestamp": "03:08:16", "text": "えっと、見てみてください"}, {"type": "subtitle", "time": 11300.03, "timestamp": "03:08:20", "text": "その周り。ああ、私たちは見なければなりません"}, {"type": "subtitle", "time": 11314.23, "timestamp": "03:08:34", "text": "ナルケインは賢者のように見える"}, {"type": "subtitle", "time": 11321.03, "timestamp": "03:08:41", "text": "それらは伝説の宝石と呼ばれている。ああ、私たちは"}, {"type": "subtitle", "time": 11324.75, "timestamp": "03:08:44", "text": "これで宝石が使えるようになりました。わあ、年長者"}, {"type": "subtitle", "time": 11326.95, "timestamp": "03:08:46", "text": "亀裂が生じるとき、"}, {"type": "subtitle", "time": 11329.63, "timestamp": "03:08:49", "text": "年長者か何か。私は年長者を覚えています"}, {"type": "subtitle", "time": 11332.63, "timestamp": "03:08:52", "text": "リングを鳴らしましたが、私たちは長老のところに戻っていません"}, {"type": "subtitle", "time": 11335.429, "timestamp": "03:08:55", "text": "しばらくしてから電話してください。では、ストリームを投稿します"}, {"type": "subtitle", "time": 11338.55, "timestamp": "03:08:58", "text": "来週のために。えっと、エルダーリングを置きます"}]
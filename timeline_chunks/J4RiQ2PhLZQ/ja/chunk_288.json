[{"type": "subtitle", "time": 17290.31, "timestamp": "04:48:10", "text": "ビート。そして私はトラックのようにこれをしません"}, {"type": "subtitle", "time": 17296.788, "timestamp": "04:48:16", "text": "そうではない。うん。待って、待って、待って。いいえ、"}, {"type": "subtitle", "time": 17299.628, "timestamp": "04:48:19", "text": "パパのところに行かないで。クマ。滞在する。滞在する。"}, {"type": "subtitle", "time": 17301.638, "timestamp": "04:48:21", "text": "滞在する。 はい。 P. ストーリーをさらに進める"}, {"type": "subtitle", "time": 17304.798, "timestamp": "04:48:24", "text": "はい。 P. ストーリーをさらに進める あなた。"}, {"type": "subtitle", "time": 17305.638, "timestamp": "04:48:25", "text": "あなた。 うん。うん。レミー、君だと思うよ"}, {"type": "subtitle", "time": 17308.638, "timestamp": "04:48:28", "text": "うん。うん。レミー、君だと思うよ さらに進歩した。さらに遠く。うん。"}, {"type": "subtitle", "time": 17312.68, "timestamp": "04:48:32", "text": "さらに進歩した。さらに遠く。うん。 待って、私たちは同じレベルです、"}, {"type": "subtitle", "time": 17321.75, "timestamp": "04:48:41", "text": "右？レメ　ああ、あなたは44歳なんですね。ああ、そうです。私"}, {"type": "subtitle", "time": 17323.708, "timestamp": "04:48:43", "text": "ストーリークエストを長い間やっていなかった"}, {"type": "subtitle", "time": 17327.27, "timestamp": "04:48:47", "text": "時間。ストーリークエストを中断しました"}, {"type": "subtitle", "time": 17332.07, "timestamp": "04:48:52", "text": "えっと、レベル36か何か。私はそれを止めた"}, {"type": "subtitle", "time": 17335.31, "timestamp": "04:48:55", "text": "それ以来。私は触りもしなかった"}, {"type": "subtitle", "time": 17337.23, "timestamp": "04:48:57", "text": "それ。今私は"}]
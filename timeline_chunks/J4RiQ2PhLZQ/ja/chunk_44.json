[{"type": "subtitle", "time": 2669.829, "timestamp": "00:44:29", "text": "H. ああ、なんてことだ。今は正常に動作しています。ああ、神様。"}, {"type": "subtitle", "time": 2671.589, "timestamp": "00:44:31", "text": "何が起こったのかはわからないが、"}, {"type": "subtitle", "time": 2676.55, "timestamp": "00:44:36", "text": "いや、これはなかった。今すぐコメントしよう。うん。"}, {"type": "subtitle", "time": 2684.99, "timestamp": "00:44:44", "text": "上。忘れた。私はただ"}, {"type": "subtitle", "time": 2688.109, "timestamp": "00:44:48", "text": "えっと、目薬をさして、"}, {"type": "subtitle", "time": 2691.43, "timestamp": "00:44:51", "text": "ちょっと目を閉じて"}]
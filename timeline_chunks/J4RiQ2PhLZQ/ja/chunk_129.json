[{"type": "subtitle", "time": 7740.629, "timestamp": "02:09:00", "text": "えっと、ちょっと待ってください。これは何だと思いますか？"}, {"type": "subtitle", "time": 7743.629, "timestamp": "02:09:03", "text": "今日の最初のスキル。請求"}, {"type": "subtitle", "time": 7756.47, "timestamp": "02:09:16", "text": "まばたき？ナギー、待って。これは何ですか？"}, {"type": "subtitle", "time": 7757.87, "timestamp": "02:09:17", "text": "何が"}, {"type": "subtitle", "time": 7760.03, "timestamp": "02:09:20", "text": "これ？"}, {"type": "subtitle", "time": 7762.31, "timestamp": "02:09:22", "text": "戦闘評価を上げて改善する"}, {"type": "subtitle", "time": 7764.39, "timestamp": "02:09:24", "text": "あなたの過負荷努力と現在の"}, {"type": "subtitle", "time": 7767.669, "timestamp": "02:09:27", "text": "戦闘。ああ、わかりました。バトルパスガイド"}, {"type": "subtitle", "time": 7770.03, "timestamp": "02:09:30", "text": "請求"}, {"type": "subtitle", "time": 7774.149, "timestamp": "02:09:34", "text": "それ。これを主張してください。うん。こんにちは。良くないね。"}, {"type": "subtitle", "time": 7776.03, "timestamp": "02:09:36", "text": "元気かい？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 7779.229, "timestamp": "02:09:39", "text": "良い。うん。"}, {"type": "subtitle", "time": 7781.47, "timestamp": "02:09:41", "text": "ハラン。請求"}, {"type": "subtitle", "time": 7784.709, "timestamp": "02:09:44", "text": "これら。わかった。戻ってください。ヌーニのところに戻ってください。"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "ここで何が起こっているのですか？"}, {"type": "subtitle", "time": 7791.39, "timestamp": "02:09:51", "text": "そして、これを実行してください。する"}, {"type": "subtitle", "time": 7793.55, "timestamp": "02:09:53", "text": "これ。"}]
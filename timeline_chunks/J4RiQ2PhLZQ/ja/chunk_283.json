[{"type": "subtitle", "time": 16984.75, "timestamp": "04:43:04", "text": "それ？何？それは何ですか？"}, {"type": "subtitle", "time": 16989.27, "timestamp": "04:43:09", "text": "キヤノン。ナニナニナニ。待って、こっちに来て。"}, {"type": "subtitle", "time": 16992.83, "timestamp": "04:43:12", "text": "ここに来て。ここに来て。さあ、そして"}, {"type": "subtitle", "time": 16995.39, "timestamp": "04:43:15", "text": "ここで"}, {"type": "subtitle", "time": 17003.51, "timestamp": "04:43:23", "text": "写真。夢を見てください。"}, {"type": "subtitle", "time": 17005.868, "timestamp": "04:43:25", "text": "では、"}, {"type": "subtitle", "time": 17014.59, "timestamp": "04:43:34", "text": "えっと"}, {"type": "subtitle", "time": 17017.43, "timestamp": "04:43:37", "text": "待って。ああ、大砲みたいなのもできるよ。"}, {"type": "subtitle", "time": 17020.59, "timestamp": "04:43:40", "text": "待って、待って。私は立ちます"}, {"type": "subtitle", "time": 17023.67, "timestamp": "04:43:43", "text": "ここ。大砲のことをしたら"}, {"type": "subtitle", "time": 17026.11, "timestamp": "04:43:46", "text": "インスタントテイク"}]
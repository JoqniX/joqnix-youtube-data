[{"type": "subtitle", "time": 13381.309, "timestamp": "03:43:01", "text": "おお。待って。全部理解できた。"}, {"type": "subtitle", "time": 13383.55, "timestamp": "03:43:03", "text": "おお。"}, {"type": "subtitle", "time": 13386.19, "timestamp": "03:43:06", "text": "くそ。チケット20枚。"}, {"type": "subtitle", "time": 13399.189, "timestamp": "03:43:19", "text": "ああ、ミントマウンドとディープスカイを手に入れたよ。おお、"}, {"type": "subtitle", "time": 13401.95, "timestamp": "03:43:21", "text": "ニース。手に入れた"}, {"type": "subtitle", "time": 13405.269, "timestamp": "03:43:25", "text": "15. これらをどうするのか分かりません"}, {"type": "subtitle", "time": 13407.95, "timestamp": "03:43:27", "text": "金とバッジ。私はただ"}, {"type": "subtitle", "time": 13412.03, "timestamp": "03:43:32", "text": "ヒューズを1つ使用してください"}, {"type": "subtitle", "time": 13422.7, "timestamp": "03:43:42", "text": "そして私は"}, {"type": "subtitle", "time": 13425.229, "timestamp": "03:43:45", "text": "[音楽]"}, {"type": "subtitle", "time": 13429.75, "timestamp": "03:43:49", "text": "うーん、待って、キャラクタースキルを試してください。欲しい"}, {"type": "subtitle", "time": 13432.71, "timestamp": "03:43:52", "text": "でも、3つ目のスキルを習得するためには。私はしません"}]
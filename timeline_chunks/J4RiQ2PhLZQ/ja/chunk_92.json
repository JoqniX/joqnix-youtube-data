[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "死んだ。よし。それは、私たちが手に入れたものです"}, {"type": "subtitle", "time": 5524.03, "timestamp": "01:32:04", "text": "３回のチャンス。"}, {"type": "subtitle", "time": 5527.91, "timestamp": "01:32:07", "text": "出口。そして今、私たちは"}, {"type": "subtitle", "time": 5530.27, "timestamp": "01:32:10", "text": "スタイルを完成させました"}, {"type": "subtitle", "time": 5533.31, "timestamp": "01:32:13", "text": "クエスト。これを主張してください。請求"}, {"type": "subtitle", "time": 5535.31, "timestamp": "01:32:15", "text": "[音楽]"}, {"type": "subtitle", "time": 5539.75, "timestamp": "01:32:19", "text": "これ。ああ、やり遂げましたよ。こんにちは。請求"}, {"type": "subtitle", "time": 5540.99, "timestamp": "01:32:20", "text": "それ。"}, {"type": "subtitle", "time": 5544.95, "timestamp": "01:32:24", "text": "終わり。何を手に入れたの？私たちは何を得たのか？"}, {"type": "subtitle", "time": 5546.95, "timestamp": "01:32:26", "text": "材料の入った袋ですよね？それでは、"}, {"type": "subtitle", "time": 5549.07, "timestamp": "01:32:29", "text": "当社の材料"}, {"type": "subtitle", "time": 5552.59, "timestamp": "01:32:32", "text": "ポーチ。はい、卵です。感謝"}, {"type": "subtitle", "time": 5556.91, "timestamp": "01:32:36", "text": "あなた。おやつをもらいました。わかった、"}, {"type": "subtitle", "time": 5559.55, "timestamp": "01:32:39", "text": "良い。私たちは何をしたのか"}, {"type": "subtitle", "time": 5571.43, "timestamp": "01:32:51", "text": "これは一体何ですか？これらはすべて厳選されたもので、"}, {"type": "subtitle", "time": 5574.709, "timestamp": "01:32:54", "text": "右？わかった。よし。そうします。"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "うん。こんにちは、ロバート・ジャクソンさん。見逃した"}, {"type": "subtitle", "time": 5578.95, "timestamp": "01:32:58", "text": "あなた。元気ですか？お元気でお過ごしでしょうか"}]
[{"type": "subtitle", "time": 3061.109, "timestamp": "00:51:01", "text": "まもなく彼を起用します。ない"}, {"type": "subtitle", "time": 3063.829, "timestamp": "00:51:03", "text": "今は、でも少ししたら、終わったら"}, {"type": "subtitle", "time": 3066.309, "timestamp": "00:51:06", "text": "ログインして、すべてのクエストをこなす"}, {"type": "subtitle", "time": 3069.349, "timestamp": "00:51:09", "text": "そして、彼ら全員が。そして私は努力している"}, {"type": "subtitle", "time": 3072.23, "timestamp": "00:51:12", "text": "このゲームを作る"}, {"type": "subtitle", "time": 3076.44, "timestamp": "00:51:16", "text": "魔女は赤い呪文を唱える"}, {"type": "subtitle", "time": 3077.63, "timestamp": "00:51:17", "text": "[音楽]"}, {"type": "subtitle", "time": 3081.109, "timestamp": "00:51:21", "text": "頭。気づいて、必要ない"}, {"type": "subtitle", "time": 3084.069, "timestamp": "00:51:24", "text": "音楽は入っていますか？ああ、忘れてた。ええ、これは"}, {"type": "subtitle", "time": 3086.309, "timestamp": "00:51:26", "text": "なぜアンケートを取る必要があると思ったのか"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "チャットが自動的に"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "アンケートと投票を開始してオフにする"}, {"type": "subtitle", "time": 3096.71, "timestamp": "00:51:36", "text": "あるいは、人々のモデレーターが"}, {"type": "subtitle", "time": 3099.15, "timestamp": "00:51:39", "text": "音楽から離れて"}, {"type": "subtitle", "time": 3102.15, "timestamp": "00:51:42", "text": "あれ。だから、たとえ私があなたを忘れたとしても"}, {"type": "subtitle", "time": 3106.309, "timestamp": "00:51:46", "text": "男ならできる。だから私は「あぁ」と言ったんです"}, {"type": "subtitle", "time": 3108.43, "timestamp": "00:51:48", "text": "私は仕事が必要です"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "システムは現在稼働中です。えっと、できるかどうかわかりません"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "YouTubeの投票システムを使用するが、少なくとも"}, {"type": "subtitle", "time": 3117.67, "timestamp": "00:51:57", "text": "チャットのコメントであれば可能です。全て"}]
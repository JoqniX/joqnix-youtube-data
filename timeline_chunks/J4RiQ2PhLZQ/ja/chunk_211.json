[{"type": "subtitle", "time": 12660.19, "timestamp": "03:31:00", "text": "ああ、違う"}, {"type": "subtitle", "time": 12661.79, "timestamp": "03:31:01", "text": "パスワード。"}, {"type": "subtitle", "time": 12664.55, "timestamp": "03:31:04", "text": "わかった。そして、CPを獲得するために"}, {"type": "subtitle", "time": 12666.87, "timestamp": "03:31:06", "text": "メインクエストを続行する。ええ、それについては"}, {"type": "subtitle", "time": 12669.55, "timestamp": "03:31:09", "text": "あなたがすべきことを教えてあげましょう。"}, {"type": "subtitle", "time": 12672.309, "timestamp": "03:31:12", "text": "えっと、すべての欠点をこのようにします。"}, {"type": "subtitle", "time": 12675.19, "timestamp": "03:31:15", "text": "このようなサブアカウントを作成し、レベルアップさせる。"}, {"type": "subtitle", "time": 12678.389, "timestamp": "03:31:18", "text": "さらに、その過程で。ああ、なぜ私は"}, {"type": "subtitle", "time": 12680.51, "timestamp": "03:31:20", "text": "それ？"}, {"type": "subtitle", "time": 12683.349, "timestamp": "03:31:23", "text": "待って、メールを見せたよ。大丈夫です。その"}, {"type": "subtitle", "time": 12695.469, "timestamp": "03:31:35", "text": "大丈夫。ジョー、何が問題なの？"}, {"type": "subtitle", "time": 12700.79, "timestamp": "03:31:40", "text": "あなた？やめておきます。多分"}, {"type": "subtitle", "time": 12703.67, "timestamp": "03:31:43", "text": "大丈夫です。全部漏らしてしまった。ほとんどの人が"}, {"type": "subtitle", "time": 12711.75, "timestamp": "03:31:51", "text": "気をつけろよ、ジョック。はい、それはプライベートです"}, {"type": "subtitle", "time": 12714.35, "timestamp": "03:31:54", "text": "メール。だから、私は本当に"}, {"type": "subtitle", "time": 12715.71, "timestamp": "03:31:55", "text": "[音楽]"}, {"type": "subtitle", "time": 12718.15, "timestamp": "03:31:58", "text": "注意深い。よし。じゃあ、待って、待って、"}]
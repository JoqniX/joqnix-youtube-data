[{"type": "subtitle", "time": 11760.55, "timestamp": "03:16:00", "text": "エネルギーは非常に強いと思いますが、その強さにもかかわらず"}, {"type": "subtitle", "time": 11764.349, "timestamp": "03:16:04", "text": "難破から逃れることができない"}, {"type": "subtitle", "time": 11766.75, "timestamp": "03:16:06", "text": "大混乱。カップル"}, {"type": "subtitle", "time": 11770.269, "timestamp": "03:16:10", "text": "ロックは素晴らしいフィオナ"}, {"type": "subtitle", "time": 11773.83, "timestamp": "03:16:13", "text": "カオスジェムの柔らかさとは比べ物にならない"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "宝石は混沌の影響により変化した"}, {"type": "subtitle", "time": 11777.99, "timestamp": "03:16:17", "text": "ただし、詳細についてはドキュメントを追加できます"}, {"type": "subtitle", "time": 11779.95, "timestamp": "03:16:19", "text": "力。"}, {"type": "subtitle", "time": 11784.07, "timestamp": "03:16:24", "text": "ああ、これで宝石のチュートリアルが始まるんですね。私"}, {"type": "subtitle", "time": 11787.71, "timestamp": "03:16:27", "text": "すでに宝石を使い始めています"}, {"type": "subtitle", "time": 11790.99, "timestamp": "03:16:30", "text": "けれど。つまり、それしか使えないということです。"}, {"type": "subtitle", "time": 11795.51, "timestamp": "03:16:35", "text": "犯罪者にとって、4つ星武器のようなものだ。"}, {"type": "subtitle", "time": 11811.349, "timestamp": "03:16:51", "text": "えっと、2～5個の宝石を刻印できます"}, {"type": "subtitle", "time": 11812.95, "timestamp": "03:16:52", "text": "スター装備と3つの宝石から6つ"}, {"type": "subtitle", "time": 11814.11, "timestamp": "03:16:54", "text": "星"}]
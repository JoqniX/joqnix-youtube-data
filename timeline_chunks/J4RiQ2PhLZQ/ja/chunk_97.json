[{"type": "subtitle", "time": 5821.669, "timestamp": "01:37:01", "text": "えっと、私は誰も連れて行けません。なぜなら彼らは"}, {"type": "subtitle", "time": 5825.43, "timestamp": "01:37:05", "text": "圧倒的に強い。無料でリフレッシュします。おお、"}, {"type": "subtitle", "time": 5832.67, "timestamp": "01:37:12", "text": "もうやめよう。"}, {"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "[拍手]"}, {"type": "subtitle", "time": 5838.229, "timestamp": "01:37:18", "text": "わかった、それはパスするよ。私が勝った。これは"}, {"type": "subtitle", "time": 5841.95, "timestamp": "01:37:21", "text": "素晴らしい。ニース。"}, {"type": "subtitle", "time": 5844.87, "timestamp": "01:37:24", "text": "続く。次の勝利を保証するわけではありません"}, {"type": "subtitle", "time": 5847.07, "timestamp": "01:37:27", "text": "時間。では、私は行きます"}, {"type": "subtitle", "time": 5850.95, "timestamp": "01:37:30", "text": "これに関しては。彼は4つ星と"}, {"type": "subtitle", "time": 5852.03, "timestamp": "01:37:32", "text": "プラス"}, {"type": "subtitle", "time": 5854.51, "timestamp": "01:37:34", "text": "27歳かもしれない。ああ、"}, {"type": "subtitle", "time": 5858.07, "timestamp": "01:37:38", "text": "神。私は勝つだろうか？分かりません。さあ"}, {"type": "subtitle", "time": 5859.99, "timestamp": "01:37:39", "text": "試す。"}, {"type": "subtitle", "time": 5872.79, "timestamp": "01:37:52", "text": "兵器。この試合を見たい。ああ、"}, {"type": "subtitle", "time": 5874.31, "timestamp": "01:37:54", "text": "彼は亡くなった。大丈夫です。大丈夫です。その"}, {"type": "subtitle", "time": 5876.55, "timestamp": "01:37:56", "text": "大丈夫。君たちならできるよ。君たちは"}]
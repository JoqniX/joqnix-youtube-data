[{"type": "subtitle", "time": 1980.63, "timestamp": "00:33:00", "text": "本を買うべきか、それとも"}, {"type": "subtitle", "time": 1982.95, "timestamp": "00:33:02", "text": "何か撮るべきか、それともプリントアウトするべきでしょうか"}, {"type": "subtitle", "time": 1986.47, "timestamp": "00:33:06", "text": "ウェブから印刷用に出力"}, {"type": "subtitle", "time": 1988.549, "timestamp": "00:33:08", "text": "アニメキャラクターが何かを着色して"}, {"type": "subtitle", "time": 1993.11, "timestamp": "00:33:13", "text": "色を塗ったり、何かをしたり、"}, {"type": "subtitle", "time": 1995.549, "timestamp": "00:33:15", "text": "マンデラ図か何かを着色する。私はしません"}, {"type": "subtitle", "time": 1998.63, "timestamp": "00:33:18", "text": "知る。ご意見があればお聞かせください"}, {"type": "subtitle", "time": 2001.75, "timestamp": "00:33:21", "text": "可能であれば、Discordサーバーに参加してください。それは"}, {"type": "subtitle", "time": 2005.43, "timestamp": "00:33:25", "text": "それはとても大きな意味を持つだろう。こんにちは、そして"}, {"type": "subtitle", "time": 2009.63, "timestamp": "00:33:29", "text": "チャンネル登録とサポートをお忘れなく"}, {"type": "subtitle", "time": 2011.99, "timestamp": "00:33:31", "text": "ズカマ。彼女のつながりは"}, {"type": "subtitle", "time": 2015.47, "timestamp": "00:33:35", "text": "説明。はい、もちろんです。忘れないでください"}, {"type": "subtitle", "time": 2019.669, "timestamp": "00:33:39", "text": "購読する。紙を元に戻します。"}, {"type": "subtitle", "time": 2022.31, "timestamp": "00:33:42", "text": "そして、私は自分の2つを使うことができてよかった"}, {"type": "subtitle", "time": 2025.389, "timestamp": "00:33:45", "text": "好きな色。それは紫で"}, {"type": "subtitle", "time": 2027.789, "timestamp": "00:33:47", "text": "光"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "青。できたらいいのに。あ、待って。ありました"}, {"type": "subtitle", "time": 2033.75, "timestamp": "00:33:53", "text": "ピンク色。ピンク色だったらよかったのに。ああ、私は"}]
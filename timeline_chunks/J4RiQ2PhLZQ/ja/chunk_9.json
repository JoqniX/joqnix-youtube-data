[{"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "私はZaddyの配信をしようと思っていました。"}, {"type": "subtitle", "time": 548.87, "timestamp": "00:09:08", "text": "わかりました、つまり基本的に私は"}, {"type": "subtitle", "time": 552.87, "timestamp": "00:09:12", "text": "昔は冗談で、自分はZaddyだと言っていた。"}, {"type": "subtitle", "time": 565.75, "timestamp": "00:09:25", "text": "ああ、パパ。私のパパ、Z。オーケー。わかった。だから私は"}, {"type": "subtitle", "time": 568.23, "timestamp": "00:09:28", "text": "口ひげを生やすつもりだったし、"}, {"type": "subtitle", "time": 572.55, "timestamp": "00:09:32", "text": "私の子供のような人に恋愛のアドバイスをしてください。おお、"}, {"type": "subtitle", "time": 575.03, "timestamp": "00:09:35", "text": "でも私はそれについてすごく緊張していたので、"}, {"type": "subtitle", "time": 582.07, "timestamp": "00:09:42", "text": "あなたは両方の角を持つことができます、私は"}, {"type": "subtitle", "time": 584.87, "timestamp": "00:09:44", "text": "表示中。"}, {"type": "subtitle", "time": 587.11, "timestamp": "00:09:47", "text": "そこで、代わりにアンダーテールの文字列を作りました"}, {"type": "subtitle", "time": 589.509, "timestamp": "00:09:49", "text": "その日。"}, {"type": "subtitle", "time": 591.829, "timestamp": "00:09:51", "text": "ああ、アンダーテール。私はしていません。あなたはそうしました"}, {"type": "subtitle", "time": 594.63, "timestamp": "00:09:54", "text": "Undertaleをプレイすることを勧めてください"}, {"type": "subtitle", "time": 597.11, "timestamp": "00:09:57", "text": "覚えて。本当に良いです。あなたがすべき"}]
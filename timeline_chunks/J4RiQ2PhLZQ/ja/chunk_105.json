[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "おもちゃか、星3つのクリスタルが2つあるようなもの"}, {"type": "subtitle", "time": 6305.03, "timestamp": "01:45:05", "text": "透明な結晶がHPを与えます"}, {"type": "subtitle", "time": 6307.31, "timestamp": "01:45:07", "text": "攻撃力とHP"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "P. そして、もうこれ以上は持っていないと思います"}, {"type": "subtitle", "time": 6312.83, "timestamp": "01:45:12", "text": "おもちゃ"}, {"type": "subtitle", "time": 6315.75, "timestamp": "01:45:15", "text": "与える。ええ、私は持っていないと思います"}, {"type": "subtitle", "time": 6318.709, "timestamp": "01:45:18", "text": "もっとおもちゃをあげたい。はい、持っていません"}, {"type": "subtitle", "time": 6322.35, "timestamp": "01:45:22", "text": "他にあげるおもちゃはありますか？"}, {"type": "subtitle", "time": 6325.99, "timestamp": "01:45:25", "text": "こんにちは。これは何ですか？リリース。あなたはできる"}, {"type": "subtitle", "time": 6329.189, "timestamp": "01:45:29", "text": "あなたが飼っている家族を野生に放しなさい。"}, {"type": "subtitle", "time": 6331.709, "timestamp": "01:45:31", "text": "ああ、それは本当に"}, {"type": "subtitle", "time": 6334.39, "timestamp": "01:45:34", "text": "いいね。ご家族の幸せをお祈りします"}, {"type": "subtitle", "time": 6335.37, "timestamp": "01:45:35", "text": "出発前に。"}, {"type": "subtitle", "time": 6336.83, "timestamp": "01:45:36", "text": "[音楽]"}, {"type": "subtitle", "time": 6339.91, "timestamp": "01:45:39", "text": "うんうん。そうすれば、売るための豆が手に入ります。"}, {"type": "subtitle", "time": 6342.709, "timestamp": "01:45:42", "text": "売ったりもできるよ。できますか"}, {"type": "subtitle", "time": 6351.95, "timestamp": "01:45:51", "text": "[音楽]"}]
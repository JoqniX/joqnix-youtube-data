[{"type": "subtitle", "time": 6061.709, "timestamp": "01:41:01", "text": "暗い。そしてあなたのために、私は"}, {"type": "subtitle", "time": 6069.99, "timestamp": "01:41:09", "text": "私には11個ありますよね？では、"}, {"type": "subtitle", "time": 6072.709, "timestamp": "01:41:12", "text": "青い6つ"}, {"type": "subtitle", "time": 6073.79, "timestamp": "01:41:13", "text": "いや"}, {"type": "subtitle", "time": 6079.56, "timestamp": "01:41:19", "text": "1つは緑地で、残りは暗い地になります。"}, {"type": "subtitle", "time": 6081.99, "timestamp": "01:41:21", "text": "[音楽]"}, {"type": "subtitle", "time": 6083.55, "timestamp": "01:41:23", "text": "よし、これでいいだろう"}, {"type": "subtitle", "time": 6086.51, "timestamp": "01:41:26", "text": "それ。戻る"}, {"type": "subtitle", "time": 6088.27, "timestamp": "01:41:28", "text": "家族。"}, {"type": "subtitle", "time": 6103.629, "timestamp": "01:41:43", "text": "まだ。"}, {"type": "subtitle", "time": 6112.83, "timestamp": "01:41:52", "text": "大きなものを1つ与えることができます"}, {"type": "subtitle", "time": 6118.75, "timestamp": "01:41:58", "text": "こんにちは、そして強化"}]
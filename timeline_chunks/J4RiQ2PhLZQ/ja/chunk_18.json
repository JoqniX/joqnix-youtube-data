[{"type": "subtitle", "time": 1082.47, "timestamp": "00:18:02", "text": "わからない。あなたはただ手に入れるべきです"}, {"type": "subtitle", "time": 1084.95, "timestamp": "00:18:04", "text": "ヌテラを少し塗って、イチゴを乗せる"}, {"type": "subtitle", "time": 1087.669, "timestamp": "00:18:07", "text": "その中に。そうやって分かるんだよ。ありがとう"}, {"type": "subtitle", "time": 1090.47, "timestamp": "00:18:10", "text": "私のことを覚えていてくれてありがとう。私はヌテラを持っています"}, {"type": "subtitle", "time": 1093.95, "timestamp": "00:18:13", "text": "冷蔵庫。私はそれを食べるつもりです"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "完全に。私は、"}, {"type": "subtitle", "time": 1100.07, "timestamp": "00:18:20", "text": "何かを忘れている。それは何か"}, {"type": "subtitle", "time": 1104.31, "timestamp": "00:18:24", "text": "私は食べることに慣れています。私は食べるのが大好きです。"}, {"type": "subtitle", "time": 1107.909, "timestamp": "00:18:27", "text": "えっと、あなたはベーキング配信もやってるんですか？なぜしないのか"}, {"type": "subtitle", "time": 1110.23, "timestamp": "00:18:30", "text": "ベーキングストリームではなく、"}, {"type": "subtitle", "time": 1113.75, "timestamp": "00:18:33", "text": "お菓子作りの動画？ほら、"}, {"type": "subtitle", "time": 1117.029, "timestamp": "00:18:37", "text": "今日、兄と私は、えーっと"}, {"type": "subtitle", "time": 1120.31, "timestamp": "00:18:40", "text": "私はこのユニークなものを手に入れるために彼に200ルピーを支払いました"}, {"type": "subtitle", "time": 1124.87, "timestamp": "00:18:44", "text": "オレオの味。オレオコーラ。わかった。"}, {"type": "subtitle", "time": 1127.23, "timestamp": "00:18:47", "text": "コカ・コーラだけど、オレオ味。そしてそれは"}, {"type": "subtitle", "time": 1130.63, "timestamp": "00:18:50", "text": "驚くほどキャラメル味がしたが、それでも"}, {"type": "subtitle", "time": 1134.87, "timestamp": "00:18:54", "text": "同時にコカ・コーラのように。良かったよ。"}, {"type": "subtitle", "time": 1138.63, "timestamp": "00:18:58", "text": "だから僕と兄のビクは"}]
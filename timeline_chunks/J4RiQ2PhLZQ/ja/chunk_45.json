[{"type": "subtitle", "time": 2701.03, "timestamp": "00:45:01", "text": "前回目が覚めたのは午後5時頃だった。私"}, {"type": "subtitle", "time": 2704.63, "timestamp": "00:45:04", "text": "ただ私のものを置いただけです私はただ置かなかったままにしました"}, {"type": "subtitle", "time": 2707.43, "timestamp": "00:45:07", "text": "目薬をさそうとしただけなのに"}, {"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "目を閉じて、そう言って、私は眠った"}, {"type": "subtitle", "time": 2712.09, "timestamp": "00:45:12", "text": "オフのように"}, {"type": "subtitle", "time": 2715.069, "timestamp": "00:45:15", "text": "[音楽]"}, {"type": "subtitle", "time": 2719.55, "timestamp": "00:45:19", "text": "ああ、そうだね。こんにちは、みんな。今日は"}, {"type": "subtitle", "time": 2722.51, "timestamp": "00:45:22", "text": "プレイ中。はい。私は始めもしなかった"}, {"type": "subtitle", "time": 2740.109, "timestamp": "00:45:40", "text": "遅い。こんにちは。ということで、今日は、えーと、"}, {"type": "subtitle", "time": 2743.63, "timestamp": "00:45:43", "text": "プレイ中。それで、私はキングダムをやります"}, {"type": "subtitle", "time": 2746.67, "timestamp": "00:45:46", "text": "もの。やるべきことがたくさんある。私"}, {"type": "subtitle", "time": 2750.39, "timestamp": "00:45:50", "text": "昨日はログインしていませんでした。そうなんです、"}, {"type": "subtitle", "time": 2752.27, "timestamp": "00:45:52", "text": "たくさんあります"}]
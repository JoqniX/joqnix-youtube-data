[{"type": "subtitle", "time": 7806.95, "timestamp": "02:10:06", "text": "何をしているの？何も得られなかった。そうするべきです。"}, {"type": "subtitle", "time": 7809.149, "timestamp": "02:10:09", "text": "いいえ、そうすべきではありません"}, {"type": "subtitle", "time": 7812.39, "timestamp": "02:10:12", "text": "えっと、低レベルのモンスターを攻撃するみたいな感じ。その代わり、"}, {"type": "subtitle", "time": 7814.75, "timestamp": "02:10:14", "text": "クエストをこなすだけです。それが主な"}, {"type": "subtitle", "time": 7817.669, "timestamp": "02:10:17", "text": "ライト。私はレベル21です。それは良いことです"}, {"type": "subtitle", "time": 7821.55, "timestamp": "02:10:21", "text": "もの。また、私は"}, {"type": "subtitle", "time": 7824.43, "timestamp": "02:10:24", "text": "私は持っていたと思います"}, {"type": "subtitle", "time": 7827.83, "timestamp": "02:10:27", "text": "何か。えっと、ちょっと確認させてください。私"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "えっと、私が作ったものみたいなの"}, {"type": "subtitle", "time": 7835.189, "timestamp": "02:10:35", "text": "このゲームって何でしたっけ？ディアブロ。はい、私は"}, {"type": "subtitle", "time": 7838.27, "timestamp": "02:10:38", "text": "何か作ったと思います"}, {"type": "subtitle", "time": 7840.95, "timestamp": "02:10:40", "text": "ディアブロ。見つけられればの話だが。私はしませんでした"}, {"type": "subtitle", "time": 7842.589, "timestamp": "02:10:42", "text": "作る"}, {"type": "subtitle", "time": 7847.109, "timestamp": "02:10:47", "text": "何でも。はぁ？でもプリセットは作ったことがない"}, {"type": "subtitle", "time": 7849.31, "timestamp": "02:10:49", "text": "のために"}, {"type": "subtitle", "time": 7852.35, "timestamp": "02:10:52", "text": "ディアブロ。はぁ？だった"}]
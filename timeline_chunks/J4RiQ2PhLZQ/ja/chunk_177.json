[{"type": "subtitle", "time": 10621.03, "timestamp": "02:57:01", "text": "報酬を逃さないように"}, {"type": "subtitle", "time": 10623.67, "timestamp": "02:57:03", "text": "もの。ものすごく速くなくてはならない。そしてこれは"}, {"type": "subtitle", "time": 10627.03, "timestamp": "02:57:07", "text": "電話では難しい。私は死んだ"}, {"type": "subtitle", "time": 10632.91, "timestamp": "02:57:12", "text": "神よ、私のストリームを"}, {"type": "subtitle", "time": 10635.79, "timestamp": "02:57:15", "text": "狙撃。ナニ"}, {"type": "subtitle", "time": 10641.07, "timestamp": "02:57:21", "text": "なに。えっと、電話に出てる？待って、レイエは"}, {"type": "subtitle", "time": 10654.59, "timestamp": "02:57:34", "text": "ええ、そうです。する"}, {"type": "subtitle", "time": 10664.389, "timestamp": "02:57:44", "text": "悪い。うん。こんにちは、ハニー。こんにちは。調子はどうですか"}, {"type": "subtitle", "time": 10667.59, "timestamp": "02:57:47", "text": "バカなハニーが何をしているの？元気ですか？はぁ？あなた"}, {"type": "subtitle", "time": 10669.309, "timestamp": "02:57:49", "text": "私がどれだけ"}, {"type": "subtitle", "time": 10673.67, "timestamp": "02:57:53", "text": "死んだ？これは皆にとっての苦痛だ。そしてボス"}]
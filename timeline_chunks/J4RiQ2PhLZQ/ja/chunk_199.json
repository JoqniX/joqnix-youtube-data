[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "魔法とは"}, {"type": "subtitle", "time": 11945.349, "timestamp": "03:19:05", "text": "本当に良い。私は、"}, {"type": "subtitle", "time": 11948.59, "timestamp": "03:19:08", "text": "たくさん頑張って手に入れる"}, {"type": "subtitle", "time": 11952.87, "timestamp": "03:19:12", "text": "そこには。待って、ショーンが持っていると思うか、"}, {"type": "subtitle", "time": 11956.03, "timestamp": "03:19:16", "text": "何か。暗い色の人を見た"}, {"type": "subtitle", "time": 11959.75, "timestamp": "03:19:19", "text": "魔法。誰だったか忘れてしまった。ええ、彼はそうします"}, {"type": "subtitle", "time": 11963.51, "timestamp": "03:19:23", "text": "それ。見てください、この星々を。彼はとても"}, {"type": "subtitle", "time": 11969.83, "timestamp": "03:19:29", "text": "わかった。ええ、そうですね。昨日私は見た"}, {"type": "subtitle", "time": 11979.11, "timestamp": "03:19:39", "text": "何かが起こり、彼らは暗闇を解き放たなければならなかった"}, {"type": "subtitle", "time": 11980.95, "timestamp": "03:19:40", "text": "彼らの武器には魔法や特殊効果が備わっている。私は"}, {"type": "subtitle", "time": 11982.429, "timestamp": "03:19:42", "text": "一体何なんだ"}, {"type": "subtitle", "time": 11984.79, "timestamp": "03:19:44", "text": "あの闇の魔法？ナニ"}, {"type": "subtitle", "time": 11990.59, "timestamp": "03:19:50", "text": "なに。"}, {"type": "subtitle", "time": 11993.87, "timestamp": "03:19:53", "text": "うん。そして私たちはこれを家族で行うことができます"}, {"type": "subtitle", "time": 11996.93, "timestamp": "03:19:56", "text": "1つ。うん。私たちならできる。"}]
[{"type": "subtitle", "time": 11161.07, "timestamp": "03:06:01", "text": "リスト。待機計画を立ててください。中止ではありません。計画する"}, {"type": "subtitle", "time": 11164.71, "timestamp": "03:06:04", "text": "時計。そう、アニメは1つだけ。どうやって"}, {"type": "subtitle", "time": 11168.99, "timestamp": "03:06:08", "text": "エピソード数は？待って、それはただの映画だ、"}, {"type": "subtitle", "time": 11173.55, "timestamp": "03:06:13", "text": "はぁ？アニメがあると思った"}, {"type": "subtitle", "time": 11177.309, "timestamp": "03:06:17", "text": "シリーズ。これは何ですか？何"}, {"type": "subtitle", "time": 11191.309, "timestamp": "03:06:31", "text": "これ？ああ、来る"}, {"type": "subtitle", "time": 11212.07, "timestamp": "03:06:52", "text": "店。そして私は、"}, {"type": "subtitle", "time": 11215.75, "timestamp": "03:06:55", "text": "えーとディアブロ、なぜなら私たちは"}, {"type": "subtitle", "time": 11218.389, "timestamp": "03:06:58", "text": "私たちは、えーと、これをやるんですよね？"}]
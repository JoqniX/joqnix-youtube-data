[{"type": "subtitle", "time": 18374.948, "timestamp": "05:06:14", "text": "プリン。私はプリンが大好きです。"}, {"type": "subtitle", "time": 18377.91, "timestamp": "05:06:17", "text": "母はいつもプリンを作ってくれた。卵"}, {"type": "subtitle", "time": 18379.628, "timestamp": "05:06:19", "text": "プリン"}, {"type": "subtitle", "time": 18386.708, "timestamp": "05:06:26", "text": "いつも、お客さんがいるときはいつでも、"}, {"type": "subtitle", "time": 18389.15, "timestamp": "05:06:29", "text": "いつも"}, {"type": "subtitle", "time": 18392.948, "timestamp": "05:06:32", "text": "プリン。彼女がそうするように彼女は言う"}, {"type": "subtitle", "time": 18395.91, "timestamp": "05:06:35", "text": "お父さんにバニラエッセンスを買って"}, {"type": "subtitle", "time": 18398.55, "timestamp": "05:06:38", "text": "必要な材料はすべて"}, {"type": "subtitle", "time": 18404.03, "timestamp": "05:06:44", "text": "それを作っている。彼女はいつもそれを作っている。"}]
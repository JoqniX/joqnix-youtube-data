[{"type": "subtitle", "time": 1446.83, "timestamp": "00:24:06", "text": "わかった。その後はどうすればいいですか？"}, {"type": "subtitle", "time": 1480.23, "timestamp": "00:24:40", "text": "GTA 6の前にジョーカーの手。何だって？"}, {"type": "subtitle", "time": 1483.269, "timestamp": "00:24:43", "text": "いいえ、以前に自分の手を撃ったことがあります。"}, {"type": "subtitle", "time": 1485.11, "timestamp": "00:24:45", "text": "私は推測する"}, {"type": "subtitle", "time": 1486.95, "timestamp": "00:24:46", "text": "えっと、それはずいぶん前のことですね。その時"}, {"type": "subtitle", "time": 1489.669, "timestamp": "00:24:49", "text": "私は仮の場所にいた"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "リビング。"}, {"type": "subtitle", "time": 1494.07, "timestamp": "00:24:54", "text": "待って、待って。彼はどうやって鍛えたのか"}, {"type": "subtitle", "time": 1497.19, "timestamp": "00:24:57", "text": "あなたの体も何か？ねえ、私は"}, {"type": "subtitle", "time": 1498.83, "timestamp": "00:24:58", "text": "アタチ。"}]
[{"type": "subtitle", "time": 8469.469, "timestamp": "02:21:09", "text": "私は"}, {"type": "subtitle", "time": 8477.23, "timestamp": "02:21:17", "text": "死んだ。ああ、彼女は本当に亡くなったんだ。"}, {"type": "subtitle", "time": 8494.87, "timestamp": "02:21:34", "text": "誰が？ナニ。ナニ。ズーと話してください。待って、"}, {"type": "subtitle", "time": 8496.389, "timestamp": "02:21:36", "text": "それでおしまい。この中には何もありません"}, {"type": "subtitle", "time": 8497.87, "timestamp": "02:21:37", "text": "ダンジョン"}, {"type": "subtitle", "time": 8502.07, "timestamp": "02:21:42", "text": "もう。隠し宝箱はありません。いいえ、何も。"}]
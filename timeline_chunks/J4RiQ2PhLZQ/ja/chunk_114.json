[{"type": "subtitle", "time": 6846.27, "timestamp": "01:54:06", "text": "する。え、ミミはもう行っちゃったの？彼らは"}, {"type": "subtitle", "time": 6852.31, "timestamp": "01:54:12", "text": "全員で共有？ええ、ミムは去ってしまいました。こんにちは。えっと、それで"}, {"type": "subtitle", "time": 6855.43, "timestamp": "01:54:15", "text": "私たちができることは、迅速に"}, {"type": "subtitle", "time": 6861.79, "timestamp": "01:54:21", "text": "はい、できます"}, {"type": "subtitle", "time": 6868.55, "timestamp": "01:54:28", "text": "解決策。うん。そして私たちはこれをしなければならない、"}, {"type": "subtitle", "time": 6872.03, "timestamp": "01:54:32", "text": "これとこれとこれと"}, {"type": "subtitle", "time": 6881.109, "timestamp": "01:54:41", "text": "征服。えっと、ちょっと遅れてしまいましたが、こんにちは。"}, {"type": "subtitle", "time": 6887.669, "timestamp": "01:54:47", "text": "こんにちは、お元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 6889.589, "timestamp": "01:54:49", "text": "良い。"}, {"type": "subtitle", "time": 6893.229, "timestamp": "01:54:53", "text": "そのためには、我々はそうするだろう。これが必要だ。"}, {"type": "subtitle", "time": 6899.669, "timestamp": "01:54:59", "text": "すべて。それは可能です。すべての"}]
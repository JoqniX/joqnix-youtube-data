[{"type": "subtitle", "time": 9301.75, "timestamp": "02:35:01", "text": "眼鏡。"}, {"type": "subtitle", "time": 9305.389, "timestamp": "02:35:05", "text": "私が選んだ理由は"}, {"type": "subtitle", "time": 9308.469, "timestamp": "02:35:08", "text": "この種のメガネを実際に購入する理由は"}, {"type": "subtitle", "time": 9311.87, "timestamp": "02:35:11", "text": "ハリー・ポッターみたいにこれが大好き"}, {"type": "subtitle", "time": 9314.79, "timestamp": "02:35:14", "text": "ハリー・ポッターのようなシリーズは、"}, {"type": "subtitle", "time": 9317.51, "timestamp": "02:35:17", "text": "丸いメガネですね、私も"}, {"type": "subtitle", "time": 9320.95, "timestamp": "02:35:20", "text": "ヌーニがかけている大きな丸いメガネは"}, {"type": "subtitle", "time": 9324.71, "timestamp": "02:35:24", "text": "私の性格もそうだ。だから私は「待って」って感じだった"}, {"type": "subtitle", "time": 9327.19, "timestamp": "02:35:27", "text": "プラスチックタイプか"}, {"type": "subtitle", "time": 9328.87, "timestamp": "02:35:28", "text": "金属タイプ。だから私は"}, {"type": "subtitle", "time": 9331.91, "timestamp": "02:35:31", "text": "メタリックタイプ、なぜならそれが"}, {"type": "subtitle", "time": 9334.51, "timestamp": "02:35:34", "text": "欲しいメガネがちょうどいいんだけど、ちょっと"}, {"type": "subtitle", "time": 9337.91, "timestamp": "02:35:37", "text": "高い。つまり、どうやら"}, {"type": "subtitle", "time": 9340.71, "timestamp": "02:35:40", "text": "私が買ったこのガラスの保証書"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "それで、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 9352.75, "timestamp": "02:35:52", "text": "それ？店主や"}, {"type": "subtitle", "time": 9357.51, "timestamp": "02:35:57", "text": "眼鏡店、眼鏡店をじっと見つめる。"}]
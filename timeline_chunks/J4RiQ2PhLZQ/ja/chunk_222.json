[{"type": "subtitle", "time": 13320.63, "timestamp": "03:42:00", "text": "実際には、キャップ2個分のキャップです。病気"}, {"type": "subtitle", "time": 13322.75, "timestamp": "03:42:02", "text": "そうしてください、"}, {"type": "subtitle", "time": 13325.389, "timestamp": "03:42:05", "text": "あまりにも。やろう"}, {"type": "subtitle", "time": 13328.51, "timestamp": "03:42:08", "text": "これ。森の魂"}, {"type": "subtitle", "time": 13331.349, "timestamp": "03:42:11", "text": "石。特に何もないけど、うん、"}, {"type": "subtitle", "time": 13338.4, "timestamp": "03:42:18", "text": "ああ、10"}, {"type": "subtitle", "time": 13345.71, "timestamp": "03:42:25", "text": "一部。 10人分"}, {"type": "subtitle", "time": 13348.67, "timestamp": "03:42:28", "text": "また。私は持っている"}, {"type": "subtitle", "time": 13357.03, "timestamp": "03:42:37", "text": "サンストーン。私は78歳です。ねえ、知ってる？私"}, {"type": "subtitle", "time": 13358.91, "timestamp": "03:42:38", "text": "保存します"}, {"type": "subtitle", "time": 13361.63, "timestamp": "03:42:41", "text": "これ。あのね？私は保存します"}, {"type": "subtitle", "time": 13364.87, "timestamp": "03:42:44", "text": "なぜなら、もし良いドロップがあったらどうなるか想像してみて"}, {"type": "subtitle", "time": 13368.71, "timestamp": "03:42:48", "text": "来るよ。その時、私はどうすればいいのでしょうか？いいえ。ええ。"}, {"type": "subtitle", "time": 13370.429, "timestamp": "03:42:50", "text": "最大ヒューズ"}, {"type": "subtitle", "time": 13374.83, "timestamp": "03:42:54", "text": "どれもそんな感じだ。わかったわかったわ"}, {"type": "subtitle", "time": 13376.75, "timestamp": "03:42:56", "text": "98."}]
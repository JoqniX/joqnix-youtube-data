[{"type": "subtitle", "time": 6127.91, "timestamp": "01:42:07", "text": "回。良い。彼は今や力強い存在だ。そして来る"}, {"type": "subtitle", "time": 6131.07, "timestamp": "01:42:11", "text": "戻る。レベルアップ"}, {"type": "subtitle", "time": 6140.75, "timestamp": "01:42:20", "text": "ああ、一つあげよう。"}, {"type": "subtitle", "time": 6143.709, "timestamp": "01:42:23", "text": "良い。私が食事を与えてあげます。心配しないで。"}, {"type": "subtitle", "time": 6148.149, "timestamp": "01:42:28", "text": "いいえ、この小鳥も作りたいのです"}, {"type": "subtitle", "time": 6156.95, "timestamp": "01:42:36", "text": "待って、炎のやつを使ってもいいの？したい"}, {"type": "subtitle", "time": 6163.149, "timestamp": "01:42:43", "text": "それ。"}, {"type": "subtitle", "time": 6171.27, "timestamp": "01:42:51", "text": "そして、価値を持つことが無価値ではないことは分かっています"}, {"type": "subtitle", "time": 6174.47, "timestamp": "01:42:54", "text": "レベルアップする価値がある"}, {"type": "subtitle", "time": 6177.39, "timestamp": "01:42:57", "text": "あなたの評価は星3つです。これはカードです"}, {"type": "subtitle", "time": 6179.79, "timestamp": "01:42:59", "text": "けれど。あなた"}]
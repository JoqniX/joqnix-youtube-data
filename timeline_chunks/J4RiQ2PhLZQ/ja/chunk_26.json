[{"type": "subtitle", "time": 1561.669, "timestamp": "00:26:01", "text": "私の手によって脱皮した。どこにあるかわからない"}, {"type": "subtitle", "time": 1572.47, "timestamp": "00:26:12", "text": "うわっ。どうすればいいですか？ ああ、それは正しいです。おお、"}, {"type": "subtitle", "time": 1579.71, "timestamp": "00:26:19", "text": "わかった。わかった。わかった。私は"}, {"type": "subtitle", "time": 1587.669, "timestamp": "00:26:27", "text": "わかった。蝶のように見える。"}, {"type": "subtitle", "time": 1588.99, "timestamp": "00:26:28", "text": "さあ"}, {"type": "subtitle", "time": 1593.43, "timestamp": "00:26:33", "text": "行く。それは1ですか？うん。"}, {"type": "subtitle", "time": 1595.99, "timestamp": "00:26:35", "text": "火事のようだ。"}, {"type": "subtitle", "time": 1597.71, "timestamp": "00:26:37", "text": "そうなんですか？私はしません"}, {"type": "subtitle", "time": 1601.3, "timestamp": "00:26:41", "text": "知る。この地域。"}, {"type": "subtitle", "time": 1603.909, "timestamp": "00:26:43", "text": "[音楽]"}, {"type": "subtitle", "time": 1607.63, "timestamp": "00:26:47", "text": "よし、この３つを作った"}, {"type": "subtitle", "time": 1610.11, "timestamp": "00:26:50", "text": "もの。"}, {"type": "subtitle", "time": 1615.07, "timestamp": "00:26:55", "text": "よし、みんな、やったぞ。で"}]
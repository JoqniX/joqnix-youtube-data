[{"type": "subtitle", "time": 6781.31, "timestamp": "01:53:01", "text": "私は"}, {"type": "subtitle", "time": 6784.43, "timestamp": "01:53:04", "text": "退屈。私はたくさんのことをやり遂げました"}, {"type": "subtitle", "time": 6787.0, "timestamp": "01:53:07", "text": "日刊紙。私"}, {"type": "subtitle", "time": 6791.47, "timestamp": "01:53:11", "text": "[音楽]"}, {"type": "subtitle", "time": 6795.55, "timestamp": "01:53:15", "text": "不平をいう。他に何か？ああ、見覚えがある"}, {"type": "subtitle", "time": 6799.03, "timestamp": "01:53:19", "text": "アドベンチャー。まだあと1つあります"}, {"type": "subtitle", "time": 6813.43, "timestamp": "01:53:33", "text": "ここ。実際はハイレベル1です。それで、"}, {"type": "subtitle", "time": 6816.27, "timestamp": "01:53:36", "text": "私はそうはしません。代わりに私は"}, {"type": "subtitle", "time": 6818.27, "timestamp": "01:53:38", "text": "する"}, {"type": "subtitle", "time": 6835.709, "timestamp": "01:53:55", "text": "そして、我々は勝利した。それは"}, {"type": "subtitle", "time": 6839.709, "timestamp": "01:53:59", "text": "それ。ほかに何か？えーと、私たちは"}]
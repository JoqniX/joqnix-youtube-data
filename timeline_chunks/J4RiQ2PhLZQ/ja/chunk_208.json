[{"type": "subtitle", "time": 12481.389, "timestamp": "03:28:01", "text": "1時間または30分。それはあなたの"}, {"type": "subtitle", "time": 12485.11, "timestamp": "03:28:05", "text": "スピード。はい。それで、その時私がしたことは"}, {"type": "subtitle", "time": 12487.87, "timestamp": "03:28:07", "text": "私は"}, {"type": "subtitle", "time": 12491.51, "timestamp": "03:28:11", "text": "239. 30は数えないでください。なぜなら私は"}, {"type": "subtitle", "time": 12494.07, "timestamp": "03:28:14", "text": "誤ってダイヤモンドをダンダンボールとして使用してしまう。"}, {"type": "subtitle", "time": 12496.19, "timestamp": "03:28:16", "text": "知りませんでした"}, {"type": "subtitle", "time": 12500.309, "timestamp": "03:28:20", "text": "それ。ええ、私が間違いを犯しました。そうなんです、"}, {"type": "subtitle", "time": 12502.19, "timestamp": "03:28:22", "text": "あなたがすべきこと"}, {"type": "subtitle", "time": 12506.07, "timestamp": "03:28:26", "text": "サブキャラクターをレベル20にすると"}, {"type": "subtitle", "time": 12510.389, "timestamp": "03:28:30", "text": "グレード1をアンロックします。グレード1には"}, {"type": "subtitle", "time": 12516.79, "timestamp": "03:28:36", "text": "さらに、拡張可能なスロットが25個ありますよね？それで"}, {"type": "subtitle", "time": 12520.07, "timestamp": "03:28:40", "text": "つまり、えーと私の卵キューブはどこ？"}, {"type": "subtitle", "time": 12522.389, "timestamp": "03:28:42", "text": "右？自分のキャラクターを確認するにはどうすればいいですか？"}, {"type": "subtitle", "time": 12524.229, "timestamp": "03:28:44", "text": "キャラクター"}, {"type": "subtitle", "time": 12526.59, "timestamp": "03:28:46", "text": "えーとコミュニティ"}, {"type": "subtitle", "time": 12530.309, "timestamp": "03:28:50", "text": "社交？こんにちは。だから私は剣士を"}, {"type": "subtitle", "time": 12534.389, "timestamp": "03:28:54", "text": "クラスは27、エンジニアは22、魔女"}, {"type": "subtitle", "time": 12537.75, "timestamp": "03:28:57", "text": "29歳として。だから、これらすべてが私に次のようなものを与えるでしょう。"}]
[{"type": "subtitle", "time": 4080.91, "timestamp": "01:08:00", "text": "1つ、"}, {"type": "subtitle", "time": 4087.67, "timestamp": "01:08:07", "text": "三つ。 1つ。はい、そうです。私は送りました"}, {"type": "subtitle", "time": 4090.829, "timestamp": "01:08:10", "text": "パーティーの招待状と王国"}, {"type": "subtitle", "time": 4095.99, "timestamp": "01:08:15", "text": "チャタニ。えーと、これは農場ジオラマです"}, {"type": "subtitle", "time": 4097.139, "timestamp": "01:08:17", "text": "あなたの馴染み"}, {"type": "subtitle", "time": 4104.309, "timestamp": "01:08:24", "text": "森。あなたはこれを後で知ることになるでしょう"}, {"type": "subtitle", "time": 4105.87, "timestamp": "01:08:25", "text": "ストーリーを実行する"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "クエスト。農場を建設しなければならない"}, {"type": "subtitle", "time": 4109.07, "timestamp": "01:08:29", "text": "そして"}, {"type": "subtitle", "time": 4111.55, "timestamp": "01:08:31", "text": "もの。そう思う。私は...するだろう"}, {"type": "subtitle", "time": 4114.63, "timestamp": "01:08:34", "text": "考える。ゆっくりと、私たちは"}, {"type": "subtitle", "time": 4121.269, "timestamp": "01:08:41", "text": "はい。そして私はこれを受け取り、"}, {"type": "subtitle", "time": 4123.63, "timestamp": "01:08:43", "text": "自分の持ち物を片付ける。"}]
[{"type": "subtitle", "time": 4625.709, "timestamp": "01:17:05", "text": "かわいい"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "壁。私は青を選びます。はい、青です。"}, {"type": "subtitle", "time": 4632.27, "timestamp": "01:17:12", "text": "オネクシア"}, {"type": "subtitle", "time": 4635.229, "timestamp": "01:17:15", "text": "青。これをどこで買えますか？"}, {"type": "subtitle", "time": 4638.63, "timestamp": "01:17:18", "text": "今この瞬間を無駄にするべきだろうか、それとも無駄にすべきではないだろうか？私はします"}, {"type": "subtitle", "time": 4647.99, "timestamp": "01:17:27", "text": "カメラの調子がどうなっているか分かる"}, {"type": "subtitle", "time": 4657.47, "timestamp": "01:17:37", "text": "知る"}, {"type": "subtitle", "time": 4660.11, "timestamp": "01:17:40", "text": "私のそれは起こっている"}, {"type": "subtitle", "time": 4667.229, "timestamp": "01:17:47", "text": "おい。はぁ？"}, {"type": "subtitle", "time": 4676.43, "timestamp": "01:17:56", "text": "何？これは何ですか？ A"}]
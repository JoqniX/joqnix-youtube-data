[{"type": "subtitle", "time": 17762.11, "timestamp": "04:56:02", "text": "また？これらは何と呼ばれていますか？"}, {"type": "subtitle", "time": 17764.55, "timestamp": "04:56:04", "text": "ひよこ豆。うん、ひよこ豆とか"}, {"type": "subtitle", "time": 17767.59, "timestamp": "04:56:07", "text": "魚。揚げ魚。実は忘れてた"}, {"type": "subtitle", "time": 17769.07, "timestamp": "04:56:09", "text": "魚は何"}, {"type": "subtitle", "time": 17779.628, "timestamp": "04:56:19", "text": "野菜は何ですか？"}, {"type": "subtitle", "time": 17782.788, "timestamp": "04:56:22", "text": "あれ？えっと、この野菜は何ですか？"}, {"type": "subtitle", "time": 17785.83, "timestamp": "04:56:25", "text": "あれ？忘れた。野菜料理だよ。"}, {"type": "subtitle", "time": 17787.23, "timestamp": "04:56:27", "text": "はい。"}, {"type": "subtitle", "time": 17791.52, "timestamp": "04:56:31", "text": "夜。"}, {"type": "subtitle", "time": 17801.87, "timestamp": "04:56:41", "text": "うん。かわいそうなパパ。なんて可愛い名前でしょう。"}, {"type": "subtitle", "time": 17811.868, "timestamp": "04:56:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17815.91, "timestamp": "04:56:55", "text": "推測。何を食べているんですか？はぁ？"}]
[{"type": "subtitle", "time": 10081.23, "timestamp": "02:48:01", "text": "旅行。後で戻ってきます"}, {"type": "subtitle", "time": 10084.71, "timestamp": "02:48:04", "text": "後で。こんにちは、こちらはチャンネル6ですよね？いいえ"}, {"type": "subtitle", "time": 10086.95, "timestamp": "02:48:06", "text": "えっと、ここにはあまり人がいませんが、"}, {"type": "subtitle", "time": 10088.51, "timestamp": "02:48:08", "text": "人々は"}, {"type": "subtitle", "time": 10092.23, "timestamp": "02:48:12", "text": "ここ。えっと、ちょっと待って、チャンネル11。私は"}, {"type": "subtitle", "time": 10093.309, "timestamp": "02:48:13", "text": "チャネル"}, {"type": "subtitle", "time": 10094.99, "timestamp": "02:48:14", "text": "11."}, {"type": "subtitle", "time": 10098.79, "timestamp": "02:48:18", "text": "おお。こんにちは。ええ、そうですね。えっと、フィールドが"}, {"type": "subtitle", "time": 10103.87, "timestamp": "02:48:23", "text": "我々次第だ、我々はそれを打ち負かし、おそらく"}, {"type": "subtitle", "time": 10107.03, "timestamp": "02:48:27", "text": "えーと、これ以上はできません"}, {"type": "subtitle", "time": 10111.19, "timestamp": "02:48:31", "text": "これは、すべての人々が"}, {"type": "subtitle", "time": 10113.309, "timestamp": "02:48:33", "text": "これをプレイする人"}, {"type": "subtitle", "time": 10117.63, "timestamp": "02:48:37", "text": "ゲーム1 1 f は即死のようなもの"}, {"type": "subtitle", "time": 10121.83, "timestamp": "02:48:41", "text": "全てのチャンネル全体。だから、"}, {"type": "subtitle", "time": 10125.429, "timestamp": "02:48:45", "text": "難しいだろうが、"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "えーと、シルバービアードのためにやることができます"}, {"type": "subtitle", "time": 10132.75, "timestamp": "02:48:52", "text": "少なくとも２つだと思います。"}, {"type": "subtitle", "time": 10136.15, "timestamp": "02:48:56", "text": "ゲームが発売された当時"}, {"type": "subtitle", "time": 10138.79, "timestamp": "02:48:58", "text": "5日か4日後くらいに、私たちは"}]
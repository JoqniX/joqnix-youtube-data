[{"type": "subtitle", "time": 11100.91, "timestamp": "03:05:00", "text": "アニメ映画 アニメシリーズ"}, {"type": "subtitle", "time": 11105.23, "timestamp": "03:05:05", "text": "はい、それは、えっと、"}, {"type": "subtitle", "time": 11121.07, "timestamp": "03:05:21", "text": "いいえ、私は"}, {"type": "subtitle", "time": 11133.63, "timestamp": "03:05:33", "text": "いや、あるはずだ。待って、アニメがない"}, {"type": "subtitle", "time": 11136.99, "timestamp": "03:05:36", "text": "待って、アニメがあるよ"}, {"type": "subtitle", "time": 11146.71, "timestamp": "03:05:46", "text": "名前。アニメはありません。えっと、なんていう名前だったっけ？"}, {"type": "subtitle", "time": 11150.11, "timestamp": "03:05:50", "text": "ええ、これです。なぜ表示されなかったのですか？"}, {"type": "subtitle", "time": 11153.429, "timestamp": "03:05:53", "text": "なぜ？ええ、これも付け加えておきます"}, {"type": "subtitle", "time": 11155.87, "timestamp": "03:05:55", "text": "これは私の時計に"}]
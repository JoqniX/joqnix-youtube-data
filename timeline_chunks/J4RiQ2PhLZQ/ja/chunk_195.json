[{"type": "subtitle", "time": 11722.429, "timestamp": "03:15:22", "text": "他に誰が出演するの？準備は完了です。"}, {"type": "subtitle", "time": 11725.71, "timestamp": "03:15:25", "text": "わかった。では、待ってください。"}, {"type": "subtitle", "time": 11736.07, "timestamp": "03:15:36", "text": "これ。私は円を完成させるのが好きだ。"}, {"type": "subtitle", "time": 11739.469, "timestamp": "03:15:39", "text": "それでは、円を締めくくりたいと思います。 1つ"}, {"type": "subtitle", "time": 11742.07, "timestamp": "03:15:42", "text": "星座。そして、この手のものは"}, {"type": "subtitle", "time": 11744.229, "timestamp": "03:15:44", "text": "私が好きなのは、私が慰めだからです"}, {"type": "subtitle", "time": 11754.469, "timestamp": "03:15:54", "text": "エマ、これは全く良くないよ。私は感じる"}]
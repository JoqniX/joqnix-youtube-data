[{"type": "subtitle", "time": 2041.35, "timestamp": "00:34:01", "text": "色。わかった。そして私は配信を終えるべきだ"}, {"type": "subtitle", "time": 2042.75, "timestamp": "00:34:02", "text": "今。"}, {"type": "subtitle", "time": 2047.389, "timestamp": "00:34:07", "text": "それで、先ほども言ったように、試験が近づいています。"}, {"type": "subtitle", "time": 2053.069, "timestamp": "00:34:13", "text": "そしておそらく配信を試してみるつもりです"}, {"type": "subtitle", "time": 2057.31, "timestamp": "00:34:17", "text": "明日。つまり、私は"}, {"type": "subtitle", "time": 2061.43, "timestamp": "00:34:21", "text": "実際、日本語を復習することができます"}, {"type": "subtitle", "time": 2065.109, "timestamp": "00:34:25", "text": "だって試験が近いし、やってみてもいいじゃない？多分"}, {"type": "subtitle", "time": 2066.589, "timestamp": "00:34:26", "text": "それは"}, {"type": "subtitle", "time": 2071.27, "timestamp": "00:34:31", "text": "良いものは良いもののようになるでしょう。ああ、忘れていました。"}, {"type": "subtitle", "time": 2074.389, "timestamp": "00:34:34", "text": "この男、この物。それは"}, {"type": "subtitle", "time": 2077.27, "timestamp": "00:34:37", "text": "良い経験でしたよね？"}, {"type": "subtitle", "time": 2084.47, "timestamp": "00:34:44", "text": "だから、次は気をつけます"}, {"type": "subtitle", "time": 2088.79, "timestamp": "00:34:48", "text": "日本語の次の日本語のレビューまたはいいね"}, {"type": "subtitle", "time": 2092.069, "timestamp": "00:34:52", "text": "学習コース。私の配信をやります"}, {"type": "subtitle", "time": 2094.069, "timestamp": "00:34:54", "text": "ある程度確認しました。うん、やってみるよ"}, {"type": "subtitle", "time": 2096.55, "timestamp": "00:34:56", "text": "明日配信します。オフラインです"}]
[{"type": "subtitle", "time": 362.029, "timestamp": "00:06:02", "text": "すると誰かが「これは簡単だ」と言った。"}, {"type": "subtitle", "time": 371.749, "timestamp": "00:06:11", "text": "はい、もう遅い時間です。私も疲れた。両方"}, {"type": "subtitle", "time": 375.909, "timestamp": "00:06:15", "text": "私たちの中には疲れている者もいる。今日は授業があった"}, {"type": "subtitle", "time": 379.59, "timestamp": "00:06:19", "text": "そして私は急いでこれに戻ってこなければならなかった"}, {"type": "subtitle", "time": 386.39, "timestamp": "00:06:26", "text": "すべては楽しさと"}, {"type": "subtitle", "time": 390.83, "timestamp": "00:06:30", "text": "結局、私たちはその日、たくさんの思い出を作った。"}, {"type": "subtitle", "time": 393.909, "timestamp": "00:06:33", "text": "はい。しかし、今日では本当にたくさんの情報があります。それは"}, {"type": "subtitle", "time": 401.67, "timestamp": "00:06:41", "text": "うん。では、あなたの計画は何ですか？"}, {"type": "subtitle", "time": 405.11, "timestamp": "00:06:45", "text": "バレンタインデー？あなたは、あなたは、えっと"}, {"type": "subtitle", "time": 407.27, "timestamp": "00:06:47", "text": "チョコレートを作っていますか？"}, {"type": "subtitle", "time": 411.59000000000003, "timestamp": "00:06:51", "text": "ケーキを作ろうと思います。おお、"}, {"type": "subtitle", "time": 414.23, "timestamp": "00:06:54", "text": "待って。ラ、去年は何をしていたの？"}, {"type": "subtitle", "time": 416.39, "timestamp": "00:06:56", "text": "ケーキを焼いて、それを披露したんじゃないの？"}, {"type": "subtitle", "time": 419.029, "timestamp": "00:06:59", "text": "ストリームか何か？何を私はしない"}]
[{"type": "subtitle", "time": 3311.549, "timestamp": "00:55:11", "text": "閉じさせてください"}, {"type": "subtitle", "time": 3322.63, "timestamp": "00:55:22", "text": "始める。えっと、このぼやけた部分を開いてください。わかった。ぼかし"}, {"type": "subtitle", "time": 3326.349, "timestamp": "00:55:26", "text": "少しだけ。それでは、Discordに戻ります。コントロール"}, {"type": "subtitle", "time": 3330.39, "timestamp": "00:55:30", "text": "スラッシュ。わかった。良い。良い。良い。元気です。"}, {"type": "subtitle", "time": 3338.23, "timestamp": "00:55:38", "text": "[音楽]"}, {"type": "subtitle", "time": 3341.91, "timestamp": "00:55:41", "text": "では、私たちがすべきことは"}, {"type": "subtitle", "time": 3344.43, "timestamp": "00:55:44", "text": "まず私は"}, {"type": "subtitle", "time": 3348.549, "timestamp": "00:55:48", "text": "主に必要なのは、ああ、宝石を手に入れた、ということです。私"}, {"type": "subtitle", "time": 3353.67, "timestamp": "00:55:53", "text": "オークションで落札した。ニース。こんにちは。とにかく、えっと"}, {"type": "subtitle", "time": 3357.109, "timestamp": "00:55:57", "text": "まず、私たちは王国に入り、"}]
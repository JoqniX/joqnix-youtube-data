[{"type": "subtitle", "time": 1320.11, "timestamp": "00:22:00", "text": "これ。"}, {"type": "subtitle", "time": 1330.63, "timestamp": "00:22:10", "text": "それを完成させるには蝶が必要だ。おお、"}, {"type": "subtitle", "time": 1335.029, "timestamp": "00:22:15", "text": "あと20秒だけ残っています。わかった。"}, {"type": "subtitle", "time": 1337.43, "timestamp": "00:22:17", "text": "一つになるよね？いくらですか"}, {"type": "subtitle", "time": 1340.71, "timestamp": "00:22:20", "text": "また時間切れですか？それは、もう"}, {"type": "subtitle", "time": 1342.149, "timestamp": "00:22:22", "text": "ええ、2時間かかる予定です。ええ、私たちは"}, {"type": "subtitle", "time": 1344.789, "timestamp": "00:22:24", "text": "まとめられます。"}, {"type": "subtitle", "time": 1346.75, "timestamp": "00:22:26", "text": "いいえ、完了できます"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "あなたの。ああ、わかりました。わかった。わかった。放してくれ"}]
[{"type": "subtitle", "time": 10021.83, "timestamp": "02:47:01", "text": "野戦。私はチャンネル6にいます。えっと、待って"}, {"type": "subtitle", "time": 10025.19, "timestamp": "02:47:05", "text": "普段私たちがみんな"}, {"type": "subtitle", "time": 10029.03, "timestamp": "02:47:09", "text": "王国でそれを行う。だから"}, {"type": "subtitle", "time": 10033.15, "timestamp": "02:47:13", "text": "最初のフィールドボス、つまり最初の"}, {"type": "subtitle", "time": 10036.87, "timestamp": "02:47:16", "text": "えっと、チャレンジフィールドのボスですね。だから"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "おそらく誰もがこれを選ぶだろう"}, {"type": "subtitle", "time": 10040.349, "timestamp": "02:47:20", "text": "チキン"}, {"type": "subtitle", "time": 10041.87, "timestamp": "02:47:21", "text": "雄鶏"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "コカット。えっと、まず一番重要なことは"}, {"type": "subtitle", "time": 10047.99, "timestamp": "02:47:27", "text": "現在のチャンネルにファストトラベルします"}, {"type": "subtitle", "time": 10049.15, "timestamp": "02:47:29", "text": "は"}, {"type": "subtitle", "time": 10052.15, "timestamp": "02:47:32", "text": "なぜなら、チャンネルを変更すると"}, {"type": "subtitle", "time": 10055.269, "timestamp": "02:47:35", "text": "パーティチャンネルが機能しない、機能しない"}, {"type": "subtitle", "time": 10059.19, "timestamp": "02:47:39", "text": "休憩時間があるので、仕事は"}, {"type": "subtitle", "time": 10062.309, "timestamp": "02:47:42", "text": "タイムアウト遅延が発生し、"}, {"type": "subtitle", "time": 10065.15, "timestamp": "02:47:45", "text": "タイムアウトしました。タイムアウトではなく遅延"}, {"type": "subtitle", "time": 10069.19, "timestamp": "02:47:49", "text": "次のチャンネルに入ってください。"}, {"type": "subtitle", "time": 10072.23, "timestamp": "02:47:52", "text": "たくさんの人 あ、待って。えっと、ほとんど"}, {"type": "subtitle", "time": 10077.23, "timestamp": "02:47:57", "text": "速く"}]
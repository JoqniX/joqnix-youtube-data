[{"type": "subtitle", "time": 18601.27, "timestamp": "05:10:01", "text": "1つ。ああ、そうだね。なぜ？ああ、これだ。これ"}, {"type": "subtitle", "time": 18602.948, "timestamp": "05:10:02", "text": "1つ。これです。うん。うん。うん。待って、"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "そうねぇ。お見せしましょう。これを見てください。"}, {"type": "subtitle", "time": 18610.55, "timestamp": "05:10:10", "text": "V のことは気にしないでください。いつも。いつも。"}, {"type": "subtitle", "time": 18612.708, "timestamp": "05:10:12", "text": "Vアカウントを見かけたら、すぐに隠れてください。"}, {"type": "subtitle", "time": 18617.868, "timestamp": "05:10:17", "text": "それ。あなたはこれを見過ごすでしょう。見えない"}, {"type": "subtitle", "time": 18621.27, "timestamp": "05:10:21", "text": "それ。私はいつも自分のVonを隠したいんです"}, {"type": "subtitle", "time": 18623.47, "timestamp": "05:10:23", "text": "私の"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "エネルギー。隠して。こんにちは。だから、これを見て"}, {"type": "subtitle", "time": 18632.788, "timestamp": "05:10:32", "text": "表示と非表示、そして非表示にした理由を説明する"}, {"type": "subtitle", "time": 18635.27, "timestamp": "05:10:35", "text": "彼。うん。これがオートモードの動作です。"}, {"type": "subtitle", "time": 18639.83, "timestamp": "05:10:39", "text": "「表示」をクリックすると、"}, {"type": "subtitle", "time": 18643.75, "timestamp": "05:10:43", "text": "チャットで。うん。今、あなたは"}, {"type": "subtitle", "time": 18645.628, "timestamp": "05:10:45", "text": "今見て"}, {"type": "subtitle", "time": 18647.39, "timestamp": "05:10:47", "text": "現れる。"}, {"type": "subtitle", "time": 18649.99, "timestamp": "05:10:49", "text": "うん。パッティングとはお別れです"}, {"type": "subtitle", "time": 18653.27, "timestamp": "05:10:53", "text": "このチョークは良いですね。その通り。"}]
[{"type": "subtitle", "time": 14402.309, "timestamp": "04:00:02", "text": "時間。 1 2 3 4 5。ああ、月曜日まで。私は手に入れた"}, {"type": "subtitle", "time": 14404.389, "timestamp": "04:00:04", "text": "時間まで。月曜日まで。はい、結構です。"}, {"type": "subtitle", "time": 14417.269, "timestamp": "04:00:17", "text": "ああ、私たちも召喚状をもらったよ。ない"}, {"type": "subtitle", "time": 14419.55, "timestamp": "04:00:19", "text": "召喚するが装備チケットも必要だ。 2つ"}, {"type": "subtitle", "time": 14427.229, "timestamp": "04:00:27", "text": "それ。私たちは何を得るのでしょうか？ライト"}, {"type": "subtitle", "time": 14429.75, "timestamp": "04:00:29", "text": "弓。星は2つです。知っている。欲しい"}, {"type": "subtitle", "time": 14432.91, "timestamp": "04:00:32", "text": "4つ星"}, {"type": "subtitle", "time": 14435.63, "timestamp": "04:00:35", "text": "緑色の三つ星。"}, {"type": "subtitle", "time": 14439.309, "timestamp": "04:00:39", "text": "悪い。私は既に持っています。私は4つ持っています"}, {"type": "subtitle", "time": 14441.99, "timestamp": "04:00:41", "text": "星。ええ、私の4番目の星に餌をあげます。"}, {"type": "subtitle", "time": 14443.87, "timestamp": "04:00:43", "text": "3つ星"}, {"type": "subtitle", "time": 14452.83, "timestamp": "04:00:52", "text": "バカ。そしてライトバート。私は2を手に入れた"}, {"type": "subtitle", "time": 14455.309, "timestamp": "04:00:55", "text": "食べるためにあなたを見つめる"}, {"type": "subtitle", "time": 14457.79, "timestamp": "04:00:57", "text": "上。"}]
[{"type": "subtitle", "time": 12121.95, "timestamp": "03:22:01", "text": "秒。そうだね。君の息子。うん"}, {"type": "subtitle", "time": 12125.71, "timestamp": "03:22:05", "text": "男の子。ああ、50人が死亡した。"}, {"type": "subtitle", "time": 12128.91, "timestamp": "03:22:08", "text": "ニース。よし。この男。"}, {"type": "subtitle", "time": 12131.429, "timestamp": "03:22:11", "text": "ああ、どうか星3つをもらってください"}, {"type": "subtitle", "time": 12137.83, "timestamp": "03:22:17", "text": "もし会ったら、彼らに教訓を与えてやる"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "ああ、星３つ。いいぞ、いいぞ、いいぞ、いいぞ。"}, {"type": "subtitle", "time": 12152.59, "timestamp": "03:22:32", "text": "良い。ティア5がアンロックされました。さあ"}, {"type": "subtitle", "time": 12156.63, "timestamp": "03:22:36", "text": "行く。今後はティア4のみをプレイします"}, {"type": "subtitle", "time": 12159.59, "timestamp": "03:22:39", "text": "だって、それが私の限界だから。そして私たちは"}, {"type": "subtitle", "time": 12164.309, "timestamp": "03:22:44", "text": "再び挑戦する。パワーアップ。私たちは"}, {"type": "subtitle", "time": 12166.55, "timestamp": "03:22:46", "text": "今回は火の寺院です。まだやったことがないので。"}, {"type": "subtitle", "time": 12169.59, "timestamp": "03:22:49", "text": "火の神殿は全くありません。私たちは"}, {"type": "subtitle", "time": 12170.349, "timestamp": "03:22:50", "text": "得る"}, {"type": "subtitle", "time": 12179.269, "timestamp": "03:22:59", "text": "三つ。我慢する。英語VA。はい、英語"}]
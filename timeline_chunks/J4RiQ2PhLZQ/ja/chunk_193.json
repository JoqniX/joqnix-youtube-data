[{"type": "subtitle", "time": 11581.71, "timestamp": "03:13:01", "text": "もの。私に"}, {"type": "subtitle", "time": 11585.389, "timestamp": "03:13:05", "text": "これを解放してください。何？私は誰と当たったの？"}, {"type": "subtitle", "time": 11590.349, "timestamp": "03:13:10", "text": "ちびっ子。私はこれを手に入れる、私はあなたにこれをあげる"}, {"type": "subtitle", "time": 11593.79, "timestamp": "03:13:13", "text": "もの。はぁ？待って。飼いならすことに失敗した。"}, {"type": "subtitle", "time": 11596.55, "timestamp": "03:13:16", "text": "おい。別にあなたに何か欲しいわけじゃないのよ。私"}, {"type": "subtitle", "time": 11604.23, "timestamp": "03:13:24", "text": "餌。よし。ジョーは行かなければならなかった。すべて"}, {"type": "subtitle", "time": 11606.469, "timestamp": "03:13:26", "text": "そろそろ出発の時間だ。えっと、"}, {"type": "subtitle", "time": 11609.309, "timestamp": "03:13:29", "text": "気をつけて。楽しむ。次回。"}, {"type": "subtitle", "time": 11614.59, "timestamp": "03:13:34", "text": "こんにちは。こんにちは。お元気でね、ハニー。そして暖かい"}, {"type": "subtitle", "time": 11617.19, "timestamp": "03:13:37", "text": "頭。音声コマンドは使えません"}, {"type": "subtitle", "time": 11620.55, "timestamp": "03:13:40", "text": "まだできていないが、手動でやらなければならない。それで、"}, {"type": "subtitle", "time": 11637.91, "timestamp": "03:13:57", "text": "マウンド。"}]
[{"type": "subtitle", "time": 6242.95, "timestamp": "01:44:02", "text": "ちびっ子。そして、先ほどの質問に対する私の答えは、"}, {"type": "subtitle", "time": 6245.31, "timestamp": "01:44:05", "text": "私はレベルアップします"}, {"type": "subtitle", "time": 6247.229, "timestamp": "01:44:07", "text": "これ。私は"}, {"type": "subtitle", "time": 6251.669, "timestamp": "01:44:11", "text": "ごめん。私はあなたを利用する。"}, {"type": "subtitle", "time": 6254.59, "timestamp": "01:44:14", "text": "はい、両方とも同じパワーです"}, {"type": "subtitle", "time": 6256.59, "timestamp": "01:44:16", "text": "信じる。"}, {"type": "subtitle", "time": 6259.229, "timestamp": "01:44:19", "text": "右。それで"}, {"type": "subtitle", "time": 6263.79, "timestamp": "01:44:23", "text": "雄牛は"}, {"type": "subtitle", "time": 6269.51, "timestamp": "01:44:29", "text": "18436、ペンギンは181 173 173です。"}, {"type": "subtitle", "time": 6272.83, "timestamp": "01:44:32", "text": "はい、ほぼ同じです"}, {"type": "subtitle", "time": 6276.07, "timestamp": "01:44:36", "text": "ほぼ同等で、彼は守備タイプのサポート役です"}, {"type": "subtitle", "time": 6285.95, "timestamp": "01:44:45", "text": "強化と彼の防御"}, {"type": "subtitle", "time": 6294.83, "timestamp": "01:44:54", "text": "HP"}, {"type": "subtitle", "time": 6296.75, "timestamp": "01:44:56", "text": "そして"}]
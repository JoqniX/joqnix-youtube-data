[{"type": "subtitle", "time": 8353.99, "timestamp": "02:19:13", "text": "ああ、彼と彼女は亡くなった。いいえ、彼女は"}, {"type": "subtitle", "time": 8369.27, "timestamp": "02:19:29", "text": "ああ、殺せ。"}, {"type": "subtitle", "time": 8370.629, "timestamp": "02:19:30", "text": "なんてこった。いいえ。私は死んでいます。私は死んだ。私は"}, {"type": "subtitle", "time": 8399.11, "timestamp": "02:19:59", "text": "グローブ。あなたは死ぬ。出て行け。出て行け。得る"}]
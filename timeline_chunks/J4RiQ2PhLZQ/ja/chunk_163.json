[{"type": "subtitle", "time": 9781.67, "timestamp": "02:43:01", "text": "しかし彼はタッチポータルをより多く使用し、"}, {"type": "subtitle", "time": 9784.23, "timestamp": "02:43:04", "text": "ストリーマーボードとその他"}, {"type": "subtitle", "time": 9788.389, "timestamp": "02:43:08", "text": "まだいじってみていないもの"}, {"type": "subtitle", "time": 9790.309, "timestamp": "02:43:10", "text": "特にタッチポータルは、私はいじらなかった"}, {"type": "subtitle", "time": 9793.27, "timestamp": "02:43:13", "text": "ストリーマーボードの周りをうろついているけど、そうじゃない"}, {"type": "subtitle", "time": 9797.03, "timestamp": "02:43:17", "text": "それほどまでに私は自分の"}, {"type": "subtitle", "time": 9800.83, "timestamp": "02:43:20", "text": "レオンと少年に詰め込む。そうなんです、"}, {"type": "subtitle", "time": 9805.429, "timestamp": "02:43:25", "text": "コードが何かクレイジーなことをするたびに"}, {"type": "subtitle", "time": 9808.23, "timestamp": "02:43:28", "text": "彼の配信は、私にもっと頑張ろうという気持ちを起こさせてくれる。"}, {"type": "subtitle", "time": 9813.429, "timestamp": "02:43:33", "text": "私の配信で、だって、最近は"}, {"type": "subtitle", "time": 9818.59, "timestamp": "02:43:38", "text": "以前と同じように、あの煩わしいコードがフェルト"}, {"type": "subtitle", "time": 9822.87, "timestamp": "02:43:42", "text": "こんな感じ、これは痛みです。私は、えっと、私の"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "ストリームに対するモチベーションとアイデアの欠如"}, {"type": "subtitle", "time": 9828.87, "timestamp": "02:43:48", "text": "もの。普段は、えーと"}, {"type": "subtitle", "time": 9831.269, "timestamp": "02:43:51", "text": "大手ストリーマーからのモチベーションを高めるもの"}, {"type": "subtitle", "time": 9833.91, "timestamp": "02:43:53", "text": "これをしてください。これを行う他の配信者"}, {"type": "subtitle", "time": 9836.19, "timestamp": "02:43:56", "text": "ナッティのように"}, {"type": "subtitle", "time": 9839.15, "timestamp": "02:43:59", "text": "エンジェル、そしてベラ"}]
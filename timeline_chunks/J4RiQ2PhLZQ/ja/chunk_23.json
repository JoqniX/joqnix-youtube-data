[{"type": "subtitle", "time": 1383.23, "timestamp": "00:23:03", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 1387.029, "timestamp": "00:23:07", "text": "わーい。こういうハサミが必要なんです"}, {"type": "subtitle", "time": 1390.47, "timestamp": "00:23:10", "text": "すごくかっこいい。分解することもできます"}, {"type": "subtitle", "time": 1394.789, "timestamp": "00:23:14", "text": "そしてそれはハサミになる。"}, {"type": "subtitle", "time": 1398.83, "timestamp": "00:23:18", "text": "わかった。ええ、これは折りたたみ式みたいなものです。"}, {"type": "subtitle", "time": 1402.31, "timestamp": "00:23:22", "text": "先生、これを見てください。とてもかわいい。それはまるで"}, {"type": "subtitle", "time": 1405.51, "timestamp": "00:23:25", "text": "子供用のはさみだけどね。うん。犬は"}, {"type": "subtitle", "time": 1407.43, "timestamp": "00:23:27", "text": "子供。"}, {"type": "subtitle", "time": 1410.47, "timestamp": "00:23:30", "text": "いいえ、私はコンパクトに収納できるものが欲しかったんです。のように"}, {"type": "subtitle", "time": 1420.42, "timestamp": "00:23:40", "text": "うん。では、どのように切ればいいのでしょうか？ただ"}, {"type": "subtitle", "time": 1425.549, "timestamp": "00:23:45", "text": "[音楽]"}]
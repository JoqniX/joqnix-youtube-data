[{"type": "subtitle", "time": 15962.55, "timestamp": "04:26:02", "text": "トマト1個買うと1個もらえるよ、君にあげるよ"}, {"type": "subtitle", "time": 15963.35, "timestamp": "04:26:03", "text": "たくさんの"}, {"type": "subtitle", "time": 15966.03, "timestamp": "04:26:06", "text": "[音楽]"}, {"type": "subtitle", "time": 15972.349, "timestamp": "04:26:12", "text": "お待ちください"}, {"type": "subtitle", "time": 15976.79, "timestamp": "04:26:16", "text": "それがピンです。彼は私を見ています"}, {"type": "subtitle", "time": 15985.229, "timestamp": "04:26:25", "text": "いいえ"}, {"type": "subtitle", "time": 15988.07, "timestamp": "04:26:28", "text": "プリン。元気かい？プリンを見てください。"}, {"type": "subtitle", "time": 15989.55, "timestamp": "04:26:29", "text": "彼は終わった"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "ここ。おお、"}, {"type": "subtitle", "time": 15995.82, "timestamp": "04:26:35", "text": "それは"}, {"type": "subtitle", "time": 16013.54, "timestamp": "04:26:53", "text": "私はそうします"}]
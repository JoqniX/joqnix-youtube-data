[{"type": "subtitle", "time": 5465.39, "timestamp": "01:31:05", "text": "クラス。私は気をつけなければならない"}, {"type": "subtitle", "time": 5468.35, "timestamp": "01:31:08", "text": "エンジニア。彼らは治癒したりできる"}, {"type": "subtitle", "time": 5485.39, "timestamp": "01:31:25", "text": "彼ら。"}, {"type": "subtitle", "time": 5486.91, "timestamp": "01:31:26", "text": "次"}, {"type": "subtitle", "time": 5490.11, "timestamp": "01:31:30", "text": "二。私は小さいものを選んでいます"}, {"type": "subtitle", "time": 5493.59, "timestamp": "01:31:33", "text": "人々。下位レベルの人々。はい。別の"}, {"type": "subtitle", "time": 5495.05, "timestamp": "01:31:35", "text": "エンジニアクラス。"}, {"type": "subtitle", "time": 5497.149, "timestamp": "01:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 5500.11, "timestamp": "01:31:40", "text": "わーい。ああ、それは"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "亡くなった。ああ、彼女は癒したのだ。何てことだ。彼女"}, {"type": "subtitle", "time": 5505.91, "timestamp": "01:31:45", "text": "治癒した。彼女は回復した。彼女は回復した。彼女"}, {"type": "subtitle", "time": 5510.27, "timestamp": "01:31:50", "text": "治癒した。彼女は回復した。ああ、彼女は亡くなった。"}, {"type": "subtitle", "time": 5512.14, "timestamp": "01:31:52", "text": "わーい。"}, {"type": "subtitle", "time": 5517.95, "timestamp": "01:31:57", "text": "[音楽]"}]
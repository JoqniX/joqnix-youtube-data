[{"type": "subtitle", "time": 1920.509, "timestamp": "00:32:00", "text": "紙工作を一緒に作りましょう"}, {"type": "subtitle", "time": 1922.99, "timestamp": "00:32:02", "text": "すべて？楽しかったです。"}, {"type": "subtitle", "time": 1925.83, "timestamp": "00:32:05", "text": "右？ズキは最善を尽くした。だから私は"}, {"type": "subtitle", "time": 1935.59, "timestamp": "00:32:15", "text": "最高。次に何かをしたいときは"}, {"type": "subtitle", "time": 1939.43, "timestamp": "00:32:19", "text": "えーと、何をすればいいの？あなたの手でアイデアをください"}, {"type": "subtitle", "time": 1951.63, "timestamp": "00:32:31", "text": "手。うん、いいよ。その"}, {"type": "subtitle", "time": 1954.149, "timestamp": "00:32:34", "text": "良い。次にやりたいことは"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "文字通り指ダンスをして、"}, {"type": "subtitle", "time": 1959.83, "timestamp": "00:32:39", "text": "指で乳首をいじったりとか。"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "でも、ええ、実際に費やしたので"}, {"type": "subtitle", "time": 1966.149, "timestamp": "00:32:46", "text": "これらのものへのお金、ええと、この2つ"}, {"type": "subtitle", "time": 1970.23, "timestamp": "00:32:50", "text": "スケッチペンや色鉛筆などの小物、"}, {"type": "subtitle", "time": 1972.43, "timestamp": "00:32:52", "text": "私たちは"}, {"type": "subtitle", "time": 1975.35, "timestamp": "00:32:55", "text": "えっと、塗り絵とか。私は自分が"}, {"type": "subtitle", "time": 1977.95, "timestamp": "00:32:57", "text": "着色料を使うべき"}]
[{"type": "subtitle", "time": 1503.19, "timestamp": "00:25:03", "text": "いや、待って。はい、そうしました。いいえ、そうは思いません。"}, {"type": "subtitle", "time": 1504.35, "timestamp": "00:25:04", "text": "どうして"}, {"type": "subtitle", "time": 1507.99, "timestamp": "00:25:07", "text": "私？待って、私は何だったか覚えていない"}, {"type": "subtitle", "time": 1515.99, "timestamp": "00:25:15", "text": "終わり。私はそうは思いません。え、私？"}, {"type": "subtitle", "time": 1518.39, "timestamp": "00:25:18", "text": "いいえ、そうは思いません。"}, {"type": "subtitle", "time": 1521.51, "timestamp": "00:25:21", "text": "以前は小川を歩いて散策していたよね。"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "ああ、いいえ、覚えていません。私は、えっと"}, {"type": "subtitle", "time": 1528.51, "timestamp": "00:25:28", "text": "ああ、君のおかげで思い出したよ"}, {"type": "subtitle", "time": 1536.11, "timestamp": "00:25:36", "text": "知ってるよ、私は"}, {"type": "subtitle", "time": 1541.51, "timestamp": "00:25:41", "text": "えっと、あなたに会った後、私は"}, {"type": "subtitle", "time": 1543.99, "timestamp": "00:25:43", "text": "酔って寝ることについてこれを学びました"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "もの。私はそれが何なのか知らなかった。私"}, {"type": "subtitle", "time": 1549.909, "timestamp": "00:25:49", "text": "袖に伝線が入ったみたい。"}, {"type": "subtitle", "time": 1558.549, "timestamp": "00:25:58", "text": "疲れていたし、酔っていたんだと思う。ああ神様、見て"}]
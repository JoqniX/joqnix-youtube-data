[{"type": "subtitle", "time": 12264.75, "timestamp": "03:24:24", "text": "弓。わかった、"}, {"type": "subtitle", "time": 12277.19, "timestamp": "03:24:37", "text": "それ。なぜ英語を話すのか分からない"}, {"type": "subtitle", "time": 12278.19, "timestamp": "03:24:38", "text": "音は"}, {"type": "subtitle", "time": 12281.99, "timestamp": "03:24:41", "text": "ディズニーからプレゼントがあります。ええ、そうです"}, {"type": "subtitle", "time": 12289.95, "timestamp": "03:24:49", "text": "え、何？"}, {"type": "subtitle", "time": 12293.79, "timestamp": "03:24:53", "text": "はぁ？ゲームはどうなったの？"}, {"type": "subtitle", "time": 12295.71, "timestamp": "03:24:55", "text": "はぁ？おお、"}, {"type": "subtitle", "time": 12299.429, "timestamp": "03:24:59", "text": "待って。何であるべきか？何？それ"}]
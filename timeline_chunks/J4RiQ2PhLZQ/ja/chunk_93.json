[{"type": "subtitle", "time": 5581.59, "timestamp": "01:33:01", "text": "まあ、バカね。"}, {"type": "subtitle", "time": 5592.229, "timestamp": "01:33:12", "text": "良い。他に何か？死ぬ。どのサイコロが"}, {"type": "subtitle", "time": 5593.95, "timestamp": "01:33:13", "text": "私たちは"}, {"type": "subtitle", "time": 5596.59, "timestamp": "01:33:16", "text": "得る？おお、"}, {"type": "subtitle", "time": 5599.99, "timestamp": "01:33:19", "text": "良い。このアイテムを交換する必要があるかもしれません。"}, {"type": "subtitle", "time": 5602.149, "timestamp": "01:33:22", "text": "それは配信でやります。私は決して取引をしません"}, {"type": "subtitle", "time": 5605.51, "timestamp": "01:33:25", "text": "それ。だから、私は最善を尽くして取引します。"}, {"type": "subtitle", "time": 5610.39, "timestamp": "01:33:30", "text": "だから私たちはこの場所に行って買います"}, {"type": "subtitle", "time": 5615.95, "timestamp": "01:33:35", "text": "宴会。宴会を2つか3つ買う必要がある"}, {"type": "subtitle", "time": 5620.189, "timestamp": "01:33:40", "text": "料金。だから私たちはできるだけ多くのものを集める必要がある"}, {"type": "subtitle", "time": 5624.35, "timestamp": "01:33:44", "text": "卵もできるし、これもできる"}, {"type": "subtitle", "time": 5627.11, "timestamp": "01:33:47", "text": "シーフード。私たちは旅行からこれを得ます"}, {"type": "subtitle", "time": 5630.149, "timestamp": "01:33:50", "text": "商人兼雑貨店。では、試してみましょう"}, {"type": "subtitle", "time": 5638.17, "timestamp": "01:33:58", "text": "私はしません"}]
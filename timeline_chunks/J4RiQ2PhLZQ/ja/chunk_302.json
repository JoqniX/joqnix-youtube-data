[{"type": "subtitle", "time": 18121.03, "timestamp": "05:02:01", "text": "控えめに言って、太陽のような感じがする。ええ、そうです"}, {"type": "subtitle", "time": 18130.948, "timestamp": "05:02:10", "text": "はい、この場所全体が"}, {"type": "subtitle", "time": 18133.28, "timestamp": "05:02:13", "text": "月明かりに照らされた恋人たち。調子はどうですか？"}, {"type": "subtitle", "time": 18134.59, "timestamp": "05:02:14", "text": "[音楽]"}, {"type": "subtitle", "time": 18140.35, "timestamp": "05:02:20", "text": "あなた？待って、これを手に入れさせて。"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "わかった。あなたは誰で、なぜ"}, {"type": "subtitle", "time": 18144.91, "timestamp": "05:02:24", "text": "持っている"}, {"type": "subtitle", "time": 18153.03, "timestamp": "05:02:33", "text": "花？あなたは盗んだ泥棒に違いない"}, {"type": "subtitle", "time": 18161.11, "timestamp": "05:02:41", "text": "ネイサンって誰？ああ、ネイサンは私のえっと"}, {"type": "subtitle", "time": 18164.03, "timestamp": "05:02:44", "text": "エモートアーティストが作った"}, {"type": "subtitle", "time": 18168.23, "timestamp": "05:02:48", "text": "えっと、ちょっと待って。つまり、ネイサンはエモートアーティストだ"}, {"type": "subtitle", "time": 18173.43, "timestamp": "05:02:53", "text": "私のドキュメントの絵文字を作ったのは誰ですか？"}, {"type": "subtitle", "time": 18175.31, "timestamp": "05:02:55", "text": "待って、待って、待って、待って"}, {"type": "subtitle", "time": 18178.47, "timestamp": "05:02:58", "text": "上。どこ"}]
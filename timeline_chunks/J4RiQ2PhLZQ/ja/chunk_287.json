[{"type": "subtitle", "time": 17221.55, "timestamp": "04:47:01", "text": "ベッドに入ってストーリークエストをしよう"}, {"type": "subtitle", "time": 17224.708, "timestamp": "04:47:04", "text": "それから、その場所へファストトラベルします。愛"}, {"type": "subtitle", "time": 17226.27, "timestamp": "04:47:06", "text": "悪魔"}, {"type": "subtitle", "time": 17242.12, "timestamp": "04:47:22", "text": "[音楽]"}, {"type": "subtitle", "time": 17247.59, "timestamp": "04:47:27", "text": "彼らは攻撃しようとしていると思う"}, {"type": "subtitle", "time": 17249.95, "timestamp": "04:47:29", "text": "私たち。ああ、うっかり始めてしまった"}, {"type": "subtitle", "time": 17251.39, "timestamp": "04:47:31", "text": "[音楽]"}, {"type": "subtitle", "time": 17259.868, "timestamp": "04:47:39", "text": "こんにちは。これを終わらせて"}, {"type": "subtitle", "time": 17262.35, "timestamp": "04:47:42", "text": "続く。うっかり"}, {"type": "subtitle", "time": 17265.35, "timestamp": "04:47:45", "text": "開始しました。私はただテレポートしたかっただけです"}, {"type": "subtitle", "time": 17274.67, "timestamp": "04:47:54", "text": "開始"}]
[{"type": "subtitle", "time": 9901.99, "timestamp": "02:45:01", "text": "特に仕上げに取り掛かる"}, {"type": "subtitle", "time": 9904.63, "timestamp": "02:45:04", "text": "Discordボット関連。それが私の締め切りです"}, {"type": "subtitle", "time": 9908.389, "timestamp": "02:45:08", "text": "今月はこれで、その後は"}, {"type": "subtitle", "time": 9910.59, "timestamp": "02:45:10", "text": "私が言及したライブデューティーの仕事をしてください"}, {"type": "subtitle", "time": 9914.23, "timestamp": "02:45:14", "text": "昨日のチャットはextendについてでした"}, {"type": "subtitle", "time": 9917.75, "timestamp": "02:45:17", "text": "実務をこなす必要がある範囲"}, {"type": "subtitle", "time": 9921.51, "timestamp": "02:45:21", "text": "彼女のためにちびキャラみたいなのだけど、"}, {"type": "subtitle", "time": 9925.349, "timestamp": "02:45:25", "text": "私のジョックちびキャラを使ってください。"}, {"type": "subtitle", "time": 9928.469, "timestamp": "02:45:28", "text": "あれは私が描いたものです。ああ、フィールドボスは5人だ"}, {"type": "subtitle", "time": 9930.469, "timestamp": "02:45:30", "text": "数分で、移動が必要です。待つことにします"}, {"type": "subtitle", "time": 9936.99, "timestamp": "02:45:36", "text": "おお"}, {"type": "subtitle", "time": 9947.23, "timestamp": "02:45:47", "text": "それ。また、誰か"}, {"type": "subtitle", "time": 9951.51, "timestamp": "02:45:51", "text": "オンライン？誰かオンラインになってる？誰も応答していません。のみ"}, {"type": "subtitle", "time": 9952.75, "timestamp": "02:45:52", "text": "私は"}, {"type": "subtitle", "time": 9955.15, "timestamp": "02:45:55", "text": "の上。"}, {"type": "subtitle", "time": 9958.19, "timestamp": "02:45:58", "text": "彼女は私はほとんど"}]
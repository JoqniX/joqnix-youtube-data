[{"type": "subtitle", "time": 10980.63, "timestamp": "03:03:00", "text": "またか？あれって何て名前だったっけ？"}, {"type": "subtitle", "time": 10982.11, "timestamp": "03:03:02", "text": "何ですか"}, {"type": "subtitle", "time": 10984.269, "timestamp": "03:03:04", "text": "これ？"}, {"type": "subtitle", "time": 10986.11, "timestamp": "03:03:06", "text": "ロジクール。"}, {"type": "subtitle", "time": 10995.75, "timestamp": "03:03:15", "text": "ロジクールG33？これじゃないですか？うん、これ"}, {"type": "subtitle", "time": 11000.19, "timestamp": "03:03:20", "text": "1つ。 Logitech G33 または HyperX Cloud"}, {"type": "subtitle", "time": 11004.07, "timestamp": "03:03:24", "text": "箱。これです。私のたった2人"}, {"type": "subtitle", "time": 11007.55, "timestamp": "03:03:27", "text": "選択肢はこの2つですが、私は"}, {"type": "subtitle", "time": 11015.269, "timestamp": "03:03:35", "text": "それ。私はボーカルをするのが大好きですが、"}, {"type": "subtitle", "time": 11018.429, "timestamp": "03:03:38", "text": "声を発する。待って、ポンドンだったの？どれの"}, {"type": "subtitle", "time": 11022.87, "timestamp": "03:03:42", "text": "ギガンティと発音するものはどれですか、または"}, {"type": "subtitle", "time": 11027.95, "timestamp": "03:03:47", "text": "待って、"}, {"type": "subtitle", "time": 11030.03, "timestamp": "03:03:50", "text": "見る。その"}, {"type": "subtitle", "time": 11035.75, "timestamp": "03:03:55", "text": "ジャイ・ガンディーと呼ばれた。ジガジガアンティ。"}, {"type": "subtitle", "time": 11039.309, "timestamp": "03:03:59", "text": "待って。ジグアンチ。私はしません"}]
[{"type": "subtitle", "time": 903.35, "timestamp": "00:15:03", "text": "推測し、その方法を学ぶ。折りたたむ"}, {"type": "subtitle", "time": 905.4, "timestamp": "00:15:05", "text": "内側の底角"}, {"type": "subtitle", "time": 911.11, "timestamp": "00:15:11", "text": "犬。"}, {"type": "subtitle", "time": 912.28, "timestamp": "00:15:12", "text": "はい。"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "[音楽]"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "どうやってまだその近くに住んでいるの？"}, {"type": "subtitle", "time": 921.59, "timestamp": "00:15:21", "text": "私は行ったことがありますか？うん。その質問は何ですか？"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "看護師が中にいます。ええ、私も同じです"}, {"type": "subtitle", "time": 927.829, "timestamp": "00:15:27", "text": "私が生まれた場所。"}, {"type": "subtitle", "time": 931.509, "timestamp": "00:15:31", "text": "私は文字通りジョーの家の目の前にいた。"}, {"type": "subtitle", "time": 934.47, "timestamp": "00:15:34", "text": "わかった。そして私は更衣室で泣いていた"}, {"type": "subtitle", "time": 937.509, "timestamp": "00:15:37", "text": "部屋の前で文字通り"}, {"type": "subtitle", "time": 939.91, "timestamp": "00:15:39", "text": "彼の家。"}, {"type": "subtitle", "time": 942.23, "timestamp": "00:15:42", "text": "しかし、私たちは会うことができず、"}, {"type": "subtitle", "time": 945.03, "timestamp": "00:15:45", "text": "ジョーは高熱のように。"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "ああ、熱があったんだ"}, {"type": "subtitle", "time": 951.03, "timestamp": "00:15:51", "text": "日。え、雨が降っていたけど、私は"}, {"type": "subtitle", "time": 955.269, "timestamp": "00:15:55", "text": "ジョックにただそれだけのために走ってきてほしい"}, {"type": "subtitle", "time": 958.47, "timestamp": "00:15:58", "text": "ご存知の通り、私たちは既に会っています。"}, {"type": "subtitle", "time": 959.389, "timestamp": "00:15:59", "text": "貧しい"}]
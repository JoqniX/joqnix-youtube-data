[{"type": "subtitle", "time": 3240.75, "timestamp": "00:54:00", "text": "9. 9じゃなくて8"}, {"type": "subtitle", "time": 3244.27, "timestamp": "00:54:04", "text": "7時30分。それからまたドロップをします"}, {"type": "subtitle", "time": 3247.43, "timestamp": "00:54:07", "text": "見逃してしまった。もっと早くやるべきだった。"}, {"type": "subtitle", "time": 3250.549, "timestamp": "00:54:10", "text": "朝。私は寝て過ごした"}, {"type": "subtitle", "time": 3252.87, "timestamp": "00:54:12", "text": "午後。だから私は"}, {"type": "subtitle", "time": 3256.27, "timestamp": "00:54:16", "text": "午後の私のドロップは"}, {"type": "subtitle", "time": 3259.51, "timestamp": "00:54:19", "text": "5 そして私は夜を過ごす"}, {"type": "subtitle", "time": 3277.67, "timestamp": "00:54:37", "text": "えっと、目薬をさしてください。私はそこにいてほしい"}, {"type": "subtitle", "time": 3279.95, "timestamp": "00:54:39", "text": "それは思い出させるものだった"}, {"type": "subtitle", "time": 3283.109, "timestamp": "00:54:43", "text": "あれ。 1時間後くらいにリマインダーを送ってください。私"}, {"type": "subtitle", "time": 3286.829, "timestamp": "00:54:46", "text": "作れるかもしれないけど、取り組んでみます"}, {"type": "subtitle", "time": 3290.79, "timestamp": "00:54:50", "text": "後で。そして、私は神の声を聞く。ああ、"}, {"type": "subtitle", "time": 3292.19, "timestamp": "00:54:52", "text": "[音楽]"}]
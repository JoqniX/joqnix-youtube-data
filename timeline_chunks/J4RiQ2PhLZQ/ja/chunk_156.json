[{"type": "subtitle", "time": 9361.27, "timestamp": "02:36:01", "text": "彼らは、彼らが"}, {"type": "subtitle", "time": 9364.389, "timestamp": "02:36:04", "text": "新しいメガネが合うかどうか不安です"}, {"type": "subtitle", "time": 9367.309, "timestamp": "02:36:07", "text": "なぜなら、"}, {"type": "subtitle", "time": 9371.27, "timestamp": "02:36:11", "text": "今の私のメガネは"}, {"type": "subtitle", "time": 9374.15, "timestamp": "02:36:14", "text": "薄いですよね？薄い、薄い"}, {"type": "subtitle", "time": 9377.349, "timestamp": "02:36:17", "text": "金属製の物体。だから、それは一種の"}, {"type": "subtitle", "time": 9381.349, "timestamp": "02:36:21", "text": "技術者が"}, {"type": "subtitle", "time": 9384.79, "timestamp": "02:36:24", "text": "古いレンズを取り出して、"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "新しいレンズを入れると、"}, {"type": "subtitle", "time": 9392.07, "timestamp": "02:36:32", "text": "あなたはそれを何と呼びますか？きついフィット感か、それとも"}, {"type": "subtitle", "time": 9394.469, "timestamp": "02:36:34", "text": "フレームとかが壊れるかもしれない。だから私は"}, {"type": "subtitle", "time": 9397.91, "timestamp": "02:36:37", "text": "心配そうに。私はまだできるといいな"}, {"type": "subtitle", "time": 9401.91, "timestamp": "02:36:41", "text": "フレームを使用するか、購入しなければならない場合は"}, {"type": "subtitle", "time": 9406.71, "timestamp": "02:36:46", "text": "新しいフレームの方が、より安全な選択肢です。えっと"}, {"type": "subtitle", "time": 9408.91, "timestamp": "02:36:48", "text": "私は欲しい"}, {"type": "subtitle", "time": 9412.55, "timestamp": "02:36:52", "text": "丸みを帯びた丸みはかっこいい。私はしたくない"}, {"type": "subtitle", "time": 9415.15, "timestamp": "02:36:55", "text": "振り出しに戻る。スクエアは"}, {"type": "subtitle", "time": 9418.03, "timestamp": "02:36:58", "text": "痛み。私は欲しい、私は好き"}]
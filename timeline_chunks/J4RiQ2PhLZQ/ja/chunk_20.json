[{"type": "subtitle", "time": 1200.54, "timestamp": "00:20:00", "text": "私には到底できないことだ。"}, {"type": "subtitle", "time": 1213.5, "timestamp": "00:20:13", "text": "これをどうやって挿入すればいいですか？"}, {"type": "subtitle", "time": 1215.15, "timestamp": "00:20:15", "text": "[音楽]"}, {"type": "subtitle", "time": 1219.84, "timestamp": "00:20:19", "text": "よし、弓を手に入れなきゃ。"}, {"type": "subtitle", "time": 1225.11, "timestamp": "00:20:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1228.63, "timestamp": "00:20:28", "text": "中に挿入するのは難しい。わかった。わかった。えっと"}, {"type": "subtitle", "time": 1245.27, "timestamp": "00:20:45", "text": "[音楽]"}, {"type": "subtitle", "time": 1248.669, "timestamp": "00:20:48", "text": "折り紙が完成しました。折り紙は"}, {"type": "subtitle", "time": 1252.71, "timestamp": "00:20:52", "text": "完了しました。美しい紙製ブレスレット"}, {"type": "subtitle", "time": 1255.35, "timestamp": "00:20:55", "text": "ハート。ああ、それは難しそう"}]
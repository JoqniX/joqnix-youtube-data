[{"type": "subtitle", "time": 14945.389, "timestamp": "04:09:05", "text": "パズル。地表噴火。"}, {"type": "subtitle", "time": 14948.79, "timestamp": "04:09:08", "text": "おお。よし、やろう。えーと、始めよう"}, {"type": "subtitle", "time": 14952.269, "timestamp": "04:09:12", "text": "マッチング。単一政党。"}, {"type": "subtitle", "time": 14956.07, "timestamp": "04:09:16", "text": "受け入れる。さあ行こう。 46. 私は"}, {"type": "subtitle", "time": 14959.83, "timestamp": "04:09:19", "text": "ここにはたった46人しかいない。ああ、わかりました。また、"}, {"type": "subtitle", "time": 14961.95, "timestamp": "04:09:21", "text": "私は"}, {"type": "subtitle", "time": 14964.83, "timestamp": "04:09:24", "text": "の"}, {"type": "subtitle", "time": 14968.87, "timestamp": "04:09:28", "text": "N. 行こう。あ、待って。それは、でも"}, {"type": "subtitle", "time": 14971.15, "timestamp": "04:09:31", "text": "私たちはすべきでしょうか"}, {"type": "subtitle", "time": 14974.03, "timestamp": "04:09:34", "text": "行く"}, {"type": "subtitle", "time": 14981.469, "timestamp": "04:09:41", "text": "黒"}, {"type": "subtitle", "time": 14984.309, "timestamp": "04:09:44", "text": "丸。黒い円のエージェント。待って、誰"}, {"type": "subtitle", "time": 14985.79, "timestamp": "04:09:45", "text": "これらは"}, {"type": "subtitle", "time": 14988.469, "timestamp": "04:09:48", "text": "人々？私はこれらを見たことがありません。それは"}, {"type": "subtitle", "time": 14991.11, "timestamp": "04:09:51", "text": "闇の魔法に関連して、"}]
[{"type": "subtitle", "time": 14462.75, "timestamp": "04:01:02", "text": "ヤシュ。そして私は強化することができます"}, {"type": "subtitle", "time": 14466.59, "timestamp": "04:01:06", "text": "これ。私は失敗した。私は失敗した"}, {"type": "subtitle", "time": 14469.349, "timestamp": "04:01:09", "text": "また。ああ、成功した。"}, {"type": "subtitle", "time": 14471.75, "timestamp": "04:01:11", "text": "もう一度やってみよう。失敗した。一度"}, {"type": "subtitle", "time": 14472.91, "timestamp": "04:01:12", "text": "もっと。"}, {"type": "subtitle", "time": 14475.229, "timestamp": "04:01:15", "text": "失敗した。私の"}, {"type": "subtitle", "time": 14481.87, "timestamp": "04:01:21", "text": "運。私の運は悪い。私たちはできる、私たちはそうする"}, {"type": "subtitle", "time": 14487.71, "timestamp": "04:01:27", "text": "悪い奴だよ。なぜ私はこんなに運が悪いのだろう？"}, {"type": "subtitle", "time": 14492.15, "timestamp": "04:01:32", "text": "お、何？これで4連勝だ。 5つの"}, {"type": "subtitle", "time": 14493.389, "timestamp": "04:01:33", "text": "行。"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "こんにちは。何？"}, {"type": "subtitle", "time": 14499.32, "timestamp": "04:01:39", "text": "私の運は本当に悪い。"}, {"type": "subtitle", "time": 14507.99, "timestamp": "04:01:47", "text": "なぜ？私はそうしない、なぜなら私は"}, {"type": "subtitle", "time": 14511.83, "timestamp": "04:01:51", "text": "4冊目の星付きウォーターブックを待っています。"}, {"type": "subtitle", "time": 14513.229, "timestamp": "04:01:53", "text": "おお"}, {"type": "subtitle", "time": 14517.03, "timestamp": "04:01:57", "text": "私の。ええ、運が悪かったんです。だから"}, {"type": "subtitle", "time": 14519.59, "timestamp": "04:01:59", "text": "手に入れたクローバーで、レベルアップします"}]
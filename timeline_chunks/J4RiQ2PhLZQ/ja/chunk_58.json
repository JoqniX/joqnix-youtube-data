[{"type": "subtitle", "time": 3488.789, "timestamp": "00:58:08", "text": "それ。今日は何を試してみようかな？何か"}, {"type": "subtitle", "time": 3503.99, "timestamp": "00:58:23", "text": "エンドウ豆。ああ、ごちそうはありません。"}, {"type": "subtitle", "time": 3508.349, "timestamp": "00:58:28", "text": "これらは料理です。盛大なごちそうが必要だ。"}, {"type": "subtitle", "time": 3517.789, "timestamp": "00:58:37", "text": "宴会を開くことができる"}, {"type": "subtitle", "time": 3520.109, "timestamp": "00:58:40", "text": "で"}, {"type": "subtitle", "time": 3523.789, "timestamp": "00:58:43", "text": "1人分。購入する必要がある"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "こんにちは。何てことだ。これ買わなきゃ。"}, {"type": "subtitle", "time": 3539.67, "timestamp": "00:58:59", "text": "王国のためにイベントのために今"}]
[{"type": "subtitle", "time": 2100.829, "timestamp": "00:35:00", "text": "クラス。正午までには戻ると思います。それで"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "午前3時4分、いや午後3時4分できるかどうか見てみましょう"}, {"type": "subtitle", "time": 2108.23, "timestamp": "00:35:08", "text": "ストリーム。うん、ストリーミングできるかどうか試してみようかな。"}, {"type": "subtitle", "time": 2111.23, "timestamp": "00:35:11", "text": "配信してみたいです。"}, {"type": "subtitle", "time": 2113.79, "timestamp": "00:35:13", "text": "はい。そうだろう"}, {"type": "subtitle", "time": 2122.99, "timestamp": "00:35:22", "text": "今日。机を掃除しなければならなかった。"}, {"type": "subtitle", "time": 2125.829, "timestamp": "00:35:25", "text": "文字通り、机を掃除しなければならなかったので"}, {"type": "subtitle", "time": 2126.27, "timestamp": "00:35:26", "text": "多くの"}, {"type": "subtitle", "time": 2127.47, "timestamp": "00:35:27", "text": "[音楽]"}, {"type": "subtitle", "time": 2131.39, "timestamp": "00:35:31", "text": "今日は、黒い大理石ならダメだから"}, {"type": "subtitle", "time": 2134.63, "timestamp": "00:35:34", "text": "テーブルトップ。埃が舞い上がるのが見える"}, {"type": "subtitle", "time": 2137.43, "timestamp": "00:35:37", "text": "毎日。私は掃除する必要がある"}, {"type": "subtitle", "time": 2141.43, "timestamp": "00:35:41", "text": "これ。でもあなたは私のOhを襲撃すると言った、"}, {"type": "subtitle", "time": 2144.91, "timestamp": "00:35:44", "text": "うん。ああ、そうだね。ペンシルベニア州で使用されました。"}, {"type": "subtitle", "time": 2149.87, "timestamp": "00:35:49", "text": "ああ。ああ、そう言ったのは、いいえ。ええと、それは"}, {"type": "subtitle", "time": 2152.87, "timestamp": "00:35:52", "text": "例えば、私たちが何か創造的なことをするときのように。おお、"}, {"type": "subtitle", "time": 2154.15, "timestamp": "00:35:54", "text": "それが何なのか疑問に思っているなら、それは"}, {"type": "subtitle", "time": 2156.95, "timestamp": "00:35:56", "text": "私のMIDIキーボード。気にしないでください。それは"}, {"type": "subtitle", "time": 2158.829, "timestamp": "00:35:58", "text": "私が作る場所"}]
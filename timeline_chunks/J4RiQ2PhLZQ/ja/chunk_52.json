[{"type": "subtitle", "time": 3121.349, "timestamp": "00:52:01", "text": "右。ええ、そうですね。えーと、ウェットレベル29の場合、"}, {"type": "subtitle", "time": 3123.99, "timestamp": "00:52:03", "text": "これはザンの服用によるもので、"}, {"type": "subtitle", "time": 3126.87, "timestamp": "00:52:06", "text": "私は、それを"}, {"type": "subtitle", "time": 3130.79, "timestamp": "00:52:10", "text": "女王様だけど、私はバカです。女王とは"}, {"type": "subtitle", "time": 3132.79, "timestamp": "00:52:12", "text": "少女。"}, {"type": "subtitle", "time": 3135.549, "timestamp": "00:52:15", "text": "いかがなさいましたか？彼女は"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "エンジニアであって、[ __ ]ではない。"}, {"type": "subtitle", "time": 3139.589, "timestamp": "00:52:19", "text": "彼女は魔法使いだ。"}, {"type": "subtitle", "time": 3143.349, "timestamp": "00:52:23", "text": "彼女は完璧な女王であるべきだ"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "エンジニアであるべきで、私は"}, {"type": "subtitle", "time": 3148.069, "timestamp": "00:52:28", "text": "誤って魔女を選びました"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "自分。"}, {"type": "subtitle", "time": 3152.829, "timestamp": "00:52:32", "text": "私は知らない"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "戻ってきたけど、大丈夫。主な理由は"}, {"type": "subtitle", "time": 3160.069, "timestamp": "00:52:40", "text": "なぜ私が誤って濡れた女王を選んだのか"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "高さがわかるから"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "悪党とエンジニアの違いと"}, {"type": "subtitle", "time": 3167.03, "timestamp": "00:52:47", "text": "この女の子"}, {"type": "subtitle", "time": 3169.75, "timestamp": "00:52:49", "text": "二人とも、さあ。私が"}, {"type": "subtitle", "time": 3172.15, "timestamp": "00:52:52", "text": "私はスポーツマンみたいにできると思った"}, {"type": "subtitle", "time": 3176.23, "timestamp": "00:52:56", "text": "卵とアクィナとタイマー、それから"}, {"type": "subtitle", "time": 3179.589, "timestamp": "00:52:59", "text": "これ。私があなたの望む人ですか？"}]
[{"type": "subtitle", "time": 8952.469, "timestamp": "02:29:12", "text": "こんにちは。そして、私たちはそれをやり遂げました。あ、待って。"}, {"type": "subtitle", "time": 8961.23, "timestamp": "02:29:21", "text": "もっと。そうそう。私たちはもっと多くのクエストに挑戦できます。"}, {"type": "subtitle", "time": 8964.91, "timestamp": "02:29:24", "text": "そうそう。これでもっと"}, {"type": "subtitle", "time": 8966.51, "timestamp": "02:29:26", "text": "冷える。"}, {"type": "subtitle", "time": 8970.79, "timestamp": "02:29:30", "text": "わかりました、そうします。走って入ってもいいよ"}, {"type": "subtitle", "time": 8984.51, "timestamp": "02:29:44", "text": "火。他に何があるだろうか"}, {"type": "subtitle", "time": 8996.349, "timestamp": "02:29:56", "text": "私たちは必ず何か特別なものを手に入れる。"}, {"type": "subtitle", "time": 8999.07, "timestamp": "02:29:59", "text": "いいえ、していません。"}]
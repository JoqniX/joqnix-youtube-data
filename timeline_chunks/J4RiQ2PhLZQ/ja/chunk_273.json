[{"type": "subtitle", "time": 16382.03, "timestamp": "04:33:02", "text": "ガンダ。こんにちは。えっと、どこに"}, {"type": "subtitle", "time": 16388.349, "timestamp": "04:33:08", "text": "屋台。"}, {"type": "subtitle", "time": 16389.72, "timestamp": "04:33:09", "text": "ソナ。"}, {"type": "subtitle", "time": 16393.07, "timestamp": "04:33:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16396.429, "timestamp": "04:33:16", "text": "うん。月と星とは何ですか、または"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "えっと、これは何ですか？わからない。これら"}, {"type": "subtitle", "time": 16419.59, "timestamp": "04:33:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16421.789, "timestamp": "04:33:41", "text": "ああ、それはできません。何が"}, {"type": "subtitle", "time": 16425.869, "timestamp": "04:33:45", "text": "これ？何？何かを入れるとどうなるか"}, {"type": "subtitle", "time": 16436.99, "timestamp": "04:33:56", "text": "売る"}]
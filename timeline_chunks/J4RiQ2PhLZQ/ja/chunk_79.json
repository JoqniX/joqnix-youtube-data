[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "私はそれをする必要がある、なぜならそれは目に見えるから"}, {"type": "subtitle", "time": 4742.47, "timestamp": "01:19:02", "text": "私はします。さあ、私と一緒にいて。これは"}, {"type": "subtitle", "time": 4749.99, "timestamp": "01:19:09", "text": "壁が青だったら、"}, {"type": "subtitle", "time": 4758.39, "timestamp": "01:19:18", "text": "はい。では、手短にやります。わかった、"}, {"type": "subtitle", "time": 4767.11, "timestamp": "01:19:27", "text": "お金。私のお金を使ってください。では、待ってください。停止。"}, {"type": "subtitle", "time": 4769.189, "timestamp": "01:19:29", "text": "待って。停止。"}, {"type": "subtitle", "time": 4777.47, "timestamp": "01:19:37", "text": "カメラ？"}, {"type": "subtitle", "time": 4787.43, "timestamp": "01:19:47", "text": "カエル。こんにちは、ちょっとだけ。よし、行こう"}, {"type": "subtitle", "time": 4793.39, "timestamp": "01:19:53", "text": "信じる。"}, {"type": "subtitle", "time": 4795.87, "timestamp": "01:19:55", "text": "友達、買う"}]
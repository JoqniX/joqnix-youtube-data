[{"type": "subtitle", "time": 18842.11, "timestamp": "05:14:02", "text": "みんな。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 18846.75, "timestamp": "05:14:06", "text": "こんにちは。ようこそ。ようこそ。"}, {"type": "subtitle", "time": 18849.55, "timestamp": "05:14:09", "text": "えーと、私たちは"}, {"type": "subtitle", "time": 18851.628, "timestamp": "05:14:11", "text": "とのコラボレーション"}, {"type": "subtitle", "time": 18857.11, "timestamp": "05:14:17", "text": "Arashar は、現在 Twitch でライブ配信中です。"}, {"type": "subtitle", "time": 18858.67, "timestamp": "05:14:18", "text": "私は"}, {"type": "subtitle", "time": 18863.19, "timestamp": "05:14:23", "text": "正しい。フォクシー少年を見せてくれ。えっと"}, {"type": "subtitle", "time": 18865.51, "timestamp": "05:14:25", "text": "1秒。うん、彼は生放送中だよ。だから私たちは"}, {"type": "subtitle", "time": 18870.23, "timestamp": "05:14:30", "text": "もう少ししたら彼を起こします。えっと、私がやります"}, {"type": "subtitle", "time": 18884.31, "timestamp": "05:14:44", "text": "ええと、本当に激しい雨が降っています"}, {"type": "subtitle", "time": 18888.59, "timestamp": "05:14:48", "text": "ここは痛みですが"}, {"type": "subtitle", "time": 18892.23, "timestamp": "05:14:52", "text": "うん、今日はベストを尽くして"}, {"type": "subtitle", "time": 18892.99, "timestamp": "05:14:52", "text": "楽しい"}, {"type": "subtitle", "time": 18895.19, "timestamp": "05:14:55", "text": "みんな。皆さんが"}, {"type": "subtitle", "time": 18898.23, "timestamp": "05:14:58", "text": "ストリームは正しく見ることができますが、"}]
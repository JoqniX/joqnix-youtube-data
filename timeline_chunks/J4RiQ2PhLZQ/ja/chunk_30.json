[{"type": "subtitle", "time": 1804.07, "timestamp": "00:30:04", "text": "うん。スズクを購読してください。私は"}, {"type": "subtitle", "time": 1807.75, "timestamp": "00:30:07", "text": "今週はCRT関連の文字列が多かった。はい。"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "購読する。"}, {"type": "subtitle", "time": 1812.31, "timestamp": "00:30:12", "text": "ああ、紙のブレスレットはとても"}, {"type": "subtitle", "time": 1816.789, "timestamp": "00:30:16", "text": "美しい。どれ？"}, {"type": "subtitle", "time": 1819.99, "timestamp": "00:30:19", "text": "ああ、これだ。"}, {"type": "subtitle", "time": 1823.789, "timestamp": "00:30:23", "text": "うん。そうそう。"}, {"type": "subtitle", "time": 1825.63, "timestamp": "00:30:25", "text": "蝶。それ"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "それはアイデアだった。蝶々をありがとう"}, {"type": "subtitle", "time": 1832.389, "timestamp": "00:30:32", "text": "あれ。皆さん、おやすみなさい。気をつけて。"}, {"type": "subtitle", "time": 1842.95, "timestamp": "00:30:42", "text": "あ、待って。私に見せるべきでしょうか？"}, {"type": "subtitle", "time": 1846.149, "timestamp": "00:30:46", "text": "それって配信中なの？いいえ、見ることができます"}, {"type": "subtitle", "time": 1848.389, "timestamp": "00:30:48", "text": "それ。本当に気持ち悪い。どうすればいいのかわからない"}, {"type": "subtitle", "time": 1850.47, "timestamp": "00:30:50", "text": "それは来た。"}, {"type": "subtitle", "time": 1852.87, "timestamp": "00:30:52", "text": "大丈夫。"}, {"type": "subtitle", "time": 1855.149, "timestamp": "00:30:55", "text": "バイバイ。"}]
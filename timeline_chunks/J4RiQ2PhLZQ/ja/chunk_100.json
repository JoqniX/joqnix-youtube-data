[{"type": "subtitle", "time": 6002.189, "timestamp": "01:40:02", "text": "雑貨屋で買ったものです。攻撃が必要だ"}, {"type": "subtitle", "time": 6005.27, "timestamp": "01:40:05", "text": "ゼリー。ありがとう。あのね？以来"}, {"type": "subtitle", "time": 6007.57, "timestamp": "01:40:07", "text": "私はここにいます、私はすべて買います"}, {"type": "subtitle", "time": 6009.149, "timestamp": "01:40:09", "text": "[音楽]"}, {"type": "subtitle", "time": 6012.75, "timestamp": "01:40:12", "text": "これ。そして私はこれを買うつもりです。"}, {"type": "subtitle", "time": 6016.43, "timestamp": "01:40:16", "text": "あまりにも。あのね？購入します"}, {"type": "subtitle", "time": 6020.55, "timestamp": "01:40:20", "text": "これ。私は気にしません。レベルアップしたい"}, {"type": "subtitle", "time": 6021.39, "timestamp": "01:40:21", "text": "彼"}, {"type": "subtitle", "time": 6025.43, "timestamp": "01:40:25", "text": "上。彼をレベルアップさせなければならない。"}, {"type": "subtitle", "time": 6032.55, "timestamp": "01:40:32", "text": "する。ええと、これですね。ああ、私は9人います"}, {"type": "subtitle", "time": 6036.95, "timestamp": "01:40:36", "text": "彼らのうちの。ああ、これはランダムな質問ですね。ああ、私たちは"}, {"type": "subtitle", "time": 6039.109, "timestamp": "01:40:39", "text": "攻撃は1回、進化はたくさん"}, {"type": "subtitle", "time": 6042.87, "timestamp": "01:40:42", "text": "果物、三つ星の光、そして火。"}, {"type": "subtitle", "time": 6044.51, "timestamp": "01:40:44", "text": "おお、"}, {"type": "subtitle", "time": 6047.75, "timestamp": "01:40:47", "text": "良い。さて、これについては、私はこれを選びます"}, {"type": "subtitle", "time": 6049.669, "timestamp": "01:40:49", "text": "1つ。"}, {"type": "subtitle", "time": 6052.79, "timestamp": "01:40:52", "text": "待って、もし私がオルベロスのレベルを上げ続けたら、"}, {"type": "subtitle", "time": 6055.59, "timestamp": "01:40:55", "text": "もう片方はどうですか？暗闇が必要"}, {"type": "subtitle", "time": 6057.629, "timestamp": "01:40:57", "text": "一つも。私は"}]
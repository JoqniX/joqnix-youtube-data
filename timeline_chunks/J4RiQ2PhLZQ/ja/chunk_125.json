[{"type": "subtitle", "time": 7505.51, "timestamp": "02:05:05", "text": "報酬を受け取るには、ニノのことも確認してください。"}, {"type": "subtitle", "time": 7507.35, "timestamp": "02:05:07", "text": "何が起こっていますか？クエストが完了しました。"}, {"type": "subtitle", "time": 7532.07, "timestamp": "02:05:32", "text": "ブースト。よし。この件は解決したい。"}, {"type": "subtitle", "time": 7548.07, "timestamp": "02:05:48", "text": "それ。心配しないで、シャドウ。私たちがやるから。"}, {"type": "subtitle", "time": 7555.91, "timestamp": "02:05:55", "text": "終わり。そしてたった2、2、2、サタルだけ"}, {"type": "subtitle", "time": 7559.35, "timestamp": "02:05:59", "text": "クエスト終了。それは良い兆候だ。"}]
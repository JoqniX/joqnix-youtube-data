[{"type": "subtitle", "time": 15606.67, "timestamp": "04:20:06", "text": "[音楽]"}, {"type": "subtitle", "time": 15610.229, "timestamp": "04:20:10", "text": "でも私はノートパソコンを保管して、"}, {"type": "subtitle", "time": 15637.149, "timestamp": "04:20:37", "text": "彼に通報されたくない。私は"}, {"type": "subtitle", "time": 15640.99, "timestamp": "04:20:40", "text": "まるで私が行きたいという欲求のように"}]
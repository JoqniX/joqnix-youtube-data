[{"type": "subtitle", "time": 7320.75, "timestamp": "02:02:00", "text": "これを自動で実行します"}, {"type": "subtitle", "time": 7324.55, "timestamp": "02:02:04", "text": "AI の機能がオンになっていないことを確認してください"}, {"type": "subtitle", "time": 7326.99, "timestamp": "02:02:06", "text": "この"}, {"type": "subtitle", "time": 7329.75, "timestamp": "02:02:09", "text": "底。これがオンになっている場合、オンのままになります。"}, {"type": "subtitle", "time": 7333.47, "timestamp": "02:02:13", "text": "暴徒と戦い、周囲を取り囲む"}, {"type": "subtitle", "time": 7336.629, "timestamp": "02:02:16", "text": "暴徒。ええ、だから私はそれを保管していないんです"}, {"type": "subtitle", "time": 7338.83, "timestamp": "02:02:18", "text": "自動"}, {"type": "subtitle", "time": 7341.91, "timestamp": "02:02:21", "text": "セミ。そして、必ずこの項目にチェックが入っていることを確認してください。それで、"}, {"type": "subtitle", "time": 7352.83, "timestamp": "02:02:32", "text": "そしてこれがオンになり、ディアブロの声が聞こえる"}, {"type": "subtitle", "time": 7354.75, "timestamp": "02:02:34", "text": "不死身。"}, {"type": "subtitle", "time": 7357.31, "timestamp": "02:02:37", "text": "ええと、"}, {"type": "subtitle", "time": 7360.669, "timestamp": "02:02:40", "text": "これは一体何ですか？何かありますか"}, {"type": "subtitle", "time": 7362.99, "timestamp": "02:02:42", "text": "ダウンロード？いいえ。"}, {"type": "subtitle", "time": 7366.589, "timestamp": "02:02:46", "text": "右。水を汲み出す獣。こんにちは。そして私は"}, {"type": "subtitle", "time": 7369.99, "timestamp": "02:02:49", "text": "ディアブロ イモータルズの音量を少し下げる"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "少し。ああ、ゲーム内でやりますよ。"}, {"type": "subtitle", "time": 7376.51, "timestamp": "02:02:56", "text": "それはゲーム内で行う必要があります。"}]
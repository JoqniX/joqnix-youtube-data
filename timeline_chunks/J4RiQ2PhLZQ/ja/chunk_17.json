[{"type": "subtitle", "time": 1037.27, "timestamp": "00:17:17", "text": "[音楽]"}, {"type": "subtitle", "time": 1039.23, "timestamp": "00:17:19", "text": "食べたい"}, {"type": "subtitle", "time": 1041.829, "timestamp": "00:17:21", "text": "何か。私は写真を見た"}, {"type": "subtitle", "time": 1044.309, "timestamp": "00:17:24", "text": "イチゴ入りのチョコレートケーキと"}, {"type": "subtitle", "time": 1047.549, "timestamp": "00:17:27", "text": "とても神々しい。"}, {"type": "subtitle", "time": 1049.51, "timestamp": "00:17:29", "text": "いちご。待って、あなたは好きですか"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "いちご？私はイチゴが大好きです。私は好きです"}, {"type": "subtitle", "time": 1056.71, "timestamp": "00:17:36", "text": "イチゴ。わーい。イチゴギャング。"}, {"type": "subtitle", "time": 1059.19, "timestamp": "00:17:39", "text": "特にチョコレートで覆われていると信じられています"}, {"type": "subtitle", "time": 1064.15, "timestamp": "00:17:44", "text": "[音楽]"}, {"type": "subtitle", "time": 1066.47, "timestamp": "00:17:46", "text": "チョコレートでコーティングされている。ああ、私は持っていません"}, {"type": "subtitle", "time": 1070.549, "timestamp": "00:17:50", "text": "それはまだ。私はただ、とても熱心だから"}, {"type": "subtitle", "time": 1074.15, "timestamp": "00:17:54", "text": "角をイチゴのように飾る。ええ、"}, {"type": "subtitle", "time": 1076.39, "timestamp": "00:17:56", "text": "私はイチゴが大好きなので、"}, {"type": "subtitle", "time": 1079.909, "timestamp": "00:17:59", "text": "いちご味のみのタイプのみを入手してください。"}]
[{"type": "subtitle", "time": 11825.03, "timestamp": "03:17:05", "text": "わかった。他の宝石を使って宝石のレベルを上げる"}, {"type": "subtitle", "time": 11828.429, "timestamp": "03:17:08", "text": "全く同じ形。"}, {"type": "subtitle", "time": 11831.349, "timestamp": "03:17:11", "text": "わかった。金を使用してグレードを上げます"}, {"type": "subtitle", "time": 11834.95, "timestamp": "03:17:14", "text": "最大レベルのジェム。ああ、わかりました。"}, {"type": "subtitle", "time": 11837.389, "timestamp": "03:17:17", "text": "最大レベルを上げる"}, {"type": "subtitle", "time": 11840.95, "timestamp": "03:17:20", "text": "最高位の6つの宝石の超越"}, {"type": "subtitle", "time": 11842.51, "timestamp": "03:17:22", "text": "取引に利用"}, {"type": "subtitle", "time": 11845.469, "timestamp": "03:17:25", "text": "重複。"}, {"type": "subtitle", "time": 11848.07, "timestamp": "03:17:28", "text": "ああ、抽出ツールが必要です"}, {"type": "subtitle", "time": 11849.99, "timestamp": "03:17:29", "text": "印刷物から宝石を抽出して機器に"}, {"type": "subtitle", "time": 11856.07, "timestamp": "03:17:36", "text": "刷り込み。だから私がやらなければならないことはこれです"}, {"type": "subtitle", "time": 11856.91, "timestamp": "03:17:36", "text": "1つ、"}, {"type": "subtitle", "time": 11867.75, "timestamp": "03:17:47", "text": "これ。そして、そのために私はこれを持っています。"}, {"type": "subtitle", "time": 11870.83, "timestamp": "03:17:50", "text": "私も刻印します"}, {"type": "subtitle", "time": 11875.269, "timestamp": "03:17:55", "text": "それはあなたへの贈り物です。私はたくさん持っています。私はあなたにあげました"}]
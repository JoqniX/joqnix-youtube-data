[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "ドーナツ。私がドーナツを食べたとき"}, {"type": "subtitle", "time": 18302.708, "timestamp": "05:05:02", "text": "初めて見たときは、「これは一体何だ？」と思いました。"}, {"type": "subtitle", "time": 18310.23, "timestamp": "05:05:10", "text": "良い。ピザも同じだ。同じ"}, {"type": "subtitle", "time": 18313.35, "timestamp": "05:05:13", "text": "ピザ。私はピザを食べたことがないが、食べたとき"}, {"type": "subtitle", "time": 18315.31, "timestamp": "05:05:15", "text": "私は「これは一体何なんだ魔法なのか」と思いました。"}, {"type": "chat", "time": 18320.555, "timestamp": "05:05:20", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Today's Guest - RXR https://x.com/RockXRawr| https://www.twitch.tv/rxr404 | you can multiwatch this collab here - https://onxa.link/i6QyR4wu"}, {"type": "subtitle", "time": 18328.39, "timestamp": "05:05:28", "text": "そして私が食べたことのないものの1つは"}, {"type": "subtitle", "time": 18331.83, "timestamp": "05:05:31", "text": "えーと、ワッフルとか。"}, {"type": "subtitle", "time": 18334.35, "timestamp": "05:05:34", "text": "私はそれしか見ていない。私はそれしか見えない"}, {"type": "subtitle", "time": 18338.628, "timestamp": "05:05:38", "text": "YouTubeとかで。私はそれを食べたことがない。"}, {"type": "subtitle", "time": 18341.15, "timestamp": "05:05:41", "text": "ワッフル、それから何？"}, {"type": "subtitle", "time": 18344.39, "timestamp": "05:05:44", "text": "それ以外？ワッフルとパンケーキをいただきます。全て"}, {"type": "subtitle", "time": 18345.23, "timestamp": "05:05:45", "text": "それ"}, {"type": "subtitle", "time": 18348.03, "timestamp": "05:05:48", "text": "もの。それらは"}]
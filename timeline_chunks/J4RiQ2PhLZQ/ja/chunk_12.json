[{"type": "subtitle", "time": 724.79, "timestamp": "00:12:04", "text": "うん。だから、私たちは何かを手に入れようと思った"}, {"type": "subtitle", "time": 729.43, "timestamp": "00:12:09", "text": "人々は、"}, {"type": "subtitle", "time": 732.629, "timestamp": "00:12:12", "text": "オフィスを借りているとか、そういうことです。それで"}, {"type": "subtitle", "time": 735.03, "timestamp": "00:12:15", "text": "私は懐疑的でした"}, {"type": "subtitle", "time": 736.949, "timestamp": "00:12:16", "text": "ストリーミングなど今は"}, {"type": "subtitle", "time": 739.11, "timestamp": "00:12:19", "text": "彼らが滞在しているなら、彼らにとっては多すぎる"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "夜勤か仕事か何か。"}, {"type": "subtitle", "time": 744.389, "timestamp": "00:12:24", "text": "ありがたいことに最終決定はしなかったので、"}, {"type": "subtitle", "time": 746.99, "timestamp": "00:12:26", "text": "まだ平和な"}, {"type": "subtitle", "time": 750.31, "timestamp": "00:12:30", "text": "ホラーストリームの時間だから、私は叫びます"}, {"type": "subtitle", "time": 751.79, "timestamp": "00:12:31", "text": "泣くように"}, {"type": "subtitle", "time": 755.79, "timestamp": "00:12:35", "text": "死にかけの人、または"}, {"type": "subtitle", "time": 757.71, "timestamp": "00:12:37", "text": "何か。だから私は"}, {"type": "subtitle", "time": 760.71, "timestamp": "00:12:40", "text": "痛みのように。"}, {"type": "subtitle", "time": 763.75, "timestamp": "00:12:43", "text": "みんな、私のメカとキアラを見た？"}, {"type": "subtitle", "time": 765.35, "timestamp": "00:12:45", "text": "勉強？"}, {"type": "subtitle", "time": 768.31, "timestamp": "00:12:48", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 774.15, "timestamp": "00:12:54", "text": "[音楽]"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "アメリカであなた様のコスプレイヤーを見かけました。"}]
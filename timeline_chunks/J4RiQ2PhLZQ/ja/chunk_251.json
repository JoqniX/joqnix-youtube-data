[{"type": "subtitle", "time": 15068.71, "timestamp": "04:11:08", "text": "そして彼女は、彼女は"}, {"type": "subtitle", "time": 15073.15, "timestamp": "04:11:13", "text": "時々撃つだけです。消え失せろ。くそ"}, {"type": "subtitle", "time": 15076.71, "timestamp": "04:11:16", "text": "オフ。でも君は赤毛だから、"}, {"type": "subtitle", "time": 15097.59, "timestamp": "04:11:37", "text": "[音楽]"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "かわいい？この物語をここまで進めてください。私は"}, {"type": "subtitle", "time": 15119.15, "timestamp": "04:11:59", "text": "[音楽]"}]
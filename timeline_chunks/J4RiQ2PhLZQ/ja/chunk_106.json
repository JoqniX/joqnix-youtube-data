[{"type": "subtitle", "time": 6360.35, "timestamp": "01:46:00", "text": "する？冬よ、来い。うん。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 6362.709, "timestamp": "01:46:02", "text": "いらっしゃいませ。待って、これって初めてなの？"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "ええ、初めてだと思います。"}, {"type": "subtitle", "time": 6387.669, "timestamp": "01:46:27", "text": "チャットが中断された。えっと、私の母は"}, {"type": "subtitle", "time": 6390.709, "timestamp": "01:46:30", "text": "電話がかかってきた。待って。そして、ようこそ。いらっしゃいませ。"}, {"type": "subtitle", "time": 6393.119, "timestamp": "01:46:33", "text": "いらっしゃいませ。 いいえ、初めてではありません。ああ、私は"}, {"type": "subtitle", "time": 6395.36, "timestamp": "01:46:35", "text": "いいえ、初めてではありません。ああ、私は 初めてだと思ったよ、だって"}, {"type": "subtitle", "time": 6397.84, "timestamp": "01:46:37", "text": "初めてだと思ったよ、だって アバターだと思ったから"}, {"type": "subtitle", "time": 6401.239, "timestamp": "01:46:41", "text": "アバターだと思ったから 私はそう思わない"}, {"type": "subtitle", "time": 6407.55, "timestamp": "01:46:47", "text": "知る。どうでしたか"}, {"type": "subtitle", "time": 6411.43, "timestamp": "01:46:51", "text": "日？ええ、それで、ちょっと確認しに行かないといけないんです。"}, {"type": "subtitle", "time": 6414.07, "timestamp": "01:46:54", "text": "家族は物のために。わからない"}, {"type": "subtitle", "time": 6416.87, "timestamp": "01:46:56", "text": "隣人に何が起こっているのか"}, {"type": "subtitle", "time": 6419.99, "timestamp": "01:46:59", "text": "彼らが私の裏庭でやっていることよりひどい。だから私は"}]
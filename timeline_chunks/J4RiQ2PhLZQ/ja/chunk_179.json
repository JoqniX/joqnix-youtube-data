[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "避ける。なぜ？心配しないで、ラウナ。えっと、いとこ"}, {"type": "subtitle", "time": 10745.83, "timestamp": "02:59:05", "text": "Nouniは放置ゲームです。私は遊んでいました"}, {"type": "subtitle", "time": 10748.11, "timestamp": "02:59:08", "text": "私がやっている間、背景にはディアブロが映っていた"}, {"type": "subtitle", "time": 10758.389, "timestamp": "02:59:18", "text": "うん。うん。ギガンティギガントは倒せる"}, {"type": "subtitle", "time": 10759.95, "timestamp": "02:59:19", "text": "すでに。ええ、そうです。こんにちは"}, {"type": "subtitle", "time": 10768.55, "timestamp": "02:59:28", "text": "何をしているの？これで完了です。"}, {"type": "subtitle", "time": 10770.07, "timestamp": "02:59:30", "text": "他のすべてのチャンネル。ああ、私たちは"}, {"type": "subtitle", "time": 10772.71, "timestamp": "02:59:32", "text": "チャンネル14。実は、チャンネルは満員です。"}, {"type": "subtitle", "time": 10775.389, "timestamp": "02:59:35", "text": "えーと、みんな"}, {"type": "subtitle", "time": 10777.15, "timestamp": "02:59:37", "text": "満杯。"}, {"type": "subtitle", "time": 10779.87, "timestamp": "02:59:39", "text": "大丈夫。わかった。ええと、それは"}, {"type": "subtitle", "time": 10782.389, "timestamp": "02:59:42", "text": "終わり。さあ、クリスティンと"}, {"type": "subtitle", "time": 10784.429, "timestamp": "02:59:44", "text": "完了"}, {"type": "subtitle", "time": 10786.95, "timestamp": "02:59:46", "text": "クエスト。わかった。あなたは、えっと、あなたを見たことがありますか"}, {"type": "subtitle", "time": 10788.63, "timestamp": "02:59:48", "text": "医者に診てもらった。それは良かったです。"}, {"type": "subtitle", "time": 10791.19, "timestamp": "02:59:51", "text": "うん。昨日、私は眼科医の診察を受けました。"}, {"type": "subtitle", "time": 10794.15, "timestamp": "02:59:54", "text": "眼科医のところへ行った。どうやら私は"}, {"type": "subtitle", "time": 10796.429, "timestamp": "02:59:56", "text": "えっと"}, {"type": "subtitle", "time": 10799.429, "timestamp": "02:59:59", "text": "phototohobiaish と彼女は私に言った"}]
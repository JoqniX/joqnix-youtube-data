[{"type": "subtitle", "time": 13141.429, "timestamp": "03:39:01", "text": "巨大ではなく巨大、何て言うんだっけ"}, {"type": "subtitle", "time": 13145.75, "timestamp": "03:39:05", "text": "えっと、これって何て言うんだっけ？"}, {"type": "subtitle", "time": 13149.429, "timestamp": "03:39:09", "text": "銀色のひげを一本、彼はネックレスをくれるだろう"}, {"type": "subtitle", "time": 13160.07, "timestamp": "03:39:20", "text": "よし、今すぐやろう。でも君は"}, {"type": "subtitle", "time": 13162.55, "timestamp": "03:39:22", "text": "銀色のひげはとても難しいでしょう"}, {"type": "subtitle", "time": 13163.71, "timestamp": "03:39:23", "text": "人々は"}, {"type": "subtitle", "time": 13167.349, "timestamp": "03:39:27", "text": "ボスを常に倒すような"}, {"type": "subtitle", "time": 13171.99, "timestamp": "03:39:31", "text": "一発勝負だよね？だから、それはとても難しいでしょう"}, {"type": "subtitle", "time": 13174.67, "timestamp": "03:39:34", "text": "あなたのために"}, {"type": "subtitle", "time": 13182.389, "timestamp": "03:39:42", "text": "上。そしてこれもまた、工芸品"}, {"type": "subtitle", "time": 13184.71, "timestamp": "03:39:44", "text": "アクセサリー。銀熊を殺した後、"}, {"type": "subtitle", "time": 13187.95, "timestamp": "03:39:47", "text": "ワラ、彼らのネックレスは"}, {"type": "subtitle", "time": 13190.51, "timestamp": "03:39:50", "text": "[音楽]"}, {"type": "subtitle", "time": 13193.75, "timestamp": "03:39:53", "text": "ここ。以上だと思います。そしてまた、"}, {"type": "subtitle", "time": 13196.07, "timestamp": "03:39:56", "text": "うん。ああ、これもそうだ。あなたはできる"}, {"type": "subtitle", "time": 13199.67, "timestamp": "03:39:59", "text": "木製ヒューズバッジ用のポットを割る。あなた"}]
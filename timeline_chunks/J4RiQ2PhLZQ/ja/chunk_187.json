[{"type": "subtitle", "time": 11225.95, "timestamp": "03:07:05", "text": "待っている"}, {"type": "subtitle", "time": 11228.63, "timestamp": "03:07:08", "text": "戻る。残念ながら、類似点はありません"}, {"type": "subtitle", "time": 11230.55, "timestamp": "03:07:10", "text": "この強力なものを今すぐ破壊するにはどうすればいいのか。のために"}, {"type": "subtitle", "time": 11234.03, "timestamp": "03:07:14", "text": "今は、人目につかないようにしなければならない。"}, {"type": "subtitle", "time": 11237.349, "timestamp": "03:07:17", "text": "はい、彼はケインです。ケインが持っているカード"}, {"type": "subtitle", "time": 11240.349, "timestamp": "03:07:20", "text": "壁の石。おお。"}, {"type": "subtitle", "time": 11244.15, "timestamp": "03:07:24", "text": "彼が悪者になったら、"}, {"type": "subtitle", "time": 11246.389, "timestamp": "03:07:26", "text": "世界はどうなるのだろうか？何が"}, {"type": "subtitle", "time": 11256.63, "timestamp": "03:07:36", "text": "タル・ラシャの儀式は3つ目の"}, {"type": "subtitle", "time": 11265.11, "timestamp": "03:07:45", "text": "行く。魔法の言葉の石は"}, {"type": "subtitle", "time": 11270.79, "timestamp": "03:07:50", "text": "言葉。あなたはすでに"}, {"type": "subtitle", "time": 11272.83, "timestamp": "03:07:52", "text": "あなたに不利な動きをしている。でもあなたはそうではない"}, {"type": "subtitle", "time": 11275.429, "timestamp": "03:07:55", "text": "一人で。チャルスはもうすぐここに来るはずだ。私はできる"}, {"type": "subtitle", "time": 11277.11, "timestamp": "03:07:57", "text": "彼女を助けてくれる人は誰もいないと思う。見つける"}]
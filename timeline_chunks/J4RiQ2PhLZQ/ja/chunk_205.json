[{"type": "subtitle", "time": 12302.59, "timestamp": "03:25:02", "text": "私を見捨てて去ってしまった。何？"}, {"type": "subtitle", "time": 12305.87, "timestamp": "03:25:05", "text": "少年よ、そして君は"}, {"type": "subtitle", "time": 12308.91, "timestamp": "03:25:08", "text": "バックアー。なぜ辞めたのか"}, {"type": "subtitle", "time": 12314.07, "timestamp": "03:25:14", "text": "自分？あなたが行く。あんなことを言ってしまってすみません。私"}, {"type": "subtitle", "time": 12317.95, "timestamp": "03:25:17", "text": "英語が大好きです。 Oはあなたを英語で留めておきました。"}, {"type": "subtitle", "time": 12332.55, "timestamp": "03:25:32", "text": "平均？こんにちは、ぼやけた時間。"}, {"type": "subtitle", "time": 12334.309, "timestamp": "03:25:34", "text": "パスワードを終了しなければならないのは悲しいことです"}, {"type": "subtitle", "time": 12340.75, "timestamp": "03:25:40", "text": "時間。高い角度"}, {"type": "subtitle", "time": 12343.19, "timestamp": "03:25:43", "text": "時間。あなたはまだパーティーに参加していますよ。はい、"}, {"type": "subtitle", "time": 12345.429, "timestamp": "03:25:45", "text": "私は党内では必ず勝つだろう。はい、フォローします"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "パーティー。こんにちは、電源を入れてください。金メダルを目指そう"}]
[{"type": "subtitle", "time": 1860.71, "timestamp": "00:31:00", "text": "今日はここまで。本当に楽しかった"}, {"type": "subtitle", "time": 1865.669, "timestamp": "00:31:05", "text": "今回のコラボレーションも楽しみです。はい、そうしましょう。"}, {"type": "subtitle", "time": 1869.83, "timestamp": "00:31:09", "text": "そして私は休むだろう、なぜなら私は"}, {"type": "subtitle", "time": 1872.71, "timestamp": "00:31:12", "text": "忘れた。カフシロップを飲むのを忘れてしまった。"}, {"type": "subtitle", "time": 1875.59, "timestamp": "00:31:15", "text": "飲みます。はい。はい。薬を飲んでください。"}, {"type": "subtitle", "time": 1877.59, "timestamp": "00:31:17", "text": "掃除したいという気持ちすら全くない"}, {"type": "subtitle", "time": 1884.87, "timestamp": "00:31:24", "text": "おやすみ。こんにちは。おやすみ。さよなら。"}, {"type": "subtitle", "time": 1894.75, "timestamp": "00:31:34", "text": "エンディング。そして彼女は去っていった。"}, {"type": "subtitle", "time": 1898.47, "timestamp": "00:31:38", "text": "わーい。何が良いかが鍵だ。ありがとう"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "来てくださった皆様にも感謝いたします。待って、私は"}, {"type": "subtitle", "time": 1905.71, "timestamp": "00:31:45", "text": "カメラに映せると思う、"}, {"type": "subtitle", "time": 1909.549, "timestamp": "00:31:49", "text": "推測。ということで、"}, {"type": "subtitle", "time": 1912.549, "timestamp": "00:31:52", "text": "皆さん、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 1916.87, "timestamp": "00:31:56", "text": "ズキと一緒に楽しんでいただけましたか？"}]
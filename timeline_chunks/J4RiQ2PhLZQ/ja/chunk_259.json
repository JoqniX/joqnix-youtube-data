[{"type": "subtitle", "time": 15548.95, "timestamp": "04:19:08", "text": "乗り越えてください。登ってはいけません。しないでください"}, {"type": "subtitle", "time": 15564.83, "timestamp": "04:19:24", "text": "ただ、ただ"}, {"type": "subtitle", "time": 15579.67, "timestamp": "04:19:39", "text": "ああ、彼は私を見ている。彼は登っている"}, {"type": "subtitle", "time": 15583.71, "timestamp": "04:19:43", "text": "壁。ああ、これは"}, {"type": "subtitle", "time": 15586.389, "timestamp": "04:19:46", "text": "B. 私は殺したくない"}, {"type": "subtitle", "time": 15589.309, "timestamp": "04:19:49", "text": "彼。彼はとても貧しい"}, {"type": "subtitle", "time": 15593.149, "timestamp": "04:19:53", "text": "そうですね。あ、気にしないでください。"}, {"type": "subtitle", "time": 15596.269, "timestamp": "04:19:56", "text": "えっと、私はただ戦っているだけです"}]
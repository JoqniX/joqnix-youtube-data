[{"type": "subtitle", "time": 2343.03, "timestamp": "00:39:03", "text": "こんにちは。こんにちは。では、最後にまとめます。"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "ここ。皆さん、そして私も"}, {"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "本当に謝罪したいのですが"}, {"type": "subtitle", "time": 2352.069, "timestamp": "00:39:12", "text": "今日チャットした人たちと私がチャットしなかった人たち"}, {"type": "subtitle", "time": 2354.069, "timestamp": "00:39:14", "text": "あなたのチャットを読みましたが、それに気づきました"}, {"type": "subtitle", "time": 2357.349, "timestamp": "00:39:17", "text": "けれど。本日はありがとうございました。そうだった"}, {"type": "subtitle", "time": 2365.19, "timestamp": "00:39:25", "text": "楽しい。うん。そして私は自分自身を感じることができる"}, {"type": "subtitle", "time": 2366.19, "timestamp": "00:39:26", "text": "取得"}, {"type": "subtitle", "time": 2369.27, "timestamp": "00:39:29", "text": "脱水症状。私は水を飲まなければならない。する"}, {"type": "subtitle", "time": 2371.829, "timestamp": "00:39:31", "text": "これが私の水差しだって知ってる？それはあまりにも"}, {"type": "subtitle", "time": 2373.39, "timestamp": "00:39:33", "text": "大きい、"}, {"type": "subtitle", "time": 2374.91, "timestamp": "00:39:34", "text": "右？"}, {"type": "subtitle", "time": 2376.91, "timestamp": "00:39:36", "text": "それもそうだ"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "こんにちは。わかった。だから、掃除が必要で、"}, {"type": "subtitle", "time": 2393.63, "timestamp": "00:39:53", "text": "もの。そして私たちは最善を尽くしました"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "今日。やあ、また会おう"}, {"type": "subtitle", "time": 2397.79, "timestamp": "00:39:57", "text": "次のやつ。"}]
[{"type": "subtitle", "time": 12365.51, "timestamp": "03:26:05", "text": "えっと、イベントが終わるのを待っています"}, {"type": "subtitle", "time": 12369.59, "timestamp": "03:26:09", "text": "実際、私は"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "イベントが終わるのを待っているので、"}, {"type": "subtitle", "time": 12396.269, "timestamp": "03:26:36", "text": "そして彼はあなたの"}, {"type": "subtitle", "time": 12403.51, "timestamp": "03:26:43", "text": "あごひげ。そして、あなたがレベル2になると"}, {"type": "subtitle", "time": 12419.67, "timestamp": "03:26:59", "text": "在庫に空きを作るにはどうすればいいですか？あなた"}]
[{"type": "subtitle", "time": 6570.31, "timestamp": "01:49:30", "text": "戻ってきました。チャド、こっちへ来なさい。ここに来て。"}, {"type": "subtitle", "time": 6572.43, "timestamp": "01:49:32", "text": "ここに来て。ここに来て。ここに来て。来る"}, {"type": "subtitle", "time": 6580.709, "timestamp": "01:49:40", "text": "[音楽]"}, {"type": "subtitle", "time": 6583.27, "timestamp": "01:49:43", "text": "戻ってきました。戻ってきました。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "どうぞお入りください。お待ちしていないことを願っています。"}, {"type": "subtitle", "time": 6587.08, "timestamp": "01:49:47", "text": "君たちを"}, {"type": "subtitle", "time": 6588.75, "timestamp": "01:49:48", "text": "[音楽]"}, {"type": "subtitle", "time": 6592.55, "timestamp": "01:49:52", "text": "待って。では、最後にもう一つだけ"}, {"type": "subtitle", "time": 6594.51, "timestamp": "01:49:54", "text": "に"}, {"type": "subtitle", "time": 6598.43, "timestamp": "01:49:58", "text": "この冒険をしよう"}]
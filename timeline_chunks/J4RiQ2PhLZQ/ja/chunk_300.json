[{"type": "subtitle", "time": 18000.47, "timestamp": "05:00:00", "text": "[音楽]"}, {"type": "subtitle", "time": 18004.43, "timestamp": "05:00:04", "text": "それで、CP は"}, {"type": "subtitle", "time": 18007.11, "timestamp": "05:00:07", "text": "このキャラクターはキャラクターパワーをポイントします"}, {"type": "subtitle", "time": 18008.59, "timestamp": "05:00:08", "text": "から"}, {"type": "subtitle", "time": 18028.708, "timestamp": "05:00:28", "text": "私にとっては朝ですが、まだ何も食べていません"}, {"type": "subtitle", "time": 18035.59, "timestamp": "05:00:35", "text": "右。ああ、それは私たちの、それは私たちの、それは私たちの"}, {"type": "subtitle", "time": 18038.11, "timestamp": "05:00:38", "text": "それは私たちの それは私たちの"}, {"type": "subtitle", "time": 18040.03, "timestamp": "05:00:40", "text": "これ"}, {"type": "subtitle", "time": 18044.948, "timestamp": "05:00:44", "text": "世界と王室"}, {"type": "subtitle", "time": 18046.51, "timestamp": "05:00:46", "text": "プロテクター。"}, {"type": "subtitle", "time": 18049.15, "timestamp": "05:00:49", "text": "わーい。私たちは互いに話し合っています。さあ"}, {"type": "subtitle", "time": 18055.83, "timestamp": "05:00:55", "text": "私は新人であることを覚えておいてください、そして私は常に"}, {"type": "subtitle", "time": 18058.67, "timestamp": "05:00:58", "text": "見ている。"}]
[{"type": "subtitle", "time": 3783.27, "timestamp": "01:03:03", "text": "ストリーム。さあ行こう。そしてどうやら私は"}, {"type": "subtitle", "time": 3787.67, "timestamp": "01:03:07", "text": "このバグでは、"}, {"type": "subtitle", "time": 3790.63, "timestamp": "01:03:10", "text": "何かを見せて、場所が必要だと伝える"}, {"type": "subtitle", "time": 3793.99, "timestamp": "01:03:13", "text": "でも、私が必要とする場所は何もない"}, {"type": "subtitle", "time": 3826.67, "timestamp": "01:03:46", "text": "ゲーム。私は"}, {"type": "subtitle", "time": 3829.829, "timestamp": "01:03:49", "text": "それ。 3をたくさん入れるつもりです"}, {"type": "subtitle", "time": 3838.59, "timestamp": "01:03:58", "text": "横に置いて、私は信じています"}]
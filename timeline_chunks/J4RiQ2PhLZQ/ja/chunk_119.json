[{"type": "subtitle", "time": 7145.709, "timestamp": "01:59:05", "text": "えっと、それとも私はただ"}, {"type": "subtitle", "time": 7149.189, "timestamp": "01:59:09", "text": "プレイを続ける？わからない。それは"}, {"type": "subtitle", "time": 7153.55, "timestamp": "01:59:13", "text": "いいですよね？ストリームが見える"}, {"type": "subtitle", "time": 7156.79, "timestamp": "01:59:16", "text": "離れて、彼らは征服者をしています"}, {"type": "subtitle", "time": 7158.669, "timestamp": "01:59:18", "text": "マッシュ"}, {"type": "subtitle", "time": 7161.149, "timestamp": "01:59:21", "text": "人生"}, {"type": "subtitle", "time": 7174.83, "timestamp": "01:59:34", "text": "報酬請求権"}, {"type": "subtitle", "time": 7181.31, "timestamp": "01:59:41", "text": "それは"}, {"type": "subtitle", "time": 7193.27, "timestamp": "01:59:53", "text": "勝利のリチャージが利用可能です。私"}]
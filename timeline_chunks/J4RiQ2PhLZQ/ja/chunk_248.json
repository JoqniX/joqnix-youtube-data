[{"type": "subtitle", "time": 14884.389, "timestamp": "04:08:04", "text": "それ。待って。ああ、私は一度出てから参加する必要がある"}, {"type": "subtitle", "time": 14894.07, "timestamp": "04:08:14", "text": "わかった。立体的な境界線。そこには"}, {"type": "subtitle", "time": 14908.63, "timestamp": "04:08:28", "text": "1つ。ですから、先ほど申し上げたように、"}, {"type": "subtitle", "time": 14916.429, "timestamp": "04:08:36", "text": "1つ。そうそう。これを扱うお店があります。"}, {"type": "subtitle", "time": 14919.63, "timestamp": "04:08:39", "text": "実際、私たちはこれを手に入れます"}, {"type": "subtitle", "time": 14923.75, "timestamp": "04:08:43", "text": "フローズン・ラボラトリーより。おお。"}, {"type": "subtitle", "time": 14926.59, "timestamp": "04:08:46", "text": "冷凍食品から入手できます"}, {"type": "subtitle", "time": 14931.229, "timestamp": "04:08:51", "text": "研究室。おお。そしてこれがナウムです"}]
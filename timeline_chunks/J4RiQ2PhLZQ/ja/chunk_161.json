[{"type": "subtitle", "time": 9661.23, "timestamp": "02:41:01", "text": "分。うん、10だね"}, {"type": "subtitle", "time": 9664.59, "timestamp": "02:41:04", "text": "分。それでは、"}, {"type": "subtitle", "time": 9667.91, "timestamp": "02:41:07", "text": "クエスト。クエストを完了させる必要がある。"}, {"type": "subtitle", "time": 9669.87, "timestamp": "02:41:09", "text": "私は現場調査を行う予定です"}, {"type": "subtitle", "time": 9672.11, "timestamp": "02:41:12", "text": "ボス。"}, {"type": "subtitle", "time": 9680.71, "timestamp": "02:41:20", "text": "ああ、9分後に現れるよ。はい、私は"}, {"type": "subtitle", "time": 9683.87, "timestamp": "02:41:23", "text": "これを終わらせなければ。私の"}, {"type": "subtitle", "time": 9686.39, "timestamp": "02:41:26", "text": "眼鏡。"}, {"type": "subtitle", "time": 9689.07, "timestamp": "02:41:29", "text": "[音楽]"}, {"type": "subtitle", "time": 9693.07, "timestamp": "02:41:33", "text": "待って、えっと、何の話をしていたんだっけ？"}, {"type": "subtitle", "time": 9703.03, "timestamp": "02:41:43", "text": "忘れた。すっかり忘れていました。私は何者だったのか"}, {"type": "subtitle", "time": 9706.349, "timestamp": "02:41:46", "text": "何について話しているのですか？私の「どこ？」の声はどこ？"}, {"type": "subtitle", "time": 9708.19, "timestamp": "02:41:48", "text": "メートル？"}, {"type": "subtitle", "time": 9711.87, "timestamp": "02:41:51", "text": "えっと、私の声はどこ？"}, {"type": "subtitle", "time": 9713.55, "timestamp": "02:41:53", "text": "メートル？"}, {"type": "subtitle", "time": 9717.95, "timestamp": "02:41:57", "text": "えっと、クエストは完了しました。"}, {"type": "subtitle", "time": 9719.87, "timestamp": "02:41:59", "text": "わかった。"}]
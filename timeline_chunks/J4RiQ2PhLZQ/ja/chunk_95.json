[{"type": "subtitle", "time": 5700.07, "timestamp": "01:35:00", "text": "右。必ずマウント操作を行ってください。レベルアップ"}, {"type": "subtitle", "time": 5703.27, "timestamp": "01:35:03", "text": "あなたのマウント。つまり、主な目的は"}, {"type": "subtitle", "time": 5705.83, "timestamp": "01:35:05", "text": "CPパワーをレベルアップさせる。キャラクター"}, {"type": "subtitle", "time": 5708.47, "timestamp": "01:35:08", "text": "力。 200にしなければならない"}, {"type": "subtitle", "time": 5709.95, "timestamp": "01:35:09", "text": "あなたは"}, {"type": "subtitle", "time": 5712.149, "timestamp": "01:35:12", "text": "初心者。ゲームが進んでいるなら、"}, {"type": "subtitle", "time": 5715.189, "timestamp": "01:35:15", "text": "少なくとも500まで上げなければならない。あるいは彼らは"}, {"type": "subtitle", "time": 5718.629, "timestamp": "01:35:18", "text": "それを持ってください。ショーンとロスは"}, {"type": "subtitle", "time": 5722.27, "timestamp": "01:35:22", "text": "私よりもCPが高い。私にさせて"}, {"type": "subtitle", "time": 5727.149, "timestamp": "01:35:27", "text": "チェック。ええ、ショーンは365です。ロスは"}, {"type": "subtitle", "time": 5730.229, "timestamp": "01:35:30", "text": "301。そう、300に到達する必要があるんだ。"}, {"type": "subtitle", "time": 5733.39, "timestamp": "01:35:33", "text": "もうすぐリーグ戦が始まる。私は行き詰まっています"}, {"type": "subtitle", "time": 5745.27, "timestamp": "01:35:45", "text": "300. こんにちは。えっと、次は？ええと、私たちはできます"}, {"type": "subtitle", "time": 5749.51, "timestamp": "01:35:49", "text": "お馴染みの決闘。次はそれだ。"}, {"type": "subtitle", "time": 5752.229, "timestamp": "01:35:52", "text": "私たちならできる。敵を変えよう。行く"}, {"type": "subtitle", "time": 5754.79, "timestamp": "01:35:54", "text": "下位レベルの人々にとって"}, {"type": "subtitle", "time": 5758.83, "timestamp": "01:35:58", "text": "簡単に勝てる。私はこれを受け取ります"}]
[{"type": "subtitle", "time": 10446.23, "timestamp": "02:54:06", "text": "巨大。どうやら、"}, {"type": "subtitle", "time": 10448.63, "timestamp": "02:54:08", "text": "チャンネルを切り替える。目が痛む"}, {"type": "subtitle", "time": 10459.03, "timestamp": "02:54:19", "text": "今。そしてこれがボスです"}, {"type": "subtitle", "time": 10466.95, "timestamp": "02:54:26", "text": "即座に。ああ神様、絶対に行かないでください"}, {"type": "subtitle", "time": 10468.349, "timestamp": "02:54:28", "text": "赤い"}, {"type": "subtitle", "time": 10479.03, "timestamp": "02:54:39", "text": "なぜ？たくさんの人がいる。私は"}, {"type": "subtitle", "time": 10493.15, "timestamp": "02:54:53", "text": "避ける。彼はそうではない"}, {"type": "subtitle", "time": 10496.67, "timestamp": "02:54:56", "text": "終わり。大きなスラムがある"}]
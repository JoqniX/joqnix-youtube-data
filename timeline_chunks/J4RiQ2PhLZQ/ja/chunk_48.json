[{"type": "subtitle", "time": 2881.87, "timestamp": "00:48:01", "text": "同じものばかりだと退屈だ"}, {"type": "subtitle", "time": 2885.71, "timestamp": "00:48:05", "text": "バカバカバカミュージックすべて"}, {"type": "subtitle", "time": 2896.23, "timestamp": "00:48:16", "text": "もし、もし、昔の状態に戻りたいとしたら"}, {"type": "subtitle", "time": 2903.03, "timestamp": "00:48:23", "text": "Spotify、つまり、今まさにそれをやろうとしているところです"}, {"type": "subtitle", "time": 2906.549, "timestamp": "00:48:26", "text": "もし私が望めば。なぜ私が"}, {"type": "subtitle", "time": 2909.349, "timestamp": "00:48:29", "text": "もう一度同じことをするのはためらわれる。わからない"}, {"type": "subtitle", "time": 2912.47, "timestamp": "00:48:32", "text": "なぜなら、それは、それは、"}, {"type": "subtitle", "time": 2914.27, "timestamp": "00:48:34", "text": "昨日私は言った"}, {"type": "subtitle", "time": 2919.349, "timestamp": "00:48:39", "text": "まるで私たち二人が"}, {"type": "subtitle", "time": 2922.67, "timestamp": "00:48:42", "text": "一緒にチャットを楽しめます"}, {"type": "subtitle", "time": 2926.47, "timestamp": "00:48:46", "text": "それはとても素晴らしいことだろう。私は苦手です"}, {"type": "subtitle", "time": 2928.829, "timestamp": "00:48:48", "text": "音楽"}, {"type": "subtitle", "time": 2930.589, "timestamp": "00:48:50", "text": "選択する。"}, {"type": "subtitle", "time": 2934.39, "timestamp": "00:48:54", "text": "うん。こんにちは。えっと、ゲームを起動して、"}, {"type": "subtitle", "time": 2936.19, "timestamp": "00:48:56", "text": "意思"}]
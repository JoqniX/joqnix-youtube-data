[{"type": "subtitle", "time": 600.37, "timestamp": "00:10:00", "text": "プレイしてみて。しかもかなり安いよ。"}, {"type": "subtitle", "time": 603.19, "timestamp": "00:10:03", "text": "[音楽]"}, {"type": "subtitle", "time": 604.67, "timestamp": "00:10:04", "text": "ジョー、"}, {"type": "subtitle", "time": 608.389, "timestamp": "00:10:08", "text": "あなたは今どこに住んでいますか？は"}, {"type": "subtitle", "time": 611.509, "timestamp": "00:10:11", "text": "配信中に聞いても大丈夫ですか？私は自分の"}, {"type": "subtitle", "time": 614.55, "timestamp": "00:10:14", "text": "家。心配しないで。私は引っ越しました"}, {"type": "subtitle", "time": 618.67, "timestamp": "00:10:18", "text": "私が言っていたあの場所は、一時的にです。"}, {"type": "subtitle", "time": 622.069, "timestamp": "00:10:22", "text": "うん。うん。ここは私の配信部屋になります。"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "だから私は大きなテーブルとか色々持っているんです。"}, {"type": "subtitle", "time": 630.87, "timestamp": "00:10:30", "text": "しかし残念ながら、専用のオフィス。ええ、できます"}, {"type": "subtitle", "time": 634.47, "timestamp": "00:10:34", "text": "そんな風に言ってみて。私に"}, {"type": "subtitle", "time": 637.43, "timestamp": "00:10:37", "text": "配信外で部屋のツアーをしようぜ。私はまだ"}, {"type": "subtitle", "time": 640.23, "timestamp": "00:10:40", "text": "ドクが一度私を間違って呼んだのを覚えてる？"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "そして、私が何も言わなくても部屋を案内してくれた"}, {"type": "subtitle", "time": 647.43, "timestamp": "00:10:47", "text": "自業自得だ。ああ、ずいぶん昔のことだよね？"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "何てことだ。"}, {"type": "subtitle", "time": 653.67, "timestamp": "00:10:53", "text": "彼はちょうど目を覚ましたところだった。"}]
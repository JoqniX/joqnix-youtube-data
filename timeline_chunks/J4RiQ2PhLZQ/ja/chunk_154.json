[{"type": "subtitle", "time": 9242.71, "timestamp": "02:34:02", "text": "あれと音のやつが"}, {"type": "subtitle", "time": 9246.59, "timestamp": "02:34:06", "text": "音に関する感度を確認してください。"}, {"type": "subtitle", "time": 9251.349, "timestamp": "02:34:11", "text": "えっと、医者は私に相談するように言いました"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "医師。では、私はそれらを"}, {"type": "subtitle", "time": 9256.51, "timestamp": "02:34:16", "text": "今週か来週"}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "1週間程度。そして、犬が私に言った"}, {"type": "subtitle", "time": 9263.83, "timestamp": "02:34:23", "text": "私の氷と私のパワーレベルは"}, {"type": "subtitle", "time": 9266.469, "timestamp": "02:34:26", "text": "少し増えました。そして私はツイートしました"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "電力レベルについて"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "古いものと新しいものを入れ替えました。"}, {"type": "subtitle", "time": 9272.429, "timestamp": "02:34:32", "text": "うん。"}, {"type": "subtitle", "time": 9277.03, "timestamp": "02:34:37", "text": "他に何か？ええ、そうです。それで、私は"}, {"type": "subtitle", "time": 9281.59, "timestamp": "02:34:41", "text": "私の眼鏡は恐らく来週届くでしょう。男、"}, {"type": "subtitle", "time": 9285.23, "timestamp": "02:34:45", "text": "それは痛みだ。私は望んでいない。問題は"}, {"type": "subtitle", "time": 9288.469, "timestamp": "02:34:48", "text": "えっと、どうやら私は全く同じものを着ているようです"}, {"type": "subtitle", "time": 9293.19, "timestamp": "02:34:53", "text": "私のオリジナルキャラクターであるジョックンを現実世界で再現したメガネ姿。私は着ています"}, {"type": "subtitle", "time": 9296.03, "timestamp": "02:34:56", "text": "全く同じラウンド"}, {"type": "subtitle", "time": 9299.11, "timestamp": "02:34:59", "text": "眼鏡。私は全く同じ丸いものを着ています"}]
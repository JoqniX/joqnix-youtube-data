[{"type": "subtitle", "time": 7980.43, "timestamp": "02:13:00", "text": "ポイントと"}, {"type": "subtitle", "time": 7982.109, "timestamp": "02:13:02", "text": "もの。"}, {"type": "subtitle", "time": 7986.629, "timestamp": "02:13:06", "text": "面白い。ズル。ああ、ズーがここにいる。恋しい"}, {"type": "subtitle", "time": 7993.31, "timestamp": "02:13:13", "text": "オバカズ・マッドキングの"}, {"type": "subtitle", "time": 7996.91, "timestamp": "02:13:16", "text": "うーん、ミステリアス"}, {"type": "subtitle", "time": 8000.069, "timestamp": "02:13:20", "text": "装置。だから、これを"}, {"type": "subtitle", "time": 8002.87, "timestamp": "02:13:22", "text": "そして「石の破片」という言葉を復元する、ということですよね？"}, {"type": "subtitle", "time": 8009.069, "timestamp": "02:13:29", "text": "あの、あのクレイジーなUの学生"}, {"type": "subtitle", "time": 8013.229, "timestamp": "02:13:33", "text": "ズル。ええ、そうですね。だから、"}, {"type": "subtitle", "time": 8016.35, "timestamp": "02:13:36", "text": "私は行く必要がある 私は自分の"}, {"type": "subtitle", "time": 8020.99, "timestamp": "02:13:40", "text": "地図。えっと、ちょっと待って、ちょっと変えてみます"}, {"type": "subtitle", "time": 8024.229, "timestamp": "02:13:44", "text": "何か。音声出力。一体どういうことだ？"}, {"type": "subtitle", "time": 8026.03, "timestamp": "02:13:46", "text": "なぜそうなるのか"}, {"type": "subtitle", "time": 8028.109, "timestamp": "02:13:48", "text": "これ？"}, {"type": "subtitle", "time": 8035.669, "timestamp": "02:13:55", "text": "音声メーター入力。どこにいるの？"}, {"type": "subtitle", "time": 8038.229, "timestamp": "02:13:58", "text": "音声メーター入力。"}]
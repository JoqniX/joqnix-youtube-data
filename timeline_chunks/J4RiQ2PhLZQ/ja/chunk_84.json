[{"type": "subtitle", "time": 5040.75, "timestamp": "01:24:00", "text": "これ"}, {"type": "subtitle", "time": 5043.51, "timestamp": "01:24:03", "text": "ロボットによる損傷。"}, {"type": "subtitle", "time": 5051.65, "timestamp": "01:24:11", "text": "シールド。そして、エンジニア向けのものも一つ。なぜ"}, {"type": "subtitle", "time": 5058.09, "timestamp": "01:24:18", "text": "ない？よし。"}, {"type": "subtitle", "time": 5059.83, "timestamp": "01:24:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5080.55, "timestamp": "01:24:40", "text": "見る。ダンジョンでは、"}, {"type": "subtitle", "time": 5082.75, "timestamp": "01:24:42", "text": "これをしてください"}, {"type": "subtitle", "time": 5085.79, "timestamp": "01:24:45", "text": "ダンジョン。最初の課題ならできます。"}, {"type": "subtitle", "time": 5088.27, "timestamp": "01:24:48", "text": "実際は、2番目ではない。それは"}, {"type": "subtitle", "time": 5091.47, "timestamp": "01:24:51", "text": "難しい。最初のやつ。おお、"}, {"type": "subtitle", "time": 5094.229, "timestamp": "01:24:54", "text": "待って。リセットするにはお金を使うにはどうすればいいですか？"}, {"type": "subtitle", "time": 5099.87, "timestamp": "01:24:59", "text": "何？"}]
[{"type": "subtitle", "time": 14001.95, "timestamp": "03:53:21", "text": "来る"}, {"type": "subtitle", "time": 14004.59, "timestamp": "03:53:24", "text": "の上。手に入れないで"}, {"type": "subtitle", "time": 14013.63, "timestamp": "03:53:33", "text": "だから私はほとんど全部手に入れた"}, {"type": "subtitle", "time": 14016.55, "timestamp": "03:53:36", "text": "星4つの武器ですよね？私は必要なものを手に入れました"}, {"type": "subtitle", "time": 14019.95, "timestamp": "03:53:39", "text": "水のような第四の星と光だけ"}, {"type": "subtitle", "time": 14024.189, "timestamp": "03:53:44", "text": "四つ星。うん、ダーク4つ星を手に入れたよ"}, {"type": "subtitle", "time": 14028.389, "timestamp": "03:53:48", "text": "自然と炎、星4つ。私はただ"}, {"type": "subtitle", "time": 14030.87, "timestamp": "03:53:50", "text": "水と光が必要で、星4つです。"}]
[{"type": "subtitle", "time": 5283.87, "timestamp": "01:28:03", "text": "しかし私たちは"}, {"type": "subtitle", "time": 5293.47, "timestamp": "01:28:13", "text": "ロックを解除しますか？はい、レベル10です。では、"}, {"type": "subtitle", "time": 5297.51, "timestamp": "01:28:17", "text": "祝福とか、初心者の祝福とか"}, {"type": "subtitle", "time": 5300.149, "timestamp": "01:28:20", "text": "守護の祝福、ですよね？我々は出来た"}, {"type": "subtitle", "time": 5303.11, "timestamp": "01:28:23", "text": "これをレベルアップするが、私は"}, {"type": "subtitle", "time": 5323.99, "timestamp": "01:28:43", "text": "信じる。こんにちは。日々の活動。仕上げる"}]
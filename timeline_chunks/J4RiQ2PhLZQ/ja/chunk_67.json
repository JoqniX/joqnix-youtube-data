[{"type": "subtitle", "time": 4021.069, "timestamp": "01:07:01", "text": "作品。よし、それ"}, {"type": "subtitle", "time": 4030.23, "timestamp": "01:07:10", "text": "もっと。ああ、その上だ。はい、結構です。"}, {"type": "subtitle", "time": 4035.95, "timestamp": "01:07:15", "text": "1つ。全て"}, {"type": "subtitle", "time": 4039.069, "timestamp": "01:07:19", "text": "右。リンゴ、"}, {"type": "subtitle", "time": 4048.71, "timestamp": "01:07:28", "text": "そこには。同じように整列させたい"}, {"type": "subtitle", "time": 4051.069, "timestamp": "01:07:31", "text": "整列済み"}, {"type": "subtitle", "time": 4054.23, "timestamp": "01:07:34", "text": "整列しました。私はそれを中間に保つことができる、"}, {"type": "subtitle", "time": 4061.789, "timestamp": "01:07:41", "text": "保管しておきます"}, {"type": "subtitle", "time": 4066.109, "timestamp": "01:07:46", "text": "宇宙的。 1つはここに置いておきます"}, {"type": "subtitle", "time": 4074.109, "timestamp": "01:07:54", "text": "右。こんにちは。リンゴの木を蹴る時が来た。"}, {"type": "subtitle", "time": 4077.63, "timestamp": "01:07:57", "text": "１、２、"}, {"type": "subtitle", "time": 4079.309, "timestamp": "01:07:59", "text": "三つ。"}]
[{"type": "subtitle", "time": 17047.31, "timestamp": "04:44:07", "text": "良いものかどうかはわかりませんが、"}, {"type": "subtitle", "time": 17049.7, "timestamp": "04:44:09", "text": "しかし、調整させてください"}, {"type": "subtitle", "time": 17050.83, "timestamp": "04:44:10", "text": "[音楽]"}, {"type": "subtitle", "time": 17060.15, "timestamp": "04:44:20", "text": "経験したことがありますか"}, {"type": "subtitle", "time": 17062.99, "timestamp": "04:44:22", "text": "サングラスをかけている？だって私は着ているから"}, {"type": "subtitle", "time": 17066.23, "timestamp": "04:44:26", "text": "眼鏡。私にはできないと思う"}, {"type": "subtitle", "time": 17069.39, "timestamp": "04:44:29", "text": "それは大きなネコ科動物だ。えっと"}, {"type": "subtitle", "time": 17072.31, "timestamp": "04:44:32", "text": "サングラス。まだ試したことはないけど。使用済み"}, {"type": "subtitle", "time": 17080.11, "timestamp": "04:44:40", "text": "痛み。"}, {"type": "subtitle", "time": 17083.628, "timestamp": "04:44:43", "text": "見て。君を見てごらん。"}, {"type": "subtitle", "time": 17087.91, "timestamp": "04:44:47", "text": "ハワイ。こんにちは。どれか一つ選びます。待って。手に入れた"}]
[{"type": "subtitle", "time": 5762.72, "timestamp": "01:36:02", "text": "1つ。こんにちは。する"}, {"type": "subtitle", "time": 5765.75, "timestamp": "01:36:05", "text": "[拍手]"}, {"type": "subtitle", "time": 5767.149, "timestamp": "01:36:07", "text": "さあ"}, {"type": "subtitle", "time": 5771.27, "timestamp": "01:36:11", "text": "行く。見て、学ぼう。見て、学ぼう。"}, {"type": "subtitle", "time": 5775.229, "timestamp": "01:36:15", "text": "これはポケモンバトルか"}, {"type": "subtitle", "time": 5783.83, "timestamp": "01:36:23", "text": "ああ、大変だ。私の私の私の家族は"}, {"type": "subtitle", "time": 5788.35, "timestamp": "01:36:28", "text": "甚大な被害。彼らを見てごらん。どうですか"}, {"type": "subtitle", "time": 5791.39, "timestamp": "01:36:31", "text": "私？そして残りはあと1人。"}, {"type": "subtitle", "time": 5794.83, "timestamp": "01:36:34", "text": "す。ああ、彼は亡くなった。その"}, {"type": "subtitle", "time": 5809.03, "timestamp": "01:36:49", "text": "こんにちは。これは素晴らしい。このジャンプが大好き"}, {"type": "subtitle", "time": 5811.75, "timestamp": "01:36:51", "text": "フレームストップのようなもの。スローモーションみたいなやつ。"}]
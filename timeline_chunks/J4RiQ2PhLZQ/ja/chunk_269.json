[{"type": "subtitle", "time": 16143.189, "timestamp": "04:29:03", "text": "ネオン。ああ、今度は別の銃だ。見て"}, {"type": "subtitle", "time": 16146.189, "timestamp": "04:29:06", "text": "あなたの友達に。それはあなたの友達です"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "あなたたち二人は今、友達同士ですね。楽しむ"}, {"type": "subtitle", "time": 16172.429, "timestamp": "04:29:32", "text": "[音楽]"}, {"type": "subtitle", "time": 16182.05, "timestamp": "04:29:42", "text": "このスキルページには火が必要だ？"}]
[{"type": "subtitle", "time": 8701.309, "timestamp": "02:25:01", "text": "右。ディアブロ"}, {"type": "subtitle", "time": 8723.95, "timestamp": "02:25:23", "text": "まず、これらの手順を踏んでください。"}, {"type": "subtitle", "time": 8726.75, "timestamp": "02:25:26", "text": "ゲート？"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "こんにちは。橋の門にいるプリに話しかけてください。"}, {"type": "subtitle", "time": 8732.87, "timestamp": "02:25:32", "text": "誰か空いてる？また、ウェイポイントもあります"}, {"type": "subtitle", "time": 8737.59, "timestamp": "02:25:37", "text": "ロックを解除する必要があります。ああ、ロックが解除されている。わかった。"}, {"type": "subtitle", "time": 8746.429, "timestamp": "02:25:46", "text": "これ？"}, {"type": "subtitle", "time": 8752.99, "timestamp": "02:25:52", "text": "ああ、彼女は"}]
[{"type": "subtitle", "time": 9069.11, "timestamp": "02:31:09", "text": "目。ああ、ひどいヒットだった。ああ、大変だ。"}, {"type": "subtitle", "time": 9071.03, "timestamp": "02:31:11", "text": "あれはひどいヒットだった。私のはどこ？"}, {"type": "subtitle", "time": 9073.51, "timestamp": "02:31:13", "text": "キャップ？ギャップはどこにあるのか？待って、どこに"}, {"type": "subtitle", "time": 9076.309, "timestamp": "02:31:16", "text": "その差は？ギャップはどこにあるのか？ああ、わかりました。"}, {"type": "subtitle", "time": 9078.87, "timestamp": "02:31:18", "text": "わかった。箱はどこですか？待って、どこに"}, {"type": "subtitle", "time": 9082.79, "timestamp": "02:31:22", "text": "箱？私は盲目です。箱はどこですか？おお、"}, {"type": "subtitle", "time": 9083.79, "timestamp": "02:31:23", "text": "手に入れた"}, {"type": "subtitle", "time": 9090.99, "timestamp": "02:31:30", "text": "箱。私の"}, {"type": "subtitle", "time": 9094.389, "timestamp": "02:31:34", "text": "行く？こんにちは。私たちは今、無言で語り合っている。静かではない"}, {"type": "subtitle", "time": 9100.27, "timestamp": "02:31:40", "text": "話す。ええ、そうですね。"}, {"type": "subtitle", "time": 9103.07, "timestamp": "02:31:43", "text": "モー、そう、"}, {"type": "subtitle", "time": 9106.55, "timestamp": "02:31:46", "text": "今？ええと、準備ができました。時間が必要なだけです"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "実際、切手を貼る。うん、時間が必要だ"}, {"type": "subtitle", "time": 9112.11, "timestamp": "02:31:52", "text": "開始タイムスタンプ"}, {"type": "subtitle", "time": 9114.95, "timestamp": "02:31:54", "text": "昨日。だから、私たちは私たちがしたことをしました"}, {"type": "subtitle", "time": 9117.469, "timestamp": "02:31:57", "text": "昨日やったこと？忘れた。私たちは遊んだ"}]
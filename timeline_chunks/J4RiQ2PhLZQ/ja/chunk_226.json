[{"type": "subtitle", "time": 13560.83, "timestamp": "03:46:00", "text": "えっと、お店"}, {"type": "subtitle", "time": 13565.91, "timestamp": "03:46:05", "text": "メタルの支配。ええと、この2つがあります。"}, {"type": "subtitle", "time": 13569.389, "timestamp": "03:46:09", "text": "必要ない。我々はできる"}, {"type": "subtitle", "time": 13573.229, "timestamp": "03:46:13", "text": "魔法の墓が爆発する"}, {"type": "subtitle", "time": 13575.59, "timestamp": "03:46:15", "text": "充電。短時間。あのね？私は"}, {"type": "subtitle", "time": 13578.03, "timestamp": "03:46:18", "text": "空売りを買うつもりです"}, {"type": "subtitle", "time": 13597.189, "timestamp": "03:46:37", "text": "ダイヤモンドとキャラクタースキルを手に入れました"}, {"type": "subtitle", "time": 13600.79, "timestamp": "03:46:40", "text": "特別請求およびクレーム。私たちは"}, {"type": "subtitle", "time": 13604.91, "timestamp": "03:46:44", "text": "3つ目の枠を獲得しました。さあ"}, {"type": "subtitle", "time": 13608.309, "timestamp": "03:46:48", "text": "行く。右。だから、これらをレベルアップさせる必要がある"}, {"type": "subtitle", "time": 13611.189, "timestamp": "03:46:51", "text": "あまりにも。それもまた、面倒な作業だ。私"}]
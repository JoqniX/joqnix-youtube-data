[{"type": "subtitle", "time": 4219.47, "timestamp": "01:10:19", "text": "そして"}, {"type": "subtitle", "time": 4230.75, "timestamp": "01:10:30", "text": "椅子。小さなトゲトゲがここに来ます。"}, {"type": "subtitle", "time": 4234.51, "timestamp": "01:10:34", "text": "そして雪だるまは"}, {"type": "subtitle", "time": 4237.59, "timestamp": "01:10:37", "text": "黄色いI"}, {"type": "subtitle", "time": 4240.03, "timestamp": "01:10:40", "text": "[音楽]"}, {"type": "subtitle", "time": 4243.47, "timestamp": "01:10:43", "text": "信じる。私たちは彼を育てます"}, {"type": "subtitle", "time": 4245.87, "timestamp": "01:10:45", "text": "上。"}, {"type": "subtitle", "time": 4247.55, "timestamp": "01:10:47", "text": "はい。"}, {"type": "subtitle", "time": 4251.149, "timestamp": "01:10:51", "text": "こんにちは。あ、待って。彼は探している"}, {"type": "subtitle", "time": 4253.47, "timestamp": "01:10:53", "text": "異なる方法で。私たちは"}]
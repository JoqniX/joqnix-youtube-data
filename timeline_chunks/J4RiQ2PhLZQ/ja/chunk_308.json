[{"type": "subtitle", "time": 18483.708, "timestamp": "05:08:03", "text": "忘れる？"}, {"type": "subtitle", "time": 18488.47, "timestamp": "05:08:08", "text": "待って、それって普通のプリンからできてるの？待って、私は"}, {"type": "subtitle", "time": 18491.708, "timestamp": "05:08:11", "text": "忘れた。プリン用の飛行機って何？"}, {"type": "subtitle", "time": 18495.35, "timestamp": "05:08:15", "text": "また？待って、ちょっと待って。買わせてください"}, {"type": "subtitle", "time": 18508.99, "timestamp": "05:08:28", "text": "チャー。何"}, {"type": "subtitle", "time": 18515.07, "timestamp": "05:08:35", "text": "プリン？"}, {"type": "subtitle", "time": 18517.07, "timestamp": "05:08:37", "text": "待って。赤"}, {"type": "subtitle", "time": 18519.75, "timestamp": "05:08:39", "text": "プリン。ああ、これだ。これがそれだ"}, {"type": "subtitle", "time": 18521.55, "timestamp": "05:08:41", "text": "私"}, {"type": "subtitle", "time": 18526.67, "timestamp": "05:08:46", "text": "えっと、これは何ですか？うん、これだよ"}, {"type": "subtitle", "time": 18530.07, "timestamp": "05:08:50", "text": "けれど。フレイムプディングとは何ですか？それは"}, {"type": "subtitle", "time": 18533.27, "timestamp": "05:08:53", "text": "新しいもの。それは何ですか？それは何ですか？"}, {"type": "subtitle", "time": 18537.948, "timestamp": "05:08:57", "text": "待って、これは何？見た目は同じだ。"}]
[{"type": "subtitle", "time": 3848.47, "timestamp": "01:04:08", "text": "ああ、そうだ、青い、いや"}, {"type": "subtitle", "time": 3851.71, "timestamp": "01:04:11", "text": "水の弓は、イベントの後、"}, {"type": "subtitle", "time": 3854.63, "timestamp": "01:04:14", "text": "はい、イベントの後、私は"}, {"type": "subtitle", "time": 3857.549, "timestamp": "01:04:17", "text": "最終報酬。私はチャンピオンを選びます"}, {"type": "subtitle", "time": 3861.95, "timestamp": "01:04:21", "text": "お辞儀をしたら、もちろんグッチで行きますよ。"}, {"type": "subtitle", "time": 3870.19, "timestamp": "01:04:30", "text": "どうにか。 2つ調理する必要がある"}, {"type": "subtitle", "time": 3871.71, "timestamp": "01:04:31", "text": "偉業。"}, {"type": "subtitle", "time": 3874.15, "timestamp": "01:04:34", "text": "オブシディアン、これは明日には終わります。"}, {"type": "subtitle", "time": 3876.72, "timestamp": "01:04:36", "text": "王国防衛、我々はできる、私は"}, {"type": "subtitle", "time": 3878.91, "timestamp": "01:04:38", "text": "[音楽]"}, {"type": "subtitle", "time": 3882.99, "timestamp": "01:04:42", "text": "信じる。プリズム、それは実行されるでしょう"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "明日。クエスト5つのうち1つ目。それ"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "時間がかかるかもしれません。私は何なのかわかりません"}, {"type": "subtitle", "time": 3896.39, "timestamp": "01:04:56", "text": "それ。王国で料理を作る。"}, {"type": "subtitle", "time": 3899.029, "timestamp": "01:04:59", "text": "Zungストアで購入してください。そうします"}]
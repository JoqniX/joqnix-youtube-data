[{"type": "subtitle", "time": 4265.79, "timestamp": "01:11:05", "text": "雪だるま。この目標を掲げて"}, {"type": "subtitle", "time": 4267.47, "timestamp": "01:11:07", "text": "のように"}, {"type": "subtitle", "time": 4269.95, "timestamp": "01:11:09", "text": "待って。ああ、できるよ"}, {"type": "subtitle", "time": 4273.99, "timestamp": "01:11:13", "text": "それ。私ならできます。 H. それは"}, {"type": "subtitle", "time": 4275.79, "timestamp": "01:11:15", "text": "ゴール？それは"}, {"type": "subtitle", "time": 4278.59, "timestamp": "01:11:18", "text": "ゴール。それは"}, {"type": "subtitle", "time": 4281.55, "timestamp": "01:11:21", "text": "ゴール。私 私 私"}, {"type": "subtitle", "time": 4285.91, "timestamp": "01:11:25", "text": "私はゴールを決めた。何てことだ。"}, {"type": "subtitle", "time": 4288.99, "timestamp": "01:11:28", "text": "さあ行こう。さあ"}, {"type": "subtitle", "time": 4304.51, "timestamp": "01:11:44", "text": "[音楽]"}, {"type": "subtitle", "time": 4313.189, "timestamp": "01:11:53", "text": "楽しい。王国には虹色のカエルがいる。"}, {"type": "subtitle", "time": 4314.95, "timestamp": "01:11:54", "text": "え、何？"}]
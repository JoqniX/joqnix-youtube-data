[{"type": "subtitle", "time": 9541.309, "timestamp": "02:39:01", "text": "私が知らないコミュニティ"}, {"type": "subtitle", "time": 9544.87, "timestamp": "02:39:04", "text": "知っておくことは特に私が言及したこと"}, {"type": "subtitle", "time": 9547.23, "timestamp": "02:39:07", "text": "昨日Twitchで配信"}, {"type": "subtitle", "time": 9551.27, "timestamp": "02:39:11", "text": "えっと、YouTubeが始まったから"}, {"type": "subtitle", "time": 9554.63, "timestamp": "02:39:14", "text": "YouTube のように、最近作り始めた"}, {"type": "subtitle", "time": 9557.63, "timestamp": "02:39:17", "text": "ライブストリーミング関連APIの変更点"}, {"type": "subtitle", "time": 9560.309, "timestamp": "02:39:20", "text": "すべてなのでほとんどありません"}, {"type": "subtitle", "time": 9564.15, "timestamp": "02:39:24", "text": "Twitchのような機能には、"}, {"type": "subtitle", "time": 9565.91, "timestamp": "02:39:25", "text": "私たちは、"}, {"type": "subtitle", "time": 9568.469, "timestamp": "02:39:28", "text": "インタラクティブな、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 9571.87, "timestamp": "02:39:31", "text": "タッチ操作のやつ。どこにあるの？どこ"}, {"type": "subtitle", "time": 9586.87, "timestamp": "02:39:46", "text": "ボタン？だから、いつでもどこにでも触れると"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "画面はこのように、"}, {"type": "subtitle", "time": 9592.63, "timestamp": "02:39:52", "text": "猫はこんな感じ。そしてこれは"}, {"type": "subtitle", "time": 9595.19, "timestamp": "02:39:55", "text": "現在TwitchでTwitchにて"}, {"type": "subtitle", "time": 9598.55, "timestamp": "02:39:58", "text": "ビデオプレーヤー。それは不可能です"}]
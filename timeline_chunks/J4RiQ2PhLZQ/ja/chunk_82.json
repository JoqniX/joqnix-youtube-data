[{"type": "subtitle", "time": 4920.91, "timestamp": "01:22:00", "text": "この修正も4,000なので、"}, {"type": "subtitle", "time": 4924.03, "timestamp": "01:22:04", "text": "お金がかかる"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "他に何を変えられるだろうか、これは何だ"}, {"type": "subtitle", "time": 4931.229, "timestamp": "01:22:11", "text": "これも"}, {"type": "subtitle", "time": 4940.43, "timestamp": "01:22:20", "text": "像も必要となるため"}, {"type": "subtitle", "time": 4943.14, "timestamp": "01:22:23", "text": "プリズム"}, {"type": "subtitle", "time": 4945.07, "timestamp": "01:22:25", "text": "[音楽]"}, {"type": "subtitle", "time": 4947.95, "timestamp": "01:22:27", "text": "そうです。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 4951.669, "timestamp": "01:22:31", "text": "これをズームアップする。これはどうでしょう？これ"}, {"type": "subtitle", "time": 4954.45, "timestamp": "01:22:34", "text": "また、"}, {"type": "subtitle", "time": 4955.95, "timestamp": "01:22:35", "text": "[音楽]"}, {"type": "subtitle", "time": 4966.629, "timestamp": "01:22:46", "text": "待って、これで直った。"}, {"type": "subtitle", "time": 4970.51, "timestamp": "01:22:50", "text": "はい、大丈夫です。私は大丈夫です。戻る"}]
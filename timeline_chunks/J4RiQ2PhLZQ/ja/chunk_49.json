[{"type": "subtitle", "time": 2940.309, "timestamp": "00:49:00", "text": "あ、待って。私はライブ配信すらしていません。おお、"}, {"type": "subtitle", "time": 2954.15, "timestamp": "00:49:14", "text": "なれ。それはそうあるべきだ それはただそうだった それは今"}, {"type": "subtitle", "time": 2956.349, "timestamp": "00:49:16", "text": "私がライブ配信中であることを示す"}, {"type": "subtitle", "time": 2969.23, "timestamp": "00:49:29", "text": "分野。"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "待って、これでうまくいくはずだ。こんにちは、"}, {"type": "subtitle", "time": 2992.829, "timestamp": "00:49:52", "text": "負荷。私だけでしょうか？"}, {"type": "subtitle", "time": 2996.63, "timestamp": "00:49:56", "text": "それとも、それは私ですよね？しかしそうではない"}]
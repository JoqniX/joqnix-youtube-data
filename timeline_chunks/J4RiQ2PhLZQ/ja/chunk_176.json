[{"type": "subtitle", "time": 10562.23, "timestamp": "02:56:02", "text": "彼はそれを前もって実行に移そうと考えている。だから私たちは"}, {"type": "subtitle", "time": 10563.87, "timestamp": "02:56:03", "text": "時間がある"}, {"type": "subtitle", "time": 10569.11, "timestamp": "02:56:09", "text": "その男はHPが自動回復する"}, {"type": "subtitle", "time": 10570.11, "timestamp": "02:56:10", "text": "少し"}, {"type": "subtitle", "time": 10579.23, "timestamp": "02:56:19", "text": "普通"}, {"type": "subtitle", "time": 10582.15, "timestamp": "02:56:22", "text": "避ける。だからこそ、これはとても難しいのです。"}, {"type": "subtitle", "time": 10585.19, "timestamp": "02:56:25", "text": "ボス。みんなは何をしてるの？"}, {"type": "subtitle", "time": 10586.51, "timestamp": "02:56:26", "text": "チャンネル"}, {"type": "subtitle", "time": 10588.87, "timestamp": "02:56:28", "text": "サーバ？チャンネル3とチャンネル7は"}, {"type": "subtitle", "time": 10591.349, "timestamp": "02:56:31", "text": "終わり。あ、待って。避けろ、避けろ、避けろ。"}, {"type": "subtitle", "time": 10593.87, "timestamp": "02:56:33", "text": "はい、結構です。ナイス回避、"}, {"type": "subtitle", "time": 10597.269, "timestamp": "02:56:37", "text": "ジョック。チャンネル4、チャンネル7、チャンネル3は"}, {"type": "subtitle", "time": 10599.469, "timestamp": "02:56:39", "text": "私は死んだ。起きる、"}, {"type": "subtitle", "time": 10602.15, "timestamp": "02:56:42", "text": "お願いします。だから、すぐに動いて"}, {"type": "subtitle", "time": 10604.429, "timestamp": "02:56:44", "text": "このようにテレポートして自動"}, {"type": "subtitle", "time": 10609.03, "timestamp": "02:56:49", "text": "攻撃。私はまた死んだ。すぐに実行してください。"}, {"type": "subtitle", "time": 10611.07, "timestamp": "02:56:51", "text": "素早く行動しなければならない"}, {"type": "subtitle", "time": 10614.71, "timestamp": "02:56:54", "text": "めちゃくちゃ速く。超"}, {"type": "subtitle", "time": 10617.469, "timestamp": "02:56:57", "text": "めちゃくちゃ速いから、"}]
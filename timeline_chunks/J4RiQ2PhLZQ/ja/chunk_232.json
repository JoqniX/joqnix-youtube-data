[{"type": "subtitle", "time": 13925.429, "timestamp": "03:52:05", "text": "あるいはボロスよ、君のやりたいようにやってくれ。しかしローグは"}, {"type": "subtitle", "time": 13928.51, "timestamp": "03:52:08", "text": "楽しい。はい、彼女はとても"}, {"type": "subtitle", "time": 13932.189, "timestamp": "03:52:12", "text": "楽しい。 Rogueでプレイします"}, {"type": "subtitle", "time": 13942.83, "timestamp": "03:52:22", "text": "はい。"}, {"type": "subtitle", "time": 13945.63, "timestamp": "03:52:25", "text": "こんにちは。次。"}, {"type": "subtitle", "time": 13976.11, "timestamp": "03:52:56", "text": "ジョー。よし、"}]
[{"type": "subtitle", "time": 5358.709, "timestamp": "01:29:18", "text": "ハッチ。やり方がわからない"}, {"type": "subtitle", "time": 5361.669, "timestamp": "01:29:21", "text": "もの。なんてこった。私はこの３つを持っていません"}, {"type": "subtitle", "time": 5363.27, "timestamp": "01:29:23", "text": "星。"}, {"type": "subtitle", "time": 5372.85, "timestamp": "01:29:32", "text": "それ。本当にそう思います"}, {"type": "subtitle", "time": 5374.43, "timestamp": "01:29:34", "text": "[音楽]"}, {"type": "subtitle", "time": 5377.189, "timestamp": "01:29:37", "text": "それ。そして、パワーアップダンジョンもあります"}, {"type": "subtitle", "time": 5379.43, "timestamp": "01:29:39", "text": "そうですよね？それでは、デュアルヤードをやります。"}, {"type": "subtitle", "time": 5381.51, "timestamp": "01:29:41", "text": "右？"}, {"type": "subtitle", "time": 5384.39, "timestamp": "01:29:44", "text": "私がいつもしたいのは"}, {"type": "subtitle", "time": 5386.35, "timestamp": "01:29:46", "text": "下位"}, {"type": "subtitle", "time": 5390.55, "timestamp": "01:29:50", "text": "より低い地位の人々"}, {"type": "subtitle", "time": 5394.189, "timestamp": "01:29:54", "text": "キャラクターの強さは私より低い。これは彼"}, {"type": "subtitle", "time": 5397.43, "timestamp": "01:29:57", "text": "より高い。それはデュアルヤードです。それは、えーと"}]
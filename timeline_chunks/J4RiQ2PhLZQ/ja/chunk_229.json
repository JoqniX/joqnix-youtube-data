[{"type": "subtitle", "time": 13748.229, "timestamp": "03:49:08", "text": "これ。こんにちは、これは水ですよね？それで、"}, {"type": "subtitle", "time": 13751.87, "timestamp": "03:49:11", "text": "こちらを使います。"}, {"type": "subtitle", "time": 13753.87, "timestamp": "03:49:13", "text": "えっと"}, {"type": "subtitle", "time": 13757.99, "timestamp": "03:49:17", "text": "私たちの自然は弓を垂らす。チャンピオンの弓。ない"}, {"type": "subtitle", "time": 13760.59, "timestamp": "03:49:20", "text": "チャンピオンボール。何？これは何のボールですか？"}, {"type": "subtitle", "time": 13780.309, "timestamp": "03:49:40", "text": "行く。あ、自動設定を忘れてた。私は死んだ。私"}, {"type": "subtitle", "time": 13783.11, "timestamp": "03:49:43", "text": "自動設定を忘れていました。"}, {"type": "subtitle", "time": 13785.63, "timestamp": "03:49:45", "text": "バカイエロー"}, {"type": "subtitle", "time": 13789.11, "timestamp": "03:49:49", "text": "リトライ。私ならこれに勝てる。忘れてしまった"}]
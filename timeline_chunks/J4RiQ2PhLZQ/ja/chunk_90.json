[{"type": "subtitle", "time": 5400.39, "timestamp": "01:30:00", "text": "1対1の対戦。これをやらなければならない"}, {"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "しかし、毎日だ。待って、これはしないよ"}, {"type": "subtitle", "time": 5404.87, "timestamp": "01:30:04", "text": "バカ。"}, {"type": "subtitle", "time": 5408.149, "timestamp": "01:30:08", "text": "ありがとう。よし、この人にしよう。彼は"}, {"type": "subtitle", "time": 5413.43, "timestamp": "01:30:13", "text": "えっと、216で、私は244です。こんにちは。デュアルスタート。あなた"}, {"type": "subtitle", "time": 5417.59, "timestamp": "01:30:17", "text": "デュアルカー入場券を3枚入手"}, {"type": "subtitle", "time": 5430.669, "timestamp": "01:30:30", "text": "彼は彼は持っている"}, {"type": "subtitle", "time": 5435.83, "timestamp": "01:30:35", "text": "自分。ああ、彼は亡くなった。わーい。"}, {"type": "subtitle", "time": 5438.59, "timestamp": "01:30:38", "text": "ああ、毎日、毎週、いつでも"}, {"type": "subtitle", "time": 5441.54, "timestamp": "01:30:41", "text": "けれど。ああ、勝ったよ。"}, {"type": "subtitle", "time": 5447.99, "timestamp": "01:30:47", "text": "ニース。よし。続く。ということで、今回は"}]
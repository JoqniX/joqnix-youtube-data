[{"type": "subtitle", "time": 10681.67, "timestamp": "02:58:01", "text": "ほとんど。戻ってくる。こんにちは。こんにちは。ティアです。"}, {"type": "subtitle", "time": 10684.75, "timestamp": "02:58:04", "text": "戻って"}, {"type": "subtitle", "time": 10687.269, "timestamp": "02:58:07", "text": "ディアブロ。私が死んでも構わない。時間がかかります"}, {"type": "subtitle", "time": 10696.63, "timestamp": "02:58:16", "text": "ディアブロ。この橋を持つ男。役に立つかもしれない"}, {"type": "subtitle", "time": 10702.87, "timestamp": "02:58:22", "text": "お元気ですか？すべて順調です。はい、私は"}, {"type": "subtitle", "time": 10705.11, "timestamp": "02:58:25", "text": "よくやっている。私は目を奪うことを考えている"}, {"type": "subtitle", "time": 10708.71, "timestamp": "02:58:28", "text": "薬。目薬をさしました"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "さっき目薬をさしたんだけど、"}, {"type": "subtitle", "time": 10721.15, "timestamp": "02:58:41", "text": "もっと、私は新しいものを待っているような"}, {"type": "subtitle", "time": 10723.99, "timestamp": "02:58:43", "text": "メガネ、新しいレンズ、実は私の"}, {"type": "subtitle", "time": 10726.269, "timestamp": "02:58:46", "text": "パワーが増加しました"}, {"type": "subtitle", "time": 10729.67, "timestamp": "02:58:49", "text": "最近。ああ、ボスは"}, {"type": "subtitle", "time": 10737.63, "timestamp": "02:58:57", "text": "彼。避けろ、避けろ、"}]
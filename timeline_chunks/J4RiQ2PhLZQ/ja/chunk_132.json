[{"type": "subtitle", "time": 7945.75, "timestamp": "02:12:25", "text": "ボス。私は死んだ。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 7963.589, "timestamp": "02:12:43", "text": "戦利品？誤ってプレイヤーを招待してしまいましたか？"}, {"type": "subtitle", "time": 7973.43, "timestamp": "02:12:53", "text": "それ。ここは一体何ですか？何"}, {"type": "subtitle", "time": 7979.189, "timestamp": "02:12:59", "text": "この方法？ああ、私は方法を解除する必要がある"}]
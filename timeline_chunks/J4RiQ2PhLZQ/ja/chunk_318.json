[{"type": "subtitle", "time": 19083.72, "timestamp": "05:18:03", "text": "招待。 Twitchをチェック"}, {"type": "subtitle", "time": 19086.51, "timestamp": "05:18:06", "text": "[音楽]"}, {"type": "subtitle", "time": 19088.708, "timestamp": "05:18:08", "text": "通知。ああ、私のライト"}, {"type": "subtitle", "time": 19091.708, "timestamp": "05:18:11", "text": "文字通りフリーク"}, {"type": "subtitle", "time": 19094.788, "timestamp": "05:18:14", "text": "ちらついた。何てことだ。もしそうなった場合"}, {"type": "subtitle", "time": 19096.59, "timestamp": "05:18:16", "text": "起こる。おお"}, {"type": "subtitle", "time": 19099.708, "timestamp": "05:18:19", "text": "主よ、私は"}, {"type": "subtitle", "time": 19102.75, "timestamp": "05:18:22", "text": "トースト。私は"}, {"type": "subtitle", "time": 19104.51, "timestamp": "05:18:24", "text": "トースト。"}, {"type": "subtitle", "time": 19121.51, "timestamp": "05:18:41", "text": "おお。それはすばらしい。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 19123.948, "timestamp": "05:18:43", "text": "チャット機能が有効になりました。ニース。ニース。"}, {"type": "subtitle", "time": 19126.99, "timestamp": "05:18:46", "text": "ニース。良い。良い。"}, {"type": "subtitle", "time": 19130.47, "timestamp": "05:18:50", "text": "良い。すべては的確で、"}, {"type": "subtitle", "time": 19132.868, "timestamp": "05:18:52", "text": "場所。"}, {"type": "subtitle", "time": 19136.27, "timestamp": "05:18:56", "text": "私は興奮しています。だった"}, {"type": "subtitle", "time": 19137.54, "timestamp": "05:18:57", "text": "興奮した。"}]
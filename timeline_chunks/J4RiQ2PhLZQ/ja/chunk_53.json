[{"type": "subtitle", "time": 3183.19, "timestamp": "00:53:03", "text": "私もそう思いました。しかしどうやら"}, {"type": "subtitle", "time": 3185.829, "timestamp": "00:53:05", "text": "バカなスカーレット・ウィッチ、私。ああ、いやだ"}, {"type": "subtitle", "time": 3188.43, "timestamp": "00:53:08", "text": "スカーレット・ウィッチ。えっと、クリムゾンウィッチか"}, {"type": "subtitle", "time": 3191.15, "timestamp": "00:53:11", "text": "次はスカーレットが出なければならない"}, {"type": "subtitle", "time": 3193.87, "timestamp": "00:53:13", "text": "振り向く。小さい"}, {"type": "subtitle", "time": 3196.19, "timestamp": "00:53:16", "text": "コーラ。はい。"}, {"type": "subtitle", "time": 3202.75, "timestamp": "00:53:22", "text": "さあ"}, {"type": "subtitle", "time": 3205.309, "timestamp": "00:53:25", "text": "行く。ブレーカ。おお、"}, {"type": "subtitle", "time": 3210.44, "timestamp": "00:53:30", "text": "おお。今、私はレベル35です。ところで、私は"}, {"type": "subtitle", "time": 3214.27, "timestamp": "00:53:34", "text": "[音楽]"}, {"type": "subtitle", "time": 3218.51, "timestamp": "00:53:38", "text": "スカーレット・ミーを粉砕した。クリムゾンは"}, {"type": "subtitle", "time": 3225.309, "timestamp": "00:53:45", "text": "[音楽]"}, {"type": "subtitle", "time": 3228.79, "timestamp": "00:53:48", "text": "こんにちは。また、チャットで私にリマインダーを送る"}, {"type": "subtitle", "time": 3231.069, "timestamp": "00:53:51", "text": "点眼薬"}]
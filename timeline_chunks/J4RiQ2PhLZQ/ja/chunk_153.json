[{"type": "subtitle", "time": 9187.83, "timestamp": "02:33:07", "text": "でも、そうですね、あなたは"}, {"type": "subtitle", "time": 9189.99, "timestamp": "02:33:09", "text": "皆さんもこういうことやってますか？"}, {"type": "subtitle", "time": 9192.55, "timestamp": "02:33:12", "text": "まるで、あなたが無理をしているかのように、"}, {"type": "subtitle", "time": 9195.59, "timestamp": "02:33:15", "text": "PC は PC と同等のもの、または電話は同等のもの、その他"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "1時間か2時間以上。親密な関係が好きですか？"}, {"type": "subtitle", "time": 9199.99, "timestamp": "02:33:19", "text": "目を少し休ませて"}, {"type": "subtitle", "time": 9202.03, "timestamp": "02:33:22", "text": "あなたの"}, {"type": "subtitle", "time": 9205.19, "timestamp": "02:33:25", "text": "目を閉じて15分くらい"}, {"type": "subtitle", "time": 9207.59, "timestamp": "02:33:27", "text": "分、もしくは15分ではなく10分くらい"}, {"type": "subtitle", "time": 9209.75, "timestamp": "02:33:29", "text": "少なくとも、あるいは目の運動のように"}, {"type": "subtitle", "time": 9212.469, "timestamp": "02:33:32", "text": "目を健康に保つためのもの"}, {"type": "subtitle", "time": 9215.51, "timestamp": "02:33:35", "text": "無理なく、自然な感じ。わからない"}, {"type": "subtitle", "time": 9222.71, "timestamp": "02:33:42", "text": "それ。ああ、YouTubeの人たちは"}, {"type": "subtitle", "time": 9224.15, "timestamp": "02:33:44", "text": "みんな、何が起こったか知らないよね"}, {"type": "subtitle", "time": 9225.99, "timestamp": "02:33:45", "text": "昨日ですよね？ええ、どうやら"}, {"type": "subtitle", "time": 9229.51, "timestamp": "02:33:49", "text": "昨日、眼科医の診察を受けました。"}, {"type": "subtitle", "time": 9232.11, "timestamp": "02:33:52", "text": "昨日、眼科の予約がありました。"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "医者、はい、そうします、私は"}, {"type": "subtitle", "time": 9236.91, "timestamp": "02:33:56", "text": "持っている"}, {"type": "subtitle", "time": 9239.63, "timestamp": "02:33:59", "text": "光過敏症"}]
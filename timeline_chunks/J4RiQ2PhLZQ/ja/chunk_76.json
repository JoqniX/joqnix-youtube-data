[{"type": "subtitle", "time": 4562.709, "timestamp": "01:16:02", "text": "4つのクエスト。こんにちは。では、プリズムを200個用意してください。"}, {"type": "subtitle", "time": 4565.669, "timestamp": "01:16:05", "text": "そうします。そして、デュアルヤードファイブ"}, {"type": "subtitle", "time": 4569.03, "timestamp": "01:16:09", "text": "回。そうします。"}, {"type": "subtitle", "time": 4570.79, "timestamp": "01:16:10", "text": "ありがとう。"}, {"type": "subtitle", "time": 4573.79, "timestamp": "01:16:13", "text": "それを行う前に、少し話を戻しましょう。"}, {"type": "subtitle", "time": 4581.03, "timestamp": "01:16:21", "text": "カスタマイズ。えっと、全部買わないといけないの？"}, {"type": "subtitle", "time": 4588.95, "timestamp": "01:16:28", "text": "右？何をすればいいですか"}, {"type": "subtitle", "time": 4595.189, "timestamp": "01:16:35", "text": "しかし、価格が高くなるほど、"}, {"type": "subtitle", "time": 4596.79, "timestamp": "01:16:36", "text": "進むほど、値段も高くなります"}, {"type": "subtitle", "time": 4598.75, "timestamp": "01:16:38", "text": "行く。"}, {"type": "subtitle", "time": 4605.149, "timestamp": "01:16:45", "text": "すべて。"}, {"type": "subtitle", "time": 4608.51, "timestamp": "01:16:48", "text": "うん。そしてそれは王国に基づいています"}, {"type": "subtitle", "time": 4611.189, "timestamp": "01:16:51", "text": "通貨、人々が寄付する金額"}, {"type": "subtitle", "time": 4612.41, "timestamp": "01:16:52", "text": "そして"}]
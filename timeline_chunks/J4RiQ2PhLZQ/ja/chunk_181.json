[{"type": "subtitle", "time": 10860.07, "timestamp": "03:01:00", "text": "上。家族の強化。私ができること"}, {"type": "subtitle", "time": 10871.11, "timestamp": "03:01:11", "text": "それ以外？あらら。巨大。ええ、私たちは"}, {"type": "subtitle", "time": 10874.389, "timestamp": "03:01:14", "text": "とてつもなく大きなものだ。ああ、私たちはああ、私たちは"}, {"type": "subtitle", "time": 10876.79, "timestamp": "03:01:16", "text": "必要なものは手に入れました。あ、待って。見てみましょう。私"}, {"type": "subtitle", "time": 10879.11, "timestamp": "03:01:19", "text": "4つ星がもらえるといいな。"}, {"type": "subtitle", "time": 10881.67, "timestamp": "03:01:21", "text": "神様、お願いします。"}, {"type": "subtitle", "time": 10884.07, "timestamp": "03:01:24", "text": "星3つの痛み。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 10888.07, "timestamp": "03:01:28", "text": "大丈夫です。では、これはこれよりも良いのでしょうか？"}, {"type": "subtitle", "time": 10891.59, "timestamp": "03:01:31", "text": "つまり、このCPはレベル111で4000です。"}, {"type": "subtitle", "time": 10895.15, "timestamp": "03:01:35", "text": "私が今手に入れたのは"}, {"type": "subtitle", "time": 10897.309, "timestamp": "03:01:37", "text": "3,922。"}, {"type": "subtitle", "time": 10900.95, "timestamp": "03:01:40", "text": "Hギガンテリング。そしてこれは"}, {"type": "subtitle", "time": 10904.59, "timestamp": "03:01:44", "text": "ステリアリング。これはより良い指輪です、"}, {"type": "subtitle", "time": 10908.389, "timestamp": "03:01:48", "text": "信じる気持ちはあるが、防御力は低い。クリティカル率"}, {"type": "subtitle", "time": 10915.83, "timestamp": "03:01:55", "text": "138 使用時に水平調整を試してみることができます"}, {"type": "subtitle", "time": 10918.309, "timestamp": "03:01:58", "text": "イヤホンやスピーカーは使えません"}]
[{"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "では、私はこれに従います。えーと、"}, {"type": "subtitle", "time": 7628.43, "timestamp": "02:07:08", "text": "この経路。これは"}, {"type": "subtitle", "time": 7632.95, "timestamp": "02:07:12", "text": "レタスを殺して回復するために"}, {"type": "subtitle", "time": 7636.149, "timestamp": "02:07:16", "text": "壁石の破片。うん、ナガテ。だから私たちは"}, {"type": "subtitle", "time": 7639.35, "timestamp": "02:07:19", "text": "まるで新たな追放の重荷を背負うようなものになるだろう。それ"}, {"type": "subtitle", "time": 7640.99, "timestamp": "02:07:20", "text": "は"}, {"type": "subtitle", "time": 7645.03, "timestamp": "02:07:25", "text": "良い。ですから、そうします。ありますか"}, {"type": "subtitle", "time": 7649.03, "timestamp": "02:07:29", "text": "このゲームで歩く？分かりません。"}, {"type": "subtitle", "time": 7651.87, "timestamp": "02:07:31", "text": "ええ、自動ではありません"}, {"type": "subtitle", "time": 7655.51, "timestamp": "02:07:35", "text": "歩く。自動歩行機能はありません。それは"}]
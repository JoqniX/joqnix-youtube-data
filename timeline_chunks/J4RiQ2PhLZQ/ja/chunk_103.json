[{"type": "subtitle", "time": 6182.91, "timestamp": "01:43:02", "text": "なぜかわからないのですが"}, {"type": "subtitle", "time": 6186.629, "timestamp": "01:43:06", "text": "やめてください。だから私は最優先事項として"}, {"type": "subtitle", "time": 6189.87, "timestamp": "01:43:09", "text": "4つ星のように"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "実際は2、3人です。レベル20。よし。こんにちは。"}, {"type": "subtitle", "time": 6209.07, "timestamp": "01:43:29", "text": "これをCPでフィルタリングします。見てみましょう。三つ"}, {"type": "subtitle", "time": 6210.83, "timestamp": "01:43:30", "text": "初め。"}, {"type": "subtitle", "time": 6215.39, "timestamp": "01:43:35", "text": "ああ、わかった。水鳥は4位です。"}, {"type": "subtitle", "time": 6217.07, "timestamp": "01:43:37", "text": "わかった。"}, {"type": "subtitle", "time": 6224.51, "timestamp": "01:43:44", "text": "電車。"}, {"type": "subtitle", "time": 6227.83, "timestamp": "01:43:47", "text": "えっと、彼が2番目です。ああ、この男は"}, {"type": "subtitle", "time": 6230.03, "timestamp": "01:43:50", "text": "また、"}, {"type": "subtitle", "time": 6232.709, "timestamp": "01:43:52", "text": "アップグレードします。私はこれらを使いたくないのですが、"}, {"type": "subtitle", "time": 6238.99, "timestamp": "01:43:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4335.87, "timestamp": "01:12:15", "text": "バカミ。虹"}, {"type": "subtitle", "time": 4341.189, "timestamp": "01:12:21", "text": "蛙。元気ですか？元気ですか？"}, {"type": "subtitle", "time": 4343.55, "timestamp": "01:12:23", "text": "そして、それがミミです。"}, {"type": "subtitle", "time": 4348.31, "timestamp": "01:12:28", "text": "ああ、私たち二人ともオルロスを持っています。オルロス"}, {"type": "subtitle", "time": 4358.55, "timestamp": "01:12:38", "text": "行く。そして私たちはここに何かを入れる必要がある"}, {"type": "subtitle", "time": 4359.55, "timestamp": "01:12:39", "text": "遊ぶ。"}, {"type": "subtitle", "time": 4363.15, "timestamp": "01:12:43", "text": "実際、私は"}, {"type": "subtitle", "time": 4365.229, "timestamp": "01:12:45", "text": "[音楽]"}, {"type": "subtitle", "time": 4375.99, "timestamp": "01:12:55", "text": "そうはしないだろう。これは私が欲しいものです"}, {"type": "subtitle", "time": 4379.27, "timestamp": "01:12:59", "text": "私が変えたいのは主にその瞬間です"}]
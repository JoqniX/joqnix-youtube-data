[{"type": "subtitle", "time": 15732.63, "timestamp": "04:22:12", "text": "了解。ちょっと後で障害物コースに行ってきます。"}, {"type": "subtitle", "time": 15735.59, "timestamp": "04:22:15", "text": "ゴキブリを追い出せるといいな"}, {"type": "subtitle", "time": 15738.389, "timestamp": "04:22:18", "text": "私の足に飛んでこない。彼がそうするなら、"}, {"type": "subtitle", "time": 15740.99, "timestamp": "04:22:20", "text": "私は実際に"}, {"type": "subtitle", "time": 15743.79, "timestamp": "04:22:23", "text": "行く"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "ボンク。彼が見つからない。行かないで。どこ"}, {"type": "subtitle", "time": 15751.309, "timestamp": "04:22:31", "text": "あなたはどこで"}, {"type": "subtitle", "time": 15761.11, "timestamp": "04:22:41", "text": "[音楽]"}, {"type": "subtitle", "time": 15771.75, "timestamp": "04:22:51", "text": "ニース。ああ、またか。よし、1つやってみよう"}]
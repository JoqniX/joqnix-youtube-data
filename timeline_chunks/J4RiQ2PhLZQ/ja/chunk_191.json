[{"type": "subtitle", "time": 11461.03, "timestamp": "03:11:01", "text": "この地域のグループ。それはあなたに報いるでしょう"}, {"type": "subtitle", "time": 11464.23, "timestamp": "03:11:04", "text": "もっと良いアイテムや物で。それ"}, {"type": "subtitle", "time": 11467.11, "timestamp": "03:11:07", "text": "とても役に立つでしょう。それが私の仕事です"}, {"type": "subtitle", "time": 11469.75, "timestamp": "03:11:09", "text": "実際、私がいるときはいつでも"}, {"type": "subtitle", "time": 11472.389, "timestamp": "03:11:12", "text": "終わったらAIモードに切り替えます"}, {"type": "subtitle", "time": 11477.67, "timestamp": "03:11:17", "text": "日。えっと、ここでカスタムグループに参加するか、"}, {"type": "subtitle", "time": 11480.63, "timestamp": "03:11:20", "text": "私にできることは、今すぐそれをすることです"}, {"type": "subtitle", "time": 11483.99, "timestamp": "03:11:23", "text": "私がここにいるなら、あなたはどう思いますか？"}, {"type": "subtitle", "time": 11486.67, "timestamp": "03:11:26", "text": "それって何？えっと、行くと"}, {"type": "subtitle", "time": 11489.99, "timestamp": "03:11:29", "text": "設定、またはこれをチェック外して自動"}, {"type": "subtitle", "time": 11494.429, "timestamp": "03:11:34", "text": "承認するか、自動的に参加させる。それは"}, {"type": "subtitle", "time": 11497.91, "timestamp": "03:11:37", "text": "より多くの戦利品などを手に入れるのに役立ちます。"}, {"type": "subtitle", "time": 11500.469, "timestamp": "03:11:40", "text": "もっとお金と物。私が使ったのはそれです"}, {"type": "subtitle", "time": 11501.39, "timestamp": "03:11:41", "text": "に"}, {"type": "subtitle", "time": 11508.91, "timestamp": "03:11:48", "text": "する。そして私たちは"}, {"type": "subtitle", "time": 11510.99, "timestamp": "03:11:50", "text": "殺す。何が"}, {"type": "subtitle", "time": 11513.87, "timestamp": "03:11:53", "text": "これ？神秘的な宝石はどのようにして"}, {"type": "subtitle", "time": 11518.83, "timestamp": "03:11:58", "text": "力？ああ、わかりました。私たちはテレポートします"}]
[{"type": "subtitle", "time": 5644.03, "timestamp": "01:34:04", "text": "[音楽]"}, {"type": "subtitle", "time": 5646.03, "timestamp": "01:34:06", "text": "カワイイと出会う"}, {"type": "subtitle", "time": 5648.11, "timestamp": "01:34:08", "text": "卵"}, {"type": "subtitle", "time": 5652.39, "timestamp": "01:34:12", "text": "かわいい。こんにちは、承知いたしました。それで、もし私たちが"}, {"type": "subtitle", "time": 5654.51, "timestamp": "01:34:14", "text": "私たちの幼稚園を見てください"}, {"type": "subtitle", "time": 5657.83, "timestamp": "01:34:17", "text": "ミッション料理、えーと3つ"}, {"type": "subtitle", "time": 5659.629, "timestamp": "01:34:19", "text": "五。"}, {"type": "subtitle", "time": 5667.51, "timestamp": "01:34:27", "text": "右。なんてこった。これです。 2人に1人。"}, {"type": "subtitle", "time": 5670.95, "timestamp": "01:34:30", "text": "では、もう一度だけ、いい子にしててね。私はできる"}, {"type": "subtitle", "time": 5673.11, "timestamp": "01:34:33", "text": "私は料理ができると信じています。私はできません"}, {"type": "subtitle", "time": 5675.95, "timestamp": "01:34:35", "text": "料理する。わかった。だから、もっと見つける必要がある"}, {"type": "subtitle", "time": 5678.83, "timestamp": "01:34:38", "text": "この川には卵が生息している。"}, {"type": "subtitle", "time": 5684.11, "timestamp": "01:34:44", "text": "わかった。デュアルヤードをレベルアップしよう。えっと"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "成果達成のための装備。私はそれをします"}, {"type": "subtitle", "time": 5692.149, "timestamp": "01:34:52", "text": "少しだけ。マウンド。"}]
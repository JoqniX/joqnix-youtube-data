[{"type": "subtitle", "time": 11403.07, "timestamp": "03:10:03", "text": "それ。そして、それは、"}, {"type": "subtitle", "time": 11406.79, "timestamp": "03:10:06", "text": "実際にこれを行うようにアドバイスされたのは、"}, {"type": "subtitle", "time": 11410.15, "timestamp": "03:10:10", "text": "あなたはAFK（離席中）で、AIモードになっているんですよね？"}, {"type": "subtitle", "time": 11413.79, "timestamp": "03:10:13", "text": "えっと、それって何ていう名前でしたっけ？それ"}, {"type": "subtitle", "time": 11416.389, "timestamp": "03:10:16", "text": "変な豚が邪魔をしている場所"}, {"type": "subtitle", "time": 11419.91, "timestamp": "03:10:19", "text": "自分。それはどういうことですか？だから私は"}, {"type": "subtitle", "time": 11423.349, "timestamp": "03:10:23", "text": "私が対処しなければならない問題。"}, {"type": "subtitle", "time": 11425.71, "timestamp": "03:10:25", "text": "東洋のハード"}, {"type": "subtitle", "time": 11427.469, "timestamp": "03:10:27", "text": "遠くの線"}, {"type": "subtitle", "time": 11429.99, "timestamp": "03:10:29", "text": "二重チェックの可能性のように"}, {"type": "subtitle", "time": 11432.269, "timestamp": "03:10:32", "text": "私自身の"}, {"type": "subtitle", "time": 11435.349, "timestamp": "03:10:35", "text": "目。少し前払いして"}, {"type": "subtitle", "time": 11440.23, "timestamp": "03:10:40", "text": "わかったよ。それで、私たち全員が"}, {"type": "subtitle", "time": 11443.349, "timestamp": "03:10:43", "text": "ああ、私たちは崩壊するラキッシュフロアに入ります"}, {"type": "subtitle", "time": 11446.87, "timestamp": "03:10:46", "text": "えっと、AI関連のもの用の右側のフロア。カオス"}, {"type": "subtitle", "time": 11449.83, "timestamp": "03:10:49", "text": "あれ。はい、カオスのやつです。では、あなたは"}, {"type": "subtitle", "time": 11453.429, "timestamp": "03:10:53", "text": "普通にすべきことは、パーティーに行くことです"}, {"type": "subtitle", "time": 11457.75, "timestamp": "03:10:57", "text": "AFK中に自動参加することもできます"}]
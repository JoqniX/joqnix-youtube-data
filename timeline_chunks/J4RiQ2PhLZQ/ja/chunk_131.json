[{"type": "subtitle", "time": 7862.55, "timestamp": "02:11:02", "text": "作られたことはない。制限されているようです"}, {"type": "subtitle", "time": 7869.43, "timestamp": "02:11:09", "text": "これ？誰かが死んだ。彼はずっと待っているのか"}, {"type": "subtitle", "time": 7884.79, "timestamp": "02:11:24", "text": "何？ニノは自動的にそうしている。しないで"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "それについて心配してください。私の最後の３つの素早い"}, {"type": "subtitle", "time": 7901.99, "timestamp": "02:11:41", "text": "わかった。リーダーボードチャレンジリフト。"}, {"type": "subtitle", "time": 7906.39, "timestamp": "02:11:46", "text": "ああ、まずは全部片付けよう。おお、いいね。私たちは"}, {"type": "subtitle", "time": 7918.149, "timestamp": "02:11:58", "text": "お金。ああ、つまりディアブロのことですね。ああ、私は"}]
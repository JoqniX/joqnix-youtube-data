[{"type": "subtitle", "time": 15121.429, "timestamp": "04:12:01", "text": "心配。そして私は、これらの人々は"}, {"type": "subtitle", "time": 15123.87, "timestamp": "04:12:03", "text": "また新しい"}, {"type": "subtitle", "time": 15128.269, "timestamp": "04:12:08", "text": "人々。ザラにはまだ会ったことがない。はい、私です"}, {"type": "subtitle", "time": 15131.229, "timestamp": "04:12:11", "text": "あまりにも。ああ、彼女は"}, {"type": "subtitle", "time": 15149.389, "timestamp": "04:12:29", "text": "彼ら。私はそうしました"}, {"type": "subtitle", "time": 15165.429, "timestamp": "04:12:45", "text": "避ける。うん。 B クラムピープスですよね？はい。"}, {"type": "subtitle", "time": 15171.11, "timestamp": "04:12:51", "text": "メインのどこにたどり着いたのかわかりません"}]
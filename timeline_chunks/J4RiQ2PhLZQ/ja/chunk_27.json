[{"type": "subtitle", "time": 1624.47, "timestamp": "00:27:04", "text": "私は三目並べしかできなかった。"}, {"type": "subtitle", "time": 1626.95, "timestamp": "00:27:06", "text": "大丈夫。しかし、私たちは最善を尽くしました。それ"}, {"type": "subtitle", "time": 1638.19, "timestamp": "00:27:18", "text": "どうすればいいの？光らせることができない。光らせることができない。しかし"}, {"type": "subtitle", "time": 1639.95, "timestamp": "00:27:19", "text": "うん、"}, {"type": "subtitle", "time": 1644.51, "timestamp": "00:27:24", "text": "わーい。初めての折り紙。やったよ。"}, {"type": "subtitle", "time": 1648.549, "timestamp": "00:27:28", "text": "わーい。どうやって写真を撮ればいいですか？私はできる"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "ああ、なんてことだ。私もやらせてください。"}, {"type": "subtitle", "time": 1659.87, "timestamp": "00:27:39", "text": "削除させてください"}, {"type": "subtitle", "time": 1666.789, "timestamp": "00:27:46", "text": "こんにちは、マット。次の配信はいつですか？うん。"}, {"type": "subtitle", "time": 1669.669, "timestamp": "00:27:49", "text": "次の配信はいつですか？わかった。"}, {"type": "subtitle", "time": 1673.13, "timestamp": "00:27:53", "text": "えっと、木曜日の私のスケジュールを見てください。"}, {"type": "subtitle", "time": 1675.51, "timestamp": "00:27:55", "text": "[音楽]"}, {"type": "subtitle", "time": 1678.549, "timestamp": "00:27:58", "text": "お弁当に入っていて、"}]
[{"type": "subtitle", "time": 8522.03, "timestamp": "02:22:02", "text": "出口。"}, {"type": "subtitle", "time": 8523.56, "timestamp": "02:22:03", "text": "はぁ？待って、"}, {"type": "subtitle", "time": 8525.309, "timestamp": "02:22:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8534.429, "timestamp": "02:22:14", "text": "私も何が起こっているのか"}, {"type": "subtitle", "time": 8537.309, "timestamp": "02:22:17", "text": "ナクニ？ああ、最後"}, {"type": "subtitle", "time": 8540.95, "timestamp": "02:22:20", "text": "解決。ああ、最後のクエスト、そう、最後の"}, {"type": "subtitle", "time": 8543.19, "timestamp": "02:22:23", "text": "クエスト。ニーノのところに戻らないといけない"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "もう少ししたら。私たちは評判を"}, {"type": "subtitle", "time": 8548.19, "timestamp": "02:22:28", "text": "そしてストーリークエストでは、"}, {"type": "subtitle", "time": 8555.51, "timestamp": "02:22:35", "text": "ヤシク。あ、待って。 8です。忘れた。"}, {"type": "subtitle", "time": 8557.95, "timestamp": "02:22:37", "text": "目を"}, {"type": "subtitle", "time": 8564.51, "timestamp": "02:22:44", "text": "滴。忘れてた"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "八。それは私のものです。それでおしまい。私にさせて"}, {"type": "subtitle", "time": 8576.83, "timestamp": "02:22:56", "text": "それ。それで、一体どういうこと？"}, {"type": "subtitle", "time": 8578.59, "timestamp": "02:22:58", "text": "O"}]
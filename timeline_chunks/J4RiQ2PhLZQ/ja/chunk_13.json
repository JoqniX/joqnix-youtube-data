[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "私たちはそうだったので、それは典型的な"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "オタク。ええと、私は気づいたのですが、"}, {"type": "subtitle", "time": 795.59, "timestamp": "00:13:15", "text": "外で見かける人々は皆"}, {"type": "subtitle", "time": 797.59, "timestamp": "00:13:17", "text": "一般人。彼らはゲームをしない。彼らは"}, {"type": "subtitle", "time": 800.87, "timestamp": "00:13:20", "text": "アニメを知らない。ごく少数の人しか知らない"}, {"type": "subtitle", "time": 803.71, "timestamp": "00:13:23", "text": "アニメについて"}, {"type": "subtitle", "time": 808.629, "timestamp": "00:13:28", "text": "もの。 「おい、君が」って感じでショックを受けたよ"}, {"type": "subtitle", "time": 810.71, "timestamp": "00:13:30", "text": "ゲームはするな。ゲンチはプレイしない。"}, {"type": "subtitle", "time": 814.87, "timestamp": "00:13:34", "text": "あなたはマインクラフトをプレイしない。"}, {"type": "subtitle", "time": 817.55, "timestamp": "00:13:37", "text": "ええ、プレイします"}, {"type": "subtitle", "time": 821.59, "timestamp": "00:13:41", "text": "私はインフィニティニキをプレイしていません"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "どちらか。私はそれに夢中だった。ああ、私"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "あまりにも。魅力的で、物語は親切です"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "でも、着せ替え要素は大好きなんです。わかった。"}, {"type": "subtitle", "time": 835.68, "timestamp": "00:13:55", "text": "はい。"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "[音楽]"}]
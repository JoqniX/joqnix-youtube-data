[{"type": "subtitle", "time": 1141.35, "timestamp": "00:19:01", "text": "えっと、ショットを撮っていたんだけど"}, {"type": "subtitle", "time": 1145.43, "timestamp": "00:19:05", "text": "ひっくり返すとASMRのように注ぐ"}, {"type": "subtitle", "time": 1154.15, "timestamp": "00:19:14", "text": "アップロードするかもしれません。"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "ああ、録音したの？うん。おお。ニース。"}, {"type": "subtitle", "time": 1162.59, "timestamp": "00:19:22", "text": "もしかしたらお菓子作りの動画を作るかも"}, {"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "各部分を考えて平らにするべきでしょうか"}, {"type": "subtitle", "time": 1176.669, "timestamp": "00:19:36", "text": "彼ら。それはそれはそれはそれは"}, {"type": "subtitle", "time": 1180.63, "timestamp": "00:19:40", "text": "終わり。それぞれのパーツを開いて平らにしてください。"}, {"type": "subtitle", "time": 1181.87, "timestamp": "00:19:41", "text": "ああ、それは"}, {"type": "subtitle", "time": 1184.909, "timestamp": "00:19:44", "text": "終わり。待って、終わったよ。良い"}, {"type": "subtitle", "time": 1189.43, "timestamp": "00:19:49", "text": "仕事。私は何もできなかった。"}, {"type": "subtitle", "time": 1192.39, "timestamp": "00:19:52", "text": "ちょっと変に見えるけど、少なくとも私たちは"}, {"type": "subtitle", "time": 1194.65, "timestamp": "00:19:54", "text": "何かを試してみた。"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "[音楽]"}, {"type": "subtitle", "time": 1197.99, "timestamp": "00:19:57", "text": "あなたは最善を尽くしました。あなたはもっとうまくやった"}]
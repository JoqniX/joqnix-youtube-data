[{"type": "subtitle", "time": 16861.31, "timestamp": "04:41:01", "text": "締め切りが近づいています。それで私は仕事に取り掛かった"}, {"type": "subtitle", "time": 16865.708, "timestamp": "04:41:05", "text": "もっとだけど、痛みも感じる"}, {"type": "subtitle", "time": 16875.948, "timestamp": "04:41:15", "text": "そして、おそらく次は"}, {"type": "subtitle", "time": 16879.35, "timestamp": "04:41:19", "text": "来月かその次の月が最も可能性が高い"}, {"type": "subtitle", "time": 16882.43, "timestamp": "04:41:22", "text": "来月、おそらく8月までに"}, {"type": "subtitle", "time": 16885.75, "timestamp": "04:41:25", "text": "私は強制的に"}, {"type": "subtitle", "time": 16887.23, "timestamp": "04:41:27", "text": "大学に進学して"}, {"type": "subtitle", "time": 16890.47, "timestamp": "04:41:30", "text": "痛みのすべて。うん、手に入れなきゃ"}, {"type": "subtitle", "time": 16893.11, "timestamp": "04:41:33", "text": "学位とかそういうの、そうじゃないと"}, {"type": "subtitle", "time": 16894.788, "timestamp": "04:41:34", "text": "支払い"}, {"type": "subtitle", "time": 16897.708, "timestamp": "04:41:37", "text": "だって私は2年間を無駄にしたから"}, {"type": "subtitle", "time": 16901.11, "timestamp": "04:41:41", "text": "もうすでに、私はしたくない、私はしたくない"}, {"type": "subtitle", "time": 16902.31, "timestamp": "04:41:42", "text": "に"}, {"type": "subtitle", "time": 16906.23, "timestamp": "04:41:46", "text": "ええ、したくないです。"}, {"type": "subtitle", "time": 16908.67, "timestamp": "04:41:48", "text": "ああ、さらに年月を無駄にする"}, {"type": "subtitle", "time": 16913.83, "timestamp": "04:41:53", "text": "また。あ、待って。捨ててもいいですか？それで、"}, {"type": "subtitle", "time": 16916.948, "timestamp": "04:41:56", "text": "このような配信は今後行われなくなるでしょう。"}, {"type": "subtitle", "time": 16919.19, "timestamp": "04:41:59", "text": "私はいつもアクティブでいるのが好きだった"}]
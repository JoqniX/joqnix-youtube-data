[{"type": "subtitle", "time": 15303.269, "timestamp": "04:15:03", "text": "誰か。待って、HPが減ってる"}, {"type": "subtitle", "time": 15315.229, "timestamp": "04:15:15", "text": "これは強化ではないのですか？いいえ、それは"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "そこでは毎秒HPが減っていく。"}, {"type": "subtitle", "time": 15328.95, "timestamp": "04:15:28", "text": "ああ、みんなも負けているんだ。待って、あれ"}, {"type": "subtitle", "time": 15332.79, "timestamp": "04:15:32", "text": "魔女はHPを失っていません。"}, {"type": "subtitle", "time": 15340.269, "timestamp": "04:15:40", "text": "バフ？デバフであってバフではない、"}, {"type": "subtitle", "time": 15342.99, "timestamp": "04:15:42", "text": "デバフ。私がどのように"}, {"type": "subtitle", "time": 15344.75, "timestamp": "04:15:44", "text": "ロス。感謝"}, {"type": "subtitle", "time": 15347.71, "timestamp": "04:15:47", "text": "神。ああ、彼は"}, {"type": "subtitle", "time": 15349.83, "timestamp": "04:15:49", "text": "激怒した。一体どういうことだ？そこには"}]
[{"type": "subtitle", "time": 4382.59, "timestamp": "01:13:02", "text": "3 です。"}, {"type": "subtitle", "time": 4385.83, "timestamp": "01:13:05", "text": "ああ、カスタマイズの選択肢が本当に多いですね。でも私は"}, {"type": "subtitle", "time": 4388.07, "timestamp": "01:13:08", "text": "前の 3 を変更したい"}, {"type": "subtitle", "time": 4398.27, "timestamp": "01:13:18", "text": "他に何ができるだろうか"}, {"type": "subtitle", "time": 4402.11, "timestamp": "01:13:22", "text": "変化？ああ、それを買ったよ"}, {"type": "subtitle", "time": 4404.59, "timestamp": "01:13:24", "text": "で。"}, {"type": "subtitle", "time": 4407.39, "timestamp": "01:13:27", "text": "待って、君"}, {"type": "subtitle", "time": 4414.87, "timestamp": "01:13:34", "text": "待って、待って。私のUIはどうなったの？"}, {"type": "subtitle", "time": 4418.709, "timestamp": "01:13:38", "text": "待って。つまり、あなたはそれを買ったということですね。その王国"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "友人。ちょっと待って、席を外します。こんにちは。取る"}, {"type": "subtitle", "time": 4424.91, "timestamp": "01:13:44", "text": "私に会いに来ることを気にかけます。待って、できないよ"}, {"type": "subtitle", "time": 4434.59, "timestamp": "01:13:54", "text": "本当に？そしてなぜ"}, {"type": "subtitle", "time": 4438.99, "timestamp": "01:13:58", "text": "何が起こったの？なぜ"}]
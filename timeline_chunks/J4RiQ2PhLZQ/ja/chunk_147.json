[{"type": "subtitle", "time": 8821.23, "timestamp": "02:27:01", "text": "代わりに、今は待っている"}, {"type": "subtitle", "time": 8825.07, "timestamp": "02:27:05", "text": "鍛冶屋。よし、鍛冶屋は終わった"}, {"type": "subtitle", "time": 8827.55, "timestamp": "02:27:07", "text": "ここ。では、"}, {"type": "subtitle", "time": 8832.03, "timestamp": "02:27:12", "text": "これは、私が望めば救済できる。"}, {"type": "subtitle", "time": 8836.19, "timestamp": "02:27:16", "text": "でも、どうすればいいのかわからない"}, {"type": "subtitle", "time": 8839.87, "timestamp": "02:27:19", "text": "それ。サルベージします"}, {"type": "subtitle", "time": 8847.03, "timestamp": "02:27:27", "text": "あなた。君を救いたくない"}, {"type": "subtitle", "time": 8864.63, "timestamp": "02:27:44", "text": "何か？だから、それをアップグレードすると、電力は"}, {"type": "subtitle", "time": 8878.75, "timestamp": "02:27:58", "text": "それ。大丈夫だよ。上"}]
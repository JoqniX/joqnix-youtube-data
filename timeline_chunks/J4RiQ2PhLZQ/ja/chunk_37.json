[{"type": "subtitle", "time": 2222.47, "timestamp": "00:37:02", "text": "ああ、同じことが適用できる"}, {"type": "subtitle", "time": 2226.43, "timestamp": "00:37:06", "text": "あなたの物、あなたのすること、でもあまり"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "ネガティブ。常に"}, {"type": "subtitle", "time": 2232.27, "timestamp": "00:37:12", "text": "あなたがしていることは良いことです"}, {"type": "subtitle", "time": 2233.79, "timestamp": "00:37:13", "text": "良い。"}, {"type": "subtitle", "time": 2237.99, "timestamp": "00:37:17", "text": "うん。それで、それが私の"}, {"type": "subtitle", "time": 2241.47, "timestamp": "00:37:21", "text": "私のアートを評価して、"}, {"type": "subtitle", "time": 2243.15, "timestamp": "00:37:23", "text": "もの。"}, {"type": "subtitle", "time": 2245.91, "timestamp": "00:37:25", "text": "うん。評価は7点くらいかな。私は必要としている"}, {"type": "subtitle", "time": 2248.71, "timestamp": "00:37:28", "text": "もっと描くために。だから、何をすべきかは分かっているはずだ。"}, {"type": "subtitle", "time": 2251.349, "timestamp": "00:37:31", "text": "練習が必要だ、絵を描き続けなければならない"}, {"type": "subtitle", "time": 2253.91, "timestamp": "00:37:33", "text": "そして絵を描いて、そして手に入れる"}, {"type": "subtitle", "time": 2256.55, "timestamp": "00:37:36", "text": "解剖学の方が得意。着色、"}, {"type": "subtitle", "time": 2258.87, "timestamp": "00:37:38", "text": "陰影、照明、たくさんの"}, {"type": "subtitle", "time": 2261.55, "timestamp": "00:37:41", "text": "物事、ですよね？に関しては"}, {"type": "subtitle", "time": 2266.51, "timestamp": "00:37:46", "text": "美術。そうですね、すべてゆっくりと行ってください。"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "ゆっくり。うん。どうぞご自由に"}, {"type": "subtitle", "time": 2274.71, "timestamp": "00:37:54", "text": "描いているものを投稿したり、"}, {"type": "subtitle", "time": 2277.99, "timestamp": "00:37:57", "text": "いろいろやってるよ。気にしないで。ああ、それは"}, {"type": "subtitle", "time": 2279.63, "timestamp": "00:37:59", "text": "完璧ではない、または"}]
[{"type": "subtitle", "time": 3421.71, "timestamp": "00:57:01", "text": "デュプリズムに参加し、"}, {"type": "subtitle", "time": 3424.349, "timestamp": "00:57:04", "text": "入った。"}, {"type": "subtitle", "time": 3427.43, "timestamp": "00:57:07", "text": "それ。王国で2つの料金を料理する"}, {"type": "subtitle", "time": 3429.349, "timestamp": "00:57:09", "text": "レストラン。私たちはそれをする必要がある。座る"}, {"type": "subtitle", "time": 3437.19, "timestamp": "00:57:17", "text": "それ。黒曜石を王国60に寄付する"}, {"type": "subtitle", "time": 3438.349, "timestamp": "00:57:18", "text": "回。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "わかった。料理を作る。えっと、ダンジョンをクリアしました。ああ、"}, {"type": "subtitle", "time": 3444.47, "timestamp": "00:57:24", "text": "今日はダンジョン攻略も必要だ。"}, {"type": "subtitle", "time": 3446.19, "timestamp": "00:57:26", "text": "うん。"}, {"type": "subtitle", "time": 3450.56, "timestamp": "00:57:30", "text": "オブシリオンとこれ。私はすべてやります"}, {"type": "subtitle", "time": 3452.589, "timestamp": "00:57:32", "text": "[音楽]"}, {"type": "subtitle", "time": 3455.23, "timestamp": "00:57:35", "text": "彼ら。私は"}, {"type": "subtitle", "time": 3458.67, "timestamp": "00:57:38", "text": "イベント。私たちは"}, {"type": "subtitle", "time": 3464.789, "timestamp": "00:57:44", "text": "これとD4、D5、D5。これはSです。それで、"}, {"type": "subtitle", "time": 3466.789, "timestamp": "00:57:46", "text": "王国にチェックインしてください。だから明日は"}, {"type": "subtitle", "time": 3471.91, "timestamp": "00:57:51", "text": "王国で2つの宴会を準備し、料理した。"}, {"type": "subtitle", "time": 3478.35, "timestamp": "00:57:58", "text": "私はそうします"}]
[{"type": "subtitle", "time": 9003.99, "timestamp": "02:30:03", "text": "わかった。こんにちは。それでは、点眼薬をさします。"}, {"type": "subtitle", "time": 9006.349, "timestamp": "02:30:06", "text": "私たちはこの出来事を目の当たりにすることができる。見ることができます"}, {"type": "subtitle", "time": 9016.23, "timestamp": "02:30:16", "text": "あれ。待って、慎重にやろう。"}, {"type": "subtitle", "time": 9019.67, "timestamp": "02:30:19", "text": "確実に命中させて、正確に狙いを定めて"}, {"type": "subtitle", "time": 9021.91, "timestamp": "02:30:21", "text": "目。"}, {"type": "subtitle", "time": 9024.87, "timestamp": "02:30:24", "text": "ああ、大変だ。問題は、目を置いたときに"}, {"type": "subtitle", "time": 9028.83, "timestamp": "02:30:28", "text": "目薬をさすと、目がひどく涙ぐむので、"}, {"type": "subtitle", "time": 9033.87, "timestamp": "02:30:33", "text": "素早い。まるで"}, {"type": "subtitle", "time": 9054.83, "timestamp": "02:30:54", "text": "よし、1つ目"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "終わり。あと1つ。それで、私は"}, {"type": "subtitle", "time": 9059.95, "timestamp": "02:30:59", "text": "左"}]
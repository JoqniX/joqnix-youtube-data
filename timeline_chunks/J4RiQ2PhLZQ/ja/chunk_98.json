[{"type": "subtitle", "time": 5883.669, "timestamp": "01:38:03", "text": "信じる。私は死にかけているんですよね？私は死にかけている。"}, {"type": "subtitle", "time": 5891.709, "timestamp": "01:38:11", "text": "私は死んだ。私は"}, {"type": "subtitle", "time": 5899.79, "timestamp": "01:38:19", "text": "死んだ。私は階級を失った。その"}, {"type": "subtitle", "time": 5901.39, "timestamp": "01:38:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5906.83, "timestamp": "01:38:26", "text": "大丈夫。つまり、レベルアップする必要があるということです"}, {"type": "subtitle", "time": 5908.83, "timestamp": "01:38:28", "text": "チーム。これ"}, {"type": "subtitle", "time": 5911.07, "timestamp": "01:38:31", "text": "特に疑問に思った"}, {"type": "subtitle", "time": 5915.91, "timestamp": "01:38:35", "text": "オルベロス。彼をもっとレベルアップさせなきゃ。"}, {"type": "subtitle", "time": 5926.55, "timestamp": "01:38:46", "text": "最大限まで使い切った。待って、どうすれば彼を最大レベルまで強化できるの？私"}, {"type": "subtitle", "time": 5931.87, "timestamp": "01:38:51", "text": "えっと"}, {"type": "subtitle", "time": 5934.709, "timestamp": "01:38:54", "text": "攻撃。私は攻撃性のクラゲは持っていません。おお、"}]
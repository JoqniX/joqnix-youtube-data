[{"type": "subtitle", "time": 16921.59, "timestamp": "04:42:01", "text": "時間。私が"}, {"type": "subtitle", "time": 16923.43, "timestamp": "04:42:03", "text": "投稿設定に積極的にアクセスして"}, {"type": "subtitle", "time": 16928.59, "timestamp": "04:42:08", "text": "それは痛みだ。うん、私は"}, {"type": "subtitle", "time": 16931.59, "timestamp": "04:42:11", "text": "それ。でも、私はそう言い続けることはできません。"}, {"type": "subtitle", "time": 16935.07, "timestamp": "04:42:15", "text": "右。あなたはそうしなければならない 私はそうしなければならない"}, {"type": "subtitle", "time": 16940.67, "timestamp": "04:42:20", "text": "痛み。ああ、空中に浮かせてしまった。さあ"}, {"type": "subtitle", "time": 16944.67, "timestamp": "04:42:24", "text": "行く。サッカーボール。ああ、それはその中に入っていたんだ。"}, {"type": "subtitle", "time": 16950.11, "timestamp": "04:42:30", "text": "わかった。置いてもいいですか？そうしてくれる？"}, {"type": "subtitle", "time": 16953.03, "timestamp": "04:42:33", "text": "いいえ。そして私は自分の"}, {"type": "subtitle", "time": 16957.83, "timestamp": "04:42:37", "text": "夕食だったけど、忘れちゃった。おおコラ、私は"}, {"type": "subtitle", "time": 16961.03, "timestamp": "04:42:41", "text": "目標を持ちたい。私は"}, {"type": "subtitle", "time": 16963.948, "timestamp": "04:42:43", "text": "ゴール。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 16966.75, "timestamp": "04:42:46", "text": "おお。はい。私は"}, {"type": "subtitle", "time": 16969.19, "timestamp": "04:42:49", "text": "ゴール。よう、ジョジョ、一緒に写真を撮ろうよ。"}, {"type": "subtitle", "time": 16970.868, "timestamp": "04:42:50", "text": "どこ？どこ？どこ？どこ？ジョーはどこにいるの？"}, {"type": "subtitle", "time": 16974.03, "timestamp": "04:42:54", "text": "ドリーミーはどこにいるの？どこ"}, {"type": "subtitle", "time": 16975.868, "timestamp": "04:42:55", "text": "夢？"}]
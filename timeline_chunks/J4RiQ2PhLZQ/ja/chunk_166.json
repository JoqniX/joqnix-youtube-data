[{"type": "subtitle", "time": 9960.71, "timestamp": "02:46:00", "text": "終わり。これについては後でまた話せます、"}, {"type": "subtitle", "time": 9963.11, "timestamp": "02:46:03", "text": "信じる。"}, {"type": "subtitle", "time": 9967.07, "timestamp": "02:46:07", "text": "ディオを終わらせろ。仕上げる"}, {"type": "subtitle", "time": 9970.63, "timestamp": "02:46:10", "text": "ここから5分間、カウントダウンしてください。私は見ている"}, {"type": "subtitle", "time": 9973.87, "timestamp": "02:46:13", "text": "タイマー終了"}, {"type": "subtitle", "time": 9976.55, "timestamp": "02:46:16", "text": "ここ。つまり、この分野の主なことは"}, {"type": "subtitle", "time": 9979.59, "timestamp": "02:46:19", "text": "ボス戦では素早くテレポートする必要がある"}, {"type": "subtitle", "time": 9988.71, "timestamp": "02:46:28", "text": "速い。急がなければならない。それが主な点です"}, {"type": "subtitle", "time": 9998.87, "timestamp": "02:46:38", "text": "ああ、この人か。これは私が必要としているものです"}, {"type": "subtitle", "time": 10000.75, "timestamp": "02:46:40", "text": "殺す、もう一方ではない"}, {"type": "subtitle", "time": 10003.87, "timestamp": "02:46:43", "text": "1つ。だから、私はこれだけをターゲットにします"}, {"type": "subtitle", "time": 10005.95, "timestamp": "02:46:45", "text": "手動で、"}, {"type": "subtitle", "time": 10013.03, "timestamp": "02:46:53", "text": "1つ。ちょっと待って。迎えに行くよ。"}, {"type": "subtitle", "time": 10015.51, "timestamp": "02:46:55", "text": "こんにちは。あ、待って。レミー、もし"}, {"type": "subtitle", "time": 10017.83, "timestamp": "02:46:57", "text": "あなたは今ログインしています"}]
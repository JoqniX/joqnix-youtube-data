[{"type": "subtitle", "time": 19320.31, "timestamp": "05:22:00", "text": "今日は銀行強盗をするつもりだ。私たちは行く"}, {"type": "subtitle", "time": 19323.708, "timestamp": "05:22:03", "text": "今日、強盗をするために。私"}, {"type": "subtitle", "time": 19326.948, "timestamp": "05:22:06", "text": "見る。待って、あなたはそうしなかった。はい、あなたは"}, {"type": "subtitle", "time": 19328.868, "timestamp": "05:22:08", "text": "今は画面上でそれをやっている。試してみます"}, {"type": "subtitle", "time": 19331.35, "timestamp": "05:22:11", "text": "チャット機能を共有する。機能していますか？それとも機能していませんか？"}]
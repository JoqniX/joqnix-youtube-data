[{"type": "subtitle", "time": 4507.83, "timestamp": "01:15:07", "text": "時間。メールアドレスを変えるべきですね。"}, {"type": "subtitle", "time": 4510.149, "timestamp": "01:15:10", "text": "私はすべてをプライベートなものとして保管しています"}, {"type": "subtitle", "time": 4512.39, "timestamp": "01:15:12", "text": "メール。ウェブサイトを持っているので、"}, {"type": "subtitle", "time": 4514.03, "timestamp": "01:15:14", "text": "私のウェブサイト"}, {"type": "subtitle", "time": 4517.149, "timestamp": "01:15:17", "text": "メール。別のルートを通ろう"}, {"type": "subtitle", "time": 4521.709, "timestamp": "01:15:21", "text": "メール。私はそれを使います、私はそれを"}, {"type": "subtitle", "time": 4525.59, "timestamp": "01:15:25", "text": "信じる。少なくとも私は"}, {"type": "subtitle", "time": 4527.39, "timestamp": "01:15:27", "text": "あなたが選ぶだろうと分かっていた"}, {"type": "subtitle", "time": 4541.75, "timestamp": "01:15:41", "text": "私たちはどこまで話しましたっけ？どこ？あ、行かなきゃ"}, {"type": "subtitle", "time": 4543.87, "timestamp": "01:15:43", "text": "私の"}, {"type": "subtitle", "time": 4547.669, "timestamp": "01:15:47", "text": "王国。王国。だから私たちは"}, {"type": "subtitle", "time": 4550.07, "timestamp": "01:15:50", "text": "クエストをいくつかクリアする。終わらせる必要がある"}, {"type": "subtitle", "time": 4552.59, "timestamp": "01:15:52", "text": "合計5つのクエスト、"}, {"type": "subtitle", "time": 4554.27, "timestamp": "01:15:54", "text": "右？"}, {"type": "subtitle", "time": 4558.47, "timestamp": "01:15:58", "text": "彼女から。王国レベル11は"}]
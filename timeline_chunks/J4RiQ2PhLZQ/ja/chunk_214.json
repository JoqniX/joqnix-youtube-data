[{"type": "subtitle", "time": 12843.83, "timestamp": "03:34:03", "text": "えっと、待って、モデレーターに入ります。わかった。えーと、もう"}, {"type": "subtitle", "time": 12846.03, "timestamp": "03:34:06", "text": "あなたができることの一つは"}, {"type": "subtitle", "time": 12849.51, "timestamp": "03:34:09", "text": "見覚えのある内容だ。卵を用意してください。ではない"}, {"type": "subtitle", "time": 12852.229, "timestamp": "03:34:12", "text": "卵。えっと、私ができなかったことって何ですか？忘れた。"}, {"type": "subtitle", "time": 12854.389, "timestamp": "03:34:14", "text": "他に何ができるでしょうか"}, {"type": "subtitle", "time": 12857.51, "timestamp": "03:34:17", "text": "もの？ AIを使うときはカオスフィールドを作ろう"}, {"type": "subtitle", "time": 12860.309, "timestamp": "03:34:20", "text": "モード。パワーアップアイテムを入手しましょう。これは"}, {"type": "subtitle", "time": 12861.16, "timestamp": "03:34:21", "text": "は 重要。次元変換をやってみて。"}, {"type": "subtitle", "time": 12864.16, "timestamp": "03:34:24", "text": "重要。次元変換をやってみて。 ナロンたちは休息し、もう一方も同様です。する"}, {"type": "subtitle", "time": 12873.07, "timestamp": "03:34:33", "text": "これ。良い装備を手に入れよう。良い装備を手に入れて、"}, {"type": "subtitle", "time": 12876.469, "timestamp": "03:34:36", "text": "アップグレードします。ええ、そうですね、高齢者に餌をやるような"}, {"type": "subtitle", "time": 12880.11, "timestamp": "03:34:40", "text": "ギヤ。常にアップグレードし、冒険を続けよう"}, {"type": "subtitle", "time": 12883.11, "timestamp": "03:34:43", "text": "もの。他に何か？そしてもしあなたが"}, {"type": "subtitle", "time": 12887.03, "timestamp": "03:34:47", "text": "レベル40または35、30、40をアンロック"}, {"type": "subtitle", "time": 12890.55, "timestamp": "03:34:50", "text": "何か、あなたはハードスターをアンロックします、"}, {"type": "subtitle", "time": 12892.229, "timestamp": "03:34:52", "text": "最初の星はアンロックされますよね？"}, {"type": "subtitle", "time": 12896.95, "timestamp": "03:34:56", "text": "君はこういうものをどんどんアップグレードし続けているんだね"}]
[{"type": "subtitle", "time": 3663.39, "timestamp": "01:01:03", "text": "作物。私はトマトがすごく欲しい。"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "M. トマトが欲しいです。"}, {"type": "subtitle", "time": 3672.109, "timestamp": "01:01:12", "text": "全てをレベルアップさせる。待って、私は"}, {"type": "subtitle", "time": 3675.03, "timestamp": "01:01:15", "text": "トマト。私は5つしか持っていません。 10個必要です"}, {"type": "subtitle", "time": 3681.349, "timestamp": "01:01:21", "text": "s.トマトの入手方法はわかりませんが、"}, {"type": "subtitle", "time": 3682.19, "timestamp": "01:01:22", "text": "欲しい"}, {"type": "subtitle", "time": 3687.549, "timestamp": "01:01:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3690.23, "timestamp": "01:01:30", "text": "彼ら。そして私は自分のためにパーティーを作ります"}, {"type": "subtitle", "time": 3692.589, "timestamp": "01:01:32", "text": "王国の人々。"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "バッカス、誰が出てるの？マカ。バカ。ミミは"}, {"type": "subtitle", "time": 3701.67, "timestamp": "01:01:41", "text": "の上。それでは、あなたを招待しましょう。"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "こんにちは。"}]
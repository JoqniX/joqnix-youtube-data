[{"type": "subtitle", "time": 9121.19, "timestamp": "02:32:01", "text": "少しの間サイコだったけど、私たちは次に進んだ"}, {"type": "subtitle", "time": 9124.309, "timestamp": "02:32:04", "text": "明らかな問題やその他すべてを修正する"}, {"type": "subtitle", "time": 9125.63, "timestamp": "02:32:05", "text": "のために"}, {"type": "subtitle", "time": 9134.389, "timestamp": "02:32:14", "text": "それ。はい。そしておそらくアップロードするでしょう"}, {"type": "subtitle", "time": 9137.429, "timestamp": "02:32:17", "text": "ええと、配信終了後。私は知っている"}, {"type": "subtitle", "time": 9139.59, "timestamp": "02:32:19", "text": "私はそれをやると言っただけです"}, {"type": "subtitle", "time": 9142.83, "timestamp": "02:32:22", "text": "昨日の朝に私は"}, {"type": "subtitle", "time": 9153.51, "timestamp": "02:32:33", "text": "また。ああ、レベルアップしたよ。聞いた話ですが"}, {"type": "subtitle", "time": 9154.51, "timestamp": "02:32:34", "text": "レベル"}, {"type": "subtitle", "time": 9163.99, "timestamp": "02:32:43", "text": "うん、気持ちいいよ。閉めて閉めて"}, {"type": "subtitle", "time": 9170.99, "timestamp": "02:32:50", "text": "ただあなたの"}, {"type": "subtitle", "time": 9174.15, "timestamp": "02:32:54", "text": "周囲。ファンがどうしたの？"}, {"type": "subtitle", "time": 9178.15, "timestamp": "02:32:58", "text": "周囲の騒音とヘッドホン"}]
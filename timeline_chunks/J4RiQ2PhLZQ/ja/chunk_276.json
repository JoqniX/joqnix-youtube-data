[{"type": "subtitle", "time": 16562.029, "timestamp": "04:36:02", "text": "よー、星２つ"}, {"type": "subtitle", "time": 16565.349, "timestamp": "04:36:05", "text": "サポート。孵化の仕方がわからない"}, {"type": "subtitle", "time": 16568.789, "timestamp": "04:36:08", "text": "ガイドは機能します。やり方を確認する必要がある"}, {"type": "subtitle", "time": 16569.789, "timestamp": "04:36:09", "text": "それ"}, {"type": "subtitle", "time": 16573.67, "timestamp": "04:36:13", "text": "きちんと。私はなんとなくやっているんです。"}, {"type": "subtitle", "time": 16587.31, "timestamp": "04:36:27", "text": "あなた"}, {"type": "subtitle", "time": 16591.54, "timestamp": "04:36:31", "text": "ああ、そしてあなたは"}, {"type": "subtitle", "time": 16593.869, "timestamp": "04:36:33", "text": "[音楽]"}, {"type": "subtitle", "time": 16596.39, "timestamp": "04:36:36", "text": "これ。えっと、何か症状がありますか？"}, {"type": "subtitle", "time": 16599.109, "timestamp": "04:36:39", "text": "あなたの目？どうやら私は"}, {"type": "subtitle", "time": 16601.83, "timestamp": "04:36:41", "text": "最近オンラインで検索して発見しました"}, {"type": "subtitle", "time": 16605.67, "timestamp": "04:36:45", "text": "それが私が頭痛を起こす理由です"}, {"type": "subtitle", "time": 16608.189, "timestamp": "04:36:48", "text": "ヘッドホンを装着しているとき、または音楽を聴いているとき"}, {"type": "subtitle", "time": 16613.429, "timestamp": "04:36:53", "text": "不均等な音や"}, {"type": "subtitle", "time": 16616.47, "timestamp": "04:36:56", "text": "周波数は、また私が持っているからです。"}]
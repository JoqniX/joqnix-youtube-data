[{"type": "subtitle", "time": 14111.99, "timestamp": "03:55:11", "text": "こんにちは。ああ。光のみを使用して敵を倒す"}, {"type": "subtitle", "time": 14115.269, "timestamp": "03:55:15", "text": "兵器。ああ、それは私がやったことじゃないよ。その"}, {"type": "subtitle", "time": 14138.189, "timestamp": "03:55:38", "text": "戻る。征服の回復があります"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "充電はしたくない。したい"}, {"type": "subtitle", "time": 14151.469, "timestamp": "03:55:51", "text": "これは終盤まで取っておいてください。"}, {"type": "subtitle", "time": 14154.55, "timestamp": "03:55:54", "text": "右？だから私は自分の"}]
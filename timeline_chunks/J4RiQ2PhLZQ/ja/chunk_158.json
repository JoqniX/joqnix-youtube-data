[{"type": "subtitle", "time": 9481.429, "timestamp": "02:38:01", "text": "ストリームにもっと集中する、"}, {"type": "subtitle", "time": 9483.75, "timestamp": "02:38:03", "text": "ストリーム関連のものを作る作業"}, {"type": "subtitle", "time": 9486.309, "timestamp": "02:38:06", "text": "新しい明らかな効果とテストのようなもの"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "それらを取り出して、明白なすべてを破る"}, {"type": "subtitle", "time": 9490.95, "timestamp": "02:38:10", "text": "配信の時間、あの頃が懐かしい。"}, {"type": "subtitle", "time": 9494.95, "timestamp": "02:38:14", "text": "最近はゲームでまったり過ごしてる"}, {"type": "subtitle", "time": 9499.27, "timestamp": "02:38:19", "text": "その他仕事関係のこともあって、もうすでに"}, {"type": "subtitle", "time": 9502.15, "timestamp": "02:38:22", "text": "過去1ヶ月間、過去1年間、私はすでに"}, {"type": "subtitle", "time": 9503.87, "timestamp": "02:38:23", "text": "ほとんどの"}, {"type": "subtitle", "time": 9508.15, "timestamp": "02:38:28", "text": "私が他人のと呼ぶ基本的な設定について"}, {"type": "subtitle", "time": 9514.79, "timestamp": "02:38:34", "text": "セットアップですが、まだ、それは、"}, {"type": "subtitle", "time": 9516.429, "timestamp": "02:38:36", "text": "まだではない"}, {"type": "subtitle", "time": 9519.99, "timestamp": "02:38:39", "text": "効率的であるのは、いつも壊れるからだが、"}, {"type": "subtitle", "time": 9521.23, "timestamp": "02:38:41", "text": "私が望むように"}, {"type": "subtitle", "time": 9524.23, "timestamp": "02:38:44", "text": "新しいものを試すために"}, {"type": "subtitle", "time": 9527.03, "timestamp": "02:38:47", "text": "特にYouTubeの人たちは知らない"}, {"type": "subtitle", "time": 9529.349, "timestamp": "02:38:49", "text": "YouTube の人たち、もっと良いものを見つけなきゃ"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "名前"}, {"type": "subtitle", "time": 9533.87, "timestamp": "02:38:53", "text": "ええと、YouTube でおなじみのものと"}, {"type": "subtitle", "time": 9537.27, "timestamp": "02:38:57", "text": "Twitch なので、私はできる、またはあなたは待ちたいですか"}, {"type": "subtitle", "time": 9539.389, "timestamp": "02:38:59", "text": "両者を区別しても構いません"}]
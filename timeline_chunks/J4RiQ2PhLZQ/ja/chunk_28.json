[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "パズルフードのような"}, {"type": "subtitle", "time": 1684.149, "timestamp": "00:28:04", "text": "ゲームと"}, {"type": "subtitle", "time": 1688.71, "timestamp": "00:28:08", "text": "ただ雑談しているだけです。さあ行こう。わかった。えっと、君"}, {"type": "subtitle", "time": 1697.269, "timestamp": "00:28:17", "text": "私もそうするべきでしょうか？あ、待って。どのように"}, {"type": "subtitle", "time": 1709.07, "timestamp": "00:28:29", "text": "それ？待って。私もそうするべきでしょうか？待って。"}, {"type": "subtitle", "time": 1712.23, "timestamp": "00:28:32", "text": "待って。持ち上げたいですか？"}, {"type": "subtitle", "time": 1714.97, "timestamp": "00:28:34", "text": "一緒に？待って。どのように"}, {"type": "subtitle", "time": 1717.63, "timestamp": "00:28:37", "text": "[音楽]"}, {"type": "subtitle", "time": 1721.909, "timestamp": "00:28:41", "text": "こんなことって本当に可能なの？はい、"}, {"type": "subtitle", "time": 1724.99, "timestamp": "00:28:44", "text": "心は手の中にあり、"}, {"type": "subtitle", "time": 1727.59, "timestamp": "00:28:47", "text": "蝶。どのように選考すればよいですか？はい、"}, {"type": "subtitle", "time": 1730.789, "timestamp": "00:28:50", "text": "みんなスクリーンショットでも撮ればいいよ。送信"}, {"type": "subtitle", "time": 1732.83, "timestamp": "00:28:52", "text": "私たちに"}, {"type": "subtitle", "time": 1736.23, "timestamp": "00:28:56", "text": "不和。わーい。それから投稿してください。投稿します"}]
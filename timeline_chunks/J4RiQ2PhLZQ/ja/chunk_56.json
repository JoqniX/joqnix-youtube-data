[{"type": "subtitle", "time": 3365.63, "timestamp": "00:56:05", "text": "それは"}, {"type": "subtitle", "time": 3373.349, "timestamp": "00:56:13", "text": "2019年。わあ、たくさんの人がいたね。"}, {"type": "subtitle", "time": 3375.95, "timestamp": "00:56:15", "text": "昨日。"}, {"type": "subtitle", "time": 3378.309, "timestamp": "00:56:18", "text": "何？昨日の確認作業。ああ、ただ"}, {"type": "subtitle", "time": 3380.99, "timestamp": "00:56:20", "text": "３人がそこにいた。おお、"}, {"type": "subtitle", "time": 3384.309, "timestamp": "00:56:24", "text": "わかった。みんなその後活動しなくなった"}, {"type": "subtitle", "time": 3387.27, "timestamp": "00:56:27", "text": "しばらくしてからプレイしてください。みんな"}, {"type": "subtitle", "time": 3390.39, "timestamp": "00:56:30", "text": "非アクティブ状態になった。私は唯一の"}, {"type": "subtitle", "time": 3391.87, "timestamp": "00:56:31", "text": "今日。"}, {"type": "subtitle", "time": 3395.99, "timestamp": "00:56:35", "text": "何？ルビック。ルビック。こんにちは。寄付。病気"}, {"type": "subtitle", "time": 3397.549, "timestamp": "00:56:37", "text": "置く"}, {"type": "subtitle", "time": 3399.21, "timestamp": "00:56:39", "text": "金。おお、"}, {"type": "subtitle", "time": 3400.589, "timestamp": "00:56:40", "text": "[音楽]"}, {"type": "subtitle", "time": 3403.589, "timestamp": "00:56:43", "text": "ブーム。ええと、私は黒曜石はやりません。"}, {"type": "subtitle", "time": 3406.069, "timestamp": "00:56:46", "text": "待って。えっと、確認する必要があるのですが"}, {"type": "subtitle", "time": 3408.75, "timestamp": "00:56:48", "text": "開催中のイベント"}, {"type": "subtitle", "time": 3412.349, "timestamp": "00:56:52", "text": "一瞬。ええ、そうですね。"}, {"type": "subtitle", "time": 3416.23, "timestamp": "00:56:56", "text": "右。えっと、プリズムを王国50に寄付してください"}, {"type": "subtitle", "time": 3418.51, "timestamp": "00:56:58", "text": "回。はい、"}]
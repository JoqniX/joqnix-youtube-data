[{"type": "subtitle", "time": 14582.63, "timestamp": "04:03:02", "text": "研究室？同じチケットが使えますか？"}, {"type": "subtitle", "time": 14585.63, "timestamp": "04:03:05", "text": "はい。だから同じものを使う必要がある"}, {"type": "subtitle", "time": 14590.11, "timestamp": "04:03:10", "text": "チケット。おお。では、私たちはどうするのでしょうか"}, {"type": "subtitle", "time": 14592.67, "timestamp": "04:03:12", "text": "1つだけやります"}, {"type": "subtitle", "time": 14596.429, "timestamp": "04:03:16", "text": "それでは、"}, {"type": "subtitle", "time": 14600.15, "timestamp": "04:03:20", "text": "ええ、今1つやって、それから、"}, {"type": "subtitle", "time": 14604.189, "timestamp": "04:03:24", "text": "もう片方。わかった。そして私たちは"}, {"type": "subtitle", "time": 14607.03, "timestamp": "04:03:27", "text": "ダンジョン。さあ行こう。あなたが"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "パーティーに参加する必要はありません。あなたはできる"}, {"type": "subtitle", "time": 14627.83, "timestamp": "04:03:47", "text": "王国。そして、王国のダンジョンもある。"}, {"type": "subtitle", "time": 14632.189, "timestamp": "04:03:52", "text": "私たち全員がやらなければならないこと、ああ、私は"}, {"type": "subtitle", "time": 14636.229, "timestamp": "04:03:56", "text": "できた。うん。ああ、あなたは姿を消してしまったのですね。はい、私は"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "消えた。そこへ行ってみなさい。"}]
[{"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "私は彼らに思い出を作っている"}, {"type": "subtitle", "time": 16809.91, "timestamp": "04:40:09", "text": "リミッタ。でも、痛みは"}, {"type": "subtitle", "time": 16811.43, "timestamp": "04:40:11", "text": "ああ、あなたの目が消えてくれるといいな"}, {"type": "subtitle", "time": 16813.75, "timestamp": "04:40:13", "text": "ゲームに関して、"}, {"type": "subtitle", "time": 16816.31, "timestamp": "04:40:16", "text": "未来。ええ、でもほとんど全員が"}, {"type": "subtitle", "time": 16820.23, "timestamp": "04:40:20", "text": "私には、えっと、休むのではなく、"}, {"type": "subtitle", "time": 16825.19, "timestamp": "04:40:25", "text": "ストレスが溜まりすぎる"}, {"type": "subtitle", "time": 16828.788, "timestamp": "04:40:28", "text": "えーっと、いつものように画面上で"}, {"type": "subtitle", "time": 16832.51, "timestamp": "04:40:32", "text": "通常、私の仕事時間はPCで行われます"}, {"type": "subtitle", "time": 16836.47, "timestamp": "04:40:36", "text": "まるで私は決して目を離さない"}, {"type": "subtitle", "time": 16840.23, "timestamp": "04:40:40", "text": "モニター画面に私が止まると"}, {"type": "subtitle", "time": 16843.91, "timestamp": "04:40:43", "text": "PCを使っていない時はスマホを使っている"}, {"type": "subtitle", "time": 16847.51, "timestamp": "04:40:47", "text": "そんな風にベッドにいるのは良くない。それ"}, {"type": "subtitle", "time": 16848.67, "timestamp": "04:40:48", "text": "とても"}, {"type": "subtitle", "time": 16851.91, "timestamp": "04:40:51", "text": "悪い。そう、気をつけなきゃいけないし"}, {"type": "subtitle", "time": 16857.83, "timestamp": "04:40:57", "text": "私自身は痛みですが、私の"}]
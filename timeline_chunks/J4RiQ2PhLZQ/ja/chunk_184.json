[{"type": "subtitle", "time": 11043.75, "timestamp": "03:04:03", "text": "知る。ジグアンチ。これは古い"}, {"type": "subtitle", "time": 11048.11, "timestamp": "03:04:08", "text": "まるで大きな叔母さんみたい。でも、あなたはそれを"}, {"type": "subtitle", "time": 11052.349, "timestamp": "03:04:12", "text": "ジガンテ。巨大"}, {"type": "subtitle", "time": 11061.429, "timestamp": "03:04:21", "text": "男の子。こんにちは。ええと、冒険はできます"}, {"type": "subtitle", "time": 11066.99, "timestamp": "03:04:26", "text": "信じる。右。 170が1つあります"}, {"type": "subtitle", "time": 11070.269, "timestamp": "03:04:30", "text": "何か。えっと、チケットは持っていません。"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "痛いですよね？コーデックス。そしてタイトルでは"}, {"type": "subtitle", "time": 11077.11, "timestamp": "03:04:37", "text": "私たちはこのことをすると言ったんですよね？"}, {"type": "subtitle", "time": 11078.95, "timestamp": "03:04:38", "text": "ストーリークエストですよね？では、物語を始めましょう"}, {"type": "subtitle", "time": 11081.03, "timestamp": "03:04:41", "text": "クエスト。"}, {"type": "subtitle", "time": 11091.11, "timestamp": "03:04:51", "text": "ガンジー、このゲームで何か思い出したことがある"}, {"type": "subtitle", "time": 11093.51, "timestamp": "03:04:53", "text": "アニメ映画か何か悲しいことに"}, {"type": "subtitle", "time": 11095.83, "timestamp": "03:04:55", "text": "私の用心深い法律はまだ見ていなかったが、私も"}, {"type": "subtitle", "time": 11097.349, "timestamp": "03:04:57", "text": "まだ見ていませんが、"}]
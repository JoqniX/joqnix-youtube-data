[{"type": "subtitle", "time": 14163.51, "timestamp": "03:56:03", "text": "こんにちは、パズルが2つ届きました。私たちはロックを解除します"}, {"type": "subtitle", "time": 14164.91, "timestamp": "03:56:04", "text": "これら"}, {"type": "subtitle", "time": 14168.07, "timestamp": "03:56:08", "text": "二。うん、パズルを解くと、"}, {"type": "subtitle", "time": 14170.11, "timestamp": "03:56:10", "text": "あなたへもっと"}, {"type": "subtitle", "time": 14190.75, "timestamp": "03:56:30", "text": "待って。何"}, {"type": "subtitle", "time": 14209.229, "timestamp": "03:56:49", "text": "待って、なぜできないの？"}, {"type": "subtitle", "time": 14216.51, "timestamp": "03:56:56", "text": "彼ら？"}]
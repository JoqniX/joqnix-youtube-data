[{"type": "subtitle", "time": 12780.309, "timestamp": "03:33:00", "text": "地域。私が言ったのはこういうことです。使用できます"}, {"type": "subtitle", "time": 12782.389, "timestamp": "03:33:02", "text": "宝物を手に入れるためのインタラクティブマップ"}, {"type": "subtitle", "time": 12785.71, "timestamp": "03:33:05", "text": "胸はこんな感じで、"}, {"type": "subtitle", "time": 12790.63, "timestamp": "03:33:10", "text": "CPとVSTA。行って確認することができます"}, {"type": "subtitle", "time": 12792.469, "timestamp": "03:33:12", "text": "Vがない場所はすべて"}, {"type": "subtitle", "time": 12795.51, "timestamp": "03:33:15", "text": "星。たとえそれがハイレベルであっても"}, {"type": "subtitle", "time": 12798.309, "timestamp": "03:33:18", "text": "場所を歩き回って"}, {"type": "subtitle", "time": 12801.429, "timestamp": "03:33:21", "text": "えーと、モブを避けて、ビアスを手に入れよう"}, {"type": "subtitle", "time": 12805.07, "timestamp": "03:33:25", "text": "このような。これにより、多くの"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "CP。ベスタ1個から651CPを獲得できます。"}, {"type": "subtitle", "time": 12814.389, "timestamp": "03:33:34", "text": "それら全てをアンロックしたと想像してみてください。"}, {"type": "subtitle", "time": 12816.03, "timestamp": "03:33:36", "text": "1,000 を獲得できます"}, {"type": "subtitle", "time": 12819.349, "timestamp": "03:33:39", "text": "CPっぽい。そしてもう一つは"}, {"type": "subtitle", "time": 12824.309, "timestamp": "03:33:44", "text": "ハンドブックになるタイトルまたは作成中のタイトル"}, {"type": "subtitle", "time": 12828.469, "timestamp": "03:33:48", "text": "CPがもらえると思います。私は知らない"}]
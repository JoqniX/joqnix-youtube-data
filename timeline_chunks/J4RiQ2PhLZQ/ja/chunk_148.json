[{"type": "subtitle", "time": 8890.11, "timestamp": "02:28:10", "text": "そしてそれは"}, {"type": "subtitle", "time": 8893.27, "timestamp": "02:28:13", "text": "これ？武器庫。異なるものを持つことができます"}, {"type": "subtitle", "time": 8895.469, "timestamp": "02:28:15", "text": "装備。"}, {"type": "subtitle", "time": 8903.51, "timestamp": "02:28:23", "text": "面白い。おお。何も持っていません"}, {"type": "subtitle", "time": 8916.429, "timestamp": "02:28:36", "text": "ああ、それで"}, {"type": "subtitle", "time": 8920.03, "timestamp": "02:28:40", "text": "宝石。私は持っていません"}, {"type": "subtitle", "time": 8923.309, "timestamp": "02:28:43", "text": "宝石。宝石を見て思い出した"}, {"type": "subtitle", "time": 8926.23, "timestamp": "02:28:46", "text": "新世界の。私はニューワールドをプレイしたことがありません"}, {"type": "subtitle", "time": 8927.71, "timestamp": "02:28:47", "text": "のように"}, {"type": "subtitle", "time": 8934.469, "timestamp": "02:28:54", "text": "忘れた。終わった。"}, {"type": "subtitle", "time": 8937.429, "timestamp": "02:28:57", "text": "これを忘れてた。かわさせてください。なぜ"}]
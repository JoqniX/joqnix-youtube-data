[{"type": "subtitle", "time": 13202.269, "timestamp": "03:40:02", "text": "鍋を割って"}, {"type": "subtitle", "time": 13205.63, "timestamp": "03:40:05", "text": "もの。そして、木箱を壊して"}, {"type": "subtitle", "time": 13208.55, "timestamp": "03:40:08", "text": "金属。時々、金属ヒューズが手に入る"}, {"type": "subtitle", "time": 13210.63, "timestamp": "03:40:10", "text": "バッジとかそういうもの。そしてそれを使うことができます"}, {"type": "subtitle", "time": 13218.87, "timestamp": "03:40:18", "text": "ポット。うん。壊れやすいものを見かけたら"}, {"type": "subtitle", "time": 13227.269, "timestamp": "03:40:27", "text": "そしてこれは、与えられるべきヒントでした"}, {"type": "subtitle", "time": 13231.99, "timestamp": "03:40:31", "text": "ショーンから私に。彼自身だ。うん。あなた"}, {"type": "subtitle", "time": 13233.91, "timestamp": "03:40:33", "text": "たくさんのヒューズバッシュを手に入れて、"}, {"type": "subtitle", "time": 13236.67, "timestamp": "03:40:36", "text": "鍋に入れる"}, {"type": "subtitle", "time": 13250.07, "timestamp": "03:40:50", "text": "はい。ああ、私はスウォッチマンのキャップを手に入れました"}]
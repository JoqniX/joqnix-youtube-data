[{"type": "subtitle", "time": 671.31, "timestamp": "00:11:11", "text": "うん。うん。ここを案内するべきだ"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "ページ。今のところ、誰もこれをレンダリングしていません。"}, {"type": "subtitle", "time": 678.71, "timestamp": "00:11:18", "text": "他の部屋。ええ、そうですね。えっと"}, {"type": "subtitle", "time": 681.55, "timestamp": "00:11:21", "text": "上部エリアは"}, {"type": "subtitle", "time": 683.99, "timestamp": "00:11:23", "text": "改装済み。そう、私たちは探しています"}, {"type": "subtitle", "time": 687.55, "timestamp": "00:11:27", "text": "新しい人が来てその職に就く"}, {"type": "subtitle", "time": 691.509, "timestamp": "00:11:31", "text": "空間。それまでは平和だ。"}, {"type": "subtitle", "time": 695.67, "timestamp": "00:11:35", "text": "それはどういう意味ですか？あぁ、それは"}, {"type": "subtitle", "time": 698.43, "timestamp": "00:11:38", "text": "私の家"}, {"type": "subtitle", "time": 701.75, "timestamp": "00:11:41", "text": "今は自分の家に住んでいます。"}, {"type": "subtitle", "time": 705.509, "timestamp": "00:11:45", "text": "えっと、私の家の1階は改装済みです。"}, {"type": "subtitle", "time": 709.509, "timestamp": "00:11:49", "text": "だから、彼らは改装されて"}, {"type": "subtitle", "time": 711.75, "timestamp": "00:11:51", "text": "2つのオフィススペースに与えて"}, {"type": "subtitle", "time": 715.23, "timestamp": "00:11:55", "text": "もの。それで、小さな部屋を手に入れたんです"}, {"type": "subtitle", "time": 718.91, "timestamp": "00:11:58", "text": "私の荷物は二階に置いてあります。"}]
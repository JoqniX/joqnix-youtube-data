[{"type": "subtitle", "time": 15194.51, "timestamp": "04:13:14", "text": "ダメージ。"}, {"type": "subtitle", "time": 15217.51, "timestamp": "04:13:37", "text": "癒す。誰がやっているのか分からない"}, {"type": "subtitle", "time": 15219.99, "timestamp": "04:13:39", "text": "治ってはいるけど、感謝してるよ。感謝"}, {"type": "subtitle", "time": 15223.11, "timestamp": "04:13:43", "text": "どういたしまして。でも待って、私は思った"}, {"type": "subtitle", "time": 15226.309, "timestamp": "04:13:46", "text": "弓兵はできない、私はロができないと思った"}, {"type": "subtitle", "time": 15228.91, "timestamp": "04:13:48", "text": "治癒するが、どうやら誰かが"}, {"type": "subtitle", "time": 15231.309, "timestamp": "04:13:51", "text": "それ。私は疑問に思う"}, {"type": "subtitle", "time": 15233.309, "timestamp": "04:13:53", "text": "誰が"}, {"type": "subtitle", "time": 15237.389, "timestamp": "04:13:57", "text": "私は痛みを感じます。私は死んだ"}]
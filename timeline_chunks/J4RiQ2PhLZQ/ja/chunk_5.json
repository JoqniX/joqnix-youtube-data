[{"type": "subtitle", "time": 301.83, "timestamp": "00:05:01", "text": "外。左から右へ折り、"}, {"type": "subtitle", "time": 303.15, "timestamp": "00:05:03", "text": "権利"}, {"type": "subtitle", "time": 311.95, "timestamp": "00:05:11", "text": "私の指示には報酬が支払われるべきだ。"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "全く問題ありません。ただおしゃべりしましょう"}, {"type": "subtitle", "time": 319.83, "timestamp": "00:05:19", "text": "今。こんにちは。はい、ただおしゃべりするだけでも構いません。はい、"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "私はあきらめます。ごめんね、ジョー。私には無理です"}, {"type": "subtitle", "time": 325.029, "timestamp": "00:05:25", "text": "これをしてください。私の脳は心配ない。いいえ"}, {"type": "subtitle", "time": 328.44, "timestamp": "00:05:28", "text": "心配事。心配ない。"}, {"type": "subtitle", "time": 330.909, "timestamp": "00:05:30", "text": "[音楽]"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "うん。折り紙はどうでしたか？"}, {"type": "subtitle", "time": 335.35, "timestamp": "00:05:35", "text": "経験？"}, {"type": "subtitle", "time": 343.11, "timestamp": "00:05:43", "text": "頭痛がする。泣いています。私"}, {"type": "subtitle", "time": 349.35, "timestamp": "00:05:49", "text": "ああ、あれは私たちがやろうとしていたものですよね？"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "それを切り落とさなければならない"}]
[{"type": "subtitle", "time": 3902.39, "timestamp": "01:05:02", "text": "それ。わかった。こんにちは。出発前に、"}, {"type": "subtitle", "time": 3903.23, "timestamp": "01:05:03", "text": "に"}, {"type": "subtitle", "time": 3905.87, "timestamp": "01:05:05", "text": "の"}, {"type": "subtitle", "time": 3907.87, "timestamp": "01:05:07", "text": "店。"}, {"type": "subtitle", "time": 3911.67, "timestamp": "01:05:11", "text": "えっと、ポイント制ですね。これです。だから私は"}, {"type": "subtitle", "time": 3912.99, "timestamp": "01:05:12", "text": "たった5人"}, {"type": "subtitle", "time": 3917.95, "timestamp": "01:05:17", "text": "トマト38個、トウモロコシ25個"}, {"type": "subtitle", "time": 3920.71, "timestamp": "01:05:20", "text": "リンゴ。私は実際にはやり方を知りません"}, {"type": "subtitle", "time": 3939.029, "timestamp": "01:05:39", "text": "あの、あのね？私たちは手に入れます、私たちは"}, {"type": "subtitle", "time": 3940.589, "timestamp": "01:05:40", "text": "実際に試してみます"}, {"type": "subtitle", "time": 3943.789, "timestamp": "01:05:43", "text": "リンゴを1つ手に入れる"}, {"type": "subtitle", "time": 3950.829, "timestamp": "01:05:50", "text": "おそらく2つ"}]
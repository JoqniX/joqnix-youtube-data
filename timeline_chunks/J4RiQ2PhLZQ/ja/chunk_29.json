[{"type": "subtitle", "time": 1748.11, "timestamp": "00:29:08", "text": "午前16時46分"}, {"type": "subtitle", "time": 1758.47, "timestamp": "00:29:18", "text": "おやすみ。私は疲れている。叩く必要はない"}, {"type": "subtitle", "time": 1764.47, "timestamp": "00:29:24", "text": "壁に頭を突っ込んだ。いや、つまり私は"}, {"type": "subtitle", "time": 1768.23, "timestamp": "00:29:28", "text": "好きなようにしたい、ただ休んでいたい"}, {"type": "subtitle", "time": 1774.59, "timestamp": "00:29:34", "text": "バイバイ。"}, {"type": "subtitle", "time": 1781.43, "timestamp": "00:29:41", "text": "できる。おやすみ。"}, {"type": "subtitle", "time": 1785.99, "timestamp": "00:29:45", "text": "最後に、お礼を申し上げて締めくくりたいと思います。"}, {"type": "subtitle", "time": 1788.63, "timestamp": "00:29:48", "text": "わかった。ここから立ち去るべきでしょうか？えっと"}, {"type": "subtitle", "time": 1791.19, "timestamp": "00:29:51", "text": "うん。最後に何か言いたいことはありますか？"}, {"type": "subtitle", "time": 1794.71, "timestamp": "00:29:54", "text": "出発前に？私を殺してください。何？"}]
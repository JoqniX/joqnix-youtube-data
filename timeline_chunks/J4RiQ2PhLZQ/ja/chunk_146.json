[{"type": "subtitle", "time": 8763.63, "timestamp": "02:26:03", "text": "自分？あなたより先に到着したスーザ"}, {"type": "subtitle", "time": 8765.91, "timestamp": "02:26:05", "text": "した。話したい相手はいますか？探す"}, {"type": "subtitle", "time": 8767.19, "timestamp": "02:26:07", "text": "彼女。黒いフェンス。あなたを案内します"}, {"type": "subtitle", "time": 8768.95, "timestamp": "02:26:08", "text": "バスマッチへようこそ、そして良い"}, {"type": "subtitle", "time": 8770.67, "timestamp": "02:26:10", "text": "運。"}, {"type": "subtitle", "time": 8789.27, "timestamp": "02:26:29", "text": "システムの仕組みがわからないのですが"}, {"type": "subtitle", "time": 8792.23, "timestamp": "02:26:32", "text": "このゲームでは、魅力強化アイテムのようなものが登場します。"}, {"type": "subtitle", "time": 8800.79, "timestamp": "02:26:40", "text": "ああ、収納スペース。いくつか入れてみます"}, {"type": "subtitle", "time": 8802.59, "timestamp": "02:26:42", "text": "ストレージ"}, {"type": "subtitle", "time": 8810.429, "timestamp": "02:26:50", "text": "えっと、これは66で、これは"}, {"type": "subtitle", "time": 8813.51, "timestamp": "02:26:53", "text": "65. アイテムをアップグレードできます。私はしません"}]
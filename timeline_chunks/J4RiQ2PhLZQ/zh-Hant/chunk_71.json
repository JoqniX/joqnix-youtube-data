[{"type": "subtitle", "time": 4269.95, "timestamp": "01:11:09", "text": "，我接下來會做一些與天國有關的事。有很多事情要做"}, {"type": "subtitle", "time": 4273.99, "timestamp": "01:11:13", "text": "。我昨天沒有登入。是的，東西太多了。"}, {"type": "subtitle", "time": 4285.91, "timestamp": "01:11:25", "text": "你好。所以我一會兒就去做"}, {"type": "subtitle", "time": 4288.99, "timestamp": "01:11:28", "text": "。然後"}]
[{"type": "subtitle", "time": 11952.87, "timestamp": "03:19:12", "text": "我不知道，我們不要拿，哦，他/她死了。不，她"}, {"type": "subtitle", "time": 11979.11, "timestamp": "03:19:39", "text": "正在吸收黑暗的"}, {"type": "subtitle", "time": 11980.95, "timestamp": "03:19:40", "text": "力量。我必須和她打一架。  哦，殺。  哦，不。不，我已經死了。我死了。我死了。我死了。我死了。戴上手套。你死了。出去。出去。回去。出去。出去。出去。"}, {"type": "subtitle", "time": 11984.79, "timestamp": "03:19:44", "text": "H 道奇公園 她有多少馬力？"}, {"type": "subtitle", "time": 11996.93, "timestamp": "03:19:56", "text": "啊，不，不，不，不。哦，他"}]
[{"type": "subtitle", "time": 26341.91, "timestamp": "07:19:01", "text": "。用的插槽連接起來，然後"}, {"type": "subtitle", "time": 26345.19, "timestamp": "07:19:05", "text": "我就會試著修理我的舊東西"}, {"type": "subtitle", "time": 26347.51, "timestamp": "07:19:07", "text": "。"}, {"type": "subtitle", "time": 26351.59, "timestamp": "07:19:11", "text": "我"}, {"type": "subtitle", "time": 26353.67, "timestamp": "07:19:13", "text": "不知道。"}, {"type": "subtitle", "time": 26359.03, "timestamp": "07:19:19", "text": "所以，呃，SN 實際上就是"}, {"type": "subtitle", "time": 26360.31, "timestamp": "07:19:20", "text": "任天堂的粉絲。對，是任天堂。這是"}, {"type": "subtitle", "time": 26362.39, "timestamp": "07:19:22", "text": "超級任天堂。哇。好的。  是的。克洛諾斯也是如此。是的，Kronos也是個搞電子產品的"}, {"type": "subtitle", "time": 26366.07, "timestamp": "07:19:26", "text": "傢伙。  我看看情況如何。這是什麼？"}, {"type": "subtitle", "time": 26382.23, "timestamp": "07:19:42", "text": "呃，雷和拉達克在哪兒？那是什麼意思呢？劍魚問道。萊萊和拉達克。"}, {"type": "subtitle", "time": 26397.35, "timestamp": "07:19:57", "text": "什麼？是的。問，等等，等等。問問Jo Lelay和Ladak在哪裡，然後等著好玩吧。"}]
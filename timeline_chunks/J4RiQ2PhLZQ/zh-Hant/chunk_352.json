[{"type": "subtitle", "time": 21123.99, "timestamp": "05:52:03", "text": "怪物"}, {"type": "subtitle", "time": 21137.43, "timestamp": "05:52:17", "text": "。我需要起床，等一個星期才能結束。"}, {"type": "subtitle", "time": 21141.03, "timestamp": "05:52:21", "text": "無法刷新。老天"}, {"type": "subtitle", "time": 21144.15, "timestamp": "05:52:24", "text": "，我該怎麼辦？只剩下五天了。"}, {"type": "subtitle", "time": 21149.83, "timestamp": "05:52:29", "text": "那麼今天是什麼"}, {"type": "subtitle", "time": 21161.35, "timestamp": "05:52:41", "text": "日子呢？今天是幾號？今天是星期四、星期五、星期六。  等待。 5天11小時。 1 2 3 4 5。哦，到星期一為止。我一直等到時間"}, {"type": "subtitle", "time": 21175.19, "timestamp": "05:52:55", "text": "。直到週一。好的。  謝謝。啊"}]
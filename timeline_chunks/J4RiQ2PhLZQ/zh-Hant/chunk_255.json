[{"type": "subtitle", "time": 15303.269, "timestamp": "04:15:03", "text": "所有人都已經打敗它了"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "二頻道。它滿了。  不，是歡迎。說實話，我其實"}, {"type": "subtitle", "time": 15332.79, "timestamp": "04:15:32", "text": "不需要做。我其實不需要廚師。我的意思是，我確實想要這條華麗的"}, {"type": "subtitle", "time": 15340.269, "timestamp": "04:15:40", "text": "項鍊。我沒有比這更好的項鍊和"}, {"type": "subtitle", "time": 15342.99, "timestamp": "04:15:42", "text": "戒指了。"}, {"type": "subtitle", "time": 15347.71, "timestamp": "04:15:47", "text": "所以，我主要得去刷巨型怪和沃爾康怪。  是的，45秒。"}]
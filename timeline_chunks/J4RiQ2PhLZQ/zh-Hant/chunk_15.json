[{"type": "subtitle", "time": 903.35, "timestamp": "00:15:03", "text": "。"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "[音樂] Jo，"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "你知道嗎？你現在住在哪裡"}, {"type": "subtitle", "time": 921.59, "timestamp": "00:15:21", "text": "？在直播中問這個問題可以嗎？"}, {"type": "subtitle", "time": 931.509, "timestamp": "00:15:31", "text": "我住在自己的房子裡。"}, {"type": "subtitle", "time": 934.47, "timestamp": "00:15:34", "text": "不用擔心。我暫時搬出了我剛才說的那個地方。  是的。是的。這將會是我的直播間。  這就是為什麼"}, {"type": "subtitle", "time": 937.509, "timestamp": "00:15:37", "text": "我買了張大桌子之類的東西"}, {"type": "subtitle", "time": 939.91, "timestamp": "00:15:39", "text": "。"}, {"type": "subtitle", "time": 942.23, "timestamp": "00:15:42", "text": "但遺憾的是，沒有專門的辦公室。是的，我可以這麼說"}, {"type": "subtitle", "time": 951.03, "timestamp": "00:15:51", "text": "。"}]
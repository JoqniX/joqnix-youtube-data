[{"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "我當時太緊張了，所以沒做。  正如我所示，你完全可以同時擁有這兩個"}, {"type": "subtitle", "time": 853.4, "timestamp": "00:14:13", "text": "角落。  所以，那天我改做了 Undertale 的"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "串燒。  啊，Undertale。我沒有。我記得你曾經推薦我玩《"}, {"type": "subtitle", "time": 890.23, "timestamp": "00:14:50", "text": "傳說之下》（Undertale）。真的很好。你"}, {"type": "subtitle", "time": 894.269, "timestamp": "00:14:54", "text": "應該玩玩，而且價格很便宜"}]
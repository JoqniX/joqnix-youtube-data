[{"type": "subtitle", "time": 26102.07, "timestamp": "07:15:02", "text": "。我們只是用嘴做到了。是的"}, {"type": "subtitle", "time": 26106.35, "timestamp": "07:15:06", "text": "，你當時有根"}, {"type": "subtitle", "time": 26109.27, "timestamp": "07:15:09", "text": "金屬管。是啊，你的嘴會火辣辣的疼。不。什麼？"}, {"type": "subtitle", "time": 26116.39, "timestamp": "07:15:16", "text": "約翰，你"}, {"type": "subtitle", "time": 26131.27, "timestamp": "07:15:31", "text": "原理是什麼？你不能對著它直接吹氣。你從遠處吹氣"}, {"type": "subtitle", "time": 26136.23, "timestamp": "07:15:36", "text": "，伙計。搞什麼鬼？哦，我以前確實做過那樣的事。"}, {"type": "chat", "time": 26156.456, "timestamp": "07:15:56", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "rxr gave up"}]
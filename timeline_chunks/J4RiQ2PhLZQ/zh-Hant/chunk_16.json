[{"type": "subtitle", "time": 963.67, "timestamp": "00:16:03", "text": "兄弟，你得在直播之外帶我"}, {"type": "subtitle", "time": 966.4, "timestamp": "00:16:06", "text": "參觀你的房間。我至今還記得，有一次Doc無意中給我打了個電話，在我沒要求的情況下帶我參觀了房間。"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "哦，是啊，很久以前了，對吧？  我的天啊。  他剛睡醒。  他過了很久才注意到這一點"}, {"type": "subtitle", "time": 1015.91, "timestamp": "00:16:55", "text": "。哦，"}]
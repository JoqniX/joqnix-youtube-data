[{"type": "subtitle", "time": 5379.43, "timestamp": "01:29:39", "text": "好的。我很好。  喚醒語音。  [音樂] 所以，呃，這裡我們需要做的首先"}, {"type": "subtitle", "time": 5384.39, "timestamp": "01:29:44", "text": "是，我們主要需要一個哦，我贏得了寶石。我贏了拍賣。好的。你好。總之，首先，我們要進入我們的王國並辦理入住手續"}, {"type": "subtitle", "time": 5394.189, "timestamp": "01:29:54", "text": "。"}, {"type": "subtitle", "time": 5397.43, "timestamp": "01:29:57", "text": "這很重要。 2019年打卡。"}]
[{"type": "subtitle", "time": 1993.11, "timestamp": "00:33:13", "text": "漂亮，但是，嗯。我來試試。我的手不好看"}, {"type": "subtitle", "time": 1998.63, "timestamp": "00:33:18", "text": "。我知道，查德。  嘿，等等，等等，等等。  [音樂] Jo做得"}, {"type": "subtitle", "time": 2005.43, "timestamp": "00:33:25", "text": "很好。為什麼這個孔"}, {"type": "subtitle", "time": 2015.47, "timestamp": "00:33:35", "text": "不能"}, {"type": "subtitle", "time": 2019.669, "timestamp": "00:33:39", "text": "插入？好的，我們應該把我們折的所有紙片都拍下來。"}, {"type": "subtitle", "time": 2033.75, "timestamp": "00:33:53", "text": "我的就只有這些。  然後，我把剩下的蝴蝶留給了它，完成它。哦，只剩下20秒了。"}]
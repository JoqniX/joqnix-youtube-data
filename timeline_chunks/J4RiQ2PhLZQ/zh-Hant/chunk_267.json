[{"type": "subtitle", "time": 16035.32, "timestamp": "04:27:15", "text": "？這令所有人都感到痛苦。而boss的血量幾乎只剩一半了。回來。"}, {"type": "subtitle", "time": 16050.469, "timestamp": "04:27:30", "text": "你好。你好。我是蒂婭。  讓我們回到暗黑破壞神的世界。我死了也沒關係。這需要一段時間，對吧？我們又回到了暗黑破壞神的世界。"}, {"type": "subtitle", "time": 16066.429, "timestamp": "04:27:46", "text": "這座橋上的人。可以幫我"}, {"type": "subtitle", "time": 16073.389, "timestamp": "04:27:53", "text": "找到乾淨的罐子"}, {"type": "subtitle", "time": 16077.07, "timestamp": "04:27:57", "text": "。  你好嗎？"}]
[{"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "哇，昨天人真多"}, {"type": "subtitle", "time": 5404.87, "timestamp": "01:30:04", "text": "。  什麼？昨天的檢查。"}, {"type": "subtitle", "time": 5417.59, "timestamp": "01:30:17", "text": "哦，只有三個人在那裡"}, {"type": "subtitle", "time": 5441.54, "timestamp": "01:30:41", "text": "。所有人都進入了非活躍狀態。今天只有我一個人。  什麼？魯比克。魯比克。你好。捐款。我會放金子。哦，"}, {"type": "subtitle", "time": 5447.99, "timestamp": "01:30:47", "text": "轟鳴。呃，我不會做黑曜石。  等待。呃，"}]
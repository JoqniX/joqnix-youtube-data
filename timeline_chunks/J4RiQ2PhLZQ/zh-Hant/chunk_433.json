[{"type": "subtitle", "time": 25987.19, "timestamp": "07:13:07", "text": "他們以前喜歡做那種……該怎麼稱呼它呢？就是用竹筒做米飯的那種"}, {"type": "subtitle", "time": 25992.708, "timestamp": "07:13:12", "text": "事。他們把石頭清理乾淨。我"}, {"type": "subtitle", "time": 26016.23, "timestamp": "07:13:36", "text": "忘了它叫什麼名字了。  我還忘了加過濾。是的。是的。  是的。過濾。他們用那玩意兒做到了。那個竹子玩意兒。  是"}, {"type": "subtitle", "time": 26019.03, "timestamp": "07:13:39", "text": "的。哦，等等。這是印地語。呃，"}, {"type": "subtitle", "time": 26025.468, "timestamp": "07:13:45", "text": "用俄羅斯信用卡。  哦，俄羅斯牌。"}, {"type": "subtitle", "time": 26027.67, "timestamp": "07:13:47", "text": "沒錯，是俄羅斯"}, {"type": "chat", "time": 26030.437, "timestamp": "07:13:50", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "I remember having that one"}, {"type": "subtitle", "time": 26031.59, "timestamp": "07:13:51", "text": "卡。好的。是的。 BPL（低於貧困線）"}, {"type": "chat", "time": 26038.279, "timestamp": "07:13:58", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "the green once"}]
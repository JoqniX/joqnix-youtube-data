[{"type": "subtitle", "time": 5644.03, "timestamp": "01:34:04", "text": "[音乐]"}, {"type": "subtitle", "time": 5646.03, "timestamp": "01:34:06", "text": "卡哇伊见面"}, {"type": "subtitle", "time": 5648.11, "timestamp": "01:34:08", "text": "蛋"}, {"type": "subtitle", "time": 5652.39, "timestamp": "01:34:12", "text": "可爱。您好，我们收到了。所以，呃，如果我们"}, {"type": "subtitle", "time": 5654.51, "timestamp": "01:34:14", "text": "看看我们的幼儿园"}, {"type": "subtitle", "time": 5657.83, "timestamp": "01:34:17", "text": "任务烹饪菜肴，呃，三道菜出炉"}, {"type": "subtitle", "time": 5659.629, "timestamp": "01:34:19", "text": "五。"}, {"type": "subtitle", "time": 5667.51, "timestamp": "01:34:27", "text": "正确的。哦，不。这个。二分之一。"}, {"type": "subtitle", "time": 5670.95, "timestamp": "01:34:30", "text": "所以，再一次，要乖哦。我可以"}, {"type": "subtitle", "time": 5673.11, "timestamp": "01:34:33", "text": "我相信我会做饭。我不，我不能"}, {"type": "subtitle", "time": 5675.95, "timestamp": "01:34:35", "text": "厨师。好的。所以，我们需要找到更多"}, {"type": "subtitle", "time": 5678.83, "timestamp": "01:34:38", "text": "这条溪流里有鸡蛋。"}, {"type": "subtitle", "time": 5684.11, "timestamp": "01:34:44", "text": "好的。升级我们的双层庭院。呃"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "成就装备。我会这样做。"}, {"type": "subtitle", "time": 5692.149, "timestamp": "01:34:52", "text": "一点。冢。"}]
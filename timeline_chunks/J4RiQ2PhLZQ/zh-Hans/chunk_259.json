[{"type": "subtitle", "time": 15548.95, "timestamp": "04:19:08", "text": "请你过来吧。不要往上爬。不要"}, {"type": "subtitle", "time": 15564.83, "timestamp": "04:19:24", "text": "只是，只是"}, {"type": "subtitle", "time": 15579.67, "timestamp": "04:19:39", "text": "啊，他在看我。他正在向上攀登"}, {"type": "subtitle", "time": 15583.71, "timestamp": "04:19:43", "text": "墙。我的天啊，这"}, {"type": "subtitle", "time": 15586.389, "timestamp": "04:19:46", "text": "B. 我想要，我想要，我不想杀人"}, {"type": "subtitle", "time": 15589.309, "timestamp": "04:19:49", "text": "他。他太穷了。"}, {"type": "subtitle", "time": 15593.149, "timestamp": "04:19:53", "text": "嗯。呃，别理我。"}, {"type": "subtitle", "time": 15596.269, "timestamp": "04:19:56", "text": "呃，我正在战斗"}]
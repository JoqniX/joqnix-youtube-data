[{"type": "subtitle", "time": 14582.63, "timestamp": "04:03:02", "text": "实验室？它使用的是同一张票吗？"}, {"type": "subtitle", "time": 14585.63, "timestamp": "04:03:05", "text": "是的。所以确实需要使用相同的方法。"}, {"type": "subtitle", "time": 14590.11, "timestamp": "04:03:10", "text": "票。哦。所以我们要做什么"}, {"type": "subtitle", "time": 14592.67, "timestamp": "04:03:12", "text": "我们会做一件事"}, {"type": "subtitle", "time": 14596.429, "timestamp": "04:03:16", "text": "那么，接下来我们将这样做"}, {"type": "subtitle", "time": 14600.15, "timestamp": "04:03:20", "text": "嗯，好的，我们现在就做一个，然后我们再做一个……"}, {"type": "subtitle", "time": 14604.189, "timestamp": "04:03:24", "text": "另一个。好的。我们将进入"}, {"type": "subtitle", "time": 14607.03, "timestamp": "04:03:27", "text": "地牢。我们走吧。你这样做很好。"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "不需要参加聚会。你可以"}, {"type": "subtitle", "time": 14627.83, "timestamp": "04:03:47", "text": "王国。这里还有一个王国地牢。"}, {"type": "subtitle", "time": 14632.189, "timestamp": "04:03:52", "text": "我们都需要这样做，哦，我"}, {"type": "subtitle", "time": 14636.229, "timestamp": "04:03:56", "text": "可以。是的。啊，你消失了。是的，我"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "消失了。去那里。"}]
[{"type": "subtitle", "time": 6360.35, "timestamp": "01:46:00", "text": "做？冬天来了。是的。你好。欢迎。"}, {"type": "subtitle", "time": 6362.709, "timestamp": "01:46:02", "text": "欢迎。等等，这是你第一次吗？"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "是的，我相信这是你第一次"}, {"type": "subtitle", "time": 6387.669, "timestamp": "01:46:27", "text": "聊天暂停了。呃，我妈妈刚刚"}, {"type": "subtitle", "time": 6390.709, "timestamp": "01:46:30", "text": "打电话。等待。欢迎。欢迎。"}, {"type": "subtitle", "time": 6393.119, "timestamp": "01:46:33", "text": "欢迎。 不，这不是我第一次。啊，我"}, {"type": "subtitle", "time": 6395.36, "timestamp": "01:46:35", "text": "不，这不是我第一次。啊，我 我以为你是第一次来，因为……"}, {"type": "subtitle", "time": 6397.84, "timestamp": "01:46:37", "text": "我以为你是第一次来，因为…… 是因为我以为是阿凡达"}, {"type": "subtitle", "time": 6401.239, "timestamp": "01:46:41", "text": "是因为我以为是阿凡达 似乎我没有"}, {"type": "subtitle", "time": 6407.55, "timestamp": "01:46:47", "text": "知道。你过得怎么样？"}, {"type": "subtitle", "time": 6411.43, "timestamp": "01:46:51", "text": "天？是的，我得去看看……"}, {"type": "subtitle", "time": 6414.07, "timestamp": "01:46:54", "text": "因为一些事情而组建家庭。我不知道"}, {"type": "subtitle", "time": 6416.87, "timestamp": "01:46:56", "text": "我邻居那边发生了什么事？"}, {"type": "subtitle", "time": 6419.99, "timestamp": "01:46:59", "text": "看看他们在我家后院干了些什么。所以，我"}]
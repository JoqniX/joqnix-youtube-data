[{"type": "subtitle", "time": 16453.949, "timestamp": "04:34:13", "text": "钻石。哦，是的，快到了。"}, {"type": "subtitle", "time": 16456.709, "timestamp": "04:34:16", "text": "10:15，对吧？等等，你们呢？"}, {"type": "subtitle", "time": 16458.029, "timestamp": "04:34:18", "text": "还记得吗？"}, {"type": "subtitle", "time": 16461.109, "timestamp": "04:34:21", "text": "我滴眼药水了吗？所以我觉得我需要"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "把我的夜晚放进去，等等，早上那个我"}, {"type": "subtitle", "time": 16467.349, "timestamp": "04:34:27", "text": "中午时分。"}, {"type": "subtitle", "time": 16470.629, "timestamp": "04:34:30", "text": "晚上，呃，中午，我放了5。"}, {"type": "subtitle", "time": 16474.109, "timestamp": "04:34:34", "text": "晚上我放了8:30"}, {"type": "subtitle", "time": 16477.949, "timestamp": "04:34:37", "text": "下午那天晚上我可以放12个，我"}, {"type": "subtitle", "time": 16480.709, "timestamp": "04:34:40", "text": "猜测。是的，还有另一个。是的，"}, {"type": "subtitle", "time": 16483.269, "timestamp": "04:34:43", "text": "我可以做到，伙计。明天我将"}, {"type": "subtitle", "time": 16486.39, "timestamp": "04:34:46", "text": "肯定会在早上6点醒来并把它放好。"}, {"type": "subtitle", "time": 16488.91, "timestamp": "04:34:48", "text": "我不会想念的。"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "它。一天四次，对吧？所以，"}, {"type": "subtitle", "time": 16495.91, "timestamp": "04:34:55", "text": "早上6点，然后中午12点……"}, {"type": "subtitle", "time": 16499.109, "timestamp": "04:34:59", "text": "中午12点，然后晚上可能就到晚上了。"}]
[{"type": "subtitle", "time": 3061.109, "timestamp": "00:51:01", "text": "我们一会儿就要让他上场了。不是"}, {"type": "subtitle", "time": 3063.829, "timestamp": "00:51:03", "text": "现在，但过一会儿，等我们做完之后。"}, {"type": "subtitle", "time": 3066.309, "timestamp": "00:51:06", "text": "登录并完成所有任务"}, {"type": "subtitle", "time": 3069.349, "timestamp": "00:51:09", "text": "他们每一个人。我正在努力奋斗"}, {"type": "subtitle", "time": 3072.23, "timestamp": "00:51:12", "text": "这款游戏是为了制作"}, {"type": "subtitle", "time": 3076.44, "timestamp": "00:51:16", "text": "呃，女巫像 onx 一样吟唱着红色"}, {"type": "subtitle", "time": 3077.63, "timestamp": "00:51:17", "text": "[音乐]"}, {"type": "subtitle", "time": 3081.109, "timestamp": "00:51:21", "text": "头。你意识到这一点了吗？你不需要"}, {"type": "subtitle", "time": 3084.069, "timestamp": "00:51:24", "text": "里面有音乐吗？啊，我忘了。是的，这是"}, {"type": "subtitle", "time": 3086.309, "timestamp": "00:51:26", "text": "我为什么觉得需要发起一项投票"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "系统允许聊天自动进行。"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "触发投票并关闭"}, {"type": "subtitle", "time": 3096.71, "timestamp": "00:51:36", "text": "或许版主可以改变人们的看法。"}, {"type": "subtitle", "time": 3099.15, "timestamp": "00:51:39", "text": "音乐"}, {"type": "subtitle", "time": 3102.15, "timestamp": "00:51:42", "text": "东西。所以即使我忘记了你"}, {"type": "subtitle", "time": 3106.309, "timestamp": "00:51:46", "text": "男人也能做到。这就是我为什么说“哦”的原因"}, {"type": "subtitle", "time": 3108.43, "timestamp": "00:51:48", "text": "我需要一份工作"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "现在系统已启动。嗯，我不知道我是否可以"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "使用 YouTube 的投票系统，但至少"}, {"type": "subtitle", "time": 3117.67, "timestamp": "00:51:57", "text": "聊天评论，有可能。全部"}]
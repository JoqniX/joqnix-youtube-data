[{"type": "subtitle", "time": 9601.309, "timestamp": "02:40:01", "text": "Twitch上的移动用户"}, {"type": "subtitle", "time": 9603.59, "timestamp": "02:40:03", "text": "打磨。是的，我想这么做。"}, {"type": "subtitle", "time": 9607.19, "timestamp": "02:40:07", "text": "类似这样的YouTube视频。我是"}, {"type": "subtitle", "time": 9608.91, "timestamp": "02:40:08", "text": "比如，我应该怎么做？"}, {"type": "subtitle", "time": 9613.63, "timestamp": "02:40:13", "text": "做？一些可以互动的东西"}, {"type": "subtitle", "time": 9616.469, "timestamp": "02:40:16", "text": "做。我可以做一些互动性强的事情。"}, {"type": "subtitle", "time": 9619.27, "timestamp": "02:40:19", "text": "尤其是我们会像……那样做"}, {"type": "subtitle", "time": 9623.03, "timestamp": "02:40:23", "text": "虚幻引擎世界相关的东西，还有……"}, {"type": "subtitle", "time": 9626.71, "timestamp": "02:40:26", "text": "也正因为如此。我不相信任何人"}, {"type": "subtitle", "time": 9629.469, "timestamp": "02:40:29", "text": "为 YouTube 开发了一个扩展程序"}, {"type": "subtitle", "time": 9634.07, "timestamp": "02:40:34", "text": "还没聊天吗？所以我有点担心。所以我是"}, {"type": "subtitle", "time": 9637.23, "timestamp": "02:40:37", "text": "像担心一样。而且，那也是一个领域吗？"}, {"type": "subtitle", "time": 9639.79, "timestamp": "02:40:39", "text": "老板通知"}, {"type": "subtitle", "time": 9642.63, "timestamp": "02:40:42", "text": "声音还是提示音？什么是"}, {"type": "subtitle", "time": 9643.71, "timestamp": "02:40:43", "text": "那"}, {"type": "subtitle", "time": 9646.55, "timestamp": "02:40:46", "text": "声音？现在是几奌？"}, {"type": "subtitle", "time": 9649.23, "timestamp": "02:40:49", "text": "我觉得我可以睁开眼睛了。"}, {"type": "subtitle", "time": 9652.309, "timestamp": "02:40:52", "text": "是的。哦，他还在做这个任务。"}, {"type": "subtitle", "time": 9655.99, "timestamp": "02:40:55", "text": "现在是8点20分。这意味着8:30在场地"}, {"type": "subtitle", "time": 9658.83, "timestamp": "02:40:58", "text": "老板要来了。所以，那是10"}]
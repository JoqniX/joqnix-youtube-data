[{"type": "subtitle", "time": 2282.39, "timestamp": "00:38:02", "text": "某物。音乐也是如此。"}, {"type": "subtitle", "time": 2286.39, "timestamp": "00:38:06", "text": "制片人在完成制作前就退出了"}, {"type": "subtitle", "time": 2289.589, "timestamp": "00:38:09", "text": "99%的生产者在完成目标前就退出了。"}, {"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "发布他们的热门歌曲之类的。"}, {"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "那就像一句俗语一样。相同的"}, {"type": "subtitle", "time": 2298.91, "timestamp": "00:38:18", "text": "这件事也可以用其他文体来表达，例如"}, {"type": "subtitle", "time": 2302.79, "timestamp": "00:38:22", "text": "出色地。不是你可以涉猎的类型细分领域"}, {"type": "subtitle", "time": 2304.79, "timestamp": "00:38:24", "text": "说。"}, {"type": "subtitle", "time": 2313.03, "timestamp": "00:38:33", "text": "那是我的弦，呃，是我今天的"}, {"type": "subtitle", "time": 2317.47, "timestamp": "00:38:37", "text": "直播流畅吗？我当时正在用手机"}, {"type": "subtitle", "time": 2320.47, "timestamp": "00:38:40", "text": "相机。我当时正在使用手机摄像头。我"}, {"type": "subtitle", "time": 2322.47, "timestamp": "00:38:42", "text": "不知道好不好。我认为是"}, {"type": "subtitle", "time": 2327.03, "timestamp": "00:38:47", "text": "使用后置摄像头，2倍变焦的那个。不，"}, {"type": "subtitle", "time": 2330.069, "timestamp": "00:38:50", "text": "不，是外置摄像头，就像"}, {"type": "subtitle", "time": 2334.55, "timestamp": "00:38:54", "text": "我猜是远距离拍摄的。是的。"}]
[{"type": "subtitle", "time": 8522.03, "timestamp": "02:22:02", "text": "出口。"}, {"type": "subtitle", "time": 8523.56, "timestamp": "02:22:03", "text": "嗯？等待，"}, {"type": "subtitle", "time": 8525.309, "timestamp": "02:22:05", "text": "[音乐]"}, {"type": "subtitle", "time": 8534.429, "timestamp": "02:22:14", "text": "我也想知道现在发生了什么"}, {"type": "subtitle", "time": 8537.309, "timestamp": "02:22:17", "text": "中国？哦，最后"}, {"type": "subtitle", "time": 8540.95, "timestamp": "02:22:20", "text": "解决方案。哦，是的，最后一个任务"}, {"type": "subtitle", "time": 8543.19, "timestamp": "02:22:23", "text": "寻求。我们需要回到尼诺"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "稍等片刻。我们将进行声誉方面的工作。"}, {"type": "subtitle", "time": 8548.19, "timestamp": "02:22:28", "text": "以及那里的故事任务，"}, {"type": "subtitle", "time": 8555.51, "timestamp": "02:22:35", "text": "亚希克。哦，等等。现在是八点。我忘了。"}, {"type": "subtitle", "time": 8557.95, "timestamp": "02:22:37", "text": "我需要睁开眼睛"}, {"type": "subtitle", "time": 8564.51, "timestamp": "02:22:44", "text": "滴。我忘了是"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "八。那是我的。就是这样。让我"}, {"type": "subtitle", "time": 8576.83, "timestamp": "02:22:56", "text": "它。所以，这到底是怎么回事？"}, {"type": "subtitle", "time": 8578.59, "timestamp": "02:22:58", "text": "哦"}]
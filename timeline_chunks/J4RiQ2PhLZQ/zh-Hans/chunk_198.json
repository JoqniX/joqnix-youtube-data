[{"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "抵抗。但没关系。我会，我可以"}, {"type": "subtitle", "time": 11886.87, "timestamp": "03:18:06", "text": "我认为应该升级一下。"}, {"type": "subtitle", "time": 11889.229, "timestamp": "03:18:09", "text": "等等，宝石在哪儿？呃，一个"}, {"type": "subtitle", "time": 11893.429, "timestamp": "03:18:13", "text": "更多的。我没有铁锹。呃，这是"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "我能用铲子，对吧？这个东西。我"}, {"type": "subtitle", "time": 11898.83, "timestamp": "03:18:18", "text": "我没有它，因为我的神灵"}, {"type": "subtitle", "time": 11902.75, "timestamp": "03:18:22", "text": "弓。这个也是。他们俩都需要"}, {"type": "subtitle", "time": 11905.99, "timestamp": "03:18:25", "text": "铲。我用它来做这件事。啊，我可以"}, {"type": "subtitle", "time": 11908.389, "timestamp": "03:18:28", "text": "我用它做过这件事。啊，等等。它是"}, {"type": "subtitle", "time": 11909.469, "timestamp": "03:18:29", "text": "美好的。它是"}, {"type": "subtitle", "time": 11912.95, "timestamp": "03:18:32", "text": "美好的。我用的是这个。三叶草"}, {"type": "subtitle", "time": 11915.349, "timestamp": "03:18:35", "text": "一。"}, {"type": "subtitle", "time": 11922.27, "timestamp": "03:18:42", "text": "抵抗。和"}, {"type": "subtitle", "time": 11924.99, "timestamp": "03:18:44", "text": "[音乐]"}, {"type": "subtitle", "time": 11927.429, "timestamp": "03:18:47", "text": "是的，我还以为你被冒犯了呢。"}, {"type": "subtitle", "time": 11930.469, "timestamp": "03:18:50", "text": "混乱。这是真的。"}, {"type": "subtitle", "time": 11932.95, "timestamp": "03:18:52", "text": "黑魔法。哦，是的，显然有。"}, {"type": "subtitle", "time": 11935.229, "timestamp": "03:18:55", "text": "另一种类型的"}, {"type": "subtitle", "time": 11938.19, "timestamp": "03:18:58", "text": "高阶终局内容，也就是黑暗面。"}]
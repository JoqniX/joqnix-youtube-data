[{"type": "subtitle", "time": 12602.79, "timestamp": "03:30:02", "text": "我到底要去多少次？"}, {"type": "subtitle", "time": 12604.91, "timestamp": "03:30:04", "text": "通过这一步"}, {"type": "subtitle", "time": 12611.59, "timestamp": "03:30:11", "text": "那说明你很强壮。想要"}, {"type": "subtitle", "time": 12614.309, "timestamp": "03:30:14", "text": "帮帮我？是的。"}, {"type": "subtitle", "time": 12617.269, "timestamp": "03:30:17", "text": "你能教小妖精和大蘑菇吗？"}, {"type": "subtitle", "time": 12619.11, "timestamp": "03:30:19", "text": "村子北边的沼泽地能给我们带来什么教训呢？"}, {"type": "subtitle", "time": 12621.59, "timestamp": "03:30:21", "text": "是的。"}, {"type": "subtitle", "time": 12625.71, "timestamp": "03:30:25", "text": "美好的。交给我们吧。我们会的"}, {"type": "subtitle", "time": 12627.35, "timestamp": "03:30:27", "text": "那。"}, {"type": "subtitle", "time": 12629.469, "timestamp": "03:30:29", "text": "[音乐]"}, {"type": "subtitle", "time": 12633.79, "timestamp": "03:30:33", "text": "吞食。哦，听起来没错。我"}, {"type": "subtitle", "time": 12636.67, "timestamp": "03:30:36", "text": "忘了"}, {"type": "subtitle", "time": 12639.95, "timestamp": "03:30:39", "text": "这是音频游戏，对吧？"}, {"type": "subtitle", "time": 12643.75, "timestamp": "03:30:43", "text": "配音为日语。"}, {"type": "subtitle", "time": 12645.87, "timestamp": "03:30:45", "text": "下载完成。"}]
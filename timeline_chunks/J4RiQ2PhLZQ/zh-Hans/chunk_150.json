[{"type": "subtitle", "time": 9003.99, "timestamp": "02:30:03", "text": "好的。你好。所以，我会滴几滴。"}, {"type": "subtitle", "time": 9006.349, "timestamp": "02:30:06", "text": "我们可以亲眼见证这一切的发生。你可以观看"}, {"type": "subtitle", "time": 9016.23, "timestamp": "02:30:16", "text": "东西。等等，我们小心点。"}, {"type": "subtitle", "time": 9019.67, "timestamp": "02:30:19", "text": "确保我击中目标，确保我瞄准准确。"}, {"type": "subtitle", "time": 9021.91, "timestamp": "02:30:21", "text": "眼睛。"}, {"type": "subtitle", "time": 9024.87, "timestamp": "02:30:24", "text": "我的天哪。问题是，当你把眼睛放进去的时候"}, {"type": "subtitle", "time": 9028.83, "timestamp": "02:30:28", "text": "滴眼药水后，我的眼睛会变得非常容易流泪。"}, {"type": "subtitle", "time": 9033.87, "timestamp": "02:30:33", "text": "快的。感觉就像是这样"}, {"type": "subtitle", "time": 9054.83, "timestamp": "02:30:54", "text": "好的，一个"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "完毕。还剩最后一个。所以，我已经完成了"}, {"type": "subtitle", "time": 9059.95, "timestamp": "02:30:59", "text": "左边"}]
[{"type": "subtitle", "time": 1860.71, "timestamp": "00:31:00", "text": "今天就到这里。我玩得很开心"}, {"type": "subtitle", "time": 1865.669, "timestamp": "00:31:05", "text": "再次合作。那就这么定了。"}, {"type": "subtitle", "time": 1869.83, "timestamp": "00:31:09", "text": "然后我就要休息了，因为我……而且我"}, {"type": "subtitle", "time": 1872.71, "timestamp": "00:31:12", "text": "忘了。我忘了喝袖口糖浆。"}, {"type": "subtitle", "time": 1875.59, "timestamp": "00:31:15", "text": "我喝。是的。是的。喝药。"}, {"type": "subtitle", "time": 1877.59, "timestamp": "00:31:17", "text": "我甚至连打扫卫生的欲望都没有。"}, {"type": "subtitle", "time": 1884.87, "timestamp": "00:31:24", "text": "晚安。你好。晚安。再见。"}, {"type": "subtitle", "time": 1894.75, "timestamp": "00:31:34", "text": "结束。然后她就离开了。"}, {"type": "subtitle", "time": 1898.47, "timestamp": "00:31:38", "text": "耶。好的才是关键。谢谢"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "也感谢所有到场的人。等等，我"}, {"type": "subtitle", "time": 1905.71, "timestamp": "00:31:45", "text": "我想我还能对着镜头展示一下，我"}, {"type": "subtitle", "time": 1909.549, "timestamp": "00:31:49", "text": "猜测。所以，谢谢你们"}, {"type": "subtitle", "time": 1912.549, "timestamp": "00:31:52", "text": "感谢各位的光临。"}, {"type": "subtitle", "time": 1916.87, "timestamp": "00:31:56", "text": "你们喜欢和Zuki一起玩吗？"}]
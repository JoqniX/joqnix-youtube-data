[{"type": "subtitle", "time": 9187.83, "timestamp": "02:33:07", "text": "是的，我想问问你做了什么。"}, {"type": "subtitle", "time": 9189.99, "timestamp": "02:33:09", "text": "你们也做类似的事情吗？"}, {"type": "subtitle", "time": 9192.55, "timestamp": "02:33:12", "text": "就像你拼命挣扎、努力工作一样"}, {"type": "subtitle", "time": 9195.59, "timestamp": "02:33:15", "text": "PC 就像 PC 或手机一样，更多"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "超过一两个小时。你喜欢亲近吗？"}, {"type": "subtitle", "time": 9199.99, "timestamp": "02:33:19", "text": "让你的眼睛休息一会儿，就像休息一样。"}, {"type": "subtitle", "time": 9202.03, "timestamp": "02:33:22", "text": "你的"}, {"type": "subtitle", "time": 9205.19, "timestamp": "02:33:25", "text": "闭上眼睛大约15分钟"}, {"type": "subtitle", "time": 9207.59, "timestamp": "02:33:27", "text": "分钟，或者像不是15分钟，而是10分钟"}, {"type": "subtitle", "time": 9209.75, "timestamp": "02:33:29", "text": "至少或者像做眼部运动一样"}, {"type": "subtitle", "time": 9212.469, "timestamp": "02:33:32", "text": "以及一些保持眼睛健康的东西"}, {"type": "subtitle", "time": 9215.51, "timestamp": "02:33:35", "text": "比如不紧张之类的。我不知道"}, {"type": "subtitle", "time": 9222.71, "timestamp": "02:33:42", "text": "那。哦，对了，对于YouTube用户来说……"}, {"type": "subtitle", "time": 9224.15, "timestamp": "02:33:44", "text": "伙计们，你们不知道发生了什么。"}, {"type": "subtitle", "time": 9225.99, "timestamp": "02:33:45", "text": "昨天，对吧？是的，显然"}, {"type": "subtitle", "time": 9229.51, "timestamp": "02:33:49", "text": "昨天我去看眼科医生了。"}, {"type": "subtitle", "time": 9232.11, "timestamp": "02:33:52", "text": "昨天预约了眼科检查。"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "医生，是的，我会的，看来我"}, {"type": "subtitle", "time": 9236.91, "timestamp": "02:33:56", "text": "有"}, {"type": "subtitle", "time": 9239.63, "timestamp": "02:33:59", "text": "光恐惧症，即对光的敏感性"}]
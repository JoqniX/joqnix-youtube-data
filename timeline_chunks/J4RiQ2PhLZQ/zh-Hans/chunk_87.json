[{"type": "subtitle", "time": 5221.79, "timestamp": "01:27:01", "text": "[音乐]"}, {"type": "subtitle", "time": 5224.709, "timestamp": "01:27:04", "text": "那。捐赠黑曜石。将会这样做。"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "明天之前。或者后天"}, {"type": "subtitle", "time": 5230.11, "timestamp": "01:27:10", "text": "相信。"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "H 创建地牢三次包括"}, {"type": "subtitle", "time": 5237.43, "timestamp": "01:27:17", "text": "雇佣兵。什么是雇佣兵？我"}, {"type": "subtitle", "time": 5240.229, "timestamp": "01:27:20", "text": "相信其他人都喜欢整个团队"}, {"type": "subtitle", "time": 5242.709, "timestamp": "01:27:22", "text": "所有公会成员也必须清除"}, {"type": "subtitle", "time": 5244.43, "timestamp": "01:27:24", "text": "这"}, {"type": "subtitle", "time": 5247.99, "timestamp": "01:27:27", "text": "需要进入地下城才能完成这项任务。我"}, {"type": "subtitle", "time": 5262.91, "timestamp": "01:27:42", "text": "呃，地牢两次"}, {"type": "subtitle", "time": 5267.47, "timestamp": "01:27:47", "text": "黑曜石厨师两项费用"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "坐着，一次都没做过。嗨，你可以做。"}]
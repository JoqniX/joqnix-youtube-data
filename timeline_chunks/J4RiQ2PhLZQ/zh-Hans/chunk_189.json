[{"type": "subtitle", "time": 11341.55, "timestamp": "03:09:01", "text": "下周将与 Hollow 一起直播"}, {"type": "subtitle", "time": 11344.23, "timestamp": "03:09:04", "text": "骑士。已经很久了……"}, {"type": "subtitle", "time": 11345.95, "timestamp": "03:09:05", "text": "触碰了那两个人，"}, {"type": "subtitle", "time": 11348.63, "timestamp": "03:09:08", "text": "正确的？如果有人知道更多信息的话"}, {"type": "subtitle", "time": 11350.75, "timestamp": "03:09:10", "text": "这些谣言，将会是"}, {"type": "subtitle", "time": 11355.349, "timestamp": "03:09:15", "text": "她。嗨，我们完成了。嗯，我会的。"}, {"type": "subtitle", "time": 11357.429, "timestamp": "03:09:17", "text": "我会把它放在后台。即使是我们"}, {"type": "subtitle", "time": 11359.51, "timestamp": "03:09:19", "text": "你永远不会知道，对吗？"}, {"type": "subtitle", "time": 11362.55, "timestamp": "03:09:22", "text": "谁知道我们是否需要它呢？我们"}, {"type": "subtitle", "time": 11366.55, "timestamp": "03:09:26", "text": "已经把东西处理掉了。"}, {"type": "subtitle", "time": 11369.309, "timestamp": "03:09:29", "text": "我们需要做，我们需要去……"}, {"type": "subtitle", "time": 11372.349, "timestamp": "03:09:32", "text": "渡船。我是"}, {"type": "subtitle", "time": 11375.429, "timestamp": "03:09:35", "text": "卡住。哦，对了，雷米，如果你还在的话。"}, {"type": "subtitle", "time": 11378.95, "timestamp": "03:09:38", "text": "是派对，对吧？所以，嗯，你参加派对。"}, {"type": "subtitle", "time": 11382.15, "timestamp": "03:09:42", "text": "显然还有额外奖励。你得到了两党"}, {"type": "subtitle", "time": 11384.87, "timestamp": "03:09:44", "text": "因为我们是两个人，所以还有额外的好处，对吧？你"}, {"type": "subtitle", "time": 11386.55, "timestamp": "03:09:46", "text": "获取黄金价格和价格下跌信息"}, {"type": "subtitle", "time": 11389.429, "timestamp": "03:09:49", "text": "如果您在附近，请仅在此处评价。"}, {"type": "subtitle", "time": 11393.469, "timestamp": "03:09:53", "text": "实际上，他们和党员们的情况一样。"}]
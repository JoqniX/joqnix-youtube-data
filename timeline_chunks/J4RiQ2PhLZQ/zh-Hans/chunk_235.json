[{"type": "subtitle", "time": 14111.99, "timestamp": "03:55:11", "text": "你好。啊。只用光击败敌人"}, {"type": "subtitle", "time": 14115.269, "timestamp": "03:55:15", "text": "武器。啊，我没做过那件事。它是"}, {"type": "subtitle", "time": 14138.189, "timestamp": "03:55:38", "text": "后退。征服点数已恢复"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "我不想充电。我想要"}, {"type": "subtitle", "time": 14151.469, "timestamp": "03:55:51", "text": "留到游戏后期再用吧。"}, {"type": "subtitle", "time": 14154.55, "timestamp": "03:55:54", "text": "正确的？这就是为什么我不使用我的呃"}]
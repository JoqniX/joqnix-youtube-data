[{"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "我要通过离开给他们留下回忆"}, {"type": "subtitle", "time": 16809.91, "timestamp": "04:40:09", "text": "限幅器。是啊，疼痛"}, {"type": "subtitle", "time": 16811.43, "timestamp": "04:40:11", "text": "呃，我希望你的眼睛会永远消失。"}, {"type": "subtitle", "time": 16813.75, "timestamp": "04:40:13", "text": "给你更多游戏乐趣"}, {"type": "subtitle", "time": 16816.31, "timestamp": "04:40:16", "text": "未来。是的，但他们大多数人都这么说过。"}, {"type": "subtitle", "time": 16820.23, "timestamp": "04:40:20", "text": "让我休息一下，其实不是。"}, {"type": "subtitle", "time": 16825.19, "timestamp": "04:40:25", "text": "给自己太大压力了"}, {"type": "subtitle", "time": 16828.788, "timestamp": "04:40:28", "text": "呃，就像我一直以来那样，在屏幕上"}, {"type": "subtitle", "time": 16832.51, "timestamp": "04:40:32", "text": "通常我的工作时间都在电脑上。"}, {"type": "subtitle", "time": 16836.47, "timestamp": "04:40:36", "text": "我就像从未把目光从他身上移开过一样"}, {"type": "subtitle", "time": 16840.23, "timestamp": "04:40:40", "text": "如果我停下来，显示器屏幕会显示……"}, {"type": "subtitle", "time": 16843.91, "timestamp": "04:40:43", "text": "比如，如果我不在电脑前，我就在手机上。"}, {"type": "subtitle", "time": 16847.51, "timestamp": "04:40:47", "text": "那样躺在床上，这样不好。那"}, {"type": "subtitle", "time": 16848.67, "timestamp": "04:40:48", "text": "非常"}, {"type": "subtitle", "time": 16851.91, "timestamp": "04:40:51", "text": "坏的。是的，我需要照顾好自己。"}, {"type": "subtitle", "time": 16857.83, "timestamp": "04:40:57", "text": "我自己，这很痛苦，但也是我自己的"}]
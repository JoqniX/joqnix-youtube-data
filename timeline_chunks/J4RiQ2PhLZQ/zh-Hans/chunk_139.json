[{"type": "subtitle", "time": 8353.99, "timestamp": "02:19:13", "text": "哦，他/她去世了。不，她正在食用"}, {"type": "subtitle", "time": 8369.27, "timestamp": "02:19:29", "text": "哦，杀。"}, {"type": "subtitle", "time": 8370.629, "timestamp": "02:19:30", "text": "哦，不。不，我已经死了。我死了。我是"}, {"type": "subtitle", "time": 8399.11, "timestamp": "02:19:59", "text": "手套。你死了。出去。出去。得到"}]
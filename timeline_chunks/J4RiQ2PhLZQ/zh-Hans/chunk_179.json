[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "躲闪。为什么？别担心，劳娜。呃，因为"}, {"type": "subtitle", "time": 10745.83, "timestamp": "02:59:05", "text": "Nouni是一款挂机游戏。我当时在玩"}, {"type": "subtitle", "time": 10748.11, "timestamp": "02:59:08", "text": "我在做某事的时候，背景音乐是​​暗黑破坏神。"}, {"type": "subtitle", "time": 10758.389, "timestamp": "02:59:18", "text": "是的。是的。巨人是可以被击败的"}, {"type": "subtitle", "time": 10759.95, "timestamp": "02:59:19", "text": "已经。是的。你好"}, {"type": "subtitle", "time": 10768.55, "timestamp": "02:59:28", "text": "正在做？事情就此完成。"}, {"type": "subtitle", "time": 10770.07, "timestamp": "02:59:30", "text": "其他所有频道。哦，我们可以去"}, {"type": "subtitle", "time": 10772.71, "timestamp": "02:59:32", "text": "14频道。实际上，该频道已满。"}, {"type": "subtitle", "time": 10775.389, "timestamp": "02:59:35", "text": "呃，每个人都是"}, {"type": "subtitle", "time": 10777.15, "timestamp": "02:59:37", "text": "满的。"}, {"type": "subtitle", "time": 10779.87, "timestamp": "02:59:39", "text": "美好的。好的。呃，那就是"}, {"type": "subtitle", "time": 10782.389, "timestamp": "02:59:42", "text": "完毕。现在我们可以去找克里斯汀了"}, {"type": "subtitle", "time": 10784.429, "timestamp": "02:59:44", "text": "完成我们的"}, {"type": "subtitle", "time": 10786.95, "timestamp": "02:59:46", "text": "寻求。好的。你看到你了吗？"}, {"type": "subtitle", "time": 10788.63, "timestamp": "02:59:48", "text": "看过医生了。很高兴听到这个消息。"}, {"type": "subtitle", "time": 10791.19, "timestamp": "02:59:51", "text": "是的。昨天我去看了一位内科医生。"}, {"type": "subtitle", "time": 10794.15, "timestamp": "02:59:54", "text": "去看眼科医生了。所以显然我"}, {"type": "subtitle", "time": 10796.429, "timestamp": "02:59:56", "text": "有"}, {"type": "subtitle", "time": 10799.429, "timestamp": "02:59:59", "text": "她有点恐照症，还告诉我呃"}]
[{"type": "subtitle", "time": 13320.63, "timestamp": "03:42:00", "text": "实际上是两个帽子的帽子。患病的"}, {"type": "subtitle", "time": 13322.75, "timestamp": "03:42:02", "text": "照做就行了。"}, {"type": "subtitle", "time": 13325.389, "timestamp": "03:42:05", "text": "也。我们开始吧"}, {"type": "subtitle", "time": 13328.51, "timestamp": "03:42:08", "text": "这。森林之魂"}, {"type": "subtitle", "time": 13331.349, "timestamp": "03:42:11", "text": "石头。没什么特别的，不过，是的。"}, {"type": "subtitle", "time": 13338.4, "timestamp": "03:42:18", "text": "哦，10"}, {"type": "subtitle", "time": 13345.71, "timestamp": "03:42:25", "text": "份量。 10份"}, {"type": "subtitle", "time": 13348.67, "timestamp": "03:42:28", "text": "再次。我有"}, {"type": "subtitle", "time": 13357.03, "timestamp": "03:42:37", "text": "太阳石。我有78个。你知道吗？我"}, {"type": "subtitle", "time": 13358.91, "timestamp": "03:42:38", "text": "将保存"}, {"type": "subtitle", "time": 13361.63, "timestamp": "03:42:41", "text": "这。你知道吗？我会保存"}, {"type": "subtitle", "time": 13364.87, "timestamp": "03:42:44", "text": "这是因为想象一下，如果出现大幅下跌的话。"}, {"type": "subtitle", "time": 13368.71, "timestamp": "03:42:48", "text": "未来。那我该怎么办？不。是的。"}, {"type": "subtitle", "time": 13370.429, "timestamp": "03:42:50", "text": "最大保险丝"}, {"type": "subtitle", "time": 13374.83, "timestamp": "03:42:54", "text": "都是那样。我明白了，我明白了"}, {"type": "subtitle", "time": 13376.75, "timestamp": "03:42:56", "text": "98."}]
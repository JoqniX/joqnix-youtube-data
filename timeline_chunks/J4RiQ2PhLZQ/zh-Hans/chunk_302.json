[{"type": "subtitle", "time": 18121.03, "timestamp": "05:02:01", "text": "低调的感觉就像孤独。是的，确实如此。"}, {"type": "subtitle", "time": 18130.948, "timestamp": "05:02:10", "text": "是的，整个地方到处都是……"}, {"type": "subtitle", "time": 18133.28, "timestamp": "05:02:13", "text": "月光下的恋人。怎样"}, {"type": "subtitle", "time": 18134.59, "timestamp": "05:02:14", "text": "[音乐]"}, {"type": "subtitle", "time": 18140.35, "timestamp": "05:02:20", "text": "你？等等，让我拿一下这个。"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "好的。你是谁？你为什么要这样做？"}, {"type": "subtitle", "time": 18144.91, "timestamp": "05:02:24", "text": "有"}, {"type": "subtitle", "time": 18153.03, "timestamp": "05:02:33", "text": "花朵？你一定是偷东西的小偷。"}, {"type": "subtitle", "time": 18161.11, "timestamp": "05:02:41", "text": "内森是谁？哦，所以内森是我的……"}, {"type": "subtitle", "time": 18164.03, "timestamp": "05:02:44", "text": "表情艺术家创作了"}, {"type": "subtitle", "time": 18168.23, "timestamp": "05:02:48", "text": "嗯，等等。所以内森是表情包艺术家"}, {"type": "subtitle", "time": 18173.43, "timestamp": "05:02:53", "text": "谁制作了我的文档表情包，我哪个"}, {"type": "subtitle", "time": 18175.31, "timestamp": "05:02:55", "text": "等等，等等，等等，等等"}, {"type": "subtitle", "time": 18178.47, "timestamp": "05:02:58", "text": "向上。在哪里？"}]
[{"type": "subtitle", "time": 6127.91, "timestamp": "01:42:07", "text": "次数。好的。他现在势力强大。即将到来"}, {"type": "subtitle", "time": 6131.07, "timestamp": "01:42:11", "text": "后退。升级"}, {"type": "subtitle", "time": 6140.75, "timestamp": "01:42:20", "text": "我给你一个。"}, {"type": "subtitle", "time": 6143.709, "timestamp": "01:42:23", "text": "好的。我来喂你。不用担心。"}, {"type": "subtitle", "time": 6148.149, "timestamp": "01:42:28", "text": "不，我也想让这只小鸟……"}, {"type": "subtitle", "time": 6156.95, "timestamp": "01:42:36", "text": "等等，我可以用火的那个吗？我想要"}, {"type": "subtitle", "time": 6163.149, "timestamp": "01:42:43", "text": "它。"}, {"type": "subtitle", "time": 6171.27, "timestamp": "01:42:51", "text": "我知道它并非毫无价值。"}, {"type": "subtitle", "time": 6174.47, "timestamp": "01:42:54", "text": "值得升级"}, {"type": "subtitle", "time": 6177.39, "timestamp": "01:42:57", "text": "你的三颗星。这是一张卡片。"}, {"type": "subtitle", "time": 6179.79, "timestamp": "01:42:59", "text": "尽管。你"}]
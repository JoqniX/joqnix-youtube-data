[{"type": "subtitle", "time": 18421.23, "timestamp": "05:07:01", "text": "布丁。是的，我应该告诉她去做"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "哪天给我做布丁，或者教我怎么做"}, {"type": "subtitle", "time": 18427.83, "timestamp": "05:07:07", "text": "布丁。"}, {"type": "subtitle", "time": 18440.868, "timestamp": "05:07:20", "text": "他故意无视我的玩笑。等待，"}, {"type": "subtitle", "time": 18442.35, "timestamp": "05:07:22", "text": "什么"}, {"type": "subtitle", "time": 18446.37, "timestamp": "05:07:26", "text": "开玩笑？等等，你刚才在哪儿说的？"}, {"type": "subtitle", "time": 18447.788, "timestamp": "05:07:27", "text": "[音乐]"}, {"type": "subtitle", "time": 18452.35, "timestamp": "05:07:32", "text": "开玩笑？等等，邦加。"}, {"type": "subtitle", "time": 18454.35, "timestamp": "05:07:34", "text": "不，"}, {"type": "subtitle", "time": 18456.788, "timestamp": "05:07:36", "text": "等待。你也喜欢布丁。是的，我"}, {"type": "subtitle", "time": 18459.99, "timestamp": "05:07:39", "text": "爱布丁。哦，笨蛋，你忘了。我"}, {"type": "subtitle", "time": 18461.99, "timestamp": "05:07:41", "text": "听不懂笑话。我带走它们"}]
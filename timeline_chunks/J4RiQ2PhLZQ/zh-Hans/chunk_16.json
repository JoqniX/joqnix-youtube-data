[{"type": "subtitle", "time": 963.67, "timestamp": "00:16:03", "text": "我哥哥要来上班了，我们还有更多"}, {"type": "subtitle", "time": 966.4, "timestamp": "00:16:06", "text": "再次相遇的机会。"}, {"type": "subtitle", "time": 984.389, "timestamp": "00:16:24", "text": "这？什么？"}, {"type": "subtitle", "time": 988.47, "timestamp": "00:16:28", "text": "里面？将内部两个角都加粗。"}, {"type": "subtitle", "time": 995.269, "timestamp": "00:16:35", "text": "这。好的。快结束了。我是"}, {"type": "subtitle", "time": 998.629, "timestamp": "00:16:38", "text": "很高兴这一切快要结束了。不再"}, {"type": "subtitle", "time": 1006.25, "timestamp": "00:16:46", "text": "笑话总是受苦。"}, {"type": "subtitle", "time": 1007.99, "timestamp": "00:16:47", "text": "[音乐]"}, {"type": "subtitle", "time": 1010.55, "timestamp": "00:16:50", "text": "好的，我明白了。 H. 就是它。"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "简单的。哦，就这么简单。哦。哦，是的"}, {"type": "subtitle", "time": 1015.91, "timestamp": "00:16:55", "text": "变得炙手可热。好的。好的。好的。"}]
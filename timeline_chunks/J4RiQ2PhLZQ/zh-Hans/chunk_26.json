[{"type": "subtitle", "time": 1561.669, "timestamp": "00:26:01", "text": "在我手中的棚子里。我不知道它在哪里"}, {"type": "subtitle", "time": 1572.47, "timestamp": "00:26:12", "text": "真恶心。我该怎么做？哦，对了。哦，"}, {"type": "subtitle", "time": 1579.71, "timestamp": "00:26:19", "text": "好的。好的。好的。我是"}, {"type": "subtitle", "time": 1587.669, "timestamp": "00:26:27", "text": "好的。它看起来像一只蝴蝶。"}, {"type": "subtitle", "time": 1588.99, "timestamp": "00:26:28", "text": "我们开始吧"}, {"type": "subtitle", "time": 1593.43, "timestamp": "00:26:33", "text": "去。是一吗？是的。"}, {"type": "subtitle", "time": 1595.99, "timestamp": "00:26:35", "text": "看起来像着火了。"}, {"type": "subtitle", "time": 1597.71, "timestamp": "00:26:37", "text": "是吗？我不"}, {"type": "subtitle", "time": 1601.3, "timestamp": "00:26:41", "text": "知道。这个区域。"}, {"type": "subtitle", "time": 1603.909, "timestamp": "00:26:43", "text": "[音乐]"}, {"type": "subtitle", "time": 1607.63, "timestamp": "00:26:47", "text": "好的，我们做了这三个"}, {"type": "subtitle", "time": 1610.11, "timestamp": "00:26:50", "text": "东西。"}, {"type": "subtitle", "time": 1615.07, "timestamp": "00:26:55", "text": "好了，伙计们，我们成功了。在"}]
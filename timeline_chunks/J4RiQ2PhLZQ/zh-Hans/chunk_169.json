[{"type": "subtitle", "time": 10142.95, "timestamp": "02:49:02", "text": "能拥有超级银胡子真是太棒了"}, {"type": "subtitle", "time": 10145.83, "timestamp": "02:49:05", "text": "很难被打败，但很多人都能做到。"}, {"type": "subtitle", "time": 10148.87, "timestamp": "02:49:08", "text": "升级了，就像刷怪升级了一样，而且是"}, {"type": "subtitle", "time": 10152.309, "timestamp": "02:49:12", "text": "现在老板很简单。就像第一个boss一样。"}, {"type": "subtitle", "time": 10155.91, "timestamp": "02:49:15", "text": "我不知道为什么，但事情就是这样。"}, {"type": "subtitle", "time": 10161.19, "timestamp": "02:49:21", "text": "是的。嗯，所以，嗯，很可能"}, {"type": "subtitle", "time": 10164.469, "timestamp": "02:49:24", "text": "我们至少能从……得到两个"}, {"type": "subtitle", "time": 10167.99, "timestamp": "02:49:27", "text": "这。他们有20个频道。哦，1"}, {"type": "subtitle", "time": 10170.79, "timestamp": "02:49:30", "text": "分钟。现在沃尔康是个好对付的老板了。"}, {"type": "subtitle", "time": 10173.11, "timestamp": "02:49:33", "text": "目前确实无法击败，因为"}, {"type": "subtitle", "time": 10175.75, "timestamp": "02:49:35", "text": "现在大家的水平都很高了。这"}, {"type": "subtitle", "time": 10179.11, "timestamp": "02:49:39", "text": "所有角色的品格等级都很高。所以"}, {"type": "subtitle", "time": 10181.429, "timestamp": "02:49:41", "text": "为此，我们很可能会得到两个或"}, {"type": "subtitle", "time": 10185.87, "timestamp": "02:49:45", "text": "三，昨天我做到了"}, {"type": "subtitle", "time": 10188.91, "timestamp": "02:49:48", "text": "巨人。我能够为……做一件"}, {"type": "subtitle", "time": 10192.389, "timestamp": "02:49:52", "text": "所以我们会这么做。总之，我会"}, {"type": "subtitle", "time": 10196.59, "timestamp": "02:49:56", "text": "保持自动模式。进入我的"}, {"type": "subtitle", "time": 10199.91, "timestamp": "02:49:59", "text": "设置自动战斗距离。我会"}]
[{"type": "subtitle", "time": 8763.63, "timestamp": "02:26:03", "text": "我？苏萨比你先到。"}, {"type": "subtitle", "time": 8765.91, "timestamp": "02:26:05", "text": "做过。你想和谁说话？寻找"}, {"type": "subtitle", "time": 8767.19, "timestamp": "02:26:07", "text": "她。黑色的栅栏。将会指引你"}, {"type": "subtitle", "time": 8768.95, "timestamp": "02:26:08", "text": "欢迎来到巴士比赛，祝您一切顺利！"}, {"type": "subtitle", "time": 8770.67, "timestamp": "02:26:10", "text": "运气。"}, {"type": "subtitle", "time": 8789.27, "timestamp": "02:26:29", "text": "我不知道这个系统是如何运作的。"}, {"type": "subtitle", "time": 8792.23, "timestamp": "02:26:32", "text": "在这个游戏中，就像这种魅力增强器一样"}, {"type": "subtitle", "time": 8800.79, "timestamp": "02:26:40", "text": "哦，储物空间。我会放一些东西进去"}, {"type": "subtitle", "time": 8802.59, "timestamp": "02:26:42", "text": "贮存"}, {"type": "subtitle", "time": 8810.429, "timestamp": "02:26:50", "text": "嗯，这是66，这是"}, {"type": "subtitle", "time": 8813.51, "timestamp": "02:26:53", "text": "65. 我可以升级该物品。我不会"}]
[{"type": "subtitle", "time": 11280.79, "timestamp": "03:08:00", "text": "你需要的力量。你好。呃，我们完成了"}, {"type": "subtitle", "time": 11283.23, "timestamp": "03:08:03", "text": "那。等等，一个"}, {"type": "subtitle", "time": 11285.59, "timestamp": "03:08:05", "text": "更多地提及Z。你或许可以"}, {"type": "subtitle", "time": 11291.29, "timestamp": "03:08:11", "text": "药水。"}, {"type": "subtitle", "time": 11293.389, "timestamp": "03:08:13", "text": "[音乐]"}, {"type": "subtitle", "time": 11296.19, "timestamp": "03:08:16", "text": "嗯，你看"}, {"type": "subtitle", "time": 11300.03, "timestamp": "03:08:20", "text": "大约。哦，我们需要检查一下。"}, {"type": "subtitle", "time": 11314.23, "timestamp": "03:08:34", "text": "纳卡内看起来像个很有智慧的人，有很多东西。"}, {"type": "subtitle", "time": 11321.03, "timestamp": "03:08:41", "text": "它们被称为传奇宝石。哦，我们"}, {"type": "subtitle", "time": 11324.75, "timestamp": "03:08:44", "text": "现在可以开始使用宝石了。哇，长者"}, {"type": "subtitle", "time": 11326.95, "timestamp": "03:08:46", "text": "当……的时候，每当……的时候，就会出现裂痕。"}, {"type": "subtitle", "time": 11329.63, "timestamp": "03:08:49", "text": "长者之类的。我记得长老"}, {"type": "subtitle", "time": 11332.63, "timestamp": "03:08:52", "text": "铃声响起，我们还没有回去找长老。"}, {"type": "subtitle", "time": 11335.429, "timestamp": "03:08:55", "text": "过一会儿再响铃。所以，我会放一个流媒体"}, {"type": "subtitle", "time": 11338.55, "timestamp": "03:08:58", "text": "下周见。呃，我会戴上一枚上古戒指。"}]
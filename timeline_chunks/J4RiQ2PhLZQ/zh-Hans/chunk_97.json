[{"type": "subtitle", "time": 5821.669, "timestamp": "01:37:01", "text": "嗯，我不能带任何人，因为他们是"}, {"type": "subtitle", "time": 5825.43, "timestamp": "01:37:05", "text": "实力悬殊。我会免费刷新一次。哦，"}, {"type": "subtitle", "time": 5832.67, "timestamp": "01:37:12", "text": "我们停下来吧。"}, {"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "[掌声]"}, {"type": "subtitle", "time": 5838.229, "timestamp": "01:37:18", "text": "好吧，那我就不看了。我赢了。这是"}, {"type": "subtitle", "time": 5841.95, "timestamp": "01:37:21", "text": "伟大的。好的。"}, {"type": "subtitle", "time": 5844.87, "timestamp": "01:37:24", "text": "继续。我不能保证下次一定能赢"}, {"type": "subtitle", "time": 5847.07, "timestamp": "01:37:27", "text": "时间。所以，我会去"}, {"type": "subtitle", "time": 5850.95, "timestamp": "01:37:30", "text": "就是这个。他拥有四星级和"}, {"type": "subtitle", "time": 5852.03, "timestamp": "01:37:32", "text": "加"}, {"type": "subtitle", "time": 5854.51, "timestamp": "01:37:34", "text": "27 可能。哦，我的"}, {"type": "subtitle", "time": 5858.07, "timestamp": "01:37:38", "text": "上帝。我会赢吗？我不知道。我们开始吧"}, {"type": "subtitle", "time": 5859.99, "timestamp": "01:37:39", "text": "尝试。"}, {"type": "subtitle", "time": 5872.79, "timestamp": "01:37:52", "text": "武器。我想看这场比赛。啊，"}, {"type": "subtitle", "time": 5874.31, "timestamp": "01:37:54", "text": "他去世了。没关系。没关系。它是"}, {"type": "subtitle", "time": 5876.55, "timestamp": "01:37:56", "text": "美好的。你们一定能做到。你们可以"}]
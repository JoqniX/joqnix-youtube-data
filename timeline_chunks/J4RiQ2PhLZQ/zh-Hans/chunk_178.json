[{"type": "subtitle", "time": 10681.67, "timestamp": "02:58:01", "text": "几乎。回来。你好。你好。我是蒂娅。"}, {"type": "subtitle", "time": 10684.75, "timestamp": "02:58:04", "text": "让我们回到……"}, {"type": "subtitle", "time": 10687.269, "timestamp": "02:58:07", "text": "暗黑破坏神。我死了也没关系。这需要"}, {"type": "subtitle", "time": 10696.63, "timestamp": "02:58:16", "text": "暗黑破坏神。这座桥上的人。或许会有帮助"}, {"type": "subtitle", "time": 10702.87, "timestamp": "02:58:22", "text": "你好吗？一切都好。是的，我是"}, {"type": "subtitle", "time": 10705.11, "timestamp": "02:58:25", "text": "做好事。我想，就像要把我的眼睛摘下来一样。"}, {"type": "subtitle", "time": 10708.71, "timestamp": "02:58:28", "text": "药品。我滴了眼药水。"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "我之前滴了眼药水，呃……"}, {"type": "subtitle", "time": 10721.15, "timestamp": "02:58:41", "text": "我更像是在等待我的……新的"}, {"type": "subtitle", "time": 10723.99, "timestamp": "02:58:43", "text": "眼镜，呃，其实是新镜片，因为我的"}, {"type": "subtitle", "time": 10726.269, "timestamp": "02:58:46", "text": "功率增加"}, {"type": "subtitle", "time": 10729.67, "timestamp": "02:58:49", "text": "最近。糟糕，老板呃……"}, {"type": "subtitle", "time": 10737.63, "timestamp": "02:58:57", "text": "他。躲开，躲开，"}]
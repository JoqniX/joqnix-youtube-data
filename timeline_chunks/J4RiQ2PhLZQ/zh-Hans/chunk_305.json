[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "油炸圈饼。当我吃甜甜圈的时候"}, {"type": "subtitle", "time": 18302.708, "timestamp": "05:05:02", "text": "第一次的时候，我心想：“这是什么？”"}, {"type": "subtitle", "time": 18310.23, "timestamp": "05:05:10", "text": "好的。披萨也是一样。同样的情况"}, {"type": "subtitle", "time": 18313.35, "timestamp": "05:05:13", "text": "比萨。我以前从不吃披萨，但当我吃的时候"}, {"type": "subtitle", "time": 18315.31, "timestamp": "05:05:15", "text": "我当时就想，“这是什么魔法？”"}, {"type": "chat", "time": 18320.555, "timestamp": "05:05:20", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Today's Guest - RXR https://x.com/RockXRawr| https://www.twitch.tv/rxr404 | you can multiwatch this collab here - https://onxa.link/i6QyR4wu"}, {"type": "subtitle", "time": 18328.39, "timestamp": "05:05:28", "text": "而我从没吃过的东西之一就是……"}, {"type": "subtitle", "time": 18331.83, "timestamp": "05:05:31", "text": "呃，华夫饼之类的东西。"}, {"type": "subtitle", "time": 18334.35, "timestamp": "05:05:34", "text": "我只看到了那些。我只看到"}, {"type": "subtitle", "time": 18338.628, "timestamp": "05:05:38", "text": "在 YouTube 之类的平台上。我从来没吃过。"}, {"type": "subtitle", "time": 18341.15, "timestamp": "05:05:41", "text": "然后是华夫饼呢？"}, {"type": "subtitle", "time": 18344.39, "timestamp": "05:05:44", "text": "别的？我们先吃华夫饼，然后吃煎饼。全部"}, {"type": "subtitle", "time": 18345.23, "timestamp": "05:05:45", "text": "那"}, {"type": "subtitle", "time": 18348.03, "timestamp": "05:05:48", "text": "东西。那些是"}]
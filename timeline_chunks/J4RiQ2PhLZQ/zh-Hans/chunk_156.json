[{"type": "subtitle", "time": 9361.27, "timestamp": "02:36:01", "text": "他们说，呃，他们能够……"}, {"type": "subtitle", "time": 9364.389, "timestamp": "02:36:04", "text": "我怀疑新眼镜是否合适。"}, {"type": "subtitle", "time": 9367.309, "timestamp": "02:36:07", "text": "因为这种情况"}, {"type": "subtitle", "time": 9371.27, "timestamp": "02:36:11", "text": "我现在的眼镜是因为"}, {"type": "subtitle", "time": 9374.15, "timestamp": "02:36:14", "text": "它很薄，对吧？它很薄"}, {"type": "subtitle", "time": 9377.349, "timestamp": "02:36:17", "text": "金属玩意儿。所以，这有点像是"}, {"type": "subtitle", "time": 9381.349, "timestamp": "02:36:21", "text": "怀疑如果技术人员喜欢"}, {"type": "subtitle", "time": 9384.79, "timestamp": "02:36:24", "text": "把旧镜头取下来，然后就像……"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "装上新镜头，也许就是它了。"}, {"type": "subtitle", "time": 9392.07, "timestamp": "02:36:32", "text": "你管它叫什么？紧身，或者也许是"}, {"type": "subtitle", "time": 9394.469, "timestamp": "02:36:34", "text": "可能会把框架之类的东西弄坏。所以，我是"}, {"type": "subtitle", "time": 9397.91, "timestamp": "02:36:37", "text": "像担心一样。我希望我还能……"}, {"type": "subtitle", "time": 9401.91, "timestamp": "02:36:41", "text": "使用呃框架，或者如果我必须买一个"}, {"type": "subtitle", "time": 9406.71, "timestamp": "02:36:46", "text": "新的车架，这是一个更安全的选择。呃"}, {"type": "subtitle", "time": 9408.91, "timestamp": "02:36:48", "text": "我就像我想要的"}, {"type": "subtitle", "time": 9412.55, "timestamp": "02:36:52", "text": "圆润的圆润感很酷。我不想"}, {"type": "subtitle", "time": 9415.15, "timestamp": "02:36:55", "text": "回到原点。正方形是"}, {"type": "subtitle", "time": 9418.03, "timestamp": "02:36:58", "text": "疼痛。我想要我喜欢"}]
[{"type": "subtitle", "time": 11760.55, "timestamp": "03:16:00", "text": "能量很强，我想尽管它很强劲"}, {"type": "subtitle", "time": 11764.349, "timestamp": "03:16:04", "text": "无法逃离残骸"}, {"type": "subtitle", "time": 11766.75, "timestamp": "03:16:06", "text": "一片混乱。一对"}, {"type": "subtitle", "time": 11770.269, "timestamp": "03:16:10", "text": "菲奥娜真是太棒了"}, {"type": "subtitle", "time": 11773.83, "timestamp": "03:16:13", "text": "跟混沌宝石的柔软度完全没法比"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "宝石因混沌的影响而发生改变。"}, {"type": "subtitle", "time": 11777.99, "timestamp": "03:16:17", "text": "但您可以将其添加到文档中以获取更多信息。"}, {"type": "subtitle", "time": 11779.95, "timestamp": "03:16:19", "text": "力量。"}, {"type": "subtitle", "time": 11784.07, "timestamp": "03:16:24", "text": "哦，现在我们来学习宝石的使用方法。我"}, {"type": "subtitle", "time": 11787.71, "timestamp": "03:16:27", "text": "已经开始使用 gems 了"}, {"type": "subtitle", "time": 11790.99, "timestamp": "03:16:30", "text": "尽管。所以你只能使用它"}, {"type": "subtitle", "time": 11795.51, "timestamp": "03:16:35", "text": "像四星级武器那样进行压痕处理。"}, {"type": "subtitle", "time": 11811.349, "timestamp": "03:16:51", "text": "嗯，你可以把两颗宝石印到五颗宝石上。"}, {"type": "subtitle", "time": 11812.95, "timestamp": "03:16:52", "text": "星级装备和三颗宝石到六"}, {"type": "subtitle", "time": 11814.11, "timestamp": "03:16:54", "text": "星星"}]
[{"type": "subtitle", "time": 841.189, "timestamp": "00:14:01", "text": "导致它倒下的故障。得到它。得到它"}, {"type": "subtitle", "time": 842.829, "timestamp": "00:14:02", "text": "向下"}, {"type": "subtitle", "time": 846.069, "timestamp": "00:14:06", "text": "它。我觉得我们应该在你……之后结束。"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "完毕。我有点困了。上部"}, {"type": "subtitle", "time": 853.4, "timestamp": "00:14:13", "text": "角落向下。是的，我的也快完成了。"}, {"type": "subtitle", "time": 856.43, "timestamp": "00:14:16", "text": "[音乐]"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "耶！我会尽力去做"}, {"type": "subtitle", "time": 861.79, "timestamp": "00:14:21", "text": "心脏"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "弓。好的，我会试试。即使它不"}, {"type": "subtitle", "time": 875.35, "timestamp": "00:14:35", "text": "但这还挺酷的。喜欢"}, {"type": "subtitle", "time": 879.87, "timestamp": "00:14:39", "text": "纸艺。我从来不喜欢"}, {"type": "subtitle", "time": 883.59, "timestamp": "00:14:43", "text": "像这样全身心投入，但是"}, {"type": "subtitle", "time": 890.23, "timestamp": "00:14:50", "text": "所以，而且因为我买了素描本，所以也……"}, {"type": "subtitle", "time": 894.269, "timestamp": "00:14:54", "text": "垫子之类的东西，我真的应该做"}, {"type": "subtitle", "time": 898.59, "timestamp": "00:14:58", "text": "更像是这种垫片，我"}]
[{"type": "subtitle", "time": 301.83, "timestamp": "00:05:01", "text": "出去。从左侧向右侧折叠，"}, {"type": "subtitle", "time": 303.15, "timestamp": "00:05:03", "text": "权利"}, {"type": "subtitle", "time": 311.95, "timestamp": "00:05:11", "text": "我的指示应该得到报酬。"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "很好。咱们就随便聊聊吧"}, {"type": "subtitle", "time": 319.83, "timestamp": "00:05:19", "text": "现在。你好。是的，我们可以聊聊天。是的，"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "我放弃。对不起，乔。我就是做不到"}, {"type": "subtitle", "time": 325.029, "timestamp": "00:05:25", "text": "这样做。我的大脑一片空白，毫无忧虑。不"}, {"type": "subtitle", "time": 328.44, "timestamp": "00:05:28", "text": "担忧。不用担心。"}, {"type": "subtitle", "time": 330.909, "timestamp": "00:05:30", "text": "[音乐]"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "是的。你的折纸作品怎么样？"}, {"type": "subtitle", "time": 335.35, "timestamp": "00:05:35", "text": "经验？"}, {"type": "subtitle", "time": 343.11, "timestamp": "00:05:43", "text": "我头疼。我哭了。我"}, {"type": "subtitle", "time": 349.35, "timestamp": "00:05:49", "text": "哦，那是我们本来打算做的，对吧？"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "我们必须把它切断，用……"}]
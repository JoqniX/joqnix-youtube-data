[{"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "所以我就按这个来……嗯……这是什么？"}, {"type": "subtitle", "time": 7628.43, "timestamp": "02:07:08", "text": "这条路径。我相信这是"}, {"type": "subtitle", "time": 7632.95, "timestamp": "02:07:12", "text": "杀死生菜并回收"}, {"type": "subtitle", "time": 7636.149, "timestamp": "02:07:16", "text": "墙石碎片。是的，长门。所以，我们"}, {"type": "subtitle", "time": 7639.35, "timestamp": "02:07:19", "text": "会成为另一种流放的负担。那"}, {"type": "subtitle", "time": 7640.99, "timestamp": "02:07:20", "text": "是"}, {"type": "subtitle", "time": 7645.03, "timestamp": "02:07:25", "text": "好的。所以我们会这么做。是否有"}, {"type": "subtitle", "time": 7649.03, "timestamp": "02:07:29", "text": "在这游戏中步行？我不知道。"}, {"type": "subtitle", "time": 7651.87, "timestamp": "02:07:31", "text": "是的，没有自动"}, {"type": "subtitle", "time": 7655.51, "timestamp": "02:07:35", "text": "走。没有自动步行功能。那是"}]
[{"type": "subtitle", "time": 14646.189, "timestamp": "04:04:06", "text": "协助"}, {"type": "subtitle", "time": 14657.389, "timestamp": "04:04:17", "text": "你只有29到30分钟的时间"}, {"type": "subtitle", "time": 14659.91, "timestamp": "04:04:19", "text": "打。我的其他队友在哪里？"}, {"type": "subtitle", "time": 14663.189, "timestamp": "04:04:23", "text": "大家都到齐了。一、二、三、四"}, {"type": "subtitle", "time": 14666.79, "timestamp": "04:04:26", "text": "五。对，一共五个。是的。"}, {"type": "subtitle", "time": 14670.71, "timestamp": "04:04:30", "text": "好的。一，二。是的。只有四个。四"}, {"type": "subtitle", "time": 14685.469, "timestamp": "04:04:45", "text": "后退。他们都在做他们的"}, {"type": "subtitle", "time": 14688.469, "timestamp": "04:04:48", "text": "最好的。哦，有一个。哦，我是"}, {"type": "subtitle", "time": 14691.389, "timestamp": "04:04:51", "text": "该党最高层。我们开始吧"}, {"type": "subtitle", "time": 14694.389, "timestamp": "04:04:54", "text": "去。我是唯一一个比别人高的人"}, {"type": "subtitle", "time": 14697.83, "timestamp": "04:04:57", "text": "比所有人都高水平。他们中的大多数"}]
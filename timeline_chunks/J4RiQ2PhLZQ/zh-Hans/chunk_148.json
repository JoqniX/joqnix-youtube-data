[{"type": "subtitle", "time": 8890.11, "timestamp": "02:28:10", "text": "而这又是什么呢？"}, {"type": "subtitle", "time": 8893.27, "timestamp": "02:28:13", "text": "这？军械库。你可以有不同的"}, {"type": "subtitle", "time": 8895.469, "timestamp": "02:28:15", "text": "装载。"}, {"type": "subtitle", "time": 8903.51, "timestamp": "02:28:23", "text": "有趣的。哇。我什么都没有"}, {"type": "subtitle", "time": 8916.429, "timestamp": "02:28:36", "text": "哦，所以"}, {"type": "subtitle", "time": 8920.03, "timestamp": "02:28:40", "text": "宝石。我没有"}, {"type": "subtitle", "time": 8923.309, "timestamp": "02:28:43", "text": "宝石。看到宝石让我想起了我"}, {"type": "subtitle", "time": 8926.23, "timestamp": "02:28:46", "text": "新大陆。我还没玩过《新世界》。"}, {"type": "subtitle", "time": 8927.71, "timestamp": "02:28:47", "text": "就像"}, {"type": "subtitle", "time": 8934.469, "timestamp": "02:28:54", "text": "忘了。结束了。"}, {"type": "subtitle", "time": 8937.429, "timestamp": "02:28:57", "text": "我把这件事忘了。让我躲开。为什么"}]
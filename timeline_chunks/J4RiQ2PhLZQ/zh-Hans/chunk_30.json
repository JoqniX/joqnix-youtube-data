[{"type": "subtitle", "time": 1804.07, "timestamp": "00:30:04", "text": "是的。订阅铃木频道。我将要做"}, {"type": "subtitle", "time": 1807.75, "timestamp": "00:30:07", "text": "本周有很多关于CRT的字符串。是的。"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "订阅。"}, {"type": "subtitle", "time": 1812.31, "timestamp": "00:30:12", "text": "我的天哪，这个纸手镯看起来好漂亮"}, {"type": "subtitle", "time": 1816.789, "timestamp": "00:30:16", "text": "美丽的。哪个？"}, {"type": "subtitle", "time": 1819.99, "timestamp": "00:30:19", "text": "哦，是这个。"}, {"type": "subtitle", "time": 1823.789, "timestamp": "00:30:23", "text": "是的。哦，是的。"}, {"type": "subtitle", "time": 1825.63, "timestamp": "00:30:25", "text": "蝴蝶。它"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "是个好主意。谢谢你送的蝴蝶"}, {"type": "subtitle", "time": 1832.389, "timestamp": "00:30:32", "text": "东西。各位晚安。小心。"}, {"type": "subtitle", "time": 1842.95, "timestamp": "00:30:42", "text": "哦，等等。我该让我自己展示吗？"}, {"type": "subtitle", "time": 1846.149, "timestamp": "00:30:46", "text": "直播中？不，你可以看看"}, {"type": "subtitle", "time": 1848.389, "timestamp": "00:30:48", "text": "它。太恶心了。我不知道该怎么做"}, {"type": "subtitle", "time": 1850.47, "timestamp": "00:30:50", "text": "它来了。"}, {"type": "subtitle", "time": 1852.87, "timestamp": "00:30:52", "text": "没关系。"}, {"type": "subtitle", "time": 1855.149, "timestamp": "00:30:55", "text": "再见。"}]
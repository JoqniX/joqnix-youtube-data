[{"type": "subtitle", "time": 8280.669, "timestamp": "02:18:00", "text": "C. 这两个人将变成三个人"}, {"type": "subtitle", "time": 8284.03, "timestamp": "02:18:04", "text": "四、三和"}, {"type": "subtitle", "time": 8286.549, "timestamp": "02:18:06", "text": "四、我可以用我的另一个鼠标，"}, {"type": "subtitle", "time": 8289.429, "timestamp": "02:18:09", "text": "这是一只母老鼠。我本来不必这么做。"}, {"type": "subtitle", "time": 8292.22, "timestamp": "02:18:12", "text": "这是我的主鼠标。"}, {"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "[音乐]"}, {"type": "subtitle", "time": 8310.75, "timestamp": "02:18:30", "text": "这。哦，完成了。改为"}, {"type": "subtitle", "time": 8312.83, "timestamp": "02:18:32", "text": "这。关闭"}, {"type": "subtitle", "time": 8316.95, "timestamp": "02:18:36", "text": "这。返回此处。我们走吧。"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "所以 Q 部分，也就是我的这个，是为了"}, {"type": "subtitle", "time": 8323.23, "timestamp": "02:18:43", "text": "攻击"}, {"type": "subtitle", "time": 8325.95, "timestamp": "02:18:45", "text": "这是地图，这是我的"}, {"type": "subtitle", "time": 8329.07, "timestamp": "02:18:49", "text": "库存，我将配备"}, {"type": "subtitle", "time": 8333.75, "timestamp": "02:18:53", "text": "但是，我现在感觉自己如此强大。"}]
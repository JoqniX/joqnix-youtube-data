[{"type": "subtitle", "time": 2343.03, "timestamp": "00:39:03", "text": "你好。你好。那么，我就简单总结一下吧。"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "这里。所以，谢谢大家，还有我"}, {"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "真的很想向那些人道歉。"}, {"type": "subtitle", "time": 2352.069, "timestamp": "00:39:12", "text": "今天和我聊天的人，我都没聊。"}, {"type": "subtitle", "time": 2354.069, "timestamp": "00:39:14", "text": "我看了你的聊天记录，但我确实注意到了。"}, {"type": "subtitle", "time": 2357.349, "timestamp": "00:39:17", "text": "尽管。谢谢你今天抽出时间。那是"}, {"type": "subtitle", "time": 2365.19, "timestamp": "00:39:25", "text": "乐趣。是的。我，我能感觉到自己"}, {"type": "subtitle", "time": 2366.19, "timestamp": "00:39:26", "text": "获得"}, {"type": "subtitle", "time": 2369.27, "timestamp": "00:39:29", "text": "脱水。我需要喝水。做"}, {"type": "subtitle", "time": 2371.829, "timestamp": "00:39:31", "text": "你知道这是我的水壶吗？太过了"}, {"type": "subtitle", "time": 2373.39, "timestamp": "00:39:33", "text": "大的，"}, {"type": "subtitle", "time": 2374.91, "timestamp": "00:39:34", "text": "正确的？"}, {"type": "subtitle", "time": 2376.91, "timestamp": "00:39:36", "text": "也是如此。"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "你好。好的。所以，我需要清理一下。"}, {"type": "subtitle", "time": 2393.63, "timestamp": "00:39:53", "text": "东西。我们尽力了。"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "今天。嘿，我们会在……见面的"}, {"type": "subtitle", "time": 2397.79, "timestamp": "00:39:57", "text": "下一个。"}]
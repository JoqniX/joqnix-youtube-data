[{"type": "subtitle", "time": 2400.75, "timestamp": "00:40:00", "text": "好的。晚安，祝你一切顺利"}, {"type": "subtitle", "time": 2404.31, "timestamp": "00:40:04", "text": "一。再见。我该怎么做？"}, {"type": "subtitle", "time": 2409.79, "timestamp": "00:40:09", "text": "不。"}, {"type": "subtitle", "time": 2414.0, "timestamp": "00:40:14", "text": "再见。等等，我该怎么做？"}, {"type": "subtitle", "time": 2425.87, "timestamp": "00:40:25", "text": "天。再见。好的"}, {"type": "subtitle", "time": 2428.95, "timestamp": "00:40:28", "text": "晚安，感谢大家今天的陪伴。你"}, {"type": "subtitle", "time": 2430.87, "timestamp": "00:40:30", "text": "我知道，每次我结束直播的时候，我都会这样做。"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "这种挥舞它们的动作"}, {"type": "subtitle", "time": 2436.31, "timestamp": "00:40:36", "text": "呃，不知为何，就好像我在挥手一样"}]
[{"type": "subtitle", "time": 4080.91, "timestamp": "01:08:00", "text": "一，"}, {"type": "subtitle", "time": 4087.67, "timestamp": "01:08:07", "text": "三。一。哦，是的，女士。我发送了"}, {"type": "subtitle", "time": 4090.829, "timestamp": "01:08:10", "text": "派对邀请函和王国"}, {"type": "subtitle", "time": 4095.99, "timestamp": "01:08:15", "text": "恰塔尼。呃呃，这是农场场景"}, {"type": "subtitle", "time": 4097.139, "timestamp": "01:08:17", "text": "你熟悉的"}, {"type": "subtitle", "time": 4104.309, "timestamp": "01:08:24", "text": "森林。你之后就会明白这一点了"}, {"type": "subtitle", "time": 4105.87, "timestamp": "01:08:25", "text": "讲这个故事"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "寻求。你必须发展你的农场"}, {"type": "subtitle", "time": 4109.07, "timestamp": "01:08:29", "text": "和"}, {"type": "subtitle", "time": 4111.55, "timestamp": "01:08:31", "text": "东西。我想应该是这样。我会"}, {"type": "subtitle", "time": 4114.63, "timestamp": "01:08:34", "text": "思考。我们慢慢地……"}, {"type": "subtitle", "time": 4121.269, "timestamp": "01:08:41", "text": "是的。我会拿走这个，然后我就……"}, {"type": "subtitle", "time": 4123.63, "timestamp": "01:08:43", "text": "帮我整理一下东西。"}]
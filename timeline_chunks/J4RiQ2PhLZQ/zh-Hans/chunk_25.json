[{"type": "subtitle", "time": 1503.19, "timestamp": "00:25:03", "text": "不，等等。我做了。不，我不这么认为。"}, {"type": "subtitle", "time": 1504.35, "timestamp": "00:25:04", "text": "怎么可能"}, {"type": "subtitle", "time": 1507.99, "timestamp": "00:25:07", "text": "我？等等，我……我不记得了。"}, {"type": "subtitle", "time": 1515.99, "timestamp": "00:25:15", "text": "完毕。我不这么认为。等等，我是吗？"}, {"type": "subtitle", "time": 1518.39, "timestamp": "00:25:18", "text": "不，我不这么认为。"}, {"type": "subtitle", "time": 1521.51, "timestamp": "00:25:21", "text": "以前你经常去溪边散步。"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "哦不，我不记得了。我当时就……"}, {"type": "subtitle", "time": 1528.51, "timestamp": "00:25:28", "text": "是啊，你让我想起了……"}, {"type": "subtitle", "time": 1536.11, "timestamp": "00:25:36", "text": "我知道我想"}, {"type": "subtitle", "time": 1541.51, "timestamp": "00:25:41", "text": "就像，嗯，是的，在见到你之后，我"}, {"type": "subtitle", "time": 1543.99, "timestamp": "00:25:43", "text": "了解到关于睡眠醉酒的事情"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "东西。我不知道那是什么。我"}, {"type": "subtitle", "time": 1549.909, "timestamp": "00:25:49", "text": "我觉得我把袖子上的那个图案弄出来了"}, {"type": "subtitle", "time": 1558.549, "timestamp": "00:25:58", "text": "我当时大概是又累又醉了吧。我的天啊，快看"}]
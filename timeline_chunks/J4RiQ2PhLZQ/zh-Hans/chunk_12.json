[{"type": "subtitle", "time": 724.79, "timestamp": "00:12:04", "text": "是的。所以我认为我们得到了一些呃"}, {"type": "subtitle", "time": 729.43, "timestamp": "00:12:09", "text": "像……这样的人，就像……那些人"}, {"type": "subtitle", "time": 732.629, "timestamp": "00:12:12", "text": "是租用办公室还是其他什么地方。所以"}, {"type": "subtitle", "time": 735.03, "timestamp": "00:12:15", "text": "我当时很怀疑，因为我"}, {"type": "subtitle", "time": 736.949, "timestamp": "00:12:16", "text": "现在流媒体等等可能就是这样了"}, {"type": "subtitle", "time": 739.11, "timestamp": "00:12:19", "text": "如果他们要待在那里，对他们来说就太多了。"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "晚上或者工作的时候。"}, {"type": "subtitle", "time": 744.389, "timestamp": "00:12:24", "text": "幸好他们最终没有达成一致，所以我"}, {"type": "subtitle", "time": 746.99, "timestamp": "00:12:26", "text": "依然拥有我的平静"}, {"type": "subtitle", "time": 750.31, "timestamp": "00:12:30", "text": "因为恐怖直播现在让我尖叫，"}, {"type": "subtitle", "time": 751.79, "timestamp": "00:12:31", "text": "哭得像"}, {"type": "subtitle", "time": 755.79, "timestamp": "00:12:35", "text": "濒临死亡的人"}, {"type": "subtitle", "time": 757.71, "timestamp": "00:12:37", "text": "某物。所以我是"}, {"type": "subtitle", "time": 760.71, "timestamp": "00:12:40", "text": "比如疼痛。"}, {"type": "subtitle", "time": 763.75, "timestamp": "00:12:43", "text": "你们看到我的机甲和琪亚拉了吗？"}, {"type": "subtitle", "time": 765.35, "timestamp": "00:12:45", "text": "学习？"}, {"type": "subtitle", "time": 768.31, "timestamp": "00:12:48", "text": "它太可爱了。"}, {"type": "subtitle", "time": 774.15, "timestamp": "00:12:54", "text": "[音乐]"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "我在美国见过你，sama cosplayer，"}]
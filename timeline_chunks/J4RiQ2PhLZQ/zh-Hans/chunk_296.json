[{"type": "subtitle", "time": 17762.11, "timestamp": "04:56:02", "text": "再次？这些叫什么？"}, {"type": "subtitle", "time": 17764.55, "timestamp": "04:56:04", "text": "鹰嘴豆。是的，鹰嘴豆之类的"}, {"type": "subtitle", "time": 17767.59, "timestamp": "04:56:07", "text": "鱼。炸鱼。其实，我忘了"}, {"type": "subtitle", "time": 17769.07, "timestamp": "04:56:09", "text": "什么鱼"}, {"type": "subtitle", "time": 17779.628, "timestamp": "04:56:19", "text": "还有一些……这是什么蔬菜"}, {"type": "subtitle", "time": 17782.788, "timestamp": "04:56:22", "text": "那玩意儿？嗯，这是什么蔬菜？"}, {"type": "subtitle", "time": 17785.83, "timestamp": "04:56:25", "text": "那玩意儿？我忘了。那是一种蔬菜。"}, {"type": "subtitle", "time": 17787.23, "timestamp": "04:56:27", "text": "是的。"}, {"type": "subtitle", "time": 17791.52, "timestamp": "04:56:31", "text": "夜晚。"}, {"type": "subtitle", "time": 17801.87, "timestamp": "04:56:41", "text": "是的。可怜的爸爸。多么可爱的名字啊。"}, {"type": "subtitle", "time": 17811.868, "timestamp": "04:56:51", "text": "[音乐]"}, {"type": "subtitle", "time": 17815.91, "timestamp": "04:56:55", "text": "猜测。你在吃什么？嗯？"}]
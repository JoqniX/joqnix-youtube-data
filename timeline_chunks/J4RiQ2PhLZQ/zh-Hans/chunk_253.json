[{"type": "subtitle", "time": 15194.51, "timestamp": "04:13:14", "text": "损害。"}, {"type": "subtitle", "time": 15217.51, "timestamp": "04:13:37", "text": "愈合。我不知道是谁在做这件事"}, {"type": "subtitle", "time": 15219.99, "timestamp": "04:13:39", "text": "虽然还在疗伤，但我很感激。感谢"}, {"type": "subtitle", "time": 15223.11, "timestamp": "04:13:43", "text": "非常感谢。等等，我想"}, {"type": "subtitle", "time": 15226.309, "timestamp": "04:13:46", "text": "弓箭手做不到，我以为罗做不到"}, {"type": "subtitle", "time": 15228.91, "timestamp": "04:13:48", "text": "治愈，但显然有人正在这样做"}, {"type": "subtitle", "time": 15231.309, "timestamp": "04:13:51", "text": "它。我想知道"}, {"type": "subtitle", "time": 15233.309, "timestamp": "04:13:53", "text": "WHO"}, {"type": "subtitle", "time": 15237.389, "timestamp": "04:13:57", "text": "我不痛。我死了"}]
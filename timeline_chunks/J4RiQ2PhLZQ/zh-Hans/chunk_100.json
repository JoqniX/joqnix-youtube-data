[{"type": "subtitle", "time": 6002.189, "timestamp": "01:40:02", "text": "从杂货店买的。我需要攻击"}, {"type": "subtitle", "time": 6005.27, "timestamp": "01:40:05", "text": "果冻。谢谢。你知道吗？自从"}, {"type": "subtitle", "time": 6007.57, "timestamp": "01:40:07", "text": "我来了，我要把所有东西都买下来。"}, {"type": "subtitle", "time": 6009.149, "timestamp": "01:40:09", "text": "[音乐]"}, {"type": "subtitle", "time": 6012.75, "timestamp": "01:40:12", "text": "这。我会买这个。"}, {"type": "subtitle", "time": 6016.43, "timestamp": "01:40:16", "text": "也。你知道吗？我会买"}, {"type": "subtitle", "time": 6020.55, "timestamp": "01:40:20", "text": "这。我不在乎。我想达到水平"}, {"type": "subtitle", "time": 6021.39, "timestamp": "01:40:21", "text": "他"}, {"type": "subtitle", "time": 6025.43, "timestamp": "01:40:25", "text": "向上。我得提升他的等级。"}, {"type": "subtitle", "time": 6032.55, "timestamp": "01:40:32", "text": "将。呃，就是这个。哦，我有九个。"}, {"type": "subtitle", "time": 6036.95, "timestamp": "01:40:36", "text": "他们中的。哦，这是个随机的答案。哦，我们"}, {"type": "subtitle", "time": 6039.109, "timestamp": "01:40:39", "text": "获得一次攻击，进化了很多次"}, {"type": "subtitle", "time": 6042.87, "timestamp": "01:40:42", "text": "水果、三星灯和火。"}, {"type": "subtitle", "time": 6044.51, "timestamp": "01:40:44", "text": "哦，"}, {"type": "subtitle", "time": 6047.75, "timestamp": "01:40:47", "text": "好的。现在，为此，我将选择这个"}, {"type": "subtitle", "time": 6049.669, "timestamp": "01:40:49", "text": "一。"}, {"type": "subtitle", "time": 6052.79, "timestamp": "01:40:52", "text": "等等，如果我继续提升我的奥贝罗斯的等级，"}, {"type": "subtitle", "time": 6055.59, "timestamp": "01:40:55", "text": "另一个呢？我需要黑暗"}, {"type": "subtitle", "time": 6057.629, "timestamp": "01:40:57", "text": "还有一个。我接受"}]
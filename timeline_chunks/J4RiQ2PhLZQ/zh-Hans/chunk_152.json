[{"type": "subtitle", "time": 9121.19, "timestamp": "02:32:01", "text": "他有点精神错乱，然后我们就继续前进了。"}, {"type": "subtitle", "time": 9124.309, "timestamp": "02:32:04", "text": "修复显而易见的问题等等"}, {"type": "subtitle", "time": 9125.63, "timestamp": "02:32:05", "text": "为了"}, {"type": "subtitle", "time": 9134.389, "timestamp": "02:32:14", "text": "它。是的。我很有可能会上传它。"}, {"type": "subtitle", "time": 9137.429, "timestamp": "02:32:17", "text": "嗯，在直播结束后。我知道我"}, {"type": "subtitle", "time": 9139.59, "timestamp": "02:32:19", "text": "我确实说过我会这么做。"}, {"type": "subtitle", "time": 9142.83, "timestamp": "02:32:22", "text": "昨天早上，但我"}, {"type": "subtitle", "time": 9153.51, "timestamp": "02:32:33", "text": "再次。哦，我升级了。我听到的是……"}, {"type": "subtitle", "time": 9154.51, "timestamp": "02:32:34", "text": "一个级别"}, {"type": "subtitle", "time": 9163.99, "timestamp": "02:32:43", "text": "你知道吗，这种感觉真好。关上你的"}, {"type": "subtitle", "time": 9170.99, "timestamp": "02:32:50", "text": "听着，听着你的"}, {"type": "subtitle", "time": 9174.15, "timestamp": "02:32:54", "text": "周围环境。发生了什么事，粉丝们？"}, {"type": "subtitle", "time": 9178.15, "timestamp": "02:32:58", "text": "周围环境的噪音和耳机"}]
[{"type": "subtitle", "time": 16260.91, "timestamp": "04:31:00", "text": "向上。"}, {"type": "subtitle", "time": 16268.95, "timestamp": "04:31:08", "text": "鸭子。如何调整相机？"}, {"type": "subtitle", "time": 16271.309, "timestamp": "04:31:11", "text": "[音乐]"}, {"type": "subtitle", "time": 16295.79, "timestamp": "04:31:35", "text": "块。"}, {"type": "subtitle", "time": 16298.67, "timestamp": "04:31:38", "text": "等待。嘎嘎。"}, {"type": "subtitle", "time": 16300.91, "timestamp": "04:31:40", "text": "嘎嘎。嘎嘎。"}, {"type": "subtitle", "time": 16305.269, "timestamp": "04:31:45", "text": "嘎嘎。又是小鸭子。"}, {"type": "subtitle", "time": 16308.229, "timestamp": "04:31:48", "text": "上传墙体和安全图片。是的，"}, {"type": "subtitle", "time": 16310.87, "timestamp": "04:31:50", "text": "我会把它上传到推特。"}, {"type": "subtitle", "time": 16312.59, "timestamp": "04:31:52", "text": "在我们结束之后"}, {"type": "subtitle", "time": 16315.149, "timestamp": "04:31:55", "text": "溪流。"}, {"type": "subtitle", "time": 16318.95, "timestamp": "04:31:58", "text": "小鸭子。哦，等等。再来一发。他跑了"}]
[{"type": "subtitle", "time": 16382.03, "timestamp": "04:33:02", "text": "甘达。你好。呃，我们当时在哪儿？"}, {"type": "subtitle", "time": 16388.349, "timestamp": "04:33:08", "text": "摊位。"}, {"type": "subtitle", "time": 16389.72, "timestamp": "04:33:09", "text": "索娜。"}, {"type": "subtitle", "time": 16393.07, "timestamp": "04:33:13", "text": "[音乐]"}, {"type": "subtitle", "time": 16396.429, "timestamp": "04:33:16", "text": "是的。月亮和星星是什么？"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "呃，这些是什么？我不知道。这些"}, {"type": "subtitle", "time": 16419.59, "timestamp": "04:33:39", "text": "[音乐]"}, {"type": "subtitle", "time": 16421.789, "timestamp": "04:33:41", "text": "哦，你不能。什么是"}, {"type": "subtitle", "time": 16425.869, "timestamp": "04:33:45", "text": "这？什么？如果我放一些会发生什么？"}, {"type": "subtitle", "time": 16436.99, "timestamp": "04:33:56", "text": "出售"}]
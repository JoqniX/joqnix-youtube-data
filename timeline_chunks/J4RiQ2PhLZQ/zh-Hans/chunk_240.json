[{"type": "subtitle", "time": 14402.309, "timestamp": "04:00:02", "text": "小时。 1 2 3 4 5。哦，到星期一为止。我得到了"}, {"type": "subtitle", "time": 14404.389, "timestamp": "04:00:04", "text": "直到时间到来。直到周一。好的。"}, {"type": "subtitle", "time": 14417.269, "timestamp": "04:00:17", "text": "哦，我们也拿到召唤券了。不是"}, {"type": "subtitle", "time": 14419.55, "timestamp": "04:00:19", "text": "召唤但需要装备券。两个"}, {"type": "subtitle", "time": 14427.229, "timestamp": "04:00:27", "text": "那。我们能得到什么？光"}, {"type": "subtitle", "time": 14429.75, "timestamp": "04:00:29", "text": "弓。两星。我知道。我想"}, {"type": "subtitle", "time": 14432.91, "timestamp": "04:00:32", "text": "四星级"}, {"type": "subtitle", "time": 14435.63, "timestamp": "04:00:35", "text": "绿色三星。"}, {"type": "subtitle", "time": 14439.309, "timestamp": "04:00:39", "text": "坏的。我已经有了。我有一个四"}, {"type": "subtitle", "time": 14441.99, "timestamp": "04:00:41", "text": "星星。所以，是的，我会喂饱我的第四颗星星。"}, {"type": "subtitle", "time": 14443.87, "timestamp": "04:00:43", "text": "我刚给的三星"}, {"type": "subtitle", "time": 14452.83, "timestamp": "04:00:52", "text": "笨蛋。还有那盏灯。我得了2分"}, {"type": "subtitle", "time": 14455.309, "timestamp": "04:00:55", "text": "盯着你看，等着吃"}, {"type": "subtitle", "time": 14457.79, "timestamp": "04:00:57", "text": "向上。"}]
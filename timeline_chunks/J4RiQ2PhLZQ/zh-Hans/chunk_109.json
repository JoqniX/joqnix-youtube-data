[{"type": "subtitle", "time": 6570.31, "timestamp": "01:49:30", "text": "我回来了。查德，过来。过来。"}, {"type": "subtitle", "time": 6572.43, "timestamp": "01:49:32", "text": "过来。过来。过来。来"}, {"type": "subtitle", "time": 6580.709, "timestamp": "01:49:40", "text": "[音乐]"}, {"type": "subtitle", "time": 6583.27, "timestamp": "01:49:43", "text": "我回来了。我回来了。我回来了。我回来了。"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "进来吧。希望你……我希望我没等你。"}, {"type": "subtitle", "time": 6587.08, "timestamp": "01:49:47", "text": "让你们"}, {"type": "subtitle", "time": 6588.75, "timestamp": "01:49:48", "text": "[音乐]"}, {"type": "subtitle", "time": 6592.55, "timestamp": "01:49:52", "text": "等待。所以，呃，最后还有一件事是……"}, {"type": "subtitle", "time": 6594.51, "timestamp": "01:49:54", "text": "到"}, {"type": "subtitle", "time": 6598.43, "timestamp": "01:49:58", "text": "冒险吧"}]
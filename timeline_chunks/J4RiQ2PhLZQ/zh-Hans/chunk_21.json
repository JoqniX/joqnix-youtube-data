[{"type": "subtitle", "time": 1265.23, "timestamp": "00:21:05", "text": "庆典。给我们办个派对，好好招待我们。"}, {"type": "subtitle", "time": 1267.4, "timestamp": "00:21:07", "text": "我们。 恭喜。它是"}, {"type": "subtitle", "time": 1269.88, "timestamp": "00:21:09", "text": "恭喜。它是 庆祝活动。"}, {"type": "subtitle", "time": 1271.46, "timestamp": "00:21:11", "text": "庆祝活动。 [音乐]"}, {"type": "subtitle", "time": 1272.76, "timestamp": "00:21:12", "text": "[音乐] 欺骗，然后睡觉。好的。"}, {"type": "subtitle", "time": 1283.75, "timestamp": "00:21:23", "text": "好了，各位。我们完成了。耶。"}, {"type": "subtitle", "time": 1286.87, "timestamp": "00:21:26", "text": "我不知道它是否漂亮。"}, {"type": "subtitle", "time": 1288.83, "timestamp": "00:21:28", "text": "但"}, {"type": "subtitle", "time": 1291.75, "timestamp": "00:21:31", "text": "是的。我来试试。我的双手并非"}, {"type": "subtitle", "time": 1295.669, "timestamp": "00:21:35", "text": "漂亮的。我知道，查德。"}, {"type": "subtitle", "time": 1299.5, "timestamp": "00:21:39", "text": "嘿，等等，等等，等等。"}, {"type": "subtitle", "time": 1302.63, "timestamp": "00:21:42", "text": "[音乐]"}, {"type": "subtitle", "time": 1307.35, "timestamp": "00:21:47", "text": "乔做得很好。为什么这个洞不是"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "我们应该把所有东西都拍下来。"}, {"type": "subtitle", "time": 1318.07, "timestamp": "00:21:58", "text": "我们制作的折纸。那只是我的"}]
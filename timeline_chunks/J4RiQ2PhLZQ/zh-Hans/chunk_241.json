[{"type": "subtitle", "time": 14462.75, "timestamp": "04:01:02", "text": "亚什。而且我可以增强"}, {"type": "subtitle", "time": 14466.59, "timestamp": "04:01:06", "text": "这。我失败了。我失败了"}, {"type": "subtitle", "time": 14469.349, "timestamp": "04:01:09", "text": "再次。哦，成功了。"}, {"type": "subtitle", "time": 14471.75, "timestamp": "04:01:11", "text": "我们再做一次。失败的。一次"}, {"type": "subtitle", "time": 14472.91, "timestamp": "04:01:12", "text": "更多的。"}, {"type": "subtitle", "time": 14475.229, "timestamp": "04:01:15", "text": "失败的。我的"}, {"type": "subtitle", "time": 14481.87, "timestamp": "04:01:21", "text": "运气。我运气真差。我，我们可以，我们会做到"}, {"type": "subtitle", "time": 14487.71, "timestamp": "04:01:27", "text": "坏人。为什么我的运气这么差？"}, {"type": "subtitle", "time": 14492.15, "timestamp": "04:01:32", "text": "哦，什么？这是四连胜了。五"}, {"type": "subtitle", "time": 14493.389, "timestamp": "04:01:33", "text": "排。"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "你好。什么？"}, {"type": "subtitle", "time": 14499.32, "timestamp": "04:01:39", "text": "我运气真差。"}, {"type": "subtitle", "time": 14507.99, "timestamp": "04:01:47", "text": "为什么？我不会那样做，因为我会……"}, {"type": "subtitle", "time": 14511.83, "timestamp": "04:01:51", "text": "期待我的第一本四星级水书。"}, {"type": "subtitle", "time": 14513.229, "timestamp": "04:01:53", "text": "哦"}, {"type": "subtitle", "time": 14517.03, "timestamp": "04:01:57", "text": "我的。是啊，我运气真差。所以，随着"}, {"type": "subtitle", "time": 14519.59, "timestamp": "04:01:59", "text": "有了这些三叶草，我们就能达到平衡。"}]
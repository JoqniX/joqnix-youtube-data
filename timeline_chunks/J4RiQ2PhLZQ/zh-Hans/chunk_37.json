[{"type": "subtitle", "time": 2222.47, "timestamp": "00:37:02", "text": "嗯，同样的事情也可以应用到"}, {"type": "subtitle", "time": 2226.43, "timestamp": "00:37:06", "text": "你做的事，但不要太……"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "消极的。记住，一定要看向……"}, {"type": "subtitle", "time": 2232.27, "timestamp": "00:37:12", "text": "你做的都是好事"}, {"type": "subtitle", "time": 2233.79, "timestamp": "00:37:13", "text": "出色地。"}, {"type": "subtitle", "time": 2237.99, "timestamp": "00:37:17", "text": "是的。所以，呃，这就是我里面的内容。"}, {"type": "subtitle", "time": 2241.47, "timestamp": "00:37:21", "text": "还记得你让我评价我的作品吗？"}, {"type": "subtitle", "time": 2243.15, "timestamp": "00:37:23", "text": "东西。"}, {"type": "subtitle", "time": 2245.91, "timestamp": "00:37:25", "text": "是的。我给它打七分。我需要"}, {"type": "subtitle", "time": 2248.71, "timestamp": "00:37:28", "text": "画更多。所以，你知道该怎么做了。"}, {"type": "subtitle", "time": 2251.349, "timestamp": "00:37:31", "text": "你需要练习，必须坚持画画。"}, {"type": "subtitle", "time": 2253.91, "timestamp": "00:37:33", "text": "画画，画画，然后得到"}, {"type": "subtitle", "time": 2256.55, "timestamp": "00:37:36", "text": "更擅长解剖学方面的东西。染色，"}, {"type": "subtitle", "time": 2258.87, "timestamp": "00:37:38", "text": "阴影、光线，太多了。"}, {"type": "subtitle", "time": 2261.55, "timestamp": "00:37:41", "text": "事情就是这样，对吧？说到"}, {"type": "subtitle", "time": 2266.51, "timestamp": "00:37:46", "text": "艺术。所以，是的，慢慢来。"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "慢慢地。嗯。请随意"}, {"type": "subtitle", "time": 2274.71, "timestamp": "00:37:54", "text": "发布你正在画的任何东西"}, {"type": "subtitle", "time": 2277.99, "timestamp": "00:37:57", "text": "做些事情。别难过。啊，是"}, {"type": "subtitle", "time": 2279.63, "timestamp": "00:37:59", "text": "不完美或"}]
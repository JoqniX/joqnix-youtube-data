[{"type": "subtitle", "time": 2162.79, "timestamp": "00:36:02", "text": "音乐。所以，呃，我说这就像……嗯……为了"}, {"type": "subtitle", "time": 2165.51, "timestamp": "00:36:05", "text": "我自己也是，如果我……我会怎么做"}, {"type": "subtitle", "time": 2168.31, "timestamp": "00:36:08", "text": "如果要画画什么的，我会"}, {"type": "subtitle", "time": 2171.15, "timestamp": "00:36:11", "text": "试着自己写。我感觉"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "满意吗？我感觉不满意。"}, {"type": "subtitle", "time": 2176.63, "timestamp": "00:36:16", "text": "使满意？如果出现错误，那又会怎样？"}, {"type": "subtitle", "time": 2180.87, "timestamp": "00:36:20", "text": "我还能从中改进什么？"}, {"type": "subtitle", "time": 2184.31, "timestamp": "00:36:24", "text": "诸如此类的事情。然后我会记下来"}, {"type": "subtitle", "time": 2187.39, "timestamp": "00:36:27", "text": "改进并努力做得更好"}, {"type": "subtitle", "time": 2190.71, "timestamp": "00:36:30", "text": "艺术的同时也要考虑什么"}, {"type": "subtitle", "time": 2193.43, "timestamp": "00:36:33", "text": "我需要改进的地方。然后"}, {"type": "subtitle", "time": 2195.47, "timestamp": "00:36:35", "text": "我来评分。"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "我。但就像我们自己一样"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "我们最了解自己。"}, {"type": "subtitle", "time": 2207.03, "timestamp": "00:36:47", "text": "没错，我们最了解自己，因为我们"}, {"type": "subtitle", "time": 2210.069, "timestamp": "00:36:50", "text": "我们已经习惯了自己，对吧？那就这样吧。"}, {"type": "subtitle", "time": 2212.55, "timestamp": "00:36:52", "text": "任何优点或缺点，以便我们了解"}, {"type": "subtitle", "time": 2215.51, "timestamp": "00:36:55", "text": "我们犯了哪些错误，我们做了哪些事"}, {"type": "subtitle", "time": 2219.43, "timestamp": "00:36:59", "text": "需要纠正等等等等，对吧，是一样的。"}]
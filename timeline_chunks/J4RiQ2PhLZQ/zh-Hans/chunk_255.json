[{"type": "subtitle", "time": 15303.269, "timestamp": "04:15:03", "text": "某人。等等，我的生命值好像在下降"}, {"type": "subtitle", "time": 15315.229, "timestamp": "04:15:15", "text": "这难道不是增益效果吗？不，是吗？"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "我在那里每秒都在掉血。"}, {"type": "subtitle", "time": 15328.95, "timestamp": "04:15:28", "text": "哦，大家都在输。等等，那个"}, {"type": "subtitle", "time": 15332.79, "timestamp": "04:15:32", "text": "女巫并没有失去生命值。"}, {"type": "subtitle", "time": 15340.269, "timestamp": "04:15:40", "text": "增强？减益，不是增益"}, {"type": "subtitle", "time": 15342.99, "timestamp": "04:15:42", "text": "减益效果。看看我怎么样"}, {"type": "subtitle", "time": 15344.75, "timestamp": "04:15:44", "text": "洛杉矶。感谢"}, {"type": "subtitle", "time": 15347.71, "timestamp": "04:15:47", "text": "上帝。哦，他是"}, {"type": "subtitle", "time": 15349.83, "timestamp": "04:15:49", "text": "怒不可遏。搞什么鬼？有一个"}]
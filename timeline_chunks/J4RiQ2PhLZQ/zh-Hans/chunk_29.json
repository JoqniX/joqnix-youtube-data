[{"type": "subtitle", "time": 1748.11, "timestamp": "00:29:08", "text": "上午 16:46"}, {"type": "subtitle", "time": 1758.47, "timestamp": "00:29:18", "text": "晚安。我累了。我还没到要啪啪啪的地步呢。"}, {"type": "subtitle", "time": 1764.47, "timestamp": "00:29:24", "text": "我的头撞到了墙上。不，我的意思是，就像我"}, {"type": "subtitle", "time": 1768.23, "timestamp": "00:29:28", "text": "我想，我只想休息一下。"}, {"type": "subtitle", "time": 1774.59, "timestamp": "00:29:34", "text": "再见。"}, {"type": "subtitle", "time": 1781.43, "timestamp": "00:29:41", "text": "能。晚安。"}, {"type": "subtitle", "time": 1785.99, "timestamp": "00:29:45", "text": "我还要总结一下，并表示感谢。"}, {"type": "subtitle", "time": 1788.63, "timestamp": "00:29:48", "text": "好的。我该离开吗？呃"}, {"type": "subtitle", "time": 1791.19, "timestamp": "00:29:51", "text": "是的。还有什么想说的吗？"}, {"type": "subtitle", "time": 1794.71, "timestamp": "00:29:54", "text": "离开之前？请杀了我。什么？"}]
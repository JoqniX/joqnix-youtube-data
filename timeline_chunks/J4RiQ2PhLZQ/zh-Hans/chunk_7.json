[{"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "甚至还记得我去年做了什么。我"}, {"type": "subtitle", "time": 426.99, "timestamp": "00:07:06", "text": "我想我当时没做什么。我最后做了什么吗？"}, {"type": "subtitle", "time": 429.79, "timestamp": "00:07:09", "text": "年？呃，我得……"}, {"type": "subtitle", "time": 433.67, "timestamp": "00:07:13", "text": "检查前一年的日期"}, {"type": "subtitle", "time": 435.67, "timestamp": "00:07:15", "text": "我喜欢巧克力揭晓仪式。"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "溪流。"}, {"type": "subtitle", "time": 438.78, "timestamp": "00:07:18", "text": "啊"}, {"type": "subtitle", "time": 441.11, "timestamp": "00:07:21", "text": "[音乐]"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "我觉得我当时拍的并不多。"}, {"type": "subtitle", "time": 448.87, "timestamp": "00:07:28", "text": "回到过去。翻过来"}, {"type": "subtitle", "time": 452.15, "timestamp": "00:07:32", "text": "是的，我想我当时没有直播。"}, {"type": "subtitle", "time": 454.23, "timestamp": "00:07:34", "text": "她会做噩梦的。"}, {"type": "subtitle", "time": 456.189, "timestamp": "00:07:36", "text": "今天的"}, {"type": "subtitle", "time": 460.15, "timestamp": "00:07:40", "text": "不，她不会。"}, {"type": "subtitle", "time": 462.79, "timestamp": "00:07:42", "text": "将年龄分为三个部分"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "那段时间我参加了一场婚礼。"}, {"type": "subtitle", "time": 467.67, "timestamp": "00:07:47", "text": "时间"}, {"type": "subtitle", "time": 470.43, "timestamp": "00:07:50", "text": "h 当"}, {"type": "subtitle", "time": 476.07, "timestamp": "00:07:56", "text": "呃，去年情人节的时候啊"}]
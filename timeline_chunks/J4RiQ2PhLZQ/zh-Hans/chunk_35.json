[{"type": "subtitle", "time": 2100.829, "timestamp": "00:35:00", "text": "班级。我估计中午之前就能回来。所以"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "凌晨 3:04 呃，下午看看我能不能做到"}, {"type": "subtitle", "time": 2108.23, "timestamp": "00:35:08", "text": "溪流。对，看看能不能直播。"}, {"type": "subtitle", "time": 2111.23, "timestamp": "00:35:11", "text": "我非常想直播。"}, {"type": "subtitle", "time": 2113.79, "timestamp": "00:35:13", "text": "是的。所以会"}, {"type": "subtitle", "time": 2122.99, "timestamp": "00:35:22", "text": "今天。我得收拾桌子。"}, {"type": "subtitle", "time": 2125.829, "timestamp": "00:35:25", "text": "我真的得清理一下我的桌子。"}, {"type": "subtitle", "time": 2126.27, "timestamp": "00:35:26", "text": "很多"}, {"type": "subtitle", "time": 2127.47, "timestamp": "00:35:27", "text": "[音乐]"}, {"type": "subtitle", "time": 2131.39, "timestamp": "00:35:31", "text": "今天不行，除非它是黑色大理石。"}, {"type": "subtitle", "time": 2134.63, "timestamp": "00:35:34", "text": "桌面。你可以看到灰尘扬起来。"}, {"type": "subtitle", "time": 2137.43, "timestamp": "00:35:37", "text": "每一天。我需要打扫"}, {"type": "subtitle", "time": 2141.43, "timestamp": "00:35:41", "text": "这个东西。但你说要突袭我的哦，"}, {"type": "subtitle", "time": 2144.91, "timestamp": "00:35:44", "text": "是的。哦，是的。它曾在宾夕法尼亚州使用过。"}, {"type": "subtitle", "time": 2149.87, "timestamp": "00:35:49", "text": "啊。哦，我这么说是因为不。嗯，是这样的。"}, {"type": "subtitle", "time": 2152.87, "timestamp": "00:35:52", "text": "就像我们做一些有创意的事情一样。哦，"}, {"type": "subtitle", "time": 2154.15, "timestamp": "00:35:54", "text": "如果你想知道那是什么，那就是"}, {"type": "subtitle", "time": 2156.95, "timestamp": "00:35:56", "text": "我的MIDI键盘。别在意。那是"}, {"type": "subtitle", "time": 2158.829, "timestamp": "00:35:58", "text": "我制作"}]
[{"type": "subtitle", "time": 9242.71, "timestamp": "02:34:02", "text": "那个东西和那个发出声音的东西即将"}, {"type": "subtitle", "time": 9246.59, "timestamp": "02:34:06", "text": "确认对声音敏感度。"}, {"type": "subtitle", "time": 9251.349, "timestamp": "02:34:11", "text": "医生让我去咨询……"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "医生。所以我会按以下方式完成它们："}, {"type": "subtitle", "time": 9256.51, "timestamp": "02:34:16", "text": "本周或下周"}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "大约一周左右。呃，那条狗告诉我告诉"}, {"type": "subtitle", "time": 9263.83, "timestamp": "02:34:23", "text": "对我来说，我的冰冻能力已经达到了我的水平"}, {"type": "subtitle", "time": 9266.469, "timestamp": "02:34:26", "text": "略有增加。我确实发了推文。"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "关于权力水平"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "把旧的和新的都换掉了。"}, {"type": "subtitle", "time": 9272.429, "timestamp": "02:34:32", "text": "是的。"}, {"type": "subtitle", "time": 9277.03, "timestamp": "02:34:37", "text": "还有什么？嗯，是的。所以，呃，我会得到"}, {"type": "subtitle", "time": 9281.59, "timestamp": "02:34:41", "text": "下周大概能拿到眼镜了。男人，"}, {"type": "subtitle", "time": 9285.23, "timestamp": "02:34:45", "text": "那是痛苦。我不想……问题是"}, {"type": "subtitle", "time": 9288.469, "timestamp": "02:34:48", "text": "嗯，看来我穿的跟你一模一样。"}, {"type": "subtitle", "time": 9293.19, "timestamp": "02:34:53", "text": "眼镜是我现实生活中扮演的Jockn的OC角色。我穿"}, {"type": "subtitle", "time": 9296.03, "timestamp": "02:34:56", "text": "完全相同的回合"}, {"type": "subtitle", "time": 9299.11, "timestamp": "02:34:59", "text": "眼镜。我戴的也是同一款圆领衫。"}]
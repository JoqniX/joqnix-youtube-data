[{"type": "subtitle", "time": 63.349000000000004, "timestamp": "00:01:03", "text": "方式。这边走。"}, {"type": "subtitle", "time": 65.83, "timestamp": "00:01:05", "text": "哦，是同一件事。我们也是一样。"}, {"type": "subtitle", "time": 67.55, "timestamp": "00:01:07", "text": "做过。但到那时"}, {"type": "subtitle", "time": 72.63, "timestamp": "00:01:12", "text": "顺便一提，多林戈去世了。"}, {"type": "subtitle", "time": 74.71000000000001, "timestamp": "00:01:14", "text": "嘿，什么？"}, {"type": "subtitle", "time": 83.27, "timestamp": "00:01:23", "text": "接下来我该怎么办？"}, {"type": "subtitle", "time": 86.469, "timestamp": "00:01:26", "text": "哦。呃，打开它，做里面的事。"}, {"type": "subtitle", "time": 95.35, "timestamp": "00:01:35", "text": "呃，这个，呃，你，是的，拿走这两个末端"}, {"type": "subtitle", "time": 103.59, "timestamp": "00:01:43", "text": "它。是的。是的，然后你就有权利了。"}, {"type": "subtitle", "time": 107.03, "timestamp": "00:01:47", "text": "向左倾斜一个角，然后重复上述步骤。"}, {"type": "subtitle", "time": 110.069, "timestamp": "00:01:50", "text": "反过来做。"}, {"type": "subtitle", "time": 111.67, "timestamp": "00:01:51", "text": "嗯？"}, {"type": "subtitle", "time": 113.59, "timestamp": "00:01:53", "text": "呃，"}, {"type": "subtitle", "time": 116.469, "timestamp": "00:01:56", "text": "像这样，对吧？你把这两个放进去"}, {"type": "subtitle", "time": 118.10900000000001, "timestamp": "00:01:58", "text": "在"}]
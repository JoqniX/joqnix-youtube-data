[{"type": "subtitle", "time": 9481.429, "timestamp": "02:38:01", "text": "比如更专注于直播"}, {"type": "subtitle", "time": 9483.75, "timestamp": "02:38:03", "text": "为流媒体建设工作"}, {"type": "subtitle", "time": 9486.309, "timestamp": "02:38:06", "text": "新的明显效果，例如测试"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "把他们赶出去，打破一切显而易见的局面。"}, {"type": "subtitle", "time": 9490.95, "timestamp": "02:38:10", "text": "我怀念那些直播的日子"}, {"type": "subtitle", "time": 9494.95, "timestamp": "02:38:14", "text": "现在我基本上就是玩游戏放松一下。"}, {"type": "subtitle", "time": 9499.27, "timestamp": "02:38:19", "text": "还有其他工作上的事，因为我已经……"}, {"type": "subtitle", "time": 9502.15, "timestamp": "02:38:22", "text": "过去一个月，过去一年，我已经"}, {"type": "subtitle", "time": 9503.87, "timestamp": "02:38:23", "text": "大部分都完成了"}, {"type": "subtitle", "time": 9508.15, "timestamp": "02:38:28", "text": "一个我称之为另一种基本设置"}, {"type": "subtitle", "time": 9514.79, "timestamp": "02:38:34", "text": "设置好了，但是还没……呃，它是……"}, {"type": "subtitle", "time": 9516.429, "timestamp": "02:38:36", "text": "还没……呃"}, {"type": "subtitle", "time": 9519.99, "timestamp": "02:38:39", "text": "效率高是因为它总是坏，但也"}, {"type": "subtitle", "time": 9521.23, "timestamp": "02:38:41", "text": "就像我想要的那样"}, {"type": "subtitle", "time": 9524.23, "timestamp": "02:38:44", "text": "你知道，尝试一些新东西"}, {"type": "subtitle", "time": 9527.03, "timestamp": "02:38:47", "text": "尤其对于YouTube用户来说，"}, {"type": "subtitle", "time": 9529.349, "timestamp": "02:38:49", "text": "YouTube 用户，我需要找到更好的"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "姓名"}, {"type": "subtitle", "time": 9533.87, "timestamp": "02:38:53", "text": "呃，对于YouTube上熟悉的人来说，"}, {"type": "subtitle", "time": 9537.27, "timestamp": "02:38:57", "text": "Twitch，所以我可以，或者你想等等吗？"}, {"type": "subtitle", "time": 9539.389, "timestamp": "02:38:59", "text": "区分两者是可以的。"}]
[{"type": "subtitle", "time": 13141.429, "timestamp": "03:39:01", "text": "巨型，不是巨大，它叫什么来着？"}, {"type": "subtitle", "time": 13145.75, "timestamp": "03:39:05", "text": "嗯，那个叫什么来着？"}, {"type": "subtitle", "time": 13149.429, "timestamp": "03:39:09", "text": "他会送一条银胡子项链"}, {"type": "subtitle", "time": 13160.07, "timestamp": "03:39:20", "text": "好的，现在就去做，但是你在做什么？"}, {"type": "subtitle", "time": 13162.55, "timestamp": "03:39:22", "text": "银胡子之所以如此难缠，是因为"}, {"type": "subtitle", "time": 13163.71, "timestamp": "03:39:23", "text": "人们是"}, {"type": "subtitle", "time": 13167.349, "timestamp": "03:39:27", "text": "就像不断地击杀boss一样"}, {"type": "subtitle", "time": 13171.99, "timestamp": "03:39:31", "text": "一次就够了吧？所以，这会非常困难。"}, {"type": "subtitle", "time": 13174.67, "timestamp": "03:39:34", "text": "为您服务"}, {"type": "subtitle", "time": 13182.389, "timestamp": "03:39:42", "text": "向上。还有这个东西，工艺品"}, {"type": "subtitle", "time": 13184.71, "timestamp": "03:39:44", "text": "配饰。在杀死银熊之后"}, {"type": "subtitle", "time": 13187.95, "timestamp": "03:39:47", "text": "哇，你可以用它们制作他们的项链"}, {"type": "subtitle", "time": 13190.51, "timestamp": "03:39:50", "text": "[音乐]"}, {"type": "subtitle", "time": 13193.75, "timestamp": "03:39:53", "text": "这里。我想，就这些了。而且，"}, {"type": "subtitle", "time": 13196.07, "timestamp": "03:39:56", "text": "是的。哦，对，这个也是。你可以"}, {"type": "subtitle", "time": 13199.67, "timestamp": "03:39:59", "text": "木制保险丝徽章的断路器。你"}]
[{"type": "subtitle", "time": 12180.67, "timestamp": "03:23:00", "text": "五、"}, {"type": "subtitle", "time": 12190.95, "timestamp": "03:23:10", "text": "等等，等等，等等，等等，等等。有"}, {"type": "subtitle", "time": 12193.429, "timestamp": "03:23:13", "text": "日语配音演员。"}, {"type": "subtitle", "time": 12195.87, "timestamp": "03:23:15", "text": "我不能"}, {"type": "subtitle", "time": 12205.429, "timestamp": "03:23:25", "text": "V. 我忘了。哦，我忘了。我"}, {"type": "subtitle", "time": 12208.75, "timestamp": "03:23:28", "text": "最近刚安装的。"}, {"type": "subtitle", "time": 12218.389, "timestamp": "03:23:38", "text": "忘记？重置电脑后，我忘记了"}, {"type": "subtitle", "time": 12219.389, "timestamp": "03:23:39", "text": "关于"}, {"type": "subtitle", "time": 12225.309, "timestamp": "03:23:45", "text": "我嘎吱嘎吱地"}, {"type": "subtitle", "time": 12230.95, "timestamp": "03:23:50", "text": "阴影会损坏主体。"}]
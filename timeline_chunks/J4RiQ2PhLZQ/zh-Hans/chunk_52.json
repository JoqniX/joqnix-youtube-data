[{"type": "subtitle", "time": 3121.349, "timestamp": "00:52:01", "text": "正确的。是的。呃，对于潮湿的29级来说，"}, {"type": "subtitle", "time": 3123.99, "timestamp": "00:52:03", "text": "这应该是关于 Xan 的，而且"}, {"type": "subtitle", "time": 3126.87, "timestamp": "00:52:06", "text": "我以为我能做到"}, {"type": "subtitle", "time": 3130.79, "timestamp": "00:52:10", "text": "我是女王，但我却是个笨蛋。女王是"}, {"type": "subtitle", "time": 3132.79, "timestamp": "00:52:12", "text": "小女孩。"}, {"type": "subtitle", "time": 3135.549, "timestamp": "00:52:15", "text": "我可以帮你吗？她应该是"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "是工程师，不是那个婊子，尽管"}, {"type": "subtitle", "time": 3139.589, "timestamp": "00:52:19", "text": "她是一名法师。"}, {"type": "subtitle", "time": 3143.349, "timestamp": "00:52:23", "text": "她应该是一位完美的……呃，女王。"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "应该是工程师，而我"}, {"type": "subtitle", "time": 3148.069, "timestamp": "00:52:28", "text": "不小心选了女巫来对付它"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "我。"}, {"type": "subtitle", "time": 3152.829, "timestamp": "00:52:32", "text": "我不知道我"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "背部受伤，但没事。主要原因"}, {"type": "subtitle", "time": 3160.069, "timestamp": "00:52:40", "text": "为什么我不小心选了一位湿润的女王"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "因为你知道高度"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "流氓和工程师的区别"}, {"type": "subtitle", "time": 3167.03, "timestamp": "00:52:47", "text": "这个女孩"}, {"type": "subtitle", "time": 3169.75, "timestamp": "00:52:49", "text": "他们俩都来吧。假设我"}, {"type": "subtitle", "time": 3172.15, "timestamp": "00:52:52", "text": "我以为我可以像个运动员一样，然后"}, {"type": "subtitle", "time": 3176.23, "timestamp": "00:52:56", "text": "鸡蛋、阿奎那和计时器，然后就像"}, {"type": "subtitle", "time": 3179.589, "timestamp": "00:52:59", "text": "这。我就是你想要的那个人吗？"}]
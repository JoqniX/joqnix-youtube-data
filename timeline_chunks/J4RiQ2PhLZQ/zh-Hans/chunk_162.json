[{"type": "subtitle", "time": 9727.63, "timestamp": "02:42:07", "text": "呃，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "呃，就是在YouTube上做那个猫咪视频吗？"}, {"type": "subtitle", "time": 9733.99, "timestamp": "02:42:13", "text": "是的。谢谢你，Dreamy。"}, {"type": "subtitle", "time": 9737.11, "timestamp": "02:42:17", "text": "所以，你知道一件事，"}, {"type": "subtitle", "time": 9738.99, "timestamp": "02:42:18", "text": "让我感到快乐的是"}, {"type": "subtitle", "time": 9741.59, "timestamp": "02:42:21", "text": "嗯，有一件事让我感到高兴……"}, {"type": "subtitle", "time": 9745.59, "timestamp": "02:42:25", "text": "那一刻，呃，是去年我……"}, {"type": "subtitle", "time": 9747.429, "timestamp": "02:42:27", "text": "以前只有他对此感兴趣"}, {"type": "subtitle", "time": 9750.79, "timestamp": "02:42:30", "text": "在高级流媒体方面，呃，胡闹"}, {"type": "subtitle", "time": 9753.91, "timestamp": "02:42:33", "text": "主要和Leoron Bot一起直播"}, {"type": "subtitle", "time": 9757.429, "timestamp": "02:42:37", "text": "Leorbot 每天都会让我发出“啊”的感叹。"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "天哪，我得弄明白这些东西。"}, {"type": "subtitle", "time": 9761.99, "timestamp": "02:42:41", "text": "无论需要多久，我都会"}, {"type": "subtitle", "time": 9764.389, "timestamp": "02:42:44", "text": "熟练掌握软件操作。我们每条溪流"}, {"type": "subtitle", "time": 9766.95, "timestamp": "02:42:46", "text": "以前在Twitch上我们喜欢"}, {"type": "subtitle", "time": 9770.23, "timestamp": "02:42:50", "text": "把东西做成特效之类的东西，然后把它们弄好。"}, {"type": "subtitle", "time": 9772.87, "timestamp": "02:42:52", "text": "我很高兴地说，嗯，不只是我一个人这样"}, {"type": "subtitle", "time": 9777.27, "timestamp": "02:42:57", "text": "这样做很快就会变成不这样做。"}, {"type": "subtitle", "time": 9779.03, "timestamp": "02:42:59", "text": "呃，不过他没用橄榄木板。"}]
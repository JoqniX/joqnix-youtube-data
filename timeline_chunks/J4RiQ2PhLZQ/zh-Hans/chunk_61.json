[{"type": "subtitle", "time": 3663.39, "timestamp": "01:01:03", "text": "农作物。我太需要西红柿了。"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "M. 我想要西红柿，所以我可以买像"}, {"type": "subtitle", "time": 3672.109, "timestamp": "01:01:12", "text": "所有方面都升级。等等，我搞不定"}, {"type": "subtitle", "time": 3675.03, "timestamp": "01:01:15", "text": "西红柿。我只有五个。我需要10个"}, {"type": "subtitle", "time": 3681.349, "timestamp": "01:01:21", "text": "秒。我不知道怎么才能买到西红柿，但是"}, {"type": "subtitle", "time": 3682.19, "timestamp": "01:01:22", "text": "我想"}, {"type": "subtitle", "time": 3687.549, "timestamp": "01:01:27", "text": "[音乐]"}, {"type": "subtitle", "time": 3690.23, "timestamp": "01:01:30", "text": "他们。我会为我举办一个派对"}, {"type": "subtitle", "time": 3692.589, "timestamp": "01:01:32", "text": "王国人民。"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "Buckas，谁在？玛卡。笨蛋。咪咪是"}, {"type": "subtitle", "time": 3701.67, "timestamp": "01:01:41", "text": "在。所以，我邀请你。"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "你好。"}]
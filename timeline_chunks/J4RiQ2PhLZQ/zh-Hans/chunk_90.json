[{"type": "subtitle", "time": 5400.39, "timestamp": "01:30:00", "text": "一对一的较量。你必须这样做"}, {"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "虽然每天都会遇到这种情况。等等，你不能这样做"}, {"type": "subtitle", "time": 5404.87, "timestamp": "01:30:04", "text": "笨蛋。"}, {"type": "subtitle", "time": 5408.149, "timestamp": "01:30:08", "text": "谢谢。好吧，我就选这个人。他是"}, {"type": "subtitle", "time": 5413.43, "timestamp": "01:30:13", "text": "呃，我244岁，我216岁。你好。开始双人模式。你"}, {"type": "subtitle", "time": 5417.59, "timestamp": "01:30:17", "text": "获得三张双人车入场券"}, {"type": "subtitle", "time": 5430.669, "timestamp": "01:30:30", "text": "他有"}, {"type": "subtitle", "time": 5435.83, "timestamp": "01:30:35", "text": "我。哦，他去世了。耶。"}, {"type": "subtitle", "time": 5438.59, "timestamp": "01:30:38", "text": "哦，每天、每周、任何时间"}, {"type": "subtitle", "time": 5441.54, "timestamp": "01:30:41", "text": "尽管。哦，我们赢了。"}, {"type": "subtitle", "time": 5447.99, "timestamp": "01:30:47", "text": "好的。好的。继续。所以这一次"}]
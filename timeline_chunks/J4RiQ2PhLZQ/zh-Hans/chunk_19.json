[{"type": "subtitle", "time": 1141.35, "timestamp": "00:19:01", "text": "好吧，我们当时在拍一些照片。"}, {"type": "subtitle", "time": 1145.43, "timestamp": "00:19:05", "text": "像倒水一样翻来覆去地倒，就像ASMR一样。"}, {"type": "subtitle", "time": 1154.15, "timestamp": "00:19:14", "text": "我可能会上传。"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "哦，你录下来了？是的。哇。好的。"}, {"type": "subtitle", "time": 1162.59, "timestamp": "00:19:22", "text": "也许我会拍个烘焙视频。"}, {"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "我应该把每个部分都考虑进去并压平吗？"}, {"type": "subtitle", "time": 1176.669, "timestamp": "00:19:36", "text": "他们。是，是，是"}, {"type": "subtitle", "time": 1180.63, "timestamp": "00:19:40", "text": "完毕。将每个部件展开并压平。"}, {"type": "subtitle", "time": 1181.87, "timestamp": "00:19:41", "text": "哦，是的"}, {"type": "subtitle", "time": 1184.909, "timestamp": "00:19:44", "text": "完毕。等等，完成了。好的"}, {"type": "subtitle", "time": 1189.43, "timestamp": "00:19:49", "text": "工作。我什么都做不了。"}, {"type": "subtitle", "time": 1192.39, "timestamp": "00:19:52", "text": "看起来有点怪异，但至少我们"}, {"type": "subtitle", "time": 1194.65, "timestamp": "00:19:54", "text": "尝试了一下。"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "[音乐]"}, {"type": "subtitle", "time": 1197.99, "timestamp": "00:19:57", "text": "你已经尽力了。你做得更好"}]
[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "我们当时就是这样，这是一种典型的我们"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "宅男。你知道，我意识到，呃，大部分"}, {"type": "subtitle", "time": 795.59, "timestamp": "00:13:15", "text": "我们在外面看到的人，他们都是"}, {"type": "subtitle", "time": 797.59, "timestamp": "00:13:17", "text": "普通人。他们不玩游戏。他们"}, {"type": "subtitle", "time": 800.87, "timestamp": "00:13:20", "text": "我不了解动漫。只有少数人知道"}, {"type": "subtitle", "time": 803.71, "timestamp": "00:13:23", "text": "关于动漫和"}, {"type": "subtitle", "time": 808.629, "timestamp": "00:13:28", "text": "东西。我当时震惊了，就像，嘿，你"}, {"type": "subtitle", "time": 810.71, "timestamp": "00:13:30", "text": "不要玩游戏。你不会玩Gench。"}, {"type": "subtitle", "time": 814.87, "timestamp": "00:13:34", "text": "你不玩《我的世界》。"}, {"type": "subtitle", "time": 817.55, "timestamp": "00:13:37", "text": "是的，我玩"}, {"type": "subtitle", "time": 821.59, "timestamp": "00:13:41", "text": "我最近没玩《无限暖暖》"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "任何一个。我当时对它上瘾了。哦，我"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "也。故事很迷人，也很温馨。"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "但我喜欢装扮这个环节。好的。"}, {"type": "subtitle", "time": 835.68, "timestamp": "00:13:55", "text": "是的。"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "[音乐]"}]
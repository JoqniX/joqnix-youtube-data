[{"type": "subtitle", "time": 9069.11, "timestamp": "02:31:09", "text": "眼睛。哦，那一下打得真重。我的天哪。"}, {"type": "subtitle", "time": 9071.03, "timestamp": "02:31:11", "text": "那是一次很重的撞击。我的在哪里？"}, {"type": "subtitle", "time": 9073.51, "timestamp": "02:31:13", "text": "帽子？差距在哪里？等等，哪里？"}, {"type": "subtitle", "time": 9076.309, "timestamp": "02:31:16", "text": "差距在哪里？差距在哪里？哦，明白了。"}, {"type": "subtitle", "time": 9078.87, "timestamp": "02:31:18", "text": "知道了。盒子在哪儿？等等，哪里？"}, {"type": "subtitle", "time": 9082.79, "timestamp": "02:31:22", "text": "盒子？我双目失明。盒子在哪儿？哦，"}, {"type": "subtitle", "time": 9083.79, "timestamp": "02:31:23", "text": "得到"}, {"type": "subtitle", "time": 9090.99, "timestamp": "02:31:30", "text": "盒子。我的"}, {"type": "subtitle", "time": 9094.389, "timestamp": "02:31:34", "text": "去？你好。我们现在进行无声的交谈。并非沉默"}, {"type": "subtitle", "time": 9100.27, "timestamp": "02:31:40", "text": "讲话。是的。"}, {"type": "subtitle", "time": 9103.07, "timestamp": "02:31:43", "text": "莫，是的，还有什么"}, {"type": "subtitle", "time": 9106.55, "timestamp": "02:31:46", "text": "现在？嗯，准备好了。我只是需要时间"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "实际上，盖上印章。是的，我需要一些时间。"}, {"type": "subtitle", "time": 9112.11, "timestamp": "02:31:52", "text": "开始时间戳"}, {"type": "subtitle", "time": 9114.95, "timestamp": "02:31:54", "text": "昨天。所以，我们做了我们该做的事。"}, {"type": "subtitle", "time": 9117.469, "timestamp": "02:31:57", "text": "我们昨天做了什么？我忘了。我们玩"}]
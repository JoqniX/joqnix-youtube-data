[{"type": "subtitle", "time": 7740.629, "timestamp": "02:09:00", "text": "所以，呃，等等。我相信我这是什么？"}, {"type": "subtitle", "time": 7743.629, "timestamp": "02:09:03", "text": "今日第一项技能。宣称"}, {"type": "subtitle", "time": 7756.47, "timestamp": "02:09:16", "text": "眨眼？娜吉，等等。这是什么？"}, {"type": "subtitle", "time": 7757.87, "timestamp": "02:09:17", "text": "什么是"}, {"type": "subtitle", "time": 7760.03, "timestamp": "02:09:20", "text": "这？"}, {"type": "subtitle", "time": 7762.31, "timestamp": "02:09:22", "text": "提升你的战斗等级以提高"}, {"type": "subtitle", "time": 7764.39, "timestamp": "02:09:24", "text": "你的超负荷努力和当前"}, {"type": "subtitle", "time": 7767.669, "timestamp": "02:09:27", "text": "战斗。哦好的。战斗通行证指南。"}, {"type": "subtitle", "time": 7770.03, "timestamp": "02:09:30", "text": "宣称"}, {"type": "subtitle", "time": 7774.149, "timestamp": "02:09:34", "text": "那。认领此信息。是的。你好。不太好。"}, {"type": "subtitle", "time": 7776.03, "timestamp": "02:09:36", "text": "你好吗？希望你一切顺利"}, {"type": "subtitle", "time": 7779.229, "timestamp": "02:09:39", "text": "出色地。是的。"}, {"type": "subtitle", "time": 7781.47, "timestamp": "02:09:41", "text": "哈兰。宣称"}, {"type": "subtitle", "time": 7784.709, "timestamp": "02:09:44", "text": "这些。好的。回去。返回努尼。"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "这里发生了什么事？"}, {"type": "subtitle", "time": 7791.39, "timestamp": "02:09:51", "text": "这样做。做"}, {"type": "subtitle", "time": 7793.55, "timestamp": "02:09:53", "text": "这。"}]
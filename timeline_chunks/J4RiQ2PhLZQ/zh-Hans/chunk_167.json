[{"type": "subtitle", "time": 10021.83, "timestamp": "02:47:01", "text": "战场战争。我在6频道。呃，等等"}, {"type": "subtitle", "time": 10025.19, "timestamp": "02:47:05", "text": "我们平时所做的一切"}, {"type": "subtitle", "time": 10029.03, "timestamp": "02:47:09", "text": "在王国里这样做。所以，在……"}, {"type": "subtitle", "time": 10033.15, "timestamp": "02:47:13", "text": "第一个野外队长，第一个就是"}, {"type": "subtitle", "time": 10036.87, "timestamp": "02:47:16", "text": "呃，挑战战场老大，对吧。所以对于"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "很可能大家都会选择这个。"}, {"type": "subtitle", "time": 10040.349, "timestamp": "02:47:20", "text": "鸡"}, {"type": "subtitle", "time": 10041.87, "timestamp": "02:47:21", "text": "公鸡"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "科卡特。呃，所以首先最重要的是……"}, {"type": "subtitle", "time": 10047.99, "timestamp": "02:47:27", "text": "你快速旅行到当前频道"}, {"type": "subtitle", "time": 10049.15, "timestamp": "02:47:29", "text": "是"}, {"type": "subtitle", "time": 10052.15, "timestamp": "02:47:32", "text": "因为如果你把频道换到"}, {"type": "subtitle", "time": 10055.269, "timestamp": "02:47:35", "text": "那个行不通的派对频道"}, {"type": "subtitle", "time": 10059.19, "timestamp": "02:47:39", "text": "努力工作，因为你会有休息时间。"}, {"type": "subtitle", "time": 10062.309, "timestamp": "02:47:42", "text": "超时延迟，你不想遇到这种情况"}, {"type": "subtitle", "time": 10065.15, "timestamp": "02:47:45", "text": "超时。不会像延迟那样超时"}, {"type": "subtitle", "time": 10069.19, "timestamp": "02:47:49", "text": "进入下一个频道，因为呃……"}, {"type": "subtitle", "time": 10072.23, "timestamp": "02:47:52", "text": "很多人……哦，等等。嗯，差不多了"}, {"type": "subtitle", "time": 10077.23, "timestamp": "02:47:57", "text": "快速"}]
[{"type": "subtitle", "time": 7145.709, "timestamp": "01:59:05", "text": "呃，或者我应该……"}, {"type": "subtitle", "time": 7149.189, "timestamp": "01:59:09", "text": "继续玩吗？我不知道。就是它"}, {"type": "subtitle", "time": 7153.55, "timestamp": "01:59:13", "text": "没问题吧？我看到了这条信息流。"}, {"type": "subtitle", "time": 7156.79, "timestamp": "01:59:16", "text": "离开，他们正在做征服者"}, {"type": "subtitle", "time": 7158.669, "timestamp": "01:59:18", "text": "糊状物"}, {"type": "subtitle", "time": 7161.149, "timestamp": "01:59:21", "text": "生活"}, {"type": "subtitle", "time": 7174.83, "timestamp": "01:59:34", "text": "有权索取奖励"}, {"type": "subtitle", "time": 7181.31, "timestamp": "01:59:41", "text": "那是"}, {"type": "subtitle", "time": 7193.27, "timestamp": "01:59:53", "text": "有征服者充能可用。我"}]
[{"type": "subtitle", "time": 15962.55, "timestamp": "04:26:02", "text": "番茄买一送一，我给你"}, {"type": "subtitle", "time": 15963.35, "timestamp": "04:26:03", "text": "很多"}, {"type": "subtitle", "time": 15966.03, "timestamp": "04:26:06", "text": "[音乐]"}, {"type": "subtitle", "time": 15972.349, "timestamp": "04:26:12", "text": "请稍等"}, {"type": "subtitle", "time": 15976.79, "timestamp": "04:26:16", "text": "那是它发出的提示音，他正在看着我。"}, {"type": "subtitle", "time": 15985.229, "timestamp": "04:26:25", "text": "诺伊"}, {"type": "subtitle", "time": 15988.07, "timestamp": "04:26:28", "text": "布丁。你好吗？看看布丁。"}, {"type": "subtitle", "time": 15989.55, "timestamp": "04:26:29", "text": "他结束了"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "这里。哦，"}, {"type": "subtitle", "time": 15995.82, "timestamp": "04:26:35", "text": "这是"}, {"type": "subtitle", "time": 16013.54, "timestamp": "04:26:53", "text": "我会的"}]
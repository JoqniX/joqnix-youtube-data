[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "我需要这样做，因为这是显而易见的。"}, {"type": "subtitle", "time": 4742.47, "timestamp": "01:19:02", "text": "我愿意。来吧，留下来陪我。这是"}, {"type": "subtitle", "time": 4749.99, "timestamp": "01:19:09", "text": "如果墙壁是蓝色的，那岂不是……"}, {"type": "subtitle", "time": 4758.39, "timestamp": "01:19:18", "text": "是的。那我就简单说一下。好的，"}, {"type": "subtitle", "time": 4767.11, "timestamp": "01:19:27", "text": "钱。花我的钱。所以，等等。停止。"}, {"type": "subtitle", "time": 4769.189, "timestamp": "01:19:29", "text": "等待。停止。"}, {"type": "subtitle", "time": 4777.47, "timestamp": "01:19:37", "text": "相机？"}, {"type": "subtitle", "time": 4787.43, "timestamp": "01:19:47", "text": "青蛙。你好，简单问一下。好的，我们走"}, {"type": "subtitle", "time": 4793.39, "timestamp": "01:19:53", "text": "相信。"}, {"type": "subtitle", "time": 4795.87, "timestamp": "01:19:55", "text": "朋友，买"}]
[{"type": "subtitle", "time": 16740.15, "timestamp": "04:39:00", "text": "大概一个月左右。是的。库兹"}, {"type": "subtitle", "time": 16743.109, "timestamp": "04:39:03", "text": "因为我不得不卧床不起，因为我……"}, {"type": "subtitle", "time": 16745.67, "timestamp": "04:39:05", "text": "头疼，根本不敢靠近电脑。"}, {"type": "subtitle", "time": 16748.349, "timestamp": "04:39:08", "text": "还有一些其他的东西。连坐都坐不下。"}, {"type": "subtitle", "time": 16751.349, "timestamp": "04:39:11", "text": "多少钱？我甚至都坐不住。"}, {"type": "subtitle", "time": 16755.31, "timestamp": "04:39:15", "text": "有点像。是的，就是这样。"}, {"type": "subtitle", "time": 16757.83, "timestamp": "04:39:17", "text": "疼痛。是啊，我根本没法工作。"}, {"type": "subtitle", "time": 16761.349, "timestamp": "04:39:21", "text": "任何事物。是的，我的确这么做了。"}, {"type": "subtitle", "time": 16764.109, "timestamp": "04:39:24", "text": "经历同样的疲劳等等"}, {"type": "subtitle", "time": 16766.75, "timestamp": "04:39:26", "text": "本周内容"}, {"type": "subtitle", "time": 16769.189, "timestamp": "04:39:29", "text": "实际上。这就是我们错过两个的原因。"}, {"type": "subtitle", "time": 16771.91, "timestamp": "04:39:31", "text": "Twitch直播，工作直播。我不能"}, {"type": "subtitle", "time": 16774.47, "timestamp": "04:39:34", "text": "开展两项工作流程。是的，"}, {"type": "subtitle", "time": 16776.23, "timestamp": "04:39:36", "text": "显然我并没有想念YouTube。"}, {"type": "subtitle", "time": 16780.67, "timestamp": "04:39:40", "text": "直播，也就是，是的，再见，也就是"}, {"type": "subtitle", "time": 16782.75, "timestamp": "04:39:42", "text": "疯狂的。但"}, {"type": "subtitle", "time": 16786.15, "timestamp": "04:39:46", "text": "是的，我想我应该……我确实有一个"}, {"type": "subtitle", "time": 16789.75, "timestamp": "04:39:49", "text": "游戏直播时长限制为2小时。"}, {"type": "subtitle", "time": 16792.31, "timestamp": "04:39:52", "text": "流或其他任何流也应如此。"}, {"type": "subtitle", "time": 16796.788, "timestamp": "04:39:56", "text": "最多两到四个小时。但是，再说一遍，"}, {"type": "subtitle", "time": 16799.35, "timestamp": "04:39:59", "text": "我没有在听聊天记录，也没有在听其他人的发言。"}]
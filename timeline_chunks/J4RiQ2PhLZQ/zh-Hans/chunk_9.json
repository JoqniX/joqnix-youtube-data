[{"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "我本来打算直播一个关于Zaddy的内容。"}, {"type": "subtitle", "time": 548.87, "timestamp": "00:09:08", "text": "好的，所以基本上，我……好的，有一个"}, {"type": "subtitle", "time": 552.87, "timestamp": "00:09:12", "text": "我以前开玩笑说我是Zaddy。"}, {"type": "subtitle", "time": 565.75, "timestamp": "00:09:25", "text": "哦，爸爸。我爸爸 Z。好的。好的。所以，我"}, {"type": "subtitle", "time": 568.23, "timestamp": "00:09:28", "text": "本来打算戴个假胡子，然后……"}, {"type": "subtitle", "time": 572.55, "timestamp": "00:09:32", "text": "给我的孩子一些恋爱建议。哦，"}, {"type": "subtitle", "time": 575.03, "timestamp": "00:09:35", "text": "但我当时真的非常紧张，"}, {"type": "subtitle", "time": 582.07, "timestamp": "00:09:42", "text": "你本来可以拥有这两个角落，就像我一样"}, {"type": "subtitle", "time": 584.87, "timestamp": "00:09:44", "text": "显示中。"}, {"type": "subtitle", "time": 587.11, "timestamp": "00:09:47", "text": "所以，我改用了 Undertale 字符串。"}, {"type": "subtitle", "time": 589.509, "timestamp": "00:09:49", "text": "当天。"}, {"type": "subtitle", "time": 591.829, "timestamp": "00:09:51", "text": "啊，Undertale。我没有。你做到了"}, {"type": "subtitle", "time": 594.63, "timestamp": "00:09:54", "text": "如果我"}, {"type": "subtitle", "time": 597.11, "timestamp": "00:09:57", "text": "记住。真的很好。你应该"}]
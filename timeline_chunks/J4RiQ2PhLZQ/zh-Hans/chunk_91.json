[{"type": "subtitle", "time": 5465.39, "timestamp": "01:31:05", "text": "班级。我必须小心"}, {"type": "subtitle", "time": 5468.35, "timestamp": "01:31:08", "text": "工程师。它们可以治愈等等"}, {"type": "subtitle", "time": 5485.39, "timestamp": "01:31:25", "text": "他们。"}, {"type": "subtitle", "time": 5486.91, "timestamp": "01:31:26", "text": "下一个"}, {"type": "subtitle", "time": 5490.11, "timestamp": "01:31:30", "text": "二。我选了个小的"}, {"type": "subtitle", "time": 5493.59, "timestamp": "01:31:33", "text": "人们。基层人员。是的。其他"}, {"type": "subtitle", "time": 5495.05, "timestamp": "01:31:35", "text": "工程师班。"}, {"type": "subtitle", "time": 5497.149, "timestamp": "01:31:37", "text": "[音乐]"}, {"type": "subtitle", "time": 5500.11, "timestamp": "01:31:40", "text": "耶。啊，它"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "死了。哦，她痊愈了。我的天啊。她"}, {"type": "subtitle", "time": 5505.91, "timestamp": "01:31:45", "text": "已痊愈。她痊愈了。她痊愈了。她"}, {"type": "subtitle", "time": 5510.27, "timestamp": "01:31:50", "text": "已痊愈。她痊愈了。哦，她去世了。"}, {"type": "subtitle", "time": 5512.14, "timestamp": "01:31:52", "text": "耶。"}, {"type": "subtitle", "time": 5517.95, "timestamp": "01:31:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 2701.03, "timestamp": "00:45:01", "text": "我上次醒来的时候大概是下午5点。我"}, {"type": "subtitle", "time": 2704.63, "timestamp": "00:45:04", "text": "我只是把我的放进去了，我一直没放进去。"}, {"type": "subtitle", "time": 2707.43, "timestamp": "00:45:07", "text": "就像我刚才试着滴眼药水一样"}, {"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "我闭上眼睛，说道，然后我就睡着了。"}, {"type": "subtitle", "time": 2712.09, "timestamp": "00:45:12", "text": "就像……"}, {"type": "subtitle", "time": 2715.069, "timestamp": "00:45:15", "text": "[音乐]"}, {"type": "subtitle", "time": 2719.55, "timestamp": "00:45:19", "text": "是的。大家好。今天我们将……"}, {"type": "subtitle", "time": 2722.51, "timestamp": "00:45:22", "text": "正在播放。是的。我甚至还没开始"}, {"type": "subtitle", "time": 2740.109, "timestamp": "00:45:40", "text": "晚的。你好。所以，今天我们将……"}, {"type": "subtitle", "time": 2743.63, "timestamp": "00:45:43", "text": "正在播放。所以，我将要……做王国"}, {"type": "subtitle", "time": 2746.67, "timestamp": "00:45:46", "text": "东西。有很多事情要做。我"}, {"type": "subtitle", "time": 2750.39, "timestamp": "00:45:50", "text": "昨天没登录。是的，"}, {"type": "subtitle", "time": 2752.27, "timestamp": "00:45:52", "text": "太多了"}]
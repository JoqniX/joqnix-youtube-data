[{"type": "subtitle", "time": 7562.55, "timestamp": "02:06:02", "text": "乔王国怎么样了？怎么样？"}, {"type": "subtitle", "time": 7564.87, "timestamp": "02:06:04", "text": "王国在做什么？暗黑破坏神怎么样了？呃"}, {"type": "subtitle", "time": 7567.35, "timestamp": "02:06:07", "text": "直到今天我都没碰过《暗黑破坏神》吧？"}, {"type": "subtitle", "time": 7571.31, "timestamp": "02:06:11", "text": "现在。自从上一期节目播出以来"}, {"type": "subtitle", "time": 7572.91, "timestamp": "02:06:12", "text": "暗黑破坏神。"}, {"type": "subtitle", "time": 7575.75, "timestamp": "02:06:15", "text": "王国正在蓬勃发展。实际上，"}, {"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "我们需要，我们需要进行王国防御"}, {"type": "subtitle", "time": 7582.39, "timestamp": "02:06:22", "text": "很快就会有一个王国地牢，所有人都会加入。"}, {"type": "subtitle", "time": 7585.589, "timestamp": "02:06:25", "text": "谁有空。我会像上次一样独自完成。"}, {"type": "subtitle", "time": 7589.43, "timestamp": "02:06:29", "text": "带自动填充功能的时间。"}, {"type": "subtitle", "time": 7596.069, "timestamp": "02:06:36", "text": "是的，我会保留原来的背景。"}, {"type": "subtitle", "time": 7599.87, "timestamp": "02:06:39", "text": "还要知道要照顾机器人"}, {"type": "subtitle", "time": 7603.91, "timestamp": "02:06:43", "text": "杰克逊·帕卡夜间机器人。等等，不要模糊。"}, {"type": "subtitle", "time": 7606.91, "timestamp": "02:06:46", "text": "我为什么要模糊处理？哦，等等"}, {"type": "subtitle", "time": 7609.95, "timestamp": "02:06:49", "text": "等待。我在做什么？我是什么？"}]
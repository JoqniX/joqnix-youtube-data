[{"type": "subtitle", "time": 7806.95, "timestamp": "02:10:06", "text": "正在做？我们什么也没得到。我应该"}, {"type": "subtitle", "time": 7809.149, "timestamp": "02:10:09", "text": "不，我不应该"}, {"type": "subtitle", "time": 7812.39, "timestamp": "02:10:12", "text": "比如攻击低等级怪物。反而，"}, {"type": "subtitle", "time": 7814.75, "timestamp": "02:10:14", "text": "我这就去做任务。这是主要问题。"}, {"type": "subtitle", "time": 7817.669, "timestamp": "02:10:17", "text": "光。我21级了。这很不错。"}, {"type": "subtitle", "time": 7821.55, "timestamp": "02:10:21", "text": "事物。而且，我相信我曾经"}, {"type": "subtitle", "time": 7824.43, "timestamp": "02:10:24", "text": "我相信我曾经有过"}, {"type": "subtitle", "time": 7827.83, "timestamp": "02:10:27", "text": "某物。嗯，我查一下。我"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "我想我给……做了个类似的东西"}, {"type": "subtitle", "time": 7835.189, "timestamp": "02:10:35", "text": "这是什么游戏来着？暗黑破坏神。是的，我"}, {"type": "subtitle", "time": 7838.27, "timestamp": "02:10:38", "text": "我相信我做了一些东西"}, {"type": "subtitle", "time": 7840.95, "timestamp": "02:10:40", "text": "暗黑破坏神。如果我能找到的话。我没有"}, {"type": "subtitle", "time": 7842.589, "timestamp": "02:10:42", "text": "制作"}, {"type": "subtitle", "time": 7847.109, "timestamp": "02:10:47", "text": "任何事物。嗯？但我从未创建过预设。"}, {"type": "subtitle", "time": 7849.31, "timestamp": "02:10:49", "text": "为了"}, {"type": "subtitle", "time": 7852.35, "timestamp": "02:10:52", "text": "暗黑破坏神。嗯？曾是"}]
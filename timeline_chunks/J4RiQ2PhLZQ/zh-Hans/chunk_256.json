[{"type": "subtitle", "time": 15360.59, "timestamp": "04:16:00", "text": "他妈的？搞什么鬼？有一个"}, {"type": "subtitle", "time": 15363.469, "timestamp": "04:16:03", "text": "公鸡。什么？"}, {"type": "subtitle", "time": 15367.95, "timestamp": "04:16:07", "text": "什么？搞什么鬼？哦，我的"}, {"type": "subtitle", "time": 15370.63, "timestamp": "04:16:10", "text": "上帝。通常情况下，如果我看到杯垫，我"}, {"type": "subtitle", "time": 15373.59, "timestamp": "04:16:13", "text": "会哭着跑开。但是，是的，我不能"}, {"type": "subtitle", "time": 15382.79, "timestamp": "04:16:22", "text": "那。我要死了。我要死了。我要死了。"}, {"type": "subtitle", "time": 15383.79, "timestamp": "04:16:23", "text": "我是"}, {"type": "subtitle", "time": 15388.99, "timestamp": "04:16:28", "text": "垂死。等等。我需要得到我"}, {"type": "subtitle", "time": 15392.309, "timestamp": "04:16:32", "text": "需要他。"}, {"type": "subtitle", "time": 15401.99, "timestamp": "04:16:41", "text": "你？我真的很喜欢你的声音"}, {"type": "subtitle", "time": 15403.469, "timestamp": "04:16:43", "text": "声音。"}, {"type": "subtitle", "time": 15412.67, "timestamp": "04:16:52", "text": "嗯？我们杀了"}, {"type": "subtitle", "time": 15415.95, "timestamp": "04:16:55", "text": "他们。他们是谁？请给我"}, {"type": "subtitle", "time": 15418.87, "timestamp": "04:16:58", "text": "最有价值球员。我没拿到最有价值球员奖。我确实收到了"}]
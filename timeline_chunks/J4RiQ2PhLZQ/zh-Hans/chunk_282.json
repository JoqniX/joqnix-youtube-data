[{"type": "subtitle", "time": 16921.59, "timestamp": "04:42:01", "text": "时间。如果我不在，就不会有直播了。"}, {"type": "subtitle", "time": 16923.43, "timestamp": "04:42:03", "text": "积极地前往帖子设置和"}, {"type": "subtitle", "time": 16928.59, "timestamp": "04:42:08", "text": "痛苦的东西。是的，我不想"}, {"type": "subtitle", "time": 16931.59, "timestamp": "04:42:11", "text": "那。但我不能一直这样说下去。"}, {"type": "subtitle", "time": 16935.07, "timestamp": "04:42:15", "text": "正确的。你必须，我必须"}, {"type": "subtitle", "time": 16940.67, "timestamp": "04:42:20", "text": "疼痛。哦，我把它弄得悬在空中了。我们开始吧"}, {"type": "subtitle", "time": 16944.67, "timestamp": "04:42:24", "text": "去。足球。哦，它就在里面。"}, {"type": "subtitle", "time": 16950.11, "timestamp": "04:42:30", "text": "好的。我可以放吗？你会吗？"}, {"type": "subtitle", "time": 16953.03, "timestamp": "04:42:33", "text": "不。我本来应该去拿我的"}, {"type": "subtitle", "time": 16957.83, "timestamp": "04:42:37", "text": "晚餐，但我忘了。哦，科拉，我想"}, {"type": "subtitle", "time": 16961.03, "timestamp": "04:42:41", "text": "我想进球。我想得到一个"}, {"type": "subtitle", "time": 16963.948, "timestamp": "04:42:43", "text": "目标。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 16966.75, "timestamp": "04:42:46", "text": "哦。是的。我做了"}, {"type": "subtitle", "time": 16969.19, "timestamp": "04:42:49", "text": "目标。哟，乔乔，跟我拍张照吧。"}, {"type": "subtitle", "time": 16970.868, "timestamp": "04:42:50", "text": "在哪里？在哪里？在哪里？在哪里？乔在哪里？"}, {"type": "subtitle", "time": 16974.03, "timestamp": "04:42:54", "text": "Dreamy在哪里？在哪里？"}, {"type": "subtitle", "time": 16975.868, "timestamp": "04:42:55", "text": "做梦吗？"}]
[{"type": "subtitle", "time": 10802.389, "timestamp": "03:00:02", "text": "去看医生，这样我就可以……"}, {"type": "subtitle", "time": 10804.87, "timestamp": "03:00:04", "text": "检查一下我的偏头痛和我的"}, {"type": "subtitle", "time": 10809.429, "timestamp": "03:00:09", "text": "听起来像……灵敏度之类的声音"}, {"type": "subtitle", "time": 10811.19, "timestamp": "03:00:11", "text": "因为我不想让声音方面的问题"}, {"type": "subtitle", "time": 10813.99, "timestamp": "03:00:13", "text": "影响到我了，因为即使现在穿着"}, {"type": "subtitle", "time": 10816.429, "timestamp": "03:00:16", "text": "耳机让我头疼"}, {"type": "subtitle", "time": 10819.99, "timestamp": "03:00:19", "text": "头疼，但我不想让它影响到我。"}, {"type": "subtitle", "time": 10823.51, "timestamp": "03:00:23", "text": "我的音乐制作相关用户作品"}, {"type": "subtitle", "time": 10826.389, "timestamp": "03:00:26", "text": "这些东西很重要。我不"}, {"type": "subtitle", "time": 10829.75, "timestamp": "03:00:29", "text": "想死。我不想受到限制。"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "正因如此。是的。所以，呃，所以她是"}, {"type": "subtitle", "time": 10837.63, "timestamp": "03:00:37", "text": "医生给我开了一个月的眼药水。"}, {"type": "subtitle", "time": 10840.83, "timestamp": "03:00:40", "text": "使用眼药水"}, {"type": "subtitle", "time": 10843.95, "timestamp": "03:00:43", "text": "月。嗯，其实是两滴眼药水。"}, {"type": "subtitle", "time": 10847.59, "timestamp": "03:00:47", "text": "呃，一天四次。一是四"}, {"type": "subtitle", "time": 10850.23, "timestamp": "03:00:50", "text": "一天几次，还有一种是一天两次。"}, {"type": "subtitle", "time": 10852.23, "timestamp": "03:00:52", "text": "一天。"}, {"type": "subtitle", "time": 10856.67, "timestamp": "03:00:56", "text": "提升技能等级。嗯，好的。等级"}]
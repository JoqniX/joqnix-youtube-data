[{"type": "subtitle", "time": 4382.59, "timestamp": "01:13:02", "text": "是三。"}, {"type": "subtitle", "time": 4385.83, "timestamp": "01:13:05", "text": "哦，可定制的选项真多。但我"}, {"type": "subtitle", "time": 4388.07, "timestamp": "01:13:08", "text": "想把前面的三个三换掉"}, {"type": "subtitle", "time": 4398.27, "timestamp": "01:13:18", "text": "我还能做什么？"}, {"type": "subtitle", "time": 4402.11, "timestamp": "01:13:22", "text": "改变？哦，我买了那个"}, {"type": "subtitle", "time": 4404.59, "timestamp": "01:13:24", "text": "在。"}, {"type": "subtitle", "time": 4407.39, "timestamp": "01:13:27", "text": "等等，你"}, {"type": "subtitle", "time": 4414.87, "timestamp": "01:13:34", "text": "等等，等等。我的用户界面怎么了？"}, {"type": "subtitle", "time": 4418.709, "timestamp": "01:13:38", "text": "等待。也就是说，是你买的。那个王国"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "朋友。等等，我要挂机一会儿。你好。拿"}, {"type": "subtitle", "time": 4424.91, "timestamp": "01:13:44", "text": "关心我。等等，你不能这样做"}, {"type": "subtitle", "time": 4434.59, "timestamp": "01:13:54", "text": "真的吗？为什么是"}, {"type": "subtitle", "time": 4438.99, "timestamp": "01:13:58", "text": "发生了什么事？为什么会这样？"}]
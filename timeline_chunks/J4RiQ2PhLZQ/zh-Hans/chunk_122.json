[{"type": "subtitle", "time": 7320.75, "timestamp": "02:02:00", "text": "执行此自动操作"}, {"type": "subtitle", "time": 7324.55, "timestamp": "02:02:04", "text": "那个东西，确保我的AI装置没开。"}, {"type": "subtitle", "time": 7326.99, "timestamp": "02:02:06", "text": "这个东西"}, {"type": "subtitle", "time": 7329.75, "timestamp": "02:02:09", "text": "底部。如果开启了，它会一直开着。"}, {"type": "subtitle", "time": 7333.47, "timestamp": "02:02:13", "text": "与暴徒和周围环境作战"}, {"type": "subtitle", "time": 7336.629, "timestamp": "02:02:16", "text": "暴民。是啊，所以我才不留着它。"}, {"type": "subtitle", "time": 7338.83, "timestamp": "02:02:18", "text": "自动"}, {"type": "subtitle", "time": 7341.91, "timestamp": "02:02:21", "text": "半。务必勾选此项。所以，"}, {"type": "subtitle", "time": 7352.83, "timestamp": "02:02:32", "text": "现在正在播放，我听到的是暗黑破坏神。"}, {"type": "subtitle", "time": 7354.75, "timestamp": "02:02:34", "text": "不朽。"}, {"type": "subtitle", "time": 7357.31, "timestamp": "02:02:37", "text": "呃，我们"}, {"type": "subtitle", "time": 7360.669, "timestamp": "02:02:40", "text": "这是什么？有什么需要注意的吗？"}, {"type": "subtitle", "time": 7362.99, "timestamp": "02:02:42", "text": "下载？不。"}, {"type": "subtitle", "time": 7366.589, "timestamp": "02:02:46", "text": "正确的。放羊的野兽。你好。我将"}, {"type": "subtitle", "time": 7369.99, "timestamp": "02:02:49", "text": "稍微降低《暗黑破坏神：不朽》的音量"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "少量。哦，我会在游戏里做的。"}, {"type": "subtitle", "time": 7376.51, "timestamp": "02:02:56", "text": "我们需要在游戏中实现这一点。"}]
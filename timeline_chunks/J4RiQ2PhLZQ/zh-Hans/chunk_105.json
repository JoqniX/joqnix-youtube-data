[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "玩具或者像两三颗星形水晶"}, {"type": "subtitle", "time": 6305.03, "timestamp": "01:45:05", "text": "透明水晶能赋予他们生命值。"}, {"type": "subtitle", "time": 6307.31, "timestamp": "01:45:07", "text": "攻击力和生命值"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "P. 我相信我没有更多了"}, {"type": "subtitle", "time": 6312.83, "timestamp": "01:45:12", "text": "玩具"}, {"type": "subtitle", "time": 6315.75, "timestamp": "01:45:15", "text": "给。是的，我想我没有任何"}, {"type": "subtitle", "time": 6318.709, "timestamp": "01:45:18", "text": "更多玩具可以送人。是的，我没有"}, {"type": "subtitle", "time": 6322.35, "timestamp": "01:45:22", "text": "还有其他玩具可以送吗？"}, {"type": "subtitle", "time": 6325.99, "timestamp": "01:45:25", "text": "你好。这是什么？发布。你可以"}, {"type": "subtitle", "time": 6329.189, "timestamp": "01:45:29", "text": "把你养的一家子放生到野外。"}, {"type": "subtitle", "time": 6331.709, "timestamp": "01:45:31", "text": "哦，那真是"}, {"type": "subtitle", "time": 6334.39, "timestamp": "01:45:34", "text": "凉爽的。祝您家人生活幸福美满"}, {"type": "subtitle", "time": 6335.37, "timestamp": "01:45:35", "text": "离开之前。"}, {"type": "subtitle", "time": 6336.83, "timestamp": "01:45:36", "text": "[音乐]"}, {"type": "subtitle", "time": 6339.91, "timestamp": "01:45:39", "text": "嗯哼。这样你就能得到豆子去卖了。"}, {"type": "subtitle", "time": 6342.709, "timestamp": "01:45:42", "text": "你可以把它们卖掉之类的。我可以吗？"}, {"type": "subtitle", "time": 6351.95, "timestamp": "01:45:51", "text": "[音乐]"}]
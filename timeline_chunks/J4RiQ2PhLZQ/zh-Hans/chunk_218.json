[{"type": "subtitle", "time": 13086.349, "timestamp": "03:38:06", "text": "还要买那条项链。"}, {"type": "subtitle", "time": 13089.309, "timestamp": "03:38:09", "text": "东西。主要你需要得到"}, {"type": "subtitle", "time": 13092.469, "timestamp": "03:38:12", "text": "项链、戒指和耳环。"}, {"type": "subtitle", "time": 13093.309, "timestamp": "03:38:13", "text": "好的"}, {"type": "subtitle", "time": 13096.87, "timestamp": "03:38:16", "text": "东西。也别忘了提升你的宠物等级。"}, {"type": "subtitle", "time": 13099.349, "timestamp": "03:38:19", "text": "好的。前四位熟悉的明星"}, {"type": "subtitle", "time": 13102.71, "timestamp": "03:38:22", "text": "你已经做到了，再提升一下。所以对你来说，"}, {"type": "subtitle", "time": 13105.83, "timestamp": "03:38:25", "text": "雷米，哦，你走了，对吧？嗯，让我"}, {"type": "subtitle", "time": 13110.269, "timestamp": "03:38:30", "text": "看。因为你的梦想将会是"}, {"type": "subtitle", "time": 13114.469, "timestamp": "03:38:34", "text": "嗯，对你来说，这将是 oros 升级 oros"}, {"type": "subtitle", "time": 13118.87, "timestamp": "03:38:38", "text": "而且可能还要等你拥有了你想要的东西"}, {"type": "subtitle", "time": 13122.99, "timestamp": "03:38:42", "text": "你真是太幸运了，笨蛋，居然有四颗星"}, {"type": "subtitle", "time": 13126.11, "timestamp": "03:38:46", "text": "不错，我拿到了四个"}, {"type": "subtitle", "time": 13129.349, "timestamp": "03:38:49", "text": "不错，所以，升级这些，你需要"}, {"type": "subtitle", "time": 13132.63, "timestamp": "03:38:52", "text": "一条项链，所以我建议这样做"}, {"type": "subtitle", "time": 13136.55, "timestamp": "03:38:56", "text": "嗯……那个……另一个……呃……"}]
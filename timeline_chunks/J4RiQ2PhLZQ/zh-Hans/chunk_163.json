[{"type": "subtitle", "time": 9781.67, "timestamp": "02:43:01", "text": "但他更多地使用触摸传送门，"}, {"type": "subtitle", "time": 9784.23, "timestamp": "02:43:04", "text": "串流板之类的东西，也就是"}, {"type": "subtitle", "time": 9788.389, "timestamp": "02:43:08", "text": "还有一些我还没来得及尝试的东西"}, {"type": "subtitle", "time": 9790.309, "timestamp": "02:43:10", "text": "尤其是触摸传送门，我没搞砸。"}, {"type": "subtitle", "time": 9793.27, "timestamp": "02:43:13", "text": "拿着串流板到处转悠，但不是。"}, {"type": "subtitle", "time": 9797.03, "timestamp": "02:43:17", "text": "就像我投入了很多精力一样"}, {"type": "subtitle", "time": 9800.83, "timestamp": "02:43:20", "text": "把东西塞进莱昂和男孩体内。是的，"}, {"type": "subtitle", "time": 9805.429, "timestamp": "02:43:25", "text": "每当科德做一些疯狂的事情时"}, {"type": "subtitle", "time": 9808.23, "timestamp": "02:43:28", "text": "他的直播激励我做得更多。"}, {"type": "subtitle", "time": 9813.429, "timestamp": "02:43:33", "text": "在我的直播里，因为，呃，因为最近我感觉"}, {"type": "subtitle", "time": 9818.59, "timestamp": "02:43:38", "text": "就像以前一样，呃，烦人的绳子，嗯，毛毡"}, {"type": "subtitle", "time": 9822.87, "timestamp": "02:43:42", "text": "像这样……呃，这就是痛苦。我有……我的"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "缺乏直播的动力和想法"}, {"type": "subtitle", "time": 9828.87, "timestamp": "02:43:48", "text": "东西。通常我会得到我的呃"}, {"type": "subtitle", "time": 9831.269, "timestamp": "02:43:51", "text": "来自大主播的励志内容"}, {"type": "subtitle", "time": 9833.91, "timestamp": "02:43:53", "text": "这样做。其他这样做的主播"}, {"type": "subtitle", "time": 9836.19, "timestamp": "02:43:56", "text": "像纳蒂"}, {"type": "subtitle", "time": 9839.15, "timestamp": "02:43:59", "text": "安琪儿，然后是贝拉"}]
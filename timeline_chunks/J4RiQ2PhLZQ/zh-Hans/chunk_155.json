[{"type": "subtitle", "time": 9301.75, "timestamp": "02:35:01", "text": "眼镜。"}, {"type": "subtitle", "time": 9305.389, "timestamp": "02:35:05", "text": "我当时就想，这就是我选择这么做的原因。"}, {"type": "subtitle", "time": 9308.469, "timestamp": "02:35:08", "text": "现实生活中购买这种眼镜的原因是"}, {"type": "subtitle", "time": 9311.87, "timestamp": "02:35:11", "text": "我喜欢哈利波特里的这个"}, {"type": "subtitle", "time": 9314.79, "timestamp": "02:35:14", "text": "像《哈利·波特》这样的系列作品拥有如此巨大的影响力。"}, {"type": "subtitle", "time": 9317.51, "timestamp": "02:35:17", "text": "圆框眼镜，没错，甚至我也有"}, {"type": "subtitle", "time": 9320.95, "timestamp": "02:35:20", "text": "Nouni 戴着那种大大的圆形眼镜"}, {"type": "subtitle", "time": 9324.71, "timestamp": "02:35:24", "text": "我的性格也是如此。所以我就想，等等，我"}, {"type": "subtitle", "time": 9327.19, "timestamp": "02:35:27", "text": "可以选择塑料材质的，或者"}, {"type": "subtitle", "time": 9328.87, "timestamp": "02:35:28", "text": "金属字体。所以，我选择了"}, {"type": "subtitle", "time": 9331.91, "timestamp": "02:35:31", "text": "金属质感，因为我觉得那是……"}, {"type": "subtitle", "time": 9334.51, "timestamp": "02:35:34", "text": "正是我想要的眼镜，而且有点"}, {"type": "subtitle", "time": 9337.91, "timestamp": "02:35:37", "text": "昂贵的。所以，显然"}, {"type": "subtitle", "time": 9340.71, "timestamp": "02:35:40", "text": "嗯，我买的这个玻璃杯的保修条款"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "所以，呃，那个叫什么来着"}, {"type": "subtitle", "time": 9352.75, "timestamp": "02:35:52", "text": "它？店主或类似"}, {"type": "subtitle", "time": 9357.51, "timestamp": "02:35:57", "text": "看看眼镜店。"}]
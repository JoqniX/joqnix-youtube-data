[{"type": "subtitle", "time": 12843.83, "timestamp": "03:34:03", "text": "嗯，等等，我进入了模式。好的。呃，另一个"}, {"type": "subtitle", "time": 12846.03, "timestamp": "03:34:06", "text": "你可以做的其中一件事是："}, {"type": "subtitle", "time": 12849.51, "timestamp": "03:34:09", "text": "熟悉的东西。去拿鸡蛋。不是"}, {"type": "subtitle", "time": 12852.229, "timestamp": "03:34:12", "text": "蛋。呃，我做不到什么？我忘了。"}, {"type": "subtitle", "time": 12854.389, "timestamp": "03:34:14", "text": "你还能做些什么来获得……还有什么？"}, {"type": "subtitle", "time": 12857.51, "timestamp": "03:34:17", "text": "东西？当你进入人工智能模式时，请使用混沌场。"}, {"type": "subtitle", "time": 12860.309, "timestamp": "03:34:20", "text": "模式。使用能量道具。这是这些"}, {"type": "subtitle", "time": 12861.15, "timestamp": "03:34:21", "text": "是"}, {"type": "subtitle", "time": 12864.15, "timestamp": "03:34:24", "text": "重要的。做一下维度计算。"}, {"type": "subtitle", "time": 12873.07, "timestamp": "03:34:33", "text": "这。买好装备。弄些好装备，"}, {"type": "subtitle", "time": 12876.469, "timestamp": "03:34:36", "text": "升级。嗯，是的，就像喂养老人一样"}, {"type": "subtitle", "time": 12880.11, "timestamp": "03:34:40", "text": "齿轮。不断升级，勇往直前"}, {"type": "subtitle", "time": 12883.11, "timestamp": "03:34:43", "text": "东西。还有什么？如果你有"}, {"type": "subtitle", "time": 12887.03, "timestamp": "03:34:47", "text": "解锁等级 40 或 35、30、40 一些"}, {"type": "subtitle", "time": 12890.55, "timestamp": "03:34:50", "text": "有一些东西，你会解锁一些高难度的星星。"}, {"type": "subtitle", "time": 12892.229, "timestamp": "03:34:52", "text": "你会解锁第一颗星，对吧？"}, {"type": "subtitle", "time": 12896.95, "timestamp": "03:34:56", "text": "你一直在升级这些东西"}]
[{"type": "subtitle", "time": 14945.389, "timestamp": "04:09:05", "text": "谜。地面喷发。"}, {"type": "subtitle", "time": 14948.79, "timestamp": "04:09:08", "text": "哇。好的，我们开始吧。呃，开始"}, {"type": "subtitle", "time": 14952.269, "timestamp": "04:09:12", "text": "配对。单方。"}, {"type": "subtitle", "time": 14956.07, "timestamp": "04:09:16", "text": "接受。我们走吧。 46. 有一个“我是”"}, {"type": "subtitle", "time": 14959.83, "timestamp": "04:09:19", "text": "这里只有46个人。哦好的。再次，"}, {"type": "subtitle", "time": 14961.95, "timestamp": "04:09:21", "text": "我是"}, {"type": "subtitle", "time": 14964.83, "timestamp": "04:09:24", "text": "这"}, {"type": "subtitle", "time": 14968.87, "timestamp": "04:09:28", "text": "N：我们走吧。哦，等等。呃，但是"}, {"type": "subtitle", "time": 14971.15, "timestamp": "04:09:31", "text": "我们应该"}, {"type": "subtitle", "time": 14974.03, "timestamp": "04:09:34", "text": "去"}, {"type": "subtitle", "time": 14981.469, "timestamp": "04:09:41", "text": "黑色的"}, {"type": "subtitle", "time": 14984.309, "timestamp": "04:09:44", "text": "圆圈。黑圈特工。等等，谁？"}, {"type": "subtitle", "time": 14985.79, "timestamp": "04:09:45", "text": "是这些吗？"}, {"type": "subtitle", "time": 14988.469, "timestamp": "04:09:48", "text": "人们？我从未见过这些。是吗？"}, {"type": "subtitle", "time": 14991.11, "timestamp": "04:09:51", "text": "与你将获得的黑暗魔法有关"}]
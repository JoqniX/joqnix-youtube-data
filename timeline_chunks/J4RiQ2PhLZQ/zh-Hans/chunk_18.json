[{"type": "subtitle", "time": 1082.47, "timestamp": "00:18:02", "text": "我不知道。你应该就像那样得到"}, {"type": "subtitle", "time": 1084.95, "timestamp": "00:18:04", "text": "加点Nutella巧克力酱，再放上草莓"}, {"type": "subtitle", "time": 1087.669, "timestamp": "00:18:07", "text": "在其中。这就是判断方法。谢谢"}, {"type": "subtitle", "time": 1090.47, "timestamp": "00:18:10", "text": "谢谢你还记得我。我的……里有Nutella巧克力酱"}, {"type": "subtitle", "time": 1093.95, "timestamp": "00:18:13", "text": "冰箱。我要把它吃掉"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "完全。我当时的感觉就像……"}, {"type": "subtitle", "time": 1100.07, "timestamp": "00:18:20", "text": "忘记了某件事。那可真是件了不起的事。"}, {"type": "subtitle", "time": 1104.31, "timestamp": "00:18:24", "text": "我习惯吃饭。我超爱吃。"}, {"type": "subtitle", "time": 1107.909, "timestamp": "00:18:27", "text": "等等，你是直播烘焙吗？为什么不呢？"}, {"type": "subtitle", "time": 1110.23, "timestamp": "00:18:30", "text": "你不是一个烘焙流，而是一个"}, {"type": "subtitle", "time": 1113.75, "timestamp": "00:18:33", "text": "烘焙视频？我确实像你知道的那样"}, {"type": "subtitle", "time": 1117.029, "timestamp": "00:18:37", "text": "今天我和我哥就像……"}, {"type": "subtitle", "time": 1120.31, "timestamp": "00:18:40", "text": "我付给他200卢比才买到这个独特的东西。"}, {"type": "subtitle", "time": 1124.87, "timestamp": "00:18:44", "text": "奥利奥口味。奥利奥可乐。好的。"}, {"type": "subtitle", "time": 1127.23, "timestamp": "00:18:47", "text": "可口可乐，但奥利奥口味的。而且它"}, {"type": "subtitle", "time": 1130.63, "timestamp": "00:18:50", "text": "尝起来出乎意料地有焦糖味，但仍然"}, {"type": "subtitle", "time": 1134.87, "timestamp": "00:18:54", "text": "同时，就像可口可乐一样。挺好的。"}, {"type": "subtitle", "time": 1138.63, "timestamp": "00:18:58", "text": "所以我和我的哥哥比库就像他一样"}]
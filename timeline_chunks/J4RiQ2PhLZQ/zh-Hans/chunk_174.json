[{"type": "subtitle", "time": 10446.23, "timestamp": "02:54:06", "text": "巨人。显然，你不需要"}, {"type": "subtitle", "time": 10448.63, "timestamp": "02:54:08", "text": "切换频道。你的眼睛感觉如何？"}, {"type": "subtitle", "time": 10459.03, "timestamp": "02:54:19", "text": "现在。这就是你的老板，你将在这里"}, {"type": "subtitle", "time": 10466.95, "timestamp": "02:54:26", "text": "即刻。我的天啊，你千万别去"}, {"type": "subtitle", "time": 10468.349, "timestamp": "02:54:28", "text": "红色"}, {"type": "subtitle", "time": 10479.03, "timestamp": "02:54:39", "text": "为什么？人很多。我看到一个"}, {"type": "subtitle", "time": 10493.15, "timestamp": "02:54:53", "text": "躲闪。他不是"}, {"type": "subtitle", "time": 10496.67, "timestamp": "02:54:56", "text": "完毕。有一次大满贯"}]
[{"type": "subtitle", "time": 9541.309, "timestamp": "02:39:01", "text": "我不认识的社区"}, {"type": "subtitle", "time": 9544.87, "timestamp": "02:39:04", "text": "尤其值得一提的是，我确实提到过"}, {"type": "subtitle", "time": 9547.23, "timestamp": "02:39:07", "text": "昨天在 Twitch 上直播了。"}, {"type": "subtitle", "time": 9551.27, "timestamp": "02:39:11", "text": "就像是因为YouTube开始兴起的"}, {"type": "subtitle", "time": 9554.63, "timestamp": "02:39:14", "text": "就像 YouTube 最近开始制作"}, {"type": "subtitle", "time": 9557.63, "timestamp": "02:39:17", "text": "直播流 API 的变更"}, {"type": "subtitle", "time": 9560.309, "timestamp": "02:39:20", "text": "所以它什么都没有，大部分"}, {"type": "subtitle", "time": 9564.15, "timestamp": "02:39:24", "text": "Twitch 等平台的功能就像什么？"}, {"type": "subtitle", "time": 9565.91, "timestamp": "02:39:25", "text": "我们是否有在里面"}, {"type": "subtitle", "time": 9568.469, "timestamp": "02:39:28", "text": "互动式的，呃，你管它叫什么来着？"}, {"type": "subtitle", "time": 9571.87, "timestamp": "02:39:31", "text": "触摸装置。它在哪儿？在哪里？"}, {"type": "subtitle", "time": 9586.87, "timestamp": "02:39:46", "text": "按钮？所以，无论你何时触摸任何地方"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "像这样的屏幕，你可以喂食"}, {"type": "subtitle", "time": 9592.63, "timestamp": "02:39:52", "text": "猫喜欢这样。而这只有一种可能。"}, {"type": "subtitle", "time": 9595.19, "timestamp": "02:39:55", "text": "目前在 Twitch 上"}, {"type": "subtitle", "time": 9598.55, "timestamp": "02:39:58", "text": "视频播放器。这是不可能的"}]
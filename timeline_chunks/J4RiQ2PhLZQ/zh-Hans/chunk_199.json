[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "魔法"}, {"type": "subtitle", "time": 11945.349, "timestamp": "03:19:05", "text": "非常好。我想我需要一个"}, {"type": "subtitle", "time": 11948.59, "timestamp": "03:19:08", "text": "需要付出很多努力才能获得"}, {"type": "subtitle", "time": 11952.87, "timestamp": "03:19:12", "text": "那里。等等，我相信肖恩有这个东西，或者"}, {"type": "subtitle", "time": 11956.03, "timestamp": "03:19:16", "text": "某物。我看到有人穿着深色衣服。"}, {"type": "subtitle", "time": 11959.75, "timestamp": "03:19:19", "text": "魔法。忘了是谁了。是的，他确实如此。"}, {"type": "subtitle", "time": 11963.51, "timestamp": "03:19:23", "text": "它。看看这些星星。他真是太……"}, {"type": "subtitle", "time": 11969.83, "timestamp": "03:19:29", "text": "陷阱。是的。昨天我看到"}, {"type": "subtitle", "time": 11979.11, "timestamp": "03:19:39", "text": "他们必须解开黑暗之门。"}, {"type": "subtitle", "time": 11980.95, "timestamp": "03:19:40", "text": "他们的武器上会有魔法之类的东西。我当时"}, {"type": "subtitle", "time": 11982.429, "timestamp": "03:19:42", "text": "这到底是什么鬼东西？"}, {"type": "subtitle", "time": 11984.79, "timestamp": "03:19:44", "text": "那种黑暗魔法？娜妮"}, {"type": "subtitle", "time": 11990.59, "timestamp": "03:19:50", "text": "娜妮。"}, {"type": "subtitle", "time": 11993.87, "timestamp": "03:19:53", "text": "是的。我们可以这样做，家人之间可以这样相处。"}, {"type": "subtitle", "time": 11996.93, "timestamp": "03:19:56", "text": "一。是的。我们能做到。"}]
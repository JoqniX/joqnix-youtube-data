[{"type": "subtitle", "time": 7680.95, "timestamp": "02:08:00", "text": "我不会让你抢走我的猎物。哦，"}, {"type": "subtitle", "time": 7682.629, "timestamp": "02:08:02", "text": "他是我的。他是我的。他是我的。他是"}, {"type": "subtitle", "time": 7685.589, "timestamp": "02:08:05", "text": "矿。喂。喂。喂。走开。难道你不这么认为吗？"}, {"type": "subtitle", "time": 7688.35, "timestamp": "02:08:08", "text": "带走他。他是"}, {"type": "subtitle", "time": 7696.229, "timestamp": "02:08:16", "text": "被偷走了。抱歉，如果我做不到。"}, {"type": "subtitle", "time": 7698.629, "timestamp": "02:08:18", "text": "这次话真不少。嗯，我有点累了。"}, {"type": "subtitle", "time": 7700.87, "timestamp": "02:08:20", "text": "此刻，我保持沉默。我 我"}, {"type": "subtitle", "time": 7703.75, "timestamp": "02:08:23", "text": "很高兴来到这里。都是K。你做的"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "哦，体验地球仪。我需要那个。"}, {"type": "subtitle", "time": 7725.229, "timestamp": "02:08:45", "text": "15"}, {"type": "subtitle", "time": 7726.83, "timestamp": "02:08:46", "text": "金子。"}, {"type": "subtitle", "time": 7729.83, "timestamp": "02:08:49", "text": "好的。哦，我们找到了一支铅笔。我们得到了"}, {"type": "subtitle", "time": 7731.629, "timestamp": "02:08:51", "text": "铅笔。"}]
[{"type": "subtitle", "time": 11581.71, "timestamp": "03:13:01", "text": "事物。让我拿一个"}, {"type": "subtitle", "time": 11585.389, "timestamp": "03:13:05", "text": "放了它。什么？我抽到了谁？"}, {"type": "subtitle", "time": 11590.349, "timestamp": "03:13:10", "text": "小不点儿。我会给你这个"}, {"type": "subtitle", "time": 11593.79, "timestamp": "03:13:13", "text": "事物。嗯？等待。驯服失败。"}, {"type": "subtitle", "time": 11596.55, "timestamp": "03:13:16", "text": "喂。我并不是想要你什么。我"}, {"type": "subtitle", "time": 11604.23, "timestamp": "03:13:24", "text": "喂养。好的。乔得走了。这一切都是"}, {"type": "subtitle", "time": 11606.469, "timestamp": "03:13:26", "text": "是时候出发了。呃，"}, {"type": "subtitle", "time": 11609.309, "timestamp": "03:13:29", "text": "小心。玩得开心。下次。"}, {"type": "subtitle", "time": 11614.59, "timestamp": "03:13:34", "text": "你好。你好。亲爱的，保重。而且温暖"}, {"type": "subtitle", "time": 11617.19, "timestamp": "03:13:37", "text": "头。我没有语音命令功能"}, {"type": "subtitle", "time": 11620.55, "timestamp": "03:13:40", "text": "但是，我必须手动操作。所以，"}, {"type": "subtitle", "time": 11637.91, "timestamp": "03:13:57", "text": "土堆。"}]
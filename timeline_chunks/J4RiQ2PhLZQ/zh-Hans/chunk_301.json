[{"type": "subtitle", "time": 18061.07, "timestamp": "05:01:01", "text": "哇。我们与……交谈"}, {"type": "subtitle", "time": 18064.31, "timestamp": "05:01:04", "text": "我们直接和本人交谈。"}, {"type": "subtitle", "time": 18078.15, "timestamp": "05:01:18", "text": "一。真酷。实际上"}, {"type": "subtitle", "time": 18080.868, "timestamp": "05:01:20", "text": "凉爽的。"}, {"type": "subtitle", "time": 18081.788, "timestamp": "05:01:21", "text": "辉光"}, {"type": "subtitle", "time": 18093.47, "timestamp": "05:01:33", "text": "更"}, {"type": "subtitle", "time": 18097.19, "timestamp": "05:01:37", "text": "月光？我想念内森·莫。我也是。我"}, {"type": "subtitle", "time": 18099.23, "timestamp": "05:01:39", "text": "希望他一切安好"}, {"type": "subtitle", "time": 18104.07, "timestamp": "05:01:44", "text": "出色地。这家伙工作真辛苦。希望他"}]
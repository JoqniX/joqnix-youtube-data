[{"type": "subtitle", "time": 15732.63, "timestamp": "04:22:12", "text": "好的。我一会儿要去玩障碍赛了。"}, {"type": "subtitle", "time": 15735.59, "timestamp": "04:22:15", "text": "我希望我能把蟑螂弄出去，这样他"}, {"type": "subtitle", "time": 15738.389, "timestamp": "04:22:18", "text": "不会飞到我的脚上。如果他真的这么做了，"}, {"type": "subtitle", "time": 15740.99, "timestamp": "04:22:20", "text": "我其实"}, {"type": "subtitle", "time": 15743.79, "timestamp": "04:22:23", "text": "去"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "砰。我找不到他。别走。在哪里"}, {"type": "subtitle", "time": 15751.309, "timestamp": "04:22:31", "text": "你去了哪里？"}, {"type": "subtitle", "time": 15761.11, "timestamp": "04:22:41", "text": "[音乐]"}, {"type": "subtitle", "time": 15771.75, "timestamp": "04:22:51", "text": "好的。哦，又一个。好的，我来做一个。"}]
[{"type": "subtitle", "time": 15068.71, "timestamp": "04:11:08", "text": "她甚至都没在做“她”这个动作。"}, {"type": "subtitle", "time": 15073.15, "timestamp": "04:11:13", "text": "有时候会突然开枪。滚开。他妈的"}, {"type": "subtitle", "time": 15076.71, "timestamp": "04:11:16", "text": "离开。但因为你是红头发，我会"}, {"type": "subtitle", "time": 15097.59, "timestamp": "04:11:37", "text": "[音乐]"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "可爱的？故事进展到这一步。我是"}, {"type": "subtitle", "time": 15119.15, "timestamp": "04:11:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 18374.948, "timestamp": "05:06:14", "text": "布丁。我喜欢布丁，因为就像我的"}, {"type": "subtitle", "time": 18377.91, "timestamp": "05:06:17", "text": "妈妈以前总是做布丁。鸡蛋"}, {"type": "subtitle", "time": 18379.628, "timestamp": "05:06:19", "text": "布丁"}, {"type": "subtitle", "time": 18386.708, "timestamp": "05:06:26", "text": "每当有客人来的时候，她总是这样。"}, {"type": "subtitle", "time": 18389.15, "timestamp": "05:06:29", "text": "总是"}, {"type": "subtitle", "time": 18392.948, "timestamp": "05:06:32", "text": "布丁。就像她那样，她告诉"}, {"type": "subtitle", "time": 18395.91, "timestamp": "05:06:35", "text": "爸爸去买香草精"}, {"type": "subtitle", "time": 18398.55, "timestamp": "05:06:38", "text": "所有必需的原料"}, {"type": "subtitle", "time": 18404.03, "timestamp": "05:06:44", "text": "正在制作中。她经常做。"}]
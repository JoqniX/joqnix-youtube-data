[{"type": "subtitle", "time": 253.589, "timestamp": "00:04:13", "text": "不，这太难了。我在这方面很差劲"}, {"type": "subtitle", "time": 256.11, "timestamp": "00:04:16", "text": "吞咽任何东西"}, {"type": "subtitle", "time": 261.27, "timestamp": "00:04:21", "text": "对我来说，这才是真正的戏剧。没关系。合法的"}, {"type": "subtitle", "time": 262.95, "timestamp": "00:04:22", "text": "戏剧。"}, {"type": "subtitle", "time": 264.99, "timestamp": "00:04:24", "text": "不，没关系。我们得到了"}, {"type": "subtitle", "time": 267.55, "timestamp": "00:04:27", "text": "这。我会指导你。"}, {"type": "subtitle", "time": 282.27, "timestamp": "00:04:42", "text": "哦，是的。我"}, {"type": "subtitle", "time": 286.31, "timestamp": "00:04:46", "text": "哦，给我看看。现在是不是太晚了？是的，它"}, {"type": "subtitle", "time": 288.87, "timestamp": "00:04:48", "text": "迟到了。这将是我们最后一次见面了，我"}, {"type": "subtitle", "time": 292.71, "timestamp": "00:04:52", "text": "猜测。不，我做不到。哦，我只是"}, {"type": "subtitle", "time": 294.629, "timestamp": "00:04:54", "text": "这样做。嗯，我明白了。简单方法。"}, {"type": "subtitle", "time": 298.23, "timestamp": "00:04:58", "text": "简单方法。呃，把它折起来。直接"}]
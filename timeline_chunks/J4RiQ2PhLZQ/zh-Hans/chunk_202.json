[{"type": "subtitle", "time": 12121.95, "timestamp": "03:22:01", "text": "秒。是的，小子。 Y 男孩。是的"}, {"type": "subtitle", "time": 12125.71, "timestamp": "03:22:05", "text": "男生。哦，我们死了50人。"}, {"type": "subtitle", "time": 12128.91, "timestamp": "03:22:08", "text": "好的。好的。这个人。"}, {"type": "subtitle", "time": 12131.429, "timestamp": "03:22:11", "text": "哦，拜托告诉我我们能拿到三星！"}, {"type": "subtitle", "time": 12137.83, "timestamp": "03:22:17", "text": "如果我再见到他们，我一定会好好教训他们。"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "哦，三星级。好，好，好，好。"}, {"type": "subtitle", "time": 12152.59, "timestamp": "03:22:32", "text": "好的。第五层已解锁。我们开始吧"}, {"type": "subtitle", "time": 12156.63, "timestamp": "03:22:36", "text": "去。我以后只会做第四级。"}, {"type": "subtitle", "time": 12159.59, "timestamp": "03:22:39", "text": "因为这是我能达到的最高高度了。我们"}, {"type": "subtitle", "time": 12164.309, "timestamp": "03:22:44", "text": "再次挑战。启动。我们会做"}, {"type": "subtitle", "time": 12166.55, "timestamp": "03:22:46", "text": "这次是火神殿，因为我还没去过。"}, {"type": "subtitle", "time": 12169.59, "timestamp": "03:22:49", "text": "根本就是火神庙。我们需要"}, {"type": "subtitle", "time": 12170.349, "timestamp": "03:22:50", "text": "得到"}, {"type": "subtitle", "time": 12179.269, "timestamp": "03:22:59", "text": "三。耽误。英语VA。是的，英语"}]
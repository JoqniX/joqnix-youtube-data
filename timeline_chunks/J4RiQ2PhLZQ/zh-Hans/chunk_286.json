[{"type": "subtitle", "time": 17162.99, "timestamp": "04:46:02", "text": "去。我希望你也参加了我们的"}, {"type": "subtitle", "time": 17166.31, "timestamp": "04:46:06", "text": "图片。回忆。"}, {"type": "subtitle", "time": 17171.99, "timestamp": "04:46:11", "text": "oro。我的思绪一片混乱。"}, {"type": "subtitle", "time": 17176.27, "timestamp": "04:46:16", "text": "莫，发生什么事了？村里，你们想要"}, {"type": "subtitle", "time": 17205.75, "timestamp": "04:46:45", "text": "我今天打算走这条路线。嗨，拿"}, {"type": "subtitle", "time": 17208.67, "timestamp": "04:46:48", "text": "[音乐]"}, {"type": "subtitle", "time": 17211.15, "timestamp": "04:46:51", "text": "护理和"}, {"type": "subtitle", "time": 17215.03, "timestamp": "04:46:55", "text": "头，然后我就挂机去拿我的"}, {"type": "subtitle", "time": 17218.11, "timestamp": "04:46:58", "text": "吃完晚饭就回来。"}]
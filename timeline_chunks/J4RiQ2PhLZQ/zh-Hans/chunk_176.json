[{"type": "subtitle", "time": 10562.23, "timestamp": "02:56:02", "text": "他打算向前推进。所以，我们"}, {"type": "subtitle", "time": 10563.87, "timestamp": "02:56:03", "text": "有时间"}, {"type": "subtitle", "time": 10569.11, "timestamp": "02:56:09", "text": "那个人的生命值会在一段时间后自动恢复。"}, {"type": "subtitle", "time": 10570.11, "timestamp": "02:56:10", "text": "小的"}, {"type": "subtitle", "time": 10579.23, "timestamp": "02:56:19", "text": "普通的"}, {"type": "subtitle", "time": 10582.15, "timestamp": "02:56:22", "text": "躲闪。这就是为什么这件事如此难以做到。"}, {"type": "subtitle", "time": 10585.19, "timestamp": "02:56:25", "text": "老板。大家都在做什么？"}, {"type": "subtitle", "time": 10586.51, "timestamp": "02:56:26", "text": "频道"}, {"type": "subtitle", "time": 10588.87, "timestamp": "02:56:28", "text": "服务器？ 3频道和7频道是"}, {"type": "subtitle", "time": 10591.349, "timestamp": "02:56:31", "text": "完毕。哦，等等。躲闪，躲闪，躲闪。"}, {"type": "subtitle", "time": 10593.87, "timestamp": "02:56:33", "text": "好的。躲避得真漂亮！"}, {"type": "subtitle", "time": 10597.269, "timestamp": "02:56:37", "text": "乔克。 4频道、7频道、3频道是"}, {"type": "subtitle", "time": 10599.469, "timestamp": "02:56:39", "text": "我死了。起床，"}, {"type": "subtitle", "time": 10602.15, "timestamp": "02:56:42", "text": "请。所以，你立刻行动起来"}, {"type": "subtitle", "time": 10604.429, "timestamp": "02:56:44", "text": "像这样传送并自动"}, {"type": "subtitle", "time": 10609.03, "timestamp": "02:56:49", "text": "攻击。我又死了一次。立即执行此操作。"}, {"type": "subtitle", "time": 10611.07, "timestamp": "02:56:51", "text": "你必须快。"}, {"type": "subtitle", "time": 10614.71, "timestamp": "02:56:54", "text": "快得惊人。你必须超级"}, {"type": "subtitle", "time": 10617.469, "timestamp": "02:56:57", "text": "快得要死，所以你不会"}]
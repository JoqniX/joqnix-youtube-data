[{"type": "subtitle", "time": 1920.509, "timestamp": "00:32:00", "text": "陪我们一起制作纸工艺品"}, {"type": "subtitle", "time": 1922.99, "timestamp": "00:32:02", "text": "一切？很有趣。"}, {"type": "subtitle", "time": 1925.83, "timestamp": "00:32:05", "text": "正确的？祖琪尽力了。所以，我是"}, {"type": "subtitle", "time": 1935.59, "timestamp": "00:32:15", "text": "最好的。下次我想做某事的时候"}, {"type": "subtitle", "time": 1939.43, "timestamp": "00:32:19", "text": "呃，该怎么办呢？提出一些你认为可行的建议吧。"}, {"type": "subtitle", "time": 1951.63, "timestamp": "00:32:31", "text": "手。是的，很好。它是"}, {"type": "subtitle", "time": 1954.149, "timestamp": "00:32:34", "text": "好的。接下来我想做的就是……"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "真的会跳手指舞，就像……"}, {"type": "subtitle", "time": 1959.83, "timestamp": "00:32:39", "text": "手指挑逗之类的。"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "但是，嗯，因为我实际上会花很多时间。"}, {"type": "subtitle", "time": 1966.149, "timestamp": "00:32:46", "text": "这些东西，呃，这两个，值得投资。"}, {"type": "subtitle", "time": 1970.23, "timestamp": "00:32:50", "text": "工具、素描笔和彩色铅笔，"}, {"type": "subtitle", "time": 1972.43, "timestamp": "00:32:52", "text": "我们将这样做"}, {"type": "subtitle", "time": 1975.35, "timestamp": "00:32:55", "text": "嗯，涂色之类的。我不知道我是否"}, {"type": "subtitle", "time": 1977.95, "timestamp": "00:32:57", "text": "应该上色"}]
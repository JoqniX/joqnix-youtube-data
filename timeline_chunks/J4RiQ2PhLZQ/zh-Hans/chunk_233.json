[{"type": "subtitle", "time": 14001.95, "timestamp": "03:53:21", "text": "来"}, {"type": "subtitle", "time": 14004.59, "timestamp": "03:53:24", "text": "在。别弄错"}, {"type": "subtitle", "time": 14013.63, "timestamp": "03:53:33", "text": "所以，我几乎得到了所有的一切。"}, {"type": "subtitle", "time": 14016.55, "timestamp": "03:53:36", "text": "四星武器，对吧？我明白了，我需要"}, {"type": "subtitle", "time": 14019.95, "timestamp": "03:53:39", "text": "像水一样，第四颗星，只有光"}, {"type": "subtitle", "time": 14024.189, "timestamp": "03:53:44", "text": "四星级。是的，我拿到了暗四星"}, {"type": "subtitle", "time": 14028.389, "timestamp": "03:53:48", "text": "嗯，自然与火焰，四星。我只是"}, {"type": "subtitle", "time": 14030.87, "timestamp": "03:53:50", "text": "需要水和光，四星，我是"}]
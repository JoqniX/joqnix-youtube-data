[{"type": "subtitle", "time": 11043.75, "timestamp": "03:04:03", "text": "知道。夹具反。这就像一个古老的“这是”"}, {"type": "subtitle", "time": 11048.11, "timestamp": "03:04:08", "text": "就像一个大反派。但你称之为"}, {"type": "subtitle", "time": 11052.349, "timestamp": "03:04:12", "text": "巨物。巨人"}, {"type": "subtitle", "time": 11061.429, "timestamp": "03:04:21", "text": "男生。你好。我们可以去冒险。"}, {"type": "subtitle", "time": 11066.99, "timestamp": "03:04:26", "text": "相信。正确的。我们有一个，呃，170"}, {"type": "subtitle", "time": 11070.269, "timestamp": "03:04:30", "text": "某物。嗯，我没有票。"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "很痛，对吧？法典。标题中我"}, {"type": "subtitle", "time": 11077.11, "timestamp": "03:04:37", "text": "我们说过会做这件事，对吧？"}, {"type": "subtitle", "time": 11078.95, "timestamp": "03:04:38", "text": "是剧情任务吧？所以我们会讲这个故事。"}, {"type": "subtitle", "time": 11081.03, "timestamp": "03:04:41", "text": "寻求。"}, {"type": "subtitle", "time": 11091.11, "timestamp": "03:04:51", "text": "如果我没记错的话，甘地也参与了这场游戏"}, {"type": "subtitle", "time": 11093.51, "timestamp": "03:04:53", "text": "有一部动画电影，或者说一些……可惜的是，它……"}, {"type": "subtitle", "time": 11095.83, "timestamp": "03:04:55", "text": "我的警惕法律还没有监视我，我也"}, {"type": "subtitle", "time": 11097.349, "timestamp": "03:04:57", "text": "还没看，但是有一部"}]
[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "死的。好的。也就是说，我们得到了我们的"}, {"type": "subtitle", "time": 5524.03, "timestamp": "01:32:04", "text": "三次机会。"}, {"type": "subtitle", "time": 5527.91, "timestamp": "01:32:07", "text": "出口。我相信，到现在我们已经……"}, {"type": "subtitle", "time": 5530.27, "timestamp": "01:32:10", "text": "完成了我们的风格"}, {"type": "subtitle", "time": 5533.31, "timestamp": "01:32:13", "text": "寻求。认领此信息。宣称"}, {"type": "subtitle", "time": 5535.31, "timestamp": "01:32:15", "text": "[音乐]"}, {"type": "subtitle", "time": 5539.75, "timestamp": "01:32:19", "text": "这。啊，我们终于完成了。你好。宣称"}, {"type": "subtitle", "time": 5540.99, "timestamp": "01:32:20", "text": "那。"}, {"type": "subtitle", "time": 5544.95, "timestamp": "01:32:24", "text": "完毕。我们得到了什么？我们得到了什么？"}, {"type": "subtitle", "time": 5546.95, "timestamp": "01:32:26", "text": "配料袋，对吧？所以，我们开始吧"}, {"type": "subtitle", "time": 5549.07, "timestamp": "01:32:29", "text": "我们的原料"}, {"type": "subtitle", "time": 5552.59, "timestamp": "01:32:32", "text": "小袋。是的，鸡蛋。感谢"}, {"type": "subtitle", "time": 5556.91, "timestamp": "01:32:36", "text": "你。我们得到了奖励。好的，"}, {"type": "subtitle", "time": 5559.55, "timestamp": "01:32:39", "text": "好的。我们做了什么"}, {"type": "subtitle", "time": 5571.43, "timestamp": "01:32:51", "text": "这是什么？这些都是精选的，"}, {"type": "subtitle", "time": 5574.709, "timestamp": "01:32:54", "text": "正确的？好的。好的。我们会这么做。"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "是的。你好，罗伯特·杰克逊。我错过了"}, {"type": "subtitle", "time": 5578.95, "timestamp": "01:32:58", "text": "你。你好吗？希望你一切顺利"}]
[{"type": "subtitle", "time": 9960.71, "timestamp": "02:46:00", "text": "完毕。我可以稍后再谈这个问题，我"}, {"type": "subtitle", "time": 9963.11, "timestamp": "02:46:03", "text": "相信。"}, {"type": "subtitle", "time": 9967.07, "timestamp": "02:46:07", "text": "打败迪奥。最后"}, {"type": "subtitle", "time": 9970.63, "timestamp": "02:46:10", "text": "倒计时5分钟。我正在看"}, {"type": "subtitle", "time": 9973.87, "timestamp": "02:46:13", "text": "我的计时器结束了"}, {"type": "subtitle", "time": 9976.55, "timestamp": "02:46:16", "text": "这里。所以，关于这个领域，最重要的是……"}, {"type": "subtitle", "time": 9979.59, "timestamp": "02:46:19", "text": "对付boss，你必须快速传送。"}, {"type": "subtitle", "time": 9988.71, "timestamp": "02:46:28", "text": "快速地。必须快。这是主要问题。"}, {"type": "subtitle", "time": 9998.87, "timestamp": "02:46:38", "text": "哦，这个人。这是我需要的"}, {"type": "subtitle", "time": 10000.75, "timestamp": "02:46:40", "text": "杀，而不是其他"}, {"type": "subtitle", "time": 10003.87, "timestamp": "02:46:43", "text": "一。所以，我只会针对这个目标。"}, {"type": "subtitle", "time": 10005.95, "timestamp": "02:46:45", "text": "手动，我"}, {"type": "subtitle", "time": 10013.03, "timestamp": "02:46:53", "text": "一。稍等片刻。我这就来接你。"}, {"type": "subtitle", "time": 10015.51, "timestamp": "02:46:55", "text": "你好。哦，等等。我们可以一起狂欢，雷米，如果"}, {"type": "subtitle", "time": 10017.83, "timestamp": "02:46:57", "text": "您现在正在登录……"}]
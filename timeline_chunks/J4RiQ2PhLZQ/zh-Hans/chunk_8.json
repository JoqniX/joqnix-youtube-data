[{"type": "subtitle", "time": 480.35, "timestamp": "00:08:00", "text": "故障一。我直播玩俄罗斯方块"}, {"type": "subtitle", "time": 485.51, "timestamp": "00:08:05", "text": "四月 二月十四日。那很好笑。"}, {"type": "subtitle", "time": 488.07, "timestamp": "00:08:08", "text": "哇。哦，是的。这里有沙地灯鱼和"}, {"type": "subtitle", "time": 490.629, "timestamp": "00:08:10", "text": "东西，对吧？不。"}, {"type": "subtitle", "time": 494.469, "timestamp": "00:08:14", "text": "我还没玩过。"}, {"type": "subtitle", "time": 496.95, "timestamp": "00:08:16", "text": "我的身体一直不太好。所以，我还没有"}, {"type": "subtitle", "time": 497.95, "timestamp": "00:08:17", "text": "真的"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "今天是我真正坐下来的日子"}, {"type": "subtitle", "time": 501.869, "timestamp": "00:08:21", "text": "我的"}, {"type": "subtitle", "time": 506.07, "timestamp": "00:08:26", "text": "几天后电脑就出问题了，你知道的。呃"}, {"type": "subtitle", "time": 508.869, "timestamp": "00:08:28", "text": "退出流媒体播放。我一直没用"}, {"type": "subtitle", "time": 511.99, "timestamp": "00:08:31", "text": "我的电脑用来做任何事，因为我一直"}, {"type": "subtitle", "time": 515.909, "timestamp": "00:08:35", "text": "真的就像一直躺在床上一样，因为"}, {"type": "subtitle", "time": 518.509, "timestamp": "00:08:38", "text": "我最近好像来月经了。"}, {"type": "subtitle", "time": 528.31, "timestamp": "00:08:48", "text": "疲劳的。我拔了智齿。"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "当时需要做手术，所以我做不了。"}, {"type": "subtitle", "time": 534.55, "timestamp": "00:08:54", "text": "说实话，真的什么都可以。"}]
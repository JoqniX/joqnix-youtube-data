[{"type": "subtitle", "time": 5762.72, "timestamp": "01:36:02", "text": "一。你好。做"}, {"type": "subtitle", "time": 5765.75, "timestamp": "01:36:05", "text": "[掌声]"}, {"type": "subtitle", "time": 5767.149, "timestamp": "01:36:07", "text": "我们来吧"}, {"type": "subtitle", "time": 5771.27, "timestamp": "01:36:11", "text": "去。观看并学习。观看并学习。"}, {"type": "subtitle", "time": 5775.229, "timestamp": "01:36:15", "text": "这就像……宝可梦对战一样"}, {"type": "subtitle", "time": 5783.83, "timestamp": "01:36:23", "text": "我的天哪。我的家人正在做"}, {"type": "subtitle", "time": 5788.35, "timestamp": "01:36:28", "text": "损失惨重。看看他们。我怎么样"}, {"type": "subtitle", "time": 5791.39, "timestamp": "01:36:31", "text": "我？还剩最后一个。"}, {"type": "subtitle", "time": 5794.83, "timestamp": "01:36:34", "text": "苏啊，他去世了。它是"}, {"type": "subtitle", "time": 5809.03, "timestamp": "01:36:49", "text": "你好。太好了。我喜欢这个跳跃"}, {"type": "subtitle", "time": 5811.75, "timestamp": "01:36:51", "text": "帧停止装置。慢动作之类的。"}]
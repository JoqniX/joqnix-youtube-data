[{"type": "subtitle", "time": 903.35, "timestamp": "00:15:03", "text": "猜猜看，然后学习如何去做。折叠"}, {"type": "subtitle", "time": 905.4, "timestamp": "00:15:05", "text": "底部角落内侧"}, {"type": "subtitle", "time": 911.11, "timestamp": "00:15:11", "text": "狗。"}, {"type": "subtitle", "time": 912.28, "timestamp": "00:15:12", "text": "是的。"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "[音乐]"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "你怎么还住在离那里很近的地方？"}, {"type": "subtitle", "time": 921.59, "timestamp": "00:15:21", "text": "我一直？是的。那是什么问题？"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "里面有护士。是的，我也是。"}, {"type": "subtitle", "time": 927.829, "timestamp": "00:15:27", "text": "我的出生地。"}, {"type": "subtitle", "time": 931.509, "timestamp": "00:15:31", "text": "我当时就站在乔家门前。"}, {"type": "subtitle", "time": 934.47, "timestamp": "00:15:34", "text": "好的。我在更衣室里哭了起来。"}, {"type": "subtitle", "time": 937.509, "timestamp": "00:15:37", "text": "因为我当时就在房间里"}, {"type": "subtitle", "time": 939.91, "timestamp": "00:15:39", "text": "他的房子。"}, {"type": "subtitle", "time": 942.23, "timestamp": "00:15:42", "text": "但我们根本无法见面。"}, {"type": "subtitle", "time": 945.03, "timestamp": "00:15:45", "text": "像发高烧一样。"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "啊，是啊，我当时发烧了。"}, {"type": "subtitle", "time": 951.03, "timestamp": "00:15:51", "text": "天。啊，当时下着雨，我没有"}, {"type": "subtitle", "time": 955.269, "timestamp": "00:15:55", "text": "就因为这个，就想让那个运动员冲过来"}, {"type": "subtitle", "time": 958.47, "timestamp": "00:15:58", "text": "你知道我们已经见过面了。"}, {"type": "subtitle", "time": 959.389, "timestamp": "00:15:59", "text": "贫穷的"}]
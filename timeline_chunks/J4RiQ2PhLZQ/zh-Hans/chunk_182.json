[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "因为它会赶上你"}, {"type": "subtitle", "time": 10924.23, "timestamp": "03:02:04", "text": "麦克风会捕捉到音频，所以"}, {"type": "subtitle", "time": 10927.83, "timestamp": "03:02:07", "text": "很遗憾，耳机没有这个选项。"}, {"type": "subtitle", "time": 10930.67, "timestamp": "03:02:10", "text": "我当时正打算买那个。"}, {"type": "subtitle", "time": 10936.15, "timestamp": "03:02:16", "text": "但我当时想，我能做到吗？"}, {"type": "subtitle", "time": 10938.309, "timestamp": "03:02:18", "text": "我想要那款耳机式手机。"}, {"type": "subtitle", "time": 10940.03, "timestamp": "03:02:20", "text": "使用"}, {"type": "subtitle", "time": 10943.95, "timestamp": "03:02:23", "text": "嗯，我能听到类似3D空间的效果。"}, {"type": "subtitle", "time": 10947.349, "timestamp": "03:02:27", "text": "声音的。所以我就想，我该怎么办？"}, {"type": "subtitle", "time": 10950.269, "timestamp": "03:02:30", "text": "我应该怎么办？我应该怎么做？"}, {"type": "subtitle", "time": 10954.15, "timestamp": "03:02:34", "text": "做？因为我戴的耳机耳朵"}, {"type": "subtitle", "time": 10956.87, "timestamp": "03:02:36", "text": "那一刻，或者我戴着的耳机"}, {"type": "subtitle", "time": 10960.87, "timestamp": "03:02:40", "text": "具有3D音效。这样我才能正确地"}, {"type": "subtitle", "time": 10963.91, "timestamp": "03:02:43", "text": "在循环前沿听到并与"}, {"type": "subtitle", "time": 10967.67, "timestamp": "03:02:47", "text": "其他游戏涉及音频方面。"}, {"type": "subtitle", "time": 10970.87, "timestamp": "03:02:50", "text": "但是，是的，我有点担心如果我使用"}, {"type": "subtitle", "time": 10973.91, "timestamp": "03:02:53", "text": "戴耳机可以吗？我以为我"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "至少要用罗技G系列的。呃，什么？"}]
[{"type": "subtitle", "time": 16620.869, "timestamp": "04:37:00", "text": "光敏感。所以我想，嗯……"}, {"type": "subtitle", "time": 16624.07, "timestamp": "04:37:04", "text": "我最后问狗狗：“我愿意吗？”"}, {"type": "subtitle", "time": 16627.189, "timestamp": "04:37:07", "text": "我有类似畏光症的症状，她说我"}, {"type": "subtitle", "time": 16631.67, "timestamp": "04:37:11", "text": "确实有点，我有点，因为她呃，因为"}, {"type": "subtitle", "time": 16633.949, "timestamp": "04:37:13", "text": "我确实对光线敏感。"}, {"type": "subtitle", "time": 16639.109, "timestamp": "04:37:19", "text": "问题是我看不见强光。"}, {"type": "subtitle", "time": 16643.429, "timestamp": "04:37:23", "text": "所以大多数时候我都会用“呃”。"}, {"type": "subtitle", "time": 16646.949, "timestamp": "04:37:26", "text": "这个。我把它保持成橙色的样子"}, {"type": "subtitle", "time": 16649.39, "timestamp": "04:37:29", "text": "这真的"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "橙色的。我的手机里一直存着你"}, {"type": "subtitle", "time": 16655.67, "timestamp": "04:37:35", "text": "亮度调至极低并保持开机状态"}, {"type": "subtitle", "time": 16658.709, "timestamp": "04:37:38", "text": "深色模式。不，切换到深色模式。所以它会"}, {"type": "subtitle", "time": 16660.83, "timestamp": "04:37:40", "text": "更"}, {"type": "subtitle", "time": 16666.47, "timestamp": "04:37:46", "text": "光线是痛苦的，就像开着日光灯一样。"}, {"type": "subtitle", "time": 16669.83, "timestamp": "04:37:49", "text": "有时就像抬头仰望我一样。"}, {"type": "subtitle", "time": 16671.99, "timestamp": "04:37:51", "text": "我无法直视前方，我的眼睛会……"}, {"type": "subtitle", "time": 16675.07, "timestamp": "04:37:55", "text": "我有点想哭什么的"}]
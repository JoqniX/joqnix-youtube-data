[{"type": "subtitle", "time": 1624.47, "timestamp": "00:27:04", "text": "我只会玩井字棋。"}, {"type": "subtitle", "time": 1626.95, "timestamp": "00:27:06", "text": "没关系。但我们尽力了。那"}, {"type": "subtitle", "time": 1638.19, "timestamp": "00:27:18", "text": "我该怎么做？我不能让它发光。但"}, {"type": "subtitle", "time": 1639.95, "timestamp": "00:27:19", "text": "是的，"}, {"type": "subtitle", "time": 1644.51, "timestamp": "00:27:24", "text": "耶。第一次折纸。我做到了。"}, {"type": "subtitle", "time": 1648.549, "timestamp": "00:27:28", "text": "耶。我该如何给它拍照？我可以"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "我的天哪。也让我来做吧。"}, {"type": "subtitle", "time": 1659.87, "timestamp": "00:27:39", "text": "让我移除"}, {"type": "subtitle", "time": 1666.789, "timestamp": "00:27:46", "text": "嗨，马特。下次直播是什么时候？是的。"}, {"type": "subtitle", "time": 1669.669, "timestamp": "00:27:49", "text": "你下次直播是什么时候？好的。"}, {"type": "subtitle", "time": 1673.13, "timestamp": "00:27:53", "text": "呃，看看我周四的日程安排。"}, {"type": "subtitle", "time": 1675.51, "timestamp": "00:27:55", "text": "[音乐]"}, {"type": "subtitle", "time": 1678.549, "timestamp": "00:27:58", "text": "它会被做成便当，而这是什么呢？"}]
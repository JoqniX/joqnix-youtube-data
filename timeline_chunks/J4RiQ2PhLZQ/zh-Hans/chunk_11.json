[{"type": "subtitle", "time": 671.31, "timestamp": "00:11:11", "text": "是的。是的。我应该带大家参观一下这里。"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "页。到目前为止，还没有人渲染过这个呃"}, {"type": "subtitle", "time": 678.71, "timestamp": "00:11:18", "text": "另一个房间。嗯，是的。呃"}, {"type": "subtitle", "time": 681.55, "timestamp": "00:11:21", "text": "顶部区域得到了"}, {"type": "subtitle", "time": 683.99, "timestamp": "00:11:23", "text": "已翻新。是的，我们正在寻找"}, {"type": "subtitle", "time": 687.55, "timestamp": "00:11:27", "text": "新的人将来接管办公室"}, {"type": "subtitle", "time": 691.509, "timestamp": "00:11:31", "text": "空间。在此之前，一切都很平静。"}, {"type": "subtitle", "time": 695.67, "timestamp": "00:11:35", "text": "你这话是什么意思？哦，呃，是"}, {"type": "subtitle", "time": 698.43, "timestamp": "00:11:38", "text": "比如我家"}, {"type": "subtitle", "time": 701.75, "timestamp": "00:11:41", "text": "我现在住在我的房子里。"}, {"type": "subtitle", "time": 705.509, "timestamp": "00:11:45", "text": "我家一楼装修过了。"}, {"type": "subtitle", "time": 709.509, "timestamp": "00:11:49", "text": "所以它们被翻新，以便它们可以"}, {"type": "subtitle", "time": 711.75, "timestamp": "00:11:51", "text": "把它分配给两个办公空间"}, {"type": "subtitle", "time": 715.23, "timestamp": "00:11:55", "text": "东西。所以我住进了一个小房间。"}, {"type": "subtitle", "time": 718.91, "timestamp": "00:11:58", "text": "我的东西在楼上。"}]
[{"type": "subtitle", "time": 14822.83, "timestamp": "04:07:02", "text": "愈合。谢谢你的另一次"}, {"type": "subtitle", "time": 14825.51, "timestamp": "04:07:05", "text": "愈合。请尽可能造成最大破坏。请"}, {"type": "subtitle", "time": 14827.07, "timestamp": "04:07:07", "text": "尽力做到最好"}, {"type": "subtitle", "time": 14843.59, "timestamp": "04:07:23", "text": "然后死去。请给我第一个"}, {"type": "subtitle", "time": 14845.91, "timestamp": "04:07:25", "text": "请捐款。请。我恳求。"}, {"type": "subtitle", "time": 14860.87, "timestamp": "04:07:40", "text": "[音乐]"}, {"type": "subtitle", "time": 14862.87, "timestamp": "04:07:42", "text": "哦，我到了。或许。我到了。或许。"}, {"type": "subtitle", "time": 14865.91, "timestamp": "04:07:45", "text": "哦，我们走吧。"}, {"type": "subtitle", "time": 14871.07, "timestamp": "04:07:51", "text": "我得到了什么？腐败者和本质灵魂"}, {"type": "subtitle", "time": 14873.87, "timestamp": "04:07:53", "text": "石头和这个"}]
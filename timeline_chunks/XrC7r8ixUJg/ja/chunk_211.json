[{"type": "subtitle", "time": 12661.03, "timestamp": "03:31:01", "text": "失礼しました。コメントを読まなくてすみません。   私"}, {"type": "subtitle", "time": 12665.59, "timestamp": "03:31:05", "text": "の YouTube チャット機能は、このオーバーレイ機能では"}, {"type": "subtitle", "time": 12668.389, "timestamp": "03:31:08", "text": "オーバーレイではなく、ストリーム上にも"}, {"type": "subtitle", "time": 12672.63, "timestamp": "03:31:12", "text": "チャット機能のように表示されません。YouTube"}, {"type": "subtitle", "time": 12675.03, "timestamp": "03:31:15", "text": "ストリームに接続されなかったため、申し訳ありません。来てくれてありがとう。来てくれてありがとう。他に"}, {"type": "subtitle", "time": 12689.349, "timestamp": "03:31:29", "text": "誰がいるでしょうか。Gan。YouTube"}, {"type": "subtitle", "time": 12692.79, "timestamp": "03:31:32", "text": "で私をフォローまたは登録してくれてありがとう。"}, {"type": "subtitle", "time": 12695.67, "timestamp": "03:31:35", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 12697.91, "timestamp": "03:31:37", "text": "ありがとう。  YouTubeのコメントから私の配信をフォローしていただいていると思います"}, {"type": "subtitle", "time": 12703.67, "timestamp": "03:31:43", "text": "。 えっと、YouTubeの動画はダメですよね？"}, {"type": "subtitle", "time": 12705.51, "timestamp": "03:31:45", "text": "やあ、"}, {"type": "subtitle", "time": 12707.269, "timestamp": "03:31:47", "text": "スパイ。 本当に修復が必要です。"}, {"type": "subtitle", "time": 12710.79, "timestamp": "03:31:50", "text": "声が出なくなるかもしれません。 私も"}, {"type": "subtitle", "time": 12713.67, "timestamp": "03:31:53", "text": "小声で話しています。 まあ、そういうことだ。"}, {"type": "subtitle", "time": 12716.07, "timestamp": "03:31:56", "text": "ルームメイトもいるし、いろいろ"}, {"type": "subtitle", "time": 12718.87, "timestamp": "03:31:58", "text": "と事情があるんです。 彼らは眠っている。"}]
[{"type": "subtitle", "time": 7629.99, "timestamp": "02:07:09", "text": "ああ、それは私です。 何てことだ。 とんでもない。"}, {"type": "subtitle", "time": 7632.069, "timestamp": "02:07:12", "text": "初日"}, {"type": "subtitle", "time": 7651.133, "timestamp": "02:07:31", "text": "トリプル消失に行きましょう。"}, {"type": "subtitle", "time": 7656.31, "timestamp": "02:07:36", "text": "ああ、"}, {"type": "subtitle", "time": 7661.03, "timestamp": "02:07:41", "text": "インターネットは関係ないよ。"}, {"type": "subtitle", "time": 7665.03, "timestamp": "02:07:45", "text": "ああ、いや、いや、いや、いや。 そんなことしないで。"}, {"type": "subtitle", "time": 7668.79, "timestamp": "02:07:48", "text": "ああ、初めてだったのに、もう勘弁してくれ"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "。"}]
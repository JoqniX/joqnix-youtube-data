[{"type": "subtitle", "time": 12180.95, "timestamp": "03:23:00", "text": "ヒロアンとやったやつで、"}, {"type": "subtitle", "time": 12182.79, "timestamp": "03:23:02", "text": "それから"}, {"type": "subtitle", "time": 12185.19, "timestamp": "03:23:05", "text": "他のほとんどのものは"}, {"type": "subtitle", "time": 12188.71, "timestamp": "03:23:08", "text": "グループでやったやつだったよね。だからもっと多くの"}, {"type": "subtitle", "time": 12209.75, "timestamp": "03:23:29", "text": "今日、日本語で入力している人がいました"}, {"type": "subtitle", "time": 12216.15, "timestamp": "03:23:36", "text": "。 えっと、ちょっとJPモードに切り替えてました"}, {"type": "subtitle", "time": 12219.83, "timestamp": "03:23:39", "text": "。 その後、私はいつもの"}, {"type": "subtitle", "time": 12229.91, "timestamp": "03:23:49", "text": "君ならできるよ。 頑張ってください。 うん。   ぜひお越しください"}, {"type": "subtitle", "time": 12233.19, "timestamp": "03:23:53", "text": "。"}, {"type": "subtitle", "time": 12236.185, "timestamp": "03:23:56", "text": "最善を尽くします。"}]
[{"type": "subtitle", "time": 11701.75, "timestamp": "03:15:01", "text": "うん、そろそろ締めくくりたいな。"}, {"type": "subtitle", "time": 11704.71, "timestamp": "03:15:04", "text": "うん、でももう12時だよ。ああ、"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "明日仕事があるのに。 明日は学校の授業があります"}, {"type": "subtitle", "time": 11708.95, "timestamp": "03:15:08", "text": "。   えっと、"}, {"type": "subtitle", "time": 11719.349, "timestamp": "03:15:19", "text": "学校に2つ目の"}, {"type": "subtitle", "time": 11723.91, "timestamp": "03:15:23", "text": "アルバイトについて相談したんです。 だから、"}, {"type": "subtitle", "time": 11728.55, "timestamp": "03:15:28", "text": "今は土曜日に配信できるかどうか分からないんです。"}, {"type": "subtitle", "time": 11735.11, "timestamp": "03:15:35", "text": "今はお金が必要なので、配信する時間が取れるのは日曜日だけになりそうです。 日本では、あらゆることの"}, {"type": "subtitle", "time": 11740.55, "timestamp": "03:15:40", "text": "バランスを取るのは本当に難しい"}, {"type": "subtitle", "time": 11750.07, "timestamp": "03:15:50", "text": "でも、"}, {"type": "subtitle", "time": 11753.429, "timestamp": "03:15:53", "text": "標準版とウォルト版は"}, {"type": "subtitle", "time": 11755.59, "timestamp": "03:15:55", "text": "クリップが切れていた。 おかえり。 はい、そろそろ"}, {"type": "subtitle", "time": 11758.79, "timestamp": "03:15:58", "text": "締めくくりたいと思います。  12時です。"}]
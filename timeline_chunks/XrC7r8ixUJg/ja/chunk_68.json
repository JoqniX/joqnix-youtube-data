[{"type": "subtitle", "time": 4084.549, "timestamp": "01:08:04", "text": "。 お願い、お願い。 私はアジア"}, {"type": "subtitle", "time": 4087.349, "timestamp": "01:08:07", "text": "サーバーに接続していると思います。 それを二重に確認するにはどうすればいいですか"}, {"type": "subtitle", "time": 4094.789, "timestamp": "01:08:14", "text": "66. ああ。 あ、待って。 いや、"}, {"type": "subtitle", "time": 4097.03, "timestamp": "01:08:17", "text": "待って。"}, {"type": "subtitle", "time": 4098.309, "timestamp": "01:08:18", "text": "選手の中には"}, {"type": "subtitle", "time": 4101.99, "timestamp": "01:08:21", "text": "中国人らしき人もいるのが分かる。 あ、こんにちは。 こんにちは、こんにちは。"}, {"type": "subtitle", "time": 4104.87, "timestamp": "01:08:24", "text": "なあ、地域を変更する必要があるなんて知らなかったよ"}, {"type": "subtitle", "time": 4106.39, "timestamp": "01:08:26", "text": "。   それは"}]
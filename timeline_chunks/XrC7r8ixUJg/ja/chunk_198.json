[{"type": "subtitle", "time": 11881.429, "timestamp": "03:18:01", "text": "えーっと（咳払い）あー"}, {"type": "subtitle", "time": 11884.07, "timestamp": "03:18:04", "text": "、今日は喉の調子が悪い。 私はたくさん話しました"}, {"type": "subtitle", "time": 11886.55, "timestamp": "03:18:06", "text": "。 あまり喋りすぎたとは思わないのですが、"}, {"type": "subtitle", "time": 11897.51, "timestamp": "03:18:17", "text": "、こんにちは。 はい、"}, {"type": "subtitle", "time": 11899.91, "timestamp": "03:18:19", "text": "今日はこれで終わりにします。 えっと、配信はこれで終了です。"}, {"type": "subtitle", "time": 11903.67, "timestamp": "03:18:23", "text": "私たちは、Modern Warfare 4、Call of"}, {"type": "subtitle", "time": 11907.19, "timestamp": "03:18:27", "text": "Duty Modern Warfare 4 をプレイしました。ベータ版は"}, {"type": "subtitle", "time": 11911.269, "timestamp": "03:18:31", "text": "1 時間 49 分で終了します。オープン早期アクセス"}, {"type": "subtitle", "time": 11915.429, "timestamp": "03:18:35", "text": "ベータ版は 1 時間 49 分で終了します。 ええと、"}, {"type": "subtitle", "time": 11918.55, "timestamp": "03:18:38", "text": "今週末、"}, {"type": "subtitle", "time": 11920.389, "timestamp": "03:18:40", "text": "今週末にオープン"}, {"type": "subtitle", "time": 11921.99, "timestamp": "03:18:41", "text": "ベータ版が実施されます。"}, {"type": "subtitle", "time": 11924.55, "timestamp": "03:18:44", "text": "これは早期アクセス版でした。 わかった。 オープン"}, {"type": "subtitle", "time": 11927.83, "timestamp": "03:18:47", "text": "ベータ版が近日公開されます。 だから、"}, {"type": "subtitle", "time": 11929.67, "timestamp": "03:18:49", "text": "日曜日は配信できないことを願うばかりだ。  30日に"}, {"type": "subtitle", "time": 11932.55, "timestamp": "03:18:52", "text": "新宿に行きます。"}, {"type": "subtitle", "time": 11936.229, "timestamp": "03:18:56", "text": "えっと、日曜日にビデオ関連のワークショップみたいなのに行かないといけないんです"}]
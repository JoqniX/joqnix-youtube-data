[{"type": "subtitle", "time": 10261.11, "timestamp": "02:51:01", "text": "くそ。 待て、彼は俺も殺したんだ。"}, {"type": "subtitle", "time": 10264.15, "timestamp": "02:51:04", "text": "彼はそうしなかった。"}, {"type": "subtitle", "time": 10266.07, "timestamp": "02:51:06", "text": "でも、それは私なんです。"}, {"type": "subtitle", "time": 10279.11, "timestamp": "02:51:19", "text": "少しレベルアップしたと思う。 いいえ、"}, {"type": "subtitle", "time": 10286.71, "timestamp": "02:51:26", "text": "おお。 えっと、"}, {"type": "subtitle", "time": 10288.469, "timestamp": "02:51:28", "text": "あと、"}, {"type": "subtitle", "time": 10291.429, "timestamp": "02:51:31", "text": "私の配信はかなり"}, {"type": "subtitle", "time": 10294.309, "timestamp": "02:51:34", "text": "遅れていると思います。   なんてこった。"}, {"type": "subtitle", "time": 10298.15, "timestamp": "02:51:38", "text": "あ、待って。 いや、気にしないで。"}, {"type": "subtitle", "time": 10300.55, "timestamp": "02:51:40", "text": "ストリーミング配信に追いついた。 わかった。"}]
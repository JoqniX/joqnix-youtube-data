[{"type": "subtitle", "time": 1683.43, "timestamp": "00:28:03", "text": "こんにちは。 こんにちは。 コマ。"}, {"type": "subtitle", "time": 1693.99, "timestamp": "00:28:13", "text": "こんにちは。   何てことだ"}, {"type": "subtitle", "time": 1713.269, "timestamp": "00:28:33", "text": "殺害確認。 こんにちは。"}, {"type": "subtitle", "time": 1717.11, "timestamp": "00:28:37", "text": "ダウンロードを一時停止しなければなりませんでした。"}, {"type": "subtitle", "time": 1719.029, "timestamp": "00:28:39", "text": "元気ですか？ 素敵なモデルですね。 あなたはそれを持っています。"}, {"type": "subtitle", "time": 1723.11, "timestamp": "00:28:43", "text": "素晴らしいですね。 ああ、ありがとうございます。"}, {"type": "subtitle", "time": 1726.389, "timestamp": "00:28:46", "text": "これは私の新しいモデルで、現時点ではまだ"}, {"type": "subtitle", "time": 1728.389, "timestamp": "00:28:48", "text": "リギングされていません。"}, {"type": "subtitle", "time": 1730.47, "timestamp": "00:28:50", "text": "いつかちゃんと設置するつもりだ。"}, {"type": "subtitle", "time": 1734.71, "timestamp": "00:28:54", "text": "ええ、今はとりあえずPNG画像として使っています。 私はまず"}, {"type": "subtitle", "time": 1737.75, "timestamp": "00:28:57", "text": "キャラクターを存在させて、"}, {"type": "subtitle", "time": 1739.83, "timestamp": "00:28:59", "text": "それから後で改良していきたかったのです。 なので、"}]
[{"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "そうそう。   これだけの"}, {"type": "subtitle", "time": 3452.87, "timestamp": "00:57:32", "text": "ピング値で。 どうやってあの"}, {"type": "subtitle", "time": 3456.309, "timestamp": "00:57:36", "text": "シュートを決めたのか、自分でもわからない。"}, {"type": "subtitle", "time": 3466.289, "timestamp": "00:57:46", "text": "スコープがなかったので、ありがとうございました。"}, {"type": "subtitle", "time": 3467.43, "timestamp": "00:57:47", "text": "[笑い]"}, {"type": "subtitle", "time": 3470.47, "timestamp": "00:57:50", "text": "彼には太刀打ちできなかった。"}, {"type": "subtitle", "time": 3473.51, "timestamp": "00:57:53", "text": "ちなみに、ここは私の最高の狙撃ポイントです"}]
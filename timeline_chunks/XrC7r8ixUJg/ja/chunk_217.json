[{"type": "subtitle", "time": 13046.79, "timestamp": "03:37:26", "text": "いい夢が見られますように。"}, {"type": "subtitle", "time": 13049.91, "timestamp": "03:37:29", "text": "星々があなたに良い夢を与えてくれますように。 それを"}, {"type": "subtitle", "time": 13052.07, "timestamp": "03:37:32", "text": "日本語でどう言うか覚えなきゃ。"}, {"type": "subtitle", "time": 13053.636, "timestamp": "03:37:33", "text": "こんにちは。"}, {"type": "subtitle", "time": 13054.469, "timestamp": "03:37:34", "text": "[笑い]"}, {"type": "subtitle", "time": 13056.07, "timestamp": "03:37:36", "text": "とにかく、来てください"}]
[{"type": "subtitle", "time": 12851.429, "timestamp": "03:34:11", "text": "ええ、できますよ。 私はします。 しかし"}, {"type": "subtitle", "time": 12854.87, "timestamp": "03:34:14", "text": "問題は、もしエリアが"}, {"type": "subtitle", "time": 12857.03, "timestamp": "03:34:17", "text": "完全に混雑している場合、"}, {"type": "subtitle", "time": 12861.429, "timestamp": "03:34:21", "text": "私のモバイルデータが機能しなくなることです。"}, {"type": "subtitle", "time": 12862.95, "timestamp": "03:34:22", "text": "ハイブリッドに関するリマインダーをありがとうございます。"}, {"type": "subtitle", "time": 12865.429, "timestamp": "03:34:25", "text": "水を飲ませてください。"}, {"type": "subtitle", "time": 12876.469, "timestamp": "03:34:36", "text": "そのストリームはどこにあるの？ えっと、ちょっと"}, {"type": "subtitle", "time": 12888.63, "timestamp": "03:34:48", "text": "私は渋谷のスクランブル"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "交差点を見せようとしていました。 いや、渋谷"}, {"type": "subtitle", "time": 12899.349, "timestamp": "03:34:59", "text": "くそっ。 これも配信で見せましょう"}]
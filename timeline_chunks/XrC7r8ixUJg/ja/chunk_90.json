[{"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "突入兵、"}, {"type": "subtitle", "time": 5424.39, "timestamp": "01:30:24", "text": "爆破兵、狙撃兵。 私はショットガンで行きたい"}, {"type": "subtitle", "time": 5426.87, "timestamp": "01:30:26", "text": "。 デザートイーグル"}, {"type": "subtitle", "time": 5428.95, "timestamp": "01:30:28", "text": "メタ。"}, {"type": "subtitle", "time": 5439.35, "timestamp": "01:30:39", "text": "近いうちにGTAをプレイするかもしれない。"}, {"type": "subtitle", "time": 5440.55, "timestamp": "01:30:40", "text": "くそ。"}]
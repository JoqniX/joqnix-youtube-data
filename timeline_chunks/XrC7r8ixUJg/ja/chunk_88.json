[{"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "ああ、少なくとも何ですか？ あれこそ私が"}, {"type": "subtitle", "time": 5310.79, "timestamp": "01:28:30", "text": "くそ、フィニッシャーがある。   まさか"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "彼がナイフで刺したなんて言わないでくれよ"}, {"type": "subtitle", "time": 5317.27, "timestamp": "01:28:37", "text": "。 彼は「なんてこった」と言った"}, {"type": "subtitle", "time": 5323.43, "timestamp": "01:28:43", "text": "ああ、なんてことだ。 彼には"}, {"type": "subtitle", "time": 5332.229, "timestamp": "01:28:52", "text": "彼らにはナイフしか使えないチームメイトがいた。"}]
[{"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "こんにちは。 えっと、ゲームプレイのカスタムフレームレートが恋しかったです"}, {"type": "subtitle", "time": 563.43, "timestamp": "00:09:23", "text": "。 とりあえず今は60のままにしておきましょう。 わかった。"}, {"type": "subtitle", "time": 583.59, "timestamp": "00:09:43", "text": "よし、行こう。 そして我々は"}, {"type": "subtitle", "time": 586.31, "timestamp": "00:09:46", "text": "別の近接武器を使用するつもりだ。 よし、"}, {"type": "subtitle", "time": 588.63, "timestamp": "00:09:48", "text": "20キルだ。 サブマシンガンを持ってダッシュした後、2キル達成"}, {"type": "subtitle", "time": 592.389, "timestamp": "00:09:52", "text": "。  2. 敵のキルストリークを2つ破壊する"}]
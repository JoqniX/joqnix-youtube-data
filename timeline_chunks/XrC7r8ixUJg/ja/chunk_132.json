[{"type": "subtitle", "time": 7947.189, "timestamp": "02:12:27", "text": "ああ、ラグがひどすぎるよ。"}, {"type": "subtitle", "time": 7953.75, "timestamp": "02:12:33", "text": "そして、今週、"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "この週末にこのゲームで私が唯一願っていることは、"}, {"type": "subtitle", "time": 7962.149, "timestamp": "02:12:42", "text": "AK-47を無料、無料で"}, {"type": "subtitle", "time": 7966.629, "timestamp": "02:12:46", "text": "プレイできるようにしてほしいということです。 ウォレットでの支払いはしないでください。"}]
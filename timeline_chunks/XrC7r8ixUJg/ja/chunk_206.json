[{"type": "subtitle", "time": 12360.87, "timestamp": "03:26:00", "text": "中国の視聴者がいて、"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "VPNを使用して私を見ていると言ったので、私は「うわあ、なぜ」と思った、"}, {"type": "subtitle", "time": 12368.309, "timestamp": "03:26:08", "text": "そう、"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "中国本土の人々は、"}, {"type": "subtitle", "time": 12375.03, "timestamp": "03:26:15", "text": "コンテンツやソーシャルメディアを見たり、"}, {"type": "subtitle", "time": 12378.79, "timestamp": "03:26:18", "text": "ソーシャルメディアを使用したりできない、私たちが"}, {"type": "subtitle", "time": 12381.429, "timestamp": "03:26:21", "text": "通常使用しているように、YouTube、Discord、"}, {"type": "subtitle", "time": 12383.349, "timestamp": "03:26:23", "text": "Twitterなど、それらすべて"}, {"type": "subtitle", "time": 12386.389, "timestamp": "03:26:26", "text": "にアクセスできない、制限された"}, {"type": "subtitle", "time": 12388.95, "timestamp": "03:26:28", "text": "ファイアウォールのようなものだ、わかりました。 だから、そういうわけで、"}, {"type": "subtitle", "time": 12393.91, "timestamp": "03:26:33", "text": "みんなが見ることができるようなプラットフォームで配信したいと思ったんです"}, {"type": "subtitle", "time": 12397.349, "timestamp": "03:26:37", "text": "。 そして私はビリー・ビリーを発見した"}, {"type": "subtitle", "time": 12401.75, "timestamp": "03:26:41", "text": "。 どうやら、多くのジム系YouTuberが"}, {"type": "subtitle", "time": 12406.229, "timestamp": "03:26:46", "text": "そこで配信しているようで、JPとか、昔はイアンとか何人かいたみたいだ"}, {"type": "subtitle", "time": 12409.67, "timestamp": "03:26:49", "text": "。   ええ、"}, {"type": "subtitle", "time": 12413.67, "timestamp": "03:26:53", "text": "そして、"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "どうにかしてそこで配信できたのは夢のようでした。 たくさんの"}]
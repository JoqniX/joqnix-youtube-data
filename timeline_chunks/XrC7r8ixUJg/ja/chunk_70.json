[{"type": "subtitle", "time": 4211.43, "timestamp": "01:10:11", "text": "彼は地面に横たわっていた。"}, {"type": "subtitle", "time": 4245.43, "timestamp": "01:10:45", "text": "何だったんだ？ あれは何だったんだ"}, {"type": "subtitle", "time": 4247.189, "timestamp": "01:10:47", "text": "？"}, {"type": "subtitle", "time": 4250.229, "timestamp": "01:10:50", "text": "ええと、プレイヤーがこれを作るでしょう。 ああ、そうだね。"}, {"type": "subtitle", "time": 4252.39, "timestamp": "01:10:52", "text": "うん。 うん。 私のような。 私は英語名と"}]
[{"type": "subtitle", "time": 11109.83, "timestamp": "03:05:09", "text": "ああ、なんてことだ、私はワンタップで人を殺している。"}, {"type": "subtitle", "time": 11128.23, "timestamp": "03:05:28", "text": "おお。 それを切り取ってください。"}, {"type": "subtitle", "time": 11130.55, "timestamp": "03:05:30", "text": "ああ、切る必要はありませんよ。"}, {"type": "subtitle", "time": 11132.309, "timestamp": "03:05:32", "text": "大丈夫です。 それは私のことです。Twitch の"}, {"type": "subtitle", "time": 11134.87, "timestamp": "03:05:34", "text": "機能もテストしています。"}, {"type": "subtitle", "time": 11137.269, "timestamp": "03:05:37", "text": "クリップするように言うだけで"}]
[{"type": "subtitle", "time": 11647.51, "timestamp": "03:14:07", "text": "私は違います。 おお。 俺のほうが良かったよ、"}, {"type": "subtitle", "time": 11657.83, "timestamp": "03:14:17", "text": "おい、たった"}, {"type": "subtitle", "time": 11663.19, "timestamp": "03:14:23", "text": "4つ。"}, {"type": "subtitle", "time": 11665.99, "timestamp": "03:14:25", "text": "五。 ああ、気にしないで。 わかった、君の勝ちだ。 あなたの"}, {"type": "subtitle", "time": 11670.15, "timestamp": "03:14:30", "text": "勝ちです。 六。 何？ わかった、君の勝ちだ。 わかった、"}, {"type": "subtitle", "time": 11671.59, "timestamp": "03:14:31", "text": "いいよ。  [笑い] じゃあ、"}, {"type": "subtitle", "time": 11685.11, "timestamp": "03:14:45", "text": "わかった、蹴られたり何かされたりするかも、えっと、"}, {"type": "subtitle", "time": 11689.269, "timestamp": "03:14:49", "text": "夕食を作ってくるよ。 よし、"}, {"type": "subtitle", "time": 11692.95, "timestamp": "03:14:52", "text": "何だって？それとももう終わりにしようか？"}, {"type": "subtitle", "time": 11695.51, "timestamp": "03:14:55", "text": "つまり、もう12時だ。うん、そろそろ"}, {"type": "subtitle", "time": 11699.03, "timestamp": "03:14:59", "text": "切り上げようかな。"}]
[{"type": "subtitle", "time": 12002.348, "timestamp": "03:20:02", "text": "待って、"}, {"type": "subtitle", "time": 12003.75, "timestamp": "03:20:03", "text": "[笑い]"}, {"type": "subtitle", "time": 12007.03, "timestamp": "03:20:07", "text": "待って、待って。  Twitchのクリップに注釈が付くのはいつですか"}, {"type": "subtitle", "time": 12010.389, "timestamp": "03:20:10", "text": "？ え、何？"}, {"type": "subtitle", "time": 12013.429, "timestamp": "03:20:13", "text": "字幕機能が付いています。 何？ どうやってやったんですか"}, {"type": "subtitle", "time": 12016.87, "timestamp": "03:20:16", "text": "？ えっと、どうやって字幕を追加したんですか？"}, {"type": "subtitle", "time": 12018.63, "timestamp": "03:20:18", "text": "クリップマネージャーで"}, {"type": "subtitle", "time": 12020.79, "timestamp": "03:20:20", "text": "30日以内であれば削除できます。"}, {"type": "subtitle", "time": 12028.229, "timestamp": "03:20:28", "text": "それではあなたのDiscordに参加しようとしているんですね。 ああ、"}, {"type": "subtitle", "time": 12031.11, "timestamp": "03:20:31", "text": "ありがとうございます。 私のDiscordサーバーにぜひご参加ください。"}, {"type": "subtitle", "time": 12033.59, "timestamp": "03:20:33", "text": "私はそれほど活動的ではないのですが。 でも、"}, {"type": "subtitle", "time": 12035.75, "timestamp": "03:20:35", "text": "Twitch クリップは"}, {"type": "subtitle", "time": 12038.87, "timestamp": "03:20:38", "text": "自動的に Discord ボットによって"}, {"type": "subtitle", "time": 12044.15, "timestamp": "03:20:44", "text": "Discord ボットで紹介されたショーのように追加されます"}, {"type": "subtitle", "time": 12047.91, "timestamp": "03:20:47", "text": "。 ええ、そうですね。"}, {"type": "subtitle", "time": 12049.59, "timestamp": "03:20:49", "text": "ああ、しまった"}, {"type": "subtitle", "time": 12054.71, "timestamp": "03:20:54", "text": "ええ、そういうことです。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 12058.15, "timestamp": "03:20:58", "text": "ただし、自動的にTwitchのみになります。"}]
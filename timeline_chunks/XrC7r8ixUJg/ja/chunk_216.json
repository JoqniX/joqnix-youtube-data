[{"type": "subtitle", "time": 12961.75, "timestamp": "03:36:01", "text": "ええ、水平ストリームで見れば、"}, {"type": "subtitle", "time": 12964.229, "timestamp": "03:36:04", "text": "それが分かりますよ。 私はこれを"}, {"type": "subtitle", "time": 12966.87, "timestamp": "03:36:06", "text": "縦型フィードには載せていません。 だから、"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "今あなたがそれを予見できるかどうかはわかりませんが、ええ、あの件については、"}, {"type": "subtitle", "time": 12982.229, "timestamp": "03:36:22", "text": "でも月曜日には眼鏡をかける予定なので、"}, {"type": "subtitle", "time": 12984.07, "timestamp": "03:36:24", "text": "後押ししてくれてありがとう。"}, {"type": "subtitle", "time": 12986.56, "timestamp": "03:36:26", "text": "ありがとう。 69歳になるなんて、なんてユーザー名だ。 いらっしゃいませ。"}, {"type": "subtitle", "time": 12991.359, "timestamp": "03:36:31", "text": "69歳になるなんて、なんてユーザー名だ。 いらっしゃいませ。 ええと、12時"}, {"type": "subtitle", "time": 12993.359, "timestamp": "03:36:33", "text": "ええと、12時 30分になります。 もっと"}, {"type": "subtitle", "time": 12995.52, "timestamp": "03:36:35", "text": "30分になります。 もっと 早く終わるはずだったのに。 そして、なぜ私はまだ"}, {"type": "subtitle", "time": 12998.96, "timestamp": "03:36:38", "text": "早く終わるはずだったのに。 そして、なぜ私はまだ ここにいるのだろうか？"}, {"type": "subtitle", "time": 13001.12, "timestamp": "03:36:41", "text": "ここにいるのだろうか？ おお。   ええ"}, {"type": "subtitle", "time": 13008.79, "timestamp": "03:36:48", "text": "、今日はありがとうございました。"}, {"type": "subtitle", "time": 13011.83, "timestamp": "03:36:51", "text": "話し合いましょう。"}, {"type": "subtitle", "time": 13015.51, "timestamp": "03:36:55", "text": "みんなと遊んで、撃ちまくるのは本当に楽しかった。"}, {"type": "subtitle", "time": 13017.03, "timestamp": "03:36:57", "text": "お越しいただきありがとうございます。"}]
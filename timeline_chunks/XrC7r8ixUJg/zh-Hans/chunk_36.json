[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "做过，呃，是什么时候的事来着？ 你知道《"}, {"type": "subtitle", "time": 2163.43, "timestamp": "00:36:03", "text": "使命召唤：现代战争》"}, {"type": "subtitle", "time": 2165.829, "timestamp": "00:36:05", "text": "和其他几部作品不一样。"}, {"type": "subtitle", "time": 2169.27, "timestamp": "00:36:09", "text": "黑色行动，对吧？ 是《黑色行动6》吗？ 我"}, {"type": "subtitle", "time": 2171.67, "timestamp": "00:36:11", "text": "以前也这样做过。   是"}, {"type": "subtitle", "time": 2175.43, "timestamp": "00:36:15", "text": "啊，那真是太好了。 就像那张小"}, {"type": "subtitle", "time": 2177.75, "timestamp": "00:36:17", "text": "地图一样。"}, {"type": "subtitle", "time": 2179.589, "timestamp": "00:36:19", "text": "就像你看那些 YouTube"}, {"type": "subtitle", "time": 2182.47, "timestamp": "00:36:22", "text": "创作者或游戏创作者"}, {"type": "subtitle", "time": 2184.55, "timestamp": "00:36:24", "text": "在他们的游戏机上玩《使命召唤》之类的游戏一样"}, {"type": "subtitle", "time": 2186.71, "timestamp": "00:36:26", "text": "。   是的"}, {"type": "subtitle", "time": 2189.75, "timestamp": "00:36:29", "text": "。 他们每个人都拿到了40个人头、50"}, {"type": "subtitle", "time": 2193.27, "timestamp": "00:36:33", "text": "个人头之类的，对吧？ 他们不停地"}, {"type": "subtitle", "time": 2195.829, "timestamp": "00:36:35", "text": "移动、奔跑，用"}, {"type": "subtitle", "time": 2199.03, "timestamp": "00:36:39", "text": "霰弹枪，有时还会用"}, {"type": "subtitle", "time": 2201.589, "timestamp": "00:36:41", "text": "沙鹰或狙击步枪之类的武器，扫射每一个人。 太"}, {"type": "subtitle", "time": 2203.51, "timestamp": "00:36:43", "text": "酷了！   等"}, {"type": "subtitle", "time": 2206.31, "timestamp": "00:36:46", "text": "我足够优秀的时候，我也想做到那样"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "。"}, {"type": "subtitle", "time": 2212.31, "timestamp": "00:36:52", "text": "啊，第一次击杀感觉如何？"}]
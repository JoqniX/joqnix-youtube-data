[{"type": "subtitle", "time": 11701.75, "timestamp": "03:15:01", "text": "嗯，我该结束了。"}, {"type": "subtitle", "time": 11704.71, "timestamp": "03:15:04", "text": "是啊，现在都12点了。天哪，我明天还要上班"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "。 我明天有课"}, {"type": "subtitle", "time": 11708.95, "timestamp": "03:15:08", "text": "。"}, {"type": "subtitle", "time": 11719.349, "timestamp": "03:15:19", "text": "跟学校谈过，想找份"}, {"type": "subtitle", "time": 11723.91, "timestamp": "03:15:23", "text": "兼职工作。 所以"}, {"type": "subtitle", "time": 11725.59, "timestamp": "03:15:25", "text": "我现在不知道能不能在"}, {"type": "subtitle", "time": 11728.55, "timestamp": "03:15:28", "text": "周六直播了。 我觉得我唯一有时间"}, {"type": "subtitle", "time": 11731.83, "timestamp": "03:15:31", "text": "直播的时间就是"}, {"type": "subtitle", "time": 11735.11, "timestamp": "03:15:35", "text": "周日了，因为我现在需要钱。 在日本，要做到面面俱到真的"}, {"type": "subtitle", "time": 11740.55, "timestamp": "03:15:40", "text": "很难"}, {"type": "subtitle", "time": 11750.07, "timestamp": "03:15:50", "text": "但是，是的"}, {"type": "subtitle", "time": 11753.429, "timestamp": "03:15:53", "text": "标准版和沃尔特版"}, {"type": "subtitle", "time": 11755.59, "timestamp": "03:15:55", "text": "都是剪辑版。 欢迎回来。 好的，"}, {"type": "subtitle", "time": 11758.79, "timestamp": "03:15:58", "text": "我要结束了。 现在是12点。"}]
[{"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "啊，至少有什么？ 这就是我能"}, {"type": "subtitle", "time": 5310.79, "timestamp": "01:28:30", "text": "该死，我还有终结技。"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "别告诉我他用刀捅人了，"}, {"type": "subtitle", "time": 5317.27, "timestamp": "01:28:37", "text": "兄弟。 他当时就惊呆了，"}, {"type": "subtitle", "time": 5323.43, "timestamp": "01:28:43", "text": "我的天哪。 他们队里有个队友只会"}, {"type": "subtitle", "time": 5332.229, "timestamp": "01:28:52", "text": "他们队里有个队友只会用刀。"}]
[{"type": "subtitle", "time": 5702.47, "timestamp": "01:35:02", "text": "相信没有真正的，比如重新"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "双手各持一把霰弹枪，"}, {"type": "subtitle", "time": 5716.31, "timestamp": "01:35:16", "text": "另一只手拿着一把。 啊。 哦，是的。 是啊，是"}, {"type": "subtitle", "time": 5718.79, "timestamp": "01:35:18", "text": "啊，是啊。"}, {"type": "subtitle", "time": 5723.83, "timestamp": "01:35:23", "text": "它叫什么名字？ 就像拥有两把枪一样。"}, {"type": "subtitle", "time": 5726.31, "timestamp": "01:35:26", "text": "我忘了名字。"}, {"type": "subtitle", "time": 5750.629, "timestamp": "01:35:50", "text": "嗯，那叫什么名字来着？ 我忘了。"}, {"type": "subtitle", "time": 5754.39, "timestamp": "01:35:54", "text": "啊，就在"}]
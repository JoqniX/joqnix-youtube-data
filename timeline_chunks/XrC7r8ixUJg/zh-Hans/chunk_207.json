[{"type": "subtitle", "time": 12420.469, "timestamp": "03:27:00", "text": "很多人，有没有什么"}, {"type": "subtitle", "time": 12423.83, "timestamp": "03:27:03", "text": "办法可以黑进系统，"}, {"type": "subtitle", "time": 12427.11, "timestamp": "03:27:07", "text": "获取一些信息之类的。"}, {"type": "subtitle", "time": 12429.91, "timestamp": "03:27:09", "text": "我的一个朋友介绍我加入了一个类似"}, {"type": "subtitle", "time": 12433.03, "timestamp": "03:27:13", "text": "MCN的公司，我在那里可以做直播"}, {"type": "subtitle", "time": 12436.71, "timestamp": "03:27:16", "text": "之类的，但是那个MCN解散了，负责"}, {"type": "subtitle", "time": 12442.79, "timestamp": "03:27:22", "text": "照顾我的部门也"}, {"type": "subtitle", "time": 12446.63, "timestamp": "03:27:26", "text": "解散了那家公司之类的。"}, {"type": "subtitle", "time": 12450.55, "timestamp": "03:27:30", "text": "所以正因为如此，我还在找地方住"}, {"type": "subtitle", "time": 12454.15, "timestamp": "03:27:34", "text": "。 大多数"}, {"type": "subtitle", "time": 12458.15, "timestamp": "03:27:38", "text": "MCN都拒绝了我，因为"}, {"type": "subtitle", "time": 12461.429, "timestamp": "03:27:41", "text": "我的观看量之类的东西不多。 呃，"}, {"type": "subtitle", "time": 12464.469, "timestamp": "03:27:44", "text": "相信我，莉娜，当然了"}, {"type": "subtitle", "time": 12465.83, "timestamp": "03:27:45", "text": "，这个平台"}, {"type": "subtitle", "time": 12469.67, "timestamp": "03:27:49", "text": "限制太多，而且充斥着很多垃圾内容。 你经常被"}, {"type": "subtitle", "time": 12472.95, "timestamp": "03:27:52", "text": "封号。 你经常被……呃……吸毒"}, {"type": "subtitle", "time": 12475.19, "timestamp": "03:27:55", "text": "。"}, {"type": "subtitle", "time": 12476.79, "timestamp": "03:27:56", "text": "如果你在直播中显示"}, {"type": "subtitle", "time": 12479.03, "timestamp": "03:27:59", "text": "其他内容，比如 YouTube、Twitch 或其他平台，甚至是"}]
[{"type": "subtitle", "time": 3432.39, "timestamp": "00:57:12", "text": "我的天啊。 愚蠢的。"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "哦，是的。"}, {"type": "subtitle", "time": 3452.87, "timestamp": "00:57:32", "text": "延迟这么高。 我也不知道我是怎么投进"}, {"type": "subtitle", "time": 3456.309, "timestamp": "00:57:36", "text": "那个球的。"}, {"type": "subtitle", "time": 3466.289, "timestamp": "00:57:46", "text": "我没法进行无瞄准镜射击。"}, {"type": "subtitle", "time": 3467.43, "timestamp": "00:57:47", "text": "[笑声] 我"}, {"type": "subtitle", "time": 3470.47, "timestamp": "00:57:50", "text": "根本招架不住他。"}, {"type": "subtitle", "time": 3473.51, "timestamp": "00:57:53", "text": "顺便说一句，这是我最佳的狙击位置"}]
[{"type": "subtitle", "time": 12360.87, "timestamp": "03:26:00", "text": "一个中国观众说他们"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "用 VPN 看我的直播，我当时就想，"}, {"type": "subtitle", "time": 12368.309, "timestamp": "03:26:08", "text": "哇，为什么？我后来才知道，"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "中国大陆的人"}, {"type": "subtitle", "time": 12375.03, "timestamp": "03:26:15", "text": "看不到内容，也用不了"}, {"type": "subtitle", "time": 12378.79, "timestamp": "03:26:18", "text": "社交媒体，就像我们"}, {"type": "subtitle", "time": 12381.429, "timestamp": "03:26:21", "text": "平时用的 YouTube、Discord、"}, {"type": "subtitle", "time": 12383.349, "timestamp": "03:26:23", "text": "Twitter 之类的，"}, {"type": "subtitle", "time": 12386.389, "timestamp": "03:26:26", "text": "他们也访问不了，就像"}, {"type": "subtitle", "time": 12388.95, "timestamp": "03:26:28", "text": "防火墙限制了一样。好吧。 所以，因为这个原因，我"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "就想，好吧，我想在一个所有人"}, {"type": "subtitle", "time": 12393.91, "timestamp": "03:26:33", "text": "都能"}, {"type": "subtitle", "time": 12397.349, "timestamp": "03:26:37", "text": "观看的平台上进行直播。 然后我发现了"}, {"type": "subtitle", "time": 12401.75, "timestamp": "03:26:41", "text": "比利比利。 显然，很多健身类 YouTuber 都在"}, {"type": "subtitle", "time": 12406.229, "timestamp": "03:26:46", "text": "那里直播，比如 JP 的那些，还有以前 Ian 的一些"}, {"type": "subtitle", "time": 12409.67, "timestamp": "03:26:49", "text": "。"}, {"type": "subtitle", "time": 12413.67, "timestamp": "03:26:53", "text": "嗯，是的，能在"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "那里直播就像做梦一样。 我一直问"}]
[{"type": "subtitle", "time": 2118.31, "timestamp": "00:35:18", "text": "忘了给我的"}, {"type": "subtitle", "time": 2121.19, "timestamp": "00:35:21", "text": "朋友汇款了。 我的天啊，我的天啊。 他在"}, {"type": "subtitle", "time": 2124.069, "timestamp": "00:35:24", "text": "杂货店。"}, {"type": "subtitle", "time": 2130.87, "timestamp": "00:35:30", "text": "花了"}, {"type": "subtitle", "time": 2134.71, "timestamp": "00:35:34", "text": "500块钱"}, {"type": "subtitle", "time": 2141.99, "timestamp": "00:35:41", "text": "等等等等。 好的。"}, {"type": "subtitle", "time": 2151.589, "timestamp": "00:35:51", "text": "好吧，我以前会拿着霰弹枪在"}, {"type": "subtitle", "time": 2153.19, "timestamp": "00:35:53", "text": "地图上到处乱跑，找到一个角落，像蛇一样攻击我的"}, {"type": "subtitle", "time": 2156.55, "timestamp": "00:35:56", "text": "敌人。 啊，我也曾经那样"}]
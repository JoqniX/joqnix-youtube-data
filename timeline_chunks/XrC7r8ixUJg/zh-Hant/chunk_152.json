[{"type": "subtitle", "time": 9141.429, "timestamp": "02:32:21", "text": "他居然知道我在那裡。  無人機在線。  呃，敵方"}, {"type": "subtitle", "time": 9146.309, "timestamp": "02:32:26", "text": "攻擊直升機來襲。  我的天啊。"}, {"type": "subtitle", "time": 9151.27, "timestamp": "02:32:31", "text": "無人機，兄弟。"}, {"type": "subtitle", "time": 9177.67, "timestamp": "02:32:57", "text": "哦，庫克視野。好的。剪下來。剪下來。剪下來。剪下來。"}]
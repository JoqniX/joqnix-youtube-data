[{"type": "subtitle", "time": 181.509, "timestamp": "00:03:01", "text": "希望我今晚不會給大家帶來麻煩，我們今晚能"}, {"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "一起度過一段美好的時光。"}, {"type": "subtitle", "time": 188.949, "timestamp": "00:03:08", "text": "今天我們也會玩《決勝時刻："}, {"type": "subtitle", "time": 192.309, "timestamp": "00:03:12", "text": "現代戰爭4》的"}, {"type": "subtitle", "time": 194.47, "timestamp": "00:03:14", "text": "早期測試版，[音樂]"}, {"type": "subtitle", "time": 197.35, "timestamp": "00:03:17", "text": "測試版將在"}, {"type": "subtitle", "time": 202.55, "timestamp": "00:03:22", "text": "5小時內結束，是的，5小時內"}, {"type": "subtitle", "time": 206.22899999999998, "timestamp": "00:03:26", "text": "測試版就會結束。我今天想盡全力"}, {"type": "subtitle", "time": 209.589, "timestamp": "00:03:29", "text": "去射擊，玩得開心，好好享受"}]
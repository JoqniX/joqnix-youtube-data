[{"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "你好。嗯，我錯過了遊戲自訂"}, {"type": "subtitle", "time": 563.43, "timestamp": "00:09:23", "text": "幀率功能。我們暫時先把它維持在60吧。好的。"}, {"type": "subtitle", "time": 583.59, "timestamp": "00:09:43", "text": "好了，我們走吧。我們將使用"}, {"type": "subtitle", "time": 586.31, "timestamp": "00:09:46", "text": "另一種近戰武器。好的，"}, {"type": "subtitle", "time": 588.63, "timestamp": "00:09:48", "text": "20殺。用那把衝鋒槍衝刺後殺死兩人"}, {"type": "subtitle", "time": 592.389, "timestamp": "00:09:52", "text": "。兩人摧毀敵方兩"}]
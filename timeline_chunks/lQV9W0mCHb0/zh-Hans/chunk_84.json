[{"type": "subtitle", "time": 5085.51, "timestamp": "01:24:45", "text": "你怎么还没死？ 我要朝"}, {"type": "subtitle", "time": 5087.03, "timestamp": "01:24:47", "text": "你脸上开枪。"}, {"type": "subtitle", "time": 5088.629, "timestamp": "01:24:48", "text": "[音乐]"}, {"type": "subtitle", "time": 5091.11, "timestamp": "01:24:51", "text": "你的脸应该砰砰砰地动起来"}, {"type": "subtitle", "time": 5094.07, "timestamp": "01:24:54", "text": "。 那你当时是怎么对我使出“boom boom"}]
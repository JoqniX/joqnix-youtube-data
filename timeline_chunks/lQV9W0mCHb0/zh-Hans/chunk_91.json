[{"type": "subtitle", "time": 5472.47, "timestamp": "01:31:12", "text": "哦，那家伙抢了我的猎物。 那家伙是哪来的"}, {"type": "subtitle", "time": 5475.59, "timestamp": "01:31:15", "text": "？ 兄弟，他抢了我的人头。 我本来可以靠"}, {"type": "subtitle", "time": 5480.149, "timestamp": "01:31:20", "text": "那次击杀拿到三个人头和两个人头。 你为什么来？ 哦，我的意思是，我们"}, {"type": "subtitle", "time": 5482.709, "timestamp": "01:31:22", "text": "是同一队的。 美好的。 但我"}, {"type": "subtitle", "time": 5485.669, "timestamp": "01:31:25", "text": "现在需要拿到这两个人头。"}, {"type": "subtitle", "time": 5496.07, "timestamp": "01:31:36", "text": "我需要完成我的猎杀。 我需要完成我的猎杀。"}, {"type": "subtitle", "time": 5504.31, "timestamp": "01:31:44", "text": "老鼠。"}, {"type": "subtitle", "time": 5507.03, "timestamp": "01:31:47", "text": "我看见你。 我看到了"}, {"type": "subtitle", "time": 5509.189, "timestamp": "01:31:49", "text": "真正的狙击手。"}, {"type": "subtitle", "time": 5513.43, "timestamp": "01:31:53", "text": "你知道吗？ 我要转职成狙击手。"}, {"type": "subtitle", "time": 5515.83, "timestamp": "01:31:55", "text": "让我来做饭。"}]
[{"type": "subtitle", "time": 841.189, "timestamp": "00:14:01", "text": "生日那天还在努力工作。 呃，我已经升到"}, {"type": "subtitle", "time": 851.11, "timestamp": "00:14:11", "text": "我想吐。 我想开坦克。"}, {"type": "subtitle", "time": 877.11, "timestamp": "00:14:37", "text": "老兄，我一直在看Stra玩《"}, {"type": "subtitle", "time": 879.59, "timestamp": "00:14:39", "text": "战地》系列游戏。"}, {"type": "subtitle", "time": 882.629, "timestamp": "00:14:42", "text": "哇，太酷了。"}, {"type": "subtitle", "time": 885.59, "timestamp": "00:14:45", "text": "那是我们的队友吗？"}, {"type": "subtitle", "time": 887.99, "timestamp": "00:14:47", "text": "你和中国有关系吗？"}, {"type": "subtitle", "time": 891.03, "timestamp": "00:14:51", "text": "所以，等等。  《战地4》就像是"}]
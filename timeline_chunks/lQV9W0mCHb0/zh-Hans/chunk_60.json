[{"type": "subtitle", "time": 3608.789, "timestamp": "01:00:08", "text": "你把我的腿打断了，对吧？"}, {"type": "subtitle", "time": 3644.95, "timestamp": "01:00:44", "text": "如何？ 我的子弹都射向哪里？ 什么？"}, {"type": "subtitle", "time": 3647.99, "timestamp": "01:00:47", "text": "这怎么可能？"}, {"type": "subtitle", "time": 3654.71, "timestamp": "01:00:54", "text": "但我的目标是你。 我不得不进行微调。 等等，我瞄准的"}]
[{"type": "subtitle", "time": 122.87, "timestamp": "00:02:02", "text": "驱动程序（也就是重新"}, {"type": "subtitle", "time": 127.109, "timestamp": "00:02:07", "text": "安装了显卡驱动程序）之后，我的"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "显示器帧率变成了 60fps 60Hz。 频率不是 240 赫兹。 我连续"}, {"type": "subtitle", "time": 146.55, "timestamp": "00:02:26", "text": "5天都用60赫兹的音频频率。 不，3、4"}, {"type": "subtitle", "time": 148.869, "timestamp": "00:02:28", "text": "天。"}, {"type": "subtitle", "time": 153.03, "timestamp": "00:02:33", "text": "兄弟，你敢信我被拉黑了吗？ 我的"}, {"type": "subtitle", "time": 154.949, "timestamp": "00:02:34", "text": "显示器"}, {"type": "subtitle", "time": 159.99, "timestamp": "00:02:39", "text": "刷新率真的是60Hz。"}, {"type": "subtitle", "time": 164.869, "timestamp": "00:02:44", "text": "啊，是啊。 祝大家消失日快乐。"}, {"type": "subtitle", "time": 167.91, "timestamp": "00:02:47", "text": "我真的挺兴奋的。 你想要_____吗？"}, {"type": "subtitle", "time": 169.50900000000001, "timestamp": "00:02:49", "text": "这是我第一次玩《"}, {"type": "subtitle", "time": 174.63, "timestamp": "00:02:54", "text": "战地4》，我很兴奋。 我们走吧。"}, {"type": "subtitle", "time": 177.35, "timestamp": "00:02:57", "text": "我正在直播，对吧？ 好的。 好，好，好，"}, {"type": "subtitle", "time": 179.35, "timestamp": "00:02:59", "text": "好。"}]
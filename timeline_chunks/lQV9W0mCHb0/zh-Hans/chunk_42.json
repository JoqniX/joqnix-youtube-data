[{"type": "subtitle", "time": 2520.069, "timestamp": "00:42:00", "text": "哦，他用DMR狙击了我。 等等，"}, {"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "那是DMR吗？ 四分卫。 哦，那是《"}, {"type": "subtitle", "time": 2526.069, "timestamp": "00:42:06", "text": "绝地求生》里的武器。"}, {"type": "subtitle", "time": 2528.55, "timestamp": "00:42:08", "text": "哇。 好的。 请问我拿到新枪了吗？"}, {"type": "subtitle", "time": 2531.51, "timestamp": "00:42:11", "text": "我还在轻机枪部队。 为什么？ 我想买一把"}, {"type": "subtitle", "time": 2548.47, "timestamp": "00:42:28", "text": "好的。 好的。 好的。 好的。 好的。 好的。"}, {"type": "subtitle", "time": 2558.55, "timestamp": "00:42:38", "text": "66 轻机枪。"}, {"type": "subtitle", "time": 2561.27, "timestamp": "00:42:41", "text": "哦，他们又把这家伙造出来了。 他浪费了"}, {"type": "subtitle", "time": 2564.47, "timestamp": "00:42:44", "text": "我太多时间。"}, {"type": "subtitle", "time": 2568.069, "timestamp": "00:42:48", "text": "我们目前击杀了多少人？"}]
[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "选择新枪。"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "我选“哦，是枪”。 哦，"}, {"type": "subtitle", "time": 2108.069, "timestamp": "00:35:08", "text": "枪战！ 哦，一开始你只有一把武器，"}, {"type": "subtitle", "time": 2109.829, "timestamp": "00:35:09", "text": "然后你杀的怪越多，就能获得"}, {"type": "subtitle", "time": 2119.03, "timestamp": "00:35:19", "text": "哦，整个班次都要跑啊？ 我的"}, {"type": "subtitle", "time": 2145.91, "timestamp": "00:35:45", "text": "我杀了一只。 我杀了一只。 我杀了"}, {"type": "subtitle", "time": 2149.27, "timestamp": "00:35:49", "text": "一只。 那是上一场比赛的。 我杀了你。"}, {"type": "subtitle", "time": 2150.71, "timestamp": "00:35:50", "text": "他杀了我两次。 我杀了他。"}, {"type": "subtitle", "time": 2152.87, "timestamp": "00:35:52", "text": "复仇。"}, {"type": "subtitle", "time": 2154.87, "timestamp": "00:35:54", "text": "呃，"}, {"type": "subtitle", "time": 2156.23, "timestamp": "00:35:56", "text": "我被派往海外服役了。 快点。 快点。"}]
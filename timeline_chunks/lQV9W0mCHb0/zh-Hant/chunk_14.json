[{"type": "subtitle", "time": 841.189, "timestamp": "00:14:01", "text": "，我已經升到"}, {"type": "subtitle", "time": 851.11, "timestamp": "00:14:11", "text": "我想開坦克車。"}, {"type": "subtitle", "time": 877.11, "timestamp": "00:14:37", "text": "老兄，我一直在看Stra玩《"}, {"type": "subtitle", "time": 879.59, "timestamp": "00:14:39", "text": "戰地》系列遊戲。  哇，"}, {"type": "subtitle", "time": 882.629, "timestamp": "00:14:42", "text": "太酷了。  那是"}, {"type": "subtitle", "time": 885.59, "timestamp": "00:14:45", "text": "我們的隊友嗎？"}, {"type": "subtitle", "time": 887.99, "timestamp": "00:14:47", "text": "你和中國有關係嗎？"}, {"type": "subtitle", "time": 891.03, "timestamp": "00:14:51", "text": "所以，等等。 《戰地4》就像是"}]
[{"type": "subtitle", "time": 62.31, "timestamp": "00:01:02", "text": "戰地4》。我好"}, {"type": "subtitle", "time": 66.31, "timestamp": "00:01:06", "text": "興奮啊！  我興奮極了。此刻我"}, {"type": "subtitle", "time": 69.429, "timestamp": "00:01:09", "text": "百感交集。"}, {"type": "subtitle", "time": 74.95, "timestamp": "00:01:14", "text": "[音樂]"}, {"type": "subtitle", "time": 78.07, "timestamp": "00:01:18", "text": "不過，"}, {"type": "subtitle", "time": 80.789, "timestamp": "00:01:20", "text": "今天就讓我們盡情享受吧。好的。"}, {"type": "subtitle", "time": 85.749, "timestamp": "00:01:25", "text": "那麼，我們直接進入遊戲吧？"}, {"type": "subtitle", "time": 91.749, "timestamp": "00:01:31", "text": "呃，讓我切換一下場景，或者，好的，"}, {"type": "subtitle", "time": 95.91, "timestamp": "00:01:35", "text": "你們都能看到這個，對吧？好的。嗯，你好，戰地"}, {"type": "subtitle", "time": 99.27000000000001, "timestamp": "00:01:39", "text": "。砰砰聲來了"}, {"type": "subtitle", "time": 101.35, "timestamp": "00:01:41", "text": "。  我們"}, {"type": "subtitle", "time": 103.429, "timestamp": "00:01:43", "text": "走吧。"}, {"type": "subtitle", "time": 105.67, "timestamp": "00:01:45", "text": "戰場上，砰砰砰。所以，我今天用我的"}, {"type": "subtitle", "time": 109.83, "timestamp": "00:01:49", "text": "PNG插件來提高幀率。"}, {"type": "subtitle", "time": 113.99000000000001, "timestamp": "00:01:53", "text": "你知道嗎，我這幾天才意識到，"}, {"type": "subtitle", "time": 116.789, "timestamp": "00:01:56", "text": "自從我為了玩《決勝時刻》"}, {"type": "subtitle", "time": 119.91, "timestamp": "00:01:59", "text": "呃，不，是《戰地6》重置了驅動程式（也就是重新"}]
[{"type": "subtitle", "time": 1142.15, "timestamp": "00:19:02", "text": "模式有點像是俄羅斯、美國和"}, {"type": "subtitle", "time": 1145.51, "timestamp": "00:19:05", "text": "中東國家的混合體。啊等等，我想等等，應該會有戰役模式吧，"}, {"type": "subtitle", "time": 1149.75, "timestamp": "00:19:09", "text": "所以我覺得《戰地"}, {"type": "subtitle", "time": 1154.39, "timestamp": "00:19:14", "text": "6》也會有戰役模式。不。"}, {"type": "subtitle", "time": 1161.83, "timestamp": "00:19:21", "text": "故事是怎麼樣的呢？"}, {"type": "subtitle", "time": 1165.669, "timestamp": "00:19:25", "text": "它像混亂和毀滅一樣嗎？"}, {"type": "subtitle", "time": 1167.83, "timestamp": "00:19:27", "text": "砰砰。  那玩意兒有點像《決勝時刻》嗎？"}, {"type": "subtitle", "time": 1171.11, "timestamp": "00:19:31", "text": "我"}, {"type": "subtitle", "time": 1173.35, "timestamp": "00:19:33", "text": "知道裡面有鬼魂之類的，還有"}, {"type": "subtitle", "time": 1177.029, "timestamp": "00:19:37", "text": "一些角色等等。對。  《戰地》系列怎麼樣？ 《"}, {"type": "subtitle", "time": 1179.19, "timestamp": "00:19:39", "text": "戰地》的主角是誰？"}, {"type": "subtitle", "time": 1182.63, "timestamp": "00:19:42", "text": "或者說，遊戲的"}]
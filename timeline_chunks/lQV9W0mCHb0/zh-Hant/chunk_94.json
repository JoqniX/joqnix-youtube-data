[{"type": "subtitle", "time": 5662.39, "timestamp": "01:34:22", "text": "開火。  他怎麼還活著？他怎麼還活著？"}, {"type": "subtitle", "time": 5665.27, "timestamp": "01:34:25", "text": "他是如何移動的？  是啊，那裝飾真是太糟糕了。所以，"}, {"type": "subtitle", "time": 5688.229, "timestamp": "01:34:48", "text": "我的"}, {"type": "subtitle", "time": 5691.59, "timestamp": "01:34:51", "text": "遊戲卡頓了。"}]
[{"type": "subtitle", "time": 181.35, "timestamp": "00:03:01", "text": "我不知道會發生什麼事。這是我第一次玩這款"}, {"type": "subtitle", "time": 185.35, "timestamp": "00:03:05", "text": "遊戲。我們走吧"}, {"type": "subtitle", "time": 188.71, "timestamp": "00:03:08", "text": "。  我們走吧。我們走吧。"}, {"type": "subtitle", "time": 190.71, "timestamp": "00:03:10", "text": "戰場。"}, {"type": "subtitle", "time": 195.03, "timestamp": "00:03:15", "text": "明天是《戰地6》，呃，下午1點30分。"}, {"type": "subtitle", "time": 198.149, "timestamp": "00:03:18", "text": "呃，《戰地6》第二"}, {"type": "subtitle", "time": 201.589, "timestamp": "00:03:21", "text": "週的beta測試就要開始了。所以，我們會努力"}, {"type": "subtitle", "time": 204.79, "timestamp": "00:03:24", "text": "奮鬥。我會切換到我的 OBS"}, {"type": "subtitle", "time": 206.55, "timestamp": "00:03:26", "text": "設定"}, {"type": "subtitle", "time": 211.11, "timestamp": "00:03:31", "text": "來玩《戰地》遊戲。"}, {"type": "subtitle", "time": 214.149, "timestamp": "00:03:34", "text": "好的，自訂。這是什麼？哦，每個"}, {"type": "subtitle", "time": 216.55, "timestamp": "00:03:36", "text": "物品都有多個類別，可以更改物品的類別"}, {"type": "subtitle", "time": 219.43, "timestamp": "00:03:39", "text": "。"}, {"type": "subtitle", "time": 223.03, "timestamp": "00:03:43", "text": "啊，設備。"}, {"type": "subtitle", "time": 225.91, "timestamp": "00:03:45", "text": "我覺得自己老了。這遊戲都這麼老了，"}, {"type": "subtitle", "time": 229.99, "timestamp": "00:03:49", "text": "老兄。搞什麼鬼？你可以給它塗漆。"}, {"type": "subtitle", "time": 239.19, "timestamp": "00:03:59", "text": "哇。好的。  我的天啊。  我的天啊。"}]
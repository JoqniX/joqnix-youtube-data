[{"type": "subtitle", "time": 7693.35, "timestamp": "02:08:13", "text": "フレームレートがゼロに落ちて、これを溶かしてしまうことはありません"}, {"type": "subtitle", "time": 7696.629, "timestamp": "02:08:16", "text": "。 待って。  1秒。 できますか？"}, {"type": "subtitle", "time": 7699.189, "timestamp": "02:08:19", "text": "本日発売。 わかった。 待って。 スタンド"}, {"type": "subtitle", "time": 7704.79, "timestamp": "02:08:24", "text": "後で時間があれば、テストしてみるといいでしょう。 修正にかかる"}, {"type": "subtitle", "time": 7707.51, "timestamp": "02:08:27", "text": "時間がご都合の良い時間かどうかお知らせください。 そして、"}, {"type": "subtitle", "time": 7715.589, "timestamp": "02:08:35", "text": "Windows ハードウェア バックエンドを更新して、代わりに"}, {"type": "subtitle", "time": 7720.069, "timestamp": "02:08:40", "text": "DX11 を使用するようにします。これにより、"}, {"type": "subtitle", "time": 7725.99, "timestamp": "02:08:45", "text": "DX D3D12 にのみ影響するメモリ リンクが回避されます。zip ファイルを"}, {"type": "subtitle", "time": 7731.189, "timestamp": "02:08:51", "text": "PC の任意の場所に指定し、標準"}, {"type": "subtitle", "time": 7733.99, "timestamp": "02:08:53", "text": "バージョンまたは MEL を起動します。これにより、エクスポートして待つ必要があるすべての設定と追加情報が保存されます。"}]
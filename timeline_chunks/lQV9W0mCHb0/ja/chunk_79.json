[{"type": "subtitle", "time": 4745.11, "timestamp": "01:19:05", "text": "パパ、一日中。"}, {"type": "subtitle", "time": 4782.07, "timestamp": "01:19:42", "text": "おお。"}, {"type": "subtitle", "time": 4784.149, "timestamp": "01:19:44", "text": "これは本当に混沌としている。"}, {"type": "subtitle", "time": 4788.07, "timestamp": "01:19:48", "text": "キルを取るのも難しい。 いやー、ストロードがバトルフィールド4をプレイしているのを見ていると、"}, {"type": "subtitle", "time": 4790.95, "timestamp": "01:19:50", "text": "彼は本当に"}, {"type": "subtitle", "time": 4794.47, "timestamp": "01:19:54", "text": "上手くプレイしているように感じたよ。 彼を見ていると、心が安らいだ。"}, {"type": "subtitle", "time": 4797.11, "timestamp": "01:19:57", "text": "実際にプレイしてみると、全く"}]
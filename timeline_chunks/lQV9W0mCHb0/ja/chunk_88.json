[{"type": "subtitle", "time": 5280.629, "timestamp": "01:28:00", "text": "主な目的は、顔のアップ写真を撮ることです。"}, {"type": "subtitle", "time": 5284.95, "timestamp": "01:28:04", "text": "ボディショットではなく、ポップなヘッドショット。"}, {"type": "subtitle", "time": 5287.189, "timestamp": "01:28:07", "text": "銃の反動には慣れていないんです"}, {"type": "subtitle", "time": 5289.83, "timestamp": "01:28:09", "text": "。 だから、"}, {"type": "subtitle", "time": 5293.03, "timestamp": "01:28:13", "text": "ちょっと難しいんです。"}, {"type": "subtitle", "time": 5327.75, "timestamp": "01:28:47", "text": "ナです。 なぜ私にそんなことをしたのですか？"}]
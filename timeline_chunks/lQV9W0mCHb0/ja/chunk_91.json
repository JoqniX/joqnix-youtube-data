[{"type": "subtitle", "time": 5472.47, "timestamp": "01:31:12", "text": "ああ、あいつが俺の獲物を横取りした。 その男はどこ"}, {"type": "subtitle", "time": 5475.59, "timestamp": "01:31:15", "text": "から来たのか？ おい、あいつ俺の獲物を横取りしたぞ。 あれなら"}, {"type": "subtitle", "time": 5477.75, "timestamp": "01:31:17", "text": "3キル2キルできたはずだ"}, {"type": "subtitle", "time": 5480.149, "timestamp": "01:31:20", "text": "。 なぜ来たのですか？ ああ、つまり、私たちは"}, {"type": "subtitle", "time": 5482.709, "timestamp": "01:31:22", "text": "同じチームなんです。 大丈夫。 でも、"}, {"type": "subtitle", "time": 5485.669, "timestamp": "01:31:25", "text": "今すぐ2キルが必要なんだ。   私には"}, {"type": "subtitle", "time": 5496.07, "timestamp": "01:31:36", "text": "必要がある。 獲物を仕留める必要がある。   獲物を仕留める"}, {"type": "subtitle", "time": 5504.31, "timestamp": "01:31:44", "text": "ネズミがいるだろう。   あなたが"}, {"type": "subtitle", "time": 5507.03, "timestamp": "01:31:47", "text": "見えてます。"}, {"type": "subtitle", "time": 5509.189, "timestamp": "01:31:49", "text": "本物の狙撃手が見える。"}, {"type": "subtitle", "time": 5513.43, "timestamp": "01:31:53", "text": "あのね？ スナイパーに切り替えます。"}, {"type": "subtitle", "time": 5515.83, "timestamp": "01:31:55", "text": "料理させてください。"}]
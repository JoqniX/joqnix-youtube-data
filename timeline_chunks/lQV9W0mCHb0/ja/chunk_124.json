[{"type": "subtitle", "time": 7450.47, "timestamp": "02:04:10", "text": "。"}, {"type": "subtitle", "time": 7452.55, "timestamp": "02:04:12", "text": "同じ。 今すぐ配信のスケジュールを設定します"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "。 わかった。 明日、何があっても、"}, {"type": "subtitle", "time": 7461.43, "timestamp": "02:04:21", "text": "ええ、バトルフィールド"}, {"type": "subtitle", "time": 7464.55, "timestamp": "02:04:24", "text": "6のオープンベータウィークエンドもプレイします。 よし、"}, {"type": "subtitle", "time": 7467.189, "timestamp": "02:04:27", "text": "明日の午後1時30分に、"}, {"type": "subtitle", "time": 7470.55, "timestamp": "02:04:30", "text": "全世界で配信するぞ。"}, {"type": "subtitle", "time": 7473.51, "timestamp": "02:04:33", "text": "同じ時間に列に並ぶことになります。"}, {"type": "subtitle", "time": 7477.51, "timestamp": "02:04:37", "text": "私たちは最善を尽くします。 うまくいけば、入れると思う"}, {"type": "subtitle", "time": 7479.43, "timestamp": "02:04:39", "text": "。"}, {"type": "subtitle", "time": 7494.07, "timestamp": "02:04:54", "text": "君は純粋だね。   わかった"}, {"type": "subtitle", "time": 7495.589, "timestamp": "02:04:55", "text": "。"}]
[{"type": "subtitle", "time": 6797.589, "timestamp": "01:53:17", "text": "明日まで待たなければならない。今日発売されるから。"}, {"type": "subtitle", "time": 6800.149, "timestamp": "01:53:20", "text": "ええ、おそらく明日でしょう。 俺たちは何度もいい"}, {"type": "subtitle", "time": 6802.47, "timestamp": "01:53:22", "text": "プレーをしそうな気がするよ"}, {"type": "subtitle", "time": 6806.47, "timestamp": "01:53:26", "text": "、兄弟。 私はひたすら努力し、"}, {"type": "subtitle", "time": 6812.79, "timestamp": "01:53:32", "text": "他の目標を急いで達成します。 我々は、"}, {"type": "subtitle", "time": 6814.79, "timestamp": "01:53:34", "text": "客観的な"}, {"type": "subtitle", "time": 6816.55, "timestamp": "01:53:36", "text": "課題を捉える必要がある。   ああ"}]
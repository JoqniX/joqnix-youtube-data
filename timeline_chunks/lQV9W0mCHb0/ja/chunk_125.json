[{"type": "subtitle", "time": 7504.87, "timestamp": "02:05:04", "text": "こちらをダウンロードしてください。"}, {"type": "subtitle", "time": 7509.99, "timestamp": "02:05:09", "text": "こんにちは。 私はグッチです。 良い。 明日、8月"}, {"type": "subtitle", "time": 7511.669, "timestamp": "02:05:11", "text": "14日。   午前"}, {"type": "subtitle", "time": 7517.43, "timestamp": "02:05:17", "text": "1時、いや、午後1時30分。"}, {"type": "subtitle", "time": 7520.79, "timestamp": "02:05:20", "text": "夕食は食べて昼食は食べずに、"}, {"type": "subtitle", "time": 7539.189, "timestamp": "02:05:39", "text": "メルがライブイベントをやるので、もっとプロモーション活動をしたかったんです。"}, {"type": "subtitle", "time": 7544.79, "timestamp": "02:05:44", "text": "それについていくつか動画を作りたかったんです。 なんで私は"}, {"type": "subtitle", "time": 7547.189, "timestamp": "02:05:47", "text": "あれこれ配信してるんだろう、って思うよね？ メル"}, {"type": "subtitle", "time": 7550.03, "timestamp": "02:05:50", "text": "関連のもの。"}]
[{"type": "subtitle", "time": 7867.669, "timestamp": "02:11:07", "text": "この新しいゲームは何ですか？ 日本のゲーム"}, {"type": "subtitle", "time": 7870.55, "timestamp": "02:11:10", "text": "モードキャリア。"}, {"type": "subtitle", "time": 7881.99, "timestamp": "02:11:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7891.03, "timestamp": "02:11:31", "text": "。 本日はここまでとさせていただきます。"}, {"type": "subtitle", "time": 7893.91, "timestamp": "02:11:33", "text": "これで終わりにします。 来てくださった"}, {"type": "subtitle", "time": 7896.39, "timestamp": "02:11:36", "text": "皆様、ありがとうございました。"}, {"type": "subtitle", "time": 7898.069, "timestamp": "02:11:38", "text": "えっと、"}, {"type": "subtitle", "time": 7900.149, "timestamp": "02:11:40", "text": "明日は"}, {"type": "subtitle", "time": 7905.27, "timestamp": "02:11:45", "text": "バトルフィールド6でお会いしましょう。よし、楽しみだ。 そして私はピューピューと撃ちまくり、"}, {"type": "subtitle", "time": 7910.95, "timestamp": "02:11:50", "text": "私たちは明白なことに切り替えます。 わかった。"}, {"type": "subtitle", "time": 7914.95, "timestamp": "02:11:54", "text": "メルが痛がりすぎる場合は、"}, {"type": "subtitle", "time": 7917.589, "timestamp": "02:11:57", "text": "OBSに切り替えます。"}]
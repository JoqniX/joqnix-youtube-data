[{"type": "subtitle", "time": 7155.589, "timestamp": "01:59:15", "text": "簡単なプレイヤー。 あなたには秘密があるに違いない。 それは環境"}, {"type": "subtitle", "time": 7165.75, "timestamp": "01:59:25", "text": "人々は無駄に列を作っている。 これだと"}, {"type": "subtitle", "time": 7168.149, "timestamp": "01:59:28", "text": "何もプレイできません。 なぜ"}, {"type": "subtitle", "time": 7172.229, "timestamp": "01:59:32", "text": "プレイしたいのですか？ おお。"}, {"type": "subtitle", "time": 7174.95, "timestamp": "01:59:34", "text": "ハミルトン版だよ、男。"}, {"type": "subtitle", "time": 7193.43, "timestamp": "01:59:53", "text": "でも、知らない人のために言っておくと、私は確かにそれをやり遂げました"}, {"type": "subtitle", "time": 7197.03, "timestamp": "01:59:57", "text": "。 これは私が手に入れました。"}, {"type": "subtitle", "time": 7199.83, "timestamp": "01:59:59", "text": "新星。 私は必死に努力していた。"}]
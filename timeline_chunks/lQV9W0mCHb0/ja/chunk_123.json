[{"type": "subtitle", "time": 7380.55, "timestamp": "02:03:00", "text": "日曜日、時間は十分ある。ひたすら頑張って、"}, {"type": "subtitle", "time": 7385.75, "timestamp": "02:03:05", "text": "チャレンジを優先してクリアしなきゃ。"}, {"type": "subtitle", "time": 7388.31, "timestamp": "02:03:08", "text": "チャレンジを優先して"}, {"type": "subtitle", "time": 7401.75, "timestamp": "02:03:21", "text": "バトルフィールドを何回プレイしたっけ？"}, {"type": "subtitle", "time": 7428.07, "timestamp": "02:03:48", "text": "ライブ配信中です。 わかった。 私は"}, {"type": "subtitle", "time": 7430.31, "timestamp": "02:03:50", "text": "バトルフィールドをプレイしたことがあります。"}, {"type": "subtitle", "time": 7432.149, "timestamp": "02:03:52", "text": "ああ、わかった。 これが3番目になります。   わかった"}]
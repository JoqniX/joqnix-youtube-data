[{"type": "subtitle", "time": 2943.51, "timestamp": "00:49:03", "text": "大丈夫。 大丈夫、任せて。"}, {"type": "subtitle", "time": 2948.63, "timestamp": "00:49:08", "text": "このゲームでより多くのキルを獲得する最良の方法は、高所を見つけることだと思う"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "。"}, {"type": "subtitle", "time": 2953.19, "timestamp": "00:49:13", "text": "すべて"}, {"type": "subtitle", "time": 2954.91, "timestamp": "00:49:14", "text": "l"}, {"type": "subtitle", "time": 2957.589, "timestamp": "00:49:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2960.47, "timestamp": "00:49:20", "text": "私は死にかけています。 何人殺した？ 八。 ああ、私は"}, {"type": "subtitle", "time": 2963.19, "timestamp": "00:49:23", "text": "8人倒しました。 ああ、しまった"}, {"type": "subtitle", "time": 2983.43, "timestamp": "00:49:43", "text": "ニース。"}, {"type": "subtitle", "time": 2997.91, "timestamp": "00:49:57", "text": "ああ、"}]
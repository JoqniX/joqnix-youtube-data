[{"type": "subtitle", "time": 62.31, "timestamp": "00:01:02", "text": "バトルフィールド4をプレイします。とても"}, {"type": "subtitle", "time": 66.31, "timestamp": "00:01:06", "text": "楽しみです。   すごく"}, {"type": "subtitle", "time": 69.429, "timestamp": "00:01:09", "text": "興奮してる。"}, {"type": "subtitle", "time": 72.95, "timestamp": "00:01:12", "text": "今この瞬間、色々な感情が込み上げてきます。"}, {"type": "subtitle", "time": 74.95, "timestamp": "00:01:14", "text": "【音楽】"}, {"type": "subtitle", "time": 78.07, "timestamp": "00:01:18", "text": "でも、今日は思いっきり楽しもう"}, {"type": "subtitle", "time": 80.789, "timestamp": "00:01:20", "text": "。 わかった。"}, {"type": "subtitle", "time": 85.749, "timestamp": "00:01:25", "text": "それでは早速ゲームを始めましょうか？"}, {"type": "subtitle", "time": 91.749, "timestamp": "00:01:31", "text": "えっと、シーンを切り替えますね。もしくは、"}, {"type": "subtitle", "time": 95.91, "timestamp": "00:01:35", "text": "皆さん、これ見えますよね？ わかった。 えっと、"}, {"type": "subtitle", "time": 99.27000000000001, "timestamp": "00:01:39", "text": "こんにちは、バトルフィールド。 ピューピューが来た"}, {"type": "subtitle", "time": 101.35, "timestamp": "00:01:41", "text": "。   さあ行こう"}, {"type": "subtitle", "time": 103.429, "timestamp": "00:01:43", "text": "。"}, {"type": "subtitle", "time": 105.67, "timestamp": "00:01:45", "text": "戦場でピュンピュン。"}, {"type": "subtitle", "time": 109.83, "timestamp": "00:01:49", "text": "今日はFPSを上げるためにPNGチューバーを使ってみます。 そして、"}, {"type": "subtitle", "time": 116.789, "timestamp": "00:01:56", "text": "Call of"}, {"type": "subtitle", "time": 119.91, "timestamp": "00:01:59", "text": "Duty、いやBattlefield 6のためにリセットしてから数日経ってから、"}]
[{"type": "subtitle", "time": 7321.75, "timestamp": "02:02:01", "text": "みんながプレイし始めたら、私たちも"}, {"type": "subtitle", "time": 7324.55, "timestamp": "02:02:04", "text": "プレイします。"}, {"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "うん。 ちょっと待って、実際にサムネイルを作ってみるよ"}, {"type": "subtitle", "time": 7328.31, "timestamp": "02:02:08", "text": "。"}, {"type": "subtitle", "time": 7330.47, "timestamp": "02:02:10", "text": "1秒。"}, {"type": "subtitle", "time": 7332.87, "timestamp": "02:02:12", "text": "マーベル バトルフィールド 6 オープンベータ ウィークエンド"}, {"type": "subtitle", "time": 7338.709, "timestamp": "02:02:18", "text": "うん、明日は"}, {"type": "subtitle", "time": 7342.87, "timestamp": "02:02:22", "text": "4 時か 6 時くらいまでプレイするつもりだよ。 それから、"}, {"type": "subtitle", "time": 7356.629, "timestamp": "02:02:36", "text": "残りのことをします。 うん。 だから、"}, {"type": "subtitle", "time": 7359.43, "timestamp": "02:02:39", "text": "木曜日、金曜日、土曜日の3日間、"}, {"type": "subtitle", "time": 7363.109, "timestamp": "02:02:43", "text": "2日間はないんだ。 土曜日はコラボ"}, {"type": "subtitle", "time": 7367.589, "timestamp": "02:02:47", "text": "DNDショーがあって、6時からなんだ。だから朝の"}, {"type": "subtitle", "time": 7371.669, "timestamp": "02:02:51", "text": "6時から、神のみぞ知る12時まで、それから"}, {"type": "subtitle", "time": 7374.07, "timestamp": "02:02:54", "text": "休憩して、"}, {"type": "subtitle", "time": 7376.709, "timestamp": "02:02:56", "text": "土曜日のエネルギーを蓄えるんだ。日曜日は17日に終わるよね、そうだ、"}]
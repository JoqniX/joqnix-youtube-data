[{"type": "subtitle", "time": 5085.51, "timestamp": "01:24:45", "text": "どうして死んでないの？ 私は"}, {"type": "subtitle", "time": 5087.03, "timestamp": "01:24:47", "text": "あなたの顔面に銃弾を撃ち込むようなものだ。"}, {"type": "subtitle", "time": 5088.629, "timestamp": "01:24:48", "text": "[音楽]"}, {"type": "subtitle", "time": 5091.11, "timestamp": "01:24:51", "text": "君の顔はドンドンバコ"}, {"type": "subtitle", "time": 5094.07, "timestamp": "01:24:54", "text": "ダンになるはずだ。 それで、どうやって"}]
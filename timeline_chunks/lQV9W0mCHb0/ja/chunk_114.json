[{"type": "subtitle", "time": 6846.39, "timestamp": "01:54:06", "text": "遅くなるのは嫌だ。   ピューピューと撃ち"}, {"type": "subtitle", "time": 6850.87, "timestamp": "01:54:10", "text": "たい。 たとえ60fpsであっても。"}, {"type": "subtitle", "time": 6852.79, "timestamp": "01:54:12", "text": "キル数を稼げればそれで"}, {"type": "subtitle", "time": 6892.87, "timestamp": "01:54:52", "text": "そのブロックで止まってください。"}]
[{"type": "subtitle", "time": 1142.15, "timestamp": "00:19:02", "text": "BF3は、ロシア、アメリカ、"}, {"type": "subtitle", "time": 1145.51, "timestamp": "00:19:05", "text": "中東諸国のキャンペーンモードの中間のような存在だ。 ああ、待って、"}, {"type": "subtitle", "time": 1147.669, "timestamp": "00:19:07", "text": "キャンペーンがあると思うよ。"}, {"type": "subtitle", "time": 1149.75, "timestamp": "00:19:09", "text": "だから、バトルフィールド"}, {"type": "subtitle", "time": 1154.39, "timestamp": "00:19:14", "text": "6にもキャンペーンがあると思う。 いや、すごい"}, {"type": "subtitle", "time": 1161.83, "timestamp": "00:19:21", "text": "バトルフィールドのストーリーとは一体何なのでしょうか？"}, {"type": "subtitle", "time": 1165.669, "timestamp": "00:19:25", "text": "それは混沌や破壊のようなものだろうか？ ピューピュー"}, {"type": "subtitle", "time": 1167.83, "timestamp": "00:19:27", "text": "。"}, {"type": "subtitle", "time": 1171.11, "timestamp": "00:19:31", "text": "コールオブデューティみたいなゲームって何ですか？"}, {"type": "subtitle", "time": 1173.35, "timestamp": "00:19:33", "text": "幽霊とか、"}, {"type": "subtitle", "time": 1177.029, "timestamp": "00:19:37", "text": "キャラクターとかがいるのは知ってるよ。そうだね。"}, {"type": "subtitle", "time": 1179.19, "timestamp": "00:19:39", "text": "バトルフィールドはどうですか？ バトルフィールドの主人公は誰ですか？"}]
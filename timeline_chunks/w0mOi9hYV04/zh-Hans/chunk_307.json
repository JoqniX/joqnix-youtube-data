[{"type": "subtitle", "time": 18420.788, "timestamp": "05:07:00", "text": "和那位主播聊天愉快吗？我是谁？"}, {"type": "subtitle", "time": 18422.31, "timestamp": "05:07:02", "text": "没那么有趣吗？和"}, {"type": "subtitle", "time": 18424.55, "timestamp": "05:07:04", "text": "所以我以前也喜欢和别人比较。"}, {"type": "subtitle", "time": 18427.67, "timestamp": "05:07:07", "text": "很多时候，这种感觉就像有毒一样。"}, {"type": "subtitle", "time": 18430.47, "timestamp": "05:07:10", "text": "我仍然后悔经历了这一切。"}, {"type": "subtitle", "time": 18433.11, "timestamp": "05:07:13", "text": "现在进入下一阶段。是的，这就是那张脸"}, {"type": "subtitle", "time": 18435.948, "timestamp": "05:07:15", "text": "任何其他创作者都会去"}, {"type": "chat", "time": 18437.737, "timestamp": "05:07:17", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Ah that sucks, i think im doing the same "}, {"type": "subtitle", "time": 18439.51, "timestamp": "05:07:19", "text": "明白了吗？它。你可能会感到开始"}, {"type": "subtitle", "time": 18444.27, "timestamp": "05:07:24", "text": "感觉像果冻一样或像……"}, {"type": "subtitle", "time": 18447.708, "timestamp": "05:07:27", "text": "诸如此类，但是"}, {"type": "subtitle", "time": 18450.75, "timestamp": "05:07:30", "text": "记住，总会有……"}, {"type": "subtitle", "time": 18454.15, "timestamp": "05:07:34", "text": "任何领域、任何事物都存在竞争。"}, {"type": "subtitle", "time": 18456.708, "timestamp": "05:07:36", "text": "将来会出现更优秀的艺术家。"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "比你强。以后会有更好的。"}, {"type": "chat", "time": 18458.695, "timestamp": "05:07:38", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "it's a cannon event"}, {"type": "subtitle", "time": 18460.51, "timestamp": "05:07:40", "text": "比你更像歌手。将会有一个"}, {"type": "subtitle", "time": 18464.55, "timestamp": "05:07:44", "text": "比任何人都更优秀，无论以何种形式"}, {"type": "subtitle", "time": 18467.11, "timestamp": "05:07:47", "text": "是你，对吧？即使你只有20岁、30岁。"}, {"type": "subtitle", "time": 18469.83, "timestamp": "05:07:49", "text": "多年来一直做着你现在做的事情，但是"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "充满激情，让我们玩得就像……"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "就像钢琴家之类的，那边正在发生什么事"}, {"type": "subtitle", "time": 18476.628, "timestamp": "05:07:56", "text": "成为一位更优秀的9岁神童"}]
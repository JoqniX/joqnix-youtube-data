[{"type": "subtitle", "time": 17820.788, "timestamp": "04:57:00", "text": "无论你想以何种方式看待V型管"}, {"type": "subtitle", "time": 17823.03, "timestamp": "04:57:03", "text": "然而，无论你以传统方式看待它"}, {"type": "subtitle", "time": 17825.35, "timestamp": "04:57:05", "text": "你完全融入了你的角色，"}, {"type": "subtitle", "time": 17827.67, "timestamp": "04:57:07", "text": "不打破或不喜欢个人化"}, {"type": "subtitle", "time": 17830.07, "timestamp": "04:57:10", "text": "个人，或者如果您希望成为您的"}, {"type": "subtitle", "time": 17834.23, "timestamp": "04:57:14", "text": "做真实的自己，坦诚相待，真正地……"}, {"type": "subtitle", "time": 17836.948, "timestamp": "04:57:16", "text": "真诚地敞开心扉，说出你的感受"}, {"type": "subtitle", "time": 17840.23, "timestamp": "04:57:20", "text": "无论你选择哪条路，都不要后悔。"}, {"type": "subtitle", "time": 17843.03, "timestamp": "04:57:23", "text": "你做出的选择是因为在路上"}, {"type": "subtitle", "time": 17846.39, "timestamp": "04:57:26", "text": "这些都是你前进道路上的障碍。"}, {"type": "subtitle", "time": 17848.99, "timestamp": "04:57:28", "text": "你最终会遇到这种情况"}, {"type": "subtitle", "time": 17852.55, "timestamp": "04:57:32", "text": "比如说，一个新YouTuber推出了它"}, {"type": "subtitle", "time": 17854.47, "timestamp": "04:57:34", "text": "很多人过来，他们不得不"}, {"type": "subtitle", "time": 17856.628, "timestamp": "04:57:36", "text": "他们会非常紧张地阅读……"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "聊天等等，对吧？你可能也知道，对吧？"}, {"type": "subtitle", "time": 17862.11, "timestamp": "04:57:42", "text": "你开始直播的时候怎么样？"}, {"type": "subtitle", "time": 17864.628, "timestamp": "04:57:44", "text": "令人紧张的是，事实证明人们是对的"}, {"type": "subtitle", "time": 17867.59, "timestamp": "04:57:47", "text": "很多人都在说话等等"}, {"type": "chat", "time": 17868.097, "timestamp": "04:57:48", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}, {"type": "subtitle", "time": 17869.35, "timestamp": "04:57:49", "text": "你必须确保你读过"}, {"type": "subtitle", "time": 17872.868, "timestamp": "04:57:52", "text": "大家的留言等等，对吧？很多"}, {"type": "subtitle", "time": 17875.51, "timestamp": "04:57:55", "text": "事情就是这样，对吧？然后你慢慢地慢慢地"}, {"type": "subtitle", "time": 17878.23, "timestamp": "04:57:58", "text": "你适应了。然后你越适应，"}]
[{"type": "subtitle", "time": 8284.95, "timestamp": "02:18:04", "text": "后退。我的天哪，你居然在学习"}, {"type": "subtitle", "time": 8287.509, "timestamp": "02:18:07", "text": "西班牙语。好的。还有一件事。好的。好的。"}, {"type": "subtitle", "time": 8290.95, "timestamp": "02:18:10", "text": "对你有好处。对我来说，我必须学习呃"}, {"type": "subtitle", "time": 8294.07, "timestamp": "02:18:14", "text": "日本人，帮我补补日语。呃"}, {"type": "subtitle", "time": 8296.95, "timestamp": "02:18:16", "text": "最近，我和爱丽丝一起出去玩。"}, {"type": "subtitle", "time": 8299.429, "timestamp": "02:18:19", "text": "在VR聊天中，你猜怎么着？他不得不"}, {"type": "subtitle", "time": 8302.629, "timestamp": "02:18:22", "text": "带我走遍天下"}, {"type": "subtitle", "time": 8307.709, "timestamp": "02:18:27", "text": "呃，我们因为这个原因才进行了VR聊天。"}, {"type": "subtitle", "time": 8311.389, "timestamp": "02:18:31", "text": "Nihongo 是 Mukashi，Nihongo 是"}, {"type": "subtitle", "time": 8314.15, "timestamp": "02:18:34", "text": "难啊，日本人真难。我 我"}, {"type": "subtitle", "time": 8317.19, "timestamp": "02:18:37", "text": "他难道不能背我吗？"}, {"type": "subtitle", "time": 8320.669, "timestamp": "02:18:40", "text": "所以我必须学习呃"}, {"type": "subtitle", "time": 8326.629, "timestamp": "02:18:46", "text": "普通话可能很快就会普及，这样他们就可以了。"}, {"type": "subtitle", "time": 8327.709, "timestamp": "02:18:47", "text": "全部"}, {"type": "subtitle", "time": 8332.15, "timestamp": "02:18:52", "text": "中国CN星座"}, {"type": "subtitle", "time": 8335.709, "timestamp": "02:18:55", "text": "不会因为我而受苦"}, {"type": "subtitle", "time": 8339.589, "timestamp": "02:18:59", "text": "英语。是的。但我遇到了一位好朋友，"}]
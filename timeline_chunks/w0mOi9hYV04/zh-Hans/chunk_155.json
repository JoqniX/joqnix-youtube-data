[{"type": "subtitle", "time": 9301.19, "timestamp": "02:35:01", "text": "OBS 727.1 新版本存在漏洞。"}, {"type": "subtitle", "time": 9305.11, "timestamp": "02:35:05", "text": "嗯，你知道我，每当有新的"}, {"type": "subtitle", "time": 9309.59, "timestamp": "02:35:09", "text": "OBS 测试 alpha 测试内容发布"}, {"type": "subtitle", "time": 9313.19, "timestamp": "02:35:13", "text": "我先安装它，然后进行直播。"}, {"type": "subtitle", "time": 9316.03, "timestamp": "02:35:16", "text": "如果它坏了，而且是"}, {"type": "subtitle", "time": 9319.19, "timestamp": "02:35:19", "text": "好的，测试完毕，稍后汇报。"}, {"type": "subtitle", "time": 9322.79, "timestamp": "02:35:22", "text": "我们通过 Discord 发现了一些漏洞"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "GitHub那边一切都好了。是的，我不是"}, {"type": "subtitle", "time": 9329.91, "timestamp": "02:35:29", "text": "我只是说了而已。确实如此。"}, {"type": "subtitle", "time": 9332.71, "timestamp": "02:35:32", "text": "对比之类的。是的，我看到了。"}, {"type": "subtitle", "time": 9335.99, "timestamp": "02:35:35", "text": "它。我觉得他们稍微改变了一下。"}, {"type": "subtitle", "time": 9339.67, "timestamp": "02:35:39", "text": "那个，你管它叫什么？呃，那是什么？"}, {"type": "subtitle", "time": 9342.11, "timestamp": "02:35:42", "text": "这？它叫什么名字？"}, {"type": "subtitle", "time": 9347.19, "timestamp": "02:35:47", "text": "再次？色度等待图像"}, {"type": "subtitle", "time": 9351.349, "timestamp": "02:35:51", "text": "混合各种东西。我觉得这像是……"}, {"type": "subtitle", "time": 9354.63, "timestamp": "02:35:54", "text": "图像融合？不，并非如此。它是"}, {"type": "subtitle", "time": 9356.429, "timestamp": "02:35:56", "text": "色键？"}, {"type": "subtitle", "time": 9359.67, "timestamp": "02:35:59", "text": "不，可能是插件本身的问题。"}]
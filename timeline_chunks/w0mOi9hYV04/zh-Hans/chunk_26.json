[{"type": "subtitle", "time": 1560.95, "timestamp": "00:26:00", "text": "那天我会直播，我会唱歌"}, {"type": "subtitle", "time": 1563.11, "timestamp": "00:26:03", "text": "送你一首生日快乐歌。现在，当"}, {"type": "subtitle", "time": 1566.35, "timestamp": "00:26:06", "text": "今天是你的生日，乔克，你过生日了吗？"}, {"type": "subtitle", "time": 1570.75, "timestamp": "00:26:10", "text": "忘记？你忘了我的生日吗？"}, {"type": "subtitle", "time": 1575.31, "timestamp": "00:26:15", "text": "科拉。好的，我的生日在八月。"}, {"type": "subtitle", "time": 1578.31, "timestamp": "00:26:18", "text": "11号，如果你不知道我的生日的话，"}, {"type": "subtitle", "time": 1580.789, "timestamp": "00:26:20", "text": "您可以随时查看即将开始的直播。"}, {"type": "subtitle", "time": 1583.909, "timestamp": "00:26:23", "text": "其中包括日程安排和免费聊天"}, {"type": "subtitle", "time": 1587.59, "timestamp": "00:26:27", "text": "在那边。它永远都会是呃"}, {"type": "subtitle", "time": 1590.95, "timestamp": "00:26:30", "text": "提前一年安排的同一天"}, {"type": "subtitle", "time": 1594.47, "timestamp": "00:26:34", "text": "我的生日是。所以，以防万一"}, {"type": "subtitle", "time": 1597.59, "timestamp": "00:26:37", "text": "谁都会忘记。我完全没做那件事。"}, {"type": "subtitle", "time": 1599.59, "timestamp": "00:26:39", "text": "仅仅因为这样人们就可以"}, {"type": "subtitle", "time": 1607.029, "timestamp": "00:26:47", "text": "没有什么。我知道这很有趣。我觉得很有趣"}, {"type": "subtitle", "time": 1609.11, "timestamp": "00:26:49", "text": "捉弄你。等等，那是你吗？"}, {"type": "subtitle", "time": 1611.549, "timestamp": "00:26:51", "text": "跟我开玩笑。等待，"}, {"type": "subtitle", "time": 1614.85, "timestamp": "00:26:54", "text": "什么？我的天啊。"}, {"type": "subtitle", "time": 1616.99, "timestamp": "00:26:56", "text": "[音乐]"}, {"type": "subtitle", "time": 1619.71, "timestamp": "00:26:59", "text": "哇。"}]
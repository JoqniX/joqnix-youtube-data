[{"type": "subtitle", "time": 5761.669, "timestamp": "01:36:01", "text": "你的疼痛，呃，等等。是的，取消。哦，"}, {"type": "subtitle", "time": 5763.75, "timestamp": "01:36:03", "text": "等待。你说的“你的商品”是什么意思？"}, {"type": "subtitle", "time": 5766.95, "timestamp": "01:36:06", "text": "是的，它应该很快就会来了。不是"}, {"type": "subtitle", "time": 5770.31, "timestamp": "01:36:10", "text": "我无法保证。或许今年就能实现了。"}, {"type": "subtitle", "time": 5774.229, "timestamp": "01:36:14", "text": "大概。如果一切顺利，那很可能是好事"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "我"}, {"type": "subtitle", "time": 5779.11, "timestamp": "01:36:19", "text": "呃，我呃，今年或明年买。它"}, {"type": "subtitle", "time": 5788.31, "timestamp": "01:36:28", "text": "呃，解锁超级留言之类的功能，我"}, {"type": "subtitle", "time": 5790.55, "timestamp": "01:36:30", "text": "猜测。是啊，因为我得还钱。"}, {"type": "subtitle", "time": 5793.99, "timestamp": "01:36:33", "text": "所提供的商品以及所有那些"}, {"type": "subtitle", "time": 5796.79, "timestamp": "01:36:36", "text": "现在所有这些东西。哦，是的。嗯"}, {"type": "subtitle", "time": 5798.95, "timestamp": "01:36:38", "text": "是的。是的。是的。我要一些"}, {"type": "subtitle", "time": 5801.43, "timestamp": "01:36:41", "text": "人们致力于此。但是，嗯……"}, {"type": "subtitle", "time": 5803.59, "timestamp": "01:36:43", "text": "最终可能就在今年或明年"}, {"type": "subtitle", "time": 5806.47, "timestamp": "01:36:46", "text": "大概。我不知道，我不知道。我"}, {"type": "subtitle", "time": 5809.79, "timestamp": "01:36:49", "text": "不能。别引用我的话。"}, {"type": "subtitle", "time": 5813.189, "timestamp": "01:36:53", "text": "好的。呃，我的第一件周边产品即将上市"}, {"type": "subtitle", "time": 5815.91, "timestamp": "01:36:55", "text": "如果你将来发布的话，它就归你了。"}, {"type": "subtitle", "time": 5818.27, "timestamp": "01:36:58", "text": "是的，我会尽力的。"}]
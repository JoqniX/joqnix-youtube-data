[{"type": "subtitle", "time": 183.509, "timestamp": "00:03:03", "text": "是啊，兄弟。我想念大家。如何才能"}, {"type": "subtitle", "time": 191.39, "timestamp": "00:03:11", "text": "你好。怎么样？嗯，怎么样？"}, {"type": "subtitle", "time": 194.07, "timestamp": "00:03:14", "text": "生活？最近过得怎么样？感到自豪"}, {"type": "subtitle", "time": 197.91, "timestamp": "00:03:17", "text": "你，笨蛋。哦，恭喜你喜得贵子比利"}, {"type": "subtitle", "time": 200.47, "timestamp": "00:03:20", "text": "比利·乔。哦，谢谢。是的。是的。呃"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "直播进行得很顺利。只是"}, {"type": "subtitle", "time": 205.75, "timestamp": "00:03:25", "text": "我需要找到一个合适的时间，所以我"}, {"type": "subtitle", "time": 207.869, "timestamp": "00:03:27", "text": "可以在那里观看直播。"}, {"type": "subtitle", "time": 210.22899999999998, "timestamp": "00:03:30", "text": "一切。是的，目前为止是……"}, {"type": "subtitle", "time": 211.309, "timestamp": "00:03:31", "text": "去"}, {"type": "subtitle", "time": 216.43, "timestamp": "00:03:36", "text": "嗯嗯，到目前为止，嗯，一直是"}, {"type": "subtitle", "time": 219.19, "timestamp": "00:03:39", "text": "好的。最近很忙。你呢？是的，"}, {"type": "subtitle", "time": 224.07, "timestamp": "00:03:44", "text": "我也是。最近很忙。从未如此之好。"}, {"type": "subtitle", "time": 228.19, "timestamp": "00:03:48", "text": "是的，我也很忙。"}, {"type": "subtitle", "time": 232.309, "timestamp": "00:03:52", "text": "是的，今天和前天都是如此。"}, {"type": "subtitle", "time": 235.35, "timestamp": "00:03:55", "text": "在我做比利之前，我做不到"}, {"type": "subtitle", "time": 238.63, "timestamp": "00:03:58", "text": "就像一个正规的YouTube直播一样。不。是的。"}]
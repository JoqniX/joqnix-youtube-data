[{"type": "subtitle", "time": 5700.149, "timestamp": "01:35:00", "text": "这东西开着。是的。所以，在某些情况下"}, {"type": "subtitle", "time": 5702.47, "timestamp": "01:35:02", "text": "诸如此类的事情。不，我有这种感觉"}, {"type": "subtitle", "time": 5707.79, "timestamp": "01:35:07", "text": "事物。等待。嗯，如果我能弄到的话。"}, {"type": "subtitle", "time": 5710.43, "timestamp": "01:35:10", "text": "呃，哪里是"}, {"type": "subtitle", "time": 5714.47, "timestamp": "01:35:14", "text": "它？我有这个东西。哦，它太大了。"}, {"type": "subtitle", "time": 5717.91, "timestamp": "01:35:17", "text": "我的天哪，它太大了。呃，我的天哪。"}, {"type": "subtitle", "time": 5719.55, "timestamp": "01:35:19", "text": "刮蹭它"}, {"type": "subtitle", "time": 5722.47, "timestamp": "01:35:22", "text": "最好的。呃，我明白了。它是"}, {"type": "subtitle", "time": 5727.27, "timestamp": "01:35:27", "text": "字面上说，呃，跨性别者说，呃，"}, {"type": "subtitle", "time": 5730.79, "timestamp": "01:35:30", "text": "系统翻译，我的意思是，呃，就像系统一样"}, {"type": "subtitle", "time": 5732.95, "timestamp": "01:35:32", "text": "就像谷歌翻译机一样"}, {"type": "subtitle", "time": 5734.91, "timestamp": "01:35:34", "text": "翻译是"}, {"type": "subtitle", "time": 5738.149, "timestamp": "01:35:38", "text": "错误。呃，请原谅我。"}, {"type": "subtitle", "time": 5741.35, "timestamp": "01:35:41", "text": "如果你在跨性别群体中读到某些东西"}, {"type": "subtitle", "time": 5743.75, "timestamp": "01:35:43", "text": "不正确或其他什么。是的，我有"}, {"type": "subtitle", "time": 5747.11, "timestamp": "01:35:47", "text": "每次我都这样，哦，可能是这样。"}, {"type": "subtitle", "time": 5749.27, "timestamp": "01:35:49", "text": "在底部或顶部，所以人们"}, {"type": "subtitle", "time": 5752.629, "timestamp": "01:35:52", "text": "我能读懂它，你知道，因为我害怕"}]
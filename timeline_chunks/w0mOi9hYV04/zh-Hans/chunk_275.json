[{"type": "subtitle", "time": 16502.39, "timestamp": "04:35:02", "text": "呃，再说一遍。社区居民"}, {"type": "subtitle", "time": 16505.99, "timestamp": "04:35:05", "text": "我相信我的音乐会场地会一直保持紧密联系。"}, {"type": "subtitle", "time": 16507.07, "timestamp": "04:35:07", "text": "如果"}, {"type": "subtitle", "time": 16510.07, "timestamp": "04:35:10", "text": "他们会在我背后做这种事"}, {"type": "subtitle", "time": 16512.789, "timestamp": "04:35:12", "text": "或者拿我开玩笑，然后哈哈大笑。"}, {"type": "subtitle", "time": 16515.189, "timestamp": "04:35:15", "text": "尽管我做了我的"}, {"type": "subtitle", "time": 16518.31, "timestamp": "04:35:18", "text": "最好是喜欢他们或者取悦他们。"}, {"type": "subtitle", "time": 16520.789, "timestamp": "04:35:20", "text": "随便什么都行，只要让他们留下来就行。"}, {"type": "subtitle", "time": 16522.869, "timestamp": "04:35:22", "text": "上帝啊，我感觉自己就像……"}, {"type": "subtitle", "time": 16525.83, "timestamp": "04:35:25", "text": "自我嘲讽一下，不过还是留下来吧。"}, {"type": "subtitle", "time": 16528.23, "timestamp": "04:35:28", "text": "注意我，别忽视我。"}, {"type": "subtitle", "time": 16530.949, "timestamp": "04:35:30", "text": "不想被视为无聊的油管博主等等。"}, {"type": "subtitle", "time": 16533.349, "timestamp": "04:35:33", "text": "我把那些给他们，他们就疑惑不解等等。"}, {"type": "subtitle", "time": 16535.349, "timestamp": "04:35:35", "text": "他们做类似的事情就是"}, {"type": "subtitle", "time": 16536.869, "timestamp": "04:35:36", "text": "开玩笑之类的。当然，我会的"}, {"type": "subtitle", "time": 16540.269, "timestamp": "04:35:40", "text": "我会心碎，而且会非常伤心，因为"}, {"type": "subtitle", "time": 16543.99, "timestamp": "04:35:43", "text": "现在，从某种意义上说，我正在投入我的时间和精力。"}, {"type": "subtitle", "time": 16546.47, "timestamp": "04:35:46", "text": "现在要慢慢地努力和一切"}, {"type": "subtitle", "time": 16550.23, "timestamp": "04:35:50", "text": "尽我所能，把这个做好"}, {"type": "subtitle", "time": 16553.349, "timestamp": "04:35:53", "text": "我是一个喜欢做事情的YouTuber，我在那里做很多事情。"}, {"type": "subtitle", "time": 16555.67, "timestamp": "04:35:55", "text": "乐趣。这是我们的爱好，对吧？对许多人来说"}]
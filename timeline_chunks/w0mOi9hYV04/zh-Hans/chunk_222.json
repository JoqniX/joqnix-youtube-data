[{"type": "subtitle", "time": 13320.469, "timestamp": "03:42:00", "text": "向上。现在差距很大。是的，"}, {"type": "subtitle", "time": 13322.71, "timestamp": "03:42:02", "text": "我把支架放在这里，"}, {"type": "subtitle", "time": 13325.07, "timestamp": "03:42:05", "text": "我把它做成了这样"}, {"type": "subtitle", "time": 13329.79, "timestamp": "03:42:09", "text": "这。手机会在这里，我会……"}, {"type": "subtitle", "time": 13333.83, "timestamp": "03:42:13", "text": "这里。乔克会来，我也来了。"}, {"type": "subtitle", "time": 13336.55, "timestamp": "03:42:16", "text": "这样做。所以现在我只想要这个"}, {"type": "subtitle", "time": 13339.469, "timestamp": "03:42:19", "text": "这东西只适合这个角落"}, {"type": "subtitle", "time": 13343.349, "timestamp": "03:42:23", "text": "很多。就是这样。之前是合身"}, {"type": "subtitle", "time": 13351.349, "timestamp": "03:42:31", "text": "你明白吗？我的画是"}, {"type": "subtitle", "time": 13355.11, "timestamp": "03:42:35", "text": "表现出痛苦。所以，如果没有人，一切都没问题。"}]
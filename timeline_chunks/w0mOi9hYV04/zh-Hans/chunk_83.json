[{"type": "subtitle", "time": 4982.07, "timestamp": "01:23:02", "text": "像我们直播或Kick这样的平台"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "现实或比利比利，所有这些都将是"}, {"type": "subtitle", "time": 4986.709, "timestamp": "01:23:06", "text": "现在就在黑板上了。但你是"}, {"type": "subtitle", "time": 4989.51, "timestamp": "01:23:09", "text": "某种程度上是胡萝卜，但又不像我。"}, {"type": "subtitle", "time": 4992.47, "timestamp": "01:23:12", "text": "我知道我必须为此做点什么。"}, {"type": "subtitle", "time": 4996.229, "timestamp": "01:23:16", "text": "大概呃呃，管理层会揍我。"}, {"type": "subtitle", "time": 4999.669, "timestamp": "01:23:19", "text": "而且就像……嗯，你这个运动员……"}, {"type": "subtitle", "time": 5003.35, "timestamp": "01:23:23", "text": "给你提供一些搞笑的东西，我就想说："}, {"type": "subtitle", "time": 5006.47, "timestamp": "01:23:26", "text": "是的，我的意思是，严格来说，是董事会或"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "主频道会像我的频道一样，所以"}, {"type": "subtitle", "time": 5012.83, "timestamp": "01:23:32", "text": "它现在和我连在一起了，所以没问题。"}, {"type": "subtitle", "time": 5015.75, "timestamp": "01:23:35", "text": "猜猜看，是的，终于要亮相了，我要去了。"}, {"type": "subtitle", "time": 5018.629, "timestamp": "01:23:38", "text": "我花了250美元买到了音乐转码许可证。"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "我有点脸红了。我高兴极了。"}, {"type": "subtitle", "time": 5022.99, "timestamp": "01:23:42", "text": "我们开始吧"}, {"type": "subtitle", "time": 5026.149, "timestamp": "01:23:46", "text": "去。我们走吧。艾森，我为你感到高兴。"}, {"type": "subtitle", "time": 5030.55, "timestamp": "01:23:50", "text": "我的天哪，你真是个勤奋的人！"}, {"type": "subtitle", "time": 5033.629, "timestamp": "01:23:53", "text": "音乐制作人，音乐家。你是我"}, {"type": "subtitle", "time": 5037.99, "timestamp": "01:23:57", "text": "高兴的。我很高兴我们……还有所有的音乐"}]
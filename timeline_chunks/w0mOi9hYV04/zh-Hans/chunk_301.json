[{"type": "subtitle", "time": 18061.788, "timestamp": "05:01:01", "text": "很久以前就认识这些即时通讯 YouTuber 了"}, {"type": "subtitle", "time": 18064.91, "timestamp": "05:01:04", "text": "页面上有我激励的人。"}, {"type": "subtitle", "time": 18068.868, "timestamp": "05:01:08", "text": "是我第一个认识并与之建立联系的人"}, {"type": "subtitle", "time": 18072.31, "timestamp": "05:01:12", "text": "所有油管博主都这样，但是，是啊，什么？"}, {"type": "subtitle", "time": 18074.628, "timestamp": "05:01:14", "text": "事情发生在我和他们在一起的时候"}, {"type": "subtitle", "time": 18079.39, "timestamp": "05:01:19", "text": "新车型一亮相就火了起来"}, {"type": "subtitle", "time": 18082.15, "timestamp": "05:01:22", "text": "因为削波通道之一"}, {"type": "subtitle", "time": 18084.948, "timestamp": "05:01:24", "text": "剪辑频道给他们打了电话，然后……"}, {"type": "subtitle", "time": 18086.788, "timestamp": "05:01:26", "text": "在首播直播期间或其他类似情况下"}, {"type": "subtitle", "time": 18089.75, "timestamp": "05:01:29", "text": "他们推广了数以万计的产品。"}, {"type": "subtitle", "time": 18093.59, "timestamp": "05:01:33", "text": "有人来看我的首播直播。"}, {"type": "subtitle", "time": 18104.15, "timestamp": "05:01:44", "text": "呃，我们的朋友们喜欢首秀直播"}, {"type": "subtitle", "time": 18106.788, "timestamp": "05:01:46", "text": "我们都为她感到非常高兴。"}, {"type": "subtitle", "time": 18109.07, "timestamp": "05:01:49", "text": "对他们来说，没错"}, {"type": "subtitle", "time": 18111.91, "timestamp": "05:01:51", "text": "而且由于很多人的崛起……"}, {"type": "subtitle", "time": 18114.31, "timestamp": "05:01:54", "text": "她来了，声音洪亮"}, {"type": "subtitle", "time": 18117.43, "timestamp": "05:01:57", "text": "呃，还有住宿之类的。所以呢"}]
[{"type": "subtitle", "time": 1862.47, "timestamp": "00:31:02", "text": "嗯，说实话，我有点害怕。呃"}, {"type": "subtitle", "time": 1866.23, "timestamp": "00:31:06", "text": "等等，呃，这个游戏是免费的吗？"}, {"type": "subtitle", "time": 1868.95, "timestamp": "00:31:08", "text": "问号。哦，你非得买它不可。"}, {"type": "subtitle", "time": 1871.75, "timestamp": "00:31:11", "text": "好吧，看来你得买了。"}, {"type": "subtitle", "time": 1877.149, "timestamp": "00:31:17", "text": "好的，"}, {"type": "subtitle", "time": 1879.23, "timestamp": "00:31:19", "text": "可以理解。它是"}, {"type": "subtitle", "time": 1882.99, "timestamp": "00:31:22", "text": "好的。看看酱汁"}, {"type": "subtitle", "time": 1886.07, "timestamp": "00:31:26", "text": "有趣的。是的。你好，索尔。欢迎来到"}, {"type": "subtitle", "time": 1888.029, "timestamp": "00:31:28", "text": "溪流。希望你一切顺利"}, {"type": "subtitle", "time": 1892.389, "timestamp": "00:31:32", "text": "出色地。你好。你好。韩国你自己慢跑"}, {"type": "subtitle", "time": 1896.35, "timestamp": "00:31:36", "text": "7月26日到我家。你好。"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "什么？韩国人。你好。哦。嗨"}, {"type": "subtitle", "time": 1904.269, "timestamp": "00:31:44", "text": "相信"}, {"type": "subtitle", "time": 1910.21, "timestamp": "00:31:50", "text": "嗯，我是说今年，也许吧。"}, {"type": "subtitle", "time": 1913.23, "timestamp": "00:31:53", "text": "[音乐]"}, {"type": "subtitle", "time": 1917.029, "timestamp": "00:31:57", "text": "嗯，今年或许会有很多。"}, {"type": "subtitle", "time": 1918.59, "timestamp": "00:31:58", "text": "在"}]
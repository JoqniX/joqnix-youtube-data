[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "是的。是的。所以，呃，呃，昨天今天"}, {"type": "subtitle", "time": 244.83, "timestamp": "00:04:04", "text": "实际上，如果我不知道我是否"}, {"type": "subtitle", "time": 248.27, "timestamp": "00:04:08", "text": "我之前提到过，对于那些不了解的人来说，"}, {"type": "subtitle", "time": 254.22899999999998, "timestamp": "00:04:14", "text": "嗯，我带了我的踏板车。呃，"}, {"type": "subtitle", "time": 255.83, "timestamp": "00:04:15", "text": "等等，这两者之间有什么区别？"}, {"type": "subtitle", "time": 258.229, "timestamp": "00:04:18", "text": "Scooty 和 Scoeter 又来了？我不"}, {"type": "subtitle", "time": 260.949, "timestamp": "00:04:20", "text": "知道。是的，就是我父母的那位"}, {"type": "subtitle", "time": 263.51, "timestamp": "00:04:23", "text": "买下了我。那件，呃，我把它买回来了。"}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "在这里，实际上我一直都在，我做了我的"}, {"type": "subtitle", "time": 269.27, "timestamp": "00:04:29", "text": "最好从我家骑车到这里。"}, {"type": "subtitle", "time": 271.95, "timestamp": "00:04:31", "text": "我住的地方。哎，真是的"}, {"type": "subtitle", "time": 275.51, "timestamp": "00:04:35", "text": "我简直不敢相信我"}, {"type": "subtitle", "time": 278.469, "timestamp": "00:04:38", "text": "真的做到了。我没撞到车。我"}, {"type": "subtitle", "time": 282.23, "timestamp": "00:04:42", "text": "没有撞到公交车。你知道我"}, {"type": "subtitle", "time": 285.11, "timestamp": "00:04:45", "text": "直接开着GTA之类的。对于那些"}, {"type": "subtitle", "time": 287.35, "timestamp": "00:04:47", "text": "谁看过我的GTA游戏，或者喜欢赛车游戏？"}, {"type": "subtitle", "time": 294.55, "timestamp": "00:04:54", "text": "但那是开车的情况。但这与"}, {"type": "subtitle", "time": 296.35, "timestamp": "00:04:56", "text": "踏板车或类似"}, {"type": "subtitle", "time": 299.909, "timestamp": "00:04:59", "text": "摩托车也是，对吧？是的。今天我"}]
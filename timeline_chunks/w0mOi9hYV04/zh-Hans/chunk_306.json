[{"type": "subtitle", "time": 18360.51, "timestamp": "05:06:00", "text": "我难道不够有趣吗？"}, {"type": "chat", "time": 18361.765, "timestamp": "05:06:01", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAgUCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAg"}, {"type": "chat", "time": 18363.908, "timestamp": "05:06:03", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Aww lmao that made me laughhh"}, {"type": "subtitle", "time": 18364.708, "timestamp": "05:06:04", "text": "你喜欢吗？我想，呃，在某些方面。"}, {"type": "subtitle", "time": 18367.43, "timestamp": "05:06:07", "text": "呃，每当我记录聊天记录的时候"}, {"type": "subtitle", "time": 18368.59, "timestamp": "05:06:08", "text": "就在我"}, {"type": "subtitle", "time": 18371.75, "timestamp": "05:06:11", "text": "混乱，人们看到了，看到了，看到了。"}, {"type": "subtitle", "time": 18376.708, "timestamp": "05:06:16", "text": "就像哦，天哪，狗狗在开玩笑，它嫉妒了"}, {"type": "subtitle", "time": 18383.43, "timestamp": "05:06:23", "text": "模式，但是，嗯，所以，我的意思是……"}, {"type": "subtitle", "time": 18387.11, "timestamp": "05:06:27", "text": "这么说吧，我现在仍然有这种感觉。"}, {"type": "subtitle", "time": 18389.59, "timestamp": "05:06:29", "text": "感觉我没有一个像样的社区。"}, {"type": "subtitle", "time": 18392.15, "timestamp": "05:06:32", "text": "或许是因为我们有一个共同点"}, {"type": "subtitle", "time": 18395.59, "timestamp": "05:06:35", "text": "拥有众多观看量的 YouTuber 的观众。"}, {"type": "subtitle", "time": 18398.47, "timestamp": "05:06:38", "text": "我猜很多 YouTuber 都是这样……"}, {"type": "subtitle", "time": 18401.59, "timestamp": "05:06:41", "text": "许多观看我音频作品的人"}, {"type": "subtitle", "time": 18405.11, "timestamp": "05:06:45", "text": "观察其他人，有时就像长时间观察一样。"}, {"type": "subtitle", "time": 18410.07, "timestamp": "05:06:50", "text": "以前这让我很生气，心想：为什么？"}, {"type": "subtitle", "time": 18413.43, "timestamp": "05:06:53", "text": "你是不是不像以前那样爱聊天了？"}, {"type": "subtitle", "time": 18415.75, "timestamp": "05:06:55", "text": "就像你来过一样，你来到了我的直播间。"}, {"type": "subtitle", "time": 18418.15, "timestamp": "05:06:58", "text": "跟我聊聊吧，但你为什么会有这种感觉？"}]
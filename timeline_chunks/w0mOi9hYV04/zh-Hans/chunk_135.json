[{"type": "subtitle", "time": 8100.47, "timestamp": "02:15:00", "text": "关心。祝你一切顺利。好的。"}, {"type": "subtitle", "time": 8101.95, "timestamp": "02:15:01", "text": "感谢您的调频"}, {"type": "subtitle", "time": 8105.669, "timestamp": "02:15:05", "text": "希望你能赶上，也希望你能追上我。"}, {"type": "subtitle", "time": 8108.47, "timestamp": "02:15:08", "text": "下一期。小心。玩得开心！"}, {"type": "subtitle", "time": 8110.31, "timestamp": "02:15:10", "text": "祝你相信自己能成功"}, {"type": "subtitle", "time": 8112.47, "timestamp": "02:15:12", "text": "参加考试。带着考试回来"}, {"type": "subtitle", "time": 8117.149, "timestamp": "02:15:17", "text": "东西。你看，现在发生了什么事？"}, {"type": "subtitle", "time": 8119.79, "timestamp": "02:15:19", "text": "翻译？哦，至少还有这一点。"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "哦，是的。现在是10点30分。"}, {"type": "subtitle", "time": 8135.589, "timestamp": "02:15:35", "text": "我会在10:30结束直播。好的。所以，"}, {"type": "subtitle", "time": 8137.91, "timestamp": "02:15:37", "text": "我把所有事情都收拾好就去睡觉。"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "到11点。"}, {"type": "subtitle", "time": 8145.35, "timestamp": "02:15:45", "text": "是的。是的。所以，呃，是的，将会……"}, {"type": "subtitle", "time": 8147.43, "timestamp": "02:15:47", "text": "有很多事情正在发生"}, {"type": "subtitle", "time": 8150.35, "timestamp": "02:15:50", "text": "未来几个月。我是"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "害怕的。我很害怕。我很高兴，而且"}, {"type": "subtitle", "time": 8156.629, "timestamp": "02:15:56", "text": "同时感到害怕。所以，我不"}, {"type": "subtitle", "time": 8159.79, "timestamp": "02:15:59", "text": "知道事情会如何发展，"}]
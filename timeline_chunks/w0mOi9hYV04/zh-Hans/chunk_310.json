[{"type": "subtitle", "time": 18603.19, "timestamp": "05:10:03", "text": "你玩的游戏。他们来这里是因为……"}, {"type": "subtitle", "time": 18605.628, "timestamp": "05:10:05", "text": "他们会帮助你的。为了"}, {"type": "subtitle", "time": 18609.03, "timestamp": "05:10:09", "text": "因为他们喜欢了解你，"}, {"type": "subtitle", "time": 18611.67, "timestamp": "05:10:11", "text": "你的性格，你的为人等等。你的"}, {"type": "chat", "time": 18613.729, "timestamp": "05:10:13", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Hm i get it :)"}, {"type": "subtitle", "time": 18613.91, "timestamp": "05:10:13", "text": "起起落落，你的快乐时光，你的"}, {"type": "subtitle", "time": 18616.628, "timestamp": "05:10:16", "text": "悲伤的时刻，你尴尬的时刻，"}, {"type": "subtitle", "time": 18618.03, "timestamp": "05:10:18", "text": "等等。无论你"}, {"type": "subtitle", "time": 18620.27, "timestamp": "05:10:20", "text": "描绘"}, {"type": "subtitle", "time": 18622.55, "timestamp": "05:10:22", "text": "流媒体，总会有的。"}, {"type": "subtitle", "time": 18624.868, "timestamp": "05:10:24", "text": "那些会在你需要的时候陪伴在你身边的人。"}, {"type": "subtitle", "time": 18625.948, "timestamp": "05:10:25", "text": "记住"}, {"type": "subtitle", "time": 18630.07, "timestamp": "05:10:30", "text": "那。而大多数事情之一"}, {"type": "subtitle", "time": 18633.43, "timestamp": "05:10:33", "text": "我们总是只看到负面的东西。"}, {"type": "subtitle", "time": 18634.67, "timestamp": "05:10:34", "text": "边。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "不，你总是只看到负面的一面。"}, {"type": "subtitle", "time": 18640.35, "timestamp": "05:10:40", "text": "忘记那些积极的方面吧。"}, {"type": "subtitle", "time": 18643.11, "timestamp": "05:10:43", "text": "正确的？就像一件负面的事情"}, {"type": "subtitle", "time": 18645.99, "timestamp": "05:10:45", "text": "你会不会一直想着这件事？"}, {"type": "subtitle", "time": 18647.67, "timestamp": "05:10:47", "text": "因为这会影响到你。那就是"}, {"type": "subtitle", "time": 18649.15, "timestamp": "05:10:49", "text": "人性。"}, {"type": "subtitle", "time": 18653.43, "timestamp": "05:10:53", "text": "不，但我们呃，会失去联系，或者就像我们"}, {"type": "subtitle", "time": 18656.43, "timestamp": "05:10:56", "text": "忽略了美好的事物"}, {"type": "subtitle", "time": 18659.83, "timestamp": "05:10:59", "text": "有时。所以如果你开始学习"}]
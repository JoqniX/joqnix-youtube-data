[{"type": "subtitle", "time": 601.99, "timestamp": "00:10:01", "text": "明天喝热腾腾的鲭鱼汤。最多"}, {"type": "subtitle", "time": 604.07, "timestamp": "00:10:04", "text": "可能明天。下次我去那里的时候"}, {"type": "subtitle", "time": 607.59, "timestamp": "00:10:07", "text": "餐厅。是的。这不太好。我是"}, {"type": "subtitle", "time": 610.59, "timestamp": "00:10:10", "text": "当我对他人构成危险时"}, {"type": "subtitle", "time": 613.35, "timestamp": "00:10:13", "text": "驾驶。骑师从巴士上被抬升到"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "摩托车行驶的声音。是的。嗯，是的。是的。是的。"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "去。 Joy，你今天看起来很高兴。"}, {"type": "subtitle", "time": 628.71, "timestamp": "00:10:28", "text": "我很高兴。等等，我的模型怎么卡住了？我"}, {"type": "subtitle", "time": 632.15, "timestamp": "00:10:32", "text": "不知道为什么。有时我的模型"}, {"type": "subtitle", "time": 634.11, "timestamp": "00:10:34", "text": "保持"}, {"type": "subtitle", "time": 638.069, "timestamp": "00:10:38", "text": "好像卡住了。它卡住了。"}, {"type": "subtitle", "time": 641.269, "timestamp": "00:10:41", "text": "彻底卡住了。现在它看起来就像这样"}, {"type": "subtitle", "time": 644.15, "timestamp": "00:10:44", "text": "就像我做的所有动作一样，"}, {"type": "subtitle", "time": 648.15, "timestamp": "00:10:48", "text": "就像，呃，就像你，你很快"}, {"type": "subtitle", "time": 655.91, "timestamp": "00:10:55", "text": "发现和努力是件好事。是的。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "是的。是的。这碗汤大概100卢比。"}]
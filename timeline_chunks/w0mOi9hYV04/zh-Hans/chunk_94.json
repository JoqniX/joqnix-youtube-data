[{"type": "subtitle", "time": 5642.31, "timestamp": "01:34:02", "text": "但很可能是的，我的意思是，这是其中之一。"}, {"type": "subtitle", "time": 5644.95, "timestamp": "01:34:04", "text": "计划要做的事情"}, {"type": "subtitle", "time": 5647.83, "timestamp": "01:34:07", "text": "今年的名单。呃，好多东西都是"}, {"type": "subtitle", "time": 5650.669, "timestamp": "01:34:10", "text": "事情就是这样，我不能再继续下去了"}, {"type": "subtitle", "time": 5658.47, "timestamp": "01:34:18", "text": "东西。是的，实时翻译。是的。"}, {"type": "subtitle", "time": 5660.87, "timestamp": "01:34:20", "text": "这是Billy Billy上的人们拥有的"}, {"type": "subtitle", "time": 5663.31, "timestamp": "01:34:23", "text": "到"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "遭受。比利，请问这是什么？"}, {"type": "subtitle", "time": 5675.35, "timestamp": "01:34:35", "text": "事物。欢迎布拉德。欢迎来到"}, {"type": "subtitle", "time": 5678.35, "timestamp": "01:34:38", "text": "溪流。希望你一切都好。你好。"}, {"type": "subtitle", "time": 5681.669, "timestamp": "01:34:41", "text": "你好。是的，这很痛苦，你知道的。"}, {"type": "subtitle", "time": 5684.47, "timestamp": "01:34:44", "text": "因为存在语言障碍。不，"}, {"type": "subtitle", "time": 5687.03, "timestamp": "01:34:47", "text": "难以置信，竟然会有人读到这篇文章。"}, {"type": "subtitle", "time": 5690.39, "timestamp": "01:34:50", "text": "他们以为哦，骑师说了什么。"}, {"type": "subtitle", "time": 5692.87, "timestamp": "01:34:52", "text": "不应该像取消那样做"}, {"type": "subtitle", "time": 5695.83, "timestamp": "01:34:55", "text": "类似这样的东西。但我有"}]
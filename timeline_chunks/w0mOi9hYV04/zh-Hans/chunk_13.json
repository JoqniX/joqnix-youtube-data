[{"type": "subtitle", "time": 788.03, "timestamp": "00:13:08", "text": "小丑"}, {"type": "subtitle", "time": 799.03, "timestamp": "00:13:19", "text": "是啊，最近我没怎么直播。"}, {"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "现在到处都是。"}, {"type": "subtitle", "time": 806.629, "timestamp": "00:13:26", "text": "所以，我真的很想"}, {"type": "subtitle", "time": 810.269, "timestamp": "00:13:30", "text": "呃，我真的很想"}, {"type": "subtitle", "time": 814.069, "timestamp": "00:13:34", "text": "嗯，我真的很想回去。"}, {"type": "subtitle", "time": 818.55, "timestamp": "00:13:38", "text": "回到我平常的生活方式。呃，我妈妈是"}, {"type": "subtitle", "time": 820.23, "timestamp": "00:13:40", "text": "他建议我买MacBook，但我不想买。"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "想要一台MacBook。哦，就像笔记本电脑那个"}, {"type": "subtitle", "time": 828.15, "timestamp": "00:13:48", "text": "或者像桌面版那样。等等，MacBook"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "我记得Air是那款笔记本电脑。我不"}, {"type": "subtitle", "time": 835.91, "timestamp": "00:13:55", "text": "知道。我对类似……之类的东西不太熟悉"}, {"type": "subtitle", "time": 837.829, "timestamp": "00:13:57", "text": "呃，它叫什么？是的，我不是。"}]
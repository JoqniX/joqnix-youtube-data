[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "26 五。我忘了。我以前总是崩溃"}, {"type": "subtitle", "time": 9424.99, "timestamp": "02:37:04", "text": "溪流。每次都在一条流中，在一个"}, {"type": "subtitle", "time": 9427.83, "timestamp": "02:37:07", "text": "坐在 Twitch 上。我认为"}, {"type": "subtitle", "time": 9430.71, "timestamp": "02:37:10", "text": "是溪流。我记得我当时"}, {"type": "subtitle", "time": 9433.27, "timestamp": "02:37:13", "text": "准备迎接新事物"}, {"type": "subtitle", "time": 9435.19, "timestamp": "02:37:15", "text": "更新以准备新的"}, {"type": "subtitle", "time": 9438.75, "timestamp": "02:37:18", "text": "更新等等。是的，我记得。"}, {"type": "subtitle", "time": 9450.99, "timestamp": "02:37:30", "text": "H 还行"}, {"type": "subtitle", "time": 9455.19, "timestamp": "02:37:35", "text": "嗯，对于那些最近不知道的人来说，我"}, {"type": "subtitle", "time": 9461.469, "timestamp": "02:37:41", "text": "我打了第一针疫苗。"}, {"type": "subtitle", "time": 9466.83, "timestamp": "02:37:46", "text": "接种了第一针疫苗"}, {"type": "subtitle", "time": 9470.309, "timestamp": "02:37:50", "text": "嗯，我昨天拍了照片。"}, {"type": "subtitle", "time": 9472.23, "timestamp": "02:37:52", "text": "等等，是昨天吗？我一直……"}, {"type": "subtitle", "time": 9475.349, "timestamp": "02:37:55", "text": "忘记星期五是什么时候？是的，"}, {"type": "subtitle", "time": 9478.469, "timestamp": "02:37:58", "text": "昨天。等等，稍等。是吗？"}]
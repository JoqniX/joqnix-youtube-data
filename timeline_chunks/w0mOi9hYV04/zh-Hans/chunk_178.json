[{"type": "subtitle", "time": 10682.71, "timestamp": "02:58:02", "text": "那。所以，我不需要上去。等等，我"}, {"type": "subtitle", "time": 10685.79, "timestamp": "02:58:05", "text": "感觉我应该去"}, {"type": "subtitle", "time": 10695.03, "timestamp": "02:58:15", "text": "怙。下午5:30 Helixan 流。得到"}, {"type": "subtitle", "time": 10698.55, "timestamp": "02:58:18", "text": "它。明白了。谢谢你，祖基。"}, {"type": "subtitle", "time": 10702.389, "timestamp": "02:58:22", "text": "时间。那可真是一次长距离跳跃。没关系。"}, {"type": "subtitle", "time": 10705.67, "timestamp": "02:58:25", "text": "我们能做到。哦，不。我们做不到。"}, {"type": "subtitle", "time": 10707.309, "timestamp": "02:58:27", "text": "它是"}, {"type": "subtitle", "time": 10709.79, "timestamp": "02:58:29", "text": "美好的。完全"}, {"type": "subtitle", "time": 10712.429, "timestamp": "02:58:32", "text": "美好的。我们砰砰"}, {"type": "subtitle", "time": 10720.389, "timestamp": "02:58:40", "text": "做不到。它涵盖了大部分内容"}, {"type": "subtitle", "time": 10724.19, "timestamp": "02:58:44", "text": "全屏显示。是的，我注意到了"}, {"type": "subtitle", "time": 10727.07, "timestamp": "02:58:47", "text": "那。所以，"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "嗯，就像……我没有……"}, {"type": "subtitle", "time": 10735.429, "timestamp": "02:58:55", "text": "在 OBS 上，我不断添加媒体源。"}, {"type": "subtitle", "time": 10739.269, "timestamp": "02:58:59", "text": "他们都喜欢网站，这样我就可以……"}]
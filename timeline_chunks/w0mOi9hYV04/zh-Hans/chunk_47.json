[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "YouTube 和 Twitch，一二。"}, {"type": "subtitle", "time": 2823.51, "timestamp": "00:47:03", "text": "呃，YouTube Studio 需要一些时间，因为"}, {"type": "subtitle", "time": 2827.03, "timestamp": "00:47:07", "text": "我正在将 V Studio 数据传输到我的……"}, {"type": "subtitle", "time": 2830.87, "timestamp": "00:47:10", "text": "嗯，流媒体PC，还有，数据是"}, {"type": "subtitle", "time": 2833.91, "timestamp": "00:47:13", "text": "开始进入 OBS。然后 OBS 必须"}, {"type": "subtitle", "time": 2838.109, "timestamp": "00:47:18", "text": "铃声响起。所以NDI需要"}, {"type": "subtitle", "time": 2841.829, "timestamp": "00:47:21", "text": "嗯……多少钱？"}, {"type": "subtitle", "time": 2847.27, "timestamp": "00:47:27", "text": "呃，是针对 1080p 60fps 的吗？不，是 1080p 60 帧。"}, {"type": "subtitle", "time": 2849.91, "timestamp": "00:47:29", "text": "等等，白纸在哪儿？"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": "再次？呃，NDI。所以大约是"}, {"type": "subtitle", "time": 2858.27, "timestamp": "00:47:38", "text": "大约 600 兆比特，不是咬。"}, {"type": "subtitle", "time": 2862.47, "timestamp": "00:47:42", "text": "我。所以，如果我这样做，所有这些都是等价的。"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "玩网络游戏会加剧痛苦"}, {"type": "subtitle", "time": 2867.23, "timestamp": "00:47:47", "text": "因为模型会卡住"}, {"type": "subtitle", "time": 2872.069, "timestamp": "00:47:52", "text": "卡住。所以所有这些都等于……我的"}, {"type": "subtitle", "time": 2874.87, "timestamp": "00:47:54", "text": "整个网络配置已达到最高级别。"}]
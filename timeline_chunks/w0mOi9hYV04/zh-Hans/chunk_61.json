[{"type": "subtitle", "time": 3660.789, "timestamp": "01:01:00", "text": "男人。我想去旅行。我想去参观"}, {"type": "subtitle", "time": 3663.15, "timestamp": "01:01:03", "text": "地点一"}, {"type": "subtitle", "time": 3666.549, "timestamp": "01:01:06", "text": "天。是的。所以目前我……"}, {"type": "subtitle", "time": 3667.87, "timestamp": "01:01:07", "text": "拥有是本地的"}, {"type": "subtitle", "time": 3672.829, "timestamp": "01:01:12", "text": "ASP。我忘了。是丹尼尔吗？"}, {"type": "subtitle", "time": 3679.51, "timestamp": "01:01:19", "text": "忘了。胶原蛋白会被困住。"}, {"type": "subtitle", "time": 3683.109, "timestamp": "01:01:23", "text": "是的，我应该。我应该，我应该。是的，"}, {"type": "subtitle", "time": 3685.57, "timestamp": "01:01:25", "text": "我可能不会"}, {"type": "subtitle", "time": 3697.99, "timestamp": "01:01:37", "text": "[音乐]"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "我整整5个小时都打不开墙。我"}, {"type": "subtitle", "time": 3702.23, "timestamp": "01:01:42", "text": "必须坐在阳台上才能收到信号。"}, {"type": "subtitle", "time": 3707.109, "timestamp": "01:01:47", "text": "我的天啊。我了解那些日子。哦，那个"}, {"type": "subtitle", "time": 3711.43, "timestamp": "01:01:51", "text": "呃，那是我去我……的时候"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "爸爸回家了。我的天啊。信号是一个"}, {"type": "subtitle", "time": 3717.43, "timestamp": "01:01:57", "text": "事物。我到底是怎么开始直播的？"}]
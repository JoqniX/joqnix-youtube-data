[{"type": "subtitle", "time": 4148.11, "timestamp": "01:09:08", "text": "原因？等等，刚才那是什么？"}, {"type": "subtitle", "time": 4152.11, "timestamp": "01:09:12", "text": "原因？哦，我只是顺道来访，因为……"}, {"type": "subtitle", "time": 4155.43, "timestamp": "01:09:15", "text": "妈妈 妈妈 嗯"}, {"type": "subtitle", "time": 4164.269, "timestamp": "01:09:24", "text": "我想要我"}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "想要和喜欢东西，喜欢哭泣"}, {"type": "subtitle", "time": 4171.189, "timestamp": "01:09:31", "text": "东西。我感觉自己越来越像要回家了。"}, {"type": "subtitle", "time": 4174.789, "timestamp": "01:09:34", "text": "然后我就去看望了妈妈。"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "接下来是奶奶，然后是爷爷，等等。"}, {"type": "subtitle", "time": 4194.39, "timestamp": "01:09:54", "text": "真的吗？没错，就是这样。嗯，差不多。"}, {"type": "subtitle", "time": 4196.709, "timestamp": "01:09:56", "text": "类似，但又有所不同。我想看看我的"}]
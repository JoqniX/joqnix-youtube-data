[{"type": "subtitle", "time": 960.87, "timestamp": "00:16:00", "text": "一些事情正在发生，呃，即将发生"}, {"type": "subtitle", "time": 964.629, "timestamp": "00:16:04", "text": "即将发生的事情"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "我无法透露，因为我不知道"}, {"type": "subtitle", "time": 971.749, "timestamp": "00:16:11", "text": "确切的发布时间。呃"}, {"type": "subtitle", "time": 975.509, "timestamp": "00:16:15", "text": "但我听说它即将到来。我是"}, {"type": "subtitle", "time": 978.269, "timestamp": "00:16:18", "text": "有人告诉我它要来了。"}, {"type": "subtitle", "time": 980.91, "timestamp": "00:16:20", "text": "是的。是的。"}, {"type": "subtitle", "time": 983.749, "timestamp": "00:16:23", "text": "呃，发生了很多事。我是"}, {"type": "subtitle", "time": 985.99, "timestamp": "00:16:25", "text": "对未来的事物感到兴奋。我不能"}, {"type": "subtitle", "time": 990.749, "timestamp": "00:16:30", "text": "把事情都说出来。好的，腿。"}, {"type": "subtitle", "time": 993.949, "timestamp": "00:16:33", "text": "或许远不止如此。"}, {"type": "subtitle", "time": 998.55, "timestamp": "00:16:38", "text": "那。我不知道。呃，为什么我的模型是这样的"}, {"type": "subtitle", "time": 1001.91, "timestamp": "00:16:41", "text": "有时会卡住？网站。也一样。呃"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "那将会非常慢"}, {"type": "subtitle", "time": 1008.389, "timestamp": "00:16:48", "text": "说实话，这算进步吧。网站内容"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "嗯，这将是一个缓慢的过程。嗯，但是"}, {"type": "subtitle", "time": 1014.069, "timestamp": "00:16:54", "text": "是的，我们最终会得到它。"}, {"type": "subtitle", "time": 1017.829, "timestamp": "00:16:57", "text": "即将开始。迟早。是的。"}]
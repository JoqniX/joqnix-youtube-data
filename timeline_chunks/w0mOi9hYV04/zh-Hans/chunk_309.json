[{"type": "subtitle", "time": 18540.948, "timestamp": "05:09:00", "text": "开这个、那个、还有那个的玩笑。下一个"}, {"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "如果你感觉不舒服，那就花时间吧"}, {"type": "subtitle", "time": 18545.27, "timestamp": "05:09:05", "text": "下次尽量不要再这样做了。"}, {"type": "subtitle", "time": 18549.75, "timestamp": "05:09:09", "text": "或者如果你犯了错误或者喜欢"}, {"type": "subtitle", "time": 18552.55, "timestamp": "05:09:12", "text": "比如，呃，自己泄露了自己的信息之类的。"}, {"type": "subtitle", "time": 18554.788, "timestamp": "05:09:14", "text": "下次别再漏东西了。"}, {"type": "subtitle", "time": 18558.31, "timestamp": "05:09:18", "text": "屏幕捕获或更谨慎一些，例如"}, {"type": "subtitle", "time": 18560.788, "timestamp": "05:09:20", "text": "从错误中吸取教训并适应"}, {"type": "subtitle", "time": 18563.51, "timestamp": "05:09:23", "text": "adaptab 不喜欢那样做，那样会"}, {"type": "subtitle", "time": 18566.15, "timestamp": "05:09:26", "text": "实际上，这样做比比较更好。"}, {"type": "subtitle", "time": 18570.31, "timestamp": "05:09:30", "text": "就像是“哦，我的朋友们”一样"}, {"type": "subtitle", "time": 18573.35, "timestamp": "05:09:33", "text": "朋友的 YouTuber 频道观众比我多。"}, {"type": "subtitle", "time": 18576.35, "timestamp": "05:09:36", "text": "我的观众大多都在看他们，"}, {"type": "subtitle", "time": 18578.03, "timestamp": "05:09:38", "text": "ETC。"}, {"type": "subtitle", "time": 18581.27, "timestamp": "05:09:41", "text": "记住，到最后，总会有结果的。"}, {"type": "subtitle", "time": 18584.628, "timestamp": "05:09:44", "text": "成为那些无论何时何地都会支持你的人。"}, {"type": "subtitle", "time": 18588.55, "timestamp": "05:09:48", "text": "你走了，谁会看着你呢？因为他们"}, {"type": "subtitle", "time": 18591.15, "timestamp": "05:09:51", "text": "感谢您抽出宝贵时间。他们"}, {"type": "subtitle", "time": 18594.708, "timestamp": "05:09:54", "text": "欣赏你自己。他们不是"}, {"type": "subtitle", "time": 18596.868, "timestamp": "05:09:56", "text": "这里是因为模特，你的外表"}, {"type": "subtitle", "time": 18599.43, "timestamp": "05:09:59", "text": "或者其他什么。他们反正不在。"}]
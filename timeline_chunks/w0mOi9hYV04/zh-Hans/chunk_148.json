[{"type": "subtitle", "time": 8886.07, "timestamp": "02:28:06", "text": "呃，甚至没有。是的，没错。那就是"}, {"type": "subtitle", "time": 8888.15, "timestamp": "02:28:08", "text": "事物。就是这样。必须是"}, {"type": "subtitle", "time": 8891.349, "timestamp": "02:28:11", "text": "既有趣又易消化。那就是"}, {"type": "subtitle", "time": 8893.59, "timestamp": "02:28:13", "text": "事物。不是那种，哦，是的，我只要"}, {"type": "subtitle", "time": 8896.07, "timestamp": "02:28:16", "text": "直播12小时，就结束了。是的。"}, {"type": "subtitle", "time": 8897.83, "timestamp": "02:28:17", "text": "不是那样的。我想把它做出来"}, {"type": "subtitle", "time": 8899.75, "timestamp": "02:28:19", "text": "消耗品。我想把它做出来"}, {"type": "subtitle", "time": 8902.469, "timestamp": "02:28:22", "text": "很有意思。所以，呃，就像"}, {"type": "subtitle", "time": 8905.55, "timestamp": "02:28:25", "text": "我最近一直都很友善。"}, {"type": "subtitle", "time": 8908.349, "timestamp": "02:28:28", "text": "就像挑选一样"}, {"type": "subtitle", "time": 8912.469, "timestamp": "02:28:32", "text": "那些东西，呃，太多了，而且喜欢"}, {"type": "subtitle", "time": 8914.309, "timestamp": "02:28:34", "text": "正在ping它。不是暂停，更像是"}, {"type": "subtitle", "time": 8916.27, "timestamp": "02:28:36", "text": "停止"}, {"type": "subtitle", "time": 8920.15, "timestamp": "02:28:40", "text": "它。呃，请在我被起诉期间为我辩护。"}, {"type": "subtitle", "time": 8922.51, "timestamp": "02:28:42", "text": "抢劫之后。哦，我的"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "上帝。是的。再见。此外，它还将是"}, {"type": "subtitle", "time": 8927.469, "timestamp": "02:28:47", "text": "10:30那么，让我们结束吧。"}, {"type": "subtitle", "time": 8930.79, "timestamp": "02:28:50", "text": "向上。我确实说过我会在……结束。"}, {"type": "subtitle", "time": 8934.11, "timestamp": "02:28:54", "text": "10:30那么我们就到此为止吧。"}, {"type": "subtitle", "time": 8937.27, "timestamp": "02:28:57", "text": "嗯，问题是我需要感谢吗？"}, {"type": "subtitle", "time": 8939.95, "timestamp": "02:28:59", "text": "现在每个人都这样吗？现在"}]
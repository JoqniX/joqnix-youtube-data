[{"type": "subtitle", "time": 6023.07, "timestamp": "01:40:23", "text": "我怀孕了。什么？什么？"}, {"type": "subtitle", "time": 6026.47, "timestamp": "01:40:26", "text": "什么？呃，我有个问题。你"}, {"type": "subtitle", "time": 6028.95, "timestamp": "01:40:28", "text": "有没有来过拍摄现场？是的，我有。我"}, {"type": "subtitle", "time": 6032.709, "timestamp": "01:40:32", "text": "有。我只是含糊其辞地谈了谈。"}, {"type": "subtitle", "time": 6035.35, "timestamp": "01:40:35", "text": "你还有多少分钟？"}, {"type": "subtitle", "time": 6038.87, "timestamp": "01:40:38", "text": "你们又开始聊天了吗？ 39. 我说过"}, {"type": "subtitle", "time": 6039.95, "timestamp": "01:40:39", "text": "喜欢"}, {"type": "subtitle", "time": 6043.99, "timestamp": "01:40:43", "text": "第29分钟。我的意思是……"}, {"type": "subtitle", "time": 6045.43, "timestamp": "01:40:45", "text": "溪流的起点。所以我再说一遍"}, {"type": "subtitle", "time": 6047.229, "timestamp": "01:40:47", "text": "再次。"}, {"type": "subtitle", "time": 6051.79, "timestamp": "01:40:51", "text": "所以，我确实很想"}, {"type": "subtitle", "time": 6054.87, "timestamp": "01:40:54", "text": "嗯，制作短片和类似视频内容。"}, {"type": "subtitle", "time": 6057.27, "timestamp": "01:40:57", "text": "你知道，我就是太挑剔了。"}]
[{"type": "subtitle", "time": 4860.07, "timestamp": "01:21:00", "text": "我可以把未来带回来"}, {"type": "subtitle", "time": 4862.39, "timestamp": "01:21:02", "text": "呃，短片或教育内容"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "它。嗯，或许我们可以这样做"}, {"type": "subtitle", "time": 4867.47, "timestamp": "01:21:07", "text": "那。为什么"}, {"type": "subtitle", "time": 4870.63, "timestamp": "01:21:10", "text": "不是？我们可以那样做。为什么不呢？"}, {"type": "subtitle", "time": 4872.11, "timestamp": "01:21:12", "text": "是的。是的。"}, {"type": "subtitle", "time": 4877.55, "timestamp": "01:21:17", "text": "是的。你好。欢迎。我呃，我来了"}, {"type": "subtitle", "time": 4879.07, "timestamp": "01:21:19", "text": "穿过"}, {"type": "subtitle", "time": 4882.35, "timestamp": "01:21:22", "text": "250 美元，更多"}, {"type": "subtitle", "time": 4884.189, "timestamp": "01:21:24", "text": "音乐。"}, {"type": "subtitle", "time": 4885.79, "timestamp": "01:21:25", "text": "什么？"}, {"type": "subtitle", "time": 4892.709, "timestamp": "01:21:32", "text": "内容。那里会有所不同。"}, {"type": "subtitle", "time": 4896.149, "timestamp": "01:21:36", "text": "可以做个变体。好的。所以，我"}, {"type": "subtitle", "time": 4898.47, "timestamp": "01:21:38", "text": "不会上传短片或视频"}, {"type": "subtitle", "time": 4901.51, "timestamp": "01:21:41", "text": "可惜主频道上还没有相关内容。做"}, {"type": "subtitle", "time": 4904.63, "timestamp": "01:21:44", "text": "不过别担心。你看，它要去我"}, {"type": "subtitle", "time": 4906.95, "timestamp": "01:21:46", "text": "要为此制定计划。好的，它会"}, {"type": "subtitle", "time": 4909.189, "timestamp": "01:21:49", "text": "显然会挂在我的墙上"}, {"type": "subtitle", "time": 4910.95, "timestamp": "01:21:50", "text": "频道，第二个频道。你可以"}, {"type": "subtitle", "time": 4912.55, "timestamp": "01:21:52", "text": "可以称之为第二频道，或者"}, {"type": "subtitle", "time": 4914.189, "timestamp": "01:21:54", "text": "严格来说是第二个"}, {"type": "subtitle", "time": 4917.03, "timestamp": "01:21:57", "text": "渠道。但问题是我有点"}, {"type": "subtitle", "time": 4919.35, "timestamp": "01:21:59", "text": "不想再开新频道"}]
[{"type": "subtitle", "time": 1322.11, "timestamp": "00:22:02", "text": "电路板或主频道会像这样"}, {"type": "subtitle", "time": 1325.27, "timestamp": "00:22:05", "text": "我的，我的。所以，它现在和我连在一起了。"}, {"type": "subtitle", "time": 1328.549, "timestamp": "00:22:08", "text": "所以，我想应该没问题吧。哦，是的。"}, {"type": "subtitle", "time": 1342.63, "timestamp": "00:22:22", "text": "超凡脱俗。我的天哪，你真是个……"}, {"type": "subtitle", "time": 1345.51, "timestamp": "00:22:25", "text": "勤奋的你，音乐制作人，"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "音乐家。嗯，我很高兴。我很高兴我们"}, {"type": "subtitle", "time": 1353.11, "timestamp": "00:22:33", "text": "呃，还有我们手机上的所有音乐"}, {"type": "subtitle", "time": 1355.07, "timestamp": "00:22:35", "text": "所有流"}, {"type": "subtitle", "time": 1359.11, "timestamp": "00:22:39", "text": "就像 Reality 制作的粉丝自制 OST 一样"}, {"type": "subtitle", "time": 1362.789, "timestamp": "00:22:42", "text": "工作室和 Eizen。是的，我很高兴。"}, {"type": "subtitle", "time": 1365.669, "timestamp": "00:22:45", "text": "谢谢。我很高兴。为什么我是凡人"}, {"type": "subtitle", "time": 1368.149, "timestamp": "00:22:48", "text": "卡住？喂，让开。我在表达自己。"}, {"type": "subtitle", "time": 1371.59, "timestamp": "00:22:51", "text": "好的。好了，它在动。"}, {"type": "subtitle", "time": 1373.59, "timestamp": "00:22:53", "text": "呃，订阅主频道不是更好吗？"}, {"type": "subtitle", "time": 1375.909, "timestamp": "00:22:55", "text": "渠道？是的。是的。是的。是的。呃，它"}, {"type": "subtitle", "time": 1377.75, "timestamp": "00:22:57", "text": "最好订阅主频道。我"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "不知道。我有点……我太……了"}]
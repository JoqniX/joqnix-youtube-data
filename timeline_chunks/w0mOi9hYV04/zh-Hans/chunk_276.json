[{"type": "subtitle", "time": 16560.15, "timestamp": "04:36:00", "text": "对我们来说，这是一种爱好。我们大多数人，"}, {"type": "subtitle", "time": 16563.83, "timestamp": "04:36:03", "text": "嗯，是的，我还没见过两个严肃的"}, {"type": "subtitle", "time": 16565.99, "timestamp": "04:36:05", "text": "这部喜剧里还有人，嗯，是的。"}, {"type": "subtitle", "time": 16568.15, "timestamp": "04:36:08", "text": "大部分都只是业余爱好，对吧？"}, {"type": "subtitle", "time": 16570.91, "timestamp": "04:36:10", "text": "和，"}, {"type": "subtitle", "time": 16573.629, "timestamp": "04:36:13", "text": "呃，谢谢你，珍妮丝。谢谢你"}, {"type": "subtitle", "time": 16578.47, "timestamp": "04:36:18", "text": "礼物，Sha。谢谢。嗯，是的，如果"}, {"type": "subtitle", "time": 16581.15, "timestamp": "04:36:21", "text": "如果那件事真的发生，我会崩溃的。"}, {"type": "subtitle", "time": 16585.109, "timestamp": "04:36:25", "text": "但我会确保把它放出来。"}, {"type": "chat", "time": 16585.755, "timestamp": "04:36:25", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I trusted them with everything :) "}, {"type": "subtitle", "time": 16589.189, "timestamp": "04:36:29", "text": "非常清楚地理解了，就像嘿，如果"}, {"type": "subtitle", "time": 16591.75, "timestamp": "04:36:31", "text": "你要那样对我吗？看看这些"}, {"type": "subtitle", "time": 16595.029, "timestamp": "04:36:35", "text": "事情会影响到我，但我不会。"}, {"type": "subtitle", "time": 16597.67, "timestamp": "04:36:37", "text": "纵容那种行为等等"}, {"type": "subtitle", "time": 16602.23, "timestamp": "04:36:42", "text": "因为不，是的，就你的情况而言，嗯"}, {"type": "subtitle", "time": 16604.269, "timestamp": "04:36:44", "text": "没关系，你得明白"}, {"type": "subtitle", "time": 16607.869, "timestamp": "04:36:47", "text": "你隶属于一家公司……"}, {"type": "subtitle", "time": 16609.39, "timestamp": "04:36:49", "text": "环境。"}, {"type": "subtitle", "time": 16612.949, "timestamp": "04:36:52", "text": "所以你建立的受众群体"}, {"type": "subtitle", "time": 16615.59, "timestamp": "04:36:55", "text": "一切都将永远共享。"}]
[{"type": "subtitle", "time": 2761.47, "timestamp": "00:46:01", "text": "呃，我们为我们感到自豪"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "j 手机。不，不是手机的问题。它是"}, {"type": "subtitle", "time": 2768.069, "timestamp": "00:46:08", "text": "一点都不热。太酷了。这是"}, {"type": "subtitle", "time": 2771.43, "timestamp": "00:46:11", "text": "无线网卡。呃，就像……主要是"}, {"type": "subtitle", "time": 2775.55, "timestamp": "00:46:15", "text": "实际上，我的人脉关系是因为你知道"}, {"type": "subtitle", "time": 2780.87, "timestamp": "00:46:20", "text": "嗯，100MP，不，是100MP，等于1GB吗？"}, {"type": "subtitle", "time": 2783.51, "timestamp": "00:46:23", "text": "网络连接正确，所以两台电脑必须……"}, {"type": "subtitle", "time": 2786.55, "timestamp": "00:46:26", "text": "由单个路由器供电，该路由器是"}, {"type": "subtitle", "time": 2789.99, "timestamp": "00:46:29", "text": "连接到千兆以太网"}, {"type": "subtitle", "time": 2792.23, "timestamp": "00:46:32", "text": "千兆分线器之类的东西，或者别的什么？"}, {"type": "subtitle", "time": 2794.87, "timestamp": "00:46:34", "text": "它再次调用了千兆交换机，"}, {"type": "subtitle", "time": 2799.91, "timestamp": "00:46:39", "text": "给你发送一个GGB，我是说1GB"}, {"type": "subtitle", "time": 2804.27, "timestamp": "00:46:44", "text": "或者，000 MP 绿光稳定"}, {"type": "subtitle", "time": 2807.67, "timestamp": "00:46:47", "text": "互联网连接速度对双方都是"}, {"type": "subtitle", "time": 2811.67, "timestamp": "00:46:51", "text": "电脑要运行它，需要用到 OBS。"}, {"type": "subtitle", "time": 2814.63, "timestamp": "00:46:54", "text": "需要大约 50% 的时间，因为它需要"}, {"type": "subtitle", "time": 2817.19, "timestamp": "00:46:57", "text": "对两个平台进行编码和录制"}]
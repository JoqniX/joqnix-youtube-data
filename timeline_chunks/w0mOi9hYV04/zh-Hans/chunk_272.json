[{"type": "subtitle", "time": 16328.59, "timestamp": "04:32:08", "text": "我很好"}, {"type": "chat", "time": 16330.041, "timestamp": "04:32:10", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "*pat pat* mitsuki"}, {"type": "subtitle", "time": 16332.55, "timestamp": "04:32:12", "text": "夜晚。好了，我回来了。呃，如果我会"}, {"type": "subtitle", "time": 16334.71, "timestamp": "04:32:14", "text": "如果我遇到年轻时的自己，我会"}, {"type": "subtitle", "time": 16336.269, "timestamp": "04:32:16", "text": "问题"}, {"type": "subtitle", "time": 16339.11, "timestamp": "04:32:19", "text": "标记。我刚认识了那些人"}, {"type": "subtitle", "time": 16342.229, "timestamp": "04:32:22", "text": "我以为我的族人实际上在哪里"}, {"type": "subtitle", "time": 16344.07, "timestamp": "04:32:24", "text": "不是。现在我觉得自己被背叛了，受到了不公正的对待。"}, {"type": "subtitle", "time": 16346.429, "timestamp": "04:32:26", "text": "我非常生气。我非常"}, {"type": "subtitle", "time": 16348.83, "timestamp": "04:32:28", "text": "伤心。"}, {"type": "chat", "time": 16351.649, "timestamp": "04:32:31", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "And they were all making fun of me and laughed on me and now i feel so dumb "}, {"type": "subtitle", "time": 16356.469, "timestamp": "04:32:36", "text": "嗯？做了件大灾难。"}, {"type": "subtitle", "time": 16363.63, "timestamp": "04:32:43", "text": "他们都在嘲笑我。"}, {"type": "subtitle", "time": 16367.79, "timestamp": "04:32:47", "text": "呃，抱歉。对不起。对不起。我"}, {"type": "subtitle", "time": 16372.429, "timestamp": "04:32:52", "text": "是珍妮。那张照片真是太……"}, {"type": "subtitle", "time": 16377.149, "timestamp": "04:32:57", "text": "我好可爱。对不起，我刚才笑了。"}]
[{"type": "subtitle", "time": 2465.109, "timestamp": "00:41:05", "text": "呃，我看着镜头，就像你呃可以保持一个"}, {"type": "subtitle", "time": 2467.829, "timestamp": "00:41:07", "text": "几个片段。是的。是的。我想要我我我我"}, {"type": "subtitle", "time": 2469.589, "timestamp": "00:41:09", "text": "甚至想过像你知道的那样做"}, {"type": "subtitle", "time": 2472.23, "timestamp": "00:41:12", "text": "YouTube目前的趋势是自那时以来"}, {"type": "subtitle", "time": 2475.829, "timestamp": "00:41:15", "text": "短片直播就像……"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "西方社会已经弄清了这一点，并且"}, {"type": "subtitle", "time": 2481.99, "timestamp": "00:41:21", "text": "呃，我们官方YouTube频道喜欢推广它"}, {"type": "subtitle", "time": 2489.27, "timestamp": "00:41:29", "text": "呃，宣传一下，嗯，所以发生了什么事"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "呃，人们想出了一个办法来"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "两条流使用两条不同的流"}, {"type": "subtitle", "time": 2497.15, "timestamp": "00:41:37", "text": "呃，极端钥匙之一将"}, {"type": "subtitle", "time": 2499.67, "timestamp": "00:41:39", "text": "垂直方向的另一个，还有一个"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "将是水平的。所以那些人"}, {"type": "subtitle", "time": 2504.23, "timestamp": "00:41:44", "text": "浏览短裤可以让你垂直"}, {"type": "subtitle", "time": 2506.309, "timestamp": "00:41:46", "text": "直播并观看你的实时表演。那么如果"}, {"type": "subtitle", "time": 2508.15, "timestamp": "00:41:48", "text": "当他们点击你的频道时，他们"}, {"type": "subtitle", "time": 2510.47, "timestamp": "00:41:50", "text": "然后就能看到水平流了。"}, {"type": "subtitle", "time": 2512.23, "timestamp": "00:41:52", "text": "他们观察水平方向的流。那"}]
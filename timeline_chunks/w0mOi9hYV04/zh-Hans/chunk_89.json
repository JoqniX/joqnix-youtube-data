[{"type": "subtitle", "time": 5340.55, "timestamp": "01:29:00", "text": "好的，不错。谢谢你告诉我"}, {"type": "subtitle", "time": 5343.03, "timestamp": "01:29:03", "text": "你的生日。我会尽量记住。"}, {"type": "subtitle", "time": 5345.55, "timestamp": "01:29:05", "text": "那。"}, {"type": "subtitle", "time": 5349.35, "timestamp": "01:29:09", "text": "是的，如果你在Discord服务器里的话，"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "熟悉的Discord服务器或"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "星座"}, {"type": "subtitle", "time": 5357.35, "timestamp": "01:29:17", "text": "呃，我的意思是，它们都使用同一个服务器。"}, {"type": "subtitle", "time": 5360.709, "timestamp": "01:29:20", "text": "我只是给它起了些好玩的名字。"}, {"type": "subtitle", "time": 5364.55, "timestamp": "01:29:24", "text": "嗯，是的，你可以设置你的生日"}, {"type": "subtitle", "time": 5367.35, "timestamp": "01:29:27", "text": "在广告服务器上使用机器人生日"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "机器人。所以你知道你会得到你会"}, {"type": "subtitle", "time": 5371.91, "timestamp": "01:29:31", "text": "公开宣布，是的，那是你的"}, {"type": "subtitle", "time": 5373.47, "timestamp": "01:29:33", "text": "这是我的"}, {"type": "subtitle", "time": 5376.709, "timestamp": "01:29:36", "text": "生日。嗯，我需要你被我包裹起来。"}, {"type": "subtitle", "time": 5378.669, "timestamp": "01:29:38", "text": "生日"}, {"type": "subtitle", "time": 5389.79, "timestamp": "01:29:49", "text": "为什么？我的天啊。哦，我的"}, {"type": "subtitle", "time": 5392.39, "timestamp": "01:29:52", "text": "上帝。好吧，这让我措手不及。"}, {"type": "subtitle", "time": 5393.55, "timestamp": "01:29:53", "text": "警卫。"}, {"type": "subtitle", "time": 5396.95, "timestamp": "01:29:56", "text": "好的。呃，你好，很高兴这不是我的"}, {"type": "subtitle", "time": 5399.229, "timestamp": "01:29:59", "text": "生日，但不管是谁"}]
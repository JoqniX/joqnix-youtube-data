[{"type": "subtitle", "time": 8761.99, "timestamp": "02:26:01", "text": "我想我会进行更大规模的直播。"}, {"type": "subtitle", "time": 8765.349, "timestamp": "02:26:05", "text": "今天的工作就到此为止，但更像是"}, {"type": "subtitle", "time": 8768.87, "timestamp": "02:26:08", "text": "我想和米娜聊天，而且喜欢"}, {"type": "subtitle", "time": 8770.79, "timestamp": "02:26:10", "text": "让我"}, {"type": "subtitle", "time": 8772.79, "timestamp": "02:26:12", "text": "呃，能够赶上我的日常工作"}, {"type": "subtitle", "time": 8776.11, "timestamp": "02:26:16", "text": "一些运动营养品之类的东西"}, {"type": "subtitle", "time": 8779.309, "timestamp": "02:26:19", "text": "现在是这样，不过是的。"}, {"type": "subtitle", "time": 8782.55, "timestamp": "02:26:22", "text": "或许我会继续前进，我不知道。"}, {"type": "subtitle", "time": 8785.15, "timestamp": "02:26:25", "text": "因为我还要照顾比利。"}, {"type": "subtitle", "time": 8787.15, "timestamp": "02:26:27", "text": "不。"}, {"type": "subtitle", "time": 8791.51, "timestamp": "02:26:31", "text": "嗯，我当时想，也许我会回去……"}, {"type": "subtitle", "time": 8793.99, "timestamp": "02:26:33", "text": "我以前的大学课程表，就像……"}, {"type": "subtitle", "time": 8796.389, "timestamp": "02:26:36", "text": "YouTube Twitch 一天后"}, {"type": "subtitle", "time": 8798.469, "timestamp": "02:26:38", "text": "可信的 YouTube 直播又一天"}, {"type": "subtitle", "time": 8800.87, "timestamp": "02:26:40", "text": "第二天，就像那样，令人信服。"}, {"type": "subtitle", "time": 8803.429, "timestamp": "02:26:43", "text": "就像我们在使用“do”一样。"}, {"type": "subtitle", "time": 8806.309, "timestamp": "02:26:46", "text": "就像YouTube上的一天又过去了。"}, {"type": "subtitle", "time": 8808.23, "timestamp": "02:26:48", "text": "Twitch 第二天又是另一天吗？"}, {"type": "subtitle", "time": 8810.87, "timestamp": "02:26:50", "text": "YouTube 就像 YouTube Twitch YouTube 一样"}, {"type": "subtitle", "time": 8813.07, "timestamp": "02:26:53", "text": "Twitch YouTube Twitch 喜欢"}, {"type": "subtitle", "time": 8818.469, "timestamp": "02:26:58", "text": "与其说是 YouTube 先是 Twitch，我"}]
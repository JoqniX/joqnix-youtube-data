[{"type": "subtitle", "time": 18720.83, "timestamp": "05:12:00", "text": "怎么说？好吧，我忘了"}, {"type": "subtitle", "time": 18723.23, "timestamp": "05:12:03", "text": "ADSD。"}, {"type": "subtitle", "time": 18726.47, "timestamp": "05:12:06", "text": "嗯，是的。嗯，是的，人们都会继续前进。和"}, {"type": "subtitle", "time": 18728.47, "timestamp": "05:12:08", "text": "当你身处更大的空间时，更大的"}, {"type": "chat", "time": 18730.752, "timestamp": "05:12:10", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "LOL JOQ MOMENT "}, {"type": "subtitle", "time": 18730.868, "timestamp": "05:12:10", "text": "随着时间的推移，更高的层次，有些人会"}, {"type": "subtitle", "time": 18733.11, "timestamp": "05:12:13", "text": "继续前进，或者其他人或"}, {"type": "subtitle", "time": 18735.51, "timestamp": "05:12:15", "text": "某某事。但至少它是"}, {"type": "subtitle", "time": 18737.43, "timestamp": "05:12:17", "text": "在你心中。你的记忆里是这样的："}, {"type": "subtitle", "time": 18739.91, "timestamp": "05:12:19", "text": "哦，以前有人看过"}, {"type": "subtitle", "time": 18742.23, "timestamp": "05:12:22", "text": "我。它们仍然在某个地方。"}, {"type": "subtitle", "time": 18744.708, "timestamp": "05:12:24", "text": "我祝他们一切顺利。即使他们"}, {"type": "subtitle", "time": 18746.59, "timestamp": "05:12:26", "text": "别看我，我依然祝他们好运"}, {"type": "subtitle", "time": 18748.948, "timestamp": "05:12:28", "text": "运气。无论他们支持谁，因为"}, {"type": "subtitle", "time": 18750.788, "timestamp": "05:12:30", "text": "当他们来到我的溪流边时"}, {"type": "subtitle", "time": 18755.39, "timestamp": "05:12:35", "text": "他们抽出时间支持我，我很享受。"}, {"type": "subtitle", "time": 18759.03, "timestamp": "05:12:39", "text": "它让我感到快乐。"}, {"type": "subtitle", "time": 18762.23, "timestamp": "05:12:42", "text": "这让我成为了有史以来最幸福的人。"}, {"type": "subtitle", "time": 18765.99, "timestamp": "05:12:45", "text": "这个世界，因为他们来过，看着我"}]
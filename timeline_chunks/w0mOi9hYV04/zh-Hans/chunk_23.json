[{"type": "subtitle", "time": 1383.43, "timestamp": "00:23:03", "text": "挑剔。好的。我太挑剔了。嗯，我只是"}, {"type": "subtitle", "time": 1384.909, "timestamp": "00:23:04", "text": "我太挑剔了。"}, {"type": "subtitle", "time": 1388.39, "timestamp": "00:23:08", "text": "猜测。因为我也在制作关于……的内容"}, {"type": "subtitle", "time": 1390.59, "timestamp": "00:23:10", "text": "比利现在，"}, {"type": "subtitle", "time": 1394.149, "timestamp": "00:23:14", "text": "嗯，我也对此感到困惑，因为我"}, {"type": "subtitle", "time": 1397.029, "timestamp": "00:23:17", "text": "最终还是得推广那个呃"}, {"type": "subtitle", "time": 1399.39, "timestamp": "00:23:19", "text": "频道，Jo 账号。"}, {"type": "subtitle", "time": 1402.71, "timestamp": "00:23:22", "text": "嗯，如果你看看我的比利比利"}, {"type": "subtitle", "time": 1405.83, "timestamp": "00:23:25", "text": "账户看起来空空如也。直到你"}, {"type": "subtitle", "time": 1407.59, "timestamp": "00:23:27", "text": "偶然发现我的直播，你就会"}, {"type": "subtitle", "time": 1409.669, "timestamp": "00:23:29", "text": "比如，“哦，这个人，这真是个……”"}, {"type": "subtitle", "time": 1411.909, "timestamp": "00:23:31", "text": "正在制作内容的账号。哦，"}, {"type": "subtitle", "time": 1414.029, "timestamp": "00:23:34", "text": "这是真的"}, {"type": "subtitle", "time": 1416.789, "timestamp": "00:23:36", "text": "我是个油管博主，因为我得上传照片。"}, {"type": "subtitle", "time": 1424.31, "timestamp": "00:23:44", "text": "“好的。”不过，我确实对……比较挑剔。"}, {"type": "subtitle", "time": 1426.47, "timestamp": "00:23:46", "text": "此刻，但我认为最终我必须……"}, {"type": "subtitle", "time": 1429.27, "timestamp": "00:23:49", "text": "比如，呃，去做。是的，因为我有点"}, {"type": "subtitle", "time": 1432.549, "timestamp": "00:23:52", "text": "想要发布优质内容。好的。"}]
[{"type": "subtitle", "time": 11160.309, "timestamp": "03:06:00", "text": "直播日，普通主播日"}, {"type": "subtitle", "time": 11163.309, "timestamp": "03:06:03", "text": "过去常常做日语"}, {"type": "subtitle", "time": 11166.469, "timestamp": "03:06:06", "text": "之后的事情我再也没碰过。"}, {"type": "subtitle", "time": 11173.309, "timestamp": "03:06:13", "text": "但我确实看了很多"}, {"type": "subtitle", "time": 11177.79, "timestamp": "03:06:17", "text": "呃，主播和"}, {"type": "subtitle", "time": 11180.95, "timestamp": "03:06:20", "text": "呃，日本主播。我与他们互动过。"}, {"type": "subtitle", "time": 11182.87, "timestamp": "03:06:22", "text": "虽然查克也说了一点，但还是……"}, {"type": "subtitle", "time": 11186.91, "timestamp": "03:06:26", "text": "利用我的动漫"}, {"type": "subtitle", "time": 11189.07, "timestamp": "03:06:29", "text": "英语。"}, {"type": "subtitle", "time": 11192.389, "timestamp": "03:06:32", "text": "动物般的。真是个好名字。或者你可以说"}, {"type": "subtitle", "time": 11198.75, "timestamp": "03:06:38", "text": "vb 货车或"}, {"type": "subtitle", "time": 11200.95, "timestamp": "03:06:40", "text": "某物。一旦开始就很有趣了"}, {"type": "subtitle", "time": 11202.63, "timestamp": "03:06:42", "text": "识别"}, {"type": "subtitle", "time": 11205.429, "timestamp": "03:06:45", "text": "呃，识别这些符号。是的。学习"}, {"type": "subtitle", "time": 11207.469, "timestamp": "03:06:47", "text": "阅读。"}, {"type": "subtitle", "time": 11211.349, "timestamp": "03:06:51", "text": "好的。那是什么？糟糕，那是……"}, {"type": "subtitle", "time": 11214.469, "timestamp": "03:06:54", "text": "第一个字母。我不，我不"}, {"type": "subtitle", "time": 11217.07, "timestamp": "03:06:57", "text": "记住那是什么。但"}]
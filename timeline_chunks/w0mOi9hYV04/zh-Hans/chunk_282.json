[{"type": "subtitle", "time": 16920.868, "timestamp": "04:42:00", "text": "当时正在Twitch上直播。那块板子是"}, {"type": "subtitle", "time": 16922.47, "timestamp": "04:42:02", "text": "我认为不存在。我认为是"}, {"type": "subtitle", "time": 16925.03, "timestamp": "04:42:05", "text": "我的论坛频道上有，是的。"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "兄弟，这让我崩溃了。我当时在参与一个合作项目。"}, {"type": "subtitle", "time": 16930.868, "timestamp": "04:42:10", "text": "我邀请了一位嘉宾，然后让观众加入。"}, {"type": "subtitle", "time": 16932.948, "timestamp": "04:42:12", "text": "因为"}, {"type": "subtitle", "time": 16935.35, "timestamp": "04:42:15", "text": "呃，我信任他们。就像……"}, {"type": "subtitle", "time": 16939.39, "timestamp": "04:42:19", "text": "Twitch上的忠实观众过来了"}, {"type": "subtitle", "time": 16943.03, "timestamp": "04:42:23", "text": "当着一个人的面说这些话"}, {"type": "subtitle", "time": 16944.59, "timestamp": "04:42:24", "text": "合作"}, {"type": "subtitle", "time": 16949.83, "timestamp": "04:42:29", "text": "我的伴侣，我感觉很糟糕等等。"}, {"type": "subtitle", "time": 16953.59, "timestamp": "04:42:33", "text": "我很糟糕等等，就像一个爱看阿姨一样"}, {"type": "subtitle", "time": 16957.27, "timestamp": "04:42:37", "text": "或者诸如此类的东西。嗯，我想"}, {"type": "subtitle", "time": 16959.11, "timestamp": "04:42:39", "text": "他们说情况更糟。但"}, {"type": "subtitle", "time": 16962.31, "timestamp": "04:42:42", "text": "是的，在现场听到这些，我"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "我没太注意，但是因为我"}, {"type": "subtitle", "time": 16967.51, "timestamp": "04:42:47", "text": "我不能吗？我好像迟到了两分钟。"}, {"type": "subtitle", "time": 16970.35, "timestamp": "04:42:50", "text": "灯笼裤之类的。我突然意识到"}, {"type": "subtitle", "time": 16972.39, "timestamp": "04:42:52", "text": "然后。我的反应是"}, {"type": "subtitle", "time": 16974.948, "timestamp": "04:42:54", "text": "然后。所以，是的，就像之后"}, {"type": "subtitle", "time": 16977.19, "timestamp": "04:42:57", "text": "直播什么的，也都影响到我了。"}]
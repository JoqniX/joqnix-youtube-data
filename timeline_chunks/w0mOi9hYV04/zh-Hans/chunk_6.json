[{"type": "subtitle", "time": 360.87, "timestamp": "00:06:00", "text": "想知道你加的是什么汤？呃，它"}, {"type": "subtitle", "time": 364.55, "timestamp": "00:06:04", "text": "好像是奶油鸡汤之类的。"}, {"type": "subtitle", "time": 366.23, "timestamp": "00:06:06", "text": "好像跟奶油之类的有关。我"}, {"type": "subtitle", "time": 368.309, "timestamp": "00:06:08", "text": "不知道。是的，还不错。那是"}, {"type": "subtitle", "time": 373.029, "timestamp": "00:06:13", "text": "口感顺滑，嗯，味道不错。甜的。和"}, {"type": "subtitle", "time": 376.39, "timestamp": "00:06:16", "text": "今天我吃了什么？鸡"}, {"type": "subtitle", "time": 378.51, "timestamp": "00:06:18", "text": "呃，玉米汤或"}, {"type": "subtitle", "time": 382.629, "timestamp": "00:06:22", "text": "某物。是的，大概有八个吧。"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "不同类型的汤。八或"}, {"type": "subtitle", "time": 387.11, "timestamp": "00:06:27", "text": "六种不同类型的汤。我"}, {"type": "subtitle", "time": 389.59, "timestamp": "00:06:29", "text": "希望有一天能把它们都尝试一遍。是的。"}, {"type": "subtitle", "time": 391.909, "timestamp": "00:06:31", "text": "是的。我想全部都尝试一下。所以，我"}, {"type": "subtitle", "time": 394.55, "timestamp": "00:06:34", "text": "想每天都去那里，而且"}, {"type": "subtitle", "time": 396.469, "timestamp": "00:06:36", "text": "骑上我的踏板车，然后开车过去。"}, {"type": "subtitle", "time": 398.629, "timestamp": "00:06:38", "text": "到那儿去，骑车过去，然后，你"}, {"type": "subtitle", "time": 400.71, "timestamp": "00:06:40", "text": "知道了，把车停好，然后上去就行了。"}, {"type": "subtitle", "time": 404.749, "timestamp": "00:06:44", "text": "就像拥有它一样，只是"}, {"type": "subtitle", "time": 407.629, "timestamp": "00:06:47", "text": "享受。"}, {"type": "subtitle", "time": 411.11, "timestamp": "00:06:51", "text": "是的。呃，米娅要上大学了。哦，"}, {"type": "subtitle", "time": 413.909, "timestamp": "00:06:53", "text": "你骑着踏板车去学校上课。"}, {"type": "subtitle", "time": 417.83, "timestamp": "00:06:57", "text": "哦，那真不错。太好了。"}, {"type": "subtitle", "time": 419.99, "timestamp": "00:06:59", "text": "我觉得你实际上必须这么做。"}]
[{"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "但是，哦，是的。现在是10点30分。"}, {"type": "subtitle", "time": 4450.79, "timestamp": "01:14:10", "text": "我会在10:30结束直播。好的。所以，"}, {"type": "subtitle", "time": 4453.11, "timestamp": "01:14:13", "text": "我把所有事情都收拾好就去睡觉。"}, {"type": "subtitle", "time": 4456.07, "timestamp": "01:14:16", "text": "到11点。"}, {"type": "subtitle", "time": 4460.709, "timestamp": "01:14:20", "text": "是的。是的。所以，呃，是的，将会……"}, {"type": "subtitle", "time": 4462.709, "timestamp": "01:14:22", "text": "有很多事情正在发生"}, {"type": "subtitle", "time": 4465.709, "timestamp": "01:14:25", "text": "未来几个月。我是"}, {"type": "subtitle", "time": 4468.79, "timestamp": "01:14:28", "text": "害怕的。我既害怕又高兴，而且"}, {"type": "subtitle", "time": 4470.43, "timestamp": "01:14:30", "text": "同样感到害怕"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "时间。所以，我不知道事情会如何发展。"}, {"type": "subtitle", "time": 4475.149, "timestamp": "01:14:35", "text": "去，"}, {"type": "subtitle", "time": 4478.55, "timestamp": "01:14:38", "text": "但我只能说，你的骑师将会是"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "这"}, {"type": "subtitle", "time": 4485.95, "timestamp": "01:14:45", "text": "相同的。是的。"}, {"type": "subtitle", "time": 4490.75, "timestamp": "01:14:50", "text": "D，还有我今天说的那些话。"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "呃，你自己看着办吧，周边商品。"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "这只是猜测，我还没有确认。"}]
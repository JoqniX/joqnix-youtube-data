[{"type": "subtitle", "time": 9720.87, "timestamp": "02:42:00", "text": "离开 Minecraft 服务器时"}, {"type": "subtitle", "time": 9724.469, "timestamp": "02:42:04", "text": "背景音乐流。嘿，这个游戏"}, {"type": "subtitle", "time": 9727.469, "timestamp": "02:42:07", "text": "这款游戏给我的RA值比你高。"}, {"type": "subtitle", "time": 9733.55, "timestamp": "02:42:13", "text": "是的。"}, {"type": "subtitle", "time": 9738.55, "timestamp": "02:42:18", "text": "M：那么，呃，我们继续吧。"}, {"type": "subtitle", "time": 9740.15, "timestamp": "02:42:20", "text": "在我们继续之前，让我，呃，结束。"}, {"type": "subtitle", "time": 9752.59, "timestamp": "02:42:32", "text": "快的。嘿，请告诉我音频情况。"}, {"type": "subtitle", "time": 9754.87, "timestamp": "02:42:34", "text": "体积。请告诉我音量大小。"}, {"type": "subtitle", "time": 9756.63, "timestamp": "02:42:36", "text": "好的。"}, {"type": "subtitle", "time": 9759.07, "timestamp": "02:42:39", "text": "让我知道它听起来怎么样。"}, {"type": "subtitle", "time": 9766.99, "timestamp": "02:42:46", "text": "好的？如果太多了请告诉我。"}, {"type": "subtitle", "time": 9769.75, "timestamp": "02:42:49", "text": "某物。我应该关掉音乐吗？"}, {"type": "subtitle", "time": 9773.27, "timestamp": "02:42:53", "text": "因为我们想要的是轻松自在的感觉，对吧？出色地"}, {"type": "subtitle", "time": 9775.349, "timestamp": "02:42:55", "text": "今天好好放松一下。让我们来谈谈"}, {"type": "subtitle", "time": 9776.59, "timestamp": "02:42:56", "text": "环境"}, {"type": "subtitle", "time": 9779.83, "timestamp": "02:42:59", "text": "在。我们的宝贝们在哪儿？什么？幽灵"}]
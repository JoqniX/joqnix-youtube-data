[{"type": "subtitle", "time": 3482.829, "timestamp": "00:58:02", "text": "下一个是Jock，呃，是我。"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "我本人，也就是Jock背后的那个人，是"}, {"type": "subtitle", "time": 3490.589, "timestamp": "00:58:10", "text": "化身。是的。所以我认为它会"}, {"type": "subtitle", "time": 3493.99, "timestamp": "00:58:13", "text": "工作。我的意思是，性别并不重要。"}, {"type": "subtitle", "time": 3497.51, "timestamp": "00:58:17", "text": "这个人，呃，这个人的性格和"}, {"type": "subtitle", "time": 3501.27, "timestamp": "00:58:21", "text": "情绪以及我所做的任何胡闹"}, {"type": "subtitle", "time": 3510.829, "timestamp": "00:58:30", "text": "嗯，我以为兄弟是武器专家。"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "文学作品里可没提到过我从未听过的事。"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "关于我所拥有的一切，都源于一个词。"}, {"type": "subtitle", "time": 3520.51, "timestamp": "00:58:40", "text": "就像Java一样，就像一台计算机或"}, {"type": "subtitle", "time": 3523.43, "timestamp": "00:58:43", "text": "某个Apache服务器之类的东西"}, {"type": "subtitle", "time": 3529.99, "timestamp": "00:58:49", "text": "这。乔伊因为被人恶意骚扰而遭到骚扰。"}]
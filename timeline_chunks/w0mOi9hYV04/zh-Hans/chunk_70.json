[{"type": "subtitle", "time": 4205.83, "timestamp": "01:10:05", "text": "嗯，是的，事情就是这样。为什么是"}, {"type": "subtitle", "time": 4208.44, "timestamp": "01:10:08", "text": "我的模型卡住了？"}, {"type": "subtitle", "time": 4210.55, "timestamp": "01:10:10", "text": "[音乐]"}, {"type": "subtitle", "time": 4212.87, "timestamp": "01:10:12", "text": "是的，那主要是"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "我一直在旅行的原因"}, {"type": "subtitle", "time": 4217.91, "timestamp": "01:10:17", "text": "然后关掉。但现在，我不需要"}, {"type": "subtitle", "time": 4218.91, "timestamp": "01:10:18", "text": "用过的"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "公共汽车。呃，我可以骑车回家。是的，"}, {"type": "subtitle", "time": 4226.79, "timestamp": "01:10:26", "text": "骑车很好。我会习惯骑车的。"}, {"type": "subtitle", "time": 4229.189, "timestamp": "01:10:29", "text": "高速公路。就好像它不是一辆自行车一样。它是"}, {"type": "subtitle", "time": 4231.03, "timestamp": "01:10:31", "text": "更像是一辆踏板车。等等，这是什么？"}, {"type": "subtitle", "time": 4233.91, "timestamp": "01:10:33", "text": "踏板车和自行车的区别"}, {"type": "subtitle", "time": 4235.709, "timestamp": "01:10:35", "text": "一个"}, {"type": "subtitle", "time": 4238.11, "timestamp": "01:10:38", "text": "小摩托？什么是"}, {"type": "subtitle", "time": 4241.75, "timestamp": "01:10:41", "text": "那？在提到两个我们呃他们之后"}, {"type": "subtitle", "time": 4243.27, "timestamp": "01:10:43", "text": "不同的起源和延续"}, {"type": "subtitle", "time": 4245.07, "timestamp": "01:10:45", "text": "德平"}, {"type": "subtitle", "time": 4248.99, "timestamp": "01:10:48", "text": "嗯，好吧，是设计，还有哦"}, {"type": "subtitle", "time": 4259.83, "timestamp": "01:10:59", "text": "猜猜安吉拉说了些什么"}]
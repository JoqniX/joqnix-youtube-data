[{"type": "subtitle", "time": 7140.87, "timestamp": "01:59:00", "text": "呃，我的意思是，那件事"}, {"type": "subtitle", "time": 7144.709, "timestamp": "01:59:04", "text": "现在这是我的声音了。呃，那东西"}, {"type": "subtitle", "time": 7148.55, "timestamp": "01:59:08", "text": "我的声音是不是有点让人困惑？"}, {"type": "subtitle", "time": 7151.91, "timestamp": "01:59:11", "text": "你对某些观众来说就像他们想的那样"}, {"type": "subtitle", "time": 7154.39, "timestamp": "01:59:14", "text": "有时他们会觉得我是个女孩"}, {"type": "subtitle", "time": 7158.31, "timestamp": "01:59:18", "text": "我是个男孩。我不知道为什么。就是这样。"}, {"type": "subtitle", "time": 7161.669, "timestamp": "01:59:21", "text": "我为什么认为雌雄同体模型会合适"}, {"type": "subtitle", "time": 7168.669, "timestamp": "01:59:28", "text": "我的声音和Jock，因为Jock下一个就是我。"}, {"type": "subtitle", "time": 7172.149, "timestamp": "01:59:32", "text": "我本人就是Jock背后的这个人"}, {"type": "subtitle", "time": 7176.43, "timestamp": "01:59:36", "text": "化身。所以，是的，所以我当时想，那会"}, {"type": "subtitle", "time": 7179.83, "timestamp": "01:59:39", "text": "工作。我的意思是，gendum（性别）并不重要。"}, {"type": "subtitle", "time": 7183.43, "timestamp": "01:59:43", "text": "这个人，呃，这个人的性格和"}, {"type": "subtitle", "time": 7186.87, "timestamp": "01:59:46", "text": "情绪以及呃，不管是什么乱七八糟的事"}, {"type": "subtitle", "time": 7195.189, "timestamp": "01:59:55", "text": "嗯，我以为兄弟是武器专家。"}, {"type": "subtitle", "time": 7196.75, "timestamp": "01:59:56", "text": "哪个"}]
[{"type": "subtitle", "time": 5280.39, "timestamp": "01:28:00", "text": "我的生日是。所以，以防万一"}, {"type": "subtitle", "time": 5283.51, "timestamp": "01:28:03", "text": "谁都会忘记。我完全没做那件事。"}, {"type": "subtitle", "time": 5285.43, "timestamp": "01:28:05", "text": "仅仅因为这样人们就可以"}, {"type": "subtitle", "time": 5292.87, "timestamp": "01:28:12", "text": "没有什么。我知道这很有趣。我觉得很有趣"}, {"type": "subtitle", "time": 5294.95, "timestamp": "01:28:14", "text": "捉弄你。等等，那是你吗？"}, {"type": "subtitle", "time": 5297.39, "timestamp": "01:28:17", "text": "跟我开玩笑。等待，"}, {"type": "subtitle", "time": 5300.71, "timestamp": "01:28:20", "text": "什么？我的天啊。"}, {"type": "subtitle", "time": 5302.91, "timestamp": "01:28:22", "text": "[音乐]"}, {"type": "subtitle", "time": 5305.629, "timestamp": "01:28:25", "text": "哇。瓦"}, {"type": "subtitle", "time": 5313.95, "timestamp": "01:28:33", "text": "水。让我拿一些"}, {"type": "subtitle", "time": 5316.55, "timestamp": "01:28:36", "text": "水。您好，Zaki Travel。欢迎来到"}, {"type": "subtitle", "time": 5318.51, "timestamp": "01:28:38", "text": "溪流。希望你一切顺利"}, {"type": "subtitle", "time": 5321.65, "timestamp": "01:28:41", "text": "出色地。一直是"}, {"type": "subtitle", "time": 5324.189, "timestamp": "01:28:44", "text": "[音乐]"}, {"type": "subtitle", "time": 5333.07, "timestamp": "01:28:53", "text": "水。是的，就是这样。"}, {"type": "subtitle", "time": 5336.07, "timestamp": "01:28:56", "text": "热的。 4月16日。今天是谁的生日？"}, {"type": "subtitle", "time": 5338.11, "timestamp": "01:28:58", "text": "呃，是忍者（Ninja）的生日。"}]
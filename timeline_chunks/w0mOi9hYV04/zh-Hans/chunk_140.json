[{"type": "subtitle", "time": 8404.79, "timestamp": "02:20:04", "text": "是的。角色扮演游戏。真有趣。以及被遮蔽的"}, {"type": "subtitle", "time": 8407.51, "timestamp": "02:20:07", "text": "说实话，看起来很有趣。夜莺是"}, {"type": "subtitle", "time": 8409.74, "timestamp": "02:20:09", "text": "也很好"}, {"type": "subtitle", "time": 8413.63, "timestamp": "02:20:13", "text": "[音乐]"}, {"type": "subtitle", "time": 8417.75, "timestamp": "02:20:17", "text": "方式，但我很喜欢这类游戏。"}, {"type": "subtitle", "time": 8422.87, "timestamp": "02:20:22", "text": "[音乐]"}, {"type": "subtitle", "time": 8425.99, "timestamp": "02:20:25", "text": "我喜欢这类游戏，但是……"}, {"type": "subtitle", "time": 8428.87, "timestamp": "02:20:28", "text": "只是我必须真的这么做。"}, {"type": "subtitle", "time": 8431.389, "timestamp": "02:20:31", "text": "播放它。那就是"}, {"type": "subtitle", "time": 8435.79, "timestamp": "02:20:35", "text": "事物。哦，昨天就出来了。"}, {"type": "subtitle", "time": 8438.55, "timestamp": "02:20:38", "text": "什么？这款游戏昨天刚发售。哦"}, {"type": "subtitle", "time": 8439.79, "timestamp": "02:20:39", "text": "我的上帝。"}, {"type": "subtitle", "time": 8448.349, "timestamp": "02:20:48", "text": "被笼罩？"}, {"type": "subtitle", "time": 8450.55, "timestamp": "02:20:50", "text": "1300。好的。"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "Shroud上个月24号发行。"}, {"type": "subtitle", "time": 8454.12, "timestamp": "02:20:54", "text": "一月。"}]
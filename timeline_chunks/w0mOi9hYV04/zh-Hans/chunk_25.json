[{"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "好的。等待。什么？等待。嗯？这是你的"}, {"type": "subtitle", "time": 1508.269, "timestamp": "00:25:08", "text": "生日。生日快乐。等待。嗯？"}, {"type": "subtitle", "time": 1510.59, "timestamp": "00:25:10", "text": "真的吗？等待。今天是你的生日。等待。"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "真的吗？开玩笑。只是在开玩笑。哦，不是的。"}, {"type": "subtitle", "time": 1516.23, "timestamp": "00:25:16", "text": "你的生日。好的。我兴奋起来了"}, {"type": "subtitle", "time": 1520.35, "timestamp": "00:25:20", "text": "一秒钟。哦，告诉我是不是你的"}, {"type": "subtitle", "time": 1523.59, "timestamp": "00:25:23", "text": "生日。我会唱歌给你听，我会唱歌给你听。"}, {"type": "subtitle", "time": 1543.669, "timestamp": "00:25:43", "text": "生日。呃，今天是我的生日月。"}, {"type": "subtitle", "time": 1546.63, "timestamp": "00:25:46", "text": "我的生日在七月。哦好的。做"}, {"type": "subtitle", "time": 1549.029, "timestamp": "00:25:49", "text": "提醒我一下有没有人过生日……"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "快要发生了或者类似的事情。好的。我会尽力"}, {"type": "subtitle", "time": 1554.23, "timestamp": "00:25:54", "text": "记住，或者我会试着把它记在我的……"}, {"type": "subtitle", "time": 1557.669, "timestamp": "00:25:57", "text": "用日历提醒自己。那么如果我"}]
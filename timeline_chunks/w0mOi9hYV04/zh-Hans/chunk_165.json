[{"type": "subtitle", "time": 9904.349, "timestamp": "02:45:04", "text": "少量。呃，以前有个樱花等着呢"}, {"type": "subtitle", "time": 9908.19, "timestamp": "02:45:08", "text": "樱花专辑。是的。"}, {"type": "subtitle", "time": 9910.95, "timestamp": "02:45:10", "text": "尼科。等等，这不是那个。这才是我要找的。"}, {"type": "subtitle", "time": 9914.99, "timestamp": "02:45:14", "text": "玩。喂。播放这个。"}, {"type": "subtitle", "time": 9922.11, "timestamp": "02:45:22", "text": "嗯？"}, {"type": "subtitle", "time": 9931.63, "timestamp": "02:45:31", "text": "好的。是的，这很好。我们开始吧"}, {"type": "subtitle", "time": 9933.389, "timestamp": "02:45:33", "text": "来。"}, {"type": "subtitle", "time": 9936.59, "timestamp": "02:45:36", "text": "你好。唤醒"}, {"type": "subtitle", "time": 9939.19, "timestamp": "02:45:39", "text": "向上。如果你需要我美妙的歌声"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "语音方面，直接问就行了。我想谈谈。不，是"}, {"type": "subtitle", "time": 9944.19, "timestamp": "02:45:44", "text": "坏的。"}, {"type": "subtitle", "time": 9947.309, "timestamp": "02:45:47", "text": "BTM。我没看错吧？"}, {"type": "subtitle", "time": 9949.63, "timestamp": "02:45:49", "text": "宝贝们。我想知道。"}, {"type": "subtitle", "time": 9950.79, "timestamp": "02:45:50", "text": "[音乐]"}, {"type": "subtitle", "time": 9958.63, "timestamp": "02:45:58", "text": "想知道。嗯，我会尽可能久地待在这里。"}]
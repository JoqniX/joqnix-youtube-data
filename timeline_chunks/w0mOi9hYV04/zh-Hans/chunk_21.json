[{"type": "subtitle", "time": 1260.789, "timestamp": "00:21:00", "text": "渠道。为什么不呢？但如果我们得到"}, {"type": "subtitle", "time": 1263.59, "timestamp": "00:21:03", "text": "用剪钳之类的东西，我们可以，我可以工作"}, {"type": "subtitle", "time": 1266.549, "timestamp": "00:21:06", "text": "和他们在一起，然后像官方人士一样，呃，就像"}, {"type": "subtitle", "time": 1270.39, "timestamp": "00:21:10", "text": "一部正式的官方短剧，或许"}, {"type": "subtitle", "time": 1272.39, "timestamp": "00:21:12", "text": "我可以把它上传到主频道。我"}, {"type": "subtitle", "time": 1274.149, "timestamp": "00:21:14", "text": "不知道。"}, {"type": "subtitle", "time": 1276.47, "timestamp": "00:21:16", "text": "呃，当太阳落山时，他们会向V方向移动。"}, {"type": "subtitle", "time": 1279.11, "timestamp": "00:21:19", "text": "是啊，为什么不呢？让他们服从V"}, {"type": "subtitle", "time": 1281.909, "timestamp": "00:21:21", "text": "渠道。我的意思是，呃，V频道会有"}, {"type": "subtitle", "time": 1285.35, "timestamp": "00:21:25", "text": "就像我直播的其他所有频道一样"}, {"type": "subtitle", "time": 1287.75, "timestamp": "00:21:27", "text": "在其他所有平台上都是如此，对吧？点赞"}, {"type": "subtitle", "time": 1290.19, "timestamp": "00:21:30", "text": "我正在直播"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "有哪些流媒体独家内容值得喜欢"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "像 Vstream 或 Kick 这样的平台"}, {"type": "subtitle", "time": 1298.87, "timestamp": "00:21:38", "text": "现实或比利比利，所有这些都将是"}, {"type": "subtitle", "time": 1300.87, "timestamp": "00:21:40", "text": "现在就在板子上，但你是"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "某种程度上被掩盖了，但又好像我没有。"}, {"type": "subtitle", "time": 1306.549, "timestamp": "00:21:46", "text": "我知道我必须为此做点什么。"}, {"type": "subtitle", "time": 1310.39, "timestamp": "00:21:50", "text": "大概呃呃，管理层会揍我。"}, {"type": "subtitle", "time": 1313.75, "timestamp": "00:21:53", "text": "而且就像……嗯，你这个运动员……"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "为了宣传你的运动装备"}, {"type": "subtitle", "time": 1319.669, "timestamp": "00:21:59", "text": "我心想，是啊，我的意思是，严格来说"}]
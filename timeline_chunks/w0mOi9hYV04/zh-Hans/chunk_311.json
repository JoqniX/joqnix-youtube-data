[{"type": "subtitle", "time": 18663.91, "timestamp": "05:11:03", "text": "珍惜生活中的小事，比如……"}, {"type": "subtitle", "time": 18665.83, "timestamp": "05:11:05", "text": "直播的时候，来了一个人。"}, {"type": "chat", "time": 18666.86, "timestamp": "05:11:06", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "often"}, {"type": "subtitle", "time": 18667.23, "timestamp": "05:11:07", "text": "与……聊天"}, {"type": "subtitle", "time": 18670.39, "timestamp": "05:11:10", "text": "我还记得那一刻"}, {"type": "subtitle", "time": 18672.948, "timestamp": "05:11:12", "text": "珍惜那一刻。是的，你做到了。"}, {"type": "subtitle", "time": 18676.39, "timestamp": "05:11:16", "text": "尽你所能。至少有一个人路过。"}, {"type": "subtitle", "time": 18679.11, "timestamp": "05:11:19", "text": "是的。第二天尽你所能。二"}, {"type": "subtitle", "time": 18682.788, "timestamp": "05:11:22", "text": "人们就这样陆续走过来。即使"}, {"type": "subtitle", "time": 18685.59, "timestamp": "05:11:25", "text": "人来人往。记住这一点"}, {"type": "subtitle", "time": 18688.948, "timestamp": "05:11:28", "text": "人来人往。你遇到的人"}, {"type": "subtitle", "time": 18691.91, "timestamp": "05:11:31", "text": "以你目前的尺码来看，未来"}, {"type": "subtitle", "time": 18694.07, "timestamp": "05:11:34", "text": "当你穿较大尺码的衣服时，它们可能会"}, {"type": "chat", "time": 18696.768, "timestamp": "05:11:36", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "If you have time we can play mc i wanna distract myself :)"}, {"type": "subtitle", "time": 18697.59, "timestamp": "05:11:37", "text": "离开是因为有些人"}, {"type": "subtitle", "time": 18699.75, "timestamp": "05:11:39", "text": "他们喜欢与规模较小的群体互动。"}, {"type": "subtitle", "time": 18702.628, "timestamp": "05:11:42", "text": "创作者，因为他们可以拥有密切的联系"}, {"type": "subtitle", "time": 18706.23, "timestamp": "05:11:46", "text": "联系或交谈就像和他们交谈一样"}, {"type": "subtitle", "time": 18708.15, "timestamp": "05:11:48", "text": "东西。他们会阅读你的信息等等。"}, {"type": "subtitle", "time": 18711.31, "timestamp": "05:11:51", "text": "正确的？正如我所说，"}, {"type": "subtitle", "time": 18714.11, "timestamp": "05:11:54", "text": "嗯，就是那些东西，对吧？"}, {"type": "subtitle", "time": 18717.15, "timestamp": "05:11:57", "text": "等等，刚才那是什么？"}]
[{"type": "subtitle", "time": 4560.03, "timestamp": "01:16:00", "text": "很多呃"}, {"type": "subtitle", "time": 4563.83, "timestamp": "01:16:03", "text": "那方面的工作太多了。所以，我"}, {"type": "subtitle", "time": 4566.03, "timestamp": "01:16:06", "text": "我没什么好说的。"}, {"type": "subtitle", "time": 4569.03, "timestamp": "01:16:09", "text": "遗憾的是，除非一切都……"}, {"type": "subtitle", "time": 4578.83, "timestamp": "01:16:18", "text": "比什。是的，我是"}, {"type": "subtitle", "time": 4586.189, "timestamp": "01:16:26", "text": "出色地。"}, {"type": "subtitle", "time": 4600.229, "timestamp": "01:16:40", "text": "后退。我的天哪，你居然在学习"}, {"type": "subtitle", "time": 4602.79, "timestamp": "01:16:42", "text": "西班牙语。好的。还有一件事。好，好"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "对你有好处。对我来说，我必须学习呃"}, {"type": "subtitle", "time": 4609.43, "timestamp": "01:16:49", "text": "日本人，帮我补补日语。呃"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "最近，我和爱丽丝一起出去玩。"}, {"type": "subtitle", "time": 4614.79, "timestamp": "01:16:54", "text": "在VR聊天中，你猜怎么着？他不得不"}, {"type": "subtitle", "time": 4617.91, "timestamp": "01:16:57", "text": "带着我一路走来"}]
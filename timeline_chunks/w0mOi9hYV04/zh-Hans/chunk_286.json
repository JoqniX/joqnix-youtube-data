[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "社区，甚至还有社区"}, {"type": "subtitle", "time": 17164.23, "timestamp": "04:46:04", "text": "你觉得舒服的地方"}, {"type": "subtitle", "time": 17166.47, "timestamp": "04:46:06", "text": "观众等等。所以你有"}, {"type": "subtitle", "time": 17169.43, "timestamp": "04:46:09", "text": "要像你有一天醒来时那样感到自豪"}, {"type": "subtitle", "time": 17172.07, "timestamp": "04:46:12", "text": "你会像这样：我要开始直播了"}, {"type": "subtitle", "time": 17174.39, "timestamp": "04:46:14", "text": "人们会给你带来积极的能量。"}, {"type": "subtitle", "time": 17177.27, "timestamp": "04:46:17", "text": "让你感到更快乐的能量"}, {"type": "subtitle", "time": 17179.51, "timestamp": "04:46:19", "text": "并为此感到自豪。第二天你将会……"}, {"type": "subtitle", "time": 17182.708, "timestamp": "04:46:22", "text": "是的，我喜欢直播。我爱我的"}, {"type": "subtitle", "time": 17185.83, "timestamp": "04:46:25", "text": "观众。我会尽我所能。和"}, {"type": "subtitle", "time": 17188.47, "timestamp": "04:46:28", "text": "第二天你就来直播了"}, {"type": "subtitle", "time": 17196.31, "timestamp": "04:46:36", "text": "开心吧？"}, {"type": "chat", "time": 17198.039, "timestamp": "04:46:38", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I lost all the motivation to stream im literally crying rn"}, {"type": "subtitle", "time": 17199.47, "timestamp": "04:46:39", "text": "这就是最终目标。"}, {"type": "subtitle", "time": 17203.23, "timestamp": "04:46:43", "text": "正确的？所以，请随意点赞。"}, {"type": "subtitle", "time": 17207.27, "timestamp": "04:46:47", "text": "嗯，告诉你的听众，是的，"}, {"type": "subtitle", "time": 17209.75, "timestamp": "04:46:49", "text": "请不要那样做。它确实会产生影响"}, {"type": "subtitle", "time": 17211.99, "timestamp": "04:46:51", "text": "我和一切。"}, {"type": "subtitle", "time": 17212.99, "timestamp": "04:46:52", "text": "但"}, {"type": "subtitle", "time": 17216.708, "timestamp": "04:46:56", "text": "也知道这会给你带来多大的精神创伤。"}, {"type": "subtitle", "time": 17219.83, "timestamp": "04:46:59", "text": "我建议你暂停一下流媒体播放。"}]
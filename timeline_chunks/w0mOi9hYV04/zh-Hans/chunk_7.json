[{"type": "subtitle", "time": 423.35, "timestamp": "00:07:03", "text": "接受如何面对的训练"}, {"type": "subtitle", "time": 430.309, "timestamp": "00:07:10", "text": "把那些东西都塞进去。 N 太好了。所以"}, {"type": "subtitle", "time": 433.27, "timestamp": "00:07:13", "text": "好的。好的。好的。继续努力吧。我会"}, {"type": "subtitle", "time": 437.27, "timestamp": "00:07:17", "text": "我也会尽力……嗯……我也会尽力……"}, {"type": "subtitle", "time": 440.309, "timestamp": "00:07:20", "text": "最好"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "呃，习惯明天吧。我其实"}, {"type": "subtitle", "time": 444.87, "timestamp": "00:07:24", "text": "开车回家，骑车回家"}, {"type": "subtitle", "time": 447.15, "timestamp": "00:07:27", "text": "清晨。所以不会有"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "嗯，是的，我要回家了。"}, {"type": "subtitle", "time": 457.27, "timestamp": "00:07:37", "text": "只是想让我爸爸……呃……然后……呃……"}, {"type": "subtitle", "time": 460.87, "timestamp": "00:07:40", "text": "我得像个手机用户一样去看看。"}, {"type": "subtitle", "time": 464.55, "timestamp": "00:07:44", "text": "商店。这是给我的SIM卡用的。"}, {"type": "subtitle", "time": 467.43, "timestamp": "00:07:47", "text": "呃，我的SIM卡好像丢了，而且"}, {"type": "subtitle", "time": 471.99, "timestamp": "00:07:51", "text": "需要弄清楚是否像短信那样"}, {"type": "subtitle", "time": 474.07, "timestamp": "00:07:54", "text": "呃，转发是可能的，或者类似的事情"}, {"type": "subtitle", "time": 476.469, "timestamp": "00:07:56", "text": "因为我插不进第二张SIM卡"}]
[{"type": "subtitle", "time": 17343.07, "timestamp": "04:49:03", "text": "因为他们在不知情的情况下做了这件事"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "对，因为我知道一些……"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "在某些方面，我的意思是，就我个人而言"}, {"type": "subtitle", "time": 17356.948, "timestamp": "04:49:16", "text": "还没正式宣布，但是嗯，有些……"}, {"type": "subtitle", "time": 17358.868, "timestamp": "04:49:18", "text": "一些主播社区之类的"}, {"type": "subtitle", "time": 17360.868, "timestamp": "04:49:20", "text": "人们试图欺负他们的主播"}, {"type": "subtitle", "time": 17363.03, "timestamp": "04:49:23", "text": "还有一些其他的东西。一切都只是玩乐而已，但"}, {"type": "subtitle", "time": 17365.67, "timestamp": "04:49:25", "text": "你知道，有时候如果你欺负别人"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "太多了，嘲笑和喜欢看"}, {"type": "subtitle", "time": 17371.67, "timestamp": "04:49:31", "text": "如果你笑得太多了，那就太不好了。"}, {"type": "subtitle", "time": 17376.07, "timestamp": "04:49:36", "text": "太多了，它会让你感觉"}, {"type": "subtitle", "time": 17378.708, "timestamp": "04:49:38", "text": "破碎的。不，感觉他们好像要带走你。"}, {"type": "subtitle", "time": 17382.07, "timestamp": "04:49:42", "text": "就像……就像看到你什么都不是一样"}, {"type": "subtitle", "time": 17385.03, "timestamp": "04:49:45", "text": "把你当灯之类的东西带走了。可以"}, {"type": "subtitle", "time": 17387.19, "timestamp": "04:49:47", "text": "我不太会表达，但我希望你"}, {"type": "chat", "time": 17389.523, "timestamp": "04:49:49", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}, {"type": "subtitle", "time": 17390.07, "timestamp": "04:49:50", "text": "你明白我的意思吧？我"}, {"type": "subtitle", "time": 17391.67, "timestamp": "04:49:51", "text": "希望你能明白我的意思。"}]
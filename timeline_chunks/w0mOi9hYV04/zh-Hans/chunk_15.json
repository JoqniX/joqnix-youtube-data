[{"type": "subtitle", "time": 905.069, "timestamp": "00:15:05", "text": "你管它叫什么？我认为更像是"}, {"type": "subtitle", "time": 909.189, "timestamp": "00:15:09", "text": "嗯……我觉得更像是你知道的。"}, {"type": "subtitle", "time": 910.67, "timestamp": "00:15:10", "text": "呃"}, {"type": "subtitle", "time": 913.31, "timestamp": "00:15:13", "text": "不确定性"}, {"type": "subtitle", "time": 916.55, "timestamp": "00:15:16", "text": "东西。东西都到此为止了吗？不，那是"}, {"type": "subtitle", "time": 919.11, "timestamp": "00:15:19", "text": "还有一点我比较欠缺。"}, {"type": "subtitle", "time": 921.67, "timestamp": "00:15:21", "text": "它。是的。你好 Craz，欢迎。欢迎来到"}, {"type": "subtitle", "time": 924.069, "timestamp": "00:15:24", "text": "溪流。希望你一切都好。"}, {"type": "subtitle", "time": 930.189, "timestamp": "00:15:30", "text": "是的，不安全"}, {"type": "subtitle", "time": 933.829, "timestamp": "00:15:33", "text": "东西。你知道，事情的不确定性，因为"}, {"type": "subtitle", "time": 937.03, "timestamp": "00:15:37", "text": "我当时有很多事情要做。"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "现在很难管理，而且令人信服。"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "直播也是我必须做的事情。"}, {"type": "subtitle", "time": 943.389, "timestamp": "00:15:43", "text": "和"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "是的，这很难做到，但确实如此。"}, {"type": "subtitle", "time": 948.47, "timestamp": "00:15:48", "text": "它是什么？不过没关系。出色地"}, {"type": "subtitle", "time": 951.11, "timestamp": "00:15:51", "text": "慢慢地"}, {"type": "subtitle", "time": 954.069, "timestamp": "00:15:54", "text": "呃，搞定它，让它运转起来。是的。制作一个"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "是的。是的。我想把……"}, {"type": "subtitle", "time": 958.23, "timestamp": "00:15:58", "text": "安排事项。是的。而且还有类似这样的"}]
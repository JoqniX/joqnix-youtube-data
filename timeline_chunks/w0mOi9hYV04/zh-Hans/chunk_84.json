[{"type": "subtitle", "time": 5041.99, "timestamp": "01:24:01", "text": "我们所有的直播流中都有，它们都是"}, {"type": "subtitle", "time": 5045.51, "timestamp": "01:24:05", "text": "例如 Reality Studios 制作的粉丝自制原声带"}, {"type": "subtitle", "time": 5049.27, "timestamp": "01:24:09", "text": "还有艾森。是的，我很高兴。谢谢。"}, {"type": "subtitle", "time": 5052.31, "timestamp": "01:24:12", "text": "我很高兴。我的模型为什么卡住了？喂，"}, {"type": "subtitle", "time": 5054.55, "timestamp": "01:24:14", "text": "移动。我在表达自己。好的。好的，"}, {"type": "subtitle", "time": 5056.51, "timestamp": "01:24:16", "text": "它是"}, {"type": "subtitle", "time": 5059.55, "timestamp": "01:24:19", "text": "移动。呃，难道不是这样更好吗？"}, {"type": "subtitle", "time": 5076.43, "timestamp": "01:24:36", "text": "现在悄悄地。"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "嗯，我也对此感到困惑，因为我"}, {"type": "subtitle", "time": 5082.87, "timestamp": "01:24:42", "text": "最终还是得推广那个呃"}, {"type": "subtitle", "time": 5085.229, "timestamp": "01:24:45", "text": "频道下一个帐户。"}, {"type": "subtitle", "time": 5088.55, "timestamp": "01:24:48", "text": "嗯，如果你看看我的比利比利"}, {"type": "subtitle", "time": 5091.669, "timestamp": "01:24:51", "text": "账户看起来空空如也。直到你"}, {"type": "subtitle", "time": 5093.51, "timestamp": "01:24:53", "text": "偶然发现我的直播，你就会"}, {"type": "subtitle", "time": 5095.51, "timestamp": "01:24:55", "text": "比如，“哦，这个人，这真是个……”"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "正在制作内容的账号。哦，"}, {"type": "subtitle", "time": 5099.95, "timestamp": "01:24:59", "text": "这是真的"}]
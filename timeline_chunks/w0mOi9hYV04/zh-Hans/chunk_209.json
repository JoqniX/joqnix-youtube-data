[{"type": "subtitle", "time": 12543.79, "timestamp": "03:29:03", "text": "我的天哪，这不是"}, {"type": "subtitle", "time": 12574.59, "timestamp": "03:29:34", "text": "稍等"}, {"type": "subtitle", "time": 12577.03, "timestamp": "03:29:37", "text": "分钟。但它没动，兄弟。什么"}, {"type": "subtitle", "time": 12578.03, "timestamp": "03:29:38", "text": "见鬼"}]
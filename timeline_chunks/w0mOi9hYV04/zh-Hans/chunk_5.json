[{"type": "subtitle", "time": 301.909, "timestamp": "00:05:01", "text": "他竟然活了下来。是的。是的。我"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "他竟然活了下来。但是，呃，当我转弯时"}, {"type": "subtitle", "time": 306.83, "timestamp": "00:05:06", "text": "差点打到那个人。我当时我得到了"}, {"type": "subtitle", "time": 310.15, "timestamp": "00:05:10", "text": "害怕的。我哭得好厉害，真的"}, {"type": "subtitle", "time": 313.27, "timestamp": "00:05:13", "text": "在路边哭泣，就像这样，哦"}, {"type": "subtitle", "time": 316.11, "timestamp": "00:05:16", "text": "我的天啊，我差点"}, {"type": "subtitle", "time": 318.39, "timestamp": "00:05:18", "text": "死了。哦，是的。是的。所有那些东西"}, {"type": "subtitle", "time": 321.71, "timestamp": "00:05:21", "text": "事情发生了，从那以后我就……"}, {"type": "subtitle", "time": 325.11, "timestamp": "00:05:25", "text": "自从我把它带回来之后。"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "是的。今天我去……"}, {"type": "subtitle", "time": 330.83, "timestamp": "00:05:30", "text": "下雨，我迷路了。呃，然后是谷歌"}, {"type": "subtitle", "time": 332.909, "timestamp": "00:05:32", "text": "已保存的地图"}, {"type": "subtitle", "time": 337.189, "timestamp": "00:05:37", "text": "我。是的。谷歌地图今天真是帮了我大忙。"}, {"type": "subtitle", "time": 339.749, "timestamp": "00:05:39", "text": "是的，我去了一家餐馆。我"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "我记得那好像是个中国人。"}, {"type": "subtitle", "time": 345.83, "timestamp": "00:05:45", "text": "某餐厅。呃，我喝了汤。我"}, {"type": "subtitle", "time": 349.029, "timestamp": "00:05:49", "text": "我喝了汤。呃，我那天就有了。"}, {"type": "subtitle", "time": 351.67, "timestamp": "00:05:51", "text": "我也来过这里。所以那天我得到"}, {"type": "subtitle", "time": 354.79, "timestamp": "00:05:54", "text": "skura，Amber 在这里回复了它。"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "那天我喝了点汤。如果你是"}]
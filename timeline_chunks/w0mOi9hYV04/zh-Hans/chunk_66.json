[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "语境。好的。语境。我的意思是"}, {"type": "subtitle", "time": 3964.95, "timestamp": "01:06:04", "text": "这。动漫展。让他喘口气。是的，我"}, {"type": "subtitle", "time": 3966.25, "timestamp": "01:06:06", "text": "需要呼吸。"}, {"type": "subtitle", "time": 3969.549, "timestamp": "01:06:09", "text": "[笑声]"}, {"type": "subtitle", "time": 3972.549, "timestamp": "01:06:12", "text": "呼吸，老兄。已经过去一段时间了。我"}, {"type": "subtitle", "time": 3974.71, "timestamp": "01:06:14", "text": "做到了。所以，我今天过得很愉快。我是"}, {"type": "subtitle", "time": 3977.349, "timestamp": "01:06:17", "text": "快乐的。希望你们都放松心情。"}, {"type": "subtitle", "time": 3990.789, "timestamp": "01:06:30", "text": "男生。是的。嗯，我刚才说到哪儿了？在哪里"}, {"type": "subtitle", "time": 3993.75, "timestamp": "01:06:33", "text": "是我吗？我刚才说到哪儿了？我刚才说到哪儿了？什么是"}, {"type": "subtitle", "time": 3996.19, "timestamp": "01:06:36", "text": "100毫升？"}, {"type": "subtitle", "time": 3999.67, "timestamp": "01:06:39", "text": "呃，100个什么？"}, {"type": "subtitle", "time": 4002.51, "timestamp": "01:06:42", "text": "钱币收藏"}, {"type": "subtitle", "time": 4014.589, "timestamp": "01:06:54", "text": "cc？什么？嗯？ 100cc是多少？"}, {"type": "subtitle", "time": 4017.87, "timestamp": "01:06:57", "text": "正确的？ 100是多少"}]
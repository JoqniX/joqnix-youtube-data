[{"type": "subtitle", "time": 7261.95, "timestamp": "02:01:01", "text": "呃，又回家了之类的。"}, {"type": "subtitle", "time": 7266.87, "timestamp": "02:01:06", "text": "嗯，所以，嗯，我呃，达成了一项交易或一项"}, {"type": "subtitle", "time": 7269.31, "timestamp": "02:01:09", "text": "与我父亲的结尾"}, {"type": "subtitle", "time": 7272.55, "timestamp": "02:01:12", "text": "我想要单独的空间，因为我"}, {"type": "subtitle", "time": 7276.629, "timestamp": "02:01:16", "text": "即便如此，我也想要我的自由和独立。"}, {"type": "subtitle", "time": 7279.189, "timestamp": "02:01:19", "text": "是的，所以他们可能会开始……"}, {"type": "subtitle", "time": 7283.75, "timestamp": "02:01:23", "text": "三月份前后都要工作，因为我会……"}, {"type": "subtitle", "time": 7286.47, "timestamp": "02:01:26", "text": "拥有自己的办公空间"}, {"type": "subtitle", "time": 7291.229, "timestamp": "02:01:31", "text": "可以说，因为嗯嗯，因为呃，我的房客"}, {"type": "subtitle", "time": 7304.149, "timestamp": "02:01:44", "text": "我们可以设立一个类似区域的地方。"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "供你居住，还有一些"}, {"type": "subtitle", "time": 7310.03, "timestamp": "02:01:50", "text": "楼上，我们会重新装修。"}, {"type": "subtitle", "time": 7313.51, "timestamp": "02:01:53", "text": "整个楼上空间并分隔成"}, {"type": "subtitle", "time": 7315.75, "timestamp": "02:01:55", "text": "分为两部分，这样你就可以有两个租户了。"}]
[{"type": "subtitle", "time": 3363.99, "timestamp": "00:56:03", "text": "在我脑海中的一些概念艺术作品中"}, {"type": "subtitle", "time": 3368.069, "timestamp": "00:56:08", "text": "很久以前我就有了这个设计。所以我就想"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "或许我可以用那些概念图。"}, {"type": "subtitle", "time": 3374.589, "timestamp": "00:56:14", "text": "不是？"}, {"type": "subtitle", "time": 3377.829, "timestamp": "00:56:17", "text": "呃，我只留了大概一个星期的长发。"}, {"type": "subtitle", "time": 3380.19, "timestamp": "00:56:20", "text": "年。是的。我"}, {"type": "subtitle", "time": 3382.95, "timestamp": "00:56:22", "text": "也。是的。是的。是的。是的。我想要"}, {"type": "subtitle", "time": 3384.47, "timestamp": "00:56:24", "text": "我的头发要长长了。我目前正在尝试"}, {"type": "subtitle", "time": 3386.71, "timestamp": "00:56:26", "text": "把头发留短。"}, {"type": "subtitle", "time": 3389.829, "timestamp": "00:56:29", "text": "目前，它看起来……呃，字面意义上的……"}, {"type": "subtitle", "time": 3391.95, "timestamp": "00:56:31", "text": "目前有点"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "少量。看起来会像个运动型男模特。"}, {"type": "subtitle", "time": 3399.23, "timestamp": "00:56:39", "text": "几款运动型发型"}, {"type": "subtitle", "time": 3401.91, "timestamp": "00:56:41", "text": "几个月。就快完成了。我只需要"}, {"type": "subtitle", "time": 3417.23, "timestamp": "00:56:57", "text": "嗯，呃，前排乐队。"}]
[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "这大概是我最后一次看直播了。"}, {"type": "subtitle", "time": 9962.269, "timestamp": "02:46:02", "text": "需要注意的"}, {"type": "subtitle", "time": 9965.55, "timestamp": "02:46:05", "text": "尽管。希望你"}, {"type": "subtitle", "time": 9983.19, "timestamp": "02:46:23", "text": "跳。跳。你跳过去。你跳"}, {"type": "subtitle", "time": 9986.269, "timestamp": "02:46:26", "text": "那里。跳下去。去"}, {"type": "subtitle", "time": 9991.91, "timestamp": "02:46:31", "text": "向上。跳。啊。失败。好的。你跳了起来。"}, {"type": "subtitle", "time": 9995.99, "timestamp": "02:46:35", "text": "跳。慢的。跳。长的。短的。跳。"}, {"type": "subtitle", "time": 9999.71, "timestamp": "02:46:39", "text": "失败。好的。蹿。慢的"}, {"type": "subtitle", "time": 10004.309, "timestamp": "02:46:44", "text": "跳。跳。是的。啊。我一直在做"}, {"type": "subtitle", "time": 10006.429, "timestamp": "02:46:46", "text": "制作"}, {"type": "subtitle", "time": 10013.269, "timestamp": "02:46:53", "text": "向下。如果我进行耐力测试呢？"}, {"type": "subtitle", "time": 10014.19, "timestamp": "02:46:54", "text": "月"}, {"type": "subtitle", "time": 10016.83, "timestamp": "02:46:56", "text": "今天？我会"}]
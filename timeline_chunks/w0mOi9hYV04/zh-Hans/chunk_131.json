[{"type": "subtitle", "time": 7861.27, "timestamp": "02:11:01", "text": "呃，接下来是妈妈，然后是奶奶，最后是爸爸。"}, {"type": "subtitle", "time": 7876.51, "timestamp": "02:11:16", "text": "是啊，我就像"}, {"type": "subtitle", "time": 7879.109, "timestamp": "02:11:19", "text": "现在。对，没错。嗯，差不多。"}, {"type": "subtitle", "time": 7881.43, "timestamp": "02:11:21", "text": "类似那样。我想看看我的"}, {"type": "subtitle", "time": 7890.55, "timestamp": "02:11:30", "text": "嗯，是的，事情就是这样。为什么是"}, {"type": "subtitle", "time": 7897.189, "timestamp": "02:11:37", "text": "卡住？但是，是的，那就是……"}, {"type": "subtitle", "time": 7899.91, "timestamp": "02:11:39", "text": "主要原因就是我一直……"}, {"type": "subtitle", "time": 7902.149, "timestamp": "02:11:42", "text": "往返于……但如今，我"}, {"type": "subtitle", "time": 7903.629, "timestamp": "02:11:43", "text": "不需要二手的"}, {"type": "subtitle", "time": 7908.31, "timestamp": "02:11:48", "text": "公共汽车。呃，我可以骑车回家。是的，"}, {"type": "subtitle", "time": 7911.43, "timestamp": "02:11:51", "text": "骑车很好。我会习惯骑车的。"}, {"type": "subtitle", "time": 7913.83, "timestamp": "02:11:53", "text": "高速公路。就好像它不是一辆自行车一样。它是"}, {"type": "subtitle", "time": 7915.669, "timestamp": "02:11:55", "text": "更像是一辆踏板车。等等，这是什么？"}, {"type": "subtitle", "time": 7918.629, "timestamp": "02:11:58", "text": "escoda 和 versus 之间的区别"}]
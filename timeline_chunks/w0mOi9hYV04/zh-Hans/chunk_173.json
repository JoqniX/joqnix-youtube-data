[{"type": "subtitle", "time": 10384.389, "timestamp": "02:53:04", "text": "去。我想做点什么，呃，作为……"}, {"type": "subtitle", "time": 10388.19, "timestamp": "02:53:08", "text": "你可以通过聊天命令来表达你的想法。"}, {"type": "subtitle", "time": 10393.59, "timestamp": "02:53:13", "text": "用户名。等等，你不能更改"}, {"type": "subtitle", "time": 10395.99, "timestamp": "02:53:15", "text": "升空后的方向。不。呃，你"}, {"type": "subtitle", "time": 10397.55, "timestamp": "02:53:17", "text": "不能"}, {"type": "subtitle", "time": 10401.429, "timestamp": "02:53:21", "text": "令人遗憾。不让我这么做。他们正是如此"}, {"type": "subtitle", "time": 10403.79, "timestamp": "02:53:23", "text": "计算"}, {"type": "subtitle", "time": 10407.03, "timestamp": "02:53:27", "text": "它。按住的时间长短也很重要。"}, {"type": "subtitle", "time": 10408.59, "timestamp": "02:53:28", "text": "空间"}, {"type": "subtitle", "time": 10412.349, "timestamp": "02:53:32", "text": "单杠、短跳或长跳"}, {"type": "subtitle", "time": 10416.71, "timestamp": "02:53:36", "text": "跳。诸如此类的事情。这就像如果我"}, {"type": "subtitle", "time": 10419.51, "timestamp": "02:53:39", "text": "快速点击速度呃空格，就像这样"}, {"type": "subtitle", "time": 10422.23, "timestamp": "02:53:42", "text": "这。如果我按住1秒钟并这样做"}, {"type": "subtitle", "time": 10426.269, "timestamp": "02:53:46", "text": "长篇 2 将如下所示。你"}, {"type": "subtitle", "time": 10430.87, "timestamp": "02:53:50", "text": "你看，我必须这样把握时机。头"}, {"type": "subtitle", "time": 10433.59, "timestamp": "02:53:53", "text": "就是这样。是的，我想做……我"}, {"type": "subtitle", "time": 10436.95, "timestamp": "02:53:56", "text": "意思是版主可以这么做，但是呃……"}]
[{"type": "subtitle", "time": 7082.31, "timestamp": "01:58:02", "text": "少量。看起来会像个运动型男模特。"}, {"type": "subtitle", "time": 7085.07, "timestamp": "01:58:05", "text": "几款运动型发型"}, {"type": "subtitle", "time": 7087.83, "timestamp": "01:58:07", "text": "几个月。就快完成了。我只需要"}, {"type": "subtitle", "time": 7089.91, "timestamp": "01:58:09", "text": "留长我的刘海。喜欢"}, {"type": "subtitle", "time": 7103.149, "timestamp": "01:58:23", "text": "嗯，前面的乐队。"}, {"type": "subtitle", "time": 7106.31, "timestamp": "01:58:26", "text": "是的。呃，兄弟说的是反向"}, {"type": "subtitle", "time": 7115.109, "timestamp": "01:58:35", "text": "令人惊讶的是，这种冲突竟然如此强烈。哪一个？等等，是"}, {"type": "subtitle", "time": 7116.87, "timestamp": "01:58:36", "text": "你是女生吗？你要找女朋友吗？"}, {"type": "subtitle", "time": 7119.03, "timestamp": "01:58:39", "text": "模型？别开玩笑了。骑师"}, {"type": "subtitle", "time": 7120.83, "timestamp": "01:58:40", "text": "是"}, {"type": "subtitle", "time": 7124.149, "timestamp": "01:58:44", "text": "美好的。我想象着骑师的私人教练"}, {"type": "subtitle", "time": 7129.109, "timestamp": "01:58:49", "text": "骑师亲自担任补丁包"}, {"type": "subtitle", "time": 7132.99, "timestamp": "01:58:52", "text": "拆卸攻击直升机。是什么"}, {"type": "subtitle", "time": 7135.39, "timestamp": "01:58:55", "text": "那？是什么"}, {"type": "subtitle", "time": 7138.629, "timestamp": "01:58:58", "text": "那？哦。呃，如果你想知道我为什么……"}]
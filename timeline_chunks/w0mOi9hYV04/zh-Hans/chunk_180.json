[{"type": "subtitle", "time": 10804.15, "timestamp": "03:00:04", "text": "我为这个角色感到难过。每当"}, {"type": "subtitle", "time": 10808.07, "timestamp": "03:00:08", "text": "他跳起来，然后好像摔倒了，他好像"}, {"type": "subtitle", "time": 10810.11, "timestamp": "03:00:10", "text": "击中"}, {"type": "subtitle", "time": 10815.469, "timestamp": "03:00:15", "text": "嗯，他打人就像他打人一样"}, {"type": "subtitle", "time": 10820.429, "timestamp": "03:00:20", "text": "脸朝下摔倒在地。不要感觉"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "强的？这个角色哪里强大了？"}, {"type": "subtitle", "time": 10833.03, "timestamp": "03:00:33", "text": "决心满足"}, {"type": "subtitle", "time": 10845.51, "timestamp": "03:00:45", "text": "是，以及精神上如何，不，嗯，精神上"}, {"type": "subtitle", "time": 10847.59, "timestamp": "03:00:47", "text": "强壮且体格健壮。这就是原因"}, {"type": "subtitle", "time": 10855.55, "timestamp": "03:00:55", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6484.07, "timestamp": "01:48:04", "text": "交换机会向你发送 1 千兆字节"}, {"type": "subtitle", "time": 6488.51, "timestamp": "01:48:08", "text": "千兆字节，我指的是1GB或1000MP，绿色的"}, {"type": "subtitle", "time": 6492.87, "timestamp": "01:48:12", "text": "轻量级稳定的互联网连接速度"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "两台电脑都需要运行它才能运行它。"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "呃，用 OBS 会占用大约 50% 的时间，因为它"}, {"type": "subtitle", "time": 6502.47, "timestamp": "01:48:22", "text": "需要对两者进行编码和记录"}, {"type": "subtitle", "time": 6507.35, "timestamp": "01:48:27", "text": "平台 YouTube 和 Twitch，这算一个和两个。"}, {"type": "subtitle", "time": 6509.109, "timestamp": "01:48:29", "text": "呃，YouTube 工作室视频需要一点时间。"}, {"type": "subtitle", "time": 6511.03, "timestamp": "01:48:31", "text": "因为我要迁移 YouTube 工作室"}, {"type": "subtitle", "time": 6516.149, "timestamp": "01:48:36", "text": "数据传输到我的流媒体电脑，然后……"}, {"type": "subtitle", "time": 6519.27, "timestamp": "01:48:39", "text": "数据正在传输到 OBS。然后是 OBS"}, {"type": "subtitle", "time": 6523.95, "timestamp": "01:48:43", "text": "必须盖过那个声音。所以NDI需要"}, {"type": "subtitle", "time": 6527.75, "timestamp": "01:48:47", "text": "嗯……多少钱？"}, {"type": "subtitle", "time": 6533.189, "timestamp": "01:48:53", "text": "呃，是针对 1080p 60fps 的吗？不，是 1080p 60 帧。"}, {"type": "subtitle", "time": 6535.83, "timestamp": "01:48:55", "text": "等等，白纸在哪儿？"}, {"type": "subtitle", "time": 6536.95, "timestamp": "01:48:56", "text": "再次？"}]
[{"type": "subtitle", "time": 16980.31, "timestamp": "04:43:00", "text": "我情绪崩溃，哭了，加入了……"}, {"type": "subtitle", "time": 16982.788, "timestamp": "04:43:02", "text": "和几个朋友一起视频通话。我告诉了他们"}, {"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "他们就此事质问了合作方。"}, {"type": "subtitle", "time": 16989.59, "timestamp": "04:43:09", "text": "客人，你为什么不喜欢谈话？"}, {"type": "subtitle", "time": 16992.39, "timestamp": "04:43:12", "text": "如果你发现乔克……，请保护他。"}, {"type": "subtitle", "time": 16995.868, "timestamp": "04:43:15", "text": "舒适不舒服"}, {"type": "subtitle", "time": 16999.59, "timestamp": "04:43:19", "text": "东西。呃，那次发生的事很糟糕。"}, {"type": "subtitle", "time": 17001.43, "timestamp": "04:43:21", "text": "好的。所以我从中学到了很多。"}, {"type": "subtitle", "time": 17004.43, "timestamp": "04:43:24", "text": "经验。所以"}, {"type": "subtitle", "time": 17008.31, "timestamp": "04:43:28", "text": "我的建议是保持开放的心态。"}, {"type": "subtitle", "time": 17010.788, "timestamp": "04:43:30", "text": "关于这件事，因为如果它有影响的话。"}, {"type": "subtitle", "time": 17013.11, "timestamp": "04:43:33", "text": "你完全有权利"}, {"type": "subtitle", "time": 17015.51, "timestamp": "04:43:35", "text": "向你的听众传达你的感受"}, {"type": "subtitle", "time": 17017.83, "timestamp": "04:43:37", "text": "让他们知道，是的，这不是我"}, {"type": "subtitle", "time": 17021.59, "timestamp": "04:43:41", "text": "我不喜欢这样，我不喜欢这样，而且我"}, {"type": "subtitle", "time": 17024.23, "timestamp": "04:43:44", "text": "我不想要这种呃，专业人士，嗯……"}, {"type": "subtitle", "time": 17027.15, "timestamp": "04:43:47", "text": "不想这样"}, {"type": "subtitle", "time": 17031.67, "timestamp": "04:43:51", "text": "嗯……该怎么说来着……呃……表演……不……呃……"}, {"type": "subtitle", "time": 17035.35, "timestamp": "04:43:55", "text": "这种行为应该被执行。"}, {"type": "chat", "time": 17035.784, "timestamp": "04:43:55", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "You are amazing and inspiring "}, {"type": "subtitle", "time": 17039.27, "timestamp": "04:43:59", "text": "东西。关键是不要总是"}]
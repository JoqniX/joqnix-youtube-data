[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "琼，欢迎来到直播间。你好。"}, {"type": "subtitle", "time": 1021.28, "timestamp": "00:17:01", "text": "欢迎。"}, {"type": "subtitle", "time": 1022.59, "timestamp": "00:17:02", "text": "[音乐]"}, {"type": "subtitle", "time": 1026.23, "timestamp": "00:17:06", "text": "欢迎。是的。我们会让它运转起来的。"}, {"type": "subtitle", "time": 1034.63, "timestamp": "00:17:14", "text": "是的。这就是我有点恼火的原因。"}, {"type": "subtitle", "time": 1035.47, "timestamp": "00:17:15", "text": "经过"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "我的道德追踪。所以，我"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "我觉得我需要换成……嗯，我觉得我"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "实际上需要切换到类似……的"}, {"type": "subtitle", "time": 1047.909, "timestamp": "00:17:27", "text": "你再打一次电话吗？它叫什么名字"}, {"type": "chat", "time": 1048.877, "timestamp": "00:17:28", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "yo yo yo Jokie bantai"}, {"type": "subtitle", "time": 1052.35, "timestamp": "00:17:32", "text": "再次？呃，网络摄像头"}, {"type": "subtitle", "time": 1054.87, "timestamp": "00:17:34", "text": "货运。我不知道。是的，有很多。"}, {"type": "subtitle", "time": 1056.71, "timestamp": "00:17:36", "text": "发生了很多事。我不能透露。"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "但最终你们会知道的。"}, {"type": "subtitle", "time": 1060.99, "timestamp": "00:17:40", "text": "所以，"}, {"type": "subtitle", "time": 1063.75, "timestamp": "00:17:43", "text": "是的，我很兴奋。我希望一切"}, {"type": "subtitle", "time": 1066.71, "timestamp": "00:17:46", "text": "一切顺利。目前一切进展顺利。"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "计划。我梦想成真了"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "没错，梦想成真了。"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "播放量惊人"}, {"type": "subtitle", "time": 1077.87, "timestamp": "00:17:57", "text": "嗯，是的，我是"}]
[{"type": "subtitle", "time": 841.949, "timestamp": "00:14:01", "text": "我主要是不太熟悉"}, {"type": "subtitle", "time": 845.829, "timestamp": "00:14:05", "text": "呃，除了iPhone之外的苹果产品。"}, {"type": "subtitle", "time": 848.55, "timestamp": "00:14:08", "text": "这是我唯一知道的。对，是iPhone。"}, {"type": "subtitle", "time": 850.389, "timestamp": "00:14:10", "text": "然后"}, {"type": "subtitle", "time": 853.949, "timestamp": "00:14:13", "text": "呃，那事情对吧？"}, {"type": "subtitle", "time": 857.269, "timestamp": "00:14:17", "text": "嗯，最近发布的"}, {"type": "subtitle", "time": 859.47, "timestamp": "00:14:19", "text": "Vision Pro Max 或"}, {"type": "subtitle", "time": 862.389, "timestamp": "00:14:22", "text": "某种视觉增强之类的东西"}, {"type": "subtitle", "time": 865.269, "timestamp": "00:14:25", "text": "这叫做。对，就是那个。是的。"}, {"type": "subtitle", "time": 867.509, "timestamp": "00:14:27", "text": "昂贵的。是的，我得直播了。"}, {"type": "subtitle", "time": 869.43, "timestamp": "00:14:29", "text": "在不同的平台上。不，不，不。它是"}, {"type": "subtitle", "time": 872.99, "timestamp": "00:14:32", "text": "因为我基本上是想"}, {"type": "subtitle", "time": 874.59, "timestamp": "00:14:34", "text": "溪流。"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "嗯，我基本上是想直播一些东西，但是"}, {"type": "subtitle", "time": 884.47, "timestamp": "00:14:44", "text": "我感觉自己现在有点像他那样"}, {"type": "subtitle", "time": 888.11, "timestamp": "00:14:48", "text": "这里那里。我想知道"}, {"type": "subtitle", "time": 891.47, "timestamp": "00:14:51", "text": "[音乐]"}, {"type": "subtitle", "time": 893.79, "timestamp": "00:14:53", "text": "为什么是"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "很糟糕，确实很糟糕。没关系。我会我会"}, {"type": "subtitle", "time": 899.75, "timestamp": "00:14:59", "text": "习惯就好。更像是……呃……什么？"}]
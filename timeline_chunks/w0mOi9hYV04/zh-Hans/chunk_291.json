[{"type": "subtitle", "time": 17462.39, "timestamp": "04:51:02", "text": "等等，我们举一个例子……"}, {"type": "subtitle", "time": 17466.31, "timestamp": "04:51:06", "text": "所以我们说我认为呃，准社会主义"}, {"type": "subtitle", "time": 17470.19, "timestamp": "04:51:10", "text": "也可能深入得太深，太奇怪了。"}, {"type": "subtitle", "time": 17472.35, "timestamp": "04:51:12", "text": "爬行"}, {"type": "subtitle", "time": 17475.868, "timestamp": "04:51:15", "text": "是的，它可以去哪里"}, {"type": "subtitle", "time": 17478.39, "timestamp": "04:51:18", "text": "大脑，但你又得设置"}, {"type": "subtitle", "time": 17480.59, "timestamp": "04:51:20", "text": "虽然有边界"}, {"type": "subtitle", "time": 17483.43, "timestamp": "04:51:23", "text": "记住，观众必须记住"}, {"type": "subtitle", "time": 17486.51, "timestamp": "04:51:26", "text": "即使他们实际上是"}, {"type": "subtitle", "time": 17489.31, "timestamp": "04:51:29", "text": "与主播沟通"}, {"type": "subtitle", "time": 17494.31, "timestamp": "04:51:34", "text": "这些东西真的是你的朋友吗？"}, {"type": "subtitle", "time": 17496.39, "timestamp": "04:51:36", "text": "就像YouTuber那样，好像真有这种东西似的。"}, {"type": "subtitle", "time": 17500.39, "timestamp": "04:51:40", "text": "对，嗯，就像主播永远不可能……"}, {"type": "subtitle", "time": 17503.67, "timestamp": "04:51:43", "text": "你的朋友对，因为就在你"}, {"type": "subtitle", "time": 17506.03, "timestamp": "04:51:46", "text": "让它们成为你的"}, {"type": "subtitle", "time": 17509.67, "timestamp": "04:51:49", "text": "朋友，还有这个关于……的话题"}, {"type": "subtitle", "time": 17511.948, "timestamp": "04:51:51", "text": "呃，等等。那个词是什么？"}, {"type": "subtitle", "time": 17514.47, "timestamp": "04:51:54", "text": "再次？天哪，我居然忘了这件事。呃，"}, {"type": "subtitle", "time": 17515.868, "timestamp": "04:51:55", "text": "那个词是什么？怎么说？"}, {"type": "subtitle", "time": 17517.708, "timestamp": "04:51:57", "text": "偏爱。"}]
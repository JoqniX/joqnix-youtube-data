[{"type": "subtitle", "time": 7022.47, "timestamp": "01:57:02", "text": "我的……呃……该怎么称呼它呢？胸部。"}, {"type": "subtitle", "time": 7025.109, "timestamp": "01:57:05", "text": "不，就像你知道他们是怎么说的那样。"}, {"type": "subtitle", "time": 7028.629, "timestamp": "01:57:08", "text": "呃，丽莎的发型，哪个动漫发型？"}, {"type": "subtitle", "time": 7030.95, "timestamp": "01:57:10", "text": "哪种发型是被诅咒的？"}, {"type": "subtitle", "time": 7032.95, "timestamp": "01:57:12", "text": "算是吧？丽莎那种类型"}, {"type": "subtitle", "time": 7035.99, "timestamp": "01:57:15", "text": "就像我总有一天想把它放进去一样。一"}, {"type": "subtitle", "time": 7038.79, "timestamp": "01:57:18", "text": "我有一天突然想到的一个想法"}, {"type": "subtitle", "time": 7042.189, "timestamp": "01:57:22", "text": "另一种运动能力的演变，呃，作为一种"}, {"type": "subtitle", "time": 7045.91, "timestamp": "01:57:25", "text": "星座。嗯，那些就像"}, {"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "在我脑海中的一些概念艺术作品中"}, {"type": "subtitle", "time": 7053.99, "timestamp": "01:57:33", "text": "很久以前我就有了这个设计。所以我就想"}, {"type": "subtitle", "time": 7056.149, "timestamp": "01:57:36", "text": "或许我可以用那些概念图。"}, {"type": "subtitle", "time": 7060.51, "timestamp": "01:57:40", "text": "不是？"}, {"type": "subtitle", "time": 7063.75, "timestamp": "01:57:43", "text": "呃，我只留了大概……"}, {"type": "subtitle", "time": 7066.03, "timestamp": "01:57:46", "text": "年。是的。我，"}, {"type": "subtitle", "time": 7068.55, "timestamp": "01:57:48", "text": "也。是的。是的。是的。是的。是的。我"}, {"type": "subtitle", "time": 7069.99, "timestamp": "01:57:49", "text": "我想留长头发。我目前"}, {"type": "subtitle", "time": 7072.229, "timestamp": "01:57:52", "text": "我正在努力把头发留短。"}, {"type": "subtitle", "time": 7075.27, "timestamp": "01:57:55", "text": "头发。目前，它呃，字面上就是呃，它"}, {"type": "subtitle", "time": 7077.79, "timestamp": "01:57:57", "text": "目前看起来有点……"}]
[{"type": "subtitle", "time": 10260.67, "timestamp": "02:51:00", "text": "依偎在我的毯子里吧。"}, {"type": "subtitle", "time": 10261.79, "timestamp": "02:51:01", "text": "[音乐]"}, {"type": "subtitle", "time": 10264.75, "timestamp": "02:51:04", "text": "你看，我爱"}, {"type": "subtitle", "time": 10267.75, "timestamp": "02:51:07", "text": "依偎着。你知道一个奇怪的事实吗？"}, {"type": "subtitle", "time": 10270.55, "timestamp": "02:51:10", "text": "关于我。我知道我很怪，但我很怪。"}, {"type": "subtitle", "time": 10272.269, "timestamp": "02:51:12", "text": "关于我的一件事"}, {"type": "subtitle", "time": 10275.23, "timestamp": "02:51:15", "text": "就是当我"}, {"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "睡觉的时候，我有时候会……呃，当我在……"}, {"type": "subtitle", "time": 10281.469, "timestamp": "02:51:21", "text": "好，嗯，开心"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "模式有点像喵喵石和行为"}, {"type": "subtitle", "time": 10286.91, "timestamp": "02:51:26", "text": "像猫一样"}, {"type": "subtitle", "time": 10288.83, "timestamp": "02:51:28", "text": "虽然"}, {"type": "subtitle", "time": 10292.11, "timestamp": "02:51:32", "text": "东西。其实是动漫"}, {"type": "subtitle", "time": 10294.91, "timestamp": "02:51:34", "text": "呃，哪个做了"}, {"type": "subtitle", "time": 10297.79, "timestamp": "02:51:37", "text": "呃，表达我的意思"}, {"type": "subtitle", "time": 10300.429, "timestamp": "02:51:40", "text": "做过。所以还有"}, {"type": "subtitle", "time": 10302.349, "timestamp": "02:51:42", "text": "礼物"}, {"type": "subtitle", "time": 10306.99, "timestamp": "02:51:46", "text": "它。我不知道我能否证明这一点。"}]
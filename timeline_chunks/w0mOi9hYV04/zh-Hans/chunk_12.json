[{"type": "subtitle", "time": 724.79, "timestamp": "00:12:04", "text": "[音乐]"}, {"type": "subtitle", "time": 727.59, "timestamp": "00:12:07", "text": "忍者说“pane”的时候我吓了一跳。为什么"}, {"type": "subtitle", "time": 729.949, "timestamp": "00:12:09", "text": "你收到了吗？"}, {"type": "subtitle", "time": 734.069, "timestamp": "00:12:14", "text": "害怕的？呃，那是因为我实际上还没有"}, {"type": "subtitle", "time": 736.79, "timestamp": "00:12:16", "text": "像那么多的印度奶酪（paneer paneer）"}, {"type": "subtitle", "time": 740.35, "timestamp": "00:12:20", "text": "某物。所以，那可能是……"}, {"type": "subtitle", "time": 743.55, "timestamp": "00:12:23", "text": "为什么。这或许就是原因。"}, {"type": "subtitle", "time": 757.269, "timestamp": "00:12:37", "text": "我的模型为什么卡住了？为什么是B工作室"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "从手机到这里？为什么选择Wi-Fi"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "不可能吗？你知道，我不能使用"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "因为我需要用USB连接iPhone"}, {"type": "subtitle", "time": 772.389, "timestamp": "00:12:52", "text": "很遗憾，只能用USB接口了。是的，Wi-Fi"}, {"type": "subtitle", "time": 774.99, "timestamp": "00:12:54", "text": "方法就是痛苦。怎么会"}]
[{"type": "subtitle", "time": 18182.23, "timestamp": "05:03:02", "text": "只要有时间她就会直播，大家"}, {"type": "subtitle", "time": 18184.628, "timestamp": "05:03:04", "text": "还记得她，会过来打招呼"}, {"type": "subtitle", "time": 18187.31, "timestamp": "05:03:07", "text": "你好，然后和她说话。"}, {"type": "subtitle", "time": 18191.03, "timestamp": "05:03:11", "text": "因为他们现在喜欢她，因为……"}, {"type": "subtitle", "time": 18192.628, "timestamp": "05:03:12", "text": "误解，一切都明了了。"}, {"type": "subtitle", "time": 18193.99, "timestamp": "05:03:13", "text": "以及所有的一切。她传达了这一点。"}, {"type": "subtitle", "time": 18196.59, "timestamp": "05:03:16", "text": "适当地。大家都明白了，"}, {"type": "subtitle", "time": 18199.11, "timestamp": "05:03:19", "text": "一切都被我视为挑战"}, {"type": "subtitle", "time": 18201.83, "timestamp": "05:03:21", "text": "努力工作。我想我直播了24小时。"}, {"type": "subtitle", "time": 18205.83, "timestamp": "05:03:25", "text": "那天我好几个小时没吃饭，因为当我"}, {"type": "subtitle", "time": 18209.91, "timestamp": "05:03:29", "text": "那次首播的直播……"}, {"type": "subtitle", "time": 18212.31, "timestamp": "05:03:32", "text": "我珍视的一位YouTube博主朋友。"}, {"type": "subtitle", "time": 18216.628, "timestamp": "05:03:36", "text": "还有爱，嗯，这激励我去工作。"}, {"type": "subtitle", "time": 18219.59, "timestamp": "05:03:39", "text": "很难，对吧？她得到了巨大的成功，因为她"}, {"type": "subtitle", "time": 18222.43, "timestamp": "05:03:42", "text": "她罪有应得。她努力工作才获得"}, {"type": "chat", "time": 18225.236, "timestamp": "05:03:45", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Omg why would you do that to yourself that’s a lottt"}, {"type": "subtitle", "time": 18226.07, "timestamp": "05:03:46", "text": "那就是她所在的地方。她工作"}, {"type": "subtitle", "time": 18228.868, "timestamp": "05:03:48", "text": "很难，真的很难，而且我也想"}, {"type": "subtitle", "time": 18231.51, "timestamp": "05:03:51", "text": "我尽力而为，然后就开始工作了。"}, {"type": "subtitle", "time": 18234.23, "timestamp": "05:03:54", "text": "也很难。我相信它启发了我"}, {"type": "subtitle", "time": 18237.75, "timestamp": "05:03:57", "text": "其他创作者，你和其他 YouTuber"}]
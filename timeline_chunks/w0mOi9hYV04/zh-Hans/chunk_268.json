[{"type": "subtitle", "time": 16081.03, "timestamp": "04:28:01", "text": "在 Discord 上进行的一次对话，安排"}, {"type": "subtitle", "time": 16082.03, "timestamp": "04:28:02", "text": "合作"}, {"type": "subtitle", "time": 16086.63, "timestamp": "04:28:06", "text": "东西。嗯，所以我得想想……"}, {"type": "subtitle", "time": 16089.189, "timestamp": "04:28:09", "text": "所以韩国时间等于日本时间"}, {"type": "subtitle", "time": 16091.189, "timestamp": "04:28:11", "text": "时间。所以"}, {"type": "subtitle", "time": 16092.75, "timestamp": "04:28:12", "text": "呃"}, {"type": "subtitle", "time": 16098.11, "timestamp": "04:28:18", "text": "所以，呃，8:30 8 呃"}, {"type": "subtitle", "time": 16106.189, "timestamp": "04:28:26", "text": "格林尼治标准时间 8:30，韩国标准时间下午 5:00。所以是5微米"}, {"type": "subtitle", "time": 16107.71, "timestamp": "04:28:27", "text": "6."}, {"type": "subtitle", "time": 16111.189, "timestamp": "04:28:31", "text": "嗯，如果是工人的话，你就得……"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "晚上8:30到家，很累。如果是我，"}, {"type": "subtitle", "time": 16118.63, "timestamp": "04:28:38", "text": "我会休息放松一个小时。"}, {"type": "subtitle", "time": 16119.78, "timestamp": "04:28:39", "text": "以及所有的一切。和"}, {"type": "subtitle", "time": 16120.99, "timestamp": "04:28:40", "text": "[音乐]"}, {"type": "subtitle", "time": 16123.99, "timestamp": "04:28:43", "text": "到那时我就可以吃晚饭了。"}, {"type": "subtitle", "time": 16125.95, "timestamp": "04:28:45", "text": "一切都对吧？"}, {"type": "subtitle", "time": 16129.51, "timestamp": "04:28:49", "text": "而且我还能"}, {"type": "subtitle", "time": 16131.75, "timestamp": "04:28:51", "text": "呃，希望电话里能联系上我。"}, {"type": "subtitle", "time": 16135.75, "timestamp": "04:28:55", "text": "很放松，对吧？但那是我。但是等等。"}]
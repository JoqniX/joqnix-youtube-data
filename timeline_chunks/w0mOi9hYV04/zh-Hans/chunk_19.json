[{"type": "subtitle", "time": 1141.83, "timestamp": "00:19:01", "text": "呃，意思是，呃，他们当然会是"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "就像其他形式一样，但是呃，我"}, {"type": "subtitle", "time": 1148.31, "timestamp": "00:19:08", "text": "以前这样做过，有些人也跟着做了。"}, {"type": "subtitle", "time": 1153.669, "timestamp": "00:19:13", "text": "我在一些Twitch之类的平台上获得了一些白金奖杯"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "呃，尤其是那些YouTube频道。"}, {"type": "subtitle", "time": 1159.83, "timestamp": "00:19:19", "text": "技术方面的东西，对吧？呃，我们不会……"}, {"type": "subtitle", "time": 1163.35, "timestamp": "00:19:23", "text": "莫伊什现在还能那样做吗？呃……"}, {"type": "subtitle", "time": 1166.95, "timestamp": "00:19:26", "text": "因为我觉得，嗯，我觉得它会"}, {"type": "subtitle", "time": 1170.23, "timestamp": "00:19:30", "text": "太枯燥、太技术化，但在"}, {"type": "subtitle", "time": 1174.23, "timestamp": "00:19:34", "text": "我可以把未来带回来"}, {"type": "subtitle", "time": 1176.47, "timestamp": "00:19:36", "text": "呃，短片或教育内容"}, {"type": "subtitle", "time": 1179.99, "timestamp": "00:19:39", "text": "它。嗯，或许我们可以这样做"}, {"type": "subtitle", "time": 1181.63, "timestamp": "00:19:41", "text": "那。为什么"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "不是？我们可以那样做。为什么不呢？"}, {"type": "subtitle", "time": 1186.27, "timestamp": "00:19:46", "text": "是的。是的。"}, {"type": "subtitle", "time": 1191.19, "timestamp": "00:19:51", "text": "是的。你好，Hyen。欢迎。我呃，运动员"}, {"type": "subtitle", "time": 1193.23, "timestamp": "00:19:53", "text": "偶然发现"}, {"type": "subtitle", "time": 1196.51, "timestamp": "00:19:56", "text": "250 美元，更多"}, {"type": "subtitle", "time": 1198.27, "timestamp": "00:19:58", "text": "音乐。"}, {"type": "subtitle", "time": 1199.95, "timestamp": "00:19:59", "text": "什么？"}]
[{"type": "subtitle", "time": 1085.75, "timestamp": "00:18:05", "text": "希望你一切顺利，耶耶"}, {"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "我也是，我也很担心。"}, {"type": "subtitle", "time": 1093.39, "timestamp": "00:18:13", "text": "呃，数以百万计的事情"}, {"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "一切都将如何发展，每个人"}, {"type": "subtitle", "time": 1099.51, "timestamp": "00:18:19", "text": "会有人拿走它，我会怎么样？"}, {"type": "subtitle", "time": 1103.43, "timestamp": "00:18:23", "text": "亲自接受并能够"}, {"type": "subtitle", "time": 1113.39, "timestamp": "00:18:33", "text": "东西。所以"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "很多，但是，嗯，一切都会顺利的。"}, {"type": "subtitle", "time": 1118.83, "timestamp": "00:18:38", "text": "我确信"}, {"type": "subtitle", "time": 1121.47, "timestamp": "00:18:41", "text": "它。是的。"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "嗯，是的，会有一些内容。"}, {"type": "subtitle", "time": 1127.909, "timestamp": "00:18:47", "text": "这里那里正在发生一些变化。呃"}, {"type": "subtitle", "time": 1130.07, "timestamp": "00:18:50", "text": "内容将会发生变化"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "这里那里。呃呃规格呃"}, {"type": "subtitle", "time": 1135.669, "timestamp": "00:18:55", "text": "具体来说，正如我提到的。"}, {"type": "subtitle", "time": 1139.83, "timestamp": "00:18:59", "text": "工作流程将不再存在。"}]
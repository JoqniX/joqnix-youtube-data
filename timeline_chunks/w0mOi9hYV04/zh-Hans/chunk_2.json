[{"type": "subtitle", "time": 126.35, "timestamp": "00:02:06", "text": "那里。所以，"}, {"type": "subtitle", "time": 128.51, "timestamp": "00:02:08", "text": "今天"}, {"type": "subtitle", "time": 135.47, "timestamp": "00:02:15", "text": "短的。你好啊，忍者。你好呀。"}, {"type": "subtitle", "time": 138.869, "timestamp": "00:02:18", "text": "欢迎。欢迎。欢迎。希望你已经"}, {"type": "subtitle", "time": 143.47, "timestamp": "00:02:23", "text": "一切都很好。你好"}, {"type": "subtitle", "time": 147.43, "timestamp": "00:02:27", "text": "我更喜欢大家。唉，我感觉"}, {"type": "subtitle", "time": 149.91, "timestamp": "00:02:29", "text": "眼泪汪汪，真的，当我……"}, {"type": "subtitle", "time": 153.11, "timestamp": "00:02:33", "text": "和大家一样。我的天哪，我的"}, {"type": "subtitle", "time": 157.15, "timestamp": "00:02:37", "text": "我的眼睛就像"}, {"type": "subtitle", "time": 160.63, "timestamp": "00:02:40", "text": "出汗。搞什么鬼？什么？"}, {"type": "subtitle", "time": 162.35, "timestamp": "00:02:42", "text": "华夫饼，"}, {"type": "subtitle", "time": 166.55, "timestamp": "00:02:46", "text": "哥们儿？我的天啊。现在就去踢球。比利，什么"}, {"type": "subtitle", "time": 167.79, "timestamp": "00:02:47", "text": "你是说？"}, {"type": "subtitle", "time": 171.869, "timestamp": "00:02:51", "text": "不，我一直在努力"}, {"type": "subtitle", "time": 177.07, "timestamp": "00:02:57", "text": "呃，我一直在努力管理。"}, {"type": "subtitle", "time": 179.869, "timestamp": "00:02:59", "text": "两个都。"}]
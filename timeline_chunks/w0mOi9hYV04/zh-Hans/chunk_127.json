[{"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "好的。我本来要说什么来着？为什么是"}, {"type": "subtitle", "time": 7640.589, "timestamp": "02:07:20", "text": "就这么简单？德里"}, {"type": "subtitle", "time": 7643.51, "timestamp": "02:07:23", "text": "ComicCon 符合上述背景。"}, {"type": "subtitle", "time": 7646.43, "timestamp": "02:07:26", "text": "好的。语境。我说的是这个。"}, {"type": "subtitle", "time": 7649.99, "timestamp": "02:07:29", "text": "动漫展。让他喘口气。是的。我需要"}, {"type": "subtitle", "time": 7657.27, "timestamp": "02:07:37", "text": "气息。哎，已经过去好久了。我"}, {"type": "subtitle", "time": 7659.43, "timestamp": "02:07:39", "text": "做到了。所以，我今天过得很愉快。我是"}, {"type": "subtitle", "time": 7662.069, "timestamp": "02:07:42", "text": "快乐的。希望你们都放松心情。"}, {"type": "subtitle", "time": 7675.589, "timestamp": "02:07:55", "text": "男生。哦，是的。嗯，我刚才说到哪儿了？哪里"}, {"type": "subtitle", "time": 7678.95, "timestamp": "02:07:58", "text": "我？我刚才说到哪儿了？我刚才说到哪儿了？ 100 等于多少？"}]
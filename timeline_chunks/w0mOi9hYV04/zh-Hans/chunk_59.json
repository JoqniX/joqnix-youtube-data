[{"type": "subtitle", "time": 3541.63, "timestamp": "00:59:01", "text": "非常"}, {"type": "subtitle", "time": 3544.63, "timestamp": "00:59:04", "text": "嗨，鼻子。嗯，在印度，什么样的"}, {"type": "subtitle", "time": 3547.03, "timestamp": "00:59:07", "text": "你用的是什么写手？就像会一样"}, {"type": "subtitle", "time": 3550.309, "timestamp": "00:59:10", "text": "因为我身处另一个地方，所以穿着呃……"}, {"type": "subtitle", "time": 3552.549, "timestamp": "00:59:12", "text": "呃，地方。呃，这就像一个本地"}, {"type": "subtitle", "time": 3553.63, "timestamp": "00:59:13", "text": "品牌。"}, {"type": "subtitle", "time": 3557.589, "timestamp": "00:59:17", "text": "呃，它叫科技未来之类的。"}, {"type": "subtitle", "time": 3561.75, "timestamp": "00:59:21", "text": "路由器，但是回到家，呃，我有一个"}, {"type": "subtitle", "time": 3565.829, "timestamp": "00:59:25", "text": "去路由器？嗯，大概吧，我会像这样"}, {"type": "subtitle", "time": 3568.069, "timestamp": "00:59:28", "text": "我将不再搬家或接收"}, {"type": "subtitle", "time": 3570.99, "timestamp": "00:59:30", "text": "很快转变"}, {"type": "subtitle", "time": 3576.03, "timestamp": "00:59:36", "text": "呃呃，又回家了之类的"}, {"type": "subtitle", "time": 3580.95, "timestamp": "00:59:40", "text": "嗯，所以，嗯，我呃，达成了一项交易或一项"}, {"type": "subtitle", "time": 3583.47, "timestamp": "00:59:43", "text": "结论是："}, {"type": "subtitle", "time": 3586.63, "timestamp": "00:59:46", "text": "我想要单独的空间，因为我"}, {"type": "subtitle", "time": 3588.829, "timestamp": "00:59:48", "text": "我想要我的自由和独立。"}, {"type": "subtitle", "time": 3592.789, "timestamp": "00:59:52", "text": "思考。所以，嗯，他们大概会……"}, {"type": "subtitle", "time": 3597.51, "timestamp": "00:59:57", "text": "大约三月份开始这项工作。呃，因为我"}]
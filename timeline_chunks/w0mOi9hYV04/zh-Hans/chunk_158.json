[{"type": "subtitle", "time": 9480.389, "timestamp": "02:38:00", "text": "周四？对，星期四。我想我"}, {"type": "subtitle", "time": 9484.11, "timestamp": "02:38:04", "text": "我忘了我的大脑，我什么时候服用的"}, {"type": "subtitle", "time": 9487.389, "timestamp": "02:38:07", "text": "疫苗？他妈的。呃，"}, {"type": "subtitle", "time": 9490.79, "timestamp": "02:38:10", "text": "周四。那是在我发薪日直播之后。"}, {"type": "subtitle", "time": 9493.27, "timestamp": "02:38:13", "text": "Payday 与 Sakura State 合作"}, {"type": "subtitle", "time": 9497.389, "timestamp": "02:38:17", "text": "寿司。所以我觉得"}, {"type": "subtitle", "time": 9500.27, "timestamp": "02:38:20", "text": "等等。"}, {"type": "subtitle", "time": 9504.99, "timestamp": "02:38:24", "text": "啊，我不记得了。啊。"}, {"type": "subtitle", "time": 9507.51, "timestamp": "02:38:27", "text": "星期五。是的，昨天。等等，今天"}, {"type": "subtitle", "time": 9509.91, "timestamp": "02:38:29", "text": "周六？什么？等等，今天"}, {"type": "subtitle", "time": 9512.99, "timestamp": "02:38:32", "text": "周六？啊，"}, {"type": "subtitle", "time": 9516.07, "timestamp": "02:38:36", "text": "什么？我总是忘记，真是的。我的大脑"}, {"type": "subtitle", "time": 9519.67, "timestamp": "02:38:39", "text": "真是个傻瓜。还有，是的。"}, {"type": "subtitle", "time": 9522.389, "timestamp": "02:38:42", "text": "你好，Tizuki。是的，你好。是的，你好"}, {"type": "subtitle", "time": 9524.83, "timestamp": "02:38:44", "text": "萨桑和"}, {"type": "subtitle", "time": 9528.349, "timestamp": "02:38:48", "text": "雅希坎。我错过了什么？"}, {"type": "subtitle", "time": 9531.79, "timestamp": "02:38:51", "text": "有人吗？以及 Streambox 流元素"}, {"type": "subtitle", "time": 9534.27, "timestamp": "02:38:54", "text": "也。所以，你们怎么样？"}, {"type": "subtitle", "time": 9538.389, "timestamp": "02:38:58", "text": "正在做？哦，等等。呃，我想我"}]
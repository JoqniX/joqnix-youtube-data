[{"type": "subtitle", "time": 17281.47, "timestamp": "04:48:01", "text": "[音乐]"}, {"type": "subtitle", "time": 17286.91, "timestamp": "04:48:06", "text": "进来。我进来。是的，就像"}, {"type": "subtitle", "time": 17290.07, "timestamp": "04:48:10", "text": "又是你，你应该让我感觉像你"}, {"type": "subtitle", "time": 17292.788, "timestamp": "04:48:12", "text": "不过应该休息一下，而且只有一次。"}, {"type": "subtitle", "time": 17295.35, "timestamp": "04:48:15", "text": "你从休息地址回来"}, {"type": "subtitle", "time": 17296.35, "timestamp": "04:48:16", "text": "这"}, {"type": "subtitle", "time": 17299.07, "timestamp": "04:48:19", "text": "妥善解决这个问题"}, {"type": "subtitle", "time": 17301.868, "timestamp": "04:48:21", "text": "如果是流媒体，那就正确地在……上进行。"}, {"type": "subtitle", "time": 17305.75, "timestamp": "04:48:25", "text": "溪流。你不必招待客人"}, {"type": "subtitle", "time": 17309.75, "timestamp": "04:48:29", "text": "呃，直播这么多小时，1小时或"}, {"type": "subtitle", "time": 17312.47, "timestamp": "04:48:32", "text": "所以。那么，我们就开始吧，随便什么都行。"}, {"type": "subtitle", "time": 17315.27, "timestamp": "04:48:35", "text": "你想让我提及并谈论地址"}, {"type": "subtitle", "time": 17318.39, "timestamp": "04:48:38", "text": "正确处理。好的。"}, {"type": "subtitle", "time": 17320.628, "timestamp": "04:48:40", "text": "让我认真对待这件事。"}, {"type": "subtitle", "time": 17323.83, "timestamp": "04:48:43", "text": "梦境或者其他什么，你会想：嗯……"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "如果你身处那种感觉，就像你"}, {"type": "subtitle", "time": 17328.948, "timestamp": "04:48:48", "text": "现在感到失望了吗？"}, {"type": "subtitle", "time": 17330.51, "timestamp": "04:48:50", "text": "就像描绘你的"}, {"type": "subtitle", "time": 17333.19, "timestamp": "04:48:53", "text": "失望，以便其他人可以"}, {"type": "subtitle", "time": 17335.55, "timestamp": "04:48:55", "text": "明白这一点"}, {"type": "subtitle", "time": 17339.27, "timestamp": "04:48:59", "text": "是的，他们应该感到难过。"}]
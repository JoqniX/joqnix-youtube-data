[{"type": "subtitle", "time": 4384.229, "timestamp": "01:13:04", "text": "类似蓝色混搭的材质"}, {"type": "subtitle", "time": 4388.87, "timestamp": "01:13:08", "text": "绿色的。我不知道。是的。"}, {"type": "subtitle", "time": 4391.91, "timestamp": "01:13:11", "text": "总之，呃，就是这样。来吧"}, {"type": "subtitle", "time": 4393.189, "timestamp": "01:13:13", "text": "酷炫又忍者范儿。你必须战斗"}, {"type": "subtitle", "time": 4413.39, "timestamp": "01:13:33", "text": "是的，拿"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "关心。祝你一切顺利。好的，"}, {"type": "subtitle", "time": 4417.229, "timestamp": "01:13:37", "text": "感谢您的调音"}, {"type": "subtitle", "time": 4420.709, "timestamp": "01:13:40", "text": "希望你能赶上进度，抓住机会。"}, {"type": "subtitle", "time": 4423.51, "timestamp": "01:13:43", "text": "我就是下一任。小心。玩得开心"}, {"type": "subtitle", "time": 4425.59, "timestamp": "01:13:45", "text": "祝你相信自己能成功"}, {"type": "subtitle", "time": 4427.669, "timestamp": "01:13:47", "text": "参加考试。与考试的斗争"}, {"type": "subtitle", "time": 4432.669, "timestamp": "01:13:52", "text": "东西。运气。发生了什么事？"}, {"type": "subtitle", "time": 4435.07, "timestamp": "01:13:55", "text": "翻译？至少是这样。"}]
[{"type": "subtitle", "time": 8822.309, "timestamp": "02:27:02", "text": "如果我接受这种现状，那就是爱"}, {"type": "subtitle", "time": 8825.51, "timestamp": "02:27:05", "text": "上下文会像 YouTube 一样，可信度很高。"}, {"type": "subtitle", "time": 8827.59, "timestamp": "02:27:07", "text": "YouTube，嗯，差不多是这样。"}, {"type": "subtitle", "time": 8828.429, "timestamp": "02:27:08", "text": "那就是"}, {"type": "subtitle", "time": 8831.59, "timestamp": "02:27:11", "text": "疼痛？哦等等，你们在考试吗？"}, {"type": "subtitle", "time": 8834.27, "timestamp": "02:27:14", "text": "哇，祝你好运！"}, {"type": "subtitle", "time": 8837.03, "timestamp": "02:27:17", "text": "我可能需要参加的考试"}, {"type": "subtitle", "time": 8840.63, "timestamp": "02:27:20", "text": "分配 我觉得可能不行"}, {"type": "subtitle", "time": 8843.67, "timestamp": "02:27:23", "text": "可惜我只能直播一个。"}, {"type": "subtitle", "time": 8844.99, "timestamp": "02:27:24", "text": "一天"}, {"type": "subtitle", "time": 8847.83, "timestamp": "02:27:27", "text": "它。但我认为我做不到。"}, {"type": "subtitle", "time": 8850.59, "timestamp": "02:27:30", "text": "观看流媒体节目很不错"}, {"type": "subtitle", "time": 8853.95, "timestamp": "02:27:33", "text": "整整24小时"}, {"type": "subtitle", "time": 8858.99, "timestamp": "02:27:38", "text": "长达12小时的完整"}, {"type": "subtitle", "time": 8862.349, "timestamp": "02:27:42", "text": "整整一周"}, {"type": "subtitle", "time": 8865.429, "timestamp": "02:27:45", "text": "我现在就像以前那样，被人敲打着离开了。"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "那会太无聊也太痛苦了。"}, {"type": "subtitle", "time": 8869.389, "timestamp": "02:27:49", "text": "所以，"}, {"type": "subtitle", "time": 8874.23, "timestamp": "02:27:54", "text": "我需要改变一些事情，比如我……"}, {"type": "subtitle", "time": 8878.51, "timestamp": "02:27:58", "text": "以前我经常那样做，你知道，我喜欢那样做"}]
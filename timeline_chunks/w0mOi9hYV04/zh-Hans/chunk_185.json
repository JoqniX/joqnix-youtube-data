[{"type": "subtitle", "time": 11106.91, "timestamp": "03:05:06", "text": "令人不寒而栗。我本来打算玩"}, {"type": "subtitle", "time": 11110.269, "timestamp": "03:05:10", "text": "我本来想玩Apex，但后来我看了直播，所以我……"}, {"type": "subtitle", "time": 11115.23, "timestamp": "03:05:15", "text": "正在观看。嗯。等等，呃，你玩Apex英雄吗？"}, {"type": "subtitle", "time": 11121.15, "timestamp": "03:05:21", "text": "好的。我正在练习平假名，"}, {"type": "subtitle", "time": 11124.79, "timestamp": "03:05:24", "text": "片假名。哦，不错。我也在练习"}, {"type": "subtitle", "time": 11127.309, "timestamp": "03:05:27", "text": "呃，目前和Zuki一起用平假名"}, {"type": "subtitle", "time": 11130.11, "timestamp": "03:05:30", "text": "Akiabi 和我"}, {"type": "subtitle", "time": 11132.389, "timestamp": "03:05:32", "text": "版主。所以他们正在教我如何"}, {"type": "subtitle", "time": 11134.67, "timestamp": "03:05:34", "text": "做日本"}, {"type": "subtitle", "time": 11138.63, "timestamp": "03:05:38", "text": "很久以后的日本人。我记得"}, {"type": "subtitle", "time": 11144.389, "timestamp": "03:05:44", "text": "就像去年那样，呃，fe，呃"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "三月，是去年的三月还是七月？"}, {"type": "subtitle", "time": 11152.469, "timestamp": "03:05:52", "text": "我以前是这样，直到我开始接触这个……"}, {"type": "subtitle", "time": 11153.95, "timestamp": "03:05:53", "text": "虚拟主播"}, {"type": "subtitle", "time": 11157.51, "timestamp": "03:05:57", "text": "趋势，呃，在我看来，不，不是现实生活中的，我的意思是"}]
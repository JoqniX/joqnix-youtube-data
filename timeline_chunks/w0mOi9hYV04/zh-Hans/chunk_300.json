[{"type": "subtitle", "time": 18001.43, "timestamp": "05:00:01", "text": "一条路正等待着你。有这么多"}, {"type": "subtitle", "time": 18004.15, "timestamp": "05:00:04", "text": "有很多东西等着你呢"}, {"type": "subtitle", "time": 18006.19, "timestamp": "05:00:06", "text": "你必须找到他们。"}, {"type": "subtitle", "time": 18008.03, "timestamp": "05:00:08", "text": "也。但"}, {"type": "subtitle", "time": 18010.75, "timestamp": "05:00:10", "text": "是啊，想想看……"}, {"type": "subtitle", "time": 18014.35, "timestamp": "05:00:14", "text": "那件事我有点……"}, {"type": "subtitle", "time": 18017.07, "timestamp": "05:00:17", "text": "虽然有点跑题，但没错，我就是这么想的。"}, {"type": "subtitle", "time": 18020.23, "timestamp": "05:00:20", "text": "因为我是那种会从……角度思考的人。"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "另一边也太多了，而且像其他方面一样"}, {"type": "subtitle", "time": 18026.07, "timestamp": "05:00:26", "text": "站在他们的角度思考，并设身处地地为他们着想"}, {"type": "chat", "time": 18028.089, "timestamp": "05:00:28", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Is this the same joq that worries over everythingUCkszU2WH9gy1mb0dV-11UJg/hcMfY5_zAbbxvwKLooCoCA"}, {"type": "subtitle", "time": 18035.15, "timestamp": "05:00:35", "text": "呃，我太爱操心了。好的。但"}, {"type": "subtitle", "time": 18042.99, "timestamp": "05:00:42", "text": "很多，当然"}, {"type": "subtitle", "time": 18048.75, "timestamp": "05:00:48", "text": "呃，你知道，呃，是的，就像说，呃，如果"}, {"type": "subtitle", "time": 18052.03, "timestamp": "05:00:52", "text": "我的意思是，我不想要你"}, {"type": "subtitle", "time": 18055.19, "timestamp": "05:00:55", "text": "我来给你讲个故事。我不想"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "想炫耀一下名字，但懂的人都会知道。"}]
[{"type": "subtitle", "time": 6240.669, "timestamp": "01:44:00", "text": "没有吉祥物"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "呃，官方的星座或乔克尼克"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "吉祥物还没定下来吧？我们没有粉丝"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "呃，吉祥物有了吗？所以，我们可以"}, {"type": "subtitle", "time": 6257.03, "timestamp": "01:44:17", "text": "嗯，我们可以有那个。我不知道。它"}, {"type": "subtitle", "time": 6259.99, "timestamp": "01:44:19", "text": "我的意思是，这是为了未来的自己。"}, {"type": "subtitle", "time": 6262.31, "timestamp": "01:44:22", "text": "我将拥有更多资源，"}, {"type": "subtitle", "time": 6265.07, "timestamp": "01:44:25", "text": "一切"}, {"type": "subtitle", "time": 6268.03, "timestamp": "01:44:28", "text": "嗯"}, {"type": "subtitle", "time": 6273.59, "timestamp": "01:44:33", "text": "这就是你在比利频道有多少订阅者。"}, {"type": "subtitle", "time": 6275.91, "timestamp": "01:44:35", "text": "比利到现在为止，呃，我的意思是，还不算太"}, {"type": "subtitle", "time": 6277.07, "timestamp": "01:44:37", "text": "很多"}, {"type": "subtitle", "time": 6281.03, "timestamp": "01:44:41", "text": "呃，情况各不相同，因为主频道是"}, {"type": "subtitle", "time": 6282.27, "timestamp": "01:44:42", "text": "这是一个新的"}, {"type": "subtitle", "time": 6285.109, "timestamp": "01:44:45", "text": "主频道是新开的，所以"}, {"type": "subtitle", "time": 6289.189, "timestamp": "01:44:49", "text": "它有点像火车，就像人们需要的那样"}, {"type": "subtitle", "time": 6293.03, "timestamp": "01:44:53", "text": "找到我。不。是的。是的。所以我会"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "告诉你，呃，我的意思是，是数字"}, {"type": "subtitle", "time": 6298.83, "timestamp": "01:44:58", "text": "没关系，但还是"}]
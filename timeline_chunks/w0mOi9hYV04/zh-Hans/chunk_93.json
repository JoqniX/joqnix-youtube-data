[{"type": "subtitle", "time": 5582.27, "timestamp": "01:33:02", "text": "7月26日到我家。你好。"}, {"type": "subtitle", "time": 5590.189, "timestamp": "01:33:10", "text": "什么？韩国人。糟糕。嗨，我相信"}, {"type": "subtitle", "time": 5596.09, "timestamp": "01:33:16", "text": "嗯，我是说今年，也许吧。"}, {"type": "subtitle", "time": 5599.07, "timestamp": "01:33:19", "text": "[音乐]"}, {"type": "subtitle", "time": 5602.87, "timestamp": "01:33:22", "text": "嗯，今年或许会有很多。"}, {"type": "subtitle", "time": 5604.51, "timestamp": "01:33:24", "text": "在"}, {"type": "subtitle", "time": 5608.79, "timestamp": "01:33:28", "text": "为什么我现在会觉得冷？呃"}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "为什么我的勿扰模式开启了？"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "不开。好的。"}, {"type": "subtitle", "time": 5616.51, "timestamp": "01:33:36", "text": "你听到我的铃声了吗？"}, {"type": "subtitle", "time": 5619.35, "timestamp": "01:33:39", "text": "调？默认的三星Galaxy"}, {"type": "subtitle", "time": 5623.07, "timestamp": "01:33:43", "text": "想了想，呃，三星"}, {"type": "subtitle", "time": 5627.59, "timestamp": "01:33:47", "text": "正在做？是的。嗯，我觉得大概是这个"}, {"type": "subtitle", "time": 5636.709, "timestamp": "01:33:56", "text": "嗯，大概是商品吧。不知道是什么"}, {"type": "subtitle", "time": 5639.91, "timestamp": "01:33:59", "text": "虽然是某种商品。呃"}]
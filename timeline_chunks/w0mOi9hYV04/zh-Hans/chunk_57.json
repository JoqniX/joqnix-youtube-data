[{"type": "subtitle", "time": 3420.39, "timestamp": "00:57:00", "text": "是的。呃，兄弟说的是反向"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "花木兰。什么是反向花木兰？我想要一个"}, {"type": "subtitle", "time": 3425.87, "timestamp": "00:57:05", "text": "女孩"}, {"type": "subtitle", "time": 3429.03, "timestamp": "00:57:09", "text": "模型。啊，真是太不协调了。哪一个？等待，"}, {"type": "subtitle", "time": 3430.95, "timestamp": "00:57:10", "text": "你是女生吗？你要找女朋友吗？"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "模型？别开玩笑了。骑师"}, {"type": "subtitle", "time": 3435.99, "timestamp": "00:57:15", "text": "没事的。"}, {"type": "subtitle", "time": 3439.109, "timestamp": "00:57:19", "text": "我想象着骑师的私人骑师"}, {"type": "subtitle", "time": 3444.349, "timestamp": "00:57:24", "text": "就我个人而言，就像一个补丁、一包补丁、一包补丁一样。"}, {"type": "subtitle", "time": 3449.47, "timestamp": "00:57:29", "text": "除了攻击之外，那是什么？那是什么？"}, {"type": "subtitle", "time": 3452.789, "timestamp": "00:57:32", "text": "哦，呃，如果你想知道我为什么……"}, {"type": "subtitle", "time": 3455.27, "timestamp": "00:57:35", "text": "就像……我的意思是，问题是……"}, {"type": "subtitle", "time": 3458.309, "timestamp": "00:57:38", "text": "现在这是我的声音了"}, {"type": "subtitle", "time": 3461.829, "timestamp": "00:57:41", "text": "呃，问题是我的声音呃有点"}, {"type": "subtitle", "time": 3464.71, "timestamp": "00:57:44", "text": "对某些观众来说可能会造成困惑"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "就像他们"}, {"type": "subtitle", "time": 3468.069, "timestamp": "00:57:48", "text": "以为我是个女孩。有时他们"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "感觉自己像个长不大的孩子。我不知道"}, {"type": "subtitle", "time": 3474.15, "timestamp": "00:57:54", "text": "为什么。所以这就是我为什么会想到雌雄同体的原因。"}, {"type": "subtitle", "time": 3478.63, "timestamp": "00:57:58", "text": "这个模特很适合我的声音和运动型身材，因为"}]
[{"type": "subtitle", "time": 3782.43, "timestamp": "01:03:02", "text": "我，我大概能做到什么……"}, {"type": "subtitle", "time": 3786.069, "timestamp": "01:03:06", "text": "康格鲁正在做。我想那样做。"}, {"type": "subtitle", "time": 3788.19, "timestamp": "01:03:08", "text": "但有一天"}, {"type": "subtitle", "time": 3791.109, "timestamp": "01:03:11", "text": "嗯，只有当我感觉舒服的时候才会这样。"}, {"type": "subtitle", "time": 3793.829, "timestamp": "01:03:13", "text": "是的。我想展示我的脸或者"}, {"type": "subtitle", "time": 3796.39, "timestamp": "01:03:16", "text": "某物。它跟其他任何东西都不一样。它是"}, {"type": "subtitle", "time": 3798.47, "timestamp": "01:03:18", "text": "它并不漂亮什么的，但是……"}, {"type": "subtitle", "time": 3800.349, "timestamp": "01:03:20", "text": "是的。我只是个普通人。"}, {"type": "subtitle", "time": 3804.829, "timestamp": "01:03:24", "text": "居住地已超过。但"}, {"type": "subtitle", "time": 3806.99, "timestamp": "01:03:26", "text": "是的。"}, {"type": "subtitle", "time": 3813.47, "timestamp": "01:03:33", "text": "嗯，CCC。 CCC是什么？嗯，大学呃"}, {"type": "subtitle", "time": 3816.19, "timestamp": "01:03:36", "text": "抵押品呃呃"}, {"type": "subtitle", "time": 3830.109, "timestamp": "01:03:50", "text": "什么？ CZ怎么说？"}]
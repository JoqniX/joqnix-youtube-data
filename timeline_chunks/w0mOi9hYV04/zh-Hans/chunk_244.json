[{"type": "subtitle", "time": 14665.11, "timestamp": "04:04:25", "text": "[音乐]"}, {"type": "subtitle", "time": 14667.07, "timestamp": "04:04:27", "text": "我当时很累。"}, {"type": "subtitle", "time": 14670.3, "timestamp": "04:04:30", "text": "今天。我大概凌晨三点就醒了。"}, {"type": "subtitle", "time": 14671.389, "timestamp": "04:04:31", "text": "[音乐]"}, {"type": "subtitle", "time": 14674.63, "timestamp": "04:04:34", "text": "早上。我晚上醒来，"}, {"type": "subtitle", "time": 14678.349, "timestamp": "04:04:38", "text": "昨天我早上8点睡的。"}, {"type": "subtitle", "time": 14686.79, "timestamp": "04:04:46", "text": "事物。我当时真的好累。我的身体"}, {"type": "subtitle", "time": 14689.75, "timestamp": "04:04:49", "text": "内心早已麻木。本周我"}]
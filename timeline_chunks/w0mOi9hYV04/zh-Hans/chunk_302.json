[{"type": "subtitle", "time": 18120.708, "timestamp": "05:02:00", "text": "发生的事情是通常对某人的忠诚。"}, {"type": "subtitle", "time": 18124.31, "timestamp": "05:02:04", "text": "经常光顾的观众们，"}, {"type": "subtitle", "time": 18127.31, "timestamp": "05:02:07", "text": "他们感到"}, {"type": "subtitle", "time": 18132.948, "timestamp": "05:02:12", "text": "有点奇怪，因为哦，她将成为我的"}, {"type": "chat", "time": 18135.902, "timestamp": "05:02:15", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I can understand "}, {"type": "subtitle", "time": 18135.99, "timestamp": "05:02:15", "text": "主播，我的 YouTuber 即将……"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "变化是因为涌入了新一批人"}, {"type": "subtitle", "time": 18143.35, "timestamp": "05:02:23", "text": "等等。是的，她甚至都没……"}, {"type": "subtitle", "time": 18144.59, "timestamp": "05:02:24", "text": "解决这个问题"}, {"type": "subtitle", "time": 18147.19, "timestamp": "05:02:27", "text": "适当地。她确实谈到了这一点。"}, {"type": "subtitle", "time": 18148.75, "timestamp": "05:02:28", "text": "像"}, {"type": "subtitle", "time": 18151.35, "timestamp": "05:02:31", "text": "即使有新人，我也会看看。"}, {"type": "chat", "time": 18153.022, "timestamp": "05:02:33", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "It must feel bad to em "}, {"type": "subtitle", "time": 18154.55, "timestamp": "05:02:34", "text": "仍然一样等等。她谈到"}, {"type": "subtitle", "time": 18156.948, "timestamp": "05:02:36", "text": "他正确地表达了这一点，并且传达得非常到位。"}, {"type": "subtitle", "time": 18160.75, "timestamp": "05:02:40", "text": "这样，从白天开始，所有观众都能看到。"}, {"type": "subtitle", "time": 18163.83, "timestamp": "05:02:43", "text": "一、呃，还有来自新观众"}, {"type": "subtitle", "time": 18167.59, "timestamp": "05:02:47", "text": "今天有人来看她。"}, {"type": "subtitle", "time": 18169.99, "timestamp": "05:02:49", "text": "她的个性和她的新模型"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "以及所有的一切，因为他们喜欢看"}, {"type": "subtitle", "time": 18174.628, "timestamp": "05:02:54", "text": "她等等。他们都听着，他们"}, {"type": "subtitle", "time": 18177.83, "timestamp": "05:02:57", "text": "即使她回来了"}, {"type": "subtitle", "time": 18178.75, "timestamp": "05:02:58", "text": "呃"}]
[{"type": "subtitle", "time": 12240.309, "timestamp": "03:24:00", "text": "这样就做成了这样，它会"}, {"type": "subtitle", "time": 12242.469, "timestamp": "03:24:02", "text": "向上走。"}, {"type": "subtitle", "time": 12244.91, "timestamp": "03:24:04", "text": "它会来的"}, {"type": "subtitle", "time": 12248.95, "timestamp": "03:24:08", "text": "向上，不是向下，而且是"}, {"type": "subtitle", "time": 12250.91, "timestamp": "03:24:10", "text": "就在……上面"}, {"type": "subtitle", "time": 12255.03, "timestamp": "03:24:15", "text": "这个东西就像键盘一样，监控着"}, {"type": "subtitle", "time": 12258.269, "timestamp": "03:24:18", "text": "但问题是，如果我把手机放在……"}, {"type": "subtitle", "time": 12263.229, "timestamp": "03:24:23", "text": "问题是我看不到一半的内容"}, {"type": "subtitle", "time": 12266.349, "timestamp": "03:24:26", "text": "屏幕就像手机挡住了一样"}, {"type": "subtitle", "time": 12268.59, "timestamp": "03:24:28", "text": "那就是"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "问题是，我当时就想，呃，我需要……"}, {"type": "subtitle", "time": 12274.67, "timestamp": "03:24:34", "text": "抬高显示器"}, {"type": "subtitle", "time": 12276.67, "timestamp": "03:24:36", "text": "向上？那"}, {"type": "subtitle", "time": 12280.269, "timestamp": "03:24:40", "text": "作品。等等，我可以吗？"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "那？我需要这样做吗？等等，等等"}, {"type": "subtitle", "time": 12286.51, "timestamp": "03:24:46", "text": "在。我可以尝试这样做吗？"}]
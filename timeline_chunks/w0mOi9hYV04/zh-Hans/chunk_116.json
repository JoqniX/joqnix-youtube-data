[{"type": "subtitle", "time": 6960.99, "timestamp": "01:56:00", "text": "这确实表明她得到了一个活力。"}, {"type": "subtitle", "time": 6964.55, "timestamp": "01:56:04", "text": "她正在融入军队，以便能够"}, {"type": "subtitle", "time": 6966.99, "timestamp": "01:56:06", "text": "呃，弄把剑来。"}, {"type": "subtitle", "time": 6970.31, "timestamp": "01:56:10", "text": "实践。嗯，我的意思是你会得到的"}, {"type": "subtitle", "time": 6974.07, "timestamp": "01:56:14", "text": "多多益善。不，我只是……我只是"}, {"type": "subtitle", "time": 6977.03, "timestamp": "01:56:17", "text": "说道。好的。我的意思是，呃，我的设计"}, {"type": "subtitle", "time": 6980.07, "timestamp": "01:56:20", "text": "或许不会改变，但我只是想要"}, {"type": "subtitle", "time": 6983.03, "timestamp": "01:56:23", "text": "就像留长头发一样，你知道，就像你"}, {"type": "subtitle", "time": 6985.109, "timestamp": "01:56:25", "text": "我知道我总是和女生在一起。"}, {"type": "subtitle", "time": 6987.35, "timestamp": "01:56:27", "text": "留着类似短波波头的发型"}, {"type": "subtitle", "time": 6990.669, "timestamp": "01:56:30", "text": "发型，对吧？是的。类似"}, {"type": "subtitle", "time": 6994.91, "timestamp": "01:56:34", "text": "嗯，Shing Yun，呃，来自"}, {"type": "subtitle", "time": 6997.51, "timestamp": "01:56:37", "text": "嗯，好像是原神之类的游戏里的。我不"}, {"type": "subtitle", "time": 7004.75, "timestamp": "01:56:44", "text": "呃，我不知道。或许。"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "头发较长。是的，最终"}, {"type": "subtitle", "time": 7010.669, "timestamp": "01:56:50", "text": "这就像一种进化。可以这样想："}, {"type": "subtitle", "time": 7013.75, "timestamp": "01:56:53", "text": "当然，我肯定还会有自己的观点。"}, {"type": "subtitle", "time": 7016.629, "timestamp": "01:56:56", "text": "我会留着一头长长的头发，"}, {"type": "subtitle", "time": 7019.189, "timestamp": "01:56:59", "text": "我把它放在我的……就像要出来一样"}]
[{"type": "subtitle", "time": 10140.389, "timestamp": "02:49:00", "text": "那个人。我仍然患有创伤后应激障碍。那是什么？"}, {"type": "subtitle", "time": 10142.75, "timestamp": "02:49:02", "text": "游戏？我想成为"}, {"type": "subtitle", "time": 10146.389, "timestamp": "02:49:06", "text": "男。感觉这游戏不错。我"}, {"type": "subtitle", "time": 10164.429, "timestamp": "02:49:24", "text": "慢慢地。嗯？那么，我们来谈谈……"}, {"type": "subtitle", "time": 10166.11, "timestamp": "02:49:26", "text": "某物。"}, {"type": "subtitle", "time": 10169.75, "timestamp": "02:49:29", "text": "呃，你那边发生什么好事了吗？"}, {"type": "subtitle", "time": 10174.349, "timestamp": "02:49:34", "text": "今天各位？你做过什么好事吗？"}, {"type": "subtitle", "time": 10177.75, "timestamp": "02:49:37", "text": "今天？仿佛它可以是任何东西。帮助"}, {"type": "subtitle", "time": 10180.79, "timestamp": "02:49:40", "text": "你的父母，做家务，做好事"}, {"type": "subtitle", "time": 10186.23, "timestamp": "02:49:46", "text": "东西。嗯。"}, {"type": "subtitle", "time": 10189.07, "timestamp": "02:49:49", "text": "你知道，现在就是这样。"}, {"type": "subtitle", "time": 10192.71, "timestamp": "02:49:52", "text": "嗯，是的，它不会那么好。"}, {"type": "subtitle", "time": 10195.75, "timestamp": "02:49:55", "text": "这是件好事，但我只是想帮忙而已。"}, {"type": "subtitle", "time": 10197.469, "timestamp": "02:49:57", "text": "我的余额"}, {"type": "subtitle", "time": 10199.79, "timestamp": "02:49:59", "text": "今天，洗"}]
[{"type": "subtitle", "time": 10081.99, "timestamp": "02:48:01", "text": "试试本尼·弗洛伊德那玩意儿。呃"}, {"type": "subtitle", "time": 10085.19, "timestamp": "02:48:05", "text": "它叫什么来着？呃，就是那个"}, {"type": "subtitle", "time": 10088.15, "timestamp": "02:48:08", "text": "有个秃头男"}, {"type": "subtitle", "time": 10091.51, "timestamp": "02:48:11", "text": "呃，在一个锅里。我想速通"}, {"type": "subtitle", "time": 10095.87, "timestamp": "02:48:15", "text": "或者类似的事情。这将是一次有趣的经历。"}, {"type": "subtitle", "time": 10099.63, "timestamp": "02:48:19", "text": "游戏。我想玩"}, {"type": "subtitle", "time": 10103.87, "timestamp": "02:48:23", "text": "那。我会故意带走那条蛇。"}, {"type": "subtitle", "time": 10122.91, "timestamp": "02:48:42", "text": "它。让我去"}, {"type": "subtitle", "time": 10125.23, "timestamp": "02:48:45", "text": "向上。那可真是一段漫长的时光。"}, {"type": "subtitle", "time": 10127.469, "timestamp": "02:48:47", "text": "跳。没关系。"}, {"type": "subtitle", "time": 10130.83, "timestamp": "02:48:50", "text": "美好的。那是一个短篇小说"}, {"type": "subtitle", "time": 10132.87, "timestamp": "02:48:52", "text": "跳。你真的想玩吗？那"}, {"type": "subtitle", "time": 10135.03, "timestamp": "02:48:55", "text": "有道理。这让你怒不可遏。患病的"}, {"type": "subtitle", "time": 10137.03, "timestamp": "02:48:57", "text": "你总可以试试。我想成为"}]
[{"type": "subtitle", "time": 1982.31, "timestamp": "00:33:02", "text": "哦，比利，快查一下这是什么？是的，"}, {"type": "subtitle", "time": 1989.509, "timestamp": "00:33:09", "text": "事物。欢迎布拉德。欢迎来到"}, {"type": "subtitle", "time": 1992.509, "timestamp": "00:33:12", "text": "溪流。希望你一切都好。你好。"}, {"type": "subtitle", "time": 1995.83, "timestamp": "00:33:15", "text": "你好。是的，这很痛苦。你知道"}, {"type": "subtitle", "time": 1998.549, "timestamp": "00:33:18", "text": "因为存在语言障碍。不，"}, {"type": "subtitle", "time": 2001.19, "timestamp": "00:33:21", "text": "难以置信，竟然会有人读到这篇文章。"}, {"type": "subtitle", "time": 2004.549, "timestamp": "00:33:24", "text": "他们以为骑师说了什么。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "不应该像取消那样做"}, {"type": "subtitle", "time": 2009.909, "timestamp": "00:33:29", "text": "类似的东西。但我有"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "这东西开着。是的。所以，在某些情况下"}, {"type": "subtitle", "time": 2016.149, "timestamp": "00:33:36", "text": "诸如此类的事情。现在，我有了这个"}, {"type": "subtitle", "time": 2019.99, "timestamp": "00:33:39", "text": "某件事。等待。嗯，如果我能得到"}, {"type": "subtitle", "time": 2021.87, "timestamp": "00:33:41", "text": "它。"}, {"type": "subtitle", "time": 2024.59, "timestamp": "00:33:44", "text": "呃，哪里是"}, {"type": "subtitle", "time": 2028.63, "timestamp": "00:33:48", "text": "它？我有这个东西。哦，它太大了。"}, {"type": "subtitle", "time": 2032.07, "timestamp": "00:33:52", "text": "我的天哪，它太大了。呃，我的天哪。"}, {"type": "subtitle", "time": 2033.71, "timestamp": "00:33:53", "text": "他擦伤"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "最好的。呃，我明白了。它是"}]
[{"type": "subtitle", "time": 1801.35, "timestamp": "00:30:01", "text": "有时。不，它行不通。"}, {"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "捕捉我的声音。还有这个"}, {"type": "subtitle", "time": 1807.909, "timestamp": "00:30:07", "text": "我想试玩一下这款游戏。嗯"}, {"type": "subtitle", "time": 1809.909, "timestamp": "00:30:09", "text": "嗯，我想试试这款游戏。"}, {"type": "subtitle", "time": 1813.269, "timestamp": "00:30:13", "text": "出去。嗯，它叫"}, {"type": "subtitle", "time": 1821.11, "timestamp": "00:30:21", "text": "呃，别这样。哦，等等。它叫什么名字？"}, {"type": "subtitle", "time": 1822.909, "timestamp": "00:30:22", "text": "它叫什么来着？"}, {"type": "subtitle", "time": 1824.43, "timestamp": "00:30:24", "text": "呃"}, {"type": "subtitle", "time": 1827.909, "timestamp": "00:30:27", "text": "等待。哦，拍马屁吧。拍马屁。这是一个"}, {"type": "subtitle", "time": 1830.07, "timestamp": "00:30:30", "text": "一场游戏。这游戏其实挺好玩的。它"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "实际上使用的是你的声音。它识别"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "你说的话，以及你表达的方式"}, {"type": "subtitle", "time": 1837.59, "timestamp": "00:30:37", "text": "游戏中与角色的对话。这"}, {"type": "subtitle", "time": 1839.909, "timestamp": "00:30:39", "text": "角色由人工智能生成。他们会采取"}, {"type": "subtitle", "time": 1842.149, "timestamp": "00:30:42", "text": "随便你说什么，编造对话"}, {"type": "subtitle", "time": 1844.789, "timestamp": "00:30:44", "text": "去做那些事。真有趣"}, {"type": "subtitle", "time": 1850.87, "timestamp": "00:30:50", "text": "小游戏。呃，我想呃，玩一下。"}, {"type": "subtitle", "time": 1855.83, "timestamp": "00:30:55", "text": "白天，不过是的。呃，我有点害怕"}]
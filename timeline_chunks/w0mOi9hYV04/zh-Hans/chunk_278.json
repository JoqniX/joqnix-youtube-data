[{"type": "subtitle", "time": 16680.709, "timestamp": "04:38:00", "text": "欣赏这类事物等等，你可以"}, {"type": "subtitle", "time": 16683.51, "timestamp": "04:38:03", "text": "你可以这样处理，并且妥善解决。"}, {"type": "subtitle", "time": 16685.59, "timestamp": "04:38:05", "text": "与你的社区沟通，以便他们"}, {"type": "subtitle", "time": 16689.51, "timestamp": "04:38:09", "text": "可以理解，是的，美月不理解。"}, {"type": "subtitle", "time": 16692.709, "timestamp": "04:38:12", "text": "比如这样那样的事情，我应该试试。"}, {"type": "subtitle", "time": 16696.39, "timestamp": "04:38:16", "text": "不要走远，以免受伤"}, {"type": "subtitle", "time": 16698.869, "timestamp": "04:38:18", "text": "我喜欢看的那些主播之类的"}, {"type": "subtitle", "time": 16702.23, "timestamp": "04:38:22", "text": "对，因为你又得这么想。"}, {"type": "subtitle", "time": 16705.67, "timestamp": "04:38:25", "text": "一种方法是可以做到，但第二种方法"}, {"type": "subtitle", "time": 16709.029, "timestamp": "04:38:29", "text": "第二点是，记住它是"}, {"type": "subtitle", "time": 16711.429, "timestamp": "04:38:31", "text": "互联网上总是有各种各样的活动。"}, {"type": "subtitle", "time": 16714.07, "timestamp": "04:38:34", "text": "好人、坏人，人们曾经是"}, {"type": "subtitle", "time": 16715.99, "timestamp": "04:38:35", "text": "都戴着口罩什么的，对吧？"}, {"type": "subtitle", "time": 16720.15, "timestamp": "04:38:40", "text": "有时他们看到呃被描绘成呃"}, {"type": "subtitle", "time": 16722.47, "timestamp": "04:38:42", "text": "很好，但幕后他们可能"}, {"type": "subtitle", "time": 16726.23, "timestamp": "04:38:46", "text": "叫你“背后捅刀”或者像……嗯……说"}, {"type": "subtitle", "time": 16727.99, "timestamp": "04:38:47", "text": "坏事或其他什么人"}, {"type": "subtitle", "time": 16730.15, "timestamp": "04:38:50", "text": "都是人。不，每个人都不一样。"}, {"type": "subtitle", "time": 16732.15, "timestamp": "04:38:52", "text": "并非所有人都会诚实，"}, {"type": "subtitle", "time": 16734.551, "timestamp": "04:38:54", "text": "一切都对吧？所以你必须"}, {"type": "subtitle", "time": 16737.07, "timestamp": "04:38:57", "text": "我明白了。作为一种内容"}, {"type": "subtitle", "time": 16739.349, "timestamp": "04:38:59", "text": "创作者、内容创作者和现场演出"}]
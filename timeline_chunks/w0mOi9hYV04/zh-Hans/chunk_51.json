[{"type": "subtitle", "time": 3067.43, "timestamp": "00:51:07", "text": "别在意电视的声音。是，是"}, {"type": "subtitle", "time": 3081.39, "timestamp": "00:51:21", "text": "滋滋作响。是的，就是这样。"}, {"type": "subtitle", "time": 3085.79, "timestamp": "00:51:25", "text": "超过。是的，那是一个"}, {"type": "subtitle", "time": 3090.03, "timestamp": "00:51:30", "text": "嘶嘶作响，或者像冒泡一样"}, {"type": "subtitle", "time": 3093.829, "timestamp": "00:51:33", "text": "ASMR，没人问过。"}, {"type": "subtitle", "time": 3096.309, "timestamp": "00:51:36", "text": "我觉得是水，但我放了"}, {"type": "subtitle", "time": 3100.79, "timestamp": "00:51:40", "text": "就像一片维生素C片，嗯，"}, {"type": "subtitle", "time": 3102.67, "timestamp": "00:51:42", "text": "嘶嘶"}, {"type": "subtitle", "time": 3106.03, "timestamp": "00:51:46", "text": "我起床后就直接喝了。喝掉它。那是"}, {"type": "subtitle", "time": 3109.43, "timestamp": "00:51:49", "text": "它。它简直就像橙汁一样，对吧？如果"}, {"type": "subtitle", "time": 3112.71, "timestamp": "00:51:52", "text": "你知道那个叫“唐唐”的东西吗？呃，哪个？"}, {"type": "subtitle", "time": 3115.589, "timestamp": "00:51:55", "text": "我们像对待客人一样服务客人。"}, {"type": "subtitle", "time": 3118.79, "timestamp": "00:51:58", "text": "诸如此类，对吧？字面意义上的我喝"}]
[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "嗯，大概是29岁左右吧。"}, {"type": "subtitle", "time": 6305.27, "timestamp": "01:45:05", "text": "船上频道里有些东西，还有"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "当前这个就像什么"}, {"type": "subtitle", "time": 6312.149, "timestamp": "01:45:12", "text": "呃，18岁。是的，它正在慢慢赶上。"}, {"type": "subtitle", "time": 6315.55, "timestamp": "01:45:15", "text": "什么频道？是的，速度很慢。"}, {"type": "subtitle", "time": 6318.07, "timestamp": "01:45:18", "text": "慢慢地。所以，是的，我们会"}, {"type": "subtitle", "time": 6320.109, "timestamp": "01:45:20", "text": "最终得到"}, {"type": "subtitle", "time": 6323.189, "timestamp": "01:45:23", "text": "那里。嗯，但我很高兴看到这一点。"}, {"type": "subtitle", "time": 6327.39, "timestamp": "01:45:27", "text": "他们就像每天都说“呃呃”一样，不呃。"}, {"type": "subtitle", "time": 6330.55, "timestamp": "01:45:30", "text": "就像YouTube上的那些人一样"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "是Twitch吧？你们是怎么看我的"}, {"type": "subtitle", "time": 6336.55, "timestamp": "01:45:36", "text": "当我……呃，真的……宣布的时候"}, {"type": "subtitle", "time": 6339.629, "timestamp": "01:45:39", "text": "现在就可以直接直播，无需预热"}, {"type": "subtitle", "time": 6342.229, "timestamp": "01:45:42", "text": "预先公布的预先公布。呃"}, {"type": "subtitle", "time": 6344.07, "timestamp": "01:45:44", "text": "当我直播的时候，你过来观看。"}, {"type": "subtitle", "time": 6345.39, "timestamp": "01:45:45", "text": "对，就像"}, {"type": "subtitle", "time": 6347.47, "timestamp": "01:45:47", "text": "那。我很高兴"}, {"type": "subtitle", "time": 6350.149, "timestamp": "01:45:50", "text": "那边也有几个"}, {"type": "subtitle", "time": 6351.669, "timestamp": "01:45:51", "text": "人们"}, {"type": "subtitle", "time": 6353.91, "timestamp": "01:45:53", "text": "呃，那些积极主动过来的人甚至"}, {"type": "subtitle", "time": 6356.95, "timestamp": "01:45:56", "text": "虽然他们不太懂英语。"}, {"type": "subtitle", "time": 6359.75, "timestamp": "01:45:59", "text": "他们会说：“好的，我们会关注你的。”"}]
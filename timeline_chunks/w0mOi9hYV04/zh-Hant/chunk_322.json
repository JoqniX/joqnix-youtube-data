[{"type": "chat", "time": 19325.029, "timestamp": "05:22:05", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Hai haii ^^"}, {"type": "subtitle", "time": 19339.99, "timestamp": "05:22:19", "text": "我從來不想讓我的運動服被我真實的自我玷污或腐蝕。  有一段時間，我想用別人代替Jock，也就是說，"}, {"type": "subtitle", "time": 19348.47, "timestamp": "05:22:28", "text": "我不想再當Jocknik，讓別人代替我當Jocknik之類的，因為我覺得自己不夠格，因為Jock對某些人"}, {"type": "subtitle", "time": 19366.31, "timestamp": "05:22:46", "text": "來說……"}, {"type": "subtitle", "time": 19373.27, "timestamp": "05:22:53", "text": "嗯，"}, {"type": "subtitle", "time": 19376.39, "timestamp": "05:22:56", "text": "我不知道，也許對很多人來說它只是一個角色，或者只是一個名字，但對我來說，它就像一個整體。嗯，Doc在我最艱難的時刻拯救了我。我許下的承諾讓我此刻還活著，而且依然是我自己。期間經歷了很多起伏。  是啊，有些人可能會想，「我的天，Jock這是在展現他的多重人格嗎？他是不是有多重人格障礙"}]
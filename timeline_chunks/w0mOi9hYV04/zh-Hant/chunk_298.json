[{"type": "subtitle", "time": 17897.35, "timestamp": "04:58:17", "text": "我。他們仍然存在於某個地方。我祝他們一切順利。"}, {"type": "subtitle", "time": 17922.948, "timestamp": "04:58:42", "text": "即使他們不再關注我，我仍然祝他們好運。不管"}, {"type": "subtitle", "time": 17926.31, "timestamp": "04:58:46", "text": "他們支持誰，因為他們來我的直播間，花時間支持我，我真的很"}, {"type": "subtitle", "time": 17935.91, "timestamp": "04:58:55", "text": "開心，這讓我感到無比幸福。他們來看我的直播，讓我感覺自己是全世界最幸福的人。"}]
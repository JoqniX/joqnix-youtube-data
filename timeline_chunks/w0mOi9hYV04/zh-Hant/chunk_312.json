[{"type": "chat", "time": 18730.752, "timestamp": "05:12:10", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "LOL JOQ MOMENT "}, {"type": "subtitle", "time": 18737.43, "timestamp": "05:12:17", "text": "。我會把這些回憶珍藏在心底，因為我記得那些在我身邊的人，記得那些好事和壞事，記得那些傷害過我的人，記得那些陪伴過"}, {"type": "subtitle", "time": 18742.23, "timestamp": "05:12:22", "text": "我的人等等。我從不恨任何人，因為恨人有什麼意義呢？這樣做有什麼意義？"}, {"type": "subtitle", "time": 18744.708, "timestamp": "05:12:24", "text": "當然，人們可以恨"}, {"type": "subtitle", "time": 18746.59, "timestamp": "05:12:26", "text": "我，但我不在乎他們是否恨我"}, {"type": "subtitle", "time": 18748.948, "timestamp": "05:12:28", "text": "。"}, {"type": "subtitle", "time": 18755.39, "timestamp": "05:12:35", "text": "我無法讓"}, {"type": "subtitle", "time": 18762.23, "timestamp": "05:12:42", "text": "自己恨任何人，"}, {"type": "subtitle", "time": 18765.99, "timestamp": "05:12:45", "text": "如果他們做了非常糟糕的事情，因為恨他們有什麼意義呢？人都會犯錯。人就是這樣等等。事情的發生總是有原因的，對吧？是的。寬恕的行為是可以的。"}, {"type": "subtitle", "time": 18777.788, "timestamp": "05:12:57", "text": "我這麼說並不是"}]
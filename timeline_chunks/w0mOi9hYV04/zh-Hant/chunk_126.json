[{"type": "subtitle", "time": 7566.44, "timestamp": "02:06:06", "text": "頻道上發布。所以，大家最後都會訂閱V頻道。說實話，"}, {"type": "subtitle", "time": 7583.15, "timestamp": "02:06:23", "text": "我希望大家訂閱V頻道。目前我會把精彩片段和各種剪輯上傳到W頻道。嗯，但是"}, {"type": "subtitle", "time": 7584.75, "timestamp": "02:06:24", "text": "[音樂]是的，還有，呃，學校有錢，呃[音樂]巴"}, {"type": "subtitle", "time": 7588.229, "timestamp": "02:06:28", "text": "。哦。啊。是的，我"}, {"type": "subtitle", "time": 7608.109, "timestamp": "02:06:48", "text": "說「但是」的時候它顯示的是「巴」。哦，我的天。呃，我看"}, {"type": "subtitle", "time": 7617.149, "timestamp": "02:06:57", "text": "短片就像你一樣，呃，可以保留一些片段。是的。是的。"}]
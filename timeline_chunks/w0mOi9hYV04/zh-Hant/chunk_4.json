[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "所以，呃，呃，昨天今天，實際上，如果"}, {"type": "subtitle", "time": 258.229, "timestamp": "00:04:18", "text": "我不"}, {"type": "subtitle", "time": 260.949, "timestamp": "00:04:20", "text": "知道我有沒有提到過，對於那些不知道的人來說，嗯，我"}, {"type": "subtitle", "time": 263.51, "timestamp": "00:04:23", "text": "帶了我的滑板車。呃，等等，Scooty 和 Scooter 有什麼不同？我不知道。"}, {"type": "subtitle", "time": 271.95, "timestamp": "00:04:31", "text": "對，就是"}, {"type": "subtitle", "time": 275.51, "timestamp": "00:04:35", "text": "我爸媽買給我的那一個。那輛車是我在這裡買的，實際上，我盡了全力"}, {"type": "subtitle", "time": 285.11, "timestamp": "00:04:45", "text": "騎著它從我家到我現在住的地方。天哪，"}]
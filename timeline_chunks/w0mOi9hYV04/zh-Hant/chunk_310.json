[{"type": "chat", "time": 18613.729, "timestamp": "05:10:13", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Hm i get it :)"}, {"type": "subtitle", "time": 18622.55, "timestamp": "05:10:22", "text": "聖誕樹。我們把每個訪客都做成了裝飾品，包括他們的頭像等等，對吧？誰還記得這件事？我至今仍記得這件事"}, {"type": "subtitle", "time": 18630.07, "timestamp": "05:10:30", "text": "。即使我"}, {"type": "subtitle", "time": 18640.35, "timestamp": "05:10:40", "text": "記性不好，我也不會忘記人。這就是為什麼我有一些工具來幫助我理清思路，"}, {"type": "subtitle", "time": 18643.11, "timestamp": "05:10:43", "text": "比如聊天記錄之類的，因為"}, {"type": "subtitle", "time": 18647.67, "timestamp": "05:10:47", "text": "它可以讓我明白誰是真心想支持我的人，誰是來過又來過的人，嗯，該怎麼稱呼它呢？我確實就此事寫過一個故事。"}, {"type": "subtitle", "time": 18659.83, "timestamp": "05:10:59", "text": "如果你去我的頻道，看看影片部分，如果你看到關於拍攝的"}]
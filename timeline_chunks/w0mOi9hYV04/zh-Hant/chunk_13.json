[{"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "現在"}, {"type": "subtitle", "time": 818.55, "timestamp": "00:13:38", "text": "我的模型有時會像卡住了一樣一直運行下去。它卡住了。  徹底卡住了。現在它移動起來就像，"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "呃，就像我做的所有動作一樣，呃，就像你快進到"}, {"type": "subtitle", "time": 828.15, "timestamp": "00:13:48", "text": "高潮部分一樣。  發現和努力是件好事"}]
[{"type": "subtitle", "time": 9487.389, "timestamp": "02:38:07", "text": "？這很有道理。這讓你怒不可遏。我總是……你也可以試試。我想成為那樣的人。我仍然患有創傷"}, {"type": "subtitle", "time": 9490.79, "timestamp": "02:38:10", "text": "後應激障礙。那是"}, {"type": "subtitle", "time": 9509.91, "timestamp": "02:38:29", "text": "什麼遊戲？我想成為那樣的"}, {"type": "subtitle", "time": 9516.07, "timestamp": "02:38:36", "text": "人。感覺這遊戲不錯。我會試一試，為什麼不呢？我需要"}, {"type": "subtitle", "time": 9519.67, "timestamp": "02:38:39", "text": "慢慢跳。嗯？那麼，我們來聊點什麼吧"}, {"type": "subtitle", "time": 9528.349, "timestamp": "02:38:48", "text": "。呃"}, {"type": "subtitle", "time": 9534.27, "timestamp": "02:38:54", "text": "，你們今天遇到什麼好事了嗎？ 你今天"}, {"type": "subtitle", "time": 9538.389, "timestamp": "02:38:58", "text": "做了什麼好事嗎？耽誤。"}]
[{"type": "subtitle", "time": 6421.229, "timestamp": "01:47:01", "text": "等待。今天是你的生日。等待。  真的嗎？開玩笑。只是在開玩笑。"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "哦，今天不是你的生日。好的。我剛才確實興奮了一下。哦，告訴我今天是不是你的生日。"}, {"type": "subtitle", "time": 6447.27, "timestamp": "01:47:27", "text": "我會為你唱生日歌。呃，祝今天過生日的人生日快樂。生日"}, {"type": "subtitle", "time": 6452.149, "timestamp": "01:47:32", "text": "快樂。"}, {"type": "subtitle", "time": 6456.07, "timestamp": "01:47:36", "text": "呃，今天是我"}, {"type": "subtitle", "time": 6459.35, "timestamp": "01:47:39", "text": "的生日。我的生日在七月。哦好的。如果有人快過生日了，請提醒我。"}, {"type": "subtitle", "time": 6467.99, "timestamp": "01:47:47", "text": "好的，我會盡量記住，或者我會把它記在我的日曆裡提醒自己。如果那天我有直播，我會為"}]
[{"type": "subtitle", "time": 23640.19, "timestamp": "06:34:00", "text": "YouTube上看直播，我感到非常孤獨。我當時就想，這也太痛苦了吧。"}, {"type": "subtitle", "time": 23644.23, "timestamp": "06:34:04", "text": "我感到孤獨。我"}, {"type": "subtitle", "time": 23648.548, "timestamp": "06:34:08", "text": "需要朋友。呃，我需要一些像印度YouTube部落客那樣的朋友"}, {"type": "subtitle", "time": 23651.27, "timestamp": "06:34:11", "text": "。"}, {"type": "subtitle", "time": 23653.43, "timestamp": "06:34:13", "text": "但"}, {"type": "subtitle", "time": 23655.948, "timestamp": "06:34:15", "text": "實際上並沒有。實際上並沒有多少。  是啊，"}, {"type": "subtitle", "time": 23659.75, "timestamp": "06:34:19", "text": "我當時就像在付錢一樣。嗯，我什麼時候問過你「"}, {"type": "subtitle", "time": 23665.59, "timestamp": "06:34:25", "text": "你來自哪個國家？」我來自印度。"}, {"type": "subtitle", "time": 23669.15, "timestamp": "06:34:29", "text": "我來自印度。我來自印度。  是的。是的"}, {"type": "subtitle", "time": 23672.43, "timestamp": "06:34:32", "text": "。嗯"}, {"type": "subtitle", "time": 23676.31, "timestamp": "06:34:36", "text": "，那天是我第一次在"}, {"type": "subtitle", "time": 23678.03, "timestamp": "06:34:38", "text": "YouTube 上"}, {"type": "subtitle", "time": 23682.83, "timestamp": "06:34:42", "text": "直播的日子。好的。不是第一次，而是像完全的……"}, {"type": "subtitle", "time": 23687.75, "timestamp": "06:34:47", "text": "呃……轉移，不是轉移，呃……就像，該"}, {"type": "subtitle", "time": 23690.628, "timestamp": "06:34:50", "text": "怎麼稱呼它，完全搬到"}, {"type": "subtitle", "time": 23693.35, "timestamp": "06:34:53", "text": "YouTube 上，就像很明顯地說，"}, {"type": "subtitle", "time": 23695.83, "timestamp": "06:34:55", "text": "我以後會在 YouTube 上直播，在"}, {"type": "subtitle", "time": 23698.39, "timestamp": "06:34:58", "text": "這裡製作東西"}]
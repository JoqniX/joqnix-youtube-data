[{"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "看待它。積極地想一想，這件事發生了，我能做些什麼呢？而"}, {"type": "subtitle", "time": 16989.59, "timestamp": "04:43:09", "text": "不是哭泣和崩潰。當然，你可以哭，哭出來。"}, {"type": "subtitle", "time": 16992.39, "timestamp": "04:43:12", "text": "如果真的讓你太難過，我建議你哭出來。哭完之後，等你冷靜下來，好好想想。我現在能做什麼？我能做些什麼來確保自己能繼續前進？"}, {"type": "subtitle", "time": 17017.83, "timestamp": "04:43:37", "text": "我不想讓這件事影響我的旅程。我有夢想，我有目標，我想成為印度YouTuber，對吧？你需要把這些都想清楚，然後寫在紙上。對著鏡子，讓自己"}, {"type": "chat", "time": 17035.784, "timestamp": "04:43:55", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "You are amazing and inspiring "}]
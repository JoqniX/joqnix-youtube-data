[{"type": "subtitle", "time": 18192.628, "timestamp": "05:03:12", "text": "是機器人"}, {"type": "subtitle", "time": 18193.99, "timestamp": "05:03:13", "text": "。之後幾個小時，"}, {"type": "subtitle", "time": 18196.59, "timestamp": "05:03:16", "text": "有人注意我，但就是沒人看，這讓我很沮喪"}, {"type": "subtitle", "time": 18201.83, "timestamp": "05:03:21", "text": "。後來我"}, {"type": "subtitle", "time": 18209.91, "timestamp": "05:03:29", "text": "開始看各種教學和指南，我發現有時候不看觀看人數也沒關係，可以把觀看人數藏起來。"}, {"type": "subtitle", "time": 18219.59, "timestamp": "05:03:39", "text": "當然，在YouTube上，你看觀看人數的時候，一定會受到很多影響。你可以說“嘿，就像直播一樣”，但別去看觀看"}, {"type": "chat", "time": 18225.236, "timestamp": "05:03:45", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Omg why would you do that to yourself that’s a lottt"}, {"type": "subtitle", "time": 18237.75, "timestamp": "05:03:57", "text": "人數，夥計，這會影響你的心態。說真的，這真的會影響你的心態。你會想，我一直在喋喋不休，我做了三、四個小時，卻沒人看我。為什麼？然後你會責怪自己。是我有問題嗎？"}]
[{"type": "subtitle", "time": 11327.75, "timestamp": "03:08:47", "text": "哦，我得查一下。  呃，"}, {"type": "subtitle", "time": 11330.07, "timestamp": "03:08:50", "text": "我得私訊他們。  是的。  星期五到了。哦"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "，等等。星期五。週六。  週六。我們和"}, {"type": "subtitle", "time": 11337.99, "timestamp": "03:08:57", "text": "Hoku 有"}]
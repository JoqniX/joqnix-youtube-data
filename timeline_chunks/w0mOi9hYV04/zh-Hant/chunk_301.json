[{"type": "subtitle", "time": 18084.948, "timestamp": "05:01:24", "text": "Jockathon"}, {"type": "subtitle", "time": 18086.788, "timestamp": "05:01:26", "text": "直播的時候，也有人來來往往，對吧？有時候，會覺得很孤獨，因為沒有人來跟我互動。但我也能理解，我在這裡已經很久了，"}, {"type": "subtitle", "time": 18106.788, "timestamp": "05:01:46", "text": "我不想強迫別人來看我的直播。不，他們有自由選擇"}]
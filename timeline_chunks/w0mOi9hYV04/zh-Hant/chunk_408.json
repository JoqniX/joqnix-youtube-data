[{"type": "subtitle", "time": 24481.11, "timestamp": "06:48:01", "text": "哦，好久不見了。嗯？"}, {"type": "subtitle", "time": 24486.31, "timestamp": "06:48:06", "text": "我已經很久沒看書了"}, {"type": "subtitle", "time": 24493.75, "timestamp": "06:48:13", "text": "。我的意思是，"}, {"type": "subtitle", "time": 24497.75, "timestamp": "06:48:17", "text": "不是讀什麼東西。最近，我一直在看雷的……雷的……"}, {"type": "subtitle", "time": 24511.19, "timestamp": "06:48:31", "text": "呃……"}, {"type": "subtitle", "time": 24523.91, "timestamp": "06:48:43", "text": "輕小說作品"}, {"type": "subtitle", "time": 24527.91, "timestamp": "06:48:47", "text": "。他傳了一些頁面給我。我慢慢地、慢慢地嘗試閱讀，但我連一卷都沒"}, {"type": "subtitle", "time": 24531.91, "timestamp": "06:48:51", "text": "能看完，因為我一直在拖延。我當時想，哦，付款很難，閱讀也很難。我不想看書。閱讀是 f。是啊，懶散運動員的時代。是的"}]
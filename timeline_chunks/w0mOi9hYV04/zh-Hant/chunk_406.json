[{"type": "subtitle", "time": 24362.868, "timestamp": "06:46:02", "text": "等等，不是生日"}, {"type": "subtitle", "time": 24365.91, "timestamp": "06:46:05", "text": "。迎"}, {"type": "subtitle", "time": 24379.628, "timestamp": "06:46:19", "text": "嬰派對。一段關於嬰兒派對的[音樂] 愉快的談話。我記得我忘了那不是櫻小姐的迎嬰派對，好像是這個月或"}, {"type": "subtitle", "time": 24387.27, "timestamp": "06:46:27", "text": "下個月的某個時候，我忘了她之前說過迎嬰派對之類的，好像是"}, {"type": "subtitle", "time": 24389.99, "timestamp": "06:46:29", "text": "在Discord上，或者其他什麼地方，我不記得了。  是的，我只記得櫻在計劃"}, {"type": "subtitle", "time": 24404.468, "timestamp": "06:46:44", "text": "或談論嬰兒派對。"}, {"type": "subtitle", "time": 24414.868, "timestamp": "06:46:54", "text": "這讓我想起來，我也是直到自己參加過一次嬰兒派對才知道那是什麼。等等，我忘了什麼是嬰兒派對了。"}, {"type": "subtitle", "time": 24418.868, "timestamp": "06:46:58", "text": "呃，所以嬰兒"}]
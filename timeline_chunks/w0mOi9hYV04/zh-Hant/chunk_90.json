[{"type": "subtitle", "time": 5405.99, "timestamp": "01:30:05", "text": "他們戰鬥。哦好的。"}, {"type": "subtitle", "time": 5411.75, "timestamp": "01:30:11", "text": "我得走了"}, {"type": "subtitle", "time": 5415.31, "timestamp": "01:30:15", "text": "。  嗨，我是說，呃，莫莉。嗯，保重。"}, {"type": "subtitle", "time": 5422.11, "timestamp": "01:30:22", "text": "祝你一切順利。好的，謝謝收看"}, {"type": "subtitle", "time": 5424.149, "timestamp": "01:30:24", "text": "。希望你能趕上進度，下次再見。"}, {"type": "subtitle", "time": 5428.43, "timestamp": "01:30:28", "text": "小心。祝你考試"}, {"type": "subtitle", "time": 5440.629, "timestamp": "01:30:40", "text": "愉快，一切順利。與考試之類的事情作鬥爭。運氣。"}]
[{"type": "subtitle", "time": 5229.75, "timestamp": "01:27:09", "text": "誕生日。今日は私の誕生日です。私の"}, {"type": "subtitle", "time": 5232.87, "timestamp": "01:27:12", "text": "誕生日は7月です。ああ、わかりました。リマインダー"}, {"type": "subtitle", "time": 5235.59, "timestamp": "01:27:15", "text": "誰かの誕生日が近づいている場合、または"}, {"type": "subtitle", "time": 5238.149, "timestamp": "01:27:18", "text": "何か。わかった、思い出してみるか"}, {"type": "subtitle", "time": 5241.83, "timestamp": "01:27:21", "text": "カレンダーに書き込んでみます。"}, {"type": "subtitle", "time": 5244.31, "timestamp": "01:27:24", "text": "ストリーミング配信中かどうか自分に言い聞かせる"}, {"type": "subtitle", "time": 5247.51, "timestamp": "01:27:27", "text": "その日、私はハッピーバースデーを歌います"}, {"type": "subtitle", "time": 5249.35, "timestamp": "01:27:29", "text": "君への歌。今、あなたの"}, {"type": "subtitle", "time": 5252.27, "timestamp": "01:27:32", "text": "誕生日、ジョック、"}, {"type": "subtitle", "time": 5255.83, "timestamp": "01:27:35", "text": "忘れる？私の誕生日を忘れたの？"}, {"type": "subtitle", "time": 5257.75, "timestamp": "01:27:37", "text": "コラ？"}, {"type": "subtitle", "time": 5262.149, "timestamp": "01:27:42", "text": "えっと、私の誕生日は8月11日です"}, {"type": "subtitle", "time": 5264.39, "timestamp": "01:27:44", "text": "そしてもし私の誕生日を知らないなら、"}, {"type": "subtitle", "time": 5266.709, "timestamp": "01:27:46", "text": "いつでも今後の配信を確認できます"}, {"type": "subtitle", "time": 5269.75, "timestamp": "01:27:49", "text": "スケジュールと無料チャット"}, {"type": "subtitle", "time": 5273.51, "timestamp": "01:27:53", "text": "そちら側。それは常に"}, {"type": "subtitle", "time": 5276.79, "timestamp": "01:27:56", "text": "同日に予定されているものと1年先のもの"}]
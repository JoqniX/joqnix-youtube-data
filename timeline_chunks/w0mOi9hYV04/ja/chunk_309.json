[{"type": "subtitle", "time": 18540.948, "timestamp": "05:09:00", "text": "あれこれと冗談を言い合おう。次"}, {"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "もし気分が良くないなら"}, {"type": "subtitle", "time": 18545.27, "timestamp": "05:09:05", "text": "次回からはそうしないようにしてください。"}, {"type": "subtitle", "time": 18549.75, "timestamp": "05:09:09", "text": "または、もしあなたが間違いを犯したり、"}, {"type": "subtitle", "time": 18552.55, "timestamp": "05:09:12", "text": "例えば、自分で個人情報を晒したり、その他いろいろ"}, {"type": "subtitle", "time": 18554.788, "timestamp": "05:09:14", "text": "次回は何かを漏らさないでください"}, {"type": "subtitle", "time": 18558.31, "timestamp": "05:09:18", "text": "画面キャプチャ、またはより注意して"}, {"type": "subtitle", "time": 18560.788, "timestamp": "05:09:20", "text": "間違いから学び、適応する"}, {"type": "subtitle", "time": 18563.51, "timestamp": "05:09:23", "text": "適応しない、そうする、そうする"}, {"type": "subtitle", "time": 18566.15, "timestamp": "05:09:26", "text": "比較するよりも実際には良い"}, {"type": "subtitle", "time": 18570.31, "timestamp": "05:09:30", "text": "ああ、仲間よ"}, {"type": "subtitle", "time": 18573.35, "timestamp": "05:09:33", "text": "友達のYouTuberは私より視聴者が多い"}, {"type": "subtitle", "time": 18576.35, "timestamp": "05:09:36", "text": "私の視聴者のほとんどは、"}, {"type": "subtitle", "time": 18578.03, "timestamp": "05:09:38", "text": "等"}, {"type": "subtitle", "time": 18581.27, "timestamp": "05:09:41", "text": "覚えておいてください、最後には"}, {"type": "subtitle", "time": 18584.628, "timestamp": "05:09:44", "text": "どこにいてもあなたをサポートしてくれる人たち"}, {"type": "subtitle", "time": 18588.55, "timestamp": "05:09:48", "text": "行くよ、誰が君を見守るんだ、なぜなら彼らは"}, {"type": "subtitle", "time": 18591.15, "timestamp": "05:09:51", "text": "お時間とご尽力に感謝いたします。彼らは"}, {"type": "subtitle", "time": 18594.708, "timestamp": "05:09:54", "text": "ありのままのあなたに感謝します。彼らはそうではない"}, {"type": "subtitle", "time": 18596.868, "timestamp": "05:09:56", "text": "モデルのおかげで、あなたの見た目が"}, {"type": "subtitle", "time": 18599.43, "timestamp": "05:09:59", "text": "あるいは何でもいい。彼らはここにいない"}]
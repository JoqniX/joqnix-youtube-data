[{"type": "subtitle", "time": 1628.029, "timestamp": "00:27:08", "text": "水。少し分けてください"}, {"type": "subtitle", "time": 1630.71, "timestamp": "00:27:10", "text": "水。こんにちは、ザキトラベルさん。ようこそ"}, {"type": "subtitle", "time": 1632.669, "timestamp": "00:27:12", "text": "小川。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 1635.77, "timestamp": "00:27:15", "text": "良い。だった"}, {"type": "subtitle", "time": 1638.35, "timestamp": "00:27:18", "text": "[音楽]"}, {"type": "subtitle", "time": 1647.23, "timestamp": "00:27:27", "text": "水。ええ、そうです"}, {"type": "subtitle", "time": 1650.23, "timestamp": "00:27:30", "text": "熱い。 4月16日。今日は誰の誕生日ですか？"}, {"type": "subtitle", "time": 1652.59, "timestamp": "00:27:32", "text": "えっと、ニンジャの誕生日。"}, {"type": "subtitle", "time": 1654.87, "timestamp": "00:27:34", "text": "はい、教えていただきありがとうございます"}, {"type": "subtitle", "time": 1656.99, "timestamp": "00:27:36", "text": "誕生日。やってみます"}, {"type": "subtitle", "time": 1659.71, "timestamp": "00:27:39", "text": "覚えて。"}, {"type": "subtitle", "time": 1663.43, "timestamp": "00:27:43", "text": "はい、Discordサーバーにいるなら、"}, {"type": "subtitle", "time": 1666.43, "timestamp": "00:27:46", "text": "おなじみのDiscordサーバーまたは"}, {"type": "subtitle", "time": 1669.75, "timestamp": "00:27:49", "text": "コンステラサーバー、えーと、つまり、それは"}, {"type": "subtitle", "time": 1672.71, "timestamp": "00:27:52", "text": "すべて同じサーバーです。私はただ楽しんでいるだけです"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "それに対する名前。"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "ええ、誕生日を設定できます"}]
[{"type": "subtitle", "time": 9241.03, "timestamp": "02:34:01", "text": "知っている？えっと、皆さんお元気ですか？した"}, {"type": "subtitle", "time": 9244.15, "timestamp": "02:34:04", "text": "皆さんに何か良いことが起こりましたか？"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "そして、実は私は計画を立てていたんです"}, {"type": "subtitle", "time": 9251.23, "timestamp": "02:34:11", "text": "ストリーミングを始める前に何を言うべきか、"}, {"type": "subtitle", "time": 9253.87, "timestamp": "02:34:13", "text": "しかし、私は言えません"}, {"type": "subtitle", "time": 9261.389, "timestamp": "02:34:21", "text": "ああ、そうだね。皆さんお元気ですか？"}, {"type": "subtitle", "time": 9266.429, "timestamp": "02:34:26", "text": "何をしているの？うん。全然気づかなかったよ"}, {"type": "subtitle", "time": 9268.87, "timestamp": "02:34:28", "text": "前に。本当に良い考えですか？"}, {"type": "subtitle", "time": 9270.83, "timestamp": "02:34:30", "text": "現在配信中ですか？"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "ええ、わかっています。ああ、心が落ち着いた気がする"}, {"type": "subtitle", "time": 9282.99, "timestamp": "02:34:42", "text": "私が配信してあなたと話すとき"}, {"type": "subtitle", "time": 9287.59, "timestamp": "02:34:47", "text": "人々。同じことは、"}, {"type": "subtitle", "time": 9290.63, "timestamp": "02:34:50", "text": "私はDiscord Vanの件で話しています"}, {"type": "subtitle", "time": 9293.27, "timestamp": "02:34:53", "text": "人との交流は良いことだ。あなたの"}, {"type": "subtitle", "time": 9295.83, "timestamp": "02:34:55", "text": "コントラストが強すぎる。えっと、実際は"}]
[{"type": "subtitle", "time": 5882.43, "timestamp": "01:38:02", "text": "そうすれば、"}, {"type": "subtitle", "time": 5886.47, "timestamp": "01:38:06", "text": "えーと、会員限定コンテンツとかそういうやつ"}, {"type": "subtitle", "time": 5889.669, "timestamp": "01:38:09", "text": "無料か何かで、すでに"}, {"type": "subtitle", "time": 5892.709, "timestamp": "01:38:12", "text": "あなたは物にお金を払っているんですよね？えっと"}, {"type": "subtitle", "time": 5894.87, "timestamp": "01:38:14", "text": "サイトへの入場料を支払う。それで"}, {"type": "subtitle", "time": 5897.83, "timestamp": "01:38:17", "text": "ええ、それは一つの理由ですね。えっと、私はえっと"}, {"type": "subtitle", "time": 5900.95, "timestamp": "01:38:20", "text": "このウェブサイトを見ました"}, {"type": "subtitle", "time": 5903.669, "timestamp": "01:38:23", "text": "コンテンツクリエイターの一部が利用している"}, {"type": "subtitle", "time": 5905.75, "timestamp": "01:38:25", "text": "YouTubeで。だから私は「あ、待って」と思った。"}, {"type": "subtitle", "time": 5908.31, "timestamp": "01:38:28", "text": "「これは何？」ということで、試してみました。"}, {"type": "subtitle", "time": 5910.87, "timestamp": "01:38:30", "text": "それでいくつか作ってみた。だから私は"}, {"type": "subtitle", "time": 5913.07, "timestamp": "01:38:33", "text": "「うーん、いいよ、"}, {"type": "subtitle", "time": 5916.47, "timestamp": "01:38:36", "text": "でも、私が持っていたものと全く同じというわけではない"}, {"type": "subtitle", "time": 5919.59, "timestamp": "01:38:39", "text": "まあ、そういうことだ。私はちょっとfが欲しい"}, {"type": "subtitle", "time": 5924.149, "timestamp": "01:38:44", "text": "ファンクラブページみたいなものが欲しかったんです。えっと"}, {"type": "subtitle", "time": 5927.27, "timestamp": "01:38:47", "text": "うん、何かみたいな、それは"}, {"type": "subtitle", "time": 5929.669, "timestamp": "01:38:49", "text": "あなた、みんなのためにカスタマイズされ、"}, {"type": "subtitle", "time": 5931.669, "timestamp": "01:38:51", "text": "すべて。まあ、そんな感じですね。しかしそれは"}, {"type": "subtitle", "time": 5934.55, "timestamp": "01:38:54", "text": "ある種の痛み。でもいずれ分かるだろう"}, {"type": "subtitle", "time": 5936.669, "timestamp": "01:38:56", "text": "それを出す。うん。"}, {"type": "subtitle", "time": 5939.109, "timestamp": "01:38:59", "text": "うん。えっと、モデレーターの追跡が機能していません"}]
[{"type": "subtitle", "time": 724.79, "timestamp": "00:12:04", "text": "[音楽]"}, {"type": "subtitle", "time": 727.59, "timestamp": "00:12:07", "text": "忍者が「パネル」と言った時、怖くなった。なぜ"}, {"type": "subtitle", "time": 729.949, "timestamp": "00:12:09", "text": "手に入れましたか？"}, {"type": "subtitle", "time": 734.069, "timestamp": "00:12:14", "text": "怖がった？えっと、実は私は"}, {"type": "subtitle", "time": 736.79, "timestamp": "00:12:16", "text": "パニールのようなものがあった、あるいは"}, {"type": "subtitle", "time": 740.35, "timestamp": "00:12:20", "text": "何か。それは、もしかしたら、"}, {"type": "subtitle", "time": 743.55, "timestamp": "00:12:23", "text": "なぜ。それが理由かもしれない。"}, {"type": "subtitle", "time": 757.269, "timestamp": "00:12:37", "text": "私のモデルが動かなくなったのはなぜですか？ Bスタジオはなぜ"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "電話からこの機器へ？ Wi-Fiを使う理由"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "それは不可能ですか？ご存知のとおり、私は"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "USB なぜなら iPhone を手に入れなければならないから"}, {"type": "subtitle", "time": 772.389, "timestamp": "00:12:52", "text": "残念ながらUSBを使うしかないですね。でも、Wi-Fiは"}, {"type": "subtitle", "time": 774.99, "timestamp": "00:12:54", "text": "その方法は苦痛を伴う。どうして"}]
[{"type": "subtitle", "time": 5642.31, "timestamp": "01:34:02", "text": "でも、おそらくそうですね。つまり、それは"}, {"type": "subtitle", "time": 5644.95, "timestamp": "01:34:04", "text": "やるべきこととして計画されているもの"}, {"type": "subtitle", "time": 5647.83, "timestamp": "01:34:07", "text": "今年のリスト。たくさんのものが"}, {"type": "subtitle", "time": 5650.669, "timestamp": "01:34:10", "text": "起こっていること 私はもう続けることができない"}, {"type": "subtitle", "time": 5658.47, "timestamp": "01:34:18", "text": "もの。はい、リアルタイム翻訳です。うん。"}, {"type": "subtitle", "time": 5660.87, "timestamp": "01:34:20", "text": "これはビリービリーの人々が持っているものです"}, {"type": "subtitle", "time": 5663.31, "timestamp": "01:34:23", "text": "に"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "苦しむ。ビリーはこれが何なのか調べている。"}, {"type": "subtitle", "time": 5675.35, "timestamp": "01:34:35", "text": "もの。ようこそ、ブラッド。ようこそ"}, {"type": "subtitle", "time": 5678.35, "timestamp": "01:34:38", "text": "ストリーム。お元気でお過ごしでしょうか。こんにちは。"}, {"type": "subtitle", "time": 5681.669, "timestamp": "01:34:41", "text": "こんにちは。ああ、これは痛みだ、そして君も知っている"}, {"type": "subtitle", "time": 5684.47, "timestamp": "01:34:44", "text": "言語の壁が原因です。いいえ、"}, {"type": "subtitle", "time": 5687.03, "timestamp": "01:34:47", "text": "信じられないことに、人々はこれを読んで"}, {"type": "subtitle", "time": 5690.39, "timestamp": "01:34:50", "text": "彼らは、ジョッキーが何か言ったと思う"}, {"type": "subtitle", "time": 5692.87, "timestamp": "01:34:52", "text": "キャンセルすべきではなかった、"}, {"type": "subtitle", "time": 5695.83, "timestamp": "01:34:55", "text": "何か、あるいは何か。でも私は"}]
[{"type": "subtitle", "time": 6240.669, "timestamp": "01:44:00", "text": "マスコットがいない"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "えーと、公式のマ・コンステラーかジョックニック"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "マスコットはまだ決まってないよね？ファンはいません"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "マスコットはまだですよね？だから、私たちは"}, {"type": "subtitle", "time": 6257.03, "timestamp": "01:44:17", "text": "ええ、それは可能です。わからない。それ"}, {"type": "subtitle", "time": 6259.99, "timestamp": "01:44:19", "text": "つまり、それはその時の未来の自分のためだ"}, {"type": "subtitle", "time": 6262.31, "timestamp": "01:44:22", "text": "私はより多くのリソースを持ち、"}, {"type": "subtitle", "time": 6265.07, "timestamp": "01:44:25", "text": "すべて"}, {"type": "subtitle", "time": 6268.03, "timestamp": "01:44:28", "text": "えっと"}, {"type": "subtitle", "time": 6271.39, "timestamp": "01:44:31", "text": "ええ、おそらくそうでしょう"}, {"type": "subtitle", "time": 6273.59, "timestamp": "01:44:33", "text": "ビリーのサブスクライバー数はそれくらいだよ"}, {"type": "subtitle", "time": 6275.91, "timestamp": "01:44:35", "text": "ビリーは今まで、つまり、それほどでもない"}, {"type": "subtitle", "time": 6277.07, "timestamp": "01:44:37", "text": "多くの"}, {"type": "subtitle", "time": 6281.03, "timestamp": "01:44:41", "text": "ええと、メインチャンネルは"}, {"type": "subtitle", "time": 6282.27, "timestamp": "01:44:42", "text": "これは新しい"}, {"type": "subtitle", "time": 6285.109, "timestamp": "01:44:45", "text": "メインチャンネルは新しいチャンネルなので"}, {"type": "subtitle", "time": 6289.189, "timestamp": "01:44:49", "text": "それは一種の列車のようなもので、人々は必要とする"}, {"type": "subtitle", "time": 6293.03, "timestamp": "01:44:53", "text": "私を見つけるために。いいえ。ええ。うん。だから私は"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "数字で言うと、"}, {"type": "subtitle", "time": 6298.83, "timestamp": "01:44:58", "text": "問題ないけどそれでも"}]
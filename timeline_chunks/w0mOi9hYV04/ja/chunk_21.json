[{"type": "subtitle", "time": 1260.789, "timestamp": "00:21:00", "text": "チャネル。なぜだめですか？しかし、もし私たちが"}, {"type": "subtitle", "time": 1263.59, "timestamp": "00:21:03", "text": "バリカンか何かで、私は作業できます"}, {"type": "subtitle", "time": 1266.549, "timestamp": "00:21:06", "text": "彼らと一緒に公式に、えっと、"}, {"type": "subtitle", "time": 1270.39, "timestamp": "00:21:10", "text": "正式な公式短編シリーズ、そしておそらく"}, {"type": "subtitle", "time": 1272.39, "timestamp": "00:21:12", "text": "メインチャンネルにアップロードできます。私"}, {"type": "subtitle", "time": 1274.149, "timestamp": "00:21:14", "text": "わからない。"}, {"type": "subtitle", "time": 1276.47, "timestamp": "00:21:16", "text": "太陽が昇ると、彼らはVに潜ります。"}, {"type": "subtitle", "time": 1279.11, "timestamp": "00:21:19", "text": "うん、いいんじゃない？彼らにVにサブをさせよう"}, {"type": "subtitle", "time": 1281.909, "timestamp": "00:21:21", "text": "チャネル。つまり、Vチャンネルには"}, {"type": "subtitle", "time": 1285.35, "timestamp": "00:21:25", "text": "私が配信する他のすべての配信と同じように"}, {"type": "subtitle", "time": 1287.75, "timestamp": "00:21:27", "text": "他のすべてのプラットフォームでそうですよね？まるで"}, {"type": "subtitle", "time": 1290.19, "timestamp": "00:21:30", "text": "私はストリーミング配信しています"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "ストリーミング限定のものがどんな"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "V streamやkickなどのプラットフォーム"}, {"type": "subtitle", "time": 1298.87, "timestamp": "00:21:38", "text": "現実かビリービリー、それら全ては"}, {"type": "subtitle", "time": 1300.87, "timestamp": "00:21:40", "text": "今はボードに載っているけど、"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "ある意味ではカバーされているけど、そうでもない"}, {"type": "subtitle", "time": 1306.549, "timestamp": "00:21:46", "text": "何とかしなければならないことは分かっている"}, {"type": "subtitle", "time": 1310.39, "timestamp": "00:21:50", "text": "おそらく、経営陣が私を叱責するでしょう"}, {"type": "subtitle", "time": 1313.75, "timestamp": "00:21:53", "text": "そして、君は、えっと、スポーツマンになるだろう"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "あなたのスポーツ関連のものを宣伝するために"}, {"type": "subtitle", "time": 1319.669, "timestamp": "00:21:59", "text": "私は「うん、つまり、技術的には"}]
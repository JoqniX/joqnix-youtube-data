[{"type": "subtitle", "time": 11767.03, "timestamp": "03:16:07", "text": "なぜあなたはなぜ私を許さないのですか"}, {"type": "subtitle", "time": 11789.67, "timestamp": "03:16:29", "text": "エラー？いや、そんなことしないで。今私は"}, {"type": "subtitle", "time": 11791.67, "timestamp": "03:16:31", "text": "上下にスワイプできない"}, {"type": "subtitle", "time": 11800.269, "timestamp": "03:16:40", "text": "何？何"}, {"type": "subtitle", "time": 11802.83, "timestamp": "03:16:42", "text": "なぜできないのか"}, {"type": "subtitle", "time": 11806.57, "timestamp": "03:16:46", "text": "触る？ああ、充電中だからだよ。"}, {"type": "subtitle", "time": 11812.83, "timestamp": "03:16:52", "text": "[音楽]"}, {"type": "subtitle", "time": 11816.51, "timestamp": "03:16:56", "text": "ああ、これは何のエラーですか？"}, {"type": "subtitle", "time": 11819.63, "timestamp": "03:16:59", "text": "何？私"}]
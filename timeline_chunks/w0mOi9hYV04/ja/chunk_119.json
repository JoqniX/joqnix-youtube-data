[{"type": "subtitle", "time": 7140.87, "timestamp": "01:59:00", "text": "えーっと、つまり、その"}, {"type": "subtitle", "time": 7144.709, "timestamp": "01:59:04", "text": "今はもう、私の声です。えっと、その"}, {"type": "subtitle", "time": 7148.55, "timestamp": "01:59:08", "text": "私の声はちょっと紛らわしいです"}, {"type": "subtitle", "time": 7151.91, "timestamp": "01:59:11", "text": "視聴者の中には、"}, {"type": "subtitle", "time": 7154.39, "timestamp": "01:59:14", "text": "私が女の子だと、時々彼らは"}, {"type": "subtitle", "time": 7158.31, "timestamp": "01:59:18", "text": "僕は男の子です。理由がわからない。つまり"}, {"type": "subtitle", "time": 7161.669, "timestamp": "01:59:21", "text": "なぜアンドロジニーモデルが合うと思ったのか"}, {"type": "subtitle", "time": 7168.669, "timestamp": "01:59:28", "text": "私の声とジョック、だってジョックの次は私だから"}, {"type": "subtitle", "time": 7172.149, "timestamp": "01:59:32", "text": "Jockの背後にいる私自身"}, {"type": "subtitle", "time": 7176.43, "timestamp": "01:59:36", "text": "アバター。ええ、それで私はこう思ったんです"}, {"type": "subtitle", "time": 7179.83, "timestamp": "01:59:39", "text": "仕事。つまり、ジェンダムは関係ない"}, {"type": "subtitle", "time": 7183.43, "timestamp": "01:59:43", "text": "その人の性格と"}, {"type": "subtitle", "time": 7186.87, "timestamp": "01:59:46", "text": "感情とか、その他諸々の騒動"}, {"type": "subtitle", "time": 7195.189, "timestamp": "01:59:55", "text": "えっと、兄貴は武器の専門家だと思ってたんだけど"}, {"type": "subtitle", "time": 7196.75, "timestamp": "01:59:56", "text": "どれの"}]
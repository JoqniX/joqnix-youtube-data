[{"type": "subtitle", "time": 17880.19, "timestamp": "04:58:00", "text": "新たな問題が始まった"}, {"type": "subtitle", "time": 17882.948, "timestamp": "04:58:02", "text": "新しいコンテンツを作りたいという願望が表面化する。私は"}, {"type": "subtitle", "time": 17885.11, "timestamp": "04:58:05", "text": "面白くして、コンテンツも充実させる"}, {"type": "subtitle", "time": 17887.83, "timestamp": "04:58:07", "text": "ブロックとか、あなたがいた場所で"}, {"type": "subtitle", "time": 17890.868, "timestamp": "04:58:10", "text": "ああ、君は迷子になって混乱したんだね"}, {"type": "subtitle", "time": 17893.59, "timestamp": "04:58:13", "text": "どうすればもっと多くの人に見てもらえるでしょうか？"}, {"type": "subtitle", "time": 17897.35, "timestamp": "04:58:17", "text": "私などなど。それでもあなたはすべてを乗り越えた"}, {"type": "subtitle", "time": 17899.75, "timestamp": "04:58:19", "text": "あなたの旅路におけるその苦難と"}, {"type": "subtitle", "time": 17902.55, "timestamp": "04:58:22", "text": "それでもあなたは一生懸命戦い、あなたはすべて"}, {"type": "subtitle", "time": 17905.03, "timestamp": "04:58:25", "text": "今ここであなたが手に入れているのは"}, {"type": "subtitle", "time": 17908.47, "timestamp": "04:58:28", "text": "今は新しいタイプの課題がたくさんある。それで"}, {"type": "subtitle", "time": 17910.868, "timestamp": "04:58:30", "text": "こういうことが起こるたびに"}, {"type": "subtitle", "time": 17913.47, "timestamp": "04:58:33", "text": "ポジティブな人生の中でそれを見てください"}, {"type": "subtitle", "time": 17917.27, "timestamp": "04:58:37", "text": "ライト。それをポジティブに捉えると"}, {"type": "subtitle", "time": 17920.31, "timestamp": "04:58:40", "text": "ええ、こういうことが起こっています。何ができるのか"}, {"type": "subtitle", "time": 17922.948, "timestamp": "04:58:42", "text": "今すぐそれについてどうすべきか？それよりも"}, {"type": "subtitle", "time": 17926.31, "timestamp": "04:58:46", "text": "泣き崩れる。もちろん、"}, {"type": "subtitle", "time": 17929.03, "timestamp": "04:58:49", "text": "泣いたり、泣いたりできるよ。思いっきり泣いて。私"}, {"type": "subtitle", "time": 17930.788, "timestamp": "04:58:50", "text": "辛いなら泣くことをお勧めします"}, {"type": "subtitle", "time": 17933.19, "timestamp": "04:58:53", "text": "過度に。泣き疲れた後、"}, {"type": "subtitle", "time": 17935.91, "timestamp": "04:58:55", "text": "落ち着いて、よく考えてみて。何ができるのか"}, {"type": "subtitle", "time": 17939.39, "timestamp": "04:58:59", "text": "私は今まさにそうしています、まさに"}]
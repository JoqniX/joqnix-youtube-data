[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "えっと、たぶん29か"}, {"type": "subtitle", "time": 6305.27, "timestamp": "01:45:05", "text": "何か、船内チャンネルと"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "今のものはどんな感じですか"}, {"type": "subtitle", "time": 6312.149, "timestamp": "01:45:12", "text": "ええと、18。ええ、徐々に追いついてきています"}, {"type": "subtitle", "time": 6315.55, "timestamp": "01:45:15", "text": "どのチャンネルですか。そう、ゆっくりと"}, {"type": "subtitle", "time": 6318.07, "timestamp": "01:45:18", "text": "ゆっくり。そうだけど、そうだね、"}, {"type": "subtitle", "time": 6320.109, "timestamp": "01:45:20", "text": "最終的に"}, {"type": "subtitle", "time": 6323.189, "timestamp": "01:45:23", "text": "そこには。ああ、でもそれを見て嬉しいよ"}, {"type": "subtitle", "time": 6327.39, "timestamp": "01:45:27", "text": "彼らは毎日、いや、毎日、"}, {"type": "subtitle", "time": 6330.55, "timestamp": "01:45:30", "text": "YouTube の人たちと同じように、"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "Twitchのことですよね？君たちはどうやって私を見ているの？"}, {"type": "subtitle", "time": 6336.55, "timestamp": "01:45:36", "text": "私が文字通り発表するとき"}, {"type": "subtitle", "time": 6339.629, "timestamp": "01:45:39", "text": "事前準備なしで今すぐストリーミング"}, {"type": "subtitle", "time": 6342.229, "timestamp": "01:45:42", "text": "事前発表の事前発表。えーと"}, {"type": "subtitle", "time": 6344.07, "timestamp": "01:45:44", "text": "私がただ配信しているところに、あなたがやって来たとき。"}, {"type": "subtitle", "time": 6345.39, "timestamp": "01:45:45", "text": "うん、そんな感じ"}, {"type": "subtitle", "time": 6347.47, "timestamp": "01:45:47", "text": "それ。私は嬉しい"}, {"type": "subtitle", "time": 6350.149, "timestamp": "01:45:50", "text": "あちらにもいくつかあります"}, {"type": "subtitle", "time": 6351.669, "timestamp": "01:45:51", "text": "人々"}, {"type": "subtitle", "time": 6353.91, "timestamp": "01:45:53", "text": "えーと、積極的にやって来る人たち"}, {"type": "subtitle", "time": 6356.95, "timestamp": "01:45:56", "text": "彼らは英語があまり得意ではないが。"}, {"type": "subtitle", "time": 6359.75, "timestamp": "01:45:59", "text": "彼らは「ああ、君のことは見守るよ」と言う。"}]
[{"type": "subtitle", "time": 8163.64, "timestamp": "02:16:03", "text": "でも私が言えるのは、ヨキは"}, {"type": "subtitle", "time": 8175.47, "timestamp": "02:16:15", "text": "そして、今日私が言ったことは何でも"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "えっと、それは自分の中に留めておいてください。グッズとか"}, {"type": "subtitle", "time": 8182.069, "timestamp": "02:16:22", "text": "それはたぶん、私は確認していません"}, {"type": "subtitle", "time": 8185.51, "timestamp": "02:16:25", "text": "それに関するものがたくさんあって"}, {"type": "subtitle", "time": 8187.669, "timestamp": "02:16:27", "text": "えーと、商品があるなら、一つだけ"}, {"type": "subtitle", "time": 8189.87, "timestamp": "02:16:29", "text": "私が言えることは"}, {"type": "subtitle", "time": 8193.87, "timestamp": "02:16:33", "text": "商品に関しては"}, {"type": "subtitle", "time": 8197.27, "timestamp": "02:16:37", "text": "オネクシアの伝承ストーリーのようなもの"}, {"type": "subtitle", "time": 8199.87, "timestamp": "02:16:39", "text": "オネクシアの世界のものが"}, {"type": "subtitle", "time": 8203.11, "timestamp": "02:16:43", "text": "別々で、VTuberのスポーツ関連のものは"}, {"type": "subtitle", "time": 8207.389, "timestamp": "02:16:47", "text": "別。わかった。だから私は宣伝しなければならない"}, {"type": "subtitle", "time": 8211.669, "timestamp": "02:16:51", "text": "オニクシアのグッズやその他諸々"}, {"type": "subtitle", "time": 8214.87, "timestamp": "02:16:54", "text": "商品は別々に"}, {"type": "subtitle", "time": 8217.589, "timestamp": "02:16:57", "text": "ええと、Joubing のものは完全に"}]
[{"type": "subtitle", "time": 10204.429, "timestamp": "02:50:04", "text": "料理。ええ、お皿を洗って、"}, {"type": "subtitle", "time": 10207.429, "timestamp": "02:50:07", "text": "お茶とか、そういう類のもの全部。手助けするだけ"}, {"type": "subtitle", "time": 10208.99, "timestamp": "02:50:08", "text": "と共に"}, {"type": "subtitle", "time": 10212.59, "timestamp": "02:50:12", "text": "家族が"}, {"type": "subtitle", "time": 10218.67, "timestamp": "02:50:18", "text": "所有"}, {"type": "subtitle", "time": 10221.269, "timestamp": "02:50:21", "text": "上。曲をいくつか削除する必要があるかもしれません"}, {"type": "subtitle", "time": 10226.309, "timestamp": "02:50:26", "text": "列。選択する方法はありますか？"}, {"type": "subtitle", "time": 10229.83, "timestamp": "02:50:29", "text": "SpotifyのQリストから曲を選択する"}, {"type": "subtitle", "time": 10232.11, "timestamp": "02:50:32", "text": "代わりに削除する"}, {"type": "subtitle", "time": 10234.83, "timestamp": "02:50:34", "text": "クリックする"}, {"type": "subtitle", "time": 10236.67, "timestamp": "02:50:36", "text": "ゆっくり？私"}, {"type": "subtitle", "time": 10240.19, "timestamp": "02:50:40", "text": "ベッドから出なかったのが不思議だ"}, {"type": "subtitle", "time": 10243.51, "timestamp": "02:50:43", "text": "今日。それは私が"}, {"type": "subtitle", "time": 10247.429, "timestamp": "02:50:47", "text": "昔はすごく怠け者で、ベッドでくつろいでいた"}, {"type": "subtitle", "time": 10250.07, "timestamp": "02:50:50", "text": "YouTubeを見たり、アニメを見たり"}, {"type": "subtitle", "time": 10251.469, "timestamp": "02:50:51", "text": "視聴中"}]
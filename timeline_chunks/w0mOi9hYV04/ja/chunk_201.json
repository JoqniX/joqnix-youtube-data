[{"type": "subtitle", "time": 12060.87, "timestamp": "03:21:00", "text": "ついに。あ、待って。わかった。では、私がどのように"}, {"type": "subtitle", "time": 12063.389, "timestamp": "03:21:03", "text": "それは"}, {"type": "subtitle", "time": 12071.87, "timestamp": "03:21:11", "text": "待って。私の場合はこうです"}, {"type": "subtitle", "time": 12074.99, "timestamp": "03:21:14", "text": "ええと、それでは。おお、"}, {"type": "subtitle", "time": 12078.11, "timestamp": "03:21:18", "text": "待って。それで、"}, {"type": "subtitle", "time": 12081.75, "timestamp": "03:21:21", "text": "ここにモニターが1台あります。"}, {"type": "subtitle", "time": 12101.55, "timestamp": "03:21:41", "text": "もう一つ"}, {"type": "subtitle", "time": 12105.349, "timestamp": "03:21:45", "text": "モニター。閉鎖されたとは言えません。わかった。"}, {"type": "subtitle", "time": 12108.95, "timestamp": "03:21:48", "text": "これは、これはメインです"}]
[{"type": "subtitle", "time": 18480.07, "timestamp": "05:08:00", "text": "この世界で、このことにおいて、あなたよりも"}, {"type": "chat", "time": 18483.271, "timestamp": "05:08:03", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "🫠"}, {"type": "subtitle", "time": 18483.59, "timestamp": "05:08:03", "text": "右派の若い世代などなど"}, {"type": "subtitle", "time": 18485.51, "timestamp": "05:08:05", "text": "いつもそうであるように"}, {"type": "subtitle", "time": 18489.11, "timestamp": "05:08:09", "text": "競争ですね。そこで私がお勧めするのは"}, {"type": "subtitle", "time": 18493.67, "timestamp": "05:08:13", "text": "常に過去の自分と比較する"}, {"type": "subtitle", "time": 18496.11, "timestamp": "05:08:16", "text": "あなた"}, {"type": "chat", "time": 18496.216, "timestamp": "05:08:16", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "true 🤧"}, {"type": "subtitle", "time": 18499.67, "timestamp": "05:08:19", "text": "今日。今日のあなたは誰ですか？どうすれば"}, {"type": "subtitle", "time": 18502.03, "timestamp": "05:08:22", "text": "あなたが作る"}, {"type": "subtitle", "time": 18505.27, "timestamp": "05:08:25", "text": "より良い？今日のあなたのように、"}, {"type": "subtitle", "time": 18508.55, "timestamp": "05:08:28", "text": "昨日、ここ数ヶ月間など"}, {"type": "subtitle", "time": 18512.43, "timestamp": "05:08:32", "text": "自己分析をしてみましょう"}, {"type": "subtitle", "time": 18514.948, "timestamp": "05:08:34", "text": "あなた自身。どのような改善が可能か見てみましょう"}, {"type": "subtitle", "time": 18518.15, "timestamp": "05:08:38", "text": "現実世界でチューブを使ってあなたの人生を作ることができますか？"}, {"type": "subtitle", "time": 18521.35, "timestamp": "05:08:41", "text": "賢い。コンテンツを改善するにはどうすれば良いでしょうか？"}, {"type": "subtitle", "time": 18523.83, "timestamp": "05:08:43", "text": "自分の配信を見たりとか"}, {"type": "subtitle", "time": 18525.99, "timestamp": "05:08:45", "text": "そしてレビューして、「ああ、私は"}, {"type": "subtitle", "time": 18528.788, "timestamp": "05:08:48", "text": "「これをより良くした」など。さあ、書いてください。"}, {"type": "subtitle", "time": 18531.11, "timestamp": "05:08:51", "text": "下。今後の配信でもそうしてください。"}, {"type": "subtitle", "time": 18533.55, "timestamp": "05:08:53", "text": "次の日、ストリーミング配信をやってみて"}, {"type": "chat", "time": 18537.615, "timestamp": "05:08:57", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "and shatters you for a while"}, {"type": "subtitle", "time": 18538.55, "timestamp": "05:08:58", "text": "より良い。ああ、私は作った、私は作った、私は作った"}]
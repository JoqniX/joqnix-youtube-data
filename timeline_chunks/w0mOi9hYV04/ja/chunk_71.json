[{"type": "subtitle", "time": 4269.11, "timestamp": "01:11:09", "text": "ええ、翻訳が壊れています"}, {"type": "subtitle", "time": 4272.87, "timestamp": "01:11:12", "text": "ほら、これが私が受け入れざるを得ない現実なんだ。"}, {"type": "subtitle", "time": 4275.669, "timestamp": "01:11:15", "text": "そしてそれは主に私の"}, {"type": "subtitle", "time": 4279.75, "timestamp": "01:11:19", "text": "アクセントとか、何でもいいんだけど。えっと、犬に教えてください"}, {"type": "subtitle", "time": 4282.189, "timestamp": "01:11:22", "text": "スクーターとスクーティーはどちらですか？それは"}, {"type": "subtitle", "time": 4284.669, "timestamp": "01:11:24", "text": "スクーター？質問。"}, {"type": "subtitle", "time": 4287.69, "timestamp": "01:11:27", "text": "待って。スクーティ。とは"}, {"type": "subtitle", "time": 4289.47, "timestamp": "01:11:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4304.149, "timestamp": "01:11:44", "text": "あらら。軽量装備。ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 4306.63, "timestamp": "01:11:46", "text": "わかった。たぶんコディだと思う。うん。新世代"}, {"type": "subtitle", "time": 4309.189, "timestamp": "01:11:49", "text": "えっと、新世代のやつ。新世代バイク"}, {"type": "subtitle", "time": 4311.51, "timestamp": "01:11:51", "text": "自動車はスクーティーと呼ばれ、"}, {"type": "subtitle", "time": 4314.47, "timestamp": "01:11:54", "text": "推測。うん。"}]
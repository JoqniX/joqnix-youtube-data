[{"type": "subtitle", "time": 8221.07, "timestamp": "02:17:01", "text": "違う。いつものように"}, {"type": "subtitle", "time": 8224.389, "timestamp": "02:17:04", "text": "チューブチューブ系のユーチューバーグッズ"}, {"type": "subtitle", "time": 8227.589, "timestamp": "02:17:07", "text": "まあ、そういう類のものだと思う。"}, {"type": "subtitle", "time": 8237.91, "timestamp": "02:17:17", "text": "はい。でも、そう、もう一方になるだろう"}, {"type": "subtitle", "time": 8240.309, "timestamp": "02:17:20", "text": "裏面。わかった。私はしていません"}, {"type": "subtitle", "time": 8242.629, "timestamp": "02:17:22", "text": "それで確認しましたが、"}, {"type": "subtitle", "time": 8247.509, "timestamp": "02:17:27", "text": "かなりの仕事量だ。仕事がたくさんある"}, {"type": "subtitle", "time": 8250.75, "timestamp": "02:17:30", "text": "それ。だから私はあまり多くを語れない"}, {"type": "subtitle", "time": 8253.75, "timestamp": "02:17:33", "text": "残念ながら、すべてが"}, {"type": "subtitle", "time": 8263.549, "timestamp": "02:17:43", "text": "ビッシュ。でも、私は"}, {"type": "subtitle", "time": 8270.91, "timestamp": "02:17:50", "text": "良い。"}]
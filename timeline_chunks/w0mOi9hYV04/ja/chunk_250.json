[{"type": "subtitle", "time": 15003.71, "timestamp": "04:10:03", "text": "私たちはコラボレーションをしています。そして"}, {"type": "subtitle", "time": 15007.07, "timestamp": "04:10:07", "text": "木曜日、木曜日"}, {"type": "subtitle", "time": 15010.67, "timestamp": "04:10:10", "text": "9 ニャーと"}, {"type": "subtitle", "time": 15013.87, "timestamp": "04:10:13", "text": "ミッチ。私たちは"}, {"type": "subtitle", "time": 15017.389, "timestamp": "04:10:17", "text": "ああ、そうだね。リポジトリのチェックをしなければならない。"}, {"type": "subtitle", "time": 15021.389, "timestamp": "04:10:21", "text": "ああ、それは確認しないと。"}, {"type": "subtitle", "time": 15024.75, "timestamp": "04:10:24", "text": "えっと、DMで連絡しないといけませんね。"}, {"type": "subtitle", "time": 15034.87, "timestamp": "04:10:34", "text": "ということで、金曜日。あ、待って。金曜日。土曜日。"}, {"type": "subtitle", "time": 15038.83, "timestamp": "04:10:38", "text": "土曜日。私たちは北と一緒です。"}, {"type": "subtitle", "time": 15040.88, "timestamp": "04:10:40", "text": "考え。"}]
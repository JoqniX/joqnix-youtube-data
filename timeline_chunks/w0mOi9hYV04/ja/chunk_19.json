[{"type": "subtitle", "time": 1141.83, "timestamp": "00:19:01", "text": "えーと、つまり、もちろんそうなるでしょう"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "他の形式と同じように、でも私が"}, {"type": "subtitle", "time": 1148.31, "timestamp": "00:19:08", "text": "以前はそうしていたし、何人かの人がそれに倣った"}, {"type": "subtitle", "time": 1153.669, "timestamp": "00:19:13", "text": "Twitchでプラチナをもらうために、"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "ええと、特にYouTubeの"}, {"type": "subtitle", "time": 1159.83, "timestamp": "00:19:19", "text": "技術的なことですね。ええと、私たちは"}, {"type": "subtitle", "time": 1163.35, "timestamp": "00:19:23", "text": "もうそれができないモイシュは、えーと"}, {"type": "subtitle", "time": 1166.95, "timestamp": "00:19:26", "text": "だって、そう感じたから"}, {"type": "subtitle", "time": 1170.23, "timestamp": "00:19:30", "text": "退屈で技術的すぎるが、"}, {"type": "subtitle", "time": 1174.23, "timestamp": "00:19:34", "text": "将来、私はそれを取り戻すことができる"}, {"type": "subtitle", "time": 1176.47, "timestamp": "00:19:36", "text": "ショート動画や教育コンテンツ"}, {"type": "subtitle", "time": 1179.99, "timestamp": "00:19:39", "text": "それ。ええ、たぶんこうすればいいと思います"}, {"type": "subtitle", "time": 1181.63, "timestamp": "00:19:41", "text": "それ。なぜ"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "ない？そうやってやればいいんです。なぜだめですか？"}, {"type": "subtitle", "time": 1186.27, "timestamp": "00:19:46", "text": "うん。うん。"}, {"type": "subtitle", "time": 1191.19, "timestamp": "00:19:51", "text": "うん。こんにちは、ヒエン。いらっしゃいませ。私は、スポーツマンです"}, {"type": "subtitle", "time": 1193.23, "timestamp": "00:19:53", "text": "遭遇した"}, {"type": "subtitle", "time": 1196.51, "timestamp": "00:19:56", "text": "250米ドル以上"}, {"type": "subtitle", "time": 1198.27, "timestamp": "00:19:58", "text": "音楽。"}, {"type": "subtitle", "time": 1199.95, "timestamp": "00:19:59", "text": "何？"}]
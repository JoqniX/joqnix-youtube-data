[{"type": "subtitle", "time": 17343.07, "timestamp": "04:49:03", "text": "彼らが知らずにしたことに対して"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "そう、そう、だってまた、私はいくつか知ってるから"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "あるストリームで、つまり私は個人的に"}, {"type": "subtitle", "time": 17356.948, "timestamp": "04:49:16", "text": "まだ取り込んでないけど、うん、いくつか"}, {"type": "subtitle", "time": 17358.868, "timestamp": "04:49:18", "text": "ストリーマーコミュニティとか"}, {"type": "subtitle", "time": 17360.868, "timestamp": "04:49:20", "text": "人々は配信者をいじめようとする"}, {"type": "subtitle", "time": 17363.03, "timestamp": "04:49:23", "text": "などなど。すべては楽しいゲームですが"}, {"type": "subtitle", "time": 17365.67, "timestamp": "04:49:25", "text": "時々、誰かをいじめると"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "やりすぎで、からかって、"}, {"type": "subtitle", "time": 17371.67, "timestamp": "04:49:31", "text": "笑いすぎだよ、もし君がそれをしたら"}, {"type": "subtitle", "time": 17376.07, "timestamp": "04:49:36", "text": "多すぎると、あなたは感じます"}, {"type": "subtitle", "time": 17378.708, "timestamp": "04:49:38", "text": "壊れた。いや、まるで彼らがあなたを連れて行くようなものだ"}, {"type": "subtitle", "time": 17382.07, "timestamp": "04:49:42", "text": "えっと、君を何事もないかのように見るとか、"}, {"type": "subtitle", "time": 17385.03, "timestamp": "04:49:45", "text": "あなたを光か何かと勘違いしている。できた"}, {"type": "subtitle", "time": 17387.19, "timestamp": "04:49:47", "text": "私は言葉が苦手ですが、"}, {"type": "chat", "time": 17389.523, "timestamp": "04:49:49", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}, {"type": "subtitle", "time": 17390.07, "timestamp": "04:49:50", "text": "私が言いたいこと、分かりますよね？私"}, {"type": "subtitle", "time": 17391.67, "timestamp": "04:49:51", "text": "あなたが私の意図を理解してくれることを願っています"}]
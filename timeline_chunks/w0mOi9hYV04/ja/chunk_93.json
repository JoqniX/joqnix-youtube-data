[{"type": "subtitle", "time": 5582.27, "timestamp": "01:33:02", "text": "7月26日に私の家へ。こんにちは。"}, {"type": "subtitle", "time": 5590.189, "timestamp": "01:33:10", "text": "何？私自身は韓国人です。あらら。こんにちは、私は信じています"}, {"type": "subtitle", "time": 5596.09, "timestamp": "01:33:16", "text": "えっと、つまり今年はたぶん"}, {"type": "subtitle", "time": 5599.07, "timestamp": "01:33:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5602.87, "timestamp": "01:33:22", "text": "今年は、もっと"}, {"type": "subtitle", "time": 5604.51, "timestamp": "01:33:24", "text": "で"}, {"type": "subtitle", "time": 5608.79, "timestamp": "01:33:28", "text": "なぜ今、寒気を感じるのだろう？えっと"}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "なぜ私の「おやすみモード」がオンになっているのですか？"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "オンではありません。わかった。"}, {"type": "subtitle", "time": 5616.51, "timestamp": "01:33:36", "text": "私の電話の音を聞きましたか？"}, {"type": "subtitle", "time": 5619.35, "timestamp": "01:33:39", "text": "曲？デフォルトのSamsung Galaxyは"}, {"type": "subtitle", "time": 5623.07, "timestamp": "01:33:43", "text": "サムスン"}, {"type": "subtitle", "time": 5627.59, "timestamp": "01:33:47", "text": "何をしているの？うん。えっと、このあたりだと思います"}, {"type": "subtitle", "time": 5636.709, "timestamp": "01:33:56", "text": "ええと、おそらく商品でしょう。何かわからない"}, {"type": "subtitle", "time": 5639.91, "timestamp": "01:33:59", "text": "一種のグッズですね。えっと"}]
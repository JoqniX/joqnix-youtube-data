[{"type": "subtitle", "time": 10140.389, "timestamp": "02:49:00", "text": "あの男。私は今でもPTSDを抱えています。あれは何でしょう"}, {"type": "subtitle", "time": 10142.75, "timestamp": "02:49:02", "text": "ゲーム？私は"}, {"type": "subtitle", "time": 10146.389, "timestamp": "02:49:06", "text": "男。いい試合だったと思う。私"}, {"type": "subtitle", "time": 10164.429, "timestamp": "02:49:24", "text": "ゆっくり。はぁ？それでは、"}, {"type": "subtitle", "time": 10166.11, "timestamp": "02:49:26", "text": "何か。"}, {"type": "subtitle", "time": 10169.75, "timestamp": "02:49:29", "text": "えっと、何か良いことがあったんですか？"}, {"type": "subtitle", "time": 10174.349, "timestamp": "02:49:34", "text": "今日の男たち？何か良い行いをしましたか？"}, {"type": "subtitle", "time": 10177.75, "timestamp": "02:49:37", "text": "今日？まるで何でもあり得るかのように。手助けする"}, {"type": "subtitle", "time": 10180.79, "timestamp": "02:49:40", "text": "両親が家事をしたり、良いことをしたり"}, {"type": "subtitle", "time": 10186.23, "timestamp": "02:49:46", "text": "もの。うん。"}, {"type": "subtitle", "time": 10189.07, "timestamp": "02:49:49", "text": "今日は、ご存知の通りです。"}, {"type": "subtitle", "time": 10192.71, "timestamp": "02:49:52", "text": "ええ、それはあまり良くないでしょう"}, {"type": "subtitle", "time": 10195.75, "timestamp": "02:49:55", "text": "善行だけど、ちょっと手伝おうとしたんだけど"}, {"type": "subtitle", "time": 10197.469, "timestamp": "02:49:57", "text": "私の残高"}, {"type": "subtitle", "time": 10199.79, "timestamp": "02:49:59", "text": "今日は、"}]
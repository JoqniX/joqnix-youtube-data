[{"type": "subtitle", "time": 4982.07, "timestamp": "01:23:02", "text": "私たちがストリーミングしたりキックしたりするようなプラットフォーム"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "現実かビリービリー、それら全ては"}, {"type": "subtitle", "time": 4986.709, "timestamp": "01:23:06", "text": "今はボードに載っています。でもあなたは"}, {"type": "subtitle", "time": 4989.51, "timestamp": "01:23:09", "text": "ある意味ニンジンだけど、そうでもない"}, {"type": "subtitle", "time": 4992.47, "timestamp": "01:23:12", "text": "何とかしなければならないことは分かっている"}, {"type": "subtitle", "time": 4996.229, "timestamp": "01:23:16", "text": "おそらく、経営陣が私を叱責するでしょう"}, {"type": "subtitle", "time": 4999.669, "timestamp": "01:23:19", "text": "そして、君は、えっと、スポーツマンになるだろう"}, {"type": "subtitle", "time": 5003.35, "timestamp": "01:23:23", "text": "冗談を言うために、私はこう思う"}, {"type": "subtitle", "time": 5006.47, "timestamp": "01:23:26", "text": "ええ、つまり技術的にはボードまたは"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "メインチャンネルは私のものと同じになるので"}, {"type": "subtitle", "time": 5012.83, "timestamp": "01:23:32", "text": "今は私と繋がっているので大丈夫です"}, {"type": "subtitle", "time": 5015.75, "timestamp": "01:23:35", "text": "推測だけど、ああ、ついに私は行くよ"}, {"type": "subtitle", "time": 5018.629, "timestamp": "01:23:38", "text": "音楽トランスコードライセンスを250ドルで購入しました。"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "ちょっと顔が赤くなっちゃった。洗濯できて幸せです。"}, {"type": "subtitle", "time": 5022.99, "timestamp": "01:23:42", "text": "さあ"}, {"type": "subtitle", "time": 5026.149, "timestamp": "01:23:46", "text": "行く。さあ行こう。アイゼン、おめでとう。"}, {"type": "subtitle", "time": 5030.55, "timestamp": "01:23:50", "text": "ああ、なんて勤勉な人なんだ"}, {"type": "subtitle", "time": 5033.629, "timestamp": "01:23:53", "text": "音楽プロデューサー、ミュージシャン。あなたは私は"}, {"type": "subtitle", "time": 5037.99, "timestamp": "01:23:57", "text": "嬉しい。私たちは、音楽もすべて"}]
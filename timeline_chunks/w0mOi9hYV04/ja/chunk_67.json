[{"type": "subtitle", "time": 4024.19, "timestamp": "01:07:04", "text": "cm？"}, {"type": "subtitle", "time": 4027.43, "timestamp": "01:07:07", "text": "何？ああ、なんてことだ、あなたは私を"}, {"type": "subtitle", "time": 4030.069, "timestamp": "01:07:10", "text": "既に混乱を招いている。 10時です。"}, {"type": "subtitle", "time": 4033.23, "timestamp": "01:07:13", "text": "それはもっとそれは"}, {"type": "subtitle", "time": 4036.19, "timestamp": "01:07:16", "text": "えっと、もう寝る時間です。"}, {"type": "subtitle", "time": 4039.63, "timestamp": "01:07:19", "text": "わかった。早めに旅行する必要がある"}, {"type": "subtitle", "time": 4042.549, "timestamp": "01:07:22", "text": "明日、家に帰って、私の"}, {"type": "subtitle", "time": 4045.63, "timestamp": "01:07:25", "text": "SIMカード関連"}, {"type": "subtitle", "time": 4050.23, "timestamp": "01:07:30", "text": "整理済み。ええ、それが可能だといいのですが"}, {"type": "subtitle", "time": 4053.109, "timestamp": "01:07:33", "text": "SMS転送と通話転送"}, {"type": "subtitle", "time": 4055.19, "timestamp": "01:07:35", "text": "もし私がそうでないなら、ある数字から別の数字へ"}, {"type": "subtitle", "time": 4059.58, "timestamp": "01:07:39", "text": "そのSIMカードを私の携帯電話に入れることさえも。"}, {"type": "subtitle", "time": 4060.829, "timestamp": "01:07:40", "text": "[音楽]"}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "うん、うまくいっているといいんだけど。"}, {"type": "subtitle", "time": 4067.43, "timestamp": "01:07:47", "text": "ジオシムで可能、試してみた"}, {"type": "subtitle", "time": 4072.27, "timestamp": "01:07:52", "text": "シミュレーション。ええ、予約しました"}, {"type": "subtitle", "time": 4074.99, "timestamp": "01:07:54", "text": "シミュレーション。"}, {"type": "subtitle", "time": 4079.349, "timestamp": "01:07:59", "text": "仕事用にSIMカードを予約したんだけど、"}]
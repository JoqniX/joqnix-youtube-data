[{"type": "subtitle", "time": 10804.15, "timestamp": "03:00:04", "text": "このキャラクターがかわいそうに思える。いつでも"}, {"type": "subtitle", "time": 10808.07, "timestamp": "03:00:08", "text": "彼はジャンプして、まるで落ちたように、"}, {"type": "subtitle", "time": 10810.11, "timestamp": "03:00:10", "text": "ヒット"}, {"type": "subtitle", "time": 10815.469, "timestamp": "03:00:15", "text": "えーっと、彼は、彼が彼の"}, {"type": "subtitle", "time": 10820.429, "timestamp": "03:00:20", "text": "顔から落ちた。感じないで"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "強い？このキャラクターの強みは何ですか？"}, {"type": "subtitle", "time": 10833.03, "timestamp": "03:00:33", "text": "この決意を持って"}, {"type": "subtitle", "time": 10845.51, "timestamp": "03:00:45", "text": "精神的に、いや、ええ、精神的に"}, {"type": "subtitle", "time": 10847.59, "timestamp": "03:00:47", "text": "強くて、体力的にも強い。それが理由です"}, {"type": "subtitle", "time": 10855.55, "timestamp": "03:00:55", "text": "[音楽]"}]
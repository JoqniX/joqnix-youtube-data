[{"type": "subtitle", "time": 1862.47, "timestamp": "00:31:02", "text": "えっと、正直言ってちょっと怖いんです。えっと"}, {"type": "subtitle", "time": 1866.23, "timestamp": "00:31:06", "text": "待って、それって、えっと、無料で遊べるゲームなの？"}, {"type": "subtitle", "time": 1868.95, "timestamp": "00:31:08", "text": "疑問符。ああ、それは買わざるを得なかったんですね。"}, {"type": "subtitle", "time": 1871.75, "timestamp": "00:31:11", "text": "なるほど、どうやら買わないといけないみたいですね。"}, {"type": "subtitle", "time": 1877.149, "timestamp": "00:31:17", "text": "わかった、"}, {"type": "subtitle", "time": 1879.23, "timestamp": "00:31:19", "text": "理解できます。その"}, {"type": "subtitle", "time": 1882.99, "timestamp": "00:31:22", "text": "わかった。ソースを見ると"}, {"type": "subtitle", "time": 1886.07, "timestamp": "00:31:26", "text": "面白い。うん。こんにちは、ソール。ようこそ"}, {"type": "subtitle", "time": 1888.029, "timestamp": "00:31:28", "text": "ストリーム。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 1892.389, "timestamp": "00:31:32", "text": "良い。こんにちは。こんにちは。韓国で自分でジョギング"}, {"type": "subtitle", "time": 1896.35, "timestamp": "00:31:36", "text": "7月26日に私の家へ。こんにちは。"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "何？私自身は韓国人です。こんにちは。おお。こんにちは"}, {"type": "subtitle", "time": 1904.269, "timestamp": "00:31:44", "text": "信じる"}, {"type": "subtitle", "time": 1910.21, "timestamp": "00:31:50", "text": "えっと、つまり今年はたぶん"}, {"type": "subtitle", "time": 1913.23, "timestamp": "00:31:53", "text": "[音楽]"}, {"type": "subtitle", "time": 1917.029, "timestamp": "00:31:57", "text": "今年は、もっと"}, {"type": "subtitle", "time": 1918.59, "timestamp": "00:31:58", "text": "で"}]
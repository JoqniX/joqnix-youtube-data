[{"type": "subtitle", "time": 11160.309, "timestamp": "03:06:00", "text": "ストリーミング日 通常のストリーマーの日 I"}, {"type": "subtitle", "time": 11163.309, "timestamp": "03:06:03", "text": "以前は神学を日本語で行っていました"}, {"type": "subtitle", "time": 11166.469, "timestamp": "03:06:06", "text": "それ以降のことは、私は一切触れなかった。"}, {"type": "subtitle", "time": 11173.309, "timestamp": "03:06:13", "text": "でも私はたくさん観ました"}, {"type": "subtitle", "time": 11177.79, "timestamp": "03:06:17", "text": "ストリーマーと"}, {"type": "subtitle", "time": 11180.95, "timestamp": "03:06:20", "text": "えっと、日本の配信者。私は彼らと交流した"}, {"type": "subtitle", "time": 11182.87, "timestamp": "03:06:22", "text": "チャックから少しだけ、そして"}, {"type": "subtitle", "time": 11186.91, "timestamp": "03:06:26", "text": "私のアニメを使って"}, {"type": "subtitle", "time": 11189.07, "timestamp": "03:06:29", "text": "英語。"}, {"type": "subtitle", "time": 11192.389, "timestamp": "03:06:32", "text": "アニミッシュ。なんて名前だ。あるいはこう言うこともできます"}, {"type": "subtitle", "time": 11198.75, "timestamp": "03:06:38", "text": "vb バンまたは"}, {"type": "subtitle", "time": 11200.95, "timestamp": "03:06:40", "text": "何か。一度始めると楽しい"}, {"type": "subtitle", "time": 11202.63, "timestamp": "03:06:42", "text": "認識する"}, {"type": "subtitle", "time": 11205.429, "timestamp": "03:06:45", "text": "ええと、シンボルを認識することです。はい。学ぶ"}, {"type": "subtitle", "time": 11207.469, "timestamp": "03:06:47", "text": "読む。"}, {"type": "subtitle", "time": 11211.349, "timestamp": "03:06:51", "text": "わかった。それは何ですか？ああ、それは"}, {"type": "subtitle", "time": 11214.469, "timestamp": "03:06:54", "text": "その最初の文字。私はそうは思わない 私はそうは思わない"}, {"type": "subtitle", "time": 11217.07, "timestamp": "03:06:57", "text": "それが何だったか覚えておいてください。しかし"}]
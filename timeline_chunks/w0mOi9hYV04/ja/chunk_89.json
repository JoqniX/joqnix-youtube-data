[{"type": "subtitle", "time": 5340.55, "timestamp": "01:29:00", "text": "よし、いいね。教えてくれてありがとう"}, {"type": "subtitle", "time": 5343.03, "timestamp": "01:29:03", "text": "あなたの誕生日。覚えておこう"}, {"type": "subtitle", "time": 5345.55, "timestamp": "01:29:05", "text": "それ。"}, {"type": "subtitle", "time": 5349.35, "timestamp": "01:29:09", "text": "はい、Discordサーバーにいるなら、"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "おなじみのDiscordサーバーまたは"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "コンテル"}, {"type": "subtitle", "time": 5357.35, "timestamp": "01:29:17", "text": "えっと、つまり、全部同じサーバーなんです。"}, {"type": "subtitle", "time": 5360.709, "timestamp": "01:29:20", "text": "私はただ、それに面白い名前をつけているだけです。"}, {"type": "subtitle", "time": 5364.55, "timestamp": "01:29:24", "text": "ええ、誕生日を設定できます"}, {"type": "subtitle", "time": 5367.35, "timestamp": "01:29:27", "text": "ボット誕生日を使用する広告サーバー"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "ボット。だから、あなたは"}, {"type": "subtitle", "time": 5371.91, "timestamp": "01:29:31", "text": "公に発表します。はい、それはあなたのものです"}, {"type": "subtitle", "time": 5373.47, "timestamp": "01:29:33", "text": "それは私の"}, {"type": "subtitle", "time": 5376.709, "timestamp": "01:29:36", "text": "誕生日。えっと、君を僕の"}, {"type": "subtitle", "time": 5378.669, "timestamp": "01:29:38", "text": "誕生日"}, {"type": "subtitle", "time": 5389.79, "timestamp": "01:29:49", "text": "なぜ？何てことだ。ああ、"}, {"type": "subtitle", "time": 5392.39, "timestamp": "01:29:52", "text": "神。ああ、それは予想外だった"}, {"type": "subtitle", "time": 5393.55, "timestamp": "01:29:53", "text": "ガード。"}, {"type": "subtitle", "time": 5396.95, "timestamp": "01:29:56", "text": "わかった。えっと、こんにちは、そして、私のじゃないので嬉しいです"}, {"type": "subtitle", "time": 5399.229, "timestamp": "01:29:59", "text": "誕生日ですが、誰であれ"}]
[{"type": "subtitle", "time": 960.87, "timestamp": "00:16:00", "text": "何かが起こって、"}, {"type": "subtitle", "time": 964.629, "timestamp": "00:16:04", "text": "まもなく起こる"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "それは分からないので明かせない"}, {"type": "subtitle", "time": 971.749, "timestamp": "00:16:11", "text": "発売される正確な時間。えっと"}, {"type": "subtitle", "time": 975.509, "timestamp": "00:16:15", "text": "でも、もうすぐ来るって聞いてるんです。私は"}, {"type": "subtitle", "time": 978.269, "timestamp": "00:16:18", "text": "来ると言われている。"}, {"type": "subtitle", "time": 980.91, "timestamp": "00:16:20", "text": "うん。うん。"}, {"type": "subtitle", "time": 983.749, "timestamp": "00:16:23", "text": "ああ、本当にたくさんのことが起こっている。私は"}, {"type": "subtitle", "time": 985.99, "timestamp": "00:16:25", "text": "未来のことにワクワクしている。私はできません"}, {"type": "subtitle", "time": 990.749, "timestamp": "00:16:30", "text": "秘密を漏らしなさい。よし、脚だ。"}, {"type": "subtitle", "time": 993.949, "timestamp": "00:16:33", "text": "もしかしたらそれ以上かもしれない"}, {"type": "subtitle", "time": 998.55, "timestamp": "00:16:38", "text": "それ。わからない。えっと、私のモデルはなぜ"}, {"type": "subtitle", "time": 1001.91, "timestamp": "00:16:41", "text": "時々行き詰まる？ウェブサイト側。ああ、それもね。えっと"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "それはとても遅いでしょう"}, {"type": "subtitle", "time": 1008.389, "timestamp": "00:16:48", "text": "正直言って、進歩している。ウェブサイト関連"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "ゆっくりとした進展になるでしょう。えっと、でも"}, {"type": "subtitle", "time": 1014.069, "timestamp": "00:16:54", "text": "うん、いずれ手に入れるよ"}, {"type": "subtitle", "time": 1017.829, "timestamp": "00:16:57", "text": "まもなく作業開始。遅かれ早かれ。うん。"}]
[{"type": "subtitle", "time": 8702.11, "timestamp": "02:25:02", "text": "それ。時々そうするし、時々"}, {"type": "subtitle", "time": 8707.19, "timestamp": "02:25:07", "text": "やめてください。ええと、でも、そう、私は寝ました"}, {"type": "subtitle", "time": 8709.75, "timestamp": "02:25:09", "text": "ええと、正直に言うと2時半頃です。私はただ"}, {"type": "subtitle", "time": 8712.03, "timestamp": "02:25:12", "text": "ホラーゲームをプレイして"}, {"type": "subtitle", "time": 8719.75, "timestamp": "02:25:19", "text": "でも、私はまだ疑問に思っています"}, {"type": "subtitle", "time": 8722.23, "timestamp": "02:25:22", "text": "自分のチャンネルの動画を見たとき"}, {"type": "subtitle", "time": 8725.75, "timestamp": "02:25:25", "text": "ライブタブですね、動画がないですから。"}, {"type": "subtitle", "time": 8728.91, "timestamp": "02:25:28", "text": "ライブタブを見ると、"}, {"type": "subtitle", "time": 8730.06, "timestamp": "02:25:30", "text": "のように"}, {"type": "subtitle", "time": 8731.63, "timestamp": "02:25:31", "text": "[音楽]"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "h なんだか、h は"}, {"type": "subtitle", "time": 8737.87, "timestamp": "02:25:37", "text": "川の流れ"}, {"type": "subtitle", "time": 8739.79, "timestamp": "02:25:39", "text": "量？質問"}, {"type": "subtitle", "time": 8742.469, "timestamp": "02:25:42", "text": "マーク。ご存知のように、私たちは最近"}, {"type": "subtitle", "time": 8745.91, "timestamp": "02:25:45", "text": "1日に3、3、4回の配信。えーと"}, {"type": "subtitle", "time": 8747.99, "timestamp": "02:25:47", "text": "バレンタインデーとバレンタインデーの期間中。"}, {"type": "subtitle", "time": 8752.11, "timestamp": "02:25:52", "text": "だから私は、それも"}, {"type": "subtitle", "time": 8756.79, "timestamp": "02:25:56", "text": "多くの？つまり、えーと、私が、えーと、私が"}, {"type": "subtitle", "time": 8759.429, "timestamp": "02:25:59", "text": "ストリーミングしたくないときはストリーミングしない"}]
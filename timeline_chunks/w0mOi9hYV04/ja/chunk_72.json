[{"type": "subtitle", "time": 4323.82, "timestamp": "01:12:03", "text": "待って。ただ「ふむ」という感じ。見た目"}, {"type": "subtitle", "time": 4325.229, "timestamp": "01:12:05", "text": "[音楽]"}, {"type": "subtitle", "time": 4348.07, "timestamp": "01:12:28", "text": "わかった。あ、そういえば、もしあなたが"}, {"type": "subtitle", "time": 4351.669, "timestamp": "01:12:31", "text": "スクーターの種類やスクーターの種類を知りたい"}, {"type": "subtitle", "time": 4355.27, "timestamp": "01:12:35", "text": "あるいはそれが何であれ、私はそれを持っています。"}, {"type": "subtitle", "time": 4357.79, "timestamp": "01:12:37", "text": "テレビだと信じてください。待って、それは"}, {"type": "subtitle", "time": 4360.79, "timestamp": "01:12:40", "text": "テレビ？確かアクティバとかいうやつだったと思う。私"}, {"type": "subtitle", "time": 4362.709, "timestamp": "01:12:42", "text": "わからない。それは私が知っている名前です"}, {"type": "subtitle", "time": 4364.75, "timestamp": "01:12:44", "text": "木星または"}, {"type": "subtitle", "time": 4367.79, "timestamp": "01:12:47", "text": "何か。どれが"}, {"type": "subtitle", "time": 4371.75, "timestamp": "01:12:51", "text": "それ。 TVS Jupiterですか、それとも"}, {"type": "subtitle", "time": 4377.35, "timestamp": "01:12:57", "text": "それ以外？でも私のは青みがかった感じ"}, {"type": "subtitle", "time": 4379.709, "timestamp": "01:12:59", "text": "緑色か何か"}]
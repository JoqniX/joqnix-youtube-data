[{"type": "subtitle", "time": 18603.19, "timestamp": "05:10:03", "text": "あなたがプレイするゲーム。彼らがここにいる理由は"}, {"type": "subtitle", "time": 18605.628, "timestamp": "05:10:05", "text": "彼らはあなたのためにここにいるのです。のために"}, {"type": "subtitle", "time": 18609.03, "timestamp": "05:10:09", "text": "なぜなら彼らはあなたのことを知るのが好きだから、"}, {"type": "subtitle", "time": 18611.67, "timestamp": "05:10:11", "text": "あなたの性格、あなたのあり方など。"}, {"type": "chat", "time": 18613.729, "timestamp": "05:10:13", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Hm i get it :)"}, {"type": "subtitle", "time": 18613.91, "timestamp": "05:10:13", "text": "浮き沈み、あなたの幸せな瞬間、あなたの"}, {"type": "subtitle", "time": 18616.628, "timestamp": "05:10:16", "text": "悲しい瞬間、恥ずかしい瞬間、"}, {"type": "subtitle", "time": 18618.03, "timestamp": "05:10:18", "text": "など。"}, {"type": "subtitle", "time": 18620.27, "timestamp": "05:10:20", "text": "描写する"}, {"type": "subtitle", "time": 18622.55, "timestamp": "05:10:22", "text": "ストリームには、常に"}, {"type": "subtitle", "time": 18624.868, "timestamp": "05:10:24", "text": "あなたを支えてくれる人たち。"}, {"type": "subtitle", "time": 18625.948, "timestamp": "05:10:25", "text": "覚えて"}, {"type": "subtitle", "time": 18630.07, "timestamp": "05:10:30", "text": "それ。そして、ほとんどの人が"}, {"type": "subtitle", "time": 18633.43, "timestamp": "05:10:33", "text": "私たちはいつもネガティブな面を見ている"}, {"type": "subtitle", "time": 18634.67, "timestamp": "05:10:34", "text": "側。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "いや、君はいつもネガティブな面ばかり見ているんだ"}, {"type": "subtitle", "time": 18640.35, "timestamp": "05:10:40", "text": "そして良いことは忘れて、"}, {"type": "subtitle", "time": 18643.11, "timestamp": "05:10:43", "text": "右？たった一つの否定的なこと"}, {"type": "subtitle", "time": 18645.99, "timestamp": "05:10:45", "text": "それはあなたの心に深く刻まれるでしょう"}, {"type": "subtitle", "time": 18647.67, "timestamp": "05:10:47", "text": "なぜなら、それはあなたにも影響を与えるからです。それは"}, {"type": "subtitle", "time": 18649.15, "timestamp": "05:10:49", "text": "人間の本質。"}, {"type": "subtitle", "time": 18653.43, "timestamp": "05:10:53", "text": "いいえ、でも私たちは、えっと、見失ったり、"}, {"type": "subtitle", "time": 18656.43, "timestamp": "05:10:56", "text": "良いことに気づかない"}, {"type": "subtitle", "time": 18659.83, "timestamp": "05:10:59", "text": "時々。だから、もしあなたが学び始めたら"}]
[{"type": "subtitle", "time": 3001.91, "timestamp": "00:50:01", "text": "えっと、トフィーとかキャンディーみたいな。そういうことなんです"}, {"type": "subtitle", "time": 3004.39, "timestamp": "00:50:04", "text": "でも、もっと大きい、大きな、コインみたいな。"}, {"type": "subtitle", "time": 3006.95, "timestamp": "00:50:06", "text": "5ルピー硬貨。 5点満点中5点"}, {"type": "subtitle", "time": 3008.87, "timestamp": "00:50:08", "text": "ルピー硬貨のようなものタブレット"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "厚みがある。実際、厚みがある。うん。私はそれを置いた"}, {"type": "subtitle", "time": 3015.63, "timestamp": "00:50:15", "text": "水に入れると泡立ち、"}, {"type": "subtitle", "time": 3018.67, "timestamp": "00:50:18", "text": "実際、聞こえますか？"}, {"type": "subtitle", "time": 3023.79, "timestamp": "00:50:23", "text": "待って。えっと、シューッという音を聞きたいですか？"}, {"type": "subtitle", "time": 3027.109, "timestamp": "00:50:27", "text": "ASMR？待って、君を消火させてあげるよ"}, {"type": "subtitle", "time": 3030.309, "timestamp": "00:50:30", "text": "ASMR。ちょっと待ってください。少し時間をください。"}, {"type": "subtitle", "time": 3032.359, "timestamp": "00:50:32", "text": "少し時間をください。 待って。ああ、積み込め。おお、"}, {"type": "subtitle", "time": 3036.28, "timestamp": "00:50:36", "text": "待って。ああ、積み込め。おお、 わかった。待って、待って、待って、待って。その前に"}, {"type": "subtitle", "time": 3038.559, "timestamp": "00:50:38", "text": "わかった。待って、待って、待って、待って。その前に 勢いが衰えるのを防ぐ。"}, {"type": "subtitle", "time": 3047.27, "timestamp": "00:50:47", "text": "聞こえますか？それはとても多くの"}]
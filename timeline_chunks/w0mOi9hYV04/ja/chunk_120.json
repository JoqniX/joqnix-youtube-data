[{"type": "subtitle", "time": 7200.149, "timestamp": "02:00:00", "text": "冗談じゃないよ、聞いたことないよ"}, {"type": "subtitle", "time": 7202.95, "timestamp": "02:00:02", "text": "ページまたは単語、私はこれらすべてを"}, {"type": "subtitle", "time": 7206.43, "timestamp": "02:00:06", "text": "Java のように、コンピュータのように、"}, {"type": "subtitle", "time": 7209.27, "timestamp": "02:00:09", "text": "Apacheサーバーか何か"}, {"type": "subtitle", "time": 7215.83, "timestamp": "02:00:15", "text": "このジョークは意地悪なことでクロンのことを呼んでいます"}, {"type": "subtitle", "time": 7223.43, "timestamp": "02:00:23", "text": "現実は意地悪で残酷でとても"}, {"type": "subtitle", "time": 7230.55, "timestamp": "02:00:30", "text": "こんにちは、ヒーリーはインドでどんな"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "文章を書くとき、あなたは次のように使いますか"}, {"type": "subtitle", "time": 7236.149, "timestamp": "02:00:36", "text": "私は別の場所にいるので、それを着ています"}, {"type": "subtitle", "time": 7239.47, "timestamp": "02:00:39", "text": "えーと、ここは地元のブランドみたいなものです"}, {"type": "subtitle", "time": 7243.51, "timestamp": "02:00:43", "text": "えっと、テックネクストとかいう名前だったかな。"}, {"type": "subtitle", "time": 7248.75, "timestamp": "02:00:48", "text": "ルーターだけど、家に帰ったら、えっと、行かなきゃ"}, {"type": "subtitle", "time": 7251.669, "timestamp": "02:00:51", "text": "ルーター、うん、たぶん、私はこう思うだろう"}, {"type": "subtitle", "time": 7253.91, "timestamp": "02:00:53", "text": "シフト中は移動したり、"}, {"type": "subtitle", "time": 7256.83, "timestamp": "02:00:56", "text": "すぐにシフトしました"}]
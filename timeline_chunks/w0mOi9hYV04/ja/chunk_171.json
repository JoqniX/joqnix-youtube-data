[{"type": "subtitle", "time": 10260.67, "timestamp": "02:51:00", "text": "バンブランケットにくるまってぬくぬくと過ごす。"}, {"type": "subtitle", "time": 10261.79, "timestamp": "02:51:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10264.75, "timestamp": "02:51:04", "text": "ほら、私は愛してる"}, {"type": "subtitle", "time": 10267.75, "timestamp": "02:51:07", "text": "寄り添う。奇妙な事実を知っていますか"}, {"type": "subtitle", "time": 10270.55, "timestamp": "02:51:10", "text": "私について。自分が変なのは分かってるけど、変な"}, {"type": "subtitle", "time": 10272.269, "timestamp": "02:51:12", "text": "私についての事実"}, {"type": "subtitle", "time": 10275.23, "timestamp": "02:51:15", "text": "私が"}, {"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "睡眠中、時々、"}, {"type": "subtitle", "time": 10281.469, "timestamp": "02:51:21", "text": "いいよ、幸せ"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "モードは、ニャーニャー石をやって、行動します"}, {"type": "subtitle", "time": 10286.91, "timestamp": "02:51:26", "text": "猫のように"}, {"type": "subtitle", "time": 10288.83, "timestamp": "02:51:28", "text": "しかし、そして"}, {"type": "subtitle", "time": 10292.11, "timestamp": "02:51:32", "text": "もの。実際はアニメです"}, {"type": "subtitle", "time": 10294.91, "timestamp": "02:51:34", "text": "えっと、それは"}, {"type": "subtitle", "time": 10297.79, "timestamp": "02:51:37", "text": "えーと、私が表現したいこと"}, {"type": "subtitle", "time": 10300.429, "timestamp": "02:51:40", "text": "した。だから、"}, {"type": "subtitle", "time": 10302.349, "timestamp": "02:51:42", "text": "ギフト"}, {"type": "subtitle", "time": 10306.99, "timestamp": "02:51:46", "text": "それ。それを証明できるかどうかはわかりません"}]
[{"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "でも、ああ、そうだね。 10時30分になります。"}, {"type": "subtitle", "time": 4450.79, "timestamp": "01:14:10", "text": "10時30分までに配信を終了します。わかった。それで、"}, {"type": "subtitle", "time": 4453.11, "timestamp": "01:14:13", "text": "全部片付けて寝るよ"}, {"type": "subtitle", "time": 4456.07, "timestamp": "01:14:16", "text": "11時までに。"}, {"type": "subtitle", "time": 4460.709, "timestamp": "01:14:20", "text": "はい。はい。ええと、そうですね、"}, {"type": "subtitle", "time": 4462.709, "timestamp": "01:14:22", "text": "たくさんのことが起こるだろう"}, {"type": "subtitle", "time": 4465.709, "timestamp": "01:14:25", "text": "今後数ヶ月。私は"}, {"type": "subtitle", "time": 4468.79, "timestamp": "01:14:28", "text": "怖がった。怖くて嬉しいし、"}, {"type": "subtitle", "time": 4470.43, "timestamp": "01:14:30", "text": "同じことに怯えている"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "時間。だから、どうなるかはわかりません"}, {"type": "subtitle", "time": 4475.149, "timestamp": "01:14:35", "text": "行く、"}, {"type": "subtitle", "time": 4478.55, "timestamp": "01:14:38", "text": "しかし、私が言えるのは、あなたの騎手は"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "の"}, {"type": "subtitle", "time": 4485.95, "timestamp": "01:14:45", "text": "同じ。ええ、そうですね。"}, {"type": "subtitle", "time": 4490.75, "timestamp": "01:14:50", "text": "Dと、今日私が言ったことは何でも"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "えっと、それは自分の中に留めておいてください。グッズとか"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "たぶん、まだ確認していないので"}]
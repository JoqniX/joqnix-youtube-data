[{"type": "subtitle", "time": 6061.109, "timestamp": "01:41:01", "text": "皆さんに質の高いコンテンツを提供したい"}, {"type": "subtitle", "time": 6064.03, "timestamp": "01:41:04", "text": "それよりも"}, {"type": "subtitle", "time": 6068.99, "timestamp": "01:41:08", "text": "安い、安いもの"}, {"type": "subtitle", "time": 6072.39, "timestamp": "01:41:12", "text": "えーと、その他いろいろ。ええ、私はちょっと"}, {"type": "subtitle", "time": 6079.27, "timestamp": "01:41:19", "text": "ええと、iPhoneは持っているんですが、とても"}, {"type": "subtitle", "time": 6082.55, "timestamp": "01:41:22", "text": "床が熱い。ああ、もしあなたが"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "iPhoneをお持ちの場合は、"}, {"type": "subtitle", "time": 6087.43, "timestamp": "01:41:27", "text": "ホームボタン、だって君にはそれが必要なんだから"}, {"type": "subtitle", "time": 6090.47, "timestamp": "01:41:30", "text": "ホームボタンなしで。わかった。それで、えーと、"}, {"type": "subtitle", "time": 6093.35, "timestamp": "01:41:33", "text": "問題は、ショットを飲みたいんだけど、"}, {"type": "subtitle", "time": 6095.99, "timestamp": "01:41:35", "text": "今のところは私のVチャンネルで公開します。それで、"}, {"type": "subtitle", "time": 6098.31, "timestamp": "01:41:38", "text": "人々は最終的にVに加入するだろう"}, {"type": "subtitle", "time": 6100.27, "timestamp": "01:41:40", "text": "チャネル。私はみんなにVを購読してほしい"}, {"type": "subtitle", "time": 6102.55, "timestamp": "01:41:42", "text": "正直に言うと、チャンネルですね。私は"}, {"type": "subtitle", "time": 6105.83, "timestamp": "01:41:45", "text": "ハイライトやクリップをアップロードする"}, {"type": "subtitle", "time": 6108.59, "timestamp": "01:41:48", "text": "Wチャンネルのコンテンツ"}, {"type": "subtitle", "time": 6110.109, "timestamp": "01:41:50", "text": "今。"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "えっと、でも"}, {"type": "subtitle", "time": 6115.39, "timestamp": "01:41:55", "text": "[音楽]"}]
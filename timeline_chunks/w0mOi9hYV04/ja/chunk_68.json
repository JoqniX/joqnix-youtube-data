[{"type": "subtitle", "time": 4080.19, "timestamp": "01:08:00", "text": "運動選手"}, {"type": "subtitle", "time": 4083.029, "timestamp": "01:08:03", "text": "もの。数字が"}, {"type": "subtitle", "time": 4086.63, "timestamp": "01:08:06", "text": "誰に対しても、公共のために公開する。そうはならないだろう"}, {"type": "subtitle", "time": 4090.069, "timestamp": "01:08:10", "text": "公的なこととかではなく、むしろ"}, {"type": "subtitle", "time": 4093.87, "timestamp": "01:08:13", "text": "えっと、YouTuberとして"}, {"type": "subtitle", "time": 4096.95, "timestamp": "01:08:16", "text": "あなたは自分の個人情報を開示すべきではありません"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "スーパーになるまでは、IRLの詳細を誰にも教えません"}, {"type": "subtitle", "time": 4103.269, "timestamp": "01:08:23", "text": "誰かと親しい。うん。今年から"}, {"type": "subtitle", "time": 4104.749, "timestamp": "01:08:24", "text": "などなど、"}, {"type": "subtitle", "time": 4107.91, "timestamp": "01:08:27", "text": "私はこれまで多くのことを経験してきた。だから私は"}, {"type": "subtitle", "time": 4110.51, "timestamp": "01:08:30", "text": "セットアップを開始した"}, {"type": "subtitle", "time": 4113.749, "timestamp": "01:08:33", "text": "境界。だから私は、もしあるなら"}, {"type": "subtitle", "time": 4117.43, "timestamp": "01:08:37", "text": "もしそれが私、ジョックに関係することなら"}, {"type": "subtitle", "time": 4119.51, "timestamp": "01:08:39", "text": "彼らにスポーツマンをあげようと思う"}, {"type": "subtitle", "time": 4123.229, "timestamp": "01:08:43", "text": "電話番号、つまり仕事用の電話番号のことです。"}, {"type": "subtitle", "time": 4125.59, "timestamp": "01:08:45", "text": "番号。あなたはなぜ旅行していたのですか？"}, {"type": "subtitle", "time": 4127.95, "timestamp": "01:08:47", "text": "最近は家にいる時間がそんなに多いの？おお"}, {"type": "subtitle", "time": 4134.95, "timestamp": "01:08:54", "text": "また？あれ、なんで私は家に帰ったんだろう？"}, {"type": "subtitle", "time": 4137.149, "timestamp": "01:08:57", "text": "最近？"}]
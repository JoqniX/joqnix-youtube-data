[{"type": "subtitle", "time": 10081.99, "timestamp": "02:48:01", "text": "ベニー・フロイドのやつを試してみて。えっと"}, {"type": "subtitle", "time": 10085.19, "timestamp": "02:48:05", "text": "あれってなんていう名前だったっけ？えっと、その一つ"}, {"type": "subtitle", "time": 10088.15, "timestamp": "02:48:08", "text": "ハゲの男がいる"}, {"type": "subtitle", "time": 10091.51, "timestamp": "02:48:11", "text": "えっと、ポットみたいなやつで。スピードランをしたい"}, {"type": "subtitle", "time": 10095.87, "timestamp": "02:48:15", "text": "あるいは、そんな感じ。楽しいでしょう"}, {"type": "subtitle", "time": 10099.63, "timestamp": "02:48:19", "text": "ゲーム。遊びたい"}, {"type": "subtitle", "time": 10103.87, "timestamp": "02:48:23", "text": "それ。私はわざと蛇を連れて行きます"}, {"type": "subtitle", "time": 10122.91, "timestamp": "02:48:42", "text": "それ。取らせてください"}, {"type": "subtitle", "time": 10125.23, "timestamp": "02:48:45", "text": "上。それは長い"}, {"type": "subtitle", "time": 10127.469, "timestamp": "02:48:47", "text": "ジャンプ。大丈夫です。"}, {"type": "subtitle", "time": 10130.83, "timestamp": "02:48:50", "text": "大丈夫。それは短い"}, {"type": "subtitle", "time": 10132.87, "timestamp": "02:48:52", "text": "ジャンプ。本当にプレイしたいの？それ"}, {"type": "subtitle", "time": 10135.03, "timestamp": "02:48:55", "text": "なるほど。それはあなたを激怒させる。病気"}, {"type": "subtitle", "time": 10137.03, "timestamp": "02:48:57", "text": "いつでも、試してみることはできます。私はなりたい"}]
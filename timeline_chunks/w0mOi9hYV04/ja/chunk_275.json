[{"type": "subtitle", "time": 16502.39, "timestamp": "04:35:02", "text": "もう一度言ってください。地域の人々"}, {"type": "subtitle", "time": 16505.99, "timestamp": "04:35:05", "text": "私のコンサート会場を近くに置いたと信じています"}, {"type": "subtitle", "time": 16507.07, "timestamp": "04:35:07", "text": "もし"}, {"type": "subtitle", "time": 16510.07, "timestamp": "04:35:10", "text": "彼らは私の知らないところでそんなことをする"}, {"type": "subtitle", "time": 16512.789, "timestamp": "04:35:12", "text": "もしくは私をからかって笑う"}, {"type": "subtitle", "time": 16515.189, "timestamp": "04:35:15", "text": "私に対して、私がやったにもかかわらず、"}, {"type": "subtitle", "time": 16518.31, "timestamp": "04:35:18", "text": "彼らに好意を与えたり、喜ばせたりするのが最善です"}, {"type": "subtitle", "time": 16520.789, "timestamp": "04:35:20", "text": "とにかく、彼らを留まらせるために"}, {"type": "subtitle", "time": 16522.869, "timestamp": "04:35:22", "text": "そして、神様、私は自分が"}, {"type": "subtitle", "time": 16525.83, "timestamp": "04:35:25", "text": "自分で自分をからかってるけど、まあ、ここにいていいねして"}, {"type": "subtitle", "time": 16528.23, "timestamp": "04:35:28", "text": "私を見て、無視されないように"}, {"type": "subtitle", "time": 16530.949, "timestamp": "04:35:30", "text": "退屈なユーチューバーなどと思われたくない。"}, {"type": "subtitle", "time": 16533.349, "timestamp": "04:35:33", "text": "私がそれを渡すと、彼らは不思議に思う、などと言う。"}, {"type": "subtitle", "time": 16535.349, "timestamp": "04:35:35", "text": "そして彼らはそのようなことをする"}, {"type": "subtitle", "time": 16536.869, "timestamp": "04:35:36", "text": "冗談とかそういう類のもの。もちろん、私は"}, {"type": "subtitle", "time": 16540.269, "timestamp": "04:35:40", "text": "心が張り裂けそうで、すごく落ち込んでいるよ"}, {"type": "subtitle", "time": 16543.99, "timestamp": "04:35:43", "text": "今、私は自分の時間と"}, {"type": "subtitle", "time": 16546.47, "timestamp": "04:35:46", "text": "努力とすべてを今ゆっくりと"}, {"type": "subtitle", "time": 16550.23, "timestamp": "04:35:50", "text": "これを構築して、最善を尽くします"}, {"type": "subtitle", "time": 16553.349, "timestamp": "04:35:53", "text": "YouTuberとして、楽しみながら様々なことをしています"}, {"type": "subtitle", "time": 16555.67, "timestamp": "04:35:55", "text": "楽しい。これは私たちの趣味ですよね？多くの人にとって"}]
[{"type": "subtitle", "time": 8100.47, "timestamp": "02:15:00", "text": "ケア。良い一日をお過ごしください。わかった。"}, {"type": "subtitle", "time": 8101.95, "timestamp": "02:15:01", "text": "ご視聴ありがとうございました"}, {"type": "subtitle", "time": 8105.669, "timestamp": "02:15:05", "text": "入って。追いついて、私を捕まえてくれるといいな。"}, {"type": "subtitle", "time": 8108.47, "timestamp": "02:15:08", "text": "次の回で。気をつけて。楽しんで、"}, {"type": "subtitle", "time": 8110.31, "timestamp": "02:15:10", "text": "あなたが信じていることに幸運を祈ります"}, {"type": "subtitle", "time": 8112.47, "timestamp": "02:15:12", "text": "試験がある。試験を持って戻ってきて"}, {"type": "subtitle", "time": 8117.149, "timestamp": "02:15:17", "text": "もの。見て、"}, {"type": "subtitle", "time": 8119.79, "timestamp": "02:15:19", "text": "翻訳？ああ、少なくともそれは"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "ああ、そうだね。 10時30分になります。"}, {"type": "subtitle", "time": 8135.589, "timestamp": "02:15:35", "text": "10時30分までに配信を終了します。わかった。それで、"}, {"type": "subtitle", "time": 8137.91, "timestamp": "02:15:37", "text": "全部片付けて寝るよ"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "11時までに。"}, {"type": "subtitle", "time": 8145.35, "timestamp": "02:15:45", "text": "はい。はい。ええと、そうですね、"}, {"type": "subtitle", "time": 8147.43, "timestamp": "02:15:47", "text": "たくさんのことが起こるだろう"}, {"type": "subtitle", "time": 8150.35, "timestamp": "02:15:50", "text": "今後数ヶ月。私は"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "怖がった。私は怖いです。私は幸せです。"}, {"type": "subtitle", "time": 8156.629, "timestamp": "02:15:56", "text": "同時に怖かった。だから、私は"}, {"type": "subtitle", "time": 8159.79, "timestamp": "02:15:59", "text": "物事がどう進むかを知る、"}]
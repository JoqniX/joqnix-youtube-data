[{"type": "subtitle", "time": 1450.029, "timestamp": "00:24:10", "text": "わかった。それで、"}, {"type": "subtitle", "time": 1453.71, "timestamp": "00:24:13", "text": "うん。また、また"}, {"type": "subtitle", "time": 1456.47, "timestamp": "00:24:16", "text": "ええ、彼女の作品にはワクワクしています。"}, {"type": "subtitle", "time": 1457.75, "timestamp": "00:24:17", "text": "はい。"}, {"type": "subtitle", "time": 1461.029, "timestamp": "00:24:21", "text": "また、クレイジーはあなたの"}, {"type": "subtitle", "time": 1463.269, "timestamp": "00:24:23", "text": "クリス、初めて？ようこそ"}, {"type": "subtitle", "time": 1466.549, "timestamp": "00:24:26", "text": "ちなみに、コンステル社です。私は信じています"}, {"type": "subtitle", "time": 1469.029, "timestamp": "00:24:29", "text": "きちんと歓迎してあげられなかったのですが、"}, {"type": "subtitle", "time": 1471.59, "timestamp": "00:24:31", "text": "でも、お元気でいらっしゃることを願っています。あなたの"}, {"type": "subtitle", "time": 1473.83, "timestamp": "00:24:33", "text": "水曜日は順調に進んでいます。こんにちは。"}, {"type": "subtitle", "time": 1479.51, "timestamp": "00:24:39", "text": "いらっしゃいませ。ああ、なんてことだ、それはヒンディー語だ。私"}, {"type": "subtitle", "time": 1481.549, "timestamp": "00:24:41", "text": "できない"}, {"type": "subtitle", "time": 1485.75, "timestamp": "00:24:45", "text": "読む。ああ、翻訳ツールを使わせてください。いいえ、"}, {"type": "subtitle", "time": 1494.83, "timestamp": "00:24:54", "text": "待って。おお。そうそう。それは私です。"}]
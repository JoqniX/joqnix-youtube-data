[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "管理も楽になりますし、"}, {"type": "subtitle", "time": 7323.47, "timestamp": "02:02:03", "text": "それら全て。"}, {"type": "subtitle", "time": 7327.31, "timestamp": "02:02:07", "text": "ええ、まあそんな感じです。私はちょっと"}, {"type": "subtitle", "time": 7329.07, "timestamp": "02:02:09", "text": "心配した。しかし"}, {"type": "subtitle", "time": 7332.07, "timestamp": "02:02:12", "text": "はい、でもいずれは引っ越さなければなりません"}, {"type": "subtitle", "time": 7336.51, "timestamp": "02:02:16", "text": "また家から出ているけど、私は戻る"}, {"type": "subtitle", "time": 7346.709, "timestamp": "02:02:26", "text": "男。旅行に行きたい。訪れたい"}, {"type": "subtitle", "time": 7349.99, "timestamp": "02:02:29", "text": "いつか訪れる場所。"}, {"type": "subtitle", "time": 7352.39, "timestamp": "02:02:32", "text": "ええ、それで、現在私は"}, {"type": "subtitle", "time": 7355.589, "timestamp": "02:02:35", "text": "ローカルASPを持っています。ああ、忘れてた。"}, {"type": "subtitle", "time": 7358.75, "timestamp": "02:02:38", "text": "ダニエルですか、それとも"}, {"type": "subtitle", "time": 7365.35, "timestamp": "02:02:45", "text": "忘れた。コラーゲンが減少するだろう。"}, {"type": "subtitle", "time": 7366.83, "timestamp": "02:02:46", "text": "うん、そうするべきだね。私"}, {"type": "subtitle", "time": 7371.45, "timestamp": "02:02:51", "text": "すべき。ええ、おそらく必要ないでしょう"}]
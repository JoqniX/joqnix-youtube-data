[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "コミュニティ、そしてコミュニティを持つ"}, {"type": "subtitle", "time": 17164.23, "timestamp": "04:46:04", "text": "あなたが快適に過ごせる場所で"}, {"type": "subtitle", "time": 17166.47, "timestamp": "04:46:06", "text": "視聴者とその他すべて。だからあなたは"}, {"type": "subtitle", "time": 17169.43, "timestamp": "04:46:09", "text": "ある日目覚めて誇りを感じ、"}, {"type": "subtitle", "time": 17172.07, "timestamp": "04:46:12", "text": "あなたはストリーミング配信をしようと思って"}, {"type": "subtitle", "time": 17174.39, "timestamp": "04:46:14", "text": "人々はあなたにエネルギーとポジティブなものを与えてくれる"}, {"type": "subtitle", "time": 17177.27, "timestamp": "04:46:17", "text": "あなたをより幸せに感じさせるエネルギー"}, {"type": "subtitle", "time": 17179.51, "timestamp": "04:46:19", "text": "そして、誇りに思う。翌日あなたは"}, {"type": "subtitle", "time": 17182.708, "timestamp": "04:46:22", "text": "そう、ストリーミングは大好きだよ。私は愛しています"}, {"type": "subtitle", "time": 17185.83, "timestamp": "04:46:25", "text": "観客。全力を尽くします。そして"}, {"type": "subtitle", "time": 17188.47, "timestamp": "04:46:28", "text": "次の日、あなたはストリームをします"}, {"type": "subtitle", "time": 17196.31, "timestamp": "04:46:36", "text": "幸せでしょ？"}, {"type": "chat", "time": 17198.039, "timestamp": "04:46:38", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I lost all the motivation to stream im literally crying rn"}, {"type": "subtitle", "time": 17199.47, "timestamp": "04:46:39", "text": "それが究極の目標です。"}, {"type": "subtitle", "time": 17203.23, "timestamp": "04:46:43", "text": "右？どうぞお気軽に「いいね！」してください。"}, {"type": "subtitle", "time": 17207.27, "timestamp": "04:46:47", "text": "ええと、聴衆に伝えてください、"}, {"type": "subtitle", "time": 17209.75, "timestamp": "04:46:49", "text": "お願い、それはやめて。影響がある"}, {"type": "subtitle", "time": 17211.99, "timestamp": "04:46:51", "text": "私と、その他すべて。"}, {"type": "subtitle", "time": 17212.99, "timestamp": "04:46:52", "text": "しかし"}, {"type": "subtitle", "time": 17216.708, "timestamp": "04:46:56", "text": "それがどれほど自分を打ちのめす可能性があるかを知ることも重要だ。"}, {"type": "subtitle", "time": 17219.83, "timestamp": "04:46:59", "text": "ストリーミング配信はしばらくお休みした方がいいと思います。"}]
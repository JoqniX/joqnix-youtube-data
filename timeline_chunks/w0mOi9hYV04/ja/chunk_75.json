[{"type": "subtitle", "time": 4501.189, "timestamp": "01:15:01", "text": "それに関する多くのこと、そしてもし"}, {"type": "subtitle", "time": 4503.35, "timestamp": "01:15:03", "text": "商品があるのは一つだけ"}, {"type": "subtitle", "time": 4505.229, "timestamp": "01:15:05", "text": "言うことは"}, {"type": "subtitle", "time": 4509.229, "timestamp": "01:15:09", "text": "商品に関しては"}, {"type": "subtitle", "time": 4512.63, "timestamp": "01:15:12", "text": "オネクシアの伝承ストーリーのようなもの"}, {"type": "subtitle", "time": 4515.149, "timestamp": "01:15:15", "text": "オネクシアの世界のものが"}, {"type": "subtitle", "time": 4518.39, "timestamp": "01:15:18", "text": "別々で、vubic のものは"}, {"type": "subtitle", "time": 4522.669, "timestamp": "01:15:22", "text": "別。わかった。だから私は宣伝しなければならない"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "オネクシアのグッズとその他すべて"}, {"type": "subtitle", "time": 4528.99, "timestamp": "01:15:28", "text": "品"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "別々に。えーと、ジョックニックがビデオ撮影"}, {"type": "subtitle", "time": 4533.35, "timestamp": "01:15:33", "text": "物事は全く違ったものに見えるだろう。"}, {"type": "subtitle", "time": 4536.35, "timestamp": "01:15:36", "text": "いつものように"}, {"type": "subtitle", "time": 4539.91, "timestamp": "01:15:39", "text": "チューブチューブのようなユーチューバー、とても親切な"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "はい。でも、そう、もう一方になるだろう"}, {"type": "subtitle", "time": 4555.59, "timestamp": "01:15:55", "text": "裏面。わかった。私はしていません"}, {"type": "subtitle", "time": 4557.91, "timestamp": "01:15:57", "text": "それで確認しましたが、"}]
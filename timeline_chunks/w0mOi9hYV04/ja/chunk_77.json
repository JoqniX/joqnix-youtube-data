[{"type": "subtitle", "time": 4623.07, "timestamp": "01:17:03", "text": "VRチャットでのセッションは"}, {"type": "subtitle", "time": 4626.75, "timestamp": "01:17:06", "text": "日本語は昔、日本語は"}, {"type": "subtitle", "time": 4629.51, "timestamp": "01:17:09", "text": "難しい、日本人は私が"}, {"type": "subtitle", "time": 4632.55, "timestamp": "01:17:12", "text": "彼は私を運ばなければならなかった。"}, {"type": "subtitle", "time": 4636.03, "timestamp": "01:17:16", "text": "だから私は学ばなければならない"}, {"type": "subtitle", "time": 4641.91, "timestamp": "01:17:21", "text": "マンドリンはおそらくすぐに"}, {"type": "subtitle", "time": 4642.99, "timestamp": "01:17:22", "text": "すべて"}, {"type": "subtitle", "time": 4647.43, "timestamp": "01:17:27", "text": "中国語のCNコネラコンステラー"}, {"type": "subtitle", "time": 4650.99, "timestamp": "01:17:30", "text": "私は苦しまない"}, {"type": "subtitle", "time": 4655.11, "timestamp": "01:17:35", "text": "英語。うん。でも私は良い友達に出会った"}, {"type": "subtitle", "time": 4657.669, "timestamp": "01:17:37", "text": "私がヴァドにいる間にたくさんの人がいた"}, {"type": "subtitle", "time": 4666.07, "timestamp": "01:17:46", "text": "ええと、JPとマンディング。うん、たぶん"}, {"type": "subtitle", "time": 4674.95, "timestamp": "01:17:54", "text": "うん、いろいろ学ばなきゃね。ええ、Hは"}, {"type": "subtitle", "time": 4677.59, "timestamp": "01:17:57", "text": "真実。はい、見ました。"}]
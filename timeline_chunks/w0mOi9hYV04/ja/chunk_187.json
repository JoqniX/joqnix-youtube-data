[{"type": "subtitle", "time": 11222.95, "timestamp": "03:07:02", "text": "えっと、待って、それは試すことですか"}, {"type": "subtitle", "time": 11228.59, "timestamp": "03:07:08", "text": "ドリーミーが何を読んでいるか、えっと、ドリーミーは何"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "言った。そしてXゲーマーでもある。うん。こんにちは。どうやって"}, {"type": "subtitle", "time": 11237.03, "timestamp": "03:07:17", "text": "あなたはXゲーマーですか？今日はどんな一日でしたか？希望"}, {"type": "subtitle", "time": 11239.83, "timestamp": "03:07:19", "text": "あなたはよくやっています。ええ、見ましたよ"}, {"type": "subtitle", "time": 11242.309, "timestamp": "03:07:22", "text": "あなたが作ったアニメーションです。あなたは"}, {"type": "subtitle", "time": 11246.15, "timestamp": "03:07:26", "text": "Starscape Discordは良かった。続けよう"}, {"type": "subtitle", "time": 11247.18, "timestamp": "03:07:27", "text": "あなたの"}, {"type": "subtitle", "time": 11249.389, "timestamp": "03:07:29", "text": "[音楽]"}, {"type": "subtitle", "time": 11251.85, "timestamp": "03:07:31", "text": "最高。続けましょう"}, {"type": "subtitle", "time": 11254.91, "timestamp": "03:07:34", "text": "[音楽]"}]
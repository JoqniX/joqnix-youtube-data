[{"type": "subtitle", "time": 18061.788, "timestamp": "05:01:01", "text": "ずっと前からこのIMユーチューバーを知ってるよ"}, {"type": "subtitle", "time": 18064.91, "timestamp": "05:01:04", "text": "ページスペースには私がインスピレーションを与えた人がいました"}, {"type": "subtitle", "time": 18068.868, "timestamp": "05:01:08", "text": "私が最初に会ったのは、"}, {"type": "subtitle", "time": 18072.31, "timestamp": "05:01:12", "text": "すべてのユーチューバーはそうだけど、そう、何"}, {"type": "subtitle", "time": 18074.628, "timestamp": "05:01:14", "text": "何が起こったかというと、彼らが"}, {"type": "subtitle", "time": 18079.39, "timestamp": "05:01:19", "text": "新モデルデビューで人気が出ました"}, {"type": "subtitle", "time": 18082.15, "timestamp": "05:01:22", "text": "クリッピングチャンネルの1つは"}, {"type": "subtitle", "time": 18084.948, "timestamp": "05:01:24", "text": "クリッピングチャンネルが彼らに電話をかけた。そして、"}, {"type": "subtitle", "time": 18086.788, "timestamp": "05:01:26", "text": "デビュー配信か何かで、"}, {"type": "subtitle", "time": 18089.75, "timestamp": "05:01:29", "text": "彼らは何千もの"}, {"type": "subtitle", "time": 18093.59, "timestamp": "05:01:33", "text": "デビュー配信で人々が私のところにやって来た"}, {"type": "subtitle", "time": 18104.15, "timestamp": "05:01:44", "text": "えーと、デビュー配信のような仲間の友達"}, {"type": "subtitle", "time": 18106.788, "timestamp": "05:01:46", "text": "そして私たちは彼女のためにとても嬉しかった"}, {"type": "subtitle", "time": 18109.07, "timestamp": "05:01:49", "text": "彼らにとっては正しい"}, {"type": "subtitle", "time": 18111.91, "timestamp": "05:01:51", "text": "そして多くの人々が"}, {"type": "subtitle", "time": 18114.31, "timestamp": "05:01:54", "text": "彼女が来ると、彼女は大声で叫んだ"}, {"type": "subtitle", "time": 18117.43, "timestamp": "05:01:57", "text": "えーと、部屋割りとかそういうこと。だから何"}]
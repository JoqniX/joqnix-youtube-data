[{"type": "subtitle", "time": 301.909, "timestamp": "00:05:01", "text": "実際、生き延びた。うん。うん。私"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "実際、生き延びた。でも、私が"}, {"type": "subtitle", "time": 306.83, "timestamp": "00:05:06", "text": "危うくその人にぶつかるところだった。私は私は手に入れた"}, {"type": "subtitle", "time": 310.15, "timestamp": "00:05:10", "text": "怖がった。私は本当に泣いていました"}, {"type": "subtitle", "time": 313.27, "timestamp": "00:05:13", "text": "道端で泣いている、ああ"}, {"type": "subtitle", "time": 316.11, "timestamp": "00:05:16", "text": "ああ、危うく"}, {"type": "subtitle", "time": 318.39, "timestamp": "00:05:18", "text": "亡くなった。そうそう。うん。それら全て"}, {"type": "subtitle", "time": 321.71, "timestamp": "00:05:21", "text": "何が起こったのか、そしてそれ以来私は"}, {"type": "subtitle", "time": 325.11, "timestamp": "00:05:25", "text": "えっと、私がそれを持ち帰って以来。"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "うん。そして今日私は"}, {"type": "subtitle", "time": 330.83, "timestamp": "00:05:30", "text": "雨が降っていて、道に迷ってしまった。えっと、それからGoogle"}, {"type": "subtitle", "time": 332.909, "timestamp": "00:05:32", "text": "マップが保存されました"}, {"type": "subtitle", "time": 337.189, "timestamp": "00:05:37", "text": "自分。うん。今日はGoogleマップに助けられました。"}, {"type": "subtitle", "time": 339.749, "timestamp": "00:05:39", "text": "ええ、レストランに行きました。私"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "それは中国製だったと思います"}, {"type": "subtitle", "time": 345.83, "timestamp": "00:05:45", "text": "レストランの何か。えっと、スープを飲みました。私"}, {"type": "subtitle", "time": 349.029, "timestamp": "00:05:49", "text": "私はスープを食べました。えっと、その日私は"}, {"type": "subtitle", "time": 351.67, "timestamp": "00:05:51", "text": "ここにも来たよ。だからその日、私が"}, {"type": "subtitle", "time": 354.79, "timestamp": "00:05:54", "text": "スクラ、アンバーがここに書き戻した。"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "その日、私はスープを飲みました。もしあなたが"}]
[{"type": "subtitle", "time": 788.03, "timestamp": "00:13:08", "text": "ジョーカー"}, {"type": "subtitle", "time": 799.03, "timestamp": "00:13:19", "text": "ええ、最近は配信してないんです"}, {"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "今ではあちこちで散発的に見られる。"}, {"type": "subtitle", "time": 806.629, "timestamp": "00:13:26", "text": "だから、本当にそうしたいんです"}, {"type": "subtitle", "time": 810.269, "timestamp": "00:13:30", "text": "えっと、本当にそうしたいんです"}, {"type": "subtitle", "time": 814.069, "timestamp": "00:13:34", "text": "えっと、本当に戻りたいんです"}, {"type": "subtitle", "time": 818.55, "timestamp": "00:13:38", "text": "いつもの調子に戻る。えっと、私の母は"}, {"type": "subtitle", "time": 820.23, "timestamp": "00:13:40", "text": "MacBookを買うように言われるけど、私は"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "MacBookが欲しい。ああ、ノートパソコンのやつみたいにね"}, {"type": "subtitle", "time": 828.15, "timestamp": "00:13:48", "text": "またはデスクトップ版のようなもの。待って、MacBook"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "Airは私が思うに最高のノートパソコンです。私はしません"}, {"type": "subtitle", "time": 835.91, "timestamp": "00:13:55", "text": "知る。そして私は、"}, {"type": "subtitle", "time": 837.829, "timestamp": "00:13:57", "text": "えっと、なんて呼ぶんだっけ？ええ、私は違います"}]
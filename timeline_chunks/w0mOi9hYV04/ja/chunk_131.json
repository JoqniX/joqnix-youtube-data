[{"type": "subtitle", "time": 7861.27, "timestamp": "02:11:01", "text": "えっと、次はママ、次はおばあちゃん、そしてパパ"}, {"type": "subtitle", "time": 7876.51, "timestamp": "02:11:16", "text": "うん、私は"}, {"type": "subtitle", "time": 7879.109, "timestamp": "02:11:19", "text": "今。ええ、まさにその通りです。うん、まあそんな感じ"}, {"type": "subtitle", "time": 7881.43, "timestamp": "02:11:21", "text": "それと似たようなものだ。私は自分の"}, {"type": "subtitle", "time": 7890.55, "timestamp": "02:11:30", "text": "ええ、そういうことなんです。なぜ"}, {"type": "subtitle", "time": 7897.189, "timestamp": "02:11:37", "text": "立ち往生？でも、それは、それは"}, {"type": "subtitle", "time": 7899.91, "timestamp": "02:11:39", "text": "私が"}, {"type": "subtitle", "time": 7902.149, "timestamp": "02:11:42", "text": "断続的に旅行している。しかし今日では、私は"}, {"type": "subtitle", "time": 7903.629, "timestamp": "02:11:43", "text": "中古品は必要ありません"}, {"type": "subtitle", "time": 7908.31, "timestamp": "02:11:48", "text": "バス。ええと、家に帰れますよ。うん、"}, {"type": "subtitle", "time": 7911.43, "timestamp": "02:11:51", "text": "乗馬は良い。乗ることに慣れるよ"}, {"type": "subtitle", "time": 7913.83, "timestamp": "02:11:53", "text": "高速道路。まるで自転車じゃないみたいだ。その"}, {"type": "subtitle", "time": 7915.669, "timestamp": "02:11:55", "text": "どちらかというとスクーターに近い。待って、"}, {"type": "subtitle", "time": 7918.629, "timestamp": "02:11:58", "text": "エスコダと対の違い"}]
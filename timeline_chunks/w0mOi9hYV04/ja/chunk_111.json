[{"type": "subtitle", "time": 6661.75, "timestamp": "01:51:01", "text": "現在、血糖降下剤を服用しています。それで、"}, {"type": "subtitle", "time": 6665.27, "timestamp": "01:51:05", "text": "それは、えーっと、それは、何か"}, {"type": "subtitle", "time": 6669.83, "timestamp": "01:51:09", "text": "えっと、どこに置いたの？"}, {"type": "subtitle", "time": 6672.79, "timestamp": "01:51:12", "text": "えっと、オレンジ味みたいな感じ"}, {"type": "subtitle", "time": 6676.149, "timestamp": "01:51:16", "text": "ところで。それで、えっと、それは"}, {"type": "subtitle", "time": 6679.31, "timestamp": "01:51:19", "text": "円形のタブレットのような"}, {"type": "subtitle", "time": 6684.109, "timestamp": "01:51:24", "text": "えーと、ポロってミント味なんだよね"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "キャラメル、もしくはキャンディーのようなもの。まるで"}, {"type": "subtitle", "time": 6689.75, "timestamp": "01:51:29", "text": "でももっと大きい、まるで"}, {"type": "subtitle", "time": 6692.79, "timestamp": "01:51:32", "text": "コイン。 5ルピー硬貨。 5点満点中5点"}, {"type": "subtitle", "time": 6694.79, "timestamp": "01:51:34", "text": "ルピー硬貨のようなものタブレット"}, {"type": "subtitle", "time": 6697.91, "timestamp": "01:51:37", "text": "実に分厚い。うん。私はそれを置いた"}, {"type": "subtitle", "time": 6701.47, "timestamp": "01:51:41", "text": "水に入れると泡立ち、"}, {"type": "subtitle", "time": 6704.51, "timestamp": "01:51:44", "text": "実際、聞こえますか？"}, {"type": "subtitle", "time": 6709.629, "timestamp": "01:51:49", "text": "待って。えっと、シューッという音を聞きたいですか？"}, {"type": "subtitle", "time": 6713.03, "timestamp": "01:51:53", "text": "ASMR？待って、君を消火させてあげるよ"}, {"type": "subtitle", "time": 6716.229, "timestamp": "01:51:56", "text": "ASMRですよね？ 1秒。少し時間をください。"}, {"type": "subtitle", "time": 6718.199, "timestamp": "01:51:58", "text": "少し時間をください。 待って。ああ、準備するよ。おお、"}]
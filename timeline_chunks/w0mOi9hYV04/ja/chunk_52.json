[{"type": "subtitle", "time": 3121.43, "timestamp": "00:52:01", "text": "まるでタンを飲んでいるかのようだ"}, {"type": "subtitle", "time": 3132.549, "timestamp": "00:52:12", "text": "[音楽]"}, {"type": "subtitle", "time": 3137.87, "timestamp": "00:52:17", "text": "持ってくる。"}, {"type": "subtitle", "time": 3140.069, "timestamp": "00:52:20", "text": "えっと、電話をすればいいのに"}, {"type": "subtitle", "time": 3142.79, "timestamp": "00:52:22", "text": "彼がそれを消散させる間、S ではない。待って。いいえ。"}, {"type": "subtitle", "time": 3145.15, "timestamp": "00:52:25", "text": "はぁ？いいえ。私は待てと思いました。"}, {"type": "subtitle", "time": 3147.15, "timestamp": "00:52:27", "text": "はぁ？"}, {"type": "subtitle", "time": 3150.15, "timestamp": "00:52:30", "text": "いいえ。え？"}, {"type": "subtitle", "time": 3163.03, "timestamp": "00:52:43", "text": "[音楽]"}, {"type": "subtitle", "time": 3165.589, "timestamp": "00:52:45", "text": "道を空けろ。彼は男の子だけどね。その"}, {"type": "subtitle", "time": 3168.95, "timestamp": "00:52:48", "text": "大丈夫。アンドロアスです。だから私は"}, {"type": "subtitle", "time": 3171.75, "timestamp": "00:52:51", "text": "あなたが望む人なら誰でも。私は男の子にもなれるし、"}, {"type": "subtitle", "time": 3174.71, "timestamp": "00:52:54", "text": "女の子になりなさい。あなたがどんな形で私を愛しても構いません"}, {"type": "subtitle", "time": 3177.23, "timestamp": "00:52:57", "text": "欲しい。だからそれは"}]
[{"type": "subtitle", "time": 16920.868, "timestamp": "04:42:00", "text": "Twitchで配信していた。そのボードは"}, {"type": "subtitle", "time": 16922.47, "timestamp": "04:42:02", "text": "存在しないと思います。それは"}, {"type": "subtitle", "time": 16925.03, "timestamp": "04:42:05", "text": "私の掲示板チャンネルにあるんだけど、うん、"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "あれで俺は打ちのめされたよ、兄弟。私はコラボレーションに参加していました"}, {"type": "subtitle", "time": 16930.868, "timestamp": "04:42:10", "text": "ゲストと一緒に、視聴者にも参加してもらいました"}, {"type": "subtitle", "time": 16932.948, "timestamp": "04:42:12", "text": "なぜなら"}, {"type": "subtitle", "time": 16935.35, "timestamp": "04:42:15", "text": "ええ、私は彼らを信頼していました。まるで"}, {"type": "subtitle", "time": 16939.39, "timestamp": "04:42:19", "text": "Twitchの熱心な視聴者がやって来て、"}, {"type": "subtitle", "time": 16943.03, "timestamp": "04:42:23", "text": "物事を言うこと、そしてそれを"}, {"type": "subtitle", "time": 16944.59, "timestamp": "04:42:24", "text": "コラボレーション"}, {"type": "subtitle", "time": 16949.83, "timestamp": "04:42:29", "text": "私が悪いパートナーであるなど。"}, {"type": "subtitle", "time": 16953.59, "timestamp": "04:42:33", "text": "私はクソ野郎で、愛の観を持つ叔母さんのような"}, {"type": "subtitle", "time": 16957.27, "timestamp": "04:42:37", "text": "あるいは、そういった類のものすべて。えっと、私は思う"}, {"type": "subtitle", "time": 16959.11, "timestamp": "04:42:39", "text": "彼らはもっとひどいことを言っていた。しかし"}, {"type": "subtitle", "time": 16962.31, "timestamp": "04:42:42", "text": "ああ、それを全部生で聞いて、"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "あまり注意を払っていなかったけど、"}, {"type": "subtitle", "time": 16967.51, "timestamp": "04:42:47", "text": "私はできないの？私は2時間遅れているみたい"}, {"type": "subtitle", "time": 16970.35, "timestamp": "04:42:50", "text": "ブルマーとかそんな感じのやつ。衝撃を受ける"}, {"type": "subtitle", "time": 16972.39, "timestamp": "04:42:52", "text": "その後。私の反応は"}, {"type": "subtitle", "time": 16974.948, "timestamp": "04:42:54", "text": "その後。そう、その後"}, {"type": "subtitle", "time": 16977.19, "timestamp": "04:42:57", "text": "ストリームも何もかも、私も衝撃を受けた。"}]
[{"type": "subtitle", "time": 16862.15, "timestamp": "04:41:02", "text": "はぁ？あなたは誰のためにそれをしたいですか？"}, {"type": "subtitle", "time": 16865.11, "timestamp": "04:41:05", "text": "人々が"}, {"type": "subtitle", "time": 16867.51, "timestamp": "04:41:07", "text": "えっと、私は悪いことについては決して話さないんです"}, {"type": "subtitle", "time": 16870.99, "timestamp": "04:41:10", "text": "もう彼らについては何も言わないけど、まあ、カバーリー"}, {"type": "subtitle", "time": 16875.15, "timestamp": "04:41:15", "text": "悲しい。インターネットのおかげだ。バカ。それは"}, {"type": "subtitle", "time": 16879.59, "timestamp": "04:41:19", "text": "インターネット。えっと、私はこれを"}, {"type": "subtitle", "time": 16883.39, "timestamp": "04:41:23", "text": "悪いことだ。つまり、つまり、その"}, {"type": "subtitle", "time": 16887.868, "timestamp": "04:41:27", "text": "これは私自身が見たものです"}, {"type": "subtitle", "time": 16891.27, "timestamp": "04:41:31", "text": "さらに悪いことだと思う。つまり、私の"}, {"type": "subtitle", "time": 16895.35, "timestamp": "04:41:35", "text": "コミュニティで、私が信頼していた人たちを見てきました"}, {"type": "subtitle", "time": 16898.708, "timestamp": "04:41:38", "text": "たくさん持ってきて、配信にも登場させたよ"}, {"type": "subtitle", "time": 16900.91, "timestamp": "04:41:40", "text": "私とゲームをするのは"}, {"type": "subtitle", "time": 16904.55, "timestamp": "04:41:44", "text": "そして、彼らが"}, {"type": "subtitle", "time": 16907.628, "timestamp": "04:41:47", "text": "たくさんの悪いことを言った"}, {"type": "subtitle", "time": 16912.708, "timestamp": "04:41:52", "text": "私とか色々、そしてそれは"}, {"type": "chat", "time": 16914.8, "timestamp": "04:41:54", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Wow i can never "}, {"type": "subtitle", "time": 16915.51, "timestamp": "04:41:55", "text": "私がそのシングルのせいで"}, {"type": "subtitle", "time": 16919.51, "timestamp": "04:41:59", "text": "2年前にTwitchで経験したトラウマ。私"}]
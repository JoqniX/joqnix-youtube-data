[{"type": "subtitle", "time": 12458.59, "timestamp": "03:27:38", "text": "よし、分解する"}, {"type": "subtitle", "time": 12461.03, "timestamp": "03:27:41", "text": "それ。見たい、聞きたい"}, {"type": "subtitle", "time": 12468.95, "timestamp": "03:27:48", "text": "待って、ほら。彼は聞くことができる"}, {"type": "subtitle", "time": 12470.55, "timestamp": "03:27:50", "text": "すべてです。"}, {"type": "subtitle", "time": 12479.72, "timestamp": "03:27:59", "text": "それ。あれらはネジです。そしてこれらは"}]
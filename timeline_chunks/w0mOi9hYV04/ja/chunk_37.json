[{"type": "subtitle", "time": 2220.47, "timestamp": "00:37:00", "text": "「え、待って。何だって？」"}, {"type": "subtitle", "time": 2223.43, "timestamp": "00:37:03", "text": "これですか？それで試してみました。作ってみました"}, {"type": "subtitle", "time": 2225.51, "timestamp": "00:37:05", "text": "中にはいろいろなものが入っている。だから私は「えーと、"}, {"type": "subtitle", "time": 2227.15, "timestamp": "00:37:07", "text": "それは良いです、"}, {"type": "subtitle", "time": 2230.63, "timestamp": "00:37:10", "text": "でも、私が持っていたものと全く同じというわけではない"}, {"type": "subtitle", "time": 2233.67, "timestamp": "00:37:13", "text": "まあ、そういうことだ。私はちょっとfが欲しい"}, {"type": "subtitle", "time": 2238.31, "timestamp": "00:37:18", "text": "ファンクラブページみたいなものが欲しかったんです。えっと"}, {"type": "subtitle", "time": 2241.349, "timestamp": "00:37:21", "text": "うん、何かみたいな、それは"}, {"type": "subtitle", "time": 2243.829, "timestamp": "00:37:23", "text": "あなた、みんなのためにカスタマイズされ、"}, {"type": "subtitle", "time": 2245.829, "timestamp": "00:37:25", "text": "すべて。まあ、そんな感じですね。しかしそれは"}, {"type": "subtitle", "time": 2248.63, "timestamp": "00:37:28", "text": "ある種の痛み。でもいずれ分かるだろう"}, {"type": "subtitle", "time": 2250.67, "timestamp": "00:37:30", "text": "それを出す。うん。"}, {"type": "subtitle", "time": 2253.19, "timestamp": "00:37:33", "text": "うん。 Mトラッキングが機能していません"}, {"type": "subtitle", "time": 2255.589, "timestamp": "00:37:35", "text": "きちんと。ああ、それは"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "電話追跡。えっと、私はVT Vを使っています"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "スタジオモバイルアプリ。いいえ。それで、口は"}, {"type": "subtitle", "time": 2266.95, "timestamp": "00:37:46", "text": "これは常に存在する問題です。私が開けない限り"}, {"type": "subtitle", "time": 2269.47, "timestamp": "00:37:49", "text": "口は"}, {"type": "subtitle", "time": 2273.99, "timestamp": "00:37:53", "text": "ああ、そうするとモデル上でしか開かないんですね。いつ"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "残念ながら、私の言っていることは追跡できないでしょう。あなた"}]
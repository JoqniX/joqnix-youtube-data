[{"type": "subtitle", "time": 10025.19, "timestamp": "02:47:05", "text": "けれど。ああ、あなたを見ていたのを覚えています"}, {"type": "subtitle", "time": 10026.83, "timestamp": "02:47:06", "text": "遊ぶ"}, {"type": "subtitle", "time": 10029.429, "timestamp": "02:47:09", "text": "これ。待って。ああ、君は"}, {"type": "subtitle", "time": 10032.79, "timestamp": "02:47:12", "text": "TwitchのJump Kingの配信ですよね？"}, {"type": "subtitle", "time": 10048.67, "timestamp": "02:47:28", "text": "睡眠を見る。"}, {"type": "subtitle", "time": 10051.55, "timestamp": "02:47:31", "text": "よし、彼は"}, {"type": "subtitle", "time": 10054.15, "timestamp": "02:47:34", "text": "寝る。つまり、試行錯誤のようなものです"}, {"type": "subtitle", "time": 10056.71, "timestamp": "02:47:36", "text": "ゲーム。もし私が"}, {"type": "subtitle", "time": 10057.71, "timestamp": "02:47:37", "text": "遊ぶ"}, {"type": "subtitle", "time": 10060.23, "timestamp": "02:47:40", "text": "彼ら。うん。"}, {"type": "subtitle", "time": 10063.309, "timestamp": "02:47:43", "text": "ああ、血みどろのゲームもある"}, {"type": "subtitle", "time": 10067.15, "timestamp": "02:47:47", "text": "沸騰。うん。しかし、中には"}, {"type": "subtitle", "time": 10071.269, "timestamp": "02:47:51", "text": "平和的、と言えるかもしれませんね。調子はどうですか"}, {"type": "subtitle", "time": 10075.03, "timestamp": "02:47:55", "text": "怒ってないの？待って、これはゲームですか"}, {"type": "subtitle", "time": 10078.55, "timestamp": "02:47:58", "text": "激怒しているはず？私は欲しい 私は欲しい"}]
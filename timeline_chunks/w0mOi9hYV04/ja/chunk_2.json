[{"type": "subtitle", "time": 126.35, "timestamp": "00:02:06", "text": "そこには。それで、"}, {"type": "subtitle", "time": 128.51, "timestamp": "00:02:08", "text": "今日"}, {"type": "subtitle", "time": 135.47, "timestamp": "00:02:15", "text": "短い。こんにちは、忍者さん。こんにちは。"}, {"type": "subtitle", "time": 138.869, "timestamp": "00:02:18", "text": "いらっしゃいませ。いらっしゃいませ。いらっしゃいませ。願わくば"}, {"type": "subtitle", "time": 143.47, "timestamp": "00:02:23", "text": "順調にやっています。こんにちは"}, {"type": "subtitle", "time": 147.43, "timestamp": "00:02:27", "text": "私自身が皆より好きです。ああ、私は"}, {"type": "subtitle", "time": 149.91, "timestamp": "00:02:29", "text": "涙が出て、文字通り"}, {"type": "subtitle", "time": 153.11, "timestamp": "00:02:33", "text": "ここにいるみんなと同じように。ああ、なんてことだ、私の"}, {"type": "subtitle", "time": 157.15, "timestamp": "00:02:37", "text": "目は私の目は"}, {"type": "subtitle", "time": 160.63, "timestamp": "00:02:40", "text": "発汗。一体どういうことだ？何"}, {"type": "subtitle", "time": 162.35, "timestamp": "00:02:42", "text": "ワッフル、"}, {"type": "subtitle", "time": 166.55, "timestamp": "00:02:46", "text": "お前？何てことだ。今はスポーツマン。ビリー、何"}, {"type": "subtitle", "time": 167.79, "timestamp": "00:02:47", "text": "つまりそういうことですか？"}, {"type": "subtitle", "time": 171.869, "timestamp": "00:02:51", "text": "いいえ、私は"}, {"type": "subtitle", "time": 177.07, "timestamp": "00:02:57", "text": "えっと、実際に管理しようとしています"}, {"type": "subtitle", "time": 179.869, "timestamp": "00:02:59", "text": "両方。"}]
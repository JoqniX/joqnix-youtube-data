[{"type": "subtitle", "time": 10384.389, "timestamp": "02:53:04", "text": "行く。何かを作りたいのですが"}, {"type": "subtitle", "time": 10388.19, "timestamp": "02:53:08", "text": "チャットコマンドで"}, {"type": "subtitle", "time": 10393.59, "timestamp": "02:53:13", "text": "ユーザー名。待って、変更できない"}, {"type": "subtitle", "time": 10395.99, "timestamp": "02:53:15", "text": "離陸後の方向。いいえ。"}, {"type": "subtitle", "time": 10397.55, "timestamp": "02:53:17", "text": "できない"}, {"type": "subtitle", "time": 10401.429, "timestamp": "02:53:21", "text": "残念ながら。許可してくれない。まさにその通り"}, {"type": "subtitle", "time": 10403.79, "timestamp": "02:53:23", "text": "計算する"}, {"type": "subtitle", "time": 10407.03, "timestamp": "02:53:27", "text": "それ。そして、どれくらい長く押し続けるかが重要です"}, {"type": "subtitle", "time": 10408.59, "timestamp": "02:53:28", "text": "スペース"}, {"type": "subtitle", "time": 10412.349, "timestamp": "02:53:32", "text": "バー、短跳び、または長跳び"}, {"type": "subtitle", "time": 10416.71, "timestamp": "02:53:36", "text": "ジャンプ。そういうことですね。これはまるで私が"}, {"type": "subtitle", "time": 10419.51, "timestamp": "02:53:39", "text": "素早くスピードをタップしてスペースを押すと、"}, {"type": "subtitle", "time": 10422.23, "timestamp": "02:53:42", "text": "これ。 1秒間保持してこれをすると"}, {"type": "subtitle", "time": 10426.269, "timestamp": "02:53:46", "text": "long 2 は次のようになります。あなた"}, {"type": "subtitle", "time": 10430.87, "timestamp": "02:53:50", "text": "ほら、そういう風にタイミングを計らないといけないんだよ。頭"}, {"type": "subtitle", "time": 10433.59, "timestamp": "02:53:53", "text": "そんな感じ。ええ、私は作りたいんです"}, {"type": "subtitle", "time": 10436.95, "timestamp": "02:53:56", "text": "つまり、モデレーターがやることはできるけど、"}]
[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "コンテクスト。わかった。コンテクスト。私は言っている"}, {"type": "subtitle", "time": 3964.95, "timestamp": "01:06:04", "text": "これ。コミコン。彼に息をさせてあげて。ええ、私は"}, {"type": "subtitle", "time": 3966.25, "timestamp": "01:06:06", "text": "息がしたい。"}, {"type": "subtitle", "time": 3969.549, "timestamp": "01:06:09", "text": "[笑い]"}, {"type": "subtitle", "time": 3972.549, "timestamp": "01:06:12", "text": "息を吸ってよ。もうずいぶん経ちましたね。私"}, {"type": "subtitle", "time": 3974.71, "timestamp": "01:06:14", "text": "そうしました。だから、今日は楽しんでいます。私は"}, {"type": "subtitle", "time": 3977.349, "timestamp": "01:06:17", "text": "ハッピー。皆さんがリラックスして過ごしていることを願っています。"}, {"type": "subtitle", "time": 3990.789, "timestamp": "01:06:30", "text": "男の子。まあ、そうですね。えっと、どこまで話したっけ？どこ"}, {"type": "subtitle", "time": 3993.75, "timestamp": "01:06:33", "text": "そうだったのか？私はどこまで話したっけ？私はどこまで話したっけ？何が"}, {"type": "subtitle", "time": 3996.19, "timestamp": "01:06:36", "text": "100cc？"}, {"type": "subtitle", "time": 3999.67, "timestamp": "01:06:39", "text": "えっと、100って何？"}, {"type": "subtitle", "time": 4002.51, "timestamp": "01:06:42", "text": "コイン収集"}, {"type": "subtitle", "time": 4014.589, "timestamp": "01:06:54", "text": "cc?何？はぁ？ 100ccって何？"}, {"type": "subtitle", "time": 4017.87, "timestamp": "01:06:57", "text": "右？ 100って何？"}]
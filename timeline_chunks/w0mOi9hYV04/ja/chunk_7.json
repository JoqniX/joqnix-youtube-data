[{"type": "subtitle", "time": 423.35, "timestamp": "00:07:03", "text": "どのように対処するかのトレーニングを受ける"}, {"type": "subtitle", "time": 430.309, "timestamp": "00:07:10", "text": "それらすべてを詰め込む。とても良い。それで"}, {"type": "subtitle", "time": 433.27, "timestamp": "00:07:13", "text": "良い。ニース。ニース。それを維持する。私はします"}, {"type": "subtitle", "time": 437.27, "timestamp": "00:07:17", "text": "私も最善を尽くします、私も最善を尽くします"}, {"type": "subtitle", "time": 440.309, "timestamp": "00:07:20", "text": "ベスト"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "明日に慣れてください。私は実際"}, {"type": "subtitle", "time": 444.87, "timestamp": "00:07:24", "text": "車で家へ帰る、自転車で家へ帰る"}, {"type": "subtitle", "time": 447.15, "timestamp": "00:07:27", "text": "早朝。だから、"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "ええ、私は家に帰ります"}, {"type": "subtitle", "time": 457.27, "timestamp": "00:07:37", "text": "父に、それから、"}, {"type": "subtitle", "time": 460.87, "timestamp": "00:07:40", "text": "モバイルで訪問する必要がある"}, {"type": "subtitle", "time": 464.55, "timestamp": "00:07:44", "text": "ショップuhストア。これは私のSIMカード用です。"}, {"type": "subtitle", "time": 467.43, "timestamp": "00:07:47", "text": "えっと、SIMカードをなくしてしまって"}, {"type": "subtitle", "time": 471.99, "timestamp": "00:07:51", "text": "SMS のようなものかどうかを調べる必要がある"}, {"type": "subtitle", "time": 474.07, "timestamp": "00:07:54", "text": "転送は可能か何か"}, {"type": "subtitle", "time": 476.469, "timestamp": "00:07:56", "text": "2枚目のSIMカードを挿入できないから"}]
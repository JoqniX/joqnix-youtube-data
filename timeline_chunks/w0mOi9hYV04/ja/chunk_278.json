[{"type": "subtitle", "time": 16680.709, "timestamp": "04:38:00", "text": "そういうことを評価できる"}, {"type": "subtitle", "time": 16683.51, "timestamp": "04:38:03", "text": "それに対処することができます"}, {"type": "subtitle", "time": 16685.59, "timestamp": "04:38:05", "text": "コミュニティとコミュニケーションを取り、"}, {"type": "subtitle", "time": 16689.51, "timestamp": "04:38:09", "text": "それは理解できるよ、ミツキはそうじゃない"}, {"type": "subtitle", "time": 16692.709, "timestamp": "04:38:12", "text": "こういうことや、私も試してみなきゃ"}, {"type": "subtitle", "time": 16696.39, "timestamp": "04:38:16", "text": "行かない、または遠くまで行って傷つける"}, {"type": "subtitle", "time": 16698.869, "timestamp": "04:38:18", "text": "私が楽しんで見ている配信者とか"}, {"type": "subtitle", "time": 16702.23, "timestamp": "04:38:22", "text": "そう、なぜならまた、それは"}, {"type": "subtitle", "time": 16705.67, "timestamp": "04:38:25", "text": "それを行う方法の一つですが、第二に"}, {"type": "subtitle", "time": 16709.029, "timestamp": "04:38:29", "text": "2つ目は、"}, {"type": "subtitle", "time": 16711.429, "timestamp": "04:38:31", "text": "インターネットは常に"}, {"type": "subtitle", "time": 16714.07, "timestamp": "04:38:34", "text": "良い人、悪い人、人々は"}, {"type": "subtitle", "time": 16715.99, "timestamp": "04:38:35", "text": "マスクもちゃんと着けてるよね？"}, {"type": "subtitle", "time": 16720.15, "timestamp": "04:38:40", "text": "時々、彼らは、"}, {"type": "subtitle", "time": 16722.47, "timestamp": "04:38:42", "text": "良いことだが、舞台裏では"}, {"type": "subtitle", "time": 16726.23, "timestamp": "04:38:46", "text": "電話して裏切るとか、えっと言うと"}, {"type": "subtitle", "time": 16727.99, "timestamp": "04:38:47", "text": "悪いこととか、とにかく人々"}, {"type": "subtitle", "time": 16730.15, "timestamp": "04:38:50", "text": "彼らは人間です。いいえ、人それぞれ違います。"}, {"type": "subtitle", "time": 16732.15, "timestamp": "04:38:52", "text": "誰もが正直で、"}, {"type": "subtitle", "time": 16734.551, "timestamp": "04:38:54", "text": "すべて、ですよね？だから、"}, {"type": "subtitle", "time": 16737.07, "timestamp": "04:38:57", "text": "それを理解してください。そしてコンテンツとして"}, {"type": "subtitle", "time": 16739.349, "timestamp": "04:38:59", "text": "クリエイター、コンテンツクリエイター、ライブ"}]
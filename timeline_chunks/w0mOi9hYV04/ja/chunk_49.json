[{"type": "subtitle", "time": 2951.829, "timestamp": "00:49:11", "text": "もっとコロンは私に意地悪だった。だから彼らは"}, {"type": "subtitle", "time": 2954.71, "timestamp": "00:49:14", "text": "口論。あなたたち二人に何があったの？希望"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "皆順調です。うん、私が行くよ"}, {"type": "subtitle", "time": 2959.349, "timestamp": "00:49:19", "text": "ええと、みんな元気です。私は思う"}, {"type": "subtitle", "time": 2961.349, "timestamp": "00:49:21", "text": "皆さんが元気でいることを願っています。による"}, {"type": "subtitle", "time": 2962.109, "timestamp": "00:49:22", "text": "の"}, {"type": "subtitle", "time": 2965.309, "timestamp": "00:49:25", "text": "まあ、私は元気ですよ。私の"}, {"type": "subtitle", "time": 2968.71, "timestamp": "00:49:28", "text": "夕食。私はここで良いことをしています。私は"}, {"type": "subtitle", "time": 2972.91, "timestamp": "00:49:32", "text": "文字通りビタミンCを摂取しています"}, {"type": "subtitle", "time": 2975.829, "timestamp": "00:49:35", "text": "現在、血糖降下剤を服用しています。それで、"}, {"type": "subtitle", "time": 2979.349, "timestamp": "00:49:39", "text": "それは、えーっと、それは、何か"}, {"type": "subtitle", "time": 2983.99, "timestamp": "00:49:43", "text": "えっと、どこに置いたの？"}, {"type": "subtitle", "time": 2986.87, "timestamp": "00:49:46", "text": "えーっと、オレンジ味みたいな感じですね。"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "ところで。えっと、それは"}, {"type": "subtitle", "time": 2993.39, "timestamp": "00:49:53", "text": "円形のタブレットのような"}, {"type": "subtitle", "time": 2998.19, "timestamp": "00:49:58", "text": "えーと、ポロのミントは、"}]
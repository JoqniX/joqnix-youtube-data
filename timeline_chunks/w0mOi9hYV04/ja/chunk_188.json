[{"type": "subtitle", "time": 11327.75, "timestamp": "03:08:47", "text": "待って、シーンが変わったの？ああ、"}, {"type": "subtitle", "time": 11330.07, "timestamp": "03:08:50", "text": "ああ、モニターを直していたんだ。何"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "えっ？皆さん、ようこそ。こんにちは。"}, {"type": "subtitle", "time": 11335.269, "timestamp": "03:08:55", "text": "こんにちは。えーと、私は接続を戻したいのですが"}, {"type": "subtitle", "time": 11337.99, "timestamp": "03:08:57", "text": "完全に修正したらストリームが正しく"}]
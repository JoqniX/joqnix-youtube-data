[{"type": "subtitle", "time": 16620.551, "timestamp": "04:37:00", "text": "君の世代の仲間だよね？だから、"}, {"type": "subtitle", "time": 16622.709, "timestamp": "04:37:02", "text": "ええと、たくさんの事例があります"}, {"type": "subtitle", "time": 16625.67, "timestamp": "04:37:05", "text": "次のようなコメントが寄せられます"}, {"type": "subtitle", "time": 16627.59, "timestamp": "04:37:07", "text": "人々があなたを他の世代と比較する"}, {"type": "chat", "time": 16628.452, "timestamp": "04:37:08", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I need to address it right? I need to confront them right? "}, {"type": "subtitle", "time": 16629.99, "timestamp": "04:37:09", "text": "友達とか、そういう類のことだよね？彼らは"}, {"type": "subtitle", "time": 16632.31, "timestamp": "04:37:12", "text": "他の遺伝子に関する話題を取り上げ、"}, {"type": "subtitle", "time": 16635.75, "timestamp": "04:37:15", "text": "もの。だから、あなたがしなければならないことは"}, {"type": "subtitle", "time": 16638.59, "timestamp": "04:37:18", "text": "力と自由を持つ"}, {"type": "subtitle", "time": 16642.551, "timestamp": "04:37:22", "text": "この問題に適切に対処する自由。"}, {"type": "subtitle", "time": 16646.91, "timestamp": "04:37:26", "text": "彼らに「これは私のチャンネルです」と伝えてください。"}, {"type": "subtitle", "time": 16648.91, "timestamp": "04:37:28", "text": "ルールと"}, {"type": "subtitle", "time": 16651.51, "timestamp": "04:37:31", "text": "他の話題を持ち出さないこと"}, {"type": "subtitle", "time": 16654.709, "timestamp": "04:37:34", "text": "私が最初に言及しない限り、YouTuberは対象外です。"}, {"type": "subtitle", "time": 16657.109, "timestamp": "04:37:37", "text": "これらすべては十分なものである"}, {"type": "subtitle", "time": 16660.551, "timestamp": "04:37:40", "text": "彼らに伝えることができること、そして"}, {"type": "subtitle", "time": 16663.83, "timestamp": "04:37:43", "text": "彼らは正しくやる、私と比較しないで"}, {"type": "subtitle", "time": 16666.709, "timestamp": "04:37:46", "text": "例えば冗談を言っている時とか"}, {"type": "subtitle", "time": 16669.67, "timestamp": "04:37:49", "text": "えーっと、からかったりして、"}, {"type": "subtitle", "time": 16672.709, "timestamp": "04:37:52", "text": "何と呼ぶのか、そこに"}, {"type": "subtitle", "time": 16675.109, "timestamp": "04:37:55", "text": "制限して、行き過ぎないようにする"}, {"type": "subtitle", "time": 16677.91, "timestamp": "04:37:57", "text": "行き過ぎたり、そういうことは"}]
[{"type": "subtitle", "time": 3660.789, "timestamp": "01:01:00", "text": "男。旅行に行きたい。訪れたい"}, {"type": "subtitle", "time": 3663.15, "timestamp": "01:01:03", "text": "1位"}, {"type": "subtitle", "time": 3666.549, "timestamp": "01:01:06", "text": "日。ええ、そうですね。だから、これは現在私が"}, {"type": "subtitle", "time": 3667.87, "timestamp": "01:01:07", "text": "ローカルであること"}, {"type": "subtitle", "time": 3672.829, "timestamp": "01:01:12", "text": "ASP。忘れた。ダニエルですか、それとも"}, {"type": "subtitle", "time": 3679.51, "timestamp": "01:01:19", "text": "忘れた。コラーゲンが閉じ込めるだろう。"}, {"type": "subtitle", "time": 3683.109, "timestamp": "01:01:23", "text": "うん、そうするべきだね。そうするべきだ、そうするべきだ。うん、"}, {"type": "subtitle", "time": 3685.57, "timestamp": "01:01:25", "text": "多分しないだろう"}, {"type": "subtitle", "time": 3697.99, "timestamp": "01:01:37", "text": "[音楽]"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "5時間も壁を開けることができなかった。私"}, {"type": "subtitle", "time": 3702.23, "timestamp": "01:01:42", "text": "電波を受信するためにバルコニーに座らなければならなかった。"}, {"type": "subtitle", "time": 3707.109, "timestamp": "01:01:47", "text": "何てことだ。そういう日ってあるよね。ああ、それ"}, {"type": "subtitle", "time": 3711.43, "timestamp": "01:01:51", "text": "えーと、これは私が自分の"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "父が帰ってきた。何てことだ。シグナルは"}, {"type": "subtitle", "time": 3717.43, "timestamp": "01:01:57", "text": "もの。そしてどうやってストリーミング配信したのか"}]
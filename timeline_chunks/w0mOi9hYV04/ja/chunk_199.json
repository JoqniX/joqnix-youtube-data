[{"type": "subtitle", "time": 11943.75, "timestamp": "03:19:03", "text": "えっと、サイゴンの鼻と首の使い方は？うん、"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "Twitterでこれを見て、買いました"}, {"type": "subtitle", "time": 11948.51, "timestamp": "03:19:08", "text": "ランダムなオンラインから即座に"}, {"type": "subtitle", "time": 11962.75, "timestamp": "03:19:22", "text": "[音楽]"}, {"type": "subtitle", "time": 11966.59, "timestamp": "03:19:26", "text": "それ？でも、どこで？どうやって作るの？"}, {"type": "subtitle", "time": 11971.03, "timestamp": "03:19:31", "text": "それ？彼は自分のセットアップには表示されません。私"}, {"type": "subtitle", "time": 11971.79, "timestamp": "03:19:31", "text": "得る"}, {"type": "subtitle", "time": 11974.59, "timestamp": "03:19:34", "text": "これ。私はこうは思っていません"}, {"type": "subtitle", "time": 11978.469, "timestamp": "03:19:38", "text": "今。私はこのやり方はしない。これは"}, {"type": "subtitle", "time": 11981.429, "timestamp": "03:19:41", "text": "手元カメラ配信のためにやったんです。私"}, {"type": "subtitle", "time": 11984.11, "timestamp": "03:19:44", "text": "こういう感じだけど、そうじゃない感じ"}, {"type": "subtitle", "time": 11991.51, "timestamp": "03:19:51", "text": "だから私は横に置いた"}, {"type": "subtitle", "time": 11995.11, "timestamp": "03:19:55", "text": "私が絵を描く場所で、それを展示できる場所。"}]
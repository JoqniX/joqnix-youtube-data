[{"type": "subtitle", "time": 8942.95, "timestamp": "02:29:02", "text": "ビリーのために先へ ビリーは始めなかった"}, {"type": "subtitle", "time": 8945.59, "timestamp": "02:29:05", "text": "もうそんなことはしないで、続けるのが難しいから"}, {"type": "subtitle", "time": 8948.87, "timestamp": "02:29:08", "text": "全員の名前を追跡し、ほんの数人だけ"}, {"type": "subtitle", "time": 8951.03, "timestamp": "02:29:11", "text": "翻訳のおかげで人々はチャットをするようになった"}, {"type": "subtitle", "time": 8954.15, "timestamp": "02:29:14", "text": "中国語が読めないから、いろいろと。"}, {"type": "subtitle", "time": 8958.469, "timestamp": "02:29:18", "text": "ああ、痛い。そこで私はただ"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "皆さんに感謝を述べ、これで終わりにします。"}, {"type": "subtitle", "time": 8963.11, "timestamp": "02:29:23", "text": "そうするべきだ、みんなそうするべきだ"}, {"type": "subtitle", "time": 8965.83, "timestamp": "02:29:25", "text": "そうする。これで大丈夫でしょうか？意思"}, {"type": "subtitle", "time": 8968.469, "timestamp": "02:29:28", "text": "私が電話をしないとみんな悲しむだろう"}, {"type": "subtitle", "time": 8973.19, "timestamp": "02:29:33", "text": "あなたの名前を言って、おやすみなさいと言う？ただ感謝する"}, {"type": "subtitle", "time": 8975.67, "timestamp": "02:29:35", "text": "一般的に。わかった。皆さんがそうおっしゃるなら。"}, {"type": "subtitle", "time": 8978.07, "timestamp": "02:29:38", "text": "わかった、いいよ。"}, {"type": "subtitle", "time": 8979.79, "timestamp": "02:29:39", "text": "やりたくないとか、"}, {"type": "subtitle", "time": 8983.07, "timestamp": "02:29:43", "text": "大丈夫とは程遠い"}, {"type": "subtitle", "time": 8986.87, "timestamp": "02:29:46", "text": "大丈夫。こんにちは。というわけで、皆さんありがとうございました。"}, {"type": "subtitle", "time": 8990.03, "timestamp": "02:29:50", "text": "今日はここまで。ご来場いただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 8993.11, "timestamp": "02:29:53", "text": "TwitchとYouTubeの両方で、"}, {"type": "subtitle", "time": 8996.15, "timestamp": "02:29:56", "text": "この掲示板を見ていて、"}, {"type": "subtitle", "time": 8999.59, "timestamp": "02:29:59", "text": "ストリームで。ありがとう。そして"}]
[{"type": "subtitle", "time": 8042.51, "timestamp": "02:14:02", "text": "テレビだと信じてください。待って、それは"}, {"type": "subtitle", "time": 8045.43, "timestamp": "02:14:05", "text": "テレビ？確かアクティバとかいうやつだったと思う。私"}, {"type": "subtitle", "time": 8047.35, "timestamp": "02:14:07", "text": "わからない。それは私が知っている名前です"}, {"type": "subtitle", "time": 8049.39, "timestamp": "02:14:09", "text": "木星または"}, {"type": "subtitle", "time": 8053.589, "timestamp": "02:14:13", "text": "何か。どちらなのか分かりません。"}, {"type": "subtitle", "time": 8062.149, "timestamp": "02:14:22", "text": "それ以外？でも私のは青みがかった感じ"}, {"type": "subtitle", "time": 8064.51, "timestamp": "02:14:24", "text": "緑色か何か"}, {"type": "subtitle", "time": 8068.95, "timestamp": "02:14:28", "text": "青をミックス＆マッチしたような素材"}, {"type": "subtitle", "time": 8073.669, "timestamp": "02:14:33", "text": "緑がかった。わからない。まあ、そうですね。"}, {"type": "subtitle", "time": 8076.95, "timestamp": "02:14:36", "text": "まあ、そういうことです。来て言って"}, {"type": "subtitle", "time": 8083.87, "timestamp": "02:14:43", "text": "わかった。皆さん、もう行かなくちゃ。"}, {"type": "subtitle", "time": 8086.91, "timestamp": "02:14:46", "text": "こんにちは。取る"}, {"type": "subtitle", "time": 8090.35, "timestamp": "02:14:50", "text": "ケア。つまり、えーと、"}, {"type": "subtitle", "time": 8098.109, "timestamp": "02:14:58", "text": "うん。取る"}]
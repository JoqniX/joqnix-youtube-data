[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "ジョーンさん、配信へようこ​​そ。こんにちは。"}, {"type": "subtitle", "time": 1021.28, "timestamp": "00:17:01", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 1022.59, "timestamp": "00:17:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1026.23, "timestamp": "00:17:06", "text": "いらっしゃいませ。うん。それを実現させよう"}, {"type": "subtitle", "time": 1034.63, "timestamp": "00:17:14", "text": "うん。だから私はちょっとイライラしている"}, {"type": "subtitle", "time": 1035.47, "timestamp": "00:17:15", "text": "による"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "私の道徳的追跡のその瞬間。だから私は"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "切り替える必要があると思う、えっと、私は"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "実際に何に切り替える必要があるか"}, {"type": "subtitle", "time": 1047.909, "timestamp": "00:17:27", "text": "もう一度呼びますか？それは何と呼ばれていますか？"}, {"type": "chat", "time": 1048.877, "timestamp": "00:17:28", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "yo yo yo Jokie bantai"}, {"type": "subtitle", "time": 1052.35, "timestamp": "00:17:32", "text": "また？ウェブカメラ"}, {"type": "subtitle", "time": 1054.87, "timestamp": "00:17:34", "text": "トラック輸送。わからない。ええ、"}, {"type": "subtitle", "time": 1056.71, "timestamp": "00:17:36", "text": "いろいろなことが起こっている。明かすことはできません"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "まだ分​​からないけど、いずれ君たちも分かるよ。"}, {"type": "subtitle", "time": 1060.99, "timestamp": "00:17:40", "text": "それで、"}, {"type": "subtitle", "time": 1063.75, "timestamp": "00:17:43", "text": "うん、楽しみだよ。すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 1066.71, "timestamp": "00:17:46", "text": "うまくいっています。これまでのところ全て順調です"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "計画済み。夢の一つが叶った"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "それはまさに夢が叶ったということだ"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "信じられないほどストリーミング配信されている"}, {"type": "subtitle", "time": 1077.87, "timestamp": "00:17:57", "text": "ええ、そうです"}]
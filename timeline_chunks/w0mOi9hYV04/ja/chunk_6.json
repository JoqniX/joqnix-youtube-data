[{"type": "subtitle", "time": 360.87, "timestamp": "00:06:00", "text": "どんなスープを入れたのか気になります。えっと、それは"}, {"type": "subtitle", "time": 364.55, "timestamp": "00:06:04", "text": "クリームチキンスープか何かだった。"}, {"type": "subtitle", "time": 366.23, "timestamp": "00:06:06", "text": "クリームか何かに関係しているのでしょう。私"}, {"type": "subtitle", "time": 368.309, "timestamp": "00:06:08", "text": "わからない。うん、良かったよ。そうだった"}, {"type": "subtitle", "time": 373.029, "timestamp": "00:06:13", "text": "クリーミーで、うん、美味しかった。甘い。そして"}, {"type": "subtitle", "time": 376.39, "timestamp": "00:06:16", "text": "今日はどんな感じだったかな？チキン"}, {"type": "subtitle", "time": 378.51, "timestamp": "00:06:18", "text": "えーとコーンスープか"}, {"type": "subtitle", "time": 382.629, "timestamp": "00:06:22", "text": "何か。ええ、8つくらいあります"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "さまざまな種類のスープをタイプする。 8つまたは"}, {"type": "subtitle", "time": 387.11, "timestamp": "00:06:27", "text": "6種類の異なるスープ。私"}, {"type": "subtitle", "time": 389.59, "timestamp": "00:06:29", "text": "いつか全部試してみたい。うん。"}, {"type": "subtitle", "time": 391.909, "timestamp": "00:06:31", "text": "うん。全部試してみたいです。だから私は"}, {"type": "subtitle", "time": 394.55, "timestamp": "00:06:34", "text": "毎日積極的にそこに行きたいし"}, {"type": "subtitle", "time": 396.469, "timestamp": "00:06:36", "text": "スクーターに乗ってドライブする"}, {"type": "subtitle", "time": 398.629, "timestamp": "00:06:38", "text": "そこへ行って、あそこに乗って、"}, {"type": "subtitle", "time": 400.71, "timestamp": "00:06:40", "text": "車を停めて、そのまま上へ"}, {"type": "subtitle", "time": 404.749, "timestamp": "00:06:44", "text": "そして、それを持っていて、ただ"}, {"type": "subtitle", "time": 407.629, "timestamp": "00:06:47", "text": "楽しむ。"}, {"type": "subtitle", "time": 411.11, "timestamp": "00:06:51", "text": "うん。えっと、ミアと大学進学。おお、"}, {"type": "subtitle", "time": 413.909, "timestamp": "00:06:53", "text": "あなたはスクーターで大学に通学しています。"}, {"type": "subtitle", "time": 417.83, "timestamp": "00:06:57", "text": "ああ、それは本当に素晴らしいですね。それは素晴らしいですね。"}, {"type": "subtitle", "time": 419.99, "timestamp": "00:06:59", "text": "そうしなければならないと思う"}]
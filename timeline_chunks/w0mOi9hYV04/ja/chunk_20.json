[{"type": "subtitle", "time": 1206.87, "timestamp": "00:20:06", "text": "コンテンツ。違いが生じるだろう"}, {"type": "subtitle", "time": 1210.31, "timestamp": "00:20:10", "text": "これのバリエーションとして考えてください。わかった。だから私は"}, {"type": "subtitle", "time": 1212.63, "timestamp": "00:20:12", "text": "ショート動画やビデオはアップロードしません"}, {"type": "subtitle", "time": 1215.669, "timestamp": "00:20:15", "text": "残念ながら、メインチャンネルにはまだコンテンツがありません。する"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "でも心配はいりません。ほら、それは私に向かっている"}, {"type": "subtitle", "time": 1221.11, "timestamp": "00:20:21", "text": "これについては計画を立ててください。はい、"}, {"type": "subtitle", "time": 1223.27, "timestamp": "00:20:23", "text": "もちろん私の壁に飾るつもりです"}, {"type": "subtitle", "time": 1225.029, "timestamp": "00:20:25", "text": "チャンネル、2番目のチャンネル。あなたはできる"}, {"type": "subtitle", "time": 1226.63, "timestamp": "00:20:26", "text": "セカンドチャンネルと呼ぶか、"}, {"type": "subtitle", "time": 1228.35, "timestamp": "00:20:28", "text": "技術的には2番目"}, {"type": "subtitle", "time": 1231.19, "timestamp": "00:20:31", "text": "チャネル。でも、実は私は"}, {"type": "subtitle", "time": 1233.43, "timestamp": "00:20:33", "text": "新しいチャンネルは作りたくない"}, {"type": "subtitle", "time": 1236.07, "timestamp": "00:20:36", "text": "今のところは、Vチャンネルは維持します"}, {"type": "subtitle", "time": 1239.35, "timestamp": "00:20:39", "text": "今のところ。しばらくの間そうだったように、"}, {"type": "subtitle", "time": 1241.35, "timestamp": "00:20:41", "text": "2年間か、あるいは1年間かな。私はしません"}, {"type": "subtitle", "time": 1243.669, "timestamp": "00:20:43", "text": "いつ作ったかはわからないけど、うん、それは"}, {"type": "subtitle", "time": 1246.789, "timestamp": "00:20:46", "text": "そこにいるよ。私のまだのアイデアプランは、えっと"}, {"type": "subtitle", "time": 1254.63, "timestamp": "00:20:54", "text": "ストリームショットとハイライトまたは"}, {"type": "subtitle", "time": 1257.99, "timestamp": "00:20:57", "text": "えーっと、W の何かみたいな"}]
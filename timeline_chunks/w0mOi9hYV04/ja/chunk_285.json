[{"type": "subtitle", "time": 17102.31, "timestamp": "04:45:02", "text": "置くために"}, {"type": "subtitle", "time": 17106.15, "timestamp": "04:45:06", "text": "えっと、今声に出して言わないといけないよ。おい、"}, {"type": "subtitle", "time": 17108.15, "timestamp": "04:45:08", "text": "私はこのような行為を容認しません"}, {"type": "subtitle", "time": 17111.31, "timestamp": "04:45:11", "text": "私のコミュニティ。これは私のチャンネルです、私の"}, {"type": "subtitle", "time": 17114.47, "timestamp": "04:45:14", "text": "ルール。そして、もしあなたが従わないなら"}, {"type": "subtitle", "time": 17118.868, "timestamp": "04:45:18", "text": "私があなたに守ってほしいこと、そして"}, {"type": "subtitle", "time": 17122.67, "timestamp": "04:45:22", "text": "フォローして、自由に生活して、いろいろやってみて。"}, {"type": "subtitle", "time": 17126.31, "timestamp": "04:45:26", "text": "そう、そんな感じ。あなたはもっと"}, {"type": "subtitle", "time": 17129.19, "timestamp": "04:45:29", "text": "君より大胆だ。軽んじてはいけない"}, {"type": "subtitle", "time": 17132.07, "timestamp": "04:45:32", "text": "あなた自身。感じない、好きじゃない、しない"}, {"type": "subtitle", "time": 17133.07, "timestamp": "04:45:33", "text": "私の"}, {"type": "subtitle", "time": 17135.75, "timestamp": "04:45:35", "text": "私が犯している間違い。やめてください"}, {"type": "subtitle", "time": 17137.91, "timestamp": "04:45:37", "text": "視聴者が見に来るように"}, {"type": "subtitle", "time": 17141.35, "timestamp": "04:45:41", "text": "あなたとか何かとか、そういうことはしないで"}, {"type": "subtitle", "time": 17145.31, "timestamp": "04:45:45", "text": "それ。私は自分の経験から多くを学んだ"}, {"type": "subtitle", "time": 17148.83, "timestamp": "04:45:48", "text": "間違いと、えっと"}, {"type": "subtitle", "time": 17152.55, "timestamp": "04:45:52", "text": "うん、他の人にも行ってほしくない"}, {"type": "subtitle", "time": 17156.07, "timestamp": "04:45:56", "text": "同じことを通して、また、それは"}, {"type": "subtitle", "time": 17158.07, "timestamp": "04:45:58", "text": "自分の形を整えるには時間がかかる"}]
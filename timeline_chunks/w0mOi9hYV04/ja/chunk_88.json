[{"type": "subtitle", "time": 5280.39, "timestamp": "01:28:00", "text": "私の誕生日はです。ええ、もし"}, {"type": "subtitle", "time": 5283.51, "timestamp": "01:28:03", "text": "誰でも忘れるものだ。私はそんなこと全くしていません"}, {"type": "subtitle", "time": 5285.43, "timestamp": "01:28:05", "text": "ただ人々が"}, {"type": "subtitle", "time": 5292.87, "timestamp": "01:28:12", "text": "何もない。楽しかったのは確かだ。楽しいです"}, {"type": "subtitle", "time": 5294.95, "timestamp": "01:28:14", "text": "あなたをからかうため。待って、あれはあなただったの？"}, {"type": "subtitle", "time": 5297.39, "timestamp": "01:28:17", "text": "私をからかっている。待って、"}, {"type": "subtitle", "time": 5300.71, "timestamp": "01:28:20", "text": "何？何てことだ。"}, {"type": "subtitle", "time": 5302.91, "timestamp": "01:28:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5305.629, "timestamp": "01:28:25", "text": "おお。ヴァ"}, {"type": "subtitle", "time": 5313.95, "timestamp": "01:28:33", "text": "水。少し分けてください"}, {"type": "subtitle", "time": 5316.55, "timestamp": "01:28:36", "text": "水。こんにちは、ザキトラベルさん。ようこそ"}, {"type": "subtitle", "time": 5318.51, "timestamp": "01:28:38", "text": "小川。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 5321.65, "timestamp": "01:28:41", "text": "良い。だった"}, {"type": "subtitle", "time": 5324.189, "timestamp": "01:28:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5333.07, "timestamp": "01:28:53", "text": "水。ええ、そうです"}, {"type": "subtitle", "time": 5336.07, "timestamp": "01:28:56", "text": "熱い。 4月16日。今日は誰の誕生日ですか？"}, {"type": "subtitle", "time": 5338.11, "timestamp": "01:28:58", "text": "えっと、ニンジャの誕生日。"}]
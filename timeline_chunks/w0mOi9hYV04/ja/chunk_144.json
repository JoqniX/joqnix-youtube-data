[{"type": "subtitle", "time": 8641.11, "timestamp": "02:24:01", "text": "もっと西洋風にしたい"}, {"type": "subtitle", "time": 8642.71, "timestamp": "02:24:02", "text": "観客。"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "私はインド時間帯に満足しています"}, {"type": "subtitle", "time": 8650.309, "timestamp": "02:24:10", "text": "いろいろあるけど、たぶん私は"}, {"type": "subtitle", "time": 8653.27, "timestamp": "02:24:13", "text": "朝にストリーミング配信とか、"}, {"type": "subtitle", "time": 8655.51, "timestamp": "02:24:15", "text": "それらはインド人にとってあまり友好的ではない"}, {"type": "subtitle", "time": 8658.07, "timestamp": "02:24:18", "text": "時間。だから、私は"}, {"type": "subtitle", "time": 8662.95, "timestamp": "02:24:22", "text": "タイムゾーン、どの時間帯に合うか"}, {"type": "subtitle", "time": 8667.07, "timestamp": "02:24:27", "text": "EUタイプやNAタイプが好きな人は、"}, {"type": "subtitle", "time": 8671.95, "timestamp": "02:24:31", "text": "知る。うん。朝に"}, {"type": "subtitle", "time": 8674.19, "timestamp": "02:24:34", "text": "時間 私はそうしない"}, {"type": "subtitle", "time": 8677.389, "timestamp": "02:24:37", "text": "ストリーミング配信のことさえ考えたことがある"}, {"type": "subtitle", "time": 8680.55, "timestamp": "02:24:40", "text": "6時30分ですが、ただ私には必要なのです"}, {"type": "subtitle", "time": 8682.67, "timestamp": "02:24:42", "text": "人々が来る"}, {"type": "subtitle", "time": 8685.469, "timestamp": "02:24:45", "text": "でも、それが問題なんだけど"}, {"type": "subtitle", "time": 8688.63, "timestamp": "02:24:48", "text": "痛みがあって、午前2時半から3時まで眠れません。"}, {"type": "subtitle", "time": 8690.07, "timestamp": "02:24:50", "text": "最初は起き上がってから"}, {"type": "subtitle", "time": 8696.23, "timestamp": "02:24:56", "text": "わあ、それってまさに私のスケジュールだわ"}, {"type": "subtitle", "time": 8698.51, "timestamp": "02:24:58", "text": "最近では。私はしない"}]
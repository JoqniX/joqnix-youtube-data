[{"type": "subtitle", "time": 8460.309, "timestamp": "02:21:00", "text": "よし、私は良いFPSゲームをプレイしたい"}, {"type": "subtitle", "time": 8462.11, "timestamp": "02:21:02", "text": "今では見つけられない"}, {"type": "subtitle", "time": 8466.63, "timestamp": "02:21:06", "text": "1つ。ああ、ただプレイしたり見たりすればいいよ"}, {"type": "subtitle", "time": 8469.51, "timestamp": "02:21:09", "text": "無料のFPSゲームみたいなもの、"}, {"type": "subtitle", "time": 8471.349, "timestamp": "02:21:11", "text": "無料で遊べるゲーム。いくつかあります"}, {"type": "subtitle", "time": 8474.55, "timestamp": "02:21:14", "text": "良いもの、またはただ買うことができます"}, {"type": "subtitle", "time": 8478.03, "timestamp": "02:21:18", "text": "新しいのを買うとか、有料版を買うとか。私"}, {"type": "subtitle", "time": 8490.79, "timestamp": "02:21:30", "text": "はい、おそらく3月でしょう。"}, {"type": "subtitle", "time": 8492.87, "timestamp": "02:21:32", "text": "2月はあと数ヶ月で終わる"}, {"type": "subtitle", "time": 8493.71, "timestamp": "02:21:33", "text": "の"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "えっと、来週の木曜日ですね"}, {"type": "subtitle", "time": 8499.71, "timestamp": "02:21:39", "text": "2月は終わり、"}, {"type": "subtitle", "time": 8502.71, "timestamp": "02:21:42", "text": "3月、そして3月には"}, {"type": "subtitle", "time": 8505.03, "timestamp": "02:21:45", "text": "その頃にはPALワールドのストリームは大丈夫になっているはずです"}, {"type": "subtitle", "time": 8508.23, "timestamp": "02:21:48", "text": "おそらく依頼された仕事は終わらせるでしょう。私はします"}, {"type": "subtitle", "time": 8512.75, "timestamp": "02:21:52", "text": "それをプロルスーパーにしたくない"}, {"type": "subtitle", "time": 8516.15, "timestamp": "02:21:56", "text": "長生きした男。つまり、それは主に私の"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "時間管理。理解しなければならない"}, {"type": "subtitle", "time": 8519.83, "timestamp": "02:21:59", "text": "まるで私が依頼を受けて仕事をしているかのように"}]
[{"type": "subtitle", "time": 3242.71, "timestamp": "00:54:02", "text": "ああ、男性のような人たち"}, {"type": "subtitle", "time": 3247.23, "timestamp": "00:54:07", "text": "PPPO と同様、PPPO ではなく SL Lo インサート"}, {"type": "subtitle", "time": 3252.03, "timestamp": "00:54:12", "text": "挿入物から剣がぶつかり合う音が聞こえる。"}, {"type": "subtitle", "time": 3254.79, "timestamp": "00:54:14", "text": "そう、そんな感じ。どのアニメだったか"}, {"type": "subtitle", "time": 3257.67, "timestamp": "00:54:17", "text": "また？えっと"}, {"type": "subtitle", "time": 3259.589, "timestamp": "00:54:19", "text": "えーと、最近公開されたそのチラ見せ映像"}, {"type": "subtitle", "time": 3261.43, "timestamp": "00:54:21", "text": "エピソード。こうなるんじゃないの？"}, {"type": "subtitle", "time": 3263.069, "timestamp": "00:54:23", "text": "今週ですか、それとも来週ですか？私"}, {"type": "subtitle", "time": 3267.75, "timestamp": "00:54:27", "text": "忘れた。えーっと、ループ7のことです"}, {"type": "subtitle", "time": 3271.99, "timestamp": "00:54:31", "text": "えっと、あの、あの悪役アニメ。"}, {"type": "subtitle", "time": 3275.069, "timestamp": "00:54:35", "text": "それは文字通り彼女がヴィグを手に入れたことを示している"}, {"type": "subtitle", "time": 3278.71, "timestamp": "00:54:38", "text": "そして彼女は軍隊に溶け込んでいる"}, {"type": "subtitle", "time": 3281.15, "timestamp": "00:54:41", "text": "えっと、剣を手に入れよう"}, {"type": "subtitle", "time": 3282.75, "timestamp": "00:54:42", "text": "練習する。"}, {"type": "subtitle", "time": 3285.51, "timestamp": "00:54:45", "text": "えっと、もっと女の子が増えるよ。"}, {"type": "subtitle", "time": 3289.589, "timestamp": "00:54:49", "text": "いや、ただ言ってるだけだよ。わかった。私"}, {"type": "subtitle", "time": 3292.71, "timestamp": "00:54:52", "text": "つまり、私のデザインは変わらないかもしれない、"}, {"type": "subtitle", "time": 3295.75, "timestamp": "00:54:55", "text": "でも私はただ髪を長くしたかっただけなんです。"}, {"type": "subtitle", "time": 3298.47, "timestamp": "00:54:58", "text": "あなたが知っている？いつもの私のやり方はご存知の通り"}]
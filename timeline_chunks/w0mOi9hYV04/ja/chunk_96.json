[{"type": "subtitle", "time": 5761.669, "timestamp": "01:36:01", "text": "痛み、えっと、待って。はい、キャンセルします。おお、"}, {"type": "subtitle", "time": 5763.75, "timestamp": "01:36:03", "text": "待って。あなたの商品とはどういう意味ですか？"}, {"type": "subtitle", "time": 5766.95, "timestamp": "01:36:06", "text": "ええ、おそらく来るでしょう。ない"}, {"type": "subtitle", "time": 5770.31, "timestamp": "01:36:10", "text": "約束はできません。今年こそは。"}, {"type": "subtitle", "time": 5774.229, "timestamp": "01:36:14", "text": "おそらく。うまくいけばプロになる可能性が高い"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "そして私は"}, {"type": "subtitle", "time": 5779.11, "timestamp": "01:36:19", "text": "えっと、今年か来年買います。それ"}, {"type": "subtitle", "time": 5788.31, "timestamp": "01:36:28", "text": "えーっと、スーパーチャットとか全部解除して、"}, {"type": "subtitle", "time": 5790.55, "timestamp": "01:36:30", "text": "推測。ああ、だって、だって、支払わなきゃいけないんだもん"}, {"type": "subtitle", "time": 5793.99, "timestamp": "01:36:33", "text": "提供された商品とそれらすべて"}, {"type": "subtitle", "time": 5796.79, "timestamp": "01:36:36", "text": "それら全てが今や。ああ、そうだね。えっと"}, {"type": "subtitle", "time": 5798.95, "timestamp": "01:36:38", "text": "うん。うん。うん。えっと、いくつかください"}, {"type": "subtitle", "time": 5801.43, "timestamp": "01:36:41", "text": "人々はそれに取り組んでいる。でも、ええ、"}, {"type": "subtitle", "time": 5803.59, "timestamp": "01:36:43", "text": "今年か来年には"}, {"type": "subtitle", "time": 5806.47, "timestamp": "01:36:46", "text": "おそらく。わかりません。そして私は"}, {"type": "subtitle", "time": 5809.79, "timestamp": "01:36:49", "text": "できません。この件については私の発言を引用しないでください。"}, {"type": "subtitle", "time": 5813.189, "timestamp": "01:36:53", "text": "わかった。えっと、私の最初のグッズは"}, {"type": "subtitle", "time": 5815.91, "timestamp": "01:36:55", "text": "あなたがそれを公開するなら、それはあなたのものになります。"}, {"type": "subtitle", "time": 5818.27, "timestamp": "01:36:58", "text": "はい、最善を尽くします。"}]
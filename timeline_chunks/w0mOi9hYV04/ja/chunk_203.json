[{"type": "subtitle", "time": 12181.79, "timestamp": "03:23:01", "text": "ここ。マウスパッドはここから"}, {"type": "subtitle", "time": 12184.75, "timestamp": "03:23:04", "text": "ここ。マウスパッドは"}, {"type": "subtitle", "time": 12187.269, "timestamp": "03:23:07", "text": "ここ。えっと、"}, {"type": "subtitle", "time": 12191.83, "timestamp": "03:23:11", "text": "など。それで、私がどのようにやったかというと、"}, {"type": "subtitle", "time": 12195.99, "timestamp": "03:23:15", "text": "まるで私がここに取り付けたかのようにやってみて"}, {"type": "subtitle", "time": 12198.67, "timestamp": "03:23:18", "text": "そして私はそれをここに持ってきて、"}, {"type": "subtitle", "time": 12202.349, "timestamp": "03:23:22", "text": "ひねり、ひねり。私はこうしました"}, {"type": "subtitle", "time": 12206.389, "timestamp": "03:23:26", "text": "これを置いて、ここに電話を置いてください。わかった。は"}, {"type": "subtitle", "time": 12208.75, "timestamp": "03:23:28", "text": "見ることができるし"}, {"type": "subtitle", "time": 12211.03, "timestamp": "03:23:31", "text": "理解する？うん。私はこうやってやった"}, {"type": "subtitle", "time": 12213.429, "timestamp": "03:23:33", "text": "それ。わかった。はい、そうしました。私はそれを作りました"}, {"type": "subtitle", "time": 12217.19, "timestamp": "03:23:37", "text": "ちょっと回転させてみたんです。だからこれは"}, {"type": "subtitle", "time": 12220.59, "timestamp": "03:23:40", "text": "モニターの焦点を合わせるのに少し苦労した。"}, {"type": "subtitle", "time": 12225.91, "timestamp": "03:23:45", "text": "今、私はそれを下ろした。それで"}, {"type": "subtitle", "time": 12227.469, "timestamp": "03:23:47", "text": "えっと、私は作っているの？"}, {"type": "subtitle", "time": 12230.79, "timestamp": "03:23:50", "text": "センス？それで、私が今やったことは"}, {"type": "subtitle", "time": 12233.51, "timestamp": "03:23:53", "text": "こちら側にあります。 3つ目はこれです"}, {"type": "subtitle", "time": 12237.229, "timestamp": "03:23:57", "text": "底面。それで私はそれを固定した"}]
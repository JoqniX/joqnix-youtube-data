[{"type": "subtitle", "time": 18720.83, "timestamp": "05:12:00", "text": "言っているの？はい、忘れていました"}, {"type": "subtitle", "time": 18723.23, "timestamp": "05:12:03", "text": "ADSD。"}, {"type": "subtitle", "time": 18726.47, "timestamp": "05:12:06", "text": "ええ、そうですね。ええ、人は前に進むものです。そして"}, {"type": "subtitle", "time": 18728.47, "timestamp": "05:12:08", "text": "より広い空間にいるとき、より広い空間にいるとき"}, {"type": "chat", "time": 18730.752, "timestamp": "05:12:10", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "LOL JOQ MOMENT "}, {"type": "subtitle", "time": 18730.868, "timestamp": "05:12:10", "text": "時間、より大きなレベルで、一部の人々は"}, {"type": "subtitle", "time": 18733.11, "timestamp": "05:12:13", "text": "先に進むか、他の人がどうするか"}, {"type": "subtitle", "time": 18735.51, "timestamp": "05:12:15", "text": "何か何か。でも少なくともそれは"}, {"type": "subtitle", "time": 18737.43, "timestamp": "05:12:17", "text": "あなたの心の中に。それはあなたの記憶の中にある"}, {"type": "subtitle", "time": 18739.91, "timestamp": "05:12:19", "text": "ああ、かつては見ていた人たちがいた"}, {"type": "subtitle", "time": 18742.23, "timestamp": "05:12:22", "text": "自分。彼らはまだどこかにいるはずだ。"}, {"type": "subtitle", "time": 18744.708, "timestamp": "05:12:24", "text": "彼らの幸運を祈っています。たとえ彼らが"}, {"type": "subtitle", "time": 18746.59, "timestamp": "05:12:26", "text": "私を見ないで、私は彼らの幸せを願っています"}, {"type": "subtitle", "time": 18748.948, "timestamp": "05:12:28", "text": "運。彼らが誰を支持していようと"}, {"type": "subtitle", "time": 18750.788, "timestamp": "05:12:30", "text": "彼らが私の配信に来て、"}, {"type": "subtitle", "time": 18755.39, "timestamp": "05:12:35", "text": "時間を割いてサポートしてくれたので、楽しかったです。"}, {"type": "subtitle", "time": 18759.03, "timestamp": "05:12:39", "text": "それを見て、私は幸せになった。"}, {"type": "subtitle", "time": 18762.23, "timestamp": "05:12:42", "text": "それは私をこれまでで一番幸せな人にした"}, {"type": "subtitle", "time": 18765.99, "timestamp": "05:12:45", "text": "この世界では、彼らが来て私を見ていた"}]
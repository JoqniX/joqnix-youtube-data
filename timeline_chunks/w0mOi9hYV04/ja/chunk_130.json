[{"type": "subtitle", "time": 7802.149, "timestamp": "02:10:02", "text": "もしそれが私、ジョックに関係することなら"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "彼らにスポーツマンをあげようと思う"}, {"type": "subtitle", "time": 7808.03, "timestamp": "02:10:08", "text": "電話番号、つまり仕事用の電話番号のことです。"}, {"type": "subtitle", "time": 7810.229, "timestamp": "02:10:10", "text": "あなたが旅行していた場所の番号は何ですか？"}, {"type": "subtitle", "time": 7812.589, "timestamp": "02:10:12", "text": "最近は家にいることが多いですね"}, {"type": "subtitle", "time": 7833.75, "timestamp": "02:10:33", "text": "理由？待って、理由は何だったの？"}, {"type": "subtitle", "time": 7838.91, "timestamp": "02:10:38", "text": "ああ、ママママが訪れただけ"}, {"type": "subtitle", "time": 7842.83, "timestamp": "02:10:42", "text": "えっと、ママの次は"}, {"type": "subtitle", "time": 7851.91, "timestamp": "02:10:51", "text": "も、そういうのが好きで、泣いたり、"}, {"type": "subtitle", "time": 7853.069, "timestamp": "02:10:53", "text": "もの"}, {"type": "subtitle", "time": 7858.39, "timestamp": "02:10:58", "text": "家に帰ってきて、"}]
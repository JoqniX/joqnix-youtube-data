[{"type": "subtitle", "time": 18420.788, "timestamp": "05:07:00", "text": "その配信者と楽しくチャットしましたか？私は"}, {"type": "subtitle", "time": 18422.31, "timestamp": "05:07:02", "text": "あまり面白くないとか？そして"}, {"type": "subtitle", "time": 18424.55, "timestamp": "05:07:04", "text": "だから私も以前は自分を他人と比べていた"}, {"type": "subtitle", "time": 18427.67, "timestamp": "05:07:07", "text": "毒のような感覚になり、"}, {"type": "subtitle", "time": 18430.47, "timestamp": "05:07:10", "text": "私は今でもこの経験を後悔している"}, {"type": "subtitle", "time": 18433.11, "timestamp": "05:07:13", "text": "今はその段階です。そう、これが顔だ"}, {"type": "subtitle", "time": 18435.948, "timestamp": "05:07:15", "text": "他のクリエイターなら誰でも"}, {"type": "chat", "time": 18437.737, "timestamp": "05:07:17", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Ah that sucks, i think im doing the same "}, {"type": "subtitle", "time": 18439.51, "timestamp": "05:07:19", "text": "通った、ですよね？それ。最初は"}, {"type": "subtitle", "time": 18444.27, "timestamp": "05:07:24", "text": "ゼリーのような感触、または感じるような"}, {"type": "subtitle", "time": 18447.708, "timestamp": "05:07:27", "text": "まあ、そういうことだけど、"}, {"type": "subtitle", "time": 18450.75, "timestamp": "05:07:30", "text": "常に"}, {"type": "subtitle", "time": 18454.15, "timestamp": "05:07:34", "text": "どんなニッチ市場でも、何でも競争は存在する。"}, {"type": "subtitle", "time": 18456.708, "timestamp": "05:07:36", "text": "もっと優れた芸術家が現れるだろう"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "あなたよりも。もっと良くなるだろう"}, {"type": "chat", "time": 18458.695, "timestamp": "05:07:38", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "it's a cannon event"}, {"type": "subtitle", "time": 18460.51, "timestamp": "05:07:40", "text": "君より歌が上手いよ。これから"}, {"type": "subtitle", "time": 18464.55, "timestamp": "05:07:44", "text": "どんな形であれ、より良い人々"}, {"type": "subtitle", "time": 18467.11, "timestamp": "05:07:47", "text": "あなたですよね？たとえあなたが20歳や30歳であっても"}, {"type": "subtitle", "time": 18469.83, "timestamp": "05:07:49", "text": "何年も前からあなたのやっていることをしていますが"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "情熱的にプレイしよう、例えば"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "ピアニストか何かが"}, {"type": "subtitle", "time": 18476.628, "timestamp": "05:07:56", "text": "9歳の天才児で、"}]
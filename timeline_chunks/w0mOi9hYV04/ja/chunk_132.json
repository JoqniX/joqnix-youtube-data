[{"type": "subtitle", "time": 7920.43, "timestamp": "02:12:00", "text": "1"}, {"type": "subtitle", "time": 7922.91, "timestamp": "02:12:02", "text": "スクーター？何が"}, {"type": "subtitle", "time": 7926.47, "timestamp": "02:12:06", "text": "それ？ 2つ参照した後、彼らは"}, {"type": "subtitle", "time": 7929.709, "timestamp": "02:12:09", "text": "起源と継続の度合いが異なる。"}, {"type": "subtitle", "time": 7933.27, "timestamp": "02:12:13", "text": "えっと、デザインと"}, {"type": "subtitle", "time": 7936.39, "timestamp": "02:12:16", "text": "ああ、わかりました。はい、わかりました。つまり、"}, {"type": "subtitle", "time": 7946.669, "timestamp": "02:12:26", "text": "アンジェラと数秒間話した。待って、"}, {"type": "subtitle", "time": 7953.83, "timestamp": "02:12:33", "text": "何？ええ、翻訳がおかしいですね。"}, {"type": "subtitle", "time": 7956.95, "timestamp": "02:12:36", "text": "ほら、これが私が生きなければならない世界なんだ"}, {"type": "subtitle", "time": 7959.91, "timestamp": "02:12:39", "text": "と。そして、それは主に"}, {"type": "subtitle", "time": 7964.55, "timestamp": "02:12:44", "text": "私のアクセントとか、そういうこと。えっと、教えてください"}, {"type": "subtitle", "time": 7966.87, "timestamp": "02:12:46", "text": "スクーターまたはスクーター。それは"}, {"type": "subtitle", "time": 7970.31, "timestamp": "02:12:50", "text": "スクーター？質問。待って。"}]
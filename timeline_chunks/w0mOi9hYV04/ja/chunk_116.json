[{"type": "subtitle", "time": 6960.99, "timestamp": "01:56:00", "text": "文字通り、彼女がヴィグを手に入れたことを示しています"}, {"type": "subtitle", "time": 6964.55, "timestamp": "01:56:04", "text": "そして彼女は軍隊に溶け込んでいる"}, {"type": "subtitle", "time": 6966.99, "timestamp": "01:56:06", "text": "えっと、剣を手に入れよう"}, {"type": "subtitle", "time": 6970.31, "timestamp": "01:56:10", "text": "練習する。えっと、つまり、あなたは"}, {"type": "subtitle", "time": 6974.07, "timestamp": "01:56:14", "text": "もっと女の子を。いいえ、ただ、ただ"}, {"type": "subtitle", "time": 6977.03, "timestamp": "01:56:17", "text": "と言っている。わかった。つまり、えーと、私のデザインは"}, {"type": "subtitle", "time": 6980.07, "timestamp": "01:56:20", "text": "変わらないかもしれないけど、ただ"}, {"type": "subtitle", "time": 6983.03, "timestamp": "01:56:23", "text": "長い髪みたいにね、ほら、君みたいに"}, {"type": "subtitle", "time": 6985.109, "timestamp": "01:56:25", "text": "私がいつも女性と付き合っているのは知っているでしょう"}, {"type": "subtitle", "time": 6987.35, "timestamp": "01:56:27", "text": "ボブカットのような短い髪型のキャラクター"}, {"type": "subtitle", "time": 6990.669, "timestamp": "01:56:30", "text": "ヘアスタイルですよね？うん。次のような"}, {"type": "subtitle", "time": 6994.91, "timestamp": "01:56:34", "text": "ウム・シン・ユン・ウから"}, {"type": "subtitle", "time": 6997.51, "timestamp": "01:56:37", "text": "えっと、原神か何かから。私はしません"}, {"type": "subtitle", "time": 7004.75, "timestamp": "01:56:44", "text": "うーん、わからない。多分。"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "M 頭髪が長い。ええ、いずれは"}, {"type": "subtitle", "time": 7010.669, "timestamp": "01:56:50", "text": "それは進化のようなものだ。次のように考えてみてください"}, {"type": "subtitle", "time": 7013.75, "timestamp": "01:56:53", "text": "もちろん、私には言いたいことがあるでしょう"}, {"type": "subtitle", "time": 7016.629, "timestamp": "01:56:56", "text": "私は大きくて長い髪をしていて、"}, {"type": "subtitle", "time": 7019.189, "timestamp": "01:56:59", "text": "私はそれを自分のものにしている、まるで出てくるように"}]
[{"type": "subtitle", "time": 13320.469, "timestamp": "03:42:00", "text": "上向き。今、大きな隔たりが生じている。うん、"}, {"type": "subtitle", "time": 13322.71, "timestamp": "03:42:02", "text": "私がやったことは、ここにスタンドを置いて"}, {"type": "subtitle", "time": 13325.07, "timestamp": "03:42:05", "text": "私はこうしました"}, {"type": "subtitle", "time": 13329.79, "timestamp": "03:42:09", "text": "これ。電話はここにありますし、私は"}, {"type": "subtitle", "time": 13333.83, "timestamp": "03:42:13", "text": "ここ。ジョックもここにいるし、私もここにいる"}, {"type": "subtitle", "time": 13336.55, "timestamp": "03:42:16", "text": "そうしている。だから今私が欲しいのはこれだけ"}, {"type": "subtitle", "time": 13339.469, "timestamp": "03:42:19", "text": "これは角にしか合わない"}, {"type": "subtitle", "time": 13343.349, "timestamp": "03:42:23", "text": "多くの。それでおしまい。以前はフィッティングだった"}, {"type": "subtitle", "time": 13351.349, "timestamp": "03:42:31", "text": "でも、あなたは理解していますよね？私の絵は"}, {"type": "subtitle", "time": 13355.11, "timestamp": "03:42:35", "text": "痛みを見せる。だから誰もいなくても大丈夫です"}]
[{"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "ニース。私は何を言おうとしていたんだろう？なぜ"}, {"type": "subtitle", "time": 7640.589, "timestamp": "02:07:20", "text": "こんなに簡単？デリー"}, {"type": "subtitle", "time": 7643.51, "timestamp": "02:07:23", "text": "コミコンは前述の文脈に沿う。"}, {"type": "subtitle", "time": 7646.43, "timestamp": "02:07:26", "text": "わかった。コンテクスト。私はこう言っているのです。"}, {"type": "subtitle", "time": 7649.99, "timestamp": "02:07:29", "text": "コミコン。彼に息をさせてあげて。うん。私は必要としている"}, {"type": "subtitle", "time": 7657.27, "timestamp": "02:07:37", "text": "呼吸。いやあ、本当に久しぶりだね。私"}, {"type": "subtitle", "time": 7659.43, "timestamp": "02:07:39", "text": "そうしました。だから、今日は楽しんでいます。私は"}, {"type": "subtitle", "time": 7662.069, "timestamp": "02:07:42", "text": "ハッピー。皆さんがリラックスして過ごしていることを願っています。"}, {"type": "subtitle", "time": 7675.589, "timestamp": "02:07:55", "text": "男の子。そうそう。えっと、どこまで話したっけ？どこに"}, {"type": "subtitle", "time": 7678.95, "timestamp": "02:07:58", "text": "私？私はどこまで話したっけ？私はどこまで話したっけ？ 100とは何ですか"}]
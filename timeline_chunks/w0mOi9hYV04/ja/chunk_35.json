[{"type": "subtitle", "time": 2102.39, "timestamp": "00:35:02", "text": "えーっと、スーパーチャットとか全部解除して、"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "推測。ああ、だって、だって、支払わなきゃいけないんだもん"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "提供された商品とそれらすべて"}, {"type": "subtitle", "time": 2110.87, "timestamp": "00:35:10", "text": "それら全てが今や。ああ、そうだね。えっと"}, {"type": "subtitle", "time": 2113.03, "timestamp": "00:35:13", "text": "うん。うん。ええ、いくつかいただきます"}, {"type": "subtitle", "time": 2115.589, "timestamp": "00:35:15", "text": "人々はそれに取り組んでいる。でも、もし"}, {"type": "subtitle", "time": 2117.67, "timestamp": "00:35:17", "text": "今年か来年には"}, {"type": "subtitle", "time": 2120.55, "timestamp": "00:35:20", "text": "多分できない、わからないし、"}, {"type": "subtitle", "time": 2123.95, "timestamp": "00:35:23", "text": "これは断言できないので、引用しないでください。"}, {"type": "subtitle", "time": 2127.589, "timestamp": "00:35:27", "text": "わかった。えっと、私の最初のマーは"}, {"type": "subtitle", "time": 2130.71, "timestamp": "00:35:30", "text": "もし私がそれを公開することがあれば、それはあなたのものです。うん、そうするよ"}, {"type": "subtitle", "time": 2132.349, "timestamp": "00:35:32", "text": "最善を尽くします。"}, {"type": "subtitle", "time": 2137.109, "timestamp": "00:35:37", "text": "ええ、私も作りました、私も試しました"}, {"type": "subtitle", "time": 2140.79, "timestamp": "00:35:40", "text": "収益化されたもののようなものを作る"}, {"type": "subtitle", "time": 2142.99, "timestamp": "00:35:42", "text": "収益化または類似"}, {"type": "subtitle", "time": 2147.95, "timestamp": "00:35:47", "text": "最近、サポーター専用のウェブサイトが開設されました。"}, {"type": "subtitle", "time": 2152.349, "timestamp": "00:35:52", "text": "えっと、でもそれは良いことだけど、でもでも"}, {"type": "subtitle", "time": 2156.03, "timestamp": "00:35:56", "text": "でも、それは持っている"}, {"type": "subtitle", "time": 2158.109, "timestamp": "00:35:58", "text": "問題"}]
[{"type": "subtitle", "time": 4860.07, "timestamp": "01:21:00", "text": "将来、私はそれを取り戻すことができる"}, {"type": "subtitle", "time": 4862.39, "timestamp": "01:21:02", "text": "ショート動画や教育コンテンツ"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "それ。ええ、たぶんこうすればいいと思います"}, {"type": "subtitle", "time": 4867.47, "timestamp": "01:21:07", "text": "それ。なぜ"}, {"type": "subtitle", "time": 4870.63, "timestamp": "01:21:10", "text": "ない？そうやってやればいいんです。なぜだめですか？"}, {"type": "subtitle", "time": 4872.11, "timestamp": "01:21:12", "text": "うん。うん。"}, {"type": "subtitle", "time": 4877.55, "timestamp": "01:21:17", "text": "うん。こんにちは。いらっしゃいませ。私はジョックです、来ました"}, {"type": "subtitle", "time": 4879.07, "timestamp": "01:21:19", "text": "横切って"}, {"type": "subtitle", "time": 4882.35, "timestamp": "01:21:22", "text": "250米ドル以上"}, {"type": "subtitle", "time": 4884.189, "timestamp": "01:21:24", "text": "音楽。"}, {"type": "subtitle", "time": 4885.79, "timestamp": "01:21:25", "text": "何？"}, {"type": "subtitle", "time": 4892.709, "timestamp": "01:21:32", "text": "コンテンツ。違いが生じるだろう"}, {"type": "subtitle", "time": 4896.149, "timestamp": "01:21:36", "text": "これのバリエーションとして考えてください。わかった。だから私は"}, {"type": "subtitle", "time": 4898.47, "timestamp": "01:21:38", "text": "ショート動画やビデオはアップロードしません"}, {"type": "subtitle", "time": 4901.51, "timestamp": "01:21:41", "text": "残念ながら、メインチャンネルにはまだコンテンツがありません。する"}, {"type": "subtitle", "time": 4904.63, "timestamp": "01:21:44", "text": "でも心配はいりません。ほら、それは私に向かっている"}, {"type": "subtitle", "time": 4906.95, "timestamp": "01:21:46", "text": "これについては計画を立ててください。はい、"}, {"type": "subtitle", "time": 4909.189, "timestamp": "01:21:49", "text": "もちろん私の壁に飾るつもりです"}, {"type": "subtitle", "time": 4910.95, "timestamp": "01:21:50", "text": "チャンネル、2番目のチャンネル。あなたはできる"}, {"type": "subtitle", "time": 4912.55, "timestamp": "01:21:52", "text": "セカンドチャンネルと呼ぶか、"}, {"type": "subtitle", "time": 4914.189, "timestamp": "01:21:54", "text": "技術的には2番目"}, {"type": "subtitle", "time": 4917.03, "timestamp": "01:21:57", "text": "チャネル。でも、実は私は"}, {"type": "subtitle", "time": 4919.35, "timestamp": "01:21:59", "text": "新しいチャンネルは作りたくない"}]
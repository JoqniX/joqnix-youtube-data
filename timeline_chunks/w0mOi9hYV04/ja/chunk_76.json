[{"type": "subtitle", "time": 4560.03, "timestamp": "01:16:00", "text": "えーっと"}, {"type": "subtitle", "time": 4563.83, "timestamp": "01:16:03", "text": "仕事、それにはたくさんの仕事がある。だから私は"}, {"type": "subtitle", "time": 4566.03, "timestamp": "01:16:06", "text": "あまり多くは語れません"}, {"type": "subtitle", "time": 4569.03, "timestamp": "01:16:09", "text": "残念ながら、すべてが"}, {"type": "subtitle", "time": 4578.83, "timestamp": "01:16:18", "text": "ビッシュ。でも、私は"}, {"type": "subtitle", "time": 4586.189, "timestamp": "01:16:26", "text": "良い。"}, {"type": "subtitle", "time": 4600.229, "timestamp": "01:16:40", "text": "戻る。ああ、君は学んでいるんだね"}, {"type": "subtitle", "time": 4602.79, "timestamp": "01:16:42", "text": "スペイン語。ニース。もう一つ。いいぞ、いいぞ、"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "よかったね。私にとっては、私は学ばなければならない"}, {"type": "subtitle", "time": 4609.43, "timestamp": "01:16:49", "text": "日本語、日本語を直してください。えっと"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "最近、アリスと遊んでいた"}, {"type": "subtitle", "time": 4614.79, "timestamp": "01:16:54", "text": "VRチャットで、なんと！彼はそうしなければならなかった"}, {"type": "subtitle", "time": 4617.91, "timestamp": "01:16:57", "text": "ずっと私を運んで"}]
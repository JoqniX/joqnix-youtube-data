[{"type": "subtitle", "time": 12240.309, "timestamp": "03:24:00", "text": "これをこのようにして作ったら、"}, {"type": "subtitle", "time": 12242.469, "timestamp": "03:24:02", "text": "上へ上がってくる。"}, {"type": "subtitle", "time": 12244.91, "timestamp": "03:24:04", "text": "それは来るだろう"}, {"type": "subtitle", "time": 12248.95, "timestamp": "03:24:08", "text": "上向き、上向きであって下向きではない。"}, {"type": "subtitle", "time": 12250.91, "timestamp": "03:24:10", "text": "文字通りその上に"}, {"type": "subtitle", "time": 12255.03, "timestamp": "03:24:15", "text": "このモニターはキーボードのような"}, {"type": "subtitle", "time": 12258.269, "timestamp": "03:24:18", "text": "でも問題は、もし私が携帯電話を正しく置いたら"}, {"type": "subtitle", "time": 12263.229, "timestamp": "03:24:23", "text": "ここでの問題は、半分が見えないことです"}, {"type": "subtitle", "time": 12266.349, "timestamp": "03:24:26", "text": "電話のような画面が遮られている"}, {"type": "subtitle", "time": 12268.59, "timestamp": "03:24:28", "text": "それは"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "問題なので、えっと、私は、"}, {"type": "subtitle", "time": 12274.67, "timestamp": "03:24:34", "text": "モニターを高くする"}, {"type": "subtitle", "time": 12276.67, "timestamp": "03:24:36", "text": "上向き？それ"}, {"type": "subtitle", "time": 12280.269, "timestamp": "03:24:40", "text": "作品。待って、私は"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "それ？それってやらなきゃいけないの？待って、待って"}, {"type": "subtitle", "time": 12286.51, "timestamp": "03:24:46", "text": "の上。試してみてもいいですか？"}]
[{"type": "subtitle", "time": 4384.229, "timestamp": "01:13:04", "text": "青をミックス＆マッチしたような素材"}, {"type": "subtitle", "time": 4388.87, "timestamp": "01:13:08", "text": "緑がかった。わからない。まあ、そうですね。"}, {"type": "subtitle", "time": 4391.91, "timestamp": "01:13:11", "text": "まあ、そういうことです。来て言って"}, {"type": "subtitle", "time": 4393.189, "timestamp": "01:13:13", "text": "かっこよくて忍者みたい。戦わなければならない"}, {"type": "subtitle", "time": 4413.39, "timestamp": "01:13:33", "text": "うん、取って"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "ケア。良い一日をお過ごしください。わかった、"}, {"type": "subtitle", "time": 4417.229, "timestamp": "01:13:37", "text": "ご視聴ありがとうございました"}, {"type": "subtitle", "time": 4420.709, "timestamp": "01:13:40", "text": "入ります。追いついてキャッチキャッチできるといいですね。"}, {"type": "subtitle", "time": 4423.51, "timestamp": "01:13:43", "text": "次の動画に私が登場します。気をつけて。楽しむ"}, {"type": "subtitle", "time": 4425.59, "timestamp": "01:13:45", "text": "そして、あなたが信じていることに幸運を祈ります"}, {"type": "subtitle", "time": 4427.669, "timestamp": "01:13:47", "text": "試験がある。試験との戦いと"}, {"type": "subtitle", "time": 4432.669, "timestamp": "01:13:52", "text": "もの。運。何が起こっているのか"}, {"type": "subtitle", "time": 4435.07, "timestamp": "01:13:55", "text": "翻訳？少なくともそれだけは"}]
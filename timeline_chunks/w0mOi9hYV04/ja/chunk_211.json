[{"type": "subtitle", "time": 12673.83, "timestamp": "03:31:13", "text": "朝。だから、これは気に入るしかないだろう。"}, {"type": "subtitle", "time": 12675.55, "timestamp": "03:31:15", "text": "これを回転させてください"}, {"type": "subtitle", "time": 12677.229, "timestamp": "03:31:17", "text": "ここ。"}, {"type": "subtitle", "time": 12691.07, "timestamp": "03:31:31", "text": "問題はこうだ。いいえ、"}, {"type": "subtitle", "time": 12694.349, "timestamp": "03:31:34", "text": "待って。このような。"}, {"type": "subtitle", "time": 12696.1, "timestamp": "03:31:36", "text": "わかった。する"}, {"type": "subtitle", "time": 12697.79, "timestamp": "03:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 12701.03, "timestamp": "03:31:41", "text": "これ。そうしてください。わかった。"}, {"type": "subtitle", "time": 12707.389, "timestamp": "03:31:47", "text": "雷？皆さん、"}]
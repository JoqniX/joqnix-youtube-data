[{"type": "subtitle", "time": 5041.99, "timestamp": "01:24:01", "text": "私たちのストリームには、すべて"}, {"type": "subtitle", "time": 5045.51, "timestamp": "01:24:05", "text": "Reality Studiosによるファンメイドのオリジナルサウンドトラックのように"}, {"type": "subtitle", "time": 5049.27, "timestamp": "01:24:09", "text": "そしてアイゼン。ええ、幸せです。ありがとう。"}, {"type": "subtitle", "time": 5052.31, "timestamp": "01:24:12", "text": "私は嬉しい。私のモデルが動かなくなったのはなぜですか？おい、"}, {"type": "subtitle", "time": 5054.55, "timestamp": "01:24:14", "text": "動く。私は表現をしている。わかった。わかった、"}, {"type": "subtitle", "time": 5056.51, "timestamp": "01:24:16", "text": "その"}, {"type": "subtitle", "time": 5059.55, "timestamp": "01:24:19", "text": "移動中。えっと、"}, {"type": "subtitle", "time": 5076.43, "timestamp": "01:24:36", "text": "今度はさりげなく。"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "えっと、私もそれについては混乱しています。"}, {"type": "subtitle", "time": 5082.87, "timestamp": "01:24:42", "text": "最終的にはそれを促進しなければならない"}, {"type": "subtitle", "time": 5085.229, "timestamp": "01:24:45", "text": "次のアカウントをチャンネル登録してください。"}, {"type": "subtitle", "time": 5088.55, "timestamp": "01:24:48", "text": "えーっと、もし私のビリービリーを見てください"}, {"type": "subtitle", "time": 5091.669, "timestamp": "01:24:51", "text": "アカウント、すごく空っぽに見える。あなたが"}, {"type": "subtitle", "time": 5093.51, "timestamp": "01:24:53", "text": "私のストリームに偶然出くわしたら、あなたは"}, {"type": "subtitle", "time": 5095.51, "timestamp": "01:24:55", "text": "「ああ、この男は、これは実際に"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "コンテンツを作成しているアカウント。おお、"}, {"type": "subtitle", "time": 5099.95, "timestamp": "01:24:59", "text": "それは実際の"}]
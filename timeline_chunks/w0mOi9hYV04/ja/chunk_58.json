[{"type": "subtitle", "time": 3482.829, "timestamp": "00:58:02", "text": "次はジョック、えっと、私です"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "ジョックの背後にいる私自身は"}, {"type": "subtitle", "time": 3490.589, "timestamp": "00:58:10", "text": "アバター。ええ、そうですね。だから私はこう思った"}, {"type": "subtitle", "time": 3493.99, "timestamp": "00:58:13", "text": "仕事。つまり、ゲンダムは関係ないということです。"}, {"type": "subtitle", "time": 3497.51, "timestamp": "00:58:17", "text": "その人の性格と"}, {"type": "subtitle", "time": 3501.27, "timestamp": "00:58:21", "text": "感情と私がどんな悪ふざけをしようとも"}, {"type": "subtitle", "time": 3510.829, "timestamp": "00:58:30", "text": "えっと、兄貴は武器の専門家だと思ってたんだけど"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "文学は私に聞いたことがないとは言わない"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "私がこれらすべてを得た言葉について"}, {"type": "subtitle", "time": 3520.51, "timestamp": "00:58:40", "text": "Java のようなコンピュータ、"}, {"type": "subtitle", "time": 3523.43, "timestamp": "00:58:43", "text": "Apacheサーバーか何か"}, {"type": "subtitle", "time": 3529.99, "timestamp": "00:58:49", "text": "これ。ジョイの電話は意地悪だった"}]
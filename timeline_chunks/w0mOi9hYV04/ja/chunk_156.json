[{"type": "subtitle", "time": 9362.19, "timestamp": "02:36:02", "text": "あまりにも。誰が"}, {"type": "subtitle", "time": 9372.389, "timestamp": "02:36:12", "text": "うん。それで、えっと、それで、何をするつもりだったんですか？"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "配信を開始するタイミングを教えてください。私は"}, {"type": "subtitle", "time": 9385.349, "timestamp": "02:36:25", "text": "実際にはとても気分を高揚させる方法ですが"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "アイドル歌手が言うように、でも私は"}, {"type": "subtitle", "time": 9394.469, "timestamp": "02:36:34", "text": "忘れた。えーと、えーと、えーと、あなたは"}, {"type": "subtitle", "time": 9396.91, "timestamp": "02:36:36", "text": "それって何？何か良いことが起こりましたか"}, {"type": "subtitle", "time": 9405.429, "timestamp": "02:36:45", "text": "ああ、一度に30件の事故が起きないことを願おう"}, {"type": "subtitle", "time": 9408.55, "timestamp": "02:36:48", "text": "流れだよ、男。ああ、大変だ。覚えているよ"}, {"type": "subtitle", "time": 9412.83, "timestamp": "02:36:52", "text": "日。えっと、26 OBSだと思います"}, {"type": "subtitle", "time": 9415.79, "timestamp": "02:36:55", "text": "26. ああ、"}]
[{"type": "subtitle", "time": 8886.07, "timestamp": "02:28:06", "text": "いや、そうでもない。そう、まさにその通り。それは"}, {"type": "subtitle", "time": 8888.15, "timestamp": "02:28:08", "text": "もの。そこが問題なんです。そうでなければならない"}, {"type": "subtitle", "time": 8891.349, "timestamp": "02:28:11", "text": "面白くて消費しやすい。それは"}, {"type": "subtitle", "time": 8893.59, "timestamp": "02:28:13", "text": "もの。 「ああ、そうだ、私はただ"}, {"type": "subtitle", "time": 8896.07, "timestamp": "02:28:16", "text": "12時間配信したら、それで終わりです。うん。"}, {"type": "subtitle", "time": 8897.83, "timestamp": "02:28:17", "text": "そうじゃない。作りたい"}, {"type": "subtitle", "time": 8899.75, "timestamp": "02:28:19", "text": "消耗品。作りたい"}, {"type": "subtitle", "time": 8902.469, "timestamp": "02:28:22", "text": "見ていて面白い。えっと、それは"}, {"type": "subtitle", "time": 8905.55, "timestamp": "02:28:25", "text": "最近私は親切にしている"}, {"type": "subtitle", "time": 8908.349, "timestamp": "02:28:28", "text": "選ぶのが好き"}, {"type": "subtitle", "time": 8912.469, "timestamp": "02:28:32", "text": "多すぎるものや、"}, {"type": "subtitle", "time": 8914.309, "timestamp": "02:28:34", "text": "それをピングします。一時停止ではなく、"}, {"type": "subtitle", "time": 8916.27, "timestamp": "02:28:36", "text": "停止中"}, {"type": "subtitle", "time": 8920.15, "timestamp": "02:28:40", "text": "それ。ええと、私の裁判の間、私を弁護してください"}, {"type": "subtitle", "time": 8922.51, "timestamp": "02:28:42", "text": "強盗事件の後。ああ、"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "神。うん。さよなら。また、"}, {"type": "subtitle", "time": 8927.469, "timestamp": "02:28:47", "text": "10時30分。それでは締めくくりましょう"}, {"type": "subtitle", "time": 8930.79, "timestamp": "02:28:50", "text": "上。私は、"}, {"type": "subtitle", "time": 8934.11, "timestamp": "02:28:54", "text": "10時30分。それでは、これで終わりにしましょう。"}, {"type": "subtitle", "time": 8937.27, "timestamp": "02:28:57", "text": "えっと、質問は、感謝する必要があるかどうかです"}, {"type": "subtitle", "time": 8939.95, "timestamp": "02:28:59", "text": "今や一人ひとりが？今"}]
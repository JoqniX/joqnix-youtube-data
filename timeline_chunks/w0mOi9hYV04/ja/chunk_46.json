[{"type": "subtitle", "time": 2761.47, "timestamp": "00:46:01", "text": "私たちは誇りに思っています"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "jフォン。いいえ、電話のせいではありません。その"}, {"type": "subtitle", "time": 2768.069, "timestamp": "00:46:08", "text": "全然熱くない。すごくかっこいい。それは"}, {"type": "subtitle", "time": 2771.43, "timestamp": "00:46:11", "text": "Wi-Fi関連のもの。えーっと、主に"}, {"type": "subtitle", "time": 2775.55, "timestamp": "00:46:15", "text": "私の人脈は実際、"}, {"type": "subtitle", "time": 2780.87, "timestamp": "00:46:20", "text": "えっと、100MP、いや1000MPは1GBに相当します。"}, {"type": "subtitle", "time": 2783.51, "timestamp": "00:46:23", "text": "ネットワーク接続が必要なので、2台のPCが"}, {"type": "subtitle", "time": 2786.55, "timestamp": "00:46:26", "text": "単一のルーターによって駆動される"}, {"type": "subtitle", "time": 2789.99, "timestamp": "00:46:29", "text": "ギガビットまたは"}, {"type": "subtitle", "time": 2792.23, "timestamp": "00:46:32", "text": "ギガビットスプリッターとか、何て言うんだっけ"}, {"type": "subtitle", "time": 2794.87, "timestamp": "00:46:34", "text": "それは再びギガビットスイッチと呼ばれ、"}, {"type": "subtitle", "time": 2799.91, "timestamp": "00:46:39", "text": "1ギガバイト、つまり1GBを送ります"}, {"type": "subtitle", "time": 2804.27, "timestamp": "00:46:44", "text": "または、000 MP の緑色の光が安定しています"}, {"type": "subtitle", "time": 2807.67, "timestamp": "00:46:47", "text": "インターネット接続速度は両方とも"}, {"type": "subtitle", "time": 2811.67, "timestamp": "00:46:51", "text": "PCで実行するにはOBSが必要です"}, {"type": "subtitle", "time": 2814.63, "timestamp": "00:46:54", "text": "少し50％かかるのは、"}, {"type": "subtitle", "time": 2817.19, "timestamp": "00:46:57", "text": "エンコードして両方のプラットフォームに記録する"}]
[{"type": "subtitle", "time": 9662.03, "timestamp": "02:41:02", "text": "ジャンプとは、"}, {"type": "subtitle", "time": 9667.67, "timestamp": "02:41:07", "text": "痛みはあるけど、大丈夫。では、切り替えましょう"}, {"type": "subtitle", "time": 9671.19, "timestamp": "02:41:11", "text": "さっと済ませて、リラックスしよう。わかった。"}, {"type": "subtitle", "time": 9673.429, "timestamp": "02:41:13", "text": "この配信では、みんなでリラックスして話しています。"}, {"type": "subtitle", "time": 9687.07, "timestamp": "02:41:27", "text": "わかった。そこで、少し声を加えました"}, {"type": "subtitle", "time": 9692.03, "timestamp": "02:41:32", "text": "コマンド。ということで、新しいものが"}, {"type": "subtitle", "time": 9694.71, "timestamp": "02:41:34", "text": "トゥイッチ。たくさんのものを追加しました"}, {"type": "subtitle", "time": 9696.67, "timestamp": "02:41:36", "text": "Twitch関連、"}, {"type": "subtitle", "time": 9700.55, "timestamp": "02:41:40", "text": "男。うん。ネタバレはしたくないのですが、"}, {"type": "subtitle", "time": 9703.59, "timestamp": "02:41:43", "text": "うん。新しいものをお見せするのが待ちきれません"}, {"type": "subtitle", "time": 9706.349, "timestamp": "02:41:46", "text": "Twitchで新しくやったこと"}, {"type": "subtitle", "time": 9709.11, "timestamp": "02:41:49", "text": "もの。これを使うのが待ち遠しい。たくさん"}, {"type": "subtitle", "time": 9711.389, "timestamp": "02:41:51", "text": "新しいものについて。"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "うん。配信を楽しんでください。また、"}, {"type": "subtitle", "time": 9716.95, "timestamp": "02:41:56", "text": "もちろん、健康を"}, {"type": "subtitle", "time": 9718.79, "timestamp": "02:41:58", "text": "優先度。私は"}]
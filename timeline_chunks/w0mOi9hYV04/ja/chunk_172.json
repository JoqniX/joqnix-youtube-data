[{"type": "subtitle", "time": 10321.55, "timestamp": "02:52:01", "text": "ああ、それから毛布とホット"}, {"type": "subtitle", "time": 10324.71, "timestamp": "02:52:04", "text": "ココアの小さなリードは良い。ええ、彼らは"}, {"type": "subtitle", "time": 10332.429, "timestamp": "02:52:12", "text": "良い。"}, {"type": "subtitle", "time": 10335.389, "timestamp": "02:52:15", "text": "うん。そして私は倒れた"}, {"type": "subtitle", "time": 10340.07, "timestamp": "02:52:20", "text": "また。ジャンプに失敗する。私たちはより長い"}, {"type": "subtitle", "time": 10343.03, "timestamp": "02:52:23", "text": "ジャンプ。私たちは失敗する。私たちは遠くからジャンプする。"}, {"type": "subtitle", "time": 10344.349, "timestamp": "02:52:24", "text": "意味する"}, {"type": "subtitle", "time": 10345.87, "timestamp": "02:52:25", "text": "成功する。"}, {"type": "subtitle", "time": 10355.87, "timestamp": "02:52:35", "text": "ジャンプ"}, {"type": "subtitle", "time": 10357.389, "timestamp": "02:52:37", "text": "ブーム"}, {"type": "subtitle", "time": 10362.389, "timestamp": "02:52:42", "text": "ブープ。そうそう。えっと、ブープが"}, {"type": "subtitle", "time": 10363.23, "timestamp": "02:52:43", "text": "1"}, {"type": "subtitle", "time": 10366.63, "timestamp": "02:52:46", "text": "もの。それは知らなかった。えっと、もしあなたが"}, {"type": "subtitle", "time": 10369.59, "timestamp": "02:52:49", "text": "かわいい人になりたかった、人を鼻でつつく"}, {"type": "subtitle", "time": 10376.19, "timestamp": "02:52:56", "text": "そして"}]
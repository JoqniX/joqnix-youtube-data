[{"type": "subtitle", "time": 6023.07, "timestamp": "01:40:23", "text": "妊娠しています。何？何？"}, {"type": "subtitle", "time": 6026.47, "timestamp": "01:40:26", "text": "何？あの、質問があります。あなたは"}, {"type": "subtitle", "time": 6028.95, "timestamp": "01:40:28", "text": "撮影現場に来たことはありますか？はい、あります。私"}, {"type": "subtitle", "time": 6032.709, "timestamp": "01:40:32", "text": "持っている。私はただそれについて話しただけです、うーん"}, {"type": "subtitle", "time": 6035.35, "timestamp": "01:40:35", "text": "何分ありますか"}, {"type": "subtitle", "time": 6038.87, "timestamp": "01:40:38", "text": "また話してたの？ 39. 私はこう言いました"}, {"type": "subtitle", "time": 6039.95, "timestamp": "01:40:39", "text": "のように"}, {"type": "subtitle", "time": 6043.99, "timestamp": "01:40:43", "text": "29分経過時点。つまり"}, {"type": "subtitle", "time": 6045.43, "timestamp": "01:40:45", "text": "ストリームの開始。では、繰り返します"}, {"type": "subtitle", "time": 6047.229, "timestamp": "01:40:47", "text": "また。"}, {"type": "subtitle", "time": 6051.79, "timestamp": "01:40:51", "text": "だから、私は本当に"}, {"type": "subtitle", "time": 6054.87, "timestamp": "01:40:54", "text": "ショート動画や動画コンテンツを作っています。"}, {"type": "subtitle", "time": 6057.27, "timestamp": "01:40:57", "text": "ただ、私がこだわりが強すぎるだけなんです。"}]
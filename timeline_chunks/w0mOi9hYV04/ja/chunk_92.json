[{"type": "subtitle", "time": 5521.11, "timestamp": "01:32:01", "text": "あなたが言っていることを、そしてそれを"}, {"type": "subtitle", "time": 5523.51, "timestamp": "01:32:03", "text": "ゲーム内でキャラクターに対して行われる会話。の"}, {"type": "subtitle", "time": 5525.83, "timestamp": "01:32:05", "text": "登場人物はAIです。彼らは"}, {"type": "subtitle", "time": 5528.07, "timestamp": "01:32:08", "text": "あなたが何を言っても、どんな会話を作っても"}, {"type": "subtitle", "time": 5530.709, "timestamp": "01:32:10", "text": "そして、それらのことをする。とても楽しい"}, {"type": "subtitle", "time": 5536.79, "timestamp": "01:32:16", "text": "ちょっとしたゲーム。えっと、それを1回プレイしたい"}, {"type": "subtitle", "time": 5541.669, "timestamp": "01:32:21", "text": "日だけど、うん。えっと、ちょっと怖いです"}, {"type": "subtitle", "time": 5548.39, "timestamp": "01:32:28", "text": "えっと、正直言ってちょっと怖いんです。えっと"}, {"type": "subtitle", "time": 5552.75, "timestamp": "01:32:32", "text": "待って、それは、えっと、無料プレイですか？"}, {"type": "subtitle", "time": 5555.35, "timestamp": "01:32:35", "text": "マーク？ああ、それは買わなきゃダメだよ。はい、"}, {"type": "subtitle", "time": 5563.07, "timestamp": "01:32:43", "text": "わかった、"}, {"type": "subtitle", "time": 5565.07, "timestamp": "01:32:45", "text": "理解できます。その"}, {"type": "subtitle", "time": 5568.91, "timestamp": "01:32:48", "text": "わかった。ソースを見ると"}, {"type": "subtitle", "time": 5571.91, "timestamp": "01:32:51", "text": "面白い。うん。こんにちは、魂よ。ようこそ"}, {"type": "subtitle", "time": 5573.95, "timestamp": "01:32:53", "text": "ストリーム。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 5578.229, "timestamp": "01:32:58", "text": "良い。こんにちは。こんにちは。韓国で自分でジョギング"}]
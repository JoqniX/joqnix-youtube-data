[{"type": "subtitle", "time": 4921.91, "timestamp": "01:22:01", "text": "ええと、今のところは。でもVチャンネルは維持します"}, {"type": "subtitle", "time": 4925.189, "timestamp": "01:22:05", "text": "今のところ。しばらくの間、私たちはそれを持っています"}, {"type": "subtitle", "time": 4927.189, "timestamp": "01:22:07", "text": "2年間か、あるいは1年間かな。私はしません"}, {"type": "subtitle", "time": 4929.59, "timestamp": "01:22:09", "text": "私がそれを作った時を覚えておいてください。でも、それは"}, {"type": "subtitle", "time": 4932.709, "timestamp": "01:22:12", "text": "そこにいるよ。私のまだのアイデアプランは、えっと"}, {"type": "subtitle", "time": 4936.99, "timestamp": "01:22:16", "text": "ストリームをアップロードします"}, {"type": "subtitle", "time": 4940.47, "timestamp": "01:22:20", "text": "ストリームショットとハイライトまたは"}, {"type": "subtitle", "time": 4943.91, "timestamp": "01:22:23", "text": "えーっと、W の何かみたいな"}, {"type": "subtitle", "time": 4946.629, "timestamp": "01:22:26", "text": "チャネル。なぜだめですか？しかし、もし私たちが"}, {"type": "subtitle", "time": 4949.51, "timestamp": "01:22:29", "text": "バリカンか何かで、私は作業できます"}, {"type": "subtitle", "time": 4952.39, "timestamp": "01:22:32", "text": "彼らと一緒に公式に、えっと、"}, {"type": "subtitle", "time": 4956.229, "timestamp": "01:22:36", "text": "正式な公式短編シリーズ、そしておそらく"}, {"type": "subtitle", "time": 4958.229, "timestamp": "01:22:38", "text": "メインチャンネルにアップロードできます。私"}, {"type": "subtitle", "time": 4959.99, "timestamp": "01:22:39", "text": "わからない。"}, {"type": "subtitle", "time": 4961.99, "timestamp": "01:22:41", "text": "えっと、日曜日に彼らは"}, {"type": "subtitle", "time": 4965.03, "timestamp": "01:22:45", "text": "V. ええ、いいんじゃない？彼らにVにサブをさせよう"}, {"type": "subtitle", "time": 4967.75, "timestamp": "01:22:47", "text": "チャネル。つまり、Vチャンネルには"}, {"type": "subtitle", "time": 4971.27, "timestamp": "01:22:51", "text": "私が配信する他のすべての配信と同じように"}, {"type": "subtitle", "time": 4973.669, "timestamp": "01:22:53", "text": "他のすべてのプラットフォームでそうですよね？まるで"}, {"type": "subtitle", "time": 4976.03, "timestamp": "01:22:56", "text": "私はストリーミング配信しています"}, {"type": "subtitle", "time": 4978.55, "timestamp": "01:22:58", "text": "ストリーミング限定のものがどんな"}]
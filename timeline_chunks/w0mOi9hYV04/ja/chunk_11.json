[{"type": "subtitle", "time": 667.43, "timestamp": "00:11:07", "text": "うん。アセンス、ポジティブなパワーエネルギー"}, {"type": "subtitle", "time": 670.389, "timestamp": "00:11:10", "text": "今日あなたから。おお、いいね。私は保持したい"}, {"type": "subtitle", "time": 673.43, "timestamp": "00:11:13", "text": "このポジティブなエネルギー、パワーのようなもの"}, {"type": "subtitle", "time": 676.31, "timestamp": "00:11:16", "text": "私のすべての配信で、何か"}, {"type": "subtitle", "time": 679.19, "timestamp": "00:11:19", "text": "前進する。それは一種の困難です"}, {"type": "subtitle", "time": 682.63, "timestamp": "00:11:22", "text": "だって、私は、"}, {"type": "subtitle", "time": 686.15, "timestamp": "00:11:26", "text": "エネルギーレベルを安定させる"}, {"type": "subtitle", "time": 690.269, "timestamp": "00:11:30", "text": "流れの中で安定する。でも私は"}, {"type": "subtitle", "time": 693.15, "timestamp": "00:11:33", "text": "改善したい 改善したい"}, {"type": "subtitle", "time": 696.11, "timestamp": "00:11:36", "text": "それ。さあ、食べなきゃ"}, {"type": "subtitle", "time": 701.069, "timestamp": "00:11:41", "text": "パニール。私は実際に必要としています"}, {"type": "subtitle", "time": 709.509, "timestamp": "00:11:49", "text": "平均？ああ、でもやってみます。はい、試してみます"}]
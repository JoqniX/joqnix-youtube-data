[{"type": "subtitle", "time": 2465.109, "timestamp": "00:41:05", "text": "えーと、君がショットをキープできるようなのを見てるよ"}, {"type": "subtitle", "time": 2467.829, "timestamp": "00:41:07", "text": "数クリップ。うん。うん。私は欲しい"}, {"type": "subtitle", "time": 2469.589, "timestamp": "00:41:09", "text": "君が知ってるようなことをしようと思ったことさえある"}, {"type": "subtitle", "time": 2472.23, "timestamp": "00:41:12", "text": "YouTubeの現在のトレンドは"}, {"type": "subtitle", "time": 2475.829, "timestamp": "00:41:15", "text": "ショート動画のライブ配信は、えっと、"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "西洋社会によって解明され、"}, {"type": "subtitle", "time": 2481.99, "timestamp": "00:41:21", "text": "ええと、公式YouTubeはそれを宣伝するのが好きです"}, {"type": "subtitle", "time": 2489.27, "timestamp": "00:41:29", "text": "えーと、宣伝してるんだけど、何が起こってるの？"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "えーと、人々は、"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "2つの異なるストリームを使用する2つのストリーム"}, {"type": "subtitle", "time": 2497.15, "timestamp": "00:41:37", "text": "ええと、極端なキーは1つ"}, {"type": "subtitle", "time": 2499.67, "timestamp": "00:41:39", "text": "垂直方向の別の別のもの別のもの"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "水平になります。だから人々は"}, {"type": "subtitle", "time": 2504.23, "timestamp": "00:41:44", "text": "ショートパンツを閲覧すると、縦方向の"}, {"type": "subtitle", "time": 2506.309, "timestamp": "00:41:46", "text": "ライブ配信を行い、視聴者とあなたのライブ配信を視聴します。そしてもし"}, {"type": "subtitle", "time": 2508.15, "timestamp": "00:41:48", "text": "彼らがあなたのチャンネルをクリックすると、"}, {"type": "subtitle", "time": 2510.47, "timestamp": "00:41:50", "text": "水平方向の流れを見ることができる"}, {"type": "subtitle", "time": 2512.23, "timestamp": "00:41:52", "text": "彼らは水平方向の流れを見つめている。それ"}]
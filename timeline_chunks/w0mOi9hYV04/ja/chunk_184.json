[{"type": "subtitle", "time": 11041.389, "timestamp": "03:04:01", "text": "私の。では、一つ確認させてください。午前"}, {"type": "subtitle", "time": 11043.23, "timestamp": "03:04:03", "text": "私"}, {"type": "subtitle", "time": 11048.23, "timestamp": "03:04:08", "text": "え？わかりました、すぐ戻ります。いや、そうでもないよ。ハハ。"}, {"type": "subtitle", "time": 11050.95, "timestamp": "03:04:10", "text": "私はただあなたの話を聞いているだけです。私はしません"}, {"type": "subtitle", "time": 11054.19, "timestamp": "03:04:14", "text": "私はあまり注意を払っていません"}, {"type": "subtitle", "time": 11057.67, "timestamp": "03:04:17", "text": "ゲーム。こんにちは。こんにちは。ゲームを楽しんでください。いいえ。"}, {"type": "subtitle", "time": 11060.63, "timestamp": "03:04:20", "text": "そしてジャサンも。あなたもそう感じる"}, {"type": "subtitle", "time": 11063.87, "timestamp": "03:04:23", "text": "秘密裏にゲームをしているんだよね？だからあなたは"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "あまりにも。 Helixanもプレイしているのかな？"}, {"type": "subtitle", "time": 11073.269, "timestamp": "03:04:33", "text": "ストリーム。私はあなたを見ていますが、主に"}, {"type": "subtitle", "time": 11076.23, "timestamp": "03:04:36", "text": "君は最高だから、ずっと君を見てるよ。モ、君"}, {"type": "subtitle", "time": 11077.309, "timestamp": "03:04:37", "text": "は"}, {"type": "subtitle", "time": 11099.67, "timestamp": "03:04:59", "text": "ゲーム。 Kを読んでいます。わあ。誰もが"}]
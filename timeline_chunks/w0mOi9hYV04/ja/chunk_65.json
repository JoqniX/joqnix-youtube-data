[{"type": "subtitle", "time": 3902.549, "timestamp": "01:05:02", "text": "えっと、バンガロール。ああ、ブラインドカーボンコピー。"}, {"type": "subtitle", "time": 3904.71, "timestamp": "01:05:04", "text": "ああ、わかりました。それがBCCSの本質です。わかった。"}, {"type": "subtitle", "time": 3907.23, "timestamp": "01:05:07", "text": "BCCS。"}, {"type": "subtitle", "time": 3910.47, "timestamp": "01:05:10", "text": "わかった。わかった。あ、待って。ええと、それはそうかもしれない"}, {"type": "subtitle", "time": 3912.91, "timestamp": "01:05:12", "text": "えっと、待って。えっと、"}, {"type": "subtitle", "time": 3915.99, "timestamp": "01:05:15", "text": "あなたの文脈はチェンナイ・コミコンでした。それで、"}, {"type": "subtitle", "time": 3923.39, "timestamp": "01:05:23", "text": "コミコンのことですよね？理解できたかな？"}, {"type": "subtitle", "time": 3927.23, "timestamp": "01:05:27", "text": "右？そうです。わーい。バンガルドゥまたは"}, {"type": "subtitle", "time": 3929.789, "timestamp": "01:05:29", "text": "バンガロール。えっと、"}, {"type": "subtitle", "time": 3932.43, "timestamp": "01:05:32", "text": "コミコン。"}, {"type": "subtitle", "time": 3953.99, "timestamp": "01:05:53", "text": "私は何を言おうとしていたんだろう？なぜこれが"}, {"type": "subtitle", "time": 3955.87, "timestamp": "01:05:55", "text": "簡単？えーと、デリー"}, {"type": "subtitle", "time": 3958.309, "timestamp": "01:05:58", "text": "コミコン。前の人に渡してください"}]
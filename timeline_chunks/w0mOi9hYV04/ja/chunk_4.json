[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "うん。うん。えーっと、昨日今日"}, {"type": "subtitle", "time": 244.83, "timestamp": "00:04:04", "text": "実際、もし私が"}, {"type": "subtitle", "time": 248.27, "timestamp": "00:04:08", "text": "知らない人のために言っておきますが、"}, {"type": "subtitle", "time": 254.22899999999998, "timestamp": "00:04:14", "text": "えっと、スクーターを持ってきました。えっと、"}, {"type": "subtitle", "time": 255.83, "timestamp": "00:04:15", "text": "待って、"}, {"type": "subtitle", "time": 258.229, "timestamp": "00:04:18", "text": "スクーティとまたスクーター？私はしません"}, {"type": "subtitle", "time": 260.949, "timestamp": "00:04:20", "text": "知る。でも、両親が持っていたのは"}, {"type": "subtitle", "time": 263.51, "timestamp": "00:04:23", "text": "私を買った。あれは、私が買い戻したものです"}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "ここにいるし、実際に私は自分の"}, {"type": "subtitle", "time": 269.27, "timestamp": "00:04:29", "text": "私の家からここまで乗るのが一番いい"}, {"type": "subtitle", "time": 271.95, "timestamp": "00:04:31", "text": "私が滞在している場所。おい、それは"}, {"type": "subtitle", "time": 275.51, "timestamp": "00:04:35", "text": "私は本当に信じられなかった"}, {"type": "subtitle", "time": 278.469, "timestamp": "00:04:38", "text": "実際にやったんです。私は車にぶつかっていません。私"}, {"type": "subtitle", "time": 282.23, "timestamp": "00:04:42", "text": "バスには衝突しなかった。君は私が"}, {"type": "subtitle", "time": 285.11, "timestamp": "00:04:45", "text": "GTAとかで右折とか。それらの人々のために"}, {"type": "subtitle", "time": 287.35, "timestamp": "00:04:47", "text": "私のGTAを見た人、またはレースが好きな人"}, {"type": "subtitle", "time": 294.55, "timestamp": "00:04:54", "text": "しかし、それは車の場合の話だ。しかしこれは"}, {"type": "subtitle", "time": 296.35, "timestamp": "00:04:56", "text": "スクーターか、"}, {"type": "subtitle", "time": 299.909, "timestamp": "00:04:59", "text": "バイクもそうですよね？うん。今日私は"}]
[{"type": "subtitle", "time": 17225.19, "timestamp": "04:47:05", "text": "少しの間何かを手に入れて、"}, {"type": "chat", "time": 17226.751, "timestamp": "04:47:06", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Its taking a lot of energy of me to"}, {"type": "subtitle", "time": 17228.07, "timestamp": "04:47:08", "text": "再び一緒になった。あなたに必要なのは休息です。"}, {"type": "subtitle", "time": 17229.83, "timestamp": "04:47:09", "text": "考え方をリセットする必要があります"}, {"type": "subtitle", "time": 17230.99, "timestamp": "04:47:10", "text": "もの。"}, {"type": "subtitle", "time": 17234.948, "timestamp": "04:47:14", "text": "わかった？ええ、必要なら休憩を取ってください。"}, {"type": "subtitle", "time": 17240.47, "timestamp": "04:47:20", "text": "に。誰も「いや」とは言わないよ"}, {"type": "subtitle", "time": 17243.75, "timestamp": "04:47:23", "text": "1つは、"}, {"type": "subtitle", "time": 17246.31, "timestamp": "04:47:26", "text": "えーっと、なんて言うんだっけ？誰のものでもない"}, {"type": "subtitle", "time": 17248.708, "timestamp": "04:47:28", "text": "何か情報はある？ああ、もう、苦しい。"}, {"type": "subtitle", "time": 17250.51, "timestamp": "04:47:30", "text": "誰も"}, {"type": "subtitle", "time": 17253.99, "timestamp": "04:47:33", "text": "ああ、結局あなたは"}, {"type": "subtitle", "time": 17255.99, "timestamp": "04:47:35", "text": "人間ですよね？もちろんできますよ"}, {"type": "subtitle", "time": 17257.31, "timestamp": "04:47:37", "text": "取る"}, {"type": "subtitle", "time": 17259.788, "timestamp": "04:47:39", "text": "壊す。それで"}, {"type": "subtitle", "time": 17263.87, "timestamp": "04:47:43", "text": "ああ、覚えておいてくれ。"}, {"type": "subtitle", "time": 17266.39, "timestamp": "04:47:46", "text": "[音楽]"}, {"type": "subtitle", "time": 17268.628, "timestamp": "04:47:48", "text": "こんにちは。だから、私が配信するモチベーションはすべて。"}, {"type": "subtitle", "time": 17270.07, "timestamp": "04:47:50", "text": "今、本当に泣いています。それは"}, {"type": "subtitle", "time": 17273.39, "timestamp": "04:47:53", "text": "かなりのエネルギーを消費する。私も。ああ、私は"}, {"type": "subtitle", "time": 17276.39, "timestamp": "04:47:56", "text": "理解する。それから、ジャスミンさん、こんにちは。こんにちは"}]
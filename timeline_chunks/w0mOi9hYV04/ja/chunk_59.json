[{"type": "subtitle", "time": 3541.63, "timestamp": "00:59:01", "text": "とても"}, {"type": "subtitle", "time": 3544.63, "timestamp": "00:59:04", "text": "こんにちは、鼻。えっと、インドではどんな"}, {"type": "subtitle", "time": 3547.03, "timestamp": "00:59:07", "text": "あなたはどのライターを使っていますか？意志のように"}, {"type": "subtitle", "time": 3550.309, "timestamp": "00:59:10", "text": "私は別の場所にいるので、"}, {"type": "subtitle", "time": 3552.549, "timestamp": "00:59:12", "text": "えっと、場所。えっと、これは地元の"}, {"type": "subtitle", "time": 3553.63, "timestamp": "00:59:13", "text": "ブランド。"}, {"type": "subtitle", "time": 3557.589, "timestamp": "00:59:17", "text": "えっと、テックネクストとかいう名前だったかな。"}, {"type": "subtitle", "time": 3561.75, "timestamp": "00:59:21", "text": "ルーターですが、自宅に戻ると、"}, {"type": "subtitle", "time": 3565.829, "timestamp": "00:59:25", "text": "ルーターを使うよ、うん、たぶん、私はこう思うだろう"}, {"type": "subtitle", "time": 3568.069, "timestamp": "00:59:28", "text": "シフト中は移動したり、"}, {"type": "subtitle", "time": 3570.99, "timestamp": "00:59:30", "text": "すぐにシフトしました"}, {"type": "subtitle", "time": 3576.03, "timestamp": "00:59:36", "text": "えーっと、また家に帰るとか"}, {"type": "subtitle", "time": 3580.95, "timestamp": "00:59:40", "text": "えっと、それで、えっと、私は取引か何かに参戦しました"}, {"type": "subtitle", "time": 3583.47, "timestamp": "00:59:43", "text": "結論として"}, {"type": "subtitle", "time": 3586.63, "timestamp": "00:59:46", "text": "私が別のスペースを欲しかったのは、"}, {"type": "subtitle", "time": 3588.829, "timestamp": "00:59:48", "text": "私は自由と独立を望んでいます"}, {"type": "subtitle", "time": 3592.789, "timestamp": "00:59:52", "text": "考える。そうですね、おそらく彼らは"}, {"type": "subtitle", "time": 3597.51, "timestamp": "00:59:57", "text": "3月頃から作業を開始する予定です。えっと、私が"}]
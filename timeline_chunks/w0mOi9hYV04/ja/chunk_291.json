[{"type": "subtitle", "time": 17462.39, "timestamp": "04:51:02", "text": "など、例を一つ挙げてみましょう。"}, {"type": "subtitle", "time": 17466.31, "timestamp": "04:51:06", "text": "マチだから、パラソーシャリズムだと思う。"}, {"type": "subtitle", "time": 17470.19, "timestamp": "04:51:10", "text": "深入りしすぎると奇妙になりすぎる"}, {"type": "subtitle", "time": 17472.35, "timestamp": "04:51:12", "text": "気味の悪い"}, {"type": "subtitle", "time": 17475.868, "timestamp": "04:51:15", "text": "どこにでも行けるよ"}, {"type": "subtitle", "time": 17478.39, "timestamp": "04:51:18", "text": "脳ですが、また設定する必要があります"}, {"type": "subtitle", "time": 17480.59, "timestamp": "04:51:20", "text": "境界はあるものの"}, {"type": "subtitle", "time": 17483.43, "timestamp": "04:51:23", "text": "視聴者は覚えておく必要がある"}, {"type": "subtitle", "time": 17486.51, "timestamp": "04:51:26", "text": "たとえ実際に"}, {"type": "subtitle", "time": 17489.31, "timestamp": "04:51:29", "text": "ストリーマーとコミュニケーションを取り、"}, {"type": "subtitle", "time": 17494.31, "timestamp": "04:51:34", "text": "彼らは本当にあなたの友達ですか？"}, {"type": "subtitle", "time": 17496.39, "timestamp": "04:51:36", "text": "まるでユーチューバーみたいに、そういうものがある"}, {"type": "subtitle", "time": 17500.39, "timestamp": "04:51:40", "text": "そう、ストリーマーは決して"}, {"type": "subtitle", "time": 17503.67, "timestamp": "04:51:43", "text": "あなたの友達は正しい、なぜならあなたが"}, {"type": "subtitle", "time": 17506.03, "timestamp": "04:51:46", "text": "それらをあなたのものに"}, {"type": "subtitle", "time": 17509.67, "timestamp": "04:51:49", "text": "友よ、この話題もあるんだ"}, {"type": "subtitle", "time": 17511.948, "timestamp": "04:51:51", "text": "えっと、待って。噂は？"}, {"type": "subtitle", "time": 17514.47, "timestamp": "04:51:54", "text": "また？ああ、すっかり忘れてた。えっと、"}, {"type": "subtitle", "time": 17515.868, "timestamp": "04:51:55", "text": "何か情報はある？何か情報はある？"}, {"type": "subtitle", "time": 17517.708, "timestamp": "04:51:57", "text": "えこひいき。"}]
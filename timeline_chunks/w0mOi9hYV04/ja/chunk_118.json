[{"type": "subtitle", "time": 7082.31, "timestamp": "01:58:02", "text": "少し。アスリートモデルみたいになるだろう"}, {"type": "subtitle", "time": 7085.07, "timestamp": "01:58:05", "text": "数種類のスポーツマン風ヘアスタイル"}, {"type": "subtitle", "time": 7087.83, "timestamp": "01:58:07", "text": "数ヶ月。もうすぐだ。私はただ必要としている"}, {"type": "subtitle", "time": 7089.91, "timestamp": "01:58:09", "text": "前髪を伸ばす。のように"}, {"type": "subtitle", "time": 7103.149, "timestamp": "01:58:23", "text": "えーっと、フロントバンド。"}, {"type": "subtitle", "time": 7106.31, "timestamp": "01:58:26", "text": "うん。えっと、兄弟は逆のことを言ってるよ"}, {"type": "subtitle", "time": 7115.109, "timestamp": "01:58:35", "text": "こんなにも衝突しているなんて不思議だ。どれ？待って、"}, {"type": "subtitle", "time": 7116.87, "timestamp": "01:58:36", "text": "あなたは女の子ですか？女の子と付き合うの？"}, {"type": "subtitle", "time": 7119.03, "timestamp": "01:58:39", "text": "モデル？ふざけるな。ジョッキーが行く"}, {"type": "subtitle", "time": 7120.83, "timestamp": "01:58:40", "text": "である"}, {"type": "subtitle", "time": 7124.149, "timestamp": "01:58:44", "text": "大丈夫。ジョッキーのパーソナルジョックを想像します"}, {"type": "subtitle", "time": 7129.109, "timestamp": "01:58:49", "text": "個人的にジョッキーとしてパッチパック"}, {"type": "subtitle", "time": 7132.99, "timestamp": "01:58:52", "text": "攻撃ヘリコプターを分解して梱包する。何ですか"}, {"type": "subtitle", "time": 7135.39, "timestamp": "01:58:55", "text": "それ？何ですか"}, {"type": "subtitle", "time": 7138.629, "timestamp": "01:58:58", "text": "それ？おお。えっと、私がなぜ"}]
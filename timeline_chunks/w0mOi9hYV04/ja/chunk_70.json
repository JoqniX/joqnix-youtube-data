[{"type": "subtitle", "time": 4205.83, "timestamp": "01:10:05", "text": "ええ、そういうことなんです。なぜ"}, {"type": "subtitle", "time": 4208.44, "timestamp": "01:10:08", "text": "私のモデルが動かなくなりましたか？"}, {"type": "subtitle", "time": 4210.55, "timestamp": "01:10:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4212.87, "timestamp": "01:10:12", "text": "でも、それは主に"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "私が旅行している理由は"}, {"type": "subtitle", "time": 4217.91, "timestamp": "01:10:17", "text": "そして、オフ。しかし今では、"}, {"type": "subtitle", "time": 4218.91, "timestamp": "01:10:18", "text": "使用済み"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "バス。ええと、家に帰れます。うん、"}, {"type": "subtitle", "time": 4226.79, "timestamp": "01:10:26", "text": "乗馬は良い。乗ることに慣れるよ"}, {"type": "subtitle", "time": 4229.189, "timestamp": "01:10:29", "text": "高速道路。まるで自転車じゃないみたいだ。その"}, {"type": "subtitle", "time": 4231.03, "timestamp": "01:10:31", "text": "どちらかというとスクーターに近い。待って、"}, {"type": "subtitle", "time": 4233.91, "timestamp": "01:10:33", "text": "スクーターと"}, {"type": "subtitle", "time": 4235.709, "timestamp": "01:10:35", "text": "1"}, {"type": "subtitle", "time": 4238.11, "timestamp": "01:10:38", "text": "スクーティー？何が"}, {"type": "subtitle", "time": 4241.75, "timestamp": "01:10:41", "text": "それ？ 2つ参照した後、彼らは"}, {"type": "subtitle", "time": 4243.27, "timestamp": "01:10:43", "text": "異なる起源と継続"}, {"type": "subtitle", "time": 4245.07, "timestamp": "01:10:45", "text": "デピング"}, {"type": "subtitle", "time": 4248.99, "timestamp": "01:10:48", "text": "えっと、デザインと"}, {"type": "subtitle", "time": 4259.83, "timestamp": "01:10:59", "text": "アンジェラと数秒間話していると推測"}]
[{"type": "subtitle", "time": 2700.23, "timestamp": "00:45:00", "text": "早く友達を作りたい"}, {"type": "subtitle", "time": 2703.43, "timestamp": "00:45:03", "text": "そこで適切なコンテンツを作成する"}, {"type": "subtitle", "time": 2706.23, "timestamp": "00:45:06", "text": "ゲームとかそういうものよりも、そちらのほうがいい。私"}, {"type": "subtitle", "time": 2707.829, "timestamp": "00:45:07", "text": "取らなければならない 私は頼まなければならない"}, {"type": "subtitle", "time": 2709.829, "timestamp": "00:45:09", "text": "権限"}, {"type": "subtitle", "time": 2713.19, "timestamp": "00:45:13", "text": "えーと、ゲームのホワイトリストみたいなもの"}, {"type": "subtitle", "time": 2715.67, "timestamp": "00:45:15", "text": "実は。だから、その時私は"}, {"type": "subtitle", "time": 2720.069, "timestamp": "00:45:20", "text": "ValerantとApexをストリーミング配信しながら"}, {"type": "subtitle", "time": 2722.71, "timestamp": "00:45:22", "text": "ぼやけた画像"}, {"type": "subtitle", "time": 2725.91, "timestamp": "00:45:25", "text": "ええと、ぼかし処理をしながら。うん。ねずみ"}, {"type": "subtitle", "time": 2735.39, "timestamp": "00:45:35", "text": "ねずみ？待って。はぁ？何てことだ。私は手に入れた"}, {"type": "subtitle", "time": 2739.03, "timestamp": "00:45:39", "text": "怖がった。えっと、なぜ私のモデルは動かなくなってしまったのでしょうか？見る"}, {"type": "subtitle", "time": 2747.79, "timestamp": "00:45:47", "text": "立ち往生。私のモデルは"}, {"type": "subtitle", "time": 2755.4, "timestamp": "00:45:55", "text": "なぜ？えっと"}]
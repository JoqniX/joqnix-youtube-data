[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "YouTube Twitch 1 2"}, {"type": "subtitle", "time": 2823.51, "timestamp": "00:47:03", "text": "えっと、YouTube Studio は少し時間がかかります。"}, {"type": "subtitle", "time": 2827.03, "timestamp": "00:47:07", "text": "V Studioのデータを転送しています。"}, {"type": "subtitle", "time": 2830.87, "timestamp": "00:47:10", "text": "えーとストリームPCそして、そのデータは"}, {"type": "subtitle", "time": 2833.91, "timestamp": "00:47:13", "text": "OBSを使い始める。次にOBSは"}, {"type": "subtitle", "time": 2838.109, "timestamp": "00:47:18", "text": "それについては、電話してください。そのためNDIには"}, {"type": "subtitle", "time": 2841.829, "timestamp": "00:47:21", "text": "えっと、いくらでしたか？"}, {"type": "subtitle", "time": 2847.27, "timestamp": "00:47:27", "text": "えっと、1080p 60fpsの場合ですか？いいえ、1080p、60fpsです。"}, {"type": "subtitle", "time": 2849.91, "timestamp": "00:47:29", "text": "待って、白い紙はどこ？"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": "また？えっと、NDI。つまり、およそ"}, {"type": "subtitle", "time": 2858.27, "timestamp": "00:47:38", "text": "約600メガビットではなくバイト"}, {"type": "subtitle", "time": 2862.47, "timestamp": "00:47:42", "text": "自分。だから、私が"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "オンラインゲームをプレイすると、さらに苦痛が増します"}, {"type": "subtitle", "time": 2867.23, "timestamp": "00:47:47", "text": "モデルが動かなくなるため"}, {"type": "subtitle", "time": 2872.069, "timestamp": "00:47:52", "text": "立ち往生。つまり、それら全ては私の"}, {"type": "subtitle", "time": 2874.87, "timestamp": "00:47:54", "text": "ネットワーク設定全体が最大限に活用されています。"}]
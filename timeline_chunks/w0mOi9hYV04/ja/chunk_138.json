[{"type": "subtitle", "time": 8284.95, "timestamp": "02:18:04", "text": "戻る。ああ、君は学んでいるんだね"}, {"type": "subtitle", "time": 8287.509, "timestamp": "02:18:07", "text": "スペイン語。ニース。もう一つ。良い。良い。"}, {"type": "subtitle", "time": 8290.95, "timestamp": "02:18:10", "text": "よかったね。私にとっては、私は学ばなければならない"}, {"type": "subtitle", "time": 8294.07, "timestamp": "02:18:14", "text": "日本語、日本語を直してください。えっと"}, {"type": "subtitle", "time": 8296.95, "timestamp": "02:18:16", "text": "最近、アリスと遊んでいた"}, {"type": "subtitle", "time": 8299.429, "timestamp": "02:18:19", "text": "VRチャットで、なんと！彼はそうしなければならなかった"}, {"type": "subtitle", "time": 8302.629, "timestamp": "02:18:22", "text": "ずっと私を運んで"}, {"type": "subtitle", "time": 8307.709, "timestamp": "02:18:27", "text": "VRチャットでのセッションは"}, {"type": "subtitle", "time": 8311.389, "timestamp": "02:18:31", "text": "日本語は昔、日本語は"}, {"type": "subtitle", "time": 8314.15, "timestamp": "02:18:34", "text": "難しい、日本人って本当に難しい。私 私"}, {"type": "subtitle", "time": 8317.19, "timestamp": "02:18:37", "text": "彼は私を運ばなければならなかった。"}, {"type": "subtitle", "time": 8320.669, "timestamp": "02:18:40", "text": "だから私は学ばなければならない"}, {"type": "subtitle", "time": 8326.629, "timestamp": "02:18:46", "text": "中国語はおそらくすぐに"}, {"type": "subtitle", "time": 8327.709, "timestamp": "02:18:47", "text": "すべて"}, {"type": "subtitle", "time": 8332.15, "timestamp": "02:18:52", "text": "中国のCNコネラーコンステラー"}, {"type": "subtitle", "time": 8335.709, "timestamp": "02:18:55", "text": "私は苦しまない"}, {"type": "subtitle", "time": 8339.589, "timestamp": "02:18:59", "text": "英語。うん。でも私は良い友達に出会いました、"}]
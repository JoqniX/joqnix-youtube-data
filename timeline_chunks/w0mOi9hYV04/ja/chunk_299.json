[{"type": "subtitle", "time": 17943.11, "timestamp": "04:59:03", "text": "2番目？確実にするために何ができますか"}, {"type": "subtitle", "time": 17945.59, "timestamp": "04:59:05", "text": "さらに進展する？私はこれを望まない"}, {"type": "subtitle", "time": 17947.47, "timestamp": "04:59:07", "text": "私の影響"}, {"type": "subtitle", "time": 17950.868, "timestamp": "04:59:10", "text": "旅。私には夢がある。私は目標を持っています"}, {"type": "subtitle", "time": 17953.51, "timestamp": "04:59:13", "text": "私がYouTuberとしてやりたいことは"}, {"type": "subtitle", "time": 17954.51, "timestamp": "04:59:14", "text": "インド人"}, {"type": "subtitle", "time": 17956.43, "timestamp": "04:59:16", "text": "YouTuber。"}, {"type": "subtitle", "time": 17958.868, "timestamp": "04:59:18", "text": "右？そう考える必要がある"}, {"type": "subtitle", "time": 17961.31, "timestamp": "04:59:21", "text": "それらすべてを書き留めて、"}, {"type": "subtitle", "time": 17964.788, "timestamp": "04:59:24", "text": "紙。鏡の前に立ちなさい。お祭りを作ろう。"}, {"type": "subtitle", "time": 17967.59, "timestamp": "04:59:27", "text": "顔に笑顔を作ってください。平手打ち"}, {"type": "subtitle", "time": 17969.91, "timestamp": "04:59:29", "text": "顔とか何か。自分自身に言い聞かせてください"}, {"type": "subtitle", "time": 17973.948, "timestamp": "04:59:33", "text": "あなたならできる。私はできます"}, {"type": "subtitle", "time": 17976.47, "timestamp": "04:59:36", "text": "それ。うん。そして、より自信を持って"}, {"type": "subtitle", "time": 17979.19, "timestamp": "04:59:39", "text": "あなた自身、なぜならあなたが来たことを覚えているから"}, {"type": "subtitle", "time": 17982.27, "timestamp": "04:59:42", "text": "遠くまで行くと"}, {"type": "subtitle", "time": 17985.43, "timestamp": "04:59:45", "text": "あなたは、あらゆる苦難を受け入れ、"}, {"type": "subtitle", "time": 17988.55, "timestamp": "04:59:48", "text": "あなたは失敗も成功も受け入れ、"}, {"type": "subtitle", "time": 17991.15, "timestamp": "04:59:51", "text": "すべて。あなたはここまで来たのですね"}, {"type": "subtitle", "time": 17992.99, "timestamp": "04:59:52", "text": "ここ、"}, {"type": "subtitle", "time": 17996.15, "timestamp": "04:59:56", "text": "右？そして、そこにはまだまだ続くものがある。"}, {"type": "subtitle", "time": 17998.27, "timestamp": "04:59:58", "text": "まだ長い道のりがある"}]
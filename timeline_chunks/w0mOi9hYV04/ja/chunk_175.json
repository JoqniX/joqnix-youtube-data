[{"type": "subtitle", "time": 10502.23, "timestamp": "02:55:02", "text": "ぜひここにも行ってみてください。ああ、なんて間抜けなんだろう"}, {"type": "subtitle", "time": 10504.51, "timestamp": "02:55:04", "text": "時々。あなた"}, {"type": "subtitle", "time": 10508.75, "timestamp": "02:55:08", "text": "わかってる、私はもう一方の"}, {"type": "subtitle", "time": 10510.67, "timestamp": "02:55:10", "text": "側。"}, {"type": "subtitle", "time": 10517.309, "timestamp": "02:55:17", "text": "ああ神様、ジョーが"}, {"type": "subtitle", "time": 10519.87, "timestamp": "02:55:19", "text": "進捗。ああ、私は"}, {"type": "subtitle", "time": 10522.63, "timestamp": "02:55:22", "text": "午前。明日の朝は配信しなければならない。おお、"}, {"type": "subtitle", "time": 10525.11, "timestamp": "02:55:25", "text": "楽しい時間でした。ニース。ニース。 S. 何時に"}, {"type": "subtitle", "time": 10527.79, "timestamp": "02:55:27", "text": "ストリーミング配信してるの？"}, {"type": "subtitle", "time": 10529.71, "timestamp": "02:55:29", "text": "[音楽]"}, {"type": "subtitle", "time": 10531.71, "timestamp": "02:55:31", "text": "ヘリックス。"}, {"type": "subtitle", "time": 10534.67, "timestamp": "02:55:34", "text": "うん。"}, {"type": "subtitle", "time": 10539.55, "timestamp": "02:55:39", "text": "ああ、そうだよ。私はミスターが恋しいです。"}, {"type": "subtitle", "time": 10541.95, "timestamp": "02:55:41", "text": "えっと"}, {"type": "subtitle", "time": 10546.19, "timestamp": "02:55:46", "text": "ワタンダの日々"}, {"type": "subtitle", "time": 10548.79, "timestamp": "02:55:48", "text": "アレクサ。しばらく教会に行ってない"}, {"type": "subtitle", "time": 10552.55, "timestamp": "02:55:52", "text": "飛行機や戦車の中で撃たれる。私"}, {"type": "subtitle", "time": 10557.469, "timestamp": "02:55:57", "text": "What Thunderをもう一度ストリーミング配信するべきかな"}]
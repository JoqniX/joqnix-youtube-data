[{"type": "subtitle", "time": 4680.63, "timestamp": "01:18:00", "text": "Hドライバーにも注目し、"}, {"type": "subtitle", "time": 4684.95, "timestamp": "01:18:04", "text": "囲まれている、それは一体何だ？ええと、RTXと"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "またしても、包囲型のゲームだ。忘れた。"}, {"type": "subtitle", "time": 4689.75, "timestamp": "01:18:09", "text": "それは何と呼ばれていますか？"}, {"type": "subtitle", "time": 4698.229, "timestamp": "01:18:18", "text": "えっと、なんていう名前でしたっけ？私は忘れた"}, {"type": "subtitle", "time": 4703.149, "timestamp": "01:18:23", "text": "名前は知らないけど、Shroudのプレイを見ていた"}, {"type": "subtitle", "time": 4704.75, "timestamp": "01:18:24", "text": "それ。"}, {"type": "subtitle", "time": 4708.51, "timestamp": "01:18:28", "text": "ああ、ナイチンゲール。ナイチンゲール。"}, {"type": "subtitle", "time": 4711.27, "timestamp": "01:18:31", "text": "うん。ナイチンゲール。うん。ナイチンゲール。"}, {"type": "subtitle", "time": 4719.27, "timestamp": "01:18:39", "text": "はい。 RPGゲーム。それは楽しいですね。"}, {"type": "subtitle", "time": 4721.99, "timestamp": "01:18:41", "text": "正直言って、シュラウドは楽しそうに見える。"}, {"type": "subtitle", "time": 4725.05, "timestamp": "01:18:45", "text": "ナイチンゲールも良いし、"}, {"type": "subtitle", "time": 4728.99, "timestamp": "01:18:48", "text": "[音楽]"}, {"type": "subtitle", "time": 4733.03, "timestamp": "01:18:53", "text": "公平。でも私はこういうタイプのゲームが大好きなんです"}]
[{"type": "subtitle", "time": 601.99, "timestamp": "00:10:01", "text": "明日は温かいサバスープを食べます。ほとんど"}, {"type": "subtitle", "time": 604.07, "timestamp": "00:10:04", "text": "おそらく明日でしょう。次回そこに行くときは"}, {"type": "subtitle", "time": 607.59, "timestamp": "00:10:07", "text": "レストラン。うん。それは良くない。私は"}, {"type": "subtitle", "time": 610.59, "timestamp": "00:10:10", "text": "私が他人に危険を及ぼすとき"}, {"type": "subtitle", "time": 613.35, "timestamp": "00:10:13", "text": "ドライブ。ジョッキーはバスから"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "スクーターの音。うん。ええ、そうですね。うん。うん。"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "行く。ジョイ、今日はとても幸せそうですね。"}, {"type": "subtitle", "time": 628.71, "timestamp": "00:10:28", "text": "私は幸せです。待って、なぜ私のモデルは動かなくなったの？私"}, {"type": "subtitle", "time": 632.15, "timestamp": "00:10:32", "text": "理由はわからない。時々私のモデル"}, {"type": "subtitle", "time": 634.11, "timestamp": "00:10:34", "text": "保存する"}, {"type": "subtitle", "time": 638.069, "timestamp": "00:10:38", "text": "まるで引っかかっているかのように。動かなくなってしまった。"}, {"type": "subtitle", "time": 641.269, "timestamp": "00:10:41", "text": "文字通り身動きが取れない。今はそのように動いている"}, {"type": "subtitle", "time": 644.15, "timestamp": "00:10:44", "text": "私がやった動きをすべて取り入れて"}, {"type": "subtitle", "time": 648.15, "timestamp": "00:10:48", "text": "えっと、君は速い"}, {"type": "subtitle", "time": 655.91, "timestamp": "00:10:55", "text": "発見と努力は素晴らしい。はい。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "はい。はい。スープは100ルピーくらいです"}]
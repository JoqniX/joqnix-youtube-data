[{"type": "subtitle", "time": 1085.75, "timestamp": "00:18:05", "text": "すべてうまくいったことを願っています。"}, {"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "私も心配しています"}, {"type": "subtitle", "time": 1093.39, "timestamp": "00:18:13", "text": "ええと、何百万ものもの"}, {"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "すべては皆がどうなるか"}, {"type": "subtitle", "time": 1099.51, "timestamp": "00:18:19", "text": "誰かがそれを受け取るだろう、私はどうだろう"}, {"type": "subtitle", "time": 1103.43, "timestamp": "00:18:23", "text": "個人的にそれを引き受け、"}, {"type": "subtitle", "time": 1113.39, "timestamp": "00:18:33", "text": "もの。それで"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "たくさんありますが、ええ、うまくいくと思います。"}, {"type": "subtitle", "time": 1118.83, "timestamp": "00:18:38", "text": "私は確信しています"}, {"type": "subtitle", "time": 1121.47, "timestamp": "00:18:41", "text": "それ。はい。"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "ええ、コンテンツはいくつかあります"}, {"type": "subtitle", "time": 1127.909, "timestamp": "00:18:47", "text": "あちこちで変化が起きている。えっと"}, {"type": "subtitle", "time": 1130.07, "timestamp": "00:18:50", "text": "コンテンツの変更が行われます"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "あちこちに。えー、えー、スペックえー"}, {"type": "subtitle", "time": 1135.669, "timestamp": "00:18:55", "text": "特に私が述べたことに関して"}, {"type": "subtitle", "time": 1139.83, "timestamp": "00:18:59", "text": "作業の流れは、もうなくなります"}]
[{"type": "subtitle", "time": 3363.99, "timestamp": "00:56:03", "text": "私が考えていたコンセプトアートでは"}, {"type": "subtitle", "time": 3368.069, "timestamp": "00:56:08", "text": "私のデザインは、ずっと以前から考えていたものです。だから私はこう思った"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "うん、もしかしたらあのコンセプトアートを使えるかもしれないね。"}, {"type": "subtitle", "time": 3374.589, "timestamp": "00:56:14", "text": "ない？"}, {"type": "subtitle", "time": 3377.829, "timestamp": "00:56:17", "text": "えっと、私は長い髪を1年くらいしか保ってなかったんです"}, {"type": "subtitle", "time": 3380.19, "timestamp": "00:56:20", "text": "年。うん。自分"}, {"type": "subtitle", "time": 3382.95, "timestamp": "00:56:22", "text": "あまりにも。うん。うん。うん。うん。したい"}, {"type": "subtitle", "time": 3384.47, "timestamp": "00:56:24", "text": "髪を伸ばしたい。私は現在"}, {"type": "subtitle", "time": 3386.71, "timestamp": "00:56:26", "text": "髪を短く伸ばします。"}, {"type": "subtitle", "time": 3389.829, "timestamp": "00:56:29", "text": "現状では、文字通り、見た目は"}, {"type": "subtitle", "time": 3391.95, "timestamp": "00:56:31", "text": "現在、少し"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "少し。アスリートモデルみたいになるだろう"}, {"type": "subtitle", "time": 3399.23, "timestamp": "00:56:39", "text": "数種類のスポーツマン風ヘアスタイル"}, {"type": "subtitle", "time": 3401.91, "timestamp": "00:56:41", "text": "数ヶ月。もうすぐだ。私はただ必要としている"}, {"type": "subtitle", "time": 3417.23, "timestamp": "00:56:57", "text": "えーと、フロントバンド。"}]
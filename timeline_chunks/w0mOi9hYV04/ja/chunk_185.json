[{"type": "subtitle", "time": 11106.91, "timestamp": "03:05:06", "text": "ぞっとする。私は遊ぶつもりだった"}, {"type": "subtitle", "time": 11110.269, "timestamp": "03:05:10", "text": "Apexですが、その後ストリームを見たので、"}, {"type": "subtitle", "time": 11115.23, "timestamp": "03:05:15", "text": "見ている。うん。待って、えっと、あなたはApexをプレイしていますか？"}, {"type": "subtitle", "time": 11121.15, "timestamp": "03:05:21", "text": "ニース。私はひらがなを練習しています"}, {"type": "subtitle", "time": 11124.79, "timestamp": "03:05:24", "text": "カタカナ。おお、いいね。私も練習しています"}, {"type": "subtitle", "time": 11127.309, "timestamp": "03:05:27", "text": "えーと、今はZukiとひらがなで"}, {"type": "subtitle", "time": 11130.11, "timestamp": "03:05:30", "text": "アキアビは私の両方とも"}, {"type": "subtitle", "time": 11132.389, "timestamp": "03:05:32", "text": "モデレーター。だから彼らは私に"}, {"type": "subtitle", "time": 11134.67, "timestamp": "03:05:34", "text": "日本語を話す"}, {"type": "subtitle", "time": 11138.63, "timestamp": "03:05:38", "text": "久しぶりに日本語を話した。私は覚えています"}, {"type": "subtitle", "time": 11144.389, "timestamp": "03:05:44", "text": "去年は、えーっと、えーっと、"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "去年の3月だったか7月だったか、3月だったかな？"}, {"type": "subtitle", "time": 11152.469, "timestamp": "03:05:52", "text": "以前はそうだったんだけど、これに乗り換えてからは"}, {"type": "subtitle", "time": 11153.95, "timestamp": "03:05:53", "text": "VTuber"}, {"type": "subtitle", "time": 11157.51, "timestamp": "03:05:57", "text": "トレンドは、私の現実世界ではなく、"}]
[{"type": "subtitle", "time": 14665.11, "timestamp": "04:04:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14667.07, "timestamp": "04:04:27", "text": "私は疲れていた"}, {"type": "subtitle", "time": 14670.3, "timestamp": "04:04:30", "text": "今日。午前3時頃に目が覚めた。"}, {"type": "subtitle", "time": 14671.389, "timestamp": "04:04:31", "text": "[音楽]"}, {"type": "subtitle", "time": 14674.63, "timestamp": "04:04:34", "text": "午前中に目が覚めて、夕方に"}, {"type": "subtitle", "time": 14678.349, "timestamp": "04:04:38", "text": "昨日は午前8時に寝ました。"}, {"type": "subtitle", "time": 14686.79, "timestamp": "04:04:46", "text": "もの。でも、すごく疲れていたんです。私の体"}, {"type": "subtitle", "time": 14689.75, "timestamp": "04:04:49", "text": "内面は死んでいた。そして今週私は"}]
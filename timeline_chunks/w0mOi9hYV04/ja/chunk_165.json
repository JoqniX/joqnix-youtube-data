[{"type": "subtitle", "time": 9904.349, "timestamp": "02:45:04", "text": "少し。えっと、昔はサクルがいたんだけど、待って"}, {"type": "subtitle", "time": 9908.19, "timestamp": "02:45:08", "text": "さくらアルバム。はい。"}, {"type": "subtitle", "time": 9910.95, "timestamp": "02:45:10", "text": "ネコ。待って、それは違う。これがそれだ。"}, {"type": "subtitle", "time": 9914.99, "timestamp": "02:45:14", "text": "遊ぶ。おい。これを再生してください。"}, {"type": "subtitle", "time": 9922.11, "timestamp": "02:45:22", "text": "はぁ？"}, {"type": "subtitle", "time": 9931.63, "timestamp": "02:45:31", "text": "わかった。うん、これは良いね。さあ"}, {"type": "subtitle", "time": 9933.389, "timestamp": "02:45:33", "text": "来る。"}, {"type": "subtitle", "time": 9936.59, "timestamp": "02:45:36", "text": "こんにちは。目覚め"}, {"type": "subtitle", "time": 9939.19, "timestamp": "02:45:39", "text": "上。私の美しい歌声が必要なら"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "声で、聞いてください。話したい。いいえ、それは"}, {"type": "subtitle", "time": 9944.19, "timestamp": "02:45:44", "text": "悪い。"}, {"type": "subtitle", "time": 9947.309, "timestamp": "02:45:47", "text": "BTM。私の読み間違いでしょうか？"}, {"type": "subtitle", "time": 9949.63, "timestamp": "02:45:49", "text": "ベイブス。私は疑問に思う。"}, {"type": "subtitle", "time": 9950.79, "timestamp": "02:45:50", "text": "[音楽]"}, {"type": "subtitle", "time": 9958.63, "timestamp": "02:45:58", "text": "不思議。ええと、できる限り長く滞在します。"}]
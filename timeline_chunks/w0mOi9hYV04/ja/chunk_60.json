[{"type": "subtitle", "time": 3600.15, "timestamp": "01:00:00", "text": "自分のスペース、オフィスを手に入れる予定です"}, {"type": "subtitle", "time": 3603.99, "timestamp": "01:00:03", "text": "スペース、だって、えーと、だって、えーと、私の"}, {"type": "subtitle", "time": 3605.309, "timestamp": "01:00:05", "text": "テナント"}, {"type": "subtitle", "time": 3613.349, "timestamp": "01:00:13", "text": "または、空室になった、そう、空室になったという言葉です。"}, {"type": "subtitle", "time": 3615.349, "timestamp": "01:00:15", "text": "だから私は「うん、もし君が望むなら、"}, {"type": "subtitle", "time": 3618.63, "timestamp": "01:00:18", "text": "私たちはエリアのような場所を設けることができます"}, {"type": "subtitle", "time": 3621.589, "timestamp": "01:00:21", "text": "あなたが住むための部屋と、上の階の部屋もあります。"}, {"type": "subtitle", "time": 3625.67, "timestamp": "01:00:25", "text": "そして、2階全体を改装します。"}, {"type": "subtitle", "time": 3628.71, "timestamp": "01:00:28", "text": "配置して2つの部分に分けます"}, {"type": "subtitle", "time": 3632.349, "timestamp": "01:00:32", "text": "テナントが2人いれば、もっと楽になります"}, {"type": "subtitle", "time": 3634.91, "timestamp": "01:00:34", "text": "管理とそれらすべて"}, {"type": "subtitle", "time": 3637.549, "timestamp": "01:00:37", "text": "もの。\""}, {"type": "subtitle", "time": 3641.39, "timestamp": "01:00:41", "text": "ええ、まあそんな感じです。私はちょっと"}, {"type": "subtitle", "time": 3645.589, "timestamp": "01:00:45", "text": "心配だけど、そうだけど、最終的には"}, {"type": "subtitle", "time": 3649.67, "timestamp": "01:00:49", "text": "また家を出るけど、"}, {"type": "subtitle", "time": 3650.589, "timestamp": "01:00:50", "text": "戻る"}]
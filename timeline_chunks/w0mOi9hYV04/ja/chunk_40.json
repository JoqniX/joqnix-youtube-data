[{"type": "subtitle", "time": 2401.589, "timestamp": "00:40:01", "text": "ホームボタン、だって君にはそれが必要なんだから"}, {"type": "subtitle", "time": 2404.63, "timestamp": "00:40:04", "text": "ホームボタンなしで。わかった。それで、えーと、"}, {"type": "subtitle", "time": 2407.43, "timestamp": "00:40:07", "text": "問題は、ショートパンツを履きたいんだけど、"}, {"type": "subtitle", "time": 2410.069, "timestamp": "00:40:10", "text": "今のところは私のWチャンネルで配信します。それで、"}, {"type": "subtitle", "time": 2412.39, "timestamp": "00:40:12", "text": "人々は最終的にWに加入するだろう"}, {"type": "subtitle", "time": 2414.349, "timestamp": "00:40:14", "text": "チャネル。私はみんなにWを購読してほしい"}, {"type": "subtitle", "time": 2416.71, "timestamp": "00:40:16", "text": "正直に言うと、チャンネルです。私は"}, {"type": "subtitle", "time": 2419.99, "timestamp": "00:40:19", "text": "ハイライトやクリップをアップロードする"}, {"type": "subtitle", "time": 2422.67, "timestamp": "00:40:22", "text": "Wチャンネルのコンテンツ"}, {"type": "subtitle", "time": 2424.19, "timestamp": "00:40:24", "text": "今。"}, {"type": "subtitle", "time": 2426.99, "timestamp": "00:40:26", "text": "えっと、でも"}, {"type": "subtitle", "time": 2429.47, "timestamp": "00:40:29", "text": "[音楽]"}, {"type": "subtitle", "time": 2451.63, "timestamp": "00:40:51", "text": "バ。おお。ああ。うん、私が言ったら「ba」って表示される"}]
[{"type": "subtitle", "time": 17820.788, "timestamp": "04:57:00", "text": "Vチューブをどのように見ても構いません"}, {"type": "subtitle", "time": 17823.03, "timestamp": "04:57:03", "text": "しかし、伝統的な方法でそれを行う"}, {"type": "subtitle", "time": 17825.35, "timestamp": "04:57:05", "text": "あなたは本来の性格を発揮し、"}, {"type": "subtitle", "time": 17827.67, "timestamp": "04:57:07", "text": "壊れていない、または個人的なものではない"}, {"type": "subtitle", "time": 17830.07, "timestamp": "04:57:10", "text": "個人的な場合、またはあなたが自分の"}, {"type": "subtitle", "time": 17834.23, "timestamp": "04:57:14", "text": "自分自身と、オープンになって実際に"}, {"type": "subtitle", "time": 17836.948, "timestamp": "04:57:16", "text": "自分が本当にどう感じているかを率直に話してください"}, {"type": "subtitle", "time": 17840.23, "timestamp": "04:57:20", "text": "どんな道を選んでも後悔しないで"}, {"type": "subtitle", "time": 17843.03, "timestamp": "04:57:23", "text": "あなたがする選択は、"}, {"type": "subtitle", "time": 17846.39, "timestamp": "04:57:26", "text": "これらはすべてあなたの行く手を阻む障害物です"}, {"type": "subtitle", "time": 17848.99, "timestamp": "04:57:28", "text": "いずれ遭遇することになる"}, {"type": "subtitle", "time": 17852.55, "timestamp": "04:57:32", "text": "例えば、新しいYouTuberがデビューしたとしましょう"}, {"type": "subtitle", "time": 17854.47, "timestamp": "04:57:34", "text": "たくさんの人がやって来たので、"}, {"type": "subtitle", "time": 17856.628, "timestamp": "04:57:36", "text": "彼らは読むのにとても緊張するだろう"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "チャットなど、あなたもご存知かもしれませんよね？"}, {"type": "subtitle", "time": 17862.11, "timestamp": "04:57:42", "text": "ストリーミングを始めたとき、"}, {"type": "subtitle", "time": 17864.628, "timestamp": "04:57:44", "text": "神経をすり減らすような、それは正しかった、人々は"}, {"type": "subtitle", "time": 17867.59, "timestamp": "04:57:47", "text": "多くの人が話している、など"}, {"type": "chat", "time": 17868.097, "timestamp": "04:57:48", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}, {"type": "subtitle", "time": 17869.35, "timestamp": "04:57:49", "text": "必ず読んでください"}, {"type": "subtitle", "time": 17872.868, "timestamp": "04:57:52", "text": "皆さんのメッセージなどですね。そうですよね？たくさんの"}, {"type": "subtitle", "time": 17875.51, "timestamp": "04:57:55", "text": "物事、ですよね？それからゆっくりと"}, {"type": "subtitle", "time": 17878.23, "timestamp": "04:57:58", "text": "あなたは適応した。そして、適応すればするほど、"}]
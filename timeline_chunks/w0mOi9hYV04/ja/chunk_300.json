[{"type": "subtitle", "time": 18001.43, "timestamp": "05:00:01", "text": "今、あなたを待っている道があります。とても"}, {"type": "subtitle", "time": 18004.15, "timestamp": "05:00:04", "text": "あなたを待っているものがたくさんあります"}, {"type": "subtitle", "time": 18006.19, "timestamp": "05:00:06", "text": "彼らにたどり着かなければならない"}, {"type": "subtitle", "time": 18008.03, "timestamp": "05:00:08", "text": "あまりにも。しかし"}, {"type": "subtitle", "time": 18010.75, "timestamp": "05:00:10", "text": "そう、こう考えてみよう"}, {"type": "subtitle", "time": 18014.35, "timestamp": "05:00:14", "text": "それで私は"}, {"type": "subtitle", "time": 18017.07, "timestamp": "05:00:17", "text": "関係ないけど、そう、それが私の"}, {"type": "subtitle", "time": 18020.23, "timestamp": "05:00:20", "text": "私は"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "反対側も多すぎるし、他のものと同じように"}, {"type": "subtitle", "time": 18026.07, "timestamp": "05:00:26", "text": "彼らの立場になって考えてみる"}, {"type": "chat", "time": 18028.089, "timestamp": "05:00:28", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Is this the same joq that worries over everythingUCkszU2WH9gy1mb0dV-11UJg/hcMfY5_zAbbxvwKLooCoCA"}, {"type": "subtitle", "time": 18035.15, "timestamp": "05:00:35", "text": "ああ、私は心配しすぎなんです。よし。しかし"}, {"type": "subtitle", "time": 18042.99, "timestamp": "05:00:42", "text": "たくさん、そしてもちろん"}, {"type": "subtitle", "time": 18048.75, "timestamp": "05:00:48", "text": "えーと、えーと、例えば、もし"}, {"type": "subtitle", "time": 18052.03, "timestamp": "05:00:52", "text": "つまり、私は望んでいない"}, {"type": "subtitle", "time": 18055.19, "timestamp": "05:00:55", "text": "では、お話をしましょう。私はほしくない"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "名前を挙げるが、知っている人は"}]
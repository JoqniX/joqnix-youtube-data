[{"type": "subtitle", "time": 6901.589, "timestamp": "01:55:01", "text": "えーっと、つまり、こう考えてみてください"}, {"type": "subtitle", "time": 6904.31, "timestamp": "01:55:04", "text": "これ。わかった。だから、これらのアニメを観るなら"}, {"type": "subtitle", "time": 6906.95, "timestamp": "01:55:06", "text": "などなど、もしあなたが"}, {"type": "subtitle", "time": 6909.35, "timestamp": "01:55:09", "text": "髪が長い女の子なら、"}, {"type": "subtitle", "time": 6911.99, "timestamp": "01:55:11", "text": "短いものがあれば、ブレンドできます"}, {"type": "subtitle", "time": 6915.669, "timestamp": "01:55:15", "text": "溶け込んで男性になり、それで"}, {"type": "subtitle", "time": 6919.27, "timestamp": "01:55:19", "text": "活動したり、働いたり、仕事に就いたりする"}, {"type": "subtitle", "time": 6921.75, "timestamp": "01:55:21", "text": "あるいは軍隊に入って戦い、"}, {"type": "subtitle", "time": 6925.51, "timestamp": "01:55:25", "text": "大きな筋肉質の男との剣の戦い"}, {"type": "subtitle", "time": 6928.629, "timestamp": "01:55:28", "text": "ああ、そう、男性のような人たち"}, {"type": "subtitle", "time": 6934.35, "timestamp": "01:55:34", "text": "PPP のように PPP スロットを挿入しない"}, {"type": "subtitle", "time": 6938.87, "timestamp": "01:55:38", "text": "剣がぶつかり合うような音を挿入します。うん、"}, {"type": "subtitle", "time": 6943.589, "timestamp": "01:55:43", "text": "そんな感じ。あれはどのアニメだったっけ？えっと"}, {"type": "subtitle", "time": 6945.51, "timestamp": "01:55:45", "text": "えーと、最近公開されたそのチラ見せ"}, {"type": "subtitle", "time": 6947.35, "timestamp": "01:55:47", "text": "エピソード。こうなるんじゃないの？"}, {"type": "subtitle", "time": 6948.91, "timestamp": "01:55:48", "text": "今週ですか、それとも来週ですか？私"}, {"type": "subtitle", "time": 6953.669, "timestamp": "01:55:53", "text": "忘れた。えーっと、ループ7のことです"}, {"type": "subtitle", "time": 6958.149, "timestamp": "01:55:58", "text": "えっと、あの、あの悪役アニメ。それ"}]
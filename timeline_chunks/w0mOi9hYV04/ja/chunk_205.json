[{"type": "subtitle", "time": 12320.91, "timestamp": "03:25:20", "text": "私"}, {"type": "subtitle", "time": 12323.79, "timestamp": "03:25:23", "text": "思う、私は必要だと思う"}, {"type": "subtitle", "time": 12329.309, "timestamp": "03:25:29", "text": "私は必要だと思う 私は必要だと感じる"}, {"type": "subtitle", "time": 12333.03, "timestamp": "03:25:33", "text": "ネジを締め直す必要があるように感じます"}, {"type": "subtitle", "time": 12338.15, "timestamp": "03:25:38", "text": "すべてです。やってみるべきでしょうか？"}, {"type": "subtitle", "time": 12340.55, "timestamp": "03:25:40", "text": "どう思いますか？ええと、普通の人間"}, {"type": "subtitle", "time": 12343.75, "timestamp": "03:25:43", "text": "人は自分のモニターを見なければならない。私"}, {"type": "subtitle", "time": 12345.75, "timestamp": "03:25:45", "text": "私のテーブルから遠いのは分かっているけど、"}, {"type": "subtitle", "time": 12349.63, "timestamp": "03:25:49", "text": "それでも、これを保管しておくべきでしょうか？"}, {"type": "subtitle", "time": 12352.229, "timestamp": "03:25:52", "text": "上昇した？だから、調べてみる必要がある。"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "上向きに、そして頭を上に向けるように。しかし"}]
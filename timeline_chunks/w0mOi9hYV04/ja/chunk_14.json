[{"type": "subtitle", "time": 841.949, "timestamp": "00:14:01", "text": "主に私はあまり詳しくありません"}, {"type": "subtitle", "time": 845.829, "timestamp": "00:14:05", "text": "ええと、iPhone以外のApple製品。"}, {"type": "subtitle", "time": 848.55, "timestamp": "00:14:08", "text": "私が知っているのはそれだけです。うん、iPhoneだよ。"}, {"type": "subtitle", "time": 850.389, "timestamp": "00:14:10", "text": "それから"}, {"type": "subtitle", "time": 853.949, "timestamp": "00:14:13", "text": "えっと、それなら、"}, {"type": "subtitle", "time": 857.269, "timestamp": "00:14:17", "text": "最近リリースされた"}, {"type": "subtitle", "time": 859.47, "timestamp": "00:14:19", "text": "ビジョンプロマックスまたは"}, {"type": "subtitle", "time": 862.389, "timestamp": "00:14:22", "text": "ビジョンプラスか何か"}, {"type": "subtitle", "time": 865.269, "timestamp": "00:14:25", "text": "これはこう呼ばれます。そう、それだ。ええ、そうです"}, {"type": "subtitle", "time": 867.509, "timestamp": "00:14:27", "text": "高い。そう、ストリーミング配信しないといけないんだ"}, {"type": "subtitle", "time": 869.43, "timestamp": "00:14:29", "text": "異なるプラットフォーム上で。いや、いや、いや。その"}, {"type": "subtitle", "time": 872.99, "timestamp": "00:14:32", "text": "なぜなら私は基本的に"}, {"type": "subtitle", "time": 874.59, "timestamp": "00:14:34", "text": "ストリーム。"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "えっと、基本的にはストリーミング配信をしたいんだけど、"}, {"type": "subtitle", "time": 884.47, "timestamp": "00:14:44", "text": "私は、最近の彼は、"}, {"type": "subtitle", "time": 888.11, "timestamp": "00:14:48", "text": "あちこちに。私は疑問に思う"}, {"type": "subtitle", "time": 891.47, "timestamp": "00:14:51", "text": "[音楽]"}, {"type": "subtitle", "time": 893.79, "timestamp": "00:14:53", "text": "なぜ"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "悪い、悪いんだ。大丈夫。私は私は"}, {"type": "subtitle", "time": 899.75, "timestamp": "00:14:59", "text": "慣れるしかないよ。それはむしろ、えっと、何？"}]
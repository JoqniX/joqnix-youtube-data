[{"type": "subtitle", "time": 1322.11, "timestamp": "00:22:02", "text": "ボードまたはメインチャンネルは次のようになります"}, {"type": "subtitle", "time": 1325.27, "timestamp": "00:22:05", "text": "私の、私のもの。だから、今は私と繋がっている。"}, {"type": "subtitle", "time": 1328.549, "timestamp": "00:22:08", "text": "だから、まあいいんじゃないでしょうか。そうそう。"}, {"type": "subtitle", "time": 1342.63, "timestamp": "00:22:22", "text": "超越的。ああ、なんてことだ、あなたは"}, {"type": "subtitle", "time": 1345.51, "timestamp": "00:22:25", "text": "勤勉な音楽プロデューサーと"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "ミュージシャン。よかった。私たちは"}, {"type": "subtitle", "time": 1353.11, "timestamp": "00:22:33", "text": "えーと、私たちの持っているすべての音楽は"}, {"type": "subtitle", "time": 1355.07, "timestamp": "00:22:35", "text": "ストリーム、すべて"}, {"type": "subtitle", "time": 1359.11, "timestamp": "00:22:39", "text": "RealityによるファンメイドOSTのようなもの"}, {"type": "subtitle", "time": 1362.789, "timestamp": "00:22:42", "text": "スタジオとアイゼン。ええ、幸せです。"}, {"type": "subtitle", "time": 1365.669, "timestamp": "00:22:45", "text": "ありがとう。私は嬉しい。なぜ私の人間は"}, {"type": "subtitle", "time": 1368.149, "timestamp": "00:22:48", "text": "立ち往生？おい、どけ。私は表現をしている。"}, {"type": "subtitle", "time": 1371.59, "timestamp": "00:22:51", "text": "わかった。よし、動いている。"}, {"type": "subtitle", "time": 1373.59, "timestamp": "00:22:53", "text": "えっと、メインチャンネルを購読した方が良いんじゃない？"}, {"type": "subtitle", "time": 1375.909, "timestamp": "00:22:55", "text": "チャネル？うん。うん。うん。うん。えっと、それは"}, {"type": "subtitle", "time": 1377.75, "timestamp": "00:22:57", "text": "メインチャンネルを購読する方が良いでしょう。私"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "わからない。私はちょっと、私はただ"}]
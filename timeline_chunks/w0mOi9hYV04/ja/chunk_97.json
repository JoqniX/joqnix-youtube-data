[{"type": "subtitle", "time": 5823.35, "timestamp": "01:37:03", "text": "うん、私も作ってみたよ"}, {"type": "subtitle", "time": 5826.629, "timestamp": "01:37:06", "text": "収益化されたもののように"}, {"type": "subtitle", "time": 5828.83, "timestamp": "01:37:08", "text": "収益化または類似"}, {"type": "subtitle", "time": 5833.87, "timestamp": "01:37:13", "text": "最近、サポーター専用のウェブサイトが開設されました。"}, {"type": "subtitle", "time": 5839.27, "timestamp": "01:37:19", "text": "えっと、でもそれは良いことだけど、でもでも"}, {"type": "subtitle", "time": 5841.95, "timestamp": "01:37:21", "text": "ええと、それはそれを持っています"}, {"type": "subtitle", "time": 5843.95, "timestamp": "01:37:23", "text": "問題"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "残念ながら。問題点もある。はい、では"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "いいことを教えてあげよう。つまり、Twitchにとっては、"}, {"type": "subtitle", "time": 5852.629, "timestamp": "01:37:32", "text": "Twitchをやっている人、気に入ったらサブスクライブしてね"}, {"type": "subtitle", "time": 5855.03, "timestamp": "01:37:35", "text": "またはティア1またはティアを使用した何か"}, {"type": "subtitle", "time": 5857.35, "timestamp": "01:37:37", "text": "2 または 33 を購入すると割引が適用されます。"}, {"type": "subtitle", "time": 5859.83, "timestamp": "01:37:39", "text": "何か。うん。だから、登録できます"}, {"type": "subtitle", "time": 5862.149, "timestamp": "01:37:42", "text": "このウェブサイトとその他すべて。しかしもし"}, {"type": "subtitle", "time": 5864.629, "timestamp": "01:37:44", "text": "あなたはYouTubeメンバーだと思います、"}, {"type": "subtitle", "time": 5868.31, "timestamp": "01:37:48", "text": "割引クーポンか何かを発行する。"}, {"type": "subtitle", "time": 5872.95, "timestamp": "01:37:52", "text": "えーと、コードを入力するには"}, {"type": "subtitle", "time": 5875.51, "timestamp": "01:37:55", "text": "1か月。"}, {"type": "subtitle", "time": 5879.189, "timestamp": "01:37:59", "text": "ええと、登録は無料です。わかった。そして"}]
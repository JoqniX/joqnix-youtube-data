[{"type": "subtitle", "time": 7261.95, "timestamp": "02:01:01", "text": "えーっと、また家に帰るとか。"}, {"type": "subtitle", "time": 7266.87, "timestamp": "02:01:06", "text": "えっと、それで、えっと、私は取引か何かに参戦しました"}, {"type": "subtitle", "time": 7269.31, "timestamp": "02:01:09", "text": "父との結論"}, {"type": "subtitle", "time": 7272.55, "timestamp": "02:01:12", "text": "私が別のスペースを欲しかったのは、"}, {"type": "subtitle", "time": 7276.629, "timestamp": "02:01:16", "text": "それでも私は自由と独立を望んでいる"}, {"type": "subtitle", "time": 7279.189, "timestamp": "02:01:19", "text": "ええ、おそらく彼らは"}, {"type": "subtitle", "time": 7283.75, "timestamp": "02:01:23", "text": "3月頃に作業する予定です。"}, {"type": "subtitle", "time": 7286.47, "timestamp": "02:01:26", "text": "自分のスペースオフィススペースを手に入れる"}, {"type": "subtitle", "time": 7291.229, "timestamp": "02:01:31", "text": "だって、えーと、だって、私のテナントが"}, {"type": "subtitle", "time": 7304.149, "timestamp": "02:01:44", "text": "空き地ではエリアのような場所を設けることができます"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "あなたが住むために、そしていくつかの"}, {"type": "subtitle", "time": 7310.03, "timestamp": "02:01:50", "text": "上の階を改装します"}, {"type": "subtitle", "time": 7313.51, "timestamp": "02:01:53", "text": "2階全体を分けて"}, {"type": "subtitle", "time": 7315.75, "timestamp": "02:01:55", "text": "2つの区画に分かれているので、2人のテナントが入居できます。"}]
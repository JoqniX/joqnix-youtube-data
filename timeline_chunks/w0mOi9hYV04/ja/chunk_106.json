[{"type": "subtitle", "time": 6363.51, "timestamp": "01:46:03", "text": "まだ。あなたは私たちの英語のVです。「えっと、英語」"}, {"type": "subtitle", "time": 6378.79, "timestamp": "01:46:18", "text": "ええ、でもイベント、でも主に"}, {"type": "subtitle", "time": 6380.99, "timestamp": "01:46:20", "text": "心から、私は"}, {"type": "subtitle", "time": 6383.91, "timestamp": "01:46:23", "text": "実際にそこで配信できて嬉しいです。"}, {"type": "subtitle", "time": 6386.149, "timestamp": "01:46:26", "text": "早く友達を作りたい"}, {"type": "subtitle", "time": 6389.27, "timestamp": "01:46:29", "text": "そこで適切なコンテンツを作成する"}, {"type": "subtitle", "time": 6391.83, "timestamp": "01:46:31", "text": "ゲームとかそういうものよりも、そちらの方がよっぽどいい。私"}, {"type": "subtitle", "time": 6393.75, "timestamp": "01:46:33", "text": "取らなければならない、頼まなければならない"}, {"type": "subtitle", "time": 6395.75, "timestamp": "01:46:35", "text": "権限"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "えーと、ゲームのホワイトリストみたいなもの"}, {"type": "subtitle", "time": 6401.51, "timestamp": "01:46:41", "text": "実は。だから、その時私は"}, {"type": "subtitle", "time": 6405.99, "timestamp": "01:46:45", "text": "ValerantとApexをストリーミング配信しながら"}, {"type": "subtitle", "time": 6408.629, "timestamp": "01:46:48", "text": "ぼやけた画像"}, {"type": "subtitle", "time": 6411.87, "timestamp": "01:46:51", "text": "ええと、ぼかし処理をしながら。うん。ねずみ"}]
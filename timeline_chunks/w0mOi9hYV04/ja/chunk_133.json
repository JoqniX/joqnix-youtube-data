[{"type": "subtitle", "time": 7988.87, "timestamp": "02:13:08", "text": "えっと。ああ、軽量級のG。ああ、わかった。わかった。"}, {"type": "subtitle", "time": 7991.43, "timestamp": "02:13:11", "text": "わかった。スクーティーだと思う。うん。新世代"}, {"type": "subtitle", "time": 7993.83, "timestamp": "02:13:13", "text": "えーと、新世代のやつ。新世代バイク"}, {"type": "subtitle", "time": 7999.189, "timestamp": "02:13:19", "text": "自動車関連のことは、電話のことでしょう。うん。"}, {"type": "subtitle", "time": 8008.51, "timestamp": "02:13:28", "text": "待って。ただ「ふむ」という感じ。その"}, {"type": "subtitle", "time": 8009.87, "timestamp": "02:13:29", "text": "[音楽]"}, {"type": "subtitle", "time": 8032.709, "timestamp": "02:13:52", "text": "わかった。あ、そういえば、もしあなたが"}, {"type": "subtitle", "time": 8036.31, "timestamp": "02:13:56", "text": "スクーターの種類やスクーターの種類を知りたい"}, {"type": "subtitle", "time": 8039.99, "timestamp": "02:13:59", "text": "あるいはそれが何であれ、私はそれを持っています。"}]
[{"type": "subtitle", "time": 3300.309, "timestamp": "00:55:00", "text": "女性キャラクターと一緒に"}, {"type": "subtitle", "time": 3303.75, "timestamp": "00:55:03", "text": "ショートボブカットのヘアスタイルですよね？うん。"}, {"type": "subtitle", "time": 3308.99, "timestamp": "00:55:08", "text": "えーと、シン・ユンみたいな感じ"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "えっと、原神か何かから。私はしません"}, {"type": "subtitle", "time": 3318.829, "timestamp": "00:55:18", "text": "うーん、わからない。"}, {"type": "subtitle", "time": 3322.39, "timestamp": "00:55:22", "text": "頭がもっと長いのかも。うん。最終的には"}, {"type": "subtitle", "time": 3325.75, "timestamp": "00:55:25", "text": "まるで進化のようだ。もう一度考えてみてください"}, {"type": "subtitle", "time": 3328.15, "timestamp": "00:55:28", "text": "もちろん、私はポイントを主張するつもりです"}, {"type": "subtitle", "time": 3330.87, "timestamp": "00:55:30", "text": "私は大きくて長い髪をしていて、"}, {"type": "subtitle", "time": 3333.51, "timestamp": "00:55:33", "text": "私の上にそれを付けて、まるでそこから出てくるように"}, {"type": "subtitle", "time": 3336.87, "timestamp": "00:55:36", "text": "私のえっと、胸って何て言うんだっけ？"}, {"type": "subtitle", "time": 3339.51, "timestamp": "00:55:39", "text": "ほら、あの人がどうやってそれをやったか知ってるでしょ"}, {"type": "subtitle", "time": 3342.79, "timestamp": "00:55:42", "text": "リサのヘアスタイルはどのアニメのヘアスタイルですか？"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "呪われた髪型か、"}, {"type": "subtitle", "time": 3347.109, "timestamp": "00:55:47", "text": "リサが何か正しいことをしているような感じ"}, {"type": "subtitle", "time": 3350.15, "timestamp": "00:55:50", "text": "いつかそれを置きたい"}, {"type": "subtitle", "time": 3353.27, "timestamp": "00:55:53", "text": "いつか思いつくアイデアの一つだよ"}, {"type": "subtitle", "time": 3356.349, "timestamp": "00:55:56", "text": "ジョックの進化"}, {"type": "subtitle", "time": 3359.99, "timestamp": "00:55:59", "text": "星座。ああ、あれはこんな感じだった"}]
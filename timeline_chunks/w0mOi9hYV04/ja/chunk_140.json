[{"type": "subtitle", "time": 8404.79, "timestamp": "02:20:04", "text": "はい。 RPGゲーム。それは楽しいですね。そして覆い隠された"}, {"type": "subtitle", "time": 8407.51, "timestamp": "02:20:07", "text": "正直言って、楽しそうだ。ナイチンゲールは"}, {"type": "subtitle", "time": 8409.74, "timestamp": "02:20:09", "text": "また、"}, {"type": "subtitle", "time": 8413.63, "timestamp": "02:20:13", "text": "[音楽]"}, {"type": "subtitle", "time": 8417.75, "timestamp": "02:20:17", "text": "そういう意味では、私はこういうタイプのゲームが大好きなんです"}, {"type": "subtitle", "time": 8422.87, "timestamp": "02:20:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8425.99, "timestamp": "02:20:25", "text": "私はこういうゲームが大好きですが、"}, {"type": "subtitle", "time": 8428.87, "timestamp": "02:20:28", "text": "ただ、実際にそうしなければならない"}, {"type": "subtitle", "time": 8431.389, "timestamp": "02:20:31", "text": "プレイしてください。それは"}, {"type": "subtitle", "time": 8435.79, "timestamp": "02:20:35", "text": "もの。ああ、昨日発売されたよ。"}, {"type": "subtitle", "time": 8438.55, "timestamp": "02:20:38", "text": "何？このゲームは昨日発売されました。おお"}, {"type": "subtitle", "time": 8439.79, "timestamp": "02:20:39", "text": "我が神よ。"}, {"type": "subtitle", "time": 8448.349, "timestamp": "02:20:48", "text": "覆われている？"}, {"type": "subtitle", "time": 8450.55, "timestamp": "02:20:50", "text": "1,300。わかった。"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "そしてシュラウドは先月24日にリリースされた"}, {"type": "subtitle", "time": 8454.12, "timestamp": "02:20:54", "text": "1月。"}]
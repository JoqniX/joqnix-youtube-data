[{"type": "subtitle", "time": 8822.309, "timestamp": "02:27:02", "text": "もし私がこれを現在の"}, {"type": "subtitle", "time": 8825.51, "timestamp": "02:27:05", "text": "文脈的にはYouTubeのようになるだろう"}, {"type": "subtitle", "time": 8827.59, "timestamp": "02:27:07", "text": "YouTube、うん、そういう感じ"}, {"type": "subtitle", "time": 8828.429, "timestamp": "02:27:08", "text": "それは"}, {"type": "subtitle", "time": 8831.59, "timestamp": "02:27:11", "text": "痛み、あ、待って、君たち試験があるんだよね"}, {"type": "subtitle", "time": 8834.27, "timestamp": "02:27:14", "text": "わあ、頑張って"}, {"type": "subtitle", "time": 8837.03, "timestamp": "02:27:17", "text": "おそらく私がやらなければならない試験は"}, {"type": "subtitle", "time": 8840.63, "timestamp": "02:27:20", "text": "課題 アール 私はおそらくそうは思わない"}, {"type": "subtitle", "time": 8843.67, "timestamp": "02:27:23", "text": "残念ながら、私はそれらをストリーミングできます。"}, {"type": "subtitle", "time": 8844.99, "timestamp": "02:27:24", "text": "1日"}, {"type": "subtitle", "time": 8847.83, "timestamp": "02:27:27", "text": "それ。でも、私には無理だと思う"}, {"type": "subtitle", "time": 8850.59, "timestamp": "02:27:30", "text": "ストリーミングするのは良いことです"}, {"type": "subtitle", "time": 8853.95, "timestamp": "02:27:33", "text": "丸24時間"}, {"type": "subtitle", "time": 8858.99, "timestamp": "02:27:38", "text": "長い 12 時間 全体"}, {"type": "subtitle", "time": 8862.349, "timestamp": "02:27:42", "text": "1週間"}, {"type": "subtitle", "time": 8865.429, "timestamp": "02:27:45", "text": "昔のようにノックして、今は"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "それはあまりにも退屈で苦痛すぎるだろう。"}, {"type": "subtitle", "time": 8869.389, "timestamp": "02:27:49", "text": "それで、"}, {"type": "subtitle", "time": 8874.23, "timestamp": "02:27:54", "text": "私はやり方を変える必要がある"}, {"type": "subtitle", "time": 8878.51, "timestamp": "02:27:58", "text": "昔はこうやってたんだよ、ほら、俺が好きなように"}]
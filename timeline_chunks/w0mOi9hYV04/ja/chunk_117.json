[{"type": "subtitle", "time": 7022.47, "timestamp": "01:57:02", "text": "私の、えっと、なんて言うんだっけ？胸。"}, {"type": "subtitle", "time": 7025.109, "timestamp": "01:57:05", "text": "いや、あの人がどうやって言うか知ってるでしょ"}, {"type": "subtitle", "time": 7028.629, "timestamp": "01:57:08", "text": "えっと、リサのヘアスタイルはどのアニメのヘアスタイルですか"}, {"type": "subtitle", "time": 7030.95, "timestamp": "01:57:10", "text": "呪われた髪型か、"}, {"type": "subtitle", "time": 7032.95, "timestamp": "01:57:12", "text": "何かあるよね？リサみたいな感じ"}, {"type": "subtitle", "time": 7035.99, "timestamp": "01:57:15", "text": "いつかそれをやってみたい。 1つ"}, {"type": "subtitle", "time": 7038.79, "timestamp": "01:57:18", "text": "ある日思いついたアイデアの一つ"}, {"type": "subtitle", "time": 7042.189, "timestamp": "01:57:22", "text": "ジョックのもう一つの進化として"}, {"type": "subtitle", "time": 7045.91, "timestamp": "01:57:25", "text": "星座。ああ、あれはこんな感じだった"}, {"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "私が考えていたコンセプトアートでは"}, {"type": "subtitle", "time": 7053.99, "timestamp": "01:57:33", "text": "私のデザインは、ずっと以前から考えていたものです。だから私はこう思った"}, {"type": "subtitle", "time": 7056.149, "timestamp": "01:57:36", "text": "うん、もしかしたらあのコンセプトアートを使えるかもしれないね。"}, {"type": "subtitle", "time": 7060.51, "timestamp": "01:57:40", "text": "ない？"}, {"type": "subtitle", "time": 7063.75, "timestamp": "01:57:43", "text": "えっと、私は長い髪を1年くらいしか保ってなかったんです"}, {"type": "subtitle", "time": 7066.03, "timestamp": "01:57:46", "text": "年。うん。自分、"}, {"type": "subtitle", "time": 7068.55, "timestamp": "01:57:48", "text": "あまりにも。うん。うん。うん。うん。うん。私"}, {"type": "subtitle", "time": 7069.99, "timestamp": "01:57:49", "text": "髪を伸ばしたい。私は現在"}, {"type": "subtitle", "time": 7072.229, "timestamp": "01:57:52", "text": "髪を短く伸ばそうとしている"}, {"type": "subtitle", "time": 7075.27, "timestamp": "01:57:55", "text": "髪。現状では、文字通り"}, {"type": "subtitle", "time": 7077.79, "timestamp": "01:57:57", "text": "今のところちょっと"}]
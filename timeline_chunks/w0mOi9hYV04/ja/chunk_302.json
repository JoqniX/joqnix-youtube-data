[{"type": "subtitle", "time": 18120.708, "timestamp": "05:02:00", "text": "起こったことは、"}, {"type": "subtitle", "time": 18124.31, "timestamp": "05:02:04", "text": "いつも来てくれる視聴者さんたち、"}, {"type": "subtitle", "time": 18127.31, "timestamp": "05:02:07", "text": "彼らは感じた"}, {"type": "subtitle", "time": 18132.948, "timestamp": "05:02:12", "text": "ちょっと変だけど、彼女は私の"}, {"type": "chat", "time": 18135.902, "timestamp": "05:02:15", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I can understand "}, {"type": "subtitle", "time": 18135.99, "timestamp": "05:02:15", "text": "ストリーマー、私のユーチューバーは、えーと"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "新しい人々の流入があったので変化しました"}, {"type": "subtitle", "time": 18143.35, "timestamp": "05:02:23", "text": "などなど。そして、ええ、彼女は、ええと、"}, {"type": "subtitle", "time": 18144.59, "timestamp": "05:02:24", "text": "これに対処する"}, {"type": "subtitle", "time": 18147.19, "timestamp": "05:02:27", "text": "きちんと。彼女は実際にこれについて言及した"}, {"type": "subtitle", "time": 18148.75, "timestamp": "05:02:28", "text": "適切に"}, {"type": "subtitle", "time": 18151.35, "timestamp": "05:02:31", "text": "新しい人がいても"}, {"type": "chat", "time": 18153.022, "timestamp": "05:02:33", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "It must feel bad to em "}, {"type": "subtitle", "time": 18154.55, "timestamp": "05:02:34", "text": "依然として同じであり、その他もろもろ。彼女はこう述べた。"}, {"type": "subtitle", "time": 18156.948, "timestamp": "05:02:36", "text": "これを適切に伝え、"}, {"type": "subtitle", "time": 18160.75, "timestamp": "05:02:40", "text": "そうすれば、初日からすべての視聴者が"}, {"type": "subtitle", "time": 18163.83, "timestamp": "05:02:43", "text": "1つと、新しい視聴者は"}, {"type": "subtitle", "time": 18167.59, "timestamp": "05:02:47", "text": "現在、彼女を見に来た人は"}, {"type": "subtitle", "time": 18169.99, "timestamp": "05:02:49", "text": "彼女の個性と新しいモデルのために"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "そして、彼らは見るのが好きなので、すべて"}, {"type": "subtitle", "time": 18174.628, "timestamp": "05:02:54", "text": "彼女など。彼らは皆耳を傾け、"}, {"type": "subtitle", "time": 18177.83, "timestamp": "05:02:57", "text": "それでも彼女が戻ってきても"}, {"type": "subtitle", "time": 18178.75, "timestamp": "05:02:58", "text": "えーと"}]
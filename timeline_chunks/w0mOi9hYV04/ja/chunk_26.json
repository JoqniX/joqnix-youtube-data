[{"type": "subtitle", "time": 1560.95, "timestamp": "00:26:00", "text": "その日はストリーミング配信をします。"}, {"type": "subtitle", "time": 1563.11, "timestamp": "00:26:03", "text": "誕生日おめでとうの歌を贈ります。今"}, {"type": "subtitle", "time": 1566.35, "timestamp": "00:26:06", "text": "今日はジョックの誕生日だよ、"}, {"type": "subtitle", "time": 1570.75, "timestamp": "00:26:10", "text": "忘れる？私の誕生日を忘れたの？"}, {"type": "subtitle", "time": 1575.31, "timestamp": "00:26:15", "text": "コーラ。はい、私の誕生日は8月です。"}, {"type": "subtitle", "time": 1578.31, "timestamp": "00:26:18", "text": "11日、私の誕生日を知らないなら、"}, {"type": "subtitle", "time": 1580.789, "timestamp": "00:26:20", "text": "今後の配信はいつでも確認できます"}, {"type": "subtitle", "time": 1583.909, "timestamp": "00:26:23", "text": "スケジュールと無料チャット"}, {"type": "subtitle", "time": 1587.59, "timestamp": "00:26:27", "text": "そちら側。それは常に"}, {"type": "subtitle", "time": 1590.95, "timestamp": "00:26:30", "text": "1年前の同じ日に予定されている"}, {"type": "subtitle", "time": 1594.47, "timestamp": "00:26:34", "text": "私の誕生日はです。そう、もし"}, {"type": "subtitle", "time": 1597.59, "timestamp": "00:26:37", "text": "誰でも忘れるものだ。私はそんなこと全くしていません"}, {"type": "subtitle", "time": 1599.59, "timestamp": "00:26:39", "text": "ただ人々が"}, {"type": "subtitle", "time": 1607.029, "timestamp": "00:26:47", "text": "何もない。楽しかったのは確かだ。楽しいです"}, {"type": "subtitle", "time": 1609.11, "timestamp": "00:26:49", "text": "あなたをからかうため。待って、あれはあなただったの？"}, {"type": "subtitle", "time": 1611.549, "timestamp": "00:26:51", "text": "私をからかっている。待って、"}, {"type": "subtitle", "time": 1614.85, "timestamp": "00:26:54", "text": "何？何てことだ。"}, {"type": "subtitle", "time": 1616.99, "timestamp": "00:26:56", "text": "[音楽]"}, {"type": "subtitle", "time": 1619.71, "timestamp": "00:26:59", "text": "おお。"}]
[{"type": "subtitle", "time": 16328.59, "timestamp": "04:32:08", "text": "いいよ"}, {"type": "chat", "time": 16330.041, "timestamp": "04:32:10", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "*pat pat* mitsuki"}, {"type": "subtitle", "time": 16332.55, "timestamp": "04:32:12", "text": "夜。はい、戻ってきました。ええと、もし私が"}, {"type": "subtitle", "time": 16334.71, "timestamp": "04:32:14", "text": "もし若い頃の自分に会ったら、"}, {"type": "subtitle", "time": 16336.269, "timestamp": "04:32:16", "text": "質問"}, {"type": "subtitle", "time": 16339.11, "timestamp": "04:32:19", "text": "マーク。私は、"}, {"type": "subtitle", "time": 16342.229, "timestamp": "04:32:22", "text": "私の仲間が実際にはどこにいるのか"}, {"type": "subtitle", "time": 16344.07, "timestamp": "04:32:24", "text": "ない。そして今、私は裏切られた、不当な扱いを受けたと感じている。"}, {"type": "subtitle", "time": 16346.429, "timestamp": "04:32:26", "text": "私はとても腹が立っています。私はとても"}, {"type": "subtitle", "time": 16348.83, "timestamp": "04:32:28", "text": "悲しい。"}, {"type": "chat", "time": 16351.649, "timestamp": "04:32:31", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "And they were all making fun of me and laughed on me and now i feel so dumb "}, {"type": "subtitle", "time": 16356.469, "timestamp": "04:32:36", "text": "はぁ？何か大きな災難を起こした"}, {"type": "subtitle", "time": 16363.63, "timestamp": "04:32:43", "text": "みんな私をからかっている。"}, {"type": "subtitle", "time": 16367.79, "timestamp": "04:32:47", "text": "あ、すみません。ごめん。ごめんなさい。私"}, {"type": "subtitle", "time": 16372.429, "timestamp": "04:32:52", "text": "ジェニーだった。その画像は"}, {"type": "subtitle", "time": 16377.149, "timestamp": "04:32:57", "text": "私ってすごく可愛い。笑ってしまってすみません。"}]
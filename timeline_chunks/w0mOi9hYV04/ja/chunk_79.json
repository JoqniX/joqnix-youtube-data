[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "正直。私はこういうゲームが大好きですが"}, {"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "ただ、私はそうしなければならない、私はそうしなければならない"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "実際にプレイしてみてください。そこが問題なんです。"}, {"type": "subtitle", "time": 4751.07, "timestamp": "01:19:11", "text": "ああ、昨日発売されたよ。"}, {"type": "subtitle", "time": 4753.83, "timestamp": "01:19:13", "text": "何？このゲームは昨日発売されました。おお"}, {"type": "subtitle", "time": 4755.07, "timestamp": "01:19:15", "text": "我が神よ。"}, {"type": "subtitle", "time": 4763.63, "timestamp": "01:19:23", "text": "覆われている？"}, {"type": "subtitle", "time": 4767.35, "timestamp": "01:19:27", "text": "1,300。わかった。そして最後に登場したのはシュラウデッドだった"}, {"type": "subtitle", "time": 4776.07, "timestamp": "01:19:36", "text": "最近は良いFPSゲームをプレイしたいのですが、"}, {"type": "subtitle", "time": 4777.39, "timestamp": "01:19:37", "text": "見つかりません"}, {"type": "subtitle", "time": 4781.91, "timestamp": "01:19:41", "text": "1つ。ああ、ただプレイしたり見たりすればいいよ"}, {"type": "subtitle", "time": 4784.87, "timestamp": "01:19:44", "text": "無料のFPSゲームみたいな感じ"}, {"type": "subtitle", "time": 4786.709, "timestamp": "01:19:46", "text": "無料で遊べるゲーム。いくつかあります"}, {"type": "subtitle", "time": 4789.91, "timestamp": "01:19:49", "text": "良いもの、またはただ買うことができます"}, {"type": "subtitle", "time": 4793.229, "timestamp": "01:19:53", "text": "新しいもの。有料版を買うとか、何か別の方法を考えてください。私"}]
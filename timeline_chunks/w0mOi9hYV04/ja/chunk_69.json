[{"type": "subtitle", "time": 4148.11, "timestamp": "01:09:08", "text": "理由？待って、"}, {"type": "subtitle", "time": 4152.11, "timestamp": "01:09:12", "text": "理由？ああ、ただ訪れただけなんです。"}, {"type": "subtitle", "time": 4155.43, "timestamp": "01:09:15", "text": "ママママウム"}, {"type": "subtitle", "time": 4164.269, "timestamp": "01:09:24", "text": "私は欲しい"}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "欲しいものや好きなもの、泣くのが好きなもの"}, {"type": "subtitle", "time": 4171.189, "timestamp": "01:09:31", "text": "もの。まるで家に帰るような気分だ。"}, {"type": "subtitle", "time": 4174.789, "timestamp": "01:09:34", "text": "そして私は次に母を訪ねて"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "次は祖母、次はパパ、といった感じ"}, {"type": "subtitle", "time": 4194.39, "timestamp": "01:09:54", "text": "本当に。ええ、まさにその通りです。うん、まあそんな感じ"}, {"type": "subtitle", "time": 4196.709, "timestamp": "01:09:56", "text": "似ているけど、こんな感じ。私は自分の"}]
[{"type": "subtitle", "time": 12360.229, "timestamp": "03:26:00", "text": "ゲーマーが今どんな感じか知ってるでしょ、彼らは"}, {"type": "subtitle", "time": 12362.71, "timestamp": "03:26:02", "text": "彼らは首を曲げる必要がない"}, {"type": "subtitle", "time": 12364.95, "timestamp": "03:26:04", "text": "そして、すべての脊椎円錐は"}, {"type": "subtitle", "time": 12367.67, "timestamp": "03:26:07", "text": "悪いよね、それについてのビデオを見たから"}, {"type": "subtitle", "time": 12370.389, "timestamp": "03:26:10", "text": "埋め合わせをするべきかと思った"}, {"type": "subtitle", "time": 12372.63, "timestamp": "03:26:12", "text": "それ"}, {"type": "subtitle", "time": 12382.19, "timestamp": "03:26:22", "text": "[音楽]"}, {"type": "subtitle", "time": 12396.49, "timestamp": "03:26:36", "text": "モニターの前には"}]
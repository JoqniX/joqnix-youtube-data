[{"type": "subtitle", "time": 13088.63, "timestamp": "03:38:08", "text": "手。えっと、下へ。上、下、上、下、上、"}, {"type": "subtitle", "time": 13094.99, "timestamp": "03:38:14", "text": "左。"}, {"type": "subtitle", "time": 13098.469, "timestamp": "03:38:18", "text": "わかった。下、上、左。わかった。待って。それで、"}, {"type": "subtitle", "time": 13105.63, "timestamp": "03:38:25", "text": "モニターを起動してください。左。私は違います"}, {"type": "subtitle", "time": 13109.389, "timestamp": "03:38:29", "text": "左。右。モニター。チェック。"}, {"type": "subtitle", "time": 13114.229, "timestamp": "03:38:34", "text": "真っ直ぐ。自分の顔を見てごらん。カメラ。 L."}, {"type": "subtitle", "time": 13116.15, "timestamp": "03:38:36", "text": "よし、これでいいと思うんだけど、どうかな？は"}]
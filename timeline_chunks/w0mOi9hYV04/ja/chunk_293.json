[{"type": "subtitle", "time": 17580.47, "timestamp": "04:53:00", "text": "「どうしたの？」とか色々話したり、えーっと"}, {"type": "chat", "time": 17583.043, "timestamp": "04:53:03", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Sheng its kind of you to say that, thankyou. Im trying my best "}, {"type": "subtitle", "time": 17583.27, "timestamp": "04:53:03", "text": "みんなフレンドリーに話すように、"}, {"type": "subtitle", "time": 17586.39, "timestamp": "04:53:06", "text": "まるで私が配信者と近すぎるかのように、"}, {"type": "subtitle", "time": 17588.868, "timestamp": "04:53:08", "text": "右？もし私がランダムな視聴者としてそれを行ったら"}, {"type": "subtitle", "time": 17592.03, "timestamp": "04:53:12", "text": "そしてチャットでは誰も"}, {"type": "subtitle", "time": 17594.708, "timestamp": "04:53:14", "text": "「この人誰？この変な人誰？」"}, {"type": "subtitle", "time": 17597.35, "timestamp": "04:53:17", "text": "男？これらすべては何を語っているのでしょうか？そして"}, {"type": "subtitle", "time": 17599.03, "timestamp": "04:53:19", "text": "もちろん、ストリーマーはあなたの友達になります"}, {"type": "subtitle", "time": 17600.948, "timestamp": "04:53:20", "text": "ストリーマーに話しかけると無視されます"}, {"type": "subtitle", "time": 17604.67, "timestamp": "04:53:24", "text": "コメントすると、"}, {"type": "subtitle", "time": 17607.11, "timestamp": "04:53:27", "text": "なぜそれが起こるのかコメントコミュニティ"}, {"type": "subtitle", "time": 17608.948, "timestamp": "04:53:28", "text": "感情の爆発は、あなたが与えているように起こります"}, {"type": "subtitle", "time": 17612.55, "timestamp": "04:53:32", "text": "誰かの権利を擁護するから、あなたが"}, {"type": "subtitle", "time": 17615.708, "timestamp": "04:53:35", "text": "一定数に達すると"}, {"type": "subtitle", "time": 17618.47, "timestamp": "04:53:38", "text": "ほとんどのストリーマーがしない傾向にあること"}, {"type": "subtitle", "time": 17620.868, "timestamp": "04:53:40", "text": "主義に過度に優遇する"}, {"type": "subtitle", "time": 17623.51, "timestamp": "04:53:43", "text": "彼らの視聴者は、私たちがチューブスペースだからです"}, {"type": "subtitle", "time": 17626.55, "timestamp": "04:53:46", "text": "準社会主義は大きな問題ですよね。"}, {"type": "subtitle", "time": 17628.948, "timestamp": "04:53:48", "text": "うん、大変だろうね。つまり"}, {"type": "subtitle", "time": 17632.23, "timestamp": "04:53:52", "text": "私が時間をかけて学んだことの一つ。そして"}, {"type": "subtitle", "time": 17635.19, "timestamp": "04:53:55", "text": "例えば私の"}, {"type": "subtitle", "time": 17637.91, "timestamp": "04:53:57", "text": "ケースでは、私が彼らと連絡を取りたい場合"}]
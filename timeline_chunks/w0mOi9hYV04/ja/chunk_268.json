[{"type": "subtitle", "time": 16081.03, "timestamp": "04:28:01", "text": "Discordでの会話、"}, {"type": "subtitle", "time": 16082.03, "timestamp": "04:28:02", "text": "コラボレーション"}, {"type": "subtitle", "time": 16086.63, "timestamp": "04:28:06", "text": "あれ。えっと、それで、考えなきゃいけないんだけど"}, {"type": "subtitle", "time": 16089.189, "timestamp": "04:28:09", "text": "つまり韓国時間は日本の時間と等しいということです"}, {"type": "subtitle", "time": 16091.189, "timestamp": "04:28:11", "text": "時間。それで"}, {"type": "subtitle", "time": 16092.75, "timestamp": "04:28:12", "text": "えーと"}, {"type": "subtitle", "time": 16106.189, "timestamp": "04:28:26", "text": "GSTの8:30はKSTでは午後5時になります。それで5"}, {"type": "subtitle", "time": 16107.71, "timestamp": "04:28:27", "text": "6."}, {"type": "subtitle", "time": 16111.189, "timestamp": "04:28:31", "text": "えっと、もしそれが労働者なら、"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "疲れて8時半に帰宅。もしそれが私だったら、"}, {"type": "subtitle", "time": 16118.63, "timestamp": "04:28:38", "text": "私は1時間休んでリラックスします"}, {"type": "subtitle", "time": 16119.78, "timestamp": "04:28:39", "text": "そして全て。そして"}, {"type": "subtitle", "time": 16120.99, "timestamp": "04:28:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16123.99, "timestamp": "04:28:43", "text": "そうすれば夕食を食べられるし"}, {"type": "subtitle", "time": 16125.95, "timestamp": "04:28:45", "text": "すべて、ですよね？"}, {"type": "subtitle", "time": 16129.51, "timestamp": "04:28:49", "text": "そして私は"}, {"type": "subtitle", "time": 16131.75, "timestamp": "04:28:51", "text": "ええと、電話をいただければ、"}, {"type": "subtitle", "time": 16135.75, "timestamp": "04:28:55", "text": "リラックスした感じですよね？でも、それは私なんです。でも待って。"}]
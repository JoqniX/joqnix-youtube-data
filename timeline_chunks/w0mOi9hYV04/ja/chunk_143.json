[{"type": "subtitle", "time": 8580.79, "timestamp": "02:23:00", "text": "それはつまり、もう寝る時間だということ。私は飲む"}, {"type": "subtitle", "time": 8583.71, "timestamp": "02:23:03", "text": "水。ああ、それが翻訳の意味だ"}, {"type": "subtitle", "time": 8587.0, "timestamp": "02:23:07", "text": "だった。ああ、"}, {"type": "subtitle", "time": 8590.67, "timestamp": "02:23:10", "text": "[音楽]"}, {"type": "subtitle", "time": 8593.15, "timestamp": "02:23:13", "text": "神。ええ、そうですね。"}, {"type": "subtitle", "time": 8596.07, "timestamp": "02:23:16", "text": "えっと、アッサをどうしたらいいか迷ってるんだけど"}, {"type": "subtitle", "time": 8599.03, "timestamp": "02:23:19", "text": "ディオが配信する。アサドはストリーミング配信していると思いますか？"}, {"type": "subtitle", "time": 8601.75, "timestamp": "02:23:21", "text": "良いですか？全員追いつけるだろうか"}, {"type": "subtitle", "time": 8603.51, "timestamp": "02:23:23", "text": "それらのストリームで？君はそもそも"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "それを見ていますか？ぜひ教えてください。楽しいですか？"}, {"type": "subtitle", "time": 8609.83, "timestamp": "02:23:29", "text": "Asa Dioのストリームを聴くには、"}, {"type": "subtitle", "time": 8611.83, "timestamp": "02:23:31", "text": "私は好きであるべきでしょうか"}, {"type": "subtitle", "time": 8613.83, "timestamp": "02:23:33", "text": "えっと、地下室に送り返すか、"}, {"type": "subtitle", "time": 8616.59, "timestamp": "02:23:36", "text": "またダンジョンか？"}, {"type": "subtitle", "time": 8619.19, "timestamp": "02:23:39", "text": "えっと、それを返送する必要があるのでしょうか？"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "またダンジョンか？私はそれを鍵をかけて保管しています"}, {"type": "subtitle", "time": 8625.27, "timestamp": "02:23:45", "text": "そして、私はまだ"}, {"type": "subtitle", "time": 8627.91, "timestamp": "02:23:47", "text": "寝ている間は実際には"}, {"type": "subtitle", "time": 8629.95, "timestamp": "02:23:49", "text": "行う"}, {"type": "subtitle", "time": 8634.07, "timestamp": "02:23:54", "text": "まるで。でも、そうなんです、"}, {"type": "subtitle", "time": 8637.349, "timestamp": "02:23:57", "text": "私が手に入れようとしているのは、えっと、"}]
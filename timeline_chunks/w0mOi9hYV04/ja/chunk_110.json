[{"type": "subtitle", "time": 6614.47, "timestamp": "01:50:14", "text": "ああ、大変だ。待って、クロノスは参加してるの？待って、"}, {"type": "subtitle", "time": 6617.229, "timestamp": "01:50:17", "text": "何？ああ、こんにちは、クロノス。ようこそ"}, {"type": "subtitle", "time": 6619.669, "timestamp": "01:50:19", "text": "ストリーム。お元気でお過ごしでしょうか。そしてその理由は？"}, {"type": "subtitle", "time": 6622.99, "timestamp": "01:50:22", "text": "私のモデルは動かなくなってしまったのでしょうか？私は嫌いです"}, {"type": "subtitle", "time": 6637.43, "timestamp": "01:50:37", "text": "もっと。コロヌスは私に意地悪だった。だから彼らは"}, {"type": "subtitle", "time": 6640.31, "timestamp": "01:50:40", "text": "ただ口論するだけ。あなたたち二人に何があったの？"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "皆さんお元気でお過ごしでしょうか。うん、私だよ"}, {"type": "subtitle", "time": 6645.109, "timestamp": "01:50:45", "text": "ええと、みんな元気ですよ。私は思う"}, {"type": "subtitle", "time": 6647.03, "timestamp": "01:50:47", "text": "皆さんが元気でいることを願っています。"}, {"type": "subtitle", "time": 6647.95, "timestamp": "01:50:47", "text": "によって"}, {"type": "subtitle", "time": 6651.229, "timestamp": "01:50:51", "text": "まあ、私は元気ですよ。私の"}, {"type": "subtitle", "time": 6654.629, "timestamp": "01:50:54", "text": "夕食。私はここで良いことをしています。私は"}, {"type": "subtitle", "time": 6659.149, "timestamp": "01:50:59", "text": "文字通りビタミンCを摂取しています"}]
[{"type": "subtitle", "time": 6781.589, "timestamp": "01:53:01", "text": "尋ねた。ええ、水だと思います。"}, {"type": "subtitle", "time": 6785.669, "timestamp": "01:53:05", "text": "でもビタミンCの錠剤を入れたら"}, {"type": "subtitle", "time": 6788.589, "timestamp": "01:53:08", "text": "えっと、そしてシュワシュワ"}, {"type": "subtitle", "time": 6791.87, "timestamp": "01:53:11", "text": "起きて、ただ飲むだけです。飲んでください。それは"}, {"type": "subtitle", "time": 6795.35, "timestamp": "01:53:15", "text": "それ。まさにタンみたいな味ですよね？もし"}, {"type": "subtitle", "time": 6798.629, "timestamp": "01:53:18", "text": "あのタンタンっていうやつ、えっと、"}, {"type": "subtitle", "time": 6801.51, "timestamp": "01:53:21", "text": "私たちはゲストをゲストのように扱います"}, {"type": "subtitle", "time": 6804.709, "timestamp": "01:53:24", "text": "などなど、そうですよね？文字通り私が飲むもの"}, {"type": "subtitle", "time": 6807.35, "timestamp": "01:53:27", "text": "まるでタンを飲んでいるかのようだ"}, {"type": "subtitle", "time": 6810.36, "timestamp": "01:53:30", "text": "何か。"}, {"type": "subtitle", "time": 6818.39, "timestamp": "01:53:38", "text": "[音楽]"}, {"type": "subtitle", "time": 6823.79, "timestamp": "01:53:43", "text": "持ってくる。"}, {"type": "subtitle", "time": 6825.99, "timestamp": "01:53:45", "text": "えっと、電話をすればいいのに"}, {"type": "subtitle", "time": 6828.629, "timestamp": "01:53:48", "text": "それが消え去る間、彼に待ってください。いいえ。"}, {"type": "subtitle", "time": 6830.99, "timestamp": "01:53:50", "text": "はぁ？いいえ。私は待てと思いました。"}, {"type": "subtitle", "time": 6833.07, "timestamp": "01:53:53", "text": "はぁ？"}]
[{"type": "subtitle", "time": 10682.71, "timestamp": "02:58:02", "text": "それ。だから、上に行く必要はないんです。待って、私は"}, {"type": "subtitle", "time": 10685.79, "timestamp": "02:58:05", "text": "行くべきだと思う"}, {"type": "subtitle", "time": 10695.03, "timestamp": "02:58:15", "text": "推測する。午後5時30分ヘリクサン川。手に入れた"}, {"type": "subtitle", "time": 10698.55, "timestamp": "02:58:18", "text": "それ。ガッチャ。ズキさん、ありがとう"}, {"type": "subtitle", "time": 10702.389, "timestamp": "02:58:22", "text": "時間。あれは大きな跳躍だった。大丈夫。"}, {"type": "subtitle", "time": 10705.67, "timestamp": "02:58:25", "text": "私たちならできる。なんてこった。私たちにはできなかった。"}, {"type": "subtitle", "time": 10707.309, "timestamp": "02:58:27", "text": "その"}, {"type": "subtitle", "time": 10709.79, "timestamp": "02:58:29", "text": "大丈夫。完全に"}, {"type": "subtitle", "time": 10712.429, "timestamp": "02:58:32", "text": "大丈夫。ブームブーム"}, {"type": "subtitle", "time": 10720.389, "timestamp": "02:58:40", "text": "できなかった。それは、"}, {"type": "subtitle", "time": 10724.19, "timestamp": "02:58:44", "text": "画面全体。ええ、気づいてますよ"}, {"type": "subtitle", "time": 10727.07, "timestamp": "02:58:47", "text": "それ。それで、"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "えっと、私は、えっと、持っていないんです"}, {"type": "subtitle", "time": 10735.429, "timestamp": "02:58:55", "text": "OBS のメディア ソースを追加し続けました。"}, {"type": "subtitle", "time": 10739.269, "timestamp": "02:58:59", "text": "それらはすべてウェブサイトのようなものなので、"}]
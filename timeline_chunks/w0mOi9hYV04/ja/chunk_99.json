[{"type": "subtitle", "time": 5941.51, "timestamp": "01:39:01", "text": "きちんと。ああ、それは"}, {"type": "subtitle", "time": 5945.27, "timestamp": "01:39:05", "text": "電話追跡。えっと、私はVT Vを使っています"}, {"type": "subtitle", "time": 5949.59, "timestamp": "01:39:09", "text": "スタジオモバイルアプリ。いいえ。それで、口は"}, {"type": "subtitle", "time": 5952.87, "timestamp": "01:39:12", "text": "これは常に存在する問題です。私が開けない限り"}, {"type": "subtitle", "time": 5955.47, "timestamp": "01:39:15", "text": "口は"}, {"type": "subtitle", "time": 5959.99, "timestamp": "01:39:19", "text": "ああ、そうするとモデル上で開くようになります。いつ"}, {"type": "subtitle", "time": 5962.39, "timestamp": "01:39:22", "text": "私が話していることは追跡できません。残念ながら、"}, {"type": "subtitle", "time": 5966.229, "timestamp": "01:39:26", "text": "それにはiPhoneとVブリッジが必要です"}, {"type": "subtitle", "time": 5969.27, "timestamp": "01:39:29", "text": "通常の唇で話す場合、"}, {"type": "subtitle", "time": 5973.109, "timestamp": "01:39:33", "text": "唇の動きのことですよね？ああ、そうだね。"}, {"type": "subtitle", "time": 5975.91, "timestamp": "01:39:35", "text": "残念ながら。そして、今のところ私はこれを持っています"}, {"type": "subtitle", "time": 5979.03, "timestamp": "01:39:39", "text": "トラッキングがランダムに停止する問題"}, {"type": "subtitle", "time": 5981.99, "timestamp": "01:39:41", "text": "そして、まるで1秒ほどフリーズしたかのように"}, {"type": "subtitle", "time": 5985.109, "timestamp": "01:39:45", "text": "そして追いつく。そう、こんな感じ。した"}, {"type": "subtitle", "time": 5987.03, "timestamp": "01:39:47", "text": "あれ、見える？それは凍りついた"}, {"type": "subtitle", "time": 5989.629, "timestamp": "01:39:49", "text": "2番。"}]
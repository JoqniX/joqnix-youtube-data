[{"type": "subtitle", "time": 14227.51, "timestamp": "03:57:07", "text": "[音楽]"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "あれらは最高だよ、相棒。えっと、つまり、私は"}, {"type": "subtitle", "time": 14234.59, "timestamp": "03:57:14", "text": "知る。私は好きです 私は好きです"}, {"type": "subtitle", "time": 14238.67, "timestamp": "03:57:18", "text": "気にしない"}, {"type": "subtitle", "time": 14241.95, "timestamp": "03:57:21", "text": "実は。実際に食べるのは構わない"}, {"type": "subtitle", "time": 14245.189, "timestamp": "03:57:25", "text": "チョコレートをたくさん食べる。たとえそれがチョコレートであっても、"}]
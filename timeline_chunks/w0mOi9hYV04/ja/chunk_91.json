[{"type": "subtitle", "time": 5460.07, "timestamp": "01:31:00", "text": "翻訳者は？待って、君たちは"}, {"type": "subtitle", "time": 5464.07, "timestamp": "01:31:04", "text": "私の英語の翻訳がどれだけ下手か見てください"}, {"type": "subtitle", "time": 5467.11, "timestamp": "01:31:07", "text": "えーと、翻訳機は私がストリーミングしているときに"}, {"type": "subtitle", "time": 5471.03, "timestamp": "01:31:11", "text": "ビリー、ビリー？これを見てください。わかった、私は"}, {"type": "subtitle", "time": 5474.47, "timestamp": "01:31:14", "text": "後で開けます。右。"}, {"type": "subtitle", "time": 5483.83, "timestamp": "01:31:23", "text": "わかった。私はただ、これを見て身震いしたいだけです"}, {"type": "subtitle", "time": 5487.189, "timestamp": "01:31:27", "text": "時々。いいえ、それは機能しません。"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "私の声を捉えてください。そして、これもある"}, {"type": "subtitle", "time": 5494.229, "timestamp": "01:31:34", "text": "プレイしてみたいゲーム。えーっと、"}, {"type": "subtitle", "time": 5497.35, "timestamp": "01:31:37", "text": "これはぜひ試してみたいゲームです。えっと、それは"}, {"type": "subtitle", "time": 5499.189, "timestamp": "01:31:39", "text": "呼ばれる"}, {"type": "subtitle", "time": 5507.03, "timestamp": "01:31:47", "text": "ああ、[ __ ]。えっと、なんていう名前だったっけ？"}, {"type": "subtitle", "time": 5508.75, "timestamp": "01:31:48", "text": "あれって何ていう名前だったっけ？"}, {"type": "subtitle", "time": 5510.35, "timestamp": "01:31:50", "text": "えっと"}, {"type": "subtitle", "time": 5513.83, "timestamp": "01:31:53", "text": "待って。ああ、媚びへつらえよ。媚びへつらえ。それは それは"}, {"type": "subtitle", "time": 5515.99, "timestamp": "01:31:55", "text": "ゲーム。実際、楽しいゲームだよ。それ"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "実際にあなたの声を使用します。それは認識する"}]
[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "これがおそらく私が受け取る最後の配信になるでしょう"}, {"type": "subtitle", "time": 9962.269, "timestamp": "02:46:02", "text": "監視する"}, {"type": "subtitle", "time": 9965.55, "timestamp": "02:46:05", "text": "その間。願わくば"}, {"type": "subtitle", "time": 9983.19, "timestamp": "02:46:23", "text": "ジャンプ。ジャンプ。それを飛び越えろ。ジャンプする"}, {"type": "subtitle", "time": 9986.269, "timestamp": "02:46:26", "text": "そこには。そこを飛び越えろ。行く"}, {"type": "subtitle", "time": 9991.91, "timestamp": "02:46:31", "text": "上。ジャンプ。ああ。失敗。わかった。あなたは飛び上がる。"}, {"type": "subtitle", "time": 9995.99, "timestamp": "02:46:35", "text": "ジャンプ。遅い。ジャンプ。長さ。短い。ジャンプ。"}, {"type": "subtitle", "time": 9999.71, "timestamp": "02:46:39", "text": "失敗。わかった。飛び上がって。遅い"}, {"type": "subtitle", "time": 10004.309, "timestamp": "02:46:44", "text": "ジャンプ。ジャンプ。うん。ああ。私は作り続けています"}, {"type": "subtitle", "time": 10006.429, "timestamp": "02:46:46", "text": "作る"}, {"type": "subtitle", "time": 10013.269, "timestamp": "02:46:53", "text": "下。もし私が耐久レースをしたらどうなるだろうか"}, {"type": "subtitle", "time": 10014.19, "timestamp": "02:46:54", "text": "月"}, {"type": "subtitle", "time": 10016.83, "timestamp": "02:46:56", "text": "今日？私は"}]
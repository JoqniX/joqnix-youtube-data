[{"type": "subtitle", "time": 1740.19, "timestamp": "00:29:00", "text": "うん。"}, {"type": "subtitle", "time": 1742.59, "timestamp": "00:29:02", "text": "いらっしゃいませ。ようこそ"}, {"type": "subtitle", "time": 1746.11, "timestamp": "00:29:06", "text": "ストリーム。ああ、モリーだ。別の"}, {"type": "subtitle", "time": 1754.789, "timestamp": "00:29:14", "text": "タマ。うん。皆さん、お誕生日おめでとうございます。"}, {"type": "subtitle", "time": 1757.669, "timestamp": "00:29:17", "text": "なぜだめですか？うん。お誕生日おめでとう"}, {"type": "subtitle", "time": 1759.07, "timestamp": "00:29:19", "text": "みんな。"}, {"type": "subtitle", "time": 1762.11, "timestamp": "00:29:22", "text": "はい、姉妹たちです。おお、"}, {"type": "subtitle", "time": 1765.07, "timestamp": "00:29:25", "text": "こんにちは。ご来場ありがとうございました"}, {"type": "subtitle", "time": 1771.269, "timestamp": "00:29:31", "text": "あなた。どれほどひどいか見てみたい"}, {"type": "subtitle", "time": 1774.23, "timestamp": "00:29:34", "text": "翻訳者は？待って。君たちは"}, {"type": "subtitle", "time": 1778.75, "timestamp": "00:29:38", "text": "私の英語がどれだけ下手か見てください"}, {"type": "subtitle", "time": 1781.19, "timestamp": "00:29:41", "text": "翻訳者は？でも私はストリーミング配信しています"}, {"type": "subtitle", "time": 1785.19, "timestamp": "00:29:45", "text": "ビリー、ビリー。これを見てください。わかった。私は私は"}, {"type": "subtitle", "time": 1787.549, "timestamp": "00:29:47", "text": "後で開けます。"}, {"type": "subtitle", "time": 1797.909, "timestamp": "00:29:57", "text": "わかった、私はただこれを見て身震いしたいだけ"}]
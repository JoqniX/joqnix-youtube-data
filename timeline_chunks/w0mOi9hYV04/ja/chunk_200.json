[{"type": "subtitle", "time": 12006.95, "timestamp": "03:20:06", "text": "錠剤。私が自分の持ち物に対してやったことは"}, {"type": "subtitle", "time": 12022.229, "timestamp": "03:20:22", "text": "なぜ？このパソコンは私を嫌っている。"}, {"type": "subtitle", "time": 12034.51, "timestamp": "03:20:34", "text": "接続する。ああ、"}, {"type": "subtitle", "time": 12038.389, "timestamp": "03:20:38", "text": "神。なぜ"}, {"type": "subtitle", "time": 12041.59, "timestamp": "03:20:41", "text": "今日はついてない日なの？これは"}, {"type": "subtitle", "time": 12042.51, "timestamp": "03:20:42", "text": "悪い"}, {"type": "subtitle", "time": 12045.67, "timestamp": "03:20:45", "text": "前兆？おお。ああ、うまくいってる。おお。ああ、"}, {"type": "subtitle", "time": 12048.309, "timestamp": "03:20:48", "text": "神。何てことだ。実際、うまくいっている。"}, {"type": "subtitle", "time": 12051.51, "timestamp": "03:20:51", "text": "何てことだ。あ、待って、待って、待って、待って。おお"}, {"type": "subtitle", "time": 12052.79, "timestamp": "03:20:52", "text": "待って、待って、待って、待って、待って。どのように"}, {"type": "subtitle", "time": 12055.83, "timestamp": "03:20:55", "text": "消去しますか？新規ファイルを消去する方法（保存しない）。"}, {"type": "subtitle", "time": 12057.389, "timestamp": "03:20:57", "text": "わかった。ああ、"}]
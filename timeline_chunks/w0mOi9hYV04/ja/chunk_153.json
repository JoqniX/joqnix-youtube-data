[{"type": "subtitle", "time": 9202.03, "timestamp": "02:33:22", "text": "うん。"}, {"type": "subtitle", "time": 9204.51, "timestamp": "02:33:24", "text": "こんにちは。行きました"}, {"type": "subtitle", "time": 9207.349, "timestamp": "02:33:27", "text": "それ。うん。こんにちは、みんな。調子はどうですか？"}, {"type": "subtitle", "time": 9208.349, "timestamp": "02:33:28", "text": "みんな"}, {"type": "subtitle", "time": 9212.429, "timestamp": "02:33:32", "text": "何をしているの？良い一日をお過ごしになられたことを願っています"}, {"type": "subtitle", "time": 9216.63, "timestamp": "02:33:36", "text": "夕方、そして良い朝を過ごしました"}, {"type": "subtitle", "time": 9219.99, "timestamp": "02:33:39", "text": "良い時間を過ごせた人は"}, {"type": "subtitle", "time": 9221.87, "timestamp": "02:33:41", "text": "それ。"}, {"type": "subtitle", "time": 9226.23, "timestamp": "02:33:46", "text": "ああ、皆さんお元気ですか？調子はどうですか"}, {"type": "subtitle", "time": 9228.95, "timestamp": "02:33:48", "text": "今のあなたですか？気分はいいけど、うーん、"}, {"type": "subtitle", "time": 9232.51, "timestamp": "02:33:52", "text": "少し肌寒い。おそらく"}, {"type": "subtitle", "time": 9234.67, "timestamp": "02:33:54", "text": "天気ですが"}, {"type": "subtitle", "time": 9237.63, "timestamp": "02:33:57", "text": "えっと、誰？"}]
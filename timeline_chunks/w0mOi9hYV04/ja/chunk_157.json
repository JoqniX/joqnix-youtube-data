[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "26 5。忘れた。以前はクラッシュしていた"}, {"type": "subtitle", "time": 9424.99, "timestamp": "02:37:04", "text": "ストリーム。毎回、1つのストリームで、1つのストリームで"}, {"type": "subtitle", "time": 9427.83, "timestamp": "02:37:07", "text": "それはTwitchで配信されていた。私は思う"}, {"type": "subtitle", "time": 9430.71, "timestamp": "02:37:10", "text": "流れは止まっていました。私は覚えている"}, {"type": "subtitle", "time": 9433.27, "timestamp": "02:37:13", "text": "新しいものを作る準備"}, {"type": "subtitle", "time": 9435.19, "timestamp": "02:37:15", "text": "新しい準備のためにアップデートしてください"}, {"type": "subtitle", "time": 9438.75, "timestamp": "02:37:18", "text": "アップデートとか色々。ええ、覚えていますよ。"}, {"type": "subtitle", "time": 9450.99, "timestamp": "02:37:30", "text": "ああ、そうそうそう"}, {"type": "subtitle", "time": 9455.19, "timestamp": "02:37:35", "text": "えーっと、最近知らない人のために"}, {"type": "subtitle", "time": 9461.469, "timestamp": "02:37:41", "text": "初めてワクチン接種を受けました"}, {"type": "subtitle", "time": 9466.83, "timestamp": "02:37:46", "text": "最初のワクチン接種を受けたので"}, {"type": "subtitle", "time": 9470.309, "timestamp": "02:37:50", "text": "えっと、昨日撮ったと思う"}, {"type": "subtitle", "time": 9472.23, "timestamp": "02:37:52", "text": "待って、昨日だったかな、私は"}, {"type": "subtitle", "time": 9475.349, "timestamp": "02:37:55", "text": "金曜日がいつだったか忘れてしまうことがある。うん、"}, {"type": "subtitle", "time": 9478.469, "timestamp": "02:37:58", "text": "昨日。待って、ちょっと待って。それは"}]
[{"type": "subtitle", "time": 3420.39, "timestamp": "00:57:00", "text": "うん。えっと、兄弟は逆のことを言ってるよ"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "ムーラン。逆ムーランって何？私は欲しい"}, {"type": "subtitle", "time": 3425.87, "timestamp": "00:57:05", "text": "女の子"}, {"type": "subtitle", "time": 3429.03, "timestamp": "00:57:09", "text": "モデル。ああ、なんとも不釣り合いだ。どれ？待って、"}, {"type": "subtitle", "time": 3430.95, "timestamp": "00:57:10", "text": "あなたは女の子ですか？女の子と付き合うの？"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "モデル？ふざけるな。ジョッキーが行く"}, {"type": "subtitle", "time": 3435.99, "timestamp": "00:57:15", "text": "大丈夫だ。"}, {"type": "subtitle", "time": 3439.109, "timestamp": "00:57:19", "text": "ジョッキーの個人的なジョックジョッキーを想像します"}, {"type": "subtitle", "time": 3444.349, "timestamp": "00:57:24", "text": "個人的にはパッチパックパックとして"}, {"type": "subtitle", "time": 3449.47, "timestamp": "00:57:29", "text": "離れて攻撃する それは何ですか"}, {"type": "subtitle", "time": 3452.789, "timestamp": "00:57:32", "text": "ああ、もし私がなぜ"}, {"type": "subtitle", "time": 3455.27, "timestamp": "00:57:35", "text": "好きで行くってことは、つまり"}, {"type": "subtitle", "time": 3458.309, "timestamp": "00:57:38", "text": "今は私の声です"}, {"type": "subtitle", "time": 3461.829, "timestamp": "00:57:41", "text": "えーと、私の声は、えーと、ちょっと"}, {"type": "subtitle", "time": 3464.71, "timestamp": "00:57:44", "text": "視聴者によっては混乱を招くかもしれない"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "まるで彼らが"}, {"type": "subtitle", "time": 3468.069, "timestamp": "00:57:48", "text": "私が女の子だと思っている。時々彼らは"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "まるで自分が男の子みたいに感じる。わからない"}, {"type": "subtitle", "time": 3474.15, "timestamp": "00:57:54", "text": "なぜ。だから私はアンドロジニーだと思ったのです"}, {"type": "subtitle", "time": 3478.63, "timestamp": "00:57:58", "text": "モデルは私の声とジョックに合うだろう"}]
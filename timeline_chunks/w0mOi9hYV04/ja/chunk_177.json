[{"type": "subtitle", "time": 10626.51, "timestamp": "02:57:06", "text": "これ。手に入れる"}, {"type": "subtitle", "time": 10630.269, "timestamp": "02:57:10", "text": "それ。そして、みんなが手に入れる"}, {"type": "subtitle", "time": 10637.349, "timestamp": "02:57:17", "text": "うん。まだ試していません。どのようにどのように"}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "永続？それは永続的なものではありません。絶対に"}, {"type": "subtitle", "time": 10654.23, "timestamp": "02:57:34", "text": "私からの永久的なヘッドパッド。見てください"}, {"type": "subtitle", "time": 10665.83, "timestamp": "02:57:45", "text": "1つ。あ、待って。これは"}, {"type": "subtitle", "time": 10668.75, "timestamp": "02:57:48", "text": "ここ？待って、待って。私は"}, {"type": "subtitle", "time": 10672.87, "timestamp": "02:57:52", "text": "後ろに。我慢する。ちょっと待って。いつ"}, {"type": "subtitle", "time": 10676.63, "timestamp": "02:57:56", "text": "これはどのようにして生まれたのですか？こんにちは。"}, {"type": "subtitle", "time": 10678.75, "timestamp": "02:57:58", "text": "待って、あなたは"}]
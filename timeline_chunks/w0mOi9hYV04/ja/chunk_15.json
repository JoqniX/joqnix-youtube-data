[{"type": "subtitle", "time": 905.069, "timestamp": "00:15:05", "text": "あなたはそれを何と呼びますか？私はむしろこう思う"}, {"type": "subtitle", "time": 909.189, "timestamp": "00:15:09", "text": "えーっと、それはもっとこうだと思うんだけど、ほら"}, {"type": "subtitle", "time": 910.67, "timestamp": "00:15:10", "text": "えーと"}, {"type": "subtitle", "time": 913.31, "timestamp": "00:15:13", "text": "不確実性"}, {"type": "subtitle", "time": 916.55, "timestamp": "00:15:16", "text": "もの。何かがやって来るの？いいえ、それは"}, {"type": "subtitle", "time": 919.11, "timestamp": "00:15:19", "text": "また、私が少し欠けている点"}, {"type": "subtitle", "time": 921.67, "timestamp": "00:15:21", "text": "それ。うん。こんにちは、クレイジーさん、ようこそ。ようこそ"}, {"type": "subtitle", "time": 924.069, "timestamp": "00:15:24", "text": "小川。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 930.189, "timestamp": "00:15:30", "text": "ええ、不透明さ"}, {"type": "subtitle", "time": 933.829, "timestamp": "00:15:33", "text": "もの。物事の不透明さ、ほら、だって"}, {"type": "subtitle", "time": 937.03, "timestamp": "00:15:37", "text": "その時はやらなきゃいけないことが山ほどあるんだ。"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "今では管理するのが難しい"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "配信も私がやらなければならないことの一つです。"}, {"type": "subtitle", "time": 943.389, "timestamp": "00:15:43", "text": "そして"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "うん、管理するのは難しいけど、"}, {"type": "subtitle", "time": 948.47, "timestamp": "00:15:48", "text": "それが何であるか。でも、大丈夫だよ。良い"}, {"type": "subtitle", "time": 951.11, "timestamp": "00:15:51", "text": "ゆっくりゆっくり"}, {"type": "subtitle", "time": 954.069, "timestamp": "00:15:54", "text": "えっと、何とかして動かしてください。うん。作る"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "うん。うん。私は復活させたい"}, {"type": "subtitle", "time": 958.23, "timestamp": "00:15:58", "text": "スケジュールを組む。うん。そして、"}]
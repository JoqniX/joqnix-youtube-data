[{"type": "subtitle", "time": 17281.47, "timestamp": "04:48:01", "text": "[音楽]"}, {"type": "subtitle", "time": 17286.91, "timestamp": "04:48:06", "text": "入るよ。入るよ。うん、そんな感じ。"}, {"type": "subtitle", "time": 17290.07, "timestamp": "04:48:10", "text": "また、あなたは、あなたは、私はあなたのように感じるべきだ"}, {"type": "subtitle", "time": 17292.788, "timestamp": "04:48:12", "text": "休憩を取るべきだが、一度"}, {"type": "subtitle", "time": 17295.35, "timestamp": "04:48:15", "text": "休憩から戻ってきて"}, {"type": "subtitle", "time": 17296.35, "timestamp": "04:48:16", "text": "これ"}, {"type": "subtitle", "time": 17299.07, "timestamp": "04:48:19", "text": "適切に対処"}, {"type": "subtitle", "time": 17301.868, "timestamp": "04:48:21", "text": "ストリームの場合は、適切に"}, {"type": "subtitle", "time": 17305.75, "timestamp": "04:48:25", "text": "ストリーム。楽しませたり、"}, {"type": "subtitle", "time": 17309.75, "timestamp": "04:48:29", "text": "えーっと、何時間も配信する 1時間か"}, {"type": "subtitle", "time": 17312.47, "timestamp": "04:48:32", "text": "それで。それでは、始めてみましょう"}, {"type": "subtitle", "time": 17315.27, "timestamp": "04:48:35", "text": "あなたが私に言及して話したいアドレス"}, {"type": "subtitle", "time": 17318.39, "timestamp": "04:48:38", "text": "これは適切です。わかった。"}, {"type": "subtitle", "time": 17320.628, "timestamp": "04:48:40", "text": "真剣に受け止めましょう"}, {"type": "subtitle", "time": 17323.83, "timestamp": "04:48:43", "text": "夢とか何かで、えっと"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "もしあなたが、"}, {"type": "subtitle", "time": 17328.948, "timestamp": "04:48:48", "text": "がっかりしているのね、そしてあなたは"}, {"type": "subtitle", "time": 17330.51, "timestamp": "04:48:50", "text": "あなたの"}, {"type": "subtitle", "time": 17333.19, "timestamp": "04:48:53", "text": "失望して他の人が"}, {"type": "subtitle", "time": 17335.55, "timestamp": "04:48:55", "text": "理解してください"}, {"type": "subtitle", "time": 17339.27, "timestamp": "04:48:59", "text": "そう、彼らはそう思うべきだ、彼らは申し訳なく思うべきだ"}]
[{"type": "subtitle", "time": 5401.59, "timestamp": "01:30:01", "text": "今日は誕生日の人の誕生日です。ハッピー"}, {"type": "subtitle", "time": 5405.99, "timestamp": "01:30:05", "text": "彼らに誕生日おめでとう。そして、ニューヨークB、ようこそ"}, {"type": "subtitle", "time": 5408.75, "timestamp": "01:30:08", "text": "小川へ。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 5411.75, "timestamp": "01:30:11", "text": "こんにちは。ここに来るのは初めてですか？私"}, {"type": "subtitle", "time": 5415.31, "timestamp": "01:30:15", "text": "この名前は今まで見たことがない。"}, {"type": "subtitle", "time": 5418.07, "timestamp": "01:30:18", "text": "ああ、信じますよ。初めてなんですね。"}, {"type": "subtitle", "time": 5418.91, "timestamp": "01:30:18", "text": "うん。"}, {"type": "subtitle", "time": 5422.11, "timestamp": "01:30:22", "text": "ようこそ、ようこそ、"}, {"type": "subtitle", "time": 5424.149, "timestamp": "01:30:24", "text": "いらっしゃいませ。ええ、初めてですよね。"}, {"type": "subtitle", "time": 5426.03, "timestamp": "01:30:26", "text": "うん、"}, {"type": "subtitle", "time": 5428.43, "timestamp": "01:30:28", "text": "いらっしゃいませ。ようこそ"}, {"type": "subtitle", "time": 5431.95, "timestamp": "01:30:31", "text": "ストリーム。ああ、モリーだ。別の"}, {"type": "subtitle", "time": 5440.629, "timestamp": "01:30:40", "text": "モリー。うん。皆さん、お誕生日おめでとうございます。"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "なぜだめですか？うん。お誕生日おめでとう"}, {"type": "subtitle", "time": 5444.99, "timestamp": "01:30:44", "text": "みんな。"}, {"type": "subtitle", "time": 5449.669, "timestamp": "01:30:49", "text": "はい、姉妹たちです。あ、こんにちは。ありがとうございます"}, {"type": "subtitle", "time": 5450.91, "timestamp": "01:30:50", "text": "来る"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "あなた。どれほどひどいか見てみたい"}]
[{"type": "subtitle", "time": 9603.91, "timestamp": "02:40:03", "text": "車両、えっと、こんなことが今起こった"}, {"type": "subtitle", "time": 9607.429, "timestamp": "02:40:07", "text": "そして私の部屋全体が"}, {"type": "subtitle", "time": 9610.63, "timestamp": "02:40:10", "text": "ガス。私はまるで窒息しそうだった"}, {"type": "subtitle", "time": 9613.99, "timestamp": "02:40:13", "text": "多く。ああ、痛い。そんな日が来る"}, {"type": "subtitle", "time": 9615.95, "timestamp": "02:40:15", "text": "日々は"}, {"type": "subtitle", "time": 9620.71, "timestamp": "02:40:20", "text": "さあ、もう話は終わりだ。では、"}, {"type": "subtitle", "time": 9632.79, "timestamp": "02:40:32", "text": "ゲーム。推奨設定、ウィンドウ"}, {"type": "subtitle", "time": 9636.389, "timestamp": "02:40:36", "text": "キャプチャとOBS。便利なボーダーレス"}, {"type": "subtitle", "time": 9638.11, "timestamp": "02:40:38", "text": "ゲーム。"}, {"type": "subtitle", "time": 9647.75, "timestamp": "02:40:47", "text": "わかった。待って、枠線なしってどうやって使うの？"}, {"type": "subtitle", "time": 9649.309, "timestamp": "02:40:49", "text": "わかった、"}, {"type": "subtitle", "time": 9653.349, "timestamp": "02:40:53", "text": "国境のない。しかし、これだけはやってみてください。どうやら、"}, {"type": "subtitle", "time": 9655.23, "timestamp": "02:40:55", "text": "使用できません"}, {"type": "subtitle", "time": 9659.309, "timestamp": "02:40:59", "text": "えっと、風、ジャンプのゲームキャプチャ"}]
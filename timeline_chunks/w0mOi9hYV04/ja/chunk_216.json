[{"type": "subtitle", "time": 12962.99, "timestamp": "03:36:02", "text": "よし、じゃあ下げて"}, {"type": "subtitle", "time": 12966.269, "timestamp": "03:36:06", "text": "上。よし、今私は"}, {"type": "subtitle", "time": 12974.51, "timestamp": "03:36:14", "text": "はい、私の携帯電話が追跡を行います。"}, {"type": "subtitle", "time": 12977.389, "timestamp": "03:36:17", "text": "わかった。だから、私はこうしている"}, {"type": "subtitle", "time": 12981.87, "timestamp": "03:36:21", "text": "これ。それで、追跡"}, {"type": "subtitle", "time": 12985.99, "timestamp": "03:36:25", "text": "左、右、左、右を確認してください。おお、"}, {"type": "subtitle", "time": 12989.07, "timestamp": "03:36:29", "text": "待って。カメラを使用しています。"}, {"type": "subtitle", "time": 13001.67, "timestamp": "03:36:41", "text": "えっと、待って。実際、大丈夫です。待って。左"}, {"type": "subtitle", "time": 13005.349, "timestamp": "03:36:45", "text": "モニター、中央モニター、右モニター、"}, {"type": "subtitle", "time": 13007.07, "timestamp": "03:36:47", "text": "左、右、"}, {"type": "subtitle", "time": 13012.469, "timestamp": "03:36:52", "text": "左。ああ、これは悪くない。の"}, {"type": "subtitle", "time": 13016.19, "timestamp": "03:36:56", "text": "私を邪魔しているのはただ一つ"}, {"type": "subtitle", "time": 13018.95, "timestamp": "03:36:58", "text": "えっと、あなたの見た目を見たいのですが"}]
[{"type": "subtitle", "time": 9540.429, "timestamp": "02:39:00", "text": "人工呼吸器を少し作動させる必要がある"}, {"type": "subtitle", "time": 9543.469, "timestamp": "02:39:03", "text": "素早い。だから、えーと、"}, {"type": "subtitle", "time": 9547.75, "timestamp": "02:39:07", "text": "週末には、車があります"}, {"type": "subtitle", "time": 9550.389, "timestamp": "02:39:10", "text": "私の家のように通り過ぎるものは"}, {"type": "subtitle", "time": 9554.71, "timestamp": "02:39:14", "text": "道路脇の近く。それで、車両が通過します"}, {"type": "subtitle", "time": 9558.07, "timestamp": "02:39:18", "text": "毒素を多く含んでいる"}, {"type": "subtitle", "time": 9560.389, "timestamp": "02:39:20", "text": "それは蚊が死ぬためであり、"}, {"type": "subtitle", "time": 9564.429, "timestamp": "02:39:24", "text": "すべて。大きな霧の煙だ"}, {"type": "subtitle", "time": 9567.469, "timestamp": "02:39:27", "text": "あれだよ、わかるだろ。"}, {"type": "subtitle", "time": 9570.71, "timestamp": "02:39:30", "text": "ああ、換気扇をつけた方がいいな"}, {"type": "subtitle", "time": 9574.03, "timestamp": "02:39:34", "text": "あれ。息ができない。その"}, {"type": "subtitle", "time": 9577.71, "timestamp": "02:39:37", "text": "痛み。それに、私の家の窓も閉まっています。"}, {"type": "subtitle", "time": 9586.87, "timestamp": "02:39:46", "text": "上。いつかこれが"}, {"type": "subtitle", "time": 9589.67, "timestamp": "02:39:49", "text": "起こった、私は換気をしていた、あの"}, {"type": "subtitle", "time": 9593.03, "timestamp": "02:39:53", "text": "換気装置、ファンが回っている"}, {"type": "subtitle", "time": 9595.67, "timestamp": "02:39:55", "text": "内部。だから私は外を内側に取り込む"}, {"type": "subtitle", "time": 9599.91, "timestamp": "02:39:59", "text": "部屋と、どうやらその日、この"}]
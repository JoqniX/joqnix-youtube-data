[{"type": "subtitle", "time": 15872.71, "timestamp": "04:24:32", "text": "では、どうすればいいのでしょうか。ちょっと待ってください。つまり、午後10時であれば。"}, {"type": "subtitle", "time": 15877.469, "timestamp": "04:24:37", "text": "インドでは午後6時30分、午後10時です。 GSTは等しい"}, {"type": "subtitle", "time": 15883.59, "timestamp": "04:24:43", "text": "午後6時までいや、午後10時じゃないよ。に等しい"}, {"type": "subtitle", "time": 15886.59, "timestamp": "04:24:46", "text": "午後6時30分私にとって。それで"}, {"type": "subtitle", "time": 15891.149, "timestamp": "04:24:51", "text": "6:30 6:30から7:30までは、"}]
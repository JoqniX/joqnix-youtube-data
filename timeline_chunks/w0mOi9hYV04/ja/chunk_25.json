[{"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "わかった。待って。何？待って。はぁ？それはあなたの"}, {"type": "subtitle", "time": 1508.269, "timestamp": "00:25:08", "text": "誕生日。お誕生日おめでとう。待って。はぁ？"}, {"type": "subtitle", "time": 1510.59, "timestamp": "00:25:10", "text": "本当に？待って。今日はあなたの誕生日です。待って。"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "本当に？ジョーク。冗談です。ああ、そうじゃない"}, {"type": "subtitle", "time": 1516.23, "timestamp": "00:25:16", "text": "あなたの誕生日。わかった。私は興奮した"}, {"type": "subtitle", "time": 1520.35, "timestamp": "00:25:20", "text": "ほんの一瞬だけ。ああ、それがあなたのものかどうか教えてください"}, {"type": "subtitle", "time": 1523.59, "timestamp": "00:25:23", "text": "誕生日。歌ってあげるよ 歌ってあげるよ"}, {"type": "subtitle", "time": 1543.669, "timestamp": "00:25:43", "text": "誕生日。えっと、今日は私の誕生月なんです。"}, {"type": "subtitle", "time": 1546.63, "timestamp": "00:25:46", "text": "私の誕生日は7月です。ああ、わかりました。する"}, {"type": "subtitle", "time": 1549.029, "timestamp": "00:25:49", "text": "誰かの誕生日がいつなのか教えてください。"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "近々何かあるか何か。わかった。私が試してみます"}, {"type": "subtitle", "time": 1554.23, "timestamp": "00:25:54", "text": "覚えておくか、私の"}, {"type": "subtitle", "time": 1557.669, "timestamp": "00:25:57", "text": "カレンダーにメモして、自分に思い出させる。それからもし私が"}]
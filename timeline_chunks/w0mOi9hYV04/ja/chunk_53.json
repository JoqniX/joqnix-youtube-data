[{"type": "subtitle", "time": 3181.349, "timestamp": "00:53:01", "text": "大丈夫。うん。うん。えっと、ジョックネックは"}, {"type": "subtitle", "time": 3183.829, "timestamp": "00:53:03", "text": "性別を持つ。どちらかというと両性具有に近いですね。"}, {"type": "subtitle", "time": 3187.19, "timestamp": "00:53:07", "text": "まあ、言えるかな。ええと、いずれ私は"}, {"type": "subtitle", "time": 3190.15, "timestamp": "00:53:10", "text": "髪が長くなるので"}, {"type": "subtitle", "time": 3191.91, "timestamp": "00:53:11", "text": "未来の私は女の子のように見えるだろう。私"}, {"type": "subtitle", "time": 3193.51, "timestamp": "00:53:13", "text": "たぶん私は何かを明かしただけだと思う"}, {"type": "subtitle", "time": 3195.51, "timestamp": "00:53:15", "text": "持つべきではない、持つべきではない、でもそうだ、"}, {"type": "subtitle", "time": 3200.71, "timestamp": "00:53:20", "text": "大丈夫です。ええ、でもそれは、ええと"}, {"type": "subtitle", "time": 3203.109, "timestamp": "00:53:23", "text": "あなたの想像力。どのようにしたいですか"}, {"type": "subtitle", "time": 3206.549, "timestamp": "00:53:26", "text": "将来の騎手？えっと、それでも受け入れてくれますか？"}, {"type": "subtitle", "time": 3215.589, "timestamp": "00:53:35", "text": "マーク。つまり、考えてみて"}, {"type": "subtitle", "time": 3217.99, "timestamp": "00:53:37", "text": "このような。わかった。だから、これらを見れば"}, {"type": "subtitle", "time": 3220.95, "timestamp": "00:53:40", "text": "アニメとかそういうの、もしもしもし"}, {"type": "subtitle", "time": 3223.51, "timestamp": "00:53:43", "text": "あなたは長い髪のようですね、もしあなたが"}, {"type": "subtitle", "time": 3226.069, "timestamp": "00:53:46", "text": "ショートヘアにすれば、周りに溶け込んで馴染むことができます"}, {"type": "subtitle", "time": 3229.75, "timestamp": "00:53:49", "text": "溶け込んで男性になり、そして"}, {"type": "subtitle", "time": 3233.349, "timestamp": "00:53:53", "text": "活動したり、働いたり、仕事に就いたりする"}, {"type": "subtitle", "time": 3235.91, "timestamp": "00:53:55", "text": "あるいは軍隊に入って戦い、"}, {"type": "subtitle", "time": 3239.589, "timestamp": "00:53:59", "text": "大きな筋肉質の男との剣の戦い"}]
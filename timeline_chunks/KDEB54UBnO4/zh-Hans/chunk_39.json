[{"type": "subtitle", "time": 2345.19, "timestamp": "00:39:05", "text": "这是我新买的自行车。 轮胎"}, {"type": "subtitle", "time": 2347.829, "timestamp": "00:39:07", "text": "好像更厚了。"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "好的，我会把它模糊处理。 我看看能不能"}, {"type": "subtitle", "time": 2362.71, "timestamp": "00:39:22", "text": "把你加进来。"}, {"type": "subtitle", "time": 2365.99, "timestamp": "00:39:25", "text": "如果可行，那我们真是太"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "幸运了。"}, {"type": "subtitle", "time": 2397.19, "timestamp": "00:39:57", "text": "如果我这么说，他们肯定会吓得魂飞魄散。"}]
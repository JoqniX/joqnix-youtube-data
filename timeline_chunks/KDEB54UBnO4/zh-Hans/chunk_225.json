[{"type": "subtitle", "time": 13501.03, "timestamp": "03:45:01", "text": "我现在还不能连接外部摄像头"}, {"type": "subtitle", "time": 13504.87, "timestamp": "03:45:04", "text": "。 我需要合适的硬件，比如"}, {"type": "subtitle", "time": 13508.229, "timestamp": "03:45:08", "text": "摄像头本身。 另外，我还"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "需要找到一台至少配备 4GB 内存的树莓派或 Orange Pi"}, {"type": "subtitle", "time": 13515.91, "timestamp": "03:45:15", "text": "。"}, {"type": "subtitle", "time": 13517.99, "timestamp": "03:45:17", "text": "嗯，"}, {"type": "subtitle", "time": 13522.15, "timestamp": "03:45:22", "text": "所以我可以对"}, {"type": "subtitle", "time": 13526.07, "timestamp": "03:45:26", "text": "运动相机、单反相机或者"}, {"type": "subtitle", "time": 13529.11, "timestamp": "03:45:29", "text": "普通相机的视频信号进行编码，然后"}, {"type": "subtitle", "time": 13533.03, "timestamp": "03:45:33", "text": "通过 Manifold 之类的软件发送到我的手机，"}, {"type": "subtitle", "time": 13536.229, "timestamp": "03:45:36", "text": "再从我的手机上进行流式传输"}, {"type": "subtitle", "time": 13537.91, "timestamp": "03:45:37", "text": "。 我觉得我需要"}, {"type": "subtitle", "time": 13541.99, "timestamp": "03:45:41", "text": "第二部手机，这样我才能控制它"}, {"type": "subtitle", "time": 13543.67, "timestamp": "03:45:43", "text": "或者做其他事情。 我不知道。 我有"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "很多想法可以尝试，但"}, {"type": "subtitle", "time": 13550.229, "timestamp": "03:45:50", "text": "我没钱了。 我身无分文，什么也做不了"}, {"type": "subtitle", "time": 13552.95, "timestamp": "03:45:52", "text": "。 我只能用我"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "目前拥有的东西。 我大概会试着修好一些东西"}, {"type": "subtitle", "time": 13558.71, "timestamp": "03:45:58", "text": "。 但我"}]
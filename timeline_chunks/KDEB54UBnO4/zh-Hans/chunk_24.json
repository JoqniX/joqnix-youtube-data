[{"type": "subtitle", "time": 1440.63, "timestamp": "00:24:00", "text": "所以，你可以清楚地看到下面是谁"}, {"type": "subtitle", "time": 1445.43, "timestamp": "00:24:05", "text": "。 如果那边的人"}, {"type": "subtitle", "time": 1451.029, "timestamp": "00:24:11", "text": "看到我，"}, {"type": "subtitle", "time": 1453.11, "timestamp": "00:24:13", "text": "他们会说：“这个人是"}, {"type": "subtitle", "time": 1464.586, "timestamp": "00:24:24", "text": "我爸爸刚回家。 欢迎回来。"}, {"type": "subtitle", "time": 1473.83, "timestamp": "00:24:33", "text": "怎么样？"}, {"type": "subtitle", "time": 1476.23, "timestamp": "00:24:36", "text": "你今天过得怎么样？"}, {"type": "subtitle", "time": 1494.149, "timestamp": "00:24:54", "text": "是苹果汁。 我只有"}, {"type": "subtitle", "time": 1496.39, "timestamp": "00:24:56", "text": "一些音乐作品，正如你所看到的。 只有一"}]
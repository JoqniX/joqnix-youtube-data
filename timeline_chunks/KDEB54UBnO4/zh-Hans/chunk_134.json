[{"type": "subtitle", "time": 8046.95, "timestamp": "02:14:06", "text": "兄弟，如果我有钱，我就带"}, {"type": "subtitle", "time": 8050.31, "timestamp": "02:14:10", "text": "你们去拉面店，然后拍下"}, {"type": "subtitle", "time": 8058.87, "timestamp": "02:14:18", "text": "下次。 总会有下一次机会。"}, {"type": "subtitle", "time": 8060.79, "timestamp": "02:14:20", "text": "记住，"}, {"type": "subtitle", "time": 8062.39, "timestamp": "02:14:22", "text": "户外溪流就像一次"}, {"type": "subtitle", "time": 8064.39, "timestamp": "02:14:24", "text": "探险。 我的天啊。 差点就撞到那块"}, {"type": "subtitle", "time": 8067.189, "timestamp": "02:14:27", "text": "板子了。 户外溪流就像……"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "等等，我到大创了。 什么？"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "我刚到大创。 等等，我应该"}, {"type": "subtitle", "time": 8079.43, "timestamp": "02:14:39", "text": "去找个手机支架吗？"}, {"type": "subtitle", "time": 8082.47, "timestamp": "02:14:42", "text": "等等，我到大创了。"}, {"type": "subtitle", "time": 8085.91, "timestamp": "02:14:45", "text": "等等，"}, {"type": "subtitle", "time": 8088.149, "timestamp": "02:14:48", "text": "我怎么突然就到了大创？"}, {"type": "subtitle", "time": 8090.229, "timestamp": "02:14:50", "text": "等等，"}, {"type": "subtitle", "time": 8093.35, "timestamp": "02:14:53", "text": "等等。 我想"}]
[{"type": "subtitle", "time": 844.15, "timestamp": "00:14:04", "text": "嗯，这里就是这里，就是那个区域。"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "这里一个人也没有。"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "兄弟，我在桥底下。 我在"}, {"type": "subtitle", "time": 852.55, "timestamp": "00:14:12", "text": "桥下。"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "呃，"}, {"type": "subtitle", "time": 862.23, "timestamp": "00:14:22", "text": "我改了那个东西。 呃，你需要"}, {"type": "subtitle", "time": 864.79, "timestamp": "00:14:24", "text": "添加一个锁定滑块的功能。"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "这里到处都是石头之类的东西。 必须"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "小心。 现在这里一个人也没有"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "。"}, {"type": "subtitle", "time": 881.91, "timestamp": "00:14:41", "text": "呃，我希望不会打扰到"}, {"type": "subtitle", "time": 883.67, "timestamp": "00:14:43", "text": "别人，如果他们在这后面做些可疑的事情，"}, {"type": "subtitle", "time": 886.89, "timestamp": "00:14:46", "text": "因为到目前为止，"}, {"type": "subtitle", "time": 890.31, "timestamp": "00:14:50", "text": "这里人不多。"}, {"type": "subtitle", "time": 893.75, "timestamp": "00:14:53", "text": "我得在天黑之前离开这里，"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "因为"}]
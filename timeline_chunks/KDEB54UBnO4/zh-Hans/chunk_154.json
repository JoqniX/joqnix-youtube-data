[{"type": "subtitle", "time": 9243.19, "timestamp": "02:34:03", "text": "当我在"}, {"type": "subtitle", "time": 9246.55, "timestamp": "02:34:06", "text": "滑块或切换开关上添加相机拍摄时间时（滑块"}, {"type": "subtitle", "time": 9250.309, "timestamp": "02:34:10", "text": "切换开关目前还不完善），"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "当我添加相机滑块时"}, {"type": "subtitle", "time": 9257.91, "timestamp": "02:34:17", "text": "，能否也添加手动"}, {"type": "subtitle", "time": 9261.83, "timestamp": "02:34:21", "text": "控制功能？ 我知道您添加了"}, {"type": "subtitle", "time": 9264.55, "timestamp": "02:34:24", "text": "变焦和曝光，也添加了手动"}, {"type": "subtitle", "time": 9269.19, "timestamp": "02:34:29", "text": "对焦、白平衡，甚至如果"}, {"type": "subtitle", "time": 9272.87, "timestamp": "02:34:32", "text": "可以的话，自动"}, {"type": "subtitle", "time": 9276.469, "timestamp": "02:34:36", "text": "归零功能也应该改成自动，或者加"}, {"type": "subtitle", "time": 9279.51, "timestamp": "02:34:39", "text": "个小按钮之类的，"}, {"type": "subtitle", "time": 9281.99, "timestamp": "02:34:41", "text": "这样我仍然可以设置 0 到"}, {"type": "subtitle", "time": 9284.63, "timestamp": "02:34:44", "text": "100 的范围。"}, {"type": "subtitle", "time": 9286.79, "timestamp": "02:34:46", "text": "您能不能把"}, {"type": "subtitle", "time": 9293.11, "timestamp": "02:34:53", "text": "。 是的。"}, {"type": "subtitle", "time": 9299.91, "timestamp": "02:34:59", "text": "我的天啊。 谢天谢地我没被"}]
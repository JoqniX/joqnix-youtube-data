[{"type": "subtitle", "time": 1622.63, "timestamp": "00:27:02", "text": "然后我们就出发。 好，我"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "看看能不能带你们去"}, {"type": "subtitle", "time": 1628.39, "timestamp": "00:27:08", "text": "骑车。"}, {"type": "subtitle", "time": 1632.23, "timestamp": "00:27:12", "text": "如果可以的话，我们出去走走吧。"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "所以，暂时这样吧，只要我还能做到。"}, {"type": "subtitle", "time": 1639.11, "timestamp": "00:27:19", "text": "目前"}, {"type": "subtitle", "time": 1642.47, "timestamp": "00:27:22", "text": "节目的问题是我忘记带我的外置麦克风了"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "。 但是，"}, {"type": "subtitle", "time": 1650.39, "timestamp": "00:27:30", "text": "呃，我能和你们沟通的最好方式"}, {"type": "subtitle", "time": 1654.149, "timestamp": "00:27:34", "text": "是，你们管它叫什么来着？ 我可以放一个"}, {"type": "subtitle", "time": 1656.63, "timestamp": "00:27:36", "text": "场景，里面写着我正在骑"}, {"type": "subtitle", "time": 1660.789, "timestamp": "00:27:40", "text": "自行车。 我不太会说话。"}, {"type": "subtitle", "time": 1665.43, "timestamp": "00:27:45", "text": "然后，呃，等我月经周期结束了，"}, {"type": "subtitle", "time": 1667.99, "timestamp": "00:27:47", "text": "我可以带你们出去散散步什么的"}, {"type": "subtitle", "time": 1670.39, "timestamp": "00:27:50", "text": "，活动活动什么的"}, {"type": "subtitle", "time": 1674.07, "timestamp": "00:27:54", "text": "。 我大概可以做到"}, {"type": "subtitle", "time": 1676.63, "timestamp": "00:27:56", "text": "。"}]
[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "，风很大。"}, {"type": "subtitle", "time": 1025.27, "timestamp": "00:17:05", "text": "天哪，风好大。"}, {"type": "subtitle", "time": 1028.069, "timestamp": "00:17:08", "text": "看，那是蝙蝠吗？"}, {"type": "subtitle", "time": 1035.029, "timestamp": "00:17:15", "text": "他正在逐渐敞开心扉。"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "那是一只小蝙蝠。"}, {"type": "subtitle", "time": 1040.87, "timestamp": "00:17:20", "text": "他飞走了。"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "是的，这是我"}, {"type": "subtitle", "time": 1049.99, "timestamp": "00:17:29", "text": "我打算就坐在这块石头上，"}, {"type": "subtitle", "time": 1053.75, "timestamp": "00:17:33", "text": "我们在这里放松一下。 确保“"}, {"type": "subtitle", "time": 1058.07, "timestamp": "00:17:38", "text": "哦，糟糕”。 请确保我的"}, {"type": "subtitle", "time": 1060.31, "timestamp": "00:17:40", "text": "鞋子不要弄湿。"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "那是"}, {"type": "subtitle", "time": 1065.27, "timestamp": "00:17:45", "text": "乌鸦粪便吗？ 鸟粪。"}, {"type": "subtitle", "time": 1068.07, "timestamp": "00:17:48", "text": "这不是最近发生的。 节目。"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "这里有个烟头。 我会用它"}, {"type": "subtitle", "time": 1078.39, "timestamp": "00:17:58", "text": "来清洁它。 我的天哪。"}]
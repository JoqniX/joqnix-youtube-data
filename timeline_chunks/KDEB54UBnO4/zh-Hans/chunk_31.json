[{"type": "subtitle", "time": 1860.47, "timestamp": "00:31:00", "text": "好的。 呃，"}, {"type": "subtitle", "time": 1863.669, "timestamp": "00:31:03", "text": "罐子是空的。 我们再也不喝"}, {"type": "subtitle", "time": 1866.63, "timestamp": "00:31:06", "text": "魔爪能量饮料了。   天色"}, {"type": "subtitle", "time": 1869.59, "timestamp": "00:31:09", "text": "真的越来越晚了。 嗯，再过5"}, {"type": "subtitle", "time": 1871.59, "timestamp": "00:31:11", "text": "分钟我们就从这里出发。"}, {"type": "subtitle", "time": 1874.31, "timestamp": "00:31:14", "text": "好的。 我必须把垃圾带走。"}, {"type": "subtitle", "time": 1879.269, "timestamp": "00:31:19", "text": "不能破坏这个美丽的地方。 呃，所以"}, {"type": "subtitle", "time": 1881.99, "timestamp": "00:31:21", "text": "我得把它带走。"}, {"type": "subtitle", "time": 1884.549, "timestamp": "00:31:24", "text": "所以现在我们必须做一个"}, {"type": "subtitle", "time": 1888.71, "timestamp": "00:31:28", "text": "负责任的人。   是的"}, {"type": "subtitle", "time": 1891.35, "timestamp": "00:31:31", "text": "。 是的。"}, {"type": "chat", "time": 1898.088, "timestamp": "00:31:38", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "owo"}, {"type": "subtitle", "time": 1901.43, "timestamp": "00:31:41", "text": "那边有个自行车骑行区。"}, {"type": "subtitle", "time": 1908.149, "timestamp": "00:31:48", "text": "看来我暂时没法带你们去骑行区了。"}, {"type": "subtitle", "time": 1910.87, "timestamp": "00:31:50", "text": "嗯，或许我们可以去体育场"}, {"type": "subtitle", "time": 1914.31, "timestamp": "00:31:54", "text": "附近逛逛。 那边有个公园，"}, {"type": "subtitle", "time": 1918.95, "timestamp": "00:31:58", "text": "呃，瓦坎。 我不知道。   嗯，是的"}]
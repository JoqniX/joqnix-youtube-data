[{"type": "subtitle", "time": 3120.23, "timestamp": "00:52:00", "text": "我没生你的气。"}, {"type": "subtitle", "time": 3124.47, "timestamp": "00:52:04", "text": "呃，好的。 让我把这个人放回去。"}, {"type": "subtitle", "time": 3126.63, "timestamp": "00:52:06", "text": "我不是因为任何人而生你的气。 不用"}, {"type": "subtitle", "time": 3132.23, "timestamp": "00:52:12", "text": "担心。 我只希望我不会泄露自己的信息。"}, {"type": "subtitle", "time": 3139.43, "timestamp": "00:52:19", "text": "好的。   这……哦，"}, {"type": "subtitle", "time": 3155.349, "timestamp": "00:52:35", "text": "好的，米娜，我要再骑一次"}, {"type": "subtitle", "time": 3157.43, "timestamp": "00:52:37", "text": "自行车了。 所以，我将无法"}, {"type": "subtitle", "time": 3160.069, "timestamp": "00:52:40", "text": "再次充值评论功能。   是的"}, {"type": "subtitle", "time": 3163.03, "timestamp": "00:52:43", "text": "。"}, {"type": "subtitle", "time": 3165.829, "timestamp": "00:52:45", "text": "背靠背。 哦，等等。 它会像这样掉下来的"}, {"type": "subtitle", "time": 3169.19, "timestamp": "00:52:49", "text": "，伙计。"}, {"type": "subtitle", "time": 3174.95, "timestamp": "00:52:54", "text": "，我们要去的那个地方，就像是"}]
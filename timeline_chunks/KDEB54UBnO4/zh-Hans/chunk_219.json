[{"type": "subtitle", "time": 13143.59, "timestamp": "03:39:03", "text": "我没看到[嗤笑]"}, {"type": "subtitle", "time": 13158.469, "timestamp": "03:39:18", "text": "我以为我已经开始了"}, {"type": "subtitle", "time": 13170.71, "timestamp": "03:39:30", "text": "我不知道。 好的，让我们感谢"}, {"type": "subtitle", "time": 13172.79, "timestamp": "03:39:32", "text": "今天所有到场的朋友。 我们已经直播了"}, {"type": "subtitle", "time": 13175.11, "timestamp": "03:39:35", "text": "很久，我确定"}, {"type": "subtitle", "time": 13178.95, "timestamp": "03:39:38", "text": "不是1小时38"}, {"type": "subtitle", "time": 13180.95, "timestamp": "03:39:40", "text": "分钟。 远不止如此。 需要3"}, {"type": "subtitle", "time": 13184.55, "timestamp": "03:39:44", "text": "小时40分钟。"}, {"type": "subtitle", "time": 13193.11, "timestamp": "03:39:53", "text": "让我们看看 Mikasuki Yuran，谢谢你的"}, {"type": "subtitle", "time": 13195.91, "timestamp": "03:39:55", "text": "光临，祝"}, {"type": "subtitle", "time": 13198.95, "timestamp": "03:39:58", "text": "Dio Parallax 品牌重塑一切顺利，我迫不及待地想看到"}]
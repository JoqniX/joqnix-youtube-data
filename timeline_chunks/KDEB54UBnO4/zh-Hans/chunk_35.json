[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "好的。   我的"}, {"type": "subtitle", "time": 2103.75, "timestamp": "00:35:03", "text": "天哪。 这就是我为什么说我必须"}, {"type": "subtitle", "time": 2106.87, "timestamp": "00:35:06", "text": "尽快离开的原因，"}, {"type": "subtitle", "time": 2110.71, "timestamp": "00:35:10", "text": "即使只是短暂离开，因为"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "这里太黑了。"}, {"type": "subtitle", "time": 2116.55, "timestamp": "00:35:16", "text": "这里非常黑。"}, {"type": "subtitle", "time": 2127.67, "timestamp": "00:35:27", "text": "哦，是的。 但这让我感觉自己"}, {"type": "subtitle", "time": 2129.99, "timestamp": "00:35:29", "text": "仿佛真的在海边，因为"}, {"type": "subtitle", "time": 2134.23, "timestamp": "00:35:34", "text": "那里的沙子就是沙子，这很"}, {"type": "subtitle", "time": 2136.95, "timestamp": "00:35:36", "text": "罕见。 我必须爬到那个"}, {"type": "subtitle", "time": 2138.589, "timestamp": "00:35:38", "text": "地方的顶部。"}, {"type": "subtitle", "time": 2139.19, "timestamp": "00:35:39", "text": "[嗤笑]"}, {"type": "subtitle", "time": 2141.91, "timestamp": "00:35:41", "text": "我的天哪。 不，我不需要"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "爬楼梯。 是的，我必须确保"}, {"type": "subtitle", "time": 2147.75, "timestamp": "00:35:47", "text": "没人看到我，因为如果他们看到我，"}, {"type": "subtitle", "time": 2149.829, "timestamp": "00:35:49", "text": "他们就会开始（音乐）质疑"}, {"type": "subtitle", "time": 2153.03, "timestamp": "00:35:53", "text": "你为什么来这里？ 这是禁区。"}, {"type": "subtitle", "time": 2154.95, "timestamp": "00:35:54", "text": "这个那个。"}]
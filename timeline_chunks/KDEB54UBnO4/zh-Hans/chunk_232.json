[{"type": "subtitle", "time": 13923.189, "timestamp": "03:52:03", "text": "嗯，是的。   大家好"}, {"type": "subtitle", "time": 13927.189, "timestamp": "03:52:07", "text": "，祝大家一切顺利。 我会回"}, {"type": "subtitle", "time": 13932.63, "timestamp": "03:52:12", "text": "我的宿舍好好休息，"}, {"type": "subtitle", "time": 13936.309, "timestamp": "03:52:16", "text": "吃点好吃的，吃点东西，"}, {"type": "subtitle", "time": 13941.67, "timestamp": "03:52:21", "text": "嗯，我会做很多事情。 我"}, {"type": "subtitle", "time": 13944.07, "timestamp": "03:52:24", "text": "得做作业。 天哪，还有"}, {"type": "subtitle", "time": 13951.429, "timestamp": "03:52:31", "text": "[嗤笑] 所以，祝"}, {"type": "subtitle", "time": 13957.189, "timestamp": "03:52:37", "text": "另外，我的电脑在做什么？ 在我"}, {"type": "subtitle", "time": 13974.469, "timestamp": "03:52:54", "text": "我还在看阿斯明·戈尔德的节目。"}]
[{"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "我当时想，一些坏人可能会"}, {"type": "subtitle", "time": 784.71, "timestamp": "00:13:04", "text": "看到我。   我的"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "天哪。 所以我们要去这边这个区域"}, {"type": "subtitle", "time": 794.069, "timestamp": "00:13:14", "text": "我不想让别人看到我，因为"}, {"type": "subtitle", "time": 797.509, "timestamp": "00:13:17", "text": "我会被责骂。 你为什么在这里？   是的"}, {"type": "subtitle", "time": 801.19, "timestamp": "00:13:21", "text": "，这是我最近发现的一个地方"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "。"}, {"type": "subtitle", "time": 810.15, "timestamp": "00:13:30", "text": "那片区域后面就像一片海洋。 所以我觉得我应该可以从这里过"}, {"type": "subtitle", "time": 815.11, "timestamp": "00:13:35", "text": "马路。 但"}, {"type": "subtitle", "time": 819.404, "timestamp": "00:13:39", "text": "通常没有人会来这里。 所以，是啊，"}, {"type": "subtitle", "time": 820.31, "timestamp": "00:13:40", "text": "[嗤笑]"}, {"type": "subtitle", "time": 823.11, "timestamp": "00:13:43", "text": "如果有人在这里，呃，那场面肯定会很"}, {"type": "subtitle", "time": 825.59, "timestamp": "00:13:45", "text": "尴尬。"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "虽然日落已经结束，但我只想"}, {"type": "subtitle", "time": 830.629, "timestamp": "00:13:50", "text": "坐在河边"}]
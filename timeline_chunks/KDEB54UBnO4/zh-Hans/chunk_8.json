[{"type": "subtitle", "time": 483.909, "timestamp": "00:08:03", "text": "天快黑了。 我的天哪。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "我想我从这边过马路。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "M. 对不起。 非常非常抱歉。 很长一段场景。"}, {"type": "subtitle", "time": 518.389, "timestamp": "00:08:38", "text": "那不是我想让你们看到的画面，是"}, {"type": "subtitle", "time": 522.31, "timestamp": "00:08:42", "text": "意外。"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "我想我得暂时锁定一下"}]
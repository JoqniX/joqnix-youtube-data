[{"type": "subtitle", "time": 254.149, "timestamp": "00:04:14", "text": "。 呃，各位收看的朋友们，我"}, {"type": "subtitle", "time": 257.749, "timestamp": "00:04:17", "text": "直播开始得有点晚了。 所以，"}, {"type": "subtitle", "time": 259.349, "timestamp": "00:04:19", "text": "呃，"}, {"type": "subtitle", "time": 262.069, "timestamp": "00:04:22", "text": "我不知道我是否应该待在这里。"}, {"type": "subtitle", "time": 265.83, "timestamp": "00:04:25", "text": "希望我还在线，兄弟。"}, {"type": "subtitle", "time": 268.39, "timestamp": "00:04:28", "text": "嗯。"}, {"type": "subtitle", "time": 272.15, "timestamp": "00:04:32", "text": "我正处于生理期。 我迟到了。"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "我还活着吗？ 真的吗？ 好了，我开始直播了。 好的。"}, {"type": "subtitle", "time": 287.67, "timestamp": "00:04:47", "text": "好的。 好的。 好的。 好的。 好的。 所以，呃，"}, {"type": "subtitle", "time": 290.71, "timestamp": "00:04:50", "text": "两件事。 嗯，是的，马上就要"}, {"type": "subtitle", "time": 294.71, "timestamp": "00:04:54", "text": "日落了。 我"}, {"type": "subtitle", "time": 297.43, "timestamp": "00:04:57", "text": "还在这路上，在这条路上。"}]
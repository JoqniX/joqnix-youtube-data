[{"type": "subtitle", "time": 2229.589, "timestamp": "00:37:09", "text": "如果他们问我，我就把麦克风静音。"}, {"type": "subtitle", "time": 2232.63, "timestamp": "00:37:12", "text": "如果他们问我，我就把"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "麦克风静音，随便找个借口搪塞过去。 哦，等等。"}, {"type": "subtitle", "time": 2240.47, "timestamp": "00:37:20", "text": "他们会看到我的三脚架。"}, {"type": "subtitle", "time": 2242.735, "timestamp": "00:37:22", "text": "所以，我不能撒谎。"}, {"type": "subtitle", "time": 2249.03, "timestamp": "00:37:29", "text": "不过他们会看到我的三脚架。"}]
[{"type": "subtitle", "time": 5040.928, "timestamp": "01:24:00", "text": "我在哪里。"}, {"type": "subtitle", "time": 5041.83, "timestamp": "01:24:01", "text": "[嗤笑]"}, {"type": "subtitle", "time": 5045.27, "timestamp": "01:24:05", "text": "我感觉自己离哪里都很远。"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "我身处高尔夫球场。   我勒个去"}, {"type": "subtitle", "time": 5051.99, "timestamp": "01:24:11", "text": "？"}, {"type": "subtitle", "time": 5061.43, "timestamp": "01:24:21", "text": "我现在就去那里。   我"}, {"type": "subtitle", "time": 5063.83, "timestamp": "01:24:23", "text": "的天哪，我进入了一个全新的音乐"}, {"type": "subtitle", "time": 5066.07, "timestamp": "01:24:26", "text": "领域。   我勒个去"}, {"type": "subtitle", "time": 5080.47, "timestamp": "01:24:40", "text": "呃，"}, {"type": "subtitle", "time": 5082.95, "timestamp": "01:24:42", "text": "那我离家还有多少公里"}, {"type": "subtitle", "time": 5085.11, "timestamp": "01:24:45", "text": "？"}, {"type": "subtitle", "time": 5087.99, "timestamp": "01:24:47", "text": "我觉得我离目的地有"}, {"type": "subtitle", "time": 5098.07, "timestamp": "01:24:58", "text": "我为什么会来？"}]
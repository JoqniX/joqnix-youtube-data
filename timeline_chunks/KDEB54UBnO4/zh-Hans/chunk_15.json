[{"type": "subtitle", "time": 902.069, "timestamp": "00:15:02", "text": "你知道，天黑以后就危险又"}, {"type": "subtitle", "time": 903.75, "timestamp": "00:15:03", "text": "可怕了。   是的"}, {"type": "subtitle", "time": 906.629, "timestamp": "00:15:06", "text": "。 就是这里。"}, {"type": "subtitle", "time": 909.59, "timestamp": "00:15:09", "text": "这里没人。 我可以，我可以，我可以把它完全留给我"}, {"type": "subtitle", "time": 911.91, "timestamp": "00:15:11", "text": "自己。   是的"}, {"type": "subtitle", "time": 921.35, "timestamp": "00:15:21", "text": "不仅仅是"}, {"type": "subtitle", "time": 923.11, "timestamp": "00:15:23", "text": "风很大。"}, {"type": "subtitle", "time": 925.829, "timestamp": "00:15:25", "text": "再看看这个。 所有的石头都"}, {"type": "subtitle", "time": 927.99, "timestamp": "00:15:27", "text": "用金属丝之类的东西包裹着，这样它们就"}, {"type": "subtitle", "time": 931.03, "timestamp": "00:15:31", "text": "不会移动，不会移位之类的"}, {"type": "subtitle", "time": 932.23, "timestamp": "00:15:32", "text": "。"}, {"type": "subtitle", "time": 935.35, "timestamp": "00:15:35", "text": "这里真是个好地方。"}, {"type": "subtitle", "time": 937.99, "timestamp": "00:15:37", "text": "这是桥底下。"}, {"type": "subtitle", "time": 943.91, "timestamp": "00:15:43", "text": "感谢各位的到来和"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "收看。我们当时就坐在"}, {"type": "subtitle", "time": 951.03, "timestamp": "00:15:51", "text": "那边的一块石头上，放松一下。"}, {"type": "subtitle", "time": 952.71, "timestamp": "00:15:52", "text": "我的裤子当然会"}, {"type": "subtitle", "time": 954.55, "timestamp": "00:15:54", "text": "弄脏。"}, {"type": "subtitle", "time": 958.15, "timestamp": "00:15:58", "text": "啊，干得漂亮。 我必须小心。"}]
[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "我当时就在桥下那片区域。 这就是"}, {"type": "subtitle", "time": 3016.39, "timestamp": "00:50:16", "text": "好的，这里是个好地方。"}, {"type": "subtitle", "time": 3018.39, "timestamp": "00:50:18", "text": "呃，"}, {"type": "subtitle", "time": 3022.15, "timestamp": "00:50:22", "text": "我当时就在这座桥下面，"}, {"type": "subtitle", "time": 3024.63, "timestamp": "00:50:24", "text": "呃，这边。"}, {"type": "subtitle", "time": 3027.109, "timestamp": "00:50:27", "text": "我当时就在下面。 坐在"}, {"type": "subtitle", "time": 3029.75, "timestamp": "00:50:29", "text": "那边。 那么，我们就到了这里。"}, {"type": "subtitle", "time": 3031.99, "timestamp": "00:50:31", "text": "呃，"}, {"type": "subtitle", "time": 3034.309, "timestamp": "00:50:34", "text": "为什么抖得这么厉害？ 因为我正"}, {"type": "subtitle", "time": 3036.23, "timestamp": "00:50:36", "text": "处于生理周期，"}, {"type": "subtitle", "time": 3039.829, "timestamp": "00:50:39", "text": "而且，"}, {"type": "subtitle", "time": 3042.47, "timestamp": "00:50:42", "text": "我唯一能做的就是这样。 我把"}, {"type": "subtitle", "time": 3045.27, "timestamp": "00:50:45", "text": "东西这样放，移动电源"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "就放在那边。 我不知道。"}, {"type": "subtitle", "time": 3050.63, "timestamp": "00:50:50", "text": "它晃动得很厉害。 就是这样"}, {"type": "subtitle", "time": 3054.63, "timestamp": "00:50:54", "text": "。 呃，我没有"}, {"type": "subtitle", "time": 3057.349, "timestamp": "00:50:57", "text": "手机支架。"}, {"type": "subtitle", "time": 3059.67, "timestamp": "00:50:59", "text": "如果是小孩子，你会说西班牙语吗？"}]
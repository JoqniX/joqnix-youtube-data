[{"type": "subtitle", "time": 2471.75, "timestamp": "00:41:11", "text": "什么？我该怎么看"}, {"type": "subtitle", "time": 2474.309, "timestamp": "00:41:14", "text": "评论啊，兄弟？"}, {"type": "subtitle", "time": 2476.47, "timestamp": "00:41:16", "text": "问题是"}, {"type": "subtitle", "time": 2479.829, "timestamp": "00:41:19", "text": "无论我怎么做，都看不到评论。 你是不是那个夜晚在"}, {"type": "subtitle", "time": 2481.349, "timestamp": "00:41:21", "text": "日本街头游荡的幽灵"}, {"type": "subtitle", "time": 2484.71, "timestamp": "00:41:24", "text": "？ 不，我真的是我的学校。 我去给"}, {"type": "subtitle", "time": 2488.47, "timestamp": "00:41:28", "text": "你们看"}, {"type": "subtitle", "time": 2490.39, "timestamp": "00:41:30", "text": "桥下的日落，那里是"}, {"type": "subtitle", "time": 2503.43, "timestamp": "00:41:43", "text": "好啊，我们去骑自行车吧。 好的。 呃，请"}]
[{"type": "subtitle", "time": 12901.67, "timestamp": "03:35:01", "text": "在直播中泄露了自己的个人信息，比如"}, {"type": "subtitle", "time": 12905.429, "timestamp": "03:35:05", "text": "手机从三脚架上掉下来。   看来"}, {"type": "subtitle", "time": 12909.03, "timestamp": "03:35:09", "text": "我需要买个好用的手机支架了"}, {"type": "subtitle", "time": 12911.19, "timestamp": "03:35:11", "text": "。"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "嗯，是的，我需要买个好用的手机"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "支架。  [清嗓子]"}, {"type": "subtitle", "time": 12918.79, "timestamp": "03:35:18", "text": "这样我就可以"}, {"type": "subtitle", "time": 12922.95, "timestamp": "03:35:22", "text": "给你们一个好的、好的、"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "好的视角。"}, {"type": "subtitle", "time": 12928.309, "timestamp": "03:35:28", "text": "是的，"}, {"type": "subtitle", "time": 12930.87, "timestamp": "03:35:30", "text": "我觉得我需要更多的"}, {"type": "subtitle", "time": 12937.67, "timestamp": "03:35:37", "text": "即使使用手机支架，"}, {"type": "subtitle", "time": 12941.269, "timestamp": "03:35:41", "text": "自行车似乎也会晃动。   是的"}, {"type": "subtitle", "time": 12943.83, "timestamp": "03:35:43", "text": "。 所以，我想即使我现在喜欢"}, {"type": "subtitle", "time": 12946.55, "timestamp": "03:35:46", "text": "今天的直播，我把"}, {"type": "subtitle", "time": 12951.349, "timestamp": "03:35:51", "text": "手机放在三脚架上，"}, {"type": "subtitle", "time": 12955.75, "timestamp": "03:35:55", "text": "然后把三脚架的腿弯曲到"}, {"type": "subtitle", "time": 12958.87, "timestamp": "03:35:58", "text": "自行车篮上，这样也能"}]
[{"type": "subtitle", "time": 8701.765, "timestamp": "02:25:01", "text": "为什么会出现悖论？"}, {"type": "subtitle", "time": 8708.63, "timestamp": "02:25:08", "text": "Paradillax 让我想起了划桨空间。"}, {"type": "subtitle", "time": 8710.87, "timestamp": "02:25:10", "text": "那个Dwell"}, {"type": "subtitle", "time": 8713.11, "timestamp": "02:25:13", "text": "应用。"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "那可是很多人啊。 他们为什么"}, {"type": "subtitle", "time": 8728.87, "timestamp": "02:25:28", "text": "看着我？ 我脸上有什么东西吗"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "？ 不。是因为我是"}, {"type": "subtitle", "time": 8734.309, "timestamp": "02:25:34", "text": "外国人吗？"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "是的，但这些是5公斤重的，对吧？"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "说说你为什么把"}, {"type": "chat", "time": 8756.433, "timestamp": "02:25:56", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "I like the name, there's a song I like with the same name, and the meaning makes sense for the app"}]
[{"type": "subtitle", "time": 3847.91, "timestamp": "01:04:07", "text": "为什么仍然显示外部模式？"}, {"type": "subtitle", "time": 3850.15, "timestamp": "01:04:10", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 3853.589, "timestamp": "01:04:13", "text": "别再刷屏了。"}, {"type": "subtitle", "time": 3857.029, "timestamp": "01:04:17", "text": "难怪你处于户外模式。"}, {"type": "subtitle", "time": 3867.51, "timestamp": "01:04:27", "text": "我知道我在室外。 我身处荒郊野外，"}, {"type": "subtitle", "time": 3875.829, "timestamp": "01:04:35", "text": "天知道我在哪里。 我正处于"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "探索的周期中。"}, {"type": "subtitle", "time": 3885.029, "timestamp": "01:04:45", "text": "兄弟，有人知道哪里有我的天吗？   那"}, {"type": "subtitle", "time": 3895.19, "timestamp": "01:04:55", "text": "等等，这是哪里？"}, {"type": "subtitle", "time": 3897.349, "timestamp": "01:04:57", "text": "我只是在骑自行车。 我不知道"}]
[{"type": "subtitle", "time": 2162.31, "timestamp": "00:36:02", "text": "感谢您的关注。"}, {"type": "subtitle", "time": 2165.829, "timestamp": "00:36:05", "text": "等等，你刚才跟着谁去了？"}, {"type": "subtitle", "time": 2170.47, "timestamp": "00:36:10", "text": "哦，谢谢你在Kick上关注我。"}, {"type": "subtitle", "time": 2173.829, "timestamp": "00:36:13", "text": "太感谢了。 我几乎没有"}, {"type": "subtitle", "time": 2176.87, "timestamp": "00:36:16", "text": "踢人观众，"}, {"type": "subtitle", "time": 2181.109, "timestamp": "00:36:21", "text": "不过，我总是会同时进行多路踢人"}, {"type": "subtitle", "time": 2188.55, "timestamp": "00:36:28", "text": "，再次感谢你。"}, {"type": "subtitle", "time": 2194.47, "timestamp": "00:36:34", "text": "呃，我得确保没有人……哦，天哪，"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "我……我疯了……我……"}, {"type": "subtitle", "time": 2204.63, "timestamp": "00:36:44", "text": "我觉得我可能会"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "见到我的老师。"}, {"type": "subtitle", "time": 2211.51, "timestamp": "00:36:51", "text": "我有可能见到我的"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "老师们。 我只希望不用走路，因为我把"}]
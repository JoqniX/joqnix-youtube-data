[{"type": "subtitle", "time": 6141.91, "timestamp": "01:42:21", "text": "我明天得洗轮胎。"}, {"type": "subtitle", "time": 6151.35, "timestamp": "01:42:31", "text": "我身上连水都没带"}, {"type": "subtitle", "time": 6155.189, "timestamp": "01:42:35", "text": "。 太痛苦了。"}, {"type": "subtitle", "time": 6170.149, "timestamp": "01:42:50", "text": "我觉得我可以走这条路出去"}, {"type": "subtitle", "time": 6172.87, "timestamp": "01:42:52", "text": "。"}]
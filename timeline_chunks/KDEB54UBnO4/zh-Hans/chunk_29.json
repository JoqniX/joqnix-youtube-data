[{"type": "subtitle", "time": 1742.47, "timestamp": "00:29:02", "text": "天，真的已经是晚上了。 天色"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "渐渐暗了，不是吗？ 天色渐渐"}, {"type": "subtitle", "time": 1748.47, "timestamp": "00:29:08", "text": "暗了。 各位，太阳现在已经落山了"}, {"type": "subtitle", "time": 1753.19, "timestamp": "00:29:13", "text": "。 太阳落山了。"}, {"type": "subtitle", "time": 1758.389, "timestamp": "00:29:18", "text": "天哪，风好大，还冷。"}, {"type": "subtitle", "time": 1761.909, "timestamp": "00:29:21", "text": "你可以看到我头顶屏幕上的温度"}, {"type": "subtitle", "time": 1766.31, "timestamp": "00:29:26", "text": "。 上面显示19°"}, {"type": "subtitle", "time": 1770.789, "timestamp": "00:29:30", "text": "C。真冷。 而且，"}, {"type": "subtitle", "time": 1777.19, "timestamp": "00:29:37", "text": "洪托。"}, {"type": "subtitle", "time": 1779.83, "timestamp": "00:29:39", "text": "哦，蝙蝠。 我的天哪。 蝙蝠。 哦，蝙蝠。 哦，"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "蝙蝠。 我的天哪。"}, {"type": "subtitle", "time": 1785.11, "timestamp": "00:29:45", "text": "蝙蝠侠来了。"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "啊，这里好多蝙蝠啊。 天哪，我的"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "相机不太好。"}]
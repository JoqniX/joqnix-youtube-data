[{"type": "subtitle", "time": 5953.99, "timestamp": "01:39:13", "text": "为什么要在这个时候骑车？  [音乐] 当时是"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "呃，我该怎么回去？"}, {"type": "subtitle", "time": 5969.83, "timestamp": "01:39:29", "text": "我他妈在哪儿？ 我的天啊。"}, {"type": "subtitle", "time": 5973.669, "timestamp": "01:39:33", "text": "它告诉我上这座桥。"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "但我身处这荒郊野外。 我"}, {"type": "subtitle", "time": 5978.31, "timestamp": "01:39:38", "text": "身处建筑工地。 我应该反其道而行之"}, {"type": "subtitle", "time": 5980.79, "timestamp": "01:39:40", "text": "。"}, {"type": "subtitle", "time": 5996.79, "timestamp": "01:39:56", "text": "好的，我"}, {"type": "subtitle", "time": 5998.95, "timestamp": "01:39:58", "text": "感觉背上有东西"}]
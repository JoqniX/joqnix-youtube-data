[{"type": "subtitle", "time": 1264.789, "timestamp": "00:21:04", "text": "我忘了你不需要把它"}, {"type": "subtitle", "time": 1289.27, "timestamp": "00:21:29", "text": "好的。 三脚架时刻。"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "但你们要如何才能听到我的声音呢？ 我忘了带"}, {"type": "subtitle", "time": 1294.47, "timestamp": "00:21:34", "text": "外接麦克风。 啊。 雅达。 我"}, {"type": "subtitle", "time": 1302.07, "timestamp": "00:21:42", "text": "我忘了。"}, {"type": "subtitle", "time": 1311.43, "timestamp": "00:21:51", "text": "我该如何留住你？ 我该把"}]
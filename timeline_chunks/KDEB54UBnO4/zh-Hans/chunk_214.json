[{"type": "subtitle", "time": 12845.19, "timestamp": "03:34:05", "text": "总的来说，今天真是不平凡的一天。"}, {"type": "subtitle", "time": 12850.469, "timestamp": "03:34:10", "text": "最后我们骑自行车"}, {"type": "subtitle", "time": 12853.91, "timestamp": "03:34:13", "text": "从K出发，大概骑了10公里，我们"}, {"type": "subtitle", "time": 12858.15, "timestamp": "03:34:18", "text": "沿着高速公路骑了一段。   真是太好了"}, {"type": "subtitle", "time": 12861.67, "timestamp": "03:34:21", "text": "。 今天是我们"}, {"type": "subtitle", "time": 12863.91, "timestamp": "03:34:23", "text": "熟悉的一天。   感谢所有"}, {"type": "subtitle", "time": 12877.269, "timestamp": "03:34:37", "text": "感谢所有到场的朋友们。"}, {"type": "subtitle", "time": 12881.19, "timestamp": "03:34:41", "text": "这对我意义重大。"}, {"type": "subtitle", "time": 12884.79, "timestamp": "03:34:44", "text": "我希望直播过程还能"}, {"type": "subtitle", "time": 12887.11, "timestamp": "03:34:47", "text": "忍受，"}, {"type": "subtitle", "time": 12890.87, "timestamp": "03:34:50", "text": "因为我们遇到了很多问题。"}, {"type": "subtitle", "time": 12893.19, "timestamp": "03:34:53", "text": "好吧，我们的直播出现了很多问题"}, {"type": "subtitle", "time": 12895.349, "timestamp": "03:34:55", "text": "。"}, {"type": "subtitle", "time": 12898.71, "timestamp": "03:34:58", "text": "哎呀，我的天哪，有好几次我差点"}]
[{"type": "subtitle", "time": 13260.87, "timestamp": "03:41:00", "text": "确认一下说话机器人是不是"}, {"type": "subtitle", "time": 13264.63, "timestamp": "03:41:04", "text": "来自 Streamerbot，对吧？  Streamabots"}, {"type": "subtitle", "time": 13268.229, "timestamp": "03:41:08", "text": "还有一件事，呃，扬声器板，我"}, {"type": "subtitle", "time": 13271.59, "timestamp": "03:41:11", "text": "不知道我是否可以让扬声器"}, {"type": "subtitle", "time": 13273.19, "timestamp": "03:41:13", "text": "板"}, {"type": "subtitle", "time": 13275.75, "timestamp": "03:41:15", "text": "给我文本转语音的东西，然后我通过"}, {"type": "subtitle", "time": 13278.79, "timestamp": "03:41:18", "text": "互联网发送出去，"}, {"type": "subtitle", "time": 13282.469, "timestamp": "03:41:22", "text": "呃，然后我可以"}, {"type": "subtitle", "time": 13286.07, "timestamp": "03:41:26", "text": "通过"}, {"type": "subtitle", "time": 13289.03, "timestamp": "03:41:29", "text": "歧管"}, {"type": "subtitle", "time": 13292.07, "timestamp": "03:41:32", "text": "或其他设备听到它。 嗯。 这倒是个好主意"}, {"type": "subtitle", "time": 13295.269, "timestamp": "03:41:35", "text": "。 我不确定这是否是个好主意。"}, {"type": "subtitle", "time": 13299.59, "timestamp": "03:41:39", "text": "我得看看那个。 是的，我得"}, {"type": "subtitle", "time": 13302.95, "timestamp": "03:41:42", "text": "检查一下那个文本语音功能。 是的，"}, {"type": "subtitle", "time": 13304.79, "timestamp": "03:41:44", "text": "现在的语音朗读功能更好了。 这样我就"}, {"type": "subtitle", "time": 13308.15, "timestamp": "03:41:48", "text": "可以了解聊天内容，知道聊天对象在"}, {"type": "subtitle", "time": 13312.389, "timestamp": "03:41:52", "text": "说什么等等。 我可以听而"}, {"type": "subtitle", "time": 13314.87, "timestamp": "03:41:54", "text": "不是读，并且停止"}, {"type": "subtitle", "time": 13317.75, "timestamp": "03:41:57", "text": "在骑行过程中停下来阅读"}]
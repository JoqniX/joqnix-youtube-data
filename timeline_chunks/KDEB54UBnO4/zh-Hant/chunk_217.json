[{"type": "subtitle", "time": 13027.03, "timestamp": "03:37:07", "text": "目前我暫時就先這樣吧。"}, {"type": "subtitle", "time": 13045.67, "timestamp": "03:37:25", "text": "然後用它來固定這個……我不知道該怎麼做，但如果我沒記錯的話，"}, {"type": "subtitle", "time": 13053.59, "timestamp": "03:37:33", "text": "我需要一個夾子。  我真的需要一個夾子。  是的，"}, {"type": "subtitle", "time": 13066.07, "timestamp": "03:37:46", "text": "我需要一個蛤蜊，兄弟。  [嘆氣]"}]
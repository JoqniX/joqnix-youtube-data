[{"type": "subtitle", "time": 8046.95, "timestamp": "02:14:06", "text": "兄弟，如果我有錢，我就帶"}, {"type": "subtitle", "time": 8050.31, "timestamp": "02:14:10", "text": "你們去拉麵店，然後拍下我吃拉麵的影片。"}, {"type": "subtitle", "time": 8058.87, "timestamp": "02:14:18", "text": "下次。總會有下一次機會。"}, {"type": "subtitle", "time": 8060.79, "timestamp": "02:14:20", "text": "記住，"}, {"type": "subtitle", "time": 8062.39, "timestamp": "02:14:22", "text": "戶外溪流就像一場"}, {"type": "subtitle", "time": 8064.39, "timestamp": "02:14:24", "text": "探險。我的天啊。差點就撞到那塊"}, {"type": "subtitle", "time": 8067.189, "timestamp": "02:14:27", "text": "板子了。戶外溪流就像……等等，我到大創了。"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "什麼？  我剛到大創。等等，我該去找手機支架嗎？  等等，我到大創了。"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "等等，我怎麼突然就到了大"}, {"type": "subtitle", "time": 8079.43, "timestamp": "02:14:39", "text": "創？"}, {"type": "subtitle", "time": 8082.47, "timestamp": "02:14:42", "text": "等等，等等。我想等等。我想問，這是不是"}]
[{"type": "subtitle", "time": 5526.149, "timestamp": "01:32:06", "text": "等待。讓我擰緊螺絲。好的。"}, {"type": "subtitle", "time": 5550.79, "timestamp": "01:32:30", "text": "我發誓，如果它再這樣下去，我就要"}, {"type": "subtitle", "time": 5563.35, "timestamp": "01:32:43", "text": "等等，它說要向左走。"}, {"type": "subtitle", "time": 5569.91, "timestamp": "01:32:49", "text": "我的谷歌地圖顯示直行。"}]
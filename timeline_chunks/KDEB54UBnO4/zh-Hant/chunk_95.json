[{"type": "subtitle", "time": 5708.229, "timestamp": "01:35:08", "text": "？"}, {"type": "subtitle", "time": 5721.91, "timestamp": "01:35:21", "text": "這裡是區域嗎？  我的天，太可怕了。"}, {"type": "subtitle", "time": 5734.31, "timestamp": "01:35:34", "text": "我該相信Google地圖嗎？我的天，這條路可真夠"}, {"type": "subtitle", "time": 5738.31, "timestamp": "01:35:38", "text": "崎嶇的。糟糕，這路不好走。  天哪，我沒事。  我的手機相機。  我的天，又要越野了。  越野時間。  這裡是正確區域嗎？  不過路面很顛簸。  等等，"}, {"type": "subtitle", "time": 5740.95, "timestamp": "01:35:40", "text": "道路封閉了。"}, {"type": "subtitle", "time": 5743.99, "timestamp": "01:35:43", "text": "我聽到奇怪的聲音。  搞什麼鬼？"}]
[{"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "我當時想，有些壞人可能會"}, {"type": "subtitle", "time": 784.71, "timestamp": "00:13:04", "text": "看到我。  我的"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "天哪。所以我們要去這邊這個區域"}, {"type": "subtitle", "time": 794.069, "timestamp": "00:13:14", "text": "我不想讓別人看到我，因為"}, {"type": "subtitle", "time": 797.509, "timestamp": "00:13:17", "text": "我會被罵。你為什麼在這裡？"}, {"type": "subtitle", "time": 801.19, "timestamp": "00:13:21", "text": "是的，這是我最近發現的一個地方"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "。"}, {"type": "subtitle", "time": 810.15, "timestamp": "00:13:30", "text": "那片區域後面就像一片海洋。所以我覺得"}, {"type": "subtitle", "time": 815.11, "timestamp": "00:13:35", "text": "我應該可以從這裡過馬路。但"}, {"type": "subtitle", "time": 819.404, "timestamp": "00:13:39", "text": "通常沒有人會來這裡。所以，是啊，"}, {"type": "subtitle", "time": 820.31, "timestamp": "00:13:40", "text": "[嗤笑]"}, {"type": "subtitle", "time": 823.11, "timestamp": "00:13:43", "text": "如果有人在這裡，呃，那場面一定會很"}, {"type": "subtitle", "time": 825.59, "timestamp": "00:13:45", "text": "尷尬。"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "雖然日落已經結束，但我"}, {"type": "subtitle", "time": 830.629, "timestamp": "00:13:50", "text": "只想坐在河邊"}]
[{"type": "subtitle", "time": 1340.87, "timestamp": "00:22:20", "text": "來自孩子的問候。你好。你好。"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "現在天色已晚。"}, {"type": "subtitle", "time": 1355.19, "timestamp": "00:22:35", "text": "我不知道自己在做什麼。我"}, {"type": "subtitle", "time": 1358.71, "timestamp": "00:22:38", "text": "只是想來這裡，做個直播，看看"}, {"type": "subtitle", "time": 1364.549, "timestamp": "00:22:44", "text": "日落什麼的，一邊吃麵包一邊喝罐魔爪"}, {"type": "subtitle", "time": 1366.95, "timestamp": "00:22:46", "text": "能量飲料"}, {"type": "subtitle", "time": 1369.35, "timestamp": "00:22:49", "text": "。但我忘了帶"}]
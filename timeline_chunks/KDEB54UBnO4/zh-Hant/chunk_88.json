[{"type": "subtitle", "time": 5293.51, "timestamp": "01:28:13", "text": "你好。你好。你好。"}, {"type": "subtitle", "time": 5295.43, "timestamp": "01:28:15", "text": "那還不錯。"}, {"type": "subtitle", "time": 5308.55, "timestamp": "01:28:28", "text": "好了，我們走吧。我們離家好遠"}, {"type": "subtitle", "time": 5339.91, "timestamp": "01:28:59", "text": "我騎車，所以沒辦法聯絡你"}]
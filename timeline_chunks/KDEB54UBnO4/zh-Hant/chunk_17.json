[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "。  天哪，風好大。"}, {"type": "subtitle", "time": 1028.069, "timestamp": "00:17:08", "text": "看，那是蝙蝠嗎？"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "那是一隻小蝙蝠。"}, {"type": "subtitle", "time": 1040.87, "timestamp": "00:17:20", "text": "他飛走了。"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "是的，這是我最近發現的景點之一。"}, {"type": "subtitle", "time": 1049.99, "timestamp": "00:17:29", "text": "我打算就坐在這塊石頭上，"}, {"type": "subtitle", "time": 1053.75, "timestamp": "00:17:33", "text": "我們在這裡放鬆一下。確保“"}, {"type": "subtitle", "time": 1058.07, "timestamp": "00:17:38", "text": "哦，糟糕”。請確保我的"}, {"type": "subtitle", "time": 1060.31, "timestamp": "00:17:40", "text": "鞋子不要弄濕。"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "那是"}, {"type": "subtitle", "time": 1065.27, "timestamp": "00:17:45", "text": "烏鴉糞便嗎？鳥糞。"}, {"type": "subtitle", "time": 1068.07, "timestamp": "00:17:48", "text": "這不是最近發生的事。節目。"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "這裡有個煙頭。我會用它"}, {"type": "subtitle", "time": 1078.39, "timestamp": "00:17:58", "text": "來清潔它。我的天哪。"}]
[{"type": "subtitle", "time": 1440.63, "timestamp": "00:24:00", "text": "所以，你可以清楚地看到"}, {"type": "subtitle", "time": 1445.43, "timestamp": "00:24:05", "text": "下面是誰。如果那邊的人"}, {"type": "subtitle", "time": 1451.029, "timestamp": "00:24:11", "text": "看到我，"}, {"type": "subtitle", "time": 1453.11, "timestamp": "00:24:13", "text": "他們會說：「這個人是"}, {"type": "subtitle", "time": 1464.586, "timestamp": "00:24:24", "text": "我爸爸剛回家。歡迎回來。"}, {"type": "subtitle", "time": 1473.83, "timestamp": "00:24:33", "text": "大家最近怎麼樣？你"}, {"type": "subtitle", "time": 1476.23, "timestamp": "00:24:36", "text": "今天過得怎麼樣？"}, {"type": "subtitle", "time": 1494.149, "timestamp": "00:24:54", "text": "是蘋果汁。我只有一些音樂作品，"}, {"type": "subtitle", "time": 1496.39, "timestamp": "00:24:56", "text": "正如你所看到的。只有一"}]
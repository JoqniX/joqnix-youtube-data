[{"type": "subtitle", "time": 1507.83, "timestamp": "00:25:07", "text": "我覺得體育場"}, {"type": "subtitle", "time": 1511.909, "timestamp": "00:25:11", "text": "可能像俱樂部活動之類的場所在運作。"}, {"type": "subtitle", "time": 1514.31, "timestamp": "00:25:14", "text": "所以他們就用那邊的球場"}, {"type": "subtitle", "time": 1515.75, "timestamp": "00:25:15", "text": "。那邊那個。你能"}, {"type": "subtitle", "time": 1517.99, "timestamp": "00:25:17", "text": "感受到音樂嗎？"}, {"type": "subtitle", "time": 1520.47, "timestamp": "00:25:20", "text": "但那邊那"}, {"type": "subtitle", "time": 1545.35, "timestamp": "00:25:45", "text": "我真希望可以帶你們去"}, {"type": "subtitle", "time": 1553.029, "timestamp": "00:25:53", "text": "如果我要這樣做，我需要確保我的"}, {"type": "subtitle", "time": 1557.11, "timestamp": "00:25:57", "text": "設備保持直立，不會到處"}]
[{"type": "subtitle", "time": 254.149, "timestamp": "00:04:14", "text": "是的。呃，各位收看的朋友們，我"}, {"type": "subtitle", "time": 257.749, "timestamp": "00:04:17", "text": "直播開始得有點晚了。所以，"}, {"type": "subtitle", "time": 259.349, "timestamp": "00:04:19", "text": "呃，"}, {"type": "subtitle", "time": 262.069, "timestamp": "00:04:22", "text": "我不知道我是否應該待在這裡。"}, {"type": "subtitle", "time": 265.83, "timestamp": "00:04:25", "text": "希望我還在線，兄弟。"}, {"type": "subtitle", "time": 268.39, "timestamp": "00:04:28", "text": "嗯。  我正處於生理期。我遲到了。"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "我還活著嗎？真的嗎？好了，我開始直播了。好的。  好的。好的。好的。好的。"}, {"type": "subtitle", "time": 287.67, "timestamp": "00:04:47", "text": "好的。所以，呃，"}, {"type": "subtitle", "time": 290.71, "timestamp": "00:04:50", "text": "兩件事。嗯，是的，馬上就要"}, {"type": "subtitle", "time": 294.71, "timestamp": "00:04:54", "text": "日落了。我"}, {"type": "subtitle", "time": 297.43, "timestamp": "00:04:57", "text": "還在這路上，在這條路上。"}]
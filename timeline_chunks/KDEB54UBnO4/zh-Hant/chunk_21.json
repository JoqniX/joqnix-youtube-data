[{"type": "subtitle", "time": 1264.789, "timestamp": "00:21:04", "text": "我忘了你不需要把它"}, {"type": "subtitle", "time": 1289.27, "timestamp": "00:21:29", "text": "好的。三腳架時刻。"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "但你們要如何才能聽到我的聲音呢？我忘了帶"}, {"type": "subtitle", "time": 1294.47, "timestamp": "00:21:34", "text": "外接麥克風。啊。雅達。我忘了。"}, {"type": "subtitle", "time": 1302.08, "timestamp": "00:21:42", "text": "我忘了。 我居然忘了。"}, {"type": "subtitle", "time": 1311.43, "timestamp": "00:21:51", "text": "我該如何留住你？我該把你們關在哪裡？"}]
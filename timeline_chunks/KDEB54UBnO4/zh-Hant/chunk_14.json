[{"type": "subtitle", "time": 844.15, "timestamp": "00:14:04", "text": "嗯，這裡就是這裡，就是那個區域。"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "這裡一個人也沒有。"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "兄弟，我在橋底下"}, {"type": "subtitle", "time": 852.55, "timestamp": "00:14:12", "text": "。我在橋下。"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "呃，"}, {"type": "subtitle", "time": 862.23, "timestamp": "00:14:22", "text": "我改了那個東西。呃，你需要"}, {"type": "subtitle", "time": 864.79, "timestamp": "00:14:24", "text": "增加一個鎖定滑桿的功能。"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "石頭之類的東西。必須"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "小心。現在這裡一個人也沒有"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "。"}, {"type": "subtitle", "time": 881.91, "timestamp": "00:14:41", "text": "呃，我希望不會打擾到"}, {"type": "subtitle", "time": 883.67, "timestamp": "00:14:43", "text": "別人，如果他們在這後面做些可疑的事情，"}, {"type": "subtitle", "time": 886.89, "timestamp": "00:14:46", "text": "因為到目前為止，這裡"}, {"type": "subtitle", "time": 890.31, "timestamp": "00:14:50", "text": "人不多。"}, {"type": "subtitle", "time": 893.75, "timestamp": "00:14:53", "text": "我得在天黑前離開這裡，"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "因為"}]
[{"type": "subtitle", "time": 1695.59, "timestamp": "00:28:15", "text": "我忘了帶我的麥克風。我把所有東西都拿走了。我帶了備用行動電源、備用充電器、"}, {"type": "subtitle", "time": 1701.029, "timestamp": "00:28:21", "text": "USB 線，"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "什麼都帶了。我忘了帶外接手電筒"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "。  你在哪個國家？日本。我目前在"}, {"type": "subtitle", "time": 1707.909, "timestamp": "00:28:27", "text": "日本當"}, {"type": "subtitle", "time": 1709.83, "timestamp": "00:28:29", "text": "語言"}, {"type": "subtitle", "time": 1712.789, "timestamp": "00:28:32", "text": "交換生。  我來這裡是學習語言的。  呃，我在日本。  是的"}]
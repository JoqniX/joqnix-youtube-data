[{"type": "subtitle", "time": 5400.87, "timestamp": "01:30:00", "text": "我漏水了嗎？是嗎？他媽的。他媽的。我露臉了嗎？拉屎。  拉屎。  媽的"}, {"type": "subtitle", "time": 5412.317, "timestamp": "01:30:12", "text": "。  等待。發生什麼事了嗎？我的天哪。"}, {"type": "subtitle", "time": 5413.11, "timestamp": "01:30:13", "text": "[清喉嚨] 操。  呃。  拉屎。"}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "喬，走吧。  對不起。"}, {"type": "subtitle", "time": 5458.31, "timestamp": "01:30:58", "text": "我需要對此進行調查。當時幾點"}]
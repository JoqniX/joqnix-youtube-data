[{"type": "subtitle", "time": 301.27, "timestamp": "00:05:01", "text": "週期來了。呃，"}, {"type": "subtitle", "time": 315.189, "timestamp": "00:05:15", "text": "我快到學校附近了。"}, {"type": "subtitle", "time": 318.71, "timestamp": "00:05:18", "text": "我需要去某個地方。我會把"}, {"type": "subtitle", "time": 323.67, "timestamp": "00:05:23", "text": "自行車停在學校的"}, {"type": "subtitle", "time": 327.99, "timestamp": "00:05:27", "text": "停車場，然後"}, {"type": "subtitle", "time": 331.27, "timestamp": "00:05:31", "text": "我會給你們一些精彩時刻。"}, {"type": "subtitle", "time": 333.909, "timestamp": "00:05:33", "text": "我知道一個好地方。"}, {"type": "subtitle", "time": 337.35, "timestamp": "00:05:37", "text": "呃，雖然太陽正在落山，"}, {"type": "subtitle", "time": 340.07, "timestamp": "00:05:40", "text": "雖然現在已經是 5:30 了，但日落時間"}, {"type": "subtitle", "time": 342.87, "timestamp": "00:05:42", "text": "是下午 5:18。  外面"}, {"type": "subtitle", "time": 355.909, "timestamp": "00:05:55", "text": "風好大。"}]
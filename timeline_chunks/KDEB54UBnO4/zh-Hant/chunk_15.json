[{"type": "subtitle", "time": 902.069, "timestamp": "00:15:02", "text": "你知道，天黑以後就危險又"}, {"type": "subtitle", "time": 903.75, "timestamp": "00:15:03", "text": "可怕了。"}, {"type": "subtitle", "time": 906.629, "timestamp": "00:15:06", "text": "是的。就是這裡。  這裡"}, {"type": "subtitle", "time": 909.59, "timestamp": "00:15:09", "text": "沒人。我可以，我可以，我可以把它完全留給我"}, {"type": "subtitle", "time": 911.91, "timestamp": "00:15:11", "text": "自己。  是的。"}, {"type": "subtitle", "time": 921.35, "timestamp": "00:15:21", "text": "不只是"}, {"type": "subtitle", "time": 923.11, "timestamp": "00:15:23", "text": "風很大。"}, {"type": "subtitle", "time": 925.829, "timestamp": "00:15:25", "text": "再看看這個。所有的石頭都"}, {"type": "subtitle", "time": 927.99, "timestamp": "00:15:27", "text": "用金屬絲之類的東西包裹著，這樣它們就"}, {"type": "subtitle", "time": 931.03, "timestamp": "00:15:31", "text": "不會移動，不會移位之類的"}, {"type": "subtitle", "time": 932.23, "timestamp": "00:15:32", "text": "。"}, {"type": "subtitle", "time": 935.35, "timestamp": "00:15:35", "text": "這裡真是個好地方。"}, {"type": "subtitle", "time": 937.99, "timestamp": "00:15:37", "text": "這是橋底下。"}, {"type": "subtitle", "time": 943.91, "timestamp": "00:15:43", "text": "感謝各位的到來與"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "收看。我們當時就坐在"}, {"type": "subtitle", "time": 951.03, "timestamp": "00:15:51", "text": "那邊的石頭上，放鬆一下。"}, {"type": "subtitle", "time": 952.71, "timestamp": "00:15:52", "text": "我的褲子當然會"}, {"type": "subtitle", "time": 954.55, "timestamp": "00:15:54", "text": "弄髒。  啊，幹得漂亮。"}, {"type": "subtitle", "time": 958.15, "timestamp": "00:15:58", "text": "我必須小心。這裡有點滑。  我的天啊，我單手就能做到，兄弟。  糟糕，這滑溜溜的。滑溜溜的。  我的天啊。  我的天啊。媽的。拉屎。拉屎。  媽的。我的天啊。好的。  媽的。好的。  太棒了。  太陽在哪裡？呃，太陽"}]
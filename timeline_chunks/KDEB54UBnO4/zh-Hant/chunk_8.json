[{"type": "subtitle", "time": 483.919, "timestamp": "00:08:03", "text": "。 它即將升溫。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "我想我從這邊過馬路。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "M. 對不起。非常非常抱歉。很長一段場景。"}, {"type": "subtitle", "time": 518.389, "timestamp": "00:08:38", "text": "那不是我想讓你們看到的畫面，是"}, {"type": "subtitle", "time": 522.31, "timestamp": "00:08:42", "text": "意外。"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "我想我得暫時鎖定"}]
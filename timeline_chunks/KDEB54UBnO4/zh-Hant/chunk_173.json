[{"type": "subtitle", "time": 10392.23, "timestamp": "02:53:12", "text": "消防車。  哦，"}, {"type": "subtitle", "time": 10415.67, "timestamp": "02:53:35", "text": "哇。  真是瘋了。瘋狂的。  熱。  熱。  我聞到了好燒製的味道。  那些孩子在馬路上玩耍嗎？  他們在街上跳舞。他們在街頭跳舞。  它在"}, {"type": "subtitle", "time": 10419.349, "timestamp": "02:53:39", "text": "哪裡？"}, {"type": "subtitle", "time": 10422.07, "timestamp": "02:53:42", "text": "家庭市場。  這是哪裡"}]
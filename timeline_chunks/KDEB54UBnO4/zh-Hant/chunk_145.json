[{"type": "subtitle", "time": 8701.765, "timestamp": "02:25:01", "text": "為什麼會出現悖論？"}, {"type": "subtitle", "time": 8708.63, "timestamp": "02:25:08", "text": "Paradillax 讓我想起了劃槳空間。"}, {"type": "subtitle", "time": 8710.87, "timestamp": "02:25:10", "text": "那個Dwell"}, {"type": "subtitle", "time": 8713.11, "timestamp": "02:25:13", "text": "應用。"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "那可是很多人啊。他們為什麼"}, {"type": "subtitle", "time": 8728.87, "timestamp": "02:25:28", "text": "看著我？我臉上有東西嗎"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "？不。是因為我是"}, {"type": "subtitle", "time": 8734.309, "timestamp": "02:25:34", "text": "外國人嗎？"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "是的，但這些是5公斤重的，對吧？"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "說說你為什麼要把"}, {"type": "chat", "time": 8756.433, "timestamp": "02:25:56", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "I like the name, there's a song I like with the same name, and the meaning makes sense for the app"}]
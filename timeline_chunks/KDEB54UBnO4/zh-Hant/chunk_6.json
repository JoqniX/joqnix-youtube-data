[{"type": "subtitle", "time": 368.95, "timestamp": "00:06:08", "text": "所以"}, {"type": "subtitle", "time": 370.71, "timestamp": "00:06:10", "text": "，"}, {"type": "subtitle", "time": 376.23, "timestamp": "00:06:16", "text": "我最初的想法是把手機固定"}, {"type": "subtitle", "time": 379.35, "timestamp": "00:06:19", "text": "在自行車上，讓你們看到我"}, {"type": "subtitle", "time": 382.629, "timestamp": "00:06:22", "text": "騎車時的視角。"}, {"type": "subtitle", "time": 388.87, "timestamp": "00:06:28", "text": "但我覺得今天做不到，"}, {"type": "subtitle", "time": 393.029, "timestamp": "00:06:33", "text": "因為我沒有手機支架了。"}, {"type": "subtitle", "time": 396.55, "timestamp": "00:06:36", "text": "舊的那個被偷了，對吧？這"}, {"type": "subtitle", "time": 401.27, "timestamp": "00:06:41", "text": "是一個新的周期。所以我只好買個新的"}, {"type": "subtitle", "time": 404.87, "timestamp": "00:06:44", "text": "。哦，是的。我必須小心。  我"}, {"type": "subtitle", "time": 407.99, "timestamp": "00:06:47", "text": "不該拿著手機，不然會被"}]
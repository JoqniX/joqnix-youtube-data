[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "私が橋の下にいたのはまさにその場所だったんです。 これが"}, {"type": "subtitle", "time": 3016.39, "timestamp": "00:50:16", "text": "よし、ここはいい場所だ。"}, {"type": "subtitle", "time": 3018.39, "timestamp": "00:50:18", "text": "えっと、"}, {"type": "subtitle", "time": 3022.15, "timestamp": "00:50:22", "text": "私はこの橋の下にいました"}, {"type": "subtitle", "time": 3024.63, "timestamp": "00:50:24", "text": "。"}, {"type": "subtitle", "time": 3027.109, "timestamp": "00:50:27", "text": "私はその下にいた。"}, {"type": "subtitle", "time": 3029.75, "timestamp": "00:50:29", "text": "あそこに座っている。 そして、私たちはここにいる。"}, {"type": "subtitle", "time": 3031.99, "timestamp": "00:50:31", "text": "えっと、なんでこんなに"}, {"type": "subtitle", "time": 3034.309, "timestamp": "00:50:34", "text": "揺れてるの？ 私は"}, {"type": "subtitle", "time": 3036.23, "timestamp": "00:50:36", "text": "生理中で、"}, {"type": "subtitle", "time": 3042.47, "timestamp": "00:50:42", "text": "私の唯一のことはこんな感じなんです。 これをこのように置くと、"}, {"type": "subtitle", "time": 3045.27, "timestamp": "00:50:45", "text": "モバイルバッテリーはあちらの方に来るようになります"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "。 わからない。"}, {"type": "subtitle", "time": 3050.63, "timestamp": "00:50:50", "text": "かなり揺れている。 だから、そういうことになるでしょう"}, {"type": "subtitle", "time": 3054.63, "timestamp": "00:50:54", "text": "。 えっと、"}, {"type": "subtitle", "time": 3057.349, "timestamp": "00:50:57", "text": "スマホスタンドは持っていません。"}, {"type": "subtitle", "time": 3059.67, "timestamp": "00:50:59", "text": "スペイン語が少し話せますか？   たとえ"}]
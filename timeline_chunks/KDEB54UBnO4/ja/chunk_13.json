[{"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "悪い人たちが"}, {"type": "subtitle", "time": 784.71, "timestamp": "00:13:04", "text": "私を見つけるかもしれないと思ったんです。"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "ああ、神様。 では、こちらのエリアへ向かいます"}, {"type": "subtitle", "time": 794.069, "timestamp": "00:13:14", "text": "他の人に見られたくない。"}, {"type": "subtitle", "time": 797.509, "timestamp": "00:13:17", "text": "叱られるから。 あなたはなぜここにいるのですか？"}, {"type": "subtitle", "time": 801.19, "timestamp": "00:13:21", "text": "そう、ここは最近"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "見つけた場所なんです。"}, {"type": "subtitle", "time": 806.31, "timestamp": "00:13:26", "text": "そして、"}, {"type": "subtitle", "time": 810.15, "timestamp": "00:13:30", "text": "そのエリアの向こう側には海が広がっている。 だから、ここなら"}, {"type": "subtitle", "time": 815.11, "timestamp": "00:13:35", "text": "渡れると思うんです。 しかし、"}, {"type": "subtitle", "time": 819.404, "timestamp": "00:13:39", "text": "ここには普段誰も来ない。 ええ、"}, {"type": "subtitle", "time": 823.11, "timestamp": "00:13:43", "text": "もし誰かがここにいたら、ええと、気まずい"}, {"type": "subtitle", "time": 825.59, "timestamp": "00:13:45", "text": "気まずいことになるでしょうね。"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "日没は過ぎてしまったけれど、ただ"}, {"type": "subtitle", "time": 830.629, "timestamp": "00:13:50", "text": "川岸に座って"}]
[{"type": "subtitle", "time": 9243.19, "timestamp": "02:34:03", "text": "カメラの時間を"}, {"type": "subtitle", "time": 9246.55, "timestamp": "02:34:06", "text": "スライダーかトグルで追加するときに、スライダーの"}, {"type": "subtitle", "time": 9250.309, "timestamp": "02:34:10", "text": "トグルはまだ高度な機能ではないんですが、"}, {"type": "subtitle", "time": 9257.91, "timestamp": "02:34:17", "text": "カメラのスライダーを追加するときに、手動コントロールも追加できますか"}, {"type": "subtitle", "time": 9261.83, "timestamp": "02:34:21", "text": "？ えっと、"}, {"type": "subtitle", "time": 9264.55, "timestamp": "02:34:24", "text": "ズームと露出を追加して、フォーカスをマニュアルフォーカスに追加し、"}, {"type": "subtitle", "time": 9269.19, "timestamp": "02:34:29", "text": "ホワイトバランスも追加したことは知っています。可能であれば、"}, {"type": "subtitle", "time": 9276.469, "timestamp": "02:34:36", "text": "オートゼロをオートにするか、"}, {"type": "subtitle", "time": 9279.51, "timestamp": "02:34:39", "text": "オートにするための小さなボタンなどを追加して、"}, {"type": "subtitle", "time": 9281.99, "timestamp": "02:34:41", "text": "0から"}, {"type": "subtitle", "time": 9284.63, "timestamp": "02:34:44", "text": "100までの範囲を維持できるようにしてください。"}, {"type": "subtitle", "time": 9286.79, "timestamp": "02:34:46", "text": "可能であれば、"}, {"type": "subtitle", "time": 9293.11, "timestamp": "02:34:53", "text": "うん。 うん。"}, {"type": "subtitle", "time": 9299.92, "timestamp": "02:34:59", "text": "。 捕まらなくて本当に良かった。 途中で止まってよかった"}]
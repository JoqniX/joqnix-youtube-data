[{"type": "chat", "time": 660.373, "timestamp": "00:11:00", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "is thy not too late already"}, {"type": "subtitle", "time": 670.79, "timestamp": "00:11:10", "text": "、準備はできました。   わかった"}, {"type": "subtitle", "time": 691.43, "timestamp": "00:11:31", "text": "ああ、彼女は今先生がいると思う"}, {"type": "subtitle", "time": 693.35, "timestamp": "00:11:33", "text": "。 昨日、彼女と話したばかりです"}, {"type": "subtitle", "time": 701.269, "timestamp": "00:11:41", "text": "私は横断歩道が渡るまで待つつもりだが、"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "彼女は私の言うことを聞かないだろう。"}, {"type": "subtitle", "time": 707.11, "timestamp": "00:11:47", "text": "彼女が自分の名前を口にしないことを願うばかりだ。"}, {"type": "subtitle", "time": 717.59, "timestamp": "00:11:57", "text": "ええ、彼女は別の先生と話しています"}]
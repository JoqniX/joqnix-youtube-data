[{"type": "subtitle", "time": 7322.87, "timestamp": "02:02:02", "text": "。 えっと、また戻ってきます。 私の配信は"}, {"type": "subtitle", "time": 7324.709, "timestamp": "02:02:04", "text": "再びライブ配信されていますか？"}, {"type": "subtitle", "time": 7326.79, "timestamp": "02:02:06", "text": "誰か私の声が聞こえますか？ お知らせ下さい。 私が"}, {"type": "subtitle", "time": 7329.83, "timestamp": "02:02:09", "text": "ライブ配信中かどうか、チャットで教えてください。"}, {"type": "subtitle", "time": 7332.87, "timestamp": "02:02:12", "text": "こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 7354.229, "timestamp": "02:02:34", "text": "ああ、あなたは大丈夫だ。 ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 7364.31, "timestamp": "02:02:44", "text": "フラッシュをオフにできると思います。"}, {"type": "subtitle", "time": 7366.31, "timestamp": "02:02:46", "text": "フラッシュをオフにしようかな。"}, {"type": "subtitle", "time": 7370.39, "timestamp": "02:02:50", "text": "トウモロコシをたくさん食べています。 ああ、フラッシュがオフになってる。 どうでも。   何てことだ"}]
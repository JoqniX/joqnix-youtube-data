[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "。"}, {"type": "subtitle", "time": 2103.75, "timestamp": "00:35:03", "text": "ああ、神様。 だから、たとえ"}, {"type": "subtitle", "time": 2110.71, "timestamp": "00:35:10", "text": "短時間でも早くここを離れなければならないと言ったんです"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "。ここはとても暗いので。"}, {"type": "subtitle", "time": 2116.55, "timestamp": "00:35:16", "text": "すごく暗い。"}, {"type": "subtitle", "time": 2127.67, "timestamp": "00:35:27", "text": "そうそう。 でも、砂浜があって砂もあるから、まるで"}, {"type": "subtitle", "time": 2129.99, "timestamp": "00:35:29", "text": "海がすぐそばにあるような気分になる。そういうのは"}, {"type": "subtitle", "time": 2136.95, "timestamp": "00:35:36", "text": "珍しい。 私はあのエリアの頂上まで登らなければならない"}, {"type": "subtitle", "time": 2138.589, "timestamp": "00:35:38", "text": "。"}, {"type": "subtitle", "time": 2139.19, "timestamp": "00:35:39", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 2141.91, "timestamp": "00:35:41", "text": "ああ、神様。 いいえ、"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "階段を上る必要はありません。 ええ、"}, {"type": "subtitle", "time": 2147.75, "timestamp": "00:35:47", "text": "誰にも見られないようにしないといけないんです。もし見られたら、"}, {"type": "subtitle", "time": 2149.829, "timestamp": "00:35:49", "text": "なぜ"}, {"type": "subtitle", "time": 2153.03, "timestamp": "00:35:53", "text": "ここに来たのかと疑問に思われるでしょうから。 立ち入り禁止区域です。   あれこれ"}, {"type": "subtitle", "time": 2154.95, "timestamp": "00:35:54", "text": "。"}]
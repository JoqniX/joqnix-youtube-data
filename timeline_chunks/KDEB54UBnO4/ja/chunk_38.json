[{"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "ああ、神様。 私の学校はお見せしません。"}, {"type": "subtitle", "time": 2299.91, "timestamp": "00:38:19", "text": "だから心配しないでください。"}, {"type": "subtitle", "time": 2309.43, "timestamp": "00:38:29", "text": "ここから自転車をどれくらい持ち出して、"}, {"type": "subtitle", "time": 2315.109, "timestamp": "00:38:35", "text": "誰にも見られる前にここからさっさと逃げ出せばいいんだ。"}, {"type": "subtitle", "time": 2318.39, "timestamp": "00:38:38", "text": "でも、本当に素敵なことですよね。   でも、本当に"}, {"type": "subtitle", "time": 2321.67, "timestamp": "00:38:41", "text": "素敵ですね。 うん。"}, {"type": "subtitle", "time": 2325.109, "timestamp": "00:38:45", "text": "ぼかしの力で、何も見えなくなる。"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "いいですね。 そうそう。"}, {"type": "subtitle", "time": 2330.71, "timestamp": "00:38:50", "text": "前回は私の生理周期が見えなかったよね？ ちなみに、これが"}, {"type": "subtitle", "time": 2338.55, "timestamp": "00:38:58", "text": "これが私の生理周期でした。"}]
[{"type": "subtitle", "time": 1622.63, "timestamp": "00:27:02", "text": "移動しましょう。 よし、じゃあ"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "みんなを"}, {"type": "subtitle", "time": 1628.39, "timestamp": "00:27:08", "text": "サイクリングに連れて行こうか。"}, {"type": "subtitle", "time": 1632.23, "timestamp": "00:27:12", "text": "それが可能なら、外に出ましょう。"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "だから、しばらくの間は、まあ、できる限りは。"}, {"type": "subtitle", "time": 1642.47, "timestamp": "00:27:22", "text": "番組で今問題になっているのは、外部マイクを持ってくるのを忘れたことです"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "。 でも、"}, {"type": "subtitle", "time": 1650.39, "timestamp": "00:27:30", "text": "えっと、皆さんと話す一番良い方法は、なんて"}, {"type": "subtitle", "time": 1654.149, "timestamp": "00:27:34", "text": "言うんでしょう？ 例えば、私が"}, {"type": "subtitle", "time": 1660.789, "timestamp": "00:27:40", "text": "自転車に乗っているシーンを入れることができます。 私はあまり話せません。   それから、"}, {"type": "subtitle", "time": 1665.43, "timestamp": "00:27:45", "text": "生理が終わったら、"}, {"type": "subtitle", "time": 1667.99, "timestamp": "00:27:47", "text": "みんなを散歩に連れて行ったり"}, {"type": "subtitle", "time": 1670.39, "timestamp": "00:27:50", "text": "、体を"}, {"type": "subtitle", "time": 1674.07, "timestamp": "00:27:54", "text": "動かしたりできると思うよ。 おそらくできると思います"}, {"type": "subtitle", "time": 1676.63, "timestamp": "00:27:56", "text": "。   やったぞ"}]
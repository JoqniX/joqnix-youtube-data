[{"type": "subtitle", "time": 1440.63, "timestamp": "00:24:00", "text": "つまり、ここに誰がいるのか文字通り見ることができるんです"}, {"type": "subtitle", "time": 1445.43, "timestamp": "00:24:05", "text": "。 もし向こうの"}, {"type": "subtitle", "time": 1449.029, "timestamp": "00:24:09", "text": "人たちが"}, {"type": "subtitle", "time": 1451.029, "timestamp": "00:24:11", "text": "私を見たら、"}, {"type": "subtitle", "time": 1453.11, "timestamp": "00:24:13", "text": "「この人は何をしているんだ"}, {"type": "subtitle", "time": 1459.59, "timestamp": "00:24:19", "text": "はい、"}, {"type": "subtitle", "time": 1464.586, "timestamp": "00:24:24", "text": "父がちょうど帰ってきました。 おかえり。"}, {"type": "subtitle", "time": 1473.83, "timestamp": "00:24:33", "text": "？"}, {"type": "subtitle", "time": 1476.23, "timestamp": "00:24:36", "text": "あなたの一日はどうでした？"}, {"type": "subtitle", "time": 1494.149, "timestamp": "00:24:54", "text": "リンゴジュースだよ。 ご覧のとおり、私は音楽に関してはほんの一部しか持っていません"}, {"type": "subtitle", "time": 1496.39, "timestamp": "00:24:56", "text": "。 ほんの少しだけ"}]
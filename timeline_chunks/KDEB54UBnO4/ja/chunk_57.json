[{"type": "subtitle", "time": 3430.069, "timestamp": "00:57:10", "text": "えっと、それは逆さまですよ。"}, {"type": "subtitle", "time": 3432.47, "timestamp": "00:57:12", "text": "でも待って、料理させて。"}, {"type": "subtitle", "time": 3437.19, "timestamp": "00:57:17", "text": "でも、これを締め付けたらどうなるだろう？"}, {"type": "subtitle", "time": 3441.349, "timestamp": "00:57:21", "text": "いや、これはむしろ重みを増すことになるだろう。   ああ、なんてことだ。"}, {"type": "subtitle", "time": 3447.99, "timestamp": "00:57:27", "text": "ああ、くそ。 危うく自分で減点するところだった。   わかった"}, {"type": "subtitle", "time": 3451.27, "timestamp": "00:57:31", "text": "。 ああ、じゃあ"}]
[{"type": "subtitle", "time": 13561.269, "timestamp": "03:46:01", "text": "将来的に"}, {"type": "subtitle", "time": 13563.91, "timestamp": "03:46:03", "text": "サイクルストリームのフレームに投資しようと考えているものの一つは、"}, {"type": "subtitle", "time": 13568.63, "timestamp": "03:46:08", "text": "傘みたいなものを買おうと思っているんです。"}, {"type": "subtitle", "time": 13580.63, "timestamp": "03:46:20", "text": "私は橋の下にいました。 私たちはサイクリングに行った。"}, {"type": "subtitle", "time": 13615.51, "timestamp": "03:46:55", "text": "Bridge。 橋の日本語は何でしたっけ"}]
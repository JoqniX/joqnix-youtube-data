[{"type": "subtitle", "time": 1507.83, "timestamp": "00:25:07", "text": "スタジアムは、おそらくクラブ活動のようなものを運営しているのだと思います"}, {"type": "subtitle", "time": 1514.31, "timestamp": "00:25:14", "text": "。 だから彼らはあちらのスタジアムを使うんだ"}, {"type": "subtitle", "time": 1515.75, "timestamp": "00:25:15", "text": "。 あちらの方です。 音楽って、わかる"}, {"type": "subtitle", "time": 1517.99, "timestamp": "00:25:17", "text": "？"}, {"type": "subtitle", "time": 1520.47, "timestamp": "00:25:20", "text": "でも、あそこにあるのは"}, {"type": "subtitle", "time": 1545.35, "timestamp": "00:25:45", "text": "君たちを"}, {"type": "subtitle", "time": 1553.029, "timestamp": "00:25:53", "text": "そのためには、"}, {"type": "subtitle", "time": 1557.11, "timestamp": "00:25:57", "text": "機材が直立したままで、"}]
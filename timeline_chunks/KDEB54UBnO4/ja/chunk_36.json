[{"type": "subtitle", "time": 2162.31, "timestamp": "00:36:02", "text": "フォローしていただきありがとうございます。"}, {"type": "subtitle", "time": 2165.829, "timestamp": "00:36:05", "text": "待って、どこを追跡したの？"}, {"type": "subtitle", "time": 2170.47, "timestamp": "00:36:10", "text": "Kickでフォローしていただきありがとうございます。"}, {"type": "subtitle", "time": 2173.829, "timestamp": "00:36:13", "text": "どうもありがとう。"}, {"type": "subtitle", "time": 2176.87, "timestamp": "00:36:16", "text": "キックの視聴者はほとんどいない"}, {"type": "subtitle", "time": 2181.109, "timestamp": "00:36:21", "text": "けど、そう、でも私はいつもキックのためにマルチリームしている"}, {"type": "subtitle", "time": 2188.55, "timestamp": "00:36:28", "text": "、改めてありがとうございました。   えっと、"}, {"type": "subtitle", "time": 2194.47, "timestamp": "00:36:34", "text": "誰もいないことを確認しないと。ああ、神様、"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "私はクレイジーなことをしている、私はクレイジーなことをしている、私は"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "先生に会う可能性があると思う。"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "先生方に会える可能性もある。"}]
[{"type": "subtitle", "time": 5400.87, "timestamp": "01:30:00", "text": "くそっ。 私、漏らしたの？ そうだったっけ？ くそ。 くそ。"}, {"type": "subtitle", "time": 5404.87, "timestamp": "01:30:04", "text": "私は自分の顔を晒してしまったのだろうか？ くそっ。"}, {"type": "subtitle", "time": 5406.719, "timestamp": "01:30:06", "text": "くそっ。 ああ、くそ。"}, {"type": "subtitle", "time": 5410.0, "timestamp": "01:30:10", "text": "ああ、くそ。 待って。 何かあったの？ ああ、神様。"}, {"type": "subtitle", "time": 5412.327, "timestamp": "01:30:12", "text": "待って。 何かあったの？ ああ、神様。 [咳払い]"}, {"type": "subtitle", "time": 5413.12, "timestamp": "01:30:13", "text": "[咳払い] くそっ。   えっと。"}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "ジョー、行って。   ごめん"}, {"type": "subtitle", "time": 5458.31, "timestamp": "01:30:58", "text": "調べてみる必要がある。 何時でしたか"}]
[{"type": "subtitle", "time": 12961.67, "timestamp": "03:36:01", "text": "。 そちらの方が安定していた。 しかし、"}, {"type": "subtitle", "time": 12967.99, "timestamp": "03:36:07", "text": "森林サイクリングエリアなどのでこぼこした地形では、"}, {"type": "subtitle", "time": 12978.95, "timestamp": "03:36:18", "text": "締め付けても外れてしまうほど非常にでこぼこしていることに気づきました"}, {"type": "subtitle", "time": 12981.429, "timestamp": "03:36:21", "text": "。 ええと、それで、"}, {"type": "subtitle", "time": 12988.229, "timestamp": "03:36:28", "text": "将来的に自分に何ができるか考えてみようと思います。 とりあえず、今はこれで進めていきます"}, {"type": "subtitle", "time": 12991.99, "timestamp": "03:36:31", "text": "。 えっと、将来的に"}, {"type": "subtitle", "time": 12995.75, "timestamp": "03:36:35", "text": "傘とか自転車の"}, {"type": "subtitle", "time": 12998.07, "timestamp": "03:36:38", "text": "傘ホルダーの"}, {"type": "subtitle", "time": 12999.67, "timestamp": "03:36:39", "text": "アームを買って、"}, {"type": "subtitle", "time": 13004.309, "timestamp": "03:36:44", "text": "それを何とかして使うかもしれません。"}, {"type": "subtitle", "time": 13006.79, "timestamp": "03:36:46", "text": "それがどういう仕組みになるかはわかりませんが、"}, {"type": "subtitle", "time": 13009.19, "timestamp": "03:36:49", "text": "クランプが必要だと思います"}, {"type": "subtitle", "time": 13011.99, "timestamp": "03:36:51", "text": "。"}]
[{"type": "subtitle", "time": 8046.95, "timestamp": "02:14:06", "text": "もしお金があったら、"}, {"type": "subtitle", "time": 8050.31, "timestamp": "02:14:10", "text": "君たちをラーメン屋に連れて行って、"}, {"type": "subtitle", "time": 8058.87, "timestamp": "02:14:18", "text": "次回。 次があるさ。"}, {"type": "subtitle", "time": 8060.79, "timestamp": "02:14:20", "text": "覚えておいてください、"}, {"type": "subtitle", "time": 8062.39, "timestamp": "02:14:22", "text": "屋外の小川は"}, {"type": "subtitle", "time": 8064.39, "timestamp": "02:14:24", "text": "冒険のようなものです。 何てことだ。 もう少しで"}, {"type": "subtitle", "time": 8067.189, "timestamp": "02:14:27", "text": "同じボードに当たるところだった。 屋外の小川は、"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "待って、ダイソーに着いた。 何？"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "M　今ダイソーに着きました。 待って、"}, {"type": "subtitle", "time": 8079.43, "timestamp": "02:14:39", "text": "スマホスタンドを探した方がいいかな？"}, {"type": "subtitle", "time": 8082.47, "timestamp": "02:14:42", "text": "待って、ダイソーに着いた。"}, {"type": "subtitle", "time": 8085.91, "timestamp": "02:14:45", "text": "え、何？突然"}, {"type": "subtitle", "time": 8088.149, "timestamp": "02:14:48", "text": "ダイソーに着いた。"}, {"type": "subtitle", "time": 8090.229, "timestamp": "02:14:50", "text": "待って、"}, {"type": "subtitle", "time": 8093.35, "timestamp": "02:14:53", "text": "待って。 私は"}]
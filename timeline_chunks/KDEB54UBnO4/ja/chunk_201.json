[{"type": "subtitle", "time": 12066.55, "timestamp": "03:21:06", "text": "ここは私がよくくつろぎに来る場所です"}, {"type": "subtitle", "time": 12068.469, "timestamp": "03:21:08", "text": "。"}, {"type": "subtitle", "time": 12071.91, "timestamp": "03:21:11", "text": "じゃあ、少し休憩しよう。 わかった。 よく"}, {"type": "subtitle", "time": 12075.11, "timestamp": "03:21:15", "text": "自転車に乗るので、"}, {"type": "subtitle", "time": 12093.269, "timestamp": "03:21:33", "text": "考えがある。"}, {"type": "subtitle", "time": 12095.51, "timestamp": "03:21:35", "text": "反対側まで行けばタイヤを洗える。"}, {"type": "subtitle", "time": 12099.429, "timestamp": "03:21:39", "text": "でも、そうします。"}, {"type": "subtitle", "time": 12101.83, "timestamp": "03:21:41", "text": "別の動画のためにそうする方がいい。 実は、"}]
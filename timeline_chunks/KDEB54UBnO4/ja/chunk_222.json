[{"type": "subtitle", "time": 13320.79, "timestamp": "03:42:00", "text": "。 私は何でも聞いていいんですよね"}, {"type": "subtitle", "time": 13323.67, "timestamp": "03:42:03", "text": "？ あらゆる種類のチャット。"}, {"type": "subtitle", "time": 13326.07, "timestamp": "03:42:06", "text": "あの、"}, {"type": "subtitle", "time": 13329.11, "timestamp": "03:42:09", "text": "ラテン語はご存知ですか？"}, {"type": "subtitle", "time": 13333.323, "timestamp": "03:42:13", "text": "えーと、じゃあ、他に誰がいるかな？ えっと、"}, {"type": "subtitle", "time": 13336.309, "timestamp": "03:42:16", "text": "[鼻を鳴らす] Shadow 7622 さんが来てくれました。Twitch"}, {"type": "subtitle", "time": 13339.429, "timestamp": "03:42:19", "text": "でフォローしてくれてありがとう。 どうもありがとう"}, {"type": "subtitle", "time": 13343.51, "timestamp": "03:42:23", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 13346.469, "timestamp": "03:42:26", "text": "えーと、"}, {"type": "subtitle", "time": 13348.389, "timestamp": "03:42:28", "text": "あなたの名前が読めません。 あなたの"}, {"type": "subtitle", "time": 13350.309, "timestamp": "03:42:30", "text": "名前はロシア語だと思います。 お越しいただきありがとうございます"}, {"type": "subtitle", "time": 13357.51, "timestamp": "03:42:37", "text": "あなたは今もストリーミング配信をしている。 ああ、"}, {"type": "subtitle", "time": 13360.469, "timestamp": "03:42:40", "text": "コナダを終わらせるつもりだ。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 13363.59, "timestamp": "03:42:43", "text": "クリップランキングの"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "リセットタイマーを少なくとも1週間に更新するよう求める請願。 待って、"}, {"type": "subtitle", "time": 13370.63, "timestamp": "03:42:50", "text": "クリップリーダーボードって何？"}, {"type": "subtitle", "time": 13373.67, "timestamp": "03:42:53", "text": "待って、クリップのランキングがあるよ。"}, {"type": "subtitle", "time": 13375.99, "timestamp": "03:42:55", "text": "よし、"}, {"type": "subtitle", "time": 13378.07, "timestamp": "03:42:58", "text": "1週間以上かけてやろう。  1ヶ月くらいかな"}]
[{"type": "subtitle", "time": 1680.47, "timestamp": "00:28:00", "text": "。"}, {"type": "subtitle", "time": 1683.43, "timestamp": "00:28:03", "text": "もし今日皆さんがそれを望むなら、教えてください"}, {"type": "subtitle", "time": 1685.51, "timestamp": "00:28:05", "text": "。 でも、まあ、ただのんびりしてるだけだよ。今日はただ"}, {"type": "subtitle", "time": 1689.029, "timestamp": "00:28:09", "text": "のんびりしてるだけ。"}, {"type": "subtitle", "time": 1691.99, "timestamp": "00:28:11", "text": "今日はただのんびりしてるだけ。"}, {"type": "subtitle", "time": 1695.59, "timestamp": "00:28:15", "text": "マイクを持っていくのを忘れた。 私は"}, {"type": "subtitle", "time": 1697.669, "timestamp": "00:28:17", "text": "全て持ち去った。 予備のモバイル"}, {"type": "subtitle", "time": 1701.029, "timestamp": "00:28:21", "text": "バッテリー、予備の充電器、USBケーブル、"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "その他諸々を持っていきました。 外付けライトを持っていくのを忘れてしまった"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "。"}, {"type": "subtitle", "time": 1707.909, "timestamp": "00:28:27", "text": "あなたはどこの国にいますか？ 日本。 私は"}, {"type": "subtitle", "time": 1709.83, "timestamp": "00:28:29", "text": "現在、語学"}, {"type": "subtitle", "time": 1712.789, "timestamp": "00:28:32", "text": "交換留学生として日本に滞在しています。"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "私は"}, {"type": "subtitle", "time": 1718.389, "timestamp": "00:28:38", "text": "語学学習者としてここにいます。"}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "日出ずる国、時刻は午後"}, {"type": "subtitle", "time": 1736.549, "timestamp": "00:28:56", "text": "6時。 そしてもう"}]
[{"type": "subtitle", "time": 12842.71, "timestamp": "03:34:02", "text": "、"}, {"type": "subtitle", "time": 12845.19, "timestamp": "03:34:05", "text": "全体的に見て、今日は何か特別な日でした。"}, {"type": "subtitle", "time": 12850.469, "timestamp": "03:34:10", "text": "結局、"}, {"type": "subtitle", "time": 12853.91, "timestamp": "03:34:13", "text": "Kから10キロくらいずっと自転車で走って、高速"}, {"type": "subtitle", "time": 12858.15, "timestamp": "03:34:18", "text": "道路とかを走ったんだ。"}, {"type": "subtitle", "time": 12861.67, "timestamp": "03:34:21", "text": "とても良かったです。 今日は私たちにとって馴染みのある出来事だった"}, {"type": "subtitle", "time": 12863.91, "timestamp": "03:34:23", "text": "。"}, {"type": "subtitle", "time": 12865.83, "timestamp": "03:34:25", "text": "そして"}, {"type": "subtitle", "time": 12877.269, "timestamp": "03:34:37", "text": "ありがとうございました。"}, {"type": "subtitle", "time": 12881.19, "timestamp": "03:34:41", "text": "それは私にとってかけがえのないものです。"}, {"type": "subtitle", "time": 12884.79, "timestamp": "03:34:44", "text": "そして、配信が"}, {"type": "subtitle", "time": 12887.11, "timestamp": "03:34:47", "text": "耐えられるものであったことを願っています。というのも、"}, {"type": "subtitle", "time": 12890.87, "timestamp": "03:34:50", "text": "いろいろと問題があったからです。"}, {"type": "subtitle", "time": 12893.19, "timestamp": "03:34:53", "text": "ええ、配信にいろいろと問題がありました"}, {"type": "subtitle", "time": 12895.349, "timestamp": "03:34:55", "text": "。"}, {"type": "subtitle", "time": 12898.71, "timestamp": "03:34:58", "text": "ああ、ああ、"}]
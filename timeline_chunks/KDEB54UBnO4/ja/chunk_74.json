[{"type": "subtitle", "time": 4441.35, "timestamp": "01:14:01", "text": "多くのサイクリストがここに集まっている"}, {"type": "subtitle", "time": 4443.03, "timestamp": "01:14:03", "text": "。  [音楽]"}, {"type": "subtitle", "time": 4445.35, "timestamp": "01:14:05", "text": "私が行く場所では、私の記憶が正しければ、"}, {"type": "subtitle", "time": 4450.149, "timestamp": "01:14:10", "text": "信号が弱かったため、そこからストリーミングすることはできませんでした。   だから"}, {"type": "subtitle", "time": 4455.51, "timestamp": "01:14:15", "text": "それは私が非常に注意すべきことなので、"}]
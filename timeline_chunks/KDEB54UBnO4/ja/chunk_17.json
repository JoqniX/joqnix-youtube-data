[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "、とても風が強かったです。   ああ"}, {"type": "subtitle", "time": 1025.27, "timestamp": "00:17:05", "text": "、なんて風が強いんだ。"}, {"type": "subtitle", "time": 1028.069, "timestamp": "00:17:08", "text": "あれ、コウモリじゃないか？"}, {"type": "subtitle", "time": 1035.029, "timestamp": "00:17:15", "text": "殻を破りつつある。"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "それは小さなコウモリだ。"}, {"type": "subtitle", "time": 1040.87, "timestamp": "00:17:20", "text": "彼は飛び去った。"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "ええ、ここは私が"}, {"type": "subtitle", "time": 1049.99, "timestamp": "00:17:29", "text": "私はこの岩の上に座って、"}, {"type": "subtitle", "time": 1053.75, "timestamp": "00:17:33", "text": "ここでゆっくりしようと思う。"}, {"type": "subtitle", "time": 1058.07, "timestamp": "00:17:38", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 1060.31, "timestamp": "00:17:40", "text": "靴を濡らさないように気をつけてください。"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "あれはカラスの[ __ ]ですか"}, {"type": "subtitle", "time": 1065.27, "timestamp": "00:17:45", "text": "？ 鳥の[ __ ]。"}, {"type": "subtitle", "time": 1068.07, "timestamp": "00:17:48", "text": "それは最近のことではない。 その番組。"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "タバコの吸い殻がある。 それを使って"}, {"type": "subtitle", "time": 1078.39, "timestamp": "00:17:58", "text": "掃除します。 ああ、神様。   一体"}]
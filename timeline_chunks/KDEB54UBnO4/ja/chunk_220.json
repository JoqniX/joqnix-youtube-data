[{"type": "subtitle", "time": 13204.229, "timestamp": "03:40:04", "text": "ライブストリーミングに使っているアプリの新しいリブランディングと、"}, {"type": "subtitle", "time": 13206.469, "timestamp": "03:40:06", "text": "追加される新機能、バグ"}, {"type": "subtitle", "time": 13209.59, "timestamp": "03:40:09", "text": "修正が待ち遠しいです。 楽しみです。"}, {"type": "subtitle", "time": 13214.79, "timestamp": "03:40:14", "text": "お越しいただきありがとうございます。 ゴジ板息子ラディラディラ"}, {"type": "subtitle", "time": 13217.349, "timestamp": "03:40:17", "text": "ディラディット公式息子。 お越しいただき、お話してくださりありがとうございます。"}, {"type": "subtitle", "time": 13222.87, "timestamp": "03:40:22", "text": "コンステラーズへようこそ。"}, {"type": "subtitle", "time": 13228.71, "timestamp": "03:40:28", "text": "Kickから私と交流してくれてありがとう。 ありがとう。 それでは、カリ・"}, {"type": "subtitle", "time": 13231.349, "timestamp": "03:40:31", "text": "サンさん、来てくれてありがとう。 クナダサンさん、"}, {"type": "subtitle", "time": 13234.229, "timestamp": "03:40:34", "text": "お越しいただきありがとうございます。そして、"}, {"type": "subtitle", "time": 13238.229, "timestamp": "03:40:38", "text": "ディーランさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 13243.03, "timestamp": "03:40:43", "text": "耳に音声合成機能を搭載してみませんか？ えっと"}, {"type": "subtitle", "time": 13248.95, "timestamp": "03:40:48", "text": "、Paradaxがブラウザソース"}, {"type": "subtitle", "time": 13250.55, "timestamp": "03:40:50", "text": "機能"}, {"type": "subtitle", "time": 13254.229, "timestamp": "03:40:54", "text": "か何かを追加するまで待たないといけないですね。 確認する必要があるのですが、"}, {"type": "subtitle", "time": 13257.51, "timestamp": "03:40:57", "text": "あなたが聞いているかどうかわかりませんが、"}]
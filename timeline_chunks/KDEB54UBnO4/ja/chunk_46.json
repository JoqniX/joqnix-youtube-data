[{"type": "subtitle", "time": 2762.309, "timestamp": "00:46:02", "text": "ショックアブソーバー付きの"}, {"type": "subtitle", "time": 2764.79, "timestamp": "00:46:04", "text": "三脚か何かが本当に必要なんです。 スタビライザーマン。"}, {"type": "subtitle", "time": 2800.309, "timestamp": "00:46:40", "text": "ここはラーメン屋さんです。 私はいつも"}, {"type": "subtitle", "time": 2803.349, "timestamp": "00:46:43", "text": "ラーメンを食べに行きます。 ここは本当に安い"}]
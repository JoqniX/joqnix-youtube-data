[{"type": "subtitle", "time": 8701.765, "timestamp": "02:25:01", "text": "なぜパラドックスなのか？"}, {"type": "subtitle", "time": 8708.63, "timestamp": "02:25:08", "text": "Paradillax はパドルスペースを思い出させます。   あの"}, {"type": "subtitle", "time": 8710.87, "timestamp": "02:25:10", "text": "dwell"}, {"type": "subtitle", "time": 8713.11, "timestamp": "02:25:13", "text": "アプリのことね。"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "かなりの人数ですね。 なぜ彼らは"}, {"type": "subtitle", "time": 8728.87, "timestamp": "02:25:28", "text": "ここで私を見ているのだろう？"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "顔に何か付いていますか？ いいえ。私が"}, {"type": "subtitle", "time": 8734.309, "timestamp": "02:25:34", "text": "外国人だからですか？"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "ええ、でもこれって5kgですよね？"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "なぜ「パラドックス」という名前をつけたのか、あなたの考えを聞かせてください。"}, {"type": "chat", "time": 8756.433, "timestamp": "02:25:56", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "I like the name, there's a song I like with the same name, and the meaning makes sense for the app"}]
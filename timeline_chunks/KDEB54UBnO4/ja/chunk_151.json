[{"type": "subtitle", "time": 9060.55, "timestamp": "02:31:00", "text": "料金はいくらですか？  50％。 わかった。 モバイル"}, {"type": "subtitle", "time": 9071.19, "timestamp": "02:31:11", "text": "また、アリタ、何というか、"}, {"type": "subtitle", "time": 9080.55, "timestamp": "02:31:20", "text": "負荷が大きすぎたのかもしれませんが、"}, {"type": "subtitle", "time": 9087.99, "timestamp": "02:31:27", "text": "ライブ配信を終了した時に、"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "赤信号を通過したのですが、アプリが"}, {"type": "subtitle", "time": 9101.429, "timestamp": "02:31:41", "text": "大きすぎたのか何かで、アプリが停止してしまいました。"}, {"type": "subtitle", "time": 9104.95, "timestamp": "02:31:44", "text": "今、私のCharモバイルバッテリーを置いたら、"}, {"type": "subtitle", "time": 9108.469, "timestamp": "02:31:48", "text": "緑色の急速充電モードになっていました。 そして、"}, {"type": "subtitle", "time": 9111.19, "timestamp": "02:31:51", "text": "Whisperアプリと"}, {"type": "subtitle", "time": 9116.07, "timestamp": "02:31:56", "text": "Googleマップアプリを閉じると、"}, {"type": "subtitle", "time": 9119.59, "timestamp": "02:31:59", "text": "オレンジ色、"}]
[{"type": "subtitle", "time": 7988.39, "timestamp": "02:13:08", "text": "待って、昨日エリアイベントに到達したと思うんだけど"}, {"type": "subtitle", "time": 7991.27, "timestamp": "02:13:11", "text": "。"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "待って、これって同じエリアなの？"}, {"type": "subtitle", "time": 7996.149, "timestamp": "02:13:16", "text": "待って、それは別の地域だと思う。"}, {"type": "subtitle", "time": 8008.149, "timestamp": "02:13:28", "text": "これらのいくつかは見たことがあるような気がします。 もしかしたら、ここは"}, {"type": "subtitle", "time": 8010.55, "timestamp": "02:13:30", "text": "別の地域かもしれません。   わからない"}]
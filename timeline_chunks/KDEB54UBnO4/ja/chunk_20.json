[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "いいえ、モンスターはいますよ。"}, {"type": "subtitle", "time": 1204.47, "timestamp": "00:20:04", "text": "白いモンスターコイン。"}, {"type": "subtitle", "time": 1237.75, "timestamp": "00:20:37", "text": "これは私が使っている三脚です。"}, {"type": "subtitle", "time": 1243.75, "timestamp": "00:20:43", "text": "モバイルバッテリーを持ちながらこれをどう使うのか全く見当もつかない"}, {"type": "subtitle", "time": 1247.11, "timestamp": "00:20:47", "text": "けど、まあいいか。"}]
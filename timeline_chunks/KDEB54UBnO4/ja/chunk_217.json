[{"type": "subtitle", "time": 13023.75, "timestamp": "03:37:03", "text": "[ため息]"}, {"type": "subtitle", "time": 13027.03, "timestamp": "03:37:07", "text": "今日は大変な一日だった。"}, {"type": "subtitle", "time": 13037.11, "timestamp": "03:37:17", "text": "配信はどうでしたか？"}, {"type": "subtitle", "time": 13040.469, "timestamp": "03:37:20", "text": "私は1014本の"}, {"type": "subtitle", "time": 13045.67, "timestamp": "03:37:25", "text": "動画と大量の音声ファイルを投稿しました。 うん。 あれ。"}, {"type": "subtitle", "time": 13053.59, "timestamp": "03:37:33", "text": "フレームレートが大幅に低下しました。"}, {"type": "subtitle", "time": 13055.99, "timestamp": "03:37:35", "text": "接続詞。"}, {"type": "subtitle", "time": 13057.67, "timestamp": "03:37:37", "text": "さあ、行って。"}, {"type": "subtitle", "time": 13060.71, "timestamp": "03:37:40", "text": "何かエラーはありましたか？ エラーはありません。 それは"}, {"type": "subtitle", "time": 13066.07, "timestamp": "03:37:46", "text": "良い改善だ。 エラーはゼロでした。"}, {"type": "subtitle", "time": 13068.07, "timestamp": "03:37:48", "text": "クレイジー。"}, {"type": "subtitle", "time": 13071.03, "timestamp": "03:37:51", "text": "そんなものを見るのは初めてだ。"}, {"type": "subtitle", "time": 13076.79, "timestamp": "03:37:56", "text": "今日の配信ではエラーは一切ありませんでした。"}]
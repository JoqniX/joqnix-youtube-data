[{"type": "subtitle", "time": 6060.07, "timestamp": "01:41:00", "text": "スマホがしょっちゅう落ちる。 今すぐ全員殺したい"}, {"type": "subtitle", "time": 6079.669, "timestamp": "01:41:19", "text": "[音楽]"}, {"type": "subtitle", "time": 6084.07, "timestamp": "01:41:24", "text": "私はたくさん悪態をついています。 ごめん。 えっと、結局、全く"}, {"type": "subtitle", "time": 6088.39, "timestamp": "01:41:28", "text": "準備していなかった場所を探検することになって、道に迷ってしまったんです"}, {"type": "subtitle", "time": 6091.43, "timestamp": "01:41:31", "text": "。   ちくしょう"}, {"type": "subtitle", "time": 6098.31, "timestamp": "01:41:38", "text": "そして夜になった。 私は"}, {"type": "subtitle", "time": 6103.669, "timestamp": "01:41:43", "text": "保護ライトのようなサイクリング用品すら持っていません。   あれこれ"}, {"type": "subtitle", "time": 6117.189, "timestamp": "01:41:57", "text": "なぜ私は…ほら、できた。 なぜ私は"}]
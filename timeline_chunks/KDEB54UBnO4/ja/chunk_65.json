[{"type": "subtitle", "time": 3900.549, "timestamp": "01:05:00", "text": "どういうことだ？"}, {"type": "subtitle", "time": 3903.27, "timestamp": "01:05:03", "text": "ええ、幹線道路を通って"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "ギアを下げます。"}, {"type": "subtitle", "time": 3921.829, "timestamp": "01:05:21", "text": "サイコパスになるのは難しい。"}, {"type": "subtitle", "time": 3943.029, "timestamp": "01:05:43", "text": "女性が"}, {"type": "subtitle", "time": 3946.95, "timestamp": "01:05:46", "text": "タバコを吸っていたのですが、それは"}, {"type": "subtitle", "time": 3953.19, "timestamp": "01:05:53", "text": "許可されています。 私は少し微笑んだ。"}, {"type": "subtitle", "time": 3955.51, "timestamp": "01:05:55", "text": "彼女が私のことを認識できたかどうかは分かりません。"}, {"type": "subtitle", "time": 3957.75, "timestamp": "01:05:57", "text": "表情がない。"}]
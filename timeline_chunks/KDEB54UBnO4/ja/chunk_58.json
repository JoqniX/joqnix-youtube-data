[{"type": "subtitle", "time": 3483.19, "timestamp": "00:58:03", "text": "モバイルバッテリーを"}, {"type": "subtitle", "time": 3487.109, "timestamp": "00:58:07", "text": "充電しないといけないんです。 よし、これでうまくいくはずだ。 はぁ？"}, {"type": "subtitle", "time": 3489.349, "timestamp": "00:58:09", "text": "なぜ音楽は急速充電されるのですか？"}, {"type": "subtitle", "time": 3499.109, "timestamp": "00:58:19", "text": "ねえ、"}, {"type": "subtitle", "time": 3501.67, "timestamp": "00:58:21", "text": "2026年に急速充電が必要な人なんているの？"}, {"type": "subtitle", "time": 3508.39, "timestamp": "00:58:28", "text": "ねえ、どうしてそうなってるの？ 待って、"}, {"type": "subtitle", "time": 3516.069, "timestamp": "00:58:36", "text": "いいえ。超高速でお願いします。"}, {"type": "subtitle", "time": 3519.67, "timestamp": "00:58:39", "text": "このスマホは超高速処理なしでは生き残れない"}, {"type": "subtitle", "time": 3524.47, "timestamp": "00:58:44", "text": "。 取引成立。 何てことだ。"}, {"type": "subtitle", "time": 3531.99, "timestamp": "00:58:51", "text": "お願い、お願い、お願い、[音楽] お願い。"}, {"type": "subtitle", "time": 3535.91, "timestamp": "00:58:55", "text": "俺は何をしたんだ？"}]
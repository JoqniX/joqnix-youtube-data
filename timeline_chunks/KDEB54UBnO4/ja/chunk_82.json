[{"type": "subtitle", "time": 4922.229, "timestamp": "01:22:02", "text": "川底の反対側の右側に手が届きそうな気がする"}, {"type": "subtitle", "time": 4925.189, "timestamp": "01:22:05", "text": "。 今の見た？"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "今夜、ジョギングをしている人たちがいる。"}, {"type": "subtitle", "time": 4931.35, "timestamp": "01:22:11", "text": "文字通りの暗闇。"}, {"type": "subtitle", "time": 4946.31, "timestamp": "01:22:26", "text": "一人は犬の散歩に来た。 私の犬を見てください"}]
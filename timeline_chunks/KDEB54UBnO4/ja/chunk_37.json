[{"type": "subtitle", "time": 2229.589, "timestamp": "00:37:09", "text": "もし彼らに聞かれたら、マイクをミュートにするだけです。   もし聞かれたら"}, {"type": "subtitle", "time": 2232.63, "timestamp": "00:37:12", "text": "、"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "マイクをミュートにして、何か言い訳をするだけです。 あ、待って。"}, {"type": "subtitle", "time": 2240.47, "timestamp": "00:37:20", "text": "彼らは私の三脚を見るだろう。   だから"}, {"type": "subtitle", "time": 2242.735, "timestamp": "00:37:22", "text": "、嘘はつけない。"}, {"type": "subtitle", "time": 2249.03, "timestamp": "00:37:29", "text": "でも、私の三脚は見えるだろうね。   ということで、しばらくの間"}]
[{"type": "subtitle", "time": 844.15, "timestamp": "00:14:04", "text": "ええと、ここはここはここです。"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "ここには誰もいない。"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "俺は橋の下にいるんだよ、兄弟。 私は"}, {"type": "subtitle", "time": 852.55, "timestamp": "00:14:12", "text": "橋の下にいます。"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "えっと、"}, {"type": "subtitle", "time": 862.23, "timestamp": "00:14:22", "text": "私が何かを変えたんです。 えっと、"}, {"type": "subtitle", "time": 864.79, "timestamp": "00:14:24", "text": "スライダーをロックする機能を作る必要があります。"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "岩とかがたくさんある。 気をつけなければならない"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "。 そして、現時点ではここには誰もいません"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "。"}, {"type": "subtitle", "time": 881.91, "timestamp": "00:14:41", "text": "えっと、"}, {"type": "subtitle", "time": 883.67, "timestamp": "00:14:43", "text": "もし誰かがこの辺りで何か怪しいことをしていたら邪魔にならないといいんだけど、"}, {"type": "subtitle", "time": 886.89, "timestamp": "00:14:46", "text": "この辺りにはあまり"}, {"type": "subtitle", "time": 890.31, "timestamp": "00:14:50", "text": "人がいないから。"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "遅くなる前にここから出ないと。だって、"}]
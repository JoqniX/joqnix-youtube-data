[{"type": "subtitle", "time": 7147.43, "timestamp": "01:59:07", "text": "超高速充電に対応していないので、ストリームを再開しなければならない可能性がわずかにあります。 だから、"}, {"type": "subtitle", "time": 7150.709, "timestamp": "01:59:10", "text": "ストリーミングを再開する必要があるかもしれない。 だから私は"}, {"type": "subtitle", "time": 7156.31, "timestamp": "01:59:16", "text": "「ああ、再起動するまでしっかり掴まっててね」と言ったんです。"}, {"type": "subtitle", "time": 7159.75, "timestamp": "01:59:19", "text": "ああ、やっと高速"}, {"type": "subtitle", "time": 7170.07, "timestamp": "01:59:30", "text": "えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 7173.27, "timestamp": "01:59:33", "text": "。   そうそう"}, {"type": "subtitle", "time": 7178.07, "timestamp": "01:59:38", "text": "。 月がとても綺麗だ。 このエリアを見てください"}, {"type": "subtitle", "time": 7179.91, "timestamp": "01:59:39", "text": "。"}, {"type": "subtitle", "time": 7182.629, "timestamp": "01:59:42", "text": "とても美しい。"}, {"type": "subtitle", "time": 7185.99, "timestamp": "01:59:45", "text": "すごくかっこいい。"}, {"type": "subtitle", "time": 7192.39, "timestamp": "01:59:52", "text": "ポケモンをプレイしたことはありますか？ 私は"}, {"type": "subtitle", "time": 7194.229, "timestamp": "01:59:54", "text": "ポケモンをあまりプレイしたことがありません。"}, {"type": "subtitle", "time": 7198.55, "timestamp": "01:59:58", "text": "実は、ポケモンGOを一度だけプレイしたことがあるんです。   以上です。"}]
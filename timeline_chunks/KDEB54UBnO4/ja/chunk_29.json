[{"type": "subtitle", "time": 1742.47, "timestamp": "00:29:02", "text": "、もう夜だ。 だんだん"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "暗くなってきましたね。"}, {"type": "subtitle", "time": 1748.47, "timestamp": "00:29:08", "text": "ここは暗くなってきた。 皆さん、太陽は今まさに沈みましたよ"}, {"type": "subtitle", "time": 1753.19, "timestamp": "00:29:13", "text": "。 日が沈んだ。"}, {"type": "subtitle", "time": 1758.389, "timestamp": "00:29:18", "text": "ああ、それに風も強くて寒い。"}, {"type": "subtitle", "time": 1766.31, "timestamp": "00:29:26", "text": "頭の上にある画面で温度を確認できます。  19℃と表示されています。"}, {"type": "subtitle", "time": 1770.789, "timestamp": "00:29:30", "text": "寒いです。 しかも、"}, {"type": "subtitle", "time": 1777.19, "timestamp": "00:29:37", "text": "本当です。"}, {"type": "subtitle", "time": 1779.83, "timestamp": "00:29:39", "text": "ああ、コウモリ。 ああ、神様。 コウモリ。 ああ、コウモリ。 ああ、"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "コウモリ。 ああ、神様。"}, {"type": "subtitle", "time": 1785.11, "timestamp": "00:29:45", "text": "バットマンがここにいる。"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "ああ、コウモリがこんなにたくさんいるなんて。 ああ、私の"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "カメラはそんなに性能が良くないんです。"}]
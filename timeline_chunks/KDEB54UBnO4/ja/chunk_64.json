[{"type": "subtitle", "time": 3847.91, "timestamp": "01:04:07", "text": "なぜまだ「外部モード」と表示されるのですか？ 一体どういうことだ"}, {"type": "subtitle", "time": 3850.15, "timestamp": "01:04:10", "text": "？"}, {"type": "subtitle", "time": 3853.589, "timestamp": "01:04:13", "text": "スパム投稿はやめてください。"}, {"type": "subtitle", "time": 3857.029, "timestamp": "01:04:17", "text": "君がアウトモードなのも無理はないね。"}, {"type": "subtitle", "time": 3867.51, "timestamp": "01:04:27", "text": "私は外にいることは分かっています。 私は人里離れた場所にいて、自分がどこにいるのか"}, {"type": "subtitle", "time": 3875.829, "timestamp": "01:04:35", "text": "神のみぞ知る。 私は自分のサイクルを"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "探求している最中です。"}, {"type": "subtitle", "time": 3885.029, "timestamp": "01:04:45", "text": "おい、誰かどこを知ってる？ ああ、なんてこった。   それは"}, {"type": "subtitle", "time": 3895.19, "timestamp": "01:04:55", "text": "待って、ここはどこ？"}, {"type": "subtitle", "time": 3897.349, "timestamp": "01:04:57", "text": "私はただサイクリングをしているだけです。 ここがどこなのか分からない。一体"}]
[{"type": "subtitle", "time": 13260.87, "timestamp": "03:41:00", "text": "スピーカーボット、つまり"}, {"type": "subtitle", "time": 13264.63, "timestamp": "03:41:04", "text": "ストリーマーボットから確認する必要がありますよね？  Streamabots もう"}, {"type": "subtitle", "time": 13268.229, "timestamp": "03:41:08", "text": "一つ、スピーカーボードのことですが、"}, {"type": "subtitle", "time": 13271.59, "timestamp": "03:41:11", "text": "スピーカー"}, {"type": "subtitle", "time": 13273.19, "timestamp": "03:41:13", "text": "ボードでテキスト"}, {"type": "subtitle", "time": 13275.75, "timestamp": "03:41:15", "text": "読み上げ機能を使って、インターネット経由で送信して、"}, {"type": "subtitle", "time": 13289.03, "timestamp": "03:41:29", "text": "マニホールド"}, {"type": "subtitle", "time": 13292.07, "timestamp": "03:41:32", "text": "か何かで聞くことができるかどうかわかりません。 ふむ。 それは良い考えですね"}, {"type": "subtitle", "time": 13295.269, "timestamp": "03:41:35", "text": "。 それは良い考えかどうか分かりません。"}, {"type": "subtitle", "time": 13299.59, "timestamp": "03:41:39", "text": "それを確認しないといけない。 ええ、あの"}, {"type": "subtitle", "time": 13302.95, "timestamp": "03:41:42", "text": "テキスト音声変換の件を確認しないといけませんね。 うん、"}, {"type": "subtitle", "time": 13304.79, "timestamp": "03:41:44", "text": "テキスト音声は以前より良くなったね。 そうすれば、"}, {"type": "subtitle", "time": 13308.15, "timestamp": "03:41:48", "text": "誰がどんなチャットをしているか、その他"}, {"type": "subtitle", "time": 13312.389, "timestamp": "03:41:52", "text": "諸々を読むことができます。 私は"}, {"type": "subtitle", "time": 13314.87, "timestamp": "03:41:54", "text": "読むよりも聞く方が得意で、"}, {"type": "subtitle", "time": 13317.75, "timestamp": "03:41:57", "text": "サイクリング中に自転車を止めて読むのをやめました"}]
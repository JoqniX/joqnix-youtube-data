[{"type": "subtitle", "time": 8257.83, "timestamp": "02:17:37", "text": "待っているのですか？ でも、8時には閉店するんですよ。 ああ、"}, {"type": "subtitle", "time": 8260.07, "timestamp": "02:17:40", "text": "閉店するんだね。"}, {"type": "subtitle", "time": 8263.19, "timestamp": "02:17:43", "text": "くそ。 閉店します。"}, {"type": "subtitle", "time": 8265.75, "timestamp": "02:17:45", "text": "くそっ。 閉店しました。"}, {"type": "subtitle", "time": 8267.589, "timestamp": "02:17:47", "text": "閉店時間です。 それから、"}, {"type": "subtitle", "time": 8271.429, "timestamp": "02:17:51", "text": "その辺りを探索してみます。   なんでそんなに"}, {"type": "subtitle", "time": 8274.469, "timestamp": "02:17:54", "text": "フォーカスしてるんだよ、兄弟？  [音楽]"}]
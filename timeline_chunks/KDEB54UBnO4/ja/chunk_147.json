[{"type": "subtitle", "time": 8866.15, "timestamp": "02:27:46", "text": "よし、あれを見て。"}, {"type": "subtitle", "time": 8868.469, "timestamp": "02:27:48", "text": "アレックスはバンドではありません。 その名前が好きなのは、"}, {"type": "subtitle", "time": 8870.07, "timestamp": "02:27:50", "text": "同じ名前の好きな曲があるからで、その"}, {"type": "subtitle", "time": 8871.99, "timestamp": "02:27:51", "text": "意味も納得できるからです"}]
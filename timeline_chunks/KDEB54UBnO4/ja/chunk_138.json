[{"type": "subtitle", "time": 8291.429, "timestamp": "02:18:11", "text": "はい、フォーカスはオートです。"}, {"type": "subtitle", "time": 8294.15, "timestamp": "02:18:14", "text": "安定させる。"}, {"type": "subtitle", "time": 8303.349, "timestamp": "02:18:23", "text": "このショッピングモールは何ですか？ このショッピングモールは何ですか？   せっかく来たんだ"}, {"type": "subtitle", "time": 8314.469, "timestamp": "02:18:34", "text": "あなたはどの国を訪れますか？  [音楽] いいえ、"}, {"type": "subtitle", "time": 8316.469, "timestamp": "02:18:36", "text": "どの国にも行くことはできません。 私は"}, {"type": "subtitle", "time": 8327.429, "timestamp": "02:18:47", "text": "ああ、これは足だ。"}, {"type": "subtitle", "time": 8337.589, "timestamp": "02:18:57", "text": "顔出しだけはしないでください。"}, {"type": "subtitle", "time": 8339.349, "timestamp": "02:18:59", "text": "これは間違いなく、"}]
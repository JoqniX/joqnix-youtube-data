[{"type": "subtitle", "time": 12905.429, "timestamp": "03:35:05", "text": "スマホが三脚から落ちて配信中に個人情報を漏らしそうになったことが何度かありました。   えっと、どうやら"}, {"type": "subtitle", "time": 12909.03, "timestamp": "03:35:09", "text": "良いスマホホルダーを買わないといけないみたいだ"}, {"type": "subtitle", "time": 12911.19, "timestamp": "03:35:11", "text": "。   ああ"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "、いいスマホ"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "ホルダーを買わないといけないな。  [咳払い]"}, {"type": "subtitle", "time": 12918.79, "timestamp": "03:35:18", "text": "そうすれば、"}, {"type": "subtitle", "time": 12922.95, "timestamp": "03:35:22", "text": "皆さんに良い、良い、"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "良い景色をお見せできます。"}, {"type": "subtitle", "time": 12928.309, "timestamp": "03:35:28", "text": "ええ、"}, {"type": "subtitle", "time": 12930.87, "timestamp": "03:35:30", "text": "もっと安定が必要だと感じています"}, {"type": "subtitle", "time": 12937.67, "timestamp": "03:35:37", "text": "スマホホルダーを使っても、"}, {"type": "subtitle", "time": 12941.269, "timestamp": "03:35:41", "text": "サイクルは揺れるようです。"}, {"type": "subtitle", "time": 12943.83, "timestamp": "03:35:43", "text": "うん。 だから、たとえ今私が"}, {"type": "subtitle", "time": 12946.55, "timestamp": "03:35:46", "text": "今日の配信で"}, {"type": "subtitle", "time": 12951.349, "timestamp": "03:35:51", "text": "スマホを三脚に乗せて、"}, {"type": "subtitle", "time": 12958.87, "timestamp": "03:35:58", "text": "自転車のカゴに三脚の脚を曲げてやったとしても、うまくいったと思う"}]
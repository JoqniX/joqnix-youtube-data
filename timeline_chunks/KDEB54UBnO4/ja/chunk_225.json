[{"type": "subtitle", "time": 13504.87, "timestamp": "03:45:04", "text": "まだ外部カメラのようなものを入力できないことです。 それには適切なハードウェア、つまり"}, {"type": "subtitle", "time": 13508.229, "timestamp": "03:45:08", "text": "カメラ本体が必要です。 それと、最低でも4GBのメモリを搭載した"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "Raspberry PiかOrange Piを見つける必要がある"}, {"type": "subtitle", "time": 13515.91, "timestamp": "03:45:15", "text": "。"}, {"type": "subtitle", "time": 13517.99, "timestamp": "03:45:17", "text": "えっと、"}, {"type": "subtitle", "time": 13526.07, "timestamp": "03:45:26", "text": "アクションカメラや一眼レフカメラ、あるいは"}, {"type": "subtitle", "time": 13529.11, "timestamp": "03:45:29", "text": "普通のカメラからのビデオフィードをエンコードして、"}, {"type": "subtitle", "time": 13533.03, "timestamp": "03:45:33", "text": "マニフォールドか何かを使って自分のスマホに送信して、"}, {"type": "subtitle", "time": 13536.229, "timestamp": "03:45:36", "text": "スマホからストリーミング配信できるんです"}, {"type": "subtitle", "time": 13537.91, "timestamp": "03:45:37", "text": "。"}, {"type": "subtitle", "time": 13541.99, "timestamp": "03:45:41", "text": "制御したりリハットしたりするために、2台目の携帯電話が必要だと感じています"}, {"type": "subtitle", "time": 13543.67, "timestamp": "03:45:43", "text": "。 わからない。"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "試してみたいアイデアはたくさんあるんだけど、"}, {"type": "subtitle", "time": 13550.229, "timestamp": "03:45:50", "text": "お金がないんだ。 私はお金がなくて、あまり何もでき"}, {"type": "subtitle", "time": 13552.95, "timestamp": "03:45:52", "text": "ないんです。 今手元にあるものしか使えない"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "。"}, {"type": "subtitle", "time": 13558.71, "timestamp": "03:45:58", "text": "とりあえず直してみます。 でも、"}]
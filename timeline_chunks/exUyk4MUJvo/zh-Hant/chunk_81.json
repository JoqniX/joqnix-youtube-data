[{"type": "subtitle", "time": 4879.189, "timestamp": "01:21:19", "text": "你知道嗎？我直接把這整個"}, {"type": "subtitle", "time": 4902.31, "timestamp": "01:21:42", "text": "我們怎麼知道的"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "？當有人在聊天室輸入內容時，它會建立一個線上人員清單。然後，呃，如果它檢查是否只有一個人，它就會更新清單。然後它會取得頻道 URL 聊天頻道。好的。這是對使用者頻道的檢查。如果清單為零，那麼"}, {"type": "subtitle", "time": 4919.83, "timestamp": "01:21:59", "text": "我們需要你"}]
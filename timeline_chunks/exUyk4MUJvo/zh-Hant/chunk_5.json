[{"type": "subtitle", "time": 300.39, "timestamp": "00:05:00", "text": "版。他們說：「是啊，我們會給"}, {"type": "subtitle", "time": 303.27, "timestamp": "00:05:03", "text": "你英雄稱號的。」我們立刻"}, {"type": "subtitle", "time": 307.67, "timestamp": "00:05:07", "text": "從Spectra升級到了"}, {"type": "subtitle", "time": 313.43, "timestamp": "00:05:13", "text": "Hero。這就是這隻老鼠。我目前用的就是那個英雄。但這種情況已經持續"}, {"type": "subtitle", "time": 315.87, "timestamp": "00:05:15", "text": "三年了"}]
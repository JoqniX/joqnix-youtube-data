[{"type": "subtitle", "time": 3076.829, "timestamp": "00:51:16", "text": "我第二次問這個問題了。你當時被描繪成女孩嗎？你"}, {"type": "subtitle", "time": 3085.39, "timestamp": "00:51:25", "text": "會像個女孩子一樣行事嗎？我不知道。我會嗎？我會。"}, {"type": "subtitle", "time": 3113.069, "timestamp": "00:51:53", "text": "我想是這樣。等等。什麼？你這麼想？什麼？ [音樂] 配對成功。什麼？直到有人說出來"}, {"type": "subtitle", "time": 3115.349, "timestamp": "00:51:55", "text": "我才意識到。我的天哪。什麼？"}]
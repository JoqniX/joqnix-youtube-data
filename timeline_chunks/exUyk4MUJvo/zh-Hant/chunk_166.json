[{"type": "subtitle", "time": 9962.469, "timestamp": "02:46:02", "text": "內疚，因為我放了這個V字形的東西。所以，我以前做過類似的事情，"}, {"type": "subtitle", "time": 9968.63, "timestamp": "02:46:08", "text": "嗯，"}, {"type": "subtitle", "time": 9981.91, "timestamp": "02:46:21", "text": "我想我的靈感來自一位主播，他過去常常在離開直播間或掛機的時候播放一些影片片段。於是我想到一個主意。哦，我沒有夾子。所以為什麼不把我的直播和 YouTube 上的內容都放上去呢？"}, {"type": "subtitle", "time": 9988.23, "timestamp": "02:46:28", "text": "嗯，是的"}, {"type": "subtitle", "time": 9990.55, "timestamp": "02:46:30", "text": "。所以我照做了。  然後我又把它"}, {"type": "subtitle", "time": 9992.95, "timestamp": "02:46:32", "text": "做得更好，就像扭蛋系統一樣。"}, {"type": "subtitle", "time": 9998.23, "timestamp": "02:46:38", "text": "所以就像頻道上所有 VS 中隨機播放一個 V，時間是隨機的。"}, {"type": "subtitle", "time": 10003.19, "timestamp": "02:46:43", "text": "然後當"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "我開始玩這個單字"}, {"type": "subtitle", "time": 10006.389, "timestamp": "02:46:46", "text": "馬拉松時，我想，哦，這行得通，但如果我睡覺什麼的怎麼辦？我需要更多的單字來玩，對吧？所以我"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "打算創建一個類似 M 播放列表的隨機播放列表，它會產生一個隨機的 YouTube 嵌入連結。因此，W 的第一個播放將從一個隨機時間戳記開始。  然後"}, {"type": "subtitle", "time": 10015.75, "timestamp": "02:46:55", "text": "，我目前在播放清單中放入了 30 個影片。所以它們都會隨機播放，"}]
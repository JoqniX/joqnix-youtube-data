[{"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "我得打敗他。釋放的前奏，教我一點。是的。是的，當然。是的。你有什麼嗎？有什麼疑問嗎？"}, {"type": "subtitle", "time": 4281.59, "timestamp": "01:11:21", "text": "我來幫你。走開。我網路延遲高嗎"}, {"type": "subtitle", "time": 4286.709, "timestamp": "01:11:26", "text": "？是的，我網路"}, {"type": "subtitle", "time": 4304.63, "timestamp": "01:11:44", "text": "沒電了。我走了。快出來了。對，開槍了。"}]
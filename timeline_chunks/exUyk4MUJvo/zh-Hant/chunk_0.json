[{"type": "subtitle", "time": 8.87, "timestamp": "00:00:08", "text": "不，我一直很努力，直到你這麼說為止。哦"}, {"type": "subtitle", "time": 11.35, "timestamp": "00:00:11", "text": "好的。"}, {"type": "subtitle", "time": 13.95, "timestamp": "00:00:13", "text": "我"}, {"type": "subtitle", "time": 17.63, "timestamp": "00:00:17", "text": "又想了想，就像……嗯，該怎麼稱呼它呢？"}, {"type": "subtitle", "time": 21.39, "timestamp": "00:00:21", "text": "你平常玩的那種遊戲，"}, {"type": "subtitle", "time": 24.07, "timestamp": "00:00:24", "text": "比如，你管它叫什麼來著？遊戲規則是什麼來著"}, {"type": "subtitle", "time": 34.229, "timestamp": "00:00:34", "text": "最後一名玩家存活下來，就像《艾爾登法環》"}, {"type": "subtitle", "time": 38.389, "timestamp": "00:00:38", "text": "和其他一些遊戲一樣，但"}, {"type": "subtitle", "time": 42.79, "timestamp": "00:00:42", "text": "我們必須與其他玩家戰鬥才能將"}, {"type": "subtitle", "time": 44.51, "timestamp": "00:00:44", "text": "戰利品"}, {"type": "subtitle", "time": 47.029, "timestamp": "00:00:47", "text": "提取回現實世界或"}, {"type": "subtitle", "time": 51.27, "timestamp": "00:00:51", "text": "其他什麼地方。黑暗靈魂王牌隊。對"}]
[{"type": "subtitle", "time": 22262.868, "timestamp": "06:11:02", "text": "我明白了。哦，天哪，快走。敵人，敵人，敵人。  我們的"}, {"type": "subtitle", "time": 22269.51, "timestamp": "06:11:09", "text": "目標已被摧毀。  關閉。  偉大的。關閉。  什麼？"}, {"type": "subtitle", "time": 22272.948, "timestamp": "06:11:12", "text": "我從另一邊過來了。我死了。"}, {"type": "subtitle", "time": 22275.67, "timestamp": "06:11:15", "text": "不，這場戰鬥很艱苦"}, {"type": "subtitle", "time": 22276.788, "timestamp": "06:11:16", "text": "。"}, {"type": "subtitle", "time": 22281.27, "timestamp": "06:11:21", "text": "哇。  [音樂] H. 我沒有黃金。嗯？  你做得很好"}, {"type": "subtitle", "time": 22283.19, "timestamp": "06:11:23", "text": "。哦，我該買這個嗎？你覺得"}, {"type": "subtitle", "time": 22296.868, "timestamp": "06:11:36", "text": "我該買東西嗎？  [音樂] 哈。 V. 威克博士的形成。沒關係。我準備好了。我的天啊。我不知道你也在我的"}, {"type": "subtitle", "time": 22302.788, "timestamp": "06:11:42", "text": "創投帳戶裡。搞什麼鬼？哦，XP。哦，解鎖。  你好，傑克先生。  傑克。哦，真是"}, {"type": "subtitle", "time": 22305.27, "timestamp": "06:11:45", "text": "不同的人。哦，不"}, {"type": "subtitle", "time": 22317.19, "timestamp": "06:11:57", "text": "一樣。  哦，等等。等等，等等，等等，等等，等等。  我聽不見你說話。一秒鐘。一秒鐘。一秒鐘。一秒鐘。讓我先修一下音訊。一秒鐘。歡迎。哦，他在說話。"}]
[{"type": "subtitle", "time": 16021.469, "timestamp": "04:27:01", "text": "需要雙手。  好的，兄弟，我明白了"}, {"type": "subtitle", "time": 16024.07, "timestamp": "04:27:04", "text": "。兄弟，我罩著你。誰說是手"}, {"type": "subtitle", "time": 16068.63, "timestamp": "04:27:48", "text": "手。掌控面部表情。牽起手。一直向上指。  誰更傾向於……我的意思是，這是真的。這是真的。  這是真的。她就像是正在觀看新動畫《"}]
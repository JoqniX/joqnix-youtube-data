[{"type": "subtitle", "time": 120.55, "timestamp": "00:02:00", "text": "有時不起作用。哦，等等。"}, {"type": "subtitle", "time": 122.19, "timestamp": "00:02:02", "text": "你現在在工作。"}, {"type": "subtitle", "time": 125.19, "timestamp": "00:02:05", "text": "什麼？當我真正瞄準"}, {"type": "subtitle", "time": 128.869, "timestamp": "00:02:08", "text": "某人時，我確信，這肯定會搞砸，對吧"}, {"type": "subtitle", "time": 138.39, "timestamp": "00:02:18", "text": "上帝。是的。你當然不能一直拿著。你當然不會堅持下去。"}, {"type": "subtitle", "time": 140.22899999999998, "timestamp": "00:02:20", "text": "他當然"}]
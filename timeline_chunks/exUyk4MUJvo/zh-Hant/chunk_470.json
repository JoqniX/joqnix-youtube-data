[{"type": "subtitle", "time": 28203.23, "timestamp": "07:50:03", "text": "，那動畫真是太棒了。  那太"}, {"type": "subtitle", "time": 28228.388, "timestamp": "07:50:28", "text": "這裡"}, {"type": "subtitle", "time": 28230.51, "timestamp": "07:50:30", "text": "買到石頭和"}, {"type": "subtitle", "time": 28237.11, "timestamp": "07:50:37", "text": "。  好的，我們繼續耕作。等等，這是什麼？哦，我的食物快吃完了"}]
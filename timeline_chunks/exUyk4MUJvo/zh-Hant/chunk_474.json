[{"type": "subtitle", "time": 28448.868, "timestamp": "07:54:08", "text": "。返回物品欄並裝備此物品。所以，我們弄到了一支"}, {"type": "subtitle", "time": 28454.11, "timestamp": "07:54:14", "text": "。我不會用它，因為……燃料嘛，對吧？"}, {"type": "subtitle", "time": 28457.75, "timestamp": "07:54:17", "text": "我拉屎了。所以我可以殺了他，因為我是五級，"}, {"type": "subtitle", "time": 28459.868, "timestamp": "07:54:19", "text": "而他只有二級。所以別在意我。"}, {"type": "subtitle", "time": 28482.35, "timestamp": "07:54:42", "text": "我需要殺了你。我的天哪。  到"}]
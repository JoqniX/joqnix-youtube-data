[{"type": "subtitle", "time": 27606.35, "timestamp": "07:40:06", "text": "確實很可怕。這是什麼恐龍"}, {"type": "subtitle", "time": 27611.23, "timestamp": "07:40:11", "text": "？我能嗎？我不應該打它。這會要了我的命，對吧？"}, {"type": "subtitle", "time": 27628.548, "timestamp": "07:40:28", "text": "野生雄性。呃，碳品質。"}, {"type": "subtitle", "time": 27636.868, "timestamp": "07:40:36", "text": "等等，什麼？二級。我該怎麼做？好的。  存貨。我以為他是"}, {"type": "subtitle", "time": 27659.23, "timestamp": "07:40:59", "text": "。  哦。  呃，猛禽弧。這是什麼？無法研磨。等等，這是什麼？  N 可"}]
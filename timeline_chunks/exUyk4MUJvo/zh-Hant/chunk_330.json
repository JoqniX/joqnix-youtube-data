[{"type": "subtitle", "time": 19802.788, "timestamp": "05:30:02", "text": "我"}, {"type": "subtitle", "time": 19805.99, "timestamp": "05:30:05", "text": "今天過得還不錯。你呢？很好。在Vex遊戲中，地面消失了。哦。"}, {"type": "subtitle", "time": 19808.07, "timestamp": "05:30:08", "text": "哦，是的。我們也遇到過這種情況。是的。是的，我們遇到過。我們也"}, {"type": "subtitle", "time": 19814.43, "timestamp": "05:30:14", "text": "遇到過這種情況。在日誌訪問中。"}, {"type": "subtitle", "time": 19826.868, "timestamp": "05:30:26", "text": "我剛才做了什麼，老兄"}, {"type": "subtitle", "time": 19829.83, "timestamp": "05:30:29", "text": "。清除。還行吧。有跳躍空間。"}]
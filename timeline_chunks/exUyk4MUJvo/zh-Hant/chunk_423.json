[{"type": "subtitle", "time": 25387.948, "timestamp": "07:03:07", "text": "事情。沒問題。我不知道。是的。呃"}, {"type": "subtitle", "time": 25394.39, "timestamp": "07:03:14", "text": "，讓我解釋一下。為什麼？看著我。好的。"}, {"type": "subtitle", "time": 25411.35, "timestamp": "07:03:31", "text": "你好。今天我們將玩《方舟：生存進化》。是的。希望你，希望大家一切"}, {"type": "subtitle", "time": 25417.43, "timestamp": "07:03:37", "text": "安好。  我想你們了。是的。昨天我們騎自行車，聊了很多事。我們……該"}, {"type": "subtitle", "time": 25421.59, "timestamp": "07:03:41", "text": "怎麼稱呼它呢？"}, {"type": "subtitle", "time": 25423.708, "timestamp": "07:03:43", "text": "我們最後會玩根欽，對吧？  是的。那很好。其實昨天過得很愉快，結局有點出乎我的意料，"}, {"type": "subtitle", "time": 25429.91, "timestamp": "07:03:49", "text": "但我真的很喜歡。我真的很喜歡[音樂]"}, {"type": "subtitle", "time": 25433.51, "timestamp": "07:03:53", "text": "。我"}, {"type": "subtitle", "time": 25435.99, "timestamp": "07:03:55", "text": "為什麼會說「"}]
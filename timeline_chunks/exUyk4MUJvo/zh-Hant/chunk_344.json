[{"type": "subtitle", "time": 20649.11, "timestamp": "05:44:09", "text": "音頻員開始。"}, {"type": "subtitle", "time": 20680.628, "timestamp": "05:44:40", "text": "。這個遊戲是免費的嗎"}, {"type": "subtitle", "time": 20683.91, "timestamp": "05:44:43", "text": "？是的，它是免費的。免費玩。只要在網路上搜尋名為「Enfield」的遊戲。不是Enfield。是Enlisted。"}]
[{"type": "subtitle", "time": 6124.55, "timestamp": "01:42:04", "text": "這種情況。哦，是這個。上次我們談話的時候它不在那裡嗎？"}, {"type": "subtitle", "time": 6128.709, "timestamp": "01:42:08", "text": "不，"}, {"type": "subtitle", "time": 6130.99, "timestamp": "01:42:10", "text": "不。那"}, {"type": "subtitle", "time": 6142.229, "timestamp": "01:42:22", "text": "是你畫的嗎"}, {"type": "subtitle", "time": 6146.39, "timestamp": "01:42:26", "text": "？哦，這是別人送我的禮物。  呃，我的一個藝術家朋友畫了我的……呃，畫了這張"}, {"type": "subtitle", "time": 6148.83, "timestamp": "01:42:28", "text": "同人"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "圖。她曾經畫過我的畫像，而且是在她學習如何製作二維模型之類的東西時指導完成的。  哦，她真是太酷了。  請問這是2D還是3D的？"}, {"type": "subtitle", "time": 6173.83, "timestamp": "01:42:53", "text": "我"}, {"type": "subtitle", "time": 6177.51, "timestamp": "01:42:57", "text": "認為它是3D的。它是二維的。 2D。我沒有，我沒有，我沒有像下半身那樣的身材。  哦，"}]
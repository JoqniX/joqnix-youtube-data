[{"type": "subtitle", "time": 19324.15, "timestamp": "05:22:04", "text": "我會"}, {"type": "subtitle", "time": 19340.15, "timestamp": "05:22:20", "text": "呃，我該"}, {"type": "subtitle", "time": 19342.23, "timestamp": "05:22:22", "text": "擔心嗎？我應該擔心。是的，我們需要稍微降低一點。好的，等等。呃，把它調回去。"}, {"type": "subtitle", "time": 19349.23, "timestamp": "05:22:29", "text": "罪魁禍首了。是的。遊戲……這個遊戲。你在開玩笑嗎"}, {"type": "subtitle", "time": 19352.15, "timestamp": "05:22:32", "text": "？我得重新開始了。圖片"}, {"type": "subtitle", "time": 19366.47, "timestamp": "05:22:46", "text": "沒有資料包。怎麼回事？我的天哪，遊戲裡有個洞。這是什麼？我打了個大方洞。"}]
[{"type": "subtitle", "time": 2964.549, "timestamp": "00:49:24", "text": "我應該記下來，"}, {"type": "subtitle", "time": 2975.63, "timestamp": "00:49:35", "text": "然後點點"}, {"type": "subtitle", "time": 2983.27, "timestamp": "00:49:43", "text": "按鈕或什麼的。正在"}, {"type": "subtitle", "time": 2989.99, "timestamp": "00:49:49", "text": "。因為我忘了。他們都死了。好了。我"}, {"type": "subtitle", "time": 2991.549, "timestamp": "00:49:51", "text": "喜歡你這樣安排"}, {"type": "subtitle", "time": 2993.15, "timestamp": "00:49:53", "text": "。開始了。我準備好了。操。三。還剩一個敵人。走吧"}]
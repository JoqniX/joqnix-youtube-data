[{"type": "subtitle", "time": 16218.87, "timestamp": "04:30:18", "text": "我知道是岡戶。你知道我將學到什麼嗎？我的天啊，人們都在關注這次選舉。"}, {"type": "subtitle", "time": 16220.79, "timestamp": "04:30:20", "text": "我是啞巴。好的，稍等一下。是的，他們去過那裡。你知道，人們拿著"}, {"type": "subtitle", "time": 16246.83, "timestamp": "04:30:46", "text": "擴音器和揚聲器，在麵包車裡，在吉普車裡等等地方守衛。"}, {"type": "subtitle", "time": 16251.08, "timestamp": "04:30:51", "text": "啊，喀拉拉邦其他地區的情況也"}]
[{"type": "subtitle", "time": 7201.589, "timestamp": "02:00:01", "text": "诸如此类的事情，我觉得……"}, {"type": "subtitle", "time": 7203.99, "timestamp": "02:00:03", "text": "我认为她能让艺术家们出来。"}, {"type": "subtitle", "time": 7206.39, "timestamp": "02:00:06", "text": "这就是公众了解此事的途径。"}, {"type": "subtitle", "time": 7208.79, "timestamp": "02:00:08", "text": "这和"}, {"type": "subtitle", "time": 7212.27, "timestamp": "02:00:12", "text": "嗯，对，那你管它叫什么？"}, {"type": "subtitle", "time": 7215.669, "timestamp": "02:00:15", "text": "呃，还有什么？是的。然后呃"}, {"type": "subtitle", "time": 7218.79, "timestamp": "02:00:18", "text": "自从奶奶去世后，她所有的朋友都……"}, {"type": "subtitle", "time": 7223.03, "timestamp": "02:00:23", "text": "将 Google Docky 变成 Google 文档。所以鞠躬"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "面纱感到失望，因为一个接近"}, {"type": "subtitle", "time": 7228.229, "timestamp": "02:00:28", "text": "她的好朋友对她做了那样的事"}, {"type": "subtitle", "time": 7230.229, "timestamp": "02:00:30", "text": "影响她的品牌和一切，因为她"}, {"type": "subtitle", "time": 7233.43, "timestamp": "02:00:33", "text": "竞争非常激烈。和"}, {"type": "subtitle", "time": 7237.03, "timestamp": "02:00:37", "text": "嗯，还有银鲸公司也参与其中。"}, {"type": "subtitle", "time": 7241.51, "timestamp": "02:00:41", "text": "她也受到了影响，因为她也"}, {"type": "subtitle", "time": 7244.47, "timestamp": "02:00:44", "text": "好像是生日礼服之类的。"}, {"type": "subtitle", "time": 7246.87, "timestamp": "02:00:46", "text": "由本应是"}, {"type": "subtitle", "time": 7249.189, "timestamp": "02:00:49", "text": "由同一位艺术家创作，他也获得了"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "取消了之类的，因为他们不这么做"}, {"type": "subtitle", "time": 7254.629, "timestamp": "02:00:54", "text": "现在知道背后的真正原因是什么了"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "艺术家拒绝或喜欢制作类似的东西"}]
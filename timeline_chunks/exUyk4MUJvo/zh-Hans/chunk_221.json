[{"type": "subtitle", "time": 13276.51, "timestamp": "03:41:16", "text": "公告。哦，等等。哦，"}, {"type": "subtitle", "time": 13280.83, "timestamp": "03:41:20", "text": "等待。可能存在无限期"}, {"type": "subtitle", "time": 13283.59, "timestamp": "03:41:23", "text": "暂停等待。我想问一下。等待。哦，"}, {"type": "subtitle", "time": 13290.19, "timestamp": "03:41:30", "text": "等待。但如果是“我的天哪”。"}, {"type": "subtitle", "time": 13297.469, "timestamp": "03:41:37", "text": "你好"}, {"type": "subtitle", "time": 13300.429, "timestamp": "03:41:40", "text": "儿子。我看到了你的"}, {"type": "subtitle", "time": 13309.309, "timestamp": "03:41:49", "text": "哦，是"}, {"type": "subtitle", "time": 13310.91, "timestamp": "03:41:50", "text": "你"}]
[{"type": "subtitle", "time": 5401.229, "timestamp": "01:30:01", "text": "名字昵称"}, {"type": "subtitle", "time": 5405.43, "timestamp": "01:30:05", "text": "这是昵称的视图。然后他就躲起来了。"}, {"type": "subtitle", "time": 5408.55, "timestamp": "01:30:08", "text": "这个东西。接下来是……"}, {"type": "subtitle", "time": 5411.35, "timestamp": "01:30:11", "text": "我们起了昵称。"}, {"type": "subtitle", "time": 5414.189, "timestamp": "01:30:14", "text": "是的，对于人们来说"}, {"type": "subtitle", "time": 5417.27, "timestamp": "01:30:17", "text": "聊天的事我们待会儿再说。是的。"}, {"type": "subtitle", "time": 5419.59, "timestamp": "01:30:19", "text": "是的。您好，Visa。你好吗？惠普"}, {"type": "subtitle", "time": 5422.47, "timestamp": "01:30:22", "text": "我看见你。任何空位？是的，我们只会……"}, {"type": "subtitle", "time": 5425.149, "timestamp": "01:30:25", "text": "如果你正在玩《间谍粉碎》，那就去玩吧。"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "因为我需要完成这项工作，所以暂时遮盖一下。"}, {"type": "subtitle", "time": 5438.07, "timestamp": "01:30:38", "text": "所以请告诉我都有哪些人会来。"}, {"type": "subtitle", "time": 5443.87, "timestamp": "01:30:43", "text": "所以我可以设置一个队列列表，或者"}, {"type": "subtitle", "time": 5446.55, "timestamp": "01:30:46", "text": "某物。所以如果数量超过……"}, {"type": "subtitle", "time": 5449.75, "timestamp": "01:30:49", "text": "四个人，我可以把你排进队列里，或者"}, {"type": "subtitle", "time": 5456.629, "timestamp": "01:30:56", "text": "转变。哦，对，我们需要安排一下。"}]
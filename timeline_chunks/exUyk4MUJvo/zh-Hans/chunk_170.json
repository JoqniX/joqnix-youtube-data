[{"type": "subtitle", "time": 10202.309, "timestamp": "02:50:02", "text": "包括照明和燃料费用。"}, {"type": "subtitle", "time": 10204.87, "timestamp": "02:50:04", "text": "是的。呃，你可以继续待在这里，也可以离开。"}, {"type": "subtitle", "time": 10207.51, "timestamp": "02:50:07", "text": "6个月后。然后是设施设备，"}, {"type": "subtitle", "time": 10209.83, "timestamp": "02:50:09", "text": "浴缸、浴室、冰箱、洗衣房"}, {"type": "subtitle", "time": 10212.55, "timestamp": "02:50:12", "text": "机器，米饭，电饭煲，呃，米饭"}, {"type": "subtitle", "time": 10214.71, "timestamp": "02:50:14", "text": "炉灶、电热锅、双层地窖"}, {"type": "subtitle", "time": 10216.87, "timestamp": "02:50:16", "text": "床、桌子和椅子。所以我认为是这样。"}, {"type": "subtitle", "time": 10219.03, "timestamp": "02:50:19", "text": "是的。你说的没错，一个房间。我"}, {"type": "subtitle", "time": 10220.63, "timestamp": "02:50:20", "text": "我想这就是它的意思。就像这样"}, {"type": "subtitle", "time": 10223.83, "timestamp": "02:50:23", "text": "两个人住在同一个房间里。"}, {"type": "subtitle", "time": 10225.429, "timestamp": "02:50:25", "text": "是的。"}, {"type": "subtitle", "time": 10228.23, "timestamp": "02:50:28", "text": "难道不就是这个意思吗？是的，确实如此。"}, {"type": "subtitle", "time": 10231.67, "timestamp": "02:50:31", "text": "意思是因为他们提到了“嗯”。"}, {"type": "subtitle", "time": 10234.23, "timestamp": "02:50:34", "text": "双层床，对吧？"}, {"type": "subtitle", "time": 10236.309, "timestamp": "02:50:36", "text": "不，我不知道，乔。我"}, {"type": "subtitle", "time": 10237.71, "timestamp": "02:50:37", "text": "不知道"}, {"type": "subtitle", "time": 10241.429, "timestamp": "02:50:41", "text": "那。就像我一样，你知道的"}, {"type": "subtitle", "time": 10244.83, "timestamp": "02:50:44", "text": "伴侣，你确实需要一些私人空间。"}, {"type": "subtitle", "time": 10247.19, "timestamp": "02:50:47", "text": "是的。不，我对此并不了解。我"}, {"type": "subtitle", "time": 10248.71, "timestamp": "02:50:48", "text": "我不了解那个。买一个"}, {"type": "subtitle", "time": 10250.71, "timestamp": "02:50:50", "text": "单人房。是的，我就是这个意思。"}, {"type": "subtitle", "time": 10252.79, "timestamp": "02:50:52", "text": "目标是。你需要的，你将拥有"}, {"type": "subtitle", "time": 10256.63, "timestamp": "02:50:56", "text": "现在内心平静下来了。是的，"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "虽然贵，但这是你的"}]
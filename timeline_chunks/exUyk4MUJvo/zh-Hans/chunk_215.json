[{"type": "subtitle", "time": 12900.229, "timestamp": "03:35:00", "text": "最终确定合作日程"}, {"type": "subtitle", "time": 12902.55, "timestamp": "03:35:02", "text": "今天就要安排好所有事情。所以，我必须"}, {"type": "subtitle", "time": 12905.59, "timestamp": "03:35:05", "text": "你会亲眼看到我惊慌失措的样子。"}, {"type": "subtitle", "time": 12909.349, "timestamp": "03:35:09", "text": "已经过去了，不过没关系。嗯，是的。"}, {"type": "subtitle", "time": 12911.75, "timestamp": "03:35:11", "text": "根据日程安排来看"}, {"type": "subtitle", "time": 12914.07, "timestamp": "03:35:14", "text": "一周过去了，今天是星期一，对吧？我"}, {"type": "subtitle", "time": 12916.07, "timestamp": "03:35:16", "text": "本周的安排甚至还没有完全敲定。"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "东西。那真是太糟糕、太疯狂了。"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "但没关系。我会安排人"}, {"type": "subtitle", "time": 12924.95, "timestamp": "03:35:24", "text": "呃，哪些人还在待定名单上。"}, {"type": "subtitle", "time": 12927.67, "timestamp": "03:35:27", "text": "大概有三四十个吧，我"}, {"type": "subtitle", "time": 12930.59, "timestamp": "03:35:30", "text": "相信。我已经数不清了。"}, {"type": "subtitle", "time": 12932.87, "timestamp": "03:35:32", "text": "观点。我每天都在联系"}, {"type": "subtitle", "time": 12934.79, "timestamp": "03:35:34", "text": "对新朋友来说。这时，我的反应是："}, {"type": "subtitle", "time": 12936.63, "timestamp": "03:35:36", "text": "“我的天哪，我该怎么说呢？”"}, {"type": "subtitle", "time": 12940.71, "timestamp": "03:35:40", "text": "“大家都到齐了吗？”不知道。不过没关系。"}, {"type": "subtitle", "time": 12943.19, "timestamp": "03:35:43", "text": "最终，如果实在太多，我可以……"}, {"type": "subtitle", "time": 12945.67, "timestamp": "03:35:45", "text": "总是把它们分组存放。"}, {"type": "subtitle", "time": 12947.59, "timestamp": "03:35:47", "text": "我们在这里以小组形式进行讨论。这将是一个团体"}, {"type": "subtitle", "time": 12949.389, "timestamp": "03:35:49", "text": "合作之类的。悬挂"}, {"type": "subtitle", "time": 12953.349, "timestamp": "03:35:53", "text": "出去。嗯，对我来说，我想和……谈谈"}, {"type": "subtitle", "time": 12955.59, "timestamp": "03:35:55", "text": "与人交往并和他们一起玩耍。我不"}, {"type": "subtitle", "time": 12956.83, "timestamp": "03:35:56", "text": "把它看作是"}]
[{"type": "subtitle", "time": 12422.229, "timestamp": "03:27:02", "text": "是的，某种程度上来说，即使我没有，如果我"}, {"type": "subtitle", "time": 12425.11, "timestamp": "03:27:05", "text": "即使我没能达到目标，"}, {"type": "subtitle", "time": 12429.11, "timestamp": "03:27:09", "text": "至少我……我确实得到了……呃……至少我曾经是"}, {"type": "subtitle", "time": 12431.67, "timestamp": "03:27:11", "text": "我对自己的表现感到满意。"}, {"type": "subtitle", "time": 12434.55, "timestamp": "03:27:14", "text": "不。所以归根结底，就是这样。"}, {"type": "subtitle", "time": 12436.83, "timestamp": "03:27:16", "text": "关于幸福。"}, {"type": "subtitle", "time": 12439.59, "timestamp": "03:27:19", "text": "是的。所以这就是为什么……是的。我受够了。"}, {"type": "subtitle", "time": 12442.469, "timestamp": "03:27:22", "text": "我不想去想该怎么做"}, {"type": "subtitle", "time": 12445.51, "timestamp": "03:27:25", "text": "金额或其他任何东西。就让它这样吧"}, {"type": "subtitle", "time": 12447.83, "timestamp": "03:27:27", "text": "有人想直接支持吗？"}, {"type": "subtitle", "time": 12450.389, "timestamp": "03:27:30", "text": "计入金额。呃，如果不是的话……"}, {"type": "subtitle", "time": 12452.63, "timestamp": "03:27:32", "text": "完全没问题。我可以放松一下，享受……"}, {"type": "subtitle", "time": 12457.99, "timestamp": "03:27:37", "text": "乐趣。我在印度的最后时光。是的。"}, {"type": "subtitle", "time": 12459.83, "timestamp": "03:27:39", "text": "我的意思是，你可以返回印度。它是"}, {"type": "subtitle", "time": 12462.71, "timestamp": "03:27:42", "text": "不像最后时刻那样。好的，我会的。"}, {"type": "subtitle", "time": 12465.429, "timestamp": "03:27:45", "text": "是的，我最终会回来的。是的，"}, {"type": "subtitle", "time": 12470.229, "timestamp": "03:27:50", "text": "因为呃，时不时地就像"}, {"type": "subtitle", "time": 12472.55, "timestamp": "03:27:52", "text": "我不知道他们是否会允许我这么做。他们"}, {"type": "subtitle", "time": 12474.95, "timestamp": "03:27:54", "text": "确实提到过，除非并且直到出现……"}, {"type": "subtitle", "time": 12478.15, "timestamp": "03:27:58", "text": "获得Nava校长的明确许可"}]
[{"type": "subtitle", "time": 11281.349, "timestamp": "03:08:01", "text": "它非常好，我的意思是，我能看到"}, {"type": "subtitle", "time": 11282.71, "timestamp": "03:08:02", "text": "它很好，也很好，但我并不"}, {"type": "subtitle", "time": 11286.55, "timestamp": "03:08:06", "text": "我认为这是优先事项，是的，我知道。哦，"}, {"type": "subtitle", "time": 11288.55, "timestamp": "03:08:08", "text": "我当时就像"}, {"type": "subtitle", "time": 11290.79, "timestamp": "03:08:10", "text": "从你现在所在的地方出发。我"}, {"type": "subtitle", "time": 11292.87, "timestamp": "03:08:12", "text": "我知道你思考得有多深，因为"}, {"type": "subtitle", "time": 11295.269, "timestamp": "03:08:15", "text": "相信我，我当时就在那里，我就在那里，我当时就是我。"}, {"type": "subtitle", "time": 11299.67, "timestamp": "03:08:19", "text": "你在哪儿，但我不知道"}, {"type": "subtitle", "time": 11301.99, "timestamp": "03:08:21", "text": "我知道，我不知道，我不是在说"}, {"type": "subtitle", "time": 11305.75, "timestamp": "03:08:25", "text": "除了“抓到你了”以外的任何事。明白了。是的。是的。"}, {"type": "subtitle", "time": 11306.75, "timestamp": "03:08:26", "text": "加"}, {"type": "subtitle", "time": 11309.59, "timestamp": "03:08:29", "text": "不过，我的确是个很不错的模特。就像我可以"}, {"type": "subtitle", "time": 11313.19, "timestamp": "03:08:33", "text": "明白为什么是2000美元，"}, {"type": "subtitle", "time": 11315.59, "timestamp": "03:08:35", "text": "是的，这会是一个很好的模型。是的，"}, {"type": "subtitle", "time": 11317.59, "timestamp": "03:08:37", "text": "说实话，2000有点太多了。"}, {"type": "subtitle", "time": 11321.59, "timestamp": "03:08:41", "text": "没错，没错，没错。和"}, {"type": "subtitle", "time": 11325.45, "timestamp": "03:08:45", "text": "这就是你投入 2000 美元后的处境。"}, {"type": "subtitle", "time": 11327.75, "timestamp": "03:08:47", "text": "[音乐]"}, {"type": "subtitle", "time": 11330.07, "timestamp": "03:08:50", "text": "请问您目前的情况如何？"}, {"type": "subtitle", "time": 11333.51, "timestamp": "03:08:53", "text": "2000美元？实际上，差得远呢。"}, {"type": "subtitle", "time": 11335.67, "timestamp": "03:08:55", "text": "实际上。不，我明白了。就像那样"}, {"type": "subtitle", "time": 11338.389, "timestamp": "03:08:58", "text": "就像那相当于我两个月的时间一样。"}]
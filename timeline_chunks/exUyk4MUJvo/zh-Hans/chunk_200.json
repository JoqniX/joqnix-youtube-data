[{"type": "subtitle", "time": 12003.11, "timestamp": "03:20:03", "text": "是，但同时我也觉得，"}, {"type": "subtitle", "time": 12005.67, "timestamp": "03:20:05", "text": "好吧，我的意思是"}, {"type": "subtitle", "time": 12010.229, "timestamp": "03:20:10", "text": "那很遗憾，但好吧。问题是……"}, {"type": "subtitle", "time": 12013.19, "timestamp": "03:20:13", "text": "我意识到它很受欢迎，但它是"}, {"type": "subtitle", "time": 12015.75, "timestamp": "03:20:15", "text": "在唐语中很流行"}, {"type": "subtitle", "time": 12018.71, "timestamp": "03:20:18", "text": "舌头。所以我知道有个机构之类的。"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "就像那样，但他们非常专注于"}, {"type": "subtitle", "time": 12024.229, "timestamp": "03:20:24", "text": "单一国家层面。你知道我"}, {"type": "subtitle", "time": 12026.469, "timestamp": "03:20:26", "text": "意思是？就像他们非常具有东亚特色一样。"}, {"type": "subtitle", "time": 12028.469, "timestamp": "03:20:28", "text": "占据主导地位。所以你需要学习像这样"}, {"type": "subtitle", "time": 12032.229, "timestamp": "03:20:32", "text": "东亚语言。真的。真的。是的。"}, {"type": "subtitle", "time": 12035.349, "timestamp": "03:20:35", "text": "你会日语。所以"}, {"type": "subtitle", "time": 12040.229, "timestamp": "03:20:40", "text": "我正在学习，而且我已经通过了N5考试。我"}, {"type": "subtitle", "time": 12043.91, "timestamp": "03:20:43", "text": "我通过N5考试了吗？我写的"}, {"type": "subtitle", "time": 12045.67, "timestamp": "03:20:45", "text": "在钦奈"}, {"type": "subtitle", "time": 12047.91, "timestamp": "03:20:47", "text": "二月份。你能说一口流利的英语吗？"}, {"type": "subtitle", "time": 12051.51, "timestamp": "03:20:51", "text": "尽管？不够流利。我会说一点。"}, {"type": "subtitle", "time": 12055.11, "timestamp": "03:20:55", "text": "是的。口语没问题，但是语法……"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "一切都是 O。"}]
[{"type": "subtitle", "time": 7680.83, "timestamp": "02:08:00", "text": "在全国各地旅行做蠢事"}, {"type": "subtitle", "time": 7684.31, "timestamp": "02:08:04", "text": "东西和旅行对像大的人来说"}, {"type": "subtitle", "time": 7686.39, "timestamp": "02:08:06", "text": "像我们这样的国家，说实话，喜欢得到"}, {"type": "subtitle", "time": 7691.189, "timestamp": "02:08:11", "text": "那个十亿的浏览量"}, {"type": "subtitle", "time": 7693.83, "timestamp": "02:08:13", "text": "就像最近Mr. Beast的速度一样"}, {"type": "subtitle", "time": 7697.03, "timestamp": "02:08:17", "text": "还有他们所有人。是的。"}, {"type": "subtitle", "time": 7699.27, "timestamp": "02:08:19", "text": "是的。甚至包括那些主播"}, {"type": "subtitle", "time": 7702.629, "timestamp": "02:08:22", "text": "凯塞内茨和耶是比较受欢迎的。"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "是的。是的。是的。你看到了吗？你看到了吗？"}, {"type": "subtitle", "time": 7709.83, "timestamp": "02:08:29", "text": "是那个叫“海战主播学院”的东西吗？"}, {"type": "subtitle", "time": 7712.87, "timestamp": "02:08:32", "text": "是的。是的。我的天啊。我想我得到了"}, {"type": "subtitle", "time": 7714.629, "timestamp": "02:08:34", "text": "一些片段。我没看到。"}, {"type": "subtitle", "time": 7717.83, "timestamp": "02:08:37", "text": "完全正确，但我认为我也这么认为。"}, {"type": "subtitle", "time": 7720.31, "timestamp": "02:08:40", "text": "我知道的一件事是额外的艾米丽"}, {"type": "subtitle", "time": 7723.27, "timestamp": "02:08:43", "text": "被选中了。"}, {"type": "subtitle", "time": 7728.79, "timestamp": "02:08:48", "text": "不过挺好玩的。我觉得，我觉得那就是"}, {"type": "subtitle", "time": 7730.87, "timestamp": "02:08:50", "text": "这就是流媒体的意义所在。"}, {"type": "subtitle", "time": 7734.47, "timestamp": "02:08:54", "text": "现在正在发生的事情。是的。"}, {"type": "subtitle", "time": 7736.95, "timestamp": "02:08:56", "text": "所以严格来说，如果我们谈论……"}, {"type": "subtitle", "time": 7739.669, "timestamp": "02:08:59", "text": "我想，这就是离开 YouTuber 那边的原因吧。"}]
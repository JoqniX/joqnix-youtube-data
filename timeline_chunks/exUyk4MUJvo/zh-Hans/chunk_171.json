[{"type": "subtitle", "time": 10261.59, "timestamp": "02:51:01", "text": "你会被迫和某人待在一起"}, {"type": "subtitle", "time": 10263.75, "timestamp": "02:51:03", "text": "几乎不认识。所以，是的，你不会……"}, {"type": "subtitle", "time": 10266.07, "timestamp": "02:51:06", "text": "心理"}, {"type": "subtitle", "time": 10267.63, "timestamp": "02:51:07", "text": "比如多少钱"}, {"type": "subtitle", "time": 10270.83, "timestamp": "02:51:10", "text": "39,000日元"}, {"type": "subtitle", "time": 10274.87, "timestamp": "02:51:14", "text": "英镑，00日元兑换成英镑？里面有多少？"}, {"type": "subtitle", "time": 10278.91, "timestamp": "02:51:18", "text": "卢比？呃，单价是312,000，"}, {"type": "subtitle", "time": 10286.07, "timestamp": "02:51:26", "text": "这不是“来吧”。其实没那么糟。"}, {"type": "subtitle", "time": 10295.67, "timestamp": "02:51:35", "text": "对，总金额就是这个数额。"}, {"type": "subtitle", "time": 10298.11, "timestamp": "02:51:38", "text": "等待总计 好的 总金额"}, {"type": "subtitle", "time": 10301.59, "timestamp": "02:51:41", "text": "312 是的，持续了几个月"}, {"type": "subtitle", "time": 10304.71, "timestamp": "02:51:44", "text": "呃，6个月，呃，包括这六个"}, {"type": "subtitle", "time": 10308.71, "timestamp": "02:51:48", "text": "每月测绘费"}, {"type": "subtitle", "time": 10311.99, "timestamp": "02:51:51", "text": "所以总额包含了押金。"}, {"type": "subtitle", "time": 10316.389, "timestamp": "02:51:56", "text": "是的，存款和穹顶进入"}, {"type": "subtitle", "time": 10319.19, "timestamp": "02:51:59", "text": "入学费用 6 个月"}]
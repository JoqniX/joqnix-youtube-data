[{"type": "subtitle", "time": 60.59, "timestamp": "00:01:00", "text": "地牢和获得"}, {"type": "subtitle", "time": 64.63, "timestamp": "00:01:04", "text": "战利品、提升装备、完成任务"}, {"type": "subtitle", "time": 66.99, "timestamp": "00:01:06", "text": "与……交谈"}, {"type": "subtitle", "time": 69.789, "timestamp": "00:01:09", "text": "商人，所有这些"}, {"type": "subtitle", "time": 79.149, "timestamp": "00:01:19", "text": "用黄金。你这话是什么意思，姑娘？它是"}, {"type": "subtitle", "time": 82.91, "timestamp": "00:01:22", "text": "坏的。你是谁？"}, {"type": "subtitle", "time": 86.95, "timestamp": "00:01:26", "text": "发现敌军。我走了。"}, {"type": "subtitle", "time": 90.149, "timestamp": "00:01:30", "text": "我无法点击鼠标左键。我无法居中。"}, {"type": "subtitle", "time": 92.39, "timestamp": "00:01:32", "text": "点击。"}, {"type": "subtitle", "time": 103.91, "timestamp": "00:01:43", "text": "我无法离开电脑。"}, {"type": "subtitle", "time": 106.95, "timestamp": "00:01:46", "text": "还剩一个敌人。好的。"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "我得走了。"}, {"type": "subtitle", "time": 112.95, "timestamp": "00:01:52", "text": "我们很清楚。费用已用完。"}, {"type": "subtitle", "time": 114.71000000000001, "timestamp": "00:01:54", "text": "为什么有时右键单击不起作用"}, {"type": "subtitle", "time": 117.99000000000001, "timestamp": "00:01:57", "text": "在职的？我的天哪。狙击手。不，我的右"}]
[{"type": "subtitle", "time": 2472.55, "timestamp": "00:41:12", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 2479.67, "timestamp": "00:41:19", "text": "最后一名幸存者。好的。感谢上帝。"}, {"type": "subtitle", "time": 2484.23, "timestamp": "00:41:24", "text": "圣哉上帝。派对开始了。"}, {"type": "subtitle", "time": 2486.349, "timestamp": "00:41:26", "text": "换边站。不，"}, {"type": "subtitle", "time": 2489.03, "timestamp": "00:41:29", "text": "它不会像这样冻住。我很害怕。"}, {"type": "subtitle", "time": 2491.589, "timestamp": "00:41:31", "text": "我很害怕。我很害怕。仅77"}, {"type": "subtitle", "time": 2494.95, "timestamp": "00:41:34", "text": "剩余百分比。还剩一小时。我不"}, {"type": "subtitle", "time": 2497.55, "timestamp": "00:41:37", "text": "像冻僵一样盯着我"}, {"type": "subtitle", "time": 2501.43, "timestamp": "00:41:41", "text": "这。我只求这一点。"}, {"type": "subtitle", "time": 2507.55, "timestamp": "00:41:47", "text": "我没了"}]
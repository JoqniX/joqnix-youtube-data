[{"type": "subtitle", "time": 2642.15, "timestamp": "00:44:02", "text": "我认为会用昵称，或者"}, {"type": "subtitle", "time": 2645.67, "timestamp": "00:44:05", "text": "有什么东西他妈的知道这是b"}, {"type": "subtitle", "time": 2646.67, "timestamp": "00:44:06", "text": "数字"}, {"type": "subtitle", "time": 2649.91, "timestamp": "00:44:09", "text": "大概两个吧。这就是我的"}, {"type": "subtitle", "time": 2651.829, "timestamp": "00:44:11", "text": "真是个馊主意。我应该把这个写下来。"}, {"type": "subtitle", "time": 2655.43, "timestamp": "00:44:15", "text": "我的天啊。否则我会忘记。"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "还剩一个敌人。离合器。好的。"}, {"type": "subtitle", "time": 2665.109, "timestamp": "00:44:25", "text": "哦，我的背好痛。每个人都好重。"}, {"type": "subtitle", "time": 2666.87, "timestamp": "00:44:26", "text": "我应该把这个记下来，然后点击向上或"}, {"type": "subtitle", "time": 2669.99, "timestamp": "00:44:29", "text": "某物。重新装弹。因为我忘了。他们"}]
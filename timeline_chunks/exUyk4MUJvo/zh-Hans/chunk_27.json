[{"type": "subtitle", "time": 1622.52, "timestamp": "00:27:02", "text": "蘸过吗？哦，我的"}, {"type": "subtitle", "time": 1624.75, "timestamp": "00:27:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1629.19, "timestamp": "00:27:09", "text": "上帝。我居然熬夜到这么晚了。哦，"}, {"type": "subtitle", "time": 1631.87, "timestamp": "00:27:11", "text": "等待。现在几点了？"}, {"type": "subtitle", "time": 1636.149, "timestamp": "00:27:16", "text": "你？应该是晚上10点左右，对吧？"}, {"type": "subtitle", "time": 1638.149, "timestamp": "00:27:18", "text": "是的，现在是晚上10点。为你。好的。我是"}, {"type": "subtitle", "time": 1650.149, "timestamp": "00:27:30", "text": "乔伊刚刚离开。"}]
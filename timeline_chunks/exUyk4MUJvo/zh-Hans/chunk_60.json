[{"type": "subtitle", "time": 3602.829, "timestamp": "01:00:02", "text": "问题是，我必须玩游戏。"}, {"type": "subtitle", "time": 3605.95, "timestamp": "01:00:05", "text": "很高兴得到"}, {"type": "subtitle", "time": 3609.51, "timestamp": "01:00:09", "text": "XP 和被低估的你只能得到类似的东西"}, {"type": "subtitle", "time": 3614.67, "timestamp": "01:00:14", "text": "但我"}, {"type": "subtitle", "time": 3617.43, "timestamp": "01:00:17", "text": "害怕的。就像担保这件事一样"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "比不足之处要好"}, {"type": "subtitle", "time": 3622.87, "timestamp": "01:00:22", "text": "前后矛盾的。正确的。这就是我的原因"}, {"type": "subtitle", "time": 3625.47, "timestamp": "01:00:25", "text": "想想人们会用尖峰冲刺还是换挡"}, {"type": "subtitle", "time": 3628.67, "timestamp": "01:00:28", "text": "玩。是的。你好。"}, {"type": "subtitle", "time": 3630.2, "timestamp": "01:00:30", "text": "嘘。你怎么样"}, {"type": "subtitle", "time": 3631.549, "timestamp": "01:00:31", "text": "[音乐]"}, {"type": "subtitle", "time": 3634.789, "timestamp": "01:00:34", "text": "正在做？嗯，差不多是这样。和"}, {"type": "subtitle", "time": 3638.23, "timestamp": "01:00:38", "text": "渲染费用是多少？ 84. 那将"}, {"type": "subtitle", "time": 3643.6, "timestamp": "01:00:43", "text": "完成了。尖刺突袭。我得走了。"}, {"type": "subtitle", "time": 3651.99, "timestamp": "01:00:51", "text": "我走了。"}, {"type": "subtitle", "time": 3657.51, "timestamp": "01:00:57", "text": "我一直都很幸运。"}]
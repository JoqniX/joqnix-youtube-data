[{"type": "subtitle", "time": 16142.03, "timestamp": "04:29:02", "text": "向上。我离开了"}, {"type": "subtitle", "time": 16145.71, "timestamp": "04:29:05", "text": "一切。这是正确的。我讨厌"}, {"type": "subtitle", "time": 16157.51, "timestamp": "04:29:17", "text": "嘿。嘿。呃，操。我不去。啊，"}, {"type": "subtitle", "time": 16160.67, "timestamp": "04:29:20", "text": "他妈的。什么？我怎样才能逗人开心？"}, {"type": "subtitle", "time": 16163.189, "timestamp": "04:29:23", "text": "我可以用它来娱乐大家吗？"}, {"type": "subtitle", "time": 16165.99, "timestamp": "04:29:25", "text": "键盘？我怎样才能获得娱乐？什么"}, {"type": "subtitle", "time": 16168.75, "timestamp": "04:29:28", "text": "我该怎么做？我不会玩"}, {"type": "subtitle", "time": 16177.309, "timestamp": "04:29:37", "text": "[音乐]"}, {"type": "subtitle", "time": 16179.91, "timestamp": "04:29:39", "text": "呃，我朋友在教我怎么玩"}, {"type": "subtitle", "time": 16182.63, "timestamp": "04:29:42", "text": "吉他。我想弹吉他。"}, {"type": "subtitle", "time": 16185.79, "timestamp": "04:29:45", "text": "也。等等，玩"}, {"type": "subtitle", "time": 16189.11, "timestamp": "04:29:49", "text": "还。等等，你想看我玩吗？"}, {"type": "subtitle", "time": 16190.91, "timestamp": "04:29:50", "text": "还？我可以做到"}, {"type": "subtitle", "time": 16194.55, "timestamp": "04:29:54", "text": "它。我的平板电脑有驱动程序吗？让我"}, {"type": "subtitle", "time": 16195.79, "timestamp": "04:29:55", "text": "查看。"}, {"type": "subtitle", "time": 16198.67, "timestamp": "04:29:58", "text": "药片。呃，黛薇"}]
[{"type": "subtitle", "time": 10022.15, "timestamp": "02:47:02", "text": "每次都觉得恶心"}, {"type": "subtitle", "time": 10024.95, "timestamp": "02:47:04", "text": "出来。我的天哪。你必须这么做"}, {"type": "subtitle", "time": 10026.74, "timestamp": "02:47:06", "text": "你必须做什么。"}, {"type": "subtitle", "time": 10029.19, "timestamp": "02:47:09", "text": "[音乐]"}, {"type": "subtitle", "time": 10030.63, "timestamp": "02:47:10", "text": "你会在那边睡床。"}, {"type": "subtitle", "time": 10045.19, "timestamp": "02:47:25", "text": "有点，嗯，是的，我在想它会"}, {"type": "subtitle", "time": 10047.91, "timestamp": "02:47:27", "text": "对我来说，单人间更好。"}, {"type": "subtitle", "time": 10050.79, "timestamp": "02:47:30", "text": "单人间，而不是房间"}, {"type": "subtitle", "time": 10054.309, "timestamp": "02:47:34", "text": "因为要和室友合住双人房，所以"}, {"type": "subtitle", "time": 10057.83, "timestamp": "02:47:37", "text": "呃，我已经听说像学生一样了。"}, {"type": "subtitle", "time": 10060.309, "timestamp": "02:47:40", "text": "四月份去的同学"}, {"type": "subtitle", "time": 10062.79, "timestamp": "02:47:42", "text": "他们说的那些事，是的，甚至"}, {"type": "subtitle", "time": 10065.59, "timestamp": "02:47:45", "text": "如果你从房间里打电话，"}, {"type": "subtitle", "time": 10068.23, "timestamp": "02:47:48", "text": "对其他人来说很烦人，所以……"}, {"type": "subtitle", "time": 10071.309, "timestamp": "02:47:51", "text": "会收到很多噪音投诉，所以我"}, {"type": "subtitle", "time": 10074.71, "timestamp": "02:47:54", "text": "从某种意义上说，什么对我更有利？"}, {"type": "subtitle", "time": 10076.67, "timestamp": "02:47:56", "text": "由于我正在直播和设置"}, {"type": "subtitle", "time": 10079.75, "timestamp": "02:47:59", "text": "如果一切都好的话……"}]
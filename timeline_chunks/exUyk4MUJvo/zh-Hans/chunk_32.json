[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "上帝。哦，我们赢了。什么？哦，等等。他们"}, {"type": "subtitle", "time": 1929.19, "timestamp": "00:32:09", "text": "好的。我讨厌当警察这件事，因为我做不到"}, {"type": "subtitle", "time": 1951.11, "timestamp": "00:32:31", "text": "很多。敌人发现我了。"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "准备好了。开始了。一个敌人"}]
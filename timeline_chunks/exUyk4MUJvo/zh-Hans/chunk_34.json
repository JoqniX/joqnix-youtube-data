[{"type": "subtitle", "time": 2046.71, "timestamp": "00:34:06", "text": "我的小号准备好了。已种下穗。那里"}, {"type": "subtitle", "time": 2060.55, "timestamp": "00:34:20", "text": "我的天啊。"}, {"type": "subtitle", "time": 2065.829, "timestamp": "00:34:25", "text": "你的足迹。他心想，他是认真的吗？"}, {"type": "subtitle", "time": 2069.069, "timestamp": "00:34:29", "text": "我觉得他挂机了"}, {"type": "subtitle", "time": 2072.149, "timestamp": "00:34:32", "text": "宏？挂机刷怪。"}, {"type": "subtitle", "time": 2076.069, "timestamp": "00:34:36", "text": "最后一名幸存者。费用已结清。我"}, {"type": "subtitle", "time": 2096.149, "timestamp": "00:34:56", "text": "该死，他从出生点到……的移动方式"}]
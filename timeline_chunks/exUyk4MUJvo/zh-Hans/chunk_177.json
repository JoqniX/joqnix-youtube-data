[{"type": "subtitle", "time": 10623.03, "timestamp": "02:57:03", "text": "该死。价格是相对的。所以，"}, {"type": "subtitle", "time": 10624.79, "timestamp": "02:57:04", "text": "你付的钱少了很多"}, {"type": "subtitle", "time": 10627.31, "timestamp": "02:57:07", "text": "你的学费。"}, {"type": "subtitle", "time": 10628.79, "timestamp": "02:57:08", "text": "[音乐]"}, {"type": "subtitle", "time": 10630.71, "timestamp": "02:57:10", "text": "你无需支付任何费用。比如，我付钱。"}, {"type": "subtitle", "time": 10633.51, "timestamp": "02:57:13", "text": "学费要翻倍。"}, {"type": "subtitle", "time": 10636.309, "timestamp": "02:57:16", "text": "是的。"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "所以，一切都吻合了。所以，你"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "不必担心。"}, {"type": "subtitle", "time": 10642.87, "timestamp": "02:57:22", "text": "但相信我，千万别弄错，千万别弄错"}, {"type": "subtitle", "time": 10644.87, "timestamp": "02:57:24", "text": "双人间。不要和某人交往"}, {"type": "subtitle", "time": 10647.75, "timestamp": "02:57:27", "text": "别的。是的。我想。"}, {"type": "subtitle", "time": 10657.59, "timestamp": "02:57:37", "text": "嗯，我从四月份的进货量中注意到了一些情况。"}, {"type": "subtitle", "time": 10660.309, "timestamp": "02:57:40", "text": "人学生批次呃，有"}, {"type": "subtitle", "time": 10663.269, "timestamp": "02:57:43", "text": "十二月课程的某位学员"}, {"type": "subtitle", "time": 10666.71, "timestamp": "02:57:46", "text": "立即进入下一阶段的那批人"}, {"type": "subtitle", "time": 10668.63, "timestamp": "02:57:48", "text": "面试通过，一切顺利。所以他"}, {"type": "subtitle", "time": 10672.71, "timestamp": "02:57:52", "text": "进入四月份招生名单的人"}, {"type": "subtitle", "time": 10676.23, "timestamp": "02:57:56", "text": "就像是从2014年12月开始的"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "一批或者类似混合批次的东西。"}, {"type": "subtitle", "time": 10679.469, "timestamp": "02:57:59", "text": "是的。"}]
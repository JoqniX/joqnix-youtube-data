[{"type": "subtitle", "time": 6180.95, "timestamp": "01:43:00", "text": "对，就是这样。所以我觉得应该会有。"}, {"type": "subtitle", "time": 6184.87, "timestamp": "01:43:04", "text": "呃，六月和七月有五名学生。"}, {"type": "subtitle", "time": 6186.47, "timestamp": "01:43:06", "text": "摄入量。"}, {"type": "subtitle", "time": 6188.87, "timestamp": "01:43:08", "text": "是的。是的。五个学生嗯，同"}, {"type": "subtitle", "time": 6191.83, "timestamp": "01:43:11", "text": "学校。是的。就是这样。好的。至少"}, {"type": "subtitle", "time": 6193.75, "timestamp": "01:43:13", "text": "你有伴侣。"}, {"type": "subtitle", "time": 6196.79, "timestamp": "01:43:16", "text": "是的。这是件好事。我进去了"}, {"type": "subtitle", "time": 6197.83, "timestamp": "01:43:17", "text": "孤身一人，你知道的。我不知道"}, {"type": "subtitle", "time": 6200.31, "timestamp": "01:43:20", "text": "任何人。我只是，我只是，呃，祈祷，祈祷"}, {"type": "subtitle", "time": 6202.629, "timestamp": "01:43:22", "text": "然后我就走了，就好像我没事一样。我"}, {"type": "subtitle", "time": 6205.229, "timestamp": "01:43:25", "text": "我会在那里交朋友。"}, {"type": "subtitle", "time": 6207.75, "timestamp": "01:43:27", "text": "是的。我相信你确实做到了。"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "朋友，对吧？我的意思是，是的。是的。但"}, {"type": "subtitle", "time": 6215.27, "timestamp": "01:43:35", "text": "你还好吗？所以，你觉得这很有趣"}, {"type": "subtitle", "time": 6218.709, "timestamp": "01:43:38", "text": "情况。我交到了朋友。"}, {"type": "subtitle", "time": 6222.229, "timestamp": "01:43:42", "text": "呃，但问题是我不得不……"}, {"type": "subtitle", "time": 6225.27, "timestamp": "01:43:45", "text": "离开我以前居住的城市。所以，"}, {"type": "subtitle", "time": 6227.59, "timestamp": "01:43:47", "text": "就我目前的情况而言，我必须开始"}, {"type": "subtitle", "time": 6231.35, "timestamp": "01:43:51", "text": "从零开始。哦，不。"}, {"type": "subtitle", "time": 6235.59, "timestamp": "01:43:55", "text": "但没关系。我重新开始。 M"}, {"type": "subtitle", "time": 6237.27, "timestamp": "01:43:57", "text": "你知道，这是那种对话之一。"}]
[{"type": "subtitle", "time": 16801.55, "timestamp": "04:40:01", "text": "别再说“我会做”，直接去做就好。"}, {"type": "subtitle", "time": 16833.67, "timestamp": "04:40:33", "text": "好的。今天真是美好的一天。我"}, {"type": "subtitle", "time": 16837.03, "timestamp": "04:40:37", "text": "本来可以做得更好。他妈的。"}, {"type": "subtitle", "time": 16839.27, "timestamp": "04:40:39", "text": "但是，但是，但是，米娅，我"}, {"type": "subtitle", "time": 16842.43, "timestamp": "04:40:42", "text": "希望人们"}, {"type": "subtitle", "time": 16844.43, "timestamp": "04:40:44", "text": "你"}, {"type": "subtitle", "time": 16847.99, "timestamp": "04:40:47", "text": "大家都很喜欢。即使我没有，"}, {"type": "subtitle", "time": 16850.47, "timestamp": "04:40:50", "text": "至少你还能享受片刻的宁静。"}, {"type": "subtitle", "time": 16851.55, "timestamp": "04:40:51", "text": "溪流。"}, {"type": "subtitle", "time": 16858.83, "timestamp": "04:40:58", "text": "再次祝您玩得愉快！"}]
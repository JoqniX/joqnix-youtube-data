[{"type": "subtitle", "time": 7260.229, "timestamp": "02:01:00", "text": "好像她没空似的。"}, {"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "生病之类的。现在"}, {"type": "subtitle", "time": 7264.47, "timestamp": "02:01:04", "text": "现在真相大白了。所以"}, {"type": "subtitle", "time": 7267.589, "timestamp": "02:01:07", "text": "每个人都像……呃……拉屎一样"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "就辛德所做的事以及她的"}, {"type": "subtitle", "time": 7273.109, "timestamp": "02:01:13", "text": "经理这么做了，因为……最后"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "辛德的道歉简直就是她的道歉。"}, {"type": "subtitle", "time": 7280.87, "timestamp": "02:01:20", "text": "她把责任推卸给了她的经纪人，也就是她的男朋友。"}, {"type": "subtitle", "time": 7283.669, "timestamp": "02:01:23", "text": "这是"}, {"type": "subtitle", "time": 7287.589, "timestamp": "02:01:27", "text": "好的。我理解TLDDR，也就是"}, {"type": "subtitle", "time": 7291.109, "timestamp": "02:01:31", "text": "基本上，呃，人们都想得到人"}, {"type": "subtitle", "time": 7293.51, "timestamp": "02:01:33", "text": "他们想迅速走红，而且他们也确实做到了。"}, {"type": "subtitle", "time": 7295.87, "timestamp": "02:01:35", "text": "各种各样愚蠢的事。"}, {"type": "subtitle", "time": 7302.149, "timestamp": "02:01:42", "text": "是的。我的天啊。我猜我猜呃"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "呃，该怎么说呢？在最"}, {"type": "subtitle", "time": 7315.26, "timestamp": "02:01:55", "text": "我的天啊。好的。对她来说是好事。"}, {"type": "subtitle", "time": 7316.55, "timestamp": "02:01:56", "text": "[音乐]"}]
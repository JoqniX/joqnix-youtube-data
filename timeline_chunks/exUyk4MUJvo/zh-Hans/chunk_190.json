[{"type": "subtitle", "time": 11400.23, "timestamp": "03:10:00", "text": "就是这么多。工作原理如下。"}, {"type": "subtitle", "time": 11404.79, "timestamp": "03:10:04", "text": "就是这样。所以，另外我还得……"}, {"type": "subtitle", "time": 11407.99, "timestamp": "03:10:07", "text": "是啊，因为人们为此付出了代价。"}, {"type": "subtitle", "time": 11410.71, "timestamp": "03:10:10", "text": "艺术。所以，我必须付钱给他们。"}, {"type": "subtitle", "time": 11415.429, "timestamp": "03:10:15", "text": "钱的东西。但是，自从……以来"}, {"type": "subtitle", "time": 11418.23, "timestamp": "03:10:18", "text": "自艺术创作以来已有七八个月了。"}, {"type": "subtitle", "time": 11422.469, "timestamp": "03:10:22", "text": "事情已经发生了，因为我现在意识到了"}, {"type": "subtitle", "time": 11425.99, "timestamp": "03:10:25", "text": "有很多缺陷之类的。"}, {"type": "subtitle", "time": 11427.99, "timestamp": "03:10:27", "text": "不，但那确实是一笔巨款。"}, {"type": "subtitle", "time": 11429.91, "timestamp": "03:10:29", "text": "钱。"}, {"type": "subtitle", "time": 11431.429, "timestamp": "03:10:31", "text": "是的。是的。是的。这是一笔巨款。"}, {"type": "subtitle", "time": 11433.91, "timestamp": "03:10:33", "text": "钱。是的。也就是说，我没有"}, {"type": "subtitle", "time": 11435.91, "timestamp": "03:10:35", "text": "你知道那件事，你知道，就像我一样。"}, {"type": "subtitle", "time": 11438.469, "timestamp": "03:10:38", "text": "就像一种爱好。那就像"}, {"type": "subtitle", "time": 11440.71, "timestamp": "03:10:40", "text": "当你处于人生的某个阶段"}, {"type": "subtitle", "time": 11442.63, "timestamp": "03:10:42", "text": "赚钱赚钱，你只想"}, {"type": "subtitle", "time": 11444.469, "timestamp": "03:10:44", "text": "培养一个爱好，就像我理解的那样"}, {"type": "subtitle", "time": 11447.59, "timestamp": "03:10:47", "text": "这只是我的一个爱好，但我实在无法接受这个价格。"}, {"type": "subtitle", "time": 11449.51, "timestamp": "03:10:49", "text": "抱歉，没办法。"}, {"type": "subtitle", "time": 11453.75, "timestamp": "03:10:53", "text": "我基本上主要画画，好吧，500幅画。"}, {"type": "subtitle", "time": 11458.15, "timestamp": "03:10:58", "text": "好吧，我会给500个艺术品，好吧"}]
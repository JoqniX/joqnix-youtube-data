[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "但千万别找主播。"}, {"type": "subtitle", "time": 9962.469, "timestamp": "02:46:02", "text": "不要找那种精神不正常的主播。"}, {"type": "subtitle", "time": 9965.349, "timestamp": "02:46:05", "text": "就像你一样。是的。"}, {"type": "subtitle", "time": 9968.63, "timestamp": "02:46:08", "text": "我的天啊。是的。"}, {"type": "subtitle", "time": 9970.63, "timestamp": "02:46:10", "text": "如果她疯了，你的房子就完了。"}, {"type": "subtitle", "time": 9972.55, "timestamp": "02:46:12", "text": "粗暴一点。没有人会进来。"}, {"type": "subtitle", "time": 9975.269, "timestamp": "02:46:15", "text": "那就去你家吧。"}, {"type": "subtitle", "time": 9976.95, "timestamp": "02:46:16", "text": "没错。真的。我不知道它有多大"}, {"type": "subtitle", "time": 9978.309, "timestamp": "02:46:18", "text": "房间就在那里。你有吗？"}, {"type": "subtitle", "time": 9981.91, "timestamp": "02:46:21", "text": "那边预订了房间之类的东西吗？所以，我"}, {"type": "subtitle", "time": 9984.03, "timestamp": "02:46:24", "text": "我想我会得到关于……的信息"}, {"type": "subtitle", "time": 9988.23, "timestamp": "02:46:28", "text": "在此之前，本月将进行测绘。啊，"}, {"type": "subtitle", "time": 9990.55, "timestamp": "02:46:30", "text": "你要去吗？嗯。是的。所以相信我，"}, {"type": "subtitle", "time": 9992.95, "timestamp": "02:46:32", "text": "你就能拥有一个好厕所了。"}, {"type": "subtitle", "time": 9995.429, "timestamp": "02:46:35", "text": "那里。日本的马桶是最好的。"}, {"type": "subtitle", "time": 9998.23, "timestamp": "02:46:38", "text": "世界。哦，"}, {"type": "subtitle", "time": 9999.349, "timestamp": "02:46:39", "text": "所有你能做的事情，你都要去做。"}, {"type": "subtitle", "time": 10003.19, "timestamp": "02:46:43", "text": "可以安心地拉屎。就是这样。"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "兄弟，你需要的就是这个。相信我"}, {"type": "subtitle", "time": 10006.389, "timestamp": "02:46:46", "text": "在英国，他们不在乎。"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "关于厕所。我的天啊。在英国等着吧"}, {"type": "subtitle", "time": 10012.79, "timestamp": "02:46:52", "text": "水里有那部分或什么东西。"}, {"type": "subtitle", "time": 10015.75, "timestamp": "02:46:55", "text": "它流动着。相信我。相信我。你"}, {"type": "subtitle", "time": 10019.99, "timestamp": "02:46:59", "text": "你正在使用纸张。我的天啊。它"}]
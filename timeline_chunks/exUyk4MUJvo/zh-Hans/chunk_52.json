[{"type": "subtitle", "time": 3121.43, "timestamp": "00:52:01", "text": "聊聊会很有帮助。"}, {"type": "subtitle", "time": 3124.069, "timestamp": "00:52:04", "text": "好的，我会的。你们可以拥有一个"}, {"type": "subtitle", "time": 3126.549, "timestamp": "00:52:06", "text": "能力"}, {"type": "subtitle", "time": 3129.109, "timestamp": "00:52:09", "text": "字符"}, {"type": "subtitle", "time": 3133.109, "timestamp": "00:52:13", "text": "能够更改您的用户名"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "或者像这样设置你的用户名。我"}, {"type": "subtitle", "time": 3136.79, "timestamp": "00:52:16", "text": "你还需要更改用户名。一"}, {"type": "subtitle", "time": 3139.27, "timestamp": "00:52:19", "text": "敌军残余。我该怎么做呢？我"}, {"type": "subtitle", "time": 3141.47, "timestamp": "00:52:21", "text": "不知道。它有点沉重"}, {"type": "subtitle", "time": 3145.39, "timestamp": "00:52:25", "text": "方法。但我希望我"}, {"type": "subtitle", "time": 3148.43, "timestamp": "00:52:28", "text": "希望我能"}, {"type": "subtitle", "time": 3169.109, "timestamp": "00:52:49", "text": "上半场最后一轮。你好。这"}, {"type": "subtitle", "time": 3171.39, "timestamp": "00:52:51", "text": "菲尼克斯刚刚封锁了"}, {"type": "subtitle", "time": 3173.41, "timestamp": "00:52:53", "text": "杀。哦，我的"}, {"type": "subtitle", "time": 3175.39, "timestamp": "00:52:55", "text": "[音乐]"}, {"type": "subtitle", "time": 3178.75, "timestamp": "00:52:58", "text": "上帝。我讨厌狙击手，因为我妈不会玩。"}]
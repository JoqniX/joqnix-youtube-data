[{"type": "subtitle", "time": 15669.269, "timestamp": "04:21:09", "text": "那。加油，兄弟。"}, {"type": "subtitle", "time": 15672.189, "timestamp": "04:21:12", "text": "呃，希望你没听到那句话。"}, {"type": "subtitle", "time": 15675.349, "timestamp": "04:21:15", "text": "嗓音。好的，我回来了。使用你的"}, {"type": "subtitle", "time": 15677.87, "timestamp": "04:21:17", "text": "投票灯"}, {"type": "subtitle", "time": 15680.67, "timestamp": "04:21:20", "text": "适当地。"}, {"type": "subtitle", "time": 15683.83, "timestamp": "04:21:23", "text": "嗯，我不知道，我不知道我是否在给予"}, {"type": "subtitle", "time": 15689.229, "timestamp": "04:21:29", "text": "他妈的。我不戴身份证，女朋友不会做这种事"}, {"type": "subtitle", "time": 15692.189, "timestamp": "04:21:32", "text": "这。我不知道。"}, {"type": "subtitle", "time": 15694.429, "timestamp": "04:21:34", "text": "但西班牙"}, {"type": "subtitle", "time": 15697.91, "timestamp": "04:21:37", "text": "PCO，我最初几年都在国外。"}, {"type": "subtitle", "time": 15706.309, "timestamp": "04:21:46", "text": "哦，我还是不了解政治。"}, {"type": "subtitle", "time": 15713.83, "timestamp": "04:21:53", "text": "知道。这些人承诺了很多事，但"}, {"type": "subtitle", "time": 15715.469, "timestamp": "04:21:55", "text": "绝不"}, {"type": "subtitle", "time": 15719.83, "timestamp": "04:21:59", "text": "做。 Punikat 的问候，感谢您的光临！"}]
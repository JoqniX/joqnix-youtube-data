[{"type": "subtitle", "time": 12240.71, "timestamp": "03:24:00", "text": "我有个兄弟姐妹，他们最终会"}, {"type": "subtitle", "time": 12243.03, "timestamp": "03:24:03", "text": "是的，他们会那样做的，我想我可以。"}, {"type": "subtitle", "time": 12245.19, "timestamp": "03:24:05", "text": "明白了"}, {"type": "subtitle", "time": 12247.59, "timestamp": "03:24:07", "text": "因为我觉得，嗯，我觉得在某个时候"}, {"type": "subtitle", "time": 12253.429, "timestamp": "03:24:13", "text": "你可能需要……你可能需要某人"}, {"type": "subtitle", "time": 12256.15, "timestamp": "03:24:16", "text": "直接让电脑闭嘴，然后说“好了，开始吧”"}, {"type": "subtitle", "time": 12259.55, "timestamp": "03:24:19", "text": "现在学习啊"}, {"type": "subtitle", "time": 12262.79, "timestamp": "03:24:22", "text": "是的，但我得学会……"}, {"type": "subtitle", "time": 12265.269, "timestamp": "03:24:25", "text": "控制并实际做其他事情"}, {"type": "subtitle", "time": 12268.67, "timestamp": "03:24:28", "text": "工作，然后出去，保持这个"}, {"type": "subtitle", "time": 12271.59, "timestamp": "03:24:31", "text": "最低限度。我以前确实这么做过。"}, {"type": "subtitle", "time": 12274.11, "timestamp": "03:24:34", "text": "在我三月份做这件事之前"}, {"type": "subtitle", "time": 12278.389, "timestamp": "03:24:38", "text": "继续。我当时就想，嗯，一开始是这样。"}, {"type": "subtitle", "time": 12280.469, "timestamp": "03:24:40", "text": "我本来不应该做这些事的。所以，我"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "当时我就说：“是啊，我要去日本。”"}, {"type": "subtitle", "time": 12286.71, "timestamp": "03:24:46", "text": "七月了，所以我打算放松一下。得到"}, {"type": "subtitle", "time": 12288.87, "timestamp": "03:24:48", "text": "去健身房什么的，开始去……"}, {"type": "subtitle", "time": 12291.229, "timestamp": "03:24:51", "text": "去健身房，锻炼身体，因为我"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "不健康，而且简直就是一根棍子。"}, {"type": "subtitle", "time": 12295.71, "timestamp": "03:24:55", "text": "此时只剩下骨头了。不吃"}, {"type": "subtitle", "time": 12298.229, "timestamp": "03:24:58", "text": "妥善准备，比如做好健康准备"}]
[{"type": "subtitle", "time": 10861.67, "timestamp": "03:01:01", "text": "比如 24 个月 21 个月 就像对。所以，"}, {"type": "subtitle", "time": 10865.03, "timestamp": "03:01:05", "text": "我当时就想，他们是不是有个完整的"}, {"type": "subtitle", "time": 10866.95, "timestamp": "03:01:06", "text": "足球场，一块类似场地"}, {"type": "subtitle", "time": 10868.79, "timestamp": "03:01:08", "text": "合租房之类的？如何"}, {"type": "subtitle", "time": 10870.71, "timestamp": "03:01:10", "text": "这项工作？"}, {"type": "subtitle", "time": 10872.389, "timestamp": "03:01:12", "text": "我的意思是，他们可能拥有，他们可能拥有"}, {"type": "subtitle", "time": 10874.23, "timestamp": "03:01:14", "text": "呃，它叫什么来着？不同的"}, {"type": "subtitle", "time": 10876.07, "timestamp": "03:01:16", "text": "他们出租的房产"}, {"type": "subtitle", "time": 10877.59, "timestamp": "03:01:17", "text": "学生。"}, {"type": "subtitle", "time": 10879.19, "timestamp": "03:01:19", "text": "哦，"}, {"type": "subtitle", "time": 10881.19, "timestamp": "03:01:21", "text": "是的。在英国，他们的做法是他们"}, {"type": "subtitle", "time": 10883.67, "timestamp": "03:01:23", "text": "实际上，它们拥有村庄，这些村庄就是它们。"}, {"type": "subtitle", "time": 10885.83, "timestamp": "03:01:25", "text": "确定学生村及所有"}, {"type": "subtitle", "time": 10889.59, "timestamp": "03:01:29", "text": "学生们将住在那里。啊"}, {"type": "subtitle", "time": 10891.429, "timestamp": "03:01:31", "text": "是的。所以我以前住的地方，他们过去常常"}, {"type": "subtitle", "time": 10894.15, "timestamp": "03:01:34", "text": "把这叫做……呃，我以前住在一个类似……的地方"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "一个全是学生的公寓楼。"}, {"type": "subtitle", "time": 10899.349, "timestamp": "03:01:39", "text": "好的。好的。"}, {"type": "subtitle", "time": 10900.95, "timestamp": "03:01:40", "text": "是的。就像不同的建筑物一样，"}, {"type": "subtitle", "time": 10903.349, "timestamp": "03:01:43", "text": "不同的房子，房子之间有道路，"}, {"type": "subtitle", "time": 10910.87, "timestamp": "03:01:50", "text": "哦。就是这样，我"}, {"type": "subtitle", "time": 10913.51, "timestamp": "03:01:53", "text": "猜是因为有6个月的时间。"}, {"type": "subtitle", "time": 10915.269, "timestamp": "03:01:55", "text": "你大概能明白你在哪里"}, {"type": "subtitle", "time": 10917.91, "timestamp": "03:01:57", "text": "位于。你随时可以出门去寻找。"}]
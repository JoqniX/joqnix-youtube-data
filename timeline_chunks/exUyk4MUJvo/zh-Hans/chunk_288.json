[{"type": "subtitle", "time": 17283.75, "timestamp": "04:48:03", "text": "拖延症和其他一些事，试试看吧。"}, {"type": "subtitle", "time": 17288.31, "timestamp": "04:48:08", "text": "努力寻找自我，然后去做。"}, {"type": "subtitle", "time": 17290.948, "timestamp": "04:48:10", "text": "你知道，那是我的主要"}, {"type": "subtitle", "time": 17293.51, "timestamp": "04:48:13", "text": "建议，以及我也会提供的建议。"}, {"type": "subtitle", "time": 17303.868, "timestamp": "04:48:23", "text": "所以，过来吧。"}, {"type": "subtitle", "time": 17310.11, "timestamp": "04:48:30", "text": "去。我真是太……了。我希望我醒来的时候"}, {"type": "subtitle", "time": 17311.628, "timestamp": "04:48:31", "text": "早期的。"}, {"type": "subtitle", "time": 17316.788, "timestamp": "04:48:36", "text": "一小时后起床。是的，我睡觉"}, {"type": "subtitle", "time": 17319.35, "timestamp": "04:48:39", "text": "现在。一两个小时后起床。然后这样做"}, {"type": "subtitle", "time": 17322.868, "timestamp": "04:48:42", "text": "可以播放。然后死去，并在其中"}, {"type": "subtitle", "time": 17326.03, "timestamp": "04:48:46", "text": "明天早上8点或9点做"}, {"type": "subtitle", "time": 17331.51, "timestamp": "04:48:51", "text": "YouTube看到凌晨4点，然后就死了，然后睡觉。"}, {"type": "subtitle", "time": 17338.39, "timestamp": "04:48:58", "text": "早上8点到凌晨3点，等等，呃，到凌晨12点。Twitch"}]
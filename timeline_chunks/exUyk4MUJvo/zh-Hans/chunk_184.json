[{"type": "subtitle", "time": 11044.07, "timestamp": "03:04:04", "text": "未来和你的爱好。是的。"}, {"type": "subtitle", "time": 11046.469, "timestamp": "03:04:06", "text": "所以你喜欢四五个游泳池。"}, {"type": "subtitle", "time": 11049.349, "timestamp": "03:04:09", "text": "基于此。所以爱好池就此诞生"}, {"type": "subtitle", "time": 11052.309, "timestamp": "03:04:12", "text": "结束，因为这四个人是三个"}, {"type": "subtitle", "time": 11054.309, "timestamp": "03:04:14", "text": "您目前想查看的游泳池"}, {"type": "subtitle", "time": 11057.51, "timestamp": "03:04:17", "text": "你的首要任务是什么？是的，"}, {"type": "subtitle", "time": 11059.349, "timestamp": "03:04:19", "text": "我想这就是我的意思吧。"}, {"type": "subtitle", "time": 11061.269, "timestamp": "03:04:21", "text": "我以前不知道这些。我最近"}, {"type": "subtitle", "time": 11063.75, "timestamp": "03:04:23", "text": "开始出现……嗯……它叫什么来着？我"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "最近开始收到来自"}, {"type": "subtitle", "time": 11067.91, "timestamp": "03:04:27", "text": "工作等等，这就是我"}, {"type": "subtitle", "time": 11070.23, "timestamp": "03:04:30", "text": "决定了我想把什么东西转移到哪里"}, {"type": "subtitle", "time": 11072.469, "timestamp": "03:04:32", "text": "我的重点是什么？你得决定。"}, {"type": "subtitle", "time": 11074.469, "timestamp": "03:04:34", "text": "关于你每月支出的用途"}, {"type": "subtitle", "time": 11079.83, "timestamp": "03:04:39", "text": "对我来说，在英国大概是200英镑左右。"}, {"type": "subtitle", "time": 11082.309, "timestamp": "03:04:42", "text": "也就是每月20000卢比。"}, {"type": "subtitle", "time": 11084.71, "timestamp": "03:04:44", "text": "食物和其他一切"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "啊"}, {"type": "subtitle", "time": 11089.269, "timestamp": "03:04:49", "text": "在日本，这可能对你来说没那么重要。"}, {"type": "subtitle", "time": 11092.15, "timestamp": "03:04:52", "text": "可能就像……呃，我不知道日元是多少，但是"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "假设你在日本，结果你就像"}, {"type": "subtitle", "time": 11097.99, "timestamp": "03:04:57", "text": "每月 5,000 至 8,000 美元，用于您的"}]
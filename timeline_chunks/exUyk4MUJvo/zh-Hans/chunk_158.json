[{"type": "subtitle", "time": 9481.19, "timestamp": "02:38:01", "text": "所以那将会是"}, {"type": "subtitle", "time": 9491.27, "timestamp": "02:38:11", "text": "我没有。你知道，就是这样。"}, {"type": "subtitle", "time": 9494.55, "timestamp": "02:38:14", "text": "简直近乎疯狂。"}, {"type": "subtitle", "time": 9497.23, "timestamp": "02:38:17", "text": "你你我"}, {"type": "subtitle", "time": 9499.15, "timestamp": "02:38:19", "text": "想想看"}, {"type": "subtitle", "time": 9501.19, "timestamp": "02:38:21", "text": "我不知道该说什么。"}, {"type": "subtitle", "time": 9504.79, "timestamp": "02:38:24", "text": "观点。这真是令人费解。"}, {"type": "subtitle", "time": 9507.83, "timestamp": "02:38:27", "text": "是的，我需要关掉电脑。喜欢"}, {"type": "subtitle", "time": 9510.15, "timestamp": "02:38:30", "text": "让我查一下。某人"}, {"type": "subtitle", "time": 9512.71, "timestamp": "02:38:32", "text": "需要到那里来，然后就六天。"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "我的意思是，简直太疯狂了。"}, {"type": "subtitle", "time": 9523.59, "timestamp": "02:38:43", "text": "等级。"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "我当时就像突然冒出一个想法一样。"}, {"type": "subtitle", "time": 9529.91, "timestamp": "02:38:49", "text": "最终我还是要去日本。"}, {"type": "subtitle", "time": 9532.15, "timestamp": "02:38:52", "text": "东西。这将是我最后一次……"}, {"type": "subtitle", "time": 9534.309, "timestamp": "02:38:54", "text": "在日本，我拥有自由等等。"}, {"type": "subtitle", "time": 9536.63, "timestamp": "02:38:56", "text": "我必须做一个负责任的成年人，"}, {"type": "subtitle", "time": 9538.07, "timestamp": "02:38:58", "text": "东西。不，不，你会得到"}, {"type": "subtitle", "time": 9539.349, "timestamp": "02:38:59", "text": "你终将获得自由"}]
[{"type": "subtitle", "time": 12662.229, "timestamp": "03:31:02", "text": "我闭上眼睛就睡着了。"}, {"type": "subtitle", "time": 12664.71, "timestamp": "03:31:04", "text": "昨天我大概有五个合作项目。"}, {"type": "subtitle", "time": 12667.59, "timestamp": "03:31:07", "text": "一天之中发生的事。所以就像早上11点那样"}, {"type": "subtitle", "time": 12672.07, "timestamp": "03:31:12", "text": "然后下午2点，然后晚上6点"}, {"type": "subtitle", "time": 12675.269, "timestamp": "03:31:15", "text": "晚上大约8点。最初是"}, {"type": "subtitle", "time": 12678.79, "timestamp": "03:31:18", "text": "10，然后变成了8，然后……"}, {"type": "subtitle", "time": 12681.91, "timestamp": "03:31:21", "text": "凌晨2点半那件事，是啊，我当时真是……"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "筋疲力尽的。你疯了。"}, {"type": "subtitle", "time": 12689.349, "timestamp": "03:31:29", "text": "我不知道。我当时就像我想要的那样"}, {"type": "subtitle", "time": 12692.309, "timestamp": "03:31:32", "text": "与所有人建立联系，因为我遇到的人"}, {"type": "subtitle", "time": 12696.55, "timestamp": "03:31:36", "text": "我现在很珍惜他们。即使你选择迷彩"}, {"type": "subtitle", "time": 12700.469, "timestamp": "03:31:40", "text": "我很看重你。你重视我们胜过"}, {"type": "subtitle", "time": 12703.83, "timestamp": "03:31:43", "text": "你自己，也就是"}, {"type": "subtitle", "time": 12705.75, "timestamp": "03:31:45", "text": "啊，对，还有那个。我需要努力"}, {"type": "subtitle", "time": 12708.03, "timestamp": "03:31:48", "text": "那。"}, {"type": "subtitle", "time": 12712.15, "timestamp": "03:31:52", "text": "是的，我很感激你重视我们，但是"}]
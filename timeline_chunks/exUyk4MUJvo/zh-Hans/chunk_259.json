[{"type": "subtitle", "time": 15555.269, "timestamp": "04:19:15", "text": "好了，我回来了。回来。回来。"}, {"type": "subtitle", "time": 15558.03, "timestamp": "04:19:18", "text": "回来。去。"}, {"type": "subtitle", "time": 15561.229, "timestamp": "04:19:21", "text": "去。我应该停止"}, {"type": "subtitle", "time": 15563.55, "timestamp": "04:19:23", "text": "那。"}, {"type": "subtitle", "time": 15567.469, "timestamp": "04:19:27", "text": "你好。我的聊天记录变成了"}, {"type": "subtitle", "time": 15569.389, "timestamp": "04:19:29", "text": "溪流。"}, {"type": "subtitle", "time": 15573.63, "timestamp": "04:19:33", "text": "嗨，哥们。矿工甚至像向上一样"}, {"type": "subtitle", "time": 15578.51, "timestamp": "04:19:38", "text": "向下。上帝你好"}, {"type": "subtitle", "time": 15584.95, "timestamp": "04:19:44", "text": "骑警。好的。我对此的感受"}, {"type": "subtitle", "time": 15588.269, "timestamp": "04:19:48", "text": "关于饲料。我知道是"}, {"type": "subtitle", "time": 15591.03, "timestamp": "04:19:51", "text": "奥卡多。你知道我将学到什么吗？哦"}]
[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "两个，呃，两个双人房，就像……是的"}, {"type": "subtitle", "time": 10143.269, "timestamp": "02:49:03", "text": "房间里会有一个完整的房间"}, {"type": "subtitle", "time": 10145.269, "timestamp": "02:49:05", "text": "房子之类的，但会有两个。"}, {"type": "subtitle", "time": 10147.349, "timestamp": "02:49:07", "text": "喜欢那样的人，而且只有一个房间"}, {"type": "subtitle", "time": 10150.309, "timestamp": "02:49:10", "text": "以及两种房型，双人房"}, {"type": "subtitle", "time": 10153.429, "timestamp": "02:49:13", "text": "单人间（含空调）"}, {"type": "subtitle", "time": 10156.71, "timestamp": "02:49:16", "text": "护发素之类的东西。等等，我"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "想想他们可能指的是两个人"}, {"type": "subtitle", "time": 10161.91, "timestamp": "02:49:21", "text": "如果你要来的话，可以住在同一个房间。"}, {"type": "subtitle", "time": 10163.99, "timestamp": "02:49:23", "text": "和某人在一起。难道那不就是他们说的吗？"}, {"type": "subtitle", "time": 10168.55, "timestamp": "02:49:28", "text": "意思是？我不太确定。让我去找找"}, {"type": "subtitle", "time": 10171.91, "timestamp": "02:49:31", "text": "想和你分享。因为是"}, {"type": "subtitle", "time": 10174.87, "timestamp": "02:49:34", "text": "更贵吗？是的，单曲"}, {"type": "subtitle", "time": 10177.19, "timestamp": "02:49:37", "text": "单人间有点贵。"}, {"type": "subtitle", "time": 10178.99, "timestamp": "02:49:38", "text": "是的。"}, {"type": "subtitle", "time": 10182.469, "timestamp": "02:49:42", "text": "哦，因为我当时就想，呃，这是一个"}, {"type": "subtitle", "time": 10184.63, "timestamp": "02:49:44", "text": "有点太多了。我不知道"}, {"type": "subtitle", "time": 10186.79, "timestamp": "02:49:46", "text": "与他人合住一间单人房"}, {"type": "subtitle", "time": 10188.309, "timestamp": "02:49:48", "text": "他人。比如，我不知道"}, {"type": "subtitle", "time": 10190.07, "timestamp": "02:49:50", "text": "那。"}, {"type": "subtitle", "time": 10191.91, "timestamp": "02:49:51", "text": "共用厨房没问题。点赞、分享"}, {"type": "subtitle", "time": 10193.86, "timestamp": "02:49:53", "text": "厨房还可以。"}, {"type": "subtitle", "time": 10195.429, "timestamp": "02:49:55", "text": "[音乐]"}, {"type": "subtitle", "time": 10197.91, "timestamp": "02:49:57", "text": "所以，我们有一个国际合租房。"}, {"type": "subtitle", "time": 10199.59, "timestamp": "02:49:59", "text": "来自不同国家的许多学生"}]
[{"type": "subtitle", "time": 14006.87, "timestamp": "03:53:26", "text": "我当时正在看这个汤姆·克兰家族的家族聚会，"}, {"type": "subtitle", "time": 14010.309, "timestamp": "03:53:30", "text": "抱歉，不是汤姆·克兰西。丹·克兰西的"}, {"type": "subtitle", "time": 14023.189, "timestamp": "03:53:43", "text": "[音乐]"}, {"type": "subtitle", "time": 14039.07, "timestamp": "03:53:59", "text": "等等，登机女孩。"}]
[{"type": "subtitle", "time": 4921.91, "timestamp": "01:22:01", "text": "后退？"}, {"type": "subtitle", "time": 4924.43, "timestamp": "01:22:04", "text": "不，开玩笑的。你不需要"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "你不需要……你不需要工资。"}, {"type": "subtitle", "time": 4932.629, "timestamp": "01:22:12", "text": "我只是在帮忙。去！去！去。手表"}, {"type": "subtitle", "time": 4938.709, "timestamp": "01:22:18", "text": "不要轻易暴露自己。你是什​​么"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "正在加载。我在途中。"}, {"type": "subtitle", "time": 4962.629, "timestamp": "01:22:42", "text": "狩猎开始了。"}, {"type": "subtitle", "time": 4965.03, "timestamp": "01:22:45", "text": "我们都……我看了一段海湾片段"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "昨天。我们了解你的策略。等待，"}, {"type": "subtitle", "time": 4970.79, "timestamp": "01:22:50", "text": "什么？什么卡扣？给我发什么湾"}]
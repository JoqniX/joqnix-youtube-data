[{"type": "subtitle", "time": 16863.03, "timestamp": "04:41:03", "text": "你自己。坚强点。坚强起来。"}, {"type": "subtitle", "time": 16884.51, "timestamp": "04:41:24", "text": "所以有一天，当我做完这一切之后……"}, {"type": "subtitle", "time": 16888.788, "timestamp": "04:41:28", "text": "一切不可能都平静安宁，对吗？"}, {"type": "subtitle", "time": 16896.91, "timestamp": "04:41:36", "text": "一件即将消逝的作品。我的意思是，我的意思是"}, {"type": "subtitle", "time": 16900.23, "timestamp": "04:41:40", "text": "举个例子，我告诉你……"}, {"type": "subtitle", "time": 16907.99, "timestamp": "04:41:47", "text": "据说新的霍尔生命世代即将到来"}, {"type": "subtitle", "time": 16909.788, "timestamp": "04:41:49", "text": "两个"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "伊恩的首秀一切都完成了"}, {"type": "subtitle", "time": 16915.67, "timestamp": "04:41:55", "text": "首次亮相之后"}, {"type": "subtitle", "time": 16917.868, "timestamp": "04:41:57", "text": "派对结束后"}]
[{"type": "subtitle", "time": 5160.03, "timestamp": "01:26:00", "text": "还剩一个敌人。我只能想到"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "分手语录。你们分手的原因是什么？"}, {"type": "subtitle", "time": 5176.55, "timestamp": "01:26:16", "text": "赛点。唉，搭讪的话真是太……"}, {"type": "subtitle", "time": 5178.51, "timestamp": "01:26:18", "text": "所以，我不"}, {"type": "subtitle", "time": 5181.51, "timestamp": "01:26:21", "text": "知道。喜欢"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "我走了。让我告诉你，"}, {"type": "subtitle", "time": 5187.43, "timestamp": "01:26:27", "text": "好像我只学过搭讪技巧似的"}, {"type": "subtitle", "time": 5190.75, "timestamp": "01:26:30", "text": "就像最近我开始的时候一样"}, {"type": "subtitle", "time": 5198.43, "timestamp": "01:26:38", "text": "这确实是一个漏洞。"}, {"type": "subtitle", "time": 5201.47, "timestamp": "01:26:41", "text": "那。我当时就想，“嗯，这是什么？”"}, {"type": "subtitle", "time": 5203.91, "timestamp": "01:26:43", "text": "“这个？”你知道，在我得知这件事之后……"}, {"type": "subtitle", "time": 5205.149, "timestamp": "01:26:45", "text": "它是"}, {"type": "subtitle", "time": 5207.55, "timestamp": "01:26:47", "text": "嗯"}, {"type": "subtitle", "time": 5210.47, "timestamp": "01:26:50", "text": "像这样使用，然后这样推动，我是"}, {"type": "subtitle", "time": 5212.03, "timestamp": "01:26:52", "text": "比如，“哦，我的"}, {"type": "subtitle", "time": 5214.47, "timestamp": "01:26:54", "text": "神。” 自从我成为神以来，就一直如此。"}, {"type": "subtitle", "time": 5217.51, "timestamp": "01:26:57", "text": "意识清醒了，我恢复了意识。"}]
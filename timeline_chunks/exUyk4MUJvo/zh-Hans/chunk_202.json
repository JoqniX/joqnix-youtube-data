[{"type": "subtitle", "time": 12121.75, "timestamp": "03:22:01", "text": "韩语和日语都很熟悉"}, {"type": "subtitle", "time": 12124.55, "timestamp": "03:22:04", "text": "语言相似语言。"}, {"type": "subtitle", "time": 12127.269, "timestamp": "03:22:07", "text": "是的。"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "你有没有想过像你想的那样……"}, {"type": "subtitle", "time": 12132.229, "timestamp": "03:22:12", "text": "走韩国路线？哦，我想到了"}, {"type": "subtitle", "time": 12135.349, "timestamp": "03:22:15", "text": "比如我到了日本之后，我会存钱。"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "起来给自己安排个假期，就像"}, {"type": "subtitle", "time": 12141.75, "timestamp": "03:22:21", "text": "去韩国或中国之类的地方旅游什么的"}, {"type": "subtitle", "time": 12144.07, "timestamp": "03:22:24", "text": "玩得开心，回来就好。"}, {"type": "subtitle", "time": 12147.03, "timestamp": "03:22:27", "text": "等我的语言课程结束后"}, {"type": "subtitle", "time": 12149.99, "timestamp": "03:22:29", "text": "或者比如，如果我要变得更大……"}, {"type": "subtitle", "time": 12152.71, "timestamp": "03:22:32", "text": "度假之类的。我仍然需要"}, {"type": "subtitle", "time": 12155.75, "timestamp": "03:22:35", "text": "完成我的大三学业。我是我"}, {"type": "subtitle", "time": 12160.07, "timestamp": "03:22:40", "text": "当时正在做呃，ODL那件事"}, {"type": "subtitle", "time": 12163.03, "timestamp": "03:22:43", "text": "大学。我当时在学英语"}, {"type": "subtitle", "time": 12165.59, "timestamp": "03:22:45", "text": "文学。所以，我目前今年"}, {"type": "subtitle", "time": 12170.309, "timestamp": "03:22:50", "text": "将是大三，嗯，嗯，我"}, {"type": "subtitle", "time": 12172.429, "timestamp": "03:22:52", "text": "没能参加三年级的考试"}, {"type": "subtitle", "time": 12175.55, "timestamp": "03:22:55", "text": "因为我有很多背部"}, {"type": "subtitle", "time": 12178.19, "timestamp": "03:22:58", "text": "我又需要一些文件了。"}]
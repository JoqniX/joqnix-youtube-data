[{"type": "subtitle", "time": 9361.19, "timestamp": "02:36:01", "text": "也是。是啊，你知道，你做你做"}, {"type": "subtitle", "time": 9362.79, "timestamp": "02:36:02", "text": "想在最后做一个好儿子"}, {"type": "subtitle", "time": 9366.63, "timestamp": "02:36:06", "text": "天。是的。真的。真的。是的。是的。"}, {"type": "subtitle", "time": 9368.63, "timestamp": "02:36:08", "text": "因为我知道我知道我知道这是它的"}, {"type": "subtitle", "time": 9371.19, "timestamp": "02:36:11", "text": "说一切都很容易，但你却不知道。"}, {"type": "subtitle", "time": 9373.75, "timestamp": "02:36:13", "text": "但你会想念你的父母。"}, {"type": "subtitle", "time": 9378.79, "timestamp": "02:36:18", "text": "有些时候会这样。是的。是的。"}, {"type": "subtitle", "time": 9381.11, "timestamp": "02:36:21", "text": "我现在甚至都开始想念他们了。我不知道什么时候"}, {"type": "subtitle", "time": 9384.63, "timestamp": "02:36:24", "text": "我明白，那种内疚感现在会一直伴随着我。"}, {"type": "subtitle", "time": 9387.59, "timestamp": "02:36:27", "text": "哇。我花了好多时间像这样"}, {"type": "subtitle", "time": 9389.83, "timestamp": "02:36:29", "text": "三四几乎四开始"}, {"type": "subtitle", "time": 9392.71, "timestamp": "02:36:32", "text": "电话。给他们一个机会，你知道的"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "知道何时会到来"}, {"type": "subtitle", "time": 9395.75, "timestamp": "02:36:35", "text": "总有那么一个时刻，你不想……"}, {"type": "subtitle", "time": 9399.27, "timestamp": "02:36:39", "text": "给他们一个机会，让他们说……哦，你"}, {"type": "subtitle", "time": 9402.15, "timestamp": "02:36:42", "text": "我不是个好儿子，你得明白。"}, {"type": "subtitle", "time": 9403.91, "timestamp": "02:36:43", "text": "在某个地方争辩说我是一个好儿子"}, {"type": "subtitle", "time": 9409.349, "timestamp": "02:36:49", "text": "大概就是这个意思。是的。"}, {"type": "subtitle", "time": 9411.349, "timestamp": "02:36:51", "text": "是的。我的意思是，我觉得你应该接受它"}, {"type": "subtitle", "time": 9413.51, "timestamp": "02:36:53", "text": "现在很容易了。你应该稍微放松一下。"}, {"type": "subtitle", "time": 9415.99, "timestamp": "02:36:55", "text": "看看你的日程安排是如何设置的"}, {"type": "subtitle", "time": 9419.03, "timestamp": "02:36:59", "text": "日本，日本做事的方式，你"}]
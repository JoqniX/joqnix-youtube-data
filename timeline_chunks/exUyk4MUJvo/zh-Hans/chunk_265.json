[{"type": "subtitle", "time": 15900.349, "timestamp": "04:25:00", "text": "溪流。早上8点起床"}, {"type": "subtitle", "time": 15903.03, "timestamp": "04:25:03", "text": "下午我的意思是，去睡觉，然后醒来……"}, {"type": "subtitle", "time": 15906.67, "timestamp": "04:25:06", "text": "晚上8点在 Twitch 上开始直播"}, {"type": "subtitle", "time": 15910.229, "timestamp": "04:25:10", "text": "一直到凌晨3点。然后我们就结束了。"}, {"type": "subtitle", "time": 15911.55, "timestamp": "04:25:11", "text": "今天。"}, {"type": "subtitle", "time": 15914.99, "timestamp": "04:25:14", "text": "好的。是的，那就是"}, {"type": "subtitle", "time": 15918.75, "timestamp": "04:25:18", "text": "日程。我是说，"}, {"type": "subtitle", "time": 15921.149, "timestamp": "04:25:21", "text": "是的。坚强点。"}, {"type": "subtitle", "time": 15923.149, "timestamp": "04:25:23", "text": "你好。你好。"}, {"type": "subtitle", "time": 15926.149, "timestamp": "04:25:26", "text": "你好。我想用日语交谈。呃，"}, {"type": "subtitle", "time": 15928.79, "timestamp": "04:25:28", "text": "我该试试吗？说。另外，我想要"}, {"type": "subtitle", "time": 15932.67, "timestamp": "04:25:32", "text": "为了尝试提高歌唱水平，"}, {"type": "subtitle", "time": 15935.429, "timestamp": "04:25:35", "text": "也。所以，我也想提高我的艺术水平。我"}, {"type": "subtitle", "time": 15937.349, "timestamp": "04:25:37", "text": "也想提高音乐制作水平。我"}, {"type": "subtitle", "time": 15940.03, "timestamp": "04:25:40", "text": "也想学键盘和钢琴。"}, {"type": "subtitle", "time": 15943.91, "timestamp": "04:25:43", "text": "他妈的。我可以在直播中完成所有这些操作吗？"}, {"type": "subtitle", "time": 15944.91, "timestamp": "04:25:44", "text": "会吗？"}, {"type": "subtitle", "time": 15946.91, "timestamp": "04:25:46", "text": "是吗？"}, {"type": "subtitle", "time": 15952.189, "timestamp": "04:25:52", "text": "会是汽车吗？会是吗？"}, {"type": "subtitle", "time": 15959.55, "timestamp": "04:25:59", "text": "我的意思是，我可以做到。"}]
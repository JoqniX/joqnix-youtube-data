[{"type": "subtitle", "time": 8223.19, "timestamp": "02:17:03", "text": "叫出游戏规则了吗？鱿鱼游戏。啊，是的。"}, {"type": "subtitle", "time": 8228.389, "timestamp": "02:17:08", "text": "我就是没时间。嗯。"}, {"type": "subtitle", "time": 8230.87, "timestamp": "02:17:10", "text": "嗯，不过我猜其中一个我喜欢。"}, {"type": "subtitle", "time": 8233.349, "timestamp": "02:17:13", "text": "看了几集之后，就觉得生活给了我很多。"}, {"type": "subtitle", "time": 8235.83, "timestamp": "02:17:15", "text": "你们这些橘子。"}, {"type": "subtitle", "time": 8238.549, "timestamp": "02:17:18", "text": "啊，我想我在Netflix上看过。"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "没有把握。我还没看过。是的。"}, {"type": "subtitle", "time": 8243.99, "timestamp": "02:17:23", "text": "还好。我觉得还可以。"}, {"type": "subtitle", "time": 8246.03, "timestamp": "02:17:26", "text": "我就像……"}, {"type": "subtitle", "time": 8249.83, "timestamp": "02:17:29", "text": "如果我是一个……我该怎么委婉地说呢？"}, {"type": "subtitle", "time": 8252.11, "timestamp": "02:17:32", "text": "方式？如果我"}, {"type": "subtitle", "time": 8255.549, "timestamp": "02:17:35", "text": "25年"}, {"type": "subtitle", "time": 8257.79, "timestamp": "02:17:37", "text": "我年纪大了。"}, {"type": "subtitle", "time": 8260.95, "timestamp": "02:17:40", "text": "不，但如果我25岁，如果我"}, {"type": "subtitle", "time": 8264.469, "timestamp": "02:17:44", "text": "如果有时间，如果我想哭的话"}, {"type": "subtitle", "time": 8268.79, "timestamp": "02:17:48", "text": "但我会很喜欢的。"}, {"type": "subtitle", "time": 8273.349, "timestamp": "02:17:53", "text": "我确实还没满25岁。"}, {"type": "subtitle", "time": 8277.07, "timestamp": "02:17:57", "text": "我不想哭。"}, {"type": "subtitle", "time": 8279.91, "timestamp": "02:17:59", "text": "所以目前我一切都还好。"}]
[{"type": "subtitle", "time": 15000.51, "timestamp": "04:10:00", "text": "第一点是"}, {"type": "subtitle", "time": 15005.15, "timestamp": "04:10:05", "text": "首要任务是重建所有……"}, {"type": "subtitle", "time": 15008.229, "timestamp": "04:10:08", "text": "然后慢慢地重建所有场景"}, {"type": "subtitle", "time": 15010.349, "timestamp": "04:10:10", "text": "我的影响"}, {"type": "subtitle", "time": 15014.71, "timestamp": "04:10:14", "text": "定制一个像这样的"}, {"type": "subtitle", "time": 15017.87, "timestamp": "04:10:17", "text": "呃，那个东西，那个欢迎的东西，我"}, {"type": "subtitle", "time": 15022.269, "timestamp": "04:10:22", "text": "需要展示简短的这个"}, {"type": "subtitle", "time": 15024.99, "timestamp": "04:10:24", "text": "动画就像……呃，向下"}, {"type": "subtitle", "time": 15028.189, "timestamp": "04:10:28", "text": "持续时间和"}, {"type": "subtitle", "time": 15030.83, "timestamp": "04:10:30", "text": "你的东西"}, {"type": "subtitle", "time": 15034.83, "timestamp": "04:10:34", "text": "知道。然后是另一个。"}, {"type": "subtitle", "time": 15037.67, "timestamp": "04:10:37", "text": "东西。是的。所有浏览器来源"}, {"type": "subtitle", "time": 15039.83, "timestamp": "04:10:39", "text": "一切。所以从现在开始我不会再……"}, {"type": "subtitle", "time": 15043.429, "timestamp": "04:10:43", "text": "我用的是Twitch上的那个东西。呃，"}, {"type": "subtitle", "time": 15046.15, "timestamp": "04:10:46", "text": "通常情况下，它会像红色一样。"}, {"type": "subtitle", "time": 15050.11, "timestamp": "04:10:50", "text": "光标，对吧？点击我的"}, {"type": "subtitle", "time": 15052.63, "timestamp": "04:10:52", "text": "流，与流进行交互"}, {"type": "subtitle", "time": 15055.07, "timestamp": "04:10:55", "text": "这些东西，我会禁用它们。"}, {"type": "subtitle", "time": 15058.87, "timestamp": "04:10:58", "text": "那是因为浏览器源代码就像"}]
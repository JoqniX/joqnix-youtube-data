[{"type": "subtitle", "time": 15061.79, "timestamp": "04:11:01", "text": "我同时使用七八个浏览器。"}, {"type": "subtitle", "time": 15066.269, "timestamp": "04:11:06", "text": "寻找更多来源以增加其价值"}, {"type": "subtitle", "time": 15070.07, "timestamp": "04:11:10", "text": "独一无二，不断添加东西。所以，"}, {"type": "subtitle", "time": 15072.55, "timestamp": "04:11:12", "text": "我会把它删掉。"}, {"type": "subtitle", "time": 15074.03, "timestamp": "04:11:14", "text": "做尼康"}, {"type": "subtitle", "time": 15076.91, "timestamp": "04:11:16", "text": "尼康 尼康 呃"}, {"type": "subtitle", "time": 15079.07, "timestamp": "04:11:19", "text": "覆盖。所以它会"}, {"type": "subtitle", "time": 15082.189, "timestamp": "04:11:22", "text": "评论将会是"}, {"type": "subtitle", "time": 15086.71, "timestamp": "04:11:26", "text": "就像从右边往右走一样"}, {"type": "subtitle", "time": 15090.03, "timestamp": "04:11:30", "text": "像漂浮物一样留在屏幕上。"}, {"type": "subtitle", "time": 15093.67, "timestamp": "04:11:33", "text": "评论。呃，你知道吗？"}, {"type": "subtitle", "time": 15097.03, "timestamp": "04:11:37", "text": "有人知道吗？这里有人知道吗？"}, {"type": "subtitle", "time": 15101.83, "timestamp": "04:11:41", "text": "实际上可以做尼康Nikico之类的"}, {"type": "subtitle", "time": 15106.15, "timestamp": "04:11:46", "text": "例如评论区"}, {"type": "subtitle", "time": 15109.63, "timestamp": "04:11:49", "text": "现在谁在直播？所有直播的节目都在进行中。"}, {"type": "subtitle", "time": 15112.349, "timestamp": "04:11:52", "text": "今天我展示，我将展示"}, {"type": "subtitle", "time": 15115.63, "timestamp": "04:11:55", "text": "你是吗？"}, {"type": "subtitle", "time": 15117.71, "timestamp": "04:11:57", "text": "现场我会展示"}]
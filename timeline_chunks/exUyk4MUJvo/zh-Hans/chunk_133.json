[{"type": "subtitle", "time": 7981.75, "timestamp": "02:13:01", "text": "改编成日式风格，它是"}, {"type": "subtitle", "time": 7983.669, "timestamp": "02:13:03", "text": "我的意思是，它甚至都不算好。"}, {"type": "subtitle", "time": 7985.83, "timestamp": "02:13:05", "text": "好吧，这确实是个好故事。它是其中之一"}, {"type": "subtitle", "time": 7987.75, "timestamp": "02:13:07", "text": "我读过的最好的曼萨斯。中的一个"}, {"type": "subtitle", "time": 7990.069, "timestamp": "02:13:10", "text": "最好的。但有很多伟大的"}, {"type": "subtitle", "time": 7991.99, "timestamp": "02:13:11", "text": "手册。"}, {"type": "subtitle", "time": 7995.669, "timestamp": "02:13:15", "text": "是的。而太阳能调平正是如此。"}, {"type": "subtitle", "time": 7999.189, "timestamp": "02:13:19", "text": "我们怎么说？呃，如果我13岁的话，我会很喜欢"}, {"type": "subtitle", "time": 8001.96, "timestamp": "02:13:21", "text": "我会说是太阳辐射水平调节。"}, {"type": "subtitle", "time": 8004.229, "timestamp": "02:13:24", "text": "[音乐]"}, {"type": "subtitle", "time": 8005.83, "timestamp": "02:13:25", "text": "这时我就想，好吧，我喜欢"}, {"type": "subtitle", "time": 8008.35, "timestamp": "02:13:28", "text": "因为所有这些，你独自升级"}, {"type": "subtitle", "time": 8011.109, "timestamp": "02:13:31", "text": "我知道他正在做的所有事情。但"}, {"type": "subtitle", "time": 8013.35, "timestamp": "02:13:33", "text": "它只不过是一把华丽的剑术之剑而已。"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "在线的。"}, {"type": "subtitle", "time": 8018.069, "timestamp": "02:13:38", "text": "哦，当然。这是一个非常强烈的观点。"}, {"type": "subtitle", "time": 8019.83, "timestamp": "02:13:39", "text": "我猜也是。"}, {"type": "subtitle", "time": 8023.109, "timestamp": "02:13:43", "text": "你读过哪些类型的魔法书？"}, {"type": "subtitle", "time": 8025.99, "timestamp": "02:13:45", "text": "你读过《Omnisia》之类的书吗？"}, {"type": "subtitle", "time": 8027.43, "timestamp": "02:13:47", "text": "是的。是的。是的。那是一个非常"}, {"type": "subtitle", "time": 8032.629, "timestamp": "02:13:52", "text": "法力充沛。我认为是的。"}, {"type": "subtitle", "time": 8035.109, "timestamp": "02:13:55", "text": "我认为最好的法力值是……"}, {"type": "subtitle", "time": 8037.03, "timestamp": "02:13:57", "text": "北方之刃。你读过吗？"}]
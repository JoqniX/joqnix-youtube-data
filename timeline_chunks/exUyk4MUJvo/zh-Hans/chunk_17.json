[{"type": "subtitle", "time": 1022.389, "timestamp": "00:17:02", "text": "准备好。发现敌人！快走！快走！快走！"}, {"type": "subtitle", "time": 1028.71, "timestamp": "00:17:08", "text": "费用。不。我的天哪。真可惜"}, {"type": "subtitle", "time": 1031.829, "timestamp": "00:17:11", "text": "必须死，但是，好吧，再检查一遍。"}, {"type": "subtitle", "time": 1033.59, "timestamp": "00:17:13", "text": "图片。"}, {"type": "subtitle", "time": 1036.71, "timestamp": "00:17:16", "text": "换班前的最后一轮。嗯，"}, {"type": "subtitle", "time": 1040.27, "timestamp": "00:17:20", "text": "这里有个空位。重新装弹。有一个"}, {"type": "subtitle", "time": 1043.15, "timestamp": "00:17:23", "text": "空间。然后我就可以"}, {"type": "subtitle", "time": 1046.59, "timestamp": "00:17:26", "text": "复制粘贴。我"}, {"type": "subtitle", "time": 1049.51, "timestamp": "00:17:29", "text": "节省。如果有人在聊天中输入文字，请允许"}, {"type": "subtitle", "time": 1051.909, "timestamp": "00:17:31", "text": "告诉我。是的，如果有人在打字，我"}, {"type": "subtitle", "time": 1054.029, "timestamp": "00:17:34", "text": "我会检查一下。"}, {"type": "subtitle", "time": 1072.95, "timestamp": "00:17:52", "text": "没错。我们六个人出发去上班了。"}]
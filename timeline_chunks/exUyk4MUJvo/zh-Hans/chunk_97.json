[{"type": "subtitle", "time": 5821.43, "timestamp": "01:37:01", "text": "已经过去一段时间了。我同意。"}, {"type": "subtitle", "time": 5823.75, "timestamp": "01:37:03", "text": "已经这样了，我不知道。最后的"}, {"type": "subtitle", "time": 5825.83, "timestamp": "01:37:05", "text": "我想，我们一起出去玩的那段时间是……"}, {"type": "subtitle", "time": 5829.59, "timestamp": "01:37:09", "text": "我不记得是不是像这样了"}, {"type": "subtitle", "time": 5831.59, "timestamp": "01:37:11", "text": "呃，它叫什么来着？"}, {"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "我们来了，然后我们聊起了“是啊，我们”。"}, {"type": "subtitle", "time": 5837.35, "timestamp": "01:37:17", "text": "我们在闲聊。"}, {"type": "subtitle", "time": 5840.31, "timestamp": "01:37:20", "text": "是啊，我不记得上次是什么时候了。那是"}, {"type": "subtitle", "time": 5842.39, "timestamp": "01:37:22", "text": "已经过去一段时间了。相信我，它确实有"}, {"type": "subtitle", "time": 5845.59, "timestamp": "01:37:25", "text": "好久不见。反应式。我忘了我还有"}, {"type": "subtitle", "time": 5847.59, "timestamp": "01:37:27", "text": "具有反应性。"}, {"type": "subtitle", "time": 5849.91, "timestamp": "01:37:29", "text": "是的，这个跟你那个很像。"}, {"type": "subtitle", "time": 5853.35, "timestamp": "01:37:33", "text": "上次我们聊天的时候就认识了。是的，我没有"}, {"type": "subtitle", "time": 5855.51, "timestamp": "01:37:35", "text": "我不记得了。那就像过时了一样"}, {"type": "subtitle", "time": 5857.59, "timestamp": "01:37:37", "text": "事物。它位于某个深处"}, {"type": "subtitle", "time": 5864.229, "timestamp": "01:37:44", "text": "我非常想念你。我当时有点"}, {"type": "subtitle", "time": 5867.51, "timestamp": "01:37:47", "text": "担心你像个不活跃的活跃人士"}, {"type": "subtitle", "time": 5870.669, "timestamp": "01:37:50", "text": "你还是我吗？"}, {"type": "subtitle", "time": 5873.91, "timestamp": "01:37:53", "text": "已经走了。不，我走了，但是"}, {"type": "subtitle", "time": 5875.51, "timestamp": "01:37:55", "text": "没关系。你随时可以给我发短信或"}, {"type": "subtitle", "time": 5879.43, "timestamp": "01:37:59", "text": "类似任何时候"}]
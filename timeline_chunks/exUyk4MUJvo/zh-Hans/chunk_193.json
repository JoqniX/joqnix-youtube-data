[{"type": "subtitle", "time": 11582.95, "timestamp": "03:13:02", "text": "新的。这样就可以了。那"}, {"type": "subtitle", "time": 11586.23, "timestamp": "03:13:06", "text": "这个价格一年下来还可以接受。是的。所以"}, {"type": "subtitle", "time": 11588.79, "timestamp": "03:13:08", "text": "就是他们说的每年的价格那件事。"}, {"type": "subtitle", "time": 11591.59, "timestamp": "03:13:11", "text": "他们最终会回来的。"}, {"type": "subtitle", "time": 11594.389, "timestamp": "03:13:14", "text": "总有一天。但就是因为那些事"}, {"type": "subtitle", "time": 11597.51, "timestamp": "03:13:17", "text": "花了这么多时间，我就想，好吧，我会的。"}, {"type": "subtitle", "time": 11600.79, "timestamp": "03:13:20", "text": "我自己处理之类的。但那是"}, {"type": "subtitle", "time": 11604.95, "timestamp": "03:13:24", "text": "好的。是的。是的，价格是"}, {"type": "subtitle", "time": 11609.75, "timestamp": "03:13:29", "text": "以上价格合理，但仅售一美元。"}, {"type": "subtitle", "time": 11613.349, "timestamp": "03:13:33", "text": "是的，那个价格确实是"}, {"type": "subtitle", "time": 11615.91, "timestamp": "03:13:35", "text": "高级版价格"}, {"type": "subtitle", "time": 11618.229, "timestamp": "03:13:38", "text": "他们第一次这么做的时候就这么叫它了。"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "来自 Fiverr 之类的平台。不，不，这个"}, {"type": "subtitle", "time": 11623.67, "timestamp": "03:13:43", "text": "呃，索具工是直接的"}, {"type": "subtitle", "time": 11626.55, "timestamp": "03:13:46", "text": "艺术家推荐"}, {"type": "subtitle", "time": 11629.51, "timestamp": "03:13:49", "text": "这位艺术家是韩国艺术家。所以我想"}, {"type": "subtitle", "time": 11631.51, "timestamp": "03:13:51", "text": "我不想处理语言问题"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "沟通不畅等等。所以，我"}, {"type": "subtitle", "time": 11635.67, "timestamp": "03:13:55", "text": "我想我会和他们认识的人一起去。"}, {"type": "subtitle", "time": 11638.63, "timestamp": "03:13:58", "text": "已经合作过。所以我去了那里。"}]
[{"type": "subtitle", "time": 7140.31, "timestamp": "01:59:00", "text": "嗯……该怎么说呢？就像……你"}, {"type": "subtitle", "time": 7143.03, "timestamp": "01:59:03", "text": "你是妈妈吗？你的艺术家是谁？"}, {"type": "subtitle", "time": 7147.589, "timestamp": "01:59:07", "text": "你的模型之类的东西，然后你进入"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "与他们签订独家合同"}, {"type": "subtitle", "time": 7153.27, "timestamp": "01:59:13", "text": "致那些你不应该创作的艺术家们"}, {"type": "subtitle", "time": 7156.149, "timestamp": "01:59:16", "text": "为其他创作者提供模型等等"}, {"type": "subtitle", "time": 7158.629, "timestamp": "01:59:18", "text": "如果那些是你非常亲近的人"}, {"type": "subtitle", "time": 7161.03, "timestamp": "01:59:21", "text": "朋友之类的，就像辛德瑞拉的那些"}, {"type": "subtitle", "time": 7163.27, "timestamp": "01:59:23", "text": "亲密的朋友就像 Bow the Veil 一样"}, {"type": "subtitle", "time": 7166.39, "timestamp": "01:59:26", "text": "那些大牌 YouTuber，不，而且所有"}, {"type": "subtitle", "time": 7169.51, "timestamp": "01:59:29", "text": "这些人曾参与过一些项目，呃……"}, {"type": "subtitle", "time": 7172.87, "timestamp": "01:59:32", "text": "我觉得Cinder的画师是Nanolas。"}, {"type": "subtitle", "time": 7178.39, "timestamp": "01:59:38", "text": "她的名字。呃，所以，是的，所以她，呃，辛德瑞拉"}, {"type": "subtitle", "time": 7182.47, "timestamp": "01:59:42", "text": "她的经纪人也参与其中。呃"}, {"type": "subtitle", "time": 7184.79, "timestamp": "01:59:44", "text": "他们与……进行了沟通"}, {"type": "subtitle", "time": 7188.149, "timestamp": "01:59:48", "text": "纳米艺术家关于“是的，不要这样做”"}, {"type": "subtitle", "time": 7190.79, "timestamp": "01:59:50", "text": "和其他创作者一起创作等等"}, {"type": "subtitle", "time": 7194.149, "timestamp": "01:59:54", "text": "嗯，那位艺术家也效仿了这一点。"}, {"type": "subtitle", "time": 7196.149, "timestamp": "01:59:56", "text": "以健康等为由的借口"}]
[{"type": "subtitle", "time": 1142.87, "timestamp": "00:19:02", "text": "射击。好球。"}, {"type": "subtitle", "time": 1164.63, "timestamp": "00:19:24", "text": "拿着。我走了。第二代。"}, {"type": "subtitle", "time": 1167.35, "timestamp": "00:19:27", "text": "圣。没想到他会这么做。"}, {"type": "subtitle", "time": 1169.11, "timestamp": "00:19:29", "text": "好的。"}, {"type": "subtitle", "time": 1171.17, "timestamp": "00:19:31", "text": "但是向下。"}, {"type": "subtitle", "time": 1177.75, "timestamp": "00:19:37", "text": "有人在中间。"}]
[{"type": "subtitle", "time": 8340.309, "timestamp": "02:19:00", "text": "糟糕。我看了《金经理》。"}, {"type": "subtitle", "time": 8346.309, "timestamp": "02:19:06", "text": "我喜欢这一点。那很好。等待，"}, {"type": "subtitle", "time": 8347.99, "timestamp": "02:19:07", "text": "他们有真人版吗？不是吗"}, {"type": "subtitle", "time": 8351.349, "timestamp": "02:19:11", "text": "就像法力一样？"}, {"type": "subtitle", "time": 8354.309, "timestamp": "02:19:14", "text": "不，不，不，不。那更像是……"}, {"type": "subtitle", "time": 8356.469, "timestamp": "02:19:16", "text": "那又是另一个故事了。这是一个"}, {"type": "subtitle", "time": 8358.469, "timestamp": "02:19:18", "text": "另一个。不是的，不是的"}, {"type": "subtitle", "time": 8362.309, "timestamp": "02:19:22", "text": "那个试图为你而战的人"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "认识他，他的女儿之类的。"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "不是那个。啊，不，那不是"}, {"type": "subtitle", "time": 8368.79, "timestamp": "02:19:28", "text": "就是那个。好的。好的。是的，奎恩先生是"}, {"type": "subtitle", "time": 8371.349, "timestamp": "02:19:31", "text": "这是我被建议的。"}, {"type": "subtitle", "time": 8373.19, "timestamp": "02:19:33", "text": "嗯。"}, {"type": "subtitle", "time": 8375.27, "timestamp": "02:19:35", "text": "我一直想看但始终没能看到的那部电影。"}, {"type": "subtitle", "time": 8380.349, "timestamp": "02:19:40", "text": "大约。 Venenzo，这个不错。嗯。"}, {"type": "subtitle", "time": 8383.91, "timestamp": "02:19:43", "text": "嗯，我想应该有一些吧，但是哦，"}, {"type": "subtitle", "time": 8386.95, "timestamp": "02:19:46", "text": "是的。曾经有一种叫做“跑”的东西。"}, {"type": "subtitle", "time": 8395.03, "timestamp": "02:19:55", "text": "嗯，大概是吧。哦，这是什么？迷失"}, {"type": "subtitle", "time": 8397.19, "timestamp": "02:19:57", "text": "星光。这是吉布利的作品吗？妈的，"}, {"type": "subtitle", "time": 8398.349, "timestamp": "02:19:58", "text": "这是一个"}]
[{"type": "subtitle", "time": 11941.99, "timestamp": "03:19:01", "text": "感觉就像做梦一样，但那是一个梦"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "未能达到预期效果，或者说没有实现。所以"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "那感觉就像触电一样。然后我"}, {"type": "subtitle", "time": 11950.389, "timestamp": "03:19:10", "text": "当时我就想，好吧，我又回到原点了。"}, {"type": "subtitle", "time": 11952.19, "timestamp": "03:19:12", "text": "一切又回到了零。"}, {"type": "subtitle", "time": 11955.59, "timestamp": "03:19:15", "text": "我理解其中的情感因素。"}, {"type": "subtitle", "time": 11968.309, "timestamp": "03:19:28", "text": "一天。一旦你像个……那是什么？"}, {"type": "subtitle", "time": 11971.15, "timestamp": "03:19:31", "text": "它叫什么名字？就像你一样"}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "一旦你加入学院，或者是什么？"}, {"type": "subtitle", "time": 11975.91, "timestamp": "03:19:35", "text": "它打来的电话？你所知道的那所学院"}, {"type": "subtitle", "time": 11977.349, "timestamp": "03:19:37", "text": "公司的。你有没有想过……"}, {"type": "subtitle", "time": 11989.269, "timestamp": "03:19:49", "text": "武宾。 Vubing 还是像一份工作？"}, {"type": "subtitle", "time": 11992.11, "timestamp": "03:19:52", "text": "是的。是的。武宾。虚拟管家。"}, {"type": "subtitle", "time": 11995.03, "timestamp": "03:19:55", "text": "啊，我不知道。我刚刚读到我刚刚"}, {"type": "subtitle", "time": 11998.87, "timestamp": "03:19:58", "text": "我已收到您的信息。是的。我非常乐意"}]
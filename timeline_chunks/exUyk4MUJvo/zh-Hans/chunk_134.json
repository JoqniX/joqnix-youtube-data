[{"type": "subtitle", "time": 8043.27, "timestamp": "02:14:03", "text": "我记得见过。我不确定我是否"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "我已经完整地读过了。我认为那是其中之一。"}, {"type": "subtitle", "time": 8049.109, "timestamp": "02:14:09", "text": "这是我读过的最好的曼萨斯之一。"}, {"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "就像艺术故事一样，一切都……"}, {"type": "subtitle", "time": 8059.83, "timestamp": "02:14:19", "text": "我觉得我读过的另一本很棒的魔法书是"}, {"type": "subtitle", "time": 8063.109, "timestamp": "02:14:23", "text": "呃，我的意思是，我会说哪个更好？"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "不过也有一些不错的例子，比如"}, {"type": "subtitle", "time": 8072.149, "timestamp": "02:14:32", "text": "它确实被改编成了一部 Netflix 剧集。"}, {"type": "subtitle", "time": 8080.79, "timestamp": "02:14:40", "text": "《弱小英雄》还不错。呃，还有什么？"}, {"type": "subtitle", "time": 8082.709, "timestamp": "02:14:42", "text": "好的？我的意思是，我们英雄确实不错，但是"}, {"type": "subtitle", "time": 8084.39, "timestamp": "02:14:44", "text": "还是像我的意思一样，就是这样。"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "确实不错。我不会，我不会说"}, {"type": "subtitle", "time": 8088.95, "timestamp": "02:14:48", "text": "对它有害的任何东西。呃，还有什么？什么"}, {"type": "subtitle", "time": 8093.2, "timestamp": "02:14:53", "text": "还有什么比这更好的法力值呢？"}, {"type": "subtitle", "time": 8096.069, "timestamp": "02:14:56", "text": "[音乐]"}, {"type": "subtitle", "time": 8099.35, "timestamp": "02:14:59", "text": "因为我读过太多《铁血》系列小说了"}]
[{"type": "subtitle", "time": 9901.11, "timestamp": "02:45:01", "text": "好好想想。是的，你说得对。"}, {"type": "subtitle", "time": 9904.389, "timestamp": "02:45:04", "text": "找个日本女朋友。"}, {"type": "subtitle", "time": 9907.91, "timestamp": "02:45:07", "text": "或许。是的，如果可能的话。我是说，"}, {"type": "subtitle", "time": 9910.87, "timestamp": "02:45:10", "text": "如果人生真如我们所愿的话。是的。"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "日本人。她可能是印度人。 WHO"}, {"type": "subtitle", "time": 9916.389, "timestamp": "02:45:16", "text": "关心吗？是的。是的。有人吗？是的。某人"}, {"type": "subtitle", "time": 9919.99, "timestamp": "02:45:19", "text": "谁真正支持你？是的，又来了。"}, {"type": "subtitle", "time": 9921.75, "timestamp": "02:45:21", "text": "再一次，我不知道，我不知道"}, {"type": "subtitle", "time": 9926.15, "timestamp": "02:45:26", "text": "你的……嗯……哦，我该怎么说呢……就像我"}, {"type": "subtitle", "time": 9928.87, "timestamp": "02:45:28", "text": "不知道它叫什么"}, {"type": "subtitle", "time": 9931.59, "timestamp": "02:45:31", "text": "性欲"}, {"type": "subtitle", "time": 9933.83, "timestamp": "02:45:33", "text": "像做"}, {"type": "subtitle", "time": 9935.59, "timestamp": "02:45:35", "text": "好的，如果你是直男的话。"}, {"type": "subtitle", "time": 9945.51, "timestamp": "02:45:45", "text": "他们是最优秀的。"}, {"type": "subtitle", "time": 9948.95, "timestamp": "02:45:48", "text": "哦，别，别去问“那是什么”。"}, {"type": "subtitle", "time": 9951.23, "timestamp": "02:45:51", "text": "叫什么？不要选择“就是不要”。"}]
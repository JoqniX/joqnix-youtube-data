[{"type": "subtitle", "time": 272.749, "timestamp": "00:04:32", "text": "假装掸灰。就像左键、中键一样"}, {"type": "subtitle", "time": 278.189, "timestamp": "00:04:38", "text": "单击，然后右键单击。全部消失了。 Z42。"}, {"type": "subtitle", "time": 281.07, "timestamp": "00:04:41", "text": "是的。是的。我的号码是G"}, {"type": "subtitle", "time": 285.67, "timestamp": "00:04:45", "text": "Z2。我之前在我的车上装过滚轮。"}, {"type": "subtitle", "time": 289.909, "timestamp": "00:04:49", "text": "第一只老鼠。那就是光谱范围。我"}, {"type": "subtitle", "time": 292.87, "timestamp": "00:04:52", "text": "我先买了那个。然后我抓住了坏人"}, {"type": "subtitle", "time": 295.59000000000003, "timestamp": "00:04:55", "text": "东西。我已经换新了。更像是一个"}, {"type": "subtitle", "time": 298.189, "timestamp": "00:04:58", "text": "升级是因为他们之前没有频谱。"}]
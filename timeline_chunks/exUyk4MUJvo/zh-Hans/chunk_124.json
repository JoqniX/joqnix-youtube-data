[{"type": "subtitle", "time": 7441.189, "timestamp": "02:04:01", "text": "流媒体作为更多帐户或"}, {"type": "subtitle", "time": 7444.31, "timestamp": "02:04:04", "text": "然后她又一次公开亮相了。"}, {"type": "subtitle", "time": 7447.83, "timestamp": "02:04:07", "text": "在她的主要账户上，私人"}, {"type": "subtitle", "time": 7450.87, "timestamp": "02:04:10", "text": "私人的，而且我觉得她好像……"}, {"type": "subtitle", "time": 7453.189, "timestamp": "02:04:13", "text": "模特服装之类的，然后"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "有那么一部马夫马夫的剧"}, {"type": "subtitle", "time": 7459.03, "timestamp": "02:04:19", "text": "对，我想就是那个。"}, {"type": "subtitle", "time": 7464.629, "timestamp": "02:04:24", "text": "那天最火的电视剧就是"}, {"type": "subtitle", "time": 7466.709, "timestamp": "02:04:26", "text": "对，我知道的两部剧就是那样。"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "非常清楚。其中一条龙"}, {"type": "subtitle", "time": 7471.43, "timestamp": "02:04:31", "text": "女孩。我不知道她的名字。奎森。"}, {"type": "subtitle", "time": 7474.39, "timestamp": "02:04:34", "text": "奎森。是的。可可。是的，我知道。"}, {"type": "subtitle", "time": 7476.95, "timestamp": "02:04:36", "text": "一。另一个我想是"}, {"type": "subtitle", "time": 7478.87, "timestamp": "02:04:38", "text": "鲁什。我不知道。然后还有其他的我"}, {"type": "subtitle", "time": 7481.99, "timestamp": "02:04:41", "text": "不知道。我最近只看过一个片段。"}, {"type": "subtitle", "time": 7485.03, "timestamp": "02:04:45", "text": "古拉毕业了吗？阿古拉"}, {"type": "subtitle", "time": 7487.43, "timestamp": "02:04:47", "text": "毕业了。是的。"}, {"type": "subtitle", "time": 7489.669, "timestamp": "02:04:49", "text": "然后立即开始研究蝰蛇"}, {"type": "subtitle", "time": 7492.47, "timestamp": "02:04:52", "text": "帐户。是的。"}, {"type": "subtitle", "time": 7499.75, "timestamp": "02:04:59", "text": "我不了解其他女孩的情况。"}]
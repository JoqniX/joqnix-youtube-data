[{"type": "subtitle", "time": 5225.83, "timestamp": "01:27:05", "text": "还剩一个敌人。我当时就想，"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "“好的，"}, {"type": "subtitle", "time": 5229.59, "timestamp": "01:27:09", "text": "我还有机会。我觉得我变得像"}, {"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "还剩30秒。"}, {"type": "subtitle", "time": 5247.75, "timestamp": "01:27:27", "text": "你想听吗？你是我的作业吗？"}, {"type": "subtitle", "time": 5249.91, "timestamp": "01:27:29", "text": "因为我想让你忘记这一切。哦"}, {"type": "subtitle", "time": 5254.669, "timestamp": "01:27:34", "text": "上帝。哦，我的"}, {"type": "subtitle", "time": 5258.31, "timestamp": "01:27:38", "text": "上帝。哟，再见。哟，小子。就是这样"}]
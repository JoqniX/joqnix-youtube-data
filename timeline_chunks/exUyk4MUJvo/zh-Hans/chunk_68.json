[{"type": "subtitle", "time": 4082.75, "timestamp": "01:08:02", "text": "它。哦"}, {"type": "subtitle", "time": 4090.549, "timestamp": "01:08:10", "text": "找到匹配项。游戏结束。哦，等等。"}, {"type": "subtitle", "time": 4093.109, "timestamp": "01:08:13", "text": "我本来应该就在那里拍的。"}, {"type": "subtitle", "time": 4094.51, "timestamp": "01:08:14", "text": "那是"}, {"type": "subtitle", "time": 4105.669, "timestamp": "01:08:25", "text": "在此之前。让我来做这些事。所以我的"}, {"type": "subtitle", "time": 4108.47, "timestamp": "01:08:28", "text": "当前结束。在此之前请稍等片刻。什么是"}, {"type": "subtitle", "time": 4112.51, "timestamp": "01:08:32", "text": "正在下载？哦，什么？什么？堡垒之夜。"}, {"type": "subtitle", "time": 4114.829, "timestamp": "01:08:34", "text": "不。"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "为什么这个人卸载了那个游戏？"}, {"type": "subtitle", "time": 4120.309, "timestamp": "01:08:40", "text": "等等，我到底有多少款游戏？"}, {"type": "subtitle", "time": 4122.749, "timestamp": "01:08:42", "text": "安装了吗？然后"}, {"type": "subtitle", "time": 4127.51, "timestamp": "01:08:47", "text": "霍格沃茨的倒霉蛋们又来了，真是史诗级的失败者们。我到底该不该这么做？"}, {"type": "subtitle", "time": 4129.47, "timestamp": "01:08:49", "text": "玩秋季"}, {"type": "subtitle", "time": 4131.91, "timestamp": "01:08:51", "text": "伙计们？我应该安装吗？我不知道。我"}, {"type": "subtitle", "time": 4135.51, "timestamp": "01:08:55", "text": "可以安装这个。是48。多少钱？"}, {"type": "subtitle", "time": 4138.55, "timestamp": "01:08:58", "text": "糖豆人？哦，是五。我会保留我会"}]
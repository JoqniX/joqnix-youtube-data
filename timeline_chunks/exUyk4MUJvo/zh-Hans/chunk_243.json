[{"type": "subtitle", "time": 14594.51, "timestamp": "04:03:14", "text": "N 甚至连克罗伊亚都做不到"}, {"type": "subtitle", "time": 14596.95, "timestamp": "04:03:16", "text": "听着，老兄。我想死。我想要"}, {"type": "subtitle", "time": 14599.07, "timestamp": "04:03:19", "text": "打人。哦"}, {"type": "subtitle", "time": 14604.15, "timestamp": "04:03:24", "text": "上帝。啊，天哪。上帝啊，我的天哪。我"}, {"type": "subtitle", "time": 14606.389, "timestamp": "04:03:26", "text": "不要过度摇晃桌子。你"}, {"type": "subtitle", "time": 14609.229, "timestamp": "04:03:29", "text": "看到老鼠在移动。看看这只老鼠"}, {"type": "subtitle", "time": 14619.42, "timestamp": "04:03:39", "text": "桌子。好的。是的，是音频。"}, {"type": "subtitle", "time": 14620.75, "timestamp": "04:03:40", "text": "[音乐]"}, {"type": "subtitle", "time": 14623.79, "timestamp": "04:03:43", "text": "正确的？上帝。"}, {"type": "subtitle", "time": 14626.51, "timestamp": "04:03:46", "text": "天哪，我"}, {"type": "subtitle", "time": 14635.15, "timestamp": "04:03:55", "text": "已经。流媒体质量参差不齐"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "地方。流到处都是。"}]
[{"type": "subtitle", "time": 8522.87, "timestamp": "02:22:02", "text": "需要在日本买一台笔记本电脑。"}, {"type": "subtitle", "time": 8524.79, "timestamp": "02:22:04", "text": "你打算在日本买还是从其他地方买？"}, {"type": "subtitle", "time": 8528.27, "timestamp": "02:22:08", "text": "印度？呃，来自日本"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "实际上在游戏中玩游戏"}, {"type": "subtitle", "time": 8534.389, "timestamp": "02:22:14", "text": "流媒体等等。所以当时"}, {"type": "subtitle", "time": 8537.19, "timestamp": "02:22:17", "text": "想着弄到最新的东西之类的。"}, {"type": "subtitle", "time": 8542.75, "timestamp": "02:22:22", "text": "我不知道。笔记本电脑 5060 或 5090"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "509 5090。"}, {"type": "subtitle", "time": 8547.67, "timestamp": "02:22:27", "text": "是的。贵的那款。你在开玩笑吧？"}, {"type": "subtitle", "time": 8550.79, "timestamp": "02:22:30", "text": "我。但这一切都是值得的。"}, {"type": "subtitle", "time": 8553.99, "timestamp": "02:22:33", "text": "是的。现在的笔记本电脑真是太麻烦了。"}, {"type": "subtitle", "time": 8556.309, "timestamp": "02:22:36", "text": "比如如果是电脑，你可以升级和修复。"}, {"type": "subtitle", "time": 8557.83, "timestamp": "02:22:37", "text": "零件和所有东西。所有东西。我"}, {"type": "subtitle", "time": 8560.07, "timestamp": "02:22:40", "text": "知道。我知道。笔记本电脑。你必须购买"}, {"type": "subtitle", "time": 8562.23, "timestamp": "02:22:42", "text": "一切重来一遍。整个单元。"}, {"type": "subtitle", "time": 8565.51, "timestamp": "02:22:45", "text": "相信我，它非常非常重。"}, {"type": "subtitle", "time": 8568.63, "timestamp": "02:22:48", "text": "就像我会建议你买苹果产品一样。"}, {"type": "subtitle", "time": 8571.27, "timestamp": "02:22:51", "text": "MacBook Air 之类的，因为……"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "它用途广泛。嗯。那东西因为"}, {"type": "subtitle", "time": 8576.389, "timestamp": "02:22:56", "text": "你不能带出门的那东西"}, {"type": "subtitle", "time": 8579.51, "timestamp": "02:22:59", "text": "因为如果风扇停了，它"}]
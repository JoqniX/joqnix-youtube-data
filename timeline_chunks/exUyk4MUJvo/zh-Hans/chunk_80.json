[{"type": "subtitle", "time": 4800.07, "timestamp": "01:20:00", "text": "很多"}, {"type": "subtitle", "time": 4804.229, "timestamp": "01:20:04", "text": "我不是已经禁用了吗？还剩一个敌人。"}, {"type": "subtitle", "time": 4806.63, "timestamp": "01:20:06", "text": "只需要一点点。"}, {"type": "subtitle", "time": 4810.03, "timestamp": "01:20:10", "text": "正在观看。哦，是的，我不需要"}, {"type": "subtitle", "time": 4822.229, "timestamp": "01:20:22", "text": "重新装弹。哦，对了，它还会检查我的"}, {"type": "subtitle", "time": 4824.63, "timestamp": "01:20:24", "text": "频道点也包括在内。那些红色的人"}, {"type": "subtitle", "time": 4827.35, "timestamp": "01:20:27", "text": "就好像不会有人只是"}, {"type": "subtitle", "time": 4830.47, "timestamp": "01:20:30", "text": "兑换频道积分，对吧？"}, {"type": "subtitle", "time": 4833.189, "timestamp": "01:20:33", "text": "所以他们不会聊天，但他们只是赎罪。"}, {"type": "subtitle", "time": 4835.229, "timestamp": "01:20:35", "text": "健康要点，例如补充水分或"}, {"type": "subtitle", "time": 4837.59, "timestamp": "01:20:37", "text": "某物。所以每当我看到那个"}, {"type": "subtitle", "time": 4839.75, "timestamp": "01:20:39", "text": "在Twitch聊天室里，我只会说“你好”。"}, {"type": "subtitle", "time": 4843.51, "timestamp": "01:20:43", "text": "向他们问好。去！去！去。所以，我"}, {"type": "subtitle", "time": 4847.189, "timestamp": "01:20:47", "text": "我想要那份名单。敌人A。"}, {"type": "subtitle", "time": 4848.03, "timestamp": "01:20:48", "text": "手表"}, {"type": "subtitle", "time": 4849.95, "timestamp": "01:20:49", "text": "出去。"}, {"type": "subtitle", "time": 4855.27, "timestamp": "01:20:55", "text": "那里。他们死了。敌人A。"}]
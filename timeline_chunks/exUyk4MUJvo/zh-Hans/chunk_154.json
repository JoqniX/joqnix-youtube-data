[{"type": "subtitle", "time": 9243.67, "timestamp": "02:34:03", "text": "等等，你在线26小时了？"}, {"type": "subtitle", "time": 9246.469, "timestamp": "02:34:06", "text": "等等，我忘了时间了。"}, {"type": "subtitle", "time": 9249.87, "timestamp": "02:34:09", "text": "抽搐。 Twitch，呃，你得结束这一切。"}, {"type": "subtitle", "time": 9257.59, "timestamp": "02:34:17", "text": "所以你其实并没有结束。哦，是的，我一直"}, {"type": "subtitle", "time": 9261.429, "timestamp": "02:34:21", "text": "它让它继续下去。是的。"}, {"type": "subtitle", "time": 9264.87, "timestamp": "02:34:24", "text": "是的，我，我，我，我绝对是什么。"}, {"type": "subtitle", "time": 9266.55, "timestamp": "02:34:26", "text": "它打来的电话？为你的坚韧鼓掌"}, {"type": "subtitle", "time": 9270.309, "timestamp": "02:34:30", "text": "在 Twitch 上待了 40 个小时。你"}, {"type": "subtitle", "time": 9273.59, "timestamp": "02:34:33", "text": "我知道，我做不到，因为呃，我……"}, {"type": "subtitle", "time": 9276.95, "timestamp": "02:34:36", "text": "我没有……呃，它叫什么来着……呃……"}, {"type": "subtitle", "time": 9279.4, "timestamp": "02:34:39", "text": "有能力做到这一点。"}, {"type": "subtitle", "time": 9280.87, "timestamp": "02:34:40", "text": "[音乐]"}, {"type": "subtitle", "time": 9283.87, "timestamp": "02:34:43", "text": "它肯定在某个地方，有48个"}, {"type": "subtitle", "time": 9286.63, "timestamp": "02:34:46", "text": "几个小时，你睡在那48小时里吗？"}, {"type": "subtitle", "time": 9289.11, "timestamp": "02:34:49", "text": "你几个小时才吃东西？哦，对对对。"}, {"type": "subtitle", "time": 9291.15, "timestamp": "02:34:51", "text": "呃"}, {"type": "subtitle", "time": 9295.27, "timestamp": "02:34:55", "text": "所以一开始我常常会……"}, {"type": "subtitle", "time": 9297.429, "timestamp": "02:34:57", "text": "我忘了做那件事，但我现在想做了。"}]
[{"type": "subtitle", "time": 8102.629, "timestamp": "02:15:02", "text": "铁血猎犬的复仇"}, {"type": "subtitle", "time": 8105.109, "timestamp": "02:15:05", "text": "猎犬之类的。我看过那个。我"}, {"type": "subtitle", "time": 8106.75, "timestamp": "02:15:06", "text": "记得我"}, {"type": "subtitle", "time": 8110.39, "timestamp": "02:15:10", "text": "我想我，我想我，我想我知道你"}, {"type": "subtitle", "time": 8115.709, "timestamp": "02:15:15", "text": "是的。"}, {"type": "subtitle", "time": 8124.47, "timestamp": "02:15:24", "text": "嗯，我觉得这挺好的。"}, {"type": "subtitle", "time": 8127.99, "timestamp": "02:15:27", "text": "出色地。是的，我觉得这个不错。"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "那又是另一回事了，但是，呃，那"}, {"type": "subtitle", "time": 8134.709, "timestamp": "02:15:34", "text": "又回到了“如果我13岁”这个问题。"}, {"type": "subtitle", "time": 8140.229, "timestamp": "02:15:40", "text": "那个是什么，那个是什么，那是什么就是好的"}, {"type": "subtitle", "time": 8141.75, "timestamp": "02:15:41", "text": "有很多话要说。"}, {"type": "subtitle", "time": 8144.46, "timestamp": "02:15:44", "text": "如今超过13岁了。"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "[音乐]"}, {"type": "subtitle", "time": 8148.55, "timestamp": "02:15:48", "text": "你读过《北方北方》吗？"}, {"type": "subtitle", "time": 8151.99, "timestamp": "02:15:51", "text": "北方之刃魔力之刃？是它的"}, {"type": "subtitle", "time": 8154.229, "timestamp": "02:15:54", "text": "惊人的。我会告诉你名字。"}, {"type": "subtitle", "time": 8157.27, "timestamp": "02:15:57", "text": "它有着非常深刻的故事，而且它"}]
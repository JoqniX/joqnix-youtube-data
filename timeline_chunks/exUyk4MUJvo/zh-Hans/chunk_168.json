[{"type": "subtitle", "time": 10085.03, "timestamp": "02:48:05", "text": "单人间，但如果我被安排和……"}, {"type": "subtitle", "time": 10087.51, "timestamp": "02:48:07", "text": "我希望室友没事"}, {"type": "subtitle", "time": 10090.63, "timestamp": "02:48:10", "text": "和我一起做事情什么的"}, {"type": "subtitle", "time": 10092.71, "timestamp": "02:48:12", "text": "羞辱之类的。如果你掷骰子"}, {"type": "subtitle", "time": 10095.67, "timestamp": "02:48:15", "text": "你的骰子点数对了，你可能会得到一个"}, {"type": "subtitle", "time": 10099.19, "timestamp": "02:48:19", "text": "在那里或许能找到人生伴侣。"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "不，我的意思是，这就像只有两个吗？"}, {"type": "subtitle", "time": 10112.55, "timestamp": "02:48:32", "text": "室友或者五人左右的房间？啊，"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "感觉就像合租房一样。"}, {"type": "subtitle", "time": 10118.07, "timestamp": "02:48:38", "text": "在一个房间里，比如有厨房的地方。"}, {"type": "subtitle", "time": 10121.03, "timestamp": "02:48:41", "text": "家里所有这些东西。"}, {"type": "subtitle", "time": 10123.51, "timestamp": "02:48:43", "text": "但是，呃，我不太确定总共有多少个。"}, {"type": "subtitle", "time": 10127.51, "timestamp": "02:48:47", "text": "但我从那件事中看到的，呃，就像……"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "你管它叫什么，就像……"}, {"type": "subtitle", "time": 10132.469, "timestamp": "02:48:52", "text": "这份文件就像一份收费结构之类的东西"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "对，所以上面字面意思是……"}]
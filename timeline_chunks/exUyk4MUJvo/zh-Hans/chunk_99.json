[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "嗯，是的，这就像……"}, {"type": "subtitle", "time": 5943.109, "timestamp": "01:39:03", "text": "初始设计网格。我有一个官方的"}, {"type": "subtitle", "time": 5944.109, "timestamp": "01:39:04", "text": "一"}, {"type": "subtitle", "time": 5946.79, "timestamp": "01:39:06", "text": "未来。这就是我这么做的原因"}, {"type": "subtitle", "time": 5950.229, "timestamp": "01:39:10", "text": "某种程度上来说，这是一场运动会。是的"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "嗯，正在进行中。当然。"}, {"type": "subtitle", "time": 5956.39, "timestamp": "01:39:16", "text": "那真酷。那真漂亮"}, {"type": "subtitle", "time": 5959.189, "timestamp": "01:39:19", "text": "是的。所以你的直播间知道这件事吗？"}, {"type": "subtitle", "time": 5962.55, "timestamp": "01:39:22", "text": "你要去别的地方吗？是的，我做了"}, {"type": "subtitle", "time": 5966.39, "timestamp": "01:39:26", "text": "把所有关于出行的事情都告诉他们。"}, {"type": "subtitle", "time": 5969.35, "timestamp": "01:39:29", "text": "去日本之类的。"}, {"type": "subtitle", "time": 5972.31, "timestamp": "01:39:32", "text": "哦，是的。你有没有机会感到兴奋？"}, {"type": "subtitle", "time": 5975.189, "timestamp": "01:39:35", "text": "还是你更担心？呃，两者"}, {"type": "subtitle", "time": 5978.79, "timestamp": "01:39:38", "text": "其实挺兴奋的，因为感觉就像"}, {"type": "subtitle", "time": 5982.39, "timestamp": "01:39:42", "text": "我人生中一个新的篇章，就像是一个新的弧线，一个新的开始。"}, {"type": "subtitle", "time": 5985.31, "timestamp": "01:39:45", "text": "过着独立自主的生活"}, {"type": "subtitle", "time": 5988.39, "timestamp": "01:39:48", "text": "所有事情都得自己做，因为"}, {"type": "subtitle", "time": 5990.79, "timestamp": "01:39:50", "text": "我已经从小被父母宠坏了，因为"}, {"type": "subtitle", "time": 5995.75, "timestamp": "01:39:55", "text": "我是独生子女，嗯"}, {"type": "subtitle", "time": 5997.99, "timestamp": "01:39:57", "text": "我需要学习如何"}]
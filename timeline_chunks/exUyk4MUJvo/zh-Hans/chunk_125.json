[{"type": "subtitle", "time": 7501.35, "timestamp": "02:05:01", "text": "尽管。我最喜欢的之一。所以像谁"}, {"type": "subtitle", "time": 7503.35, "timestamp": "02:05:03", "text": "是最受欢迎的吗？帕科拉和"}, {"type": "subtitle", "time": 7505.27, "timestamp": "02:05:05", "text": "所有东西。第三代。曾是"}, {"type": "subtitle", "time": 7508.149, "timestamp": "02:05:08", "text": "这是第三代还是第四代？呃"}, {"type": "subtitle", "time": 7512.79, "timestamp": "02:05:12", "text": "帕科拉排第二，对吧？我不知道。"}, {"type": "subtitle", "time": 7516.07, "timestamp": "02:05:16", "text": "帕科拉就在那里。是的。哦，对，那就是"}, {"type": "subtitle", "time": 7517.709, "timestamp": "02:05:17", "text": "好的。"}, {"type": "subtitle", "time": 7521.07, "timestamp": "02:05:21", "text": "是的。我很高兴。帕可拉。我喜欢帕可拉，"}, {"type": "subtitle", "time": 7525.27, "timestamp": "02:05:25", "text": "男人。你还在玩《我的世界》吗？"}, {"type": "subtitle", "time": 7526.709, "timestamp": "02:05:26", "text": "我不认为他们是……"}, {"type": "subtitle", "time": 7529.669, "timestamp": "02:05:29", "text": "呃，我该怎么说呢，现在这么大"}, {"type": "subtitle", "time": 7533.03, "timestamp": "02:05:33", "text": "目前为止？"}, {"type": "subtitle", "time": 7535.109, "timestamp": "02:05:35", "text": "是啊，我想是因为语言的问题吧。"}, {"type": "subtitle", "time": 7536.87, "timestamp": "02:05:36", "text": "再次。永远都是语言的问题。"}, {"type": "subtitle", "time": 7540.39, "timestamp": "02:05:40", "text": "日方"}, {"type": "subtitle", "time": 7543.27, "timestamp": "02:05:43", "text": "就像你不能长那么大一样，因为"}, {"type": "subtitle", "time": 7545.03, "timestamp": "02:05:45", "text": "仅仅是因为语言。你可以这样做"}, {"type": "subtitle", "time": 7547.189, "timestamp": "02:05:47", "text": "你想要的一切。语言正在走向"}, {"type": "subtitle", "time": 7549.189, "timestamp": "02:05:49", "text": "阻止你。如果你是英国人，"}, {"type": "subtitle", "time": 7550.669, "timestamp": "02:05:50", "text": "你肯定报道得更多。"}, {"type": "subtitle", "time": 7557.189, "timestamp": "02:05:57", "text": "嗯，好吧，也算合理。这位 YouTuber"}, {"type": "subtitle", "time": 7559.109, "timestamp": "02:05:59", "text": "对方阵营依然表现良好。我想那里"}]
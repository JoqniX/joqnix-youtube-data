[{"type": "subtitle", "time": 2161.27, "timestamp": "00:36:01", "text": "还剩一个敌人。嗯，我只能"}, {"type": "subtitle", "time": 2165.27, "timestamp": "00:36:05", "text": "打开我的电脑，打开我的电脑，然后运行宏"}, {"type": "subtitle", "time": 2167.27, "timestamp": "00:36:07", "text": "就"}, {"type": "subtitle", "time": 2170.829, "timestamp": "00:36:10", "text": "撑住，稍后再回来或"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "某物。我希望他不会被禁赛。"}, {"type": "subtitle", "time": 2189.67, "timestamp": "00:36:29", "text": "呃，第五"}, {"type": "subtitle", "time": 2191.829, "timestamp": "00:36:31", "text": "找到匹配项。"}, {"type": "subtitle", "time": 2195.03, "timestamp": "00:36:35", "text": "是的。呃，咱们先呃一会儿，等我到了再说。"}, {"type": "subtitle", "time": 2197.55, "timestamp": "00:36:37", "text": "既然我来了，我们就来做……"}, {"type": "subtitle", "time": 2208.95, "timestamp": "00:36:48", "text": "咱们来玩昵称游戏吧，我之前是"}, {"type": "subtitle", "time": 2211.67, "timestamp": "00:36:51", "text": "你知道，我是在谈论YouTube。我"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "也就是说，我可以做到在 Twitch 午夜直播。"}, {"type": "subtitle", "time": 2216.27, "timestamp": "00:36:56", "text": "嗯，我想应该没问题吧。我不"}, {"type": "subtitle", "time": 2219.19, "timestamp": "00:36:59", "text": "知道。我喜欢我同时处理多项任务的感觉"}]
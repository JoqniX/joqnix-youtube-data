[{"type": "subtitle", "time": 3431.43, "timestamp": "00:57:11", "text": "好的，又回到332了。好的，所以我需要"}, {"type": "subtitle", "time": 3433.27, "timestamp": "00:57:13", "text": "安装这个。但是，真的有什么吗？"}, {"type": "subtitle", "time": 3437.27, "timestamp": "00:57:17", "text": "《堡垒之夜》里发生了什么？不。对。"}, {"type": "subtitle", "time": 3440.069, "timestamp": "00:57:20", "text": "但我没有空间。那是Go，"}, {"type": "subtitle", "time": 3454.63, "timestamp": "00:57:34", "text": "让我们玩。"}, {"type": "subtitle", "time": 3459.67, "timestamp": "00:57:39", "text": "小心。我的终极技能已经准备好了。"}, {"type": "subtitle", "time": 3468.95, "timestamp": "00:57:48", "text": "裂隙漫步功能已移除。最后一名幸存者。"}]
[{"type": "subtitle", "time": 6483.83, "timestamp": "01:48:03", "text": "我只希望我能好好学习，因为我"}, {"type": "subtitle", "time": 6486.629, "timestamp": "01:48:06", "text": "我认为在人生的某个阶段，呃，当我"}, {"type": "subtitle", "time": 6489.95, "timestamp": "01:48:09", "text": "感觉有点像几年前的事了。"}, {"type": "subtitle", "time": 6492.55, "timestamp": "01:48:12", "text": "嗯，我有点失去动力了。"}, {"type": "subtitle", "time": 6495.07, "timestamp": "01:48:15", "text": "因为我把精力都放在了我的爱好上，所以没怎么学习。"}, {"type": "subtitle", "time": 6498.87, "timestamp": "01:48:18", "text": "更多的是，是的，因为我花了很多时间"}, {"type": "subtitle", "time": 6500.709, "timestamp": "01:48:20", "text": "去那里有很多钱，父母是"}, {"type": "subtitle", "time": 6503.109, "timestamp": "01:48:23", "text": "给我寄了很多钱，我喜欢这样"}, {"type": "subtitle", "time": 6506.07, "timestamp": "01:48:26", "text": "至少把我送到那里去。"}, {"type": "subtitle", "time": 6508.709, "timestamp": "01:48:28", "text": "呃，学习。所以我希望喜欢学习，"}, {"type": "subtitle", "time": 6513.189, "timestamp": "01:48:33", "text": "把东西整理好，然后去见日本人。"}, {"type": "subtitle", "time": 6517.109, "timestamp": "01:48:37", "text": "呃，至少要达到JLPDN2或N1水平，这样我才能"}, {"type": "subtitle", "time": 6521.59, "timestamp": "01:48:41", "text": "找到一份工作，是的，这是我的目标之一。"}, {"type": "subtitle", "time": 6523.87, "timestamp": "01:48:43", "text": "在日本，拥有就是"}, {"type": "subtitle", "time": 6527.91, "timestamp": "01:48:47", "text": "比如确保我能找到一份好工作"}, {"type": "subtitle", "time": 6531.669, "timestamp": "01:48:51", "text": "然后你知道，把钱寄给我。"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "回到父母身边，或许还会带走"}, {"type": "subtitle", "time": 6536.31, "timestamp": "01:48:56", "text": "让他们也在那里，这样他们也能快乐起来。"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "你知道他们的儿子实际上确实……"}]
[{"type": "subtitle", "time": 6662.229, "timestamp": "01:51:02", "text": "片刻。是的。就是这样。对，你"}, {"type": "subtitle", "time": 6664.229, "timestamp": "01:51:04", "text": "我的意思是，我明白，因为我曾经也是"}, {"type": "subtitle", "time": 6666.87, "timestamp": "01:51:06", "text": "也一样。我认识一些英国人。我"}, {"type": "subtitle", "time": 6669.669, "timestamp": "01:51:09", "text": "我确实遇到了一个人，我的意思是，他不是英国人。"}, {"type": "subtitle", "time": 6671.669, "timestamp": "01:51:11", "text": "但在我认识他们期间，他们一直是我的好朋友。"}, {"type": "subtitle", "time": 6675.03, "timestamp": "01:51:15", "text": "在 Discord 上，一切都与我有关"}, {"type": "subtitle", "time": 6677.35, "timestamp": "01:51:17", "text": "我想，关键在于放手。"}, {"type": "subtitle", "time": 6678.95, "timestamp": "01:51:18", "text": "学会放下那层外壳，然后就……"}, {"type": "subtitle", "time": 6681.109, "timestamp": "01:51:21", "text": "展现真实的自我，然后开始吧"}, {"type": "subtitle", "time": 6684.07, "timestamp": "01:51:24", "text": "从那里开始。这取决于……"}, {"type": "subtitle", "time": 6686.229, "timestamp": "01:51:26", "text": "说实话，其他人也一样。"}, {"type": "subtitle", "time": 6687.83, "timestamp": "01:51:27", "text": "如果他们不介意露脸的话"}, {"type": "subtitle", "time": 6689.99, "timestamp": "01:51:29", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "我知道，我知道，在块茎领域，它就是其中之一。"}, {"type": "subtitle", "time": 6696.149, "timestamp": "01:51:36", "text": "你能做的最禁忌的事情之一。"}, {"type": "subtitle", "time": 6697.83, "timestamp": "01:51:37", "text": "M"}, {"type": "subtitle", "time": 6700.79, "timestamp": "01:51:40", "text": "但我的意思是，你只需要接受"}, {"type": "subtitle", "time": 6703.07, "timestamp": "01:51:43", "text": "有时需要跨越。"}, {"type": "subtitle", "time": 6708.87, "timestamp": "01:51:48", "text": "是的。对我来说，我确实喜欢"}, {"type": "subtitle", "time": 6711.75, "timestamp": "01:51:51", "text": "一开始我就觉得，呃，就像"}, {"type": "subtitle", "time": 6713.75, "timestamp": "01:51:53", "text": "对此我很敏感，就像我不想……"}, {"type": "subtitle", "time": 6716.31, "timestamp": "01:51:56", "text": "露个脸什么的。然后我"}]
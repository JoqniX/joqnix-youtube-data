[{"type": "subtitle", "time": 4380.55, "timestamp": "01:13:00", "text": "头晕目眩。我走了。"}, {"type": "subtitle", "time": 4394.31, "timestamp": "01:13:14", "text": "我想把独奏部分放出来。就是这样。"}, {"type": "subtitle", "time": 4397.51, "timestamp": "01:13:17", "text": "针对本场比赛。"}, {"type": "subtitle", "time": 4400.55, "timestamp": "01:13:20", "text": "正在扫描前方区域。"}, {"type": "subtitle", "time": 4406.35, "timestamp": "01:13:26", "text": "滚出我的"}, {"type": "subtitle", "time": 4428.87, "timestamp": "01:13:48", "text": "好的。最后一名幸存者。哦，他去世了。"}, {"type": "subtitle", "time": 4435.83, "timestamp": "01:13:55", "text": "我的天，有人比我强。哦，这是……"}, {"type": "subtitle", "time": 4439.43, "timestamp": "01:13:59", "text": "我们其中一个有毒吗？是的。"}]
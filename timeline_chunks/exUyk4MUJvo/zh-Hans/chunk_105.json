[{"type": "subtitle", "time": 6301.27, "timestamp": "01:45:01", "text": "诸如此类的事情。啊"}, {"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "因为这并非因为这个原因，而是因为……"}, {"type": "subtitle", "time": 6304.79, "timestamp": "01:45:04", "text": "这是因为文化原因，你知道的。"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "就像这种文化已经变成了我"}, {"type": "subtitle", "time": 6311.709, "timestamp": "01:45:11", "text": "不知道该怎么在直播里说，但是"}, {"type": "subtitle", "time": 6314.709, "timestamp": "01:45:14", "text": "是我，我会像我一样直截了当地说。"}, {"type": "subtitle", "time": 6317.59, "timestamp": "01:45:17", "text": "可以，而且我认为是因为这是我的。"}, {"type": "subtitle", "time": 6321.35, "timestamp": "01:45:21", "text": "这些都是韩国人自己说的。"}, {"type": "subtitle", "time": 6325.59, "timestamp": "01:45:25", "text": "如果是在城市里，或者更确切地说是在……"}, {"type": "subtitle", "time": 6328.39, "timestamp": "01:45:28", "text": "现在的现代传统韩国人"}, {"type": "subtitle", "time": 6330.55, "timestamp": "01:45:30", "text": "开始进行全球动员，他们是"}, {"type": "subtitle", "time": 6333.59, "timestamp": "01:45:33", "text": "开始接受。但那些"}, {"type": "subtitle", "time": 6335.91, "timestamp": "01:45:35", "text": "他们更传统，他们仍然觉得"}, {"type": "subtitle", "time": 6338.95, "timestamp": "01:45:38", "text": "更偏爱浅肤色"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "类型，你懂我的意思。是的。"}, {"type": "subtitle", "time": 6345.35, "timestamp": "01:45:45", "text": "日本人比较开放。"}, {"type": "subtitle", "time": 6347.75, "timestamp": "01:45:47", "text": "像你这样的情况，因为因为"}, {"type": "subtitle", "time": 6349.99, "timestamp": "01:45:49", "text": "如今很多人都去日本旅游。"}, {"type": "subtitle", "time": 6351.91, "timestamp": "01:45:51", "text": "诸如此类的事情。所以他们情况还不错。"}, {"type": "chat", "time": 6351.944, "timestamp": "01:45:51", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yoo"}, {"type": "subtitle", "time": 6354.79, "timestamp": "01:45:54", "text": "我觉得嗯。"}, {"type": "subtitle", "time": 6357.03, "timestamp": "01:45:57", "text": "你不会感觉到那种……"}]
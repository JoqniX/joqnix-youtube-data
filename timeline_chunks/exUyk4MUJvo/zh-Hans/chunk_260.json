[{"type": "subtitle", "time": 15610.67, "timestamp": "04:20:10", "text": "选举。我是哑巴。好的，一个"}, {"type": "subtitle", "time": 15613.51, "timestamp": "04:20:13", "text": "第二节是的，他们去过那里。你知道，"}, {"type": "subtitle", "time": 15615.99, "timestamp": "04:20:15", "text": "人们拿着扩音器大声喊叫"}, {"type": "subtitle", "time": 15618.55, "timestamp": "04:20:18", "text": "面包车里的扬声器"}, {"type": "subtitle", "time": 15623.07, "timestamp": "04:20:23", "text": "吉普车和那些东西在警戒。"}, {"type": "subtitle", "time": 15627.95, "timestamp": "04:20:27", "text": "啊，其他产品也是这样吗？"}, {"type": "subtitle", "time": 15631.07, "timestamp": "04:20:31", "text": "喀拉拉邦有哪些邦？就像这样"}, {"type": "subtitle", "time": 15635.349, "timestamp": "04:20:35", "text": "这些人坐着吉普车去。哦，是的。"}, {"type": "subtitle", "time": 15637.79, "timestamp": "04:20:37", "text": "你的第一个"}, {"type": "subtitle", "time": 15643.189, "timestamp": "04:20:43", "text": "选举。是的。等等，我做了，我做了，等等，我"}, {"type": "subtitle", "time": 15644.269, "timestamp": "04:20:44", "text": "做过"}, {"type": "subtitle", "time": 15648.11, "timestamp": "04:20:48", "text": "我做了什么。"}, {"type": "subtitle", "time": 15651.87, "timestamp": "04:20:51", "text": "所以，是今年还是去年？"}]
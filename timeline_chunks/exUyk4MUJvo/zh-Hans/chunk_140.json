[{"type": "subtitle", "time": 8401.429, "timestamp": "02:20:01", "text": "吉布利。哦，"}, {"type": "subtitle", "time": 8403.349, "timestamp": "02:20:03", "text": "我以前从未知道。他们最近刚刚新增了"}, {"type": "subtitle", "time": 8410.55, "timestamp": "02:20:10", "text": "好了。我得找点东西。"}, {"type": "subtitle", "time": 8412.75, "timestamp": "02:20:12", "text": "是吉卜力工作室吗？"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "实际上？哦，不。这不是吉卜力工作室的作品。"}, {"type": "subtitle", "time": 8419.51, "timestamp": "02:20:19", "text": "这是韩国科幻电影。好的。啊。"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "当宇航员离开地球进行质量提升时，"}, {"type": "subtitle", "time": 8424.23, "timestamp": "02:20:24", "text": "浩瀚无垠的空间分隔"}, {"type": "subtitle", "time": 8428.75, "timestamp": "02:20:28", "text": "星途恋人。我的天哪，真是的"}, {"type": "subtitle", "time": 8431.11, "timestamp": "02:20:31", "text": "俗气的。我不是，我不是，我不是对这方面不感兴趣。"}, {"type": "subtitle", "time": 8436.63, "timestamp": "02:20:36", "text": "现在。你呢？什么是？"}, {"type": "subtitle", "time": 8439.71, "timestamp": "02:20:39", "text": "你在看吗？"}, {"type": "subtitle", "time": 8443.57, "timestamp": "02:20:43", "text": "呃，我最后记得的事"}, {"type": "subtitle", "time": 8445.309, "timestamp": "02:20:45", "text": "[音乐]"}, {"type": "subtitle", "time": 8450.469, "timestamp": "02:20:50", "text": "我最近看了《壮志凌云：独行侠》。"}, {"type": "subtitle", "time": 8452.79, "timestamp": "02:20:52", "text": "那挺好的。那挺好的。那挺好的。"}, {"type": "subtitle", "time": 8455.349, "timestamp": "02:20:55", "text": "是的，我开始沉迷于这个游戏了。"}]
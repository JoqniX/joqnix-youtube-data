[{"type": "subtitle", "time": 6360.229, "timestamp": "01:46:00", "text": "歧视日本。我会"}, {"type": "subtitle", "time": 6363.27, "timestamp": "01:46:03", "text": "说你不会直接感觉到它"}, {"type": "subtitle", "time": 6367.189, "timestamp": "01:46:07", "text": "如果你明白我的意思。是的。"}, {"type": "subtitle", "time": 6368.55, "timestamp": "01:46:08", "text": "而且我觉得你无论去哪里都不会……"}, {"type": "subtitle", "time": 6370.87, "timestamp": "01:46:10", "text": "感到直接的歧视"}, {"type": "subtitle", "time": 6373.59, "timestamp": "01:46:13", "text": "任何地方，因为那就像法律上的"}, {"type": "subtitle", "time": 6376.47, "timestamp": "01:46:16", "text": "这是在法律上很难做到的事。如果"}, {"type": "subtitle", "time": 6377.99, "timestamp": "01:46:17", "text": "如果你觉得可以，你随时都可以。"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "拍个TikTok视频什么的。"}, {"type": "subtitle", "time": 6383.109, "timestamp": "01:46:23", "text": "是的。哦，你终于可以用TikTok了"}, {"type": "subtitle", "time": 6387.189, "timestamp": "01:46:27", "text": "顺便一提。是的。是的。最后。"}, {"type": "subtitle", "time": 6389.83, "timestamp": "01:46:29", "text": "哦好的。相信我，就是这样。"}, {"type": "subtitle", "time": 6391.99, "timestamp": "01:46:31", "text": "幸好你远离那里。不"}, {"type": "subtitle", "time": 6395.51, "timestamp": "01:46:35", "text": "别……别掉进去。你不想"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "陷入其中。是的。坚持你的"}, {"type": "subtitle", "time": 6401.44, "timestamp": "01:46:41", "text": "YouTube 和 Instagram 的资源。"}, {"type": "subtitle", "time": 6402.95, "timestamp": "01:46:42", "text": "[音乐]"}, {"type": "subtitle", "time": 6411.03, "timestamp": "01:46:51", "text": "媒体。是的。"}, {"type": "subtitle", "time": 6413.189, "timestamp": "01:46:53", "text": "您对日本有什么期望？"}, {"type": "subtitle", "time": 6415.51, "timestamp": "01:46:55", "text": "说实话？符合预期吗？什么"}, {"type": "subtitle", "time": 6416.43, "timestamp": "01:46:56", "text": "你看"}, {"type": "subtitle", "time": 6418.59, "timestamp": "01:46:58", "text": "你自己？"}]
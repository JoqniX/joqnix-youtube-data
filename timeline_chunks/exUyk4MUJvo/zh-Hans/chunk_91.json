[{"type": "subtitle", "time": 5460.03, "timestamp": "01:31:00", "text": "也。我不想手动输入"}, {"type": "subtitle", "time": 5462.95, "timestamp": "01:31:02", "text": "它。人们正在排队等候。"}, {"type": "subtitle", "time": 5465.91, "timestamp": "01:31:05", "text": "某物。呃，老兄，我收到好多呢。"}, {"type": "subtitle", "time": 5467.709, "timestamp": "01:31:07", "text": "想法"}, {"type": "subtitle", "time": 5470.709, "timestamp": "01:31:10", "text": "直播提升生活品质的内容。我没了"}, {"type": "subtitle", "time": 5510.03, "timestamp": "01:31:50", "text": "放是吗？"}, {"type": "subtitle", "time": 5514.189, "timestamp": "01:31:54", "text": "你？宝贝，是你吗？嘘。"}, {"type": "subtitle", "time": 5517.75, "timestamp": "01:31:57", "text": "等等，什么？"}]
[{"type": "subtitle", "time": 1501.77, "timestamp": "00:25:01", "text": "这不是隧道床。不，那可就大了。"}, {"type": "subtitle", "time": 1503.63, "timestamp": "00:25:03", "text": "[音乐]"}, {"type": "subtitle", "time": 1507.549, "timestamp": "00:25:07", "text": "嗯，跟L有关的东西。"}, {"type": "subtitle", "time": 1510.23, "timestamp": "00:25:10", "text": "呃，莱纳德。是的，伦纳德。伦纳德。"}, {"type": "subtitle", "time": 1511.549, "timestamp": "00:25:11", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 1514.19, "timestamp": "00:25:14", "text": "伦纳德。我当时"}, {"type": "subtitle", "time": 1518.43, "timestamp": "00:25:18", "text": "想知道在某些情况下会怎样，"}, {"type": "subtitle", "time": 1521.549, "timestamp": "00:25:21", "text": "正确的？如果什么"}, {"type": "subtitle", "time": 1525.99, "timestamp": "00:25:25", "text": "我喜欢那样，我不知道。"}, {"type": "subtitle", "time": 1528.95, "timestamp": "00:25:28", "text": "就像这样渲染一样"}, {"type": "subtitle", "time": 1531.029, "timestamp": "00:25:31", "text": "这个东西的渲染等等都正确"}, {"type": "subtitle", "time": 1534.75, "timestamp": "00:25:34", "text": "那。如果我有一个类似……的东西"}, {"type": "subtitle", "time": 1538.669, "timestamp": "00:25:38", "text": "莱纳德那玩意儿只是为了"}, {"type": "subtitle", "time": 1541.07, "timestamp": "00:25:41", "text": "举个例子，我们想象一下"}, {"type": "subtitle", "time": 1543.909, "timestamp": "00:25:43", "text": "以防万一我们有伦纳德"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "拥有良好 CPU 和内存的实例"}, {"type": "subtitle", "time": 1548.51, "timestamp": "00:25:48", "text": "以及GPU和"}, {"type": "subtitle", "time": 1559.35, "timestamp": "00:25:59", "text": "哦，有一瞬间我以为我的游戏"}]
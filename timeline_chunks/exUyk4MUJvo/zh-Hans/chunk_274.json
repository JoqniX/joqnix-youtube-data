[{"type": "subtitle", "time": 16470.99, "timestamp": "04:34:30", "text": "我好无聊。他妈的。我不能在"}, {"type": "subtitle", "time": 16472.99, "timestamp": "04:34:32", "text": "这"}, {"type": "subtitle", "time": 16477.23, "timestamp": "04:34:37", "text": "h.上帝。该死。该死。"}, {"type": "subtitle", "time": 16489.51, "timestamp": "04:34:49", "text": "H. 你知道最有趣的。患病的"}, {"type": "subtitle", "time": 16492.629, "timestamp": "04:34:52", "text": "给你看看我经常指导的那些人，"}, {"type": "subtitle", "time": 16494.75, "timestamp": "04:34:54", "text": "尤其"}, {"type": "subtitle", "time": 16498.31, "timestamp": "04:34:58", "text": "任务是看看如何"}]
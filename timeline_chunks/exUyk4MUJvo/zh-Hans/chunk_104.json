[{"type": "subtitle", "time": 6240.07, "timestamp": "01:44:00", "text": "他们说我会、我会再次到达那里。"}, {"type": "subtitle", "time": 6243.27, "timestamp": "01:44:03", "text": "嗯。是的。我不知道。我参加 我参加"}, {"type": "subtitle", "time": 6245.35, "timestamp": "01:44:05", "text": "这座新城市我只住了几个月而已。"}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "差不多是这样。所以我不得不出差，因为……"}, {"type": "subtitle", "time": 6254.47, "timestamp": "01:44:14", "text": "嗯，是的，那里有海滩什么的。所以"}, {"type": "subtitle", "time": 6256.39, "timestamp": "01:44:16", "text": "它很漂亮，它很漂亮，它很漂亮"}, {"type": "subtitle", "time": 6263.35, "timestamp": "01:44:23", "text": "嗯，我觉得最近发生的事情之一是……"}, {"type": "subtitle", "time": 6266.629, "timestamp": "01:44:26", "text": "我会得到的东西，你知道的，就是它们"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "有时有些人会"}, {"type": "subtitle", "time": 6273.35, "timestamp": "01:44:33", "text": "呃，对其他国家有点不礼貌。"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "人们就因为你是印度人就这么说。"}, {"type": "subtitle", "time": 6281.91, "timestamp": "01:44:41", "text": "歧视什么的，呃，不不，是你。"}, {"type": "subtitle", "time": 6283.99, "timestamp": "01:44:43", "text": "在日本不必担心这个问题。"}, {"type": "subtitle", "time": 6287.35, "timestamp": "01:44:47", "text": "我想是的，你会有这种感觉。"}, {"type": "subtitle", "time": 6291.43, "timestamp": "01:44:51", "text": "我认为还有更多。"}, {"type": "subtitle", "time": 6294.149, "timestamp": "01:44:54", "text": "那里肯定有一些，但是……"}, {"type": "subtitle", "time": 6296.709, "timestamp": "01:44:56", "text": "更北部的地区"}, {"type": "subtitle", "time": 6298.55, "timestamp": "01:44:58", "text": "我觉得这种情况在韩国更常见。"}]
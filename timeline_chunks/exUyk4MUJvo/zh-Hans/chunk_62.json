[{"type": "subtitle", "time": 3721.789, "timestamp": "01:02:01", "text": "跨界车。确切地。你在那里。呃"}, {"type": "subtitle", "time": 3741.91, "timestamp": "01:02:21", "text": "我死了。"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "等等。这是专家的手势，对吧？"}, {"type": "subtitle", "time": 3757.829, "timestamp": "01:02:37", "text": "正确的。哦，是的。是的。你好吗"}, {"type": "subtitle", "time": 3760.309, "timestamp": "01:02:40", "text": "正在做？专家签名。是的。是的。是的。我"}, {"type": "subtitle", "time": 3763.19, "timestamp": "01:02:43", "text": "忘了。就像你上次来的时候一样"}, {"type": "subtitle", "time": 3765.27, "timestamp": "01:02:45", "text": "那是什么时候的事？"}, {"type": "subtitle", "time": 3767.43, "timestamp": "01:02:47", "text": "你来了，就像“是啊”。已经很久了"}, {"type": "subtitle", "time": 3770.71, "timestamp": "01:02:50", "text": "时间。是的。是的。是的。就像上次一样"}, {"type": "subtitle", "time": 3772.829, "timestamp": "01:02:52", "text": "十二月。"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "知道他什么时候问起钥匙的事，"}, {"type": "subtitle", "time": 3778.87, "timestamp": "01:02:58", "text": "樱花和她的家人一起直播。我当时是吗？"}]
[{"type": "subtitle", "time": 5769.43, "timestamp": "01:36:09", "text": "大家好。所以，我很抱歉……"}, {"type": "subtitle", "time": 5771.43, "timestamp": "01:36:11", "text": "呃，今天开始得有点晚，不过是的。"}, {"type": "subtitle", "time": 5775.51, "timestamp": "01:36:15", "text": "欢迎来到 Chathon 的第 82 天。它是"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "官方"}, {"type": "subtitle", "time": 5778.35, "timestamp": "01:36:18", "text": "呃，是"}, {"type": "subtitle", "time": 5782.629, "timestamp": "01:36:22", "text": "正式日期是六月，也就是最后一天。"}, {"type": "subtitle", "time": 5785.35, "timestamp": "01:36:25", "text": "Jockathon 比赛的一部分在这里举行。"}, {"type": "subtitle", "time": 5789.11, "timestamp": "01:36:29", "text": "但今天，在这个月的开始，我们"}, {"type": "subtitle", "time": 5792.43, "timestamp": "01:36:32", "text": "我们有一位特别嘉宾。我们有一个"}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "西摩·斯卡莫尔。我很抱歉"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "把你的名字念错了。你好。"}, {"type": "subtitle", "time": 5800.639, "timestamp": "01:36:40", "text": "你好。 你好。让我了解一下你的反应。"}, {"type": "subtitle", "time": 5808.39, "timestamp": "01:36:48", "text": "好了。它应该会弹出。请"}, {"type": "subtitle", "time": 5815.43, "timestamp": "01:36:55", "text": "向上。已经过去一段时间了，对吧？我们聊了"}, {"type": "subtitle", "time": 5819.35, "timestamp": "01:36:59", "text": "然后就这样待在一起。你呢？"}]
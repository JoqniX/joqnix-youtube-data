[{"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "哦，对不起。但是，是啊，我当时就想……"}, {"type": "subtitle", "time": 18005.99, "timestamp": "05:00:05", "text": "修修补补。技术问题"}, {"type": "subtitle", "time": 18007.51, "timestamp": "05:00:07", "text": "现在。"}, {"type": "subtitle", "time": 18009.91, "timestamp": "05:00:09", "text": "发生了很多更新和事情。我 我"}, {"type": "subtitle", "time": 18017.788, "timestamp": "05:00:17", "text": "一又二又半"}, {"type": "subtitle", "time": 18020.39, "timestamp": "05:00:20", "text": "我想大概是白天吧。而且还有很多。"}, {"type": "subtitle", "time": 18024.27, "timestamp": "05:00:24", "text": "已更新。我的天哪，是"}, {"type": "subtitle", "time": 18026.868, "timestamp": "05:00:26", "text": "二月。是啊，大家最近怎么样？"}, {"type": "subtitle", "time": 18030.708, "timestamp": "05:00:30", "text": "今晚有什么安排？你好。你好。睡得好"}, {"type": "subtitle", "time": 18033.708, "timestamp": "05:00:33", "text": "星期二。星期二快乐。"}, {"type": "subtitle", "time": 18037.67, "timestamp": "05:00:37", "text": "是的。是的，今天我们要玩游戏。"}, {"type": "subtitle", "time": 18040.788, "timestamp": "05:00:40", "text": "一款名为《入伍》的游戏。更有可能"}, {"type": "subtitle", "time": 18045.19, "timestamp": "05:00:45", "text": "呃，它是一款基于《战争世界》的游戏。它"}, {"type": "subtitle", "time": 18047.67, "timestamp": "05:00:47", "text": "是一款很有趣的游戏。我当时正在看一部不错的电影。"}, {"type": "subtitle", "time": 18050.628, "timestamp": "05:00:50", "text": "我的朋友，那个吸血鬼医生，玩"}, {"type": "subtitle", "time": 18052.868, "timestamp": "05:00:52", "text": "游戏。所以我就想，“我的天哪，"}, {"type": "subtitle", "time": 18055.15, "timestamp": "05:00:55", "text": "这款游戏真好玩，而且是世界级的。"}, {"type": "subtitle", "time": 18056.83, "timestamp": "05:00:56", "text": "战争"}, {"type": "subtitle", "time": 18059.03, "timestamp": "05:00:59", "text": "战场。我的天啊，这是……"}]
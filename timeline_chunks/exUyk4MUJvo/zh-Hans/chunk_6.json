[{"type": "subtitle", "time": 362.11, "timestamp": "00:06:02", "text": "你的职责还没有结束。我的天哪。感谢"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "你。下来。"}, {"type": "subtitle", "time": 383.67, "timestamp": "00:06:23", "text": "那里。快用完了。还剩30秒。哦"}, {"type": "subtitle", "time": 398.07, "timestamp": "00:06:38", "text": "天哪，我射不中枪了。我的天啊。"}, {"type": "subtitle", "time": 402.23, "timestamp": "00:06:42", "text": "最后一名幸存者。我不会射击。"}, {"type": "subtitle", "time": 405.19, "timestamp": "00:06:45", "text": "还剩10秒。"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "[掌声]"}]
[{"type": "subtitle", "time": 16260.429, "timestamp": "04:31:00", "text": "呃，是我弄坏了吗？这是怎么回事？"}, {"type": "subtitle", "time": 16262.83, "timestamp": "04:31:02", "text": "延迟？正是如此。"}, {"type": "subtitle", "time": 16266.63, "timestamp": "04:31:06", "text": "延迟。哦，等等。如果你同时点击它们"}, {"type": "subtitle", "time": 16270.31, "timestamp": "04:31:10", "text": "总而言之，它们有点像循环。即使"}, {"type": "subtitle", "time": 16279.51, "timestamp": "04:31:19", "text": "你会看到一个滑动效果。哦，那是什么？"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "叫什么？我不知道。呃，是幻灯片还是波拉？"}, {"type": "subtitle", "time": 16285.469, "timestamp": "04:31:25", "text": "是的，pora。波拉"}, {"type": "subtitle", "time": 16288.55, "timestamp": "04:31:28", "text": "波拉。我连基本的东西都忘了。我"}, {"type": "subtitle", "time": 16291.389, "timestamp": "04:31:31", "text": "以前经常点赞关注"}, {"type": "subtitle", "time": 16295.51, "timestamp": "04:31:35", "text": "就像很多关于 FL Studio 的教程一样。"}, {"type": "subtitle", "time": 16299.95, "timestamp": "04:31:39", "text": "先用 Studio，然后是 Ableton，最后是混音。"}, {"type": "subtitle", "time": 16303.59, "timestamp": "04:31:43", "text": "大师喜欢那件事"}, {"type": "subtitle", "time": 16308.429, "timestamp": "04:31:48", "text": "那段时间我感觉自己好像无法喜欢"}, {"type": "subtitle", "time": 16313.03, "timestamp": "04:31:53", "text": "充分发挥创意，把我的想法变成现实。"}, {"type": "subtitle", "time": 16315.67, "timestamp": "04:31:55", "text": "我的脑子一片空白，我做不到，我做不到，我当时无法做到。"}, {"type": "subtitle", "time": 16318.149, "timestamp": "04:31:58", "text": "到"}]
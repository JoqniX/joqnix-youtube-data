[{"type": "subtitle", "time": 6900.75, "timestamp": "01:55:00", "text": "走出屏幕，思考一下"}, {"type": "subtitle", "time": 6904.07, "timestamp": "01:55:04", "text": "其实，这真的无关紧要。"}, {"type": "subtitle", "time": 6906.39, "timestamp": "01:55:06", "text": "诚实的。就像我以前对这件事非常忌讳一样"}, {"type": "subtitle", "time": 6908.95, "timestamp": "01:55:08", "text": "露脸。但我一出现"}, {"type": "subtitle", "time": 6912.87, "timestamp": "01:55:12", "text": "我的脸变了，我遇到了更多的人。我"}, {"type": "subtitle", "time": 6915.03, "timestamp": "01:55:15", "text": "与他们建立更私人的联系"}, {"type": "subtitle", "time": 6919.27, "timestamp": "01:55:19", "text": "与其说是水平，不如说是……呃"}, {"type": "subtitle", "time": 6921.27, "timestamp": "01:55:21", "text": "它叫什么名字？我知道，我知道你喜欢"}, {"type": "subtitle", "time": 6923.75, "timestamp": "01:55:23", "text": "你对被评判的恐惧感是什么感觉？"}, {"type": "subtitle", "time": 6926.31, "timestamp": "01:55:26", "text": "以及所有的一切，我总是这样想。"}, {"type": "subtitle", "time": 6928.79, "timestamp": "01:55:28", "text": "如果他们真的以貌取人的话"}, {"type": "subtitle", "time": 6930.629, "timestamp": "01:55:30", "text": "这意味着我不想与……有联系"}, {"type": "subtitle", "time": 6933.91, "timestamp": "01:55:33", "text": "他们。如果他们没问题的话"}, {"type": "subtitle", "time": 6935.99, "timestamp": "01:55:35", "text": "如果他们那样做，而且他们不那样做"}, {"type": "subtitle", "time": 6937.43, "timestamp": "01:55:37", "text": "想让你知道他们不想这样做"}, {"type": "subtitle", "time": 6939.43, "timestamp": "01:55:39", "text": "它。我宁愿不与他们来往"}, {"type": "subtitle", "time": 6941.43, "timestamp": "01:55:41", "text": "如果他们因此评判我，就不要和他们交往。"}, {"type": "subtitle", "time": 6945.189, "timestamp": "01:55:45", "text": "我的外貌或者我是谁。我想你"}, {"type": "subtitle", "time": 6946.03, "timestamp": "01:55:46", "text": "不能"}, {"type": "subtitle", "time": 6948.709, "timestamp": "01:55:48", "text": "你其实根本逃不掉"}, {"type": "subtitle", "time": 6952.629, "timestamp": "01:55:52", "text": "你是谁。是的。或者躲在……后面"}, {"type": "subtitle", "time": 6955.27, "timestamp": "01:55:55", "text": "虚拟主播形象。它在那里是为了结识新朋友。"}, {"type": "subtitle", "time": 6958.149, "timestamp": "01:55:58", "text": "人们。所以我想，我猜真的"}]
[{"type": "subtitle", "time": 6542.55, "timestamp": "01:49:02", "text": "他尽力了，然后把他们带来了"}, {"type": "subtitle", "time": 6545.55, "timestamp": "01:49:05", "text": "那里。他们现在应该很高兴了。"}, {"type": "subtitle", "time": 6549.109, "timestamp": "01:49:09", "text": "是的。嗯，这些就像目标或"}, {"type": "subtitle", "time": 6552.149, "timestamp": "01:49:12", "text": "就像我在日本时做的梦一样。"}, {"type": "subtitle", "time": 6555.27, "timestamp": "01:49:15", "text": "这是我成功所必需的。但是，是啊，谁？"}, {"type": "subtitle", "time": 6558.31, "timestamp": "01:49:18", "text": "知道吗？我肯定能得到一个好的……"}, {"type": "subtitle", "time": 6561.189, "timestamp": "01:49:21", "text": "兼职工作。糟糕的兼职工作是"}, {"type": "subtitle", "time": 6564.31, "timestamp": "01:49:24", "text": "对我来说是必须的。学校告诉我"}, {"type": "subtitle", "time": 6566.39, "timestamp": "01:49:26", "text": "对我来说，这是必须的。这是必需的"}, {"type": "subtitle", "time": 6568.39, "timestamp": "01:49:28", "text": "让我去做。"}, {"type": "subtitle", "time": 6571.91, "timestamp": "01:49:31", "text": "是的，大概每周28小时。"}, {"type": "subtitle", "time": 6574.709, "timestamp": "01:49:34", "text": "必须去做。如果我超过那个数，那就是"}, {"type": "subtitle", "time": 6577.43, "timestamp": "01:49:37", "text": "违法之类的。他们有很多"}, {"type": "subtitle", "time": 6583.109, "timestamp": "01:49:43", "text": "我们在这里只有20个小时。"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "兼职。我喜欢我的工作时间，你可以"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "做20个小时。我的意思是，薪水嘛……"}, {"type": "subtitle", "time": 6591.189, "timestamp": "01:49:51", "text": "它应该比日本更多，但实际上"}, {"type": "subtitle", "time": 6593.59, "timestamp": "01:49:53", "text": "与此同时，这里的东西又超级贵。"}, {"type": "subtitle", "time": 6596.229, "timestamp": "01:49:56", "text": "相信我。哦，是的"}, {"type": "subtitle", "time": 6598.39, "timestamp": "01:49:58", "text": "就像你不可能得到低于一的任何值一样。"}]
[{"type": "subtitle", "time": 10800.07, "timestamp": "03:00:00", "text": "相信我，独居才是最好的。"}, {"type": "subtitle", "time": 10802.83, "timestamp": "03:00:02", "text": "支持。"}, {"type": "subtitle", "time": 10805.19, "timestamp": "03:00:05", "text": "你发挥得如此出色，你"}, {"type": "subtitle", "time": 10806.95, "timestamp": "03:00:06", "text": "掷这么大的骰子。你知道，你"}, {"type": "subtitle", "time": 10808.55, "timestamp": "03:00:08", "text": "不知道你最终会和谁在一起。如果"}, {"type": "subtitle", "time": 10810.15, "timestamp": "03:00:10", "text": "你知道你最终会成为什么样的人。"}, {"type": "subtitle", "time": 10811.91, "timestamp": "03:00:11", "text": "如果可以，那就好。是的。你可以，你"}, {"type": "subtitle", "time": 10813.51, "timestamp": "03:00:13", "text": "你知道，你可以像这样和那个人交谈"}, {"type": "subtitle", "time": 10815.51, "timestamp": "03:00:15", "text": "比如说，“哦，对了，我做这个这个我是"}, {"type": "subtitle", "time": 10817.349, "timestamp": "03:00:17", "text": "一个油管博主之类的。"}, {"type": "subtitle", "time": 10820.469, "timestamp": "03:00:20", "text": "是的。是的。没错，没错，没错。但是如果"}, {"type": "subtitle", "time": 10822.55, "timestamp": "03:00:22", "text": "你不是，但那样就像是整个"}, {"type": "subtitle", "time": 10824.55, "timestamp": "03:00:24", "text": "完全是两码事。"}, {"type": "subtitle", "time": 10826.389, "timestamp": "03:00:26", "text": "我很惊讶他们竟然不给你"}, {"type": "subtitle", "time": 10830.349, "timestamp": "03:00:30", "text": "两个不同的房间。我非常惊讶。"}, {"type": "subtitle", "time": 10831.99, "timestamp": "03:00:31", "text": "是的。"}, {"type": "subtitle", "time": 10835.469, "timestamp": "03:00:35", "text": "我更困惑了"}, {"type": "subtitle", "time": 10838.63, "timestamp": "03:00:38", "text": "嗯，我不知道这个系统是怎么运作的。"}, {"type": "subtitle", "time": 10840.51, "timestamp": "03:00:40", "text": "就像……"}, {"type": "subtitle", "time": 10843.51, "timestamp": "03:00:43", "text": "就像我在想……的时候"}, {"type": "subtitle", "time": 10846.55, "timestamp": "03:00:46", "text": "这就像一个为期六个月的测谎程序"}, {"type": "subtitle", "time": 10848.71, "timestamp": "03:00:48", "text": "对，就是这样。"}, {"type": "subtitle", "time": 10850.389, "timestamp": "03:00:50", "text": "大概是因为它是一种语言吧。"}, {"type": "subtitle", "time": 10852.87, "timestamp": "03:00:52", "text": "他们最终都会去上学。"}, {"type": "subtitle", "time": 10856.15, "timestamp": "03:00:56", "text": "一年内会有学生入学。"}, {"type": "subtitle", "time": 10858.71, "timestamp": "03:00:58", "text": "对，一年后那件事就发生了，对吧？"}]
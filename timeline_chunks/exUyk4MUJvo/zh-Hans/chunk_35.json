[{"type": "subtitle", "time": 2107.79, "timestamp": "00:35:07", "text": "这？啊，访问"}, {"type": "subtitle", "time": 2126.069, "timestamp": "00:35:26", "text": "苹果。我的天啊。"}, {"type": "subtitle", "time": 2131.27, "timestamp": "00:35:31", "text": "准备好。我为自己当初指出这一点感到很内疚。"}, {"type": "subtitle", "time": 2147.91, "timestamp": "00:35:47", "text": "对凤凰城不利。我喜欢他这种坦率的性格。"}, {"type": "subtitle", "time": 2149.91, "timestamp": "00:35:49", "text": "我认为他也是刚刚赢得……的人"}, {"type": "subtitle", "time": 2153.27, "timestamp": "00:35:53", "text": "刷经验值的时候，那家伙说：“是啊，我"}, {"type": "subtitle", "time": 2156.55, "timestamp": "00:35:56", "text": "我不知道该怎么办。我所做的一切都是真的。"}, {"type": "subtitle", "time": 2158.71, "timestamp": "00:35:58", "text": "只是"}]
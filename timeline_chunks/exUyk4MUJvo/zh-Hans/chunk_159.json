[{"type": "subtitle", "time": 9541.19, "timestamp": "02:39:01", "text": "日本。事情并非如此。只是"}, {"type": "subtitle", "time": 9544.07, "timestamp": "02:39:04", "text": "自由的定义会发生变化。是的，"}, {"type": "subtitle", "time": 9547.03, "timestamp": "02:39:07", "text": "定义变更。是的。"}, {"type": "subtitle", "time": 9550.83, "timestamp": "02:39:10", "text": "所以我就想，是啊。"}, {"type": "subtitle", "time": 9554.95, "timestamp": "02:39:14", "text": "嗯，既然我在做这个Subaton类型的"}, {"type": "subtitle", "time": 9558.91, "timestamp": "02:39:18", "text": "既然如此，为什么不试着打破自己的规则呢？"}, {"type": "subtitle", "time": 9562.07, "timestamp": "02:39:22", "text": "直播时长之类的？当然，呃"}, {"type": "subtitle", "time": 9564.23, "timestamp": "02:39:24", "text": "我可以休息，休息足够多的时间，这样我"}, {"type": "subtitle", "time": 9567.27, "timestamp": "02:39:27", "text": "能够有足够的能量继续下去"}, {"type": "subtitle", "time": 9570.79, "timestamp": "02:39:30", "text": "那些事件以及所有的事情，呃……"}, {"type": "subtitle", "time": 9572.87, "timestamp": "02:39:32", "text": "月底的合作活动"}, {"type": "subtitle", "time": 9575.19, "timestamp": "02:39:35", "text": "五月份的时候等等。所以我就想，"}, {"type": "subtitle", "time": 9577.19, "timestamp": "02:39:37", "text": "是啊，为什么不呢？我做过这件事吗？然后我"}, {"type": "subtitle", "time": 9579.11, "timestamp": "02:39:39", "text": "比如，“是啊，为什么不呢？”我做到了。我"}, {"type": "subtitle", "time": 9580.63, "timestamp": "02:39:40", "text": "思考"}, {"type": "subtitle", "time": 9583.59, "timestamp": "02:39:43", "text": "我有点后悔。我确实有一个"}, {"type": "subtitle", "time": 9587.03, "timestamp": "02:39:47", "text": "后悔吧，是啊。前进。如果你这样做"}, {"type": "subtitle", "time": 9589.19, "timestamp": "02:39:49", "text": "如果你真的要去日本，我希望你"}, {"type": "subtitle", "time": 9591.71, "timestamp": "02:39:51", "text": "展现出同样的韧性。我是说，"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "就像在学习中一样。当然是在学习方面。"}, {"type": "subtitle", "time": 9596.87, "timestamp": "02:39:56", "text": "是的。研究。是的。是的。是的。那是"}, {"type": "subtitle", "time": 9598.15, "timestamp": "02:39:58", "text": "你肯定会得到的东西"}]
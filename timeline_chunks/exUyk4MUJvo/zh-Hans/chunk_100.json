[{"type": "subtitle", "time": 6000.31, "timestamp": "01:40:00", "text": "烹饪和填充"}, {"type": "subtitle", "time": 6002.27, "timestamp": "01:40:02", "text": "相信我"}, {"type": "subtitle", "time": 6005.35, "timestamp": "01:40:05", "text": "野外生存烹饪。好的。我仍然"}, {"type": "subtitle", "time": 6008.709, "timestamp": "01:40:08", "text": "需要学习如何烹饪肉类之类的食物"}, {"type": "subtitle", "time": 6010.55, "timestamp": "01:40:10", "text": "还有鱼之类的东西。那些东西"}, {"type": "subtitle", "time": 6012.709, "timestamp": "01:40:12", "text": "需要学习以及如何准备。不，"}, {"type": "subtitle", "time": 6014.55, "timestamp": "01:40:14", "text": "不，相信我，你会需要的"}, {"type": "subtitle", "time": 6016.79, "timestamp": "01:40:16", "text": "因为我虽然很喜欢日语，但我……"}, {"type": "subtitle", "time": 6019.43, "timestamp": "01:40:19", "text": "食物。我是说，我喜欢切块咖喱。"}, {"type": "subtitle", "time": 6021.43, "timestamp": "01:40:21", "text": "以及其他所有东西。而你是"}, {"type": "subtitle", "time": 6023.669, "timestamp": "01:40:23", "text": "肯定会找到一些印度人。"}, {"type": "subtitle", "time": 6025.51, "timestamp": "01:40:25", "text": "那里有印度菜。它不像印度"}, {"type": "subtitle", "time": 6029.75, "timestamp": "01:40:29", "text": "食物无处不在。是的。但事情就是这样"}, {"type": "subtitle", "time": 6032.99, "timestamp": "01:40:32", "text": "你不喜欢的一点是……"}, {"type": "subtitle", "time": 6036.229, "timestamp": "01:40:36", "text": "事物。我不知道。我不知道，就像"}, {"type": "subtitle", "time": 6038.95, "timestamp": "01:40:38", "text": "如果你吃了……呃，它叫什么来着？牛肉或"}, {"type": "subtitle", "time": 6040.709, "timestamp": "01:40:40", "text": "不是。如果你吃东西，那就吃牛肉。是的。"}, {"type": "subtitle", "time": 6044.07, "timestamp": "01:40:44", "text": "是的，我有。好的。如果你吃牛肉的话"}, {"type": "subtitle", "time": 6046.31, "timestamp": "01:40:46", "text": "你应该对很多东西都没问题。"}, {"type": "subtitle", "time": 6048.39, "timestamp": "01:40:48", "text": "日本料理。"}, {"type": "subtitle", "time": 6049.99, "timestamp": "01:40:49", "text": "嗯。"}, {"type": "subtitle", "time": 6053.31, "timestamp": "01:40:53", "text": "因为我，我的意思是，你比我懂得多"}, {"type": "subtitle", "time": 6056.87, "timestamp": "01:40:56", "text": "但是，呃，有些日本汤……"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "可能不太符合我们的口味。"}]
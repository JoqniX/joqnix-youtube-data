[{"type": "subtitle", "time": 4743.189, "timestamp": "01:19:03", "text": "已连接。它们之间有联系。好的。"}, {"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "我得走了。"}, {"type": "subtitle", "time": 4748.11, "timestamp": "01:19:08", "text": "我半小时后回来。你好。你好。你好。"}, {"type": "subtitle", "time": 4751.59, "timestamp": "01:19:11", "text": "来。我可以尝尝腌青柠吗？"}, {"type": "subtitle", "time": 4753.31, "timestamp": "01:19:13", "text": "你？是的。"}, {"type": "subtitle", "time": 4755.83, "timestamp": "01:19:15", "text": "再见。我不知道你为什么想要……"}, {"type": "subtitle", "time": 4766.03, "timestamp": "01:19:26", "text": "某人"}, {"type": "subtitle", "time": 4769.27, "timestamp": "01:19:29", "text": "上去。"}, {"type": "subtitle", "time": 4771.07, "timestamp": "01:19:31", "text": "几乎"}, {"type": "subtitle", "time": 4788.07, "timestamp": "01:19:48", "text": "我没看见他。什么？重新装弹。等待，"}, {"type": "subtitle", "time": 4789.83, "timestamp": "01:19:49", "text": "为什么会这样？哦，是啊。是的。等等，我的"}, {"type": "subtitle", "time": 4792.31, "timestamp": "01:19:52", "text": "欢迎功能已开启。哦，是的。这"}, {"type": "subtitle", "time": 4797.83, "timestamp": "01:19:57", "text": "过来。过来。这就是你得到的原因"}]
[{"type": "subtitle", "time": 5881.99, "timestamp": "01:38:01", "text": "是的。即使我"}, {"type": "subtitle", "time": 5886.709, "timestamp": "01:38:06", "text": "人虽已不在，但我依然在那里。是的。是的。是的。"}, {"type": "subtitle", "time": 5888.709, "timestamp": "01:38:08", "text": "哦，你换了新头像。我从未见过"}, {"type": "subtitle", "time": 5892.229, "timestamp": "01:38:12", "text": "那。哦，是这个。它不在那里吗？"}, {"type": "subtitle", "time": 5895.03, "timestamp": "01:38:15", "text": "我们上次谈话是什么时候？"}, {"type": "subtitle", "time": 5898.709, "timestamp": "01:38:18", "text": "不，不。那是你画的吗？哦，这真是一次"}, {"type": "subtitle", "time": 5900.51, "timestamp": "01:38:20", "text": "送给我的礼物。"}, {"type": "subtitle", "time": 5905.189, "timestamp": "01:38:25", "text": "呃，我的艺术家朋友画了我的呃"}, {"type": "subtitle", "time": 5908.39, "timestamp": "01:38:28", "text": "画了同人图。她曾经画过一幅画"}, {"type": "subtitle", "time": 5910.95, "timestamp": "01:38:30", "text": "我和她一起执导了这部电影，当时她……"}, {"type": "subtitle", "time": 5913.109, "timestamp": "01:38:33", "text": "学习如何制作2D模型"}, {"type": "subtitle", "time": 5914.79, "timestamp": "01:38:34", "text": "东西。"}, {"type": "subtitle", "time": 5916.709, "timestamp": "01:38:36", "text": "哦，她真是太酷了。"}, {"type": "subtitle", "time": 5919.669, "timestamp": "01:38:39", "text": "请问这是2D还是3D的？我认为是"}, {"type": "subtitle", "time": 5924.31, "timestamp": "01:38:44", "text": "3D。它是二维的。 2D。我不 我不 我"}, {"type": "subtitle", "time": 5929.43, "timestamp": "01:38:49", "text": "我的下半身身材不好。"}, {"type": "subtitle", "time": 5931.109, "timestamp": "01:38:51", "text": "哦，你没有更低的价格。好的。好的。"}, {"type": "subtitle", "time": 5934.87, "timestamp": "01:38:54", "text": "我们不谈论这件事。"}, {"type": "subtitle", "time": 5937.03, "timestamp": "01:38:57", "text": "我的天啊。"}]
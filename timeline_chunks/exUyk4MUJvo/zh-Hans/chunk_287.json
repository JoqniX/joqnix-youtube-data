[{"type": "subtitle", "time": 17227.83, "timestamp": "04:47:07", "text": "记忆。基本上就是我认识的所有人。"}, {"type": "subtitle", "time": 17237.19, "timestamp": "04:47:17", "text": "今天。真的非常感谢。"}, {"type": "subtitle", "time": 17240.788, "timestamp": "04:47:20", "text": "嗯，就像拥有这种声音一样，我"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "不在乎为什么，但我很累，但我还是……"}, {"type": "subtitle", "time": 17246.91, "timestamp": "04:47:26", "text": "真的真的"}, {"type": "subtitle", "time": 17251.67, "timestamp": "04:47:31", "text": "真心感谢你们今天都来了"}, {"type": "subtitle", "time": 17257.628, "timestamp": "04:47:37", "text": "即使它很无聊，即使它是"}, {"type": "subtitle", "time": 17260.31, "timestamp": "04:47:40", "text": "让你开心，让你开怀大笑，你玩得很开心"}, {"type": "subtitle", "time": 17264.35, "timestamp": "04:47:44", "text": "他脸上带着笑容，他散开了笑容，呃，你散开了笑容"}, {"type": "subtitle", "time": 17272.35, "timestamp": "04:47:52", "text": "对我来说，不要忘记……"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "保持积极乐观，坚强起来，去做"}, {"type": "subtitle", "time": 17276.43, "timestamp": "04:47:56", "text": "最好的你"}, {"type": "subtitle", "time": 17279.59, "timestamp": "04:47:59", "text": "即使生活艰难，也要明白这一点。"}]
[{"type": "subtitle", "time": 6840.07, "timestamp": "01:54:00", "text": "我来自南印度。然后我有点"}, {"type": "chat", "time": 6842.666, "timestamp": "01:54:02", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 6845.51, "timestamp": "01:54:05", "text": "确实像嗯嗯流，呃，和"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "其他平台上的其他一些创作者"}, {"type": "subtitle", "time": 6850.95, "timestamp": "01:54:10", "text": "用我的母语来说就是"}, {"type": "subtitle", "time": 6854.149, "timestamp": "01:54:14", "text": "那是马拉雅拉姆语。所以我觉得如果你"}, {"type": "subtitle", "time": 6856.07, "timestamp": "01:54:16", "text": "搜索得足够深入，它已经存在了。"}, {"type": "subtitle", "time": 6859.189, "timestamp": "01:54:19", "text": "透露我来自那个地区"}, {"type": "subtitle", "time": 6862.229, "timestamp": "01:54:22", "text": "我猜你说的语言是……"}, {"type": "subtitle", "time": 6864.07, "timestamp": "01:54:24", "text": "立刻就得实话实说，但是"}, {"type": "subtitle", "time": 6866.629, "timestamp": "01:54:26", "text": "但马拉姆语是两者的共同语言。"}, {"type": "subtitle", "time": 6869.83, "timestamp": "01:54:29", "text": "这两个州太让人困惑了，但我可以"}, {"type": "subtitle", "time": 6872.75, "timestamp": "01:54:32", "text": "我大概能猜到你来自哪里。"}, {"type": "subtitle", "time": 6876.149, "timestamp": "01:54:36", "text": "是的。我不知道为什么我能做到"}, {"type": "subtitle", "time": 6879.27, "timestamp": "01:54:39", "text": "在我的直播里，这话很容易说出口，但是……"}, {"type": "subtitle", "time": 6882.35, "timestamp": "01:54:42", "text": "有时我会想，呃，这难道不是……"}, {"type": "subtitle", "time": 6887.589, "timestamp": "01:54:47", "text": "这也是禁忌吗？比如，克制一下。不，"}, {"type": "subtitle", "time": 6890.55, "timestamp": "01:54:50", "text": "说实话，就像我以前那样"}, {"type": "subtitle", "time": 6893.27, "timestamp": "01:54:53", "text": "也一样。但是不，我想我以前是"}, {"type": "subtitle", "time": 6896.43, "timestamp": "01:54:56", "text": "我也要那样做。但一旦你排序完毕"}]
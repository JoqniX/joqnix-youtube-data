[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "1953年。哦，现在是晚上7点。现在。哇。"}, {"type": "subtitle", "time": 12603.03, "timestamp": "03:30:03", "text": "但在日本，差不多要9个小时。"}, {"type": "subtitle", "time": 12607.67, "timestamp": "03:30:07", "text": "我前面有人。哦，现在是晚上7点。是的。"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "下午6点前在印度，那差不多是10:30。"}, {"type": "subtitle", "time": 12614.389, "timestamp": "03:30:14", "text": "下午有什么东西。是的。不，那是"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "嗯，时间到了。印度对阵日本"}, {"type": "subtitle", "time": 12620.389, "timestamp": "03:30:20", "text": "只需4个小时，对吧？如果我……的话，3个小时"}, {"type": "subtitle", "time": 12622.87, "timestamp": "03:30:22", "text": "正确的。 3小时30分钟。是的，就是这样。"}, {"type": "subtitle", "time": 12624.95, "timestamp": "03:30:24", "text": "还不错。还不错。什么"}, {"type": "subtitle", "time": 12628.95, "timestamp": "03:30:28", "text": "关于伦敦？那多少钱？所以是5:30"}, {"type": "subtitle", "time": 12633.19, "timestamp": "03:30:33", "text": "加 5:30。哦，那是5点5分30秒。"}, {"type": "subtitle", "time": 12636.309, "timestamp": "03:30:36", "text": "几分钟后。哇。"}, {"type": "subtitle", "time": 12638.55, "timestamp": "03:30:38", "text": "情况还不算太糟。加拿大的情况更糟。"}, {"type": "subtitle", "time": 12640.83, "timestamp": "03:30:40", "text": "大约2小时。"}, {"type": "subtitle", "time": 12643.59, "timestamp": "03:30:43", "text": "是的。昨天我遇到了一位来自"}, {"type": "subtitle", "time": 12647.59, "timestamp": "03:30:47", "text": "加拿大，然后我就睡着了。他们是"}, {"type": "subtitle", "time": 12650.389, "timestamp": "03:30:50", "text": "他们有点迟到了，因为他们得走了。"}, {"type": "subtitle", "time": 12652.71, "timestamp": "03:30:52", "text": "在外面的某个地方。呃，我确实提过。"}, {"type": "subtitle", "time": 12655.67, "timestamp": "03:30:55", "text": "让他们提前30分钟私信我，或者"}, {"type": "subtitle", "time": 12658.71, "timestamp": "03:30:58", "text": "一小时前我会小睡一会儿。"}]
[{"type": "subtitle", "time": 10981.429, "timestamp": "03:03:01", "text": "因为那件事，嗯，我的意思是，我的意思是，我"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "意思是说，这是你的首要任务吗？"}, {"type": "subtitle", "time": 10989.19, "timestamp": "03:03:09", "text": "非优先事项。我不知道。你知道"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "你总能做那条腿。"}, {"type": "subtitle", "time": 10995.19, "timestamp": "03:03:15", "text": "属于。所以资金来源是这样的"}, {"type": "subtitle", "time": 10996.79, "timestamp": "03:03:16", "text": "比如，你必须理解你的"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "你的优先事项体现在食物和租房上。"}, {"type": "subtitle", "time": 11002.469, "timestamp": "03:03:22", "text": "这是您的资金池之一。这"}, {"type": "subtitle", "time": 11006.79, "timestamp": "03:03:26", "text": "第二个食物池就是呃……"}, {"type": "subtitle", "time": 11009.429, "timestamp": "03:03:29", "text": "学术费用和学费"}, {"type": "subtitle", "time": 11012.15, "timestamp": "03:03:32", "text": "以及我所假设的一切，嗯"}, {"type": "subtitle", "time": 11013.51, "timestamp": "03:03:33", "text": "即使你的父母在支付费用"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "如果你必须贷款的话？"}, {"type": "subtitle", "time": 11018.15, "timestamp": "03:03:38", "text": "我不知道你所谓的“趣味融资”是怎么回事。"}, {"type": "subtitle", "time": 11020.23, "timestamp": "03:03:40", "text": "情况是这样的，但如果你要贷款的话"}, {"type": "subtitle", "time": 11023.269, "timestamp": "03:03:43", "text": "是的，贷款。是的。所以我不得不"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "得为此出门一会儿。第二"}, {"type": "subtitle", "time": 11030.15, "timestamp": "03:03:50", "text": "然后你要做的就是把你的……嗯……摆出来。"}, {"type": "subtitle", "time": 11031.83, "timestamp": "03:03:51", "text": "这是你提出的另一件事。"}, {"type": "subtitle", "time": 11034.95, "timestamp": "03:03:54", "text": "为了你的学业。然后所有的一切"}, {"type": "subtitle", "time": 11037.11, "timestamp": "03:03:57", "text": "剩下的部分你可能需要分成几份。"}, {"type": "subtitle", "time": 11039.429, "timestamp": "03:03:59", "text": "把它分成两部分。一个适合你投资的"}]
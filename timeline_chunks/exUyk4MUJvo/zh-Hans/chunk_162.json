[{"type": "subtitle", "time": 9720.95, "timestamp": "02:42:00", "text": "虚弱的？如果你对“弱”的定义是"}, {"type": "subtitle", "time": 9723.349, "timestamp": "02:42:03", "text": "那么，我究竟是什么？就像我，我就是我"}, {"type": "subtitle", "time": 9726.309, "timestamp": "02:42:06", "text": "感觉就像我站在你面前是个处男处女。"}, {"type": "subtitle", "time": 9729.32, "timestamp": "02:42:09", "text": "你说的“弱”是什么意思？"}, {"type": "subtitle", "time": 9731.03, "timestamp": "02:42:11", "text": "[音乐]"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "我不知道。并不弱。没有"}, {"type": "subtitle", "time": 9749.67, "timestamp": "02:42:29", "text": "但是，通过这件最好的事情，你可以……"}, {"type": "subtitle", "time": 9751.59, "timestamp": "02:42:31", "text": "在日本你能做的最好的事情就是"}, {"type": "subtitle", "time": 9753.95, "timestamp": "02:42:33", "text": "我在这里看到人们所做的事。去"}, {"type": "subtitle", "time": 9758.07, "timestamp": "02:42:38", "text": "呃，找个日本女朋友"}, {"type": "subtitle", "time": 9761.27, "timestamp": "02:42:41", "text": "谁会……谁会做……谁……你可以……"}, {"type": "subtitle", "time": 9765.429, "timestamp": "02:42:45", "text": "她会在晚些时候搬来和她一起住。"}, {"type": "subtitle", "time": 9767.429, "timestamp": "02:42:47", "text": "为你做所有家务，你"}, {"type": "subtitle", "time": 9770.71, "timestamp": "02:42:50", "text": "就做直播相关的工作就行了。"}, {"type": "subtitle", "time": 9772.55, "timestamp": "02:42:52", "text": "那将是最大的梦想"}, {"type": "subtitle", "time": 9775.91, "timestamp": "02:42:55", "text": "目前对您来说。是的。"}, {"type": "subtitle", "time": 9779.27, "timestamp": "02:42:59", "text": "那会很有趣。"}]
[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "所以我听说其他一些学校也这样"}, {"type": "subtitle", "time": 8884.469, "timestamp": "02:28:04", "text": "北海道和其他一些地方允许这样做。"}, {"type": "subtitle", "time": 8886.389, "timestamp": "02:28:06", "text": "但是这所GMA学校真是太棒了"}, {"type": "subtitle", "time": 8887.99, "timestamp": "02:28:07", "text": "在这方面非常严格。是的。你必须"}, {"type": "subtitle", "time": 8890.03, "timestamp": "02:28:10", "text": "遵守校规"}, {"type": "subtitle", "time": 8894.15, "timestamp": "02:28:14", "text": "一切都像你。是的。我当时就想，"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "该死。"}, {"type": "subtitle", "time": 8897.429, "timestamp": "02:28:17", "text": "你打算待多少年？"}, {"type": "subtitle", "time": 8901.67, "timestamp": "02:28:21", "text": "那里？嗯，是的，1年9个月"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "我会在那里。然后我必须想办法"}, {"type": "subtitle", "time": 8906.55, "timestamp": "02:28:26", "text": "将签证再次转换为学生签证"}, {"type": "subtitle", "time": 8909.19, "timestamp": "02:28:29", "text": "或者像工作签证那样，对吧？能够"}, {"type": "subtitle", "time": 8912.23, "timestamp": "02:28:32", "text": "在那里待一段时间。"}, {"type": "subtitle", "time": 8915.55, "timestamp": "02:28:35", "text": "我的目标是成为像"}, {"type": "subtitle", "time": 8920.389, "timestamp": "02:28:40", "text": "嗯，我住在那里，那是公关部门。"}, {"type": "subtitle", "time": 8923.67, "timestamp": "02:28:43", "text": "是的。是啊，那肯定很有趣。那"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "那很好。是的，那将会非常"}, {"type": "subtitle", "time": 8928.389, "timestamp": "02:28:48", "text": "乐趣。但如果你考虑安定下来"}, {"type": "subtitle", "time": 8931.03, "timestamp": "02:28:51", "text": "那边的情况就截然不同了。"}, {"type": "subtitle", "time": 8932.15, "timestamp": "02:28:52", "text": "呃，它叫什么来着？不同的"}, {"type": "subtitle", "time": 8936.79, "timestamp": "02:28:56", "text": "问这个问题是因为，呃，那样你就不需要了"}]
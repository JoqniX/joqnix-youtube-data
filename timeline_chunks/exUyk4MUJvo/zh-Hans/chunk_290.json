[{"type": "subtitle", "time": 17400.628, "timestamp": "04:50:00", "text": "呃，你们能听清楚我说话吗？呃，"}, {"type": "subtitle", "time": 17403.51, "timestamp": "04:50:03", "text": "我就坐在地板上，手里拿着麦克风。"}, {"type": "subtitle", "time": 17405.31, "timestamp": "04:50:05", "text": "朝向我的嘴"}, {"type": "subtitle", "time": 17408.628, "timestamp": "04:50:08", "text": "再次。可能会把麦克风弄坏"}, {"type": "subtitle", "time": 17411.788, "timestamp": "04:50:11", "text": "今天就站在这里。我的天啊，"}, {"type": "subtitle", "time": 17415.15, "timestamp": "04:50:15", "text": "它不喜欢这样。哦"}, {"type": "subtitle", "time": 17419.07, "timestamp": "04:50:19", "text": "上帝。好了，站起来"}, {"type": "subtitle", "time": 17421.67, "timestamp": "04:50:21", "text": "向上。好了，我回来了。我回来了。我走了"}, {"type": "subtitle", "time": 17427.39, "timestamp": "04:50:27", "text": "是的，"}, {"type": "subtitle", "time": 17432.35, "timestamp": "04:50:32", "text": "20日，Twitch上见！"}, {"type": "subtitle", "time": 17435.708, "timestamp": "04:50:35", "text": "天。嗯，我会尽力的，你"}, {"type": "subtitle", "time": 17440.948, "timestamp": "04:50:40", "text": "要知道，要更加努力、更加努力、更加努力。"}, {"type": "subtitle", "time": 17443.628, "timestamp": "04:50:43", "text": "我不是，我尽量不去想。"}, {"type": "subtitle", "time": 17447.75, "timestamp": "04:50:47", "text": "死。是的，我也会尽我所能。还，"}, {"type": "subtitle", "time": 17448.59, "timestamp": "04:50:48", "text": "你"}, {"type": "subtitle", "time": 17452.628, "timestamp": "04:50:52", "text": "有些人确实想让我难堪，你就待在那儿吧。"}, {"type": "subtitle", "time": 17455.39, "timestamp": "04:50:55", "text": "你知道，这样我就不会给了"}, {"type": "subtitle", "time": 17459.55, "timestamp": "04:50:59", "text": "向上，你知道的。所以"}]
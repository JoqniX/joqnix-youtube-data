[{"type": "subtitle", "time": 1082.789, "timestamp": "00:18:02", "text": "已种下穗。让我来做这件事。"}, {"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "尴尬。我的最终准备"}, {"type": "subtitle", "time": 1095.15, "timestamp": "00:18:15", "text": "他们是如此"}, {"type": "subtitle", "time": 1097.75, "timestamp": "00:18:17", "text": "他妈的。是的，它有效。现在我明白了"}, {"type": "subtitle", "time": 1099.75, "timestamp": "00:18:19", "text": "流媒体URL。所以，这将引导我到"}, {"type": "subtitle", "time": 1101.909, "timestamp": "00:18:21", "text": "当前流。这样我就可以"}, {"type": "subtitle", "time": 1104.71, "timestamp": "00:18:24", "text": "知道这条消息来自哪个信息流。"}, {"type": "subtitle", "time": 1106.95, "timestamp": "00:18:26", "text": "我们走吧。"}, {"type": "subtitle", "time": 1109.669, "timestamp": "00:18:29", "text": "他们最终解决了这个问题。一个敌人"}, {"type": "subtitle", "time": 1112.549, "timestamp": "00:18:32", "text": "其余的。圣。"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "把他们打下来。"}, {"type": "subtitle", "time": 1116.95, "timestamp": "00:18:36", "text": "我的准备好了。"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "恶梦。"}, {"type": "subtitle", "time": 1121.43, "timestamp": "00:18:41", "text": "注意保护眼睛。"}, {"type": "subtitle", "time": 1124.95, "timestamp": "00:18:44", "text": "我觉得他过不了关。"}, {"type": "subtitle", "time": 1129.51, "timestamp": "00:18:49", "text": "最后一名幸存者。该死。离合器。"}, {"type": "subtitle", "time": 1132.549, "timestamp": "00:18:52", "text": "好的。好的。"}, {"type": "subtitle", "time": 1135.909, "timestamp": "00:18:55", "text": "换边站。"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "你还在使用 YouTube API。"}, {"type": "subtitle", "time": 1139.549, "timestamp": "00:18:59", "text": "好的"}]
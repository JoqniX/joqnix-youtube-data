[{"type": "subtitle", "time": 9066.63, "timestamp": "02:31:06", "text": "但我不会，我不会说那就是……"}, {"type": "subtitle", "time": 9074.99, "timestamp": "02:31:14", "text": "[音乐]"}, {"type": "subtitle", "time": 9082.309, "timestamp": "02:31:22", "text": "是的，你需要收拾行李。"}, {"type": "subtitle", "time": 9084.87, "timestamp": "02:31:24", "text": "需要打包哦，还有玛吉魔法"}, {"type": "subtitle", "time": 9087.03, "timestamp": "02:31:27", "text": "玛萨拉。这就是游戏。"}, {"type": "subtitle", "time": 9089.469, "timestamp": "02:31:29", "text": "换位器。喜欢"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "五个或者我没有，我记得我的"}, {"type": "subtitle", "time": 9097.83, "timestamp": "02:31:37", "text": "呃，日本老师说得好像我不能"}, {"type": "subtitle", "time": 9100.71, "timestamp": "02:31:40", "text": "食用生食和加工食品或"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "某物。我不确定我是否可以参加"}, {"type": "subtitle", "time": 9104.07, "timestamp": "02:31:44", "text": "玛萨拉。"}, {"type": "subtitle", "time": 9106.469, "timestamp": "02:31:46", "text": "我确实想参加"}, {"type": "subtitle", "time": 9109.83, "timestamp": "02:31:49", "text": "不，你可以点赞，为什么不呢？哦，等等"}, {"type": "subtitle", "time": 9111.99, "timestamp": "02:31:51", "text": "那里。难道没有办法发送吗？"}, {"type": "subtitle", "time": 9115.429, "timestamp": "02:31:55", "text": "去日本之前要带的东西"}, {"type": "subtitle", "time": 9117.03, "timestamp": "02:31:57", "text": "某物？"}, {"type": "subtitle", "time": 9119.27, "timestamp": "02:31:59", "text": "是的，可以。有一种东西叫做"}]
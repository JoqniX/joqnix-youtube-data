[{"type": "subtitle", "time": 2584.87, "timestamp": "00:43:04", "text": "嗯，是的，比如说有人……"}, {"type": "subtitle", "time": 2587.23, "timestamp": "00:43:07", "text": "用户名是两个"}, {"type": "subtitle", "time": 2590.95, "timestamp": "00:43:10", "text": "用户喜欢 Shambbo Bob 之类的。"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "这是两个人共同拥有的名字。"}, {"type": "subtitle", "time": 2596.23, "timestamp": "00:43:16", "text": "YouTube 显示名称。"}, {"type": "subtitle", "time": 2599.349, "timestamp": "00:43:19", "text": "所以我能做的就是制作其中一个。"}, {"type": "subtitle", "time": 2603.95, "timestamp": "00:43:23", "text": "把这套东西，呃，就像一套昵称一样"}, {"type": "subtitle", "time": 2608.63, "timestamp": "00:43:28", "text": "那就像一号灌木炸弹一样放置"}, {"type": "subtitle", "time": 2610.63, "timestamp": "00:43:30", "text": "把"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "不。是的。二号炸弹就够了"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "另一个昵称。好的。当然。自那以后"}, {"type": "subtitle", "time": 2626.109, "timestamp": "00:43:46", "text": "是"}, {"type": "subtitle", "time": 2630.15, "timestamp": "00:43:50", "text": "设置该日志记录到文件中，它将"}, {"type": "subtitle", "time": 2634.47, "timestamp": "00:43:54", "text": "保存保存，每当聊天呃或"}, {"type": "subtitle", "time": 2636.87, "timestamp": "00:43:56", "text": "就像第一次他们会那样。"}, {"type": "subtitle", "time": 2639.99, "timestamp": "00:43:59", "text": "通常会受到这样的欢迎，但是……"}]
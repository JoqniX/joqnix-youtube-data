[{"type": "subtitle", "time": 9600.07, "timestamp": "02:40:00", "text": "凭借这种毅力，总能找到出路。"}, {"type": "subtitle", "time": 9601.51, "timestamp": "02:40:01", "text": "就像你肯定会得到"}, {"type": "subtitle", "time": 9605.51, "timestamp": "02:40:05", "text": "一些。是的。我不是那个意思。"}, {"type": "subtitle", "time": 9608.309, "timestamp": "02:40:08", "text": "是错的还是对的。就是……呃……什么？"}, {"type": "subtitle", "time": 9610.309, "timestamp": "02:40:10", "text": "我该怎么做？我该怎么说？"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "这只是，呃，如果定向努力"}, {"type": "subtitle", "time": 9615.91, "timestamp": "02:40:15", "text": "如果你想朝着某个方向努力，那就去做吧"}, {"type": "subtitle", "time": 9619.15, "timestamp": "02:40:19", "text": "你一定能做到。"}, {"type": "subtitle", "time": 9624.71, "timestamp": "02:40:24", "text": "是的。我唯一后悔的事是"}, {"type": "subtitle", "time": 9627.349, "timestamp": "02:40:27", "text": "呃，我感觉很内疚，因为我把这些写出来了。"}, {"type": "subtitle", "time": 9629.83, "timestamp": "02:40:29", "text": "V形的东西。所以我当时就做了类似的事情"}, {"type": "subtitle", "time": 9633.27, "timestamp": "02:40:33", "text": "那天，呃，就像我想我得到了"}, {"type": "subtitle", "time": 9635.91, "timestamp": "02:40:35", "text": "灵感来自一位使用过的主播"}, {"type": "subtitle", "time": 9638.79, "timestamp": "02:40:38", "text": "在他们离开期间播放片段"}, {"type": "subtitle", "time": 9641.19, "timestamp": "02:40:41", "text": "直播间或者其他什么地方挂机。所以，我"}, {"type": "subtitle", "time": 9643.75, "timestamp": "02:40:43", "text": "想到一个主意。哦，我没有夹子。所以"}, {"type": "subtitle", "time": 9647.27, "timestamp": "02:40:47", "text": "为什么不把我的直播放到 YouTube 上呢？"}, {"type": "subtitle", "time": 9650.07, "timestamp": "02:40:50", "text": "YouTube上的东西？嗯，是的。所以我照做了。"}, {"type": "subtitle", "time": 9652.79, "timestamp": "02:40:52", "text": "然后我让它变得更好了。"}, {"type": "subtitle", "time": 9657.75, "timestamp": "02:40:57", "text": "就像扭蛋系统一样。所以就像一个随机的V"}]
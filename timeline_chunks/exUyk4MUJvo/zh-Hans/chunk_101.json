[{"type": "subtitle", "time": 6061.109, "timestamp": "01:41:01", "text": "他们可能会说它很辣，但相信我"}, {"type": "subtitle", "time": 6062.87, "timestamp": "01:41:02", "text": "它不是。"}, {"type": "subtitle", "time": 6064.87, "timestamp": "01:41:04", "text": "啊"}, {"type": "subtitle", "time": 6068.39, "timestamp": "01:41:08", "text": "我觉得我们得找个能吃辣的人。是的，我"}, {"type": "subtitle", "time": 6070.79, "timestamp": "01:41:10", "text": "可能需要要求加倍辣或"}, {"type": "subtitle", "time": 6073.109, "timestamp": "01:41:13", "text": "一些适合印度风味的东西。你"}, {"type": "subtitle", "time": 6075.669, "timestamp": "01:41:15", "text": "得说，看看我，看看我"}, {"type": "subtitle", "time": 6083.35, "timestamp": "01:41:23", "text": "这就是我无论去哪里都会做的事情。"}, {"type": "subtitle", "time": 6085.91, "timestamp": "01:41:25", "text": "英国。看看我。我是印度人"}, {"type": "subtitle", "time": 6088.07, "timestamp": "01:41:28", "text": "相信我，给我来点印度辣的。我"}, {"type": "subtitle", "time": 6092.07, "timestamp": "01:41:32", "text": "不想吃辛辣的英国菜。"}, {"type": "subtitle", "time": 6094.709, "timestamp": "01:41:34", "text": "我的天啊。就像那个东西"}, {"type": "subtitle", "time": 6101.83, "timestamp": "01:41:41", "text": "该死。"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "另外，呃，搬到一个你可能……的国家"}, {"type": "subtitle", "time": 6108.07, "timestamp": "01:41:48", "text": "获得很多挑战性的东西"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "诸如此类的东西"}, {"type": "subtitle", "time": 6113.27, "timestamp": "01:41:53", "text": "有些事情如果最终发生，那也是好事。"}, {"type": "subtitle", "time": 6115.83, "timestamp": "01:41:55", "text": "变得更善于社交，我不知道。"}]
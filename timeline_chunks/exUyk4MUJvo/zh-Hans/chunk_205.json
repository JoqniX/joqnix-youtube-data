[{"type": "subtitle", "time": 12301.99, "timestamp": "03:25:01", "text": "准备就绪，状态良好，然后开始直播"}, {"type": "subtitle", "time": 12304.389, "timestamp": "03:25:04", "text": "比如每周至少花1个小时，或者一次"}, {"type": "subtitle", "time": 12306.19, "timestamp": "03:25:06", "text": "一周两次。那是我最初的"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "事物。然后就发生了那些事。"}, {"type": "subtitle", "time": 12312.15, "timestamp": "03:25:12", "text": "然后我就想，"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "“我的天哪，这么多钱。” H 做什么"}, {"type": "subtitle", "time": 12318.07, "timestamp": "03:25:18", "text": "我愿意？我当时就想，“好吧，行。我……”"}, {"type": "subtitle", "time": 12321.269, "timestamp": "03:25:21", "text": "甚至，嗯，我感到内疚，因为，嗯，因为"}, {"type": "subtitle", "time": 12323.83, "timestamp": "03:25:23", "text": "包括所有的一切，对吧？”因为"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "我当时正专注于那个东西，"}, {"type": "subtitle", "time": 12328.309, "timestamp": "03:25:28", "text": "社区层面，适度，所有这些"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "东西。我当时好像没怎么集中注意力。"}, {"type": "subtitle", "time": 12332.309, "timestamp": "03:25:32", "text": "频道等等。我当时就想，"}, {"type": "subtitle", "time": 12335.91, "timestamp": "03:25:35", "text": "“是啊，也许我会把它当作一种挑战。”"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "有机会，你知道，就像……"}, {"type": "subtitle", "time": 12340.79, "timestamp": "03:25:40", "text": "马拉松或者类似短程马拉松之类​​的比赛。"}, {"type": "subtitle", "time": 12344.15, "timestamp": "03:25:44", "text": "尽管我是一个从未这样做过的人"}, {"type": "subtitle", "time": 12346.63, "timestamp": "03:25:46", "text": "之前是因为我当时想，除非……"}, {"type": "subtitle", "time": 12349.269, "timestamp": "03:25:49", "text": "直到我举办慈善活动并为此而做"}, {"type": "subtitle", "time": 12351.429, "timestamp": "03:25:51", "text": "慈善，我永远不会参加萨巴顿乐队的演出。"}, {"type": "subtitle", "time": 12354.55, "timestamp": "03:25:54", "text": "或者诸如此类的事情，因为即便如此，也无所谓。"}, {"type": "subtitle", "time": 12357.03, "timestamp": "03:25:57", "text": "我最终总是会这样做。"}]
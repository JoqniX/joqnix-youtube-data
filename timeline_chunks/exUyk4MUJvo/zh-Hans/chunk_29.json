[{"type": "subtitle", "time": 1745.95, "timestamp": "00:29:05", "text": "我不喜欢这样。我不喜欢"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "这个冷冻装置。我真的不是"}, {"type": "subtitle", "time": 1752.95, "timestamp": "00:29:12", "text": "喜欢这个。我的天哪。我好害怕。"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "我只是不想让它关停。"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "我应该关闭这些后台程序吗？我"}, {"type": "subtitle", "time": 1759.99, "timestamp": "00:29:19", "text": "应该关闭此问题。我不该冒这个险。"}, {"type": "subtitle", "time": 1766.07, "timestamp": "00:29:26", "text": "我需要重新渲染。迪奥，我不"}, {"type": "subtitle", "time": 1787.909, "timestamp": "00:29:47", "text": "已种下穗。最后一名幸存者。"}, {"type": "subtitle", "time": 1797.99, "timestamp": "00:29:57", "text": "玩笑结束了。你死定了。"}]
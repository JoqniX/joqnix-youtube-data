[{"type": "subtitle", "time": 15962.389, "timestamp": "04:26:02", "text": "这里。按下 medi 键。按下按钮"}, {"type": "subtitle", "time": 15965.149, "timestamp": "04:26:05", "text": "这把钥匙。 MIDI"}, {"type": "subtitle", "time": 15969.349, "timestamp": "04:26:09", "text": "出口。我的意思是，如果我想的话，我的意思是，如果我"}, {"type": "subtitle", "time": 15972.11, "timestamp": "04:26:12", "text": "意思是说，如果我想的话，我并不是说我想要。我的意思是，我想要"}, {"type": "subtitle", "time": 15974.03, "timestamp": "04:26:14", "text": "要做"}, {"type": "subtitle", "time": 15976.63, "timestamp": "04:26:16", "text": "这。想继续弹这台键盘。"}, {"type": "subtitle", "time": 15981.309, "timestamp": "04:26:21", "text": "老兄，拜托。已经，已经太久了"}, {"type": "subtitle", "time": 15984.99, "timestamp": "04:26:24", "text": "长的。我把笔记全忘了。忘了"}, {"type": "subtitle", "time": 15989.51, "timestamp": "04:26:29", "text": "一切。我只知道这些，就像看到它们一样。"}, {"type": "subtitle", "time": 15993.87, "timestamp": "04:26:33", "text": "等等，我是不是断线了？我是否"}, {"type": "subtitle", "time": 15999.87, "timestamp": "04:26:39", "text": "断开？我的天啊，这个USB……呃，USB。哦"}, {"type": "subtitle", "time": 16007.95, "timestamp": "04:26:47", "text": "开始。等等，我只知道一、二，"}, {"type": "subtitle", "time": 16012.189, "timestamp": "04:26:52", "text": "三，所有基本的东西。"}, {"type": "subtitle", "time": 16017.63, "timestamp": "04:26:57", "text": "我忘了怎么弹小调音阶了。"}]
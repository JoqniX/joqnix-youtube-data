[{"type": "subtitle", "time": 7801.47, "timestamp": "02:10:01", "text": "5万美元？哦，你是从哪里弄到的？"}, {"type": "subtitle", "time": 7803.589, "timestamp": "02:10:03", "text": "5万美元？我的意思是，你为什么要给它"}, {"type": "subtitle", "time": 7805.35, "timestamp": "02:10:05", "text": "出去？因为他要拿到1000万美元"}, {"type": "subtitle", "time": 7813.189, "timestamp": "02:10:13", "text": "是的，英国方面。我一直在尝试"}, {"type": "subtitle", "time": 7816.39, "timestamp": "02:10:16", "text": "看看英国这边，英国这边就只是"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "我想也没那么有趣吧。英国"}, {"type": "subtitle", "time": 7821.75, "timestamp": "02:10:21", "text": "另一方面，日式风格正在蓬勃发展。我"}, {"type": "subtitle", "time": 7823.35, "timestamp": "02:10:23", "text": "我觉得日方基本上就是这样。"}, {"type": "subtitle", "time": 7827.109, "timestamp": "02:10:27", "text": "蓬勃发展。哦，确实如此。"}, {"type": "subtitle", "time": 7829.589, "timestamp": "02:10:29", "text": "是的。我的意思是，他们做得更多。"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "那里有股稀稀拉拉的东西，美国人"}, {"type": "subtitle", "time": 7834.55, "timestamp": "02:10:34", "text": "以前有人喜欢恶作剧，比如你。"}, {"type": "subtitle", "time": 7837.87, "timestamp": "02:10:37", "text": "认识那些呃"}, {"type": "subtitle", "time": 7842.229, "timestamp": "02:10:42", "text": "一些游走在恶作剧边缘的事情。 M"}, {"type": "subtitle", "time": 7844.87, "timestamp": "02:10:44", "text": "我认为美国当时站在了那个舞台上。"}, {"type": "subtitle", "time": 7846.79, "timestamp": "02:10:46", "text": "当然是因为人们的缘故，他们有点……"}, {"type": "subtitle", "time": 7849.03, "timestamp": "02:10:49", "text": "只是因为那样就停止了。"}, {"type": "subtitle", "time": 7852.79, "timestamp": "02:10:52", "text": "接近蠕虫行为的临界水平。是的。我"}, {"type": "subtitle", "time": 7854.31, "timestamp": "02:10:54", "text": "不能说是临界值。真令人毛骨悚然"}, {"type": "subtitle", "time": 7857.83, "timestamp": "02:10:57", "text": "行为水平。嗯。"}, {"type": "subtitle", "time": 7859.75, "timestamp": "02:10:59", "text": "所以他们正在这样做。他们正处于那个阶段"}]
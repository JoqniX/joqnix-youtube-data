[{"type": "subtitle", "time": 9301.67, "timestamp": "02:35:01", "text": "照顾好他们，喜欢他们"}, {"type": "subtitle", "time": 9304.63, "timestamp": "02:35:04", "text": "像早上那样保持它"}, {"type": "subtitle", "time": 9307.349, "timestamp": "02:35:07", "text": "比如说，我在 YouTube 那边有"}, {"type": "subtitle", "time": 9310.23, "timestamp": "02:35:10", "text": "V 的限制是 12 小时，对吧？"}, {"type": "subtitle", "time": 9312.23, "timestamp": "02:35:12", "text": "一切。所以我不得不结束直播了。"}, {"type": "subtitle", "time": 9314.79, "timestamp": "02:35:14", "text": "然后重新启动直播。所以，我"}, {"type": "subtitle", "time": 9318.55, "timestamp": "02:35:18", "text": "做就像说，呃，最初的事情是"}, {"type": "subtitle", "time": 9321.51, "timestamp": "02:35:21", "text": "我从早上9点开始直播。"}, {"type": "subtitle", "time": 9325.83, "timestamp": "02:35:25", "text": "第一部分直播，然后嗯，是的，9:00"}, {"type": "subtitle", "time": 9329.429, "timestamp": "02:35:29", "text": "上午。然后我嗯，要么在上午9点之前。"}, {"type": "subtitle", "time": 9331.429, "timestamp": "02:35:31", "text": "直播开始后，我会开始讲话。"}, {"type": "subtitle", "time": 9334.389, "timestamp": "02:35:34", "text": "一会儿，大概一个小时，然后休息一下"}, {"type": "subtitle", "time": 9337.27, "timestamp": "02:35:37", "text": "早餐休息一下，然后回来继续"}, {"type": "subtitle", "time": 9341.349, "timestamp": "02:35:41", "text": "东西，然后过一会儿就变成1或2了，然后你"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "午休一下，回来继续做这件事。"}, {"type": "subtitle", "time": 9347.75, "timestamp": "02:35:47", "text": "就像那样，那也算是一种结果，但是"}, {"type": "subtitle", "time": 9351.19, "timestamp": "02:35:51", "text": "现在我知道你要走了"}, {"type": "subtitle", "time": 9353.03, "timestamp": "02:35:53", "text": "去日本旅行时，你可能需要带上"}, {"type": "subtitle", "time": 9355.83, "timestamp": "02:35:55", "text": "把你的空闲时间都用来陪伴家人。"}, {"type": "subtitle", "time": 9358.389, "timestamp": "02:35:58", "text": "是的，没错。是的，我必须这么做。"}]
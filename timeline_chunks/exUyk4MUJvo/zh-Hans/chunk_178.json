[{"type": "subtitle", "time": 10684.55, "timestamp": "02:58:04", "text": "所以他说他是，呃，他的室友是"}, {"type": "subtitle", "time": 10685.79, "timestamp": "02:58:05", "text": "相同"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "来自印度的同学。所以我就想，但他"}, {"type": "subtitle", "time": 10693.349, "timestamp": "02:58:13", "text": "还提到这似乎是随机的。所以，"}, {"type": "subtitle", "time": 10696.71, "timestamp": "02:58:16", "text": "如果你运气好，就会和……配对。"}, {"type": "subtitle", "time": 10700.55, "timestamp": "02:58:20", "text": "呃，来自同一国家的人，或者如果"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "你运气不好，呃，你会被安排配对。"}, {"type": "subtitle", "time": 10705.19, "timestamp": "02:58:25", "text": "和外国人在一起之类的。我不知道"}, {"type": "subtitle", "time": 10707.51, "timestamp": "02:58:27", "text": "关于性别问题。会是女孩吗？"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "女孩还是男孩？男孩还是男孩？女孩？混合的？我"}, {"type": "subtitle", "time": 10712.95, "timestamp": "02:58:32", "text": "不知道。"}, {"type": "subtitle", "time": 10717.349, "timestamp": "02:58:37", "text": "如果是混合口味的，那你就有福了。"}, {"type": "subtitle", "time": 10720.309, "timestamp": "02:58:40", "text": "但作为外出的常规做法，我"}, {"type": "subtitle", "time": 10722.87, "timestamp": "02:58:42", "text": "常说永远不要在你住的地方睡觉"}, {"type": "subtitle", "time": 10726.15, "timestamp": "02:58:46", "text": "工作或生活。"}, {"type": "subtitle", "time": 10728.469, "timestamp": "02:58:48", "text": "所以永远不要建立那样的关系"}, {"type": "subtitle", "time": 10731.51, "timestamp": "02:58:51", "text": "你工作的地方或居住的地方。"}, {"type": "subtitle", "time": 10734.389, "timestamp": "02:58:54", "text": "气氛变得非常尴尬。"}, {"type": "subtitle", "time": 10738.19, "timestamp": "02:58:58", "text": "如果你决定离开的话。"}]
[{"type": "subtitle", "time": 10747.03, "timestamp": "02:59:07", "text": "你将面临很多糟糕的事情"}, {"type": "subtitle", "time": 10748.59, "timestamp": "02:59:08", "text": "事物。"}, {"type": "subtitle", "time": 10754.71, "timestamp": "02:59:14", "text": "我的天啊。我希望能住单人间。"}, {"type": "subtitle", "time": 10756.71, "timestamp": "02:59:16", "text": "我已经跟他们说过很多次了。"}, {"type": "subtitle", "time": 10760.23, "timestamp": "02:59:20", "text": "次数。所以，我希望他们能优先考虑我。"}, {"type": "subtitle", "time": 10762.389, "timestamp": "02:59:22", "text": "找个单人间。别，别弄到"}, {"type": "subtitle", "time": 10765.19, "timestamp": "02:59:25", "text": "双人间。我的意思是，多少钱"}, {"type": "subtitle", "time": 10767.51, "timestamp": "02:59:27", "text": "贵，就像……不贵"}, {"type": "subtitle", "time": 10770.11, "timestamp": "02:59:30", "text": "那很贵，而且你"}, {"type": "subtitle", "time": 10772.389, "timestamp": "02:59:32", "text": "别管成本了。忘了说吧"}, {"type": "subtitle", "time": 10774.469, "timestamp": "02:59:34", "text": "成本。你从中获得的精神满足感"}, {"type": "subtitle", "time": 10778.87, "timestamp": "02:59:38", "text": "那不一样。嗯。"}, {"type": "subtitle", "time": 10781.75, "timestamp": "02:59:41", "text": "就像你必须优先考虑的事情一样"}, {"type": "subtitle", "time": 10784.429, "timestamp": "02:59:44", "text": "保持内心的平静比什么都重要。"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "就像我知道我知道就像和……一起生活一样"}, {"type": "subtitle", "time": 10788.79, "timestamp": "02:59:48", "text": "你父母可能会是的，哦，你"}, {"type": "subtitle", "time": 10790.75, "timestamp": "02:59:50", "text": "应该和别人一起生活，因为"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "呃，你知道那是因为你要去"}, {"type": "subtitle", "time": 10795.349, "timestamp": "02:59:55", "text": "第一次到户外之类的"}, {"type": "subtitle", "time": 10797.51, "timestamp": "02:59:57", "text": "如果你有这样的需求，你需要一些帮助。"}]
[{"type": "subtitle", "time": 12121.75, "timestamp": "03:22:01", "text": "韓国語と日本語は馴染み深い"}, {"type": "subtitle", "time": 12124.55, "timestamp": "03:22:04", "text": "言語は類似言語です。"}, {"type": "subtitle", "time": 12127.269, "timestamp": "03:22:07", "text": "うん。"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "これまで、自分が望むように決めたことがありますか"}, {"type": "subtitle", "time": 12132.229, "timestamp": "03:22:12", "text": "韓国ルートを選ぶ？ああ、私は"}, {"type": "subtitle", "time": 12135.349, "timestamp": "03:22:15", "text": "日本に着いたら、貯金します"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "起きて休暇を取って"}, {"type": "subtitle", "time": 12141.75, "timestamp": "03:22:21", "text": "韓国や中国などを訪れること、そして"}, {"type": "subtitle", "time": 12144.07, "timestamp": "03:22:24", "text": "楽しんで、また来てね、みたいな感じ。"}, {"type": "subtitle", "time": 12147.03, "timestamp": "03:22:27", "text": "えっと、語学コースが終わったら"}, {"type": "subtitle", "time": 12149.99, "timestamp": "03:22:29", "text": "あるいは、もっと大きくなってきたら"}, {"type": "subtitle", "time": 12152.71, "timestamp": "03:22:32", "text": "休暇か何か。私はまだ"}, {"type": "subtitle", "time": 12155.75, "timestamp": "03:22:35", "text": "えっと、３年生の課程を終える。私は私です"}, {"type": "subtitle", "time": 12160.07, "timestamp": "03:22:40", "text": "えーと、ODLのやつをやってたんだ"}, {"type": "subtitle", "time": 12163.03, "timestamp": "03:22:43", "text": "大学。私は英語を勉強していました"}, {"type": "subtitle", "time": 12165.59, "timestamp": "03:22:45", "text": "文学。だから私は現在今年"}, {"type": "subtitle", "time": 12170.309, "timestamp": "03:22:50", "text": "3年目になります。ええ、ええ、私は"}, {"type": "subtitle", "time": 12172.429, "timestamp": "03:22:52", "text": "3年生の試験を受けられなかった"}, {"type": "subtitle", "time": 12175.55, "timestamp": "03:22:55", "text": "背中がたくさんあるから"}, {"type": "subtitle", "time": 12178.19, "timestamp": "03:22:58", "text": "書類がまた必要だ"}]
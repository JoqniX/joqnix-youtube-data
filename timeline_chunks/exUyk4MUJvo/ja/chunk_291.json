[{"type": "subtitle", "time": 17463.99, "timestamp": "04:51:03", "text": "ええ、それで今日の配信では、忘れていました"}, {"type": "subtitle", "time": 17469.43, "timestamp": "04:51:09", "text": "表を作る。みんなにヘッドパッドをあげたよ"}, {"type": "subtitle", "time": 17473.07, "timestamp": "04:51:13", "text": "あなた方一人ひとり。へ向かう"}, {"type": "subtitle", "time": 17477.55, "timestamp": "04:51:17", "text": "全て。あなたたちは皆、それに値する"}, {"type": "subtitle", "time": 17496.19, "timestamp": "04:51:36", "text": "ほら、自分のことをして、寝て、"}, {"type": "subtitle", "time": 17499.75, "timestamp": "04:51:39", "text": "他の配信を見るようなこと"}, {"type": "subtitle", "time": 17503.868, "timestamp": "04:51:43", "text": "そして再びインスピレーションを得る"}, {"type": "subtitle", "time": 17507.27, "timestamp": "04:51:47", "text": "ポジティブに、モチベーションとして"}, {"type": "subtitle", "time": 17509.39, "timestamp": "04:51:49", "text": "何かをする"}, {"type": "subtitle", "time": 17513.628, "timestamp": "04:51:53", "text": "しかし、私のサポートの人々のために"}]
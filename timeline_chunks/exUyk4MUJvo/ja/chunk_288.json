[{"type": "subtitle", "time": 17283.75, "timestamp": "04:48:03", "text": "先延ばしやその他のことはただ試すだけです"}, {"type": "subtitle", "time": 17288.31, "timestamp": "04:48:08", "text": "そして、自分自身を見つけようとして、それからそれを実行してください。"}, {"type": "subtitle", "time": 17290.948, "timestamp": "04:48:10", "text": "知ってるでしょ、それが私の主な"}, {"type": "subtitle", "time": 17293.51, "timestamp": "04:48:13", "text": "アドバイスと、私がアドバイスする内容も"}, {"type": "subtitle", "time": 17303.868, "timestamp": "04:48:23", "text": "そう、こっちに来て。"}, {"type": "subtitle", "time": 17310.11, "timestamp": "04:48:30", "text": "行く。私はとても陰気です。目が覚めたら"}, {"type": "subtitle", "time": 17311.628, "timestamp": "04:48:31", "text": "早い。"}, {"type": "subtitle", "time": 17316.788, "timestamp": "04:48:36", "text": "それから1時間後に起きてください。うん、寝るよ"}, {"type": "subtitle", "time": 17319.35, "timestamp": "04:48:39", "text": "今。 1～2時間後に起きてください。それから"}, {"type": "subtitle", "time": 17322.868, "timestamp": "04:48:42", "text": "これをストリーミング配信します。そして死んで"}, {"type": "subtitle", "time": 17326.03, "timestamp": "04:48:46", "text": "明日の朝8時か9時に"}, {"type": "subtitle", "time": 17331.51, "timestamp": "04:48:51", "text": "YouTube 4時まで見て、それから死んで、それから寝て"}, {"type": "subtitle", "time": 17338.39, "timestamp": "04:48:58", "text": "8時から3時まで、午前0時まで待ってください。Twitch"}]
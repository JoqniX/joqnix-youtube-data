[{"type": "subtitle", "time": 10563.15, "timestamp": "02:56:03", "text": "それについては、まず知っておいてほしい。"}, {"type": "subtitle", "time": 10566.469, "timestamp": "02:56:06", "text": "ええ、彼らがそれについて言及していたのを覚えています"}, {"type": "subtitle", "time": 10569.59, "timestamp": "02:56:09", "text": "どこかで。私は忘れていました"}, {"type": "subtitle", "time": 10571.95, "timestamp": "02:56:11", "text": "チェック。うん。"}, {"type": "subtitle", "time": 10575.23, "timestamp": "02:56:15", "text": "日本の最低賃金。"}, {"type": "subtitle", "time": 10581.07, "timestamp": "02:56:21", "text": "わかった。ああ、時給1554ドルか。"}, {"type": "subtitle", "time": 10583.15, "timestamp": "02:56:23", "text": "Yは"}, {"type": "subtitle", "time": 10585.83, "timestamp": "02:56:25", "text": "ポンド？ポンドに変換するにはどうすればいいですか？"}, {"type": "subtitle", "time": 10587.87, "timestamp": "02:56:27", "text": "イギリスで理解する"}, {"type": "subtitle", "time": 10591.269, "timestamp": "02:56:31", "text": "条項。こんにちは。うん。"}, {"type": "subtitle", "time": 10593.55, "timestamp": "02:56:33", "text": "それは"}, {"type": "subtitle", "time": 10597.51, "timestamp": "02:56:37", "text": "悪い？それは非常に悪い。何てことだ。とても"}, {"type": "subtitle", "time": 10599.59, "timestamp": "02:56:39", "text": "悪い。"}, {"type": "subtitle", "time": 10603.11, "timestamp": "02:56:43", "text": "時給はたったの5ポンドです。つまり、あなたは"}, {"type": "subtitle", "time": 10607.03, "timestamp": "02:56:47", "text": "時給500ルピー。はぁ？"}, {"type": "subtitle", "time": 10609.469, "timestamp": "02:56:49", "text": "うん。英国の最低賃金は"}, {"type": "subtitle", "time": 10615.95, "timestamp": "02:56:55", "text": "時給は約11ポンドから1,100ポンド。"}, {"type": "subtitle", "time": 10617.95, "timestamp": "02:56:57", "text": "おお"}]
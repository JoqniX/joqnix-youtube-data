[{"type": "subtitle", "time": 16621.91, "timestamp": "04:37:01", "text": "確認してみますか？私はそうでしょうか？うん。わかった。ではなぜ"}, {"type": "subtitle", "time": 16626.99, "timestamp": "04:37:06", "text": "2秒ありますか？二。なんてこった。二。二"}, {"type": "subtitle", "time": 16631.31, "timestamp": "04:37:11", "text": "2番。 8秒。ああ、神様。 8秒。"}, {"type": "subtitle", "time": 16633.15, "timestamp": "04:37:13", "text": "フレイック。"}, {"type": "subtitle", "time": 16638.31, "timestamp": "04:37:18", "text": "もう一つは「なぜそこにあるのか」です"}, {"type": "subtitle", "time": 16644.99, "timestamp": "04:37:24", "text": "2番目？もう一つは寿司だ"}, {"type": "subtitle", "time": 16646.99, "timestamp": "04:37:26", "text": "ドラゴン。"}, {"type": "subtitle", "time": 16651.83, "timestamp": "04:37:31", "text": "えっと、寿司ドラゴン。寿司の龍。はい。"}, {"type": "subtitle", "time": 16658.59, "timestamp": "04:37:38", "text": "男。彼が"}, {"type": "subtitle", "time": 16663.551, "timestamp": "04:37:43", "text": "そうです。エフェクトとか色々。それは"}, {"type": "subtitle", "time": 16666.109, "timestamp": "04:37:46", "text": "だからそれは"}, {"type": "subtitle", "time": 16671.91, "timestamp": "04:37:51", "text": "驚愕だ。これを想像してみてください。すべて"}, {"type": "subtitle", "time": 16675.949, "timestamp": "04:37:55", "text": "OBSなどを通じてライブ配信されます"}, {"type": "subtitle", "time": 16679.83, "timestamp": "04:37:59", "text": "彼だけのもの。彼は"}]
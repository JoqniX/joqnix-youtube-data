[{"type": "subtitle", "time": 12662.229, "timestamp": "03:31:02", "text": "目を閉じたりして、そのまま眠ってしまった。"}, {"type": "subtitle", "time": 12664.71, "timestamp": "03:31:04", "text": "昨日はコラボが5件くらいあったんだけど、"}, {"type": "subtitle", "time": 12667.59, "timestamp": "03:31:07", "text": "一日で何かが起こる。午前11時頃"}, {"type": "subtitle", "time": 12672.07, "timestamp": "03:31:12", "text": "それから午後2時、それから夕方6時"}, {"type": "subtitle", "time": 12675.269, "timestamp": "03:31:15", "text": "夜8時頃最初は"}, {"type": "subtitle", "time": 12678.79, "timestamp": "03:31:18", "text": "10 だったのが 8 に変わり、"}, {"type": "subtitle", "time": 12681.91, "timestamp": "03:31:21", "text": "午前2時半の出来事で、ええ、私はとても"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "疲れ果てた。君は正気じゃない。"}, {"type": "subtitle", "time": 12689.349, "timestamp": "03:31:29", "text": "わからない。私はこう思いました"}, {"type": "subtitle", "time": 12692.309, "timestamp": "03:31:32", "text": "出会った人たちみんなと繋がる"}, {"type": "subtitle", "time": 12696.55, "timestamp": "03:31:36", "text": "今ではそれらを大切に思っています。カモフラージュIを選んだとしても"}, {"type": "subtitle", "time": 12700.469, "timestamp": "03:31:40", "text": "あなたをとても大切に思っています。あなたは私たちを高く評価しています"}, {"type": "subtitle", "time": 12703.83, "timestamp": "03:31:43", "text": "あなた自身"}, {"type": "subtitle", "time": 12705.75, "timestamp": "03:31:45", "text": "ああ、それもそうだね。私は取り組む必要がある"}, {"type": "subtitle", "time": 12708.03, "timestamp": "03:31:48", "text": "それ。"}, {"type": "subtitle", "time": 12712.15, "timestamp": "03:31:52", "text": "うん、あなたが私たちを大切に思ってくれているのは嬉しいけど"}]
[{"type": "subtitle", "time": 4800.07, "timestamp": "01:20:00", "text": "たくさんの"}, {"type": "subtitle", "time": 4804.229, "timestamp": "01:20:04", "text": "無効化しなかったっけ？敵はあと一体。"}, {"type": "subtitle", "time": 4806.63, "timestamp": "01:20:06", "text": "ほんの少しで十分だ。"}, {"type": "subtitle", "time": 4810.03, "timestamp": "01:20:10", "text": "ここで見ています。ああ、私は"}, {"type": "subtitle", "time": 4822.229, "timestamp": "01:20:22", "text": "再装填中。ああ、それは私の"}, {"type": "subtitle", "time": 4824.63, "timestamp": "01:20:24", "text": "チャンネルポイントも同様です。読んだ人"}, {"type": "subtitle", "time": 4827.35, "timestamp": "01:20:27", "text": "まるで、ただ"}, {"type": "subtitle", "time": 4830.47, "timestamp": "01:20:30", "text": "チャンネルポイントを交換するんですよね？"}, {"type": "subtitle", "time": 4833.189, "timestamp": "01:20:33", "text": "だから彼らはチャットはしないが、ただ償う"}, {"type": "subtitle", "time": 4835.229, "timestamp": "01:20:35", "text": "健康上のポイントとしては、水分補給や"}, {"type": "subtitle", "time": 4837.59, "timestamp": "01:20:37", "text": "何か。だから、私がそれを見るたびに"}, {"type": "subtitle", "time": 4839.75, "timestamp": "01:20:39", "text": "Twitchチャットでは、ただ「うん、こんにちは」と言うだけです"}, {"type": "subtitle", "time": 4843.51, "timestamp": "01:20:43", "text": "そして彼らに挨拶をする。行け！行け！行け。だから私は"}, {"type": "subtitle", "time": 4847.189, "timestamp": "01:20:47", "text": "そのリストが欲しかったんです。敵A。"}, {"type": "subtitle", "time": 4848.03, "timestamp": "01:20:48", "text": "時計"}, {"type": "subtitle", "time": 4849.95, "timestamp": "01:20:49", "text": "外。"}, {"type": "subtitle", "time": 4855.27, "timestamp": "01:20:55", "text": "そこには。彼らは死んだ。敵A。"}]
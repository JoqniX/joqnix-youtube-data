[{"type": "subtitle", "time": 10502.07, "timestamp": "02:55:02", "text": "東京の価格を見たので。"}, {"type": "subtitle", "time": 10504.87, "timestamp": "02:55:04", "text": "その倍の金額だった。それはああ、"}, {"type": "subtitle", "time": 10507.429, "timestamp": "02:55:07", "text": "いいえ。うん。大都市ではいつもそういうことが起こる。"}, {"type": "subtitle", "time": 10509.269, "timestamp": "02:55:09", "text": "ロンドンの物価を見たことがありますか？ロンドンで私は"}, {"type": "subtitle", "time": 10513.349, "timestamp": "02:55:13", "text": "毎月8万ドル支払わなければならない。何"}, {"type": "subtitle", "time": 10522.309, "timestamp": "02:55:22", "text": "ロンドンはロンドンであり、物価は安くない。ロンドンは"}, {"type": "subtitle", "time": 10525.51, "timestamp": "02:55:25", "text": "ロンドンは最悪だ。そして私を信じて"}, {"type": "subtitle", "time": 10527.19, "timestamp": "02:55:27", "text": "だから私はロンドンには行かない"}, {"type": "subtitle", "time": 10529.51, "timestamp": "02:55:29", "text": "いいね。つまり、今はロンドンに住む余裕はあるけど"}, {"type": "subtitle", "time": 10532.23, "timestamp": "02:55:32", "text": "それでも私はそこには行かないだろう。"}, {"type": "subtitle", "time": 10535.19, "timestamp": "02:55:35", "text": "M 一度仕事が始まれば大丈夫です"}, {"type": "subtitle", "time": 10537.03, "timestamp": "02:55:37", "text": "仕事に就いて"}, {"type": "subtitle", "time": 10538.469, "timestamp": "02:55:38", "text": "すべて順調ですが、"}, {"type": "subtitle", "time": 10542.15, "timestamp": "02:55:42", "text": "ロンドンでの仕事は、"}, {"type": "subtitle", "time": 10544.07, "timestamp": "02:55:44", "text": "でも、それもすべて相対的なものだと思う。"}, {"type": "subtitle", "time": 10548.469, "timestamp": "02:55:48", "text": "そういうことを全部やらなきゃいけないんだ"}, {"type": "subtitle", "time": 10551.11, "timestamp": "02:55:51", "text": "おそらく、価格についてはご存知のとおりです。"}, {"type": "subtitle", "time": 10553.429, "timestamp": "02:55:53", "text": "物やその他のすべてのものが"}, {"type": "subtitle", "time": 10557.11, "timestamp": "02:55:57", "text": "同じように上昇する"}, {"type": "subtitle", "time": 10559.59, "timestamp": "02:55:59", "text": "最低支払額はいくらですか？"}]
[{"type": "subtitle", "time": 10321.309, "timestamp": "02:52:01", "text": "すべてよし、わかった。"}, {"type": "subtitle", "time": 10324.389, "timestamp": "02:52:04", "text": "1.69ポンド。月ごとに分けてみましょう。おお、"}, {"type": "subtitle", "time": 10338.71, "timestamp": "02:52:18", "text": "84,500。うん、"}, {"type": "subtitle", "time": 10341.07, "timestamp": "02:52:21", "text": "支払うだけです。"}, {"type": "subtitle", "time": 10344.63, "timestamp": "02:52:24", "text": "わかった。つまり、月額わずか2万ドルです。する"}, {"type": "subtitle", "time": 10347.83, "timestamp": "02:52:27", "text": "私がイギリスでいくら払っているか知っていますか？どうやって"}, {"type": "subtitle", "time": 10349.59, "timestamp": "02:52:29", "text": "多くの？"}, {"type": "subtitle", "time": 10354.389, "timestamp": "02:52:34", "text": "私は毎月6万ドル支払っています。何？"}, {"type": "subtitle", "time": 10357.75, "timestamp": "02:52:37", "text": "うん。うん。はぁ？"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "本当に？それは、それほど高価なのです"}, {"type": "subtitle", "time": 10361.75, "timestamp": "02:52:41", "text": "こちらです。それはまるで私がそれを手に入れたようなものだ"}, {"type": "subtitle", "time": 10364.15, "timestamp": "02:52:44", "text": "ここの料金の額は、私は"}, {"type": "subtitle", "time": 10370.389, "timestamp": "02:52:50", "text": "いや、違う。私を信じて。悪くはない。"}, {"type": "subtitle", "time": 10372.389, "timestamp": "02:52:52", "text": "信じてくれ、それは"}, {"type": "subtitle", "time": 10376.07, "timestamp": "02:52:56", "text": "あなたは考えることができる。何てことだ。"}, {"type": "subtitle", "time": 10379.429, "timestamp": "02:52:59", "text": "それは、それは、私は喜んでその上に住みます"}]
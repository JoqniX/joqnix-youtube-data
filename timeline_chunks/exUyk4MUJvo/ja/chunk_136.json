[{"type": "subtitle", "time": 8161.31, "timestamp": "02:16:01", "text": "それは私がこれから言うことに、よりよく表れています。"}, {"type": "subtitle", "time": 8164.069, "timestamp": "02:16:04", "text": "ああ、私は知らない。それは「伝説の」と呼ばれている。"}, {"type": "subtitle", "time": 8165.83, "timestamp": "02:16:05", "text": "主。"}, {"type": "subtitle", "time": 8168.39, "timestamp": "02:16:08", "text": "ロードブレードの伝説。ああ、そうだね"}, {"type": "subtitle", "time": 8171.03, "timestamp": "02:16:11", "text": "13歳児のように聞こえる。私を信じて、"}, {"type": "subtitle", "time": 8186.96, "timestamp": "02:16:26", "text": "ええ、それは私です。"}, {"type": "subtitle", "time": 8189.91, "timestamp": "02:16:29", "text": "[音楽]"}, {"type": "subtitle", "time": 8192.07, "timestamp": "02:16:32", "text": "テレビ番組はどうでしょうか？行ったことがありますか？"}, {"type": "subtitle", "time": 8194.15, "timestamp": "02:16:34", "text": "Netflixの番組や"}, {"type": "subtitle", "time": 8197.07, "timestamp": "02:16:37", "text": "何でも？"}, {"type": "subtitle", "time": 8201.03, "timestamp": "02:16:41", "text": "えっと、Netflixの番組。えっと、いくつか見たんだけど"}, {"type": "subtitle", "time": 8202.629, "timestamp": "02:16:42", "text": "時々彼らのことを話すが、私は"}, {"type": "subtitle", "time": 8204.79, "timestamp": "02:16:44", "text": "全部見る時間を確保"}, {"type": "subtitle", "time": 8207.19, "timestamp": "02:16:47", "text": "どれも1時間くらいの長さだから、"}, {"type": "subtitle", "time": 8210.95, "timestamp": "02:16:50", "text": "あなたが知っている。ええ、そうです。"}, {"type": "subtitle", "time": 8213.91, "timestamp": "02:16:53", "text": "だから、それはとても大きなコミットメントです"}, {"type": "subtitle", "time": 8215.99, "timestamp": "02:16:55", "text": "ただそこに座って、すべてを見ていればいい。しかし"}, {"type": "subtitle", "time": 8219.349, "timestamp": "02:16:59", "text": "私は「What's the game」を見たいと思っていました"}]
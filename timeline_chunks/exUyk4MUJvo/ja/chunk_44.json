[{"type": "subtitle", "time": 2642.15, "timestamp": "00:44:02", "text": "私の見解では、ニックネームまたは"}, {"type": "subtitle", "time": 2645.67, "timestamp": "00:44:05", "text": "何かがめちゃくちゃ知ってる、これはb"}, {"type": "subtitle", "time": 2646.67, "timestamp": "00:44:06", "text": "番号"}, {"type": "subtitle", "time": 2649.91, "timestamp": "00:44:09", "text": "そんな感じのものが2つ。それが私の"}, {"type": "subtitle", "time": 2651.829, "timestamp": "00:44:11", "text": "とんでもないアイデアだ。これは書き留めておくべきだ。"}, {"type": "subtitle", "time": 2655.43, "timestamp": "00:44:15", "text": "何てことだ。さもないと忘れてしまう。"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "敵はあと一体。クラッチ。ニース。"}, {"type": "subtitle", "time": 2665.109, "timestamp": "00:44:25", "text": "ああ、背中が痛い。みんなすごく重い。"}, {"type": "subtitle", "time": 2666.87, "timestamp": "00:44:26", "text": "これを書き留めてクリックするか、"}, {"type": "subtitle", "time": 2669.99, "timestamp": "00:44:29", "text": "何か。再装填中。だって、忘れちゃうんだもん。彼らは"}]
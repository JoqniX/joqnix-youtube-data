[{"type": "subtitle", "time": 8282.629, "timestamp": "02:18:02", "text": "Netflixの番組。はぁ？ Netflixを見せてください。"}, {"type": "subtitle", "time": 8284.469, "timestamp": "02:18:04", "text": "私のNetflixを見せてください。私はシングルスを観る"}, {"type": "subtitle", "time": 8288.03, "timestamp": "02:18:08", "text": "インフェルノだよ、知ってる？それは何ですか？"}, {"type": "subtitle", "time": 8291.11, "timestamp": "02:18:11", "text": "えっと、まだ見てないんです。韓国のデート"}, {"type": "subtitle", "time": 8295.79, "timestamp": "02:18:15", "text": "見せる。これは韓国の恋愛リアリティ番組です。ああ、"}, {"type": "subtitle", "time": 8299.549, "timestamp": "02:18:19", "text": "うん。それはとてもそれはとても"}, {"type": "subtitle", "time": 8303.91, "timestamp": "02:18:23", "text": "えーっと、どう言えばいいかな？非常に基本的"}, {"type": "subtitle", "time": 8306.07, "timestamp": "02:18:26", "text": "あなたのような韓国の恋愛番組"}, {"type": "subtitle", "time": 8308.95, "timestamp": "02:18:28", "text": "そんなに触られたりしないよ"}, {"type": "subtitle", "time": 8315.589, "timestamp": "02:18:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 8318.709, "timestamp": "02:18:38", "text": "何を見ていたか確認させてください。だから私は"}, {"type": "subtitle", "time": 8325.589, "timestamp": "02:18:45", "text": "もう一度実行してみました。私は見たかった"}, {"type": "subtitle", "time": 8328.549, "timestamp": "02:18:48", "text": "私がやった悪魔シリーズ"}]
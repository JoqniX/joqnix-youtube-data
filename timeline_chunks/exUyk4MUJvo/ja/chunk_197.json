[{"type": "subtitle", "time": 11822.95, "timestamp": "03:17:02", "text": "もしあの場所が、この場所が来たら"}, {"type": "subtitle", "time": 11827.59, "timestamp": "03:17:07", "text": "戻る前に、もし私がそうしたら"}, {"type": "subtitle", "time": 11831.59, "timestamp": "03:17:11", "text": "実際に支払うのに時間がかかり、"}, {"type": "subtitle", "time": 11834.87, "timestamp": "03:17:14", "text": "最終的には、私はこれを自分のために手に入れます"}, {"type": "subtitle", "time": 11837.429, "timestamp": "03:17:17", "text": "もし彼らがやって来て、私がまだ"}, {"type": "subtitle", "time": 11839.83, "timestamp": "03:17:19", "text": "彼らの下にあり、すべてが同じように正しい"}, {"type": "subtitle", "time": 11843.19, "timestamp": "03:17:23", "text": "だから私は「ああ、どうすればいいのかわからない」って感じ"}, {"type": "subtitle", "time": 11845.269, "timestamp": "03:17:25", "text": "物事はそうなるだろうけど、そう、私はそうしなかったから"}, {"type": "subtitle", "time": 11848.309, "timestamp": "03:17:28", "text": "私がそこにいなければならなかったという事実のように"}, {"type": "subtitle", "time": 11851.51, "timestamp": "03:17:31", "text": "これは行われたので、私は好きにならなければなりません"}, {"type": "subtitle", "time": 11853.99, "timestamp": "03:17:33", "text": "なぜなら彼らは余裕がなかったから"}, {"type": "subtitle", "time": 11856.95, "timestamp": "03:17:36", "text": "ええと、資金です。だから私は対処しなければならないのです。"}, {"type": "subtitle", "time": 11857.95, "timestamp": "03:17:37", "text": "それ"}, {"type": "subtitle", "time": 11860.389, "timestamp": "03:17:40", "text": "自分自身。わからない、もしかしたら私は"}, {"type": "subtitle", "time": 11862.71, "timestamp": "03:17:42", "text": "頑固で、わからないけど、ただ"}, {"type": "subtitle", "time": 11865.11, "timestamp": "03:17:45", "text": "ああ、そうはさせられなかった"}, {"type": "subtitle", "time": 11867.99, "timestamp": "03:17:47", "text": "忘れ去られた。とても素敵なモデルで"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "とても気に入っています。皆さんに"}, {"type": "subtitle", "time": 11872.95, "timestamp": "03:17:52", "text": "いつかそれを見ることができるだろうし、すべてを見るだろう。"}, {"type": "subtitle", "time": 11876.229, "timestamp": "03:17:56", "text": "ええ、だって、Vtubing のおかげで"}, {"type": "subtitle", "time": 11878.389, "timestamp": "03:17:58", "text": "えっと、ストリーミング配信してたと思うんだけど"}]
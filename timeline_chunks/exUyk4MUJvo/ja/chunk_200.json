[{"type": "subtitle", "time": 12003.11, "timestamp": "03:20:03", "text": "だが、この時点で私はこう思う。"}, {"type": "subtitle", "time": 12005.67, "timestamp": "03:20:05", "text": "わかった、つまり"}, {"type": "subtitle", "time": 12010.229, "timestamp": "03:20:10", "text": "それは残念だけど、仕方ないね。問題は"}, {"type": "subtitle", "time": 12013.19, "timestamp": "03:20:13", "text": "人気があることに気づきましたが、"}, {"type": "subtitle", "time": 12015.75, "timestamp": "03:20:15", "text": "中国語で非常に人気があります"}, {"type": "subtitle", "time": 12018.71, "timestamp": "03:20:18", "text": "舌。だから私はある代理店か何かを知っている"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "そんな感じだけど、彼らはとても集中している"}, {"type": "subtitle", "time": 12024.229, "timestamp": "03:20:24", "text": "一国的な側面。ねえ、私が"}, {"type": "subtitle", "time": 12026.469, "timestamp": "03:20:26", "text": "平均？まるで東アジアのよう"}, {"type": "subtitle", "time": 12028.469, "timestamp": "03:20:28", "text": "支配した。だから、次のように学ぶ必要がある"}, {"type": "subtitle", "time": 12032.229, "timestamp": "03:20:32", "text": "東アジアの言語。真実。真実。うん。"}, {"type": "subtitle", "time": 12035.349, "timestamp": "03:20:35", "text": "あなたは日本語がわかるんですね。それで"}, {"type": "subtitle", "time": 12040.229, "timestamp": "03:20:40", "text": "私は勉強中で、N5試験にも合格しました。私"}, {"type": "subtitle", "time": 12043.91, "timestamp": "03:20:43", "text": "私はN5試験に合格しましたか？私が書いた"}, {"type": "subtitle", "time": 12045.67, "timestamp": "03:20:45", "text": "チェンナイで"}, {"type": "subtitle", "time": 12047.91, "timestamp": "03:20:47", "text": "2月に。流暢に話せますか？"}, {"type": "subtitle", "time": 12051.51, "timestamp": "03:20:51", "text": "けれど？流暢ではない。少しなら話せます。"}, {"type": "subtitle", "time": 12055.11, "timestamp": "03:20:55", "text": "うん。話すのはいいけど、文法が"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "そして全てはOです。"}]
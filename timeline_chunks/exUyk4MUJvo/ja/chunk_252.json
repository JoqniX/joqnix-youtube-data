[{"type": "subtitle", "time": 15126.91, "timestamp": "04:12:06", "text": "うん。ああ、これ、見える？これは"}, {"type": "subtitle", "time": 15129.59, "timestamp": "04:12:09", "text": "ニコンのやつ。すべてを見ることができます"}, {"type": "subtitle", "time": 15132.189, "timestamp": "04:12:12", "text": "コメントは次のようになります"}, {"type": "subtitle", "time": 15134.91, "timestamp": "04:12:14", "text": "これ。"}, {"type": "subtitle", "time": 15140.95, "timestamp": "04:12:20", "text": "行く。これ、見えますか？かっこいいと思わない？送ってください。"}, {"type": "subtitle", "time": 15142.429, "timestamp": "04:12:22", "text": "送信"}, {"type": "subtitle", "time": 15168.189, "timestamp": "04:12:48", "text": "1つ。うん。どうすればいいですか どうすればいいですか"}, {"type": "subtitle", "time": 15171.429, "timestamp": "04:12:51", "text": "あ、待って。待って。忘れた。それは"}, {"type": "subtitle", "time": 15174.87, "timestamp": "04:12:54", "text": "ああ、それは「ああ、くそ」ではない。忘れた。その"}, {"type": "subtitle", "time": 15176.51, "timestamp": "04:12:56", "text": "ではない"}, {"type": "subtitle", "time": 15179.91, "timestamp": "04:12:59", "text": "Chromeウェブストアです。それはそれは"}]
[{"type": "subtitle", "time": 14404.87, "timestamp": "04:00:04", "text": "その曲名。話したかった"}, {"type": "subtitle", "time": 14412.349, "timestamp": "04:00:12", "text": "コントロール。歌が聞こえない"}, {"type": "subtitle", "time": 14414.75, "timestamp": "04:00:14", "text": "プレイしました。わかった。"}, {"type": "subtitle", "time": 14423.11, "timestamp": "04:00:23", "text": "何？冗談ですよね？冗談だよ、"}, {"type": "subtitle", "time": 14428.429, "timestamp": "04:00:28", "text": "おお、"}, {"type": "subtitle", "time": 14442.189, "timestamp": "04:00:42", "text": "死ぬ。私はくしゃみをした。おお"}, {"type": "subtitle", "time": 14446.79, "timestamp": "04:00:46", "text": "ああ、くしゃみしちゃった。そこには何もない。"}, {"type": "subtitle", "time": 14448.269, "timestamp": "04:00:48", "text": "いいえ。ああ"}, {"type": "subtitle", "time": 14458.15, "timestamp": "04:00:58", "text": "待って、最初は"}]
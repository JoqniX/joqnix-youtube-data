[{"type": "subtitle", "time": 14642.11, "timestamp": "04:04:02", "text": "私はあらゆる場所にいます"}, {"type": "subtitle", "time": 14645.15, "timestamp": "04:04:05", "text": "場所。なぜ私は"}, {"type": "subtitle", "time": 14647.229, "timestamp": "04:04:07", "text": "ストリーミング配信？違う"}, {"type": "subtitle", "time": 14650.11, "timestamp": "04:04:10", "text": "彼らは？違う"}, {"type": "subtitle", "time": 14653.75, "timestamp": "04:04:13", "text": "彼らは？くそ。サウンドボードはどこですか？"}, {"type": "subtitle", "time": 14655.63, "timestamp": "04:04:15", "text": "サウンドボードはどこですか？どこにある"}, {"type": "subtitle", "time": 14658.9, "timestamp": "04:04:18", "text": "サウンドボード？どこにある"}, {"type": "subtitle", "time": 14664.91, "timestamp": "04:04:24", "text": "[音楽]"}, {"type": "subtitle", "time": 14668.309, "timestamp": "04:04:28", "text": "サウンドボード？ああ、くそ。ああ、くそ。ああ、くそ。"}, {"type": "subtitle", "time": 14672.75, "timestamp": "04:04:32", "text": "最悪だ。停止。停止。全て"}, {"type": "subtitle", "time": 14676.31, "timestamp": "04:04:36", "text": "種類。それで大丈夫です。"}, {"type": "subtitle", "time": 14687.03, "timestamp": "04:04:47", "text": "私はカメが好きです。"}, {"type": "subtitle", "time": 14693.07, "timestamp": "04:04:53", "text": "このキーは何をするものですか？えっと、C D E F G A B C E"}, {"type": "subtitle", "time": 14697.06, "timestamp": "04:04:57", "text": "シャープC#。これは何も効果がない"}]
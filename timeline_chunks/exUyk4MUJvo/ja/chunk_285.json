[{"type": "subtitle", "time": 17108.39, "timestamp": "04:45:08", "text": "しかし、Discordでの配信により"}, {"type": "subtitle", "time": 17111.31, "timestamp": "04:45:11", "text": "通知は"}, {"type": "subtitle", "time": 17112.99, "timestamp": "04:45:12", "text": "なれ"}, {"type": "subtitle", "time": 17114.75, "timestamp": "04:45:14", "text": "ミュート。"}, {"type": "subtitle", "time": 17117.75, "timestamp": "04:45:17", "text": "前回の配信と同じように"}, {"type": "subtitle", "time": 17120.948, "timestamp": "04:45:20", "text": "つまり、Twitchの最後の配信のことです。"}, {"type": "subtitle", "time": 17124.31, "timestamp": "04:45:24", "text": "えっと、私の最新の配信は"}, {"type": "subtitle", "time": 17128.2, "timestamp": "04:45:28", "text": "Twitchで最近配信したストリームで寝ました"}, {"type": "subtitle", "time": 17135.67, "timestamp": "04:45:35", "text": "オフ。ああ、まさにそんな感じ。ありがとうございます"}, {"type": "subtitle", "time": 17142.07, "timestamp": "04:45:42", "text": "ストリーム。あなたはここにいます"}, {"type": "subtitle", "time": 17151.51, "timestamp": "04:45:51", "text": "もう終わりにすべきだと思う。どのぐらいの間"}, {"type": "subtitle", "time": 17154.55, "timestamp": "04:45:54", "text": "また配信してるの？確認してみます。"}, {"type": "subtitle", "time": 17159.07, "timestamp": "04:45:59", "text": "ええ、4時間経過したところです"}]
[{"type": "subtitle", "time": 10022.15, "timestamp": "02:47:02", "text": "毎回嫌悪感を感じる"}, {"type": "subtitle", "time": 10024.95, "timestamp": "02:47:04", "text": "出てくる。でも、ああ、なんてことだ。やらなきゃいけない"}, {"type": "subtitle", "time": 10026.74, "timestamp": "02:47:06", "text": "あなたがすべきこと。"}, {"type": "subtitle", "time": 10029.19, "timestamp": "02:47:09", "text": "[音楽]"}, {"type": "subtitle", "time": 10030.63, "timestamp": "02:47:10", "text": "あなたはあちらのベッドで寝ることになるよ。"}, {"type": "subtitle", "time": 10045.19, "timestamp": "02:47:25", "text": "ちょっと、ええ、そうだと思います"}, {"type": "subtitle", "time": 10047.91, "timestamp": "02:47:27", "text": "個室の方が私には都合がいい"}, {"type": "subtitle", "time": 10050.79, "timestamp": "02:47:30", "text": "個室ではなく、"}, {"type": "subtitle", "time": 10054.309, "timestamp": "02:47:34", "text": "ルームメイトと二人部屋なので"}, {"type": "subtitle", "time": 10057.83, "timestamp": "02:47:37", "text": "えっと、もう学生みたいなのを聞いたよ"}, {"type": "subtitle", "time": 10060.309, "timestamp": "02:47:40", "text": "4月に旅行に行ったクラスメート"}, {"type": "subtitle", "time": 10062.79, "timestamp": "02:47:42", "text": "彼らが言っていたことは、そう、"}, {"type": "subtitle", "time": 10065.59, "timestamp": "02:47:45", "text": "部屋から電話をかけると"}, {"type": "subtitle", "time": 10068.23, "timestamp": "02:47:48", "text": "他の人にとっては迷惑なので、"}, {"type": "subtitle", "time": 10071.309, "timestamp": "02:47:51", "text": "騒音の苦情がたくさんあるので"}, {"type": "subtitle", "time": 10074.71, "timestamp": "02:47:54", "text": "ある意味、私にとって何がより良いのか"}, {"type": "subtitle", "time": 10076.67, "timestamp": "02:47:56", "text": "ストリーミング配信をしているので設定しています"}, {"type": "subtitle", "time": 10079.75, "timestamp": "02:47:59", "text": "すべては、それが"}]
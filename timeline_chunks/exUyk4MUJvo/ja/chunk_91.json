[{"type": "subtitle", "time": 5460.03, "timestamp": "01:31:00", "text": "あまりにも。手動で入力したくない"}, {"type": "subtitle", "time": 5462.95, "timestamp": "01:31:02", "text": "それ。人々は列に並んで待っています、"}, {"type": "subtitle", "time": 5465.91, "timestamp": "01:31:05", "text": "何か。ああ、たくさん"}, {"type": "subtitle", "time": 5467.709, "timestamp": "01:31:07", "text": "アイデア"}, {"type": "subtitle", "time": 5470.709, "timestamp": "01:31:10", "text": "生活の質に関する話題を配信する。私は"}, {"type": "subtitle", "time": 5510.03, "timestamp": "01:31:50", "text": "それは"}, {"type": "subtitle", "time": 5514.189, "timestamp": "01:31:54", "text": "あなた？ベイビー、君なの？静かに。"}, {"type": "subtitle", "time": 5517.75, "timestamp": "01:31:57", "text": "え、何？"}]
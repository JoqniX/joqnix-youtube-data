[{"type": "subtitle", "time": 13081.229, "timestamp": "03:38:01", "text": "あなた"}, {"type": "subtitle", "time": 13085.67, "timestamp": "03:38:05", "text": "Siri。それは本当に大きな意味があります。え、本当？"}, {"type": "subtitle", "time": 13087.95, "timestamp": "03:38:07", "text": "とても意味があります。"}, {"type": "subtitle", "time": 13089.79, "timestamp": "03:38:09", "text": "えっと"}, {"type": "subtitle", "time": 13103.269, "timestamp": "03:38:23", "text": "機会。最善を尽くします。私は"}, {"type": "subtitle", "time": 13105.469, "timestamp": "03:38:25", "text": "それが"}, {"type": "subtitle", "time": 13110.95, "timestamp": "03:38:30", "text": "別アカウントで参加しても構いません。えっと"}, {"type": "subtitle", "time": 13112.87, "timestamp": "03:38:32", "text": "なぜなら"}, {"type": "subtitle", "time": 13114.83, "timestamp": "03:38:34", "text": "えっと"}, {"type": "subtitle", "time": 13117.75, "timestamp": "03:38:37", "text": "私の主な"}, {"type": "subtitle", "time": 13125.15, "timestamp": "03:38:45", "text": "ニトロは入ってない"}, {"type": "subtitle", "time": 13126.91, "timestamp": "03:38:46", "text": "もう。"}, {"type": "subtitle", "time": 13133.469, "timestamp": "03:38:53", "text": "えっと、サーバーに入っているので"}, {"type": "subtitle", "time": 13138.91, "timestamp": "03:38:58", "text": "私"}]
[{"type": "subtitle", "time": 660.87, "timestamp": "00:11:00", "text": "うん。そうそう。参加したい方は"}, {"type": "subtitle", "time": 663.75, "timestamp": "00:11:03", "text": "ちなみに、あなたも参加できますよ。忘れた"}, {"type": "subtitle", "time": 665.389, "timestamp": "00:11:05", "text": "言及する"}, {"type": "subtitle", "time": 668.19, "timestamp": "00:11:08", "text": "それは"}, {"type": "subtitle", "time": 672.47, "timestamp": "00:11:12", "text": "終わり。私はいつからここにいるの？"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "流れ？ 6時半ですよね？ 6:00に"}, {"type": "subtitle", "time": 681.11, "timestamp": "00:11:21", "text": "朝。何てことだ。待って、私は"}, {"type": "subtitle", "time": 684.15, "timestamp": "00:11:24", "text": "私が何時間配信したか確認する"}, {"type": "subtitle", "time": 688.31, "timestamp": "00:11:28", "text": "この1ヶ月でこれをやります。うん、そうしよう"}, {"type": "subtitle", "time": 691.99, "timestamp": "00:11:31", "text": "私が12時間配信を何回行ったか見てください。"}, {"type": "subtitle", "time": 694.35, "timestamp": "00:11:34", "text": "昨日は12時間。それは"}, {"type": "subtitle", "time": 700.55, "timestamp": "00:11:40", "text": "1 2 3 4 5 6 7。うん、これは近い"}, {"type": "subtitle", "time": 705.75, "timestamp": "00:11:45", "text": "10. わかりました。うん。セブン。"}, {"type": "subtitle", "time": 707.31, "timestamp": "00:11:47", "text": "セブン、"}, {"type": "subtitle", "time": 710.03, "timestamp": "00:11:50", "text": "右？ああ、たった7人だ。"}, {"type": "subtitle", "time": 713.31, "timestamp": "00:11:53", "text": "わあ、それは"}, {"type": "subtitle", "time": 716.949, "timestamp": "00:11:56", "text": "それ。でも、中には10個あるものもあります。数えるべきでしょうか？"}]
[{"type": "subtitle", "time": 9123.67, "timestamp": "02:32:03", "text": "DPDですが、DPDが"}, {"type": "subtitle", "time": 9124.87, "timestamp": "02:32:04", "text": "地元の人が持っているかもしれない"}, {"type": "subtitle", "time": 9128.51, "timestamp": "02:32:08", "text": "GPDとチャットする必要があるけど、うん。うん。"}, {"type": "subtitle", "time": 9131.19, "timestamp": "02:32:11", "text": "うん。つまり、充電が役に立つかもしれない"}, {"type": "subtitle", "time": 9134.23, "timestamp": "02:32:14", "text": "イギリスではDPDを使用しているため、"}, {"type": "subtitle", "time": 9138.15, "timestamp": "02:32:18", "text": "それを代わりにやってくれます。おお"}, {"type": "subtitle", "time": 9141.429, "timestamp": "02:32:21", "text": "うん。つまり、マギーマジックが手に入るってことだよ"}, {"type": "subtitle", "time": 9143.469, "timestamp": "02:32:23", "text": "マサラはこうなります"}, {"type": "subtitle", "time": 9145.95, "timestamp": "02:32:25", "text": "あなたは得られないでしょう"}, {"type": "subtitle", "time": 9149.67, "timestamp": "02:32:29", "text": "つまり、私は自分が"}, {"type": "subtitle", "time": 9151.91, "timestamp": "02:32:31", "text": "君はそう思うかもしれないけど、君が"}, {"type": "subtitle", "time": 9154.71, "timestamp": "02:32:34", "text": "イリーやドーサのようなものが手に入るかもしれない"}, {"type": "subtitle", "time": 9157.19, "timestamp": "02:32:37", "text": "あちらのバッター。私たちはそれをこちらで入手します"}, {"type": "subtitle", "time": 9159.32, "timestamp": "02:32:39", "text": "しかし、こちらではそうではない。"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "残念ながらイタリアの"}, {"type": "subtitle", "time": 9169.19, "timestamp": "02:32:49", "text": "私はそれを非常に後悔しています。私は、"}, {"type": "subtitle", "time": 9170.87, "timestamp": "02:32:50", "text": "必要な機材はすべて"}, {"type": "subtitle", "time": 9172.29, "timestamp": "02:32:52", "text": "イタリア"}, {"type": "subtitle", "time": 9174.07, "timestamp": "02:32:54", "text": "[音楽]"}, {"type": "subtitle", "time": 9177.429, "timestamp": "02:32:57", "text": "だから私は何とかしてそれを調達しなければならない"}, {"type": "subtitle", "time": 9179.349, "timestamp": "02:32:59", "text": "以前のルームメイトはイタリア料理を作っていた"}]
[{"type": "subtitle", "time": 16207.71, "timestamp": "04:30:07", "text": "くそ"}, {"type": "subtitle", "time": 16211.67, "timestamp": "04:30:11", "text": "えっと、えっと、えっと、でも、ちょっと待ってよ"}, {"type": "subtitle", "time": 16218.87, "timestamp": "04:30:18", "text": "これ？私も参加してもいいですか？わからない。私"}, {"type": "subtitle", "time": 16220.79, "timestamp": "04:30:20", "text": "わからない。私は出場しません。えっと、私は"}, {"type": "subtitle", "time": 16222.64, "timestamp": "04:30:22", "text": "わからない。"}, {"type": "subtitle", "time": 16231.03, "timestamp": "04:30:31", "text": "多分。あ、待って。あなたはコントロールできます"}, {"type": "subtitle", "time": 16232.67, "timestamp": "04:30:32", "text": "ボリュームを使用して"}, {"type": "subtitle", "time": 16237.99, "timestamp": "04:30:37", "text": "ノブ。それから私は、忘れてさえいませんでした。私"}, {"type": "subtitle", "time": 16241.91, "timestamp": "04:30:41", "text": "こんなものがあったことすら忘れてた。また、"}, {"type": "subtitle", "time": 16246.83, "timestamp": "04:30:46", "text": "オクターブとモジュレーションとピッチ。"}, {"type": "subtitle", "time": 16251.08, "timestamp": "04:30:51", "text": "えっと、変調器とかのこと忘れてた。"}]
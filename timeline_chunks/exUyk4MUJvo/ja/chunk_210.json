[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "1953年。ああ、午後7時だ。今すぐ。おお。"}, {"type": "subtitle", "time": 12603.03, "timestamp": "03:30:03", "text": "しかし日本では、ほぼ9時間です"}, {"type": "subtitle", "time": 12607.67, "timestamp": "03:30:07", "text": "私より先に進んでいます。ああ、午後7時だ。うん。"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "午後6時までにインドでは、それは10時半くらいです"}, {"type": "subtitle", "time": 12614.389, "timestamp": "03:30:14", "text": "午後何かある。うん。いいえ、それは"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "ああ、もう時間だ。インド対日本は"}, {"type": "subtitle", "time": 12620.389, "timestamp": "03:30:20", "text": "たった4時間ですよね？もし私が"}, {"type": "subtitle", "time": 12622.87, "timestamp": "03:30:22", "text": "正しい。 3時間30分。ええ、そうです"}, {"type": "subtitle", "time": 12624.95, "timestamp": "03:30:24", "text": "全然悪くない。悪くないね。何"}, {"type": "subtitle", "time": 12628.95, "timestamp": "03:30:28", "text": "ロンドンについて？それはいくらですか？ 5時30分"}, {"type": "subtitle", "time": 12633.19, "timestamp": "03:30:33", "text": "プラス5時30分。ああ、それは5時間と5時間30分ですね"}, {"type": "subtitle", "time": 12636.309, "timestamp": "03:30:36", "text": "数分先です。おお。"}, {"type": "subtitle", "time": 12638.55, "timestamp": "03:30:38", "text": "それでも悪くはない。カナダの方がはるかにひどい。"}, {"type": "subtitle", "time": 12640.83, "timestamp": "03:30:40", "text": "約2時間。"}, {"type": "subtitle", "time": 12643.59, "timestamp": "03:30:43", "text": "うん。昨日、私は"}, {"type": "subtitle", "time": 12647.59, "timestamp": "03:30:47", "text": "カナダに行って、それから寝て寝ました。彼らはいた"}, {"type": "subtitle", "time": 12650.389, "timestamp": "03:30:50", "text": "彼らは行かなければならなかったので少し遅れた"}, {"type": "subtitle", "time": 12652.71, "timestamp": "03:30:52", "text": "外の何かの上。ええと、私は言いました"}, {"type": "subtitle", "time": 12655.67, "timestamp": "03:30:55", "text": "30分前にDMを送るか、"}, {"type": "subtitle", "time": 12658.71, "timestamp": "03:30:58", "text": "1時間前に少し昼寝をします"}]
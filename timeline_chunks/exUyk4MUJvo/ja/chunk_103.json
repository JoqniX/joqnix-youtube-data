[{"type": "subtitle", "time": 6180.95, "timestamp": "01:43:00", "text": "そう、そんな感じ。だから、"}, {"type": "subtitle", "time": 6184.87, "timestamp": "01:43:04", "text": "6月と7月は5人の学生"}, {"type": "subtitle", "time": 6186.47, "timestamp": "01:43:06", "text": "摂取量。"}, {"type": "subtitle", "time": 6188.87, "timestamp": "01:43:08", "text": "うん。うん。 5人の生徒が同じ"}, {"type": "subtitle", "time": 6191.83, "timestamp": "01:43:11", "text": "学校。うん。そんな感じ。わかった。少なくとも"}, {"type": "subtitle", "time": 6193.75, "timestamp": "01:43:13", "text": "あなたには頼れる人がいる。"}, {"type": "subtitle", "time": 6196.79, "timestamp": "01:43:16", "text": "うん。それは良いことだ。私は中に入った"}, {"type": "subtitle", "time": 6197.83, "timestamp": "01:43:17", "text": "まったく一人ぼっちなんだよ。知りませんでした"}, {"type": "subtitle", "time": 6200.31, "timestamp": "01:43:20", "text": "誰でも。ただ、ただ祈っただけです"}, {"type": "subtitle", "time": 6202.629, "timestamp": "01:43:22", "text": "そして私は「大丈夫」という感じで行った。私"}, {"type": "subtitle", "time": 6205.229, "timestamp": "01:43:25", "text": "そこで友達を作るつもりだ。"}, {"type": "subtitle", "time": 6207.75, "timestamp": "01:43:27", "text": "うん。そして、あなたは作ったと信じています"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "友達ですよね？ええ、そうですね。うん。しかし"}, {"type": "subtitle", "time": 6215.27, "timestamp": "01:43:35", "text": "わかりました。だから、それは面白い"}, {"type": "subtitle", "time": 6218.709, "timestamp": "01:43:38", "text": "状況。友達はできました。"}, {"type": "subtitle", "time": 6222.229, "timestamp": "01:43:42", "text": "ええと、でも、問題は、私は"}, {"type": "subtitle", "time": 6225.27, "timestamp": "01:43:45", "text": "かつて住んでいた街を離れる。それで、"}, {"type": "subtitle", "time": 6227.59, "timestamp": "01:43:47", "text": "今の私の状況では、始めなければならない"}, {"type": "subtitle", "time": 6231.35, "timestamp": "01:43:51", "text": "ゼロからの復活。なんてこった。"}, {"type": "subtitle", "time": 6235.59, "timestamp": "01:43:55", "text": "でも大丈夫。もう一度やり直します。 M"}, {"type": "subtitle", "time": 6237.27, "timestamp": "01:43:57", "text": "そういう会話の一つだよね"}]
[{"type": "subtitle", "time": 14899.03, "timestamp": "04:08:19", "text": "ミナがTwitchの配信に出演中。私が試してみます"}, {"type": "subtitle", "time": 14910.79, "timestamp": "04:08:30", "text": "それはただ多すぎる"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "[音楽]"}, {"type": "subtitle", "time": 14915.309, "timestamp": "04:08:35", "text": "やるべきこと。あまりにも"}, {"type": "subtitle", "time": 14925.11, "timestamp": "04:08:45", "text": "兄弟。待って、車はこう走っていた"}, {"type": "subtitle", "time": 14936.15, "timestamp": "04:08:56", "text": "それ？それはどこへ行ったの？おい、俺は"}, {"type": "subtitle", "time": 14937.49, "timestamp": "04:08:57", "text": "以前は"}]
[{"type": "subtitle", "time": 11223.309, "timestamp": "03:07:03", "text": "私はそれがよりユニークで"}, {"type": "subtitle", "time": 11228.15, "timestamp": "03:07:08", "text": "それとか、私のタイプに合ってるんだよね。"}, {"type": "subtitle", "time": 11230.87, "timestamp": "03:07:10", "text": "とても素敵なモデルですね。それは"}, {"type": "subtitle", "time": 11233.67, "timestamp": "03:07:13", "text": "優先度？はい。うん。我が神よ。それは"}, {"type": "subtitle", "time": 11236.71, "timestamp": "03:07:16", "text": "優先度？何てことだ。それが優先事項であれば、"}, {"type": "subtitle", "time": 11240.67, "timestamp": "03:07:20", "text": "それから、それを優先順位の高いボックスに入れてください。"}, {"type": "subtitle", "time": 11250.469, "timestamp": "03:07:30", "text": "これ。大丈夫です。大丈夫です。それで"}, {"type": "subtitle", "time": 11253.349, "timestamp": "03:07:33", "text": "これは2回目の反復で、"}, {"type": "subtitle", "time": 11257.19, "timestamp": "03:07:37", "text": "昨日、修正版のアップデートを入手しました。私"}, {"type": "subtitle", "time": 11260.55, "timestamp": "03:07:40", "text": "当初は共有する予定だった"}, {"type": "subtitle", "time": 11263.11, "timestamp": "03:07:43", "text": "シルエット版のような一般の人々"}, {"type": "subtitle", "time": 11265.95, "timestamp": "03:07:45", "text": "それの"}, {"type": "subtitle", "time": 11269.19, "timestamp": "03:07:49", "text": "アーティストはできなかった、彼女は新人だった"}, {"type": "subtitle", "time": 11272.469, "timestamp": "03:07:52", "text": "彼女は別れなかった"}, {"type": "subtitle", "time": 11273.469, "timestamp": "03:07:53", "text": "もの"}, {"type": "subtitle", "time": 11276.469, "timestamp": "03:07:56", "text": "正しくはとても良い"}]
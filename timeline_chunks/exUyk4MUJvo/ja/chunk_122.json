[{"type": "subtitle", "time": 7321.189, "timestamp": "02:02:01", "text": "彼女にとって良くないことだと思う。うん。"}, {"type": "subtitle", "time": 7323.35, "timestamp": "02:02:03", "text": "かわいそうな彼氏が、その被害に遭ってしまった。"}, {"type": "subtitle", "time": 7327.149, "timestamp": "02:02:07", "text": "それが、私が一番悲しいことなんです。"}, {"type": "subtitle", "time": 7329.31, "timestamp": "02:02:09", "text": "うん。ああ、"}, {"type": "subtitle", "time": 7333.95, "timestamp": "02:02:13", "text": "神。うん。それが実際に起こったことです。それから"}, {"type": "subtitle", "time": 7337.99, "timestamp": "02:02:17", "text": "ええと、最近は企業による"}, {"type": "subtitle", "time": 7341.589, "timestamp": "02:02:21", "text": "YouTuberが卒業してインディーズになる"}, {"type": "subtitle", "time": 7345.109, "timestamp": "02:02:25", "text": "そしてそれらはより人気があり、より"}, {"type": "subtitle", "time": 7347.55, "timestamp": "02:02:27", "text": "インディーズで成功を収めた"}, {"type": "subtitle", "time": 7350.79, "timestamp": "02:02:30", "text": "サイドは、人気のあるものすべてです"}, {"type": "subtitle", "time": 7352.95, "timestamp": "02:02:32", "text": "彼らの企業としての側面によるものです。うん。"}, {"type": "subtitle", "time": 7356.589, "timestamp": "02:02:36", "text": "うん。うん。そして彼らが"}, {"type": "subtitle", "time": 7359.51, "timestamp": "02:02:39", "text": "私の間違いは他にもありますか？はい。はい。あなたが正しい。"}, {"type": "subtitle", "time": 7361.109, "timestamp": "02:02:41", "text": "はい。"}, {"type": "subtitle", "time": 7363.03, "timestamp": "02:02:43", "text": "そして今やそれは一種の流行のようになっている。もし"}, {"type": "subtitle", "time": 7366.189, "timestamp": "02:02:46", "text": "あなたは企業人なので、簡単に"}, {"type": "subtitle", "time": 7369.03, "timestamp": "02:02:49", "text": "より多くの聴衆と、あなたが"}, {"type": "subtitle", "time": 7372.589, "timestamp": "02:02:52", "text": "そういうインディーズっぽい感じになってきている。のように"}, {"type": "subtitle", "time": 7375.589, "timestamp": "02:02:55", "text": "ええと、警官としてはそうすべきではない"}, {"type": "subtitle", "time": 7378.709, "timestamp": "02:02:58", "text": "えっと、卒業するのかどうか明かすか、しないか"}]
[{"type": "subtitle", "time": 10383.63, "timestamp": "02:53:03", "text": "そこは、たった一部屋だった。私を信じて。それで"}, {"type": "subtitle", "time": 10387.11, "timestamp": "02:53:07", "text": "うん。だから、たとえそれが"}, {"type": "subtitle", "time": 10388.55, "timestamp": "02:53:08", "text": "悪い、あなたはインド人から来ている"}, {"type": "subtitle", "time": 10392.07, "timestamp": "02:53:12", "text": "そこには精神性が宿っている。あなたは、あなたは"}, {"type": "subtitle", "time": 10398.23, "timestamp": "02:53:18", "text": "[音楽]"}, {"type": "subtitle", "time": 10401.269, "timestamp": "02:53:21", "text": "あなたは21ヶ月間のコースを受講するのですね。"}, {"type": "subtitle", "time": 10404.87, "timestamp": "02:53:24", "text": "いや、24。あ、待って。待ってください"}, {"type": "subtitle", "time": 10407.99, "timestamp": "02:53:27", "text": "2番。うん。 21。21。うん。うん。 7月。"}, {"type": "subtitle", "time": 10410.55, "timestamp": "02:53:30", "text": "わかった。"}, {"type": "subtitle", "time": 10414.75, "timestamp": "02:53:34", "text": "うん。つまり、その合計額もあるということですね。"}, {"type": "subtitle", "time": 10419.349, "timestamp": "02:53:39", "text": "9750。見せてください。 3,950。"}, {"type": "subtitle", "time": 10428.67, "timestamp": "02:53:48", "text": "97750または2"}, {"type": "subtitle", "time": 10431.63, "timestamp": "02:53:51", "text": "ラク"}, {"type": "subtitle", "time": 10435.83, "timestamp": "02:53:55", "text": "35,150ルピーで、これは6ヶ月分の料金です。"}, {"type": "subtitle", "time": 10437.63, "timestamp": "02:53:57", "text": "右"}]
[{"type": "subtitle", "time": 6483.83, "timestamp": "01:48:03", "text": "ただ、ちゃんと勉強することを願うだけです。"}, {"type": "subtitle", "time": 6486.629, "timestamp": "01:48:06", "text": "人生のある時点で、"}, {"type": "subtitle", "time": 6489.95, "timestamp": "01:48:09", "text": "数年前のことだったと思う"}, {"type": "subtitle", "time": 6492.55, "timestamp": "01:48:12", "text": "えっと、やる気がなくなってしまった"}, {"type": "subtitle", "time": 6495.07, "timestamp": "01:48:15", "text": "趣味に集中していたので勉強はしませんでした"}, {"type": "subtitle", "time": 6498.87, "timestamp": "01:48:18", "text": "もっと、そう、私が費やしているように"}, {"type": "subtitle", "time": 6500.709, "timestamp": "01:48:20", "text": "両親はそこに行くのにたくさんのお金がある"}, {"type": "subtitle", "time": 6503.109, "timestamp": "01:48:23", "text": "私にたくさんのお金を送って、"}, {"type": "subtitle", "time": 6506.07, "timestamp": "01:48:26", "text": "せめて私をそこに送って"}, {"type": "subtitle", "time": 6508.709, "timestamp": "01:48:28", "text": "えっと、勉強。だから私は勉強が好きになりたいし"}, {"type": "subtitle", "time": 6513.189, "timestamp": "01:48:33", "text": "きちんと物を揃えて日本人に届けよう"}, {"type": "subtitle", "time": 6517.109, "timestamp": "01:48:37", "text": "ええと、少なくともJLPDN2またはN1レベルなので、"}, {"type": "subtitle", "time": 6521.59, "timestamp": "01:48:41", "text": "仕事に就くこと、そしてそう、私の目標の一つは"}, {"type": "subtitle", "time": 6523.87, "timestamp": "01:48:43", "text": "日本では"}, {"type": "subtitle", "time": 6527.91, "timestamp": "01:48:47", "text": "ええと、良い仕事に就けるように"}, {"type": "subtitle", "time": 6531.669, "timestamp": "01:48:51", "text": "そして、お金を送ってくれる"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "両親の元へ戻り、また、もしかしたら"}, {"type": "subtitle", "time": 6536.31, "timestamp": "01:48:56", "text": "彼らをそこに連れてきて、彼らも幸せになれるように"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "彼らの息子が実際に"}]
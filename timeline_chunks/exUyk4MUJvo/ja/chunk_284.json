[{"type": "subtitle", "time": 17045.59, "timestamp": "04:44:05", "text": "自分？ああ、もう倒れそうだ"}, {"type": "subtitle", "time": 17046.67, "timestamp": "04:44:06", "text": "また。"}, {"type": "subtitle", "time": 17050.27, "timestamp": "04:44:10", "text": "なぜ？なぜ？何が起こったのか"}, {"type": "subtitle", "time": 17054.11, "timestamp": "04:44:14", "text": "私の"}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "エネルギー？昔はそうだったけど、できない、できない"}, {"type": "subtitle", "time": 17060.788, "timestamp": "04:44:20", "text": "24時間配信しろよ、相棒。 N 何"}, {"type": "subtitle", "time": 17079.59, "timestamp": "04:44:39", "text": "待って、もし本当に寝てしまったらどうなるの？"}, {"type": "subtitle", "time": 17085.07, "timestamp": "04:44:45", "text": "くそ。"}, {"type": "subtitle", "time": 17087.07, "timestamp": "04:44:47", "text": "うん。"}, {"type": "subtitle", "time": 17091.59, "timestamp": "04:44:51", "text": "私がこのように話すと想像してみてください"}, {"type": "subtitle", "time": 17092.99, "timestamp": "04:44:52", "text": "マイクと"}]
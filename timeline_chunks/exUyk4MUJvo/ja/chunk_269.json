[{"type": "subtitle", "time": 16142.03, "timestamp": "04:29:02", "text": "上。私は去った"}, {"type": "subtitle", "time": 16145.71, "timestamp": "04:29:05", "text": "すべて。それは正しい。私は嫌いです"}, {"type": "subtitle", "time": 16157.51, "timestamp": "04:29:17", "text": "おい。おい。ああ、くそ。私は行きません。ああ、"}, {"type": "subtitle", "time": 16160.67, "timestamp": "04:29:20", "text": "くそ。何？どうすれば人を楽しませることができるだろうか"}, {"type": "subtitle", "time": 16163.189, "timestamp": "04:29:23", "text": "これで楽しませることができるでしょうか"}, {"type": "subtitle", "time": 16165.99, "timestamp": "04:29:25", "text": "キーボード？どうすれば楽しめるだろうか？何"}, {"type": "subtitle", "time": 16168.75, "timestamp": "04:29:28", "text": "どうすればいいでしょうか？遊び方がわからない"}, {"type": "subtitle", "time": 16177.309, "timestamp": "04:29:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16179.91, "timestamp": "04:29:39", "text": "えっと、友達が私に演奏の仕方を教えてくれている"}, {"type": "subtitle", "time": 16182.63, "timestamp": "04:29:42", "text": "ギター。ギターを弾きたい、"}, {"type": "subtitle", "time": 16185.79, "timestamp": "04:29:45", "text": "あまりにも。待って、再生"}, {"type": "subtitle", "time": 16189.11, "timestamp": "04:29:49", "text": "また。待って、私のプレイを見たい？"}, {"type": "subtitle", "time": 16190.91, "timestamp": "04:29:50", "text": "また？私はできる"}, {"type": "subtitle", "time": 16194.55, "timestamp": "04:29:54", "text": "それ。タブレット用のドライバーはインストールされていますか？私にさせて"}, {"type": "subtitle", "time": 16195.79, "timestamp": "04:29:55", "text": "チェック。"}, {"type": "subtitle", "time": 16198.67, "timestamp": "04:29:58", "text": "錠剤。ああ、デヴィ"}]
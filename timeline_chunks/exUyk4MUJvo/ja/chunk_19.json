[{"type": "subtitle", "time": 1142.87, "timestamp": "00:19:02", "text": "ショット。ナイスショット。"}, {"type": "subtitle", "time": 1164.63, "timestamp": "00:19:24", "text": "これを受け取って。私はここから出て行く。マーク2。"}, {"type": "subtitle", "time": 1167.35, "timestamp": "00:19:27", "text": "聖なる。彼がそんなことをするとは思っていなかった。"}, {"type": "subtitle", "time": 1169.11, "timestamp": "00:19:29", "text": "わかった。"}, {"type": "subtitle", "time": 1171.17, "timestamp": "00:19:31", "text": "しかし、下へ。"}, {"type": "subtitle", "time": 1177.75, "timestamp": "00:19:37", "text": "誰かの真ん中。"}]
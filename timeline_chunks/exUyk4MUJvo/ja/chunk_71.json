[{"type": "subtitle", "time": 4264.47, "timestamp": "01:11:04", "text": "どのサーバー形式がゲーム専用なのか。"}, {"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "私は素敵な靴を履いて雲の上に出かけることはありません。それは"}, {"type": "subtitle", "time": 4281.59, "timestamp": "01:11:21", "text": "神。何てことだ。彼らは毒々しくなっている。私"}, {"type": "subtitle", "time": 4284.709, "timestamp": "01:11:24", "text": "3回pingを実行しました。"}, {"type": "subtitle", "time": 4286.709, "timestamp": "01:11:26", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 4290.229, "timestamp": "01:11:30", "text": "さぁ行こう。敵を発見。"}, {"type": "subtitle", "time": 4304.63, "timestamp": "01:11:44", "text": "今回は絶対に計画しません。"}, {"type": "subtitle", "time": 4318.63, "timestamp": "01:11:58", "text": "敵を発見。料金がかかりません。"}]
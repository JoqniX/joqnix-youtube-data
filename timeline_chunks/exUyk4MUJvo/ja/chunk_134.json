[{"type": "subtitle", "time": 8043.27, "timestamp": "02:14:03", "text": "見た記憶がある。私はよくわかりません"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "私はそれをすべて読んだ。それは1つだと思います"}, {"type": "subtitle", "time": 8049.109, "timestamp": "02:14:09", "text": "私が読んだ中で最高のマンサの一つ"}, {"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "アートストーリーのように、すべてが"}, {"type": "subtitle", "time": 8059.83, "timestamp": "02:14:19", "text": "私が読んだもう一つの素晴らしいマナは"}, {"type": "subtitle", "time": 8063.109, "timestamp": "02:14:23", "text": "えーと、どれを言うかって"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "良いものもあるよ。"}, {"type": "subtitle", "time": 8072.149, "timestamp": "02:14:32", "text": "Netflixでドラマ化された"}, {"type": "subtitle", "time": 8080.79, "timestamp": "02:14:40", "text": "『弱き英雄』は良かった。えっと、他に何があったかな"}, {"type": "subtitle", "time": 8082.709, "timestamp": "02:14:42", "text": "良い？つまり、ヒーローは良かったけど、"}, {"type": "subtitle", "time": 8084.39, "timestamp": "02:14:44", "text": "それでも、つまり、それは"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "実際、良い。私は言わないだろう"}, {"type": "subtitle", "time": 8088.95, "timestamp": "02:14:48", "text": "それにとって悪いことは何もない。えっと、他に何かありますか？何"}, {"type": "subtitle", "time": 8093.2, "timestamp": "02:14:53", "text": "他に良いマナとは何ですか？"}, {"type": "subtitle", "time": 8096.069, "timestamp": "02:14:56", "text": "[音楽]"}, {"type": "subtitle", "time": 8099.35, "timestamp": "02:14:59", "text": "私はアイアンブラッドをたくさん読んだので"}]
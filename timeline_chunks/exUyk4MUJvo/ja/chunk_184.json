[{"type": "subtitle", "time": 11044.07, "timestamp": "03:04:04", "text": "将来を見据えたものと、趣味のためのもの。うん。"}, {"type": "subtitle", "time": 11046.469, "timestamp": "03:04:06", "text": "だから、4つか5つのプールをやるんだ"}, {"type": "subtitle", "time": 11049.349, "timestamp": "03:04:09", "text": "これに基づいて。趣味のプールは"}, {"type": "subtitle", "time": 11052.309, "timestamp": "03:04:12", "text": "終わりです。なぜならこれらは4つ3つだからです"}, {"type": "subtitle", "time": 11054.309, "timestamp": "03:04:14", "text": "現在検討中のプール"}, {"type": "subtitle", "time": 11057.51, "timestamp": "03:04:17", "text": "あなたの優先事項は何ですか？うん、"}, {"type": "subtitle", "time": 11059.349, "timestamp": "03:04:19", "text": "たぶんそういうことだと思う。"}, {"type": "subtitle", "time": 11061.269, "timestamp": "03:04:21", "text": "こんなこと知らなかった。私は最近"}, {"type": "subtitle", "time": 11063.75, "timestamp": "03:04:23", "text": "えっと、なんて言うんだっけ？私"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "最近お金を受け取り始めました"}, {"type": "subtitle", "time": 11067.91, "timestamp": "03:04:27", "text": "仕事とか色々あって、それが私にとって"}, {"type": "subtitle", "time": 11070.23, "timestamp": "03:04:30", "text": "どこに何を移動させたいか決めました"}, {"type": "subtitle", "time": 11072.469, "timestamp": "03:04:32", "text": "私の焦点は、あなたが決めなければならないものです"}, {"type": "subtitle", "time": 11074.469, "timestamp": "03:04:34", "text": "毎月の支出がどうなるか"}, {"type": "subtitle", "time": 11079.83, "timestamp": "03:04:39", "text": "イギリスでは私の場合、約200ポンドくらいです。"}, {"type": "subtitle", "time": 11082.309, "timestamp": "03:04:42", "text": "つまり、月々20,000ルピーです。"}, {"type": "subtitle", "time": 11084.71, "timestamp": "03:04:44", "text": "食べ物とその他すべて"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "ああ"}, {"type": "subtitle", "time": 11089.269, "timestamp": "03:04:49", "text": "日本にお住まいの方にとっては、それより少ないかもしれません。"}, {"type": "subtitle", "time": 11092.15, "timestamp": "03:04:52", "text": "円ではわからないけど、"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "例えば日本だとすると、最終的にはこうなります"}, {"type": "subtitle", "time": 11097.99, "timestamp": "03:04:57", "text": "月額5,000～8,000ドル"}]
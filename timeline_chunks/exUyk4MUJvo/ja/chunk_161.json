[{"type": "subtitle", "time": 9660.71, "timestamp": "02:41:00", "text": "チャンネルのすべてのVSを再生します"}, {"type": "subtitle", "time": 9663.27, "timestamp": "02:41:03", "text": "ランダムなタイムスタンプで。それから私が"}, {"type": "subtitle", "time": 9665.83, "timestamp": "02:41:05", "text": "このジョックマラソンを始めたとき、私は「おお」と思いました"}, {"type": "subtitle", "time": 9668.63, "timestamp": "02:41:08", "text": "それはうまくいくけど、もし私が寝ていたらどうなるの？"}, {"type": "subtitle", "time": 9671.51, "timestamp": "02:41:11", "text": "そして、もっと言葉が必要なこと"}, {"type": "subtitle", "time": 9675.27, "timestamp": "02:41:15", "text": "右？だから私はMのような人を持つつもりだった"}, {"type": "subtitle", "time": 9677.83, "timestamp": "02:41:17", "text": "ランダムなプレイリストが生成されます"}, {"type": "subtitle", "time": 9681.03, "timestamp": "02:41:21", "text": "ランダム埋め込み YouTube埋め込みリンク"}, {"type": "subtitle", "time": 9684.55, "timestamp": "02:41:24", "text": "プレイリスト。まずランダムなタイムスタンプ"}, {"type": "subtitle", "time": 9687.27, "timestamp": "02:41:27", "text": "Wはランダムなタイムスタンプから再生を開始します。"}, {"type": "subtitle", "time": 9689.99, "timestamp": "02:41:29", "text": "それから、私がプレイリストに入れたすべての動画"}, {"type": "subtitle", "time": 9693.349, "timestamp": "02:41:33", "text": "とりあえず30個入れた。だから全部"}, {"type": "subtitle", "time": 9696.63, "timestamp": "02:41:36", "text": "ランダムに選ばれた30本の動画のようにランダム化されます"}, {"type": "subtitle", "time": 9699.11, "timestamp": "02:41:39", "text": "ストリームはそういう形で存在するでしょう。それ"}, {"type": "subtitle", "time": 9701.19, "timestamp": "02:41:41", "text": "良かったんだけど、罪悪感を感じた"}, {"type": "subtitle", "time": 9703.91, "timestamp": "02:41:43", "text": "ああ、VODを再生して、"}, {"type": "subtitle", "time": 9708.469, "timestamp": "02:41:48", "text": "ストリーム。それに、私は弱いんです"}, {"type": "subtitle", "time": 9711.51, "timestamp": "02:41:51", "text": "体格的に。だから、私は病気になりやすく、"}, {"type": "subtitle", "time": 9713.59, "timestamp": "02:41:53", "text": "疲れやすい。"}, {"type": "subtitle", "time": 9715.429, "timestamp": "02:41:55", "text": "他の誰よりも強い精神力"}, {"type": "subtitle", "time": 9718.51, "timestamp": "02:41:58", "text": "私がこれまで知っている中で最
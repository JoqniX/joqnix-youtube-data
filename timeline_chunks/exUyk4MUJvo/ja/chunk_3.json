[{"type": "subtitle", "time": 183.43, "timestamp": "00:03:03", "text": "ここに行こう。火事だ。"}, {"type": "subtitle", "time": 194.35, "timestamp": "00:03:14", "text": "スパイク"}, {"type": "subtitle", "time": 201.589, "timestamp": "00:03:21", "text": "敵を発見。"}, {"type": "subtitle", "time": 221.82999999999998, "timestamp": "00:03:41", "text": "最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 229.35, "timestamp": "00:03:49", "text": "どうしてこんなことになったんだろう？私はしません"}, {"type": "subtitle", "time": 232.63, "timestamp": "00:03:52", "text": "知る。待って、電話がかかってきた。わかった、"}]
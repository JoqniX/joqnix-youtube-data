[{"type": "subtitle", "time": 8460.15, "timestamp": "02:21:00", "text": "なぜかWar Thunderと呼ばれている。"}, {"type": "subtitle", "time": 8462.469, "timestamp": "02:21:02", "text": "広告を見てそこへ行くのですか？なぜなら"}, {"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "それはまさに広告だ。それは大幅に追加された"}, {"type": "subtitle", "time": 8470.03, "timestamp": "02:21:10", "text": "うん。ああ、"}, {"type": "subtitle", "time": 8473.19, "timestamp": "02:21:13", "text": "神。ええ、私は"}, {"type": "subtitle", "time": 8475.59, "timestamp": "02:21:15", "text": "私のせいでまたやる気になったし、"}, {"type": "subtitle", "time": 8477.55, "timestamp": "02:21:17", "text": "「ああ、"}, {"type": "subtitle", "time": 8480.87, "timestamp": "02:21:20", "text": "面白いですね。そして、私が観て以来"}, {"type": "subtitle", "time": 8483.83, "timestamp": "02:21:23", "text": "トップガンを見て、「ああ、私はそうすべきだ」と思った。"}, {"type": "subtitle", "time": 8487.27, "timestamp": "02:21:27", "text": "ジェット機のように研ぎ澄ます必要もあるし、"}, {"type": "subtitle", "time": 8495.51, "timestamp": "02:21:35", "text": "うん、楽しいよ。"}, {"type": "subtitle", "time": 8498.469, "timestamp": "02:21:38", "text": "あなたはフライトシミュレーターをプレイしたことがありますか？"}, {"type": "subtitle", "time": 8500.75, "timestamp": "02:21:40", "text": "えっと、"}, {"type": "subtitle", "time": 8504.87, "timestamp": "02:21:44", "text": "まだ試していませんが、"}, {"type": "subtitle", "time": 8507.51, "timestamp": "02:21:47", "text": "それ。私は、それは多くの"}, {"type": "subtitle", "time": 8510.07, "timestamp": "02:21:50", "text": "グラフィックのことですよね？"}, {"type": "subtitle", "time": 8512.389, "timestamp": "02:21:52", "text": "うん。ええと、大丈夫です。つまり、そういうことではない"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "ああ、ノートパソコンを買うの？ああ、そうですね。私"}]
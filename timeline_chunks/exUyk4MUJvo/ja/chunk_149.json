[{"type": "subtitle", "time": 8941.91, "timestamp": "02:29:01", "text": "本当にそれほど優れたノートパソコンを手に入れるには。"}, {"type": "subtitle", "time": 8944.389, "timestamp": "02:29:04", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 8953.83, "timestamp": "02:29:13", "text": "それはどこで入手できますか"}, {"type": "subtitle", "time": 8955.83, "timestamp": "02:29:15", "text": "その筐体には軽量ノートパソコンが入るだろう"}, {"type": "subtitle", "time": 8957.349, "timestamp": "02:29:17", "text": "バッテリーの持ちが良い。あなたは"}, {"type": "subtitle", "time": 8960.79, "timestamp": "02:29:20", "text": "整理済み。しかし私はWindowsを知りません"}, {"type": "subtitle", "time": 8964.27, "timestamp": "02:29:24", "text": "それができるノートパソコンはまだありません。"}, {"type": "subtitle", "time": 8975.03, "timestamp": "02:29:35", "text": "私のおすすめはアップルです。のように"}, {"type": "subtitle", "time": 8978.79, "timestamp": "02:29:38", "text": "私はアップルが欲しい。私はしていません。"}, {"type": "subtitle", "time": 8981.83, "timestamp": "02:29:41", "text": "個人的には使っていませんが、ええと"}, {"type": "subtitle", "time": 8985.349, "timestamp": "02:29:45", "text": "いとこたちが"}, {"type": "subtitle", "time": 8987.51, "timestamp": "02:29:47", "text": "私の家に来た、あるいは彼らが必要としていたように"}, {"type": "subtitle", "time": 8989.91, "timestamp": "02:29:49", "text": "技術的なことなら何でもお手伝いします。難しくない"}, {"type": "subtitle", "time": 8994.23, "timestamp": "02:29:54", "text": "実を言うと。うん。うん。うん。"}, {"type": "subtitle", "time": 8996.309, "timestamp": "02:29:56", "text": "大丈夫です。まるで"}, {"type": "subtitle", "time": 8999.19, "timestamp": "02:29:59", "text": "わかった。"}]
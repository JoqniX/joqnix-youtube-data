[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "神。ああ、勝ったよ。何？あ、待って。彼らは"}, {"type": "subtitle", "time": 1929.19, "timestamp": "00:32:09", "text": "わかった。この警官の件は嫌いだ、なぜなら私は"}, {"type": "subtitle", "time": 1951.11, "timestamp": "00:32:31", "text": "多くの。敵に見つかった。"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "準備完了です。さぁ行こう。敵1人"}]
[{"type": "subtitle", "time": 15555.269, "timestamp": "04:19:15", "text": "はい、私です。戻ってくる。戻ってくる。"}, {"type": "subtitle", "time": 15558.03, "timestamp": "04:19:18", "text": "戻ってくる。行く。"}, {"type": "subtitle", "time": 15561.229, "timestamp": "04:19:21", "text": "行く。私は止めなければならない"}, {"type": "subtitle", "time": 15563.55, "timestamp": "04:19:23", "text": "それ。"}, {"type": "subtitle", "time": 15567.469, "timestamp": "04:19:27", "text": "こんにちは。私のチャットは"}, {"type": "subtitle", "time": 15569.389, "timestamp": "04:19:29", "text": "ストリーム。"}, {"type": "subtitle", "time": 15573.63, "timestamp": "04:19:33", "text": "やあ、君。マイナーはアップして"}, {"type": "subtitle", "time": 15578.51, "timestamp": "04:19:38", "text": "下。神様こんにちは"}, {"type": "subtitle", "time": 15584.95, "timestamp": "04:19:44", "text": "隊員。よし。これについて私はこう思う"}, {"type": "subtitle", "time": 15588.269, "timestamp": "04:19:48", "text": "フィードについて。私はそれが"}, {"type": "subtitle", "time": 15591.03, "timestamp": "04:19:51", "text": "岡戸。私が何を学ぶか分かる？おお"}]
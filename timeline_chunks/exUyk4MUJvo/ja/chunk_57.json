[{"type": "subtitle", "time": 3431.43, "timestamp": "00:57:11", "text": "よし、332に戻った。よし、だから私は"}, {"type": "subtitle", "time": 3433.27, "timestamp": "00:57:13", "text": "これをインストールしてください。しかし何か"}, {"type": "subtitle", "time": 3437.27, "timestamp": "00:57:17", "text": "フォートナイトで何が起こっているの？いいえ。そうです。"}, {"type": "subtitle", "time": 3440.069, "timestamp": "00:57:20", "text": "でも、スペースがないんです。それがGoです。"}, {"type": "subtitle", "time": 3454.63, "timestamp": "00:57:34", "text": "遊ぼう。"}, {"type": "subtitle", "time": 3459.67, "timestamp": "00:57:39", "text": "注意喚起。私の必殺技が完成しました。"}, {"type": "subtitle", "time": 3468.95, "timestamp": "00:57:48", "text": "リフトウォークは中止です。最後に残ったプレイヤー。"}]
[{"type": "subtitle", "time": 8102.629, "timestamp": "02:15:02", "text": "鉄血の復讐のハウンド"}, {"type": "subtitle", "time": 8105.109, "timestamp": "02:15:05", "text": "猟犬か何か。それを見たよ。私"}, {"type": "subtitle", "time": 8106.75, "timestamp": "02:15:06", "text": "覚えてるよ"}, {"type": "subtitle", "time": 8110.39, "timestamp": "02:15:10", "text": "私は、あなたが何を考えているか知っていると思います"}, {"type": "subtitle", "time": 8115.709, "timestamp": "02:15:15", "text": "うん。"}, {"type": "subtitle", "time": 8124.47, "timestamp": "02:15:24", "text": "ええと、それは良いと思います。"}, {"type": "subtitle", "time": 8127.99, "timestamp": "02:15:27", "text": "良い。うん、それはいいアイデアだと思うよ。"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "それはまたですが、それは、それは、"}, {"type": "subtitle", "time": 8134.709, "timestamp": "02:15:34", "text": "もし私が13歳だったら、という話に戻る"}, {"type": "subtitle", "time": 8140.229, "timestamp": "02:15:40", "text": "あるものは良いものである"}, {"type": "subtitle", "time": 8141.75, "timestamp": "02:15:41", "text": "言うべきことはたくさんあるので"}, {"type": "subtitle", "time": 8144.46, "timestamp": "02:15:44", "text": "現在では13以上。"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "[音楽]"}, {"type": "subtitle", "time": 8148.55, "timestamp": "02:15:48", "text": "ノーザンノーザンを読んだことがありますか？"}, {"type": "subtitle", "time": 8151.99, "timestamp": "02:15:51", "text": "北方の刃のマナの刃？それはそれは"}, {"type": "subtitle", "time": 8154.229, "timestamp": "02:15:54", "text": "すばらしい。名前は後でお知らせします。"}, {"type": "subtitle", "time": 8157.27, "timestamp": "02:15:57", "text": "それはとても深い物語で、"}]
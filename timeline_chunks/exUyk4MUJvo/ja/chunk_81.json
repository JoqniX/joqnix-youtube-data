[{"type": "subtitle", "time": 4864.47, "timestamp": "01:21:04", "text": "再装填中。再装填中。"}, {"type": "subtitle", "time": 4867.27, "timestamp": "01:21:07", "text": "惑星と戦う。"}, {"type": "subtitle", "time": 4879.189, "timestamp": "01:21:19", "text": "いいえ。Bはお持ちですか？なぜなら私はただ"}, {"type": "subtitle", "time": 4892.55, "timestamp": "01:21:32", "text": "敵はあと一体。最後のプレイヤー"}, {"type": "subtitle", "time": 4902.31, "timestamp": "01:21:42", "text": "待って、恋に落ちるってどういう意味？"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "あなたに恋をしたから？あなたは転んだ。あなた"}, {"type": "subtitle", "time": 4907.189, "timestamp": "01:21:47", "text": "バンドで優勝したんだよね？"}, {"type": "subtitle", "time": 4911.59, "timestamp": "01:21:51", "text": "それ。 「did you in」とはどういう意味ですか？"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "意図的に"}, {"type": "subtitle", "time": 4917.149, "timestamp": "01:21:57", "text": "私があなたのために絆創膏を買うために、"}, {"type": "subtitle", "time": 4919.83, "timestamp": "01:21:59", "text": "バカ？いつ私に支払ってくれるのですか？"}]
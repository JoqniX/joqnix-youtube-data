[{"type": "subtitle", "time": 14702.67, "timestamp": "04:05:02", "text": "[音楽]"}, {"type": "subtitle", "time": 14706.85, "timestamp": "04:05:06", "text": "でも、ああ、待って。聞こえますか？"}, {"type": "subtitle", "time": 14715.229, "timestamp": "04:05:15", "text": "[音楽]"}, {"type": "subtitle", "time": 14719.189, "timestamp": "04:05:19", "text": "これ？ああ、遅延だ。ああ、遅延だ。遅れ。待って、"}, {"type": "subtitle", "time": 14722.15, "timestamp": "04:05:22", "text": "どういう意味ですか？私は遊んでいました"}, {"type": "subtitle", "time": 14738.189, "timestamp": "04:05:38", "text": "笑うだけ"}, {"type": "subtitle", "time": 14743.63, "timestamp": "04:05:43", "text": "十分。"}, {"type": "subtitle", "time": 14747.269, "timestamp": "04:05:47", "text": "F. あのね？私は実際"}, {"type": "subtitle", "time": 14749.269, "timestamp": "04:05:49", "text": "このようなことを計画しています"}, {"type": "subtitle", "time": 14751.269, "timestamp": "04:05:51", "text": "ボタンを押し続けます"}, {"type": "subtitle", "time": 14755.189, "timestamp": "04:05:55", "text": "ボタン、変化するシーン、"}, {"type": "subtitle", "time": 14759.59, "timestamp": "04:05:59", "text": "実際にいろいろ変えていくと、"}]
[{"type": "subtitle", "time": 16863.03, "timestamp": "04:41:03", "text": "あなた自身。強くありなさい。もっと強くあれ。"}, {"type": "subtitle", "time": 16884.51, "timestamp": "04:41:24", "text": "だから、いつか私が"}, {"type": "subtitle", "time": 16888.788, "timestamp": "04:41:28", "text": "すべてが平和であることはできない、私は"}, {"type": "subtitle", "time": 16896.91, "timestamp": "04:41:36", "text": "衰退しつつあるもの。つまり、つまり"}, {"type": "subtitle", "time": 16900.23, "timestamp": "04:41:40", "text": "例えば、"}, {"type": "subtitle", "time": 16907.99, "timestamp": "04:41:47", "text": "新しいホリデーライフ世代が来ると言っている"}, {"type": "subtitle", "time": 16909.788, "timestamp": "04:41:49", "text": "2つ"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "イアンのデビューはすべて完了しました"}, {"type": "subtitle", "time": 16915.67, "timestamp": "04:41:55", "text": "最初のデビューが終わったら、その後"}, {"type": "subtitle", "time": 16917.868, "timestamp": "04:41:57", "text": "パーティーは終わった"}]
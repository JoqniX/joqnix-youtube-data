[{"type": "subtitle", "time": 15480.67, "timestamp": "04:18:00", "text": "それで、私はこの新しいアニメを見ています"}, {"type": "subtitle", "time": 15483.55, "timestamp": "04:18:03", "text": "えーとSS"}, {"type": "subtitle", "time": 15486.67, "timestamp": "04:18:06", "text": "ディナ・ゼン"}, {"type": "subtitle", "time": 15489.63, "timestamp": "04:18:09", "text": "これについて"}, {"type": "subtitle", "time": 15492.189, "timestamp": "04:18:12", "text": "1つ。これ"}, {"type": "subtitle", "time": 15505.95, "timestamp": "04:18:25", "text": "それで。おい、アートチャットを見てみろよ。何が"}, {"type": "subtitle", "time": 15508.91, "timestamp": "04:18:28", "text": "これ？何が"}, {"type": "subtitle", "time": 15512.79, "timestamp": "04:18:32", "text": "これ？あなたたちは人間ですか？あなたが見ている"}, {"type": "subtitle", "time": 15521.11, "timestamp": "04:18:41", "text": "すごい、本当にすごい。見て見て"}, {"type": "subtitle", "time": 15523.83, "timestamp": "04:18:43", "text": "ここのチャートを見てください"}]
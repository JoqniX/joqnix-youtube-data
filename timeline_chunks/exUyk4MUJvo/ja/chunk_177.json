[{"type": "subtitle", "time": 10623.03, "timestamp": "02:57:03", "text": "くそ。繰り返しますが、価格は相対的なものです。それで、"}, {"type": "subtitle", "time": 10624.79, "timestamp": "02:57:04", "text": "あなたはより少ない金額を支払っています"}, {"type": "subtitle", "time": 10627.31, "timestamp": "02:57:07", "text": "あなたの授業料。"}, {"type": "subtitle", "time": 10628.79, "timestamp": "02:57:08", "text": "[音楽]"}, {"type": "subtitle", "time": 10630.71, "timestamp": "02:57:10", "text": "料金は一切かかりません。つまり、私は支払っている"}, {"type": "subtitle", "time": 10633.51, "timestamp": "02:57:13", "text": "授業料はこれの倍額です。"}, {"type": "subtitle", "time": 10636.309, "timestamp": "02:57:16", "text": "うん。"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "つまり、全てが一致するということだ。だから、あなたは"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "心配する必要はありません。"}, {"type": "subtitle", "time": 10642.87, "timestamp": "02:57:22", "text": "でも信じて、"}, {"type": "subtitle", "time": 10644.87, "timestamp": "02:57:24", "text": "ダブルルーム。誰かと付き合わないで"}, {"type": "subtitle", "time": 10647.75, "timestamp": "02:57:27", "text": "それ以外。うん。私はしようとしています。"}, {"type": "subtitle", "time": 10657.59, "timestamp": "02:57:37", "text": "4月の新入生から私が気づいたことは"}, {"type": "subtitle", "time": 10660.309, "timestamp": "02:57:40", "text": "人々、学生、バッチ、ええと、そこに"}, {"type": "subtitle", "time": 10663.269, "timestamp": "02:57:43", "text": "12月のコースの誰か"}, {"type": "subtitle", "time": 10666.71, "timestamp": "02:57:46", "text": "すぐに参加できたグループ"}, {"type": "subtitle", "time": 10668.63, "timestamp": "02:57:48", "text": "面接も全部合格した。だから彼は"}, {"type": "subtitle", "time": 10672.71, "timestamp": "02:57:52", "text": "4月入学の人たち"}, {"type": "subtitle", "time": 10676.23, "timestamp": "02:57:56", "text": "2014年12月頃から来ているような感じ"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "バッチ、もしくは混合バッチのようなもの。"}, {"type": "subtitle", "time": 10679.469, "timestamp": "02:57:59", "text": "うん。"}]
[{"type": "subtitle", "time": 2821.03, "timestamp": "00:47:01", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 2823.27, "timestamp": "00:47:03", "text": "これで2回目の質問です。"}, {"type": "subtitle", "time": 2824.95, "timestamp": "00:47:04", "text": "あなたは当時、女の子として扱われていましたか？意思"}, {"type": "subtitle", "time": 2827.829, "timestamp": "00:47:07", "text": "女の子みたいに振る舞うの？わからない。する"}, {"type": "subtitle", "time": 2830.19, "timestamp": "00:47:10", "text": "私？私はします。待って、"}, {"type": "subtitle", "time": 2833.63, "timestamp": "00:47:13", "text": "何？私はします。何？そう思います。待って。"}, {"type": "subtitle", "time": 2851.19, "timestamp": "00:47:31", "text": "一致する結果が見つかりました。"}, {"type": "subtitle", "time": 2853.47, "timestamp": "00:47:33", "text": "何？今まで気づかなかった"}, {"type": "subtitle", "time": 2871.39, "timestamp": "00:47:51", "text": "ああ、これは書き留めておかないといけないな。"}, {"type": "subtitle", "time": 2873.99, "timestamp": "00:47:53", "text": "右？私たちは何を話し合ったのか"}, {"type": "subtitle", "time": 2876.55, "timestamp": "00:47:56", "text": "また？ニックネームを追加する機能"}, {"type": "subtitle", "time": 2878.67, "timestamp": "00:47:58", "text": "時間のユーザー"}]
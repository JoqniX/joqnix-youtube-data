[{"type": "subtitle", "time": 6240.07, "timestamp": "01:44:00", "text": "彼らは「またそこへ行くよ」と言う。"}, {"type": "subtitle", "time": 6243.27, "timestamp": "01:44:03", "text": "うん。はい。わからない。参加します 参加します"}, {"type": "subtitle", "time": 6245.35, "timestamp": "01:44:05", "text": "この新しい街はほんの数ヶ月だけ"}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "まあ、そんな感じ。だから私は旅行しなければならない"}, {"type": "subtitle", "time": 6254.47, "timestamp": "01:44:14", "text": "ええ、ビーチとか色々ありますよ。それで"}, {"type": "subtitle", "time": 6256.39, "timestamp": "01:44:16", "text": "とてもきれいです とてもきれいです"}, {"type": "subtitle", "time": 6263.35, "timestamp": "01:44:23", "text": "ええと、最近のことの一つは"}, {"type": "subtitle", "time": 6266.629, "timestamp": "01:44:26", "text": "私が手に入れるものは、ご存知の通り、"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "時々、人々は"}, {"type": "subtitle", "time": 6273.35, "timestamp": "01:44:33", "text": "えっと、他国に対して少し失礼ですね"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "人々は、あなたがインド人だから"}, {"type": "subtitle", "time": 6281.91, "timestamp": "01:44:41", "text": "差別とか、いやいや、あなた"}, {"type": "subtitle", "time": 6283.99, "timestamp": "01:44:43", "text": "日本ではその心配は無用です"}, {"type": "subtitle", "time": 6287.35, "timestamp": "01:44:47", "text": "私はそう思います、それはあなたが感じるでしょう"}, {"type": "subtitle", "time": 6291.43, "timestamp": "01:44:51", "text": "もっとあると思う"}, {"type": "subtitle", "time": 6294.149, "timestamp": "01:44:54", "text": "確かにいくつかあるが、"}, {"type": "subtitle", "time": 6296.709, "timestamp": "01:44:56", "text": "北部の北部地域では"}, {"type": "subtitle", "time": 6298.55, "timestamp": "01:44:58", "text": "韓国ではもっとそうだと思うし"}]
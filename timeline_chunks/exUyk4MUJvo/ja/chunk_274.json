[{"type": "subtitle", "time": 16470.99, "timestamp": "04:34:30", "text": "私は退屈です。くそ。私は参加できません"}, {"type": "subtitle", "time": 16472.99, "timestamp": "04:34:32", "text": "の"}, {"type": "subtitle", "time": 16477.23, "timestamp": "04:34:37", "text": "h.神。ちくしょう。ちくしょう。"}, {"type": "subtitle", "time": 16489.51, "timestamp": "04:34:49", "text": "H. 一番面白いのは君だよ。病気"}, {"type": "subtitle", "time": 16492.629, "timestamp": "04:34:52", "text": "私がよく指導している人たちをお見せします。"}, {"type": "subtitle", "time": 16494.75, "timestamp": "04:34:54", "text": "特に"}, {"type": "subtitle", "time": 16498.31, "timestamp": "04:34:58", "text": "ミッション"}]
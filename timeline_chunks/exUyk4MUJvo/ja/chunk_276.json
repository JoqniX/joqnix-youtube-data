[{"type": "subtitle", "time": 16564.629, "timestamp": "04:36:04", "text": "インタラクティブな感じ、ってことね。"}, {"type": "subtitle", "time": 16568.709, "timestamp": "04:36:08", "text": "このような。つまり、それは簡単にできるのですが、"}, {"type": "subtitle", "time": 16570.029, "timestamp": "04:36:10", "text": "の"}, {"type": "subtitle", "time": 16572.551, "timestamp": "04:36:12", "text": "明らかにやりたくない。"}, {"type": "subtitle", "time": 16579.51, "timestamp": "04:36:19", "text": "制限事項。私はこれら全てをやりたい"}, {"type": "subtitle", "time": 16587.07, "timestamp": "04:36:27", "text": "のように"}, {"type": "subtitle", "time": 16590.109, "timestamp": "04:36:30", "text": "もっとハイパー"}, {"type": "subtitle", "time": 16592.551, "timestamp": "04:36:32", "text": "相互の作用。それが私の目標です"}, {"type": "subtitle", "time": 16596.91, "timestamp": "04:36:36", "text": "ストリーム。ハイパーになりたい"}, {"type": "subtitle", "time": 16600.59, "timestamp": "04:36:40", "text": "相対性。しかし"}, {"type": "subtitle", "time": 16609.75, "timestamp": "04:36:49", "text": "いいえ。わかった。私は生きているのだろうか？くそ。私は"}]
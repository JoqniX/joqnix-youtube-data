[{"type": "subtitle", "time": 1501.77, "timestamp": "00:25:01", "text": "これはトンネル状の床ではない。いいえ、それは大きな"}, {"type": "subtitle", "time": 1503.63, "timestamp": "00:25:03", "text": "[音楽]"}, {"type": "subtitle", "time": 1507.549, "timestamp": "00:25:07", "text": "えっと、Lで始まる何か。"}, {"type": "subtitle", "time": 1510.23, "timestamp": "00:25:10", "text": "えっと、レナード。ああ、レナード。レナード。"}, {"type": "subtitle", "time": 1511.549, "timestamp": "00:25:11", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 1514.19, "timestamp": "00:25:14", "text": "レナード。私は"}, {"type": "subtitle", "time": 1518.43, "timestamp": "00:25:18", "text": "場合によってはどうなるのか疑問に思う"}, {"type": "subtitle", "time": 1521.549, "timestamp": "00:25:21", "text": "右？もしも"}, {"type": "subtitle", "time": 1525.99, "timestamp": "00:25:25", "text": "それは良いと思います。わかりません"}, {"type": "subtitle", "time": 1528.95, "timestamp": "00:25:28", "text": "レンダリングをこのように配置する"}, {"type": "subtitle", "time": 1531.029, "timestamp": "00:25:31", "text": "このレンダリングとかは"}, {"type": "subtitle", "time": 1534.75, "timestamp": "00:25:34", "text": "それ。もし私が何かを持っているなら"}, {"type": "subtitle", "time": 1538.669, "timestamp": "00:25:38", "text": "レナードのやつは"}, {"type": "subtitle", "time": 1541.07, "timestamp": "00:25:41", "text": "例として、"}, {"type": "subtitle", "time": 1543.909, "timestamp": "00:25:43", "text": "万が一レナードがいたら"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "優れたCPUとRAMを備えたインスタンス"}, {"type": "subtitle", "time": 1548.51, "timestamp": "00:25:48", "text": "そしてGPUと"}, {"type": "subtitle", "time": 1559.35, "timestamp": "00:25:59", "text": "ああ、一瞬、私のゲームは"}]
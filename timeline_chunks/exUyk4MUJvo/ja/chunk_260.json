[{"type": "subtitle", "time": 15610.67, "timestamp": "04:20:10", "text": "選挙。私は口がきけません。よし、1つ目"}, {"type": "subtitle", "time": 15613.51, "timestamp": "04:20:13", "text": "秒ええ、彼らはそこへ行ったんです。あなたが知っている、"}, {"type": "subtitle", "time": 15615.99, "timestamp": "04:20:15", "text": "人々はメガホンで「うーん」と言う"}, {"type": "subtitle", "time": 15618.55, "timestamp": "04:20:18", "text": "そして、バンの中のスピーカーは"}, {"type": "subtitle", "time": 15623.07, "timestamp": "04:20:23", "text": "ジープなどが警備している。"}, {"type": "subtitle", "time": 15627.95, "timestamp": "04:20:27", "text": "ああ、これは他のものも同じですか"}, {"type": "subtitle", "time": 15631.07, "timestamp": "04:20:31", "text": "ケララ州の州は？それはまるで"}, {"type": "subtitle", "time": 15635.349, "timestamp": "04:20:35", "text": "この人たちはジープに乗って行く。ああ、そうだね"}, {"type": "subtitle", "time": 15637.79, "timestamp": "04:20:37", "text": "あなたの最初の"}, {"type": "subtitle", "time": 15643.189, "timestamp": "04:20:43", "text": "選挙。はい。待って、私はやった、私はやった、待って、私は"}, {"type": "subtitle", "time": 15644.269, "timestamp": "04:20:44", "text": "した"}, {"type": "subtitle", "time": 15648.11, "timestamp": "04:20:48", "text": "私がしたこと。"}, {"type": "subtitle", "time": 15651.87, "timestamp": "04:20:51", "text": "それで、それは今年だったのか、それとも去年だったのか？"}]
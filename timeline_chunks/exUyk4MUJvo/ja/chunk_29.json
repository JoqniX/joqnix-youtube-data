[{"type": "subtitle", "time": 1745.95, "timestamp": "00:29:05", "text": "私はこれが気に入らない。私は好きではありません"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "この冷凍装置。私は本当にそうではない"}, {"type": "subtitle", "time": 1752.95, "timestamp": "00:29:12", "text": "気に入った。ああ、神様。私は怖いです。"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "とにかく、閉鎖してほしくないんです。"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "このバックグラウンド処理は閉じた方がいいでしょうか？私"}, {"type": "subtitle", "time": 1759.99, "timestamp": "00:29:19", "text": "これは閉じるべきでしょう。リスクを冒すべきではない。"}, {"type": "subtitle", "time": 1766.07, "timestamp": "00:29:26", "text": "もう一度レンダリングする必要がある。ディオ、私は"}, {"type": "subtitle", "time": 1787.909, "timestamp": "00:29:47", "text": "スパイクが植えられました。最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 1797.99, "timestamp": "00:29:57", "text": "冗談はもう終わりだ。お前は死んだ。"}]
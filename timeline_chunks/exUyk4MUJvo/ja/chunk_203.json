[{"type": "subtitle", "time": 12181.269, "timestamp": "03:23:01", "text": "ストリーミングが影響している場合は、"}, {"type": "subtitle", "time": 12183.51, "timestamp": "03:23:03", "text": "どこかで謝る必要がある"}, {"type": "subtitle", "time": 12188.79, "timestamp": "03:23:08", "text": "ええ、つまり私はそうじゃない、私はそうじゃない、私はそうじゃない"}, {"type": "subtitle", "time": 12191.99, "timestamp": "03:23:11", "text": "あなたに何らかの影響を与えること。"}, {"type": "subtitle", "time": 12194.95, "timestamp": "03:23:14", "text": "これはそれに影響を与えている。それは"}, {"type": "subtitle", "time": 12198.309, "timestamp": "03:23:18", "text": "今月は試験があるので影響があります"}, {"type": "subtitle", "time": 12202.07, "timestamp": "03:23:22", "text": "15日からの3週目、そして私は"}, {"type": "subtitle", "time": 12204.229, "timestamp": "03:23:24", "text": "どの科目を勉強すればいいのかわからない"}, {"type": "subtitle", "time": 12206.79, "timestamp": "03:23:26", "text": "書くべきこと、または私がすべきことは"}, {"type": "subtitle", "time": 12209.75, "timestamp": "03:23:29", "text": "試験のためにそこへ行く。"}, {"type": "subtitle", "time": 12212.87, "timestamp": "03:23:32", "text": "あなたの粘り強さには改めて感謝しますが"}, {"type": "subtitle", "time": 12214.71, "timestamp": "03:23:34", "text": "これは正気の沙汰ではない。"}, {"type": "subtitle", "time": 12216.269, "timestamp": "03:23:36", "text": "ええ、そうです"}, {"type": "subtitle", "time": 12220.63, "timestamp": "03:23:40", "text": "悪い。マヤ、私が聞いたところによると、"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "両親があなたの部屋に入ってきたことはありますか？"}, {"type": "subtitle", "time": 12230.229, "timestamp": "03:23:50", "text": "もしかしたらあなたの兄弟姉妹は"}, {"type": "subtitle", "time": 12232.469, "timestamp": "03:23:52", "text": "彼らは今までそんなことをしたことがあるか、よしよし、"}, {"type": "subtitle", "time": 12235.11, "timestamp": "03:23:55", "text": "勉強"}, {"type": "subtitle", "time": 12237.99, "timestamp": "03:23:57", "text": "つまり、私は今一人っ子なので、もし"}]
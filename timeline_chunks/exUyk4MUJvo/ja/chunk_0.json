[{"type": "subtitle", "time": 8.87, "timestamp": "00:00:08", "text": "いや、君がそう言うまでは全力で頑張ったよ。おお、"}, {"type": "subtitle", "time": 11.35, "timestamp": "00:00:11", "text": "わかった。"}, {"type": "subtitle", "time": 13.95, "timestamp": "00:00:13", "text": "私は思った"}, {"type": "subtitle", "time": 17.63, "timestamp": "00:00:17", "text": "また、何て言うんだっけ？"}, {"type": "subtitle", "time": 21.39, "timestamp": "00:00:21", "text": "いつものゲーム"}, {"type": "subtitle", "time": 24.07, "timestamp": "00:00:24", "text": "それは何と呼ぶのでしょうか？ゲームは何ですか？"}, {"type": "subtitle", "time": 34.229, "timestamp": "00:00:34", "text": "最後のプレイヤーが残る、エルデンリングみたいに"}, {"type": "subtitle", "time": 38.389, "timestamp": "00:00:38", "text": "そしてもう1つのゲームも同じようなものだったが"}, {"type": "subtitle", "time": 42.79, "timestamp": "00:00:42", "text": "そして私たちは他の人と戦わなければならなかった"}, {"type": "subtitle", "time": 44.51, "timestamp": "00:00:44", "text": "戦利品"}, {"type": "subtitle", "time": 47.029, "timestamp": "00:00:47", "text": "現実世界に戻るか、"}, {"type": "subtitle", "time": 51.27, "timestamp": "00:00:51", "text": "何か。チームエース ダークソウル。うん、"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "まあ、そんな感じですね。ボスと戦うか、"}, {"type": "subtitle", "time": 57.549, "timestamp": "00:00:57", "text": "生き物や物、"}]
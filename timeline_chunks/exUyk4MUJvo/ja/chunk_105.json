[{"type": "subtitle", "time": 6301.27, "timestamp": "01:45:01", "text": "そういう類のことです。ああ"}, {"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "なぜなら、これはこれのせいではなく、"}, {"type": "subtitle", "time": 6304.79, "timestamp": "01:45:04", "text": "それは文化のせいだよ、わかるだろ"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "文化が変わってしまったように、私は"}, {"type": "subtitle", "time": 6311.709, "timestamp": "01:45:11", "text": "配信でどう言えばいいのか分からないけど"}, {"type": "subtitle", "time": 6314.709, "timestamp": "01:45:14", "text": "それは私です。私は率直に言います"}, {"type": "subtitle", "time": 6317.59, "timestamp": "01:45:17", "text": "できるし、それがだからだと思う。"}, {"type": "subtitle", "time": 6321.35, "timestamp": "01:45:21", "text": "韓国人自身から聞いた話"}, {"type": "subtitle", "time": 6325.59, "timestamp": "01:45:25", "text": "都市部や、より都市部に近い場所では"}, {"type": "subtitle", "time": 6328.39, "timestamp": "01:45:28", "text": "現代の伝統的な韓国人は今"}, {"type": "subtitle", "time": 6330.55, "timestamp": "01:45:30", "text": "グローバルな動員が始まった、彼らは"}, {"type": "subtitle", "time": 6333.59, "timestamp": "01:45:33", "text": "受け入れ始めている。しかし、"}, {"type": "subtitle", "time": 6335.91, "timestamp": "01:45:35", "text": "より伝統的だが、彼らはまだ"}, {"type": "subtitle", "time": 6338.95, "timestamp": "01:45:38", "text": "やや色白の肌に惹かれる"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "種類、つまり、言いたいことが分かりますよね。うん。"}, {"type": "subtitle", "time": 6345.35, "timestamp": "01:45:45", "text": "日本人は、"}, {"type": "subtitle", "time": 6347.75, "timestamp": "01:45:47", "text": "あなたのようなケースでは、"}, {"type": "subtitle", "time": 6349.99, "timestamp": "01:45:49", "text": "今日では多くの人が日本を訪れ、"}, {"type": "subtitle", "time": 6351.91, "timestamp": "01:45:51", "text": "そういう類のことです。だから、彼らはかなり良い人たちだ"}, {"type": "chat", "time": 6351.944, "timestamp": "01:45:51", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yoo"}, {"type": "subtitle", "time": 6354.79, "timestamp": "01:45:54", "text": "うん、そう思う。"}, {"type": "subtitle", "time": 6357.03, "timestamp": "01:45:57", "text": "あなたは、その種の"}]
[{"type": "subtitle", "time": 7501.35, "timestamp": "02:05:01", "text": "けれど。私のお気に入りの一つです。じゃあ誰のこと？"}, {"type": "subtitle", "time": 7503.35, "timestamp": "02:05:03", "text": "お気に入りのものは何ですか？パコラと"}, {"type": "subtitle", "time": 7505.27, "timestamp": "02:05:05", "text": "全部。第三世代。だった"}, {"type": "subtitle", "time": 7508.149, "timestamp": "02:05:08", "text": "それは3世代目か4世代目ですか？えっと"}, {"type": "subtitle", "time": 7512.79, "timestamp": "02:05:12", "text": "パコラが2位だったよね？よくわからない。"}, {"type": "subtitle", "time": 7516.07, "timestamp": "02:05:16", "text": "パコラがあります。はい。ああ、そうだね"}, {"type": "subtitle", "time": 7517.709, "timestamp": "02:05:17", "text": "良い。"}, {"type": "subtitle", "time": 7521.07, "timestamp": "02:05:21", "text": "うん。私は嬉しい。パコラ。私はパコラが大好きです。"}, {"type": "subtitle", "time": 7525.27, "timestamp": "02:05:25", "text": "男。まだマインクラフト見てるの？"}, {"type": "subtitle", "time": 7526.709, "timestamp": "02:05:26", "text": "私はそうは思わない、彼らは"}, {"type": "subtitle", "time": 7529.669, "timestamp": "02:05:29", "text": "それでも、えっと、今、そんな大きなことを言うとしたら何て言うんだろう"}, {"type": "subtitle", "time": 7533.03, "timestamp": "02:05:33", "text": "現時点では？"}, {"type": "subtitle", "time": 7535.109, "timestamp": "02:05:35", "text": "ええ、たぶん言語の問題でしょうね"}, {"type": "subtitle", "time": 7536.87, "timestamp": "02:05:36", "text": "また。いつも、いつも言語の問題だ"}, {"type": "subtitle", "time": 7540.39, "timestamp": "02:05:40", "text": "日本側"}, {"type": "subtitle", "time": 7543.27, "timestamp": "02:05:43", "text": "そんなに大きくはなれないのは"}, {"type": "subtitle", "time": 7545.03, "timestamp": "02:05:45", "text": "単に言語の違いによるものだ。できます"}, {"type": "subtitle", "time": 7547.189, "timestamp": "02:05:47", "text": "あなたが望むものすべて。言語は"}, {"type": "subtitle", "time": 7549.189, "timestamp": "02:05:49", "text": "あなたを止めるために。あなたが英語圏の方なら、"}, {"type": "subtitle", "time": 7550.669, "timestamp": "02:05:50", "text": "あなたは間違いなくより多くのことをカバーしています"}, {"type": "subtitle", "time": 7557.189, "timestamp": "02:05:57", "text": "ああ、まあ、確かにそうですね。 YouTuber"}, {"type": "subtitle", "time": 7559.109, "timestamp": "02:05:59", "text": "側は依然として好調だ。たぶん"}]
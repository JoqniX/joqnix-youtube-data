[{"type": "subtitle", "time": 3721.789, "timestamp": "01:02:01", "text": "クロスオーバー。その通り。そこのあなた。えっと"}, {"type": "subtitle", "time": 3741.91, "timestamp": "01:02:21", "text": "私は死んだ。"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "うん、待って。これは専門家のサインですよね？"}, {"type": "subtitle", "time": 3757.829, "timestamp": "01:02:37", "text": "正しい。そうそう。うん。元気ですか"}, {"type": "subtitle", "time": 3760.309, "timestamp": "01:02:40", "text": "何をしているの？専門家のサイン。うん。うん。うん。私"}, {"type": "subtitle", "time": 3763.19, "timestamp": "01:02:43", "text": "忘れた。前回あなたが来たときのように"}, {"type": "subtitle", "time": 3765.27, "timestamp": "01:02:45", "text": "それはいつのことだった？"}, {"type": "subtitle", "time": 3767.43, "timestamp": "01:02:47", "text": "あなたは「うん」って感じで来た。長い年月が経ちました"}, {"type": "subtitle", "time": 3770.71, "timestamp": "01:02:50", "text": "時間。うん。うん。うん。前回と同じように"}, {"type": "subtitle", "time": 3772.829, "timestamp": "01:02:52", "text": "12月。"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "彼が鍵について尋ねたとき、"}, {"type": "subtitle", "time": 3778.87, "timestamp": "01:02:58", "text": "配信をしているさくらとその家族。私は"}]
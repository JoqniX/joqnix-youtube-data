[{"type": "subtitle", "time": 15722.87, "timestamp": "04:22:02", "text": "配信がうまくいかなくて本当にごめんなさい"}, {"type": "subtitle", "time": 15725.269, "timestamp": "04:22:05", "text": "大きな、ネガティブな"}, {"type": "subtitle", "time": 15728.55, "timestamp": "04:22:08", "text": "途中で行くが、次回は行かない"}, {"type": "subtitle", "time": 15732.63, "timestamp": "04:22:12", "text": "再び起こる。こんにちは、"}, {"type": "subtitle", "time": 15735.87, "timestamp": "04:22:15", "text": "次回は、より非活動的かつ活動的になります。"}, {"type": "subtitle", "time": 15737.389, "timestamp": "04:22:17", "text": "訪問。"}, {"type": "subtitle", "time": 15747.349, "timestamp": "04:22:27", "text": "ポジティブ。ここにヘッドがあります"}, {"type": "subtitle", "time": 15750.349, "timestamp": "04:22:30", "text": "あなたが行く理由とミナのためのパッド"}]
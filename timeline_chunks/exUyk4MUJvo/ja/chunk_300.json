[{"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "ああ、すみません。でも、ええ、私は「うーん」って感じでした"}, {"type": "subtitle", "time": 18005.99, "timestamp": "05:00:05", "text": "いろいろと修理しているところです。技術的な問題"}, {"type": "subtitle", "time": 18007.51, "timestamp": "05:00:07", "text": "今。"}, {"type": "subtitle", "time": 18009.91, "timestamp": "05:00:09", "text": "たくさんのアップデートや変更がありました。私 私"}, {"type": "subtitle", "time": 18017.788, "timestamp": "05:00:17", "text": "1と2.5"}, {"type": "subtitle", "time": 18020.39, "timestamp": "05:00:20", "text": "たぶん、日でしょうね。そして、とてもたくさんあります"}, {"type": "subtitle", "time": 18024.27, "timestamp": "05:00:24", "text": "既にアップデート済みです。ああ、それは"}, {"type": "subtitle", "time": 18026.868, "timestamp": "05:00:26", "text": "2月。ええ、皆さんお元気ですか？"}, {"type": "subtitle", "time": 18030.708, "timestamp": "05:00:30", "text": "今夜は何をしますか？こんにちは。こんにちは。ゆっくり休んでください"}, {"type": "subtitle", "time": 18033.708, "timestamp": "05:00:33", "text": "火曜日の。火曜日おめでとうございます。"}, {"type": "subtitle", "time": 18037.67, "timestamp": "05:00:37", "text": "うん。ということで、今日は"}, {"type": "subtitle", "time": 18040.788, "timestamp": "05:00:40", "text": "Enlistedというゲーム。可能性が高い"}, {"type": "subtitle", "time": 18045.19, "timestamp": "05:00:45", "text": "ええと、これはワールド・オブ・ウォーをベースにしたゲームです。それ"}, {"type": "subtitle", "time": 18047.67, "timestamp": "05:00:47", "text": "楽しいゲームです。そして私は良いものを見ていました"}, {"type": "subtitle", "time": 18050.628, "timestamp": "05:00:50", "text": "私の友人である吸血鬼の医者が"}, {"type": "subtitle", "time": 18052.868, "timestamp": "05:00:52", "text": "ゲーム。だから私は「ああ、なんてことだ、"}, {"type": "subtitle", "time": 18055.15, "timestamp": "05:00:55", "text": "このゲームはピューピューで楽しくてワールド"}, {"type": "subtitle", "time": 18056.83, "timestamp": "05:00:56", "text": "戦争"}, {"type": "subtitle", "time": 18059.03, "timestamp": "05:00:59", "text": "戦場。ああ、これは"}]
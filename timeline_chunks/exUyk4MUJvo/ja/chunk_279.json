[{"type": "subtitle", "time": 16741.23, "timestamp": "04:39:01", "text": "彼が使うもの"}, {"type": "subtitle", "time": 16744.75, "timestamp": "04:39:04", "text": "コントロールとは、押すボタンのことです。"}, {"type": "subtitle", "time": 16749.23, "timestamp": "04:39:09", "text": "キーボードで押すようなボタン"}, {"type": "subtitle", "time": 16752.07, "timestamp": "04:39:12", "text": "ボタン。うん。そしてもう片方は"}, {"type": "subtitle", "time": 16754.31, "timestamp": "04:39:14", "text": "こんなコードメーカーにもなりたい"}, {"type": "subtitle", "time": 16760.59, "timestamp": "04:39:20", "text": "サコサンは、"}, {"type": "subtitle", "time": 16778.23, "timestamp": "04:39:38", "text": "うん。もう5時25分だ。えっと、私は"}, {"type": "subtitle", "time": 16787.83, "timestamp": "04:39:47", "text": "また、私がいつも行くという事実"}, {"type": "subtitle", "time": 16790.55, "timestamp": "04:39:50", "text": "私はこれをします、私はこれをします"}, {"type": "subtitle", "time": 16791.868, "timestamp": "04:39:51", "text": "そしてそれは"}, {"type": "subtitle", "time": 16797.11, "timestamp": "04:39:57", "text": "しかし、それには時間がかかる。だから"}]
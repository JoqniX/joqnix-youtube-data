[{"type": "subtitle", "time": 7861.669, "timestamp": "02:11:01", "text": "ステージ。すぐに彼らは"}, {"type": "subtitle", "time": 7864.149, "timestamp": "02:11:04", "text": "それを発展させれば、人々が"}, {"type": "subtitle", "time": 7865.83, "timestamp": "02:11:05", "text": "誰が彼らをそのことで非難するだろうか。"}, {"type": "subtitle", "time": 7868.79, "timestamp": "02:11:08", "text": "それで、"}, {"type": "subtitle", "time": 7872.87, "timestamp": "02:11:12", "text": "もっと日本のYouTuberの動画を見なきゃ。"}, {"type": "subtitle", "time": 7875.83, "timestamp": "02:11:15", "text": "私はたくさんのものを逃している"}, {"type": "subtitle", "time": 7878.709, "timestamp": "02:11:18", "text": "日本のユーチューバーたち。わからない"}, {"type": "subtitle", "time": 7881.99, "timestamp": "02:11:21", "text": "たくさんいるけど、私は実際に"}, {"type": "subtitle", "time": 7884.52, "timestamp": "02:11:24", "text": "YouTubeの日本語版は絶対に見ないで。"}, {"type": "subtitle", "time": 7886.629, "timestamp": "02:11:26", "text": "[音楽]"}, {"type": "subtitle", "time": 7890.51, "timestamp": "02:11:30", "text": "彼を知っているか、もしくは何らかの知り合いだ。男は"}, {"type": "subtitle", "time": 7894.87, "timestamp": "02:11:34", "text": "サングラス付きのメガネなど。"}, {"type": "subtitle", "time": 7896.55, "timestamp": "02:11:36", "text": "日本側についてはよくわかりませんが"}, {"type": "subtitle", "time": 7898.87, "timestamp": "02:11:38", "text": "YouTube なぜなら私は決して、私は決して"}, {"type": "subtitle", "time": 7900.47, "timestamp": "02:11:40", "text": "それを深く掘り下げた。私は知っている"}, {"type": "subtitle", "time": 7902.709, "timestamp": "02:11:42", "text": "ホロライブとか日本のもの"}, {"type": "subtitle", "time": 7904.39, "timestamp": "02:11:44", "text": "YouTuberは日本の側で"}, {"type": "subtitle", "time": 7906.229, "timestamp": "02:11:46", "text": "YouTube。"}, {"type": "subtitle", "time": 7909.83, "timestamp": "02:11:49", "text": "くそ。でも、その後はまあ、うーん"}, {"type": "subtitle", "time": 7911.79, "timestamp": "02:11:51", "text": "流れ落ちて"}, {"type": "subtitle", "time": 7914.47, "timestamp": "02:11:54", "text": "アニメは日本の側だったと思う"}, {"type": "subtitle", "time": 7915.48, "timestamp": "02:11:55", "text": "自分。"}, {"type": "
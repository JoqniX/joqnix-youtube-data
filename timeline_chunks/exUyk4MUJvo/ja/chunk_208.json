[{"type": "subtitle", "time": 12480.309, "timestamp": "03:28:00", "text": "あなたはインドに戻ることはできません。夏"}, {"type": "subtitle", "time": 12482.07, "timestamp": "03:28:02", "text": "条件は間違いなく戻ることができます"}, {"type": "subtitle", "time": 12483.91, "timestamp": "03:28:03", "text": "夏季学期。うん。うん。夏季学期。"}, {"type": "subtitle", "time": 12487.229, "timestamp": "03:28:07", "text": "はい。はい。うーん、うーんって考えてたんだけど"}, {"type": "subtitle", "time": 12489.63, "timestamp": "03:28:09", "text": "あなたが"}, {"type": "subtitle", "time": 12493.51, "timestamp": "03:28:13", "text": "だから私はこう考えていたんだ"}, {"type": "subtitle", "time": 12496.389, "timestamp": "03:28:16", "text": "試験は年に2回、6月に行われます。"}, {"type": "subtitle", "time": 12499.03, "timestamp": "03:28:19", "text": "そして12月だったので、もし"}, {"type": "subtitle", "time": 12501.91, "timestamp": "03:28:21", "text": "学校の夏休みとか色々"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "日本に滞在すれば、インドに戻ることができます"}, {"type": "subtitle", "time": 12507.51, "timestamp": "03:28:27", "text": "そして試験などを正しく書くか、"}, {"type": "subtitle", "time": 12510.15, "timestamp": "03:28:30", "text": "彼らは、私は彼らが"}, {"type": "subtitle", "time": 12513.83, "timestamp": "03:28:33", "text": "IGNUの国際的なイベントがあるので"}, {"type": "subtitle", "time": 12515.11, "timestamp": "03:28:35", "text": "彼らがそれを持っているかどうかはわかりません"}, {"type": "subtitle", "time": 12517.269, "timestamp": "03:28:37", "text": "日本だが、もしあれば、それは"}, {"type": "subtitle", "time": 12519.99, "timestamp": "03:28:39", "text": "多く。だから、試験を受けることができる"}, {"type": "subtitle", "time": 12522.07, "timestamp": "03:28:42", "text": "オンラインで済ませてしまおう、"}, {"type": "subtitle", "time": 12524.229, "timestamp": "03:28:44", "text": "右？ここへ来るよりも"}, {"type": "subtitle", "time": 12526.469, "timestamp": "03:28:46", "text": "行ったり来たりして、"}, {"type": "subtitle", "time": 12528.55, "timestamp": "03:28:48", "text": "高価ですよね？航空券に関して"}, {"type": "subtitle", "time": 12531.91, "timestamp": "03:28:51", "text": "そして全て。だから、私はそれを望んでいない。"}, {"type": "subtitle", "time": 12533.91, "timestamp": "03:28:53", "text": "うん。うん、納得だ。うん、そうだね"}, {"type": "subtitle", "time": 12536.07, "timestamp": "03:28:56", "text": "半年ごとに戻ってきたい、または"}]
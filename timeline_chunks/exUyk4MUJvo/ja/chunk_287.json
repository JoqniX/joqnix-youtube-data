[{"type": "subtitle", "time": 17227.83, "timestamp": "04:47:07", "text": "メモリ。それは私が知っているほぼ全員です"}, {"type": "subtitle", "time": 17237.19, "timestamp": "04:47:17", "text": "今日。本当に、本当に感謝しています。"}, {"type": "subtitle", "time": 17240.788, "timestamp": "04:47:20", "text": "えっと、この声を持っていて、"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "理由は気にしないけど、疲れてるけど、それでも私は"}, {"type": "subtitle", "time": 17246.91, "timestamp": "04:47:26", "text": "本当に本当に"}, {"type": "subtitle", "time": 17251.67, "timestamp": "04:47:31", "text": "皆さんが今日来てくださったことを本当に嬉しく思います。"}, {"type": "subtitle", "time": 17257.628, "timestamp": "04:47:37", "text": "たとえ退屈だったとしても、たとえ"}, {"type": "subtitle", "time": 17260.31, "timestamp": "04:47:40", "text": "楽しかった、笑った、"}, {"type": "subtitle", "time": 17264.35, "timestamp": "04:47:44", "text": "彼が笑った、彼は広げた、君は広げた"}, {"type": "subtitle", "time": 17272.35, "timestamp": "04:47:52", "text": "私にとって忘れないで"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "前向きに、強くあり続け、"}, {"type": "subtitle", "time": 17276.43, "timestamp": "04:47:56", "text": "最高のあなた"}, {"type": "subtitle", "time": 17279.59, "timestamp": "04:47:59", "text": "人生がどんなに辛くても、"}]
[{"type": "subtitle", "time": 8821.91, "timestamp": "02:27:01", "text": "ヨガ。それは何という名前ですか？レノボ"}, {"type": "chat", "time": 8823.996, "timestamp": "02:27:03", "author": "@AsAnOtaku", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ml9qi1LKsmPGIy_j3CcCCPBXWFNxXjZJ9lViNDhl_52A=s64-c-k-c0x00ffffff-no-rj", "message": "legion ?"}, {"type": "subtitle", "time": 8824.469, "timestamp": "02:27:04", "text": "プライム会員かゲーマー会員か。それは良い"}, {"type": "subtitle", "time": 8827.83, "timestamp": "02:27:07", "text": "1つ。 Lenovo Legionはそこにあります。ああ、レギオン。"}, {"type": "subtitle", "time": 8830.15, "timestamp": "02:27:10", "text": "ああ、それ忘れてた。それはとても"}, {"type": "subtitle", "time": 8832.67, "timestamp": "02:27:12", "text": "いいぞ。ええ、レノボですね。私ならGoProを選びますね。"}, {"type": "subtitle", "time": 8839.51, "timestamp": "02:27:19", "text": "レギオン。うん。わからない。私はただ"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "これをグーグルで検索する。私はあまり知らない"}, {"type": "subtitle", "time": 8844.07, "timestamp": "02:27:24", "text": "まさにその通り。実際に検索する必要がある"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "うん。うん。つまり、あなたは"}, {"type": "chat", "time": 8855.604, "timestamp": "02:27:35", "author": "@AsAnOtaku", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ml9qi1LKsmPGIy_j3CcCCPBXWFNxXjZJ9lViNDhl_52A=s64-c-k-c0x00ffffff-no-rj", "message": "Legion Y-500 series pog "}, {"type": "subtitle", "time": 8857.83, "timestamp": "02:27:37", "text": "日本に定住するつもりですか？最終的に"}, {"type": "subtitle", "time": 8861.75, "timestamp": "02:27:41", "text": "私は24年目が好きではない"}, {"type": "subtitle", "time": 8863.99, "timestamp": "02:27:43", "text": "数ヶ月。つまり、1年9ヶ月で"}, {"type": "subtitle", "time": 8866.95, "timestamp": "02:27:46", "text": "語学コース。そうすれば私は"}, {"type": "subtitle", "time": 8869.03, "timestamp": "02:27:49", "text": "例えば、運転免許証を申請するなど"}, {"type": "subtitle", "time": 8871.91, "timestamp": "02:27:51", "text": "すべては学校のおかげで"}, {"type": "subtitle", "time": 8875.27, "timestamp": "02:27:55", "text": "時間を無駄にすることを許してくれない"}, {"type": "subtitle", "time": 8878.95, "timestamp": "02:27:58", "text": "運転免許証の手続きとか、そういうこと。"}]
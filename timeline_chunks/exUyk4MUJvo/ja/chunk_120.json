[{"type": "subtitle", "time": 7201.589, "timestamp": "02:00:01", "text": "そして、そういうこと全部、そして私は思う、えーと"}, {"type": "subtitle", "time": 7203.99, "timestamp": "02:00:03", "text": "彼女はアーティストが出てきたと思う"}, {"type": "subtitle", "time": 7206.39, "timestamp": "02:00:06", "text": "そうやって一般の人々は"}, {"type": "subtitle", "time": 7208.79, "timestamp": "02:00:08", "text": "これと"}, {"type": "subtitle", "time": 7212.27, "timestamp": "02:00:12", "text": "ええ、それで、何と呼ぶんですか？"}, {"type": "subtitle", "time": 7215.669, "timestamp": "02:00:15", "text": "えっと、他に何かありましたっけ？うん。それから、えーと"}, {"type": "subtitle", "time": 7218.79, "timestamp": "02:00:18", "text": "ナナ以来の彼女の友達全員"}, {"type": "subtitle", "time": 7223.03, "timestamp": "02:00:23", "text": "Google DockyをGoogleドキュメントに変換しました。だからお辞儀をしよう"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "ヴェールは、"}, {"type": "subtitle", "time": 7228.229, "timestamp": "02:00:28", "text": "彼女の親友が彼女にそれをした"}, {"type": "subtitle", "time": 7230.229, "timestamp": "02:00:30", "text": "彼女のブランドやその他すべてに影響するから、"}, {"type": "subtitle", "time": 7233.43, "timestamp": "02:00:33", "text": "とても競争心が強くて、いろいろとね。そして"}, {"type": "subtitle", "time": 7237.03, "timestamp": "02:00:37", "text": "ええと、シルバーホエールも関わっていました。"}, {"type": "subtitle", "time": 7241.51, "timestamp": "02:00:41", "text": "彼女も影響を受けた、なぜなら彼女も"}, {"type": "subtitle", "time": 7244.47, "timestamp": "02:00:44", "text": "誕生日用の衣装か何かを持っていた"}, {"type": "subtitle", "time": 7246.87, "timestamp": "02:00:46", "text": "作られたのは"}, {"type": "subtitle", "time": 7249.189, "timestamp": "02:00:49", "text": "アーティストによって行われた"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "キャンセルとか色々あって、彼らはそうしないから"}, {"type": "subtitle", "time": 7254.629, "timestamp": "02:00:54", "text": "本当の理由がわかった"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "アーティストが拒否したり、似たようなことをしたり"}]
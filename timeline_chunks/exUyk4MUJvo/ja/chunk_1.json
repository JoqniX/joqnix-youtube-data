[{"type": "subtitle", "time": 60.59, "timestamp": "00:01:00", "text": "ダンジョンと"}, {"type": "subtitle", "time": 64.63, "timestamp": "00:01:04", "text": "戦利品、装備の強化、タスクの実行、"}, {"type": "subtitle", "time": 66.99, "timestamp": "00:01:06", "text": "と話している"}, {"type": "subtitle", "time": 69.789, "timestamp": "00:01:09", "text": "商人、それらすべて"}, {"type": "subtitle", "time": 79.149, "timestamp": "00:01:19", "text": "金色で。どういう意味だよ、お嬢ちゃん？その"}, {"type": "subtitle", "time": 82.91, "timestamp": "00:01:22", "text": "悪い。あなたは誰ですか？"}, {"type": "subtitle", "time": 86.95, "timestamp": "00:01:26", "text": "敵を発見。私はここから出て行く。"}, {"type": "subtitle", "time": 90.149, "timestamp": "00:01:30", "text": "左クリックができません。真ん中に行けない"}, {"type": "subtitle", "time": 92.39, "timestamp": "00:01:32", "text": "クリック。"}, {"type": "subtitle", "time": 103.91, "timestamp": "00:01:43", "text": "私はcomから離れることができません。"}, {"type": "subtitle", "time": 106.95, "timestamp": "00:01:46", "text": "敵はあと一体。わかった。"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "もう行かなきゃ。"}, {"type": "subtitle", "time": 112.95, "timestamp": "00:01:52", "text": "そして、私たちの認識は明確です。料金がかかりません。"}, {"type": "subtitle", "time": 114.71000000000001, "timestamp": "00:01:54", "text": "右クリックが時々できないのはなぜですか？"}, {"type": "subtitle", "time": 117.99000000000001, "timestamp": "00:01:57", "text": "働く？ああ、神様。スナイパー。いいえ、私の右"}]
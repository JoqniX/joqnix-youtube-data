[{"type": "subtitle", "time": 3361.19, "timestamp": "00:56:01", "text": "フォートナイト。彼らはフォートナイトをインストールしない"}, {"type": "subtitle", "time": 3363.349, "timestamp": "00:56:03", "text": "それから。"}, {"type": "subtitle", "time": 3365.51, "timestamp": "00:56:05", "text": "行け！行け！行け。"}, {"type": "subtitle", "time": 3367.0, "timestamp": "00:56:07", "text": "目に気をつけて。"}, {"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "[拍手]"}, {"type": "subtitle", "time": 3370.71, "timestamp": "00:56:10", "text": "このチャンネルの唯一の伝統は、"}, {"type": "subtitle", "time": 3373.15, "timestamp": "00:56:13", "text": "新シーズンが始まったらフォートナイトをプレイしよう"}, {"type": "subtitle", "time": 3376.549, "timestamp": "00:56:16", "text": "外。それでおしまい。"}, {"type": "subtitle", "time": 3411.67, "timestamp": "00:56:51", "text": "最後に残ったプレイヤー。おお。"}]
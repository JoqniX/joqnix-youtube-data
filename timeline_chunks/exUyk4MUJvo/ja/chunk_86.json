[{"type": "subtitle", "time": 5160.03, "timestamp": "01:26:00", "text": "敵はあと一体。私は思いつくのは"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "別れのセリフ。あなたの別れはどういう意味ですか？"}, {"type": "subtitle", "time": 5176.55, "timestamp": "01:26:16", "text": "マッチポイント。ナンパのセリフって本当に"}, {"type": "subtitle", "time": 5178.51, "timestamp": "01:26:18", "text": "だから私はしない"}, {"type": "subtitle", "time": 5181.51, "timestamp": "01:26:21", "text": "知る。のように"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "私はここから出て行く。そうですね、"}, {"type": "subtitle", "time": 5187.43, "timestamp": "01:26:27", "text": "ナンパのセリフについて学んだばかり"}, {"type": "subtitle", "time": 5190.75, "timestamp": "01:26:30", "text": "最近始めたときのように"}, {"type": "subtitle", "time": 5198.43, "timestamp": "01:26:38", "text": "これは特定のバグです"}, {"type": "subtitle", "time": 5201.47, "timestamp": "01:26:41", "text": "それ。 「えっ、何これ？」"}, {"type": "subtitle", "time": 5203.91, "timestamp": "01:26:43", "text": "これ？ほら、私がそれを知った後"}, {"type": "subtitle", "time": 5205.149, "timestamp": "01:26:45", "text": "その"}, {"type": "subtitle", "time": 5207.55, "timestamp": "01:26:47", "text": "えっと"}, {"type": "subtitle", "time": 5210.47, "timestamp": "01:26:50", "text": "このように使われ、これが押す、私は"}, {"type": "subtitle", "time": 5212.03, "timestamp": "01:26:52", "text": "「ああ、私の"}, {"type": "subtitle", "time": 5214.47, "timestamp": "01:26:54", "text": "神よ。」それから私は"}, {"type": "subtitle", "time": 5217.51, "timestamp": "01:26:57", "text": "意識がはっきりしたので、"}]
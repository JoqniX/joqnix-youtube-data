[{"type": "subtitle", "time": 10861.67, "timestamp": "03:01:01", "text": "24ヶ月とか21ヶ月とか、そうですね。それで、"}, {"type": "subtitle", "time": 10865.03, "timestamp": "03:01:05", "text": "私は、彼らは全体的に"}, {"type": "subtitle", "time": 10866.95, "timestamp": "03:01:06", "text": "サッカー場、"}, {"type": "subtitle", "time": 10868.79, "timestamp": "03:01:08", "text": "シェアハウスとかそういう類のもの？どのように"}, {"type": "subtitle", "time": 10870.71, "timestamp": "03:01:10", "text": "この作品？"}, {"type": "subtitle", "time": 10872.389, "timestamp": "03:01:12", "text": "つまり、彼らは持っているかもしれないし、持っているかもしれない"}, {"type": "subtitle", "time": 10874.23, "timestamp": "03:01:14", "text": "えっと、なんていう名前ですか？違う"}, {"type": "subtitle", "time": 10876.07, "timestamp": "03:01:16", "text": "彼らが貸し出す物件"}, {"type": "subtitle", "time": 10877.59, "timestamp": "03:01:17", "text": "学生たち。"}, {"type": "subtitle", "time": 10879.19, "timestamp": "03:01:19", "text": "おお、"}, {"type": "subtitle", "time": 10881.19, "timestamp": "03:01:21", "text": "うん。イギリスでは、彼らは"}, {"type": "subtitle", "time": 10883.67, "timestamp": "03:01:23", "text": "文字通り村があるのですが、"}, {"type": "subtitle", "time": 10885.83, "timestamp": "03:01:25", "text": "学生村とすべての"}, {"type": "subtitle", "time": 10889.59, "timestamp": "03:01:29", "text": "学生たちはそこに住むことになる。ああ"}, {"type": "subtitle", "time": 10891.429, "timestamp": "03:01:31", "text": "うん。私が以前住んでいた場所では"}, {"type": "subtitle", "time": 10894.15, "timestamp": "03:01:34", "text": "これを呼ぶと、私は以前、"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "そこは学生ばかりが住む複合施設だった。"}, {"type": "subtitle", "time": 10899.349, "timestamp": "03:01:39", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 10900.95, "timestamp": "03:01:40", "text": "うん。異なる建物のように、"}, {"type": "subtitle", "time": 10903.349, "timestamp": "03:01:43", "text": "異なる家々、その間の道路、そして"}, {"type": "subtitle", "time": 10910.87, "timestamp": "03:01:50", "text": "おお。だからそういうことなんです、そういうことです、そして私は"}, {"type": "subtitle", "time": 10913.51, "timestamp": "03:01:53", "text": "6ヶ月だからだと思う"}, {"type": "subtitle", "time": 10915.269, "timestamp": "03:01:55", "text": "あなたは自分がどこにいるのか理解するでしょう"}, {"type": "subtitle", "time": 10917.91, "timestamp": "03:01:57", "text": "いる場所。いつでも外に出て探すことができます"}]
[{"type": "subtitle", "time": 2584.87, "timestamp": "00:43:04", "text": "ええ、例えば誰かが同じ"}, {"type": "subtitle", "time": 2587.23, "timestamp": "00:43:07", "text": "ユーザー名を2つ"}, {"type": "subtitle", "time": 2590.95, "timestamp": "00:43:10", "text": "シャンボ・ボブとかいうユーザー。"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "それは2人が持っている名前です"}, {"type": "subtitle", "time": 2596.23, "timestamp": "00:43:16", "text": "YouTubeの表示名。"}, {"type": "subtitle", "time": 2599.349, "timestamp": "00:43:19", "text": "だから私ができることは、そのうちの1つを作ることです"}, {"type": "subtitle", "time": 2603.95, "timestamp": "00:43:23", "text": "セットをセットのニックネームのようにする"}, {"type": "subtitle", "time": 2608.63, "timestamp": "00:43:28", "text": "それはまるでブラシ爆弾1号のようなものだ"}, {"type": "subtitle", "time": 2610.63, "timestamp": "00:43:30", "text": "置く"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "いいえ。うん。爆弾2号で十分だ"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "別のニックネーム。わかった。もちろん。それ以来、"}, {"type": "subtitle", "time": 2626.109, "timestamp": "00:43:46", "text": "は"}, {"type": "subtitle", "time": 2630.15, "timestamp": "00:43:50", "text": "ファイルにログを記録する設定は"}, {"type": "subtitle", "time": 2634.47, "timestamp": "00:43:54", "text": "保存して、チャットがいつでも"}, {"type": "subtitle", "time": 2636.87, "timestamp": "00:43:56", "text": "まあ、初めて彼らは"}, {"type": "subtitle", "time": 2639.99, "timestamp": "00:43:59", "text": "通常はこのように歓迎されますが、"}]
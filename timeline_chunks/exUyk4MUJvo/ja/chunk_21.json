[{"type": "subtitle", "time": 1279.31, "timestamp": "00:21:19", "text": "今日は設定することを忘れていました"}, {"type": "subtitle", "time": 1283.99, "timestamp": "00:21:23", "text": "忘れてしまったアップメテオsp。一致するものが見つかりました"}, {"type": "subtitle", "time": 1301.63, "timestamp": "00:21:41", "text": "では、積み込みが終わるまで、何かした方がいいでしょうか？"}, {"type": "subtitle", "time": 1304.95, "timestamp": "00:21:44", "text": "ユーザー名に関するもの"}, {"type": "subtitle", "time": 1308.029, "timestamp": "00:21:48", "text": "それとも、そうすべきではないのだろうか？私はしません"}, {"type": "subtitle", "time": 1311.43, "timestamp": "00:21:51", "text": "知る。ああ、わかった。やるべきか、それとも"}, {"type": "subtitle", "time": 1318.549, "timestamp": "00:21:58", "text": "知る。でも、これについては考えなければならない"}]
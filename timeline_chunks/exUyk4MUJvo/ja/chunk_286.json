[{"type": "subtitle", "time": 17166.19, "timestamp": "04:46:06", "text": "それ。私"}, {"type": "subtitle", "time": 17168.91, "timestamp": "04:46:08", "text": "終わりにします"}, {"type": "subtitle", "time": 17172.07, "timestamp": "04:46:12", "text": "それ。もう終わりにします。"}, {"type": "subtitle", "time": 17174.51, "timestamp": "04:46:14", "text": "だから一度"}, {"type": "subtitle", "time": 17179.11, "timestamp": "04:46:19", "text": "特に、そしてあなたたち二人は"}, {"type": "subtitle", "time": 17181.948, "timestamp": "04:46:21", "text": "チャットで非常に活発に活動している。"}, {"type": "subtitle", "time": 17185.07, "timestamp": "04:46:25", "text": "さくらさん、DJ、"}, {"type": "subtitle", "time": 17188.91, "timestamp": "04:46:28", "text": "ヒカリサン、赤紙S、ブルー"}, {"type": "subtitle", "time": 17192.55, "timestamp": "04:46:32", "text": "猫、スキャンドレックス、"}, {"type": "subtitle", "time": 17193.948, "timestamp": "04:46:33", "text": "えーと、ミア・カーム、"}, {"type": "subtitle", "time": 17195.47, "timestamp": "04:46:35", "text": "マクソン、"}, {"type": "subtitle", "time": 17201.19, "timestamp": "04:46:41", "text": "Honeyan、TGST、そして誰？そして誰が"}, {"type": "subtitle", "time": 17203.91, "timestamp": "04:46:43", "text": "それ以外？私はすべての名前を言ったと言いました"}, {"type": "subtitle", "time": 17208.628, "timestamp": "04:46:48", "text": "心臓。ええ、なぜストリーミング配信するんですか？私は言った"}, {"type": "subtitle", "time": 17210.67, "timestamp": "04:46:50", "text": "名前を暗記して、"}, {"type": "subtitle", "time": 17214.15, "timestamp": "04:46:54", "text": "まあ、そうですね。でも、直さないといけない"}]
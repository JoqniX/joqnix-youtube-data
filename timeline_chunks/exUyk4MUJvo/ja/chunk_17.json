[{"type": "subtitle", "time": 1022.389, "timestamp": "00:17:02", "text": "準備ができて。敵を発見。行け、行け、行け。"}, {"type": "subtitle", "time": 1028.71, "timestamp": "00:17:08", "text": "料金。いや。ああ、なんてことだ。残念なことに"}, {"type": "subtitle", "time": 1031.829, "timestamp": "00:17:11", "text": "死ななければならなかったが、よし、これをもう一度確認しよう"}, {"type": "subtitle", "time": 1033.59, "timestamp": "00:17:13", "text": "写真。"}, {"type": "subtitle", "time": 1036.71, "timestamp": "00:17:16", "text": "交代時間前の最終ラウンド。えっと、"}, {"type": "subtitle", "time": 1040.27, "timestamp": "00:17:20", "text": "スペースがあります。再装填中。そこには"}, {"type": "subtitle", "time": 1043.15, "timestamp": "00:17:23", "text": "空間。そして私は"}, {"type": "subtitle", "time": 1046.59, "timestamp": "00:17:26", "text": "コピー＆ペーストしてください。私"}, {"type": "subtitle", "time": 1049.51, "timestamp": "00:17:29", "text": "保存。誰かがチャットに入力したら、"}, {"type": "subtitle", "time": 1051.909, "timestamp": "00:17:31", "text": "知ってるよ。ええ、誰かが入力しているなら、"}, {"type": "subtitle", "time": 1054.029, "timestamp": "00:17:34", "text": "確認します"}, {"type": "subtitle", "time": 1072.95, "timestamp": "00:17:52", "text": "いや、そうだね。私たち6人は毎日出発しました"}]
[{"type": "subtitle", "time": 3842.069, "timestamp": "01:04:02", "text": "expert potatoと同じユーザー名を持っています。"}, {"type": "subtitle", "time": 3844.47, "timestamp": "01:04:04", "text": "そうしたら、私は混乱してしまうでしょう。右。それは"}, {"type": "subtitle", "time": 3851.19, "timestamp": "01:04:11", "text": "うん。熟練度。はい。はい。のように"}, {"type": "subtitle", "time": 3853.91, "timestamp": "01:04:13", "text": "以前の名前のこと。うん。うん。うん。"}, {"type": "subtitle", "time": 3856.39, "timestamp": "01:04:16", "text": "つまり、それは私が認識するのに役立つでしょう"}, {"type": "subtitle", "time": 3859.829, "timestamp": "01:04:19", "text": "その人のほうが優れている。それはいいですね。それで、"}, {"type": "subtitle", "time": 3876.27, "timestamp": "01:04:36", "text": "うん。皆さん、ラマダンおめでとうございます。切り替え"}, {"type": "subtitle", "time": 3886.789, "timestamp": "01:04:46", "text": "基本的に私は味方ではないので"}, {"type": "subtitle", "time": 3888.069, "timestamp": "01:04:48", "text": "大丈夫です。うん、大丈夫だよ。大丈夫です。"}, {"type": "subtitle", "time": 3890.47, "timestamp": "01:04:50", "text": "心配しないで。心配しないで。だから、"}, {"type": "subtitle", "time": 3892.87, "timestamp": "01:04:52", "text": "ニックネームは私の側だけのもので、"}, {"type": "subtitle", "time": 3895.589, "timestamp": "01:04:55", "text": "公開側向けであって、配信向けではない"}]
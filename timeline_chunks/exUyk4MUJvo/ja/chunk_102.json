[{"type": "subtitle", "time": 6120.229, "timestamp": "01:42:00", "text": "えっと、あなたは現実世界ではもっと社交的ですか？ いいえ"}, {"type": "subtitle", "time": 6122.629, "timestamp": "01:42:02", "text": "どちらかというと内向的だけど、"}, {"type": "subtitle", "time": 6124.55, "timestamp": "01:42:04", "text": "これは外出する良い習慣になるでしょう"}, {"type": "subtitle", "time": 6128.709, "timestamp": "01:42:08", "text": "内向的な人向けの番組。ええ、私を信じてください"}, {"type": "subtitle", "time": 6130.99, "timestamp": "01:42:10", "text": "私は、えっと、どちらかというと内向的な方です。"}, {"type": "subtitle", "time": 6133.91, "timestamp": "01:42:13", "text": "でも結局は外に出ることになる"}, {"type": "subtitle", "time": 6136.55, "timestamp": "01:42:16", "text": "新しい友達を作る新しい人々と出会う"}, {"type": "subtitle", "time": 6140.629, "timestamp": "01:42:20", "text": "結局はいつも何とかなるものだ。うん。は"}, {"type": "subtitle", "time": 6142.229, "timestamp": "01:42:22", "text": "一人で行くの？それとも誰かと一緒に行くの？"}, {"type": "subtitle", "time": 6146.39, "timestamp": "01:42:26", "text": "そこに知り合いがいるの？えーと、それで、"}, {"type": "subtitle", "time": 6148.83, "timestamp": "01:42:28", "text": "私と同じ学校の他の生徒も"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "バッチ。うんうん。私は地元の"}, {"type": "subtitle", "time": 6155.99, "timestamp": "01:42:35", "text": "ええと、ここインドにある日本人学校です。それから"}, {"type": "subtitle", "time": 6161.03, "timestamp": "01:42:41", "text": "彼らから私は日本へ行く。えっと、私が"}, {"type": "subtitle", "time": 6163.669, "timestamp": "01:42:43", "text": "GMAのインタビューの1つに合格した"}, {"type": "subtitle", "time": 6165.35, "timestamp": "01:42:45", "text": "学校。"}, {"type": "subtitle", "time": 6168.39, "timestamp": "01:42:48", "text": "そう、そんな感じ。えっと、つまり私は"}, {"type": "subtitle", "time": 6170.83, "timestamp": "01:42:50", "text": "日本からCOEを受け取りました"}, {"type": "subtitle", "time": 6173.83, "timestamp": "01:42:53", "text": "学校。だから今週中に受け取るよ"}, {"type": "subtitle", "time": 6177.51, "timestamp": "01:42:57", "text": "1月か6月の第1週だと思う。それで"}]
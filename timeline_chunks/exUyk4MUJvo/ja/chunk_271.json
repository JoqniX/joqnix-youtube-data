[{"type": "subtitle", "time": 16260.429, "timestamp": "04:31:00", "text": "えっと、壊しちゃったのかな？何が"}, {"type": "subtitle", "time": 16262.83, "timestamp": "04:31:02", "text": "遅れ？それは"}, {"type": "subtitle", "time": 16266.63, "timestamp": "04:31:06", "text": "遅れ。あ、待って。両方をタップすると"}, {"type": "subtitle", "time": 16270.31, "timestamp": "04:31:10", "text": "それらを合わせると、一種のループのようなものだ。たとえ"}, {"type": "subtitle", "time": 16279.51, "timestamp": "04:31:19", "text": "スライド効果が得られます。ああ、何ですか"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "電話した？わからない。スライドかポラか？"}, {"type": "subtitle", "time": 16285.469, "timestamp": "04:31:25", "text": "うん、ポラ。ポラ"}, {"type": "subtitle", "time": 16288.55, "timestamp": "04:31:28", "text": "ポラ。そして、基本的なことも忘れてしまった。私"}, {"type": "subtitle", "time": 16291.389, "timestamp": "04:31:31", "text": "以前は、フォローするのが好きでした。"}, {"type": "subtitle", "time": 16295.51, "timestamp": "04:31:35", "text": "FL Studioに関するチュートリアルは数多くあります。"}, {"type": "subtitle", "time": 16299.95, "timestamp": "04:31:39", "text": "スタジオ、Ableton、ミックス"}, {"type": "subtitle", "time": 16303.59, "timestamp": "04:31:43", "text": "マスターはそれについて気に入っている"}, {"type": "subtitle", "time": 16308.429, "timestamp": "04:31:48", "text": "その時は、まるで私が好きになれなかったような感じでした"}, {"type": "subtitle", "time": 16313.03, "timestamp": "04:31:53", "text": "適切にクリエイティブにアイデアを"}, {"type": "subtitle", "time": 16315.67, "timestamp": "04:31:55", "text": "私の心は、できない、できなかった、できなかった"}, {"type": "subtitle", "time": 16318.149, "timestamp": "04:31:58", "text": "に"}]
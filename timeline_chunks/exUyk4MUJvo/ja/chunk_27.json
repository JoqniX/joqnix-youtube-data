[{"type": "subtitle", "time": 1622.52, "timestamp": "00:27:02", "text": "浸した？ああ、"}, {"type": "subtitle", "time": 1624.75, "timestamp": "00:27:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1629.19, "timestamp": "00:27:09", "text": "神。こんな遅くまで起きていられたなんて。おお、"}, {"type": "subtitle", "time": 1631.87, "timestamp": "00:27:11", "text": "待って。何時ですか？"}, {"type": "subtitle", "time": 1636.149, "timestamp": "00:27:16", "text": "あなた？午後10時頃ですよね？"}, {"type": "subtitle", "time": 1638.149, "timestamp": "00:27:18", "text": "ええ、午後10時です。あなたのために。ニース。私は"}, {"type": "subtitle", "time": 1650.149, "timestamp": "00:27:30", "text": "ジョイはすぐ先に行ってしまった。"}]
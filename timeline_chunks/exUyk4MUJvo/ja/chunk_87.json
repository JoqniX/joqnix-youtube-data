[{"type": "subtitle", "time": 5225.83, "timestamp": "01:27:05", "text": "敵はあと一体。そして私はこう思った。"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "\"わかった、"}, {"type": "subtitle", "time": 5229.59, "timestamp": "01:27:09", "text": "私にはチャンスがある。私はこうなったと思う"}, {"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "残り30秒。"}, {"type": "subtitle", "time": 5247.75, "timestamp": "01:27:27", "text": "聞きたいですか？あなたは私の宿題ですか？"}, {"type": "subtitle", "time": 5249.91, "timestamp": "01:27:29", "text": "だって、君に忘れさせたいんだもん。おお"}, {"type": "subtitle", "time": 5254.669, "timestamp": "01:27:34", "text": "神。ああ、"}, {"type": "subtitle", "time": 5258.31, "timestamp": "01:27:38", "text": "神。よお、じゃあね。よう、坊や。それは それは"}]
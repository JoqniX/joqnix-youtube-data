[{"type": "subtitle", "time": 3602.829, "timestamp": "01:00:02", "text": "問題は、私がプレイしなければならないということです"}, {"type": "subtitle", "time": 3605.95, "timestamp": "01:00:05", "text": "手に入れるのが良い"}, {"type": "subtitle", "time": 3609.51, "timestamp": "01:00:09", "text": "XP と過小評価されているものからは、次のようなものしか得られません。"}, {"type": "subtitle", "time": 3614.67, "timestamp": "01:00:14", "text": "でも私は"}, {"type": "subtitle", "time": 3617.43, "timestamp": "01:00:17", "text": "怖がった。保証の件は"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "不十分なよりも優れている"}, {"type": "subtitle", "time": 3622.87, "timestamp": "01:00:22", "text": "矛盾している。右。だから私は"}, {"type": "subtitle", "time": 3625.47, "timestamp": "01:00:25", "text": "人々はスパイクラッシュやシフトを使うと思う"}, {"type": "subtitle", "time": 3628.67, "timestamp": "01:00:28", "text": "遊ぶ。うん。こんにちは。"}, {"type": "subtitle", "time": 3630.2, "timestamp": "01:00:30", "text": "静かに。どうやって"}, {"type": "subtitle", "time": 3631.549, "timestamp": "01:00:31", "text": "[音楽]"}, {"type": "subtitle", "time": 3634.789, "timestamp": "01:00:34", "text": "何をしているの？ええ、そんな感じです。そして"}, {"type": "subtitle", "time": 3638.23, "timestamp": "01:00:38", "text": "レンダリング費用はいくらですか？ 84. それは"}, {"type": "subtitle", "time": 3643.6, "timestamp": "01:00:43", "text": "完了。スパイクラッシュ。もう行かなきゃ。"}, {"type": "subtitle", "time": 3651.99, "timestamp": "01:00:51", "text": "私はここから出て行く。"}, {"type": "subtitle", "time": 3657.51, "timestamp": "01:00:57", "text": "私は長い間、幸運に恵まれてきました。"}]
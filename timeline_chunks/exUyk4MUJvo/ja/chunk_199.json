[{"type": "subtitle", "time": 11941.99, "timestamp": "03:19:01", "text": "まるで夢のようだったけど、その夢は"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "期待外れだった、あるいは実現しなかった。それで"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "それは衝撃的な出来事だった。それから私は"}, {"type": "subtitle", "time": 11950.389, "timestamp": "03:19:10", "text": "よし、元の場所に戻った"}, {"type": "subtitle", "time": 11952.19, "timestamp": "03:19:12", "text": "再び振り出しに戻る。"}, {"type": "subtitle", "time": 11955.59, "timestamp": "03:19:15", "text": "感情的な側面は理解できます。"}, {"type": "subtitle", "time": 11968.309, "timestamp": "03:19:28", "text": "ある日。一度、それは何だか"}, {"type": "subtitle", "time": 11971.15, "timestamp": "03:19:31", "text": "それは何という名前ですか？あなたのような"}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "アカデミーに入学したらどうなるか、"}, {"type": "subtitle", "time": 11975.91, "timestamp": "03:19:35", "text": "電話がかかってきた？アカデミーは"}, {"type": "subtitle", "time": 11977.349, "timestamp": "03:19:37", "text": "企業。考えたことがありますか"}, {"type": "subtitle", "time": 11989.269, "timestamp": "03:19:49", "text": "ヴービング。 Vubingとか、えーと仕事みたいなもの？"}, {"type": "subtitle", "time": 11992.11, "timestamp": "03:19:52", "text": "うん。うん。ヴービング。 Vチュービング。"}, {"type": "subtitle", "time": 11995.03, "timestamp": "03:19:55", "text": "ああ、わからない。私はただ読んだだけです"}, {"type": "subtitle", "time": 11998.87, "timestamp": "03:19:58", "text": "メッセージを読みました。うん。私は"}]
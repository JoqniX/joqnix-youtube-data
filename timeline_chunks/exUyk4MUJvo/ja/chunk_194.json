[{"type": "subtitle", "time": 11640.469, "timestamp": "03:14:00", "text": "彼らの商品をチェックしてみたら気に入った"}, {"type": "subtitle", "time": 11644.07, "timestamp": "03:14:04", "text": "それ。だから私は「うん、韓国語だよ」って言ったんだ"}, {"type": "subtitle", "time": 11647.79, "timestamp": "03:14:07", "text": "今。ええと、韓国語版のはずです"}, {"type": "subtitle", "time": 11652.03, "timestamp": "03:14:12", "text": "その下には「はい」と書くべきです。 9ドル900ドル"}, {"type": "subtitle", "time": 11654.79, "timestamp": "03:14:14", "text": "何か。でも、そう、それから追加"}, {"type": "subtitle", "time": 11657.67, "timestamp": "03:14:17", "text": "さらに彼らは、これが"}, {"type": "subtitle", "time": 11660.469, "timestamp": "03:14:20", "text": "より良く"}, {"type": "subtitle", "time": 11664.87, "timestamp": "03:14:24", "text": "しかしこれはまだ、"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "イギリスの基準で言えば、これは高価だ。あなた"}, {"type": "subtitle", "time": 11669.91, "timestamp": "03:14:29", "text": "理解する？それはそれはそれはそれはそれは私は"}, {"type": "subtitle", "time": 11671.75, "timestamp": "03:14:31", "text": "インドで言うと理解する"}, {"type": "subtitle", "time": 11675.19, "timestamp": "03:14:35", "text": "インドのお金は高価です"}, {"type": "subtitle", "time": 11679.19, "timestamp": "03:14:39", "text": "インドでは、でもご存知のようにイギリスでは"}, {"type": "subtitle", "time": 11682.87, "timestamp": "03:14:42", "text": "貨幣水準は依然として高い。うん、"}, {"type": "subtitle", "time": 11684.67, "timestamp": "03:14:44", "text": "それはそれだ"}, {"type": "subtitle", "time": 11687.19, "timestamp": "03:14:47", "text": "趣味のためなら"}, {"type": "subtitle", "time": 11689.91, "timestamp": "03:14:49", "text": "正当化できる、わかった、できるならしてもいいよ"}, {"type": "subtitle", "time": 11693.19, "timestamp": "03:14:53", "text": "それを正当化するのは良いことだ"}, {"type": "subtitle", "time": 11695.91, "timestamp": "03:14:55", "text": "誰もが特定のものを見ることができるわけではない"}, {"type": "subtitle", "time": 11698.63, "timestamp": "03:14:58", "text": "同様に理解しています"}]
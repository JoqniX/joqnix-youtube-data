[{"type": "subtitle", "time": 16921.27, "timestamp": "04:42:01", "text": "いつものストリームが"}, {"type": "subtitle", "time": 16924.03, "timestamp": "04:42:04", "text": "あなたが楽しむゲーム配信"}, {"type": "subtitle", "time": 16926.788, "timestamp": "04:42:06", "text": "人々。ええ、あのストリームですね"}, {"type": "subtitle", "time": 16929.628, "timestamp": "04:42:09", "text": "リラックスできるもの"}, {"type": "subtitle", "time": 16933.708, "timestamp": "04:42:13", "text": "外に出て、ゲームを楽しんで、"}, {"type": "subtitle", "time": 16935.31, "timestamp": "04:42:15", "text": "自分自身、"}, {"type": "subtitle", "time": 16938.43, "timestamp": "04:42:18", "text": "楽しんで、楽しんで、"}, {"type": "subtitle", "time": 16942.11, "timestamp": "04:42:22", "text": "楽しんで、ただ"}, {"type": "subtitle", "time": 16945.59, "timestamp": "04:42:25", "text": "無料。ただ自由にすればいいんだよ。ただ存在するだけ"}, {"type": "subtitle", "time": 16947.788, "timestamp": "04:42:27", "text": "冷やした。"}, {"type": "subtitle", "time": 16950.19, "timestamp": "04:42:30", "text": "無料。"}, {"type": "subtitle", "time": 16956.39, "timestamp": "04:42:36", "text": "まさにその通り。それは私が"}, {"type": "subtitle", "time": 16958.948, "timestamp": "04:42:38", "text": "仕事から解放され、"}, {"type": "subtitle", "time": 16962.39, "timestamp": "04:42:42", "text": "ストレス、何もかもから解放されて、"}, {"type": "subtitle", "time": 16967.07, "timestamp": "04:42:47", "text": "必要ない、いや、必要ない、好き"}, {"type": "subtitle", "time": 16970.59, "timestamp": "04:42:50", "text": "えっと、私は好きになる必要はない"}, {"type": "subtitle", "time": 16973.788, "timestamp": "04:42:53", "text": "えっと、緊張して、"}, {"type": "subtitle", "time": 16977.31, "timestamp": "04:42:57", "text": "ストレスを感じて、物事を心配する"}, {"type": "subtitle", "time": 16978.91, "timestamp": "04:42:58", "text": "オーバーインク"}]
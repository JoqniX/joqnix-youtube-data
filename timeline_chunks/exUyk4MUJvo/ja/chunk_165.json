[{"type": "subtitle", "time": 9901.11, "timestamp": "02:45:01", "text": "よく考えてみて。ええ、おっしゃる通りです。"}, {"type": "subtitle", "time": 9904.389, "timestamp": "02:45:04", "text": "日本人の彼女を作りなさい。"}, {"type": "subtitle", "time": 9907.91, "timestamp": "02:45:07", "text": "多分。ええ、可能であれば。つまり、"}, {"type": "subtitle", "time": 9910.87, "timestamp": "02:45:10", "text": "もし人生がそういう風に進むなら。うん。"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "日本語。彼女はインド人かもしれない。誰が"}, {"type": "subtitle", "time": 9916.389, "timestamp": "02:45:16", "text": "気にかけている？うん。うん。誰でも？うん。誰か"}, {"type": "subtitle", "time": 9919.99, "timestamp": "02:45:19", "text": "実際にあなたを支持しているのは誰ですか、そしてまた"}, {"type": "subtitle", "time": 9921.75, "timestamp": "02:45:21", "text": "また、わからない、わからないまで"}, {"type": "subtitle", "time": 9926.15, "timestamp": "02:45:26", "text": "えっと、どう言えばいいかな、私は"}, {"type": "subtitle", "time": 9928.87, "timestamp": "02:45:28", "text": "知らないけど、何て言うんだっけ"}, {"type": "subtitle", "time": 9931.59, "timestamp": "02:45:31", "text": "セクシュアリティ"}, {"type": "subtitle", "time": 9933.83, "timestamp": "02:45:33", "text": "好きに"}, {"type": "subtitle", "time": 9935.59, "timestamp": "02:45:35", "text": "うん、わかった、ストレートなら、もしあなたがストレートなら"}, {"type": "subtitle", "time": 9945.51, "timestamp": "02:45:45", "text": "彼らは最高の中の最高だ"}, {"type": "subtitle", "time": 9948.95, "timestamp": "02:45:48", "text": "ああ、何だっけ、行かないで"}, {"type": "subtitle", "time": 9951.23, "timestamp": "02:45:51", "text": "電話した？行かないで、ただ行かないで"}]
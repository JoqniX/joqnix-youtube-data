[{"type": "subtitle", "time": 2417.19, "timestamp": "00:40:17", "text": "No. 120. O"}, {"type": "subtitle", "time": 2425.91, "timestamp": "00:40:25", "text": "彼らは完全に死んでしまった。"}, {"type": "subtitle", "time": 2429.75, "timestamp": "00:40:29", "text": "存在の空間。何てことだ。"}, {"type": "subtitle", "time": 2445.589, "timestamp": "00:40:45", "text": "行く。気をつけて。"}]
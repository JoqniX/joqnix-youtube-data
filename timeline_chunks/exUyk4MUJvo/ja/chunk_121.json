[{"type": "subtitle", "time": 7260.229, "timestamp": "02:01:00", "text": "彼女は都合が悪くて"}, {"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "病気とか、そういう類のこと。今"}, {"type": "subtitle", "time": 7264.47, "timestamp": "02:01:04", "text": "今、真実が明らかになった。それで"}, {"type": "subtitle", "time": 7267.589, "timestamp": "02:01:07", "text": "みんな文字通りうんこしてた"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "シンダーがしたことと彼女の"}, {"type": "subtitle", "time": 7273.109, "timestamp": "02:01:13", "text": "マネージャーは、ええと、そして結局"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "シンダーの謝罪は文字通り彼女の"}, {"type": "subtitle", "time": 7280.87, "timestamp": "02:01:20", "text": "彼女はマネージャー、つまり彼氏を責めている。"}, {"type": "subtitle", "time": 7283.669, "timestamp": "02:01:23", "text": "これは"}, {"type": "subtitle", "time": 7287.589, "timestamp": "02:01:27", "text": "わかった。私はTLDDRを理解しています。"}, {"type": "subtitle", "time": 7291.109, "timestamp": "02:01:31", "text": "まあ、人々は人々を手に入れたいと思っています"}, {"type": "subtitle", "time": 7293.51, "timestamp": "02:01:33", "text": "彼らはすぐに人気者になりたいと思っており、実際に人気者になっている。"}, {"type": "subtitle", "time": 7295.87, "timestamp": "02:01:35", "text": "くだらないことばかり。"}, {"type": "subtitle", "time": 7302.149, "timestamp": "02:01:42", "text": "うん。何てことだ。たぶん、たぶん、えっと"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "えっと、どう言えばいいかな？最も"}, {"type": "subtitle", "time": 7315.26, "timestamp": "02:01:55", "text": "何てことだ。わかった。彼女にとって良いことだ。"}, {"type": "subtitle", "time": 7316.55, "timestamp": "02:01:56", "text": "[音楽]"}]
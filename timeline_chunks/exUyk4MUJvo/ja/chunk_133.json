[{"type": "subtitle", "time": 7981.75, "timestamp": "02:13:01", "text": "日本風にアレンジされていて、"}, {"type": "subtitle", "time": 7983.669, "timestamp": "02:13:03", "text": "それはそれほど良いものでもない、つまり、"}, {"type": "subtitle", "time": 7985.83, "timestamp": "02:13:05", "text": "うん、いい話だね。それは"}, {"type": "subtitle", "time": 7987.75, "timestamp": "02:13:07", "text": "私が読んだ中で最高のマンサ作品です。の1つ"}, {"type": "subtitle", "time": 7990.069, "timestamp": "02:13:10", "text": "最高。しかし、素晴らしいものが複数あります"}, {"type": "subtitle", "time": 7991.99, "timestamp": "02:13:11", "text": "マヌアス。"}, {"type": "subtitle", "time": 7995.669, "timestamp": "02:13:15", "text": "はい。そして太陽水平調整とは"}, {"type": "subtitle", "time": 7999.189, "timestamp": "02:13:19", "text": "私たちはそう言うのか？えっと、もし私が13歳だったら、"}, {"type": "subtitle", "time": 8001.96, "timestamp": "02:13:21", "text": "太陽の水平化、とでも言うべきでしょうか。"}, {"type": "subtitle", "time": 8004.229, "timestamp": "02:13:24", "text": "[音楽]"}, {"type": "subtitle", "time": 8005.83, "timestamp": "02:13:25", "text": "この時点で私は、よし、私は好き"}, {"type": "subtitle", "time": 8008.35, "timestamp": "02:13:28", "text": "ソロレベリングは、"}, {"type": "subtitle", "time": 8011.109, "timestamp": "02:13:31", "text": "彼がやっていること全てを知っている。しかし"}, {"type": "subtitle", "time": 8013.35, "timestamp": "02:13:33", "text": "それはただの剣術の美化された剣にすぎない"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "オンライン。"}, {"type": "subtitle", "time": 8018.069, "timestamp": "02:13:38", "text": "ああ、もちろんです。それは非常に強い意見ですね。"}, {"type": "subtitle", "time": 8019.83, "timestamp": "02:13:39", "text": "私は推測する。"}, {"type": "subtitle", "time": 8023.109, "timestamp": "02:13:43", "text": "あなたはどんな種類のマナを読みますか？"}, {"type": "subtitle", "time": 8025.99, "timestamp": "02:13:45", "text": "オムニシアのリーダーとか、そういうの読んだことありますか？"}, {"type": "subtitle", "time": 8027.43, "timestamp": "02:13:47", "text": "うん。うん。うん。それはとても"}, {"type": "subtitle", "time": 8032.629, "timestamp": "02:13:52", "text": "良いマナ。そうだと思います。"}, {"type": "subtitle", "time": 8035.109, "timestamp": "02:13:55", "text": "最高のマナは"}, {"type": "subtitle", "time": 8037.03, "timestamp": "02:13:57", "text": "ノーザンブレード。読んだことがありますか？"}]
[{"type": "subtitle", "time": 15000.51, "timestamp": "04:10:00", "text": "1番目の修正は"}, {"type": "subtitle", "time": 15005.15, "timestamp": "04:10:05", "text": "1番目は、すべてを再建することです"}, {"type": "subtitle", "time": 15008.229, "timestamp": "04:10:08", "text": "シーンはゆっくりと再構築され、"}, {"type": "subtitle", "time": 15010.349, "timestamp": "04:10:10", "text": "私が"}, {"type": "subtitle", "time": 15014.71, "timestamp": "04:10:14", "text": "このようなカスタム品があります"}, {"type": "subtitle", "time": 15017.87, "timestamp": "04:10:17", "text": "えーと、あの歓迎のやつ、"}, {"type": "subtitle", "time": 15022.269, "timestamp": "04:10:22", "text": "短い短いものを見せる必要がある"}, {"type": "subtitle", "time": 15024.99, "timestamp": "04:10:24", "text": "アニメーションは、えっと、下の方にあります"}, {"type": "subtitle", "time": 15028.189, "timestamp": "04:10:28", "text": "期間と"}, {"type": "subtitle", "time": 15030.83, "timestamp": "04:10:30", "text": "物"}, {"type": "subtitle", "time": 15034.83, "timestamp": "04:10:34", "text": "知る。そしてもう一方"}, {"type": "subtitle", "time": 15037.67, "timestamp": "04:10:37", "text": "もの。うん。すべてのブラウザソース"}, {"type": "subtitle", "time": 15039.83, "timestamp": "04:10:39", "text": "すべて。だからこれからは私は"}, {"type": "subtitle", "time": 15043.429, "timestamp": "04:10:43", "text": "Twitchでその機能を使っています。えっと、"}, {"type": "subtitle", "time": 15046.15, "timestamp": "04:10:46", "text": "通常は赤色"}, {"type": "subtitle", "time": 15050.11, "timestamp": "04:10:50", "text": "カーソルですよね？私の"}, {"type": "subtitle", "time": 15052.63, "timestamp": "04:10:52", "text": "ストリーム、ストリームとやり取りする"}, {"type": "subtitle", "time": 15055.07, "timestamp": "04:10:55", "text": "いろいろなものを無効にします"}, {"type": "subtitle", "time": 15058.87, "timestamp": "04:10:58", "text": "なぜならブラウザのソースは"}]
[{"type": "subtitle", "time": 2522.47, "timestamp": "00:42:02", "text": "そこには。お元気ですか？"}, {"type": "subtitle", "time": 2526.02, "timestamp": "00:42:06", "text": "お元気でお過ごしでしょうか。ヤフー。ヒーリング"}, {"type": "subtitle", "time": 2566.47, "timestamp": "00:42:46", "text": "いいえ。ニックネームの件を待ってください。"}, {"type": "subtitle", "time": 2568.309, "timestamp": "00:42:48", "text": "コマンドのようにしましょう、"}, {"type": "subtitle", "time": 2570.349, "timestamp": "00:42:50", "text": "何か、私は"}, {"type": "subtitle", "time": 2572.63, "timestamp": "00:42:52", "text": "推測。わからない。ああ神様、私は作っています"}, {"type": "subtitle", "time": 2575.589, "timestamp": "00:42:55", "text": "たぶん、私が話をややこしくしているだけでしょうね。"}]
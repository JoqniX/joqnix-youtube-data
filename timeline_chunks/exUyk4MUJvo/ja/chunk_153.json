[{"type": "subtitle", "time": 9182.79, "timestamp": "02:33:02", "text": "私は喜んで喜んで"}, {"type": "subtitle", "time": 9195.349, "timestamp": "02:33:15", "text": "そして、もしあなたが依存しているなら"}, {"type": "subtitle", "time": 9198.63, "timestamp": "02:33:18", "text": "それについては、確実に学ぶ必要があります"}, {"type": "subtitle", "time": 9202.07, "timestamp": "02:33:22", "text": "パラチャパティを作る。"}, {"type": "subtitle", "time": 9204.15, "timestamp": "02:33:24", "text": "ああ、そうだ"}, {"type": "subtitle", "time": 9206.23, "timestamp": "02:33:26", "text": "作り方を学ぶ必要がある"}, {"type": "subtitle", "time": 9207.59, "timestamp": "02:33:27", "text": "お米は最も簡単にできるものです"}, {"type": "subtitle", "time": 9211.75, "timestamp": "02:33:31", "text": "米はどこでも手に入る。ご飯はおいしい。はい。"}, {"type": "subtitle", "time": 9213.91, "timestamp": "02:33:33", "text": "人形が必要です。人形が必要です。ドールユー"}, {"type": "subtitle", "time": 9217.27, "timestamp": "02:33:37", "text": "学ぶ必要がある。うん。"}, {"type": "subtitle", "time": 9219.349, "timestamp": "02:33:39", "text": "そして、もしあなたが、もしあなたが、もしあなたが食べるなら、何が"}, {"type": "subtitle", "time": 9221.349, "timestamp": "02:33:41", "text": "電話がかかってきた？チキン。私は知らない"}, {"type": "subtitle", "time": 9223.91, "timestamp": "02:33:43", "text": "日本の鶏肉の基準ですが、"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "かなり良い。絶対に。"}, {"type": "subtitle", "time": 9228.389, "timestamp": "02:33:48", "text": "はい。あなたは学ぶ必要がある"}, {"type": "subtitle", "time": 9234.95, "timestamp": "02:33:54", "text": "シンプルなチキンカレー、家庭風カレー"}, {"type": "subtitle", "time": 9237.99, "timestamp": "02:33:57", "text": "それは最も素晴らしいことだ。"}, {"type": "subtitle", "time": 9239.59, "timestamp": "02:33:59", "text": "うん。"}]
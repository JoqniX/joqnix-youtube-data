[{"type": "subtitle", "time": 1981.269, "timestamp": "00:33:01", "text": "残り。"}, {"type": "subtitle", "time": 1989.149, "timestamp": "00:33:09", "text": "しなければならない"}, {"type": "subtitle", "time": 1992.47, "timestamp": "00:33:12", "text": "行く。料金がかかりません。"}, {"type": "subtitle", "time": 1995.23, "timestamp": "00:33:15", "text": "フェニックスはいつもAFK（離席中）だ。何"}, {"type": "subtitle", "time": 1998.23, "timestamp": "00:33:18", "text": "なぜハッキングされたのか？"}, {"type": "subtitle", "time": 2007.909, "timestamp": "00:33:27", "text": "マッチポイント。"}, {"type": "subtitle", "time": 2010.149, "timestamp": "00:33:30", "text": "あれって有害だったよね？自分"}, {"type": "subtitle", "time": 2012.509, "timestamp": "00:33:32", "text": "電撃"}, {"type": "subtitle", "time": 2015.35, "timestamp": "00:33:35", "text": "死んだ。それは有害だった。お入りください"}, {"type": "subtitle", "time": 2017.19, "timestamp": "00:33:37", "text": "今。あんなことをするべきじゃなかった。私"}, {"type": "subtitle", "time": 2019.269, "timestamp": "00:33:39", "text": "壁を攻撃すればよかったのに"}, {"type": "subtitle", "time": 2021.23, "timestamp": "00:33:41", "text": "容器または"}, {"type": "subtitle", "time": 2024.19, "timestamp": "00:33:44", "text": "何でも。それは悪かった"}, {"type": "subtitle", "time": 2037.669, "timestamp": "00:33:57", "text": "冗談はもう終わりだ。お前は死んだ。"}]
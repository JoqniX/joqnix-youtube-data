[{"type": "subtitle", "time": 9840.469, "timestamp": "02:44:00", "text": "私がチューブで動画を配信したり、ストリーミングしたりしているところ。"}, {"type": "subtitle", "time": 9842.87, "timestamp": "02:44:02", "text": "うん、それは面白そうだね。しかし、しかし"}, {"type": "subtitle", "time": 9844.55, "timestamp": "02:44:04", "text": "問題は、その後、"}, {"type": "subtitle", "time": 9846.309, "timestamp": "02:44:06", "text": "もう一つの問題は、誰が"}, {"type": "subtitle", "time": 9848.91, "timestamp": "02:44:08", "text": "誰がその家を引き継ぐのか。"}, {"type": "subtitle", "time": 9852.55, "timestamp": "02:44:12", "text": "ああ、その通りですね。ええ、なぜなら"}, {"type": "subtitle", "time": 9854.55, "timestamp": "02:44:14", "text": "なぜなら、もしあなたたち二人が"}, {"type": "subtitle", "time": 9857.75, "timestamp": "02:44:17", "text": "このレベルの狂気なら、家は"}, {"type": "subtitle", "time": 9860.55, "timestamp": "02:44:20", "text": "ちょっと混乱しそうだ。ええ、私たちは"}, {"type": "subtitle", "time": 9863.59, "timestamp": "02:44:23", "text": "アスペンガールみたいなのは嫌だ。"}, {"type": "subtitle", "time": 9866.23, "timestamp": "02:44:26", "text": "うん。いや、いや、それは嫌だ。それは"}, {"type": "subtitle", "time": 9868.07, "timestamp": "02:44:28", "text": "私が考えていること。"}, {"type": "subtitle", "time": 9870.389, "timestamp": "02:44:30", "text": "特に女の子を手に入れる"}, {"type": "subtitle", "time": 9872.95, "timestamp": "02:44:32", "text": "ストリーマーに夢中な人、"}, {"type": "subtitle", "time": 9874.2, "timestamp": "02:44:34", "text": "ストリーミング配信。"}, {"type": "subtitle", "time": 9880.71, "timestamp": "02:44:40", "text": "ほら、私はあなたにアドバイスしているんだ"}, {"type": "subtitle", "time": 9884.389, "timestamp": "02:44:44", "text": "あなたは日本に住みたいのですね。ええ、私は"}, {"type": "subtitle", "time": 9886.429, "timestamp": "02:44:46", "text": "実際、私は考えていなかった"}, {"type": "subtitle", "time": 9890.07, "timestamp": "02:44:50", "text": "そうですが、ありがとうございます。彼の"}, {"type": "subtitle", "time": 9892.55, "timestamp": "02:44:52", "text": "彼女？うん、集中しようと思ったんだ"}, {"type": "subtitle", "time": 9895.11, "timestamp": "02:44:55", "text": "勉強や人生やその他すべてについて"}, {"type": "subtitle", "time": 9897.51, "timestamp": "02:44:57", "text": "そうすれば私は"}]
[{"type": "subtitle", "time": 12781.229, "timestamp": "03:33:01", "text": "たくさんのことについて話している"}, {"type": "subtitle", "time": 12784.51, "timestamp": "03:33:04", "text": "もの。それこそが、いわゆる「たまり場」ってやつだ。私たちは"}, {"type": "subtitle", "time": 12787.07, "timestamp": "03:33:07", "text": "冷やした。私たちは冷やしました"}, {"type": "subtitle", "time": 12800.469, "timestamp": "03:33:20", "text": "ええ、本当に楽しかったですし、みんな"}, {"type": "subtitle", "time": 12809.83, "timestamp": "03:33:29", "text": "えっと、本当に仮想通貨詐欺に遭ったのかな？"}, {"type": "subtitle", "time": 12811.99, "timestamp": "03:33:31", "text": "私のTwitterに何か投稿しましたか？彼らは私のタグを付けました"}, {"type": "subtitle", "time": 12814.87, "timestamp": "03:33:34", "text": "アカウント。何が"}, {"type": "subtitle", "time": 12817.15, "timestamp": "03:33:37", "text": "えっと、タグを解除するにはどうすればいいですか？"}, {"type": "subtitle", "time": 12823.59, "timestamp": "03:33:43", "text": "会話。ええ、そうしました。私はそうしました"}, {"type": "subtitle", "time": 12826.59, "timestamp": "03:33:46", "text": "それ。奇妙な。"}, {"type": "subtitle", "time": 12829.389, "timestamp": "03:33:49", "text": "とにかく、こんにちは"}, {"type": "subtitle", "time": 12833.229, "timestamp": "03:33:53", "text": "ダッシュ。本当に楽しかった"}, {"type": "subtitle", "time": 12835.51, "timestamp": "03:33:55", "text": "コラボレーション。本当に楽しいコラボレーションでした。私"}]
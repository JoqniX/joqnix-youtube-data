[{"type": "subtitle", "time": 2280.829, "timestamp": "00:38:00", "text": "URL。つまり、それは次のような意味になります"}, {"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "Discordのために何をしたか考えてみよう"}, {"type": "subtitle", "time": 2300.71, "timestamp": "00:38:20", "text": "私の赤いシステムのために、私は何をしたのでしょうか？"}, {"type": "subtitle", "time": 2303.99, "timestamp": "00:38:23", "text": "私はここから出て行く。あ、待って。セージは、"}, {"type": "subtitle", "time": 2327.63, "timestamp": "00:38:47", "text": "聖なる主よ。"}, {"type": "subtitle", "time": 2331.19, "timestamp": "00:38:51", "text": "興ざめな人。脅威システム。私がやったことは"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "私の脅迫に対して、どう行動するか。最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 2337.99, "timestamp": "00:38:57", "text": "私は自分のスレッドシステムのために何をしたのか？私"}]
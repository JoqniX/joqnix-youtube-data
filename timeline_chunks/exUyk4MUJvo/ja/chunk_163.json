[{"type": "subtitle", "time": 9780.07, "timestamp": "02:43:00", "text": "うん。"}, {"type": "subtitle", "time": 9782.63, "timestamp": "02:43:02", "text": "日本語のような中間的な位置づけ/"}, {"type": "subtitle", "time": 9783.99, "timestamp": "02:43:03", "text": "インド人、なぜならあなたはただ"}, {"type": "subtitle", "time": 9787.67, "timestamp": "02:43:07", "text": "日本食を食べる。はい、本当です、本当です、"}, {"type": "subtitle", "time": 9790.469, "timestamp": "02:43:10", "text": "真実。料理もしなければならないし"}, {"type": "subtitle", "time": 9792.87, "timestamp": "02:43:12", "text": "パートナーにインド料理をご馳走する"}, {"type": "subtitle", "time": 9796.389, "timestamp": "02:43:16", "text": "などなど。うん。そうすれば彼らも学ぶことができる"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "インド料理の作り方も。うん。"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "うん。うん。それは、それがすべきことだ"}, {"type": "subtitle", "time": 9804.23, "timestamp": "02:43:24", "text": "あなたが目指すべきもの。だから降りて"}, {"type": "subtitle", "time": 9807.349, "timestamp": "02:43:27", "text": "ストリーム、日本へ、デバイスデザイン"}, {"type": "subtitle", "time": 9810.63, "timestamp": "02:43:30", "text": "君の計画は全部、彼女を見つけろ。うん。そして"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "そしてまたストリーミング配信を始める"}, {"type": "subtitle", "time": 9814.23, "timestamp": "02:43:34", "text": "そして、「やあ、"}, {"type": "subtitle", "time": 9815.55, "timestamp": "02:43:35", "text": "私はここにいます"}, {"type": "subtitle", "time": 9823.59, "timestamp": "02:43:43", "text": "うん、それは確かに良いことだろう。うん、"}, {"type": "subtitle", "time": 9825.429, "timestamp": "02:43:45", "text": "それは私が実現したい夢です。"}, {"type": "subtitle", "time": 9829.349, "timestamp": "02:43:49", "text": "考える。ええ、私は"}, {"type": "subtitle", "time": 9831.95, "timestamp": "02:43:51", "text": "私の夢を支えてくれるかもしれない。彼女は"}, {"type": "subtitle", "time": 9835.51, "timestamp": "02:43:55", "text": "ストリーミング再生がさらに良くなる。ああ、彼女を連れて行けるよ"}, {"type": "subtitle", "time": 9838.55, "timestamp": "02:43:58", "text": "ここから始めて、うん、始めよう"}]
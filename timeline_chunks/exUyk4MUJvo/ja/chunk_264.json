[{"type": "subtitle", "time": 15842.469, "timestamp": "04:24:02", "text": "私を見て、私の退屈な配信、退屈な"}, {"type": "subtitle", "time": 15844.149, "timestamp": "04:24:04", "text": "声。"}, {"type": "subtitle", "time": 15845.55, "timestamp": "04:24:05", "text": "しかし"}, {"type": "subtitle", "time": 15860.269, "timestamp": "04:24:20", "text": "聖なるものもまた"}, {"type": "subtitle", "time": 15863.59, "timestamp": "04:24:23", "text": "誰かが私に言った場合にのみ来た"}, {"type": "subtitle", "time": 15866.469, "timestamp": "04:24:26", "text": "音楽の音量を声から始める"}, {"type": "subtitle", "time": 15885.269, "timestamp": "04:24:45", "text": "みんな。とてもネガティブだ。君たちは歓声を上げた"}, {"type": "subtitle", "time": 15897.59, "timestamp": "04:24:57", "text": "上。えっと、6時まで配信します。ストップ"}]
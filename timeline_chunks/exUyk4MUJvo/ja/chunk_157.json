[{"type": "subtitle", "time": 9421.11, "timestamp": "02:37:01", "text": "時間があるかどうかは、あなたの"}, {"type": "subtitle", "time": 9423.429, "timestamp": "02:37:03", "text": "焦点が変わりました。あなたの現在の優先事項"}, {"type": "subtitle", "time": 9427.389, "timestamp": "02:37:07", "text": "少し変更する。うん、そうだろうね"}, {"type": "subtitle", "time": 9430.55, "timestamp": "02:37:10", "text": "それは変わるだろう。私は言っているわけではない"}, {"type": "subtitle", "time": 9432.469, "timestamp": "02:37:12", "text": "信頼すれば絶対にできる"}, {"type": "subtitle", "time": 9435.19, "timestamp": "02:37:15", "text": "私とあなたは既に48時間経過しています。"}, {"type": "subtitle", "time": 9438.79, "timestamp": "02:37:18", "text": "だから、ああ、それは実際には、"}, {"type": "subtitle", "time": 9442.99, "timestamp": "02:37:22", "text": "実際の時間をお伝えします。えっと"}, {"type": "subtitle", "time": 9451.67, "timestamp": "02:37:31", "text": "実際、少なすぎる。待って、"}, {"type": "subtitle", "time": 9453.429, "timestamp": "02:37:33", "text": "あなたに"}, {"type": "subtitle", "time": 9457.95, "timestamp": "02:37:37", "text": "数時間で。よし、そうあるべきだ"}, {"type": "subtitle", "time": 9460.79, "timestamp": "02:37:40", "text": "約ああ、話したいことがある。なぜできないのか"}, {"type": "subtitle", "time": 9464.55, "timestamp": "02:37:44", "text": "Google、それを見せてくれませんか？何てことだ。 1つ"}, {"type": "subtitle", "time": 9467.429, "timestamp": "02:37:47", "text": "2番。"}, {"type": "subtitle", "time": 9469.55, "timestamp": "02:37:49", "text": "それで、私はこれを始めました"}, {"type": "subtitle", "time": 9474.11, "timestamp": "02:37:54", "text": "3月12日午前10時からのチョーク"}, {"type": "subtitle", "time": 9478.55, "timestamp": "02:37:58", "text": "午前。そう、"}]
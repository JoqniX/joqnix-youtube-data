[{"type": "subtitle", "time": 4743.189, "timestamp": "01:19:03", "text": "接続されました。繋がっている。良い。"}, {"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "もう行かなきゃ。"}, {"type": "subtitle", "time": 4748.11, "timestamp": "01:19:08", "text": "30分後に戻ります。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 4751.59, "timestamp": "01:19:11", "text": "来る。ライムのピクルスを試してもいいですか？"}, {"type": "subtitle", "time": 4753.31, "timestamp": "01:19:13", "text": "あなた？はい。"}, {"type": "subtitle", "time": 4755.83, "timestamp": "01:19:15", "text": "さよなら。なぜそうしたいのか分かりません"}, {"type": "subtitle", "time": 4766.03, "timestamp": "01:19:26", "text": "誰か"}, {"type": "subtitle", "time": 4769.27, "timestamp": "01:19:29", "text": "一番上へ登ってください。"}, {"type": "subtitle", "time": 4771.07, "timestamp": "01:19:31", "text": "ほとんど"}, {"type": "subtitle", "time": 4788.07, "timestamp": "01:19:48", "text": "私は彼を見かけなかった。何？再装填中。待って、"}, {"type": "subtitle", "time": 4789.83, "timestamp": "01:19:49", "text": "なぜそうしたのか。ああ、そうだ。うん。待って、私の"}, {"type": "subtitle", "time": 4792.31, "timestamp": "01:19:52", "text": "ウェルカム機能がオンになっています。そうそう。これ"}, {"type": "subtitle", "time": 4797.83, "timestamp": "01:19:57", "text": "ここに来て。ここに来て。だからあなたは"}]
[{"type": "subtitle", "time": 9004.309, "timestamp": "02:30:04", "text": "そして、ゲームもできます。"}, {"type": "subtitle", "time": 9006.07, "timestamp": "02:30:06", "text": "クラウドゲームはいつでもできます"}, {"type": "subtitle", "time": 9009.51, "timestamp": "02:30:09", "text": "欲しい。ああ、そうですね。"}, {"type": "subtitle", "time": 9012.23, "timestamp": "02:30:12", "text": "Xbox ゲーム パス、Xbox コントローラーを入手し、"}, {"type": "subtitle", "time": 9022.79, "timestamp": "02:30:22", "text": "でも、つまり、"}, {"type": "subtitle", "time": 9025.59, "timestamp": "02:30:25", "text": "ローカルゲームほど良くはない、"}, {"type": "subtitle", "time": 9034.79, "timestamp": "02:30:34", "text": "クラウドゲーミングを試したことはありますか？どうだった？"}, {"type": "subtitle", "time": 9037.19, "timestamp": "02:30:37", "text": "イギリスでは良いと知っています。"}, {"type": "subtitle", "time": 9039.51, "timestamp": "02:30:39", "text": "インターネットの速度は限界を超えています"}, {"type": "subtitle", "time": 9042.15, "timestamp": "02:30:42", "text": "のように"}, {"type": "subtitle", "time": 9045.11, "timestamp": "02:30:45", "text": "時々、少し緊張する"}, {"type": "subtitle", "time": 9046.79, "timestamp": "02:30:46", "text": "最も"}, {"type": "subtitle", "time": 9057.99, "timestamp": "02:30:57", "text": "スピードが速ければ"}]
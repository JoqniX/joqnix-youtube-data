[{"type": "subtitle", "time": 300.39, "timestamp": "00:05:00", "text": "バージョン。彼らは「ああ、"}, {"type": "subtitle", "time": 303.27, "timestamp": "00:05:03", "text": "「君にヒーローをあげるよ。」即座にアップグレードしました。"}, {"type": "subtitle", "time": 307.67, "timestamp": "00:05:07", "text": "スペクトラからヒーローへ。それはこれだ"}, {"type": "subtitle", "time": 310.23, "timestamp": "00:05:10", "text": "ねずみ。私が現在使用しているのは"}, {"type": "subtitle", "time": 313.43, "timestamp": "00:05:13", "text": "ヒーロー。しかし、これは"}, {"type": "subtitle", "time": 315.87, "timestamp": "00:05:15", "text": "3年"}, {"type": "subtitle", "time": 323.749, "timestamp": "00:05:23", "text": "痛み。スイッチマウスが必要になるかもしれないが、"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "私が慣れている痛みは"}, {"type": "subtitle", "time": 329.67, "timestamp": "00:05:29", "text": "マクロボタンとキーの設定と"}, {"type": "subtitle", "time": 332.629, "timestamp": "00:05:32", "text": "マウス用のものなので、買わなければならない"}, {"type": "subtitle", "time": 335.59000000000003, "timestamp": "00:05:35", "text": "全く同じもの。ありがとう。ああ、Zファイア"}, {"type": "subtitle", "time": 339.909, "timestamp": "00:05:39", "text": "仕事。えーと、Gire 2 の新作、K のやつ、"}]
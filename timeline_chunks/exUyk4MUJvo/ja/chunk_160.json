[{"type": "subtitle", "time": 9600.07, "timestamp": "02:40:00", "text": "これほどの粘り強さを持つ場所ならどこかにあるはずだ。"}, {"type": "subtitle", "time": 9601.51, "timestamp": "02:40:01", "text": "きっと手に入れるよ"}, {"type": "subtitle", "time": 9605.51, "timestamp": "02:40:05", "text": "いくつかの。うん。私はこれを言っているわけではありません"}, {"type": "subtitle", "time": 9608.309, "timestamp": "02:40:08", "text": "正しいか間違っているか。それはただ、えっと、何"}, {"type": "subtitle", "time": 9610.309, "timestamp": "02:40:10", "text": "何を、何を、どう言えばいいの？"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "それは、もし集中的な努力があれば"}, {"type": "subtitle", "time": 9615.91, "timestamp": "02:40:15", "text": "もしあなたが望むなら、何かに向かって"}, {"type": "subtitle", "time": 9619.15, "timestamp": "02:40:19", "text": "それを達成すれば、必ず達成できます。"}, {"type": "subtitle", "time": 9624.71, "timestamp": "02:40:24", "text": "うん。私が唯一後悔しているのは"}, {"type": "subtitle", "time": 9627.349, "timestamp": "02:40:27", "text": "えっと、これを載せることに罪悪感を感じました"}, {"type": "subtitle", "time": 9629.83, "timestamp": "02:40:29", "text": "V字型のもの。だから私は昔、"}, {"type": "subtitle", "time": 9633.27, "timestamp": "02:40:33", "text": "その日、えっと、私が手に入れたと思う"}, {"type": "subtitle", "time": 9635.91, "timestamp": "02:40:35", "text": "ストリーマーが使用していたものからインスピレーションを受けました"}, {"type": "subtitle", "time": 9638.79, "timestamp": "02:40:38", "text": "彼らが去った時にクリップを再生する"}, {"type": "subtitle", "time": 9641.19, "timestamp": "02:40:41", "text": "配信からか、AFK（離席）中の何か。だから私は"}, {"type": "subtitle", "time": 9643.75, "timestamp": "02:40:43", "text": "アイデアが浮かんだ。ああ、クリップは持っていません。それで"}, {"type": "subtitle", "time": 9647.27, "timestamp": "02:40:47", "text": "なぜ私は自分のストリームをYouTubeに載せないのか"}, {"type": "subtitle", "time": 9650.07, "timestamp": "02:40:50", "text": "YouTube関連のもの？ああ、そうだね。だから、私はそうした。"}, {"type": "subtitle", "time": 9652.79, "timestamp": "02:40:52", "text": "それから私はそれをさらに良くするために"}, {"type": "subtitle", "time": 9657.75, "timestamp": "02:40:57", "text": "ガチャシステムのようなものだ。つまりランダムなV"}]
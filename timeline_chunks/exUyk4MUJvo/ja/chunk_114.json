[{"type": "subtitle", "time": 6840.07, "timestamp": "01:54:00", "text": "私は南インド出身です。それから私は"}, {"type": "chat", "time": 6842.666, "timestamp": "01:54:02", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 6845.51, "timestamp": "01:54:05", "text": "ストリームのようなものをしました。"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "他のプラットフォームの他のクリエイターたち"}, {"type": "subtitle", "time": 6850.95, "timestamp": "01:54:10", "text": "それは私の母語で"}, {"type": "subtitle", "time": 6854.149, "timestamp": "01:54:14", "text": "それはマラヤーラム語だった。だから、もしあなたが"}, {"type": "subtitle", "time": 6856.07, "timestamp": "01:54:16", "text": "十分に深く探せば、すでに"}, {"type": "subtitle", "time": 6859.189, "timestamp": "01:54:19", "text": "私はその地域出身だと明かした"}, {"type": "subtitle", "time": 6862.229, "timestamp": "01:54:22", "text": "あなたが話す言語は"}, {"type": "subtitle", "time": 6864.07, "timestamp": "01:54:24", "text": "すぐに正直に言わなければならないが、"}, {"type": "subtitle", "time": 6866.629, "timestamp": "01:54:26", "text": "しかしマラームは"}, {"type": "subtitle", "time": 6869.83, "timestamp": "01:54:29", "text": "2つの州はとても紛らわしいですが、私は"}, {"type": "subtitle", "time": 6872.75, "timestamp": "01:54:32", "text": "あなたの出身地はだいたい想像がつきます。"}, {"type": "subtitle", "time": 6876.149, "timestamp": "01:54:36", "text": "うん。なぜかはわかりませんが、文字通り"}, {"type": "subtitle", "time": 6879.27, "timestamp": "01:54:39", "text": "自分の配信で簡単にそう言えるけど、"}, {"type": "subtitle", "time": 6882.35, "timestamp": "01:54:42", "text": "時々、私はこう思う、えっと、これは"}, {"type": "subtitle", "time": 6887.589, "timestamp": "01:54:47", "text": "これもタブーなのか？ちょっと、抑えてよ。いいえ、"}, {"type": "subtitle", "time": 6890.55, "timestamp": "01:54:50", "text": "正直に言うと、昔の私は"}, {"type": "subtitle", "time": 6893.27, "timestamp": "01:54:53", "text": "それもまた然り。でも、いや、昔は"}, {"type": "subtitle", "time": 6896.43, "timestamp": "01:54:56", "text": "あなたもそうであるべきだ。しかし、一度整理すれば"}]
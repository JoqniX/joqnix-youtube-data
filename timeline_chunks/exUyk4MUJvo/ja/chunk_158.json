[{"type": "subtitle", "time": 9481.19, "timestamp": "02:38:01", "text": "それは"}, {"type": "subtitle", "time": 9491.27, "timestamp": "02:38:11", "text": "私はそうしなかった。つまり、それはそういうことだ。"}, {"type": "subtitle", "time": 9494.55, "timestamp": "02:38:14", "text": "正気の沙汰とは思えない。"}, {"type": "subtitle", "time": 9497.23, "timestamp": "02:38:17", "text": "あなた、あなた、私"}, {"type": "subtitle", "time": 9499.15, "timestamp": "02:38:19", "text": "考えてみてください"}, {"type": "subtitle", "time": 9501.19, "timestamp": "02:38:21", "text": "私はこの件について何と言えばいいのか分かりません"}, {"type": "subtitle", "time": 9504.79, "timestamp": "02:38:24", "text": "ポイント。これは不可解だ。"}, {"type": "subtitle", "time": 9507.83, "timestamp": "02:38:27", "text": "うん、パソコンをシャットダウンしないといけないんだ。のように"}, {"type": "subtitle", "time": 9510.15, "timestamp": "02:38:30", "text": "確認してみます。誰か誰か"}, {"type": "subtitle", "time": 9512.71, "timestamp": "02:38:32", "text": "そこに来る必要がある、そしてたった6日間"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "つまり、それはまるで狂気の沙汰だった"}, {"type": "subtitle", "time": 9523.59, "timestamp": "02:38:43", "text": "レベル。"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "ふとある考えが浮かんだ"}, {"type": "subtitle", "time": 9529.91, "timestamp": "02:38:49", "text": "いずれ日本へ行くつもりです"}, {"type": "subtitle", "time": 9532.15, "timestamp": "02:38:52", "text": "もの。これが最後になります"}, {"type": "subtitle", "time": 9534.309, "timestamp": "02:38:54", "text": "日本では自由と色々があるから"}, {"type": "subtitle", "time": 9536.63, "timestamp": "02:38:56", "text": "私は責任ある大人でなければならないし"}, {"type": "subtitle", "time": 9538.07, "timestamp": "02:38:58", "text": "もの。いやいや、あなたは"}, {"type": "subtitle", "time": 9539.349, "timestamp": "02:38:59", "text": "あなたは自由を手に入れるでしょう"}]
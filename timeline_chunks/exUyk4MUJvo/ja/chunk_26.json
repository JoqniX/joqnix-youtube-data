[{"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "下がれ。私はここから出て行く。ほんの一瞬だけ。"}, {"type": "subtitle", "time": 1573.87, "timestamp": "00:26:13", "text": "しなければならない"}, {"type": "subtitle", "time": 1582.269, "timestamp": "00:26:22", "text": "そこには。スパイク"}, {"type": "subtitle", "time": 1589.39, "timestamp": "00:26:29", "text": "うん。こんにちは、スノーウィー。うん。こんにちは、"}, {"type": "subtitle", "time": 1601.269, "timestamp": "00:26:41", "text": "敵はあと一体。最後のプレイヤー"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "立っている。"}, {"type": "subtitle", "time": 1618.07, "timestamp": "00:26:58", "text": "Yジョッキーはただジョッキーがただ落ちただけです。何"}]
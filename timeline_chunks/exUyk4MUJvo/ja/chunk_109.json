[{"type": "subtitle", "time": 6542.55, "timestamp": "01:49:02", "text": "彼らは最善を尽くし、彼らを連れてきた"}, {"type": "subtitle", "time": 6545.55, "timestamp": "01:49:05", "text": "そこには。彼らは今、幸せだろう。"}, {"type": "subtitle", "time": 6549.109, "timestamp": "01:49:09", "text": "うん。ええ、これらは目標のようなもので、"}, {"type": "subtitle", "time": 6552.149, "timestamp": "01:49:12", "text": "日本にいる間、ある意味夢を見ているような気分だった"}, {"type": "subtitle", "time": 6555.27, "timestamp": "01:49:15", "text": "それは私が成功するために必要なものです。でも、誰が"}, {"type": "subtitle", "time": 6558.31, "timestamp": "01:49:18", "text": "知っている？間違いなく良い"}, {"type": "subtitle", "time": 6561.189, "timestamp": "01:49:21", "text": "パートタイムの仕事。悪いパートタイムは"}, {"type": "subtitle", "time": 6564.31, "timestamp": "01:49:24", "text": "私にとっては必須です。学校は私に"}, {"type": "subtitle", "time": 6566.39, "timestamp": "01:49:26", "text": "私にとっては必須です。必要"}, {"type": "subtitle", "time": 6568.39, "timestamp": "01:49:28", "text": "私にやらせてください。"}, {"type": "subtitle", "time": 6571.91, "timestamp": "01:49:31", "text": "そう、週28時間くらいかな。"}, {"type": "subtitle", "time": 6574.709, "timestamp": "01:49:34", "text": "やらなければならない。もし私がそれを超えると、"}, {"type": "subtitle", "time": 6577.43, "timestamp": "01:49:37", "text": "違法行為か何か。たくさんあります"}, {"type": "subtitle", "time": 6583.109, "timestamp": "01:49:43", "text": "こちらにはあと20時間しかない"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "パートタイム。私の勤務時間のように、"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "20時間働く。つまり、給料は"}, {"type": "subtitle", "time": 6591.189, "timestamp": "01:49:51", "text": "日本よりも多いはずだが、"}, {"type": "subtitle", "time": 6593.59, "timestamp": "01:49:53", "text": "同時に、こちらでは物価が非常に高い。"}, {"type": "subtitle", "time": 6596.229, "timestamp": "01:49:56", "text": "私を信じて。そうそう"}, {"type": "subtitle", "time": 6598.39, "timestamp": "01:49:58", "text": "1以下は手に入らない"}]
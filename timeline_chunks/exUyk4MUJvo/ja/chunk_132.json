[{"type": "subtitle", "time": 7922.709, "timestamp": "02:12:02", "text": "時間が取れないけど、できる限り努力します"}, {"type": "subtitle", "time": 7924.87, "timestamp": "02:12:04", "text": "ここでいくつかの断片を見て、"}, {"type": "subtitle", "time": 7928.229, "timestamp": "02:12:08", "text": "そこには。私は私は持っています 私は私は昔持っています 私はまだ"}, {"type": "subtitle", "time": 7931.589, "timestamp": "02:12:11", "text": "あちこちで漫画を読んでるけど、えっと"}, {"type": "subtitle", "time": 7933.91, "timestamp": "02:12:13", "text": "信じてくれ、私は本当に理解していない"}, {"type": "subtitle", "time": 7938.229, "timestamp": "02:12:18", "text": "アニメを見る時間がほとんどなくなってしまった。うん。"}, {"type": "subtitle", "time": 7940.709, "timestamp": "02:12:20", "text": "うん。つまり、最近ソロを見たんだけど"}, {"type": "subtitle", "time": 7943.27, "timestamp": "02:12:23", "text": "レベリングが年間最優秀アニメ賞を受賞しました。"}, {"type": "subtitle", "time": 7946.55, "timestamp": "02:12:26", "text": "私はそれに愕然とした。えっと、私は"}, {"type": "subtitle", "time": 7948.87, "timestamp": "02:12:28", "text": "勝つことは分かっていたが、私は予想していた"}, {"type": "subtitle", "time": 7951.27, "timestamp": "02:12:31", "text": "正直に言うと、もっと正直な意見です。えっと、私は思う"}, {"type": "subtitle", "time": 7954.229, "timestamp": "02:12:34", "text": "メッセージを見逃した子供たち"}, {"type": "subtitle", "time": 7956.99, "timestamp": "02:12:36", "text": "または投票した人"}, {"type": "subtitle", "time": 7960.39, "timestamp": "02:12:40", "text": "それ。私はソロは"}, {"type": "subtitle", "time": 7962.31, "timestamp": "02:12:42", "text": "レベリングは、"}, {"type": "subtitle", "time": 7964.229, "timestamp": "02:12:44", "text": "今年最高のアニメ。私を信じて、"}, {"type": "subtitle", "time": 7966.629, "timestamp": "02:12:46", "text": "もっとずっと良いアニメはたくさんあった。"}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "いいえ。"}, {"type": "subtitle", "time": 7970.87, "timestamp": "02:12:50", "text": "正直に言うと、魂を愛することは"}, {"type": "subtitle", "time": 7973.75, "timestamp": "02:12:53", "text": "日本の概念ですらない。確かに、確かに、"}, {"type": "subtitle", "time": 7976.629, "timestamp": "02:12:56", "text": "真実。それは韓国特有のものですよね？うん、"}, {"type": "subtitle", "time": 7978.95, "timestamp": "02:12:58", "text": "これは韓国の漫画で、"}]
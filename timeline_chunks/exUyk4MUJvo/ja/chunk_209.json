[{"type": "subtitle", "time": 12540.07, "timestamp": "03:29:00", "text": "ご存じの通り、8～6ヶ月ほど"}, {"type": "subtitle", "time": 12542.469, "timestamp": "03:29:02", "text": "精神的な活力を与えてくれるので、"}, {"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "両親に会って、あなたのように健康的な食事をしましょう"}, {"type": "subtitle", "time": 12547.349, "timestamp": "03:29:07", "text": "何か食べて、また戻ってくる。おお"}, {"type": "subtitle", "time": 12555.83, "timestamp": "03:29:15", "text": "うん。私の場合はもうすぐ11時55分です。ああ、それは"}, {"type": "subtitle", "time": 12558.87, "timestamp": "03:29:18", "text": "もう12歳だよ。ああ、そうだね。うん。私たちは話しました"}, {"type": "subtitle", "time": 12564.309, "timestamp": "03:29:24", "text": "多く。右に行かなきゃダメだよ。うん、そうだね"}, {"type": "subtitle", "time": 12567.349, "timestamp": "03:29:27", "text": "再び繋がれてよかったです。"}, {"type": "subtitle", "time": 12570.03, "timestamp": "03:29:30", "text": "そうだね、そうだった"}, {"type": "subtitle", "time": 12573.91, "timestamp": "03:29:33", "text": "楽しいことがたくさんあったから、もっとやろうよ"}, {"type": "subtitle", "time": 12577.19, "timestamp": "03:29:37", "text": "将来、もし可能なら、うん、もちろん"}, {"type": "subtitle", "time": 12579.11, "timestamp": "03:29:39", "text": "日本についてはよくわからないし、"}, {"type": "subtitle", "time": 12581.67, "timestamp": "03:29:41", "text": "日本語で私に"}, {"type": "subtitle", "time": 12584.15, "timestamp": "03:29:44", "text": "必ず写真を送りますね"}, {"type": "subtitle", "time": 12587.59, "timestamp": "03:29:47", "text": "そして、あなたが共有してくれることを願っているもの"}, {"type": "subtitle", "time": 12589.83, "timestamp": "03:29:49", "text": "ロンドンからの写真もあります"}, {"type": "subtitle", "time": 12594.15, "timestamp": "03:29:54", "text": "それは「ああ、もちろん」という意味になります。"}, {"type": "subtitle", "time": 12595.87, "timestamp": "03:29:55", "text": "うん。うん。おお、"}]
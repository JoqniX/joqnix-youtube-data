[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "2人部屋、つまり、そうですね"}, {"type": "subtitle", "time": 10143.269, "timestamp": "02:49:03", "text": "部屋全体に"}, {"type": "subtitle", "time": 10145.269, "timestamp": "02:49:05", "text": "家か何かだけど、2つあるよ"}, {"type": "subtitle", "time": 10147.349, "timestamp": "02:49:07", "text": "そういう人たちがいて、部屋が1つある"}, {"type": "subtitle", "time": 10150.309, "timestamp": "02:49:10", "text": "そして2人部屋タイプの2部屋と"}, {"type": "subtitle", "time": 10153.429, "timestamp": "02:49:13", "text": "エアコン付き1名用客室"}, {"type": "subtitle", "time": 10156.71, "timestamp": "02:49:16", "text": "コンディショナーとか、そういう類のもの全部。待って、私は"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "彼らが言っているのは2人かもしれないと思う"}, {"type": "subtitle", "time": 10161.91, "timestamp": "02:49:21", "text": "あなたが来るなら、同じ部屋に住めます"}, {"type": "subtitle", "time": 10163.99, "timestamp": "02:49:23", "text": "誰かと一緒にいる。それは彼らが"}, {"type": "subtitle", "time": 10168.55, "timestamp": "02:49:28", "text": "平均？ H よくわからない。見つけさせてください"}, {"type": "subtitle", "time": 10171.91, "timestamp": "02:49:31", "text": "そういうもの、そしてそれをあなたと共有したいんです。なぜなら"}, {"type": "subtitle", "time": 10174.87, "timestamp": "02:49:34", "text": "それの方が高い？ええ、シングルは"}, {"type": "subtitle", "time": 10177.19, "timestamp": "02:49:37", "text": "シングルルームは少し高めです。"}, {"type": "subtitle", "time": 10178.99, "timestamp": "02:49:38", "text": "うん。"}, {"type": "subtitle", "time": 10182.469, "timestamp": "02:49:42", "text": "ああ、だって私は、これは"}, {"type": "subtitle", "time": 10184.63, "timestamp": "02:49:44", "text": "ちょっとやりすぎだ。私は、私は知らない"}, {"type": "subtitle", "time": 10186.79, "timestamp": "02:49:46", "text": "1つの部屋を共有する"}, {"type": "subtitle", "time": 10188.309, "timestamp": "02:49:48", "text": "他の誰か。えっと、よくわからないんだけど"}, {"type": "subtitle", "time": 10190.07, "timestamp": "02:49:50", "text": "それ。"}, {"type": "subtitle", "time": 10191.91, "timestamp": "02:49:51", "text": "キッチンを共有するのは問題ありません。いいね、シェア"}, {"type": "subtitle", "time": 10193.86, "timestamp": "02:49:53", "text": "キッチンはまあまあです。"}, {"type": "subtitle", "time": 10195.429, "timestamp": "02:49:55", "text": "[音楽]"}, {"type": "subtitle", "time": 10197.91, "timestamp": "02:49:57", "text": "つまり、私たちは国際的なシェアハウスを運営しているということです。"}, {"type": "subtitle", "time": 10199.59, "timestamp": "02:49:59", "text": "さまざまな国からの多くの学生"}]
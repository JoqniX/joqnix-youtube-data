[{"type": "subtitle", "time": 17342.59, "timestamp": "04:49:02", "text": "そしてそれをもう一度繰り返す"}, {"type": "subtitle", "time": 17345.59, "timestamp": "04:49:05", "text": "Twitch YouTube Twitch YouTube Twitch すべて"}, {"type": "subtitle", "time": 17349.99, "timestamp": "04:49:09", "text": "毎日1日、永遠に配信しない"}, {"type": "subtitle", "time": 17352.07, "timestamp": "04:49:12", "text": "クソ気にしないで、もっとストリーミングしたい、"}, {"type": "subtitle", "time": 17355.99, "timestamp": "04:49:15", "text": "スタンドを最大限に活用するために、そうですね。"}, {"type": "subtitle", "time": 17358.39, "timestamp": "04:49:18", "text": "他のこともやらないでください"}, {"type": "subtitle", "time": 17359.708, "timestamp": "04:49:19", "text": "心配する"}, {"type": "subtitle", "time": 17363.11, "timestamp": "04:49:23", "text": "健康については心配しないでください"}, {"type": "subtitle", "time": 17365.03, "timestamp": "04:49:25", "text": "これらのストリームはすべて"}, {"type": "subtitle", "time": 17368.39, "timestamp": "04:49:28", "text": "これらのストリームは、不適切です。"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "何をしたらいいかわからない、アイデアが尽きた"}, {"type": "subtitle", "time": 17374.868, "timestamp": "04:49:34", "text": "配信はしていませんが、来てくれてありがとう。"}, {"type": "subtitle", "time": 17377.11, "timestamp": "04:49:37", "text": "お越しいただきありがとうございます。それは本当に"}, {"type": "subtitle", "time": 17379.868, "timestamp": "04:49:39", "text": "多く。また、ゲーム配信も行います。"}, {"type": "subtitle", "time": 17387.83, "timestamp": "04:49:47", "text": "知る。ああ神様、もうほとんど準備が整いました"}, {"type": "subtitle", "time": 17391.03, "timestamp": "04:49:51", "text": "ああ神様、私はすでに"}, {"type": "subtitle", "time": 17393.15, "timestamp": "04:49:53", "text": "落ちた。"}, {"type": "subtitle", "time": 17394.75, "timestamp": "04:49:54", "text": "神。"}, {"type": "subtitle", "time": 17397.708, "timestamp": "04:49:57", "text": "ああ、くそ。"}]
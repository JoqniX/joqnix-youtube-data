[{"type": "subtitle", "time": 16801.55, "timestamp": "04:40:01", "text": "「私がやる」と言うのをやめて、ただ実行してください"}, {"type": "subtitle", "time": 16833.67, "timestamp": "04:40:33", "text": "わかった。今日は本当にいい天気だった。私"}, {"type": "subtitle", "time": 16837.03, "timestamp": "04:40:37", "text": "もっとうまくできたはずだ。くそ。"}, {"type": "subtitle", "time": 16839.27, "timestamp": "04:40:39", "text": "でも、それでも、それでも、それでも、ミア、私は"}, {"type": "subtitle", "time": 16842.43, "timestamp": "04:40:42", "text": "希望の人々が"}, {"type": "subtitle", "time": 16844.43, "timestamp": "04:40:44", "text": "あなた"}, {"type": "subtitle", "time": 16847.99, "timestamp": "04:40:47", "text": "みんな楽しんでいる。私はそうしなかったけれど、"}, {"type": "subtitle", "time": 16850.47, "timestamp": "04:40:50", "text": "少なくとも、あなたは"}, {"type": "subtitle", "time": 16851.55, "timestamp": "04:40:51", "text": "ストリーム。"}, {"type": "subtitle", "time": 16858.83, "timestamp": "04:40:58", "text": "もう一度、どうぞお楽しみください。"}]
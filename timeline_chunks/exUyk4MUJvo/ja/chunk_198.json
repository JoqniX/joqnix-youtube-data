[{"type": "subtitle", "time": 11882.309, "timestamp": "03:18:02", "text": "YouTubeを始めてもう6年になります。だからそれは"}, {"type": "subtitle", "time": 11885.67, "timestamp": "03:18:05", "text": "提供できなくて申し訳なく、悲しい気持ちになった"}, {"type": "subtitle", "time": 11887.99, "timestamp": "03:18:07", "text": "何か新しいこと。もし私が"}, {"type": "subtitle", "time": 11890.71, "timestamp": "03:18:10", "text": "3Dモデル、衣装のようなものがあれば、"}, {"type": "subtitle", "time": 11892.79, "timestamp": "03:18:12", "text": "自分の服とか、そういうのを自分で作るんだよね？"}, {"type": "subtitle", "time": 11894.95, "timestamp": "03:18:14", "text": "ライブ2Dに関しては、"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "限られているんですよね？あなたは、"}, {"type": "subtitle", "time": 11898.87, "timestamp": "03:18:18", "text": "自分でやる、あるいは依頼するなど。"}, {"type": "subtitle", "time": 11901.99, "timestamp": "03:18:21", "text": "それは、あなたが描くことができるということです。私は苦手です"}, {"type": "subtitle", "time": 11904.63, "timestamp": "03:18:24", "text": "絵を描くことはできますが、今は練習中です。私はできません"}, {"type": "subtitle", "time": 11909.429, "timestamp": "03:18:29", "text": "色塗りとかはできるけど、線画は描けるよ。"}, {"type": "subtitle", "time": 11912.07, "timestamp": "03:18:32", "text": "つまり"}, {"type": "subtitle", "time": 11916.15, "timestamp": "03:18:36", "text": "でも正直に言うと、私は"}, {"type": "subtitle", "time": 11918.63, "timestamp": "03:18:38", "text": "実際にはこのような立場になるだろう"}, {"type": "subtitle", "time": 11921.11, "timestamp": "03:18:41", "text": "だって、最終的には私は「うん、私は"}, {"type": "subtitle", "time": 11923.83, "timestamp": "03:18:43", "text": "絵を描こう"}, {"type": "subtitle", "time": 11927.429, "timestamp": "03:18:47", "text": "いや、いや、いや。えーっと、つまり、"}, {"type": "subtitle", "time": 11930.229, "timestamp": "03:18:50", "text": "その支援を受けることで"}, {"type": "subtitle", "time": 11934.389, "timestamp": "03:18:54", "text": "その場所にいる機会"}, {"type": "subtitle", "time": 11936.229, "timestamp": "03:18:56", "text": "物事の。うん。約束された場所のように"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "これとあれとこれとあれが欲しい"}]
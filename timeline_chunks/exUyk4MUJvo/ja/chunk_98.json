[{"type": "subtitle", "time": 5881.99, "timestamp": "01:38:01", "text": "うん。たとえ私が"}, {"type": "subtitle", "time": 5886.709, "timestamp": "01:38:06", "text": "いなくなった？ 私はまだそこにいる。はい。はい。うん。"}, {"type": "subtitle", "time": 5888.709, "timestamp": "01:38:08", "text": "おや、新しいアバターですね。私は見たことがない"}, {"type": "subtitle", "time": 5892.229, "timestamp": "01:38:12", "text": "それ。ああ、これだ。そこになかったのか？"}, {"type": "subtitle", "time": 5895.03, "timestamp": "01:38:15", "text": "前回お話したのはいつでしたか？"}, {"type": "subtitle", "time": 5898.709, "timestamp": "01:38:18", "text": "いいえ。いいえ。あなたがそれを描くのですか？ああ、これは"}, {"type": "subtitle", "time": 5900.51, "timestamp": "01:38:20", "text": "私への贈り物。"}, {"type": "subtitle", "time": 5905.189, "timestamp": "01:38:25", "text": "えーと、私のアーティストの友人が私の絵を描いてくれました"}, {"type": "subtitle", "time": 5908.39, "timestamp": "01:38:28", "text": "ファンアートを描きました。彼女は一度描いた"}, {"type": "subtitle", "time": 5910.95, "timestamp": "01:38:30", "text": "私と彼女はそれを監督した"}, {"type": "subtitle", "time": 5913.109, "timestamp": "01:38:33", "text": "2Dモデルの作成方法を学び、"}, {"type": "subtitle", "time": 5914.79, "timestamp": "01:38:34", "text": "もの。"}, {"type": "subtitle", "time": 5916.709, "timestamp": "01:38:36", "text": "ああ、彼女はすごくクールだね。"}, {"type": "subtitle", "time": 5919.669, "timestamp": "01:38:39", "text": "えっと、これは2Dですか、それとも3Dですか？それは"}, {"type": "subtitle", "time": 5924.31, "timestamp": "01:38:44", "text": "3D。これは2Dです。 2D。私は、私は、私は"}, {"type": "subtitle", "time": 5929.43, "timestamp": "01:38:49", "text": "私には下半身のような体型はありません。"}, {"type": "subtitle", "time": 5931.109, "timestamp": "01:38:51", "text": "ああ、下位グレードはないんですね。わかった。わかった。"}, {"type": "subtitle", "time": 5934.87, "timestamp": "01:38:54", "text": "私たちはそのことについては話しません。"}, {"type": "subtitle", "time": 5937.03, "timestamp": "01:38:57", "text": "何てことだ。"}]
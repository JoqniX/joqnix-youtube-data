[{"type": "subtitle", "time": 10747.03, "timestamp": "02:59:07", "text": "あなたはたくさんの"}, {"type": "subtitle", "time": 10748.59, "timestamp": "02:59:08", "text": "もの。"}, {"type": "subtitle", "time": 10754.71, "timestamp": "02:59:14", "text": "何てことだ。個室が取れるといいな。"}, {"type": "subtitle", "time": 10756.71, "timestamp": "02:59:16", "text": "私は彼らに何度もそう言ってきた"}, {"type": "subtitle", "time": 10760.23, "timestamp": "02:59:20", "text": "回。だから、彼らが私を優先してくれることを願っています。"}, {"type": "subtitle", "time": 10762.389, "timestamp": "02:59:22", "text": "個室を借りてください。手に入れないで"}, {"type": "subtitle", "time": 10765.19, "timestamp": "02:59:25", "text": "ダブルルーム。つまり、どれくらい"}, {"type": "subtitle", "time": 10767.51, "timestamp": "02:59:27", "text": "高価です。それは、そうではありません。"}, {"type": "subtitle", "time": 10770.11, "timestamp": "02:59:30", "text": "それは高価で、"}, {"type": "subtitle", "time": 10772.389, "timestamp": "02:59:32", "text": "費用については忘れてください。忘れてください"}, {"type": "subtitle", "time": 10774.469, "timestamp": "02:59:34", "text": "費用。精神的な部分"}, {"type": "subtitle", "time": 10778.87, "timestamp": "02:59:38", "text": "それは違う。うん。"}, {"type": "subtitle", "time": 10781.75, "timestamp": "02:59:41", "text": "それは、あなたが優先しなければならないあなた自身のようなものです"}, {"type": "subtitle", "time": 10784.429, "timestamp": "02:59:44", "text": "何よりもまず、あなたの心の平安が大切です。"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "知ってるよ、知ってるよ、一緒に暮らすのが好き"}, {"type": "subtitle", "time": 10788.79, "timestamp": "02:59:48", "text": "あなたの両親かもしれない人、ああ、あなた"}, {"type": "subtitle", "time": 10790.75, "timestamp": "02:59:50", "text": "誰かと一緒に暮らすべき理由は"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "えっと、それはあなたが行くからだよ"}, {"type": "subtitle", "time": 10795.349, "timestamp": "02:59:55", "text": "初めて外に出たとか"}, {"type": "subtitle", "time": 10797.51, "timestamp": "02:59:57", "text": "そんな時は、何らかのサポートが必要です。"}]
[{"type": "subtitle", "time": 11760.309, "timestamp": "03:16:00", "text": "もしその値段を見たら、私は"}, {"type": "subtitle", "time": 11763.07, "timestamp": "03:16:03", "text": "断った。"}, {"type": "subtitle", "time": 11766.469, "timestamp": "03:16:06", "text": "「はい、ありがとうございます」という感じで始めます。またね"}, {"type": "subtitle", "time": 11769.429, "timestamp": "03:16:09", "text": "後で。"}, {"type": "subtitle", "time": 11772.469, "timestamp": "03:16:12", "text": "うーん、それを正当化する方法が見当たらないですね。"}, {"type": "subtitle", "time": 11774.469, "timestamp": "03:16:14", "text": "あなたなら誰よりも上手くできるかもしれない"}, {"type": "subtitle", "time": 11776.63, "timestamp": "03:16:16", "text": "なぜなら、おそらく"}, {"type": "subtitle", "time": 11778.63, "timestamp": "03:16:18", "text": "私よりずっと上手です。私は 私は 私は"}, {"type": "subtitle", "time": 11780.87, "timestamp": "03:16:20", "text": "その意味では無知だ。私は無知です。"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "いや、[ __ ]だ。ただ、それは"}, {"type": "subtitle", "time": 11787.269, "timestamp": "03:16:27", "text": "えっと、私はそのモデルが本当に好きで、"}, {"type": "subtitle", "time": 11790.07, "timestamp": "03:16:30", "text": "彼らにそれを入れたくなかった"}, {"type": "subtitle", "time": 11792.63, "timestamp": "03:16:32", "text": "ゴミ箱に入れて、あとは忘れてしまいましょう。私"}, {"type": "subtitle", "time": 11795.83, "timestamp": "03:16:35", "text": "私はそれを許すことができなかった"}, {"type": "subtitle", "time": 11798.55, "timestamp": "03:16:38", "text": "他の人たちと一緒に座って、"}, {"type": "subtitle", "time": 11802.229, "timestamp": "03:16:42", "text": "いい人だ。うん。私はただ感じた"}, {"type": "subtitle", "time": 11804.71, "timestamp": "03:16:44", "text": "たとえ3、4時間かかっても"}, {"type": "subtitle", "time": 11807.99, "timestamp": "03:16:47", "text": "数年後、悪者になった。"}, {"type": "subtitle", "time": 11809.75, "timestamp": "03:16:49", "text": "うん。たとえ4、5年かかっても"}, {"type": "subtitle", "time": 11811.51, "timestamp": "03:16:51", "text": "このモデルをデビューさせるのに何年もかかりましたが、"}, {"type": "subtitle", "time": 11814.15, "timestamp": "03:16:54", "text": "少なくとも"}, {"type": "subtitle", "time": 11819.19, "timestamp": "03:16:59", "text": "それを使ってみて、うん。私は母です"}]
[{"type": "subtitle", "time": 15900.349, "timestamp": "04:25:00", "text": "小川。午前8時に起床"}, {"type": "subtitle", "time": 15903.03, "timestamp": "04:25:03", "text": "午後つまり、寝て起きると"}, {"type": "subtitle", "time": 15906.67, "timestamp": "04:25:06", "text": "午後8時Twitchで配信を開始する"}, {"type": "subtitle", "time": 15910.229, "timestamp": "04:25:10", "text": "午前3時まで。それから終了して"}, {"type": "subtitle", "time": 15911.55, "timestamp": "04:25:11", "text": "今日。"}, {"type": "subtitle", "time": 15914.99, "timestamp": "04:25:14", "text": "わかった。ええ、それは"}, {"type": "subtitle", "time": 15918.75, "timestamp": "04:25:18", "text": "スケジュール。つまり、"}, {"type": "subtitle", "time": 15921.149, "timestamp": "04:25:21", "text": "うん。強くありなさい。"}, {"type": "subtitle", "time": 15923.149, "timestamp": "04:25:23", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 15926.149, "timestamp": "04:25:26", "text": "こんにちは。日本語で話したいです。えっと、"}, {"type": "subtitle", "time": 15928.79, "timestamp": "04:25:28", "text": "それを試してみようかな？話している。また、私は"}, {"type": "subtitle", "time": 15932.67, "timestamp": "04:25:32", "text": "歌唱力を向上させるために、"}, {"type": "subtitle", "time": 15935.429, "timestamp": "04:25:35", "text": "あまりにも。だから、私も芸術の腕を磨きたいんです。私"}, {"type": "subtitle", "time": 15937.349, "timestamp": "04:25:37", "text": "音楽制作のスキルも向上させたい。私"}, {"type": "subtitle", "time": 15940.03, "timestamp": "04:25:40", "text": "キーボードとピアノも習いたい。"}, {"type": "subtitle", "time": 15943.91, "timestamp": "04:25:43", "text": "くそ。これらすべてを配信で行うことはありますか？"}, {"type": "subtitle", "time": 15944.91, "timestamp": "04:25:44", "text": "それはそうだろうか"}, {"type": "subtitle", "time": 15952.189, "timestamp": "04:25:52", "text": "それは車でしょうか？それは"}, {"type": "subtitle", "time": 15959.55, "timestamp": "04:25:59", "text": "つまり、私ならできるってこと。"}]
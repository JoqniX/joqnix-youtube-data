[{"type": "subtitle", "time": 14050.55, "timestamp": "03:54:10", "text": "面白い。ええ、垂直ストリーミングは"}, {"type": "subtitle", "time": 14053.75, "timestamp": "03:54:13", "text": "ちなみに、Twitchにも登場予定です。"}, {"type": "subtitle", "time": 14057.67, "timestamp": "03:54:17", "text": "デュアルフォーマットのストリーミングと視聴"}, {"type": "subtitle", "time": 14059.75, "timestamp": "03:54:19", "text": "今年の後半。水平方向に流れる"}, {"type": "subtitle", "time": 14061.189, "timestamp": "03:54:21", "text": "そして同時に垂直方向にも。だからあなたの"}, {"type": "subtitle", "time": 14063.59, "timestamp": "03:54:23", "text": "ストリームワークは、ディヤードを妨害し、"}, {"type": "subtitle", "time": 14066.03, "timestamp": "03:54:26", "text": "電話のスクロールバー。もう横首は気にしなくていい"}, {"type": "subtitle", "time": 14069.87, "timestamp": "03:54:29", "text": "横向きに。これは実際には"}, {"type": "subtitle", "time": 14072.63, "timestamp": "03:54:32", "text": "いいね。 2Kストリーミングに先行アクセス"}, {"type": "subtitle", "time": 14074.87, "timestamp": "03:54:34", "text": "ベータ。私たちはこれを2K全体に拡大しています"}, {"type": "subtitle", "time": 14078.229, "timestamp": "03:54:38", "text": "144Bストリーミング。クリアストリーム報酬"}, {"type": "subtitle", "time": 14081.189, "timestamp": "03:54:41", "text": "ロールアップストリーミングHD。"}, {"type": "subtitle", "time": 14084.269, "timestamp": "03:54:44", "text": "アクセスするには登録が必要です。では、そうします"}, {"type": "subtitle", "time": 14087.67, "timestamp": "03:54:47", "text": "実際はできないけど、それでも私は"}]
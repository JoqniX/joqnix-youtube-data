[{"type": "subtitle", "time": 9361.19, "timestamp": "02:36:01", "text": "それもまた然り。うん、そうだね、そうだね"}, {"type": "subtitle", "time": 9362.79, "timestamp": "02:36:02", "text": "人生の終わりに良い息子になりたい"}, {"type": "subtitle", "time": 9366.63, "timestamp": "02:36:06", "text": "日。はい。真実。真実。うん。うん。"}, {"type": "subtitle", "time": 9368.63, "timestamp": "02:36:08", "text": "なぜなら、私は知っている、私は知っている、私は知っている、それは"}, {"type": "subtitle", "time": 9371.19, "timestamp": "02:36:11", "text": "何でも言うのは簡単だけど、あなたは知らない"}, {"type": "subtitle", "time": 9373.75, "timestamp": "02:36:13", "text": "でも、あなたは両親が恋しくなるでしょう"}, {"type": "subtitle", "time": 9378.79, "timestamp": "02:36:18", "text": "いつかは誰かが。うん。うん。"}, {"type": "subtitle", "time": 9381.11, "timestamp": "02:36:21", "text": "今でも彼らが恋しい。いつになるかわかりません"}, {"type": "subtitle", "time": 9384.63, "timestamp": "02:36:24", "text": "これからは、その罪悪感が残るだろうと分かります。"}, {"type": "subtitle", "time": 9387.59, "timestamp": "02:36:27", "text": "おお。私はたくさんの時間を費やしています"}, {"type": "subtitle", "time": 9389.83, "timestamp": "02:36:29", "text": "3 4 ほぼ 4 開始"}, {"type": "subtitle", "time": 9392.71, "timestamp": "02:36:32", "text": "電話。彼らにチャンスを与えてあげて、あなたは"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "いつでもいつでも"}, {"type": "subtitle", "time": 9395.75, "timestamp": "02:36:35", "text": "いつかは"}, {"type": "subtitle", "time": 9399.27, "timestamp": "02:36:39", "text": "彼らにチャンスを与えて、ああ、あなたは"}, {"type": "subtitle", "time": 9402.15, "timestamp": "02:36:42", "text": "良い息子ではなかった、あなたは知っておく必要がある"}, {"type": "subtitle", "time": 9403.91, "timestamp": "02:36:43", "text": "どこかで私が良い息子だったと主張した"}, {"type": "subtitle", "time": 9409.349, "timestamp": "02:36:49", "text": "どこかの時点で。うん。"}, {"type": "subtitle", "time": 9411.349, "timestamp": "02:36:51", "text": "うん。つまり、あなたはそれを受け取るべきだと思う"}, {"type": "subtitle", "time": 9413.51, "timestamp": "02:36:53", "text": "これで簡単になった。少しペースを落とした方がいいよ。"}, {"type": "subtitle", "time": 9415.99, "timestamp": "02:36:55", "text": "スケジュールの設定方法を確認する"}, {"type": "subtitle", "time": 9419.03, "timestamp": "02:36:59", "text": "日本、日本でのやり方、"}]
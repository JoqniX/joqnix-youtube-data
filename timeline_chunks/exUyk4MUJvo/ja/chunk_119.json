[{"type": "subtitle", "time": 7140.31, "timestamp": "01:59:00", "text": "えっと、どう言えばいいかな？それは、えっと、あなた"}, {"type": "subtitle", "time": 7143.03, "timestamp": "01:59:03", "text": "あなたはママで、あなたのアーティストが作った"}, {"type": "subtitle", "time": 7147.589, "timestamp": "01:59:07", "text": "あなたのモデルや物、そしてあなたが行くところ"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "彼らとの独占契約はこう言って"}, {"type": "subtitle", "time": 7153.27, "timestamp": "01:59:13", "text": "アーティストに、あなたが作るべきではないもの"}, {"type": "subtitle", "time": 7156.149, "timestamp": "01:59:16", "text": "他のクリエイター向けのモデルやその他"}, {"type": "subtitle", "time": 7158.629, "timestamp": "01:59:18", "text": "もしそれがあなたのとても親しい人なら"}, {"type": "subtitle", "time": 7161.03, "timestamp": "01:59:21", "text": "友達とか、シンダーのとても"}, {"type": "subtitle", "time": 7163.27, "timestamp": "01:59:23", "text": "親しい友人たちは皆、Bow the Veil のようだった"}, {"type": "subtitle", "time": 7166.39, "timestamp": "01:59:26", "text": "あの大きなユーチューバーたちは、いいえ、そしてすべての"}, {"type": "subtitle", "time": 7169.51, "timestamp": "01:59:29", "text": "これらの人々は、彼らのプロジェクトを持っていました。"}, {"type": "subtitle", "time": 7172.87, "timestamp": "01:59:32", "text": "シンダーのアーティスト、ナノラスだと思います。"}, {"type": "subtitle", "time": 7178.39, "timestamp": "01:59:38", "text": "彼女の名前。ええと、そう、彼女はシンダーです"}, {"type": "subtitle", "time": 7182.47, "timestamp": "01:59:42", "text": "そして、彼女のマネージャーもこの件に関与していた。えーと"}, {"type": "subtitle", "time": 7184.79, "timestamp": "01:59:44", "text": "彼らは"}, {"type": "subtitle", "time": 7188.149, "timestamp": "01:59:48", "text": "ナノイスト、アーティスト、そうしないで"}, {"type": "subtitle", "time": 7190.79, "timestamp": "01:59:50", "text": "他のクリエイターとのコラボレーションやその他諸々"}, {"type": "subtitle", "time": 7194.149, "timestamp": "01:59:54", "text": "そして、アーティストはそれを実行した"}, {"type": "subtitle", "time": 7196.149, "timestamp": "01:59:56", "text": "健康上の理由などあらゆる言い訳"}]
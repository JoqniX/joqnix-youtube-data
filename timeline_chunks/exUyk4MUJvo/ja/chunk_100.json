[{"type": "subtitle", "time": 6000.31, "timestamp": "01:40:00", "text": "料理して詰め込む"}, {"type": "subtitle", "time": 6002.27, "timestamp": "01:40:02", "text": "私を信じて"}, {"type": "subtitle", "time": 6005.35, "timestamp": "01:40:05", "text": "それは、サバイバル料理のことだ。わかった。私はまだ"}, {"type": "subtitle", "time": 6008.709, "timestamp": "01:40:08", "text": "肉のように調理する方法を学ぶ必要がある"}, {"type": "subtitle", "time": 6010.55, "timestamp": "01:40:10", "text": "魚もその他いろいろ。私が"}, {"type": "subtitle", "time": 6012.709, "timestamp": "01:40:12", "text": "学習方法と準備方法を学ぶ必要がある。いいえ、"}, {"type": "subtitle", "time": 6014.55, "timestamp": "01:40:14", "text": "いいえ、信じてください、あなたは"}, {"type": "subtitle", "time": 6016.79, "timestamp": "01:40:16", "text": "私は日本語が大好きなので"}, {"type": "subtitle", "time": 6019.43, "timestamp": "01:40:19", "text": "食べ物。つまり、私はカットカレーが好きなんです"}, {"type": "subtitle", "time": 6021.43, "timestamp": "01:40:21", "text": "それに、物とか全部。そしてあなたは"}, {"type": "subtitle", "time": 6023.669, "timestamp": "01:40:23", "text": "間違いなくインド人を見つけるつもりだ"}, {"type": "subtitle", "time": 6025.51, "timestamp": "01:40:25", "text": "そこにはインド料理がある。インド風ではない"}, {"type": "subtitle", "time": 6029.75, "timestamp": "01:40:29", "text": "食べ物はどこにでもある。うん。しかし、"}, {"type": "subtitle", "time": 6032.99, "timestamp": "01:40:32", "text": "あなたが特定のことを好まない点"}, {"type": "subtitle", "time": 6036.229, "timestamp": "01:40:36", "text": "もの。わからない。わからない"}, {"type": "subtitle", "time": 6038.95, "timestamp": "01:40:38", "text": "もしあなたがそれを食べるなら、えっと、何て言うんだっけ？牛肉または"}, {"type": "subtitle", "time": 6040.709, "timestamp": "01:40:40", "text": "ない。もし食べるなら、牛肉を食べるべきだ。うん。"}, {"type": "subtitle", "time": 6044.07, "timestamp": "01:40:44", "text": "ええ、そうです。わかった。牛肉を食べるなら"}, {"type": "subtitle", "time": 6046.31, "timestamp": "01:40:46", "text": "多くの点で問題ないはずです"}, {"type": "subtitle", "time": 6048.39, "timestamp": "01:40:48", "text": "日本料理。"}, {"type": "subtitle", "time": 6049.99, "timestamp": "01:40:49", "text": "うん。"}, {"type": "subtitle", "time": 6053.31, "timestamp": "01:40:53", "text": "だって、つまり、あなたは私よりよく知っているから"}, {"type": "subtitle", "time": 6056.87, "timestamp": "01:40:56", "text": "でも、日本のスープの中には"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "私たちの味覚にはそれほど辛くないかもしれません。"}]
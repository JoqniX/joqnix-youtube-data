[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "ええ、これはまるで"}, {"type": "subtitle", "time": 5943.109, "timestamp": "01:39:03", "text": "初期設計メッシュ。私は公式の"}, {"type": "subtitle", "time": 5944.109, "timestamp": "01:39:04", "text": "1つ"}, {"type": "subtitle", "time": 5946.79, "timestamp": "01:39:06", "text": "来るよ。だからこそ私は"}, {"type": "subtitle", "time": 5950.229, "timestamp": "01:39:10", "text": "ある意味、ジョックマラソンみたいなものだ。うん"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "ええ、それは作業中です。もちろん。"}, {"type": "subtitle", "time": 5956.39, "timestamp": "01:39:16", "text": "それはかなりすごいですね。それはかなり"}, {"type": "subtitle", "time": 5959.189, "timestamp": "01:39:19", "text": "うん。あなたの配信は"}, {"type": "subtitle", "time": 5962.55, "timestamp": "01:39:22", "text": "どこか別の場所に行くの？はい、そうしました。"}, {"type": "subtitle", "time": 5966.39, "timestamp": "01:39:26", "text": "行くことについて全て彼らに話す"}, {"type": "subtitle", "time": 5969.35, "timestamp": "01:39:29", "text": "日本とかに行くとか。"}, {"type": "subtitle", "time": 5972.31, "timestamp": "01:39:32", "text": "そうそう。何かワクワクすることはありますか？"}, {"type": "subtitle", "time": 5975.189, "timestamp": "01:39:35", "text": "それとも、あなたはもっと心配しているのですか？ええ、両方"}, {"type": "subtitle", "time": 5978.79, "timestamp": "01:39:38", "text": "実際、興奮しています。なぜなら、"}, {"type": "subtitle", "time": 5982.39, "timestamp": "01:39:42", "text": "私の人生の新たな弧、新たな章"}, {"type": "subtitle", "time": 5985.31, "timestamp": "01:39:45", "text": "独立した生活を送り、"}, {"type": "subtitle", "time": 5988.39, "timestamp": "01:39:48", "text": "すべて自分でやっています。"}, {"type": "subtitle", "time": 5990.79, "timestamp": "01:39:50", "text": "私は両親からすでに甘やかされているので"}, {"type": "subtitle", "time": 5995.75, "timestamp": "01:39:55", "text": "私は一人っ子で、"}, {"type": "subtitle", "time": 5997.99, "timestamp": "01:39:57", "text": "私は学ぶ必要がある"}]
[{"type": "subtitle", "time": 8223.19, "timestamp": "02:17:03", "text": "試合を呼んだ？イカゲーム。ああ、そうですね。"}, {"type": "subtitle", "time": 8228.389, "timestamp": "02:17:08", "text": "時間がなかったんです。うん。"}, {"type": "subtitle", "time": 8230.87, "timestamp": "02:17:10", "text": "えっと、でもそのうちの1つは好きかな"}, {"type": "subtitle", "time": 8233.349, "timestamp": "02:17:13", "text": "数エピソードを見たとき、人生は"}, {"type": "subtitle", "time": 8235.83, "timestamp": "02:17:15", "text": "みかんちゃんたち。"}, {"type": "subtitle", "time": 8238.549, "timestamp": "02:17:18", "text": "ああ、Netflixで見たことがあると思う。"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "わからない。私は見ていません。うん、そうだね"}, {"type": "subtitle", "time": 8243.99, "timestamp": "02:17:23", "text": "大丈夫でした。まあまあだったと言えるでしょう"}, {"type": "subtitle", "time": 8246.03, "timestamp": "02:17:26", "text": "私が"}, {"type": "subtitle", "time": 8249.83, "timestamp": "02:17:29", "text": "もし私が"}, {"type": "subtitle", "time": 8252.11, "timestamp": "02:17:32", "text": "方法？もし私が"}, {"type": "subtitle", "time": 8255.549, "timestamp": "02:17:35", "text": "25歳"}, {"type": "subtitle", "time": 8257.79, "timestamp": "02:17:37", "text": "古い、私は"}, {"type": "subtitle", "time": 8260.95, "timestamp": "02:17:40", "text": "そうではなく、もし私が25歳で、もし私が"}, {"type": "subtitle", "time": 8264.469, "timestamp": "02:17:44", "text": "時間があったら、もし私が泣きたかったら"}, {"type": "subtitle", "time": 8268.79, "timestamp": "02:17:48", "text": "でも、私はそれが好きだったでしょうね。"}, {"type": "subtitle", "time": 8273.349, "timestamp": "02:17:53", "text": "私はまだ25歳になっていません"}, {"type": "subtitle", "time": 8277.07, "timestamp": "02:17:57", "text": "そして、私は泣きたくない。"}, {"type": "subtitle", "time": 8279.91, "timestamp": "02:17:59", "text": "だから今のところ私は大丈夫です"}]
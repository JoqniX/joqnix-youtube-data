[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "でも、ストリーマーだけは絶対に買わないでください。"}, {"type": "subtitle", "time": 9962.469, "timestamp": "02:46:02", "text": "狂ったストリーマーをそんな風に手に入れないでください"}, {"type": "subtitle", "time": 9965.349, "timestamp": "02:46:05", "text": "あなたと同じように。うん。"}, {"type": "subtitle", "time": 9968.63, "timestamp": "02:46:08", "text": "何てことだ。うん。"}, {"type": "subtitle", "time": 9970.63, "timestamp": "02:46:10", "text": "彼女が狂っているなら、あなたの家は"}, {"type": "subtitle", "time": 9972.55, "timestamp": "02:46:12", "text": "乱暴に扱う。誰も入ろうとはしなかった"}, {"type": "subtitle", "time": 9975.269, "timestamp": "02:46:15", "text": "では、あなたの家ですね。"}, {"type": "subtitle", "time": 9976.95, "timestamp": "02:46:16", "text": "それは本当です。真実。どれくらい大きいかわかりません"}, {"type": "subtitle", "time": 9978.309, "timestamp": "02:46:18", "text": "部屋はあります。あなたは持っていますか"}, {"type": "subtitle", "time": 9981.91, "timestamp": "02:46:21", "text": "向こうで部屋とか予約したの？だから私は"}, {"type": "subtitle", "time": 9984.03, "timestamp": "02:46:24", "text": "私はその情報を入手しようと思います"}, {"type": "subtitle", "time": 9988.23, "timestamp": "02:46:28", "text": "それ以前の今月までにドメトリを計測する。ああ、"}, {"type": "subtitle", "time": 9990.55, "timestamp": "02:46:30", "text": "そうするつもり？うん。だから私を信じて、"}, {"type": "subtitle", "time": 9992.95, "timestamp": "02:46:32", "text": "良いトイレを手に入れることができます"}, {"type": "subtitle", "time": 9995.429, "timestamp": "02:46:35", "text": "そこには。日本のトイレは最高です"}, {"type": "subtitle", "time": 9998.23, "timestamp": "02:46:38", "text": "世界。それで、ああ、"}, {"type": "subtitle", "time": 9999.349, "timestamp": "02:46:39", "text": "あなたができることはすべて、"}, {"type": "subtitle", "time": 10003.19, "timestamp": "02:46:43", "text": "静かに用を足すために。そしてそれが"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "それが君に必要なものだよ、兄弟。信じてくれよ"}, {"type": "subtitle", "time": 10006.389, "timestamp": "02:46:46", "text": "イギリスでは、彼らはそんなこと気にしない。"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "トイレについて。何てことだ。イギリスで待って"}, {"type": "subtitle", "time": 10012.79, "timestamp": "02:46:52", "text": "水にその部分か何かがある"}, {"type": "subtitle", "time": 10015.75, "timestamp": "02:46:55", "text": "流れるもの。私を信じて。私を信じて。あなた"}, {"type": "subtitle", "time": 10019.99, "timestamp": "02:46:59", "text": "あなたは紙を使っています。何てことだ。それ"}]
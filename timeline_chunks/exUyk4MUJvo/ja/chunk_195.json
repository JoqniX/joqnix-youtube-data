[{"type": "subtitle", "time": 11700.309, "timestamp": "03:15:00", "text": "[音楽]"}, {"type": "subtitle", "time": 11703.19, "timestamp": "03:15:03", "text": "知ってる？私、美術大学で働いてるから"}, {"type": "subtitle", "time": 11705.51, "timestamp": "03:15:05", "text": "アーティストに聞いてみましょう"}, {"type": "subtitle", "time": 11709.269, "timestamp": "03:15:09", "text": "そこにいて、その価格を正当化するかもしれない"}, {"type": "subtitle", "time": 11711.65, "timestamp": "03:15:11", "text": "もう少しうまく正当化できるようにする。"}, {"type": "subtitle", "time": 11714.389, "timestamp": "03:15:14", "text": "[音楽]"}, {"type": "subtitle", "time": 11717.91, "timestamp": "03:15:17", "text": "うん。でも、そうですね、ええと、そこに"}, {"type": "subtitle", "time": 11721.99, "timestamp": "03:15:21", "text": "もし私が"}, {"type": "subtitle", "time": 11724.79, "timestamp": "03:15:24", "text": "このアートでデビューするために、"}, {"type": "subtitle", "time": 11727.59, "timestamp": "03:15:27", "text": "現在モデル化中。私が設定しているものと同じように"}, {"type": "subtitle", "time": 11729.51, "timestamp": "03:15:29", "text": "品質基準とか、そういう類のものですよね？"}, {"type": "subtitle", "time": 11732.15, "timestamp": "03:15:32", "text": "そして、将来の資産すべて、あるいは何か"}, {"type": "subtitle", "time": 11735.429, "timestamp": "03:15:35", "text": "その品質と同等でなければならないか、"}, {"type": "subtitle", "time": 11737.429, "timestamp": "03:15:37", "text": "何か。それは、それは、それは"}, {"type": "subtitle", "time": 11740.309, "timestamp": "03:15:40", "text": "これについて私が嫌いな点。もっとお金を使う"}, {"type": "subtitle", "time": 11742.79, "timestamp": "03:15:42", "text": "結局はお金だ。何？何？何が"}, {"type": "subtitle", "time": 11744.63, "timestamp": "03:15:44", "text": "これ？私はこれをこの時にやりたくない"}, {"type": "subtitle", "time": 11751.59, "timestamp": "03:15:51", "text": "スキーム。あなたが手に入れる資産は、"}, {"type": "subtitle", "time": 11758.309, "timestamp": "03:15:58", "text": "いや、いや、いや、いや、いや。ジョーだと思う、"}]
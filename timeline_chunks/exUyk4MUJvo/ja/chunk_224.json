[{"type": "subtitle", "time": 13440.75, "timestamp": "03:44:00", "text": "[音楽]"}, {"type": "subtitle", "time": 13464.429, "timestamp": "03:44:24", "text": "自分。人生は"}, {"type": "subtitle", "time": 13466.59, "timestamp": "03:44:26", "text": "自分。おお、"}, {"type": "subtitle", "time": 13469.71, "timestamp": "03:44:29", "text": "天気と"}, {"type": "subtitle", "time": 13478.269, "timestamp": "03:44:38", "text": "ええ、もし、もし"}, {"type": "subtitle", "time": 13485.349, "timestamp": "03:44:45", "text": "いずれにしてもストリーミングはできません"}, {"type": "subtitle", "time": 13487.95, "timestamp": "03:44:47", "text": "または、えーと"}, {"type": "subtitle", "time": 13494.15, "timestamp": "03:44:54", "text": "もしくは、今日中に作ってみてください。ええ、大丈夫です。"}, {"type": "subtitle", "time": 13499.429, "timestamp": "03:44:59", "text": "あまり心配しないでください"}]
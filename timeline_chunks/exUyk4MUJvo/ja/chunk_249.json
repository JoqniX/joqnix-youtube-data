[{"type": "subtitle", "time": 14950.83, "timestamp": "04:09:10", "text": "それ。わかった。わかった。これはうまくいかない"}, {"type": "subtitle", "time": 14953.189, "timestamp": "04:09:13", "text": "どこでも。配信を終了した方がいいでしょうか？"}, {"type": "subtitle", "time": 14955.59, "timestamp": "04:09:15", "text": "すぐに、それとも話し続けるべきでしょうか？"}, {"type": "subtitle", "time": 14958.99, "timestamp": "04:09:18", "text": "あなたたち全員を"}, {"type": "subtitle", "time": 14962.309, "timestamp": "04:09:22", "text": "面白い？やってみて。だから、私がこれから"}, {"type": "subtitle", "time": 14965.51, "timestamp": "04:09:25", "text": "1つをやっている"}, {"type": "subtitle", "time": 14966.59, "timestamp": "04:09:26", "text": "再建"}, {"type": "subtitle", "time": 14968.91, "timestamp": "04:09:28", "text": "すべて。"}, {"type": "subtitle", "time": 14972.59, "timestamp": "04:09:32", "text": "意味の意味"}, {"type": "subtitle", "time": 14977.07, "timestamp": "04:09:37", "text": "えっと、私が持っているもの"}, {"type": "subtitle", "time": 14979.87, "timestamp": "04:09:39", "text": "えっと、私にさせてください"}, {"type": "subtitle", "time": 14984.15, "timestamp": "04:09:44", "text": "えーと、私の"}, {"type": "subtitle", "time": 14988.63, "timestamp": "04:09:48", "text": "作業の流れが非常に遅い。それで、今日"}, {"type": "subtitle", "time": 14992.189, "timestamp": "04:09:52", "text": "今日はゆっくり時間をかけよう"}, {"type": "subtitle", "time": 14995.79, "timestamp": "04:09:55", "text": "修正しない"}]
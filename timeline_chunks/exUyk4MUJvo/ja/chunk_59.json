[{"type": "subtitle", "time": 3543.95, "timestamp": "00:59:03", "text": "[音楽]"}, {"type": "subtitle", "time": 3547.349, "timestamp": "00:59:07", "text": "ブッシュだよ、男。とても暑い。私はもう死んだ。"}, {"type": "subtitle", "time": 3550.47, "timestamp": "00:59:10", "text": "それは怪しい。お風呂に入ったばかりで、"}, {"type": "subtitle", "time": 3582.789, "timestamp": "00:59:42", "text": "では、確認のために評価なしの動画を1本作ってみます。"}, {"type": "subtitle", "time": 3584.51, "timestamp": "00:59:44", "text": "私が受け取る金額。"}, {"type": "subtitle", "time": 3587.589, "timestamp": "00:59:47", "text": "はい、私が受け取っているかどうかを確認するために"}, {"type": "subtitle", "time": 3591.63, "timestamp": "00:59:51", "text": "少しだけ追加のXPまたは"}, {"type": "subtitle", "time": 3595.829, "timestamp": "00:59:55", "text": "スパイを知っていてシフトするようなものです"}, {"type": "subtitle", "time": 3599.99, "timestamp": "00:59:59", "text": "私、000 XP保証だけど過小評価されてる"}]
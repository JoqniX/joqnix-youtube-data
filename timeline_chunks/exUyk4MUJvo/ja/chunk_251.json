[{"type": "subtitle", "time": 15061.79, "timestamp": "04:11:01", "text": "私は7～8種類のブラウザを使っています"}, {"type": "subtitle", "time": 15066.269, "timestamp": "04:11:06", "text": "それをより良くするための情報源"}, {"type": "subtitle", "time": 15070.07, "timestamp": "04:11:10", "text": "ユニークで、どんどん物を追加していく。それで、"}, {"type": "subtitle", "time": 15072.55, "timestamp": "04:11:12", "text": "削除します。"}, {"type": "subtitle", "time": 15074.03, "timestamp": "04:11:14", "text": "ニコン"}, {"type": "subtitle", "time": 15079.07, "timestamp": "04:11:19", "text": "かぶせる。そうだろう"}, {"type": "subtitle", "time": 15082.189, "timestamp": "04:11:22", "text": "コメントは"}, {"type": "subtitle", "time": 15086.71, "timestamp": "04:11:26", "text": "右から右へ"}, {"type": "subtitle", "time": 15090.03, "timestamp": "04:11:30", "text": "画面上に浮遊物のように残された"}, {"type": "subtitle", "time": 15093.67, "timestamp": "04:11:33", "text": "コメント。えっと、あなたはそれを知っていましたか？"}, {"type": "subtitle", "time": 15097.03, "timestamp": "04:11:37", "text": "知ってる、ここにいる誰か知ってる"}, {"type": "subtitle", "time": 15101.83, "timestamp": "04:11:41", "text": "実際にはニコンニキコのようなことができます"}, {"type": "subtitle", "time": 15106.15, "timestamp": "04:11:46", "text": "例えばコメント欄のやつ"}, {"type": "subtitle", "time": 15109.63, "timestamp": "04:11:49", "text": "今ライブ配信している人は誰？ライブ配信している人は？"}, {"type": "subtitle", "time": 15112.349, "timestamp": "04:11:52", "text": "今日は、私はお見せします"}, {"type": "subtitle", "time": 15115.63, "timestamp": "04:11:55", "text": "そうだね"}, {"type": "subtitle", "time": 15117.71, "timestamp": "04:11:57", "text": "ライブで見せます"}]
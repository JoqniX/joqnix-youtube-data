[{"type": "subtitle", "time": 17400.628, "timestamp": "04:50:00", "text": "あの、皆さん、私の声がちゃんと聞こえますか？えっと、"}, {"type": "subtitle", "time": 17403.51, "timestamp": "04:50:03", "text": "私はただマイクを持って床に座っているだけです"}, {"type": "subtitle", "time": 17405.31, "timestamp": "04:50:05", "text": "私の口に向かって"}, {"type": "subtitle", "time": 17408.628, "timestamp": "04:50:08", "text": "また。マイクを壊してしまうかもしれない"}, {"type": "subtitle", "time": 17411.788, "timestamp": "04:50:11", "text": "今日、立ち上がろう。ああ神様、"}, {"type": "subtitle", "time": 17415.15, "timestamp": "04:50:15", "text": "それはこれを好まない。おお"}, {"type": "subtitle", "time": 17419.07, "timestamp": "04:50:19", "text": "神。はい、立ってください"}, {"type": "subtitle", "time": 17421.67, "timestamp": "04:50:21", "text": "上。はい、戻ってきました。戻ってきました。私は行く"}, {"type": "subtitle", "time": 17427.39, "timestamp": "04:50:27", "text": "うん、"}, {"type": "subtitle", "time": 17432.35, "timestamp": "04:50:32", "text": "20 Twitchでまた会いましょう。"}, {"type": "subtitle", "time": 17435.708, "timestamp": "04:50:35", "text": "日。ええ、最善を尽くします、"}, {"type": "subtitle", "time": 17440.948, "timestamp": "04:50:40", "text": "知っておく、もっともっともっと頑張るんだ。"}, {"type": "subtitle", "time": 17443.628, "timestamp": "04:50:43", "text": "私はそうしないつもりです"}, {"type": "subtitle", "time": 17447.75, "timestamp": "04:50:47", "text": "死ぬ。ええ、私も最善を尽くします。また、"}, {"type": "subtitle", "time": 17448.59, "timestamp": "04:50:48", "text": "あなた"}, {"type": "subtitle", "time": 17452.628, "timestamp": "04:50:52", "text": "男たちは私を誘惑しようとする、ただそこにいるだけで、"}, {"type": "subtitle", "time": 17455.39, "timestamp": "04:50:55", "text": "ほら、だから私は"}, {"type": "subtitle", "time": 17459.55, "timestamp": "04:50:59", "text": "上だよ、わかるだろ。それで"}]
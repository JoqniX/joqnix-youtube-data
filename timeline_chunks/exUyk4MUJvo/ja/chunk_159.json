[{"type": "subtitle", "time": 9541.19, "timestamp": "02:39:01", "text": "日本。そうではない。ただ"}, {"type": "subtitle", "time": 9544.07, "timestamp": "02:39:04", "text": "自由の定義は変化する。うん、"}, {"type": "subtitle", "time": 9547.03, "timestamp": "02:39:07", "text": "定義が変わる。はい。"}, {"type": "subtitle", "time": 9550.83, "timestamp": "02:39:10", "text": "だから私は「うん」って感じだった。"}, {"type": "subtitle", "time": 9554.95, "timestamp": "02:39:14", "text": "えっと、私がサブアトンみたいなことをしているから、"}, {"type": "subtitle", "time": 9558.91, "timestamp": "02:39:18", "text": "物事について、なぜ私は自分の"}, {"type": "subtitle", "time": 9562.07, "timestamp": "02:39:22", "text": "配信時間とかそういうこと？もちろん、ええと"}, {"type": "subtitle", "time": 9564.23, "timestamp": "02:39:24", "text": "私は休憩を取ることができます、十分な休憩を取って"}, {"type": "subtitle", "time": 9567.27, "timestamp": "02:39:27", "text": "続けるのに十分なエネルギーがある"}, {"type": "subtitle", "time": 9570.79, "timestamp": "02:39:30", "text": "イベントやその他諸々"}, {"type": "subtitle", "time": 9572.87, "timestamp": "02:39:32", "text": "月末のコラボ"}, {"type": "subtitle", "time": 9575.19, "timestamp": "02:39:35", "text": "5月頃とか。だから私はこう思った、"}, {"type": "subtitle", "time": 9577.19, "timestamp": "02:39:37", "text": "うん、いいんじゃない？私がそんなことしたの？それから私は"}, {"type": "subtitle", "time": 9579.11, "timestamp": "02:39:39", "text": "「うん、いいんじゃない？」みたいな感じ。そして、私はそうした。私"}, {"type": "subtitle", "time": 9580.63, "timestamp": "02:39:40", "text": "考える"}, {"type": "subtitle", "time": 9583.59, "timestamp": "02:39:43", "text": "少し後悔している。私は持っています"}, {"type": "subtitle", "time": 9587.03, "timestamp": "02:39:47", "text": "後悔する、うん。どうぞ。もしあなたがそうするなら"}, {"type": "subtitle", "time": 9589.19, "timestamp": "02:39:49", "text": "日本に行くなら、"}, {"type": "subtitle", "time": 9591.71, "timestamp": "02:39:51", "text": "同じ粘り強さを見せる。つまり、"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "研究結果のように。もちろん、研究においての話です。"}, {"type": "subtitle", "time": 9596.87, "timestamp": "02:39:56", "text": "はい。研究。はい。はい。はい。それは"}, {"type": "subtitle", "time": 9598.15, "timestamp": "02:39:58", "text": "必ず手に入るもの"}]
[{"type": "subtitle", "time": 12060.87, "timestamp": "03:21:00", "text": "ああ、わかってるよ。知っている。言語を学ぶ"}, {"type": "subtitle", "time": 12064.15, "timestamp": "03:21:04", "text": "正直に言うと。タミル語を話せますか？"}, {"type": "subtitle", "time": 12068.07, "timestamp": "03:21:08", "text": "タミル語？ええと、私の両親はそれを話します。ええと"}, {"type": "subtitle", "time": 12070.229, "timestamp": "03:21:10", "text": "親はそれを知っている、なぜなら彼らは見ているから"}, {"type": "subtitle", "time": 12073.11, "timestamp": "03:21:13", "text": "映画とかそういうもの。理解できます"}, {"type": "subtitle", "time": 12075.269, "timestamp": "03:21:15", "text": "しかし、それを話すことはできない。もしあなたが"}, {"type": "subtitle", "time": 12077.19, "timestamp": "03:21:17", "text": "タミル語を理解する、タミル語は"}, {"type": "subtitle", "time": 12079.91, "timestamp": "03:21:19", "text": "最も難しい言語のように思えます。それ"}, {"type": "subtitle", "time": 12081.59, "timestamp": "03:21:21", "text": "は。"}, {"type": "subtitle", "time": 12083.51, "timestamp": "03:21:23", "text": "そう思います。つまり、一番難しいわけではないけれど"}, {"type": "subtitle", "time": 12085.269, "timestamp": "03:21:25", "text": "最も難しいもののひとつだと思う。ターディスは"}, {"type": "subtitle", "time": 12088.03, "timestamp": "03:21:28", "text": "それでも私は中国語だと思う。ああ、中国語。"}, {"type": "subtitle", "time": 12091.51, "timestamp": "03:21:31", "text": "うん。私はまだそれを学ばなければならない。"}, {"type": "subtitle", "time": 12094.55, "timestamp": "03:21:34", "text": "今はBilly Billyで配信しています。だからそれは"}, {"type": "subtitle", "time": 12096.71, "timestamp": "03:21:36", "text": "言語の壁があるため難しい。"}, {"type": "subtitle", "time": 12100.19, "timestamp": "03:21:40", "text": "中国語を学ぶと"}, {"type": "subtitle", "time": 12103.11, "timestamp": "03:21:43", "text": "あなたの進路は広東語を学ぶことです。私は思う"}, {"type": "subtitle", "time": 12107.91, "timestamp": "03:21:47", "text": "広東語の方が簡単だ。ああ、広東語。うん。"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "または、いつでも「それは何？」に行けばいい"}, {"type": "subtitle", "time": 12111.99, "timestamp": "03:21:51", "text": "電話した？の"}, {"type": "subtitle", "time": 12114.469, "timestamp": "03:21:54", "text": "ええと、日本の北側は"}, {"type": "subtitle", "time": 12116.15, "timestamp": "03:21:56", "text": "韓国。韓国語を学ぶ どれがどれ"}, {"type": "subtitle", "time": 12119.269, "timestamp": "03:21:59", "text": "あなたにとっては今なら簡単でしょう。"}]
[{"type": "subtitle", "time": 12900.229, "timestamp": "03:35:00", "text": "スケジュールを確定し、コラボレーション"}, {"type": "subtitle", "time": 12902.55, "timestamp": "03:35:02", "text": "今日中に予定を立ててください。だから、私は"}, {"type": "subtitle", "time": 12905.59, "timestamp": "03:35:05", "text": "えっと、文字通り私がパニックになるのが見えるよ"}, {"type": "subtitle", "time": 12909.349, "timestamp": "03:35:09", "text": "もう乗り越えたけど、大丈夫。ええ、そうですね。"}, {"type": "subtitle", "time": 12911.75, "timestamp": "03:35:11", "text": "このスケジュールに基づいて"}, {"type": "subtitle", "time": 12914.07, "timestamp": "03:35:14", "text": "今週はもう月曜日ですよね？私"}, {"type": "subtitle", "time": 12916.07, "timestamp": "03:35:16", "text": "今週の最終決定すらまだできていない"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "もの。それは本当にひどくて狂気じみている。"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "でも大丈夫。私は人々を配置します"}, {"type": "subtitle", "time": 12924.95, "timestamp": "03:35:24", "text": "保留リストに載っている人たち。"}, {"type": "subtitle", "time": 12927.67, "timestamp": "03:35:27", "text": "30人か40人くらいいるよ、"}, {"type": "subtitle", "time": 12930.59, "timestamp": "03:35:30", "text": "信じる。私は数えきれなくなりました"}, {"type": "subtitle", "time": 12932.87, "timestamp": "03:35:32", "text": "ポイント。毎日連絡を取り続けています"}, {"type": "subtitle", "time": 12934.79, "timestamp": "03:35:34", "text": "新しい人々へ。この時点で私はこう思う、"}, {"type": "subtitle", "time": 12936.63, "timestamp": "03:35:36", "text": "「ああ、どうやって"}, {"type": "subtitle", "time": 12940.71, "timestamp": "03:35:40", "text": "全員入ったの？分からない。でも大丈夫。"}, {"type": "subtitle", "time": 12943.19, "timestamp": "03:35:43", "text": "最終的には、それが多すぎる場合は、"}, {"type": "subtitle", "time": 12945.67, "timestamp": "03:35:45", "text": "いつもグループに入れて"}, {"type": "subtitle", "time": 12947.59, "timestamp": "03:35:47", "text": "グループでここに来ました。それはグループになるでしょう"}, {"type": "subtitle", "time": 12949.389, "timestamp": "03:35:49", "text": "コラボレーションとか、そういうの。下がる"}, {"type": "subtitle", "time": 12953.349, "timestamp": "03:35:53", "text": "外。えっと、私としては、"}, {"type": "subtitle", "time": 12955.59, "timestamp": "03:35:55", "text": "人々と交流し、彼らと楽しい時間を過ごす。私はしません"}, {"type": "subtitle", "time": 12956.83, "timestamp": "03:35:56", "text": "それを次のように見てください"}]
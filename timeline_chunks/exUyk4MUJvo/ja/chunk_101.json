[{"type": "subtitle", "time": 6061.109, "timestamp": "01:41:01", "text": "辛いと言うかもしれないけど、信じて"}, {"type": "subtitle", "time": 6062.87, "timestamp": "01:41:02", "text": "そうではありません。"}, {"type": "subtitle", "time": 6064.87, "timestamp": "01:41:04", "text": "ああ"}, {"type": "subtitle", "time": 6068.39, "timestamp": "01:41:08", "text": "辛いもの好きの人が必要だと思います。うん、そうだね"}, {"type": "subtitle", "time": 6070.79, "timestamp": "01:41:10", "text": "超激辛を頼む必要があるかもしれない"}, {"type": "subtitle", "time": 6073.109, "timestamp": "01:41:13", "text": "インドのスパイスに合うもの。あなた"}, {"type": "subtitle", "time": 6075.669, "timestamp": "01:41:15", "text": "言わなきゃいけないのは、私を見て、私を見て、私を見てってこと"}, {"type": "subtitle", "time": 6083.35, "timestamp": "01:41:23", "text": "それが私がどこへ行ってもやっていることです"}, {"type": "subtitle", "time": 6085.91, "timestamp": "01:41:25", "text": "イギリス。私を見てよ。私はインド人です"}, {"type": "subtitle", "time": 6088.07, "timestamp": "01:41:28", "text": "そして、信じてくれ、インド風のスパイシーな料理が好きだ。私"}, {"type": "subtitle", "time": 6092.07, "timestamp": "01:41:32", "text": "イギリス風の辛いものは要らない。"}, {"type": "subtitle", "time": 6094.709, "timestamp": "01:41:34", "text": "何てことだ。あれみたいなやつ"}, {"type": "subtitle", "time": 6101.83, "timestamp": "01:41:41", "text": "くそ。"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "それに、あなたが"}, {"type": "subtitle", "time": 6108.07, "timestamp": "01:41:48", "text": "挑戦的なものなど、たくさんのものを手に入れる"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "例えば"}, {"type": "subtitle", "time": 6113.27, "timestamp": "01:41:53", "text": "最終的にそうなった場合、良いこともあります"}, {"type": "subtitle", "time": 6115.83, "timestamp": "01:41:55", "text": "もっと社交的になること、それは私にはわからない"}]
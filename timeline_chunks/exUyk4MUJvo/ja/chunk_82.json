[{"type": "subtitle", "time": 4921.91, "timestamp": "01:22:01", "text": "戻る？"}, {"type": "subtitle", "time": 4924.43, "timestamp": "01:22:04", "text": "いや、冗談だよ。必要ない"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "支払う必要はありません。"}, {"type": "subtitle", "time": 4932.629, "timestamp": "01:22:12", "text": "私はただ助けを求めているだけです。行け！行け！行け。時計"}, {"type": "subtitle", "time": 4938.709, "timestamp": "01:22:18", "text": "彼自身を晒すだけではいけない。あなたは何を"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "ここで再読み込みします。行く途中です。"}, {"type": "subtitle", "time": 4962.629, "timestamp": "01:22:42", "text": "狩りが始まる。"}, {"type": "subtitle", "time": 4965.03, "timestamp": "01:22:45", "text": "みんな、ベイクリップを見たよ"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "昨日。私たちはあなたの戦術を知っています。待って、"}, {"type": "subtitle", "time": 4970.79, "timestamp": "01:22:50", "text": "何？どのベイクリップですか？私に何を送ってくださいか"}]
[{"type": "subtitle", "time": 9720.95, "timestamp": "02:42:00", "text": "弱い？もしあなたの「弱い」の定義が"}, {"type": "subtitle", "time": 9723.349, "timestamp": "02:42:03", "text": "では、私は一体何者なのだろうか？私がそうであるように、私はそうである"}, {"type": "subtitle", "time": 9726.309, "timestamp": "02:42:06", "text": "まるで君の前では私がプレビアンみたいだ。"}, {"type": "subtitle", "time": 9729.32, "timestamp": "02:42:09", "text": "弱いってどういう意味ですか？"}, {"type": "subtitle", "time": 9731.03, "timestamp": "02:42:11", "text": "[音楽]"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "わからない。弱くはない。ない"}, {"type": "subtitle", "time": 9749.67, "timestamp": "02:42:29", "text": "でも、この方法が一番いい"}, {"type": "subtitle", "time": 9751.59, "timestamp": "02:42:31", "text": "日本でできる最高のことは"}, {"type": "subtitle", "time": 9753.95, "timestamp": "02:42:33", "text": "私がここで人々がやっているのを見てきたこと。行く"}, {"type": "subtitle", "time": 9758.07, "timestamp": "02:42:38", "text": "日本人のガールフレンドを作る"}, {"type": "subtitle", "time": 9761.27, "timestamp": "02:42:41", "text": "誰が、誰が、誰が、あなたができるでしょうか"}, {"type": "subtitle", "time": 9765.429, "timestamp": "02:42:45", "text": "後日、彼女と一緒に引っ越して"}, {"type": "subtitle", "time": 9767.429, "timestamp": "02:42:47", "text": "家事全般をやってくれるし、"}, {"type": "subtitle", "time": 9770.71, "timestamp": "02:42:50", "text": "ストリーミング配信だけすればいい。"}, {"type": "subtitle", "time": 9772.55, "timestamp": "02:42:52", "text": "それが最高の夢だ"}, {"type": "subtitle", "time": 9775.91, "timestamp": "02:42:55", "text": "現在、あなたにとって。うん。"}, {"type": "subtitle", "time": 9779.27, "timestamp": "02:42:59", "text": "それは楽しそうですね。"}]
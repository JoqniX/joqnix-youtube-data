[{"type": "subtitle", "time": 10202.309, "timestamp": "02:50:02", "text": "照明費と燃料費を含める。"}, {"type": "subtitle", "time": 10204.87, "timestamp": "02:50:04", "text": "うん。ええと、そのまま滞在してもいいし、出て行ってもいいですよ"}, {"type": "subtitle", "time": 10207.51, "timestamp": "02:50:07", "text": "6か月後。次に設備機器、"}, {"type": "subtitle", "time": 10209.83, "timestamp": "02:50:09", "text": "風呂、浴室、冷蔵庫、洗濯"}, {"type": "subtitle", "time": 10212.55, "timestamp": "02:50:12", "text": "機械、米、炊飯器、えーと、米"}, {"type": "subtitle", "time": 10214.71, "timestamp": "02:50:14", "text": "調理器具、電気鍋、二段式バンカー、"}, {"type": "subtitle", "time": 10216.87, "timestamp": "02:50:16", "text": "ベッド、机、椅子。だから私は"}, {"type": "subtitle", "time": 10219.03, "timestamp": "02:50:19", "text": "うん、そうだね。あなたが言った通り、部屋は一つだけです。私"}, {"type": "subtitle", "time": 10220.63, "timestamp": "02:50:20", "text": "そういう意味だと思う。まるで"}, {"type": "subtitle", "time": 10223.83, "timestamp": "02:50:23", "text": "同じ部屋に住んでいる2人。"}, {"type": "subtitle", "time": 10225.429, "timestamp": "02:50:25", "text": "うん。"}, {"type": "subtitle", "time": 10228.23, "timestamp": "02:50:28", "text": "そういう意味じゃないの？ええ、そうです"}, {"type": "subtitle", "time": 10231.67, "timestamp": "02:50:31", "text": "そういう意味だよ、だって彼らは言うから"}, {"type": "subtitle", "time": 10234.23, "timestamp": "02:50:34", "text": "二段ベッドですよね？"}, {"type": "subtitle", "time": 10236.309, "timestamp": "02:50:36", "text": "いや、それはどうかな、ジョー。私"}, {"type": "subtitle", "time": 10237.71, "timestamp": "02:50:37", "text": "知らない"}, {"type": "subtitle", "time": 10241.429, "timestamp": "02:50:41", "text": "それ。私がそうであるように、"}, {"type": "subtitle", "time": 10244.83, "timestamp": "02:50:44", "text": "パートナー、あなたにも少しはプライバシーが必要ですよ。"}, {"type": "subtitle", "time": 10247.19, "timestamp": "02:50:47", "text": "うん。いいえ、それについては分かりません。私"}, {"type": "subtitle", "time": 10248.71, "timestamp": "02:50:48", "text": "それについてはよく分かりません。 1つ手に入れよう"}, {"type": "subtitle", "time": 10250.71, "timestamp": "02:50:50", "text": "一人部屋。ええ、それが私の"}, {"type": "subtitle", "time": 10252.79, "timestamp": "02:50:52", "text": "目指す。あなたには必要なものがあります"}, {"type": "subtitle", "time": 10256.63, "timestamp": "02:50:56", "text": "今は精神的に落ち着いています。うん、"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "高いけど、"}]
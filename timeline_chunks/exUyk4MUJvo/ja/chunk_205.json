[{"type": "subtitle", "time": 12301.99, "timestamp": "03:25:01", "text": "準備万端、体調も万全、ストリーミング配信もできる。"}, {"type": "subtitle", "time": 12304.389, "timestamp": "03:25:04", "text": "週に少なくとも1時間、1回または"}, {"type": "subtitle", "time": 12306.19, "timestamp": "03:25:06", "text": "週に2回。それが私の最初の"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "もの。そして、あの出来事が起こった。"}, {"type": "subtitle", "time": 12312.15, "timestamp": "03:25:12", "text": "すると私はこう思った。"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "「なんてことだ、そんなに大金なのか。」 H 何を"}, {"type": "subtitle", "time": 12318.07, "timestamp": "03:25:18", "text": "私はします？そして私は「わかった、わかった。"}, {"type": "subtitle", "time": 12321.269, "timestamp": "03:25:21", "text": "えっと、罪悪感を感じるのは、えっと、"}, {"type": "subtitle", "time": 12323.83, "timestamp": "03:25:23", "text": "嫉妬とか全部のことだよね？だって"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "私はそのことに集中していて"}, {"type": "subtitle", "time": 12328.309, "timestamp": "03:25:28", "text": "コミュニティの観点から、モデレーション、それらすべて"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "もの。私は集中していなかった"}, {"type": "subtitle", "time": 12332.309, "timestamp": "03:25:32", "text": "チャンネルもその他すべて。私はこう思った。"}, {"type": "subtitle", "time": 12335.91, "timestamp": "03:25:35", "text": "「うん、たぶんそれをチャンスとして受け止めるよ"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "機会として、"}, {"type": "subtitle", "time": 12340.79, "timestamp": "03:25:40", "text": "マラソンとか、それに近いサブマラソンみたいなやつ。"}, {"type": "subtitle", "time": 12344.15, "timestamp": "03:25:44", "text": "私は決して"}, {"type": "subtitle", "time": 12346.63, "timestamp": "03:25:46", "text": "以前は、私は「そうでなければ」と思っていました。"}, {"type": "subtitle", "time": 12349.269, "timestamp": "03:25:49", "text": "チャリティーイベントを開催するまで、"}, {"type": "subtitle", "time": 12351.429, "timestamp": "03:25:51", "text": "チャリティ、私はサバトンをやるつもりはない"}, {"type": "subtitle", "time": 12354.55, "timestamp": "03:25:54", "text": "あるいは、どんなことでも"}, {"type": "subtitle", "time": 12357.03, "timestamp": "03:25:57", "text": "私はいつも最終的には"}]
[{"type": "subtitle", "time": 12240.71, "timestamp": "03:24:00", "text": "私には兄弟がいて、彼らは最終的に"}, {"type": "subtitle", "time": 12243.03, "timestamp": "03:24:03", "text": "うん、彼らはそうすると思う。できると思う。"}, {"type": "subtitle", "time": 12245.19, "timestamp": "03:24:05", "text": "見て"}, {"type": "subtitle", "time": 12247.59, "timestamp": "03:24:07", "text": "なぜなら、ある時点で私は思うからです"}, {"type": "subtitle", "time": 12253.429, "timestamp": "03:24:13", "text": "誰かが必要になるかもしれません"}, {"type": "subtitle", "time": 12256.15, "timestamp": "03:24:16", "text": "PCを黙らせて「よし、行くぞ」と言うだけ"}, {"type": "subtitle", "time": 12259.55, "timestamp": "03:24:19", "text": "今すぐ勉強する ああ"}, {"type": "subtitle", "time": 12262.79, "timestamp": "03:24:22", "text": "うん、でも、私は学ばなければならないだろう"}, {"type": "subtitle", "time": 12265.269, "timestamp": "03:24:25", "text": "コントロールして、実際に他のことをする"}, {"type": "subtitle", "time": 12268.67, "timestamp": "03:24:28", "text": "そして仕事して外に出てこれを維持する"}, {"type": "subtitle", "time": 12271.59, "timestamp": "03:24:31", "text": "最小。実は私も以前はそうしていました"}, {"type": "subtitle", "time": 12274.11, "timestamp": "03:24:34", "text": "3月にこのことをする前に"}, {"type": "subtitle", "time": 12278.389, "timestamp": "03:24:38", "text": "先へ。最初は、ええ、"}, {"type": "subtitle", "time": 12280.469, "timestamp": "03:24:40", "text": "これらは全て、彼がやるべきことではなかった。だから私は"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "「うん、日本に行くよ」"}, {"type": "subtitle", "time": 12286.71, "timestamp": "03:24:46", "text": "7月なので、ゆっくり過ごそうと思っています。得る"}, {"type": "subtitle", "time": 12288.87, "timestamp": "03:24:48", "text": "ジムか何かに行って、"}, {"type": "subtitle", "time": 12291.229, "timestamp": "03:24:51", "text": "ジムに行って体を鍛えるんだ、だって私は"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "不健康で文字通り棒と"}, {"type": "subtitle", "time": 12295.71, "timestamp": "03:24:55", "text": "この時点では骨が残っている。食べない"}, {"type": "subtitle", "time": 12298.229, "timestamp": "03:24:58", "text": "適切に、健康の準備をするなど、"}]
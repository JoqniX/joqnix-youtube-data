[{"type": "subtitle", "time": 3121.43, "timestamp": "00:52:01", "text": "チャットすれば、とても役に立つでしょう。"}, {"type": "subtitle", "time": 3124.069, "timestamp": "00:52:04", "text": "はい、そうします。そして君たちは"}, {"type": "subtitle", "time": 3126.549, "timestamp": "00:52:06", "text": "能力"}, {"type": "subtitle", "time": 3129.109, "timestamp": "00:52:09", "text": "チャー"}, {"type": "subtitle", "time": 3133.109, "timestamp": "00:52:13", "text": "ユーザー名を変更する機能"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "または「はい」と入力してユーザー名を設定してください。私"}, {"type": "subtitle", "time": 3136.79, "timestamp": "00:52:16", "text": "ユーザー名も変更する必要があります。 1つ"}, {"type": "subtitle", "time": 3139.27, "timestamp": "00:52:19", "text": "敵が残っている。どうすればいいですか？私"}, {"type": "subtitle", "time": 3141.47, "timestamp": "00:52:21", "text": "わからない。かなり重い"}, {"type": "subtitle", "time": 3145.39, "timestamp": "00:52:25", "text": "方法。でも私は"}, {"type": "subtitle", "time": 3148.43, "timestamp": "00:52:28", "text": "希望できる"}, {"type": "subtitle", "time": 3169.109, "timestamp": "00:52:49", "text": "前半戦最後のラウンド。こんにちは。の"}, {"type": "subtitle", "time": 3171.39, "timestamp": "00:52:51", "text": "フェニックスはちょうどブロックした"}, {"type": "subtitle", "time": 3173.41, "timestamp": "00:52:53", "text": "殺す。ああ、"}, {"type": "subtitle", "time": 3175.39, "timestamp": "00:52:55", "text": "[音楽]"}, {"type": "subtitle", "time": 3178.75, "timestamp": "00:52:58", "text": "神。スナイパーが嫌いなのは、私の母ができないから"}]
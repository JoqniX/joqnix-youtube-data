[{"type": "subtitle", "time": 15669.269, "timestamp": "04:21:09", "text": "それ。行けよ、相棒。"}, {"type": "subtitle", "time": 15672.189, "timestamp": "04:21:12", "text": "えっと、聞いてなかったらいいんだけど"}, {"type": "subtitle", "time": 15675.349, "timestamp": "04:21:15", "text": "声。はい、戻ります。使用"}, {"type": "subtitle", "time": 15677.87, "timestamp": "04:21:17", "text": "投票ライト"}, {"type": "subtitle", "time": 15680.67, "timestamp": "04:21:20", "text": "きちんと。"}, {"type": "subtitle", "time": 15683.83, "timestamp": "04:21:23", "text": "えっと、私は、もし私が"}, {"type": "subtitle", "time": 15689.229, "timestamp": "04:21:29", "text": "くそ。 ID ID GF は次のようなことをしません"}, {"type": "subtitle", "time": 15692.189, "timestamp": "04:21:32", "text": "これ。わからない。"}, {"type": "subtitle", "time": 15694.429, "timestamp": "04:21:34", "text": "しかしスペインは"}, {"type": "subtitle", "time": 15697.91, "timestamp": "04:21:37", "text": "PCO、最初の数年間は海外にいました"}, {"type": "subtitle", "time": 15706.309, "timestamp": "04:21:46", "text": "ああ、私はまだ政治についてはよく知らない"}, {"type": "subtitle", "time": 15713.83, "timestamp": "04:21:53", "text": "知る。これらの人々は何かを約束しますが"}, {"type": "subtitle", "time": 15715.469, "timestamp": "04:21:55", "text": "一度もない"}, {"type": "subtitle", "time": 15719.83, "timestamp": "04:21:59", "text": "する。こんにちは、プニカットが来てくれて、そして"}]
[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "それで、他の学校では"}, {"type": "subtitle", "time": 8884.469, "timestamp": "02:28:04", "text": "北海道など、許可されている場所"}, {"type": "subtitle", "time": 8886.389, "timestamp": "02:28:06", "text": "でもこのGMAスクールは最高だった"}, {"type": "subtitle", "time": 8887.99, "timestamp": "02:28:07", "text": "その点に関しては厳格だ。うん。あなたがしなければならない"}, {"type": "subtitle", "time": 8890.03, "timestamp": "02:28:10", "text": "学校の規則に従って"}, {"type": "subtitle", "time": 8894.15, "timestamp": "02:28:14", "text": "すべてがあなたに似ている。うん。私はこう思った。"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "くそ。"}, {"type": "subtitle", "time": 8897.429, "timestamp": "02:28:17", "text": "何年になる予定ですか"}, {"type": "subtitle", "time": 8901.67, "timestamp": "02:28:21", "text": "そこには？ええと、そうですね、1年9ヶ月です。"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "私はそこにいます。それから私は何とかして"}, {"type": "subtitle", "time": 8906.55, "timestamp": "02:28:26", "text": "ビザを学生ビザに再度切り替える"}, {"type": "subtitle", "time": 8909.19, "timestamp": "02:28:29", "text": "あるいは、就労ビザみたいなものですよね？できる"}, {"type": "subtitle", "time": 8912.23, "timestamp": "02:28:32", "text": "しばらくそこに滞在する。"}, {"type": "subtitle", "time": 8915.55, "timestamp": "02:28:35", "text": "私は、"}, {"type": "subtitle", "time": 8920.389, "timestamp": "02:28:40", "text": "えっと、私の住居のPR担当の方。"}, {"type": "subtitle", "time": 8923.67, "timestamp": "02:28:43", "text": "うん。うん、それは楽しそうだね。それ"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "良いですね。ええ、それはとても"}, {"type": "subtitle", "time": 8928.389, "timestamp": "02:28:48", "text": "楽しい。でも、もしあなたが落ち着こうと考えているなら"}, {"type": "subtitle", "time": 8931.03, "timestamp": "02:28:51", "text": "向こう側は、全く違う"}, {"type": "subtitle", "time": 8932.15, "timestamp": "02:28:52", "text": "えっと、なんていう名前ですか？別の"}, {"type": "subtitle", "time": 8936.79, "timestamp": "02:28:56", "text": "質問です。なぜなら、そうすれば必要ないからです。"}]
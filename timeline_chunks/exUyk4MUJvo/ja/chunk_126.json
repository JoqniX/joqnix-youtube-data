[{"type": "subtitle", "time": 7561.109, "timestamp": "02:06:01", "text": "今は男性のユーチューバーがずっと多いのは"}, {"type": "subtitle", "time": 7563.109, "timestamp": "02:06:03", "text": "私はもっ​​と多くのものを見るようになったと思います"}, {"type": "subtitle", "time": 7567.669, "timestamp": "02:06:07", "text": "男性用。いや、そうじゃない、なんて言えばいいんだっけ、違う"}, {"type": "subtitle", "time": 7569.35, "timestamp": "02:06:09", "text": "人気がある。つまり、"}, {"type": "subtitle", "time": 7572.79, "timestamp": "02:06:12", "text": "人気があるけど、"}, {"type": "subtitle", "time": 7576.79, "timestamp": "02:06:16", "text": "ゆっくりとそこに着いています。なぜなら私は"}, {"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "彼らが決して同等にならないとは思わない"}, {"type": "subtitle", "time": 7582.709, "timestamp": "02:06:22", "text": "女性側で。うん。うん。うん。"}, {"type": "subtitle", "time": 7585.75, "timestamp": "02:06:25", "text": "でも、私はまだ幸せそうに見えます"}, {"type": "subtitle", "time": 7589.03, "timestamp": "02:06:29", "text": "彼らはゆっくりとではあるが、そこへ近づいている。"}, {"type": "subtitle", "time": 7591.99, "timestamp": "02:06:31", "text": "今はとてもいいけど、昔は"}, {"type": "subtitle", "time": 7594.55, "timestamp": "02:06:34", "text": "それは言われたことだった"}, {"type": "subtitle", "time": 7598.629, "timestamp": "02:06:38", "text": "女性のクリエイターだけが"}, {"type": "subtitle", "time": 7601.51, "timestamp": "02:06:41", "text": "トップに立つために、そして男性クリエイター"}, {"type": "subtitle", "time": 7603.109, "timestamp": "02:06:43", "text": "どこにも行けないとか、そんな感じ"}, {"type": "subtitle", "time": 7606.47, "timestamp": "02:06:46", "text": "そして人々はかつて見下していた"}, {"type": "subtitle", "time": 7609.589, "timestamp": "02:06:49", "text": "男性ユーチューバーとか。"}, {"type": "subtitle", "time": 7611.27, "timestamp": "02:06:51", "text": "うん。見ることについてはよくわからない"}, {"type": "subtitle", "time": 7614.95, "timestamp": "02:06:54", "text": "下半分だけど、間違いなく私は"}, {"type": "subtitle", "time": 7616.79, "timestamp": "02:06:56", "text": "間違いなく、それは単なる興味だと思います"}, {"type": "subtitle", "time": 7619.589, "timestamp": "02:06:59", "text": "相対的な関心がないかのように"}]
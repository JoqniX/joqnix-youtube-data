[{"type": "subtitle", "time": 10085.03, "timestamp": "02:48:05", "text": "個室ですが、もし私が"}, {"type": "subtitle", "time": 10087.51, "timestamp": "02:48:07", "text": "ルームメイトが無事だといいのですが"}, {"type": "subtitle", "time": 10090.63, "timestamp": "02:48:10", "text": "私と一緒に何かをしたり、その他いろいろなことをしたり"}, {"type": "subtitle", "time": 10092.71, "timestamp": "02:48:12", "text": "恥をかかせたり、そういう類のこと。ロールすると"}, {"type": "subtitle", "time": 10095.67, "timestamp": "02:48:15", "text": "サイコロが正しければ、"}, {"type": "subtitle", "time": 10099.19, "timestamp": "02:48:19", "text": "そこで人生の伴侶を見つけることができるかもしれない。"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "いや、つまりこれはたった2つだけなのか"}, {"type": "subtitle", "time": 10112.55, "timestamp": "02:48:32", "text": "ルームメイト同士、もしくは5部屋以内のグループ？ああ、"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "まるでシェアハウスみたいだと思う"}, {"type": "subtitle", "time": 10118.07, "timestamp": "02:48:38", "text": "そして、キッチンがあるような部屋で"}, {"type": "subtitle", "time": 10121.03, "timestamp": "02:48:41", "text": "家の中にあるものすべて。"}, {"type": "subtitle", "time": 10123.51, "timestamp": "02:48:43", "text": "でも、全部でいくつあるのかはよくわからない"}, {"type": "subtitle", "time": 10127.51, "timestamp": "02:48:47", "text": "でも、そこから私が見たのは、えーと、"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "なんて言うんだっけ、"}, {"type": "subtitle", "time": 10132.469, "timestamp": "02:48:52", "text": "この論文は料金体系のようなものだ"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "そうですね、それで、そこには文字通りこう書いてありました。"}]
[{"type": "subtitle", "time": 10684.55, "timestamp": "02:58:04", "text": "それで彼は、ルームメイトが"}, {"type": "subtitle", "time": 10685.79, "timestamp": "02:58:05", "text": "同じ"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "インド出身のクラスメート。だから私はこう思ったけど、彼は"}, {"type": "subtitle", "time": 10693.349, "timestamp": "02:58:13", "text": "ランダムであるかのように言及もしました。それで、"}, {"type": "subtitle", "time": 10696.71, "timestamp": "02:58:16", "text": "運が良ければ、"}, {"type": "subtitle", "time": 10700.55, "timestamp": "02:58:20", "text": "同じ国の人、または"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "あなたは運が良くない、あなたはペアになる"}, {"type": "subtitle", "time": 10705.19, "timestamp": "02:58:25", "text": "外国人とかと一緒のやつ。よくわからない"}, {"type": "subtitle", "time": 10707.51, "timestamp": "02:58:27", "text": "性別の件について。女の子でしょうか？"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "女の子か男の子か、男の子か男の子か、女の子？混合？私"}, {"type": "subtitle", "time": 10712.95, "timestamp": "02:58:32", "text": "わからない。"}, {"type": "subtitle", "time": 10717.349, "timestamp": "02:58:37", "text": "ミックスなら、きっと美味しいですよ。"}, {"type": "subtitle", "time": 10720.309, "timestamp": "02:58:40", "text": "しかし、外出のルールとして、私は"}, {"type": "subtitle", "time": 10722.87, "timestamp": "02:58:42", "text": "いつも、絶対に寝ないでと言っている"}, {"type": "subtitle", "time": 10726.15, "timestamp": "02:58:46", "text": "働くか、住むか。"}, {"type": "subtitle", "time": 10728.469, "timestamp": "02:58:48", "text": "だから、決してそのような関係を作らないで"}, {"type": "subtitle", "time": 10731.51, "timestamp": "02:58:51", "text": "あなたが働いている場所、またはあなたが住んでいる場所。"}, {"type": "subtitle", "time": 10734.389, "timestamp": "02:58:54", "text": "とても気まずくなる"}, {"type": "subtitle", "time": 10738.19, "timestamp": "02:58:58", "text": "もしあなたが、ほら、去ることに決めたら"}]
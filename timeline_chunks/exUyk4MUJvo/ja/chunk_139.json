[{"type": "subtitle", "time": 8340.309, "timestamp": "02:19:00", "text": "あらら。私はキムマネージャーを見ました。"}, {"type": "subtitle", "time": 8346.309, "timestamp": "02:19:06", "text": "それは私が気に入った点です。それは良かった。待って、"}, {"type": "subtitle", "time": 8347.99, "timestamp": "02:19:07", "text": "それの実写版があるの？違う"}, {"type": "subtitle", "time": 8351.349, "timestamp": "02:19:11", "text": "それはマナのようなものですか？"}, {"type": "subtitle", "time": 8354.309, "timestamp": "02:19:14", "text": "いや、いや、いや、いや。それはむしろ"}, {"type": "subtitle", "time": 8356.469, "timestamp": "02:19:16", "text": "それはそれ自体が物語です。それは"}, {"type": "subtitle", "time": 8358.469, "timestamp": "02:19:18", "text": "別のもの。それは、それは、"}, {"type": "subtitle", "time": 8362.309, "timestamp": "02:19:22", "text": "あなたのために戦おうとする男"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "彼の娘か何かを知っている。"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "それは違います。ああ、いや、それは違う"}, {"type": "subtitle", "time": 8368.79, "timestamp": "02:19:28", "text": "その一つ。わかった。わかった。ええ、クイーン氏は"}, {"type": "subtitle", "time": 8371.349, "timestamp": "02:19:31", "text": "提案されたこと。"}, {"type": "subtitle", "time": 8373.19, "timestamp": "02:19:33", "text": "うん。"}, {"type": "subtitle", "time": 8375.27, "timestamp": "02:19:35", "text": "見たかったけど、結局見られなかった"}, {"type": "subtitle", "time": 8380.349, "timestamp": "02:19:40", "text": "その周り。ヴェネンツォ、それはいい名前だね。うん。"}, {"type": "subtitle", "time": 8383.91, "timestamp": "02:19:43", "text": "ええと、いくつかあると思いますが、ああ、"}, {"type": "subtitle", "time": 8386.95, "timestamp": "02:19:46", "text": "うん。走ることと呼ばれるものがあった。"}, {"type": "subtitle", "time": 8395.03, "timestamp": "02:19:55", "text": "ええ、そうでしょうね。おや、これは何でしょう？迷子になった"}, {"type": "subtitle", "time": 8397.19, "timestamp": "02:19:57", "text": "星明かり。ギブリー製ですか？ああ、くそ、"}, {"type": "subtitle", "time": 8398.349, "timestamp": "02:19:58", "text": "それは"}]
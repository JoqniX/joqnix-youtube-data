[{"type": "subtitle", "time": 8401.429, "timestamp": "02:20:01", "text": "ギブリー。おお、"}, {"type": "subtitle", "time": 8403.349, "timestamp": "02:20:03", "text": "全く知らなかった。彼らは最近追加しました"}, {"type": "subtitle", "time": 8410.55, "timestamp": "02:20:10", "text": "はい、どうぞ。探さなければならないものがある。"}, {"type": "subtitle", "time": 8412.75, "timestamp": "02:20:12", "text": "スタジオジブリですか、"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "実は？なんてこった。スタジオジブリではない。"}, {"type": "subtitle", "time": 8419.51, "timestamp": "02:20:19", "text": "韓国のSF映画です。わかった。ああ。"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "宇宙飛行士が質量を求めて地球を離れるとき、"}, {"type": "subtitle", "time": 8424.23, "timestamp": "02:20:24", "text": "広大な無限の空間が分割する"}, {"type": "subtitle", "time": 8428.75, "timestamp": "02:20:28", "text": "運命に翻弄された恋人たち。ああ、なんてことだ、"}, {"type": "subtitle", "time": 8431.11, "timestamp": "02:20:31", "text": "安っぽい。私は興味がない、私は興味がない"}, {"type": "subtitle", "time": 8436.63, "timestamp": "02:20:36", "text": "今。あなたはどうですか？何が何だ"}, {"type": "subtitle", "time": 8439.71, "timestamp": "02:20:39", "text": "見てますか？"}, {"type": "subtitle", "time": 8443.57, "timestamp": "02:20:43", "text": "最後に覚えているのは"}, {"type": "subtitle", "time": 8445.309, "timestamp": "02:20:45", "text": "[音楽]"}, {"type": "subtitle", "time": 8450.469, "timestamp": "02:20:50", "text": "最近『トップガン マーヴェリック』を観ました。"}, {"type": "subtitle", "time": 8452.79, "timestamp": "02:20:52", "text": "それは良い。それは良い。それは良い。"}, {"type": "subtitle", "time": 8455.349, "timestamp": "02:20:55", "text": "うん、このゲームにハマり始めたんだ"}]
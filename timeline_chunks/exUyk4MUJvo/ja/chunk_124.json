[{"type": "subtitle", "time": 7441.189, "timestamp": "02:04:01", "text": "ストリームとして、より多くのアカウントまたは"}, {"type": "subtitle", "time": 7444.31, "timestamp": "02:04:04", "text": "何かがあって、それから彼女はそれを再び披露した"}, {"type": "subtitle", "time": 7447.83, "timestamp": "02:04:07", "text": "彼女のメインアカウントのプライベート"}, {"type": "subtitle", "time": 7450.87, "timestamp": "02:04:10", "text": "プライベートなもので、彼女は"}, {"type": "subtitle", "time": 7453.189, "timestamp": "02:04:13", "text": "モデルの衣装か何か、それから"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "まふまふドラマがある"}, {"type": "subtitle", "time": 7459.03, "timestamp": "02:04:19", "text": "そう、あれは"}, {"type": "subtitle", "time": 7464.629, "timestamp": "02:04:24", "text": "それはその日の人気ドラマだった"}, {"type": "subtitle", "time": 7466.709, "timestamp": "02:04:26", "text": "うん、それは私が知っている2つのドラマのようなものだった"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "よく知っている。ドラゴンの1匹は"}, {"type": "subtitle", "time": 7471.43, "timestamp": "02:04:31", "text": "女の子。彼女の名前は知りません。クエソン。"}, {"type": "subtitle", "time": 7474.39, "timestamp": "02:04:34", "text": "クエソン。うん。ココ。ええ、それは知っています"}, {"type": "subtitle", "time": 7476.95, "timestamp": "02:04:36", "text": "1つ。そしてもう一つは、"}, {"type": "subtitle", "time": 7478.87, "timestamp": "02:04:38", "text": "ルシ。わからない。それから他のもの"}, {"type": "subtitle", "time": 7481.99, "timestamp": "02:04:41", "text": "わからない。最近、たった1つのクリップを見た"}, {"type": "subtitle", "time": 7485.03, "timestamp": "02:04:45", "text": "グラは卒業した。ア・グラ"}, {"type": "subtitle", "time": 7487.43, "timestamp": "02:04:47", "text": "卒業した。うん。"}, {"type": "subtitle", "time": 7489.669, "timestamp": "02:04:49", "text": "そしてすぐにバイパーに取り掛かった"}, {"type": "subtitle", "time": 7492.47, "timestamp": "02:04:52", "text": "アカウント。うん。"}, {"type": "subtitle", "time": 7499.75, "timestamp": "02:04:59", "text": "他の女の子たちのことはよくわからない"}]
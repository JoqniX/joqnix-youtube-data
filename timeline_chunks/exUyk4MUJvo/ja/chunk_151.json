[{"type": "subtitle", "time": 9066.63, "timestamp": "02:31:06", "text": "でも、私はそうは言いません。"}, {"type": "subtitle", "time": 9074.99, "timestamp": "02:31:14", "text": "[音楽]"}, {"type": "subtitle", "time": 9082.309, "timestamp": "02:31:22", "text": "うん、荷造りする必要があるよ"}, {"type": "subtitle", "time": 9084.87, "timestamp": "02:31:24", "text": "荷造りしなきゃ。あ、マルギマジックを手に入れよう"}, {"type": "subtitle", "time": 9087.03, "timestamp": "02:31:27", "text": "マサラ。それがゲームゲームです"}, {"type": "subtitle", "time": 9089.469, "timestamp": "02:31:29", "text": "チェンジャー。のように"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "5つ、もしくは私は覚えていない"}, {"type": "subtitle", "time": 9097.83, "timestamp": "02:31:37", "text": "えっと、日本語の先生が、私にはできないって言ってる"}, {"type": "subtitle", "time": 9100.71, "timestamp": "02:31:40", "text": "生の食品や加工食品を摂取するか、"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "何か。受けられるかどうかわからない"}, {"type": "subtitle", "time": 9104.07, "timestamp": "02:31:44", "text": "マサラ。"}, {"type": "subtitle", "time": 9106.469, "timestamp": "02:31:46", "text": "私は連れて行きたい"}, {"type": "subtitle", "time": 9109.83, "timestamp": "02:31:49", "text": "いいえ、なぜダメなのですか？あ、待って"}, {"type": "subtitle", "time": 9111.99, "timestamp": "02:31:51", "text": "そこには。送信する方法はないですか"}, {"type": "subtitle", "time": 9115.429, "timestamp": "02:31:55", "text": "日本に行く前に必要なもの、または"}, {"type": "subtitle", "time": 9117.03, "timestamp": "02:31:57", "text": "何か？"}, {"type": "subtitle", "time": 9119.27, "timestamp": "02:31:59", "text": "はい、できますよ。というものがあります"}]
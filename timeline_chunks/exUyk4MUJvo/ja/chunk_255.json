[{"type": "subtitle", "time": 15304.389, "timestamp": "04:15:04", "text": "屋内および公共の場。このフィードを見てください。さあ"}, {"type": "subtitle", "time": 15313.389, "timestamp": "04:15:13", "text": "飼料"}, {"type": "subtitle", "time": 15317.71, "timestamp": "04:15:17", "text": "時間。君たちは君たちはできない"}, {"type": "subtitle", "time": 15321.67, "timestamp": "04:15:21", "text": "ここ。待って。えっと、私は"}, {"type": "subtitle", "time": 15324.87, "timestamp": "04:15:24", "text": "もっと良い方法はないだろうか？はい、持っています"}, {"type": "subtitle", "time": 15347.229, "timestamp": "04:15:47", "text": "くそ。"}, {"type": "subtitle", "time": 15350.389, "timestamp": "04:15:50", "text": "えっと。ああ、兄弟。ええ、そうですね。わかった。わかった。"}, {"type": "subtitle", "time": 15354.83, "timestamp": "04:15:54", "text": "コピー。コピー。コピー。コピー。戻る"}]
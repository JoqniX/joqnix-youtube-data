[{"type": "subtitle", "time": 5642.87, "timestamp": "01:34:02", "text": "自分は死なないだろうと思っている。私はただ瞬きすることができる"}, {"type": "subtitle", "time": 5658.629, "timestamp": "01:34:18", "text": "[音楽]"}, {"type": "subtitle", "time": 5660.91, "timestamp": "01:34:20", "text": "切り替え"}, {"type": "subtitle", "time": 5664.79, "timestamp": "01:34:24", "text": "側面。えっと、ダジャレはここにあります。わかった。もう行かなきゃ。"}, {"type": "subtitle", "time": 5667.75, "timestamp": "01:34:27", "text": "ここに銃がある。"}, {"type": "subtitle", "time": 5670.229, "timestamp": "01:34:30", "text": "待って、リシャ、あなたはパーティーに参加しているじゃない。"}]
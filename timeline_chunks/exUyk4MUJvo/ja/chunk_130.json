[{"type": "subtitle", "time": 7801.47, "timestamp": "02:10:01", "text": "5万ドル？ああ、どこで手に入れたの？"}, {"type": "subtitle", "time": 7803.589, "timestamp": "02:10:03", "text": "5万ドル？つまり、なぜそれを渡すのですか"}, {"type": "subtitle", "time": 7805.35, "timestamp": "02:10:05", "text": "外？彼は1000万ドルを受け取っているから"}, {"type": "subtitle", "time": 7813.189, "timestamp": "02:10:13", "text": "ええ、イギリス側ですね。私は"}, {"type": "subtitle", "time": 7816.39, "timestamp": "02:10:16", "text": "イギリス側を見てください。イギリス側は"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "それもあまり楽しいことではないと思う。イギリス"}, {"type": "subtitle", "time": 7821.75, "timestamp": "02:10:21", "text": "一方、日本風スタイルがブームになっている。私"}, {"type": "subtitle", "time": 7823.35, "timestamp": "02:10:23", "text": "日本側はほぼ"}, {"type": "subtitle", "time": 7827.109, "timestamp": "02:10:27", "text": "好調だ。ああ、そうだね。"}, {"type": "subtitle", "time": 7829.589, "timestamp": "02:10:29", "text": "うん。つまり、彼らはもっと多くのことをしているということです"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "アメリカ人が"}, {"type": "subtitle", "time": 7834.55, "timestamp": "02:10:34", "text": "以前は、あなたと同じようにいたずらをしていた側"}, {"type": "subtitle", "time": 7837.87, "timestamp": "02:10:37", "text": "それらのことを知っていますか"}, {"type": "subtitle", "time": 7842.229, "timestamp": "02:10:42", "text": "際どいイタズラとかそういう類のもの。 M"}, {"type": "subtitle", "time": 7844.87, "timestamp": "02:10:44", "text": "アメリカはその舞台に立っていたと思うし、"}, {"type": "subtitle", "time": 7846.79, "timestamp": "02:10:46", "text": "確かに、人々がそういうことをするから"}, {"type": "subtitle", "time": 7849.03, "timestamp": "02:10:49", "text": "それをやめただけです。"}, {"type": "subtitle", "time": 7852.79, "timestamp": "02:10:52", "text": "際どい、不気味なレベルの行動。うん。私"}, {"type": "subtitle", "time": 7854.31, "timestamp": "02:10:54", "text": "境界線上とは言えないだろう。それは不気味だ"}, {"type": "subtitle", "time": 7857.83, "timestamp": "02:10:57", "text": "レベル行動。うん。"}, {"type": "subtitle", "time": 7859.75, "timestamp": "02:10:59", "text": "だから彼らはそうしているのです。彼らはその"}]
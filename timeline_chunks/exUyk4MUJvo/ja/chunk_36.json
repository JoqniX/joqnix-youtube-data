[{"type": "subtitle", "time": 2161.27, "timestamp": "00:36:01", "text": "敵はあと一体残っている。ええと、私はただ"}, {"type": "subtitle", "time": 2165.27, "timestamp": "00:36:05", "text": "PC を起動して、PC を起動してマクロを実行します"}, {"type": "subtitle", "time": 2167.27, "timestamp": "00:36:07", "text": "そしてちょうど"}, {"type": "subtitle", "time": 2170.829, "timestamp": "00:36:10", "text": "立てかけて後で戻ってくるか、"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "何か。彼が追放されないことを願います"}, {"type": "subtitle", "time": 2189.67, "timestamp": "00:36:29", "text": "えーと、5番目"}, {"type": "subtitle", "time": 2191.829, "timestamp": "00:36:31", "text": "一致する結果が見つかりました。"}, {"type": "subtitle", "time": 2195.03, "timestamp": "00:36:35", "text": "うん。えーと、私がここに来るまで、えーとやってみましょう。"}, {"type": "subtitle", "time": 2197.55, "timestamp": "00:36:37", "text": "せっかく来たんだから、"}, {"type": "subtitle", "time": 2208.95, "timestamp": "00:36:48", "text": "ニックネームの件をやってみよう"}, {"type": "subtitle", "time": 2211.67, "timestamp": "00:36:51", "text": "YouTubeの話をしてるんだよ。私"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "つまり、Twitch の深夜にそれをやることができます"}, {"type": "subtitle", "time": 2216.27, "timestamp": "00:36:56", "text": "まあ、いいんじゃないでしょうか。私はしません"}, {"type": "subtitle", "time": 2219.19, "timestamp": "00:36:59", "text": "知る。私はマルチタスクをしているのが好きです"}]
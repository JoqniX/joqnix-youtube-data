[{"type": "subtitle", "time": 6360.229, "timestamp": "01:46:00", "text": "差別 日本。私はそうするだろう"}, {"type": "subtitle", "time": 6363.27, "timestamp": "01:46:03", "text": "直接感じないと言って"}, {"type": "subtitle", "time": 6367.189, "timestamp": "01:46:07", "text": "お分かりでしょうが。うん。"}, {"type": "subtitle", "time": 6368.55, "timestamp": "01:46:08", "text": "そして、どこにも"}, {"type": "subtitle", "time": 6370.87, "timestamp": "01:46:10", "text": "差別を直接感じる"}, {"type": "subtitle", "time": 6373.59, "timestamp": "01:46:13", "text": "どこでも、それは法的に"}, {"type": "subtitle", "time": 6376.47, "timestamp": "01:46:16", "text": "法的には非常に難しいことだ。そしてもし"}, {"type": "subtitle", "time": 6377.99, "timestamp": "01:46:17", "text": "もしそう感じたらいつでも"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "それについてTikTok動画でも作ればいいんじゃない？"}, {"type": "subtitle", "time": 6383.109, "timestamp": "01:46:23", "text": "うん。ああ、ついにTikTokが使えるようになったんだね"}, {"type": "subtitle", "time": 6387.189, "timestamp": "01:46:27", "text": "ちなみに、それもそうです。はい。はい。ついに。"}, {"type": "subtitle", "time": 6389.83, "timestamp": "01:46:29", "text": "ああ、わかりました。信じてくれ、それは 信じてくれ、それは"}, {"type": "subtitle", "time": 6391.99, "timestamp": "01:46:31", "text": "あなたがそこから離れているのは良いことだ。しないで"}, {"type": "subtitle", "time": 6395.51, "timestamp": "01:46:35", "text": "それに陥ってはいけません。あなたは望んでいない"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "それに陥る。うん。自分の"}, {"type": "subtitle", "time": 6401.44, "timestamp": "01:46:41", "text": "YouTube と Instagram の解像度。"}, {"type": "subtitle", "time": 6402.95, "timestamp": "01:46:42", "text": "[音楽]"}, {"type": "subtitle", "time": 6411.03, "timestamp": "01:46:51", "text": "メディア。うん。"}, {"type": "subtitle", "time": 6413.189, "timestamp": "01:46:53", "text": "日本に何を期待していますか？"}, {"type": "subtitle", "time": 6415.51, "timestamp": "01:46:55", "text": "正直に言って？期待値のようなものですか？何が"}, {"type": "subtitle", "time": 6416.43, "timestamp": "01:46:56", "text": "分かりますか"}, {"type": "subtitle", "time": 6418.59, "timestamp": "01:46:58", "text": "あなた自身ですか？"}]
[{"type": "subtitle", "time": 7381.99, "timestamp": "02:03:01", "text": "インディーズ系の卒業式みたいな感じだよね。"}, {"type": "subtitle", "time": 7385.83, "timestamp": "02:03:05", "text": "アカウントとか色々あるけど、こっそり"}, {"type": "subtitle", "time": 7389.99, "timestamp": "02:03:09", "text": "うん。うん。私はそれが好きです。"}, {"type": "subtitle", "time": 7393.47, "timestamp": "02:03:13", "text": "ああ、それで彼らはボンネットの下と"}, {"type": "subtitle", "time": 7395.669, "timestamp": "02:03:15", "text": "戦術。正直言って、私は全面的に賛成です。"}, {"type": "subtitle", "time": 7397.27, "timestamp": "02:03:17", "text": "彼らはインディーズ側でより多くのお金を得ている、"}, {"type": "subtitle", "time": 7399.35, "timestamp": "02:03:19", "text": "推測ですが。"}, {"type": "subtitle", "time": 7401.669, "timestamp": "02:03:21", "text": "うん。"}, {"type": "subtitle", "time": 7404.39, "timestamp": "02:03:24", "text": "まあ、それももっともだ。それは本当に"}, {"type": "subtitle", "time": 7406.39, "timestamp": "02:03:26", "text": "良い。あなたはもっとお金を得るためにそうするのですか？"}, {"type": "subtitle", "time": 7409.51, "timestamp": "02:03:29", "text": "つまり、なぜなぜなぜなぜ支払うのか"}, {"type": "subtitle", "time": 7412.149, "timestamp": "02:03:32", "text": "企業？一定の金額まで支払ってください"}, {"type": "subtitle", "time": 7413.91, "timestamp": "02:03:33", "text": "なぜなら彼らは交換するつもりだから"}, {"type": "subtitle", "time": 7417.03, "timestamp": "02:03:37", "text": "いずれにせよ、将来はあなた次第です。私が語る唯一の物語"}, {"type": "subtitle", "time": 7419.189, "timestamp": "02:03:39", "text": "自分がYouTuberに戻ったことを知っていた"}, {"type": "subtitle", "time": 7420.79, "timestamp": "02:03:40", "text": "それがロシアの物語だった。どうすればいいのかわからない"}, {"type": "subtitle", "time": 7425.109, "timestamp": "02:03:45", "text": "彼女は今やっているけど、ああ、なんてことだ。つまり"}, {"type": "subtitle", "time": 7428.87, "timestamp": "02:03:48", "text": "彼女はヴィショジョとヴィショを去った"}, {"type": "subtitle", "time": 7430.79, "timestamp": "02:03:50", "text": "どうやら彼らに彼女に与えさせたようだ"}, {"type": "subtitle", "time": 7433.83, "timestamp": "02:03:53", "text": "モデルとその他"}, {"type": "subtitle", "time": 7435.91, "timestamp": "02:03:55", "text": "それは一体どういうこと？ああ、彼らにやらせてやろう"}, {"type": "subtitle", "time": 7438.31, "timestamp": "02:03:58", "text": "モデルとかそういうもの。だから彼女は時々"}]
[{"type": "subtitle", "time": 2107.79, "timestamp": "00:35:07", "text": "これ？ああ、アクセス"}, {"type": "subtitle", "time": 2126.069, "timestamp": "00:35:26", "text": "マック。何てことだ。"}, {"type": "subtitle", "time": 2131.27, "timestamp": "00:35:31", "text": "準備ができて。それを指摘してしまったことを後悔している。"}, {"type": "subtitle", "time": 2147.91, "timestamp": "00:35:47", "text": "フェニックスにとっては良くない。彼がただ私であるところが大好きです"}, {"type": "subtitle", "time": 2149.91, "timestamp": "00:35:49", "text": "彼はまた、"}, {"type": "subtitle", "time": 2153.27, "timestamp": "00:35:53", "text": "XPを稼いで、男は「ああ、"}, {"type": "subtitle", "time": 2156.55, "timestamp": "00:35:56", "text": "どうすればいいのかわからない。私は、そうするだけです"}, {"type": "subtitle", "time": 2158.71, "timestamp": "00:35:58", "text": "はただ"}]
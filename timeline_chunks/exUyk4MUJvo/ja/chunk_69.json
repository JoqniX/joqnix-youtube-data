[{"type": "subtitle", "time": 4142.11, "timestamp": "01:09:02", "text": "そこに滞在させてあげます。原神、どうやって"}, {"type": "subtitle", "time": 4145.51, "timestamp": "01:09:05", "text": "多くの？それは間違いです。原神は"}, {"type": "subtitle", "time": 4152.59, "timestamp": "01:09:12", "text": "250 245 GMP?いや。もう一度いくらになるか"}, {"type": "subtitle", "time": 4155.43, "timestamp": "01:09:15", "text": "同じです。終わったら"}, {"type": "subtitle", "time": 4159.189, "timestamp": "01:09:19", "text": "アンインストールしてください。"}, {"type": "subtitle", "time": 4167.11, "timestamp": "01:09:27", "text": "パパ、こんにちは。それでは、私の歓迎の挨拶ですね。"}, {"type": "subtitle", "time": 4169.91, "timestamp": "01:09:29", "text": "チャンネルのURLを書き留めて"}, {"type": "subtitle", "time": 4173.03, "timestamp": "01:09:33", "text": "そうすれば無視されるだろう"}, {"type": "subtitle", "time": 4175.709, "timestamp": "01:09:35", "text": "うん、こんにちは"}, {"type": "subtitle", "time": 4178.95, "timestamp": "01:09:38", "text": "ショー"}, {"type": "subtitle", "time": 4182.789, "timestamp": "01:09:42", "text": "何とかして"}, {"type": "subtitle", "time": 4185.03, "timestamp": "01:09:45", "text": "えっと、ニックネームシステムみたいなものを作ろう"}, {"type": "subtitle", "time": 4191.51, "timestamp": "01:09:51", "text": "なんてこった。ストレージ容量はどれくらいですか？"}, {"type": "subtitle", "time": 4195.95, "timestamp": "01:09:55", "text": "私のストレージは、あなたに渡すはずだったのですが"}]
[{"type": "subtitle", "time": 13382.349, "timestamp": "03:43:02", "text": "2人分の友達"}, {"type": "subtitle", "time": 13386.15, "timestamp": "03:43:06", "text": "つながり、話し、一緒に過ごす"}, {"type": "subtitle", "time": 13387.229, "timestamp": "03:43:07", "text": "外。"}, {"type": "subtitle", "time": 13392.95, "timestamp": "03:43:12", "text": "たとえ有効になっていても"}, {"type": "subtitle", "time": 13397.469, "timestamp": "03:43:17", "text": "ゲームなどをプレイする、心配しないで"}, {"type": "subtitle", "time": 13401.429, "timestamp": "03:43:21", "text": "ええと、"}, {"type": "subtitle", "time": 13404.91, "timestamp": "03:43:24", "text": "えっと、私は話せる"}, {"type": "subtitle", "time": 13409.81, "timestamp": "03:43:29", "text": "しばらくの間、あなたに。それは"}, {"type": "subtitle", "time": 13412.75, "timestamp": "03:43:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13416.75, "timestamp": "03:43:36", "text": "十分。えっと、だって"}, {"type": "subtitle", "time": 13421.09, "timestamp": "03:43:41", "text": "私はそれを"}, {"type": "subtitle", "time": 13423.15, "timestamp": "03:43:43", "text": "[音楽]"}, {"type": "subtitle", "time": 13438.25, "timestamp": "03:43:58", "text": "私は日本へ出発します"}]
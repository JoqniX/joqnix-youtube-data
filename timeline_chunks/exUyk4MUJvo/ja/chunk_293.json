[{"type": "subtitle", "time": 17582.628, "timestamp": "04:53:02", "text": "平均。そう、もう一度、もう一度、"}, {"type": "subtitle", "time": 17584.43, "timestamp": "04:53:04", "text": "一度"}, {"type": "subtitle", "time": 17586.868, "timestamp": "04:53:06", "text": "改めて皆さんへ。ああ神様、私は何をしてしまったんだ"}, {"type": "subtitle", "time": 17589.628, "timestamp": "04:53:09", "text": "する？私は何をしたの？私は何をしたのか"}, {"type": "subtitle", "time": 17593.51, "timestamp": "04:53:13", "text": "する？改めて、皆さんが残ってくださったことに感謝します。"}, {"type": "subtitle", "time": 17594.99, "timestamp": "04:53:14", "text": "まで"}, {"type": "subtitle", "time": 17599.15, "timestamp": "04:53:19", "text": "終わり。次の配信は"}, {"type": "subtitle", "time": 17602.39, "timestamp": "04:53:22", "text": "トゥイッチ。また、スケジュールを修正する必要があります"}, {"type": "subtitle", "time": 17606.628, "timestamp": "04:53:26", "text": "おそらく。これは手に負えなくなってきている。"}, {"type": "subtitle", "time": 17608.39, "timestamp": "04:53:28", "text": "通常、YouTubeストリームは1であるべきです"}, {"type": "subtitle", "time": 17611.91, "timestamp": "04:53:31", "text": "1時間、2時間、でも私はそれを導いている"}, {"type": "subtitle", "time": 17617.47, "timestamp": "04:53:37", "text": "六。それで"}, {"type": "subtitle", "time": 17632.83, "timestamp": "04:53:52", "text": "自分。つまり、それは"}, {"type": "subtitle", "time": 17639.15, "timestamp": "04:53:59", "text": "スズキ"}]
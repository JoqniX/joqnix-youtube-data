[{"type": "subtitle", "time": 11582.95, "timestamp": "03:13:02", "text": "新しいもの。だから、それでいいんです。それ"}, {"type": "subtitle", "time": 11586.23, "timestamp": "03:13:06", "text": "その価格は年式に見合っている。うん。それで"}, {"type": "subtitle", "time": 11588.79, "timestamp": "03:13:08", "text": "年間価格の件ですが、彼らはこう言っていました"}, {"type": "subtitle", "time": 11591.59, "timestamp": "03:13:11", "text": "彼らはいずれ戻ってくるだろう"}, {"type": "subtitle", "time": 11594.389, "timestamp": "03:13:14", "text": "いつか。でも、そう、彼らのせいで"}, {"type": "subtitle", "time": 11597.51, "timestamp": "03:13:17", "text": "時間がかかりすぎたので、うん、"}, {"type": "subtitle", "time": 11600.79, "timestamp": "03:13:20", "text": "自分で対処するなど。しかしそれは"}, {"type": "subtitle", "time": 11604.95, "timestamp": "03:13:24", "text": "わかった。うん。そう、そしてその価格は"}, {"type": "subtitle", "time": 11609.75, "timestamp": "03:13:29", "text": "正当化できるが、上記の価格は"}, {"type": "subtitle", "time": 11613.349, "timestamp": "03:13:33", "text": "ええ、その値段は、実際は"}, {"type": "subtitle", "time": 11615.91, "timestamp": "03:13:35", "text": "プレミアムバージョンの価格"}, {"type": "subtitle", "time": 11618.229, "timestamp": "03:13:38", "text": "そして彼らは私が初めてそれをすると"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "Fiverrか何かで手に入れたやつ。いや、いや、これは"}, {"type": "subtitle", "time": 11623.67, "timestamp": "03:13:43", "text": "ええと、リガーは直接"}, {"type": "subtitle", "time": 11626.55, "timestamp": "03:13:46", "text": "アーティストからの推薦"}, {"type": "subtitle", "time": 11629.51, "timestamp": "03:13:49", "text": "このアーティストは韓国人アーティストです。だから私は思った"}, {"type": "subtitle", "time": 11631.51, "timestamp": "03:13:51", "text": "言語の問題には対処したくない"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "コミュニケーションも最悪だし、何もかも最悪だ。だから私は"}, {"type": "subtitle", "time": 11635.67, "timestamp": "03:13:55", "text": "彼らが連れている誰かと一緒に行こうと思った"}, {"type": "subtitle", "time": 11638.63, "timestamp": "03:13:58", "text": "既に一緒に仕事をしたことがある。それで私はそこへ行って"}]
[{"type": "subtitle", "time": 16321.75, "timestamp": "04:32:01", "text": "私はソフトウェアにこのように実装しました"}, {"type": "subtitle", "time": 16325.189, "timestamp": "04:32:05", "text": "結局、何かを作ることになった"}, {"type": "subtitle", "time": 16327.55, "timestamp": "04:32:07", "text": "このブロック音楽"}, {"type": "subtitle", "time": 16331.55, "timestamp": "04:32:11", "text": "ブロックがブロックされてこの壁に向かって"}, {"type": "subtitle", "time": 16333.71, "timestamp": "04:32:13", "text": "何年も"}, {"type": "subtitle", "time": 16338.91, "timestamp": "04:32:18", "text": "数ヶ月後、私は諦めてしまった。"}, {"type": "subtitle", "time": 16342.55, "timestamp": "04:32:22", "text": "うん。うん。それが私の物語です"}, {"type": "subtitle", "time": 16346.469, "timestamp": "04:32:26", "text": "音楽制作とかそういうのをやめるんだ。私"}, {"type": "subtitle", "time": 16349.83, "timestamp": "04:32:29", "text": "今日のFSの平均は簡単に戻ってきます"}, {"type": "subtitle", "time": 16351.95, "timestamp": "04:32:31", "text": "本当に"}, {"type": "subtitle", "time": 16355.99, "timestamp": "04:32:35", "text": "簡単だけど、重要なのは"}, {"type": "subtitle", "time": 16360.67, "timestamp": "04:32:40", "text": "主にあなたが好きなように"}, {"type": "subtitle", "time": 16365.07, "timestamp": "04:32:45", "text": "えーっと、メロディーを均一にして、"}, {"type": "subtitle", "time": 16368.149, "timestamp": "04:32:48", "text": "バックグラウンドのものをフロントエンドのものを詰め込む"}, {"type": "subtitle", "time": 16371.309, "timestamp": "04:32:51", "text": "側面に詰める"}, {"type": "subtitle", "time": 16374.91, "timestamp": "04:32:54", "text": "材料とフィラーと"}, {"type": "subtitle", "time": 16379.71, "timestamp": "04:32:59", "text": "うん。"}]
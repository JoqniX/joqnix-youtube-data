[{"type": "subtitle", "time": 362.11, "timestamp": "00:06:02", "text": "あなたの任務はまだ終わっていません。ああ、なんてことだ。感謝"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "あなた。引き下がれ。"}, {"type": "subtitle", "time": 383.67, "timestamp": "00:06:23", "text": "そこには。残量が少なくなってきました。残り30秒。おお"}, {"type": "subtitle", "time": 398.07, "timestamp": "00:06:38", "text": "うわ、撃てないよ。何てことだ。"}, {"type": "subtitle", "time": 402.23, "timestamp": "00:06:42", "text": "最後に残ったプレイヤー。私は撃てません。"}, {"type": "subtitle", "time": 405.19, "timestamp": "00:06:45", "text": "残り10秒。"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "[拍手]"}]
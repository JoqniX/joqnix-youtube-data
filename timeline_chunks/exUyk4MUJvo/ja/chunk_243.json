[{"type": "subtitle", "time": 14594.51, "timestamp": "04:03:14", "text": "N クロイアでさえできなかった"}, {"type": "subtitle", "time": 14596.95, "timestamp": "04:03:16", "text": "聞いてくれよ。私は死にたい。したい"}, {"type": "subtitle", "time": 14599.07, "timestamp": "04:03:19", "text": "何かを殴る。おお"}, {"type": "subtitle", "time": 14604.15, "timestamp": "04:03:24", "text": "神。ああ、神様。神様、ああ神様。私"}, {"type": "subtitle", "time": 14606.389, "timestamp": "04:03:26", "text": "テーブルをあまり揺らしてはいけない。あなた"}, {"type": "subtitle", "time": 14609.229, "timestamp": "04:03:29", "text": "ネズミが動いているのが見える。マウスを見る"}, {"type": "subtitle", "time": 14619.42, "timestamp": "04:03:39", "text": "机。わかった。ええ、音声です。"}, {"type": "subtitle", "time": 14620.75, "timestamp": "04:03:40", "text": "[音楽]"}, {"type": "subtitle", "time": 14623.79, "timestamp": "04:03:43", "text": "右？神。"}, {"type": "subtitle", "time": 14626.51, "timestamp": "04:03:46", "text": "神よ、私は"}, {"type": "subtitle", "time": 14635.15, "timestamp": "04:03:55", "text": "すでに。ストリーム品質は"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "場所。ストリームはあちこちに散らばっている。"}]
[{"type": "subtitle", "time": 4082.75, "timestamp": "01:08:02", "text": "それ。おお"}, {"type": "subtitle", "time": 4090.549, "timestamp": "01:08:10", "text": "一致する結果が見つかりました。試合終了。あ、待って。"}, {"type": "subtitle", "time": 4093.109, "timestamp": "01:08:13", "text": "私はまさにそこで受け取るはずだった。"}, {"type": "subtitle", "time": 4094.51, "timestamp": "01:08:14", "text": "それは"}, {"type": "subtitle", "time": 4105.669, "timestamp": "01:08:25", "text": "それまで。私にやらせてください。だから私の"}, {"type": "subtitle", "time": 4108.47, "timestamp": "01:08:28", "text": "現在の終了。その前に待ってください。何が"}, {"type": "subtitle", "time": 4112.51, "timestamp": "01:08:32", "text": "ダウンロード中？え、何？何？フォートナイト。"}, {"type": "subtitle", "time": 4114.829, "timestamp": "01:08:34", "text": "いいえ。"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "なぜこの人はそのゲームをアンインストールしたのか？"}, {"type": "subtitle", "time": 4120.309, "timestamp": "01:08:40", "text": "待って、ゲームはいくつあるの？"}, {"type": "subtitle", "time": 4122.749, "timestamp": "01:08:42", "text": "インストール済みですか？それから"}, {"type": "subtitle", "time": 4127.51, "timestamp": "01:08:47", "text": "ホグワーツのフォールガイズ、またもや壮大な展開だ。私は"}, {"type": "subtitle", "time": 4129.47, "timestamp": "01:08:49", "text": "秋をプレイする"}, {"type": "subtitle", "time": 4131.91, "timestamp": "01:08:51", "text": "みんな？インストールすべきでしょうか？わからない。私"}, {"type": "subtitle", "time": 4135.51, "timestamp": "01:08:55", "text": "これをインストールできます。 48です。いくらですか"}, {"type": "subtitle", "time": 4138.55, "timestamp": "01:08:58", "text": "フォールガイズ？ああ、5時だ。私は続ける 私は"}]
[{"type": "subtitle", "time": 8522.87, "timestamp": "02:22:02", "text": "日本でノートパソコンを買わなければならない。"}, {"type": "subtitle", "time": 8524.79, "timestamp": "02:22:04", "text": "日本で手に入れる予定ですか、それとも"}, {"type": "subtitle", "time": 8528.27, "timestamp": "02:22:08", "text": "インド？日本から"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "実際にゲームでゲームをプレイして"}, {"type": "subtitle", "time": 8534.389, "timestamp": "02:22:14", "text": "ストリーミング配信など、すべて含めて。だから私は"}, {"type": "subtitle", "time": 8537.19, "timestamp": "02:22:17", "text": "最新版か何かを手に入れようと思っている。"}, {"type": "subtitle", "time": 8542.75, "timestamp": "02:22:22", "text": "わからない。ノートパソコン5060または5090"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "509 5090。"}, {"type": "subtitle", "time": 8547.67, "timestamp": "02:22:27", "text": "うん。高価な方。冗談でしょ"}, {"type": "subtitle", "time": 8550.79, "timestamp": "02:22:30", "text": "自分。でも、それだけの価値はある。"}, {"type": "subtitle", "time": 8553.99, "timestamp": "02:22:33", "text": "うん。それに、今のノートパソコンは本当に面倒くさい。"}, {"type": "subtitle", "time": 8556.309, "timestamp": "02:22:36", "text": "PCの場合、アップグレードして修正できます"}, {"type": "subtitle", "time": 8557.83, "timestamp": "02:22:37", "text": "部品も全て。全部。私"}, {"type": "subtitle", "time": 8560.07, "timestamp": "02:22:40", "text": "知る。知っている。ラップトップ。買わなければならない"}, {"type": "subtitle", "time": 8562.23, "timestamp": "02:22:42", "text": "もう一度最初からやり直す。ユニット全体。"}, {"type": "subtitle", "time": 8565.51, "timestamp": "02:22:45", "text": "信じてください、それは本当に本当に重いんです。"}, {"type": "subtitle", "time": 8568.63, "timestamp": "02:22:48", "text": "私があなたにアップルを勧めたように"}, {"type": "subtitle", "time": 8571.27, "timestamp": "02:22:51", "text": "MacBook Airとか、"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "実に多用途だ。うん。そのことは"}, {"type": "subtitle", "time": 8576.389, "timestamp": "02:22:56", "text": "外に持ち出せないもの"}, {"type": "subtitle", "time": 8579.51, "timestamp": "02:22:59", "text": "ファンが離れてしまうと"}]
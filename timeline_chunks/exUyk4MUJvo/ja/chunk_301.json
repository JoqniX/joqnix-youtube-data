[{"type": "subtitle", "time": 18061.67, "timestamp": "05:01:01", "text": "「これは史上最高のゲームだ。」そして私は"}, {"type": "subtitle", "time": 18063.35, "timestamp": "05:01:03", "text": "「ああ、なんてことだ、知ってるか？むしろ"}, {"type": "subtitle", "time": 18064.708, "timestamp": "05:01:04", "text": "明日ストリーミング配信するより、"}, {"type": "subtitle", "time": 18066.47, "timestamp": "05:01:06", "text": "今日ストリーミング配信して、まだやってないから"}, {"type": "subtitle", "time": 18068.868, "timestamp": "05:01:08", "text": "1日かそこら配信して、私はこう思った。"}, {"type": "subtitle", "time": 18071.708, "timestamp": "05:01:11", "text": "「うん、行こう。"}, {"type": "subtitle", "time": 18075.31, "timestamp": "05:01:15", "text": "それを手に入れよう。"}, {"type": "subtitle", "time": 18076.99, "timestamp": "05:01:16", "text": "それ。"}, {"type": "subtitle", "time": 18081.868, "timestamp": "05:01:21", "text": "えっと、少々お待ちください。それでは始めましょう。"}, {"type": "subtitle", "time": 18085.27, "timestamp": "05:01:25", "text": "はい、少々お待ちください。こんにちは、バイソン"}, {"type": "subtitle", "time": 18086.788, "timestamp": "05:01:26", "text": "太陽。こんにちは。ようこそ、ようこそ。私は"}, {"type": "subtitle", "time": 18089.27, "timestamp": "05:01:29", "text": "鳩。配信へようこ​​そ。アリッサ、"}, {"type": "subtitle", "time": 18090.868, "timestamp": "05:01:30", "text": "ストリームへようこそ。そしてクロノス、"}, {"type": "subtitle", "time": 18093.43, "timestamp": "05:01:33", "text": "配信へようこ​​そ。"}, {"type": "subtitle", "time": 18097.47, "timestamp": "05:01:37", "text": "みなさん、こんにちは。皆さんが元気でいることを願っています"}, {"type": "subtitle", "time": 18100.11, "timestamp": "05:01:40", "text": "良い。わかりました、"}, {"type": "subtitle", "time": 18103.788, "timestamp": "05:01:43", "text": "これと、"}]
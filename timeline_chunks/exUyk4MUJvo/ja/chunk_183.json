[{"type": "subtitle", "time": 10981.429, "timestamp": "03:03:01", "text": "そのことについては、えっと、つまり、私は"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "つまり、それがあなたの優先事項なのですか？"}, {"type": "subtitle", "time": 10989.19, "timestamp": "03:03:09", "text": "優先事項ではない。わかりません。あなたが知っている"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "いつでもその脚を作ることができます"}, {"type": "subtitle", "time": 10995.19, "timestamp": "03:03:15", "text": "に該当する。資金調達はこうです"}, {"type": "subtitle", "time": 10996.79, "timestamp": "03:03:16", "text": "理解しなければならないこと"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "優先順位は食料と賃貸物件にあります"}, {"type": "subtitle", "time": 11002.469, "timestamp": "03:03:22", "text": "これは、あなたの資金源の一つです。の"}, {"type": "subtitle", "time": 11006.79, "timestamp": "03:03:26", "text": "2番目の食料プールは、"}, {"type": "subtitle", "time": 11009.429, "timestamp": "03:03:29", "text": "学業および授業料"}, {"type": "subtitle", "time": 11012.15, "timestamp": "03:03:32", "text": "そして私が想定しているすべてのことは"}, {"type": "subtitle", "time": 11013.51, "timestamp": "03:03:33", "text": "たとえあなたの両親が支払っているとしても"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "ローンを組む予定ですか？"}, {"type": "subtitle", "time": 11018.15, "timestamp": "03:03:38", "text": "あなたの楽しい資金調達方法がわかりません"}, {"type": "subtitle", "time": 11020.23, "timestamp": "03:03:40", "text": "状況は、ローンを組む場合"}, {"type": "subtitle", "time": 11023.269, "timestamp": "03:03:43", "text": "ええ、ローンです。うん。だから私は"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "それには少し出かけなければならない。 2番"}, {"type": "subtitle", "time": 11030.15, "timestamp": "03:03:50", "text": "次にやるべきことは、えーと、"}, {"type": "subtitle", "time": 11031.83, "timestamp": "03:03:51", "text": "それはあなたが設定したもう一つのことです"}, {"type": "subtitle", "time": 11034.95, "timestamp": "03:03:54", "text": "あなたの学業のために。それからすべてのもの"}, {"type": "subtitle", "time": 11037.11, "timestamp": "03:03:57", "text": "残りのものを分割したい"}, {"type": "subtitle", "time": 11039.429, "timestamp": "03:03:59", "text": "それを二つに分ける。投資のための1つ"}]
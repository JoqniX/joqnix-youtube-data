[{"type": "subtitle", "time": 10261.59, "timestamp": "02:51:01", "text": "誰かと一緒に閉じ込められることになる"}, {"type": "subtitle", "time": 10263.75, "timestamp": "02:51:03", "text": "ほとんど知らない。そう、あなたは"}, {"type": "subtitle", "time": 10266.07, "timestamp": "02:51:06", "text": "精神"}, {"type": "subtitle", "time": 10267.63, "timestamp": "02:51:07", "text": "いくらですか"}, {"type": "subtitle", "time": 10270.83, "timestamp": "02:51:10", "text": "39,000円"}, {"type": "subtitle", "time": 10274.87, "timestamp": "02:51:14", "text": "ポンド、千円をポンドに換算すると？どれくらい"}, {"type": "subtitle", "time": 10278.91, "timestamp": "02:51:18", "text": "ルピー？ええと、1つは312,000です。"}, {"type": "subtitle", "time": 10286.07, "timestamp": "02:51:26", "text": "違うよ、さあ。それほど悪くはないよ。"}, {"type": "subtitle", "time": 10295.67, "timestamp": "02:51:35", "text": "ええ、その合計金額ですね"}, {"type": "subtitle", "time": 10298.11, "timestamp": "02:51:38", "text": "合計金額をお待ちください。合計金額"}, {"type": "subtitle", "time": 10301.59, "timestamp": "02:51:41", "text": "312 ええ、それは何ヶ月間ですか"}, {"type": "subtitle", "time": 10304.71, "timestamp": "02:51:44", "text": "えーと、6ヶ月、えーと、6ヶ月を含む"}, {"type": "subtitle", "time": 10308.71, "timestamp": "02:51:48", "text": "月額ドメトリー料金"}, {"type": "subtitle", "time": 10311.99, "timestamp": "02:51:51", "text": "つまり、合計金額には預金が含まれています"}, {"type": "subtitle", "time": 10316.389, "timestamp": "02:51:56", "text": "はい、入金してドメットが入場します"}, {"type": "subtitle", "time": 10319.19, "timestamp": "02:51:59", "text": "入学金（6ヶ月分）"}]
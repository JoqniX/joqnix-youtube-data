[{"type": "subtitle", "time": 4578.55, "timestamp": "01:16:18", "text": "あ、待って。これは間違いです。あのね？"}, {"type": "subtitle", "time": 4580.59, "timestamp": "01:16:20", "text": "この全体をコピーします"}, {"type": "subtitle", "time": 4591.669, "timestamp": "01:16:31", "text": "シャーロット。えっと、どうして私たちが知っているんですか？いつ"}, {"type": "subtitle", "time": 4593.31, "timestamp": "01:16:33", "text": "誰かが入力する"}, {"type": "subtitle", "time": 4596.47, "timestamp": "01:16:36", "text": "チャットすると、"}, {"type": "subtitle", "time": 4597.47, "timestamp": "01:16:37", "text": "は"}, {"type": "subtitle", "time": 4600.63, "timestamp": "01:16:40", "text": "そこには。それから、それが"}, {"type": "subtitle", "time": 4604.07, "timestamp": "01:16:44", "text": "一人が操作すれば、更新されます。それから"}, {"type": "subtitle", "time": 4606.11, "timestamp": "01:16:46", "text": "チャンネルを取得します"}, {"type": "subtitle", "time": 4609.79, "timestamp": "01:16:49", "text": "URLチャットチャンネル。"}, {"type": "subtitle", "time": 4612.91, "timestamp": "01:16:52", "text": "わかった。そしてこれはユーザーに対するチェックです"}, {"type": "subtitle", "time": 4616.43, "timestamp": "01:16:56", "text": "チャネル。ゼロから"}]
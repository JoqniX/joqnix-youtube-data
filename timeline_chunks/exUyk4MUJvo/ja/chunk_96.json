[{"type": "subtitle", "time": 5769.43, "timestamp": "01:36:09", "text": "それでは皆さん、こんにちは。だから、ごめんなさい、"}, {"type": "subtitle", "time": 5771.43, "timestamp": "01:36:11", "text": "今日は開始が遅れたけど、うん"}, {"type": "subtitle", "time": 5775.51, "timestamp": "01:36:15", "text": "チャソン82日目へようこそ。その"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "公式に"}, {"type": "subtitle", "time": 5778.35, "timestamp": "01:36:18", "text": "えっと、それは"}, {"type": "subtitle", "time": 5782.629, "timestamp": "01:36:22", "text": "正式には6月、最終日"}, {"type": "subtitle", "time": 5785.35, "timestamp": "01:36:25", "text": "ジョッカソンのこの区間はここで行われる。"}, {"type": "subtitle", "time": 5789.11, "timestamp": "01:36:29", "text": "しかし今日は月初めなので、"}, {"type": "subtitle", "time": 5792.43, "timestamp": "01:36:32", "text": "特別なゲストをお迎えしています。私たちには"}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "シーモア・スカモア。申し訳ありません"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "あなたの名前をめちゃくちゃに発音する。こんにちは。"}, {"type": "subtitle", "time": 5800.639, "timestamp": "01:36:40", "text": "こんにちは。 こんにちは。あなたの反応を聞かせてください"}, {"type": "subtitle", "time": 5808.39, "timestamp": "01:36:48", "text": "はい、どうぞ。ポップアップ表示されるはずです。お願いします"}, {"type": "subtitle", "time": 5815.43, "timestamp": "01:36:55", "text": "上。久しぶりですね。私たちは話しました"}, {"type": "subtitle", "time": 5819.35, "timestamp": "01:36:59", "text": "そして、こんな風に時間を過ごした。あなたはどうですか？"}]
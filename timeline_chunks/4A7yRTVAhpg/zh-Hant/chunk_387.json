[{"type": "subtitle", "time": 23228.628, "timestamp": "06:27:08", "text": "。 [音樂] 哦。哦不。我做了"}, {"type": "subtitle", "time": 23246.708, "timestamp": "06:27:26", "text": "什麼？ Jocknik，你的真名是什麼？ Jocknik。那就是我"}, {"type": "subtitle", "time": 23248.35, "timestamp": "06:27:28", "text": "的真名。我開玩笑的。 Jocknik，這難道不神奇嗎？作家竟然能故意利用你缺乏想像力這一點，讓你完全摸不著頭腦。總之，我最近讀了很多恐怖小說。"}, {"type": "subtitle", "time": 23273.35, "timestamp": "06:27:53", "text": "哦不。"}, {"type": "subtitle", "time": 23279.548, "timestamp": "06:27:59", "text": "[音樂]"}]
[{"type": "subtitle", "time": 25931.07, "timestamp": "07:12:11", "text": "所有人展示文學真諦的機會。  問題在於，文學社的概念聽起來太晦澀難懂，太"}, {"type": "subtitle", "time": 25937.708, "timestamp": "07:12:17", "text": "學術化了。但事實根本"}, {"type": "subtitle", "time": 25953.99, "timestamp": "07:12:33", "text": "不是那樣，你知道嗎？"}, {"type": "subtitle", "time": 25956.39, "timestamp": "07:12:36", "text": "我們只需要一種方法向"}, {"type": "subtitle", "time": 25970.868, "timestamp": "07:12:50", "text": "所有人展示這一點"}, {"type": "subtitle", "time": 25978.15, "timestamp": "07:12:58", "text": "。這是他們創造性思考中表達出來的。  [音樂] 但這並"}]
[{"type": "subtitle", "time": 2224.93, "timestamp": "00:37:04", "text": "。  他們需要什麼？哦，他們需要"}, {"type": "subtitle", "time": 2245.67, "timestamp": "00:37:25", "text": "兩種"}, {"type": "subtitle", "time": 2249.13, "timestamp": "00:37:29", "text": "媒介。好的。"}, {"type": "subtitle", "time": 2254.109, "timestamp": "00:37:34", "text": "我該把這個丟到哪裡？  呃，垃圾桶。"}, {"type": "subtitle", "time": 2261.51, "timestamp": "00:37:41", "text": "哦，垃圾已經沒了。呃，沒有空間了。呃，就讓它這樣吧。我的天啊。哦，"}, {"type": "subtitle", "time": 2264.069, "timestamp": "00:37:44", "text": "我們還需要再一個。是的。是的。  [音樂]"}]
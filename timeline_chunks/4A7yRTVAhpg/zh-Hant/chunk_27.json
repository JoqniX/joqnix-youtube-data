[{"type": "subtitle", "time": 1623.35, "timestamp": "00:27:03", "text": "微。我的天啊。  凌亂的。他們可能有時"}, {"type": "subtitle", "time": 1637.47, "timestamp": "00:27:17", "text": "不希望它是稀有的。所以要煮至"}, {"type": "subtitle", "time": 1639.71, "timestamp": "00:27:19", "text": "三分熟。  會證明一切。這大概就是三分熟吧。所以這個你可以做更多菜。  好的。好了。是的。  我是做飯的人。我是廚師。"}, {"type": "subtitle", "time": 1654.269, "timestamp": "00:27:34", "text": "？我該如何清理"}, {"type": "subtitle", "time": 1663.11, "timestamp": "00:27:43", "text": "它？  好的。我的天哪，是粉筆混進去了。裡面加了巧克力。我們贏了"}, {"type": "subtitle", "time": 1666.149, "timestamp": "00:27:46", "text": "一場。  做得好。"}, {"type": "subtitle", "time": 1669.909, "timestamp": "00:27:49", "text": "你可以把另一個再做一次"}]
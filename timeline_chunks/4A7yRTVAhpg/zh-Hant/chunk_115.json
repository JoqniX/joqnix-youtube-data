[{"type": "subtitle", "time": 6927.51, "timestamp": "01:55:27", "text": "這樣比較容易。  他們其實挺喜歡牛奶的。  味道不錯。"}, {"type": "subtitle", "time": 6929.47, "timestamp": "01:55:29", "text": "免費贈送"}, {"type": "subtitle", "time": 6930.91, "timestamp": "01:55:30", "text": "[音樂]牛奶瓶。即使你不給，如果他們沒要求，"}, {"type": "subtitle", "time": 6938.61, "timestamp": "01:55:38", "text": "他們也會主動拿走奶瓶。  好的，"}]
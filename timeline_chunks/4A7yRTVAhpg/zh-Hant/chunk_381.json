[{"type": "subtitle", "time": 22878.11, "timestamp": "06:21:18", "text": "我不假思索地開口說道：“"}, {"type": "subtitle", "time": 22886.868, "timestamp": "06:21:26", "text": "哦，天哪。對了，尤里，你呢？” “嗯，讓我"}, {"type": "subtitle", "time": 22890.628, "timestamp": "06:21:30", "text": "想想。”"}, {"type": "subtitle", "time": 22897.91, "timestamp": "06:21:37", "text": "尤里用手指描摹著茶杯的邊緣。 「嗯……我最喜歡那些構建了深邃複雜奇幻世界的"}]
[{"type": "subtitle", "time": 33723.87, "timestamp": "09:22:03", "text": "我一直都在關注他們，這樣"}, {"type": "subtitle", "time": 33750.746, "timestamp": "09:22:30", "text": "我才能"}, {"type": "subtitle", "time": 33753.35, "timestamp": "09:22:33", "text": "知道大家都在做什麼。是的。不是那樣，但是像[音樂]……嗯……不是那樣，更像是……嗯，怎麼說呢？嗯……我想做，但某種程度上我覺得，如果我做了，會不會……我不知道，有人會有不同的想法……"}, {"type": "subtitle", "time": 33762.71, "timestamp": "09:22:42", "text": "我"}, {"type": "subtitle", "time": 33765.87, "timestamp": "09:22:45", "text": "不知道……嗯……"}, {"type": "subtitle", "time": 33769.19, "timestamp": "09:22:49", "text": "我不知道，每當我看到油管博主的"}, {"type": "subtitle", "time": 33772.23, "timestamp": "09:22:52", "text": "短片或者真實視頻之"}, {"type": "subtitle", "time": 33775.67, "timestamp": "09:22:55", "text": "類的……"}]
[{"type": "subtitle", "time": 31321.99, "timestamp": "08:42:01", "text": "支持他們，"}, {"type": "subtitle", "time": 31325.35, "timestamp": "08:42:05", "text": "如果可以的話，請盡量過來看看。歡迎過來看看。我知道現在"}, {"type": "subtitle", "time": 31327.83, "timestamp": "08:42:07", "text": "是晚上。你們大多數人"}, {"type": "subtitle", "time": 31330.708, "timestamp": "08:42:10", "text": "恐怕都去不了那裡。"}, {"type": "subtitle", "time": 31332.91, "timestamp": "08:42:12", "text": "沒關係。挺好的。"}, {"type": "subtitle", "time": 31336.708, "timestamp": "08:42:16", "text": "但是，即使你來不了，也總會有的"}, {"type": "subtitle", "time": 31339.75, "timestamp": "08:42:19", "text": "，所以別擔心。"}, {"type": "subtitle", "time": 31341.91, "timestamp": "08:42:21", "text": "所以，讓我們盡力而為吧。這是我們第一次合作，"}, {"type": "subtitle", "time": 31344.468, "timestamp": "08:42:24", "text": "我們要去打高爾夫，而我這輩子從來沒打過"}, {"type": "subtitle", "time": 31347.67, "timestamp": "08:42:27", "text": "高爾夫。是"}, {"type": "subtitle", "time": 31350.23, "timestamp": "08:42:30", "text": "的，我下載了這款遊戲。我早上忘了"}, {"type": "subtitle", "time": 31353.51, "timestamp": "08:42:33", "text": "這事兒，不過呃，其實我在"}, {"type": "subtitle", "time": 31357.708, "timestamp": "08:42:37", "text": "下載完 Fortnite 相關"}, {"type": "subtitle", "time": 31361.868, "timestamp": "08:42:41", "text": "內容之後，就把它放到下載清單裡了。是的，我很高興。哦耶"}, {"type": "subtitle", "time": 31366.788, "timestamp": "08:42:46", "text": "，我回來了。哇，真好玩。今天真的太"}, {"type": "subtitle", "time": 31369.868, "timestamp": "08:42:49", "text": "開心了。我非常喜歡"}, {"type": "subtitle", "time": 31372.788, "timestamp": "08:42:52", "text": "。老兄，你的人生真精彩。但是"}, {"type": "subtitle", "time": 31375.19, "timestamp": "08:42:55", "text": "，我也需要盡快通關這款遊戲，"}, {"type": "subtitle", "time": 31378.23, "timestamp": "08:42:58", "text": "這樣我才能最終"}]
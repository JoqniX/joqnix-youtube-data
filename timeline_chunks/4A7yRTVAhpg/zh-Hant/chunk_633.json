[{"type": "subtitle", "time": 37990.39, "timestamp": "10:33:10", "text": "發現了PayPal的問題。不，那"}, {"type": "subtitle", "time": 38009.19, "timestamp": "10:33:29", "text": "不是我的帳號，是別人的帳號。想像一下Twitch的收益發放狀況。想像一下所有這些 Twitch"}, {"type": "subtitle", "time": 38017.19, "timestamp": "10:33:37", "text": "訂閱用戶等等。  所有錢都轉到了別人的帳戶。"}, {"type": "subtitle", "time": 38022.79, "timestamp": "10:33:42", "text": "我會在這裡痛哭流涕，問為什麼，為什麼，但感謝上帝，我被原諒了。"}]
[{"type": "subtitle", "time": 12664.07, "timestamp": "03:31:04", "text": "為什麼要進屋？什麼？現在"}, {"type": "subtitle", "time": 12667.03, "timestamp": "03:31:07", "text": "我們可以進屋了。敬請期待。  嗯？我需要服用小麥之類的東西嗎？是的。我不知道。目前還沒有這個"}, {"type": "subtitle", "time": 12669.91, "timestamp": "03:31:09", "text": "打算。"}, {"type": "subtitle", "time": 12680.309, "timestamp": "03:31:20", "text": "我們可以接受。是的。"}, {"type": "subtitle", "time": 12699.349, "timestamp": "03:31:39", "text": "如果你手裡拿著它。是的。快點。快點。我的天啊"}, {"type": "subtitle", "time": 12706.79, "timestamp": "03:31:46", "text": "。看看成本。真是亂成一團。我的天啊。一片混亂。這就是它出現的原因。  為什麼？為什麼？為什麼會傳來令人毛骨悚然的聲音？是的。過來。過來。哦，喬，你想吃披薩嗎？過來。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "啊，披薩。披薩.披薩時間到！"}, {"type": "subtitle", "time": 12717.91, "timestamp": "03:31:57", "text": "嘿，看。哦，它是可以吃的"}]
[{"type": "subtitle", "time": 33915.31, "timestamp": "09:25:15", "text": "結束的話，我要感謝大家。我忘了，然後Kurya來了，Kuryasan，謝謝你來。好久不見了。"}, {"type": "subtitle", "time": 33929.83, "timestamp": "09:25:29", "text": "你來。希望你"}, {"type": "subtitle", "time": 33932.79, "timestamp": "09:25:32", "text": "今天過得愉快。我是說，即使是下午或晚上"}, {"type": "subtitle", "time": 33939.426, "timestamp": "09:25:39", "text": "。還有，Paka，你為什麼總覺得我生你的氣"}, {"type": "subtitle", "time": 33953.35, "timestamp": "09:25:53", "text": "？我沒有，我根本不會生任何人的氣，甚至對我的家人也不會。我很寬容。即使你傷害我"}]
[{"type": "subtitle", "time": 35314.99, "timestamp": "09:48:34", "text": "，就像這樣。我下載英文字幕。對，我下載"}, {"type": "subtitle", "time": 35319.11, "timestamp": "09:48:39", "text": "英文字幕。把它保存在這裡。"}, {"type": "subtitle", "time": 35325.03, "timestamp": "09:48:45", "text": "然後是簡體中文字幕。下載SRT文件，不是txt文件。 txt"}, {"type": "subtitle", "time": 35327.906, "timestamp": "09:48:47", "text": "檔案可以用"}, {"type": "subtitle", "time": 35331.03, "timestamp": "09:48:51", "text": "畫圖軟體打開"}, {"type": "subtitle", "time": 35338.79, "timestamp": "09:48:58", "text": "，但要用編輯軟體之類的。 SRT更好。我把這"}]
[{"type": "subtitle", "time": 21968.708, "timestamp": "06:06:08", "text": "抱歉。[音樂]夏樹。[音樂]"}, {"type": "subtitle", "time": 21986.07, "timestamp": "06:06:26", "text": "鐮月。一個態度很差的女孩，好像叫夏樹，我"}, {"type": "subtitle", "time": 21988.868, "timestamp": "06:06:28", "text": "不認識她可能是一個小數，我猜她可能是一個小杯子，我不認識她可能說她的時候。她好可愛。"}, {"type": "subtitle", "time": 22011.35, "timestamp": "06:06:51", "text": "嗎"}]
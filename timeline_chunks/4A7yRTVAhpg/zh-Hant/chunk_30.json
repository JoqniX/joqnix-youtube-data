[{"type": "subtitle", "time": 1832.63, "timestamp": "00:30:32", "text": "我們確實需要這個。"}, {"type": "subtitle", "time": 1836.23, "timestamp": "00:30:36", "text": "沒關係。我暫時把它放在櫃子裡。"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "我們並不需要這個。我們需要"}, {"type": "subtitle", "time": 1848.17, "timestamp": "00:30:48", "text": "額外的桌子。糟糕。  沒關係。好的。哦，就像個花盆。為什麼門打開這麼慢？我不知道。  但"}, {"type": "subtitle", "time": 1858.389, "timestamp": "00:30:58", "text": "我們完蛋了。  我覺得我們可能沒有足夠的盤子。糟糕，我們沒有足夠的航班。沒關係"}]
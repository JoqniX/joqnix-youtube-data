[{"type": "subtitle", "time": 26290.15, "timestamp": "07:18:10", "text": "莫妮卡有沒有受傷。確實如此。  是的，我知道。"}, {"type": "subtitle", "time": 26320.868, "timestamp": "07:18:40", "text": "這是"}, {"type": "subtitle", "time": 26324.07, "timestamp": "07:18:44", "text": "我最擅長的。"}, {"type": "subtitle", "time": 26333.708, "timestamp": "07:18:53", "text": "好了，我得走了。再見。你好。呃，保重。小心。是的，感謝"}]
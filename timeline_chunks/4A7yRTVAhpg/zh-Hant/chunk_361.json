[{"type": "subtitle", "time": 21662.83, "timestamp": "06:01:02", "text": "你在開玩笑嗎？得把這個念出來，對吧？"}, {"type": "subtitle", "time": 21683.03, "timestamp": "06:01:23", "text": "哦，嘿。她完全沒注意到自己可能會引起任何注意。朋友。醒來又醒來，真是煩死了。 哦，但如果她"}, {"type": "subtitle", "time": 21689.75, "timestamp": "06:01:29", "text": "要追我，追得那麼緊，我感覺還不如逃跑。也很差。 真是"}, {"type": "subtitle", "time": 21701.27, "timestamp": "06:01:41", "text": "痛苦。略我似的。 這樣說很沒禮貌。"}, {"type": "subtitle", "time": 21718.948, "timestamp": "06:01:58", "text": "好吧，如果別人因為你行為"}]
[{"type": "subtitle", "time": 26595.11, "timestamp": "07:23:15", "text": "因為"}, {"type": "subtitle", "time": 26598.11, "timestamp": "07:23:18", "text": "他們不想讓你難堪"}, {"type": "subtitle", "time": 26601.67, "timestamp": "07:23:21", "text": "。幸好，"}, {"type": "subtitle", "time": 26606.43, "timestamp": "07:23:26", "text": "我不在乎"}, {"type": "subtitle", "time": 26609.23, "timestamp": "07:23:29", "text": "。我真的不在乎。"}, {"type": "subtitle", "time": 26614.788, "timestamp": "07:23:34", "text": "你好。嘿，你是說更酷嗎？你甚至都不把西裝外套的釦子扣上。索里，說"}, {"type": "subtitle", "time": 26623.548, "timestamp": "07:23:43", "text": "真的，你覺得為什麼還沒有男朋友"}, {"type": "subtitle", "time": 26634.11, "timestamp": "07:23:54", "text": "？這也太刻薄了吧。不好意思，不過"}]
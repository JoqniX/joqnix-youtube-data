[{"type": "subtitle", "time": 27846.868, "timestamp": "07:44:06", "text": "自己最後的舒適之地，無法放下"}, {"type": "subtitle", "time": 27849.83, "timestamp": "07:44:09", "text": "過去，很快她將"}, {"type": "subtitle", "time": 27851.35, "timestamp": "07:44:11", "text": "一無所有。那樣說比那樣表達嚴肅得多。"}, {"type": "subtitle", "time": 27863.19, "timestamp": "07:44:23", "text": "我根本沒想過這一點。那真是令人印象深刻。沒什麼"}, {"type": "subtitle", "time": 27887.23, "timestamp": "07:44:47", "text": "[音樂] 嗯，"}, {"type": "subtitle", "time": 27891.43, "timestamp": "07:44:51", "text": "你這麼想我很高興。記住，用不了多久你也會注意到這些事情"}]
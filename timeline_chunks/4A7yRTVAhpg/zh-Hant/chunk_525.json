[{"type": "subtitle", "time": 31503.35, "timestamp": "08:45:03", "text": "玩《"}, {"type": "subtitle", "time": 31517.868, "timestamp": "08:45:17", "text": "要塞英雄》之類的。但是新賽季快到了，所以我會玩新賽季的。"}, {"type": "subtitle", "time": 31521.27, "timestamp": "08:45:21", "text": "所以"}, {"type": "subtitle", "time": 31525.35, "timestamp": "08:45:25", "text": "我就在"}, {"type": "subtitle", "time": 31528.468, "timestamp": "08:45:28", "text": "想，為什麼不專門安排單機遊戲直播計畫呢？還有一些我需要完成但還沒玩完的遊戲，我會把它們安排成固定的直播，每次一兩個小時。至於我的空閒時間，"}, {"type": "subtitle", "time": 31543.07, "timestamp": "08:45:43", "text": "我會安排兩個小時的直播來工作，或是進行一些隨性的直播，像是玩《瓦倫達》或其他任何我"}, {"type": "subtitle", "time": 31548.43, "timestamp": "08:45:48", "text": "想玩的遊戲。所以，這就是我當時覺得我能做到的"}, {"type": "subtitle", "time": 31551.27, "timestamp": "08:45:51", "text": "。我不知道你怎麼想。或許可行。"}, {"type": "subtitle", "time": 31556.23, "timestamp": "08:45:56", "text": "我"}, {"type": "subtitle", "time": 31557.308, "timestamp": "08:45:57", "text": "不"}]
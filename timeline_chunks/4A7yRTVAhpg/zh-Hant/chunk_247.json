[{"type": "subtitle", "time": 14820.389, "timestamp": "04:07:00", "text": "一個靜音快捷鍵，但它突然失效了。  沒關係。沒關係。加入。好的"}, {"type": "subtitle", "time": 14824.71, "timestamp": "04:07:04", "text": "。"}, {"type": "subtitle", "time": 14826.87, "timestamp": "04:07:06", "text": "嘿，給我發個邀請。我給你發邀請。"}, {"type": "subtitle", "time": 14832.71, "timestamp": "04:07:12", "text": "好的。  你好。我起來。"}, {"type": "subtitle", "time": 14842.07, "timestamp": "04:07:22", "text": "我去把"}, {"type": "subtitle", "time": 14844.95, "timestamp": "04:07:24", "text": "水接滿，馬上回來。好的。好的。我們會等待。  好的。咱們"}, {"type": "subtitle", "time": 14854.469, "timestamp": "04:07:34", "text": "去城裡吧，因為我從來不喜歡玩城裡的遊戲。  下地獄吧。哇。我很高興自己仍然是個紅髮辣妹。謝謝。謝謝。  這是第一個這樣對待我的遊戲。我很高興。保重。再見。謝謝光臨。希望你的大腿早日康復。  請幫我"}, {"type": "subtitle", "time": 14862.07, "timestamp": "04:07:42", "text": "續滿水。  是的"}]
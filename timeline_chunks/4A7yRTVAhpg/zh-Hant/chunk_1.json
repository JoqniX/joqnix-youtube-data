[{"type": "chat", "time": 60.002, "timestamp": "00:01:00", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/12az7rPw"}, {"type": "chat", "time": 61.503, "timestamp": "00:01:01", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Joqi I just woke up"}, {"type": "subtitle", "time": 77.19, "timestamp": "00:01:17", "text": "。  歷史上有幾個幽靈標籤，為你帶來酷炫的鑽石。對不起。你只是……你只是……這意味著你不應該聽。這意味著你不應該聽。腦桿。不用擔心。  廁所非常棒。如果"}, {"type": "subtitle", "time": 79.10900000000001, "timestamp": "00:01:19", "text": "你不理解這一點，反而是件"}, {"type": "subtitle", "time": 81.91, "timestamp": "00:01:21", "text": "好事。確切地。基本上就是繩子。"}, {"type": "subtitle", "time": 84.23, "timestamp": "00:01:24", "text": "我正在路上。你是俄亥俄州的利比。對不起"}, {"type": "subtitle", "time": 90.63, "timestamp": "00:01:30", "text": "。請停止俄亥俄州的行動。凱拉，我們不玩"}, {"type": "subtitle", "time": 92.31, "timestamp": "00:01:32", "text": "木筏遊戲。為什麼要造船？"}, {"type": "subtitle", "time": 94.83, "timestamp": "00:01:34", "text": "搞什麼鬼？我的意思是，"}, {"type": "subtitle", "time": 100.31, "timestamp": "00:01:40", "text": "女王陛下，我這兒有繩子。我們能在"}, {"type": "subtitle", "time": 103.19, "timestamp": "00:01:43", "text": "這裡建一個嗎？"}, {"type": "subtitle", "time": 105.27000000000001, "timestamp": "00:01:45", "text": "我覺得我們應該先集中精力解決房子的問題"}, {"type": "subtitle", "time": 116.8, "timestamp": "00:01:56", "text": "。當然。當然。等等，迷路了。  好的。是的"}]
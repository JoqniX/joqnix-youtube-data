[{"type": "subtitle", "time": 31441.35, "timestamp": "08:44:01", "text": "這些遊戲我可以隨時玩，想玩就玩，不用像以前那樣安排時間玩"}, {"type": "subtitle", "time": 31451.03, "timestamp": "08:44:11", "text": "。我可以直接用"}, {"type": "subtitle", "time": 31454.308, "timestamp": "08:44:14", "text": "它擦拭。我也喜歡《命運》。它們都屬於這類多人遊戲，對吧？這些都屬於這種非計劃"}, {"type": "subtitle", "time": 31462.628, "timestamp": "08:44:22", "text": "性的活動，例如當"}, {"type": "subtitle", "time": 31470.308, "timestamp": "08:44:30", "text": "我"}, {"type": "subtitle", "time": 31477.59, "timestamp": "08:44:37", "text": "想做點什麼或想玩什麼的時候，我就可以做那種事。所以我一直在想，其實你們都知道我開了很多系列直播，大部分"}, {"type": "subtitle", "time": 31479.75, "timestamp": "08:44:39", "text": "多人遊戲系列我都"}, {"type": "subtitle", "time": 31483.91, "timestamp": "08:44:43", "text": "玩不下去，因為已經有很多系列直播了。"}, {"type": "subtitle", "time": 31486.788, "timestamp": "08:44:46", "text": "不過，"}, {"type": "subtitle", "time": 31489.19, "timestamp": "08:44:49", "text": "我有時候會"}, {"type": "subtitle", "time": 31492.308, "timestamp": "08:44:52", "text": "玩，有時候"}, {"type": "subtitle", "time": 31496.15, "timestamp": "08:44:56", "text": "不會，這取決於我想玩什麼。特別是"}, {"type": "subtitle", "time": 31498.07, "timestamp": "08:44:58", "text": "像《鬥陣特攻》這樣的多人遊戲，如果有活動的話，我就會"}]
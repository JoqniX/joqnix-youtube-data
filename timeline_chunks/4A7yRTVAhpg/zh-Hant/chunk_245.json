[{"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "我不知道。我不知道這會帶來什麼區別。我不知道。沒有"}, {"type": "subtitle", "time": 14728.309, "timestamp": "04:05:28", "text": "什麼。  H. Oh.哦。哇。哦。噓，這裡是Hush。我的天啊。我的天啊。  遊戲進行得很順利，湯米會很高興的。  發生了什麼事？  什麼？"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "你聽得到我嗎？沒有靜音。"}, {"type": "subtitle", "time": 14746.389, "timestamp": "04:05:46", "text": "哦，該死。我不是故意要"}, {"type": "subtitle", "time": 14750.469, "timestamp": "04:05:50", "text": "靜音的。  糟糕。別理它。你真酷。你真酷。你真酷"}]
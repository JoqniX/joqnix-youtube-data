[{"type": "subtitle", "time": 663.43, "timestamp": "00:11:03", "text": "。僅限受邀者付費。"}, {"type": "subtitle", "time": 678.069, "timestamp": "00:11:18", "text": "我們喜歡交朋友。好了。是的。"}, {"type": "subtitle", "time": 695.91, "timestamp": "00:11:35", "text": "嗨，桃子。你也可以換衣服。我喜歡玩鬧。看你打球真開心。我玩過一次，場面很混亂，但你知道，"}, {"type": "subtitle", "time": 698.97, "timestamp": "00:11:38", "text": "我們會玩得很開心。  給我一分鐘時間。各位保重。  按 O 開始。"}]
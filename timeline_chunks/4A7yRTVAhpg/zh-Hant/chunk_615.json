[{"type": "subtitle", "time": 36915.39, "timestamp": "10:15:15", "text": "Jokathon 等等活動中獲得的片段和所有東西，"}, {"type": "subtitle", "time": 36924.15, "timestamp": "10:15:24", "text": "嗯，做所有的事情。我們現在就得去做這件事"}, {"type": "subtitle", "time": 36931.55, "timestamp": "10:15:31", "text": "。所以，我們必須這樣做。我們會這麼做"}, {"type": "subtitle", "time": 36936.426, "timestamp": "10:15:36", "text": "。嗯。  昨天我一直說要錄個影片來宣傳活動，但DJ馬拉松已經開始了，所以"}, {"type": "subtitle", "time": 36940.35, "timestamp": "10:15:40", "text": "我覺得沒問題。但是DJ馬拉松"}, {"type": "subtitle", "time": 36951.906, "timestamp": "10:15:51", "text": "那邊"}, {"type": "subtitle", "time": 36955.19, "timestamp": "10:15:55", "text": "我們"}]
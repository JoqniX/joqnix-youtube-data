[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "好的。他會迎來"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "爆發時刻。我簡直不敢相信他離開了。他像我生命中的其他人一樣離開了。被遺棄，被背叛，任其腐爛而死。靠自己。是的。"}, {"type": "subtitle", "time": 11975.71, "timestamp": "03:19:35", "text": "但我們沒事。我"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "想我也加入你們。  讓我來享用你手上的美味吧。  你還記得遵守這些準則嗎？等待。好的。現在"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "我明白了。耶"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "。"}, {"type": "subtitle", "time": 11995.11, "timestamp": "03:19:55", "text": "你記得遵守這些規定嗎"}, {"type": "subtitle", "time": 11998.15, "timestamp": "03:19:58", "text": "？喬。保留所有物品。保留所有物品。你的笑話。再見。你正在摸索遊戲規則。  是的。為什麼？為什麼我的"}]
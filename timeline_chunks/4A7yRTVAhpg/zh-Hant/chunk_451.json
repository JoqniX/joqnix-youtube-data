[{"type": "subtitle", "time": 27076.67, "timestamp": "07:31:16", "text": "音樂》。另一方面，莫妮卡在作文簿上寫下的字跡，從我坐的地方就能看到莫妮卡工整的筆跡。  尤里"}, {"type": "subtitle", "time": 27083.11, "timestamp": "07:31:23", "text": "不情願地也同意了，並開始動用他們的銀行帳戶。我自己也"}, {"type": "subtitle", "time": 27088.23, "timestamp": "07:31:28", "text": "這樣做。我該先把我的詩給誰看"}, {"type": "subtitle", "time": 27095.23, "timestamp": "07:31:35", "text": "？喔"}, {"type": "subtitle", "time": 27097.468, "timestamp": "07:31:37", "text": "不，我該怎麼辦？我該怎麼辦？糟了，"}]
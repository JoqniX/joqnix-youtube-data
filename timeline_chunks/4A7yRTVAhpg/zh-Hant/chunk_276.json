[{"type": "subtitle", "time": 16563.949, "timestamp": "04:36:03", "text": "那嚇到我了。  是的。哦，你好，"}, {"type": "subtitle", "time": 16581.269, "timestamp": "04:36:21", "text": "眼球在哪裡？我找不到。  好的。他好像"}, {"type": "subtitle", "time": 16583.91, "timestamp": "04:36:23", "text": "很有興趣。我找到了我的，但"}, {"type": "subtitle", "time": 16587.189, "timestamp": "04:36:27", "text": "我立刻就把它扔了，因為我不想玩這個"}, {"type": "subtitle", "time": 16590.551, "timestamp": "04:36:30", "text": "。比如說，你現在手上在玩什麼遊戲？呃，目前我正在安裝怪物獵人崛起。我有一隻《錘子英雄》手錶。我有一些Golfit"}, {"type": "subtitle", "time": 16592.629, "timestamp": "04:36:32", "text": "好友。我"}, {"type": "subtitle", "time": 16598.089, "timestamp": "04:36:38", "text": "玩《鐵鎚英雄》手錶遊戲。我不。哦。是的。哦，還有更多遊戲。我也有《求生之"}]
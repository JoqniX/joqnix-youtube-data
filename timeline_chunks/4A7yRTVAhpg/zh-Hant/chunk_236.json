[{"type": "subtitle", "time": 14171.67, "timestamp": "03:56:11", "text": "我們來扶你起來"}, {"type": "subtitle", "time": 14174.389, "timestamp": "03:56:14", "text": "。你贏了嗎？哦，我們搞定了三隻山羊。還有，歡迎來到直播間，Zena。"}, {"type": "subtitle", "time": 14177.269, "timestamp": "03:56:17", "text": "你今天怎麼樣？  我們走吧。我們需要乾草。  我的天啊。"}, {"type": "subtitle", "time": 14191.83, "timestamp": "03:56:31", "text": "為什麼我們像短草？哦，不。糟糕。我們直接把電梯放在這裡就行了。我再去買一隻山羊。已收購。回到"}, {"type": "subtitle", "time": 14211.75, "timestamp": "03:56:51", "text": "召喚物啟動的環節。呃，我需要那樣做嗎？不。對。  黃金你"}]
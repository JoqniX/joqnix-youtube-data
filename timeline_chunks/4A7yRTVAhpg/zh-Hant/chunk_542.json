[{"type": "subtitle", "time": 32527.67, "timestamp": "09:02:07", "text": "我得發推特"}, {"type": "subtitle", "time": 32531.19, "timestamp": "09:02:11", "text": "。喔天哪，"}, {"type": "subtitle", "time": 32534.15, "timestamp": "09:02:14", "text": "我得發推文。是啊，我得發推文。"}, {"type": "subtitle", "time": 32543.35, "timestamp": "09:02:23", "text": "我"}, {"type": "subtitle", "time": 32546.308, "timestamp": "09:02:26", "text": "剛剛發現我的推特橫幅沒有更新。哇。好吧。通常都是這樣嗎？ [音樂] 好了，現在更新了。好吧，所以"}, {"type": "subtitle", "time": 32548.388, "timestamp": "09:02:28", "text": "我得發兩次之類的"}, {"type": "subtitle", "time": 32552.15, "timestamp": "09:02:32", "text": "。天哪，你怎麼知道[音樂] 會這樣？我心想，我知道我應該結束直播了，但我真的快要崩潰了。別在意[音樂]我。哦，對了，關於"}, {"type": "subtitle", "time": 32579.27, "timestamp": "09:02:59", "text": "Valerant"}]
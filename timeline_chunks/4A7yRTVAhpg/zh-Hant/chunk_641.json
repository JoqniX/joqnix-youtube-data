[{"type": "subtitle", "time": 38480.95, "timestamp": "10:41:20", "text": "我給我"}, {"type": "subtitle", "time": 38481.2, "timestamp": "10:41:21", "text": "的"}, {"type": "subtitle", "time": 38484.19, "timestamp": "10:41:24", "text": "銀行"}, {"type": "subtitle", "time": 38487.19, "timestamp": "10:41:27", "text": "分行，也就是我爸幫我開戶的那家附近的銀行分行，寫了一封電子郵件。"}, {"type": "subtitle", "time": 38494.87, "timestamp": "10:41:34", "text": "於是，我給他們發了一封電子郵件。我爸爸也給他們打了電話，說我給他們發了"}, {"type": "subtitle", "time": 38509.99, "timestamp": "10:41:49", "text": "電子郵件，他們會跟進並處理此事。我想我可能還得去……呃，我可能還得去銀行。"}]
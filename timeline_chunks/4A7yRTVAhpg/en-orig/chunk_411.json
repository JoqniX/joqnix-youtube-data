[{"type": "subtitle", "time": 24660.83, "timestamp": "06:51:00", "text": "Monica, baka,"}, {"type": "subtitle", "time": 24668.31, "timestamp": "06:51:08", "text": "fine. The cupcakes, your poems,"}, {"type": "subtitle", "time": 24672.03, "timestamp": "06:51:12", "text": "everything you do is just as cute as you"}, {"type": "subtitle", "time": 24675.99, "timestamp": "06:51:15", "text": "are. Suslets up behind Natsuki and puts"}, {"type": "subtitle", "time": 24678.99, "timestamp": "06:51:18", "text": "her hand around her shoulders."}, {"type": "subtitle", "time": 24681.948, "timestamp": "06:51:21", "text": "Ada, I'm not"}, {"type": "subtitle", "time": 24685.708, "timestamp": "06:51:25", "text": "cute. Natsuki, you write your own"}, {"type": "subtitle", "time": 24688.75, "timestamp": "06:51:28", "text": "poems. Uh, well, I guess"}, {"type": "subtitle", "time": 24691.788, "timestamp": "06:51:31", "text": "sometimes. Why do you"}, {"type": "subtitle", "time": 24694.83, "timestamp": "06:51:34", "text": "care? I think that's"}, {"type": "subtitle", "time": 24697.81, "timestamp": "06:51:37", "text": "impressive. Why don't you share them"}, {"type": "subtitle", "time": 24700.99, "timestamp": "06:51:40", "text": "[Music]"}, {"type": "subtitle", "time": 24704.35, "timestamp": "06:51:44", "text": "sometime? No."}, {"type": "subtitle", "time": 24707.948, "timestamp": "06:51:47", "text": "No. That's the key. How"}, {"type": "subtitle", "time": 24709.628, "timestamp": "06:51:49", "text": "about"}, {"type": "subtitle", "time": 24713.11, "timestamp": "06:51:53", "text": "you like them?"}]
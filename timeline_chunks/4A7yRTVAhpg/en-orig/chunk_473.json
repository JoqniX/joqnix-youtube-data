[{"type": "subtitle", "time": 28383.11, "timestamp": "07:53:03", "text": "Who know? Actually, the story is in the"}, {"type": "subtitle", "time": 28387.23, "timestamp": "07:53:07", "text": "board. A ghost. at all. Jocknik,"}, {"type": "subtitle", "time": 28390.868, "timestamp": "07:53:10", "text": "freely. I must have totally missed the"}, {"type": "subtitle", "time": 28393.67, "timestamp": "07:53:13", "text": "point. Well, I suppose you did only"}, {"type": "subtitle", "time": 28396.83, "timestamp": "07:53:16", "text": "glance over it after all."}, {"type": "subtitle", "time": 28401.43, "timestamp": "07:53:21", "text": "But remember that poem poets often"}, {"type": "subtitle", "time": 28403.75, "timestamp": "07:53:23", "text": "express their thought own thoughts,"}, {"type": "subtitle", "time": 28406.67, "timestamp": "07:53:26", "text": "feelings, and experiences in their"}, {"type": "subtitle", "time": 28410.15, "timestamp": "07:53:30", "text": "work. They usually do more than tell a"}, {"type": "subtitle", "time": 28413.43, "timestamp": "07:53:33", "text": "story, simple story, or paint a picture."}, {"type": "subtitle", "time": 28416.868, "timestamp": "07:53:36", "text": "In this case, perhaps the subject of the"}, {"type": "subtitle", "time": 28419.91, "timestamp": "07:53:39", "text": "poem is only being symbolically compared"}, {"type": "subtitle", "time": 28421.07, "timestamp": "07:53:41", "text": "to a"}, {"type": "subtitle", "time": 28424.27, "timestamp": "07:53:44", "text": "ghost. Lingering in her"}, {"type": "subtitle", "time": 28427.11, "timestamp": "07:53:47", "text": "remaining place of comfort, unable to"}, {"type": "subtitle", "time": 28431.43, "timestamp": "07:53:51", "text": "let go of the past and soon to be left"}, {"type": "subtitle", "time": 28438.19, "timestamp": "07:53:58", "text": "nothing. That's a lot more solemn"}]
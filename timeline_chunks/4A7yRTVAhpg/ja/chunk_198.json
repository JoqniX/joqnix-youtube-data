[{"type": "subtitle", "time": 11880.63, "timestamp": "03:18:00", "text": "屋根裏部屋の反対側。えーっと"}, {"type": "subtitle", "time": 11882.71, "timestamp": "03:18:02", "text": "もしあなたが屋根裏部屋に上がるなら、"}, {"type": "subtitle", "time": 11887.19, "timestamp": "03:18:07", "text": "反対側には、アンナがいます"}, {"type": "subtitle", "time": 11891.71, "timestamp": "03:18:11", "text": "不気味なカボチャの音が鳴り響く。何てことだ。"}, {"type": "subtitle", "time": 11894.229, "timestamp": "03:18:14", "text": "アンナの反対側のように、"}, {"type": "subtitle", "time": 11898.07, "timestamp": "03:18:18", "text": "彼女が必要だ。はい。彼女は私の近くにいる。私"}, {"type": "subtitle", "time": 11900.309, "timestamp": "03:18:20", "text": "彼女の顔をよく見ることができた。"}, {"type": "subtitle", "time": 11903.67, "timestamp": "03:18:23", "text": "ほら、こういうことがあるんだ。"}, {"type": "subtitle", "time": 11906.229, "timestamp": "03:18:26", "text": "どこへ連れて行きますか？"}, {"type": "subtitle", "time": 11909.349, "timestamp": "03:18:29", "text": "えっと、一番上に？その上には"}, {"type": "subtitle", "time": 11912.389, "timestamp": "03:18:32", "text": "ガソリンみたいなもの。手に入れることができる。私は必要としている"}, {"type": "subtitle", "time": 11915.75, "timestamp": "03:18:35", "text": "私がロックを解除するのが好きです"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "ドア。ああ、ジョー、これ読んだの？"}, {"type": "subtitle", "time": 11920.79, "timestamp": "03:18:40", "text": "法律？"}, {"type": "subtitle", "time": 11923.51, "timestamp": "03:18:43", "text": "どれ？えっと、全部読んだって書いてあったと思うんだけど"}, {"type": "subtitle", "time": 11926.229, "timestamp": "03:18:46", "text": "しかし、法律は。 3回中3回。おお、"}, {"type": "subtitle", "time": 11929.269, "timestamp": "03:18:49", "text": "わかった。よくやった。おお、いいね。よくやった。私は"}, {"type": "subtitle", "time": 11931.19, "timestamp": "03:18:51", "text": "君を誇りに思うよ。私たちはロックを解除したと思います"}, {"type": "subtitle", "time": 11933.349, "timestamp": "03:18:53", "text": "すべての部屋。ヴィック、君は"}, {"type": "subtitle", "time": 11937.229, "timestamp": "03:18:57", "text": "ジョックにヤギの捕まえ方を教える？"}]
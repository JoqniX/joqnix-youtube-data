[{"type": "subtitle", "time": 12664.07, "timestamp": "03:31:04", "text": "それってやらなきゃいけないの？いいえ。そうです。"}, {"type": "subtitle", "time": 12667.03, "timestamp": "03:31:07", "text": "金はそのまま持っていていいよ。私は"}, {"type": "subtitle", "time": 12669.91, "timestamp": "03:31:09", "text": "それではコードを書きます。わかった。"}, {"type": "subtitle", "time": 12680.309, "timestamp": "03:31:20", "text": "ああ、この場所に置けるよ。"}, {"type": "subtitle", "time": 12682.95, "timestamp": "03:31:22", "text": "右？"}, {"type": "subtitle", "time": 12684.87, "timestamp": "03:31:24", "text": "彼女は私に襲いかかってくるだろうか？それは逃げ出すだろう。"}, {"type": "subtitle", "time": 12686.309, "timestamp": "03:31:26", "text": "それは逃げ出すだろう。落とすことはできません"}, {"type": "subtitle", "time": 12689.51, "timestamp": "03:31:29", "text": "ヤギ。ああ、"}, {"type": "subtitle", "time": 12692.15, "timestamp": "03:31:32", "text": "救急キットのようにヤギを捕まえることはできない"}, {"type": "subtitle", "time": 12699.349, "timestamp": "03:31:39", "text": "待って、もし私がそれを手に持ったままにしたら、彼は"}, {"type": "subtitle", "time": 12706.79, "timestamp": "03:31:46", "text": "あまり。ああ、わかりました。私の"}, {"type": "subtitle", "time": 12709.99, "timestamp": "03:31:49", "text": "わかった。私はヤギを飼っていて、ジャックは"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "ちなみに、地下室だよ、みんな。おお、いいね。"}, {"type": "subtitle", "time": 12715.83, "timestamp": "03:31:55", "text": "とにかく、私はヤギを飼っていて、ジャックは"}, {"type": "subtitle", "time": 12717.91, "timestamp": "03:31:57", "text": "ヤギ。私たちはどうすべきでしょうか？わかった。ええ、私たちは"}]
[{"type": "subtitle", "time": 1623.35, "timestamp": "00:27:03", "text": "これ。一日の終わりだ。わーい。"}, {"type": "subtitle", "time": 1632.39, "timestamp": "00:27:12", "text": "ああ、終わってしまった。おお、"}, {"type": "subtitle", "time": 1635.59, "timestamp": "00:27:15", "text": "うん。あっという間に終わる。"}, {"type": "subtitle", "time": 1637.47, "timestamp": "00:27:17", "text": "本当に手短に。泣かないでください。"}, {"type": "subtitle", "time": 1639.71, "timestamp": "00:27:19", "text": "すべて。トレイ"}, {"type": "subtitle", "time": 1643.029, "timestamp": "00:27:23", "text": "立つ。えっと"}, {"type": "subtitle", "time": 1645.19, "timestamp": "00:27:25", "text": "シンク。シンク。"}, {"type": "subtitle", "time": 1654.269, "timestamp": "00:27:34", "text": "えっと、これって買う必要ありますか？"}, {"type": "subtitle", "time": 1658.93, "timestamp": "00:27:38", "text": "はい、これは良いでしょう。"}, {"type": "subtitle", "time": 1660.63, "timestamp": "00:27:40", "text": "[音楽]"}, {"type": "subtitle", "time": 1663.11, "timestamp": "00:27:43", "text": "これをどこに置けばいいですか？これを充電してください。私は手に入れた"}, {"type": "subtitle", "time": 1666.149, "timestamp": "00:27:46", "text": "1つ。とった。よし、一つ手に入れたぞ。わかった。"}, {"type": "subtitle", "time": 1669.909, "timestamp": "00:27:49", "text": "それをやめるべきでしょうか？それともやめるべきですか？"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "えっと、スタンドみたいなものが必要なんじゃないですか？"}, {"type": "subtitle", "time": 1677.029, "timestamp": "00:27:57", "text": "あれ？"}]
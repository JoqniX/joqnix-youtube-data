[{"type": "subtitle", "time": 15002.55, "timestamp": "04:10:02", "text": "ニース。闇市場を見てみろ。破壊行為。"}, {"type": "subtitle", "time": 15012.63, "timestamp": "04:10:12", "text": "それも適切な指標ですね。ヴィック"}, {"type": "subtitle", "time": 15014.55, "timestamp": "04:10:14", "text": "ヴィックはとんでもない市場を持っているが、"}, {"type": "subtitle", "time": 15017.83, "timestamp": "04:10:17", "text": "嘘。レアゴーストやアイアンフレンジーのように、"}, {"type": "subtitle", "time": 15024.469, "timestamp": "04:10:24", "text": "例えば、あなたの好きな市場を見せてください。"}, {"type": "subtitle", "time": 15027.429, "timestamp": "04:10:27", "text": "公開チャットで送ります。わかった。うん。"}, {"type": "subtitle", "time": 15029.67, "timestamp": "04:10:29", "text": "ええ、見えますよ。あなたが見えます。おお、"}, {"type": "subtitle", "time": 15031.99, "timestamp": "04:10:31", "text": "ホライゾン・フレンジーとは何ですか？見た目"}, {"type": "subtitle", "time": 15039.79, "timestamp": "04:10:39", "text": "ああ、なんてことだ、闇市場だ。"}, {"type": "subtitle", "time": 15043.269, "timestamp": "04:10:43", "text": "ああ、良さそうだ。"}, {"type": "subtitle", "time": 15045.349, "timestamp": "04:10:45", "text": "これはどのゲームでもデフォルトスキンになり得る"}, {"type": "subtitle", "time": 15049.67, "timestamp": "04:10:49", "text": "ゲームではあるが、Valorではプレミアムゲームだ。"}, {"type": "subtitle", "time": 15051.349, "timestamp": "04:10:51", "text": "うん。闇市場の問題点は"}, {"type": "subtitle", "time": 15054.229, "timestamp": "04:10:54", "text": "スイッチを入れると銃の動かし方が変わります"}, {"type": "subtitle", "time": 15055.75, "timestamp": "04:10:55", "text": "攻撃するかどうかによって見た目が変わります"}, {"type": "subtitle", "time": 15059.59, "timestamp": "04:10:59", "text": "あるいは防御する。うん。"}]
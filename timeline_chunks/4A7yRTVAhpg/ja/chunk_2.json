[{"type": "subtitle", "time": 122.389, "timestamp": "00:02:02", "text": "ああ、そうじゃない、そうじゃない、そうじゃない"}, {"type": "subtitle", "time": 124.83, "timestamp": "00:02:04", "text": "お前の名を抹殺してやる。それは"}, {"type": "subtitle", "time": 127.51, "timestamp": "00:02:07", "text": "それはあなたを殺すでしょう。それは確かに殺す"}, {"type": "chat", "time": 128.565, "timestamp": "00:02:08", "author": "@HawksTheGreat", "avatar": "https://yt4.ggpht.com/wIXzMkIdhkpB7e8s2M6Eg2Kma9ZHeQ86iJ5gTwujW3p7qmbWfnmzLN_VgliuNH3SRsdBR5qeZA=s64-c-k-c0x00ffffff-no-rj", "message": "what's this?"}, {"type": "subtitle", "time": 130.869, "timestamp": "00:02:10", "text": "それ。いや、その丸太はちょうど私の上に落ちてきたんだ"}, {"type": "chat", "time": 131.368, "timestamp": "00:02:11", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... Matthew, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 132.98, "timestamp": "00:02:12", "text": "なぜなら私はこうだったから"}, {"type": "subtitle", "time": 138.15, "timestamp": "00:02:18", "text": "私は持っていません。 1つ足りない"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "ロープ。"}, {"type": "subtitle", "time": 141.82999999999998, "timestamp": "00:02:21", "text": "布があれば、私はロープを持っています。私は持っている"}, {"type": "subtitle", "time": 143.99, "timestamp": "00:02:23", "text": "ロープ。動け、動け、動け、動け。これですか"}, {"type": "subtitle", "time": 145.99, "timestamp": "00:02:25", "text": "大丈夫？ロープが通ってきた。近日公開"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "を通して。わかった。どこで料理できますか？"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "ログを再度収集する必要があります。私は行く"}, {"type": "subtitle", "time": 154.39, "timestamp": "00:02:34", "text": "収集作業に行く。はい、承知いたしました。"}, {"type": "subtitle", "time": 157.03, "timestamp": "00:02:37", "text": "はい、どうぞ。とても面白いだろう"}, {"type": "subtitle", "time": 160.82999999999998, "timestamp": "00:02:40", "text": "いかだの上で火を起こすんだよ。"}, {"type": "subtitle", "time": 163.82999999999998, "timestamp": "00:02:43", "text": "ええ、実際に可能です。木材。"}, {"type": "subtitle", "time": 168.22899999999998, "timestamp": "00:02:48", "text": "木材。私たちはその歌手が好きになれる。"}, {"type": "subtitle", "time": 177.39, "timestamp": "00:02:57", "text": "を突き破る"}]
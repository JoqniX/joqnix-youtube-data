[{"type": "subtitle", "time": 17401.07, "timestamp": "04:50:01", "text": "例えば、予告編の作り方など。"}, {"type": "subtitle", "time": 17405.43, "timestamp": "04:50:05", "text": "ああ、ビデオ編集関連の"}, {"type": "subtitle", "time": 17407.51, "timestamp": "04:50:07", "text": "どうやってやっているのか、いまだに不思議に思います。私はただ"}, {"type": "subtitle", "time": 17409.15, "timestamp": "04:50:09", "text": "基本的な知識"}, {"type": "subtitle", "time": 17413.35, "timestamp": "04:50:13", "text": "編集、カット、トリミング。それでおしまい。"}, {"type": "subtitle", "time": 17420.15, "timestamp": "04:50:20", "text": "それ。とにかく、それが私があなたに尋ねた理由です"}, {"type": "subtitle", "time": 17422.39, "timestamp": "04:50:22", "text": "君は僕に何か編集してほしいみたいだね"}, {"type": "subtitle", "time": 17424.868, "timestamp": "04:50:24", "text": "たとえそれが基本的なものであったとしても、"}, {"type": "subtitle", "time": 17427.03, "timestamp": "04:50:27", "text": "何か。"}, {"type": "subtitle", "time": 17430.39, "timestamp": "04:50:30", "text": "あなたにそんな風に感じさせたくありませんし、"}, {"type": "subtitle", "time": 17436.788, "timestamp": "04:50:36", "text": "「いや、そんなに罪悪感を感じるなら、"}, {"type": "subtitle", "time": 17438.55, "timestamp": "04:50:38", "text": "それで支払ってくれてもいいよ。つまり、それは"}, {"type": "subtitle", "time": 17443.19, "timestamp": "04:50:43", "text": "大したことじゃない。もしあなたが気に入ったら、もしあなたが言うなら"}, {"type": "subtitle", "time": 17445.51, "timestamp": "04:50:45", "text": "「ねえ、ヴィック、君の絵を描きたいんだけど」"}, {"type": "subtitle", "time": 17448.868, "timestamp": "04:50:48", "text": "何かあれば、喜んでやります。"}, {"type": "subtitle", "time": 17451.35, "timestamp": "04:50:51", "text": "でも、何だと思いますか？もし私がただ掴むのが好きなら"}, {"type": "subtitle", "time": 17453.19, "timestamp": "04:50:53", "text": "あなたの絵を無料で使わせてもらうのは、申し訳ない気持ちになります。"}, {"type": "subtitle", "time": 17455.11, "timestamp": "04:50:55", "text": "代わりに、私はあなたに支払います。」"}, {"type": "subtitle", "time": 17457.91, "timestamp": "04:50:57", "text": "もう罪悪感はない。えっと、私は支払いました"}, {"type": "subtitle", "time": 17459.47, "timestamp": "04:50:59", "text": "彼。私は彼に報酬を支払った。"}]
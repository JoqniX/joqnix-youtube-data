[{"type": "subtitle", "time": 13200.309, "timestamp": "03:40:00", "text": "昨晩、弦が切れてしまった。"}, {"type": "subtitle", "time": 13203.429, "timestamp": "03:40:03", "text": "何が起こっていますか？くそ。"}, {"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "くそ。くそ。私の鍵がなぜ"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "働く？"}, {"type": "subtitle", "time": 13208.71, "timestamp": "03:40:08", "text": "よし、どういうわけか私のキーボードが"}, {"type": "subtitle", "time": 13209.99, "timestamp": "03:40:09", "text": "動作しなくなりました。私はキーバインドを持っています"}, {"type": "subtitle", "time": 13220.389, "timestamp": "03:40:20", "text": "大丈夫です。大丈夫です。参加する。わかった。おい、"}, {"type": "subtitle", "time": 13224.79, "timestamp": "03:40:24", "text": "招待状を送ってください。招待状を送ります。わかった。"}, {"type": "subtitle", "time": 13227.269, "timestamp": "03:40:27", "text": "こんにちは。起きます。水筒に水を補充して"}, {"type": "subtitle", "time": 13235.83, "timestamp": "03:40:35", "text": "わかった。街へ行こう、だって私は決して好きじゃないから"}, {"type": "subtitle", "time": 13243.51, "timestamp": "03:40:43", "text": "地獄へ行け。おお。私はまだ"}, {"type": "subtitle", "time": 13248.15, "timestamp": "03:40:48", "text": "赤毛のモリー。ありがとう。ありがとう。"}, {"type": "subtitle", "time": 13249.99, "timestamp": "03:40:49", "text": "これは、これをやった最初のゲームです"}, {"type": "subtitle", "time": 13252.51, "timestamp": "03:40:52", "text": "自分。私は"}, {"type": "subtitle", "time": 13254.91, "timestamp": "03:40:54", "text": "ハッピー。あなたは"}, {"type": "subtitle", "time": 13257.429, "timestamp": "03:40:57", "text": "ケア。バイバイ。お立ち寄りいただきありがとうございます"}]
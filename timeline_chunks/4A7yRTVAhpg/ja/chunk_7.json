[{"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "私たちは皆、同じ立場にいるのでしょうか？私たちは"}, {"type": "subtitle", "time": 425.11, "timestamp": "00:07:05", "text": "は。"}, {"type": "subtitle", "time": 436.51, "timestamp": "00:07:16", "text": "こんにちは。持っている"}, {"type": "subtitle", "time": 441.029, "timestamp": "00:07:21", "text": "桃。こんにちは、ピーチ。こんにちは、ロレスさん。古い"}, {"type": "subtitle", "time": 445.83, "timestamp": "00:07:25", "text": "男。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 448.41, "timestamp": "00:07:28", "text": "チャックニックと遊んでいます"}, {"type": "subtitle", "time": 451.07, "timestamp": "00:07:31", "text": "[音楽]"}, {"type": "subtitle", "time": 453.99, "timestamp": "00:07:33", "text": "今日。音楽が鳴っていない。おお、"}, {"type": "subtitle", "time": 464.629, "timestamp": "00:07:44", "text": "始める。ご招待します。思うに"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "桃。私はこのゲームをプレイしたことがありません。"}, {"type": "subtitle", "time": 479.35, "timestamp": "00:07:59", "text": "それが君との初めての経験になるだろう。"}]
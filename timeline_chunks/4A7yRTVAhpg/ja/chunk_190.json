[{"type": "subtitle", "time": 11400.55, "timestamp": "03:10:00", "text": "あ、待って。なぜ？待って、なぜ彼らは行くの？"}, {"type": "subtitle", "time": 11403.11, "timestamp": "03:10:03", "text": "家の中ですか？何？さあ、行こう"}, {"type": "subtitle", "time": 11406.07, "timestamp": "03:10:06", "text": "家の中。近日公開。"}, {"type": "subtitle", "time": 11409.11, "timestamp": "03:10:09", "text": "はぁ？服用する必要がありますか？"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "小麦を何かに使う？はい。私はしません"}, {"type": "subtitle", "time": 11414.23, "timestamp": "03:10:14", "text": "知る。今のところは。"}, {"type": "subtitle", "time": 11417.269, "timestamp": "03:10:17", "text": "私たちは耐えられる。うん。もしあなたがそれを持っているなら"}, {"type": "subtitle", "time": 11418.63, "timestamp": "03:10:18", "text": "あなたの手。うん。来て。来て。ああ、"}, {"type": "subtitle", "time": 11421.269, "timestamp": "03:10:21", "text": "神。費用を見てください。ひどい有様だ。おお"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "それはやってくる。"}, {"type": "subtitle", "time": 11433.51, "timestamp": "03:10:33", "text": "なぜ？なぜ？なぜ不気味な音がするのですか"}, {"type": "subtitle", "time": 11437.03, "timestamp": "03:10:37", "text": "来る？うん。ここに来て。ここに来て。おお、"}, {"type": "subtitle", "time": 11438.469, "timestamp": "03:10:38", "text": "ジョー、ピザ食べたい？来る"}, {"type": "subtitle", "time": 11441.83, "timestamp": "03:10:41", "text": "ここ。ああ、ピザ。ピザ。ピザの時間だ。おい、"}, {"type": "subtitle", "time": 11443.75, "timestamp": "03:10:43", "text": "見て。ああ、食べてもいいですよ。これは"}, {"type": "subtitle", "time": 11446.389, "timestamp": "03:10:46", "text": "素晴らしい。ピザはそんなに悪くないよ。できない"}, {"type": "subtitle", "time": 11448.95, "timestamp": "03:10:48", "text": "待って。美味しそうですね。"}, {"type": "subtitle", "time": 11454.63, "timestamp": "03:10:54", "text": "うん。非常にリアルなピザ。うん。"}, {"type": "subtitle", "time": 11456.63, "timestamp": "03:10:56", "text": "ティーカップもいくつかあります。私たちは手に入れることができます"}, {"type": "subtitle", "time": 11458.79, "timestamp": "03:10:58", "text": "お茶を淹れています。それはアルコールだと思います"}]
[{"type": "subtitle", "time": 3962.589, "timestamp": "01:06:02", "text": "待って、待って、待って。予約を受け付けます"}, {"type": "subtitle", "time": 3965.75, "timestamp": "01:06:05", "text": "机。なぜ4人掛けのテーブルしかないのですか？"}, {"type": "subtitle", "time": 3969.43, "timestamp": "01:06:09", "text": "それは全く意味が分からない。"}, {"type": "subtitle", "time": 3973.67, "timestamp": "01:06:13", "text": "あ、最後だ。"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "二。 4つならできます。"}, {"type": "subtitle", "time": 3993.63, "timestamp": "01:06:33", "text": "考える。うん。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "はい。はい。はい。はい。はい。はい、そう思います。"}, {"type": "subtitle", "time": 4002.589, "timestamp": "01:06:42", "text": "うん。それからシンクを設置しようと思います"}, {"type": "subtitle", "time": 4005.47, "timestamp": "01:06:45", "text": "ここからアクセスできます"}, {"type": "subtitle", "time": 4009.19, "timestamp": "01:06:49", "text": "あまりにも。その後"}, {"type": "subtitle", "time": 4011.71, "timestamp": "01:06:51", "text": "えーと、ゴミ箱"}, {"type": "subtitle", "time": 4014.589, "timestamp": "01:06:54", "text": "ここ。探しています"}, {"type": "subtitle", "time": 4019.029, "timestamp": "01:06:59", "text": "これです。いいえ、こちらです。私たちは"}]
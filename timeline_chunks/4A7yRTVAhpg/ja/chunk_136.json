[{"type": "subtitle", "time": 8161.75, "timestamp": "02:16:01", "text": "肉とかそういうもの。しかし、私たちはまた"}, {"type": "subtitle", "time": 8186.709, "timestamp": "02:16:26", "text": "動く。もう片方だけ取らせてください"}, {"type": "subtitle", "time": 8188.069, "timestamp": "02:16:28", "text": "外。もう片方も外してみますね。"}, {"type": "subtitle", "time": 8190.87, "timestamp": "02:16:30", "text": "じゃあ、それを外しましょう。なんてこった。おお"}, {"type": "subtitle", "time": 8196.509, "timestamp": "02:16:36", "text": "[音楽]"}, {"type": "subtitle", "time": 8198.85, "timestamp": "02:16:38", "text": "くそっ。私たちはこれを埋めていると思います"}, {"type": "subtitle", "time": 8206.709, "timestamp": "02:16:46", "text": "夜。餃子を作るのは難しすぎる。何"}, {"type": "subtitle", "time": 8208.429, "timestamp": "02:16:48", "text": "の"}, {"type": "subtitle", "time": 8213.049, "timestamp": "02:16:53", "text": "変人？餃子を作るのがなぜこんなに難しいのか？"}]
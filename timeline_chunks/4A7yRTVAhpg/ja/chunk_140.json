[{"type": "subtitle", "time": 8400.27, "timestamp": "02:20:00", "text": "[音楽]"}, {"type": "subtitle", "time": 8427.15, "timestamp": "02:20:27", "text": "では、あなたの好きな食べ物は何ですか？"}, {"type": "subtitle", "time": 8431.12, "timestamp": "02:20:31", "text": "ミーシャへ？お気に入り"}, {"type": "subtitle", "time": 8434.19, "timestamp": "02:20:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8444.309, "timestamp": "02:20:44", "text": "こんにちは、ボッシャー・ボッシュ。ザ・シムズ4は"}, {"type": "subtitle", "time": 8445.75, "timestamp": "02:20:45", "text": "少し見た目が違う。私はそうではない"}, {"type": "subtitle", "time": 8448.07, "timestamp": "02:20:48", "text": "シムズ4をプレイ中。フォローありがとうございます。"}, {"type": "subtitle", "time": 8451.03, "timestamp": "02:20:51", "text": "けれど。ようこそ。"}, {"type": "subtitle", "time": 8453.67, "timestamp": "02:20:53", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 8457.71, "timestamp": "02:20:57", "text": "混沌がPAをプレイする"}]
[{"type": "subtitle", "time": 17821.03, "timestamp": "04:57:01", "text": "特定のジャンルは分かりませんが。"}, {"type": "subtitle", "time": 17824.55, "timestamp": "04:57:04", "text": "うん、それについては何とかするよ。大丈夫です。"}, {"type": "subtitle", "time": 17827.19, "timestamp": "04:57:07", "text": "多分、自分で解決できると思う"}, {"type": "subtitle", "time": 17829.51, "timestamp": "04:57:09", "text": "私が研究やタイトルをしている間に"}, {"type": "subtitle", "time": 17836.39, "timestamp": "04:57:16", "text": "つまり、これはバトルソーシャルゲームですよね？もし私が"}, {"type": "subtitle", "time": 17838.23, "timestamp": "04:57:18", "text": "覚えてる？私はこう言ったんだ、「ジャックさん、"}, {"type": "subtitle", "time": 17842.39, "timestamp": "04:57:22", "text": "まだ配信終わってないの？いいえ。ああ、私たちは"}, {"type": "subtitle", "time": 17845.11, "timestamp": "04:57:25", "text": "ただ話しているだけです。"}, {"type": "subtitle", "time": 17847.11, "timestamp": "04:57:27", "text": "ええ、話していましたよ。大丈夫です。その"}, {"type": "subtitle", "time": 17849.35, "timestamp": "04:57:29", "text": "大丈夫。ついさっき彼を倒したところです。私"}, {"type": "subtitle", "time": 17851.59, "timestamp": "04:57:31", "text": "まあ、みんな終わったって感じだった。あなた"}, {"type": "subtitle", "time": 17855.51, "timestamp": "04:57:35", "text": "今は自由に話せる。何てことだ。待って。おお"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "我が神よ。ズキが配信を始める"}, {"type": "subtitle", "time": 17859.83, "timestamp": "04:57:39", "text": "今。"}, {"type": "subtitle", "time": 17868.55, "timestamp": "04:57:48", "text": "午前2時。イエス・キリスト。ええ、彼女は"}, {"type": "subtitle", "time": 17873.27, "timestamp": "04:57:53", "text": "その時のように、その状況に適応する"}, {"type": "subtitle", "time": 17876.23, "timestamp": "04:57:56", "text": "ゾーン。ああ、彼女はすごい奴だ。彼女は"}]
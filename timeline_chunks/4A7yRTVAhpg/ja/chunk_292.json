[{"type": "subtitle", "time": 17523.39, "timestamp": "04:52:03", "text": "ソーシャルのようなものですが、私は"}, {"type": "subtitle", "time": 17525.788, "timestamp": "04:52:05", "text": "たぶん、そうだったと思う。"}, {"type": "subtitle", "time": 17529.03, "timestamp": "04:52:09", "text": "そんなことを実験している。うん、君は"}, {"type": "subtitle", "time": 17532.31, "timestamp": "04:52:12", "text": "すでに自分の力を分散させているのに、"}, {"type": "subtitle", "time": 17535.67, "timestamp": "04:52:15", "text": "「自分自身を広める」とはどういう意味ですか？"}, {"type": "subtitle", "time": 17538.788, "timestamp": "04:52:18", "text": "ええ、それはまるでたくさんのことを同時にこなしているようなものです。"}, {"type": "subtitle", "time": 17541.27, "timestamp": "04:52:21", "text": "わかった。 2つ行う代わりに"}, {"type": "subtitle", "time": 17543.51, "timestamp": "04:52:23", "text": "5～6～8個のもの"}, {"type": "subtitle", "time": 17547.83, "timestamp": "04:52:27", "text": "10個の事柄。それは良くない。"}, {"type": "subtitle", "time": 17549.99, "timestamp": "04:52:29", "text": "これを想像してみてください。あなたは料理をしています"}, {"type": "subtitle", "time": 17553.35, "timestamp": "04:52:33", "text": "あなたの場所で、あなたはたぶんできると思う"}, {"type": "subtitle", "time": 17557.27, "timestamp": "04:52:37", "text": "ロティを作って見てみると"}, {"type": "subtitle", "time": 17560.628, "timestamp": "04:52:40", "text": "牛乳。しかし、2つだけ行うのではなく、"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "あなたはロティを作っているように、"}, {"type": "subtitle", "time": 17564.39, "timestamp": "04:52:44", "text": "あなたは牛乳を見ていて、"}, {"type": "subtitle", "time": 17567.59, "timestamp": "04:52:47", "text": "カレーも作っています。何かが傾向にあるかもしれない"}, {"type": "subtitle", "time": 17569.67, "timestamp": "04:52:49", "text": "うまくいかない。牛乳をこぼしてしまうかもしれませんよ。"}, {"type": "subtitle", "time": 17571.83, "timestamp": "04:52:51", "text": "ロティを焦がしてしまうかもしれないし、"}, {"type": "chat", "time": 17572.439, "timestamp": "04:52:52", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqnix"}, {"type": "subtitle", "time": 17576.07, "timestamp": "04:52:56", "text": "例えば、その過程でカレーを焦がしてしまうようなものだ。ああ、"}, {"type": "subtitle", "time": 17579.83, "timestamp": "04:52:59", "text": "だから、それを広めるのは"}]
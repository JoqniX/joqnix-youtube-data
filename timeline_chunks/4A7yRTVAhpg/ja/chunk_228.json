[{"type": "subtitle", "time": 13683.75, "timestamp": "03:48:03", "text": "彼女が鍵を手に入れるための引き金。"}, {"type": "subtitle", "time": 13685.75, "timestamp": "03:48:05", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 13688.87, "timestamp": "03:48:08", "text": "わかったよ、ジョン。来て。私たちと一緒に来てください。わかった、"}, {"type": "subtitle", "time": 13691.269, "timestamp": "03:48:11", "text": "かなりうまくいったよ。さあ行こう。来て、"}, {"type": "subtitle", "time": 13693.67, "timestamp": "03:48:13", "text": "ジャンプ。先頭に立たなければならない。"}, {"type": "subtitle", "time": 13699.269, "timestamp": "03:48:19", "text": "来て。あなたはできません。そうではない。"}, {"type": "subtitle", "time": 13702.309, "timestamp": "03:48:22", "text": "信じてください、私はそれを何度も試しました。"}, {"type": "subtitle", "time": 13704.389, "timestamp": "03:48:24", "text": "何てことだ。そう、そのまま続けて"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "フォワード。ああ、君の走り方を見てごらん。ああ、あなたは"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "彼女に会えるのが楽しみだ。"}, {"type": "subtitle", "time": 13712.269, "timestamp": "03:48:32", "text": "彼を見て。彼を見て。それは"}, {"type": "subtitle", "time": 13714.55, "timestamp": "03:48:34", "text": "litは完了しました。自分の体型を感じる"}, {"type": "subtitle", "time": 13716.55, "timestamp": "03:48:36", "text": "変化する。私は激しい痛みを感じた。これは"}, {"type": "subtitle", "time": 13718.07, "timestamp": "03:48:38", "text": "私がいるべき場所に。私はそうしました"}, {"type": "subtitle", "time": 13719.51, "timestamp": "03:48:39", "text": "すべて順調です。私は持っていたはずだった"}, {"type": "subtitle", "time": 13721.67, "timestamp": "03:48:41", "text": "コントロール。彼の音が聞こえる"}, {"type": "subtitle", "time": 13723.91, "timestamp": "03:48:43", "text": "心の中で笑みがこぼれる。ゆっくりと、そして空虚に。それ"}, {"type": "subtitle", "time": 13726.15, "timestamp": "03:48:46", "text": "決して止まらない。それはほとんど"}, {"type": "subtitle", "time": 13729.67, "timestamp": "03:48:49", "text": "まるで動くこだまのように届く。ああ、彼女は"}, {"type": "subtitle", "time": 13732.309, "timestamp": "03:48:52", "text": "まさに今、それを経験しているところだよ。経験しているところです。"}, {"type": "subtitle", "time": 13734.15, "timestamp": "03:48:54", "text": "パンプキン。"}, {"type": "subtitle", "time": 13736.229, "timestamp": "03:48:56", "text": "こんにちは。ここに来て。行く。そこに入って"}, {"type": "subtitle", "time": 13738.55, "timestamp": "03:48:58", "text": "場所。"}]
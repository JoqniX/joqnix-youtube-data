[{"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "アイテム？待って、あなたにも表示されますか？"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "それとも、私と私の側だけの問題でしょうか？いいえ、"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "あなただけです。"}, {"type": "subtitle", "time": 2957.24, "timestamp": "00:49:17", "text": "私はあなたの味方だと思います。"}, {"type": "subtitle", "time": 2964.39, "timestamp": "00:49:24", "text": "あ、待って。あなたに責任を負わせることはできません。ない"}, {"type": "subtitle", "time": 2967.109, "timestamp": "00:49:27", "text": "そこには。"}, {"type": "subtitle", "time": 2970.589, "timestamp": "00:49:30", "text": "アイテムを表示します。つまり、私は"}, {"type": "subtitle", "time": 2971.7, "timestamp": "00:49:31", "text": "のように"}, {"type": "subtitle", "time": 2972.829, "timestamp": "00:49:32", "text": "[音楽]"}, {"type": "subtitle", "time": 2977.069, "timestamp": "00:49:37", "text": "ああ、私ならできる。"}, {"type": "subtitle", "time": 2980.47, "timestamp": "00:49:40", "text": "あなた専用のカスタムマイクをお持ちですね。ああ、"}, {"type": "subtitle", "time": 2982.8, "timestamp": "00:49:42", "text": "神よ、だから"}, {"type": "subtitle", "time": 2984.91, "timestamp": "00:49:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2986.75, "timestamp": "00:49:46", "text": "かわいい。"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "ああ、わかった。"}]
[{"type": "subtitle", "time": 1860.87, "timestamp": "00:31:00", "text": "毎日ゴミを片付けることができます。"}, {"type": "subtitle", "time": 1863.909, "timestamp": "00:31:03", "text": "これ以上作らないのが一番だ。"}, {"type": "subtitle", "time": 1867.029, "timestamp": "00:31:07", "text": "ごみ。もしそれがもっとゴミなら、それはつまり"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "引き抜くのがより困難になる。どこに置くか"}, {"type": "subtitle", "time": 1880.95, "timestamp": "00:31:20", "text": "ああ、食洗機は本当に嫌いだ。 1つ"}, {"type": "subtitle", "time": 1883.99, "timestamp": "00:31:23", "text": "ステッカー。やったー。"}, {"type": "subtitle", "time": 1886.39, "timestamp": "00:31:26", "text": "さあ行こう。"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "[音楽]"}, {"type": "subtitle", "time": 1890.23, "timestamp": "00:31:30", "text": "もっとお金。"}, {"type": "subtitle", "time": 1896.07, "timestamp": "00:31:36", "text": "顧客の注文は非表示になっています"}, {"type": "subtitle", "time": 1898.35, "timestamp": "00:31:38", "text": "そうでない場合"}, {"type": "subtitle", "time": 1901.99, "timestamp": "00:31:41", "text": "近く。スティックのトッピングとしてマッシュルームを加える。私"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "ああ、そうだね。私たちは調理器を手に入れました。私たちは"}]
[{"type": "subtitle", "time": 14460.71, "timestamp": "04:01:00", "text": "もし皆さんがそうしたいなら、それはそれで構いません。私"}, {"type": "subtitle", "time": 14462.309, "timestamp": "04:01:02", "text": "私のも終わらせることができる。私はそこにいます"}, {"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "何かあれば、皆さんの配信を見ています。"}, {"type": "subtitle", "time": 14466.469, "timestamp": "04:01:06", "text": "わかった。ジャックさん、何をしたいですか？"}, {"type": "subtitle", "time": 14470.91, "timestamp": "04:01:10", "text": "遊ぶ？ディワヴァと遊びたいですか？"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "ディワが好きですか？いや、プレイしたくない"}, {"type": "subtitle", "time": 14477.189, "timestamp": "04:01:17", "text": "ディワ"}, {"type": "subtitle", "time": 14479.03, "timestamp": "04:01:19", "text": "文字通りたった一人"}, {"type": "subtitle", "time": 14482.07, "timestamp": "04:01:22", "text": "ゲームをプレイする者は、その渦中にいる。"}, {"type": "subtitle", "time": 14484.63, "timestamp": "04:01:24", "text": "だから、彼女がいなければ、私たち二人は"}, {"type": "subtitle", "time": 14487.269, "timestamp": "04:01:27", "text": "たぶんただ撮るだけ"}, {"type": "subtitle", "time": 14490.63, "timestamp": "04:01:30", "text": "ヒット。ストレートパンチを食らう"}, {"type": "subtitle", "time": 14492.03, "timestamp": "04:01:32", "text": "歯。はい。"}, {"type": "subtitle", "time": 14493.269, "timestamp": "04:01:33", "text": "[音楽]"}, {"type": "subtitle", "time": 14496.79, "timestamp": "04:01:36", "text": "わかった。あのね？"}, {"type": "subtitle", "time": 14499.189, "timestamp": "04:01:39", "text": "2Dって何？"}, {"type": "subtitle", "time": 14502.429, "timestamp": "04:01:42", "text": "わからない。私は原神をアップデートしていません。"}, {"type": "subtitle", "time": 14505.269, "timestamp": "04:01:45", "text": "こんにちは。あなたはどうですか？これはFPSではありません"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "けれど。えっと、どのゲームですか？何？原神。"}, {"type": "subtitle", "time": 14510.63, "timestamp": "04:01:50", "text": "原神。えーっと、さっきも言ったように、君たち"}, {"type": "subtitle", "time": 14513.51, "timestamp": "04:01:53", "text": "私はヨーロッパサーバーに接続しているので、配信しています。それで、"}, {"type": "subtitle", "time": 14517.03, "timestamp": "04:01:57", "text": "ええ、でもこの仕事は"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "質問。私はヨーロッパを持っています。私は決して"}]
[{"type": "subtitle", "time": 18504.23, "timestamp": "05:08:24", "text": "久しぶりですね。元気でしたか？"}, {"type": "subtitle", "time": 18513.75, "timestamp": "05:08:33", "text": "こんにちは。それは良かったです。"}, {"type": "subtitle", "time": 18515.91, "timestamp": "05:08:35", "text": "ああ、もう終わりだ。私は自分のPCを評価しています"}, {"type": "subtitle", "time": 18518.55, "timestamp": "05:08:38", "text": "今。私は自分のしたいことは何でもできる。うん。"}, {"type": "subtitle", "time": 18521.67, "timestamp": "05:08:41", "text": "さあ行こう。待って、どのCPUを手に入れたの？"}, {"type": "subtitle", "time": 18525.83, "timestamp": "05:08:45", "text": "えっと、5600ですよね？えっと、どっちだったっけ？"}, {"type": "subtitle", "time": 18537.75, "timestamp": "05:08:57", "text": "56は良い数字だ。私は38とレックスを持っています。私は"}, {"type": "subtitle", "time": 18539.83, "timestamp": "05:08:59", "text": "第3世代で。あなたは5日目です"}]
[{"type": "subtitle", "time": 18602.628, "timestamp": "05:10:02", "text": "今週中に時間があれば、ぜひお願いします。だからもし"}, {"type": "subtitle", "time": 18605.23, "timestamp": "05:10:05", "text": "私は正しいです。"}, {"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "月曜日はあれだ、月曜日は金曜日だ、"}, {"type": "subtitle", "time": 18611.11, "timestamp": "05:10:11", "text": "右？待って、まだここにいるの？"}, {"type": "subtitle", "time": 18616.43, "timestamp": "05:10:16", "text": "待って。えっと、そうだったっけ？うん。月曜日。"}, {"type": "subtitle", "time": 18619.27, "timestamp": "05:10:19", "text": "明日。わかった。今日は土曜日です"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "土曜日。うん。明日。うん。月曜日、"}, {"type": "subtitle", "time": 18626.07, "timestamp": "05:10:26", "text": "ええと、水曜日と金曜日だったと思います。"}, {"type": "subtitle", "time": 18628.83, "timestamp": "05:10:28", "text": "うん。うん。だから火曜日にやろう、"}, {"type": "subtitle", "time": 18631.35, "timestamp": "05:10:31", "text": "木曜日、日曜日、または金曜日、土曜日。"}, {"type": "subtitle", "time": 18635.11, "timestamp": "05:10:35", "text": "うん。では、明日以降ですね。"}, {"type": "subtitle", "time": 18638.948, "timestamp": "05:10:38", "text": "はい、可能です。うん、いいんじゃない？"}, {"type": "subtitle", "time": 18640.83, "timestamp": "05:10:40", "text": "それなら、なぜダメなの？"}, {"type": "subtitle", "time": 18644.23, "timestamp": "05:10:44", "text": "[音楽]"}, {"type": "subtitle", "time": 18646.59, "timestamp": "05:10:46", "text": "いつになるかはわかりません"}, {"type": "subtitle", "time": 18653.75, "timestamp": "05:10:53", "text": "[音楽]"}, {"type": "subtitle", "time": 18655.75, "timestamp": "05:10:55", "text": "何てことだ。"}, {"type": "subtitle", "time": 18658.868, "timestamp": "05:10:58", "text": "ああ、ベックはそうだ。こんにちは、ベック。こんにちは。"}]
[{"type": "subtitle", "time": 11521.19, "timestamp": "03:12:01", "text": "上がるはず？はい。上へ上がってください、ミスター・アワー"}, {"type": "subtitle", "time": 11523.91, "timestamp": "03:12:03", "text": "目標はアンナを救うことだ。"}, {"type": "subtitle", "time": 11527.19, "timestamp": "03:12:07", "text": "はい。私たちの目標はアンナを救うことです。固着する"}, {"type": "subtitle", "time": 11529.75, "timestamp": "03:12:09", "text": "神話的。神話級の彼を前に立たせる。"}, {"type": "subtitle", "time": 11533.75, "timestamp": "03:12:13", "text": "続けて。プレーオフだよね？うん。うん。行く"}, {"type": "subtitle", "time": 11535.99, "timestamp": "03:12:15", "text": "その場所を通って。待って、赤い"}, {"type": "subtitle", "time": 11539.11, "timestamp": "03:12:19", "text": "あれ。あそこに赤いものがあります。"}, {"type": "subtitle", "time": 11541.19, "timestamp": "03:12:21", "text": "前進せよ。大丈夫です。大丈夫です。うん、"}, {"type": "subtitle", "time": 11543.11, "timestamp": "03:12:23", "text": "我々は持っています。ええ、私たちはあなたの味方です。いいえ、"}, {"type": "subtitle", "time": 11547.03, "timestamp": "03:12:27", "text": "いや、いや。聞こえましたか？"}, {"type": "subtitle", "time": 11549.75, "timestamp": "03:12:29", "text": "今、聞こえましたか？"}, {"type": "subtitle", "time": 11551.429, "timestamp": "03:12:31", "text": "気味の悪い男がいる。不気味な"}, {"type": "subtitle", "time": 11553.19, "timestamp": "03:12:33", "text": "男が歩いている。"}, {"type": "subtitle", "time": 11554.95, "timestamp": "03:12:34", "text": "いや、いや。彼は何もするつもりはない"}, {"type": "subtitle", "time": 11557.91, "timestamp": "03:12:37", "text": "あなた。行く。さあ、行こう。大丈夫です。"}, {"type": "subtitle", "time": 11570.95, "timestamp": "03:12:50", "text": "Mさん、何ですか？何も起こっていない。来る"}, {"type": "subtitle", "time": 11577.11, "timestamp": "03:12:57", "text": "大丈夫。"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "ああ、衛生兵さん。来て。あなたはそうすべきだった"}]
[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "ええ、もちろんです。ちょっと待ってください。私はまだ"}, {"type": "subtitle", "time": 11943.429, "timestamp": "03:19:03", "text": "まるで、"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "相部屋みたいな感じ。ああ、それは"}, {"type": "subtitle", "time": 11948.87, "timestamp": "03:19:08", "text": "1階にあります。初め"}, {"type": "subtitle", "time": 11951.269, "timestamp": "03:19:11", "text": "床とは、"}, {"type": "subtitle", "time": 11953.349, "timestamp": "03:19:13", "text": "1階にいるなら、"}, {"type": "subtitle", "time": 11956.79, "timestamp": "03:19:16", "text": "階段を上ってください。"}, {"type": "subtitle", "time": 11959.67, "timestamp": "03:19:19", "text": "ランドマークのようなもの、ほら、"}, {"type": "subtitle", "time": 11961.03, "timestamp": "03:19:21", "text": "何？私はただ、"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "召喚陣にガソリンを撒く。これ"}, {"type": "subtitle", "time": 11967.429, "timestamp": "03:19:27", "text": "1つ。このドア。どちらのドアでも"}, {"type": "subtitle", "time": 11969.269, "timestamp": "03:19:29", "text": "開ける。"}, {"type": "subtitle", "time": 11971.429, "timestamp": "03:19:31", "text": "ああ、ドアが2つ開いていない。それは"}, {"type": "subtitle", "time": 11975.71, "timestamp": "03:19:35", "text": "朝食が鍵。そして、私たちは"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "共用バスルームが必要です。わからない"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "私は一般的にどこにあるのか忘れました"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "どの部屋も恐らくそうでしょう。うん。"}, {"type": "subtitle", "time": 11993.11, "timestamp": "03:19:53", "text": "外側の部屋は施錠されていません"}, {"type": "subtitle", "time": 11995.11, "timestamp": "03:19:55", "text": "あなたが行く場所は"}, {"type": "subtitle", "time": 11998.15, "timestamp": "03:19:58", "text": "召喚系のやつだよね？ああ、その"}]
[{"type": "chat", "time": 60.002, "timestamp": "00:01:00", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/12az7rPw"}, {"type": "chat", "time": 61.503, "timestamp": "00:01:01", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Joqi I just woke up"}, {"type": "subtitle", "time": 67.67, "timestamp": "00:01:07", "text": "ダイヤモンド、君たちにとって素晴らしいね。ごめんなさい。あなた"}, {"type": "subtitle", "time": 70.469, "timestamp": "00:01:10", "text": "ただ持っているだけ あなたはただ持っている それはあなたが"}, {"type": "subtitle", "time": 72.469, "timestamp": "00:01:12", "text": "聞いてはいけない。それはあなたがすべきという意味です"}, {"type": "subtitle", "time": 74.789, "timestamp": "00:01:14", "text": "聞かない。脳の棒。心配しないで。"}, {"type": "subtitle", "time": 77.19, "timestamp": "00:01:17", "text": "トイレはとても素晴らしいです。もしあなたがそうしないなら"}, {"type": "subtitle", "time": 79.10900000000001, "timestamp": "00:01:19", "text": "もしそれが理解できないなら、それは"}, {"type": "subtitle", "time": 81.91, "timestamp": "00:01:21", "text": "良いことだ。その通り。基本的には、ロープです。"}, {"type": "subtitle", "time": 84.23, "timestamp": "00:01:24", "text": "今向かっているところです。あなたはただのリビー"}, {"type": "subtitle", "time": 87.149, "timestamp": "00:01:27", "text": "オハイオ州。ごめんなさい。お願いします"}, {"type": "subtitle", "time": 90.63, "timestamp": "00:01:30", "text": "オハイオ州を止めろ。カイラ、私たちは遊んでいません"}, {"type": "subtitle", "time": 92.31, "timestamp": "00:01:32", "text": "ラフト。なぜボートを作っているのですか？何"}, {"type": "subtitle", "time": 94.83, "timestamp": "00:01:34", "text": "なんだって？私"}, {"type": "subtitle", "time": 96.429, "timestamp": "00:01:36", "text": "平均、"}, {"type": "subtitle", "time": 100.31, "timestamp": "00:01:40", "text": "女王陛下、私はロープを持っています。作れますか"}, {"type": "subtitle", "time": 103.19, "timestamp": "00:01:43", "text": "ここですか？"}, {"type": "subtitle", "time": 105.27000000000001, "timestamp": "00:01:45", "text": "私たちは、"}, {"type": "subtitle", "time": 110.87, "timestamp": "00:01:50", "text": "まず家から。もちろん。もちろん。待て、迷子だ。"}, {"type": "subtitle", "time": 114.31, "timestamp": "00:01:54", "text": "わかった。うん。つまり、岩のホームレス"}, {"type": "subtitle", "time": 116.8, "timestamp": "00:01:56", "text": "ファンボーイたち。"}]
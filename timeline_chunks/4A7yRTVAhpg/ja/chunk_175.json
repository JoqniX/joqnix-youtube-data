[{"type": "subtitle", "time": 10502.79, "timestamp": "02:55:02", "text": "なぜ私は自分自身をチェックしないのか"}, {"type": "subtitle", "time": 10506.389, "timestamp": "02:55:06", "text": "だって、確認したんだから。確認しました"}, {"type": "subtitle", "time": 10508.389, "timestamp": "02:55:08", "text": "ええ、あなたの声は聞こえますよ。あなたは"}, {"type": "subtitle", "time": 10510.07, "timestamp": "02:55:10", "text": "本当に聞き取りやすい。それは良い。それは"}, {"type": "subtitle", "time": 10513.67, "timestamp": "02:55:13", "text": "良い。温かい方が私にとって話すのに良いので"}, {"type": "subtitle", "time": 10517.269, "timestamp": "02:55:17", "text": "確認できます。こんにちは。こんにちは。こんにちは。うん。"}, {"type": "subtitle", "time": 10519.429, "timestamp": "02:55:19", "text": "うん。うん。こんにちは。こんにちは。私の名前はChです。"}, {"type": "subtitle", "time": 10521.19, "timestamp": "02:55:21", "text": "ニース。はじめまして。私は怖い"}, {"type": "subtitle", "time": 10525.83, "timestamp": "02:55:25", "text": "ホラー。私を助けてください。助けを送ってください。"}, {"type": "subtitle", "time": 10535.83, "timestamp": "02:55:35", "text": "ああ、そうだね。こんにちは、妹よ。こんにちは。"}, {"type": "subtitle", "time": 10537.83, "timestamp": "02:55:37", "text": "チャットをあまり読めなくなる"}, {"type": "subtitle", "time": 10540.469, "timestamp": "02:55:40", "text": "なぜなら私は集中しなければならないから"}, {"type": "subtitle", "time": 10543.19, "timestamp": "02:55:43", "text": "コラボレーションとゲーム。でも、希望はある"}, {"type": "subtitle", "time": 10545.269, "timestamp": "02:55:45", "text": "皆さん楽しんでください。すべてを見ることができます"}, {"type": "subtitle", "time": 10547.429, "timestamp": "02:55:47", "text": "リンクにあるすべてのストリーム"}, {"type": "subtitle", "time": 10559.83, "timestamp": "02:55:59", "text": "ピナック、まあまあ元気だと思うよ。私はしません"}]
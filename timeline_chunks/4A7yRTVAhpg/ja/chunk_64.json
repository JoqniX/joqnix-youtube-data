[{"type": "subtitle", "time": 3842.789, "timestamp": "01:04:02", "text": "それとも何か別のこと？飲む、飲む"}, {"type": "subtitle", "time": 3845.67, "timestamp": "01:04:05", "text": "かなり抑制されている。あなたの能力はどれくらいですか？"}, {"type": "subtitle", "time": 3850.15, "timestamp": "01:04:10", "text": "いいえ。ええと、中国の旧正月は"}, {"type": "subtitle", "time": 3852.63, "timestamp": "01:04:12", "text": "みんなが"}, {"type": "subtitle", "time": 3855.51, "timestamp": "01:04:15", "text": "酔っぱらう。家族全員"}, {"type": "subtitle", "time": 3857.67, "timestamp": "01:04:17", "text": "そして彼らはこう言うでしょう。「飲みに来なさい。"}, {"type": "subtitle", "time": 3860.589, "timestamp": "01:04:20", "text": "大丈夫だよ。だって、私はつい最近18歳になったばかりだから。"}, {"type": "subtitle", "time": 3863.829, "timestamp": "01:04:23", "text": "年。いいえ、去年の11月です。"}, {"type": "subtitle", "time": 3866.069, "timestamp": "01:04:26", "text": "ということで、今年の旧正月には、"}, {"type": "subtitle", "time": 3868.63, "timestamp": "01:04:28", "text": "彼らは「ああ、飲みに行った方がいいよ」と言う"}, {"type": "subtitle", "time": 3872.15, "timestamp": "01:04:32", "text": "「さあ。」そして彼らは私にカップに注ぎ始めた。"}, {"type": "subtitle", "time": 3874.47, "timestamp": "01:04:34", "text": "一杯、また一杯と飲んだ後、私は言った"}, {"type": "subtitle", "time": 3879.27, "timestamp": "01:04:39", "text": "いいえ。そして私は「ああ、やばい。まあ、"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "ひどい、悲しすぎる。私たちには"}, {"type": "subtitle", "time": 3885.029, "timestamp": "01:04:45", "text": "選択肢です。」それで、私は自分ができることを発見しました"}, {"type": "chat", "time": 3886.287, "timestamp": "01:04:46", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "."}, {"type": "subtitle", "time": 3889.75, "timestamp": "01:04:49", "text": "私はお酒にとても強いんです。ああ、"}, {"type": "subtitle", "time": 3893.19, "timestamp": "01:04:53", "text": "そうですね。ああ、ブラックコーヒー、ピザ、または"}, {"type": "subtitle", "time": 3895.67, "timestamp": "01:04:55", "text": "サラダ。"}, {"type": "subtitle", "time": 3899.029, "timestamp": "01:04:59", "text": "あの、コーヒーでも飲んでみませんか？感じる"}]
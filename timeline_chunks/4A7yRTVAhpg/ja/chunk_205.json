[{"type": "subtitle", "time": 12302.429, "timestamp": "03:25:02", "text": "未使用ですか？私は檻を持っています、"}, {"type": "subtitle", "time": 12305.83, "timestamp": "03:25:05", "text": "地下室、地下室。明るいですか、それとも"}, {"type": "subtitle", "time": 12308.15, "timestamp": "03:25:08", "text": "光っているの？それらのどれかが光っているか、"}, {"type": "subtitle", "time": 12310.87, "timestamp": "03:25:10", "text": "明るい感じ？いいえ、光ってはいません。あなた"}, {"type": "subtitle", "time": 12318.71, "timestamp": "03:25:18", "text": "うん。だから、それらを手に取ってください。"}, {"type": "subtitle", "time": 12321.11, "timestamp": "03:25:21", "text": "近づかないでください。わかった。もうやめます。"}, {"type": "subtitle", "time": 12323.95, "timestamp": "03:25:23", "text": "あなたはそれを拾い上げる。"}, {"type": "subtitle", "time": 12326.229, "timestamp": "03:25:26", "text": "わかった。はい、わかりました。ほら、ほら、ほら。"}, {"type": "subtitle", "time": 12327.67, "timestamp": "03:25:27", "text": "何をするか。わかった、あのね？落とす"}, {"type": "subtitle", "time": 12329.75, "timestamp": "03:25:29", "text": "それ。"}, {"type": "subtitle", "time": 12333.349, "timestamp": "03:25:33", "text": "諦めるよ。わかりました、私は行きます"}, {"type": "subtitle", "time": 12338.71, "timestamp": "03:25:38", "text": "それからゆっくりとヤギに近づくか、"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "見て、それから近くに落とす"}, {"type": "subtitle", "time": 12351.59, "timestamp": "03:25:51", "text": "ああ、わかりました。さあ、ヤギに近づいて、"}, {"type": "subtitle", "time": 12353.75, "timestamp": "03:25:53", "text": "拾い上げてください。"}, {"type": "subtitle", "time": 12355.51, "timestamp": "03:25:55", "text": "これがヤギの捕まえ方だ。しないでください"}, {"type": "subtitle", "time": 12357.429, "timestamp": "03:25:57", "text": "ヤギを今すぐ燃やすように、"}]
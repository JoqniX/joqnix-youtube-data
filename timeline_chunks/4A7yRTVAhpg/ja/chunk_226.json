[{"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "素早い。わかった。ねえ、モー。私たちは壊れた"}, {"type": "subtitle", "time": 13565.87, "timestamp": "03:46:05", "text": "宿屋へ。我々は"}, {"type": "subtitle", "time": 13570.95, "timestamp": "03:46:10", "text": "侵入から侵入へ。"}, {"type": "subtitle", "time": 13576.469, "timestamp": "03:46:16", "text": "いいぞ。いいぞ。準備は全て整いました。"}, {"type": "subtitle", "time": 13579.67, "timestamp": "03:46:19", "text": "最後の祠を設置しました。ママとパパ"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "邪魔しようとしたので、止めなければならなかった"}, {"type": "subtitle", "time": 13583.11, "timestamp": "03:46:23", "text": "彼ら。何があっても邪魔はさせない"}, {"type": "subtitle", "time": 13586.07, "timestamp": "03:46:26", "text": "私とアイゼル。もうすぐ彼が到着する。私"}, {"type": "subtitle", "time": 13588.389, "timestamp": "03:46:28", "text": "彼の存在を感じることができる。他の人は失敗したかもしれないが、"}, {"type": "subtitle", "time": 13589.91, "timestamp": "03:46:29", "text": "しかし今回は儀式を行った"}, {"type": "subtitle", "time": 13592.87, "timestamp": "03:46:32", "text": "古いテストからの翻訳を自分で"}, {"type": "subtitle", "time": 13595.269, "timestamp": "03:46:35", "text": "正確です。それに、私は"}, {"type": "subtitle", "time": 13598.469, "timestamp": "03:46:38", "text": "それを制御する力。おお。私は思う"}, {"type": "subtitle", "time": 13600.309, "timestamp": "03:46:40", "text": "召喚をやめなければならないもの"}, {"type": "subtitle", "time": 13602.07, "timestamp": "03:46:42", "text": "悪魔だよ、男。この友達全員みたいに"}, {"type": "subtitle", "time": 13604.15, "timestamp": "03:46:44", "text": "グループ グループ グループは、"}, {"type": "subtitle", "time": 13607.59, "timestamp": "03:46:47", "text": "全く同じことをして死ぬ。"}, {"type": "subtitle", "time": 13610.71, "timestamp": "03:46:50", "text": "うん、大丈夫だよ。"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "気味が悪い話だ。ある時点で、"}, {"type": "subtitle", "time": 13614.55, "timestamp": "03:46:54", "text": "要は、"}, {"type": "subtitle", "time": 13617.67, "timestamp": "03:46:57", "text": "そんなことが起こって、もう諦めるしかない。"}]
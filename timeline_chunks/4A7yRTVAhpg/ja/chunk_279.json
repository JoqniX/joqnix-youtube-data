[{"type": "subtitle", "time": 16742.629, "timestamp": "04:39:02", "text": "ここで汗をかきたくない、"}, {"type": "subtitle", "time": 16744.23, "timestamp": "04:39:04", "text": "あなたが知っている？待って、デッドバイはどうなの？"}, {"type": "subtitle", "time": 16748.189, "timestamp": "04:39:08", "text": "日光？デッド・バイ・デイライト。私は持っていません"}, {"type": "subtitle", "time": 16751.429, "timestamp": "04:39:11", "text": "それ。あなたはそうしたいのですね。あなたはもっとよく分かっているはずです。"}, {"type": "subtitle", "time": 16755.109, "timestamp": "04:39:15", "text": "でも原神の代わりに、キラキラしたものを"}, {"type": "subtitle", "time": 16757.269, "timestamp": "04:39:17", "text": "のように"}, {"type": "subtitle", "time": 16765.189, "timestamp": "04:39:25", "text": "おお。そうそう。"}, {"type": "subtitle", "time": 16767.39, "timestamp": "04:39:27", "text": "しかし何もない"}, {"type": "subtitle", "time": 16771.189, "timestamp": "04:39:31", "text": "しかし、それもたくさんあった。うん。ただ"}, {"type": "subtitle", "time": 16773.59, "timestamp": "04:39:33", "text": "無差別に人を撃つ。大丈夫です。おお、"}, {"type": "subtitle", "time": 16776.83, "timestamp": "04:39:36", "text": "ごめん。過去の人々。うん、"}, {"type": "subtitle", "time": 16778.47, "timestamp": "04:39:38", "text": "[音楽]"}, {"type": "subtitle", "time": 16781.43, "timestamp": "04:39:41", "text": "私たちはドラゴン神話が好きです。待って、何が"}, {"type": "subtitle", "time": 16784.868, "timestamp": "04:39:44", "text": "心理的な恐怖？ああ、私たちはできる"}, {"type": "subtitle", "time": 16786.708, "timestamp": "04:39:46", "text": "まさにその通りです。さて、何かありますか？"}, {"type": "subtitle", "time": 16789.27, "timestamp": "04:39:49", "text": "おすすめはありますか？つまり、"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "心理ホラー？それは"}, {"type": "subtitle", "time": 16794.07, "timestamp": "04:39:54", "text": "あなたの脳。"}]
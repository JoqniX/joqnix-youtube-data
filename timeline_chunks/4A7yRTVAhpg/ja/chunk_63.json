[{"type": "subtitle", "time": 3782.39, "timestamp": "01:03:02", "text": "コーヒー。これは本当に素晴らしい。私はそれが好きです。私"}, {"type": "subtitle", "time": 3785.75, "timestamp": "01:03:05", "text": "そんな感じ。私はそれがとても好きです。おお、"}, {"type": "subtitle", "time": 3789.51, "timestamp": "01:03:09", "text": "移動が楽になる。正しく行動しなさい。うん。女優"}, {"type": "subtitle", "time": 3791.91, "timestamp": "01:03:11", "text": "立方体。"}, {"type": "subtitle", "time": 3801.27, "timestamp": "01:03:21", "text": "私は何に準備ができているのか？よし。"}, {"type": "subtitle", "time": 3804.63, "timestamp": "01:03:24", "text": "ああ、それはすべて私の勇気とキーバインドのおかげだ。"}, {"type": "subtitle", "time": 3808.789, "timestamp": "01:03:28", "text": "すごく面白い。準備ができて？見る？わかった。ジョック。"}, {"type": "subtitle", "time": 3816.349, "timestamp": "01:03:36", "text": "ジョックは飲酒運転ができる年齢だ。"}, {"type": "subtitle", "time": 3818.99, "timestamp": "01:03:38", "text": "ええ、ただ私は"}, {"type": "subtitle", "time": 3821.99, "timestamp": "01:03:41", "text": "飲む。数口飲んだだけで酔っぱらう"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "ビールとかそういうもの。理由がわからない。ああ、私は"}, {"type": "subtitle", "time": 3827.309, "timestamp": "01:03:47", "text": "私のアルコールはいつも"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "軽量。あなたはどう思うかは分かりません。"}, {"type": "subtitle", "time": 3839.589, "timestamp": "01:03:59", "text": "自分が大酒飲みだとどうやってわかるの？"}]
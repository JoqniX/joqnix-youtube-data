[{"type": "subtitle", "time": 17101.75, "timestamp": "04:45:01", "text": "でも素敵ですね。きっと素晴らしいでしょう。"}, {"type": "subtitle", "time": 17104.11, "timestamp": "04:45:04", "text": "うん。"}, {"type": "subtitle", "time": 17111.35, "timestamp": "04:45:11", "text": "このことについて。ホラー。うん。ホラー。"}, {"type": "subtitle", "time": 17122.23, "timestamp": "04:45:22", "text": "では、待ってください。 1週間は何日ですか？"}, {"type": "subtitle", "time": 17126.07, "timestamp": "04:45:26", "text": "わかった。セブン。明日。"}, {"type": "subtitle", "time": 17127.75, "timestamp": "04:45:27", "text": "日曜日。"}, {"type": "subtitle", "time": 17129.99, "timestamp": "04:45:29", "text": "私はスケジュールを準備しなかったのが良かった。私"}, {"type": "subtitle", "time": 17132.15, "timestamp": "04:45:32", "text": "明日配信したいんだけど、"}, {"type": "subtitle", "time": 17136.31, "timestamp": "04:45:36", "text": "それもしたくない。よし、これで終わりにしよう"}, {"type": "subtitle", "time": 17139.67, "timestamp": "04:45:39", "text": "ストリーム配信中。今は誰も見ていない。"}, {"type": "subtitle", "time": 17142.23, "timestamp": "04:45:42", "text": "よし、皆さんに感謝を伝えたい。"}, {"type": "subtitle", "time": 17145.15, "timestamp": "04:45:45", "text": "それはハッシュ・クロノスと2人です"}, {"type": "subtitle", "time": 17147.27, "timestamp": "04:45:47", "text": "ハトン。お越しいただきありがとうございます。本当に"}, {"type": "subtitle", "time": 17149.35, "timestamp": "04:45:49", "text": "感謝します。君たちは最高だ。"}, {"type": "subtitle", "time": 17152.19, "timestamp": "04:45:52", "text": "そしていつものように、またお会いしましょう"}, {"type": "subtitle", "time": 17155.59, "timestamp": "04:45:55", "text": "来週は男たちだ。ええ、皆さんは"}, {"type": "subtitle", "time": 17158.628, "timestamp": "04:45:58", "text": "何かのほんの少しのチラ見せのようなもの"}]
[{"type": "subtitle", "time": 15488.189, "timestamp": "04:18:08", "text": "何てことだ。バイバイ。"}, {"type": "subtitle", "time": 15491.91, "timestamp": "04:18:11", "text": "わかった。大丈夫。必ず二人とも見つけ出す。"}, {"type": "subtitle", "time": 15494.79, "timestamp": "04:18:14", "text": "ストリームはまさにそうです。でも大丈夫だよ。"}, {"type": "subtitle", "time": 15496.03, "timestamp": "04:18:16", "text": "私はいつも"}, {"type": "subtitle", "time": 15512.79, "timestamp": "04:18:32", "text": "オペレーター？ああ、イエス・キリストよ。"}, {"type": "subtitle", "time": 15514.95, "timestamp": "04:18:34", "text": "フラッシュが見られると思います。あなた"}, {"type": "subtitle", "time": 15516.269, "timestamp": "04:18:36", "text": "フラッシュできる"}, {"type": "subtitle", "time": 15520.55, "timestamp": "04:18:40", "text": "彼ら。私は持っています。"}, {"type": "subtitle", "time": 15522.95, "timestamp": "04:18:42", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 15531.11, "timestamp": "04:18:51", "text": "このゲーム、すごく変な感じがする。それは"}, {"type": "subtitle", "time": 15532.87, "timestamp": "04:18:52", "text": "その間。"}, {"type": "subtitle", "time": 15534.87, "timestamp": "04:18:54", "text": "大丈夫。あなたは"}, {"type": "subtitle", "time": 15537.75, "timestamp": "04:18:57", "text": "あっという間にリズムに乗る。 1秒以内に。"}]
[{"type": "subtitle", "time": 11772.71, "timestamp": "03:16:12", "text": "私は今まで見たことがないようなことをただ知っていた"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "聞こえた？どこ？私はこれを見たことがありません"}, {"type": "subtitle", "time": 11778.55, "timestamp": "03:16:18", "text": "年明け早々といった感じ。ああ、ジョー、"}, {"type": "subtitle", "time": 11780.87, "timestamp": "03:16:20", "text": "ここに来て。あれが悪魔だ。行け、行け。"}, {"type": "subtitle", "time": 11782.389, "timestamp": "03:16:22", "text": "疲れ果てた。"}, {"type": "subtitle", "time": 11785.11, "timestamp": "03:16:25", "text": "来て。私はただ彼を抱きしめるだけ。うん。ああ、私は"}, {"type": "subtitle", "time": 11788.63, "timestamp": "03:16:28", "text": "やけど。そうそう。あれを見てください。 Jの最初の"}, {"type": "subtitle", "time": 11791.59, "timestamp": "03:16:31", "text": "悪魔。イエス。ジョー、本当に誇りに思うよ。"}, {"type": "subtitle", "time": 11796.55, "timestamp": "03:16:36", "text": "よくやった。わーい。ああ、赤ちゃんの初めての獲物だ。"}, {"type": "subtitle", "time": 11800.469, "timestamp": "03:16:40", "text": "赤ちゃんの泣き声が聞こえる。"}, {"type": "subtitle", "time": 11803.75, "timestamp": "03:16:43", "text": "大丈夫です。そこには。大丈夫ですよ。あなたは"}, {"type": "subtitle", "time": 11807.269, "timestamp": "03:16:47", "text": "大丈夫。あなたは素晴らしいです。あなたはやっている"}, {"type": "subtitle", "time": 11809.269, "timestamp": "03:16:49", "text": "素晴らしい。"}, {"type": "subtitle", "time": 11813.11, "timestamp": "03:16:53", "text": "あ、バスルームの鍵を共有しないといけないんです。"}, {"type": "subtitle", "time": 11815.99, "timestamp": "03:16:55", "text": "バスルームの鍵を共有する。うん。ああ、そうじゃなかった"}, {"type": "subtitle", "time": 11818.55, "timestamp": "03:16:58", "text": "それを持っているの？あなたは2階にいますか？はい、そうです"}]
[{"type": "subtitle", "time": 7202.189, "timestamp": "02:00:02", "text": "仕事。私は[ __ ]したと思う"}, {"type": "subtitle", "time": 7213.43, "timestamp": "02:00:13", "text": "なんてこった。"}, {"type": "subtitle", "time": 7215.669, "timestamp": "02:00:15", "text": "あ、待って。"}, {"type": "subtitle", "time": 7219.55, "timestamp": "02:00:19", "text": "私たちの短い"}, {"type": "subtitle", "time": 7222.55, "timestamp": "02:00:22", "text": "小麦粉を一時停止してチョークキャロットを作る"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "そして肉と農場との交流を追加する"}, {"type": "subtitle", "time": 7228.79, "timestamp": "02:00:28", "text": "餃子を作って調理する。"}, {"type": "subtitle", "time": 7231.629, "timestamp": "02:00:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7237.09, "timestamp": "02:00:37", "text": "必要。そして"}, {"type": "subtitle", "time": 7240.189, "timestamp": "02:00:40", "text": "[音楽]"}, {"type": "subtitle", "time": 7244.47, "timestamp": "02:00:44", "text": "では、これはどのように機能するのでしょうか？"}, {"type": "subtitle", "time": 7248.31, "timestamp": "02:00:48", "text": "揚げる必要はありますか？揚げる？"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "いいえ、でもそうあるべきなんです。あ、待って。"}, {"type": "subtitle", "time": 7253.629, "timestamp": "02:00:53", "text": "あのね？させて"}, {"type": "subtitle", "time": 7259.27, "timestamp": "02:00:59", "text": "私たちに、今はただ今日死んでしまおう。"}]
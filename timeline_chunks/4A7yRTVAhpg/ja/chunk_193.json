[{"type": "subtitle", "time": 11586.95, "timestamp": "03:13:06", "text": "来て。ガッチャ。わかった。わかった。私たちが"}, {"type": "subtitle", "time": 11588.95, "timestamp": "03:13:08", "text": "ジョー、もし私たちがただ"}, {"type": "subtitle", "time": 11590.79, "timestamp": "03:13:10", "text": "今すぐ入って、おそらく私たち全員が"}, {"type": "subtitle", "time": 11592.95, "timestamp": "03:13:12", "text": "死ぬ。私たちがこれからすることは"}, {"type": "subtitle", "time": 11595.67, "timestamp": "03:13:15", "text": "鍵を探しています。わかった。そして私たちは行く"}, {"type": "subtitle", "time": 11599.349, "timestamp": "03:13:19", "text": "家全体のロックを解除する。できるだけ多く開く"}, {"type": "subtitle", "time": 11601.99, "timestamp": "03:13:21", "text": "できる限りドアを開ける。"}, {"type": "subtitle", "time": 11605.11, "timestamp": "03:13:25", "text": "わかった。うん。鍵を探して"}, {"type": "subtitle", "time": 11607.91, "timestamp": "03:13:27", "text": "ドアを開ける。どこがダメなの？"}, {"type": "subtitle", "time": 11610.309, "timestamp": "03:13:30", "text": "もう一度行く？"}, {"type": "subtitle", "time": 11613.19, "timestamp": "03:13:33", "text": "ええと、あなたはどこへでも行けますよ。"}, {"type": "subtitle", "time": 11615.59, "timestamp": "03:13:35", "text": "では、狩猟はいつ行われるのでしょうか？"}, {"type": "subtitle", "time": 11618.309, "timestamp": "03:13:38", "text": "彼女は私を殺しに来たのか？えっと、私たちが"}, {"type": "subtitle", "time": 11622.469, "timestamp": "03:13:42", "text": "ヤギを生贄に捧げ始めなさい。わかった。えっと"}, {"type": "subtitle", "time": 11624.95, "timestamp": "03:13:44", "text": "わかった。わかった。医療キットを積み上げよう"}, {"type": "subtitle", "time": 11628.07, "timestamp": "03:13:48", "text": "ホール。"}, {"type": "subtitle", "time": 11630.309, "timestamp": "03:13:50", "text": "よし。可能です。保持しましょう"}, {"type": "subtitle", "time": 11632.71, "timestamp": "03:13:52", "text": "廊下に救急キットがあるので、"}, {"type": "subtitle", "time": 11634.269, "timestamp": "03:13:54", "text": "好かれやすい"}, {"type": "subtitle", "time": 11638.15, "timestamp": "03:13:58", "text": "得る。ああ、ホールはどこですか？これです"}]
[{"type": "subtitle", "time": 10443.349, "timestamp": "02:54:03", "text": "申し訳ありません。わかった。ジャック、君に"}, {"type": "subtitle", "time": 10447.59, "timestamp": "02:54:07", "text": "聞いてください。それはあなたのオーディオのようなものです"}, {"type": "subtitle", "time": 10458.23, "timestamp": "02:54:18", "text": "何？"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "バンドでもある。はい。しかし、しかし、しかし"}, {"type": "subtitle", "time": 10467.67, "timestamp": "02:54:27", "text": "これは私ができる最高の人です"}, {"type": "subtitle", "time": 10470.71, "timestamp": "02:54:30", "text": "聞く。音声は良好ですか？私のは私のです"}, {"type": "subtitle", "time": 10475.349, "timestamp": "02:54:35", "text": "音量が小さすぎるのか、それとも大きすぎるのか？"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "運動部員はジャックの声が聞こえるかって感じ"}, {"type": "subtitle", "time": 10480.87, "timestamp": "02:54:40", "text": "彼は大丈夫なのか、それとも落ち込んでいるのか？彼が落ち込んでいるなら"}, {"type": "subtitle", "time": 10483.309, "timestamp": "02:54:43", "text": "増加したい"}, {"type": "subtitle", "time": 10487.83, "timestamp": "02:54:47", "text": "音量。わかった。待って。これも確認してください。"}, {"type": "subtitle", "time": 10492.19, "timestamp": "02:54:52", "text": "はい、お願いします。調整する、調整する"}, {"type": "subtitle", "time": 10496.87, "timestamp": "02:54:56", "text": "私は調整していたんです。ええと、私は"}, {"type": "subtitle", "time": 10499.67, "timestamp": "02:54:59", "text": "自分で確認したいのですが、なぜ"}]
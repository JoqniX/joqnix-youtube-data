[{"type": "subtitle", "time": 12781.19, "timestamp": "03:33:01", "text": "最後に1つ取っておきます。"}, {"type": "subtitle", "time": 12785.19, "timestamp": "03:33:05", "text": "不気味な悪魔。死ぬ。死ぬ。パリ。死ぬ。くそ"}, {"type": "subtitle", "time": 12788.03, "timestamp": "03:33:08", "text": "あなた。"}, {"type": "subtitle", "time": 12790.95, "timestamp": "03:33:10", "text": "いらっしゃいませ。ついにアップグレードできて嬉しい"}, {"type": "subtitle", "time": 12793.469, "timestamp": "03:33:13", "text": "平和的に。さあ行こう。"}, {"type": "subtitle", "time": 12797.349, "timestamp": "03:33:17", "text": "おめでとうございます。はい、どうぞ。閉会"}, {"type": "subtitle", "time": 12799.349, "timestamp": "03:33:19", "text": "ドア。私は絶対にあそこには行かない。"}, {"type": "subtitle", "time": 12802.229, "timestamp": "03:33:22", "text": "また彼女のところへ行く。"}, {"type": "subtitle", "time": 12804.71, "timestamp": "03:33:24", "text": "彼女は外にいるのか？彼女は二階にいる。彼女は"}, {"type": "subtitle", "time": 12807.83, "timestamp": "03:33:27", "text": "2階へ。 2階へ。"}, {"type": "subtitle", "time": 12809.269, "timestamp": "03:33:29", "text": "もう行かなくちゃ。よし、みんな"}, {"type": "subtitle", "time": 12811.269, "timestamp": "03:33:31", "text": "バーベキューピット。"}, {"type": "subtitle", "time": 12812.87, "timestamp": "03:33:32", "text": "ええ、料理をしますよ。だった"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "料理をするつもりです。いいえ、私は"}, {"type": "subtitle", "time": 12818.15, "timestamp": "03:33:38", "text": "高い。うん、料理人。さあ行こう。わーい。私たちにさせて"}, {"type": "subtitle", "time": 12820.229, "timestamp": "03:33:40", "text": "料理する。"}, {"type": "subtitle", "time": 12823.11, "timestamp": "03:33:43", "text": "いやいや。金を落とすのはどうですか？"}, {"type": "subtitle", "time": 12824.95, "timestamp": "03:33:44", "text": "バーベキューの部分？ Eキーを押すだけです。"}, {"type": "subtitle", "time": 12827.19, "timestamp": "03:33:47", "text": "Eを押してください。Eを押すだけです。E。了解、了解。"}, {"type": "subtitle", "time": 12831.11, "timestamp": "03:33:51", "text": "さあ、何か拾ってきなさい。あらら。ああ、彼女は"}, {"type": "subtitle", "time": 12833.67, "timestamp": "03:33:53", "text": "ここに来るつもりです。あらら。行け！行け！行け。"}, {"type": "subtitle", "time": 12835.03, "timestamp": "03:33:55", "text": "ただ火をつけるだけ。火をつけろ。ライト"}]
[{"type": "subtitle", "time": 11221.349, "timestamp": "03:07:01", "text": "ああ、小麦とか何か食べてもいいですよ。"}, {"type": "subtitle", "time": 11224.07, "timestamp": "03:07:04", "text": "おい。おい。彼は物を拾い集めている"}, {"type": "subtitle", "time": 11227.19, "timestamp": "03:07:07", "text": "すでに。ちょっと旅行に出かけよう"}, {"type": "subtitle", "time": 11230.95, "timestamp": "03:07:10", "text": "方法。ここに来て。ああ、わかりました。よし。 A"}, {"type": "subtitle", "time": 11233.269, "timestamp": "03:07:13", "text": "アンナに会うためにちょっとした旅行"}, {"type": "subtitle", "time": 11236.23, "timestamp": "03:07:16", "text": "ねえ、あのカボチャを見てよ。"}, {"type": "subtitle", "time": 11241.11, "timestamp": "03:07:21", "text": "ああ、今日はハロウィンだ。だから、いいえ。不気味な。"}, {"type": "subtitle", "time": 11249.91, "timestamp": "03:07:29", "text": "えっと、あの犬の鳴き声は何？"}, {"type": "subtitle", "time": 11254.79, "timestamp": "03:07:34", "text": "ただの小さな犬です。なぜ？あなたが知っている、"}, {"type": "subtitle", "time": 11256.389, "timestamp": "03:07:36", "text": "さあ、ジョー。私たちはインドに住んでいます。あなた"}, {"type": "subtitle", "time": 11258.51, "timestamp": "03:07:38", "text": "それに慣れるべきだ。"}, {"type": "subtitle", "time": 11262.23, "timestamp": "03:07:42", "text": "私の家にはダマス犬はいません。"}, {"type": "subtitle", "time": 11263.99, "timestamp": "03:07:43", "text": "ダメージは1つだけ。うん。ああ、こっちへおいで。"}, {"type": "subtitle", "time": 11265.429, "timestamp": "03:07:45", "text": "ここに来て。ここに来て。あ、待って。おお、"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "待って。いいえ。ここは一体何ですか？儀式"}, {"type": "subtitle", "time": 11271.99, "timestamp": "03:07:51", "text": "あれ。うん。あれがバーベキューだ"}, {"type": "subtitle", "time": 11273.19, "timestamp": "03:07:53", "text": "場所。そこが私たちが"}, {"type": "subtitle", "time": 11277.469, "timestamp": "03:07:57", "text": "バーベキュー。あそこにバラが咲いている。"}, {"type": "subtitle", "time": 11279.75, "timestamp": "03:07:59", "text": "うん。ここに来て。 Y. あなたは見たい"}]
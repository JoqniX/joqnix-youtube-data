[{"type": "subtitle", "time": 967.509, "timestamp": "00:16:07", "text": "[音楽]"}, {"type": "subtitle", "time": 973.35, "timestamp": "00:16:13", "text": "あ、ジッパー付きの前開きにしてください。どこ"}, {"type": "subtitle", "time": 979.35, "timestamp": "00:16:19", "text": "そして、ああ、取り出す必要があります"}, {"type": "subtitle", "time": 981.59, "timestamp": "00:16:21", "text": "毎回お皿に盛る。"}, {"type": "subtitle", "time": 983.069, "timestamp": "00:16:23", "text": "ああ、それは"}, {"type": "subtitle", "time": 987.79, "timestamp": "00:16:27", "text": "終わり。お二人ともお元気ですか？私は大丈夫です。調子はどうですか？"}, {"type": "subtitle", "time": 993.03, "timestamp": "00:16:33", "text": "ジョー？ジョック、元気かい？私は"}, {"type": "subtitle", "time": 996.629, "timestamp": "00:16:36", "text": "睡眠不足だけど、ここにいるよ。えっと、それは"}, {"type": "subtitle", "time": 999.03, "timestamp": "00:16:39", "text": "私たち二人。"}, {"type": "subtitle", "time": 1007.44, "timestamp": "00:16:47", "text": "シルヴィ。もう1品作らせてください"}, {"type": "subtitle", "time": 1009.31, "timestamp": "00:16:49", "text": "[音楽]"}]
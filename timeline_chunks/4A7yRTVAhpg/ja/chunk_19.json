[{"type": "subtitle", "time": 1152.15, "timestamp": "00:19:12", "text": "冷たいステーキ。 1回はレア、2回は"}, {"type": "subtitle", "time": 1155.75, "timestamp": "00:19:15", "text": "中程度、よくできた場合は3つ星。おお。"}, {"type": "subtitle", "time": 1158.23, "timestamp": "00:19:18", "text": "なんてこった。ステーキにそういうのが付いているのを忘れてた。"}, {"type": "subtitle", "time": 1159.99, "timestamp": "00:19:19", "text": "いいえ。"}, {"type": "subtitle", "time": 1173.27, "timestamp": "00:19:33", "text": "ああ、場所を変えることはできますよ。うん、"}, {"type": "subtitle", "time": 1176.39, "timestamp": "00:19:36", "text": "それはとても便利ですね。"}, {"type": "subtitle", "time": 1180.19, "timestamp": "00:19:40", "text": "3本の木が役に立つ。その後"}, {"type": "subtitle", "time": 1184.549, "timestamp": "00:19:44", "text": "えっと、シンクを持ってきますね。"}, {"type": "subtitle", "time": 1187.51, "timestamp": "00:19:47", "text": "その方が簡単だ。いずれ分かるでしょう。私は自分の"}, {"type": "subtitle", "time": 1195.11, "timestamp": "00:19:55", "text": "[音楽]"}, {"type": "subtitle", "time": 1196.38, "timestamp": "00:19:56", "text": "えっと"}]
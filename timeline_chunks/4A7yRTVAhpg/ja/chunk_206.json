[{"type": "subtitle", "time": 12365.429, "timestamp": "03:26:05", "text": "ええ、それであなたも夢中になっていますか？彼らは"}, {"type": "subtitle", "time": 12367.67, "timestamp": "03:26:07", "text": "全ての鍵は手元にあります。私たちは"}, {"type": "subtitle", "time": 12370.229, "timestamp": "03:26:10", "text": "すべてのドアのロックを解除しました。"}, {"type": "subtitle", "time": 12373.19, "timestamp": "03:26:13", "text": "だから、ヤギが"}, {"type": "subtitle", "time": 12375.429, "timestamp": "03:26:15", "text": "それを食べる。"}, {"type": "subtitle", "time": 12377.03, "timestamp": "03:26:17", "text": "はい。"}, {"type": "subtitle", "time": 12380.07, "timestamp": "03:26:20", "text": "どうすれば髪の毛を増やせるのでしょうか？ええと、私たちはそれらを見つけます"}, {"type": "subtitle", "time": 12384.79, "timestamp": "03:26:24", "text": "外。うん。リスポーンしますか？はい。それ"}, {"type": "subtitle", "time": 12387.03, "timestamp": "03:26:27", "text": "リスポーンします。ああ、これを受け取ってもらえますか？"}, {"type": "subtitle", "time": 12388.71, "timestamp": "03:26:28", "text": "ガソリン？"}, {"type": "subtitle", "time": 12390.95, "timestamp": "03:26:30", "text": "ああ、あなたはどこにいるの？この"}, {"type": "subtitle", "time": 12394.389, "timestamp": "03:26:34", "text": "部屋。あらら。後ろに。後ろに。ああ、後ろだ。"}, {"type": "subtitle", "time": 12397.349, "timestamp": "03:26:37", "text": "わかった。"}, {"type": "subtitle", "time": 12401.19, "timestamp": "03:26:41", "text": "これです。わかった。また、バッテリーも"}, {"type": "subtitle", "time": 12409.99, "timestamp": "03:26:49", "text": "[音楽]"}, {"type": "subtitle", "time": 12411.75, "timestamp": "03:26:51", "text": "ええ、金メダルを持っています。誰もが"}, {"type": "subtitle", "time": 12414.07, "timestamp": "03:26:54", "text": "ヤギを飼っていますか？なぜなら、私は思うからです。ああ、私は思う"}, {"type": "subtitle", "time": 12416.309, "timestamp": "03:26:56", "text": "準備は万端です。ああ、うっかり"}, {"type": "subtitle", "time": 12419.67, "timestamp": "03:26:59", "text": "神を落とした。ああ、大丈夫だよ。それは それは"}]
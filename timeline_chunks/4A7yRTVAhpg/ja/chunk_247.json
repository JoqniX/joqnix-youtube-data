[{"type": "subtitle", "time": 14820.389, "timestamp": "04:07:00", "text": "ヴィックとフジ用にコピーを手に入れたと思う"}, {"type": "subtitle", "time": 14824.71, "timestamp": "04:07:04", "text": "ヴィックは自分のために買った。ええ、それもそうです。"}, {"type": "subtitle", "time": 14826.87, "timestamp": "04:07:06", "text": "そう、まさに広がり続けているんです。"}, {"type": "subtitle", "time": 14829.99, "timestamp": "04:07:09", "text": "私たちはただ遊んでいただけです。くそ。"}, {"type": "subtitle", "time": 14832.71, "timestamp": "04:07:12", "text": "ゲームをダウンロードしました。わかった。その"}, {"type": "subtitle", "time": 14834.469, "timestamp": "04:07:14", "text": "ゲームをダウンロードした瞬間、誰も"}, {"type": "subtitle", "time": 14839.269, "timestamp": "04:07:19", "text": "皆が立ち止まった。理由がわからない。"}, {"type": "subtitle", "time": 14842.07, "timestamp": "04:07:22", "text": "うん。私はただ迫り来る迫り来る"}, {"type": "subtitle", "time": 14844.95, "timestamp": "04:07:24", "text": "不信感の雲。ただ私が"}, {"type": "subtitle", "time": 14847.269, "timestamp": "04:07:27", "text": "触れるとすぐに枯れてしまう。"}, {"type": "subtitle", "time": 14849.51, "timestamp": "04:07:29", "text": "何てことだ。いや、そんな言い方はしないで。"}, {"type": "subtitle", "time": 14852.15, "timestamp": "04:07:32", "text": "何てことだ。とにかく、私は明らかに"}, {"type": "subtitle", "time": 14854.469, "timestamp": "04:07:34", "text": "冗談だよ。 Jさん、"}, {"type": "subtitle", "time": 14856.99, "timestamp": "04:07:36", "text": "ゲーム？うん、手に入れたよ"}, {"type": "subtitle", "time": 14859.75, "timestamp": "04:07:39", "text": "以前入手可能だったサルベーション。だから私は"}, {"type": "subtitle", "time": 14862.07, "timestamp": "04:07:42", "text": "欺瞞なしに再起動するようなものだ。"}, {"type": "subtitle", "time": 14864.55, "timestamp": "04:07:44", "text": "うん、久しぶりにオンラインになったよ"}, {"type": "subtitle", "time": 14866.87, "timestamp": "04:07:46", "text": "ヴァレラントで長い間。"}, {"type": "subtitle", "time": 14871.03, "timestamp": "04:07:51", "text": "Ch氏はい、でも大丈夫です"}, {"type": "subtitle", "time": 14874.79, "timestamp": "04:07:54", "text": "ミスターが遊びたくないように出て行くのを見送る"}, {"type": "subtitle", "time": 14877.11, "timestamp": "04:07:57", "text": "ゲームでは、おそらく2ラウンドか"}, {"type": "subtitle", "time": 14879.99, "timestamp": "04:07:59", "text": "何かあったにもかかわらず、彼は依然としてトップ5に入っていた。"}]
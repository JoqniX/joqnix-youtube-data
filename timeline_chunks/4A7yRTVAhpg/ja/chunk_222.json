[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "レディ。クモ女も可愛い"}, {"type": "subtitle", "time": 13322.389, "timestamp": "03:42:02", "text": "単純。"}, {"type": "subtitle", "time": 13324.71, "timestamp": "03:42:04", "text": "ええ、でも、ああ、あのね？あなたが知っている"}, {"type": "subtitle", "time": 13327.19, "timestamp": "03:42:07", "text": "何？中に入りたいですか？中に入りましょう。"}, {"type": "subtitle", "time": 13332.15, "timestamp": "03:42:12", "text": "大丈夫です。ああ、そうだね。私たちは見た 私たちは見た 私たちは"}, {"type": "subtitle", "time": 13336.229, "timestamp": "03:42:16", "text": "ジョーという女性を見かけた。女性であるべきだ。"}, {"type": "subtitle", "time": 13346.91, "timestamp": "03:42:26", "text": "アルゴフォビア、君たちはプレイしたい"}, {"type": "subtitle", "time": 13350.11, "timestamp": "03:42:30", "text": "衝突？それは素晴らしいですね"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "ああ、フードドッグって何？調子はどうですか？だった"}, {"type": "subtitle", "time": 13365.349, "timestamp": "03:42:45", "text": "食べ物、そして何がおいしいの、犬？"}, {"type": "subtitle", "time": 13366.87, "timestamp": "03:42:46", "text": "こんにちは、ホットドッグ。お元気ですか？希望"}, {"type": "subtitle", "time": 13378.07, "timestamp": "03:42:58", "text": "いやいや。"}]
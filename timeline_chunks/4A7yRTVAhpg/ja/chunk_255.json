[{"type": "subtitle", "time": 15301.91, "timestamp": "04:15:01", "text": "より良い。参加したいです。次は私が試してみます"}, {"type": "subtitle", "time": 15305.03, "timestamp": "04:15:05", "text": "ゲーム。何かあったら覚えておいて"}, {"type": "subtitle", "time": 15307.99, "timestamp": "04:15:07", "text": "間違いだ、自分で唱えればいい。私は"}, {"type": "subtitle", "time": 15311.349, "timestamp": "04:15:11", "text": "より良い。そしてあなたはもっと良くなるでしょう。"}, {"type": "subtitle", "time": 15320.87, "timestamp": "04:15:20", "text": "私は死んだ。"}, {"type": "subtitle", "time": 15323.75, "timestamp": "04:15:23", "text": "ああ、"}, {"type": "subtitle", "time": 15327.269, "timestamp": "04:15:27", "text": "ほとんど。君ならできるよ。"}, {"type": "subtitle", "time": 15330.87, "timestamp": "04:15:30", "text": "ああ、クロスヘアも大好きだよ。"}, {"type": "subtitle", "time": 15339.67, "timestamp": "04:15:39", "text": "ああ、"}, {"type": "subtitle", "time": 15343.269, "timestamp": "04:15:43", "text": "ネオンサインがムカつく。何てことだ、"}, {"type": "subtitle", "time": 15345.79, "timestamp": "04:15:45", "text": "ネオンサインがあなたをイライラさせている。多分"}, {"type": "subtitle", "time": 15348.87, "timestamp": "04:15:48", "text": "何か行動を起こすべきかもしれない。"}]
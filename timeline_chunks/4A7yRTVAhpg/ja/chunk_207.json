[{"type": "subtitle", "time": 12423.19, "timestamp": "03:27:03", "text": "大丈夫。はい、どうぞ。ガソリン缶。私に"}, {"type": "subtitle", "time": 12425.75, "timestamp": "03:27:05", "text": "2番。ちょっと荷物を積ませてくれ。"}, {"type": "subtitle", "time": 12427.99, "timestamp": "03:27:07", "text": "はい、大丈夫です。"}, {"type": "subtitle", "time": 12430.55, "timestamp": "03:27:10", "text": "銃が必要だ。"}, {"type": "subtitle", "time": 12433.67, "timestamp": "03:27:13", "text": "ガラス。ここをつかんで落とすことができます"}, {"type": "subtitle", "time": 12435.03, "timestamp": "03:27:15", "text": "彼女の目の前にそれを置いた。良い。あなたは"}, {"type": "subtitle", "time": 12437.19, "timestamp": "03:27:17", "text": "大丈夫。"}, {"type": "subtitle", "time": 12440.51, "timestamp": "03:27:20", "text": "いくつか手に入れよう"}, {"type": "subtitle", "time": 12444.229, "timestamp": "03:27:24", "text": "ショック。ヤギを駆け抜けて"}, {"type": "subtitle", "time": 12446.229, "timestamp": "03:27:26", "text": "ヤギ。"}, {"type": "subtitle", "time": 12449.51, "timestamp": "03:27:29", "text": "よし、やってみるよ。ヤギから切り離す。"}, {"type": "subtitle", "time": 12452.309, "timestamp": "03:27:32", "text": "大丈夫です。食料を一度に手に入れることができます。"}, {"type": "subtitle", "time": 12461.79, "timestamp": "03:27:41", "text": "そうそう。はい、それは"}, {"type": "subtitle", "time": 12468.95, "timestamp": "03:27:48", "text": "ここまで来ると、アンナは"}, {"type": "subtitle", "time": 12471.11, "timestamp": "03:27:51", "text": "それは私たちを殺すだろう。"}, {"type": "subtitle", "time": 12472.87, "timestamp": "03:27:52", "text": "ええ、それがすべてです"}, {"type": "subtitle", "time": 12476.469, "timestamp": "03:27:56", "text": "ゲームについて。賢くならなければならない。"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "何てことだ。"}]
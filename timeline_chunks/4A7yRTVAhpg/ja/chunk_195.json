[{"type": "subtitle", "time": 11702.07, "timestamp": "03:15:02", "text": "悪魔？どうやって？悪魔はどんな姿をしているのでしょうか？"}, {"type": "subtitle", "time": 11704.15, "timestamp": "03:15:04", "text": "信じてください、あなたはいつか分かるでしょう"}, {"type": "subtitle", "time": 11706.63, "timestamp": "03:15:06", "text": "それを見て。"}, {"type": "subtitle", "time": 11709.59, "timestamp": "03:15:09", "text": "ああ、アンナが泣いている。"}, {"type": "subtitle", "time": 11711.429, "timestamp": "03:15:11", "text": "ああ、彼女は大変な時期を過ごしているんだね。はい、彼女は"}, {"type": "subtitle", "time": 11713.91, "timestamp": "03:15:13", "text": "それを経験している。彼女は、"}, {"type": "subtitle", "time": 11715.99, "timestamp": "03:15:15", "text": "彼女にとって非常に感情的な時期だ。あなた"}, {"type": "subtitle", "time": 11717.99, "timestamp": "03:15:17", "text": "ほら、彼女にはある程度の自由を与えてあげてるんだよ。"}, {"type": "subtitle", "time": 11719.99, "timestamp": "03:15:19", "text": "私たちは彼女に少し距離を置くようにしている。どこに保管すればいいですか"}, {"type": "subtitle", "time": 11723.11, "timestamp": "03:15:23", "text": "ガソリン缶？外。えっと、ほら、"}, {"type": "subtitle", "time": 11725.51, "timestamp": "03:15:25", "text": "バーベキューをする場所を知っている。"}, {"type": "subtitle", "time": 11735.91, "timestamp": "03:15:35", "text": "よし、みんな。うん。はい。もし君たちが必要とするなら"}, {"type": "subtitle", "time": 11740.309, "timestamp": "03:15:40", "text": "ええと、共有の寝室の鍵は私が持っています。"}, {"type": "subtitle", "time": 11742.87, "timestamp": "03:15:42", "text": "わかった。いいね。"}, {"type": "subtitle", "time": 11745.349, "timestamp": "03:15:45", "text": "カボチャが残っていて、"}, {"type": "subtitle", "time": 11747.429, "timestamp": "03:15:47", "text": "そうだよ、相棒。ええ、たくさんあります"}]
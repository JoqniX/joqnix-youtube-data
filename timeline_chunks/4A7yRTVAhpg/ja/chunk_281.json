[{"type": "subtitle", "time": 16863.59, "timestamp": "04:41:03", "text": "ゲーム。いいえ、違います。うん。地元の協同組合。"}, {"type": "subtitle", "time": 16866.628, "timestamp": "04:41:06", "text": "パンとフレッド。いや、いや、いや。愛。いいえ、"}, {"type": "subtitle", "time": 16868.39, "timestamp": "04:41:08", "text": "いや、いや、いや、いや。そうじゃない。何が"}, {"type": "subtitle", "time": 16871.59, "timestamp": "04:41:11", "text": "それを何と呼ぶのか？デッドスペース3は"}, {"type": "subtitle", "time": 16873.75, "timestamp": "04:41:13", "text": "コープ。"}, {"type": "subtitle", "time": 16876.868, "timestamp": "04:41:16", "text": "ああ、１と２じゃないよ。 1と2ではない。"}, {"type": "subtitle", "time": 16883.788, "timestamp": "04:41:23", "text": "[音楽]"}, {"type": "subtitle", "time": 16887.03, "timestamp": "04:41:27", "text": "わかった。面白いゲームがある。あなた"}, {"type": "subtitle", "time": 16891.51, "timestamp": "04:41:31", "text": "World of Hollerをプレイしてみませんか？"}, {"type": "subtitle", "time": 16894.31, "timestamp": "04:41:34", "text": "ホラーの世界。何？ホラーの世界。"}, {"type": "subtitle", "time": 16896.788, "timestamp": "04:41:36", "text": "660ルピーくらいです。まるでスーパー"}, {"type": "subtitle", "time": 16898.708, "timestamp": "04:41:38", "text": "ホラーゲーム。"}, {"type": "subtitle", "time": 16901.43, "timestamp": "04:41:41", "text": "まるでジンジャーブラックみたいで"}, {"type": "subtitle", "time": 16903.75, "timestamp": "04:41:43", "text": "白。"}, {"type": "subtitle", "time": 16906.19, "timestamp": "04:41:46", "text": "生姜を食べる人からインスピレーションを得た。"}, {"type": "subtitle", "time": 16908.948, "timestamp": "04:41:48", "text": "ジンジェリート。何？"}, {"type": "subtitle", "time": 16913.19, "timestamp": "04:41:53", "text": "何てことだ。彼を知らないの？いや。ちくしょう。"}, {"type": "subtitle", "time": 16915.51, "timestamp": "04:41:55", "text": "彼について調べてみてください。彼について調べてみてください。"}, {"type": "subtitle", "time": 16918.19, "timestamp": "04:41:58", "text": "待って。ジンジャーの綴り。"}]
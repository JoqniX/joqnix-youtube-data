[{"type": "subtitle", "time": 14583.67, "timestamp": "04:03:03", "text": "プレイ中ですか？ 1つのマッチのようなカップル"}, {"type": "subtitle", "time": 14584.95, "timestamp": "04:03:04", "text": "あるいは、そんな感じ。終わらせるしかない"}, {"type": "subtitle", "time": 14587.03, "timestamp": "04:03:07", "text": "ストリーム。"}, {"type": "subtitle", "time": 14589.429, "timestamp": "04:03:09", "text": "これを締めくくって"}, {"type": "subtitle", "time": 14592.469, "timestamp": "04:03:12", "text": "連勝街道を突き進む。いいえ、しないでください"}, {"type": "subtitle", "time": 14594.79, "timestamp": "04:03:14", "text": "それ。わかった。わかった。わかった。わかった。 1つの値"}, {"type": "subtitle", "time": 14596.469, "timestamp": "04:03:16", "text": "ゲーム。わかった。わかった。はい、できます"}, {"type": "subtitle", "time": 14600.469, "timestamp": "04:03:20", "text": "それ。そう、私たちは虫が好きなんです"}, {"type": "subtitle", "time": 14603.83, "timestamp": "04:03:23", "text": "薬物中毒のウサギ。笑。何？何？"}, {"type": "subtitle", "time": 14608.15, "timestamp": "04:03:28", "text": "クロノの出番だ。一体どういうことだ？何？"}, {"type": "subtitle", "time": 14610.229, "timestamp": "04:03:30", "text": "バッグス・バニーにドラッグを飲ませてやれよ。"}, {"type": "subtitle", "time": 14614.79, "timestamp": "04:03:34", "text": "来て。ああ、わかりました。私はしたい 私はしたい"}, {"type": "subtitle", "time": 14617.99, "timestamp": "04:03:37", "text": "ヴァラントに変更してください。"}, {"type": "subtitle", "time": 14621.189, "timestamp": "04:03:41", "text": "こんにちは。 Mythicは精神的な支えとしてここにいます。"}, {"type": "subtitle", "time": 14624.15, "timestamp": "04:03:44", "text": "彼女は単なるコーチ以上の存在だ。"}, {"type": "subtitle", "time": 14638.95, "timestamp": "04:03:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 18122.15, "timestamp": "05:02:02", "text": "また。大丈夫です。"}, {"type": "subtitle", "time": 18124.39, "timestamp": "05:02:04", "text": "何てことだ。そして明日は日曜日です。"}, {"type": "subtitle", "time": 18128.31, "timestamp": "05:02:08", "text": "つまり、あなたが大家さんで、"}, {"type": "subtitle", "time": 18131.03, "timestamp": "05:02:11", "text": "フェスティバルもペストフェスティバルのようなもの"}, {"type": "subtitle", "time": 18133.19, "timestamp": "05:02:13", "text": "あるいは何かが起こっている。それで彼女は私に"}, {"type": "subtitle", "time": 18135.75, "timestamp": "05:02:15", "text": "ビリヤニのクーポンみたいなもの。"}, {"type": "subtitle", "time": 18138.868, "timestamp": "05:02:18", "text": "彼女は私にビリヤニを食べに来るように言った。"}, {"type": "subtitle", "time": 18143.75, "timestamp": "05:02:23", "text": "何てことだ。ビリヤニだよ、みんな。さあ行こう。"}, {"type": "subtitle", "time": 18145.67, "timestamp": "05:02:25", "text": "はい。"}, {"type": "subtitle", "time": 18148.23, "timestamp": "05:02:28", "text": "わかった。ところで、何何何何"}, {"type": "subtitle", "time": 18149.75, "timestamp": "05:02:29", "text": "ビリヤニはありますか？それはまるで"}, {"type": "subtitle", "time": 18153.19, "timestamp": "05:02:33", "text": "バスマティ米？それともあの変わった海のサンバルみたいな？"}, {"type": "subtitle", "time": 18155.19, "timestamp": "05:02:35", "text": "わからない。バスマティが一番だと思う"}, {"type": "chat", "time": 18157.622, "timestamp": "05:02:37", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Midnight-Snacking"}, {"type": "subtitle", "time": 18157.99, "timestamp": "05:02:37", "text": "当時のことですよね？ええ、これがあります"}, {"type": "subtitle", "time": 18161.83, "timestamp": "05:02:41", "text": "ここのシーグサンバルは変で、馬鹿げている。"}, {"type": "subtitle", "time": 18166.41, "timestamp": "05:02:46", "text": "ああ、あれは全然美味しくなかったよ。"}, {"type": "subtitle", "time": 18168.628, "timestamp": "05:02:48", "text": "[音楽]"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "ねえ、バスマティライスってどんな味がするの？"}, {"type": "subtitle", "time": 18173.83, "timestamp": "05:02:53", "text": "のように？味を忘れてしまった。バスマティライス"}, {"type": "subtitle", "time": 18176.31, "timestamp": "05:02:56", "text": "麺のような、米のような、長い"}, {"type": "subtitle", "time": 18179.27, "timestamp": "05:02:59", "text": "米。ああ、いや。うん。うん。うん。の"}]
[{"type": "subtitle", "time": 9780.19, "timestamp": "02:43:00", "text": "彼は、彼らは何をしようとしているのか"}, {"type": "subtitle", "time": 9783.03, "timestamp": "02:43:03", "text": "する？なぜ彼らは私たちの"}, {"type": "subtitle", "time": 9796.389, "timestamp": "02:43:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9800.55, "timestamp": "02:43:20", "text": "ここで終わりにします。"}, {"type": "subtitle", "time": 9803.349, "timestamp": "02:43:23", "text": "ええ、ここで終わりにしましょう。"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "ありがとう。"}, {"type": "subtitle", "time": 9814.79, "timestamp": "02:43:34", "text": "ご招待いただきありがとうございます。さあ"}, {"type": "subtitle", "time": 9818.469, "timestamp": "02:43:38", "text": "次回はぜひプレイしたいです。はい、次"}, {"type": "subtitle", "time": 9823.19, "timestamp": "02:43:43", "text": "私が日本にいる時間。上。いいえ、"}, {"type": "subtitle", "time": 9826.85, "timestamp": "02:43:46", "text": "あなたは私より1時間先を行っています。"}, {"type": "subtitle", "time": 9828.349, "timestamp": "02:43:48", "text": "[音楽]"}, {"type": "subtitle", "time": 9831.03, "timestamp": "02:43:51", "text": "うん。うん。もっとコラボレーションすべきだ"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "楽しかったよ。ありがとうございました"}]
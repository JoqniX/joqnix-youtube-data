[{"type": "subtitle", "time": 1920.23, "timestamp": "00:32:00", "text": "調理器具が必要ですよね？"}, {"type": "subtitle", "time": 1923.59, "timestamp": "00:32:03", "text": "えっと、もう1つ必要なら、"}, {"type": "subtitle", "time": 1927.029, "timestamp": "00:32:07", "text": "アップグレードしてください。アップグレードできますか？ええ、私たちは"}, {"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "アップグレードできるので、別のものを設置する必要はありません。"}, {"type": "subtitle", "time": 1935.59, "timestamp": "00:32:15", "text": "アップグレードすると、動作が速くなります。"}, {"type": "subtitle", "time": 1939.149, "timestamp": "00:32:19", "text": "そうそう。これ60ドル。わかった、絶対にない"}, {"type": "subtitle", "time": 1942.71, "timestamp": "00:32:22", "text": "心。でも私たちはできる、ああ、私はちょっと欲しい"}, {"type": "subtitle", "time": 1945.43, "timestamp": "00:32:25", "text": "もっとお皿を。プレートが増えると"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": "より良い。"}, {"type": "subtitle", "time": 1951.87, "timestamp": "00:32:31", "text": "残った袋。それは何ですか？私は持っていません"}, {"type": "subtitle", "time": 1955.35, "timestamp": "00:32:35", "text": "アイデア。あのね？コンロを用意しよう"}, {"type": "subtitle", "time": 1965.549, "timestamp": "00:32:45", "text": "あ、待って。それはアップグレードされたものですか？ああ、それ"}, {"type": "subtitle", "time": 1973.269, "timestamp": "00:32:53", "text": "これをどこかに置いておけますか？"}, {"type": "subtitle", "time": 1974.59, "timestamp": "00:32:54", "text": "それは"}, {"type": "subtitle", "time": 1977.509, "timestamp": "00:32:57", "text": "一度姿を消す。"}]
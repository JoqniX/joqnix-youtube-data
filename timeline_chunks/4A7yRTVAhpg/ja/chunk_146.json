[{"type": "subtitle", "time": 8764.19, "timestamp": "02:26:04", "text": "今回のラウンドはどれくらい続けたいですか？"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "[音楽]"}, {"type": "subtitle", "time": 8779.429, "timestamp": "02:26:19", "text": "一度クラッシュしたら、"}, {"type": "subtitle", "time": 8781.67, "timestamp": "02:26:21", "text": "ある日、私たちは再開することができません"}, {"type": "subtitle", "time": 8783.15, "timestamp": "02:26:23", "text": "そうですね"}, {"type": "subtitle", "time": 8787.429, "timestamp": "02:26:27", "text": "私たちはできる"}, {"type": "subtitle", "time": 8788.91, "timestamp": "02:26:28", "text": "我々はできる"}, {"type": "subtitle", "time": 8791.389, "timestamp": "02:26:31", "text": "そして完璧"}]
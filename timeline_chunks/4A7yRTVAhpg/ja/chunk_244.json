[{"type": "subtitle", "time": 14641.75, "timestamp": "04:04:01", "text": "たぶん、えっと、"}, {"type": "subtitle", "time": 14643.91, "timestamp": "04:04:03", "text": "もう手遅れだ。"}, {"type": "subtitle", "time": 14646.95, "timestamp": "04:04:06", "text": "ああ、もう遅い時間だ。だからそれは"}, {"type": "subtitle", "time": 14649.469, "timestamp": "04:04:09", "text": "少し痛い。うん。"}, {"type": "subtitle", "time": 14654.07, "timestamp": "04:04:14", "text": "こんにちは。こんにちは。私は配信を終了しました。病気"}, {"type": "subtitle", "time": 14658.469, "timestamp": "04:04:18", "text": "私はここにいるのではなく、ただあなたたちを応援しているだけです。"}, {"type": "subtitle", "time": 14662.229, "timestamp": "04:04:22", "text": "こんにちは。うん、大丈夫だよ。あなたには私たちが見えません"}, {"type": "subtitle", "time": 14665.79, "timestamp": "04:04:25", "text": "ゲームが下手なのと同じように。ああ、いや、いや、"}, {"type": "subtitle", "time": 14670.95, "timestamp": "04:04:30", "text": "いいえ。あなたはきっと素晴らしい人になるでしょう。私を信じて。はい。"}, {"type": "subtitle", "time": 14674.07, "timestamp": "04:04:34", "text": "すごく面白いことになるよ。"}, {"type": "subtitle", "time": 14675.91, "timestamp": "04:04:35", "text": "あなたはきっと素晴らしい人になるでしょう。信じる"}, {"type": "subtitle", "time": 14679.75, "timestamp": "04:04:39", "text": "あなた自身。わかった。まず、ミスター。"}, {"type": "subtitle", "time": 14683.59, "timestamp": "04:04:43", "text": "ジャクニックス、もう隠れるのはやめてくれないか？"}, {"type": "subtitle", "time": 14691.189, "timestamp": "04:04:51", "text": "どうして分かったの？どうして分かったの？どうやって"}, {"type": "subtitle", "time": 14693.99, "timestamp": "04:04:53", "text": "私が障害者だって知っていましたか？"}, {"type": "subtitle", "time": 14697.03, "timestamp": "04:04:57", "text": "もちろんそうするよ。"}]
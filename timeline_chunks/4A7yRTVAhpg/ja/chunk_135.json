[{"type": "subtitle", "time": 8123.55, "timestamp": "02:15:23", "text": "ニンジン。ニンジン。"}, {"type": "subtitle", "time": 8127.43, "timestamp": "02:15:27", "text": "ニンジン。肉。"}, {"type": "subtitle", "time": 8147.669, "timestamp": "02:15:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8149.669, "timestamp": "02:15:49", "text": "ああ、なんてことだ。保管できますか？できません"}, {"type": "subtitle", "time": 8151.589, "timestamp": "02:15:51", "text": "餃子を売る。冗談でしょう？"}, {"type": "subtitle", "time": 8153.83, "timestamp": "02:15:53", "text": "自分。"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "小道具の中に保管してください。正直に、"}, {"type": "subtitle", "time": 8159.99, "timestamp": "02:15:59", "text": "できません。ああ、生のまましか保存できない"}]
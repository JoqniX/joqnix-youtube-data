[{"type": "subtitle", "time": 1985.83, "timestamp": "00:33:05", "text": "うん、そこに置いておこう。"}, {"type": "subtitle", "time": 1987.99, "timestamp": "00:33:07", "text": "もう調査する必要はありません"}, {"type": "subtitle", "time": 1989.669, "timestamp": "00:33:09", "text": "なぜなら"}, {"type": "subtitle", "time": 1993.71, "timestamp": "00:33:13", "text": "えっと、食洗機はもう持ってますよ。"}, {"type": "subtitle", "time": 1995.99, "timestamp": "00:33:15", "text": "ああ、ただお金が足りないだけなんです"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "まだ手に入れていない。"}, {"type": "subtitle", "time": 2001.269, "timestamp": "00:33:21", "text": "待って、待って、待って、待って、待って。ああ、私は"}, {"type": "subtitle", "time": 2003.35, "timestamp": "00:33:23", "text": "忘れた。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "既存のものをアップグレードすることはできません。"}, {"type": "subtitle", "time": 2010.31, "timestamp": "00:33:30", "text": "いや、それはできません。"}, {"type": "subtitle", "time": 2017.11, "timestamp": "00:33:37", "text": "うん。こうすればあなたにとっては簡単です"}, {"type": "subtitle", "time": 2020.71, "timestamp": "00:33:40", "text": "並ぶ。うん。うん。確かに、確かに、確かに。"}, {"type": "subtitle", "time": 2033.43, "timestamp": "00:33:53", "text": "ええと、それを切り刻まなければなりません。ああ、なんてことだ。"}, {"type": "subtitle", "time": 2036.07, "timestamp": "00:33:56", "text": "うん、イライラするよね。"}]
[{"type": "subtitle", "time": 12840.63, "timestamp": "03:34:00", "text": "あらら。それは違います。少なくとも"}, {"type": "subtitle", "time": 12841.99, "timestamp": "03:34:01", "text": "1人減った。少なくとも1人は倒せる"}, {"type": "subtitle", "time": 12852.63, "timestamp": "03:34:12", "text": "彼女は来ない。待って、待って。私は"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "ピッキング。注意深く見守ってください。注意深く見守ってください。どうやって"}, {"type": "subtitle", "time": 12857.67, "timestamp": "03:34:17", "text": "長さ？"}, {"type": "subtitle", "time": 12860.07, "timestamp": "03:34:20", "text": "えっと、待って、待って、待って。えっと、火事。火。"}, {"type": "subtitle", "time": 12862.63, "timestamp": "03:34:22", "text": "うん。うん。"}, {"type": "subtitle", "time": 12865.83, "timestamp": "03:34:25", "text": "ああ、彼女が来るわ。彼女が来る。ゲット・アイム"}, {"type": "subtitle", "time": 12868.269, "timestamp": "03:34:28", "text": "大丈夫。元気です。火をつけます。"}, {"type": "subtitle", "time": 12872.309, "timestamp": "03:34:32", "text": "立つ。いいえ。わかりました。銃を置くよ。わかった。"}, {"type": "subtitle", "time": 12874.07, "timestamp": "03:34:34", "text": "ダメ。ダメ。ダメ。ダメ。ダメ。ダメ。ダメ、ダメ、ダメ。ダメ、ダメ、ダメ"}, {"type": "subtitle", "time": 12877.19, "timestamp": "03:34:37", "text": "歩けない、歩けない、歩けない。待って、私は"}, {"type": "subtitle", "time": 12879.83, "timestamp": "03:34:39", "text": "走れ、走れ。では、神についてはどうでしょうか？えっと、"}, {"type": "subtitle", "time": 12883.349, "timestamp": "03:34:43", "text": "コードはいつでも後で書き留めることができます。"}, {"type": "subtitle", "time": 12885.51, "timestamp": "03:34:45", "text": "よし、中に入るよ。"}, {"type": "subtitle", "time": 12887.59, "timestamp": "03:34:47", "text": "ああ、"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "待って、待って。どうしたの？ヴィックは亡くなった。試す"}, {"type": "subtitle", "time": 12893.51, "timestamp": "03:34:53", "text": "前回のゲームに再接続します。"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "あ、待って。いや、いや、いや。えーと、ヴィック・ヴィックス"}]
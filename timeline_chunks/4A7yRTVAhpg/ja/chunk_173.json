[{"type": "subtitle", "time": 10380.309, "timestamp": "02:53:00", "text": "そうではありません。それは涅槃ではない。ごめん。"}, {"type": "subtitle", "time": 10382.15, "timestamp": "02:53:02", "text": "まるで混乱した腺みたい"}, {"type": "subtitle", "time": 10391.59, "timestamp": "02:53:11", "text": "ああ、大変だ。普通はこう呼ぶだけです、"}, {"type": "subtitle", "time": 10393.03, "timestamp": "02:53:13", "text": "でも、なぜそう呼ぶのか分かりません"}, {"type": "subtitle", "time": 10395.03, "timestamp": "02:53:15", "text": "涅槃。"}, {"type": "subtitle", "time": 10397.83, "timestamp": "02:53:17", "text": "ああ、それって同じことだよね？"}, {"type": "subtitle", "time": 10401.83, "timestamp": "02:53:21", "text": "いいえ。え？しかし、マリファナは"}, {"type": "subtitle", "time": 10404.67, "timestamp": "02:53:24", "text": "同じ。"}, {"type": "subtitle", "time": 10407.51, "timestamp": "02:53:27", "text": "ああ、わかりました。今、すごく混乱しています。わかった。"}, {"type": "subtitle", "time": 10410.469, "timestamp": "02:53:30", "text": "知ってる？お香。大丈夫。"}, {"type": "subtitle", "time": 10413.429, "timestamp": "02:53:33", "text": "お香。ああ、わかりました。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 10416.469, "timestamp": "02:53:36", "text": "わかった。お香スティックは、まるで"}, {"type": "subtitle", "time": 10420.07, "timestamp": "02:53:40", "text": "あなたが神々に捧げるような献身。"}, {"type": "subtitle", "time": 10423.269, "timestamp": "02:53:43", "text": "燃える棒のようなものもある"}, {"type": "subtitle", "time": 10427.03, "timestamp": "02:53:47", "text": "蚊を寄せ付けないためだけに。だから、"}, {"type": "subtitle", "time": 10429.19, "timestamp": "02:53:49", "text": "たぶん、ジャガイモかな。わからない。しかし"}, {"type": "subtitle", "time": 10433.91, "timestamp": "02:53:53", "text": "ええ、私の主張は変わりません。ミラナは"}, {"type": "subtitle", "time": 10439.07, "timestamp": "02:53:59", "text": "蚊のブランドではありません。はい。"}]
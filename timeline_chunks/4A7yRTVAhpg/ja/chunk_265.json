[{"type": "subtitle", "time": 15902.07, "timestamp": "04:25:02", "text": "ポータルに入ってください。ああ、私は死んだ。狂った"}, {"type": "subtitle", "time": 15904.469, "timestamp": "04:25:04", "text": "ジャンプ。大丈夫です"}, {"type": "subtitle", "time": 15907.189, "timestamp": "04:25:07", "text": "だって、MVMを手に入れたから。おお、いいね。ニース。彼"}, {"type": "subtitle", "time": 15927.429, "timestamp": "04:25:27", "text": "死んだ。大丈夫です。"}, {"type": "subtitle", "time": 15929.99, "timestamp": "04:25:29", "text": "みんなでしばらくの間楽しむことができるよ、"}, {"type": "subtitle", "time": 15943.11, "timestamp": "04:25:43", "text": "[拍手]"}, {"type": "subtitle", "time": 15946.07, "timestamp": "04:25:46", "text": "圧倒的だ。"}, {"type": "subtitle", "time": 15949.75, "timestamp": "04:25:49", "text": "あの人たちはキャンプをしているような感じですね。"}, {"type": "subtitle", "time": 15958.229, "timestamp": "04:25:58", "text": "[拍手]"}]
[{"type": "subtitle", "time": 15361.83, "timestamp": "04:16:01", "text": "ああ、なんてこった。それは、それは、ほとんど"}, {"type": "subtitle", "time": 15365.83, "timestamp": "04:16:05", "text": "死んだ。ああ、大変だ。痛い。何てことだ。私はとても"}, {"type": "subtitle", "time": 15369.349, "timestamp": "04:16:09", "text": "錆びている。私はここから出て行く。すっかり腕が鈍ってしまった。"}, {"type": "subtitle", "time": 15386.149, "timestamp": "04:16:26", "text": "ラスティをプレイするのをやめる方法を知ってるよね"}, {"type": "subtitle", "time": 15395.91, "timestamp": "04:16:35", "text": "再装填中。"}, {"type": "subtitle", "time": 15400.11, "timestamp": "04:16:40", "text": "ステージチェンジまであと10秒。しなければならない"}, {"type": "subtitle", "time": 15403.75, "timestamp": "04:16:43", "text": "行く。ああ、"}, {"type": "subtitle", "time": 15406.07, "timestamp": "04:16:46", "text": "もう行かなきゃ。"}, {"type": "subtitle", "time": 15418.55, "timestamp": "04:16:58", "text": "何てことだ。私は、ああ"}]
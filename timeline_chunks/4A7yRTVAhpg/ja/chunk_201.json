[{"type": "subtitle", "time": 12062.67, "timestamp": "03:21:02", "text": "右？そしてあなたは"}, {"type": "subtitle", "time": 12065.91, "timestamp": "03:21:05", "text": "走る。おお、"}, {"type": "subtitle", "time": 12069.59, "timestamp": "03:21:09", "text": "わかった。ちくしょう。どこがバカなんだ"}, {"type": "subtitle", "time": 12071.91, "timestamp": "03:21:11", "text": "もの？"}, {"type": "subtitle", "time": 12073.95, "timestamp": "03:21:13", "text": "共有する"}, {"type": "subtitle", "time": 12077.19, "timestamp": "03:21:17", "text": "バスルーム。どこにいるの？"}, {"type": "subtitle", "time": 12079.11, "timestamp": "03:21:19", "text": "つまり、私は、"}, {"type": "subtitle", "time": 12080.71, "timestamp": "03:21:20", "text": "すでに開封済みです。"}, {"type": "subtitle", "time": 12083.269, "timestamp": "03:21:23", "text": "開いているようだ。誤って開いてしまいました"}, {"type": "subtitle", "time": 12086.15, "timestamp": "03:21:26", "text": "それ。"}, {"type": "subtitle", "time": 12088.87, "timestamp": "03:21:28", "text": "バスルームは共有してください。"}, {"type": "subtitle", "time": 12092.55, "timestamp": "03:21:32", "text": "しかし、重要なのはそこだ。ええ、あなたはまだ"}, {"type": "subtitle", "time": 12096.309, "timestamp": "03:21:36", "text": "鍵はそこですよね？いいえ、あなたたちはそれを使います、"}, {"type": "subtitle", "time": 12098.309, "timestamp": "03:21:38", "text": "右？待って、待って。どうやって確認するの？"}, {"type": "subtitle", "time": 12100.19, "timestamp": "03:21:40", "text": "また鍵ですか？"}, {"type": "subtitle", "time": 12103.429, "timestamp": "03:21:43", "text": "K.K."}, {"type": "subtitle", "time": 12107.19, "timestamp": "03:21:47", "text": "鍵は渡しませんよ。 1 2 3 4 5 6。"}, {"type": "subtitle", "time": 12110.63, "timestamp": "03:21:50", "text": "俺のヤギを落とした。わかった。えーと、V6 7"}, {"type": "subtitle", "time": 12114.469, "timestamp": "03:21:54", "text": "8 9. 朝食室はどこですか？私たちには必要だ"}, {"type": "subtitle", "time": 12117.349, "timestamp": "03:21:57", "text": "1階です。いいえ。ええと、地面"}]
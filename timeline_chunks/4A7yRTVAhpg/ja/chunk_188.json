[{"type": "subtitle", "time": 11284.15, "timestamp": "03:08:04", "text": "ヤギ？ B. バーベキュー。はぁ？なぜ"}, {"type": "subtitle", "time": 11286.95, "timestamp": "03:08:06", "text": "罪のないヤギを殺すのか？来て。だった"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "そこでバーベキューをする。ご存知の通り、これは"}, {"type": "subtitle", "time": 11291.429, "timestamp": "03:08:11", "text": "バーベキューパーティー。あ、待って。何が"}, {"type": "subtitle", "time": 11292.87, "timestamp": "03:08:12", "text": "このヤギたちは一体何者なんだ？何てことだ、"}, {"type": "subtitle", "time": 11295.03, "timestamp": "03:08:15", "text": "彼らは気味が悪い。よし。あなたはしたい"}, {"type": "subtitle", "time": 11296.469, "timestamp": "03:08:16", "text": "彼らを解放するのか？あなたは"}, {"type": "subtitle", "time": 11299.51, "timestamp": "03:08:19", "text": "栄誉？はぁ？なぜそれらを設定するのか"}, {"type": "subtitle", "time": 11305.75, "timestamp": "03:08:25", "text": "聞いてください、誰もが"}, {"type": "subtitle", "time": 11307.51, "timestamp": "03:08:27", "text": "自由。監視されたくないだろう"}, {"type": "subtitle", "time": 11310.07, "timestamp": "03:08:30", "text": "そんな感じですよね？あなたは彼らに"}, {"type": "subtitle", "time": 11313.11, "timestamp": "03:08:33", "text": "好意。好意。"}, {"type": "subtitle", "time": 11315.11, "timestamp": "03:08:35", "text": "待って、何か聞こえる？聞こえますか？"}, {"type": "subtitle", "time": 11317.99, "timestamp": "03:08:37", "text": "それ？誰か。よし、ジョン、私について来なさい。"}, {"type": "subtitle", "time": 11320.309, "timestamp": "03:08:40", "text": "私と来て。私と来て。それは私でした。"}, {"type": "subtitle", "time": 11322.55, "timestamp": "03:08:42", "text": "ジョン。ジャンプしているのは私です。神様、やめてください"}, {"type": "subtitle", "time": 11325.19, "timestamp": "03:08:45", "text": "私を怖がらせてください。"}, {"type": "subtitle", "time": 11330.63, "timestamp": "03:08:50", "text": "何てことだ。なぜ？とにかく、私たちはそうしました。"}, {"type": "subtitle", "time": 11332.71, "timestamp": "03:08:52", "text": "わかった。とにかく、ジョー、中に入って"}, {"type": "subtitle", "time": 11334.23, "timestamp": "03:08:54", "text": "鍵。"}, {"type": "subtitle", "time": 11337.11, "timestamp": "03:08:57", "text": "わかった。え、そうだよね？わかった。そして、悪。そして"}]
[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "うん。あまり。私は思う。願っています。その"}, {"type": "subtitle", "time": 1684.95, "timestamp": "00:28:04", "text": "わかった。何とか解決策を見つけ出すよ。しかしシンク"}, {"type": "subtitle", "time": 1686.669, "timestamp": "00:28:06", "text": "は最高です。なぜなら、"}, {"type": "subtitle", "time": 1689.31, "timestamp": "00:28:09", "text": "食洗機はゆっくり動く。"}, {"type": "subtitle", "time": 1692.75, "timestamp": "00:28:12", "text": "うまくいけば。お願い、お願い"}, {"type": "subtitle", "time": 1697.789, "timestamp": "00:28:17", "text": "食器洗い機。わかった。始めましょうか？"}, {"type": "subtitle", "time": 1700.63, "timestamp": "00:28:20", "text": "うん。ああ、"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "待って。どうでも。"}, {"type": "subtitle", "time": 1715.59, "timestamp": "00:28:35", "text": "つまり、リサーチデスクは基本的に"}, {"type": "subtitle", "time": 1718.07, "timestamp": "00:28:38", "text": "このゲームではギャンブルシステムがあり、"}, {"type": "subtitle", "time": 1720.87, "timestamp": "00:28:40", "text": "アップグレードとか、そういうのも手に入るよ。"}, {"type": "subtitle", "time": 1724.029, "timestamp": "00:28:44", "text": "だから、良いことだ。待って、2つ必要"}, {"type": "subtitle", "time": 1726.549, "timestamp": "00:28:46", "text": "媒体。うん、それも入れる必要があるね"}, {"type": "subtitle", "time": 1728.549, "timestamp": "00:28:48", "text": "ゴミ。なんてこった。待って、待って、待って、"}, {"type": "subtitle", "time": 1731.72, "timestamp": "00:28:51", "text": "待って。それは確かに存在する。"}, {"type": "subtitle", "time": 1735.11, "timestamp": "00:28:55", "text": "[音楽]"}, {"type": "subtitle", "time": 1737.389, "timestamp": "00:28:57", "text": "もっとガスが必要だ"}]
[{"type": "subtitle", "time": 14401.269, "timestamp": "04:00:01", "text": "着けていません。持っていません。"}, {"type": "subtitle", "time": 14403.11, "timestamp": "04:00:03", "text": "インストール済みですが、とても簡単です"}, {"type": "subtitle", "time": 14405.59, "timestamp": "04:00:05", "text": "インストールしてください。ジョーはそれを持っているのか"}, {"type": "subtitle", "time": 14408.15, "timestamp": "04:00:08", "text": "それもまた問題だ。うん。うん。ええ、そうです"}, {"type": "subtitle", "time": 14411.51, "timestamp": "04:00:11", "text": "それを持っている。ダウンロードする必要があるのか​​な"}, {"type": "subtitle", "time": 14414.309, "timestamp": "04:00:14", "text": "でもダウンロードはとても簡単です"}, {"type": "subtitle", "time": 14418.229, "timestamp": "04:00:18", "text": "でも、5GBくらいあるんです。 5GB 7GBですが、"}, {"type": "subtitle", "time": 14421.67, "timestamp": "04:00:21", "text": "現在配信中。ストリームは「ああ、そうだ」になるだろう。"}, {"type": "subtitle", "time": 14423.91, "timestamp": "04:00:23", "text": "ああ、持っていますよ。インストール済みです。私"}, {"type": "subtitle", "time": 14426.229, "timestamp": "04:00:26", "text": "インストールしてください。うん、できるよ、できるよ"}, {"type": "subtitle", "time": 14427.67, "timestamp": "04:00:27", "text": "彼らのために少し残しておいてあげよう。待って。いいえ、"}, {"type": "subtitle", "time": 14429.11, "timestamp": "04:00:29", "text": "それも一人称視点です。それはかもしれない"}, {"type": "subtitle", "time": 14431.99, "timestamp": "04:00:31", "text": "今でも私をめちゃくちゃにしてくれる。そうそう。するとそれは"}, {"type": "subtitle", "time": 14434.95, "timestamp": "04:00:34", "text": "いいえ。ええ。本当にごめんなさい、皆さん。どうですか？"}, {"type": "subtitle", "time": 14437.429, "timestamp": "04:00:37", "text": "これ？ところで、あなたは不気味なものを手に入れました"}, {"type": "subtitle", "time": 14441.11, "timestamp": "04:00:41", "text": "目が見えたので、これで終わりにできます。おお、"}, {"type": "subtitle", "time": 14443.51, "timestamp": "04:00:43", "text": "入れてほしいの？わかった。そして死ぬ。"}, {"type": "subtitle", "time": 14445.269, "timestamp": "04:00:45", "text": "いや、いや。私たちは"}, {"type": "subtitle", "time": 14447.07, "timestamp": "04:00:47", "text": "ゲーム、ジョー。"}, {"type": "subtitle", "time": 14450.07, "timestamp": "04:00:50", "text": "そうそう。メインメニューを終了します。わかった。"}, {"type": "subtitle", "time": 14450.83, "timestamp": "04:00:50", "text": "さあ"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "見る。触る。"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "おお。おお、"}]
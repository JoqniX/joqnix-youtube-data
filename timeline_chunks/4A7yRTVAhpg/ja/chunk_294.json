[{"type": "subtitle", "time": 17640.15, "timestamp": "04:54:00", "text": "大丈夫。とにかく、そうだね。えっと、来週は何週目ですか？"}, {"type": "subtitle", "time": 17642.99, "timestamp": "04:54:02", "text": "また？私たちはLeft 4 Deadをプレイし、"}, {"type": "subtitle", "time": 17647.67, "timestamp": "04:54:07", "text": "新しいギンジートゲーム。ええ、"}, {"type": "subtitle", "time": 17657.59, "timestamp": "04:54:17", "text": "はい。まだ原神をプレイしたいの？私"}, {"type": "subtitle", "time": 17659.91, "timestamp": "04:54:19", "text": "原神をプレイしてみたいです。うん。あなた"}, {"type": "subtitle", "time": 17662.788, "timestamp": "04:54:22", "text": "何だと思う？変えましょう。原神は去った"}, {"type": "subtitle", "time": 17665.07, "timestamp": "04:54:25", "text": "足場と"}, {"type": "subtitle", "time": 17667.75, "timestamp": "04:54:27", "text": "ギンジート。ギンジートは別格だ。"}, {"type": "subtitle", "time": 17669.83, "timestamp": "04:54:29", "text": "あなたみたいに、私は知らないけど、"}, {"type": "subtitle", "time": 17671.99, "timestamp": "04:54:31", "text": "ゲームを買うのは、"}, {"type": "subtitle", "time": 17673.67, "timestamp": "04:54:33", "text": "シングルプレイヤー。うん。私はそうは思わない"}, {"type": "subtitle", "time": 17676.15, "timestamp": "04:54:36", "text": "私たちはそれをまた使うつもりです。の代わりに"}, {"type": "subtitle", "time": 17678.15, "timestamp": "04:54:38", "text": "ギンギト、君は悪役のようにプレイしたいのか？"}, {"type": "subtitle", "time": 17680.31, "timestamp": "04:54:40", "text": "無料で手に入れたばかりなので、その範囲内です。"}, {"type": "subtitle", "time": 17682.948, "timestamp": "04:54:42", "text": "そうそう。うん。私もそうしたかった"}, {"type": "subtitle", "time": 17686.15, "timestamp": "04:54:46", "text": "『サイコブレイク』をプレイする。それは可能です。うん。"}, {"type": "subtitle", "time": 17688.628, "timestamp": "04:54:48", "text": "それをただ買うのではなく、"}, {"type": "subtitle", "time": 17690.55, "timestamp": "04:54:50", "text": "何をすべきか、"}, {"type": "subtitle", "time": 17692.628, "timestamp": "04:54:52", "text": "何か。無料でプレイできます"}, {"type": "subtitle", "time": 17695.51, "timestamp": "04:54:55", "text": "ゲーム、そして私はそれをプレイします、そしてあなたも"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "それに対して反応するだろう。どうですか？"}]
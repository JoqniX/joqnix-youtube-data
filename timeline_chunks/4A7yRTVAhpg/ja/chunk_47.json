[{"type": "subtitle", "time": 2824.88, "timestamp": "00:47:04", "text": "待って。もっと多くの人が来るだろう。ああ、"}, {"type": "subtitle", "time": 2833.79, "timestamp": "00:47:13", "text": "神。直後に彼の飛行機を離陸させてください。"}, {"type": "subtitle", "time": 2846.79, "timestamp": "00:47:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2850.23, "timestamp": "00:47:30", "text": "それらを入手してください。それらを入手してください。"}, {"type": "subtitle", "time": 2852.34, "timestamp": "00:47:32", "text": "レタス。"}, {"type": "subtitle", "time": 2854.47, "timestamp": "00:47:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2857.91, "timestamp": "00:47:37", "text": "私が持っています。"}, {"type": "subtitle", "time": 2859.589, "timestamp": "00:47:39", "text": "お皿がまだ必要です。一番良いと思う"}, {"type": "subtitle", "time": 2861.51, "timestamp": "00:47:41", "text": "言い換えれば。"}, {"type": "subtitle", "time": 2863.15, "timestamp": "00:47:43", "text": "よし。わかった。そこにいる"}, {"type": "subtitle", "time": 2865.15, "timestamp": "00:47:45", "text": "行く。"}, {"type": "subtitle", "time": 2866.84, "timestamp": "00:47:46", "text": "私たちは彼らは"}, {"type": "subtitle", "time": 2870.27, "timestamp": "00:47:50", "text": "[音楽]"}, {"type": "subtitle", "time": 2873.81, "timestamp": "00:47:53", "text": "来るよ。私たちはやり遂げた。"}]
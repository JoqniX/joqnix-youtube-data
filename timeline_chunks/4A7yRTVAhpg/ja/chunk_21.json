[{"type": "subtitle", "time": 1260.909, "timestamp": "00:21:00", "text": "待って、私は行く"}, {"type": "subtitle", "time": 1264.669, "timestamp": "00:21:04", "text": "一つを閉じる。閉鎖する"}, {"type": "subtitle", "time": 1268.549, "timestamp": "00:21:08", "text": "1つ。それでは始めましょう。私たちは、あなたは私ができます"}, {"type": "subtitle", "time": 1269.99, "timestamp": "00:21:09", "text": "あなたの鍵が何なのかはわかりませんが、もしあなたが"}, {"type": "subtitle", "time": 1277.27, "timestamp": "00:21:17", "text": "待って、これは何？"}, {"type": "subtitle", "time": 1278.75, "timestamp": "00:21:18", "text": "また？の"}, {"type": "subtitle", "time": 1282.39, "timestamp": "00:21:22", "text": "ダイナー。何てことだ。最初に来た人がいました。"}, {"type": "subtitle", "time": 1294.549, "timestamp": "00:21:34", "text": "何も押せない。ああ、Tだ。"}, {"type": "subtitle", "time": 1303.63, "timestamp": "00:21:43", "text": "わー。何てことだ。"}, {"type": "subtitle", "time": 1306.63, "timestamp": "00:21:46", "text": "乱雑な。彼らはそれを珍しいものにしたくないかもしれない"}, {"type": "subtitle", "time": 1311.11, "timestamp": "00:21:51", "text": "時々。だからレアで焼いてください。"}, {"type": "subtitle", "time": 1313.669, "timestamp": "00:21:53", "text": "それは明らかになるだろう。これは中程度"}, {"type": "chat", "time": 1316.849, "timestamp": "00:21:56", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "this looks like overcooked"}, {"type": "subtitle", "time": 1317.83, "timestamp": "00:21:57", "text": "レア。だから、こちらはもっとたくさん料理できるんです。"}]
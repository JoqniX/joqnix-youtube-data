[{"type": "subtitle", "time": 2886.55, "timestamp": "00:48:06", "text": "[音楽]"}, {"type": "subtitle", "time": 2889.67, "timestamp": "00:48:09", "text": "あなたのモデルはどこへ行ったのですか？何だって？"}, {"type": "subtitle", "time": 2891.43, "timestamp": "00:48:11", "text": "何が起こったのか？"}, {"type": "subtitle", "time": 2895.23, "timestamp": "00:48:15", "text": "N　間違ったボタンを押してしまったようです。"}, {"type": "subtitle", "time": 2900.109, "timestamp": "00:48:20", "text": "ああ、とても素敵です。私たちはまるで動いているようです"}, {"type": "subtitle", "time": 2901.63, "timestamp": "00:48:21", "text": "一緒に。"}, {"type": "subtitle", "time": 2902.829, "timestamp": "00:48:22", "text": "[音楽]"}, {"type": "subtitle", "time": 2905.95, "timestamp": "00:48:25", "text": "神。ああ、私たちは"}, {"type": "subtitle", "time": 2908.27, "timestamp": "00:48:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2912.47, "timestamp": "00:48:32", "text": "行く。そうそう。資産も掲載できます。"}, {"type": "subtitle", "time": 2915.109, "timestamp": "00:48:35", "text": "あ、待って。"}, {"type": "subtitle", "time": 2917.87, "timestamp": "00:48:37", "text": "君にあげるよ"}, {"type": "subtitle", "time": 2920.15, "timestamp": "00:48:40", "text": "皿。よし。持って行かなければならない"}]
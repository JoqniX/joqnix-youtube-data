[{"type": "subtitle", "time": 16620.949, "timestamp": "04:37:00", "text": "えっと、まあ、最終的には私は"}, {"type": "subtitle", "time": 16623.109, "timestamp": "04:37:03", "text": "Twitchで仕事の配信をしたり、"}, {"type": "subtitle", "time": 16624.709, "timestamp": "04:37:04", "text": "簡単な鋳造作業を行い、"}, {"type": "subtitle", "time": 16627.83, "timestamp": "04:37:07", "text": "すべて。私はなぜだろうと思った"}, {"type": "subtitle", "time": 16629.91, "timestamp": "04:37:09", "text": "私は恐怖を感じません。たった8日間です"}, {"type": "subtitle", "time": 16633.75, "timestamp": "04:37:13", "text": "今はもう行ってしまった。まだ10月だ。"}, {"type": "subtitle", "time": 16637.189, "timestamp": "04:37:17", "text": "ええ、10月だけです。"}, {"type": "subtitle", "time": 16639.83, "timestamp": "04:37:19", "text": "耐えるしかないんだ。それでおしまい。"}, {"type": "subtitle", "time": 16641.83, "timestamp": "04:37:21", "text": "うん。"}, {"type": "subtitle", "time": 16650.869, "timestamp": "04:37:30", "text": "なぜか分からないけど、今朝は"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "Parasocialをプレイしたとき、私はとても"}, {"type": "subtitle", "time": 16658.39, "timestamp": "04:37:38", "text": "怖がった。私はとても感じていました"}, {"type": "subtitle", "time": 16660.99, "timestamp": "04:37:40", "text": "ストレスというよりは、えーっと"}, {"type": "subtitle", "time": 16662.949, "timestamp": "04:37:42", "text": "不快感や何か"}, {"type": "subtitle", "time": 16665.67, "timestamp": "04:37:45", "text": "呼吸が苦しい、または"}, {"type": "subtitle", "time": 16669.269, "timestamp": "04:37:49", "text": "パソコンから発せられる熱が体に伝わる"}, {"type": "subtitle", "time": 16672.23, "timestamp": "04:37:52", "text": "あれ。うん。うん。熱中症または"}, {"type": "subtitle", "time": 16675.83, "timestamp": "04:37:55", "text": "何か。うん。私もそう感じていました。"}, {"type": "subtitle", "time": 16678.349, "timestamp": "04:37:58", "text": "えーと、あなたは"}]
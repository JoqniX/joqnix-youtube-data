[{"type": "subtitle", "time": 17220.39, "timestamp": "04:47:00", "text": "神話は病気になった。うん。"}, {"type": "subtitle", "time": 17223.35, "timestamp": "04:47:03", "text": "うん。しかも、もう遅い時間だった。今はこう思っています"}, {"type": "subtitle", "time": 17225.43, "timestamp": "04:47:05", "text": "また、あなたがそうするときも疑問に思います"}, {"type": "subtitle", "time": 17228.55, "timestamp": "04:47:08", "text": "夜の小川、そう、私たちのほとんどが"}, {"type": "subtitle", "time": 17231.75, "timestamp": "04:47:11", "text": "すごく疲れるだろうね。うん。"}, {"type": "subtitle", "time": 17234.15, "timestamp": "04:47:14", "text": "うん。私も同じ経験をしました。責めることはできない"}, {"type": "subtitle", "time": 17235.86, "timestamp": "04:47:15", "text": "しかし彼女はそうだった。"}, {"type": "subtitle", "time": 17237.35, "timestamp": "04:47:17", "text": "[音楽]"}, {"type": "subtitle", "time": 17245.19, "timestamp": "04:47:25", "text": "私は疲れをスキップして実際に"}, {"type": "subtitle", "time": 17247.35, "timestamp": "04:47:27", "text": "入浴して頭を"}, {"type": "subtitle", "time": 17250.03, "timestamp": "04:47:30", "text": "数人分のバケツ"}, {"type": "subtitle", "time": 17253.43, "timestamp": "04:47:33", "text": "分。申し訳ない。溺死した"}, {"type": "subtitle", "time": 17257.19, "timestamp": "04:47:37", "text": "あなた自身。大丈夫です。何てことだ。のように"}, {"type": "subtitle", "time": 17259.99, "timestamp": "04:47:39", "text": "うん。ただし、頻繁にやるのは避けてください。"}, {"type": "subtitle", "time": 17262.03, "timestamp": "04:47:42", "text": "いいえ、いいえ、"}, {"type": "subtitle", "time": 17265.59, "timestamp": "04:47:45", "text": "いいえ。例えば、浴槽みたいなものだったら、"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "よし、それは良いことだ。しかし、それは"}, {"type": "subtitle", "time": 17270.788, "timestamp": "04:47:50", "text": "浴槽みたいなものではなく、"}, {"type": "subtitle", "time": 17276.15, "timestamp": "04:47:56", "text": "だから、狭い場所に物を置くのが好きなんですね"}]
[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "木。動作が遅いですか？セレスト。エマ、"}, {"type": "subtitle", "time": 183.11, "timestamp": "00:03:03", "text": "それはトカゲです。"}, {"type": "subtitle", "time": 185.03, "timestamp": "00:03:05", "text": "つまり、グリッチが発生しているなら、"}, {"type": "subtitle", "time": 186.869, "timestamp": "00:03:06", "text": "待って、Celesteがラグってる？"}, {"type": "subtitle", "time": 188.63, "timestamp": "00:03:08", "text": "とんでもない。"}, {"type": "subtitle", "time": 190.309, "timestamp": "00:03:10", "text": "はるか遠くから。どうすれば入手できますか"}, {"type": "subtitle", "time": 193.11, "timestamp": "00:03:13", "text": "私の斧は？セレストについては何も言えません。"}, {"type": "subtitle", "time": 194.71, "timestamp": "00:03:14", "text": "ああ、でも人食い族は間違いなく"}, {"type": "subtitle", "time": 197.82999999999998, "timestamp": "00:03:17", "text": "遅れている。何を期待してるんだ？の"}, {"type": "subtitle", "time": 206.309, "timestamp": "00:03:26", "text": "うん。セレスト。はい、承知いたしました。新しい"}, {"type": "subtitle", "time": 208.07, "timestamp": "00:03:28", "text": "ロビーは、多くのものと同じように"}, {"type": "subtitle", "time": 209.43, "timestamp": "00:03:29", "text": "正直に言うと、動作が遅い。私は"}, {"type": "subtitle", "time": 212.71, "timestamp": "00:03:32", "text": "ウサギをハッキングしたら、消えてしまった。"}, {"type": "subtitle", "time": 215.19, "timestamp": "00:03:35", "text": "つまり、それはあなたのウサギやあなたの"}, {"type": "subtitle", "time": 218.71, "timestamp": "00:03:38", "text": "斧。その場合、私たちは"}, {"type": "subtitle", "time": 220.55, "timestamp": "00:03:40", "text": "あれを見てください。私たちは行く予定ですか？"}, {"type": "subtitle", "time": 222.22899999999998, "timestamp": "00:03:42", "text": "私は反対側にいるようなものだ"}, {"type": "subtitle", "time": 226.149, "timestamp": "00:03:46", "text": "世界？はい。"}, {"type": "subtitle", "time": 227.75, "timestamp": "00:03:47", "text": "あなたは隔離されている。それでは、"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "それを受け入れるしかない。ごめんなさい。"}, {"type": "subtitle", "time": 232.39, "timestamp": "00:03:52", "text": "例えば、まずは"}, {"type": "subtitle", "time": 233.82999999999998, "timestamp": "00:03:53", "text": "別のサーバー、なぜならすべてが"}, {"type": "subtitle", "time": 235.91, "timestamp": "00:03:55", "text": "遅れている。進行状況を保存して"}, {"type": "subtitle", "time": 238.07, "timestamp": "00:03:58", "text": "別のサーバーに転送するかどうか。"}]
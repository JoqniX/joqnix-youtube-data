[{"type": "subtitle", "time": 7391.109, "timestamp": "02:03:11", "text": "人生って本当に複雑だ。何てことだ。わかった、"}, {"type": "subtitle", "time": 7399.03, "timestamp": "02:03:19", "text": "それから。よし、あと1つ必要だ。はい、"}, {"type": "subtitle", "time": 7401.229, "timestamp": "02:03:21", "text": "わかった。練習を終えましょう"}, {"type": "subtitle", "time": 7403.91, "timestamp": "02:03:23", "text": "モード。つまり、やり直さなければならない"}, {"type": "subtitle", "time": 7407.189, "timestamp": "02:03:27", "text": "全体。うん。"}, {"type": "subtitle", "time": 7409.669, "timestamp": "02:03:29", "text": "ああ、机を叩きつけてしまいそうだ。私は後悔しています"}, {"type": "subtitle", "time": 7415.85, "timestamp": "02:03:35", "text": "餃子。大丈夫。いいえ"}, {"type": "subtitle", "time": 7418.109, "timestamp": "02:03:38", "text": "[音楽]"}, {"type": "subtitle", "time": 7424.27, "timestamp": "02:03:44", "text": "ボブ、それは"}, {"type": "subtitle", "time": 7428.59, "timestamp": "02:03:48", "text": "わかった。いや、これはここにあるべきだ。"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "[音楽]"}, {"type": "subtitle", "time": 7434.79, "timestamp": "02:03:54", "text": "うん、できるよ。私もできます"}]
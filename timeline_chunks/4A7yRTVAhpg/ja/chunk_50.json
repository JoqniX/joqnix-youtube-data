[{"type": "subtitle", "time": 3004.829, "timestamp": "00:50:04", "text": "シンク。日帰りアップグレードをするべきでしょうか？"}, {"type": "subtitle", "time": 3009.27, "timestamp": "00:50:09", "text": "私たちのテーブルは？ああ、沈むべきだ。シンク。"}, {"type": "subtitle", "time": 3012.39, "timestamp": "00:50:12", "text": "ああ、沈むね。シンク。うん。"}, {"type": "subtitle", "time": 3015.349, "timestamp": "00:50:15", "text": "では、待ってください。これは食器洗い機ではありません。"}, {"type": "subtitle", "time": 3018.19, "timestamp": "00:50:18", "text": "そうではありません。ただのシンクだよ。"}, {"type": "subtitle", "time": 3022.99, "timestamp": "00:50:22", "text": "あ、待って。私たちは始めることができます"}, {"type": "subtitle", "time": 3027.99, "timestamp": "00:50:27", "text": "日。いいえ。あなたは何を手に入れましたか？"}, {"type": "subtitle", "time": 3030.99, "timestamp": "00:50:30", "text": "まずは私たちが始めなければなりません。"}, {"type": "subtitle", "time": 3039.069, "timestamp": "00:50:39", "text": "食洗機だと思う。皿。皿。"}, {"type": "subtitle", "time": 3041.91, "timestamp": "00:50:41", "text": "食器洗い機。食器洗い機。"}, {"type": "subtitle", "time": 3043.86, "timestamp": "00:50:43", "text": "わーい。"}, {"type": "subtitle", "time": 3046.589, "timestamp": "00:50:46", "text": "[音楽]"}, {"type": "subtitle", "time": 3059.97, "timestamp": "00:50:59", "text": "後で私の"}]
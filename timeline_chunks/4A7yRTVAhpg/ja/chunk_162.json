[{"type": "subtitle", "time": 9726.99, "timestamp": "02:42:06", "text": "あなたは死ぬ。あなたは死ぬ。あなたは死ぬ。あなたは死ぬ。あなた"}, {"type": "subtitle", "time": 9731.389, "timestamp": "02:42:11", "text": "[音楽]"}, {"type": "subtitle", "time": 9744.52, "timestamp": "02:42:24", "text": "あれ、焼き加減が足りなかったのかな？"}, {"type": "subtitle", "time": 9746.71, "timestamp": "02:42:26", "text": "[音楽]"}, {"type": "subtitle", "time": 9748.55, "timestamp": "02:42:28", "text": "あ、待って。その通りです。それぞれが"}, {"type": "subtitle", "time": 9753.349, "timestamp": "02:42:33", "text": "1つ。ああ、しまった。えっと。ああ、くそ。ああ、くそ。"}, {"type": "subtitle", "time": 9756.89, "timestamp": "02:42:36", "text": "私は大きな間違いを犯した。"}, {"type": "subtitle", "time": 9764.59, "timestamp": "02:42:44", "text": "[音楽]"}, {"type": "subtitle", "time": 9770.95, "timestamp": "02:42:50", "text": "おっと。ああ。いや。ああ、なんてことだ。しかたがない、"}, {"type": "subtitle", "time": 9773.27, "timestamp": "02:42:53", "text": "ごめんなさい。彼らが起こしたスキャンダルとは何ですか？"}, {"type": "subtitle", "time": 9776.469, "timestamp": "02:42:56", "text": "すでに作っているのですか？"}]
[{"type": "subtitle", "time": 14041.269, "timestamp": "03:54:01", "text": "我々を狩る。そんなことはしないでください。まだ。ない"}, {"type": "subtitle", "time": 14043.67, "timestamp": "03:54:03", "text": "まだ。えっと、ヴィック、卵はありますか？"}, {"type": "subtitle", "time": 14048.389, "timestamp": "03:54:08", "text": "あなた？いいえ。私はモデルのような存在です。ええ、見つけました"}, {"type": "subtitle", "time": 14051.189, "timestamp": "03:54:11", "text": "地面にもう一つ卵が落ちていた。はい、私は"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "いいですか？ わかりました、あのね？大丈夫。"}, {"type": "subtitle", "time": 14058.229, "timestamp": "03:54:18", "text": "ここのことは忘れてください。わかった、"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "Zを死に至らしめるには、どれくらいの紫外線が必要ですか？"}, {"type": "subtitle", "time": 14068.469, "timestamp": "03:54:28", "text": "悪魔の蜘蛛みたいなやつ？おお。わからない"}, {"type": "subtitle", "time": 14075.99, "timestamp": "03:54:35", "text": "うん。 50 のような感じではない"}, {"type": "subtitle", "time": 14079.429, "timestamp": "03:54:39", "text": "60. 待って、私はIを持っています。いいえ。ええと、"}, {"type": "subtitle", "time": 14081.75, "timestamp": "03:54:41", "text": "私の画面に表示されています。まるで私が"}, {"type": "subtitle", "time": 14086.469, "timestamp": "03:54:46", "text": "近いとか、そんな感じ。ああ、私は隠れている。"}, {"type": "subtitle", "time": 14089.229, "timestamp": "03:54:49", "text": "ここは隠れ場所だ。わかった。おお、"}, {"type": "subtitle", "time": 14091.67, "timestamp": "03:54:51", "text": "うん。このゲームには何が含まれていますか？でもできない"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "あまり長く隠れていると、"}, {"type": "subtitle", "time": 14098.71, "timestamp": "03:54:58", "text": "あなたを見つけ出すでしょう。彼女はあなたを殺すでしょう。はい。"}]
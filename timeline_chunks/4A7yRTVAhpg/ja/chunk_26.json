[{"type": "subtitle", "time": 1562.549, "timestamp": "00:26:02", "text": "火を通しすぎる。あなた"}, {"type": "subtitle", "time": 1565.51, "timestamp": "00:26:05", "text": "了解しました。大丈夫、できるよ。"}, {"type": "subtitle", "time": 1569.35, "timestamp": "00:26:09", "text": "大丈夫、できるよ。うまくいけば。"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "まだ交流しないでください。わかった。えっと、それは"}, {"type": "subtitle", "time": 1575.11, "timestamp": "00:26:15", "text": "わかった。大丈夫。大丈夫。そこには"}, {"type": "subtitle", "time": 1579.7, "timestamp": "00:26:19", "text": "時間。レア1個、ミディアム1個。"}, {"type": "subtitle", "time": 1595.63, "timestamp": "00:26:35", "text": "[音楽]"}, {"type": "subtitle", "time": 1597.95, "timestamp": "00:26:37", "text": "ああ、よくやった。"}, {"type": "subtitle", "time": 1601.39, "timestamp": "00:26:41", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 1605.59, "timestamp": "00:26:45", "text": "これ。これを買って、あれをやります。感謝"}, {"type": "subtitle", "time": 1607.3, "timestamp": "00:26:47", "text": "お皿をどうぞ。"}, {"type": "subtitle", "time": 1618.59, "timestamp": "00:26:58", "text": "ああ、売るよ"}]
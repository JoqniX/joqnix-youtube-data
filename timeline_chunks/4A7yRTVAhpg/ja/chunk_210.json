[{"type": "subtitle", "time": 12603.83, "timestamp": "03:30:03", "text": "どこにいるの？私は外にいます"}, {"type": "subtitle", "time": 12617.19, "timestamp": "03:30:17", "text": "あのね？私は"}, {"type": "subtitle", "time": 12619.55, "timestamp": "03:30:19", "text": "入り口。入るぞ。動くな。"}, {"type": "subtitle", "time": 12621.99, "timestamp": "03:30:21", "text": "鍵。よし。はい、どうぞ。さあ、始めよう"}, {"type": "subtitle", "time": 12624.63, "timestamp": "03:30:24", "text": "後退してください。あなたは勝っていますか？おお、"}, {"type": "subtitle", "time": 12626.71, "timestamp": "03:30:26", "text": "ええと、ヤギを３頭仕留めました。また、"}, {"type": "subtitle", "time": 12628.15, "timestamp": "03:30:28", "text": "ストリームへようこそ、ゼナさん。元気ですか"}, {"type": "subtitle", "time": 12630.469, "timestamp": "03:30:30", "text": "今日は何をしますか？"}, {"type": "subtitle", "time": 12633.59, "timestamp": "03:30:33", "text": "さあ行こう。干し草が必要です。"}, {"type": "subtitle", "time": 12637.71, "timestamp": "03:30:37", "text": "何てことだ。なぜ私たちは、短い干し草のようなものなのだろうか？おお"}, {"type": "subtitle", "time": 12641.59, "timestamp": "03:30:41", "text": "いいえ。おっと。リフトを降ろすだけです"}, {"type": "subtitle", "time": 12656.309, "timestamp": "03:30:56", "text": "ヤギ。 Goが買収されました。戻って"}, {"type": "subtitle", "time": 12659.91, "timestamp": "03:30:59", "text": "召喚装置を起動する。えっと、"}]
[{"type": "subtitle", "time": 10861.429, "timestamp": "03:01:01", "text": "人生。見捨てられ、裏切られ、朽ち果てるまま放置された"}, {"type": "subtitle", "time": 10867.19, "timestamp": "03:01:07", "text": "そして死ぬ。自分のことは自分でやる。うん。しかし"}, {"type": "subtitle", "time": 10871.19, "timestamp": "03:01:11", "text": "私たちは大丈夫です。私も参加しようと思います。"}, {"type": "subtitle", "time": 10875.11, "timestamp": "03:01:15", "text": "あなたが持っているジューシーなものをください。"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "vに従うことを覚えていますか？"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "ガイドライン？待って。わかった。そして今私は"}, {"type": "subtitle", "time": 10885.59, "timestamp": "03:01:25", "text": "それ。わーい。従うことを忘れていませんか？"}, {"type": "subtitle", "time": 10888.63, "timestamp": "03:01:28", "text": "ガイドライン？ジョー。すべて保管してください。保つ"}, {"type": "subtitle", "time": 10891.349, "timestamp": "03:01:31", "text": "すべて。君のジョークだよ。またね。あなた"}, {"type": "subtitle", "time": 10893.429, "timestamp": "03:01:33", "text": "ゲームのルールを理解する。"}, {"type": "subtitle", "time": 10898.67, "timestamp": "03:01:38", "text": "うん。なぜ？なぜマイクがオンになっているのですか？"}, {"type": "subtitle", "time": 10902.15, "timestamp": "03:01:42", "text": "わかった。応答がありません。"}, {"type": "subtitle", "time": 10906.07, "timestamp": "03:01:46", "text": "冗談じゃないよ。"}, {"type": "subtitle", "time": 10908.469, "timestamp": "03:01:48", "text": "私は自分が既に赤毛であることに満足している。感謝"}, {"type": "subtitle", "time": 10912.63, "timestamp": "03:01:52", "text": "あなた。ありがとう。時代の神々。"}, {"type": "subtitle", "time": 10914.15, "timestamp": "03:01:54", "text": "ああ、君は"}, {"type": "subtitle", "time": 10917.51, "timestamp": "03:01:57", "text": "コメディアンのモリー。"}, {"type": "subtitle", "time": 10919.67, "timestamp": "03:01:59", "text": "あなたは主を見ることができます"}]
[{"type": "subtitle", "time": 1202.39, "timestamp": "00:20:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1204.95, "timestamp": "00:20:04", "text": "私たちがコラボレーションするのは今回が初めてだと思います。"}, {"type": "subtitle", "time": 1208.48, "timestamp": "00:20:08", "text": "正しくはこうですよね？うん。"}, {"type": "subtitle", "time": 1237.75, "timestamp": "00:20:37", "text": "だから、洗濯場を設置しなければならない"}, {"type": "subtitle", "time": 1239.43, "timestamp": "00:20:39", "text": "ここ"}, {"type": "subtitle", "time": 1241.75, "timestamp": "00:20:41", "text": "食器を集める方が簡単だから"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "そしてここで洗ってください。だって、もし入ったら、"}, {"type": "subtitle", "time": 1250.07, "timestamp": "00:20:50", "text": "本当にイライラする。"}, {"type": "subtitle", "time": 1252.549, "timestamp": "00:20:52", "text": "だから、ああ、料理して、それから"}, {"type": "subtitle", "time": 1254.39, "timestamp": "00:20:54", "text": "ここに置いて、お皿を置いて"}, {"type": "subtitle", "time": 1258.71, "timestamp": "00:20:58", "text": "それから、あれこれ。信じられない。"}]
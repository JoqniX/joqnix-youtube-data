[{"type": "subtitle", "time": 2465.19, "timestamp": "00:41:05", "text": "待ってください、そこで皿をお出しします、"}, {"type": "subtitle", "time": 2467.51, "timestamp": "00:41:07", "text": "右？おお。そうそう。入手先は"}, {"type": "subtitle", "time": 2472.63, "timestamp": "00:41:12", "text": "側面。ああ、それは賢いですね。"}, {"type": "subtitle", "time": 2474.79, "timestamp": "00:41:14", "text": "男。あなたは全ての戦術を知っている。私はしません"}, {"type": "subtitle", "time": 2483.75, "timestamp": "00:41:23", "text": "すごくかっこいい。とても素敵なものですね。きれい"}, {"type": "subtitle", "time": 2486.95, "timestamp": "00:41:26", "text": "コツさえ掴めば簡単だよ。私は"}, {"type": "subtitle", "time": 2488.91, "timestamp": "00:41:28", "text": "自分を閉じ込める"}, {"type": "subtitle", "time": 2493.63, "timestamp": "00:41:33", "text": "ここ。そして、これが私の料理方法です。"}, {"type": "subtitle", "time": 2498.39, "timestamp": "00:41:38", "text": "ああ、キャベツ。チョップ。チョップ。チョップ。"}, {"type": "subtitle", "time": 2500.95, "timestamp": "00:41:40", "text": "そして、チョッピーな動きをしたい"}]
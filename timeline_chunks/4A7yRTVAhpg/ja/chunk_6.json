[{"type": "subtitle", "time": 360.79, "timestamp": "00:06:00", "text": "独創的であってほしいが、私は"}, {"type": "subtitle", "time": 362.629, "timestamp": "00:06:02", "text": "それ。皆さん、ありがとうございました。私は自分の"}, {"type": "subtitle", "time": 365.99, "timestamp": "00:06:05", "text": "コカ・コーラゼロをあなたの"}, {"type": "subtitle", "time": 369.189, "timestamp": "00:06:09", "text": "それってちょっとゲイっぽいよね。なぜ？さあ、みんな行こう。"}, {"type": "subtitle", "time": 371.35, "timestamp": "00:06:11", "text": "ええ、そうですね。少なくともカロリーはゼロ。"}, {"type": "subtitle", "time": 375.67, "timestamp": "00:06:15", "text": "さあ行こう。さあ、行こうぜ、みんな。"}, {"type": "subtitle", "time": 376.67, "timestamp": "00:06:16", "text": "私たちの"}, {"type": "subtitle", "time": 379.79, "timestamp": "00:06:19", "text": "ホストゼロ"}, {"type": "subtitle", "time": 382.87, "timestamp": "00:06:22", "text": "セレスティア・ヴォイドによるカロリー。彼女は私たちの"}, {"type": "subtitle", "time": 387.43, "timestamp": "00:06:27", "text": "真のリーダー。はい。本当に本当に。本物の銀行。"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "うん。えっと、司会者は誰だったの？"}, {"type": "subtitle", "time": 390.95, "timestamp": "00:06:30", "text": "推測？本物の森。これは2番目ですか"}, {"type": "subtitle", "time": 392.55, "timestamp": "00:06:32", "text": "新婚旅行？それともまだ初婚？"}, {"type": "subtitle", "time": 395.029, "timestamp": "00:06:35", "text": "ハネムーン？うわぁ。ロビーの子供を"}, {"type": "subtitle", "time": 398.029, "timestamp": "00:06:38", "text": "私の腕。 Eハネムーンプロマックス、"}, {"type": "subtitle", "time": 408.629, "timestamp": "00:06:48", "text": "子供だよ。子供は一人も見当たらない。どのように"}, {"type": "subtitle", "time": 410.23, "timestamp": "00:06:50", "text": "くそ？まず第一に、"}, {"type": "subtitle", "time": 411.749, "timestamp": "00:06:51", "text": "皆さん、これは新婚旅行ですよね？どうやって"}, {"type": "subtitle", "time": 413.189, "timestamp": "00:06:53", "text": "お前は子供を産む前に"}, {"type": "subtitle", "time": 415.11, "timestamp": "00:06:55", "text": "ハネムーン？"}, {"type": "subtitle", "time": 417.43, "timestamp": "00:06:57", "text": "わかった、養子になるよ。わかった。なぜ私たちは"}, {"type": "subtitle", "time": 419.67, "timestamp": "00:06:59", "text": "全員同じ席に？"}]
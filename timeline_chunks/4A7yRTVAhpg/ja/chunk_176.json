[{"type": "subtitle", "time": 10561.91, "timestamp": "02:56:01", "text": "知っておく"}, {"type": "subtitle", "time": 10565.67, "timestamp": "02:56:05", "text": "ああ、すごく疲れた。もっと睡眠が必要だ"}, {"type": "subtitle", "time": 10568.79, "timestamp": "02:56:08", "text": "正直に言ってください。睡眠をとることはできますが、"}, {"type": "subtitle", "time": 10579.429, "timestamp": "02:56:19", "text": "わかった。ジャックの声はちゃんと聞こえるよ。ニース。"}, {"type": "subtitle", "time": 10582.309, "timestamp": "02:56:22", "text": "ニース。ジャックの声が聞こえる。"}, {"type": "subtitle", "time": 10584.309, "timestamp": "02:56:24", "text": "皆さん、私の声が聞こえますよね、それは素晴らしい"}, {"type": "subtitle", "time": 10587.83, "timestamp": "02:56:27", "text": "いいね。自分の配信をチェックしておくべきだった"}, {"type": "subtitle", "time": 10595.03, "timestamp": "02:56:35", "text": "君たちといるとすごく楽しいよ。私"}, {"type": "subtitle", "time": 10597.75, "timestamp": "02:56:37", "text": "確認するのを忘れていました。では、確認してみます。"}, {"type": "subtitle", "time": 10600.23, "timestamp": "02:56:40", "text": "すべて。だから、音量をしっかり調整します"}, {"type": "subtitle", "time": 10610.11, "timestamp": "02:56:50", "text": "[音楽]"}, {"type": "subtitle", "time": 10613.55, "timestamp": "02:56:53", "text": "まあ、そういうことだ。うん。えっと、どこ"}]
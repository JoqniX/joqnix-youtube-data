[{"type": "subtitle", "time": 15120.91, "timestamp": "04:12:00", "text": "側？ああ、まだそこにいるよ。それは それは"}, {"type": "subtitle", "time": 15123.389, "timestamp": "04:12:03", "text": "大丈夫。まるで誰も見ていないかのように。"}, {"type": "subtitle", "time": 15131.349, "timestamp": "04:12:11", "text": "うん。わからない。イエス・キリスト。迅速"}, {"type": "subtitle", "time": 15134.229, "timestamp": "04:12:14", "text": "遊ぶ。神。ああ、あなたはそれをしたいのですね"}, {"type": "subtitle", "time": 15137.59, "timestamp": "04:12:17", "text": "マッチ？そうそう。ああ、チームデスマッチか。"}, {"type": "subtitle", "time": 15139.59, "timestamp": "04:12:19", "text": "ああ、そうだね。デッドマッチまたはチーム"}, {"type": "subtitle", "time": 15141.51, "timestamp": "04:12:21", "text": "何でも。何でもやってみよう。チーム チーム"}, {"type": "subtitle", "time": 15142.99, "timestamp": "04:12:22", "text": "デスマッチ。チーム"}, {"type": "subtitle", "time": 15145.67, "timestamp": "04:12:25", "text": "デスマッチ。これは楽しいですね。さらに、"}, {"type": "subtitle", "time": 15147.429, "timestamp": "04:12:27", "text": "この場所からは進歩が得られる。うん、"}, {"type": "subtitle", "time": 15149.83, "timestamp": "04:12:29", "text": "チームデスマッチは最高だ。それはたくさん"}, {"type": "subtitle", "time": 15151.429, "timestamp": "04:12:31", "text": "プレイをやめた私の知っている人たち"}, {"type": "subtitle", "time": 15158.469, "timestamp": "04:12:38", "text": "うん、チームディフェンスは良いね。わからない"}]
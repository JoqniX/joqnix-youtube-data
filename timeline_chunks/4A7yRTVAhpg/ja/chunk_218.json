[{"type": "subtitle", "time": 13080.67, "timestamp": "03:38:00", "text": "投稿"}, {"type": "subtitle", "time": 13083.83, "timestamp": "03:38:03", "text": "ゲームに最適な地域。君たちが望むように"}, {"type": "subtitle", "time": 13085.67, "timestamp": "03:38:05", "text": "アジアや最高の地域など"}, {"type": "subtitle", "time": 13088.03, "timestamp": "03:38:08", "text": "何か？"}, {"type": "subtitle", "time": 13091.429, "timestamp": "03:38:11", "text": "何でも。アジア。 pingが300くらいだったのを見た"}, {"type": "subtitle", "time": 13094.389, "timestamp": "03:38:14", "text": "なぜか分からないけど、私はそうだった。"}, {"type": "subtitle", "time": 13096.55, "timestamp": "03:38:16", "text": "インド。ああ、まるで、まるで"}, {"type": "subtitle", "time": 13105.11, "timestamp": "03:38:25", "text": "実際にはインド地域です。わからない。私"}, {"type": "subtitle", "time": 13106.469, "timestamp": "03:38:26", "text": "何が違うのか分からない"}, {"type": "subtitle", "time": 13107.71, "timestamp": "03:38:27", "text": "やろうと思っている。私はしません"}, {"type": "subtitle", "time": 13116.67, "timestamp": "03:38:36", "text": "H."}, {"type": "subtitle", "time": 13121.75, "timestamp": "03:38:41", "text": "おお。おお。おお。おお。ハッシュがここにいる。ああ、"}, {"type": "subtitle", "time": 13137.75, "timestamp": "03:38:57", "text": "どうしたの？"}, {"type": "subtitle", "time": 13139.91, "timestamp": "03:38:59", "text": "何？聞こえますか？ミュートしませんでした。おお、"}]
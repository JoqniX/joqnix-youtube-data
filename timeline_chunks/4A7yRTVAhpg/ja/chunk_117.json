[{"type": "subtitle", "time": 7029.709, "timestamp": "01:57:09", "text": "もの。"}, {"type": "subtitle", "time": 7033.35, "timestamp": "01:57:13", "text": "あ、待って。ここに置いておきます。次に同期します。"}, {"type": "subtitle", "time": 7036.55, "timestamp": "01:57:16", "text": "ここに置いておくので、ご自由にお使いください。"}, {"type": "subtitle", "time": 7050.589, "timestamp": "01:57:30", "text": "うん。これです。いいえ、こちらです。いいえ。何ですか？"}, {"type": "subtitle", "time": 7054.109, "timestamp": "01:57:34", "text": "何？何でも。それ"}, {"type": "subtitle", "time": 7065.55, "timestamp": "01:57:45", "text": "ああ、こんにちは、アリサ。いらっしゃいませ"}]
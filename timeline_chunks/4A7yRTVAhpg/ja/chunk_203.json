[{"type": "subtitle", "time": 12181.59, "timestamp": "03:23:01", "text": "うん。どれくらいできるか見てみましょう。私は"}, {"type": "subtitle", "time": 12184.15, "timestamp": "03:23:04", "text": "かなり疲れた。そしてシーモアは"}, {"type": "subtitle", "time": 12185.51, "timestamp": "03:23:05", "text": "私たちに加わって、どれくらい続くか見てみましょう"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "えっと、正直に言うと、動きを感じています"}, {"type": "subtitle", "time": 12224.79, "timestamp": "03:23:44", "text": "[音楽]"}, {"type": "subtitle", "time": 12226.71, "timestamp": "03:23:46", "text": "よし、大丈夫だと思う。そうするべきです。"}, {"type": "subtitle", "time": 12228.55, "timestamp": "03:23:48", "text": "大丈夫だよ。ああ、ちょっと待ってください。私はします"}, {"type": "subtitle", "time": 12230.229, "timestamp": "03:23:50", "text": "ただぶらぶらする代わりに"}, {"type": "subtitle", "time": 12233.19, "timestamp": "03:23:53", "text": "目的もなく、ジョックに教えることができる"}, {"type": "subtitle", "time": 12235.229, "timestamp": "03:23:55", "text": "これ。ジョック、おいで"}, {"type": "subtitle", "time": 12238.389, "timestamp": "03:23:58", "text": "階下。私は階下の神様の近くにいます"}]
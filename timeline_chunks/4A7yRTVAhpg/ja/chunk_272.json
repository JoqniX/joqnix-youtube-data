[{"type": "subtitle", "time": 16320.349, "timestamp": "04:32:00", "text": "何か落ち着いた曲をかけてください。"}, {"type": "subtitle", "time": 16324.07, "timestamp": "04:32:04", "text": "ああ、いつかきっとできるよ。ええ、私たちは"}, {"type": "subtitle", "time": 16326.229, "timestamp": "04:32:06", "text": "次のようなチルストリームを行うことができます"}, {"type": "subtitle", "time": 16328.229, "timestamp": "04:32:08", "text": "1週間くらいかな。"}, {"type": "subtitle", "time": 16329.75, "timestamp": "04:32:09", "text": "ああ、いつやりたいですか？私はしていません"}, {"type": "subtitle", "time": 16331.429, "timestamp": "04:32:11", "text": "まだスケジュールは組んでない。はい、私は"}, {"type": "subtitle", "time": 16335.11, "timestamp": "04:32:15", "text": "文字通り、じゃあ源珍みたいにやってみよう"}, {"type": "subtitle", "time": 16336.71, "timestamp": "04:32:16", "text": "のように"}, {"type": "subtitle", "time": 16338.55, "timestamp": "04:32:18", "text": "うん、いろいろと追いついて、"}, {"type": "subtitle", "time": 16379.59, "timestamp": "04:32:59", "text": "はぁ。まあ、いいでしょう。誰かが話したがった"}]
[{"type": "subtitle", "time": 11042.83, "timestamp": "03:04:02", "text": "なぜこのゲームはこんなに動きが多いのか"}, {"type": "subtitle", "time": 11045.19, "timestamp": "03:04:05", "text": "特典？つまり、私たちは走っていて、"}, {"type": "subtitle", "time": 11046.79, "timestamp": "03:04:06", "text": "逃走中。"}, {"type": "subtitle", "time": 11049.19, "timestamp": "03:04:09", "text": "はい。つまり、私たちは"}, {"type": "subtitle", "time": 11053.03, "timestamp": "03:04:13", "text": "悪魔。うん。ああ、わかりました。私は、"}, {"type": "subtitle", "time": 11055.429, "timestamp": "03:04:15", "text": "私にはお金がありません。"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "大丈夫です。あなたは手に入れるでしょう あなたは手に入れるでしょう"}, {"type": "subtitle", "time": 11059.269, "timestamp": "03:04:19", "text": "あなたが遊び好きなとき。あのね？私 私"}, {"type": "subtitle", "time": 11061.59, "timestamp": "03:04:21", "text": "4月になります。私は、私は"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "4月。私は老人役を演じる。"}, {"type": "subtitle", "time": 11068.55, "timestamp": "03:04:28", "text": "よし、君のお尻から始めよう。わかりました、"}, {"type": "subtitle", "time": 11070.63, "timestamp": "03:04:30", "text": "ジャックはこれが初めてなので、"}, {"type": "subtitle", "time": 11073.83, "timestamp": "03:04:33", "text": "まずは農家から始めましょう。"}, {"type": "subtitle", "time": 11076.429, "timestamp": "03:04:36", "text": "わかった。アメリカ合衆国"}, {"type": "subtitle", "time": 11079.429, "timestamp": "03:04:39", "text": "2006年。カリフォルニアのコヨーテバレーは"}, {"type": "subtitle", "time": 11082.71, "timestamp": "03:04:42", "text": "夏の太陽の下で、焼けつくように熱くなる。"}, {"type": "subtitle", "time": 11085.19, "timestamp": "03:04:45", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 11089.03, "timestamp": "03:04:49", "text": "悪魔のリーダー。ザジルの監視者"}, {"type": "subtitle", "time": 11094.55, "timestamp": "03:04:54", "text": "[音楽]"}, {"type": "subtitle", "time": 11096.63, "timestamp": "03:04:56", "text": "アンナは"}]
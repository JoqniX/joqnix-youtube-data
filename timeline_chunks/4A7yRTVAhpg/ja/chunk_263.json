[{"type": "subtitle", "time": 15788.87, "timestamp": "04:23:08", "text": "こんにちは。"}, {"type": "subtitle", "time": 15795.229, "timestamp": "04:23:15", "text": "聞こえますか？えっと、"}, {"type": "subtitle", "time": 15800.07, "timestamp": "04:23:20", "text": "ああ、画面が真っ暗だから死にそうだ"}, {"type": "subtitle", "time": 15807.83, "timestamp": "04:23:27", "text": "はい、まだ頭痛がします。"}, {"type": "subtitle", "time": 15809.429, "timestamp": "04:23:29", "text": "だから私は出発したいし、行くつもりです"}, {"type": "subtitle", "time": 15811.11, "timestamp": "04:23:31", "text": "眠る。"}, {"type": "subtitle", "time": 15814.149, "timestamp": "04:23:34", "text": "よし、君たち二人。本日はありがとうございました。おお、"}, {"type": "subtitle", "time": 15815.83, "timestamp": "04:23:35", "text": "ああ、そうなった。私はここに留まります"}, {"type": "subtitle", "time": 15818.95, "timestamp": "04:23:38", "text": "ああ、それだ。そうそう。ええ、私は"}, {"type": "subtitle", "time": 15820.389, "timestamp": "04:23:40", "text": "今、あなたの声が聞こえます。おやすみ。気をつけて"}, {"type": "subtitle", "time": 15822.79, "timestamp": "04:23:42", "text": "もう一度。申し訳ありません"}, {"type": "subtitle", "time": 15825.03, "timestamp": "04:23:45", "text": "この全て。"}, {"type": "subtitle", "time": 15826.55, "timestamp": "04:23:46", "text": "大丈夫。謝らないでください。その"}, {"type": "subtitle", "time": 15829.59, "timestamp": "04:23:49", "text": "大丈夫。謝罪します。うん、遊べるよ"}, {"type": "subtitle", "time": 15832.71, "timestamp": "04:23:52", "text": "また今度。ああ、ジャックを怖がらせることができる"}, {"type": "subtitle", "time": 15835.63, "timestamp": "04:23:55", "text": "どこか別の場所で。大丈夫です。"}, {"type": "subtitle", "time": 15839.99, "timestamp": "04:23:59", "text": "待って、他に誰も連れて行かないよ"}]
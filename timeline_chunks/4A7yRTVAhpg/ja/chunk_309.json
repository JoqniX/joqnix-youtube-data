[{"type": "subtitle", "time": 18549.708, "timestamp": "05:09:09", "text": "考える"}, {"type": "subtitle", "time": 18552.788, "timestamp": "05:09:12", "text": "ああ、600 Xですね。ええ。うん。それは良いです。"}, {"type": "subtitle", "time": 18554.51, "timestamp": "05:09:14", "text": "それは良いです。私は持っている"}, {"type": "subtitle", "time": 18558.39, "timestamp": "05:09:18", "text": "私のものは何だったっけ？ 30. ええ、持っています"}, {"type": "subtitle", "time": 18560.51, "timestamp": "05:09:20", "text": "3,800"}, {"type": "subtitle", "time": 18564.83, "timestamp": "05:09:24", "text": "X. ちょっと待って、38か36？私"}, {"type": "subtitle", "time": 18569.2, "timestamp": "05:09:29", "text": "忘れた。うん。実際は3,800人です。"}, {"type": "subtitle", "time": 18575.99, "timestamp": "05:09:35", "text": "ああ、ジャック。はい。これで終わりにします。"}, {"type": "subtitle", "time": 18577.39, "timestamp": "05:09:37", "text": "しないで"}, {"type": "subtitle", "time": 18580.59, "timestamp": "05:09:40", "text": "心配。私たちは計画を立てていた"}, {"type": "subtitle", "time": 18584.59, "timestamp": "05:09:44", "text": "週末の出来事。"}, {"type": "subtitle", "time": 18586.75, "timestamp": "05:09:46", "text": "それで、"}, {"type": "subtitle", "time": 18591.19, "timestamp": "05:09:51", "text": "だから、そう、私たちはコラボレーションできなかったんです。ええと、"}, {"type": "subtitle", "time": 18593.99, "timestamp": "05:09:53", "text": "コラボレーションできなかったのは今週だったか、それとも"}, {"type": "subtitle", "time": 18595.99, "timestamp": "05:09:55", "text": "先週？先週のことですよね？先週。"}, {"type": "subtitle", "time": 18599.43, "timestamp": "05:09:59", "text": "うん。うん。チャ。メイクアップできるよ"}]
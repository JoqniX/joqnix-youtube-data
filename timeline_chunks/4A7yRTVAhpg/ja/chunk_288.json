[{"type": "subtitle", "time": 17289.99, "timestamp": "04:48:09", "text": "うん。とにかく、ああ、なんてことだ。わからない"}, {"type": "subtitle", "time": 17293.67, "timestamp": "04:48:13", "text": "今回はどうやって起きていようか。スミ"}, {"type": "subtitle", "time": 17296.67, "timestamp": "04:48:16", "text": "サーバーも同様です"}, {"type": "subtitle", "time": 17299.83, "timestamp": "04:48:19", "text": "満杯。イエス・キリスト。"}, {"type": "subtitle", "time": 17302.27, "timestamp": "04:48:22", "text": "これらの人たちは実際には"}, {"type": "subtitle", "time": 17304.55, "timestamp": "04:48:24", "text": "非常識な。死にそうな気分だ"}, {"type": "subtitle", "time": 17306.868, "timestamp": "04:48:26", "text": "今は、でも、この人たちは「やめて」って感じ"}, {"type": "subtitle", "time": 17311.11, "timestamp": "04:48:31", "text": "死ぬ。うん、疲れてるよ。ああ、私は"}, {"type": "subtitle", "time": 17313.19, "timestamp": "04:48:33", "text": "デビューする必要がある。おいおい、何だよ"}, {"type": "subtitle", "time": 17315.43, "timestamp": "04:48:35", "text": "私は何をすべきですか？はい。いついつ"}, {"type": "subtitle", "time": 17317.99, "timestamp": "04:48:37", "text": "ストライクするつもりですか？どのような？"}, {"type": "subtitle", "time": 17324.39, "timestamp": "04:48:44", "text": "いやいやいや、実際のもの"}, {"type": "subtitle", "time": 17328.07, "timestamp": "04:48:48", "text": "Twitterで盛り上げたり、デビューを応援したりするにはどうすればいいですか？"}, {"type": "subtitle", "time": 17330.55, "timestamp": "04:48:50", "text": "ああ、モデル発表はこうやってできるよ"}, {"type": "subtitle", "time": 17333.55, "timestamp": "04:48:53", "text": "実際に今、それをレビューしています。私はそうは思わない"}, {"type": "subtitle", "time": 17337.03, "timestamp": "04:48:57", "text": "デビュー後、実際のように好きになる"}]
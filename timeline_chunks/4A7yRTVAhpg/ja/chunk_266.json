[{"type": "subtitle", "time": 15964.95, "timestamp": "04:26:04", "text": "彼らは他のチームメイトと同じような"}, {"type": "subtitle", "time": 15968.07, "timestamp": "04:26:08", "text": "それを片付けることもそうですが、"}, {"type": "subtitle", "time": 15970.79, "timestamp": "04:26:10", "text": "あまり効率的ではない。"}, {"type": "subtitle", "time": 15987.389, "timestamp": "04:26:27", "text": "ああ、彼女は"}, {"type": "subtitle", "time": 16018.469, "timestamp": "04:26:58", "text": "いいえ。ああ、なんてことだ、彼らはとても遠く離れています"}]
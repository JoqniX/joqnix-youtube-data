[{"type": "subtitle", "time": 17701.27, "timestamp": "04:55:01", "text": "はい、可能です。うん。うん。ニース。"}, {"type": "subtitle", "time": 17703.43, "timestamp": "04:55:03", "text": "わかった。終わり。取引成立。私たちは"}, {"type": "subtitle", "time": 17708.708, "timestamp": "04:55:08", "text": "プレーへの影響。待って、ベン。えーと、グソンインパクト"}, {"type": "subtitle", "time": 17710.708, "timestamp": "04:55:10", "text": "月曜日になるよ、だってわかるでしょ"}, {"type": "subtitle", "time": 17714.868, "timestamp": "04:55:14", "text": "待って、D2はLAって言ったのかと思ったよ。おお、"}, {"type": "subtitle", "time": 17718.628, "timestamp": "04:55:18", "text": "Alpha D2は水曜日のような感じになるだろう。"}, {"type": "subtitle", "time": 17721.75, "timestamp": "04:55:21", "text": "水曜日。わかった。そして悪は"}, {"type": "subtitle", "time": 17723.83, "timestamp": "04:55:23", "text": "金曜日になる予定です。"}, {"type": "subtitle", "time": 17726.788, "timestamp": "04:55:26", "text": "わかった。月曜日3日。了解。よし。はい。"}, {"type": "subtitle", "time": 17728.39, "timestamp": "04:55:28", "text": "連続してやりたくないから"}, {"type": "subtitle", "time": 17732.788, "timestamp": "04:55:32", "text": "疲れてしまうから。"}, {"type": "subtitle", "time": 17735.19, "timestamp": "04:55:35", "text": "はい。うん。うん。わかった。 3つあります"}, {"type": "subtitle", "time": 17738.31, "timestamp": "04:55:38", "text": "今すぐやるべきこと。ジャック"}, {"type": "subtitle", "time": 17741.35, "timestamp": "04:55:41", "text": "うん。だから、私たちの2人は、待って、1人は"}, {"type": "subtitle", "time": 17744.868, "timestamp": "04:55:44", "text": "えっと、あなたがプレイしているのが、もう片方は私たちです"}, {"type": "subtitle", "time": 17747.19, "timestamp": "04:55:47", "text": "2つのグループを一緒に。もう一人は私です"}, {"type": "subtitle", "time": 17749.43, "timestamp": "04:55:49", "text": "演奏するあなたと、それを見ているあなた。わかった。わかった。"}, {"type": "subtitle", "time": 17752.23, "timestamp": "04:55:52", "text": "わかった。 2つのうちの1つは、"}, {"type": "subtitle", "time": 17754.868, "timestamp": "04:55:54", "text": "2つのうち3つは、私たちが一緒に遊んでいるものです"}, {"type": "subtitle", "time": 17757.27, "timestamp": "04:55:57", "text": "なぜなら、一緒に遊べるから。愛"}, {"type": "subtitle", "time": 17759.91, "timestamp": "04:55:59", "text": "死んだら一緒に遊べるよ、これ"}]
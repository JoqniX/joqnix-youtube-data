[{"type": "subtitle", "time": 15722.389, "timestamp": "04:22:02", "text": "エスカレーション。楽しいゲームです。あるいは、ああ、これ"}, {"type": "subtitle", "time": 15730.469, "timestamp": "04:22:10", "text": "ああ、ボーダーランズですか？グリースペンシル2"}, {"type": "subtitle", "time": 15735.59, "timestamp": "04:22:15", "text": "ええと、2.5D、呼び方は何でもいいですよ。"}, {"type": "subtitle", "time": 15740.07, "timestamp": "04:22:20", "text": "あ、そうそう、ちなみに、"}, {"type": "subtitle", "time": 15741.59, "timestamp": "04:22:21", "text": "もしあなたがプレイすることに興味があるなら"}, {"type": "subtitle", "time": 15744.07, "timestamp": "04:22:24", "text": "シングルプレイヤーゲームのように、Evil Within"}, {"type": "subtitle", "time": 15748.79, "timestamp": "04:22:28", "text": "Epic Gamesで配信中です。どれ？悪"}, {"type": "subtitle", "time": 15752.71, "timestamp": "04:22:32", "text": "内で。ああ、あれか。ああ、そうだ、手に入れた"}, {"type": "subtitle", "time": 15754.79, "timestamp": "04:22:34", "text": "それ。そして『サイコブレイク2』も発売される"}, {"type": "subtitle", "time": 15757.349, "timestamp": "04:22:37", "text": "無料で入手できます。私は両方とも手に入れるつもりです"}, {"type": "subtitle", "time": 15759.03, "timestamp": "04:22:39", "text": "彼ら。"}, {"type": "subtitle", "time": 15761.229, "timestamp": "04:22:41", "text": "私の"}, {"type": "subtitle", "time": 15764.95, "timestamp": "04:22:44", "text": "チャネル。えっと"}, {"type": "subtitle", "time": 15767.03, "timestamp": "04:22:47", "text": "なぜなら『サイコブレイク』は本当に素晴らしいから"}, {"type": "subtitle", "time": 15768.95, "timestamp": "04:22:48", "text": "ゲーム。"}, {"type": "subtitle", "time": 15772.15, "timestamp": "04:22:52", "text": "うん。古いゲームだけど、良いゲームだよ。"}, {"type": "subtitle", "time": 15779.55, "timestamp": "04:22:59", "text": "ニース。うん。うん。うん。"}]
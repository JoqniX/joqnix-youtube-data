[{"type": "subtitle", "time": 12900.67, "timestamp": "03:35:00", "text": "ネットがダウンしたんだと思う。いいえ。"}, {"type": "subtitle", "time": 12904.87, "timestamp": "03:35:04", "text": "ヴィック・リック。いいえ、"}, {"type": "subtitle", "time": 12912.15, "timestamp": "03:35:12", "text": "いや。ああ、いやだ。え、何？何が起こっていますか？"}, {"type": "subtitle", "time": 12914.07, "timestamp": "03:35:14", "text": "えっと、ヴィック、ネットが壊れたみたいで"}, {"type": "subtitle", "time": 12922.389, "timestamp": "03:35:22", "text": "大丈夫。ああ、水分補給をありがとう。"}, {"type": "subtitle", "time": 12924.229, "timestamp": "03:35:24", "text": "すぐにやりますよ。君たちは"}, {"type": "subtitle", "time": 12927.03, "timestamp": "03:35:27", "text": "水も飲んでください。うん。うん。ありがとう"}, {"type": "subtitle", "time": 12931.71, "timestamp": "03:35:31", "text": "それは、くそ、そうじゃないということを思い出させてくれる。"}, {"type": "subtitle", "time": 12935.75, "timestamp": "03:35:35", "text": "楽しい。わかった。わかった。とにかく、えーと、ジョー、私は思う"}, {"type": "subtitle", "time": 12939.269, "timestamp": "03:35:39", "text": "君は基本的なことを理解しているね。うん。基本的な考え方。"}, {"type": "subtitle", "time": 12952.07, "timestamp": "03:35:52", "text": "慣れてしまえば、"}, {"type": "subtitle", "time": 12955.91, "timestamp": "03:35:55", "text": "怖い。そうだといい。うん。うん。一般的に、"}, {"type": "subtitle", "time": 12957.67, "timestamp": "03:35:57", "text": "このゲーム、このゲームは実際にはそうではない"}]
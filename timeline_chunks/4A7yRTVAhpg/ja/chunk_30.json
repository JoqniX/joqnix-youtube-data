[{"type": "subtitle", "time": 1823.909, "timestamp": "00:30:23", "text": "私には、やるべき場所がありません。ああ。"}, {"type": "subtitle", "time": 1832.63, "timestamp": "00:30:32", "text": "彼らに必要なものは何ですか？ああ、2つ必要だ"}, {"type": "subtitle", "time": 1836.23, "timestamp": "00:30:36", "text": "媒体。わかった。これはどこに捨てればいいですか？"}, {"type": "subtitle", "time": 1837.83, "timestamp": "00:30:37", "text": "えっと、ゴミ箱。ああ、もうない"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "ごみ。ええと、もうスペースがありません。えっと、"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "そのままにしておけばいい。何てことだ。ああ、私たちは"}, {"type": "subtitle", "time": 1848.17, "timestamp": "00:30:48", "text": "あと1つ。うん。うん。"}, {"type": "subtitle", "time": 1854.549, "timestamp": "00:30:54", "text": "[音楽]"}, {"type": "subtitle", "time": 1858.389, "timestamp": "00:30:58", "text": "だから、もっとゴミ箱みたいなものが必要だ。えっと、"}]
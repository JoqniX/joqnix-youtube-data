[{"type": "subtitle", "time": 18307.83, "timestamp": "05:05:07", "text": "けれど。でも、そう、だから、私は"}, {"type": "subtitle", "time": 18311.03, "timestamp": "05:05:11", "text": "来週の予定を事前に立てておいた"}, {"type": "subtitle", "time": 18314.31, "timestamp": "05:05:14", "text": "もの。 3つのストリームは"}, {"type": "subtitle", "time": 18317.27, "timestamp": "05:05:17", "text": "3つのストリームはロットのようなものです"}, {"type": "subtitle", "time": 18320.868, "timestamp": "05:05:20", "text": "でも、僕たちは原神をやるつもりだよ。地獄"}, {"type": "subtitle", "time": 18323.67, "timestamp": "05:05:23", "text": "少しL42をやって、新しい"}, {"type": "subtitle", "time": 18325.23, "timestamp": "05:05:25", "text": "無料ゲーム"}, {"type": "subtitle", "time": 18327.51, "timestamp": "05:05:27", "text": "ヴィックが少し演奏するのは素晴らしいことだ"}, {"type": "subtitle", "time": 18330.15, "timestamp": "05:05:30", "text": "少しだけ同行した。なぜ私は"}, {"type": "subtitle", "time": 18332.948, "timestamp": "05:05:32", "text": "連れて行かれた理由はわからない"}, {"type": "subtitle", "time": 18335.83, "timestamp": "05:05:35", "text": "少なくとも私はプレイしないので、ゲームを注文します"}, {"type": "subtitle", "time": 18338.55, "timestamp": "05:05:38", "text": "見ていると少し辛いけど、それでも"}, {"type": "subtitle", "time": 18340.39, "timestamp": "05:05:40", "text": "少なくとも私はトラウマにはなっていない"}, {"type": "subtitle", "time": 18343.868, "timestamp": "05:05:43", "text": "見ていると実際に"}, {"type": "subtitle", "time": 18351.23, "timestamp": "05:05:51", "text": "それ。何てことだ。しかし"}, {"type": "subtitle", "time": 18354.628, "timestamp": "05:05:54", "text": "うん、でもきっと楽しいよ。きっと楽しいよ。"}, {"type": "subtitle", "time": 18357.31, "timestamp": "05:05:57", "text": "私は興奮しています。私は"}, {"type": "subtitle", "time": 18359.708, "timestamp": "05:05:59", "text": "盛り上がっている。"}]
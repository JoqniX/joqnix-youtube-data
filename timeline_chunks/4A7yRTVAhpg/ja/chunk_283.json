[{"type": "subtitle", "time": 16982.31, "timestamp": "04:43:02", "text": "ええ、そうですね。ええ、見ていましたよ。"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "ニース。それをプレイしたいの？"}, {"type": "subtitle", "time": 16990.47, "timestamp": "04:43:10", "text": "待てよ、シングルプレイヤーモードだぞ。うん、そんな感じ"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "片方の場所では時計が、もう片方では時計が。"}, {"type": "subtitle", "time": 16998.3, "timestamp": "04:43:18", "text": "いつ実行したいですか？何時？"}, {"type": "subtitle", "time": 17004.868, "timestamp": "04:43:24", "text": "Hは来週です。来週ならできますよ"}, {"type": "subtitle", "time": 17006.788, "timestamp": "04:43:26", "text": "実は。ええ、来週ですね。うん。うん。"}, {"type": "subtitle", "time": 17010.31, "timestamp": "04:43:30", "text": "焼き尽くせ。来週。わかった。月曜日に"}, {"type": "subtitle", "time": 17013.59, "timestamp": "04:43:33", "text": "Left for Dead のようにできる"}, {"type": "subtitle", "time": 17016.788, "timestamp": "04:43:36", "text": "そして、このギンギトを次のようにすることができます"}, {"type": "subtitle", "time": 17018.628, "timestamp": "04:43:38", "text": "水曜日か木曜日か金曜日か"}, {"type": "subtitle", "time": 17021.35, "timestamp": "04:43:41", "text": "何か。よし。木曜日みたいに。"}, {"type": "subtitle", "time": 17025.11, "timestamp": "04:43:45", "text": "木曜日は最高の時間だ。"}, {"type": "subtitle", "time": 17028.15, "timestamp": "04:43:48", "text": "はい、可能です。"}, {"type": "subtitle", "time": 17034.47, "timestamp": "04:43:54", "text": "うん。この画面であなたを共有します"}, {"type": "subtitle", "time": 17036.39, "timestamp": "04:43:56", "text": "だから、あなたが何を見逃すか"}, {"type": "subtitle", "time": 17038.788, "timestamp": "04:43:58", "text": "まるでただ「オーケー」を見ているような感じ。だから、"}]
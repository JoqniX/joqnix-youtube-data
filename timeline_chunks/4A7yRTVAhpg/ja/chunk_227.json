[{"type": "subtitle", "time": 13620.469, "timestamp": "03:47:00", "text": "この作品には神々が登場するのだろうか？いいえ、"}, {"type": "subtitle", "time": 13623.429, "timestamp": "03:47:03", "text": "卵が出ます。"}, {"type": "subtitle", "time": 13627.189, "timestamp": "03:47:07", "text": "卵？はい。あなたは食べるつもりです"}, {"type": "subtitle", "time": 13629.269, "timestamp": "03:47:09", "text": "食べに行くんだよ ほらほらほらほら"}, {"type": "subtitle", "time": 13633.189, "timestamp": "03:47:13", "text": "このグループ？この酸性の便が見えますか？"}, {"type": "subtitle", "time": 13635.83, "timestamp": "03:47:15", "text": "これらを使って掃除します"}, {"type": "subtitle", "time": 13637.429, "timestamp": "03:47:17", "text": "ボトル。"}, {"type": "subtitle", "time": 13641.03, "timestamp": "03:47:21", "text": "だから、今まさにそれをやっているところです。"}, {"type": "subtitle", "time": 13644.389, "timestamp": "03:47:24", "text": "ああ、それから卵を見つけて、"}, {"type": "subtitle", "time": 13646.03, "timestamp": "03:47:26", "text": "洗濯します"}, {"type": "subtitle", "time": 13649.349, "timestamp": "03:47:29", "text": "彼らを犠牲にし、"}, {"type": "subtitle", "time": 13651.59, "timestamp": "03:47:31", "text": "祭壇。"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "ああ、救急箱をここに置かないで"}, {"type": "subtitle", "time": 13658.63, "timestamp": "03:47:38", "text": "いつものように。ここに物を置いておいてください。うん、"}, {"type": "subtitle", "time": 13660.87, "timestamp": "03:47:40", "text": "薬箱を真ん中に置いてください。"}, {"type": "subtitle", "time": 13663.67, "timestamp": "03:47:43", "text": "私はこれを浄化します"}, {"type": "subtitle", "time": 13665.83, "timestamp": "03:47:45", "text": "岩だらけの水辺の物体も。あなたが知っている"}, {"type": "subtitle", "time": 13667.349, "timestamp": "03:47:47", "text": "何？その前に、"}, {"type": "subtitle", "time": 13669.91, "timestamp": "03:47:49", "text": "ザラを刺激するんだよ、わかるだろ？ザラを探しに行こう。"}, {"type": "subtitle", "time": 13671.95, "timestamp": "03:47:51", "text": "来る"}, {"type": "subtitle", "time": 13674.87, "timestamp": "03:47:54", "text": "今すぐにでもやりたいという喜び。神話級。"}, {"type": "subtitle", "time": 13676.63, "timestamp": "03:47:56", "text": "神話級。今すぐやりたいの？私たちはそうではない"}, {"type": "subtitle", "time": 13678.07, "timestamp": "03:47:58", "text": "私たちは彼女を攻撃するつもりはありません。私たちはそうではない"}, {"type": "subtitle", "time": 13679.67, "timestamp": "03:47:59", "text": "卵を犠牲にするつもりですが、"}]
[{"type": "subtitle", "time": 13500.55, "timestamp": "03:45:00", "text": "家族経営の宿。ザラは巨大なものを発見した"}, {"type": "subtitle", "time": 13503.75, "timestamp": "03:45:03", "text": "巣を作るクモを不浄なものとして捧げる"}, {"type": "subtitle", "time": 13505.55, "timestamp": "03:45:05", "text": "血の生贄。"}, {"type": "subtitle", "time": 13507.83, "timestamp": "03:45:07", "text": "[音楽]"}, {"type": "subtitle", "time": 13511.11, "timestamp": "03:45:11", "text": "はぁ？儀式が失敗し、"}, {"type": "subtitle", "time": 13514.71, "timestamp": "03:45:14", "text": "アジルはザラの体と精神を乗っ取った"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "元カルト信者であり、"}, {"type": "subtitle", "time": 13524.87, "timestamp": "03:45:24", "text": "ザラの忠実な友人の皆さん、ついに"}, {"type": "subtitle", "time": 13528.309, "timestamp": "03:45:28", "text": "宿を見つけた後。"}, {"type": "subtitle", "time": 13539.99, "timestamp": "03:45:39", "text": "私を待ち受けているものは何であれ、ほぼ。"}, {"type": "subtitle", "time": 13542.63, "timestamp": "03:45:42", "text": "だから私たちは忠誠心を持っているのです。私たちは忠誠心を持っています。ああ、"}, {"type": "subtitle", "time": 13545.269, "timestamp": "03:45:45", "text": "神。ジョーがクソ野郎なのが見える"}, {"type": "subtitle", "time": 13547.269, "timestamp": "03:45:47", "text": "彼。"}, {"type": "subtitle", "time": 13549.269, "timestamp": "03:45:49", "text": "え、何？"}, {"type": "subtitle", "time": 13551.67, "timestamp": "03:45:51", "text": "カットシーンの前にロードされました"}, {"type": "subtitle", "time": 13554.309, "timestamp": "03:45:54", "text": "終了しました。先ほど、あなたのモデルを見ました。"}, {"type": "subtitle", "time": 13555.99, "timestamp": "03:45:55", "text": "ボールをありがとうございました。私にやらせてください"}]
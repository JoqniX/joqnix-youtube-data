[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "「うん、大丈夫だよ」みたいな感じ。うん、そうするべきだ"}, {"type": "subtitle", "time": 18005.91, "timestamp": "05:00:05", "text": "事前にお知らせしておきました。私は"}, {"type": "subtitle", "time": 18009.47, "timestamp": "05:00:09", "text": "ごめん。大丈夫です。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "わかった。くそ。最高の睡眠をあなたはまだ"}, {"type": "subtitle", "time": 18016.39, "timestamp": "05:00:16", "text": "起きている。くそ。あなたは"}, {"type": "subtitle", "time": 18019.11, "timestamp": "05:00:19", "text": "寝ろよ。うん。あなたは"}, {"type": "subtitle", "time": 18024.31, "timestamp": "05:00:24", "text": "とにかく、私は私は私は私は私の"}, {"type": "subtitle", "time": 18028.47, "timestamp": "05:00:28", "text": "今すぐ立ち去れ。こんにちは。"}, {"type": "subtitle", "time": 18030.708, "timestamp": "05:00:30", "text": "たとえ死んでも、私は起きてい続けるだろう。"}, {"type": "subtitle", "time": 18033.67, "timestamp": "05:00:33", "text": "イエス・キリスト。 Sumiサーバー。くそ。"}, {"type": "subtitle", "time": 18037.19, "timestamp": "05:00:37", "text": "こいつらはまるで目を覚ましているみたいだ。私は思う"}, {"type": "subtitle", "time": 18040.31, "timestamp": "05:00:40", "text": "明日は日曜日。もちろん。もちろん。"}, {"type": "subtitle", "time": 18042.47, "timestamp": "05:00:42", "text": "だから彼らはああいう感じなんだ"}, {"type": "subtitle", "time": 18043.99, "timestamp": "05:00:43", "text": "起きている。大丈夫です。大丈夫です。それから彼らは"}, {"type": "subtitle", "time": 18046.47, "timestamp": "05:00:46", "text": "それなら良いですね。"}, {"type": "subtitle", "time": 18048.47, "timestamp": "05:00:48", "text": "彼らがどれだけ目を覚ましたかは関係ない"}, {"type": "subtitle", "time": 18050.07, "timestamp": "05:00:50", "text": "けれど。"}, {"type": "subtitle", "time": 18051.99, "timestamp": "05:00:51", "text": "ああ、神様。仕事がなければいいのに"}, {"type": "subtitle", "time": 18056.11, "timestamp": "05:00:56", "text": "明日だよ。私はまだ働いています"}, {"type": "subtitle", "time": 18058.55, "timestamp": "05:00:58", "text": "明日。ああ、それは大きなものになるだろう"}]
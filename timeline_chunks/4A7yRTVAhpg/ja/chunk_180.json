[{"type": "subtitle", "time": 10800.319, "timestamp": "03:00:00", "text": "招待状を送ってください。わかりました、私が主催します 歯茎。"}, {"type": "subtitle", "time": 10802.0, "timestamp": "03:00:02", "text": "歯茎。 えっと、待って、ロビーをホストしたら、"}, {"type": "subtitle", "time": 10804.8, "timestamp": "03:00:04", "text": "えっと、待って、ロビーをホストしたら、 他の人も参加できる人？誰か"}, {"type": "subtitle", "time": 10807.52, "timestamp": "03:00:07", "text": "他の人も参加できる人？誰か 他に参加する人はいますか？参加すれば、私たちはそれを実現できる"}, {"type": "subtitle", "time": 10809.04, "timestamp": "03:00:09", "text": "他に参加する人はいますか？参加すれば、私たちはそれを実現できる プライベートなsのようなもの。ああ、わかりました。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 10811.6, "timestamp": "03:00:11", "text": "プライベートなsのようなもの。ああ、わかりました。わかった。ええ、私たちは 14 が必要です"}, {"type": "subtitle", "time": 10816.08, "timestamp": "03:00:16", "text": "14 が必要です うん、大丈夫だよ。大丈夫です。パスワード"}, {"type": "subtitle", "time": 10818.56, "timestamp": "03:00:18", "text": "うん、大丈夫だよ。大丈夫です。パスワード になるだろう"}, {"type": "subtitle", "time": 10826.99, "timestamp": "03:00:26", "text": "来るように"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "戻る。彼は牛乳を買いに私たちのもとを離れ、"}, {"type": "subtitle", "time": 10834.71, "timestamp": "03:00:34", "text": "二度と戻ってこなかった。彼は二度と戻ってこなかった。おお"}, {"type": "subtitle", "time": 10838.99, "timestamp": "03:00:38", "text": "我が神よ。彼は牛乳を買いに出かけたが、"}, {"type": "subtitle", "time": 10842.71, "timestamp": "03:00:42", "text": "牛乳を買いに出かけたことは一度もない。やめてください"}, {"type": "subtitle", "time": 10852.71, "timestamp": "03:00:52", "text": "神。牛乳を買うのが大好きです。はい。ニース。地獄"}, {"type": "subtitle", "time": 10855.19, "timestamp": "03:00:55", "text": "燃えるような瞬間。彼が"}, {"type": "subtitle", "time": 10857.51, "timestamp": "03:00:57", "text": "左。彼は私の周りのみんなと同じように去っていった"}]
[{"type": "subtitle", "time": 1442.23, "timestamp": "00:24:02", "text": "さあ、どうぞ。いつ手に入れますか"}, {"type": "subtitle", "time": 1445.029, "timestamp": "00:24:05", "text": "ダイニングテーブル？"}, {"type": "subtitle", "time": 1448.31, "timestamp": "00:24:08", "text": "あらら。待って、ホブとか書いてあるよ。"}, {"type": "subtitle", "time": 1451.39, "timestamp": "00:24:11", "text": "コイン。つまり、それはまた別の"}, {"type": "subtitle", "time": 1455.35, "timestamp": "00:24:15", "text": "えっと、私たちはそれを買う必要はありません。私たちには必要だった"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "しかし、これは違う。大丈夫。私はそれを保管します"}, {"type": "subtitle", "time": 1461.83, "timestamp": "00:24:21", "text": "今のところは内閣で。私たちは必要なかった"}, {"type": "subtitle", "time": 1464.029, "timestamp": "00:24:24", "text": "これ。追加が必要でした"}, {"type": "subtitle", "time": 1467.75, "timestamp": "00:24:27", "text": "テーブル。あらら。"}, {"type": "subtitle", "time": 1470.909, "timestamp": "00:24:30", "text": "大丈夫。全て"}, {"type": "subtitle", "time": 1482.59, "timestamp": "00:24:42", "text": "ポット。なぜドアは"}, {"type": "subtitle", "time": 1486.63, "timestamp": "00:24:46", "text": "遅い？わからない。"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "でも、俺たちはもうダメだ。"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "十分な量があるとは思えません"}, {"type": "subtitle", "time": 1493.87, "timestamp": "00:24:53", "text": "皿。おお"}, {"type": "subtitle", "time": 1497.269, "timestamp": "00:24:57", "text": "いいえ、便数が足りません。その"}]
[{"type": "subtitle", "time": 18182.628, "timestamp": "05:03:02", "text": "ビリヤニ。バスマティ。うん。うん。わかりました。"}, {"type": "subtitle", "time": 18190.15, "timestamp": "05:03:10", "text": "ビリヤニ。うん。とにかく、私は"}, {"type": "subtitle", "time": 18192.628, "timestamp": "05:03:12", "text": "今すぐ立ち去れ。もし私がただ"}, {"type": "subtitle", "time": 18194.708, "timestamp": "05:03:14", "text": "一日中こんな風に話して、"}, {"type": "subtitle", "time": 18198.07, "timestamp": "05:03:18", "text": "ああ、私はただ死ぬだけだ。さよなら。良い一日を"}, {"type": "subtitle", "time": 18200.708, "timestamp": "05:03:20", "text": "1つ。皆さん、良い一日を。持つ"}, {"type": "subtitle", "time": 18202.07, "timestamp": "05:03:22", "text": "いいですね。さよなら。良い一日を。さあ"}, {"type": "subtitle", "time": 18205.91, "timestamp": "05:03:25", "text": "それを得る。さよなら。さようなら、クロノス。さようなら、クロノス。"}, {"type": "subtitle", "time": 18207.628, "timestamp": "05:03:27", "text": "さよなら、"}, {"type": "subtitle", "time": 18211.03, "timestamp": "05:03:31", "text": "アルミニウム。ヴーはここにいた。"}, {"type": "subtitle", "time": 18212.83, "timestamp": "05:03:32", "text": "ヴーは"}, {"type": "subtitle", "time": 18215.27, "timestamp": "05:03:35", "text": "ここ。皆さん、さようなら。良い一日を"}, {"type": "subtitle", "time": 18217.83, "timestamp": "05:03:37", "text": "1つ。私はレオプシスを服用します。バイバイ。こんにちは。"}, {"type": "subtitle", "time": 18237.72, "timestamp": "05:03:57", "text": "バイバイ。のために"}]
[{"type": "subtitle", "time": 2642.349, "timestamp": "00:44:02", "text": "いいえ。"}, {"type": "subtitle", "time": 2649.75, "timestamp": "00:44:09", "text": "私たちは何を得るのでしょうか？"}, {"type": "subtitle", "time": 2656.069, "timestamp": "00:44:16", "text": "アップグレード可能なプレート。アップグレードできますか？"}, {"type": "subtitle", "time": 2658.55, "timestamp": "00:44:18", "text": "お皿？うん。うん。うん。私たちはすべきです"}, {"type": "subtitle", "time": 2660.47, "timestamp": "00:44:20", "text": "アップグレードプレート。待って、いくらいくら"}, {"type": "subtitle", "time": 2663.39, "timestamp": "00:44:23", "text": "研究は埃をかぶっているのか？おお、研究デスクは"}, {"type": "subtitle", "time": 2667.109, "timestamp": "00:44:27", "text": "高い。わかった、気にしないで。"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "カウンターをアップグレードするべきだと思うので"}, {"type": "subtitle", "time": 2672.87, "timestamp": "00:44:32", "text": "今はもっと速くなりました。"}, {"type": "subtitle", "time": 2675.349, "timestamp": "00:44:35", "text": "しかし、カウンターはあまりアップグレードされません"}, {"type": "chat", "time": 2675.709, "timestamp": "00:44:35", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Did u finally got your cooker??"}, {"type": "subtitle", "time": 2678.309, "timestamp": "00:44:38", "text": "けれど。カウンターのアップグレードは何をしますか？"}, {"type": "subtitle", "time": 2681.43, "timestamp": "00:44:41", "text": "けれど？それは単にああ"}, {"type": "subtitle", "time": 2684.95, "timestamp": "00:44:44", "text": "より速く切ることもできますし、"}, {"type": "subtitle", "time": 2687.75, "timestamp": "00:44:47", "text": "本当にイライラする。それはしない"}, {"type": "subtitle", "time": 2690.63, "timestamp": "00:44:50", "text": "大したことは何も。"}, {"type": "subtitle", "time": 2693.109, "timestamp": "00:44:53", "text": "ついに調理器具を手に入れましたか？あなたへ"}, {"type": "subtitle", "time": 2697.71, "timestamp": "00:44:57", "text": "WhatsAppのクッキーでした。集中。こんにちは、アストラさん"}]
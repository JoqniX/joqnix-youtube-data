[{"type": "subtitle", "time": 18060.23, "timestamp": "05:01:00", "text": "トラブル。"}, {"type": "subtitle", "time": 18063.948, "timestamp": "05:01:03", "text": "明日の仕事、頑張ってください。"}, {"type": "subtitle", "time": 18066.788, "timestamp": "05:01:06", "text": "じゃあ、良い一日を、ジャック。ええ、"}, {"type": "subtitle", "time": 18069.03, "timestamp": "05:01:09", "text": "ストリームを終了して、"}, {"type": "subtitle", "time": 18071.83, "timestamp": "05:01:11", "text": "午前 8 時まで配信します。いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 18073.83, "timestamp": "05:01:13", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。あなたが知っている"}, {"type": "subtitle", "time": 18074.948, "timestamp": "05:01:14", "text": "何？私はここに残ります。私は"}, {"type": "subtitle", "time": 18077.948, "timestamp": "05:01:17", "text": "滞在する。終わりだ。終わりだ。"}, {"type": "subtitle", "time": 18081.67, "timestamp": "05:01:21", "text": "いや、彼女は必要ない。ええ、ただ話すだけです"}, {"type": "subtitle", "time": 18084.27, "timestamp": "05:01:24", "text": "少しの間、そして私が"}, {"type": "subtitle", "time": 18088.47, "timestamp": "05:01:28", "text": "睡眠は必要だと約束します"}, {"type": "subtitle", "time": 18091.19, "timestamp": "05:01:31", "text": "あなたに必要なものです。"}, {"type": "subtitle", "time": 18094.708, "timestamp": "05:01:34", "text": "ちなみに、あなたにとっても初めて聞く話ですね。ああ、いや"}, {"type": "subtitle", "time": 18096.55, "timestamp": "05:01:36", "text": "心配事。私は目覚めることを考えている"}, {"type": "subtitle", "time": 18098.39, "timestamp": "05:01:38", "text": "早起きして、偽物にそれをするのが好き"}, {"type": "subtitle", "time": 18101.03, "timestamp": "05:01:41", "text": "明日。そうですね、"}, {"type": "subtitle", "time": 18103.83, "timestamp": "05:01:43", "text": "それなら早く寝なきゃいけないね。うん、"}, {"type": "subtitle", "time": 18106.628, "timestamp": "05:01:46", "text": "ということで、これで締めくくりたいと思います。私"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "1:30は早すぎるサメだとは思わない。"}, {"type": "subtitle", "time": 18110.75, "timestamp": "05:01:50", "text": "おお、"}, {"type": "subtitle", "time": 18114.23, "timestamp": "05:01:54", "text": "待って。大丈夫。でも、ええ、"}, {"type": "subtitle", "time": 18117.59, "timestamp": "05:01:57", "text": "まあ、いいんじゃない？うん、大丈夫だよ。"}, {"type": "subtitle", "time": 18119.67, "timestamp": "05:01:59", "text": "バケツに頭を突っ込んで"}]
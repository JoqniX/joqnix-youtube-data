[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "うーん、おそらく違うでしょう。おそらく違うだろう。いいえ、"}, {"type": "subtitle", "time": 243.75, "timestamp": "00:04:03", "text": "少なくとも1人は自分の電力を節約できる"}, {"type": "subtitle", "time": 245.99, "timestamp": "00:04:05", "text": "進歩ですよね？つまり、私たちは"}, {"type": "subtitle", "time": 247.75, "timestamp": "00:04:07", "text": "まだ基地を建設していない。さらに、"}, {"type": "subtitle", "time": 249.75, "timestamp": "00:04:09", "text": "まだそこまでには至っていない。"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "ええ、それほど進歩は見られません"}, {"type": "subtitle", "time": 253.71, "timestamp": "00:04:13", "text": "どこでも。さて、私が司会者です。おお"}, {"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "ひっくり返す。破壊という遊びとは"}, {"type": "subtitle", "time": 259.509, "timestamp": "00:04:19", "text": "行け、兄弟。司会者はどこにいますか？くそ。"}, {"type": "chat", "time": 261.505, "timestamp": "00:04:21", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "please wait for a bit, we'll start the collab in a bit"}, {"type": "subtitle", "time": 263.189, "timestamp": "00:04:23", "text": "何してるの？彼女を殺す。"}, {"type": "subtitle", "time": 266.23, "timestamp": "00:04:26", "text": "明らかに。もし私が去ったら、"}, {"type": "subtitle", "time": 269.189, "timestamp": "00:04:29", "text": "それはなくなってしまった。"}, {"type": "subtitle", "time": 277.99, "timestamp": "00:04:37", "text": "全員応答あり。どうしたの？"}, {"type": "subtitle", "time": 279.909, "timestamp": "00:04:39", "text": "なんてこった。"}, {"type": "subtitle", "time": 282.95, "timestamp": "00:04:42", "text": "新しいものを作っています。"}, {"type": "subtitle", "time": 285.189, "timestamp": "00:04:45", "text": "私の電気は私を見捨てて"}, {"type": "subtitle", "time": 292.95, "timestamp": "00:04:52", "text": "大丈夫。電源を入れてください。実際は"}, {"type": "subtitle", "time": 296.469, "timestamp": "00:04:56", "text": "だから、少なくともいかだをやってから"}, {"type": "subtitle", "time": 299.27, "timestamp": "00:04:59", "text": 
[{"type": "subtitle", "time": 8345.19, "timestamp": "02:19:05", "text": "テーブル。いいえ、私はこれを置くべきです"}, {"type": "subtitle", "time": 8347.95, "timestamp": "02:19:07", "text": "ここに1つあります。ない"}, {"type": "subtitle", "time": 8349.09, "timestamp": "02:19:09", "text": "ここ。"}, {"type": "subtitle", "time": 8351.23, "timestamp": "02:19:11", "text": "[音楽]"}, {"type": "subtitle", "time": 8354.709, "timestamp": "02:19:14", "text": "そして、ここ。"}, {"type": "subtitle", "time": 8356.19, "timestamp": "02:19:16", "text": "私の"}, {"type": "subtitle", "time": 8378.509, "timestamp": "02:19:38", "text": "言う？"}, {"type": "subtitle", "time": 8381.07, "timestamp": "02:19:41", "text": "私たちはキスをした"}]
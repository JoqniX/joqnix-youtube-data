[{"type": "subtitle", "time": 6300.75, "timestamp": "01:45:00", "text": "ポイント。ダイニングテーブルの設計図"}, {"type": "subtitle", "time": 6303.43, "timestamp": "01:45:03", "text": "キャビネットカウンター。調査デスク何ですか"}, {"type": "subtitle", "time": 6310.07, "timestamp": "01:45:10", "text": "ああ、モップ。"}, {"type": "subtitle", "time": 6313.59, "timestamp": "01:45:13", "text": "ああ、本当に必要なのか？それ、もらってもいいですよ。その"}, {"type": "subtitle", "time": 6315.59, "timestamp": "01:45:15", "text": "役に立つかもしれない。私たちはできる、すべきだ"}, {"type": "subtitle", "time": 6317.75, "timestamp": "01:45:17", "text": "買いますか？"}, {"type": "subtitle", "time": 6319.38, "timestamp": "01:45:19", "text": "うん、やってみて。"}, {"type": "subtitle", "time": 6321.27, "timestamp": "01:45:21", "text": "[音楽]"}, {"type": "subtitle", "time": 6334.07, "timestamp": "01:45:34", "text": "ニース。ニース。"}, {"type": "subtitle", "time": 6335.39, "timestamp": "01:45:35", "text": "私は必要だと思う"}, {"type": "subtitle", "time": 6340.07, "timestamp": "01:45:40", "text": "とりあえず、これはここで終わりにしましょう。"}, {"type": "subtitle", "time": 6341.709, "timestamp": "01:45:41", "text": "うん。そして"}, {"type": "subtitle", "time": 6343.229, "timestamp": "01:45:43", "text": "それから"}, {"type": "subtitle", "time": 6351.629, "timestamp": "01:45:51", "text": "ここ。私はただ置くことができます"}]
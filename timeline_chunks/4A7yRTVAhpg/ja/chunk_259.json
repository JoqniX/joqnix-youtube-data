[{"type": "subtitle", "time": 15540.63, "timestamp": "04:19:00", "text": "はい。はい。そうすれば、"}, {"type": "subtitle", "time": 15543.67, "timestamp": "04:19:03", "text": "エース。エースが出るよ。今"}, {"type": "subtitle", "time": 15545.83, "timestamp": "04:19:05", "text": "私は退屈です。自慢しているんです。私は思う。私"}, {"type": "subtitle", "time": 15548.389, "timestamp": "04:19:08", "text": "わからない。いいえ。いいえ。信頼、信頼、信頼、"}, {"type": "subtitle", "time": 15550.07, "timestamp": "04:19:10", "text": "信じる、"}, {"type": "subtitle", "time": 15552.87, "timestamp": "04:19:12", "text": "信じろ、冗談だ。信じる。"}, {"type": "subtitle", "time": 15557.99, "timestamp": "04:19:17", "text": "ええと、一つだけ言えることがあります。あなたではない"}, {"type": "subtitle", "time": 15565.189, "timestamp": "04:19:25", "text": "ああ、あの忌々しい恐怖。あなたの言う通りでした。"}, {"type": "subtitle", "time": 15581.03, "timestamp": "04:19:41", "text": "ニース。"}, {"type": "subtitle", "time": 15588.389, "timestamp": "04:19:48", "text": "試してみました。でも、でも、誰が"}, {"type": "subtitle", "time": 15590.309, "timestamp": "04:19:50", "text": "それを手に入れることができたより良いネオン"}, {"type": "subtitle", "time": 15591.71, "timestamp": "04:19:51", "text": "殺す？"}, {"type": "subtitle", "time": 15597.429, "timestamp": "04:19:57", "text": "私と一緒に来てください。そう、君だよ。何てことだ。"}, {"type": "subtitle", "time": 15598.95, "timestamp": "04:19:58", "text": "ギリシャ語"}]
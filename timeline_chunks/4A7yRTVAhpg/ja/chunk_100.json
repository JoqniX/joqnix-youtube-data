[{"type": "subtitle", "time": 6005.95, "timestamp": "01:40:05", "text": "[音楽]"}, {"type": "subtitle", "time": 6013.37, "timestamp": "01:40:13", "text": "ああ、それから"}, {"type": "subtitle", "time": 6015.79, "timestamp": "01:40:15", "text": "[音楽]"}, {"type": "subtitle", "time": 6017.31, "timestamp": "01:40:17", "text": "そこには"}, {"type": "subtitle", "time": 6025.07, "timestamp": "01:40:25", "text": "カウンタ。おお、コーヒー"}, {"type": "subtitle", "time": 6033.59, "timestamp": "01:40:33", "text": "[音楽]"}, {"type": "subtitle", "time": 6039.629, "timestamp": "01:40:39", "text": "もし私が研究をしたら"}, {"type": "subtitle", "time": 6042.75, "timestamp": "01:40:42", "text": "机？しかし、調査デスクは"}, {"type": "subtitle", "time": 6045.91, "timestamp": "01:40:45", "text": "十分。これはどういう状態ですか？テレポート"}, {"type": "subtitle", "time": 6047.47, "timestamp": "01:40:47", "text": "アイテム"}, {"type": "subtitle", "time": 6050.229, "timestamp": "01:40:50", "text": "他の。これは必要ないと思う。私"}, {"type": "subtitle", "time": 6053.51, "timestamp": "01:40:53", "text": "調査デスクが必要だと思う。そして"}, {"type": "subtitle", "time": 6056.149, "timestamp": "01:40:56", "text": "愚かな襲撃者を投げ捨てろ。私は興味があります"}]
[{"type": "subtitle", "time": 541.99, "timestamp": "00:09:01", "text": "始める。おお。おお。オンラインプレイヤーですよね？"}, {"type": "subtitle", "time": 543.47, "timestamp": "00:09:03", "text": "待って、招待したの？"}, {"type": "subtitle", "time": 546.43, "timestamp": "00:09:06", "text": "自分？私は思う"}, {"type": "subtitle", "time": 548.99, "timestamp": "00:09:08", "text": "[音楽]"}, {"type": "subtitle", "time": 559.67, "timestamp": "00:09:19", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 564.23, "timestamp": "00:09:24", "text": "えっと、どうやって参加すればいいんですか？"}, {"type": "subtitle", "time": 567.35, "timestamp": "00:09:27", "text": "Steamで招待状を送りました。"}, {"type": "subtitle", "time": 570.71, "timestamp": "00:09:30", "text": "私はそれを受け入れた。そして、あなたは送りましたか？"}, {"type": "subtitle", "time": 572.87, "timestamp": "00:09:32", "text": "また？"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "うん。"}, {"type": "subtitle", "time": 582.949, "timestamp": "00:09:42", "text": "[音楽]"}, {"type": "subtitle", "time": 585.12, "timestamp": "00:09:45", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "[音楽]"}, {"type": "subtitle", "time": 594.949, "timestamp": "00:09:54", "text": "持続する。 1分だけ時間をください。えっと、"}, {"type": "subtitle", "time": 596.88, "timestamp": "00:09:56", "text": "ただやるだけ"}]
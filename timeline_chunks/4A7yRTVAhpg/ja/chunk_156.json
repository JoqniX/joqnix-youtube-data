[{"type": "subtitle", "time": 9366.59, "timestamp": "02:36:06", "text": "パイ。必要"}, {"type": "subtitle", "time": 9370.389, "timestamp": "02:36:10", "text": "小麦粉で鳩を作る。それをこねて"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "パイクラッシュ。回転させて種を取り除きます。それから"}, {"type": "subtitle", "time": 9376.469, "timestamp": "02:36:16", "text": "刻んで、混ぜ合わせて、調理する。"}, {"type": "subtitle", "time": 9410.47, "timestamp": "02:36:50", "text": "感じる"}]
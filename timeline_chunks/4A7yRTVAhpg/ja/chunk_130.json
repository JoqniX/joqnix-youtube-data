[{"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "三つ。待って。本当にやりたいことは"}, {"type": "subtitle", "time": 7805.99, "timestamp": "02:10:05", "text": "三つ？"}, {"type": "subtitle", "time": 7809.35, "timestamp": "02:10:09", "text": "Hは3人です。"}, {"type": "subtitle", "time": 7810.43, "timestamp": "02:10:10", "text": "三つ"}, {"type": "subtitle", "time": 7813.109, "timestamp": "02:10:13", "text": "人々。 3人で来る人はあまり多くない"}, {"type": "subtitle", "time": 7816.95, "timestamp": "02:10:16", "text": "けれど。 2に設定できます。私"}, {"type": "subtitle", "time": 7823.99, "timestamp": "02:10:23", "text": "うん。その後"}, {"type": "subtitle", "time": 7832.629, "timestamp": "02:10:32", "text": "シンクはここに置いたと思う。"}, {"type": "subtitle", "time": 7834.35, "timestamp": "02:10:34", "text": "うん。"}, {"type": "subtitle", "time": 7837.76, "timestamp": "02:10:37", "text": "それから"}, {"type": "subtitle", "time": 7844.709, "timestamp": "02:10:44", "text": "こんな感じです。"}, {"type": "subtitle", "time": 7852.229, "timestamp": "02:10:52", "text": "[音楽]"}, {"type": "subtitle", "time": 7855.35, "timestamp": "02:10:55", "text": "私たちは私にはできない方法で肉に手が届く。"}]
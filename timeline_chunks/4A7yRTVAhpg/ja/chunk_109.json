[{"type": "subtitle", "time": 6564.79, "timestamp": "01:49:24", "text": "コーヒー。ああ、彼らには砂糖が必要だ。彼らは必要としている"}, {"type": "subtitle", "time": 6574.709, "timestamp": "01:49:34", "text": "わかった。元気ですか？"}, {"type": "subtitle", "time": 6577.43, "timestamp": "01:49:37", "text": "なぜこんなに人が多いのですか？うん、"}, {"type": "subtitle", "time": 6582.149, "timestamp": "01:49:42", "text": "彼らは行き詰まっている。何てことだ。コピー。もっと"}, {"type": "subtitle", "time": 6584.79, "timestamp": "01:49:44", "text": "コックピット。"}, {"type": "subtitle", "time": 6586.47, "timestamp": "01:49:46", "text": "それを1つに持っていく必要があると思います"}, {"type": "subtitle", "time": 6590.95, "timestamp": "01:49:50", "text": "後ろから先に。うん。"}, {"type": "subtitle", "time": 6594.229, "timestamp": "01:49:54", "text": "台所にいる二人は後回しでいい。"}, {"type": "subtitle", "time": 6595.49, "timestamp": "01:49:55", "text": "はい。"}]
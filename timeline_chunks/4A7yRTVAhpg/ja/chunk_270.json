[{"type": "subtitle", "time": 16204.229, "timestamp": "04:30:04", "text": "まあ、本当に？彼は特殊な手榴弾を手に入れた。"}, {"type": "subtitle", "time": 16213.91, "timestamp": "04:30:13", "text": "再装填中。"}, {"type": "subtitle", "time": 16245.55, "timestamp": "04:30:45", "text": "どうやって私はああ、なんてことだ、"}, {"type": "subtitle", "time": 16249.269, "timestamp": "04:30:49", "text": "何かが遅れる。"}, {"type": "subtitle", "time": 16251.83, "timestamp": "04:30:51", "text": "彼らはハッキングしているんだよ、兄弟。彼らはハッキングしている。"}, {"type": "subtitle", "time": 16255.349, "timestamp": "04:30:55", "text": "ああ、彼らはもう"}, {"type": "subtitle", "time": 16257.59, "timestamp": "04:30:57", "text": "ああ、大変だ。私が最後の犠牲者だった。ニース。"}, {"type": "subtitle", "time": 16259.59, "timestamp": "04:30:59", "text": "そこは、"}]
[{"type": "subtitle", "time": 13741.429, "timestamp": "03:49:01", "text": "中に入って。こっちに来て。ここに来て。ジョー。"}, {"type": "subtitle", "time": 13744.07, "timestamp": "03:49:04", "text": "うん。彼を見て。どちらでも構いません"}, {"type": "subtitle", "time": 13748.11, "timestamp": "03:49:08", "text": "どうぞお帰りください。すべて"}, {"type": "subtitle", "time": 13753.63, "timestamp": "03:49:13", "text": "ああ、あの女性はどなたですか？おいおい、勘弁してくれよ。"}, {"type": "subtitle", "time": 13756.389, "timestamp": "03:49:16", "text": "ザラ（日本版）"}, {"type": "subtitle", "time": 13759.83, "timestamp": "03:49:19", "text": "おお。なんてこった。"}, {"type": "subtitle", "time": 13761.92, "timestamp": "03:49:21", "text": "なんてこった。 彼女は嘔吐している。なんてこった。探していません。"}, {"type": "subtitle", "time": 13766.319, "timestamp": "03:49:26", "text": "彼女は嘔吐している。なんてこった。探していません。 なんてこった。彼女は君を裏切ったんだよ、兄弟。"}, {"type": "subtitle", "time": 13769.86, "timestamp": "03:49:29", "text": "なんてこった。彼女は君を裏切ったんだよ、兄弟。 [拍手]"}, {"type": "subtitle", "time": 13772.479, "timestamp": "03:49:32", "text": "[拍手] ああ、彼女は中に這い込んだ。何てことだ。親切"}, {"type": "subtitle", "time": 13775.199, "timestamp": "03:49:35", "text": "ああ、彼女は中に這い込んだ。何てことだ。親切 君に爆撃がかかったんだね。大丈夫ですか？"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "私はそれを見る必要はなかった。私"}, {"type": "subtitle", "time": 13784.55, "timestamp": "03:49:44", "text": "あれを見る必要はなかった。私は必要なかった"}, {"type": "subtitle", "time": 13787.349, "timestamp": "03:49:47", "text": "それを見るために。はい。行くべきではなかった"}, {"type": "subtitle", "time": 13790.389, "timestamp": "03:49:50", "text": "仕事に取り掛かる。はい、そうです。おいおい、豚野郎。あなた"}, {"type": "subtitle", "time": 13793.429, "timestamp": "03:49:53", "text": "これ、見えますか？"}, {"type": "subtitle", "time": 13795.349, "timestamp": "03:49:55", "text": "卵を拾って洗う必要があります"}, {"type": "subtitle", "time": 13799.349, "timestamp": "03:49:59", "text": "そしてそれを犠牲にする。はい。卵は何個"}]
[{"type": "subtitle", "time": 18243.91, "timestamp": "05:04:03", "text": "今日来られなかった人たちもいるけど、それでも。"}, {"type": "subtitle", "time": 18245.628, "timestamp": "05:04:05", "text": "感謝"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "君だよ。私は楽しみにしていた"}, {"type": "subtitle", "time": 18250.948, "timestamp": "05:04:10", "text": "シモとのコラボみたいだけど、まあいいか。"}, {"type": "subtitle", "time": 18253.75, "timestamp": "05:04:13", "text": "次回があるさ。いいえ、これは"}, {"type": "subtitle", "time": 18257.23, "timestamp": "05:04:17", "text": "常に次"}, {"type": "subtitle", "time": 18260.708, "timestamp": "05:04:20", "text": "時間。だから、私が欲しいもののひとつは"}, {"type": "subtitle", "time": 18263.83, "timestamp": "05:04:23", "text": "VAが少し"}, {"type": "subtitle", "time": 18266.31, "timestamp": "05:04:26", "text": "怖い。幸いにも、私は叫びませんでした。私"}, {"type": "subtitle", "time": 18268.628, "timestamp": "05:04:28", "text": "肺が破裂しそうなくらい叫びそうだった"}, {"type": "subtitle", "time": 18271.19, "timestamp": "05:04:31", "text": "今日は実は叔母さんが"}, {"type": "subtitle", "time": 18273.59, "timestamp": "05:04:33", "text": "文字通りあなたと同じように家に帰ってきた"}, {"type": "subtitle", "time": 18276.23, "timestamp": "05:04:36", "text": "覚えてる？私がBBに行ったのはちょうど"}, {"type": "subtitle", "time": 18279.51, "timestamp": "05:04:39", "text": "その時話していたら彼が入ってきた"}, {"type": "subtitle", "time": 18283.51, "timestamp": "05:04:43", "text": "などなど。うん。午後12時～1時頃"}, {"type": "subtitle", "time": 18286.23, "timestamp": "05:04:46", "text": "午前1時。うん。私は叫びそうになった"}, {"type": "subtitle", "time": 18289.948, "timestamp": "05:04:49", "text": "隣人が私の肺に"}, {"type": "subtitle", "time": 18296.91, "timestamp": "05:04:56", "text": "痛み。大丈夫"}]
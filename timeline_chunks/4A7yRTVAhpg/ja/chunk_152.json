[{"type": "subtitle", "time": 9120.23, "timestamp": "02:32:00", "text": "いや、それは良くない考えだ。悪い考えだ。私たちはすべきではない"}, {"type": "subtitle", "time": 9122.44, "timestamp": "02:32:02", "text": "自分たちで閉じこもる。"}, {"type": "subtitle", "time": 9125.51, "timestamp": "02:32:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9127.99, "timestamp": "02:32:07", "text": "ああ、5人にしてもいいよ。"}, {"type": "subtitle", "time": 9144.429, "timestamp": "02:32:24", "text": "それ？"}, {"type": "subtitle", "time": 9147.27, "timestamp": "02:32:27", "text": "H. いや、だってここに戻したら、"}, {"type": "subtitle", "time": 9148.51, "timestamp": "02:32:28", "text": "また"}]
[{"type": "subtitle", "time": 15240.95, "timestamp": "04:14:00", "text": "十分。わかった、"}, {"type": "subtitle", "time": 15242.75, "timestamp": "04:14:02", "text": "君たちは"}, {"type": "subtitle", "time": 15247.309, "timestamp": "04:14:07", "text": "ジョーは、何の後で悪いゲームプレイを見たのですか？ 3"}, {"type": "subtitle", "time": 15249.309, "timestamp": "04:14:09", "text": "2か月、2"}, {"type": "subtitle", "time": 15252.469, "timestamp": "04:14:12", "text": "数ヶ月。ヴァレラント・ジョック、君は良い"}, {"type": "subtitle", "time": 15260.71, "timestamp": "04:14:20", "text": "何？どういう意味ですか？あなたは良い"}, {"type": "subtitle", "time": 15263.03, "timestamp": "04:14:23", "text": "ゲームプレイ。嘘をつくのはやめろ。嘘をつくのはやめろ。"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "あなたは上手い。どういう意味ですか？何が"}, {"type": "subtitle", "time": 15268.07, "timestamp": "04:14:28", "text": "え、何？ え、何？って言うの？"}, {"type": "subtitle", "time": 15270.309, "timestamp": "04:14:30", "text": "どういう意味かって？黙れ。あなたは"}, {"type": "subtitle", "time": 15275.03, "timestamp": "04:14:35", "text": "ゲームが上手い。あなたは最高です。しないで"}, {"type": "subtitle", "time": 15278.95, "timestamp": "04:14:38", "text": "君は世界で一番素敵な男の子だよ。"}, {"type": "subtitle", "time": 15282.07, "timestamp": "04:14:42", "text": "自分を信じなければならない。その"}, {"type": "subtitle", "time": 15293.91, "timestamp": "04:14:53", "text": "私はある種族を滅ぼした。私は殺した あなたは"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "より良いネオン。あなたはより優れていた"}, {"type": "subtitle", "time": 15298.389, "timestamp": "04:14:58", "text": "ネオンの光が彼女を殺した。あなたは"}]
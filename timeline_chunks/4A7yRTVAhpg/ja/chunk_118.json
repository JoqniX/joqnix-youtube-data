[{"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "お父さん、元気ですか？私は元気ですが"}, {"type": "subtitle", "time": 7089.229, "timestamp": "01:58:09", "text": "睡眠不足。私たち二人とも"}, {"type": "subtitle", "time": 7093.03, "timestamp": "01:58:13", "text": "私たち二人は睡眠不足で"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "もの。うん。君も僕も睡眠が必要だ。しかし"}, {"type": "subtitle", "time": 7105.669, "timestamp": "01:58:25", "text": "[音楽]"}, {"type": "subtitle", "time": 7107.27, "timestamp": "01:58:27", "text": "私たちの真似はしないでください。お願いします"}, {"type": "subtitle", "time": 7112.43, "timestamp": "01:58:32", "text": "なれ"}, {"type": "subtitle", "time": 7115.43, "timestamp": "01:58:35", "text": "睡眠のように。"}, {"type": "subtitle", "time": 7119.07, "timestamp": "01:58:39", "text": "よし、やってみよう。待って、"}, {"type": "subtitle", "time": 7122.47, "timestamp": "01:58:42", "text": "レシピ？小麦粉が必要か、水を加える"}, {"type": "subtitle", "time": 7126.229, "timestamp": "01:58:46", "text": "生地。ニンジンと肉を刻む。あ、待って。"}, {"type": "subtitle", "time": 7139.589, "timestamp": "01:58:59", "text": "えっと、いいえ、まだ置いておけばアクセスできます"}]
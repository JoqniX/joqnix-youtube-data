[{"type": "subtitle", "time": 6241.55, "timestamp": "01:44:01", "text": "自分。でも、それは保持できるような"}, {"type": "subtitle", "time": 6244.69, "timestamp": "01:44:04", "text": "アイテム。追加の部品を取り付けることができます。"}, {"type": "subtitle", "time": 6250.31, "timestamp": "01:44:10", "text": "おお、"}, {"type": "subtitle", "time": 6252.9, "timestamp": "01:44:12", "text": "物語のように。"}, {"type": "subtitle", "time": 6259.99, "timestamp": "01:44:19", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 6263.27, "timestamp": "01:44:23", "text": "片付けるものが山ほどある。私たちには"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "ルームボードはプレイしません。"}, {"type": "subtitle", "time": 6287.06, "timestamp": "01:44:47", "text": "えっと。"}, {"type": "subtitle", "time": 6288.47, "timestamp": "01:44:48", "text": "[音楽]"}, {"type": "subtitle", "time": 6291.91, "timestamp": "01:44:51", "text": "ああ、2つ必要だよ。 2つ必要です"}, {"type": "subtitle", "time": 6294.229, "timestamp": "01:44:54", "text": "一度。"}, {"type": "subtitle", "time": 6297.31, "timestamp": "01:44:57", "text": "えっと、だから"}]
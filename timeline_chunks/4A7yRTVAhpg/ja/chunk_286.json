[{"type": "subtitle", "time": 17161.27, "timestamp": "04:46:01", "text": "私たちはそう言いました。私たちは2つのことを計画しており、"}, {"type": "subtitle", "time": 17163.75, "timestamp": "04:46:03", "text": "あなたはもっと計画しているのですね。"}, {"type": "subtitle", "time": 17166.15, "timestamp": "04:46:06", "text": "ええ、それは"}, {"type": "subtitle", "time": 17169.91, "timestamp": "04:46:09", "text": "素晴らしいものになるでしょう。私たちは最善を尽くします。"}, {"type": "subtitle", "time": 17171.43, "timestamp": "04:46:11", "text": "うん。"}, {"type": "subtitle", "time": 17174.27, "timestamp": "04:46:14", "text": "それではまた次回お会いしましょう"}, {"type": "subtitle", "time": 17176.67, "timestamp": "04:46:16", "text": "時間。"}, {"type": "subtitle", "time": 17180.23, "timestamp": "04:46:20", "text": "バイバイ。そしてもちろん"}, {"type": "subtitle", "time": 17182.55, "timestamp": "04:46:22", "text": "ジャック・ニックに特別な感謝を。"}, {"type": "subtitle", "time": 17186.47, "timestamp": "04:46:26", "text": "ここ。ありがとう"}, {"type": "subtitle", "time": 17194.15, "timestamp": "04:46:34", "text": "それでは、いつものように、またお会いしましょう。"}, {"type": "subtitle", "time": 17196.75, "timestamp": "04:46:36", "text": "次回。"}, {"type": "subtitle", "time": 17208.1, "timestamp": "04:46:48", "text": "はい、配信を終了しました。"}, {"type": "subtitle", "time": 17210.03, "timestamp": "04:46:50", "text": "[音楽]"}, {"type": "subtitle", "time": 17213.75, "timestamp": "04:46:53", "text": "あれは何でしょう？うん。はい。"}, {"type": "subtitle", "time": 17215.67, "timestamp": "04:46:55", "text": "今日は素敵でしたが、残念ながら"}]
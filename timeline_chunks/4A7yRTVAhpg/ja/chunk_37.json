[{"type": "subtitle", "time": 2224.93, "timestamp": "00:37:04", "text": "そうです。トマトも欲しいです。"}, {"type": "subtitle", "time": 2227.67, "timestamp": "00:37:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2236.79, "timestamp": "00:37:16", "text": "床にいる人は"}, {"type": "subtitle", "time": 2238.87, "timestamp": "00:37:18", "text": "すべて。彼女はただ料理をしなければならない"}, {"type": "subtitle", "time": 2240.75, "timestamp": "00:37:20", "text": "期待"}, {"type": "subtitle", "time": 2245.67, "timestamp": "00:37:25", "text": "本物。どちらにとっても大変だ"}, {"type": "subtitle", "time": 2249.13, "timestamp": "00:37:29", "text": "経験助成金。それは何ですか？"}, {"type": "subtitle", "time": 2250.91, "timestamp": "00:37:30", "text": "[音楽]"}, {"type": "subtitle", "time": 2254.109, "timestamp": "00:37:34", "text": "より多くのアップグレードカードを手に入れて、"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "経験。それはピザをメイン料理にするということだ。"}, {"type": "subtitle", "time": 2261.51, "timestamp": "00:37:41", "text": "あ、ピザが出てきた。"}, {"type": "subtitle", "time": 2264.069, "timestamp": "00:37:44", "text": "ピザができました。ああ、ピザがありますよ"}, {"type": "subtitle", "time": 2267.27, "timestamp": "00:37:47", "text": "今。どちらを試してみたいですか？"}, {"type": "subtitle", "time": 2269.99, "timestamp": "00:37:49", "text": "ピザかサラダか？"}, {"type": "subtitle", "time": 2273.19, "timestamp": "00:37:53", "text": "どちらの方があなたにとって良さそうですか？"}, {"type": "subtitle", "time": 2276.79, "timestamp": "00:37:56", "text": "どちらでも構わないが、サラダの方が"}]
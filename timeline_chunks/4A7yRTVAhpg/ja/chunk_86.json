[{"type": "subtitle", "time": 5161.629, "timestamp": "01:26:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5164.39, "timestamp": "01:26:04", "text": "無料。彼らは実際にミルクボトルを取ります"}, {"type": "subtitle", "time": 5168.07, "timestamp": "01:26:08", "text": "たとえあなたがそうしなくても、彼らが尋ねなくても。"}, {"type": "subtitle", "time": 5182.39, "timestamp": "01:26:22", "text": "もっと。待って、あなたは"}, {"type": "subtitle", "time": 5185.51, "timestamp": "01:26:25", "text": "コーヒーは、通常はそうではないので"}, {"type": "subtitle", "time": 5188.95, "timestamp": "01:26:28", "text": "ゲームに行くと、それは示します"}, {"type": "subtitle", "time": 5191.229, "timestamp": "01:26:31", "text": "汚い"}]
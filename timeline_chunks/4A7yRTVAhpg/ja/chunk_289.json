[{"type": "subtitle", "time": 17340.07, "timestamp": "04:49:00", "text": "YouTubeデビュー後、以前"}, {"type": "subtitle", "time": 17342.23, "timestamp": "04:49:02", "text": "その前に私は"}, {"type": "subtitle", "time": 17346.27, "timestamp": "04:49:06", "text": "デビュー前に好きになる"}, {"type": "subtitle", "time": 17350.23, "timestamp": "04:49:10", "text": "えーっと、1日前くらいに、私は"}, {"type": "subtitle", "time": 17352.31, "timestamp": "04:49:12", "text": "トレーラー。デビューのようにドロップします"}, {"type": "subtitle", "time": 17355.27, "timestamp": "04:49:15", "text": "予告編を観てからデビューします"}, {"type": "subtitle", "time": 17357.51, "timestamp": "04:49:17", "text": "そしてデビュー後に投稿します"}, {"type": "subtitle", "time": 17360.23, "timestamp": "04:49:20", "text": "Twitterで活動しているモデル。"}, {"type": "subtitle", "time": 17362.788, "timestamp": "04:49:22", "text": "うん、それはいいことだろう"}, {"type": "subtitle", "time": 17365.39, "timestamp": "04:49:25", "text": "単に落とすのではなく"}, {"type": "subtitle", "time": 17368.31, "timestamp": "04:49:28", "text": "ポスターとあらゆる宣伝を"}, {"type": "subtitle", "time": 17372.628, "timestamp": "04:49:32", "text": "実際、それが最適だろう。私は"}, {"type": "subtitle", "time": 17374.708, "timestamp": "04:49:34", "text": "500ccにしようかと考えている"}, {"type": "subtitle", "time": 17376.31, "timestamp": "04:49:36", "text": "特別だけど、好きになれないと思う"}, {"type": "subtitle", "time": 17379.35, "timestamp": "04:49:39", "text": "500に早く到達する。だから、"}, {"type": "subtitle", "time": 17382.15, "timestamp": "04:49:42", "text": "私はそれを捨てて"}, {"type": "subtitle", "time": 17384.15, "timestamp": "04:49:44", "text": "そこには。"}, {"type": "subtitle", "time": 17388.15, "timestamp": "04:49:48", "text": "うん。ああ、神様。えっと、一番大事なのは"}, {"type": "subtitle", "time": 17391.75, "timestamp": "04:49:51", "text": "実験してみるのも良いことだ、という考え方です。だからそれは"}, {"type": "subtitle", "time": 17394.15, "timestamp": "04:49:54", "text": "すべて順調です。"}, {"type": "subtitle", "time": 17396.868, "timestamp": "04:49:56", "text": "私も似たようなアイデアを探しています"}]
[{"type": "subtitle", "time": 6489.07, "timestamp": "01:48:09", "text": "H. わかりました。"}, {"type": "subtitle", "time": 6492.629, "timestamp": "01:48:12", "text": "うん。うん。さあ行こう。私たちならできる。"}, {"type": "subtitle", "time": 6505.07, "timestamp": "01:48:25", "text": "[音楽]"}, {"type": "subtitle", "time": 6507.51, "timestamp": "01:48:27", "text": "行く。わあ、たくさんの人が来ている"}]
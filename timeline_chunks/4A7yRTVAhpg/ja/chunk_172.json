[{"type": "subtitle", "time": 10322.63, "timestamp": "02:52:02", "text": "蚊も何もかも大丈夫"}, {"type": "subtitle", "time": 10325.23, "timestamp": "02:52:05", "text": "そんな感じ"}, {"type": "subtitle", "time": 10328.55, "timestamp": "02:52:08", "text": "待って、それは何？"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "つまり、例えばあなたが死んで、"}, {"type": "subtitle", "time": 10335.51, "timestamp": "02:52:15", "text": "天国に行くとか、そんな感じですね。"}, {"type": "subtitle", "time": 10337.99, "timestamp": "02:52:17", "text": "究極の昇進仕事"}, {"type": "subtitle", "time": 10339.71, "timestamp": "02:52:19", "text": "スピリチュアル"}, {"type": "subtitle", "time": 10343.87, "timestamp": "02:52:23", "text": "イェシャ"}, {"type": "subtitle", "time": 10347.19, "timestamp": "02:52:27", "text": "ああ、わかりました。それが涅槃だ。わかった。"}, {"type": "subtitle", "time": 10348.95, "timestamp": "02:52:28", "text": "ガッチャ。"}, {"type": "subtitle", "time": 10353.269, "timestamp": "02:52:33", "text": "はい。それはバンドのようなものでもある。"}, {"type": "subtitle", "time": 10355.99, "timestamp": "02:52:35", "text": "ああ、それはあなたが火をつけたあの棒みたいなものですね"}, {"type": "subtitle", "time": 10368.63, "timestamp": "02:52:48", "text": "どの棒のこと？棒状のもの。光を当てる"}, {"type": "subtitle", "time": 10371.11, "timestamp": "02:52:51", "text": "まるで喫煙者みたいに上空にいるんだよ。それ"}, {"type": "subtitle", "time": 10374.07, "timestamp": "02:52:54", "text": "秩序も整っていて、品揃えも良い。あれは"}, {"type": "subtitle", "time": 10376.63, "timestamp": "02:52:56", "text": "蚊のためにそれを置いたのに、いや、"}]
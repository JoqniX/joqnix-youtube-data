[{"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "VC。彼らはまだ行方不明だ。うん、"}, {"type": "subtitle", "time": 14766.55, "timestamp": "04:06:06", "text": "彼らは、ああ、みんなVCだ。"}, {"type": "subtitle", "time": 14775.83, "timestamp": "04:06:15", "text": "2番目です。何てことだ。ええ、彼らは"}, {"type": "subtitle", "time": 14778.79, "timestamp": "04:06:18", "text": "すべて揃っている。ああ、ハンマーのヒーローたち"}, {"type": "subtitle", "time": 14781.83, "timestamp": "04:06:21", "text": "時計。くそ。"}, {"type": "subtitle", "time": 14783.91, "timestamp": "04:06:23", "text": "知っている。待って、みんなが遊んでる理由"}, {"type": "subtitle", "time": 14786.229, "timestamp": "04:06:26", "text": "ハンマーウォッチ？良いですか？ああ、そうだ"}, {"type": "subtitle", "time": 14788.07, "timestamp": "04:06:28", "text": "良い。とても楽しいです。わかった、それで何？"}, {"type": "subtitle", "time": 14791.99, "timestamp": "04:06:31", "text": "何が起こったかというと、レッドがそれを買ったんです。"}, {"type": "subtitle", "time": 14795.269, "timestamp": "04:06:35", "text": "ええと、彼は私にコピーをプレゼントしてくれたんです。"}, {"type": "subtitle", "time": 14797.429, "timestamp": "04:06:37", "text": "えっと、それから私たちは二人とも"}, {"type": "subtitle", "time": 14799.269, "timestamp": "04:06:39", "text": "VCでムラと一緒にいたとき、"}, {"type": "subtitle", "time": 14802.469, "timestamp": "04:06:42", "text": "ああ、やってみようよ、それで、"}, {"type": "subtitle", "time": 14805.83, "timestamp": "04:06:45", "text": "ムラにも一冊買ってあげたよ。"}, {"type": "subtitle", "time": 14808.63, "timestamp": "04:06:48", "text": "そしてその後、V3が演奏していたのをご存知でしょう"}, {"type": "subtitle", "time": 14811.269, "timestamp": "04:06:51", "text": "そしてショーカが私たちが遊んでいるのを見て"}, {"type": "subtitle", "time": 14814.95, "timestamp": "04:06:54", "text": "ショーカのためにコピーを買って、"}, {"type": "subtitle", "time": 14818.15, "timestamp": "04:06:58", "text": "VCとVic、VicとFujiだと思います。だから私たちは"}]
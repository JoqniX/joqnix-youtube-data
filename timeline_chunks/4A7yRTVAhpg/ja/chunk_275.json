[{"type": "subtitle", "time": 16502.15, "timestamp": "04:35:02", "text": "今日で21歳、男。いいえ、次は22番です。うん。おお、"}, {"type": "subtitle", "time": 16505.269, "timestamp": "04:35:05", "text": "今日は日曜日です。うん。私は忘れていた、私たちはまだ"}, {"type": "subtitle", "time": 16507.269, "timestamp": "04:35:07", "text": "終わらせるのにあと8日くらいかかるかな"}, {"type": "subtitle", "time": 16509.67, "timestamp": "04:35:09", "text": "今月いっぱい。だから、大丈夫です。うん。"}, {"type": "subtitle", "time": 16511.91, "timestamp": "04:35:11", "text": "さらに8日間の苦しみ"}, {"type": "subtitle", "time": 16513.429, "timestamp": "04:35:13", "text": "ホラー。"}, {"type": "subtitle", "time": 16515.189, "timestamp": "04:35:15", "text": "はい。"}, {"type": "subtitle", "time": 16517.75, "timestamp": "04:35:17", "text": "だから、何も見なかったとしても"}, {"type": "subtitle", "time": 16520.551, "timestamp": "04:35:20", "text": "恐ろしいことに、"}, {"type": "subtitle", "time": 16523.109, "timestamp": "04:35:23", "text": "ええ、ちょっと驚かせてしまったかもしれませんね。"}, {"type": "subtitle", "time": 16526.551, "timestamp": "04:35:26", "text": "ファスモのように、しかし私たちは"}, {"type": "subtitle", "time": 16530.15, "timestamp": "04:35:30", "text": "何でもかんでもむさぼり食うようにする。うん。"}, {"type": "subtitle", "time": 16531.75, "timestamp": "04:35:31", "text": "たとえあなたが2回死んで、"}, {"type": "subtitle", "time": 16533.59, "timestamp": "04:35:33", "text": "ジャンプにも慣れてきたね"}, {"type": "subtitle", "time": 16536.789, "timestamp": "04:35:36", "text": "怖い話もあるよ。だから、私と同じように、"}, {"type": "subtitle", "time": 16538.109, "timestamp": "04:35:38", "text": "その"}, {"type": "subtitle", "time": 16543.83, "timestamp": "04:35:43", "text": "大丈夫。 H また、あなたは、"}, {"type": "subtitle", "time": 16547.269, "timestamp": "04:35:47", "text": "FasmophobiaをFPSとしてプレイするような感じ。"}, {"type": "subtitle", "time": 16550.869, "timestamp": "04:35:50", "text": "Devをプレイするのは、"}, {"type": "subtitle", "time": 16552.629, "timestamp": "04:35:52", "text": "FPSゲームは走り回らなければならないから"}]
[{"type": "subtitle", "time": 15180.429, "timestamp": "04:13:00", "text": "神。誰が気にするんだ？私は行くつもりです"}, {"type": "subtitle", "time": 15183.59, "timestamp": "04:13:03", "text": "試す。うん。"}, {"type": "subtitle", "time": 15185.79, "timestamp": "04:13:05", "text": "誰かが私のネオンを盗んだ"}, {"type": "subtitle", "time": 15189.269, "timestamp": "04:13:09", "text": "家。何てことだ。"}, {"type": "subtitle", "time": 15191.189, "timestamp": "04:13:11", "text": "何てことだ。あなたは最高のネオンです。あなたは"}, {"type": "subtitle", "time": 15193.429, "timestamp": "04:13:13", "text": "最高のネオン。あなたはいつも"}, {"type": "subtitle", "time": 15206.309, "timestamp": "04:13:26", "text": "ああ、今度は死んだふりをするつもりか？"}, {"type": "subtitle", "time": 15209.149, "timestamp": "04:13:29", "text": "いつものようにスカイに加入します。"}, {"type": "subtitle", "time": 15213.63, "timestamp": "04:13:33", "text": "ニース。私はスカイが大好きです。これは"}, {"type": "subtitle", "time": 15217.51, "timestamp": "04:13:37", "text": "素晴らしい。とても楽しかった。後で探してみます。"}, {"type": "subtitle", "time": 15219.63, "timestamp": "04:13:39", "text": "配信に集中します。"}, {"type": "subtitle", "time": 15222.91, "timestamp": "04:13:42", "text": "わかった。私は自分の"}, {"type": "subtitle", "time": 15225.55, "timestamp": "04:13:45", "text": "最高。うん。"}, {"type": "subtitle", "time": 15228.229, "timestamp": "04:13:48", "text": "ネオン。いいえ、していません。ネオンは手に入らなかった。"}, {"type": "subtitle", "time": 15231.469, "timestamp": "04:13:51", "text": "ランダムなもの"}, {"type": "subtitle", "time": 15234.63, "timestamp": "04:13:54", "text": "ネオンを手に入れた。"}]
[{"type": "subtitle", "time": 17582.948, "timestamp": "04:53:02", "text": "とても薄い。あなたは1つや"}, {"type": "subtitle", "time": 17585.51, "timestamp": "04:53:05", "text": "またもや見逃した。それは通常"}, {"type": "subtitle", "time": 17587.27, "timestamp": "04:53:07", "text": "起こる。薄く広げるということは"}, {"type": "subtitle", "time": 17589.75, "timestamp": "04:53:09", "text": "それは否定的な意味合いで、つまり"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "あれこれやりすぎないように。よし。それで"}, {"type": "subtitle", "time": 17594.788, "timestamp": "04:53:14", "text": "だから私は「～のような」と言っているのです"}, {"type": "subtitle", "time": 17598.15, "timestamp": "04:53:18", "text": "YouTubeをやっているように、あなたは本当に"}, {"type": "subtitle", "time": 17600.868, "timestamp": "04:53:20", "text": "Twitch、Facebookもやって、いいねも"}, {"type": "subtitle", "time": 17603.11, "timestamp": "04:53:23", "text": "動画を編集する。それはまるで"}, {"type": "subtitle", "time": 17605.948, "timestamp": "04:53:25", "text": "疲れる。"}, {"type": "subtitle", "time": 17609.83, "timestamp": "04:53:29", "text": "うん。私の中には試してみたかった"}, {"type": "subtitle", "time": 17611.67, "timestamp": "04:53:31", "text": "夏のキャスティングですが、私の一部でもあります"}, {"type": "subtitle", "time": 17615.83, "timestamp": "04:53:35", "text": "「いや、やめとけよ」って感じだった。一瞬。"}, {"type": "subtitle", "time": 17618.23, "timestamp": "04:53:38", "text": "うん。心配しないで。私はそうしたい"}, {"type": "subtitle", "time": 17621.27, "timestamp": "04:53:41", "text": "私は何でも最高に頑張る"}, {"type": "subtitle", "time": 17623.27, "timestamp": "04:53:43", "text": "それを のように する ことができます"}, {"type": "subtitle", "time": 17626.31, "timestamp": "04:53:46", "text": "できる限りプロフェッショナルに。"}, {"type": "subtitle", "time": 17629.35, "timestamp": "04:53:49", "text": "だから、その点は心配しないでください。えっと、"}, {"type": "subtitle", "time": 17632.19, "timestamp": "04:53:52", "text": "試してみる価値はある。実験する"}, {"type": "subtitle", "time": 17636.11, "timestamp": "04:53:56", "text": "それ。つまり、あなたはそれを理解したということですね。その"}]
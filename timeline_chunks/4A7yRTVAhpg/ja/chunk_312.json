[{"type": "subtitle", "time": 18721.51, "timestamp": "05:12:01", "text": "うん。うん。あなたは何が好きですか？ゾンビ"}, {"type": "subtitle", "time": 18724.39, "timestamp": "05:12:04", "text": "ピューピューとか、そういう感じ。の"}, {"type": "subtitle", "time": 18726.55, "timestamp": "05:12:06", "text": "もちろん、私はピューピュー撃つのが好きですが、ええ、私は"}, {"type": "subtitle", "time": 18727.83, "timestamp": "05:12:07", "text": "ゾンビゲームはこれまでプレイしたことがありません。"}, {"type": "subtitle", "time": 18734.948, "timestamp": "05:12:14", "text": "まだあと2試合残っています"}, {"type": "subtitle", "time": 18737.11, "timestamp": "05:12:17", "text": "死んだ原神。"}, {"type": "subtitle", "time": 18739.67, "timestamp": "05:12:19", "text": "待てよ、原神は無料じゃないか。そうそう。"}, {"type": "subtitle", "time": 18742.31, "timestamp": "05:12:22", "text": "私は原神をプレイするだけです。はい、できます"}, {"type": "subtitle", "time": 18743.91, "timestamp": "05:12:23", "text": "原神。"}, {"type": "subtitle", "time": 18745.35, "timestamp": "05:12:25", "text": "私たちと一緒に原人（ゲンジン）をプレイしませんか？何"}, {"type": "subtitle", "time": 18749.59, "timestamp": "05:12:29", "text": "ところで、あなたはどのサーバーに接続していますか？なるほど。"}, {"type": "subtitle", "time": 18753.67, "timestamp": "05:12:33", "text": "素晴らしいね。まるでve のようなグラインドです"}, {"type": "subtitle", "time": 18756.07, "timestamp": "05:12:36", "text": "そして遺伝子。私を見て。私は決して触らない"}, {"type": "subtitle", "time": 18757.91, "timestamp": "05:12:37", "text": "原神。"}, {"type": "subtitle", "time": 18766.868, "timestamp": "05:12:46", "text": "ああ、体重を貯めて"}, {"type": "subtitle", "time": 18772.628, "timestamp": "05:12:52", "text": "相変わらず、まるでグラインドしているような感じだ。"}, {"type": "subtitle", "time": 18774.788, "timestamp": "05:12:54", "text": "重量とショットガン"}, {"type": "subtitle", "time": 18777.43, "timestamp": "05:12:57", "text": "他の誰かが"}]
[{"type": "subtitle", "time": 14522.229, "timestamp": "04:02:02", "text": "触ってみたけど。私は本当に落ち込んでいる。"}, {"type": "subtitle", "time": 14523.91, "timestamp": "04:02:03", "text": "つまり、もし皆さんが望むなら、"}, {"type": "subtitle", "time": 14525.99, "timestamp": "04:02:05", "text": "君たちは先に行ってくれ、私はただそこにいるだけだ"}, {"type": "subtitle", "time": 14530.15, "timestamp": "04:02:10", "text": "モデルサポートのため。はい。わかった。"}, {"type": "subtitle", "time": 14533.55, "timestamp": "04:02:13", "text": "わかった。何をプレイしたいですか？"}, {"type": "subtitle", "time": 14537.67, "timestamp": "04:02:17", "text": "えっと、例えばどんな感じか見てみましょう。私は"}, {"type": "subtitle", "time": 14539.55, "timestamp": "04:02:19", "text": "何？"}, {"type": "subtitle", "time": 14548.67, "timestamp": "04:02:28", "text": "ベースBPM"}, {"type": "subtitle", "time": 14552.91, "timestamp": "04:02:32", "text": "エイペックスジャンプキングデスティニー"}, {"type": "subtitle", "time": 14556.229, "timestamp": "04:02:36", "text": "死者を追う。ダウンロードすれば"}, {"type": "subtitle", "time": 14558.79, "timestamp": "04:02:38", "text": "あなたが望むもの。好きにならないだろう"}, {"type": "subtitle", "time": 14561.67, "timestamp": "04:02:41", "text": "上。少し話をして、"}, {"type": "subtitle", "time": 14564.07, "timestamp": "04:02:44", "text": "ダウンロードするだけで、すぐにプレイできます。"}, {"type": "subtitle", "time": 14565.95, "timestamp": "04:02:45", "text": "でもカウンターがある"}, {"type": "subtitle", "time": 14569.189, "timestamp": "04:02:49", "text": "ストライク。いいえ、私はそれをアンインストールしました。"}, {"type": "subtitle", "time": 14570.95, "timestamp": "04:02:50", "text": "ダウンロードする必要がありました。あ、待って。あなた"}, {"type": "subtitle", "time": 14571.87, "timestamp": "04:02:51", "text": "何だと思う？"}, {"type": "subtitle", "time": 14574.51, "timestamp": "04:02:54", "text": "バレンタイン"}, {"type": "subtitle", "time": 14577.349, "timestamp": "04:02:57", "text": "ヴァレント。そうそう。私はvalができます。うん、"}, {"type": "subtitle", "time": 14579.91, "timestamp": "04:02:59", "text": "もちろん。うん。でも、どれくらいの間"}]
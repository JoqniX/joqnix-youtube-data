[{"type": "subtitle", "time": 12240.07, "timestamp": "03:24:00", "text": "召喚"}, {"type": "subtitle", "time": 12242.07, "timestamp": "03:24:02", "text": "金の召喚。わかった。わかった。に着く"}, {"type": "subtitle", "time": 12244.469, "timestamp": "03:24:04", "text": "ロビー。"}, {"type": "subtitle", "time": 12247.75, "timestamp": "03:24:07", "text": "ロビーか。私たちが好きな場所"}, {"type": "subtitle", "time": 12250.229, "timestamp": "03:24:10", "text": "救急キットを全部落としてしまった。 1秒。"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "それを置いてみましょう。アンナは"}, {"type": "subtitle", "time": 12253.15, "timestamp": "03:24:13", "text": "カバーする"}, {"type": "subtitle", "time": 12256.55, "timestamp": "03:24:16", "text": "入り口。私がスローワに向き合うか、それとも彼女が向き合うか"}, {"type": "subtitle", "time": 12259.67, "timestamp": "03:24:19", "text": "体をブロックする？彼女はあなたの進路を体で塞ぐでしょう。"}, {"type": "subtitle", "time": 12269.19, "timestamp": "03:24:29", "text": "あらら。あなたは"}, {"type": "subtitle", "time": 12272.79, "timestamp": "03:24:32", "text": "ああ、そうするかもしれないね。"}, {"type": "subtitle", "time": 12274.429, "timestamp": "03:24:34", "text": "よし、もうすぐだ"}, {"type": "subtitle", "time": 12278.269, "timestamp": "03:24:38", "text": "終わり。戻ってきます。 1 2"}, {"type": "subtitle", "time": 12283.59, "timestamp": "03:24:43", "text": "3 4 5 6 7 8 よし、ガソリンをあと2つ。"}, {"type": "subtitle", "time": 12291.59, "timestamp": "03:24:51", "text": "来るよ。ただ、あてもなく連れ回してくれればいい。私"}, {"type": "subtitle", "time": 12293.03, "timestamp": "03:24:53", "text": "あなたに、"}, {"type": "subtitle", "time": 12296.469, "timestamp": "03:24:56", "text": "ヤギか何か。えっと、皆さんKを押してください。"}, {"type": "subtitle", "time": 12298.389, "timestamp": "03:24:58", "text": "鍵は何個持っていますか？鍵"}]
[{"type": "subtitle", "time": 660.63, "timestamp": "00:11:00", "text": "進行中またはストリームを一緒に"}, {"type": "subtitle", "time": 663.43, "timestamp": "00:11:03", "text": "あれ。"}, {"type": "subtitle", "time": 667.11, "timestamp": "00:11:07", "text": "ああ、うっかり置き忘れたんですね。私はそれをそのままにしておいた。"}, {"type": "subtitle", "time": 669.069, "timestamp": "00:11:09", "text": "1つ"}, {"type": "subtitle", "time": 678.069, "timestamp": "00:11:18", "text": "一緒に配信しようか？"}, {"type": "subtitle", "time": 680.15, "timestamp": "00:11:20", "text": "ああ、私が勘定をしなければならないのですか"}, {"type": "subtitle", "time": 683.35, "timestamp": "00:11:23", "text": "開いているとか？ああ、まずは"}, {"type": "subtitle", "time": 684.949, "timestamp": "00:11:24", "text": "迷惑な。"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "ああ、それは困ったものだ。うん。だから、私たちは"}, {"type": "subtitle", "time": 690.79, "timestamp": "00:11:30", "text": "実際にやらなきゃいけないのは、エネルギーを消耗するから"}, {"type": "subtitle", "time": 693.63, "timestamp": "00:11:33", "text": "Wi-Fiをもっと利用しよう。"}, {"type": "subtitle", "time": 695.91, "timestamp": "00:11:35", "text": "そうそう。大丈夫です。うん、やらないでおこう"}, {"type": "subtitle", "time": 698.97, "timestamp": "00:11:38", "text": "それ。大丈夫です。必要ない。"}, {"type": "subtitle", "time": 701.75, "timestamp": "00:11:41", "text": "[音楽]"}, {"type": "subtitle", "time": 705.59, "timestamp": "00:11:45", "text": "こんにちは。参加しますか？ああ、そうだよ。あなたは"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "自分？それとも歩いて行かなければならないのでしょうか"}]
[{"type": "subtitle", "time": 4141.669, "timestamp": "01:09:01", "text": "[音楽]"}, {"type": "subtitle", "time": 4144.789, "timestamp": "01:09:04", "text": "夜にコーヒーを飲む人なんているの？"}, {"type": "subtitle", "time": 4146.789, "timestamp": "01:09:06", "text": "実は私なんです。私はコーヒーを飲みます"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "カウンタ。"}, {"type": "subtitle", "time": 4169.829, "timestamp": "01:09:29", "text": "ダイニングテーブルが必要です。ええ、でも私たちは"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "十分なお金を持っている。小型昇降機。何が"}, {"type": "subtitle", "time": 4174.87, "timestamp": "01:09:34", "text": "それ？"}, {"type": "subtitle", "time": 4177.749, "timestamp": "01:09:37", "text": "接続する。それは全てをつなぐ。待って。"}, {"type": "subtitle", "time": 4179.95, "timestamp": "01:09:39", "text": "わかった、行くよ"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "これを取り出す。それは無料です。"}, {"type": "subtitle", "time": 4185.39, "timestamp": "01:09:45", "text": "いや、それは"}, {"type": "subtitle", "time": 4192.55, "timestamp": "01:09:52", "text": "棚に置きます。私"}, {"type": "subtitle", "time": 4194.95, "timestamp": "01:09:54", "text": "推測"}, {"type": "subtitle", "time": 4197.75, "timestamp": "01:09:57", "text": "棚には1つしか置けません。おお、"}]
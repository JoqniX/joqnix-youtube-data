[{"type": "subtitle", "time": 13260.55, "timestamp": "03:41:00", "text": "による。太ももの痛みが少しでも和らぐといいですね。"}, {"type": "subtitle", "time": 13266.03, "timestamp": "03:41:06", "text": "水を入れてください。"}, {"type": "subtitle", "time": 13269.79, "timestamp": "03:41:09", "text": "はい。私は戻ってきます。"}, {"type": "subtitle", "time": 13273.67, "timestamp": "03:41:13", "text": "はい。町で遊ぶのは、私たちは決して"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "町で遊んだ。私たちはそうしましたが、好きではありませんでした"}, {"type": "subtitle", "time": 13284.91, "timestamp": "03:41:24", "text": "何か。"}, {"type": "subtitle", "time": 13288.229, "timestamp": "03:41:28", "text": "こんにちは。ああ、私のキーがしばらく使えなくなりました"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "理由。ああ、でも、ああ、覚えてるよ"}, {"type": "subtitle", "time": 13291.91, "timestamp": "03:41:31", "text": "面倒くさそうだったので"}, {"type": "subtitle", "time": 13295.75, "timestamp": "03:41:35", "text": "プレイしなかった。うん。おお。ああ、私たちも"}, {"type": "subtitle", "time": 13298.309, "timestamp": "03:41:38", "text": "時間も切れた。だから、私たちはプレーしなかった"}, {"type": "subtitle", "time": 13306.95, "timestamp": "03:41:46", "text": "あなたがやりたいことは何でも、"}, {"type": "subtitle", "time": 13309.59, "timestamp": "03:41:49", "text": "決して単純な話ではない。"}, {"type": "subtitle", "time": 13311.75, "timestamp": "03:41:51", "text": "つまり、シンプルさという点では、アンナは"}, {"type": "subtitle", "time": 13315.03, "timestamp": "03:41:55", "text": "最も単純な方法です。その後、"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "それは何て言うんだっけ？宿屋。クモ"}]
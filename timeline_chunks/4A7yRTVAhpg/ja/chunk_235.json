[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "神話級。神話級。えっと、私は"}, {"type": "subtitle", "time": 14104.229, "timestamp": "03:55:04", "text": "コンピューター。鍵を見つけた。あなたなら"}, {"type": "subtitle", "time": 14107.349, "timestamp": "03:55:07", "text": "あなたが洗うと彼女を刺激したいですか?"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "卵か、ああ、だめだ。いいえ。"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "それらを看板に載せてください。わかった。私は"}, {"type": "subtitle", "time": 14114.63, "timestamp": "03:55:14", "text": "卵を洗ってください。わかった。持続する。所有"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "私は扉を開けている。待って。"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "いや、いや、いや。私は犠牲になるのは好きじゃない。"}, {"type": "subtitle", "time": 14129.429, "timestamp": "03:55:29", "text": "ちょっと洗っているだけです。ああ、わかりました。私は"}, {"type": "subtitle", "time": 14132.389, "timestamp": "03:55:32", "text": "食器洗い。大丈夫です。"}, {"type": "subtitle", "time": 14135.229, "timestamp": "03:55:35", "text": "1号室。部屋はどこですか"}, {"type": "subtitle", "time": 14145.71, "timestamp": "03:55:45", "text": "ごめん。見てください"}]
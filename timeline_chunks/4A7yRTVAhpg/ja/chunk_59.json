[{"type": "subtitle", "time": 3540.23, "timestamp": "00:59:00", "text": "私はこれを必要としません。えっと、君"}, {"type": "subtitle", "time": 3542.23, "timestamp": "00:59:02", "text": "いずれ必要になるだろう。つまり"}, {"type": "subtitle", "time": 3544.829, "timestamp": "00:59:04", "text": "イライラする。"}, {"type": "subtitle", "time": 3548.829, "timestamp": "00:59:08", "text": "ああ、ジョー、元気かい？私は"}, {"type": "subtitle", "time": 3553.03, "timestamp": "00:59:13", "text": "素晴らしい。睡眠不足。でもそうですね、"}, {"type": "chat", "time": 3555.732, "timestamp": "00:59:15", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "And viola"}, {"type": "subtitle", "time": 3557.27, "timestamp": "00:59:17", "text": "ひどく睡眠不足だ。私たち二人。はい、"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "知っている。"}, {"type": "subtitle", "time": 3575.75, "timestamp": "00:59:35", "text": "わかった。それで、これはどういう仕組みになっているのでしょうか？"}, {"type": "subtitle", "time": 3580.27, "timestamp": "00:59:40", "text": "だから、一度入れたら、"}, {"type": "subtitle", "time": 3583.47, "timestamp": "00:59:43", "text": "えっと、基本的には、"}, {"type": "subtitle", "time": 3587.99, "timestamp": "00:59:47", "text": "汚れた食器を入れて、それから"}, {"type": "subtitle", "time": 3591.75, "timestamp": "00:59:51", "text": "えっと、別の番号を押してください。でも私は"}, {"type": "chat", "time": 3592.933, "timestamp": "00:59:52", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Cooking yum yum yum. (Hopefully)"}, {"type": "subtitle", "time": 3594.47, "timestamp": "00:59:54", "text": "満員になるまで待つことをお勧めします。"}, {"type": "subtitle", "time": 3596.069, "timestamp": "00:59:56", "text": "何度も洗う必要はありません"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "回。"}]
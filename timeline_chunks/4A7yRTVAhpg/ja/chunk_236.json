[{"type": "subtitle", "time": 14171.67, "timestamp": "03:56:11", "text": "だから卵を洗って"}, {"type": "subtitle", "time": 14174.389, "timestamp": "03:56:14", "text": "それを私の手に握っていてください。うん、君"}, {"type": "subtitle", "time": 14177.269, "timestamp": "03:56:17", "text": "できる。手に持っているものは何ですか？何"}, {"type": "subtitle", "time": 14179.91, "timestamp": "03:56:19", "text": "どんなシンボルをお持ちですか？わからない どうすれば"}, {"type": "subtitle", "time": 14181.63, "timestamp": "03:56:21", "text": "私はそれを知っています？"}, {"type": "subtitle", "time": 14185.11, "timestamp": "03:56:25", "text": "えっと、卵は洗いましたか？いいえ、違います"}, {"type": "subtitle", "time": 14187.51, "timestamp": "03:56:27", "text": "まだ。はい、卵を洗う場合は"}, {"type": "subtitle", "time": 14190.389, "timestamp": "03:56:30", "text": "欲しい。"}, {"type": "subtitle", "time": 14191.83, "timestamp": "03:56:31", "text": "卵を洗うことができるので、"}, {"type": "subtitle", "time": 14194.07, "timestamp": "03:56:34", "text": "もしあなたがそれを手に持っていれば"}, {"type": "subtitle", "time": 14208.55, "timestamp": "03:56:48", "text": "おっと。わかった。これは不気味な目のシンボルだ。"}, {"type": "subtitle", "time": 14211.75, "timestamp": "03:56:51", "text": "不気味な目のシンボル。ええ、目のシンボルですね。"}]
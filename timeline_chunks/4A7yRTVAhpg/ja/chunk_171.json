[{"type": "subtitle", "time": 10263.03, "timestamp": "02:51:03", "text": "みんなに会えなくて寂しかったよ。えっと、君たちは何者なの？"}, {"type": "subtitle", "time": 10265.15, "timestamp": "02:51:05", "text": "行う"}, {"type": "subtitle", "time": 10268.19, "timestamp": "02:51:08", "text": "良い。だから、おやすみなさい"}, {"type": "subtitle", "time": 10271.389, "timestamp": "02:51:11", "text": "私が考えていた時間"}, {"type": "subtitle", "time": 10275.59, "timestamp": "02:51:15", "text": "私がやっていたこと。待って、"}, {"type": "subtitle", "time": 10287.269, "timestamp": "02:51:27", "text": "今日の調子はどうですか？私は、私は"}, {"type": "subtitle", "time": 10289.51, "timestamp": "02:51:29", "text": "良い。元気ですか？"}, {"type": "subtitle", "time": 10290.99, "timestamp": "02:51:30", "text": "私"}, {"type": "subtitle", "time": 10294.07, "timestamp": "02:51:34", "text": "午前。元気です。"}, {"type": "subtitle", "time": 10298.79, "timestamp": "02:51:38", "text": "なんてこった。あなたは死にかけているのですか？私は誓います。"}, {"type": "subtitle", "time": 10299.71, "timestamp": "02:51:39", "text": "おお"}, {"type": "subtitle", "time": 10303.51, "timestamp": "02:51:43", "text": "いいえ。何てことだ。お元気でいらっしゃることを願っています。"}, {"type": "subtitle", "time": 10313.67, "timestamp": "02:51:53", "text": "待って、ニルヴァーナって何？待って、何が"}, {"type": "subtitle", "time": 10315.95, "timestamp": "02:51:55", "text": "涅槃？上昇するのと同じように"}, {"type": "subtitle", "time": 10319.91, "timestamp": "02:51:59", "text": "アセンス・アセンドメント、エッセンスのようなもの"}]
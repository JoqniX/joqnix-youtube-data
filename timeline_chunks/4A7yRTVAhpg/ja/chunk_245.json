[{"type": "subtitle", "time": 14713.51, "timestamp": "04:05:13", "text": "あ、すみません。ああ、君たちは"}, {"type": "subtitle", "time": 14715.269, "timestamp": "04:05:15", "text": "Valerantをプレイしますか？"}, {"type": "subtitle", "time": 14717.75, "timestamp": "04:05:17", "text": "うん。ああ、あなたも参加したいの？ああ、いや、いや、"}, {"type": "subtitle", "time": 14721.59, "timestamp": "04:05:21", "text": "いいえ。私は休憩が好きです。ええ、私は一般的に"}, {"type": "subtitle", "time": 14724.229, "timestamp": "04:05:24", "text": "何かから少し離れたい気分だ。私は"}, {"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "ただ見に行くだけです。私はしない"}, {"type": "subtitle", "time": 14728.309, "timestamp": "04:05:28", "text": "何でもプレイしてください。大丈夫です。聞こえます"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "私たち。ええ、私たちの叫び声が聞こえるでしょう。"}, {"type": "subtitle", "time": 14741.99, "timestamp": "04:05:41", "text": "私はミシックでプレイし、彼女が好きです"}, {"type": "subtitle", "time": 14746.389, "timestamp": "04:05:46", "text": "少し前に友達とメイクアップアーティストと会いました。そうそう。"}, {"type": "subtitle", "time": 14748.309, "timestamp": "04:05:48", "text": "数時間前と同じように、以前と同じように"}, {"type": "subtitle", "time": 14750.469, "timestamp": "04:05:50", "text": "ストリーム。"}, {"type": "subtitle", "time": 14753.189, "timestamp": "04:05:53", "text": "Muaはたぶんどこかへ行ってしまったと思う"}, {"type": "subtitle", "time": 14755.03, "timestamp": "04:05:55", "text": "寝る時間か何かだろう。"}, {"type": "subtitle", "time": 14758.71, "timestamp": "04:05:58", "text": "はい。いいえ、彼はまだVCにいます。"}]
[{"type": "subtitle", "time": 17761.59, "timestamp": "04:56:01", "text": "悪意があると思う、それはシングルだと思う"}, {"type": "subtitle", "time": 17763.51, "timestamp": "04:56:03", "text": "プレイヤーなので一緒にプレイできません"}, {"type": "subtitle", "time": 17766.708, "timestamp": "04:56:06", "text": "まるで、まるで、私たちは1つプレイしなければならないかのように"}, {"type": "subtitle", "time": 17768.948, "timestamp": "04:56:08", "text": "そして誰かが反応しなければならない"}, {"type": "subtitle", "time": 17773.75, "timestamp": "04:56:13", "text": "そうですね、そういうことです"}, {"type": "subtitle", "time": 17776.31, "timestamp": "04:56:16", "text": "そう、これは一種のウォッチアロングみたいなものだ"}, {"type": "subtitle", "time": 17780.03, "timestamp": "04:56:20", "text": "でも、まるで一人の男がそれをプレイしているみたいだ。"}, {"type": "subtitle", "time": 17781.99, "timestamp": "04:56:21", "text": "[音楽]"}, {"type": "subtitle", "time": 17784.31, "timestamp": "04:56:24", "text": "うん。先ほども言ったように、ゲームスタイルは1つ"}, {"type": "subtitle", "time": 17787.27, "timestamp": "04:56:27", "text": "場所やその他の反応。"}, {"type": "subtitle", "time": 17790.07, "timestamp": "04:56:30", "text": "うん。はい、可能です。うん、"}, {"type": "subtitle", "time": 17792.948, "timestamp": "04:56:32", "text": "それは面白そうですね。楽しそうですね。そして"}, {"type": "subtitle", "time": 17799.03, "timestamp": "04:56:39", "text": "それを何と呼べばいいですか？なぜなら私は"}, {"type": "subtitle", "time": 17801.39, "timestamp": "04:56:41", "text": "ゲームの陰鬱なスタイルとは呼べない。"}, {"type": "subtitle", "time": 17805.83, "timestamp": "04:56:45", "text": "そんなのうまくいくわけないだろ。"}, {"type": "subtitle", "time": 17809.27, "timestamp": "04:56:49", "text": "いいえ、私は生で見たものもいくつか見ています"}, {"type": "subtitle", "time": 17811.43, "timestamp": "04:56:51", "text": "YouTube は日本の YouTuber と同じように"}, {"type": "subtitle", "time": 17813.11, "timestamp": "04:56:53", "text": "それ。"}, {"type": "subtitle", "time": 17816.51, "timestamp": "04:56:56", "text": "それは何と呼ばれているのですか？"}]
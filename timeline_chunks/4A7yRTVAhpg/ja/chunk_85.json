[{"type": "subtitle", "time": 5104.149, "timestamp": "01:25:04", "text": "変な感じがする。"}, {"type": "subtitle", "time": 5107.03, "timestamp": "01:25:07", "text": "何でも。待って、待って、待って、"}, {"type": "subtitle", "time": 5109.709, "timestamp": "01:25:09", "text": "待って。"}, {"type": "subtitle", "time": 5113.91, "timestamp": "01:25:13", "text": "えっと、これはここに置いてください。こちらは赤くなります。"}, {"type": "subtitle", "time": 5118.07, "timestamp": "01:25:18", "text": "こちらは赤くなります。そして、私たちは大丈夫です。"}, {"type": "subtitle", "time": 5120.79, "timestamp": "01:25:20", "text": "わかった。彼らが入れるかどうかはわかりません。"}, {"type": "subtitle", "time": 5122.48, "timestamp": "01:25:22", "text": "しかし、誰にも分からない。"}, {"type": "subtitle", "time": 5126.87, "timestamp": "01:25:26", "text": "[音楽]"}, {"type": "subtitle", "time": 5128.629, "timestamp": "01:25:28", "text": "待って、"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "えっと、こちら側からですか？うん。ああ、そうだ、君"}, {"type": "subtitle", "time": 5137.35, "timestamp": "01:25:37", "text": "できる。わかった。わかった。わかった。わかった。良い。良い。"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "良い。良い。良い。もっと速く。"}, {"type": "subtitle", "time": 5149.51, "timestamp": "01:25:49", "text": "彼らは実は牛乳が好きなんです。"}]
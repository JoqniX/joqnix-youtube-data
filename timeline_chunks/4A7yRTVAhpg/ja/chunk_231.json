[{"type": "subtitle", "time": 13862.15, "timestamp": "03:51:02", "text": "ここに視線を向けてください。剣は中にあります"}, {"type": "subtitle", "time": 13865.189, "timestamp": "03:51:05", "text": "洞窟。ああ、卵がもう一つある"}, {"type": "subtitle", "time": 13866.75, "timestamp": "03:51:06", "text": "感覚的に"}, {"type": "subtitle", "time": 13868.99, "timestamp": "03:51:08", "text": "場所。この医療キット2個"}, {"type": "subtitle", "time": 13881.11, "timestamp": "03:51:21", "text": "三つ。鍵を見つけた。 3号室。"}, {"type": "subtitle", "time": 13883.51, "timestamp": "03:51:23", "text": "ああ、３号室ですね。ええと、部屋はその中にあります"}, {"type": "subtitle", "time": 13892.55, "timestamp": "03:51:32", "text": "床。おお。ああ、わかった、わかった"}, {"type": "subtitle", "time": 13897.71, "timestamp": "03:51:37", "text": "もう一つの鍵。卵の保存容器を手に入れました"}, {"type": "subtitle", "time": 13900.91, "timestamp": "03:51:40", "text": "鍵。ああ、バケツ。"}, {"type": "subtitle", "time": 13904.269, "timestamp": "03:51:44", "text": "バケツ。このドアを開けてはいけないのですか？"}, {"type": "subtitle", "time": 13907.229, "timestamp": "03:51:47", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 13910.309, "timestamp": "03:51:50", "text": "行く。私はトイレにいます。そこには"}, {"type": "subtitle", "time": 13913.75, "timestamp": "03:51:53", "text": "鏡。このろうそくの階段。"}, {"type": "subtitle", "time": 13917.59, "timestamp": "03:51:57", "text": "ああ、1号室ですね。 2号室。"}]
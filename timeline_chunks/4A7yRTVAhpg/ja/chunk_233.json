[{"type": "subtitle", "time": 13981.03, "timestamp": "03:53:01", "text": "予感がする。ええ、クモはいつも"}, {"type": "subtitle", "time": 13982.87, "timestamp": "03:53:02", "text": "うざいよ、マジで。でも大丈夫。うん、"}, {"type": "subtitle", "time": 13985.91, "timestamp": "03:53:05", "text": "彼らは私たちをからかった。うん。待って、"}, {"type": "subtitle", "time": 13987.75, "timestamp": "03:53:07", "text": "何？どういう意味ですか？私に従ってください。私たちは"}, {"type": "subtitle", "time": 13990.95, "timestamp": "03:53:10", "text": "ジョー、君はそう思っているのか。私は強くなった。あなたは"}, {"type": "subtitle", "time": 13993.189, "timestamp": "03:53:13", "text": "あなたはどんなクモよりも優れている"}, {"type": "subtitle", "time": 13995.189, "timestamp": "03:53:15", "text": "そうなりたい。"}, {"type": "subtitle", "time": 13998.07, "timestamp": "03:53:18", "text": "はい。君は大きなクモだ。はい。はい。"}, {"type": "subtitle", "time": 14002.55, "timestamp": "03:53:22", "text": "良くなったね。より良いクモ。はい。"}, {"type": "subtitle", "time": 14004.469, "timestamp": "03:53:24", "text": "ジョー、いつも覚えていてね。何でもあり"}, {"type": "subtitle", "time": 14006.229, "timestamp": "03:53:26", "text": "違う、君の方が優れている。あなたは"}, {"type": "subtitle", "time": 14008.15, "timestamp": "03:53:28", "text": "彼ら。"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "はい。"}, {"type": "subtitle", "time": 14012.99, "timestamp": "03:53:32", "text": "ジャック、君は彼らより優れているよ。来て。"}, {"type": "subtitle", "time": 14022.229, "timestamp": "03:53:42", "text": "こんにちは。"}, {"type": "subtitle", "time": 14024.389, "timestamp": "03:53:44", "text": "ああ、卵をピラミッドの中に入れたんですね"}, {"type": "subtitle", "time": 14027.429, "timestamp": "03:53:47", "text": "あれ。はい。はい。まず洗ってください"}, {"type": "subtitle", "time": 14030.15, "timestamp": "03:53:50", "text": "けれど。おお。池の中で。では"}, {"type": "subtitle", "time": 14032.15, "timestamp": "03:53:52", "text": "池。うん。そしてそれを"}, {"type": "subtitle", "time": 14034.55, "timestamp": "03:53:54", "text": "それぞれの神社。"}, {"type": "subtitle", "time": 14036.469, "timestamp": "03:53:56", "text": "はい。あなたがそうすると、彼女は"}]
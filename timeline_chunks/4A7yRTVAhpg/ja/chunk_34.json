[{"type": "subtitle", "time": 2041.51, "timestamp": "00:34:01", "text": "彼らはキノコが欲しいので、私は刻みます"}, {"type": "subtitle", "time": 2047.509, "timestamp": "00:34:07", "text": "キノコ。待って、それは正しくない"}, {"type": "subtitle", "time": 2050.51, "timestamp": "00:34:10", "text": "けれど。これは違う"}, {"type": "subtitle", "time": 2079.589, "timestamp": "00:34:39", "text": "レア。待って。いや、いや、いや、いや。私たちには、"}, {"type": "subtitle", "time": 2081.589, "timestamp": "00:34:41", "text": "終わり。いや、違うよ。これを受け取って。これを受け取って。"}, {"type": "subtitle", "time": 2090.389, "timestamp": "00:34:50", "text": "待って。私"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "こんにちは、ベイビー。ようこそ。"}]
[{"type": "subtitle", "time": 4385.669, "timestamp": "01:13:05", "text": "17の研究テストで彼女が発見された。はい、私は"}, {"type": "subtitle", "time": 4388.63, "timestamp": "01:13:08", "text": "これを入れることができると思いますが、"}, {"type": "subtitle", "time": 4390.15, "timestamp": "01:13:10", "text": "ダイニングテーブル。"}, {"type": "subtitle", "time": 4405.99, "timestamp": "01:13:25", "text": "待って、私、今何したの？"}, {"type": "subtitle", "time": 4408.43, "timestamp": "01:13:28", "text": "ああ、新しいカレンダーが出てるね。"}, {"type": "subtitle", "time": 4412.07, "timestamp": "01:13:32", "text": "ああ、古いやつ。"}, {"type": "subtitle", "time": 4413.229, "timestamp": "01:13:33", "text": "研究"}, {"type": "subtitle", "time": 4416.229, "timestamp": "01:13:36", "text": "テスト。無料ですか？つまり、私たちはそれを手に入れることができる"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "次のラウンド。いいえ、違います。 40ドルです。"}, {"type": "subtitle", "time": 4421.189, "timestamp": "01:13:41", "text": "ああ、他のラウンドのものは"}, {"type": "subtitle", "time": 4424.47, "timestamp": "01:13:44", "text": "まだそこにいるだろうか？"}, {"type": "subtitle", "time": 4428.149, "timestamp": "01:13:48", "text": "ええと、ここに入れたら、そうですね"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "そうですが、一度に1つしか置けません。"}, {"type": "subtitle", "time": 4434.21, "timestamp": "01:13:54", "text": "それで、"}, {"type": "subtitle", "time": 4435.39, "timestamp": "01:13:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4438.95, "timestamp": "01:13:58", "text": "うん。いいえ、大丈夫です。それは研究です"}]
[{"type": "subtitle", "time": 8461.03, "timestamp": "02:21:01", "text": "最高。でも、好きな食べ物は"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "例えばパスタみたいな感じかな。私はどんなタイプでも好きです"}, {"type": "subtitle", "time": 8469.03, "timestamp": "02:21:09", "text": "パスタの。パスタ。"}, {"type": "subtitle", "time": 8478.91, "timestamp": "02:21:18", "text": "うん。どうやって"}, {"type": "subtitle", "time": 8481.27, "timestamp": "02:21:21", "text": "何をしているの？あなたはどうですか？持っていますか"}, {"type": "subtitle", "time": 8484.63, "timestamp": "02:21:24", "text": "好きな食べ物は？私はあなたが食べるもの全てを食べます"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "[笑い]"}, {"type": "subtitle", "time": 8494.89, "timestamp": "02:21:34", "text": "それはどの程度まで真実なのか？"}, {"type": "subtitle", "time": 8507.309, "timestamp": "02:21:47", "text": "本当に大金を稼いでいる"}]
[{"type": "subtitle", "time": 10982.23, "timestamp": "03:03:02", "text": "何てことだ。私はこれを知りませんでした。"}, {"type": "subtitle", "time": 10996.71, "timestamp": "03:03:16", "text": "わかった。えっと、ゲームの音声って全部ですか？"}, {"type": "subtitle", "time": 10998.79, "timestamp": "03:03:18", "text": "チャド、私たちは誰を感じているの？どれ"}, {"type": "subtitle", "time": 11001.51, "timestamp": "03:03:21", "text": "あなたは私にどうなってほしいですか？"}, {"type": "subtitle", "time": 11004.269, "timestamp": "03:03:24", "text": "1秒。"}, {"type": "subtitle", "time": 11006.23, "timestamp": "03:03:26", "text": "わーい。"}, {"type": "subtitle", "time": 11008.23, "timestamp": "03:03:28", "text": "ああ、おやつを取りに行かなきゃ。"}, {"type": "subtitle", "time": 11011.51, "timestamp": "03:03:31", "text": "準備完了。フランクはなぜ"}, {"type": "subtitle", "time": 11015.59, "timestamp": "03:03:35", "text": "そんな感じ？なぜ彼はあんな顔をしているのですか？"}, {"type": "subtitle", "time": 11018.55, "timestamp": "03:03:38", "text": "特典を選択する必要があります。彼はとても"}, {"type": "subtitle", "time": 11020.15, "timestamp": "03:03:40", "text": "脂っこい。"}, {"type": "subtitle", "time": 11029.19, "timestamp": "03:03:49", "text": "バッテリーを回転させます。フランクって誰？彼は"}, {"type": "subtitle", "time": 11030.55, "timestamp": "03:03:50", "text": "彼は年寄りではないと思う"}, {"type": "subtitle", "time": 11032.55, "timestamp": "03:03:52", "text": "キャラクター。彼は新しいキャラクターですよね？"}, {"type": "subtitle", "time": 11034.63, "timestamp": "03:03:54", "text": "いいえ、新しいキャラクターだと思います"}, {"type": "subtitle", "time": 11036.55, "timestamp": "03:03:56", "text": "実は。ええ、見たことないです"}, {"type": "subtitle", "time": 11039.91, "timestamp": "03:03:59", "text": "前に。ええ、おならを見たことがないんです。"}]
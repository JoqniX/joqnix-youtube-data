[{"type": "subtitle", "time": 4743.65, "timestamp": "01:19:03", "text": "えっと、カップを渡さないといけないか、"}, {"type": "subtitle", "time": 4745.149, "timestamp": "01:19:05", "text": "[音楽]"}, {"type": "subtitle", "time": 4751.39, "timestamp": "01:19:11", "text": "あげてください。"}, {"type": "subtitle", "time": 4755.11, "timestamp": "01:19:15", "text": "ああ、そういう仕組みだったんですね。彼らは尋ねる"}, {"type": "subtitle", "time": 4759.83, "timestamp": "01:19:19", "text": "牛乳。待って、よくわからない。私もそうは思わない"}, {"type": "subtitle", "time": 4763.01, "timestamp": "01:19:23", "text": "それを得る。なぜミルクボトルが必要なのですか？"}]
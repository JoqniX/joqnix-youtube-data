[{"type": "subtitle", "time": 16563.949, "timestamp": "04:36:03", "text": "大丈夫です。"}, {"type": "subtitle", "time": 16571.189, "timestamp": "04:36:11", "text": "ホラー映画のおすすめはありますか？"}, {"type": "subtitle", "time": 16573.029, "timestamp": "04:36:13", "text": "ゲーム？"}, {"type": "subtitle", "time": 16575.349, "timestamp": "04:36:15", "text": "わからない。ゲーム・グラムができる"}, {"type": "subtitle", "time": 16578.23, "timestamp": "04:36:18", "text": "一人の男がプレイするスタイルのホラーゲーム"}, {"type": "subtitle", "time": 16581.269, "timestamp": "04:36:21", "text": "そして、一人の男がそれを見守っている。"}, {"type": "subtitle", "time": 16583.91, "timestamp": "04:36:23", "text": "うん、それは楽しそうだね。うん。"}, {"type": "subtitle", "time": 16587.189, "timestamp": "04:36:27", "text": "うん、君が望むならそうすることもできるよ"}, {"type": "subtitle", "time": 16590.551, "timestamp": "04:36:30", "text": "に。ホラーゲームを買うこともできるし、"}, {"type": "subtitle", "time": 16592.629, "timestamp": "04:36:32", "text": "両方ともお金を一緒に出すことができます"}, {"type": "subtitle", "time": 16595.67, "timestamp": "04:36:35", "text": "ホラーゲームを買う。だから私たちは"}, {"type": "subtitle", "time": 16598.089, "timestamp": "04:36:38", "text": "ゲーム全体を一緒にプレイする。"}, {"type": "subtitle", "time": 16599.99, "timestamp": "04:36:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16603.91, "timestamp": "04:36:43", "text": "なぜそんなに苦しみたいのですか？"}, {"type": "subtitle", "time": 16609.91, "timestamp": "04:36:49", "text": "良い質問ですね。誰が尋ねたのか？私はただ尋ねただけです"}, {"type": "subtitle", "time": 16612.029, "timestamp": "04:36:52", "text": "こんにちは お元気ですか"}, {"type": "subtitle", "time": 16614.949, "timestamp": "04:36:54", "text": "何をしているの？良い、"}, {"type": "subtitle", "time": 16617.429, "timestamp": "04:36:57", "text": "正直言って、全く分かりません。私は"}]
[{"type": "subtitle", "time": 18363.19, "timestamp": "05:06:03", "text": "それで、えーと、先週、つまり先週"}, {"type": "subtitle", "time": 18365.67, "timestamp": "05:06:05", "text": "週というのは、今週のことですか、それとも先週のことですか？"}, {"type": "subtitle", "time": 18369.11, "timestamp": "05:06:09", "text": "先週は、"}, {"type": "subtitle", "time": 18372.59, "timestamp": "05:06:12", "text": "まさにそれを言おうとしていたところだ。言おうとしていた"}, {"type": "subtitle", "time": 18376.47, "timestamp": "05:06:16", "text": "それ。先週か今週のように、えっと、私たちは"}, {"type": "subtitle", "time": 18379.67, "timestamp": "05:06:19", "text": "一緒にストリーミング配信することはできませんでした。"}, {"type": "subtitle", "time": 18382.708, "timestamp": "05:06:22", "text": "うん。うん。また、Apex も開催されます。"}, {"type": "subtitle", "time": 18384.868, "timestamp": "05:06:24", "text": "右？うん。私たちは文字通りそれが可能です。"}, {"type": "subtitle", "time": 18387.11, "timestamp": "05:06:27", "text": "うん。私たちもそれが可能です。イベントは"}, {"type": "subtitle", "time": 18389.31, "timestamp": "05:06:29", "text": "そこに1週間滞在します。それで、"}, {"type": "subtitle", "time": 18398.03, "timestamp": "05:06:38", "text": "[音楽]"}, {"type": "subtitle", "time": 18401.27, "timestamp": "05:06:41", "text": "では、なぜ皆さんは私が"}, {"type": "subtitle", "time": 18404.31, "timestamp": "05:06:44", "text": "この話し合いの時間に気が散っていた"}, {"type": "subtitle", "time": 18411.27, "timestamp": "05:06:51", "text": "えっと、話中に気が散ってたかな？"}]
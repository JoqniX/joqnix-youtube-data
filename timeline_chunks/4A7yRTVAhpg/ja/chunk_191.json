[{"type": "subtitle", "time": 11462.95, "timestamp": "03:11:02", "text": "そちら側。おお。ああ、辛い。"}, {"type": "subtitle", "time": 11466.469, "timestamp": "03:11:06", "text": "ああ、鍵がある。谷。現実。手に入れた"}, {"type": "subtitle", "time": 11470.469, "timestamp": "03:11:10", "text": "鍵となるもの。ああ、それは高級品だよ。うん。"}, {"type": "subtitle", "time": 11473.99, "timestamp": "03:11:13", "text": "ブルジョワ。今、聞こえましたか？"}, {"type": "subtitle", "time": 11476.63, "timestamp": "03:11:16", "text": "何？それは何ですか？そこには"}, {"type": "subtitle", "time": 11477.79, "timestamp": "03:11:17", "text": "きしむ音"}, {"type": "subtitle", "time": 11481.91, "timestamp": "03:11:21", "text": "ノイズ。それは普通のことですか？えっと、私たちだけです"}, {"type": "subtitle", "time": 11484.71, "timestamp": "03:11:24", "text": "歩き回るような感じ。ああ、わかりました。おお、"}, {"type": "subtitle", "time": 11488.309, "timestamp": "03:11:28", "text": "ほら、こっちに神様がいるわよ、ハニー。そうそう。"}, {"type": "subtitle", "time": 11491.59, "timestamp": "03:11:31", "text": "読んでください。読んでください。 10月17日。私はできる"}, {"type": "subtitle", "time": 11495.11, "timestamp": "03:11:35", "text": "頭の中でアージルの声が聞こえる。彼の"}, {"type": "subtitle", "time": 11497.67, "timestamp": "03:11:37", "text": "私の血管には怒りがみなぎっている。負けているような気がする"}, {"type": "subtitle", "time": 11500.63, "timestamp": "03:11:40", "text": "彼を支配する。理解できない。"}, {"type": "subtitle", "time": 11502.79, "timestamp": "03:11:42", "text": "奇妙な言葉が止まらない"}, {"type": "subtitle", "time": 11505.349, "timestamp": "03:11:45", "text": "私が手下として話すとき、私の口から出てくる"}, {"type": "subtitle", "time": 11507.79, "timestamp": "03:11:47", "text": "私の周りでは、至る所で何かが起こっている。"}, {"type": "subtitle", "time": 11511.19, "timestamp": "03:11:51", "text": "そしてああ"}, {"type": "subtitle", "time": 11513.91, "timestamp": "03:11:53", "text": "そうするべきなの？"}, {"type": "subtitle", "time": 11517.429, "timestamp": "03:11:57", "text": "ええ、少しはね。わかった。ええ、私は"}]
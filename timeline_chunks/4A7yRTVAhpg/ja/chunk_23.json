[{"type": "subtitle", "time": 1386.549, "timestamp": "00:23:06", "text": "何てことだ。時間がない。時間がない。知っている。私"}, {"type": "subtitle", "time": 1388.27, "timestamp": "00:23:08", "text": "知る。取る"}, {"type": "subtitle", "time": 1391.71, "timestamp": "00:23:11", "text": "それ。 2つ必要です"}, {"type": "subtitle", "time": 1394.99, "timestamp": "00:23:14", "text": "レア。ざまあみろ。 1つ"}, {"type": "subtitle", "time": 1396.59, "timestamp": "00:23:16", "text": "[音楽]"}, {"type": "subtitle", "time": 1400.35, "timestamp": "00:23:20", "text": "もっと。こんにちは、ドラゴンたち"}, {"type": "subtitle", "time": 1402.75, "timestamp": "00:23:22", "text": "は"}, {"type": "subtitle", "time": 1414.39, "timestamp": "00:23:34", "text": "うん。間違った方です。間違った方です。くそっ。"}, {"type": "subtitle", "time": 1417.39, "timestamp": "00:23:37", "text": "ああ、終わった。さあ"}, {"type": "subtitle", "time": 1420.789, "timestamp": "00:23:40", "text": "行く。上にタイマーがあり、"}, {"type": "subtitle", "time": 1424.99, "timestamp": "00:23:44", "text": "丸一日、T（トランスジェンダー）として過ごすようなものだ。だから、"}, {"type": "subtitle", "time": 1429.149, "timestamp": "00:23:49", "text": "迷惑な。ああ、部屋に入ってください。入力"}, {"type": "subtitle", "time": 1432.11, "timestamp": "00:23:52", "text": "部屋。私たちは何をしたのか"}, {"type": "subtitle", "time": 1433.71, "timestamp": "00:23:53", "text": "得る？"}, {"type": "subtitle", "time": 1436.07, "timestamp": "00:23:56", "text": "皿。そうそう。小皿は"}, {"type": "subtitle", "time": 1438.47, "timestamp": "00:23:58", "text": "概ね良好。ダイニングテーブル。私は"}, {"type": "subtitle", "time": 1439.87, "timestamp": "00:23:59", "text": "その物"}]
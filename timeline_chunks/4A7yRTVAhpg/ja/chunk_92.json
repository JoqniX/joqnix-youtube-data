[{"type": "subtitle", "time": 5528.31, "timestamp": "01:32:08", "text": "わかった。トイレに行きたい。"}, {"type": "subtitle", "time": 5530.75, "timestamp": "01:32:10", "text": "ああ、もしあなたが"}, {"type": "subtitle", "time": 5533.11, "timestamp": "01:32:13", "text": "始める前に、いくつか確認しておきたいことがあります。初めに、"}, {"type": "subtitle", "time": 5536.87, "timestamp": "01:32:16", "text": "これを開けて、ここにこれを置いてください。"}, {"type": "subtitle", "time": 5540.27, "timestamp": "01:32:20", "text": "それから私は"}, {"type": "subtitle", "time": 5549.03, "timestamp": "01:32:29", "text": "これ。えっと、ダイニングテーブル。必要でしょうか？"}, {"type": "subtitle", "time": 5552.229, "timestamp": "01:32:32", "text": "もっとダイニングテーブルが必要ですか？研究。"}, {"type": "subtitle", "time": 5554.31, "timestamp": "01:32:34", "text": "トレーナーとはどういう存在ですか？"}, {"type": "subtitle", "time": 5556.95, "timestamp": "01:32:36", "text": "なぜそうなるのか、私にはわからない。その"}, {"type": "subtitle", "time": 5557.46, "timestamp": "01:32:37", "text": "使い物にならない。"}, {"type": "subtitle", "time": 5568.07, "timestamp": "01:32:48", "text": "えっと、もっと速く動いて。これは"}, {"type": "subtitle", "time": 5570.79, "timestamp": "01:32:50", "text": "水たまりの中を歩く。"}, {"type": "subtitle", "time": 5577.59, "timestamp": "01:32:57", "text": "机？研究デスクは"}]
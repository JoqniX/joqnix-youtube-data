[{"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "ああ、待たなきゃ。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 724.87, "timestamp": "00:12:04", "text": "うん。鏡の前に立って"}, {"type": "subtitle", "time": 727.03, "timestamp": "00:12:07", "text": "OかPを押してください。変更できます。"}, {"type": "subtitle", "time": 729.47, "timestamp": "00:12:09", "text": "あなたの色。"}, {"type": "subtitle", "time": 731.31, "timestamp": "00:12:11", "text": "おお、"}, {"type": "subtitle", "time": 733.75, "timestamp": "00:12:13", "text": "鏡。待って、それは常にOになる"}, {"type": "subtitle", "time": 737.19, "timestamp": "00:12:17", "text": "またはP。ああ、鍵は変更できますよ。えっと、"}, {"type": "subtitle", "time": 740.99, "timestamp": "00:12:20", "text": "脱出できたとしても、それは左側にある。"}, {"type": "subtitle", "time": 752.069, "timestamp": "00:12:32", "text": "ああ、見て。それらはパステルカラーです。わーい。"}, {"type": "subtitle", "time": 753.07, "timestamp": "00:12:33", "text": "いいえ。"}, {"type": "subtitle", "time": 755.67, "timestamp": "00:12:35", "text": "[音楽]"}, {"type": "subtitle", "time": 758.55, "timestamp": "00:12:38", "text": "あなたも外見を変えたのですか？"}, {"type": "subtitle", "time": 761.03, "timestamp": "00:12:41", "text": "はい、できますよ。"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "たくさんのこと。ああ、なんてことだ。私は"}, {"type": "subtitle", "time": 771.55, "timestamp": "00:12:51", "text": "お祭り気分"}]
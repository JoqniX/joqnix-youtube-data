[{"type": "subtitle", "time": 12542.229, "timestamp": "03:29:02", "text": "アンナが来て、私たちは紫外線と"}, {"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "私たちは大丈夫だ。わかった。ああ、彼女が来るわ。"}, {"type": "subtitle", "time": 12547.349, "timestamp": "03:29:07", "text": "彼女が来る。彼女が来る。なんてこった。"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "はい、大丈夫です。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 12552.76, "timestamp": "03:29:12", "text": "大丈夫です。大丈夫です。 走るんだ。"}, {"type": "subtitle", "time": 12555.52, "timestamp": "03:29:15", "text": "走るんだ。 私は行き詰まっています。わかった。"}, {"type": "subtitle", "time": 12559.92, "timestamp": "03:29:19", "text": "私は行き詰まっています。わかった。 あなたは死につつあるのですか？何だって？その"}, {"type": "subtitle", "time": 12562.72, "timestamp": "03:29:22", "text": "あなたは死につつあるのですか？何だって？その わかった。大丈夫。大丈夫。何？"}, {"type": "subtitle", "time": 12566.88, "timestamp": "03:29:26", "text": "わかった。大丈夫。大丈夫。何？ ああ、この不気味な顔があなたとして戻ってくる"}, {"type": "subtitle", "time": 12569.6, "timestamp": "03:29:29", "text": "ああ、この不気味な顔があなたとして戻ってくる なれ"}, {"type": "subtitle", "time": 12571.92, "timestamp": "03:29:31", "text": "なれ 待機時間と回数が適切でした。"}, {"type": "subtitle", "time": 12582.87, "timestamp": "03:29:42", "text": "ああ、彼女の目は赤かった。だから私たちは"}, {"type": "subtitle", "time": 12584.55, "timestamp": "03:29:44", "text": "彼女を蘇生させて。いやいや、走り続けて"}, {"type": "subtitle", "time": 12586.389, "timestamp": "03:29:46", "text": "後ろもね。えっと、ジアはあなたの隣にいますか？"}, {"type": "subtitle", "time": 12592.03, "timestamp": "03:29:52", "text": "ええ、そうですね。彼女は檻の中にいる"}, {"type": "subtitle", "time": 12596.55, "timestamp": "03:29:56", "text": "場所。私は外に出ます"}, {"type": "subtitle", "time": 12599.83, "timestamp": "03:29:59", "text": "救急キットを持って行きます。"}]
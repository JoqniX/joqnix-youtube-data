[{"type": "subtitle", "time": 9900.79, "timestamp": "02:45:00", "text": "同じように。フォローを忘れずに"}, {"type": "subtitle", "time": 9902.79, "timestamp": "02:45:02", "text": "彼女のチャンネルを購読してください。ヘリングスは"}, {"type": "subtitle", "time": 9904.79, "timestamp": "02:45:04", "text": "説明とピン留めされた"}, {"type": "subtitle", "time": 9907.349, "timestamp": "02:45:07", "text": "YouTubeとTwitchへのコメント。だから感じて"}, {"type": "subtitle", "time": 9915.91, "timestamp": "02:45:15", "text": "それ。これで締めくくりましょう。包まない"}, {"type": "chat", "time": 9920.168, "timestamp": "02:45:20", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "it looked fun"}, {"type": "subtitle", "time": 9920.51, "timestamp": "02:45:20", "text": "つまり、私はまだ行くつもりだ。心配しないで。"}, {"type": "subtitle", "time": 9924.55, "timestamp": "02:45:24", "text": "ええ、そろそろ行かなきゃ。食事に行きます"}, {"type": "subtitle", "time": 9926.19, "timestamp": "02:45:26", "text": "そして戻ってきてください。"}, {"type": "subtitle", "time": 9929.03, "timestamp": "02:45:29", "text": "ええと、夕食を食べます。私はしていません"}, {"type": "subtitle", "time": 9931.83, "timestamp": "02:45:31", "text": "夕食は済ませたけど、うん、食べに行くよ"}, {"type": "chat", "time": 9939.257, "timestamp": "02:45:39", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "enjoy your food"}, {"type": "subtitle", "time": 9953.71, "timestamp": "02:45:53", "text": "[音楽]"}, {"type": "subtitle", "time": 9956.95, "timestamp": "02:45:56", "text": "こんにちは。少し時間をください。いくつか持っています"}]
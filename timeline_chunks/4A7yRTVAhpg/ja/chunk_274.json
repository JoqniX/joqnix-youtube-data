[{"type": "subtitle", "time": 16442.07, "timestamp": "04:34:02", "text": "今ではストリームも。というわけで、そういうことです。はい。"}, {"type": "subtitle", "time": 16447.029, "timestamp": "04:34:07", "text": "うん。こんにちは。こんにちは、ミスター。ちょうど"}, {"type": "subtitle", "time": 16449.67, "timestamp": "04:34:09", "text": "人々にとっての文脈。人々が入ってきたのかもしれない"}, {"type": "subtitle", "time": 16452.23, "timestamp": "04:34:12", "text": "貪り食うのを見て、しかし彼らはただ"}, {"type": "subtitle", "time": 16453.91, "timestamp": "04:34:13", "text": "探しています。"}, {"type": "subtitle", "time": 16457.189, "timestamp": "04:34:17", "text": "うん。単に背景を説明していただけです。"}, {"type": "subtitle", "time": 16460.15, "timestamp": "04:34:20", "text": "うん。うん。私もそうしました。うん。それで"}, {"type": "subtitle", "time": 16461.54, "timestamp": "04:34:21", "text": "以上です。"}, {"type": "subtitle", "time": 16463.349, "timestamp": "04:34:23", "text": "[音楽]"}, {"type": "subtitle", "time": 16470.869, "timestamp": "04:34:30", "text": "では、いつ原神をプレイしたいですか？"}, {"type": "subtitle", "time": 16474.869, "timestamp": "04:34:34", "text": "来週また来週。いつでも"}, {"type": "subtitle", "time": 16477.109, "timestamp": "04:34:37", "text": "火曜日、月曜日。できない"}, {"type": "subtitle", "time": 16483.029, "timestamp": "04:34:43", "text": "月曜日。げんちん。"}, {"type": "subtitle", "time": 16485.429, "timestamp": "04:34:45", "text": "もちろん。もちろん。あ、待って。来週は"}, {"type": "subtitle", "time": 16488.39, "timestamp": "04:34:48", "text": "終わり。待って、来週が終わりじゃないの？"}, {"type": "subtitle", "time": 16491.029, "timestamp": "04:34:51", "text": "なんてこった。これは違う。わかった。わかった。そこには"}]
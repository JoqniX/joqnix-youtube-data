[{"type": "subtitle", "time": 7261.83, "timestamp": "02:01:01", "text": "私たちはしくじったと思う。私はしくじった。私"}, {"type": "subtitle", "time": 7270.12, "timestamp": "02:01:10", "text": "起こる。"}, {"type": "subtitle", "time": 7275.39, "timestamp": "02:01:15", "text": "[音楽]"}, {"type": "subtitle", "time": 7278.24, "timestamp": "02:01:18", "text": "決して好きではない"}, {"type": "subtitle", "time": 7288.589, "timestamp": "02:01:28", "text": "[音楽]"}, {"type": "subtitle", "time": 7291.669, "timestamp": "02:01:31", "text": "ボンコ。ああ、雄鶏。ああ、"}, {"type": "subtitle", "time": 7294.41, "timestamp": "02:01:34", "text": "雄鶏。"}, {"type": "subtitle", "time": 7296.709, "timestamp": "02:01:36", "text": "[音楽]"}, {"type": "subtitle", "time": 7301.189, "timestamp": "02:01:41", "text": "3日間休止します。だから、私たちは大丈夫です。"}, {"type": "subtitle", "time": 7303.669, "timestamp": "02:01:43", "text": "わかった。さあ、まずはレシピを作ってみよう"}, {"type": "subtitle", "time": 7306.47, "timestamp": "02:01:46", "text": "そして見て。はい、チュートリアルをやってみましょう"}, {"type": "subtitle", "time": 7310.109, "timestamp": "02:01:50", "text": "初め。そして、代わりに"}, {"type": "subtitle", "time": 7312.95, "timestamp": "02:01:52", "text": "これ、そう、私たちはこれを中に必要としているし"}, {"type": "subtitle", "time": 7314.21, "timestamp": "02:01:54", "text": "外。"}, {"type": "subtitle", "time": 7316.91, "timestamp": "02:01:56", "text": "[音楽]"}]
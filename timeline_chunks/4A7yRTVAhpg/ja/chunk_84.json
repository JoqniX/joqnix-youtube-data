[{"type": "subtitle", "time": 5040.79, "timestamp": "01:24:00", "text": "ただ、とても難しいんです"}, {"type": "subtitle", "time": 5043.669, "timestamp": "01:24:03", "text": "お客さんがいる時に通る。"}, {"type": "subtitle", "time": 5045.18, "timestamp": "01:24:05", "text": "そうそう。それで、"}, {"type": "subtitle", "time": 5046.75, "timestamp": "01:24:06", "text": "[音楽]"}, {"type": "subtitle", "time": 5049.51, "timestamp": "01:24:09", "text": "うん。それから、"}, {"type": "subtitle", "time": 5051.75, "timestamp": "01:24:11", "text": "寮。いいえ。"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "私がここの玄関先に置いておかない限りは。うん。"}, {"type": "subtitle", "time": 5056.39, "timestamp": "01:24:16", "text": "うん。私は行かないから。手に入れることができません"}, {"type": "subtitle", "time": 5059.51, "timestamp": "01:24:19", "text": "外。うん。でも待って、どうやって集めるの？"}, {"type": "subtitle", "time": 5062.47, "timestamp": "01:24:22", "text": "もの、"}, {"type": "subtitle", "time": 5066.149, "timestamp": "01:24:26", "text": "右？持続する。えっと、待って。行き詰まってしまった。"}, {"type": "subtitle", "time": 5070.39, "timestamp": "01:24:30", "text": "くそっ。ああ、中に入っても構いませんよ。おお、"}, {"type": "subtitle", "time": 5080.95, "timestamp": "01:24:40", "text": "知る。そうそう。 1つは外に置いておけます。"}, {"type": "chat", "time": 5091.482, "timestamp": "01:24:51", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "*Sneak in*"}, {"type": "chat", "time": 5094.064, "timestamp": "01:24:54", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Wildan19gta~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}]
[{"type": "subtitle", "time": 12720.389, "timestamp": "03:32:00", "text": "今すぐにでもそれを焼き払ってしまおうか。"}, {"type": "subtitle", "time": 12722.389, "timestamp": "03:32:02", "text": "今すぐ1枚置いてください。でも燃やさないで"}, {"type": "subtitle", "time": 12725.269, "timestamp": "03:32:05", "text": "それ。ただ置いておくだけで、燃やさないで"}, {"type": "subtitle", "time": 12727.269, "timestamp": "03:32:07", "text": "バーベキューで"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "ピット。"}, {"type": "subtitle", "time": 12731.67, "timestamp": "03:32:11", "text": "ああ、ヤギを飼ってもいいよ。私"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "ここにヤギが1頭いたような気がする。手に入れます"}, {"type": "subtitle", "time": 12735.67, "timestamp": "03:32:15", "text": "ヤギを連れてくるよ。ヤギを連れてくるよ。"}, {"type": "subtitle", "time": 12741.03, "timestamp": "03:32:21", "text": "[拍手]"}, {"type": "subtitle", "time": 12749.99, "timestamp": "03:32:29", "text": "はい。"}, {"type": "subtitle", "time": 12753.03, "timestamp": "03:32:33", "text": "[音楽]"}, {"type": "subtitle", "time": 12755.83, "timestamp": "03:32:35", "text": "私を信じて。私を信じてください、皆さん。私を信じて。私"}, {"type": "subtitle", "time": 12767.11, "timestamp": "03:32:47", "text": "ああ、君のために美味しい干し草を用意してあるよ。"}, {"type": "subtitle", "time": 12768.71, "timestamp": "03:32:48", "text": "外にはヤギがいっぱいいる"}, {"type": "subtitle", "time": 12772.229, "timestamp": "03:32:52", "text": "けれど。外。うん、彼らは"}, {"type": "subtitle", "time": 12774.389, "timestamp": "03:32:54", "text": "まるで間抜けみたいに走り回っている。たくさんの"}, {"type": "subtitle", "time": 12775.99, "timestamp": "03:32:55", "text": "もの。それでは、"}, {"type": "subtitle", "time": 12778.07, "timestamp": "03:32:58", "text": "家の中に幽霊がいて、それから私たちは"}]
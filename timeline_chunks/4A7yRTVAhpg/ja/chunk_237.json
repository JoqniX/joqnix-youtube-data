[{"type": "subtitle", "time": 14230.469, "timestamp": "03:57:10", "text": "では、彼女は一体どこにいるのでしょうか？"}, {"type": "subtitle", "time": 14232.63, "timestamp": "03:57:12", "text": "ああ、彼女はあちこちをうろついているだろう"}, {"type": "subtitle", "time": 14234.71, "timestamp": "03:57:14", "text": "ああ、トイレに卵がある"}, {"type": "subtitle", "time": 14236.309, "timestamp": "03:57:16", "text": "2階へ。"}, {"type": "subtitle", "time": 14238.309, "timestamp": "03:57:18", "text": "まあ、みんなが"}, {"type": "subtitle", "time": 14240.71, "timestamp": "03:57:20", "text": "中に卵が入っている。彼らはすでに"}, {"type": "subtitle", "time": 14242.07, "timestamp": "03:57:22", "text": "みんな、正直に言うよ。私は"}, {"type": "subtitle", "time": 14243.83, "timestamp": "03:57:23", "text": "乗り物酔いがひどくなる人もいる"}, {"type": "subtitle", "time": 14247.11, "timestamp": "03:57:27", "text": "理由。あなたは、あなたは、あなたは止めたいのですか？"}, {"type": "subtitle", "time": 14248.71, "timestamp": "03:57:28", "text": "あなたならできますよ。私はそうかもしれないし、そうかもしれない"}, {"type": "subtitle", "time": 14252.309, "timestamp": "03:57:32", "text": "に。持続する。"}, {"type": "subtitle", "time": 14255.07, "timestamp": "03:57:35", "text": "ごめんなさい。私は知っています"}, {"type": "subtitle", "time": 14259.269, "timestamp": "03:57:39", "text": "私たちは話したくない。"}, {"type": "subtitle", "time": 14261.67, "timestamp": "03:57:41", "text": "ごめんなさい。いや、いや、いや。大丈夫です。"}, {"type": "subtitle", "time": 14270.15, "timestamp": "03:57:50", "text": "ニース。ああ、神様。うん、私はしたい、私はしたい"}, {"type": "subtitle", "time": 14272.429, "timestamp": "03:57:52", "text": "ここにいてください。の"}, {"type": "subtitle", "time": 14275.75, "timestamp": "03:57:55", "text": "キャンプしたい。キャンプしたい。ザバラはどこにいるのか"}, {"type": "subtitle", "time": 14279.429, "timestamp": "03:57:59", "text": "えっと、見つからないので、あなたを置いていきます"}]
[{"type": "subtitle", "time": 13440.469, "timestamp": "03:44:00", "text": "なぜなら、私は悪夢を見ないからです。しかし"}, {"type": "subtitle", "time": 13443.11, "timestamp": "03:44:03", "text": "私には許してくれない、だってほら知ってるでしょ"}, {"type": "subtitle", "time": 13445.51, "timestamp": "03:44:05", "text": "ファスモ、文字通り気が狂ってしまうよ"}, {"type": "subtitle", "time": 13448.309, "timestamp": "03:44:08", "text": "あなたが望むなら。しかし残念ながら、"}, {"type": "subtitle", "time": 13450.71, "timestamp": "03:44:10", "text": "通常の手順を完了して次の手順に進む"}, {"type": "subtitle", "time": 13453.269, "timestamp": "03:44:13", "text": "一つは、なんていうか、バカげてる。"}, {"type": "subtitle", "time": 13462.309, "timestamp": "03:44:22", "text": "まあ、今のところは大丈夫だよ、ジョー。うん、"}, {"type": "subtitle", "time": 13465.11, "timestamp": "03:44:25", "text": "今のところは安全です。ええ、嬉しいです。私は"}, {"type": "subtitle", "time": 13467.11, "timestamp": "03:44:27", "text": "嬉しい。"}, {"type": "subtitle", "time": 13470.15, "timestamp": "03:44:30", "text": "あなたは喜んでいない。"}, {"type": "subtitle", "time": 13472.79, "timestamp": "03:44:32", "text": "私が喜んでいないってどういう意味ですか？"}, {"type": "subtitle", "time": 13475.429, "timestamp": "03:44:35", "text": "もし私がそうだったら、最初に死んでいたでしょうし、"}, {"type": "subtitle", "time": 13477.59, "timestamp": "03:44:37", "text": "叫んだりとか。"}, {"type": "subtitle", "time": 13480.229, "timestamp": "03:44:40", "text": "大丈夫。大丈夫。ああ、これは"}, {"type": "subtitle", "time": 13483.349, "timestamp": "03:44:43", "text": "温泉みたいなもの。私のサムネイル"}, {"type": "subtitle", "time": 13486.91, "timestamp": "03:44:46", "text": "彼女の時代から記憶されているカルト"}, {"type": "subtitle", "time": 13488.429, "timestamp": "03:44:48", "text": "ウォッチャー"}, {"type": "subtitle", "time": 13497.429, "timestamp": "03:44:57", "text": "地下の洞窟に隠されている"}]
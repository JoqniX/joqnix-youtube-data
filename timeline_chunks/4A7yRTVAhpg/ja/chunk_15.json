[{"type": "subtitle", "time": 901.509, "timestamp": "00:15:01", "text": "待って。ああ、それは違うキーですね。"}, {"type": "subtitle", "time": 909.11, "timestamp": "00:15:09", "text": "ああ、これはこうなるだろう、これはこうなるだろう"}, {"type": "subtitle", "time": 921.11, "timestamp": "00:15:21", "text": "ああ、簡単に言うと"}, {"type": "subtitle", "time": 924.23, "timestamp": "00:15:24", "text": "そこには。そうそう。変だ。ゲーム"}, {"type": "subtitle", "time": 926.79, "timestamp": "00:15:26", "text": "機械って不思議だよね。"}, {"type": "subtitle", "time": 936.67, "timestamp": "00:15:36", "text": "こんにちはジャスミン、ありがとう"}, {"type": "subtitle", "time": 940.31, "timestamp": "00:15:40", "text": "続く。元気ですか？"}, {"type": "subtitle", "time": 943.11, "timestamp": "00:15:43", "text": "ジャスミン。ああ、彼は魚が欲しいんだ。彼は欲しい"}, {"type": "subtitle", "time": 944.71, "timestamp": "00:15:44", "text": "魚。"}, {"type": "subtitle", "time": 948.189, "timestamp": "00:15:48", "text": "うわ、彼はタイマーを持ってる"}, {"type": "subtitle", "time": 953.23, "timestamp": "00:15:53", "text": "あれ。いいえ、彼は去るんです。"}]
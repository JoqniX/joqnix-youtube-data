[{"type": "subtitle", "time": 16382.79, "timestamp": "04:33:02", "text": "誰も話していないようだったが、確かに人はここにいた。"}, {"type": "subtitle", "time": 16384.59, "timestamp": "04:33:04", "text": "私はしません"}, {"type": "subtitle", "time": 16387.99, "timestamp": "04:33:07", "text": "知る。しかし、それは怖がらせてしまう。"}, {"type": "subtitle", "time": 16390.15, "timestamp": "04:33:10", "text": "残念ながら、ゲームを変更しなければなりません"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "参考までに言うと、ああ、"}, {"type": "subtitle", "time": 16395.83, "timestamp": "04:33:15", "text": "タイトルに「貪り食う」とあるけど、いいねはない"}, {"type": "subtitle", "time": 16399.109, "timestamp": "04:33:19", "text": "ゲームプレイを観戦することで、ゲームプレイを向上させる。ええと、私たちは"}, {"type": "subtitle", "time": 16402.15, "timestamp": "04:33:22", "text": "神話級の別のものみたいだ。彼女はそうだった"}, {"type": "subtitle", "time": 16403.429, "timestamp": "04:33:23", "text": "私たちと一緒に遊ぼうとしている。しかし"}, {"type": "subtitle", "time": 16405.949, "timestamp": "04:33:25", "text": "残念ながら、彼女には"}, {"type": "subtitle", "time": 16408.47, "timestamp": "04:33:28", "text": "合併症。だから、私たちはある意味、"}, {"type": "subtitle", "time": 16411.83, "timestamp": "04:33:31", "text": "えーと、ゲームを変えよう、ええ、"}, {"type": "subtitle", "time": 16414.789, "timestamp": "04:33:34", "text": "二人は難しいし"}, {"type": "subtitle", "time": 16416.789, "timestamp": "04:33:36", "text": "そうでなければ、とても退屈でしょう。だから私たちは"}, {"type": "subtitle", "time": 16419.429, "timestamp": "04:33:39", "text": "ゲームを変えて"}, {"type": "subtitle", "time": 16421.83, "timestamp": "04:33:41", "text": "ちょっと気分転換したいだけなんです"}, {"type": "subtitle", "time": 16424.23, "timestamp": "04:33:44", "text": "物を移動させて"}, {"type": "subtitle", "time": 16426.59, "timestamp": "04:33:46", "text": "そのような。だから、私たちは遊んでいるんです"}, {"type": "subtitle", "time": 16429.75, "timestamp": "04:33:49", "text": "2試合、同じ条件で。わかった、"}, {"type": "subtitle", "time": 16431.429, "timestamp": "04:33:51", "text": "戻ってきました。わからない。戻ってきました。それで"}, {"type": "subtitle", "time": 16435.189, "timestamp": "04:33:55", "text": "以上です。それで、他の誰かも"}, {"type": "subtitle", "time": 16439.189, "timestamp": "04:33:59", "text": "参考までに？ええ、私たちは終わりません"}]
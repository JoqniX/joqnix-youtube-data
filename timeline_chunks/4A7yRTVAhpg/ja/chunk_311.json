[{"type": "subtitle", "time": 18661.27, "timestamp": "05:11:01", "text": "心配しないで、ベック。私はそうします 私はそうします"}, {"type": "subtitle", "time": 18664.31, "timestamp": "05:11:04", "text": "文字通り眠る。心配しないで。"}, {"type": "subtitle", "time": 18666.868, "timestamp": "05:11:06", "text": "あなたは私に何か質問していましたね。続けて。おお、"}, {"type": "subtitle", "time": 18670.15, "timestamp": "05:11:10", "text": "うん。うん。月曜日だったかな？"}, {"type": "subtitle", "time": 18673.75, "timestamp": "05:11:13", "text": "水曜日と土曜日、それとも金曜日？の"}, {"type": "subtitle", "time": 18677.19, "timestamp": "05:11:17", "text": "金曜日。金曜日。あ、待って。遊びたい"}, {"type": "subtitle", "time": 18679.43, "timestamp": "05:11:19", "text": "ゲームをする？"}, {"type": "subtitle", "time": 18683.47, "timestamp": "05:11:23", "text": "そうそう。アーチャン、L42は持っていますか？"}, {"type": "subtitle", "time": 18689.83, "timestamp": "05:11:29", "text": "L42。えっと、もう一度何ですか？いいえ、そうではありません。"}, {"type": "subtitle", "time": 18692.55, "timestamp": "05:11:32", "text": "わかった。それはいくらですか？"}, {"type": "subtitle", "time": 18696.59, "timestamp": "05:11:36", "text": "一緒に参加しませんか？"}, {"type": "subtitle", "time": 18701.5, "timestamp": "05:11:41", "text": "えっと、もし私がそれを持っていたら、私は"}, {"type": "subtitle", "time": 18704.11, "timestamp": "05:11:44", "text": "[音楽]"}, {"type": "subtitle", "time": 18713.99, "timestamp": "05:11:53", "text": "どう思う、ヴィック？"}, {"type": "subtitle", "time": 18716.47, "timestamp": "05:11:56", "text": "わからない。彼が全体を気に入ったら"}, {"type": "subtitle", "time": 18718.788, "timestamp": "05:11:58", "text": "ゾンビゲーム、買いたくない。"}]
[{"type": "subtitle", "time": 13027.67, "timestamp": "03:37:07", "text": "大丈夫。わかった。いいね。いいね。いいね。大丈夫です。"}, {"type": "subtitle", "time": 13029.15, "timestamp": "03:37:09", "text": "その"}, {"type": "subtitle", "time": 13033.59, "timestamp": "03:37:13", "text": "大丈夫。ロードできないと思います"}, {"type": "subtitle", "time": 13035.75, "timestamp": "03:37:15", "text": "ロビー。"}, {"type": "subtitle", "time": 13040.229, "timestamp": "03:37:20", "text": "なんてこった。だから、またやるんだ。"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "ええ、大丈夫です。大丈夫です。私は作ることができます"}, {"type": "subtitle", "time": 13055.75, "timestamp": "03:37:35", "text": "私の"}, {"type": "subtitle", "time": 13057.11, "timestamp": "03:37:37", "text": "あなたは作りたい あなたは作りたい"}, {"type": "subtitle", "time": 13059.11, "timestamp": "03:37:39", "text": "ロビー？いや、違うよ。いいえ。あなたならできます。"}, {"type": "subtitle", "time": 13068.87, "timestamp": "03:37:48", "text": "右。ピーピーピーピーピー。"}, {"type": "subtitle", "time": 13072.469, "timestamp": "03:37:52", "text": "何だと思う？ああ、ちょっと待ってください。あなた"}, {"type": "subtitle", "time": 13074.75, "timestamp": "03:37:54", "text": "君たちは色々なことを試してみたいんだ"}, {"type": "subtitle", "time": 13078.95, "timestamp": "03:37:58", "text": "地図？ああ、それはできますよ。もちろん。"}]
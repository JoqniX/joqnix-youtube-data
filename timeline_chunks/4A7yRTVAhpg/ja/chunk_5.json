[{"type": "subtitle", "time": 301.749, "timestamp": "00:05:01", "text": "できる。いいえ、まだやっています。それは"}, {"type": "subtitle", "time": 311.51, "timestamp": "00:05:11", "text": "24. 招待状を受け取りました。いいですね。できる"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "私を招待してくれるの？傷がついてしまってすみません。私は"}, {"type": "subtitle", "time": 316.71, "timestamp": "00:05:16", "text": "リストを順に見ていく。はい、申し訳ありません"}, {"type": "subtitle", "time": 318.87, "timestamp": "00:05:18", "text": "擦り傷だよ、おい。大丈夫。招待するだけで"}, {"type": "subtitle", "time": 320.95, "timestamp": "00:05:20", "text": "自分自身。実際、そう、できるよ"}, {"type": "subtitle", "time": 323.43, "timestamp": "00:05:23", "text": "正直言って、そう思います。ええ、ここにいますよ。誰が"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "私たちが見逃したものは？なんてこった。見逃している"}, {"type": "subtitle", "time": 329.11, "timestamp": "00:05:29", "text": "誰か？こんにちは、うまくいきません。わかった。私はえっと"}, {"type": "subtitle", "time": 331.51, "timestamp": "00:05:31", "text": "うん。うん。えっと、どうやって退出すればいいんでしたっけ？えっと、"}, {"type": "subtitle", "time": 333.909, "timestamp": "00:05:33", "text": "待って。彼らはどうやって脱出するのか？逃げる。出口"}, {"type": "subtitle", "time": 337.67, "timestamp": "00:05:37", "text": "メニューへ。さあ行こう。うん。逃げる。またはあなた"}, {"type": "subtitle", "time": 339.51, "timestamp": "00:05:39", "text": "ほら、飛び越えることができる"}, {"type": "subtitle", "time": 341.749, "timestamp": "00:05:41", "text": "招待する。待って。私には見えません。はい、"}, {"type": "subtitle", "time": 345.029, "timestamp": "00:05:45", "text": "とりあえず、これをクリックしてみます。では、"}, {"type": "subtitle", "time": 347.83, "timestamp": "00:05:47", "text": "あなたは走るのが好きですか？"}, {"type": "subtitle", "time": 350.629, "timestamp": "00:05:50", "text": "それで、みんな、Oh my のために何をするの？"}, {"type": "subtitle", "time": 354.15, "timestamp": "00:05:54", "text": "神。わかった。わかった。"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "お前の父親だよ。"}, {"type": "subtitle", "time": 358.71, "timestamp": "00:05:58", "text": "それはひどい。あなたが"}]
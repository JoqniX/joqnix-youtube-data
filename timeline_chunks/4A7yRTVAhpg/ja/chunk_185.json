[{"type": "subtitle", "time": 11100.63, "timestamp": "03:05:00", "text": "自らザジルを召喚する。 2年間、"}, {"type": "subtitle", "time": 11103.51, "timestamp": "03:05:03", "text": "アンナは、"}, {"type": "subtitle", "time": 11106.469, "timestamp": "03:05:06", "text": "古代の文献を探求しながら、彼女は"}, {"type": "subtitle", "time": 11108.429, "timestamp": "03:05:08", "text": "ヤギを育てる"}, {"type": "subtitle", "time": 11111.429, "timestamp": "03:05:11", "text": "悪魔。長い時間だ。それは"}, {"type": "subtitle", "time": 11113.67, "timestamp": "03:05:13", "text": "エイプリルがこれまで経験したどんな関係よりも長い"}, {"type": "subtitle", "time": 11117.269, "timestamp": "03:05:17", "text": "持っていた。破滅的な構想だ。"}, {"type": "subtitle", "time": 11119.99, "timestamp": "03:05:19", "text": "彼女の最も信頼できるフォロワーの一人として、"}, {"type": "subtitle", "time": 11122.63, "timestamp": "03:05:22", "text": "アンナの家に到着すると、"}, {"type": "subtitle", "time": 11127.349, "timestamp": "03:05:27", "text": "何が、あるいは誰が間違っていたのかを明らかにする。誰が"}, {"type": "subtitle", "time": 11130.15, "timestamp": "03:05:30", "text": "何かがうまくいかなかった？ああ、シモはできないだろう"}, {"type": "subtitle", "time": 11133.19, "timestamp": "03:05:33", "text": "参加しませんか。彼には任務がある。"}, {"type": "subtitle", "time": 11136.309, "timestamp": "03:05:36", "text": "なんてこった。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 11142.389, "timestamp": "03:05:42", "text": "大丈夫。持続する。こんにちは、ブルー。感謝"}, {"type": "subtitle", "time": 11145.19, "timestamp": "03:05:45", "text": "読んでくれてありがとう。配信へようこ​​そ。"}, {"type": "subtitle", "time": 11148.309, "timestamp": "03:05:48", "text": "お元気ですか？あ、ちょっと待って。なぜ"}, {"type": "subtitle", "time": 11150.389, "timestamp": "03:05:50", "text": "暗い？何てことだ。入手方法"}]
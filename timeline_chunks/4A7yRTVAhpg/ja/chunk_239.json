[{"type": "subtitle", "time": 14341.32, "timestamp": "03:59:01", "text": "良い。"}, {"type": "subtitle", "time": 14343.189, "timestamp": "03:59:03", "text": "[音楽]"}, {"type": "subtitle", "time": 14345.189, "timestamp": "03:59:05", "text": "ええ、ご希望であればゲームを変更することもできますよ。"}, {"type": "subtitle", "time": 14347.75, "timestamp": "03:59:07", "text": "どんなゲームがやりたい？カイルのように、"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "どんなゲームをプレイしたいですか？"}, {"type": "subtitle", "time": 14352.07, "timestamp": "03:59:12", "text": "けれど？どんなゲームがありますか？私は"}, {"type": "subtitle", "time": 14356.229, "timestamp": "03:59:16", "text": "質問。ストリームをアップロードしてくれよ。おお、"}, {"type": "subtitle", "time": 14359.189, "timestamp": "03:59:19", "text": "えっと、神様って何て呼ぶの？それは怖かった。"}, {"type": "subtitle", "time": 14362.469, "timestamp": "03:59:22", "text": "うん。ああ、こんにちは、ジャックさん。こんにちは。"}, {"type": "subtitle", "time": 14365.269, "timestamp": "03:59:25", "text": "目玉みたいなのはどこ？私はできません"}, {"type": "subtitle", "time": 14367.269, "timestamp": "03:59:27", "text": "探す。"}, {"type": "subtitle", "time": 14369.349, "timestamp": "03:59:29", "text": "わかった。彼は興味を持っているように見える。私"}, {"type": "subtitle", "time": 14371.67, "timestamp": "03:59:31", "text": "私は自分のものを見つけたけど、ただ落としてしまった"}, {"type": "subtitle", "time": 14373.189, "timestamp": "03:59:33", "text": "すぐに、だって私はしたくないから"}, {"type": "subtitle", "time": 14376.309, "timestamp": "03:59:36", "text": "これを再生してください。あなたなら何と言いますか"}, {"type": "subtitle", "time": 14378.229, "timestamp": "03:59:38", "text": "あなたが手に持っているゲームは何ですか？"}, {"type": "subtitle", "time": 14381.83, "timestamp": "03:59:41", "text": "今？えっと、現在インストールしているものは"}, {"type": "subtitle", "time": 14384.55, "timestamp": "03:59:44", "text": "モンスターハンターライズ。私はヒーローズを持っています"}, {"type": "subtitle", "time": 14387.51, "timestamp": "03:59:47", "text": "ハンマーウォッチ。私にはゴルフフィットネス仲間がいます。私"}, {"type": "subtitle", "time": 14391.03, "timestamp": "03:59:51", "text": "ハンマーのヒーローがゲームを観戦する。私"}, {"type": "subtitle", "time": 14395.429, "timestamp": "03:59:55", "text": "やめてください。ああ。 O. もっとゲームがあります。私"}, {"type": "subtitle", "time": 14399.83, "timestamp": "03:59:59", "text": "『Left 4 Dead』も持っています。私は"}]
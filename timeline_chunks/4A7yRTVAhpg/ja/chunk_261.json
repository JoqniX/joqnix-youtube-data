[{"type": "subtitle", "time": 15663.349, "timestamp": "04:21:03", "text": "とても順調です。ジョック。来て。うん。"}, {"type": "subtitle", "time": 15666.149, "timestamp": "04:21:06", "text": "二人とも誇りに思うよ。"}, {"type": "subtitle", "time": 15670.149, "timestamp": "04:21:10", "text": "70キル。何てことだ。ニース。"}, {"type": "subtitle", "time": 15672.71, "timestamp": "04:21:12", "text": "わかった。ザックさん、あなたは自分が"}, {"type": "subtitle", "time": 15685.67, "timestamp": "04:21:25", "text": "こんにちは。何てことだ。何てことだ。ジョック。ほとんどの"}, {"type": "subtitle", "time": 15688.63, "timestamp": "04:21:28", "text": "彼の肌はとても紫色だ。疑問に思う"}, {"type": "subtitle", "time": 15691.429, "timestamp": "04:21:31", "text": "それはあなたの好きな色かどうか。ああ、いとこ"}, {"type": "subtitle", "time": 15695.269, "timestamp": "04:21:35", "text": "ジョックのユニフォームの色は今は紫だ。そうしなければならなかった"}, {"type": "subtitle", "time": 15699.429, "timestamp": "04:21:39", "text": "紫。青色のバリエーションをもっと増やしてほしい。"}, {"type": "subtitle", "time": 15708.51, "timestamp": "04:21:48", "text": "はい。自社ブランド。"}, {"type": "subtitle", "time": 15711.189, "timestamp": "04:21:51", "text": "はい。とにかく、もう一度やりたいの？"}, {"type": "subtitle", "time": 15714.309, "timestamp": "04:21:54", "text": "マッチドロップ？ええ、もちろんです。もちろん。楽しい"}, {"type": "subtitle", "time": 15716.309, "timestamp": "04:21:56", "text": "エスカレーションみたいなマッチ？"}, {"type": "subtitle", "time": 15718.55, "timestamp": "04:21:58", "text": "ええ、もちろんです。もちろん。素晴らしい。私は愛する"}]
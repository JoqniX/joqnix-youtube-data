[{"type": "subtitle", "time": 7981.629, "timestamp": "02:13:01", "text": "[音楽]"}, {"type": "subtitle", "time": 7983.589, "timestamp": "02:13:03", "text": "うるさい。待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 7993.03, "timestamp": "02:13:13", "text": "私たちは何を得るのでしょうか？見えない。私はできません"}, {"type": "subtitle", "time": 7994.35, "timestamp": "02:13:14", "text": "教えて。その"}, {"type": "subtitle", "time": 7996.83, "timestamp": "02:13:16", "text": "わかった。ああ、それはオートだ"}, {"type": "subtitle", "time": 7999.95, "timestamp": "02:13:19", "text": "メッキ工。私はそれが嫌いです"}, {"type": "subtitle", "time": 8003.75, "timestamp": "02:13:23", "text": "自動。何？それは何ですか？すべてにプレート"}, {"type": "subtitle", "time": 8005.91, "timestamp": "02:13:25", "text": "料理が出来上がったとき、でもそれが好き"}, {"type": "subtitle", "time": 8007.82, "timestamp": "02:13:27", "text": "本当に最悪だ。"}, {"type": "subtitle", "time": 8020.229, "timestamp": "02:13:40", "text": "[音楽]"}, {"type": "subtitle", "time": 8022.069, "timestamp": "02:13:42", "text": "駅。最大4つの同じものを収納できます"}, {"type": "subtitle", "time": 8035.03, "timestamp": "02:13:55", "text": "カウンタ？たくさんあります。ええ、できますよ。"}]
[{"type": "subtitle", "time": 11161.83, "timestamp": "03:06:01", "text": "ジャック、360度ノー・スコープをやらなきゃ。"}, {"type": "subtitle", "time": 11164.55, "timestamp": "03:06:04", "text": "このために。待ってて、私は"}, {"type": "subtitle", "time": 11167.03, "timestamp": "03:06:07", "text": "それを実行する。わかった。わかった。やってますよ。私は"}, {"type": "subtitle", "time": 11169.269, "timestamp": "03:06:09", "text": "やってみます。"}, {"type": "subtitle", "time": 11171.67, "timestamp": "03:06:11", "text": "君たちはもっと低いレベルにリードしたいのか、それとも君たちは"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "中に入る？わかった。 360度見ました。はい。"}, {"type": "subtitle", "time": 11178.71, "timestamp": "03:06:18", "text": "わかった。取締役会と共に。"}, {"type": "subtitle", "time": 11182.469, "timestamp": "03:06:22", "text": "わかった。 10月14日。簡単ではなかった"}, {"type": "subtitle", "time": 11184.75, "timestamp": "03:06:24", "text": "召喚のためにヤギを集める"}, {"type": "subtitle", "time": 11188.79, "timestamp": "03:06:28", "text": "儀式。たくさんのクソがあってよかった"}, {"type": "subtitle", "time": 11191.91, "timestamp": "03:06:31", "text": "ああ、そうなんですか？うん。くそ。やあ、始めよう"}, {"type": "subtitle", "time": 11194.15, "timestamp": "03:06:34", "text": "それが良い考えだったのかどうか疑問に思う"}, {"type": "subtitle", "time": 11196.389, "timestamp": "03:06:36", "text": "これだけでも十分だ。ネイサンはいつも私に"}, {"type": "subtitle", "time": 11198.55, "timestamp": "03:06:38", "text": "私は自分の仲間と一緒にいるべきです"}, {"type": "subtitle", "time": 11202.07, "timestamp": "03:06:42", "text": "その時が来る。なんだか変な感じがする。私の肌"}, {"type": "subtitle", "time": 11205.03, "timestamp": "03:06:45", "text": "肌が焼けるように痛い。どうしたの？"}, {"type": "subtitle", "time": 11207.91, "timestamp": "03:06:47", "text": "この血？これでさよならです。"}, {"type": "subtitle", "time": 11211.51, "timestamp": "03:06:51", "text": "ええ、大丈夫です。それはトマトソースです。その"}, {"type": "subtitle", "time": 11214.87, "timestamp": "03:06:54", "text": "うん。いちご。イチゴソース。はい。"}, {"type": "subtitle", "time": 11218.23, "timestamp": "03:06:58", "text": "はい。彼はああ、彼はああを得ている。"}]
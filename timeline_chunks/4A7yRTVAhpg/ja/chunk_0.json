[{"type": "chat", "time": 0.0, "timestamp": "00:00:00", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight's Guest - Viola Santiago - https://www.twitch.tv/viola_santiago | https://www.youtube.com/@viola_santiago"}, {"type": "subtitle", "time": 4.47, "timestamp": "00:00:04", "text": "待って。みんな、誰かこれ拾ってくれない？"}, {"type": "subtitle", "time": 7.31, "timestamp": "00:00:07", "text": "脚と腕？"}, {"type": "subtitle", "time": 10.23, "timestamp": "00:00:10", "text": "私は大丈夫です。わかった。わかった。"}, {"type": "subtitle", "time": 11.23, "timestamp": "00:00:11", "text": "私たちはすべきでしょうか"}, {"type": "subtitle", "time": 16.63, "timestamp": "00:00:16", "text": "了解しました。わかった。基地を作っているのか？"}, {"type": "subtitle", "time": 18.95, "timestamp": "00:00:18", "text": "向こう岸にいる私たちは"}, {"type": "subtitle", "time": 22.79, "timestamp": "00:00:22", "text": "私たちの目の前にいるように。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 25.91, "timestamp": "00:00:25", "text": "こんにちは。六。わかった。また、私はちょうど手に入れた"}, {"type": "subtitle", "time": 28.63, "timestamp": "00:00:28", "text": "予期せぬ客が何人かいた。だから、これは"}, {"type": "subtitle", "time": 30.31, "timestamp": "00:00:30", "text": "ジャズになる予定です、手伝ってくれますか"}, {"type": "subtitle", "time": 34.15, "timestamp": "00:00:34", "text": "私がこの食べ物を運ぶ？ああ、どうやって"}, {"type": "subtitle", "time": 36.95, "timestamp": "00:00:36", "text": "このゲームは動作しますか？"}, {"type": "subtitle", "time": 38.229, "timestamp": "00:00:38", "text": "こちらには食べ物があります"}, {"type": "subtitle", "time": 39.91, "timestamp": "00:00:39", "text": "ここ。話してはいけないことは分かっています"}, {"type": "subtitle", "time": 42.069, "timestamp": "00:00:42", "text": "私のチャットについて。"}, {"type": "subtitle", "time": 45.75, "timestamp": "00:00:45", "text": "皆さんはキャスピアを知っていますよね？そうそう。"}, {"type": "subtitle", "time": 48.31, "timestamp": "00:00:48", "text": "彼は、私は彼の言葉が全く理解できないと言います"}, {"type": "subtitle", "time": 51.11, "timestamp": "00:00:51", "text": "言ってるけど、そう、彼はそういうことを言ってるんだ。"}]
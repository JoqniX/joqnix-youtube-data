[{"type": "subtitle", "time": 16802.868, "timestamp": "04:40:02", "text": "ドーンという感じではない。それはあなたを"}, {"type": "subtitle", "time": 16805.27, "timestamp": "04:40:05", "text": "心理学を復活させる。裏部屋からの脱出"}, {"type": "subtitle", "time": 16809.27, "timestamp": "04:40:09", "text": "心理ホラー。何てことだ。うん。"}, {"type": "subtitle", "time": 16812.628, "timestamp": "04:40:12", "text": "思い出させてくれてありがとう。はい、私たちは"}, {"type": "subtitle", "time": 16815.99, "timestamp": "04:40:15", "text": "このゲームをもう一度プレイしてください。"}, {"type": "subtitle", "time": 16820.948, "timestamp": "04:40:20", "text": "なぜ私はああ、なんてことだ。何？ああ、なんてことだ。"}, {"type": "subtitle", "time": 16830.868, "timestamp": "04:40:30", "text": "まさか自分がP2Pでプレイするなんて信じられない"}, {"type": "subtitle", "time": 16833.11, "timestamp": "04:40:33", "text": "遊び時間。"}, {"type": "subtitle", "time": 16835.47, "timestamp": "04:40:35", "text": "それは"}, {"type": "subtitle", "time": 16838.31, "timestamp": "04:40:38", "text": "心理的な。何てことだ。リモートリアル"}, {"type": "subtitle", "time": 16841.75, "timestamp": "04:40:41", "text": "お得な情報。ああ、文学部は"}, {"type": "subtitle", "time": 16844.47, "timestamp": "04:40:44", "text": "それもいいですね。ええ、私にとってはそうではありません"}, {"type": "subtitle", "time": 16847.35, "timestamp": "04:40:47", "text": "まるで、ただのびっくりさせるようなジャンプスケアみたいだ。誰が気にする？"}, {"type": "subtitle", "time": 16850.868, "timestamp": "04:40:50", "text": "デッドスペースは良いゲームだ。 Dead Space by"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "シュダ。しかし、値段が高い。"}, {"type": "subtitle", "time": 16857.19, "timestamp": "04:40:57", "text": "でも値段が高いですね。 3,000。"}, {"type": "subtitle", "time": 16859.91, "timestamp": "04:40:59", "text": "パンと無料。ああ、マルチプレイヤーゲームですね"}]
[{"type": "subtitle", "time": 12001.59, "timestamp": "03:20:01", "text": "裏口も施錠されています。私"}, {"type": "subtitle", "time": 12003.95, "timestamp": "03:20:03", "text": "鍵は中にあると思う"}, {"type": "subtitle", "time": 12007.469, "timestamp": "03:20:07", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 12011.429, "timestamp": "03:20:11", "text": "おっと、またカボチャだ。"}, {"type": "subtitle", "time": 12021.56, "timestamp": "03:20:21", "text": "ちくしょう。よし、悪魔を殺せ。"}, {"type": "subtitle", "time": 12023.269, "timestamp": "03:20:23", "text": "[音楽]"}, {"type": "subtitle", "time": 12027.75, "timestamp": "03:20:27", "text": "とても混乱しています。こんにちは。こんにちは。私は私は"}, {"type": "subtitle", "time": 12031.83, "timestamp": "03:20:31", "text": "今でも愛を探し求めている。私"}, {"type": "subtitle", "time": 12034.429, "timestamp": "03:20:34", "text": "子供たちを私たち二人で共有できたらいいのに。それで、"}, {"type": "subtitle", "time": 12039.349, "timestamp": "03:20:39", "text": "待って。そこで、私には考えがあるんです。だから、もしアンナが"}, {"type": "subtitle", "time": 12042.469, "timestamp": "03:20:42", "text": "捕まったら、死ぬ。えっと、あなたは"}, {"type": "subtitle", "time": 12044.71, "timestamp": "03:20:44", "text": "行動不能になった後、蘇生させることができる"}, {"type": "subtitle", "time": 12047.269, "timestamp": "03:20:47", "text": "救急キットを持ったあなた。"}, {"type": "subtitle", "time": 12048.75, "timestamp": "03:20:48", "text": "ああ、どうすれば"}, {"type": "subtitle", "time": 12053.75, "timestamp": "03:20:53", "text": "えっと、またアンナの家から逃げ出した。彼女が手に入れたら"}, {"type": "subtitle", "time": 12056.55, "timestamp": "03:20:56", "text": "お前は、死んだんだ。あなたは紫外線を"}, {"type": "subtitle", "time": 12059.83, "timestamp": "03:20:59", "text": "彼女。紫外線ライトを当てて気絶させるんだ、"}]
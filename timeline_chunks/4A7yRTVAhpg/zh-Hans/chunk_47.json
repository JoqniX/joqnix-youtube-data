[{"type": "subtitle", "time": 2824.88, "timestamp": "00:47:04", "text": "等待。更多人来了。哦，我的"}, {"type": "subtitle", "time": 2833.79, "timestamp": "00:47:13", "text": "上帝。之后立刻让他离开飞机。"}, {"type": "subtitle", "time": 2846.79, "timestamp": "00:47:26", "text": "[音乐]"}, {"type": "subtitle", "time": 2850.23, "timestamp": "00:47:30", "text": "拿到它们。拿到它们。"}, {"type": "subtitle", "time": 2852.34, "timestamp": "00:47:32", "text": "莴苣。"}, {"type": "subtitle", "time": 2854.47, "timestamp": "00:47:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2857.91, "timestamp": "00:47:37", "text": "我来拿着。"}, {"type": "subtitle", "time": 2859.589, "timestamp": "00:47:39", "text": "我还需要一个盘子。我认为这是最好的"}, {"type": "subtitle", "time": 2861.51, "timestamp": "00:47:41", "text": "这么说吧。"}, {"type": "subtitle", "time": 2863.15, "timestamp": "00:47:43", "text": "好的。好的。在那里"}, {"type": "subtitle", "time": 2865.15, "timestamp": "00:47:45", "text": "去。"}, {"type": "subtitle", "time": 2866.84, "timestamp": "00:47:46", "text": "我们 他们是"}, {"type": "subtitle", "time": 2870.27, "timestamp": "00:47:50", "text": "[音乐]"}, {"type": "subtitle", "time": 2873.81, "timestamp": "00:47:53", "text": "未来。我们做到了。"}]
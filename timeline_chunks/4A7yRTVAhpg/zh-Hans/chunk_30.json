[{"type": "subtitle", "time": 1823.909, "timestamp": "00:30:23", "text": "我没有地方可以做这件事。啊。"}, {"type": "subtitle", "time": 1832.63, "timestamp": "00:30:32", "text": "他们需要什么？哦，他们需要两个"}, {"type": "subtitle", "time": 1836.23, "timestamp": "00:30:36", "text": "媒介。好的。我该把这个扔到哪里？"}, {"type": "subtitle", "time": 1837.83, "timestamp": "00:30:37", "text": "呃，垃圾桶。哦，没有了。"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "垃圾。呃，没有空间了。呃，"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "就让它这样吧。我的天啊。哦，我们需要"}, {"type": "subtitle", "time": 1848.17, "timestamp": "00:30:48", "text": "还有一个。是的。是的。"}, {"type": "subtitle", "time": 1854.549, "timestamp": "00:30:54", "text": "[音乐]"}, {"type": "subtitle", "time": 1858.389, "timestamp": "00:30:58", "text": "所以，我们需要更多的垃圾桶之类的东西。嗯，"}]
[{"type": "chat", "time": 0.0, "timestamp": "00:00:00", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight's Guest - Viola Santiago - https://www.twitch.tv/viola_santiago | https://www.youtube.com/@viola_santiago"}, {"type": "subtitle", "time": 4.47, "timestamp": "00:00:04", "text": "等待。各位，有人能帮忙拿一下这个吗？"}, {"type": "subtitle", "time": 7.31, "timestamp": "00:00:07", "text": "腿和胳膊？"}, {"type": "subtitle", "time": 10.23, "timestamp": "00:00:10", "text": "我没事。好的。好的。"}, {"type": "subtitle", "time": 11.23, "timestamp": "00:00:11", "text": "我们应该"}, {"type": "subtitle", "time": 16.63, "timestamp": "00:00:16", "text": "没问题。好的。我们是在建立基地吗？"}, {"type": "subtitle", "time": 18.95, "timestamp": "00:00:18", "text": "我们在对岸的另一边。"}, {"type": "subtitle", "time": 22.79, "timestamp": "00:00:22", "text": "就像在我们面前一样。你好。你好。"}, {"type": "subtitle", "time": 25.91, "timestamp": "00:00:25", "text": "你好。六。好的。另外，我刚刚……"}, {"type": "subtitle", "time": 28.63, "timestamp": "00:00:28", "text": "一些不速之客。所以，这个"}, {"type": "subtitle", "time": 30.31, "timestamp": "00:00:30", "text": "将会是一场爵士乐演出，你能帮忙吗？"}, {"type": "subtitle", "time": 34.15, "timestamp": "00:00:34", "text": "我来拿这些食物吗？哦，怎么会这样"}, {"type": "subtitle", "time": 36.95, "timestamp": "00:00:36", "text": "这个游戏能玩吗？"}, {"type": "subtitle", "time": 38.229, "timestamp": "00:00:38", "text": "这边有一些食物"}, {"type": "subtitle", "time": 39.91, "timestamp": "00:00:39", "text": "这里。我知道我不应该说话。"}, {"type": "subtitle", "time": 42.069, "timestamp": "00:00:42", "text": "关于我的聊天记录。"}, {"type": "subtitle", "time": 45.75, "timestamp": "00:00:45", "text": "你们都知道里海吧？哦，是的。"}, {"type": "subtitle", "time": 48.31, "timestamp": "00:00:48", "text": "他说我一个字都听不懂。"}, {"type": "subtitle", "time": 51.11, "timestamp": "00:00:51", "text": "他说，没错，他说的就是那些话。"}]
[{"type": "subtitle", "time": 17289.99, "timestamp": "04:48:09", "text": "是的。总之，我的天哪。我不知道"}, {"type": "subtitle", "time": 17293.67, "timestamp": "04:48:13", "text": "他们这次是怎么熬夜的？须美"}, {"type": "subtitle", "time": 17296.67, "timestamp": "04:48:16", "text": "服务器就像……"}, {"type": "subtitle", "time": 17299.83, "timestamp": "04:48:19", "text": "满的。耶稣基督。"}, {"type": "subtitle", "time": 17302.27, "timestamp": "04:48:22", "text": "这些人实际上是"}, {"type": "subtitle", "time": 17304.55, "timestamp": "04:48:24", "text": "疯狂的。我觉得自己快要死了"}, {"type": "subtitle", "time": 17306.868, "timestamp": "04:48:26", "text": "现在，但这些人却说：别这样"}, {"type": "subtitle", "time": 17311.11, "timestamp": "04:48:31", "text": "死。是啊，我好累。哦，天哪，我"}, {"type": "subtitle", "time": 17313.19, "timestamp": "04:48:33", "text": "需要出道。老兄，就像什么？"}, {"type": "subtitle", "time": 17315.43, "timestamp": "04:48:35", "text": "我该怎么办？是的。何时"}, {"type": "subtitle", "time": 17317.99, "timestamp": "04:48:37", "text": "你要去参加罢工吗？比如什么？"}, {"type": "subtitle", "time": 17324.39, "timestamp": "04:48:44", "text": "比如，不不不不，像实际的东西，比如"}, {"type": "subtitle", "time": 17328.07, "timestamp": "04:48:48", "text": "我如何在推特上宣传我的出道作品？"}, {"type": "subtitle", "time": 17330.55, "timestamp": "04:48:50", "text": "哦，你可以像这样揭晓模型。"}, {"type": "subtitle", "time": 17333.55, "timestamp": "04:48:53", "text": "现在确实有人在审查它。我不"}, {"type": "subtitle", "time": 17337.03, "timestamp": "04:48:57", "text": "出道后会像真的一样"}]
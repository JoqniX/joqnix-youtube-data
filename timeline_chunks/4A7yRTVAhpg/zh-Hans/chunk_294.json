[{"type": "subtitle", "time": 17640.15, "timestamp": "04:54:00", "text": "美好的。总之，是的。呃，下周是什么？"}, {"type": "subtitle", "time": 17642.99, "timestamp": "04:54:02", "text": "再次？我们要玩《求生之路》"}, {"type": "subtitle", "time": 17647.67, "timestamp": "04:54:07", "text": "新的 Gingito 游戏。是的，"}, {"type": "subtitle", "time": 17657.59, "timestamp": "04:54:17", "text": "是的。你还想玩原神吗？我"}, {"type": "subtitle", "time": 17659.91, "timestamp": "04:54:19", "text": "很想玩原神。是的。你"}, {"type": "subtitle", "time": 17662.788, "timestamp": "04:54:22", "text": "知道什么？我们来改变它。原神左"}, {"type": "subtitle", "time": 17665.07, "timestamp": "04:54:25", "text": "有脚的和"}, {"type": "subtitle", "time": 17667.75, "timestamp": "04:54:27", "text": "金吉托。 Gingiito 真是别具一格。"}, {"type": "subtitle", "time": 17669.83, "timestamp": "04:54:29", "text": "就像你，我不知道你喜欢什么。"}, {"type": "subtitle", "time": 17671.99, "timestamp": "04:54:31", "text": "购买这款游戏是因为它就像……"}, {"type": "subtitle", "time": 17673.67, "timestamp": "04:54:33", "text": "单人游戏。是的。我觉得不是这样。"}, {"type": "subtitle", "time": 17676.15, "timestamp": "04:54:36", "text": "我们还会再次使用它。而不是"}, {"type": "subtitle", "time": 17678.15, "timestamp": "04:54:38", "text": "金吉托，你想扮演邪恶角色吗？"}, {"type": "subtitle", "time": 17680.31, "timestamp": "04:54:40", "text": "因为我是免费得到的，所以就放在这里了。"}, {"type": "subtitle", "time": 17682.948, "timestamp": "04:54:42", "text": "哦，是的。是的。我也想这么做"}, {"type": "subtitle", "time": 17686.15, "timestamp": "04:54:46", "text": "玩《恶灵附身》。我们可以做到。是的。"}, {"type": "subtitle", "time": 17688.628, "timestamp": "04:54:48", "text": "而不是像那样直接买下来"}, {"type": "subtitle", "time": 17690.55, "timestamp": "04:54:50", "text": "只是看着它，想知道该怎么做，或者"}, {"type": "subtitle", "time": 17692.628, "timestamp": "04:54:52", "text": "某物。我们可以玩免费游戏。"}, {"type": "subtitle", "time": 17695.51, "timestamp": "04:54:55", "text": "游戏，就像我会玩一样，你"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "会对此作出反应。怎么样？"}]
[{"type": "subtitle", "time": 4385.669, "timestamp": "01:13:05", "text": "17项研究测试发现了她。好的，我"}, {"type": "subtitle", "time": 4388.63, "timestamp": "01:13:08", "text": "我觉得我们可以把它放进去，但是我们可能会……"}, {"type": "subtitle", "time": 4390.15, "timestamp": "01:13:10", "text": "餐桌。"}, {"type": "subtitle", "time": 4405.99, "timestamp": "01:13:25", "text": "等等，我刚才做了什么？"}, {"type": "subtitle", "time": 4408.43, "timestamp": "01:13:28", "text": "哦，有份新日历。"}, {"type": "subtitle", "time": 4412.07, "timestamp": "01:13:32", "text": "哦，老家伙了。"}, {"type": "subtitle", "time": 4413.229, "timestamp": "01:13:33", "text": "研究"}, {"type": "subtitle", "time": 4416.229, "timestamp": "01:13:36", "text": "测试。是免费的吗？我的意思是，我们可以得到它"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "下一轮。不，不是。售价40美元。"}, {"type": "subtitle", "time": 4421.189, "timestamp": "01:13:41", "text": "哦，其他轮次的那些东西呢？"}, {"type": "subtitle", "time": 4424.47, "timestamp": "01:13:44", "text": "它还会在那里吗？"}, {"type": "subtitle", "time": 4428.149, "timestamp": "01:13:48", "text": "嗯，如果我们把它放在这里，是的，它会"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "可以，但我们一次只能放一个。"}, {"type": "subtitle", "time": 4434.21, "timestamp": "01:13:54", "text": "所以，"}, {"type": "subtitle", "time": 4435.39, "timestamp": "01:13:55", "text": "[音乐]"}, {"type": "subtitle", "time": 4438.95, "timestamp": "01:13:58", "text": "是的。不，没关系。这是研究"}]
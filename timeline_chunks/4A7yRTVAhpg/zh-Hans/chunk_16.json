[{"type": "subtitle", "time": 967.509, "timestamp": "00:16:07", "text": "[音乐]"}, {"type": "subtitle", "time": 973.35, "timestamp": "00:16:13", "text": "哦，装上拉链式门襟。在哪里"}, {"type": "subtitle", "time": 979.35, "timestamp": "00:16:19", "text": "然后，哦，你需要把……"}, {"type": "subtitle", "time": 981.59, "timestamp": "00:16:21", "text": "每次都摆盘。"}, {"type": "subtitle", "time": 983.069, "timestamp": "00:16:23", "text": "哦，是的"}, {"type": "subtitle", "time": 987.79, "timestamp": "00:16:27", "text": "完毕。你们俩最近怎么样？我没事。怎么样？"}, {"type": "subtitle", "time": 993.03, "timestamp": "00:16:33", "text": "乔？乔克，你好吗？我靠……勉强维持生计"}, {"type": "subtitle", "time": 996.629, "timestamp": "00:16:36", "text": "虽然睡眠不足，但我还是来了。呃，那是"}, {"type": "subtitle", "time": 999.03, "timestamp": "00:16:39", "text": "我们俩。"}, {"type": "subtitle", "time": 1007.44, "timestamp": "00:16:47", "text": "西尔维。让我再做一份。"}, {"type": "subtitle", "time": 1009.31, "timestamp": "00:16:49", "text": "[音乐]"}]
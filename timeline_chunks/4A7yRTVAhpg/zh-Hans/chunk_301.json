[{"type": "subtitle", "time": 18060.23, "timestamp": "05:01:00", "text": "麻烦。"}, {"type": "subtitle", "time": 18063.948, "timestamp": "05:01:03", "text": "祝你明天工作一切顺利。"}, {"type": "subtitle", "time": 18066.788, "timestamp": "05:01:06", "text": "祝你一切顺利，杰克。是的，"}, {"type": "subtitle", "time": 18069.03, "timestamp": "05:01:09", "text": "请结束直播，别这样。"}, {"type": "subtitle", "time": 18071.83, "timestamp": "05:01:11", "text": "直播到早上8点。不，不，不，不。"}, {"type": "subtitle", "time": 18073.83, "timestamp": "05:01:13", "text": "不，不，不，不，不，不，不，不。你知道"}, {"type": "subtitle", "time": 18074.948, "timestamp": "05:01:14", "text": "什么？我打算留下来。我要"}, {"type": "subtitle", "time": 18077.948, "timestamp": "05:01:17", "text": "停留。你结束了。你结束了。"}, {"type": "subtitle", "time": 18081.67, "timestamp": "05:01:21", "text": "不，我不需要她。嗯，我就说说吧。"}, {"type": "subtitle", "time": 18084.27, "timestamp": "05:01:24", "text": "一会儿，就像我"}, {"type": "subtitle", "time": 18088.47, "timestamp": "05:01:28", "text": "保证你需要睡眠，就像睡眠一样。"}, {"type": "subtitle", "time": 18091.19, "timestamp": "05:01:31", "text": "你需要。"}, {"type": "subtitle", "time": 18094.708, "timestamp": "05:01:34", "text": "顺便说一句，对你来说也是新的。哦，是的，不"}, {"type": "subtitle", "time": 18096.55, "timestamp": "05:01:36", "text": "担忧。我好像在想醒来"}, {"type": "subtitle", "time": 18098.39, "timestamp": "05:01:38", "text": "早起，喜欢对着一个骗子做这种事。"}, {"type": "subtitle", "time": 18101.03, "timestamp": "05:01:41", "text": "明天。是的，"}, {"type": "subtitle", "time": 18103.83, "timestamp": "05:01:43", "text": "那你得早睡了。是的，"}, {"type": "subtitle", "time": 18106.628, "timestamp": "05:01:46", "text": "因此，我的发言就到此为止了。我"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "我不认为1:30是鲨鱼出没的早期时间。"}, {"type": "subtitle", "time": 18110.75, "timestamp": "05:01:50", "text": "哦，"}, {"type": "subtitle", "time": 18114.23, "timestamp": "05:01:54", "text": "等待。没关系。但是，呃，是的，"}, {"type": "subtitle", "time": 18117.59, "timestamp": "05:01:57", "text": "还行吧。是的，没问题。"}, {"type": "subtitle", "time": 18119.67, "timestamp": "05:01:59", "text": "把你的头埋进桶里"}]
[{"type": "subtitle", "time": 2763.349, "timestamp": "00:46:03", "text": "它肯定要切开，对吧？"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "是的。"}, {"type": "subtitle", "time": 2768.15, "timestamp": "00:46:08", "text": "哦，等等。"}, {"type": "subtitle", "time": 2770.309, "timestamp": "00:46:10", "text": "那确实有这么回事。我的天啊。那是一个"}, {"type": "subtitle", "time": 2772.76, "timestamp": "00:46:12", "text": "事物。是的。"}, {"type": "subtitle", "time": 2786.63, "timestamp": "00:46:26", "text": "这是什么？呃，"}, {"type": "subtitle", "time": 2793.99, "timestamp": "00:46:33", "text": "[音乐]"}, {"type": "subtitle", "time": 2796.74, "timestamp": "00:46:36", "text": "请问我可以要一个盘子吗？是的。感谢"}, {"type": "subtitle", "time": 2798.99, "timestamp": "00:46:38", "text": "[音乐]"}, {"type": "subtitle", "time": 2802.47, "timestamp": "00:46:42", "text": "你。我来拿刀。"}, {"type": "subtitle", "time": 2806.79, "timestamp": "00:46:46", "text": "[音乐]"}, {"type": "subtitle", "time": 2811.55, "timestamp": "00:46:51", "text": "你想要什么？我想要生菜和"}]
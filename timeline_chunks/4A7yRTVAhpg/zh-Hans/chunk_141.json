[{"type": "subtitle", "time": 8461.03, "timestamp": "02:21:01", "text": "最好的。但是，呃，我最喜欢的食物是……"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "比如说像意大利面之类的。我喜欢任何类型的"}, {"type": "subtitle", "time": 8469.03, "timestamp": "02:21:09", "text": "意大利面。面食。"}, {"type": "subtitle", "time": 8478.91, "timestamp": "02:21:18", "text": "是的。你怎么样"}, {"type": "subtitle", "time": 8481.27, "timestamp": "02:21:21", "text": "正在做？你呢？你有"}, {"type": "subtitle", "time": 8484.63, "timestamp": "02:21:24", "text": "最喜欢的食物？我吃你所有的东西"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "[笑声]"}, {"type": "subtitle", "time": 8494.89, "timestamp": "02:21:34", "text": "这种说法究竟有多真实？"}, {"type": "subtitle", "time": 8507.309, "timestamp": "02:21:47", "text": "真的赚了很多钱"}]
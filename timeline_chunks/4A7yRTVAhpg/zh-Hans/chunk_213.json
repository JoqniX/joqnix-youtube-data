[{"type": "subtitle", "time": 12781.19, "timestamp": "03:33:01", "text": "可以留着，我最后留一个。"}, {"type": "subtitle", "time": 12785.19, "timestamp": "03:33:05", "text": "可怕的恶魔。死。死。巴黎。死。他妈的"}, {"type": "subtitle", "time": 12788.03, "timestamp": "03:33:08", "text": "你。"}, {"type": "subtitle", "time": 12790.95, "timestamp": "03:33:10", "text": "欢迎。很高兴地说，我终于升级了我的"}, {"type": "subtitle", "time": 12793.469, "timestamp": "03:33:13", "text": "平静地。我们走吧。"}, {"type": "subtitle", "time": 12797.349, "timestamp": "03:33:17", "text": "我为你感到高兴。好了。结束"}, {"type": "subtitle", "time": 12799.349, "timestamp": "03:33:19", "text": "门。我永远不会下去。"}, {"type": "subtitle", "time": 12802.229, "timestamp": "03:33:22", "text": "再去见她。"}, {"type": "subtitle", "time": 12804.71, "timestamp": "03:33:24", "text": "她在外面吗？她在楼上。她是"}, {"type": "subtitle", "time": 12807.83, "timestamp": "03:33:27", "text": "楼上。楼上。"}, {"type": "subtitle", "time": 12809.269, "timestamp": "03:33:29", "text": "我得走了。好了，大家都到……"}, {"type": "subtitle", "time": 12811.269, "timestamp": "03:33:31", "text": "烧烤坑。"}, {"type": "subtitle", "time": 12812.87, "timestamp": "03:33:32", "text": "是的，我们要做饭。是"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "去做饭。不，我感觉不像是在"}, {"type": "subtitle", "time": 12818.15, "timestamp": "03:33:38", "text": "高的。对，做饭。我们走吧。耶。让我们"}, {"type": "subtitle", "time": 12820.229, "timestamp": "03:33:40", "text": "厨师。"}, {"type": "subtitle", "time": 12823.11, "timestamp": "03:33:43", "text": "嗯嗯。你喜欢怎么把金子扔进去？"}, {"type": "subtitle", "time": 12824.95, "timestamp": "03:33:44", "text": "烧烤那部分？只需按 E 键。"}, {"type": "subtitle", "time": 12827.19, "timestamp": "03:33:47", "text": "按 E 键。只需按 E 键。E。好的，酷。"}, {"type": "subtitle", "time": 12831.11, "timestamp": "03:33:51", "text": "现在去拿点东西。糟糕。哦，她是"}, {"type": "subtitle", "time": 12833.67, "timestamp": "03:33:53", "text": "准备过来。糟糕。去！去！去。"}, {"type": "subtitle", "time": 12835.03, "timestamp": "03:33:55", "text": "点亮它就好。点亮它。光"}]
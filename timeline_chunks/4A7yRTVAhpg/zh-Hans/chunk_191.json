[{"type": "subtitle", "time": 11462.95, "timestamp": "03:11:02", "text": "在那边。哦。哦，好辣。"}, {"type": "subtitle", "time": 11466.469, "timestamp": "03:11:06", "text": "哦，这里有把钥匙。谷。现实。得到"}, {"type": "subtitle", "time": 11470.469, "timestamp": "03:11:10", "text": "关键。哦，是那种高档货。是的。"}, {"type": "subtitle", "time": 11473.99, "timestamp": "03:11:13", "text": "蜡烛。你听到了吗？"}, {"type": "subtitle", "time": 11476.63, "timestamp": "03:11:16", "text": "什么？那是什么？那就像……"}, {"type": "subtitle", "time": 11477.79, "timestamp": "03:11:17", "text": "吱吱作响"}, {"type": "subtitle", "time": 11481.91, "timestamp": "03:11:21", "text": "噪音。这正常吗？嗯，只有我们俩。"}, {"type": "subtitle", "time": 11484.71, "timestamp": "03:11:24", "text": "就像四处走走一样。哦好的。哦，"}, {"type": "subtitle", "time": 11488.309, "timestamp": "03:11:28", "text": "亲爱的，主就在这里。哦，是的。"}, {"type": "subtitle", "time": 11491.59, "timestamp": "03:11:31", "text": "读一下。读一下。 10月17日。我可以"}, {"type": "subtitle", "time": 11495.11, "timestamp": "03:11:35", "text": "我脑海里回荡着阿齐尔的声音。感受他的"}, {"type": "subtitle", "time": 11497.67, "timestamp": "03:11:37", "text": "我血管里流淌着怒火。我觉得自己快要输了。"}, {"type": "subtitle", "time": 11500.63, "timestamp": "03:11:40", "text": "控制他。我不明白。"}, {"type": "subtitle", "time": 11502.79, "timestamp": "03:11:42", "text": "无法阻止这些奇怪的词语倾泻而出"}, {"type": "subtitle", "time": 11505.349, "timestamp": "03:11:45", "text": "从我口中说出这些话，就像我作为爪牙一样"}, {"type": "subtitle", "time": 11507.79, "timestamp": "03:11:47", "text": "我周围的一切都在崛起。"}, {"type": "subtitle", "time": 11511.19, "timestamp": "03:11:51", "text": "哦"}, {"type": "subtitle", "time": 11513.91, "timestamp": "03:11:53", "text": "我应该这样做吗？"}, {"type": "subtitle", "time": 11517.429, "timestamp": "03:11:57", "text": "是的，有一点点。好的。嗯，我是吗？"}]
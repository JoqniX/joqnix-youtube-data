[{"type": "subtitle", "time": 6782.669, "timestamp": "01:53:02", "text": "和"}, {"type": "subtitle", "time": 6788.47, "timestamp": "01:53:08", "text": "那我真想把我的冷桌子留在这儿。"}, {"type": "subtitle", "time": 6791.83, "timestamp": "01:53:11", "text": "房卡。房卡。练习模式。"}, {"type": "subtitle", "time": 6795.55, "timestamp": "01:53:15", "text": "激活卡片。节省。返回中。站立"}, {"type": "subtitle", "time": 6804.99, "timestamp": "01:53:24", "text": "机器并放置在机器上"}, {"type": "subtitle", "time": 6808.03, "timestamp": "01:53:28", "text": "泡茶。将水、茶包和"}, {"type": "subtitle", "time": 6810.39, "timestamp": "01:53:30", "text": "茶壶。然后放在柜台上。"}, {"type": "subtitle", "time": 6812.629, "timestamp": "01:53:32", "text": "陡。最多可搜索四位客户。给"}, {"type": "subtitle", "time": 6815.27, "timestamp": "01:53:35", "text": "每位顾客都有自己的杯子。好的，我们开始吧"}, {"type": "chat", "time": 6827.051, "timestamp": "01:53:47", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "hello you two"}]
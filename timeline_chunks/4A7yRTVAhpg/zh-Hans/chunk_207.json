[{"type": "subtitle", "time": 12423.19, "timestamp": "03:27:03", "text": "美好的。好了。汽油桶。给我一个"}, {"type": "subtitle", "time": 12425.75, "timestamp": "03:27:05", "text": "第二。让我接一发。"}, {"type": "subtitle", "time": 12427.99, "timestamp": "03:27:07", "text": "好的，没关系。"}, {"type": "subtitle", "time": 12430.55, "timestamp": "03:27:10", "text": "我需要一把枪。"}, {"type": "subtitle", "time": 12433.67, "timestamp": "03:27:13", "text": "玻璃。抓住这里，你就可以扔了"}, {"type": "subtitle", "time": 12435.03, "timestamp": "03:27:15", "text": "就在她面前。好的。你将会"}, {"type": "subtitle", "time": 12437.19, "timestamp": "03:27:17", "text": "美好的。"}, {"type": "subtitle", "time": 12440.51, "timestamp": "03:27:20", "text": "让我们来点儿……"}, {"type": "subtitle", "time": 12444.229, "timestamp": "03:27:24", "text": "震惊。刚跑过一只山羊去弄了"}, {"type": "subtitle", "time": 12446.229, "timestamp": "03:27:26", "text": "山羊。"}, {"type": "subtitle", "time": 12449.51, "timestamp": "03:27:29", "text": "好的，我正在做这件事。从山羊身上下来。"}, {"type": "subtitle", "time": 12452.309, "timestamp": "03:27:32", "text": "没关系。我们可以弄到食物，然后就出发了。"}, {"type": "subtitle", "time": 12461.79, "timestamp": "03:27:41", "text": "哦，是的。好的，就是这样。"}, {"type": "subtitle", "time": 12468.95, "timestamp": "03:27:48", "text": "过了这么久，安娜就……"}, {"type": "subtitle", "time": 12471.11, "timestamp": "03:27:51", "text": "但这会要了我们的命。"}, {"type": "subtitle", "time": 12472.87, "timestamp": "03:27:52", "text": "对，这就是全部的……事情。"}, {"type": "subtitle", "time": 12476.469, "timestamp": "03:27:56", "text": "关于游戏。你必须聪明。"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "我的天啊。"}]
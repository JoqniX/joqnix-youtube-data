[{"type": "subtitle", "time": 17582.948, "timestamp": "04:53:02", "text": "太薄了。你可能正在做一件事"}, {"type": "subtitle", "time": 17585.51, "timestamp": "04:53:05", "text": "又错过了一次。这通常是倾向于"}, {"type": "subtitle", "time": 17587.27, "timestamp": "04:53:07", "text": "将会发生。所以分散资源意味着"}, {"type": "subtitle", "time": 17589.75, "timestamp": "04:53:09", "text": "它带有负面含义，意思是"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "不要做太多事情。好的。所以"}, {"type": "subtitle", "time": 17594.788, "timestamp": "04:53:14", "text": "所以我才用“比如”而不是“"}, {"type": "subtitle", "time": 17598.15, "timestamp": "04:53:18", "text": "就像做 YouTube 一样，你真的非常喜欢"}, {"type": "subtitle", "time": 17600.868, "timestamp": "04:53:20", "text": "你玩Twitch，也玩Facebook，还喜欢"}, {"type": "subtitle", "time": 17603.11, "timestamp": "04:53:23", "text": "编辑视频。将会像这样"}, {"type": "subtitle", "time": 17605.948, "timestamp": "04:53:25", "text": "累死了。"}, {"type": "subtitle", "time": 17609.83, "timestamp": "04:53:29", "text": "是的。我内心深处很想尝试一下"}, {"type": "subtitle", "time": 17611.67, "timestamp": "04:53:31", "text": "夏季选角，但也是我自己的一部分"}, {"type": "subtitle", "time": 17615.83, "timestamp": "04:53:35", "text": "当时我就想，不行，兄弟，别这么做。片刻。"}, {"type": "subtitle", "time": 17618.23, "timestamp": "04:53:38", "text": "是的。别担心。我愿意这样做"}, {"type": "subtitle", "time": 17621.27, "timestamp": "04:53:41", "text": "我尽我所能去做任何事"}, {"type": "subtitle", "time": 17623.27, "timestamp": "04:53:43", "text": "可以像……一样，把它弄得像……"}, {"type": "subtitle", "time": 17626.31, "timestamp": "04:53:46", "text": "尽可能专业。"}, {"type": "subtitle", "time": 17629.35, "timestamp": "04:53:49", "text": "所以不用担心。比如，呃，给"}, {"type": "subtitle", "time": 17632.19, "timestamp": "04:53:52", "text": "不妨一试。尝试"}, {"type": "subtitle", "time": 17636.11, "timestamp": "04:53:56", "text": "它。所以你明白了。它是"}]
[{"type": "subtitle", "time": 14230.469, "timestamp": "03:57:10", "text": "那么，她现在在哪里呢？"}, {"type": "subtitle", "time": 14232.63, "timestamp": "03:57:12", "text": "哦，她会在这里闲逛。"}, {"type": "subtitle", "time": 14234.71, "timestamp": "03:57:14", "text": "哦，厕所里有个鸡蛋"}, {"type": "subtitle", "time": 14236.309, "timestamp": "03:57:16", "text": "楼上。"}, {"type": "subtitle", "time": 14238.309, "timestamp": "03:57:18", "text": "我们不能接受，因为每个人"}, {"type": "subtitle", "time": 14240.71, "timestamp": "03:57:20", "text": "里面有个鸡蛋。他们已经拥有一个"}, {"type": "subtitle", "time": 14242.07, "timestamp": "03:57:22", "text": "各位，我不会撒谎。我就像"}, {"type": "subtitle", "time": 14243.83, "timestamp": "03:57:23", "text": "有些人晕车晕得很厉害"}, {"type": "subtitle", "time": 14247.11, "timestamp": "03:57:27", "text": "原因。你想……你想停下来吗？"}, {"type": "subtitle", "time": 14248.71, "timestamp": "03:57:28", "text": "你可以这样做。我可能，我可能"}, {"type": "subtitle", "time": 14252.309, "timestamp": "03:57:32", "text": "到。坚持，稍等。"}, {"type": "subtitle", "time": 14255.07, "timestamp": "03:57:35", "text": "我很抱歉。我知道"}, {"type": "subtitle", "time": 14259.269, "timestamp": "03:57:39", "text": "我们不想谈。"}, {"type": "subtitle", "time": 14261.67, "timestamp": "03:57:41", "text": "我很抱歉。不，不，不。没关系。"}, {"type": "subtitle", "time": 14270.15, "timestamp": "03:57:50", "text": "好的。我的天哪。是的，我想，我想"}, {"type": "subtitle", "time": 14272.429, "timestamp": "03:57:52", "text": "就住这儿吧。这"}, {"type": "subtitle", "time": 14275.75, "timestamp": "03:57:55", "text": "我想去露营。扎瓦拉在哪里？"}, {"type": "subtitle", "time": 14279.429, "timestamp": "03:57:59", "text": "呃，我找不到我了，我会离开你的。"}]
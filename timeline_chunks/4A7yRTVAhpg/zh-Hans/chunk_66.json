[{"type": "subtitle", "time": 3962.589, "timestamp": "01:06:02", "text": "等等，等等，等等。让我来接受预订"}, {"type": "subtitle", "time": 3965.75, "timestamp": "01:06:05", "text": "桌子。为什么只有四人桌？"}, {"type": "subtitle", "time": 3969.43, "timestamp": "01:06:09", "text": "这完全说不通。"}, {"type": "subtitle", "time": 3973.67, "timestamp": "01:06:13", "text": "哦，最后一个了。"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "二。我们可以做四个。"}, {"type": "subtitle", "time": 3993.63, "timestamp": "01:06:33", "text": "思考。是的。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "是的。是的。是的。是的。是的。我想是的。"}, {"type": "subtitle", "time": 4002.589, "timestamp": "01:06:42", "text": "是的。然后我想我会把水槽放上去。"}, {"type": "subtitle", "time": 4005.47, "timestamp": "01:06:45", "text": "在这里您可以访问它"}, {"type": "subtitle", "time": 4009.19, "timestamp": "01:06:49", "text": "也。进而"}, {"type": "subtitle", "time": 4011.71, "timestamp": "01:06:51", "text": "呃，垃圾桶"}, {"type": "subtitle", "time": 4014.589, "timestamp": "01:06:54", "text": "这里。寻找"}, {"type": "subtitle", "time": 4019.029, "timestamp": "01:06:59", "text": "就是这里。不，是这个。我们需要"}]
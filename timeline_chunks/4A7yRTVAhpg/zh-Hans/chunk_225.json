[{"type": "subtitle", "time": 13500.55, "timestamp": "03:45:00", "text": "家庭经营的旅馆。 Zara 发现了一个巨人"}, {"type": "subtitle", "time": 13503.75, "timestamp": "03:45:03", "text": "筑巢的蜘蛛被视为污秽"}, {"type": "subtitle", "time": 13505.55, "timestamp": "03:45:05", "text": "血祭。"}, {"type": "subtitle", "time": 13507.83, "timestamp": "03:45:07", "text": "[音乐]"}, {"type": "subtitle", "time": 13511.11, "timestamp": "03:45:11", "text": "嗯？仪式出了差错，现在"}, {"type": "subtitle", "time": 13514.71, "timestamp": "03:45:14", "text": "阿兹尔已经占据了扎拉的身体和思想。"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "作为一名前邪教成员，以及其中之一"}, {"type": "subtitle", "time": 13524.87, "timestamp": "03:45:24", "text": "Zara的忠实朋友们，你们终于……"}, {"type": "subtitle", "time": 13528.309, "timestamp": "03:45:28", "text": "找到旅馆后，我去了那里。"}, {"type": "subtitle", "time": 13539.99, "timestamp": "03:45:39", "text": "几乎无论等待我的是什么。"}, {"type": "subtitle", "time": 13542.63, "timestamp": "03:45:42", "text": "所以我们是忠诚的。我们忠诚。哦，我的"}, {"type": "subtitle", "time": 13545.269, "timestamp": "03:45:45", "text": "上帝。我只看到我看到乔他妈的躺着"}, {"type": "subtitle", "time": 13547.269, "timestamp": "03:45:47", "text": "他。"}, {"type": "subtitle", "time": 13549.269, "timestamp": "03:45:49", "text": "等等，什么？"}, {"type": "subtitle", "time": 13551.67, "timestamp": "03:45:51", "text": "你你你加载完毕，然后进入过场动画"}, {"type": "subtitle", "time": 13554.309, "timestamp": "03:45:54", "text": "结束了。我们刚才看到了你的模型。"}, {"type": "subtitle", "time": 13555.99, "timestamp": "03:45:55", "text": "谢谢你送的球。让我来做这件事。"}]
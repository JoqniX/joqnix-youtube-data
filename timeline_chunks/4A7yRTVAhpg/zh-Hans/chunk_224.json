[{"type": "subtitle", "time": 13440.469, "timestamp": "03:44:00", "text": "因为我不想经历噩梦。但"}, {"type": "subtitle", "time": 13443.11, "timestamp": "03:44:03", "text": "不允许我，因为你知道"}, {"type": "subtitle", "time": 13445.51, "timestamp": "03:44:05", "text": "Fasmo，你真的会疯掉的。"}, {"type": "subtitle", "time": 13448.309, "timestamp": "03:44:08", "text": "如果你想。但很遗憾，你拥有"}, {"type": "subtitle", "time": 13450.71, "timestamp": "03:44:10", "text": "完成普通任务即可获得下一个任务"}, {"type": "subtitle", "time": 13453.269, "timestamp": "03:44:13", "text": "其中一个，我不知道，就是愚蠢。"}, {"type": "subtitle", "time": 13462.309, "timestamp": "03:44:22", "text": "好了，乔，你暂时安全了。是的，"}, {"type": "subtitle", "time": 13465.11, "timestamp": "03:44:25", "text": "你暂时安全了。是的，我很高兴。我是"}, {"type": "subtitle", "time": 13467.11, "timestamp": "03:44:27", "text": "高兴的。"}, {"type": "subtitle", "time": 13470.15, "timestamp": "03:44:30", "text": "你并不高兴。"}, {"type": "subtitle", "time": 13472.79, "timestamp": "03:44:32", "text": "你说我不高兴是什么意思？"}, {"type": "subtitle", "time": 13475.429, "timestamp": "03:44:35", "text": "如果我是，我会先死，而且我会"}, {"type": "subtitle", "time": 13477.59, "timestamp": "03:44:37", "text": "尖叫之类的。"}, {"type": "subtitle", "time": 13480.229, "timestamp": "03:44:40", "text": "没关系。没关系。哦，这是"}, {"type": "subtitle", "time": 13483.349, "timestamp": "03:44:43", "text": "温泉之类的东西。我的缩略图"}, {"type": "subtitle", "time": 13486.91, "timestamp": "03:44:46", "text": "记得她那个时代的邪教"}, {"type": "subtitle", "time": 13488.429, "timestamp": "03:44:48", "text": "观察者"}, {"type": "subtitle", "time": 13497.429, "timestamp": "03:44:57", "text": "隐藏在地下的洞穴里"}]
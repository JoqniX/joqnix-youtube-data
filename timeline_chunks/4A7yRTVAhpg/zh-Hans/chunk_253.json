[{"type": "subtitle", "time": 15180.429, "timestamp": "04:13:00", "text": "上帝。谁在乎？我要走了"}, {"type": "subtitle", "time": 15183.59, "timestamp": "04:13:03", "text": "尝试。是的。"}, {"type": "subtitle", "time": 15185.79, "timestamp": "04:13:05", "text": "有人拿走了我的霓虹灯"}, {"type": "subtitle", "time": 15189.269, "timestamp": "04:13:09", "text": "家。我的天啊。"}, {"type": "subtitle", "time": 15191.189, "timestamp": "04:13:11", "text": "我的天啊。你是最棒的霓虹灯。你是"}, {"type": "subtitle", "time": 15193.429, "timestamp": "04:13:13", "text": "最好的霓虹灯。你将永远是"}, {"type": "subtitle", "time": 15206.309, "timestamp": "04:13:26", "text": "哦，你现在要装死吗？"}, {"type": "subtitle", "time": 15209.149, "timestamp": "04:13:29", "text": "我照常收看天空电视台。"}, {"type": "subtitle", "time": 15213.63, "timestamp": "04:13:33", "text": "好的。我喜欢天空。这是"}, {"type": "subtitle", "time": 15217.51, "timestamp": "04:13:37", "text": "伟大的。真有趣。我稍后会找找。"}, {"type": "subtitle", "time": 15219.63, "timestamp": "04:13:39", "text": "我只会专注于直播。"}, {"type": "subtitle", "time": 15222.91, "timestamp": "04:13:42", "text": "好的。我会做我的"}, {"type": "subtitle", "time": 15225.55, "timestamp": "04:13:45", "text": "最好的。是的。"}, {"type": "subtitle", "time": 15228.229, "timestamp": "04:13:48", "text": "氖。不，我没有。我买不到霓虹灯。"}, {"type": "subtitle", "time": 15231.469, "timestamp": "04:13:51", "text": "一些随机的"}, {"type": "subtitle", "time": 15234.63, "timestamp": "04:13:54", "text": "有了霓虹灯。"}]
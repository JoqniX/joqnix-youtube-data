[{"type": "subtitle", "time": 10322.63, "timestamp": "02:52:02", "text": "蚊子和一切都很好"}, {"type": "subtitle", "time": 10325.23, "timestamp": "02:52:05", "text": "类似这样的东西"}, {"type": "subtitle", "time": 10328.55, "timestamp": "02:52:08", "text": "等等，那是什么？"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "比如说，假设你死了，然后……"}, {"type": "subtitle", "time": 10335.51, "timestamp": "02:52:15", "text": "去天堂什么的，嗯，终极目标"}, {"type": "subtitle", "time": 10337.99, "timestamp": "02:52:17", "text": "终极晋升工作，例如"}, {"type": "subtitle", "time": 10339.71, "timestamp": "02:52:19", "text": "精神"}, {"type": "subtitle", "time": 10343.87, "timestamp": "02:52:23", "text": "耶莎"}, {"type": "subtitle", "time": 10347.19, "timestamp": "02:52:27", "text": "哦，好的。这就是涅槃。好的。"}, {"type": "subtitle", "time": 10348.95, "timestamp": "02:52:28", "text": "明白了。"}, {"type": "subtitle", "time": 10353.269, "timestamp": "02:52:33", "text": "是的。它也像一个乐队。"}, {"type": "subtitle", "time": 10355.99, "timestamp": "02:52:35", "text": "哦，就是你点燃的那根棍子。"}, {"type": "subtitle", "time": 10368.63, "timestamp": "02:52:48", "text": "什么棍子？棍状物。你放光"}, {"type": "subtitle", "time": 10371.11, "timestamp": "02:52:51", "text": "那家伙就像个老烟民一样。它"}, {"type": "subtitle", "time": 10374.07, "timestamp": "02:52:54", "text": "东西摆放整齐。那个呃"}, {"type": "subtitle", "time": 10376.63, "timestamp": "02:52:56", "text": "你把它放在那里是为了防蚊子，但并没有。"}]
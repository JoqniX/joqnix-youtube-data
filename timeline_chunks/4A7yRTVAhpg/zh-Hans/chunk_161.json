[{"type": "subtitle", "time": 9660.469, "timestamp": "02:41:00", "text": "[音乐]"}, {"type": "subtitle", "time": 9677.59, "timestamp": "02:41:17", "text": "好的，我去拿番茄。哦，绝不"}, {"type": "subtitle", "time": 9702.38, "timestamp": "02:41:42", "text": "他们可以排队等候。哦。哦。问："}, {"type": "subtitle", "time": 9713.349, "timestamp": "02:41:53", "text": "问：等等。你能把披萨拿出来吗？"}, {"type": "subtitle", "time": 9719.99, "timestamp": "02:41:59", "text": "我的天啊。混乱。"}]
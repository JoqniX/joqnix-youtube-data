[{"type": "subtitle", "time": 17880.31, "timestamp": "04:58:00", "text": "兽。我感觉自己也像个傻瓜一样。"}, {"type": "subtitle", "time": 17881.47, "timestamp": "04:58:01", "text": "好奇"}, {"type": "subtitle", "time": 17885.67, "timestamp": "04:58:05", "text": "她怎么可能不困呢？"}, {"type": "subtitle", "time": 17888.07, "timestamp": "04:58:08", "text": "我觉得她就像是把自己冲进马桶里一样。"}, {"type": "subtitle", "time": 17890.15, "timestamp": "04:58:10", "text": "就像她喜欢早睡早起一样，你"}, {"type": "subtitle", "time": 17892.47, "timestamp": "04:58:12", "text": "我知道那样，啊，也许就是这样。"}, {"type": "subtitle", "time": 17894.19, "timestamp": "04:58:14", "text": "是的。"}, {"type": "subtitle", "time": 17900.75, "timestamp": "04:58:20", "text": "和她在一起，但不幸的是我睡着了。"}, {"type": "subtitle", "time": 17904.55, "timestamp": "04:58:24", "text": "我错过了两次。我觉得你"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "好像也是来叫醒我的。"}, {"type": "subtitle", "time": 17910.708, "timestamp": "04:58:30", "text": "我记得这件事。是的。是的。是的。"}, {"type": "subtitle", "time": 17913.03, "timestamp": "04:58:33", "text": "我说，事情就是这样发生的。"}, {"type": "subtitle", "time": 17915.43, "timestamp": "04:58:35", "text": "是的。之后她就说“嗯”。那是"}, {"type": "subtitle", "time": 17917.27, "timestamp": "04:58:37", "text": "它。我觉得行不通，因为我"}, {"type": "subtitle", "time": 17923.43, "timestamp": "04:58:43", "text": "我还是觉得很难过。我仍然感到难过"}, {"type": "subtitle", "time": 17928.55, "timestamp": "04:58:48", "text": "这些可以被视为一种"}, {"type": "subtitle", "time": 17930.11, "timestamp": "04:58:50", "text": "经验。"}, {"type": "subtitle", "time": 17933.75, "timestamp": "04:58:53", "text": "不，事情就是这样发生了。你确实有事要做"}, {"type": "subtitle", "time": 17935.35, "timestamp": "04:58:55", "text": "你最好不要让这种情况再次发生"}, {"type": "subtitle", "time": 17938.51, "timestamp": "04:58:58", "text": "或者类似的事情。"}]
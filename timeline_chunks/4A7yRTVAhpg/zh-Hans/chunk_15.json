[{"type": "subtitle", "time": 901.509, "timestamp": "00:15:01", "text": "等待。哦，这是不同的钥匙。"}, {"type": "subtitle", "time": 909.11, "timestamp": "00:15:09", "text": "哦，这将会是这样的，这将会是这样的"}, {"type": "subtitle", "time": 921.11, "timestamp": "00:15:21", "text": "哦，你可以简单地说……"}, {"type": "subtitle", "time": 924.23, "timestamp": "00:15:24", "text": "那里。哦，是的。真奇怪。游戏"}, {"type": "subtitle", "time": 926.79, "timestamp": "00:15:26", "text": "机械原理很奇怪。"}, {"type": "subtitle", "time": 936.67, "timestamp": "00:15:36", "text": "嗨，茉莉，谢谢你"}, {"type": "subtitle", "time": 940.31, "timestamp": "00:15:40", "text": "下列的。你好吗？"}, {"type": "subtitle", "time": 943.11, "timestamp": "00:15:43", "text": "茉莉花。糟了，他想吃鱼。他想要"}, {"type": "subtitle", "time": 944.71, "timestamp": "00:15:44", "text": "鱼。"}, {"type": "subtitle", "time": 948.189, "timestamp": "00:15:48", "text": "哇，他居然有定时器！"}, {"type": "subtitle", "time": 953.23, "timestamp": "00:15:53", "text": "东西。不，他要走了。"}]
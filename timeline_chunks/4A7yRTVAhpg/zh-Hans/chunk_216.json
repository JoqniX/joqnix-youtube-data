[{"type": "subtitle", "time": 12961.51, "timestamp": "03:36:01", "text": "可怕的。是的，就像这样，做"}, {"type": "subtitle", "time": 12963.03, "timestamp": "03:36:03", "text": "你还记得吗？说真的，即使"}, {"type": "subtitle", "time": 12964.95, "timestamp": "03:36:04", "text": "恐鬼症比这更可怕"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "就连法斯玛·法斯玛也没那么可怕。"}, {"type": "subtitle", "time": 12975.19, "timestamp": "03:36:15", "text": "就像我们玩《Devo》和《Valerant》一样，"}, {"type": "subtitle", "time": 12976.79, "timestamp": "03:36:16", "text": "但感觉我们好像不得不到处搬家。"}, {"type": "subtitle", "time": 12979.349, "timestamp": "03:36:19", "text": "时间。是的，我们带着垃圾而来"}, {"type": "subtitle", "time": 12980.87, "timestamp": "03:36:20", "text": "还有屎。"}, {"type": "subtitle", "time": 12984.95, "timestamp": "03:36:24", "text": "对，我们就像一群人到处乱跑。"}, {"type": "subtitle", "time": 12987.19, "timestamp": "03:36:27", "text": "虽然有很多孩子，但在Fasmo你真的可以"}, {"type": "subtitle", "time": 12989.99, "timestamp": "03:36:29", "text": "寒意。是啊，你可以放松一下。你可以"}, {"type": "subtitle", "time": 12993.349, "timestamp": "03:36:33", "text": "讲话。你可以尽情胡闹，"}, {"type": "subtitle", "time": 12999.19, "timestamp": "03:36:39", "text": "知道，因为如果你想的话，我的天哪，"}, {"type": "subtitle", "time": 13000.11, "timestamp": "03:36:40", "text": "我的"}, {"type": "subtitle", "time": 13003.59, "timestamp": "03:36:43", "text": "互联网。怎么了？哦，不。"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "好了，我的直播正在进行中，你们"}, {"type": "subtitle", "time": 13009.03, "timestamp": "03:36:49", "text": "能听到我说话吗？"}, {"type": "subtitle", "time": 13010.469, "timestamp": "03:36:50", "text": "是的。"}, {"type": "subtitle", "time": 13019.429, "timestamp": "03:36:59", "text": "好的。好的。我想，呃，我会的。"}]
[{"type": "subtitle", "time": 1623.35, "timestamp": "00:27:03", "text": "这。一天结束了。耶。"}, {"type": "subtitle", "time": 1632.39, "timestamp": "00:27:12", "text": "哦，结束了。哦，"}, {"type": "subtitle", "time": 1635.59, "timestamp": "00:27:15", "text": "是的。很快就结束了。"}, {"type": "subtitle", "time": 1637.47, "timestamp": "00:27:17", "text": "很快。请不要哭。"}, {"type": "subtitle", "time": 1639.71, "timestamp": "00:27:19", "text": "一切。特雷"}, {"type": "subtitle", "time": 1643.029, "timestamp": "00:27:23", "text": "站立。呃"}, {"type": "subtitle", "time": 1645.19, "timestamp": "00:27:25", "text": "下沉。下沉。"}, {"type": "subtitle", "time": 1654.269, "timestamp": "00:27:34", "text": "呃，我们需要买这个吗？"}, {"type": "subtitle", "time": 1658.93, "timestamp": "00:27:38", "text": "是的，这会很好。"}, {"type": "subtitle", "time": 1660.63, "timestamp": "00:27:40", "text": "[音乐]"}, {"type": "subtitle", "time": 1663.11, "timestamp": "00:27:43", "text": "这个应该放在哪里？给它充电。我得到了"}, {"type": "subtitle", "time": 1666.149, "timestamp": "00:27:46", "text": "一。我得到了一个。我们找到一个了。好的。"}, {"type": "subtitle", "time": 1669.909, "timestamp": "00:27:49", "text": "我们能否或者应该取消这个提议？"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "嗯，我们难道不需要一个类似支架的东西吗？"}, {"type": "subtitle", "time": 1677.029, "timestamp": "00:27:57", "text": "那玩意儿？"}]
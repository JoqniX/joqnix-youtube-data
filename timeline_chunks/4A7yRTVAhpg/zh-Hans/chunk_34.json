[{"type": "subtitle", "time": 2041.51, "timestamp": "00:34:01", "text": "他们想要蘑菇，我会把蘑菇切碎。"}, {"type": "subtitle", "time": 2047.509, "timestamp": "00:34:07", "text": "蘑菇。等等，这不对"}, {"type": "subtitle", "time": 2050.51, "timestamp": "00:34:10", "text": "尽管。这个不是"}, {"type": "subtitle", "time": 2079.589, "timestamp": "00:34:39", "text": "稀有的。等待。不，不，不，不。我们需要井"}, {"type": "subtitle", "time": 2081.589, "timestamp": "00:34:41", "text": "完毕。呃，不。拿着。拿着。"}, {"type": "subtitle", "time": 2090.389, "timestamp": "00:34:50", "text": "等待。我"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "不，不，不，不，不，不。"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "你好，宝贝。欢迎光临。谢谢。"}]
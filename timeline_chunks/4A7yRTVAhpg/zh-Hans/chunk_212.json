[{"type": "subtitle", "time": 12720.389, "timestamp": "03:32:00", "text": "我们现在就可以把那一个烧掉。"}, {"type": "subtitle", "time": 12722.389, "timestamp": "03:32:02", "text": "现在就下一张。但不要烧毁"}, {"type": "subtitle", "time": 12725.269, "timestamp": "03:32:05", "text": "它。放下就行，别烧了。"}, {"type": "subtitle", "time": 12727.269, "timestamp": "03:32:07", "text": "在烧烤中"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "坑。"}, {"type": "subtitle", "time": 12731.67, "timestamp": "03:32:11", "text": "哦，去吧，你可以养只山羊。我"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "我好像在这边看到了一只山羊。我会得到"}, {"type": "subtitle", "time": 12735.67, "timestamp": "03:32:15", "text": "我去弄只山羊来。我去弄只山羊来。"}, {"type": "subtitle", "time": 12741.03, "timestamp": "03:32:21", "text": "[掌声]"}, {"type": "subtitle", "time": 12749.99, "timestamp": "03:32:29", "text": "是的。"}, {"type": "subtitle", "time": 12753.03, "timestamp": "03:32:33", "text": "[音乐]"}, {"type": "subtitle", "time": 12755.83, "timestamp": "03:32:35", "text": "相信我。相信我，各位。相信我。我"}, {"type": "subtitle", "time": 12767.11, "timestamp": "03:32:47", "text": "哦，我这里有一些上好的干草给你。"}, {"type": "subtitle", "time": 12768.71, "timestamp": "03:32:48", "text": "外面好像有很多山羊。"}, {"type": "subtitle", "time": 12772.229, "timestamp": "03:32:52", "text": "尽管。外部。是的，他们就像"}, {"type": "subtitle", "time": 12774.389, "timestamp": "03:32:54", "text": "像个傻瓜一样到处乱跑。一群"}, {"type": "subtitle", "time": 12775.99, "timestamp": "03:32:55", "text": "事物。那么，让我们把所有的……"}, {"type": "subtitle", "time": 12778.07, "timestamp": "03:32:58", "text": "房子里有鬼魂，然后我们"}]
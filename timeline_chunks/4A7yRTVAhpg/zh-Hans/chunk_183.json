[{"type": "subtitle", "time": 10982.23, "timestamp": "03:03:02", "text": "我的天啊。我之前不知道这件事。"}, {"type": "subtitle", "time": 10996.71, "timestamp": "03:03:16", "text": "好的。呃，游戏音效就是全部内容吗？"}, {"type": "subtitle", "time": 10998.79, "timestamp": "03:03:18", "text": "查德，我们到底在感受谁？哪一个"}, {"type": "subtitle", "time": 11001.51, "timestamp": "03:03:21", "text": "你希望我成为那样的人吗？"}, {"type": "subtitle", "time": 11004.269, "timestamp": "03:03:24", "text": "我们还有一秒钟。"}, {"type": "subtitle", "time": 11006.23, "timestamp": "03:03:26", "text": "耶。"}, {"type": "subtitle", "time": 11008.23, "timestamp": "03:03:28", "text": "哦，我得去拿我的零食了。"}, {"type": "subtitle", "time": 11011.51, "timestamp": "03:03:31", "text": "一切准备就绪。弗兰克为什么看起来"}, {"type": "subtitle", "time": 11015.59, "timestamp": "03:03:35", "text": "像这样吗？他为什么长成那样？"}, {"type": "subtitle", "time": 11018.55, "timestamp": "03:03:38", "text": "你必须选择一项特权。他看起来好漂亮"}, {"type": "subtitle", "time": 11020.15, "timestamp": "03:03:40", "text": "腻。"}, {"type": "subtitle", "time": 11029.19, "timestamp": "03:03:49", "text": "rev 电池。侧翼是谁？他像"}, {"type": "subtitle", "time": 11030.55, "timestamp": "03:03:50", "text": "我不认为他年纪大了。"}, {"type": "subtitle", "time": 11032.55, "timestamp": "03:03:52", "text": "特点。他是个新角色，对吧？"}, {"type": "subtitle", "time": 11034.63, "timestamp": "03:03:54", "text": "不，我认为这是一个新角色。"}, {"type": "subtitle", "time": 11036.55, "timestamp": "03:03:56", "text": "实际上。是啊，我从没见过。"}, {"type": "subtitle", "time": 11039.91, "timestamp": "03:03:59", "text": "前。是啊，我从没见过放屁。"}]
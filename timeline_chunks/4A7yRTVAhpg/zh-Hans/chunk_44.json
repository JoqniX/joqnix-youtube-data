[{"type": "subtitle", "time": 2642.349, "timestamp": "00:44:02", "text": "不。"}, {"type": "subtitle", "time": 2649.75, "timestamp": "00:44:09", "text": "我们能得到什么？"}, {"type": "subtitle", "time": 2656.069, "timestamp": "00:44:16", "text": "可升级车牌。我们可以升级我们的"}, {"type": "subtitle", "time": 2658.55, "timestamp": "00:44:18", "text": "盘子？是的。是的。是的。我们应该"}, {"type": "subtitle", "time": 2660.47, "timestamp": "00:44:20", "text": "升级车牌。等等，多少钱？多少钱？"}, {"type": "subtitle", "time": 2663.39, "timestamp": "00:44:23", "text": "研究是灰尘吗？哦，研究台是"}, {"type": "subtitle", "time": 2667.109, "timestamp": "00:44:27", "text": "昂贵的。好吧，没事了。"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "我认为我们应该升级一下柜台。"}, {"type": "subtitle", "time": 2672.87, "timestamp": "00:44:32", "text": "现在速度更快了。"}, {"type": "subtitle", "time": 2675.349, "timestamp": "00:44:35", "text": "但反击能力提升并不明显。"}, {"type": "chat", "time": 2675.709, "timestamp": "00:44:35", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Did u finally got your cooker??"}, {"type": "subtitle", "time": 2678.309, "timestamp": "00:44:38", "text": "尽管。反制升级的作用是什么？"}, {"type": "subtitle", "time": 2681.43, "timestamp": "00:44:41", "text": "尽管？它只会像“哦”一样越陷越深。"}, {"type": "subtitle", "time": 2684.95, "timestamp": "00:44:44", "text": "你可以切得更快之类的"}, {"type": "subtitle", "time": 2687.75, "timestamp": "00:44:47", "text": "真是太烦人了。它不会这样做"}, {"type": "subtitle", "time": 2690.63, "timestamp": "00:44:50", "text": "很多东西。"}, {"type": "subtitle", "time": 2693.109, "timestamp": "00:44:53", "text": "你的炉灶终于到货了吗？此致"}, {"type": "subtitle", "time": 2697.71, "timestamp": "00:44:57", "text": "是WhatsApp cookies。重点。你好，阿斯特拉"}]
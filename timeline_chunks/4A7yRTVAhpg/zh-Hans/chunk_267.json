[{"type": "subtitle", "time": 16020.149, "timestamp": "04:27:00", "text": "手。"}, {"type": "subtitle", "time": 16023.349, "timestamp": "04:27:03", "text": "我的天啊。终于，我击杀了一个人。"}, {"type": "subtitle", "time": 16026.229, "timestamp": "04:27:06", "text": "我们走吧。"}, {"type": "subtitle", "time": 16028.63, "timestamp": "04:27:08", "text": "重新装弹。我真的不喜欢狙击手"}, {"type": "subtitle", "time": 16031.349, "timestamp": "04:27:11", "text": "在这场游戏中，伙计。我以为我们只是"}, {"type": "subtitle", "time": 16038.99, "timestamp": "04:27:18", "text": "去你的。"}, {"type": "subtitle", "time": 16041.389, "timestamp": "04:27:21", "text": "啊，我"}, {"type": "subtitle", "time": 16051.59, "timestamp": "04:27:31", "text": "我以为我会喜欢像我这样的人"}]
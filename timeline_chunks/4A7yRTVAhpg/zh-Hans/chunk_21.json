[{"type": "subtitle", "time": 1260.909, "timestamp": "00:21:00", "text": "等等，我要走了"}, {"type": "subtitle", "time": 1264.669, "timestamp": "00:21:04", "text": "关闭其中一个。关闭"}, {"type": "subtitle", "time": 1268.549, "timestamp": "00:21:08", "text": "一。我们可以开始了。我们你可以我"}, {"type": "subtitle", "time": 1269.99, "timestamp": "00:21:09", "text": "我不知道你的钥匙是什么，但是如果你"}, {"type": "subtitle", "time": 1277.27, "timestamp": "00:21:17", "text": "我们要运行一个“等等，这是什么？”"}, {"type": "subtitle", "time": 1278.75, "timestamp": "00:21:18", "text": "再次？这"}, {"type": "subtitle", "time": 1282.39, "timestamp": "00:21:22", "text": "餐馆。我的天啊。第一个人来了。"}, {"type": "subtitle", "time": 1294.549, "timestamp": "00:21:34", "text": "我什么都按不了。哦，是T。"}, {"type": "subtitle", "time": 1303.63, "timestamp": "00:21:43", "text": "微。我的天啊。"}, {"type": "subtitle", "time": 1306.63, "timestamp": "00:21:46", "text": "凌乱的。他们可能不希望它稀有。"}, {"type": "subtitle", "time": 1311.11, "timestamp": "00:21:51", "text": "有时。所以要煮至三分熟。"}, {"type": "subtitle", "time": 1313.669, "timestamp": "00:21:53", "text": "会证明一切。这就像中等水平"}, {"type": "chat", "time": 1316.849, "timestamp": "00:21:56", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "this looks like overcooked"}, {"type": "subtitle", "time": 1317.83, "timestamp": "00:21:57", "text": "稀有的。所以这个你可以做更多菜。"}]
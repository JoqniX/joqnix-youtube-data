[{"type": "subtitle", "time": 14641.75, "timestamp": "04:04:01", "text": "我觉得可能是因为……"}, {"type": "subtitle", "time": 14643.91, "timestamp": "04:04:03", "text": "太迟了。"}, {"type": "subtitle", "time": 14646.95, "timestamp": "04:04:06", "text": "是啊，现在已经很晚了。这就是为什么它是"}, {"type": "subtitle", "time": 14649.469, "timestamp": "04:04:09", "text": "有点疼。是的。"}, {"type": "subtitle", "time": 14654.07, "timestamp": "04:04:14", "text": "你好。你好。我结束了直播。患病的"}, {"type": "subtitle", "time": 14658.469, "timestamp": "04:04:18", "text": "我不会只是在这里为你们加油。"}, {"type": "subtitle", "time": 14662.229, "timestamp": "04:04:22", "text": "你好。是的，没问题。你们看不到我们"}, {"type": "subtitle", "time": 14665.79, "timestamp": "04:04:25", "text": "比如游戏玩得很烂。哦，不，不"}, {"type": "subtitle", "time": 14670.95, "timestamp": "04:04:30", "text": "不。你会很棒的。相信我。是的。"}, {"type": "subtitle", "time": 14674.07, "timestamp": "04:04:34", "text": "肯定会非常搞笑。"}, {"type": "subtitle", "time": 14675.91, "timestamp": "04:04:35", "text": "你一定会很出色。相信"}, {"type": "subtitle", "time": 14679.75, "timestamp": "04:04:39", "text": "你自己。好的。首先，先生。"}, {"type": "subtitle", "time": 14683.59, "timestamp": "04:04:43", "text": "Jacnix，你能别再躲躲藏藏了吗？"}, {"type": "subtitle", "time": 14691.189, "timestamp": "04:04:51", "text": "你是怎么知道的？你是怎么知道的？如何"}, {"type": "subtitle", "time": 14693.99, "timestamp": "04:04:53", "text": "你知道我是残疾人吗？"}, {"type": "subtitle", "time": 14697.03, "timestamp": "04:04:57", "text": "当然你会这么做。"}]
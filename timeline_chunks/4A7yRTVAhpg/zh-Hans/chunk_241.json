[{"type": "subtitle", "time": 14460.71, "timestamp": "04:01:00", "text": "如果你们想这么做的话，嗯，没问题。我"}, {"type": "subtitle", "time": 14462.309, "timestamp": "04:01:02", "text": "可以结束我的。我会到那儿的。"}, {"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "我会看你们的直播。"}, {"type": "subtitle", "time": 14466.469, "timestamp": "04:01:06", "text": "好的。杰克先生，您想做什么？"}, {"type": "subtitle", "time": 14470.91, "timestamp": "04:01:10", "text": "玩？你想和迪瓦瓦一起玩吗？"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "像迪瓦那样？不，我不想玩。"}, {"type": "subtitle", "time": 14477.189, "timestamp": "04:01:17", "text": "迪瓦现在"}, {"type": "subtitle", "time": 14479.03, "timestamp": "04:01:19", "text": "因为真的就像那个人一样"}, {"type": "subtitle", "time": 14482.07, "timestamp": "04:01:22", "text": "参与这场游戏的人都身处其中。"}, {"type": "subtitle", "time": 14484.63, "timestamp": "04:01:24", "text": "所以没有她，就像我们俩一样"}, {"type": "subtitle", "time": 14487.269, "timestamp": "04:01:27", "text": "可能就像会直接拿走一样"}, {"type": "subtitle", "time": 14490.63, "timestamp": "04:01:30", "text": "命中。直接挨了一记重拳。"}, {"type": "subtitle", "time": 14492.03, "timestamp": "04:01:32", "text": "牙齿。是的。"}, {"type": "subtitle", "time": 14493.269, "timestamp": "04:01:33", "text": "[音乐]"}, {"type": "subtitle", "time": 14496.79, "timestamp": "04:01:36", "text": "好的。你知道吗？"}, {"type": "subtitle", "time": 14499.189, "timestamp": "04:01:39", "text": "什么是二维？"}, {"type": "subtitle", "time": 14502.429, "timestamp": "04:01:42", "text": "我不知道。我没有更新原神。"}, {"type": "subtitle", "time": 14505.269, "timestamp": "04:01:45", "text": "你好。你呢？这不是第一人称射击游戏。"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "尽管。呃，是哪个游戏？什么？原神。"}, {"type": "subtitle", "time": 14510.63, "timestamp": "04:01:50", "text": "原神。呃，就像我说的，你们"}, {"type": "subtitle", "time": 14513.51, "timestamp": "04:01:53", "text": "因为我使用的是欧洲服务器，所以只能在线观看。所以，"}, {"type": "subtitle", "time": 14517.03, "timestamp": "04:01:57", "text": "我有……嗯，是的，但是这份工作是……"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "问题。我确实有一个欧洲。我从未"}]
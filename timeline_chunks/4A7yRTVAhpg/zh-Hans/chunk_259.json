[{"type": "subtitle", "time": 15540.63, "timestamp": "04:19:00", "text": "是的。是的。然后你就会得到"}, {"type": "subtitle", "time": 15543.67, "timestamp": "04:19:03", "text": "一张王牌。你会拿到一张王牌。现在"}, {"type": "subtitle", "time": 15545.83, "timestamp": "04:19:05", "text": "我好无聊。我在炫耀。我认为。我"}, {"type": "subtitle", "time": 15548.389, "timestamp": "04:19:08", "text": "不知道。不，不。信任，信任，信任。"}, {"type": "subtitle", "time": 15550.07, "timestamp": "04:19:10", "text": "相信，"}, {"type": "subtitle", "time": 15557.99, "timestamp": "04:19:17", "text": "呃，我只能说一件事。你不"}, {"type": "subtitle", "time": 15565.189, "timestamp": "04:19:25", "text": "哦，真是吓死我了。你是对的。"}, {"type": "subtitle", "time": 15581.03, "timestamp": "04:19:41", "text": "好的。"}, {"type": "subtitle", "time": 15588.389, "timestamp": "04:19:48", "text": "试过了。但你知道，你知道是谁"}, {"type": "subtitle", "time": 15590.309, "timestamp": "04:19:50", "text": "一个更好的霓虹灯设计师，本来可以得到那个"}, {"type": "subtitle", "time": 15591.71, "timestamp": "04:19:51", "text": "杀？"}, {"type": "subtitle", "time": 15597.429, "timestamp": "04:19:57", "text": "乔我。是的，就是你。我的天啊。"}, {"type": "subtitle", "time": 15598.95, "timestamp": "04:19:58", "text": "希腊语。"}]
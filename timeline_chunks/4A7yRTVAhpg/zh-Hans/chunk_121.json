[{"type": "subtitle", "time": 7261.83, "timestamp": "02:01:01", "text": "我觉得我们搞砸了。我搞砸了。我"}, {"type": "subtitle", "time": 7270.12, "timestamp": "02:01:10", "text": "事情发生了。"}, {"type": "subtitle", "time": 7275.39, "timestamp": "02:01:15", "text": "[音乐]"}, {"type": "subtitle", "time": 7278.24, "timestamp": "02:01:18", "text": "从来都不喜欢"}, {"type": "subtitle", "time": 7288.589, "timestamp": "02:01:28", "text": "[音乐]"}, {"type": "subtitle", "time": 7291.669, "timestamp": "02:01:31", "text": "邦科。哦，公鸡。哦，那里有一个"}, {"type": "subtitle", "time": 7294.41, "timestamp": "02:01:34", "text": "公鸡。"}, {"type": "subtitle", "time": 7296.709, "timestamp": "02:01:36", "text": "[音乐]"}, {"type": "subtitle", "time": 7301.189, "timestamp": "02:01:41", "text": "它会重新启动3天。所以，我们一切都好。"}, {"type": "subtitle", "time": 7303.669, "timestamp": "02:01:43", "text": "好的。现在，先试着做一下这个食谱。"}, {"type": "subtitle", "time": 7306.47, "timestamp": "02:01:46", "text": "瞧。好的，我们开始教程吧。"}, {"type": "subtitle", "time": 7310.109, "timestamp": "02:01:50", "text": "第一的。而不是像拥有"}, {"type": "subtitle", "time": 7312.95, "timestamp": "02:01:52", "text": "是的，我们需要这个放在里面。"}, {"type": "subtitle", "time": 7314.21, "timestamp": "02:01:54", "text": "外部。"}, {"type": "subtitle", "time": 7316.91, "timestamp": "02:01:56", "text": "[音乐]"}]
[{"type": "subtitle", "time": 1386.549, "timestamp": "00:23:06", "text": "我的天啊。没时间了。没时间了。我知道。我"}, {"type": "subtitle", "time": 1388.27, "timestamp": "00:23:08", "text": "知道。拿"}, {"type": "subtitle", "time": 1391.71, "timestamp": "00:23:11", "text": "那。我们需要两个"}, {"type": "subtitle", "time": 1394.99, "timestamp": "00:23:14", "text": "稀有品种。吃我一拳。一"}, {"type": "subtitle", "time": 1396.59, "timestamp": "00:23:16", "text": "[音乐]"}, {"type": "subtitle", "time": 1400.35, "timestamp": "00:23:20", "text": "更多的。你好，龙们。"}, {"type": "subtitle", "time": 1402.75, "timestamp": "00:23:22", "text": "就像"}, {"type": "subtitle", "time": 1414.39, "timestamp": "00:23:34", "text": "是的。选错了。选错了。拉屎。"}, {"type": "subtitle", "time": 1417.39, "timestamp": "00:23:37", "text": "哦，我们完成了。我们开始吧"}, {"type": "subtitle", "time": 1420.789, "timestamp": "00:23:40", "text": "去。上方有一个计时器，它显示"}, {"type": "subtitle", "time": 1424.99, "timestamp": "00:23:44", "text": "就像一整天一样。所以，就是这样"}, {"type": "subtitle", "time": 1429.149, "timestamp": "00:23:49", "text": "恼人的。哦，进屋吧。进入"}, {"type": "subtitle", "time": 1432.11, "timestamp": "00:23:52", "text": "房间。我们做了什么"}, {"type": "subtitle", "time": 1433.71, "timestamp": "00:23:53", "text": "得到？"}, {"type": "subtitle", "time": 1436.07, "timestamp": "00:23:56", "text": "盘子。哦，是的。小盘子是"}, {"type": "subtitle", "time": 1438.47, "timestamp": "00:23:58", "text": "通常不错。餐桌。我会保留"}, {"type": "subtitle", "time": 1439.87, "timestamp": "00:23:59", "text": "东西"}]
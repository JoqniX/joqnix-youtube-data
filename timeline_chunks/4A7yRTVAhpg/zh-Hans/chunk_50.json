[{"type": "subtitle", "time": 3004.829, "timestamp": "00:50:04", "text": "下沉。我们是否应该进行当日升级"}, {"type": "subtitle", "time": 3009.27, "timestamp": "00:50:09", "text": "我们的桌子？是的，我们应该沉没。下沉。"}, {"type": "subtitle", "time": 3012.39, "timestamp": "00:50:12", "text": "是啊，沉没了。下沉。是的。"}, {"type": "subtitle", "time": 3015.349, "timestamp": "00:50:15", "text": "所以，等等。这不是洗碗机。"}, {"type": "subtitle", "time": 3018.19, "timestamp": "00:50:18", "text": "它不是。它只是个水槽。"}, {"type": "subtitle", "time": 3022.99, "timestamp": "00:50:22", "text": "啊，等等。我们可以开始我们的"}, {"type": "subtitle", "time": 3027.99, "timestamp": "00:50:27", "text": "天。没有。你得到了什么？"}, {"type": "subtitle", "time": 3030.99, "timestamp": "00:50:30", "text": "我们得先开始。"}, {"type": "subtitle", "time": 3039.069, "timestamp": "00:50:39", "text": "我想是洗碗机。盘子。盘子。"}, {"type": "subtitle", "time": 3041.91, "timestamp": "00:50:41", "text": "洗碗机。洗碗机。"}, {"type": "subtitle", "time": 3043.86, "timestamp": "00:50:43", "text": "耶。"}, {"type": "subtitle", "time": 3046.589, "timestamp": "00:50:46", "text": "[音乐]"}, {"type": "subtitle", "time": 3059.97, "timestamp": "00:50:59", "text": "后来我的"}]
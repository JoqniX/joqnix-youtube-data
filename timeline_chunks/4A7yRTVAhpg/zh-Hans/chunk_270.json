[{"type": "subtitle", "time": 16204.229, "timestamp": "04:30:04", "text": "哦真的吗？他拿到了特制手榴弹。"}, {"type": "subtitle", "time": 16213.91, "timestamp": "04:30:13", "text": "重新装弹。"}, {"type": "subtitle", "time": 16245.55, "timestamp": "04:30:45", "text": "我怎么会……我的天哪，那"}, {"type": "subtitle", "time": 16249.269, "timestamp": "04:30:49", "text": "有点卡顿。"}, {"type": "subtitle", "time": 16251.83, "timestamp": "04:30:51", "text": "兄弟，他们在搞黑客攻击。他们在进行黑客攻击。"}, {"type": "subtitle", "time": 16255.349, "timestamp": "04:30:55", "text": "啊，他们已经"}, {"type": "subtitle", "time": 16257.59, "timestamp": "04:30:57", "text": "我的天哪。我是最后一个被杀的。好的。"}, {"type": "subtitle", "time": 16259.59, "timestamp": "04:30:59", "text": "当他们有……的时候，那可不是个好地方。"}]
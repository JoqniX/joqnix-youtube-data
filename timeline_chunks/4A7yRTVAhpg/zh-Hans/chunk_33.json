[{"type": "subtitle", "time": 1985.83, "timestamp": "00:33:05", "text": "好，就把它放在那儿吧。"}, {"type": "subtitle", "time": 1987.99, "timestamp": "00:33:07", "text": "我们不需要再进行研究了。"}, {"type": "subtitle", "time": 1989.669, "timestamp": "00:33:09", "text": "因为"}, {"type": "subtitle", "time": 1993.71, "timestamp": "00:33:13", "text": "呃，我们已经有洗碗机了。"}, {"type": "subtitle", "time": 1995.99, "timestamp": "00:33:15", "text": "啊，只是我们钱不够。"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "还没拿到。"}, {"type": "subtitle", "time": 2001.269, "timestamp": "00:33:21", "text": "等等，等等，等等，等等，等等。哦，我"}, {"type": "subtitle", "time": 2003.35, "timestamp": "00:33:23", "text": "忘了。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "我们无法升级现有设备。"}, {"type": "subtitle", "time": 2010.31, "timestamp": "00:33:30", "text": "呃，不行。"}, {"type": "subtitle", "time": 2017.11, "timestamp": "00:33:37", "text": "是的。这样对你来说更容易"}, {"type": "subtitle", "time": 2020.71, "timestamp": "00:33:40", "text": "排队。是的。是的。没错，没错，没错。"}, {"type": "subtitle", "time": 2033.43, "timestamp": "00:33:53", "text": "呃，我们得把它切掉。我的天哪。"}, {"type": "subtitle", "time": 2036.07, "timestamp": "00:33:56", "text": "是啊，真烦人。"}]
[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "嗯，当然。稍等片刻。我仍然"}, {"type": "subtitle", "time": 11943.429, "timestamp": "03:19:03", "text": "就像在寻找该死的……"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "就像合住一个卧室那样。哦，它"}, {"type": "subtitle", "time": 11948.87, "timestamp": "03:19:08", "text": "应该在一楼。第一的"}, {"type": "subtitle", "time": 11951.269, "timestamp": "03:19:11", "text": "地板的意思就像"}, {"type": "subtitle", "time": 11953.349, "timestamp": "03:19:13", "text": "如果你在一楼，那就去吧，而且你"}, {"type": "subtitle", "time": 11956.79, "timestamp": "03:19:16", "text": "上楼。"}, {"type": "subtitle", "time": 11959.67, "timestamp": "03:19:19", "text": "任何类似地标的东西，比如，你知道的。"}, {"type": "subtitle", "time": 11961.03, "timestamp": "03:19:21", "text": "什么？我就像要把……放进去一样"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "召唤阵上的汽油。这"}, {"type": "subtitle", "time": 11967.429, "timestamp": "03:19:27", "text": "一。这扇门。呃，不管哪扇门不是"}, {"type": "subtitle", "time": 11969.269, "timestamp": "03:19:29", "text": "打开。"}, {"type": "subtitle", "time": 11971.429, "timestamp": "03:19:31", "text": "哦，有两扇门没开。那是"}, {"type": "subtitle", "time": 11975.71, "timestamp": "03:19:35", "text": "早餐的关键。呃，我们"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "需要使用公用浴室。我不知道"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "我通常忘记了任何地方在哪里"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "任何房间可能都是如此。是的。"}, {"type": "subtitle", "time": 11993.11, "timestamp": "03:19:53", "text": "外面的房间没有上锁。"}, {"type": "subtitle", "time": 11995.11, "timestamp": "03:19:55", "text": "你去的地方"}, {"type": "subtitle", "time": 11998.15, "timestamp": "03:19:58", "text": "召唤装置，对吧？哦，那个"}]
[{"type": "subtitle", "time": 12840.63, "timestamp": "03:34:00", "text": "糟糕。那不是我们至少可以得到的"}, {"type": "subtitle", "time": 12841.99, "timestamp": "03:34:01", "text": "搞定一个。我们至少可以拿下一个"}, {"type": "subtitle", "time": 12852.63, "timestamp": "03:34:12", "text": "她不来了。等等，等等。我是"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "采摘。密切关注。密切关注。如何"}, {"type": "subtitle", "time": 12857.67, "timestamp": "03:34:17", "text": "长的？"}, {"type": "subtitle", "time": 12860.07, "timestamp": "03:34:20", "text": "呃，等等，等等，等等。呃，着火了。火。"}, {"type": "subtitle", "time": 12862.63, "timestamp": "03:34:22", "text": "是的。是的。"}, {"type": "subtitle", "time": 12865.83, "timestamp": "03:34:25", "text": "哦，她来了。她来了。明白了"}, {"type": "subtitle", "time": 12868.269, "timestamp": "03:34:28", "text": "美好的。我很好。我要把它点燃。"}, {"type": "subtitle", "time": 12872.309, "timestamp": "03:34:32", "text": "站立。不。好的。我会把枪放上。好的。"}, {"type": "subtitle", "time": 12874.07, "timestamp": "03:34:34", "text": "不，不，不，不，不，不，不，不要，不要"}, {"type": "subtitle", "time": 12877.19, "timestamp": "03:34:37", "text": "不行不行不行，我走不了路。等等，我"}, {"type": "subtitle", "time": 12879.83, "timestamp": "03:34:39", "text": "跑跑。那么神呢？呃，"}, {"type": "subtitle", "time": 12883.349, "timestamp": "03:34:43", "text": "我们可以稍后再编写代码。"}, {"type": "subtitle", "time": 12885.51, "timestamp": "03:34:45", "text": "好了，我要进去了。"}, {"type": "subtitle", "time": 12887.59, "timestamp": "03:34:47", "text": "哦，拜"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "等等，等等。发生了什么？维克去世了。尝试"}, {"type": "subtitle", "time": 12893.51, "timestamp": "03:34:53", "text": "重新连接到您之前的游戏。"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "哦，等等。不，不，不。呃，维克·维克的"}]
[{"type": "subtitle", "time": 11340.469, "timestamp": "03:09:00", "text": "删除那段背景故事。好的。 10月16日。这"}, {"type": "subtitle", "time": 11342.469, "timestamp": "03:09:02", "text": "这正是观众们所期待的一切。"}, {"type": "subtitle", "time": 11344.87, "timestamp": "03:09:04", "text": "祭祀诸神的时刻即将到来。"}, {"type": "subtitle", "time": 11347.67, "timestamp": "03:09:07", "text": "而且必须由我来牵涉任何人。"}, {"type": "subtitle", "time": 11350.23, "timestamp": "03:09:10", "text": "否则现在可​​能会破坏我的纽带。"}, {"type": "subtitle", "time": 11351.23, "timestamp": "03:09:11", "text": "和"}, {"type": "subtitle", "time": 11355.03, "timestamp": "03:09:15", "text": "阿佐，然后他就会被放逐。为什么"}, {"type": "subtitle", "time": 11358.87, "timestamp": "03:09:18", "text": "我发抖了吗？为什么要进行血液检查？"}, {"type": "subtitle", "time": 11363.19, "timestamp": "03:09:23", "text": "你好。你好呀。你好。"}, {"type": "subtitle", "time": 11367.59, "timestamp": "03:09:27", "text": "你好呀。你好呀。你好呀。"}, {"type": "subtitle", "time": 11369.51, "timestamp": "03:09:29", "text": "好的。好的。我觉得你已经……"}, {"type": "subtitle", "time": 11372.55, "timestamp": "03:09:32", "text": "你有一双美丽的眼睛，但我已婚。"}, {"type": "subtitle", "time": 11376.15, "timestamp": "03:09:36", "text": "所以我对此不予置评。"}, {"type": "subtitle", "time": 11380.389, "timestamp": "03:09:40", "text": "哦，是那位退休女演员吗？"}, {"type": "subtitle", "time": 11382.309, "timestamp": "03:09:42", "text": "比如结婚之类的？不，不，不"}, {"type": "subtitle", "time": 11385.269, "timestamp": "03:09:45", "text": "不。我在瓦莱兰特结婚了。哦，是的。"}, {"type": "subtitle", "time": 11388.389, "timestamp": "03:09:48", "text": "是啊是啊。走，走。好了，现在开始说话。"}, {"type": "subtitle", "time": 11391.11, "timestamp": "03:09:51", "text": "你按下E键。你看着笼子。"}, {"type": "subtitle", "time": 11398.63, "timestamp": "03:09:58", "text": "E. 现在看看他们走了。"}]
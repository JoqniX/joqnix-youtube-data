[{"type": "subtitle", "time": 4141.669, "timestamp": "01:09:01", "text": "[音乐]"}, {"type": "subtitle", "time": 4144.789, "timestamp": "01:09:04", "text": "谁会在晚上喝咖啡？"}, {"type": "subtitle", "time": 4146.789, "timestamp": "01:09:06", "text": "其实是我。我确实会喝咖啡。"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "柜台。"}, {"type": "subtitle", "time": 4169.829, "timestamp": "01:09:29", "text": "我们需要一张餐桌。是的，但我们没有"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "有足够的钱。送餐升降机。什么是"}, {"type": "subtitle", "time": 4174.87, "timestamp": "01:09:34", "text": "那？"}, {"type": "subtitle", "time": 4177.749, "timestamp": "01:09:37", "text": "连接。它连接着一切。等待。"}, {"type": "subtitle", "time": 4179.95, "timestamp": "01:09:39", "text": "好的，我要走了"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "把它取出来。那是免费的。"}, {"type": "subtitle", "time": 4185.39, "timestamp": "01:09:45", "text": "不，是"}, {"type": "subtitle", "time": 4192.55, "timestamp": "01:09:52", "text": "我打算把它放到架子上。我"}, {"type": "subtitle", "time": 4194.95, "timestamp": "01:09:54", "text": "猜测"}, {"type": "subtitle", "time": 4197.75, "timestamp": "01:09:57", "text": "我们只能在架子上放一个。哦，"}]
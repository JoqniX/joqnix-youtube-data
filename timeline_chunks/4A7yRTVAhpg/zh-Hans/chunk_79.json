[{"type": "subtitle", "time": 4743.65, "timestamp": "01:19:03", "text": "呃，你得把杯子给他们，或者"}, {"type": "subtitle", "time": 4745.149, "timestamp": "01:19:05", "text": "[音乐]"}, {"type": "subtitle", "time": 4751.39, "timestamp": "01:19:11", "text": "给它。"}, {"type": "subtitle", "time": 4755.11, "timestamp": "01:19:15", "text": "哦，原来是这样。他们问"}, {"type": "subtitle", "time": 4759.83, "timestamp": "01:19:19", "text": "牛奶。等等，我没明白。我也不。"}, {"type": "subtitle", "time": 4763.01, "timestamp": "01:19:23", "text": "得到它。我为什么需要奶瓶？"}]
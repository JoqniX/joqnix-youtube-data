[{"type": "subtitle", "time": 301.749, "timestamp": "00:05:01", "text": "能。不，我还在做。那是"}, {"type": "subtitle", "time": 311.51, "timestamp": "00:05:11", "text": "24. 我收到了邀请，好的，不错。能"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "你邀请我吗？抱歉，上面有划痕。我是"}, {"type": "subtitle", "time": 316.71, "timestamp": "00:05:16", "text": "逐一查看列表。是的，抱歉。"}, {"type": "subtitle", "time": 318.87, "timestamp": "00:05:18", "text": "擦伤，伙计。没关系。我可以直接邀请"}, {"type": "subtitle", "time": 320.95, "timestamp": "00:05:20", "text": "我。实际上，是的，你可以这样做"}, {"type": "subtitle", "time": 323.43, "timestamp": "00:05:23", "text": "确实如此。是的，我在这里。谁是"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "我们错过了什么？哦，不。我们是不是错过了什么？"}, {"type": "subtitle", "time": 329.11, "timestamp": "00:05:29", "text": "有人吗？你好，不行。好的。我呃"}, {"type": "subtitle", "time": 331.51, "timestamp": "00:05:31", "text": "是的。是的。呃，我该怎么离开？呃，"}, {"type": "subtitle", "time": 333.909, "timestamp": "00:05:33", "text": "等待。他们如何逃脱？逃脱。出口"}, {"type": "subtitle", "time": 337.67, "timestamp": "00:05:37", "text": "进入菜单。我们走吧。是的。逃脱。或者你"}, {"type": "subtitle", "time": 339.51, "timestamp": "00:05:39", "text": "可以直接跳过"}, {"type": "subtitle", "time": 341.749, "timestamp": "00:05:41", "text": "邀请。等待。我没看见。好的，我会"}, {"type": "subtitle", "time": 345.029, "timestamp": "00:05:45", "text": "我这就点开这个。所以，是"}, {"type": "subtitle", "time": 347.83, "timestamp": "00:05:47", "text": "你喜欢跑步吗？"}, {"type": "subtitle", "time": 350.629, "timestamp": "00:05:50", "text": "所以，各位，你们都为Oh My做些什么呢？"}, {"type": "subtitle", "time": 354.15, "timestamp": "00:05:54", "text": "上帝。知道了。知道了。"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "你父亲，伙计。"}, {"type": "subtitle", "time": 358.71, "timestamp": "00:05:58", "text": "太刻薄了。我知道你正在努力"}]
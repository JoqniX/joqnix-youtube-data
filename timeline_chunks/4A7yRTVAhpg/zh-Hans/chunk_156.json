[{"type": "subtitle", "time": 9366.59, "timestamp": "02:36:06", "text": "馅饼。需要一个"}, {"type": "subtitle", "time": 9370.389, "timestamp": "02:36:10", "text": "用面粉制作鸽子。揉成"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "馅饼碎了。反转以去除种子。然后"}, {"type": "subtitle", "time": 9376.469, "timestamp": "02:36:16", "text": "切碎、混合、烹煮。"}, {"type": "subtitle", "time": 9410.47, "timestamp": "02:36:50", "text": "你感觉到了"}]
[{"type": "subtitle", "time": 122.389, "timestamp": "00:02:02", "text": "哦，不，不，不"}, {"type": "subtitle", "time": 124.83, "timestamp": "00:02:04", "text": "抹杀你的名字。那是"}, {"type": "subtitle", "time": 127.51, "timestamp": "00:02:07", "text": "那样会要了你的命。它确实会致命"}, {"type": "chat", "time": 128.565, "timestamp": "00:02:08", "author": "@HawksTheGreat", "avatar": "https://yt4.ggpht.com/wIXzMkIdhkpB7e8s2M6Eg2Kma9ZHeQ86iJ5gTwujW3p7qmbWfnmzLN_VgliuNH3SRsdBR5qeZA=s64-c-k-c0x00ffffff-no-rj", "message": "what's this?"}, {"type": "subtitle", "time": 130.869, "timestamp": "00:02:10", "text": "它。不，那根木头正好砸到我了。"}, {"type": "chat", "time": 131.368, "timestamp": "00:02:11", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... Matthew, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 132.98, "timestamp": "00:02:12", "text": "因为我当时就像"}, {"type": "subtitle", "time": 138.15, "timestamp": "00:02:18", "text": "我没有。我们少了一个"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "绳索。"}, {"type": "subtitle", "time": 141.82999999999998, "timestamp": "00:02:21", "text": "你有布，我有绳子。我有"}, {"type": "subtitle", "time": 143.99, "timestamp": "00:02:23", "text": "一根绳子。动起来，动起来，动起来，动起来。这是什么？"}, {"type": "subtitle", "time": 145.99, "timestamp": "00:02:25", "text": "你们还好吗？绳子穿过来了。未来"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "通过。好的。我可以在哪里烹饪我们"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "需要再次收集日志。我要走了"}, {"type": "subtitle", "time": 154.39, "timestamp": "00:02:34", "text": "去收集物资。是的，先生。"}, {"type": "subtitle", "time": 157.03, "timestamp": "00:02:37", "text": "好了。那该有多滑稽啊"}, {"type": "subtitle", "time": 160.82999999999998, "timestamp": "00:02:40", "text": "你知道，在木筏上生火。"}, {"type": "subtitle", "time": 163.82999999999998, "timestamp": "00:02:43", "text": "是的，我们确实可以做到这一点。木材。"}, {"type": "subtitle", "time": 168.22899999999998, "timestamp": "00:02:48", "text": "木材。我们可能喜欢这位歌手。"}, {"type": "subtitle", "time": 177.39, "timestamp": "00:02:57", "text": "尝试通过"}]
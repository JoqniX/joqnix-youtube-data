[{"type": "subtitle", "time": 16382.79, "timestamp": "04:33:02", "text": "虽然没人说话，但这里明明有人。"}, {"type": "subtitle", "time": 16384.59, "timestamp": "04:33:04", "text": "我不"}, {"type": "subtitle", "time": 16387.99, "timestamp": "04:33:07", "text": "知道。不过，它确实很吓人。"}, {"type": "subtitle", "time": 16390.15, "timestamp": "04:33:10", "text": "很遗憾，我们得换游戏了。"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "如果仅供参考，可能就像“哦，还有……”"}, {"type": "subtitle", "time": 16395.83, "timestamp": "04:33:15", "text": "标题里有“吞噬”二字，但实际上并没有。"}, {"type": "subtitle", "time": 16399.109, "timestamp": "04:33:19", "text": "培养游戏观看能力。呃，我们有"}, {"type": "subtitle", "time": 16402.15, "timestamp": "04:33:22", "text": "就像另一个神话般的存在。她"}, {"type": "subtitle", "time": 16403.429, "timestamp": "04:33:23", "text": "准备和我们一起玩。但"}, {"type": "subtitle", "time": 16405.949, "timestamp": "04:33:25", "text": "不幸的是，她有一些类似的东西"}, {"type": "subtitle", "time": 16408.47, "timestamp": "04:33:28", "text": "并发症。所以，我们不得不……"}, {"type": "subtitle", "time": 16411.83, "timestamp": "04:33:31", "text": "就像改变游戏规则一样，因为，嗯，是的。"}, {"type": "subtitle", "time": 16414.789, "timestamp": "04:33:34", "text": "就像两个人合二为一一样困难"}, {"type": "subtitle", "time": 16416.789, "timestamp": "04:33:36", "text": "否则就会非常无聊。所以，我们"}, {"type": "subtitle", "time": 16419.429, "timestamp": "04:33:39", "text": "得改变一下游戏规则，"}, {"type": "subtitle", "time": 16421.83, "timestamp": "04:33:41", "text": "其实只是想换换口味而已"}, {"type": "subtitle", "time": 16424.23, "timestamp": "04:33:44", "text": "只是把东西搬走之类的"}, {"type": "subtitle", "time": 16426.59, "timestamp": "04:33:46", "text": "这样的。所以，这就是为什么我们像是在玩游戏。"}, {"type": "subtitle", "time": 16429.75, "timestamp": "04:33:49", "text": "就像两场比赛一样。好的，"}, {"type": "subtitle", "time": 16431.429, "timestamp": "04:33:51", "text": "我回来了。我不知道。我回来了。所以"}, {"type": "subtitle", "time": 16435.189, "timestamp": "04:33:55", "text": "就是这样。所以还有其他人喜欢吗？"}, {"type": "subtitle", "time": 16439.189, "timestamp": "04:33:59", "text": "只是为了提供背景信息？是的，我们没有结束"}]
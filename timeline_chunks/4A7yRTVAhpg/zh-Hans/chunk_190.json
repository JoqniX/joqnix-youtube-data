[{"type": "subtitle", "time": 11400.55, "timestamp": "03:10:00", "text": "哦，等等。为什么？等等，他们为什么要走？"}, {"type": "subtitle", "time": 11403.11, "timestamp": "03:10:03", "text": "在房子里面吗？什么？现在我们可以走了"}, {"type": "subtitle", "time": 11406.07, "timestamp": "03:10:06", "text": "在房子里面。敬请期待。"}, {"type": "subtitle", "time": 11409.11, "timestamp": "03:10:09", "text": "嗯？我需要服用吗？我需要服用吗？"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "把小麦拿走吗？是的。我不"}, {"type": "subtitle", "time": 11414.23, "timestamp": "03:10:14", "text": "知道。目前还没有这个打算。"}, {"type": "subtitle", "time": 11417.269, "timestamp": "03:10:17", "text": "我们可以接受。是的。如果你有它的话"}, {"type": "subtitle", "time": 11418.63, "timestamp": "03:10:18", "text": "你的手。是的。快点。快点。哦，我的"}, {"type": "subtitle", "time": 11421.269, "timestamp": "03:10:21", "text": "上帝。看看成本。真是乱成一团。哦"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "它来了。"}, {"type": "subtitle", "time": 11433.51, "timestamp": "03:10:33", "text": "为什么？为什么？为什么会有令人毛骨悚然的声音？"}, {"type": "subtitle", "time": 11437.03, "timestamp": "03:10:37", "text": "未来？是的。过来。过来。哦，"}, {"type": "subtitle", "time": 11438.469, "timestamp": "03:10:38", "text": "乔，你想吃披萨吗？来"}, {"type": "subtitle", "time": 11441.83, "timestamp": "03:10:41", "text": "这里。啊，披萨。比萨。披萨时间到！嘿，"}, {"type": "subtitle", "time": 11443.75, "timestamp": "03:10:43", "text": "看。哦，它是可以吃的。这看起来"}, {"type": "subtitle", "time": 11446.389, "timestamp": "03:10:46", "text": "伟大的。披萨其实没那么难吃。不能"}, {"type": "subtitle", "time": 11448.95, "timestamp": "03:10:48", "text": "等待。看起来真好吃。"}, {"type": "subtitle", "time": 11454.63, "timestamp": "03:10:54", "text": "是的。高度逼真的披萨。是的。"}, {"type": "subtitle", "time": 11456.63, "timestamp": "03:10:56", "text": "这里还有一些茶杯。我们可以得到"}, {"type": "subtitle", "time": 11458.79, "timestamp": "03:10:58", "text": "有人在喝茶。我觉得那是酒精。"}]
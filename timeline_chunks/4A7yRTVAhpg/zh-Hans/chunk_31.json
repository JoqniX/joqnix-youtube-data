[{"type": "subtitle", "time": 1860.87, "timestamp": "00:31:00", "text": "你可以每天都清理垃圾。"}, {"type": "subtitle", "time": 1863.909, "timestamp": "00:31:03", "text": "最好不要再做了。"}, {"type": "subtitle", "time": 1867.029, "timestamp": "00:31:07", "text": "垃圾。如果垃圾更多，那就意味着像"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "更难拔出来。放在哪里"}, {"type": "subtitle", "time": 1880.95, "timestamp": "00:31:20", "text": "哦，我最讨厌洗碗机了。那个"}, {"type": "subtitle", "time": 1883.99, "timestamp": "00:31:23", "text": "卡住了。哇哦。"}, {"type": "subtitle", "time": 1886.39, "timestamp": "00:31:26", "text": "我们走吧。"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "[音乐]"}, {"type": "subtitle", "time": 1890.23, "timestamp": "00:31:30", "text": "更多钱。"}, {"type": "subtitle", "time": 1896.07, "timestamp": "00:31:36", "text": "顾客订单已隐藏"}, {"type": "subtitle", "time": 1898.35, "timestamp": "00:31:38", "text": "如果不是"}, {"type": "subtitle", "time": 1901.99, "timestamp": "00:31:41", "text": "附近。加入蘑菇作为装饰。我"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "我们哦，是的。我弄到了一台炉灶。我们"}]
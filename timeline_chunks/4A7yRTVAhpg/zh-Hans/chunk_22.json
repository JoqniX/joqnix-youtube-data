[{"type": "subtitle", "time": 1324.35, "timestamp": "00:22:04", "text": "我是"}, {"type": "subtitle", "time": 1327.75, "timestamp": "00:22:07", "text": "炊具。我是厨师。"}, {"type": "subtitle", "time": 1343.95, "timestamp": "00:22:23", "text": "好的。我的天哪，是粉笔！"}, {"type": "subtitle", "time": 1347.19, "timestamp": "00:22:27", "text": "混合。里面加了巧克力。我们赢了一场。"}, {"type": "subtitle", "time": 1349.11, "timestamp": "00:22:29", "text": "做得好。你可以烹饪另一个。"}, {"type": "subtitle", "time": 1351.07, "timestamp": "00:22:31", "text": "再次。"}, {"type": "subtitle", "time": 1365.27, "timestamp": "00:22:45", "text": "出去。谢谢。等等，不，那个是“否”。"}, {"type": "subtitle", "time": 1368.23, "timestamp": "00:22:48", "text": "那条写得很好。"}, {"type": "subtitle", "time": 1371.85, "timestamp": "00:22:51", "text": "两种稀有品种。哦，是的。像这样。"}]
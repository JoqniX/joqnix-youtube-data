[{"type": "subtitle", "time": 12664.07, "timestamp": "03:31:04", "text": "我需要这样做吗？不。对。"}, {"type": "subtitle", "time": 12667.03, "timestamp": "03:31:07", "text": "黄金你可以留着。我会保留"}, {"type": "subtitle", "time": 12669.91, "timestamp": "03:31:09", "text": "然后编写代码。好的。"}, {"type": "subtitle", "time": 12680.309, "timestamp": "03:31:20", "text": "哦，我可以把它放在这个地方。"}, {"type": "subtitle", "time": 12682.95, "timestamp": "03:31:22", "text": "正确的？"}, {"type": "subtitle", "time": 12684.87, "timestamp": "03:31:24", "text": "她会来找我吗？它会逃跑。"}, {"type": "subtitle", "time": 12686.309, "timestamp": "03:31:26", "text": "它会逃跑。你不能丢掉"}, {"type": "subtitle", "time": 12689.51, "timestamp": "03:31:29", "text": "山羊。啊，"}, {"type": "subtitle", "time": 12692.15, "timestamp": "03:31:32", "text": "你不能像拿医疗包那样拿着山羊"}, {"type": "subtitle", "time": 12699.349, "timestamp": "03:31:39", "text": "等等，如果我把它拿在手里，他会"}, {"type": "subtitle", "time": 12706.79, "timestamp": "03:31:46", "text": "并不真地。哦好的。那是我的"}, {"type": "subtitle", "time": 12709.99, "timestamp": "03:31:49", "text": "好的。我有一只山羊，杰克也有一只。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "顺便说一句，是地下室。哦，真棒。"}, {"type": "subtitle", "time": 12715.83, "timestamp": "03:31:55", "text": "总之，我有一只山羊，杰克也有一只"}, {"type": "subtitle", "time": 12717.91, "timestamp": "03:31:57", "text": "山羊。我们该怎么办？好的。是的，我们"}]
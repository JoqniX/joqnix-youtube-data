[{"type": "subtitle", "time": 11100.63, "timestamp": "03:05:00", "text": "他亲自召唤了一位扎齐尔。两年来，"}, {"type": "subtitle", "time": 11103.51, "timestamp": "03:05:03", "text": "安娜尝试了在……中发现的各种仪式。"}, {"type": "subtitle", "time": 11106.469, "timestamp": "03:05:06", "text": "她翻阅古代文献，寻找出路"}, {"type": "subtitle", "time": 11108.429, "timestamp": "03:05:08", "text": "饲养山羊"}, {"type": "subtitle", "time": 11111.429, "timestamp": "03:05:11", "text": "恶魔。时间很长。我认为那是"}, {"type": "subtitle", "time": 11113.67, "timestamp": "03:05:13", "text": "比四月任何一段感情都长"}, {"type": "subtitle", "time": 11117.269, "timestamp": "03:05:17", "text": "有。灾难性的想法。"}, {"type": "subtitle", "time": 11119.99, "timestamp": "03:05:19", "text": "作为她最信任的追随者之一，"}, {"type": "subtitle", "time": 11122.63, "timestamp": "03:05:22", "text": "你来到安娜家，发现"}, {"type": "subtitle", "time": 11127.349, "timestamp": "03:05:27", "text": "找出哪里出了问题，或者谁出了问题。谁有"}, {"type": "subtitle", "time": 11130.15, "timestamp": "03:05:30", "text": "出错了吗？哦，西蒙将无法……"}, {"type": "subtitle", "time": 11133.19, "timestamp": "03:05:33", "text": "加入我们。他有任务在身。"}, {"type": "subtitle", "time": 11136.309, "timestamp": "03:05:36", "text": "哦，不。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 11142.389, "timestamp": "03:05:42", "text": "没关系。坚持，稍等。你好，蓝色。感谢"}, {"type": "subtitle", "time": 11145.19, "timestamp": "03:05:45", "text": "感谢阅读。欢迎来到直播间。"}, {"type": "subtitle", "time": 11148.309, "timestamp": "03:05:48", "text": "你好吗？哦，等等。为什么是"}, {"type": "subtitle", "time": 11150.389, "timestamp": "03:05:50", "text": "天黑了吗？我的天啊。如何获得"}]
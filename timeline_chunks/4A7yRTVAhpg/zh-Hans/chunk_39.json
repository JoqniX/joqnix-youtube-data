[{"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "灶台，我不能升级吗？这是什么？"}, {"type": "subtitle", "time": 2347.47, "timestamp": "00:39:07", "text": "我没有"}, {"type": "subtitle", "time": 2349.47, "timestamp": "00:39:09", "text": "做什么"}, {"type": "subtitle", "time": 2352.79, "timestamp": "00:39:12", "text": "这？看起来像个工厂。"}, {"type": "subtitle", "time": 2355.91, "timestamp": "00:39:15", "text": "是的，我也不确定那是什么。"}, {"type": "subtitle", "time": 2361.51, "timestamp": "00:39:21", "text": "但我们会想办法解决的。我们走吧。是的。"}, {"type": "subtitle", "time": 2364.23, "timestamp": "00:39:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2365.99, "timestamp": "00:39:25", "text": "切碎字母，并可选择添加切碎内容"}, {"type": "subtitle", "time": 2373.93, "timestamp": "00:39:33", "text": "时间。"}, {"type": "subtitle", "time": 2384.069, "timestamp": "00:39:44", "text": "你用那种方式称呼别人"}, {"type": "subtitle", "time": 2386.79, "timestamp": "00:39:46", "text": "他们过来了。"}, {"type": "subtitle", "time": 2393.99, "timestamp": "00:39:53", "text": "哦，是的。这不需要烹饪"}, {"type": "subtitle", "time": 2398.349, "timestamp": "00:39:58", "text": "烹饪。是的，这不需要烹饪。"}]
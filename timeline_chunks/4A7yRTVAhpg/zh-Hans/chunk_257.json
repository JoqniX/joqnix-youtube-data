[{"type": "subtitle", "time": 15421.309, "timestamp": "04:17:01", "text": "不，我想要我"}, {"type": "subtitle", "time": 15424.07, "timestamp": "04:17:04", "text": "想要玩《Valerant》简直太棒了"}, {"type": "subtitle", "time": 15427.91, "timestamp": "04:17:07", "text": "恐怖游戏，对吧？嗯，算是吧。是的。"}, {"type": "subtitle", "time": 15430.63, "timestamp": "04:17:10", "text": "这些经历有多可怕？哦，你知道的。"}, {"type": "subtitle", "time": 15432.389, "timestamp": "04:17:12", "text": "不，归根结底，我们仍然"}, {"type": "subtitle", "time": 15435.349, "timestamp": "04:17:15", "text": "你们还在努力拼搏。"}, {"type": "subtitle", "time": 15442.55, "timestamp": "04:17:22", "text": "你们知道吗？我相当确定"}, {"type": "subtitle", "time": 15446.79, "timestamp": "04:17:26", "text": "比如，呃，在Steam上是不是很明显？"}, {"type": "subtitle", "time": 15449.11, "timestamp": "04:17:29", "text": "属于心理恐怖题材。"}, {"type": "subtitle", "time": 15451.99, "timestamp": "04:17:31", "text": "所以每次他们他妈的把它删掉的时候"}, {"type": "subtitle", "time": 15454.389, "timestamp": "04:17:34", "text": "尽管。他们把它移走了。"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "哦，但它可是经典之作。是的，他们"}, {"type": "subtitle", "time": 15460.63, "timestamp": "04:17:40", "text": "已移除。哇。每次"}, {"type": "subtitle", "time": 15462.07, "timestamp": "04:17:42", "text": "万圣节促销活动即将到来。"}, {"type": "subtitle", "time": 15464.95, "timestamp": "04:17:44", "text": "会像所有“为什么？”一样显示出来。因为神话"}, {"type": "subtitle", "time": 15467.429, "timestamp": "04:17:47", "text": "我晕车了，而且我们是唯一一个"}, {"type": "subtitle", "time": 15472.469, "timestamp": "04:17:52", "text": "更懂得如何演奏迪瓦的玩家。"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "西蒙的儿子来不了，所以我们"}, {"type": "subtitle", "time": 15476.83, "timestamp": "04:17:56", "text": "考虑切换"}]
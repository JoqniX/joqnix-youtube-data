[{"type": "subtitle", "time": 3782.39, "timestamp": "01:03:02", "text": "咖啡。太好了。我喜欢这个。我"}, {"type": "subtitle", "time": 3785.75, "timestamp": "01:03:05", "text": "就是这样。我太喜欢这个了。哦，"}, {"type": "subtitle", "time": 3789.51, "timestamp": "01:03:09", "text": "更容易移动。行事得体。是的。演员"}, {"type": "subtitle", "time": 3791.91, "timestamp": "01:03:11", "text": "立方体。"}, {"type": "subtitle", "time": 3801.27, "timestamp": "01:03:21", "text": "我准备好了吗？好的。"}, {"type": "subtitle", "time": 3804.63, "timestamp": "01:03:24", "text": "哦，这全靠我的勇气值和快捷键设置。"}, {"type": "subtitle", "time": 3808.789, "timestamp": "01:03:28", "text": "太搞笑了。准备好？看？好的。乔克。"}, {"type": "subtitle", "time": 3816.349, "timestamp": "01:03:36", "text": "乔克已经到了可以喝酒开车的年龄。"}, {"type": "subtitle", "time": 3818.99, "timestamp": "01:03:38", "text": "是啊，只是我没有"}, {"type": "subtitle", "time": 3821.99, "timestamp": "01:03:41", "text": "喝。我喝几口酒就醉了。"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "啤酒之类的东西。我不知道为什么。哦，我"}, {"type": "subtitle", "time": 3827.309, "timestamp": "01:03:47", "text": "我觉得我的酒总是你"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "轻的。我不知道你怎么想。"}, {"type": "subtitle", "time": 3839.589, "timestamp": "01:03:59", "text": "你怎么知道自己是酗酒者？"}]
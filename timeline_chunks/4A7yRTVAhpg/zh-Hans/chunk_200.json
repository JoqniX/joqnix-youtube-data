[{"type": "subtitle", "time": 12001.59, "timestamp": "03:20:01", "text": "后门也锁着。我"}, {"type": "subtitle", "time": 12003.95, "timestamp": "03:20:03", "text": "我觉得钥匙就在里面。"}, {"type": "subtitle", "time": 12007.469, "timestamp": "03:20:07", "text": "我的天啊，南瓜。"}, {"type": "subtitle", "time": 12011.429, "timestamp": "03:20:11", "text": "哦，又一个南瓜。"}, {"type": "subtitle", "time": 12021.56, "timestamp": "03:20:21", "text": "该死。好，消灭恶魔。"}, {"type": "subtitle", "time": 12023.269, "timestamp": "03:20:23", "text": "[音乐]"}, {"type": "subtitle", "time": 12027.75, "timestamp": "03:20:27", "text": "我好困惑。你好。你好。我 我"}, {"type": "subtitle", "time": 12031.83, "timestamp": "03:20:31", "text": "仍然像在寻找爱情。我"}, {"type": "subtitle", "time": 12034.429, "timestamp": "03:20:34", "text": "真希望我们俩能共同抚养这些孩子。所以，"}, {"type": "subtitle", "time": 12039.349, "timestamp": "03:20:39", "text": "等待。我有个想法。所以，如果安娜"}, {"type": "subtitle", "time": 12042.469, "timestamp": "03:20:42", "text": "被抓住了，我就死了。呃，你得到"}, {"type": "subtitle", "time": 12044.71, "timestamp": "03:20:44", "text": "丧失行动能力，然后我们可以恢复"}, {"type": "subtitle", "time": 12047.269, "timestamp": "03:20:47", "text": "你带着医疗包。"}, {"type": "subtitle", "time": 12048.75, "timestamp": "03:20:48", "text": "哦，该如何……"}, {"type": "subtitle", "time": 12053.75, "timestamp": "03:20:53", "text": "呃，再次从安娜那里逃脱。如果她得到"}, {"type": "subtitle", "time": 12056.55, "timestamp": "03:20:56", "text": "你，你死定了。你转过你的紫外线"}, {"type": "subtitle", "time": 12059.83, "timestamp": "03:20:59", "text": "她。你用紫外线照射她，让她昏迷。"}]
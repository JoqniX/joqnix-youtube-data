[{"type": "subtitle", "time": 18307.83, "timestamp": "05:05:07", "text": "尽管。但是，嗯，所以，我就像……"}, {"type": "subtitle", "time": 18311.03, "timestamp": "05:05:11", "text": "下周的日程安排已经提前为我制定好了。"}, {"type": "subtitle", "time": 18314.31, "timestamp": "05:05:14", "text": "东西。所以这三条溪流将是……"}, {"type": "subtitle", "time": 18317.27, "timestamp": "05:05:17", "text": "三条溪流会像很多一样"}, {"type": "subtitle", "time": 18320.868, "timestamp": "05:05:20", "text": "但就像我们会玩原神一样。地狱"}, {"type": "subtitle", "time": 18323.67, "timestamp": "05:05:23", "text": "稍微做点L42，在新"}, {"type": "subtitle", "time": 18325.23, "timestamp": "05:05:25", "text": "免费游戏"}, {"type": "subtitle", "time": 18327.51, "timestamp": "05:05:27", "text": "维克将要出演的那场演出真是太棒了！"}, {"type": "subtitle", "time": 18330.15, "timestamp": "05:05:30", "text": "陪同他的是一小段。我为什么会在这里"}, {"type": "subtitle", "time": 18332.948, "timestamp": "05:05:32", "text": "被拖来陪同，我不知道为什么"}, {"type": "subtitle", "time": 18335.83, "timestamp": "05:05:35", "text": "至少我没玩过这种订单游戏。"}, {"type": "subtitle", "time": 18338.55, "timestamp": "05:05:38", "text": "观看过程有点痛苦，但仍然"}, {"type": "subtitle", "time": 18340.39, "timestamp": "05:05:40", "text": "至少我没有受到精神创伤。"}, {"type": "subtitle", "time": 18343.868, "timestamp": "05:05:43", "text": "就像看一样，而且实际上"}, {"type": "subtitle", "time": 18351.23, "timestamp": "05:05:51", "text": "那。我的天啊。但"}, {"type": "subtitle", "time": 18354.628, "timestamp": "05:05:54", "text": "是啊，应该会很有趣。这会很有趣。"}, {"type": "subtitle", "time": 18357.31, "timestamp": "05:05:57", "text": "我很兴奋。我是"}, {"type": "subtitle", "time": 18359.708, "timestamp": "05:05:59", "text": "大肆宣传。"}]
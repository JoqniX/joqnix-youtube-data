[{"type": "subtitle", "time": 15488.189, "timestamp": "04:18:08", "text": "我的天啊。再见。"}, {"type": "subtitle", "time": 15491.91, "timestamp": "04:18:11", "text": "好的。美好的。我们会找到你们俩的。"}, {"type": "subtitle", "time": 15494.79, "timestamp": "04:18:14", "text": "流媒体就是……嗯。不过没关系。"}, {"type": "subtitle", "time": 15496.03, "timestamp": "04:18:16", "text": "我将永远"}, {"type": "subtitle", "time": 15512.79, "timestamp": "04:18:32", "text": "操作员？我的天哪。"}, {"type": "subtitle", "time": 15514.95, "timestamp": "04:18:34", "text": "我相信你有闪光灯。你"}, {"type": "subtitle", "time": 15516.269, "timestamp": "04:18:36", "text": "可闪光"}, {"type": "subtitle", "time": 15520.55, "timestamp": "04:18:40", "text": "他们。我有一张。"}, {"type": "subtitle", "time": 15522.95, "timestamp": "04:18:42", "text": "我的天哪。"}, {"type": "subtitle", "time": 15531.11, "timestamp": "04:18:51", "text": "这游戏玩起来感觉好奇怪。一直以来"}, {"type": "subtitle", "time": 15532.87, "timestamp": "04:18:52", "text": "尽管。"}, {"type": "subtitle", "time": 15534.87, "timestamp": "04:18:54", "text": "没关系。你会重新回到……"}, {"type": "subtitle", "time": 15537.75, "timestamp": "04:18:57", "text": "很快就进入了节奏。不到一秒。"}]
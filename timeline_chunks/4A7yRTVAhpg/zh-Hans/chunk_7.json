[{"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "我们坐在同一个位置吗？我认为我们"}, {"type": "subtitle", "time": 425.11, "timestamp": "00:07:05", "text": "是。"}, {"type": "subtitle", "time": 436.51, "timestamp": "00:07:16", "text": "你好。有"}, {"type": "subtitle", "time": 441.029, "timestamp": "00:07:21", "text": "一个桃子。嗨，桃子。你好，洛雷斯。老的"}, {"type": "subtitle", "time": 445.83, "timestamp": "00:07:25", "text": "男人。你好。你好。"}, {"type": "subtitle", "time": 448.41, "timestamp": "00:07:28", "text": "我们和查克尼克一起玩"}, {"type": "subtitle", "time": 451.07, "timestamp": "00:07:31", "text": "[音乐]"}, {"type": "subtitle", "time": 453.99, "timestamp": "00:07:33", "text": "今天。音乐没有播放。哦，"}, {"type": "subtitle", "time": 464.629, "timestamp": "00:07:44", "text": "开始。我会邀请你。我觉得是这样。"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "桃。我以前从没玩过这款游戏。"}, {"type": "subtitle", "time": 479.35, "timestamp": "00:07:59", "text": "那将是我和你的第一次。"}]
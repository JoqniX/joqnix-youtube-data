[{"type": "subtitle", "time": 13260.55, "timestamp": "03:41:00", "text": "经过。嗯，希望你的大腿感觉好些了。"}, {"type": "subtitle", "time": 13266.03, "timestamp": "03:41:06", "text": "请帮我续满水。"}, {"type": "subtitle", "time": 13269.79, "timestamp": "03:41:09", "text": "是的。我会回来的。"}, {"type": "subtitle", "time": 13273.67, "timestamp": "03:41:13", "text": "是的。玩转小镇，因为我，我们从未"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "玩过小镇。我们试过了，但我们不喜欢"}, {"type": "subtitle", "time": 13284.91, "timestamp": "03:41:24", "text": "某物。"}, {"type": "subtitle", "time": 13288.229, "timestamp": "03:41:28", "text": "你好。哦，我的钥匙突然不能用了。"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "原因。嗯，是的，我记得。"}, {"type": "subtitle", "time": 13291.91, "timestamp": "03:41:31", "text": "看起来很麻烦，所以我们"}, {"type": "subtitle", "time": 13295.75, "timestamp": "03:41:35", "text": "没上场。是的。哦。哦，我们也是。"}, {"type": "subtitle", "time": 13298.309, "timestamp": "03:41:38", "text": "时间也不够了。所以就像我们没玩一样"}, {"type": "subtitle", "time": 13306.95, "timestamp": "03:41:46", "text": "你想玩的任何东西，但"}, {"type": "subtitle", "time": 13309.59, "timestamp": "03:41:49", "text": "这一点也不简单。"}, {"type": "subtitle", "time": 13311.75, "timestamp": "03:41:51", "text": "我的意思是，就简单而言，我认为安娜"}, {"type": "subtitle", "time": 13315.03, "timestamp": "03:41:55", "text": "是最简单的。之后我会……"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "它叫什么来着？旅店。蜘蛛"}]
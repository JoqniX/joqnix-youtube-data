[{"type": "subtitle", "time": 11284.15, "timestamp": "03:08:04", "text": "山羊？ B. 烧烤。嗯？你为什么会这样？"}, {"type": "subtitle", "time": 11286.95, "timestamp": "03:08:06", "text": "杀死无辜的山羊？快点。是"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "在那里烧烤。你知道，这是"}, {"type": "subtitle", "time": 11291.429, "timestamp": "03:08:11", "text": "烧烤派对。哦，等等。什么是"}, {"type": "subtitle", "time": 11292.87, "timestamp": "03:08:12", "text": "这些山羊是怎么回事？我的天啊，"}, {"type": "subtitle", "time": 11295.03, "timestamp": "03:08:15", "text": "它们很诡异。好的。你想要"}, {"type": "subtitle", "time": 11296.469, "timestamp": "03:08:16", "text": "放了他们？你想做"}, {"type": "subtitle", "time": 11299.51, "timestamp": "03:08:19", "text": "荣誉？嗯？你为什么要设置它们？"}, {"type": "subtitle", "time": 11305.75, "timestamp": "03:08:25", "text": "听着，每个人都应该拥有……的生活"}, {"type": "subtitle", "time": 11307.51, "timestamp": "03:08:27", "text": "自由。你肯定不想被牵着鼻子走。"}, {"type": "subtitle", "time": 11310.07, "timestamp": "03:08:30", "text": "就是这样，对吧？你正在为他们做一件"}, {"type": "subtitle", "time": 11313.11, "timestamp": "03:08:33", "text": "恩惠。帮忙。"}, {"type": "subtitle", "time": 11315.11, "timestamp": "03:08:35", "text": "等等，你听到什么了吗？你听到了吗？"}, {"type": "subtitle", "time": 11317.99, "timestamp": "03:08:37", "text": "那？某人。好的，约翰，跟我来。"}, {"type": "subtitle", "time": 11320.309, "timestamp": "03:08:40", "text": "跟我来。跟我来。那是我。"}, {"type": "subtitle", "time": 11322.55, "timestamp": "03:08:42", "text": "约翰。那是我在跳。上帝啊，不要"}, {"type": "subtitle", "time": 11325.19, "timestamp": "03:08:45", "text": "吓唬我。"}, {"type": "subtitle", "time": 11330.63, "timestamp": "03:08:50", "text": "我的天啊。为什么？反正我们有。"}, {"type": "subtitle", "time": 11332.71, "timestamp": "03:08:52", "text": "好的。总之，乔，进去拿……"}, {"type": "subtitle", "time": 11334.23, "timestamp": "03:08:54", "text": "钥匙。"}, {"type": "subtitle", "time": 11337.11, "timestamp": "03:08:57", "text": "好的。对吧？好的。还有邪恶。和"}]
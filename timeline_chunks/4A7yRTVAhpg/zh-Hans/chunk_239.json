[{"type": "subtitle", "time": 14341.32, "timestamp": "03:59:01", "text": "出色地。"}, {"type": "subtitle", "time": 14343.189, "timestamp": "03:59:03", "text": "[音乐]"}, {"type": "subtitle", "time": 14345.189, "timestamp": "03:59:05", "text": "好的，如果你想的话，我们可以换游戏。"}, {"type": "subtitle", "time": 14347.75, "timestamp": "03:59:07", "text": "你想玩什么游戏？就像凯尔一样，什么"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "你想玩什么游戏？"}, {"type": "subtitle", "time": 14352.07, "timestamp": "03:59:12", "text": "尽管？游戏是做什么的？我需要"}, {"type": "subtitle", "time": 14356.229, "timestamp": "03:59:16", "text": "问题。把流量调低点，老兄。哦，"}, {"type": "subtitle", "time": 14359.189, "timestamp": "03:59:19", "text": "呃，你们怎么称呼上帝？那吓到我了。"}, {"type": "subtitle", "time": 14362.469, "timestamp": "03:59:22", "text": "是的。哦，你好，雅克先生。你好。"}, {"type": "subtitle", "time": 14365.269, "timestamp": "03:59:25", "text": "眼球在哪儿？我不能"}, {"type": "subtitle", "time": 14367.269, "timestamp": "03:59:27", "text": "寻找。"}, {"type": "subtitle", "time": 14369.349, "timestamp": "03:59:29", "text": "好的。他好像很感兴趣。我"}, {"type": "subtitle", "time": 14371.67, "timestamp": "03:59:31", "text": "我找到了，但我好像刚把它弄丢了。"}, {"type": "subtitle", "time": 14373.189, "timestamp": "03:59:33", "text": "立刻，因为我不想……"}, {"type": "subtitle", "time": 14376.309, "timestamp": "03:59:36", "text": "播放这个。你会怎么说呢？"}, {"type": "subtitle", "time": 14378.229, "timestamp": "03:59:38", "text": "你手里拿着的是什么游戏？"}, {"type": "subtitle", "time": 14381.83, "timestamp": "03:59:41", "text": "现在？呃，目前就像安装一样，我已经有"}, {"type": "subtitle", "time": 14384.55, "timestamp": "03:59:44", "text": "怪物猎人崛起。我有《英雄联盟》"}, {"type": "subtitle", "time": 14387.51, "timestamp": "03:59:47", "text": "锤子手表。我有一些Golfit好友。我"}, {"type": "subtitle", "time": 14391.03, "timestamp": "03:59:51", "text": "让英雄们玩转 Hammer 手表游戏。我"}, {"type": "subtitle", "time": 14395.429, "timestamp": "03:59:55", "text": "别。哦。是的。哦，还有更多游戏。我"}, {"type": "subtitle", "time": 14399.83, "timestamp": "03:59:59", "text": "也有《求生之路》。我看到了 I"}]
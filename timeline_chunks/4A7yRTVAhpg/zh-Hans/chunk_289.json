[{"type": "subtitle", "time": 17340.07, "timestamp": "04:49:00", "text": "就像在 YouTube 首秀之后一样，就像在 YouTube 首秀之前一样"}, {"type": "subtitle", "time": 17342.23, "timestamp": "04:49:02", "text": "在此之前，我会喜欢之后"}, {"type": "subtitle", "time": 17346.27, "timestamp": "04:49:06", "text": "出道前我会喜欢像"}, {"type": "subtitle", "time": 17350.23, "timestamp": "04:49:10", "text": "嗯嗯，就像前天一样，我会做……"}, {"type": "subtitle", "time": 17352.31, "timestamp": "04:49:12", "text": "拖车。我会像首秀那样放弃它"}, {"type": "subtitle", "time": 17355.27, "timestamp": "04:49:15", "text": "预告片之后，我将正式亮相。"}, {"type": "subtitle", "time": 17357.51, "timestamp": "04:49:17", "text": "出道之后我会发布……"}, {"type": "subtitle", "time": 17360.23, "timestamp": "04:49:20", "text": "在推特上发布模特照片。"}, {"type": "subtitle", "time": 17362.788, "timestamp": "04:49:22", "text": "是的，那会很好。"}, {"type": "subtitle", "time": 17365.39, "timestamp": "04:49:25", "text": "而不是像那样直接放弃"}, {"type": "subtitle", "time": 17368.31, "timestamp": "04:49:28", "text": "海报和所有炒作都抛到九霄云外"}, {"type": "subtitle", "time": 17372.628, "timestamp": "04:49:32", "text": "实际上，这样做才是最佳选择。我当时"}, {"type": "subtitle", "time": 17374.708, "timestamp": "04:49:34", "text": "考虑把它做成类似500那样的。"}, {"type": "subtitle", "time": 17376.31, "timestamp": "04:49:36", "text": "很特别，但我估计我不会喜欢"}, {"type": "subtitle", "time": 17379.35, "timestamp": "04:49:39", "text": "现在不可能更快达到500了。所以，就像"}, {"type": "subtitle", "time": 17382.15, "timestamp": "04:49:42", "text": "我打算就此作罢，然后离开"}, {"type": "subtitle", "time": 17384.15, "timestamp": "04:49:44", "text": "那里。"}, {"type": "subtitle", "time": 17388.15, "timestamp": "04:49:48", "text": "是的。我的天哪。呃，最重要的是"}, {"type": "subtitle", "time": 17391.75, "timestamp": "04:49:51", "text": "就像可以进行实验一样。所以是"}, {"type": "subtitle", "time": 17394.15, "timestamp": "04:49:54", "text": "一切都好。"}, {"type": "subtitle", "time": 17396.868, "timestamp": "04:49:56", "text": "我也在寻找类似的想法。"}]
[{"type": "subtitle", "time": 7202.189, "timestamp": "02:00:02", "text": "工作。我觉得我搞砸了。"}, {"type": "subtitle", "time": 7213.43, "timestamp": "02:00:13", "text": "哦，不。"}, {"type": "subtitle", "time": 7215.669, "timestamp": "02:00:15", "text": "哦，等等。"}, {"type": "subtitle", "time": 7219.55, "timestamp": "02:00:19", "text": "我们简短的呃"}, {"type": "subtitle", "time": 7222.55, "timestamp": "02:00:22", "text": "暂停面粉制作粉笔胡萝卜"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "以及肉类，并添加到与农场的互动中"}, {"type": "subtitle", "time": 7228.79, "timestamp": "02:00:28", "text": "饺子和厨师。"}, {"type": "subtitle", "time": 7231.629, "timestamp": "02:00:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7237.09, "timestamp": "02:00:37", "text": "需要。和"}, {"type": "subtitle", "time": 7240.189, "timestamp": "02:00:40", "text": "[音乐]"}, {"type": "subtitle", "time": 7244.47, "timestamp": "02:00:44", "text": "那它是如何运作的呢？"}, {"type": "subtitle", "time": 7248.31, "timestamp": "02:00:48", "text": "一定要油炸吗？煎一下？"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "不，但它应该是……哦，等等。"}, {"type": "subtitle", "time": 7253.629, "timestamp": "02:00:53", "text": "你知道吗？让"}, {"type": "subtitle", "time": 7259.27, "timestamp": "02:00:59", "text": "让我们就此死去吧。"}]
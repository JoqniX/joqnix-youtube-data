[{"type": "subtitle", "time": 18243.91, "timestamp": "05:04:03", "text": "今天有些人没能来，但仍然……"}, {"type": "subtitle", "time": 18245.628, "timestamp": "05:04:05", "text": "感谢"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "你，伙计。我当时非常期待。"}, {"type": "subtitle", "time": 18250.948, "timestamp": "05:04:10", "text": "虽然和 Simo 合作有点可惜，不过没关系。"}, {"type": "subtitle", "time": 18253.75, "timestamp": "05:04:13", "text": "总会有下一次机会。不，这个"}, {"type": "subtitle", "time": 18257.23, "timestamp": "05:04:17", "text": "永远是下一个"}, {"type": "subtitle", "time": 18260.708, "timestamp": "05:04:20", "text": "时间。所以，就像我想要的其中一件事一样"}, {"type": "subtitle", "time": 18263.83, "timestamp": "05:04:23", "text": "可以说，退伍军人事务部有点……"}, {"type": "subtitle", "time": 18266.31, "timestamp": "05:04:26", "text": "可怕的。幸好我没有尖叫。我"}, {"type": "subtitle", "time": 18268.628, "timestamp": "05:04:28", "text": "我差点尖叫到肺都哑了。"}, {"type": "subtitle", "time": 18271.19, "timestamp": "05:04:31", "text": "今天出去其实是因为阿姨"}, {"type": "subtitle", "time": 18273.59, "timestamp": "05:04:33", "text": "回家的时候就像你一样。"}, {"type": "subtitle", "time": 18276.23, "timestamp": "05:04:36", "text": "记得我刚到BB的时候"}, {"type": "subtitle", "time": 18279.51, "timestamp": "05:04:39", "text": "那次谈话，他突然就进来了。"}, {"type": "subtitle", "time": 18283.51, "timestamp": "05:04:43", "text": "还有一些其他的东西。是的。比如下午 12:00 到 1:00"}, {"type": "subtitle", "time": 18286.23, "timestamp": "05:04:46", "text": "凌晨1点。是的。我当时真想尖叫。"}, {"type": "subtitle", "time": 18289.948, "timestamp": "05:04:49", "text": "邻居们吸入我的肺里"}, {"type": "subtitle", "time": 18296.91, "timestamp": "05:04:56", "text": "疼痛。没关系"}]
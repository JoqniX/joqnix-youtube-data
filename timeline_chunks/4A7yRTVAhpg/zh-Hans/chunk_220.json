[{"type": "subtitle", "time": 13200.309, "timestamp": "03:40:00", "text": "前一天晚上我把一根绳子弄断了。"}, {"type": "subtitle", "time": 13203.429, "timestamp": "03:40:03", "text": "发生了什么事？该死。"}, {"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "该死。该死。为什么我的钥匙不在"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "在职的？"}, {"type": "subtitle", "time": 13208.71, "timestamp": "03:40:08", "text": "好吧，不知为何我的键盘"}, {"type": "subtitle", "time": 13209.99, "timestamp": "03:40:09", "text": "停止工作了。我设置了一个快捷键"}, {"type": "subtitle", "time": 13220.389, "timestamp": "03:40:20", "text": "没关系。没关系。加入。好的。嘿，"}, {"type": "subtitle", "time": 13224.79, "timestamp": "03:40:24", "text": "给我发个邀请。我已向您发送邀请。好的。"}, {"type": "subtitle", "time": 13227.269, "timestamp": "03:40:27", "text": "你好。我起来。我去把水接满。"}, {"type": "subtitle", "time": 13235.83, "timestamp": "03:40:35", "text": "好的。咱们去城里吧，因为我从来不喜欢"}, {"type": "subtitle", "time": 13243.51, "timestamp": "03:40:43", "text": "下地狱吧。哇。我很高兴我仍然在这里。"}, {"type": "subtitle", "time": 13248.15, "timestamp": "03:40:48", "text": "一个红头发的莫莉。谢谢。谢谢。"}, {"type": "subtitle", "time": 13249.99, "timestamp": "03:40:49", "text": "这是第一款这样做的游戏"}, {"type": "subtitle", "time": 13252.51, "timestamp": "03:40:52", "text": "我。我是"}, {"type": "subtitle", "time": 13254.91, "timestamp": "03:40:54", "text": "快乐的。你拿"}, {"type": "subtitle", "time": 13257.429, "timestamp": "03:40:57", "text": "关心。再见。感谢您的光临"}]
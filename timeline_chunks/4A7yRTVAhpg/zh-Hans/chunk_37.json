[{"type": "subtitle", "time": 2224.93, "timestamp": "00:37:04", "text": "做。我们还想要番茄。"}, {"type": "subtitle", "time": 2227.67, "timestamp": "00:37:07", "text": "[音乐]"}, {"type": "subtitle", "time": 2236.79, "timestamp": "00:37:16", "text": "躺在地上的人会压在……"}, {"type": "subtitle", "time": 2238.87, "timestamp": "00:37:18", "text": "一切。她只需要做饭就行了。"}, {"type": "subtitle", "time": 2240.75, "timestamp": "00:37:20", "text": "对……的期待"}, {"type": "subtitle", "time": 2245.67, "timestamp": "00:37:25", "text": "真实的。这对双方都很困难。"}, {"type": "subtitle", "time": 2249.13, "timestamp": "00:37:29", "text": "经验补助金。那是什么？"}, {"type": "subtitle", "time": 2250.91, "timestamp": "00:37:30", "text": "[音乐]"}, {"type": "subtitle", "time": 2254.109, "timestamp": "00:37:34", "text": "我获得更多升级卡牌以获得更多"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "经验。这是把披萨当主菜。"}, {"type": "subtitle", "time": 2261.51, "timestamp": "00:37:41", "text": "哦，现在有披萨了。"}, {"type": "subtitle", "time": 2264.069, "timestamp": "00:37:44", "text": "我们现在有披萨了。哦，我们有披萨。"}, {"type": "subtitle", "time": 2267.27, "timestamp": "00:37:47", "text": "现在。你想尝试哪一个？"}, {"type": "subtitle", "time": 2269.99, "timestamp": "00:37:49", "text": "披萨还是沙拉？"}, {"type": "subtitle", "time": 2273.19, "timestamp": "00:37:53", "text": "你觉得哪个更好？"}, {"type": "subtitle", "time": 2276.79, "timestamp": "00:37:56", "text": "两个我都行，不过沙拉更好。"}]
[{"type": "subtitle", "time": 541.99, "timestamp": "00:09:01", "text": "开始。哦。哦。是线上玩家吧？"}, {"type": "subtitle", "time": 543.47, "timestamp": "00:09:03", "text": "等等，你邀请了吗？"}, {"type": "subtitle", "time": 546.43, "timestamp": "00:09:06", "text": "我？我觉得我"}, {"type": "subtitle", "time": 548.99, "timestamp": "00:09:08", "text": "[音乐]"}, {"type": "subtitle", "time": 559.67, "timestamp": "00:09:19", "text": "你还好吗？"}, {"type": "subtitle", "time": 564.23, "timestamp": "00:09:24", "text": "我正在看……等等，我该如何加入？"}, {"type": "subtitle", "time": 567.35, "timestamp": "00:09:27", "text": "呃，我给你发了Steam邀请。"}, {"type": "subtitle", "time": 570.71, "timestamp": "00:09:30", "text": "我接受了。你发了吗？"}, {"type": "subtitle", "time": 572.87, "timestamp": "00:09:32", "text": "再次？"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "是的。"}, {"type": "subtitle", "time": 582.949, "timestamp": "00:09:42", "text": "[音乐]"}, {"type": "subtitle", "time": 585.12, "timestamp": "00:09:45", "text": "好了。"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "[音乐]"}, {"type": "subtitle", "time": 594.949, "timestamp": "00:09:54", "text": "坚持，稍等。给我一分钟时间。呃，让我"}, {"type": "subtitle", "time": 596.88, "timestamp": "00:09:56", "text": "就这么做"}]
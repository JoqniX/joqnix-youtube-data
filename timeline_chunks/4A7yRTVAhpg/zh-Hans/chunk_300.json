[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "比如，“嗯，没事。”是的，我应该"}, {"type": "subtitle", "time": 18005.91, "timestamp": "05:00:05", "text": "我已经提前通知过你了。我是"}, {"type": "subtitle", "time": 18009.47, "timestamp": "05:00:09", "text": "对不起。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "好的。该死。你依然拥有最棒的睡眠"}, {"type": "subtitle", "time": 18016.39, "timestamp": "05:00:16", "text": "醒。该死。我以为你去了"}, {"type": "subtitle", "time": 18019.11, "timestamp": "05:00:19", "text": "睡觉吧，伙计。是的。我以为你去了"}, {"type": "subtitle", "time": 18024.31, "timestamp": "05:00:24", "text": "总之，我会，我会，我会带走我的"}, {"type": "subtitle", "time": 18028.47, "timestamp": "05:00:28", "text": "现在就走。你好。"}, {"type": "subtitle", "time": 18030.708, "timestamp": "05:00:30", "text": "如果我喜欢，我会一直保持清醒直到死去。"}, {"type": "subtitle", "time": 18033.67, "timestamp": "05:00:33", "text": "耶稣基督。 Sumi 服务器。该死。"}, {"type": "subtitle", "time": 18037.19, "timestamp": "05:00:37", "text": "这些人就像醒着一样。我认为"}, {"type": "subtitle", "time": 18040.31, "timestamp": "05:00:40", "text": "明天，星期日。当然。当然。"}, {"type": "subtitle", "time": 18042.47, "timestamp": "05:00:42", "text": "所以他们才会这样。"}, {"type": "subtitle", "time": 18043.99, "timestamp": "05:00:43", "text": "醒。没关系。没关系。然后他们"}, {"type": "subtitle", "time": 18046.47, "timestamp": "05:00:46", "text": "那时它们就很好。"}, {"type": "subtitle", "time": 18048.47, "timestamp": "05:00:48", "text": "他们醒来多少次并不重要"}, {"type": "subtitle", "time": 18050.07, "timestamp": "05:00:50", "text": "尽管。"}, {"type": "subtitle", "time": 18051.99, "timestamp": "05:00:51", "text": "我的天哪。我真希望自己不用工作。"}, {"type": "subtitle", "time": 18056.11, "timestamp": "05:00:56", "text": "明天，伙计。我仍然在工作"}, {"type": "subtitle", "time": 18058.55, "timestamp": "05:00:58", "text": "明天。哦，你说它会很大"}]
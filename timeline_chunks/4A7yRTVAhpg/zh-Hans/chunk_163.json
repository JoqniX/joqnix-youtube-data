[{"type": "subtitle", "time": 9780.19, "timestamp": "02:43:00", "text": "他心想，他们到底想干什么？"}, {"type": "subtitle", "time": 9783.03, "timestamp": "02:43:03", "text": "做？为什么？为什么他们要玷污我们？"}, {"type": "subtitle", "time": 9796.389, "timestamp": "02:43:16", "text": "[音乐]"}, {"type": "subtitle", "time": 9800.55, "timestamp": "02:43:20", "text": "我就说到这里吧。"}, {"type": "subtitle", "time": 9803.349, "timestamp": "02:43:23", "text": "好的，我们可以到此结束了。"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "谢谢。"}, {"type": "subtitle", "time": 9814.79, "timestamp": "02:43:34", "text": "谢谢你邀请我。我们开始吧"}, {"type": "subtitle", "time": 9818.469, "timestamp": "02:43:38", "text": "希望下次能上场。好的，下一个"}, {"type": "subtitle", "time": 9823.19, "timestamp": "02:43:43", "text": "我到日本的时间。向上。不，"}, {"type": "subtitle", "time": 9826.85, "timestamp": "02:43:46", "text": "你比我早一个小时。"}, {"type": "subtitle", "time": 9828.349, "timestamp": "02:43:48", "text": "[音乐]"}, {"type": "subtitle", "time": 9831.03, "timestamp": "02:43:51", "text": "是的。是的。我们应该多进行合作。"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "真有趣。非常感谢。"}]
[{"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "爸爸，您好吗？我一切都好，但是"}, {"type": "subtitle", "time": 7089.229, "timestamp": "01:58:09", "text": "睡眠不足。我们俩"}, {"type": "subtitle", "time": 7093.03, "timestamp": "01:58:13", "text": "我们俩都睡眠不足，"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "东西。是的。你我都需要睡觉。但"}, {"type": "subtitle", "time": 7105.669, "timestamp": "01:58:25", "text": "[音乐]"}, {"type": "subtitle", "time": 7107.27, "timestamp": "01:58:27", "text": "请不要效仿我们。请"}, {"type": "subtitle", "time": 7112.43, "timestamp": "01:58:32", "text": "是"}, {"type": "subtitle", "time": 7115.43, "timestamp": "01:58:35", "text": "就像睡觉一样。"}, {"type": "subtitle", "time": 7119.07, "timestamp": "01:58:39", "text": "好的，我们试试。等等，这是什么？"}, {"type": "subtitle", "time": 7122.47, "timestamp": "01:58:42", "text": "食谱？需要面粉或加水才能制作"}, {"type": "subtitle", "time": 7126.229, "timestamp": "01:58:46", "text": "面团。将胡萝卜和肉切碎。哦，等等。"}, {"type": "subtitle", "time": 7139.589, "timestamp": "01:58:59", "text": "呃，不，如果我仍然把它放进去，我就可以访问它。"}]
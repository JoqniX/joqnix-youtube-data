[{"type": "subtitle", "time": 13920.79, "timestamp": "03:52:00", "text": "谁像个笨蛋一样领导？"}, {"type": "subtitle", "time": 13923.429, "timestamp": "03:52:03", "text": "呃，在温泉上，呃"}, {"type": "subtitle", "time": 13932.269, "timestamp": "03:52:12", "text": "房间"}, {"type": "subtitle", "time": 13935.11, "timestamp": "03:52:15", "text": "八。哦，"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "七。五。哦，我没看到。"}, {"type": "subtitle", "time": 13941.75, "timestamp": "03:52:21", "text": "另一把钥匙。我知道。我只想撒谎"}, {"type": "subtitle", "time": 13944.469, "timestamp": "03:52:24", "text": "躺到床上睡觉去吧，伙计。房间"}, {"type": "subtitle", "time": 13947.83, "timestamp": "03:52:27", "text": "八。我也是。三号房间。我需要房间"}, {"type": "subtitle", "time": 13951.51, "timestamp": "03:52:31", "text": "我想，关键就在这里。等待。三号房间。在哪里"}, {"type": "subtitle", "time": 13953.55, "timestamp": "03:52:33", "text": "你是？我是"}, {"type": "subtitle", "time": 13959.03, "timestamp": "03:52:39", "text": "我就是这个。三。这个。好的。"}, {"type": "subtitle", "time": 13962.07, "timestamp": "03:52:42", "text": "是的。打开这个门进去。并开放"}, {"type": "subtitle", "time": 13965.59, "timestamp": "03:52:45", "text": "这扇门也是。"}, {"type": "subtitle", "time": 13971.349, "timestamp": "03:52:51", "text": "好了。好工作。干得好，查克。"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "呃，我需要找室友。在哪里？"}, {"type": "subtitle", "time": 13975.67, "timestamp": "03:52:55", "text": "蜘蛛在哪里？我听到蜘蛛的声音。好的，"}, {"type": "subtitle", "time": 13978.95, "timestamp": "03:52:58", "text": "这只蜘蛛会越来越烦人。我 我"}]
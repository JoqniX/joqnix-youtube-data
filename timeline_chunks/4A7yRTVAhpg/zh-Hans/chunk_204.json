[{"type": "subtitle", "time": 12240.07, "timestamp": "03:24:00", "text": "召唤"}, {"type": "subtitle", "time": 12242.07, "timestamp": "03:24:02", "text": "黄金召唤。好的。好的。到达"}, {"type": "subtitle", "time": 12244.469, "timestamp": "03:24:04", "text": "大厅。"}, {"type": "subtitle", "time": 12247.75, "timestamp": "03:24:07", "text": "大厅？我们喜欢的地方"}, {"type": "subtitle", "time": 12250.229, "timestamp": "03:24:10", "text": "医疗包全丢了。一秒钟。"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "让我把东西放上去。安娜就像"}, {"type": "subtitle", "time": 12253.15, "timestamp": "03:24:13", "text": "涵盖"}, {"type": "subtitle", "time": 12256.55, "timestamp": "03:24:16", "text": "入口。我该面临抛掷吗？还是她？"}, {"type": "subtitle", "time": 12259.67, "timestamp": "03:24:19", "text": "挡住我？她会用身体挡住你。"}, {"type": "subtitle", "time": 12269.19, "timestamp": "03:24:29", "text": "糟糕。你……"}, {"type": "subtitle", "time": 12272.79, "timestamp": "03:24:32", "text": "哦，也许吧。"}, {"type": "subtitle", "time": 12274.429, "timestamp": "03:24:34", "text": "好了，我快到了"}, {"type": "subtitle", "time": 12278.269, "timestamp": "03:24:38", "text": "完毕。我还会回来的。 1 2"}, {"type": "subtitle", "time": 12283.59, "timestamp": "03:24:43", "text": "3 4 5 6 7 8 好的，再加两瓶汽油。"}, {"type": "subtitle", "time": 12291.59, "timestamp": "03:24:51", "text": "未来。就带我漫无目的地走走吧。我"}, {"type": "subtitle", "time": 12293.03, "timestamp": "03:24:53", "text": "可以教你如何获得一个"}, {"type": "subtitle", "time": 12296.469, "timestamp": "03:24:56", "text": "山羊之类的。呃，大家按K键。"}, {"type": "subtitle", "time": 12298.389, "timestamp": "03:24:58", "text": "你有多少把钥匙？任何密钥"}]
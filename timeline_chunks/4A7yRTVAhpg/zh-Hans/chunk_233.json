[{"type": "subtitle", "time": 13981.03, "timestamp": "03:53:01", "text": "有一种感觉。是的，蜘蛛总是"}, {"type": "subtitle", "time": 13982.87, "timestamp": "03:53:02", "text": "真烦人。但没关系。是的，"}, {"type": "subtitle", "time": 13985.91, "timestamp": "03:53:05", "text": "他们跟我们开玩笑。是的。等待，"}, {"type": "subtitle", "time": 13987.75, "timestamp": "03:53:07", "text": "什么？你是什​​么意思？跟我来。我们"}, {"type": "subtitle", "time": 13990.95, "timestamp": "03:53:10", "text": "你有吗，乔？我更强壮了。你是"}, {"type": "subtitle", "time": 13993.189, "timestamp": "03:53:13", "text": "你比任何蜘蛛都强。"}, {"type": "subtitle", "time": 13995.189, "timestamp": "03:53:15", "text": "希望如此。"}, {"type": "subtitle", "time": 13998.07, "timestamp": "03:53:18", "text": "是的。你是一只大蜘蛛。是的。是的。"}, {"type": "subtitle", "time": 14002.55, "timestamp": "03:53:22", "text": "你比以前好多了。更好的蜘蛛。是的。"}, {"type": "subtitle", "time": 14004.469, "timestamp": "03:53:24", "text": "永远记住，乔。一切皆有可能"}, {"type": "subtitle", "time": 14006.229, "timestamp": "03:53:26", "text": "错了，你比我强。你比……更优秀"}, {"type": "subtitle", "time": 14008.15, "timestamp": "03:53:28", "text": "他们。"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "是的。"}, {"type": "subtitle", "time": 14012.99, "timestamp": "03:53:32", "text": "杰克，你比他们强多了。快点。"}, {"type": "subtitle", "time": 14022.229, "timestamp": "03:53:42", "text": "你好。"}, {"type": "subtitle", "time": 14024.389, "timestamp": "03:53:44", "text": "哦，你把鸡蛋放进金字塔里。"}, {"type": "subtitle", "time": 14027.429, "timestamp": "03:53:47", "text": "东西。是的。是的。你先把它洗干净。"}, {"type": "subtitle", "time": 14030.15, "timestamp": "03:53:50", "text": "尽管。哦。在池塘里。在"}, {"type": "subtitle", "time": 14032.15, "timestamp": "03:53:52", "text": "池塘。嗯。然后你把它放进去"}, {"type": "subtitle", "time": 14034.55, "timestamp": "03:53:54", "text": "各自的神社。"}, {"type": "subtitle", "time": 14036.469, "timestamp": "03:53:56", "text": "是的。如果你那样做，她就会开始"}]
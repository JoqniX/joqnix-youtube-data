[{"type": "subtitle", "time": 1562.549, "timestamp": "00:26:02", "text": "煮过头了。你"}, {"type": "subtitle", "time": 1565.51, "timestamp": "00:26:05", "text": "明白了。我们能搞定。"}, {"type": "subtitle", "time": 1569.35, "timestamp": "00:26:09", "text": "我们能搞定。但愿如此。"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "呃，暂时不要互动。好的。呃，是"}, {"type": "subtitle", "time": 1575.11, "timestamp": "00:26:15", "text": "好的。没关系。没关系。有"}, {"type": "subtitle", "time": 1579.7, "timestamp": "00:26:19", "text": "时间。一件稀有品，一件普通品。"}, {"type": "subtitle", "time": 1595.63, "timestamp": "00:26:35", "text": "[音乐]"}, {"type": "subtitle", "time": 1597.95, "timestamp": "00:26:37", "text": "嗯，干得好。"}, {"type": "subtitle", "time": 1601.39, "timestamp": "00:26:41", "text": "好的。呃，拿"}, {"type": "subtitle", "time": 1605.59, "timestamp": "00:26:45", "text": "这。我会把这个拿去，然后去做那件事。感谢"}, {"type": "subtitle", "time": 1607.3, "timestamp": "00:26:47", "text": "你把盘子拿走。"}, {"type": "subtitle", "time": 1618.59, "timestamp": "00:26:58", "text": "哦，我会卖掉"}]
[{"type": "subtitle", "time": 1442.23, "timestamp": "00:24:02", "text": "给你，然后拿走。你什么时候会收到"}, {"type": "subtitle", "time": 1445.029, "timestamp": "00:24:05", "text": "餐桌？"}, {"type": "subtitle", "time": 1448.31, "timestamp": "00:24:08", "text": "糟糕。等等，上面好像写着炉灶之类的东西。"}, {"type": "subtitle", "time": 1451.39, "timestamp": "00:24:11", "text": "硬币。所以，这是另一个例子。"}, {"type": "subtitle", "time": 1455.35, "timestamp": "00:24:15", "text": "嗯，我们不需要买它。我们需要"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "不过，这一点……没关系。我会把它保留下来。"}, {"type": "subtitle", "time": 1461.83, "timestamp": "00:24:21", "text": "暂时就这些内阁成员吧。我们不需要"}, {"type": "subtitle", "time": 1464.029, "timestamp": "00:24:24", "text": "这。我们需要额外资金"}, {"type": "subtitle", "time": 1467.75, "timestamp": "00:24:27", "text": "表格。糟糕。"}, {"type": "subtitle", "time": 1470.909, "timestamp": "00:24:30", "text": "没关系。全部"}, {"type": "subtitle", "time": 1482.59, "timestamp": "00:24:42", "text": "锅。为什么这扇门这么……"}, {"type": "subtitle", "time": 1486.63, "timestamp": "00:24:46", "text": "慢的？我不知道。"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "但我们完蛋了。"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "我认为我们没有足够的资源。"}, {"type": "subtitle", "time": 1493.87, "timestamp": "00:24:53", "text": "盘子。哦"}, {"type": "subtitle", "time": 1497.269, "timestamp": "00:24:57", "text": "不，我们没有足够的航班。它是"}]
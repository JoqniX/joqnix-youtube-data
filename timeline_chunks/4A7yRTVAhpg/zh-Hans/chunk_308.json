[{"type": "subtitle", "time": 18504.23, "timestamp": "05:08:24", "text": "好久不见了。你最近怎么样？"}, {"type": "subtitle", "time": 18513.75, "timestamp": "05:08:33", "text": "你好。很高兴听到这个消息。"}, {"type": "subtitle", "time": 18515.91, "timestamp": "05:08:35", "text": "是啊，我受够了。我正在给我的电脑打分。"}, {"type": "subtitle", "time": 18518.55, "timestamp": "05:08:38", "text": "现在。我可以做任何我想做的事。是的。"}, {"type": "subtitle", "time": 18521.67, "timestamp": "05:08:41", "text": "我们走吧。等等，你买的是哪款CPU？"}, {"type": "subtitle", "time": 18525.83, "timestamp": "05:08:45", "text": "呃，5600，对吧？等等，是哪个来着？"}, {"type": "subtitle", "time": 18537.75, "timestamp": "05:08:57", "text": "56岁不错。我有38和Rex。我是"}, {"type": "subtitle", "time": 18539.83, "timestamp": "05:08:59", "text": "第三代。你现在在第五页"}]
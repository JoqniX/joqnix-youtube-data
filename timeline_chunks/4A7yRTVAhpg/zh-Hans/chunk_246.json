[{"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "VC。那些人仍然下落不明。是的，"}, {"type": "subtitle", "time": 14766.55, "timestamp": "04:06:06", "text": "他们都在……我的天哪，每个人都在VC。"}, {"type": "subtitle", "time": 14775.83, "timestamp": "04:06:15", "text": "第二名。我的天啊。是的，他们是"}, {"type": "subtitle", "time": 14778.79, "timestamp": "04:06:18", "text": "都在那里。我的天，锤子影业的英雄们"}, {"type": "subtitle", "time": 14781.83, "timestamp": "04:06:21", "text": "手表。该死。"}, {"type": "subtitle", "time": 14783.91, "timestamp": "04:06:23", "text": "我知道。等等，为什么大家都在玩"}, {"type": "subtitle", "time": 14786.229, "timestamp": "04:06:26", "text": "锤子手表？好吗？哦，是的。"}, {"type": "subtitle", "time": 14788.07, "timestamp": "04:06:28", "text": "好的。非常有趣。好吧，所以呢？"}, {"type": "subtitle", "time": 14791.99, "timestamp": "04:06:31", "text": "事情是这样的，呃，Red好像把它买下来了。"}, {"type": "subtitle", "time": 14795.269, "timestamp": "04:06:35", "text": "呃，他送了我一本。"}, {"type": "subtitle", "time": 14797.429, "timestamp": "04:06:37", "text": "呃，然后我们俩都打算……"}, {"type": "subtitle", "time": 14799.269, "timestamp": "04:06:39", "text": "就像在 VC 里和 Mura 一起一样，我们当时"}, {"type": "subtitle", "time": 14802.469, "timestamp": "04:06:42", "text": "就像，哦，我们来玩吧，呃，所以就像"}, {"type": "subtitle", "time": 14805.83, "timestamp": "04:06:45", "text": "我也给穆拉买了一本。"}, {"type": "subtitle", "time": 14808.63, "timestamp": "04:06:48", "text": "之后你就知道V3在玩游戏了。"}, {"type": "subtitle", "time": 14811.269, "timestamp": "04:06:51", "text": "然后肖卡看到了我们玩，所以我"}, {"type": "subtitle", "time": 14814.95, "timestamp": "04:06:54", "text": "我给Shoka买了一本，我们当时就在里面"}, {"type": "subtitle", "time": 14818.15, "timestamp": "04:06:58", "text": "VC 和 Vic，我想是 Vic 和 Fuji。所以，我们"}]
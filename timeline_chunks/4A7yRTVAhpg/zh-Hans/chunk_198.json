[{"type": "subtitle", "time": 11880.63, "timestamp": "03:18:00", "text": "在阁楼的另一边。比如……"}, {"type": "subtitle", "time": 11882.71, "timestamp": "03:18:02", "text": "如果你上到阁楼，就去……"}, {"type": "subtitle", "time": 11887.19, "timestamp": "03:18:07", "text": "另一方面，你会发现安娜就像"}, {"type": "subtitle", "time": 11891.71, "timestamp": "03:18:11", "text": "令人毛骨悚然的南瓜发出声响。我的天啊。"}, {"type": "subtitle", "time": 11894.229, "timestamp": "03:18:14", "text": "像安娜的另一面一样，这样你就不会"}, {"type": "subtitle", "time": 11898.07, "timestamp": "03:18:18", "text": "需要她。是的。她就在我附近。我"}, {"type": "subtitle", "time": 11900.309, "timestamp": "03:18:20", "text": "我看清了她的脸。"}, {"type": "subtitle", "time": 11903.67, "timestamp": "03:18:23", "text": "你看，这里有个东西。"}, {"type": "subtitle", "time": 11906.229, "timestamp": "03:18:26", "text": "你会带它去哪里"}, {"type": "subtitle", "time": 11909.349, "timestamp": "03:18:29", "text": "呃，在上面？在其顶部，最上面还有一个"}, {"type": "subtitle", "time": 11912.389, "timestamp": "03:18:32", "text": "汽油之类的东西。我们可以得到它。我需要"}, {"type": "subtitle", "time": 11915.75, "timestamp": "03:18:35", "text": "就像我要解锁一样"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "一扇门。哦，乔，你喜欢读这篇文章吗？"}, {"type": "subtitle", "time": 11920.79, "timestamp": "03:18:40", "text": "法律？"}, {"type": "subtitle", "time": 11923.51, "timestamp": "03:18:43", "text": "哪一个？呃，我想上面说的是“我已全部阅读”。"}, {"type": "subtitle", "time": 11926.229, "timestamp": "03:18:46", "text": "但法律就是如此。三分之二。哦，"}, {"type": "subtitle", "time": 11929.269, "timestamp": "03:18:49", "text": "好的。好工作。哦，不错。好工作。我是"}, {"type": "subtitle", "time": 11931.19, "timestamp": "03:18:51", "text": "为你感到骄傲。我认为我们已经解锁了。"}, {"type": "subtitle", "time": 11933.349, "timestamp": "03:18:53", "text": "所有房间。维克，你想……"}, {"type": "subtitle", "time": 11937.229, "timestamp": "03:18:57", "text": "教乔克如何捉山羊？"}]
[{"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "快的。好的。嘿，莫。我们打破了"}, {"type": "subtitle", "time": 13565.87, "timestamp": "03:46:05", "text": "住进一家客栈。可以说我们有"}, {"type": "subtitle", "time": 13570.95, "timestamp": "03:46:10", "text": "被破损到破损。"}, {"type": "subtitle", "time": 13576.469, "timestamp": "03:46:16", "text": "不错。不错。一切准备就绪。"}, {"type": "subtitle", "time": 13579.67, "timestamp": "03:46:19", "text": "我已经建好了最后一个神龛。爸爸妈妈"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "他试图干预，所以我不得不停止。"}, {"type": "subtitle", "time": 13583.11, "timestamp": "03:46:23", "text": "他们。我不能让任何事阻碍我。"}, {"type": "subtitle", "time": 13586.07, "timestamp": "03:46:26", "text": "我和艾泽尔。他快到了。我"}, {"type": "subtitle", "time": 13588.389, "timestamp": "03:46:28", "text": "能感觉到他。其他人可能失败了，"}, {"type": "subtitle", "time": 13589.91, "timestamp": "03:46:29", "text": "但这一次，仪式开始了。"}, {"type": "subtitle", "time": 13592.87, "timestamp": "03:46:32", "text": "我自己翻译了旧试卷。"}, {"type": "subtitle", "time": 13595.269, "timestamp": "03:46:35", "text": "准确的。此外，我知道我拥有"}, {"type": "subtitle", "time": 13598.469, "timestamp": "03:46:38", "text": "有足够的力量控制它。哇。我认为在"}, {"type": "subtitle", "time": 13600.309, "timestamp": "03:46:40", "text": "你只需要停止召唤"}, {"type": "subtitle", "time": 13602.07, "timestamp": "03:46:42", "text": "恶魔啊，老兄。就像这位朋友一样"}, {"type": "subtitle", "time": 13604.15, "timestamp": "03:46:44", "text": "一群人一直在尝试"}, {"type": "subtitle", "time": 13607.59, "timestamp": "03:46:47", "text": "做同样的蠢事，然后去死。"}, {"type": "subtitle", "time": 13610.71, "timestamp": "03:46:50", "text": "是的，没问题。"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "真诡异。在某个时候"}, {"type": "subtitle", "time": 13614.55, "timestamp": "03:46:54", "text": "重点在于你要看的是什么。"}, {"type": "subtitle", "time": 13617.67, "timestamp": "03:46:57", "text": "事情发生了就放弃了。"}]
[{"type": "subtitle", "time": 1920.23, "timestamp": "00:32:00", "text": "需要炊具，对吧？"}, {"type": "subtitle", "time": 1923.59, "timestamp": "00:32:03", "text": "呃，如果你还需要一个，我们可以"}, {"type": "subtitle", "time": 1927.029, "timestamp": "00:32:07", "text": "升级它。我们可以升级它吗？是的，我们"}, {"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "可以升级它，而无需安装另一个。"}, {"type": "subtitle", "time": 1935.59, "timestamp": "00:32:15", "text": "升级后速度会更快。"}, {"type": "subtitle", "time": 1939.149, "timestamp": "00:32:19", "text": "哦，是的。这个要60美元。好吧，绝不"}, {"type": "subtitle", "time": 1942.71, "timestamp": "00:32:22", "text": "头脑。但是我们可以吗？哦，我有点想"}, {"type": "subtitle", "time": 1945.43, "timestamp": "00:32:25", "text": "更多盘子。更多的盘子"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": "更好的。"}, {"type": "subtitle", "time": 1951.87, "timestamp": "00:32:31", "text": "剩余的袋子。那是什么？我没有"}, {"type": "subtitle", "time": 1955.35, "timestamp": "00:32:35", "text": "主意。你知道吗？咱们去炉灶那儿吧。"}, {"type": "subtitle", "time": 1965.549, "timestamp": "00:32:45", "text": "哦，等等。这是升级版吗？哦，那个"}, {"type": "subtitle", "time": 1973.269, "timestamp": "00:32:53", "text": "我们可以把它放在某个地方吗？"}, {"type": "subtitle", "time": 1974.59, "timestamp": "00:32:54", "text": "它将"}, {"type": "subtitle", "time": 1977.509, "timestamp": "00:32:57", "text": "消失一次。"}]
[{"type": "subtitle", "time": 11586.95, "timestamp": "03:13:06", "text": "快点。明白了。好的。好的。我们是什么"}, {"type": "subtitle", "time": 11588.95, "timestamp": "03:13:08", "text": "乔，我会这么做的，因为如果我们只是"}, {"type": "subtitle", "time": 11590.79, "timestamp": "03:13:10", "text": "现在就进去，我们可能都会"}, {"type": "subtitle", "time": 11592.95, "timestamp": "03:13:12", "text": "死。我们接下来要做的就是……"}, {"type": "subtitle", "time": 11595.67, "timestamp": "03:13:15", "text": "正在寻找钥匙。好的。我们要走了"}, {"type": "subtitle", "time": 11599.349, "timestamp": "03:13:19", "text": "解锁整栋房子。打开尽可能多的"}, {"type": "subtitle", "time": 11601.99, "timestamp": "03:13:21", "text": "尽可能多地开门。"}, {"type": "subtitle", "time": 11605.11, "timestamp": "03:13:25", "text": "好的。是的。你寻找钥匙，然后你"}, {"type": "subtitle", "time": 11607.91, "timestamp": "03:13:27", "text": "打开大门。我不应该在哪里？"}, {"type": "subtitle", "time": 11610.309, "timestamp": "03:13:30", "text": "再来一次？"}, {"type": "subtitle", "time": 11613.19, "timestamp": "03:13:33", "text": "呃，你可以去任何地方。"}, {"type": "subtitle", "time": 11615.59, "timestamp": "03:13:35", "text": "那么，狩猎活动什么时候开始呢？"}, {"type": "subtitle", "time": 11618.309, "timestamp": "03:13:38", "text": "她来杀我吗？呃，当我们"}, {"type": "subtitle", "time": 11622.469, "timestamp": "03:13:42", "text": "开始宰杀山羊。好的。呃"}, {"type": "subtitle", "time": 11624.95, "timestamp": "03:13:44", "text": "好的。好的。让我们把医疗包堆放在一起"}, {"type": "subtitle", "time": 11628.07, "timestamp": "03:13:48", "text": "大厅。"}, {"type": "subtitle", "time": 11630.309, "timestamp": "03:13:50", "text": "好的。可以做到。让我们保持"}, {"type": "subtitle", "time": 11632.71, "timestamp": "03:13:52", "text": "大厅里有急救箱，所以会很方便。"}, {"type": "subtitle", "time": 11634.269, "timestamp": "03:13:54", "text": "更容易喜欢"}, {"type": "subtitle", "time": 11638.15, "timestamp": "03:13:58", "text": "得到。哦，大厅在哪里？这个"}]
[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "呃，可能不会。可能不会。不，在"}, {"type": "subtitle", "time": 243.75, "timestamp": "00:04:03", "text": "至少有一个人可以节省电力。"}, {"type": "subtitle", "time": 245.99, "timestamp": "00:04:05", "text": "这是进步，对吧？我的意思是，我们还没有"}, {"type": "subtitle", "time": 247.75, "timestamp": "00:04:07", "text": "基地还没建好。除此之外，"}, {"type": "subtitle", "time": 249.75, "timestamp": "00:04:09", "text": "我们还没走到那一步呢。"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "是的，我们进展不大。"}, {"type": "subtitle", "time": 253.71, "timestamp": "00:04:13", "text": "任何地方。嗯，我是主持人。哦"}, {"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "翻转。一场破坏游戏是什么样的？"}, {"type": "subtitle", "time": 259.509, "timestamp": "00:04:19", "text": "走开，兄弟。主持人呢？该死的。"}, {"type": "chat", "time": 261.505, "timestamp": "00:04:21", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "please wait for a bit, we'll start the collab in a bit"}, {"type": "subtitle", "time": 263.189, "timestamp": "00:04:23", "text": "你在干什么？杀了她。"}, {"type": "subtitle", "time": 266.23, "timestamp": "00:04:26", "text": "明显地。如果我离开，"}, {"type": "subtitle", "time": 269.189, "timestamp": "00:04:29", "text": "它不见了。"}, {"type": "subtitle", "time": 277.99, "timestamp": "00:04:37", "text": "全部回复。发生了什么？"}, {"type": "subtitle", "time": 279.909, "timestamp": "00:04:39", "text": "哦，不。"}, {"type": "subtitle", "time": 282.95, "timestamp": "00:04:42", "text": "我们正在制作一个新的。"}, {"type": "subtitle", "time": 285.189, "timestamp": "00:04:45", "text": "我的电突然停了，"}, {"type": "subtitle", "time": 292.95, "timestamp": "00:04:52", "text": "没关系。接通电源。实际上"}, {"type": "subtitle", "time": 296.469, "timestamp": "00:04:56", "text": "所以我至少会先划筏子再……"}, {"type": "subtitle", "time": 299.27, "timestamp": "00:04:59", "text": "离开。我需要吗？我不认为你"}]
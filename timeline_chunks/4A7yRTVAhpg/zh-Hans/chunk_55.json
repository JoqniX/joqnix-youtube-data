[{"type": "subtitle", "time": 3307.67, "timestamp": "00:55:07", "text": "你做事真有条理。真好。你"}, {"type": "subtitle", "time": 3310.27, "timestamp": "00:55:10", "text": "只是拥有这么多"}, {"type": "subtitle", "time": 3312.349, "timestamp": "00:55:12", "text": "强迫症。"}, {"type": "subtitle", "time": 3315.67, "timestamp": "00:55:15", "text": "一群烂人。"}, {"type": "subtitle", "time": 3324.549, "timestamp": "00:55:24", "text": "[音乐]"}, {"type": "subtitle", "time": 3331.39, "timestamp": "00:55:31", "text": "他们想要番茄吗？是的，他们想要"}, {"type": "subtitle", "time": 3336.03, "timestamp": "00:55:36", "text": "番茄。一如既往，人们想要"}, {"type": "subtitle", "time": 3351.68, "timestamp": "00:55:51", "text": "番茄。让我们"}]
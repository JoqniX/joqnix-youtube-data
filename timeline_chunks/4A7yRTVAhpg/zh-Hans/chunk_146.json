[{"type": "subtitle", "time": 8764.19, "timestamp": "02:26:04", "text": "这一轮你想玩多久？"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "[音乐]"}, {"type": "subtitle", "time": 8779.429, "timestamp": "02:26:19", "text": "我认为一旦我们崩溃，就像我们失败了一样"}, {"type": "subtitle", "time": 8781.67, "timestamp": "02:26:21", "text": "其中一天，我们无法重新开始。"}, {"type": "subtitle", "time": 8783.15, "timestamp": "02:26:23", "text": "是的"}, {"type": "subtitle", "time": 8787.429, "timestamp": "02:26:27", "text": "我们能"}, {"type": "subtitle", "time": 8788.91, "timestamp": "02:26:28", "text": "我们可以"}, {"type": "subtitle", "time": 8791.389, "timestamp": "02:26:31", "text": "完美"}]
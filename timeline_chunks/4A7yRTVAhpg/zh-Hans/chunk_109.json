[{"type": "subtitle", "time": 6564.79, "timestamp": "01:49:24", "text": "咖啡。哦，他们需要糖。他们需要"}, {"type": "subtitle", "time": 6574.709, "timestamp": "01:49:34", "text": "好的。你好吗？"}, {"type": "subtitle", "time": 6577.43, "timestamp": "01:49:37", "text": "为什么有这么多人？是的，"}, {"type": "subtitle", "time": 6582.149, "timestamp": "01:49:42", "text": "他们被困住了。我的天啊。科皮特。更多的"}, {"type": "subtitle", "time": 6584.79, "timestamp": "01:49:44", "text": "座舱。"}, {"type": "subtitle", "time": 6586.47, "timestamp": "01:49:46", "text": "我认为我们需要把它弄到一处。"}, {"type": "subtitle", "time": 6590.95, "timestamp": "01:49:50", "text": "先从背面开始。是的。"}, {"type": "subtitle", "time": 6594.229, "timestamp": "01:49:54", "text": "厨房里的那两个人可以等等。"}, {"type": "subtitle", "time": 6595.49, "timestamp": "01:49:55", "text": "是的。"}]
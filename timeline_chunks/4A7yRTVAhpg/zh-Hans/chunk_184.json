[{"type": "subtitle", "time": 11042.83, "timestamp": "03:04:02", "text": "为什么这款游戏有这么多动作"}, {"type": "subtitle", "time": 11045.19, "timestamp": "03:04:05", "text": "福利？这意味着我们正在运行，"}, {"type": "subtitle", "time": 11046.79, "timestamp": "03:04:06", "text": "逃脱。"}, {"type": "subtitle", "time": 11049.19, "timestamp": "03:04:09", "text": "是的。我的意思是，我们正在逃离……"}, {"type": "subtitle", "time": 11053.03, "timestamp": "03:04:13", "text": "恶魔。是的。哦好的。我会，我会做的"}, {"type": "subtitle", "time": 11055.429, "timestamp": "03:04:15", "text": "我没钱。"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "没关系。你会得到，你会得到"}, {"type": "subtitle", "time": 11059.269, "timestamp": "03:04:19", "text": "当你喜欢玩耍的时候。你知道吗？我 我"}, {"type": "subtitle", "time": 11061.59, "timestamp": "03:04:21", "text": "将在四月份。我将，我将成为"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "四月。我将成为那个老人。"}, {"type": "subtitle", "time": 11068.55, "timestamp": "03:04:28", "text": "好了，我们开始揉你的屁股。好的，因为"}, {"type": "subtitle", "time": 11070.63, "timestamp": "03:04:30", "text": "由于雅克是新手，我们先……"}, {"type": "subtitle", "time": 11073.83, "timestamp": "03:04:33", "text": "先从农舍开始。"}, {"type": "subtitle", "time": 11076.429, "timestamp": "03:04:36", "text": "好的。美国"}, {"type": "subtitle", "time": 11079.429, "timestamp": "03:04:39", "text": "2006年。加利福尼亚州的郊狼谷是"}, {"type": "subtitle", "time": 11082.71, "timestamp": "03:04:42", "text": "在夏日烈阳下炙烤。"}, {"type": "subtitle", "time": 11085.19, "timestamp": "03:04:45", "text": "哦，我的天啊。"}, {"type": "subtitle", "time": 11089.03, "timestamp": "03:04:49", "text": "恶魔首领。扎齐尔的守望者"}, {"type": "subtitle", "time": 11094.55, "timestamp": "03:04:54", "text": "[音乐]"}, {"type": "subtitle", "time": 11096.63, "timestamp": "03:04:56", "text": "安娜对这个想法着迷了"}]
[{"type": "subtitle", "time": 15120.91, "timestamp": "04:12:00", "text": "边？哦，他们还在那里。是，是"}, {"type": "subtitle", "time": 15123.389, "timestamp": "04:12:03", "text": "美好的。好像没人看似的。"}, {"type": "subtitle", "time": 15131.349, "timestamp": "04:12:11", "text": "是的。我不知道。耶稣基督。迅速"}, {"type": "subtitle", "time": 15134.229, "timestamp": "04:12:14", "text": "玩。上帝。哦，你想那样做。"}, {"type": "subtitle", "time": 15137.59, "timestamp": "04:12:17", "text": "匹配？哦，是的。哦，团队死亡竞赛。"}, {"type": "subtitle", "time": 15139.59, "timestamp": "04:12:19", "text": "你想……哦，是的。死对头或死队"}, {"type": "subtitle", "time": 15141.51, "timestamp": "04:12:21", "text": "任何事物。我们什么都行。团队"}, {"type": "subtitle", "time": 15142.99, "timestamp": "04:12:22", "text": "死亡竞赛。团队"}, {"type": "subtitle", "time": 15145.67, "timestamp": "04:12:25", "text": "死亡竞赛。这很有趣。此外，"}, {"type": "subtitle", "time": 15147.429, "timestamp": "04:12:27", "text": "你在这里能取得进步。是的，"}, {"type": "subtitle", "time": 15149.83, "timestamp": "04:12:29", "text": "团队死亡竞赛模式很棒。很多"}, {"type": "subtitle", "time": 15151.429, "timestamp": "04:12:31", "text": "我认识的那些不再玩游戏的人，我喜欢他们。"}, {"type": "subtitle", "time": 15158.469, "timestamp": "04:12:38", "text": "是的，团队防守很好。我不知道"}]
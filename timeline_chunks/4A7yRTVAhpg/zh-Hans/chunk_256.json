[{"type": "subtitle", "time": 15361.83, "timestamp": "04:16:01", "text": "哦，我的天啊。那几乎"}, {"type": "subtitle", "time": 15365.83, "timestamp": "04:16:05", "text": "死的。我的天哪。哎哟。我的天啊。我太"}, {"type": "subtitle", "time": 15369.349, "timestamp": "04:16:09", "text": "生锈了。我走了。我太生疏了。"}, {"type": "subtitle", "time": 15386.149, "timestamp": "04:16:26", "text": "你知道你是怎么停止玩Rusty的。"}, {"type": "subtitle", "time": 15395.91, "timestamp": "04:16:35", "text": "重新装弹。"}, {"type": "subtitle", "time": 15400.11, "timestamp": "04:16:40", "text": "距离舞台切换还有10秒。必须"}, {"type": "subtitle", "time": 15403.75, "timestamp": "04:16:43", "text": "去。啊，"}, {"type": "subtitle", "time": 15406.07, "timestamp": "04:16:46", "text": "我得走了。"}, {"type": "subtitle", "time": 15418.55, "timestamp": "04:16:58", "text": "我的天啊。我觉得我错过了“哦”"}]
[{"type": "subtitle", "time": 3842.789, "timestamp": "01:04:02", "text": "还是别的什么？你喝，你喝这么多"}, {"type": "subtitle", "time": 3845.67, "timestamp": "01:04:05", "text": "很多事情都得到了控制。你的能力范围是多少？"}, {"type": "subtitle", "time": 3850.15, "timestamp": "01:04:10", "text": "不。呃，所以中国新年是那一年"}, {"type": "subtitle", "time": 3852.63, "timestamp": "01:04:12", "text": "就像是每个人都会参加的那个月份一样。"}, {"type": "subtitle", "time": 3855.51, "timestamp": "01:04:15", "text": "喝醉了。每个家庭成员"}, {"type": "subtitle", "time": 3857.67, "timestamp": "01:04:17", "text": "他们会说：“来喝一杯。你……”"}, {"type": "subtitle", "time": 3860.589, "timestamp": "01:04:20", "text": "很好。因为我去年刚满18岁。"}, {"type": "subtitle", "time": 3863.829, "timestamp": "01:04:23", "text": "年。不，是去年11月的事。"}, {"type": "subtitle", "time": 3866.069, "timestamp": "01:04:26", "text": "所以，今年春节，"}, {"type": "subtitle", "time": 3868.63, "timestamp": "01:04:28", "text": "他们会说：“哦，你最好去喝酒。”"}, {"type": "subtitle", "time": 3872.15, "timestamp": "01:04:32", "text": "“现在。”然后他们开始给我倒杯子。"}, {"type": "subtitle", "time": 3874.47, "timestamp": "01:04:34", "text": "一杯接一杯，尽管我说"}, {"type": "subtitle", "time": 3879.27, "timestamp": "01:04:39", "text": "不。我当时就想，“哦，糟了。好吧。”"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "太糟糕了，太令人难过了。我们没有"}, {"type": "subtitle", "time": 3885.029, "timestamp": "01:04:45", "text": "选择。”于是，我发现我可以"}, {"type": "chat", "time": 3886.287, "timestamp": "01:04:46", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "."}, {"type": "subtitle", "time": 3889.75, "timestamp": "01:04:49", "text": "我酒量很好。啊，"}, {"type": "subtitle", "time": 3893.19, "timestamp": "01:04:53", "text": "是的。哦，黑咖啡、披萨，或者"}, {"type": "subtitle", "time": 3895.67, "timestamp": "01:04:55", "text": "沙拉。"}, {"type": "subtitle", "time": 3899.029, "timestamp": "01:04:59", "text": "呃，我们试试咖啡吧？感觉"}]
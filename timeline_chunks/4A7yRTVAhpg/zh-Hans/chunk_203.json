[{"type": "subtitle", "time": 12181.59, "timestamp": "03:23:01", "text": "是的。我们看看能做多少。我是"}, {"type": "subtitle", "time": 12184.15, "timestamp": "03:23:04", "text": "很累。既然西摩不会……"}, {"type": "subtitle", "time": 12185.51, "timestamp": "03:23:05", "text": "加入我们，看看我们能走多远。"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "呃，说实话，我感觉到了动静。"}, {"type": "subtitle", "time": 12224.79, "timestamp": "03:23:44", "text": "[音乐]"}, {"type": "subtitle", "time": 12226.71, "timestamp": "03:23:46", "text": "好的，我想我应该没事了。我应该"}, {"type": "subtitle", "time": 12228.55, "timestamp": "03:23:48", "text": "没事的。哦，请稍等一下。我会"}, {"type": "subtitle", "time": 12230.229, "timestamp": "03:23:50", "text": "而不是四处闲逛"}, {"type": "subtitle", "time": 12233.19, "timestamp": "03:23:53", "text": "漫无目的地，我也可以教乔克一些关于"}, {"type": "subtitle", "time": 12235.229, "timestamp": "03:23:55", "text": "这。乔克，过来"}, {"type": "subtitle", "time": 12238.389, "timestamp": "03:23:58", "text": "楼下。我在楼下，靠近神像。"}]
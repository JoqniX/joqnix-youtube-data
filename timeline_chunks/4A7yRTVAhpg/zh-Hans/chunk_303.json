[{"type": "subtitle", "time": 18182.628, "timestamp": "05:03:02", "text": "印度香饭。巴斯马蒂米。是的。是的。好的，那就这样吧。"}, {"type": "subtitle", "time": 18190.15, "timestamp": "05:03:10", "text": "印度香饭。嗯。总之，我会带上我的"}, {"type": "subtitle", "time": 18192.628, "timestamp": "05:03:12", "text": "现在就走。如果我能一直这样下去就好了"}, {"type": "subtitle", "time": 18194.708, "timestamp": "05:03:14", "text": "整天这样说话，呃……"}, {"type": "subtitle", "time": 18198.07, "timestamp": "05:03:18", "text": "是啊，我就要死了。再见。祝你一切顺利"}, {"type": "subtitle", "time": 18200.708, "timestamp": "05:03:20", "text": "一。祝大家一切顺利。有"}, {"type": "subtitle", "time": 18202.07, "timestamp": "05:03:22", "text": "不错。再见。祝你一切顺利。我们开始吧"}, {"type": "subtitle", "time": 18205.91, "timestamp": "05:03:25", "text": "得到它。再见。再见，克洛诺斯。再见，克洛诺斯。"}, {"type": "subtitle", "time": 18207.628, "timestamp": "05:03:27", "text": "再见，"}, {"type": "subtitle", "time": 18211.03, "timestamp": "05:03:31", "text": "铝。 Vu来过这里。"}, {"type": "subtitle", "time": 18212.83, "timestamp": "05:03:32", "text": "Vu 是"}, {"type": "subtitle", "time": 18215.27, "timestamp": "05:03:35", "text": "这里。各位再见。祝你一切顺利"}, {"type": "subtitle", "time": 18217.83, "timestamp": "05:03:37", "text": "一。我会带上我的豹子。再见。你好。"}, {"type": "subtitle", "time": 18237.72, "timestamp": "05:03:57", "text": "再见。为了"}]
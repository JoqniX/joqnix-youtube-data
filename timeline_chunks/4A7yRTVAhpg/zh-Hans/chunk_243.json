[{"type": "subtitle", "time": 14583.67, "timestamp": "04:03:03", "text": "玩吗？一对情侣就像一场比赛"}, {"type": "subtitle", "time": 14584.95, "timestamp": "04:03:04", "text": "或者别的什么。你只需要结束这一切"}, {"type": "subtitle", "time": 14587.03, "timestamp": "04:03:07", "text": "溪流。"}, {"type": "subtitle", "time": 14589.429, "timestamp": "04:03:09", "text": "我当时在想，我该如何结束这件事呢？"}, {"type": "subtitle", "time": 14592.469, "timestamp": "04:03:12", "text": "开启连胜。不，不要这样做"}, {"type": "subtitle", "time": 14594.79, "timestamp": "04:03:14", "text": "那。好的。好的。好的。知道了。一个值"}, {"type": "subtitle", "time": 14596.469, "timestamp": "04:03:16", "text": "游戏。好的。知道了。是的，我们可以做到"}, {"type": "subtitle", "time": 14600.469, "timestamp": "04:03:20", "text": "那。是的，我们就是喜欢虫子。"}, {"type": "subtitle", "time": 14603.83, "timestamp": "04:03:23", "text": "吸毒的兔子。哈哈。什么？什么？"}, {"type": "subtitle", "time": 14608.15, "timestamp": "04:03:28", "text": "Chrono 已经启动了。搞什么鬼？什么？"}, {"type": "subtitle", "time": 14610.229, "timestamp": "04:03:30", "text": "让你的兔八哥嗑药吧，老兄。"}, {"type": "subtitle", "time": 14614.79, "timestamp": "04:03:34", "text": "快点。哦好的。我想，我想"}, {"type": "subtitle", "time": 14617.99, "timestamp": "04:03:37", "text": "改成 Valant。"}, {"type": "subtitle", "time": 14621.189, "timestamp": "04:03:41", "text": "你好。 Mythic在此提供精神支持。"}, {"type": "subtitle", "time": 14624.15, "timestamp": "04:03:44", "text": "她不仅仅是一位教练。"}, {"type": "subtitle", "time": 14638.95, "timestamp": "04:03:58", "text": "[音乐]"}]
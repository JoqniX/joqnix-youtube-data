[{"type": "subtitle", "time": 17401.07, "timestamp": "04:50:01", "text": "例如，如何制作预告片。"}, {"type": "subtitle", "time": 17405.43, "timestamp": "04:50:05", "text": "啊，是的，视频剪辑方面的事情一直是"}, {"type": "subtitle", "time": 17407.51, "timestamp": "04:50:07", "text": "我还是很好奇你是怎么做到的。我只"}, {"type": "subtitle", "time": 17409.15, "timestamp": "04:50:09", "text": "基本知识"}, {"type": "subtitle", "time": 17413.35, "timestamp": "04:50:13", "text": "编辑、剪切、修剪。就是这样。"}, {"type": "subtitle", "time": 17420.15, "timestamp": "04:50:20", "text": "它。总之，这就是我问你的原因。"}, {"type": "subtitle", "time": 17422.39, "timestamp": "04:50:22", "text": "就像你想让我帮你编辑一些东西一样"}, {"type": "subtitle", "time": 17424.868, "timestamp": "04:50:24", "text": "即使他们像基本款或"}, {"type": "subtitle", "time": 17427.03, "timestamp": "04:50:27", "text": "某物。"}, {"type": "subtitle", "time": 17430.39, "timestamp": "04:50:30", "text": "我不想让你觉得或者"}, {"type": "subtitle", "time": 17436.788, "timestamp": "04:50:36", "text": "“不，如果你真的感到内疚，你可以……”"}, {"type": "subtitle", "time": 17438.55, "timestamp": "04:50:38", "text": "甚至可以用它来付我钱。比如，这不是一个"}, {"type": "subtitle", "time": 17443.19, "timestamp": "04:50:43", "text": "没什么大不了的。如果你喜欢的话"}, {"type": "subtitle", "time": 17445.51, "timestamp": "04:50:45", "text": "比如，“嘿，维克，我想画你。”"}, {"type": "subtitle", "time": 17448.868, "timestamp": "04:50:48", "text": "我会做点什么，我会很喜欢的。"}, {"type": "subtitle", "time": 17451.35, "timestamp": "04:50:51", "text": "但你猜怎么着？如果我只是喜欢抓取"}, {"type": "subtitle", "time": 17453.19, "timestamp": "04:50:53", "text": "免费接受你的画作，我会感到很抱歉。"}, {"type": "subtitle", "time": 17455.11, "timestamp": "04:50:55", "text": "我还是直接付钱给你吧。” 我会"}, {"type": "subtitle", "time": 17457.91, "timestamp": "04:50:57", "text": "不再有内疚感了。好吧，我付了钱"}, {"type": "subtitle", "time": 17459.47, "timestamp": "04:50:59", "text": "他。我付钱给他了。"}]
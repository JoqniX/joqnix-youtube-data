[{"type": "subtitle", "time": 12542.229, "timestamp": "03:29:02", "text": "安娜来了，我们用紫外线……"}, {"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "我们会没事的。好的。哦，她来了。"}, {"type": "subtitle", "time": 12547.349, "timestamp": "03:29:07", "text": "她来了。她来了。哦，不。"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "好的，没问题。没关系。没关系。"}, {"type": "subtitle", "time": 12552.76, "timestamp": "03:29:12", "text": "没关系。没关系。 你跑。"}, {"type": "subtitle", "time": 12555.52, "timestamp": "03:29:15", "text": "你跑。 我被困住了。好的。"}, {"type": "subtitle", "time": 12559.92, "timestamp": "03:29:19", "text": "我被困住了。好的。 你是不是疯了？什么？它是"}, {"type": "subtitle", "time": 12562.72, "timestamp": "03:29:22", "text": "你是不是疯了？什么？它是 好的。没关系。没关系。什么？"}, {"type": "subtitle", "time": 12566.88, "timestamp": "03:29:26", "text": "好的。没关系。没关系。什么？ 哦，这张诡异的脸又出现了，你"}, {"type": "subtitle", "time": 12569.6, "timestamp": "03:29:29", "text": "哦，这张诡异的脸又出现了，你 是"}, {"type": "subtitle", "time": 12571.92, "timestamp": "03:29:31", "text": "是 已经等待并达到了正确的次数。"}, {"type": "subtitle", "time": 12582.87, "timestamp": "03:29:42", "text": "哦，她的眼睛红了。这就是我们"}, {"type": "subtitle", "time": 12584.55, "timestamp": "03:29:44", "text": "让她复活。不，不，你继续跑"}, {"type": "subtitle", "time": 12586.389, "timestamp": "03:29:46", "text": "背部也一样。呃，齐亚在你旁边吗？"}, {"type": "subtitle", "time": 12592.03, "timestamp": "03:29:52", "text": "嗯，是的。她被关在笼子里。"}, {"type": "subtitle", "time": 12596.55, "timestamp": "03:29:56", "text": "地方。我要出去，呃，我会"}, {"type": "subtitle", "time": 12599.83, "timestamp": "03:29:59", "text": "带上急救包。"}]
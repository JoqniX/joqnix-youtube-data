[{"type": "subtitle", "time": 7981.629, "timestamp": "02:13:01", "text": "[音乐]"}, {"type": "subtitle", "time": 7983.589, "timestamp": "02:13:03", "text": "诺伊什。等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 7993.03, "timestamp": "02:13:13", "text": "我们能得到什么？我看不见。我不能"}, {"type": "subtitle", "time": 7994.35, "timestamp": "02:13:14", "text": "告诉。它是"}, {"type": "subtitle", "time": 7996.83, "timestamp": "02:13:16", "text": "好的。哦，是汽车"}, {"type": "subtitle", "time": 7999.95, "timestamp": "02:13:19", "text": "电镀工。我讨厌这样"}, {"type": "subtitle", "time": 8003.75, "timestamp": "02:13:23", "text": "汽车。什么？那是什么？它涵盖了所有"}, {"type": "subtitle", "time": 8005.91, "timestamp": "02:13:25", "text": "食物做好后，我喜欢它"}, {"type": "subtitle", "time": 8007.82, "timestamp": "02:13:27", "text": "糟透了。"}, {"type": "subtitle", "time": 8020.229, "timestamp": "02:13:40", "text": "[音乐]"}, {"type": "subtitle", "time": 8022.069, "timestamp": "02:13:42", "text": "车站。最多可存放四个相同的"}, {"type": "subtitle", "time": 8035.03, "timestamp": "02:13:55", "text": "柜台？我们有很多。是的，我们可以。"}]
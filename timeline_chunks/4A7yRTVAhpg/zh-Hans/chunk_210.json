[{"type": "subtitle", "time": 12603.83, "timestamp": "03:30:03", "text": "你在哪里？我在外面"}, {"type": "subtitle", "time": 12617.19, "timestamp": "03:30:17", "text": "你知道吗？我会进入"}, {"type": "subtitle", "time": 12619.55, "timestamp": "03:30:19", "text": "入口。我进来了。别动。"}, {"type": "subtitle", "time": 12621.99, "timestamp": "03:30:21", "text": "钥匙。好的。好了。我们开始吧"}, {"type": "subtitle", "time": 12624.63, "timestamp": "03:30:24", "text": "你后退。你赢了吗？哦，"}, {"type": "subtitle", "time": 12626.71, "timestamp": "03:30:26", "text": "我们弄倒了三只山羊。还，"}, {"type": "subtitle", "time": 12628.15, "timestamp": "03:30:28", "text": "欢迎来到直播间，Zena。你好吗"}, {"type": "subtitle", "time": 12630.469, "timestamp": "03:30:30", "text": "今天做什么？"}, {"type": "subtitle", "time": 12633.59, "timestamp": "03:30:33", "text": "我们走吧。我们需要干草。"}, {"type": "subtitle", "time": 12637.71, "timestamp": "03:30:37", "text": "我的天啊。为什么我们像短草一样？哦"}, {"type": "subtitle", "time": 12641.59, "timestamp": "03:30:41", "text": "不。糟糕。我们直接把电梯放下来就行了。"}, {"type": "subtitle", "time": 12656.309, "timestamp": "03:30:56", "text": "山羊。已收购。回到"}, {"type": "subtitle", "time": 12659.91, "timestamp": "03:30:59", "text": "召唤出那个东西并启动它。呃，"}]
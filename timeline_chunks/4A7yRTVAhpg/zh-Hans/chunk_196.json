[{"type": "subtitle", "time": 11772.71, "timestamp": "03:16:12", "text": "我只是知道，我从未见过这样的人。"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "你听到了吗？在哪里？我从未见过这种情况"}, {"type": "subtitle", "time": 11778.55, "timestamp": "03:16:18", "text": "就像年初的时候那样。哦，乔，"}, {"type": "subtitle", "time": 11780.87, "timestamp": "03:16:20", "text": "过来。那就是恶魔。走，走。"}, {"type": "subtitle", "time": 11782.389, "timestamp": "03:16:22", "text": "筋疲力尽的。"}, {"type": "subtitle", "time": 11785.11, "timestamp": "03:16:25", "text": "快点。我只是抱着他。是的。哦，我"}, {"type": "subtitle", "time": 11788.63, "timestamp": "03:16:28", "text": "烧伤。哦，是的。瞧瞧。 J 的第一个"}, {"type": "subtitle", "time": 11791.59, "timestamp": "03:16:31", "text": "恶魔。耶稣。乔，我真为你感到骄傲。"}, {"type": "subtitle", "time": 11796.55, "timestamp": "03:16:36", "text": "好工作。耶。哦，宝贝的第一次杀戮。"}, {"type": "subtitle", "time": 11800.469, "timestamp": "03:16:40", "text": "有婴儿的哭声。"}, {"type": "subtitle", "time": 11803.75, "timestamp": "03:16:43", "text": "没关系。那里。你没事。你是"}, {"type": "subtitle", "time": 11807.269, "timestamp": "03:16:47", "text": "美好的。你做得很好。你正在做的"}, {"type": "subtitle", "time": 11809.269, "timestamp": "03:16:49", "text": "伟大的。"}, {"type": "subtitle", "time": 11813.11, "timestamp": "03:16:53", "text": "哦，我需要和别人共用一把浴室钥匙。"}, {"type": "subtitle", "time": 11815.99, "timestamp": "03:16:55", "text": "共用浴室钥匙。是的。哦，没有"}, {"type": "subtitle", "time": 11818.55, "timestamp": "03:16:58", "text": "你有吗？你在楼上吗？是的，就是这样。"}]
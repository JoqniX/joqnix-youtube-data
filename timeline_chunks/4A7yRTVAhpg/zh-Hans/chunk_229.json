[{"type": "subtitle", "time": 13741.429, "timestamp": "03:49:01", "text": "进去。过来。过来。乔。"}, {"type": "subtitle", "time": 13744.07, "timestamp": "03:49:04", "text": "是的。看看他。哪个都无所谓"}, {"type": "subtitle", "time": 13748.11, "timestamp": "03:49:08", "text": "祝你一路顺风。这一切都是"}, {"type": "subtitle", "time": 13753.63, "timestamp": "03:49:13", "text": "哦，那位女士是谁？哦，拜托。"}, {"type": "subtitle", "time": 13756.389, "timestamp": "03:49:16", "text": "Zara日本。"}, {"type": "subtitle", "time": 13759.83, "timestamp": "03:49:19", "text": "哦。哦，不。"}, {"type": "subtitle", "time": 13761.92, "timestamp": "03:49:21", "text": "哦，不。 她呕吐了。哦，不。我没在找。"}, {"type": "subtitle", "time": 13766.319, "timestamp": "03:49:26", "text": "她呕吐了。哦，不。我没在找。 哦，不。她对你彻底失望了，兄弟。"}, {"type": "subtitle", "time": 13769.86, "timestamp": "03:49:29", "text": "哦，不。她对你彻底失望了，兄弟。 [掌声]"}, {"type": "subtitle", "time": 13772.479, "timestamp": "03:49:32", "text": "[掌声] 哦，她爬了进去。我的天啊。种类"}, {"type": "subtitle", "time": 13775.199, "timestamp": "03:49:35", "text": "哦，她爬了进去。我的天啊。种类 虽然炸弹袭击了你。你还好吗？"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "我不需要看到那些。我"}, {"type": "subtitle", "time": 13784.55, "timestamp": "03:49:44", "text": "我没必要看到那个。我不需要"}, {"type": "subtitle", "time": 13787.349, "timestamp": "03:49:47", "text": "亲眼所见。是的。我不应该去"}, {"type": "subtitle", "time": 13790.389, "timestamp": "03:49:50", "text": "去上班了。是的。嗯，过来吧，猪。你"}, {"type": "subtitle", "time": 13793.429, "timestamp": "03:49:53", "text": "看到了吗？"}, {"type": "subtitle", "time": 13795.349, "timestamp": "03:49:55", "text": "鸡蛋，我们需要把它捡起来清洗。"}, {"type": "subtitle", "time": 13799.349, "timestamp": "03:49:59", "text": "把它牺牲掉。是的。多少个鸡蛋"}]
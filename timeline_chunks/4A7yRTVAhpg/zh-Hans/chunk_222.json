[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "女士。蜘蛛女也很漂亮"}, {"type": "subtitle", "time": 13322.389, "timestamp": "03:42:02", "text": "简单的。"}, {"type": "subtitle", "time": 13324.71, "timestamp": "03:42:04", "text": "是啊，但是，你知道吗？你知道"}, {"type": "subtitle", "time": 13327.19, "timestamp": "03:42:07", "text": "什么？你想进去吗？我们进去吧。"}, {"type": "subtitle", "time": 13332.15, "timestamp": "03:42:12", "text": "没关系。哦是的。我们 我们看到 我们看到了"}, {"type": "subtitle", "time": 13336.229, "timestamp": "03:42:16", "text": "看到了乔女士。是那位女士。"}, {"type": "subtitle", "time": 13346.91, "timestamp": "03:42:26", "text": "恐车症，你们想玩吗？"}, {"type": "subtitle", "time": 13350.11, "timestamp": "03:42:30", "text": "碰撞？那真是太好了"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "哦，狗粮是什么？什么好？曾是"}, {"type": "subtitle", "time": 13365.349, "timestamp": "03:42:45", "text": "食物和什么好吃，狗狗？"}, {"type": "subtitle", "time": 13366.87, "timestamp": "03:42:46", "text": "你好，热狗。你好吗？希望"}, {"type": "subtitle", "time": 13378.07, "timestamp": "03:42:58", "text": "嗯哼。"}]
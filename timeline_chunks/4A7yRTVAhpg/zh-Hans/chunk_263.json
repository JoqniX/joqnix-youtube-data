[{"type": "subtitle", "time": 15788.87, "timestamp": "04:23:08", "text": "你好。"}, {"type": "subtitle", "time": 15795.229, "timestamp": "04:23:15", "text": "你们能听到我们说话吗？呃，"}, {"type": "subtitle", "time": 15800.07, "timestamp": "04:23:20", "text": "哦，快要死了，因为屏幕黑了。"}, {"type": "subtitle", "time": 15807.83, "timestamp": "04:23:27", "text": "好吧，我还是头疼。"}, {"type": "subtitle", "time": 15809.429, "timestamp": "04:23:29", "text": "所以我想走了，我要出发了。"}, {"type": "subtitle", "time": 15811.11, "timestamp": "04:23:31", "text": "睡觉。"}, {"type": "subtitle", "time": 15814.149, "timestamp": "04:23:34", "text": "好了，你们两个。谢谢你今天抽出时间。哦，"}, {"type": "subtitle", "time": 15815.83, "timestamp": "04:23:35", "text": "就这样。我会留下来。"}, {"type": "subtitle", "time": 15818.95, "timestamp": "04:23:38", "text": "直到“哦，就是这样。”哦，是的。是的，我"}, {"type": "subtitle", "time": 15820.389, "timestamp": "04:23:40", "text": "现在能听到你说话了。晚安。小心"}, {"type": "subtitle", "time": 15822.79, "timestamp": "04:23:42", "text": "再次。我对此深感抱歉"}, {"type": "subtitle", "time": 15825.03, "timestamp": "04:23:45", "text": "整件事。"}, {"type": "subtitle", "time": 15826.55, "timestamp": "04:23:46", "text": "没关系。不要道歉。它是"}, {"type": "subtitle", "time": 15829.59, "timestamp": "04:23:49", "text": "美好的。道歉。是的，我们可以玩。"}, {"type": "subtitle", "time": 15832.71, "timestamp": "04:23:52", "text": "下次吧。是的，我们可以吓唬雅克。"}, {"type": "subtitle", "time": 15835.63, "timestamp": "04:23:55", "text": "别的地方。没关系。"}, {"type": "subtitle", "time": 15839.99, "timestamp": "04:23:59", "text": "等等，我们不会把你带到其他地方的。"}]
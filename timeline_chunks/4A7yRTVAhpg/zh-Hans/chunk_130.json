[{"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "三。等待。你真的想这么做"}, {"type": "subtitle", "time": 7805.99, "timestamp": "02:10:05", "text": "三？"}, {"type": "subtitle", "time": 7809.35, "timestamp": "02:10:09", "text": "H 三个人。"}, {"type": "subtitle", "time": 7810.43, "timestamp": "02:10:10", "text": "三"}, {"type": "subtitle", "time": 7813.109, "timestamp": "02:10:13", "text": "人们。很少有人会三五成群。"}, {"type": "subtitle", "time": 7816.95, "timestamp": "02:10:16", "text": "尽管。你可以把它设为二。我"}, {"type": "subtitle", "time": 7823.99, "timestamp": "02:10:23", "text": "是的。进而"}, {"type": "subtitle", "time": 7832.629, "timestamp": "02:10:32", "text": "我想我把水槽放在这里了。"}, {"type": "subtitle", "time": 7834.35, "timestamp": "02:10:34", "text": "是的。"}, {"type": "subtitle", "time": 7837.76, "timestamp": "02:10:37", "text": "然后"}, {"type": "subtitle", "time": 7844.709, "timestamp": "02:10:44", "text": "像这样。"}, {"type": "subtitle", "time": 7852.229, "timestamp": "02:10:52", "text": "[音乐]"}, {"type": "subtitle", "time": 7855.35, "timestamp": "02:10:55", "text": "我们能吃到肉，而我却吃不到。"}]
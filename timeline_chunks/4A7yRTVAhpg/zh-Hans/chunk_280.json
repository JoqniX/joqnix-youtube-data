[{"type": "subtitle", "time": 16802.868, "timestamp": "04:40:02", "text": "这不像爆炸一样。它就像让你"}, {"type": "subtitle", "time": 16805.27, "timestamp": "04:40:05", "text": "心理学。从后屋逃脱"}, {"type": "subtitle", "time": 16809.27, "timestamp": "04:40:09", "text": "心理恐怖片。我的天啊。是的。"}, {"type": "subtitle", "time": 16812.628, "timestamp": "04:40:12", "text": "谢谢提醒。是的，我们将"}, {"type": "subtitle", "time": 16815.99, "timestamp": "04:40:15", "text": "把这局游戏重新玩一遍。"}, {"type": "subtitle", "time": 16820.948, "timestamp": "04:40:20", "text": "我为什么会这样？我的天哪。什么？我的天哪。"}, {"type": "subtitle", "time": 16830.868, "timestamp": "04:40:30", "text": "真不敢相信我居然玩过付费游戏。"}, {"type": "subtitle", "time": 16833.11, "timestamp": "04:40:33", "text": "玩耍时间。"}, {"type": "subtitle", "time": 16835.47, "timestamp": "04:40:35", "text": "那是"}, {"type": "subtitle", "time": 16838.31, "timestamp": "04:40:38", "text": "心理。我的天啊。远程真实"}, {"type": "subtitle", "time": 16841.75, "timestamp": "04:40:41", "text": "交易。哦，对了，文学俱乐部是"}, {"type": "subtitle", "time": 16844.47, "timestamp": "04:40:44", "text": "我也喜欢那样。是的，对我来说不是。"}, {"type": "subtitle", "time": 16847.35, "timestamp": "04:40:47", "text": "就像突然吓你一跳一样。谁在乎？"}, {"type": "subtitle", "time": 16850.868, "timestamp": "04:40:50", "text": "《死亡空间》是一款好游戏。 《死亡空间》"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "舒达。但是价格很贵。"}, {"type": "subtitle", "time": 16857.19, "timestamp": "04:40:57", "text": "不过价格很贵。 3,000。"}, {"type": "subtitle", "time": 16859.91, "timestamp": "04:40:59", "text": "面包和自由。哦，这是个多人游戏。"}]
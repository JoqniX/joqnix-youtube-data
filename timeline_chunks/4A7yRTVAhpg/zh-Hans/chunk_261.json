[{"type": "subtitle", "time": 15663.349, "timestamp": "04:21:03", "text": "做得非常好。乔克。快点。嗯。"}, {"type": "subtitle", "time": 15666.149, "timestamp": "04:21:06", "text": "我为你们俩感到骄傲。"}, {"type": "subtitle", "time": 15670.149, "timestamp": "04:21:10", "text": "70次击杀。我的天啊。好的。"}, {"type": "subtitle", "time": 15672.71, "timestamp": "04:21:12", "text": "好的。扎克先生，您能想象自己身处……"}, {"type": "subtitle", "time": 15685.67, "timestamp": "04:21:25", "text": "你好。我的天啊。我的天啊。乔克。大部分"}, {"type": "subtitle", "time": 15688.63, "timestamp": "04:21:28", "text": "他的皮肤都变成紫色了。我想知道是否"}, {"type": "subtitle", "time": 15691.429, "timestamp": "04:21:31", "text": "不管它是不是你最喜欢的颜色。哦，因为"}, {"type": "subtitle", "time": 15695.269, "timestamp": "04:21:35", "text": "乔克的代表色现在是紫色。我不得不"}, {"type": "subtitle", "time": 15699.429, "timestamp": "04:21:39", "text": "紫色的。我也需要更多不同色调的蓝色。"}, {"type": "subtitle", "time": 15708.51, "timestamp": "04:21:48", "text": "是的。自有品牌。"}, {"type": "subtitle", "time": 15711.189, "timestamp": "04:21:51", "text": "是的。总之，你想再做一次。"}, {"type": "subtitle", "time": 15714.309, "timestamp": "04:21:54", "text": "比赛掉落？当然可以。当然。有趣的"}, {"type": "subtitle", "time": 15716.309, "timestamp": "04:21:56", "text": "类似升级之类的匹配？"}, {"type": "subtitle", "time": 15718.55, "timestamp": "04:21:58", "text": "当然可以。当然。伟大的。我爱"}]
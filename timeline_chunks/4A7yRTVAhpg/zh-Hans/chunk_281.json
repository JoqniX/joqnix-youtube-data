[{"type": "subtitle", "time": 16863.59, "timestamp": "04:41:03", "text": "游戏。不，不是。是的。本地合作社。"}, {"type": "subtitle", "time": 16866.628, "timestamp": "04:41:06", "text": "面包和弗雷德。不，不，不。爱。不，"}, {"type": "subtitle", "time": 16868.39, "timestamp": "04:41:08", "text": "不，不，不，不。不是那样。什么"}, {"type": "subtitle", "time": 16871.59, "timestamp": "04:41:11", "text": "你管这叫什么？ 《死亡空间3》"}, {"type": "subtitle", "time": 16873.75, "timestamp": "04:41:13", "text": "合作社。"}, {"type": "subtitle", "time": 16876.868, "timestamp": "04:41:16", "text": "哦，不是一和二。不是一和二。"}, {"type": "subtitle", "time": 16883.788, "timestamp": "04:41:23", "text": "[音乐]"}, {"type": "subtitle", "time": 16887.03, "timestamp": "04:41:27", "text": "好的。这是一款很有意思的游戏。你"}, {"type": "subtitle", "time": 16891.51, "timestamp": "04:41:31", "text": "想玩《霍勒世界》吗？"}, {"type": "subtitle", "time": 16894.31, "timestamp": "04:41:34", "text": "霍勒的世界。什么？霍勒的世界。"}, {"type": "subtitle", "time": 16896.788, "timestamp": "04:41:36", "text": "大概是660卢比。它就像一个超级"}, {"type": "subtitle", "time": 16898.708, "timestamp": "04:41:38", "text": "恐怖游戏。"}, {"type": "subtitle", "time": 16901.43, "timestamp": "04:41:41", "text": "就像……就像姜汁黑……"}, {"type": "subtitle", "time": 16903.75, "timestamp": "04:41:43", "text": "白色的。"}, {"type": "subtitle", "time": 16906.19, "timestamp": "04:41:46", "text": "姜食者灵感来源。"}, {"type": "subtitle", "time": 16908.948, "timestamp": "04:41:48", "text": "姜饼。什么？"}, {"type": "subtitle", "time": 16913.19, "timestamp": "04:41:53", "text": "我的天啊。你不认识他？不。该死。"}, {"type": "subtitle", "time": 16915.51, "timestamp": "04:41:55", "text": "搜一下他的名字就行了。搜一下他的名字就行了。"}, {"type": "subtitle", "time": 16918.19, "timestamp": "04:41:58", "text": "等待。姜的拼写。"}]
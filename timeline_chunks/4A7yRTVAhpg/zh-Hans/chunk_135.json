[{"type": "subtitle", "time": 8123.55, "timestamp": "02:15:23", "text": "胡萝卜。胡萝卜。"}, {"type": "subtitle", "time": 8127.43, "timestamp": "02:15:27", "text": "胡萝卜。肉。"}, {"type": "subtitle", "time": 8147.669, "timestamp": "02:15:47", "text": "[音乐]"}, {"type": "subtitle", "time": 8149.669, "timestamp": "02:15:49", "text": "我的天哪。我们可以储存吗？呃，我们不能。"}, {"type": "subtitle", "time": 8151.589, "timestamp": "02:15:51", "text": "商店出售饺子。你肯定在开玩笑吧？"}, {"type": "subtitle", "time": 8153.83, "timestamp": "02:15:53", "text": "我。"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "把它放在道具盒里。诚实地，"}, {"type": "subtitle", "time": 8159.99, "timestamp": "02:15:59", "text": "我们不能。哦，我们只能像生肉一样储存。"}]
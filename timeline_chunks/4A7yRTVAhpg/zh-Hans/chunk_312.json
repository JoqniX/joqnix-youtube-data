[{"type": "subtitle", "time": 18721.51, "timestamp": "05:12:01", "text": "是的。是的。你喜欢什么？僵尸"}, {"type": "subtitle", "time": 18724.39, "timestamp": "05:12:04", "text": "还有像枪声、枪声之类的。的"}, {"type": "subtitle", "time": 18726.55, "timestamp": "05:12:06", "text": "当然，我喜欢枪战，但是，是的，我"}, {"type": "subtitle", "time": 18727.83, "timestamp": "05:12:07", "text": "我以前没玩过任何丧尸游戏。"}, {"type": "subtitle", "time": 18734.948, "timestamp": "05:12:14", "text": "我们还有两场比赛要打。"}, {"type": "subtitle", "time": 18737.11, "timestamp": "05:12:17", "text": "死了原神。"}, {"type": "subtitle", "time": 18739.67, "timestamp": "05:12:19", "text": "等等，原神不是免费的吗？哦，是的。"}, {"type": "subtitle", "time": 18742.31, "timestamp": "05:12:22", "text": "我只玩原神。是的，我们可以做到"}, {"type": "subtitle", "time": 18743.91, "timestamp": "05:12:23", "text": "原神。"}, {"type": "subtitle", "time": 18745.35, "timestamp": "05:12:25", "text": "你想和我们一起玩源神吗？什么"}, {"type": "subtitle", "time": 18749.59, "timestamp": "05:12:29", "text": "顺便问一下，你在线吗？我懂了。"}, {"type": "subtitle", "time": 18753.67, "timestamp": "05:12:33", "text": "真棒，伙计。就像打仗一样，这很费劲。"}, {"type": "subtitle", "time": 18756.07, "timestamp": "05:12:36", "text": "和基因。看着我。我从不碰"}, {"type": "subtitle", "time": 18757.91, "timestamp": "05:12:37", "text": "原神。"}, {"type": "subtitle", "time": 18766.868, "timestamp": "05:12:46", "text": "哦，我正在攒钱减肥。"}, {"type": "subtitle", "time": 18772.628, "timestamp": "05:12:52", "text": "仍然像在苦苦挣扎一样，一动不动"}, {"type": "subtitle", "time": 18774.788, "timestamp": "05:12:54", "text": "重量和霰弹枪"}, {"type": "subtitle", "time": 18777.43, "timestamp": "05:12:57", "text": "除非另有他人"}]
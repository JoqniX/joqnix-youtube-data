[{"type": "subtitle", "time": 10443.349, "timestamp": "02:54:03", "text": "对不起。好的。我是杰克，我希望你"}, {"type": "subtitle", "time": 10447.59, "timestamp": "02:54:07", "text": "比如听。就像你的音频一样"}, {"type": "subtitle", "time": 10458.23, "timestamp": "02:54:18", "text": "什么？"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "也是一个乐队。是的。但是但是但是"}, {"type": "subtitle", "time": 10467.67, "timestamp": "02:54:27", "text": "这简直就是我能遇到的最好的人了。"}, {"type": "subtitle", "time": 10470.71, "timestamp": "02:54:30", "text": "问。音质好吗？我的是我的"}, {"type": "subtitle", "time": 10475.349, "timestamp": "02:54:35", "text": "音量太低还是我开得太高了？"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "那个运动员就像你能听到杰克的声音吗？"}, {"type": "subtitle", "time": 10480.87, "timestamp": "02:54:40", "text": "他身体状况良好还是情绪低落？如果他情绪低落，我"}, {"type": "subtitle", "time": 10483.309, "timestamp": "02:54:43", "text": "会增加"}, {"type": "subtitle", "time": 10487.83, "timestamp": "02:54:47", "text": "体积。好的。等待。还要检查一下。"}, {"type": "subtitle", "time": 10492.19, "timestamp": "02:54:52", "text": "好的，谢谢。我就像在调整调整一样。"}, {"type": "subtitle", "time": 10496.87, "timestamp": "02:54:56", "text": "我当时正在调整我的……嗯，好吧，我"}, {"type": "subtitle", "time": 10499.67, "timestamp": "02:54:59", "text": "我想自己检查一下，因为为什么呢？"}]
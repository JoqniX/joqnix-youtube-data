[{"type": "subtitle", "time": 16742.629, "timestamp": "04:39:02", "text": "我不想在这里出汗。"}, {"type": "subtitle", "time": 16744.23, "timestamp": "04:39:04", "text": "你知道？等等，那《Dead by》呢？"}, {"type": "subtitle", "time": 16748.189, "timestamp": "04:39:08", "text": "天亮了吗？黎明杀机。我没有"}, {"type": "subtitle", "time": 16751.429, "timestamp": "04:39:11", "text": "它。你想说“好吧”，你明明知道得更清楚。"}, {"type": "subtitle", "time": 16755.109, "timestamp": "04:39:15", "text": "但我们不要玩原神，我们还是喜欢闪亮亮的东西吧。"}, {"type": "subtitle", "time": 16757.269, "timestamp": "04:39:17", "text": "它就像……"}, {"type": "subtitle", "time": 16765.189, "timestamp": "04:39:25", "text": "哦。哦，是的。"}, {"type": "subtitle", "time": 16767.39, "timestamp": "04:39:27", "text": "但什么也没有"}, {"type": "subtitle", "time": 16771.189, "timestamp": "04:39:31", "text": "不过，那里也有很多这样的东西。是的。只是"}, {"type": "subtitle", "time": 16773.59, "timestamp": "04:39:33", "text": "盲目射杀他人。没关系。哦，"}, {"type": "subtitle", "time": 16776.83, "timestamp": "04:39:36", "text": "对不起。过去的人。是的，"}, {"type": "subtitle", "time": 16778.47, "timestamp": "04:39:38", "text": "[音乐]"}, {"type": "subtitle", "time": 16781.43, "timestamp": "04:39:41", "text": "我们喜欢神话中的龙。等等，这是什么？"}, {"type": "subtitle", "time": 16784.868, "timestamp": "04:39:44", "text": "心理恐怖？哦，我们可以做到"}, {"type": "subtitle", "time": 16786.708, "timestamp": "04:39:46", "text": "确实如此。那么，你有什么吗？"}, {"type": "subtitle", "time": 16789.27, "timestamp": "04:39:49", "text": "有什么建议吗？比如，什么是"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "心理恐怖？它会干扰"}, {"type": "subtitle", "time": 16794.07, "timestamp": "04:39:54", "text": "你的大脑。"}]
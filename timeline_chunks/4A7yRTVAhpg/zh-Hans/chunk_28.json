[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "是的。并不真地。我认为。但愿如此。它是"}, {"type": "subtitle", "time": 1684.95, "timestamp": "00:28:04", "text": "好的。我们会想办法的。但是水槽"}, {"type": "subtitle", "time": 1686.669, "timestamp": "00:28:06", "text": "是最好的，因为它会成为一个"}, {"type": "subtitle", "time": 1689.31, "timestamp": "00:28:09", "text": "洗碗机慢速运转。"}, {"type": "subtitle", "time": 1692.75, "timestamp": "00:28:12", "text": "但愿如此。请给我一个"}, {"type": "subtitle", "time": 1697.789, "timestamp": "00:28:17", "text": "洗碗机。好的。我们开始吧？"}, {"type": "subtitle", "time": 1700.63, "timestamp": "00:28:20", "text": "是的。如果我穿过哦会发生什么？"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "等待。没关系。"}, {"type": "subtitle", "time": 1715.59, "timestamp": "00:28:35", "text": "所以，研究台基本上就是一个"}, {"type": "subtitle", "time": 1718.07, "timestamp": "00:28:38", "text": "这款游戏中的赌博系统是，你"}, {"type": "subtitle", "time": 1720.87, "timestamp": "00:28:40", "text": "可以获得升级之类的东西。"}, {"type": "subtitle", "time": 1724.029, "timestamp": "00:28:44", "text": "所以，这很好。等等，我们需要两个"}, {"type": "subtitle", "time": 1726.549, "timestamp": "00:28:46", "text": "媒介。是的，我们需要把这一点也考虑进去。"}, {"type": "subtitle", "time": 1728.549, "timestamp": "00:28:48", "text": "垃圾。哦，不。等等，等等，等等"}, {"type": "subtitle", "time": 1731.72, "timestamp": "00:28:51", "text": "等待。那确实有这么回事。"}, {"type": "subtitle", "time": 1735.11, "timestamp": "00:28:55", "text": "[音乐]"}, {"type": "subtitle", "time": 1737.389, "timestamp": "00:28:57", "text": "我们需要更多天然气"}]
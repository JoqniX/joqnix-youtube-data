[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "神话。神话。呃，我有一个"}, {"type": "subtitle", "time": 14104.229, "timestamp": "03:55:04", "text": "电脑。我找到钥匙了。你愿意吗？"}, {"type": "subtitle", "time": 14107.349, "timestamp": "03:55:07", "text": "你想通过洗澡来激怒她吗？"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "鸡蛋，或者哦，不。不。只有当你"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "把它们放在标牌上。好的。我要"}, {"type": "subtitle", "time": 14114.63, "timestamp": "03:55:14", "text": "现在就把鸡蛋洗干净。好的。坚持，稍等。抓住"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "我正在打开大门。等待。"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "不，不，不。我不是那种会做出牺牲的人。"}, {"type": "subtitle", "time": 14129.429, "timestamp": "03:55:29", "text": "我只是在洗漱。哦好的。我是"}, {"type": "subtitle", "time": 14132.389, "timestamp": "03:55:32", "text": "洗碗。没关系。"}, {"type": "subtitle", "time": 14135.229, "timestamp": "03:55:35", "text": "一号房间。房间在哪里？"}, {"type": "subtitle", "time": 14145.71, "timestamp": "03:55:45", "text": "对不起。看看"}]
[{"type": "subtitle", "time": 17041.67, "timestamp": "04:44:01", "text": "你想做什么？你做什么？我们俩都想做什么？"}, {"type": "subtitle", "time": 17044.31, "timestamp": "04:44:04", "text": "一起直播或类似"}, {"type": "subtitle", "time": 17047.67, "timestamp": "04:44:07", "text": "呃，其实你不必这样，对吧？"}, {"type": "subtitle", "time": 17049.83, "timestamp": "04:44:09", "text": "可以直接看直播，我就会像这样"}, {"type": "subtitle", "time": 17053.51, "timestamp": "04:44:13", "text": "我来玩，或者我可以来玩。你可以"}, {"type": "subtitle", "time": 17056.55, "timestamp": "04:44:16", "text": "就像看着我一样。"}, {"type": "subtitle", "time": 17059.67, "timestamp": "04:44:19", "text": "Discord，然后给你反馈。"}, {"type": "subtitle", "time": 17063.868, "timestamp": "04:44:23", "text": "好的。因为就像如果你看到"}, {"type": "subtitle", "time": 17065.91, "timestamp": "04:44:25", "text": "直播，显然会是"}, {"type": "subtitle", "time": 17067.83, "timestamp": "04:44:27", "text": "延迟是因为像流媒体延迟一样，你"}, {"type": "subtitle", "time": 17071.51, "timestamp": "04:44:31", "text": "知道。哦，是的。是的。是的。嗯，是的。"}, {"type": "subtitle", "time": 17074.15, "timestamp": "04:44:34", "text": "就像直播一样，然后去做。是的。"}, {"type": "subtitle", "time": 17076.628, "timestamp": "04:44:36", "text": "是的。它也可以朝两个方向发展"}, {"type": "subtitle", "time": 17080.07, "timestamp": "04:44:40", "text": "就像你可以直播一样，你"}, {"type": "subtitle", "time": 17082.788, "timestamp": "04:44:42", "text": "你可以看着我，我会很喜欢的。"}, {"type": "subtitle", "time": 17086.11, "timestamp": "04:44:46", "text": "玩游戏或者我也可以只是点赞"}, {"type": "subtitle", "time": 17089.11, "timestamp": "04:44:49", "text": "直播，就像我也会直播一样。"}, {"type": "subtitle", "time": 17091.35, "timestamp": "04:44:51", "text": "Discord 和 YouTube 上你都可以。"}, {"type": "subtitle", "time": 17093.35, "timestamp": "04:44:53", "text": "手表"}, {"type": "subtitle", "time": 17095.99, "timestamp": "04:44:55", "text": "给你一些反应之类的。是的，我们"}, {"type": "subtitle", "time": 17097.91, "timestamp": "04:44:57", "text": "可以做到。是的。是的，会的"}]
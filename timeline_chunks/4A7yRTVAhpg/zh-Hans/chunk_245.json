[{"type": "subtitle", "time": 14713.51, "timestamp": "04:05:13", "text": "哦，对不起。哦，你们要……"}, {"type": "subtitle", "time": 14715.269, "timestamp": "04:05:15", "text": "玩《Valerant》吗？"}, {"type": "subtitle", "time": 14717.75, "timestamp": "04:05:17", "text": "是的。哦，你想加入吗？哦，不，不"}, {"type": "subtitle", "time": 14721.59, "timestamp": "04:05:21", "text": "不。我喜欢休息一下。是的，我通常"}, {"type": "subtitle", "time": 14724.229, "timestamp": "04:05:24", "text": "我觉得我需要休息一下，什么都不想做。我是"}, {"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "我就看看而已。我不会"}, {"type": "subtitle", "time": 14728.309, "timestamp": "04:05:28", "text": "什么都能玩。没关系。你可以听到"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "我们。是的，你能听到我们像尖叫一样的声音。"}, {"type": "subtitle", "time": 14741.99, "timestamp": "04:05:41", "text": "我和Mythic一起玩过，也很喜欢她。"}, {"type": "subtitle", "time": 14746.389, "timestamp": "04:05:46", "text": "不久前和朋友还有Mua一起。哦，是的。"}, {"type": "subtitle", "time": 14748.309, "timestamp": "04:05:48", "text": "就像几个小时前那样，就像以前那样。"}, {"type": "subtitle", "time": 14750.469, "timestamp": "04:05:50", "text": "溪流。"}, {"type": "subtitle", "time": 14753.189, "timestamp": "04:05:53", "text": "我觉得Mua大概是离开了。"}, {"type": "subtitle", "time": 14755.03, "timestamp": "04:05:55", "text": "因为那是他的睡觉时间之类的。"}, {"type": "subtitle", "time": 14758.71, "timestamp": "04:05:58", "text": "是的。不，他还在VC工作。"}]
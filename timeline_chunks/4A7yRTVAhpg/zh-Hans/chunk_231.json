[{"type": "subtitle", "time": 13862.15, "timestamp": "03:51:02", "text": "把眼睛集中到这里来。剑在里面"}, {"type": "subtitle", "time": 13865.189, "timestamp": "03:51:05", "text": "山洞。哦，上面还有一个蛋。"}, {"type": "subtitle", "time": 13866.75, "timestamp": "03:51:06", "text": "感觉"}, {"type": "subtitle", "time": 13868.99, "timestamp": "03:51:08", "text": "地方。这上面有两个医疗包"}, {"type": "subtitle", "time": 13881.11, "timestamp": "03:51:21", "text": "三。我找到了一把钥匙。三号房间。"}, {"type": "subtitle", "time": 13883.51, "timestamp": "03:51:23", "text": "哦，三号房间。房间就在里面。"}, {"type": "subtitle", "time": 13892.55, "timestamp": "03:51:32", "text": "地面。哦。哦，我发现我看到我看到"}, {"type": "subtitle", "time": 13897.71, "timestamp": "03:51:37", "text": "另一把钥匙。我买了一个鸡蛋储存罐"}, {"type": "subtitle", "time": 13900.91, "timestamp": "03:51:40", "text": "钥匙。哦，水桶。"}, {"type": "subtitle", "time": 13904.269, "timestamp": "03:51:44", "text": "桶。我不能打开这扇门吗？"}, {"type": "subtitle", "time": 13907.229, "timestamp": "03:51:47", "text": "哦，我们到了。"}, {"type": "subtitle", "time": 13910.309, "timestamp": "03:51:50", "text": "去。我在洗手间。有一个"}, {"type": "subtitle", "time": 13913.75, "timestamp": "03:51:53", "text": "镜子。这是蜡烛楼梯。"}, {"type": "subtitle", "time": 13917.59, "timestamp": "03:51:57", "text": "哦，一号房间。二号房间。"}]
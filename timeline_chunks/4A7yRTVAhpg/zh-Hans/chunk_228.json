[{"type": "subtitle", "time": 13683.75, "timestamp": "03:48:03", "text": "她触发了拿到钥匙的指令。"}, {"type": "subtitle", "time": 13685.75, "timestamp": "03:48:05", "text": "哦好的。"}, {"type": "subtitle", "time": 13688.87, "timestamp": "03:48:08", "text": "好的，约翰。快点。跟我们来。好的，"}, {"type": "subtitle", "time": 13691.269, "timestamp": "03:48:11", "text": "我把它开火了。我们走吧。快点，"}, {"type": "subtitle", "time": 13693.67, "timestamp": "03:48:13", "text": "跳。你必须……你必须走在前面。"}, {"type": "subtitle", "time": 13699.269, "timestamp": "03:48:19", "text": "快点。你不能。并非如此。"}, {"type": "subtitle", "time": 13702.309, "timestamp": "03:48:22", "text": "相信我，我试过很多次了。"}, {"type": "subtitle", "time": 13704.389, "timestamp": "03:48:24", "text": "我的天啊。对，继续。"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "向前。哇，你跑得真快！哦，你是"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "很期待见到她。"}, {"type": "subtitle", "time": 13712.269, "timestamp": "03:48:32", "text": "看看他。看看他。那是"}, {"type": "subtitle", "time": 13714.55, "timestamp": "03:48:34", "text": "点亮完成。我感觉到了我的形态"}, {"type": "subtitle", "time": 13716.55, "timestamp": "03:48:36", "text": "转变。我痛得难以忍受。并非如此"}, {"type": "subtitle", "time": 13718.07, "timestamp": "03:48:38", "text": "我本该在的地方。我做了"}, {"type": "subtitle", "time": 13719.51, "timestamp": "03:48:39", "text": "一切都好。我本应该有"}, {"type": "subtitle", "time": 13721.67, "timestamp": "03:48:41", "text": "控制。能听到他的声音"}, {"type": "subtitle", "time": 13723.91, "timestamp": "03:48:43", "text": "脑海中一片笑意。缓慢而空洞。它"}, {"type": "subtitle", "time": 13726.15, "timestamp": "03:48:46", "text": "永不停歇。它几乎就快要结束了"}, {"type": "subtitle", "time": 13729.67, "timestamp": "03:48:49", "text": "像移动的回声一样传播。哦，她是"}, {"type": "subtitle", "time": 13732.309, "timestamp": "03:48:52", "text": "经历过，兄弟。正在经历这件事。"}, {"type": "subtitle", "time": 13734.15, "timestamp": "03:48:54", "text": "南瓜。"}, {"type": "subtitle", "time": 13736.229, "timestamp": "03:48:56", "text": "你好。过来。去。进入那个"}, {"type": "subtitle", "time": 13738.55, "timestamp": "03:48:58", "text": "地方。"}]
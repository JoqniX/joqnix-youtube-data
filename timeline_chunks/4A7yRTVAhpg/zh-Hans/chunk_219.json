[{"type": "subtitle", "time": 13142.429, "timestamp": "03:39:02", "text": "他妈的。我不是故意要静音的。"}, {"type": "subtitle", "time": 13145.59, "timestamp": "03:39:05", "text": "糟糕。忽略"}, {"type": "subtitle", "time": 13147.75, "timestamp": "03:39:07", "text": "它。你真酷。你真酷。你真酷。我"}, {"type": "subtitle", "time": 13149.19, "timestamp": "03:39:09", "text": "感觉就像你在跟我们说话一样"}, {"type": "subtitle", "time": 13151.51, "timestamp": "03:39:11", "text": "某物。"}, {"type": "subtitle", "time": 13159.34, "timestamp": "03:39:19", "text": "好的。神话。我们是否已经"}, {"type": "subtitle", "time": 13161.389, "timestamp": "03:39:21", "text": "[音乐]"}, {"type": "subtitle", "time": 13173.75, "timestamp": "03:39:33", "text": "它非常巨大。这是一张非常愚蠢的地图。它是"}, {"type": "subtitle", "time": 13177.59, "timestamp": "03:39:37", "text": "一张非常烦人的大地图。"}, {"type": "subtitle", "time": 13181.429, "timestamp": "03:39:41", "text": "我们不喜欢我们，我们很清楚什么"}, {"type": "subtitle", "time": 13185.71, "timestamp": "03:39:45", "text": "庇护所也是如此。我们有点像我们"}, {"type": "subtitle", "time": 13188.229, "timestamp": "03:39:48", "text": "真的吗？哦，是的，我想我们确实有。我认为"}, {"type": "subtitle", "time": 13196.71, "timestamp": "03:39:56", "text": "尽管。事情就是这样。"}]
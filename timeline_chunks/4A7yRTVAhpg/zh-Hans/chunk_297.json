[{"type": "subtitle", "time": 17821.03, "timestamp": "04:57:01", "text": "我不知道具体的类型。"}, {"type": "subtitle", "time": 17824.55, "timestamp": "04:57:04", "text": "好的，我们会想办法的。没关系。"}, {"type": "subtitle", "time": 17827.19, "timestamp": "04:57:07", "text": "我大概会弄明白的。"}, {"type": "subtitle", "time": 17829.51, "timestamp": "04:57:09", "text": "在我进行研究和撰写标题时"}, {"type": "subtitle", "time": 17836.39, "timestamp": "04:57:16", "text": "所以这是一款战斗类社交游戏，对吧？如果我"}, {"type": "subtitle", "time": 17838.23, "timestamp": "04:57:18", "text": "记得吗，我当时就说，杰奎先生，你有……"}, {"type": "subtitle", "time": 17842.39, "timestamp": "04:57:22", "text": "你的直播还没结束吗？不。哦，我们"}, {"type": "subtitle", "time": 17845.11, "timestamp": "04:57:25", "text": "只是闲聊。"}, {"type": "subtitle", "time": 17847.11, "timestamp": "04:57:27", "text": "是的，我们当时在聊天。没关系。它是"}, {"type": "subtitle", "time": 17849.35, "timestamp": "04:57:29", "text": "美好的。我刚刚才把他解决掉。我"}, {"type": "subtitle", "time": 17851.59, "timestamp": "04:57:31", "text": "当时的感觉就像，好吧，我们都结束了。你"}, {"type": "subtitle", "time": 17855.51, "timestamp": "04:57:35", "text": "现在可以畅所欲言了。我的天啊。等待。哦"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "我的上帝。所以Zuki要开始直播了"}, {"type": "subtitle", "time": 17859.83, "timestamp": "04:57:39", "text": "现在。"}, {"type": "subtitle", "time": 17868.55, "timestamp": "04:57:48", "text": "凌晨2点。耶稣基督。是的，她，她是"}, {"type": "subtitle", "time": 17873.27, "timestamp": "04:57:53", "text": "就像适应那个时候一样"}, {"type": "subtitle", "time": 17876.23, "timestamp": "04:57:56", "text": "区。没错，她简直是个狠角色。她是一个"}]
[{"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "哦，我得坚持一下。好的。好的。好的。"}, {"type": "subtitle", "time": 724.87, "timestamp": "00:12:04", "text": "是的。站在镜子前，"}, {"type": "subtitle", "time": 727.03, "timestamp": "00:12:07", "text": "按 O 或 P 键。您可以更改"}, {"type": "subtitle", "time": 729.47, "timestamp": "00:12:09", "text": "你的颜色。"}, {"type": "subtitle", "time": 731.31, "timestamp": "00:12:11", "text": "哦，"}, {"type": "subtitle", "time": 733.75, "timestamp": "00:12:13", "text": "镜子。等等，它永远都是 O"}, {"type": "subtitle", "time": 737.19, "timestamp": "00:12:17", "text": "或者 P. 哦，你可以更换钥匙。呃，"}, {"type": "subtitle", "time": 740.99, "timestamp": "00:12:20", "text": "如果你成功逃脱，出口在左边。"}, {"type": "subtitle", "time": 752.069, "timestamp": "00:12:32", "text": "哦，瞧。它们是柔和的粉彩色。耶。"}, {"type": "subtitle", "time": 753.07, "timestamp": "00:12:33", "text": "不。"}, {"type": "subtitle", "time": 755.67, "timestamp": "00:12:35", "text": "[音乐]"}, {"type": "subtitle", "time": 758.55, "timestamp": "00:12:38", "text": "你的外貌也改变了吗？"}, {"type": "subtitle", "time": 761.03, "timestamp": "00:12:41", "text": "是的，可以。"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "太多事情了。我的天哪。我可以是"}, {"type": "subtitle", "time": 771.55, "timestamp": "00:12:51", "text": "节日"}]
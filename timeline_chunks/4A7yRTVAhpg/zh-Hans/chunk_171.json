[{"type": "subtitle", "time": 10263.03, "timestamp": "02:51:03", "text": "想你们了。呃，你们是……"}, {"type": "subtitle", "time": 10265.15, "timestamp": "02:51:05", "text": "正在做"}, {"type": "subtitle", "time": 10268.19, "timestamp": "02:51:08", "text": "出色地。所以，既然已经到了晚上……"}, {"type": "subtitle", "time": 10271.389, "timestamp": "02:51:11", "text": "我当时正在考虑做什么"}, {"type": "subtitle", "time": 10275.59, "timestamp": "02:51:15", "text": "我正在做的事情。等待，"}, {"type": "subtitle", "time": 10287.269, "timestamp": "02:51:27", "text": "你今天怎么样？我正在做"}, {"type": "subtitle", "time": 10289.51, "timestamp": "02:51:29", "text": "好的。你好吗？"}, {"type": "subtitle", "time": 10290.99, "timestamp": "02:51:30", "text": "我"}, {"type": "subtitle", "time": 10294.07, "timestamp": "02:51:34", "text": "是。我很好。"}, {"type": "subtitle", "time": 10298.79, "timestamp": "02:51:38", "text": "哦，不。你快要死了吗？我发誓。"}, {"type": "subtitle", "time": 10299.71, "timestamp": "02:51:39", "text": "哦"}, {"type": "subtitle", "time": 10303.51, "timestamp": "02:51:43", "text": "不。我的天啊。希望你一切都好。"}, {"type": "subtitle", "time": 10313.67, "timestamp": "02:51:53", "text": "等等，Nirvana是什么？等等，这是什么？"}, {"type": "subtitle", "time": 10315.95, "timestamp": "02:51:55", "text": "涅槃？像上升一样"}, {"type": "subtitle", "time": 10319.91, "timestamp": "02:51:59", "text": "感觉上升呃本质就像为了"}]
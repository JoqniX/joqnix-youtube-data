[{"type": "subtitle", "time": 16982.31, "timestamp": "04:43:02", "text": "嗯，是的。是的，我正在看。"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "好的。你想玩那个游戏吗？"}, {"type": "subtitle", "time": 16990.47, "timestamp": "04:43:10", "text": "等等，只有一个玩家。对，就像"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "一个地方和其他手表。"}, {"type": "subtitle", "time": 16998.3, "timestamp": "04:43:18", "text": "你想什么时候做？什么时候？"}, {"type": "subtitle", "time": 17004.868, "timestamp": "04:43:24", "text": "下周H。我们下周可以做。"}, {"type": "subtitle", "time": 17006.788, "timestamp": "04:43:26", "text": "实际上。是的，下周。是的。是的。"}, {"type": "subtitle", "time": 17010.31, "timestamp": "04:43:30", "text": "烧毁。下周。好的。星期一我们"}, {"type": "subtitle", "time": 17013.59, "timestamp": "04:43:33", "text": "可以像《求生之路》那样做"}, {"type": "subtitle", "time": 17016.788, "timestamp": "04:43:36", "text": "我们也可以像这样做Gingito的事情"}, {"type": "subtitle", "time": 17018.628, "timestamp": "04:43:38", "text": "星期三或星期四或星期五或"}, {"type": "subtitle", "time": 17021.35, "timestamp": "04:43:41", "text": "某物。好的。就像星期四一样。"}, {"type": "subtitle", "time": 17025.11, "timestamp": "04:43:45", "text": "星期四是最好的时间。"}, {"type": "subtitle", "time": 17028.15, "timestamp": "04:43:48", "text": "是的，我们可以做到。"}, {"type": "subtitle", "time": 17034.47, "timestamp": "04:43:54", "text": "是的。我会在这个界面和你共享屏幕。"}, {"type": "subtitle", "time": 17036.39, "timestamp": "04:43:56", "text": "所以你不会错过你如何代替"}, {"type": "subtitle", "time": 17038.788, "timestamp": "04:43:58", "text": "就像只是看着“好的”。所以，这样做吧"}]
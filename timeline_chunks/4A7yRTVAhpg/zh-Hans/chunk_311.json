[{"type": "subtitle", "time": 18661.27, "timestamp": "05:11:01", "text": "别担心，贝克。我会，我会"}, {"type": "subtitle", "time": 18664.31, "timestamp": "05:11:04", "text": "真的在睡觉。不用担心。"}, {"type": "subtitle", "time": 18666.868, "timestamp": "05:11:06", "text": "你刚才问我什么事。继续。哦，"}, {"type": "subtitle", "time": 18670.15, "timestamp": "05:11:10", "text": "是的。是的。是星期一吗？"}, {"type": "subtitle", "time": 18673.75, "timestamp": "05:11:13", "text": "周三和周六或周五？这"}, {"type": "subtitle", "time": 18677.19, "timestamp": "05:11:17", "text": "星期五。星期五。哦，等等。想玩"}, {"type": "subtitle", "time": 18679.43, "timestamp": "05:11:19", "text": "玩游戏吗？"}, {"type": "subtitle", "time": 18683.47, "timestamp": "05:11:23", "text": "哦，是的。阿禅，你有L42吗？"}, {"type": "subtitle", "time": 18689.83, "timestamp": "05:11:29", "text": "L42.呃，再说一遍？不，你不需要。"}, {"type": "subtitle", "time": 18692.55, "timestamp": "05:11:32", "text": "好的。那多少钱？"}, {"type": "subtitle", "time": 18696.59, "timestamp": "05:11:36", "text": "你想加入我们吗？"}, {"type": "subtitle", "time": 18701.5, "timestamp": "05:11:41", "text": "嗯，我的意思是，如果我有的话，我会很喜欢的。"}, {"type": "subtitle", "time": 18704.11, "timestamp": "05:11:44", "text": "[音乐]"}, {"type": "subtitle", "time": 18713.99, "timestamp": "05:11:53", "text": "维克，你觉得呢？"}, {"type": "subtitle", "time": 18716.47, "timestamp": "05:11:56", "text": "没有把握。如果他喜欢整个场景"}, {"type": "subtitle", "time": 18718.788, "timestamp": "05:11:58", "text": "我不想玩丧尸游戏。"}]
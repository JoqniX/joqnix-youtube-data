[{"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "物品？等等，你那边也能看到吗？"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "还是说只有我和我的家人？不，"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "只有你一个人。"}, {"type": "subtitle", "time": 2957.24, "timestamp": "00:49:17", "text": "我认为你站在自己这边。"}, {"type": "subtitle", "time": 2964.39, "timestamp": "00:49:24", "text": "哦，等等。我不能把责任推到你身上。不是"}, {"type": "subtitle", "time": 2967.109, "timestamp": "00:49:27", "text": "那里。"}, {"type": "subtitle", "time": 2970.589, "timestamp": "00:49:30", "text": "显示项目。我的意思是，我可以放"}, {"type": "subtitle", "time": 2971.7, "timestamp": "00:49:31", "text": "喜欢"}, {"type": "subtitle", "time": 2972.829, "timestamp": "00:49:32", "text": "[音乐]"}, {"type": "subtitle", "time": 2977.069, "timestamp": "00:49:37", "text": "我能做到。"}, {"type": "subtitle", "time": 2980.47, "timestamp": "00:49:40", "text": "A 你有自己的定制麦克风。哦，我的"}, {"type": "subtitle", "time": 2982.8, "timestamp": "00:49:42", "text": "天哪，所以"}, {"type": "subtitle", "time": 2984.91, "timestamp": "00:49:44", "text": "[音乐]"}, {"type": "subtitle", "time": 2986.75, "timestamp": "00:49:46", "text": "可爱的。"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "呃，好的。"}]
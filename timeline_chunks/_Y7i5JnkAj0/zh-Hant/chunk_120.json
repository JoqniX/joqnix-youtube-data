[{"type": "subtitle", "time": 7208.709, "timestamp": "02:00:08", "text": "我不會放棄太多。"}, {"type": "subtitle", "time": 7216.709, "timestamp": "02:00:16", "text": "不錯。我想是啊，放手吧。我喜歡動物，沒有動物。我不能那樣做。不，不，不。"}, {"type": "subtitle", "time": 7227.189, "timestamp": "02:00:27", "text": "你得像動物一樣。你應該像動物一樣。像綿羊一樣。"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "誰？是你。我？青蛙。怎麼才能像青蛙？我的"}, {"type": "subtitle", "time": 7259.43, "timestamp": "02:00:59", "text": "她真的做到了。我"}]
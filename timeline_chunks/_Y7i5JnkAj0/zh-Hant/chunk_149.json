[{"type": "subtitle", "time": 8943.59, "timestamp": "02:29:03", "text": "我從來沒做過任何讓自己"}, {"type": "subtitle", "time": 8945.99, "timestamp": "02:29:05", "text": "更酷的事"}, {"type": "subtitle", "time": 8959.429, "timestamp": "02:29:19", "text": "。我生來就很酷。像素化的像素化不重要。我看著你，你這該死的像素生物，但你看錯地方了。哦"}, {"type": "subtitle", "time": 8992.79, "timestamp": "02:29:52", "text": "不。觸摸不好。"}]
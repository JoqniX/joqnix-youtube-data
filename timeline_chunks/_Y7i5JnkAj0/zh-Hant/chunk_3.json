[{"type": "subtitle", "time": 180.47, "timestamp": "00:03:00", "text": "好的。嗯，在我切換到VR聊天之前，我"}, {"type": "subtitle", "time": 183.509, "timestamp": "00:03:03", "text": "想說，嗯，這將是我"}, {"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "最後一次直播。說實話，我本來"}, {"type": "subtitle", "time": 188.869, "timestamp": "00:03:08", "text": "想做幾次直播的。我確實"}, {"type": "subtitle", "time": 193.27, "timestamp": "00:03:13", "text": "答應過會直播幾次，但很遺憾我現在沒時間。"}, {"type": "subtitle", "time": 197.50900000000001, "timestamp": "00:03:17", "text": "我現在真的非常非常"}, {"type": "subtitle", "time": 203.99, "timestamp": "00:03:23", "text": "抱歉。但這真是太糟糕了。沒關係。"}, {"type": "subtitle", "time": 207.11, "timestamp": "00:03:27", "text": "但只要我今晚能直播一次"}, {"type": "subtitle", "time": 210.07, "timestamp": "00:03:30", "text": "，那就一切都好。  一切都"}, {"type": "subtitle", "time": 212.309, "timestamp": "00:03:32", "text": "很好。"}, {"type": "subtitle", "time": 215.99, "timestamp": "00:03:35", "text": "嗯，是的，我已經很久沒打開我的"}, {"type": "subtitle", "time": 219.50900000000001, "timestamp": "00:03:39", "text": "串流軟體了。我"}, {"type": "subtitle", "time": 222.63, "timestamp": "00:03:42", "text": "可能不太擅長這個，但讓我們"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "盡力享受今天吧。好的。呃，讓我來"}, {"type": "subtitle", "time": 230.39, "timestamp": "00:03:50", "text": "處理一下這裡的事情。一"}, {"type": "subtitle", "time": 232.309, "timestamp": "00:03:52", "text": "秒鐘。  嗯"}, {"type": "subtitle", "time": 235.50900000000001, "timestamp": "00:03:55", "text": "，今天我們將邀請到阿斯特拉"}, {"type": "subtitle", "time": 237.67000000000002, "timestamp": "00:03:57", "text": "和賈斯米娜。"}]
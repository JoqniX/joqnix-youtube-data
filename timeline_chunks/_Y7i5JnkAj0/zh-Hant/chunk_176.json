[{"type": "subtitle", "time": 10562.469, "timestamp": "02:56:02", "text": "問題。跳過吧。  好了，我已經完成了。這就是"}, {"type": "subtitle", "time": 10581.67, "timestamp": "02:56:21", "text": "問題所在。  喝。"}, {"type": "subtitle", "time": 10597.75, "timestamp": "02:56:37", "text": "喝。  哦。  好的。  糟了，我"}, {"type": "subtitle", "time": 10600.55, "timestamp": "02:56:40", "text": "撞牆了。"}, {"type": "subtitle", "time": 10609.67, "timestamp": "02:56:49", "text": "哦，輪到你了。  我的天啊。  誰知道呢？  我知道。  搞什麼鬼，兄弟？兄弟，我揍你一頓。"}]
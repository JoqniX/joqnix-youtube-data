[{"type": "subtitle", "time": 1217.75, "timestamp": "00:20:17", "text": "要喝一杯，讓今晚成為一個難忘的夜晚。你好。  這將會是一個令人難忘的夜晚。  茉莉在"}, {"type": "subtitle", "time": 1220.15, "timestamp": "00:20:20", "text": "哪裡？我不能，我必須……你可以戳一下別人。"}, {"type": "subtitle", "time": 1224.549, "timestamp": "00:20:24", "text": "什麼？"}, {"type": "subtitle", "time": 1230.63, "timestamp": "00:20:30", "text": "你可以輕輕戳一下別人。  那確實有這麼"}, {"type": "subtitle", "time": 1238.549, "timestamp": "00:20:38", "text": "一回事。  好的。"}]
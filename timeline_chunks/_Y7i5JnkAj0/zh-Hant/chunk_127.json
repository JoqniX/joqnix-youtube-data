[{"type": "subtitle", "time": 7620.79, "timestamp": "02:07:00", "text": "怎麼提醒你要幫耳機充電"}, {"type": "subtitle", "time": 7622.709, "timestamp": "02:07:02", "text": "？ 5分鐘。好的。什麼？呃，就是盯著別人看，呃，我好像很沉默。我會躲在角落裡，躲在牆後面。我"}, {"type": "subtitle", "time": 7652.31, "timestamp": "02:07:32", "text": "會看著別人說話，然後想，「哇，這才是說話。」是啊，這很詭異。那就是"}, {"type": "chat", "time": 7667.973, "timestamp": "02:07:47", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "我不知道怎麼互動"}]
[{"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "我要改一下我的「不要放水」。  真是莫名其妙！為什麼？為什麼？"}, {"type": "subtitle", "time": 941.189, "timestamp": "00:15:41", "text": "睫毛膏。  兄弟，"}, {"type": "subtitle", "time": 945.03, "timestamp": "00:15:45", "text": "為什麼是我的錯？  我們出去吧。兄弟，我們出去玩吧。  我們走吧。  我們走吧。"}, {"type": "subtitle", "time": 953.749, "timestamp": "00:15:53", "text": "等等，他去哪了？  我的天啊。"}]
[{"type": "subtitle", "time": 5820.39, "timestamp": "01:37:00", "text": "。至少你收到了這麼多可愛的簡訊。好的，我會告訴你的"}, {"type": "subtitle", "time": 5839.59, "timestamp": "01:37:19", "text": "等等，她會加入嗎"}, {"type": "subtitle", "time": 5852.229, "timestamp": "01:37:32", "text": "？她會加入。是的，加入我們。別再和Shoro調情了"}, {"type": "subtitle", "time": 5867.189, "timestamp": "01:37:47", "text": "別。這是我的選擇。我走了，兄弟。你覺得房間裡誰最了解你？"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "誰了解？我的意思是，我就像一本橡樹百科全書。"}]
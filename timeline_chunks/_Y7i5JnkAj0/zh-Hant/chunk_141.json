[{"type": "subtitle", "time": 8463.19, "timestamp": "02:21:03", "text": "我之前說過這個"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "。"}, {"type": "subtitle", "time": 8466.71, "timestamp": "02:21:06", "text": "所以我可以跳過這個。哦，"}, {"type": "subtitle", "time": 8473.67, "timestamp": "02:21:13", "text": "在那之前喝酒，鏡頭都會拍到喝酒喝酒喝酒。我比較喜歡模仿嗎？你想要爭議還是不想要爭議？你想要爭議還是不想要？等一下。我不"}, {"type": "subtitle", "time": 8473.99, "timestamp": "02:21:13", "text": "知道。我不知道。你什麼意思？我不知道。那個人是不是先模仿了某人"}, {"type": "subtitle", "time": 8497.11, "timestamp": "02:21:37", "text": "？哦。哦。我的天哪。"}, {"type": "subtitle", "time": 8503.11, "timestamp": "02:21:43", "text": "我剛才突然想到了"}, {"type": "subtitle", "time": 8505.59, "timestamp": "02:21:45", "text": "。"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "呃，不。別開玩笑。狗說。不。什麼？"}, {"type": "subtitle", "time": 8509.349, "timestamp": "02:21:49", "text": "你在想什麼？"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "呃，什麼？我確實想要……我很"}, {"type": "subtitle", "time": 8512.95, "timestamp": "02:21:52", "text": "好奇。我們會說什麼呢"}, {"type": "subtitle", "time": 8519.27, "timestamp": "02:21:59", "text": "？但我又想，「不，我應該。」你知道嗎？好吧。好吧。好吧。好吧。猜猜看。那"}]
[{"type": "subtitle", "time": 14281.11, "timestamp": "03:58:01", "text": "言っていいのか、何を言ってはいけないのか？"}, {"type": "subtitle", "time": 14283.91, "timestamp": "03:58:03", "text": "うん。 そして、それは"}, {"type": "subtitle", "time": 14289.75, "timestamp": "03:58:09", "text": "私の頭の中で長い思考プロセスへと発展した。"}, {"type": "subtitle", "time": 14293.51, "timestamp": "03:58:13", "text": "そして私はここで"}, {"type": "subtitle", "time": 14295.99, "timestamp": "03:58:15", "text": "頭に浮かんだことを何でも言っていますが、同時に、"}, {"type": "subtitle", "time": 14304.07, "timestamp": "03:58:24", "text": "この用語に新しい言葉が必要だと思うので、この用語に新しい言葉が必要だと思います。ええと、"}, {"type": "subtitle", "time": 14314.229, "timestamp": "03:58:34", "text": "口が軽いと言いたかったのですが、"}, {"type": "subtitle", "time": 14316.07, "timestamp": "03:58:36", "text": "それが正しい用語かどうかわかりませんが、"}, {"type": "subtitle", "time": 14318.87, "timestamp": "03:58:38", "text": "ええ、私は自分が何を言っているかに気をつけなければなりません"}, {"type": "subtitle", "time": 14320.79, "timestamp": "03:58:40", "text": "。"}, {"type": "chat", "time": 14321.299, "timestamp": "03:58:41", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "totally understandable as it cause chain responses"}, {"type": "subtitle", "time": 14322.87, "timestamp": "03:58:42", "text": "それで、"}, {"type": "subtitle", "time": 14327.349, "timestamp": "03:58:47", "text": "そう、ディオの件ね。  H、君は僕が"}, {"type": "subtitle", "time": 14333.75, "timestamp": "03:58:53", "text": "うん、"}, {"type": "subtitle", "time": 14337.349, "timestamp": "03:58:57", "text": "ハッシュハッシュはいいと思うよ。"}]
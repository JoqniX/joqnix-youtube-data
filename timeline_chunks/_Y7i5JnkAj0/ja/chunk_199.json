[{"type": "subtitle", "time": 11943.19, "timestamp": "03:19:03", "text": "でも、ストリーミングに戻ってきた時にも言ったと思うけど、自分のやりたい"}, {"type": "subtitle", "time": 11950.95, "timestamp": "03:19:10", "text": "ことをやりたいだけなんです。"}, {"type": "subtitle", "time": 11956.469, "timestamp": "03:19:16", "text": "もう自分をインド人ユーチューバーとして宣伝することはないと思うけど、"}, {"type": "subtitle", "time": 11976.63, "timestamp": "03:19:36", "text": "ジョックをインド人ユーチューバーとして常に結びつける遺産というか歴史のようなものは存在するし、それはそういうものだ"}, {"type": "subtitle", "time": 11979.67, "timestamp": "03:19:39", "text": "。 うん。 ええ、そうです、"}, {"type": "subtitle", "time": 11981.99, "timestamp": "03:19:41", "text": "私はインド人です。私はインド人としてスタートしました。"}, {"type": "subtitle", "time": 11985.349, "timestamp": "03:19:45", "text": "ええ、そうですね。 ええ、そうですね。"}, {"type": "subtitle", "time": 11987.91, "timestamp": "03:19:47", "text": "私は一体何を言っているんだ？"}, {"type": "subtitle", "time": 11992.07, "timestamp": "03:19:52", "text": "でも、あなたにも理解してもらえるといいなと思っています。 よし。"}, {"type": "subtitle", "time": 11995.75, "timestamp": "03:19:55", "text": "ええと、つまり、私はいつも、"}]
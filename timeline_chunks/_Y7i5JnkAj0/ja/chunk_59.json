[{"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "、いいよ。"}, {"type": "subtitle", "time": 3550.71, "timestamp": "00:59:10", "text": "結局、こんなことがあった後、この"}, {"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "話から何を学んだの？ ブンティ・タンは"}, {"type": "subtitle", "time": 3559.99, "timestamp": "00:59:19", "text": "母親のせいで全ての苦しみを味わった。 彼女は最初、"}, {"type": "subtitle", "time": 3561.43, "timestamp": "00:59:21", "text": "金持ちの男と結婚すると思っていた。 しかし、"}, {"type": "subtitle", "time": 3563.67, "timestamp": "00:59:23", "text": "その男は醜かった。 その男は"}, {"type": "subtitle", "time": 3566.87, "timestamp": "00:59:26", "text": "読み書きができなかった。 その男は貧乏で、"}, {"type": "subtitle", "time": 3569.109, "timestamp": "00:59:29", "text": "子供がいた。 彼女には責任があり、"}, {"type": "subtitle", "time": 3572.069, "timestamp": "00:59:32", "text": "昨夜は彼女の子供だったのだから、彼女は子供を置いていくことはできない"}, {"type": "subtitle", "time": 3572.549, "timestamp": "00:59:32", "text": "。"}, {"type": "subtitle", "time": 3572.87, "timestamp": "00:59:32", "text": "うん。"}, {"type": "subtitle", "time": 3575.75, "timestamp": "00:59:35", "text": "では、彼女はその見返りに何を得たのか？ その女の子は"}, {"type": "subtitle", "time": 3578.63, "timestamp": "00:59:38", "text": "美しく、読み書きもでき、頭が良かったので、"}, {"type": "subtitle", "time": 3580.63, "timestamp": "00:59:40", "text": "文字通り一生懸命働いてベンティよりも多く稼ぐことができた"}, {"type": "subtitle", "time": 3583.109, "timestamp": "00:59:43", "text": "。"}, {"type": "subtitle", "time": 3583.67, "timestamp": "00:59:43", "text": "うん。"}, {"type": "subtitle", "time": 3586.23, "timestamp": "00:59:46", "text": "良い人生を送れただろうに。 しかし、"}, {"type": "subtitle", "time": 3590.15, "timestamp": "00:59:50", "text": "母親が「彼女は金目当てだ」と言ったからといって、"}, {"type": "subtitle", "time": 3593.109, "timestamp": "00:59:53", "text": "彼女は何も得られなかった。 彼女には世話をしなければならない子供がいる"}, {"type": "subtitle", "time": 3595.67, "timestamp": "00:59:55", "text": "。 彼女は"}, {"type": "subtitle", "time": 3598.15, "timestamp": "00:59:58", "text": "大学在学中に休学期間があった。 彼女は学位も持っていないし、"}]
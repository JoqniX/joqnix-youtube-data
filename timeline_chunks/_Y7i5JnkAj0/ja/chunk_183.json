[{"type": "subtitle", "time": 10992.23, "timestamp": "03:03:12", "text": "私のコミュニティ投稿に、私の神様、このチャットみたいなものに、"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "新しい"}, {"type": "subtitle", "time": 10996.389, "timestamp": "03:03:16", "text": "章だと書いて書いたんです。"}, {"type": "subtitle", "time": 10999.59, "timestamp": "03:03:19", "text": "これは明らかに新たな章の始まりであり、"}, {"type": "subtitle", "time": 11001.75, "timestamp": "03:03:21", "text": "私はこれから多くの"}, {"type": "subtitle", "time": 11003.51, "timestamp": "03:03:23", "text": "新しいことに集中していくつもりです。   これからたくさんの"}, {"type": "subtitle", "time": 11005.269, "timestamp": "03:03:25", "text": "新しいことに集中していくつもりです。"}, {"type": "subtitle", "time": 11012.07, "timestamp": "03:03:32", "text": "約束はできませんが、ずっと目指してきた方向へ進んでいきます。"}, {"type": "chat", "time": 11017.837, "timestamp": "03:03:37", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Will drop by whenever I can manUCkszU2WH9gy1mb0dV-11UJg/hf90Xv-jHeOR8gSxxrToBAUCkszU2WH9gy1mb0dV-11UJg/hf90Xv-jHeOR8gSxxrToBAUCkszU2WH9gy1mb0dV-11UJg/hf90Xv-jHeOR8gSxxrToBA"}, {"type": "subtitle", "time": 11018.389, "timestamp": "03:03:38", "text": "そして今、自分の"}, {"type": "subtitle", "time": 11024.389, "timestamp": "03:03:44", "text": "夢を追いかけ、自分"}, {"type": "subtitle", "time": 11028.87, "timestamp": "03:03:48", "text": "自身をさらに磨いていく場所、国へ向かっています。"}, {"type": "subtitle", "time": 11030.63, "timestamp": "03:03:50", "text": "うん。 だから、たとえしばらくの間、配信がなくても"}, {"type": "subtitle", "time": 11033.83, "timestamp": "03:03:53", "text": "、コンテンツがなくても"}, {"type": "subtitle", "time": 11037.83, "timestamp": "03:03:57", "text": "、どれくらいの間か、どれくらいの間か、ええ"}]
[{"type": "subtitle", "time": 9061.91, "timestamp": "02:31:01", "text": "あなたには何か隠れた才能がありますか？"}, {"type": "subtitle", "time": 9070.95, "timestamp": "02:31:10", "text": "私には隠れた才能が2つある。   よく"}, {"type": "subtitle", "time": 9074.07, "timestamp": "02:31:14", "text": "やることなんだけど、"}, {"type": "subtitle", "time": 9076.469, "timestamp": "02:31:16", "text": "人差し指と薬指を"}, {"type": "subtitle", "time": 9078.63, "timestamp": "02:31:18", "text": "後ろに曲げて、一緒に"}, {"type": "subtitle", "time": 9081.67, "timestamp": "02:31:21", "text": "ハートの形を作ることができるんだ。 わかった。 そして、私は自分の親指に触れることができます"}, {"type": "subtitle", "time": 9081.83, "timestamp": "02:31:21", "text": "。   一体どういうことだよ"}, {"type": "subtitle", "time": 9084.23, "timestamp": "02:31:24", "text": "、兄弟？"}, {"type": "subtitle", "time": 9086.469, "timestamp": "02:31:26", "text": "うん。 本当に？ 指を"}, {"type": "subtitle", "time": 9087.75, "timestamp": "02:31:27", "text": "後ろに曲げると、"}, {"type": "subtitle", "time": 9090.389, "timestamp": "02:31:30", "text": "ほら、親指を完全に後ろに曲げることができる"}, {"type": "subtitle", "time": 9092.23, "timestamp": "02:31:32", "text": "。まるで全体が元に戻るようにね。"}, {"type": "subtitle", "time": 9093.75, "timestamp": "02:31:33", "text": "私は「あなたの才能は"}, {"type": "subtitle", "time": 9095.27, "timestamp": "02:31:35", "text": "隠しておいてほしい」と言いました。"}, {"type": "subtitle", "time": 9100.309, "timestamp": "02:31:40", "text": "ないの？ お前が気に入らなくても、俺は気にしない"}, {"type": "subtitle", "time": 9102.389, "timestamp": "02:31:42", "text": "。"}, {"type": "subtitle", "time": 9103.99, "timestamp": "02:31:43", "text": "彼らはここにいるのに、あなたは聞きたくない。   私の声を"}]
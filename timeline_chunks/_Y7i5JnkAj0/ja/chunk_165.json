[{"type": "subtitle", "time": 9909.19, "timestamp": "02:45:09", "text": "あなたの好きな飲​​み物は何ですか？"}, {"type": "subtitle", "time": 9910.71, "timestamp": "02:45:10", "text": "あのね？ 気にしないで、兄弟。"}, {"type": "subtitle", "time": 9913.429, "timestamp": "02:45:13", "text": "部屋がとても暑いので、行きます。 ああ、"}, {"type": "subtitle", "time": 9915.67, "timestamp": "02:45:15", "text": "なんてこった。"}, {"type": "subtitle", "time": 9918.389, "timestamp": "02:45:18", "text": "あなたの人生であなたのことを一番よく知っている人は誰ですか"}, {"type": "subtitle", "time": 9920.469, "timestamp": "02:45:20", "text": "？"}, {"type": "subtitle", "time": 9923.269, "timestamp": "02:45:23", "text": "家族、両親、父、母。 うん、お母さん、"}, {"type": "subtitle", "time": 9924.63, "timestamp": "02:45:24", "text": "お父さん。"}, {"type": "subtitle", "time": 9932.79, "timestamp": "02:45:32", "text": "去るべきだと思う。"}, {"type": "subtitle", "time": 9936.07, "timestamp": "02:45:36", "text": "締めくくりたいところだが、ジャスミンが負けた。"}, {"type": "subtitle", "time": 9938.55, "timestamp": "02:45:38", "text": "はい、そろそろ締めくくりましょう。"}, {"type": "subtitle", "time": 9941.429, "timestamp": "02:45:41", "text": "なぜ、つまり、あなたの最後の終わりはなぜだったのか、という意味です。"}, {"type": "subtitle", "time": 9947.91, "timestamp": "02:45:47", "text": "それは非常に有害なものだったが、"}, {"type": "subtitle", "time": 9949.83, "timestamp": "02:45:49", "text": "私はノアに「こんなことはしない」と言った"}, {"type": "subtitle", "time": 9952.309, "timestamp": "02:45:52", "text": "。"}, {"type": "subtitle", "time": 9954.95, "timestamp": "02:45:54", "text": "待って、ジェリーが最後の人だ。"}, {"type": "subtitle", "time": 9956.15, "timestamp": "02:45:56", "text": "最後にやってみよう。"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "最後の部分をやろう。 さあ、おいで。"}]
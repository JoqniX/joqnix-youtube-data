[{"type": "subtitle", "time": 8345.19, "timestamp": "02:19:05", "text": "あなたはこれまで、トラブルを避けるために嘘をついたことがありますか"}, {"type": "subtitle", "time": 8346.95, "timestamp": "02:19:06", "text": "？ うん。"}, {"type": "subtitle", "time": 8349.509, "timestamp": "02:19:09", "text": "悪い。"}, {"type": "subtitle", "time": 8349.99, "timestamp": "02:19:09", "text": "ジョーク。   それは"}, {"type": "subtitle", "time": 8352.629, "timestamp": "02:19:12", "text": "何だったのか？ 最後に"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "嘘をついたのはいつですか？そして、それはどんな嘘でしたか？"}, {"type": "subtitle", "time": 8364.07, "timestamp": "02:19:24", "text": "激怒。 バス。"}, {"type": "subtitle", "time": 8383.75, "timestamp": "02:19:43", "text": "あなたは答えませんでした。 黙れ。"}, {"type": "subtitle", "time": 8385.75, "timestamp": "02:19:45", "text": "私は答えた。"}, {"type": "subtitle", "time": 8391.11, "timestamp": "02:19:51", "text": "まず答えてください。 最後についた嘘は何だった？"}]
[{"type": "subtitle", "time": 8041.91, "timestamp": "02:14:01", "text": "瞬間があったんだ。VR"}, {"type": "subtitle", "time": 8045.03, "timestamp": "02:14:05", "text": "チャットで、僕と"}, {"type": "subtitle", "time": 8048.79, "timestamp": "02:14:08", "text": "友達3人で"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "ピクニックに行った時のこと。"}, {"type": "subtitle", "time": 8055.189, "timestamp": "02:14:15", "text": "うん、ピクニック。僕、えーと、名前は"}, {"type": "subtitle", "time": 8057.589, "timestamp": "02:14:17", "text": "プロフィールに書いてあるから、読みたい人は"}, {"type": "subtitle", "time": 8061.83, "timestamp": "02:14:21", "text": "読めばいい。えーと、マービン"}, {"type": "subtitle", "time": 8064.629, "timestamp": "02:14:24", "text": "と彼らだよ。うん。"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "目が痛いよ、兄弟。わかった。うん、すごく楽しかったよ"}, {"type": "subtitle", "time": 8071.35, "timestamp": "02:14:31", "text": "。それが"}, {"type": "subtitle", "time": 8074.629, "timestamp": "02:14:34", "text": "僕の好きなところの一つ。彼らが絵を描いて、僕も絵を描いて、"}, {"type": "subtitle", "time": 8076.47, "timestamp": "02:14:36", "text": "隅っこに座って、あの"}, {"type": "subtitle", "time": 8078.55, "timestamp": "02:14:38", "text": "ラブラブな二人が絵を描いてるのを見てたらすごく"}, {"type": "subtitle", "time": 8081.91, "timestamp": "02:14:41", "text": "幸せだった。ただ"}, {"type": "subtitle", "time": 8083.35, "timestamp": "02:14:43", "text": "見てただけ。"}, {"type": "subtitle", "time": 8084.31, "timestamp": "02:14:44", "text": "待って、なんで？"}, {"type": "subtitle", "time": 8087.189, "timestamp": "02:14:47", "text": "うん。"}, {"type": "subtitle", "time": 8095.43, "timestamp": "02:14:55", "text": "あら、正直、君は僕が欲しいの？ ブロック"}, {"type": "chat", "time": 8097.864, "timestamp": "02:14:57", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Jasmine changes accents real quick"}]
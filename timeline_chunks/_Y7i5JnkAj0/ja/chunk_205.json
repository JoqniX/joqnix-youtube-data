[{"type": "subtitle", "time": 12301.51, "timestamp": "03:25:01", "text": "ストリーミングとか音楽とか、そういう架空の"}, {"type": "subtitle", "time": 12307.349, "timestamp": "03:25:07", "text": "キャラクターとか、そういう私が本当に楽しんでいる活動に集約されるんです"}, {"type": "subtitle", "time": 12311.67, "timestamp": "03:25:11", "text": "。 アニメとか織物とか、よくわから"}, {"type": "subtitle", "time": 12313.67, "timestamp": "03:25:13", "text": "ないけど、"}, {"type": "subtitle", "time": 12319.349, "timestamp": "03:25:19", "text": "全部つながってる感じがするし、"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "たとえそこにいても、いつも"}, {"type": "subtitle", "time": 12326.389, "timestamp": "03:25:26", "text": "もっとつながってる感じがするよね。"}, {"type": "subtitle", "time": 12329.75, "timestamp": "03:25:29", "text": "インドでは織物は外国のものみたいなものだよね。"}, {"type": "subtitle", "time": 12335.429, "timestamp": "03:25:35", "text": "私たちには独自の"}, {"type": "subtitle", "time": 12337.349, "timestamp": "03:25:37", "text": "文化があるよね。"}, {"type": "subtitle", "time": 12340.309, "timestamp": "03:25:40", "text": "アニメとかは外国のものと"}, {"type": "subtitle", "time": 12342.79, "timestamp": "03:25:42", "text": "言えるけど、映画も"}, {"type": "subtitle", "time": 12345.429, "timestamp": "03:25:45", "text": "外国のものと言えるよね。でも、映画とかにはボリウッド、ハリウッド、モリウッド、トイウッドがあるよね。ハリウッドってあるのかな。わからないけど、"}, {"type": "subtitle", "time": 12359.99, "timestamp": "03:25:59", "text": "インドには映画に関して良いものがたくさんあるよね。"}]
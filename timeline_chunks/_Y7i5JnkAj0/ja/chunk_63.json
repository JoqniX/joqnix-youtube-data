[{"type": "subtitle", "time": 3785.43, "timestamp": "01:03:05", "text": "ああ、本当に久しぶりだね。 そうそう。 もちろん、私たちは"}, {"type": "subtitle", "time": 3788.71, "timestamp": "01:03:08", "text": "Why Dareに行くつもりよ、ダーリン？"}, {"type": "subtitle", "time": 3791.349, "timestamp": "01:03:11", "text": "それは事実ではない。   わかった"}, {"type": "subtitle", "time": 3793.75, "timestamp": "01:03:13", "text": "。 私の真実とは何か？ あなたの"}, {"type": "subtitle", "time": 3796.549, "timestamp": "01:03:16", "text": "お気に入りの飲みゲームは何ですか？また、その理由は？ 私はお"}, {"type": "subtitle", "time": 3799.19, "timestamp": "01:03:19", "text": "酒を飲みません。   わかった"}, {"type": "subtitle", "time": 3801.19, "timestamp": "01:03:21", "text": "。 冗談だよ。 あなたが選びたいものを何でも選んでください"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "待つ」をクリックしてください。 だから、あちこち回って"}, {"type": "subtitle", "time": 3811.349, "timestamp": "01:03:31", "text": "クリックしていかないといけないんです。"}, {"type": "subtitle", "time": 3811.75, "timestamp": "01:03:31", "text": "うん。"}, {"type": "subtitle", "time": 3814.63, "timestamp": "01:03:34", "text": "どこをクリックしますか？ 私は"}, {"type": "subtitle", "time": 3823.109, "timestamp": "01:03:43", "text": "ビールがお好きなら、一番好きなビールは何ですか？"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "あなたはビールが好きですか？"}, {"type": "subtitle", "time": 3828.87, "timestamp": "01:03:48", "text": "いいえ、私はお酒を飲みません。 私は"}, {"type": "subtitle", "time": 3830.15, "timestamp": "01:03:50", "text": "リンゴジュースを飲みます。"}, {"type": "subtitle", "time": 3832.549, "timestamp": "01:03:52", "text": "よし、次は君の番だ。"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "しかし、"}, {"type": "subtitle", "time": 3838.95, "timestamp": "01:03:58", "text": "これからは、"}]
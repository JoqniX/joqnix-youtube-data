[{"type": "subtitle", "time": 11102.15, "timestamp": "03:05:02", "text": "私を見たり、私を知ったり、"}, {"type": "subtitle", "time": 11104.95, "timestamp": "03:05:04", "text": "私と交流したりすれば、このことを理解できるかもしれません。 だからこそ、"}, {"type": "subtitle", "time": 11109.67, "timestamp": "03:05:09", "text": "配信したり何かを言ったりすることさえ、非常にリスクが高いのです。 私は"}, {"type": "subtitle", "time": 11116.15, "timestamp": "03:05:16", "text": "口を開けてただしゃべりまくって、とてもオープンになってしまう。"}, {"type": "subtitle", "time": 11121.349, "timestamp": "03:05:21", "text": "それは私にとって最悪で、最も悪い"}, {"type": "subtitle", "time": 11123.67, "timestamp": "03:05:23", "text": "ことだ。私は"}, {"type": "subtitle", "time": 11126.15, "timestamp": "03:05:26", "text": "それをコントロールできないけれど、同時に"}, {"type": "subtitle", "time": 11128.95, "timestamp": "03:05:28", "text": "コントロールしなければならない。 ええ、それが"}, {"type": "subtitle", "time": 11133.03, "timestamp": "03:05:33", "text": "私が"}, {"type": "subtitle", "time": 11137.19, "timestamp": "03:05:37", "text": "配信したくない理由の一つなんです"}, {"type": "subtitle", "time": 11141.67, "timestamp": "03:05:41", "text": "。だって、言ってはいけないことを喋ってしまうから。 そして"}, {"type": "subtitle", "time": 11145.75, "timestamp": "03:05:45", "text": "今、私は自分が心を開いて"}, {"type": "chat", "time": 11158.504, "timestamp": "03:05:58", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "no worries bro it was just bad encounter ya learn from mistake and move one"}]
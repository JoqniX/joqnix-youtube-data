[{"type": "subtitle", "time": 422.23, "timestamp": "00:07:02", "text": "愛情にとって有害。"}, {"type": "subtitle", "time": 425.35, "timestamp": "00:07:05", "text": "はい。 私は有害人間です。"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "愛情を込めて。"}, {"type": "subtitle", "time": 428.629, "timestamp": "00:07:08", "text": "俺は人間だよ、兄弟。 私はいじめっ子です。 私は"}, {"type": "subtitle", "time": 431.749, "timestamp": "00:07:11", "text": "有害人間です。 私に何を期待しているのですか？"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "いいえ、私たちは今でもあなたを愛しています。 私たちは今でも"}, {"type": "subtitle", "time": 433.589, "timestamp": "00:07:13", "text": "あなたを愛しています。 うん。"}, {"type": "subtitle", "time": 453.35, "timestamp": "00:07:33", "text": "あなたの配信を視聴できるはずです。"}, {"type": "subtitle", "time": 455.11, "timestamp": "00:07:35", "text": "いや。"}, {"type": "subtitle", "time": 456.87, "timestamp": "00:07:36", "text": "うん、配信見てるよ。 ストリーミング配信できます"}, {"type": "subtitle", "time": 458.39, "timestamp": "00:07:38", "text": "。 待って、待って、待って、待って、"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "待って。 ストリームを再生させてください。   何てことだ"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "。 プレイしないでください。"}, {"type": "subtitle", "time": 464.95, "timestamp": "00:07:44", "text": "ここで配信させてくれよ、兄弟。"}, {"type": "subtitle", "time": 467.909, "timestamp": "00:07:47", "text": "いいえ、それなら私には見えます。 いや。"}, {"type": "subtitle", "time": 471.51, "timestamp": "00:07:51", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 474.71, "timestamp": "00:07:54", "text": "自分の声を聞くのはすごく気まずいだろうな。 最近、自分の言動に"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "恥ずかしさを感じています。 え、"}]
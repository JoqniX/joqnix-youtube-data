[{"type": "subtitle", "time": 14822.07, "timestamp": "04:07:02", "text": "克服していかないといけないと思う。そうだね。自分の"}, {"type": "subtitle", "time": 14830.309, "timestamp": "04:07:10", "text": "恐れていることを克服するのは、やらなきゃいけないことだよね"}, {"type": "subtitle", "time": 14833.59, "timestamp": "04:07:13", "text": "？"}, {"type": "subtitle", "time": 14835.03, "timestamp": "04:07:15", "text": "実は、"}, {"type": "subtitle", "time": 14838.07, "timestamp": "04:07:18", "text": "配信をしようと思っていたんだけど、生活が"}, {"type": "subtitle", "time": 14840.469, "timestamp": "04:07:20", "text": "忙しくてできなかったんだ。 朝から晩までずっと配信していて、"}, {"type": "subtitle", "time": 14841.83, "timestamp": "04:07:21", "text": "今日を逃すところだった。"}, {"type": "subtitle", "time": 14845.349, "timestamp": "04:07:25", "text": "後悔していたよ。うん。それに、土壇場だったし"}, {"type": "subtitle", "time": 14850.07, "timestamp": "04:07:30", "text": "。正直、正直、正直、正直、"}, {"type": "subtitle", "time": 14855.83, "timestamp": "04:07:35", "text": "今日じゃなくて、30日じゃなくて、もっと前に配信したかったんだ"}, {"type": "chat", "time": 14859.324, "timestamp": "04:07:39", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "well ya life throws hardship ya gotta keep up the grind"}, {"type": "subtitle", "time": 14860.229, "timestamp": "04:07:40", "text": "。27日か28日とかに配信して、"}, {"type": "subtitle", "time": 14865.59, "timestamp": "04:07:45", "text": "ホラー配信とか全部終わらせたい。"}, {"type": "subtitle", "time": 14871.11, "timestamp": "04:07:51", "text": "約束の配信とか全部終わらせて、"}, {"type": "subtitle", "time": 14874.15, "timestamp": "04:07:54", "text": "あれこれ配信しなかったって後悔したくないんだ"}, {"type": "subtitle", "time": 14876.71, "timestamp": "04:07:56", "text": "。いや。えっと、せめて"}]
[{"type": "subtitle", "time": 6843.44, "timestamp": "01:54:03", "text": "うん。待って、ジャスミンにも。 ノー、ノー、ノー、ノー、ノー。ノーって言って。ノーって言って、"}, {"type": "subtitle", "time": 6845.44, "timestamp": "01:54:05", "text": "ノー、ノー、ノー、ノー、ノー。ノーって言って。ノーって言って、 ジョック。"}, {"type": "subtitle", "time": 6846.639, "timestamp": "01:54:06", "text": "ジョック。 悪いこと？ジョック、"}, {"type": "subtitle", "time": 6848.0, "timestamp": "01:54:08", "text": "悪いこと？ジョック、 あなたに何か言ってるのよ。うん。"}, {"type": "subtitle", "time": 6850.0, "timestamp": "01:54:10", "text": "あなたに何か言ってるのよ。うん。 うん。触って。"}, {"type": "subtitle", "time": 6850.56, "timestamp": "01:54:10", "text": "うん。触って。 うん。うん。本当に？"}, {"type": "subtitle", "time": 6852.719, "timestamp": "01:54:12", "text": "うん。うん。本当に？ 今私を信じてる？確信してる"}, {"type": "subtitle", "time": 6854.4, "timestamp": "01:54:14", "text": "今私を信じてる？確信してる 。ノーって言って。もう一つあるんだ。"}, {"type": "subtitle", "time": 6857.119, "timestamp": "01:54:17", "text": "。ノーって言って。もう一つあるんだ。 言って、他のもう"}, {"type": "subtitle", "time": 6859.76, "timestamp": "01:54:19", "text": "言って、他のもう 一つにも教えて、そうすれば知ってるよ。"}, {"type": "subtitle", "time": 6862.639, "timestamp": "01:54:22", "text": "一つにも教えて、そうすれば知ってるよ。 ノー、ノー、ノー、ノー。うん。わかった。聞いて聞いて。あと"}, {"type": "subtitle", "time": 6870.07, "timestamp": "01:54:30", "text": "一つだけあるんだ。"}, {"type": "subtitle", "time": 6872.31, "timestamp": "01:54:32", "text": "うん。そして、モッドはあなたのストリームだから、"}, {"type": "subtitle", "time": 6874.79, "timestamp": "01:54:34", "text": "今送っても意味がない。"}, {"type": "subtitle", "time": 6878.79, "timestamp": "01:54:38", "text": "うん、それも本当だ。"}, {"type": "subtitle", "time": 6886.47, "timestamp": "01:54:46", "text": "こんにちは。"}, {"type": "subtitle", "time": 6889.669, "timestamp": "01:54:49", "text": "でもタイミングがね。もし彼女が"}, {"type": "subtitle", "time": 6893.91, "timestamp": "01:54:53", "text": "もう送ってきたとしたらどうだろう。そして"}, {"type": "subtitle", "time": 6896.55, "timestamp": "01:54:56", "text": "私は、どうやって彼女が そんなに早く潤滑油を塗ったのか"}]
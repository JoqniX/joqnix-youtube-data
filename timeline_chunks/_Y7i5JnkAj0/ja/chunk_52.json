[{"type": "subtitle", "time": 3128.79, "timestamp": "00:52:08", "text": "はい。   わかった"}, {"type": "subtitle", "time": 3131.03, "timestamp": "00:52:11", "text": "。"}, {"type": "subtitle", "time": 3141.109, "timestamp": "00:52:21", "text": "一方的な、一方的な、"}, {"type": "subtitle", "time": 3150.39, "timestamp": "00:52:30", "text": "つまり、バンディは"}, {"type": "subtitle", "time": 3153.589, "timestamp": "00:52:33", "text": "非常に裕福な家庭で育ったということだ。 わかった。   わかった"}, {"type": "subtitle", "time": 3153.99, "timestamp": "00:52:33", "text": "。"}, {"type": "subtitle", "time": 3156.71, "timestamp": "00:52:36", "text": "これはまるでブンティの豪邸のようだった。   まるで"}, {"type": "subtitle", "time": 3167.19, "timestamp": "00:52:47", "text": "大金持ちだ。 バンティは金持ちだった。 非常に裕福。 彼は"}, {"type": "subtitle", "time": 3170.39, "timestamp": "00:52:50", "text": "父親と同じように、世界で最も裕福な人物の一人だった。   わかった"}, {"type": "subtitle", "time": 3170.79, "timestamp": "00:52:50", "text": "。"}, {"type": "subtitle", "time": 3173.91, "timestamp": "00:52:53", "text": "しかし、バンディは"}, {"type": "subtitle", "time": 3175.99, "timestamp": "00:52:55", "text": "父親が金持ちだったため、教育を受ける必要がなかった。 だから彼は"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "教育の仕事はできなかった。 わかった。"}]
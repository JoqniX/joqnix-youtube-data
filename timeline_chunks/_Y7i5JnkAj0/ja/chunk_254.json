[{"type": "subtitle", "time": 15240.55, "timestamp": "04:14:00", "text": "。"}, {"type": "subtitle", "time": 15244.389, "timestamp": "04:14:04", "text": "今夜は寝坊します。あと数"}, {"type": "subtitle", "time": 15247.11, "timestamp": "04:14:07", "text": "日しかありません。"}, {"type": "subtitle", "time": 15250.389, "timestamp": "04:14:10", "text": "左、右？家族と過ごす。だから、"}, {"type": "subtitle", "time": 15253.429, "timestamp": "04:14:13", "text": "家族と時間を過ごすつもり。"}, {"type": "subtitle", "time": 15255.349, "timestamp": "04:14:15", "text": "うん、家族と過ごす時間の方が大切"}, {"type": "subtitle", "time": 15259.67, "timestamp": "04:14:19", "text": "。家族と過ごす時間は大切。うーん、"}, {"type": "subtitle", "time": 15263.11, "timestamp": "04:14:23", "text": "うん、まだ実感が湧かない。"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "前に言ったように、たぶん"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "飛行機に乗ったら、もしくは"}, {"type": "subtitle", "time": 15277.269, "timestamp": "04:14:37", "text": "家族に別れを告げたら、実感が湧いてくると思う。うん、うん"}, {"type": "subtitle", "time": 15287.99, "timestamp": "04:14:47", "text": "。本当に去るんだ。本当に去るんだ。"}, {"type": "chat", "time": 15293.878, "timestamp": "04:14:53", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "again lots of love all the best and always one step at a time can dm anytime will try to get back asap if ya do relax enjoy ride and keep of moving forward"}, {"type": "subtitle", "time": 15297.67, "timestamp": "04:14:57", "text": "訪問ビザか何かで来ない限り、もう直接会うことはない。もしくは、私が"}]
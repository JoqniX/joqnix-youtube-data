[{"type": "subtitle", "time": 5950.95, "timestamp": "01:39:10", "text": "、作ったよ。うん。オーケー。わあ。わあ。"}, {"type": "subtitle", "time": 5960.229, "timestamp": "01:39:20", "text": "え？かわいい。"}, {"type": "subtitle", "time": 5975.75, "timestamp": "01:39:35", "text": "えっと、"}, {"type": "subtitle", "time": 5978.229, "timestamp": "01:39:38", "text": "もし君が私たちと人生を交換できるとしたら、"}, {"type": "subtitle", "time": 5979.27, "timestamp": "01:39:39", "text": "彼女にアドバイスするの？"}, {"type": "subtitle", "time": 5982.87, "timestamp": "01:39:42", "text": "死ぬことと引き換えに命を交換する？"}, {"type": "subtitle", "time": 5983.669, "timestamp": "01:39:43", "text": "ああ、"}, {"type": "subtitle", "time": 5985.83, "timestamp": "01:39:45", "text": "つまり、彼女が死にかけているなら、"}, {"type": "subtitle", "time": 5994.39, "timestamp": "01:39:54", "text": "どんな？ なんてこった。"}, {"type": "subtitle", "time": 5996.95, "timestamp": "01:39:56", "text": "これは一体どういう質問なんだ？"}, {"type": "subtitle", "time": 5999.35, "timestamp": "01:39:59", "text": "うーん、"}]
[{"type": "subtitle", "time": 1216.789, "timestamp": "00:20:16", "text": "。"}, {"type": "subtitle", "time": 1217.75, "timestamp": "00:20:17", "text": "メッセージを受け取りました。   そこに"}, {"type": "subtitle", "time": 1220.15, "timestamp": "00:20:20", "text": "誰かいる。"}, {"type": "subtitle", "time": 1221.59, "timestamp": "00:20:21", "text": "私のサーバーに投稿しましょうか？"}, {"type": "subtitle", "time": 1224.549, "timestamp": "00:20:24", "text": "どれ？   わかりません"}, {"type": "subtitle", "time": 1230.63, "timestamp": "00:20:30", "text": "。 私の配信は再び途絶えてしまった。"}, {"type": "subtitle", "time": 1233.35, "timestamp": "00:20:33", "text": "確認してみます。 まあ、最終的にはあなた次第ですけどね"}, {"type": "subtitle", "time": 1235.43, "timestamp": "00:20:35", "text": "。"}, {"type": "subtitle", "time": 1238.549, "timestamp": "00:20:38", "text": "それをコラボレーション作品にしたんです。 では、"}, {"type": "subtitle", "time": 1241.83, "timestamp": "00:20:41", "text": "これを私のサーバーにプロモーションとして掲載してください。"}, {"type": "subtitle", "time": 1245.029, "timestamp": "00:20:45", "text": "うん。 うん。 あなたが望むなら。 既に"}, {"type": "subtitle", "time": 1254.95, "timestamp": "00:20:54", "text": "四つん這いのままでいるなら、"}]
[{"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "俺のベッドはどこだ、兄弟？"}, {"type": "subtitle", "time": 9610.389, "timestamp": "02:40:10", "text": "もう一度入手してください。   何てことだ"}, {"type": "subtitle", "time": 9623.27, "timestamp": "02:40:23", "text": "彼女は実際にそうした。"}, {"type": "subtitle", "time": 9626.07, "timestamp": "02:40:26", "text": "彼女は「ああ、なんてことだ」と言った"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "写真を撮りましたか？ ああ、私は持っていくはずだったのに、"}, {"type": "subtitle", "time": 9639.67, "timestamp": "02:40:39", "text": "ああ、待って。"}, {"type": "subtitle", "time": 9641.99, "timestamp": "02:40:41", "text": "彼はそれを配信で見た。"}, {"type": "subtitle", "time": 9649.75, "timestamp": "02:40:49", "text": "あなたが好きな曲の中で、一番恥ずかしい曲は何ですか"}, {"type": "subtitle", "time": 9651.27, "timestamp": "02:40:51", "text": "？"}, {"type": "subtitle", "time": 9656.71, "timestamp": "02:40:56", "text": "。"}]
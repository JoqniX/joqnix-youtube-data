[{"type": "subtitle", "time": 7208.709, "timestamp": "02:00:08", "text": "ああ、おい。わかった。もう終わり。なんてこった。隠れてる。さあ。ああ。なんてこった。わかった。"}, {"type": "subtitle", "time": 7216.709, "timestamp": "02:00:16", "text": "次。"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "。私は、あなたが、えーと、私が"}, {"type": "subtitle", "time": 7230.709, "timestamp": "02:00:30", "text": "今、物事を言う時の言い方で何か言うつもりだと思った。今でも時々、"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "？"}, {"type": "subtitle", "time": 7259.43, "timestamp": "02:00:59", "text": "、もう終わり。"}]
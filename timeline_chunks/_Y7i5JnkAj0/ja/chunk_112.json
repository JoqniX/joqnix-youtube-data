[{"type": "subtitle", "time": 6723.75, "timestamp": "01:52:03", "text": "馬鹿げたことを話すだけ？"}, {"type": "subtitle", "time": 6728.07, "timestamp": "01:52:08", "text": "よし。いや、それは実際つまらない。"}, {"type": "subtitle", "time": 6729.589, "timestamp": "01:52:09", "text": "いいえ。"}, {"type": "subtitle", "time": 6732.709, "timestamp": "01:52:12", "text": "私にやらせてください。私を信じてください"}, {"type": "subtitle", "time": 6736.39, "timestamp": "01:52:16", "text": "。私を信じてください。私にやらせてください。"}, {"type": "subtitle", "time": 6738.629, "timestamp": "01:52:18", "text": "次回はあなたにやらせます。いいえ、"}, {"type": "subtitle", "time": 6740.149, "timestamp": "01:52:20", "text": "約束します。"}, {"type": "subtitle", "time": 6741.99, "timestamp": "01:52:21", "text": "そんな子犬のような目で見ないでください。いいえ、それはしません"}, {"type": "subtitle", "time": 6742.95, "timestamp": "01:52:22", "text": "。"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "彼女に、"}, {"type": "subtitle", "time": 6748.709, "timestamp": "01:52:28", "text": "サーバーに満足していないので"}, {"type": "subtitle", "time": 6750.149, "timestamp": "01:52:30", "text": "辞めてほしいと、彼女のモデレーターにDMを送るように頼んでください。なんてことだ。いいえ。"}, {"type": "subtitle", "time": 6755.669, "timestamp": "01:52:35", "text": "彼女にそう頼んでください。"}, {"type": "subtitle", "time": 6757.35, "timestamp": "01:52:37", "text": "彼女にそうするように頼んでください。"}, {"type": "subtitle", "time": 6761.189, "timestamp": "01:52:41", "text": "それは愚かでした。"}, {"type": "subtitle", "time": 6762.709, "timestamp": "01:52:42", "text": "私は知りません。彼女と"}, {"type": "subtitle", "time": 6764.31, "timestamp": "01:52:44", "text": "モデレーターの関係を知らないのですか？"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "誰だか知らないでしょう。なぜそうしたいのですか？わかりました。わかりました。私は入力しています"}, {"type": "subtitle", "time": 6768.79, "timestamp": "01:52:48", "text": "。タップしています。"}, {"type": "subtitle", "time": 6769.35, "timestamp": "01:52:49", "text": "ああ、わかりました。タップしています。GMの"}, {"type": "subtitle", "time": 6773.03, "timestamp": "01:52:53", "text": "スクリーンショット。"}, {"type": "subtitle", "time": 6776.55, "timestamp": "01:52:56", "text": "なぜ？なぜスクリーンショットを撮らないのですか？いいえ"}]
[{"type": "subtitle", "time": 7321.75, "timestamp": "02:02:01", "text": "有名になりたい。"}, {"type": "subtitle", "time": 7323.189, "timestamp": "02:02:03", "text": "椅子を替えるよ。"}, {"type": "subtitle", "time": 7325.43, "timestamp": "02:02:05", "text": "ああ、答えがわかった。わかってる"}, {"type": "subtitle", "time": 7325.99, "timestamp": "02:02:05", "text": "。"}, {"type": "subtitle", "time": 7327.589, "timestamp": "02:02:07", "text": "その言葉言ってもいい？"}, {"type": "subtitle", "time": 7330.149, "timestamp": "02:02:10", "text": "何が君を有名にしたんだ、犬？"}, {"type": "subtitle", "time": 7330.79, "timestamp": "02:02:10", "text": "ああ、わかった"}, {"type": "subtitle", "time": 7332.87, "timestamp": "02:02:12", "text": "。待って、これに答える前に、"}, {"type": "subtitle", "time": 7337.03, "timestamp": "02:02:17", "text": "言っておきたいんだけど、ええ、今は、ええと、"}, {"type": "subtitle", "time": 7343.43, "timestamp": "02:02:23", "text": "間違った理由で有名になった。間違った理由で。"}, {"type": "subtitle", "time": 7344.229, "timestamp": "02:02:24", "text": "ええ。"}, {"type": "subtitle", "time": 7353.43, "timestamp": "02:02:33", "text": "将来は音楽か何かで有名になりたい。ええ、それが"}, {"type": "subtitle", "time": 7355.189, "timestamp": "02:02:35", "text": "私の願い。"}, {"type": "subtitle", "time": 7357.43, "timestamp": "02:02:37", "text": "音楽。ええと、"}, {"type": "subtitle", "time": 7359.189, "timestamp": "02:02:39", "text": "ヨガの後に繰り返すように言うよ。"}, {"type": "subtitle", "time": 7366.07, "timestamp": "02:02:46", "text": "音楽制作、"}, {"type": "subtitle", "time": 7368.709, "timestamp": "02:02:48", "text": "デジタル音楽のような音楽を教えるよ。"}, {"type": "subtitle", "time": 7370.47, "timestamp": "02:02:50", "text": "どういう意味だよ、兄弟？もし君が望むなら、いや、"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "いや。"}]
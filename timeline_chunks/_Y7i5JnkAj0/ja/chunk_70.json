[{"type": "subtitle", "time": 4202.229, "timestamp": "01:10:02", "text": "チャットで一番変なことをする。"}, {"type": "subtitle", "time": 4203.75, "timestamp": "01:10:03", "text": "次回。 次。 わかった、"}, {"type": "subtitle", "time": 4206.07, "timestamp": "01:10:06", "text": "考えさせて。"}, {"type": "subtitle", "time": 4211.669, "timestamp": "01:10:11", "text": "キャビア。"}, {"type": "subtitle", "time": 4213.43, "timestamp": "01:10:13", "text": "どうだった？"}, {"type": "subtitle", "time": 4215.669, "timestamp": "01:10:15", "text": "いや、それは違う。"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "バターのようなクリーミーなもの。 バターのような食感のもの"}, {"type": "subtitle", "time": 4221.11, "timestamp": "01:10:21", "text": "。 塩辛くてクリーミー。"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "バターのような感じだけど、食"}, {"type": "subtitle", "time": 4225.83, "timestamp": "01:10:25", "text": "感が違う。 だから"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "パンみたいなものと一緒に食べる。 クッキーみたいなもの"}, {"type": "subtitle", "time": 4231.11, "timestamp": "01:10:31", "text": "。 そうやって食べる。"}, {"type": "subtitle", "time": 4234.149, "timestamp": "01:10:34", "text": "正直に言うと、それほど話題になるほどの価値はないと思った"}, {"type": "subtitle", "time": 4245.83, "timestamp": "01:10:45", "text": "こんにちは。 えーと、"}, {"type": "subtitle", "time": 4256.87, "timestamp": "01:10:56", "text": "実際にこれについて話さなきゃいけない。 ああ、なんてことだ。"}]
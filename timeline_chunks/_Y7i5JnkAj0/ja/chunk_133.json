[{"type": "subtitle", "time": 7997.35, "timestamp": "02:13:17", "text": "、待って。まだ、えーと、一番"}, {"type": "subtitle", "time": 8002.709, "timestamp": "02:13:22", "text": "大切な思い出をしていたんだ。"}, {"type": "subtitle", "time": 8005.27, "timestamp": "02:13:25", "text": "違う、私は"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "何らかの"}, {"type": "subtitle", "time": 8010.629, "timestamp": "02:13:30", "text": "理由で誤って中指を立ててしまったんだ。鼻を触って"}, {"type": "subtitle", "time": 8012.39, "timestamp": "02:13:32", "text": "中指を立ててたよ。"}, {"type": "subtitle", "time": 8015.83, "timestamp": "02:13:35", "text": "配信してたよね。いや、鼻を触ってたら"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "中指が出たんだ。"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "なんで鼻を触ってたの？"}, {"type": "subtitle", "time": 8026.709, "timestamp": "02:13:46", "text": "メガネをいじってたから触ってたんだよ。"}, {"type": "subtitle", "time": 8032.229, "timestamp": "02:13:52", "text": "黙れ。彼女に話させて。無視されても構わないよ。"}, {"type": "subtitle", "time": 8036.629, "timestamp": "02:13:56", "text": "大丈夫。"}, {"type": "subtitle", "time": 8039.189, "timestamp": "02:13:59", "text": "無視されることに慣れてるんだから。"}, {"type": "subtitle", "time": 8039.83, "timestamp": "02:13:59", "text": "黙れ。ある"}]
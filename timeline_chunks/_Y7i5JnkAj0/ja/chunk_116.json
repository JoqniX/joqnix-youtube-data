[{"type": "subtitle", "time": 6971.189, "timestamp": "01:56:11", "text": "そういうのは嫌なんだ。"}, {"type": "subtitle", "time": 6973.35, "timestamp": "01:56:13", "text": "誰かのものを壊したくない。"}, {"type": "subtitle", "time": 6976.229, "timestamp": "01:56:16", "text": "彼らが何時に起きたか。それは違う。彼らが目を覚ましたら、"}, {"type": "subtitle", "time": 6980.07, "timestamp": "01:56:20", "text": "何かが欠けていることに気づく。何が"}, {"type": "subtitle", "time": 6983.03, "timestamp": "01:56:23", "text": "欠けていたの？"}, {"type": "subtitle", "time": 6987.99, "timestamp": "01:56:27", "text": "人間でさえ"}, {"type": "subtitle", "time": 6997.43, "timestamp": "01:56:37", "text": "何を聞きたかったの？"}, {"type": "subtitle", "time": 6999.51, "timestamp": "01:56:39", "text": "ステッカーを持っていると想像してください。わかった。そして、"}, {"type": "subtitle", "time": 7001.189, "timestamp": "01:56:41", "text": "「ああ、私は私の"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "そこにステッカーがあるように。「わかった。"}, {"type": "subtitle", "time": 7004.55, "timestamp": "01:56:44", "text": "ヘッドセットをつけて歩いたと想像してみて。朝"}, {"type": "subtitle", "time": 7006.79, "timestamp": "01:56:46", "text": "起きたらヘッドセットがない。どこで"}]
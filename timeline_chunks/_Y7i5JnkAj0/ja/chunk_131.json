[{"type": "subtitle", "time": 7862.229, "timestamp": "02:11:02", "text": "女の子に叫ぶのは楽しかった。痛い。いや"}, {"type": "subtitle", "time": 7863.669, "timestamp": "02:11:03", "text": "、面白くなかった。"}, {"type": "subtitle", "time": 7873.109, "timestamp": "02:11:13", "text": "なんで"}, {"type": "subtitle", "time": 7874.87, "timestamp": "02:11:14", "text": "殺すんだ？"}, {"type": "subtitle", "time": 7883.35, "timestamp": "02:11:23", "text": "どうすればいいんだ？"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "ホラーマップ、VHマップに連れて行かれて、私は"}, {"type": "subtitle", "time": 7889.35, "timestamp": "02:11:29", "text": "こう思った。「ねえ、ホラーゲームをプレイする代わりに"}, {"type": "subtitle", "time": 7892.149, "timestamp": "02:11:32", "text": "、これを叫ぼうよ。"}]
[{"type": "subtitle", "time": 3189.27, "timestamp": "00:53:09", "text": "ベンティは読み書きができなかった。 それでおしまい。"}, {"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "うん。"}, {"type": "subtitle", "time": 3194.549, "timestamp": "00:53:14", "text": "しかし一方で、パンはかつて、"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "貧しい家庭環境で暮らしていた。 わかった。"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "彼女は貧しかった。"}, {"type": "subtitle", "time": 3216.39, "timestamp": "00:53:36", "text": "しかし、ベンティ・ディアンは学業に非常に優れていた"}, {"type": "subtitle", "time": 3229.27, "timestamp": "00:53:49", "text": "彼女は大学で首席だった。 彼女は"}, {"type": "subtitle", "time": 3231.75, "timestamp": "00:53:51", "text": "奨学金を得て、ホグワーツで学ぶことができた"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "。"}, {"type": "subtitle", "time": 3238.95, "timestamp": "00:53:58", "text": "彼女はホグワーツ魔法魔術学校で教育を受けた。"}]
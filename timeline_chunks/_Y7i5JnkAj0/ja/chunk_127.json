[{"type": "subtitle", "time": 7620.79, "timestamp": "02:07:00", "text": "何かしたことある"}, {"type": "subtitle", "time": 7622.709, "timestamp": "02:07:02", "text": "？"}, {"type": "subtitle", "time": 7624.55, "timestamp": "02:07:04", "text": "クール。もっと"}, {"type": "subtitle", "time": 7626.87, "timestamp": "02:07:06", "text": "クールな人間になるために何かをしたことはない"}, {"type": "subtitle", "time": 7628.79, "timestamp": "02:07:08", "text": "。"}, {"type": "subtitle", "time": 7652.31, "timestamp": "02:07:32", "text": "関係ない。"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "お前のピクセル化された生き物を見てる"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "ああ、だめだ。"}, {"type": "subtitle", "time": 7665.03, "timestamp": "02:07:45", "text": "触り方が悪い。"}, {"type": "subtitle", "time": 7666.069, "timestamp": "02:07:46", "text": "お前の顔はそこにある。"}, {"type": "chat", "time": 7667.973, "timestamp": "02:07:47", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "残念だ。"}, {"type": "subtitle", "time": 7671.189, "timestamp": "02:07:51", "text": "触り方が悪いと文句を言った。"}, {"type": "subtitle", "time": 7678.79, "timestamp": "02:07:58", "text": "嘘じゃない。ここは"}]
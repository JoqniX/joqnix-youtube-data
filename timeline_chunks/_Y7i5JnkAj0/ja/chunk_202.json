[{"type": "subtitle", "time": 12122.95, "timestamp": "03:22:02", "text": "4月4日までに日本に到着します。 はい。"}, {"type": "subtitle", "time": 12126.79, "timestamp": "03:22:06", "text": "17時間のフライト。 だから17とか、よくわからないけど、"}, {"type": "subtitle", "time": 12129.67, "timestamp": "03:22:09", "text": "24時間以内には着くよ"}, {"type": "subtitle", "time": 12133.269, "timestamp": "03:22:13", "text": "ね？ フライトとして。"}, {"type": "subtitle", "time": 12136.229, "timestamp": "03:22:16", "text": "ええ、4月4日には"}, {"type": "subtitle", "time": 12139.03, "timestamp": "03:22:19", "text": "日本にいます。"}, {"type": "subtitle", "time": 12140.95, "timestamp": "03:22:20", "text": "私たちはもっと良くなるでしょう。 一歩ずつ進んでいきましょう。"}, {"type": "subtitle", "time": 12143.67, "timestamp": "03:22:23", "text": "はい。"}, {"type": "subtitle", "time": 12145.429, "timestamp": "03:22:25", "text": "お互いに好きなことを何でもすれば、"}, {"type": "subtitle", "time": 12148.07, "timestamp": "03:22:28", "text": "どうなるか分かるだろう、などと自分に言い聞かせてはいけない。 はい、もちろんです。"}, {"type": "subtitle", "time": 12155.429, "timestamp": "03:22:35", "text": "うん、うん、うん。 えっと、いや、いや、いや、いや。"}, {"type": "chat", "time": 12156.326, "timestamp": "03:22:36", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I will actually will take your hard work as motivation"}, {"type": "subtitle", "time": 12158.07, "timestamp": "03:22:38", "text": "私は何を言っていたんだっけ？ 待って。"}, {"type": "subtitle", "time": 12161.99, "timestamp": "03:22:41", "text": "うん、うん、うん。 だから、"}, {"type": "subtitle", "time": 12164.71, "timestamp": "03:22:44", "text": "自慢したいわけじゃないんです。"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "自慢しているわけではないんです。 私の場合、自分の"}, {"type": "chat", "time": 12171.282, "timestamp": "03:22:51", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "will try to be somewhere az well when we chat again"}, {"type": "subtitle", "time": 12173.11, "timestamp": "03:22:53", "text": "人生をめちゃくちゃにしようとしています。なぜなら、私は"}, {"type": "subtitle", "time": 12179.67, "timestamp": "03:22:59", "text": "利己的で、"}]
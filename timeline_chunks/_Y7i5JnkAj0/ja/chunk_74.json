[{"type": "subtitle", "time": 4440.63, "timestamp": "01:14:00", "text": "つまり、夜遊びをたくさんしたってこと"}, {"type": "subtitle", "time": 4442.63, "timestamp": "01:14:02", "text": "。言ってはいけないことって知ってる？"}, {"type": "subtitle", "time": 4447.189, "timestamp": "01:14:07", "text": "僕はビデオなんだ。僕がやったすごいことって、えーと、"}, {"type": "subtitle", "time": 4451.03, "timestamp": "01:14:11", "text": "何かカテゴリーとか、"}, {"type": "subtitle", "time": 4465.51, "timestamp": "01:14:25", "text": "実はよくわからないんだ。もし君が"}, {"type": "subtitle", "time": 4467.03, "timestamp": "01:14:27", "text": "山に登ったって言ったら、僕は"}, {"type": "subtitle", "time": 4470.229, "timestamp": "01:14:30", "text": "本当に信じるよ。"}, {"type": "subtitle", "time": 4472.87, "timestamp": "01:14:32", "text": "僕は山に登ったことはない。"}, {"type": "subtitle", "time": 4478.709, "timestamp": "01:14:38", "text": "。何を言えばいいのかわから"}, {"type": "subtitle", "time": 4487.99, "timestamp": "01:14:47", "text": "ダートバイクとか、"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "レースとか、そういうダートなことに挑戦したことある？"}, {"type": "subtitle", "time": 4495.51, "timestamp": "01:14:55", "text": "えーと、ドラッグレース。"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "ああ、ドラッグレース。"}, {"type": "subtitle", "time": 4498.95, "timestamp": "01:14:58", "text": "それはいいね。"}]
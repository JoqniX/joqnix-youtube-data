[{"type": "subtitle", "time": 489.43, "timestamp": "00:08:09", "text": "。"}, {"type": "subtitle", "time": 492.869, "timestamp": "00:08:12", "text": "こんにちは。 ええ、そうですね。 こんにちは。"}, {"type": "subtitle", "time": 494.869, "timestamp": "00:08:14", "text": "こんにちは。 しばらくここには来ていませんでした。"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "うん。 日本に行く予定ですか？ はい。 ええと、"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "4番目です。 えっと、4番目です。 はい。 私は去ります"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "。 私のコミュニティでのその件に関する発表"}, {"type": "subtitle", "time": 507.11, "timestamp": "00:08:27", "text": "。 今、やっとできた。 私はただ戻ってきただけです"}, {"type": "subtitle", "time": 507.99, "timestamp": "00:08:27", "text": "。   さあ行こう"}, {"type": "subtitle", "time": 510.39, "timestamp": "00:08:30", "text": "。"}, {"type": "subtitle", "time": 512.23, "timestamp": "00:08:32", "text": "再生できますか？"}, {"type": "subtitle", "time": 515.19, "timestamp": "00:08:35", "text": "再生できません。"}, {"type": "subtitle", "time": 516.55, "timestamp": "00:08:36", "text": "大丈夫です。"}, {"type": "subtitle", "time": 518.469, "timestamp": "00:08:38", "text": "すぐ戻ってきます。"}, {"type": "subtitle", "time": 526.47, "timestamp": "00:08:46", "text": "クエストには橋があります。 それが一番"}, {"type": "subtitle", "time": 528.23, "timestamp": "00:08:48", "text": "いいところだ。"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "Twitch もありますし、"}]
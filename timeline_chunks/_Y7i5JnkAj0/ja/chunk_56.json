[{"type": "subtitle", "time": 3368.549, "timestamp": "00:56:08", "text": "どうやら最初のシミュレーションの後、彼らは"}, {"type": "subtitle", "time": 3370.549, "timestamp": "00:56:10", "text": "互いに話をし始めたようだ。 彼らは出会い、"}, {"type": "subtitle", "time": 3372.95, "timestamp": "00:56:12", "text": "ゲームなどを一緒にするようになり、"}, {"type": "subtitle", "time": 3374.71, "timestamp": "00:56:14", "text": "VRチャートをプレイし始め、"}, {"type": "subtitle", "time": 3379.03, "timestamp": "00:56:19", "text": "マインクラフトをプレイし始め、そして出会った。 そして、"}, {"type": "subtitle", "time": 3381.109, "timestamp": "00:56:21", "text": "バンティはとても裕福な"}, {"type": "subtitle", "time": 3383.27, "timestamp": "00:56:23", "text": "家庭の出身だったので、"}, {"type": "subtitle", "time": 3386.47, "timestamp": "00:56:26", "text": "バンティの母親は、彼女の"}, {"type": "subtitle", "time": 3389.349, "timestamp": "00:56:29", "text": "友人がとても裕福であることを知りました。   わかった"}, {"type": "subtitle", "time": 3390.87, "timestamp": "00:56:30", "text": "。"}, {"type": "subtitle", "time": 3392.87, "timestamp": "00:56:32", "text": "彼女は裕福な家柄ではなく、"}, {"type": "subtitle", "time": 3394.309, "timestamp": "00:56:34", "text": "貧しい"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "家庭の出身だったようだ。"}, {"type": "subtitle", "time": 3395.75, "timestamp": "00:56:35", "text": "おお。"}, {"type": "subtitle", "time": 3399.43, "timestamp": "00:56:39", "text": "そこで彼女の母親は、バンディ・タンに"}, {"type": "subtitle", "time": 3403.19, "timestamp": "00:56:43", "text": "バンディをデートに誘うよう強要し始めた。"}, {"type": "subtitle", "time": 3406.87, "timestamp": "00:56:46", "text": "しかし、バンディ・バンディ・タイはバンディが好きではなかった。"}, {"type": "subtitle", "time": 3408.71, "timestamp": "00:56:48", "text": "しかし、彼女の母親は金持ちだからバンディを気に入っていたのだ"}, {"type": "subtitle", "time": 3410.309, "timestamp": "00:56:50", "text": "。"}, {"type": "subtitle", "time": 3412.23, "timestamp": "00:56:52", "text": "つまり、バンディは金目当てではなかったということだ。"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "。   では、あの"}]
[{"type": "subtitle", "time": 15485.67, "timestamp": "04:18:05", "text": "時間か1時間前に終わるはずだったのに、私はたくさんしゃべりました"}, {"type": "subtitle", "time": 15489.349, "timestamp": "04:18:09", "text": "。すごい。すごい。"}, {"type": "subtitle", "time": 15492.149, "timestamp": "04:18:12", "text": "だから、アストラとジャスミン、"}, {"type": "subtitle", "time": 15494.55, "timestamp": "04:18:14", "text": "今日はありがとう。そしてシャリサンも"}, {"type": "subtitle", "time": 15497.349, "timestamp": "04:18:17", "text": "。3人とも、"}, {"type": "subtitle", "time": 15499.59, "timestamp": "04:18:19", "text": "VRチャットで一緒に過ごしてくれて本当にありがとう"}, {"type": "subtitle", "time": 15503.51, "timestamp": "04:18:23", "text": "。そして、今夜"}, {"type": "chat", "time": 15504.191, "timestamp": "04:18:24", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEcyaaa sometime soon"}, {"type": "subtitle", "time": 15507.91, "timestamp": "04:18:27", "text": "私にとって忘れられない思い出を作ってくれてありがとう"}, {"type": "subtitle", "time": 15511.189, "timestamp": "04:18:31", "text": "。本当に本当に意味があります。3人には"}, {"type": "subtitle", "time": 15514.07, "timestamp": "04:18:34", "text": "永遠に感謝しています"}, {"type": "subtitle", "time": 15517.75, "timestamp": "04:18:37", "text": "。あなたたちは"}, {"type": "subtitle", "time": 15521.189, "timestamp": "04:18:41", "text": "私にとって本当に良い友達で、いつもそばにいてくれました"}, {"type": "subtitle", "time": 15523.03, "timestamp": "04:18:43", "text": "。"}, {"type": "subtitle", "time": 15525.189, "timestamp": "04:18:45", "text": "ありがとう。そして、これで"}, {"type": "subtitle", "time": 15532.63, "timestamp": "04:18:52", "text": "ストリームは終了です。"}, {"type": "subtitle", "time": 15535.91, "timestamp": "04:18:55", "text": "えっと、これに切り替えて、「"}, {"type": "subtitle", "time": 15538.389, "timestamp": "04:18:58", "text": "はい、ここで終わりにします」と言ってもいいと思います"}]
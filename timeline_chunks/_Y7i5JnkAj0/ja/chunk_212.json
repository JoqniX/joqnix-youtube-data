[{"type": "subtitle", "time": 12720.469, "timestamp": "03:32:00", "text": "音楽の学位を取得するつもりです。 運が良ければ、自分の"}, {"type": "subtitle", "time": 12723.11, "timestamp": "03:32:03", "text": "人生を何とか立て直して、溜まっている課題を片付けて、"}, {"type": "subtitle", "time": 12729.269, "timestamp": "03:32:09", "text": "学位を取って、"}, {"type": "subtitle", "time": 12732.87, "timestamp": "03:32:12", "text": "修士号を取って、それから"}, {"type": "subtitle", "time": 12735.429, "timestamp": "03:32:15", "text": "音楽に転向して、音楽の"}, {"type": "subtitle", "time": 12737.349, "timestamp": "03:32:17", "text": "学位を取って、音楽の修士号を取るとか、そういうのをできると思う。よくわからないけど、"}, {"type": "subtitle", "time": 12747.269, "timestamp": "03:32:27", "text": "学位がないと"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "どこにも行けないから、ちゃんと別の学位を取らないといけないだろうね。 いいえ、仕事すらなく、何もかも"}, {"type": "subtitle", "time": 12751.83, "timestamp": "03:32:31", "text": "失いました。   破産寸前になるだろう"}, {"type": "subtitle", "time": 12757.269, "timestamp": "03:32:37", "text": "。 ええ、それは"}, {"type": "subtitle", "time": 12761.349, "timestamp": "03:32:41", "text": "悲しい現実です。"}, {"type": "subtitle", "time": 12764.55, "timestamp": "03:32:44", "text": "ジオキャッシング。 ああ、それに関する動画は見たことがあるよ"}, {"type": "subtitle", "time": 12771.67, "timestamp": "03:32:51", "text": "地理情報検索は良いですね。 本当に楽しくて"}, {"type": "subtitle", "time": 12773.349, "timestamp": "03:32:53", "text": "ワクワクしました。"}, {"type": "chat", "time": 12774.358, "timestamp": "03:32:54", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 12776.229, "timestamp": "03:32:56", "text": "私は賛成します。 ありがとう。 ありがとう。"}]
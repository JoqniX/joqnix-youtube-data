[{"type": "subtitle", "time": 5110.629, "timestamp": "01:25:10", "text": "これは怖がってる。"}, {"type": "subtitle", "time": 5114.07, "timestamp": "01:25:14", "text": "待って、私はこれが欲しい。"}, {"type": "subtitle", "time": 5115.75, "timestamp": "01:25:15", "text": "これが欲しい？"}, {"type": "subtitle", "time": 5118.229, "timestamp": "01:25:18", "text": "これもらってもいい？"}, {"type": "subtitle", "time": 5120.31, "timestamp": "01:25:20", "text": "待って、どうやって"}, {"type": "subtitle", "time": 5134.629, "timestamp": "01:25:34", "text": "お気に入りにできたのに。"}, {"type": "subtitle", "time": 5137.11, "timestamp": "01:25:37", "text": "待って、忘れた。ところで、どうやって変更するの"}, {"type": "subtitle", "time": 5137.51, "timestamp": "01:25:37", "text": "？"}]
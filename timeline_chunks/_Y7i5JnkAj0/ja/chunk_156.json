[{"type": "subtitle", "time": 9368.63, "timestamp": "02:36:08", "text": "大丈夫だよ、犬。 大丈夫。"}, {"type": "subtitle", "time": 9370.15, "timestamp": "02:36:10", "text": "私の名前を使っても構いません。 心配しないで。"}, {"type": "subtitle", "time": 9374.79, "timestamp": "02:36:14", "text": "うん。 うん。 うん。 はい、できます。  Sh。 あなたが一番"}, {"type": "subtitle", "time": 9378.15, "timestamp": "02:36:18", "text": "多く言ったことを言いたかったんです。"}, {"type": "subtitle", "time": 9380.87, "timestamp": "02:36:20", "text": "私たちは知っています。 一番ではないけれど、お二人とも"}, {"type": "subtitle", "time": 9383.03, "timestamp": "02:36:23", "text": "同じくらいだと思います。   なんてこった。   なんてこった。"}, {"type": "subtitle", "time": 9396.55, "timestamp": "02:36:36", "text": "うん。 両者とも同等である。"}, {"type": "subtitle", "time": 9418.79, "timestamp": "02:36:58", "text": "これが、君と友達でいることの報いだ。   わかった"}]
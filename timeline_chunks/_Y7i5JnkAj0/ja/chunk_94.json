[{"type": "subtitle", "time": 5684.55, "timestamp": "01:34:44", "text": "私を見て。"}, {"type": "subtitle", "time": 5687.43, "timestamp": "01:34:47", "text": "こんにちは。最初は風船だと思ったけど、"}, {"type": "subtitle", "time": 5695.91, "timestamp": "01:34:55", "text": "生き物だ。生き物だ。わあ。"}, {"type": "subtitle", "time": 5698.87, "timestamp": "01:34:58", "text": "神話上の生き物だ。毛虫だ。"}]
[{"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "。"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "すごくバカなことをしちゃった。大丈夫だよ。"}, {"type": "subtitle", "time": 5896.709, "timestamp": "01:38:16", "text": "何？いや、私は観客だよ。私は遊んでない。"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "部屋が燃えてる。ここにいる誰かにしか言えないよ"}, {"type": "subtitle", "time": 5918.149, "timestamp": "01:38:38", "text": "。いや、私は遊んでない"}, {"type": "subtitle", "time": 5931.75, "timestamp": "01:38:51", "text": "いや、私は自分を救うよ"}, {"type": "subtitle", "time": 5934.149, "timestamp": "01:38:54", "text": "。私は自分を救うよ。私はわがままなんだ。オーケー、それでいいよ。"}]
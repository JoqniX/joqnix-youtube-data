[{"type": "subtitle", "time": 4324.149, "timestamp": "01:12:04", "text": "。"}, {"type": "subtitle", "time": 4326.31, "timestamp": "01:12:06", "text": "私は、"}, {"type": "subtitle", "time": 4329.189, "timestamp": "01:12:09", "text": "日本出身の人と会った。"}, {"type": "subtitle", "time": 4331.83, "timestamp": "01:12:11", "text": "正直にイエスかノーで答える必要がある。"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "うん。うん。私は、えーと、たぶんと言える"}, {"type": "subtitle", "time": 4338.63, "timestamp": "01:12:18", "text": "。オーケー。イエスかノーがあるの？"}, {"type": "subtitle", "time": 4339.83, "timestamp": "01:12:19", "text": "うん。たぶん。"}, {"type": "subtitle", "time": 4341.189, "timestamp": "01:12:21", "text": "うん。たぶんでもいい。"}, {"type": "subtitle", "time": 4349.189, "timestamp": "01:12:29", "text": "オーケー。"}, {"type": "subtitle", "time": 4361.51, "timestamp": "01:12:41", "text": "ステータス。えーと待って。リアルタイムでステータスがある"}, {"type": "subtitle", "time": 4362.79, "timestamp": "01:12:42", "text": "。 ああ、そうだね。そうだよ。"}, {"type": "subtitle", "time": 4364.47, "timestamp": "01:12:44", "text": "うん。そうだね。"}, {"type": "subtitle", "time": 4369.11, "timestamp": "01:12:49", "text": "えーと、"}, {"type": "subtitle", "time": 4373.35, "timestamp": "01:12:53", "text": "グループがステータスを何に設定するかを選ぶんだ。"}]
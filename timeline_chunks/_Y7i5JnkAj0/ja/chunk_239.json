[{"type": "subtitle", "time": 14341.11, "timestamp": "03:59:01", "text": "シーッ、シーッ。 うん、それは"}, {"type": "subtitle", "time": 14343.99, "timestamp": "03:59:03", "text": "いいアイデアだと思うよ。"}, {"type": "subtitle", "time": 14346.229, "timestamp": "03:59:06", "text": "有名な交差点へ向かう。"}, {"type": "chat", "time": 14348.061, "timestamp": "03:59:08", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "it not a loose mouth that for like those who talk bad words"}, {"type": "subtitle", "time": 14349.75, "timestamp": "03:59:09", "text": "観客対応、頑張ってください。 そうそう。 シヴァ横断。 以前は"}, {"type": "subtitle", "time": 14354.71, "timestamp": "03:59:14", "text": "YouTubeのライブストリームを見ていて、そこでは"}, {"type": "subtitle", "time": 14364.229, "timestamp": "03:59:24", "text": "、そうそう、"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "このカメラは日本から見えるよね？"}, {"type": "subtitle", "time": 14369.99, "timestamp": "03:59:29", "text": "カメラのように。 ああ、信号機の監視カメラか"}, {"type": "subtitle", "time": 14372.229, "timestamp": "03:59:32", "text": "何かだろう。 固定カメラの"}, {"type": "subtitle", "time": 14375.11, "timestamp": "03:59:35", "text": "ように、人々が横断したり、動いたりする様子をずっと見ているような感じですよね"}, {"type": "subtitle", "time": 14378.309, "timestamp": "03:59:38", "text": "？ ライブ"}, {"type": "subtitle", "time": 14381.59, "timestamp": "03:59:41", "text": "配信。 昔、あのイギリス横断の"}, {"type": "subtitle", "time": 14384.389, "timestamp": "03:59:44", "text": "番組をよく見ていたよ。 人々が歩いている様子"}, {"type": "subtitle", "time": 14387.189, "timestamp": "03:59:47", "text": "など。例えば月曜日は"}, {"type": "subtitle", "time": 14390.87, "timestamp": "03:59:50", "text": "忙しい日で、人々が歩いている。   もしかしたら、"}, {"type": "subtitle", "time": 14399.269, "timestamp": "03:59:59", "text": "難しいかもしれない。"}]
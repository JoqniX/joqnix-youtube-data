[{"type": "subtitle", "time": 9240.15, "timestamp": "02:34:00", "text": "自分のこういうところは好きだけど、"}, {"type": "subtitle", "time": 9244.469, "timestamp": "02:34:04", "text": "同時に嫌いでもあるんです。それは、私がとても"}, {"type": "subtitle", "time": 9250.07, "timestamp": "02:34:10", "text": "それは"}, {"type": "subtitle", "time": 9252.79, "timestamp": "02:34:12", "text": "常に憎むべきものであるべきだ。"}, {"type": "subtitle", "time": 9254.79, "timestamp": "02:34:14", "text": "うん。"}, {"type": "subtitle", "time": 9257.59, "timestamp": "02:34:17", "text": "好感度が高いのは、あなたもご存知でしょう。"}, {"type": "subtitle", "time": 9268.55, "timestamp": "02:34:28", "text": "何か問題でも？"}, {"type": "subtitle", "time": 9297.349, "timestamp": "02:34:57", "text": "チャットをプレイしている皆さんは、"}]
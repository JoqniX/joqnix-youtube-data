[{"type": "subtitle", "time": 6007.75, "timestamp": "01:40:07", "text": "うん、実際、イエスって言おうかと思ってるんだ。ほら、"}, {"type": "subtitle", "time": 6012.229, "timestamp": "01:40:12", "text": "考えてみてよ"}, {"type": "subtitle", "time": 6014.149, "timestamp": "01:40:14", "text": "、彼女は僕を殺す前に考えないだろうけど"}, {"type": "subtitle", "time": 6016.95, "timestamp": "01:40:16", "text": "。"}, {"type": "subtitle", "time": 6018.87, "timestamp": "01:40:18", "text": "正直、"}, {"type": "subtitle", "time": 6022.07, "timestamp": "01:40:22", "text": "もし"}, {"type": "subtitle", "time": 6027.669, "timestamp": "01:40:27", "text": "うん、僕の命は"}, {"type": "subtitle", "time": 6029.83, "timestamp": "01:40:29", "text": "貴重だから。 君の命も"}, {"type": "subtitle", "time": 6031.43, "timestamp": "01:40:31", "text": "貴重だ。 誰にも命をあげない。 それだけの"}, {"type": "chat", "time": 6033.944, "timestamp": "01:40:33", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "what you looking?"}, {"type": "subtitle", "time": 6035.43, "timestamp": "01:40:35", "text": "価値がある。"}]
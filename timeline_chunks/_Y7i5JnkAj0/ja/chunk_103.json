[{"type": "subtitle", "time": 6181.43, "timestamp": "01:43:01", "text": "。幸せな思い出。"}, {"type": "subtitle", "time": 6189.99, "timestamp": "01:43:09", "text": "ああ。"}, {"type": "subtitle", "time": 6191.83, "timestamp": "01:43:11", "text": "あなたの人生で。"}, {"type": "subtitle", "time": 6202.31, "timestamp": "01:43:22", "text": "ジョーク。"}, {"type": "subtitle", "time": 6205.669, "timestamp": "01:43:25", "text": "ああ、待って。彼は"}, {"type": "subtitle", "time": 6209.83, "timestamp": "01:43:29", "text": "あなたの声を聞いてなかった。ああ、神様。"}, {"type": "subtitle", "time": 6211.75, "timestamp": "01:43:31", "text": "何？"}, {"type": "subtitle", "time": 6215.109, "timestamp": "01:43:35", "text": "ああ、私は嫌い。私はこういう質問が苦手"}, {"type": "subtitle", "time": 6217.35, "timestamp": "01:43:37", "text": "。ああ、何が、何が、何が、何が、こんなに"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "難しいことなの？なぜ私は自分が好きなの？"}, {"type": "subtitle", "time": 6232.629, "timestamp": "01:43:52", "text": "彼はあなたじゃない、"}]
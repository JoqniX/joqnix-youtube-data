[{"type": "subtitle", "time": 14401.67, "timestamp": "04:00:01", "text": "ああ、"}, {"type": "subtitle", "time": 14403.269, "timestamp": "04:00:03", "text": "すべてに慣れてからでないとできません。"}, {"type": "subtitle", "time": 14406.229, "timestamp": "04:00:06", "text": "1ヶ月か2ヶ月かかるだろう。それ以上は誰にもわからない"}, {"type": "subtitle", "time": 14408.55, "timestamp": "04:00:08", "text": "。"}, {"type": "subtitle", "time": 14412.63, "timestamp": "04:00:12", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "そこに行って、撮影したり、何かしたりしたいです"}, {"type": "subtitle", "time": 14420.87, "timestamp": "04:00:20", "text": "。 特に"}, {"type": "subtitle", "time": 14423.03, "timestamp": "04:00:23", "text": "広告のようなものがあるのがいいですね。 いいえ、3D"}, {"type": "subtitle", "time": 14425.03, "timestamp": "04:00:25", "text": "広告のことです。あの、"}, {"type": "subtitle", "time": 14437.59, "timestamp": "04:00:37", "text": "建物から誰かが出てくるような没入感のあるタイプの3D広告、4Dとか5Dとか"}, {"type": "subtitle", "time": 14441.189, "timestamp": "04:00:41", "text": "6Dとか8Dとか、そういうクールなもので、"}, {"type": "subtitle", "time": 14445.189, "timestamp": "04:00:45", "text": "見て動かせるようなものです。 うん。"}, {"type": "subtitle", "time": 14447.99, "timestamp": "04:00:47", "text": "ええ、それもそこにあると思います。   よくわから"}]
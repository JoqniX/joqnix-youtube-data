[{"type": "subtitle", "time": 1323.11, "timestamp": "00:22:03", "text": "椅子に座っていた男だった。 その後は"}, {"type": "subtitle", "time": 1325.51, "timestamp": "00:22:05", "text": "、好きなようにして構いません"}, {"type": "subtitle", "time": 1327.19, "timestamp": "00:22:07", "text": "。"}, {"type": "subtitle", "time": 1349.909, "timestamp": "00:22:29", "text": "私がするべきことではなかったんです。"}, {"type": "subtitle", "time": 1368.71, "timestamp": "00:22:48", "text": "ところで、何をしているんですか？"}, {"type": "subtitle", "time": 1371.35, "timestamp": "00:22:51", "text": "右。 ああ、ジャスミン。"}]
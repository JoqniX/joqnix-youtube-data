[{"type": "subtitle", "time": 4683.51, "timestamp": "01:18:03", "text": "ジョーが誰と話しているのかを知った今、"}, {"type": "subtitle", "time": 4687.35, "timestamp": "01:18:07", "text": "嫉妬深い人はどんな顔をしているのかがわかります。"}, {"type": "subtitle", "time": 4689.27, "timestamp": "01:18:09", "text": "私は嫉妬していません。「ああ、わかりました」という感じです。   わかった"}, {"type": "subtitle", "time": 4691.59, "timestamp": "01:18:11", "text": "。"}, {"type": "subtitle", "time": 4693.669, "timestamp": "01:18:13", "text": "知識が豊富だ。"}, {"type": "subtitle", "time": 4698.07, "timestamp": "01:18:18", "text": "いつかからかってやるよ。」わかった。"}, {"type": "subtitle", "time": 4700.709, "timestamp": "01:18:20", "text": "ああ、それはできないよ。"}, {"type": "subtitle", "time": 4703.83, "timestamp": "01:18:23", "text": "知らない。好きな"}, {"type": "subtitle", "time": 4707.59, "timestamp": "01:18:27", "text": "人を選んで、"}, {"type": "subtitle", "time": 4711.83, "timestamp": "01:18:31", "text": "何？"}, {"type": "subtitle", "time": 4714.07, "timestamp": "01:18:34", "text": "うん、わからない。"}, {"type": "subtitle", "time": 4721.91, "timestamp": "01:18:41", "text": "冗談。"}, {"type": "subtitle", "time": 4723.91, "timestamp": "01:18:43", "text": "うーん、気分が悪い。"}, {"type": "subtitle", "time": 4726.709, "timestamp": "01:18:46", "text": "冗談を言っていいかわからない。参加できるかな。待って、"}, {"type": "subtitle", "time": 4729.03, "timestamp": "01:18:49", "text": "試させて。"}, {"type": "subtitle", "time": 4731.59, "timestamp": "01:18:51", "text": "彼女も続けられるよ。"}]
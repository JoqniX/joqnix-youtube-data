[{"type": "subtitle", "time": 180.47, "timestamp": "00:03:00", "text": "。 えっと、VRチャットに切り替える前に、"}, {"type": "subtitle", "time": 183.509, "timestamp": "00:03:03", "text": "これが私が行う"}, {"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "最後の配信になることを言っておきたいです。 正直なところ、いくつか配信をしてみたかったんです"}, {"type": "subtitle", "time": 188.869, "timestamp": "00:03:08", "text": "。"}, {"type": "subtitle", "time": 193.27, "timestamp": "00:03:13", "text": "いくつか配信すると約束しましたが、残念ながら今はそれができません"}, {"type": "subtitle", "time": 197.50900000000001, "timestamp": "00:03:17", "text": "。 本当に本当にごめんなさい"}, {"type": "subtitle", "time": 203.99, "timestamp": "00:03:23", "text": "。 しかし、それはタブーだ。 大丈夫です。"}, {"type": "subtitle", "time": 207.11, "timestamp": "00:03:27", "text": "でも、今夜1回でも配信できれば"}, {"type": "subtitle", "time": 210.07, "timestamp": "00:03:30", "text": "、それで十分です。"}, {"type": "subtitle", "time": 212.309, "timestamp": "00:03:32", "text": "すべて順調です。"}, {"type": "subtitle", "time": 215.99, "timestamp": "00:03:35", "text": "ええ、そうですね、"}, {"type": "subtitle", "time": 219.50900000000001, "timestamp": "00:03:39", "text": "ストリーミングソフトを長い間起動していません。 私は"}, {"type": "subtitle", "time": 222.63, "timestamp": "00:03:42", "text": "下手かもしれないけど、"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "今日は精一杯楽しもう。 わかった。 えっと、"}, {"type": "subtitle", "time": 230.39, "timestamp": "00:03:50", "text": "ここのあれこれ直させてください。  1"}, {"type": "subtitle", "time": 232.309, "timestamp": "00:03:52", "text": "秒。   えっと"}, {"type": "subtitle", "time": 235.50900000000001, "timestamp": "00:03:55", "text": "、今日はアストラ"}, {"type": "subtitle", "time": 237.67000000000002, "timestamp": "00:03:57", "text": "とジャスミナが参加してくれます。"}]
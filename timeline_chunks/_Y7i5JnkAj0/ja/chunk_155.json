[{"type": "subtitle", "time": 9300.55, "timestamp": "02:35:00", "text": "あなたが理想のVR"}, {"type": "subtitle", "time": 9304.389, "timestamp": "02:35:04", "text": "ワールドを創造するために開発を手伝ってくれます。 どんな感じになるだろうか？"}, {"type": "subtitle", "time": 9306.79, "timestamp": "02:35:06", "text": "私は自分の現実世界を創造するだろう。 いいえ。なぜ"}, {"type": "subtitle", "time": 9315.91, "timestamp": "02:35:15", "text": "私は、以前のように、インドの神話の城のような、ちゃんとした"}, {"type": "subtitle", "time": 9317.83, "timestamp": "02:35:17", "text": "ゴールデンイストのようなテーマを作成し、以前の"}, {"type": "subtitle", "time": 9322.87, "timestamp": "02:35:22", "text": "ダンジョンは、"}, {"type": "subtitle", "time": 9334.309, "timestamp": "02:35:34", "text": "基本的に私がストリームで使用する城の地下のダンジョンのサンセットのようなちゃんとしたバーになります。"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "うん。   わかった"}, {"type": "subtitle", "time": 9349.83, "timestamp": "02:35:49", "text": "これだ。"}, {"type": "subtitle", "time": 9352.87, "timestamp": "02:35:52", "text": "以前にもやったことがある。 待って。"}, {"type": "subtitle", "time": 9356.79, "timestamp": "02:35:56", "text": "ええ、今彼女はここにいます。 つまり、"}]
[{"type": "subtitle", "time": 9841.429, "timestamp": "02:44:01", "text": "。"}, {"type": "subtitle", "time": 9844.15, "timestamp": "02:44:04", "text": "うん、"}, {"type": "subtitle", "time": 9845.83, "timestamp": "02:44:05", "text": "私もVRが欲しい。"}, {"type": "subtitle", "time": 9847.83, "timestamp": "02:44:07", "text": "ああ、あなたは全然"}, {"type": "subtitle", "time": 9850.63, "timestamp": "02:44:10", "text": "買わないんですね。 うまくいってないよ、兄弟。 それは"}, {"type": "subtitle", "time": 9871.91, "timestamp": "02:44:31", "text": "基地で知り合った友人の第一印象はどうでしたか？ 私には基地の友達がいません。"}, {"type": "subtitle", "time": 9880.63, "timestamp": "02:44:40", "text": "私には兄弟がいる。 私には"}, {"type": "subtitle", "time": 9881.83, "timestamp": "02:44:41", "text": "親友がいません。"}, {"type": "subtitle", "time": 9884.389, "timestamp": "02:44:44", "text": "私はその人を親友とは呼ばない。"}]
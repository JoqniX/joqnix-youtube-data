[{"type": "subtitle", "time": 2580.39, "timestamp": "00:43:00", "text": "うん。 だから、私はここでのそういう考え方が好きではない"}, {"type": "subtitle", "time": 2581.43, "timestamp": "00:43:01", "text": "。"}, {"type": "subtitle", "time": 2620.63, "timestamp": "00:43:40", "text": "高い数字を書いたらどうなる？ あ、待って。 だから、もし私が"}, {"type": "subtitle", "time": 2623.43, "timestamp": "00:43:43", "text": "ストリームを高画質にしたら、皆さん。"}, {"type": "subtitle", "time": 2625.91, "timestamp": "00:43:45", "text": "ああ、いや、いや、いや。 大丈夫です。 わかった。"}, {"type": "subtitle", "time": 2626.63, "timestamp": "00:43:46", "text": "待って。   自"}, {"type": "subtitle", "time": 2628.47, "timestamp": "00:43:48", "text": "撮り用の表情はやめろよ、兄弟。"}, {"type": "subtitle", "time": 2631.109, "timestamp": "00:43:51", "text": "かなり考え込む必要がある。"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "インドでの最後の配信。 はい、"}, {"type": "subtitle", "time": 2634.55, "timestamp": "00:43:54", "text": "そうです。   「"}, {"type": "chat", "time": 2636.747, "timestamp": "00:43:56", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "last stream in india?"}, {"type": "chat", "time": 2638.842, "timestamp": "00:43:58", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! RPGfanatic-i3z~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}]
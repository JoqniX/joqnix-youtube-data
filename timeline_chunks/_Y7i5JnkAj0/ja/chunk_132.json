[{"type": "subtitle", "time": 7931.189, "timestamp": "02:12:11", "text": "これはニンジン？ああ、待って。あの点。わかった"}, {"type": "subtitle", "time": 7933.99, "timestamp": "02:12:13", "text": "。あの"}, {"type": "subtitle", "time": 7934.87, "timestamp": "02:12:14", "text": "車が欲しいの？"}, {"type": "subtitle", "time": 7938.79, "timestamp": "02:12:18", "text": "これは私が普段使っているものだ。なんてこった。"}, {"type": "subtitle", "time": 7950.069, "timestamp": "02:12:30", "text": "真実で行こう。"}, {"type": "subtitle", "time": 7955.91, "timestamp": "02:12:35", "text": "公共のロビーで耳にした会話の変化は？"}, {"type": "subtitle", "time": 7958.069, "timestamp": "02:12:38", "text": "ケモナーとのERP。NRPは"}, {"type": "subtitle", "time": 7971.99, "timestamp": "02:12:51", "text": "人が何を言っているのか考えない。"}, {"type": "subtitle", "time": 7974.39, "timestamp": "02:12:54", "text": "別の真実で行こう。"}, {"type": "subtitle", "time": 7976.31, "timestamp": "02:12:56", "text": "好きな飲み物は？"}, {"type": "subtitle", "time": 7977.669, "timestamp": "02:12:57", "text": "そこは飛ばして。"}, {"type": "subtitle", "time": 7979.27, "timestamp": "02:12:59", "text": "全部の飲み物だ。一番"}]
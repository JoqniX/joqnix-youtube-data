[{"type": "subtitle", "time": 6483.669, "timestamp": "01:48:03", "text": "ああ、神様。"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "こんにちは。ちょっと"}, {"type": "subtitle", "time": 6493.59, "timestamp": "01:48:13", "text": "待って、"}, {"type": "subtitle", "time": 6497.43, "timestamp": "01:48:17", "text": "ヘッドセットを充電するようにリマインダーして。"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "ヘッドセットを充電するようにリマインダーするにはどうすればいい？"}, {"type": "subtitle", "time": 6504.629, "timestamp": "01:48:24", "text": "5分。わかった。"}, {"type": "subtitle", "time": 6529.99, "timestamp": "01:48:49", "text": "私は静かにしている。隅っこにいる"}, {"type": "subtitle", "time": 6531.669, "timestamp": "01:48:51", "text": "。"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "壁の向こう側で。"}, {"type": "subtitle", "time": 6537.51, "timestamp": "01:48:57", "text": "人が話しているのを見て、「うわ、"}, {"type": "subtitle", "time": 6539.189, "timestamp": "01:48:59", "text": "あれは話してるんだ」って思うんだ。"}]
[{"type": "subtitle", "time": 15005.83, "timestamp": "04:10:05", "text": "私がこのゲームをほとんどプレイしていないことを覚えておいてください"}, {"type": "subtitle", "time": 15007.67, "timestamp": "04:10:07", "text": "。"}, {"type": "subtitle", "time": 15011.75, "timestamp": "04:10:11", "text": "このゲームをほとんど配信していません。"}, {"type": "subtitle", "time": 15014.469, "timestamp": "04:10:14", "text": "何？わかりました。"}, {"type": "subtitle", "time": 15017.349, "timestamp": "04:10:17", "text": "ああ、iOSアプリができたんですね。"}, {"type": "subtitle", "time": 15020.71, "timestamp": "04:10:20", "text": "えっと、何を言っていたんでしたっけ？ええと、"}, {"type": "subtitle", "time": 15024.389, "timestamp": "04:10:24", "text": "努力を続けなければなりません。はい。"}, {"type": "subtitle", "time": 15026.309, "timestamp": "04:10:26", "text": "もう一度言いますが、"}, {"type": "subtitle", "time": 15030.469, "timestamp": "04:10:30", "text": "最後の瞬間に参加してくれたすべての人に言いたいことがあります。"}, {"type": "subtitle", "time": 15034.469, "timestamp": "04:10:34", "text": "ええと、それは私にとって本当に大きな意味があります"}, {"type": "subtitle", "time": 15036.87, "timestamp": "04:10:36", "text": "。"}, {"type": "subtitle", "time": 15040.87, "timestamp": "04:10:40", "text": "ですから、ええ。さよならを言うのは辛いですが、さよならではありません"}, {"type": "subtitle", "time": 15043.91, "timestamp": "04:10:43", "text": "。今はただのバイバイです"}, {"type": "subtitle", "time": 15047.67, "timestamp": "04:10:47", "text": "。また後で会いましょう とりあえず後で"}, {"type": "subtitle", "time": 15049.51, "timestamp": "04:10:49", "text": "。"}, {"type": "subtitle", "time": 15051.269, "timestamp": "04:10:51", "text": "うん、"}]
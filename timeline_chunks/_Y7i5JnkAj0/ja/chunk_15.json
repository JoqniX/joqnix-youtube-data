[{"type": "subtitle", "time": 922.629, "timestamp": "00:15:22", "text": "、えーと、"}, {"type": "subtitle", "time": 924.31, "timestamp": "00:15:24", "text": "私の発表を読んでいない方のために、"}, {"type": "subtitle", "time": 930.87, "timestamp": "00:15:30", "text": "4日に日本へ出発するという発表をしました。 今日の"}, {"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "配信が終わったら、"}, {"type": "subtitle", "time": 937.67, "timestamp": "00:15:37", "text": "配信機材とか、"}, {"type": "subtitle", "time": 941.189, "timestamp": "00:15:41", "text": "マイクとか、"}, {"type": "subtitle", "time": 945.03, "timestamp": "00:15:45", "text": "配信で使うもの全部を片付けるつもりです。 というわけで、先ほど"}, {"type": "subtitle", "time": 950.949, "timestamp": "00:15:50", "text": "申し上げた通り、今日が最後の配信となります。"}, {"type": "subtitle", "time": 953.749, "timestamp": "00:15:53", "text": "ええと、"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "今日は一杯飲んで、"}]
[{"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "。"}, {"type": "chat", "time": 11413.732, "timestamp": "03:10:13", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "we all are children"}, {"type": "subtitle", "time": 11413.75, "timestamp": "03:10:13", "text": "ああ、今日は本当に不安だったよ。"}, {"type": "subtitle", "time": 11416.469, "timestamp": "03:10:16", "text": "私の先生は、"}, {"type": "subtitle", "time": 11422.23, "timestamp": "03:10:22", "text": "家から空港に着いたとき、"}, {"type": "subtitle", "time": 11425.11, "timestamp": "03:10:25", "text": "私が不安になることがあると言いました。"}, {"type": "subtitle", "time": 11432.07, "timestamp": "03:10:32", "text": "一緒に来るもう一人の学生は、安定した人になれるでしょう。"}, {"type": "subtitle", "time": 11436.389, "timestamp": "03:10:36", "text": "乗り継ぎ地に到着したら、"}, {"type": "subtitle", "time": 11438.389, "timestamp": "03:10:38", "text": "直行便ではなく乗り継ぎ便なのですが"}, {"type": "chat", "time": 11438.671, "timestamp": "03:10:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "*virtual hugs* bro"}, {"type": "subtitle", "time": 11440.95, "timestamp": "03:10:40", "text": "、そこまで"}, {"type": "subtitle", "time": 11443.03, "timestamp": "03:10:43", "text": "詳しい情報を伝える必要はありません。 そもそも、なぜ私は"}, {"type": "subtitle", "time": 11445.91, "timestamp": "03:10:45", "text": "こんなことを長々と話しているのだろう？ でも、そうですね、"}, {"type": "subtitle", "time": 11449.11, "timestamp": "03:10:49", "text": "私が中立的な立場で、"}, {"type": "subtitle", "time": 11453.349, "timestamp": "03:10:53", "text": "彼が不安な立場になれるような階層の上のようなものです。"}]
[{"type": "subtitle", "time": 10681.429, "timestamp": "02:58:01", "text": "みんなが恋しくなると思う。 私は"}, {"type": "subtitle", "time": 10685.03, "timestamp": "02:58:05", "text": "泣き出して、「なんで"}, {"type": "subtitle", "time": 10690.07, "timestamp": "02:58:10", "text": "家に帰りたいの？」みたいなことを言い始めるでしょう。 でも、"}, {"type": "subtitle", "time": 10692.95, "timestamp": "02:58:12", "text": "正直に言うと、"}, {"type": "subtitle", "time": 10696.389, "timestamp": "02:58:16", "text": "ええと、正直に言うと、"}, {"type": "subtitle", "time": 10702.23, "timestamp": "02:58:22", "text": "今日、これをやって、"}, {"type": "subtitle", "time": 10705.99, "timestamp": "02:58:25", "text": "最後の"}, {"type": "subtitle", "time": 10711.11, "timestamp": "02:58:31", "text": "配信としてここで終えることを本当に嬉しく思います。 ええ、本当に楽しかったです。"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "久しぶりにアストラとジャスミンと楽しい時間を過ごしました。"}, {"type": "subtitle", "time": 10719.349, "timestamp": "02:58:39", "text": "うん。"}, {"type": "subtitle", "time": 10725.51, "timestamp": "02:58:45", "text": "そう、今日は"}, {"type": "chat", "time": 10727.216, "timestamp": "02:58:47", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "gambate ne~"}, {"type": "subtitle", "time": 10737.51, "timestamp": "02:58:57", "text": "、"}]
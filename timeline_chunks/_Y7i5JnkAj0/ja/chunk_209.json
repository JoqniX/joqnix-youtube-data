[{"type": "subtitle", "time": 12541.75, "timestamp": "03:29:01", "text": "海外に行って学生になるんです。しばらくの間、"}, {"type": "subtitle", "time": 12544.15, "timestamp": "03:29:04", "text": "知らない国で過ごして、"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "色々なことを学び、適応していくわけです。滞在中は自分の"}, {"type": "subtitle", "time": 12553.11, "timestamp": "03:29:13", "text": "国を代表する立場にもなりますしね。そういうわけで、"}, {"type": "subtitle", "time": 12564.229, "timestamp": "03:29:24", "text": "語学"}, {"type": "subtitle", "time": 12566.87, "timestamp": "03:29:26", "text": "交換留学生などの場合、どこへ行っても自分の"}, {"type": "subtitle", "time": 12569.19, "timestamp": "03:29:29", "text": "国を身近に感じられるというのは良いことなんです。 ええと、"}, {"type": "subtitle", "time": 12571.269, "timestamp": "03:29:31", "text": "あなたがどの国を旅行するにしても、つまり"}, {"type": "subtitle", "time": 12574.389, "timestamp": "03:29:34", "text": "旅行や観光など、どこへ行っても、"}, {"type": "subtitle", "time": 12576.389, "timestamp": "03:29:36", "text": "あなたがどこから来たとしても、あなたは常に"}, {"type": "subtitle", "time": 12580.15, "timestamp": "03:29:40", "text": "自分の文化的な部分をそこに持っていくでしょう。"}, {"type": "subtitle", "time": 12582.07, "timestamp": "03:29:42", "text": "うん。"}, {"type": "subtitle", "time": 12585.67, "timestamp": "03:29:45", "text": "あなたはまるで、あなた自身を代表する"}, {"type": "subtitle", "time": 12599.11, "timestamp": "03:29:59", "text": "ええ、私にはわかりません"}]
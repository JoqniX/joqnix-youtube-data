[{"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "。 ありがとう。 いらっしゃいませ。"}, {"type": "subtitle", "time": 12669.75, "timestamp": "03:31:09", "text": "ええ、そうですね。 だから、日本に着いたら、"}, {"type": "subtitle", "time": 12672.229, "timestamp": "03:31:12", "text": "すべて漢字と"}, {"type": "subtitle", "time": 12675.429, "timestamp": "03:31:15", "text": "日本語で書かれているんですよね。   すべてです"}, {"type": "subtitle", "time": 12678.79, "timestamp": "03:31:18", "text": "。 私の居住者"}, {"type": "subtitle", "time": 12681.11, "timestamp": "03:31:21", "text": "カードもだ。"}, {"type": "subtitle", "time": 12685.03, "timestamp": "03:31:25", "text": "ええ、すべてそうですが、"}, {"type": "subtitle", "time": 12699.67, "timestamp": "03:31:39", "text": "楽しみです。"}, {"type": "subtitle", "time": 12702.07, "timestamp": "03:31:42", "text": "どのぐらいの間？ ええと、"}, {"type": "subtitle", "time": 12704.07, "timestamp": "03:31:44", "text": "2年以上ですね。"}, {"type": "subtitle", "time": 12708.309, "timestamp": "03:31:48", "text": "2年間の語学コースを受講して、その後そこで"}, {"type": "subtitle", "time": 12714.389, "timestamp": "03:31:54", "text": "大学に進学するつもりです。 おそらく"}, {"type": "subtitle", "time": 12716.95, "timestamp": "03:31:56", "text": "音楽に転向して、"}]
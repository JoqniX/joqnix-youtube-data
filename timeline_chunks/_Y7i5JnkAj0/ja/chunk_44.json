[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "何だよ、兄弟？」をオフにする 一体どういうことだよ、兄弟？"}, {"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": "何？"}, {"type": "subtitle", "time": 2644.47, "timestamp": "00:44:04", "text": "いいえ、あなたに歌を歌っているわけではありません。 私は"}, {"type": "subtitle", "time": 2647.349, "timestamp": "00:44:07", "text": "他の人に向けて歌っている。 わかったよ、兄弟。 みんな"}, {"type": "subtitle", "time": 2650.63, "timestamp": "00:44:10", "text": "度胸があるな。"}, {"type": "subtitle", "time": 2653.67, "timestamp": "00:44:13", "text": "私はカエルを触っています。"}, {"type": "subtitle", "time": 2657.589, "timestamp": "00:44:17", "text": "待って。 両手。"}, {"type": "subtitle", "time": 2659.27, "timestamp": "00:44:19", "text": "おお。"}, {"type": "subtitle", "time": 2660.309, "timestamp": "00:44:20", "text": "来る。"}, {"type": "subtitle", "time": 2679.349, "timestamp": "00:44:39", "text": "ああ、これは元祖ですね。 あ、待って。 これは、"}, {"type": "subtitle", "time": 2682.15, "timestamp": "00:44:42", "text": "あなたが最初にいた世界です"}, {"type": "subtitle", "time": 2685.109, "timestamp": "00:44:45", "text": "。 うん。"}, {"type": "subtitle", "time": 2686.319, "timestamp": "00:44:46", "text": "うん。 いやー、パーカーの品揃えがすごく良かったよ。"}, {"type": "subtitle", "time": 2694.23, "timestamp": "00:44:54", "text": "おお。"}, {"type": "subtitle", "time": 2696.95, "timestamp": "00:44:56", "text": "とても素敵です。"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "ジャスミン、調子はどう？ そうそう。"}]
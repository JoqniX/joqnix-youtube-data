[{"type": "subtitle", "time": 3424.549, "timestamp": "00:57:04", "text": "騒動やトラブルの後、一体何が起こったのでしょうか？ バンティは亡くなり、"}, {"type": "subtitle", "time": 3428.23, "timestamp": "00:57:08", "text": "その後バンティは結婚した。 わかった。"}, {"type": "subtitle", "time": 3431.51, "timestamp": "00:57:11", "text": "2、3年のドラマを経て、彼らは"}, {"type": "subtitle", "time": 3433.91, "timestamp": "00:57:13", "text": "結婚した。"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "うん。"}, {"type": "subtitle", "time": 3445.19, "timestamp": "00:57:25", "text": "そしてある日、バンディは遺体で発見された。"}, {"type": "subtitle", "time": 3447.589, "timestamp": "00:57:27", "text": "何？"}, {"type": "subtitle", "time": 3455.67, "timestamp": "00:57:35", "text": "彼女は、"}, {"type": "subtitle", "time": 3460.47, "timestamp": "00:57:40", "text": "妻に殺されたんです。 バンディを殺した。"}, {"type": "subtitle", "time": 3462.309, "timestamp": "00:57:42", "text": "いいえ。ああ、みんな妻がバンティを殺したと思っていた"}, {"type": "subtitle", "time": 3465.349, "timestamp": "00:57:45", "text": "けど、いいえ、"}, {"type": "subtitle", "time": 3466.71, "timestamp": "00:57:46", "text": "バンティを殺したのは妻ではありませんでした。"}, {"type": "subtitle", "time": 3467.589, "timestamp": "00:57:47", "text": "母親？"}, {"type": "subtitle", "time": 3470.95, "timestamp": "00:57:50", "text": "それは彼の義母だった。"}, {"type": "subtitle", "time": 3472.95, "timestamp": "00:57:52", "text": "うん。"}, {"type": "subtitle", "time": 3475.67, "timestamp": "00:57:55", "text": "しかし、落とし穴があった。 姑は、"}, {"type": "subtitle", "time": 3477.75, "timestamp": "00:57:57", "text": "ブンティを殺せば"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "娘がブンティの財産をすべて相続できると考えていた"}]
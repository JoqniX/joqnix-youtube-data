[{"type": "subtitle", "time": 12840.389, "timestamp": "03:34:00", "text": "私はインド出身で日本に住んでいますが、まだインド全体を体験したことはありません。"}, {"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "でも、"}, {"type": "chat", "time": 12849.486, "timestamp": "03:34:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ahhhj"}, {"type": "subtitle", "time": 12854.79, "timestamp": "03:34:14", "text": "好み"}, {"type": "subtitle", "time": 12856.63, "timestamp": "03:34:16", "text": "や興味が違うので、日本全体を体験するつもりです。 ええ、その通りです。 それは"}, {"type": "subtitle", "time": 12859.67, "timestamp": "03:34:19", "text": "本当だ。 確かに、確かに、確かに。"}, {"type": "subtitle", "time": 12866.95, "timestamp": "03:34:26", "text": "うん。"}, {"type": "subtitle", "time": 12868.95, "timestamp": "03:34:28", "text": "えっと、"}, {"type": "subtitle", "time": 12874.229, "timestamp": "03:34:34", "text": "そうですね、今日は色々なことを感じています。"}, {"type": "subtitle", "time": 12877.429, "timestamp": "03:34:37", "text": "繰り返しますが、私がこんなにしゃべっていても"}, {"type": "subtitle", "time": 12879.11, "timestamp": "03:34:39", "text": "気にしないでください"}, {"type": "subtitle", "time": 12881.11, "timestamp": "03:34:41", "text": "。 はい、私のライブ配信です。"}, {"type": "subtitle", "time": 12884.07, "timestamp": "03:34:44", "text": "大丈夫だといいのですが。 でも、それと同時に、"}, {"type": "subtitle", "time": 12887.269, "timestamp": "03:34:47", "text": "動画を作ったり、Vlogを作ったり、そういうことも全部やるつもりです。"}, {"type": "subtitle", "time": 12890.309, "timestamp": "03:34:50", "text": "最善を尽くします。"}, {"type": "subtitle", "time": 12892.71, "timestamp": "03:34:52", "text": "ええと、最善を尽くします。"}]
[{"type": "subtitle", "time": 1707.83, "timestamp": "00:28:27", "text": "ああ、VRを手に入れたら、彼女が僕を見るたびに願うつもりだ"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "。"}, {"type": "subtitle", "time": 1724.549, "timestamp": "00:28:44", "text": "えっと、それって何ていう名前だっけ？ えっと、マックスは何て"}, {"type": "subtitle", "time": 1728.149, "timestamp": "00:28:48", "text": "言ってるの？ いいえ。ええと、"}, {"type": "subtitle", "time": 1731.029, "timestamp": "00:28:51", "text": "それを表す言葉がありました。"}, {"type": "subtitle", "time": 1732.549, "timestamp": "00:28:52", "text": "ええ、"}, {"type": "subtitle", "time": 1733.909, "timestamp": "00:28:53", "text": "見てください。 マックスのこと。"}, {"type": "subtitle", "time": 1735.83, "timestamp": "00:28:55", "text": "あちらで確認してみないと。 あちら側が見えるよ"}]
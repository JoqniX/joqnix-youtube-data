[{"type": "subtitle", "time": 8463.19, "timestamp": "02:21:03", "text": "うん、うん、うん。 知っている。 ええ、"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "あなたが一度も行ったことがないのは知っています。"}, {"type": "subtitle", "time": 8466.71, "timestamp": "02:21:06", "text": "では、質問を変えてみましょう。 いや、"}, {"type": "subtitle", "time": 8473.67, "timestamp": "02:21:13", "text": "前で、これまでで一番恥ずかしいことをしてしまった経験は何ですか？"}, {"type": "subtitle", "time": 8473.99, "timestamp": "02:21:13", "text": "知っている。"}, {"type": "subtitle", "time": 8475.75, "timestamp": "02:21:15", "text": "おお、興味深い。 面白い。"}, {"type": "subtitle", "time": 8476.399, "timestamp": "02:21:16", "text": "面白い。 ああ、"}, {"type": "subtitle", "time": 8478.24, "timestamp": "02:21:18", "text": "ああ、 神様、なぜ私に"}, {"type": "subtitle", "time": 8481.04, "timestamp": "02:21:21", "text": "神様、なぜ私に これを覚えていてほしいのですか？ わかった。"}, {"type": "subtitle", "time": 8484.24, "timestamp": "02:21:24", "text": "これを覚えていてほしいのですか？ わかった。 憧れの人の前。"}, {"type": "subtitle", "time": 8486.8, "timestamp": "02:21:26", "text": "憧れの人の前。 おお。   わかった"}, {"type": "subtitle", "time": 8489.439, "timestamp": "02:21:29", "text": "おお。   わかった 。 では、"}, {"type": "subtitle", "time": 8497.11, "timestamp": "02:21:37", "text": "待ってください。 これを配信で言うべきでしょうか？   言い"}, {"type": "subtitle", "time": 8499.59, "timestamp": "02:21:39", "text": "たいなら言ってもいいし、言いたくないなら言ってもいい。   わかった"}, {"type": "subtitle", "time": 8503.11, "timestamp": "02:21:43", "text": "。 これは私が"}, {"type": "subtitle", "time": 8505.59, "timestamp": "02:21:45", "text": "とても小さかった頃の写真です。"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "いや、してないよ。 わかった。"}, {"type": "subtitle", "time": 8509.349, "timestamp": "02:21:49", "text": "あなたがまだ小さかった頃。"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "うん。 まるで"}, {"type": "subtitle", "time": 8512.95, "timestamp": "02:21:52", "text": "片思いをしているみたいに。 あなたは小さい頃、片思いをしていた"}, {"type": "subtitle", "time": 8514.309, "timestamp": "02:21:54", "text": "。"}, {"type": "subtitle", "time": 8519.27, "timestamp": "02:21:59", "text": "小さい頃、「crush」がどういう意味か知っていましたか？"}]
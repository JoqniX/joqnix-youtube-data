[{"type": "subtitle", "time": 13022.309, "timestamp": "03:37:02", "text": "今回は、"}, {"type": "subtitle", "time": 13028.07, "timestamp": "03:37:08", "text": "今日の配信で"}, {"type": "subtitle", "time": 13035.75, "timestamp": "03:37:15", "text": "アストラとジャスミンとシリと遊んだ真実と挑戦のゲームでその質問を見たことがありますよね？"}, {"type": "subtitle", "time": 13039.59, "timestamp": "03:37:19", "text": "あなたが有名になりたいことは何ですか？"}, {"type": "subtitle", "time": 13040.87, "timestamp": "03:37:20", "text": "右。"}, {"type": "subtitle", "time": 13044.55, "timestamp": "03:37:24", "text": "そして、今は自分が"}, {"type": "subtitle", "time": 13048.87, "timestamp": "03:37:28", "text": "間違ったことで有名になっていることは分かっていますが、"}, {"type": "subtitle", "time": 13055.349, "timestamp": "03:37:35", "text": "それを"}, {"type": "subtitle", "time": 13058.63, "timestamp": "03:37:38", "text": "過去のこととして忘れたいと思っています。 そして今回は、自分の"}, {"type": "subtitle", "time": 13064.87, "timestamp": "03:37:44", "text": "目標や夢が自分をどこへ連れて行ってくれるのか、実際に見てみたいんです"}, {"type": "subtitle", "time": 13067.67, "timestamp": "03:37:47", "text": "。 だから私は"}, {"type": "subtitle", "time": 13070.79, "timestamp": "03:37:50", "text": "夢の場所に行くんだよ、そうでしょ？ 夢を追いかけているんだ、"}, {"type": "subtitle", "time": 13073.83, "timestamp": "03:37:53", "text": "そうだろ？ 日本に行くとか、そういうのって、"}, {"type": "subtitle", "time": 13078.469, "timestamp": "03:37:58", "text": "私に言わせればクレイジーなことだよ。"}]
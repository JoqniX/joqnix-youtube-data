[{"type": "subtitle", "time": 9663.03, "timestamp": "02:41:03", "text": "オーケー」が好きです。 わかった。 わかった。 だから、私にはわからない。   黙れ"}, {"type": "subtitle", "time": 9665.67, "timestamp": "02:41:05", "text": "。 それで、ハニの"}, {"type": "subtitle", "time": 9671.19, "timestamp": "02:41:11", "text": "曲で「バンドゥク」という曲があるんです。"}, {"type": "subtitle", "time": 9679.67, "timestamp": "02:41:19", "text": "私はその曲が好きです。"}, {"type": "subtitle", "time": 9682.87, "timestamp": "02:41:22", "text": "君たちは聞きたいのか？"}, {"type": "subtitle", "time": 9686.389, "timestamp": "02:41:26", "text": "いいえ。いいえ、いいえ、いいえ、いいえ、いいえ。   ねえ"}, {"type": "subtitle", "time": 9687.19, "timestamp": "02:41:27", "text": "、遊ぼうよ。"}, {"type": "subtitle", "time": 9690.389, "timestamp": "02:41:30", "text": "Zがストリーミング配信中です。 著作権を取得する。"}, {"type": "subtitle", "time": 9693.83, "timestamp": "02:41:33", "text": "ミュート。 ミュート。 沈黙の世界。   配信中は、"}, {"type": "subtitle", "time": 9696.389, "timestamp": "02:41:36", "text": "ゲームの音声を"}, {"type": "subtitle", "time": 9697.11, "timestamp": "02:41:37", "text": "一時的にミュートしてください。   わかった"}, {"type": "subtitle", "time": 9699.19, "timestamp": "02:41:39", "text": "。 待って。   わかった"}, {"type": "subtitle", "time": 9711.83, "timestamp": "02:41:51", "text": "ゲームではなく、配信をミュートしてください。"}, {"type": "subtitle", "time": 9714.79, "timestamp": "02:41:54", "text": "うん。 うん。 うん。 動画を閉じてください。 ビデオ、ビデオ"}, {"type": "subtitle", "time": 9716.79, "timestamp": "02:41:56", "text": "。"}]
[{"type": "subtitle", "time": 7809.83, "timestamp": "02:10:09", "text": "日本語の"}, {"type": "subtitle", "time": 7813.43, "timestamp": "02:10:13", "text": "学習の世界にいて、"}, {"type": "subtitle", "time": 7817.669, "timestamp": "02:10:17", "text": "日本語を教えてくれる人に会ったんだ。その人が"}, {"type": "subtitle", "time": 7820.79, "timestamp": "02:10:20", "text": "私と話したりして、たくさんのことを手伝ってくれて、私たちはすぐに進んだ"}, {"type": "subtitle", "time": 7829.109, "timestamp": "02:10:29", "text": "。"}, {"type": "subtitle", "time": 7831.43, "timestamp": "02:10:31", "text": "うん。うん。それから私たちはたくさんの"}, {"type": "subtitle", "time": 7834.709, "timestamp": "02:10:34", "text": "場所に行ったんだけど、恐怖のせいで彼女の耳元で叫んでたんだ"}, {"type": "subtitle", "time": 7837.03, "timestamp": "02:10:37", "text": "。でも、そうだよ、"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "それが女の子の記憶のほとんどだ。"}, {"type": "subtitle", "time": 7848.229, "timestamp": "02:10:48", "text": "待って、待って、待って。大丈夫。大丈夫。いや、"}, {"type": "subtitle", "time": 7850.79, "timestamp": "02:10:50", "text": "いや、いや。楽しかったよ。楽しかったよ。"}, {"type": "subtitle", "time": 7853.91, "timestamp": "02:10:53", "text": "みんなと楽しかったよ。楽しかった"}]
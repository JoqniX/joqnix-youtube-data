[{"type": "subtitle", "time": 8223.349, "timestamp": "02:17:03", "text": "どう言えばいいかな？"}, {"type": "subtitle", "time": 8227.99, "timestamp": "02:17:07", "text": "最初はあまり交流がなくて、"}, {"type": "subtitle", "time": 8231.509, "timestamp": "02:17:11", "text": "彼はとても自己中心的で、自己中心的で、自己中心的"}, {"type": "subtitle", "time": 8243.03, "timestamp": "02:17:23", "text": "で失礼な人だと感じたの。"}, {"type": "subtitle", "time": 8248.309, "timestamp": "02:17:28", "text": "義務ってどういう意味？"}, {"type": "subtitle", "time": 8253.589, "timestamp": "02:17:33", "text": "本当にそう感じたの？ そう感じた。"}, {"type": "subtitle", "time": 8254.549, "timestamp": "02:17:34", "text": "うん。"}, {"type": "subtitle", "time": 8260.309, "timestamp": "02:17:40", "text": "わかってる。真剣に、あなたが私と一緒に来たとき、"}, {"type": "subtitle", "time": 8267.75, "timestamp": "02:17:47", "text": "一言で言うと、とても"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "プロフェッショナルな人って感じだったよね。"}, {"type": "subtitle", "time": 8274.549, "timestamp": "02:17:54", "text": "うん。だから、"}, {"type": "subtitle", "time": 8276.389, "timestamp": "02:17:56", "text": "初めて会ったときは、すごくフォーマルでプロフェッショナルだった。"}, {"type": "subtitle", "time": 8279.75, "timestamp": "02:17:59", "text": "うん。すごくフォーマルだった。"}]
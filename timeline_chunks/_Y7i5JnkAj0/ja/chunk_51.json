[{"type": "subtitle", "time": 3066.71, "timestamp": "00:51:06", "text": "最後の配信ではなかったのですが、ええ、待って、何をしているの？"}, {"type": "subtitle", "time": 3078.15, "timestamp": "00:51:18", "text": "どこ？このギャラクシーペンを持っていくよ。"}, {"type": "subtitle", "time": 3080.63, "timestamp": "00:51:20", "text": "あ、待って、これはいい壁だ。お気に入りが必要だ。"}, {"type": "subtitle", "time": 3118.39, "timestamp": "00:51:58", "text": "1秒。  1秒。  1秒。  1"}]
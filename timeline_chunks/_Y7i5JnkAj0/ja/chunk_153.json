[{"type": "subtitle", "time": 9184.55, "timestamp": "02:33:04", "text": "何か言っても気にしないでください"}, {"type": "subtitle", "time": 9193.11, "timestamp": "02:33:13", "text": "私は言った。 あなたは気分が悪くなった。"}, {"type": "subtitle", "time": 9194.309, "timestamp": "02:33:14", "text": "何か。"}, {"type": "subtitle", "time": 9211.19, "timestamp": "02:33:31", "text": "それはすぐに答えられるはずです。 陽気な。"}, {"type": "subtitle", "time": 9214.71, "timestamp": "02:33:34", "text": "ブルズ。 ブルズ。 ブルズ。 ブルズ。 ブルズ。"}, {"type": "subtitle", "time": 9216.23, "timestamp": "02:33:36", "text": "実は、"}, {"type": "subtitle", "time": 9223.91, "timestamp": "02:33:43", "text": "こちらです。 ジェイスは、"}, {"type": "subtitle", "time": 9227.03, "timestamp": "02:33:47", "text": "自分の好きなところを見つけようと必死に努力していた。 本当にたくさんありますよ。 どれを"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "全く異なる性格ですよね？"}, {"type": "subtitle", "time": 9237.51, "timestamp": "02:33:57", "text": "えっと、"}]
[{"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "つまり、あなたたちは二人とも"}, {"type": "subtitle", "time": 3307.03, "timestamp": "00:55:07", "text": "話を聞いていないということですね。"}, {"type": "subtitle", "time": 3307.67, "timestamp": "00:55:07", "text": "はい。"}, {"type": "subtitle", "time": 3308.87, "timestamp": "00:55:08", "text": "黒板。"}, {"type": "subtitle", "time": 3310.79, "timestamp": "00:55:10", "text": "こんにちは。"}, {"type": "subtitle", "time": 3319.19, "timestamp": "00:55:19", "text": "だから、私もホグワーツから多くを学んだ。 わかった。"}, {"type": "subtitle", "time": 3321.51, "timestamp": "00:55:21", "text": "私はホグワーツで学んだ。"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "ああ、"}, {"type": "subtitle", "time": 3336.95, "timestamp": "00:55:36", "text": "出会った。"}, {"type": "subtitle", "time": 3348.549, "timestamp": "00:55:48", "text": "見た目が悪いね。 良くない。 彼は醜い"}, {"type": "subtitle", "time": 3352.71, "timestamp": "00:55:52", "text": "男で、野獣で、そしてまた醜い男だった。"}, {"type": "subtitle", "time": 3355.589, "timestamp": "00:55:55", "text": "でも、いや、私の間違いです。 一方で"}, {"type": "subtitle", "time": 3359.75, "timestamp": "00:55:59", "text": "、彼女は綺麗だったよね"}]
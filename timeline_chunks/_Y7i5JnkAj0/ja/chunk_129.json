[{"type": "subtitle", "time": 7741.51, "timestamp": "02:09:01", "text": "私がデートする人は、私がデートが上手だと言うだろう"}, {"type": "subtitle", "time": 7753.43, "timestamp": "02:09:13", "text": "これをスキップすると、"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "ああ、そうか。ギャラリーみたいなものが最近来た。"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "待って、どうやって確認するの？"}, {"type": "subtitle", "time": 7778.629, "timestamp": "02:09:38", "text": "待って、 それはもうない。ああ、そうだ。フォト"}, {"type": "subtitle", "time": 7781.589, "timestamp": "02:09:41", "text": "ギャラリー。ああ、"}, {"type": "subtitle", "time": 7797.83, "timestamp": "02:09:57", "text": "季節的なものみたいなもので、えっと、ある時、"}]
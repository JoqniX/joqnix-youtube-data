[{"type": "subtitle", "time": 7140.629, "timestamp": "01:59:00", "text": "どういう意味？わからない"}, {"type": "subtitle", "time": 7147.75, "timestamp": "01:59:07", "text": "最初に"}, {"type": "subtitle", "time": 7163.03, "timestamp": "01:59:23", "text": "なんてこった。 今、殴られた。"}, {"type": "subtitle", "time": 7165.91, "timestamp": "01:59:25", "text": "いや、"}, {"type": "subtitle", "time": 7176.07, "timestamp": "01:59:36", "text": "冗談はやめて。"}, {"type": "subtitle", "time": 7178.149, "timestamp": "01:59:38", "text": "犬が言う。いや。何？何を"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "え、"}, {"type": "subtitle", "time": 7182.87, "timestamp": "01:59:42", "text": "何？でも、気になる"}, {"type": "subtitle", "time": 7185.189, "timestamp": "01:59:45", "text": "。でも、"}, {"type": "subtitle", "time": 7188.629, "timestamp": "01:59:48", "text": "私たちは何て言うんだろう？でも、「いや、そうするべきだ」とも思う。ねえ、わかる"}, {"type": "subtitle", "time": 7190.629, "timestamp": "01:59:50", "text": "？わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 7193.83, "timestamp": "01:59:53", "text": "当ててみて。あの人があなたを呼んだ時の言い方は"}, {"type": "subtitle", "time": 7196.629, "timestamp": "01:59:56", "text": "、「J」みたいだった"}]
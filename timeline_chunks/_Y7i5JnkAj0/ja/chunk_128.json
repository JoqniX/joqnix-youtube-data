[{"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "お前の顔がここにあるみたいだ。わかった"}, {"type": "subtitle", "time": 7690.87, "timestamp": "02:08:10", "text": "。ああ、言ったよ。わかった。私をつかんで"}, {"type": "subtitle", "time": 7692.87, "timestamp": "02:08:12", "text": "。"}, {"type": "subtitle", "time": 7695.83, "timestamp": "02:08:15", "text": "こういうものをつかむのは楽しい。それで、"}, {"type": "chat", "time": 7707.837, "timestamp": "02:08:27", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQUCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQ"}, {"type": "subtitle", "time": 7718.87, "timestamp": "02:08:38", "text": "これをスキップしなかった？"}, {"type": "subtitle", "time": 7720.069, "timestamp": "02:08:40", "text": "でも、デートに行ったことはない。今までで"}, {"type": "subtitle", "time": 7721.91, "timestamp": "02:08:41", "text": "最悪のデートを説明して"}, {"type": "subtitle", "time": 7723.99, "timestamp": "02:08:43", "text": "。デートに行ったことがないの？"}, {"type": "subtitle", "time": 7726.31, "timestamp": "02:08:46", "text": "いいえ。一度もない。"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "ジャスミン、彼をデートに連れて行って。"}, {"type": "subtitle", "time": 7730.229, "timestamp": "02:08:50", "text": "デートに連れて行きたいけど、お前は"}, {"type": "subtitle", "time": 7731.589, "timestamp": "02:08:51", "text": "日本に行くんだよ、兄弟。"}]
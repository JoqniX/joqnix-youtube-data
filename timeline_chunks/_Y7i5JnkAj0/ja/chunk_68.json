[{"type": "subtitle", "time": 4081.67, "timestamp": "01:08:01", "text": "ああ、絶対に忘れないよ。ルーンは僕"}, {"type": "subtitle", "time": 4085.109, "timestamp": "01:08:05", "text": "にとってすごく大切なものだった。ああ。一緒に色々やってたの"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "覚えてる？"}, {"type": "subtitle", "time": 4090.549, "timestamp": "01:08:10", "text": "待って。あー、そうそう。ああ、そうそう。僕は"}, {"type": "subtitle", "time": 4092.87, "timestamp": "01:08:12", "text": "君と1対1で戦ってたんだ。ああ、そうそう。あれは"}, {"type": "subtitle", "time": 4095.19, "timestamp": "01:08:15", "text": "すごく良かった。今でも覚えてるよ。そして"}, {"type": "subtitle", "time": 4098.39, "timestamp": "01:08:18", "text": "君は僕に神の力をくれた。ああ、あれは"}, {"type": "subtitle", "time": 4100.63, "timestamp": "01:08:20", "text": "すごく良かった。あの"}, {"type": "subtitle", "time": 4102.709, "timestamp": "01:08:22", "text": "部屋はみんなのお気に入りの思い出だった。なんだか、"}, {"type": "subtitle", "time": 4108.87, "timestamp": "01:08:28", "text": "誰かが遊んでて気分が悪かったのかなって思う。"}, {"type": "subtitle", "time": 4112.87, "timestamp": "01:08:32", "text": "本当だよ。僕も一番好きだった。本当にたくさんのことをしたよね。"}, {"type": "subtitle", "time": 4116.87, "timestamp": "01:08:36", "text": "君にマインクラフトを教えたのは僕だったよね。うん"}, {"type": "subtitle", "time": 4117.349, "timestamp": "01:08:37", "text": "。うん、"}, {"type": "subtitle", "time": 4123.11, "timestamp": "01:08:43", "text": "よし、真実を話そう。真実を話すよ"}, {"type": "subtitle", "time": 4125.43, "timestamp": "01:08:45", "text": "。真実 そこ。 1つは何？"}]
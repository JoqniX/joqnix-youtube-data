[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "、いや。 それはおかしくないよ。 いや、いや、犬。"}, {"type": "subtitle", "time": 8582.95, "timestamp": "02:23:02", "text": "それはおかしくないよ。 それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 8585.19, "timestamp": "02:23:05", "text": "それはまさにロマンチックだ。 それは"}, {"type": "subtitle", "time": 8587.51, "timestamp": "02:23:07", "text": "恥ずかしいことではありません。"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "痛々しいよ、兄弟。"}, {"type": "subtitle", "time": 8593.11, "timestamp": "02:23:13", "text": "黙れ。 あなたはそれについて何を知っていますか？ あなたは"}, {"type": "subtitle", "time": 8604.71, "timestamp": "02:23:24", "text": "ねえ、"}, {"type": "subtitle", "time": 8608.469, "timestamp": "02:23:28", "text": "恥ずかしい話だけど、えっと、ある時こんなことがあったんだ"}, {"type": "subtitle", "time": 8610.71, "timestamp": "02:23:30", "text": "。"}, {"type": "subtitle", "time": 8611.99, "timestamp": "02:23:31", "text": "恥ずかしい。 では、"}, {"type": "subtitle", "time": 8613.99, "timestamp": "02:23:33", "text": "恥ずかしいとはどういう意味か説明しましょう。 恥ずかしいというのは、好きな人に話しかけようとして、あまりにもうまく"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "話せなくて、結局"}, {"type": "subtitle", "time": 8619.75, "timestamp": "02:23:39", "text": "笑われてしまったということだ。 君があまりにも慌てて手を"}, {"type": "subtitle", "time": 8621.83, "timestamp": "02:23:41", "text": "抜いたせいで、彼女は"}, {"type": "subtitle", "time": 8625.429, "timestamp": "02:23:45", "text": "君の顔にコーヒーをぶちまけたんだ。 あなたは彼女の前でfをする。"}, {"type": "subtitle", "time": 8627.99, "timestamp": "02:23:47", "text": "あなたは"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "彼女の前で人々にいじめられた。 あなたは"}, {"type": "subtitle", "time": 8631.429, "timestamp": "02:23:51", "text": "彼女の前で拒絶された。   ああ"}, {"type": "subtitle", "time": 8633.19, "timestamp": "02:23:53", "text": "、それは恥ずかしい"}]
[{"type": "subtitle", "time": 7523.03, "timestamp": "02:05:23", "text": "あ、待って。マイク？"}, {"type": "subtitle", "time": 7525.99, "timestamp": "02:05:25", "text": "またマイク？なんてこった。ごめん。えっと"}, {"type": "subtitle", "time": 7527.99, "timestamp": "02:05:27", "text": "、ミュートした。わかった。"}, {"type": "subtitle", "time": 7531.99, "timestamp": "02:05:31", "text": "瞬間はたくさんある。えっと、"}, {"type": "subtitle", "time": 7556.39, "timestamp": "02:05:56", "text": "僕と兄弟が一緒に暮らしていた頃かな"}]
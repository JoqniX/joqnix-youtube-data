[{"type": "subtitle", "time": 4262.07, "timestamp": "01:11:02", "text": "話さないで。 イエスかノーだよ。"}, {"type": "subtitle", "time": 4265.83, "timestamp": "01:11:05", "text": "ああ、なんてことだ。ああ。ああ、神様ありがとう。"}, {"type": "subtitle", "time": 4267.59, "timestamp": "01:11:07", "text": "あなたは質問に答える方法を知らない"}, {"type": "subtitle", "time": 4268.95, "timestamp": "01:11:08", "text": "。あなたは英語を知らない。なんてことだ"}, {"type": "subtitle", "time": 4273.83, "timestamp": "01:11:13", "text": "。それはむしろ「はい、あります」という感じだ。"}, {"type": "subtitle", "time": 4275.91, "timestamp": "01:11:15", "text": "それについて話したいなら、それについて話すか、"}, {"type": "subtitle", "time": 4280.47, "timestamp": "01:11:20", "text": "片思いではない。それは、えーと"}, {"type": "subtitle", "time": 4284.709, "timestamp": "01:11:24", "text": "、ああ、友達としてはどんな感じだったか？"}, {"type": "subtitle", "time": 4287.43, "timestamp": "01:11:27", "text": "面白いとか、おかしいとか？"}, {"type": "subtitle", "time": 4296.31, "timestamp": "01:11:36", "text": "おかえりなさい。"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "ジョークは、イエスかノーで教えてくれる。VR"}, {"type": "subtitle", "time": 4311.11, "timestamp": "01:11:51", "text": "チャットで出会った人に片思いしたことはありますか？待って、ある？わからない"}]
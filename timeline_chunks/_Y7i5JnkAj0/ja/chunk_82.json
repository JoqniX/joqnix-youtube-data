[{"type": "subtitle", "time": 4920.39, "timestamp": "01:22:00", "text": "私は彼女のためだけに吠える。"}, {"type": "subtitle", "time": 4922.709, "timestamp": "01:22:02", "text": "何？"}, {"type": "subtitle", "time": 4923.83, "timestamp": "01:22:03", "text": "彼女って誰？"}, {"type": "subtitle", "time": 4927.99, "timestamp": "01:22:07", "text": "私は自分のためだけに吠える。"}, {"type": "subtitle", "time": 4930.709, "timestamp": "01:22:10", "text": "どうやってみんながあなただとわかるの？私は"}, {"type": "subtitle", "time": 4932.87, "timestamp": "01:22:12", "text": "自分の名前を入れた。"}, {"type": "subtitle", "time": 4935.669, "timestamp": "01:22:15", "text": "待って、"}, {"type": "subtitle", "time": 4970.149, "timestamp": "01:22:50", "text": "プレゼントが好きだと嘘をついたことある？"}, {"type": "subtitle", "time": 4977.11, "timestamp": "01:22:57", "text": "何だった？プレゼントが好きだと嘘をついた。"}, {"type": "subtitle", "time": 4979.83, "timestamp": "01:22:59", "text": "うん。私は母に、"}]
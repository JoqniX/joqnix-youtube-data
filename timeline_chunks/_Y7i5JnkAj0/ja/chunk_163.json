[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "古い"}, {"type": "subtitle", "time": 9784.07, "timestamp": "02:43:04", "text": "曲を演奏して、あなたが「1900 ベイビー」って言った部分をカットできたんじゃないかと思った"}, {"type": "subtitle", "time": 9791.03, "timestamp": "02:43:11", "text": "。"}, {"type": "subtitle", "time": 9792.87, "timestamp": "02:43:12", "text": "うん。 残念ながら、"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "ああ、チャンスを逃してしまった。 なぜ私は"}, {"type": "subtitle", "time": 9803.27, "timestamp": "02:43:23", "text": "床に座っているのだろう？ 実は今、"}, {"type": "subtitle", "time": 9805.19, "timestamp": "02:43:25", "text": "床に座っているんです。"}, {"type": "subtitle", "time": 9808.63, "timestamp": "02:43:28", "text": "何が起こっているか分かりますか？"}, {"type": "subtitle", "time": 9813.75, "timestamp": "02:43:33", "text": "バッテリー残量を確認する必要がある。"}, {"type": "subtitle", "time": 9822.469, "timestamp": "02:43:42", "text": "彼は実際にその番号でプレーしています。"}, {"type": "subtitle", "time": 9830.15, "timestamp": "02:43:50", "text": "私のものはとても素敵です。 いつか必ずお金を貯めて、衛星放送を契約するつもりだ"}, {"type": "subtitle", "time": 9839.83, "timestamp": "02:43:59", "text": "、VRを買うべきだよ。 とても楽しいです。   きっと気に入るよ"}]
[{"type": "subtitle", "time": 13083.83, "timestamp": "03:38:03", "text": "うん。 そして、またワクワクしてきた。"}, {"type": "subtitle", "time": 13085.91, "timestamp": "03:38:05", "text": "繰り返しているかもしれませんが、それでも、ええ、"}, {"type": "subtitle", "time": 13088.71, "timestamp": "03:38:08", "text": "興奮したり、"}, {"type": "subtitle", "time": 13100.389, "timestamp": "03:38:20", "text": "そうですね、"}, {"type": "subtitle", "time": 13103.349, "timestamp": "03:38:23", "text": "セキュリティ関連の作業をたくさんやらなきゃいけないんですよね？   よく考えてみると"}, {"type": "subtitle", "time": 13107.03, "timestamp": "03:38:27", "text": "、今の状態を台無しにしたく"}, {"type": "subtitle", "time": 13110.55, "timestamp": "03:38:30", "text": "ない"}, {"type": "subtitle", "time": 13113.83, "timestamp": "03:38:33", "text": "。 今、私が感じているこの平和な気持ち。"}, {"type": "subtitle", "time": 13115.429, "timestamp": "03:38:35", "text": "右。"}, {"type": "subtitle", "time": 13118.389, "timestamp": "03:38:38", "text": "うん。 私が経験した恐ろしい出来事"}, {"type": "subtitle", "time": 13120.15, "timestamp": "03:38:40", "text": "。"}, {"type": "chat", "time": 13121.111, "timestamp": "03:38:41", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQUCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQUCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQ"}, {"type": "subtitle", "time": 13127.03, "timestamp": "03:38:47", "text": "日本にいるときにもっとそうなってほしくはないけど、今はもっと挑戦的な感じになるだろうし、"}, {"type": "subtitle", "time": 13129.51, "timestamp": "03:38:49", "text": "明らかにもっと挑戦があるだろう。"}, {"type": "chat", "time": 13132.54, "timestamp": "03:38:52", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "remember to hydrate"}, {"type": "subtitle", "time": 13133.269, "timestamp": "03:38:53", "text": "人生みたいなもので、"}, {"type": "subtitle", "time": 13137.349, "timestamp": "03:38:57", "text": "人生はたくさんの挑戦を与えてくれる。逃げるのでは"}]
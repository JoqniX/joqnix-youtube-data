[{"type": "subtitle", "time": 3601.19, "timestamp": "01:00:01", "text": "読み書きもできないんだよ"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "常に自分が持っているものに感謝しなさい。ちなみに、"}, {"type": "subtitle", "time": 3617.67, "timestamp": "01:00:17", "text": "道徳や哲学の授業はありません。"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "私はそんなことは気にしない。 醜い人とは絶対に結婚してはいけない"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "。 それがそこから学ぶことだ"}, {"type": "subtitle", "time": 3625.109, "timestamp": "01:00:25", "text": "。 何？   何てことだ"}, {"type": "subtitle", "time": 3627.67, "timestamp": "01:00:27", "text": "。   あなたは、"}, {"type": "subtitle", "time": 3632.309, "timestamp": "01:00:32", "text": "他の人の意見に耳を傾けず、自分が"}, {"type": "subtitle", "time": 3634.95, "timestamp": "01:00:34", "text": "正しいと思うことをしなさいと言うと思っていました。 あなたは今、"}, {"type": "subtitle", "time": 3643.75, "timestamp": "01:00:43", "text": "。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "それは良いことでした。"}, {"type": "subtitle", "time": 3646.95, "timestamp": "01:00:46", "text": "先生になって、私たちにそう言うだけだったのです"}, {"type": "subtitle", "time": 3647.829, "timestamp": "01:00:47", "text": "。"}, {"type": "subtitle", "time": 3650.95, "timestamp": "01:00:50", "text": "黒板を見てください。"}, {"type": "subtitle", "time": 3654.63, "timestamp": "01:00:54", "text": "これはどうやらホワイトボードのようだ。"}]
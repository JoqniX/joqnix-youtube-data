[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "彼女がくれたのはストレートアイロン。彼女は"}, {"type": "subtitle", "time": 4983.669, "timestamp": "01:23:03", "text": "私にストレートアイロンをくれた。彼女は私にヘア"}, {"type": "subtitle", "time": 4985.91, "timestamp": "01:23:05", "text": "ドライヤーをくれた。彼女は私にカーラーをくれた。オーケー。"}, {"type": "subtitle", "time": 4987.59, "timestamp": "01:23:07", "text": "私が言ったのは、「ああ、本当にありがとう」。  「"}, {"type": "subtitle", "time": 4989.99, "timestamp": "01:23:09", "text": "すごく気に入ってるの。」 一つ問題なのは、私は"}, {"type": "subtitle", "time": 4992.47, "timestamp": "01:23:12", "text": "ロングヘアじゃなかったこと。ショート"}, {"type": "subtitle", "time": 4994.39, "timestamp": "01:23:14", "text": "ヘアだったの。だから、どうやって"}, {"type": "subtitle", "time": 4996.87, "timestamp": "01:23:16", "text": "ストレートにすればいいのかわからなかった。よし。"}, {"type": "subtitle", "time": 4999.189, "timestamp": "01:23:19", "text": "タオルで乾かすだけ。"}, {"type": "subtitle", "time": 5001.669, "timestamp": "01:23:21", "text": "半日もすれば乾くのは"}, {"type": "subtitle", "time": 5005.11, "timestamp": "01:23:25", "text": "当然だけど。その後、"}, {"type": "subtitle", "time": 5007.99, "timestamp": "01:23:27", "text": "アストラはアストラじゃなかった。何なの？ジョーは"}, {"type": "subtitle", "time": 5010.229, "timestamp": "01:23:30", "text": "顔追跡を使わなかった。私は"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "彼をアストラと呼んだ。すごい。わかった。えっと、"}, {"type": "subtitle", "time": 5015.189, "timestamp": "01:23:35", "text": "それで、"}, {"type": "subtitle", "time": 5017.43, "timestamp": "01:23:37", "text": "どうしてカーラーが必要なの？"}, {"type": "subtitle", "time": 5020.709, "timestamp": "01:23:40", "text": "カーラーを使わなきゃいけなかった。それは"}, {"type": "subtitle", "time": 5022.87, "timestamp": "01:23:42", "text": "不要だった。そしてそれは、私が"}, {"type": "subtitle", "time": 5025.189, "timestamp": "01:23:45", "text": "母に「ママ、ヘッドセットが欲しい」と言った後のことだった。"}, {"type": "subtitle", "time": 5026.87, "timestamp": "01:23:46", "text": "母がこんなもの全部買えるのに、私はどう感じればいいの"}, {"type": "subtitle", "time": 5028.95, "timestamp": "01:23:48", "text": "？母は私が"}, {"type": "subtitle", "time": 5032.149, "timestamp": "01:23:52", "text": "ヘッドセットを買うことだけは望んでいないのに、母はこんなこと全部やってる。"}, {"type": "subtitle", "time": 5037.91, "timestamp": "01:23:57", "text": "あ、犬がステータスを戻した。"}, {"type": "subtitle", "time": 5039.99, "timestamp": "01:23:59", "text": "どこに"}]
[{"type": "subtitle", "time": 5043.91, "timestamp": "01:24:03", "text": "[ __ ]があったの？待って、"}, {"type": "subtitle", "time": 5047.189, "timestamp": "01:24:07", "text": "待って、実際に入れたんだけど。"}, {"type": "subtitle", "time": 5049.27, "timestamp": "01:24:09", "text": "いや、いや。実際には触ってない。"}, {"type": "subtitle", "time": 5052.47, "timestamp": "01:24:12", "text": "見てもいいよ。"}, {"type": "subtitle", "time": 5054.709, "timestamp": "01:24:14", "text": "こんにちは。"}, {"type": "subtitle", "time": 5058.31, "timestamp": "01:24:18", "text": "あ、どうしてロボットなの？わかった、女の子。"}, {"type": "subtitle", "time": 5059.51, "timestamp": "01:24:19", "text": "ガーリー。ガーリー。待って、"}, {"type": "subtitle", "time": 5061.03, "timestamp": "01:24:21", "text": "ナビをあげるよ。"}, {"type": "subtitle", "time": 5064.149, "timestamp": "01:24:24", "text": "ゲンチンのキャラクターが欲しいの？ああ、違う。"}, {"type": "subtitle", "time": 5065.51, "timestamp": "01:24:25", "text": "これは簡単だよ。"}, {"type": "subtitle", "time": 5084.87, "timestamp": "01:24:44", "text": "犬？そのアバターになりたいの？"}, {"type": "subtitle", "time": 5088.07, "timestamp": "01:24:48", "text": "違う。どれ？"}]
[{"type": "subtitle", "time": 1564.31, "timestamp": "00:26:04", "text": "可能であれば、ホールドなどの操作をしてください。"}, {"type": "subtitle", "time": 1565.51, "timestamp": "00:26:05", "text": "中断可能かどうかはわかりません。"}, {"type": "subtitle", "time": 1566.95, "timestamp": "00:26:06", "text": "あなたは幻肢痛を抱えています。 幻肢"}, {"type": "subtitle", "time": 1569.35, "timestamp": "00:26:09", "text": "痛とは何ですか？"}, {"type": "subtitle", "time": 1570.95, "timestamp": "00:26:10", "text": "ファントム。 ああ、それは中断可能ですが、その"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "一部です。   わかった"}, {"type": "subtitle", "time": 1573.11, "timestamp": "00:26:13", "text": "。"}, {"type": "subtitle", "time": 1576.31, "timestamp": "00:26:16", "text": "ファントム。"}, {"type": "subtitle", "time": 1580.549, "timestamp": "00:26:20", "text": "基本的に、男が睾丸を蹴られるような動作をすると、"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "ああ、ほとんどそうです。だから、私がこのように"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "あなたに触れると、冗談ですが、"}, {"type": "subtitle", "time": 1599.51, "timestamp": "00:26:39", "text": "実際に"}, {"type": "subtitle", "time": 1601.19, "timestamp": "00:26:41", "text": "手に痛みを感じるでしょう。それは"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "幻覚感覚です。なぜなら、あなたの脳は"}, {"type": "subtitle", "time": 1604.23, "timestamp": "00:26:44", "text": "実際に触れられていると考えているからです。"}, {"type": "subtitle", "time": 1606.149, "timestamp": "00:26:46", "text": "しかし、それはでたらめです。"}, {"type": "subtitle", "time": 1606.63, "timestamp": "00:26:46", "text": "ああ、"}, {"type": "subtitle", "time": 1608.47, "timestamp": "00:26:48", "text": "兄弟、男なら誰でも"}]
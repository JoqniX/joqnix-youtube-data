[{"type": "subtitle", "time": 14461.51, "timestamp": "04:01:01", "text": "落ち着いて"}, {"type": "subtitle", "time": 14464.79, "timestamp": "04:01:04", "text": "、ノートパソコンや必要なものが全部揃って、"}, {"type": "subtitle", "time": 14468.309, "timestamp": "04:01:08", "text": "インターネット環境も整ったら、日本から配信します。配信は"}, {"type": "subtitle", "time": 14471.429, "timestamp": "04:01:11", "text": "1回だけです。 どうなるか見てみよう。 そうではないかもしれない。"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "配信しないかもしれません。 知るか？"}, {"type": "subtitle", "time": 14478.55, "timestamp": "04:01:18", "text": "たまに配信するかもしれないけど、"}, {"type": "subtitle", "time": 14482.469, "timestamp": "04:01:22", "text": "今は優先順位をきちんと決めなきゃいけないんだ"}, {"type": "subtitle", "time": 14484.95, "timestamp": "04:01:24", "text": "。 前に言ったように、自分が"}, {"type": "subtitle", "time": 14490.87, "timestamp": "04:01:30", "text": "対処できることに集中しないといけない。"}, {"type": "subtitle", "time": 14494.309, "timestamp": "04:01:34", "text": "それで私は「いや、"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "ストリーミングに時間をかけすぎた。二度とそんな"}, {"type": "subtitle", "time": 14499.51, "timestamp": "04:01:39", "text": "間違いはしたくない。"}, {"type": "subtitle", "time": 14503.429, "timestamp": "04:01:43", "text": "たとえ違う国にいても、"}, {"type": "subtitle", "time": 14506.07, "timestamp": "04:01:46", "text": "これからは動画にする。"}, {"type": "subtitle", "time": 14509.429, "timestamp": "04:01:49", "text": "もっと動画形式にしたい。でも、ライブ"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "配信もいつかやってみるかもしれない。誰にもわからない。"}, {"type": "subtitle", "time": 14516.71, "timestamp": "04:01:56", "text": "旧正月の"}]
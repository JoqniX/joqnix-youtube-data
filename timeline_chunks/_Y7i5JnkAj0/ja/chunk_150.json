[{"type": "subtitle", "time": 9008.15, "timestamp": "02:30:08", "text": "知るか？"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "、兄弟？ お前の顔面を蹴り飛ばしてやるよ、"}, {"type": "subtitle", "time": 9017.429, "timestamp": "02:30:17", "text": "兄弟。"}, {"type": "subtitle", "time": 9019.51, "timestamp": "02:30:19", "text": "いいえ、しません。"}, {"type": "subtitle", "time": 9021.51, "timestamp": "02:30:21", "text": "信じてくれ、俺はお前の"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "顎が折れるくらい思いっきり蹴ってやるよ、兄弟。 あなたは"}, {"type": "subtitle", "time": 9024.55, "timestamp": "02:30:24", "text": "8本の歯を失うでしょう。"}, {"type": "subtitle", "time": 9027.99, "timestamp": "02:30:27", "text": "私はしません。"}, {"type": "subtitle", "time": 9028.389, "timestamp": "02:30:28", "text": "そう、"}, {"type": "subtitle", "time": 9029.99, "timestamp": "02:30:29", "text": "歯だよ。 歯。"}, {"type": "subtitle", "time": 9033.27, "timestamp": "02:30:33", "text": "歯はたった8本しかない。 八。 八。"}, {"type": "subtitle", "time": 9033.59, "timestamp": "02:30:33", "text": "2です。"}, {"type": "subtitle", "time": 9034.79, "timestamp": "02:30:34", "text": "歯。"}, {"type": "subtitle", "time": 9039.429, "timestamp": "02:30:39", "text": "はい。 歯は1つです。 歯はたくさんある。   何てことだ"}, {"type": "subtitle", "time": 9058.95, "timestamp": "02:30:58", "text": "。"}]
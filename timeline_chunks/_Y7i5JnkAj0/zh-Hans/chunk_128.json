[{"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "就像你的脸在这里。"}, {"type": "subtitle", "time": 7690.87, "timestamp": "02:08:10", "text": "好的。是的，我说出来了。"}, {"type": "subtitle", "time": 7692.87, "timestamp": "02:08:12", "text": "好的。抓住我。"}, {"type": "subtitle", "time": 7695.83, "timestamp": "02:08:15", "text": "抓住这些东西很有趣。所以，"}, {"type": "chat", "time": 7707.837, "timestamp": "02:08:27", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQUCkszU2WH9gy1mb0dV-11UJg/vQF1XpyaG_XG8gTs77bACQ"}, {"type": "subtitle", "time": 7718.87, "timestamp": "02:08:38", "text": "跳过这个吗？我从来没…… 不过，约会"}, {"type": "subtitle", "time": 7720.069, "timestamp": "02:08:40", "text": "嘛。"}, {"type": "subtitle", "time": 7721.91, "timestamp": "02:08:41", "text": "说说你经历过的最糟糕的约会"}, {"type": "subtitle", "time": 7723.99, "timestamp": "02:08:43", "text": "。你从来没约会过？"}, {"type": "subtitle", "time": 7726.31, "timestamp": "02:08:46", "text": "没有。从来没有。"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "茉莉，带他去约会吧。"}, {"type": "subtitle", "time": 7730.229, "timestamp": "02:08:50", "text": "我本来想带你去约会的，但你得去"}, {"type": "subtitle", "time": 7731.589, "timestamp": "02:08:51", "text": "日本，兄弟。让"}]
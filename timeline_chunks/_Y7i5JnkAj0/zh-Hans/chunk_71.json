[{"type": "subtitle", "time": 4262.07, "timestamp": "01:11:02", "text": "别说话。要么是，要么否。"}, {"type": "subtitle", "time": 4265.83, "timestamp": "01:11:05", "text": "我的天哪。哦。哦，谢天谢地。"}, {"type": "subtitle", "time": 4267.59, "timestamp": "01:11:07", "text": "你 你 不知道怎么回答这个"}, {"type": "subtitle", "time": 4268.95, "timestamp": "01:11:08", "text": "问题。你不懂英语。我的"}, {"type": "subtitle", "time": 4270.63, "timestamp": "01:11:10", "text": "天哪。"}, {"type": "subtitle", "time": 4273.83, "timestamp": "01:11:13", "text": "更像是“是的，我有”。如果你"}, {"type": "subtitle", "time": 4275.91, "timestamp": "01:11:15", "text": "想说，那就说吧，不然就"}, {"type": "subtitle", "time": 4280.47, "timestamp": "01:11:20", "text": "不是暗恋了。就像……"}, {"type": "subtitle", "time": 4284.709, "timestamp": "01:11:24", "text": "嗯，作为朋友感觉怎么样？"}, {"type": "subtitle", "time": 4287.43, "timestamp": "01:11:27", "text": "有趣吗？是的"}, {"type": "subtitle", "time": 4296.31, "timestamp": "01:11:36", "text": "欢迎回来。是的，"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "笑话是告诉我“是”或“否”。"}, {"type": "subtitle", "time": 4307.669, "timestamp": "01:11:47", "text": "你有没有暗恋过"}, {"type": "subtitle", "time": 4311.11, "timestamp": "01:11:51", "text": "在VR聊天中认识的人？等等，"}, {"type": "subtitle", "time": 4312.95, "timestamp": "01:11:52", "text": "你……"}]
[{"type": "subtitle", "time": 8783.03, "timestamp": "02:26:23", "text": "阿斯特拉（Astra），最多可以注射四"}, {"type": "subtitle", "time": 8785.59, "timestamp": "02:26:25", "text": "针。 要友善。"}, {"type": "subtitle", "time": 8786.389, "timestamp": "02:26:26", "text": "我一边喝酒一边……是"}, {"type": "subtitle", "time": 8788.309, "timestamp": "02:26:28", "text": "啊，喝得"}, {"type": "subtitle", "time": 8795.67, "timestamp": "02:26:35", "text": "我本可能分享一些让你难堪的事情"}, {"type": "subtitle", "time": 8796.79, "timestamp": "02:26:36", "text": "。"}, {"type": "subtitle", "time": 8804.95, "timestamp": "02:26:44", "text": "不。 只有在你觉得舒服的情况下才行。"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "没关系。 没关系。"}, {"type": "subtitle", "time": 8808.309, "timestamp": "02:26:48", "text": "在VR中拍照，然后拍出一张"}, {"type": "subtitle", "time": 8811.429, "timestamp": "02:26:51", "text": "尴尬的照片。 那样就容易多了"}]
[{"type": "subtitle", "time": 6843.43, "timestamp": "01:54:03", "text": "是啊。等等，也让茉莉知道。"}, {"type": "subtitle", "time": 6845.43, "timestamp": "01:54:05", "text": "不，不，不，不，不。说不。说不，"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "乔克。这样不"}, {"type": "subtitle", "time": 6847.99, "timestamp": "01:54:07", "text": "好吗？"}, {"type": "subtitle", "time": 6849.99, "timestamp": "01:54:09", "text": "我是在跟你说话，乔克。是啊。是"}, {"type": "subtitle", "time": 6850.55, "timestamp": "01:54:10", "text": "啊。摸我。是啊。是啊"}, {"type": "subtitle", "time": 6852.709, "timestamp": "01:54:12", "text": "。你确定吗？"}, {"type": "subtitle", "time": 6854.39, "timestamp": "01:54:14", "text": "你现在相信我了吗？"}, {"type": "subtitle", "time": 6857.109, "timestamp": "01:54:17", "text": "我确定。说不。我还有一个。"}, {"type": "subtitle", "time": 6859.75, "timestamp": "01:54:19", "text": "说，"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "告诉另一个，然后他也知道。"}, {"type": "subtitle", "time": 6865.75, "timestamp": "01:54:25", "text": "不，不，不，不。是啊。好吧。"}, {"type": "subtitle", "time": 6867.99, "timestamp": "01:54:27", "text": "问问。"}, {"type": "subtitle", "time": 6870.07, "timestamp": "01:54:30", "text": "我还有一个。是"}, {"type": "subtitle", "time": 6872.31, "timestamp": "01:54:32", "text": "啊。而且你的直播管理员，所以"}, {"type": "subtitle", "time": 6874.79, "timestamp": "01:54:34", "text": "现在发也没用了。是"}, {"type": "subtitle", "time": 6878.79, "timestamp": "01:54:38", "text": "啊，也是这样。是"}, {"type": "subtitle", "time": 6886.47, "timestamp": "01:54:46", "text": "你好。"}, {"type": "subtitle", "time": 6889.669, "timestamp": "01:54:49", "text": "不过时机也太巧了吧。想象一下如果她"}, {"type": "subtitle", "time": 6893.91, "timestamp": "01:54:53", "text": "已经发了。然后"}, {"type": "subtitle", "time": 6896.55, "timestamp": "01:54:56", "text": "我就想，她怎么这么快就搞定了，"}]
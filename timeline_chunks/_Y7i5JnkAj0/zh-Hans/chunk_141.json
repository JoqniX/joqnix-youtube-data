[{"type": "subtitle", "time": 8463.19, "timestamp": "02:21:03", "text": "啊，是啊，是啊。 我知道。 是的，"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "我知道你从来没有去过。"}, {"type": "subtitle", "time": 8466.71, "timestamp": "02:21:06", "text": "所以，换个问题。 不，"}, {"type": "subtitle", "time": 8471.83, "timestamp": "02:21:11", "text": "你"}, {"type": "subtitle", "time": 8473.67, "timestamp": "02:21:13", "text": "在暗恋对象面前做过的最尴尬的事是什么？ 我"}, {"type": "subtitle", "time": 8473.99, "timestamp": "02:21:13", "text": "知道。"}, {"type": "subtitle", "time": 8475.75, "timestamp": "02:21:15", "text": "哦，有意思。 有趣的。"}, {"type": "subtitle", "time": 8476.399, "timestamp": "02:21:16", "text": "有趣的。 呃，"}, {"type": "subtitle", "time": 8478.24, "timestamp": "02:21:18", "text": "呃， 上帝，你为什么要我记住"}, {"type": "subtitle", "time": 8481.04, "timestamp": "02:21:21", "text": "上帝，你为什么要我记住 这件事？ 好的。"}, {"type": "subtitle", "time": 8484.24, "timestamp": "02:21:24", "text": "这件事？ 好的。 在暗恋对象面前。"}, {"type": "subtitle", "time": 8486.8, "timestamp": "02:21:26", "text": "在暗恋对象面前。 哦。"}, {"type": "subtitle", "time": 8489.439, "timestamp": "02:21:29", "text": "哦。 好的。 所以，"}, {"type": "subtitle", "time": 8497.11, "timestamp": "02:21:37", "text": "等等。 我应该在直播里说这个吗？"}, {"type": "subtitle", "time": 8499.59, "timestamp": "02:21:39", "text": "你想说还是不说都行。"}, {"type": "subtitle", "time": 8503.11, "timestamp": "02:21:43", "text": "好的。 我只能说，这是我小时候的样子"}, {"type": "subtitle", "time": 8505.59, "timestamp": "02:21:45", "text": "。"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "呃，我没有。 好的。"}, {"type": "subtitle", "time": 8509.349, "timestamp": "02:21:49", "text": "你小时候。   是的"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "。 就像"}, {"type": "subtitle", "time": 8512.95, "timestamp": "02:21:52", "text": "你暗恋过别人一样。 你小时候有过暗恋对象"}, {"type": "subtitle", "time": 8514.309, "timestamp": "02:21:54", "text": "。"}, {"type": "subtitle", "time": 8516.55, "timestamp": "02:21:56", "text": "你小时候知道“暗恋”是什么意思吗"}, {"type": "subtitle", "time": 8519.27, "timestamp": "02:21:59", "text": "？   当"}]
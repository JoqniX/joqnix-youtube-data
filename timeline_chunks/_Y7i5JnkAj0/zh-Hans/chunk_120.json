[{"type": "subtitle", "time": 7204.55, "timestamp": "02:00:04", "text": "老兄。好了"}, {"type": "subtitle", "time": 7208.709, "timestamp": "02:00:08", "text": "。我讲完了。我的天啊。我要躲起来了。来吧"}, {"type": "subtitle", "time": 7212.39, "timestamp": "02:00:12", "text": "。哦我的。我的"}, {"type": "subtitle", "time": 7216.709, "timestamp": "02:00:16", "text": "天啊。好了。下一个。"}, {"type": "subtitle", "time": 7221.83, "timestamp": "02:00:21", "text": "我的天啊，"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "原来你是这个意思。我当时想，"}, {"type": "subtitle", "time": 7227.189, "timestamp": "02:00:27", "text": "你会像……呃……什么……"}, {"type": "subtitle", "time": 7230.709, "timestamp": "02:00:30", "text": "呃……我现在说话的方式……以前"}, {"type": "subtitle", "time": 7233.35, "timestamp": "02:00:33", "text": "我有时还会说"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "那是什么鬼？"}, {"type": "subtitle", "time": 7259.43, "timestamp": "02:00:59", "text": "好了，你讲完了。"}]
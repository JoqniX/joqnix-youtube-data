[{"type": "subtitle", "time": 15600.79, "timestamp": "04:20:00", "text": "朋友们。"}, {"type": "subtitle", "time": 15603.269, "timestamp": "04:20:03", "text": "不要总是做好事，好吗？"}, {"type": "subtitle", "time": 15605.83, "timestamp": "04:20:05", "text": "记住这一点。"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "帮助别人。"}, {"type": "subtitle", "time": 15610.149, "timestamp": "04:20:10", "text": "无论是小事，做你该做的"}, {"type": "subtitle", "time": 15613.03, "timestamp": "04:20:13", "text": "事，好吗？让"}, {"type": "subtitle", "time": 15621.269, "timestamp": "04:20:21", "text": "自己更快乐，更自信。嗨。"}, {"type": "chat", "time": 15621.596, "timestamp": "04:20:21", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Will do"}, {"type": "subtitle", "time": 15623.91, "timestamp": "04:20:23", "text": "我相信下次你们再看到"}, {"type": "chat", "time": 15626.025, "timestamp": "04:20:26", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AE"}, {"type": "subtitle", "time": 15628.07, "timestamp": "04:20:28", "text": "我的时候，我可能已经脱胎换骨了。也许"}, {"type": "subtitle", "time": 15630.309, "timestamp": "04:20:30", "text": "我会变成一个不一样的运动员。"}, {"type": "subtitle", "time": 15633.349, "timestamp": "04:20:33", "text": "谁知道呢？我相信我自己也会"}, {"type": "subtitle", "time": 15636.55, "timestamp": "04:20:36", "text": "看到这一点。所以，是的，我迫不及待地想要看到"}, {"type": "subtitle", "time": 15640.149, "timestamp": "04:20:40", "text": "那一刻。"}, {"type": "subtitle", "time": 15642.79, "timestamp": "04:20:42", "text": "大家不要忘记做好事，不要"}, {"type": "subtitle", "time": 15646.07, "timestamp": "04:20:46", "text": "忘记做好"}, {"type": "subtitle", "time": 15648.229, "timestamp": "04:20:48"
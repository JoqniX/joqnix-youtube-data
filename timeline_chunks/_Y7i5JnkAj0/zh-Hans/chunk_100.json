[{"type": "subtitle", "time": 6007.75, "timestamp": "01:40:07", "text": "啊，其实我在考虑要不要"}, {"type": "subtitle", "time": 6009.59, "timestamp": "01:40:09", "text": "答应，你知道，"}, {"type": "subtitle", "time": 6012.229, "timestamp": "01:40:12", "text": "想想吧"}, {"type": "subtitle", "time": 6014.149, "timestamp": "01:40:14", "text": "兄弟，她杀了我之前可不会考虑的"}, {"type": "subtitle", "time": 6016.95, "timestamp": "01:40:16", "text": "。说"}, {"type": "subtitle", "time": 6018.87, "timestamp": "01:40:18", "text": "实话，"}, {"type": "subtitle", "time": 6022.07, "timestamp": "01:40:22", "text": "就算要我"}, {"type": "subtitle", "time": 6027.669, "timestamp": "01:40:27", "text": "是啊，"}, {"type": "subtitle", "time": 6029.83, "timestamp": "01:40:29", "text": "因为我的生命很珍贵。你的生命也很"}, {"type": "subtitle", "time": 6031.43, "timestamp": "01:40:31", "text": "珍贵。你不能把生命献给"}, {"type": "subtitle", "time": 6033.189, "timestamp": "01:40:33", "text": "任何人。"}, {"type": "chat", "time": 6033.944, "timestamp": "01:40:33", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "what you looking?"}, {"type": "subtitle", "time": 6035.43, "timestamp": "01:40:35", "text": "这很值得。"}, {"type": "subtitle", "time": 6059.59, "timestamp": "01:40:59", "text": "哦不。糟了。"}]
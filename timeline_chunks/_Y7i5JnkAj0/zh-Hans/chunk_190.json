[{"type": "subtitle", "time": 11406.389, "timestamp": "03:10:06", "text": "我很兴奋。 我有"}, {"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "很多事情感到焦虑。"}, {"type": "chat", "time": 11413.732, "timestamp": "03:10:13", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "we all are children"}, {"type": "subtitle", "time": 11413.75, "timestamp": "03:10:13", "text": "天哪，我今天真是焦虑极了。"}, {"type": "subtitle", "time": 11416.469, "timestamp": "03:10:16", "text": "我的老师说，"}, {"type": "subtitle", "time": 11419.51, "timestamp": "03:10:19", "text": "当我从"}, {"type": "subtitle", "time": 11422.23, "timestamp": "03:10:22", "text": "家乡来到机场时，"}, {"type": "subtitle", "time": 11425.11, "timestamp": "03:10:25", "text": "我可能会感到焦虑。"}, {"type": "subtitle", "time": 11427.429, "timestamp": "03:10:27", "text": "另一个和我一起来的学生"}, {"type": "subtitle", "time": 11432.07, "timestamp": "03:10:32", "text": "，他比较稳重。"}, {"type": "subtitle", "time": 11436.389, "timestamp": "03:10:36", "text": "我下飞机后会转机，虽然不是直飞"}, {"type": "subtitle", "time": 11438.389, "timestamp": "03:10:38", "text": "，而是中转"}, {"type": "chat", "time": 11438.671, "timestamp": "03:10:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "*virtual hugs* bro"}, {"type": "subtitle", "time": 11440.95, "timestamp": "03:10:40", "text": "航班，但我不需要透露"}, {"type": "subtitle", "time": 11443.03, "timestamp": "03:10:43", "text": "太多信息。 我为什么会想到要"}, {"type": "subtitle", "time": 11445.91, "timestamp": "03:10:45", "text": "唠叨这些事呢？ 但是，是的，就像在更高的"}, {"type": "subtitle", "time": 11449.11, "timestamp": "03:10:49", "text": "层次上，我可以保持中立，"}, {"type": "subtitle", "time": 11453.349, "timestamp": "03:10:53", "text": "而他可以保持焦虑。"}, {"type": "subtitle", "time": 11456.389, "timestamp": "03:10:56", "text": "希望这个想法能顺利实现"}]
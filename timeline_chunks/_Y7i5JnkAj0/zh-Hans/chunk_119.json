[{"type": "subtitle", "time": 7140.629, "timestamp": "01:59:00", "text": "我不知道。你什么意思？我不"}, {"type": "subtitle", "time": 7147.75, "timestamp": "01:59:07", "text": "个人是不是先"}, {"type": "subtitle", "time": 7163.03, "timestamp": "01:59:23", "text": "刚才突然想到了。"}, {"type": "subtitle", "time": 7165.91, "timestamp": "01:59:25", "text": "呃，"}, {"type": "subtitle", "time": 7176.07, "timestamp": "01:59:36", "text": "开玩笑。"}, {"type": "subtitle", "time": 7178.149, "timestamp": "01:59:38", "text": "狗说。不。什么？你在"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "呃，"}, {"type": "subtitle", "time": 7182.87, "timestamp": "01:59:42", "text": "什么？"}, {"type": "subtitle", "time": 7185.189, "timestamp": "01:59:45", "text": "我确实想要……我很好奇。"}, {"type": "subtitle", "time": 7188.629, "timestamp": "01:59:48", "text": "我们会说什么呢？但我又想，“不，我"}, {"type": "subtitle", "time": 7189.03, "timestamp": "01:59:49", "text": "应该。”"}, {"type": "subtitle", "time": 7190.629, "timestamp": "01:59:50", "text": "你知道吗？好吧。好吧。好吧。好吧。"}, {"type": "subtitle", "time": 7193.83, "timestamp": "01:59:53", "text": "猜猜看。那个人叫你的方式"}, {"type": "subtitle", "time": 7196.629, "timestamp": "01:59:56", "text": "就像，“J。”"}]
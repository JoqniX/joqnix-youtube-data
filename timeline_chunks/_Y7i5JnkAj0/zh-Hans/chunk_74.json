[{"type": "subtitle", "time": 4440.63, "timestamp": "01:14:00", "text": "基本上，我经常"}, {"type": "subtitle", "time": 4442.63, "timestamp": "01:14:02", "text": "出去玩。你知道我不应该说什么吗？"}, {"type": "subtitle", "time": 4447.189, "timestamp": "01:14:07", "text": "我是个视频。我做过的酷事，"}, {"type": "subtitle", "time": 4451.03, "timestamp": "01:14:11", "text": "呃，你们想知道的是哪一类或者什么"}, {"type": "subtitle", "time": 4465.51, "timestamp": "01:14:25", "text": "我其实不知道。如果你告诉我"}, {"type": "subtitle", "time": 4467.03, "timestamp": "01:14:27", "text": "你爬过山，我还会"}, {"type": "subtitle", "time": 4470.229, "timestamp": "01:14:30", "text": "相信你。"}, {"type": "subtitle", "time": 4472.87, "timestamp": "01:14:32", "text": "我没爬过山。"}, {"type": "subtitle", "time": 4478.709, "timestamp": "01:14:38", "text": "我不知道。"}, {"type": "subtitle", "time": 4487.99, "timestamp": "01:14:47", "text": "你玩过越野摩托车"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "或者赛车之类的吗？"}, {"type": "subtitle", "time": 4495.51, "timestamp": "01:14:55", "text": "呃，赛车，直线加速赛。"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "哦，直线加速赛。"}, {"type": "subtitle", "time": 4498.95, "timestamp": "01:14:58", "text": "那太好了。"}]
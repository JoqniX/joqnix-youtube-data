[{"type": "subtitle", "time": 14341.11, "timestamp": "03:59:01", "text": "嘘，别说话。 嗯，我"}, {"type": "subtitle", "time": 14343.99, "timestamp": "03:59:03", "text": "觉得这挺好的。"}, {"type": "subtitle", "time": 14346.229, "timestamp": "03:59:06", "text": "前往著名的十字路口。 祝你人气爆棚"}, {"type": "chat", "time": 14348.061, "timestamp": "03:59:08", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "it not a loose mouth that for like those who talk bad words"}, {"type": "subtitle", "time": 14349.75, "timestamp": "03:59:09", "text": "。 哦，是的。 湿婆神路过。 我以前经常"}, {"type": "subtitle", "time": 14352.07, "timestamp": "03:59:12", "text": "在 YouTube 上看那种直播，就像现在的"}, {"type": "subtitle", "time": 14364.229, "timestamp": "03:59:24", "text": "天啊，我当时就想，是啊，你可以"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "从日本看到这款相机，对吧？ 就像"}, {"type": "subtitle", "time": 14369.99, "timestamp": "03:59:29", "text": "相机一样。 对，可能是交通信号灯摄像头之"}, {"type": "subtitle", "time": 14372.229, "timestamp": "03:59:32", "text": "类的。 你就像用固定摄像头一样，不停地观察人们过"}, {"type": "subtitle", "time": 14375.11, "timestamp": "03:59:35", "text": "马路、移动等等，"}, {"type": "subtitle", "time": 14378.309, "timestamp": "03:59:38", "text": "对吧？"}, {"type": "subtitle", "time": 14381.59, "timestamp": "03:59:41", "text": "直播。 我以前经常看那个英国过境的"}, {"type": "subtitle", "time": 14384.389, "timestamp": "03:59:44", "text": "节目。 人们在走路"}, {"type": "subtitle", "time": 14387.189, "timestamp": "03:59:47", "text": "等等。比如星期一，"}, {"type": "subtitle", "time": 14390.87, "timestamp": "03:59:50", "text": "繁忙的一天，人们在走路。"}, {"type": "subtitle", "time": 14399.269, "timestamp": "03:59:59", "text": "很难。"}]
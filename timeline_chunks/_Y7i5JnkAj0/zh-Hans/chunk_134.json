[{"type": "subtitle", "time": 8041.91, "timestamp": "02:14:01", "text": "有那么一刻。有那么"}, {"type": "subtitle", "time": 8045.03, "timestamp": "02:14:05", "text": "一刻，在VR聊天里，我和"}, {"type": "subtitle", "time": 8048.79, "timestamp": "02:14:08", "text": "我的三个朋友去"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "野餐了。"}, {"type": "subtitle", "time": 8055.189, "timestamp": "02:14:15", "text": "对，野餐。我 呃呃，名字都写在"}, {"type": "subtitle", "time": 8057.589, "timestamp": "02:14:17", "text": "我的个人简介里了，想看的人自然"}, {"type": "subtitle", "time": 8061.83, "timestamp": "02:14:21", "text": "会看。呃，就是马文"}, {"type": "subtitle", "time": 8064.629, "timestamp": "02:14:24", "text": "他们。对。"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "兄弟，看得我眼睛疼。好吧。对，"}, {"type": "subtitle", "time": 8071.35, "timestamp": "02:14:31", "text": "我们玩得很开心。这是"}, {"type": "subtitle", "time": 8074.629, "timestamp": "02:14:34", "text": "我喜欢的一点。他们画画，我也画画，我坐在"}, {"type": "subtitle", "time": 8076.47, "timestamp": "02:14:36", "text": "角落里看着那两个"}, {"type": "subtitle", "time": 8078.55, "timestamp": "02:14:38", "text": "卿卿我我的情侣画画，我"}, {"type": "subtitle", "time": 8081.91, "timestamp": "02:14:41", "text": "好开心。我就"}, {"type": "subtitle", "time": 8083.35, "timestamp": "02:14:43", "text": "看着。"}, {"type": "subtitle", "time": 8084.31, "timestamp": "02:14:44", "text": "等等，为什么？是"}, {"type": "subtitle", "time": 8087.189, "timestamp": "02:14:47", "text": "啊。"}, {"type": "subtitle", "time": 8089.35, "timestamp": "02:14:49", "text": "你说你在野餐的时候看情侣"}, {"type": "subtitle", "time": 8095.43, "timestamp": "02:14:55", "text": "阿拉，说真的，你想让我把你拉黑"}, {"type": "chat", "time": 8097.864, "timestamp": "02:14:57", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Jasmine changes accents real quick"}]
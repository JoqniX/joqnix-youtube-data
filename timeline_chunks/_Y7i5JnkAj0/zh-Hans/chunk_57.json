[{"type": "subtitle", "time": 3421.51, "timestamp": "00:57:01", "text": "那么，在经历了这一切闹剧和混乱之后，又发生了什么呢"}, {"type": "subtitle", "time": 3424.549, "timestamp": "00:57:04", "text": "？ 邦蒂去世后，邦蒂"}, {"type": "subtitle", "time": 3428.23, "timestamp": "00:57:08", "text": "最终结了婚。 好的。"}, {"type": "subtitle", "time": 3431.51, "timestamp": "00:57:11", "text": "经历了两三年的风风雨雨后，他们终于"}, {"type": "subtitle", "time": 3433.91, "timestamp": "00:57:13", "text": "结婚了。"}, {"type": "subtitle", "time": 3439.68, "timestamp": "00:57:19", "text": "。 后来有一天，邦迪被发现死亡。"}, {"type": "subtitle", "time": 3445.2, "timestamp": "00:57:25", "text": "后来有一天，邦迪被发现死亡。 什么？   是的"}, {"type": "subtitle", "time": 3447.599, "timestamp": "00:57:27", "text": "什么？   是的 。 猜猜为什么？"}, {"type": "subtitle", "time": 3455.67, "timestamp": "00:57:35", "text": "她……呃，她"}, {"type": "subtitle", "time": 3460.47, "timestamp": "00:57:40", "text": "妻子杀了她。 击毙了邦迪。"}, {"type": "subtitle", "time": 3462.309, "timestamp": "00:57:42", "text": "不。哦，大家都以为是妻子杀了"}, {"type": "subtitle", "time": 3465.349, "timestamp": "00:57:45", "text": "邦蒂，但其实不是，"}, {"type": "subtitle", "time": 3466.71, "timestamp": "00:57:46", "text": "杀邦蒂的不是妻子。"}, {"type": "subtitle", "time": 3467.589, "timestamp": "00:57:47", "text": "母亲？"}, {"type": "subtitle", "time": 3470.95, "timestamp": "00:57:50", "text": "那是他岳母。   是的"}, {"type": "subtitle", "time": 3472.95, "timestamp": "00:57:52", "text": "。"}, {"type": "subtitle", "time": 3475.67, "timestamp": "00:57:55", "text": "但其中有个陷阱。 婆婆"}, {"type": "subtitle", "time": 3477.75, "timestamp": "00:57:57", "text": "认为，如果她杀了邦蒂，"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "她的女儿就能继承"}]
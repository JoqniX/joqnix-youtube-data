[{"type": "subtitle", "time": 7997.35, "timestamp": "02:13:17", "text": "哦，等等。我还在说"}, {"type": "subtitle", "time": 8002.709, "timestamp": "02:13:22", "text": "我最珍贵的回忆。"}, {"type": "subtitle", "time": 8005.27, "timestamp": "02:13:25", "text": "不，我不小心把"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "手指竖起来了，不知道为什么"}, {"type": "subtitle", "time": 8010.629, "timestamp": "02:13:30", "text": "。我当时在摸鼻子，"}, {"type": "subtitle", "time": 8012.39, "timestamp": "02:13:32", "text": "你竖起了中指。你在"}, {"type": "subtitle", "time": 8015.83, "timestamp": "02:13:35", "text": "直播。不，我当时在摸鼻子，"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "然后就竖起了中指。"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "你为什么摸鼻子？"}, {"type": "subtitle", "time": 8023.589, "timestamp": "02:13:43", "text": "我摸是"}, {"type": "subtitle", "time": 8026.709, "timestamp": "02:13:46", "text": "因为我在调整"}, {"type": "subtitle", "time": 8028.79, "timestamp": "02:13:48", "text": "眼镜。"}, {"type": "subtitle", "time": 8032.229, "timestamp": "02:13:52", "text": "闭嘴。让她说。我的"}, {"type": "subtitle", "time": 8034.069, "timestamp": "02:13:54", "text": "意思是，我不介意被忽略。"}, {"type": "subtitle", "time": 8036.629, "timestamp": "02:13:56", "text": "没关系。"}, {"type": "subtitle", "time": 8039.189, "timestamp": "02:13:59", "text": "你已经习惯被忽略了。"}, {"type": "subtitle", "time": 8039.83, "timestamp": "02:13:59", "text": "闭嘴。"}]
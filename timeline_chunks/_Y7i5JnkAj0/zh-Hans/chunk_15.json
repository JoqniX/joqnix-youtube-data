[{"type": "subtitle", "time": 922.629, "timestamp": "00:15:22", "text": "所以，嗯，对于那些还没有"}, {"type": "subtitle", "time": 924.31, "timestamp": "00:15:24", "text": "看过我公告的人，我发布了一条"}, {"type": "subtitle", "time": 926.949, "timestamp": "00:15:26", "text": "关于我将于"}, {"type": "subtitle", "time": 930.87, "timestamp": "00:15:30", "text": "4号前往日本的公告。 今天的直播结束后"}, {"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "，我会收拾我的"}, {"type": "subtitle", "time": 937.67, "timestamp": "00:15:37", "text": "直播设备之类的东西，比如"}, {"type": "subtitle", "time": 941.189, "timestamp": "00:15:41", "text": "麦克风等等，这些都是"}, {"type": "subtitle", "time": 945.03, "timestamp": "00:15:45", "text": "我直播时用的。 是的"}, {"type": "subtitle", "time": 948.23, "timestamp": "00:15:48", "text": "，"}, {"type": "subtitle", "time": 950.949, "timestamp": "00:15:50", "text": "正如我之前提到的，今天将是最后一次直播。"}, {"type": "subtitle", "time": 953.749, "timestamp": "00:15:53", "text": "嗯，"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "今天我要喝一杯，让今晚成为"}]
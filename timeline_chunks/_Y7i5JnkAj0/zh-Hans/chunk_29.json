[{"type": "subtitle", "time": 1748.47, "timestamp": "00:29:08", "text": "我很害怕。   好了"}, {"type": "subtitle", "time": 1776.63, "timestamp": "00:29:36", "text": "太好了。"}, {"type": "subtitle", "time": 1779.19, "timestamp": "00:29:39", "text": "我不明白，我无法感受到这种胡说八道。"}, {"type": "subtitle", "time": 1782.389, "timestamp": "00:29:42", "text": "这就是正常的事情。"}, {"type": "subtitle", "time": 1787.269, "timestamp": "00:29:47", "text": "等等，我要捅死你。 什么？"}, {"type": "subtitle", "time": 1789.99, "timestamp": "00:29:49", "text": "我看不到你正在使用的任何东西。"}, {"type": "subtitle", "time": 1792.31, "timestamp": "00:29:52", "text": "请使这款 Quest 设备兼容，以便"}]
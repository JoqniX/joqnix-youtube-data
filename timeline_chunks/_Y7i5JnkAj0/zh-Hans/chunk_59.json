[{"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "好吧，行。   是的"}, {"type": "subtitle", "time": 3550.71, "timestamp": "00:59:10", "text": "所以经历了这一切之后，你"}, {"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "从这个故事中学到了什么？  Bunty Tan所遭受的一切苦难都是"}, {"type": "subtitle", "time": 3559.99, "timestamp": "00:59:19", "text": "因为她的母亲。 她一开始以为"}, {"type": "subtitle", "time": 3561.43, "timestamp": "00:59:21", "text": "自己会嫁给一个有钱人。 但"}, {"type": "subtitle", "time": 3563.67, "timestamp": "00:59:23", "text": "他长得丑。 那人是个"}, {"type": "subtitle", "time": 3566.87, "timestamp": "00:59:26", "text": "文盲。 那人很穷，还有一个"}, {"type": "subtitle", "time": 3569.109, "timestamp": "00:59:29", "text": "孩子。 她肩负着他"}, {"type": "subtitle", "time": 3570.63, "timestamp": "00:59:30", "text": "不能、她不能离开她的"}, {"type": "subtitle", "time": 3572.069, "timestamp": "00:59:32", "text": "孩子的责任，因为昨晚死去的是她的孩子"}, {"type": "subtitle", "time": 3572.549, "timestamp": "00:59:32", "text": "。   是的"}, {"type": "subtitle", "time": 3572.87, "timestamp": "00:59:32", "text": "。"}, {"type": "subtitle", "time": 3575.75, "timestamp": "00:59:35", "text": "那么她得到了什么回报呢？ 一个女孩长得"}, {"type": "subtitle", "time": 3578.63, "timestamp": "00:59:38", "text": "漂亮，识字，而且非常聪明，她能"}, {"type": "subtitle", "time": 3580.63, "timestamp": "00:59:40", "text": "努力工作，收入比"}, {"type": "subtitle", "time": 3583.109, "timestamp": "00:59:43", "text": "本蒂高。"}, {"type": "subtitle", "time": 3583.67, "timestamp": "00:59:43", "text": "嗯。   本来可以"}, {"type": "subtitle", "time": 3586.23, "timestamp": "00:59:46", "text": "过上好日子。 但仅仅"}, {"type": "subtitle", "time": 3590.15, "timestamp": "00:59:50", "text": "因为她妈妈说她是拜金女，"}, {"type": "subtitle", "time": 3593.109, "timestamp": "00:59:53", "text": "她就什么也没得到。 她还要"}, {"type": "subtitle", "time": 3595.67, "timestamp": "00:59:55", "text": "照顾孩子。 她在大学期间有过一段空档期"}, {"type": "subtitle", "time": 3598.15, "timestamp": "00:59:58", "text": "。 她既没有学位，"}]
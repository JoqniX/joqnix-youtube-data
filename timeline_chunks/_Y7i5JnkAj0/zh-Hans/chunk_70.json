[{"type": "subtitle", "time": 4206.07, "timestamp": "01:10:06", "text": "想想。你在聊天中做过的最奇怪的事情是什么？下次。下一个。好的，让我想想。"}, {"type": "subtitle", "time": 4211.669, "timestamp": "01:10:11", "text": "鱼子酱。味道"}, {"type": "subtitle", "time": 4213.43, "timestamp": "01:10:13", "text": "怎么样？"}, {"type": "subtitle", "time": 4215.669, "timestamp": "01:10:15", "text": "不，不是那个。它就像黄油一样，口感像"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "奶油一样。"}, {"type": "subtitle", "time": 4221.11, "timestamp": "01:10:21", "text": "它咸咸的，又很滑。"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "感觉就像黄油，但"}, {"type": "subtitle", "time": 4225.83, "timestamp": "01:10:25", "text": "质地不一样。所以你要用"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "面包之类的东西吃。就像饼干之"}, {"type": "subtitle", "time": 4231.11, "timestamp": "01:10:31", "text": "类的东西。就是那种味道。"}, {"type": "subtitle", "time": 4234.149, "timestamp": "01:10:34", "text": "说实话，我觉得它名不副实"}, {"type": "subtitle", "time": 4245.83, "timestamp": "01:10:45", "text": "嗨。呃，我们再来一次"}, {"type": "subtitle", "time": 4256.87, "timestamp": "01:10:56", "text": "我真的得说说这个。"}, {"type": "subtitle", "time": 4258.95, "timestamp": "01:10:58", "text": "我的天哪。"}]
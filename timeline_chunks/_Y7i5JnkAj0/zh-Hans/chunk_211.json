[{"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "。 谢谢。 欢迎。"}, {"type": "subtitle", "time": 12669.75, "timestamp": "03:31:09", "text": "嗯，是的。 所以当我抵达"}, {"type": "subtitle", "time": 12672.229, "timestamp": "03:31:12", "text": "日本后，所有东西都会是汉字和"}, {"type": "subtitle", "time": 12675.429, "timestamp": "03:31:15", "text": "日语，对吧？"}, {"type": "subtitle", "time": 12678.79, "timestamp": "03:31:18", "text": "所有的一切。 连我的居民"}, {"type": "subtitle", "time": 12681.11, "timestamp": "03:31:21", "text": "卡也包括在内。   是的"}, {"type": "subtitle", "time": 12685.03, "timestamp": "03:31:25", "text": "，所有事情都糟透了，"}, {"type": "subtitle", "time": 12694.229, "timestamp": "03:31:34", "text": "我会习惯的，"}, {"type": "subtitle", "time": 12699.67, "timestamp": "03:31:39", "text": "我很兴奋。"}, {"type": "subtitle", "time": 12702.07, "timestamp": "03:31:42", "text": "多久？ 呃，"}, {"type": "subtitle", "time": 12704.07, "timestamp": "03:31:44", "text": "超过两年了。"}, {"type": "subtitle", "time": 12706.469, "timestamp": "03:31:46", "text": "我打算先上"}, {"type": "subtitle", "time": 12708.309, "timestamp": "03:31:48", "text": "两年的语言课，然后去"}, {"type": "subtitle", "time": 12714.389, "timestamp": "03:31:54", "text": "那里读大学。"}, {"type": "subtitle", "time": 12716.95, "timestamp": "03:31:56", "text": "我可能要转行学音乐，然后去读"}]
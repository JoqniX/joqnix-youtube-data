[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "她送我的直发器。她送了"}, {"type": "subtitle", "time": 4983.669, "timestamp": "01:23:03", "text": "我一个 她给了我一个直发器。她还给了我一个吹风"}, {"type": "subtitle", "time": 4985.91, "timestamp": "01:23:05", "text": "机。她又给了我一个卷发器。好的。"}, {"type": "subtitle", "time": 4987.59, "timestamp": "01:23:07", "text": "我说了一句话：“哦，非常感谢。” 我"}, {"type": "subtitle", "time": 4989.99, "timestamp": "01:23:09", "text": "太喜欢它了。”有一件事，我的"}, {"type": "subtitle", "time": 4992.47, "timestamp": "01:23:12", "text": "头发不长。我的"}, {"type": "subtitle", "time": 4994.39, "timestamp": "01:23:14", "text": "头发很短。不。所以我不知道"}, {"type": "subtitle", "time": 4996.87, "timestamp": "01:23:16", "text": "我该怎么把它拉直。好吧。我"}, {"type": "subtitle", "time": 4999.189, "timestamp": "01:23:19", "text": "只能用毛巾擦干。"}, {"type": "subtitle", "time": 5001.669, "timestamp": "01:23:21", "text": "半天之内它就干了，"}, {"type": "subtitle", "time": 5005.11, "timestamp": "01:23:25", "text": "很明显。之后，"}, {"type": "subtitle", "time": 5007.99, "timestamp": "01:23:27", "text": "Astra 就不是 Astra 了。搞什么鬼？Jo"}, {"type": "subtitle", "time": 5010.229, "timestamp": "01:23:30", "text": "没用面部追踪。我叫"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "他 Astra。哇。好吧。嗯，"}, {"type": "subtitle", "time": 5015.189, "timestamp": "01:23:35", "text": "那"}, {"type": "subtitle", "time": 5017.43, "timestamp": "01:23:37", "text": "我为什么需要卷发棒？"}, {"type": "subtitle", "time": 5020.709, "timestamp": "01:23:40", "text": "呃，我得用卷发棒。那完全"}, {"type": "subtitle", "time": 5022.87, "timestamp": "01:23:42", "text": "没必要。那是在我"}, {"type": "subtitle", "time": 5025.189, "timestamp": "01:23:45", "text": "告诉我妈“妈，我想要个头戴式耳机”之后。"}, {"type": "subtitle", "time": 5026.87, "timestamp": "01:23:46", "text": "她能"}, {"type": "subtitle", "time": 5028.95, "timestamp": "01:23:48", "text": "买得起这些东西，我该作何感想？她就是不想让我"}, {"type": "subtitle", "time": 5032.149, "timestamp": "01:23:52", "text": "买头戴式耳机，她自己却买了这么多。"}, {"type": "subtitle", "time": 5037.91, "timestamp": "01:23:57", "text": "哦，狗的状态又变回来了。"}]
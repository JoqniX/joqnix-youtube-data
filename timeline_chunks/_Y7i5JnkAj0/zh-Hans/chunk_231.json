[{"type": "subtitle", "time": 13861.91, "timestamp": "03:51:01", "text": "我当时想，我试着跟一个主播聊天。他坐在"}, {"type": "subtitle", "time": 13865.269, "timestamp": "03:51:05", "text": "椅子上，跟我站在类似舞台的平台上聊天，"}, {"type": "subtitle", "time": 13867.03, "timestamp": "03:51:07", "text": "所有"}, {"type": "subtitle", "time": 13869.429, "timestamp": "03:51:09", "text": "家长都在等着，好像在接受"}, {"type": "subtitle", "time": 13872.55, "timestamp": "03:51:12", "text": "采访。他"}, {"type": "subtitle", "time": 13875.429, "timestamp": "03:51:15", "text": "手里拿着稿子，"}, {"type": "subtitle", "time": 13877.59, "timestamp": "03:51:17", "text": "一个接一个地问我"}, {"type": "subtitle", "time": 13879.67, "timestamp": "03:51:19", "text": "问题，他想"}, {"type": "subtitle", "time": 13883.11, "timestamp": "03:51:23", "text": "知道我会怎么回答。我说我"}, {"type": "chat", "time": 13885.514, "timestamp": "03:51:25", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 13886.95, "timestamp": "03:51:26", "text": "滔滔不绝，他说：“不错，"}, {"type": "subtitle", "time": 13890.469, "timestamp": "03:51:30", "text": "但我们可以缩短一下。"}, {"type": "subtitle", "time": 13894.71, "timestamp": "03:51:34", "text": "我们需要给观众一个"}, {"type": "subtitle", "time": 13897.11, "timestamp": "03:51:37", "text": "理由，你要展现出你的"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "热情和自信等等。” 我当时很"}, {"type": "subtitle", "time": 13904.309, "timestamp": "03:51:44", "text": "紧张，因为我以前也"}, {"type": "chat", "time": 13910.256, "timestamp": "03:51:50", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ahh"}, {"type": "subtitle", "time": 13912.15, "timestamp": "03:51:52", "text": "拍过视频，但我从来"}, {"type": "subtitle", "time": 13914.15, "timestamp": "03:51:54", "text": "不"}, {"type": "subtitle", "time": 13917.03, "timestamp": "03:51:57", "text": "写稿子，总是即兴发挥"}]
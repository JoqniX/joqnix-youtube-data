[{"type": "subtitle", "time": 11280.79, "timestamp": "03:08:00", "text": "想念我的电脑的。 我会想念这里的一切"}, {"type": "chat", "time": 11282.74, "timestamp": "03:08:02", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "its a big step so anxiety is normal"}, {"type": "subtitle", "time": 11283.91, "timestamp": "03:08:03", "text": "。 现在"}, {"type": "subtitle", "time": 11286.15, "timestamp": "03:08:06", "text": "我房间里所有的生物和非生物物品"}, {"type": "subtitle", "time": 11289.51, "timestamp": "03:08:09", "text": "。 计划、"}, {"type": "subtitle", "time": 11296.07, "timestamp": "03:08:16", "text": "我的直播设备、我的显示器通道、我的"}, {"type": "subtitle", "time": 11299.349, "timestamp": "03:08:19", "text": "电脑通道、我的鼠标通道、我的键盘、我的 MIDI"}, {"type": "subtitle", "time": 11302.87, "timestamp": "03:08:22", "text": "键盘音源（我用它来制作音乐），"}, {"type": "subtitle", "time": 11309.359, "timestamp": "03:08:29", "text": "， 这简直就像是迈出了一大步"}, {"type": "subtitle", "time": 11318.389, "timestamp": "03:08:38", "text": "。 感觉就像我要去月球上散步"}, {"type": "subtitle", "time": 11320.87, "timestamp": "03:08:40", "text": "一样。 这是一"}, {"type": "subtitle", "time": 11323.03, "timestamp": "03:08:43", "text": "大步，对吧？"}, {"type": "subtitle", "time": 11327.99, "timestamp": "03:08:47", "text": "呃，超级超级爱干净的内向者，"}, {"type": "subtitle", "time": 11330.55, "timestamp": "03:08:50", "text": "几乎不出门，几乎没有生活"}, {"type": "subtitle", "time": 11332.07, "timestamp": "03:08:52", "text": "经验，即将"}, {"type": "subtitle", "time": 11335.51, "timestamp": "03:08:55", "text": "走出家门，与人接触。 我的意思是，我"}, {"type": "subtitle", "time": 11337.349, "timestamp": "03:08:57", "text": "已经有了那种感觉，就像我要去"}]
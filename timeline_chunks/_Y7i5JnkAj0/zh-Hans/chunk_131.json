[{"type": "subtitle", "time": 7862.229, "timestamp": "02:11:02", "text": "对着女孩尖叫很有趣。哎哟。"}, {"type": "subtitle", "time": 7863.669, "timestamp": "02:11:03", "text": "不，这不好笑。"}, {"type": "subtitle", "time": 7873.109, "timestamp": "02:11:13", "text": "你为什么要"}, {"type": "subtitle", "time": 7874.87, "timestamp": "02:11:14", "text": "杀人？"}, {"type": "subtitle", "time": 7883.35, "timestamp": "02:11:23", "text": "我能怎么办？就像我被带到一个"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "恐怖地图，一个极难地图，然后我就想，你"}, {"type": "subtitle", "time": 7889.35, "timestamp": "02:11:29", "text": "知道吗？与其玩恐怖"}, {"type": "subtitle", "time": 7892.149, "timestamp": "02:11:32", "text": "游戏，不如尖叫吧。"}]
[{"type": "subtitle", "time": 4861.03, "timestamp": "01:21:01", "text": "耶！"}, {"type": "subtitle", "time": 4862.95, "timestamp": "01:21:02", "text": "你的排第二，因为是你做的"}, {"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "。你花了很多心思。我"}, {"type": "subtitle", "time": 4867.11, "timestamp": "01:21:07", "text": "的排第三，因为那不是"}, {"type": "subtitle", "time": 4872.87, "timestamp": "01:21:12", "text": "狗狗，轮到你了。"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "我的天哪。我是认真的。狗狗。"}, {"type": "subtitle", "time": 4880.07, "timestamp": "01:21:20", "text": "我应该第一次去那里吗？"}, {"type": "subtitle", "time": 4903.03, "timestamp": "01:21:43", "text": "？嗯？是的。是的。我框起来的那个是"}, {"type": "subtitle", "time": 4905.59, "timestamp": "01:21:45", "text": "我的名字。开始吧。"}]
[{"type": "subtitle", "time": 1564.31, "timestamp": "00:26:04", "text": "如果可以的话，请保持互动。 我不知道"}, {"type": "subtitle", "time": 1565.51, "timestamp": "00:26:05", "text": "它是否可以被中断。"}, {"type": "subtitle", "time": 1566.95, "timestamp": "00:26:06", "text": "你患有幻肢痛。 什么是幻肢"}, {"type": "subtitle", "time": 1569.35, "timestamp": "00:26:09", "text": "痛？"}, {"type": "subtitle", "time": 1570.95, "timestamp": "00:26:10", "text": "幻影。 哦，是的，它可以被中断，"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "但只能中断一部分。"}, {"type": "subtitle", "time": 1573.11, "timestamp": "00:26:13", "text": "好的。"}, {"type": "subtitle", "time": 1576.31, "timestamp": "00:26:16", "text": "幻影。 幻觉"}, {"type": "subtitle", "time": 1580.549, "timestamp": "00:26:20", "text": "基本上是指当一个人的睾丸被"}, {"type": "subtitle", "time": 1583.35, "timestamp": "00:26:23", "text": "踢到时，你会感到"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "哦我的天，差不多就是这样。所以，"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "如果我这样碰你，好吧，开玩笑，如果"}, {"type": "subtitle", "time": 1599.51, "timestamp": "00:26:39", "text": "我这样碰你，你实际上会"}, {"type": "subtitle", "time": 1601.19, "timestamp": "00:26:41", "text": "感觉到手上的疼痛，这就是"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "幻觉，因为你的大脑会"}, {"type": "subtitle", "time": 1604.23, "timestamp": "00:26:44", "text": "认为你真的被碰了，"}, {"type": "subtitle", "time": 1606.149, "timestamp": "00:26:46", "text": "但这都是胡扯。"}, {"type": "subtitle", "time": 1606.63, "timestamp": "00:26:46", "text": "哎，"}, {"type": "subtitle", "time": 1608.47, "timestamp": "00:26:48", "text": "兄弟，每个男人在感情方面都有一些不可告人的秘密"}]
[{"type": "subtitle", "time": 6723.75, "timestamp": "01:52:03", "text": "随便说点蠢话？"}, {"type": "subtitle", "time": 6728.07, "timestamp": "01:52:08", "text": "好吧。不，那其实挺无聊的。"}, {"type": "subtitle", "time": 6729.589, "timestamp": "01:52:09", "text": "不。"}, {"type": "subtitle", "time": 6732.709, "timestamp": "01:52:12", "text": "让我来。相信我。"}, {"type": "subtitle", "time": 6736.39, "timestamp": "01:52:16", "text": "相信我。让我来。"}, {"type": "subtitle", "time": 6738.629, "timestamp": "01:52:18", "text": "下次我会让你来的。不，"}, {"type": "subtitle", "time": 6740.149, "timestamp": "01:52:20", "text": "我保证。"}, {"type": "subtitle", "time": 6741.99, "timestamp": "01:52:21", "text": "别用那种可怜巴巴的眼神看着我。不，我"}, {"type": "subtitle", "time": 6742.95, "timestamp": "01:52:22", "text": "不会那样做的。"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "让她私信他的管理员"}, {"type": "subtitle", "time": 6748.709, "timestamp": "01:52:28", "text": "她对服务器不满意，"}, {"type": "subtitle", "time": 6750.149, "timestamp": "01:52:30", "text": "想让他们辞职。"}, {"type": "subtitle", "time": 6752.31, "timestamp": "01:52:32", "text": "我的天哪。"}, {"type": "subtitle", "time": 6753.75, "timestamp": "01:52:33", "text": "不。"}, {"type": "subtitle", "time": 6755.669, "timestamp": "01:52:35", "text": "问问她。"}, {"type": "subtitle", "time": 6757.35, "timestamp": "01:52:37", "text": "问问她怎么做。"}, {"type": "subtitle", "time": 6761.189, "timestamp": "01:52:41", "text": "这太蠢了。"}, {"type": "subtitle", "time": 6762.709, "timestamp": "01:52:42", "text": "我不知道。你不知道她"}, {"type": "subtitle", "time": 6764.31, "timestamp": "01:52:44", "text": "和管理员的关系吗？你不"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "知道是谁。你为什么想……"}, {"type": "subtitle", "time": 6768.79, "timestamp": "01:52:48", "text": "好吧。好吧。我在打字。我在敲键盘。"}, {"type": "subtitle", "time": 6769.35, "timestamp": "01:52:49", "text": "哦，我知道了。"}, {"type": "subtitle", "time": 6770.79, "timestamp": "01:52:50", "text": "我在敲键盘。"}, {"type": "subtitle", "time": 6773.03, "timestamp": "01:52:53", "text": "截图，GM。"}, {"type": "subtitle", "time": 6776.55, "timestamp": "01:52:56", "text": "为什么？为什么不截图？不。"}]
[{"type": "subtitle", "time": 4324.149, "timestamp": "01:12:04", "text": "。"}, {"type": "subtitle", "time": 4326.31, "timestamp": "01:12:06", "text": "我遇到过一个人，"}, {"type": "subtitle", "time": 4329.189, "timestamp": "01:12:09", "text": "我遇到过一个来自日本的人。"}, {"type": "subtitle", "time": 4331.11, "timestamp": "01:12:11", "text": "你只需要诚实地回答“是”或“否”"}, {"type": "subtitle", "time": 4331.83, "timestamp": "01:12:11", "text": "。是的。是的。"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "我……我可以说……呃……"}, {"type": "subtitle", "time": 4338.63, "timestamp": "01:12:18", "text": "也许。好的。有“是”或“否”吗？是的。“也许”也可以。是的。“也许”"}, {"type": "subtitle", "time": 4341.189, "timestamp": "01:12:21", "text": "也行。是的。是的。“也许”。也许。"}, {"type": "subtitle", "time": 4349.189, "timestamp": "01:12:29", "text": "好的。"}, {"type": "subtitle", "time": 4361.51, "timestamp": "01:12:41", "text": "状态。呃，等等。我们有实时状态"}, {"type": "subtitle", "time": 4362.79, "timestamp": "01:12:42", "text": "。哦，是的。我们有。"}, {"type": "subtitle", "time": 4364.47, "timestamp": "01:12:44", "text": "嗯。是的。"}, {"type": "subtitle", "time": 4369.11, "timestamp": "01:12:49", "text": "呃，"}, {"type": "subtitle", "time": 4373.35, "timestamp": "01:12:53", "text": "群组 选好你的状态设置。"}]
[{"type": "subtitle", "time": 9008.15, "timestamp": "02:30:08", "text": "谁知道呢？"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "搞什么鬼，兄弟？ 兄弟，我揍你一顿"}, {"type": "subtitle", "time": 9017.429, "timestamp": "02:30:17", "text": "。"}, {"type": "subtitle", "time": 9019.51, "timestamp": "02:30:19", "text": "不，我不会。"}, {"type": "subtitle", "time": 9021.51, "timestamp": "02:30:21", "text": "相信我，我会狠狠地踢你，把你的"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "下巴踢断，兄弟。 你会失去"}, {"type": "subtitle", "time": 9024.55, "timestamp": "02:30:24", "text": "八颗牙齿。"}, {"type": "subtitle", "time": 9027.99, "timestamp": "02:30:27", "text": "我不会。"}, {"type": "subtitle", "time": 9028.389, "timestamp": "02:30:28", "text": "对，"}, {"type": "subtitle", "time": 9029.99, "timestamp": "02:30:29", "text": "牙齿。 牙齿。"}, {"type": "subtitle", "time": 9033.27, "timestamp": "02:30:33", "text": "我只有八颗牙。 八。 八。 是"}, {"type": "subtitle", "time": 9033.59, "timestamp": "02:30:33", "text": "二。"}, {"type": "subtitle", "time": 9034.79, "timestamp": "02:30:34", "text": "牙齿。   是的"}, {"type": "subtitle", "time": 9039.429, "timestamp": "02:30:39", "text": "。 牙齿是其中之一。 牙齿很多。"}, {"type": "subtitle", "time": 9058.95, "timestamp": "02:30:58", "text": "好的。"}]
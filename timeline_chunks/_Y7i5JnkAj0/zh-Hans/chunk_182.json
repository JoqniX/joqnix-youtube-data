[{"type": "subtitle", "time": 10920.389, "timestamp": "03:02:00", "text": "等等等等，嗯，很多事情，对吧？"}, {"type": "subtitle", "time": 10925.75, "timestamp": "03:02:05", "text": "不，我不确定我"}, {"type": "subtitle", "time": 10928.389, "timestamp": "03:02:08", "text": "在日本的这段旅程会把我带向何方"}, {"type": "subtitle", "time": 10930.63, "timestamp": "03:02:10", "text": "。 我还会认识很多新朋友，看到很多"}, {"type": "subtitle", "time": 10933.51, "timestamp": "03:02:13", "text": "新面孔。"}, {"type": "subtitle", "time": 10935.99, "timestamp": "03:02:15", "text": "但我仍然不想忘记那些"}, {"type": "chat", "time": 10937.539, "timestamp": "03:02:17", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "well I'll pray you have smooth journey and a good circle"}, {"type": "subtitle", "time": 10939.67, "timestamp": "03:02:19", "text": "在我人生起步阶段给予我帮助的人"}, {"type": "subtitle", "time": 10944.71, "timestamp": "03:02:24", "text": "。 呃，这要献给我的"}, {"type": "subtitle", "time": 10947.11, "timestamp": "03:02:27", "text": "社区成员们，"}, {"type": "subtitle", "time": 10950.23, "timestamp": "03:02:30", "text": "呃，"}, {"type": "chat", "time": 10950.441, "timestamp": "03:02:30", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yup yup"}, {"type": "subtitle", "time": 10953.91, "timestamp": "03:02:33", "text": "即使在经历了所有这些跌宕起伏的"}, {"type": "subtitle", "time": 10956.23, "timestamp": "03:02:36", "text": "事件之后，他们仍然与我同在。"}, {"type": "subtitle", "time": 10960.79, "timestamp": "03:02:40", "text": "嗯，这么多年来，对吧？"}, {"type": "subtitle", "time": 10965.75, "timestamp": "03:02:45", "text": "如果你能"}, {"type": "subtitle", "time": 10969.99, "timestamp": "03:02:49", "text": "继续支持我，我会非常感激。 是的，因为"}, {"type": "subtitle", "time": 10974.469, "timestamp": "03:02:54", "text": "我再次全心全意地在我的……"}, {"type": "chat", "time": 10979.669, "timestamp": "03:02:59", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}]
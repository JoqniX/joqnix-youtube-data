[{"type": "subtitle", "time": 3368.549, "timestamp": "00:56:08", "text": "显然，在第一次模拟之后，他们就"}, {"type": "subtitle", "time": 3370.549, "timestamp": "00:56:10", "text": "开始互相交谈了。 他们相遇了，"}, {"type": "subtitle", "time": 3372.95, "timestamp": "00:56:12", "text": "他们开始玩游戏，"}, {"type": "subtitle", "time": 3374.71, "timestamp": "00:56:14", "text": "开始玩VR图表，开始"}, {"type": "subtitle", "time": 3379.03, "timestamp": "00:56:19", "text": "玩我的世界，然后他们就相遇了。"}, {"type": "subtitle", "time": 3381.109, "timestamp": "00:56:21", "text": "因为邦蒂出身富裕"}, {"type": "subtitle", "time": 3383.27, "timestamp": "00:56:23", "text": "家庭，"}, {"type": "subtitle", "time": 3386.47, "timestamp": "00:56:26", "text": "邦蒂的妈妈才知道她有个"}, {"type": "subtitle", "time": 3389.349, "timestamp": "00:56:29", "text": "非常富有的朋友。"}, {"type": "subtitle", "time": 3390.87, "timestamp": "00:56:30", "text": "好的。"}, {"type": "subtitle", "time": 3392.87, "timestamp": "00:56:32", "text": "显然，她并非出身于桥牌"}, {"type": "subtitle", "time": 3394.309, "timestamp": "00:56:34", "text": "世家，而是来自一个贫困"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "家庭。"}, {"type": "subtitle", "time": 3395.75, "timestamp": "00:56:35", "text": "哦。"}, {"type": "subtitle", "time": 3399.43, "timestamp": "00:56:39", "text": "于是她妈妈开始强迫邦迪·谭去"}, {"type": "subtitle", "time": 3403.19, "timestamp": "00:56:43", "text": "约邦迪出去约会。"}, {"type": "subtitle", "time": 3406.87, "timestamp": "00:56:46", "text": "但邦迪·泰不喜欢邦迪。"}, {"type": "subtitle", "time": 3408.71, "timestamp": "00:56:48", "text": "但她妈妈喜欢邦迪是因为"}, {"type": "subtitle", "time": 3410.309, "timestamp": "00:56:50", "text": "有钱。"}, {"type": "subtitle", "time": 3412.23, "timestamp": "00:56:52", "text": "所以邦迪并非拜金男。"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "好的。"}]
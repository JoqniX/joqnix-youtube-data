[{"type": "subtitle", "time": 3189.27, "timestamp": "00:53:09", "text": "本蒂是个文盲。 就是这样。   是的"}, {"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "。"}, {"type": "subtitle", "time": 3194.549, "timestamp": "00:53:14", "text": "但另一方面，潘，"}, {"type": "subtitle", "time": 3197.43, "timestamp": "00:53:17", "text": "他以前生活在一个"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "像个贫困的家庭。 好的。"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "她很穷。"}, {"type": "subtitle", "time": 3216.39, "timestamp": "00:53:36", "text": "但本蒂·迪安的学习成绩非常好"}, {"type": "subtitle", "time": 3229.27, "timestamp": "00:53:49", "text": "她是大学里的尖子生。 她获得了"}, {"type": "subtitle", "time": 3231.75, "timestamp": "00:53:51", "text": "奖学金，得以在"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "霍格沃茨学习。"}, {"type": "subtitle", "time": 3238.95, "timestamp": "00:53:58", "text": "她去霍格沃茨接受教育。"}]
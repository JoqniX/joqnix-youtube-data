[{"type": "subtitle", "time": 6971.189, "timestamp": "01:56:11", "text": "我不想那样。"}, {"type": "subtitle", "time": 6973.35, "timestamp": "01:56:13", "text": "我不想破坏别人"}, {"type": "subtitle", "time": 6976.229, "timestamp": "01:56:16", "text": "醒来时的心情。"}, {"type": "subtitle", "time": 6979.03, "timestamp": "01:56:19", "text": "不是说他们醒来发现自己少了"}, {"type": "subtitle", "time": 6980.07, "timestamp": "01:56:20", "text": "什么。他们"}, {"type": "subtitle", "time": 6983.03, "timestamp": "01:56:23", "text": "少了什么？不是"}, {"type": "subtitle", "time": 6984.87, "timestamp": "01:56:24", "text": "那种愚蠢的、更"}, {"type": "subtitle", "time": 6987.99, "timestamp": "01:56:27", "text": "独特的、甚至人类都想象不到的东西"}, {"type": "subtitle", "time": 6997.43, "timestamp": "01:56:37", "text": "你想问什么？"}, {"type": "subtitle", "time": 6999.51, "timestamp": "01:56:39", "text": "想象一下你有一个贴纸。好的。然后"}, {"type": "subtitle", "time": 7001.189, "timestamp": "01:56:41", "text": "你想，“哦，我希望我的贴纸在"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "那里。”好的。就说，想象一下我"}, {"type": "subtitle", "time": 7004.55, "timestamp": "01:56:44", "text": "带着耳机走了。早上"}, {"type": "subtitle", "time": 7006.79, "timestamp": "01:56:46", "text": "醒来，我发现耳机不见了。"}]
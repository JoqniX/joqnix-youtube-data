[{"type": "subtitle", "time": 3128.79, "timestamp": "00:52:08", "text": "。"}, {"type": "subtitle", "time": 3131.03, "timestamp": "00:52:11", "text": "好的。"}, {"type": "subtitle", "time": 3141.109, "timestamp": "00:52:21", "text": "单恋，单恋，"}, {"type": "subtitle", "time": 3150.39, "timestamp": "00:52:30", "text": "所以，邦迪基本上是在一个"}, {"type": "subtitle", "time": 3153.589, "timestamp": "00:52:33", "text": "非常富裕的家庭长大的。 好的。"}, {"type": "subtitle", "time": 3154.0, "timestamp": "00:52:34", "text": "好的。 这简直就像邦蒂的豪宅。"}, {"type": "subtitle", "time": 3156.72, "timestamp": "00:52:36", "text": "这简直就像邦蒂的豪宅。 就像一个富得流油的富翁，他真是个"}, {"type": "subtitle", "time": 3167.19, "timestamp": "00:52:47", "text": "富翁。 邦蒂很有钱。 非常富有。 他像"}, {"type": "subtitle", "time": 3170.39, "timestamp": "00:52:50", "text": "他父亲一样，是世界上最富有的人之一。"}, {"type": "subtitle", "time": 3170.79, "timestamp": "00:52:50", "text": "好的。"}, {"type": "subtitle", "time": 3173.91, "timestamp": "00:52:53", "text": "但邦迪从未接受过教育，"}, {"type": "subtitle", "time": 3175.99, "timestamp": "00:52:55", "text": "因为他的父亲很富有。 所以他没能"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "接受教育。 好的。"}]
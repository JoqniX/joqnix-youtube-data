[{"type": "subtitle", "time": 7320.95, "timestamp": "02:02:00", "text": "很好……"}, {"type": "subtitle", "time": 7321.75, "timestamp": "02:02:01", "text": "想出名。"}, {"type": "subtitle", "time": 7323.189, "timestamp": "02:02:03", "text": "我要换椅子。"}, {"type": "subtitle", "time": 7325.43, "timestamp": "02:02:05", "text": "哦，我知道答案。"}, {"type": "subtitle", "time": 7325.99, "timestamp": "02:02:05", "text": "我知道。"}, {"type": "subtitle", "time": 7327.589, "timestamp": "02:02:07", "text": "我可以说那个词吗？是"}, {"type": "subtitle", "time": 7330.149, "timestamp": "02:02:10", "text": "什么让你出名的，老兄？"}, {"type": "subtitle", "time": 7330.79, "timestamp": "02:02:10", "text": "哦，"}, {"type": "subtitle", "time": 7332.87, "timestamp": "02:02:12", "text": "好的。等等，在我回答这个问题之前，我刚刚"}, {"type": "subtitle", "time": 7337.03, "timestamp": "02:02:17", "text": "想说，是的，目前我"}, {"type": "subtitle", "time": 7340.55, "timestamp": "02:02:20", "text": "出名是因为"}, {"type": "subtitle", "time": 7343.43, "timestamp": "02:02:23", "text": "错误的原因。错误的原因。是的。是的"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "。但是，"}, {"type": "subtitle", "time": 7350.39, "timestamp": "02:02:30", "text": "我希望将来能因为"}, {"type": "subtitle", "time": 7353.43, "timestamp": "02:02:33", "text": "音乐或其他什么而出名。是的，这就是"}, {"type": "subtitle", "time": 7355.189, "timestamp": "02:02:35", "text": "我的愿望。"}, {"type": "subtitle", "time": 7357.43, "timestamp": "02:02:37", "text": "音乐。我会像"}, {"type": "subtitle", "time": 7359.189, "timestamp": "02:02:39", "text": "做完瑜伽后那样，教你"}, {"type": "subtitle", "time": 7366.07, "timestamp": "02:02:46", "text": "那种音乐制作，那种"}, {"type": "subtitle", "time": 7368.709, "timestamp": "02:02:48", "text": "数字音乐。"}, {"type": "subtitle", "time": 7370.47, "timestamp": "02:02:50", "text": "你什么意思，兄弟？如果你想……不，"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "不。如果你想出名，你现在就必须展现你的才华"}]
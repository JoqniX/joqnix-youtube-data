[{"type": "subtitle", "time": 9061.91, "timestamp": "02:31:01", "text": "你有什么不为人知的才能吗？"}, {"type": "subtitle", "time": 9070.95, "timestamp": "02:31:10", "text": "我拥有两项隐藏的才能。"}, {"type": "subtitle", "time": 9074.07, "timestamp": "02:31:14", "text": "这是一种人们会做的手势，"}, {"type": "subtitle", "time": 9076.469, "timestamp": "02:31:16", "text": "我的食指和无名指"}, {"type": "subtitle", "time": 9078.63, "timestamp": "02:31:18", "text": "可以向后弯曲，一起"}, {"type": "subtitle", "time": 9081.67, "timestamp": "02:31:21", "text": "形成一个心形。 好的。 我能摸到我的"}, {"type": "subtitle", "time": 9081.83, "timestamp": "02:31:21", "text": "大拇指。"}, {"type": "subtitle", "time": 9084.23, "timestamp": "02:31:24", "text": "兄弟，这他妈怎么回事？   是的"}, {"type": "subtitle", "time": 9086.469, "timestamp": "02:31:26", "text": "。 真的吗？ 如果我把手"}, {"type": "subtitle", "time": 9087.75, "timestamp": "02:31:27", "text": "指向后弯曲，"}, {"type": "subtitle", "time": 9090.389, "timestamp": "02:31:30", "text": "你看，我可以把拇指完全向后弯曲，"}, {"type": "subtitle", "time": 9092.23, "timestamp": "02:31:32", "text": "就像整个手指都可以向后弯曲一样。"}, {"type": "subtitle", "time": 9093.75, "timestamp": "02:31:33", "text": "我说：“请把你的才能"}, {"type": "subtitle", "time": 9095.27, "timestamp": "02:31:35", "text": "隐藏起来。”"}, {"type": "subtitle", "time": 9100.309, "timestamp": "02:31:40", "text": "你不喜欢吗？"}, {"type": "subtitle", "time": 9102.389, "timestamp": "02:31:42", "text": "你喜不喜欢我才不在乎。"}, {"type": "subtitle", "time": 9103.99, "timestamp": "02:31:43", "text": "它们就在这里，而你不想听到。"}]
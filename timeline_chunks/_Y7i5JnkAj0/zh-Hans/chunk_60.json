[{"type": "subtitle", "time": 3601.19, "timestamp": "01:00:01", "text": "现在也是个文盲"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "永远要感恩你所拥有的一切，"}, {"type": "subtitle", "time": 3614.87, "timestamp": "01:00:14", "text": "而且，"}, {"type": "subtitle", "time": 3617.67, "timestamp": "01:00:17", "text": "这里没有道德课或哲学课。"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "我不在乎。 永远不要娶长相"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "丑陋的人。 这就是你从中学到的"}, {"type": "subtitle", "time": 3625.109, "timestamp": "01:00:25", "text": "。 什么？"}, {"type": "subtitle", "time": 3627.67, "timestamp": "01:00:27", "text": "我的天啊。"}, {"type": "subtitle", "time": 3630.069, "timestamp": "01:00:30", "text": "我以为你会说不要听"}, {"type": "subtitle", "time": 3632.309, "timestamp": "01:00:32", "text": "其他人的意见，要坚持做自己"}, {"type": "subtitle", "time": 3634.95, "timestamp": "01:00:34", "text": "认为正确的事。 你刚才的行为"}, {"type": "subtitle", "time": 3643.75, "timestamp": "01:00:43", "text": "我的天啊。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "那真是太好了，他当"}, {"type": "subtitle", "time": 3646.95, "timestamp": "01:00:46", "text": "老师只是为了告诉我们“是的”"}, {"type": "subtitle", "time": 3647.829, "timestamp": "01:00:47", "text": "。"}, {"type": "subtitle", "time": 3650.95, "timestamp": "01:00:50", "text": "看看黑板。"}, {"type": "subtitle", "time": 3654.63, "timestamp": "01:00:54", "text": "这显然是一块白板。   是的"}]
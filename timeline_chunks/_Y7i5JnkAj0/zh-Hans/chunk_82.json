[{"type": "subtitle", "time": 4920.39, "timestamp": "01:22:00", "text": "我只让她这么做。"}, {"type": "subtitle", "time": 4922.709, "timestamp": "01:22:02", "text": "什么？"}, {"type": "subtitle", "time": 4923.83, "timestamp": "01:22:03", "text": "她是谁？"}, {"type": "subtitle", "time": 4927.99, "timestamp": "01:22:07", "text": "我框起来的是我自己。"}, {"type": "subtitle", "time": 4930.709, "timestamp": "01:22:10", "text": "别人怎么知道是你？"}, {"type": "subtitle", "time": 4932.87, "timestamp": "01:22:12", "text": "我填了我的名字。"}, {"type": "subtitle", "time": 4935.669, "timestamp": "01:22:15", "text": "等等，"}, {"type": "subtitle", "time": 4955.189, "timestamp": "01:22:35", "text": "我只为"}, {"type": "subtitle", "time": 4970.149, "timestamp": "01:22:50", "text": "你有没有撒谎说喜欢某个礼物？"}, {"type": "subtitle", "time": 4977.11, "timestamp": "01:22:57", "text": "是什么？我撒谎说喜欢某个礼物。"}, {"type": "subtitle", "time": 4979.83, "timestamp": "01:22:59", "text": "是的。我骗我妈妈说我喜欢"}]
[{"type": "subtitle", "time": 3785.43, "timestamp": "01:03:05", "text": "哦，再见了。 哦，是的。 显然，我们"}, {"type": "subtitle", "time": 3788.71, "timestamp": "01:03:08", "text": "要去《亲爱的，你为何敢？》"}, {"type": "subtitle", "time": 3791.349, "timestamp": "01:03:11", "text": "那不是事实。"}, {"type": "subtitle", "time": 3793.75, "timestamp": "01:03:13", "text": "好的。 我的真相是什么？ 你"}, {"type": "subtitle", "time": 3796.549, "timestamp": "01:03:16", "text": "最喜欢的喝酒游戏是什么？为什么？ 我不"}, {"type": "subtitle", "time": 3799.19, "timestamp": "01:03:19", "text": "喝酒。"}, {"type": "subtitle", "time": 3801.19, "timestamp": "01:03:21", "text": "好的。 开玩笑的。 随你"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "点击“等待”。 所以，我得绕路"}, {"type": "subtitle", "time": 3811.349, "timestamp": "01:03:31", "text": "点击进去看看。"}, {"type": "subtitle", "time": 3811.75, "timestamp": "01:03:31", "text": "嗯。"}, {"type": "subtitle", "time": 3814.63, "timestamp": "01:03:34", "text": "你想点击哪里？ 我会说"}, {"type": "subtitle", "time": 3823.109, "timestamp": "01:03:43", "text": "如果你喜欢啤酒，你最喜欢哪种？"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "你喜欢喝啤酒吗？"}, {"type": "subtitle", "time": 3828.87, "timestamp": "01:03:48", "text": "不，我不喝酒。 我喝"}, {"type": "subtitle", "time": 3830.15, "timestamp": "01:03:50", "text": "苹果汁。"}, {"type": "subtitle", "time": 3832.549, "timestamp": "01:03:52", "text": "好了，轮到你了。"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "但从"}, {"type": "subtitle", "time": 3838.95, "timestamp": "01:03:58", "text": "现在开始，"}]
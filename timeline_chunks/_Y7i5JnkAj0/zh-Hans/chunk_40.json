[{"type": "subtitle", "time": 2404.39, "timestamp": "00:40:04", "text": "它对我有什么作用？   我的"}, {"type": "subtitle", "time": 2406.23, "timestamp": "00:40:06", "text": "天，"}, {"type": "subtitle", "time": 2409.349, "timestamp": "00:40:09", "text": "我重新启动了直播。"}, {"type": "subtitle", "time": 2409.75, "timestamp": "00:40:09", "text": "好的。   妈的"}, {"type": "subtitle", "time": 2411.589, "timestamp": "00:40:11", "text": "。 我得重新设置一下。"}, {"type": "subtitle", "time": 2413.349, "timestamp": "00:40:13", "text": "不可能，兄弟。"}, {"type": "subtitle", "time": 2416.95, "timestamp": "00:40:16", "text": "阿斯特拉，我看不到你的艾比。"}, {"type": "subtitle", "time": 2421.03, "timestamp": "00:40:21", "text": "是的，我还可以说说你的头像。"}, {"type": "subtitle", "time": 2442.63, "timestamp": "00:40:42", "text": "你为什么要改变我的发型？ 因为我确实是"}, {"type": "subtitle", "time": 2445.51, "timestamp": "00:40:45", "text": "。 她出车祸了。"}, {"type": "subtitle", "time": 2449.19, "timestamp": "00:40:49", "text": "等等，什么？ 她出车祸了。 谁撞车了？"}, {"type": "subtitle", "time": 2450.23, "timestamp": "00:40:50", "text": "啊，"}, {"type": "subtitle", "time": 2452.55, "timestamp": "00:40:52", "text": "不。"}, {"type": "subtitle", "time": 2454.39, "timestamp": "00:40:54", "text": "我把他拉黑了，然后又把他解除拉黑。 它会"}, {"type": "subtitle", "time": 2455.51, "timestamp": "00:40:55", "text": "频繁启动。"}, {"type": "subtitle", "time": 2457.349, "timestamp": "00:40:57", "text": "是的，我以前用过。"}]
[{"type": "subtitle", "time": 8345.19, "timestamp": "02:19:05", "text": "你有没有为了避免"}, {"type": "subtitle", "time": 8346.95, "timestamp": "02:19:06", "text": "惹麻烦而撒过谎？ 是的。"}, {"type": "subtitle", "time": 8349.509, "timestamp": "02:19:09", "text": "坏的。"}, {"type": "subtitle", "time": 8349.99, "timestamp": "02:19:09", "text": "开玩笑。   那"}, {"type": "subtitle", "time": 8352.629, "timestamp": "02:19:12", "text": "是什么？ 你上一次"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "说谎是什么时候？说谎的原因是什么？"}, {"type": "subtitle", "time": 8364.07, "timestamp": "02:19:24", "text": "愤怒。 公共汽车。"}, {"type": "subtitle", "time": 8383.75, "timestamp": "02:19:43", "text": "你没有回答。 住口。"}, {"type": "subtitle", "time": 8385.75, "timestamp": "02:19:45", "text": "我回答了。"}, {"type": "subtitle", "time": 8391.11, "timestamp": "02:19:51", "text": "先回答。 最后一个谎言是什么？"}]
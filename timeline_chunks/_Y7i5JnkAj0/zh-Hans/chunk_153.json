[{"type": "subtitle", "time": 9184.55, "timestamp": "02:33:04", "text": "如果我跟你说些什么，你也不会觉得难过"}, {"type": "subtitle", "time": 9193.11, "timestamp": "02:33:13", "text": "我说别难过。 你感到很难过。"}, {"type": "subtitle", "time": 9194.309, "timestamp": "02:33:14", "text": "某物。"}, {"type": "subtitle", "time": 9211.19, "timestamp": "02:33:31", "text": "应该很快就能得到答案。 令人愉悦的。"}, {"type": "subtitle", "time": 9214.71, "timestamp": "02:33:34", "text": "公牛队。 公牛队。 公牛队。 公牛队。 公牛队。"}, {"type": "subtitle", "time": 9216.23, "timestamp": "02:33:36", "text": "事实上，我身上有很多我"}, {"type": "subtitle", "time": 9223.91, "timestamp": "02:33:43", "text": "。 杰斯一直在努力"}, {"type": "subtitle", "time": 9225.51, "timestamp": "02:33:45", "text": "寻找"}, {"type": "subtitle", "time": 9227.03, "timestamp": "02:33:47", "text": "自己喜欢的地方。 你知道，太多了。 我不知道"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "两种截然不同的性格，对吧？"}, {"type": "subtitle", "time": 9237.51, "timestamp": "02:33:57", "text": "嗯，"}]
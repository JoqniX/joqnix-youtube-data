[{"type": "subtitle", "time": 8641.91, "timestamp": "02:24:01", "text": "哦，是啊，我也遇到过这种情况。 我跌倒了。"}, {"type": "subtitle", "time": 8657.11, "timestamp": "02:24:17", "text": "嗨。 你好。"}, {"type": "subtitle", "time": 8658.469, "timestamp": "02:24:18", "text": "好吧，没事了。"}, {"type": "chat", "time": 8660.52, "timestamp": "02:24:20", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "somehow those example felt close to someone"}, {"type": "subtitle", "time": 8661.349, "timestamp": "02:24:21", "text": "哦，我只是想说，但你"}, {"type": "subtitle", "time": 8663.91, "timestamp": "02:24:23", "text": "可能会觉得这样说不太好。 这没什么好"}, {"type": "subtitle", "time": 8667.83, "timestamp": "02:24:27", "text": "尴尬的，不过确实如此。 所以我想说，"}, {"type": "subtitle", "time": 8671.349, "timestamp": "02:24:31", "text": "好吧，这只是一个阶段。 好的。 呃，"}, {"type": "subtitle", "time": 8674.63, "timestamp": "02:24:34", "text": "这只是我人生中的一个阶段。 好的。"}, {"type": "subtitle", "time": 8678.389, "timestamp": "02:24:38", "text": "所以我提前到了教室。 好的。"}, {"type": "subtitle", "time": 8680.55, "timestamp": "02:24:40", "text": "过来。 过来。 过来。 我过去常常"}, {"type": "subtitle", "time": 8681.11, "timestamp": "02:24:41", "text": "坐着，"}, {"type": "subtitle", "time": 8682.71, "timestamp": "02:24:42", "text": "看着我的眼睛，然后告诉我。"}, {"type": "subtitle", "time": 8685.03, "timestamp": "02:24:45", "text": "好的。"}, {"type": "subtitle", "time": 8687.19, "timestamp": "02:24:47", "text": "，"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "我那天很早就到了教室，"}, {"type": "subtitle", "time": 8695.349, "timestamp": "02:24:55", "text": "比任何人都早得多，而我喜欢的人也在"}]
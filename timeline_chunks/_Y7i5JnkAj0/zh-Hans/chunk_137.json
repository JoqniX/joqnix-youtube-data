[{"type": "subtitle", "time": 8223.349, "timestamp": "02:17:03", "text": "该怎么说呢？感觉"}, {"type": "subtitle", "time": 8226.389, "timestamp": "02:17:06", "text": "我们一开始互动很少，"}, {"type": "subtitle", "time": 8231.509, "timestamp": "02:17:11", "text": "我觉得他很自私，他确实很自私，"}, {"type": "subtitle", "time": 8243.03, "timestamp": "02:17:23", "text": "粗鲁，还有"}, {"type": "subtitle", "time": 8245.91, "timestamp": "02:17:25", "text": "责任感……"}, {"type": "subtitle", "time": 8248.309, "timestamp": "02:17:28", "text": "哦，你说的责任感是什么意思？"}, {"type": "subtitle", "time": 8253.589, "timestamp": "02:17:33", "text": "你真的有这种感觉吗？"}, {"type": "subtitle", "time": 8254.549, "timestamp": "02:17:34", "text": "是的。"}, {"type": "subtitle", "time": 8260.309, "timestamp": "02:17:40", "text": "我知道。说真的，就像你加入"}, {"type": "subtitle", "time": 8264.469, "timestamp": "02:17:44", "text": "我的时候，你……用"}, {"type": "subtitle", "time": 8267.75, "timestamp": "02:17:47", "text": "一个词来形容？他更像是一个非常"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "专业的人。"}, {"type": "subtitle", "time": 8274.549, "timestamp": "02:17:54", "text": "是的。所以，"}, {"type": "subtitle", "time": 8276.389, "timestamp": "02:17:56", "text": "我第一次见到他的时候，他非常正式和专业。"}, {"type": "subtitle", "time": 8279.75, "timestamp": "02:17:59", "text": "是的。他非常正式。"}]
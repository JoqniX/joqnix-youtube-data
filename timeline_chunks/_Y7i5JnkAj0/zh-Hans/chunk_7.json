[{"type": "subtitle", "time": 422.23, "timestamp": "00:07:02", "text": "对感情有害。   是的"}, {"type": "subtitle", "time": 425.35, "timestamp": "00:07:05", "text": "。 我是一个有毒的人。"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "表达爱意。"}, {"type": "subtitle", "time": 428.629, "timestamp": "00:07:08", "text": "我是个人，兄弟。 我是个恶霸。 我是一个"}, {"type": "subtitle", "time": 431.749, "timestamp": "00:07:11", "text": "有毒的人。 你对我有什么期望？"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "不，我们依然爱你。 我们依然爱"}, {"type": "subtitle", "time": 433.589, "timestamp": "00:07:13", "text": "你。 是的。   是的"}, {"type": "subtitle", "time": 453.35, "timestamp": "00:07:33", "text": "我应该能看到你的直播。"}, {"type": "subtitle", "time": 456.87, "timestamp": "00:07:36", "text": "不，我在看直播呢，兄弟。 我可以"}, {"type": "subtitle", "time": 458.39, "timestamp": "00:07:38", "text": "播放直播。 等等，等等，等等，等等，"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "等等。 让我播放直播。"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "我的天啊。 别玩。"}, {"type": "subtitle", "time": 464.95, "timestamp": "00:07:44", "text": "让我在这里直播一下，兄弟。"}, {"type": "subtitle", "time": 467.909, "timestamp": "00:07:47", "text": "不，那样我就能看到了。 不。"}, {"type": "subtitle", "time": 471.51, "timestamp": "00:07:51", "text": "我的天哪。 听到自己的声音我会觉得很尴尬"}, {"type": "subtitle", "time": 474.71, "timestamp": "00:07:54", "text": "。 我最近一直"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "对自己感到尴尬。 等等，你"}]
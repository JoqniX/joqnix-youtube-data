[{"type": "subtitle", "time": 6481.669, "timestamp": "01:48:01", "text": "天哪。我的"}, {"type": "subtitle", "time": 6483.669, "timestamp": "01:48:03", "text": "老天爷。"}, {"type": "subtitle", "time": 6485.51, "timestamp": "01:48:05", "text": "我在聊天室里做过最奇怪的事是什么"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "你好。"}, {"type": "subtitle", "time": 6493.59, "timestamp": "01:48:13", "text": "等等，"}, {"type": "subtitle", "time": 6497.43, "timestamp": "01:48:17", "text": "提醒我给耳机充电，好吗？"}, {"type": "subtitle", "time": 6498.87, "timestamp": "01:48:18", "text": "我怎么提醒你给"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "耳机充电？"}, {"type": "subtitle", "time": 6504.629, "timestamp": "01:48:24", "text": "5分钟。好的。"}, {"type": "subtitle", "time": 6527.51, "timestamp": "01:48:47", "text": "呃，"}, {"type": "subtitle", "time": 6529.99, "timestamp": "01:48:49", "text": "我好像很沉默。我会躲在"}, {"type": "subtitle", "time": 6531.669, "timestamp": "01:48:51", "text": "角落里，"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "躲在墙后面。我会看着"}, {"type": "subtitle", "time": 6537.51, "timestamp": "01:48:57", "text": "别人说话，然后想，“哇，"}, {"type": "subtitle", "time": 6539.189, "timestamp": "01:48:59", "text": "这才是说话。”"}]
[{"type": "subtitle", "time": 14281.11, "timestamp": "03:58:01", "text": "说什么？我不能说什么？   是的"}, {"type": "subtitle", "time": 14283.91, "timestamp": "03:58:03", "text": "。 于是，我"}, {"type": "subtitle", "time": 14289.75, "timestamp": "03:58:09", "text": "在脑海中进行了长时间的思考。"}, {"type": "subtitle", "time": 14293.51, "timestamp": "03:58:13", "text": "我在这里想到什么就说什么，"}, {"type": "subtitle", "time": 14295.99, "timestamp": "03:58:15", "text": "但同时也尽量小心，"}, {"type": "subtitle", "time": 14299.99, "timestamp": "03:58:19", "text": "你知道，"}, {"type": "subtitle", "time": 14302.309, "timestamp": "03:58:22", "text": "我觉得我需要一个新词来形容"}, {"type": "subtitle", "time": 14304.07, "timestamp": "03:58:24", "text": "这个"}, {"type": "subtitle", "time": 14307.75, "timestamp": "03:58:27", "text": "术语，或者说，"}, {"type": "subtitle", "time": 14311.51, "timestamp": "03:58:31", "text": "比如"}, {"type": "subtitle", "time": 14314.229, "timestamp": "03:58:34", "text": "我想说“口无遮拦”，但我不"}, {"type": "subtitle", "time": 14316.07, "timestamp": "03:58:36", "text": "知道这是否是正确的术语，"}, {"type": "subtitle", "time": 14318.87, "timestamp": "03:58:38", "text": "所以，是的，我应该注意我的措辞"}, {"type": "subtitle", "time": 14320.79, "timestamp": "03:58:40", "text": "。"}, {"type": "chat", "time": 14321.299, "timestamp": "03:58:41", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "totally understandable as it cause chain responses"}, {"type": "subtitle", "time": 14322.87, "timestamp": "03:58:42", "text": "所以，对"}, {"type": "subtitle", "time": 14327.349, "timestamp": "03:58:47", "text": "，就是Dio那件事。 你明白我"}, {"type": "subtitle", "time": 14333.75, "timestamp": "03:58:53", "text": "是啊，"}, {"type": "subtitle", "time": 14337.349, "timestamp": "03:58:57", "text": "我觉得“嘘嘘”挺好的。"}]
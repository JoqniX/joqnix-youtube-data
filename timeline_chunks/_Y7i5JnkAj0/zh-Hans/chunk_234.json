[{"type": "subtitle", "time": 14042.71, "timestamp": "03:54:02", "text": "加工"}, {"type": "subtitle", "time": 14046.15, "timestamp": "03:54:06", "text": "再改进的原则，对吧？所以"}, {"type": "subtitle", "time": 14048.309, "timestamp": "03:54:08", "text": "即使质量不好"}, {"type": "subtitle", "time": 14052.79, "timestamp": "03:54:12", "text": "，我也会尽"}, {"type": "subtitle", "time": 14056.309, "timestamp": "03:54:16", "text": "我所能，先拍个vlog什么的，"}, {"type": "subtitle", "time": 14059.99, "timestamp": "03:54:19", "text": "视频肯定会很糟糕。"}, {"type": "subtitle", "time": 14061.91, "timestamp": "03:54:21", "text": "谁知道呢，"}, {"type": "subtitle", "time": 14064.63, "timestamp": "03:54:24", "text": "我拍这个那个"}, {"type": "subtitle", "time": 14067.189, "timestamp": "03:54:27", "text": "都会很糟糕。很烂。但没关系。随着"}, {"type": "subtitle", "time": 14069.269, "timestamp": "03:54:29", "text": "时间的推移，我会进步的。"}, {"type": "subtitle", "time": 14071.349, "timestamp": "03:54:31", "text": "总有一天，我也会像那些拥有专业"}, {"type": "chat", "time": 14071.821, "timestamp": "03:54:31", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 14074.55, "timestamp": "03:54:34", "text": "摄像机的人一样，比如"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "现在到处都是水，我可以有"}, {"type": "subtitle", "time": 14078.63, "timestamp": "03:54:38", "text": "自己的摄影师什么的，然后说："}, {"type": "subtitle", "time": 14081.59, "timestamp": "03:54:41", "text": "“嘿，切换到16角度。”"}, {"type": "subtitle", "time": 14086.07, "timestamp": "03:54:46", "text": "换成呃，换成呃，八八"}, {"type": "subtitle", "time": 14089.59, "timestamp": "03:54:49", "text": "呃，像偏光镜之类的。 我"}, {"type": "subtitle", "time": 14091.91, "timestamp": "03:54:51", "text": "不知道该切换到柔光模式之"}, {"type": "subtitle", "time": 14094.63, "timestamp": "03:54:54", "text": "类的。 我可以像以前那样"}, {"type": "subtitle", "time": 14097.91, "timestamp": "03:54:57", "text": "快速地观看节目。 我以前经常"}]
[{"type": "subtitle", "time": 15240.55, "timestamp": "04:14:00", "text": "我起床了。"}, {"type": "subtitle", "time": 15244.389, "timestamp": "04:14:04", "text": "今晚可以睡懒觉了。只剩下几天时间了"}, {"type": "subtitle", "time": 15250.389, "timestamp": "04:14:10", "text": "，对吧？和家人一起度过。所以，我要好好"}, {"type": "subtitle", "time": 15253.429, "timestamp": "04:14:13", "text": "享受…… 和家人在一起的时间。是"}, {"type": "subtitle", "time": 15255.349, "timestamp": "04:14:15", "text": "啊，不过和家人在一起的时间更重要"}, {"type": "subtitle", "time": 15259.67, "timestamp": "04:14:19", "text": "。和家人在一起的时间很重要。嗯，是"}, {"type": "subtitle", "time": 15263.11, "timestamp": "04:14:23", "text": "啊，我还没缓过神来。就像我"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "之前说的，"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "可能等我上了飞机，或者等我……等我……等我"}, {"type": "subtitle", "time": 15277.269, "timestamp": "04:14:37", "text": "和家人道别之后，"}, {"type": "subtitle", "time": 15284.229, "timestamp": "04:14:44", "text": "我才会真正意识到，是啊，是啊，"}, {"type": "subtitle", "time": 15287.99, "timestamp": "04:14:47", "text": "我真的要走了。"}, {"type": "subtitle", "time": 15293.83, "timestamp": "04:14:53", "text": "我再也见不到他们了，"}, {"type": "chat", "time": 15293.878, "timestamp": "04:14:53", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "again lots of love all the best and always one step at a time can dm anytime will try to get back asap if ya do relax enjoy ride and keep of moving forward"}, {"type": "subtitle", "time": 15297.67, "timestamp": "04:14:57", "text": "除非他们持访问签证来找"}]
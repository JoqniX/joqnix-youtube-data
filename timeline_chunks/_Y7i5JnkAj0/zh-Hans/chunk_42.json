[{"type": "subtitle", "time": 2527.99, "timestamp": "00:42:07", "text": "我不认识你，侯赛因。"}, {"type": "subtitle", "time": 2530.95, "timestamp": "00:42:10", "text": "兄弟，我几乎可以肯定他是个"}, {"type": "subtitle", "time": 2534.55, "timestamp": "00:42:14", "text": "令人讨厌的人。 兄弟，"}, {"type": "subtitle", "time": 2535.829, "timestamp": "00:42:15", "text": "我跟他联系不多。"}, {"type": "subtitle", "time": 2539.589, "timestamp": "00:42:19", "text": "现在应该可以了。 对不起。"}, {"type": "chat", "time": 2541.48, "timestamp": "00:42:21", "author": "@scgamer6506", "avatar": "https://yt4.ggpht.com/GYw7u18LDWoYezLh9AAHUSG5EttEKzEs94hPYZVIlREDitRaPYBWqhoExLCtx6vYjXeVxKmaCQ=s64-c-k-c0x00ffffff-no-rj", "message": "here we go"}, {"type": "subtitle", "time": 2542.95, "timestamp": "00:42:22", "text": "查德，我讨厌VR里的印度人。 显然，"}, {"type": "chat", "time": 2544.127, "timestamp": "00:42:24", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! scgamer6506~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2545.19, "timestamp": "00:42:25", "text": "他们说话并不客气。"}, {"type": "subtitle", "time": 2547.03, "timestamp": "00:42:27", "text": "哇。"}, {"type": "subtitle", "time": 2554.63, "timestamp": "00:42:34", "text": "不，相信我，兄弟。 你知道"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "印度人在这里的问题是什么吗？ 他们"}, {"type": "subtitle", "time": 2558.79, "timestamp": "00:42:38", "text": "会尝试的。"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "我受够了你总是躲着我，不让我"}, {"type": "subtitle", "time": 2562.23, "timestamp": "00:42:42", "text": "看到你。"}, {"type": "subtitle", "time": 2564.71, "timestamp": "00:42:44", "text": "你知道他们是做什么的吗？ 他们"}, {"type": "subtitle", "time": 2567.109, "timestamp": "00:42:47", "text": "装酷，然后贬低其他"}, {"type": "subtitle", "time": 2568.71, "timestamp": "00:42:48", "text": "印度人，只是为了"}, {"type": "subtitle", "time": 2570.63, "timestamp": "00:42:50", "text": "博得某个外国女孩的欢心。 我心想，"}, {"type": "subtitle", "time": 2573.27, "timestamp": "00:42:53", "text": "兄弟，你真是绝望到家了。"}, {"type": "subtitle", "time": 2575.349, "timestamp": "00:42:55", "text": "住口。"}, {"type": "subtitle", "time": 2578.23, "timestamp": "00:42:58", "text": "好的。   是的"}]
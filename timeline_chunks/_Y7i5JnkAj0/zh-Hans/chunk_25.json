[{"type": "subtitle", "time": 1502.149, "timestamp": "00:25:02", "text": "它是否可以交互？ 我不"}, {"type": "subtitle", "time": 1503.19, "timestamp": "00:25:03", "text": "知道。"}, {"type": "subtitle", "time": 1514.149, "timestamp": "00:25:14", "text": "呃，不是“走”。 哦，等等。 我得走了。"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "那是我拥有的最具互动性的东西，"}, {"type": "subtitle", "time": 1526.95, "timestamp": "00:25:26", "text": "甚至我的领带也不会进行互动，"}, {"type": "subtitle", "time": 1529.19, "timestamp": "00:25:29", "text": "通常它们会进行互动"}, {"type": "subtitle", "time": 1535.35, "timestamp": "00:25:35", "text": "阿斯特拉，"}, {"type": "subtitle", "time": 1544.47, "timestamp": "00:25:44", "text": "这位阿斯特拉女王，你是怎么找到这件"}, {"type": "subtitle", "time": 1547.83, "timestamp": "00:25:47", "text": "夹克的？好的，这太好了。 他"}, {"type": "subtitle", "time": 1550.549, "timestamp": "00:25:50", "text": "穿衣打扮看起来好酷。"}, {"type": "subtitle", "time": 1557.11, "timestamp": "00:25:57", "text": "好的。"}]
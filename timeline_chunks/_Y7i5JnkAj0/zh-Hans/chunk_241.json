[{"type": "subtitle", "time": 14461.51, "timestamp": "04:01:01", "text": "我安顿下来"}, {"type": "subtitle", "time": 14464.79, "timestamp": "04:01:04", "text": "，拿到笔记本电脑和其他所有东西，连上"}, {"type": "subtitle", "time": 14468.309, "timestamp": "04:01:08", "text": "网络等等之后，我会从日本进行直播。我只"}, {"type": "subtitle", "time": 14471.429, "timestamp": "04:01:11", "text": "直播一次。 看看情况如何。 或许"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "不是。 我可能不会直播。 谁知道呢？"}, {"type": "subtitle", "time": 14478.55, "timestamp": "04:01:18", "text": "也许我会偶尔直播一下，"}, {"type": "subtitle", "time": 14482.469, "timestamp": "04:01:22", "text": "因为我现在必须理清我的优先事项"}, {"type": "subtitle", "time": 14484.95, "timestamp": "04:01:24", "text": "。 正如我所说，我得"}, {"type": "subtitle", "time": 14490.87, "timestamp": "04:01:30", "text": "专注于我能掌控的事情。"}, {"type": "subtitle", "time": 14494.309, "timestamp": "04:01:34", "text": "我说：“不，我浪费了很多时间"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "直播。我不想"}, {"type": "subtitle", "time": 14499.51, "timestamp": "04:01:39", "text": "再犯同样的错误了。"}, {"type": "subtitle", "time": 14503.429, "timestamp": "04:01:43", "text": "即使我在国外，"}, {"type": "subtitle", "time": 14506.07, "timestamp": "04:01:46", "text": "以后也会做视频。我想尝试"}, {"type": "subtitle", "time": 14509.429, "timestamp": "04:01:49", "text": "更多视频形式。不过，"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "直播我以后可能会试试。"}, {"type": "subtitle", "time": 14515.429, "timestamp": "04:01:55", "text": "谁知道呢？"}, {"type": "subtitle", "time": 14516.71, "timestamp": "04:01:56", "text": "会有春节"}]
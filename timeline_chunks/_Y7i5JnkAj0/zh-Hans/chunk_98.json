[{"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "呃，非常抱歉。非常抱歉。"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "我做了件很蠢的事。"}, {"type": "subtitle", "time": 5896.709, "timestamp": "01:38:16", "text": "什么？不，我是观众。我没有玩游戏。"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "房间着火了。你只能说"}, {"type": "subtitle", "time": 5918.149, "timestamp": "01:38:38", "text": "这里有人。不，我没有玩"}, {"type": "subtitle", "time": 5931.75, "timestamp": "01:38:51", "text": "不，我会"}, {"type": "subtitle", "time": 5934.149, "timestamp": "01:38:54", "text": "救我自己。我很自私。"}]
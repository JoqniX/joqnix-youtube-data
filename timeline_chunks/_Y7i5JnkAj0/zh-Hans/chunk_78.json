[{"type": "subtitle", "time": 4683.51, "timestamp": "01:18:03", "text": "现在我知道乔会跟我多说些什么了，"}, {"type": "subtitle", "time": 4685.59, "timestamp": "01:18:05", "text": "这就是"}, {"type": "subtitle", "time": 4687.35, "timestamp": "01:18:07", "text": "嫉妒的人的样子。"}, {"type": "subtitle", "time": 4689.27, "timestamp": "01:18:09", "text": "我不嫉妒。我就想，“哦，好吧。”"}, {"type": "subtitle", "time": 4691.59, "timestamp": "01:18:11", "text": "好的。"}, {"type": "subtitle", "time": 4693.669, "timestamp": "01:18:13", "text": "懂得很多。"}, {"type": "subtitle", "time": 4698.07, "timestamp": "01:18:18", "text": "我以后会逗你玩的。” 好的。"}, {"type": "subtitle", "time": 4700.709, "timestamp": "01:18:20", "text": "哦，你不能那样做。你没有"}, {"type": "subtitle", "time": 4703.83, "timestamp": "01:18:23", "text": "我知道。"}, {"type": "subtitle", "time": 4707.59, "timestamp": "01:18:27", "text": "选择一个人，唱一首"}, {"type": "subtitle", "time": 4711.83, "timestamp": "01:18:31", "text": "是什么？"}, {"type": "subtitle", "time": 4714.07, "timestamp": "01:18:34", "text": "嗯，我不知道。再点"}, {"type": "subtitle", "time": 4721.91, "timestamp": "01:18:41", "text": "开玩笑。"}, {"type": "subtitle", "time": 4723.91, "timestamp": "01:18:43", "text": "呃，我感觉很不舒服。我不确定我能不能"}, {"type": "subtitle", "time": 4726.709, "timestamp": "01:18:46", "text": "开玩笑。我能不能参加。等等，让我"}, {"type": "subtitle", "time": 4729.03, "timestamp": "01:18:49", "text": "试试。"}, {"type": "subtitle", "time": 4731.59, "timestamp": "01:18:51", "text": "她也"}, {"type": "subtitle", "time": 4739.35, "timestamp": "01:18:59", "text": "sen"}]
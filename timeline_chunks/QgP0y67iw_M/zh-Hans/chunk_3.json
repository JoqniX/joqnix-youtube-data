[{"type": "subtitle", "time": 187.11, "timestamp": "00:03:07", "text": "你们最近怎么样？ 大家最近怎么样"}, {"type": "subtitle", "time": 190.55, "timestamp": "00:03:10", "text": "？ 所以，今天我们要挑战"}, {"type": "subtitle", "time": 193.35, "timestamp": "00:03:13", "text": "夜之深渊。 我今天直播的时间比平时"}, {"type": "subtitle", "time": 202.47, "timestamp": "00:03:22", "text": "我今天比平时提前一点开始直播"}, {"type": "subtitle", "time": 206.47, "timestamp": "00:03:26", "text": "。 就是这样。"}, {"type": "subtitle", "time": 209.43, "timestamp": "00:03:29", "text": "嗯，"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "我找不到。 诡异的。 真奇怪。 我"}, {"type": "subtitle", "time": 215.43, "timestamp": "00:03:35", "text": "找不到。"}, {"type": "subtitle", "time": 217.67000000000002, "timestamp": "00:03:37", "text": "我查了一下。"}, {"type": "subtitle", "time": 221.91, "timestamp": "00:03:41", "text": "让我看看我的另一个账户。"}, {"type": "subtitle", "time": 225.75, "timestamp": "00:03:45", "text": "嗯？  OBS 的"}, {"type": "subtitle", "time": 229.91, "timestamp": "00:03:49", "text": "音量调节功能到底在哪儿？ 啊，明白了。 知道了。"}, {"type": "subtitle", "time": 232.07, "timestamp": "00:03:52", "text": "我把它抄下来，放在浴室里某个"}, {"type": "subtitle", "time": 236.07, "timestamp": "00:03:56", "text": "地方，这样我就能记住了。"}, {"type": "subtitle", "time": 238.309, "timestamp": "00:03:58", "text": "呃，"}]
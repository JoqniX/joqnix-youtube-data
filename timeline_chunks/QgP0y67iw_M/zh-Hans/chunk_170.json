[{"type": "subtitle", "time": 10203.67, "timestamp": "02:50:03", "text": "你好。 尽情享受水带来的乐趣。 我去吃"}, {"type": "subtitle", "time": 10205.349, "timestamp": "02:50:05", "text": "晚饭，一会儿就回来"}, {"type": "subtitle", "time": 10209.99, "timestamp": "02:50:09", "text": "。"}, {"type": "subtitle", "time": 10219.418, "timestamp": "02:50:19", "text": "如果我看到有女孩在和别人说话，我会回来的。 我的天啊。"}, {"type": "subtitle", "time": 10221.269, "timestamp": "02:50:21", "text": "[笑声]"}, {"type": "subtitle", "time": 10225.968, "timestamp": "02:50:25", "text": "嗨。 我的天啊。 我这么让人困惑吗？"}, {"type": "subtitle", "time": 10227.19, "timestamp": "02:50:27", "text": "[笑声]"}, {"type": "subtitle", "time": 10229.03, "timestamp": "02:50:29", "text": "好的。"}, {"type": "subtitle", "time": 10235.75, "timestamp": "02:50:35", "text": "晚餐。"}, {"type": "chat", "time": 10240.322, "timestamp": "02:50:40", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "not for me"}, {"type": "subtitle", "time": 10244.389, "timestamp": "02:50:44", "text": "呃，稍等一下。"}, {"type": "chat", "time": 10248.275, "timestamp": "02:50:48", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "I know you are boy"}, {"type": "subtitle", "time": 10254.309, "timestamp": "02:50:54", "text": "哦，你先好好享受这段时光，等我吃完饭回来再说"}]
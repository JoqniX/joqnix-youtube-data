[{"type": "subtitle", "time": 10801.11, "timestamp": "03:00:01", "text": "好的。 你好。 所以，我们会为此进行一些"}, {"type": "subtitle", "time": 10805.75, "timestamp": "03:00:05", "text": "测试。 我已经收集了 40 个，"}, {"type": "subtitle", "time": 10808.87, "timestamp": "03:00:08", "text": "30 个就够了。 下面那些"}, {"type": "subtitle", "time": 10811.59, "timestamp": "03:00:11", "text": "我稍后再做。"}, {"type": "subtitle", "time": 10823.269, "timestamp": "03:00:23", "text": "为什么我还没死？ 为什么？ 我的"}, {"type": "subtitle", "time": 10826.15, "timestamp": "03:00:26", "text": "天哪。 怎么了？"}, {"type": "subtitle", "time": 10828.79, "timestamp": "03:00:28", "text": "这个女人几个小时以来一直想杀了我"}, {"type": "subtitle", "time": 10831.349, "timestamp": "03:00:31", "text": "。 都两分钟了，"}, {"type": "subtitle", "time": 10841.19, "timestamp": "03:00:41", "text": "捕食者，请杀了我。 不，"}, {"type": "subtitle", "time": 10843.269, "timestamp": "03:00:43", "text": "这只是绝望而已。 我觉得"}, {"type": "subtitle", "time": 10845.59, "timestamp": "03:00:45", "text": "这并不是游戏在暗示什么"}, {"type": "subtitle", "time": 10850.309, "timestamp": "03:00:50", "text": "，而是感觉好像游戏在阻止"}, {"type": "subtitle", "time": 10852.71, "timestamp": "03:00:52", "text": "我杀人"}, {"type": "subtitle", "time": 10854.71, "timestamp": "03:00:54", "text": "。"}]
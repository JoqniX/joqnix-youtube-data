[{"type": "subtitle", "time": 26187.91, "timestamp": "07:16:27", "text": "我的天啊。 是该死的，是该死的，是该死的，"}, {"type": "subtitle", "time": 26190.708, "timestamp": "07:16:30", "text": "是那个律师房客。"}, {"type": "subtitle", "time": 26194.628, "timestamp": "07:16:34", "text": "我的天啊。 兄弟，我吓坏了。"}, {"type": "subtitle", "time": 26198.948, "timestamp": "07:16:38", "text": "我当时想，“怎么会进来？"}, {"type": "subtitle", "time": 26201.83, "timestamp": "07:16:41", "text": "我的天哪，我吓了一跳。"}]
[{"type": "subtitle", "time": 20348.47, "timestamp": "05:39:08", "text": "不，不，不，不。 跑，跑，跑，跑。"}, {"type": "subtitle", "time": 20350.948, "timestamp": "05:39:10", "text": "愚蠢，愚蠢。"}, {"type": "subtitle", "time": 20352.39, "timestamp": "05:39:12", "text": "拜托，这是我最后一次了。 请，请"}, {"type": "subtitle", "time": 20353.35, "timestamp": "05:39:13", "text": "，请，"}, {"type": "subtitle", "time": 20356.07, "timestamp": "05:39:16", "text": "请，请，请。"}, {"type": "subtitle", "time": 20358.23, "timestamp": "05:39:18", "text": "快点。 快点。 快点。 我得"}, {"type": "subtitle", "time": 20360.788, "timestamp": "05:39:20", "text": "提升角色等级了。 下次"}, {"type": "subtitle", "time": 20362.868, "timestamp": "05:39:22", "text": "我会小心的。 我会小心的。 我，"}, {"type": "subtitle", "time": 20374.15, "timestamp": "05:39:34", "text": "哦，我的天哪。 不，"}, {"type": "subtitle", "time": 20378.708, "timestamp": "05:39:38", "text": "别让她把我撞到墙上。"}, {"type": "subtitle", "time": 20393.03, "timestamp": "05:39:53", "text": "最终的。"}]
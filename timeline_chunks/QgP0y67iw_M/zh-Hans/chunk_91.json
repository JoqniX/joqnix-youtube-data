[{"type": "subtitle", "time": 5464.47, "timestamp": "01:31:04", "text": "啊，它显示为未定义。 不明确的。 哦，"}, {"type": "subtitle", "time": 5473.11, "timestamp": "01:31:13", "text": "嗯，我明天会做。"}, {"type": "subtitle", "time": 5475.669, "timestamp": "01:31:15", "text": "可能是延误的原因。"}, {"type": "subtitle", "time": 5477.669, "timestamp": "01:31:17", "text": "我需要增加一些延迟才能让它"}, {"type": "subtitle", "time": 5483.189, "timestamp": "01:31:23", "text": "好了，我刚才说到哪儿了？ 我们换张"}, {"type": "subtitle", "time": 5487.27, "timestamp": "01:31:27", "text": "地图看看。 冰。 所以我们完成了"}, {"type": "subtitle", "time": 5490.629, "timestamp": "01:31:30", "text": "Galvanet、Gala 和 Lansa。 所以"}, {"type": "subtitle", "time": 5493.83, "timestamp": "01:31:33", "text": "这次我们打算在冰湖上缝纫。"}, {"type": "subtitle", "time": 5498.31, "timestamp": "01:31:38", "text": "等等，我昨天已经完成缝纫了。"}, {"type": "subtitle", "time": 5500.07, "timestamp": "01:31:40", "text": "所以"}, {"type": "subtitle", "time": 5508.709, "timestamp": "01:31:48", "text": "好的。"}, {"type": "subtitle", "time": 5510.709, "timestamp": "01:31:50", "text": "哦，是的。 我不知道你当时是否在场。"}, {"type": "subtitle", "time": 5512.629, "timestamp": "01:31:52", "text": "等等，"}, {"type": "subtitle", "time": 5515.11, "timestamp": "01:31:55", "text": "你们什么时候又来袭击我了？ 那天是星期几"}, {"type": "subtitle", "time": 5517.51, "timestamp": "01:31:57", "text": "？ 我忘了。"}]
[{"type": "subtitle", "time": 12122.469, "timestamp": "03:22:02", "text": "这些就像是"}, {"type": "subtitle", "time": 12126.79, "timestamp": "03:22:06", "text": "你可以装在角色武器和"}, {"type": "subtitle", "time": 12130.95, "timestamp": "03:22:10", "text": "角色特殊武器上的MOD。 所以你要一遍又一遍地运行"}, {"type": "subtitle", "time": 12133.19, "timestamp": "03:22:13", "text": "这些，直到获得这些"}, {"type": "subtitle", "time": 12137.03, "timestamp": "03:22:17", "text": "可能的奖励，对吧？没有扭蛋，"}, {"type": "subtitle", "time": 12140.309, "timestamp": "03:22:20", "text": "因为你必须肝，而不是"}, {"type": "subtitle", "time": 12141.99, "timestamp": "03:22:21", "text": "扭蛋。他们有一种"}, {"type": "subtitle", "time": 12145.03, "timestamp": "03:22:25", "text": "叫做合作佣金的东西，所以我"}, {"type": "subtitle", "time": 12148.87, "timestamp": "03:22:28", "text": "必须得到这个东西，这个秘密字母"}, {"type": "subtitle", "time": 12151.67, "timestamp": "03:22:31", "text": "方块，你可以通过玩游戏获得它，"}, {"type": "subtitle", "time": 12154.71, "timestamp": "03:22:34", "text": "比如完成最终任务或者"}, {"type": "subtitle", "time": 12159.03, "timestamp": "03:22:39", "text": "参加活动等等。 所以你做这个农场，就是"}, {"type": "subtitle", "time": 12162.389, "timestamp": "03:22:42", "text": "购买角色和"}, {"type": "subtitle", "time": 12165.269, "timestamp": "03:22:45", "text": "角色的秘密信件。 所以这其中存在一定的"}, {"type": "subtitle", "time": 12167.67, "timestamp": "03:22:47", "text": "概率。"}, {"type": "subtitle", "time": 12170.71, "timestamp": "03:22:50", "text": "所以你会得到三个等级，第三级和"}, {"type": "subtitle", "time": 12174.389, "timestamp": "03:22:54", "text": "普通一级一样。 二级会员可以获得两次"}, {"type": "subtitle", "time": 12178.309, "timestamp": "03:22:58", "text": "射击机会，一级会员可以获得十次"}]
[{"type": "subtitle", "time": 17342.868, "timestamp": "04:49:02", "text": "上帝。 起义的伊娃。"}, {"type": "subtitle", "time": 17350.15, "timestamp": "04:49:10", "text": "这是什么？"}, {"type": "subtitle", "time": 17363.99, "timestamp": "04:49:23", "text": "我进了豪宅，然后左右移动"}, {"type": "subtitle", "time": 17365.55, "timestamp": "04:49:25", "text": "。"}, {"type": "subtitle", "time": 17376.628, "timestamp": "04:49:36", "text": "这里。"}, {"type": "subtitle", "time": 17378.788, "timestamp": "04:49:38", "text": "不。等等，等等，等等，等等。 楼梯在"}, {"type": "subtitle", "time": 17381.11, "timestamp": "04:49:41", "text": "这里。 这里。 它应该在"}, {"type": "subtitle", "time": 17385.856, "timestamp": "04:49:45", "text": "这里，但我认为我已经把它取走了。"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "[叹气]"}, {"type": "subtitle", "time": 17389.43, "timestamp": "04:49:49", "text": "那是不是意味着我已经收集齐了"}, {"type": "subtitle", "time": 17393.19, "timestamp": "04:49:53", "text": "游戏里的大部分东西？"}]
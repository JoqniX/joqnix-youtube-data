[{"type": "subtitle", "time": 8411.27, "timestamp": "02:20:11", "text": "哦，我看到了。"}, {"type": "subtitle", "time": 8413.75, "timestamp": "02:20:13", "text": "萨西巴卡也藏在"}, {"type": "subtitle", "time": 8416.71, "timestamp": "02:20:16", "text": "冰柱里。"}, {"type": "subtitle", "time": 8419.11, "timestamp": "02:20:19", "text": "所以，它应该在下面。"}, {"type": "subtitle", "time": 8427.59, "timestamp": "02:20:27", "text": "我想我的确收集到了。 这里没有。"}, {"type": "subtitle", "time": 8440.95, "timestamp": "02:20:40", "text": "好的。"}, {"type": "subtitle", "time": 8443.75, "timestamp": "02:20:43", "text": "靠近钓鱼点。"}]
[{"type": "subtitle", "time": 23225.11, "timestamp": "06:27:05", "text": "哇。 昨晚真是个好夜晚。"}, {"type": "subtitle", "time": 23229.19, "timestamp": "06:27:09", "text": "晚安模式的刷新率太疯狂了。"}, {"type": "subtitle", "time": 23232.788, "timestamp": "06:27:12", "text": "我给他吃了更好的食物，希望能"}, {"type": "subtitle", "time": 23275.27, "timestamp": "06:27:55", "text": "我不走运”会怎么样？"}, {"type": "subtitle", "time": 23278.708, "timestamp": "06:27:58", "text": "给我一个方方正正的，伙计。 请给我一个方形的"}]
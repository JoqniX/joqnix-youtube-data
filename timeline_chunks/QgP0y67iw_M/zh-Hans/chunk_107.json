[{"type": "subtitle", "time": 6421.75, "timestamp": "01:47:01", "text": "这就是为什么我必须单独进行操作的原因。"}, {"type": "subtitle", "time": 6427.43, "timestamp": "01:47:07", "text": "听起来很复杂。 是的。  [笑声] 是的"}, {"type": "subtitle", "time": 6439.189, "timestamp": "01:47:19", "text": "我"}, {"type": "subtitle", "time": 6442.55, "timestamp": "01:47:22", "text": "不太常用显而易见的东西。"}, {"type": "subtitle", "time": 6444.87, "timestamp": "01:47:24", "text": "我玩一些对GPU要求很高的游戏时会离开"}, {"type": "subtitle", "time": 6447.03, "timestamp": "01:47:27", "text": "，我用的就是这种显而易见的方式"}, {"type": "subtitle", "time": 6448.87, "timestamp": "01:47:28", "text": "。   就是"}, {"type": "subtitle", "time": 6454.709, "timestamp": "01:47:34", "text": "[叹气]"}, {"type": "subtitle", "time": 6457.189, "timestamp": "01:47:37", "text": "单台电脑配置太麻烦了。 我不知道"}, {"type": "subtitle", "time": 6459.83, "timestamp": "01:47:39", "text": "人们是如何生存下来的。 不，我现在"}, {"type": "subtitle", "time": 6462.55, "timestamp": "01:47:42", "text": "明白这有多"}, {"type": "subtitle", "time": 6464.87, "timestamp": "01:47:44", "text": "难了。"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "那时候我不用担心。 不，"}, {"type": "subtitle", "time": 6469.669, "timestamp": "01:47:49", "text": "它就像采集卡一样，对吧？ 所以我干脆把"}, {"type": "subtitle", "time": 6472.149, "timestamp": "01:47:52", "text": "整个屏幕都显示出来。"}, {"type": "subtitle", "time": 6474.629, "timestamp": "01:47:54", "text": "它将类似于显示源。 一台电脑"}, {"type": "subtitle", "time": 6477.43, "timestamp": "01:47:57", "text": "将负责流媒体播放。"}]
[{"type": "subtitle", "time": 10624.212, "timestamp": "02:57:04", "text": "Farlight 84。"}, {"type": "subtitle", "time": 10624.95, "timestamp": "02:57:04", "text": "[笑声]"}, {"type": "subtitle", "time": 10628.63, "timestamp": "02:57:08", "text": "我想在重置之前刷这个东西"}, {"type": "subtitle", "time": 10630.23, "timestamp": "02:57:10", "text": "。"}, {"type": "subtitle", "time": 10637.99, "timestamp": "02:57:17", "text": "我得怪达尔文。 你让我很想"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "打开 Far Light.io。 像往常一样，我现在应该会一直"}, {"type": "subtitle", "time": 10643.99, "timestamp": "02:57:23", "text": "开着蓝色协议在"}, {"type": "subtitle", "time": 10647.51, "timestamp": "02:57:27", "text": "后台运行，或者挂机刷怪，"}, {"type": "subtitle", "time": 10653.67, "timestamp": "02:57:33", "text": "[倒吸一口凉气]"}, {"type": "subtitle", "time": 10656.469, "timestamp": "02:57:36", "text": "哦，你不能在地图外死亡。"}, {"type": "subtitle", "time": 10661.429, "timestamp": "02:57:41", "text": "你被喷气背包带着到处飞。 我的天啊，"}, {"type": "subtitle", "time": 10673.11, "timestamp": "02:57:53", "text": "等等，我能做什么？ 等等，我想我可以"}, {"type": "subtitle", "time": 10675.349, "timestamp": "02:57:55", "text": "展示一下，对吧？"}, {"type": "subtitle", "time": 10678.469, "timestamp": "02:57:58", "text": "你想看吗？"}]
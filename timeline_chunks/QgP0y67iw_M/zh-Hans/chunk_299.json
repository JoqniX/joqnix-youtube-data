[{"type": "subtitle", "time": 17944.39, "timestamp": "04:59:04", "text": "现在你不会忘记人们了。 不用"}, {"type": "subtitle", "time": 17951.67, "timestamp": "04:59:11", "text": "对不起，艾尔莎。"}, {"type": "subtitle", "time": 17987.83, "timestamp": "04:59:47", "text": "她把这个零钱包放在你怀里，"}, {"type": "subtitle", "time": 17990.47, "timestamp": "04:59:50", "text": "然后像着了魔似的走开了。 泪水"}, {"type": "subtitle", "time": 17992.868, "timestamp": "04:59:52", "text": "和微笑在她闪烁的眼眸中交织，"}, {"type": "subtitle", "time": 17998.948, "timestamp": "04:59:58", "text": "最终变得温柔起来。 喉咙必须平整。 时间"}]
[{"type": "subtitle", "time": 4923.59, "timestamp": "01:22:03", "text": "德文，你想叫我丹，还是想让我"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "好了，现在是中午12点。 我们去这里"}, {"type": "subtitle", "time": 4938.709, "timestamp": "01:22:18", "text": "看看有没有泽尼蒙出现。"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "所以我现在在哪张地图上？ 呃，L 晚会。"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "等等，我是在参加晚宴，对吧？"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "我在洛纳。 好的，我们"}, {"type": "subtitle", "time": 4952.79, "timestamp": "01:22:32", "text": "今天会把这里彻底搜一遍，看看有没有"}, {"type": "subtitle", "time": 4955.27, "timestamp": "01:22:35", "text": "什么"}, {"type": "subtitle", "time": 4971.59, "timestamp": "01:22:51", "text": "隐藏这个和这个类别。"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "好了，我们到了。"}]
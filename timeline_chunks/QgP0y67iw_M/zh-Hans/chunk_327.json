[{"type": "subtitle", "time": 19624.07, "timestamp": "05:27:04", "text": "他只是"}, {"type": "subtitle", "time": 19652.39, "timestamp": "05:27:32", "text": "好的。 呃，附近有几个敌人，呃，"}, {"type": "subtitle", "time": 19655.35, "timestamp": "05:27:35", "text": "造成的伤害更高，不，不。 如果"}, {"type": "subtitle", "time": 19657.27, "timestamp": "05:27:37", "text": "800 万范围内的敌人较少，则造成的"}, {"type": "subtitle", "time": 19660.628, "timestamp": "05:27:40", "text": "伤害会更高，最高可达 60%。"}, {"type": "subtitle", "time": 19668.07, "timestamp": "05:27:48", "text": "如果伤害生效，目标的生命值"}, {"type": "subtitle", "time": 19670.15, "timestamp": "05:27:50", "text": "只能触发一次，然后对同一"}, {"type": "subtitle", "time": 19675.11, "timestamp": "05:27:55", "text": "一层物品的伤害提升效果。"}]
[{"type": "subtitle", "time": 4021.99, "timestamp": "01:07:01", "text": "浦那动漫展吧。 所以有些人"}, {"type": "subtitle", "time": 4024.95, "timestamp": "01:07:04", "text": "说他们的 YouTuber 朋友看到了我的"}, {"type": "subtitle", "time": 4026.23, "timestamp": "01:07:06", "text": "脸之类的东西。 我不知道他们有没有"}, {"type": "subtitle", "time": 4029.91, "timestamp": "01:07:09", "text": "舔过什么的，但确实，事情发生的时候，"}, {"type": "subtitle", "time": 4034.47, "timestamp": "01:07:14", "text": "我看到有些人"}, {"type": "subtitle", "time": 4036.63, "timestamp": "01:07:16", "text": "评论"}, {"type": "subtitle", "time": 4039.99, "timestamp": "01:07:19", "text": "我的外貌之类的"}, {"type": "subtitle", "time": 4052.39, "timestamp": "01:07:32", "text": "但是，我不会"}, {"type": "subtitle", "time": 4055.75, "timestamp": "01:07:35", "text": "露脸，也不会透露这个。 我现在是一名"}, {"type": "subtitle", "time": 4057.43, "timestamp": "01:07:37", "text": "YouTuber。"}, {"type": "subtitle", "time": 4060.549, "timestamp": "01:07:40", "text": "我遵循的是传统的 YouTube 制作方式，所以我不想那样"}, {"type": "subtitle", "time": 4063.109, "timestamp": "01:07:43", "text": "做。"}]
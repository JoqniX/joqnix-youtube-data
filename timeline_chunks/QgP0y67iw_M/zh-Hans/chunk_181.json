[{"type": "subtitle", "time": 10860.63, "timestamp": "03:01:00", "text": "你们那边卡住了，对吧？"}, {"type": "subtitle", "time": 10862.71, "timestamp": "03:01:02", "text": "你们那边整个屏幕都卡住了，"}, {"type": "subtitle", "time": 10865.349, "timestamp": "03:01:05", "text": "对吧？ 有时候我的声音会有点"}, {"type": "subtitle", "time": 10868.71, "timestamp": "03:01:08", "text": "沙哑，对吧？ 圣。"}, {"type": "subtitle", "time": 10871.75, "timestamp": "03:01:11", "text": "我觉得《远航84》不太适合"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "我边玩其他游戏边做其他事。"}, {"type": "subtitle", "time": 10900.55, "timestamp": "03:01:40", "text": "啊，卡得厉害。 我觉得"}, {"type": "subtitle", "time": 10902.55, "timestamp": "03:01:42", "text": "我不应该冒险。 我觉得我"}, {"type": "subtitle", "time": 10904.63, "timestamp": "03:01:44", "text": "不应该冒险。"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "你知道吗？ 我先退出一下，因为"}, {"type": "subtitle", "time": 10910.23, "timestamp": "03:01:50", "text": "背景光线比较暗。 我现在不这么认为"}, {"type": "subtitle", "time": 10911.99, "timestamp": "03:01:51", "text": "。"}, {"type": "subtitle", "time": 10915.349, "timestamp": "03:01:55", "text": "我感觉自己被切断了联系。"}, {"type": "subtitle", "time": 10919.19, "timestamp": "03:01:59", "text": "我的天啊。 我们稍后再做。   是的"}]
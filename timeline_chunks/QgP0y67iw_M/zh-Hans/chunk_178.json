[{"type": "subtitle", "time": 10682.389, "timestamp": "02:58:02", "text": "我在另一个游戏中。"}, {"type": "subtitle", "time": 10684.87, "timestamp": "02:58:04", "text": "等等，为什么这里没有显示？ 哦，"}, {"type": "subtitle", "time": 10687.51, "timestamp": "02:58:07", "text": "光。 好的，我到了。 好吧，我想"}, {"type": "subtitle", "time": 10691.11, "timestamp": "02:58:11", "text": "死。 让我找到手榴弹然后"}, {"type": "subtitle", "time": 10694.953, "timestamp": "02:58:14", "text": "去死吧。 我需要三根火柴才能点燃那个盒子。"}, {"type": "subtitle", "time": 10702.07, "timestamp": "02:58:22", "text": "我当时完全可以直接喷火啊。"}, {"type": "subtitle", "time": 10706.63, "timestamp": "02:58:26", "text": "但我仍然需要完成恶魔的任务"}, {"type": "subtitle", "time": 10709.99, "timestamp": "02:58:29", "text": "。 我的天啊，我这边的游戏卡顿得厉害"}, {"type": "subtitle", "time": 10715.51, "timestamp": "02:58:35", "text": "。 我看到那个东西卡顿得"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "厉害。 好了，我找到这个"}, {"type": "subtitle", "time": 10720.63, "timestamp": "02:58:40", "text": "人了。 我能行。如果是机器人，请"}, {"type": "subtitle", "time": 10724.71, "timestamp": "02:58:44", "text": "杀了我。 嘿，杀了我吧，"}, {"type": "subtitle", "time": 10727.51, "timestamp": "02:58:47", "text": "求你了。 是啊，杀了我吧。 是的。 你"}, {"type": "subtitle", "time": 10731.269, "timestamp": "02:58:51", "text": "枪法很差。 你枪法很差。 哦，"}, {"type": "subtitle", "time": 10737.349, "timestamp": "02:58:57", "text": "孩子，你为什么射击这么差？   是的"}]
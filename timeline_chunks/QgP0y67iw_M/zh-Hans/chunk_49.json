[{"type": "subtitle", "time": 2953.19, "timestamp": "00:49:13", "text": "我的注意力都集中在这件事上。"}, {"type": "subtitle", "time": 2963.75, "timestamp": "00:49:23", "text": "好的。"}, {"type": "subtitle", "time": 2968.309, "timestamp": "00:49:28", "text": "我同时从两边死了。 好的。"}, {"type": "subtitle", "time": 2970.15, "timestamp": "00:49:30", "text": "好的。 我觉得这些钱应该够了"}, {"type": "subtitle", "time": 2972.39, "timestamp": "00:49:32", "text": "。 让我们看看我们能用手头现有的这些东西做些什么"}, {"type": "subtitle", "time": 2974.309, "timestamp": "00:49:34", "text": "。"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "虽然我应该优先考虑挖矿来赚更多"}, {"type": "subtitle", "time": 2983.99, "timestamp": "00:49:43", "text": "钱，但我还是想做个农场倒卖者，不过"}, {"type": "subtitle", "time": 2985.51, "timestamp": "00:49:45", "text": "康德克斯（Condex）确实不错。好的"}]
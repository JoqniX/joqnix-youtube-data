[{"type": "subtitle", "time": 12002.55, "timestamp": "03:20:02", "text": "你玩的是多人模式还是故事"}, {"type": "subtitle", "time": 12005.67, "timestamp": "03:20:05", "text": "模式？ 呃，我们只是在刷副本"}, {"type": "subtitle", "time": 12008.79, "timestamp": "03:20:08", "text": "。 你可以说这不是多人游戏。 它们"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "就像人工智能伙伴一样。"}, {"type": "subtitle", "time": 12015.91, "timestamp": "03:20:15", "text": "非多人游戏。"}, {"type": "subtitle", "time": 12019.11, "timestamp": "03:20:19", "text": "所以，这些就像是可以"}, {"type": "subtitle", "time": 12021.67, "timestamp": "03:20:21", "text": "在战斗中协助你的伙伴。"}, {"type": "subtitle", "time": 12023.91, "timestamp": "03:20:23", "text": "我需要提升我的主角等级。"}, {"type": "subtitle", "time": 12032.309, "timestamp": "03:20:32", "text": "这款游戏就像是"}, {"type": "subtitle", "time": 12036.63, "timestamp": "03:20:36", "text": "动漫版的《星际战甲》（Warframe）。 你可以说没有陷阱。"}, {"type": "subtitle", "time": 12038.229, "timestamp": "03:20:38", "text": "虽然这是一款扭蛋游戏，但实际上并"}, {"type": "subtitle", "time": 12040.389, "timestamp": "03:20:40", "text": "没有扭蛋环节。 一切免费。"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "角色、武器。 你只需要种田、"}]
[{"type": "subtitle", "time": 20059.75, "timestamp": "05:34:19", "text": "你好。 我相信我能打败这个boss，"}, {"type": "subtitle", "time": 20063.11, "timestamp": "05:34:23", "text": "并且一击必杀，拜托了。"}, {"type": "subtitle", "time": 20071.99, "timestamp": "05:34:31", "text": "天哪。"}, {"type": "subtitle", "time": 20082.47, "timestamp": "05:34:42", "text": "躲闪。 躲闪。 这是令人窒息的巨浪。"}, {"type": "subtitle", "time": 20086.15, "timestamp": "05:34:46", "text": "等等，我的防御？我的护盾没了。   我的天啊"}, {"type": "subtitle", "time": 20094.788, "timestamp": "05:34:54", "text": "我本应该做点什么的，"}]
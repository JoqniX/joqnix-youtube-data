[{"type": "subtitle", "time": 21665.11, "timestamp": "06:01:05", "text": "，明天是“聚光灯”节目。"}, {"type": "subtitle", "time": 21667.11, "timestamp": "06:01:07", "text": "对，明天是堡垒之夜。 我"}, {"type": "subtitle", "time": 21676.708, "timestamp": "06:01:16", "text": "必须拿下"}, {"type": "subtitle", "time": 21691.83, "timestamp": "06:01:31", "text": "哦，他是个盾牌角色。 首领的护盾"}, {"type": "subtitle", "time": 21699.67, "timestamp": "06:01:39", "text": "我能否不打破他的护盾，让他无法"}, {"type": "subtitle", "time": 21701.75, "timestamp": "06:01:41", "text": "使用护盾？ 但他就像一辆"}, {"type": "subtitle", "time": 21706.15, "timestamp": "06:01:46", "text": "没有护盾的坦克，突然就失去了作用。 我不能吗？"}, {"type": "subtitle", "time": 21708.15, "timestamp": "06:01:48", "text": "哪款游戏可以打破他的护盾？"}, {"type": "subtitle", "time": 21710.788, "timestamp": "06:01:50", "text": "是哪款游戏？ 蓝色协议。 我"}, {"type": "subtitle", "time": 21712.47, "timestamp": "06:01:52", "text": "忘了。"}, {"type": "subtitle", "time": 21715.03, "timestamp": "06:01:55", "text": "好的，我们拿到了闪电战。"}]
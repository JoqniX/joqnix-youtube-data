[{"type": "subtitle", "time": 2162.23, "timestamp": "00:36:02", "text": "57. 这还不够，兄弟。"}, {"type": "subtitle", "time": 2166.069, "timestamp": "00:36:06", "text": "呃，我没钱了。"}, {"type": "subtitle", "time": 2169.359, "timestamp": "00:36:09", "text": "我没钱了。 我真的没钱了。"}, {"type": "subtitle", "time": 2175.349, "timestamp": "00:36:15", "text": "呃，"}, {"type": "subtitle", "time": 2178.15, "timestamp": "00:36:18", "text": "盒子里的猫。"}, {"type": "subtitle", "time": 2181.03, "timestamp": "00:36:21", "text": "H，这款黑色的也很可爱。 我"}, {"type": "subtitle", "time": 2198.31, "timestamp": "00:36:38", "text": "我不是为了钱，你知道，我不想那样"}, {"type": "subtitle", "time": 2200.31, "timestamp": "00:36:40", "text": "做。"}, {"type": "subtitle", "time": 2202.79, "timestamp": "00:36:42", "text": "我想做这件事。"}, {"type": "subtitle", "time": 2209.91, "timestamp": "00:36:49", "text": "呃，"}]
[{"type": "subtitle", "time": 12243.429, "timestamp": "03:24:03", "text": "这些就像是模组一样。 所以，就像电车的专业人士一样"}, {"type": "subtitle", "time": 12245.75, "timestamp": "03:24:05", "text": "。 这就是我想要的"}, {"type": "subtitle", "time": 12249.03, "timestamp": "03:24:09", "text": "紫色版本。 这"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "对于远程武器来说是好事。"}, {"type": "subtitle", "time": 12254.79, "timestamp": "03:24:14", "text": "触发概率为 10%，就是这样。"}, {"type": "subtitle", "time": 12257.269, "timestamp": "03:24:17", "text": "这些就像是模组。 你可以"}, {"type": "subtitle", "time": 12259.91, "timestamp": "03:24:19", "text": "为你的角色安装一些不错的MOD。"}, {"type": "subtitle", "time": 12263.269, "timestamp": "03:24:23", "text": "例如，我使用的角色"}, {"type": "subtitle", "time": 12267.19, "timestamp": "03:24:27", "text": "丽贝卡，她很适合挂机刷怪。"}, {"type": "subtitle", "time": 12271.349, "timestamp": "03:24:31", "text": "所以，我需要找到……呃，它叫什么来"}, {"type": "subtitle", "time": 12275.269, "timestamp": "03:24:35", "text": "着？ 我需要给她一些统计数据，让她"}, {"type": "subtitle", "time": 12279.03, "timestamp": "03:24:39", "text": "能够获得更多，该怎么称呼它呢？ 这些"}, {"type": "subtitle", "time": 12280.95, "timestamp": "03:24:40", "text": "高亮显示的数值包括：技能伤害、技能"}, {"type": "subtitle", "time": 12284.15, "timestamp": "03:24:44", "text": "范围、击杀数、水系攻击。 这是她"}, {"type": "subtitle", "time": 12286.469, "timestamp": "03:24:46", "text": "独有的数据。 所以，如果我理解没错的话，我需要用这些"}, {"type": "subtitle", "time": 12289.269, "timestamp": "03:24:49", "text": "东西来提升它们的等级，或者类似的事情"}, {"type": "subtitle", "time": 12292.469, "timestamp": "03:24:52", "text": "。"}, {"type": "subtitle", "time": 12294.87, "timestamp": "03:24:54", "text": "我对此并不了解。 我"}, {"type": "subtitle", "time": 12296.469, "timestamp": "03:24:56", "text": "得像教程那样跟着做"}, {"type": "subtitle", "time": 12298.79, "timestamp": "03:24:58", "text": "。 我不知道。"}]
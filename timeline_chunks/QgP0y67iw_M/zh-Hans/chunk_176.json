[{"type": "subtitle", "time": 10563.19, "timestamp": "02:56:03", "text": "我一直很讨厌这个人，他不给你，"}, {"type": "subtitle", "time": 10570.23, "timestamp": "02:56:10", "text": "呃，收回这句话。"}, {"type": "subtitle", "time": 10590.55, "timestamp": "02:56:30", "text": "我不能去那里。 我本来想去"}, {"type": "subtitle", "time": 10600.389, "timestamp": "02:56:40", "text": "惊讶的是，这款游戏竟然没有推出"}, {"type": "subtitle", "time": 10602.71, "timestamp": "02:56:42", "text": "任何万圣节活动。"}, {"type": "subtitle", "time": 10604.79, "timestamp": "02:56:44", "text": "我原以为游戏里会像"}, {"type": "subtitle", "time": 10607.67, "timestamp": "02:56:47", "text": "万圣节那样有很多装饰之类的，"}, {"type": "subtitle", "time": 10619.75, "timestamp": "02:56:59", "text": "现在确实有点卡顿。 因为我的电脑侧面装了"}]
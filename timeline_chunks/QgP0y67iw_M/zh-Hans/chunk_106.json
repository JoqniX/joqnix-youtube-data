[{"type": "subtitle", "time": 6361.43, "timestamp": "01:46:01", "text": "多直播平台？ 那是因为现在如果我在"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "这里使用 YouTube，如果我在"}, {"type": "subtitle", "time": 6367.59, "timestamp": "01:46:07", "text": "这里打开 YouTube，问题在于我必须"}, {"type": "subtitle", "time": 6371.43, "timestamp": "01:46:11", "text": "保持 YouTube 控制面板开启。"}, {"type": "subtitle", "time": 6374.629, "timestamp": "01:46:14", "text": "如果我的浏览器进入睡眠模式，"}, {"type": "subtitle", "time": 6377.35, "timestamp": "01:46:17", "text": "视频流就会中断。 这是其中一个"}, {"type": "subtitle", "time": 6379.51, "timestamp": "01:46:19", "text": "问题。 所以我必须像这样保持仪表盘"}, {"type": "subtitle", "time": 6382.55, "timestamp": "01:46:22", "text": "打开状态。 这样，这条溪流就会"}, {"type": "subtitle", "time": 6386.87, "timestamp": "01:46:26", "text": "继续存在。 如果我的仪表盘处于不活动状态，"}, {"type": "subtitle", "time": 6389.51, "timestamp": "01:46:29", "text": "例如标签页进入休眠状态，或者我不小心"}, {"type": "subtitle", "time": 6392.709, "timestamp": "01:46:32", "text": "关闭了它。 不，YouTube不会"}, {"type": "subtitle", "time": 6395.51, "timestamp": "01:46:35", "text": "从这里获取视频源。 那是"}, {"type": "subtitle", "time": 6398.229, "timestamp": "01:46:38", "text": "YouTube 的问题。 但不知何故，我使用"}, {"type": "subtitle", "time": 6406.149, "timestamp": "01:46:46", "text": "，Beam 正在考虑，"}, {"type": "subtitle", "time": 6409.43, "timestamp": "01:46:49", "text": "如果有一天 YouTube 或"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "Google 应用批准了"}, {"type": "subtitle", "time": 6415.59, "timestamp": "01:46:55", "text": "他们的申请，他们就会实现这个目标"}, {"type": "subtitle", "time": 6418.87, "timestamp": "01:46:58", "text": "。 所以，我还在使用 Mel，"}]
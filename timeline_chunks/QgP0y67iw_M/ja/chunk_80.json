[{"type": "subtitle", "time": 4801.59, "timestamp": "01:20:01", "text": "グラフィックカードをアップグレードして、"}, {"type": "subtitle", "time": 4804.31, "timestamp": "01:20:04", "text": "そこで再度呼び出すだけではダメなのでしょうか？   私はできません"}, {"type": "subtitle", "time": 4833.51, "timestamp": "01:20:33", "text": "でも"}, {"type": "subtitle", "time": 4835.59, "timestamp": "01:20:35", "text": "今は、"}, {"type": "subtitle", "time": 4838.07, "timestamp": "01:20:38", "text": "パーツを個別に交換したりアップグレードしたりできるノートパソコンにしようかと考えています"}, {"type": "subtitle", "time": 4840.31, "timestamp": "01:20:40", "text": "。 部品は"}, {"type": "subtitle", "time": 4843.03, "timestamp": "01:20:43", "text": "彼らのウェブサイトから購入するんだ。 それでいいのかどうか、よくわからない"}, {"type": "subtitle", "time": 4846.39, "timestamp": "01:20:46", "text": "。"}, {"type": "subtitle", "time": 4858.149, "timestamp": "01:20:58", "text": "私たちはたくさん農業を試みましたが、運が悪かったのです"}]
[{"type": "subtitle", "time": 5765.35, "timestamp": "01:36:05", "text": "うん、すごく便利だよ。 さて、私は"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "レベル50までレベルアップして"}, {"type": "subtitle", "time": 5774.39, "timestamp": "01:36:14", "text": "、このモッドやアーティファクトを"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "入手できるようにしなければなりませんでした。"}, {"type": "subtitle", "time": 5783.51, "timestamp": "01:36:23", "text": "ええ、ピアスの補助ですね。"}, {"type": "subtitle", "time": 5787.43, "timestamp": "01:36:27", "text": "これとこれを手に入れるにはレベル50にならなければならなかった。"}, {"type": "subtitle", "time": 5814.47, "timestamp": "01:36:54", "text": "私はホーリーベンドロータスゴッドインディゴを見たくない。"}]
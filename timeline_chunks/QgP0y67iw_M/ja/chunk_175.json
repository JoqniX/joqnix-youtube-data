[{"type": "subtitle", "time": 10510.309, "timestamp": "02:55:10", "text": "あなたの動画を投稿していました。ああ、なるほど。"}, {"type": "subtitle", "time": 10512.87, "timestamp": "02:55:12", "text": "今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 10515.349, "timestamp": "02:55:15", "text": "良いことをしている。 お元気ですか？ 今日は順調に"}, {"type": "subtitle", "time": 10519.19, "timestamp": "02:55:19", "text": "進んでいます。 元気です。"}, {"type": "subtitle", "time": 10521.269, "timestamp": "02:55:21", "text": "えっと、"}, {"type": "subtitle", "time": 10535.429, "timestamp": "02:55:35", "text": "、ラグがひどい。"}, {"type": "subtitle", "time": 10538.469, "timestamp": "02:55:38", "text": "複数のゲームを同時にプレイすると、こうなるんです（笑）"}, {"type": "subtitle", "time": 10540.95, "timestamp": "02:55:40", "text": "。 何が起こるのですか？ わかった。 とんでもない"}]
[{"type": "chat", "time": 18146.173, "timestamp": "05:02:26", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "if the truth is cruel, then lies must be kind. That's why kindness is a lie"}, {"type": "subtitle", "time": 18149.43, "timestamp": "05:02:29", "text": "そして明かりは消えなければならない。 だからこそ、"}, {"type": "subtitle", "time": 18152.15, "timestamp": "05:02:32", "text": "優しさは生き続けているのだ。"}, {"type": "subtitle", "time": 18161.99, "timestamp": "05:02:41", "text": "かわいそうな母親。娘は亡くなったが、"}, {"type": "subtitle", "time": 18166.39, "timestamp": "05:02:46", "text": "母親は最期の息を引き取る直前に、別の少女の命を救った"}, {"type": "chat", "time": 18167.65, "timestamp": "05:02:47", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "by hikki"}, {"type": "subtitle", "time": 18168.948, "timestamp": "05:02:48", "text": "。"}, {"type": "subtitle", "time": 18173.03, "timestamp": "05:02:53", "text": "しかし、それでも母親は信じられないでいる。"}, {"type": "subtitle", "time": 18176.708, "timestamp": "05:02:56", "text": "母親は、たとえ見つけることができなくても、娘を探しに行くつもりだ"}]
[{"type": "subtitle", "time": 15843.189, "timestamp": "04:24:03", "text": "つまり、彼女の家には何もないんです。"}, {"type": "subtitle", "time": 15846.07, "timestamp": "04:24:06", "text": "フィナ、元気でいるといいな。 あの、どうして"}, {"type": "subtitle", "time": 15849.67, "timestamp": "04:24:09", "text": "あなたと話せないんですか？ なぜNPCなの？"}, {"type": "subtitle", "time": 15858.07, "timestamp": "04:24:18", "text": "待って、今気づいたことがある。"}, {"type": "subtitle", "time": 15866.63, "timestamp": "04:24:26", "text": "待って。"}, {"type": "subtitle", "time": 15868.229, "timestamp": "04:24:28", "text": "うん。   彼女は"}, {"type": "subtitle", "time": 15871.83, "timestamp": "04:24:31", "text": "どこで手に入るの？   ちょっと"}, {"type": "subtitle", "time": 15874.79, "timestamp": "04:24:34", "text": "待って。 彼女が"}, {"type": "subtitle", "time": 15876.71, "timestamp": "04:24:36", "text": "ここにいないことに今気づいた。   では、"}, {"type": "subtitle", "time": 15879.83, "timestamp": "04:24:39", "text": "どうすれば彼女を手に入れられるのでしょうか？"}, {"type": "subtitle", "time": 15883.269, "timestamp": "04:24:43", "text": "フィナ。 フィナ。 フィナ。 フィナ。"}, {"type": "subtitle", "time": 15885.03, "timestamp": "04:24:45", "text": "はぁ？"}, {"type": "subtitle", "time": 15889.75, "timestamp": "04:24:49", "text": "待って。 フィナはどうすれば入手できますか？   ちょっと"}, {"type": "subtitle", "time": 15895.59, "timestamp": "04:24:55", "text": "待って。 わかった。 だから、ここでキスをする。"}]
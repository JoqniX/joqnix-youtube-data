[{"type": "subtitle", "time": 10203.67, "timestamp": "02:50:03", "text": "こんにちは。 水を楽しんでください。 夕食を食べてきて、戻ってきます"}, {"type": "subtitle", "time": 10209.99, "timestamp": "02:50:09", "text": "。 ここから始めようかな"}, {"type": "subtitle", "time": 10219.418, "timestamp": "02:50:19", "text": "女の子と話しているのを見かけたら戻ってくるよ。 何てことだ。"}, {"type": "subtitle", "time": 10221.269, "timestamp": "02:50:21", "text": "[笑い声]"}, {"type": "subtitle", "time": 10225.968, "timestamp": "02:50:25", "text": "こんにちは。 何てことだ。 私ってそんなに分かりにくい人なの？"}, {"type": "subtitle", "time": 10227.19, "timestamp": "02:50:27", "text": "[笑い]"}, {"type": "subtitle", "time": 10229.03, "timestamp": "02:50:29", "text": "わかった。"}, {"type": "subtitle", "time": 10235.75, "timestamp": "02:50:35", "text": "夕食。"}, {"type": "chat", "time": 10240.322, "timestamp": "02:50:40", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "not for me"}, {"type": "subtitle", "time": 10244.389, "timestamp": "02:50:44", "text": "、ちょっと待ってください。"}, {"type": "chat", "time": 10248.275, "timestamp": "02:50:48", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "I know you are boy"}, {"type": "subtitle", "time": 10254.309, "timestamp": "02:50:54", "text": "ああ、私が食事をして戻ってくるまで、このVを楽しんでください"}]
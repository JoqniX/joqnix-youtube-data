[{"type": "subtitle", "time": 6361.43, "timestamp": "01:46:01", "text": "マルチストリーマーを使用しているのか疑問に思うかもしれませんね。 なぜなら、"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "ここでYouTubeを使う場合、"}, {"type": "subtitle", "time": 6367.59, "timestamp": "01:46:07", "text": "ここでYouTubeをオンにすると、"}, {"type": "subtitle", "time": 6371.43, "timestamp": "01:46:11", "text": "YouTubeダッシュボードをオンにしたままにしておく必要があるからです。"}, {"type": "subtitle", "time": 6374.629, "timestamp": "01:46:14", "text": "ブラウザがスリープモードに入ると、"}, {"type": "subtitle", "time": 6377.35, "timestamp": "01:46:17", "text": "ストリーミングが途切れてしまいます。 それが一つの"}, {"type": "subtitle", "time": 6379.51, "timestamp": "01:46:19", "text": "問題点です。 だから、ダッシュボードは"}, {"type": "subtitle", "time": 6382.55, "timestamp": "01:46:22", "text": "このように開いたままにしておかなければならないんです。 つまり、その流れは"}, {"type": "subtitle", "time": 6386.87, "timestamp": "01:46:26", "text": "生き続けるということだ。 私のダッシュボードが非アクティブになった場合、"}, {"type": "subtitle", "time": 6389.51, "timestamp": "01:46:29", "text": "タブがスリープ状態になったり、誤って"}, {"type": "subtitle", "time": 6392.709, "timestamp": "01:46:32", "text": "閉じたりします。 いいえ、YouTubeは"}, {"type": "subtitle", "time": 6395.51, "timestamp": "01:46:35", "text": "ここからのフィードは取得しません。 それは"}, {"type": "subtitle", "time": 6398.229, "timestamp": "01:46:38", "text": "YouTube側の問題です。 しかし、なぜか私は"}, {"type": "subtitle", "time": 6406.149, "timestamp": "01:46:46", "text": "、Beamは"}, {"type": "subtitle", "time": 6409.43, "timestamp": "01:46:49", "text": "いつかYouTubeや"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "Googleアプリが"}, {"type": "subtitle", "time": 6415.59, "timestamp": "01:46:55", "text": "彼らのアプリケーションを承認すれば、それを実現することを考えている"}, {"type": "subtitle", "time": 6418.87, "timestamp": "01:46:58", "text": "。 だから、私はまだMelを使っているので、"}]
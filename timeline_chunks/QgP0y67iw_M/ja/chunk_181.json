[{"type": "subtitle", "time": 10860.63, "timestamp": "03:01:00", "text": "皆さんもそう思ってますよね？"}, {"type": "subtitle", "time": 10862.71, "timestamp": "03:01:02", "text": "画面全体がフリーズしている状態ですよね"}, {"type": "subtitle", "time": 10865.349, "timestamp": "03:01:05", "text": "？ それに、時々私の声が"}, {"type": "subtitle", "time": 10868.71, "timestamp": "03:01:08", "text": "遅れるんですよね？ 聖なる。"}, {"type": "subtitle", "time": 10871.75, "timestamp": "03:01:11", "text": "Farlight 84は、マルチタスクをしながら"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "プレイするのに適したゲームではないと思います。   そうそう"}, {"type": "subtitle", "time": 10900.55, "timestamp": "03:01:40", "text": "うん、めちゃくちゃ動作が遅いね。"}, {"type": "subtitle", "time": 10902.55, "timestamp": "03:01:42", "text": "リスクを冒すべきではないと思う。"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "あのね？"}, {"type": "subtitle", "time": 10910.23, "timestamp": "03:01:50", "text": "背景の照明のために、ちょっとやめておきます。 今はそうは思わない"}, {"type": "subtitle", "time": 10911.99, "timestamp": "03:01:51", "text": "。   まるで話が"}, {"type": "subtitle", "time": 10915.349, "timestamp": "03:01:55", "text": "遮断されているような気分だ。   何てことだ"}, {"type": "subtitle", "time": 10919.19, "timestamp": "03:01:59", "text": "。 後でやろう。"}]
[{"type": "subtitle", "time": 5891.99, "timestamp": "01:38:11", "text": "次回はいつですか？ わからない。 私は"}, {"type": "subtitle", "time": 5895.75, "timestamp": "01:38:15", "text": "人見知りすぎるんです。 それに、私は歌があまり上手じゃないんです。   ええ"}, {"type": "subtitle", "time": 5926.149, "timestamp": "01:38:46", "text": "オーケー、この胸。"}, {"type": "subtitle", "time": 5930.47, "timestamp": "01:38:50", "text": "私は再び街の中へ入っていく。"}]
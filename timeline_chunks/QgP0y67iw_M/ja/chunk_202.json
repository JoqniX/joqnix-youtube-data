[{"type": "subtitle", "time": 12122.469, "timestamp": "03:22:02", "text": "これらは"}, {"type": "subtitle", "time": 12126.79, "timestamp": "03:22:06", "text": "キャラクターの武器や"}, {"type": "subtitle", "time": 12130.95, "timestamp": "03:22:10", "text": "キャラクターの特殊武器に装着できるモジュールのようなものです。 だから、"}, {"type": "subtitle", "time": 12133.19, "timestamp": "03:22:13", "text": "これらの報酬が得られるまで何度もこれを繰り返します。ガチャはありません。"}, {"type": "subtitle", "time": 12141.99, "timestamp": "03:22:21", "text": "ガチャの代わりにこれを周回する必要があるからです。"}, {"type": "subtitle", "time": 12145.03, "timestamp": "03:22:25", "text": "コミッションと呼ばれるものがあります。"}, {"type": "subtitle", "time": 12148.87, "timestamp": "03:22:28", "text": "この秘密の文字キューブを入手する必要があります。これは、"}, {"type": "subtitle", "time": 12154.71, "timestamp": "03:22:34", "text": "エンドゲームや"}, {"type": "subtitle", "time": 12159.03, "timestamp": "03:22:39", "text": "イベントなどをプレイすることで入手できます。 つまり、この農場では、"}, {"type": "subtitle", "time": 12162.389, "timestamp": "03:22:42", "text": "キャラクターの"}, {"type": "subtitle", "time": 12165.269, "timestamp": "03:22:45", "text": "秘密の手紙を購入します。 つまり、ある程度の"}, {"type": "subtitle", "time": 12167.67, "timestamp": "03:22:47", "text": "確率があるということだ。"}, {"type": "subtitle", "time": 12170.71, "timestamp": "03:22:50", "text": "つまり、3つのティアがあり、ティア3は"}, {"type": "subtitle", "time": 12174.389, "timestamp": "03:22:54", "text": "通常の1のようなものです。 ティア2では2"}, {"type": "subtitle", "time": 12178.309, "timestamp": "03:22:58", "text": "発、ティア1では10"}]
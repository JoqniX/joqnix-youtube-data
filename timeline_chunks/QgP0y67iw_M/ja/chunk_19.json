[{"type": "subtitle", "time": 1181.51, "timestamp": "00:19:41", "text": "プレイヤー３。 知っている。 プレイヤー２。 さあ、入って。どうぞ"}, {"type": "subtitle", "time": 1191.35, "timestamp": "00:19:51", "text": "時代遅れだと思います。"}, {"type": "subtitle", "time": 1193.83, "timestamp": "00:19:53", "text": "おそらく、私たちは非常にゆっくりとテレポートされるでしょう"}, {"type": "subtitle", "time": 1195.669, "timestamp": "00:19:55", "text": "。   私たちを見てください"}, {"type": "subtitle", "time": 1198.15, "timestamp": "00:19:58", "text": "。 私たちは今、とても速い。 私たちを見てください"}, {"type": "subtitle", "time": 1199.83, "timestamp": "00:19:59", "text": "。"}]
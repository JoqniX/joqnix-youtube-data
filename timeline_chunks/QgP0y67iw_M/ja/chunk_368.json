[{"type": "subtitle", "time": 22085.03, "timestamp": "06:08:05", "text": "だから、この壁に"}, {"type": "subtitle", "time": 22087.27, "timestamp": "06:08:07", "text": "追い詰められて、スピードを上げて逃げるしかない。 よし、ついに2つ目を手に入れたぞ"}, {"type": "subtitle", "time": 22127.59, "timestamp": "06:08:47", "text": "だけが去った。 だから、サージハントが必要なんだ。 ハントは"}, {"type": "subtitle", "time": 22129.59, "timestamp": "06:08:49", "text": "待つ。"}, {"type": "subtitle", "time": 22133.99, "timestamp": "06:08:53", "text": "見捨てられたフェニル。  ForsakenのHunt"}, {"type": "subtitle", "time": 22136.788, "timestamp": "06:08:56", "text": "Fafne for Waitは、どちらも異なります。"}]
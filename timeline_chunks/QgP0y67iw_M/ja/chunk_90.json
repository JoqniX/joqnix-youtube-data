[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "OBSでは動作しません。 ああ、忘れてた。 こいつはバカだ。"}, {"type": "subtitle", "time": 5403.669, "timestamp": "01:30:03", "text": "ああ、もう。 忘れた。 私のウェブサイトは"}, {"type": "subtitle", "time": 5406.629, "timestamp": "01:30:06", "text": "OBSに対応していないんですよね"}, {"type": "subtitle", "time": 5408.31, "timestamp": "01:30:08", "text": "？"}, {"type": "subtitle", "time": 5413.189, "timestamp": "01:30:13", "text": "ええ、うまくいきません。 おお、"}, {"type": "subtitle", "time": 5417.59, "timestamp": "01:30:17", "text": "すごい。 忘れた。 効果があるだけではありません。"}, {"type": "subtitle", "time": 5420.95, "timestamp": "01:30:20", "text": "メルには効くよ。"}, {"type": "subtitle", "time": 5423.99, "timestamp": "01:30:23", "text": "うん。 ええと、これは他の"}, {"type": "subtitle", "time": 5428.47, "timestamp": "01:30:28", "text": "ブラウザでも動作するはずです。"}, {"type": "subtitle", "time": 5430.709, "timestamp": "01:30:30", "text": "V字型のやつ。"}, {"type": "chat", "time": 5432.582, "timestamp": "01:30:32", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "https://joqnix.space/stream-widgets/v..."}, {"type": "subtitle", "time": 5438.229, "timestamp": "01:30:38", "text": "？ 今、電源を入れたところです"}, {"type": "subtitle", "time": 5441.11, "timestamp": "01:30:41", "text": "。 それで、12なのに、"}, {"type": "subtitle", "time": 5444.95, "timestamp": "01:30:44", "text": "なぜストリームが2つしかないのですか？ そこに"}, {"type": "subtitle", "time": 5448.55, "timestamp": "01:30:48", "text": "30個生成されるはずです。"}, {"type": "subtitle", "time": 5451.51, "timestamp": "01:30:51", "text": "一度確認したら、"}, {"type": "subtitle", "time": 5454.07, "timestamp": "01:30:54", "text": "ストリームのバックエンドも確認するかもしれません。 いいえ。"}, {"type": "subtitle", "time": 5456.79, "timestamp": "01:30:56", "text": "サイクルって何ですか？ 見てみましょう。 なぜ動作しないのですか"}]
[{"type": "subtitle", "time": 20348.47, "timestamp": "05:39:08", "text": "いや、いや、いや、いや。 走れ、走れ、走れ、走れ。"}, {"type": "subtitle", "time": 20350.948, "timestamp": "05:39:10", "text": "バカ、バカ。"}, {"type": "subtitle", "time": 20352.39, "timestamp": "05:39:12", "text": "お願いです、これが私の最後の祈りです。 お願い、"}, {"type": "subtitle", "time": 20353.35, "timestamp": "05:39:13", "text": "、お願い"}, {"type": "subtitle", "time": 20358.23, "timestamp": "05:39:18", "text": "。 来て。 来て。"}, {"type": "subtitle", "time": 20360.788, "timestamp": "05:39:20", "text": "キャラクターのレベルを上げなきゃいけないんだよ。 次は気をつけます"}, {"type": "subtitle", "time": 20362.868, "timestamp": "05:39:22", "text": "。 気をつけます。 私たちはできるよ。"}, {"type": "subtitle", "time": 20374.15, "timestamp": "05:39:34", "text": "ああ、なんてことだ。 いや。"}, {"type": "subtitle", "time": 20378.708, "timestamp": "05:39:38", "text": "彼女に壁にぶつからせないでくれ。"}, {"type": "subtitle", "time": 20393.03, "timestamp": "05:39:53", "text": "究極の。   走る"}]
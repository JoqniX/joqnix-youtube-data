[{"type": "subtitle", "time": 2162.23, "timestamp": "00:36:02", "text": "57. それだけじゃ足りないよ、兄弟。"}, {"type": "subtitle", "time": 2166.069, "timestamp": "00:36:06", "text": "えっと、お金がなくなってしまいました。"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "お金がなくなってしまった。"}, {"type": "subtitle", "time": 2175.349, "timestamp": "00:36:15", "text": "えっと、"}, {"type": "subtitle", "time": 2178.15, "timestamp": "00:36:18", "text": "箱の中の猫。"}, {"type": "subtitle", "time": 2181.03, "timestamp": "00:36:21", "text": "ああ、この黒いのもすごく可愛いね。 わからない"}, {"type": "subtitle", "time": 2198.31, "timestamp": "00:36:38", "text": "お金のためじゃなくて、やりたくないんです"}, {"type": "subtitle", "time": 2200.31, "timestamp": "00:36:40", "text": "。   やりたいです"}, {"type": "subtitle", "time": 2202.79, "timestamp": "00:36:42", "text": "。"}, {"type": "subtitle", "time": 2209.91, "timestamp": "00:36:49", "text": "えっと、"}]
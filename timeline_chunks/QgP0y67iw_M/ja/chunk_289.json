[{"type": "subtitle", "time": 17342.868, "timestamp": "04:49:02", "text": "神。 反乱のエヴァ。"}, {"type": "subtitle", "time": 17350.15, "timestamp": "04:49:10", "text": "これは何ですか？"}, {"type": "subtitle", "time": 17363.99, "timestamp": "04:49:23", "text": "私は邸宅に入り、左へ右へ進みます"}, {"type": "subtitle", "time": 17365.55, "timestamp": "04:49:25", "text": "。"}, {"type": "subtitle", "time": 17374.07, "timestamp": "04:49:34", "text": "ここの左側へ行ってください。"}, {"type": "subtitle", "time": 17376.628, "timestamp": "04:49:36", "text": "ここ。"}, {"type": "subtitle", "time": 17378.788, "timestamp": "04:49:38", "text": "いや。待って、待って、待って、待って。 階段は"}, {"type": "subtitle", "time": 17381.11, "timestamp": "04:49:41", "text": "ここにあります。 ここです。 本来は"}, {"type": "subtitle", "time": 17385.856, "timestamp": "04:49:45", "text": "ここにあるはずなのですが、私が持ち帰ってしまったようです。"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "[ため息] ということは、"}, {"type": "subtitle", "time": 17393.19, "timestamp": "04:49:53", "text": "このゲームのほとんどすべてのアイテムを集めたってこと？"}]
[{"type": "subtitle", "time": 11114.95, "timestamp": "03:05:14", "text": "よし、これでこれも終わりだと思う"}, {"type": "subtitle", "time": 11120.71, "timestamp": "03:05:20", "text": "早かったですね。"}, {"type": "subtitle", "time": 11134.07, "timestamp": "03:05:34", "text": "私が探していたものではありませんでした。 さて、"}, {"type": "subtitle", "time": 11136.389, "timestamp": "03:05:36", "text": "もう一度言いますが、"}, {"type": "subtitle", "time": 11139.349, "timestamp": "03:05:39", "text": "正しいものを栽培しなければなりません。 それは"}, {"type": "subtitle", "time": 11143.67, "timestamp": "03:05:43", "text": "難しい。 それを手に入れるには運が必要だ"}, {"type": "subtitle", "time": 11145.19, "timestamp": "03:05:45", "text": "。"}]
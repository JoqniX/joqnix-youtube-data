[{"type": "subtitle", "time": 4762.229, "timestamp": "01:19:22", "text": "でも、SCS Rock 636については、ノート"}, {"type": "subtitle", "time": 4767.189, "timestamp": "01:19:27", "text": "パソコンに関してはあまり詳しくないんです。 残念ながら、"}, {"type": "subtitle", "time": 4770.07, "timestamp": "01:19:30", "text": "私はノートパソコンに詳しくありません。 いいえ、"}, {"type": "subtitle", "time": 4772.39, "timestamp": "01:19:32", "text": "アップグレードしたい場合は、"}, {"type": "subtitle", "time": 4774.63, "timestamp": "01:19:34", "text": "ユニット全体をアップグレードする必要があります。 さて、"}, {"type": "subtitle", "time": 4776.31, "timestamp": "01:19:36", "text": "それが私がノートパソコンで唯一嫌いな点です"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "。"}, {"type": "subtitle", "time": 4783.99, "timestamp": "01:19:43", "text": "例えば、50 50シリーズのノート"}, {"type": "subtitle", "time": 4786.229, "timestamp": "01:19:46", "text": "パソコンを買ったとしましょう。アップグレードするために新しいノートパソコンを買わなければなりません。 わかった。"}, {"type": "subtitle", "time": 4789.51, "timestamp": "01:19:49", "text": "60シリーズか"}, {"type": "subtitle", "time": 4793.75, "timestamp": "01:19:53", "text": "何かが出たら、"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "新しいのを買わなきゃいけないと思う。 いいえ。"}, {"type": "subtitle", "time": 4799.59, "timestamp": "01:19:59", "text": "そしてそれはfです。"}]
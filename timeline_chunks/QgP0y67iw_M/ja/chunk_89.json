[{"type": "subtitle", "time": 5342.709, "timestamp": "01:29:02", "text": "。 これで完了です。"}, {"type": "subtitle", "time": 5345.35, "timestamp": "01:29:05", "text": "それから、"}, {"type": "subtitle", "time": 5349.83, "timestamp": "01:29:09", "text": "いくつか設定を有効にさせてください。"}, {"type": "subtitle", "time": 5352.629, "timestamp": "01:29:12", "text": "この男、"}, {"type": "subtitle", "time": 5360.629, "timestamp": "01:29:20", "text": "うん、ちょっと席を外したら、えっと、"}, {"type": "subtitle", "time": 5365.35, "timestamp": "01:29:25", "text": "9時までには食べに行こうと思う。たぶん9時か9時半くらいかな。 それまでには"}, {"type": "subtitle", "time": 5368.47, "timestamp": "01:29:28", "text": "、すべて準備が整っていると思います。"}, {"type": "subtitle", "time": 5372.55, "timestamp": "01:29:32", "text": "まあ、そうですね。 ええ、8つ手に入れたら、ちょっと待ってください、"}, {"type": "subtitle", "time": 5375.99, "timestamp": "01:29:35", "text": "VODが再生されます。"}, {"type": "subtitle", "time": 5378.07, "timestamp": "01:29:38", "text": "VOD（ビデオオンデマンド）が再生されます。 これは、私が"}, {"type": "subtitle", "time": 5381.35, "timestamp": "01:29:41", "text": "このゲーム、TNAから配信した古いストリームの1つです"}, {"type": "subtitle", "time": 5383.27, "timestamp": "01:29:43", "text": "。   実際に動作させて"}, {"type": "subtitle", "time": 5386.31, "timestamp": "01:29:46", "text": "試してみたい。   ちょっと"}, {"type": "subtitle", "time": 5389.75, "timestamp": "01:29:49", "text": "待って、確認させて。 そもそも効果はあるのか？"}, {"type": "subtitle", "time": 5393.189, "timestamp": "01:29:53", "text": "確認したい。 これをオンにすると"}, {"type": "subtitle", "time": 5397.03, "timestamp": "01:29:57", "text": "表示されますか？ あ、待って。"}]
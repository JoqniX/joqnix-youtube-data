[{"type": "subtitle", "time": 17234.868, "timestamp": "04:47:14", "text": "彼らのファイルはどこにあるんですか？"}, {"type": "subtitle", "time": 17245.43, "timestamp": "04:47:25", "text": "これがこの家のものなの？"}, {"type": "subtitle", "time": 17254.55, "timestamp": "04:47:34", "text": "家の中で自分がどこにいるのかさえ分からない。   ええと"}, {"type": "subtitle", "time": 17269.27, "timestamp": "04:47:49", "text": "それらのファイルは収集できたと思います。   ただ、"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "ああ、おそらく別の名前でしょう。"}]
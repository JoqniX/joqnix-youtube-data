[{"type": "subtitle", "time": 4380.47, "timestamp": "01:13:00", "text": "私は遠くが見えません。"}, {"type": "subtitle", "time": 4383.669, "timestamp": "01:13:03", "text": "医者は、私が昨年、いや"}, {"type": "subtitle", "time": 4387.27, "timestamp": "01:13:07", "text": "今年の"}, {"type": "subtitle", "time": 4391.83, "timestamp": "01:13:11", "text": "1月、"}, {"type": "subtitle", "time": 4394.709, "timestamp": "01:13:14", "text": "日本に行く前にいつ視力検査を受けたのか尋ねました。"}, {"type": "chat", "time": 4399.169, "timestamp": "01:13:19", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "it's too much pain to see without glasses"}, {"type": "subtitle", "time": 4403.27, "timestamp": "01:13:23", "text": "7月の入院の時に行く予定だったのですが。 それで医者は「"}, {"type": "subtitle", "time": 4405.75, "timestamp": "01:13:25", "text": "レーザー治療をしますか？」と聞いてきたんです。"}, {"type": "subtitle", "time": 4408.39, "timestamp": "01:13:28", "text": "そして私は、「"}, {"type": "subtitle", "time": 4410.79, "timestamp": "01:13:30", "text": "メガネをかけた方が自分に似合う気がする」と思ったんです。"}, {"type": "subtitle", "time": 4413.669, "timestamp": "01:13:33", "text": "だから私は、「"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "私は長い間眼鏡を使っています"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "。 だから、やっぱり"}, {"type": "subtitle", "time": 4431.189, "timestamp": "01:13:51", "text": "メガネをかけ続けるべきだと思ったんです。"}, {"type": "subtitle", "time": 4434.07, "timestamp": "01:13:54", "text": "さらに、私のジョックニックモデルには丸"}, {"type": "subtitle", "time": 4437.51, "timestamp": "01:13:57", "text": "眼鏡が付いてきました。 そんな時に私は現実世界での活動があるんです。"}, {"type": "subtitle", "time": 4438.87, "timestamp": "01:13:58", "text": "「よし、"}]
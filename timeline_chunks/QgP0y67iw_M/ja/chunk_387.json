[{"type": "subtitle", "time": 23225.11, "timestamp": "06:27:05", "text": "おお。 おやすみなさい、そこにいたよ。"}, {"type": "subtitle", "time": 23229.19, "timestamp": "06:27:09", "text": "おやすみの出現率は異常に高い。"}, {"type": "subtitle", "time": 23232.788, "timestamp": "06:27:12", "text": "そして私は彼にもっと良い食べ物を与え、"}, {"type": "subtitle", "time": 23275.27, "timestamp": "06:27:55", "text": "私は運が良くない」という言葉を止めたらどうなるでしょうか。"}, {"type": "subtitle", "time": 23278.708, "timestamp": "06:27:58", "text": "箱型のやつをくれよ。"}]
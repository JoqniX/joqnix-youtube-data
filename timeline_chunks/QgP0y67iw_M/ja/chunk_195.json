[{"type": "subtitle", "time": 11714.469, "timestamp": "03:15:14", "text": "あの件が"}, {"type": "subtitle", "time": 11717.51, "timestamp": "03:15:17", "text": "起こっていた時に休止して以来、ウェブサイトには一切手を付けていません。"}, {"type": "subtitle", "time": 11724.63, "timestamp": "03:15:24", "text": "私はウェブサイトには一切手を付けていません。"}, {"type": "subtitle", "time": 11728.95, "timestamp": "03:15:28", "text": "今日、久しぶりに"}, {"type": "subtitle", "time": 11732.07, "timestamp": "03:15:32", "text": "配信を再開してコラボ動画を投稿しました。"}, {"type": "subtitle", "time": 11734.229, "timestamp": "03:15:34", "text": "コラボ企画を終えました。 コラボ作品を制作しました。 だから、"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "コラボパートナーのデータベースを更新した方がいいかなって考えてたんだよね"}, {"type": "subtitle", "time": 11741.59, "timestamp": "03:15:41", "text": "？ つまり、その人の"}, {"type": "subtitle", "time": 11745.19, "timestamp": "03:15:45", "text": "アバターやPNG画像などを"}, {"type": "subtitle", "time": 11748.389, "timestamp": "03:15:48", "text": "Notionデータベースに追加できるということです。 だから今はもっと簡単になった。 だから、"}, {"type": "subtitle", "time": 11753.83, "timestamp": "03:15:53", "text": "PNG画像を入手するために彼らのDMを掘り起こす必要はない。  Notionを使って既に自分のウェブサイトにホストしているはずです"}]
[{"type": "subtitle", "time": 2746.71, "timestamp": "00:45:46", "text": "戦闘パートナーを"}, {"type": "subtitle", "time": 2750.47, "timestamp": "00:45:50", "text": "同じ場所に配置して、自分は"}, {"type": "subtitle", "time": 2753.349, "timestamp": "00:45:53", "text": "他の場所で資源を採集しながら、パートナーの一人を"}, {"type": "subtitle", "time": 2755.829, "timestamp": "00:45:55", "text": "このエリアに留めておくとか、そういうことができたらいいのに。"}]
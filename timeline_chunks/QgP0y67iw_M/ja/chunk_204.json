[{"type": "subtitle", "time": 12243.429, "timestamp": "03:24:03", "text": "これらは、いわば改造のようなものです。 つまり、"}, {"type": "subtitle", "time": 12245.75, "timestamp": "03:24:05", "text": "路面電車のプロみたいな感じ。 私が欲しかったのは、この商品の"}, {"type": "subtitle", "time": 12249.03, "timestamp": "03:24:09", "text": "紫色バージョンでした。 これは"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "遠距離武器に適しています。"}, {"type": "subtitle", "time": 12254.79, "timestamp": "03:24:14", "text": "トリガー確率は10%といったところでしょうか。"}, {"type": "subtitle", "time": 12257.269, "timestamp": "03:24:17", "text": "これらはモッドのようなものです。"}, {"type": "subtitle", "time": 12259.91, "timestamp": "03:24:19", "text": "キャラクター用の優れた改造パーツを入手できます。"}, {"type": "subtitle", "time": 12263.269, "timestamp": "03:24:23", "text": "例えば、私が使っているキャラクターの"}, {"type": "subtitle", "time": 12267.19, "timestamp": "03:24:27", "text": "レベッカは、放置狩りに適しています。"}, {"type": "subtitle", "time": 12271.349, "timestamp": "03:24:31", "text": "それで、えっと、なんて言うんでしたっけ"}, {"type": "subtitle", "time": 12275.269, "timestamp": "03:24:35", "text": "？ 彼女にもっと多くの統計情報を与える必要があるのですが、"}, {"type": "subtitle", "time": 12279.03, "timestamp": "03:24:39", "text": "それを何と呼ぶのでしょうか？ これらは"}, {"type": "subtitle", "time": 12280.95, "timestamp": "03:24:40", "text": "、スキルダメージ、スキル"}, {"type": "subtitle", "time": 12284.15, "timestamp": "03:24:44", "text": "範囲、キル数、ハイドロアタックです。 これらは彼女"}, {"type": "subtitle", "time": 12286.469, "timestamp": "03:24:46", "text": "独自の統計データです。 つまり、これらのアイテムを使ってレベルアップする必要がある、ということでしょうか"}, {"type": "subtitle", "time": 12292.469, "timestamp": "03:24:52", "text": "。"}, {"type": "subtitle", "time": 12294.87, "timestamp": "03:24:54", "text": "私はこの分野に詳しくありません。"}, {"type": "subtitle", "time": 12296.469, "timestamp": "03:24:56", "text": "チュートリアルとかに従わないといけないんです"}, {"type": "subtitle", "time": 12298.79, "timestamp": "03:24:58", "text": "。 わからない。"}]
[{"type": "subtitle", "time": 4622.55, "timestamp": "01:17:02", "text": "ゲーム用PCの"}, {"type": "subtitle", "time": 4627.51, "timestamp": "01:17:07", "text": "RAMなどは、ストリーム用PCの"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "RAMやキャプチャーカードなど全て使っていますが、ゲーム用"}, {"type": "subtitle", "time": 4637.75, "timestamp": "01:17:17", "text": "PCが壊れてしまったので、今はキャプチャーカードを使う必要はありません。予備のPCがないのですが、"}, {"type": "subtitle", "time": 4642.31, "timestamp": "01:17:22", "text": "おそらく1月か"}, {"type": "subtitle", "time": 4645.669, "timestamp": "01:17:25", "text": "2月にはノートパソコンを購入する予定です。"}, {"type": "subtitle", "time": 4650.47, "timestamp": "01:17:30", "text": "4月には日本に"}, {"type": "subtitle", "time": 4651.83, "timestamp": "01:17:31", "text": "留学に行くので、その時に持っていく必要があります"}, {"type": "subtitle", "time": 4653.35, "timestamp": "01:17:33", "text": "。   だから、おそらく"}, {"type": "subtitle", "time": 4657.27, "timestamp": "01:17:37", "text": "私はラップトップで"}, {"type": "subtitle", "time": 4659.669, "timestamp": "01:17:39", "text": "ゲームをして、"}, {"type": "subtitle", "time": 4663.11, "timestamp": "01:17:43", "text": "ストリーム PC を PCR 音楽ストリームとして使うつもりです"}, {"type": "subtitle", "time": 4666.95, "timestamp": "01:17:46", "text": "。 ああ、そうするよ。待ちきれない。"}, {"type": "subtitle", "time": 4669.99, "timestamp": "01:17:49", "text": "[鼻を鳴らす] 残念ながら、"}, {"type": "subtitle", "time": 4674.229, "timestamp": "01:17:54", "text": "これを全部日本のドームに持っていくことはできません。"}, {"type": "subtitle", "time": 4679.51, "timestamp": "01:17:59", "text": "なぜなら、あちらには荷物制限があるからです。 待ち時間制限など"}]
[{"type": "subtitle", "time": 6675.669, "timestamp": "01:51:15", "text": "ああ、私の戦闘パートが来た。 よし"}, {"type": "subtitle", "time": 6690.39, "timestamp": "01:51:30", "text": "戦闘仲間の皆さん、こちらの女性が必要です"}, {"type": "subtitle", "time": 6693.189, "timestamp": "01:51:33", "text": "。"}, {"type": "subtitle", "time": 6696.149, "timestamp": "01:51:36", "text": "あなたは何が好きですか？ 剣と弓。 わかった、"}, {"type": "subtitle", "time": 6719.83, "timestamp": "01:51:59", "text": "トリュフチャマを入れてもいいと思う。 お二人ともお似合いです"}]
[{"type": "subtitle", "time": 10563.19, "timestamp": "02:56:03", "text": "私はいつもこの男が嫌いです。"}, {"type": "subtitle", "time": 10570.23, "timestamp": "02:56:10", "text": "あ、取り消してください。"}, {"type": "subtitle", "time": 10590.55, "timestamp": "02:56:30", "text": "私はそこへは行けません。"}, {"type": "subtitle", "time": 10600.389, "timestamp": "02:56:40", "text": "ゲームが"}, {"type": "subtitle", "time": 10602.71, "timestamp": "02:56:42", "text": "ハロウィンに何も対応しなかったのは意外だ。"}, {"type": "subtitle", "time": 10604.79, "timestamp": "02:56:44", "text": "ゲーム内に"}, {"type": "subtitle", "time": 10607.67, "timestamp": "02:56:47", "text": "ハロウィンの飾り付けとかがあると思ってたんだけど、なかった"}, {"type": "subtitle", "time": 10619.75, "timestamp": "02:56:59", "text": "今は動作が遅いですね。 それは、私のサイドに"}]
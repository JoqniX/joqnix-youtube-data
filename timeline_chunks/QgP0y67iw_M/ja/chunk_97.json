[{"type": "subtitle", "time": 5845.03, "timestamp": "01:37:25", "text": "。 こちらです。 そして、あるはずです。あるはずです。"}, {"type": "subtitle", "time": 5848.229, "timestamp": "01:37:28", "text": "ああ、それは上にあります。 わかった。"}, {"type": "subtitle", "time": 5857.669, "timestamp": "01:37:37", "text": "私の言うとおりです。 はい、そうします。 私はします。 ただ、"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "私は歌が下手なんです。"}, {"type": "subtitle", "time": 5863.51, "timestamp": "01:37:43", "text": "今、赤崎の「青春ブタ野郎」を聴いています"}, {"type": "subtitle", "time": 5865.109, "timestamp": "01:37:45", "text": "。   まるで"}]
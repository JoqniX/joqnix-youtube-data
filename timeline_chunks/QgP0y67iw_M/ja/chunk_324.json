[{"type": "subtitle", "time": 19449.59, "timestamp": "05:24:09", "text": "射程武器のクリティカル発生率を上げて、範囲"}, {"type": "subtitle", "time": 19451.67, "timestamp": "05:24:11", "text": "内の敵を倒します。 わかった。 うん。 うん。"}, {"type": "subtitle", "time": 19485.03, "timestamp": "05:24:45", "text": "待て、悪魔の楔形は間違っている。 おお。 あ、"}, {"type": "subtitle", "time": 19487.27, "timestamp": "05:24:47", "text": "待って。 デーモンウェスは使用しません。"}, {"type": "subtitle", "time": 19490.47, "timestamp": "05:24:50", "text": "忘れた。 あ、"}]
[{"type": "subtitle", "time": 19861.83, "timestamp": "05:31:01", "text": "。 どちらも良いですね。 どちらも良いですね"}, {"type": "subtitle", "time": 19877.59, "timestamp": "05:31:17", "text": "これでいいでしょう。 いいえ、標的は1つだけです"}, {"type": "subtitle", "time": 19879.67, "timestamp": "05:31:19", "text": "。 さて、最後のボスは単体のターゲットであることを覚えておいてください"}, {"type": "subtitle", "time": 19883.19, "timestamp": "05:31:23", "text": "。"}, {"type": "subtitle", "time": 19887.19, "timestamp": "05:31:27", "text": "だから、そんなにたくさん必要ないんです。 すでに一匹の"}, {"type": "subtitle", "time": 19889.35, "timestamp": "05:31:29", "text": "クラゲが辺り一面を覆っている"}, {"type": "subtitle", "time": 19892.39, "timestamp": "05:31:32", "text": "。 まあまあ [笑い] スキル範囲は"}, {"type": "subtitle", "time": 19899.19, "timestamp": "05:31:39", "text": "それは正気の沙汰ではない。 私のクラゲの生息範囲を見てください"}, {"type": "subtitle", "time": 19900.868, "timestamp": "05:31:40", "text": "。   わかった"}, {"type": "subtitle", "time": 19904.23, "timestamp": "05:31:44", "text": "。 ダメージを受けると、銃のシールドポイントが減る。"}, {"type": "subtitle", "time": 19909.11, "timestamp": "05:31:49", "text": "トリガー確率は90%です。"}]
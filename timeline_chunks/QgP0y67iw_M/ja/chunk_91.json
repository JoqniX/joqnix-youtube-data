[{"type": "subtitle", "time": 5464.47, "timestamp": "01:31:04", "text": "ああ、定義されていないようです。 未定義。 ああ、"}, {"type": "subtitle", "time": 5473.11, "timestamp": "01:31:13", "text": "ええと、それは明日やります。"}, {"type": "subtitle", "time": 5475.669, "timestamp": "01:31:15", "text": "おそらく遅延が原因でしょう。"}, {"type": "subtitle", "time": 5483.189, "timestamp": "01:31:23", "text": "さて、どこまで話しましたっけ？"}, {"type": "subtitle", "time": 5487.27, "timestamp": "01:31:27", "text": "別の地図を見てみましょう。 氷。 それで、"}, {"type": "subtitle", "time": 5490.629, "timestamp": "01:31:30", "text": "ガルヴァネットとガラとランサを終えました。 というわけで、"}, {"type": "subtitle", "time": 5493.83, "timestamp": "01:31:33", "text": "今回は氷の湖で泳ぐような感じかな。 いや、"}, {"type": "subtitle", "time": 5498.31, "timestamp": "01:31:38", "text": "待って、昨日縫い終わったよ。"}, {"type": "subtitle", "time": 5500.07, "timestamp": "01:31:40", "text": "それで、なんとか"}, {"type": "subtitle", "time": 5508.709, "timestamp": "01:31:48", "text": "。"}, {"type": "subtitle", "time": 5510.709, "timestamp": "01:31:50", "text": "そうそう。 あなたがそこにいたかどうかは分かりません。"}, {"type": "subtitle", "time": 5512.629, "timestamp": "01:31:52", "text": "えっと、いつ"}, {"type": "subtitle", "time": 5515.11, "timestamp": "01:31:55", "text": "私を襲撃したんですか？ 何曜日だったっけ"}, {"type": "subtitle", "time": 5517.51, "timestamp": "01:31:57", "text": "？ 忘れた。"}]
[{"type": "subtitle", "time": 8411.27, "timestamp": "02:20:11", "text": "ああ、なるほど。   つららの中には"}, {"type": "subtitle", "time": 8413.75, "timestamp": "02:20:13", "text": "サシバカも隠れている"}, {"type": "subtitle", "time": 8416.71, "timestamp": "02:20:16", "text": "。"}, {"type": "subtitle", "time": 8419.11, "timestamp": "02:20:19", "text": "つまり、ここより下に位置するはずです。"}, {"type": "subtitle", "time": 8427.59, "timestamp": "02:20:27", "text": "受け取ったと思います。 ここにはない。"}, {"type": "subtitle", "time": 8440.96, "timestamp": "02:20:40", "text": "。 釣り場の近く。"}, {"type": "subtitle", "time": 8443.76, "timestamp": "02:20:43", "text": "釣り場の近く。 あれは宝箱ですよね？ わかった。   わーい！"}]
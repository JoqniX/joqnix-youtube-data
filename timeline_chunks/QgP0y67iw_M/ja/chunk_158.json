[{"type": "subtitle", "time": 9486.469, "timestamp": "02:38:06", "text": "でも、そうですね、これには時間がかかりました。"}, {"type": "subtitle", "time": 9488.71, "timestamp": "02:38:08", "text": "私の別のYouTuberの友達が、"}, {"type": "subtitle", "time": 9491.03, "timestamp": "02:38:11", "text": "歌の歌い方を教えてくれました。 そうやって私は"}, {"type": "subtitle", "time": 9494.389, "timestamp": "02:38:14", "text": "それを知ったのです。 だから私は、音楽の"}, {"type": "subtitle", "time": 9497.59, "timestamp": "02:38:17", "text": "練習を積極的に続けていました。   今はまあまあ大丈夫です"}, {"type": "subtitle", "time": 9501.67, "timestamp": "02:38:21", "text": "。 でも、"}, {"type": "subtitle", "time": 9503.429, "timestamp": "02:38:23", "text": "他にも"}, {"type": "subtitle", "time": 9505.75, "timestamp": "02:38:25", "text": "練習している曲はたくさんありますよ。"}, {"type": "chat", "time": 9511.433, "timestamp": "02:38:31", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "you sing English one also ?"}, {"type": "subtitle", "time": 9514.63, "timestamp": "02:38:34", "text": "それは歌うようなものだ。 いいえ。ええと、今のところは"}, {"type": "subtitle", "time": 9516.95, "timestamp": "02:38:36", "text": "歌詞を読んで、それに合わせて歌うことはできます"}, {"type": "subtitle", "time": 9519.349, "timestamp": "02:38:39", "text": "。 でも一番大事なのは、"}, {"type": "subtitle", "time": 9523.51, "timestamp": "02:38:43", "text": "イントネーションとか音程とかそういうことだ。 いいえ、"}, {"type": "subtitle", "time": 9527.75, "timestamp": "02:38:47", "text": "それこそ私が練習する必要があることです。 英語の歌も歌ってください"}, {"type": "subtitle", "time": 9530.469, "timestamp": "02:38:50", "text": "。 いいえ、私はしません。"}, {"type": "subtitle", "time": 9533.27, "timestamp": "02:38:53", "text": "練習しなければならない。 いいえ、"}, {"type": "subtitle", "time": 9535.27, "timestamp": "02:38:55", "text": "現在、英語の歌を"}]
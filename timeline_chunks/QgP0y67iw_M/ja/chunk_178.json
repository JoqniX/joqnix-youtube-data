[{"type": "subtitle", "time": 10682.389, "timestamp": "02:58:02", "text": "別のゲームでの私。"}, {"type": "subtitle", "time": 10684.87, "timestamp": "02:58:04", "text": "あれ、なぜここに表示されないんだろう？ ああ、"}, {"type": "subtitle", "time": 10687.51, "timestamp": "02:58:07", "text": "光よ。 はい、ここにいます。 わかった、私は"}, {"type": "subtitle", "time": 10691.11, "timestamp": "02:58:11", "text": "死にたいんだ。 手榴弾を見つけて、そのまま"}, {"type": "subtitle", "time": 10694.953, "timestamp": "02:58:14", "text": "死にたい。 その箱にはマッチが３つ必要です。"}, {"type": "subtitle", "time": 10702.07, "timestamp": "02:58:22", "text": "その時は火を噴き出せばよかったのに。  H"}, {"type": "subtitle", "time": 10706.63, "timestamp": "02:58:26", "text": "でも、悪魔をなんとかやらなきゃいけないんだよね"}, {"type": "subtitle", "time": 10709.99, "timestamp": "02:58:29", "text": "。 ああ、ゲームがすごく"}, {"type": "subtitle", "time": 10715.51, "timestamp": "02:58:35", "text": "カクカクする。"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "すごく動作が遅いものが見えています。 よし、その"}, {"type": "subtitle", "time": 10720.63, "timestamp": "02:58:40", "text": "人を見つけた。 もしそれがボットなら、私を"}, {"type": "subtitle", "time": 10724.71, "timestamp": "02:58:44", "text": "殺してください。 ねえ、"}, {"type": "subtitle", "time": 10727.51, "timestamp": "02:58:47", "text": "お願いだから私を殺して。 ああ、もう殺してくれ。 はい。 君は"}, {"type": "subtitle", "time": 10731.269, "timestamp": "02:58:51", "text": "射撃が下手だ。 君は射撃が下手だ。 ああ、"}, {"type": "subtitle", "time": 10737.349, "timestamp": "02:58:57", "text": "どうして君は射撃が下手なんだい？"}]
[{"type": "subtitle", "time": 5282.55, "timestamp": "01:28:02", "text": "レアな出現場所はどこにある？"}, {"type": "subtitle", "time": 5286.87, "timestamp": "01:28:06", "text": "天才。 私のポケモンが欲しい。"}, {"type": "subtitle", "time": 5291.189, "timestamp": "01:28:11", "text": "ああ、わかった。 ここにはないと思います。"}, {"type": "subtitle", "time": 5293.51, "timestamp": "01:28:13", "text": "おそらく、昨日"}, {"type": "subtitle", "time": 5296.149, "timestamp": "01:28:16", "text": "リセット後にここに来てそれを探していたからでしょう"}, {"type": "subtitle", "time": 5300.229, "timestamp": "01:28:20", "text": "。 だから、ここにはないかもしれない。 そうであれば"}, {"type": "subtitle", "time": 5304.87, "timestamp": "01:28:24", "text": "、今日やってみましょう。 えっと、"}, {"type": "subtitle", "time": 5311.43, "timestamp": "01:28:31", "text": "このマップでは宝箱探しができますよ。  1秒。"}, {"type": "subtitle", "time": 5313.99, "timestamp": "01:28:33", "text": "私の実績を明確にさせてください。   今は8時"}, {"type": "subtitle", "time": 5317.669, "timestamp": "01:28:37", "text": "30分です。 夕食を食べなければならない。 お腹が空きました"}, {"type": "subtitle", "time": 5320.31, "timestamp": "01:28:40", "text": "。"}, {"type": "subtitle", "time": 5322.229, "timestamp": "01:28:42", "text": "お腹がすいた。"}, {"type": "subtitle", "time": 5338.87, "timestamp": "01:28:58", "text": "うん、少なめに食べるよ。 今じゃない。 もう少ししたら食べてください"}]
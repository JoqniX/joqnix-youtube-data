[{"type": "subtitle", "time": 21665.11, "timestamp": "06:01:05", "text": "そうそう、明日はスポットライトだよ。"}, {"type": "subtitle", "time": 21667.11, "timestamp": "06:01:07", "text": "うん、明日はフォートナイトだよ。"}, {"type": "subtitle", "time": 21691.83, "timestamp": "06:01:31", "text": "ああ、盾使いのキャラクターですね。 ボスのシールド"}, {"type": "subtitle", "time": 21701.75, "timestamp": "06:01:41", "text": "使えないように、彼の盾を壊すことはできないのでしょうか？ しかし彼はまるで"}, {"type": "subtitle", "time": 21706.15, "timestamp": "06:01:46", "text": "盾のない戦車のような存在だ。 ダメですか？"}, {"type": "subtitle", "time": 21708.15, "timestamp": "06:01:48", "text": "どのゲームで彼のシールドを破ることができますか？"}, {"type": "subtitle", "time": 21710.788, "timestamp": "06:01:50", "text": "どのゲームでしたか？ ブループロトコル。"}, {"type": "subtitle", "time": 21712.47, "timestamp": "06:01:52", "text": "忘れた。"}, {"type": "subtitle", "time": 21715.03, "timestamp": "06:01:55", "text": "よし、ブリッツを手に入れたぞ。"}]
[{"type": "subtitle", "time": 1860.31, "timestamp": "00:31:00", "text": "かわいい。 友達みたいだ。"}, {"type": "subtitle", "time": 1863.029, "timestamp": "00:31:03", "text": "絶対に。"}, {"type": "subtitle", "time": 1866.149, "timestamp": "00:31:06", "text": "ああ、あの人はガチャプレイヤーだ。 いや、どうやら"}, {"type": "subtitle", "time": 1870.87, "timestamp": "00:31:10", "text": "ガチャにお金を使うべきだらしい。"}, {"type": "subtitle", "time": 1898.47, "timestamp": "00:31:38", "text": "。  L60は行く。"}]
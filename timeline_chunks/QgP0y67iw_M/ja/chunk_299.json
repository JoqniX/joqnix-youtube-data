[{"type": "subtitle", "time": 17944.39, "timestamp": "04:59:04", "text": "これであなたは人々のことを忘れないでしょう。"}, {"type": "subtitle", "time": 17951.67, "timestamp": "04:59:11", "text": "、エルサ。   ああ、なんてことだ"}, {"type": "subtitle", "time": 17987.83, "timestamp": "04:59:47", "text": "彼女はあなたの腕にコインポーチを握らせ、まるで魔法にかかったように"}, {"type": "subtitle", "time": 17990.47, "timestamp": "04:59:50", "text": "立ち去る。"}, {"type": "subtitle", "time": 17992.868, "timestamp": "04:59:52", "text": "彼女の揺らめく瞳には涙と微笑みが混じり合い、"}, {"type": "subtitle", "time": 17998.948, "timestamp": "04:59:58", "text": "最後には優しくなった。 喉はきれいでなければならない。 時間は、それが持つ"}]
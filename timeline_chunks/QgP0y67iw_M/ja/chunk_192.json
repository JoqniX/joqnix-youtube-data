[{"type": "subtitle", "time": 11521.269, "timestamp": "03:12:01", "text": "。"}, {"type": "subtitle", "time": 11546.63, "timestamp": "03:12:26", "text": "クール。 新しいモデルを手に入れましたね。 ああ、これは"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "トランブルとホンダ。 待て、これは"}, {"type": "subtitle", "time": 11555.349, "timestamp": "03:12:35", "text": "ホンダではない。 これは違う。 わかった。"}, {"type": "subtitle", "time": 11557.75, "timestamp": "03:12:37", "text": "もう一度挑戦してください。"}, {"type": "subtitle", "time": 11559.99, "timestamp": "03:12:39", "text": "こんにちは、ライランド。 お元気ですか？ 久しぶりですね"}]
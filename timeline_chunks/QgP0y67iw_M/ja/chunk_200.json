[{"type": "subtitle", "time": 12002.55, "timestamp": "03:20:02", "text": "マルチプレイヤーモードとストーリーモード、どちらをプレイしていますか"}, {"type": "subtitle", "time": 12005.67, "timestamp": "03:20:05", "text": "？ えっと、ダンジョン"}, {"type": "subtitle", "time": 12008.79, "timestamp": "03:20:08", "text": "攻略をしているところです。 マルチプレイヤーではないと言ってもいいでしょう。 これらは"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "AIコンパニオンのようなものだ。"}, {"type": "subtitle", "time": 12015.91, "timestamp": "03:20:15", "text": "マルチプレイヤーではありません。"}, {"type": "subtitle", "time": 12019.11, "timestamp": "03:20:19", "text": "つまり、これらは"}, {"type": "subtitle", "time": 12021.67, "timestamp": "03:20:21", "text": "戦闘であなたを助けてくれる仲間のようなものです。"}, {"type": "subtitle", "time": 12023.91, "timestamp": "03:20:23", "text": "メインキャラクターのレベルを上げなきゃ。"}, {"type": "subtitle", "time": 12032.309, "timestamp": "03:20:32", "text": "このゲームはWarframeの"}, {"type": "subtitle", "time": 12036.63, "timestamp": "03:20:36", "text": "アニメ版Warframeみたいなものだ。  「いいえ、騙された」と言ってもいいですよ。"}, {"type": "subtitle", "time": 12038.229, "timestamp": "03:20:38", "text": "これはガチャゲームですが、"}, {"type": "subtitle", "time": 12040.389, "timestamp": "03:20:40", "text": "ガチャはありません。 すべて無料です。"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "キャラクター、武器。 ひたすら耕す、"}]
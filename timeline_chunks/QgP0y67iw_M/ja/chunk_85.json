[{"type": "subtitle", "time": 5120.55, "timestamp": "01:25:20", "text": "よし、何も"}, {"type": "subtitle", "time": 5127.75, "timestamp": "01:25:27", "text": "どうかここにいてください。"}, {"type": "subtitle", "time": 5135.59, "timestamp": "01:25:35", "text": "こんにちは、ユキさん。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 5137.189, "timestamp": "01:25:37", "text": "今日の調子はどうですか？"}, {"type": "subtitle", "time": 5144.55, "timestamp": "01:25:44", "text": "私は語学の授業を受けなかったのですか？ もちろん。 私は"}, {"type": "subtitle", "time": 5147.43, "timestamp": "01:25:47", "text": "配信を早めに始めました。 というわけで、"}, {"type": "subtitle", "time": 5150.709, "timestamp": "01:25:50", "text": "午前中は配信しました。   で"}]
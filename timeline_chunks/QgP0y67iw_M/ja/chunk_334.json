[{"type": "subtitle", "time": 20059.75, "timestamp": "05:34:19", "text": "こんにちは。 私はこのボスと戦って、"}, {"type": "subtitle", "time": 20063.11, "timestamp": "05:34:23", "text": "一撃で倒せると思います。お願いします。"}, {"type": "subtitle", "time": 20071.99, "timestamp": "05:34:31", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 20082.47, "timestamp": "05:34:42", "text": "ダッジ。 ダッジ。 それは、衰退していく波だ。"}, {"type": "subtitle", "time": 20086.15, "timestamp": "05:34:46", "text": "待って、私の防御シールドがなくなりました。   ああ"}, {"type": "subtitle", "time": 20094.788, "timestamp": "05:34:54", "text": "俺は何か対策を講じるべきだった、"}]
[{"type": "subtitle", "time": 1217.19, "timestamp": "00:20:17", "text": "、それはたくさんのことだ。 上。"}, {"type": "subtitle", "time": 1222.87, "timestamp": "00:20:22", "text": "はい。 さあ行こう。 もう一つだけください"}, {"type": "subtitle", "time": 1224.549, "timestamp": "00:20:24", "text": "。 本当はそういう使い方をするべきじゃないんだ"}, {"type": "subtitle", "time": 1226.87, "timestamp": "00:20:26", "text": "けど、まあ、別にいいかと思って、このまま使ってみるよ。"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "行く。 たくさんの武器をレベルアップさせなきゃ"}, {"type": "subtitle", "time": 1239.35, "timestamp": "00:20:39", "text": "。  260。だから、私は"}, {"type": "subtitle", "time": 1242.07, "timestamp": "00:20:42", "text": "大丈夫です。 良い。"}]
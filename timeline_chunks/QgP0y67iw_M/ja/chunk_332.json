[{"type": "subtitle", "time": 19941.67, "timestamp": "05:32:21", "text": "ええと、強化を所持しているときに復活ダメージを1減らし、"}, {"type": "subtitle", "time": 19945.75, "timestamp": "05:32:25", "text": "復活正気"}, {"type": "subtitle", "time": 19954.948, "timestamp": "05:32:34", "text": "。 はぁ？"}, {"type": "subtitle", "time": 19958.31, "timestamp": "05:32:38", "text": "ええと、パレードの華やかさですね。"}, {"type": "subtitle", "time": 19962.39, "timestamp": "05:32:42", "text": "これは何ですか？ さらに、復活劇が1つ。"}]
[{"type": "subtitle", "time": 10741.59, "timestamp": "02:59:01", "text": "うん。 うん。 はい。 殺す。"}, {"type": "subtitle", "time": 10753.349, "timestamp": "02:59:13", "text": "ええ、"}, {"type": "subtitle", "time": 10757.178, "timestamp": "02:59:17", "text": "私はあなたに真正面から向き合っています。 撃ってよ、"}, {"type": "subtitle", "time": 10757.75, "timestamp": "02:59:17", "text": "[笑い]"}, {"type": "subtitle", "time": 10759.67, "timestamp": "02:59:19", "text": "おい。"}, {"type": "subtitle", "time": 10762.79, "timestamp": "02:59:22", "text": "どうして弾が外れるのか？"}, {"type": "subtitle", "time": 10766.87, "timestamp": "02:59:26", "text": "私はあなたの鼻の中にいます。 何てことだ。 え、"}, {"type": "subtitle", "time": 10778.55, "timestamp": "02:59:38", "text": "ネットワーク。 冗談でしょう？"}, {"type": "subtitle", "time": 10780.07, "timestamp": "02:59:40", "text": "冗談でしょ？ よし、"}, {"type": "subtitle", "time": 10782.71, "timestamp": "02:59:42", "text": "ゲームはこう言うんだ、いや、ジョー、"}, {"type": "subtitle", "time": 10789.75, "timestamp": "02:59:49", "text": "DNAに集中しなきゃ。 わかった、いいよ。 私はDNAに焦点を当てます。"}, {"type": "subtitle", "time": 10793.03, "timestamp": "02:59:53", "text": "このゲームが"}, {"type": "subtitle", "time": 10796.79, "timestamp": "02:59:56", "text": "このカテゴリを好むという大胆さは狂気じみている。   わかった"}]
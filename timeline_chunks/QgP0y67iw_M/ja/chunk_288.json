[{"type": "subtitle", "time": 17291.27, "timestamp": "04:48:11", "text": "よし、見てみよう。 箱を読んでください。"}, {"type": "subtitle", "time": 17310.948, "timestamp": "04:48:30", "text": "月を運ぶ枝。 あ、待って。"}, {"type": "subtitle", "time": 17312.948, "timestamp": "04:48:32", "text": "支店。 支店。 支店。"}, {"type": "subtitle", "time": 17320.31, "timestamp": "04:48:40", "text": "1つあります。"}, {"type": "subtitle", "time": 17323.11, "timestamp": "04:48:43", "text": "蜂起前夜。"}, {"type": "subtitle", "time": 17326.708, "timestamp": "04:48:46", "text": "待って。 反乱のエヴァ。 終わりました。 どこ"}, {"type": "subtitle", "time": 17329.75, "timestamp": "04:48:49", "text": "ですか？"}, {"type": "subtitle", "time": 17333.35, "timestamp": "04:48:53", "text": "エヴァの反乱。 反乱のエヴァ。 ああ、これだ"}, {"type": "subtitle", "time": 17335.67, "timestamp": "04:48:55", "text": "。"}]
[{"type": "subtitle", "time": 5177.91, "timestamp": "01:26:17", "text": "それは消え去ることはないだろう。"}, {"type": "subtitle", "time": 5180.629, "timestamp": "01:26:20", "text": "何人かの叔母さんと話さなきゃ。 なんてこった。"}, {"type": "subtitle", "time": 5199.51, "timestamp": "01:26:39", "text": "この地図も何の意味もないと思う。"}, {"type": "subtitle", "time": 5205.91, "timestamp": "01:26:45", "text": "テレポートのアニメーションが好きです。 まるで"}, {"type": "subtitle", "time": 5209.35, "timestamp": "01:26:49", "text": "自分がスーパーマンになったみたいだ。 私は上昇し"}, {"type": "subtitle", "time": 5212.07, "timestamp": "01:26:52", "text": "たり下降したりしている。  [笑い声]"}]
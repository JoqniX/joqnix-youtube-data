[{"type": "subtitle", "time": 15420.159, "timestamp": "04:17:00", "text": "こんにちは。 あなたたちを探していました。   それから"}, {"type": "subtitle", "time": 15423.439, "timestamp": "04:17:03", "text": "あなたたちを探していました。   それから 、私も水を飲んでいますし、"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "待って、なんで子供たちが"}, {"type": "subtitle", "time": 15465.67, "timestamp": "04:17:45", "text": "屋上にいるの？ こんにちは。 大丈夫ですか？"}, {"type": "subtitle", "time": 15468.55, "timestamp": "04:17:48", "text": "そこには何もありませんでした。"}, {"type": "subtitle", "time": 15471.51, "timestamp": "04:17:51", "text": "なぜここにいるのですか？ それで、"}, {"type": "subtitle", "time": 15474.229, "timestamp": "04:17:54", "text": "妹さんと一緒にここで何をしているんですか？"}, {"type": "subtitle", "time": 15476.389, "timestamp": "04:17:56", "text": "これはまずい。"}]
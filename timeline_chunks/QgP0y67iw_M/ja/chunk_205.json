[{"type": "subtitle", "time": 12308.55, "timestamp": "03:25:08", "text": "プライム・セレニティはどこにありますか？"}, {"type": "subtitle", "time": 12315.429, "timestamp": "03:25:15", "text": "最高の静寂。   そうでは"}, {"type": "subtitle", "time": 12318.87, "timestamp": "03:25:18", "text": "ないのですか？ そうそう。 これは、"}, {"type": "subtitle", "time": 12322.63, "timestamp": "03:25:22", "text": "えっと、探し出す。 誰が追われているのか？ 私は"}, {"type": "subtitle", "time": 12327.11, "timestamp": "03:25:27", "text": "これを望んでいない。 プライムセレニティを置きます。"}, {"type": "subtitle", "time": 12329.51, "timestamp": "03:25:29", "text": "ええ、見てください。 水害による被害はさらに増加し​​ている。"}, {"type": "subtitle", "time": 12332.469, "timestamp": "03:25:32", "text": "うん、平穏の方がいいよね。"}, {"type": "subtitle", "time": 12338.469, "timestamp": "03:25:38", "text": "良い。 わかった。 ああ、彼女をアップグレードできるよ。 わーい。"}, {"type": "subtitle", "time": 12347.91, "timestamp": "03:25:47", "text": "、いいよ。   あとどれくらい"}, {"type": "subtitle", "time": 12352.95, "timestamp": "03:25:52", "text": "？ そのうち2つ。   かなりの"}]
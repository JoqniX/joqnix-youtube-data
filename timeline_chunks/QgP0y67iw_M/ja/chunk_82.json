[{"type": "subtitle", "time": 4923.59, "timestamp": "01:22:03", "text": "ドヴィン、君は僕に電話したいの？それとも僕が"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "はい、こちらは正午です。 では、ここに行って"}, {"type": "subtitle", "time": 4938.709, "timestamp": "01:22:18", "text": "ゼニモンの出現場所を確認しましょう。"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "それで、私は今どのマップにいるんでしたっけ？ ええと、Lガラ。"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "待って、私はガラに所属してるんだよね？"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "私はロナにいます。 よし、"}, {"type": "subtitle", "time": 4952.79, "timestamp": "01:22:32", "text": "今日はこの場所をくまなく調べて、何か持っているものがないか確認してみよう"}, {"type": "subtitle", "time": 4971.59, "timestamp": "01:22:51", "text": "このカテゴリとこのカテゴリを非表示にします。"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "よし、私たちはここにいる。"}]
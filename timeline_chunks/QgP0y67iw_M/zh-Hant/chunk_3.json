[{"type": "subtitle", "time": 187.11, "timestamp": "00:03:07", "text": "你們最近怎麼樣？大家最近怎麼樣"}, {"type": "subtitle", "time": 190.55, "timestamp": "00:03:10", "text": "？所以，今天我們要挑戰"}, {"type": "subtitle", "time": 193.35, "timestamp": "00:03:13", "text": "夜之深淵。我今天直播的時間"}, {"type": "subtitle", "time": 202.47, "timestamp": "00:03:22", "text": "我今天比平常提早一點開始直播"}, {"type": "subtitle", "time": 206.47, "timestamp": "00:03:26", "text": "。就是這樣。"}, {"type": "subtitle", "time": 209.43, "timestamp": "00:03:29", "text": "嗯，我找不到。詭異的。真奇怪。"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "我"}, {"type": "subtitle", "time": 215.43, "timestamp": "00:03:35", "text": "找不到。"}, {"type": "subtitle", "time": 217.67000000000002, "timestamp": "00:03:37", "text": "我查了一下。"}, {"type": "subtitle", "time": 221.91, "timestamp": "00:03:41", "text": "讓我看看我的另一個帳戶。"}, {"type": "subtitle", "time": 225.75, "timestamp": "00:03:45", "text": "嗯？ OBS 的"}, {"type": "subtitle", "time": 229.91, "timestamp": "00:03:49", "text": "音量調整功能到底在哪裡？啊，明白了。知道了。"}, {"type": "subtitle", "time": 232.07, "timestamp": "00:03:52", "text": "我把它抄下來，放在浴室裡某個"}, {"type": "subtitle", "time": 236.07, "timestamp": "00:03:56", "text": "地方，這樣我就能記住了。"}, {"type": "subtitle", "time": 238.309, "timestamp": "00:03:58", "text": "呃，"}]
[{"type": "subtitle", "time": 919.91, "timestamp": "00:15:19", "text": "三。"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "Tibeta現在要升到60級了。"}, {"type": "subtitle", "time": 930.55, "timestamp": "00:15:30", "text": "問題是，"}, {"type": "subtitle", "time": 936.23, "timestamp": "00:15:36", "text": "僅僅因為我使用了她，她就會升級嗎？"}, {"type": "subtitle", "time": 939.59, "timestamp": "00:15:39", "text": "我想確認一下。  不過"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "我覺得她可能"}]
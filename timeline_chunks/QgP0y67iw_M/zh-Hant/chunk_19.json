[{"type": "subtitle", "time": 1181.51, "timestamp": "00:19:41", "text": "三號玩家。我知道。二號玩家。進來吧"}, {"type": "subtitle", "time": 1191.35, "timestamp": "00:19:51", "text": "我覺得它落後太多了。"}, {"type": "subtitle", "time": 1193.83, "timestamp": "00:19:53", "text": "我們大概會被傳送"}, {"type": "subtitle", "time": 1195.669, "timestamp": "00:19:55", "text": "得很慢。"}, {"type": "subtitle", "time": 1198.15, "timestamp": "00:19:58", "text": "看看我們。我們現在速度非常快。看看"}, {"type": "subtitle", "time": 1199.83, "timestamp": "00:19:59", "text": "我們。"}]
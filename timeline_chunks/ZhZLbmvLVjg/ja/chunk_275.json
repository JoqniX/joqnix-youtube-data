[{"type": "subtitle", "time": 16502.15, "timestamp": "04:35:02", "text": "翌日何をすべきか"}, {"type": "subtitle", "time": 16504.91, "timestamp": "04:35:04", "text": "深いところはない"}, {"type": "subtitle", "time": 16508.15, "timestamp": "04:35:08", "text": "考え。頭が痛い。私も。私"}, {"type": "subtitle", "time": 16511.67, "timestamp": "04:35:11", "text": "タイガーバムのように適用され、斧も"}, {"type": "subtitle", "time": 16513.429, "timestamp": "04:35:13", "text": "石油のことだよ、一緒に"}, {"type": "subtitle", "time": 16516.629, "timestamp": "04:35:16", "text": "額と首と"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "すべて。偏頭痛がひどくなってきた"}, {"type": "subtitle", "time": 16523.67, "timestamp": "04:35:23", "text": "今日は2時間くらいしか寝なかったから。えっと、私は"}, {"type": "subtitle", "time": 16527.07, "timestamp": "04:35:27", "text": "昨日は一晩中起きて"}, {"type": "subtitle", "time": 16530.789, "timestamp": "04:35:30", "text": "招待状リスト。ああ、なんてことだ。私はしません"}, {"type": "subtitle", "time": 16532.15, "timestamp": "04:35:32", "text": "知る。"}, {"type": "subtitle", "time": 16535.189, "timestamp": "04:35:35", "text": "なんだか、いや、ちょっと気まずい感じだった"}, {"type": "subtitle", "time": 16537.109, "timestamp": "04:35:37", "text": "奇妙な理由で、まるで私がやったかのように感じた"}, {"type": "subtitle", "time": 16539.99, "timestamp": "04:35:39", "text": "12時間配信を2回とか、"}, {"type": "subtitle", "time": 16541.31, "timestamp": "04:35:41", "text": "24時間"}, {"type": "subtitle", "time": 16544.551, "timestamp": "04:35:44", "text": "ストリーム。似たような感覚で"}, {"type": "subtitle", "time": 16547.551, "timestamp": "04:35:47", "text": "体が動きたがらない"}, {"type": "subtitle", "time": 16551.269, "timestamp": "04:35:51", "text": "一瞬。ああ、ちょっと心配だったんです。"}, {"type": "subtitle", "time": 16552.91, "timestamp": "04:35:52", "text": "H"}, {"type": "subtitle", "time": 16556.07, "timestamp": "04:35:56", "text": "面白い。しばらくぶり"}, {"type": "subtitle", "time": 16559.109, "timestamp": "04:35:59", "text": "ああ、そんな感じだった。 TWは"}]
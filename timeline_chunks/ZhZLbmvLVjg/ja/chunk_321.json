[{"type": "subtitle", "time": 19261.23, "timestamp": "05:21:01", "text": "[音楽]"}, {"type": "subtitle", "time": 19264.03, "timestamp": "05:21:04", "text": "これ"}, {"type": "subtitle", "time": 19266.59, "timestamp": "05:21:06", "text": "幽霊のチョークを覗く"}, {"type": "subtitle", "time": 19271.39, "timestamp": "05:21:11", "text": "アーク。幽霊のような幽霊を想像してみてください"}, {"type": "subtitle", "time": 19273.51, "timestamp": "05:21:13", "text": "星座。それはとても良いですね。"}, {"type": "subtitle", "time": 19274.99, "timestamp": "05:21:14", "text": "それはまさに"}, {"type": "subtitle", "time": 19279.99, "timestamp": "05:21:19", "text": "良い。わかりました、ちょっとこれをやらせてください。"}, {"type": "subtitle", "time": 19282.788, "timestamp": "05:21:22", "text": "あのね？もし私が好きなら"}, {"type": "subtitle", "time": 19287.59, "timestamp": "05:21:27", "text": "他のことに集中するから、私はもう"}, {"type": "subtitle", "time": 19290.07, "timestamp": "05:21:30", "text": "配信に全力を注ぎます。私はとても"}, {"type": "subtitle", "time": 19293.43, "timestamp": "05:21:33", "text": "もちろん。いろいろなことが起こっていて、"}, {"type": "subtitle", "time": 19297.99, "timestamp": "05:21:37", "text": "他の場所では、「ああ、大変だ」と思いました。"}, {"type": "subtitle", "time": 19299.75, "timestamp": "05:21:39", "text": "時々、本当にそうできたらいいのにと思う"}, {"type": "subtitle", "time": 19303.15, "timestamp": "05:21:43", "text": "えっと"}, {"type": "subtitle", "time": 19307.27, "timestamp": "05:21:47", "text": "ああ、いつか、ああ、今閉じたのか"}, {"type": "subtitle", "time": 19311.11, "timestamp": "05:21:51", "text": "読書ウェブサイト"}, {"type": "subtitle", "time": 19313.35, "timestamp": "05:21:53", "text": "皆さんはどのストーリーを選びますか？"}, {"type": "subtitle", "time": 19315.19, "timestamp": "05:21:55", "text": "したい"}, {"type": "subtitle", "time": 19317.35, "timestamp": "05:21:57", "text": "えっと、皆さんはどれが一番快適ですか？"}]
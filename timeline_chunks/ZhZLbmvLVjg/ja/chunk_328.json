[{"type": "subtitle", "time": 19680.948, "timestamp": "05:28:00", "text": "物理的な。それは彼の過去の出来事だった。そしていいえ"}, {"type": "subtitle", "time": 19683.35, "timestamp": "05:28:03", "text": "彼がどれだけ速く運転していても、"}, {"type": "subtitle", "time": 19685.948, "timestamp": "05:28:05", "text": "そこから抜け出すことはできなかった。"}, {"type": "subtitle", "time": 19689.708, "timestamp": "05:28:09", "text": "罪悪感は危険だ"}, {"type": "subtitle", "time": 19695.07, "timestamp": "05:28:15", "text": "フィーリング。それはしばらくの間彼を苦しめていた"}, {"type": "subtitle", "time": 19699.47, "timestamp": "05:28:19", "text": "年。それで彼は運転していた"}, {"type": "subtitle", "time": 19702.868, "timestamp": "05:28:22", "text": "大都市から離れた場所。彼はいくつか必要だった"}, {"type": "subtitle", "time": 19707.31, "timestamp": "05:28:27", "text": "ホルンを吹く時間。 Vの状態"}, {"type": "subtitle", "time": 19709.43, "timestamp": "05:28:29", "text": "ウィスコンシン州は優れた"}, {"type": "subtitle", "time": 19711.99, "timestamp": "05:28:31", "text": "彼にとっての選択だ。ジェイクの亡くなった両親は"}, {"type": "subtitle", "time": 19715.59, "timestamp": "05:28:35", "text": "森の中ではないどこかにある小屋。彼"}, {"type": "subtitle", "time": 19717.59, "timestamp": "05:28:37", "text": "その方向に向かっていた"}, {"type": "subtitle", "time": 19720.11, "timestamp": "05:28:40", "text": "数時間逃走するために"}, {"type": "subtitle", "time": 19724.23, "timestamp": "05:28:44", "text": "日。眠気が彼を襲った。"}, {"type": "subtitle", "time": 19728.15, "timestamp": "05:28:48", "text": "そして彼は集中するのが難しかった"}, {"type": "subtitle", "time": 19730.708, "timestamp": "05:28:50", "text": "道路。彼は何時間も運転していた"}, {"type": "subtitle", "time": 19734.948, "timestamp": "05:28:54", "text": "今。運転も彼の好きなことの一つだった。"}, {"type": "subtitle", "time": 19738.83, "timestamp": "05:28:58", "text": "長い恋愛物語。長い道は彼の"}]
[{"type": "subtitle", "time": 1760.909, "timestamp": "00:29:20", "text": "神。ああ、大変だ。何てことだ。"}, {"type": "subtitle", "time": 1764.63, "timestamp": "00:29:24", "text": "わーい。ヤバイ。何てことだ。"}, {"type": "subtitle", "time": 1766.95, "timestamp": "00:29:26", "text": "よし、ついに到着した。何かありますか？"}, {"type": "subtitle", "time": 1773.19, "timestamp": "00:29:33", "text": "必要？でも待って、どうやって降りて"}, {"type": "subtitle", "time": 1776.549, "timestamp": "00:29:36", "text": "トップにいるあの男の鍵は？うん。"}, {"type": "subtitle", "time": 1783.789, "timestamp": "00:29:43", "text": "何をしているの？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 1788.549, "timestamp": "00:29:48", "text": "良い。よし、じゃあここに行こう。飛び降りてもいいですか？"}, {"type": "subtitle", "time": 1790.149, "timestamp": "00:29:50", "text": "いいえ。"}, {"type": "subtitle", "time": 1790.52, "timestamp": "00:29:50", "text": "そして"}, {"type": "subtitle", "time": 1792.909, "timestamp": "00:29:52", "text": "[音楽]"}]
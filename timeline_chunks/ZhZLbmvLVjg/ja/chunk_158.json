[{"type": "subtitle", "time": 9488.27, "timestamp": "02:38:08", "text": "ともかく。うん。さよなら。はぁ。それで、"}, {"type": "subtitle", "time": 9491.55, "timestamp": "02:38:11", "text": "えっと、これは"}, {"type": "subtitle", "time": 9494.27, "timestamp": "02:38:14", "text": "あれ。だから私たちは"}, {"type": "subtitle", "time": 9498.99, "timestamp": "02:38:18", "text": "最初の記憶のものが"}, {"type": "subtitle", "time": 9503.349, "timestamp": "02:38:23", "text": "ここ。えーと、1つ、2つ、"}, {"type": "subtitle", "time": 9513.87, "timestamp": "02:38:33", "text": "待って"}, {"type": "subtitle", "time": 9517.19, "timestamp": "02:38:37", "text": "分。ちょっと待って。それはあなたに示します"}, {"type": "subtitle", "time": 9524.11, "timestamp": "02:38:44", "text": "は。それはまさに"}, {"type": "subtitle", "time": 9527.07, "timestamp": "02:38:47", "text": "いいね。それは本棚の中にあります"}, {"type": "subtitle", "time": 9529.79, "timestamp": "02:38:49", "text": "あれ。我々はそれを手に入れた"}, {"type": "subtitle", "time": 9532.71, "timestamp": "02:38:52", "text": "実は。これは、待って、私は知っています"}, {"type": "subtitle", "time": 9534.87, "timestamp": "02:38:54", "text": "場所。私はその場所を知っています。待って、待って、"}]
[{"type": "subtitle", "time": 3182.15, "timestamp": "00:53:02", "text": "どのアニメか何かを忘れたような設定"}, {"type": "subtitle", "time": 3185.829, "timestamp": "00:53:05", "text": "そこにあったアニメシリーズ。だから、"}, {"type": "subtitle", "time": 3190.39, "timestamp": "00:53:10", "text": "空高くには高貴な人々が住んでいる"}, {"type": "subtitle", "time": 3193.349, "timestamp": "00:53:13", "text": "ええと、高貴な人々、金持ちの人々は"}, {"type": "subtitle", "time": 3195.99, "timestamp": "00:53:15", "text": "地下のスラム街に住む人々は"}, {"type": "subtitle", "time": 3197.39, "timestamp": "00:53:17", "text": "貧しい"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "住んでいて、好き"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "ああ、どのアニメだったか忘れちゃった。"}, {"type": "subtitle", "time": 3207.03, "timestamp": "00:53:27", "text": "それは「銃がなければ人生もない」ということでしょうか？わからない。"}, {"type": "subtitle", "time": 3209.549, "timestamp": "00:53:29", "text": "銃規制がなかったように感じる"}, {"type": "subtitle", "time": 3213.349, "timestamp": "00:53:33", "text": "人生。それは全く別物だった。どのアニメ"}]
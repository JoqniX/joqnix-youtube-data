[{"type": "subtitle", "time": 4562.669, "timestamp": "01:16:02", "text": "いいえ。私はこの電子音が大好きです"}, {"type": "subtitle", "time": 4564.41, "timestamp": "01:16:04", "text": "音楽。それで"}, {"type": "subtitle", "time": 4566.27, "timestamp": "01:16:06", "text": "[音楽]"}, {"type": "subtitle", "time": 4582.79, "timestamp": "01:16:22", "text": "地下鉄。魔法が私の助けになってくれなかった"}, {"type": "subtitle", "time": 4585.669, "timestamp": "01:16:25", "text": "案件。あなたは何も得られませんでした。おお、"}, {"type": "subtitle", "time": 4588.669, "timestamp": "01:16:28", "text": "私には希望がある。私たちは"}, {"type": "subtitle", "time": 4591.55, "timestamp": "01:16:31", "text": "希望。ええ、そう願っています。我々は持っています"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "希望。私は予約しません。それは"}, {"type": "subtitle", "time": 4596.07, "timestamp": "01:16:36", "text": "大丈夫。"}, {"type": "subtitle", "time": 4599.709, "timestamp": "01:16:39", "text": "私たちは"}, {"type": "subtitle", "time": 4606.47, "timestamp": "01:16:46", "text": "うん。何が起ころうとも"}, {"type": "subtitle", "time": 4610.35, "timestamp": "01:16:50", "text": "何が起こるのか？うん。ええ、私たちは続けます"}, {"type": "subtitle", "time": 4619.63, "timestamp": "01:16:59", "text": "何でも。それが彼が"}]
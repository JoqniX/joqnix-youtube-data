[{"type": "subtitle", "time": 5230.189, "timestamp": "01:27:10", "text": "ここ。何てことだ。私を置いて死なないで。"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "わかった、ぶん殴ってやるよ。来なくちゃ"}, {"type": "subtitle", "time": 5245.709, "timestamp": "01:27:25", "text": "いいえ。彼はボックスを通り抜けて、"}, {"type": "subtitle", "time": 5248.87, "timestamp": "01:27:28", "text": "できません。いいえ。"}, {"type": "subtitle", "time": 5266.75, "timestamp": "01:27:46", "text": "私は、力が獲得することを知っていた"}, {"type": "subtitle", "time": 5270.91, "timestamp": "01:27:50", "text": "ソル。はぁ？すぐにでも"}, {"type": "subtitle", "time": 5273.87, "timestamp": "01:27:53", "text": "これを受け取って。"}, {"type": "subtitle", "time": 5275.79, "timestamp": "01:27:55", "text": "はぁ？"}]
[{"type": "subtitle", "time": 8041.109, "timestamp": "02:14:01", "text": "私はそれを使わないように正気を失ってしまった"}, {"type": "subtitle", "time": 8042.83, "timestamp": "02:14:02", "text": "アラームのように"}, {"type": "subtitle", "time": 8047.069, "timestamp": "02:14:07", "text": "アスマの声のように、あるいは"}, {"type": "subtitle", "time": 8065.47, "timestamp": "02:14:25", "text": "ダーリン、目を覚ませ"}, {"type": "subtitle", "time": 8068.91, "timestamp": "02:14:28", "text": "ウェイキーはここで恋しい。"}, {"type": "subtitle", "time": 8097.03, "timestamp": "02:14:57", "text": "アラームとは違うんです。まるで"}, {"type": "subtitle", "time": 8099.79, "timestamp": "02:14:59", "text": "ただの音声"}]
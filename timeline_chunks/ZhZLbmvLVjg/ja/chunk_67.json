[{"type": "subtitle", "time": 4020.23, "timestamp": "01:07:00", "text": "再起動しました。彼は元気ですか？目的は何ですか？"}, {"type": "subtitle", "time": 4023.43, "timestamp": "01:07:03", "text": "どうしてそんなに射撃が上手なの？"}, {"type": "subtitle", "time": 4033.75, "timestamp": "01:07:13", "text": "良い？もっと良いアドバイスとしては、彼の真下には行かないことです。"}, {"type": "subtitle", "time": 4036.24, "timestamp": "01:07:16", "text": "このゴーストプレートと"}, {"type": "subtitle", "time": 4046.03, "timestamp": "01:07:26", "text": "回避する。"}, {"type": "subtitle", "time": 4053.549, "timestamp": "01:07:33", "text": "バイバイ。こんにちは。ここに来て。来る"}, {"type": "subtitle", "time": 4071.47, "timestamp": "01:07:51", "text": "今。わかった。ああ、これ覚えてる"}]
[{"type": "subtitle", "time": 16560.789, "timestamp": "04:36:00", "text": "ストリームはTwitchのみで行われていました。"}, {"type": "subtitle", "time": 16564.429, "timestamp": "04:36:04", "text": "Discordバナー。何てことだ。また。それは"}, {"type": "subtitle", "time": 16567.51, "timestamp": "04:36:07", "text": "壊れた？それは命令です。バックエンド。"}, {"type": "subtitle", "time": 16569.39, "timestamp": "04:36:09", "text": "後ろ側です"}, {"type": "subtitle", "time": 16572.23, "timestamp": "04:36:12", "text": "終わり。なぜいつもこうなのかわからない"}, {"type": "subtitle", "time": 16575.31, "timestamp": "04:36:15", "text": "リセットまたは何か"}, {"type": "subtitle", "time": 16577.72, "timestamp": "04:36:17", "text": "目的。種の"}, {"type": "subtitle", "time": 16580.83, "timestamp": "04:36:20", "text": "[音楽]"}, {"type": "subtitle", "time": 16583.83, "timestamp": "04:36:23", "text": "奇妙な。ええ、このガキは実際には"}, {"type": "subtitle", "time": 16591.869, "timestamp": "04:36:31", "text": "何？毎回修正しなければならない"}, {"type": "subtitle", "time": 16594.029, "timestamp": "04:36:34", "text": "ナノアイ。"}, {"type": "subtitle", "time": 16597.31, "timestamp": "04:36:37", "text": "おお。まるで私みたいに"}, {"type": "subtitle", "time": 16600.109, "timestamp": "04:36:40", "text": "これを繰り返し行う"}, {"type": "subtitle", "time": 16603.109, "timestamp": "04:36:43", "text": "最近では繰り返し行わなければならない"}, {"type": "subtitle", "time": 16606.949, "timestamp": "04:36:46", "text": "コマンドを下に移動して"}, {"type": "subtitle", "time": 16608.029, "timestamp": "04:36:48", "text": "それ"}, {"type": "subtitle", "time": 16610.709, "timestamp": "04:36:50", "text": "別れた。よし、これで大丈夫だろう。"}, {"type": "subtitle", "time": 16613.269, "timestamp": "04:36:53", "text": "これで、sim のように表示されるはずです"}, {"type": "subtitle", "time": 16617.23, "timestamp": "04:36:57", "text": "Twitterでのシマルキャスティングなど全て"}]
[{"type": "subtitle", "time": 12007.15, "timestamp": "03:20:07", "text": "えっと、私は"}, {"type": "subtitle", "time": 12033.15, "timestamp": "03:20:33", "text": "きちんとした。膝に聞いてみましょう、閉じています"}, {"type": "subtitle", "time": 12052.71, "timestamp": "03:20:52", "text": "もしかしたら、私は進歩する必要があるのか​​もしれない。あのね？"}, {"type": "subtitle", "time": 12054.51, "timestamp": "03:20:54", "text": "私たちはこの場所にまた戻ってきます"}, {"type": "subtitle", "time": 12058.07, "timestamp": "03:20:58", "text": "またか、そうだろ？クラブに行くために。"}]
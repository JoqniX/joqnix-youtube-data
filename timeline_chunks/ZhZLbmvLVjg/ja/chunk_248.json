[{"type": "subtitle", "time": 14881.11, "timestamp": "04:08:01", "text": "あなたのストリームで。ねえ、私は信じてる"}, {"type": "subtitle", "time": 14883.63, "timestamp": "04:08:03", "text": "今日は休憩日です"}, {"type": "subtitle", "time": 14886.55, "timestamp": "04:08:06", "text": "あなた。ええ、あなたにとっては休憩時間ですよね？"}, {"type": "subtitle", "time": 14889.03, "timestamp": "04:08:09", "text": "ええ、休憩ですね。では、今日は何"}, {"type": "subtitle", "time": 14892.229, "timestamp": "04:08:12", "text": "また？今日は木曜日です。ええ、今日の"}, {"type": "subtitle", "time": 14894.83, "timestamp": "04:08:14", "text": "木曜日。こんにちは。楽しい"}, {"type": "subtitle", "time": 14898.15, "timestamp": "04:08:18", "text": "昨日の配信の休憩は楽しかった。"}, {"type": "subtitle", "time": 14908.71, "timestamp": "04:08:28", "text": "だから、施錠用のロッカーはすべて"}, {"type": "subtitle", "time": 14911.67, "timestamp": "04:08:31", "text": "ストリームと世界中の視聴者"}, {"type": "subtitle", "time": 14913.59, "timestamp": "04:08:33", "text": "この時計を振り返ってみて。ありがとうございます"}, {"type": "subtitle", "time": 14917.11, "timestamp": "04:08:37", "text": "見ている。それは本当に大きな意味があります。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 14920.269, "timestamp": "04:08:40", "text": "それではまた次回お会いしましょう"}, {"type": "subtitle", "time": 14923.51, "timestamp": "04:08:43", "text": "1つは、私が「えーと、いくつか直している」と言うでしょう"}, {"type": "subtitle", "time": 14928.07, "timestamp": "04:08:48", "text": "主にYouTube向けのコンテンツを少しずつ投稿しています。"}, {"type": "subtitle", "time": 14929.83, "timestamp": "04:08:49", "text": "ポイントシステムを導入したかった"}, {"type": "subtitle", "time": 14931.389, "timestamp": "04:08:51", "text": "戻る"}, {"type": "subtitle", "time": 14934.07, "timestamp": "04:08:54", "text": "前回の配信で話した内容と"}, {"type": "subtitle", "time": 14936.79, "timestamp": "04:08:56", "text": "今日の配信。だから、私はこう尋ねるつもりです"}, {"type": "subtitle", "time": 14939.91, "timestamp": "04:08:59", "text": "周囲をうまく回り、うまく機能させる。わかった。だから、あなたは"}]
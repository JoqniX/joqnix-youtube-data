[{"type": "subtitle", "time": 18841.37, "timestamp": "05:14:01", "text": "誕生日。ハッピー"}, {"type": "subtitle", "time": 18845.47, "timestamp": "05:14:05", "text": "[音楽]"}, {"type": "subtitle", "time": 18847.868, "timestamp": "05:14:07", "text": "誕生日。即興で"}, {"type": "subtitle", "time": 18854.26, "timestamp": "05:14:14", "text": "ああ、そう"}, {"type": "subtitle", "time": 18855.868, "timestamp": "05:14:15", "text": "[音楽]"}, {"type": "subtitle", "time": 18858.83, "timestamp": "05:14:18", "text": "だから私は私だ"}, {"type": "subtitle", "time": 18861.868, "timestamp": "05:14:21", "text": "願うのは、あなたが知っているように"}, {"type": "subtitle", "time": 18863.42, "timestamp": "05:14:23", "text": "星座 I"}, {"type": "subtitle", "time": 18871.07, "timestamp": "05:14:31", "text": "星座のように私はそうするだろう。なぜ"}, {"type": "subtitle", "time": 18874.23, "timestamp": "05:14:34", "text": "ない？私は"}, {"type": "subtitle", "time": 18877.03, "timestamp": "05:14:37", "text": "星座 私はその力を受け入れるのが好きです"}, {"type": "subtitle", "time": 18880.55, "timestamp": "05:14:40", "text": "星々の右。そうですね、私は"}, {"type": "subtitle", "time": 18884.03, "timestamp": "05:14:44", "text": "あなたに幸せと幸せを与えるために"}, {"type": "subtitle", "time": 18887.91, "timestamp": "05:14:47", "text": "瞬間。幸せそうな笑顔。ワクウォーク"}, {"type": "subtitle", "time": 18890.27, "timestamp": "05:14:50", "text": "幸せ。"}]
[{"type": "subtitle", "time": 6782.589, "timestamp": "01:53:02", "text": "リマインダーやバグがあれば入力してください"}, {"type": "subtitle", "time": 6785.35, "timestamp": "01:53:05", "text": "そのコマンドでチャットしましょう。それから"}, {"type": "subtitle", "time": 6787.03, "timestamp": "01:53:07", "text": "コマンドはDiscordで送信されます"}, {"type": "subtitle", "time": 6790.149, "timestamp": "01:53:10", "text": "サーバーと私へのプライベートメッセージとして"}, {"type": "subtitle", "time": 6793.669, "timestamp": "01:53:13", "text": "ああ、そうだな、覚えてるよ"}, {"type": "subtitle", "time": 6795.83, "timestamp": "01:53:15", "text": "チャットで誰かがこれをするように言って、"}, {"type": "subtitle", "time": 6797.75, "timestamp": "01:53:17", "text": "それ"}, {"type": "subtitle", "time": 6801.31, "timestamp": "01:53:21", "text": "などなど、わかりました、私は"}, {"type": "subtitle", "time": 6804.189, "timestamp": "01:53:24", "text": "忘れて、それが私を助けてくれる"}, {"type": "subtitle", "time": 6807.87, "timestamp": "01:53:27", "text": "たくさんの良いもの"}, {"type": "subtitle", "time": 6810.83, "timestamp": "01:53:30", "text": "知っていれば追いつく"}, {"type": "subtitle", "time": 6814.87, "timestamp": "01:53:34", "text": "えーと、ソフトウェアにはたくさんの"}, {"type": "subtitle", "time": 6817.109, "timestamp": "01:53:37", "text": "異なる定義。マイナス"}, {"type": "subtitle", "time": 6819.47, "timestamp": "01:53:39", "text": "Fボーイに似ているが、"}, {"type": "subtitle", "time": 6822.709, "timestamp": "01:53:42", "text": "傲慢な態度。 Fボーイは体を求める"}, {"type": "subtitle", "time": 6826.709, "timestamp": "01:53:46", "text": "しかし、優しい男の子は感情に流される。私にとって柔らかい"}, {"type": "subtitle", "time": 6829.189, "timestamp": "01:53:49", "text": "男の子はより優しく従順な男性です"}, {"type": "subtitle", "time": 6832.189, "timestamp": "01:53:52", "text": "魅力的なペルソナ"}, {"type": "subtitle", "time": 6835.229, "timestamp": "01:53:55", "text": "女性的な視線。"}]
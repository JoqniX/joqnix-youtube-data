[{"type": "subtitle", "time": 17942.868, "timestamp": "04:59:02", "text": "あ、待って。何？待って。なぜみんなの"}, {"type": "subtitle", "time": 17945.35, "timestamp": "04:59:05", "text": "ユーザー名が質問ですか？感嘆"}, {"type": "subtitle", "time": 17948.19, "timestamp": "04:59:08", "text": "マーク。はぁ？"}, {"type": "subtitle", "time": 17951.708, "timestamp": "04:59:11", "text": "待って。はぁ？何？どうしたの？"}, {"type": "subtitle", "time": 17955.07, "timestamp": "04:59:15", "text": "待って。ああ、私は記録をつけていなかった。"}, {"type": "subtitle", "time": 17960.31, "timestamp": "04:59:20", "text": "ああ、そのログを取ったのは私だけです。ああ、"}, {"type": "subtitle", "time": 17964.07, "timestamp": "04:59:24", "text": "あなたがやったかどうかはわかりません"}, {"type": "subtitle", "time": 17966.708, "timestamp": "04:59:26", "text": "あなた自身。おい、お前は俺が頭が悪いと思ってるのか？"}, {"type": "subtitle", "time": 17968.948, "timestamp": "04:59:28", "text": "私の高度なログインシステムを作るのに十分です"}, {"type": "subtitle", "time": 17972.15, "timestamp": "04:59:32", "text": "Discordで？私は基本バージョンを作成しました。"}, {"type": "subtitle", "time": 17975.19, "timestamp": "04:59:35", "text": "わかったよ、君は私をからかってるんだね。あなた"}, {"type": "subtitle", "time": 17977.99, "timestamp": "04:59:37", "text": "実際にやったんです。何てことだ。あなたも"}, {"type": "subtitle", "time": 17982.27, "timestamp": "04:59:42", "text": "心配になってきた。後ほどご説明します。"}, {"type": "subtitle", "time": 17985.948, "timestamp": "04:59:45", "text": "なぜ？あなたは、"}, {"type": "subtitle", "time": 17990.07, "timestamp": "04:59:50", "text": "ああ、なんてことだ、それは私にとっては恐ろしい。私"}, {"type": "subtitle", "time": 17992.868, "timestamp": "04:59:52", "text": "お互いが見つけ合うことを知っていたような"}, {"type": "subtitle", "time": 17994.31, "timestamp": "04:59:54", "text": "他の人にとってはそれが初めてのことだった。"}, {"type": "subtitle", "time": 17997.708, "timestamp": "04:59:57", "text": "これ。うん。うん。たくさんあります"}, {"type": "subtitle", "time": 17999.99, "timestamp": "04:59:59", "text": "人々は互いを見つけている"}]
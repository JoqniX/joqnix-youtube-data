[{"type": "subtitle", "time": 1500.87, "timestamp": "00:25:00", "text": "夜。そうそう。こんにちは、マッチ。どうやって"}, {"type": "subtitle", "time": 1509.149, "timestamp": "00:25:09", "text": "ここ。とんでもない。いいえ"}, {"type": "subtitle", "time": 1510.99, "timestamp": "00:25:10", "text": "方法。"}, {"type": "subtitle", "time": 1518.39, "timestamp": "00:25:18", "text": "私は2つ見ることができる"}, {"type": "subtitle", "time": 1521.269, "timestamp": "00:25:21", "text": "1日でストリームを再生するのは、"}, {"type": "subtitle", "time": 1524.71, "timestamp": "00:25:24", "text": "なぜならあなたは同じ朝だったから"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "私はもう寝る時間です。そうそう、"}, {"type": "subtitle", "time": 1531.71, "timestamp": "00:25:31", "text": "もう寝る時間ですよね？"}, {"type": "subtitle", "time": 1535.07, "timestamp": "00:25:35", "text": "今。待って、一体何時なの？"}, {"type": "subtitle", "time": 1537.909, "timestamp": "00:25:37", "text": "それ？あ、待って、現在の時刻は"}, {"type": "subtitle", "time": 1541.269, "timestamp": "00:25:41", "text": "何か付いてる？セットアップしたようなものを置いたか"}, {"type": "subtitle", "time": 1543.99, "timestamp": "00:25:43", "text": "現在の時間システム？"}, {"type": "subtitle", "time": 1554.07, "timestamp": "00:25:54", "text": "上。以前はTwitchでやっていましたが、"}, {"type": "subtitle", "time": 1556.63, "timestamp": "00:25:56", "text": "コードを変更しました"}, {"type": "subtitle", "time": 1558.95, "timestamp": "00:25:58", "text": "Streamer を使うには、それを使うことができます。"}]
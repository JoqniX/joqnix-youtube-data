[{"type": "subtitle", "time": 5042.629, "timestamp": "01:24:02", "text": "わかった。こんにちは。さあ、中へ入ろう"}, {"type": "subtitle", "time": 5072.83, "timestamp": "01:24:32", "text": "完了。そしてこれは"}, {"type": "subtitle", "time": 5075.149, "timestamp": "01:24:35", "text": "B. Bは"}, {"type": "subtitle", "time": 5085.79, "timestamp": "01:24:45", "text": "C. そこに"}, {"type": "subtitle", "time": 5089.99, "timestamp": "01:24:49", "text": "行く。よくやった、友よ。こんにちは"}, {"type": "subtitle", "time": 5093.27, "timestamp": "01:24:53", "text": "調子はどうですか？そこで見つけた。私は知っています"}, {"type": "subtitle", "time": 5095.31, "timestamp": "01:24:55", "text": "何か"}]
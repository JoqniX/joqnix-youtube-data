[{"type": "subtitle", "time": 10682.19, "timestamp": "02:58:02", "text": "彼女に、これを持ってくるにはこれをしなければならない"}, {"type": "subtitle", "time": 10693.429, "timestamp": "02:58:13", "text": "それ。私は、私が持っているものがどこにあるか、という感じです。"}, {"type": "subtitle", "time": 10694.19, "timestamp": "02:58:14", "text": "探しています"}, {"type": "subtitle", "time": 10696.83, "timestamp": "02:58:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10700.469, "timestamp": "02:58:20", "text": "のために？よし、見てみよう。ああ、思い出。それで、"}, {"type": "subtitle", "time": 10702.79, "timestamp": "02:58:22", "text": "これこそ私が探していたものです。この場所"}, {"type": "subtitle", "time": 10704.79, "timestamp": "02:58:24", "text": "そちら側。"}, {"type": "subtitle", "time": 10709.59, "timestamp": "02:58:29", "text": "大きな緑がかった青色のネオンサインがある"}, {"type": "subtitle", "time": 10712.389, "timestamp": "02:58:32", "text": "ギターか何かがある。"}, {"type": "subtitle", "time": 10715.59, "timestamp": "02:58:35", "text": "あそこにポスターがあります。わかった。ネオンサインと"}, {"type": "subtitle", "time": 10716.91, "timestamp": "02:58:36", "text": "1"}, {"type": "subtitle", "time": 10720.44, "timestamp": "02:58:40", "text": "ポスター。ネオンサインとポスター。"}]
[{"type": "subtitle", "time": 15440.67, "timestamp": "04:17:20", "text": "私の声は聞こえていますか？はい、私は"}, {"type": "subtitle", "time": 15444.63, "timestamp": "04:17:24", "text": "可聴。ああ、本当に怖かったよ"}, {"type": "subtitle", "time": 15447.229, "timestamp": "04:17:27", "text": "マイクが動いていなかったとき。ああ、"}, {"type": "subtitle", "time": 15450.429, "timestamp": "04:17:30", "text": "神。うん。こんにちは"}, {"type": "subtitle", "time": 15462.469, "timestamp": "04:17:42", "text": "だから、本当に謝罪したいのですが"}, {"type": "subtitle", "time": 15467.03, "timestamp": "04:17:47", "text": "今日の配信は大幅に遅れました。私は最高です"}, {"type": "subtitle", "time": 15470.91, "timestamp": "04:17:50", "text": "本当に本当にごめんなさい。"}, {"type": "subtitle", "time": 15474.83, "timestamp": "04:17:54", "text": "ええ、私はここにいます"}, {"type": "subtitle", "time": 15476.99, "timestamp": "04:17:56", "text": "永遠に。私はここにいます"}]
[{"type": "subtitle", "time": 16860.708, "timestamp": "04:41:00", "text": "この16分間のホラーゲームをプレイしたい"}, {"type": "subtitle", "time": 16863.07, "timestamp": "04:41:03", "text": "リアルで怖いゲーム。"}, {"type": "subtitle", "time": 16867.27, "timestamp": "04:41:07", "text": "スクーピー・スクーピー・クーピー・スクービー・ドゥー"}, {"type": "subtitle", "time": 16877.628, "timestamp": "04:41:17", "text": "幸せです"}, {"type": "subtitle", "time": 16880.55, "timestamp": "04:41:20", "text": "ハロウィン。ああ、待って、実際に"}, {"type": "subtitle", "time": 16883.47, "timestamp": "04:41:23", "text": "入力する、発音する、そのように。"}, {"type": "subtitle", "time": 16886.55, "timestamp": "04:41:26", "text": "アビー・ハロウィン。ああ、それはとても"}, {"type": "subtitle", "time": 16889.91, "timestamp": "04:41:29", "text": "独創的で、とてもかわいい。私はちょうど引っ越しました"}, {"type": "subtitle", "time": 16899.788, "timestamp": "04:41:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16903.27, "timestamp": "04:41:43", "text": "それ。ええ、そうですね。えっと、正直に言うと"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "スケルへようこそ。初めてのことです。"}, {"type": "subtitle", "time": 16915.51, "timestamp": "04:41:55", "text": "右？私の"}, {"type": "subtitle", "time": 16918.628, "timestamp": "04:41:58", "text": "教会のストリーム？初めてですか？"}]
[{"type": "subtitle", "time": 17820.91, "timestamp": "04:57:00", "text": "ホラーASMRロールプレイ動画？"}, {"type": "subtitle", "time": 17825.75, "timestamp": "04:57:05", "text": "何？私が「ああ」と言ったのはいつですか。おお。"}, {"type": "subtitle", "time": 17833.788, "timestamp": "04:57:13", "text": "「ああ、なんてことだ」と言いなさい。私は何をする必要がありますか？"}, {"type": "subtitle", "time": 17841.67, "timestamp": "04:57:21", "text": "何？ホラーロールプレイングゲームってどうやってやるの？"}, {"type": "subtitle", "time": 17845.43, "timestamp": "04:57:25", "text": "ASMRロールプレイング？どうやって？ご存知の通り、私は"}, {"type": "subtitle", "time": 17847.99, "timestamp": "04:57:27", "text": "文字通りホラーが怖くて"}, {"type": "subtitle", "time": 17850.39, "timestamp": "04:57:30", "text": "私は文字通り泣いて叫んで、"}, {"type": "subtitle", "time": 17855.19, "timestamp": "04:57:35", "text": "パニックになる。どうやってやればいいんだろう？"}, {"type": "subtitle", "time": 17863.47, "timestamp": "04:57:43", "text": "RPで、私は怖い女の子です"}, {"type": "subtitle", "time": 17867.708, "timestamp": "04:57:47", "text": "猫。つまり、ヤンデレみたいなことができるってこと"}, {"type": "subtitle", "time": 17872.15, "timestamp": "04:57:52", "text": "いいよ、ヤンドレをもっと良くしてあげられるよ。しかし"}, {"type": "subtitle", "time": 17874.708, "timestamp": "04:57:54", "text": "それはホラーっぽいですか？それはあなたが"}, {"type": "subtitle", "time": 17879.07, "timestamp": "04:57:59", "text": "恐ろしい。しかし、"}]
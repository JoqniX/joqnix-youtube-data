[{"type": "subtitle", "time": 12547.71, "timestamp": "03:29:07", "text": "ランチ。それ"}, {"type": "subtitle", "time": 12551.389, "timestamp": "03:29:11", "text": "場所。なぜ？なぜ私は"}, {"type": "subtitle", "time": 12554.15, "timestamp": "03:29:14", "text": "絶対にない。でも問題は、どうすれば"}, {"type": "subtitle", "time": 12555.389, "timestamp": "03:29:15", "text": "下"}, {"type": "subtitle", "time": 12562.87, "timestamp": "03:29:22", "text": "けれど？もし私がそうしてそれを受け取るなら、"}, {"type": "subtitle", "time": 12569.67, "timestamp": "03:29:29", "text": "右。ああ、目が覚めたらもうそうなってた"}, {"type": "subtitle", "time": 12572.55, "timestamp": "03:29:32", "text": "今すぐ。ああ、いいね、いいね、いいね、いいね。"}, {"type": "subtitle", "time": 12574.75, "timestamp": "03:29:34", "text": "こんにちは。良い、"}, {"type": "subtitle", "time": 12592.55, "timestamp": "03:29:52", "text": "おお。何てことだ。それは私を見た。それは私に見せてくれた。"}]
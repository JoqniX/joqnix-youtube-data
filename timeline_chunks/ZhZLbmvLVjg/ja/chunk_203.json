[{"type": "subtitle", "time": 12213.83, "timestamp": "03:23:33", "text": "ああ、もしかしたらバカールバクは"}, {"type": "subtitle", "time": 12216.07, "timestamp": "03:23:36", "text": "いや、いや、いや。バカロとは言わない方がいい。おお"}, {"type": "subtitle", "time": 12219.269, "timestamp": "03:23:39", "text": "我が神よ。バカロと言わないように注意する"}, {"type": "subtitle", "time": 12221.59, "timestamp": "03:23:41", "text": "これから先は、意味がわかったから。"}, {"type": "subtitle", "time": 12223.389, "timestamp": "03:23:43", "text": "ああ、"}, {"type": "subtitle", "time": 12226.349, "timestamp": "03:23:46", "text": "神。みんな"}]
[{"type": "subtitle", "time": 16801.51, "timestamp": "04:40:01", "text": "いいえ。ああ、なんて可愛いんでしょう。それは"}, {"type": "subtitle", "time": 16804.55, "timestamp": "04:40:04", "text": "私がこの資産を選んだ理由は、本当に"}, {"type": "subtitle", "time": 16807.55, "timestamp": "04:40:07", "text": "気に入ったよ。とてもかわいい"}, {"type": "subtitle", "time": 16809.68, "timestamp": "04:40:09", "text": "今"}, {"type": "subtitle", "time": 16811.23, "timestamp": "04:40:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16813.708, "timestamp": "04:40:13", "text": "私を好き"}, {"type": "subtitle", "time": 16817.43, "timestamp": "04:40:17", "text": "塊。えっと、皆さんのハロウィンはどんな感じですか？"}, {"type": "subtitle", "time": 16819.82, "timestamp": "04:40:19", "text": "された？みんな、何してるの？"}, {"type": "subtitle", "time": 16824.99, "timestamp": "04:40:24", "text": "[音楽]"}, {"type": "subtitle", "time": 16828.27, "timestamp": "04:40:28", "text": "最近？みんな、最近何してるの？"}, {"type": "subtitle", "time": 16832.55, "timestamp": "04:40:32", "text": "日？でも、ええ、実際には私は"}, {"type": "subtitle", "time": 16835.708, "timestamp": "04:40:35", "text": "本当にこれをプレイしてみたい"}, {"type": "subtitle", "time": 16838.91, "timestamp": "04:40:38", "text": "ゲーム。わからない"}, {"type": "subtitle", "time": 16842.59, "timestamp": "04:40:42", "text": "これはいくらですか"}, {"type": "subtitle", "time": 16854.788, "timestamp": "04:40:54", "text": "ゲームはどれくらいの容量があるか"}, {"type": "subtitle", "time": 16858.15, "timestamp": "04:40:58", "text": "12GBです。これってダウンロードできるの？私"}]
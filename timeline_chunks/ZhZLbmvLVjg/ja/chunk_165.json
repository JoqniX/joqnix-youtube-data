[{"type": "subtitle", "time": 9902.71, "timestamp": "02:45:02", "text": "役員。私は歩くことで人を転ばせることができる、"}, {"type": "subtitle", "time": 9905.91, "timestamp": "02:45:05", "text": "自分たちの道を歩み続ける。"}, {"type": "subtitle", "time": 9906.75, "timestamp": "02:45:06", "text": "それ"}, {"type": "subtitle", "time": 9908.75, "timestamp": "02:45:08", "text": "は"}, {"type": "subtitle", "time": 9924.429, "timestamp": "02:45:24", "text": "上。私の答えは"}, {"type": "subtitle", "time": 9928.269, "timestamp": "02:45:28", "text": "回答される。もし私が行くなら"}, {"type": "subtitle", "time": 9933.57, "timestamp": "02:45:33", "text": "上を目指すには、トップに立つ方法を見つけなければならない。"}]
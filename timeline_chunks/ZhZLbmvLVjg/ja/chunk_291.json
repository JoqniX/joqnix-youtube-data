[{"type": "subtitle", "time": 17461.708, "timestamp": "04:51:01", "text": "それ。来る"}, {"type": "subtitle", "time": 17463.47, "timestamp": "04:51:03", "text": "ここ。"}, {"type": "subtitle", "time": 17466.55, "timestamp": "04:51:06", "text": "こんにちは。待って、私は違う。それは示しているんじゃないですか"}, {"type": "subtitle", "time": 17470.03, "timestamp": "04:51:10", "text": "そこで配信してるの？はい、どうぞ"}, {"type": "subtitle", "time": 17473.59, "timestamp": "04:51:13", "text": "行く。おめでとうございます おめでとうございます"}, {"type": "subtitle", "time": 17476.59, "timestamp": "04:51:16", "text": "600人のサブで、ジョー氏。こんにちは。感謝"}, {"type": "subtitle", "time": 17479.99, "timestamp": "04:51:19", "text": "あなた。ありがとう、Dさん。"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "でも正直に言うと、そうじゃない"}, {"type": "subtitle", "time": 17484.948, "timestamp": "04:51:24", "text": "えっと、600とかそんな感じかな。私はしません"}, {"type": "subtitle", "time": 17488.15, "timestamp": "04:51:28", "text": "知る。ごく普通のことのように感じるんだよ。それ"}, {"type": "subtitle", "time": 17489.628, "timestamp": "04:51:29", "text": "ただ"}, {"type": "subtitle", "time": 17492.35, "timestamp": "04:51:32", "text": "感じる"}, {"type": "subtitle", "time": 17494.91, "timestamp": "04:51:34", "text": "いつもの。うん。何もない"}, {"type": "subtitle", "time": 17498.91, "timestamp": "04:51:38", "text": "ファンシー。冗談だよ。トリック・オア・"}, {"type": "subtitle", "time": 17501.43, "timestamp": "04:51:41", "text": "扱う。うん。トリック・オア・トリート。そうすることで、"}, {"type": "subtitle", "time": 17506.07, "timestamp": "04:51:46", "text": "どうやって待つのですか？どうすればいいですか？えっと"}, {"type": "subtitle", "time": 17510.788, "timestamp": "04:51:50", "text": "私は「キャンディをちょうだい、ちょうだい」って感じ。トリック"}, {"type": "subtitle", "time": 17513.23, "timestamp": "04:51:53", "text": "木のトリックトリックまたは"}, {"type": "subtitle", "time": 17518.21, "timestamp": "04:51:58", "text": "扱う。どうすればいいのですか？禁止する時が来た"}, {"type": "subtitle", "time": 17519.55, "timestamp": "04:51:59", "text": "[音楽]"}]
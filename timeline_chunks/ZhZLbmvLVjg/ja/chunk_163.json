[{"type": "subtitle", "time": 9780.11, "timestamp": "02:43:00", "text": "行った"}, {"type": "subtitle", "time": 9790.79, "timestamp": "02:43:10", "text": "そこにいたんですね。ここは私がいた場所です"}, {"type": "subtitle", "time": 9793.83, "timestamp": "02:43:13", "text": "話している。それはここにありました。どのように"}, {"type": "subtitle", "time": 9820.23, "timestamp": "02:43:40", "text": "どうすればこの場所に入れるのですか？私は到達する"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "アニメ映画を見るのは、"}, {"type": "subtitle", "time": 9825.429, "timestamp": "02:43:45", "text": "ありきたりで、目に見えるものはありません。それはただ"}, {"type": "subtitle", "time": 9826.87, "timestamp": "02:43:46", "text": "どこからともなく現れて、"}]
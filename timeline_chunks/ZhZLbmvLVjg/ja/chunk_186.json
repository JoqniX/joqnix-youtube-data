[{"type": "subtitle", "time": 11160.59, "timestamp": "03:06:00", "text": "あまりにも"}, {"type": "subtitle", "time": 11164.51, "timestamp": "03:06:04", "text": "多くの。ああ、私はしなければならない"}, {"type": "subtitle", "time": 11173.71, "timestamp": "03:06:13", "text": "ああ、覚えているよ。"}, {"type": "subtitle", "time": 11180.63, "timestamp": "03:06:20", "text": "シート？ごめんなさい。知らなかった"}, {"type": "subtitle", "time": 11182.51, "timestamp": "03:06:22", "text": "ヘルプ。誰も教えてくれなかった"}, {"type": "subtitle", "time": 11195.03, "timestamp": "03:06:35", "text": "実際に偶然何かをして"}, {"type": "subtitle", "time": 11197.03, "timestamp": "03:06:37", "text": "知らなかったのは申し訳ない。"}, {"type": "subtitle", "time": 11209.75, "timestamp": "03:06:49", "text": "謝罪して、どこへ行けばいいのかを尋ねた。私は超"}, {"type": "subtitle", "time": 11215.59, "timestamp": "03:06:55", "text": "一瞬。どうすれば手に入れられるのでしょうか"}]
[{"type": "subtitle", "time": 9362.389, "timestamp": "02:36:02", "text": "うん。待って。えーと、私も"}, {"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "いとこが言ったので、いくつかの百合シリーズ"}, {"type": "subtitle", "time": 9367.429, "timestamp": "02:36:07", "text": "彼らはそれを現実にした。彼らは本当に本当に"}, {"type": "subtitle", "time": 9369.429, "timestamp": "02:36:09", "text": "特定のものを読んでいるときの楽しい思い出"}, {"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "一つは、ユーリがすごく可愛いように見えるということ。うん、"}, {"type": "subtitle", "time": 9374.349, "timestamp": "02:36:14", "text": "ユーリはとても"}, {"type": "subtitle", "time": 9381.15, "timestamp": "02:36:21", "text": "ユーリ"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "あまりにも。私にあなたの"}, {"type": "subtitle", "time": 9385.309, "timestamp": "02:36:25", "text": "お気に入りの喜びまたは"}, {"type": "subtitle", "time": 9390.75, "timestamp": "02:36:30", "text": "おい、大変だよ。どちらも好きです"}, {"type": "subtitle", "time": 9394.55, "timestamp": "02:36:34", "text": "けれど。でも私はユーリ!!! on ICE を観始めたんです"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "初め。それからYOIにハマった。だから私は"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "見るのではなく、マンガをたくさん読む。"}, {"type": "subtitle", "time": 9406.95, "timestamp": "02:36:46", "text": "百合漫画。ヴァンパーズはその一つだ。私が"}, {"type": "subtitle", "time": 9410.11, "timestamp": "02:36:50", "text": "ヴァンパイアは楽しかった、とても"}, {"type": "subtitle", "time": 9414.15, "timestamp": "02:36:54", "text": "かわいい。だから私がヴァンパイアを読み始めたとき、"}, {"type": "subtitle", "time": 9417.27, "timestamp": "02:36:57", "text": "作家はちょうどそれを書き始めたところだった"}]
[{"type": "subtitle", "time": 6062.47, "timestamp": "01:41:02", "text": "私が逃した思い出"}, {"type": "subtitle", "time": 6066.95, "timestamp": "01:41:06", "text": "えーと、1、2、3、4、5、6つのメモリスロット。だから私たちは"}, {"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "これらの6つを取りに行くようなもので、"}, {"type": "subtitle", "time": 6074.149, "timestamp": "01:41:14", "text": "今日の終わりですが、"}, {"type": "subtitle", "time": 6080.229, "timestamp": "01:41:20", "text": "それ。カイイ、おかえりなさい。私は"}, {"type": "subtitle", "time": 6082.83, "timestamp": "01:41:22", "text": "私たちがやっているゲームをやっている"}, {"type": "subtitle", "time": 6098.149, "timestamp": "01:41:38", "text": "「おかえりなさい」ってどういう意味？あなたは"}, {"type": "subtitle", "time": 6119.79, "timestamp": "01:41:59", "text": "こんにちは。"}]
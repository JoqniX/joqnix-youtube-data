[{"type": "subtitle", "time": 19860.628, "timestamp": "05:31:00", "text": "発生。ジェイは見たことを覚えていなかった"}, {"type": "subtitle", "time": 19863.35, "timestamp": "05:31:03", "text": "これまでにそんな経験はなかった。彼の目"}, {"type": "subtitle", "time": 19867.03, "timestamp": "05:31:07", "text": "近くの影に何かを見つけた。それ"}, {"type": "subtitle", "time": 19868.868, "timestamp": "05:31:08", "text": "人が立っているように見えた"}, {"type": "subtitle", "time": 19871.43, "timestamp": "05:31:11", "text": "そこには。一瞬、彼は"}, {"type": "subtitle", "time": 19878.788, "timestamp": "05:31:18", "text": "丸い赤い目、またはそこにまたはあった"}, {"type": "subtitle", "time": 19879.948, "timestamp": "05:31:19", "text": "そこには"}, {"type": "subtitle", "time": 19881.628, "timestamp": "05:31:21", "text": "赤"}, {"type": "subtitle", "time": 19885.19, "timestamp": "05:31:25", "text": "ライト？彼はゆっくりと少し速度を落とした"}, {"type": "subtitle", "time": 19889.23, "timestamp": "05:31:29", "text": "しかし、それ以上は見えなかった。そこで彼は続けた"}, {"type": "subtitle", "time": 19891.75, "timestamp": "05:31:31", "text": "運転。彼の車のヘッドライト"}, {"type": "subtitle", "time": 19894.23, "timestamp": "05:31:34", "text": "彼が"}, {"type": "subtitle", "time": 19897.83, "timestamp": "05:31:37", "text": "標識と一列に並ぶ。外にも"}, {"type": "subtitle", "time": 19900.67, "timestamp": "05:31:40", "text": "ほんの数秒間。彼のラジオが"}, {"type": "subtitle", "time": 19904.11, "timestamp": "05:31:44", "text": "混沌とした中でチャンネルを切り替える狂気"}, {"type": "subtitle", "time": 19907.868, "timestamp": "05:31:47", "text": "彼が"}, {"type": "subtitle", "time": 19913.11, "timestamp": "05:31:53", "text": "サイン。約30ヤードほど進んだところで、"}, {"type": "subtitle", "time": 19915.83, "timestamp": "05:31:55", "text": "全てが元通りになった。の"}, {"type": "subtitle", "time": 19917.868, "timestamp": "05:31:57", "text": "奇妙なことに、彼は目を覚ました"}]
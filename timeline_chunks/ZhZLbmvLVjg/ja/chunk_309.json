[{"type": "subtitle", "time": 18540.41, "timestamp": "05:09:00", "text": "誕生日を尋ねる"}, {"type": "subtitle", "time": 18542.43, "timestamp": "05:09:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18544.27, "timestamp": "05:09:04", "text": "願い？"}, {"type": "subtitle", "time": 18546.66, "timestamp": "05:09:06", "text": "はぁ？"}, {"type": "subtitle", "time": 18555.11, "timestamp": "05:09:15", "text": "わかった。そうそう。今日はハッシュの誕生日です。"}, {"type": "subtitle", "time": 18556.27, "timestamp": "05:09:16", "text": "右？私"}, {"type": "subtitle", "time": 18559.51, "timestamp": "05:09:19", "text": "忘れた。あ、待って。ああ、私たちは歌うべきだ"}, {"type": "subtitle", "time": 18564.788, "timestamp": "05:09:24", "text": "ハッシュさん、誕生日おめでとうございます。私は完全に"}, {"type": "subtitle", "time": 18567.51, "timestamp": "05:09:27", "text": "あ、それ忘れてた。何てことだ。おお"}, {"type": "subtitle", "time": 18569.67, "timestamp": "05:09:29", "text": "うん、うん、うん、うん、うん、うん。しかし"}, {"type": "subtitle", "time": 18572.948, "timestamp": "05:09:32", "text": "私の頭の中では、ハッシュの"}, {"type": "subtitle", "time": 18576.19, "timestamp": "05:09:36", "text": "誕生日が昨日か"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "何か。私は忘れていた、まるで私が"}, {"type": "subtitle", "time": 18582.23, "timestamp": "05:09:42", "text": "昨日は一晩中起きていた。ええ、私は"}, {"type": "subtitle", "time": 18584.91, "timestamp": "05:09:44", "text": "いや、そう感じた"}, {"type": "subtitle", "time": 18592.47, "timestamp": "05:09:52", "text": "遅い。怖い話を読んでほしい。その"}, {"type": "subtitle", "time": 18594.47, "timestamp": "05:09:54", "text": "実話ではないし、短い話でもない。わかった、"}, {"type": "chat", "time": 18596.124, "timestamp": "05:09:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "indeed mr vodnix"}, {"type": "subtitle", "time": 18596.69, "timestamp": "05:09:56", "text": "大丈夫。"}, {"type": "subtitle", "time": 18598.99, "timestamp": "05:09:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 20040.47, "timestamp": "05:34:00", "text": "そこは明るい場所だったが、広くはなかった。"}, {"type": "subtitle", "time": 20043.39, "timestamp": "05:34:03", "text": "駅の友人"}, {"type": "subtitle", "time": 20045.91, "timestamp": "05:34:05", "text": "ポンプが設置され、覆われていた"}, {"type": "subtitle", "time": 20048.07, "timestamp": "05:34:08", "text": "長い金属製の屋根が支えられている"}, {"type": "subtitle", "time": 20052.23, "timestamp": "05:34:12", "text": "鉄骨構造。彼は赤い1993年式を止めた"}, {"type": "subtitle", "time": 20055.19, "timestamp": "05:34:15", "text": "BMWをガソリンスタンドの1つに停めて給油した"}, {"type": "subtitle", "time": 20060.548, "timestamp": "05:34:20", "text": "タンク。別の車が駐車されていた"}, {"type": "subtitle", "time": 20063.27, "timestamp": "05:34:23", "text": "ポンプ。彼らはたった4人しかいなかった。ジェイク"}, {"type": "subtitle", "time": 20065.19, "timestamp": "05:34:25", "text": "中を覗くと、女性と"}, {"type": "subtitle", "time": 20067.99, "timestamp": "05:34:27", "text": "窓から小さな男の子が。彼らはいた"}, {"type": "subtitle", "time": 20070.83, "timestamp": "05:34:30", "text": "何をすればいいのか分からないような顔をして"}, {"type": "subtitle", "time": 20073.43, "timestamp": "05:34:33", "text": "買う。彼は再び周囲を見回したが、"}, {"type": "subtitle", "time": 20075.35, "timestamp": "05:34:35", "text": "何か見える。ライトは明るく、"}, {"type": "subtitle", "time": 20077.67, "timestamp": "05:34:37", "text": "その辺りでは、彼は"}, {"type": "subtitle", "time": 20079.99, "timestamp": "05:34:39", "text": "遠くにあるものを識別する"}, {"type": "subtitle", "time": 20083.31, "timestamp": "05:34:43", "text": "暗闇。彼が見たもの"}, {"type": "subtitle", "time": 20086.43, "timestamp": "05:34:46", "text": "以前から不安な気持ちが残っていた"}, {"type": "subtitle", "time": 20089.83, "timestamp": "05:34:49", "text": "彼。奇妙な形をした影。または"}]
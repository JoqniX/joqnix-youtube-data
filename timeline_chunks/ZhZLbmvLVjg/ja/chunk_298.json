[{"type": "subtitle", "time": 17881.628, "timestamp": "04:58:01", "text": "ホラー作品"}, {"type": "subtitle", "time": 17884.03, "timestamp": "04:58:04", "text": "けれど？"}, {"type": "subtitle", "time": 17887.15, "timestamp": "04:58:07", "text": "ああ、そうだね。こんにちは、レイ"}, {"type": "subtitle", "time": 17890.708, "timestamp": "04:58:10", "text": "20倍。ようこそ、ようこそ、ようこそ。調子はどうですか？"}, {"type": "subtitle", "time": 17891.788, "timestamp": "04:58:11", "text": "あなた"}, {"type": "subtitle", "time": 17895.948, "timestamp": "04:58:15", "text": "今日？お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 17900.53, "timestamp": "04:58:20", "text": "はぁ？ヤフー。そして幸せ"}, {"type": "subtitle", "time": 17902.83, "timestamp": "04:58:22", "text": "[音楽]"}, {"type": "subtitle", "time": 17904.868, "timestamp": "04:58:24", "text": "ハロウィン。右側を見たい"}, {"type": "subtitle", "time": 17905.868, "timestamp": "04:58:25", "text": "側"}, {"type": "subtitle", "time": 17908.67, "timestamp": "04:58:28", "text": "何"}, {"type": "subtitle", "time": 17932.27, "timestamp": "04:58:52", "text": "えーと"}, {"type": "subtitle", "time": 17939.07, "timestamp": "04:58:59", "text": "はぁ？"}]
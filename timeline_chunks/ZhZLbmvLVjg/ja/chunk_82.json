[{"type": "subtitle", "time": 4935.11, "timestamp": "01:22:15", "text": "ヘビーチューンがすごく効いていたのを覚えているよ。"}, {"type": "subtitle", "time": 4937.11, "timestamp": "01:22:17", "text": "彼らはこれで全てをきれいにした"}, {"type": "subtitle", "time": 4939.27, "timestamp": "01:22:19", "text": "力。移動する自由を与える力。彼らは"}, {"type": "subtitle", "time": 4941.07, "timestamp": "01:22:21", "text": "良い。そうだった"}, {"type": "subtitle", "time": 4944.51, "timestamp": "01:22:24", "text": "彼ら。疫病。私は覚えています"}, {"type": "subtitle", "time": 4947.83, "timestamp": "01:22:27", "text": "今。みんな死んでいく。彼らは"}, {"type": "subtitle", "time": 4949.83, "timestamp": "01:22:29", "text": "ほぼ全てだった。彼らは何も行動を起こさなかった。時計"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "私の家族は私たちのために命を捧げる。私はできなかった"}, {"type": "subtitle", "time": 4956.07, "timestamp": "01:22:36", "text": "彼らを救うためなら何でもする。お母さん、あなたは"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "それでも私を助けてくれる。私たちはまだ行くことができます"}, {"type": "subtitle", "time": 4959.51, "timestamp": "01:22:39", "text": "一緒に横になる。人間の性格"}, {"type": "subtitle", "time": 4963.229, "timestamp": "01:22:43", "text": "そして、私が愛した人々。"}, {"type": "subtitle", "time": 4969.629, "timestamp": "01:22:49", "text": "メモリ。"}]
[{"type": "subtitle", "time": 13862.51, "timestamp": "03:51:02", "text": "店。これらすべてが終わった"}, {"type": "subtitle", "time": 13865.83, "timestamp": "03:51:05", "text": "ここ。どうして気づかなかったんだろう"}, {"type": "subtitle", "time": 13867.389, "timestamp": "03:51:07", "text": "[音楽]"}, {"type": "subtitle", "time": 13870.67, "timestamp": "03:51:10", "text": "これ？最上階には"}, {"type": "subtitle", "time": 13875.189, "timestamp": "03:51:15", "text": "ここ。はい、どうぞ。最後にもう一つ。"}, {"type": "subtitle", "time": 13878.11, "timestamp": "03:51:18", "text": "こんにちは。配信を締めくくりましょう。ああ、"}, {"type": "subtitle", "time": 13882.59, "timestamp": "03:51:22", "text": "ああ、私たちはたくさんの思い出を持っている。"}, {"type": "subtitle", "time": 13884.389, "timestamp": "03:51:24", "text": "[音楽]"}, {"type": "subtitle", "time": 13902.71, "timestamp": "03:51:42", "text": "はぁ？ああ、謎が解けたぞ。何？"}, {"type": "subtitle", "time": 13906.75, "timestamp": "03:51:46", "text": "虹色の虹色の"}, {"type": "subtitle", "time": 13912.7, "timestamp": "03:51:52", "text": "カラフルなバックパックになりました。くそ、ロックを解除した"}, {"type": "subtitle", "time": 13915.229, "timestamp": "03:51:55", "text": "[音楽]"}, {"type": "subtitle", "time": 13919.229, "timestamp": "03:51:59", "text": "すべて。私は本当に100％達成しました"}]
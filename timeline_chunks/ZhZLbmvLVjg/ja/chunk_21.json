[{"type": "subtitle", "time": 1265.11, "timestamp": "00:21:05", "text": "暗闇の中で私の居場所を見つけてキスして。"}, {"type": "subtitle", "time": 1267.029, "timestamp": "00:21:07", "text": "上院議員は私を助けることを拒否した。彼らは私に言った"}, {"type": "subtitle", "time": 1270.99, "timestamp": "00:21:10", "text": "行く場所がないなら、もっと働こう"}, {"type": "subtitle", "time": 1273.99, "timestamp": "00:21:13", "text": "ここ。あなたは愛する人の数を忘れてしまった"}, {"type": "subtitle", "time": 1277.99, "timestamp": "00:21:17", "text": "そして育てられた。ああ、私は子供だった。車。"}, {"type": "subtitle", "time": 1280.35, "timestamp": "00:21:20", "text": "たくさんあった"}, {"type": "subtitle", "time": 1285.789, "timestamp": "00:21:25", "text": "子猫とか、そういうもの。ええと、たくさんありました"}, {"type": "subtitle", "time": 1289.31, "timestamp": "00:21:29", "text": "彼が飼っていた子猫は"}, {"type": "subtitle", "time": 1309.23, "timestamp": "00:21:49", "text": "いいえ。私は何だったのか"}, {"type": "subtitle", "time": 1312.3, "timestamp": "00:21:52", "text": "言っているの？だめだ。静かに。"}]
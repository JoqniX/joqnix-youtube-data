[{"type": "subtitle", "time": 6422.31, "timestamp": "01:47:02", "text": "わかった。ネオ、彼らは責任のあるトランス"}, {"type": "subtitle", "time": 6424.709, "timestamp": "01:47:04", "text": "上層階にはスラム街の多くの住民が住んでいる。"}, {"type": "subtitle", "time": 6427.709, "timestamp": "01:47:07", "text": "細菌を開発してそれを解決しようとした"}, {"type": "subtitle", "time": 6430.55, "timestamp": "01:47:10", "text": "成長するにつれて、ゴミもどんどん減っていく。今私たちは"}, {"type": "subtitle", "time": 6432.59, "timestamp": "01:47:12", "text": "ゼロです。さあ"}, {"type": "subtitle", "time": 6436.91, "timestamp": "01:47:16", "text": "行く。こんにちは。手に入れました。今私たちは"}, {"type": "subtitle", "time": 6444.07, "timestamp": "01:47:24", "text": "やめる。ゲームを始めなきゃ。"}, {"type": "subtitle", "time": 6451.149, "timestamp": "01:47:31", "text": "章。あなたは"}, {"type": "subtitle", "time": 6454.33, "timestamp": "01:47:34", "text": "本物？私はそうするつもりではなかった"}, {"type": "subtitle", "time": 6457.79, "timestamp": "01:47:37", "text": "[音楽]"}, {"type": "subtitle", "time": 6460.95, "timestamp": "01:47:40", "text": "やめる。私はバカだ。私はバカだ。私はしたい"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "また。君はジョーだ。知ってるか"}, {"type": "subtitle", "time": 6470.51, "timestamp": "01:47:50", "text": "軟弱な男の子って意味？だから少年は"}, {"type": "subtitle", "time": 6475.91, "timestamp": "01:47:55", "text": "声が柔らかい人"}]
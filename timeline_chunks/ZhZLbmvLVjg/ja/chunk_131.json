[{"type": "subtitle", "time": 7881.55, "timestamp": "02:11:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7886.47, "timestamp": "02:11:26", "text": "熱い。待って、行きたくない。"}, {"type": "subtitle", "time": 7902.43, "timestamp": "02:11:42", "text": "私が手に入れる必要があるのは"}, {"type": "subtitle", "time": 7912.709, "timestamp": "02:11:52", "text": "私たちがしなかったすべての場所"}, {"type": "subtitle", "time": 7915.83, "timestamp": "02:11:55", "text": "まだ探索中です。"}, {"type": "subtitle", "time": 7918.03, "timestamp": "02:11:58", "text": "探検してみましょう"}]
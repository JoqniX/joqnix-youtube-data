[{"type": "subtitle", "time": 2403.92, "timestamp": "00:40:03", "text": "あなたは"}, {"type": "subtitle", "time": 2409.15, "timestamp": "00:40:09", "text": "[音楽]"}, {"type": "subtitle", "time": 2412.51, "timestamp": "00:40:12", "text": "もちろん？何かが上に"}, {"type": "subtitle", "time": 2416.31, "timestamp": "00:40:16", "text": "そこには。そこは立ち入り禁止区域ですか？わかった。おお、"}, {"type": "subtitle", "time": 2417.99, "timestamp": "00:40:17", "text": "うん。 3つ手に入れました。もう1つあります"}, {"type": "subtitle", "time": 2420.829, "timestamp": "00:40:20", "text": "この場所から。ああ、溶岩"}, {"type": "subtitle", "time": 2423.67, "timestamp": "00:40:23", "text": "ランプ。つまり、これが私たちが求めていた溶岩ランプだったのです。"}, {"type": "subtitle", "time": 2439.55, "timestamp": "00:40:39", "text": "ナイトクラブのブラー。来て"}, {"type": "subtitle", "time": 2442.95, "timestamp": "00:40:42", "text": "ナイトクラブ。彼女を探しに行こう。こんにちは。"}]
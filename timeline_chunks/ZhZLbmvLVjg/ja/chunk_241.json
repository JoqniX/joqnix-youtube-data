[{"type": "subtitle", "time": 14461.429, "timestamp": "04:01:01", "text": "この時間にストリーミング配信をしています"}, {"type": "subtitle", "time": 14464.469, "timestamp": "04:01:04", "text": "テーマのある部屋ですよね？ああ、そうだったらいいのに"}, {"type": "subtitle", "time": 14467.349, "timestamp": "04:01:07", "text": "自動化する方法があれば、"}, {"type": "subtitle", "time": 14475.349, "timestamp": "04:01:15", "text": "全て。システムまたは何か"}, {"type": "subtitle", "time": 14477.51, "timestamp": "04:01:17", "text": "自動的に私のためにすべてを行う"}, {"type": "subtitle", "time": 14480.63, "timestamp": "04:01:20", "text": "ストリーマーにとって非常に役立つのは、"}, {"type": "subtitle", "time": 14483.309, "timestamp": "04:01:23", "text": "やらなければならない大変な仕事が多すぎる"}, {"type": "subtitle", "time": 14486.03, "timestamp": "04:01:26", "text": "手作業を行う"}, {"type": "subtitle", "time": 14489.79, "timestamp": "04:01:29", "text": "実際は痛みを伴うだろうが"}, {"type": "subtitle", "time": 14492.59, "timestamp": "04:01:32", "text": "うん、そうだね"}, {"type": "subtitle", "time": 14495.99, "timestamp": "04:01:35", "text": "えっと、今夜は配信しません。"}, {"type": "subtitle", "time": 14497.67, "timestamp": "04:01:37", "text": "今夜ストリーミング配信します"}, {"type": "subtitle", "time": 14500.87, "timestamp": "04:01:40", "text": "明日は配信はありません"}, {"type": "subtitle", "time": 14503.11, "timestamp": "04:01:43", "text": "明日は金曜日だから、えーと、金曜日は"}, {"type": "subtitle", "time": 14509.99, "timestamp": "04:01:49", "text": "忙しい。ええ、予約が入っていました"}, {"type": "subtitle", "time": 14512.71, "timestamp": "04:01:52", "text": "ドキュメントと共に。そう、私たちは"}, {"type": "subtitle", "time": 14516.349, "timestamp": "04:01:56", "text": "それ。忙しくなります。だから、私はそうしないかもしれない"}]
[{"type": "subtitle", "time": 9974.469, "timestamp": "02:46:14", "text": "そこは意味不明なのは分かっていますが、"}, {"type": "subtitle", "time": 9978.469, "timestamp": "02:46:18", "text": "男。スーパーマンは、待って、人々はただ"}, {"type": "subtitle", "time": 9981.269, "timestamp": "02:46:21", "text": "可愛いカップルたちを見て、私はこう思う。"}, {"type": "subtitle", "time": 9983.19, "timestamp": "02:46:23", "text": "なんで君たちは"}, {"type": "subtitle", "time": 9985.91, "timestamp": "02:46:25", "text": "恋愛中？人間は非常に有害で"}, {"type": "subtitle", "time": 9987.95, "timestamp": "02:46:27", "text": "恥ずかしいし、それが最後になり、"}, {"type": "subtitle", "time": 9994.269, "timestamp": "02:46:34", "text": "うん。しかし"}, {"type": "subtitle", "time": 9995.87, "timestamp": "02:46:35", "text": "また"}, {"type": "subtitle", "time": 10010.87, "timestamp": "02:46:50", "text": "何をするか"}]
[{"type": "subtitle", "time": 17221.43, "timestamp": "04:47:01", "text": "インド出身の誰かがアカウントを作成しました"}, {"type": "subtitle", "time": 17225.03, "timestamp": "04:47:05", "text": "王座を作り始め、王座を作りました"}, {"type": "subtitle", "time": 17227.27, "timestamp": "04:47:07", "text": "えーと、いろいろと。彼らは親切なようだった"}, {"type": "subtitle", "time": 17230.23, "timestamp": "04:47:10", "text": "それについて教えてくれるだけのことは十分だ。しかし、"}, {"type": "subtitle", "time": 17234.868, "timestamp": "04:47:14", "text": "私がこれまでコネクションを持っていなかったインターン生"}, {"type": "subtitle", "time": 17239.35, "timestamp": "04:47:19", "text": "連絡を取っていた相手は去っていった"}, {"type": "subtitle", "time": 17242.15, "timestamp": "04:47:22", "text": "彼らはインターン期間を終えた。それで"}, {"type": "subtitle", "time": 17245.11, "timestamp": "04:47:25", "text": "彼らは削除しなければならなかった"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "彼らのDiscordカードすべての連絡先すべて"}, {"type": "subtitle", "time": 17249.07, "timestamp": "04:47:29", "text": "それら。だから私は他に手段がなかった"}, {"type": "subtitle", "time": 17252.15, "timestamp": "04:47:32", "text": "彼らが私に教えてくれた連絡先に連絡してください"}, {"type": "subtitle", "time": 17254.708, "timestamp": "04:47:34", "text": "他の人にはDMを送ります。彼らは決して"}, {"type": "subtitle", "time": 17265.788, "timestamp": "04:47:45", "text": "ああ、まるで何かに取り憑かれているみたいだ。ああ、どうぞ。私は"}, {"type": "subtitle", "time": 17269.67, "timestamp": "04:47:49", "text": "ごめん。でも、でも、今は"}, {"type": "subtitle", "time": 17274.07, "timestamp": "04:47:54", "text": "ええと、このコミュニティは"}, {"type": "subtitle", "time": 17275.47, "timestamp": "04:47:55", "text": "現時点で"}, {"type": "subtitle", "time": 17279.15, "timestamp": "04:47:59", "text": "小さくて純粋で、"}]
[{"type": "subtitle", "time": 8102.31, "timestamp": "02:15:02", "text": "パック。誰もがそれを欲しがっている。彼らは使用できる"}, {"type": "subtitle", "time": 8104.27, "timestamp": "02:15:04", "text": "しかし彼らは"}, {"type": "subtitle", "time": 8107.39, "timestamp": "02:15:07", "text": "欲しい。それで"}, {"type": "subtitle", "time": 8115.27, "timestamp": "02:15:15", "text": "彼ら。人々が「uh nanji」と「"}, {"type": "subtitle", "time": 8117.39, "timestamp": "02:15:17", "text": "ホルの音のように"}, {"type": "subtitle", "time": 8119.229, "timestamp": "02:15:19", "text": "パック"}, {"type": "subtitle", "time": 8122.069, "timestamp": "02:15:22", "text": "アラームのようなもの。"}, {"type": "subtitle", "time": 8123.99, "timestamp": "02:15:23", "text": "彼らが寂しさを感じている時、私にはわかるんです"}, {"type": "subtitle", "time": 8126.31, "timestamp": "02:15:26", "text": "あるいは、彼らが聞いた何か、あるいは彼女が"}, {"type": "subtitle", "time": 8129.03, "timestamp": "02:15:29", "text": "声を返したりして落ち着かせたり"}, {"type": "subtitle", "time": 8131.87, "timestamp": "02:15:31", "text": "下へ降りて、そういうことをすれば"}, {"type": "subtitle", "time": 8134.54, "timestamp": "02:15:34", "text": "言う。"}, {"type": "subtitle", "time": 8136.03, "timestamp": "02:15:36", "text": "[拍手]"}, {"type": "subtitle", "time": 8138.91, "timestamp": "02:15:38", "text": "うん。何か役に立つものがあると知ってる？"}, {"type": "subtitle", "time": 8141.39, "timestamp": "02:15:41", "text": "人々"}]
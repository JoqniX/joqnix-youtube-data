[{"type": "subtitle", "time": 17040.31, "timestamp": "04:44:00", "text": "私のショーから出て行け。あの頃が懐かしい。"}, {"type": "subtitle", "time": 17043.67, "timestamp": "04:44:03", "text": "2021年に私が始めた頃は"}, {"type": "subtitle", "time": 17047.23, "timestamp": "04:44:07", "text": "ビデオ撮影中、みんな「ジョン、来て」って感じだった。"}, {"type": "subtitle", "time": 17050.948, "timestamp": "04:44:10", "text": "毎日がコラボの日だった。そこには"}, {"type": "subtitle", "time": 17053.43, "timestamp": "04:44:13", "text": "コラボレーションを希望する人がたくさんいる"}, {"type": "subtitle", "time": 17055.27, "timestamp": "04:44:15", "text": "私と一緒に。それで私は「わかった、やってみよう」と思った"}, {"type": "subtitle", "time": 17058.55, "timestamp": "04:44:18", "text": "今日、今日、あの日。それから私は"}, {"type": "subtitle", "time": 17060.35, "timestamp": "04:44:20", "text": "ああ、"}, {"type": "subtitle", "time": 17064.39, "timestamp": "04:44:24", "text": "痛みとか、そういう類のすべて。そして、これこれ"}, {"type": "subtitle", "time": 17067.59, "timestamp": "04:44:27", "text": "すべてはズキのおかげで可能になった"}, {"type": "subtitle", "time": 17070.15, "timestamp": "04:44:30", "text": "実際に話す勇気をくれたのは誰だったのか"}, {"type": "subtitle", "time": 17073.27, "timestamp": "04:44:33", "text": "人との接し方、話し方"}, {"type": "subtitle", "time": 17075.83, "timestamp": "04:44:35", "text": "コラボレーションとか色々あったけど。だから私は"}, {"type": "subtitle", "time": 17078.59, "timestamp": "04:44:38", "text": "彼女には本当に感謝しています"}, {"type": "subtitle", "time": 17081.59, "timestamp": "04:44:41", "text": "以来。うん。でも最近はやらない"}, {"type": "subtitle", "time": 17083.43, "timestamp": "04:44:43", "text": "多くのコラボレーション。私はただのんびりしていた"}, {"type": "subtitle", "time": 17087.59, "timestamp": "04:44:47", "text": "IMV invaの仲間たちと、そして今コラボレーション中"}, {"type": "subtitle", "time": 17092.15, "timestamp": "04:44:52", "text": "事実上、ve とすべて"}, {"type": "subtitle", "time": 17094.55, "timestamp": "04:44:54", "text": "veといえば、彼はストリーミング配信をしているんじゃないの？"}, {"type": "subtitle", "time": 17096.55, "timestamp": "04:44:56", "text": "彼が配信しているのはホラーゲームではない"}, {"type": "subtitle", "time": 17098.43, "timestamp": "04:44:58", "text": "すべてフラッシュ"}]
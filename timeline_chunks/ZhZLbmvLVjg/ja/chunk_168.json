[{"type": "subtitle", "time": 10108.309, "timestamp": "02:48:28", "text": "ここ？よし、そこは私たちが"}, {"type": "subtitle", "time": 10109.71, "timestamp": "02:48:29", "text": "必要だった"}, {"type": "subtitle", "time": 10116.83, "timestamp": "02:48:36", "text": "に。ええ、ここが私たちが見た場所です"}, {"type": "subtitle", "time": 10119.99, "timestamp": "02:48:39", "text": "先ほどあちらにあったもの。私たちも行きます"}, {"type": "subtitle", "time": 10121.51, "timestamp": "02:48:41", "text": "そこに戻ります。つまり、これがもう一つ"}, {"type": "subtitle", "time": 10122.95, "timestamp": "02:48:42", "text": "場所。"}, {"type": "subtitle", "time": 10128.99, "timestamp": "02:48:48", "text": "感じるもの"}, {"type": "subtitle", "time": 10136.309, "timestamp": "02:48:56", "text": "わかった、あのね？やってみよう"}, {"type": "subtitle", "time": 10139.19, "timestamp": "02:48:59", "text": "パズルとかそういうもの。ロックを解除しましょう"}]
[{"type": "subtitle", "time": 17703.75, "timestamp": "04:55:03", "text": "インドには、"}, {"type": "subtitle", "time": 17706.07, "timestamp": "04:55:06", "text": "YouTuberとして、"}, {"type": "subtitle", "time": 17708.99, "timestamp": "04:55:08", "text": "イアンというVtuberで、ストリーミング配信をしていて、"}, {"type": "subtitle", "time": 17710.91, "timestamp": "04:55:10", "text": "すべて"}, {"type": "subtitle", "time": 17714.788, "timestamp": "04:55:14", "text": "ああ、神様、泣きたい気分だ"}, {"type": "subtitle", "time": 17717.15, "timestamp": "04:55:17", "text": "見るのが楽しい"}, {"type": "subtitle", "time": 17720.25, "timestamp": "04:55:20", "text": "この神様、私は本当に泣いています"}, {"type": "subtitle", "time": 17722.628, "timestamp": "04:55:22", "text": "[音楽]"}, {"type": "subtitle", "time": 17725.868, "timestamp": "04:55:25", "text": "でも、それを見ると嬉しくなります。"}, {"type": "subtitle", "time": 17728.75, "timestamp": "04:55:28", "text": "実際にはもっと多くの"}, {"type": "subtitle", "time": 17732.67, "timestamp": "04:55:32", "text": "YouTuber。当時はただ"}, {"type": "subtitle", "time": 17735.43, "timestamp": "04:55:35", "text": "五。当時はただのDMグループだった"}, {"type": "subtitle", "time": 17738.15, "timestamp": "04:55:38", "text": "5人から10人程度。そして今、"}, {"type": "subtitle", "time": 17741.67, "timestamp": "04:55:41", "text": "それ。さあ、みんなを見てください。のように"}, {"type": "subtitle", "time": 17744.47, "timestamp": "04:55:44", "text": "いくらですか？ちょっとスクロールさせてください"}, {"type": "subtitle", "time": 17750.43, "timestamp": "04:55:50", "text": "えーと"}, {"type": "subtitle", "time": 17753.03, "timestamp": "04:55:53", "text": "121. リストを作成している間、私は"}, {"type": "subtitle", "time": 17755.67, "timestamp": "04:55:55", "text": "ちょっと怖いのは、BBCのために"}, {"type": "subtitle", "time": 17757.948, "timestamp": "04:55:57", "text": "記事の中で、私は90以上あると言いました"}]
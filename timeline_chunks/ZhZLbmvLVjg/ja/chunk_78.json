[{"type": "subtitle", "time": 4682.31, "timestamp": "01:18:02", "text": "クリーン。ベッドには十分ご注意ください。"}, {"type": "subtitle", "time": 4686.03, "timestamp": "01:18:06", "text": "良い１日を。よし。まあ、"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "注意深い。何してるの？ご挨拶申し上げます。"}, {"type": "subtitle", "time": 4692.03, "timestamp": "01:18:12", "text": "ウォールシティの住民"}, {"type": "subtitle", "time": 4694.35, "timestamp": "01:18:14", "text": "99. ウォル"}, {"type": "subtitle", "time": 4698.35, "timestamp": "01:18:18", "text": "市。ああ、ここは新しい場所だ"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "これ？いろいろなことが起こるものだ。わかった。都市"}, {"type": "subtitle", "time": 4712.75, "timestamp": "01:18:32", "text": "サービスがロックされる理由"}, {"type": "subtitle", "time": 4715.07, "timestamp": "01:18:35", "text": "監禁"}, {"type": "subtitle", "time": 4718.79, "timestamp": "01:18:38", "text": "手順。わかった。市民がいれば"}, {"type": "subtitle", "time": 4720.59, "timestamp": "01:18:40", "text": "あなたは"}, {"type": "subtitle", "time": 4723.11, "timestamp": "01:18:43", "text": "管制室を要請する。わかった。行けるよ"}, {"type": "subtitle", "time": 4725.95, "timestamp": "01:18:45", "text": "屋外に設置する必要があり、制御室も必要です。"}, {"type": "subtitle", "time": 4729.229, "timestamp": "01:18:49", "text": "わかった。市"}, {"type": "subtitle", "time": 4731.07, "timestamp": "01:18:51", "text": "CL。は"}, {"type": "subtitle", "time": 4734.149, "timestamp": "01:18:54", "text": "これは、ああ、なんてことだ。私たちは、私たちは"}, {"type": "subtitle", "time": 4736.75, "timestamp": "01:18:56", "text": "最上階"}, {"type": "subtitle", "time": 4739.39, "timestamp": "01:18:59", "text": "壁。何てことだ。"}]
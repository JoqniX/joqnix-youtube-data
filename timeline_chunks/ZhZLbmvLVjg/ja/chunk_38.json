[{"type": "subtitle", "time": 2281.63, "timestamp": "00:38:01", "text": "あれ。"}, {"type": "subtitle", "time": 2292.39, "timestamp": "00:38:12", "text": "あなたは別のものを見つけました。本気ですか？"}, {"type": "subtitle", "time": 2296.03, "timestamp": "00:38:16", "text": "待って。それでは順番に。これは"}, {"type": "subtitle", "time": 2306.99, "timestamp": "00:38:26", "text": "4つ。これはその一つです。"}, {"type": "subtitle", "time": 2310.51, "timestamp": "00:38:30", "text": "実際、これは"}, {"type": "subtitle", "time": 2315.87, "timestamp": "00:38:35", "text": "1つ。この記号の答えは"}, {"type": "subtitle", "time": 2319.829, "timestamp": "00:38:39", "text": "右。これはその一つです。"}, {"type": "subtitle", "time": 2323.03, "timestamp": "00:38:43", "text": "彼らは、私の仲間のようにはできません。"}, {"type": "subtitle", "time": 2326.069, "timestamp": "00:38:46", "text": "それで、彼らは一体何をしているんだろう？これは私が"}, {"type": "subtitle", "time": 2329.39, "timestamp": "00:38:49", "text": "濡れた。はい、それは"}, {"type": "subtitle", "time": 2333.109, "timestamp": "00:38:53", "text": "1つ。シーケンス番号はありません。待って、もし私がそうでないなら"}]
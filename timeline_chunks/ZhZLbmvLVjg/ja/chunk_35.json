[{"type": "subtitle", "time": 2100.03, "timestamp": "00:35:00", "text": "面白い。わかった。どこ"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "また？彼女の家は"}, {"type": "subtitle", "time": 2117.27, "timestamp": "00:35:17", "text": "エリア。どうしたの？彼らはそれを阻止した"}, {"type": "subtitle", "time": 2119.99, "timestamp": "00:35:19", "text": "オフ。はぁ？"}, {"type": "subtitle", "time": 2122.71, "timestamp": "00:35:22", "text": "私はインドに関するコレクションを持っています。"}, {"type": "subtitle", "time": 2124.91, "timestamp": "00:35:24", "text": "待て、彼らはそれを遮断した。彼らはどうやって"}, {"type": "subtitle", "time": 2128.59, "timestamp": "00:35:28", "text": "知る？彼女が生きていることをどうやって知ったのか"}, {"type": "subtitle", "time": 2139.95, "timestamp": "00:35:39", "text": "けれど？検索演算子は"}, {"type": "subtitle", "time": 2142.99, "timestamp": "00:35:42", "text": "行くよ。彼女が住んでいることをどうやって知ったのか"}, {"type": "subtitle", "time": 2145.43, "timestamp": "00:35:45", "text": "ここ？一体どういうことだ？彼らは封鎖した"}, {"type": "subtitle", "time": 2148.55, "timestamp": "00:35:48", "text": "この場所を完全に。"}]
[{"type": "subtitle", "time": 19922.23, "timestamp": "05:32:02", "text": "彼の無気力な状態。"}, {"type": "subtitle", "time": 19924.708, "timestamp": "05:32:04", "text": "ジャックは自分のバッテリーが"}, {"type": "subtitle", "time": 19927.43, "timestamp": "05:32:07", "text": "正常に動作している。誤った書き方"}, {"type": "subtitle", "time": 19929.43, "timestamp": "05:32:09", "text": "干渉と組み合わせると"}, {"type": "subtitle", "time": 19933.15, "timestamp": "05:32:13", "text": "助けは両方を説明するかもしれない"}, {"type": "subtitle", "time": 19936.628, "timestamp": "05:32:16", "text": "現象。しかし、奇妙だったのは、"}, {"type": "subtitle", "time": 19947.07, "timestamp": "05:32:27", "text": "時間。行く。文字通り"}, {"type": "subtitle", "time": 19950.03, "timestamp": "05:32:30", "text": "同時にあくびもする。 A"}, {"type": "subtitle", "time": 19953.03, "timestamp": "05:32:33", "text": "このような偶然が起こる可能性はごくわずかだった"}, {"type": "subtitle", "time": 19953.868, "timestamp": "05:32:33", "text": "の"}, {"type": "subtitle", "time": 19955.548, "timestamp": "05:32:35", "text": "ハプニング。"}, {"type": "subtitle", "time": 19960.75, "timestamp": "05:32:40", "text": "「ああ、疲れた」と彼は思った。そして彼はスピードを上げた"}, {"type": "subtitle", "time": 19964.23, "timestamp": "05:32:44", "text": "さらにスピードを上げて"}, {"type": "subtitle", "time": 19966.19, "timestamp": "05:32:46", "text": "ガソリンスタンドに到着したらすぐに"}, {"type": "subtitle", "time": 19969.27, "timestamp": "05:32:49", "text": "可能。数分間の休憩と"}, {"type": "subtitle", "time": 19971.91, "timestamp": "05:32:51", "text": "彼はもうすぐ向かうだろう。一杯の"}, {"type": "subtitle", "time": 19974.11, "timestamp": "05:32:54", "text": "コーヒーがいいだろう"}, {"type": "subtitle", "time": 19977.19, "timestamp": "05:32:57", "text": "アイデア。ジェイクは自動販売機を見つけたいと思っていた"}]
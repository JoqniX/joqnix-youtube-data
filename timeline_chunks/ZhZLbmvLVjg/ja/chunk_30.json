[{"type": "subtitle", "time": 1818.149, "timestamp": "00:30:18", "text": "これは日常的なことなの？"}, {"type": "subtitle", "time": 1820.89, "timestamp": "00:30:20", "text": "ああ、あなたはそうしなければならない"}, {"type": "subtitle", "time": 1836.83, "timestamp": "00:30:36", "text": "はぁ？ H ああ、それは"}, {"type": "subtitle", "time": 1838.83, "timestamp": "00:30:38", "text": "パズル。おお、"}, {"type": "subtitle", "time": 1847.51, "timestamp": "00:30:47", "text": "この男をここに連れてくることはできるが、"}, {"type": "subtitle", "time": 1848.83, "timestamp": "00:30:48", "text": "どうすれば入手できますか"}, {"type": "subtitle", "time": 1850.669, "timestamp": "00:30:50", "text": "上？得る"}, {"type": "subtitle", "time": 1853.33, "timestamp": "00:30:53", "text": "彼。行ってもいいですか？"}, {"type": "subtitle", "time": 1855.07, "timestamp": "00:30:55", "text": "[音楽]"}, {"type": "subtitle", "time": 1857.59, "timestamp": "00:30:57", "text": "のように？ああ、わかりました。わかった。わかった。手に入れた"}]
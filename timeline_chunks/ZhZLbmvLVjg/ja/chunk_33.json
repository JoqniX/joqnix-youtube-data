[{"type": "subtitle", "time": 1980.23, "timestamp": "00:33:00", "text": "バックグラウンドで実行されているアプリケーション。"}, {"type": "subtitle", "time": 1992.47, "timestamp": "00:33:12", "text": "えっ？このゲームのポイントはこうだ。"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "このゲームには、"}, {"type": "subtitle", "time": 1996.95, "timestamp": "00:33:16", "text": "彼の「ちくしょう」の1つが続く。うん。ああ、"}, {"type": "subtitle", "time": 1998.909, "timestamp": "00:33:18", "text": "神。待って。 69"}, {"type": "subtitle", "time": 2003.99, "timestamp": "00:33:23", "text": "メモリ。ニース。はい、では閉じます。えっと、"}, {"type": "subtitle", "time": 2007.789, "timestamp": "00:33:27", "text": "今は罪悪感を感じる必要はない。近い"}, {"type": "subtitle", "time": 2011.47, "timestamp": "00:33:31", "text": "それ。ゲームループ。私は必要ない"}, {"type": "subtitle", "time": 2018.669, "timestamp": "00:33:38", "text": "わかった。なぜああ"}, {"type": "subtitle", "time": 2023.31, "timestamp": "00:33:43", "text": "ああ、痛い。大きい"}, {"type": "subtitle", "time": 2037.75, "timestamp": "00:33:57", "text": "いいえ。了解しました。店内に留めておきましょう。"}]
[{"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "ちなみに、これらはすべて完了しました。それで、"}, {"type": "subtitle", "time": 7149.91, "timestamp": "01:59:09", "text": "私たちはただここから出たいだけなんです。"}, {"type": "subtitle", "time": 7163.589, "timestamp": "01:59:23", "text": "拒否する。ところで、今、あのジョーク聞いたような気がするんだけど？あなた"}, {"type": "subtitle", "time": 7166.709, "timestamp": "01:59:26", "text": "あなたは妹だと言った。私はスイッチを入れるような"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "それもまた然り。一番悲しい。私はどちらの面も持っている。は"}, {"type": "subtitle", "time": 7173.669, "timestamp": "01:59:33", "text": "それを表す言葉ってあるのかな？両方に当てはまるのは誰？私"}, {"type": "subtitle", "time": 7174.83, "timestamp": "01:59:34", "text": "しないで"}, {"type": "subtitle", "time": 7177.189, "timestamp": "01:59:37", "text": "知る。これを表す言葉があるといいのですが。私"}, {"type": "subtitle", "time": 7179.83, "timestamp": "01:59:39", "text": "わからない。"}, {"type": "subtitle", "time": 7181.91, "timestamp": "01:59:41", "text": "だから、完全に大人の姿を見るだけです"}, {"type": "subtitle", "time": 7185.43, "timestamp": "01:59:45", "text": "危険だと思ったら、何事もなかったかのように元に戻る。"}, {"type": "subtitle", "time": 7187.16, "timestamp": "01:59:47", "text": "その通り。そうでしょう？"}, {"type": "subtitle", "time": 7191.229, "timestamp": "01:59:51", "text": "[音楽]"}, {"type": "subtitle", "time": 7193.629, "timestamp": "01:59:53", "text": "いいね？その"}, {"type": "subtitle", "time": 7196.03, "timestamp": "01:59:56", "text": "かわいい。それは"}, {"type": "subtitle", "time": 7198.87, "timestamp": "01:59:58", "text": "ボールかわいい。猫を見て"}]
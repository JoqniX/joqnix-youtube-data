[{"type": "subtitle", "time": 7044.229, "timestamp": "01:57:24", "text": "個人的には、あなたの握力の強さが気に入っています"}, {"type": "subtitle", "time": 7046.35, "timestamp": "01:57:26", "text": "あなたが持っている自己認識は偽りです"}, {"type": "subtitle", "time": 7050.589, "timestamp": "01:57:30", "text": "まるで私が車好きではないかのように注目される"}, {"type": "subtitle", "time": 7053.109, "timestamp": "01:57:33", "text": "それ。待って、感覚ってどういう意味ですか"}, {"type": "subtitle", "time": 7056.79, "timestamp": "01:57:36", "text": "自己？ああ、自分が何者か分かっているのか？どのようなタイプですか"}, {"type": "subtitle", "time": 7059.229, "timestamp": "01:57:39", "text": "あなたが"}, {"type": "subtitle", "time": 7062.149, "timestamp": "01:57:42", "text": "とかそういうの？"}, {"type": "subtitle", "time": 7064.189, "timestamp": "01:57:44", "text": "そうそう。"}, {"type": "subtitle", "time": 7074.07, "timestamp": "01:57:54", "text": "右？自分が何者かを知っている人々"}]
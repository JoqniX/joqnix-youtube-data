[{"type": "subtitle", "time": 12616.269, "timestamp": "03:30:16", "text": "青。"}, {"type": "subtitle", "time": 12624.229, "timestamp": "03:30:24", "text": "さよなら。ボンをキープできない、"}, {"type": "subtitle", "time": 12649.91, "timestamp": "03:30:49", "text": "ええ、私が呼ばれたい名前は"}, {"type": "subtitle", "time": 12652.95, "timestamp": "03:30:52", "text": "シュガーとベイビーは、"}, {"type": "subtitle", "time": 12655.51, "timestamp": "03:30:55", "text": "どんなニックネームがいいか、アイデア"}, {"type": "subtitle", "time": 12656.59, "timestamp": "03:30:56", "text": "電話がかかってきた。"}]
[{"type": "subtitle", "time": 11643.75, "timestamp": "03:14:03", "text": "私たちが感じている肉。いくつかある"}, {"type": "subtitle", "time": 11644.67, "timestamp": "03:14:04", "text": "私は"}, {"type": "subtitle", "time": 11648.2, "timestamp": "03:14:08", "text": "ない。入手できません。"}, {"type": "subtitle", "time": 11650.469, "timestamp": "03:14:10", "text": "[音楽]"}, {"type": "subtitle", "time": 11652.79, "timestamp": "03:14:12", "text": "だって、物語を進めすぎちゃったから。"}, {"type": "subtitle", "time": 11668.229, "timestamp": "03:14:28", "text": "えっと、私が見逃しているのは何でしょう"}, {"type": "subtitle", "time": 11694.309, "timestamp": "03:14:54", "text": "いや、待って。彼女が持っていたあの物は何だったのか"}]
[{"type": "subtitle", "time": 6842.95, "timestamp": "01:54:02", "text": "肯定的な定義を話すことは"}, {"type": "subtitle", "time": 6845.35, "timestamp": "01:54:05", "text": "男らしさに欠ける、かわいいと評される少年"}, {"type": "subtitle", "time": 6847.39, "timestamp": "01:54:07", "text": "より柔らかな性別に基づいて"}, {"type": "subtitle", "time": 6849.669, "timestamp": "01:54:09", "text": "特徴。私はどんな立場にもなりたくない"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "彼らのうちの。私もマイナスにはならない"}, {"type": "subtitle", "time": 6853.669, "timestamp": "01:54:13", "text": "定義または私は性別ではない私は"}, {"type": "subtitle", "time": 6855.43, "timestamp": "01:54:15", "text": "大きな泥棒で、私は"}, {"type": "subtitle", "time": 6857.07, "timestamp": "01:54:17", "text": "人々。"}]
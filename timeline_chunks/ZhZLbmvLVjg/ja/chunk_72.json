[{"type": "subtitle", "time": 4321.83, "timestamp": "01:12:01", "text": "この金属製の格子のような門は、"}, {"type": "subtitle", "time": 4325.11, "timestamp": "01:12:05", "text": "コースはすべて簡単に分解できる。しかし"}, {"type": "subtitle", "time": 4327.79, "timestamp": "01:12:07", "text": "あそこのドアはすごく"}, {"type": "subtitle", "time": 4330.55, "timestamp": "01:12:10", "text": "装甲された重装甲物。あなたはそう思う"}, {"type": "subtitle", "time": 4336.63, "timestamp": "01:12:16", "text": "いいえ。あなたが運転を始めたら、私は帰ります"}, {"type": "subtitle", "time": 4337.95, "timestamp": "01:12:17", "text": "惑星。"}, {"type": "subtitle", "time": 4351.27, "timestamp": "01:12:31", "text": "家。何てことだ。みんな来るよ。私は"}, {"type": "subtitle", "time": 4352.709, "timestamp": "01:12:32", "text": "走っている。私は走っています。私は走っています。私は"}, {"type": "subtitle", "time": 4369.47, "timestamp": "01:12:49", "text": "[音楽]"}]
[{"type": "subtitle", "time": 5890.75, "timestamp": "01:38:10", "text": "実は。待って"}, {"type": "subtitle", "time": 5894.87, "timestamp": "01:38:14", "text": "分。それはつまり、ああ、私は全部手に入れたということ"}, {"type": "subtitle", "time": 5896.27, "timestamp": "01:38:16", "text": "思い出。"}, {"type": "subtitle", "time": 5898.91, "timestamp": "01:38:18", "text": "うん、"}, {"type": "subtitle", "time": 5902.629, "timestamp": "01:38:22", "text": "ええと、私はそれに戻ることができると思います"}, {"type": "subtitle", "time": 5907.629, "timestamp": "01:38:27", "text": "カテゴリを再起動する。だから私はこう言った"}, {"type": "subtitle", "time": 5909.47, "timestamp": "01:38:29", "text": "私たちについて"}, {"type": "subtitle", "time": 5918.189, "timestamp": "01:38:38", "text": "うん。だから、私を見つける必要がある"}, {"type": "subtitle", "time": 5922.75, "timestamp": "01:38:42", "text": "3つ目の記憶のやつは、"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "集める。うん。こんにちは。はい、ようこそ"}, {"type": "subtitle", "time": 5928.87, "timestamp": "01:38:48", "text": "戻る。私たちは試合を終えた。だから私たちは"}, {"type": "subtitle", "time": 5931.83, "timestamp": "01:38:51", "text": "私たちは、すべての"}, {"type": "subtitle", "time": 5937.47, "timestamp": "01:38:57", "text": "B12 を亡くした人々の思い出"}, {"type": "subtitle", "time": 5939.229, "timestamp": "01:38:59", "text": "離れて。"}]
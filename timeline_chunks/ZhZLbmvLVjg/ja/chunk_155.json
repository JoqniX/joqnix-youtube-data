[{"type": "subtitle", "time": 9305.03, "timestamp": "02:35:05", "text": "待って。よし、保存は放っておいて"}, {"type": "subtitle", "time": 9307.309, "timestamp": "02:35:07", "text": "私たちは辞めました"}, {"type": "subtitle", "time": 9309.79, "timestamp": "02:35:09", "text": "それを開始"}, {"type": "subtitle", "time": 9313.27, "timestamp": "02:35:13", "text": "また。私たちは章の始まりを告げた。ほら、だから私たちは"}, {"type": "subtitle", "time": 9314.75, "timestamp": "02:35:14", "text": "すべて手に入れた"}, {"type": "subtitle", "time": 9317.15, "timestamp": "02:35:17", "text": "思い出はまさに"}, {"type": "subtitle", "time": 9318.99, "timestamp": "02:35:18", "text": "ミッドタウン、"}, {"type": "subtitle", "time": 9338.79, "timestamp": "02:35:38", "text": "はい、エアコンを少し調整しました。親切"}, {"type": "subtitle", "time": 9345.429, "timestamp": "02:35:45", "text": "上。あ、そういえば、最後に言ったんだけど"}, {"type": "subtitle", "time": 9348.15, "timestamp": "02:35:48", "text": "ストリーム"}, {"type": "subtitle", "time": 9351.11, "timestamp": "02:35:51", "text": "えっと、昨日。私はもう後戻りできなかった。それで、"}, {"type": "subtitle", "time": 9352.95, "timestamp": "02:35:52", "text": "どうやら私はその中のすべてを終えたようです"}, {"type": "subtitle", "time": 9354.83, "timestamp": "02:35:54", "text": "ビッグスリー"}]
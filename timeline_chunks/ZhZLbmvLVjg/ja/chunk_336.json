[{"type": "subtitle", "time": 20160.83, "timestamp": "05:36:00", "text": "数日間髭を剃った。彼の"}, {"type": "subtitle", "time": 20164.07, "timestamp": "05:36:04", "text": "頬がこけ、目が垂れ下がっている"}, {"type": "subtitle", "time": 20165.31, "timestamp": "05:36:05", "text": "疲れ"}, {"type": "subtitle", "time": 20173.27, "timestamp": "05:36:13", "text": "酒に溺れるという過酷な経験を乗り越えた。"}, {"type": "subtitle", "time": 20175.51, "timestamp": "05:36:15", "text": "彼はタンクを満タンにして中に入った。"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "駅で、彼は"}, {"type": "subtitle", "time": 20180.39, "timestamp": "05:36:20", "text": "自動販売機で買ったコーヒー。彼"}, {"type": "subtitle", "time": 20182.23, "timestamp": "05:36:22", "text": "時計を待ちながら、"}, {"type": "subtitle", "time": 20184.15, "timestamp": "05:36:24", "text": "心地よい音楽が流れていた"}, {"type": "subtitle", "time": 20186.59, "timestamp": "05:36:26", "text": "背景。それは"}, {"type": "subtitle", "time": 20190.23, "timestamp": "05:36:30", "text": "ラジオは聞こえたが、どこにあるのか分からなかった。"}, {"type": "subtitle", "time": 20192.31, "timestamp": "05:36:32", "text": "ガソリンスタンドの時計が"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "数秒後にカウンターが作動する。彼は"}, {"type": "subtitle", "time": 20198.47, "timestamp": "05:36:38", "text": "背の高い黒人男性で、少し痩せている。"}, {"type": "subtitle", "time": 20201.43, "timestamp": "05:36:41", "text": "その男性は全く疲れているようには見えなかった。多分"}, {"type": "subtitle", "time": 20204.47, "timestamp": "05:36:44", "text": "少し退屈だ。彼はそうした。彼は"}]
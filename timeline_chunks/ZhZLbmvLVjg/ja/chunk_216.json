[{"type": "subtitle", "time": 12983.51, "timestamp": "03:36:23", "text": "もし私たちができないなら、何も意味がない"}, {"type": "subtitle", "time": 12989.95, "timestamp": "03:36:29", "text": "誰かいますか？"}, {"type": "subtitle", "time": 12992.03, "timestamp": "03:36:32", "text": "誰も、"}, {"type": "subtitle", "time": 12995.55, "timestamp": "03:36:35", "text": "二。ああ、この人は新人だ、"}, {"type": "subtitle", "time": 13004.59, "timestamp": "03:36:44", "text": "いいえ、それで、"}, {"type": "subtitle", "time": 13015.59, "timestamp": "03:36:55", "text": "[音楽]"}]
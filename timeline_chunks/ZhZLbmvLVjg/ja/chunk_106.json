[{"type": "subtitle", "time": 6360.149, "timestamp": "01:46:00", "text": "彼が私をボットだと言ったから、私はそう言ったのです。"}, {"type": "subtitle", "time": 6362.03, "timestamp": "01:46:02", "text": "うん。ずっと昔"}, {"type": "subtitle", "time": 6364.109, "timestamp": "01:46:04", "text": "そこには"}, {"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "バカイ。あ、待って。彼らはアレルギーがあります"}, {"type": "subtitle", "time": 6368.79, "timestamp": "01:46:08", "text": "金属か何か。そのうちの1人が亡くなった"}, {"type": "subtitle", "time": 6371.149, "timestamp": "01:46:11", "text": "けれど。"}, {"type": "subtitle", "time": 6372.669, "timestamp": "01:46:12", "text": "何？"}, {"type": "subtitle", "time": 6375.51, "timestamp": "01:46:15", "text": "どうやって？つまり、あなたは受け身なの？いいえ、私は"}, {"type": "subtitle", "time": 6377.51, "timestamp": "01:46:17", "text": "底。私がボトムエネルギーを与えたから。"}, {"type": "subtitle", "time": 6379.709, "timestamp": "01:46:19", "text": "私はそうではない、私はそうならない"}, {"type": "subtitle", "time": 6396.149, "timestamp": "01:46:36", "text": "でも、私は以前はこれらのことを何も知らなかった。"}, {"type": "subtitle", "time": 6397.99, "timestamp": "01:46:37", "text": "なんでそんなにストレートに言うの？"}, {"type": "subtitle", "time": 6401.55, "timestamp": "01:46:41", "text": "これは何ですか？何？これはたくさんの"}, {"type": "subtitle", "time": 6406.51, "timestamp": "01:46:46", "text": "情報。それは心配しないでください"}, {"type": "subtitle", "time": 6409.87, "timestamp": "01:46:49", "text": "それ。心配しないでください"}]
[{"type": "subtitle", "time": 19800.07, "timestamp": "05:30:00", "text": "彼ら。ジェイクは特に注意を払わなければならなかった"}, {"type": "subtitle", "time": 19803.03, "timestamp": "05:30:03", "text": "道路と、その脇にあるものすべて。彼"}, {"type": "subtitle", "time": 19805.27, "timestamp": "05:30:05", "text": "アギアにぶつかるリスクを冒したくなかった"}, {"type": "subtitle", "time": 19806.03, "timestamp": "05:30:06", "text": "野生"}, {"type": "subtitle", "time": 19809.91, "timestamp": "05:30:09", "text": "弓。彼は森林地帯にたどり着いた。私はそうしなければならない"}, {"type": "subtitle", "time": 19812.948, "timestamp": "05:30:12", "text": "近い、と彼は思い、アクセルを踏んだ。"}, {"type": "subtitle", "time": 19815.35, "timestamp": "05:30:15", "text": "もう少し強くペダルを漕いでください。"}, {"type": "subtitle", "time": 19817.708, "timestamp": "05:30:17", "text": "危険な場所を通過した後"}, {"type": "subtitle", "time": 19820.548, "timestamp": "05:30:20", "text": "縁石で、ジャックはライトの1つを見つけた"}, {"type": "subtitle", "time": 19823.548, "timestamp": "05:30:23", "text": "ライトのすぐ後ろにあるポール"}, {"type": "subtitle", "time": 19827.03, "timestamp": "05:30:27", "text": "ポール。そこには次のような看板があった。"}, {"type": "subtitle", "time": 19828.51, "timestamp": "05:30:28", "text": "ガスがあった"}, {"type": "subtitle", "time": 19830.35, "timestamp": "05:30:30", "text": "駅"}, {"type": "subtitle", "time": 19833.948, "timestamp": "05:30:33", "text": "約1マイル下った"}, {"type": "subtitle", "time": 19838.23, "timestamp": "05:30:38", "text": "道。彼は楽器に目をやった"}, {"type": "subtitle", "time": 19841.75, "timestamp": "05:30:41", "text": "インパネ。それは、"}, {"type": "subtitle", "time": 19846.11, "timestamp": "05:30:46", "text": "まだガスが"}, {"type": "subtitle", "time": 19849.75, "timestamp": "05:30:49", "text": "タンク。看板を振り返って見ると、"}, {"type": "subtitle", "time": 19852.47, "timestamp": "05:30:52", "text": "ライトが正常に作動していなかった。それ"}, {"type": "subtitle", "time": 19854.43, "timestamp": "05:30:54", "text": "色あせ続け、"}, {"type": "subtitle", "time": 19857.948, "timestamp": "05:30:57", "text": "再び明るくなった。それは奇妙だった"}]
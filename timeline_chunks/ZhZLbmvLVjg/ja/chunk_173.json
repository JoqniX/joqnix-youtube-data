[{"type": "subtitle", "time": 10386.91, "timestamp": "02:53:06", "text": "皆さん、どうですか？"}, {"type": "subtitle", "time": 10389.63, "timestamp": "02:53:09", "text": "えっと、３、１ドルあります"}, {"type": "subtitle", "time": 10392.14, "timestamp": "02:53:12", "text": "番号。"}, {"type": "subtitle", "time": 10400.63, "timestamp": "02:53:20", "text": "待って。えっと、fluff は健全という意味だと思います"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "愛情深く、ただ冷酷なだけではない。"}, {"type": "subtitle", "time": 10407.03, "timestamp": "02:53:27", "text": "ああ、わかってるよ。私はそのことを知りませんでした"}, {"type": "subtitle", "time": 10410.03, "timestamp": "02:53:30", "text": "言葉。教えてくださってありがとうございます"}, {"type": "subtitle", "time": 10412.99, "timestamp": "02:53:32", "text": "それはつまり"}, {"type": "subtitle", "time": 10419.51, "timestamp": "02:53:39", "text": "の上。待って、ここは一体何？私は決して"}, {"type": "subtitle", "time": 10421.07, "timestamp": "02:53:41", "text": "された"}, {"type": "subtitle", "time": 10434.07, "timestamp": "02:53:54", "text": "さて、次は帽子です。"}, {"type": "subtitle", "time": 10436.59, "timestamp": "02:53:56", "text": "その男は"}, {"type": "subtitle", "time": 10439.23, "timestamp": "02:53:59", "text": "酔っ払って"}]
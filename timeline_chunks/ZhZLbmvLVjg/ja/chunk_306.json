[{"type": "subtitle", "time": 18361.03, "timestamp": "05:06:01", "text": "シャンプー。あ、待って。なぜ壊れているのですか？その"}, {"type": "subtitle", "time": 18362.67, "timestamp": "05:06:02", "text": "壊れた。その"}, {"type": "subtitle", "time": 18369.51, "timestamp": "05:06:09", "text": "壊れた。えーと、例えば、"}, {"type": "subtitle", "time": 18371.788, "timestamp": "05:06:11", "text": "これ"}, {"type": "subtitle", "time": 18376.39, "timestamp": "05:06:16", "text": "今。負荷。うん。うん。負荷。それはまるで"}, {"type": "subtitle", "time": 18379.03, "timestamp": "05:06:19", "text": "文字通り壊れている。なぜ、何がジョックなのか"}, {"type": "subtitle", "time": 18383.59, "timestamp": "05:06:23", "text": "重要なことは？ああ、神様。うん。ほら、いいじゃないか"}, {"type": "subtitle", "time": 18385.59, "timestamp": "05:06:25", "text": "すべてですが、私は"}, {"type": "subtitle", "time": 18387.948, "timestamp": "05:06:27", "text": "口は"}, {"type": "subtitle", "time": 18389.948, "timestamp": "05:06:29", "text": "ああ、まるで"}, {"type": "subtitle", "time": 18394.23, "timestamp": "05:06:34", "text": "広い。そちらの方が幅が広い。私は開けることができません"}, {"type": "subtitle", "time": 18397.99, "timestamp": "05:06:37", "text": "そんな口の仕方。奇妙だ。私は"}, {"type": "subtitle", "time": 18400.17, "timestamp": "05:06:40", "text": "少し"}, {"type": "subtitle", "time": 18401.868, "timestamp": "05:06:41", "text": "[音楽]"}, {"type": "subtitle", "time": 18405.83, "timestamp": "05:06:45", "text": "口。開けてみたいですね。とても広い。 N"}, {"type": "subtitle", "time": 18408.35, "timestamp": "05:06:48", "text": "これは"}, {"type": "subtitle", "time": 18410.59, "timestamp": "05:06:50", "text": "もの？なぜ"}, {"type": "subtitle", "time": 18414.99, "timestamp": "05:06:54", "text": "なぜ私は口を開ける必要があるのか"}, {"type": "subtitle", "time": 18419.47, "timestamp": "05:06:59", "text": "彼女が姿を現すには、どれだけの努力が必要だったのでしょうか？"}]
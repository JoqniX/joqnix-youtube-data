[{"type": "subtitle", "time": 4221.07, "timestamp": "01:10:21", "text": "私たちは、ああ、私はこうして行かなければならない。"}, {"type": "subtitle", "time": 4223.55, "timestamp": "01:10:23", "text": "よし、来い"}, {"type": "subtitle", "time": 4227.03, "timestamp": "01:10:27", "text": "戻る。私は気にしない、気にしない、気にしない"}, {"type": "subtitle", "time": 4229.229, "timestamp": "01:10:29", "text": "私の発電所の近くです。"}, {"type": "subtitle", "time": 4231.35, "timestamp": "01:10:31", "text": "それが復活した。これは初めてです"}, {"type": "subtitle", "time": 4249.99, "timestamp": "01:10:49", "text": "行く。だから、えーと、これが私ができる唯一の方法です"}, {"type": "subtitle", "time": 4252.229, "timestamp": "01:10:52", "text": "対照群を見つける。私たちは方法を見つけなければなりませんでした"}, {"type": "subtitle", "time": 4253.75, "timestamp": "01:10:53", "text": "ただし、部屋へのアクセスは必要です。見てみましょう"}, {"type": "subtitle", "time": 4256.91, "timestamp": "01:10:56", "text": "その周り。こんにちは、ヤシュ。"}, {"type": "subtitle", "time": 4259.669, "timestamp": "01:10:59", "text": "シャシュ。周りを見渡してみましょう。つまり、これは"}]
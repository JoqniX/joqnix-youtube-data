[{"type": "subtitle", "time": 7985.39, "timestamp": "02:13:05", "text": "彼ら。私はたくさん"}, {"type": "subtitle", "time": 7988.709, "timestamp": "02:13:08", "text": "間違っている。どうやらそう聞こえるらしい"}, {"type": "subtitle", "time": 7994.99, "timestamp": "02:13:14", "text": "ええ、私は個人でやりました"}, {"type": "subtitle", "time": 8002.91, "timestamp": "02:13:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8005.43, "timestamp": "02:13:25", "text": "などなど、例えば「おはようございます」といった感じ"}, {"type": "subtitle", "time": 8008.629, "timestamp": "02:13:28", "text": "警報関連のもの。そこに彼らは"}, {"type": "subtitle", "time": 8012.87, "timestamp": "02:13:32", "text": "私の実験対象者のようなものだ。"}, {"type": "subtitle", "time": 8016.589, "timestamp": "02:13:36", "text": "えーと、私は"}, {"type": "subtitle", "time": 8018.51, "timestamp": "02:13:38", "text": "えっと、声"}, {"type": "subtitle", "time": 8021.589, "timestamp": "02:13:41", "text": "あれ、ボイスパック。だから私はこう思った"}, {"type": "subtitle", "time": 8024.83, "timestamp": "02:13:44", "text": "試すために"}, {"type": "subtitle", "time": 8032.109, "timestamp": "02:13:52", "text": "もの。"}, {"type": "subtitle", "time": 8036.2, "timestamp": "02:13:56", "text": "ええ、それらは完璧とは言えませんでした。"}, {"type": "subtitle", "time": 8039.109, "timestamp": "02:13:59", "text": "[音楽]"}]
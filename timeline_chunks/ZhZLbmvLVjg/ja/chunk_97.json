[{"type": "subtitle", "time": 5820.99, "timestamp": "01:37:00", "text": "できる"}, {"type": "subtitle", "time": 5825.109, "timestamp": "01:37:05", "text": "それ。でも、それはつまり、私は"}, {"type": "subtitle", "time": 5827.629, "timestamp": "01:37:07", "text": "またお皿だ。私"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "やめてください。しかし、３人に何が起こったのか"}, {"type": "subtitle", "time": 5832.109, "timestamp": "01:37:12", "text": "少し"}, {"type": "subtitle", "time": 5835.35, "timestamp": "01:37:15", "text": "子猫？私たちの子猫たち。私はしませんでした"}, {"type": "subtitle", "time": 5849.27, "timestamp": "01:37:29", "text": "H. そうですね、それとも終わらせるべきでしょうか"}, {"type": "subtitle", "time": 5852.47, "timestamp": "01:37:32", "text": "ここ？わからない。私がどう思うか"}, {"type": "subtitle", "time": 5853.31, "timestamp": "01:37:33", "text": "すべき"}, {"type": "subtitle", "time": 5858.109, "timestamp": "01:37:38", "text": "する？ 「続行」を押したらどうなりますか？何が"}, {"type": "subtitle", "time": 5860.56, "timestamp": "01:37:40", "text": "起こる？新しいゲームを開始します"}, {"type": "subtitle", "time": 5862.669, "timestamp": "01:37:42", "text": "[音楽]"}, {"type": "subtitle", "time": 5865.31, "timestamp": "01:37:45", "text": "プラス。ああ、それは"}, {"type": "subtitle", "time": 5867.149, "timestamp": "01:37:47", "text": "ここ。"}, {"type": "subtitle", "time": 5871.35, "timestamp": "01:37:51", "text": "はい、これはニューゲームプラスからのものです。わかった。"}, {"type": "subtitle", "time": 5874.47, "timestamp": "01:37:54", "text": "前作からのニューゲームプラスではない。"}, {"type": "subtitle", "time": 5876.55, "timestamp": "01:37:56", "text": "それでね、知ってる？これらを完了しましょう"}, {"type": "subtitle", "time": 5879.31, "timestamp": "01:37:59", "text": "もの。屋上、"}]
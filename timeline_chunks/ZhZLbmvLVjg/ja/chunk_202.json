[{"type": "subtitle", "time": 12136.49, "timestamp": "03:22:16", "text": "来る"}, {"type": "subtitle", "time": 12157.83, "timestamp": "03:22:37", "text": "の上。ああ、神様、私は死んでしまった。それはやりすぎだった。"}, {"type": "subtitle", "time": 12171.349, "timestamp": "03:22:51", "text": "それ。いや。ああ、くしゃみが止まらない。"}, {"type": "subtitle", "time": 12174.87, "timestamp": "03:22:54", "text": "絶対に音量を上げないでください。"}]
[{"type": "subtitle", "time": 2703.47, "timestamp": "00:45:03", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 2711.71, "timestamp": "00:45:11", "text": "だから、溶岩を見つける必要がある"}, {"type": "subtitle", "time": 2746.95, "timestamp": "00:45:46", "text": "私は友達が集まるパーティーに行く"}, {"type": "subtitle", "time": 2749.75, "timestamp": "00:45:49", "text": "たとえ夜遅くまで"}, {"type": "subtitle", "time": 2751.589, "timestamp": "00:45:51", "text": "迷惑な結果に苦しむ"}, {"type": "subtitle", "time": 2754.47, "timestamp": "00:45:54", "text": "翌朝。まあ、喜びを見つけるのは良いことだ"}, {"type": "subtitle", "time": 2757.19, "timestamp": "00:45:57", "text": "居住不可能な地表にもかかわらず。"}, {"type": "subtitle", "time": 2758.79, "timestamp": "00:45:58", "text": "地下生活環境は"}]
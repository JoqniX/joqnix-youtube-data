[{"type": "subtitle", "time": 13331.11, "timestamp": "03:42:11", "text": "私は何かを探しているのですが、"}, {"type": "subtitle", "time": 13339.429, "timestamp": "03:42:19", "text": "それ。私はほとんどすべてを探検しました"}, {"type": "subtitle", "time": 13371.71, "timestamp": "03:42:51", "text": "ここ。私がこれをすれば、彼は"}, {"type": "subtitle", "time": 13375.79, "timestamp": "03:42:55", "text": "シュシュになる。彼はコンピュータサイエンスが好きではない。"}]
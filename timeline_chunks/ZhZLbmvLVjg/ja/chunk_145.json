[{"type": "subtitle", "time": 8703.95, "timestamp": "02:25:03", "text": "良い。大丈夫です。私はただ戦う必要がある"}, {"type": "subtitle", "time": 8723.27, "timestamp": "02:25:23", "text": "ああ、降りてよ。降りる。わかった。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 8724.91, "timestamp": "02:25:24", "text": "ほとんど"}, {"type": "subtitle", "time": 8729.11, "timestamp": "02:25:29", "text": "亡くなった。設定してください。あ、待って。なぜ"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "映画『ドキオ』のセット？そうなると思った"}, {"type": "subtitle", "time": 8733.71, "timestamp": "02:25:33", "text": "音楽に関するものであること。設定する"}, {"type": "subtitle", "time": 8736.389, "timestamp": "02:25:36", "text": "それ。実際、最初のビデオを最後に見た"}, {"type": "subtitle", "time": 8738.75, "timestamp": "02:25:38", "text": "年。"}, {"type": "subtitle", "time": 8741.71, "timestamp": "02:25:41", "text": "ああ、それは"}, {"type": "subtitle", "time": 8745.11, "timestamp": "02:25:45", "text": "大学生ですよね？うん。する"}]
[{"type": "subtitle", "time": 16740.31, "timestamp": "04:39:00", "text": "良い。オレンジ色って、金色みたいな色だよね？いいえ、"}, {"type": "subtitle", "time": 16743.23, "timestamp": "04:39:03", "text": "待って、待って、いや、"}, {"type": "subtitle", "time": 16746.551, "timestamp": "04:39:06", "text": "待って。いいえ、オレンジはオレンジです。行く。あなた"}, {"type": "subtitle", "time": 16748.869, "timestamp": "04:39:08", "text": "知ってるよ、私がいる部屋は、"}, {"type": "subtitle", "time": 16750.109, "timestamp": "04:39:10", "text": "すべては"}, {"type": "subtitle", "time": 16754.269, "timestamp": "04:39:14", "text": "オレンジ色や金色のような"}, {"type": "subtitle", "time": 16759.07, "timestamp": "04:39:19", "text": "黒のように。私はそれを知っています"}, {"type": "subtitle", "time": 16763.05, "timestamp": "04:39:23", "text": "あれ。ああ、私は下手です"}, {"type": "subtitle", "time": 16768.75, "timestamp": "04:39:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16772.551, "timestamp": "04:39:32", "text": "これ。オレンジ色の物体。私の首ちゃん"}, {"type": "subtitle", "time": 16775.869, "timestamp": "04:39:35", "text": "えっと、首。これこれ"}, {"type": "subtitle", "time": 16778.0, "timestamp": "04:39:38", "text": "呼吸。できますか"}, {"type": "subtitle", "time": 16780.27, "timestamp": "04:39:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16783.59, "timestamp": "04:39:43", "text": "それ？まるで、ほら、君が"}, {"type": "subtitle", "time": 16787.03, "timestamp": "04:39:47", "text": "ほら、顎を顔にこすりつけるように"}, {"type": "subtitle", "time": 16790.628, "timestamp": "04:39:50", "text": "ネオちゃんの耳。ああ、もしそれが"}, {"type": "subtitle", "time": 16794.99, "timestamp": "04:39:54", "text": "実際のネコちゃん、もしくは小さなえーと"}, {"type": "subtitle", "time": 16798.51, "timestamp": "04:39:58", "text": "生き物。すごく可愛いと思うよ。"}]
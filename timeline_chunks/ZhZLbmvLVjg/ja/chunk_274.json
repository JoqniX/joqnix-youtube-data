[{"type": "subtitle", "time": 16440.949, "timestamp": "04:34:00", "text": "ハロウィン？"}, {"type": "subtitle", "time": 16443.029, "timestamp": "04:34:03", "text": "待って、ストリーミングは"}, {"type": "subtitle", "time": 16444.51, "timestamp": "04:34:04", "text": "これ"}, {"type": "subtitle", "time": 16447.83, "timestamp": "04:34:07", "text": "時間？私の理解が正しければ、あなたは"}, {"type": "subtitle", "time": 16455.789, "timestamp": "04:34:15", "text": "ストリーム？通常、"}, {"type": "subtitle", "time": 16459.109, "timestamp": "04:34:19", "text": "zukama は通常、"}, {"type": "subtitle", "time": 16462.15, "timestamp": "04:34:22", "text": "夏か12歳くらいの頃、"}, {"type": "subtitle", "time": 16468.789, "timestamp": "04:34:28", "text": "最近は10歳くらいの少年みたいに眠くて仕方がない"}, {"type": "subtitle", "time": 16472.15, "timestamp": "04:34:32", "text": "あるいは9だけど、私の一部はジョッキーが"}, {"type": "subtitle", "time": 16476.15, "timestamp": "04:34:36", "text": "やるべき仕事がある。それで私は「わかった、それなら"}, {"type": "subtitle", "time": 16478.47, "timestamp": "04:34:38", "text": "もし私がPCをシャットダウンして、"}, {"type": "subtitle", "time": 16481.189, "timestamp": "04:34:41", "text": "寝なさい、気が散ってしまうから"}, {"type": "subtitle", "time": 16483.75, "timestamp": "04:34:43", "text": "音楽を聴くのが好きで、"}, {"type": "subtitle", "time": 16485.51, "timestamp": "04:34:45", "text": "音楽を聴いているときは"}, {"type": "subtitle", "time": 16487.59, "timestamp": "04:34:47", "text": "2つ、私が一緒に歌うか、好きなもの"}, {"type": "subtitle", "time": 16490.47, "timestamp": "04:34:50", "text": "眠りにつくか、あるいはただ感じる"}, {"type": "subtitle", "time": 16493.51, "timestamp": "04:34:53", "text": "ハイパーか、インスピレーションを感じて試してみます"}, {"type": "subtitle", "time": 16496.629, "timestamp": "04:34:56", "text": "何かを録音したり、一緒に歌ったりする"}, {"type": "subtitle", "time": 16499.99, "timestamp": "04:34:59", "text": "そして、いくつかのことについて深く考える"}]
[{"type": "subtitle", "time": 1444.31, "timestamp": "00:24:04", "text": "えっと、茶色っぽい色の猫がいます。白"}, {"type": "subtitle", "time": 1456.59, "timestamp": "00:24:16", "text": "もろい。つまり３人ってことですよね？"}, {"type": "subtitle", "time": 1460.99, "timestamp": "00:24:20", "text": "ホワイト、クロ、ブラッキー、または"}, {"type": "subtitle", "time": 1469.51, "timestamp": "00:24:29", "text": "チャット。まあ、私は配信するには珍しい時間帯にいます。"}, {"type": "subtitle", "time": 1471.669, "timestamp": "00:24:31", "text": "いや、この時に配信したかったんだ"}, {"type": "subtitle", "time": 1472.88, "timestamp": "00:24:32", "text": "時間"}, {"type": "subtitle", "time": 1474.43, "timestamp": "00:24:34", "text": "[音楽]"}, {"type": "subtitle", "time": 1478.07, "timestamp": "00:24:38", "text": "実は。いや、いや、私は死んだんだ。私は"}, {"type": "subtitle", "time": 1479.789, "timestamp": "00:24:39", "text": "脱出するが、"}, {"type": "subtitle", "time": 1483.669, "timestamp": "00:24:43", "text": "ああ、そう、私の配信はこんな感じになるよ"}, {"type": "subtitle", "time": 1486.43, "timestamp": "00:24:46", "text": "この時。私はそれをやろうとしています"}, {"type": "subtitle", "time": 1489.19, "timestamp": "00:24:49", "text": "朝。私は変えようとしています"}, {"type": "subtitle", "time": 1492.549, "timestamp": "00:24:52", "text": "これからは朝の時間なので"}, {"type": "subtitle", "time": 1496.07, "timestamp": "00:24:56", "text": "夕方にはリラックスできるかな？"}, {"type": "subtitle", "time": 1498.19, "timestamp": "00:24:58", "text": "そして"}]
[{"type": "subtitle", "time": 15490.83, "timestamp": "04:18:10", "text": "[音楽]"}, {"type": "subtitle", "time": 15494.55, "timestamp": "04:18:14", "text": "こんにちは。さあ、行って。私は何かやっていた"}, {"type": "subtitle", "time": 15497.83, "timestamp": "04:18:17", "text": "あなたは地域活動を知っていて、人を助けるのが好きです"}, {"type": "subtitle", "time": 15500.309, "timestamp": "04:18:20", "text": "他のユーチューバーたちが準備している"}, {"type": "subtitle", "time": 15504.429, "timestamp": "04:18:24", "text": "流れが上がって、それからそれから"}, {"type": "subtitle", "time": 15507.91, "timestamp": "04:18:27", "text": "えーっと、私が走り回っていた間ずっと"}, {"type": "subtitle", "time": 15509.71, "timestamp": "04:18:29", "text": "左と"}, {"type": "subtitle", "time": 15513.11, "timestamp": "04:18:33", "text": "右。私はこれが本当にひどい"}, {"type": "subtitle", "time": 15523.83, "timestamp": "04:18:43", "text": "自分。でも、今日は、"}, {"type": "subtitle", "time": 15527.269, "timestamp": "04:18:47", "text": "すでに午後11時。ハロウィンは"}, {"type": "subtitle", "time": 15528.91, "timestamp": "04:18:48", "text": "ほとんど"}, {"type": "subtitle", "time": 15531.63, "timestamp": "04:18:51", "text": "以上。しかし"}, {"type": "subtitle", "time": 15534.79, "timestamp": "04:18:54", "text": "ええ、皆さんのハロウィンはどうでしたか？"}, {"type": "subtitle", "time": 15537.83, "timestamp": "04:18:57", "text": "みんな、何か不気味なことをしたって知ってた？"}, {"type": "subtitle", "time": 15539.51, "timestamp": "04:18:59", "text": "不気味な感じ？それとも何か？何が"}]
[{"type": "subtitle", "time": 4080.63, "timestamp": "01:08:00", "text": "このかわいそうな男は、"}, {"type": "subtitle", "time": 4082.19, "timestamp": "01:08:02", "text": "反抗する"}, {"type": "subtitle", "time": 4085.51, "timestamp": "01:08:05", "text": "彼ら。彼に何が起こったのですか？彼らは持っている"}, {"type": "subtitle", "time": 4087.349, "timestamp": "01:08:07", "text": "感情を完全に消し去り、"}, {"type": "subtitle", "time": 4089.51, "timestamp": "01:08:09", "text": "自己認識はあるが、記憶はもうない。さあ"}, {"type": "subtitle", "time": 4092.069, "timestamp": "01:08:12", "text": "捕まらないようにしましょう。ああ、それ"}, {"type": "subtitle", "time": 4095.07, "timestamp": "01:08:15", "text": "それが私の最後の記憶だった。最後の枠です。"}, {"type": "subtitle", "time": 4097.349, "timestamp": "01:08:17", "text": "わかった。そして、収集を続けましょう。"}, {"type": "subtitle", "time": 4115.07, "timestamp": "01:08:35", "text": "これ。全て"}, {"type": "subtitle", "time": 4117.55, "timestamp": "01:08:37", "text": "右。私たちは"}, {"type": "subtitle", "time": 4119.42, "timestamp": "01:08:39", "text": "両方を下げる"}, {"type": "subtitle", "time": 4121.709, "timestamp": "01:08:41", "text": "[音楽]"}, {"type": "subtitle", "time": 4124.43, "timestamp": "01:08:44", "text": "彼ら。両方とも下げます"}, {"type": "subtitle", "time": 4127.789, "timestamp": "01:08:47", "text": "彼ら。上へ"}, {"type": "subtitle", "time": 4129.63, "timestamp": "01:08:49", "text": "ここ。する"}, {"type": "subtitle", "time": 4138.99, "timestamp": "01:08:58", "text": "私は戻ってきて閉じます"}]
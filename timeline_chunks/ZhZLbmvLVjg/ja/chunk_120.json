[{"type": "subtitle", "time": 7220.07, "timestamp": "02:00:20", "text": "バー。私は見ませんでした。皆さんは見ましたか？"}, {"type": "subtitle", "time": 7222.229, "timestamp": "02:00:22", "text": "安全なサイン？私は見ていないと思います"}, {"type": "subtitle", "time": 7224.91, "timestamp": "02:00:24", "text": "安全標識。"}, {"type": "subtitle", "time": 7247.629, "timestamp": "02:00:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7252.75, "timestamp": "02:00:52", "text": "ねえ、全部終わらせなきゃいけないんだ。ああ、"}, {"type": "subtitle", "time": 7256.35, "timestamp": "02:00:56", "text": "神。しかし、私たちはこれをすべてやり遂げました"}]
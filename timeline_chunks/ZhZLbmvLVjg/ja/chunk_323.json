[{"type": "subtitle", "time": 19380.75, "timestamp": "05:23:00", "text": "第1章。わかった。何かが外にある"}, {"type": "subtitle", "time": 19383.55, "timestamp": "05:23:03", "text": "ここ。わかった。やろう"}, {"type": "subtitle", "time": 19386.708, "timestamp": "05:23:06", "text": "これ。何も怖いことはない。眠れません。こんにちは、"}, {"type": "subtitle", "time": 19389.35, "timestamp": "05:23:09", "text": "マスカラを塗ります。 ASMRが欲しいですか？"}, {"type": "subtitle", "time": 19392.788, "timestamp": "05:23:12", "text": "実際、ASMRは要らないのですか？選ぶ"}, {"type": "subtitle", "time": 19394.19, "timestamp": "05:23:14", "text": "あなたの"}, {"type": "subtitle", "time": 19397.75, "timestamp": "05:23:17", "text": "部分。もしご希望でしたら、そうすることもできますよ。"}, {"type": "subtitle", "time": 19399.51, "timestamp": "05:23:19", "text": "ファンを消して、"}, {"type": "subtitle", "time": 19400.99, "timestamp": "05:23:20", "text": "文字通り読んでください。それは"}, {"type": "subtitle", "time": 19403.91, "timestamp": "05:23:23", "text": "それ。 ASMRみたいなのが欲しいなら、"}, {"type": "subtitle", "time": 19406.15, "timestamp": "05:23:26", "text": "それは可能です。 ASMRは含まれていません。あなたは望んでいない"}, {"type": "subtitle", "time": 19407.07, "timestamp": "05:23:27", "text": "それ？"}, {"type": "subtitle", "time": 19409.628, "timestamp": "05:23:29", "text": "わかった。"}, {"type": "subtitle", "time": 19419.03, "timestamp": "05:23:39", "text": "何かサインを書いてください。なぜ？なぜ私は"}, {"type": "subtitle", "time": 19421.59, "timestamp": "05:23:41", "text": "まるで歌を歌うかのように録音する"}, {"type": "subtitle", "time": 19423.59, "timestamp": "05:23:43", "text": "何か例を挙げてみて？そうそう。"}, {"type": "subtitle", "time": 19424.99, "timestamp": "05:23:44", "text": "さあ"}, {"type": "subtitle", "time": 19427.948, "timestamp": "05:23:47", "text": "行く。要約が必要ですか？"}, {"type": "subtitle", "time": 19429.55, "timestamp": "05:23:49", "text": "これ？"}, {"type": "subtitle", "time": 19435.31, "timestamp": "05:23:55", "text": "わかった。それは何か外にある"}, {"type": "subtitle", "time": 19438.43, "timestamp": "05:23:58", "text": "オールドスクール"}]
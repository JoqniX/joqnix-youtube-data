[{"type": "subtitle", "time": 14822.349, "timestamp": "04:07:02", "text": "こんにちは。家に着いた"}, {"type": "subtitle", "time": 14828.67, "timestamp": "04:07:08", "text": "運。本当は"}, {"type": "subtitle", "time": 14832.349, "timestamp": "04:07:12", "text": "多く。楽しんでいただけたでしょうか"}, {"type": "subtitle", "time": 14835.469, "timestamp": "04:07:15", "text": "運。それは本当に"}, {"type": "subtitle", "time": 14838.95, "timestamp": "04:07:18", "text": "多く。来てくれてありがとう。本当に"}, {"type": "subtitle", "time": 14843.67, "timestamp": "04:07:23", "text": "とても意味があります。元気だった？"}, {"type": "subtitle", "time": 14846.389, "timestamp": "04:07:26", "text": "あなたのチャットを見逃してしまいましたか？私はそう思います"}, {"type": "subtitle", "time": 14850.469, "timestamp": "04:07:30", "text": "あなたがいなくて寂しい。電話するのを忘れた"}, {"type": "subtitle", "time": 14851.389, "timestamp": "04:07:31", "text": "あなた"}, {"type": "subtitle", "time": 14864.71, "timestamp": "04:07:44", "text": "lingは本当に大きな意味を持つ。そして最後に、"}, {"type": "subtitle", "time": 14876.63, "timestamp": "04:07:56", "text": "ええ、ちゃんと食事を済ませたことを願っています。あなた"}, {"type": "subtitle", "time": 14878.95, "timestamp": "04:07:58", "text": "君はそれを受けるって言ってたよね？こんにちは。来る"}]
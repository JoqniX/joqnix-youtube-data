[{"type": "subtitle", "time": 12721.79, "timestamp": "03:32:01", "text": "いいえ、私に"}, {"type": "subtitle", "time": 12760.79, "timestamp": "03:32:40", "text": "砂糖。私は危うく「バー」と言いそうになった。おお"}, {"type": "subtitle", "time": 12769.229, "timestamp": "03:32:49", "text": "えっと"}, {"type": "subtitle", "time": 12772.269, "timestamp": "03:32:52", "text": "今は私は保持しますいいえ私は保持します"}, {"type": "subtitle", "time": 12774.469, "timestamp": "03:32:54", "text": "uhabooga は意味を持つため"}, {"type": "subtitle", "time": 12777.269, "timestamp": "03:32:57", "text": "自分。自分の名前が「私」だと分かりました。もし彼らが"}, {"type": "subtitle", "time": 12779.83, "timestamp": "03:32:59", "text": "今まで私を見た人は笑って、私の"}]
[{"type": "subtitle", "time": 4627.79, "timestamp": "01:17:07", "text": "私はどこにいるのか"}, {"type": "subtitle", "time": 4636.03, "timestamp": "01:17:16", "text": "私？"}, {"type": "subtitle", "time": 4648.669, "timestamp": "01:17:28", "text": "そこには。続けて。それが彼が"}, {"type": "subtitle", "time": 4679.87, "timestamp": "01:17:59", "text": "右？だから、スーパー"}]
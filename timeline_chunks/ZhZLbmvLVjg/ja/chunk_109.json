[{"type": "subtitle", "time": 6540.07, "timestamp": "01:49:00", "text": "思いやり。でも、私が"}, {"type": "subtitle", "time": 6544.149, "timestamp": "01:49:04", "text": "彼らは男ではないと言っている"}, {"type": "subtitle", "time": 6546.87, "timestamp": "01:49:06", "text": "えーと、親切とかそういう人じゃない人。の"}, {"type": "subtitle", "time": 6549.07, "timestamp": "01:49:09", "text": "もちろん彼らは"}, {"type": "subtitle", "time": 6550.92, "timestamp": "01:49:10", "text": "は。しかし"}, {"type": "subtitle", "time": 6553.709, "timestamp": "01:49:13", "text": "[音楽]"}, {"type": "subtitle", "time": 6558.07, "timestamp": "01:49:18", "text": "うん、それは私、マスカランは男性を作る"}, {"type": "subtitle", "time": 6567.47, "timestamp": "01:49:27", "text": "よし、じゃあスピードランしてみよう。"}, {"type": "subtitle", "time": 6570.629, "timestamp": "01:49:30", "text": "本当は完全に終わらせるはずだった"}, {"type": "subtitle", "time": 6574.51, "timestamp": "01:49:34", "text": "この章を保存してください。知りませんでした"}, {"type": "subtitle", "time": 6598.51, "timestamp": "01:49:58", "text": "開けて"}]
[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "初めてです。なぜ人々が"}, {"type": "subtitle", "time": 18007.47, "timestamp": "05:00:07", "text": "なぜこんなに壊れているのか"}, {"type": "subtitle", "time": 18010.91, "timestamp": "05:00:10", "text": "さらに大きな理由"}, {"type": "subtitle", "time": 18024.83, "timestamp": "05:00:24", "text": "あまりにも？"}, {"type": "subtitle", "time": 18027.83, "timestamp": "05:00:27", "text": "パパ、それはあなたが望むようなものではありません"}, {"type": "subtitle", "time": 18031.99, "timestamp": "05:00:31", "text": "他の誰よりも立ち上がる"}, {"type": "subtitle", "time": 18035.11, "timestamp": "05:00:35", "text": "それとも何か別のこと？ああ、今気づいたんだけど"}, {"type": "subtitle", "time": 18037.628, "timestamp": "05:00:37", "text": "ディスコードが実際には"}, {"type": "subtitle", "time": 18041.83, "timestamp": "05:00:41", "text": "えっと、実際には数が増えているんですね？"}, {"type": "subtitle", "time": 18043.31, "timestamp": "05:00:43", "text": "その中で"}, {"type": "subtitle", "time": 18058.07, "timestamp": "05:00:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 17403.91, "timestamp": "04:50:03", "text": "母への私の尊敬はチャートを駆け巡った"}, {"type": "subtitle", "time": 17406.51, "timestamp": "04:50:06", "text": "だって、彼が"}, {"type": "subtitle", "time": 17410.99, "timestamp": "04:50:10", "text": "えっと、それよりも前に"}, {"type": "subtitle", "time": 17414.23, "timestamp": "04:50:14", "text": "ニ。うん。こんにちは、マリンSさん。ようこそ。"}, {"type": "subtitle", "time": 17415.51, "timestamp": "04:50:15", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。うん。"}, {"type": "subtitle", "time": 17418.15, "timestamp": "04:50:18", "text": "こんにちは、ヴィック。うん。こんにちは、ビクター。希望"}, {"type": "subtitle", "time": 17421.99, "timestamp": "04:50:21", "text": "あなたはよくやっています。うん。こんにちは、Dub Sさん。"}, {"type": "subtitle", "time": 17423.27, "timestamp": "04:50:23", "text": "いらっしゃいませ。いらっしゃいませ。皆さんが"}, {"type": "subtitle", "time": 17426.15, "timestamp": "04:50:26", "text": "順調です。ハッピーハロウィン。"}, {"type": "subtitle", "time": 17428.51, "timestamp": "04:50:28", "text": "そう、それが理由"}, {"type": "subtitle", "time": 17433.03, "timestamp": "04:50:33", "text": "私が尊敬している理由は、そしてまた、ニャーは"}, {"type": "subtitle", "time": 17433.788, "timestamp": "04:50:33", "text": "私の"}, {"type": "subtitle", "time": 17437.11, "timestamp": "04:50:37", "text": "先輩。ああ、ニャーが"}, {"type": "subtitle", "time": 17438.22, "timestamp": "04:50:38", "text": "私の"}, {"type": "subtitle", "time": 17445.41, "timestamp": "04:50:45", "text": "先輩。おお、"}, {"type": "subtitle", "time": 17447.788, "timestamp": "04:50:47", "text": "[音楽]"}, {"type": "subtitle", "time": 17450.91, "timestamp": "04:50:50", "text": "待って。そうしてください。"}, {"type": "subtitle", "time": 17458.07, "timestamp": "04:50:58", "text": "Discordで何か見かけた。ちょっと待ってください"}, {"type": "subtitle", "time": 17458.91, "timestamp": "04:50:58", "text": "する"}]
[{"type": "subtitle", "time": 1871.87, "timestamp": "00:31:11", "text": "持続する"}, {"type": "subtitle", "time": 1876.269, "timestamp": "00:31:16", "text": "ここ。電源を切ってください。行く"}, {"type": "subtitle", "time": 1878.43, "timestamp": "00:31:18", "text": "上。乗り越える"}, {"type": "subtitle", "time": 1891.43, "timestamp": "00:31:31", "text": "ここ。あ、着信音が鳴った。それで、"}, {"type": "subtitle", "time": 1894.43, "timestamp": "00:31:34", "text": "待って。この通話はまさにそれを行っています"}, {"type": "subtitle", "time": 1898.31, "timestamp": "00:31:38", "text": "それ？持続する。もう一度、これを台無しにさせてください。"}, {"type": "subtitle", "time": 1901.269, "timestamp": "00:31:41", "text": "1秒。 Discordはどこでこれをやっているのですか？"}, {"type": "subtitle", "time": 1906.95, "timestamp": "00:31:46", "text": "ごめん。わかった。これです。 １、２。わかった。"}, {"type": "subtitle", "time": 1908.669, "timestamp": "00:31:48", "text": "さあ"}, {"type": "subtitle", "time": 1913.149, "timestamp": "00:31:53", "text": "行く。電話してください。うん。"}, {"type": "subtitle", "time": 1915.63, "timestamp": "00:31:55", "text": "待って。これを"}, {"type": "subtitle", "time": 1917.389, "timestamp": "00:31:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 3901.029, "timestamp": "01:05:01", "text": "トップ？ああ、私を乗せてくれるの？"}, {"type": "subtitle", "time": 3919.95, "timestamp": "01:05:19", "text": "1つ。開けてもいいですか？"}, {"type": "subtitle", "time": 3922.549, "timestamp": "01:05:22", "text": "これ？道を塞いでください。彼らは彼らは"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "私を即座にスポーンさせてください。餌にできるかもしれない"}, {"type": "subtitle", "time": 3926.15, "timestamp": "01:05:26", "text": "彼らを独房に閉じ込めて鍵をかけるんだ。"}, {"type": "subtitle", "time": 3928.349, "timestamp": "01:05:28", "text": "わかった。私はできます"}, {"type": "subtitle", "time": 3930.99, "timestamp": "01:05:30", "text": "それ。うん。感謝"}, {"type": "subtitle", "time": 3934.63, "timestamp": "01:05:34", "text": "あなた。つまり、こういうことなんです。私はします"}, {"type": "subtitle", "time": 3936.109, "timestamp": "01:05:36", "text": "彼を誘い出す"}, {"type": "subtitle", "time": 3950.349, "timestamp": "01:05:50", "text": "ああ、遅刻してしまった。わかりました、やります"}]
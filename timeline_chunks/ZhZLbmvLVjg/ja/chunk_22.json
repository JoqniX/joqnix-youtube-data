[{"type": "subtitle", "time": 1338.43, "timestamp": "00:22:18", "text": "何てことだ。私は逃げた"}, {"type": "subtitle", "time": 1346.87, "timestamp": "00:22:26", "text": "私はバカかもしれないけど、少なくとも私は"}, {"type": "subtitle", "time": 1349.27, "timestamp": "00:22:29", "text": "私のペットたちのことを覚えていてください。覚えているけど、"}, {"type": "subtitle", "time": 1350.51, "timestamp": "00:22:30", "text": "たくさんあります"}, {"type": "subtitle", "time": 1352.51, "timestamp": "00:22:32", "text": "多くの。わかった、"}, {"type": "subtitle", "time": 1356.39, "timestamp": "00:22:36", "text": "ネオス。私は現在のものを覚えています"}, {"type": "subtitle", "time": 1359.51, "timestamp": "00:22:39", "text": "ええと、旧世代。それは"}, {"type": "subtitle", "time": 1361.549, "timestamp": "00:22:41", "text": "のように"}, {"type": "subtitle", "time": 1364.35, "timestamp": "00:22:44", "text": "世代。世代の上限は？"}, {"type": "subtitle", "time": 1367.51, "timestamp": "00:22:47", "text": "また？カレンの子猫たち。私は猫が好きです。"}, {"type": "subtitle", "time": 1368.669, "timestamp": "00:22:48", "text": "私は持っている"}, {"type": "subtitle", "time": 1373.909, "timestamp": "00:22:53", "text": "OB。 H. では、１、２、３、４、５。"}, {"type": "subtitle", "time": 1377.909, "timestamp": "00:22:57", "text": "いや、違う。 5ですか、それとも4ですか？ 1 2 3. もし"}]
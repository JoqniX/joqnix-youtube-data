[{"type": "subtitle", "time": 841.11, "timestamp": "00:14:01", "text": "中のリーダーボードを確認してください。はい、"}, {"type": "subtitle", "time": 842.99, "timestamp": "00:14:02", "text": "そうしてください。"}, {"type": "subtitle", "time": 851.35, "timestamp": "00:14:11", "text": "ガッチャ。はい。だから、それが1つ目、"}, {"type": "subtitle", "time": 854.069, "timestamp": "00:14:14", "text": "ポイントシステムみたいなもの。だから、もしあなたが"}, {"type": "subtitle", "time": 855.55, "timestamp": "00:14:15", "text": "感嘆"}, {"type": "subtitle", "time": 858.949, "timestamp": "00:14:18", "text": "あなたのチャットでポイントポイントを、私は疑問に思います"}, {"type": "subtitle", "time": 862.03, "timestamp": "00:14:22", "text": "何が起こるだろうか。実際にやってみよう"}, {"type": "subtitle", "time": 865.67, "timestamp": "00:14:25", "text": "それ。ポイント。何か分かるだろうか？私はそうしました"}, {"type": "subtitle", "time": 869.35, "timestamp": "00:14:29", "text": "設定しない。私は実際には設定していません"}, {"type": "subtitle", "time": 871.15, "timestamp": "00:14:31", "text": "上。だから私はこう思う"}, {"type": "subtitle", "time": 873.75, "timestamp": "00:14:33", "text": "心配した。それはStreamlabsです。いいえ、違います"}, {"type": "subtitle", "time": 876.11, "timestamp": "00:14:36", "text": "Streamlabs。 Streamlabsは必要ありません。"}, {"type": "subtitle", "time": 888.67, "timestamp": "00:14:48", "text": "ポイント。待って、何も表示されない"}, {"type": "subtitle", "time": 897.31, "timestamp": "00:14:57", "text": "何？待って。ポイントですよね？"}]
[{"type": "subtitle", "time": 4261.59, "timestamp": "01:11:01", "text": "逃走用の乗り物のようなものだと思う。"}, {"type": "subtitle", "time": 4263.87, "timestamp": "01:11:03", "text": "一部の人にとって"}, {"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "理由、ここはまるで休暇のようだ"}, {"type": "subtitle", "time": 4283.63, "timestamp": "01:11:23", "text": "いや、待って。ドアを開けなければならない。あなた"}, {"type": "subtitle", "time": 4287.07, "timestamp": "01:11:27", "text": "ちくしょう。私は開ける必要があります"}, {"type": "subtitle", "time": 4290.35, "timestamp": "01:11:30", "text": "ドア。どうすればいいでしょうか"}, {"type": "subtitle", "time": 4299.51, "timestamp": "01:11:39", "text": "だから、ああ、私を乗せてくれなきゃ。わかった。"}, {"type": "subtitle", "time": 4301.27, "timestamp": "01:11:41", "text": "わかった。なぜ私はそう思ったのだろうか？なぜなぜ"}, {"type": "subtitle", "time": 4304.39, "timestamp": "01:11:44", "text": "考えてなかったっけ？わかった。与える"}, {"type": "subtitle", "time": 4305.31, "timestamp": "01:11:45", "text": "私"}, {"type": "subtitle", "time": 4307.75, "timestamp": "01:11:47", "text": "リフト。いいえ、ドアにぶつかってはいけません。"}, {"type": "subtitle", "time": 4310.669, "timestamp": "01:11:50", "text": "カイ。それは重装甲の"}, {"type": "subtitle", "time": 4313.11, "timestamp": "01:11:53", "text": "ドア。衝突する方法はありません"}, {"type": "subtitle", "time": 4315.229, "timestamp": "01:11:55", "text": "ドア。開けなければなりません"}, {"type": "subtitle", "time": 4318.79, "timestamp": "01:11:58", "text": "上。このような門やフェンスの場合"}]
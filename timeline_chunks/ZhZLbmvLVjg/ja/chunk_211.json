[{"type": "subtitle", "time": 12660.91, "timestamp": "03:31:00", "text": "A、でも名前を変える"}, {"type": "subtitle", "time": 12665.03, "timestamp": "03:31:05", "text": "えーと、名前をハニーに変えるか"}, {"type": "subtitle", "time": 12667.11, "timestamp": "03:31:07", "text": "砂糖。ああ、もしよろしければ、私が始めます"}, {"type": "subtitle", "time": 12679.229, "timestamp": "03:31:19", "text": "あなた。でも、シュガとだけ呼ぶのは"}, {"type": "subtitle", "time": 12689.389, "timestamp": "03:31:29", "text": "そして、あなたのDiscord名は"}, {"type": "subtitle", "time": 12691.309, "timestamp": "03:31:31", "text": "チーズバーガーまたは"}, {"type": "subtitle", "time": 12694.83, "timestamp": "03:31:34", "text": "何か。名前を忘れてしまった"}, {"type": "subtitle", "time": 12696.67, "timestamp": "03:31:36", "text": "また。"}, {"type": "subtitle", "time": 12700.95, "timestamp": "03:31:40", "text": "ごめん。えっと、彼らはミーム素材を使って"}, {"type": "subtitle", "time": 12703.389, "timestamp": "03:31:43", "text": "とても難しい"}, {"type": "subtitle", "time": 12708.19, "timestamp": "03:31:48", "text": "理解する。そうですね、私は何を作ればいいでしょうか"}]
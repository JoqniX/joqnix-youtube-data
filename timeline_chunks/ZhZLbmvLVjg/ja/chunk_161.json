[{"type": "subtitle", "time": 9661.51, "timestamp": "02:41:01", "text": "でも、ええ、私たちはカイシが大好きです"}, {"type": "subtitle", "time": 9663.67, "timestamp": "02:41:03", "text": "すべてについて話すことができるので"}, {"type": "subtitle", "time": 9677.389, "timestamp": "02:41:17", "text": "うんうん、話せるよ"}, {"type": "subtitle", "time": 9680.309, "timestamp": "02:41:20", "text": "お気に入りのアイテムやおすすめアイテム"}, {"type": "subtitle", "time": 9683.349, "timestamp": "02:41:23", "text": "他にも見るべきアニメや作品。そうだった"}, {"type": "subtitle", "time": 9692.469, "timestamp": "02:41:32", "text": "いいね。知らなかったけど、よかった"}, {"type": "subtitle", "time": 9695.429, "timestamp": "02:41:35", "text": "私たちは相互に報いを受けた。待って、これは"}, {"type": "subtitle", "time": 9698.07, "timestamp": "02:41:38", "text": "相互貨物チケット？見たのを忘れた"}, {"type": "subtitle", "time": 9702.75, "timestamp": "02:41:42", "text": "どこかで"}, {"type": "subtitle", "time": 9706.429, "timestamp": "02:41:46", "text": "Googleをコピー"}, {"type": "subtitle", "time": 9709.19, "timestamp": "02:41:49", "text": "互いに与えたり受け取ったりすることを探す"}, {"type": "subtitle", "time": 9711.55, "timestamp": "02:41:51", "text": "感情を表すために交換する"}]
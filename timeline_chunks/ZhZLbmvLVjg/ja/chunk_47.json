[{"type": "subtitle", "time": 2820.39, "timestamp": "00:47:00", "text": "クレメンタイン。彼女はあの男と一緒にいる"}, {"type": "subtitle", "time": 2823.39, "timestamp": "00:47:03", "text": "上はブレザー。我々はトップに立つ必要がある、"}, {"type": "subtitle", "time": 2825.79, "timestamp": "00:47:05", "text": "あまりにも。"}, {"type": "subtitle", "time": 2829.67, "timestamp": "00:47:09", "text": "ええ、それを実現する方法を見つける必要があります。"}, {"type": "subtitle", "time": 2836.23, "timestamp": "00:47:16", "text": "ああ、そこへ行って。それは良くないと思う"}, {"type": "subtitle", "time": 2845.43, "timestamp": "00:47:25", "text": "わかった。では、私たちは"}, {"type": "subtitle", "time": 2847.39, "timestamp": "00:47:27", "text": "バッテリー。では、それを"}, {"type": "subtitle", "time": 2850.19, "timestamp": "00:47:30", "text": "クレメンタイン。ああ、この人か。彼は"}, {"type": "subtitle", "time": 2852.95, "timestamp": "00:47:32", "text": "それ。私は超VIPに行こうとします"}, {"type": "subtitle", "time": 2854.87, "timestamp": "00:47:34", "text": "信じられる？このレバーをちょうど見たところだよ"}, {"type": "subtitle", "time": 2856.309, "timestamp": "00:47:36", "text": "面白半分で？飲み物をいただけますか？"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "この小さなレバーをあげましょう。ああ、私は"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "飲み物をお渡しします。はい、どうぞ。"}, {"type": "subtitle", "time": 2863.43, "timestamp": "00:47:43", "text": "約束。よし。ありがとう。"}]
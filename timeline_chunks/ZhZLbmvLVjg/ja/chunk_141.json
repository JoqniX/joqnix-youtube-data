[{"type": "subtitle", "time": 8462.19, "timestamp": "02:21:02", "text": "ええ、もう少し"}, {"type": "subtitle", "time": 8464.95, "timestamp": "02:21:04", "text": "もの。私もこの喜びを分かち合ってください"}, {"type": "subtitle", "time": 8468.309, "timestamp": "02:21:08", "text": "そこには。ええ、そう言いましたよ。私たちは"}, {"type": "subtitle", "time": 8480.469, "timestamp": "02:21:20", "text": "神。何てことだ。どうやって戻ってきたのか"}, {"type": "subtitle", "time": 8487.23, "timestamp": "02:21:27", "text": "すばらしい。降りる。出て行け。得る"}, {"type": "subtitle", "time": 8489.67, "timestamp": "02:21:29", "text": "オフ。どうやって？どうやって戻ってきたのか分からない"}, {"type": "subtitle", "time": 8501.309, "timestamp": "02:21:41", "text": "ああ、"}, {"type": "subtitle", "time": 8513.71, "timestamp": "02:21:53", "text": "オフ。よし、これでいい。待って、見逃した？"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "何でも？私は注意を払っていませんでした。私たちは"}, {"type": "subtitle", "time": 8517.55, "timestamp": "02:21:57", "text": "見逃す"}]
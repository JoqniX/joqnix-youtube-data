[{"type": "subtitle", "time": 7943.189, "timestamp": "02:12:23", "text": "右？ファンサーバーってやつだよ。"}, {"type": "subtitle", "time": 7945.95, "timestamp": "02:12:25", "text": "どうやら私は無言で"}, {"type": "subtitle", "time": 7954.27, "timestamp": "02:12:34", "text": "ストリーム。ああ、だって君は"}, {"type": "subtitle", "time": 7957.709, "timestamp": "02:12:37", "text": "知っていることは、"}, {"type": "subtitle", "time": 7961.27, "timestamp": "02:12:41", "text": "多くの。ああ、これは何でしょう？その場所を覚えておいてください。"}, {"type": "subtitle", "time": 7970.43, "timestamp": "02:12:50", "text": "水はきれいで"}, {"type": "subtitle", "time": 7973.03, "timestamp": "02:12:53", "text": "人々の生活を支えるためにガソリンが配給された"}, {"type": "subtitle", "time": 7974.629, "timestamp": "02:12:54", "text": "輸送中。科学者ショー"}, {"type": "subtitle", "time": 7976.47, "timestamp": "02:12:56", "text": "私にとって、水は砕け散った。彼らはまるで"}, {"type": "subtitle", "time": 7979.75, "timestamp": "02:12:59", "text": "巨大で、全体を収容できる"}]
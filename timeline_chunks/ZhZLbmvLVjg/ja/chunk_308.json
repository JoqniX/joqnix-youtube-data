[{"type": "subtitle", "time": 18481.59, "timestamp": "05:08:01", "text": "では、ホラー小説をいくつか読んでみましょう。"}, {"type": "subtitle", "time": 18483.51, "timestamp": "05:08:03", "text": "うん。"}, {"type": "subtitle", "time": 18486.07, "timestamp": "05:08:06", "text": "待って、待って。今のことですか、それとも、えっと、"}, {"type": "subtitle", "time": 18488.31, "timestamp": "05:08:08", "text": "未来は？じゃあ、来週くらい？いいえ、これは"}, {"type": "subtitle", "time": 18491.31, "timestamp": "05:08:11", "text": "11月は11月です。いいえ、何が"}, {"type": "subtitle", "time": 18494.07, "timestamp": "05:08:14", "text": "11月？私はどんなことをするの？"}, {"type": "subtitle", "time": 18495.39, "timestamp": "05:08:15", "text": "11月？なぜならそれは"}, {"type": "subtitle", "time": 18498.51, "timestamp": "05:08:18", "text": "ゴリラ。スケジュールを立てたくない"}, {"type": "subtitle", "time": 18507.15, "timestamp": "05:08:27", "text": "のように"}, {"type": "subtitle", "time": 18509.91, "timestamp": "05:08:29", "text": "ハロウィン。くそ。私は決してタイミングを試さない"}, {"type": "subtitle", "time": 18514.51, "timestamp": "05:08:34", "text": "誰に対しても。 12分あります。"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "残り。おお。そうそう。うん。うん。"}, {"type": "subtitle", "time": 18519.628, "timestamp": "05:08:39", "text": "わかった。待って。ホラー"}, {"type": "subtitle", "time": 18522.11, "timestamp": "05:08:42", "text": "物語。ホラー"}, {"type": "subtitle", "time": 18529.708, "timestamp": "05:08:49", "text": "物語。わかった。"}, {"type": "subtitle", "time": 18532.32, "timestamp": "05:08:52", "text": "ああ、わかった。さあ"}, {"type": "subtitle", "time": 18534.67, "timestamp": "05:08:54", "text": "[音楽]"}, {"type": "subtitle", "time": 18537.99, "timestamp": "05:08:57", "text": "ああ、もっと簡単な方法を知ってるよ。参加できますか？"}]
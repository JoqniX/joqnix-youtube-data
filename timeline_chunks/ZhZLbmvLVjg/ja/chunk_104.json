[{"type": "subtitle", "time": 6241.95, "timestamp": "01:44:01", "text": "わかった。来る"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "神。その鶏は挟まっている"}, {"type": "subtitle", "time": 6272.75, "timestamp": "01:44:32", "text": "まるで"}, {"type": "subtitle", "time": 6286.31, "timestamp": "01:44:46", "text": "わかった。まあ、あなたは怠け者になることを拒否しているんですね。"}, {"type": "subtitle", "time": 6288.47, "timestamp": "01:44:48", "text": "君は最下位だよ。でも私はスイッチです"}, {"type": "subtitle", "time": 6290.59, "timestamp": "01:44:50", "text": "けれど。私は言った"}, {"type": "subtitle", "time": 6295.03, "timestamp": "01:44:55", "text": "多く。君とは違って、バカカイは"}]
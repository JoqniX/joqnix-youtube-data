[{"type": "subtitle", "time": 10202.309, "timestamp": "02:50:02", "text": "愛。うん。そしてヨイは行為である。の"}, {"type": "subtitle", "time": 10207.03, "timestamp": "02:50:07", "text": "実際の行為。の"}, {"type": "subtitle", "time": 10210.55, "timestamp": "02:50:10", "text": "えーっと、実際のエッチなヘンタイじゃないよ"}, {"type": "subtitle", "time": 10213.91, "timestamp": "02:50:13", "text": "そう言って輝くことができるもの"}, {"type": "subtitle", "time": 10215.87, "timestamp": "02:50:15", "text": "軽度"}, {"type": "subtitle", "time": 10219.429, "timestamp": "02:50:19", "text": "あまり穏やかではない安全なタイプですが、それは"}, {"type": "subtitle", "time": 10227.15, "timestamp": "02:50:27", "text": "はい、したがってbが安全です"}, {"type": "subtitle", "time": 10229.87, "timestamp": "02:50:29", "text": "yoi という単語は"}, {"type": "subtitle", "time": 10244.309, "timestamp": "02:50:44", "text": "よし、カメラを破壊して"}, {"type": "subtitle", "time": 10244.65, "timestamp": "02:50:44", "text": "仕上げる"}]
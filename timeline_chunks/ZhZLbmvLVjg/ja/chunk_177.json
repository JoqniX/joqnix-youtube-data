[{"type": "subtitle", "time": 10621.269, "timestamp": "02:57:01", "text": "中身のない話ではない。つまり、ふわふわしたものはいいんだけど、"}, {"type": "subtitle", "time": 10624.55, "timestamp": "02:57:04", "text": "適切な比率のふわふわ感、本当にふわふわ感を出すな"}, {"type": "subtitle", "time": 10627.16, "timestamp": "02:57:07", "text": "私の心をくすぐる"}, {"type": "subtitle", "time": 10663.51, "timestamp": "02:57:43", "text": "今は正しい立ち位置だ。あなたは誰ですか？何が"}, {"type": "subtitle", "time": 10664.51, "timestamp": "02:57:44", "text": "あなた"}, {"type": "subtitle", "time": 10667.59, "timestamp": "02:57:47", "text": "欲しい？あなたは私の"}, {"type": "subtitle", "time": 10677.63, "timestamp": "02:57:57", "text": "わかった。わかった。えっと、会う前に"}]
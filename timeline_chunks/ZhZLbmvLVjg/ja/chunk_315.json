[{"type": "subtitle", "time": 18913.15, "timestamp": "05:15:13", "text": "ああ、広告が流れてる。"}, {"type": "subtitle", "time": 18916.83, "timestamp": "05:15:16", "text": "ゴメ。よし、"}, {"type": "subtitle", "time": 18920.708, "timestamp": "05:15:20", "text": "読む。私は土を盗みに来た。私は"}, {"type": "subtitle", "time": 18935.31, "timestamp": "05:15:35", "text": "あなたD.ハッピー"}, {"type": "subtitle", "time": 18938.59, "timestamp": "05:15:38", "text": "ハロウィン。ハロウィンはいかがでしたか？"}, {"type": "subtitle", "time": 18943.39, "timestamp": "05:15:43", "text": "D？良い時間を過ごせたことを願っています"}, {"type": "subtitle", "time": 18946.59, "timestamp": "05:15:46", "text": "ハロウィン。少し"}, {"type": "subtitle", "time": 18948.99, "timestamp": "05:15:48", "text": "ジョークが通じなかった"}, {"type": "subtitle", "time": 18952.708, "timestamp": "05:15:52", "text": "あなた。お元気でお過ごしでしょうか。また、"}, {"type": "subtitle", "time": 18956.15, "timestamp": "05:15:56", "text": "私の先輩の誕生日。ああ、幸せ"}, {"type": "subtitle", "time": 18957.84, "timestamp": "05:15:57", "text": "誕生日"}]
[{"type": "subtitle", "time": 16326.189, "timestamp": "04:32:06", "text": "えっと、これ買えますか？持っているかどうかわかりません"}, {"type": "subtitle", "time": 16327.79, "timestamp": "04:32:07", "text": "お金"}, {"type": "subtitle", "time": 16330.429, "timestamp": "04:32:10", "text": "悲しいことに私は"}, {"type": "subtitle", "time": 16335.55, "timestamp": "04:32:15", "text": "十分です、ええと、私は受け取っていません"}, {"type": "subtitle", "time": 16339.229, "timestamp": "04:32:19", "text": "私の給料"}, {"type": "subtitle", "time": 16342.71, "timestamp": "04:32:22", "text": "まだですが、えっと、私の"}, {"type": "subtitle", "time": 16351.229, "timestamp": "04:32:31", "text": "銀行？今日は何をするべきでしょうか？わかりました、私はいくらですか"}, {"type": "subtitle", "time": 16354.07, "timestamp": "04:32:34", "text": "持っている？ああ、神様、私は持っていません、持っていません"}, {"type": "subtitle", "time": 16357.59, "timestamp": "04:32:37", "text": "十分あります。ああ、私は300ルピーしか持っていません"}, {"type": "subtitle", "time": 16361.189, "timestamp": "04:32:41", "text": "私の銀行口座に。 O. そしてゲームは"}, {"type": "subtitle", "time": 16363.469, "timestamp": "04:32:43", "text": "文字通り"}, {"type": "subtitle", "time": 16365.71, "timestamp": "04:32:45", "text": "432."}, {"type": "subtitle", "time": 16369.63, "timestamp": "04:32:49", "text": "おい。ああ、もう。ああ、もう。"}, {"type": "subtitle", "time": 16371.63, "timestamp": "04:32:51", "text": "えっと。おお"}, {"type": "subtitle", "time": 16375.41, "timestamp": "04:32:55", "text": "神。自分が好きになるなんて思ってもみなかった"}, {"type": "subtitle", "time": 16377.389, "timestamp": "04:32:57", "text": "[音楽]"}, {"type": "subtitle", "time": 16379.75, "timestamp": "04:32:59", "text": "えっと、ごめんね、エドワード。これまで服を着たことはありますか？"}]
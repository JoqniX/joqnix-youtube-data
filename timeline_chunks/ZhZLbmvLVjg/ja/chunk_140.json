[{"type": "subtitle", "time": 8404.11, "timestamp": "02:20:04", "text": "えーと"}, {"type": "subtitle", "time": 8410.11, "timestamp": "02:20:10", "text": "BLコンテンツが好きな女性"}, {"type": "subtitle", "time": 8414.79, "timestamp": "02:20:14", "text": "正直。だから、好きな女性ファンは"}, {"type": "subtitle", "time": 8418.27, "timestamp": "02:20:18", "text": "うん、BL（ボーイズラブ）"}, {"type": "subtitle", "time": 8421.75, "timestamp": "02:20:21", "text": "彼らが名前を持っていると確信している"}, {"type": "subtitle", "time": 8424.87, "timestamp": "02:20:24", "text": "彼ら自身、それはフォッシであり、"}, {"type": "subtitle", "time": 8427.15, "timestamp": "02:20:27", "text": "愛する男性"}, {"type": "subtitle", "time": 8434.429, "timestamp": "02:20:34", "text": "ふだんちと"}, {"type": "subtitle", "time": 8437.63, "timestamp": "02:20:37", "text": "カイシ、そして私も含めることができます"}, {"type": "subtitle", "time": 8441.429, "timestamp": "02:20:41", "text": "ええと、私も好きな人は"}, {"type": "subtitle", "time": 8443.71, "timestamp": "02:20:43", "text": "ファンシ"}, {"type": "subtitle", "time": 8450.389, "timestamp": "02:20:50", "text": "うん。だから、私はある意味ミックスです"}, {"type": "subtitle", "time": 8452.349, "timestamp": "02:20:52", "text": "正直。どちらも好きです"}, {"type": "subtitle", "time": 8458.91, "timestamp": "02:20:58", "text": "いやいや、DLとBL。それで、"}]
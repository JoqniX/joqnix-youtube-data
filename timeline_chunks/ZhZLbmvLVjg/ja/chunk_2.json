[{"type": "subtitle", "time": 127.83, "timestamp": "00:02:07", "text": "えっと、私の"}, {"type": "subtitle", "time": 130.11, "timestamp": "00:02:10", "text": "[音楽]"}, {"type": "subtitle", "time": 137.32999999999998, "timestamp": "00:02:17", "text": "の"}, {"type": "subtitle", "time": 141.39, "timestamp": "00:02:21", "text": "[音楽]"}, {"type": "subtitle", "time": 146.35, "timestamp": "00:02:26", "text": "人生。はい、準備は全て整いましたね？"}, {"type": "subtitle", "time": 150.309, "timestamp": "00:02:30", "text": "よし、私は死んだと思う"}, {"type": "subtitle", "time": 152.79, "timestamp": "00:02:32", "text": "1時間前。ええ、まあそんな感じです。はい。"}, {"type": "subtitle", "time": 154.28, "timestamp": "00:02:34", "text": "はい。 はい。わかった。あのね？私は"}, {"type": "subtitle", "time": 156.959, "timestamp": "00:02:36", "text": "はい。わかった。あのね？私は おそらく掃討作戦だろう。観るつもりです"}, {"type": "subtitle", "time": 159.36, "timestamp": "00:02:39", "text": "おそらく掃討作戦だろう。観るつもりです アニメを見てリラックス"}, {"type": "subtitle", "time": 161.31900000000002, "timestamp": "00:02:41", "text": "アニメを見てリラックス 脳。私は掃除に行く、私は"}, {"type": "subtitle", "time": 168.43, "timestamp": "00:02:48", "text": "[音楽]"}, {"type": "subtitle", "time": 172.22899999999998, "timestamp": "00:02:52", "text": "推測。おやすみ。私のことを恋しく思わないで。私は愛する"}, {"type": "subtitle", "time": 178.869, "timestamp": "00:02:58", "text": "こんにちは。待って、寝て見るべきかな"}]
[{"type": "subtitle", "time": 4742.55, "timestamp": "01:19:02", "text": "方法。あのオレンジ色の場所は"}, {"type": "subtitle", "time": 4744.27, "timestamp": "01:19:04", "text": "来た"}, {"type": "subtitle", "time": 4756.11, "timestamp": "01:19:16", "text": "人々。それで"}, {"type": "subtitle", "time": 4761.11, "timestamp": "01:19:21", "text": "かわいい。赤、青、緑、シアン、白、"}, {"type": "subtitle", "time": 4764.11, "timestamp": "01:19:24", "text": "ライトブルー、それから"}, {"type": "subtitle", "time": 4768.39, "timestamp": "01:19:28", "text": "オレンジ。我慢する。もう一度行かなきゃ。"}, {"type": "subtitle", "time": 4777.31, "timestamp": "01:19:37", "text": "[音楽]"}, {"type": "subtitle", "time": 4780.39, "timestamp": "01:19:40", "text": "管理部門の認定エージェントと会う"}, {"type": "subtitle", "time": 4783.47, "timestamp": "01:19:43", "text": "部屋。では、制御はどこにあるのか"}, {"type": "subtitle", "time": 4786.35, "timestamp": "01:19:46", "text": "[音楽]"}, {"type": "subtitle", "time": 4788.51, "timestamp": "01:19:48", "text": "部屋？コントロール"}]
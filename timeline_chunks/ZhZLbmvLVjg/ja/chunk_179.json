[{"type": "subtitle", "time": 10740.389, "timestamp": "02:59:00", "text": "ネオンサインのある場所ならそうあるべきだった。これは"}, {"type": "subtitle", "time": 10741.15, "timestamp": "02:59:01", "text": "ない"}, {"type": "subtitle", "time": 10745.63, "timestamp": "02:59:05", "text": "それ。検索。だから場所を見つける必要がある"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "内部。だから、いくつかの家に侵入する必要がある"}, {"type": "subtitle", "time": 10750.03, "timestamp": "02:59:10", "text": "私"}, {"type": "subtitle", "time": 10766.11, "timestamp": "02:59:26", "text": "どこへ行くべきか、しかし待つ"}, {"type": "subtitle", "time": 10770.269, "timestamp": "02:59:30", "text": "上。そこは開けた場所ですか？"}, {"type": "subtitle", "time": 10774.59, "timestamp": "02:59:34", "text": "待って、私ならできるよ。ああ、待って。営業していません。"}, {"type": "subtitle", "time": 10777.51, "timestamp": "02:59:37", "text": "よし、どこかに私が"}, {"type": "subtitle", "time": 10785.349, "timestamp": "02:59:45", "text": "[音楽]"}, {"type": "subtitle", "time": 10797.51, "timestamp": "02:59:57", "text": "そこには。スマートとは何か？ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 10799.269, "timestamp": "02:59:59", "text": "新しい単語を学ぶ。フラッフとは何ですか？待って、"}]
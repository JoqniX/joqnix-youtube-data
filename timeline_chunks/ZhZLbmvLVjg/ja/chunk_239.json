[{"type": "subtitle", "time": 14341.189, "timestamp": "03:59:01", "text": "「ああ、ジョーはストリーミング配信してるよ」"}, {"type": "subtitle", "time": 14345.229, "timestamp": "03:59:05", "text": "YouTube。サムネイルも良さそうだ。"}, {"type": "subtitle", "time": 14347.91, "timestamp": "03:59:07", "text": "それ。そんな感じ。そして私が止まると"}, {"type": "subtitle", "time": 14350.189, "timestamp": "03:59:10", "text": "ストリーミングすると、私の"}, {"type": "subtitle", "time": 14354.55, "timestamp": "03:59:14", "text": "いつものバナー広告です。うん。そして特に"}, {"type": "subtitle", "time": 14357.75, "timestamp": "03:59:17", "text": "私もツイートしないといけないな。主に"}, {"type": "subtitle", "time": 14358.67, "timestamp": "03:59:18", "text": "ツイート"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "あれ。私もそうしたいです。私は"}, {"type": "subtitle", "time": 14370.269, "timestamp": "03:59:30", "text": "さあ、ダイナミックな自動ツイート"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "あれ。でもそれは、私の一部なんです"}, {"type": "subtitle", "time": 14380.71, "timestamp": "03:59:40", "text": "それに対して、よりコントロールできるように。だから私は"}, {"type": "subtitle", "time": 14381.95, "timestamp": "03:59:41", "text": "になるだろう"}, {"type": "subtitle", "time": 14384.79, "timestamp": "03:59:44", "text": "ストリーマーボードを使って試してみますが"}, {"type": "subtitle", "time": 14387.91, "timestamp": "03:59:47", "text": "うまくいかない場合は、"}, {"type": "subtitle", "time": 14390.389, "timestamp": "03:59:50", "text": "昔ながらのレオボードだけど、お金を払わないといけない"}, {"type": "subtitle", "time": 14393.59, "timestamp": "03:59:53", "text": "そのためには、私は支払いたくない"}, {"type": "subtitle", "time": 14397.51, "timestamp": "03:59:57", "text": "機内用品はやはり苦痛です"}]
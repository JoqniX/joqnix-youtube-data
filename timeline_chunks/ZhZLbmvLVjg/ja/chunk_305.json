[{"type": "subtitle", "time": 18303.788, "timestamp": "05:05:03", "text": "それ？えーと、FPSゲームをプレイするか"}, {"type": "subtitle", "time": 18336.788, "timestamp": "05:05:36", "text": "神。うん、トラッキングは本当に痛いよ。"}, {"type": "subtitle", "time": 18339.07, "timestamp": "05:05:39", "text": "しかしそれ以外は"}, {"type": "subtitle", "time": 18341.35, "timestamp": "05:05:41", "text": "良い。私が望まない理由"}, {"type": "subtitle", "time": 18345.75, "timestamp": "05:05:45", "text": "電話もやる理由は、えーと"}, {"type": "subtitle", "time": 18348.31, "timestamp": "05:05:48", "text": "口が動かない。私は好きでなければならない"}, {"type": "subtitle", "time": 18350.868, "timestamp": "05:05:50", "text": "口を開けて、ああ、誰かのように"}, {"type": "subtitle", "time": 18353.67, "timestamp": "05:05:53", "text": "口に食べ物を与える"}, {"type": "subtitle", "time": 18358.19, "timestamp": "05:05:58", "text": "せめて少しは開けて。戻る"}]
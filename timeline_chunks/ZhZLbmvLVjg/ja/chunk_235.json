[{"type": "subtitle", "time": 14100.71, "timestamp": "03:55:00", "text": "ゲームについて？ゲームは本当に"}, {"type": "subtitle", "time": 14106.429, "timestamp": "03:55:06", "text": "本当に探求心旺盛で、冒険心がある。私"}, {"type": "subtitle", "time": 14109.429, "timestamp": "03:55:09", "text": "幸せと悲しみが入り混じったハドメンツ"}, {"type": "subtitle", "time": 14113.55, "timestamp": "03:55:13", "text": "特に最後にB12を失ったのは"}, {"type": "subtitle", "time": 14115.95, "timestamp": "03:55:15", "text": "たくさんだが"}, {"type": "subtitle", "time": 14119.91, "timestamp": "03:55:19", "text": "うん、いい話があるね。私はすべて楽しんだ"}, {"type": "subtitle", "time": 14123.189, "timestamp": "03:55:23", "text": "その構成要素。それは隠されている"}, {"type": "subtitle", "time": 14127.15, "timestamp": "03:55:27", "text": "イースターエッグとか、そういう参照"}, {"type": "subtitle", "time": 14130.75, "timestamp": "03:55:30", "text": "もの。本当に"}, {"type": "subtitle", "time": 14134.55, "timestamp": "03:55:34", "text": "良い。はい。そして最後に、私は嬉しい"}, {"type": "subtitle", "time": 14137.03, "timestamp": "03:55:37", "text": "実際にゲームをクリアした"}, {"type": "subtitle", "time": 14140.189, "timestamp": "03:55:40", "text": "あまり深く考えずに"}, {"type": "subtitle", "time": 14144.15, "timestamp": "03:55:44", "text": "ストリーム。待って、どうやって、どれくらい時間が経った"}, {"type": "subtitle", "time": 14147.03, "timestamp": "03:55:47", "text": "昨日の配信？ 4時間かかるんですよね？"}, {"type": "subtitle", "time": 14150.79, "timestamp": "03:55:50", "text": "昨日、最初の部分を終えました。"}, {"type": "subtitle", "time": 14153.15, "timestamp": "03:55:53", "text": "4時間経過後、"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "話している。うん。うん。うん。現在"}]
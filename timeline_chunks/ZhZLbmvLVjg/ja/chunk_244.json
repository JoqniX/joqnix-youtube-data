[{"type": "subtitle", "time": 14642.11, "timestamp": "04:04:02", "text": "15分以上の動画をアップロードしてください"}, {"type": "subtitle", "time": 14644.95, "timestamp": "04:04:04", "text": "動画。モバイル認証と"}, {"type": "subtitle", "time": 14647.03, "timestamp": "04:04:07", "text": "他の検証は、このチャンネルです"}, {"type": "subtitle", "time": 14647.79, "timestamp": "04:04:07", "text": "は"}, {"type": "subtitle", "time": 14650.269, "timestamp": "04:04:10", "text": "正真正銘で"}, {"type": "subtitle", "time": 14652.67, "timestamp": "04:04:12", "text": "えーっと、"}, {"type": "subtitle", "time": 14656.349, "timestamp": "04:04:16", "text": "杖か何か。確認します"}, {"type": "subtitle", "time": 14660.389, "timestamp": "04:04:20", "text": "チャンネルから動画の数"}, {"type": "subtitle", "time": 14663.11, "timestamp": "04:04:23", "text": "アップロードまたはいいねする人が登録すると、"}, {"type": "subtitle", "time": 14668.55, "timestamp": "04:04:28", "text": "完全なアクセス権を取得する、ということでしょうか。それで"}, {"type": "subtitle", "time": 14671.269, "timestamp": "04:04:31", "text": "ええ、それで私はサブを手に入れることができました"}, {"type": "subtitle", "time": 14674.67, "timestamp": "04:04:34", "text": "フルアクセス、えっと、"}, {"type": "subtitle", "time": 14677.95, "timestamp": "04:04:37", "text": "最近アップロードされた111件"}, {"type": "subtitle", "time": 14682.229, "timestamp": "04:04:42", "text": "ビデオ、すべての単語、そして、さらに"}, {"type": "subtitle", "time": 14684.469, "timestamp": "04:04:44", "text": "すでに4人の購読者がいた。私"}, {"type": "subtitle", "time": 14686.87, "timestamp": "04:04:46", "text": "どういうわけかわかりませんが、ありがとうございます"}, {"type": "subtitle", "time": 14689.83, "timestamp": "04:04:49", "text": "そのために私にさせてください、私にさせてください、私にさせてください"}, {"type": "subtitle", "time": 14692.95, "timestamp": "04:04:52", "text": "ジョックウォールジョックを次のチャンネルに"}, {"type": "subtitle", "time": 14695.269, "timestamp": "04:04:55", "text": "認証を受ける"}, {"type": "subtitle", "time": 14698.59, "timestamp": "04:04:58", "text": "えーと、全部手に入れる"}]
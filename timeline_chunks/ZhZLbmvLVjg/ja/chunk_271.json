[{"type": "subtitle", "time": 16262.309, "timestamp": "04:31:02", "text": "足音のような小さな音を知っている"}, {"type": "subtitle", "time": 16265.189, "timestamp": "04:31:05", "text": "そんな瞬間には叫び声をあげたい。ああ神様、いとこ"}, {"type": "subtitle", "time": 16269.149, "timestamp": "04:31:09", "text": "私は本当に下手です"}, {"type": "subtitle", "time": 16272.269, "timestamp": "04:31:12", "text": "神。まあ、そうですね。"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "えっと、大きなことはしたくないんだけど"}, {"type": "subtitle", "time": 16278.229, "timestamp": "04:31:18", "text": "ゲームか、さもなくば何もない。つまり、私は"}, {"type": "subtitle", "time": 16284.07, "timestamp": "04:31:24", "text": "試してみようかな、えっと、えっと、私は"}, {"type": "subtitle", "time": 16287.429, "timestamp": "04:31:27", "text": "怖いゲームを作ってみることもできるけど、私は"}, {"type": "subtitle", "time": 16290.71, "timestamp": "04:31:30", "text": "それほど大きなものではないもの。いいえ、違います"}, {"type": "subtitle", "time": 16294.67, "timestamp": "04:31:34", "text": "大きくない。つまりそういうことじゃない"}, {"type": "subtitle", "time": 16300.269, "timestamp": "04:31:40", "text": "えっと、なんて呼ぶんだっけ？そうではない"}, {"type": "subtitle", "time": 16303.67, "timestamp": "04:31:43", "text": "えっと、なんて呼ぶんだっけ？それも違う"}, {"type": "subtitle", "time": 16305.91, "timestamp": "04:31:45", "text": "まあ、そんなに大きくない感じかな。"}, {"type": "subtitle", "time": 16307.149, "timestamp": "04:31:47", "text": "しかし短い"}, {"type": "subtitle", "time": 16309.99, "timestamp": "04:31:49", "text": "要するに、私の心に浮かぶ唯一のゲーム"}, {"type": "subtitle", "time": 16313.349, "timestamp": "04:31:53", "text": "心の中では叫んだりしないでほしい"}, {"type": "subtitle", "time": 16314.83, "timestamp": "04:31:54", "text": "それは16分です"}]
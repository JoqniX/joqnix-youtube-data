[{"type": "subtitle", "time": 3060.39, "timestamp": "00:51:00", "text": "なぜ人々はそんなに文句を言うのか私にはわからない"}, {"type": "subtitle", "time": 3060.85, "timestamp": "00:51:00", "text": "について"}, {"type": "subtitle", "time": 3083.309, "timestamp": "00:51:23", "text": "彼。おお、"}, {"type": "subtitle", "time": 3086.39, "timestamp": "00:51:26", "text": "いいえ。あなたは見た目ほど賢くない。"}, {"type": "subtitle", "time": 3087.99, "timestamp": "00:51:27", "text": "大丈夫。まあ、個人的な恨みはないよ。"}, {"type": "subtitle", "time": 3089.75, "timestamp": "00:51:29", "text": "ビジネスはビジネスだ。なんてこった。何が"}, {"type": "subtitle", "time": 3093.47, "timestamp": "00:51:33", "text": "クレメンタインをどうするつもり？おい。"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "シート。これはファッションよりもお金です"}, {"type": "subtitle", "time": 3105.15, "timestamp": "00:51:45", "text": "そして複雑だ。それらはすべて"}]
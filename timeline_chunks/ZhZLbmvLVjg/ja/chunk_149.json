[{"type": "subtitle", "time": 8946.389, "timestamp": "02:29:06", "text": "時間。無駄にするためにこれをする必要はありません"}, {"type": "subtitle", "time": 8954.11, "timestamp": "02:29:14", "text": "行く。片付ける必要はない。なぜ？私"}, {"type": "subtitle", "time": 8956.63, "timestamp": "02:29:16", "text": "忘れた。それで、私はそれを観ました。だった"}, {"type": "subtitle", "time": 8958.95, "timestamp": "02:29:18", "text": "正直に言うと、映画になる予定です。"}, {"type": "subtitle", "time": 8961.349, "timestamp": "02:29:21", "text": "ジェロは実際には"}, {"type": "subtitle", "time": 8962.27, "timestamp": "02:29:22", "text": "それは変わった"}, {"type": "subtitle", "time": 8976.97, "timestamp": "02:29:36", "text": "うん。私は"}, {"type": "subtitle", "time": 8978.91, "timestamp": "02:29:38", "text": "[音楽]"}]
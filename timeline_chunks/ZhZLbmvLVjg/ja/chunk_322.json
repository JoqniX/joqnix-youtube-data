[{"type": "subtitle", "time": 19322.708, "timestamp": "05:22:02", "text": "えーと、私はこうなります、えーと、私はこうなります"}, {"type": "subtitle", "time": 19325.75, "timestamp": "05:22:05", "text": "この画面では本当ですが、ただ私が欲しいのは"}, {"type": "subtitle", "time": 19329.708, "timestamp": "05:22:09", "text": "あなたたちが何を望んでいるのかを知るために、"}, {"type": "subtitle", "time": 19333.35, "timestamp": "05:22:13", "text": "君たちが何を望んでいるか知ってるよ"}, {"type": "subtitle", "time": 19337.51, "timestamp": "05:22:17", "text": "もの。ええと、それでは教えてください。えっと、待って。えっと、"}, {"type": "subtitle", "time": 19338.83, "timestamp": "05:22:18", "text": "それで私たちは"}, {"type": "subtitle", "time": 19341.75, "timestamp": "05:22:21", "text": "これら。見せるべきか、それとも選ぶべきか"}, {"type": "subtitle", "time": 19345.788, "timestamp": "05:22:25", "text": "ランダムに選んだもの？私に選ばせて"}, {"type": "subtitle", "time": 19348.67, "timestamp": "05:22:28", "text": "レビューがたくさんある"}, {"type": "subtitle", "time": 19351.99, "timestamp": "05:22:31", "text": "けれど。 1冊の本があります"}, {"type": "subtitle", "time": 19353.47, "timestamp": "05:22:33", "text": "214"}, {"type": "subtitle", "time": 19355.55, "timestamp": "05:22:35", "text": "レビュー。"}, {"type": "subtitle", "time": 19363.11, "timestamp": "05:22:43", "text": "わかった。 1つ。わかった。それでは"}, {"type": "subtitle", "time": 19366.31, "timestamp": "05:22:46", "text": "人気のあるもの。わかった。の"}, {"type": "subtitle", "time": 19370.15, "timestamp": "05:22:50", "text": "えっと、２１。わかった。振り返らないで。"}, {"type": "subtitle", "time": 19373.59, "timestamp": "05:22:53", "text": "彼女の声を聞くと。ちょっと待って。"}, {"type": "subtitle", "time": 19375.59, "timestamp": "05:22:55", "text": "我慢する。待って、待って、待って。それらは10です"}, {"type": "subtitle", "time": 19377.11, "timestamp": "05:22:57", "text": "章。あのね？読んでみましょう"}]
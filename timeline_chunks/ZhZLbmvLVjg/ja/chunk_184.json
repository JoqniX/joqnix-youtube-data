[{"type": "subtitle", "time": 11053.349, "timestamp": "03:04:13", "text": "おお。ああ。"}, {"type": "subtitle", "time": 11057.309, "timestamp": "03:04:17", "text": "あの音が聞こえた、あの音が"}, {"type": "subtitle", "time": 11070.469, "timestamp": "03:04:30", "text": "どこかで。開けて、私たちが来られるように"}, {"type": "subtitle", "time": 11082.389, "timestamp": "03:04:42", "text": "バカあお、バカ、効率的な使い方"}, {"type": "subtitle", "time": 11086.269, "timestamp": "03:04:46", "text": "コンドミニアムが"}, {"type": "subtitle", "time": 11091.23, "timestamp": "03:04:51", "text": "一体何なんだ、はっきりしてきたが"}, {"type": "subtitle", "time": 11095.55, "timestamp": "03:04:55", "text": "えー、バカールはクソ野郎だ、何だって"}, {"type": "subtitle", "time": 11097.71, "timestamp": "03:04:57", "text": "地獄"}]
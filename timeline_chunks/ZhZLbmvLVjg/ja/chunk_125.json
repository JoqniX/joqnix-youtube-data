[{"type": "subtitle", "time": 7501.83, "timestamp": "02:05:01", "text": "けれど？彼はあなたを引っ掻くことができる、"}, {"type": "subtitle", "time": 7502.91, "timestamp": "02:05:02", "text": "なぜならあなたは"}, {"type": "subtitle", "time": 7507.07, "timestamp": "02:05:07", "text": "痛み。それは怪しい点の一つだ。 2つ目に、彼は"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "噛む。意地悪をしろ。ああ、ネオはこんな感じ"}, {"type": "subtitle", "time": 7518.669, "timestamp": "02:05:18", "text": "私は怪しいです"}, {"type": "subtitle", "time": 7522.07, "timestamp": "02:05:22", "text": "容疑者。うん。ええ、その通りです。"}, {"type": "subtitle", "time": 7524.79, "timestamp": "02:05:24", "text": "その通り。よし、レオにしよう。しかし"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "あと、私も刀が好きです。武士。それで、"}, {"type": "subtitle", "time": 7529.95, "timestamp": "02:05:29", "text": "あのね？だって私たちは遊んでるんだもん"}, {"type": "subtitle", "time": 7532.76, "timestamp": "02:05:32", "text": "ゲームなら、"}, {"type": "subtitle", "time": 7533.87, "timestamp": "02:05:33", "text": "[音楽]"}, {"type": "subtitle", "time": 7558.03, "timestamp": "02:05:58", "text": "はい、あなたは見るのが好きなネカですね。"}]
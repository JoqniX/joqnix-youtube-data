[{"type": "subtitle", "time": 15960.43, "timestamp": "04:26:00", "text": "そして次に"}, {"type": "subtitle", "time": 15962.99, "timestamp": "04:26:02", "text": "[音楽]"}, {"type": "subtitle", "time": 15968.51, "timestamp": "04:26:08", "text": "ああ、わかりました。えっと、それからママが来る。 Mはオンです"}, {"type": "subtitle", "time": 15971.429, "timestamp": "04:26:11", "text": "トゥイッチ。うん。こんにちは、ムレイ。うん。こんにちは、"}, {"type": "subtitle", "time": 15973.75, "timestamp": "04:26:13", "text": "シャ。皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 15975.349, "timestamp": "04:26:15", "text": "あなたはハロウィンの宇宙飛行士の衣装を着ています"}, {"type": "subtitle", "time": 15977.189, "timestamp": "04:26:17", "text": "ヘルメット。え、どういう意味ですか？私は"}, {"type": "subtitle", "time": 15979.51, "timestamp": "04:26:19", "text": "宇宙飛行用ヘルメットを着用している。え、何？待って、"}, {"type": "subtitle", "time": 15980.84, "timestamp": "04:26:20", "text": "何？"}, {"type": "subtitle", "time": 15981.95, "timestamp": "04:26:21", "text": "[音楽]"}, {"type": "subtitle", "time": 15984.389, "timestamp": "04:26:24", "text": "シャカ、元気でいることを願っています。希望"}, {"type": "subtitle", "time": 15987.95, "timestamp": "04:26:27", "text": "あなたはよくやっています。私、どうだったか"}, {"type": "subtitle", "time": 15990.03, "timestamp": "04:26:30", "text": "ハロウィン？どうでしたか？"}, {"type": "subtitle", "time": 15993.67, "timestamp": "04:26:33", "text": "ハロウィン？素晴らしいですね、あなたが"}, {"type": "subtitle", "time": 15995.07, "timestamp": "04:26:35", "text": "順調に進んでいます、"}, {"type": "subtitle", "time": 15997.469, "timestamp": "04:26:37", "text": "加藤。お元気ですか、"}, {"type": "subtitle", "time": 16001.63, "timestamp": "04:26:41", "text": "加藤？ハッピーハロウィン。そして男よ、"}, {"type": "subtitle", "time": 16004.389, "timestamp": "04:26:44", "text": "ハッピーハロウィン！お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 16006.91, "timestamp": "04:26:46", "text": "良い。それは"}, {"type": "subtitle", "time": 16010.71, "timestamp": "04:26:50", "text": "その間。こんにちは、ママ。次は"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "任命されたモデレーター。それから、えっと、私たちは"}, {"type": "subtitle", "time": 16016.71, "timestamp": "04:26:56", "text": "剣の魂を手に入れた"}]
[{"type": "subtitle", "time": 19021.99, "timestamp": "05:17:01", "text": "でも、すごく快適だよ。そしてあなたが"}, {"type": "subtitle", "time": 19023.708, "timestamp": "05:17:03", "text": "感じる"}, {"type": "subtitle", "time": 19026.788, "timestamp": "05:17:06", "text": "夜は、顎を乗せてもいいですよ"}, {"type": "subtitle", "time": 19030.47, "timestamp": "05:17:10", "text": "下へ降りて、走るようにして、これをします。どうすれば"}, {"type": "subtitle", "time": 19033.39, "timestamp": "05:17:13", "text": "私は好きです"}, {"type": "subtitle", "time": 19038.67, "timestamp": "05:17:18", "text": "これ？とても快適です。それから小さな"}, {"type": "subtitle", "time": 19042.31, "timestamp": "05:17:22", "text": "ネコチャマはとても可愛くてぷにぷにしていて"}, {"type": "subtitle", "time": 19057.788, "timestamp": "05:17:37", "text": "ああ、それは"}, {"type": "subtitle", "time": 19061.35, "timestamp": "05:17:41", "text": "そう、本当に可愛いですね。そういうことだ"}, {"type": "subtitle", "time": 19062.27, "timestamp": "05:17:42", "text": "それで"}, {"type": "subtitle", "time": 19064.708, "timestamp": "05:17:44", "text": "愛らしい。好きになるとは思っていませんでした"}, {"type": "subtitle", "time": 19067.31, "timestamp": "05:17:47", "text": "実際に手に入れる"}, {"type": "subtitle", "time": 19071.35, "timestamp": "05:17:51", "text": "えっと、これ、えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 19075.19, "timestamp": "05:17:55", "text": "この、えーっと、文字通りフィットするようなものを手に入れましょう"}, {"type": "subtitle", "time": 19078.15, "timestamp": "05:17:58", "text": "背景も含めて。それは"}]
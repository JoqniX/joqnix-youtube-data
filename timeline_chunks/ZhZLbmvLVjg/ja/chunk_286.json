[{"type": "subtitle", "time": 17162.628, "timestamp": "04:46:02", "text": "すべて、そしてそう、だから私はチェックしていました"}, {"type": "subtitle", "time": 17164.868, "timestamp": "04:46:04", "text": "それを週単位か月単位で"}, {"type": "subtitle", "time": 17167.03, "timestamp": "04:46:07", "text": "暇な時にいつでも、毎日または定期的に"}, {"type": "subtitle", "time": 17171.27, "timestamp": "04:46:11", "text": "無料、そしてそれが私が誰を知っていたか"}, {"type": "subtitle", "time": 17173.99, "timestamp": "04:46:13", "text": "すべては活動的で、"}, {"type": "subtitle", "time": 17177.35, "timestamp": "04:46:17", "text": "好きな人だけが言及するようなこと"}, {"type": "subtitle", "time": 17179.51, "timestamp": "04:46:19", "text": "彼らはインド出身のインド人か、あるいは彼らは"}, {"type": "subtitle", "time": 17181.99, "timestamp": "04:46:21", "text": "インド人ユーチューバーのTwitterより"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "Twitch でそれらのすべてを見たら、私は"}, {"type": "subtitle", "time": 17187.51, "timestamp": "04:46:27", "text": "何とかして見つけることができれば、"}, {"type": "subtitle", "time": 17189.628, "timestamp": "04:46:29", "text": "そんなことはしないで、痛いから"}, {"type": "subtitle", "time": 17193.99, "timestamp": "04:46:33", "text": "特にその主要なものを支払う"}, {"type": "subtitle", "time": 17197.43, "timestamp": "04:46:37", "text": "インド人、またはインド・ヴバ、それがキーワードです"}, {"type": "subtitle", "time": 17200.23, "timestamp": "04:46:40", "text": "もしそれが重要なポイントだったとしたら"}, {"type": "subtitle", "time": 17203.43, "timestamp": "04:46:43", "text": "そしてスローンが登場して以来、"}, {"type": "subtitle", "time": 17206.948, "timestamp": "04:46:46", "text": "Throneのスタッフは本当に素晴らしかった。えっと"}, {"type": "subtitle", "time": 17209.91, "timestamp": "04:46:49", "text": "連絡を取ったインターンの1人"}, {"type": "subtitle", "time": 17213.51, "timestamp": "04:46:53", "text": "Vtuberコミュニティなどへ、"}, {"type": "subtitle", "time": 17215.27, "timestamp": "04:46:55", "text": "親切にも教えてくれた"}, {"type": "subtitle", "time": 17219.03, "timestamp": "04:46:59", "text": "VTubか何かが事前にわかる"}]
[{"type": "subtitle", "time": 15902.51, "timestamp": "04:25:02", "text": "任命されたメンバーに"}, {"type": "subtitle", "time": 15907.03, "timestamp": "04:25:07", "text": "でも、でも、それは近いうちにやりますよ。こんにちは。"}, {"type": "subtitle", "time": 15911.51, "timestamp": "04:25:11", "text": "ええ、ご覧のとおり、アルちゃんは"}, {"type": "subtitle", "time": 15913.269, "timestamp": "04:25:13", "text": "モデレーターの1人"}, {"type": "subtitle", "time": 15916.95, "timestamp": "04:25:16", "text": "モデレーター。ああ、最初のはアル"}, {"type": "subtitle", "time": 15920.03, "timestamp": "04:25:20", "text": "チャンは"}, {"type": "subtitle", "time": 15923.75, "timestamp": "04:25:23", "text": "A、それから待って、実際に"}, {"type": "subtitle", "time": 15926.309, "timestamp": "04:25:26", "text": "アルファベット順にしますか？もしそれが"}, {"type": "subtitle", "time": 15930.189, "timestamp": "04:25:30", "text": "アルファベット順で、次は誰ですか？"}, {"type": "subtitle", "time": 15934.309, "timestamp": "04:25:34", "text": "わかった。こんにちは。次に列に並んでいる人"}, {"type": "subtitle", "time": 15935.71, "timestamp": "04:25:35", "text": "意思"}, {"type": "subtitle", "time": 15939.91, "timestamp": "04:25:39", "text": "セレスティア・ジャマになりましょう。うん。セレスティア・ヴォイド"}, {"type": "subtitle", "time": 15942.75, "timestamp": "04:25:42", "text": "フォレストChより。彼女はまた、"}, {"type": "subtitle", "time": 15946.03, "timestamp": "04:25:46", "text": "モッド。そう、彼女も"}, {"type": "subtitle", "time": 15949.71, "timestamp": "04:25:49", "text": "彼女も入った。"}, {"type": "subtitle", "time": 15954.32, "timestamp": "04:25:54", "text": "わーい。彼は現在、司会者も務めている。それで、"}, {"type": "subtitle", "time": 15957.229, "timestamp": "04:25:57", "text": "[音楽]"}]
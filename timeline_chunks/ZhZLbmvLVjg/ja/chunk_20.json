[{"type": "subtitle", "time": 1209.87, "timestamp": "00:20:09", "text": "神。私は違います"}, {"type": "subtitle", "time": 1213.39, "timestamp": "00:20:13", "text": "ここ。では、Cについて何を知っていますか？"}, {"type": "subtitle", "time": 1218.95, "timestamp": "00:20:18", "text": "運動選手？もっと普通の人間らしいことを。"}, {"type": "subtitle", "time": 1220.43, "timestamp": "00:20:20", "text": "私は猫が好きです。"}, {"type": "subtitle", "time": 1225.11, "timestamp": "00:20:25", "text": "バカは30匹か40匹くらいの猫を飼っていたと思う"}, {"type": "subtitle", "time": 1226.11, "timestamp": "00:20:26", "text": "オーバー"}, {"type": "subtitle", "time": 1241.47, "timestamp": "00:20:41", "text": "だから、猫が"}, {"type": "subtitle", "time": 1246.07, "timestamp": "00:20:46", "text": "くすぐったり、首を軽く叩いたりして、"}, {"type": "subtitle", "time": 1249.23, "timestamp": "00:20:49", "text": "彼らはそれを気に入っている。それは"}, {"type": "subtitle", "time": 1251.83, "timestamp": "00:20:51", "text": "1つ。お腹を撫でると、"}, {"type": "subtitle", "time": 1252.909, "timestamp": "00:20:52", "text": "のように"}]
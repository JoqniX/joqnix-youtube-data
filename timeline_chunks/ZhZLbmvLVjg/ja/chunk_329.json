[{"type": "subtitle", "time": 19741.59, "timestamp": "05:29:01", "text": "お気に入り。彼の妻と息子は"}, {"type": "subtitle", "time": 19744.15, "timestamp": "05:29:04", "text": "亡くなったが、彼はよく旅に出ていた。"}, {"type": "subtitle", "time": 19747.19, "timestamp": "05:29:07", "text": "時々ジェイクはただ車に乗り込み、"}, {"type": "subtitle", "time": 19749.39, "timestamp": "05:29:09", "text": "走り去った"}, {"type": "subtitle", "time": 19753.03, "timestamp": "05:29:13", "text": "どこにもない。道路の照明があまり明るくなかった。"}, {"type": "subtitle", "time": 19755.708, "timestamp": "05:29:15", "text": "結局、田舎道はあった。"}, {"type": "subtitle", "time": 19758.67, "timestamp": "05:29:18", "text": "それはこれまで"}, {"type": "subtitle", "time": 19763.07, "timestamp": "05:29:23", "text": "1980年代以降に修復された。"}, {"type": "subtitle", "time": 19765.31, "timestamp": "05:29:25", "text": "現在"}, {"type": "subtitle", "time": 19768.788, "timestamp": "05:29:28", "text": "2005年には既に劣化していた"}, {"type": "subtitle", "time": 19771.19, "timestamp": "05:29:31", "text": "天候と高い"}, {"type": "subtitle", "time": 19774.708, "timestamp": "05:29:34", "text": "トラックの交通量。今"}, {"type": "subtitle", "time": 19776.27, "timestamp": "05:29:36", "text": "トラック"}, {"type": "subtitle", "time": 19779.83, "timestamp": "05:29:39", "text": "この道を避けようとしましたが、"}, {"type": "subtitle", "time": 19782.868, "timestamp": "05:29:42", "text": "貧しいため、できる限り"}, {"type": "subtitle", "time": 19785.35, "timestamp": "05:29:45", "text": "条件。"}, {"type": "subtitle", "time": 19787.43, "timestamp": "05:29:47", "text": "劣悪な状況に陥った。多くの"}, {"type": "subtitle", "time": 19789.47, "timestamp": "05:29:49", "text": "ライトは"}, {"type": "subtitle", "time": 19791.788, "timestamp": "05:29:51", "text": "働いていて誰もいない"}]
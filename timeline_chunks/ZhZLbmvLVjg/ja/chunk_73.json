[{"type": "subtitle", "time": 4383.07, "timestamp": "01:13:03", "text": "[拍手]"}, {"type": "subtitle", "time": 4384.83, "timestamp": "01:13:04", "text": "はい。"}, {"type": "subtitle", "time": 4388.35, "timestamp": "01:13:08", "text": "あなたが"}, {"type": "subtitle", "time": 4390.03, "timestamp": "01:13:10", "text": "最高だ。"}, {"type": "subtitle", "time": 4392.91, "timestamp": "01:13:12", "text": "え、何？"}, {"type": "subtitle", "time": 4396.51, "timestamp": "01:13:16", "text": "クレイミー、何してるの？"}, {"type": "subtitle", "time": 4398.47, "timestamp": "01:13:18", "text": "じめじめして、私たちには無理だ"}, {"type": "subtitle", "time": 4400.95, "timestamp": "01:13:20", "text": "送り主が我々の背後に迫っている。これは"}, {"type": "subtitle", "time": 4404.07, "timestamp": "01:13:24", "text": "でも、行かなければならないと言わなければならない。私 私"}, {"type": "subtitle", "time": 4406.11, "timestamp": "01:13:26", "text": "それを書いた。"}, {"type": "subtitle", "time": 4410.31, "timestamp": "01:13:30", "text": "何？でも、でも、でも、でも、私たちの誰も知らないんです。"}, {"type": "subtitle", "time": 4412.07, "timestamp": "01:13:32", "text": "誰もが"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "でも、私たちのどちらかが何をしなければならないの？君を"}, {"type": "subtitle", "time": 4419.79, "timestamp": "01:13:39", "text": "私の小さな部外者ラム。待って、"}, {"type": "subtitle", "time": 4422.189, "timestamp": "01:13:42", "text": "何？登る"}, {"type": "subtitle", "time": 4424.95, "timestamp": "01:13:44", "text": "自分。いや、いや、いや、いや。犠牲にしてはならない"}, {"type": "subtitle", "time": 4426.83, "timestamp": "01:13:46", "text": "あなた自身。おお、"}, {"type": "subtitle", "time": 4429.07, "timestamp": "01:13:49", "text": "待って。"}, {"type": "subtitle", "time": 4430.669, "timestamp": "01:13:50", "text": "いいえ、"}, {"type": "subtitle", "time": 4433.95, "timestamp": "01:13:53", "text": "アサリ。家に帰るには"}, {"type": "subtitle", "time": 4437.07, "timestamp": "01:13:57", "text": "自分。家に帰らなければならない"}]
[{"type": "subtitle", "time": 8166.95, "timestamp": "02:16:06", "text": "死ぬ。本当に素晴らしいサウンドパックを想像してみてください。あなたが知っている"}, {"type": "subtitle", "time": 8169.39, "timestamp": "02:16:09", "text": "実際にやったユーチューバー"}, {"type": "subtitle", "time": 8173.229, "timestamp": "02:16:13", "text": "それ。彼女はやり遂げた。ズキは"}, {"type": "subtitle", "time": 8177.669, "timestamp": "02:16:17", "text": "それ。ああ、ズキがやったんだよ。たくさんあります"}, {"type": "subtitle", "time": 8181.03, "timestamp": "02:16:21", "text": "効果音。ズキ、ズキだけじゃなくて、えーと、"}, {"type": "subtitle", "time": 8185.31, "timestamp": "02:16:25", "text": "コアはヘラコードがやった時にもやった"}, {"type": "subtitle", "time": 8188.39, "timestamp": "02:16:28", "text": "それは、でも私は彼が実際に"}, {"type": "subtitle", "time": 8192.549, "timestamp": "02:16:32", "text": "公表された。それはただ、えーっと、えーっと"}, {"type": "subtitle", "time": 8195.349, "timestamp": "02:16:35", "text": "彼の不和の中で。私はそれをグーグルのように見た"}, {"type": "subtitle", "time": 8198.709, "timestamp": "02:16:38", "text": "ドライブにはそれらすべてがたくさん含まれている。それ"}, {"type": "subtitle", "time": 8207.83, "timestamp": "02:16:47", "text": "いろいろありそうですね。他に誰がいるだろうか"}, {"type": "subtitle", "time": 8210.03, "timestamp": "02:16:50", "text": "母がやったの？私はしません"}, {"type": "subtitle", "time": 8219.79, "timestamp": "02:16:59", "text": "それ。ミヤダが言ったら、私は"}]
[{"type": "subtitle", "time": 16982.07, "timestamp": "04:43:02", "text": "その方法と理由は？どうしてそれがわかるの？"}, {"type": "subtitle", "time": 16988.11, "timestamp": "04:43:08", "text": "[音楽]"}, {"type": "subtitle", "time": 16995.47, "timestamp": "04:43:15", "text": "大きな私？"}, {"type": "subtitle", "time": 17005.23, "timestamp": "04:43:25", "text": "イオンは"}, {"type": "subtitle", "time": 17008.868, "timestamp": "04:43:28", "text": "今日、インチューバー。ルナ・ミラ。うん、ローラ"}, {"type": "subtitle", "time": 17012.47, "timestamp": "04:43:32", "text": "ショーンは鈴木と長い間コラボレーションしていた"}, {"type": "subtitle", "time": 17014.43, "timestamp": "04:43:34", "text": "戻る。"}, {"type": "subtitle", "time": 17017.35, "timestamp": "04:43:37", "text": "2021年から2022年の期間。うん、そうだと思う"}, {"type": "subtitle", "time": 17021.03, "timestamp": "04:43:41", "text": "2022年期間。楽しいコラボレーションでした。"}, {"type": "subtitle", "time": 17024.51, "timestamp": "04:43:44", "text": "右？皆さんもぜひチェックしてみてください"}, {"type": "subtitle", "time": 17027.99, "timestamp": "04:43:47", "text": "外。楽しいですよ。私もコラボレーションしたかった"}, {"type": "subtitle", "time": 17032.51, "timestamp": "04:43:52", "text": "ルナと一緒に、でも私は"}, {"type": "subtitle", "time": 17035.43, "timestamp": "04:43:55", "text": "シャイ。しかし、崩壊の話をしていると、"}, {"type": "subtitle", "time": 17037.59, "timestamp": "04:43:57", "text": "本当に自分自身を成長させる必要があるし、"}]
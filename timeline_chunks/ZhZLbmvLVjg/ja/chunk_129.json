[{"type": "subtitle", "time": 7751.51, "timestamp": "02:09:11", "text": "迷惑だ、電話してこないし、自分からも電話してこない"}, {"type": "subtitle", "time": 7754.35, "timestamp": "02:09:14", "text": "またネッコだ。"}, {"type": "subtitle", "time": 7756.149, "timestamp": "02:09:16", "text": "[音楽]"}, {"type": "subtitle", "time": 7758.51, "timestamp": "02:09:18", "text": "電話しないわけじゃないよ"}, {"type": "subtitle", "time": 7762.189, "timestamp": "02:09:22", "text": "自分自身。私は今、"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "コーチ。私を見て。私には耳がある。ニャー。"}, {"type": "subtitle", "time": 7767.589, "timestamp": "02:09:27", "text": "ニャー。ニャー。ああ、何が起こったのか"}, {"type": "subtitle", "time": 7768.47, "timestamp": "02:09:28", "text": "モデル？"}, {"type": "subtitle", "time": 7771.149, "timestamp": "02:09:31", "text": "[音楽]"}]
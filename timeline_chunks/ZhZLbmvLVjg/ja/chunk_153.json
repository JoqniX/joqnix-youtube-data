[{"type": "subtitle", "time": 9180.309, "timestamp": "02:33:00", "text": "なぜ。だから、これを終わらせる必要があるんだ"}, {"type": "subtitle", "time": 9192.51, "timestamp": "02:33:12", "text": "市。待って、すべての思い出を手に入れたの？"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "けれど？ええ、そうしましたよ。つまり、たった3人だけ"}, {"type": "subtitle", "time": 9198.23, "timestamp": "02:33:18", "text": "まだまだ手に入れたい思い出が残っている"}, {"type": "subtitle", "time": 9201.59, "timestamp": "02:33:21", "text": "もの。えっと、私は恥ずかしがり屋なので実際に"}, {"type": "subtitle", "time": 9204.63, "timestamp": "02:33:24", "text": "そういうことに実際に携わる。"}, {"type": "subtitle", "time": 9207.83, "timestamp": "02:33:27", "text": "待って、これは本当に良い"}, {"type": "subtitle", "time": 9234.27, "timestamp": "02:33:54", "text": "それは"}, {"type": "subtitle", "time": 9236.67, "timestamp": "02:33:56", "text": "これ？ああ、それは"}]
[{"type": "subtitle", "time": 4440.87, "timestamp": "01:14:00", "text": "自分。消え失せろ。したくないの？"}, {"type": "subtitle", "time": 4444.35, "timestamp": "01:14:04", "text": "家に帰りたい"}, {"type": "subtitle", "time": 4451.47, "timestamp": "01:14:11", "text": "はぁ？これ"}, {"type": "subtitle", "time": 4454.79, "timestamp": "01:14:14", "text": "くそ。あの女性はどこにいるの？ロバートは"}, {"type": "subtitle", "time": 4464.07, "timestamp": "01:14:24", "text": "おい、おい？彼は私に教えてくれた。彼女は今、イライラしたのか"}, {"type": "subtitle", "time": 4481.31, "timestamp": "01:14:41", "text": "バック。彼女が世話をしてくれるといいな"}, {"type": "subtitle", "time": 4484.39, "timestamp": "01:14:44", "text": "彼女自身。ああ、私は頭がおかしい。噛まないで"}, {"type": "subtitle", "time": 4488.149, "timestamp": "01:14:48", "text": "彼女を突き放せ。いいえ、私は彼女を引っ掻いて"}]
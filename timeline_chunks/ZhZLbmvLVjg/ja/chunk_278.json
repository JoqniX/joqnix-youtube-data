[{"type": "subtitle", "time": 16680.67, "timestamp": "04:38:00", "text": "タグを見て、私はあなたが"}, {"type": "subtitle", "time": 16690.869, "timestamp": "04:38:10", "text": "うん。私は実際にはタグを付けていません。私"}, {"type": "subtitle", "time": 16692.551, "timestamp": "04:38:12", "text": "私のタグがあるかどうかわかりません"}, {"type": "subtitle", "time": 16695.429, "timestamp": "04:38:15", "text": "ストリーム。 Vid IQなどのチェックをすると"}, {"type": "subtitle", "time": 16698.551, "timestamp": "04:38:18", "text": "他のものについては、"}, {"type": "subtitle", "time": 16701.109, "timestamp": "04:38:21", "text": "ずっと昔からのデフォルト設定。それらの"}, {"type": "subtitle", "time": 16709.15, "timestamp": "04:38:29", "text": "[音楽]"}, {"type": "subtitle", "time": 16711.83, "timestamp": "04:38:31", "text": "うん。でも、気にしないでください。私は食べています"}, {"type": "subtitle", "time": 16714.23, "timestamp": "04:38:34", "text": "オレンジ、だってほら、今日は"}, {"type": "subtitle", "time": 16717.269, "timestamp": "04:38:37", "text": "ハロウィン。すべてがオレンジ色、金色"}, {"type": "subtitle", "time": 16719.99, "timestamp": "04:38:39", "text": "色は、今はカボチャ色です。それで、私は"}, {"type": "subtitle", "time": 16734.551, "timestamp": "04:38:54", "text": "オレンジ。そして私は完全に回復しました"}, {"type": "subtitle", "time": 16737.23, "timestamp": "04:38:57", "text": "ビバとは"}]
[{"type": "subtitle", "time": 4810.11, "timestamp": "01:20:10", "text": "右。人間だけが"}, {"type": "subtitle", "time": 4816.229, "timestamp": "01:20:16", "text": "人間。また、私は"}, {"type": "subtitle", "time": 4818.07, "timestamp": "01:20:18", "text": "人間とみなされる。ねえ、それも"}, {"type": "subtitle", "time": 4819.63, "timestamp": "01:20:19", "text": "攻撃"}, {"type": "subtitle", "time": 4822.87, "timestamp": "01:20:22", "text": "安全。この通路を開けてください。何が"}, {"type": "subtitle", "time": 4829.709, "timestamp": "01:20:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4832.57, "timestamp": "01:20:32", "text": "計画済み？一緒に歩けば、"}, {"type": "subtitle", "time": 4835.47, "timestamp": "01:20:35", "text": "[音楽]"}, {"type": "subtitle", "time": 4837.7, "timestamp": "01:20:37", "text": "言った、"}]
[{"type": "subtitle", "time": 14701.99, "timestamp": "04:05:01", "text": "チェックマークではなくアクセスしてください。"}, {"type": "subtitle", "time": 14703.91, "timestamp": "04:05:03", "text": "えっと、混乱させてしまう、それで混乱させてしまう"}, {"type": "subtitle", "time": 14706.71, "timestamp": "04:05:06", "text": "検証はOK、検証チェックマークは不要"}, {"type": "subtitle", "time": 14710.469, "timestamp": "04:05:10", "text": "チャンネルだけをマークする"}, {"type": "subtitle", "time": 14714.229, "timestamp": "04:05:14", "text": "フルアクセスってことか。うん、そうするよ。"}, {"type": "subtitle", "time": 14716.59, "timestamp": "04:05:16", "text": "ええと、そうします。君たちをキープするよ"}, {"type": "subtitle", "time": 14719.269, "timestamp": "04:05:19", "text": "アップデート。ということで、皆さんに感謝します。"}, {"type": "subtitle", "time": 14721.429, "timestamp": "04:05:21", "text": "今日来てくれた皆さん。本当に"}, {"type": "subtitle", "time": 14724.15, "timestamp": "04:05:24", "text": "本当に大きな意味があります。それで、カイシさんは、"}, {"type": "subtitle", "time": 14726.63, "timestamp": "04:05:26", "text": "来るよ。それは本当に大きな意味があります。ありがとう"}, {"type": "subtitle", "time": 14728.389, "timestamp": "04:05:28", "text": "最初からそこにいてくれてありがとう"}, {"type": "subtitle", "time": 14743.7, "timestamp": "04:05:43", "text": "の上。本当に感謝しています。"}, {"type": "subtitle", "time": 14746.07, "timestamp": "04:05:46", "text": "[音楽]"}, {"type": "subtitle", "time": 14747.469, "timestamp": "04:05:47", "text": "本当の意味は"}, {"type": "subtitle", "time": 14750.229, "timestamp": "04:05:50", "text": "多く。お越しいただきありがとうございます。私たちは話しました"}, {"type": "subtitle", "time": 14759.429, "timestamp": "04:05:59", "text": "もの。新しいことに慣れなければならない"}]
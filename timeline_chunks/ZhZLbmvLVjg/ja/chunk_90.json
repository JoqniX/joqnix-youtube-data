[{"type": "subtitle", "time": 5400.39, "timestamp": "01:30:00", "text": "日光。あれはモモです。そいつだ、"}, {"type": "subtitle", "time": 5406.27, "timestamp": "01:30:06", "text": "守護者。ああ、"}, {"type": "subtitle", "time": 5409.03, "timestamp": "01:30:09", "text": "神よ、彼らは太陽の光を見ている"}, {"type": "subtitle", "time": 5417.35, "timestamp": "01:30:17", "text": "あれはグラミーだ。彼女はまだ生きている。感謝"}, {"type": "subtitle", "time": 5420.24, "timestamp": "01:30:20", "text": "神。"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "犠牲。彼を迎えに行くよ。"}, {"type": "subtitle", "time": 5446.47, "timestamp": "01:30:46", "text": "おい、彼を抱き上げろ。選びに行くの？"}, {"type": "subtitle", "time": 5449.47, "timestamp": "01:30:49", "text": "彼を立ち上がらせた。彼はもっと生き生きとしなければならない。"}, {"type": "subtitle", "time": 5454.189, "timestamp": "01:30:54", "text": "ああ、彼を抱き上げて。"}]
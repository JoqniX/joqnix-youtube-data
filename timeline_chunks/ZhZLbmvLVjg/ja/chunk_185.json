[{"type": "subtitle", "time": 11107.67, "timestamp": "03:05:07", "text": "ああ、なんてことだ、私は自分がそんなに"}, {"type": "subtitle", "time": 11146.63, "timestamp": "03:05:46", "text": "えっと、塩。だって彼女は素晴らしすぎるから。"}, {"type": "subtitle", "time": 11149.79, "timestamp": "03:05:49", "text": "本当だ、本当だ、本当だ、本当だ。それは"}, {"type": "subtitle", "time": 11152.99, "timestamp": "03:05:52", "text": "真実。私は彼をからかうのが好きだ"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "彼を怒らせるのが怖いけど、"}, {"type": "subtitle", "time": 11157.63, "timestamp": "03:05:57", "text": "行く"}, {"type": "subtitle", "time": 11159.67, "timestamp": "03:05:59", "text": "多くの。だから、行きたくないんです"}]
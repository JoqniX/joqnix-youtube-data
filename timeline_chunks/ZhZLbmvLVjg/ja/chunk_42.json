[{"type": "subtitle", "time": 2529.589, "timestamp": "00:42:09", "text": "ここ？これは遅刻犯ですか？やあ、"}, {"type": "subtitle", "time": 2532.03, "timestamp": "00:42:12", "text": "何をしているの？上で何をしているの？"}, {"type": "subtitle", "time": 2539.309, "timestamp": "00:42:19", "text": "よし、じゃあここに行こう。"}, {"type": "subtitle", "time": 2540.829, "timestamp": "00:42:20", "text": "会う"}, {"type": "subtitle", "time": 2543.589, "timestamp": "00:42:23", "text": "アレックス。さあ、飛び込んで飲み物を取りに行こう。おお、"}, {"type": "subtitle", "time": 2551.03, "timestamp": "00:42:31", "text": "アレックス。ああ、大変だ。彼は私たちに無料チケットをくれた"}, {"type": "subtitle", "time": 2561.109, "timestamp": "00:42:41", "text": "あなた。ニース。マイルズのような"}, {"type": "subtitle", "time": 2564.87, "timestamp": "00:42:44", "text": "自分で作ったの？ああ、まるでドラゴンのようだ。"}, {"type": "subtitle", "time": 2566.19, "timestamp": "00:42:46", "text": "ドラゴンの頭。"}, {"type": "subtitle", "time": 2568.03, "timestamp": "00:42:48", "text": "はい。誰が"}, {"type": "subtitle", "time": 2576.589, "timestamp": "00:42:56", "text": "えっと、その男って誰だっけ？する必要がある"}, {"type": "subtitle", "time": 2579.95, "timestamp": "00:42:59", "text": "見る。この人ですか？それは私の"}]
[{"type": "subtitle", "time": 15670.07, "timestamp": "04:21:10", "text": "[音楽]"}, {"type": "subtitle", "time": 15671.67, "timestamp": "04:21:11", "text": "見えないわけじゃないですよね？そうではありません"}, {"type": "subtitle", "time": 15674.99, "timestamp": "04:21:14", "text": "見えないですよね？わかった。今気づいた"}, {"type": "subtitle", "time": 15678.389, "timestamp": "04:21:18", "text": "何か。今、あることに気づいた。どうやって"}, {"type": "subtitle", "time": 15682.189, "timestamp": "04:21:22", "text": "レイヤーを再度削除しますか？私は行く"}, {"type": "subtitle", "time": 15685.189, "timestamp": "04:21:25", "text": "えっと、レイヤーを削除するにはどうすればいいですか？わかった。する"}, {"type": "subtitle", "time": 15687.59, "timestamp": "04:21:27", "text": "あなたはそれが分からないんですよね？わかった。"}, {"type": "subtitle", "time": 15688.91, "timestamp": "04:21:28", "text": "その"}, {"type": "subtitle", "time": 15691.83, "timestamp": "04:21:31", "text": "去った。靴の新しいアップデートは"}, {"type": "subtitle", "time": 15696.349, "timestamp": "04:21:36", "text": "本当に素晴らしい。とても楽しかったです"}, {"type": "subtitle", "time": 15698.67, "timestamp": "04:21:38", "text": "これ。"}, {"type": "subtitle", "time": 15701.99, "timestamp": "04:21:41", "text": "えっと、どうしてこんなに大きな"}, {"type": "subtitle", "time": 15706.469, "timestamp": "04:21:46", "text": "ネコの上の髭みたいなやつ？ない"}, {"type": "subtitle", "time": 15712.71, "timestamp": "04:21:52", "text": "N. ああ、私は色覚異常があるんです。誰がクロマを置いたのか"}, {"type": "subtitle", "time": 15713.95, "timestamp": "04:21:53", "text": "鍵？ああ、"}]
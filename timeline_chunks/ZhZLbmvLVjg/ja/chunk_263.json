[{"type": "subtitle", "time": 15781.349, "timestamp": "04:23:01", "text": "もっと。あなたには理解できないかもしれない"}, {"type": "subtitle", "time": 15784.269, "timestamp": "04:23:04", "text": "私が着ているもの"}, {"type": "subtitle", "time": 15787.67, "timestamp": "04:23:07", "text": "これ。ちょっと可愛いですね。見て見て"}, {"type": "subtitle", "time": 15789.349, "timestamp": "04:23:09", "text": "彼らに向かって。つまり、今は寝室があるということだ"}, {"type": "subtitle", "time": 15793.83, "timestamp": "04:23:13", "text": "などなど。そして私はこの星空が好きです、"}, {"type": "subtitle", "time": 15798.389, "timestamp": "04:23:18", "text": "黒と金色をテーマにした"}, {"type": "subtitle", "time": 15802.149, "timestamp": "04:23:22", "text": "金色、オレンジ色、金色をテーマにした星"}, {"type": "subtitle", "time": 15804.229, "timestamp": "04:23:24", "text": "そして全て。この部屋はそれほど"}, {"type": "subtitle", "time": 15810.309, "timestamp": "04:23:30", "text": "ニース。ああ、本にもそういうものがありますよ。えっと、でも私は"}, {"type": "subtitle", "time": 15813.189, "timestamp": "04:23:33", "text": "ええ、本はそうします。私はそもそも読書をするのだろうか？私はします"}, {"type": "subtitle", "time": 15814.11, "timestamp": "04:23:34", "text": "読む"}, {"type": "subtitle", "time": 15817.91, "timestamp": "04:23:37", "text": "時々。だから、本当にすごく楽しんでいます。"}, {"type": "subtitle", "time": 15819.79, "timestamp": "04:23:39", "text": "だから私は本当に疲れているんです。とても"}, {"type": "subtitle", "time": 15822.03, "timestamp": "04:23:42", "text": "疲れた。あなたは眠る"}, {"type": "subtitle", "time": 15825.07, "timestamp": "04:23:45", "text": "良い。寝てください"}, {"type": "subtitle", "time": 15829.59, "timestamp": "04:23:49", "text": "良い。あなたはよく眠れますね。ええ、そうですね。えっと、"}, {"type": "subtitle", "time": 15832.63, "timestamp": "04:23:52", "text": "今日は配信します。"}, {"type": "subtitle", "time": 15835.469, "timestamp": "04:23:55", "text": "皆さん、最近の出来事について最新情報を入手してください。"}, {"type": "subtitle", "time": 15839.309, "timestamp": "04:23:59", "text": "メジャー2をやらなきゃいけないのを忘れてた"}]
[{"type": "subtitle", "time": 19146.07, "timestamp": "05:19:06", "text": "えーと [音楽]"}, {"type": "subtitle", "time": 19159.09, "timestamp": "05:19:19", "text": "えっと"}, {"type": "subtitle", "time": 19169.55, "timestamp": "05:19:29", "text": "[音楽]"}, {"type": "subtitle", "time": 19173.43, "timestamp": "05:19:33", "text": "よし、行こう。ああ、幽霊みたい"}, {"type": "subtitle", "time": 19175.11, "timestamp": "05:19:35", "text": "星座。"}, {"type": "subtitle", "time": 19177.868, "timestamp": "05:19:37", "text": "待って、あれって本当に幽霊なの？"}, {"type": "subtitle", "time": 19180.708, "timestamp": "05:19:40", "text": "慰め？あ、待って。実際に"}, {"type": "subtitle", "time": 19184.948, "timestamp": "05:19:44", "text": "幽霊のような星座になる。おお。おお"}, {"type": "subtitle", "time": 19187.35, "timestamp": "05:19:47", "text": "我が神よ。これは私にインスピレーションを与えてくれる"}, {"type": "subtitle", "time": 19189.51, "timestamp": "05:19:49", "text": "服装とか、そういうものに使うんだ。ああ、"}, {"type": "subtitle", "time": 19194.11, "timestamp": "05:19:54", "text": "神。猫のデザインみたい。ああ、"}, {"type": "subtitle", "time": 19198.47, "timestamp": "05:19:58", "text": "神。何てことだ。私は文字通り行くことができます"}]
[{"type": "subtitle", "time": 10922.95, "timestamp": "03:02:02", "text": "もの。彼女から電話がかかってきた。私はあまり読書をしません"}, {"type": "subtitle", "time": 10961.91, "timestamp": "03:02:41", "text": "内部。はい。中に入ってください。はい、行きました"}, {"type": "subtitle", "time": 10964.269, "timestamp": "03:02:44", "text": "内部。よし、これらは"}, {"type": "subtitle", "time": 10966.269, "timestamp": "03:02:46", "text": "内部。行く。"}, {"type": "subtitle", "time": 10970.269, "timestamp": "03:02:50", "text": "行く。全部手に入れたらどうなるの？"}, {"type": "subtitle", "time": 10973.51, "timestamp": "03:02:53", "text": "内部？中はすべてなくなってしまった。わかった。"}, {"type": "subtitle", "time": 10975.15, "timestamp": "03:02:55", "text": "これからどうなるのか？"}]
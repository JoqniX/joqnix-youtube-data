[{"type": "subtitle", "time": 3661.91, "timestamp": "01:01:01", "text": "ああ、一瞬怖かった。なれ"}, {"type": "subtitle", "time": 3664.47, "timestamp": "01:01:04", "text": "いいね。落ち着いて。落ち着いて。青色に変わる。"}, {"type": "subtitle", "time": 3666.47, "timestamp": "01:01:06", "text": "青色に変わる。青色に変わる。お願いします"}, {"type": "subtitle", "time": 3669.71, "timestamp": "01:01:09", "text": "青色に変わる。わかった、"}, {"type": "subtitle", "time": 3672.67, "timestamp": "01:01:12", "text": "[音楽]"}, {"type": "subtitle", "time": 3691.87, "timestamp": "01:01:31", "text": "わかった。以上"}, {"type": "subtitle", "time": 3705.67, "timestamp": "01:01:45", "text": "これ？わかった。彼らは私の面倒を見てくれている。"}, {"type": "subtitle", "time": 3707.309, "timestamp": "01:01:47", "text": "探している"}, {"type": "subtitle", "time": 3709.37, "timestamp": "01:01:49", "text": "自分。私"}, {"type": "subtitle", "time": 3711.87, "timestamp": "01:01:51", "text": "[音楽]"}, {"type": "subtitle", "time": 3715.39, "timestamp": "01:01:55", "text": "彼らは厳戒態勢にあると信じている。"}]
[{"type": "subtitle", "time": 18600.51, "timestamp": "05:10:00", "text": "本物"}, {"type": "subtitle", "time": 18602.19, "timestamp": "05:10:02", "text": "ホラー"}, {"type": "subtitle", "time": 18603.868, "timestamp": "05:10:03", "text": "話"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "最初の魚を読んで、でもあなたは言った、私は"}, {"type": "chat", "time": 18608.063, "timestamp": "05:10:08", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 18608.99, "timestamp": "05:10:08", "text": "それはあなたの"}, {"type": "subtitle", "time": 18614.75, "timestamp": "05:10:14", "text": "最初は、でもあなたは私があなたではないと言った"}, {"type": "chat", "time": 18616.237, "timestamp": "05:10:16", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ye, he did wish me"}, {"type": "subtitle", "time": 18616.59, "timestamp": "05:10:16", "text": "初め"}, {"type": "subtitle", "time": 18620.25, "timestamp": "05:10:20", "text": "家にいたが"}, {"type": "chat", "time": 18630.195, "timestamp": "05:10:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wut nice memory"}, {"type": "subtitle", "time": 18630.47, "timestamp": "05:10:30", "text": "えっと、どこで読みたいですか"}, {"type": "subtitle", "time": 18632.16, "timestamp": "05:10:32", "text": "読む"}, {"type": "subtitle", "time": 18634.11, "timestamp": "05:10:34", "text": "[音楽]"}, {"type": "subtitle", "time": 18638.35, "timestamp": "05:10:38", "text": "ホラー小説を読んだらどうですか？"}, {"type": "subtitle", "time": 18642.92, "timestamp": "05:10:42", "text": "えっと、文学クラブ。わかった。"}, {"type": "subtitle", "time": 18648.27, "timestamp": "05:10:48", "text": "[音楽]"}, {"type": "subtitle", "time": 18652.15, "timesta
[{"type": "subtitle", "time": 16383.349, "timestamp": "04:33:03", "text": "コスプレ犬を着る？私は一度もそうしたことはありません。えっと"}, {"type": "subtitle", "time": 16386.551, "timestamp": "04:33:06", "text": "私がドレスアップしたのは、"}, {"type": "subtitle", "time": 16391.349, "timestamp": "04:33:11", "text": "女性役を演じる女性"}, {"type": "subtitle", "time": 16394.07, "timestamp": "04:33:14", "text": "えっと、そして、私はこれを言ったんです"}, {"type": "subtitle", "time": 16396.789, "timestamp": "04:33:16", "text": "高校時代の恥ずかしい話"}, {"type": "subtitle", "time": 16400.429, "timestamp": "04:33:20", "text": "ジョックはかつてクレラだった"}, {"type": "subtitle", "time": 16403.59, "timestamp": "04:33:23", "text": "えっと、女の子の格好をさせられたんです。わかった、"}, {"type": "subtitle", "time": 16406.07, "timestamp": "04:33:26", "text": "私が言えるのはそれだけです。それが私の"}, {"type": "subtitle", "time": 16409.83, "timestamp": "04:33:29", "text": "私がやった唯一のコスプレです。それは本当に"}, {"type": "subtitle", "time": 16413.269, "timestamp": "04:33:33", "text": "コスプレとしてカウントされますか？"}, {"type": "subtitle", "time": 16417.01, "timestamp": "04:33:37", "text": "ああ、そうだね。つまり、それが唯一の"}, {"type": "subtitle", "time": 16419.07, "timestamp": "04:33:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16422.269, "timestamp": "04:33:42", "text": "もの。えっと"}, {"type": "subtitle", "time": 16425.359, "timestamp": "04:33:45", "text": "痛み、恥ずかしい"}, {"type": "subtitle", "time": 16430.99, "timestamp": "04:33:50", "text": "もの。"}, {"type": "subtitle", "time": 16435.39, "timestamp": "04:33:55", "text": "ああ、もっと。ジャマはどうですか？"}, {"type": "subtitle", "time": 16438.31, "timestamp": "04:33:58", "text": "何をしているの？元気ですか？調子はどうですか？"}]
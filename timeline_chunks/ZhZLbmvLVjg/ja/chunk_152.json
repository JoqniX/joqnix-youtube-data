[{"type": "subtitle", "time": 9121.83, "timestamp": "02:32:01", "text": "小さなひよこたち。裸の鶏。"}, {"type": "subtitle", "time": 9132.11, "timestamp": "02:32:12", "text": "ボンベイは私にとって馴染み深い場所です"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "まだ見ていません。する必要がある"}, {"type": "subtitle", "time": 9169.309, "timestamp": "02:32:49", "text": "うん。本当に？うん。誓って言うけど、私はこう思ってた"}]
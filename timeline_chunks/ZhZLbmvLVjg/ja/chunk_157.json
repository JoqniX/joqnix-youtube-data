[{"type": "subtitle", "time": 9421.95, "timestamp": "02:37:01", "text": "マンガ。だから私は2つしか読んでいません"}, {"type": "subtitle", "time": 9424.55, "timestamp": "02:37:04", "text": "章。ええ、たった2章だけです。それ"}, {"type": "subtitle", "time": 9426.87, "timestamp": "02:37:06", "text": "彼女が作家だった頃"}, {"type": "subtitle", "time": 9427.95, "timestamp": "02:37:07", "text": "書き込み"}, {"type": "subtitle", "time": 9430.87, "timestamp": "02:37:10", "text": "それ。そして、それを読まなかった時から、"}, {"type": "subtitle", "time": 9433.429, "timestamp": "02:37:13", "text": "いくつあると思いますか？私にさせて"}, {"type": "subtitle", "time": 9438.03, "timestamp": "02:37:18", "text": "チェック。"}, {"type": "subtitle", "time": 9441.03, "timestamp": "02:37:21", "text": "はい。うん。何章ありますか"}, {"type": "subtitle", "time": 9444.389, "timestamp": "02:37:24", "text": "吸血鬼がまたやったのか？今では"}, {"type": "subtitle", "time": 9447.67, "timestamp": "02:37:27", "text": "今、人気です。 Wikipediaには"}, {"type": "subtitle", "time": 9450.19, "timestamp": "02:37:30", "text": "ヴァンパの登場。"}, {"type": "subtitle", "time": 9453.79, "timestamp": "02:37:33", "text": "何？それは人気を博した。どうやって？"}, {"type": "subtitle", "time": 9458.55, "timestamp": "02:37:38", "text": "いつ？わかった。待って。おお、7つのタップボリューム"}, {"type": "subtitle", "time": 9460.429, "timestamp": "02:37:40", "text": "出てきた。"}]
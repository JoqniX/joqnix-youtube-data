[{"type": "subtitle", "time": 2229.75, "timestamp": "00:37:09", "text": "プロンプト？ちょっと行かなきゃいけないんだけど、すぐ戻るよ。"}, {"type": "subtitle", "time": 2231.71, "timestamp": "00:37:11", "text": "こんにちは。気をつけて。取る"}, {"type": "subtitle", "time": 2250.39, "timestamp": "00:37:30", "text": "B2レベルのクレメンタインは真ん中に位置します。"}, {"type": "subtitle", "time": 2255.069, "timestamp": "00:37:35", "text": "記号は4つあります。その看板。"}, {"type": "subtitle", "time": 2260.349, "timestamp": "00:37:40", "text": "[音楽]"}, {"type": "subtitle", "time": 2263.43, "timestamp": "00:37:43", "text": "植物。わかった。 １、２、３、４。"}, {"type": "subtitle", "time": 2266.15, "timestamp": "00:37:46", "text": "4つ目は溶岩ランプです。 3つ目は"}, {"type": "subtitle", "time": 2269.43, "timestamp": "00:37:49", "text": "テーブルスタンドのようなもの。テーブルの上の何か"}, {"type": "subtitle", "time": 2272.23, "timestamp": "00:37:52", "text": "あるいは、脚に関する何か。 2は"}, {"type": "subtitle", "time": 2275.31, "timestamp": "00:37:55", "text": "豪華なティーポット"}, {"type": "subtitle", "time": 2278.91, "timestamp": "00:37:58", "text": "あれ。 1つは、玉ねぎの上に"}]
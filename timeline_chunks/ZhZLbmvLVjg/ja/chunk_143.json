[{"type": "subtitle", "time": 8580.15, "timestamp": "02:23:00", "text": "サーバー内の誰でも。"}, {"type": "subtitle", "time": 8584.95, "timestamp": "02:23:04", "text": "これは質量を取り除くためのものです"}, {"type": "subtitle", "time": 8587.59, "timestamp": "02:23:07", "text": "pingとかそういうの。大量ピングを避ける"}, {"type": "subtitle", "time": 8589.23, "timestamp": "02:23:09", "text": "そして"}, {"type": "subtitle", "time": 8592.15, "timestamp": "02:23:12", "text": "スタースケープでやりたかったから、いろいろやってみた"}, {"type": "subtitle", "time": 8594.23, "timestamp": "02:23:14", "text": "長い間探していたが、"}, {"type": "subtitle", "time": 8595.67, "timestamp": "02:23:15", "text": "もっと良い方法がある。それで、私はテストしていました"}, {"type": "subtitle", "time": 8598.99, "timestamp": "02:23:18", "text": "私のサーバーにあります。それは"}, {"type": "subtitle", "time": 8601.67, "timestamp": "02:23:21", "text": "魅力。よし、これでいい。私たちには2つの思い出がある。"}, {"type": "subtitle", "time": 8604.19, "timestamp": "02:23:24", "text": "この場所を完成させる必要がある"}, {"type": "subtitle", "time": 8608.309, "timestamp": "02:23:28", "text": "外。ええ、読んでいません。"}, {"type": "subtitle", "time": 8616.71, "timestamp": "02:23:36", "text": "また？その物質はあらゆる場所で生育する"}, {"type": "subtitle", "time": 8618.469, "timestamp": "02:23:38", "text": "Zは何でできているのですか？それ"}, {"type": "subtitle", "time": 8628.51, "timestamp": "02:23:48", "text": "わかった。よし。さあ行こう"}, {"type": "subtitle", "time": 8631.23, "timestamp": "02:23:51", "text": "家。外に出よう"}, {"type": "subtitle", "time": 8634.389, "timestamp": "02:23:54", "text": "ここ。ええ、そうですね。いつか、"}, {"type": "subtitle", "time": 8637.15, "timestamp": "02:23:57", "text": "そうですね、もし私ができるなら"}]
[{"type": "subtitle", "time": 18790.948, "timestamp": "05:13:10", "text": "[音楽]"}, {"type": "subtitle", "time": 18794.67, "timestamp": "05:13:14", "text": "お誕生日おめでとう"}, {"type": "subtitle", "time": 18799.31, "timestamp": "05:13:19", "text": "あなた。お誕生日おめでとう"}, {"type": "subtitle", "time": 18803.81, "timestamp": "05:13:23", "text": "あなた。ハシ、誕生日おめでとう。"}, {"type": "subtitle", "time": 18812.19, "timestamp": "05:13:32", "text": "クロノ、誕生日おめでとう"}, {"type": "subtitle", "time": 18817.55, "timestamp": "05:13:37", "text": "あなた。神のご加護がありますように"}, {"type": "subtitle", "time": 18823.43, "timestamp": "05:13:43", "text": "あなた。星の光があなたを導きますように。"}, {"type": "subtitle", "time": 18827.39, "timestamp": "05:13:47", "text": "そして星々は"}, {"type": "subtitle", "time": 18838.59, "timestamp": "05:13:58", "text": "少し。ハッピー"}]
[{"type": "subtitle", "time": 10800.95, "timestamp": "03:00:00", "text": "私は「フラッフ」が何なのかを知りました。何が"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "ごめんなさい。忘れた。説明します。"}, {"type": "subtitle", "time": 10808.349, "timestamp": "03:00:08", "text": "私は試合に出場します。待って、"}, {"type": "subtitle", "time": 10810.79, "timestamp": "03:00:10", "text": "何？忘れたってどういう意味ですか"}, {"type": "subtitle", "time": 10817.07, "timestamp": "03:00:17", "text": "キャラクターシート。私たちは助ける必要がある"}, {"type": "subtitle", "time": 10820.59, "timestamp": "03:00:20", "text": "彼。文字はどこにありますか"}, {"type": "subtitle", "time": 10823.87, "timestamp": "03:00:23", "text": "そのシート"}, {"type": "subtitle", "time": 10832.349, "timestamp": "03:00:32", "text": "得意げな得意げなはバン"}, {"type": "subtitle", "time": 10847.83, "timestamp": "03:00:47", "text": "バン。なぜこの怪しい電線は"}, {"type": "subtitle", "time": 10850.03, "timestamp": "03:00:50", "text": "行き詰まった"}, {"type": "subtitle", "time": 10852.79, "timestamp": "03:00:52", "text": "そこには？これは接続されているはずです"}]
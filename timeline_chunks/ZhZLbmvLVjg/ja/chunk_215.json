[{"type": "subtitle", "time": 12916.51, "timestamp": "03:35:16", "text": "秋。ああ、開いているよ"}, {"type": "subtitle", "time": 12918.51, "timestamp": "03:35:18", "text": "今。"}, {"type": "subtitle", "time": 12921.349, "timestamp": "03:35:21", "text": "ああ、そうそう。私たちは最初の"}, {"type": "subtitle", "time": 12923.63, "timestamp": "03:35:23", "text": "メモリ"}, {"type": "subtitle", "time": 12927.83, "timestamp": "03:35:27", "text": "スロット。今度はそのうちの2人を見つけ出す必要がある。"}, {"type": "subtitle", "time": 12930.55, "timestamp": "03:35:30", "text": "都会での生活は厳しいものになった。センター"}, {"type": "subtitle", "time": 12931.91, "timestamp": "03:35:31", "text": "家が作られました"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "強力だ。彼らは都市を守る力を持っている"}, {"type": "subtitle", "time": 12941.429, "timestamp": "03:35:41", "text": "時代を超越した。よし、あと2人必要だ。二"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "残りはまだです。私たちは彼らを見つけ出すでしょう。良い"}, {"type": "subtitle", "time": 12954.07, "timestamp": "03:35:54", "text": "外。私は場所を取得できませんでした"}]
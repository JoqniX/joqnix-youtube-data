[{"type": "subtitle", "time": 3121.109, "timestamp": "00:52:01", "text": "この世界には人間は存在しない"}, {"type": "subtitle", "time": 3124.069, "timestamp": "00:52:04", "text": "地下の場所。私たちは上に行く必要があります"}, {"type": "subtitle", "time": 3133.549, "timestamp": "00:52:13", "text": "人間。待って、これ"}, {"type": "subtitle", "time": 3136.51, "timestamp": "00:52:16", "text": "高い。このくらいの高さ。"}, {"type": "subtitle", "time": 3141.9, "timestamp": "00:52:21", "text": "私のビタミンB12。ビタミンB12はどこにあるの？ああ、ビタミンB12はどこ？"}, {"type": "subtitle", "time": 3151.91, "timestamp": "00:52:31", "text": "待って、ビタミンB12はどこ？彼らはB12を除去した"}, {"type": "subtitle", "time": 3152.75, "timestamp": "00:52:32", "text": "から"}, {"type": "subtitle", "time": 3162.71, "timestamp": "00:52:42", "text": "バカ、人間を手に入れるには、"}, {"type": "subtitle", "time": 3165.99, "timestamp": "00:52:45", "text": "ええと、地上に出る必要があります。私たちは"}, {"type": "subtitle", "time": 3169.349, "timestamp": "00:52:49", "text": "現在、何て言うんだっけ？"}, {"type": "subtitle", "time": 3172.63, "timestamp": "00:52:52", "text": "地下の場所ですよね？"}, {"type": "subtitle", "time": 3175.03, "timestamp": "00:52:55", "text": "アニメの権利があり、"}, {"type": "subtitle", "time": 3176.109, "timestamp": "00:52:56", "text": "同じ"}]
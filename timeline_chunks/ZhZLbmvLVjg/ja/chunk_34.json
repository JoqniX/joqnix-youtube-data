[{"type": "subtitle", "time": 2040.63, "timestamp": "00:34:00", "text": "待って、私はIの鍵を作っていません"}, {"type": "subtitle", "time": 2042.389, "timestamp": "00:34:02", "text": "その男のために鍵を作らなかった"}, {"type": "subtitle", "time": 2044.269, "timestamp": "00:34:04", "text": "人が倒れている"}, {"type": "subtitle", "time": 2048.19, "timestamp": "00:34:08", "text": "そこには。ああ、私はやっていません。私"}, {"type": "subtitle", "time": 2052.47, "timestamp": "00:34:12", "text": "見逃した。見逃した。待って、戻ってもいいですか？"}, {"type": "subtitle", "time": 2055.55, "timestamp": "00:34:15", "text": "そして、それを実行するのか？ああ、私は"}, {"type": "subtitle", "time": 2058.71, "timestamp": "00:34:18", "text": "忘れた。見逃してしまいました。持続する。私はします"}, {"type": "subtitle", "time": 2068.19, "timestamp": "00:34:28", "text": "それを教えてくれてありがとう。感謝"}, {"type": "subtitle", "time": 2072.27, "timestamp": "00:34:32", "text": "あなた。ぼかし効果のことですよね？私は必要としている"}, {"type": "subtitle", "time": 2076.43, "timestamp": "00:34:36", "text": "それを行うようコマンドを与える"}, {"type": "subtitle", "time": 2088.03, "timestamp": "00:34:48", "text": "翻訳する？ああ、私たちは戻ってきた"}, {"type": "subtitle", "time": 2090.19, "timestamp": "00:34:50", "text": "ここ。"}, {"type": "subtitle", "time": 2094.909, "timestamp": "00:34:54", "text": "ああ、行きたければそこへ行ってもいいですよ。"}, {"type": "subtitle", "time": 2097.39, "timestamp": "00:34:57", "text": "おお、"}]
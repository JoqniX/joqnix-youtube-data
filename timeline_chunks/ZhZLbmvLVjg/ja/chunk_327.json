[{"type": "subtitle", "time": 19621.99, "timestamp": "05:27:01", "text": "では、こうすればいいのですか？私は自分の"}, {"type": "subtitle", "time": 19630.59, "timestamp": "05:27:10", "text": "あれ。こうやってみよう"}, {"type": "subtitle", "time": 19633.59, "timestamp": "05:27:13", "text": "これ。全て"}, {"type": "subtitle", "time": 19641.788, "timestamp": "05:27:21", "text": "[音楽]"}, {"type": "subtitle", "time": 19644.548, "timestamp": "05:27:24", "text": "音楽。ちょっとうるさいですね。修正しました"}, {"type": "subtitle", "time": 19645.708, "timestamp": "05:27:25", "text": "あなた"}, {"type": "subtitle", "time": 19647.23, "timestamp": "05:27:27", "text": "みんな。"}, {"type": "subtitle", "time": 19649.39, "timestamp": "05:27:29", "text": "でも楽しんで"}, {"type": "subtitle", "time": 19652.35, "timestamp": "05:27:32", "text": "の"}, {"type": "subtitle", "time": 19656.39, "timestamp": "05:27:36", "text": "不気味さと共に痛みを感じる。私は、えーと"}, {"type": "subtitle", "time": 19660.19, "timestamp": "05:27:40", "text": "読む。こんにちは。どうですか？何かが外にある"}, {"type": "subtitle", "time": 19664.27, "timestamp": "05:27:44", "text": "そこには。暗い道は暗い道へと続く"}, {"type": "subtitle", "time": 19667.27, "timestamp": "05:27:47", "text": "場所。次のような言葉が"}, {"type": "subtitle", "time": 19670.548, "timestamp": "05:27:50", "text": "ジェイク・ハッティスの心を通して"}, {"type": "subtitle", "time": 19673.07, "timestamp": "05:27:53", "text": "孤独な国に到着"}, {"type": "subtitle", "time": 19676.39, "timestamp": "05:27:56", "text": "道。彼は暗い場所から来た、"}, {"type": "subtitle", "time": 19678.03, "timestamp": "05:27:58", "text": "場所ではなかった"}]
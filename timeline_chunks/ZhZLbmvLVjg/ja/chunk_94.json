[{"type": "subtitle", "time": 5645.95, "timestamp": "01:34:05", "text": "死ぬ。ということで、ゲームは終了しました。"}, {"type": "subtitle", "time": 5649.59, "timestamp": "01:34:09", "text": "もっと。私はこれを後ろで走らせました。えっと"}, {"type": "subtitle", "time": 5652.149, "timestamp": "01:34:12", "text": "私はこれを放置した。私はすべてを読みたい"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "人々の名前。人の名前を読まない"}, {"type": "subtitle", "time": 5656.189, "timestamp": "01:34:16", "text": "しかし"}, {"type": "subtitle", "time": 5660.55, "timestamp": "01:34:20", "text": "もっと見る。それで、どうでしたか？"}, {"type": "subtitle", "time": 5663.669, "timestamp": "01:34:23", "text": "けれど？野良猫は気に入りましたか？ゲーム"}, {"type": "subtitle", "time": 5667.03, "timestamp": "01:34:27", "text": "迷子？正直に言うと、私は"}, {"type": "subtitle", "time": 5671.75, "timestamp": "01:34:31", "text": "たくさんあります。とても気に入りました。待って、"}, {"type": "subtitle", "time": 5673.75, "timestamp": "01:34:33", "text": "この中にはインド人の名前がたくさんある"}, {"type": "subtitle", "time": 5675.31, "timestamp": "01:34:35", "text": "クレジット。"}, {"type": "subtitle", "time": 5678.43, "timestamp": "01:34:38", "text": "何？何？インド人がたくさんいます"}, {"type": "subtitle", "time": 5681.229, "timestamp": "01:34:41", "text": "名前。おお。"}, {"type": "subtitle", "time": 5683.709, "timestamp": "01:34:43", "text": "見る"}, {"type": "subtitle", "time": 5686.35, "timestamp": "01:34:46", "text": "カワイイはどこにでもいる。プレイテスト"}, {"type": "subtitle", "time": 5688.629, "timestamp": "01:34:48", "text": "ティス。ああ、彼らは"}, {"type": "subtitle", "time": 5692.43, "timestamp": "01:34:52", "text": "プレイテスターの名前も。くそ。"}, {"type": "subtitle", "time": 5698.99, "timestamp": "01:34:58", "text": "知る。ええ、私はこれが本当に好きなんです"}]
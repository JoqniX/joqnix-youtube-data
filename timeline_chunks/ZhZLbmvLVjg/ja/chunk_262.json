[{"type": "subtitle", "time": 15736.03, "timestamp": "04:22:16", "text": "スイング。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 15738.71, "timestamp": "04:22:18", "text": "良い。ハロウィンはどうでしたか？あなたはそうしました"}, {"type": "subtitle", "time": 15740.87, "timestamp": "04:22:20", "text": "ハロウィンの写真を見せてください。あなたはそうしました"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "ハロウィンのカボチャみたいなものを見せる"}, {"type": "subtitle", "time": 15747.189, "timestamp": "04:22:27", "text": "そして、それを作ったのはあなたです。とてもかわいい。それはとても"}, {"type": "subtitle", "time": 15748.349, "timestamp": "04:22:28", "text": "かわいい。"}, {"type": "subtitle", "time": 15751.349, "timestamp": "04:22:31", "text": "陸上でのパンプキンジャックの様子はどうですか？それはそれは"}, {"type": "subtitle", "time": 15753.429, "timestamp": "04:22:33", "text": "本当に良いです。本当に良いです。感謝"}, {"type": "subtitle", "time": 15755.79, "timestamp": "04:22:35", "text": "共有してくれてありがとう"}, {"type": "subtitle", "time": 15759.11, "timestamp": "04:22:39", "text": "写真。去年、もし私が"}, {"type": "subtitle", "time": 15761.67, "timestamp": "04:22:41", "text": "ハロウィンは"}, {"type": "subtitle", "time": 15764.51, "timestamp": "04:22:44", "text": "あなたの好きな"}, {"type": "subtitle", "time": 15767.59, "timestamp": "04:22:47", "text": "お祭りやお祝い事など、そしてあなたも"}]
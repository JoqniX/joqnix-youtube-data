[{"type": "subtitle", "time": 4147.189, "timestamp": "01:09:07", "text": "それ。とても簡単です。何てことだ。さあ"}, {"type": "subtitle", "time": 4154.269, "timestamp": "01:09:14", "text": "わかった。"}, {"type": "subtitle", "time": 4170.309, "timestamp": "01:09:30", "text": "好奇心旺盛？じゃあ、私たちは"}, {"type": "subtitle", "time": 4173.789, "timestamp": "01:09:33", "text": "電力が復旧した。はい。取っていく"}, {"type": "subtitle", "time": 4177.07, "timestamp": "01:09:37", "text": "力。取っていく"}, {"type": "subtitle", "time": 4179.229, "timestamp": "01:09:39", "text": "力。"}, {"type": "subtitle", "time": 4181.63, "timestamp": "01:09:41", "text": "はい。ああ、彼は閉めた"}, {"type": "subtitle", "time": 4185.59, "timestamp": "01:09:45", "text": "それ。 M. なぜ閉鎖したのですか？君は"}, {"type": "subtitle", "time": 4187.749, "timestamp": "01:09:47", "text": "他の人が入れるようにして、"}]
[{"type": "subtitle", "time": 3960.63, "timestamp": "01:06:00", "text": "心配。こんにちは。では、彼に会いに行く前に、"}, {"type": "subtitle", "time": 3972.75, "timestamp": "01:06:12", "text": "わかった、"}, {"type": "subtitle", "time": 4003.99, "timestamp": "01:06:43", "text": "あまりにも。床に倒れている男が見えますか？彼"}, {"type": "subtitle", "time": 4005.67, "timestamp": "01:06:45", "text": "再起動が必要です。私は失いたくない"}, {"type": "subtitle", "time": 4008.029, "timestamp": "01:06:48", "text": "手。私は"}, {"type": "subtitle", "time": 4015.95, "timestamp": "01:06:55", "text": "[音楽]"}]
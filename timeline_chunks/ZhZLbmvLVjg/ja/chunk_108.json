[{"type": "subtitle", "time": 6480.149, "timestamp": "01:48:00", "text": "行動も健全な"}, {"type": "subtitle", "time": 6482.109, "timestamp": "01:48:02", "text": "タッチして"}, {"type": "subtitle", "time": 6485.59, "timestamp": "01:48:05", "text": "男らしい男とは違って、"}, {"type": "subtitle", "time": 6496.43, "timestamp": "01:48:16", "text": "エクセンブル・シュノ、究極のソフト"}, {"type": "subtitle", "time": 6499.189, "timestamp": "01:48:19", "text": "男の子、あなたが今まで見た中で最も優しい男の子"}, {"type": "subtitle", "time": 6506.229, "timestamp": "01:48:26", "text": "ビュッフェだが完璧ではないが"}, {"type": "subtitle", "time": 6512.629, "timestamp": "01:48:32", "text": "パフェット。えっと、まずは"}, {"type": "subtitle", "time": 6519.709, "timestamp": "01:48:39", "text": "変化。いいえ。でも"}, {"type": "subtitle", "time": 6523.109, "timestamp": "01:48:43", "text": "ええ、ただの物静かな話し方だけじゃないんです"}, {"type": "subtitle", "time": 6527.99, "timestamp": "01:48:47", "text": "えっと、柔らかい性格ですね。"}, {"type": "subtitle", "time": 6531.109, "timestamp": "01:48:51", "text": "彼らには似たような種類もいる。彼らです"}, {"type": "subtitle", "time": 6534.35, "timestamp": "01:48:54", "text": "通常のうーんよりも親切"}, {"type": "subtitle", "time": 6537.79, "timestamp": "01:48:57", "text": "男。もっと親切で、もっと"}]
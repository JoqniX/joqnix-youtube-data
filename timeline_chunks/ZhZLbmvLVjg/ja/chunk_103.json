[{"type": "subtitle", "time": 6200.35, "timestamp": "01:43:20", "text": "ああ、スカイが優しい男の子なら、息を吸って。停車駅"}, {"type": "subtitle", "time": 6204.91, "timestamp": "01:43:24", "text": "呼吸。カイがいつも"}, {"type": "subtitle", "time": 6208.629, "timestamp": "01:43:28", "text": "うーん、軟弱者と呼ばれることを拒否する。私"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "わからない。彼は軟弱なように聞こえる"}, {"type": "subtitle", "time": 6212.43, "timestamp": "01:43:32", "text": "男の子"}, {"type": "subtitle", "time": 6216.43, "timestamp": "01:43:36", "text": "けれど。彼はあの優しい男の子を手に入れた"}, {"type": "subtitle", "time": 6226.149, "timestamp": "01:43:46", "text": "彼は死なない。死ぬな。死ぬな。"}, {"type": "subtitle", "time": 6227.75, "timestamp": "01:43:47", "text": "死ぬな。死ぬな。死ぬな。しないで"}, {"type": "subtitle", "time": 6229.59, "timestamp": "01:43:49", "text": "死ぬ。死ぬな。死なないで。しないで"}]
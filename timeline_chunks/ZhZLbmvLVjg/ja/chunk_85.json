[{"type": "subtitle", "time": 5103.87, "timestamp": "01:25:03", "text": "そこには。何が"}, {"type": "subtitle", "time": 5106.27, "timestamp": "01:25:06", "text": "それ？屋根"}, {"type": "subtitle", "time": 5113.35, "timestamp": "01:25:13", "text": "そこに閉じ込められた。それはワークステーションです"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "開ける。しかし、セキュリティ対策は講じられている。"}, {"type": "subtitle", "time": 5119.91, "timestamp": "01:25:19", "text": "ああ、メインシステムをハッキングして、"}, {"type": "subtitle", "time": 5141.49, "timestamp": "01:25:41", "text": "ロック済み"}, {"type": "subtitle", "time": 5149.31, "timestamp": "01:25:49", "text": "ここ。わかった。我々は破壊する"}, {"type": "subtitle", "time": 5156.51, "timestamp": "01:25:56", "text": "1つでハッキングできます"}, {"type": "subtitle", "time": 5159.47, "timestamp": "01:25:59", "text": "それ。その通りです。あなたはハッキングしました"}]
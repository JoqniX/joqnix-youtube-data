[{"type": "subtitle", "time": 1622.35, "timestamp": "00:27:02", "text": "神。何の話をしていたんだっけ？"}, {"type": "subtitle", "time": 1625.59, "timestamp": "00:27:05", "text": "また？ああ、彼の鍵が落ちてるよ。"}, {"type": "subtitle", "time": 1628.789, "timestamp": "00:27:08", "text": "どこ？また？下ですよね？下。下。"}, {"type": "subtitle", "time": 1634.71, "timestamp": "00:27:14", "text": "けれど？持続する。あなたの質問にお答えします"}, {"type": "subtitle", "time": 1637.47, "timestamp": "00:27:17", "text": "1分後に。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 1641.149, "timestamp": "00:27:21", "text": "こんにちは。待って。ごめん。私はタイプします"}, {"type": "subtitle", "time": 1645.07, "timestamp": "00:27:25", "text": "間違っている。ああ、始まったよ。それは"}, {"type": "subtitle", "time": 1647.75, "timestamp": "00:27:27", "text": "右。右側にあります。何が放送されているか"}, {"type": "subtitle", "time": 1649.23, "timestamp": "00:27:29", "text": "正しい？"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "ミッチ。ナニ。ナニ。なんてこった。私はトリガーしました"}, {"type": "subtitle", "time": 1665.19, "timestamp": "00:27:45", "text": "ここ。来て。出て行け。出て行け。得る"}, {"type": "subtitle", "time": 1667.75, "timestamp": "00:27:47", "text": "外。ここに来て。ここに来て。ここに来て。または"}, {"type": "subtitle", "time": 1668.99, "timestamp": "00:27:48", "text": "行ってもいいですよ"}, {"type": "subtitle", "time": 1671.59, "timestamp": "00:27:51", "text": "離れて。時が来たんだよ、坊や。そうそう。うん。"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "うん。ああ、私が言いたかったのは現地時間のことです。えっと、"}, {"type": "subtitle", "time": 1679.59, "timestamp": "00:27:59", "text": "いや、いや、いや。チャット機能におけるユーザーの利用時間。"}]
[{"type": "subtitle", "time": 12782.51, "timestamp": "03:33:02", "text": "名前を声に出して言ってください。 A"}, {"type": "subtitle", "time": 12784.03, "timestamp": "03:33:04", "text": "[音楽]"}, {"type": "subtitle", "time": 12787.18, "timestamp": "03:33:07", "text": "かわいい。すごく可愛いですね。"}, {"type": "subtitle", "time": 12801.99, "timestamp": "03:33:21", "text": "[音楽]"}, {"type": "subtitle", "time": 12807.11, "timestamp": "03:33:27", "text": "ああ、大変だ。ああ、それはとてもかわいいですね。何てことだ。"}, {"type": "subtitle", "time": 12809.469, "timestamp": "03:33:29", "text": "何てことだ。おお"}, {"type": "subtitle", "time": 12819.19, "timestamp": "03:33:39", "text": "そして、もしあなたがジョッカについて疑問に思っているなら、私は"}, {"type": "subtitle", "time": 12822.59, "timestamp": "03:33:42", "text": "あなたが言わないことに気付きました"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "なぜ？ああ、それは私がチャンを呼ぶから"}, {"type": "subtitle", "time": 12833.07, "timestamp": "03:33:53", "text": "男性と仲間のために"}]
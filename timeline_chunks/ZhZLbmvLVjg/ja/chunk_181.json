[{"type": "subtitle", "time": 10871.63, "timestamp": "03:01:11", "text": "[音楽]"}, {"type": "subtitle", "time": 10878.63, "timestamp": "03:01:18", "text": "ああ、なるほど。非社交的な人を見る"}, {"type": "subtitle", "time": 10889.349, "timestamp": "03:01:29", "text": "あなた。どこですか？えっと、私は見つける必要がある"}, {"type": "subtitle", "time": 10891.51, "timestamp": "03:01:31", "text": "キャラクターシートを渡して"}, {"type": "subtitle", "time": 10893.429, "timestamp": "03:01:33", "text": "あそこにいる子供は叱られている"}, {"type": "subtitle", "time": 10897.83, "timestamp": "03:01:37", "text": "彼の先生か母親。それなら私が手伝う必要がある"}, {"type": "subtitle", "time": 10900.59, "timestamp": "03:01:40", "text": "えっと、他に誰がいましたっけ？私"}, {"type": "subtitle", "time": 10903.67, "timestamp": "03:01:43", "text": "忘れた。彼はここで酔っ払っている。私たちはする必要があります"}, {"type": "subtitle", "time": 10917.67, "timestamp": "03:01:57", "text": "上。はい。ああ、君は読みすぎだよ"}, {"type": "subtitle", "time": 10919.309, "timestamp": "03:01:59", "text": "それ"}]
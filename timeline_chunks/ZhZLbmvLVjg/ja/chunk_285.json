[{"type": "subtitle", "time": 17101.67, "timestamp": "04:45:01", "text": "えっと、何ヴィック待って、あ、彼は終わった"}, {"type": "subtitle", "time": 17108.31, "timestamp": "04:45:08", "text": "えっと、彼は何をしたの？ああ、いや、私は違う"}, {"type": "subtitle", "time": 17111.27, "timestamp": "04:45:11", "text": "この不気味なゲームを見ても、閉じることはできない"}, {"type": "subtitle", "time": 17113.35, "timestamp": "04:45:13", "text": "ステップ。いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 17122.708, "timestamp": "04:45:22", "text": "それ。ねえ、ミランは、そう、ミランは"}, {"type": "subtitle", "time": 17125.07, "timestamp": "04:45:25", "text": "インド人ユーチューバー。"}, {"type": "subtitle", "time": 17129.99, "timestamp": "04:45:29", "text": "はい、私はすべての長らく行方不明だった"}, {"type": "subtitle", "time": 17133.31, "timestamp": "04:45:33", "text": "YouTuberたち、そして私は「はい、ありがとうございます」って感じ"}, {"type": "subtitle", "time": 17137.27, "timestamp": "04:45:37", "text": "メモリ。ありがとう、懐かしさ、懐かしさ"}, {"type": "subtitle", "time": 17139.91, "timestamp": "04:45:39", "text": "私の脳とか何とか。私は知らない"}, {"type": "subtitle", "time": 17144.708, "timestamp": "04:45:44", "text": "言葉の種類。えっと、だってこれ"}, {"type": "subtitle", "time": 17149.59, "timestamp": "04:45:49", "text": "2020年、2021年、2023年、2022年、2023年のような4年間"}, {"type": "subtitle", "time": 17151.91, "timestamp": "04:45:51", "text": "暇な時はいつでも"}, {"type": "subtitle", "time": 17154.948, "timestamp": "04:45:54", "text": "ヘッドハウスのヘッドハンティングスカウトに使用"}, {"type": "subtitle", "time": 17157.35, "timestamp": "04:45:57", "text": "YouTuberたちはそれを見て、ああ、何か"}, {"type": "subtitle", "time": 17159.628, "timestamp": "04:45:59", "text": "新しいYouTuberでもそうでなくても、"}]
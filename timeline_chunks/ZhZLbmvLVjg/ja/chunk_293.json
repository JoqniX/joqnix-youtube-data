[{"type": "subtitle", "time": 17585.19, "timestamp": "04:53:05", "text": "えっと、このウェブカメラの位置は"}, {"type": "subtitle", "time": 17587.27, "timestamp": "04:53:07", "text": "ウェブカメラの位置が本当に悪い"}, {"type": "subtitle", "time": 17589.31, "timestamp": "04:53:09", "text": "あるいは、そんな感じ。わからない"}, {"type": "subtitle", "time": 17592.67, "timestamp": "04:53:12", "text": "なぜ。ええ、私は自分の戦闘プラットフォームを選びます。"}, {"type": "subtitle", "time": 17596.67, "timestamp": "04:53:16", "text": "はい。良い。良い"}, {"type": "subtitle", "time": 17600.07, "timestamp": "04:53:20", "text": "仕事。正直に言うと、私は"}, {"type": "subtitle", "time": 17602.15, "timestamp": "04:53:22", "text": "ゲームをプレイするが、"}, {"type": "subtitle", "time": 17604.948, "timestamp": "04:53:24", "text": "ただ雑談しているだけです。大丈夫だといいのですが。今、"}, {"type": "subtitle", "time": 17607.35, "timestamp": "04:53:27", "text": "でも、心配しないでください。試験後"}, {"type": "subtitle", "time": 17610.47, "timestamp": "04:53:30", "text": "12月になったら、もっと自由になれると思う。私は私は"}, {"type": "subtitle", "time": 17612.948, "timestamp": "04:53:32", "text": "ほとんどのストリームと同じように、"}, {"type": "subtitle", "time": 17615.11, "timestamp": "04:53:35", "text": "すべて。正直言って分かりません"}, {"type": "subtitle", "time": 17618.39, "timestamp": "04:53:38", "text": "物事がどのように進むか。あなたは私を知っている。たとえ"}, {"type": "subtitle", "time": 17620.35, "timestamp": "04:53:40", "text": "試験だから、私は"}, {"type": "subtitle", "time": 17622.708, "timestamp": "04:53:42", "text": "勉強。たとえそれが重要であっても"}, {"type": "subtitle", "time": 17627.47, "timestamp": "04:53:47", "text": "試験があるのに、私は勉強しない。私はただ自分のことに集中する"}, {"type": "subtitle", "time": 17633.03, "timestamp": "04:53:53", "text": "優先順位。痛み。それは痛みだ。"}]
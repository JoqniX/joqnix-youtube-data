[{"type": "subtitle", "time": 5763.189, "timestamp": "01:36:03", "text": "全員が無事で生きていた。しかし"}, {"type": "subtitle", "time": 5766.43, "timestamp": "01:36:06", "text": "アサリ、いや、アサリではない。"}, {"type": "subtitle", "time": 5768.59, "timestamp": "01:36:08", "text": "B12。それは確かに"}, {"type": "subtitle", "time": 5773.229, "timestamp": "01:36:13", "text": "痛み。でもデュオ、私はゲームを楽しんでいるので"}, {"type": "subtitle", "time": 5776.03, "timestamp": "01:36:16", "text": "多くの。それは楽しい"}, {"type": "subtitle", "time": 5780.03, "timestamp": "01:36:20", "text": "旅。ゲームを開始できますか？"}, {"type": "subtitle", "time": 5783.07, "timestamp": "01:36:23", "text": "また？ 21アウト"}, {"type": "subtitle", "time": 5786.31, "timestamp": "01:36:26", "text": "ああ、待って。"}, {"type": "subtitle", "time": 5789.75, "timestamp": "01:36:29", "text": "ああ、記憶力があるんだ。そうそう。私は必要だった"}, {"type": "subtitle", "time": 5791.55, "timestamp": "01:36:31", "text": "すべて集める"}, {"type": "subtitle", "time": 5800.07, "timestamp": "01:36:40", "text": "5、6、7は集めませんでした。"}, {"type": "subtitle", "time": 5802.75, "timestamp": "01:36:42", "text": "3つの思い出"}, {"type": "subtitle", "time": 5806.03, "timestamp": "01:36:46", "text": "Maと記憶ゼロ"}, {"type": "subtitle", "time": 5809.83, "timestamp": "01:36:49", "text": "下水道。行き止まり。私たちはそれを集めました。これ"}, {"type": "subtitle", "time": 5812.35, "timestamp": "01:36:52", "text": "屋根には、"}, {"type": "subtitle", "time": 5815.43, "timestamp": "01:36:55", "text": "信じる。うん。"}, {"type": "subtitle", "time": 5818.87, "timestamp": "01:36:58", "text": "皆さんは私がこれを100%クリアすることを望んでいますか？私たちは"}]
[{"type": "subtitle", "time": 1082.99, "timestamp": "00:18:02", "text": "ヘヘヘはスラムアタックを仕掛けた。"}, {"type": "subtitle", "time": 1086.86, "timestamp": "00:18:06", "text": "ああ、早めの朝食だ。"}, {"type": "subtitle", "time": 1089.789, "timestamp": "00:18:09", "text": "[音楽]"}, {"type": "subtitle", "time": 1092.99, "timestamp": "00:18:12", "text": "こんにちは。私はすでに朝食を済ませました"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "7時00分。私はその場所から戻ってきました"}, {"type": "subtitle", "time": 1100.87, "timestamp": "00:18:20", "text": "そして私たちはそこから食べ始めた。うん。始める"}, {"type": "subtitle", "time": 1109.43, "timestamp": "00:18:29", "text": "続く。待って。章を選択できます"}, {"type": "subtitle", "time": 1112.15, "timestamp": "00:18:32", "text": "そのセーブファイルから。もし私が戻ったらどうなるだろう"}, {"type": "subtitle", "time": 1119.82, "timestamp": "00:18:39", "text": "見逃しましたか？私はできる"}, {"type": "subtitle", "time": 1122.029, "timestamp": "00:18:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1128.39, "timestamp": "00:18:48", "text": "見る。彼はまるで話しているようだ。彼は実際に"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "彼。生粋の内向型人間。外向的"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "実は。"}]
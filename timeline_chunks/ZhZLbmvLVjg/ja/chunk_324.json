[{"type": "subtitle", "time": 19442.39, "timestamp": "05:24:02", "text": "ホラー。まとめ。男は自分の"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "過去にガソリンスタンドに到着した"}, {"type": "subtitle", "time": 19448.948, "timestamp": "05:24:08", "text": "真夜中の田舎道。"}, {"type": "subtitle", "time": 19451.59, "timestamp": "05:24:11", "text": "彼は自分が何を持ってきたのか分かっていない。"}, {"type": "subtitle", "time": 19455.27, "timestamp": "05:24:15", "text": "彼と何かがあって、普通は止まる"}, {"type": "subtitle", "time": 19457.03, "timestamp": "05:24:17", "text": "ガソリンスタンドの真ん中で"}, {"type": "subtitle", "time": 19459.75, "timestamp": "05:24:19", "text": "夜は戦いへと変わる"}, {"type": "subtitle", "time": 19461.788, "timestamp": "05:24:21", "text": "数人の生存"}, {"type": "subtitle", "time": 19466.47, "timestamp": "05:24:26", "text": "人々。ジェイクが終わるまで何も終わらない"}, {"type": "subtitle", "time": 19468.55, "timestamp": "05:24:28", "text": "彼は過去と向き合い、"}, {"type": "subtitle", "time": 19470.47, "timestamp": "05:24:30", "text": "やった。"}, {"type": "subtitle", "time": 19474.27, "timestamp": "05:24:34", "text": "その後、ついに暗闇が"}, {"type": "subtitle", "time": 19478.39, "timestamp": "05:24:38", "text": "彼らを放っておいてあげて。はい、18歳以上です"}, {"type": "subtitle", "time": 19493.51, "timestamp": "05:24:53", "text": "場所。これらは、"}, {"type": "subtitle", "time": 19495.83, "timestamp": "05:24:55", "text": "ジェイクの待って、向きを変える必要があるの？"}, {"type": "subtitle", "time": 19497.91, "timestamp": "05:24:57", "text": "バックグラウンドミュージックをオフにする？あなたは私に"}]
[{"type": "subtitle", "time": 18180.31, "timestamp": "05:03:00", "text": "残りの金は使ってください。ええ、私は"}, {"type": "subtitle", "time": 18183.39, "timestamp": "05:03:03", "text": "私はそれを入手するために使用しました"}, {"type": "subtitle", "time": 18186.628, "timestamp": "05:03:06", "text": "うん、そうだね。鉄道への再投資"}, {"type": "subtitle", "time": 18188.948, "timestamp": "05:03:08", "text": "software.io のような恥ずべき存在になり得る。する必要がある"}, {"type": "subtitle", "time": 18191.43, "timestamp": "05:03:11", "text": "次にノイズ分離プラグインを購入してください"}, {"type": "subtitle", "time": 18195.11, "timestamp": "05:03:15", "text": "月。公式リリースが遅れた"}, {"type": "subtitle", "time": 18196.83, "timestamp": "05:03:16", "text": "一部の人にとって"}, {"type": "subtitle", "time": 18200.708, "timestamp": "05:03:20", "text": "理由。でも、それは早く発売されるよ。"}, {"type": "subtitle", "time": 18203.11, "timestamp": "05:03:23", "text": "11月だと言っていた。だから、私は探している"}, {"type": "subtitle", "time": 18205.11, "timestamp": "05:03:25", "text": "楽しみにしています。今のところ、私はまだ"}, {"type": "subtitle", "time": 18210.948, "timestamp": "05:03:30", "text": "私のRNノイズを使用しています。ペインコ アロ アン"}, {"type": "subtitle", "time": 18212.99, "timestamp": "05:03:32", "text": "アロンノイズ"}, {"type": "subtitle", "time": 18215.67, "timestamp": "05:03:35", "text": "私はまだそれを使っていますか？あ、待って。いいえ、"}, {"type": "subtitle", "time": 18218.47, "timestamp": "05:03:38", "text": "私はそれを使っていません。待って、ゴヨがアクティブです。"}, {"type": "subtitle", "time": 18224.67, "timestamp": "05:03:44", "text": "何？待って、ずっと"}, {"type": "subtitle", "time": 18227.868, "timestamp": "05:03:47", "text": "アクティブ？何？"}, {"type": "subtitle", "time": 18231.19, "timestamp": "05:03:51", "text": "待って、気づかなかった。待って、私の"}, {"type": "subtitle", "time": 18233.19, "timestamp": "05:03:53", "text": "音声は正常ですか？私の音声が"}, {"type": "subtitle", "time": 18235.19, "timestamp": "05:03:55", "text": "良い。弾むような音や短いチョッピーな音ではない"}, {"type": "subtitle", "time": 18238.19, "timestamp": "05:03:58", "text": "あるいは、そんな感じ。私は"}]
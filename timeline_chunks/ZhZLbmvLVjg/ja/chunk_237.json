[{"type": "subtitle", "time": 14227.03, "timestamp": "03:57:07", "text": "あまりにも。では、他に何を始めたのか"}, {"type": "subtitle", "time": 14230.07, "timestamp": "03:57:10", "text": "まだ終わってないの？ GTFIは"}, {"type": "subtitle", "time": 14232.11, "timestamp": "03:57:12", "text": "それ"}, {"type": "subtitle", "time": 14235.91, "timestamp": "03:57:15", "text": "あまりにも。 GTFIで作られているので、インストールできます"}, {"type": "subtitle", "time": 14239.03, "timestamp": "03:57:19", "text": "もっと広いスペースを確保しよう。うん、GTAをやるよ"}, {"type": "subtitle", "time": 14240.59, "timestamp": "03:57:20", "text": "5"}, {"type": "subtitle", "time": 14255.99, "timestamp": "03:57:35", "text": "多く。なぜこんなにあくびばかりするんだろう？多分"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "もうすごく疲れているから。"}, {"type": "subtitle", "time": 14259.55, "timestamp": "03:57:39", "text": "しかし"}, {"type": "subtitle", "time": 14262.95, "timestamp": "03:57:42", "text": "ええ、それで、私が話したことは"}, {"type": "subtitle", "time": 14268.469, "timestamp": "03:57:48", "text": "ストリーム、えーと、新しいものを使用します"}, {"type": "subtitle", "time": 14273.189, "timestamp": "03:57:53", "text": "ええ、私たちは"}, {"type": "subtitle", "time": 14276.51, "timestamp": "03:57:56", "text": "えーと、ストリーマーを使って"}]
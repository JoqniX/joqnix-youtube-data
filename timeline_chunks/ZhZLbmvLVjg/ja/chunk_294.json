[{"type": "subtitle", "time": 17647.59, "timestamp": "04:54:07", "text": "[音楽]"}, {"type": "subtitle", "time": 17657.948, "timestamp": "04:54:17", "text": "じゃあ、えっと、私は行けません"}, {"type": "subtitle", "time": 17660.55, "timestamp": "04:54:20", "text": "戻る。これから動画制作に取り掛かります。"}, {"type": "subtitle", "time": 17662.31, "timestamp": "04:54:22", "text": "2年間隠してお​​いて、パパ"}, {"type": "subtitle", "time": 17664.47, "timestamp": "04:54:24", "text": "ジョーは私をリストに追加しなかったと言った。"}, {"type": "subtitle", "time": 17666.99, "timestamp": "04:54:26", "text": "2年が経ちました"}, {"type": "subtitle", "time": 17668.91, "timestamp": "04:54:28", "text": "年。あなた"}, {"type": "subtitle", "time": 17671.27, "timestamp": "04:54:31", "text": "知ってるでしょ、パート１の１つ"}, {"type": "subtitle", "time": 17673.67, "timestamp": "04:54:33", "text": "私が本当に幸せに思うこと"}, {"type": "subtitle", "time": 17675.83, "timestamp": "04:54:35", "text": "この概念リストを作成して、"}, {"type": "subtitle", "time": 17677.67, "timestamp": "04:54:37", "text": "それを公開して、ツイートする"}, {"type": "subtitle", "time": 17680.868, "timestamp": "04:54:40", "text": "それと全ては事実です"}, {"type": "subtitle", "time": 17683.11, "timestamp": "04:54:43", "text": "私が今まで見たことのない新しいユーチューバーです"}, {"type": "subtitle", "time": 17685.11, "timestamp": "04:54:45", "text": "前に。"}, {"type": "subtitle", "time": 17689.75, "timestamp": "04:54:49", "text": "彼らに会えたことが、本当に嬉しかった。"}, {"type": "subtitle", "time": 17694.91, "timestamp": "04:54:54", "text": "それは私をとても"}, {"type": "subtitle", "time": 17699.23, "timestamp": "04:54:59", "text": "ああ、それは私をとてもとても幸せにしてくれました"}]
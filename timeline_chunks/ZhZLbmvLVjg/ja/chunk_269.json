[{"type": "subtitle", "time": 16140.429, "timestamp": "04:29:00", "text": "ようやくボードを手に入れたので"}, {"type": "subtitle", "time": 16144.07, "timestamp": "04:29:04", "text": "すべて。ええ、大丈夫です。できなかった"}, {"type": "subtitle", "time": 16145.07, "timestamp": "04:29:05", "text": "する"}, {"type": "subtitle", "time": 16147.67, "timestamp": "04:29:07", "text": "ハロウィン。私もハロウィンはできませんでした。"}, {"type": "subtitle", "time": 16150.07, "timestamp": "04:29:10", "text": "祝ったわけじゃないけど、"}, {"type": "subtitle", "time": 16153.189, "timestamp": "04:29:13", "text": "今年は皆さんと一緒にお祝いします。"}, {"type": "subtitle", "time": 16155.99, "timestamp": "04:29:15", "text": "そう、君は怖いゲームをしているんだね。私"}, {"type": "subtitle", "time": 16159.75, "timestamp": "04:29:19", "text": "今日は何をするか分からない。私"}, {"type": "subtitle", "time": 16161.95, "timestamp": "04:29:21", "text": "私はただ"}, {"type": "subtitle", "time": 16164.55, "timestamp": "04:29:24", "text": "チャット中。もちろん、私は"}, {"type": "subtitle", "time": 16167.75, "timestamp": "04:29:27", "text": "怖いゲームとかそんな感じだけど、"}, {"type": "subtitle", "time": 16169.07, "timestamp": "04:29:29", "text": "感じた、"}, {"type": "subtitle", "time": 16173.189, "timestamp": "04:29:33", "text": "知ってる、私はああ叔母さんみたいに感じた、"}, {"type": "subtitle", "time": 16176.149, "timestamp": "04:29:36", "text": "大家さんの叔母さんがあそこで寝ています。"}, {"type": "subtitle", "time": 16178.63, "timestamp": "04:29:38", "text": "彼女を怖がらせたくない。私はそうしたい"}, {"type": "subtitle", "time": 16181.349, "timestamp": "04:29:41", "text": "今年プレイしたいホラーゲームの夢を共有しよう。"}, {"type": "subtitle", "time": 16185.03, "timestamp": "04:29:45", "text": "いいえ、実はホラー作品はあまり手がけていません。"}, {"type": "subtitle", "time": 16188.63, "timestamp": "04:29:48", "text": "それでも私は親切ではない、ええ、親切ではない"}, {"type": "subtitle", "time": 16189.79, "timestamp": "04:29:49", "text": "の"}, {"type": "subtitle", "time": 16192.389, "timestamp": "04:29:52", "text": "後悔。私がホラーをやったと思いますか？"}, {"type": "subtitle", "time": 16193.79, "timestamp": "04:29:53", "text": "ストリーム？"}, {"type": "subtitle", "time": 16197.349, "timestamp": "04:29:57", "text": "ミナ、コラボ配信はしたよ。のように、"}, {"type": "subtitle", "time": 16199.63, "timestamp": "04:29:59", "text": "自分のものを見せてください"}]
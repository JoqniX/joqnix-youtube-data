[{"type": "subtitle", "time": 6306.109, "timestamp": "01:45:06", "text": "バ。私だけが受け身なわけじゃない。"}, {"type": "subtitle", "time": 6308.79, "timestamp": "01:45:08", "text": "わかった。受け身の立場だとからかわれるのは誰？"}, {"type": "subtitle", "time": 6319.03, "timestamp": "01:45:19", "text": "みんなが私を呼ぶからHfy"}, {"type": "subtitle", "time": 6321.83, "timestamp": "01:45:21", "text": "試合。ええ、私です。それが一つ目です。私があなたに電話します"}, {"type": "subtitle", "time": 6322.83, "timestamp": "01:45:22", "text": "1"}, {"type": "subtitle", "time": 6327.149, "timestamp": "01:45:27", "text": "底。これはもう"}, {"type": "subtitle", "time": 6335.59, "timestamp": "01:45:35", "text": "君だけが、君だけが"}, {"type": "subtitle", "time": 6337.75, "timestamp": "01:45:37", "text": "私を呼ぶ人は皆、私をトップと呼ぶ。うん、"}, {"type": "subtitle", "time": 6341.39, "timestamp": "01:45:41", "text": "はい、そうしました。うん。"}, {"type": "subtitle", "time": 6345.35, "timestamp": "01:45:45", "text": "ほら、ほら、君をトップって呼んだでしょ。でもあなたは"}, {"type": "subtitle", "time": 6347.87, "timestamp": "01:45:47", "text": "私を爆弾と呼んでください。"}, {"type": "subtitle", "time": 6350.27, "timestamp": "01:45:50", "text": "なぜ？であるべき"}, {"type": "subtitle", "time": 6353.95, "timestamp": "01:45:53", "text": "与えることは"}, {"type": "subtitle", "time": 6357.51, "timestamp": "01:45:57", "text": "ちくしょう。私も受け身だと言っているんです。"}]
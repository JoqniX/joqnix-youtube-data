[{"type": "subtitle", "time": 17282.31, "timestamp": "04:48:02", "text": "良い。問題は、何百万もの"}, {"type": "subtitle", "time": 17284.708, "timestamp": "04:48:04", "text": "今、外にいる。たくさんの人が"}, {"type": "subtitle", "time": 17287.75, "timestamp": "04:48:07", "text": "インドから、そしてたくさんの"}, {"type": "subtitle", "time": 17289.83, "timestamp": "04:48:09", "text": "ストリーミング配信をしているかもしれない人たち、あるいは"}, {"type": "subtitle", "time": 17292.51, "timestamp": "04:48:12", "text": "チューブを今すぐ"}, {"type": "subtitle", "time": 17296.788, "timestamp": "04:48:16", "text": "では、どうすればそうならないとわかるのでしょうか"}, {"type": "subtitle", "time": 17299.628, "timestamp": "04:48:19", "text": "彼らは自己宣伝が好きで、"}, {"type": "subtitle", "time": 17303.03, "timestamp": "04:48:23", "text": "正しいことをするか、あるいは誰かに連絡を取る"}, {"type": "subtitle", "time": 17305.91, "timestamp": "04:48:25", "text": "私のような人、あるいは他の人たちのような人たち"}, {"type": "subtitle", "time": 17308.15, "timestamp": "04:48:28", "text": "アクティブで、ストリームなどが好きです"}, {"type": "subtitle", "time": 17310.39, "timestamp": "04:48:30", "text": "そうすれば、私は"}, {"type": "subtitle", "time": 17313.59, "timestamp": "04:48:33", "text": "あの人が存在することを知る"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "Vubとその他諸々のために。良い、"}, {"type": "subtitle", "time": 17317.75, "timestamp": "04:48:37", "text": "彼らは、ほら、自分たちの"}, {"type": "subtitle", "time": 17321.868, "timestamp": "04:48:41", "text": "貝殻か、小さいもののように"}, {"type": "subtitle", "time": 17324.628, "timestamp": "04:48:44", "text": "選別されていない宝石、または研磨されていない宝石のようなもの"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "研磨が必要な宝石または"}, {"type": "subtitle", "time": 17329.11, "timestamp": "04:48:49", "text": "何か。カードが何なのかわかりません"}, {"type": "subtitle", "time": 17331.868, "timestamp": "04:48:51", "text": "言う。"}, {"type": "subtitle", "time": 17334.628, "timestamp": "04:48:54", "text": "痛み。しかし、彼はYouTuberを一人も追加しなかった。"}, {"type": "subtitle", "time": 17337.31, "timestamp": "04:48:57", "text": "私のお気に入りのユーチューバーは、"}]
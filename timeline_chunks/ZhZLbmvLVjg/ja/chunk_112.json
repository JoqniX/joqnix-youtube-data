[{"type": "subtitle", "time": 6720.35, "timestamp": "01:52:00", "text": "えっと、そのことわざは何だったっけ？"}, {"type": "subtitle", "time": 6723.95, "timestamp": "01:52:03", "text": "また？でも、忘れてしまった。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 6726.35, "timestamp": "01:52:06", "text": "忘れた。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 6733.83, "timestamp": "01:52:13", "text": "ことわざは何だったっけ？私は何者だったのか"}, {"type": "subtitle", "time": 6735.709, "timestamp": "01:52:15", "text": "もう一度言っていますか？ことわざは何だったか"}, {"type": "subtitle", "time": 6738.07, "timestamp": "01:52:18", "text": "また？ことわざは何だったっけ？何"}, {"type": "subtitle", "time": 6739.75, "timestamp": "01:52:19", "text": "彼はまた同じことを言っていたのか？忘れた。忘れた。"}, {"type": "subtitle", "time": 6742.55, "timestamp": "01:52:22", "text": "忘れた。忘れた。忘れた。忘れた。"}, {"type": "subtitle", "time": 6745.03, "timestamp": "01:52:25", "text": "何てことだ。忘れた。忘れた。何が"}, {"type": "subtitle", "time": 6746.709, "timestamp": "01:52:26", "text": "私が言っているのは？私は何を言っていたんだっけ？彼は何者だったのか"}, {"type": "subtitle", "time": 6748.149, "timestamp": "01:52:28", "text": "言っているの？彼は何と言っていたのですか？彼は何者だったのか"}, {"type": "subtitle", "time": 6750.55, "timestamp": "01:52:30", "text": "言っているの？私は何を言っていたんだっけ？私は何者だったのか"}, {"type": "subtitle", "time": 6753.189, "timestamp": "01:52:33", "text": "言っているの？私は何を言っていたんだっけ？こんにちは。うん。"}, {"type": "subtitle", "time": 6757.43, "timestamp": "01:52:37", "text": "うん。うん。えっと、リマインドコマンドですね。"}, {"type": "subtitle", "time": 6759.99, "timestamp": "01:52:39", "text": "それはできるよ、まだ作ってないんだ"}, {"type": "subtitle", "time": 6762.31, "timestamp": "01:52:42", "text": "でも、もし私がそれを作ったら、それはこうなるだろう"}, {"type": "subtitle", "time": 6765.99, "timestamp": "01:52:45", "text": "感嘆符はジョックを思い出させる。そうすれば"}, {"type": "subtitle", "time": 6770.189, "timestamp": "01:52:50", "text": "そのコマンドを使用して"}, {"type": "subtitle", "time": 6775.669, "timestamp": "01:52:55", "text": "重要なメッセージ、例えばリマインダーなど"}, {"type": "subtitle", "time": 6778.03, "timestamp": "01:52:58", "text": "感嘆"}]
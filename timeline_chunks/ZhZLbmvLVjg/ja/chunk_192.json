[{"type": "subtitle", "time": 11530.11, "timestamp": "03:12:10", "text": "破壊するかもしれない"}, {"type": "subtitle", "time": 11542.91, "timestamp": "03:12:22", "text": "猫。"}, {"type": "subtitle", "time": 11545.87, "timestamp": "03:12:25", "text": "えっと、私は何をすればいいですか"}, {"type": "subtitle", "time": 11557.03, "timestamp": "03:12:37", "text": "ええと、それは無限だと思います。彼は"}, {"type": "subtitle", "time": 11560.389, "timestamp": "03:12:40", "text": "物を引き剥がすことについて。一部の人にとって"}, {"type": "subtitle", "time": 11575.71, "timestamp": "03:12:55", "text": "あまりにも。彼は私たちに靴を履かせようとするだろう"}]
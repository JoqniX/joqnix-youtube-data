[{"type": "subtitle", "time": 3485.39, "timestamp": "00:58:05", "text": "の"}, {"type": "subtitle", "time": 3497.87, "timestamp": "00:58:17", "text": "うん。さあ行こう。さあ行こう。さあ"}, {"type": "subtitle", "time": 3499.95, "timestamp": "00:58:19", "text": "行く。"}, {"type": "subtitle", "time": 3511.069, "timestamp": "00:58:31", "text": "私たち二人ともここから脱出するつもりだ"}, {"type": "subtitle", "time": 3513.789, "timestamp": "00:58:33", "text": "生きている。お前を捕まえるぞ"}, {"type": "subtitle", "time": 3516.75, "timestamp": "00:58:36", "text": "家。"}, {"type": "subtitle", "time": 3520.23, "timestamp": "00:58:40", "text": "自分。なぜこんなに広いのですか？なぜ"}, {"type": "subtitle", "time": 3522.51, "timestamp": "00:58:42", "text": "人が集まりそうな雰囲気ですか？"}]
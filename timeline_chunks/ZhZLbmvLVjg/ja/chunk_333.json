[{"type": "subtitle", "time": 19980.15, "timestamp": "05:33:00", "text": "そこに機械がある。奇妙な出来事"}, {"type": "subtitle", "time": 19988.43, "timestamp": "05:33:08", "text": "彼ら自身も、そうすれば大丈夫でしょう"}, {"type": "subtitle", "time": 19990.548, "timestamp": "05:33:10", "text": "続く。犬は何をしているの？私たちは"}, {"type": "subtitle", "time": 20002.47, "timestamp": "05:33:22", "text": "話。疲れた男は周囲を見回し続けた。"}, {"type": "subtitle", "time": 20004.548, "timestamp": "05:33:24", "text": "彼が何か最初のものを台無しにできるかどうかを見る"}, {"type": "subtitle", "time": 20006.47, "timestamp": "05:33:26", "text": "木々の間。彼は見えなかった"}, {"type": "subtitle", "time": 20008.788, "timestamp": "05:33:28", "text": "普通と違うこと。あった"}, {"type": "subtitle", "time": 20012.67, "timestamp": "05:33:32", "text": "あたり一面にオークとカエデの木しかない。彼"}, {"type": "subtitle", "time": 20015.35, "timestamp": "05:33:35", "text": "緑豊かな植生に囲まれた"}, {"type": "subtitle", "time": 20018.47, "timestamp": "05:33:38", "text": "両側から道路が通じている。暗い部分は"}, {"type": "subtitle", "time": 20021.51, "timestamp": "05:33:41", "text": "彼は不安を感じた。彼はスピードを落とさなければならなかった"}, {"type": "subtitle", "time": 20024.91, "timestamp": "05:33:44", "text": "通過時は特に注意して運転してください"}, {"type": "subtitle", "time": 20029.23, "timestamp": "05:33:49", "text": "光が当たっていた部分"}, {"type": "subtitle", "time": 20031.91, "timestamp": "05:33:51", "text": "外。ガソリンスタンドが目の前に現れた"}]
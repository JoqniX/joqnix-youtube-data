[{"type": "subtitle", "time": 7387.669, "timestamp": "02:03:07", "text": "右。うちにおいで。どこかに行って。私たちはそうしなかった"}, {"type": "subtitle", "time": 7396.39, "timestamp": "02:03:16", "text": "ここ。ちょっとした秘密がなければならない"}, {"type": "subtitle", "time": 7398.83, "timestamp": "02:03:18", "text": "あちこちに。 2つしかない、"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "右？ネコで行こうよ、だって私たちは遊んでるんだから"}, {"type": "subtitle", "time": 7403.75, "timestamp": "02:03:23", "text": "ネコゲーム。"}, {"type": "subtitle", "time": 7405.83, "timestamp": "02:03:25", "text": "待って、待って、待って、待って。えっと、ロックしてない"}, {"type": "subtitle", "time": 7413.99, "timestamp": "02:03:33", "text": "停止。剣。侍の刀。私にさせて、"}, {"type": "subtitle", "time": 7416.149, "timestamp": "02:03:36", "text": "推測させてください。えっと、カイは"}, {"type": "subtitle", "time": 7417.47, "timestamp": "02:03:37", "text": "私の"}, {"type": "subtitle", "time": 7420.31, "timestamp": "02:03:40", "text": "答え。ちょっと分析させてください。"}, {"type": "subtitle", "time": 7423.39, "timestamp": "02:03:43", "text": "両方を分析してください。"}, {"type": "subtitle", "time": 7426.669, "timestamp": "02:03:46", "text": "わかった。剣。あなたが言った"}, {"type": "subtitle", "time": 7429.83, "timestamp": "02:03:49", "text": "タチ。怪しい感じがする、だって、"}, {"type": "subtitle", "time": 7433.51, "timestamp": "02:03:53", "text": "侍の刀には必ず鞘が付いている。"}, {"type": "subtitle", "time": 7435.589, "timestamp": "02:03:55", "text": "それとも、なんて呼ぶんだっけ？私は忘れた"}, {"type": "subtitle", "time": 7438.31, "timestamp": "02:03:58", "text": "手に持って"}]
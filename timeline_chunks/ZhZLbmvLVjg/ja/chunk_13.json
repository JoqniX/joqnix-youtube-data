[{"type": "subtitle", "time": 780.949, "timestamp": "00:13:00", "text": "私も将来は変わるだろう"}, {"type": "subtitle", "time": 784.79, "timestamp": "00:13:04", "text": "この色。うん、配色"}, {"type": "subtitle", "time": 787.11, "timestamp": "00:13:07", "text": "これもそうだ。でも、そう、だから"}, {"type": "subtitle", "time": 789.75, "timestamp": "00:13:09", "text": "リーダーボードはこんな感じになるでしょう。えっと、"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "チャットに表示される瞬間です。いいえ、いいえ、"}, {"type": "subtitle", "time": 795.19, "timestamp": "00:13:15", "text": "いいえ。配信画面に表示されます。私はちょっと"}, {"type": "subtitle", "time": 798.79, "timestamp": "00:13:18", "text": "チャットでも見せたかったんです。"}, {"type": "subtitle", "time": 800.389, "timestamp": "00:13:20", "text": "だから、私はそのやり方がわからないのですが、"}, {"type": "subtitle", "time": 803.43, "timestamp": "00:13:23", "text": "この神をサポートするために尋ねる必要がある"}, {"type": "subtitle", "time": 806.03, "timestamp": "00:13:26", "text": "この人を作ったのは"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "拡張 両方の人々 メインの男"}, {"type": "subtitle", "time": 811.03, "timestamp": "00:13:31", "text": "このポイントシステムを作ったのは誰ですか？"}, {"type": "subtitle", "time": 813.91, "timestamp": "00:13:33", "text": "リーダーボードシステムを作った人"}, {"type": "subtitle", "time": 815.23, "timestamp": "00:13:35", "text": "表示しない"}, {"type": "subtitle", "time": 819.269, "timestamp": "00:13:39", "text": "チャット、つまりYouTubeについては、私は持っていません"}, {"type": "subtitle", "time": 822.069, "timestamp": "00:13:42", "text": "YouTubeのチャットボードはありません"}, {"type": "subtitle", "time": 826.629, "timestamp": "00:13:46", "text": "ボードアカウントを作成してすべてを行う方法"}, {"type": "subtitle", "time": 829.67, "timestamp": "00:13:49", "text": "Twitchでできること"}, {"type": "subtitle", "time": 832.15, "timestamp": "00:13:52", "text": "ボードアカウント、サブアカウントを使用する"}, {"type": "subtitle", "time": 835.79, "timestamp": "00:13:55", "text": "実際、投稿するもの"}, {"type": "subtitle", "time": 837.75, "timestamp": "00:13:57", "text": "すべて。はい、コメントしてください"}]
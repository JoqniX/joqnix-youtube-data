[{"type": "subtitle", "time": 6601.07, "timestamp": "01:50:01", "text": "上。そこで私たちは"}, {"type": "subtitle", "time": 6607.709, "timestamp": "01:50:07", "text": "[音楽]"}, {"type": "subtitle", "time": 6611.59, "timestamp": "01:50:11", "text": "ここ。待って、私は以前はニャーを持っていた"}, {"type": "subtitle", "time": 6613.55, "timestamp": "01:50:13", "text": "声 声"}, {"type": "subtitle", "time": 6617.07, "timestamp": "01:50:17", "text": "笑いの代替としての効果"}, {"type": "subtitle", "time": 6620.79, "timestamp": "01:50:20", "text": "あれ。追加しなかったのか"}, {"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "効果音の削除？"}, {"type": "subtitle", "time": 6627.55, "timestamp": "01:50:27", "text": "ああ、追加するのを忘れていたみたいだ。あなたが知っている"}, {"type": "subtitle", "time": 6631.91, "timestamp": "01:50:31", "text": "何？追加してみます。追加してみます。"}, {"type": "subtitle", "time": 6634.79, "timestamp": "01:50:34", "text": "配信後。うん。また、私は"}, {"type": "subtitle", "time": 6636.95, "timestamp": "01:50:36", "text": "何かをすること"}, {"type": "subtitle", "time": 6639.39, "timestamp": "01:50:39", "text": "えーっと、リマインダーみたいな感じ"}]
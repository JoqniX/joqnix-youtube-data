[{"type": "subtitle", "time": 16204.309, "timestamp": "04:30:04", "text": "チャネル。ああ、そうだな。ええと、私たちが"}, {"type": "subtitle", "time": 16207.67, "timestamp": "04:30:07", "text": "うん、ディーワは楽しかったよ。ええ、ディーワは"}, {"type": "subtitle", "time": 16212.149, "timestamp": "04:30:12", "text": "楽しい。死んだものとして放置された。ディワ、これで2人目だ。"}, {"type": "subtitle", "time": 16214.389, "timestamp": "04:30:14", "text": "では、その後はどうなるのか？パラソーシャル、これで３つ目。"}, {"type": "subtitle", "time": 16217.51, "timestamp": "04:30:17", "text": "パスフォビア、これで4つ目。では、その後はどうなるのか？それから"}, {"type": "subtitle", "time": 16221.03, "timestamp": "04:30:21", "text": "今月は何をしましたか？ 4つ。それから"}, {"type": "subtitle", "time": 16223.07, "timestamp": "04:30:23", "text": "奥の部屋"}, {"type": "subtitle", "time": 16225.51, "timestamp": "04:30:25", "text": "五。それはカウントされますか？ 5つです"}, {"type": "subtitle", "time": 16227.59, "timestamp": "04:30:27", "text": "ゲームですよね？待って、それって本当に"}, {"type": "subtitle", "time": 16230.07, "timestamp": "04:30:30", "text": "カウント？そんな風に数えてもいいですか？"}, {"type": "subtitle", "time": 16233.67, "timestamp": "04:30:33", "text": "いや、そんなことはない。しかし、昨年2022年に私が"}, {"type": "subtitle", "time": 16238.469, "timestamp": "04:30:38", "text": "私がやったことは、2週間ほど恐ろしい日々が続いたことです。"}, {"type": "subtitle", "time": 16241.91, "timestamp": "04:30:41", "text": "2週間分の恐怖が"}, {"type": "subtitle", "time": 16245.51, "timestamp": "04:30:45", "text": "私は焼け落ちて、文字通り"}, {"type": "subtitle", "time": 16249.229, "timestamp": "04:30:49", "text": "私の精神状態に影響を与えた、例えば"}, {"type": "subtitle", "time": 16253.75, "timestamp": "04:30:53", "text": "小さな音でも、私はすごくびっくりしてしまうんです。"}, {"type": "subtitle", "time": 16256.95, "timestamp": "04:30:56", "text": "FPSのようなビデオゲームはプレイできませんでした"}, {"type": "subtitle", "time": 16259.75, "timestamp": "04:30:59", "text": "ゲームはそれ以来ずっとあなたのように適切に"}]
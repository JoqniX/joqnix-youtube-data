[{"type": "subtitle", "time": 15606.07, "timestamp": "04:20:06", "text": "私は眠ります。ご心配なく。"}, {"type": "subtitle", "time": 15607.39, "timestamp": "04:20:07", "text": "心配しないでください"}, {"type": "subtitle", "time": 15609.229, "timestamp": "04:20:09", "text": "[音楽]"}, {"type": "subtitle", "time": 15612.229, "timestamp": "04:20:12", "text": "それ。待って、それって大丈夫？ひねりは"}, {"type": "subtitle", "time": 15619.51, "timestamp": "04:20:19", "text": "わかったよ。"}, {"type": "subtitle", "time": 15621.429, "timestamp": "04:20:21", "text": "何と言っていいかわからない。のように"}, {"type": "subtitle", "time": 15624.63, "timestamp": "04:20:24", "text": "文字通り、私は何も準備していませんし、"}, {"type": "subtitle", "time": 15627.83, "timestamp": "04:20:27", "text": "問題はこれではなく、私がこれを準備したということではない。"}, {"type": "subtitle", "time": 15630.87, "timestamp": "04:20:30", "text": "例えば午後6時頃。考えていたように"}, {"type": "subtitle", "time": 15633.429, "timestamp": "04:20:33", "text": "7時頃に配信するとか、"}, {"type": "subtitle", "time": 15637.269, "timestamp": "04:20:37", "text": "5とかそんな感じ。えっと、これは6時に準備しました"}, {"type": "subtitle", "time": 15640.229, "timestamp": "04:20:40", "text": "または午後5時夕方にはそういうもの"}, {"type": "subtitle", "time": 15642.07, "timestamp": "04:20:42", "text": "ハロウィン配信用のアセット"}, {"type": "subtitle", "time": 15644.149, "timestamp": "04:20:44", "text": "すべて。また、もし確認したい場合は"}, {"type": "subtitle", "time": 15646.309, "timestamp": "04:20:46", "text": "これらのアセットからリンクが"}, {"type": "subtitle", "time": 15649.11, "timestamp": "04:20:49", "text": "説明。私は自分が確実に"}, {"type": "subtitle", "time": 15652.229, "timestamp": "04:20:52", "text": "クレジットを付けました。"}, {"type": "subtitle", "time": 15656.07, "timestamp": "04:20:56", "text": "他の人たちの仕事に対して。うん。"}, {"type": "subtitle", "time": 15658.82, "timestamp": "04:20:58", "text": "うん。うん。"}]
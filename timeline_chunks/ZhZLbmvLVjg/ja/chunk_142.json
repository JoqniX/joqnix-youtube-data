[{"type": "subtitle", "time": 8525.63, "timestamp": "02:22:05", "text": "あれ？こちらには何もなかった、"}, {"type": "subtitle", "time": 8529.87, "timestamp": "02:22:09", "text": "右？私は言葉を検閲しています。全て"}, {"type": "subtitle", "time": 8536.19, "timestamp": "02:22:16", "text": "ええと、ほら、"}, {"type": "subtitle", "time": 8540.07, "timestamp": "02:22:20", "text": "あー、そうそう、言い忘れてたんだけど"}, {"type": "subtitle", "time": 8542.79, "timestamp": "02:22:22", "text": "自動車関連のテストをしていたんです。あなた"}, {"type": "subtitle", "time": 8545.15, "timestamp": "02:22:25", "text": "知ってるよ、この新しい自動車"}, {"type": "subtitle", "time": 8547.87, "timestamp": "02:22:27", "text": "システム。やったよ"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "えっと、この車に新しいものを作ったんだ。その"}, {"type": "subtitle", "time": 8554.55, "timestamp": "02:22:34", "text": "実際、家族の発表の中で。できる"}, {"type": "subtitle", "time": 8561.99, "timestamp": "02:22:41", "text": "ええと、これは。だから私はこうしました、ああ、"}, {"type": "subtitle", "time": 8564.71, "timestamp": "02:22:44", "text": "待って。それはこちらにあります。必ず"}, {"type": "subtitle", "time": 8566.91, "timestamp": "02:22:46", "text": "理由"}, {"type": "subtitle", "time": 8569.55, "timestamp": "02:22:49", "text": "ここ。そこで私たちは"}, {"type": "subtitle", "time": 8571.55, "timestamp": "02:22:51", "text": "行く。"}, {"type": "subtitle", "time": 8574.55, "timestamp": "02:22:54", "text": "ここ。よし、これでいい。ついに。いいえ、私は"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "誰もできないように"}]
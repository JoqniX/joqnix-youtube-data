[{"type": "subtitle", "time": 1380.31, "timestamp": "00:23:00", "text": "黒猫も含めるよ。の"}, {"type": "subtitle", "time": 1382.63, "timestamp": "00:23:02", "text": "まっすぐな猫がやってきて"}, {"type": "subtitle", "time": 1384.63, "timestamp": "00:23:04", "text": "ここに住んでいる。これで5人目になりますね。"}, {"type": "subtitle", "time": 1388.23, "timestamp": "00:23:08", "text": "うん。 5匹の猫。猫に名前をつけましょう。えっと、"}, {"type": "subtitle", "time": 1390.31, "timestamp": "00:23:10", "text": "悲しい名前ではないが、"}, {"type": "subtitle", "time": 1394.51, "timestamp": "00:23:14", "text": "彼らに名前をつけた。黒の方は"}, {"type": "subtitle", "time": 1397.99, "timestamp": "00:23:17", "text": "黒奈。それから、えーと、白いのもあるんだけど、"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "これは大きな問題だ。今それは"}, {"type": "subtitle", "time": 1403.87, "timestamp": "00:23:23", "text": "小さな子猫が大きな"}, {"type": "subtitle", "time": 1408.669, "timestamp": "00:23:28", "text": "子猫。だから私は電話する"}, {"type": "subtitle", "time": 1410.91, "timestamp": "00:23:30", "text": "彼"}, {"type": "subtitle", "time": 1413.549, "timestamp": "00:23:33", "text": "[音楽]"}, {"type": "subtitle", "time": 1418.27, "timestamp": "00:23:38", "text": "白。白人はいない。以前は"}, {"type": "subtitle", "time": 1428.39, "timestamp": "00:23:48", "text": "黄色。うん。こんにちは。"}, {"type": "subtitle", "time": 1431.23, "timestamp": "00:23:51", "text": "元気かい"}, {"type": "subtitle", "time": 1439.789, "timestamp": "00:23:59", "text": "亡くなった。それからそれから"}]
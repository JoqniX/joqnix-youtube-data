[{"type": "subtitle", "time": 18727.708, "timestamp": "05:12:07", "text": "[音楽]"}, {"type": "subtitle", "time": 18730.39, "timestamp": "05:12:10", "text": "えっと、その時は時間に関係なく"}, {"type": "subtitle", "time": 18734.23, "timestamp": "05:12:14", "text": "もしそれが大丈夫なら、"}, {"type": "subtitle", "time": 18738.11, "timestamp": "05:12:18", "text": "文字通り"}, {"type": "subtitle", "time": 18742.708, "timestamp": "05:12:22", "text": "ええ、文字通り、これを読むことができます。"}, {"type": "subtitle", "time": 18747.708, "timestamp": "05:12:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18749.99, "timestamp": "05:12:29", "text": "ない？では、どちらを読めばいいでしょうか？"}, {"type": "subtitle", "time": 18751.99, "timestamp": "05:12:31", "text": "たくさんあります。わかった。こんにちは。その前に、"}, {"type": "subtitle", "time": 18761.99, "timestamp": "05:12:41", "text": "ハシム。誕生日おめでとう、待って、私に"}]
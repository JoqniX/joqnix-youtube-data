[{"type": "subtitle", "time": 6663.43, "timestamp": "01:51:03", "text": "私は口がきけないのですか？一体どういうことだ？ミュートしました"}, {"type": "subtitle", "time": 6667.35, "timestamp": "01:51:07", "text": "自分自身。いいえ、ずっと私が話していました。"}, {"type": "subtitle", "time": 6688.87, "timestamp": "01:51:28", "text": "なぜ？あのね？私はそれを作らなければならない"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "ああ、たくさんのものが"}, {"type": "subtitle", "time": 6693.91, "timestamp": "01:51:33", "text": "修正しなければならない脳内"}, {"type": "subtitle", "time": 6696.709, "timestamp": "01:51:36", "text": "自動化する。でも私は"}, {"type": "subtitle", "time": 6699.109, "timestamp": "01:51:39", "text": "あなたの声が聞こえました。待って、あなたはえ？私"}, {"type": "subtitle", "time": 6702.149, "timestamp": "01:51:42", "text": "わからない。マイクを今見たところです。"}, {"type": "subtitle", "time": 6705.03, "timestamp": "01:51:45", "text": "マイクのライトが消えていたんです"}, {"type": "subtitle", "time": 6706.109, "timestamp": "01:51:46", "text": "そしてまた"}, {"type": "subtitle", "time": 6709.03, "timestamp": "01:51:49", "text": "えっと、私ミュートしてたの？それとも話してたの？"}, {"type": "subtitle", "time": 6711.91, "timestamp": "01:51:51", "text": "この件について？こんにちは。もう一度繰り返します。"}, {"type": "subtitle", "time": 6714.27, "timestamp": "01:51:54", "text": "えっと、どこで手に入れたのか分からない"}, {"type": "subtitle", "time": 6718.629, "timestamp": "01:51:58", "text": "ミュート。ええ、でも、それで私はこう言っていたんです"}]
[{"type": "subtitle", "time": 14942.309, "timestamp": "04:09:02", "text": "ポイントを獲得するには、いいねやシェアをしてください。"}, {"type": "subtitle", "time": 14944.95, "timestamp": "04:09:04", "text": "私は両方に共通のポイントシステムを持っています"}, {"type": "subtitle", "time": 14946.189, "timestamp": "04:09:06", "text": "Twitchと"}, {"type": "subtitle", "time": 14949.469, "timestamp": "04:09:09", "text": "YouTube。こんにちは。"}, {"type": "subtitle", "time": 14953.429, "timestamp": "04:09:13", "text": "誰でも？そして私はカイに見せた"}, {"type": "subtitle", "time": 14955.11, "timestamp": "04:09:15", "text": "リーダーボードは"}, {"type": "subtitle", "time": 14957.349, "timestamp": "04:09:17", "text": "ストリーム。もう一度お見せします。それで"}, {"type": "subtitle", "time": 14959.99, "timestamp": "04:09:19", "text": "ええ、あなたはどこにいますか？こんにちは。これを超える"}, {"type": "subtitle", "time": 14961.79, "timestamp": "04:09:21", "text": "ここに"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "リーダーボード。これは以下とリンクされます"}, {"type": "subtitle", "time": 14967.349, "timestamp": "04:09:27", "text": "持っている人全員の名前"}, {"type": "subtitle", "time": 14970.229, "timestamp": "04:09:30", "text": "ポイントとかそういう類。現時点では"}, {"type": "subtitle", "time": 14972.469, "timestamp": "04:09:32", "text": "ランダムな名前とランダムなポイント。そうではありません"}, {"type": "subtitle", "time": 14975.83, "timestamp": "04:09:35", "text": "まだ完全に設定が完了していません。そうですね、私は"}, {"type": "subtitle", "time": 14979.469, "timestamp": "04:09:39", "text": "それとその他諸々を少しずつ"}, {"type": "subtitle", "time": 14982.67, "timestamp": "04:09:42", "text": "ゆっくり。こんにちは。それで"}, {"type": "subtitle", "time": 14986.309, "timestamp": "04:09:46", "text": "皆さん、ありがとうございました。さて、見てみよう"}, {"type": "subtitle", "time": 14988.11, "timestamp": "04:09:48", "text": "次の動画で君たちを見てね。"}, {"type": "subtitle", "time": 14996.51, "timestamp": "04:09:56", "text": "こんにちは。今、オーマイって言った？"}, {"type": "subtitle", "time": 14999.71, "timestamp": "04:09:59", "text": "神。何てことだ。私はほとんど「私は"}]
[{"type": "subtitle", "time": 9603.389, "timestamp": "02:40:03", "text": "ロボット。の"}, {"type": "subtitle", "time": 9606.15, "timestamp": "02:40:06", "text": "ロボット。ロボット。実際、最初の"}, {"type": "subtitle", "time": 9608.23, "timestamp": "02:40:08", "text": "ビールとあなたについて話す時間"}, {"type": "subtitle", "time": 9609.83, "timestamp": "02:40:09", "text": "私のいとこよりも。私は"}, {"type": "subtitle", "time": 9611.51, "timestamp": "02:40:11", "text": "オープンスペースを見つけたので、言及するまで"}, {"type": "subtitle", "time": 9613.309, "timestamp": "02:40:13", "text": "今。"}, {"type": "subtitle", "time": 9615.87, "timestamp": "02:40:15", "text": "正直に言うと"}, {"type": "subtitle", "time": 9619.59, "timestamp": "02:40:19", "text": "君たち、僕の友達全員、アイドル仲間たち"}, {"type": "subtitle", "time": 9621.91, "timestamp": "02:40:21", "text": "私はアニメについて話しました、彼らは"}, {"type": "subtitle", "time": 9625.59, "timestamp": "02:40:25", "text": "なんだか変な感じだった。私はBLが好きだった"}, {"type": "subtitle", "time": 9627.63, "timestamp": "02:40:27", "text": "G"}, {"type": "subtitle", "time": 9632.63, "timestamp": "02:40:32", "text": "いろいろあったけど、でも、それで、これがあった"}, {"type": "subtitle", "time": 9635.75, "timestamp": "02:40:35", "text": "アニメグループの皆さん。彼らはまた"}, {"type": "subtitle", "time": 9638.95, "timestamp": "02:40:38", "text": "白い"}, {"type": "subtitle", "time": 9642.309, "timestamp": "02:40:42", "text": "えーと、デンデンとか。だから私はもっと"}, {"type": "subtitle", "time": 9645.11, "timestamp": "02:40:45", "text": "いつか話せるグループが見つかるだろうか"}, {"type": "subtitle", "time": 9647.83, "timestamp": "02:40:47", "text": "この商品と、ついに見つけた"}, {"type": "subtitle", "time": 9650.79, "timestamp": "02:40:50", "text": "BLについて話す。だから私はまだ探している"}, {"type": "subtitle", "time": 9655.15, "timestamp": "02:40:55", "text": "GL関連のことですが、"}, {"type": "subtitle", "time": 9658.19, "timestamp": "02:40:58", "text": "ゆっくりと"}]
[{"type": "subtitle", "time": 20100.03, "timestamp": "05:35:00", "text": "彼は"}, {"type": "subtitle", "time": 20102.35, "timestamp": "05:35:02", "text": "車。外に出た"}, {"type": "subtitle", "time": 20105.11, "timestamp": "05:35:05", "text": "車の中で、革のジッパーを上げた"}, {"type": "subtitle", "time": 20108.19, "timestamp": "05:35:08", "text": "ジャケット。風が少し強かった"}, {"type": "subtitle", "time": 20116.51, "timestamp": "05:35:16", "text": "到着した。秋はすでに始まっていたが"}, {"type": "subtitle", "time": 20118.948, "timestamp": "05:35:18", "text": "到着したので、天気は"}, {"type": "subtitle", "time": 20123.11, "timestamp": "05:35:23", "text": "日ごとに寒くなる。彼の足は硬かった"}, {"type": "subtitle", "time": 20125.27, "timestamp": "05:35:25", "text": "歩く時間。彼はかなりの時間を費やした"}, {"type": "subtitle", "time": 20128.23, "timestamp": "05:35:28", "text": "座った姿勢で過ごす時間。だから彼の"}, {"type": "subtitle", "time": 20144.19, "timestamp": "05:35:44", "text": "錆びている。"}, {"type": "subtitle", "time": 20149.19, "timestamp": "05:35:49", "text": "ジェイクはそんなに年をとっていなかった。実際、彼は"}, {"type": "subtitle", "time": 20153.27, "timestamp": "05:35:53", "text": "まだ44歳で、男性として健康そのものだ"}, {"type": "subtitle", "time": 20155.51, "timestamp": "05:35:55", "text": "ある年齢に達する。彼の顔に浮かんだよろめき"}, {"type": "subtitle", "time": 20158.23, "timestamp": "05:35:58", "text": "すでに髭に変わっている。彼はそうしていなかった"}]
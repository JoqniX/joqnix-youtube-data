[{"type": "subtitle", "time": 483.27, "timestamp": "00:08:03", "text": "こんにちは、ようこそ。えっと、"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "私は何を言っていたんだっけ？ええ、Twitchでやりました"}, {"type": "subtitle", "time": 490.15, "timestamp": "00:08:10", "text": "ずっと昔に私たちが"}, {"type": "subtitle", "time": 493.43, "timestamp": "00:08:13", "text": "TwitcherのTwitter名変更"}, {"type": "subtitle", "time": 496.629, "timestamp": "00:08:16", "text": "YouTube。ライブ配信すると、"}, {"type": "chat", "time": 498.491, "timestamp": "00:08:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why is vodnix lookin to the side so much"}, {"type": "subtitle", "time": 499.469, "timestamp": "00:08:19", "text": "Twitchとかそういうやつ。それで"}, {"type": "subtitle", "time": 501.869, "timestamp": "00:08:21", "text": "どうやら効果があるようだ。"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "どうやらあなたは私がTwitterユーザーだと知っているようですね"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "開発する、私はTwitter開発者を持っています"}, {"type": "chat", "time": 506.48, "timestamp": "00:08:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "bro had the 2nd monitor far right"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "アクセス、ですよね？ああ、それはチャットですね。それは"}, {"type": "subtitle", "time": 510.309, "timestamp": "00:08:30", "text": "チャット。それはチャットですね。待っていた"}, {"type": "subtitle", "time": 513.029, "timestamp": "00:08:33", "text": "Twitter開発者ポータルを使用して"}, {"type": "subtitle", "time": 516.149, "timestamp": "00:08:36", "text": "私のTwitterボード用のアプリを作成し、"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "いろいろなものがあり、Discord ボードがそれを接続しました"}, {"type": "subtitle", "time": 521.99, "timestamp": "00:08:41", "text": "そう、それは私にはできなかった"}, {"type": "subtitle", "time": 526.87, "timestamp": "00:08:46", "text": "私は何事も遅いんです。でもでも今はできる"}, {"type": "subtitle", "time": 530.23, "timestamp": "00:08:50", "text": "Twitter API を使用してバナーを変更し、"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "ライブ配信時のユーザー名とアバター。だから私は"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "この突拍子もないアイデアを思いついた。そうなる"}, {"type": "subtitle", "time": 538.47, "timestamp": "00:08:58", "text": "画像に透かしを入れるような感じ。そうなるだろう"}]
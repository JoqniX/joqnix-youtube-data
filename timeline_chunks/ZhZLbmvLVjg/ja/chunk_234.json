[{"type": "subtitle", "time": 14058.189, "timestamp": "03:54:18", "text": "主。はい、それは"}, {"type": "subtitle", "time": 14065.15, "timestamp": "03:54:25", "text": "やめる。"}, {"type": "subtitle", "time": 14066.91, "timestamp": "03:54:26", "text": "ついに。"}, {"type": "subtitle", "time": 14073.15, "timestamp": "03:54:33", "text": "そして27件中27件完了しました。"}, {"type": "subtitle", "time": 14076.11, "timestamp": "03:54:36", "text": "思い出。"}, {"type": "subtitle", "time": 14079.229, "timestamp": "03:54:39", "text": "ついに、"}, {"type": "subtitle", "time": 14081.07, "timestamp": "03:54:41", "text": "ゲーム。"}, {"type": "subtitle", "time": 14085.349, "timestamp": "03:54:45", "text": "こんにちは。これで辞めて、"}, {"type": "subtitle", "time": 14088.229, "timestamp": "03:54:48", "text": "配信を終了します。そう、それは"}, {"type": "subtitle", "time": 14090.03, "timestamp": "03:54:50", "text": "楽しい旅になる"}, {"type": "subtitle", "time": 14092.51, "timestamp": "03:54:52", "text": "正直。"}, {"type": "subtitle", "time": 14095.79, "timestamp": "03:54:55", "text": "ああ。モー、私たちが終わってしまったなんて信じられない"}, {"type": "subtitle", "time": 14098.55, "timestamp": "03:54:58", "text": "それ。ええ、そうですね。私はどう思うか"}]
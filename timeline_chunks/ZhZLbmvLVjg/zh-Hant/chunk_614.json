[{"type": "subtitle", "time": 36847.266, "timestamp": "10:14:07", "text": "我們走吧。"}, {"type": "subtitle", "time": 36851.99, "timestamp": "10:14:11", "text": "媽的。抽煙。  帶走我的幻影。我那裡有幻影。  城市被毀。  還剩一個敵人。  我的天哪。我"}, {"type": "subtitle", "time": 36866.63, "timestamp": "10:14:26", "text": "朋友花了190塊錢把他買"}, {"type": "subtitle", "time": 36868.55, "timestamp": "10:14:28", "text": "下來了。  謝謝。  謝謝。"}, {"type": "subtitle", "time": 36880.31, "timestamp": "10:14:40", "text": "嘿，你是不是盡力想把我的槍還給我？  開始"}, {"type": "subtitle", "time": 36887.55, "timestamp": "10:14:47", "text": "了。  費用已用完。  費用已用完。"}]
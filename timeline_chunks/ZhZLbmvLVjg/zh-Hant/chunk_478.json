[{"type": "subtitle", "time": 28681.19, "timestamp": "07:58:01", "text": "不能叫我喬克。  那樣就容易多了，"}, {"type": "subtitle", "time": 28683.91, "timestamp": "07:58:03", "text": "因為對很多人來說，“"}, {"type": "subtitle", "time": 28687.43, "timestamp": "07:58:07", "text": "Jock”這個詞很難發音。其他可發音的。  薩。好的。是的。  那麼，你是如何找到鈉的"}, {"type": "subtitle", "time": 28699.19, "timestamp": "07:58:19", "text": "？  但你就像"}, {"type": "subtitle", "time": 28713.11, "timestamp": "07:58:33", "text": "倖存者。  別叫我V，"}, {"type": "subtitle", "time": 28731.99, "timestamp": "07:58:51", "text": "我會叫你V。"}]
[{"type": "subtitle", "time": 17820.91, "timestamp": "04:57:00", "text": "？萬聖節過得怎麼樣"}, {"type": "subtitle", "time": 17825.75, "timestamp": "04:57:05", "text": "？太好了，希望你一切都好，Katto。卡托，你好嗎？萬聖節快樂。還有，老兄，萬聖節快樂。希望你一切都好。好久不見了。嗨，"}, {"type": "subtitle", "time": 17833.788, "timestamp": "04:57:13", "text": "媽媽。"}, {"type": "subtitle", "time": 17845.43, "timestamp": "04:57:25", "text": "是下一位被任命的主持人。然後，還有被任命的劍魂。感謝《"}]
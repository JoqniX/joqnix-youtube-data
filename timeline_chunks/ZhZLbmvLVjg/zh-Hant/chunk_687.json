[{"type": "subtitle", "time": 41223.586, "timestamp": "11:27:03", "text": "呃，我還想多說幾句，但是現在已經快四個小時了。我的天哪，我發現我的夜間直播"}, {"type": "subtitle", "time": 41229.55, "timestamp": "11:27:09", "text": "或 YouTube直播"}, {"type": "subtitle", "time": 41241.426, "timestamp": "11:27:21", "text": "不知不覺就變成了 5 個小時。 點發的推文。是的，我沒睡。我為什麼"}, {"type": "subtitle", "time": 41267.746, "timestamp": "11:27:47", "text": "整夜沒睡？我的天啊。還有這句“嗨，桑”。嗨，桑。薩爾瑪·薩拉姆。  薩爾喜歡"}]
[{"type": "subtitle", "time": 25400.23, "timestamp": "07:03:20", "text": "等等，是"}, {"type": "subtitle", "time": 25402.788, "timestamp": "07:03:22", "text": "不是只有我一個人沒聽到你說話"}, {"type": "subtitle", "time": 25407.15, "timestamp": "07:03:27", "text": "？你一句話都沒說。是的。  是的。是的。是的。因為"}, {"type": "subtitle", "time": 25410.548, "timestamp": "07:03:30", "text": "我總是忘記。  我的天啊。"}]
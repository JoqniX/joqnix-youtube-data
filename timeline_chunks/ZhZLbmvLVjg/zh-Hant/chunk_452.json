[{"type": "subtitle", "time": 27121.27, "timestamp": "07:32:01", "text": "。 我有一段時間沒做了，也許"}, {"type": "subtitle", "time": 27123.11, "timestamp": "07:32:03", "text": "我會抽空做一次"}, {"type": "subtitle", "time": 27124.628, "timestamp": "07:32:04", "text": "。  哦，就差一點點。好吧。不"}, {"type": "subtitle", "time": 27134.03, "timestamp": "07:32:14", "text": "，不，"}, {"type": "subtitle", "time": 27154.388, "timestamp": "07:32:34", "text": "我的意思是像我們執行的那種臥底任務。這種立體面料並非它唯一的功能。  作為一次秘密任務，我們成功地活了"}]
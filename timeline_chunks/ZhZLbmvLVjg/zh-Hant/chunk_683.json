[{"type": "subtitle", "time": 40982.71, "timestamp": "11:23:02", "text": "我說“baka”的時候，更像是​​​​在叫你暱稱，或者像“baka”之類的，就像我用來稱呼別人的暱稱，表示信任，也是友誼的象徵。"}, {"type": "subtitle", "time": 40986.55, "timestamp": "11:23:06", "text": "我不知道。這是件好事。這正是"}, {"type": "subtitle", "time": 40990.71, "timestamp": "11:23:10", "text": "我想表達的意思，而且是好意的。"}, {"type": "subtitle", "time": 40995.31, "timestamp": "11:23:15", "text": "所以"}, {"type": "subtitle", "time": 41006.106, "timestamp": "11:23:26", "text": "我用「笨蛋」這個詞跟我要接觸的"}, {"type": "subtitle", "time": 41034.79, "timestamp": "11:23:54", "text": "日本人說了這句話。 baka。不用了。是的。 沙米爾·阿馬桑。我們知道是誰幹的。 哦是的。的到來。上的個人資料圖片。等著。盡力了，對嗎"}]
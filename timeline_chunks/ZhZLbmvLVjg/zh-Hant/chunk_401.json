[{"type": "subtitle", "time": 24060.83, "timestamp": "06:41:00", "text": "？當然可以。好了，"}, {"type": "subtitle", "time": 24071.43, "timestamp": "06:41:11", "text": "我們走吧。有趣的。你好。"}, {"type": "subtitle", "time": 24074.67, "timestamp": "06:41:14", "text": "我會"}, {"type": "subtitle", "time": 24079.43, "timestamp": "06:41:19", "text": "回來的。好的。好的。"}, {"type": "subtitle", "time": 24099.03, "timestamp": "06:41:39", "text": "你"}, {"type": "subtitle", "time": 24101.99, "timestamp": "06:41:41", "text": "喜歡這個視頻。快點。給他們一些"}, {"type": "subtitle", "time": 24106.31, "timestamp": "06:41:46", "text": "享受。等待。不，我會的。我很"}, {"type": "subtitle", "time": 24109.99, "timestamp": "06:41:49", "text": "生氣。嗯嗯，我馬上回來。我感覺有點"}, {"type": "subtitle", "time": 24112.788, "timestamp": "06:41:52", "text": "冷，我想大概是因為待在"}, {"type": "subtitle", "time": 24115.51, "timestamp": "06:41:55", "text": "房子裡吧，這裡是新加坡。我不"}, {"type": "subtitle", "time": 24118.31, "timestamp": "06:41:58", "text": "知道為什麼新加坡人會覺得，"}]
[{"type": "subtitle", "time": 41168.23, "timestamp": "11:26:08", "text": "我就像在打開，就像在剪掉一些"}, {"type": "subtitle", "time": 41171.03, "timestamp": "11:26:11", "text": "東西，因為我在 Twitch"}, {"type": "subtitle", "time": 41173.426, "timestamp": "11:26:13", "text": "直播中不小心犯了個小錯誤。所以，我得把它"}, {"type": "subtitle", "time": 41178.87, "timestamp": "11:26:18", "text": "修好。  呃，喬說，試著說"}, {"type": "subtitle", "time": 41193.746, "timestamp": "11:26:33", "text": "這個呃呃蘇塔爾。  是"}, {"type": "subtitle", "time": 41205.15, "timestamp": "11:26:45", "text": "的。謝謝你教我一個新詞。謝謝"}, {"type": "subtitle", "time": 41210.426, "timestamp": "11:26:50", "text": "。謝謝。"}]
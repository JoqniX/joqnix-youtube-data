[{"type": "subtitle", "time": 4935.11, "timestamp": "01:22:15", "text": "我的天哪，好痛。大容量"}, {"type": "subtitle", "time": 4939.27, "timestamp": "01:22:19", "text": "電池。哦，不。哦，不。哦，不。"}, {"type": "subtitle", "time": 4944.51, "timestamp": "01:22:24", "text": "我們明白了"}, {"type": "subtitle", "time": 4947.83, "timestamp": "01:22:27", "text": "。我們繼續在店裡。  等等，我沒給樓下那個人配鑰匙。"}, {"type": "subtitle", "time": 4956.07, "timestamp": "01:22:36", "text": "哦，我沒做"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "。我錯過了，我錯過了。等等，我可以回去再做一次嗎"}]
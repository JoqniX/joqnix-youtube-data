[{"type": "subtitle", "time": 9362.389, "timestamp": "02:36:02", "text": "必須到達終點，但我們當中總要有人去做什麼？我會把你留在我的公羊圈裡，小"}, {"type": "subtitle", "time": 9390.75, "timestamp": "02:36:30", "text": "局外人。等等，什麼？爬上來"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "。不，不，不，不。"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "不要"}]
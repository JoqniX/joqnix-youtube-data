[{"type": "subtitle", "time": 24395.75, "timestamp": "06:46:35", "text": "我回來了。我回來了。我的"}, {"type": "subtitle", "time": 24397.708, "timestamp": "06:46:37", "text": "天哪，我回來了。讓我來"}, {"type": "subtitle", "time": 24405.59, "timestamp": "06:46:45", "text": "談談《我的天哪，我回來了》。我"}, {"type": "subtitle", "time": 24409.91, "timestamp": "06:46:49", "text": "錯過了什麼？你錯過了。"}, {"type": "subtitle", "time": 24411.59, "timestamp": "06:46:51", "text": "沒有什麼。其實你什麼都沒錯過"}, {"type": "subtitle", "time": 24413.27, "timestamp": "06:46:53", "text": "。"}, {"type": "subtitle", "time": 24415.11, "timestamp": "06:46:55", "text": "哦"}]
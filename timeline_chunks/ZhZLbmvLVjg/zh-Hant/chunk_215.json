[{"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "沒關係。我必須戰勝它。下車。下車。下車。  哦，快下車。下車。"}, {"type": "subtitle", "time": 12941.429, "timestamp": "03:35:41", "text": "好的。我的天哪，我差點就死了。"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "請務必"}, {"type": "subtitle", "time": 12954.07, "timestamp": "03:35:54", "text": "。"}]
[{"type": "subtitle", "time": 39373.83, "timestamp": "10:56:13", "text": "謝謝。  順便說一句，這是喬的主意。  哦真的嗎？  他媽的。  這是喬的主意。  好的。好的。"}, {"type": "subtitle", "time": 39378.39, "timestamp": "10:56:18", "text": "我的意思是，"}, {"type": "subtitle", "time": 39414.23, "timestamp": "10:56:54", "text": "我確實加了一點進去。  你們玩嗎？好的，我這就結束。  好了，我們今天就到這裡。你好"}]
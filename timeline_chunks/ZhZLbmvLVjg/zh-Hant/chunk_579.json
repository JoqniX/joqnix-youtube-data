[{"type": "subtitle", "time": 34740.51, "timestamp": "09:39:00", "text": "跳嗎？  A. 她困了。  [音樂] 我們去讀書吧？  我們走吧？"}, {"type": "subtitle", "time": 34749.79, "timestamp": "09:39:09", "text": "我會盡力。  現在。是的。當然可以。由你決定。  我一直都是這樣。  由你決定。是的。嗯。"}, {"type": "subtitle", "time": 34759.39, "timestamp": "09:39:19", "text": "我目前"}, {"type": "subtitle", "time": 34766.15, "timestamp": "09:39:26", "text": "不符合加入風險投資公司的資格。  他這話是什麼意思？你這話是"}, {"type": "subtitle", "time": 34769.03, "timestamp": "09:39:29", "text": "什麼意思？嗯？  加入此行屬於"}, {"type": "subtitle", "time": 34774.83, "timestamp": "09:39:34", "text": "違法行為。  還有幾場比賽？"}, {"type": "subtitle", "time": 34777.83, "timestamp": "09:39:37", "text": "我"}]
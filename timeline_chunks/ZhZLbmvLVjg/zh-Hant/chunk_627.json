[{"type": "subtitle", "time": 37622.87, "timestamp": "10:27:02", "text": "城市，一個 AR。  我的天啊。  還剩一個敵人。  她當時挂機了，老兄。"}, {"type": "subtitle", "time": 37630.87, "timestamp": "10:27:10", "text": "我喜歡這種膚質。"}, {"type": "subtitle", "time": 37633.51, "timestamp": "10:27:13", "text": "我不應該跳過這段音樂，對吧？是的。光譜皮膚。是的，當然"}, {"type": "subtitle", "time": 37654.87, "timestamp": "10:27:34", "text": "。我昨天在店裡看到過。"}, {"type": "subtitle", "time": 37669.586, "timestamp": "10:27:49", "text": "我本來想買它，但我"}]
[{"type": "subtitle", "time": 24007.03, "timestamp": "06:40:07", "text": "你真的在等我，你知道嗎，"}, {"type": "subtitle", "time": 24010.468, "timestamp": "06:40:10", "text": "我第一個看到你，我第一個看到你，"}, {"type": "subtitle", "time": 24013.27, "timestamp": "06:40:13", "text": "所以我就…我的天哪。"}, {"type": "subtitle", "time": 24029.868, "timestamp": "06:40:29", "text": "我們可以在"}, {"type": "subtitle", "time": 24032.708, "timestamp": "06:40:32", "text": "新加坡比賽嗎？這樣可以嗎？"}, {"type": "subtitle", "time": 24035.99, "timestamp": "06:40:35", "text": "「所以，我選 01，"}, {"type": "subtitle", "time": 24038.628, "timestamp": "06:40:38", "text": "因為我覺得他能打新加坡。 是的"}, {"type": "subtitle", "time": 24041.67, "timestamp": "06:40:41", "text": "。呃，我可能會說，別對我抱"}, {"type": "subtitle", "time": 24043.868, "timestamp": "06:40:43", "text": "太大期望，就像一隻高貴的豬說的那樣。"}, {"type": "subtitle", "time": 24046.628, "timestamp": "06:40:46", "text": "我們該怎麼辦？我們還要再看一場嗎"}]
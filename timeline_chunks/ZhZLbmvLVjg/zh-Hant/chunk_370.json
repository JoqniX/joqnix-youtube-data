[{"type": "subtitle", "time": 22206.548, "timestamp": "06:10:06", "text": "忘了發推特。那我就這麼做吧。我很抱歉。所以，讓我來解決這個問題。"}, {"type": "subtitle", "time": 22213.35, "timestamp": "06:10:13", "text": "你最近怎麼樣？赫拉克勒斯，"}, {"type": "subtitle", "time": 22216.51, "timestamp": "06:10:16", "text": "你"}, {"type": "subtitle", "time": 22235.11, "timestamp": "06:10:35", "text": "最近怎麼樣？你們最近怎麼樣？歡迎。  [音樂]"}, {"type": "subtitle", "time": 22245.628, "timestamp": "06:10:45", "text": "嗨。你好。去。去"}, {"type": "subtitle", "time": 22254.15, "timestamp": "06:10:54", "text": "。"}, {"type": "subtitle", "time": 22257.708, "timestamp": "06:10:57", "text": "呃，剛才有客人來，我家人"}]
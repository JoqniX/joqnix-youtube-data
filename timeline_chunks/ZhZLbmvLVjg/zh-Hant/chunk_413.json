[{"type": "subtitle", "time": 24811.51, "timestamp": "06:53:31", "text": "一個標籤。兄弟，就連你的"}, {"type": "subtitle", "time": 24815.19, "timestamp": "06:53:35", "text": "貝爾·克羅薩都有綠頭髮。不，不，不。"}, {"type": "subtitle", "time": 24818.15, "timestamp": "06:53:38", "text": "她戴著一頂綠色的帽子。它不會讓"}, {"type": "subtitle", "time": 24821.31, "timestamp": "06:53:41", "text": "頭髮變綠。不，不，"}, {"type": "subtitle", "time": 24839.23, "timestamp": "06:53:59", "text": "我需要一扇窗戶"}]
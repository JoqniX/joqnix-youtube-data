[{"type": "subtitle", "time": 25286.708, "timestamp": "07:01:26", "text": "哦，他把它幹掉了。我簡直無法形容我的"}, {"type": "subtitle", "time": 25290.03, "timestamp": "07:01:30", "text": "天哪。  說實話，挺有意思的"}, {"type": "subtitle", "time": 25302.708, "timestamp": "07:01:42", "text": "。我的意思是，aka An 真的"}, {"type": "subtitle", "time": 25305.67, "timestamp": "07:01:45", "text": "太棒了。至上主義者。我的天啊。  陰謀。  我的天啊。  我的天啊。難道"}, {"type": "subtitle", "time": 25314.468, "timestamp": "07:01:54", "text": "我沒看見我們嗎？"}, {"type": "subtitle", "time": 25317.67, "timestamp": "07:01:57", "text": "GG。 GG。好的。好的。我覺得我們可以像排演"}]
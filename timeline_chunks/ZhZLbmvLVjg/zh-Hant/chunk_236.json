[{"type": "subtitle", "time": 14206.87, "timestamp": "03:56:46", "text": "吸血鬼》漫畫的時候，作者就開始創作那部漫畫了。所以我只讀了"}, {"type": "subtitle", "time": 14209.11, "timestamp": "03:56:49", "text": "兩章。是的，只有兩章"}, {"type": "subtitle", "time": 14211.99, "timestamp": "03:56:51", "text": "。那次她就是作者本人，作者正在寫這本書。自從我沒讀過之後，我記得"}, {"type": "subtitle", "time": 14214.229, "timestamp": "03:56:54", "text": "它好像有多少本？讓我查一下。  是的。是的。 《吸血鬼》一共有"}]
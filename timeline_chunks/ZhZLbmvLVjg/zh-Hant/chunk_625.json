[{"type": "subtitle", "time": 37512.99, "timestamp": "10:25:12", "text": "錄音。我的天啊。我為什麼會走下甲板？我的天哪，甲板。我的天啊。我們不會有煙，對吧？什麼樣的人？我的天啊。  他玩了"}, {"type": "subtitle", "time": 37528.63, "timestamp": "10:25:28", "text": "三次雞蛋。我去。  我去開雨刮器。"}, {"type": "subtitle", "time": 37531.51, "timestamp": "10:25:31", "text": "我其實不玩"}, {"type": "subtitle", "time": 37535.67, "timestamp": "10:25:35", "text": "毒蛇這個角色。"}, {"type": "subtitle", "time": 37537.51, "timestamp": "10:25:37", "text": "所以如果我表現"}, {"type": "subtitle", "time": 37545.67, "timestamp": "10:25:45", "text": "很差，也沒關係。請原諒我。 Nuki，也"}, {"type": "subtitle", "time": 37554.95, "timestamp": "10:25:54", "text": "祝你新年快樂。你好。好的。  哦，等等。是的。然後因為我說了句“笨蛋”，"}]
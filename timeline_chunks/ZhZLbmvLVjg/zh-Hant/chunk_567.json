[{"type": "subtitle", "time": 34022.83, "timestamp": "09:27:02", "text": "我這就回去看看情況。"}, {"type": "subtitle", "time": 34032.71, "timestamp": "09:27:12", "text": "啊，他們結束了。他們在這邊。我的天哪，我可能會冒生命危險。  我的天啊。那是誰幹的？"}, {"type": "subtitle", "time": 34043.83, "timestamp": "09:27:23", "text": "我們走吧。"}, {"type": "subtitle", "time": 34064.07, "timestamp": "09:27:44", "text": "不是我。什麼？已種下穗。是的，我會"}, {"type": "subtitle", "time": 34066.07, "timestamp": "09:27:46", "text": "盡力贏。我們"}, {"type": "subtitle", "time": 34079.19, "timestamp": "09:27:59", "text": "走吧。是的。  [掌聲] 我的天哪。  是的，我認識我們兄弟。哦，"}]
[{"type": "subtitle", "time": 37817.266, "timestamp": "10:30:17", "text": "咱們從後面操他們。為什麼不"}, {"type": "subtitle", "time": 37822.07, "timestamp": "10:30:22", "text": "呢？"}, {"type": "subtitle", "time": 37824.79, "timestamp": "10:30:24", "text": "啊，簽名。  嗯，好的。好的。你想要皮膚嗎？不。"}, {"type": "subtitle", "time": 37828.23, "timestamp": "10:30:28", "text": "紅色和主要幻影。冠軍。幻影。冠軍。  資金削減。  是的。你好，菲諾薩。"}, {"type": "subtitle", "time": 37834.426, "timestamp": "10:30:34", "text": "你今天怎麼樣？  我的天啊。  我可以看到。  什麼？"}, {"type": "subtitle", "time": 37850.03, "timestamp": "10:30:50", "text": "我幫不了"}, {"type": "subtitle", "time": 37858.87, "timestamp": "10:30:58", "text": "你。我"}]
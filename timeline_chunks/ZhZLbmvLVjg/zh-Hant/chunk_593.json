[{"type": "subtitle", "time": 35591.51, "timestamp": "09:53:11", "text": "？  我們知道嗎"}, {"type": "subtitle", "time": 35595.99, "timestamp": "09:53:15", "text": "？我不知道。  30秒。一秒鐘。等等"}, {"type": "subtitle", "time": 35601.906, "timestamp": "09:53:21", "text": "，我們還要再等等。稍等片刻。"}, {"type": "subtitle", "time": 35608.19, "timestamp": "09:53:28", "text": "哦，你可以為團隊做這件事。  我認為他輪換了位置。  哦，這他媽什麼"}, {"type": "subtitle", "time": 35628.39, "timestamp": "09:53:48", "text": "鬼？  為什麼？為什麼？  再見。拜拜，兄弟。"}, {"type": "subtitle", "time": 35637.35, "timestamp": "09:53:57", "text": "沒關係。沒關係。  沒關係。你盡力了"}]
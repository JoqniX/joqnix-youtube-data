[{"type": "subtitle", "time": 29043.91, "timestamp": "08:04:03", "text": "？卡特里娜。哇。  卡特里娜"}, {"type": "subtitle", "time": 29069.43, "timestamp": "08:04:29", "text": "你什麼時候有空告訴我一聲"}, {"type": "subtitle", "time": 29089.99, "timestamp": "08:04:49", "text": "范恩在這裡等著呢。  你好"}, {"type": "subtitle", "time": 29092.468, "timestamp": "08:04:52", "text": "，範。  你好。  你好。我"}, {"type": "subtitle", "time": 29095.91, "timestamp": "08:04:55", "text": "該買嗎？我不"}]
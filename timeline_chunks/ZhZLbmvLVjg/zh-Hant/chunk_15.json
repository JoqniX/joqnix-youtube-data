[{"type": "subtitle", "time": 900.99, "timestamp": "00:15:00", "text": "、使用者名稱"}, {"type": "subtitle", "time": 904.269, "timestamp": "00:15:04", "text": "和個人資料。於是我想到了一個瘋狂的主意。它就像在圖片上加上浮水印一樣。我將在我的三個直播平台上分別展示三張圖片。"}, {"type": "subtitle", "time": 918.59, "timestamp": "00:15:18", "text": "YouTube、Twitch 和其他平台都在直播。"}, {"type": "subtitle", "time": 926.31, "timestamp": "00:15:26", "text": "你好。另外，我還想使用 API 取得直播"}, {"type": "subtitle", "time": 930.99, "timestamp": "00:15:30", "text": "串流的縮圖"}, {"type": "subtitle", "time": 934.15, "timestamp": "00:15:34", "text": "。給我"}, {"type": "subtitle", "time": 940.069, "timestamp": "00:15:40", "text": "像橫幅上那樣的圖案"}, {"type": "subtitle", "time": 944.71, "timestamp": "00:15:44", "text": "。你可以看到"}]
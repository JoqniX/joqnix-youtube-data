[{"type": "subtitle", "time": 8464.95, "timestamp": "02:21:04", "text": "等等。  等等，也讓我跟他談談"}, {"type": "subtitle", "time": 8468.309, "timestamp": "02:21:08", "text": "。你看到地上的那個人了嗎？他需要重啟。我不想失去我的手。我很害怕。他讓[音樂]重獲"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "？  你的槍法怎麼這麼準？  他的槍法怎麼這麼"}]
[{"type": "subtitle", "time": 20165.31, "timestamp": "05:36:05", "text": "愉快，D？希望你度過了一個"}, {"type": "subtitle", "time": 20184.15, "timestamp": "05:36:24", "text": "愉快的萬聖節。我沒跟你講個小"}, {"type": "subtitle", "time": 20198.47, "timestamp": "05:36:38", "text": "笑話。"}, {"type": "subtitle", "time": 20201.43, "timestamp": "05:36:41", "text": "希望你一切都好。今天也是我一位前輩的生日。哦，"}, {"type": "subtitle", "time": 20215.27, "timestamp": "05:36:55", "text": "祝[音樂]前輩生日快樂。是的。  是的。請像送我的生日祝福一樣把它們送出去。 [音樂] 哼哼。 M：它真的非常舒服。然後"}, {"type": "subtitle", "time": 20217.23, "timestamp": "05:36:57", "text": "當你感覺像晚上一樣"}, {"type": "subtitle", "time": 20219.548, "timestamp": "05:36:59", "text": "難熬的時候，你可以低下頭，像這樣跑起來"}]
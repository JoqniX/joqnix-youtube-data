[{"type": "subtitle", "time": 28026.388, "timestamp": "07:47:06", "text": "。哦，這他媽什麼鬼"}, {"type": "subtitle", "time": 28029.19, "timestamp": "07:47:09", "text": "？"}, {"type": "subtitle", "time": 28035.51, "timestamp": "07:47:15", "text": "我不知道。  我們現在真的身處一條溪流中。  等等，她走了嗎？  不，"}, {"type": "subtitle", "time": 28039.11, "timestamp": "07:47:19", "text": "我沒看到你們倆。  沒關係。"}, {"type": "subtitle", "time": 28048.31, "timestamp": "07:47:28", "text": "如果你願意，可以加入我們。  是的。是的"}, {"type": "subtitle", "time": 28060.468, "timestamp": "07:47:40", "text": "，你可以加入我們。  我"}, {"type": "subtitle", "time": 28063.35, "timestamp": "07:47:43", "text": "的天啊。"}, {"type": "subtitle", "time": 28071.35, "timestamp": "07:47:51", "text": "我們還以為是口井呢。是的。"}, {"type": "subtitle", "time": 28073.43, "timestamp": "07:47:53", "text": "你盡力了嗎？我的天啊。  我的天啊。"}]
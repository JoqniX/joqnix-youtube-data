[{"type": "subtitle", "time": 6785.35, "timestamp": "01:53:05", "text": "總之，這沒什麼"}, {"type": "subtitle", "time": 6790.149, "timestamp": "01:53:10", "text": "私人恩怨。  生意就是生意。哦，不。你打算怎麼處置克萊門汀？餵。  餵。這裡"}, {"type": "subtitle", "time": 6819.47, "timestamp": "01:53:39", "text": "沒有人類的天空。這不僅是時尚，"}, {"type": "subtitle", "time": 6829.189, "timestamp": "01:53:49", "text": "更是金錢和複雜性的問題"}]
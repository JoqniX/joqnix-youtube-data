[{"type": "subtitle", "time": 21509.788, "timestamp": "05:58:29", "text": "大家萬聖節快樂，歡迎來到…（這裡疑似拼字錯誤，無法翻譯）感謝你成為我的星靈，這是我從我這邊得到的第一個建議，就像星靈守護者一樣。 Suki，謝謝Zuki"}, {"type": "subtitle", "time": 21512.788, "timestamp": "05:58:32", "text": "今天過來。這真的對"}, {"type": "subtitle", "time": 21521.15, "timestamp": "05:58:41", "text": "我意義重大"}, {"type": "subtitle", "time": 21523.75, "timestamp": "05:58:43", "text": "。非常感謝你的"}, {"type": "subtitle", "time": 21531.67, "timestamp": "05:58:51", "text": "光臨。萬聖節快樂。然後是帕爾。謝謝你，朋友。謝謝光臨。這真的對我意義重大。萬聖節快樂。  達米甚。謝謝光臨。萬聖節快樂。非常非常"}]
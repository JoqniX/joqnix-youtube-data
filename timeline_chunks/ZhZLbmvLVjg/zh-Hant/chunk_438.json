[{"type": "subtitle", "time": 26310.23, "timestamp": "07:18:30", "text": "我會看中場。盡量別死。他說這裡用了"}, {"type": "subtitle", "time": 26313.11, "timestamp": "07:18:33", "text": "誘餌。  敵人眾多。  誘餌逃脫指控。"}, {"type": "subtitle", "time": 26317.59, "timestamp": "07:18:37", "text": "別惹我。  哦，他們都在這裡。是的，他們排名中等。  中。  我的天啊。中。他們為什麼會選擇"}, {"type": "subtitle", "time": 26322.788, "timestamp": "07:18:42", "text": "白羊座？  什麼"}, {"type": "subtitle", "time": 26324.788, "timestamp": "07:18:44", "text": "？上次"}]
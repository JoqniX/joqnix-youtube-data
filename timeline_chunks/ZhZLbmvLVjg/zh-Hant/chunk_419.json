[{"type": "subtitle", "time": 25143.15, "timestamp": "06:59:03", "text": "好的。你做得很好。任在哪裡"}, {"type": "subtitle", "time": 25158.67, "timestamp": "06:59:18", "text": "[掌聲]"}, {"type": "subtitle", "time": 25160.67, "timestamp": "06:59:20", "text": "推薦我和"}, {"type": "subtitle", "time": 25163.75, "timestamp": "06:59:23", "text": "阿尼庫納一對一。我沒有要殺"}, {"type": "subtitle", "time": 25179.51, "timestamp": "06:59:39", "text": "[笑聲]"}, {"type": "subtitle", "time": 25182.31, "timestamp": "06:59:42", "text": "我的天哪。行人。為什麼？我打了她。我打中了"}, {"type": "subtitle", "time": 25186.39, "timestamp": "06:59:46", "text": "她的頭。雙關語讓我很惱火。"}, {"type": "subtitle", "time": 25188.07, "timestamp": "06:59:48", "text": "如何？"}, {"type": "subtitle", "time": 25189.67, "timestamp": "06:59:49", "text": "我還沒做呢。我的"}]
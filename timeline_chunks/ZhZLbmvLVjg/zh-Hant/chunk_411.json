[{"type": "subtitle", "time": 24663.31, "timestamp": "06:51:03", "text": "讓我問問"}, {"type": "subtitle", "time": 24665.07, "timestamp": "06:51:05", "text": "他，"}, {"type": "subtitle", "time": 24679.27, "timestamp": "06:51:19", "text": "來嗎？等待。我覺得雷南應該會加入"}, {"type": "subtitle", "time": 24689.83, "timestamp": "06:51:29", "text": "不過沒關係。"}, {"type": "subtitle", "time": 24692.35, "timestamp": "06:51:32", "text": "我們不必為此擔心。有人會背"}]
[{"type": "subtitle", "time": 27061.11, "timestamp": "07:31:01", "text": "哦，原來是死皮。  好的"}, {"type": "subtitle", "time": 27065.91, "timestamp": "07:31:05", "text": "。那是守護者嗎？決不。那是。  哇。"}, {"type": "subtitle", "time": 27069.75, "timestamp": "07:31:09", "text": "嘿，Sh。  是的。  死的。"}, {"type": "subtitle", "time": 27076.468, "timestamp": "07:31:16", "text": "我的模型怎麼了？我的天啊。是的，我……我"}, {"type": "subtitle", "time": 27090.31, "timestamp": "07:31:30", "text": "不是……"}, {"type": "subtitle", "time": 27092.23, "timestamp": "07:31:32", "text": "我好像搞砸了一些聊天"}, {"type": "subtitle", "time": 27095.19, "timestamp": "07:31:35", "text": "。我回來了。我剛吃過飯。  哦，"}, {"type": "subtitle", "time": 27097.15, "timestamp": "07:31:37", "text": "好，好，好。"}, {"type": "subtitle", "time": 27116.07, "timestamp": "07:31:56", "text": "現在就吃你的飯吧。  現在對你來說已經很晚了吧？我錯過了什麼？ 小心點"}]
[{"type": "subtitle", "time": 18247.31, "timestamp": "05:04:07", "text": "[音樂] 是"}, {"type": "subtitle", "time": 18255.02, "timestamp": "05:04:15", "text": "的"}, {"type": "subtitle", "time": 18258.99, "timestamp": "05:04:18", "text": "。我很少查看我的訂閱人數，因為我知道當你太在意數字時，你會覺得"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "自己沒有成長，沒有做好這個，沒有做好那個。很多人都跟我說過要多"}]
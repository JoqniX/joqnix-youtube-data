[{"type": "subtitle", "time": 37561.11, "timestamp": "10:26:01", "text": "然後我就獨自離開了，就像那樣"}, {"type": "subtitle", "time": 37562.95, "timestamp": "10:26:02", "text": "。嗯"}, {"type": "subtitle", "time": 37565.23, "timestamp": "10:26:05", "text": "。"}, {"type": "subtitle", "time": 37567.67, "timestamp": "10:26:07", "text": "然後我想到了很多可以搭配的組合。"}, {"type": "subtitle", "time": 37571.51, "timestamp": "10:26:11", "text": "我們走嗎？  哦好的。是的。是的。印地語裡有一個詞叫 takya kalam。那是什麼？  這就像摩根·弗里曼要來給你的主人配音一樣"}, {"type": "subtitle", "time": 37608.31, "timestamp": "10:26:48", "text": "。"}, {"type": "subtitle", "time": 37615.746, "timestamp": "10:26:55", "text": "Lord [音樂] 哦不"}, {"type": "subtitle", "time": 37619.746, "timestamp": "10:26:59", "text": "，我只有 22 點 HP。  AR 一座"}]
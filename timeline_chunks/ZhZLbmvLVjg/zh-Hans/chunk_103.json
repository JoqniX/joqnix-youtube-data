[{"type": "subtitle", "time": 6200.35, "timestamp": "01:43:20", "text": "啊，如果Sky是个温柔的男孩，那就深呼吸吧。停止"}, {"type": "subtitle", "time": 6204.91, "timestamp": "01:43:24", "text": "呼吸。我知道为什么凯伊总是"}, {"type": "subtitle", "time": 6208.629, "timestamp": "01:43:28", "text": "呃，他拒绝被叫做软弱的男孩。我"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "不知道。他听起来确实像个温柔的人。"}, {"type": "subtitle", "time": 6212.43, "timestamp": "01:43:32", "text": "男生"}, {"type": "subtitle", "time": 6216.43, "timestamp": "01:43:36", "text": "尽管。他得到了那个软弱的男孩"}, {"type": "subtitle", "time": 6226.149, "timestamp": "01:43:46", "text": "他不会死。别死。别死。"}, {"type": "subtitle", "time": 6227.75, "timestamp": "01:43:47", "text": "别死。别死。别死。不"}, {"type": "subtitle", "time": 6229.6, "timestamp": "01:43:49", "text": "死。别死。别死。不 死。别死。别死。不"}]
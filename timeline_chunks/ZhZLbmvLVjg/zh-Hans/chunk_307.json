[{"type": "subtitle", "time": 18434.91, "timestamp": "05:07:14", "text": "哦，我的"}, {"type": "subtitle", "time": 18446.35, "timestamp": "05:07:26", "text": "[音乐]"}, {"type": "subtitle", "time": 18450.31, "timestamp": "05:07:30", "text": "嘿。我的天哪。所以，呃，有人有吗？"}, {"type": "subtitle", "time": 18455.47, "timestamp": "05:07:35", "text": "神志之后"}, {"type": "subtitle", "time": 18471.19, "timestamp": "05:07:51", "text": "好的。好吧。所以，呃，但我正在获得"}, {"type": "subtitle", "time": 18474.15, "timestamp": "05:07:54", "text": "心不在焉地向上走。那很糟糕。我不应该"}, {"type": "subtitle", "time": 18476.11, "timestamp": "05:07:56", "text": "在"}, {"type": "subtitle", "time": 18479.11, "timestamp": "05:07:59", "text": "溪流。恐怖故事。好的。我们开始吧"}]
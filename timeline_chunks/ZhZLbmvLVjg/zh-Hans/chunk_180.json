[{"type": "subtitle", "time": 10800.95, "timestamp": "03:00:00", "text": "我终于明白什么是绒毛了。什么是"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "对不起。我忘了。我会解释的。"}, {"type": "subtitle", "time": 10808.349, "timestamp": "03:00:08", "text": "我要上场比赛了。等待，"}, {"type": "subtitle", "time": 10810.79, "timestamp": "03:00:10", "text": "什么？你说你忘了你的"}, {"type": "subtitle", "time": 10817.07, "timestamp": "03:00:17", "text": "角色卡。我们需要帮忙"}, {"type": "subtitle", "time": 10820.59, "timestamp": "03:00:20", "text": "他。角色在哪里？"}, {"type": "subtitle", "time": 10823.87, "timestamp": "03:00:23", "text": "那张纸"}, {"type": "subtitle", "time": 10832.349, "timestamp": "03:00:32", "text": "自鸣得意就是爆炸"}, {"type": "subtitle", "time": 10847.83, "timestamp": "03:00:47", "text": "砰。为什么这是根电线？"}, {"type": "subtitle", "time": 10850.03, "timestamp": "03:00:50", "text": "就像被困住了"}, {"type": "subtitle", "time": 10852.79, "timestamp": "03:00:52", "text": "那里？这应该是相关的"}]
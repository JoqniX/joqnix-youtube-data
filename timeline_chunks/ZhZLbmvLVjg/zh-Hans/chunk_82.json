[{"type": "subtitle", "time": 4935.11, "timestamp": "01:22:15", "text": "我记得我经常把它们调得很重。"}, {"type": "subtitle", "time": 4937.11, "timestamp": "01:22:17", "text": "他们把所有东西都清理干净了。"}, {"type": "subtitle", "time": 4939.27, "timestamp": "01:22:19", "text": "力量。拥有行动自由。他们看起来"}, {"type": "subtitle", "time": 4941.07, "timestamp": "01:22:21", "text": "好的。确实如此。"}, {"type": "subtitle", "time": 4944.51, "timestamp": "01:22:24", "text": "他们。瘟疫。我记得"}, {"type": "subtitle", "time": 4947.83, "timestamp": "01:22:27", "text": "现在。每个人都在死去。他们认为他们"}, {"type": "subtitle", "time": 4949.83, "timestamp": "01:22:29", "text": "差不多就这些了。他们什么也没做。手表"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "我的家人为了我们而牺牲。我做不到。"}, {"type": "subtitle", "time": 4956.07, "timestamp": "01:22:36", "text": "为了救他们，什么都愿意做。妈妈，你可以"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "请帮帮我。我们仍然可以去我们的"}, {"type": "subtitle", "time": 4959.51, "timestamp": "01:22:39", "text": "并排在一起。人类的性格"}, {"type": "subtitle", "time": 4963.229, "timestamp": "01:22:43", "text": "以及我爱的人们。"}, {"type": "subtitle", "time": 4969.629, "timestamp": "01:22:49", "text": "记忆。"}]
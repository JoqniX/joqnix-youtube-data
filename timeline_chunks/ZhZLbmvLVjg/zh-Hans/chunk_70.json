[{"type": "subtitle", "time": 4221.07, "timestamp": "01:10:21", "text": "哦，我需要这样走。"}, {"type": "subtitle", "time": 4223.55, "timestamp": "01:10:23", "text": "好的，过来"}, {"type": "subtitle", "time": 4227.03, "timestamp": "01:10:27", "text": "后退。我不会，我不会，我不在乎"}, {"type": "subtitle", "time": 4229.229, "timestamp": "01:10:29", "text": "就在我发电厂附近。"}, {"type": "subtitle", "time": 4231.35, "timestamp": "01:10:31", "text": "它又回来了。这是第一个"}, {"type": "subtitle", "time": 4249.99, "timestamp": "01:10:49", "text": "去。所以，呃，这是我唯一能做的"}, {"type": "subtitle", "time": 4252.229, "timestamp": "01:10:52", "text": "找到一个对照组。我们必须找到一种方法"}, {"type": "subtitle", "time": 4253.75, "timestamp": "01:10:53", "text": "不过，还是得想办法进房间。我们来看"}, {"type": "subtitle", "time": 4256.91, "timestamp": "01:10:56", "text": "大约。你好，Yash。"}, {"type": "subtitle", "time": 4259.669, "timestamp": "01:10:59", "text": "沙什。我们四处看看。所以，这将"}]
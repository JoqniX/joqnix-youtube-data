[{"type": "subtitle", "time": 19800.07, "timestamp": "05:30:00", "text": "他们。杰克必须格外注意"}, {"type": "subtitle", "time": 19803.03, "timestamp": "05:30:03", "text": "道路以及路边的一切。他"}, {"type": "subtitle", "time": 19805.27, "timestamp": "05:30:05", "text": "不想冒险撞到阿吉亚"}, {"type": "subtitle", "time": 19806.03, "timestamp": "05:30:06", "text": "荒野"}, {"type": "subtitle", "time": 19809.91, "timestamp": "05:30:09", "text": "弓。他来到了一片树林里。我一定是"}, {"type": "subtitle", "time": 19812.948, "timestamp": "05:30:12", "text": "他心想，差不多了，然后踩下了油门。"}, {"type": "subtitle", "time": 19815.35, "timestamp": "05:30:15", "text": "再用力踩一下踏板。"}, {"type": "subtitle", "time": 19817.708, "timestamp": "05:30:17", "text": "在危险中通过"}, {"type": "subtitle", "time": 19820.548, "timestamp": "05:30:20", "text": "杰克在路边发现了一盏灯"}, {"type": "subtitle", "time": 19823.548, "timestamp": "05:30:23", "text": "灯后面的杆子"}, {"type": "subtitle", "time": 19827.03, "timestamp": "05:30:27", "text": "极。那里有一个牌子，上面写着："}, {"type": "subtitle", "time": 19828.51, "timestamp": "05:30:28", "text": "有气体"}, {"type": "subtitle", "time": 19830.35, "timestamp": "05:30:30", "text": "车站"}, {"type": "subtitle", "time": 19833.948, "timestamp": "05:30:33", "text": "大约一英里远"}, {"type": "subtitle", "time": 19838.23, "timestamp": "05:30:38", "text": "路。他瞥了一眼乐器。"}, {"type": "subtitle", "time": 19841.75, "timestamp": "05:30:41", "text": "仪表盘。这表明那里"}, {"type": "subtitle", "time": 19846.11, "timestamp": "05:30:46", "text": "里面还有气体。"}, {"type": "subtitle", "time": 19849.75, "timestamp": "05:30:49", "text": "坦克。他回头瞥了一眼路牌，发现"}, {"type": "subtitle", "time": 19852.47, "timestamp": "05:30:52", "text": "灯出了点问题。它"}, {"type": "subtitle", "time": 19854.43, "timestamp": "05:30:54", "text": "不断褪色，"}, {"type": "subtitle", "time": 19857.948, "timestamp": "05:30:57", "text": "亮度再次提升。这很奇怪"}]
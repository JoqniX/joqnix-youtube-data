[{"type": "subtitle", "time": 6062.47, "timestamp": "01:41:02", "text": "我错过的回忆"}, {"type": "subtitle", "time": 6066.95, "timestamp": "01:41:06", "text": "呃，1 2 3 4 5 六个内存插槽。所以我们是"}, {"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "就像去把这六个人弄到手一样"}, {"type": "subtitle", "time": 6074.149, "timestamp": "01:41:14", "text": "就像你知道的，今天就到此为止了，但是我们"}, {"type": "subtitle", "time": 6080.229, "timestamp": "01:41:20", "text": "它。欢迎回来，凯伊。我完成了"}, {"type": "subtitle", "time": 6082.83, "timestamp": "01:41:22", "text": "我们正在玩的游戏"}, {"type": "subtitle", "time": 6098.149, "timestamp": "01:41:38", "text": "你的“欢迎回来”是什么意思？你曾是"}, {"type": "subtitle", "time": 6119.79, "timestamp": "01:41:59", "text": "你好。"}]
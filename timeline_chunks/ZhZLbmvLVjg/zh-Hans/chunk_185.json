[{"type": "subtitle", "time": 11107.67, "timestamp": "03:05:07", "text": "我的天哪，我竟然不知道我这么……"}, {"type": "subtitle", "time": 11146.63, "timestamp": "03:05:46", "text": "呃，因为她太优秀了，所以有点咸。"}, {"type": "subtitle", "time": 11149.79, "timestamp": "03:05:49", "text": "没错，没错，没错，没错。那是"}, {"type": "subtitle", "time": 11152.99, "timestamp": "03:05:52", "text": "真的。我喜欢逗他。"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "回去惹他生气，但我害怕"}, {"type": "subtitle", "time": 11157.63, "timestamp": "03:05:57", "text": "也去"}, {"type": "subtitle", "time": 11159.67, "timestamp": "03:05:59", "text": "很多。所以，你知道，我不想去"}]
[{"type": "subtitle", "time": 9603.389, "timestamp": "02:40:03", "text": "机器人。这"}, {"type": "subtitle", "time": 9606.15, "timestamp": "02:40:06", "text": "机器人。机器人。实际上，第一个"}, {"type": "subtitle", "time": 9608.23, "timestamp": "02:40:08", "text": "聊啤酒和你其他事的时间"}, {"type": "subtitle", "time": 9609.83, "timestamp": "02:40:09", "text": "比我表弟还不如。我一直没有这种感觉"}, {"type": "subtitle", "time": 9611.51, "timestamp": "02:40:11", "text": "找到空地来提及直到"}, {"type": "subtitle", "time": 9613.309, "timestamp": "02:40:13", "text": "现在。"}, {"type": "subtitle", "time": 9615.87, "timestamp": "02:40:15", "text": "说实话"}, {"type": "subtitle", "time": 9619.59, "timestamp": "02:40:19", "text": "你们，我所有的朋友，我的偶像朋友们"}, {"type": "subtitle", "time": 9621.91, "timestamp": "02:40:21", "text": "我聊过动漫，他们"}, {"type": "subtitle", "time": 9625.59, "timestamp": "02:40:25", "text": "我们都觉得很奇怪。所以，我当时很喜欢BL（耽美）。"}, {"type": "subtitle", "time": 9627.63, "timestamp": "02:40:27", "text": "G"}, {"type": "subtitle", "time": 9632.63, "timestamp": "02:40:32", "text": "东西，但是，呃，还有这个"}, {"type": "subtitle", "time": 9635.75, "timestamp": "02:40:35", "text": "动漫小组呃，伙计们。他们也是"}, {"type": "subtitle", "time": 9638.95, "timestamp": "02:40:38", "text": "比如，你有一个白色"}, {"type": "subtitle", "time": 9642.309, "timestamp": "02:40:42", "text": "呃，丹丹之类的。所以我就想，更多"}, {"type": "subtitle", "time": 9645.11, "timestamp": "02:40:45", "text": "我能找到一个可以一起讨论的群体吗？"}, {"type": "subtitle", "time": 9647.83, "timestamp": "02:40:47", "text": "这些东西，我终于找到一个了"}, {"type": "subtitle", "time": 9650.79, "timestamp": "02:40:50", "text": "聊聊BL。所以我还在寻找"}, {"type": "subtitle", "time": 9655.15, "timestamp": "02:40:55", "text": "关于GL相关的内容，但我猜我"}, {"type": "subtitle", "time": 9658.19, "timestamp": "02:40:58", "text": "慢慢地"}]
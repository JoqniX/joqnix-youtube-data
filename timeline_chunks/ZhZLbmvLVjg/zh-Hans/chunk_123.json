[{"type": "subtitle", "time": 7387.669, "timestamp": "02:03:07", "text": "正确的。到我这里来。离开。我们没有"}, {"type": "subtitle", "time": 7396.39, "timestamp": "02:03:16", "text": "这里。必须有一些小秘密。"}, {"type": "subtitle", "time": 7398.83, "timestamp": "02:03:18", "text": "这里那里。只有两个，"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "正确的？咱们选Neco吧，因为我们在玩游戏"}, {"type": "subtitle", "time": 7403.75, "timestamp": "02:03:23", "text": "Neco游戏。"}, {"type": "subtitle", "time": 7405.83, "timestamp": "02:03:25", "text": "等等，等等，等等，等等。呃，没锁。"}, {"type": "subtitle", "time": 7413.99, "timestamp": "02:03:33", "text": "停止。剑。武士刀。让我来，"}, {"type": "subtitle", "time": 7416.149, "timestamp": "02:03:36", "text": "让我猜猜。呃，凯，没有"}, {"type": "subtitle", "time": 7417.47, "timestamp": "02:03:37", "text": "修复我的"}, {"type": "subtitle", "time": 7420.31, "timestamp": "02:03:40", "text": "回答。让我来分析一下。"}, {"type": "subtitle", "time": 7423.39, "timestamp": "02:03:43", "text": "分析这两者。"}, {"type": "subtitle", "time": 7426.669, "timestamp": "02:03:46", "text": "好的。剑。你说"}, {"type": "subtitle", "time": 7429.83, "timestamp": "02:03:49", "text": "太极。感觉很可疑，因为，你知道，"}, {"type": "subtitle", "time": 7433.51, "timestamp": "02:03:53", "text": "武士刀总是配有刀鞘。"}, {"type": "subtitle", "time": 7435.589, "timestamp": "02:03:55", "text": "或者，该怎么称呼它呢？我忘了"}, {"type": "subtitle", "time": 7438.31, "timestamp": "02:03:58", "text": "你手里拿着的那个东西"}]
[{"type": "subtitle", "time": 10682.19, "timestamp": "02:58:02", "text": "我需要这样做才能把她带来"}, {"type": "subtitle", "time": 10693.429, "timestamp": "02:58:13", "text": "它。我心想，我那玩意儿在哪儿呢？"}, {"type": "subtitle", "time": 10694.19, "timestamp": "02:58:14", "text": "寻找"}, {"type": "subtitle", "time": 10696.83, "timestamp": "02:58:16", "text": "[音乐]"}, {"type": "subtitle", "time": 10700.469, "timestamp": "02:58:20", "text": "为了？好的，我们来看看。呃，回忆。所以，"}, {"type": "subtitle", "time": 10702.79, "timestamp": "02:58:22", "text": "这就是我想要的。这个地方"}, {"type": "subtitle", "time": 10704.79, "timestamp": "02:58:24", "text": "在那边。"}, {"type": "subtitle", "time": 10709.59, "timestamp": "02:58:29", "text": "那里有一个巨大的蓝绿色霓虹灯招牌"}, {"type": "subtitle", "time": 10712.389, "timestamp": "02:58:32", "text": "那里好像还有一把吉他之类的东西。"}, {"type": "subtitle", "time": 10715.59, "timestamp": "02:58:35", "text": "那边有海报。好的。霓虹灯招牌和"}, {"type": "subtitle", "time": 10716.91, "timestamp": "02:58:36", "text": "一个"}, {"type": "subtitle", "time": 10720.44, "timestamp": "02:58:40", "text": "海报。霓虹灯招牌和海报。"}]
[{"type": "subtitle", "time": 11643.75, "timestamp": "03:14:03", "text": "我们感受到的肉。有一些东西"}, {"type": "subtitle", "time": 11644.67, "timestamp": "03:14:04", "text": "我是"}, {"type": "subtitle", "time": 11648.2, "timestamp": "03:14:08", "text": "丢失的。拿不到。"}, {"type": "subtitle", "time": 11650.469, "timestamp": "03:14:10", "text": "[音乐]"}, {"type": "subtitle", "time": 11652.79, "timestamp": "03:14:12", "text": "因为我在故事里进展得太快了。"}, {"type": "subtitle", "time": 11668.229, "timestamp": "03:14:28", "text": "呃，我到底错过了什么？"}, {"type": "subtitle", "time": 11694.309, "timestamp": "03:14:54", "text": "不，等等。她身上那是什么？她是什么？"}]
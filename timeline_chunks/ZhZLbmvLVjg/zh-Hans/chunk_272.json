[{"type": "subtitle", "time": 16326.189, "timestamp": "04:32:06", "text": "呃，我可以买这个吗？我不知道我有没有。"}, {"type": "subtitle", "time": 16327.79, "timestamp": "04:32:07", "text": "钱"}, {"type": "subtitle", "time": 16330.429, "timestamp": "04:32:10", "text": "很遗憾，我确实有"}, {"type": "subtitle", "time": 16335.55, "timestamp": "04:32:15", "text": "够了，呃，我还没收到。"}, {"type": "subtitle", "time": 16339.229, "timestamp": "04:32:19", "text": "我的工资单"}, {"type": "subtitle", "time": 16342.71, "timestamp": "04:32:22", "text": "但是，呃，我能把它从我的……拿走吗？"}, {"type": "subtitle", "time": 16351.229, "timestamp": "04:32:31", "text": "银行？我今天该做什么？好的，我应该付多少钱？"}, {"type": "subtitle", "time": 16354.07, "timestamp": "04:32:34", "text": "有？我的天哪，我没有，我没有"}, {"type": "subtitle", "time": 16357.59, "timestamp": "04:32:37", "text": "够了。哦，我只有300卢比。"}, {"type": "subtitle", "time": 16361.189, "timestamp": "04:32:41", "text": "在我的银行账户里。哦，游戏是"}, {"type": "subtitle", "time": 16363.469, "timestamp": "04:32:43", "text": "字面上地"}, {"type": "subtitle", "time": 16365.71, "timestamp": "04:32:45", "text": "432."}, {"type": "subtitle", "time": 16369.63, "timestamp": "04:32:49", "text": "喂。我的天哪。我的天哪。"}, {"type": "subtitle", "time": 16371.63, "timestamp": "04:32:51", "text": "嗯。哦"}, {"type": "subtitle", "time": 16375.41, "timestamp": "04:32:55", "text": "上帝。我没想到我竟然会喜欢上它"}, {"type": "subtitle", "time": 16377.389, "timestamp": "04:32:57", "text": "[音乐]"}, {"type": "subtitle", "time": 16379.75, "timestamp": "04:32:59", "text": "嗯，抱歉，爱德华。你有没有穿过衣服？"}]
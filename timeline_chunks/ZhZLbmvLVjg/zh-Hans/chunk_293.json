[{"type": "subtitle", "time": 17585.19, "timestamp": "04:53:05", "text": "呃，这个网络摄像头的位置"}, {"type": "subtitle", "time": 17587.27, "timestamp": "04:53:07", "text": "网络摄像头的位置真的很糟糕"}, {"type": "subtitle", "time": 17589.31, "timestamp": "04:53:09", "text": "或者别的什么。我不知道"}, {"type": "subtitle", "time": 17592.67, "timestamp": "04:53:12", "text": "为什么。是的，我会选择我的战斗平台。"}, {"type": "subtitle", "time": 17596.67, "timestamp": "04:53:16", "text": "是的。好的。好的"}, {"type": "subtitle", "time": 17600.07, "timestamp": "04:53:20", "text": "工作。你知道，呃，老实说，我想要"}, {"type": "subtitle", "time": 17602.15, "timestamp": "04:53:22", "text": "玩个游戏，但我认为我们会的"}, {"type": "subtitle", "time": 17604.948, "timestamp": "04:53:24", "text": "只是闲聊。希望一切顺利。现在，"}, {"type": "subtitle", "time": 17607.35, "timestamp": "04:53:27", "text": "但别担心。考试结束后"}, {"type": "subtitle", "time": 17610.47, "timestamp": "04:53:30", "text": "12月，我会更自由一些。我将"}, {"type": "subtitle", "time": 17612.948, "timestamp": "04:53:32", "text": "像大多数直播一样，"}, {"type": "subtitle", "time": 17615.11, "timestamp": "04:53:35", "text": "一切。说实话，我不知道。"}, {"type": "subtitle", "time": 17618.39, "timestamp": "04:53:38", "text": "事情会如何发展。你了解我。即使"}, {"type": "subtitle", "time": 17620.35, "timestamp": "04:53:40", "text": "是考试，我没有"}, {"type": "subtitle", "time": 17622.708, "timestamp": "04:53:42", "text": "学习。即使这也很重要"}, {"type": "subtitle", "time": 17627.47, "timestamp": "04:53:47", "text": "考试的时候我不复习。我只专注于我的"}, {"type": "subtitle", "time": 17633.03, "timestamp": "04:53:53", "text": "优先事项。疼痛。这是痛苦。"}]
[{"type": "subtitle", "time": 10871.63, "timestamp": "03:01:11", "text": "[音乐]"}, {"type": "subtitle", "time": 10878.63, "timestamp": "03:01:18", "text": "嗯，哦，我明白了。我看到了不善交际的人"}, {"type": "subtitle", "time": 10889.349, "timestamp": "03:01:29", "text": "你。它在哪里？呃，所以我需要找到"}, {"type": "subtitle", "time": 10891.51, "timestamp": "03:01:31", "text": "把角色卡交给那个人"}, {"type": "subtitle", "time": 10893.429, "timestamp": "03:01:33", "text": "那边那个被训斥的孩子"}, {"type": "subtitle", "time": 10897.83, "timestamp": "03:01:37", "text": "他的老师或妈妈。那我需要帮忙。"}, {"type": "subtitle", "time": 10900.59, "timestamp": "03:01:40", "text": "呃，还有谁？我"}, {"type": "subtitle", "time": 10903.67, "timestamp": "03:01:43", "text": "忘了。他喝醉了。我们需要"}, {"type": "subtitle", "time": 10917.67, "timestamp": "03:01:57", "text": "向上。是的。是啊，你读书太多了。"}, {"type": "subtitle", "time": 10919.309, "timestamp": "03:01:59", "text": "那"}]
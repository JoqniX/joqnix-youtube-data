[{"type": "subtitle", "time": 1380.31, "timestamp": "00:23:00", "text": "我也把黑猫算进去了。这"}, {"type": "subtitle", "time": 1382.63, "timestamp": "00:23:02", "text": "一只直猫出现了，然后开始"}, {"type": "subtitle", "time": 1384.63, "timestamp": "00:23:04", "text": "住在这里。所以，那就是五。"}, {"type": "subtitle", "time": 1388.23, "timestamp": "00:23:08", "text": "是的。五只猫。给你的猫起名字。嗯，"}, {"type": "subtitle", "time": 1390.31, "timestamp": "00:23:10", "text": "它们没有一个悲伤的名字，但是"}, {"type": "subtitle", "time": 1394.51, "timestamp": "00:23:14", "text": "给他们取了名字。黑的那个是"}, {"type": "subtitle", "time": 1397.99, "timestamp": "00:23:17", "text": "库罗纳。然后，呃，还有一个白色的，"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "这是一件大事。现在它变成了一个来自"}, {"type": "subtitle", "time": 1403.87, "timestamp": "00:23:23", "text": "一只小猫咪变成了一只大猫"}, {"type": "subtitle", "time": 1408.669, "timestamp": "00:23:28", "text": "小猫。所以我打电话"}, {"type": "subtitle", "time": 1410.91, "timestamp": "00:23:30", "text": "他"}, {"type": "subtitle", "time": 1413.549, "timestamp": "00:23:33", "text": "[音乐]"}, {"type": "subtitle", "time": 1418.27, "timestamp": "00:23:38", "text": "白色的。没有白色。过去是"}, {"type": "subtitle", "time": 1428.39, "timestamp": "00:23:48", "text": "黄色的。是的。你好。"}, {"type": "subtitle", "time": 1431.23, "timestamp": "00:23:51", "text": "你好吗"}, {"type": "subtitle", "time": 1439.789, "timestamp": "00:23:59", "text": "死了。然后然后"}]
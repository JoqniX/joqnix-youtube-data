[{"type": "subtitle", "time": 2820.39, "timestamp": "00:47:00", "text": "克莱门汀。她和那个男的在一起"}, {"type": "subtitle", "time": 2823.39, "timestamp": "00:47:03", "text": "上身穿Blazer外套。我们需要占据上风。"}, {"type": "subtitle", "time": 2825.79, "timestamp": "00:47:05", "text": "也。"}, {"type": "subtitle", "time": 2829.67, "timestamp": "00:47:09", "text": "是的，我们需要找到解决办法。"}, {"type": "subtitle", "time": 2836.23, "timestamp": "00:47:16", "text": "哦，快到那儿去。我觉得这不太好。"}, {"type": "subtitle", "time": 2845.43, "timestamp": "00:47:25", "text": "好的。所以，我们要做什么，我们已经得到了"}, {"type": "subtitle", "time": 2847.39, "timestamp": "00:47:27", "text": "电池。所以，我们要把它给"}, {"type": "subtitle", "time": 2850.19, "timestamp": "00:47:30", "text": "克莱门汀。哦，这个人。他有"}, {"type": "subtitle", "time": 2852.95, "timestamp": "00:47:32", "text": "它。我试着去一家超级VIP店，那里会提供……"}, {"type": "subtitle", "time": 2854.87, "timestamp": "00:47:34", "text": "你能相信吗？我刚才亲眼看到了这个杠杆。"}, {"type": "subtitle", "time": 2856.309, "timestamp": "00:47:36", "text": "纯粹为了好玩？能给我一杯水吗？"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "我会把这个小杠杆给你。哦，我"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "把饮料给你。好了。"}, {"type": "subtitle", "time": 2863.43, "timestamp": "00:47:43", "text": "承诺。好的。谢谢。"}]
[{"type": "subtitle", "time": 5230.189, "timestamp": "01:27:10", "text": "这里。我的天啊。别死在我面前。"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "好吧，我揍你一顿。你得来"}, {"type": "subtitle", "time": 5245.709, "timestamp": "01:27:25", "text": "不，他正从禁区里出来，我们"}, {"type": "subtitle", "time": 5248.87, "timestamp": "01:27:28", "text": "不能。不。"}, {"type": "subtitle", "time": 5266.75, "timestamp": "01:27:46", "text": "我知道权力会获得"}, {"type": "subtitle", "time": 5270.91, "timestamp": "01:27:50", "text": "解。嗯？第二个我可以"}, {"type": "subtitle", "time": 5273.87, "timestamp": "01:27:53", "text": "拿着。"}, {"type": "subtitle", "time": 5275.79, "timestamp": "01:27:55", "text": "嗯？"}]
[{"type": "subtitle", "time": 15781.349, "timestamp": "04:23:01", "text": "更多的。我不知道你是否能意识到"}, {"type": "subtitle", "time": 15784.269, "timestamp": "04:23:04", "text": "我穿的"}, {"type": "subtitle", "time": 15787.67, "timestamp": "04:23:07", "text": "这。有点可爱。看看"}, {"type": "subtitle", "time": 15789.349, "timestamp": "04:23:09", "text": "对着他们。我的意思是，现在这里有个卧室了。"}, {"type": "subtitle", "time": 15793.83, "timestamp": "04:23:13", "text": "还有其他一些东西。我喜欢这种星空的感觉，"}, {"type": "subtitle", "time": 15798.389, "timestamp": "04:23:18", "text": "你知道，黑色和金色主题的"}, {"type": "subtitle", "time": 15802.149, "timestamp": "04:23:22", "text": "金色的，像橙色的，金色主题的星星"}, {"type": "subtitle", "time": 15804.229, "timestamp": "04:23:24", "text": "以及所有的一切。这个房间并不那么……"}, {"type": "subtitle", "time": 15810.309, "timestamp": "04:23:30", "text": "好的。嗯，书里也有。呃，但是我"}, {"type": "subtitle", "time": 15813.189, "timestamp": "04:23:33", "text": "是的，书确实如此。我平时会读书吗？我愿意"}, {"type": "subtitle", "time": 15814.11, "timestamp": "04:23:34", "text": "读"}, {"type": "subtitle", "time": 15817.91, "timestamp": "04:23:37", "text": "有时。所以真的很喜欢。"}, {"type": "subtitle", "time": 15819.79, "timestamp": "04:23:39", "text": "这就是我如此疲惫的原因。非常"}, {"type": "subtitle", "time": 15822.03, "timestamp": "04:23:42", "text": "疲劳的。你睡着了"}, {"type": "subtitle", "time": 15825.07, "timestamp": "04:23:45", "text": "出色地。睡觉"}, {"type": "subtitle", "time": 15829.59, "timestamp": "04:23:49", "text": "出色地。你睡得很好。是的。嗯，因为"}, {"type": "subtitle", "time": 15832.63, "timestamp": "04:23:52", "text": "我今天直播，呃，让我留住你。"}, {"type": "subtitle", "time": 15835.469, "timestamp": "04:23:55", "text": "各位，你们都了解最近发生的事情吗？"}, {"type": "subtitle", "time": 15839.309, "timestamp": "04:23:59", "text": "我忘了我还要做第二项重要任务。"}]
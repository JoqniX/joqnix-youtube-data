[{"type": "subtitle", "time": 4440.87, "timestamp": "01:14:00", "text": "我。滚开。你不想吗？不想"}, {"type": "subtitle", "time": 4444.35, "timestamp": "01:14:04", "text": "你想回家，回到……"}, {"type": "subtitle", "time": 4451.47, "timestamp": "01:14:11", "text": "嗯？这"}, {"type": "subtitle", "time": 4454.79, "timestamp": "01:14:14", "text": "他妈的。那个女人在哪儿？罗伯特，他"}, {"type": "subtitle", "time": 4464.07, "timestamp": "01:14:24", "text": "喂，伙计？他告诉我。她刚才是不是在烦人？"}, {"type": "subtitle", "time": 4481.31, "timestamp": "01:14:41", "text": "巴克。我希望她能照顾好"}, {"type": "subtitle", "time": 4484.39, "timestamp": "01:14:44", "text": "她自己。哦，我疯了。别咬人"}, {"type": "subtitle", "time": 4488.149, "timestamp": "01:14:48", "text": "她走了。不，我会一直挠她，直到她"}]
[{"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "顺便说一句，我们已经把所有这些都完成了。所以，"}, {"type": "subtitle", "time": 7149.91, "timestamp": "01:59:09", "text": "我们只想离开这里。"}, {"type": "subtitle", "time": 7163.589, "timestamp": "01:59:23", "text": "拒绝。还有，我刚才是不是听到那个笑话了？你"}, {"type": "subtitle", "time": 7166.709, "timestamp": "01:59:26", "text": "你说你是姐姐。我就像切换进去一样"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "也是。 M 最悲伤。我两者兼具。是"}, {"type": "subtitle", "time": 7173.669, "timestamp": "01:59:33", "text": "有专门的词来形容这种情况吗？谁既是这两种身份？我"}, {"type": "subtitle", "time": 7174.83, "timestamp": "01:59:34", "text": "不"}, {"type": "subtitle", "time": 7177.189, "timestamp": "01:59:37", "text": "知道。希望有个词可以形容这种情况。我"}, {"type": "subtitle", "time": 7179.83, "timestamp": "01:59:39", "text": "不知道。"}, {"type": "subtitle", "time": 7181.91, "timestamp": "01:59:41", "text": "所以，请看看完全是成年人的世界。"}, {"type": "subtitle", "time": 7185.43, "timestamp": "01:59:45", "text": "先是感觉不安全，然后又像什么都没发生过一样恢复正常。"}, {"type": "subtitle", "time": 7187.16, "timestamp": "01:59:47", "text": "确切地。不是吗？"}, {"type": "subtitle", "time": 7191.229, "timestamp": "01:59:51", "text": "[音乐]"}, {"type": "subtitle", "time": 7193.629, "timestamp": "01:59:53", "text": "凉爽的？它是"}, {"type": "subtitle", "time": 7196.03, "timestamp": "01:59:56", "text": "可爱。这是一个"}, {"type": "subtitle", "time": 7198.87, "timestamp": "01:59:58", "text": "球形可爱。不过看看那只猫"}]
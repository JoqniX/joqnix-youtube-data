[{"type": "subtitle", "time": 2703.47, "timestamp": "00:45:03", "text": "上帝。我的天啊。"}, {"type": "subtitle", "time": 2711.71, "timestamp": "00:45:11", "text": "所以，我们需要找到熔岩。"}, {"type": "subtitle", "time": 2746.95, "timestamp": "00:45:46", "text": "我会去参加朋友们的聚会。"}, {"type": "subtitle", "time": 2749.75, "timestamp": "00:45:49", "text": "即使要熬到深夜，他也愿意这样做。"}, {"type": "subtitle", "time": 2751.589, "timestamp": "00:45:51", "text": "承受令人烦恼的后果"}, {"type": "subtitle", "time": 2754.47, "timestamp": "00:45:54", "text": "第二天早上。很高兴找到快乐"}, {"type": "subtitle", "time": 2757.19, "timestamp": "00:45:57", "text": "尽管地表环境恶劣，不适宜居住。"}, {"type": "subtitle", "time": 2758.79, "timestamp": "00:45:58", "text": "地下生活条件变得"}]
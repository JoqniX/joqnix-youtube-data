[{"type": "subtitle", "time": 19680.948, "timestamp": "05:28:00", "text": "身体的。那是他过去的事了。不"}, {"type": "subtitle", "time": 19683.35, "timestamp": "05:28:03", "text": "无论他开车速度有多快，他"}, {"type": "subtitle", "time": 19685.948, "timestamp": "05:28:05", "text": "无法脱身。"}, {"type": "subtitle", "time": 19689.708, "timestamp": "05:28:09", "text": "内疚是一种危险的"}, {"type": "subtitle", "time": 19695.07, "timestamp": "05:28:15", "text": "感觉。这件事困扰了他好一阵子。"}, {"type": "subtitle", "time": 19699.47, "timestamp": "05:28:19", "text": "年。所以他当时正在开车。"}, {"type": "subtitle", "time": 19702.868, "timestamp": "05:28:22", "text": "远离大城市。他需要一些"}, {"type": "subtitle", "time": 19707.31, "timestamp": "05:28:27", "text": "他按响了号角。 V 的状态"}, {"type": "subtitle", "time": 19709.43, "timestamp": "05:28:29", "text": "威斯康星州被证明是一个优秀的"}, {"type": "subtitle", "time": 19711.99, "timestamp": "05:28:31", "text": "对他来说，这是个选择。杰克的已故父母曾"}, {"type": "subtitle", "time": 19715.59, "timestamp": "05:28:35", "text": "一间不在树林里的小屋。他"}, {"type": "subtitle", "time": 19717.59, "timestamp": "05:28:37", "text": "正朝着那个方向前进"}, {"type": "subtitle", "time": 19720.11, "timestamp": "05:28:40", "text": "为了逃脱一段时间"}, {"type": "subtitle", "time": 19724.23, "timestamp": "05:28:44", "text": "天。困意袭来，他顿时被睡意笼罩。"}, {"type": "subtitle", "time": 19728.15, "timestamp": "05:28:48", "text": "他很难集中注意力"}, {"type": "subtitle", "time": 19730.708, "timestamp": "05:28:50", "text": "道路。他开车开了好几个小时。"}, {"type": "subtitle", "time": 19734.948, "timestamp": "05:28:54", "text": "现在。开车也是他非常喜欢的事情。"}, {"type": "subtitle", "time": 19738.83, "timestamp": "05:28:58", "text": "爱情故事很长。漫长的道路是他的"}]
[{"type": "subtitle", "time": 18841.37, "timestamp": "05:14:01", "text": "生日。快乐的"}, {"type": "subtitle", "time": 18845.47, "timestamp": "05:14:05", "text": "[音乐]"}, {"type": "subtitle", "time": 18847.868, "timestamp": "05:14:07", "text": "生日。你是在即兴发挥吗？"}, {"type": "subtitle", "time": 18854.26, "timestamp": "05:14:14", "text": "哦，所以"}, {"type": "subtitle", "time": 18855.868, "timestamp": "05:14:15", "text": "[音乐]"}, {"type": "subtitle", "time": 18858.83, "timestamp": "05:14:18", "text": "所以，我就是。"}, {"type": "subtitle", "time": 18861.868, "timestamp": "05:14:21", "text": "希望，因为你知道作为一个"}, {"type": "subtitle", "time": 18863.42, "timestamp": "05:14:23", "text": "星座 I"}, {"type": "subtitle", "time": 18871.07, "timestamp": "05:14:31", "text": "我将如星座般闪耀。为什么"}, {"type": "subtitle", "time": 18874.23, "timestamp": "05:14:34", "text": "不是？我认识你，你现在知道了。"}, {"type": "subtitle", "time": 18877.03, "timestamp": "05:14:37", "text": "我喜欢感受星座的力量"}, {"type": "subtitle", "time": 18880.55, "timestamp": "05:14:40", "text": "右边是星星。是的，我会使用"}, {"type": "subtitle", "time": 18884.03, "timestamp": "05:14:44", "text": "愿你幸福快乐"}, {"type": "subtitle", "time": 18887.91, "timestamp": "05:14:47", "text": "瞬间。开心的笑脸。和久步"}, {"type": "subtitle", "time": 18890.27, "timestamp": "05:14:50", "text": "幸福。"}]
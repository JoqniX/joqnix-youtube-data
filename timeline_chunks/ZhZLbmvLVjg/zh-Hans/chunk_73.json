[{"type": "subtitle", "time": 4383.07, "timestamp": "01:13:03", "text": "[掌声]"}, {"type": "subtitle", "time": 4384.83, "timestamp": "01:13:04", "text": "是的。"}, {"type": "subtitle", "time": 4388.35, "timestamp": "01:13:08", "text": "如果你是……，任何东西都可能崩溃。"}, {"type": "subtitle", "time": 4390.03, "timestamp": "01:13:10", "text": "太厉害了。"}, {"type": "subtitle", "time": 4392.91, "timestamp": "01:13:12", "text": "等等，什么？"}, {"type": "subtitle", "time": 4396.51, "timestamp": "01:13:16", "text": "克拉米，你在干什么？"}, {"type": "subtitle", "time": 4398.47, "timestamp": "01:13:18", "text": "克拉米，我们肯定到不了了。"}, {"type": "subtitle", "time": 4400.95, "timestamp": "01:13:20", "text": "发件人一直紧追不舍。可以这样吗？"}, {"type": "subtitle", "time": 4404.07, "timestamp": "01:13:24", "text": "但你必须说我们必须走了。我 我"}, {"type": "subtitle", "time": 4406.11, "timestamp": "01:13:26", "text": "写了。"}, {"type": "subtitle", "time": 4410.31, "timestamp": "01:13:30", "text": "什么？但是，但是，但是，我们谁也不知道。"}, {"type": "subtitle", "time": 4412.07, "timestamp": "01:13:32", "text": "并不是每个人都必须到达那里"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "但我们之中必须有人做什么？我会留住你"}, {"type": "subtitle", "time": 4419.79, "timestamp": "01:13:39", "text": "在我那只小公羊里，一个局外人。等待，"}, {"type": "subtitle", "time": 4422.189, "timestamp": "01:13:42", "text": "什么？爬"}, {"type": "subtitle", "time": 4424.95, "timestamp": "01:13:44", "text": "我。不，不，不，不。不要牺牲"}, {"type": "subtitle", "time": 4426.83, "timestamp": "01:13:46", "text": "你自己。哦，"}, {"type": "subtitle", "time": 4429.07, "timestamp": "01:13:49", "text": "等待。"}, {"type": "subtitle", "time": 4430.669, "timestamp": "01:13:50", "text": "不，"}, {"type": "subtitle", "time": 4433.95, "timestamp": "01:13:53", "text": "蛤。你必须回家"}, {"type": "subtitle", "time": 4437.07, "timestamp": "01:13:57", "text": "我。得回家了"}]
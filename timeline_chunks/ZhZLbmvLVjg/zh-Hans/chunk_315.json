[{"type": "subtitle", "time": 18913.15, "timestamp": "05:15:13", "text": "天哪，外面在放广告。"}, {"type": "subtitle", "time": 18916.83, "timestamp": "05:15:16", "text": "戈梅。好的，我们开始吧"}, {"type": "subtitle", "time": 18920.708, "timestamp": "05:15:20", "text": "读。我来这里是为了偷土。我是"}, {"type": "subtitle", "time": 18935.31, "timestamp": "05:15:35", "text": "你 D. 快乐"}, {"type": "subtitle", "time": 18938.59, "timestamp": "05:15:38", "text": "万圣节。希望你的万圣节过得愉快。"}, {"type": "subtitle", "time": 18943.39, "timestamp": "05:15:43", "text": "D？希望你过得愉快"}, {"type": "subtitle", "time": 18946.59, "timestamp": "05:15:46", "text": "万圣节。一点"}, {"type": "subtitle", "time": 18948.99, "timestamp": "05:15:48", "text": "笑话没讲完"}, {"type": "subtitle", "time": 18952.708, "timestamp": "05:15:52", "text": "你。希望你一切都好。它也是"}, {"type": "subtitle", "time": 18956.15, "timestamp": "05:15:56", "text": "这是我一位前辈的生日。哦，快乐"}, {"type": "subtitle", "time": 18957.84, "timestamp": "05:15:57", "text": "生日快乐"}]
[{"type": "subtitle", "time": 3182.15, "timestamp": "00:53:02", "text": "设置好像我忘了是哪个动漫或什么东西了"}, {"type": "subtitle", "time": 3185.829, "timestamp": "00:53:05", "text": "当时还有一部动画剧集。所以就像"}, {"type": "subtitle", "time": 3190.39, "timestamp": "00:53:10", "text": "天空之上居住着高级贵族"}, {"type": "subtitle", "time": 3193.349, "timestamp": "00:53:13", "text": "呃，贵族们，富人们在底层"}, {"type": "subtitle", "time": 3195.99, "timestamp": "00:53:15", "text": "地下贫民窟里的人们"}, {"type": "subtitle", "time": 3197.39, "timestamp": "00:53:17", "text": "贫穷的"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "生活和喜欢"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "呃，对，我忘了那是哪部动画了。"}, {"type": "subtitle", "time": 3207.03, "timestamp": "00:53:27", "text": "是“没有枪就没有生命”吗？我不知道。"}, {"type": "subtitle", "time": 3209.549, "timestamp": "00:53:29", "text": "感觉不像是“无枪无枪”"}, {"type": "subtitle", "time": 3213.349, "timestamp": "00:53:33", "text": "生活。那完全是另一回事。哪部动漫"}]
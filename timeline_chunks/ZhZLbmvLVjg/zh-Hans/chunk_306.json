[{"type": "subtitle", "time": 18361.03, "timestamp": "05:06:01", "text": "洗发水。哦，等等。它为什么坏了？它是"}, {"type": "subtitle", "time": 18362.67, "timestamp": "05:06:02", "text": "破碎的。它是"}, {"type": "subtitle", "time": 18369.51, "timestamp": "05:06:09", "text": "破碎的。例如，类似这样的"}, {"type": "subtitle", "time": 18371.788, "timestamp": "05:06:11", "text": "这"}, {"type": "subtitle", "time": 18376.39, "timestamp": "05:06:16", "text": "现在。加载。是的。是的。加载。它喜欢"}, {"type": "subtitle", "time": 18379.03, "timestamp": "05:06:19", "text": "彻底坏掉了。为什么是“运动健将”？"}, {"type": "subtitle", "time": 18383.59, "timestamp": "05:06:23", "text": "关键操作？我的天哪。是的。你看，这很好。"}, {"type": "subtitle", "time": 18385.59, "timestamp": "05:06:25", "text": "一切都好，但我需要打开我的"}, {"type": "subtitle", "time": 18387.948, "timestamp": "05:06:27", "text": "嘴巴像"}, {"type": "subtitle", "time": 18389.948, "timestamp": "05:06:29", "text": "啊，喜欢"}, {"type": "subtitle", "time": 18394.23, "timestamp": "05:06:34", "text": "宽的。那更宽。我打不开我的"}, {"type": "subtitle", "time": 18397.99, "timestamp": "05:06:37", "text": "那样的嘴。真奇怪。我就像我"}, {"type": "subtitle", "time": 18400.17, "timestamp": "05:06:40", "text": "稍微"}, {"type": "subtitle", "time": 18401.868, "timestamp": "05:06:41", "text": "[音乐]"}, {"type": "subtitle", "time": 18405.83, "timestamp": "05:06:45", "text": "嘴。我想打开它。真宽。 N"}, {"type": "subtitle", "time": 18408.35, "timestamp": "05:06:48", "text": "这是什么？"}, {"type": "subtitle", "time": 18410.59, "timestamp": "05:06:50", "text": "事物？为什么"}, {"type": "subtitle", "time": 18414.99, "timestamp": "05:06:54", "text": "我为什么非要张嘴呢？"}, {"type": "subtitle", "time": 18419.47, "timestamp": "05:06:59", "text": "让她露面有多难？"}]
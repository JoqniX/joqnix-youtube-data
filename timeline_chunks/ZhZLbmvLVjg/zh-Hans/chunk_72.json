[{"type": "subtitle", "time": 4321.83, "timestamp": "01:12:01", "text": "大门像这样是金属栅栏式的，它是"}, {"type": "subtitle", "time": 4325.11, "timestamp": "01:12:05", "text": "当然，这一切都很容易拆分。但"}, {"type": "subtitle", "time": 4327.79, "timestamp": "01:12:07", "text": "那边的门就像是高度"}, {"type": "subtitle", "time": 4330.55, "timestamp": "01:12:10", "text": "装甲重型物体。你认为"}, {"type": "subtitle", "time": 4336.63, "timestamp": "01:12:16", "text": "不。如果你开始开车，我就走了。"}, {"type": "subtitle", "time": 4337.95, "timestamp": "01:12:17", "text": "地球。"}, {"type": "subtitle", "time": 4351.27, "timestamp": "01:12:31", "text": "家。我的天啊。大家都来了。我是"}, {"type": "subtitle", "time": 4352.709, "timestamp": "01:12:32", "text": "跑步。我在跑步。我在跑步。我是"}, {"type": "subtitle", "time": 4369.47, "timestamp": "01:12:49", "text": "[音乐]"}]
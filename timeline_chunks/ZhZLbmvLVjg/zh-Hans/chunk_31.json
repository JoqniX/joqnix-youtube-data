[{"type": "subtitle", "time": 1871.87, "timestamp": "00:31:11", "text": "坚持，稍等"}, {"type": "subtitle", "time": 1876.269, "timestamp": "00:31:16", "text": "这里。关掉它。去"}, {"type": "subtitle", "time": 1878.43, "timestamp": "00:31:18", "text": "向上。克服"}, {"type": "subtitle", "time": 1891.43, "timestamp": "00:31:31", "text": "这里。哦，我听到电话铃声响了。所以，"}, {"type": "subtitle", "time": 1894.43, "timestamp": "00:31:34", "text": "等待。这次通话正在这样做"}, {"type": "subtitle", "time": 1898.31, "timestamp": "00:31:38", "text": "那？坚持，稍等。让我再吹一次。"}, {"type": "subtitle", "time": 1901.269, "timestamp": "00:31:41", "text": "一秒钟。 Discord在哪里做这件事？"}, {"type": "subtitle", "time": 1906.95, "timestamp": "00:31:46", "text": "对不起。好的。这个。一，二。好的。"}, {"type": "subtitle", "time": 1908.669, "timestamp": "00:31:48", "text": "我们开始吧"}, {"type": "subtitle", "time": 1913.149, "timestamp": "00:31:53", "text": "去。你给我打电话。是的。"}, {"type": "subtitle", "time": 1915.63, "timestamp": "00:31:55", "text": "等待。准备把这个"}, {"type": "subtitle", "time": 1917.389, "timestamp": "00:31:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 19442.39, "timestamp": "05:24:02", "text": "恐怖。概括。一个被他的……所困扰的男人"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "过去到达加油站"}, {"type": "subtitle", "time": 19448.948, "timestamp": "05:24:08", "text": "深夜的乡村公路。"}, {"type": "subtitle", "time": 19451.59, "timestamp": "05:24:11", "text": "他不知道自己带来了什么。"}, {"type": "subtitle", "time": 19455.27, "timestamp": "05:24:15", "text": "他身上有些事，通常会停止。"}, {"type": "subtitle", "time": 19457.03, "timestamp": "05:24:17", "text": "在中间的加油站"}, {"type": "subtitle", "time": 19459.75, "timestamp": "05:24:19", "text": "夜晚变成了一场战斗"}, {"type": "subtitle", "time": 19461.788, "timestamp": "05:24:21", "text": "几个人的生存"}, {"type": "subtitle", "time": 19466.47, "timestamp": "05:24:26", "text": "人们。不到杰克，一切都不会结束。"}, {"type": "subtitle", "time": 19468.55, "timestamp": "05:24:28", "text": "他直面自己的过去，并为之付出代价。"}, {"type": "subtitle", "time": 19470.47, "timestamp": "05:24:30", "text": "已经完成了。"}, {"type": "subtitle", "time": 19474.27, "timestamp": "05:24:34", "text": "只有在那之后，黑暗才终于消散。"}, {"type": "subtitle", "time": 19478.39, "timestamp": "05:24:38", "text": "别管他们。好的，仅限18岁以上。"}, {"type": "subtitle", "time": 19493.51, "timestamp": "05:24:53", "text": "地点。这些话是这样的"}, {"type": "subtitle", "time": 19495.83, "timestamp": "05:24:55", "text": "通过杰克的“等等，我需要转身吗？”"}, {"type": "subtitle", "time": 19497.91, "timestamp": "05:24:57", "text": "关闭背景音乐？你让我"}]
[{"type": "subtitle", "time": 7044.229, "timestamp": "01:57:24", "text": "首先，我喜欢你抓握东西的方式。"}, {"type": "subtitle", "time": 7046.35, "timestamp": "01:57:26", "text": "你对自我的认知是错误的"}, {"type": "subtitle", "time": 7050.589, "timestamp": "01:57:30", "text": "好像我不是那种爱车之人似的"}, {"type": "subtitle", "time": 7053.109, "timestamp": "01:57:33", "text": "那。等等，你说的“感觉”是什么意思？"}, {"type": "subtitle", "time": 7056.79, "timestamp": "01:57:36", "text": "自己？你知道你是什么吗？什么类型的"}, {"type": "subtitle", "time": 7059.229, "timestamp": "01:57:39", "text": "你这个人"}, {"type": "subtitle", "time": 7062.149, "timestamp": "01:57:42", "text": "是和东西吗？"}, {"type": "subtitle", "time": 7064.189, "timestamp": "01:57:44", "text": "哦，是的。"}, {"type": "subtitle", "time": 7074.07, "timestamp": "01:57:54", "text": "正确的？知道自己是什么的人"}]
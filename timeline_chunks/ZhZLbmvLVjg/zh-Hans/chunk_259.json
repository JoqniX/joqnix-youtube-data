[{"type": "subtitle", "time": 15541.26, "timestamp": "04:19:01", "text": "你们也这么做吗？你们都干了什么？"}, {"type": "subtitle", "time": 15543.71, "timestamp": "04:19:03", "text": "[音乐]"}, {"type": "subtitle", "time": 15548.55, "timestamp": "04:19:08", "text": "做？你们今天都做了些什么？呃，"}, {"type": "subtitle", "time": 15551.55, "timestamp": "04:19:11", "text": "遗憾的是，我什么也没做。"}, {"type": "subtitle", "time": 15555.87, "timestamp": "04:19:15", "text": "真的。我当时就想，你知道，就是"}, {"type": "subtitle", "time": 15559.51, "timestamp": "04:19:19", "text": "嗯，我当时就像……我当时就像在做……"}, {"type": "subtitle", "time": 15561.61, "timestamp": "04:19:21", "text": "今天一整天都在忙这些事。"}, {"type": "subtitle", "time": 15566.67, "timestamp": "04:19:26", "text": "[音乐]"}, {"type": "subtitle", "time": 15570.469, "timestamp": "04:19:30", "text": "所以玛雅玛雅，你们喜欢我的新歌吗？"}, {"type": "subtitle", "time": 15574.78, "timestamp": "04:19:34", "text": "我选择穿的衣服"}, {"type": "subtitle", "time": 15579.469, "timestamp": "04:19:39", "text": "[音乐]"}, {"type": "subtitle", "time": 15582.74, "timestamp": "04:19:42", "text": "万圣节？糟糕的服装。"}]
[{"type": "subtitle", "time": 4261.59, "timestamp": "01:11:01", "text": "我认为它就像一辆逃逸车辆。"}, {"type": "subtitle", "time": 4263.87, "timestamp": "01:11:03", "text": "对于某些人来说"}, {"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "原因很简单，这感觉就像一次逃离。"}, {"type": "subtitle", "time": 4283.63, "timestamp": "01:11:23", "text": "不，等等。我需要开门。你"}, {"type": "subtitle", "time": 4287.07, "timestamp": "01:11:27", "text": "真倒霉。我需要打开"}, {"type": "subtitle", "time": 4290.35, "timestamp": "01:11:30", "text": "门。我该怎么做？"}, {"type": "subtitle", "time": 4299.51, "timestamp": "01:11:39", "text": "所以，哦，你得载我一程。好的。"}, {"type": "subtitle", "time": 4301.27, "timestamp": "01:11:41", "text": "好的。我为什么会想到这个？为什么？"}, {"type": "subtitle", "time": 4304.39, "timestamp": "01:11:44", "text": "难道我没想到吗？好的。给"}, {"type": "subtitle", "time": 4305.31, "timestamp": "01:11:45", "text": "我"}, {"type": "subtitle", "time": 4307.75, "timestamp": "01:11:47", "text": "举起。不，你不能撞门。"}, {"type": "subtitle", "time": 4310.669, "timestamp": "01:11:50", "text": "凯。那是一辆重型装甲车"}, {"type": "subtitle", "time": 4313.11, "timestamp": "01:11:53", "text": "门。根本不可能撞上去"}, {"type": "subtitle", "time": 4315.229, "timestamp": "01:11:55", "text": "门。你必须打开它"}, {"type": "subtitle", "time": 4318.79, "timestamp": "01:11:58", "text": "向上。如果它像这样的门，那就用栅栏围起来。"}]
[{"type": "subtitle", "time": 16502.15, "timestamp": "04:35:02", "text": "我第二天需要做什么？我应该做什么？"}, {"type": "subtitle", "time": 16504.91, "timestamp": "04:35:04", "text": "你没有深奥的"}, {"type": "subtitle", "time": 16508.15, "timestamp": "04:35:08", "text": "想法。我头疼。我也是。我"}, {"type": "subtitle", "time": 16511.67, "timestamp": "04:35:11", "text": "应用方式类似于老虎屁股和斧头"}, {"type": "subtitle", "time": 16513.429, "timestamp": "04:35:13", "text": "石油的事，你知道，一起在"}, {"type": "subtitle", "time": 16516.629, "timestamp": "04:35:16", "text": "额头上、脖子上……"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "一切。我的偏头痛越来越严重了。"}, {"type": "subtitle", "time": 16523.67, "timestamp": "04:35:23", "text": "因为我今天只睡了两个小时。呃，我"}, {"type": "subtitle", "time": 16527.07, "timestamp": "04:35:27", "text": "昨天晚上熬夜做了这件事"}, {"type": "subtitle", "time": 16530.789, "timestamp": "04:35:30", "text": "出题人名单。我的天哪。我不"}, {"type": "subtitle", "time": 16532.15, "timestamp": "04:35:32", "text": "知道。"}, {"type": "subtitle", "time": 16535.189, "timestamp": "04:35:35", "text": "感觉就像我……不，有些尴尬"}, {"type": "subtitle", "time": 16537.109, "timestamp": "04:35:37", "text": "原因很奇怪，感觉就像我那样做的"}, {"type": "subtitle", "time": 16539.99, "timestamp": "04:35:39", "text": "两次 12 小时的直播之类的，或者"}, {"type": "subtitle", "time": 16541.31, "timestamp": "04:35:41", "text": "24小时"}, {"type": "subtitle", "time": 16544.551, "timestamp": "04:35:44", "text": "溪流。那种感觉，你的"}, {"type": "subtitle", "time": 16547.551, "timestamp": "04:35:47", "text": "身体不想动"}, {"type": "subtitle", "time": 16551.269, "timestamp": "04:35:51", "text": "片刻。哦，我当时有点担心。"}, {"type": "subtitle", "time": 16552.91, "timestamp": "04:35:52", "text": "H"}, {"type": "subtitle", "time": 16556.07, "timestamp": "04:35:56", "text": "有趣的。已经很久了……"}, {"type": "subtitle", "time": 16559.109, "timestamp": "04:35:59", "text": "嗯，感觉就是这样。我以为是推特"}]
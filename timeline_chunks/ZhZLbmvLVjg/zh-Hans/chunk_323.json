[{"type": "subtitle", "time": 19380.75, "timestamp": "05:23:00", "text": "第一章。好的。出局"}, {"type": "subtitle", "time": 19383.55, "timestamp": "05:23:03", "text": "这里。好的。我们开始吧"}, {"type": "subtitle", "time": 19386.708, "timestamp": "05:23:06", "text": "这。没什么可怕的。我睡不着。你好，"}, {"type": "subtitle", "time": 19389.35, "timestamp": "05:23:09", "text": "我要涂睫毛膏了。你想体验ASMR吗？"}, {"type": "subtitle", "time": 19392.788, "timestamp": "05:23:12", "text": "真的吗？还是你根本不想听ASMR？挑选"}, {"type": "subtitle", "time": 19394.19, "timestamp": "05:23:14", "text": "你的"}, {"type": "subtitle", "time": 19397.75, "timestamp": "05:23:17", "text": "部分。如果你愿意，我可以这么做。"}, {"type": "subtitle", "time": 19399.51, "timestamp": "05:23:19", "text": "我只需要关掉风扇就行了，然后……"}, {"type": "subtitle", "time": 19400.99, "timestamp": "05:23:20", "text": "逐字阅读。那是"}, {"type": "subtitle", "time": 19403.91, "timestamp": "05:23:23", "text": "它。如果你想要类似ASMR的东西，我"}, {"type": "subtitle", "time": 19406.15, "timestamp": "05:23:26", "text": "可以做到。没有ASMR。你不想"}, {"type": "subtitle", "time": 19407.07, "timestamp": "05:23:27", "text": "那？"}, {"type": "subtitle", "time": 19409.628, "timestamp": "05:23:29", "text": "好的。"}, {"type": "subtitle", "time": 19419.03, "timestamp": "05:23:39", "text": "在外面签个名。为什么？我为什么会这样"}, {"type": "subtitle", "time": 19421.59, "timestamp": "05:23:41", "text": "把它录下来，就好像我要唱歌一样。"}, {"type": "subtitle", "time": 19423.59, "timestamp": "05:23:43", "text": "你能说出什么东西吗？哦，是的。"}, {"type": "subtitle", "time": 19424.99, "timestamp": "05:23:44", "text": "我们开始吧"}, {"type": "subtitle", "time": 19427.948, "timestamp": "05:23:47", "text": "去。您需要摘要吗？"}, {"type": "subtitle", "time": 19429.55, "timestamp": "05:23:49", "text": "这？"}, {"type": "subtitle", "time": 19435.31, "timestamp": "05:23:55", "text": "好的。外面有某种东西。"}, {"type": "subtitle", "time": 19438.43, "timestamp": "05:23:58", "text": "老派"}]
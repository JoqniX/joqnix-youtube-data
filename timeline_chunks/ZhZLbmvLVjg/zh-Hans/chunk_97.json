[{"type": "subtitle", "time": 5820.99, "timestamp": "01:37:00", "text": "可以"}, {"type": "subtitle", "time": 5825.109, "timestamp": "01:37:05", "text": "那。但我不知道这是否意味着我需要"}, {"type": "subtitle", "time": 5827.629, "timestamp": "01:37:07", "text": "又是一盘菜。我"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "不。但这三个人后来怎么样了呢？"}, {"type": "subtitle", "time": 5832.109, "timestamp": "01:37:12", "text": "小的"}, {"type": "subtitle", "time": 5835.35, "timestamp": "01:37:15", "text": "小猫？我们的小猫咪们。我没有"}, {"type": "subtitle", "time": 5849.27, "timestamp": "01:37:29", "text": "H：所以，是啊，或者我应该就此结束吧。"}, {"type": "subtitle", "time": 5852.47, "timestamp": "01:37:32", "text": "这里？我不知道。你觉得我怎么样？"}, {"type": "subtitle", "time": 5853.31, "timestamp": "01:37:33", "text": "应该"}, {"type": "subtitle", "time": 5858.109, "timestamp": "01:37:38", "text": "做？如果我按继续键呢？什么会"}, {"type": "subtitle", "time": 5860.56, "timestamp": "01:37:40", "text": "发生？将开始新游戏"}, {"type": "subtitle", "time": 5862.669, "timestamp": "01:37:42", "text": "[音乐]"}, {"type": "subtitle", "time": 5865.31, "timestamp": "01:37:45", "text": "加。哦，它来自"}, {"type": "subtitle", "time": 5867.149, "timestamp": "01:37:47", "text": "这里。"}, {"type": "subtitle", "time": 5871.35, "timestamp": "01:37:51", "text": "好的，这是二周目游戏的内容。好的。"}, {"type": "subtitle", "time": 5874.47, "timestamp": "01:37:54", "text": "不是上一部作品的二周目。"}, {"type": "subtitle", "time": 5876.55, "timestamp": "01:37:56", "text": "你知道吗？让我们完成这些"}, {"type": "subtitle", "time": 5879.31, "timestamp": "01:37:59", "text": "东西。屋顶，"}]
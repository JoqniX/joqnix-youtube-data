[{"type": "subtitle", "time": 19021.99, "timestamp": "05:17:01", "text": "真的好舒服啊。然后当你"}, {"type": "subtitle", "time": 19023.708, "timestamp": "05:17:03", "text": "感觉像"}, {"type": "subtitle", "time": 19026.788, "timestamp": "05:17:06", "text": "晚上，你可以把下巴放在那里"}, {"type": "subtitle", "time": 19030.47, "timestamp": "05:17:10", "text": "向下跑，像这样。如何才能"}, {"type": "subtitle", "time": 19033.39, "timestamp": "05:17:13", "text": "我喜欢这样做"}, {"type": "subtitle", "time": 19038.67, "timestamp": "05:17:18", "text": "这？它太舒服了。然后是小"}, {"type": "subtitle", "time": 19042.31, "timestamp": "05:17:22", "text": "猫咪小可爱好可爱好软萌啊"}, {"type": "subtitle", "time": 19057.788, "timestamp": "05:17:37", "text": "我的天哪，是"}, {"type": "subtitle", "time": 19061.35, "timestamp": "05:17:41", "text": "是的，它太可爱了。所以，就是这样。"}, {"type": "subtitle", "time": 19062.27, "timestamp": "05:17:42", "text": "所以"}, {"type": "subtitle", "time": 19064.708, "timestamp": "05:17:44", "text": "可爱。我没想到我会喜欢"}, {"type": "subtitle", "time": 19067.31, "timestamp": "05:17:47", "text": "实际上得到它就像"}, {"type": "subtitle", "time": 19071.35, "timestamp": "05:17:51", "text": "嗯……这个……嗯……它叫什么来着？"}, {"type": "subtitle", "time": 19075.19, "timestamp": "05:17:55", "text": "把这些东西弄到手，就像真的合身一样。"}, {"type": "subtitle", "time": 19078.15, "timestamp": "05:17:58", "text": "包括背景。那是"}]
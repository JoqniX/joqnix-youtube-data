[{"type": "subtitle", "time": 6306.109, "timestamp": "01:45:06", "text": "巴。我不是唯一的受方。"}, {"type": "subtitle", "time": 6308.79, "timestamp": "01:45:08", "text": "好的。谁会因为是受方而被嘲笑？"}, {"type": "subtitle", "time": 6319.03, "timestamp": "01:45:19", "text": "Hfy，只是因为大家都叫我"}, {"type": "subtitle", "time": 6321.83, "timestamp": "01:45:21", "text": "回合。对，是我。这是其中之一。我打电话给你"}, {"type": "subtitle", "time": 6322.83, "timestamp": "01:45:22", "text": "一个"}, {"type": "subtitle", "time": 6327.149, "timestamp": "01:45:27", "text": "底部。这是另一个吗？"}, {"type": "subtitle", "time": 6335.59, "timestamp": "01:45:35", "text": "感觉你是唯一，嗯，你是唯一"}, {"type": "subtitle", "time": 6337.75, "timestamp": "01:45:37", "text": "凡是叫我“老大”的人，都会叫我“老大”。是的，"}, {"type": "subtitle", "time": 6341.39, "timestamp": "01:45:41", "text": "我做了。是的。"}, {"type": "subtitle", "time": 6345.35, "timestamp": "01:45:45", "text": "你看，我没夸你厉害吧。但是你"}, {"type": "subtitle", "time": 6347.87, "timestamp": "01:45:47", "text": "叫我炸弹吧。"}, {"type": "subtitle", "time": 6350.27, "timestamp": "01:45:50", "text": "为什么？应该是"}, {"type": "subtitle", "time": 6353.95, "timestamp": "01:45:53", "text": "给予应该是"}, {"type": "subtitle", "time": 6357.51, "timestamp": "01:45:57", "text": "真倒霉。我的意思是，我也是受。"}]
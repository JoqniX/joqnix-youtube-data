[{"type": "subtitle", "time": 12007.15, "timestamp": "03:20:07", "text": "呃，我不见了"}, {"type": "subtitle", "time": 12033.15, "timestamp": "03:20:33", "text": "整洁的。我们问问膝盖，它已经闭合了。"}, {"type": "subtitle", "time": 12052.71, "timestamp": "03:20:52", "text": "或许我需要取得一些进展。你知道吗？"}, {"type": "subtitle", "time": 12054.51, "timestamp": "03:20:54", "text": "我们还会再来这里。"}, {"type": "subtitle", "time": 12058.07, "timestamp": "03:20:58", "text": "又来了，对吧？去俱乐部。"}]
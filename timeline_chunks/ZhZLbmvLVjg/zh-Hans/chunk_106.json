[{"type": "subtitle", "time": 6360.149, "timestamp": "01:46:00", "text": "我说这话是因为他说我是机器人。"}, {"type": "subtitle", "time": 6362.03, "timestamp": "01:46:02", "text": "是的。很久以前"}, {"type": "subtitle", "time": 6364.109, "timestamp": "01:46:04", "text": "那里"}, {"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "bakai。哦，等等。他们对……过敏"}, {"type": "subtitle", "time": 6368.79, "timestamp": "01:46:08", "text": "金属之类的东西。其中一人死亡"}, {"type": "subtitle", "time": 6371.149, "timestamp": "01:46:11", "text": "尽管。"}, {"type": "subtitle", "time": 6372.669, "timestamp": "01:46:12", "text": "什么？"}, {"type": "subtitle", "time": 6375.51, "timestamp": "01:46:15", "text": "如何？所以，你是受？不，我不是"}, {"type": "subtitle", "time": 6377.51, "timestamp": "01:46:17", "text": "底部。就因为我给了他一点底线能量。"}, {"type": "subtitle", "time": 6379.709, "timestamp": "01:46:19", "text": "我不是，我不会变成"}, {"type": "subtitle", "time": 6396.149, "timestamp": "01:46:36", "text": "但我之前对此一无所知。"}, {"type": "subtitle", "time": 6397.99, "timestamp": "01:46:37", "text": "你们为什么说得这么直白？"}, {"type": "subtitle", "time": 6401.55, "timestamp": "01:46:41", "text": "这是什么？什么？这很多"}, {"type": "subtitle", "time": 6406.51, "timestamp": "01:46:46", "text": "信息。别担心"}, {"type": "subtitle", "time": 6409.87, "timestamp": "01:46:49", "text": "它。别担心"}]
[{"type": "subtitle", "time": 9180.309, "timestamp": "02:33:00", "text": "为什么。所以，我们需要像这样完成这件事……"}, {"type": "subtitle", "time": 9192.51, "timestamp": "02:33:12", "text": "城市。等等，我们是不是已经收集到所有记忆了？"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "尽管？是的，我们做到了。所以，只有三个"}, {"type": "subtitle", "time": 9198.23, "timestamp": "02:33:18", "text": "还有更多回忆等着我去发现"}, {"type": "subtitle", "time": 9201.59, "timestamp": "02:33:21", "text": "东西。我太害羞了，根本不敢开口。"}, {"type": "subtitle", "time": 9204.63, "timestamp": "02:33:24", "text": "亲身实践过这类东西。"}, {"type": "subtitle", "time": 9207.83, "timestamp": "02:33:27", "text": "等等，这东西真的很好。"}, {"type": "subtitle", "time": 9234.27, "timestamp": "02:33:54", "text": "什么？"}, {"type": "subtitle", "time": 9236.67, "timestamp": "02:33:56", "text": "这？哦，它在里面"}]
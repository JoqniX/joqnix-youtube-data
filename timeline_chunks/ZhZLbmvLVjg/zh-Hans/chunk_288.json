[{"type": "subtitle", "time": 17282.31, "timestamp": "04:48:02", "text": "好的。问题是，那里有数百万人。"}, {"type": "subtitle", "time": 17284.708, "timestamp": "04:48:04", "text": "现在就在那里。人太多了"}, {"type": "subtitle", "time": 17287.75, "timestamp": "04:48:07", "text": "来自印度，而且会有很多"}, {"type": "subtitle", "time": 17289.83, "timestamp": "04:48:09", "text": "甚至可能正在直播的人，或者我们"}, {"type": "subtitle", "time": 17292.51, "timestamp": "04:48:12", "text": "就在这几秒钟里，管子……"}, {"type": "subtitle", "time": 17296.788, "timestamp": "04:48:16", "text": "除非我们能够确定我们不会这样做，否则我们又如何知道呢？"}, {"type": "subtitle", "time": 17299.628, "timestamp": "04:48:19", "text": "他们喜欢自我推销等等"}, {"type": "subtitle", "time": 17303.03, "timestamp": "04:48:23", "text": "事情对吧，或者像联系那个人一样"}, {"type": "subtitle", "time": 17305.91, "timestamp": "04:48:25", "text": "像我这样的人，或者像其他人一样的人"}, {"type": "subtitle", "time": 17308.15, "timestamp": "04:48:28", "text": "活跃且喜欢直播之类的"}, {"type": "subtitle", "time": 17310.39, "timestamp": "04:48:30", "text": "只有到那时，我才能"}, {"type": "subtitle", "time": 17313.59, "timestamp": "04:48:33", "text": "知道某某人存在"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "为了Vub以及所有的一切。出色地，"}, {"type": "subtitle", "time": 17317.75, "timestamp": "04:48:37", "text": "他们会像，你知道，在他们自己的世界里。"}, {"type": "subtitle", "time": 17321.868, "timestamp": "04:48:41", "text": "壳，或者像小壳一样，就像它们一样"}, {"type": "subtitle", "time": 17324.628, "timestamp": "04:48:44", "text": "未经挑选的宝石，或者像未抛光的宝石"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "需要抛光的宝石"}, {"type": "subtitle", "time": 17329.11, "timestamp": "04:48:49", "text": "某物。我不知道这张卡是干什么用的"}, {"type": "subtitle", "time": 17331.868, "timestamp": "04:48:51", "text": "说。"}, {"type": "subtitle", "time": 17334.628, "timestamp": "04:48:54", "text": "疼痛。但他一个油管博主都没加。"}, {"type": "subtitle", "time": 17337.31, "timestamp": "04:48:57", "text": "我最喜欢的油管博主，你知道，就是他"}]
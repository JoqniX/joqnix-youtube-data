[{"type": "subtitle", "time": 20160.83, "timestamp": "05:36:00", "text": "已经剃了几天胡子了。他的"}, {"type": "subtitle", "time": 20164.07, "timestamp": "05:36:04", "text": "凹陷的脸颊和下垂的眼睑暴露了一切"}, {"type": "subtitle", "time": 20165.31, "timestamp": "05:36:05", "text": "疲倦"}, {"type": "subtitle", "time": 20173.27, "timestamp": "05:36:13", "text": "经历过与酒瓶的激烈交锋。"}, {"type": "subtitle", "time": 20175.51, "timestamp": "05:36:15", "text": "他加满了油箱，然后走了进去。"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "他去了车站，给自己买了一个"}, {"type": "subtitle", "time": 20180.39, "timestamp": "05:36:20", "text": "从自动售货机买的咖啡。他"}, {"type": "subtitle", "time": 20182.23, "timestamp": "05:36:22", "text": "一边听着一边等着钟表"}, {"type": "subtitle", "time": 20184.15, "timestamp": "05:36:24", "text": "耳边播放着悦耳的音乐"}, {"type": "subtitle", "time": 20186.59, "timestamp": "05:36:26", "text": "背景。那一定是……"}, {"type": "subtitle", "time": 20190.23, "timestamp": "05:36:30", "text": "他想听收音机，但他找不到收音机在哪里。"}, {"type": "subtitle", "time": 20192.31, "timestamp": "05:36:32", "text": "加油站的钟响了"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "几秒钟后计数器出现。他曾是"}, {"type": "subtitle", "time": 20198.47, "timestamp": "05:36:38", "text": "高个黑人，有点瘦。"}, {"type": "subtitle", "time": 20201.43, "timestamp": "05:36:41", "text": "那人看起来一点也不累。或许"}, {"type": "subtitle", "time": 20204.47, "timestamp": "05:36:44", "text": "有点无聊。他做到了。他有一个"}]
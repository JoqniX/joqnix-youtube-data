[{"type": "subtitle", "time": 20100.03, "timestamp": "05:35:00", "text": "他逃了出来"}, {"type": "subtitle", "time": 20102.35, "timestamp": "05:35:02", "text": "车。离开了"}, {"type": "subtitle", "time": 20105.11, "timestamp": "05:35:05", "text": "车里，他拉上了皮衣的拉链。"}, {"type": "subtitle", "time": 20108.19, "timestamp": "05:35:08", "text": "夹克。周围有点风。"}, {"type": "subtitle", "time": 20116.51, "timestamp": "05:35:16", "text": "到达的。虽然秋天已经来临"}, {"type": "subtitle", "time": 20118.948, "timestamp": "05:35:18", "text": "天气到了，所以天气持续恶化"}, {"type": "subtitle", "time": 20123.11, "timestamp": "05:35:23", "text": "一天比一天冷。他的腿很硬"}, {"type": "subtitle", "time": 20125.27, "timestamp": "05:35:25", "text": "步行时间。他花费了相当多的时间。"}, {"type": "subtitle", "time": 20128.23, "timestamp": "05:35:28", "text": "坐姿时间。所以他的"}, {"type": "subtitle", "time": 20144.19, "timestamp": "05:35:44", "text": "生锈了。"}, {"type": "subtitle", "time": 20149.19, "timestamp": "05:35:49", "text": "嗯，杰克年纪不算太大。事实上，他"}, {"type": "subtitle", "time": 20153.27, "timestamp": "05:35:53", "text": "才44岁，身体依然非常健康。"}, {"type": "subtitle", "time": 20155.51, "timestamp": "05:35:55", "text": "到了这个年纪。他脸上的踉跄"}, {"type": "subtitle", "time": 20158.23, "timestamp": "05:35:58", "text": "已经变成胡子了。他还没有"}]
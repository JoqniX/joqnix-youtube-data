[{"type": "subtitle", "time": 4020.23, "timestamp": "01:07:00", "text": "已重启。他怎么样了？目标是什么？"}, {"type": "subtitle", "time": 4023.43, "timestamp": "01:07:03", "text": "你的枪法怎么这么准？"}, {"type": "subtitle", "time": 4033.75, "timestamp": "01:07:13", "text": "好的？更好的建议是，不要从他身下钻过去。"}, {"type": "subtitle", "time": 4036.24, "timestamp": "01:07:16", "text": "这个幽灵车牌和"}, {"type": "subtitle", "time": 4046.03, "timestamp": "01:07:26", "text": "逃避。"}, {"type": "subtitle", "time": 4053.549, "timestamp": "01:07:33", "text": "再见。你好。过来。来"}, {"type": "subtitle", "time": 4071.47, "timestamp": "01:07:51", "text": "现在。好的。哦，还记得吗？"}]
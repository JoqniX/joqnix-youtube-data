[{"type": "subtitle", "time": 16020.189, "timestamp": "04:27:00", "text": "出色地。感谢《剑魂》。然后是"}, {"type": "subtitle", "time": 16023.51, "timestamp": "04:27:03", "text": "最后，尽管并非最不重要的"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "还。你可能见过他们，呃，作为……"}, {"type": "subtitle", "time": 16029.71, "timestamp": "04:27:09", "text": "临时模式。就是它，就是它。"}, {"type": "subtitle", "time": 16032.03, "timestamp": "04:27:12", "text": "仅限哈希"}, {"type": "subtitle", "time": 16034.79, "timestamp": "04:27:14", "text": "克洛诺斯。是的。 Hash Chama 也获得了"}, {"type": "subtitle", "time": 16036.95, "timestamp": "04:27:16", "text": "版主职位。"}, {"type": "subtitle", "time": 16038.75, "timestamp": "04:27:18", "text": "是的，全部"}, {"type": "subtitle", "time": 16041.07, "timestamp": "04:27:21", "text": "新式枪械"}, {"type": "subtitle", "time": 16045.11, "timestamp": "04:27:25", "text": "主持人。所以，嗯，因为我当时就想……"}, {"type": "subtitle", "time": 16048.63, "timestamp": "04:27:28", "text": "忙着做社区工作，呃……"}, {"type": "subtitle", "time": 16052.469, "timestamp": "04:27:32", "text": "IMTubers。我无法集中精力处理自己的事。"}, {"type": "subtitle", "time": 16055.59, "timestamp": "04:27:35", "text": "服务器相关的事情等等。但我会做"}, {"type": "subtitle", "time": 16058.63, "timestamp": "04:27:38", "text": "明天以及本周大部分时间"}, {"type": "subtitle", "time": 16060.71, "timestamp": "04:27:40", "text": "可能明天，后天"}, {"type": "subtitle", "time": 16063.51, "timestamp": "04:27:43", "text": "明天晚上我有空。患病的"}, {"type": "subtitle", "time": 16066.149, "timestamp": "04:27:46", "text": "就像做所有这些事情一样。是的"}, {"type": "subtitle", "time": 16068.79, "timestamp": "04:27:48", "text": "呃，会有新的……呃……改版"}, {"type": "subtitle", "time": 16071.99, "timestamp": "04:27:51", "text": "服务器改造以及所有这些"}, {"type": "subtitle", "time": 16075.03, "timestamp": "04:27:55", "text": "东西，这样所有枪支都可以像这样"}, {"type": "subtitle", "time": 16078.469, "timestamp": "04:27:58", "text": "切换一下，就像你知道他们是否喜欢我一样"}]
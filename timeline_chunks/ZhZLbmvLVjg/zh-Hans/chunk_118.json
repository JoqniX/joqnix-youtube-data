[{"type": "subtitle", "time": 7083.39, "timestamp": "01:58:03", "text": "安装一个收发器。"}, {"type": "subtitle", "time": 7085.629, "timestamp": "01:58:05", "text": "[音乐]"}, {"type": "subtitle", "time": 7088.47, "timestamp": "01:58:08", "text": "好的。我或许会喜欢它，因为我"}, {"type": "subtitle", "time": 7092.31, "timestamp": "01:58:12", "text": "我不想做我不喜欢的事。"}, {"type": "subtitle", "time": 7095.51, "timestamp": "01:58:15", "text": "我的意思是，没关系，我给零花钱。"}, {"type": "subtitle", "time": 7097.47, "timestamp": "01:58:17", "text": "聊天"}, {"type": "subtitle", "time": 7104.27, "timestamp": "01:58:24", "text": "有点霸凌倾向，但也没那么过分。"}, {"type": "subtitle", "time": 7115.589, "timestamp": "01:58:35", "text": "我多么希望双方势均力敌，但我却欺负你。"}, {"type": "subtitle", "time": 7117.229, "timestamp": "01:58:37", "text": "欺负我"}, {"type": "subtitle", "time": 7121.629, "timestamp": "01:58:41", "text": "五五开，不一定。"}, {"type": "subtitle", "time": 7124.75, "timestamp": "01:58:44", "text": "平等的。不会的"}, {"type": "subtitle", "time": 7127.43, "timestamp": "01:58:47", "text": "就像熟悉的欺凌一样"}, {"type": "subtitle", "time": 7128.95, "timestamp": "01:58:48", "text": "他欺负我，但我无能为力。"}, {"type": "subtitle", "time": 7136.95, "timestamp": "01:58:56", "text": "不，我做不了所有这些事。它必须"}]
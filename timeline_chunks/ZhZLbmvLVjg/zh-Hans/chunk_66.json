[{"type": "subtitle", "time": 3960.63, "timestamp": "01:06:00", "text": "担心。你好。所以，在我们去见他之前，"}, {"type": "subtitle", "time": 3972.75, "timestamp": "01:06:12", "text": "好的，"}, {"type": "subtitle", "time": 4003.99, "timestamp": "01:06:43", "text": "也。你看到地上的那个人了吗？他"}, {"type": "subtitle", "time": 4005.67, "timestamp": "01:06:45", "text": "需要重启。我不想失去我的"}, {"type": "subtitle", "time": 4008.029, "timestamp": "01:06:48", "text": "手。我是"}, {"type": "subtitle", "time": 4015.95, "timestamp": "01:06:55", "text": "[音乐]"}]
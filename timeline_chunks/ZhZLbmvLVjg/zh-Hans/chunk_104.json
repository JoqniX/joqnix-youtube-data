[{"type": "subtitle", "time": 6241.95, "timestamp": "01:44:01", "text": "好的。来"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "上帝。那只鸡卡住了"}, {"type": "subtitle", "time": 6272.75, "timestamp": "01:44:32", "text": "就像……"}, {"type": "subtitle", "time": 6286.31, "timestamp": "01:44:46", "text": "好的。你肯定不想当个游手好闲的人。"}, {"type": "subtitle", "time": 6288.47, "timestamp": "01:44:48", "text": "不过你是个机器人。但我是一个双性恋"}, {"type": "subtitle", "time": 6290.59, "timestamp": "01:44:50", "text": "尽管。我说过"}, {"type": "subtitle", "time": 6295.03, "timestamp": "01:44:55", "text": "很多。不像你，笨蛋凯，你明白"}]
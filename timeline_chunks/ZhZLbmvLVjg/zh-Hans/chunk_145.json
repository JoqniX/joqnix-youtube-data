[{"type": "subtitle", "time": 8703.95, "timestamp": "02:25:03", "text": "好的。没关系。我只需要战斗"}, {"type": "subtitle", "time": 8723.27, "timestamp": "02:25:23", "text": "哦，快下车。下车。好的。我的天哪，我"}, {"type": "subtitle", "time": 8724.91, "timestamp": "02:25:24", "text": "几乎"}, {"type": "subtitle", "time": 8729.11, "timestamp": "02:25:29", "text": "死了。请务必设置。哦，等等。为什么是"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "电影《Dokio》？我以为它会……"}, {"type": "subtitle", "time": 8733.71, "timestamp": "02:25:33", "text": "与音乐有关。做设置"}, {"type": "subtitle", "time": 8736.389, "timestamp": "02:25:36", "text": "它。其实我上次看的第一个视频是……"}, {"type": "subtitle", "time": 8738.75, "timestamp": "02:25:38", "text": "年。"}, {"type": "subtitle", "time": 8741.71, "timestamp": "02:25:41", "text": "哦，做"}, {"type": "subtitle", "time": 8745.11, "timestamp": "02:25:45", "text": "你是大学生吧？是的。做"}]
[{"type": "subtitle", "time": 4810.11, "timestamp": "01:20:10", "text": "正确的。只有人类才有权这样做"}, {"type": "subtitle", "time": 4816.229, "timestamp": "01:20:16", "text": "人类。它还说我不是"}, {"type": "subtitle", "time": 4818.07, "timestamp": "01:20:18", "text": "被认为是人类。嘿，那也是"}, {"type": "subtitle", "time": 4819.63, "timestamp": "01:20:19", "text": "进攻"}, {"type": "subtitle", "time": 4822.87, "timestamp": "01:20:22", "text": "安全。打开这条通道。什么"}, {"type": "subtitle", "time": 4829.709, "timestamp": "01:20:29", "text": "[音乐]"}, {"type": "subtitle", "time": 4832.57, "timestamp": "01:20:32", "text": "计划？也许如果我们一起走，他会"}, {"type": "subtitle", "time": 4835.47, "timestamp": "01:20:35", "text": "[音乐]"}, {"type": "subtitle", "time": 4837.7, "timestamp": "01:20:37", "text": "说，"}]
[{"type": "subtitle", "time": 12484.91, "timestamp": "03:28:04", "text": "[音乐]"}, {"type": "subtitle", "time": 12488.349, "timestamp": "03:28:08", "text": "再次？哦，是的，我来了。"}, {"type": "subtitle", "time": 12503.42, "timestamp": "03:28:23", "text": "是的。哦，出路。好的。"}, {"type": "subtitle", "time": 12512.59, "timestamp": "03:28:32", "text": "哦，他没注意到我。好，好"}, {"type": "subtitle", "time": 12523.15, "timestamp": "03:28:43", "text": "好的。"}, {"type": "subtitle", "time": 12526.269, "timestamp": "03:28:46", "text": "你好。这将是"}, {"type": "subtitle", "time": 12530.63, "timestamp": "03:28:50", "text": "边。运气，运气，运气。你好。随"}, {"type": "subtitle", "time": 12531.469, "timestamp": "03:28:51", "text": "你的"}]
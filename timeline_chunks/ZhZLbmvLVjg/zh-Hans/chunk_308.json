[{"type": "subtitle", "time": 18481.59, "timestamp": "05:08:01", "text": "那我们来读些恐怖故事吧。"}, {"type": "subtitle", "time": 18483.51, "timestamp": "05:08:03", "text": "是的。"}, {"type": "subtitle", "time": 18486.07, "timestamp": "05:08:06", "text": "等等，等等。你是说现在还是像……呃……在……"}, {"type": "subtitle", "time": 18488.31, "timestamp": "05:08:08", "text": "未来？比如下周？不，这个"}, {"type": "subtitle", "time": 18491.31, "timestamp": "05:08:11", "text": "现在是十一月。不，那是什么？"}, {"type": "subtitle", "time": 18494.07, "timestamp": "05:08:14", "text": "十一月？我可以做什么类型的事情？"}, {"type": "subtitle", "time": 18495.39, "timestamp": "05:08:15", "text": "十一月？因为是"}, {"type": "subtitle", "time": 18498.51, "timestamp": "05:08:18", "text": "大猩猩。我不想安排日程"}, {"type": "subtitle", "time": 18507.15, "timestamp": "05:08:27", "text": "喜欢"}, {"type": "subtitle", "time": 18509.91, "timestamp": "05:08:29", "text": "万圣节。该死。我从不考验我们的时间安排。"}, {"type": "subtitle", "time": 18514.51, "timestamp": "05:08:34", "text": "对任何人。拥抱一下，我们还有12分钟"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "其余的。哦。哦，是的。是的。是的。"}, {"type": "subtitle", "time": 18519.628, "timestamp": "05:08:39", "text": "好的。等待。恐怖"}, {"type": "subtitle", "time": 18522.11, "timestamp": "05:08:42", "text": "故事。恐怖"}, {"type": "subtitle", "time": 18529.708, "timestamp": "05:08:49", "text": "故事。好的。"}, {"type": "subtitle", "time": 18532.32, "timestamp": "05:08:52", "text": "呃，好的。我们开始吧"}, {"type": "subtitle", "time": 18534.67, "timestamp": "05:08:54", "text": "[音乐]"}, {"type": "subtitle", "time": 18537.99, "timestamp": "05:08:57", "text": "呃，我知道更简单的方法。我可以加入吗？"}]
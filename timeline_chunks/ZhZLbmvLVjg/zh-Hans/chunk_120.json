[{"type": "subtitle", "time": 7220.07, "timestamp": "02:00:20", "text": "酒吧。我没看到。你们看到了吗？"}, {"type": "subtitle", "time": 7222.229, "timestamp": "02:00:22", "text": "安全标志？我相信我没有看到"}, {"type": "subtitle", "time": 7224.91, "timestamp": "02:00:24", "text": "安全标志。"}, {"type": "subtitle", "time": 7247.629, "timestamp": "02:00:47", "text": "[音乐]"}, {"type": "subtitle", "time": 7252.75, "timestamp": "02:00:52", "text": "嘿，我必须把它们全部完成。哦，我的"}, {"type": "subtitle", "time": 7256.35, "timestamp": "02:00:56", "text": "上帝。但我们完成了这一切。"}]
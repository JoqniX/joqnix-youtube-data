[{"type": "subtitle", "time": 17040.31, "timestamp": "04:44:00", "text": "从我的节目里出来。我怀念那些日子。"}, {"type": "subtitle", "time": 17043.67, "timestamp": "04:44:03", "text": "你知道，那是在2021年我刚开始的时候。"}, {"type": "subtitle", "time": 17047.23, "timestamp": "04:44:07", "text": "大家都在录像，然后就说：“约翰，过来。”"}, {"type": "subtitle", "time": 17050.948, "timestamp": "04:44:10", "text": "感觉每天都是合作日。那里"}, {"type": "subtitle", "time": 17053.43, "timestamp": "04:44:13", "text": "有太多人想要合作了"}, {"type": "subtitle", "time": 17055.27, "timestamp": "04:44:15", "text": "与我一起。然后我就想，好吧，我来做"}, {"type": "subtitle", "time": 17058.55, "timestamp": "04:44:18", "text": "就是今天，就是今天，就是那一天。然后我"}, {"type": "subtitle", "time": 17060.35, "timestamp": "04:44:20", "text": "当时的感觉就像，啊，"}, {"type": "subtitle", "time": 17064.39, "timestamp": "04:44:24", "text": "疼痛，诸如此类的事情。嗯，这个"}, {"type": "subtitle", "time": 17067.59, "timestamp": "04:44:27", "text": "这一切之所以成为可能，全靠祖基。"}, {"type": "subtitle", "time": 17070.15, "timestamp": "04:44:30", "text": "是谁给了我勇气去真正开口说话？"}, {"type": "subtitle", "time": 17073.27, "timestamp": "04:44:33", "text": "如何与人相处以及如何说话"}, {"type": "subtitle", "time": 17075.83, "timestamp": "04:44:35", "text": "合作等等。所以我是"}, {"type": "subtitle", "time": 17078.59, "timestamp": "04:44:38", "text": "真的非常感谢她"}, {"type": "subtitle", "time": 17081.59, "timestamp": "04:44:41", "text": "自从。是的。但现在我不这么做了。"}, {"type": "subtitle", "time": 17083.43, "timestamp": "04:44:43", "text": "多次合作。我一直都在放松休息。"}, {"type": "subtitle", "time": 17087.59, "timestamp": "04:44:47", "text": "和我的 IMV 入侵团队一起，现在正在合作"}, {"type": "subtitle", "time": 17092.15, "timestamp": "04:44:52", "text": "和他们在一起，几乎就像是……一样"}, {"type": "subtitle", "time": 17094.55, "timestamp": "04:44:54", "text": "说到ve，他不是在直播吗？"}, {"type": "subtitle", "time": 17096.55, "timestamp": "04:44:56", "text": "他直播的不是恐怖游戏。"}, {"type": "subtitle", "time": 17098.43, "timestamp": "04:44:58", "text": "所有闪光灯"}]
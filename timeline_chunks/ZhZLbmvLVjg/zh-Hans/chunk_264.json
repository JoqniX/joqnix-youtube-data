[{"type": "subtitle", "time": 15842.71, "timestamp": "04:24:02", "text": "公告一：关于日程安排"}, {"type": "subtitle", "time": 15845.91, "timestamp": "04:24:05", "text": "本周我要去的地方"}, {"type": "subtitle", "time": 15849.91, "timestamp": "04:24:09", "text": "完全变成大猩猩了，所以就像不再……呃……"}, {"type": "subtitle", "time": 15852.71, "timestamp": "04:24:12", "text": "意思是，我不是在安排日程，只是……"}, {"type": "subtitle", "time": 15855.11, "timestamp": "04:24:15", "text": "今天，不是本周的今天，是……"}, {"type": "subtitle", "time": 15857.429, "timestamp": "04:24:17", "text": "仅限本周或本月"}, {"type": "subtitle", "time": 15858.469, "timestamp": "04:24:18", "text": "谁知道呢"}, {"type": "subtitle", "time": 15861.189, "timestamp": "04:24:21", "text": "是的，我不做日程安排。呃，我"}, {"type": "subtitle", "time": 15862.95, "timestamp": "04:24:22", "text": "忘记发布Enisma公告了"}, {"type": "subtitle", "time": 15866.11, "timestamp": "04:24:26", "text": "因为我当时满脑子都是……"}, {"type": "subtitle", "time": 15871.91, "timestamp": "04:24:31", "text": "我的社区志愿工作。呃，那"}, {"type": "subtitle", "time": 15875.67, "timestamp": "04:24:35", "text": "还有什么？第二项公告是："}, {"type": "subtitle", "time": 15878.59, "timestamp": "04:24:38", "text": "终于有了"}, {"type": "subtitle", "time": 15882.51, "timestamp": "04:24:42", "text": "当选一词被选中。是否有"}, {"type": "subtitle", "time": 15885.63, "timestamp": "04:24:45", "text": "选举？不，我们终于……"}, {"type": "subtitle", "time": 15889.51, "timestamp": "04:24:49", "text": "我们频道任命了新的版主"}, {"type": "subtitle", "time": 15893.269, "timestamp": "04:24:53", "text": "YouTube、Discord 和 Twitch 都算。"}, {"type": "subtitle", "time": 15896.149, "timestamp": "04:24:56", "text": "我需要……呃，我还没有完全……"}, {"type": "subtitle", "time": 15898.63, "timestamp": "04:24:58", "text": "把 mod ro 给所有人，就像"}]
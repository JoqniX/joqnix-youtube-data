[{"type": "subtitle", "time": 5103.87, "timestamp": "01:25:03", "text": "那里。什么是"}, {"type": "subtitle", "time": 5106.27, "timestamp": "01:25:06", "text": "那？屋顶"}, {"type": "subtitle", "time": 5113.35, "timestamp": "01:25:13", "text": "被锁在那里了。那是工作站。"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "打开。但有安全管控措施。"}, {"type": "subtitle", "time": 5119.91, "timestamp": "01:25:19", "text": "哦，我黑进了主系统，而且"}, {"type": "subtitle", "time": 5141.49, "timestamp": "01:25:41", "text": "已锁定"}, {"type": "subtitle", "time": 5149.31, "timestamp": "01:25:49", "text": "这里。好的。我们摧毁"}, {"type": "subtitle", "time": 5156.51, "timestamp": "01:25:56", "text": "一个，让你破解"}, {"type": "subtitle", "time": 5159.47, "timestamp": "01:25:59", "text": "它。答对了。你黑了"}]
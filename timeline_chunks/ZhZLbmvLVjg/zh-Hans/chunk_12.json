[{"type": "subtitle", "time": 721.11, "timestamp": "00:12:01", "text": "将从中获取信息流"}, {"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "Streamlabs 会像记录一样记录下来。"}, {"type": "subtitle", "time": 725.269, "timestamp": "00:12:05", "text": "那我就会用 Streamlabs 了。"}, {"type": "subtitle", "time": 728.35, "timestamp": "00:12:08", "text": "Streamlabs 收集了你们的用户数据"}, {"type": "subtitle", "time": 732.629, "timestamp": "00:12:12", "text": "积分，我会把它转换成"}, {"type": "subtitle", "time": 736.79, "timestamp": "00:12:16", "text": "积分制，所以你从……获得的积分"}, {"type": "subtitle", "time": 741.67, "timestamp": "00:12:21", "text": "YouTube的目标是与Twitch平起平坐。"}, {"type": "subtitle", "time": 743.91, "timestamp": "00:12:23", "text": "在 Twitch 上，你可以很容易地得到它，因为"}, {"type": "subtitle", "time": 745.069, "timestamp": "00:12:25", "text": "它是"}, {"type": "subtitle", "time": 746.949, "timestamp": "00:12:26", "text": "融合的。那岂不是……"}, {"type": "subtitle", "time": 748.389, "timestamp": "00:12:28", "text": "排行榜？是的。你想看看"}, {"type": "subtitle", "time": 750.99, "timestamp": "00:12:30", "text": "排行榜？等等，我想看看……"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "排行榜？我添加了这个。所以，这是"}, {"type": "subtitle", "time": 755.91, "timestamp": "00:12:35", "text": "目前就像一个排行榜。它是"}, {"type": "subtitle", "time": 759.11, "timestamp": "00:12:39", "text": "就像随机用户一样。所以，是的，你看顶部"}, {"type": "subtitle", "time": 761.43, "timestamp": "00:12:41", "text": "XS 上有 5 个。我更换了泰坦，"}, {"type": "subtitle", "time": 764.31, "timestamp": "00:12:44", "text": "东西。所以，你们所有人都会明白"}, {"type": "subtitle", "time": 766.35, "timestamp": "00:12:46", "text": "大部分要点。它会像……"}, {"type": "subtitle", "time": 768.79, "timestamp": "00:12:48", "text": "像这样的排行榜。"}, {"type": "subtitle", "time": 772.47, "timestamp": "00:12:52", "text": "所以，是的，我需要……呃，得到……"}, {"type": "subtitle", "time": 775.67, "timestamp": "00:12:55", "text": "把那人的呃……东西和​​东西放进去"}, {"type": "subtitle", "time": 778.71, "timestamp": "00:12:58", "text": "呃，这个呃，代码之类的东西。不过，是的，善良"}]
[{"type": "subtitle", "time": 14100.71, "timestamp": "03:55:00", "text": "关于游戏？比赛真的"}, {"type": "subtitle", "time": 14106.429, "timestamp": "03:55:06", "text": "非常勇于探索，嗯，冒险。我"}, {"type": "subtitle", "time": 14109.429, "timestamp": "03:55:09", "text": "虽然有快乐和悲伤的情绪"}, {"type": "subtitle", "time": 14113.55, "timestamp": "03:55:13", "text": "尤其是最后失去维生素B12，太可惜了。"}, {"type": "subtitle", "time": 14115.95, "timestamp": "03:55:15", "text": "很多，但是"}, {"type": "subtitle", "time": 14119.91, "timestamp": "03:55:19", "text": "是的，他的故事很精彩。我非常享受这一切。"}, {"type": "subtitle", "time": 14123.189, "timestamp": "03:55:23", "text": "它的各个部分。它藏起来了"}, {"type": "subtitle", "time": 14127.15, "timestamp": "03:55:27", "text": "彩蛋和类似致敬"}, {"type": "subtitle", "time": 14130.75, "timestamp": "03:55:30", "text": "东西。真是"}, {"type": "subtitle", "time": 14134.55, "timestamp": "03:55:34", "text": "好的。是的。最后，我很高兴"}, {"type": "subtitle", "time": 14137.03, "timestamp": "03:55:37", "text": "我真的通关了。"}, {"type": "subtitle", "time": 14140.189, "timestamp": "03:55:40", "text": "不多说“呃”"}, {"type": "subtitle", "time": 14144.15, "timestamp": "03:55:44", "text": "流。等等，这过了多久？"}, {"type": "subtitle", "time": 14147.03, "timestamp": "03:55:47", "text": "昨天的直播？时长4小时，对吧？"}, {"type": "subtitle", "time": 14150.79, "timestamp": "03:55:50", "text": "我们昨天结束了第一部分。"}, {"type": "subtitle", "time": 14153.15, "timestamp": "03:55:53", "text": "4小时后，我继续"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "说。是的。是的。是的。现在"}]
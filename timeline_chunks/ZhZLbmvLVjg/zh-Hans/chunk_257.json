[{"type": "subtitle", "time": 15440.67, "timestamp": "04:17:20", "text": "我的声音能被听到吗？好的，我是"}, {"type": "subtitle", "time": 15444.63, "timestamp": "04:17:24", "text": "可听见的。好吧，我真的吓了一跳。"}, {"type": "subtitle", "time": 15447.229, "timestamp": "04:17:27", "text": "当我的麦克风没有移动时。哦，我的"}, {"type": "subtitle", "time": 15450.429, "timestamp": "04:17:30", "text": "上帝。是的。你好"}, {"type": "subtitle", "time": 15462.469, "timestamp": "04:17:42", "text": "所以，我真的想为此道歉。"}, {"type": "subtitle", "time": 15467.03, "timestamp": "04:17:47", "text": "今天的直播延迟太严重了。我超级棒"}, {"type": "subtitle", "time": 15470.91, "timestamp": "04:17:50", "text": "非常非常抱歉。"}, {"type": "subtitle", "time": 15474.83, "timestamp": "04:17:54", "text": "是的，我在这里。"}, {"type": "subtitle", "time": 15476.99, "timestamp": "04:17:56", "text": "永远。我在这里"}]
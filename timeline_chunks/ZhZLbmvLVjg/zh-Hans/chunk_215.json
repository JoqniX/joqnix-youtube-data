[{"type": "subtitle", "time": 12916.51, "timestamp": "03:35:16", "text": "落下。哦，它开着呢。"}, {"type": "subtitle", "time": 12918.51, "timestamp": "03:35:18", "text": "现在。"}, {"type": "subtitle", "time": 12921.349, "timestamp": "03:35:21", "text": "哦，找到了。我们得到了第一个"}, {"type": "subtitle", "time": 12923.63, "timestamp": "03:35:23", "text": "记忆"}, {"type": "subtitle", "time": 12927.83, "timestamp": "03:35:27", "text": "投币口。现在我们需要找到其中两个。"}, {"type": "subtitle", "time": 12930.55, "timestamp": "03:35:30", "text": "生活变得艰难起来。中心"}, {"type": "subtitle", "time": 12931.91, "timestamp": "03:35:31", "text": "成为房子"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "强大的。他们有能力保住这座城市。"}, {"type": "subtitle", "time": 12941.429, "timestamp": "03:35:41", "text": "永恒的。好的，我们还需要两个。二"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "左边更多。我们会查清楚的。出色地"}, {"type": "subtitle", "time": 12954.07, "timestamp": "03:35:54", "text": "出去。我没找到位置信息"}]
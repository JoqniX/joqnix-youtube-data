[{"type": "subtitle", "time": 8041.109, "timestamp": "02:14:01", "text": "我当时真是疯了，居然用了那个词。"}, {"type": "subtitle", "time": 8042.83, "timestamp": "02:14:02", "text": "警报就像"}, {"type": "subtitle", "time": 8047.069, "timestamp": "02:14:07", "text": "就像用阿斯玛的声音，或者像"}, {"type": "subtitle", "time": 8065.47, "timestamp": "02:14:25", "text": "亲爱的醒来"}, {"type": "subtitle", "time": 8068.91, "timestamp": "02:14:28", "text": "醒醒吧，他错过了这里。"}, {"type": "subtitle", "time": 8097.03, "timestamp": "02:14:57", "text": "但这跟警报不一样。就像"}, {"type": "subtitle", "time": 8099.79, "timestamp": "02:14:59", "text": "只是一个声音"}]
[{"type": "subtitle", "time": 10561.429, "timestamp": "02:56:01", "text": "你知道吗？我们去……"}, {"type": "subtitle", "time": 10574.23, "timestamp": "02:56:14", "text": "时间。是的。找到这三个呃"}, {"type": "subtitle", "time": 10575.87, "timestamp": "02:56:15", "text": "记忆"}, {"type": "subtitle", "time": 10578.389, "timestamp": "02:56:18", "text": "老虎机游戏结束后，我们今天的工作就结束了。"}, {"type": "subtitle", "time": 10580.63, "timestamp": "02:56:20", "text": "好了，我这就结束直播。"}, {"type": "subtitle", "time": 10582.469, "timestamp": "02:56:22", "text": "我们已经直播了大约两个小时了，"}, {"type": "subtitle", "time": 10587.63, "timestamp": "02:56:27", "text": "正确的？我相信我一开始是这样的"}, {"type": "subtitle", "time": 10601.71, "timestamp": "02:56:41", "text": "开始了。哦"}, {"type": "subtitle", "time": 10611.23, "timestamp": "02:56:51", "text": "那里。"}, {"type": "subtitle", "time": 10618.15, "timestamp": "02:56:58", "text": "嗯，我喜欢这种蓬松感和轻盈感之间的良好平衡。"}]
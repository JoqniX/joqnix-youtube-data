[{"type": "subtitle", "time": 14701.99, "timestamp": "04:05:01", "text": "虽然没有勾号，但请不要访问"}, {"type": "subtitle", "time": 14703.91, "timestamp": "04:05:03", "text": "呃，让你困惑，用那个让你困惑。"}, {"type": "subtitle", "time": 14706.71, "timestamp": "04:05:06", "text": "验证通过，不是验证勾选框。"}, {"type": "subtitle", "time": 14710.469, "timestamp": "04:05:10", "text": "标记频道"}, {"type": "subtitle", "time": 14714.229, "timestamp": "04:05:14", "text": "你有完全访问权限吗？是的，我会的。"}, {"type": "subtitle", "time": 14716.59, "timestamp": "04:05:16", "text": "正在做这件事。我会一直陪着你们。"}, {"type": "subtitle", "time": 14719.269, "timestamp": "04:05:19", "text": "更新。所以，感谢所有人。"}, {"type": "subtitle", "time": 14721.429, "timestamp": "04:05:21", "text": "今天到场的各位，你们好。真的"}, {"type": "subtitle", "time": 14724.15, "timestamp": "04:05:24", "text": "意义重大。那么，凯石对于"}, {"type": "subtitle", "time": 14726.63, "timestamp": "04:05:26", "text": "未来。这对我意义重大。谢谢"}, {"type": "subtitle", "time": 14728.389, "timestamp": "04:05:28", "text": "从一开始就在那里，直到"}, {"type": "subtitle", "time": 14743.7, "timestamp": "04:05:43", "text": "在。意义重大。"}, {"type": "subtitle", "time": 14746.07, "timestamp": "04:05:46", "text": "[音乐]"}, {"type": "subtitle", "time": 14747.469, "timestamp": "04:05:47", "text": "真正意味着"}, {"type": "subtitle", "time": 14750.229, "timestamp": "04:05:50", "text": "很多。谢谢你们的到来。我们聊了"}, {"type": "subtitle", "time": 14759.429, "timestamp": "04:05:59", "text": "东西。我得慢慢习惯新的"}]
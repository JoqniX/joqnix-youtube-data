[{"type": "subtitle", "time": 9974.469, "timestamp": "02:46:14", "text": "我知道这说不通，"}, {"type": "subtitle", "time": 9978.469, "timestamp": "02:46:18", "text": "男人。超人可以等等，人们只是"}, {"type": "subtitle", "time": 9981.269, "timestamp": "02:46:21", "text": "看到那些可爱的情侣，我就想，"}, {"type": "subtitle", "time": 9983.19, "timestamp": "02:46:23", "text": "你们到底为什么会这样？你们到底为什么会这样？"}, {"type": "subtitle", "time": 9985.91, "timestamp": "02:46:25", "text": "恋爱？人类可能极具毒性，而且"}, {"type": "subtitle", "time": 9987.95, "timestamp": "02:46:27", "text": "尴尬，而且一直持续到最后，就像"}, {"type": "subtitle", "time": 9994.269, "timestamp": "02:46:34", "text": "是的。但"}, {"type": "subtitle", "time": 9995.87, "timestamp": "02:46:35", "text": "再次"}, {"type": "subtitle", "time": 10010.87, "timestamp": "02:46:50", "text": "该怎么办"}]
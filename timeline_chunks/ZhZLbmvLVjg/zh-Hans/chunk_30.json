[{"type": "subtitle", "time": 1818.149, "timestamp": "00:30:18", "text": "这是例行程序吗？"}, {"type": "subtitle", "time": 1820.89, "timestamp": "00:30:20", "text": "哦，你必须是"}, {"type": "subtitle", "time": 1836.83, "timestamp": "00:30:36", "text": "嗯？哦，是的，是的"}, {"type": "subtitle", "time": 1838.83, "timestamp": "00:30:38", "text": "谜。哦，"}, {"type": "subtitle", "time": 1847.51, "timestamp": "00:30:47", "text": "我本来可以把这家伙弄过来，但是"}, {"type": "subtitle", "time": 1848.83, "timestamp": "00:30:48", "text": "我该如何获得"}, {"type": "subtitle", "time": 1850.669, "timestamp": "00:30:50", "text": "向上？得到"}, {"type": "subtitle", "time": 1853.33, "timestamp": "00:30:53", "text": "他。我可以去吗？"}, {"type": "subtitle", "time": 1855.07, "timestamp": "00:30:55", "text": "[音乐]"}, {"type": "subtitle", "time": 1857.59, "timestamp": "00:30:57", "text": "喜欢？哦，明白了。知道了。知道了。得到"}]
[{"type": "subtitle", "time": 8525.63, "timestamp": "02:22:05", "text": "那玩意儿？这里什么都没有。"}, {"type": "subtitle", "time": 8529.87, "timestamp": "02:22:09", "text": "正确的？我正在屏蔽某些词语。全部"}, {"type": "subtitle", "time": 8536.19, "timestamp": "02:22:16", "text": "呃，你知道的，"}, {"type": "subtitle", "time": 8540.07, "timestamp": "02:22:20", "text": "呃，哦对了，我忘了说我"}, {"type": "subtitle", "time": 8542.79, "timestamp": "02:22:22", "text": "我当时在测试一些汽车方面的东西。你"}, {"type": "subtitle", "time": 8545.15, "timestamp": "02:22:25", "text": "知道，这款新汽车"}, {"type": "subtitle", "time": 8547.87, "timestamp": "02:22:27", "text": "系统。我做到了"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "呃，我在这辆车里做了个新玩意儿。它是"}, {"type": "subtitle", "time": 8554.55, "timestamp": "02:22:34", "text": "实际上，是在家庭公告里。能"}, {"type": "subtitle", "time": 8561.99, "timestamp": "02:22:41", "text": "嗯，就这样。所以我这样安排了：哦，"}, {"type": "subtitle", "time": 8564.71, "timestamp": "02:22:44", "text": "等待。就在这里。必须有一个"}, {"type": "subtitle", "time": 8566.91, "timestamp": "02:22:46", "text": "你可以通过以下方式"}, {"type": "subtitle", "time": 8569.55, "timestamp": "02:22:49", "text": "这里。那里我们"}, {"type": "subtitle", "time": 8571.55, "timestamp": "02:22:51", "text": "去。"}, {"type": "subtitle", "time": 8574.55, "timestamp": "02:22:54", "text": "这里。好了。最后。不，是我做的。"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "这样一来，就不会有人能够……"}]
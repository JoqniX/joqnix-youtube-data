[{"type": "subtitle", "time": 19621.99, "timestamp": "05:27:01", "text": "那我这样做呢？我想开始我的"}, {"type": "subtitle", "time": 19630.59, "timestamp": "05:27:10", "text": "东西。我们这样做吧"}, {"type": "subtitle", "time": 19633.59, "timestamp": "05:27:13", "text": "这。全部"}, {"type": "subtitle", "time": 19641.788, "timestamp": "05:27:21", "text": "[音乐]"}, {"type": "subtitle", "time": 19644.548, "timestamp": "05:27:24", "text": "音乐。有点吵。我把它修好了。"}, {"type": "subtitle", "time": 19645.708, "timestamp": "05:27:25", "text": "你"}, {"type": "subtitle", "time": 19647.23, "timestamp": "05:27:27", "text": "伙计们。"}, {"type": "subtitle", "time": 19649.39, "timestamp": "05:27:29", "text": "但要享受"}, {"type": "subtitle", "time": 19652.35, "timestamp": "05:27:32", "text": "这"}, {"type": "subtitle", "time": 19660.19, "timestamp": "05:27:40", "text": "读。你好。怎么样？出局"}, {"type": "subtitle", "time": 19664.27, "timestamp": "05:27:44", "text": "那里。黑暗的道路通向黑暗"}, {"type": "subtitle", "time": 19667.27, "timestamp": "05:27:47", "text": "地点。这些话就是当时说的话。"}, {"type": "subtitle", "time": 19670.548, "timestamp": "05:27:50", "text": "透过杰克·哈蒂斯的思绪，他当时"}, {"type": "subtitle", "time": 19673.07, "timestamp": "05:27:53", "text": "抵达这片荒凉的土地"}, {"type": "subtitle", "time": 19676.39, "timestamp": "05:27:56", "text": "路。他来自一个黑暗的地方，一个"}, {"type": "subtitle", "time": 19678.03, "timestamp": "05:27:58", "text": "那地方并非"}]
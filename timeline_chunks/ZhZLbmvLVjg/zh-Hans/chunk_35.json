[{"type": "subtitle", "time": 2100.03, "timestamp": "00:35:00", "text": "有趣的。好的。在哪里"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "再次？她的房子应该是"}, {"type": "subtitle", "time": 2117.27, "timestamp": "00:35:17", "text": "区域。发生了什么？他们屏蔽了它"}, {"type": "subtitle", "time": 2119.99, "timestamp": "00:35:19", "text": "离开。嗯？"}, {"type": "subtitle", "time": 2122.71, "timestamp": "00:35:22", "text": "我收藏了一些关于印度的物品。"}, {"type": "subtitle", "time": 2124.91, "timestamp": "00:35:24", "text": "等等，他们把它屏蔽掉了。他们是如何做到的？"}, {"type": "subtitle", "time": 2128.59, "timestamp": "00:35:28", "text": "知道？他们怎么知道她还活着"}, {"type": "subtitle", "time": 2139.95, "timestamp": "00:35:39", "text": "尽管？搜索运算符是"}, {"type": "subtitle", "time": 2142.99, "timestamp": "00:35:42", "text": "去。他们怎么知道她还活着"}, {"type": "subtitle", "time": 2145.43, "timestamp": "00:35:45", "text": "这里？搞什么鬼？他们封锁了"}, {"type": "subtitle", "time": 2148.55, "timestamp": "00:35:48", "text": "这个地方完全是。"}]
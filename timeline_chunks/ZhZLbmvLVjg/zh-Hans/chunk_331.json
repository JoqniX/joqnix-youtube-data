[{"type": "subtitle", "time": 19860.628, "timestamp": "05:31:00", "text": "发生。杰伊想不起来自己见过什么。"}, {"type": "subtitle", "time": 19863.35, "timestamp": "05:31:03", "text": "以前从未发生过类似的事情。他的眼睛"}, {"type": "subtitle", "time": 19867.03, "timestamp": "05:31:07", "text": "在阴影附近发现了什么。它"}, {"type": "subtitle", "time": 19868.868, "timestamp": "05:31:08", "text": "看起来好像有人站着。"}, {"type": "subtitle", "time": 19871.43, "timestamp": "05:31:11", "text": "那里。那一瞬间，他似乎看到了……"}, {"type": "subtitle", "time": 19878.788, "timestamp": "05:31:18", "text": "圆形红眼，或者那里，或者曾经"}, {"type": "subtitle", "time": 19879.948, "timestamp": "05:31:19", "text": "那里"}, {"type": "subtitle", "time": 19881.628, "timestamp": "05:31:21", "text": "红色的"}, {"type": "subtitle", "time": 19885.19, "timestamp": "05:31:25", "text": "灯？他慢慢地，稍微放慢了速度。"}, {"type": "subtitle", "time": 19889.23, "timestamp": "05:31:29", "text": "但看不到更多了。所以他继续……"}, {"type": "subtitle", "time": 19891.75, "timestamp": "05:31:31", "text": "开车。他车的前灯"}, {"type": "subtitle", "time": 19894.23, "timestamp": "05:31:34", "text": "当他处于……时，他的目光不规则地闪烁着。"}, {"type": "subtitle", "time": 19897.83, "timestamp": "05:31:37", "text": "与标志牌对齐。甚至还有"}, {"type": "subtitle", "time": 19900.67, "timestamp": "05:31:40", "text": "持续几秒钟。他的收音机"}, {"type": "subtitle", "time": 19904.11, "timestamp": "05:31:44", "text": "混乱中疯狂切换频道"}, {"type": "subtitle", "time": 19907.868, "timestamp": "05:31:47", "text": "直到他克服了困难为止"}, {"type": "subtitle", "time": 19913.11, "timestamp": "05:31:53", "text": "符号。大约走了30码左右，"}, {"type": "subtitle", "time": 19915.83, "timestamp": "05:31:55", "text": "一切都恢复正常了。这"}, {"type": "subtitle", "time": 19917.868, "timestamp": "05:31:57", "text": "奇怪的事情甚至把他吵醒了"}]
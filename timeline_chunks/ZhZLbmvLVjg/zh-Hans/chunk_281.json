[{"type": "subtitle", "time": 16860.708, "timestamp": "04:41:00", "text": "想玩这个16分钟的恐怖游戏"}, {"type": "subtitle", "time": 16863.07, "timestamp": "04:41:03", "text": "一款既逼真又有点恐怖的游戏。"}, {"type": "subtitle", "time": 16867.27, "timestamp": "04:41:07", "text": "史酷比 史酷比 库比"}, {"type": "subtitle", "time": 16877.628, "timestamp": "04:41:17", "text": "很高兴"}, {"type": "subtitle", "time": 16880.55, "timestamp": "04:41:20", "text": "万圣节。哦等等，你其实可以"}, {"type": "subtitle", "time": 16883.47, "timestamp": "04:41:23", "text": "像这样打字，像这样说。"}, {"type": "subtitle", "time": 16886.55, "timestamp": "04:41:26", "text": "艾比万圣节。我的天哪，这太……"}, {"type": "subtitle", "time": 16889.91, "timestamp": "04:41:29", "text": "很有创意，而且非常可爱。我刚刚搬了我的"}, {"type": "subtitle", "time": 16899.788, "timestamp": "04:41:39", "text": "[音乐]"}, {"type": "subtitle", "time": 16903.27, "timestamp": "04:41:43", "text": "那。是的。嗯，老兄，说实话"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "骷髅欢迎。这是你第一次，"}, {"type": "subtitle", "time": 16915.51, "timestamp": "04:41:55", "text": "正确的？这是你第一次来我家吗？"}, {"type": "subtitle", "time": 16918.628, "timestamp": "04:41:58", "text": "教会直播？这是你第一次吗？"}]
[{"type": "subtitle", "time": 1338.43, "timestamp": "00:22:18", "text": "我的天啊。我逃出来了。"}, {"type": "subtitle", "time": 1346.87, "timestamp": "00:22:26", "text": "我可能是个笨蛋，但我至少……"}, {"type": "subtitle", "time": 1349.27, "timestamp": "00:22:29", "text": "请记住我的宠物。我记得，但是"}, {"type": "subtitle", "time": 1350.51, "timestamp": "00:22:30", "text": "有这么多"}, {"type": "subtitle", "time": 1352.51, "timestamp": "00:22:32", "text": "很多。好的，"}, {"type": "subtitle", "time": 1356.39, "timestamp": "00:22:36", "text": "新。我记得现在的那些，"}, {"type": "subtitle", "time": 1359.51, "timestamp": "00:22:39", "text": "呃，还有老一辈人。那是"}, {"type": "subtitle", "time": 1361.549, "timestamp": "00:22:41", "text": "喜欢"}, {"type": "subtitle", "time": 1364.35, "timestamp": "00:22:44", "text": "一代。发电量上限是多少？"}, {"type": "subtitle", "time": 1367.51, "timestamp": "00:22:47", "text": "再次？凯伦小猫。我喜欢猫。"}, {"type": "subtitle", "time": 1368.669, "timestamp": "00:22:48", "text": "我有"}, {"type": "subtitle", "time": 1373.909, "timestamp": "00:22:53", "text": "产科。 H. 所以，一、二、三、四、五。"}, {"type": "subtitle", "time": 1377.909, "timestamp": "00:22:57", "text": "等等，不对。是五还是四？ 1 2 3. 如果"}]
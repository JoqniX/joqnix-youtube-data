[{"type": "subtitle", "time": 19261.23, "timestamp": "05:21:01", "text": "[音乐]"}, {"type": "subtitle", "time": 19264.03, "timestamp": "05:21:04", "text": "这"}, {"type": "subtitle", "time": 19266.59, "timestamp": "05:21:06", "text": "窥视幽灵粉笔"}, {"type": "subtitle", "time": 19271.39, "timestamp": "05:21:11", "text": "弧。想象一下鬼魂就像……"}, {"type": "subtitle", "time": 19273.51, "timestamp": "05:21:13", "text": "星座。那太好了。"}, {"type": "subtitle", "time": 19274.99, "timestamp": "05:21:14", "text": "确实如此。"}, {"type": "subtitle", "time": 19279.99, "timestamp": "05:21:19", "text": "好的。好的，我这就去做。"}, {"type": "subtitle", "time": 19282.788, "timestamp": "05:21:22", "text": "你知道吗？我刚刚意识到，如果我喜欢"}, {"type": "subtitle", "time": 19287.59, "timestamp": "05:21:27", "text": "把精力放在其他事情上吧，我甚至不会……"}, {"type": "subtitle", "time": 19290.07, "timestamp": "05:21:30", "text": "把我的一切都献给溪流。我太"}, {"type": "subtitle", "time": 19293.43, "timestamp": "05:21:33", "text": "当然。发生了很多事，呃……"}, {"type": "subtitle", "time": 19297.99, "timestamp": "05:21:37", "text": "其他地方，呃，我就想，“哦，天哪。”"}, {"type": "subtitle", "time": 19299.75, "timestamp": "05:21:39", "text": "有时候我真的希望我能"}, {"type": "subtitle", "time": 19303.15, "timestamp": "05:21:43", "text": "嗯……"}, {"type": "subtitle", "time": 19307.27, "timestamp": "05:21:47", "text": "嗯，是的，有时候，哦，我刚才是不是关掉了？"}, {"type": "subtitle", "time": 19311.11, "timestamp": "05:21:51", "text": "好的，这个读书网站"}, {"type": "subtitle", "time": 19313.35, "timestamp": "05:21:53", "text": "咱们来选选你们喜欢的故事吧"}, {"type": "subtitle", "time": 19315.19, "timestamp": "05:21:55", "text": "想要"}, {"type": "subtitle", "time": 19317.35, "timestamp": "05:21:57", "text": "呃，你们觉得哪个舒服？"}]
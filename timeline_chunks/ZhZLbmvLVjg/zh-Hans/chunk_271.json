[{"type": "subtitle", "time": 16262.309, "timestamp": "04:31:02", "text": "我知道，就像轻微的脚步声一样。"}, {"type": "subtitle", "time": 16265.189, "timestamp": "04:31:05", "text": "尖叫吧，在那种时刻。哦，天哪，因为"}, {"type": "subtitle", "time": 16269.149, "timestamp": "04:31:09", "text": "我真的不擅长哦"}, {"type": "subtitle", "time": 16272.269, "timestamp": "04:31:12", "text": "上帝。是的。"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "嗯，我不想做那种大事。"}, {"type": "subtitle", "time": 16278.229, "timestamp": "04:31:18", "text": "要么赢，要么不赢。我的意思是，我可以"}, {"type": "subtitle", "time": 16284.07, "timestamp": "04:31:24", "text": "可以试着做个……你知道的……嗯……我"}, {"type": "subtitle", "time": 16287.429, "timestamp": "04:31:27", "text": "可以尝试做一款恐怖游戏，但我想要"}, {"type": "subtitle", "time": 16290.71, "timestamp": "04:31:30", "text": "一件并不算大的事。不，不是"}, {"type": "subtitle", "time": 16294.67, "timestamp": "04:31:34", "text": "不大。我的意思是，不是那样。"}, {"type": "subtitle", "time": 16300.269, "timestamp": "04:31:40", "text": "嗯……它叫什么？并非如此"}, {"type": "subtitle", "time": 16303.67, "timestamp": "04:31:43", "text": "嗯……它叫什么？也不尽然。"}, {"type": "subtitle", "time": 16305.91, "timestamp": "04:31:45", "text": "有点像那种不大不小的，你知道的"}, {"type": "subtitle", "time": 16307.149, "timestamp": "04:31:47", "text": "但简短"}, {"type": "subtitle", "time": 16309.99, "timestamp": "04:31:49", "text": "短片是唯一一款进入我视野的游戏"}, {"type": "subtitle", "time": 16313.349, "timestamp": "04:31:53", "text": "注意别尖叫什么的"}, {"type": "subtitle", "time": 16314.83, "timestamp": "04:31:54", "text": "那是16分钟"}]
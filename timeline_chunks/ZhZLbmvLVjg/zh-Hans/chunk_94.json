[{"type": "subtitle", "time": 5645.95, "timestamp": "01:34:05", "text": "死。所以，我们结束了游戏。"}, {"type": "subtitle", "time": 5649.59, "timestamp": "01:34:09", "text": "更多的。我让它在后面运行。呃"}, {"type": "subtitle", "time": 5652.149, "timestamp": "01:34:12", "text": "我让它运行下去。我想阅读所有……"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "人名。不读人名"}, {"type": "subtitle", "time": 5656.189, "timestamp": "01:34:16", "text": "但"}, {"type": "subtitle", "time": 5660.55, "timestamp": "01:34:20", "text": "查看更多。所以，你觉得怎么样？"}, {"type": "subtitle", "time": 5663.669, "timestamp": "01:34:23", "text": "尽管？你喜欢那只流浪狗吗？游戏"}, {"type": "subtitle", "time": 5667.03, "timestamp": "01:34:27", "text": "迷路了吗？说实话，我挺享受的。"}, {"type": "subtitle", "time": 5671.75, "timestamp": "01:34:31", "text": "很多。我非常喜欢它。等待，"}, {"type": "subtitle", "time": 5673.75, "timestamp": "01:34:33", "text": "这里面有很多印度名字"}, {"type": "subtitle", "time": 5675.31, "timestamp": "01:34:35", "text": "学分。"}, {"type": "subtitle", "time": 5678.43, "timestamp": "01:34:38", "text": "什么？什么？有很多印度人"}, {"type": "subtitle", "time": 5681.229, "timestamp": "01:34:41", "text": "姓名。哇。"}, {"type": "subtitle", "time": 5683.709, "timestamp": "01:34:43", "text": "看"}, {"type": "subtitle", "time": 5686.35, "timestamp": "01:34:46", "text": "到处都是卡瓦伊。试玩"}, {"type": "subtitle", "time": 5688.629, "timestamp": "01:34:48", "text": "蓟。哦，他们放了"}, {"type": "subtitle", "time": 5692.43, "timestamp": "01:34:52", "text": "也给游戏测试员起了名字。该死。"}, {"type": "subtitle", "time": 5698.99, "timestamp": "01:34:58", "text": "知道。是的，我真的很喜欢这个"}]
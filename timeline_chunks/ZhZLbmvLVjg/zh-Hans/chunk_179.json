[{"type": "subtitle", "time": 10740.389, "timestamp": "02:59:00", "text": "原本应该是一家霓虹灯闪烁的地方。所以这是"}, {"type": "subtitle", "time": 10741.15, "timestamp": "02:59:01", "text": "不是"}, {"type": "subtitle", "time": 10745.63, "timestamp": "02:59:05", "text": "它。搜索。所以我们需要找个地方"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "里面。所以我们需要闯入一些房屋"}, {"type": "subtitle", "time": 10750.03, "timestamp": "02:59:10", "text": "我"}, {"type": "subtitle", "time": 10770.269, "timestamp": "02:59:30", "text": "向上。那是一个空旷的地方吗？"}, {"type": "subtitle", "time": 10774.59, "timestamp": "02:59:34", "text": "等等，我可以……哦，等等。它还没开门。"}, {"type": "subtitle", "time": 10777.51, "timestamp": "02:59:37", "text": "好吧，应该有个地方我可以……"}, {"type": "subtitle", "time": 10785.349, "timestamp": "02:59:45", "text": "[音乐]"}, {"type": "subtitle", "time": 10797.51, "timestamp": "02:59:57", "text": "那里。什么是聪明？我的天哪，我"}, {"type": "subtitle", "time": 10799.269, "timestamp": "02:59:59", "text": "学习新单词。什么是绒毛？等待，"}]
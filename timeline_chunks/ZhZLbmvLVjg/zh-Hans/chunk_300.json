[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "第一次。我不明白为什么人们……"}, {"type": "subtitle", "time": 18007.47, "timestamp": "05:00:07", "text": "感觉就像被毁了一样"}, {"type": "subtitle", "time": 18010.91, "timestamp": "05:00:10", "text": "一个更大的原因"}, {"type": "subtitle", "time": 18024.83, "timestamp": "05:00:24", "text": "也？"}, {"type": "subtitle", "time": 18027.83, "timestamp": "05:00:27", "text": "爸爸，你并不像你想要的东西。"}, {"type": "subtitle", "time": 18031.99, "timestamp": "05:00:31", "text": "比其他任何人都更挺身而出"}, {"type": "subtitle", "time": 18035.11, "timestamp": "05:00:35", "text": "还是别的什么？哦，我刚刚意识到我"}, {"type": "subtitle", "time": 18037.628, "timestamp": "05:00:37", "text": "Discord 实际上就像"}, {"type": "subtitle", "time": 18041.83, "timestamp": "05:00:41", "text": "嗯，数量居然还在增加，是吗？"}, {"type": "subtitle", "time": 18043.31, "timestamp": "05:00:43", "text": "其中"}, {"type": "subtitle", "time": 18058.07, "timestamp": "05:00:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 19980.15, "timestamp": "05:33:00", "text": "那边有台机器。如果发生奇怪的事件"}, {"type": "subtitle", "time": 19988.43, "timestamp": "05:33:08", "text": "如果他们都同意，那就没问题了。"}, {"type": "subtitle", "time": 19990.548, "timestamp": "05:33:10", "text": "继续。狗狗在干什么？我们是"}, {"type": "subtitle", "time": 20002.47, "timestamp": "05:33:22", "text": "故事。疲惫的男人不停地环顾四周。"}, {"type": "subtitle", "time": 20004.548, "timestamp": "05:33:24", "text": "看看他能否破坏一些初始的东西。"}, {"type": "subtitle", "time": 20006.47, "timestamp": "05:33:26", "text": "在树林之间。他看不见"}, {"type": "subtitle", "time": 20008.788, "timestamp": "05:33:28", "text": "任何不寻常的事情。有"}, {"type": "subtitle", "time": 20012.67, "timestamp": "05:33:32", "text": "到处只有橡树和枫树。他"}, {"type": "subtitle", "time": 20015.35, "timestamp": "05:33:35", "text": "周围环绕着茂盛的植被。"}, {"type": "subtitle", "time": 20018.47, "timestamp": "05:33:38", "text": "两侧都有道路。黑暗部分"}, {"type": "subtitle", "time": 20021.51, "timestamp": "05:33:41", "text": "他感到不安。他不得不放慢速度，"}, {"type": "subtitle", "time": 20024.91, "timestamp": "05:33:44", "text": "驾车经过时要格外小心。"}, {"type": "subtitle", "time": 20029.23, "timestamp": "05:33:49", "text": "光线照射到的部分"}, {"type": "subtitle", "time": 20031.91, "timestamp": "05:33:51", "text": "出去。加油站出现在前方"}]
[{"type": "subtitle", "time": 17942.868, "timestamp": "04:59:02", "text": "哦，等等。什么？等待。为什么每个人都……"}, {"type": "subtitle", "time": 17945.35, "timestamp": "04:59:05", "text": "用户名是问句吗？感叹"}, {"type": "subtitle", "time": 17948.19, "timestamp": "04:59:08", "text": "标记。嗯？"}, {"type": "subtitle", "time": 17951.708, "timestamp": "04:59:11", "text": "等待。嗯？什么？发生了什么？"}, {"type": "subtitle", "time": 17955.07, "timestamp": "04:59:15", "text": "等待。天哪，我没做日志。"}, {"type": "subtitle", "time": 17960.31, "timestamp": "04:59:20", "text": "哦，只有我写了那份日志。我会说哦，"}, {"type": "subtitle", "time": 17964.07, "timestamp": "04:59:24", "text": "我没看到你是否已经完成了"}, {"type": "subtitle", "time": 17966.708, "timestamp": "04:59:26", "text": "你自己。你以为我不聪明吗？"}, {"type": "subtitle", "time": 17968.948, "timestamp": "04:59:28", "text": "足以构建我的高级登录系统"}, {"type": "subtitle", "time": 17972.15, "timestamp": "04:59:32", "text": "在 Discord 上吗？我做的是基础版。"}, {"type": "subtitle", "time": 17975.19, "timestamp": "04:59:35", "text": "好吧，你是在逗我玩吗？你"}, {"type": "subtitle", "time": 17977.99, "timestamp": "04:59:37", "text": "真的做到了。我的天啊。你呢"}, {"type": "subtitle", "time": 17982.27, "timestamp": "04:59:42", "text": "这让我很担心。我们稍后会解释。"}, {"type": "subtitle", "time": 17985.948, "timestamp": "04:59:45", "text": "为什么？你喜欢这样做吗？"}, {"type": "subtitle", "time": 17990.07, "timestamp": "04:59:50", "text": "我的天哪，这太吓人了。我"}, {"type": "subtitle", "time": 17992.868, "timestamp": "04:59:52", "text": "感觉就像我知道我们找到了彼此"}, {"type": "subtitle", "time": 17994.31, "timestamp": "04:59:54", "text": "因为这件事，其他人第一次有了这种经历。"}, {"type": "subtitle", "time": 17997.708, "timestamp": "04:59:57", "text": "这。是的。是的。有很多"}, {"type": "subtitle", "time": 17999.99, "timestamp": "04:59:59", "text": "人们正在寻找彼此"}]
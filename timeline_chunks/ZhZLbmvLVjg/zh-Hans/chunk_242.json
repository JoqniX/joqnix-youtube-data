[{"type": "subtitle", "time": 14520.75, "timestamp": "04:02:00", "text": "实际上，直播是在周五。"}, {"type": "subtitle", "time": 14523.75, "timestamp": "04:02:03", "text": "是的，我周五可能不会直播。患病的"}, {"type": "subtitle", "time": 14525.59, "timestamp": "04:02:05", "text": "周五和周六休息一天，我们将"}, {"type": "subtitle", "time": 14528.63, "timestamp": "04:02:08", "text": "进行直播。还有星期天。如果事情进展顺利"}, {"type": "subtitle", "time": 14533.229, "timestamp": "04:02:13", "text": "嗯，我大概会用VPN。"}, {"type": "subtitle", "time": 14535.75, "timestamp": "04:02:15", "text": "猜测。所以，我将进行一次测试直播。"}, {"type": "subtitle", "time": 14538.71, "timestamp": "04:02:18", "text": "比利比利。我想我会这么做。"}, {"type": "subtitle", "time": 14540.87, "timestamp": "04:02:20", "text": "我会把链接之类的东西发给你。"}, {"type": "subtitle", "time": 14543.429, "timestamp": "04:02:23", "text": "是的，慢慢来，我们会……"}, {"type": "subtitle", "time": 14547.269, "timestamp": "04:02:27", "text": "Billy Billy Billy 的东西呃，结束了。"}, {"type": "subtitle", "time": 14549.83, "timestamp": "04:02:29", "text": "我还没录视频呢。"}, {"type": "subtitle", "time": 14551.87, "timestamp": "04:02:31", "text": "即在"}, {"type": "subtitle", "time": 14555.11, "timestamp": "04:02:35", "text": "豪宅，但确实，这很痛苦"}, {"type": "subtitle", "time": 14557.349, "timestamp": "04:02:37", "text": "仔细想想，介绍那部分"}, {"type": "subtitle", "time": 14560.349, "timestamp": "04:02:40", "text": "我从未接触过虚拟主播。"}, {"type": "subtitle", "time": 14564.63, "timestamp": "04:02:44", "text": "一方面觉得有点怪，但另一方面我又觉得……"}, {"type": "subtitle", "time": 14569.11, "timestamp": "04:02:49", "text": "很高兴你不是V2，但却完全符合我的要求。"}, {"type": "subtitle", "time": 14574.51, "timestamp": "04:02:54", "text": "既可以像使用 PNG 格式，也可以像使用 3D 模型一样使用"}, {"type": "subtitle", "time": 14577.269, "timestamp": "04:02:57", "text": "对，但我没有。不，我的一部分。"}, {"type": "subtitle", "time": 14578.469, "timestamp": "04:02:58", "text": "不想做虚拟主播。"}]
[{"type": "subtitle", "time": 4080.63, "timestamp": "01:08:00", "text": "这个可怜的家伙似乎很无情。"}, {"type": "subtitle", "time": 4082.19, "timestamp": "01:08:02", "text": "最终走向反抗"}, {"type": "subtitle", "time": 4085.51, "timestamp": "01:08:05", "text": "他们。他后来怎么样了？他们有"}, {"type": "subtitle", "time": 4087.349, "timestamp": "01:08:07", "text": "完全抹去所有情绪，没有"}, {"type": "subtitle", "time": 4089.51, "timestamp": "01:08:09", "text": "拥有自我意识，但不再拥有记忆。我们开始吧"}, {"type": "subtitle", "time": 4092.069, "timestamp": "01:08:12", "text": "我们千万别被抓住了。哦，那个"}, {"type": "subtitle", "time": 4095.07, "timestamp": "01:08:15", "text": "那是我最后的记忆。最后一个名额。"}, {"type": "subtitle", "time": 4097.349, "timestamp": "01:08:17", "text": "好的。继续收集"}, {"type": "subtitle", "time": 4115.07, "timestamp": "01:08:35", "text": "这。全部"}, {"type": "subtitle", "time": 4117.55, "timestamp": "01:08:37", "text": "正确的。我们"}, {"type": "subtitle", "time": 4119.42, "timestamp": "01:08:39", "text": "降低两个"}, {"type": "subtitle", "time": 4121.709, "timestamp": "01:08:41", "text": "[音乐]"}, {"type": "subtitle", "time": 4124.43, "timestamp": "01:08:44", "text": "他们。我们降低了这两个"}, {"type": "subtitle", "time": 4127.789, "timestamp": "01:08:47", "text": "他们。进入"}, {"type": "subtitle", "time": 4129.63, "timestamp": "01:08:49", "text": "这里。做"}, {"type": "subtitle", "time": 4138.99, "timestamp": "01:08:58", "text": "我回来了，关门了"}]
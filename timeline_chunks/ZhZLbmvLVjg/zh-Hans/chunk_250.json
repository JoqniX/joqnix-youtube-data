[{"type": "subtitle", "time": 15002.67, "timestamp": "04:10:02", "text": "角状物。我的天啊。什么？"}, {"type": "subtitle", "time": 15007.63, "timestamp": "04:10:07", "text": "什么？我本来应该说我是"}, {"type": "subtitle", "time": 15012.59, "timestamp": "04:10:12", "text": "打哈欠。我为什么会发出声音？哦，我的"}, {"type": "subtitle", "time": 15022.55, "timestamp": "04:10:22", "text": "今天有人吗？回头见！"}, {"type": "subtitle", "time": 15026.87, "timestamp": "04:10:26", "text": "明天。也就是说，就在周六。你好。"}, {"type": "subtitle", "time": 15029.269, "timestamp": "04:10:29", "text": "下次我再告诉你们的时候，"}, {"type": "subtitle", "time": 15031.59, "timestamp": "04:10:31", "text": "将在推特和Discord上发布更新。"}, {"type": "subtitle", "time": 15033.309, "timestamp": "04:10:33", "text": "以及"}, {"type": "subtitle", "time": 15052.309, "timestamp": "04:10:52", "text": "如果你正在锁定，仍然在锁定"}, {"type": "subtitle", "time": 15055.189, "timestamp": "04:10:55", "text": "你去看另一个直播之类的。"}, {"type": "subtitle", "time": 15057.11, "timestamp": "04:10:57", "text": "别忘了支持他们哦"}, {"type": "subtitle", "time": 15059.99, "timestamp": "04:10:59", "text": "给他们舒适的头垫，"}]
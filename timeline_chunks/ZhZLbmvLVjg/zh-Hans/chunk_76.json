[{"type": "subtitle", "time": 4562.669, "timestamp": "01:16:02", "text": "不，我喜欢这种电子音乐。"}, {"type": "subtitle", "time": 4564.41, "timestamp": "01:16:04", "text": "音乐。所以"}, {"type": "subtitle", "time": 4566.27, "timestamp": "01:16:06", "text": "[音乐]"}, {"type": "subtitle", "time": 4582.79, "timestamp": "01:16:22", "text": "地铁。魔法并没有帮助我。"}, {"type": "subtitle", "time": 4585.669, "timestamp": "01:16:25", "text": "事情。你什么也没得到。哦，让我们"}, {"type": "subtitle", "time": 4588.669, "timestamp": "01:16:28", "text": "让我重燃希望。我们"}, {"type": "subtitle", "time": 4591.55, "timestamp": "01:16:31", "text": "希望。是的，我们希望如此。我们有"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "希望。我不预订。将会是"}, {"type": "subtitle", "time": 4596.07, "timestamp": "01:16:36", "text": "美好的。"}, {"type": "subtitle", "time": 4599.709, "timestamp": "01:16:39", "text": "现在我不会了，因为我们相信我们"}, {"type": "subtitle", "time": 4606.47, "timestamp": "01:16:46", "text": "是的。无论如何都会发生"}, {"type": "subtitle", "time": 4610.35, "timestamp": "01:16:50", "text": "发生什么事？是的。呃，我们继续前进"}, {"type": "subtitle", "time": 4619.63, "timestamp": "01:16:59", "text": "任何事物。那就是他"}]
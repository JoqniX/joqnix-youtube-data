[{"type": "subtitle", "time": 7751.51, "timestamp": "02:09:11", "text": "他从来不打电话，也从来不给自己打电话。"}, {"type": "subtitle", "time": 7754.35, "timestamp": "02:09:14", "text": "又是Necco。"}, {"type": "subtitle", "time": 7756.149, "timestamp": "02:09:16", "text": "[音乐]"}, {"type": "subtitle", "time": 7758.51, "timestamp": "02:09:18", "text": "我不是说我不会打电话。"}, {"type": "subtitle", "time": 7762.189, "timestamp": "02:09:22", "text": "我。我现在是"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "教练。看着我。我有耳朵。喵。"}, {"type": "subtitle", "time": 7767.589, "timestamp": "02:09:27", "text": "喵。喵。哦，发生了什么事？"}, {"type": "subtitle", "time": 7768.47, "timestamp": "02:09:28", "text": "模型？"}, {"type": "subtitle", "time": 7771.149, "timestamp": "02:09:31", "text": "[音乐]"}]
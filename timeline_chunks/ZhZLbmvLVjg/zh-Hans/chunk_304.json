[{"type": "subtitle", "time": 18247.31, "timestamp": "05:04:07", "text": "[音乐]"}, {"type": "subtitle", "time": 18251.788, "timestamp": "05:04:11", "text": "对我有好处。你好。是的。你好，"}, {"type": "subtitle", "time": 18255.02, "timestamp": "05:04:15", "text": "忍者。希望你一切都好。快乐的"}, {"type": "subtitle", "time": 18256.51, "timestamp": "05:04:16", "text": "[音乐]"}, {"type": "subtitle", "time": 18258.99, "timestamp": "05:04:18", "text": "万圣节。氢"}, {"type": "subtitle", "time": 18262.39, "timestamp": "05:04:22", "text": "嗯，我有一些想做的事情。"}, {"type": "subtitle", "time": 18264.75, "timestamp": "05:04:24", "text": "但我也想放松一下"}, {"type": "subtitle", "time": 18266.99, "timestamp": "05:04:26", "text": "今天不知道"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "为什么我的一部分想说我"}, {"type": "subtitle", "time": 18271.31, "timestamp": "05:04:31", "text": "工作"}, {"type": "subtitle", "time": 18275.27, "timestamp": "05:04:35", "text": "虽然很努力，但我并不认为我真的努力工作了。"}, {"type": "subtitle", "time": 18276.91, "timestamp": "05:04:36", "text": "但就像有母亲一样"}, {"type": "subtitle", "time": 18281.15, "timestamp": "05:04:41", "text": "妈妈，你知道吗，所以我当时"}, {"type": "subtitle", "time": 18284.99, "timestamp": "05:04:44", "text": "就像我最初的想法一样"}, {"type": "subtitle", "time": 18286.05, "timestamp": "05:04:46", "text": "到"}, {"type": "subtitle", "time": 18287.788, "timestamp": "05:04:47", "text": "[音乐]"}, {"type": "subtitle", "time": 18290.31, "timestamp": "05:04:50", "text": "嗯，我最初的想法是喜欢"}, {"type": "subtitle", "time": 18296.788, "timestamp": "05:04:56", "text": "嗯，我最初的想法是字面意义上的"}, {"type": "subtitle", "time": 18299.15, "timestamp": "05:04:59", "text": "你管它叫什么？"}]
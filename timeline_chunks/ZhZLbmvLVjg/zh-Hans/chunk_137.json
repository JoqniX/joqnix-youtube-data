[{"type": "subtitle", "time": 8223.309, "timestamp": "02:17:03", "text": "胸罩发出喵喵声"}, {"type": "subtitle", "time": 8238.19, "timestamp": "02:17:18", "text": "到。他很久以前就开始搞这个兄弟帮派了。"}, {"type": "subtitle", "time": 8258.549, "timestamp": "02:17:38", "text": "好了，我们把这件事弄清楚了。是否有任何"}, {"type": "subtitle", "time": 8272.07, "timestamp": "02:17:52", "text": "正确的？你们让我心跳加速。如何"}]
[{"type": "chat", "time": 600.559, "timestamp": "00:10:00", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "nah, audio is fine"}, {"type": "subtitle", "time": 602.19, "timestamp": "00:10:02", "text": "准备睡觉。看着我入睡吧。"}, {"type": "subtitle", "time": 606.15, "timestamp": "00:10:06", "text": "什么？哦"}, {"type": "subtitle", "time": 608.23, "timestamp": "00:10:08", "text": "我打开电脑，看到的就是这个画面。好的。"}, {"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "未来会怎样？"}, {"type": "subtitle", "time": 616.15, "timestamp": "00:10:16", "text": "当前笑话被否压制"}, {"type": "subtitle", "time": 619.19, "timestamp": "00:10:19", "text": "实验。音频是否像……"}, {"type": "subtitle", "time": 621.67, "timestamp": "00:10:21", "text": "当我说话的时候，音量会降低。好的。"}, {"type": "subtitle", "time": 624.31, "timestamp": "00:10:24", "text": "我只记得凌晨一点就睡着了。我是"}, {"type": "subtitle", "time": 627.91, "timestamp": "00:10:27", "text": "正在尝试调整音频插头"}, {"type": "subtitle", "time": 629.91, "timestamp": "00:10:29", "text": "然后出去散步，应该……"}, {"type": "subtitle", "time": 632.23, "timestamp": "00:10:32", "text": "躲闪。我今天开车太疯狂了。不是"}, {"type": "subtitle", "time": 634.23, "timestamp": "00:10:34", "text": "大幅增加，但也有一点点。是的，"}, {"type": "chat", "time": 634.603, "timestamp": "00:10:34", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "i feel its fine cuz we can listen to u clearly then"}, {"type": "subtitle", "time": 636.87, "timestamp": "00:10:36", "text": "我超级兴奋，而且……呃……"}, {"type": "subtitle", "time": 639.15, "timestamp": "00:10:39", "text": "我听到超级超级"}, {"type": "chat", "time": 639.67, "timestamp": "00:10:39", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "and make out who's speaking"}, {"type": "subtitle", "time": 646.47, "timestamp": "00:10:46", "text": "是的。对，上次直播，就是昨天的直播。"}, {"type": "subtitle", "time": 650.03, "timestamp": "00:10:50", "text": "直播，我们做了呃流浪第一部分。"}, {"type": "subtitle", "time": 652.389, "timestamp": "00:10:52", "text": "流浪。是的。是的，它运行正常。它是"}, {"type": "subtitle", "time": 654.15, "timestamp": "00:10:54", "text": "好的。很好。很好。我将"}, {"type": "subtitle", "time": 657.509, "timestamp": "00:10:57", "text": "公开。享受。再见。积分制"}]
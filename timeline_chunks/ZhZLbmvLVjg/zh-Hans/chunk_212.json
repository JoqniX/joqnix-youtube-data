[{"type": "subtitle", "time": 12721.79, "timestamp": "03:32:01", "text": "不，让我"}, {"type": "subtitle", "time": 12760.79, "timestamp": "03:32:40", "text": "糖。我差点就说“巴”了。哦"}, {"type": "subtitle", "time": 12769.229, "timestamp": "03:32:49", "text": "呃"}, {"type": "subtitle", "time": 12772.269, "timestamp": "03:32:52", "text": "现在我保留，不，我保留"}, {"type": "subtitle", "time": 12774.469, "timestamp": "03:32:54", "text": "uhabooga 因为它具有意义"}, {"type": "subtitle", "time": 12777.269, "timestamp": "03:32:57", "text": "我。我看到我的名字就是我。如果他们有"}, {"type": "subtitle", "time": 12779.83, "timestamp": "03:32:59", "text": "他们见过我，就嘲笑我，还读我的日记。"}]
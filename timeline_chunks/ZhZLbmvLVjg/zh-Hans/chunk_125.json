[{"type": "subtitle", "time": 7501.83, "timestamp": "02:05:01", "text": "尽管？他可能只是把你抓伤而已。"}, {"type": "subtitle", "time": 7502.91, "timestamp": "02:05:02", "text": "因为你"}, {"type": "subtitle", "time": 7507.07, "timestamp": "02:05:07", "text": "疼痛。那件事很可疑。第二，他将"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "咬。要刻薄。哦，尼奥可以像这样"}, {"type": "subtitle", "time": 7518.669, "timestamp": "02:05:18", "text": "我怀疑我的"}, {"type": "subtitle", "time": 7522.07, "timestamp": "02:05:22", "text": "怀疑。是的。是的，没错。"}, {"type": "subtitle", "time": 7524.79, "timestamp": "02:05:24", "text": "确切地。好吧，我选狮子座。但"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "另外，我也喜欢武士刀。武士。所以，"}, {"type": "subtitle", "time": 7529.95, "timestamp": "02:05:29", "text": "你知道吗？因为我们正在玩游戏"}, {"type": "subtitle", "time": 7532.76, "timestamp": "02:05:32", "text": "我会选择玩游戏。"}, {"type": "subtitle", "time": 7533.87, "timestamp": "02:05:33", "text": "[音乐]"}, {"type": "subtitle", "time": 7558.03, "timestamp": "02:05:58", "text": "是的，你是喜欢看的neca。"}]
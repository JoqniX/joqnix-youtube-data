[{"type": "subtitle", "time": 1082.99, "timestamp": "00:18:02", "text": "他嘿嘿嘿发动了猛攻。"}, {"type": "subtitle", "time": 1086.86, "timestamp": "00:18:06", "text": "哦，早起吃早餐了。"}, {"type": "subtitle", "time": 1089.789, "timestamp": "00:18:09", "text": "[音乐]"}, {"type": "subtitle", "time": 1092.99, "timestamp": "00:18:12", "text": "你好。我已经吃过早餐了。"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "7:00。我呃，从那个地方回来了。"}, {"type": "subtitle", "time": 1100.87, "timestamp": "00:18:20", "text": "然后我们就从那里把它吃了。是的。开始"}, {"type": "subtitle", "time": 1109.43, "timestamp": "00:18:29", "text": "继续。等待。我可以选择章节"}, {"type": "subtitle", "time": 1112.15, "timestamp": "00:18:32", "text": "从该存档文件中读取。如果我回去呢？"}, {"type": "subtitle", "time": 1119.82, "timestamp": "00:18:39", "text": "错过了？我可以做到"}, {"type": "subtitle", "time": 1122.029, "timestamp": "00:18:42", "text": "[音乐]"}, {"type": "subtitle", "time": 1128.39, "timestamp": "00:18:48", "text": "看。他就像在说话一样。他真是个真人"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "他。真正的内向者。外向型"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "实际上。"}]
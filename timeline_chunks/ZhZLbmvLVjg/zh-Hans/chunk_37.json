[{"type": "subtitle", "time": 2229.75, "timestamp": "00:37:09", "text": "迅速的？我得走了，不过我会回来的。"}, {"type": "subtitle", "time": 2231.71, "timestamp": "00:37:11", "text": "你好。小心。拿"}, {"type": "subtitle", "time": 2250.39, "timestamp": "00:37:30", "text": "B2 的 Clementine 位于中间。"}, {"type": "subtitle", "time": 2255.069, "timestamp": "00:37:35", "text": "共有四个符号。标志。"}, {"type": "subtitle", "time": 2260.349, "timestamp": "00:37:40", "text": "[音乐]"}, {"type": "subtitle", "time": 2263.43, "timestamp": "00:37:43", "text": "植物。好的。一、二、三、四。"}, {"type": "subtitle", "time": 2266.15, "timestamp": "00:37:46", "text": "第四个是熔岩灯。第三个是"}, {"type": "subtitle", "time": 2269.43, "timestamp": "00:37:49", "text": "就像桌子支架一样。桌子上的东西"}, {"type": "subtitle", "time": 2272.23, "timestamp": "00:37:52", "text": "或者某种带腿的东西。二就像"}, {"type": "subtitle", "time": 2275.31, "timestamp": "00:37:55", "text": "某种华丽的茶壶"}, {"type": "subtitle", "time": 2278.91, "timestamp": "00:37:58", "text": "东西。一个就像洋葱放在上面"}]
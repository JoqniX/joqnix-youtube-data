[{"type": "subtitle", "time": 5890.75, "timestamp": "01:38:10", "text": "实际上。稍等"}, {"type": "subtitle", "time": 5894.87, "timestamp": "01:38:14", "text": "分钟。那是不是意味着我……哦，我全都明白了"}, {"type": "subtitle", "time": 5896.27, "timestamp": "01:38:16", "text": "那些回忆。"}, {"type": "subtitle", "time": 5898.91, "timestamp": "01:38:18", "text": "是的，"}, {"type": "subtitle", "time": 5902.629, "timestamp": "01:38:22", "text": "呃，我相信我可以回去。"}, {"type": "subtitle", "time": 5907.629, "timestamp": "01:38:27", "text": "重启类别。所以我就想，算了"}, {"type": "subtitle", "time": 5909.47, "timestamp": "01:38:29", "text": "关于我们"}, {"type": "subtitle", "time": 5918.189, "timestamp": "01:38:38", "text": "是的。所以我们需要找到我呃"}, {"type": "subtitle", "time": 5922.75, "timestamp": "01:38:42", "text": "第三个呃记忆体，我没有"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "收集。是的。你好。是的，欢迎"}, {"type": "subtitle", "time": 5928.87, "timestamp": "01:38:48", "text": "后退。游戏结束了。所以，我们是"}, {"type": "subtitle", "time": 5931.83, "timestamp": "01:38:51", "text": "我们正在做的就像是……呃，得到所有……"}, {"type": "subtitle", "time": 5937.47, "timestamp": "01:38:57", "text": "缅怀逝去的B12"}, {"type": "subtitle", "time": 5939.229, "timestamp": "01:38:59", "text": "离开。"}]
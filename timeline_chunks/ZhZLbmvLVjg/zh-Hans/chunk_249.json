[{"type": "subtitle", "time": 14942.309, "timestamp": "04:09:02", "text": "你们可以通过点赞和分享赚取积分。"}, {"type": "subtitle", "time": 14944.95, "timestamp": "04:09:04", "text": "我有一个适用于两者的通用积分系统。"}, {"type": "subtitle", "time": 14946.189, "timestamp": "04:09:06", "text": "Twitch 和"}, {"type": "subtitle", "time": 14949.469, "timestamp": "04:09:09", "text": "YouTube。你好。"}, {"type": "subtitle", "time": 14953.429, "timestamp": "04:09:13", "text": "有人吗？我确实给凯看了"}, {"type": "subtitle", "time": 14955.11, "timestamp": "04:09:15", "text": "排行榜在开始时"}, {"type": "subtitle", "time": 14957.349, "timestamp": "04:09:17", "text": "溪流。我再演示一遍。所以"}, {"type": "subtitle", "time": 14959.99, "timestamp": "04:09:19", "text": "是啊，你在哪里？你好。超过"}, {"type": "subtitle", "time": 14961.79, "timestamp": "04:09:21", "text": "这里是"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "排行榜。所以这将与……相关"}, {"type": "subtitle", "time": 14967.349, "timestamp": "04:09:27", "text": "每个人的名字，对于那些有"}, {"type": "subtitle", "time": 14970.229, "timestamp": "04:09:30", "text": "积分之类的。目前是"}, {"type": "subtitle", "time": 14972.469, "timestamp": "04:09:32", "text": "随机名称和随机分数。它不是"}, {"type": "subtitle", "time": 14975.83, "timestamp": "04:09:35", "text": "尚未完全设置完毕。是的，我会这么做。"}, {"type": "subtitle", "time": 14979.469, "timestamp": "04:09:39", "text": "它和一些东西一点一点地"}, {"type": "subtitle", "time": 14982.67, "timestamp": "04:09:42", "text": "慢慢地。你好。就这样"}, {"type": "subtitle", "time": 14986.309, "timestamp": "04:09:46", "text": "他说：“谢谢大家。”现在，我看看。"}, {"type": "subtitle", "time": 14988.11, "timestamp": "04:09:48", "text": "你们下次见。"}, {"type": "subtitle", "time": 14996.51, "timestamp": "04:09:56", "text": "你好。我刚才是不是说了“哦，我的天哪”？"}, {"type": "subtitle", "time": 14999.71, "timestamp": "04:09:59", "text": "上帝。我的天啊。我差点就说我是"}]
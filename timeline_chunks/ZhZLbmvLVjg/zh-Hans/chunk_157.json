[{"type": "subtitle", "time": 9421.95, "timestamp": "02:37:01", "text": "漫画。所以我只读了两本。"}, {"type": "subtitle", "time": 9424.55, "timestamp": "02:37:04", "text": "章节。是的，只有两章。那"}, {"type": "subtitle", "time": 9426.87, "timestamp": "02:37:06", "text": "她和作家在一起的时光"}, {"type": "subtitle", "time": 9427.95, "timestamp": "02:37:07", "text": "写作"}, {"type": "subtitle", "time": 9430.87, "timestamp": "02:37:10", "text": "它。自从我没读过那本书之后，我就……"}, {"type": "subtitle", "time": 9433.429, "timestamp": "02:37:13", "text": "你觉得它有多少个？让我"}, {"type": "subtitle", "time": 9438.03, "timestamp": "02:37:18", "text": "查看。"}, {"type": "subtitle", "time": 9441.03, "timestamp": "02:37:21", "text": "是的。是的。一共有多少章？"}, {"type": "subtitle", "time": 9444.389, "timestamp": "02:37:24", "text": "吸血鬼又来了？现在它变成了"}, {"type": "subtitle", "time": 9447.67, "timestamp": "02:37:27", "text": "现在很流行。维基百科有一个"}, {"type": "subtitle", "time": 9450.19, "timestamp": "02:37:30", "text": "一条关于 vampas 的记录。"}, {"type": "subtitle", "time": 9453.79, "timestamp": "02:37:33", "text": "什么？它变得很受欢迎。如何？"}, {"type": "subtitle", "time": 9458.55, "timestamp": "02:37:38", "text": "什么时候？好的。等待。哦，七个音量级别"}, {"type": "subtitle", "time": 9460.429, "timestamp": "02:37:40", "text": "出来了。"}]
[{"type": "subtitle", "time": 10386.91, "timestamp": "02:53:06", "text": "你们都好吗？"}, {"type": "subtitle", "time": 10389.63, "timestamp": "02:53:09", "text": "呃，三，那里有一美元"}, {"type": "subtitle", "time": 10392.14, "timestamp": "02:53:12", "text": "数字。"}, {"type": "subtitle", "time": 10400.63, "timestamp": "02:53:20", "text": "等待。呃，我觉得“fluff”的意思是“温馨的”。"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "充满爱，而不仅仅是冷酷无情。"}, {"type": "subtitle", "time": 10407.03, "timestamp": "02:53:27", "text": "哦，我知道了。我之前不知道这件事。"}, {"type": "subtitle", "time": 10410.03, "timestamp": "02:53:30", "text": "单词。谢谢你教我"}, {"type": "subtitle", "time": 10412.99, "timestamp": "02:53:32", "text": "这意味着"}, {"type": "subtitle", "time": 10419.51, "timestamp": "02:53:39", "text": "在。等等，这是什么地方？我从未"}, {"type": "subtitle", "time": 10421.07, "timestamp": "02:53:41", "text": "到过"}, {"type": "subtitle", "time": 10434.07, "timestamp": "02:53:54", "text": "好的，接下来是帽子。"}, {"type": "subtitle", "time": 10436.59, "timestamp": "02:53:56", "text": "这个人将会是"}, {"type": "subtitle", "time": 10439.23, "timestamp": "02:53:59", "text": "喝醉了"}]
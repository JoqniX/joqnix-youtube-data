[{"type": "subtitle", "time": 17221.43, "timestamp": "04:47:01", "text": "一位来自印度的网友注册了一个账号"}, {"type": "subtitle", "time": 17225.03, "timestamp": "04:47:05", "text": "王座，并开始建造王座"}, {"type": "subtitle", "time": 17227.27, "timestamp": "04:47:07", "text": "呃，一些杂七杂八的东西。他们就像是那种人"}, {"type": "subtitle", "time": 17230.23, "timestamp": "04:47:10", "text": "足以告诉我这件事。但是"}, {"type": "subtitle", "time": 17234.868, "timestamp": "04:47:14", "text": "我之前并没有什么人脉关系，就跟那个实习生聊了起来。"}, {"type": "subtitle", "time": 17239.35, "timestamp": "04:47:19", "text": "就像和他们保持联系一样，他们离开了。"}, {"type": "subtitle", "time": 17242.15, "timestamp": "04:47:22", "text": "他们的实习期结束了。所以"}, {"type": "subtitle", "time": 17245.11, "timestamp": "04:47:25", "text": "他们不得不……呃，他们不得不删除"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "他们的 Discord 卡，所有那些联系方式"}, {"type": "subtitle", "time": 17249.07, "timestamp": "04:47:29", "text": "那些东西。所以我别无他法"}, {"type": "subtitle", "time": 17252.15, "timestamp": "04:47:32", "text": "联系他们给我的联系人。"}, {"type": "subtitle", "time": 17254.708, "timestamp": "04:47:34", "text": "我私信了其他人。他们从未"}, {"type": "subtitle", "time": 17265.788, "timestamp": "04:47:45", "text": "真是的，我感觉自己被鬼魂缠身了。哦，走吧。我是"}, {"type": "subtitle", "time": 17269.67, "timestamp": "04:47:49", "text": "对不起。但是，你知道，现在的问题是……"}, {"type": "subtitle", "time": 17274.07, "timestamp": "04:47:54", "text": "我知道，嗯，问题是这个社区是"}, {"type": "subtitle", "time": 17275.47, "timestamp": "04:47:55", "text": "眼下"}, {"type": "subtitle", "time": 17279.15, "timestamp": "04:47:59", "text": "小巧、纯净，而且也喜欢"}]
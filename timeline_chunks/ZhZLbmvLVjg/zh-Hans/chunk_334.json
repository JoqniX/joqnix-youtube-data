[{"type": "subtitle", "time": 20040.47, "timestamp": "05:34:00", "text": "这是一个光线充足的地方，但并不大。"}, {"type": "subtitle", "time": 20043.39, "timestamp": "05:34:03", "text": "车站的朋友"}, {"type": "subtitle", "time": 20045.91, "timestamp": "05:34:05", "text": "水泵已放置完毕并被覆盖。"}, {"type": "subtitle", "time": 20048.07, "timestamp": "05:34:08", "text": "金属屋顶由一根长杆支撑。"}, {"type": "subtitle", "time": 20052.23, "timestamp": "05:34:12", "text": "钢结构。他停下了他的红色1993"}, {"type": "subtitle", "time": 20055.19, "timestamp": "05:34:15", "text": "宝马车在其中一个加油站加满了油"}, {"type": "subtitle", "time": 20060.548, "timestamp": "05:34:20", "text": "坦克。另一辆车停在……"}, {"type": "subtitle", "time": 20063.27, "timestamp": "05:34:23", "text": "泵。他们只有四个人。杰克"}, {"type": "subtitle", "time": 20065.19, "timestamp": "05:34:25", "text": "他往里一看，发现一个女人和一个"}, {"type": "subtitle", "time": 20067.99, "timestamp": "05:34:27", "text": "透过窗户看到一个小家伙。他们是"}, {"type": "subtitle", "time": 20070.83, "timestamp": "05:34:30", "text": "看起来他们好像不知道该怎么办"}, {"type": "subtitle", "time": 20073.43, "timestamp": "05:34:33", "text": "买。他再次环顾四周，却发现"}, {"type": "subtitle", "time": 20075.35, "timestamp": "05:34:35", "text": "看到任何东西吗？灯光一直都很亮。"}, {"type": "subtitle", "time": 20077.67, "timestamp": "05:34:37", "text": "他四处奔波，所以无法……"}, {"type": "subtitle", "time": 20079.99, "timestamp": "05:34:39", "text": "辨别更远处的任何事物"}, {"type": "subtitle", "time": 20083.31, "timestamp": "05:34:43", "text": "黑暗。他所看到的"}, {"type": "subtitle", "time": 20086.43, "timestamp": "05:34:46", "text": "之前留下的不安感"}, {"type": "subtitle", "time": 20089.83, "timestamp": "05:34:49", "text": "他。一个形状奇特的影子。或者"}]
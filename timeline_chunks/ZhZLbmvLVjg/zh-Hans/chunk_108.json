[{"type": "subtitle", "time": 6480.149, "timestamp": "01:48:00", "text": "行为举止也相当健康。"}, {"type": "subtitle", "time": 6482.109, "timestamp": "01:48:02", "text": "触摸"}, {"type": "subtitle", "time": 6485.59, "timestamp": "01:48:05", "text": "他不像那个男子汉，不像那个男子汉。"}, {"type": "subtitle", "time": 6496.43, "timestamp": "01:48:16", "text": "出品方舟，极致柔软"}, {"type": "subtitle", "time": 6499.189, "timestamp": "01:48:19", "text": "男孩，你所能想象到的最温柔的男孩"}, {"type": "subtitle", "time": 6506.229, "timestamp": "01:48:26", "text": "自助餐，但也不尽如人意，不过"}, {"type": "subtitle", "time": 6512.629, "timestamp": "01:48:32", "text": "泡芙。我想，呃，开始吧，你看"}, {"type": "subtitle", "time": 6519.709, "timestamp": "01:48:39", "text": "改变。不。呃，但是"}, {"type": "subtitle", "time": 6523.109, "timestamp": "01:48:43", "text": "是啊，不只是那种轻声细语而已。"}, {"type": "subtitle", "time": 6527.99, "timestamp": "01:48:47", "text": "嗯，性格比较温柔。"}, {"type": "subtitle", "time": 6531.109, "timestamp": "01:48:51", "text": "它们之间也有相似之处。他们是"}, {"type": "subtitle", "time": 6534.35, "timestamp": "01:48:54", "text": "比一般人更友善"}, {"type": "subtitle", "time": 6537.79, "timestamp": "01:48:57", "text": "男性。更友善、更"}]
[{"type": "subtitle", "time": 12547.71, "timestamp": "03:29:07", "text": "午餐。那"}, {"type": "subtitle", "time": 12551.389, "timestamp": "03:29:11", "text": "地方。为什么？为什么我感觉自己"}, {"type": "subtitle", "time": 12554.15, "timestamp": "03:29:14", "text": "从来没有。但问题是，我该如何来？"}, {"type": "subtitle", "time": 12555.389, "timestamp": "03:29:15", "text": "向下"}, {"type": "subtitle", "time": 12562.87, "timestamp": "03:29:22", "text": "尽管？如果我那样做并接受它，那就是"}, {"type": "subtitle", "time": 12569.67, "timestamp": "03:29:29", "text": "正确的。哦，我刚醒来就发现自己有它了。"}, {"type": "subtitle", "time": 12572.55, "timestamp": "03:29:32", "text": "现在。哦，真好，真好，真好，真好。"}, {"type": "subtitle", "time": 12574.75, "timestamp": "03:29:34", "text": "你好。好的，"}, {"type": "subtitle", "time": 12592.55, "timestamp": "03:29:52", "text": "哇。我的天啊。它看见我了。它给我看了。"}]
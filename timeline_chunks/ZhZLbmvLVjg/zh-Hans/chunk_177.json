[{"type": "subtitle", "time": 10621.269, "timestamp": "02:57:01", "text": "不是废话。我的意思是，轻松一点没问题，但是"}, {"type": "subtitle", "time": 10624.55, "timestamp": "02:57:04", "text": "合适的蓬松度，不要真的蓬松"}, {"type": "subtitle", "time": 10627.16, "timestamp": "02:57:07", "text": "让我心动不已"}, {"type": "subtitle", "time": 10663.51, "timestamp": "02:57:43", "text": "现在站直。你是谁？什么"}, {"type": "subtitle", "time": 10664.51, "timestamp": "02:57:44", "text": "你"}, {"type": "subtitle", "time": 10667.59, "timestamp": "02:57:47", "text": "想？我想你就是我的“你是怎么做到的”"}, {"type": "subtitle", "time": 10677.63, "timestamp": "02:57:57", "text": "好的。好的。呃，在我们见面之前"}]
[{"type": "subtitle", "time": 483.27, "timestamp": "00:08:03", "text": "helloishi 欢迎欢迎。嗯……"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "我刚才说到哪儿了？是的，我们在Twitch上做了"}, {"type": "subtitle", "time": 490.15, "timestamp": "00:08:10", "text": "很久以前，我们就曾有过一段充满创意的时光。"}, {"type": "subtitle", "time": 493.43, "timestamp": "00:08:13", "text": "Twitcher 的 Twitter 名称变更"}, {"type": "subtitle", "time": 496.629, "timestamp": "00:08:16", "text": "YouTube。我直播的时候就会开播。"}, {"type": "chat", "time": 498.491, "timestamp": "00:08:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why is vodnix lookin to the side so much"}, {"type": "subtitle", "time": 499.469, "timestamp": "00:08:19", "text": "Twitch之类的。所以"}, {"type": "subtitle", "time": 501.869, "timestamp": "00:08:21", "text": "显然有效。"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "显然你知道我是个推特用户。"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "开发……呃，我有推特开发者"}, {"type": "chat", "time": 506.48, "timestamp": "00:08:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "bro had the 2nd monitor far right"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "可以访问，对吧？哦，那是聊天。那是"}, {"type": "subtitle", "time": 510.309, "timestamp": "00:08:30", "text": "聊天。这是一次聊天。我一直在等"}, {"type": "subtitle", "time": 513.029, "timestamp": "00:08:33", "text": "使用 Twitter 开发者门户"}, {"type": "subtitle", "time": 516.149, "timestamp": "00:08:36", "text": "为我的 Twitter 看板开发一个应用程序"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "东西和 Discord 论坛连接了它"}, {"type": "subtitle", "time": 521.99, "timestamp": "00:08:41", "text": "是的，我做不到，因为"}, {"type": "subtitle", "time": 526.87, "timestamp": "00:08:46", "text": "我做
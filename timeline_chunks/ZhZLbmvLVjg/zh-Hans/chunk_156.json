[{"type": "subtitle", "time": 9362.389, "timestamp": "02:36:02", "text": "是的。等待。呃，我也想进入……"}, {"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "因为我表妹说，我看了一些百合系列作品。"}, {"type": "subtitle", "time": 9367.429, "timestamp": "02:36:07", "text": "他们把它变成了现实。他们真的真的"}, {"type": "subtitle", "time": 9369.429, "timestamp": "02:36:09", "text": "阅读特定书籍时涌现的快乐回忆"}, {"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "一个，Yuri看起来真的很可爱。是的，"}, {"type": "subtitle", "time": 9374.349, "timestamp": "02:36:14", "text": "尤里真是太"}, {"type": "subtitle", "time": 9381.15, "timestamp": "02:36:21", "text": "尤里"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "也。如果你问我哪个是你的"}, {"type": "subtitle", "time": 9385.309, "timestamp": "02:36:25", "text": "最喜欢的快乐或"}, {"type": "subtitle", "time": 9390.75, "timestamp": "02:36:30", "text": "哎，真难啊。我两个都喜欢。"}, {"type": "subtitle", "time": 9394.55, "timestamp": "02:36:34", "text": "尽管。但我最初是看《尤里》的。"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "第一的。然后我迷上了Yoi。所以我以前"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "看漫画，不看电视，读很多漫画。"}, {"type": "subtitle", "time": 9406.95, "timestamp": "02:36:46", "text": "百合漫画。 Vampers是其中之一。当我"}, {"type": "subtitle", "time": 9410.11, "timestamp": "02:36:50", "text": "很喜欢《吸血鬼》，它太棒了"}, {"type": "subtitle", "time": 9414.15, "timestamp": "02:36:54", "text": "可爱的。所以当我开始读《吸血鬼》系列小说时，"}, {"type": "subtitle", "time": 9417.27, "timestamp": "02:36:57", "text": "作者刚开始写那个……"}]
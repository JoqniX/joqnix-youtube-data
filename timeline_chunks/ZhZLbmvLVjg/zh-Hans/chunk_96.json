[{"type": "subtitle", "time": 5763.189, "timestamp": "01:36:03", "text": "也就是说，所有人都平安无事。但"}, {"type": "subtitle", "time": 5766.43, "timestamp": "01:36:06", "text": "蛤蜊，不，不是蛤蜊。"}, {"type": "subtitle", "time": 5768.59, "timestamp": "01:36:08", "text": "B12.确实如此"}, {"type": "subtitle", "time": 5773.229, "timestamp": "01:36:13", "text": "疼痛。但是，Duo，我很喜欢这款游戏。"}, {"type": "subtitle", "time": 5776.03, "timestamp": "01:36:16", "text": "很多。这是一次愉快的经历。"}, {"type": "subtitle", "time": 5780.03, "timestamp": "01:36:20", "text": "旅行。我可以开始游戏了吗？"}, {"type": "subtitle", "time": 5783.07, "timestamp": "01:36:23", "text": "再次？ 21 出局"}, {"type": "subtitle", "time": 5786.31, "timestamp": "01:36:26", "text": "哦，等等。"}, {"type": "subtitle", "time": 5789.75, "timestamp": "01:36:29", "text": "哦，它有记忆功能。哦，是的。我需要"}, {"type": "subtitle", "time": 5791.55, "timestamp": "01:36:31", "text": "收集所有"}, {"type": "subtitle", "time": 5800.07, "timestamp": "01:36:40", "text": "我没有收集 5、6、7，"}, {"type": "subtitle", "time": 5802.75, "timestamp": "01:36:42", "text": "来自三个人的回忆"}, {"type": "subtitle", "time": 5806.03, "timestamp": "01:36:46", "text": "Ma 和零记忆"}, {"type": "subtitle", "time": 5809.83, "timestamp": "01:36:49", "text": "下水道。死胡同。我们把它收集起来了。这"}, {"type": "subtitle", "time": 5812.35, "timestamp": "01:36:52", "text": "屋顶应该会收集雨水，我"}, {"type": "subtitle", "time": 5815.43, "timestamp": "01:36:55", "text": "相信。是的。"}, {"type": "subtitle", "time": 5818.87, "timestamp": "01:36:58", "text": "你们希望我把这个做到100%吗？我们"}]
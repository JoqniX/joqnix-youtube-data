[{"type": "subtitle", "time": 1760.909, "timestamp": "00:29:20", "text": "上帝。我的天哪。我的天啊。"}, {"type": "subtitle", "time": 1764.63, "timestamp": "00:29:24", "text": "耶。雅拜。我的天啊。"}, {"type": "subtitle", "time": 1766.95, "timestamp": "00:29:26", "text": "好了，我们终于到了。有什么吗？"}, {"type": "subtitle", "time": 1773.19, "timestamp": "00:29:33", "text": "需要？等等，我该怎么下去才能到那里？"}, {"type": "subtitle", "time": 1776.549, "timestamp": "00:29:36", "text": "那个站在最上面的人的钥匙是什么？是的。"}, {"type": "subtitle", "time": 1783.789, "timestamp": "00:29:43", "text": "正在做？希望你一切顺利"}, {"type": "subtitle", "time": 1788.549, "timestamp": "00:29:48", "text": "出色地。好的，我们去这里。我可以跳下去吗？"}, {"type": "subtitle", "time": 1790.149, "timestamp": "00:29:50", "text": "不。"}, {"type": "subtitle", "time": 1790.52, "timestamp": "00:29:50", "text": "和"}, {"type": "subtitle", "time": 1792.909, "timestamp": "00:29:52", "text": "[音乐]"}]
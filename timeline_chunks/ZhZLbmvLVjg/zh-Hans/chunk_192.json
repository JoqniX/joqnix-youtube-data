[{"type": "subtitle", "time": 11530.11, "timestamp": "03:12:10", "text": "或许会摧毁"}, {"type": "subtitle", "time": 11542.91, "timestamp": "03:12:22", "text": "猫。"}, {"type": "subtitle", "time": 11545.87, "timestamp": "03:12:25", "text": "呃，我应该怎么办？"}, {"type": "subtitle", "time": 11557.03, "timestamp": "03:12:37", "text": "嗯，我认为那是无穷大。他一直"}, {"type": "subtitle", "time": 11560.389, "timestamp": "03:12:40", "text": "把东西拉下来。对于某些人来说"}, {"type": "subtitle", "time": 11575.71, "timestamp": "03:12:55", "text": "也。他会试图给我们穿鞋。"}]
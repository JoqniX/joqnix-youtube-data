[{"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "他们。下一个在哪里？哦，是的。"}, {"type": "subtitle", "time": 8295.469, "timestamp": "02:18:15", "text": "令人毛骨悚然"}, {"type": "subtitle", "time": 8313.669, "timestamp": "02:18:33", "text": "放开我。放开我。放开我。得到"}, {"type": "subtitle", "time": 8325.549, "timestamp": "02:18:45", "text": "我。啊，"}, {"type": "subtitle", "time": 8329.67, "timestamp": "02:18:49", "text": "我把他们打晕了。"}]
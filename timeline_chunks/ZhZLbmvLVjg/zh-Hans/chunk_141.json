[{"type": "subtitle", "time": 8462.19, "timestamp": "02:21:02", "text": "是的，还有一些额外的……"}, {"type": "subtitle", "time": 8464.95, "timestamp": "02:21:04", "text": "东西。请让我分享我们的喜悦。"}, {"type": "subtitle", "time": 8468.309, "timestamp": "02:21:08", "text": "那里。对，我就是这么说的。我们"}, {"type": "subtitle", "time": 8480.469, "timestamp": "02:21:20", "text": "上帝。我的天啊。我怎么回来了？"}, {"type": "subtitle", "time": 8487.23, "timestamp": "02:21:27", "text": "惊人的。下车。出去。得到"}, {"type": "subtitle", "time": 8489.67, "timestamp": "02:21:29", "text": "离开。如何？我不知道我是怎么回来的。"}, {"type": "subtitle", "time": 8501.309, "timestamp": "02:21:41", "text": "哦，我的"}, {"type": "subtitle", "time": 8513.71, "timestamp": "02:21:53", "text": "离开。好了。等等，我们是不是错过了什么？"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "任何事物？我没注意。我们是否"}, {"type": "subtitle", "time": 8517.55, "timestamp": "02:21:57", "text": "错过"}]
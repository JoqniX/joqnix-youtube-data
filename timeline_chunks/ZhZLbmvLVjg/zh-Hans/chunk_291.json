[{"type": "subtitle", "time": 17461.708, "timestamp": "04:51:01", "text": "那。来"}, {"type": "subtitle", "time": 17463.47, "timestamp": "04:51:03", "text": "这里。"}, {"type": "subtitle", "time": 17466.55, "timestamp": "04:51:06", "text": "你好。等等，我不是……难道这不就表明……"}, {"type": "subtitle", "time": 17470.03, "timestamp": "04:51:10", "text": "我正在那里直播？好了，就是这样。"}, {"type": "subtitle", "time": 17473.59, "timestamp": "04:51:13", "text": "去。恭喜！"}, {"type": "subtitle", "time": 17476.59, "timestamp": "04:51:16", "text": "乔先生，订阅人数已达 600。你好。感谢"}, {"type": "subtitle", "time": 17479.99, "timestamp": "04:51:19", "text": "你。谢谢你，D。"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "但说实话，并非如此。"}, {"type": "subtitle", "time": 17484.948, "timestamp": "04:51:24", "text": "感觉像600之类的。我不"}, {"type": "subtitle", "time": 17488.15, "timestamp": "04:51:28", "text": "知道。感觉很正常，你知道吗？它"}, {"type": "subtitle", "time": 17489.628, "timestamp": "04:51:29", "text": "只是"}, {"type": "subtitle", "time": 17492.35, "timestamp": "04:51:32", "text": "感觉"}, {"type": "subtitle", "time": 17494.91, "timestamp": "04:51:34", "text": "通常。是的。没有什么"}, {"type": "subtitle", "time": 17498.91, "timestamp": "04:51:38", "text": "想要。开玩笑。不给糖就捣蛋"}, {"type": "subtitle", "time": 17501.43, "timestamp": "04:51:41", "text": "对待。是的。不给糖就捣蛋。那样的话，"}, {"type": "subtitle", "time": 17506.07, "timestamp": "04:51:46", "text": "你怎么等？我该怎么做？呃"}, {"type": "subtitle", "time": 17510.788, "timestamp": "04:51:50", "text": "我现在就像在说“给我糖果”。诡计"}, {"type": "subtitle", "time": 17513.23, "timestamp": "04:51:53", "text": "树的诡计或诡计"}, {"type": "subtitle", "time": 17518.21, "timestamp": "04:51:58", "text": "对待。你是怎么做到的？是时候禁止"}, {"type": "subtitle", "time": 17519.55, "timestamp": "04:51:59", "text": "[音乐]"}]
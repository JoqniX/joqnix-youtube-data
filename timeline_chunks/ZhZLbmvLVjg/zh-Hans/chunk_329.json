[{"type": "subtitle", "time": 19741.59, "timestamp": "05:29:01", "text": "最喜欢的。由于他的妻子和儿子"}, {"type": "subtitle", "time": 19744.15, "timestamp": "05:29:04", "text": "他去世时，经常在外奔波。"}, {"type": "subtitle", "time": 19747.19, "timestamp": "05:29:07", "text": "有时候杰克就直接上了车，"}, {"type": "subtitle", "time": 19749.39, "timestamp": "05:29:09", "text": "开车驶离"}, {"type": "subtitle", "time": 19753.03, "timestamp": "05:29:13", "text": "无处。道路照明不太好。"}, {"type": "subtitle", "time": 19755.708, "timestamp": "05:29:15", "text": "原来那里确实有一条乡间小路。"}, {"type": "subtitle", "time": 19758.67, "timestamp": "05:29:18", "text": "但这并非如此"}, {"type": "subtitle", "time": 19763.07, "timestamp": "05:29:23", "text": "自 20 世纪 80 年代以来一直处于修复状态。"}, {"type": "subtitle", "time": 19765.31, "timestamp": "05:29:25", "text": "现在在"}, {"type": "subtitle", "time": 19768.788, "timestamp": "05:29:28", "text": "2005年，它的状况已经恶化。"}, {"type": "subtitle", "time": 19771.19, "timestamp": "05:29:31", "text": "受天气和高气温影响"}, {"type": "subtitle", "time": 19774.708, "timestamp": "05:29:34", "text": "货车交通频率。现在是"}, {"type": "subtitle", "time": 19776.27, "timestamp": "05:29:36", "text": "卡车"}, {"type": "subtitle", "time": 19779.83, "timestamp": "05:29:39", "text": "我尝试过很多次，但都尽量避免走这条路。"}, {"type": "subtitle", "time": 19782.868, "timestamp": "05:29:42", "text": "尽可能地因为贫穷"}, {"type": "subtitle", "time": 19785.35, "timestamp": "05:29:45", "text": "状况。"}, {"type": "subtitle", "time": 19787.43, "timestamp": "05:29:47", "text": "那些处境恶劣的人。许多"}, {"type": "subtitle", "time": 19789.47, "timestamp": "05:29:49", "text": "灯不亮。"}, {"type": "subtitle", "time": 19791.788, "timestamp": "05:29:51", "text": "工作，无人"}]
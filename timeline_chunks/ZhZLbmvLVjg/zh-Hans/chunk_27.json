[{"type": "subtitle", "time": 1622.35, "timestamp": "00:27:02", "text": "上帝。我刚才说到哪儿了？"}, {"type": "subtitle", "time": 1625.59, "timestamp": "00:27:05", "text": "再次？哦，对了，他的钥匙掉下来了。"}, {"type": "subtitle", "time": 1628.789, "timestamp": "00:27:08", "text": "在哪里？再次？向下，对吧？向下。向下。"}, {"type": "subtitle", "time": 1634.71, "timestamp": "00:27:14", "text": "尽管？坚持，稍等。我回答你的问题"}, {"type": "subtitle", "time": 1637.47, "timestamp": "00:27:17", "text": "马上就好。你好。你好。你好。"}, {"type": "subtitle", "time": 1641.149, "timestamp": "00:27:21", "text": "你好。等待。对不起。我打字"}, {"type": "subtitle", "time": 1645.07, "timestamp": "00:27:25", "text": "错误的。是的，已经开始了。它在……"}, {"type": "subtitle", "time": 1647.75, "timestamp": "00:27:27", "text": "正确的。它在右边。有什么节目"}, {"type": "subtitle", "time": 1649.23, "timestamp": "00:27:29", "text": "对吗？"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "米奇。娜妮。娜妮。哦，不。我触发了"}, {"type": "subtitle", "time": 1665.19, "timestamp": "00:27:45", "text": "这里。快点。出去。出去。得到"}, {"type": "subtitle", "time": 1667.75, "timestamp": "00:27:47", "text": "出去。过来。过来。过来。或者"}, {"type": "subtitle", "time": 1668.99, "timestamp": "00:27:48", "text": "你可以去"}, {"type": "subtitle", "time": 1671.59, "timestamp": "00:27:51", "text": "离开。时间到了，孩子。哦，是的。是的。"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "是的。哦，我指的是当地时间。呃，"}, {"type": "subtitle", "time": 1679.59, "timestamp": "00:27:59", "text": "不，不，不。用户在聊天窗口停留的时间。"}]
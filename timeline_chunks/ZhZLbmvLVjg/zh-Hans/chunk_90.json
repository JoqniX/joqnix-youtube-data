[{"type": "subtitle", "time": 5400.39, "timestamp": "01:30:00", "text": "阳光。那是Momo。就是他。"}, {"type": "subtitle", "time": 5406.27, "timestamp": "01:30:06", "text": "监护人。哦，我的"}, {"type": "subtitle", "time": 5409.03, "timestamp": "01:30:09", "text": "天哪，他们终于见到阳光了。"}, {"type": "subtitle", "time": 5417.35, "timestamp": "01:30:17", "text": "那是魅力四射的。她还活着。感谢"}, {"type": "subtitle", "time": 5420.24, "timestamp": "01:30:20", "text": "上帝。"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "牺牲。我们去接他。"}, {"type": "subtitle", "time": 5446.47, "timestamp": "01:30:46", "text": "喂，把他接上。你要去挑选"}, {"type": "subtitle", "time": 5449.47, "timestamp": "01:30:49", "text": "把他扶起来。他需要振作起来。"}, {"type": "subtitle", "time": 5454.189, "timestamp": "01:30:54", "text": "哦，把他抱起来。"}]
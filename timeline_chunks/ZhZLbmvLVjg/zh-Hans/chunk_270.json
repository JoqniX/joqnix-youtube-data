[{"type": "subtitle", "time": 16204.309, "timestamp": "04:30:04", "text": "渠道。等等，是的。呃，迪瓦瓦，我们"}, {"type": "subtitle", "time": 16207.67, "timestamp": "04:30:07", "text": "是的，迪瓦很有趣。是的，迪瓦是"}, {"type": "subtitle", "time": 16212.149, "timestamp": "04:30:12", "text": "乐趣。弃之不顾。迪瓦，那是两个。"}, {"type": "subtitle", "time": 16214.389, "timestamp": "04:30:14", "text": "然后呢？准社会性，那就是三个。"}, {"type": "subtitle", "time": 16217.51, "timestamp": "04:30:17", "text": "恐狗症，这是第四个。然后呢？然后"}, {"type": "subtitle", "time": 16221.03, "timestamp": "04:30:21", "text": "这个月我们都做了些什么？四、然后"}, {"type": "subtitle", "time": 16223.07, "timestamp": "04:30:23", "text": "后屋"}, {"type": "subtitle", "time": 16225.51, "timestamp": "04:30:25", "text": "五。这算吗？那是五个"}, {"type": "subtitle", "time": 16227.59, "timestamp": "04:30:27", "text": "游戏，对吧？等等，那真的存在吗？"}, {"type": "subtitle", "time": 16230.07, "timestamp": "04:30:30", "text": "数数？这样数数可以吗？"}, {"type": "subtitle", "time": 16233.67, "timestamp": "04:30:33", "text": "绝对不行。但去年，也就是2022年，我"}, {"type": "subtitle", "time": 16238.469, "timestamp": "04:30:38", "text": "我经历了长达两周的噩梦，"}, {"type": "subtitle", "time": 16241.91, "timestamp": "04:30:41", "text": "就像持续了两周的恐怖经历，简直到了极致。"}, {"type": "subtitle", "time": 16245.51, "timestamp": "04:30:45", "text": "我被烧毁了，真的，它"}, {"type": "subtitle", "time": 16249.229, "timestamp": "04:30:49", "text": "影响了我的精神状态，就像……"}, {"type": "subtitle", "time": 16253.75, "timestamp": "04:30:53", "text": "很小的声音都能把我吓一跳。"}, {"type": "subtitle", "time": 16256.95, "timestamp": "04:30:56", "text": "我玩不了任何电子游戏，比如第一人称射击游戏。"}, {"type": "subtitle", "time": 16259.75, "timestamp": "04:30:59", "text": "自从你出现以来，游戏就一直很正常。"}]
[{"type": "subtitle", "time": 6601.07, "timestamp": "01:50:01", "text": "向上。那里我们"}, {"type": "subtitle", "time": 6607.709, "timestamp": "01:50:07", "text": "[音乐]"}, {"type": "subtitle", "time": 6611.59, "timestamp": "01:50:11", "text": "这里。等等，我以前有那个音"}, {"type": "subtitle", "time": 6613.55, "timestamp": "01:50:13", "text": "声音 呃 声音"}, {"type": "subtitle", "time": 6617.07, "timestamp": "01:50:17", "text": "以笑声作为替代效果"}, {"type": "subtitle", "time": 6620.79, "timestamp": "01:50:20", "text": "东西。我不是在添加的时候添加的吗？"}, {"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "清除音效？"}, {"type": "subtitle", "time": 6627.55, "timestamp": "01:50:27", "text": "哦，我想我忘了加上去了。你知道"}, {"type": "subtitle", "time": 6631.91, "timestamp": "01:50:31", "text": "什么？我会添加，我会尝试添加它。"}, {"type": "subtitle", "time": 6634.79, "timestamp": "01:50:34", "text": "溪流之后。是的。而且，我认为"}, {"type": "subtitle", "time": 6636.95, "timestamp": "01:50:36", "text": "做某事"}, {"type": "subtitle", "time": 6639.39, "timestamp": "01:50:39", "text": "呃，就像一个提醒"}]
[{"type": "subtitle", "time": 18540.41, "timestamp": "05:09:00", "text": "询问生日"}, {"type": "subtitle", "time": 18542.43, "timestamp": "05:09:02", "text": "[音乐]"}, {"type": "subtitle", "time": 18544.27, "timestamp": "05:09:04", "text": "希望？"}, {"type": "subtitle", "time": 18546.66, "timestamp": "05:09:06", "text": "嗯？"}, {"type": "subtitle", "time": 18555.11, "timestamp": "05:09:15", "text": "好的。哦，是的。今天是Hash的生日，"}, {"type": "subtitle", "time": 18556.27, "timestamp": "05:09:16", "text": "正确的？我"}, {"type": "subtitle", "time": 18559.51, "timestamp": "05:09:19", "text": "忘了。哦，等等。哦，我们应该唱歌"}, {"type": "subtitle", "time": 18564.788, "timestamp": "05:09:24", "text": "祝Hash生日快乐。我完全"}, {"type": "subtitle", "time": 18567.51, "timestamp": "05:09:27", "text": "呃，我忘了这事了。我的天啊。哦"}, {"type": "subtitle", "time": 18569.67, "timestamp": "05:09:29", "text": "是啊，是啊，是啊，是啊，是啊。但"}, {"type": "subtitle", "time": 18572.948, "timestamp": "05:09:32", "text": "就像我脑海里浮现的，呃，哈希的"}, {"type": "subtitle", "time": 18576.19, "timestamp": "05:09:36", "text": "生日是昨天还是昨天"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "某物。我忘了，就像我忘了我"}, {"type": "subtitle", "time": 18582.23, "timestamp": "05:09:42", "text": "昨天晚上熬夜了。是的，我"}, {"type": "subtitle", "time": 18584.91, "timestamp": "05:09:44", "text": "感觉就像，不，我确实"}, {"type": "subtitle", "time": 18592.47, "timestamp": "05:09:52", "text": "晚的。我想让你读一本恐怖小说。它是"}, {"type": "subtitle", "time": 18594.47, "timestamp": "05:09:54", "text": "这不是真实的故事，也不是一个短篇故事。好的，"}, {"type": "chat", "time": 18596.124, "timestamp": "05:09:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "indeed mr vodnix"}, {"type": "subtitle", "time": 18596.69, "timestamp": "05:09:56", "text": "美好的。"}, {"type": "subtitle", "time": 18598.99, "timestamp": "05:09:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 20100.03, "timestamp": "05:35:00", "text": "He got out of the"}, {"type": "subtitle", "time": 20102.35, "timestamp": "05:35:02", "text": "car. Got out of the"}, {"type": "subtitle", "time": 20105.11, "timestamp": "05:35:05", "text": "car, pulled up the zipper of his leather"}, {"type": "subtitle", "time": 20108.19, "timestamp": "05:35:08", "text": "jacket. It was a little windy around"}, {"type": "subtitle", "time": 20116.51, "timestamp": "05:35:16", "text": "arrived. Although autumn had already"}, {"type": "subtitle", "time": 20118.948, "timestamp": "05:35:18", "text": "arrived, so the weather kept on getting"}, {"type": "subtitle", "time": 20123.11, "timestamp": "05:35:23", "text": "colder each day. His legs had a hard"}, {"type": "subtitle", "time": 20125.27, "timestamp": "05:35:25", "text": "time walking. He spent a considerable"}, {"type": "subtitle", "time": 20128.23, "timestamp": "05:35:28", "text": "time in the seated position. So his"}, {"type": "subtitle", "time": 20144.19, "timestamp": "05:35:44", "text": "rusty."}, {"type": "subtitle", "time": 20149.19, "timestamp": "05:35:49", "text": "Um Jake wasn't too old. In fact, he was"}, {"type": "subtitle", "time": 20153.27, "timestamp": "05:35:53", "text": "only 44 and still healthy as a man can"}, {"type": "subtitle", "time": 20155.51, "timestamp": "05:35:55", "text": "be at an age. The stumble on his face"}, {"type": "subtitle", "time": 20158.23, "timestamp": "05:35:58", "text": "already turned into a beard. He hadn't"}]
[{"type": "subtitle", "time": 2180.91, "timestamp": "00:36:20", "text": "私を連れて行って"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "今。はい、私のモデルを接続します。"}, {"type": "subtitle", "time": 2187.17, "timestamp": "00:36:27", "text": "電話から"}, {"type": "subtitle", "time": 2200.39, "timestamp": "00:36:40", "text": "朝食。ああ、大変だ。"}, {"type": "subtitle", "time": 2209.51, "timestamp": "00:36:49", "text": "ジョーク。だから私は作りたい、私は維持しなければならない"}]
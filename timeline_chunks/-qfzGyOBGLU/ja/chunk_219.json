[{"type": "subtitle", "time": 13156.83, "timestamp": "03:39:16", "text": "うん。手に入れたい"}, {"type": "subtitle", "time": 13159.99, "timestamp": "03:39:19", "text": "あなた。もし私たちが生き残っていたら、そう、私たちは"}, {"type": "subtitle", "time": 13162.75, "timestamp": "03:39:22", "text": "たくさんのものを持って帰った"}, {"type": "subtitle", "time": 13164.269, "timestamp": "03:39:24", "text": "もの、"}, {"type": "subtitle", "time": 13168.51, "timestamp": "03:39:28", "text": "残念ながら。つまり、私はまだ戻ることができる、"}, {"type": "subtitle", "time": 13172.229, "timestamp": "03:39:32", "text": "そう、そして彼がくれた品物を手に入れる。"}, {"type": "subtitle", "time": 13173.79, "timestamp": "03:39:33", "text": "あなたが知っている"}, {"type": "subtitle", "time": 13177.389, "timestamp": "03:39:37", "text": "何？それは、"}, {"type": "subtitle", "time": 13180.79, "timestamp": "03:39:40", "text": "少しでも。ああ、荷物を持ってあそこに戻って。"}, {"type": "subtitle", "time": 13182.59, "timestamp": "03:39:42", "text": "それもまた"}, {"type": "subtitle", "time": 13190.83, "timestamp": "03:39:50", "text": "何か。ああ、あなたはここにいたんですね。何が"}, {"type": "subtitle", "time": 13193.63, "timestamp": "03:39:53", "text": "この３つ"}]
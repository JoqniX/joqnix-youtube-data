[{"type": "subtitle", "time": 9844.51, "timestamp": "02:44:04", "text": "私はそうで、"}, {"type": "subtitle", "time": 9852.269, "timestamp": "02:44:12", "text": "[音楽]"}, {"type": "subtitle", "time": 9856.23, "timestamp": "02:44:16", "text": "男。昔はよく飛び出して、"}, {"type": "subtitle", "time": 9859.67, "timestamp": "02:44:19", "text": "Hyperscapeでたくさんのトロフィーを獲得する。"}, {"type": "subtitle", "time": 9862.469, "timestamp": "02:44:22", "text": "私はそれらを全て失った。私はそれをよく遊んでいました"}, {"type": "subtitle", "time": 9866.309, "timestamp": "02:44:26", "text": "ゲームと痛み。大丈夫だよ、犬。その"}, {"type": "subtitle", "time": 9875.07, "timestamp": "02:44:35", "text": "でも、大丈夫だよ。拭いきれない後悔。"}, {"type": "subtitle", "time": 9879.55, "timestamp": "02:44:39", "text": "いいえ、わかりません。一酸化炭素中毒かもしれない。ああ"}, {"type": "subtitle", "time": 9882.11, "timestamp": "02:44:42", "text": "いいえ。なんてこった。"}, {"type": "subtitle", "time": 9886.469, "timestamp": "02:44:46", "text": "何？本気ですか？もちろん。手に入れるべき"}, {"type": "subtitle", "time": 9892.71, "timestamp": "02:44:52", "text": "何か。うん。うん。うん。そしてまた"}, {"type": "subtitle", "time": 9896.87, "timestamp": "02:44:56", "text": "飲んで、飲んで、待って、何を"}]
[{"type": "subtitle", "time": 19748.35, "timestamp": "05:29:08", "text": "もっと。わかった。私は思う"}, {"type": "subtitle", "time": 19752.27, "timestamp": "05:29:12", "text": "これ。わかった。だから、私たちは行かなければならない"}, {"type": "subtitle", "time": 19754.11, "timestamp": "05:29:14", "text": "そして"}, {"type": "subtitle", "time": 19757.47, "timestamp": "05:29:17", "text": "待って。私たちには必要だ"}, {"type": "subtitle", "time": 19762.39, "timestamp": "05:29:22", "text": "準備を始め、行動を起こす。"}, {"type": "subtitle", "time": 19764.39, "timestamp": "05:29:24", "text": "それで、つるはしを手に入れた。それで、私は銃を手に入れた。"}, {"type": "subtitle", "time": 19767.39, "timestamp": "05:29:27", "text": "私はすべてを手に入れました、私は"}, {"type": "subtitle", "time": 19770.47, "timestamp": "05:29:30", "text": "信じる。ああ、添付ファイルを入手できます"}, {"type": "subtitle", "time": 19789.51, "timestamp": "05:29:49", "text": "行く。分かりません。ああ、これはボットだ。その"}]
[{"type": "subtitle", "time": 12060.349, "timestamp": "03:21:00", "text": "では、私は何をすればいいのでしょうか"}, {"type": "subtitle", "time": 12078.63, "timestamp": "03:21:18", "text": "うん。それで、今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 12112.63, "timestamp": "03:21:52", "text": "あの、これらの商品は必要ですか？私はそうは思わない"}, {"type": "subtitle", "time": 12114.389, "timestamp": "03:21:54", "text": "これらをどう扱うべきかを知っている。私はただ"}, {"type": "subtitle", "time": 12117.389, "timestamp": "03:21:57", "text": "それを捨てろ。必要であれば、"}]
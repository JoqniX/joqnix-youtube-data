[{"type": "subtitle", "time": 12181.19, "timestamp": "03:23:01", "text": "何か。誰か包帯を持ってきてください"}, {"type": "subtitle", "time": 12182.51, "timestamp": "03:23:02", "text": "少なくとも。来る"}, {"type": "subtitle", "time": 12184.75, "timestamp": "03:23:04", "text": "の上。私は手に入れた"}, {"type": "subtitle", "time": 12192.99, "timestamp": "03:23:12", "text": "わーい。どんな戦利品？"}, {"type": "subtitle", "time": 12205.87, "timestamp": "03:23:25", "text": "誰かがこう言っているのが聞こえた"}, {"type": "subtitle", "time": 12207.469, "timestamp": "03:23:27", "text": "ワンプ。"}, {"type": "subtitle", "time": 12210.51, "timestamp": "03:23:30", "text": "何？誰かがこう言っているのが聞こえた"}, {"type": "subtitle", "time": 12229.19, "timestamp": "03:23:49", "text": "では、この辺りを通り抜けてみましょうか。"}, {"type": "subtitle", "time": 12232.469, "timestamp": "03:23:52", "text": "自分がどこにいるのか分からない。私は何者ですか？"}, {"type": "subtitle", "time": 12234.51, "timestamp": "03:23:54", "text": "何をすべきか？しかしそれは"}, {"type": "subtitle", "time": 12237.269, "timestamp": "03:23:57", "text": "大丈夫。うん、二階に行こうか、"}, {"type": "subtitle", "time": 12239.87, "timestamp": "03:23:59", "text": "何か見ることができるように、"}]
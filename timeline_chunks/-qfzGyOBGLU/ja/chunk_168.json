[{"type": "subtitle", "time": 10080.389, "timestamp": "02:48:00", "text": "ベテランおよびPVP専用チーム情報プレイヤー"}, {"type": "subtitle", "time": 10082.87, "timestamp": "02:48:02", "text": "チーム情報ベテランで名前を確認する。"}, {"type": "subtitle", "time": 10086.67, "timestamp": "02:48:06", "text": "わかった。わかった。まず、まず"}, {"type": "subtitle", "time": 10089.23, "timestamp": "02:48:09", "text": "やらなきゃいけないこと"}, {"type": "subtitle", "time": 10092.469, "timestamp": "02:48:12", "text": "グラフィックが下の方にあるのは、"}, {"type": "subtitle", "time": 10097.87, "timestamp": "02:48:17", "text": "持ち帰り"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "ウーピー。えっと、ゲームがクラッシュするのは嫌なんです"}, {"type": "subtitle", "time": 10107.79, "timestamp": "02:48:27", "text": "時間。"}, {"type": "subtitle", "time": 10111.99, "timestamp": "02:48:31", "text": "えっと、これらを下げた方がいいですか？ Coが戻ってきた。私は"}, {"type": "subtitle", "time": 10114.07, "timestamp": "02:48:34", "text": "このコメントを殴ってやる。はい、私たちは"}, {"type": "subtitle", "time": 10115.469, "timestamp": "02:48:35", "text": "パンチすべき"}, {"type": "subtitle", "time": 10130.03, "timestamp": "02:48:50", "text": "えーと、画像効果。何ですか"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "これ？アンビエントコレクション。レンズが動く"}, {"type": "subtitle", "time": 10136.83, "timestamp": "02:48:56", "text": "ぼやけている。私はモーションブラーが好きではありません。作る"}, {"type": "subtitle", "time": 10139.99, "timestamp": "02:48:59", "text": "音楽。音声の音量。わかった。マスター"}]
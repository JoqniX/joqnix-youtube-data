[{"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "店？え、何？グリーンカード。とは"}, {"type": "subtitle", "time": 13204.51, "timestamp": "03:40:04", "text": "緑"}, {"type": "subtitle", "time": 13207.83, "timestamp": "03:40:07", "text": "カード？うん。ええと、行きましょう。私は"}, {"type": "subtitle", "time": 13224.389, "timestamp": "03:40:24", "text": "戻る？罠が一つ。半自動ボディ。"}, {"type": "subtitle", "time": 13232.91, "timestamp": "03:40:32", "text": "誰かがこのために店を開いたのか、それとも"}, {"type": "subtitle", "time": 13236.67, "timestamp": "03:40:36", "text": "何か？コンパウンドボウ。待って、"}, {"type": "subtitle", "time": 13239.99, "timestamp": "03:40:39", "text": "何？待って、ロープなら二人分買えるよ。"}, {"type": "subtitle", "time": 13247.15, "timestamp": "03:40:47", "text": "それ。ああ、パーティーを開くんですね。"}, {"type": "subtitle", "time": 13259.11, "timestamp": "03:40:59", "text": "私はバカなことをして、唯一の"}]
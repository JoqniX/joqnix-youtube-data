[{"type": "subtitle", "time": 18260.51, "timestamp": "05:04:20", "text": "大丈夫。それはいいです。聖なる神よ。ああ、"}, {"type": "subtitle", "time": 18275.31, "timestamp": "05:04:35", "text": "えっと、どうやって降りればいいですか？ああ、"}, {"type": "subtitle", "time": 18278.23, "timestamp": "05:04:38", "text": "神。待って、どうやって私たちはここに来たんだっけ？"}, {"type": "subtitle", "time": 18282.99, "timestamp": "05:04:42", "text": "忘れた。"}]
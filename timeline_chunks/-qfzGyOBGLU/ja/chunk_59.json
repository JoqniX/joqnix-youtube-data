[{"type": "subtitle", "time": 3545.63, "timestamp": "00:59:05", "text": "1つ。私の動きは"}, {"type": "subtitle", "time": 3547.87, "timestamp": "00:59:07", "text": "ピーク。しかし"}, {"type": "subtitle", "time": 3551.43, "timestamp": "00:59:11", "text": "うん。ああ、もう遅い時間だった。ああ、私はとても"}, {"type": "subtitle", "time": 3561.19, "timestamp": "00:59:21", "text": "ええ、そうですね、行きます。時刻は10時12分です。病気"}, {"type": "subtitle", "time": 3564.789, "timestamp": "00:59:24", "text": "朝食を食べ、歯を磨き、"}, {"type": "subtitle", "time": 3566.99, "timestamp": "00:59:26", "text": "お風呂に入って、リセット"}, {"type": "subtitle", "time": 3571.39, "timestamp": "00:59:31", "text": "自分自身。問題は、私が自分の"}, {"type": "subtitle", "time": 3573.67, "timestamp": "00:59:33", "text": "インストラクター。今日は授業があるよね？"}, {"type": "subtitle", "time": 3576.95, "timestamp": "00:59:36", "text": "私は文字通り何かを提出しなければならない"}, {"type": "subtitle", "time": 3578.87, "timestamp": "00:59:38", "text": "今日。"}, {"type": "subtitle", "time": 3582.03, "timestamp": "00:59:42", "text": "私が"}, {"type": "subtitle", "time": 3587.109, "timestamp": "00:59:47", "text": "保存すらできないという事実"}]
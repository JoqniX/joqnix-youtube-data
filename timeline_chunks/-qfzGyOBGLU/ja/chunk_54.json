[{"type": "subtitle", "time": 3241.75, "timestamp": "00:54:01", "text": "区別された、または簡単に、そして、ええと、"}, {"type": "subtitle", "time": 3245.829, "timestamp": "00:54:05", "text": "shiの形でもどんな形でも私だと簡単に認識できます"}, {"type": "subtitle", "time": 3248.069, "timestamp": "00:54:08", "text": "落書きでもアートでも何でも構いません。この現在の"}, {"type": "subtitle", "time": 3251.589, "timestamp": "00:54:11", "text": "モデルはヘアアクセサリーで、"}, {"type": "subtitle", "time": 3254.79, "timestamp": "00:54:14", "text": "髪の毛の描き方"}, {"type": "subtitle", "time": 3257.91, "timestamp": "00:54:17", "text": "すべて順調で、衣装も"}, {"type": "subtitle", "time": 3259.309, "timestamp": "00:54:19", "text": "パーカー"}, {"type": "subtitle", "time": 3262.63, "timestamp": "00:54:22", "text": "そうですね、新しいモデルはどんな感じになるのか気になります。"}, {"type": "subtitle", "time": 3264.91, "timestamp": "00:54:24", "text": "それは少し"}, {"type": "subtitle", "time": 3268.73, "timestamp": "00:54:28", "text": "大変だ、ああ神様、ファンが心配だ"}, {"type": "subtitle", "time": 3271.23, "timestamp": "00:54:31", "text": "[音楽]"}, {"type": "subtitle", "time": 3274.63, "timestamp": "00:54:34", "text": "アーティストたち、ああ神様、私はそれを"}, {"type": "subtitle", "time": 3282.03, "timestamp": "00:54:42", "text": "完璧で"}, {"type": "subtitle", "time": 3284.63, "timestamp": "00:54:44", "text": "共通する独自の要素。ええ、ありますよ"}, {"type": "subtitle", "time": 3287.43, "timestamp": "00:54:47", "text": "共通要素。私はこう感じています"}, {"type": "subtitle", "time": 3288.67, "timestamp": "00:54:48", "text": "そこには"}, {"type": "subtitle", "time": 3291.64, "timestamp": "00:54:51", "text": "は ダイアナ。ないよ、ああ、なんてことだ。今"}, {"type": "subtitle", "time": 3294.96, "timestamp": "00:54:54", "text": "ダイアナ。ないよ、ああ、なんてことだ。今 私がそれを見ると、私は"}]
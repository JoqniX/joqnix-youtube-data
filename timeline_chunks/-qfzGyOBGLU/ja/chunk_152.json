[{"type": "subtitle", "time": 9120.309, "timestamp": "02:32:00", "text": "別のメールアドレス。そして私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 9124.07, "timestamp": "02:32:04", "text": "ええ、痛みはありますが、"}, {"type": "subtitle", "time": 9127.83, "timestamp": "02:32:07", "text": "だから大丈夫です。ええと、私は"}, {"type": "subtitle", "time": 9130.95, "timestamp": "02:32:10", "text": "なんとかしてそれを受け入れて生きていかなければならないが、それでも私は"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "この、えーと、これと付き合っていかないといけない"}, {"type": "subtitle", "time": 9136.75, "timestamp": "02:32:16", "text": "偽者が現れるだろう"}, {"type": "subtitle", "time": 9149.349, "timestamp": "02:32:29", "text": "名前。うん。うん。こんにちは、パンさん。調子はどうですか"}, {"type": "subtitle", "time": 9150.11, "timestamp": "02:32:30", "text": "あなた"}, {"type": "subtitle", "time": 9152.87, "timestamp": "02:32:32", "text": "何をしているの？そうそう。プレイする前に、"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "忘れた。忘れた。忘れた。忘れた。私"}, {"type": "subtitle", "time": 9157.19, "timestamp": "02:32:37", "text": "忘れた。どこにいるの？えっと、どうすればいいですか"}, {"type": "subtitle", "time": 9161.23, "timestamp": "02:32:41", "text": "えっと、神様、神様、確認するべきでしょうか？待って、待って、"}, {"type": "subtitle", "time": 9166.87, "timestamp": "02:32:46", "text": "待って。えっと、家。これが私のチェック方法です"}, {"type": "subtitle", "time": 9169.27, "timestamp": "02:32:49", "text": "はい、これです。そう、私たちは"}, {"type": "subtitle", "time": 9172.19, "timestamp": "02:32:52", "text": "今週のスケジュールが発表されました。それで、"}, {"type": "subtitle", "time": 9176.07, "timestamp": "02:32:56", "text": "はい。ええ、そうです。ということで、今週は"}, {"type": "subtitle", "time": 9179.59, "timestamp": "02:32:59", "text": "特別な日。今週はとても特別な週です。えっと"}]
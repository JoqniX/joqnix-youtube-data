[{"type": "subtitle", "time": 7320.75, "timestamp": "02:02:00", "text": "あなた自身が思う"}, {"type": "subtitle", "time": 7324.35, "timestamp": "02:02:04", "text": "うん、読んだよ"}, {"type": "subtitle", "time": 7326.79, "timestamp": "02:02:06", "text": "素敵な両親が素敵な景色を楽しめる場所"}, {"type": "subtitle", "time": 7328.109, "timestamp": "02:02:08", "text": "人生は素敵な友達でいっぱい"}, {"type": "subtitle", "time": 7337.03, "timestamp": "02:02:17", "text": "そこには。これ以上何を望むというのか？あなた"}, {"type": "subtitle", "time": 7340.229, "timestamp": "02:02:20", "text": "周りに良い人がいて、"}, {"type": "subtitle", "time": 7343.07, "timestamp": "02:02:23", "text": "あなたを応援しています。"}, {"type": "subtitle", "time": 7345.07, "timestamp": "02:02:25", "text": "いいえ。"}, {"type": "subtitle", "time": 7347.91, "timestamp": "02:02:27", "text": "わかった。あなたは勉強していますか"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "国を出る？うん。うん。うん。それで、えーと"}, {"type": "subtitle", "time": 7354.709, "timestamp": "02:02:34", "text": "計画は、日本では使えない"}, {"type": "subtitle", "time": 7357.75, "timestamp": "02:02:37", "text": "えっと、あそこでは英語はあまり使えません。いいえ、"}, {"type": "subtitle", "time": 7360.39, "timestamp": "02:02:40", "text": "完全に日本製です。日本の現地求人"}, {"type": "subtitle", "time": 7363.03, "timestamp": "02:02:43", "text": "すべて。だから私は計画している"}, {"type": "subtitle", "time": 7365.75, "timestamp": "02:02:45", "text": "問題は、私が日本語を学ぶまで"}, {"type": "subtitle", "time": 7369.75, "timestamp": "02:02:49", "text": "ビジネスレベルN2またはN1ネイティブレベル"}, {"type": "subtitle", "time": 7373.95, "timestamp": "02:02:53", "text": "最も難しいレベルの言語レベルの熟練度"}, {"type": "subtitle", "time": 7377.51, "timestamp": "02:02:57", "text": "レベル。ええ、そうしようとしています"}]
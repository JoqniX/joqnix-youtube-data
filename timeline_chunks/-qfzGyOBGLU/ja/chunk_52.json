[{"type": "subtitle", "time": 3120.99, "timestamp": "00:52:00", "text": "成長を描写する"}, {"type": "subtitle", "time": 3123.63, "timestamp": "00:52:03", "text": "要素を追加する"}, {"type": "subtitle", "time": 3125.309, "timestamp": "00:52:05", "text": "成長"}, {"type": "subtitle", "time": 3127.069, "timestamp": "00:52:07", "text": "のように"}, {"type": "subtitle", "time": 3131.27, "timestamp": "00:52:11", "text": "うん、なりたかったんだ、なりたかったんだ"}, {"type": "subtitle", "time": 3134.309, "timestamp": "00:52:14", "text": "不良少年、どんな漫画を"}, {"type": "subtitle", "time": 3137.19, "timestamp": "00:52:17", "text": "当時読んだデビッドアクセサリーI"}, {"type": "subtitle", "time": 3139.23, "timestamp": "00:52:19", "text": "しないで"}, {"type": "subtitle", "time": 3142.71, "timestamp": "00:52:22", "text": "知ってるよ、私はいつも"}, {"type": "subtitle", "time": 3146.069, "timestamp": "00:52:26", "text": "アクセサリーやピアスを身につけたい"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "あるいは私が決して手に入れることのできない何か"}, {"type": "subtitle", "time": 3151.27, "timestamp": "00:52:31", "text": "私の棚に飾るために。だから私は"}, {"type": "subtitle", "time": 3152.75, "timestamp": "00:52:32", "text": "モデルは"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "それ。どうやって、どうやって、どうやって"}, {"type": "subtitle", "time": 3157.71, "timestamp": "00:52:37", "text": "何か感じるもの？私"}, {"type": "subtitle", "time": 3166.47, "timestamp": "00:52:46", "text": "それ。私は自分の「ロードマン」としての資質を磨く必要がある。うん。"}, {"type": "subtitle", "time": 3169.549, "timestamp": "00:52:49", "text": "エモっぽい感じ。はい。はい。それは"}, {"type": "subtitle", "time": 3173.03, "timestamp": "00:52:53", "text": "その時のこと。でも私はそれを理解しています"}, {"type": "subtitle", "time": 3174.75, "timestamp": "00:52:54", "text": "私には合わない"}, {"type": "subtitle", "time": 3176.829, "timestamp": "00:52:56", "text": "多くの"}, {"type": "subtitle", "time": 3179.349, "timestamp": "00:52:59", "text": "感情表現。自分には合わないと分かっています"}]
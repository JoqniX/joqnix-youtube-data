[{"type": "subtitle", "time": 16502.629, "timestamp": "04:35:02", "text": "それは私が思っているものですか？"}, {"type": "subtitle", "time": 16504.269, "timestamp": "04:35:04", "text": "わかった、"}, {"type": "subtitle", "time": 16506.75, "timestamp": "04:35:06", "text": "待って。殺さなければならない"}, {"type": "subtitle", "time": 16510.83, "timestamp": "04:35:10", "text": "それ。待って、私は寝ていません"}, {"type": "subtitle", "time": 16512.83, "timestamp": "04:35:12", "text": "バッグ。"}, {"type": "subtitle", "time": 16515.869, "timestamp": "04:35:15", "text": "ああ、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 16520.31, "timestamp": "04:35:20", "text": "待って。寝袋。いくら？布30枚。"}, {"type": "subtitle", "time": 16523.109, "timestamp": "04:35:23", "text": "待って、待って、待って、待って。まず、"}, {"type": "subtitle", "time": 16525.629, "timestamp": "04:35:25", "text": "そして、それを殺す。"}, {"type": "subtitle", "time": 16529.429, "timestamp": "04:35:29", "text": "なるほど、そういうことか。"}, {"type": "subtitle", "time": 16538.83, "timestamp": "04:35:38", "text": "えーと、寝袋、"}, {"type": "subtitle", "time": 16541.83, "timestamp": "04:35:41", "text": "工芸品、そして私は二重扉を持っています"}, {"type": "subtitle", "time": 16543.839, "timestamp": "04:35:43", "text": "良い。"}]
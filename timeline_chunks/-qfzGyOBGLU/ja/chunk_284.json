[{"type": "subtitle", "time": 17040.708, "timestamp": "04:44:00", "text": "それ。これはどんな動物に関する豆知識ですか？私はそうは思わない"}, {"type": "subtitle", "time": 17042.708, "timestamp": "04:44:02", "text": "それに対してどう対処すべきかを知っている。私は"}, {"type": "subtitle", "time": 17047.07, "timestamp": "04:44:07", "text": "これは私の負担です。これらのものを装着したままにしてください"}, {"type": "subtitle", "time": 17049.47, "timestamp": "04:44:09", "text": "ここ。私たちには必要だ"}, {"type": "subtitle", "time": 17052.43, "timestamp": "04:44:12", "text": "この木材。私たちは保持することができます"}, {"type": "subtitle", "time": 17055.75, "timestamp": "04:44:15", "text": "それ。昔ながらの「もう終わらせてしまえばいいの？」"}, {"type": "subtitle", "time": 17058.27, "timestamp": "04:44:18", "text": "待って、私は古いものを保持します"}, {"type": "subtitle", "time": 17061.11, "timestamp": "04:44:21", "text": "いろいろなものを試して、これらの新しいものを試してください"}, {"type": "subtitle", "time": 17065.708, "timestamp": "04:44:25", "text": "うん。わかった、"}, {"type": "subtitle", "time": 17076.35, "timestamp": "04:44:36", "text": "行く。この新しいものを使ってみよう"}, {"type": "subtitle", "time": 17080.39, "timestamp": "04:44:40", "text": "もの。えっと、そこに行くって知ってる？"}, {"type": "subtitle", "time": 17082.31, "timestamp": "04:44:42", "text": "金属部品を見つけてください。はい、はい、"}, {"type": "subtitle", "time": 17086.35, "timestamp": "04:44:46", "text": "わかった。ガッチャ。金属球。そこにいる"}, {"type": "subtitle", "time": 17089.67, "timestamp": "04:44:49", "text": "は。私も銃を手に入れた。さあ行こう。"}, {"type": "subtitle", "time": 17092.27, "timestamp": "04:44:52", "text": "さあ行こう。君は"}, {"type": "subtitle", "time": 17095.19, "timestamp": "04:44:55", "text": "ピュー。サリー、私は人を撃つことはできないけど、"}]
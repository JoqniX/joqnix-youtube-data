[{"type": "subtitle", "time": 3428.71, "timestamp": "00:57:08", "text": "昨日、自分が事故を起こしていたことに気づいた。私"}, {"type": "subtitle", "time": 3432.069, "timestamp": "00:57:12", "text": "この単語は昨日覚えました。クラッシュアウト"}, {"type": "subtitle", "time": 3435.27, "timestamp": "00:57:15", "text": "そして、私はそれを使っています。おお。私は学んだ"}, {"type": "subtitle", "time": 3437.75, "timestamp": "00:57:17", "text": "クラッシュアウトの意味を学び、"}, {"type": "subtitle", "time": 3440.87, "timestamp": "00:57:20", "text": "私も使ったことがあります。私の友人は"}, {"type": "subtitle", "time": 3442.67, "timestamp": "00:57:22", "text": "VCで話していた"}, {"type": "subtitle", "time": 3445.51, "timestamp": "00:57:25", "text": "昨日、君たちが話しているように"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "BRBにいました。私は透明人間みたいで、"}, {"type": "subtitle", "time": 3452.03, "timestamp": "00:57:32", "text": "会議や人々の手助けをすること"}, {"type": "subtitle", "time": 3455.19, "timestamp": "00:57:35", "text": "もの。だから、彼らが言ったように"}, {"type": "subtitle", "time": 3456.67, "timestamp": "00:57:36", "text": "クラッシュして"}, {"type": "subtitle", "time": 3460.47, "timestamp": "00:57:40", "text": "すべてにおいて、ああ、なんて新しい言葉なんだ"}, {"type": "subtitle", "time": 3463.63, "timestamp": "00:57:43", "text": "これまで聞いたことも、使ったこともない"}, {"type": "subtitle", "time": 3470.95, "timestamp": "00:57:50", "text": "実は。クラッシュする可能性もあった"}, {"type": "subtitle", "time": 3473.069, "timestamp": "00:57:53", "text": "昨晩。私"}, {"type": "subtitle", "time": 3476.43, "timestamp": "00:57:56", "text": "つまり、真夜中ではない"}, {"type": "subtitle", "time": 3479.87, "timestamp": "00:57:59", "text": "夜中。ええ、そうですね。 6:00"}]
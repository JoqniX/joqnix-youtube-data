[{"type": "subtitle", "time": 11954.07, "timestamp": "03:19:14", "text": "この男は何かを持っている。これは何ですか"}, {"type": "subtitle", "time": 11957.269, "timestamp": "03:19:17", "text": "木製の大きな木製看板？できますか？"}, {"type": "subtitle", "time": 11959.99, "timestamp": "03:19:19", "text": "これと何か関係ありますか？私は新しい"}, {"type": "subtitle", "time": 11979.11, "timestamp": "03:19:39", "text": "ええ、NPCです。はい、はい、はい。なんてこった、"}, {"type": "subtitle", "time": 11982.63, "timestamp": "03:19:42", "text": "走らなければならない。ああ、NPCだ。ああ、"}, {"type": "subtitle", "time": 11985.59, "timestamp": "03:19:45", "text": "神。殴ってもいいですか？えっと、私ができるように"}]
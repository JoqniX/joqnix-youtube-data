[{"type": "subtitle", "time": 20593.47, "timestamp": "05:43:13", "text": "[音楽]"}, {"type": "subtitle", "time": 20595.58, "timestamp": "05:43:15", "text": "待って。"}, {"type": "subtitle", "time": 20598.19, "timestamp": "05:43:18", "text": "[音楽]"}, {"type": "subtitle", "time": 20605.708, "timestamp": "05:43:25", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 20609.39, "timestamp": "05:43:29", "text": "ということで、昼食を持って戻ってきました。"}, {"type": "subtitle", "time": 20614.99, "timestamp": "05:43:34", "text": "夕食。それで、いくつか"}, {"type": "subtitle", "time": 20618.948, "timestamp": "05:43:38", "text": "ええと、木材が少しあります。今、私たちは"}, {"type": "subtitle", "time": 20627.788, "timestamp": "05:43:47", "text": "主に。それでは"}, {"type": "subtitle", "time": 20630.948, "timestamp": "05:43:50", "text": "行く。キノコも見つかったら、"}, {"type": "subtitle", "time": 20632.59, "timestamp": "05:43:52", "text": "それを次のように解釈できます"}, {"type": "subtitle", "time": 20635.03, "timestamp": "05:43:55", "text": "良い。それとも、そうすべきだと感じているのだろうか"}, {"type": "subtitle", "time": 20638.19, "timestamp": "05:43:58", "text": "おそらく絆創膏を持っていく"}]
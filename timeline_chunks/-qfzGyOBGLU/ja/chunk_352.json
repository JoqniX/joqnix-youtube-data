[{"type": "subtitle", "time": 21136.39, "timestamp": "05:52:16", "text": "ああ、著作権ね。著作権。著作権。おお"}, {"type": "subtitle", "time": 21140.03, "timestamp": "05:52:20", "text": "神。著作権。その歌知ってるよ。それは"}, {"type": "subtitle", "time": 21142.91, "timestamp": "05:52:22", "text": "著作権。何てことだ。誰が"}, {"type": "subtitle", "time": 21153.07, "timestamp": "05:52:33", "text": "誰かがラジオを置いた"}, {"type": "subtitle", "time": 21156.628, "timestamp": "05:52:36", "text": "歌。何てことだ。それに、待って、"}, {"type": "subtitle", "time": 21166.75, "timestamp": "05:52:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21169.43, "timestamp": "05:52:49", "text": "神。少なくとも木材は手に入る。私たちは"}, {"type": "subtitle", "time": 21173.18, "timestamp": "05:52:53", "text": "動物性脂肪とか色々入ってるよ。"}, {"type": "subtitle", "time": 21177.51, "timestamp": "05:52:57", "text": "[音楽]"}]
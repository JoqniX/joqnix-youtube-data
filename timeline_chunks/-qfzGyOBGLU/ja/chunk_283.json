[{"type": "subtitle", "time": 16982.75, "timestamp": "04:43:02", "text": "とりあえずこれらを置いて"}, {"type": "subtitle", "time": 16985.27, "timestamp": "04:43:05", "text": "もの。ドアの鍵を取ってきて"}, {"type": "subtitle", "time": 16988.43, "timestamp": "04:43:08", "text": "安全な場所に保管してください"}, {"type": "subtitle", "time": 16991.75, "timestamp": "04:43:11", "text": "場合。でも、このままにしておけばいいと思う"}, {"type": "subtitle", "time": 17006.55, "timestamp": "04:43:26", "text": "実は、この物を手に入れたんです。わかった、"}, {"type": "subtitle", "time": 17008.35, "timestamp": "04:43:28", "text": "この男を"}, {"type": "subtitle", "time": 17009.868, "timestamp": "04:43:29", "text": "以上"}, {"type": "subtitle", "time": 17013.15, "timestamp": "04:43:33", "text": "ここ。開けてください。弾薬をいくつか"}, {"type": "subtitle", "time": 17017.03, "timestamp": "04:43:37", "text": "そこには。これくらいは私が引き受けます。そして"}, {"type": "subtitle", "time": 17019.32, "timestamp": "04:43:39", "text": "これらのもの"}, {"type": "subtitle", "time": 17020.75, "timestamp": "04:43:40", "text": "[音楽]"}, {"type": "subtitle", "time": 17028.15, "timestamp": "04:43:48", "text": "これはサルです。ああ、そうです。ああ、わかりました。"}, {"type": "subtitle", "time": 17029.81, "timestamp": "04:43:49", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 17031.788, "timestamp": "04:43:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17034.39, "timestamp": "04:43:54", "text": "えっと、どうすればいいんだろう？えっと、これは取っておきます"}, {"type": "subtitle", "time": 17037.47, "timestamp": "04:43:57", "text": "そしてこれとこれ。すべて"}]
[{"type": "subtitle", "time": 6781.189, "timestamp": "01:53:01", "text": "右？場合によります。でも、ショーマネー"}, {"type": "subtitle", "time": 6789.189, "timestamp": "01:53:09", "text": "そう、アメリカとかと比べて、日本は"}, {"type": "subtitle", "time": 6791.709, "timestamp": "01:53:11", "text": "安いので、"}, {"type": "subtitle", "time": 6795.189, "timestamp": "01:53:15", "text": "推測。ええ、高いですね。事実"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "両親は最善を尽くすことに慣れている"}, {"type": "subtitle", "time": 6800.99, "timestamp": "01:53:20", "text": "一人っ子として私を送ることは"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "非常識な。正直に言って、"}, {"type": "subtitle", "time": 6805.99, "timestamp": "01:53:25", "text": "家族だよ、男。もし私が手に入れることができたら"}, {"type": "subtitle", "time": 6813.709, "timestamp": "01:53:33", "text": "正直に。うん。インドの船。"}, {"type": "subtitle", "time": 6816.39, "timestamp": "01:53:36", "text": "はい。彼らは最善を尽くしている。そして私は"}, {"type": "subtitle", "time": 6819.589, "timestamp": "01:53:39", "text": "お金がないからお願いするのは気が引ける。"}, {"type": "subtitle", "time": 6821.51, "timestamp": "01:53:41", "text": "だから、私の"}, {"type": "subtitle", "time": 6823.43, "timestamp": "01:53:43", "text": "YouTube関連の動画でも何でも、試してみます"}, {"type": "subtitle", "time": 6826.79, "timestamp": "01:53:46", "text": "両親にあまり迷惑をかけないように。私が試してみます"}, {"type": "subtitle", "time": 6830.31, "timestamp": "01:53:50", "text": "何とかしてフリーランスになるか、"}, {"type": "subtitle", "time": 6833.99, "timestamp": "01:53:53", "text": "雑用でも何でもやってるよ。私はできません"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "屋外での肉体労働。私はそれが苦手なんです。"}, {"type": "subtitle", "time": 6839.95, "timestamp": "01:53:59", "text": "私は内向的な人間です。私は自分の"}]
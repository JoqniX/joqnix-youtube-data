[{"type": "subtitle", "time": 6914.63, "timestamp": "01:55:14", "text": "いいえ、そちらの方が安くなります。"}, {"type": "subtitle", "time": 6917.629, "timestamp": "01:55:17", "text": "[音楽]"}, {"type": "subtitle", "time": 6929.99, "timestamp": "01:55:29", "text": "もし私が今買いたいもの"}, {"type": "subtitle", "time": 6933.35, "timestamp": "01:55:33", "text": "文字通りVRヘッドセットのようなものがある"}, {"type": "subtitle", "time": 6936.55, "timestamp": "01:55:36", "text": "クエストツリーとか、そんな感じのもの。それでおしまい。それ"}, {"type": "subtitle", "time": 6939.99, "timestamp": "01:55:39", "text": "1つはモーション追跡機能で、"}, {"type": "subtitle", "time": 6940.99, "timestamp": "01:55:40", "text": "ラップトップ"}, {"type": "subtitle", "time": 6943.99, "timestamp": "01:55:43", "text": "あれ。音楽関連のその他のもの"}, {"type": "subtitle", "time": 6948.07, "timestamp": "01:55:48", "text": "ええと、サウンドカードなどの同期は"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "未来。私は、"}, {"type": "subtitle", "time": 6953.91, "timestamp": "01:55:53", "text": "自分自身が安定していれば"}, {"type": "subtitle", "time": 6957.109, "timestamp": "01:55:57", "text": "十分か、音楽でお金を稼げるか"}]
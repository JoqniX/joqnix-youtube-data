[{"type": "subtitle", "time": 5712.31, "timestamp": "01:35:12", "text": "基づいています。ヒンディー語を話せますか？えっと、ちょっと"}, {"type": "subtitle", "time": 5719.55, "timestamp": "01:35:19", "text": "ヒンディー語の組み合わせが至る所にあります。"}, {"type": "subtitle", "time": 5722.79, "timestamp": "01:35:22", "text": "ええ、私はヒンディー語が得意ではありません。"}, {"type": "subtitle", "time": 5726.75, "timestamp": "01:35:26", "text": "私はヒンディー語を読んでみることができます"}, {"type": "subtitle", "time": 5729.11, "timestamp": "01:35:29", "text": "コメントはあまり理解できないだろうけど"}, {"type": "subtitle", "time": 5732.629, "timestamp": "01:35:32", "text": "それについて、読んでみます。"}, {"type": "subtitle", "time": 5737.39, "timestamp": "01:35:37", "text": "えっと、私はヒンディー語をあまり話せません。"}, {"type": "subtitle", "time": 5740.31, "timestamp": "01:35:40", "text": "ええ、いつもその科目が嫌いでしたし"}, {"type": "subtitle", "time": 5748.39, "timestamp": "01:35:48", "text": "難しい。まあ、ストリームへようこそ"}, {"type": "subtitle", "time": 5754.709, "timestamp": "01:35:54", "text": "ようこそ、ようこそ、ようこそ。お元気ですか？"}, {"type": "subtitle", "time": 5757.31, "timestamp": "01:35:57", "text": "今日？良い"}]
[{"type": "subtitle", "time": 21302.548, "timestamp": "05:55:02", "text": "けれど。はい。 ３、４発の弾丸を"}, {"type": "subtitle", "time": 21309.548, "timestamp": "05:55:09", "text": "戻る。時にはそうしなければならない"}, {"type": "subtitle", "time": 21311.75, "timestamp": "05:55:11", "text": "あなたの"}, {"type": "subtitle", "time": 21313.83, "timestamp": "05:55:13", "text": "生存。しかし、これに関しては遠慮は無用だ"}, {"type": "subtitle", "time": 21315.628, "timestamp": "05:55:15", "text": "1つ。片付ける。"}, {"type": "subtitle", "time": 21344.91, "timestamp": "05:55:44", "text": "わかった。"}, {"type": "subtitle", "time": 21348.23, "timestamp": "05:55:48", "text": "では、ツナ缶を食べて、"}, {"type": "subtitle", "time": 21349.47, "timestamp": "05:55:49", "text": "の"}, {"type": "subtitle", "time": 21354.83, "timestamp": "05:55:54", "text": "生の空き缶。私たちは生で耐えることができます"}, {"type": "subtitle", "time": 21358.35, "timestamp": "05:55:58", "text": "肉。生の鹿肉。これは保管できます"}]
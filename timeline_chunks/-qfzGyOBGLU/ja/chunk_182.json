[{"type": "subtitle", "time": 10920.83, "timestamp": "03:02:00", "text": "うわあ、値段もすごく高い。ああ、"}, {"type": "subtitle", "time": 10923.07, "timestamp": "03:02:03", "text": "神。骨"}, {"type": "subtitle", "time": 10931.03, "timestamp": "03:02:11", "text": "H. もう遅い時間だ。私は見つける必要がある"}, {"type": "subtitle", "time": 10934.309, "timestamp": "03:02:14", "text": "住むにはいい場所ですよね？"}, {"type": "subtitle", "time": 10953.349, "timestamp": "03:02:33", "text": "とにかく。ここは良さそうな家ですね。"}, {"type": "subtitle", "time": 10957.15, "timestamp": "03:02:37", "text": "キャンプ。ああ、キャンプファイヤーだ。"}, {"type": "subtitle", "time": 10959.87, "timestamp": "03:02:39", "text": "ああ、私は落とすことができます"}, {"type": "subtitle", "time": 10969.71, "timestamp": "03:02:49", "text": "ああ、光"}, {"type": "subtitle", "time": 10972.99, "timestamp": "03:02:52", "text": "キャンプファイヤー。待って、どうすれば"}, {"type": "subtitle", "time": 10975.15, "timestamp": "03:02:55", "text": "落とす？"}, {"type": "subtitle", "time": 10979.15, "timestamp": "03:02:59", "text": "いいえ。どうやって分割すればいいですか？"}]
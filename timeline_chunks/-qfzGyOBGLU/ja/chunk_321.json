[{"type": "subtitle", "time": 19260.67, "timestamp": "05:21:00", "text": "フレーム"}, {"type": "subtitle", "time": 19263.83, "timestamp": "05:21:03", "text": "けれど？ 2人分の席はありますか？何"}, {"type": "subtitle", "time": 19273.47, "timestamp": "05:21:13", "text": "精巧な。これらのうち2つ。"}, {"type": "subtitle", "time": 19277.948, "timestamp": "05:21:17", "text": "おお。何てことだ。あなたはそれをしなかった"}, {"type": "subtitle", "time": 19280.51, "timestamp": "05:21:20", "text": "自分。聖なる"}, {"type": "subtitle", "time": 19284.55, "timestamp": "05:21:24", "text": "神。私にはそんなことはしなかった。何てことだ。"}, {"type": "subtitle", "time": 19288.91, "timestamp": "05:21:28", "text": "何てことだ。何てことだ。何てことだ。ああ、"}]
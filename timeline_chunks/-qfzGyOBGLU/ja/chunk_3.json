[{"type": "subtitle", "time": 184.07, "timestamp": "00:03:04", "text": "ああ、そう、私は飲んだけど"}, {"type": "subtitle", "time": 186.309, "timestamp": "00:03:06", "text": "今、すごく新鮮な気分だよ。なぜ"}, {"type": "subtitle", "time": 188.99, "timestamp": "00:03:08", "text": "気分がとても良い"}, {"type": "subtitle", "time": 191.35, "timestamp": "00:03:11", "text": "新鮮な？ああ、すごくかっこいい。私は考えもしなかった"}, {"type": "subtitle", "time": 192.83, "timestamp": "00:03:12", "text": "忙しい"}, {"type": "subtitle", "time": 197.47, "timestamp": "00:03:17", "text": "たぶん3週間くらいかな。 2週間"}, {"type": "subtitle", "time": 200.03, "timestamp": "00:03:20", "text": "推測"}, {"type": "subtitle", "time": 203.79, "timestamp": "00:03:23", "text": "約230で、1つ1つは明らかです"}, {"type": "subtitle", "time": 207.67000000000002, "timestamp": "00:03:27", "text": "座っている。いいえ。ええ、でも私たちは"}, {"type": "subtitle", "time": 212.35, "timestamp": "00:03:32", "text": "PCによって引き起こされるビットレートの変動"}, {"type": "subtitle", "time": 214.949, "timestamp": "00:03:34", "text": "コインですが、それだけです。"}, {"type": "subtitle", "time": 217.19, "timestamp": "00:03:37", "text": "キャスターラボのマルチストリーマーを切り替えました"}, {"type": "subtitle", "time": 220.35, "timestamp": "00:03:40", "text": "サーバーをシンガポールに送る代わりに"}, {"type": "subtitle", "time": 222.589, "timestamp": "00:03:42", "text": "米国"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "西なので、オレゴンのサーバーではありません。"}, {"type": "subtitle", "time": 228.789, "timestamp": "00:03:48", "text": "実際のシンガポールサーバーのように、"}, {"type": "subtitle", "time": 232.67000000000002, "timestamp": "00:03:52", "text": "レイテンシーとその他諸々が改善する"}, {"type": "subtitle", "time": 234.35, "timestamp": "00:03:54", "text": "そうですね。"}, {"type": "subtitle", "time": 238.47, "timestamp": "00:03:58", "text": "ええ、来年4月分の支払いをしなければなりません。えっと"}]
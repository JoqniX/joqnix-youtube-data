[{"type": "subtitle", "time": 19683.11, "timestamp": "05:28:03", "text": "私が見つめていた滴、座って見つめていた滴、"}, {"type": "subtitle", "time": 19684.43, "timestamp": "05:28:04", "text": "主張できない"}, {"type": "subtitle", "time": 19695.868, "timestamp": "05:28:15", "text": "ええ、でも金曜日は試合をします"}, {"type": "subtitle", "time": 19701.07, "timestamp": "05:28:21", "text": "えーと、ウォーハンマーをプレイしています"}, {"type": "subtitle", "time": 19705.83, "timestamp": "05:28:25", "text": "4,000、あのゾンビのピュープゲーム。うん、"}, {"type": "subtitle", "time": 19707.948, "timestamp": "05:28:27", "text": "それは、それは、それが出てくる"}, {"type": "subtitle", "time": 19711.27, "timestamp": "05:28:31", "text": "30日。それは2日後のことだ。あなたはできる"}, {"type": "subtitle", "time": 19714.31, "timestamp": "05:28:34", "text": "予約注文すれば今すぐプレイできます。ええと"}, {"type": "subtitle", "time": 19721.67, "timestamp": "05:28:41", "text": "ベータ版ですが、ストリーミング配信します。"}, {"type": "subtitle", "time": 19736.75, "timestamp": "05:28:56", "text": "私はそれよりもそちらに興奮しています"}]
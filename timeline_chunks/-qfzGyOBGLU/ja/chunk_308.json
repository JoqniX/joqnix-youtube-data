[{"type": "subtitle", "time": 18519.03, "timestamp": "05:08:39", "text": "終わり。ああ、あの雷はすごかった。それは"}, {"type": "subtitle", "time": 18521.47, "timestamp": "05:08:41", "text": "すごくかっこいい。"}, {"type": "subtitle", "time": 18524.628, "timestamp": "05:08:44", "text": "わかった。えっと、ジョックのこと覚えてる？どこにいたの？"}, {"type": "subtitle", "time": 18526.27, "timestamp": "05:08:46", "text": "あなたの"}, {"type": "subtitle", "time": 18528.868, "timestamp": "05:08:48", "text": "家？ああ、ここだ。ああ、そこ"}, {"type": "subtitle", "time": 18532.788, "timestamp": "05:08:52", "text": "あなたは。私の家。我が家が一番。何てことだ、"}, {"type": "subtitle", "time": 18534.868, "timestamp": "05:08:54", "text": "ただいま。"}, {"type": "subtitle", "time": 18536.99, "timestamp": "05:08:56", "text": "ジョックが帰ってきた"}, {"type": "subtitle", "time": 18539.07, "timestamp": "05:08:59", "text": "家。"}]
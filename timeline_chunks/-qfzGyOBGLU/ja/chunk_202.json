[{"type": "subtitle", "time": 12133.229, "timestamp": "03:22:13", "text": "死んだ。そのままにしておいてください。おお。わかった。わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 12135.39, "timestamp": "03:22:15", "text": "あなた。"}, {"type": "subtitle", "time": 12137.229, "timestamp": "03:22:17", "text": "[音楽]"}, {"type": "subtitle", "time": 12140.429, "timestamp": "03:22:20", "text": "待って、ちょっとそれを止めさせて"}, {"type": "subtitle", "time": 12144.03, "timestamp": "03:22:24", "text": "アラーム。ああ、私は10歳です"}, {"type": "subtitle", "time": 12153.79, "timestamp": "03:22:33", "text": "いいえ。ああ、ゴーグルの粘液です。"}, {"type": "subtitle", "time": 12156.63, "timestamp": "03:22:36", "text": "W. 自分のキャラクターに装着してもいいですか？ああ、私は"}, {"type": "subtitle", "time": 12158.55, "timestamp": "03:22:38", "text": "冷却グラスを用意してください。一種のゴーグル"}, {"type": "subtitle", "time": 12167.469, "timestamp": "03:22:47", "text": "かっこいいですね。ああ、なんてことだ、私は"}]
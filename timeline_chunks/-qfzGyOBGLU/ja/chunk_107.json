[{"type": "subtitle", "time": 6420.709, "timestamp": "01:47:00", "text": "観客を騙す。ええ、ありますよ"}, {"type": "subtitle", "time": 6425.47, "timestamp": "01:47:05", "text": "[音楽]"}, {"type": "subtitle", "time": 6429.51, "timestamp": "01:47:09", "text": "あまりにも。それが現実さ。"}, {"type": "subtitle", "time": 6438.43, "timestamp": "01:47:18", "text": "[音楽]"}, {"type": "subtitle", "time": 6441.75, "timestamp": "01:47:21", "text": "えっと、私は何人かのユーチューバーを知っていると思うのですが"}, {"type": "subtitle", "time": 6445.83, "timestamp": "01:47:25", "text": "音声機能を使う声です。私は...するだろう"}, {"type": "subtitle", "time": 6447.149, "timestamp": "01:47:27", "text": "言う"}, {"type": "subtitle", "time": 6449.669, "timestamp": "01:47:29", "text": "ある程度までは健康である程度までは"}, {"type": "subtitle", "time": 6451.35, "timestamp": "01:47:31", "text": "YouTuber文化はあまりにも親密になりすぎていた"}, {"type": "subtitle", "time": 6452.99, "timestamp": "01:47:32", "text": "アイドル文化へ。"}, {"type": "subtitle", "time": 6455.91, "timestamp": "01:47:35", "text": "うん。バランスを保つために"}, {"type": "subtitle", "time": 6458.629, "timestamp": "01:47:38", "text": "パラソーシャルから離れる。ああ、準社会主義ですね。"}, {"type": "subtitle", "time": 6465.47, "timestamp": "01:47:45", "text": "スペイン。それは痛みだ。"}, {"type": "subtitle", "time": 6468.629, "timestamp": "01:47:48", "text": "ああ、私はラシアになりそうな気がする"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "私が進む道のどの時点でも"}, {"type": "subtitle", "time": 6472.189, "timestamp": "01:47:52", "text": "私の"}, {"type": "subtitle", "time": 6474.47, "timestamp": "01:47:54", "text": "もの。 2 日目に何が起こったか覚えていますか"}, {"type": "subtitle", "time": 6477.03, "timestamp": "01:47:57", "text": "数週間前？どれ？なんてドラマだ"}, {"type": "subtitle", "time": 6479.03, "timestamp": "01:47:59", "text": "コミュニティで起こったことは"}]
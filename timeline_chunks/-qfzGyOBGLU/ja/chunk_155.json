[{"type": "subtitle", "time": 9300.309, "timestamp": "02:35:00", "text": "新作ゲームをプレイ"}, {"type": "subtitle", "time": 9302.71, "timestamp": "02:35:02", "text": "30日に発売される"}, {"type": "subtitle", "time": 9306.469, "timestamp": "02:35:06", "text": "11月。それはウォーハンマー40,000と呼ばれています。"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "暗い。それはラストラストのようなものです"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "Left for Dead 2みたいな感じだけど、もっと良い"}, {"type": "subtitle", "time": 9318.309, "timestamp": "02:35:18", "text": "種の。ええ、そうですね。ああ、待ちきれない"}, {"type": "subtitle", "time": 9320.79, "timestamp": "02:35:20", "text": "プレイしてください。どうやら私は尋ねたようだ"}, {"type": "subtitle", "time": 9323.349, "timestamp": "02:35:23", "text": "VTuberの中にYouTuberがいるなら"}, {"type": "subtitle", "time": 9325.71, "timestamp": "02:35:25", "text": "所有している。誰もいないようだ"}, {"type": "subtitle", "time": 9328.55, "timestamp": "02:35:28", "text": "まだ。いいえ。誰も私に連絡してきませんでした。"}, {"type": "subtitle", "time": 9330.389, "timestamp": "02:35:30", "text": "彼らは得点を重ねたいのだ。おそらく"}, {"type": "subtitle", "time": 9333.51, "timestamp": "02:35:33", "text": "ソロでプレイするか、ランダムにメンバーを補充します。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "えーと、ダークタイドストリーム用。そう、それは"}, {"type": "subtitle", "time": 9338.87, "timestamp": "02:35:38", "text": "大丈夫。そして土曜日にはコラボレーションがあります"}, {"type": "subtitle", "time": 9341.83, "timestamp": "02:35:41", "text": "唯一無二のフジフジと一緒にストリーミングしよう。"}, {"type": "subtitle", "time": 9344.429, "timestamp": "02:35:44", "text": "ああ、富士って言ったっけ？ああ、"}, {"type": "subtitle", "time": 9346.51, "timestamp": "02:35:46", "text": "神。富士"}, {"type": "subtitle", "time": 9349.03, "timestamp": "02:35:49", "text": "エベレスト。ええ、私たちは"}, {"type": "subtitle", "time": 9351.429, "timestamp": "02:35:51", "text": "富士山の息子、エベレスト。私たちはピューピューと撃ちます"}, {"type": "subtitle", "time": 9352.91, "timestamp": "02:35:52", "text": "の"}, {"type": "subtitle", "time": 9355.99, "timestamp": "02:35:55", "text": "空気。それはスターだ。えっと、スターウォーズ"}, {"type": "subtitle", "time": 9358.79, "timestamp": "02:35:58", "text": "Squadronゲームは無料で入手できます"}]
[{"type": "subtitle", "time": 16863.51, "timestamp": "04:41:03", "text": "うん。問題ない。ゲームを楽しんでください。こんにちは。あなた"}, {"type": "subtitle", "time": 16869.948, "timestamp": "04:41:09", "text": "楽しむ。おい。私は人を殺すことはできない。 O."}, {"type": "subtitle", "time": 16874.55, "timestamp": "04:41:14", "text": "バカ。これはPVEゲームです。 M終了。"}, {"type": "subtitle", "time": 16876.628, "timestamp": "04:41:16", "text": "アカウント停止とかになるだろうな。私はほしくない"}, {"type": "subtitle", "time": 16880.67, "timestamp": "04:41:20", "text": "初日からアカウント停止処分を受けるなんて。"}, {"type": "subtitle", "time": 16885.35, "timestamp": "04:41:25", "text": "あらら、あそこに人がいるわ。おお。"}, {"type": "subtitle", "time": 16887.75, "timestamp": "04:41:27", "text": "わかった。えっと、ロックするつもりだったんですよね？"}, {"type": "subtitle", "time": 16895.35, "timestamp": "04:41:35", "text": "このドアをロック/ロック解除しますか？"}, {"type": "subtitle", "time": 16896.99, "timestamp": "04:41:36", "text": "クレ。"}, {"type": "subtitle", "time": 16904.628, "timestamp": "04:41:44", "text": "鍵。待って。ドアの鍵。待って。何てことだ。"}, {"type": "subtitle", "time": 16907.39, "timestamp": "04:41:47", "text": "待って。そうやってやるんですか？何てことだ。"}, {"type": "subtitle", "time": 16909.39, "timestamp": "04:41:49", "text": "何？"}, {"type": "subtitle", "time": 16912.868, "timestamp": "04:41:52", "text": "ロックを解除します。ロックを解除する。ノック。これをロックする"}, {"type": "subtitle", "time": 16918.75, "timestamp": "04:41:58", "text": "ドア。ああ、わかりました。わかった。わかった。ロックを解除して"}]
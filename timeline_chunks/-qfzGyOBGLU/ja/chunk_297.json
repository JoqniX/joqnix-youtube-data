[{"type": "subtitle", "time": 17821.47, "timestamp": "04:57:01", "text": "パルクール"}, {"type": "subtitle", "time": 17845.35, "timestamp": "04:57:25", "text": "ファン。わーい。"}, {"type": "subtitle", "time": 17847.31, "timestamp": "04:57:27", "text": "あなたは"}, {"type": "subtitle", "time": 17850.51, "timestamp": "04:57:30", "text": "それ。これは何ですか"}, {"type": "subtitle", "time": 17853.31, "timestamp": "04:57:33", "text": "戦利品？道"}, {"type": "subtitle", "time": 17855.948, "timestamp": "04:57:35", "text": "兆候。えっと"}, {"type": "subtitle", "time": 17864.47, "timestamp": "04:57:44", "text": "えっと、石を敷くとしたら、私たちは"}, {"type": "subtitle", "time": 17866.35, "timestamp": "04:57:46", "text": "これを使うことができます"}, {"type": "subtitle", "time": 17869.788, "timestamp": "04:57:49", "text": "実は。わかった。えっと、何を投げればいいかな"}, {"type": "subtitle", "time": 17878.708, "timestamp": "04:57:58", "text": "ええと、ロープです。ええと、ロープの長さです。"}]
[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "治療法は？忘れた。ええ、そうですね。えっと、私は思う"}, {"type": "subtitle", "time": 9904.71, "timestamp": "02:45:04", "text": "水分を摂る、水を飲む、そして"}, {"type": "subtitle", "time": 9911.67, "timestamp": "02:45:11", "text": "忘れた。でも、念のため予防策は講じてください。"}, {"type": "subtitle", "time": 9914.07, "timestamp": "02:45:14", "text": "わかった。予防措置を講じ、"}, {"type": "subtitle", "time": 9916.87, "timestamp": "02:45:16", "text": "もの。わかった。"}, {"type": "subtitle", "time": 9920.389, "timestamp": "02:45:20", "text": "だから、えーと、あなたの家族の残りの人たちや"}, {"type": "subtitle", "time": 9922.87, "timestamp": "02:45:22", "text": "ええと、愛する人もCOを受け取ることはありません。"}, {"type": "subtitle", "time": 9925.67, "timestamp": "02:45:25", "text": "だから隔離する必要がある"}, {"type": "subtitle", "time": 9932.429, "timestamp": "02:45:32", "text": "忘れた"}, {"type": "subtitle", "time": 9935.71, "timestamp": "02:45:35", "text": "痛み。うん"}, {"type": "subtitle", "time": 9937.63, "timestamp": "02:45:37", "text": "もの。"}, {"type": "subtitle", "time": 9941.51, "timestamp": "02:45:41", "text": "というわけで、こんにちはディアブロの息子よ。元気かい？"}, {"type": "subtitle", "time": 9945.67, "timestamp": "02:45:45", "text": "元気ですか？元気です。"}, {"type": "subtitle", "time": 9949.11, "timestamp": "02:45:49", "text": "調子はいいけど、良くないところもある。"}, {"type": "subtitle", "time": 9950.67, "timestamp": "02:45:50", "text": "失った"}, {"type": "subtitle", "time": 9954.83, "timestamp": "02:45:54", "text": "私のUbisoftアカウント。だから、私は"}, {"type": "subtitle", "time": 9958.95, "timestamp": "02:45:58", "text": "怒っているのではなく、失望している"}]
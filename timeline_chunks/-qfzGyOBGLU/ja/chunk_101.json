[{"type": "subtitle", "time": 6060.55, "timestamp": "01:41:00", "text": "うん。だから私は12時間連続で働いていた"}, {"type": "subtitle", "time": 6063.189, "timestamp": "01:41:03", "text": "あまり休憩を取らずに座っている"}, {"type": "subtitle", "time": 6065.27, "timestamp": "01:41:05", "text": "1回の座談会で2時間くらいかかるような感じ"}, {"type": "subtitle", "time": 6070.07, "timestamp": "01:41:10", "text": "私の健康を破壊したもの"}, {"type": "subtitle", "time": 6073.51, "timestamp": "01:41:13", "text": "それは悪いことですが、最近私は"}, {"type": "subtitle", "time": 6076.55, "timestamp": "01:41:16", "text": "最近は、最近ではなく、"}, {"type": "subtitle", "time": 6079.35, "timestamp": "01:41:19", "text": "私は、"}, {"type": "subtitle", "time": 6082.51, "timestamp": "01:41:22", "text": "他のストリーマーは、あなたのゲームをプレイするのと同じようにそれをします"}, {"type": "subtitle", "time": 6087.83, "timestamp": "01:41:27", "text": "WSって、昔の配信のことですよね？"}, {"type": "subtitle", "time": 6090.87, "timestamp": "01:41:30", "text": "これはTwitch文化でより頻繁に行われ、私は"}, {"type": "subtitle", "time": 6093.99, "timestamp": "01:41:33", "text": "YouTubeのためにやってるんだけど"}, {"type": "subtitle", "time": 6097.35, "timestamp": "01:41:37", "text": "Twitchで配信中。だから私はそうしたので"}, {"type": "subtitle", "time": 6099.99, "timestamp": "01:41:39", "text": "そうすればもっと休憩を取れるよね？その間"}, {"type": "subtitle", "time": 6101.75, "timestamp": "01:41:41", "text": "ストリームが"}, {"type": "subtitle", "time": 6103.83, "timestamp": "01:41:43", "text": "楽しませてくれて、雰囲気はまだ"}, {"type": "subtitle", "time": 6106.95, "timestamp": "01:41:46", "text": "続いてるよね？そして私は休憩を取ることができる"}, {"type": "subtitle", "time": 6110.79, "timestamp": "01:41:50", "text": "そして戻ってきてください。うん。だから、私はちょっと遊んでいます"}, {"type": "subtitle", "time": 6113.43, "timestamp": "01:41:53", "text": "この24時間放送の番組でも同じ形式を採用しています。"}, {"type": "subtitle", "time": 6115.51, "timestamp": "01:41:55", "text": "ジョッカソンの配信、"}, {"type": "subtitle", "time": 6119.229, "timestamp": "01:41:59", "text": "私のテレビモデルデビューのためのクラウドファンディング"}]
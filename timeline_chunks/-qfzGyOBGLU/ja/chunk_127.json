[{"type": "subtitle", "time": 7620.629, "timestamp": "02:07:00", "text": "ええ、私のために戻ってきてほしいだけです"}, {"type": "subtitle", "time": 7622.47, "timestamp": "02:07:02", "text": "エンターテイメントの仕事に就くか、"}, {"type": "subtitle", "time": 7626.47, "timestamp": "02:07:06", "text": "何かを宣伝して、"}, {"type": "subtitle", "time": 7628.709, "timestamp": "02:07:08", "text": "インディアンが茂みか何かに会って"}, {"type": "subtitle", "time": 7632.709, "timestamp": "02:07:12", "text": "また、私の旅を"}, {"type": "subtitle", "time": 7636.75, "timestamp": "02:07:16", "text": "より幅広い観客の隣にいるスポーツマン"}, {"type": "subtitle", "time": 7639.91, "timestamp": "02:07:19", "text": "そして、より多くの機会を得る。もしかしたら"}, {"type": "subtitle", "time": 7643.069, "timestamp": "02:07:23", "text": "偶像。わからない"}, {"type": "subtitle", "time": 7645.51, "timestamp": "02:07:25", "text": "可能。私は自分が"}, {"type": "subtitle", "time": 7648.069, "timestamp": "02:07:28", "text": "アイドル。でも、まあ、害はないだろうね"}, {"type": "subtitle", "time": 7652.83, "timestamp": "02:07:32", "text": "[音楽]"}, {"type": "subtitle", "time": 7655.669, "timestamp": "02:07:35", "text": "試す。その時彼は持っていなかった"}, {"type": "subtitle", "time": 7658.07, "timestamp": "02:07:38", "text": "彼が現在持っている知識と同じくらい。"}, {"type": "subtitle", "time": 7661.149, "timestamp": "02:07:41", "text": "[音楽]"}, {"type": "subtitle", "time": 7667.08, "timestamp": "02:07:47", "text": "知る。"}]
[{"type": "subtitle", "time": 4860.99, "timestamp": "01:21:00", "text": "わかりました、そうします"}, {"type": "subtitle", "time": 4880.229, "timestamp": "01:21:20", "text": "ああ、それはあまりにも痛すぎるだろう。もし私が"}, {"type": "subtitle", "time": 4881.79, "timestamp": "01:21:21", "text": "データを失い、"}, {"type": "subtitle", "time": 4884.149, "timestamp": "01:21:24", "text": "すべて？だから私はこう思う"}, {"type": "subtitle", "time": 4886.79, "timestamp": "01:21:26", "text": "アシスタント。そして、支払う方が良い"}, {"type": "subtitle", "time": 4888.51, "timestamp": "01:21:28", "text": "ライセンス、"}, {"type": "subtitle", "time": 4892.55, "timestamp": "01:21:32", "text": "それに、私はそれをいくつかの"}, {"type": "subtitle", "time": 4894.189, "timestamp": "01:21:34", "text": "カップル"}, {"type": "subtitle", "time": 4896.51, "timestamp": "01:21:36", "text": "数ヶ月、"}, {"type": "subtitle", "time": 4901.11, "timestamp": "01:21:41", "text": "右？私も血清が欲しいです。"}, {"type": "subtitle", "time": 4903.35, "timestamp": "01:21:43", "text": "クラロンとセラムで遊びたい"}, {"type": "subtitle", "time": 4906.55, "timestamp": "01:21:46", "text": "あまりにも。でも、そのためには免許を取らないといけない"}, {"type": "subtitle", "time": 4916.11, "timestamp": "01:21:56", "text": "25件のデータ。それは最大で保存されます"}]
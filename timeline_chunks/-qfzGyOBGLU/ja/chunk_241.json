[{"type": "subtitle", "time": 14464.59, "timestamp": "04:01:04", "text": "キャンプファイヤー。誰かの椅子もまた"}, {"type": "subtitle", "time": 14469.15, "timestamp": "04:01:09", "text": "ここ。これは何ですか？木の幹？"}, {"type": "subtitle", "time": 14472.63, "timestamp": "04:01:12", "text": "さて、私はどこへ行くのでしょうか？私はしません"}, {"type": "subtitle", "time": 14478.229, "timestamp": "04:01:18", "text": "つるはしが木には使えないことは分かっている。"}, {"type": "subtitle", "time": 14480.99, "timestamp": "04:01:20", "text": "はい、わかりました"}, {"type": "subtitle", "time": 14484.63, "timestamp": "04:01:24", "text": "あなた。それで、Xさん、どうやって私のことを知ったのですか？"}, {"type": "subtitle", "time": 14513.51, "timestamp": "04:01:53", "text": "私たちは主に石を探しているので、"}, {"type": "subtitle", "time": 14517.11, "timestamp": "04:01:57", "text": "手斧を作ることができ、それが私を助けてくれる"}, {"type": "subtitle", "time": 14518.429, "timestamp": "04:01:58", "text": "あなたへ"}]
[{"type": "subtitle", "time": 13579.03, "timestamp": "03:46:19", "text": "痛み。大丈夫です。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 13581.99, "timestamp": "03:46:21", "text": "大丈夫です。ドナルド・ドリフター、今行くよ"}, {"type": "subtitle", "time": 13584.95, "timestamp": "03:46:24", "text": "あなたのために。近日公開。お前を迎えに行くぞ。私は"}, {"type": "subtitle", "time": 13596.71, "timestamp": "03:46:36", "text": "時間。私はこれらのことを何も知りません。クラフトする"}, {"type": "subtitle", "time": 13599.189, "timestamp": "03:46:39", "text": "寝袋。ああ、私は"}, {"type": "subtitle", "time": 13601.83, "timestamp": "03:46:41", "text": "寝袋を使ってリスポーン地点を設定する。"}, {"type": "subtitle", "time": 13608.67, "timestamp": "03:46:48", "text": "学ぶ。ああ、神様。まず最初に"}, {"type": "subtitle", "time": 13610.83, "timestamp": "03:46:50", "text": "初め、"}, {"type": "subtitle", "time": 13613.63, "timestamp": "03:46:53", "text": "私たちは"}]
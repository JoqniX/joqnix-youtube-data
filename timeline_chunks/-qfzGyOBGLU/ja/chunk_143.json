[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "ガイドライン。彼らは、ああ、これは"}, {"type": "subtitle", "time": 8586.91, "timestamp": "02:23:06", "text": "断然良い。これは断然良い。ああ、"}, {"type": "subtitle", "time": 8589.67, "timestamp": "02:23:09", "text": "神。ファンアート募集。はい、できます"}, {"type": "subtitle", "time": 8606.63, "timestamp": "02:23:26", "text": "いいね。ああ、これは本当にすごい。欲しい"}, {"type": "subtitle", "time": 8608.03, "timestamp": "02:23:28", "text": "する"}, {"type": "subtitle", "time": 8618.07, "timestamp": "02:23:38", "text": "少し。彼女は行く。マスコットを配置できます"}, {"type": "subtitle", "time": 8619.389, "timestamp": "02:23:39", "text": "以上"}, {"type": "subtitle", "time": 8623.309, "timestamp": "02:23:43", "text": "ここ。コンサートのすべてのマスコット"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "飛行機、みんなに"}, {"type": "subtitle", "time": 8628.79, "timestamp": "02:23:48", "text": "それぞれ異なるユニークな"}]
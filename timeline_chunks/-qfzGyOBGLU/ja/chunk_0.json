[{"type": "subtitle", "time": 11.589, "timestamp": "00:00:11", "text": "[音楽]"}, {"type": "subtitle", "time": 29.189, "timestamp": "00:00:29", "text": "ジョアトンの16日目へようこそ"}, {"type": "subtitle", "time": 30.99, "timestamp": "00:00:30", "text": "1つ。ようこそ"}, {"type": "subtitle", "time": 34.389, "timestamp": "00:00:34", "text": "第1四半期ストリームへようこそ"}, {"type": "subtitle", "time": 36.87, "timestamp": "00:00:36", "text": "そして私はどこで寝るつもりなのか"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "今日は睡眠不足だ。昨日は"}, {"type": "subtitle", "time": 42.03, "timestamp": "00:00:42", "text": "昨晩。つまり"}, {"type": "subtitle", "time": 46.869, "timestamp": "00:00:46", "text": "今朝は私にとって大変でした"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "私には多すぎる。私はマインクラフトで死んだ。私"}, {"type": "subtitle", "time": 52.31, "timestamp": "00:00:52", "text": "全てが死んだ。私はすべてを失った。"}, {"type": "subtitle", "time": 53.869, "timestamp": "00:00:53", "text": "つまり、痛みだ"}]
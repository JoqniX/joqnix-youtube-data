[{"type": "subtitle", "time": 6121.709, "timestamp": "01:42:01", "text": "もの。"}, {"type": "subtitle", "time": 6125.109, "timestamp": "01:42:05", "text": "えっと、だから私はいつも寝ているとき、"}, {"type": "subtitle", "time": 6127.35, "timestamp": "01:42:07", "text": "ボードを取り付けて、戻ってきたら、"}, {"type": "subtitle", "time": 6129.51, "timestamp": "01:42:09", "text": "私は出席し、実際に"}, {"type": "subtitle", "time": 6132.79, "timestamp": "01:42:12", "text": "最高ですよね？ああ、声が裏返ってる"}, {"type": "subtitle", "time": 6147.75, "timestamp": "01:42:27", "text": "H2。自動ストリーミング。ああ、私は昔"}, {"type": "subtitle", "time": 6149.27, "timestamp": "01:42:29", "text": "自動ストリーミングシステム。教えてあげよう"}, {"type": "subtitle", "time": 6152.43, "timestamp": "01:42:32", "text": "私のバックエンドはどうやって"}, {"type": "subtitle", "time": 6155.51, "timestamp": "01:42:35", "text": "作品。自動ストリーミング。どうやってやったかって？私はそうしました"}, {"type": "subtitle", "time": 6160.109, "timestamp": "01:42:40", "text": "それは、ええと、1週間ほど前のことです。そうだった"}, {"type": "subtitle", "time": 6163.189, "timestamp": "01:42:43", "text": "例えば、私が6時に配信するとしましょう。"}, {"type": "subtitle", "time": 6165.83, "timestamp": "01:42:45", "text": "午前。了解。実際に起こることは、私がセットアップすることです"}, {"type": "subtitle", "time": 6168.31, "timestamp": "01:42:48", "text": "すべて。私のシステムがどのように動作するかは"}, {"type": "subtitle", "time": 6172.39, "timestamp": "01:42:52", "text": "午後10時にPCをオフにします。昨日の夜に。"}, {"type": "subtitle", "time": 6175.03, "timestamp": "01:42:55", "text": "朝、そしてあなたと一緒にいる時、私は安らかに眠ります。"}, {"type": "subtitle", "time": 6178.07, "timestamp": "01:42:58", "text": "わかった。私は安らかに眠る。コンピューター"}]
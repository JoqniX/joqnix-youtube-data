[{"type": "subtitle", "time": 21060.548, "timestamp": "05:51:00", "text": "の上。わかった。それで、お元気ですか？えっと、エド"}, {"type": "subtitle", "time": 21063.948, "timestamp": "05:51:03", "text": "白い看板。お元気でお過ごしでしょうか。で"}, {"type": "subtitle", "time": 21068.47, "timestamp": "05:51:08", "text": "少なくとも、あなたが元気でいることを願っています。ミア。"}, {"type": "subtitle", "time": 21070.11, "timestamp": "05:51:10", "text": "おお、"}, {"type": "subtitle", "time": 21082.19, "timestamp": "05:51:22", "text": "帽子。戦利品が"}, {"type": "subtitle", "time": 21104.548, "timestamp": "05:51:44", "text": "これを運転できますか？もしあなたが"}, {"type": "subtitle", "time": 21107.47, "timestamp": "05:51:47", "text": "これを運転してください。でも補充する必要がある、"}, {"type": "subtitle", "time": 21111.51, "timestamp": "05:51:51", "text": "右？車さえ手に入れば、"}]
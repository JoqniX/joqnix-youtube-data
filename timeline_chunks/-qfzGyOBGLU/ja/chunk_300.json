[{"type": "subtitle", "time": 18000.628, "timestamp": "05:00:00", "text": "箱。これは何ですか？ギア。私は思う"}, {"type": "subtitle", "time": 18002.75, "timestamp": "05:00:02", "text": "これを見た"}, {"type": "subtitle", "time": 18006.75, "timestamp": "05:00:06", "text": "アイテム。それは重要だと思います。私はしません"}, {"type": "subtitle", "time": 18011.15, "timestamp": "05:00:11", "text": "知る。えっと、ちょっと必要なんです"}, {"type": "subtitle", "time": 18014.07, "timestamp": "05:00:14", "text": "えっと、投げた方がいいかな？あのね？病気"}, {"type": "subtitle", "time": 18016.11, "timestamp": "05:00:16", "text": "削除する"}, {"type": "subtitle", "time": 18025.43, "timestamp": "05:00:25", "text": "1つ。まだ先は長い。わかった。ああ、"}, {"type": "subtitle", "time": 18028.11, "timestamp": "05:00:28", "text": "手斧。"}, {"type": "subtitle", "time": 18040.55, "timestamp": "05:00:40", "text": "これ。転んだらどうなるか想像してみて"}, {"type": "subtitle", "time": 18058.47, "timestamp": "05:00:58", "text": "人々。なぜ私は"}]
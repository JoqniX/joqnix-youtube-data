[{"type": "subtitle", "time": 1982.47, "timestamp": "00:33:02", "text": "ほら、問題は、私にはできるんだ"}, {"type": "subtitle", "time": 1986.389, "timestamp": "00:33:06", "text": "私が知っている選択肢ですが、"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "最新の機能が欲しいので購入します"}, {"type": "subtitle", "time": 1993.669, "timestamp": "00:33:13", "text": "ライセンスもずっと良いですよ"}, {"type": "subtitle", "time": 1996.63, "timestamp": "00:33:16", "text": "でも、ただお金がないだけなんです"}, {"type": "subtitle", "time": 1999.149, "timestamp": "00:33:19", "text": "少なくともそれを使うことができる"}, {"type": "subtitle", "time": 2002.149, "timestamp": "00:33:22", "text": "ええ、音楽もインストラクターは"}, {"type": "subtitle", "time": 2011.029, "timestamp": "00:33:31", "text": "1年後の購読"}, {"type": "subtitle", "time": 2018.47, "timestamp": "00:33:38", "text": "言ったけど、一時停止しなければならなかった"}, {"type": "subtitle", "time": 2019.87, "timestamp": "00:33:39", "text": "2月"}, {"type": "subtitle", "time": 2022.71, "timestamp": "00:33:42", "text": "先に進むのは、"}]
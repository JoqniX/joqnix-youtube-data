[{"type": "subtitle", "time": 3362.349, "timestamp": "00:56:02", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 3365.99, "timestamp": "00:56:05", "text": "声。うん。でも私は「ああ、なんてことだ、"}, {"type": "subtitle", "time": 3368.47, "timestamp": "00:56:08", "text": "今は頭が真っ白で、"}, {"type": "subtitle", "time": 3371.47, "timestamp": "00:56:11", "text": "家に帰るには、私の家に戻る"}, {"type": "subtitle", "time": 3373.87, "timestamp": "00:56:13", "text": "マインクラフト。私は対処したくない"}, {"type": "subtitle", "time": 3380.03, "timestamp": "00:56:20", "text": "多くの。"}, {"type": "subtitle", "time": 3381.87, "timestamp": "00:56:21", "text": "[音楽]"}, {"type": "subtitle", "time": 3395.589, "timestamp": "00:56:35", "text": "過去の各モデルに共通する要素。"}, {"type": "subtitle", "time": 3398.549, "timestamp": "00:56:38", "text": "はい。私はそれを描写します"}, {"type": "subtitle", "time": 3401.549, "timestamp": "00:56:41", "text": "公式モデルを通じて"}, {"type": "subtitle", "time": 3404.19, "timestamp": "00:56:44", "text": "適切な"}, {"type": "subtitle", "time": 3407.39, "timestamp": "00:56:47", "text": "モデル。それは一般的になるだろう"}, {"type": "subtitle", "time": 3415.069, "timestamp": "00:56:55", "text": "道路。"}, {"type": "subtitle", "time": 3418.26, "timestamp": "00:56:58", "text": "だから技術"}]
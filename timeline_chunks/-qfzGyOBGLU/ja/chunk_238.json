[{"type": "subtitle", "time": 14280.75, "timestamp": "03:58:00", "text": "おお。"}, {"type": "subtitle", "time": 14311.99, "timestamp": "03:58:31", "text": "アコースティックギターを手に入れました。待って、私は"}, {"type": "subtitle", "time": 14322.269, "timestamp": "03:58:42", "text": "怖がった。できると思う。わかった、絶対にない"}, {"type": "subtitle", "time": 14324.87, "timestamp": "03:58:44", "text": "心。気にしないでください。誰かが"}, {"type": "subtitle", "time": 14328.55, "timestamp": "03:58:48", "text": "ここに住んでいる。私はただステルスを手に入れているだけです"}, {"type": "subtitle", "time": 14336.229, "timestamp": "03:58:56", "text": "[音楽]"}, {"type": "subtitle", "time": 14339.469, "timestamp": "03:58:59", "text": "これはなかなか良いですね。できますか"}]
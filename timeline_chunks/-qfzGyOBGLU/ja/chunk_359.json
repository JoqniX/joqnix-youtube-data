[{"type": "subtitle", "time": 21540.83, "timestamp": "05:59:00", "text": "レンダリング関連のもの？えっと、私はRTXを持っています"}, {"type": "subtitle", "time": 21543.868, "timestamp": "05:59:03", "text": "2060年はもうすぐ"}, {"type": "subtitle", "time": 21547.39, "timestamp": "05:59:07", "text": "死んでもまだ生きている"}, {"type": "subtitle", "time": 21550.868, "timestamp": "05:59:10", "text": "どういうわけか、それでうまくいく。それが私の"}, {"type": "subtitle", "time": 21557.35, "timestamp": "05:59:17", "text": "と。でも、私は走るべきではない"}, {"type": "subtitle", "time": 21560.708, "timestamp": "05:59:20", "text": "背景に写っているものすべて。私がそうしたら"}, {"type": "subtitle", "time": 21563.788, "timestamp": "05:59:23", "text": "全体をクラッシュさせる"}, {"type": "subtitle", "time": 21566.19, "timestamp": "05:59:26", "text": "PCとは"}, {"type": "subtitle", "time": 21568.788, "timestamp": "05:59:28", "text": "難しい。それは"}, {"type": "subtitle", "time": 21570.708, "timestamp": "05:59:30", "text": "温度の問題と粘着性"}, {"type": "subtitle", "time": 21573.35, "timestamp": "05:59:33", "text": "ファンの問題。それは非常に不安定になり、"}, {"type": "subtitle", "time": 21576.948, "timestamp": "05:59:36", "text": "一瞬。でも、プロセッサは、えーと"}]
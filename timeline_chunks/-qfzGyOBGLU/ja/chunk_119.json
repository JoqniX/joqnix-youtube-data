[{"type": "subtitle", "time": 7150.55, "timestamp": "01:59:10", "text": "ファンタジーの世界に飛び込んで、偽りの人生を生きよう"}, {"type": "subtitle", "time": 7165.27, "timestamp": "01:59:25", "text": "金が全くない。大丈夫。では"}, {"type": "subtitle", "time": 7169.589, "timestamp": "01:59:29", "text": "将来、お金を稼げるなら"}, {"type": "subtitle", "time": 7172.87, "timestamp": "01:59:32", "text": "運が良ければ、実際にたくさん貯金できます。"}, {"type": "subtitle", "time": 7175.03, "timestamp": "01:59:35", "text": "そうだよ、常に貯金しておくんだ。しないで"}, {"type": "subtitle", "time": 7176.75, "timestamp": "01:59:36", "text": "私のような。私は"}, {"type": "subtitle", "time": 7178.27, "timestamp": "01:59:38", "text": "節約。"}, {"type": "subtitle", "time": 7181.109, "timestamp": "01:59:41", "text": "ああ、君が手に入れられるとき"}, {"type": "subtitle", "time": 7184.31, "timestamp": "01:59:44", "text": "十分な貯蓄と物資があれば、"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "自分を"}, {"type": "subtitle", "time": 7187.51, "timestamp": "01:59:47", "text": "休暇。"}, {"type": "subtitle", "time": 7190.95, "timestamp": "01:59:50", "text": "だから世界を楽しむことも、"}, {"type": "subtitle", "time": 7193.35, "timestamp": "01:59:53", "text": "海外旅行か何か"}, {"type": "subtitle", "time": 7195.47, "timestamp": "01:59:55", "text": "訪問または観光または"}, {"type": "subtitle", "time": 7198.87, "timestamp": "01:59:58", "text": "何か。うん。なぜなら、ある意味であなたは"}]
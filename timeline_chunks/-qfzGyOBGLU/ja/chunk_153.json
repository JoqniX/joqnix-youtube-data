[{"type": "subtitle", "time": 9181.469, "timestamp": "02:33:01", "text": "なぜなら、今は時間だから"}, {"type": "subtitle", "time": 9184.79, "timestamp": "02:33:04", "text": "誕生日。えっと、私の"}, {"type": "subtitle", "time": 9187.349, "timestamp": "02:33:07", "text": "また誕生日だ。忘れないでください、それは"}, {"type": "subtitle", "time": 9191.95, "timestamp": "02:33:11", "text": "私の誕生日。わかった。ああ、そうだね。それで"}, {"type": "subtitle", "time": 9195.51, "timestamp": "02:33:15", "text": "えっと、30日はタイムの誕生日です。私たちは"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "YouTubeでライブ配信を行います。私はしていません"}, {"type": "subtitle", "time": 9200.63, "timestamp": "02:33:20", "text": "まだスケジュールしてないんだけど、えっと、まだ"}, {"type": "subtitle", "time": 9203.429, "timestamp": "02:33:23", "text": "何をすべきか考えているので、"}, {"type": "subtitle", "time": 9207.83, "timestamp": "02:33:27", "text": "ちゃんとしたスケッチがないとか、"}, {"type": "subtitle", "time": 9210.07, "timestamp": "02:33:30", "text": "何でも。私はただピッククルーを持っているだけです"}, {"type": "subtitle", "time": 9213.19, "timestamp": "02:33:33", "text": "それで、私は自分の決めたことは、"}, {"type": "subtitle", "time": 9216.389, "timestamp": "02:33:36", "text": "キャラクターデザインの最初のバージョン"}, {"type": "subtitle", "time": 9218.95, "timestamp": "02:33:38", "text": "まあ、使えるかどうか心配です"}, {"type": "subtitle", "time": 9220.469, "timestamp": "02:33:40", "text": "サムネイル用かどうか。だから私はこう思う"}, {"type": "subtitle", "time": 9223.59, "timestamp": "02:33:43", "text": "それを遅らせる。ええと、水曜日"}, {"type": "subtitle", "time": 9226.79, "timestamp": "02:33:46", "text": "30日午後4時30分配信します"}, {"type": "subtitle", "time": 9229.75, "timestamp": "02:33:49", "text": "私に何でも質問できる"}, {"type": "subtitle", "time": 9232.469, "timestamp": "02:33:52", "text": "Onexia、私の将来のプロジェクトは、えーと"}, {"type": "subtitle", "time": 9235.19, "timestamp": "02:33:55", "text": "Onexiaとは、"}, {"type": "subtitle", "time": 9238.55, "timestamp": "02:33:58", "text": "航海とか、そういうこと全部。えっと"}]
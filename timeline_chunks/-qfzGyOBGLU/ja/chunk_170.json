[{"type": "subtitle", "time": 10202.99, "timestamp": "02:50:02", "text": "話す？ああ、音声送信ste。"}, {"type": "subtitle", "time": 10205.83, "timestamp": "02:50:05", "text": "えっと、自分の声が"}, {"type": "subtitle", "time": 10208.35, "timestamp": "02:50:08", "text": "ハプニング？どうすればいいですか"}, {"type": "subtitle", "time": 10210.91, "timestamp": "02:50:10", "text": "[音楽]"}, {"type": "subtitle", "time": 10215.389, "timestamp": "02:50:15", "text": "チェック？待って、どうして私がそれを知っているのか"}, {"type": "subtitle", "time": 10219.83, "timestamp": "02:50:19", "text": "音声ですか？ 「オーマイゴッド」はありません。"}, {"type": "subtitle", "time": 10221.95, "timestamp": "02:50:21", "text": "どうすれば変更できますか？"}, {"type": "subtitle", "time": 10224.87, "timestamp": "02:50:24", "text": "冗談でしょう。ありえない"}, {"type": "subtitle", "time": 10233.87, "timestamp": "02:50:33", "text": "大丈夫。それで、えっと、どこに"}, {"type": "subtitle", "time": 10237.95, "timestamp": "02:50:37", "text": "私たちは？地図を開くにはどうすればいいですか？"}, {"type": "subtitle", "time": 10248.07, "timestamp": "02:50:48", "text": "これら。明らかに16人が"}]
[{"type": "subtitle", "time": 10281.67, "timestamp": "02:51:21", "text": "これ？ああ、うっかり忘れてしまったのか"}, {"type": "subtitle", "time": 10288.269, "timestamp": "02:51:28", "text": "主要な。はい、今ならできます"}, {"type": "subtitle", "time": 10291.03, "timestamp": "02:51:31", "text": "攻撃。映画を見に行くよ。行く"}, {"type": "subtitle", "time": 10293.67, "timestamp": "02:51:33", "text": "それから寝なさい。楽しい配信を。こんにちは。"}, {"type": "subtitle", "time": 10296.469, "timestamp": "02:51:36", "text": "気をつけて。それは何ですか？ありがとう。感謝"}, {"type": "subtitle", "time": 10299.429, "timestamp": "02:51:39", "text": "来てくれてありがとう、タイガー。願わくば"}, {"type": "subtitle", "time": 10301.87, "timestamp": "02:51:41", "text": "映画を見るのに良い作品です。"}, {"type": "subtitle", "time": 10304.15, "timestamp": "02:51:44", "text": "わかった。残りの時間を楽しんでください"}]
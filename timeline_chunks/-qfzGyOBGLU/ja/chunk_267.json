[{"type": "subtitle", "time": 16026.269, "timestamp": "04:27:06", "text": "木材"}, {"type": "subtitle", "time": 16029.51, "timestamp": "04:27:09", "text": "クラフト。さあ行こう。ツールを作成します"}, {"type": "subtitle", "time": 16030.71, "timestamp": "04:27:10", "text": "ここ。"}, {"type": "subtitle", "time": 16032.83, "timestamp": "04:27:12", "text": "横に置くか"}, {"type": "subtitle", "time": 16037.79, "timestamp": "04:27:17", "text": "何か。それまでは、ええと、私たちは"}, {"type": "subtitle", "time": 16041.63, "timestamp": "04:27:21", "text": "これら。この男を勝たせて"}, {"type": "subtitle", "time": 16044.71, "timestamp": "04:27:24", "text": "ここ。開けてください。そして私たちはその物を置いた"}, {"type": "subtitle", "time": 16076.149, "timestamp": "04:27:56", "text": "あれ。米の24時間あたりのコスト。"}]
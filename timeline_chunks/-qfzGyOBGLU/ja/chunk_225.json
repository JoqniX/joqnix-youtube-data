[{"type": "subtitle", "time": 13503.189, "timestamp": "03:45:03", "text": "また。さよなら。こんにちは、ティー。やあ、ドラコーン。できる"}, {"type": "subtitle", "time": 13505.71, "timestamp": "03:45:05", "text": "弓を作るの？弓を作ることができません。"}, {"type": "subtitle", "time": 13522.229, "timestamp": "03:45:22", "text": "もの。できますか？ああ、できます、できます"}, {"type": "subtitle", "time": 13528.83, "timestamp": "03:45:28", "text": "何？シャベルの土台。"}, {"type": "subtitle", "time": 13534.83, "timestamp": "03:45:34", "text": "くそ？"}, {"type": "subtitle", "time": 13539.51, "timestamp": "03:45:39", "text": "えっと、サバイバル用の魚捕り罠。いいえ。"}, {"type": "subtitle", "time": 13559.269, "timestamp": "03:45:59", "text": "キノコ。ああ、なんてことだ、私がそんなに"}]
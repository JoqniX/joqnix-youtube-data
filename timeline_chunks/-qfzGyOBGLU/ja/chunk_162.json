[{"type": "subtitle", "time": 9721.59, "timestamp": "02:42:01", "text": "タイガラン、あなたはどこへ行くべきですか？"}, {"type": "subtitle", "time": 9723.28, "timestamp": "02:42:03", "text": "ベッド？"}, {"type": "subtitle", "time": 9725.51, "timestamp": "02:42:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9729.07, "timestamp": "02:42:09", "text": "調整しようと思った"}, {"type": "subtitle", "time": 9731.15, "timestamp": "02:42:11", "text": "そこにあなたが"}, {"type": "subtitle", "time": 9734.309, "timestamp": "02:42:14", "text": "行く。ええ、待ちきれません。わからない"}, {"type": "subtitle", "time": 9737.67, "timestamp": "02:42:17", "text": "これがどうなるかはわかりませんが、私はこれが"}, {"type": "subtitle", "time": 9743.429, "timestamp": "02:42:23", "text": "良い。ちょっと待ってください。息を吹きかけさせてください"}, {"type": "subtitle", "time": 9745.51, "timestamp": "02:42:25", "text": "画面。 1秒。すべてを閉じる必要があります"}, {"type": "subtitle", "time": 9748.51, "timestamp": "02:42:28", "text": "バックグラウンドアプリケーション。私"}, {"type": "subtitle", "time": 9750.95, "timestamp": "02:42:30", "text": "忘れた。でも、本当に悲劇的だ"}, {"type": "subtitle", "time": 9753.27, "timestamp": "02:42:33", "text": "えっと、マリオ・バヨフトに何が起こったのか"}, {"type": "subtitle", "time": 9756.23, "timestamp": "02:42:36", "text": "アカウント。大丈夫です。そういうこと"}, {"type": "subtitle", "time": 9758.07, "timestamp": "02:42:38", "text": "起こる。私は引き締める必要がある"}, {"type": "subtitle", "time": 9761.51, "timestamp": "02:42:41", "text": "セキュリティもまた、私にはできない"}, {"type": "subtitle", "time": 9762.75, "timestamp": "02:42:42", "text": "多くの"}, {"type": "subtitle", "time": 9766.55, "timestamp": "02:42:46", "text": "キャプチャカードを見せているからですよね？"}, {"type": "subtitle", "time": 9769.75, "timestamp": "02:42:49", "text": "えっと、できないんだけど、もし私が望めばできるんだけど"}, {"type": "subtitle", "time": 9772.389, "timestamp": "02:42:52", "text": "ゲーム用PCで別のOBSを使用し、"}, {"type": "subtitle", "time": 9775.11, "timestamp": "02:42:55", "text": "ゲームキャプチャか何かを使えばいいよ。"}, {"type": "subtitle", "time": 9778.95, "timestamp": "02:42:58", "text": "しかし、そうするとまた動作がかなり遅くなるだろう"}]
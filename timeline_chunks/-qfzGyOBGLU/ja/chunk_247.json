[{"type": "subtitle", "time": 14820.11, "timestamp": "04:07:00", "text": "何？それで"}, {"type": "subtitle", "time": 14824.55, "timestamp": "04:07:04", "text": "良い。ああ、もう遅い時間だ。"}, {"type": "subtitle", "time": 14825.71, "timestamp": "04:07:05", "text": "私"}, {"type": "subtitle", "time": 14830.75, "timestamp": "04:07:10", "text": "このアイテムを安全に保管します。"}, {"type": "subtitle", "time": 14847.75, "timestamp": "04:07:27", "text": "バイオリンとキーボード。私は薬を飲んでいます"}, {"type": "subtitle", "time": 14849.87, "timestamp": "04:07:29", "text": "キーボードとして使えるので"}, {"type": "subtitle", "time": 14852.15, "timestamp": "04:07:32", "text": "良い。私たちはどこへ行くのですか？私たちは行く"}, {"type": "subtitle", "time": 14858.95, "timestamp": "04:07:38", "text": "物を売ったり作ったりできるかもしれない"}]
[{"type": "subtitle", "time": 4440.99, "timestamp": "01:14:00", "text": "今"}, {"type": "subtitle", "time": 4443.91, "timestamp": "01:14:03", "text": "でも私には助けてくれる人が誰もいない"}, {"type": "subtitle", "time": 4446.55, "timestamp": "01:14:06", "text": "ウェブサイトで全て私は全て"}, {"type": "subtitle", "time": 4449.35, "timestamp": "01:14:09", "text": "私自身はウェブスタジオを購入しました"}, {"type": "subtitle", "time": 4451.31, "timestamp": "01:14:11", "text": "生涯契約"}, {"type": "subtitle", "time": 4453.39, "timestamp": "01:14:13", "text": "今"}, {"type": "subtitle", "time": 4458.229, "timestamp": "01:14:18", "text": "でも私は欲しい、私の問題は"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "もちろん誰かに依頼することもできた"}, {"type": "subtitle", "time": 4461.99, "timestamp": "01:14:21", "text": "ウェブサイトは完全に委託されています"}, {"type": "subtitle", "time": 4465.43, "timestamp": "01:14:25", "text": "誰かだけど、私は自分の力が欲しいので、私の"}, {"type": "subtitle", "time": 4467.669, "timestamp": "01:14:27", "text": "ウェブサイトは今変更を加えたいと思っていて"}, {"type": "subtitle", "time": 4470.59, "timestamp": "01:14:30", "text": "しばらくして気に入らなければすべて"}, {"type": "subtitle", "time": 4473.35, "timestamp": "01:14:33", "text": "時間。私は邪魔をするのではなくそれを望んでいます"}, {"type": "subtitle", "time": 4477.27, "timestamp": "01:14:37", "text": "ええと、ウェブ開発者はいつもそうです。欲しい"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "私自身もそれを実行したいし、私だけがそれを求めている"}, {"type": "subtitle", "time": 4481.75, "timestamp": "01:14:41", "text": "ペプデフの"}, {"type": "subtitle", "time": 4486.43, "timestamp": "01:14:46", "text": "えーと、ウェブ開発のえーと、ヘルプみたいなもの"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "もしそれが必要なら、もしそれが必要なら"}, {"type": "subtitle", "time": 4499.43, "timestamp": "01:14:59", "text": "Kronosではできないのか？ U を作ることはできますが"}]
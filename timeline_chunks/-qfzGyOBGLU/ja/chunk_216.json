[{"type": "subtitle", "time": 12967.309, "timestamp": "03:36:07", "text": "ベイン。彼らは彼を殺した"}, {"type": "subtitle", "time": 12982.389, "timestamp": "03:36:22", "text": "私は待つ。リロードボタンは何だったっけ？ R.オー"}, {"type": "subtitle", "time": 12984.429, "timestamp": "03:36:24", "text": "神。それは"}, {"type": "subtitle", "time": 12986.75, "timestamp": "03:36:26", "text": "なぜ。"}, {"type": "subtitle", "time": 12989.91, "timestamp": "03:36:29", "text": "そして私はF1キーを押していました。おお"}, {"type": "subtitle", "time": 12992.51, "timestamp": "03:36:32", "text": "我が神よ。大丈夫です。その"}, {"type": "subtitle", "time": 12995.07, "timestamp": "03:36:35", "text": "大丈夫。これは"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "男の子たちが旅立つ。それで、あれは何だったの？"}, {"type": "subtitle", "time": 13011.11, "timestamp": "03:36:51", "text": "また？誰かの声が聞こえる。雨が降っている。その"}, {"type": "subtitle", "time": 13013.95, "timestamp": "03:36:53", "text": "それは鹿です。殺してもいいですか"}, {"type": "subtitle", "time": 13019.07, "timestamp": "03:36:59", "text": "それ"}]
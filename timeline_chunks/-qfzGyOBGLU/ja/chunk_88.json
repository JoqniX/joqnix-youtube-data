[{"type": "subtitle", "time": 5285.11, "timestamp": "01:28:05", "text": "何が起こったのか、そしてもし私がそれを提出しなかったら"}, {"type": "subtitle", "time": 5289.669, "timestamp": "01:28:09", "text": "そう、私のプロジェクトはそうは思わない"}, {"type": "subtitle", "time": 5291.83, "timestamp": "01:28:11", "text": "私はどこへでも行く。私はただ無駄にしている"}, {"type": "subtitle", "time": 5294.31, "timestamp": "01:28:14", "text": "お金、ほら、授業に出席して"}, {"type": "subtitle", "time": 5296.629, "timestamp": "01:28:16", "text": "私の疑問を解消することさえせず、"}, {"type": "subtitle", "time": 5300.43, "timestamp": "01:28:20", "text": "もの。音楽コースの共同は"}, {"type": "subtitle", "time": 5304.51, "timestamp": "01:28:24", "text": "65,000。それは大きな"}, {"type": "subtitle", "time": 5308.229, "timestamp": "01:28:28", "text": "額。自分の給料から支払っています。"}, {"type": "subtitle", "time": 5309.55, "timestamp": "01:28:29", "text": "私"}, {"type": "subtitle", "time": 5312.95, "timestamp": "01:28:32", "text": "実際には少ないが、それでも"}, {"type": "subtitle", "time": 5317.11, "timestamp": "01:28:37", "text": "どうにかして支払おう。私はお父さんに頼みました、"}, {"type": "subtitle", "time": 5319.11, "timestamp": "01:28:39", "text": "4ヶ月分割払いにして"}]
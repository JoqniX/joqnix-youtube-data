[{"type": "subtitle", "time": 14165.11, "timestamp": "03:56:05", "text": "B. 何もありません。石はどこにありますか？"}, {"type": "subtitle", "time": 14167.95, "timestamp": "03:56:07", "text": "なぜ石はそんなに難しいのか"}, {"type": "subtitle", "time": 14170.469, "timestamp": "03:56:10", "text": "探す？これらを手に取りたくありませんか？"}, {"type": "subtitle", "time": 14172.95, "timestamp": "03:56:12", "text": "石、あるいはもしそうだったら"}, {"type": "subtitle", "time": 14175.269, "timestamp": "03:56:15", "text": "マインクラフトか何か、"}, {"type": "subtitle", "time": 14178.55, "timestamp": "03:56:18", "text": "ほら、これらの建造物を攻撃して"}, {"type": "subtitle", "time": 14180.75, "timestamp": "03:56:20", "text": "物を手に入れる。"}, {"type": "subtitle", "time": 14183.63, "timestamp": "03:56:23", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 14195.189, "timestamp": "03:56:35", "text": "何？いつ空いていますか？いつ空いていますか？それ"}, {"type": "subtitle", "time": 14198.15, "timestamp": "03:56:38", "text": "正直に言うと、場合によりますね。ああ、私は戻ってきました"}]
[{"type": "subtitle", "time": 7021.709, "timestamp": "01:57:01", "text": "でも、痛みは"}, {"type": "subtitle", "time": 7025.35, "timestamp": "01:57:05", "text": "男。でも私は実際にそうするだろう"}, {"type": "subtitle", "time": 7037.27, "timestamp": "01:57:17", "text": "感覚。ジョックは草の上で寝たい"}, {"type": "subtitle", "time": 7040.589, "timestamp": "01:57:20", "text": "牧草地には、実際に"}, {"type": "subtitle", "time": 7043.189, "timestamp": "01:57:23", "text": "草が生えている。いや、実は私は"}, {"type": "subtitle", "time": 7046.55, "timestamp": "01:57:26", "text": "GMA。 GMAは丘陵地帯です。まるで"}, {"type": "subtitle", "time": 7053.83, "timestamp": "01:57:33", "text": "右？つまり、ここは市街地ではないということです。それで、"}, {"type": "subtitle", "time": 7055.91, "timestamp": "01:57:35", "text": "温泉があって、"}, {"type": "subtitle", "time": 7060.07, "timestamp": "01:57:40", "text": "自然は、当時も今も、あらゆる場所に存在している。だから私は"}, {"type": "subtitle", "time": 7063.109, "timestamp": "01:57:43", "text": "外出もできるんだよ。それは"}, {"type": "subtitle", "time": 7071.83, "timestamp": "01:57:51", "text": "うん、いいよ。ちょっと待って、確認させて。させて"}, {"type": "subtitle", "time": 7075.51, "timestamp": "01:57:55", "text": "私にグーグルでアカデミーをグーグルで調べさせてください"}]
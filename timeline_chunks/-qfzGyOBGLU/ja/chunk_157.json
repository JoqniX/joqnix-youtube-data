[{"type": "subtitle", "time": 9421.59, "timestamp": "02:37:01", "text": "ストリーム。よし、以上だ。"}, {"type": "subtitle", "time": 9424.27, "timestamp": "02:37:04", "text": "スケジュールの一部。そして覚えておいてください、"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "えーと、11月30日には、"}, {"type": "subtitle", "time": 9431.55, "timestamp": "02:37:11", "text": "誕生日のお祝いのメッセージ"}, {"type": "subtitle", "time": 9434.95, "timestamp": "02:37:14", "text": "不和。えっと、ちょっと待ってください。隠す必要がある"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "プライベートサーバーにいたため、私の画面が表示されました。"}, {"type": "subtitle", "time": 9442.71, "timestamp": "02:37:22", "text": "以前、コピー＆ペーストする必要があったので"}, {"type": "subtitle", "time": 9445.07, "timestamp": "02:37:25", "text": "バックアップ"}, {"type": "subtitle", "time": 9449.349, "timestamp": "02:37:29", "text": "コード。気にしないでください。ええ、そうですね。えっと、そこ"}, {"type": "subtitle", "time": 9450.99, "timestamp": "02:37:30", "text": "あなたが行く。おお、"}, {"type": "subtitle", "time": 9453.15, "timestamp": "02:37:33", "text": "待って。"}, {"type": "subtitle", "time": 9456.91, "timestamp": "02:37:36", "text": "はい、どうぞ。ちょっと待って。お見せしましょう"}, {"type": "subtitle", "time": 9461.91, "timestamp": "02:37:41", "text": "これ。こんにちは。それで、30日には"}, {"type": "subtitle", "time": 9463.91, "timestamp": "02:37:43", "text": "アン、Discordで発表します"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "同じように。それで、このチャンネルの誕生日"}, {"type": "subtitle", "time": 9468.63, "timestamp": "02:37:48", "text": "願いは誰にでも叶えられる"}, {"type": "subtitle", "time": 9471.27, "timestamp": "02:37:51", "text": "誕生日のお祝いメッセージを投稿できる場所"}, {"type": "subtitle", "time": 9473.91, "timestamp": "02:37:53", "text": "両方とも理解しています、私たちがしたように"}, {"type": "subtitle", "time": 9478.15, "timestamp": "02:37:58", "text": "私を含めた過去2、3回の航海"}]
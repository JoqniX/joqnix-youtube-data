[{"type": "subtitle", "time": 7383.35, "timestamp": "02:03:03", "text": "日本で1年9ヶ月過ごしたら、もし私が"}, {"type": "subtitle", "time": 7387.189, "timestamp": "02:03:07", "text": "1年以内にN2などの資格を取得すれば合格です"}, {"type": "subtitle", "time": 7391.75, "timestamp": "02:03:11", "text": "ビザを9ヶ月間変換する必要があります"}, {"type": "subtitle", "time": 7395.83, "timestamp": "02:03:15", "text": "えーと、ビザを学生に渡したんですよね、もし"}, {"type": "subtitle", "time": 7398.79, "timestamp": "02:03:18", "text": "もし私が"}, {"type": "subtitle", "time": 7401.51, "timestamp": "02:03:21", "text": "ちゃんとした仕事ですよね。だから私は考えているのですが"}, {"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "大学に行くので、"}, {"type": "subtitle", "time": 7405.75, "timestamp": "02:03:25", "text": "大学の学位またはそれ以上の学位"}, {"type": "subtitle", "time": 7408.55, "timestamp": "02:03:28", "text": "そこには。そのためには、良いものを手に入れなければならない"}, {"type": "subtitle", "time": 7411.99, "timestamp": "02:03:31", "text": "大学に進学して、出願したり、その他諸々。私の"}, {"type": "subtitle", "time": 7415.43, "timestamp": "02:03:35", "text": "最高です、そしていくつか参加できるといいな"}, {"type": "subtitle", "time": 7416.43, "timestamp": "02:03:36", "text": "の"}, {"type": "subtitle", "time": 7419.43, "timestamp": "02:03:39", "text": "大学。じゃあ、私は一人でやっていくしかないんですよね？"}, {"type": "subtitle", "time": 7421.669, "timestamp": "02:03:41", "text": "住む場所とか、いろいろ探さなきゃいけないんだ。"}, {"type": "subtitle", "time": 7423.589, "timestamp": "02:03:43", "text": "それからビザとその他すべてが"}, {"type": "subtitle", "time": 7425.149, "timestamp": "02:03:45", "text": "終わったら、"}, {"type": "subtitle", "time": 7427.91, "timestamp": "02:03:47", "text": "良い。私はそこに滞在できます。でも私は"}, {"type": "subtitle", "time": 7429.51, "timestamp": "02:03:49", "text": "インドに戻って執筆する"}, {"type": "subtitle", "time": 7431.51, "timestamp": "02:03:51", "text": "無視する。"}, {"type": "subtitle", "time": 7433.669, "timestamp": "02:03:53", "text": "そして最近、"}, {"type": "subtitle", "time": 7435.79, "timestamp": "02:03:55", "text": "国際支店"}, {"type": "subtitle", "time": 7438.95, "timestamp": "02:03:58", "text": "外国人留学生向け。だから私は考えている"}]
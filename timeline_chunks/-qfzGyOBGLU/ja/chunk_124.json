[{"type": "subtitle", "time": 7442.0, "timestamp": "02:04:02", "text": "彼らに電話して、"}, {"type": "subtitle", "time": 7443.229, "timestamp": "02:04:03", "text": "[音楽]"}, {"type": "subtitle", "time": 7449.91, "timestamp": "02:04:09", "text": "えーと、でも、ええと、なんて呼ぶんですか？"}, {"type": "subtitle", "time": 7452.47, "timestamp": "02:04:12", "text": "えっと、日本に関しては、私は、"}, {"type": "subtitle", "time": 7457.03, "timestamp": "02:04:17", "text": "方法はあるけど、ええ、そう思う"}, {"type": "subtitle", "time": 7458.629, "timestamp": "02:04:18", "text": "国際支店または"}, {"type": "subtitle", "time": 7460.39, "timestamp": "02:04:20", "text": "オンラインで試験を受けられるように何か"}, {"type": "subtitle", "time": 7463.43, "timestamp": "02:04:23", "text": "インドに戻るのではなく、"}, {"type": "subtitle", "time": 7466.91, "timestamp": "02:04:26", "text": "今の航空券は40,000円と高額です。"}, {"type": "subtitle", "time": 7469.709, "timestamp": "02:04:29", "text": "Dの航空券は"}, {"type": "subtitle", "time": 7472.35, "timestamp": "02:04:32", "text": "40,000往復のように"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "なあ、俺には奨学金がないんだよ。"}, {"type": "subtitle", "time": 7478.55, "timestamp": "02:04:38", "text": "先生は奨学金を受けているんですよ"}, {"type": "subtitle", "time": 7480.99, "timestamp": "02:04:40", "text": "来ることができます"}, {"type": "subtitle", "time": 7484.629, "timestamp": "02:04:44", "text": "簡単に。費用は一切かかりません。ええ、彼らは"}, {"type": "subtitle", "time": 7487.79, "timestamp": "02:04:47", "text": "奨学金は諸経費をカバーします。"}, {"type": "subtitle", "time": 7492.149, "timestamp": "02:04:52", "text": "はい。一生懸命勉強しないといけないんだ。私の先生"}, {"type": "subtitle", "time": 7495.43, "timestamp": "02:04:55", "text": "えっと、私の先生は日本語を学んだ"}, {"type": "subtitle", "time": 7498.709, "timestamp": "02:04:58", "text": "自宅からインドのようにN1まで"}]
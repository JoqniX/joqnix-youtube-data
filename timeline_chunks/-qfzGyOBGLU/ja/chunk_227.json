[{"type": "subtitle", "time": 13621.309, "timestamp": "03:47:01", "text": "準備する。私たちは準備します"}, {"type": "subtitle", "time": 13624.15, "timestamp": "03:47:04", "text": "もの。私たちは銃を手に入れ、"}, {"type": "subtitle", "time": 13626.91, "timestamp": "03:47:06", "text": "もの。ええ、私は死にました。"}, {"type": "subtitle", "time": 13630.349, "timestamp": "03:47:10", "text": "うまくいけば。ああ、それは遠い道のりですが、"}, {"type": "subtitle", "time": 13638.91, "timestamp": "03:47:18", "text": "そこには。バカの意味。あ、待って。何が"}, {"type": "subtitle", "time": 13655.99, "timestamp": "03:47:35", "text": "ボトル。あの音は何だ？ああ、それは"}, {"type": "subtitle", "time": 13664.67, "timestamp": "03:47:44", "text": "えっと、私の質問は"}]
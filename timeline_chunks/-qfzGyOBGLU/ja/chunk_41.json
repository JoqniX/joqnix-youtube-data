[{"type": "subtitle", "time": 2464.67, "timestamp": "00:41:04", "text": "うん。しかしそれは"}, {"type": "subtitle", "time": 2477.03, "timestamp": "00:41:17", "text": "自分が叫びすぎていることに気づいた。"}, {"type": "subtitle", "time": 2478.03, "timestamp": "00:41:18", "text": "私は"}, {"type": "subtitle", "time": 2481.47, "timestamp": "00:41:21", "text": "文字通り叫んでない、文字通り"}, {"type": "subtitle", "time": 2488.47, "timestamp": "00:41:28", "text": "わからない。それは新しいことですか、それとも"}, {"type": "subtitle", "time": 2502.43, "timestamp": "00:41:42", "text": "知る。良い質問ですね。"}, {"type": "subtitle", "time": 2510.79, "timestamp": "00:41:50", "text": "知る。 1秒。マイクを差し込みます"}]
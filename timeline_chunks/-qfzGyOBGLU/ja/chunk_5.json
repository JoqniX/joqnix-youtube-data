[{"type": "subtitle", "time": 318.59, "timestamp": "00:05:18", "text": "悲しいことに、地図をなくしてしまった"}, {"type": "subtitle", "time": 321.43, "timestamp": "00:05:21", "text": "けれど。私が手に入れた地図の数"}, {"type": "subtitle", "time": 324.749, "timestamp": "00:05:24", "text": "酒場。私はそれらを失くしました"}, {"type": "subtitle", "time": 328.029, "timestamp": "00:05:28", "text": "全て。私はハビビと取引したかった"}, {"type": "subtitle", "time": 330.83, "timestamp": "00:05:30", "text": "ジャシマと"}]
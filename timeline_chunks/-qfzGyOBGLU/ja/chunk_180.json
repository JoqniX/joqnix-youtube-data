[{"type": "subtitle", "time": 10808.19, "timestamp": "03:00:08", "text": "する？得る"}, {"type": "subtitle", "time": 10810.87, "timestamp": "03:00:10", "text": "もの。こんにちは。歌を歌ってください。私は孤独です。私"}, {"type": "subtitle", "time": 10814.51, "timestamp": "03:00:14", "text": "お金がない。私は一人です。おお、"}, {"type": "subtitle", "time": 10829.95, "timestamp": "03:00:29", "text": "他のゲームをすることもできます。"}, {"type": "subtitle", "time": 10847.23, "timestamp": "03:00:47", "text": "それ。はい、どうぞ。 330点獲得しました"}]
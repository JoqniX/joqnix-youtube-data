[{"type": "subtitle", "time": 7692.31, "timestamp": "02:08:12", "text": "彼女は彼のハラムを管理しているのか？いいえ、私は10歳でした。"}, {"type": "subtitle", "time": 7699.669, "timestamp": "02:08:19", "text": "ダミー。いや、待って。 10歳の時、私は"}, {"type": "subtitle", "time": 7702.31, "timestamp": "02:08:22", "text": "フォートナイト。私は自分の弧の中にいました"}, {"type": "subtitle", "time": 7704.99, "timestamp": "02:08:24", "text": "eスポーツになる"}, {"type": "subtitle", "time": 7708.55, "timestamp": "02:08:28", "text": "プロとしてゲームをプレイする選手と"}, {"type": "subtitle", "time": 7712.31, "timestamp": "02:08:32", "text": "お金と戦うもの"}, {"type": "subtitle", "time": 7714.709, "timestamp": "02:08:34", "text": "小さな子供たちとDiscordをするような感じ。"}, {"type": "subtitle", "time": 7717.51, "timestamp": "02:08:37", "text": "10ドルくらいの賭けをするんだ。賭け"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "1対1とかそういうやつ。何てことだ。待っている"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "Robloxのようなもの。 Discord 用の Roblox ではありません"}, {"type": "subtitle", "time": 7727.109, "timestamp": "02:08:47", "text": "ニトロとか、私が覚えていると思うもの"}, {"type": "subtitle", "time": 7730.31, "timestamp": "02:08:50", "text": "私の人生におけるその軌跡。ええ、昔は"}, {"type": "subtitle", "time": 7732.629, "timestamp": "02:08:52", "text": "子供を殴る。殴られた子供ではない。いいえ、"}, {"type": "subtitle", "time": 7735.27, "timestamp": "02:08:55", "text": "変な意味に受け取らないでください。昔ながらの方法。私"}]
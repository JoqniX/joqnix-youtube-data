[{"type": "subtitle", "time": 10886.07, "timestamp": "03:01:26", "text": "なぜ思ったようにヒットしないのか"}, {"type": "subtitle", "time": 10901.67, "timestamp": "03:01:41", "text": "打つ？なんてこった、それはとても時間がかかった"}, {"type": "subtitle", "time": 10906.15, "timestamp": "03:01:46", "text": "クリア。つまり、私は木材を380個持っています。おお。では、なぜ"}, {"type": "subtitle", "time": 10908.91, "timestamp": "03:01:48", "text": "工作が必要ですか？"}, {"type": "subtitle", "time": 10911.83, "timestamp": "03:01:51", "text": "女性？それは問題ですね。これは木です"}, {"type": "subtitle", "time": 10913.15, "timestamp": "03:01:53", "text": "ストレージ"}, {"type": "subtitle", "time": 10917.67, "timestamp": "03:01:57", "text": "箱。いくら？これには木材が100個必要です。"}]
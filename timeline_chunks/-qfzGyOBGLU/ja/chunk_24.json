[{"type": "subtitle", "time": 1440.95, "timestamp": "00:24:00", "text": "さっき、誰かがそれをやっているのを見た。うわぁ、って感じ。"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "いいね。よし、私はやりたいことをやる"}, {"type": "subtitle", "time": 1457.47, "timestamp": "00:24:17", "text": "の"}, {"type": "subtitle", "time": 1460.99, "timestamp": "00:24:20", "text": "ツイート16日目"}, {"type": "subtitle", "time": 1486.47, "timestamp": "00:24:46", "text": "チャ。昇進が必要だ。ズキが言ったように、私は"}, {"type": "subtitle", "time": 1488.909, "timestamp": "00:24:48", "text": "ジョアソンを真に宣伝する必要がある"}, {"type": "subtitle", "time": 1492.549, "timestamp": "00:24:52", "text": "イベント。私が行く道では、それは"}, {"type": "subtitle", "time": 1495.029, "timestamp": "00:24:55", "text": "良い結果にはならないだろう。今はたった3つ、たった4つ"}, {"type": "subtitle", "time": 1499.269, "timestamp": "00:24:59", "text": "今日を含めた残り日数 1 2 3 4 4"}]
[{"type": "subtitle", "time": 14105.91, "timestamp": "03:55:05", "text": "それ。次はランダムです。これは何ですか？"}, {"type": "subtitle", "time": 14108.03, "timestamp": "03:55:08", "text": "睡眠"}, {"type": "subtitle", "time": 14115.83, "timestamp": "03:55:15", "text": "乗り物。 Twitchのライバル。 Twitchです。"}, {"type": "subtitle", "time": 14119.07, "timestamp": "03:55:19", "text": "Twitchの配信者がいます"}, {"type": "subtitle", "time": 14123.229, "timestamp": "03:55:23", "text": "ここ。わかった。ええ、いくつか見ました"}, {"type": "subtitle", "time": 14126.11, "timestamp": "03:55:26", "text": "硫黄"}, {"type": "subtitle", "time": 14129.91, "timestamp": "03:55:29", "text": "まあ、そんな感じ。これらを壊して物を手に入れることはできない。"}, {"type": "subtitle", "time": 14131.55, "timestamp": "03:55:31", "text": "わかった。"}, {"type": "subtitle", "time": 14134.15, "timestamp": "03:55:34", "text": "残念ながら、できません。これらは何ですか？私は思う"}, {"type": "subtitle", "time": 14136.75, "timestamp": "03:55:36", "text": "それは木と何か"}, {"type": "subtitle", "time": 14156.269, "timestamp": "03:55:56", "text": "行くの？えっと、私の荷物が"}]
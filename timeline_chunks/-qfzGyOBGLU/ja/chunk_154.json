[{"type": "subtitle", "time": 9242.15, "timestamp": "02:34:02", "text": "待って、ラスティ・ミュージックが流れてる。わかった。こんにちは。"}, {"type": "subtitle", "time": 9244.95, "timestamp": "02:34:04", "text": "そういうこと全部。それで、火曜日は、"}, {"type": "subtitle", "time": 9247.07, "timestamp": "02:34:07", "text": "ストリーミング配信中。私はストリーミング配信しません"}, {"type": "subtitle", "time": 9250.23, "timestamp": "02:34:10", "text": "火曜日。えっと、ちょっと"}, {"type": "subtitle", "time": 9252.87, "timestamp": "02:34:12", "text": "何かをしている。私は家にいません"}, {"type": "subtitle", "time": 9256.07, "timestamp": "02:34:16", "text": "あまりにも。そうですね、でも木曜日には"}, {"type": "subtitle", "time": 9258.309, "timestamp": "02:34:18", "text": "Torumをストリーミング配信中。私はずっと"}, {"type": "subtitle", "time": 9261.19, "timestamp": "02:34:21", "text": "このゲームを頻繁に配信する。スタースケープ・ガールズ"}, {"type": "subtitle", "time": 9263.67, "timestamp": "02:34:23", "text": "最近、たくさん配信している。モイェドゥと"}, {"type": "subtitle", "time": 9267.349, "timestamp": "02:34:27", "text": "ルミは最近トルムムをよくプレイしている。"}, {"type": "subtitle", "time": 9269.79, "timestamp": "02:34:29", "text": "彼らがトーラムを演奏するのを見る。実際は"}, {"type": "subtitle", "time": 9273.75, "timestamp": "02:34:33", "text": "モエドゥとカイイシが実際に私を"}, {"type": "subtitle", "time": 9277.99, "timestamp": "02:34:37", "text": "トルムへ。そう、私はまだMo'sにいる。"}, {"type": "subtitle", "time": 9281.349, "timestamp": "02:34:41", "text": "氏族だろうがギルドだろうが、何であれ。そうですね、"}, {"type": "subtitle", "time": 9285.03, "timestamp": "02:34:45", "text": "木曜日にトルムムと対戦します。えっと、"}, {"type": "subtitle", "time": 9287.99, "timestamp": "02:34:47", "text": "噂をすれば影が差す、それがモーだ。うん。"}, {"type": "subtitle", "time": 9291.27, "timestamp": "02:34:51", "text": "こんにちは。お元気でお過ごしでしょうか。またね"}, {"type": "subtitle", "time": 9297.91, "timestamp": "02:34:57", "text": "com。そう、そして金曜日には"}]
[{"type": "subtitle", "time": 2074.03, "timestamp": "00:34:34", "text": "もの？それなら、会員制サービスを本格的に開始する時だ。"}, {"type": "subtitle", "time": 2083.669, "timestamp": "00:34:43", "text": "いいえ、膨らませるべきではありません"}, {"type": "subtitle", "time": 2084.909, "timestamp": "00:34:44", "text": "価格。"}, {"type": "subtitle", "time": 2087.349, "timestamp": "00:34:47", "text": "バカ、値段を吊り上げるなよ。それはもっと"}, {"type": "subtitle", "time": 2090.43, "timestamp": "00:34:50", "text": "まるで私がそれを作るべきではないかのように"}, {"type": "subtitle", "time": 2093.19, "timestamp": "00:34:53", "text": "高い。それは人々のように映るだろう"}]
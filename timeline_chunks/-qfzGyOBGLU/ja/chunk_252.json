[{"type": "subtitle", "time": 15123.55, "timestamp": "04:12:03", "text": "見逃した。ということで、私もこれを見逃したのですが"}, {"type": "subtitle", "time": 15143.269, "timestamp": "04:12:23", "text": "ああ、こんにちは。そこに誰かいますか？待って、"}, {"type": "subtitle", "time": 15146.349, "timestamp": "04:12:26", "text": "アッシュは私たちに降ろさせた。待って、いや"}, {"type": "subtitle", "time": 15156.15, "timestamp": "04:12:36", "text": "何？何？これを見逃していた。おお。私は愛する"}, {"type": "subtitle", "time": 15160.189, "timestamp": "04:12:40", "text": "アッシュを見ている。私は彼らの大ファンです"}, {"type": "subtitle", "time": 15164.389, "timestamp": "04:12:44", "text": "ストリーム。彼女は最近GTA 5をプレイしている"}, {"type": "subtitle", "time": 15171.51, "timestamp": "04:12:51", "text": "もの。どこに行って家を建てればいいの？"}, {"type": "subtitle", "time": 15173.91, "timestamp": "04:12:53", "text": "もの？待って、近くに家を建てるべきだ"}, {"type": "subtitle", "time": 15176.11, "timestamp": "04:12:56", "text": "お店へ、または"}, {"type": "subtitle", "time": 15179.389, "timestamp": "04:12:59", "text": "何か。ああ、いくつか手に入れたよ"}]
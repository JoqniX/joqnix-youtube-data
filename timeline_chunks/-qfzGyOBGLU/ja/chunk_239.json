[{"type": "subtitle", "time": 14349.309, "timestamp": "03:59:09", "text": "いいえ、そうする必要はありません"}, {"type": "subtitle", "time": 14359.269, "timestamp": "03:59:19", "text": "それ。持っていない場合は、"}, {"type": "subtitle", "time": 14364.269, "timestamp": "03:59:24", "text": "すぐに死んでしまうだろう。ああ、私は"}, {"type": "subtitle", "time": 14371.55, "timestamp": "03:59:31", "text": "ついに。ああ、どうしても手に入れたかったんです。"}, {"type": "subtitle", "time": 14381.75, "timestamp": "03:59:41", "text": "もっと。さらに50個入手しました。そして、アディティアも、"}, {"type": "subtitle", "time": 14385.91, "timestamp": "03:59:45", "text": "えっと、明日は配信しません。それで、"}, {"type": "subtitle", "time": 14389.389, "timestamp": "03:59:49", "text": "えーと、ダウンロード済みの事前準備を続けるか、"}]
[{"type": "subtitle", "time": 9541.23, "timestamp": "02:39:01", "text": "する？こんにちは。戻ってきました。さあ行こう。"}, {"type": "subtitle", "time": 9545.55, "timestamp": "02:39:05", "text": "さび。それで、昨日これをインストールしました"}, {"type": "subtitle", "time": 9549.19, "timestamp": "02:39:09", "text": "ゲーム。そして私がなぜそれを買ったのかをお話ししましょう"}, {"type": "subtitle", "time": 9552.389, "timestamp": "02:39:12", "text": "このゲーム。私は、あなたたちが"}, {"type": "subtitle", "time": 9556.309, "timestamp": "02:39:16", "text": "私のツイートを見ました。私のこれはどこにあるの？それで、"}, {"type": "subtitle", "time": 9560.55, "timestamp": "02:39:20", "text": "えっと、最近ツイートしたんだけど。もし私が"}, {"type": "subtitle", "time": 9565.469, "timestamp": "02:39:25", "text": "見つけることができる。もし私がそれを見つけることができれば"}, {"type": "subtitle", "time": 9567.55, "timestamp": "02:39:27", "text": "ツイート。どこに"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "あなた？ああ、これだ。このツイート。私はただ"}, {"type": "subtitle", "time": 9574.07, "timestamp": "02:39:34", "text": "たくさん貯金してRustを買った。そして"}, {"type": "subtitle", "time": 9576.79, "timestamp": "02:39:36", "text": "これまで集めたラストドロップは全て"}, {"type": "subtitle", "time": 9578.63, "timestamp": "02:39:38", "text": "昨年Twitchから撤退。それら全て私は"}, {"type": "subtitle", "time": 9583.429, "timestamp": "02:39:43", "text": "期限切れ。はい、一滴残らず"}, {"type": "subtitle", "time": 9585.15, "timestamp": "02:39:45", "text": "すり潰した"}, {"type": "subtitle", "time": 9588.11, "timestamp": "02:39:48", "text": "トゥイッチ。全員"}, {"type": "subtitle", "time": 9592.95, "timestamp": "02:39:52", "text": "去った。シュラウドガンはなくなりました。 SQC えーとアイテム"}, {"type": "subtitle", "time": 9597.23, "timestamp": "02:39:57", "text": "消えてしまった。ポケモンのガレージドアは"}]
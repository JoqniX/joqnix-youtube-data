[{"type": "subtitle", "time": 3060.47, "timestamp": "00:51:00", "text": "コンステレーションはアクセサリーをプレゼントした。いいえ、"}, {"type": "subtitle", "time": 3062.069, "timestamp": "00:51:02", "text": "問題は、そこに違いがあるということです。病気"}, {"type": "subtitle", "time": 3062.67, "timestamp": "00:51:02", "text": "教えて"}, {"type": "subtitle", "time": 3065.349, "timestamp": "00:51:05", "text": "あなた。教えてあげましょう。あなたに教えてあげましょう"}, {"type": "subtitle", "time": 3068.71, "timestamp": "00:51:08", "text": "今あなたが見つめているジョークは"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "もっとかっこよくなりたかったし、"}, {"type": "subtitle", "time": 3073.39, "timestamp": "00:51:13", "text": "より非行的になり、"}, {"type": "subtitle", "time": 3076.03, "timestamp": "00:51:16", "text": "生意気なガキ。社会的に溶け込みたかった"}, {"type": "subtitle", "time": 3078.589, "timestamp": "00:51:18", "text": "円。だから彼は"}, {"type": "subtitle", "time": 3082.91, "timestamp": "00:51:22", "text": "ピアスとか全部含めて、だよね？"}, {"type": "subtitle", "time": 3087.51, "timestamp": "00:51:27", "text": "ピアス。新しい方は純粋すぎる。"}, {"type": "subtitle", "time": 3090.829, "timestamp": "00:51:30", "text": "それはそれが描写している"}, {"type": "subtitle", "time": 3094.43, "timestamp": "00:51:34", "text": "それは描写する描写する"}, {"type": "subtitle", "time": 3098.309, "timestamp": "00:51:38", "text": "始まりのアークはそうではなく、"}, {"type": "subtitle", "time": 3100.71, "timestamp": "00:51:40", "text": "正式なモデルが完成しました。だから私は"}, {"type": "subtitle", "time": 3105.15, "timestamp": "00:51:45", "text": "成熟の部分はゆっくりと進めて、"}, {"type": "subtitle", "time": 3108.549, "timestamp": "00:51:48", "text": "時間が経つにつれて新しいモデルは"}, {"type": "subtitle", "time": 3110.71, "timestamp": "00:51:50", "text": "衣装か何かアップグレードできるもの"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "新しい公式モデルの将来。"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "それから、えっと、私はその"}]
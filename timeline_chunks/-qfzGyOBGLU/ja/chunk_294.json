[{"type": "subtitle", "time": 17640.43, "timestamp": "04:54:00", "text": "全て"}, {"type": "subtitle", "time": 17643.11, "timestamp": "04:54:03", "text": "右。パドルは正常に動作していますか？おお、"}, {"type": "subtitle", "time": 17645.43, "timestamp": "04:54:05", "text": "うん。えっと、私のパドル。あ、待って。忘れた。"}, {"type": "subtitle", "time": 17646.83, "timestamp": "04:54:06", "text": "忘れた。私"}, {"type": "subtitle", "time": 17649.75, "timestamp": "04:54:09", "text": "忘れた。あなたは何者ですか？えっと、忘れてた"}, {"type": "subtitle", "time": 17653.788, "timestamp": "04:54:13", "text": "これをRust用にセットアップしました。新しいものを作りましょう"}, {"type": "subtitle", "time": 17656.47, "timestamp": "04:54:16", "text": "プロフィール。 Rustはどこにありますか？ああ神様、私は"}, {"type": "subtitle", "time": 17662.43, "timestamp": "04:54:22", "text": "Rust.exeコピー"}, {"type": "subtitle", "time": 17665.15, "timestamp": "04:54:25", "text": "それ。追加"}, {"type": "subtitle", "time": 17667.868, "timestamp": "04:54:27", "text": "上に貼り付ける"}, {"type": "subtitle", "time": 17671.708, "timestamp": "04:54:31", "text": "ここ。 Rustだけですか？ええ、ただ"}, {"type": "subtitle", "time": 17675.75, "timestamp": "04:54:35", "text": "さび。だから、アンディは簡単にズルできる"}, {"type": "subtitle", "time": 17678.67, "timestamp": "04:54:38", "text": "ブートストラップ。わかった。そしてそれが"}, {"type": "subtitle", "time": 17682.07, "timestamp": "04:54:42", "text": "1ファイル1、ですよね？名前を変える必要がある"}, {"type": "subtitle", "time": 17684.43, "timestamp": "04:54:44", "text": "これ。 1秒。"}, {"type": "subtitle", "time": 17688.23, "timestamp": "04:54:48", "text": "さび。こんにちは。えっと、待って。最上位層。私にさせて"}, {"type": "subtitle", "time": 17689.788, "timestamp": "04:54:49", "text": "これをコピーしてください"}, {"type": "subtitle", "time": 17693.47, "timestamp": "04:54:53", "text": "そしてあなたを"}, {"type": "subtitle", "time": 17697.31, "timestamp": "04:54:57", "text": "ここ。一番濃い色のTを貼り付けて押し付けます。"}]
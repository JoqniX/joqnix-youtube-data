[{"type": "subtitle", "time": 10740.11, "timestamp": "02:59:00", "text": "自分。"}, {"type": "subtitle", "time": 10743.75, "timestamp": "02:59:03", "text": "わあ、すごい。クリックするだけでいいんです。する"}, {"type": "subtitle", "time": 10745.79, "timestamp": "02:59:05", "text": "まだアークシステムワークスをプレイしてるの？そうそう。私"}, {"type": "subtitle", "time": 10749.429, "timestamp": "02:59:09", "text": "アンインストールしなければならなかったことを忘れていました。"}, {"type": "subtitle", "time": 10751.469, "timestamp": "02:59:11", "text": "本当に不足していた"}, {"type": "subtitle", "time": 10755.11, "timestamp": "02:59:15", "text": "Cドライブとゲームドライブの空き容量"}, {"type": "subtitle", "time": 10757.309, "timestamp": "02:59:17", "text": "などなど。だから、アンインストールしなければならなかった"}, {"type": "subtitle", "time": 10760.51, "timestamp": "02:59:20", "text": "鞍をつける。でも、私は1つプレイします"}, {"type": "subtitle", "time": 10764.11, "timestamp": "02:59:24", "text": "日。例えば、サーバーがある場合、"}, {"type": "subtitle", "time": 10768.269, "timestamp": "02:59:28", "text": "何か飛び込めるもの、"}, {"type": "subtitle", "time": 10770.63, "timestamp": "02:59:30", "text": "すべてになるもの"}, {"type": "subtitle", "time": 10773.269, "timestamp": "02:59:33", "text": "これも役立ちます。わからない。わからない"}, {"type": "subtitle", "time": 10775.67, "timestamp": "02:59:35", "text": "実際はそうだけど、そうするかどうかはわからない"}, {"type": "subtitle", "time": 10779.75, "timestamp": "02:59:39", "text": "すぐにはプレイできないけど"}, {"type": "subtitle", "time": 10783.389, "timestamp": "02:59:43", "text": "いつか私も行くよ"}, {"type": "subtitle", "time": 10786.349, "timestamp": "02:59:46", "text": "背後からの攻撃もだ。"}, {"type": "subtitle", "time": 10790.11, "timestamp": "02:59:50", "text": "ああ、こうやって建てるんだ。"}, {"type": "subtitle", "time": 10793.15, "timestamp": "02:59:53", "text": "おお。持つことができる"}, {"type": "subtitle", "time": 10795.83, "timestamp": "02:59:55", "text": "ハンマー。これで人を殴ってもいいですか？"}]
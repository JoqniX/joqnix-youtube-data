[{"type": "subtitle", "time": 10565.75, "timestamp": "02:56:05", "text": "これ？何も言っていない。低い"}, {"type": "subtitle", "time": 10572.95, "timestamp": "02:56:12", "text": "最悪だ。サーバーが起動しました。誰もいないかもしれない"}, {"type": "subtitle", "time": 10582.99, "timestamp": "02:56:22", "text": "何？誰かが近くにいるような気がする"}, {"type": "subtitle", "time": 10600.309, "timestamp": "02:56:40", "text": "きちんと。貨物全般。もちろん。あなたが"}, {"type": "subtitle", "time": 10605.15, "timestamp": "02:56:45", "text": "[音楽]"}, {"type": "subtitle", "time": 10609.71, "timestamp": "02:56:49", "text": "え、何？ああ、彼は誰かと話している"}, {"type": "subtitle", "time": 10612.55, "timestamp": "02:56:52", "text": "それ以外。誰かが本当に欲しかったと思った"}, {"type": "subtitle", "time": 10615.15, "timestamp": "02:56:55", "text": "私を助けるために。"}, {"type": "subtitle", "time": 10619.71, "timestamp": "02:56:59", "text": "A：では、このXマークは何ですか？だから、私は"}]
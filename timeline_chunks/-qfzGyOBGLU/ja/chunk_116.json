[{"type": "subtitle", "time": 6960.03, "timestamp": "01:56:00", "text": "ジョックニックとして"}, {"type": "subtitle", "time": 6964.31, "timestamp": "01:56:04", "text": "または、私はスポーツマン、または音楽関係の別名"}, {"type": "subtitle", "time": 6967.99, "timestamp": "01:56:07", "text": "私は持っている。ええ、もし両方とも"}, {"type": "subtitle", "time": 6970.55, "timestamp": "01:56:10", "text": "何とかしてお金を稼げば、そうするよ"}, {"type": "subtitle", "time": 6973.589, "timestamp": "01:56:13", "text": "それを使って、もし人々が実際に"}, {"type": "subtitle", "time": 6975.91, "timestamp": "01:56:15", "text": "私の歌を聴いて、そう、私は"}, {"type": "subtitle", "time": 6979.109, "timestamp": "01:56:19", "text": "まず音楽を作ってから、それをやります。"}, {"type": "subtitle", "time": 6981.189, "timestamp": "01:56:21", "text": "でも、そのお金は"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "それとVチューブのようなものは"}, {"type": "subtitle", "time": 6986.79, "timestamp": "01:56:26", "text": "Vtubingに行くのかな。そう、誰が"}, {"type": "subtitle", "time": 6989.83, "timestamp": "01:56:29", "text": "本当にXゲームをプレイしたいのですか？うん、そうしたい"}, {"type": "subtitle", "time": 6992.55, "timestamp": "01:56:32", "text": "実験。 VRチャットに参加したい、または"}, {"type": "subtitle", "time": 6995.27, "timestamp": "01:56:35", "text": "VRで寝たいな"}, {"type": "subtitle", "time": 6997.669, "timestamp": "01:56:37", "text": "ヘッドセットを装着するか、何か別のことをする。寝たい"}, {"type": "subtitle", "time": 7000.55, "timestamp": "01:56:40", "text": "草の生い茂る牧草地か何かで、"}, {"type": "subtitle", "time": 7003.83, "timestamp": "01:56:43", "text": "「うん、人生って最高だね」みたいな感じ。それから私は"}, {"type": "subtitle", "time": 7005.87, "timestamp": "01:56:45", "text": "目を覚ましてヘッドホンを外してください。私は"}, {"type": "subtitle", "time": 7008.99, "timestamp": "01:56:48", "text": "戻りたくない"}, {"type": "subtitle", "time": 7011.669, "timestamp": "01:56:51", "text": "現実。授業に行きたくない。"}, {"type": "subtitle", "time": 7014.91, "timestamp": "01:56:54", "text": "VRの中で眠りたい。私は"}, {"type": "subtitle", "time": 7019.109, "timestamp": "01:56:59", "text": "ベッドの中で穏やかに寄り添う。"}]
[{"type": "subtitle", "time": 11880.55, "timestamp": "03:18:00", "text": "ああ、でもお腹がペコペコなんだ。私は死ぬ"}, {"type": "subtitle", "time": 11907.309, "timestamp": "03:18:27", "text": "右。彼はこちらに来る"}, {"type": "subtitle", "time": 11910.469, "timestamp": "03:18:30", "text": "自分。 H. 撃たないで。撃たないで。私は"}, {"type": "subtitle", "time": 11919.15, "timestamp": "03:18:39", "text": "H."}]
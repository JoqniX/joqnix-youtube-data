[{"type": "subtitle", "time": 6301.43, "timestamp": "01:45:01", "text": "YouTubeのようにOBに自動的にストリーミングする"}, {"type": "subtitle", "time": 6304.07, "timestamp": "01:45:04", "text": "あるいは、そんな感じ。 OBSはオンのままにしておいてください"}, {"type": "subtitle", "time": 6306.229, "timestamp": "01:45:06", "text": "自動的にストリーミングを開始します"}, {"type": "subtitle", "time": 6308.39, "timestamp": "01:45:08", "text": "特定の時間。シーンを切り替えるすべて"}, {"type": "subtitle", "time": 6310.75, "timestamp": "01:45:10", "text": "マクロなどを追加する"}, {"type": "subtitle", "time": 6313.91, "timestamp": "01:45:13", "text": "それ。それも一つのやり方だ。あなたはできる"}, {"type": "subtitle", "time": 6315.99, "timestamp": "01:45:15", "text": "コメントや"}, {"type": "subtitle", "time": 6320.149, "timestamp": "01:45:20", "text": "もの。なかなかいい感じだね。うん、そうだよ"}, {"type": "subtitle", "time": 6322.709, "timestamp": "01:45:22", "text": "すでに始めています"}, {"type": "subtitle", "time": 6324.39, "timestamp": "01:45:24", "text": "本当の自分を見せるための提案を受ける"}, {"type": "subtitle", "time": 6327.109, "timestamp": "01:45:27", "text": "顔。したくないならやらなくていいよ"}, {"type": "subtitle", "time": 6329.35, "timestamp": "01:45:29", "text": "それを実行する。誰にもさせないで"}, {"type": "subtitle", "time": 6331.91, "timestamp": "01:45:31", "text": "あなたにしたくないことを強制する"}, {"type": "subtitle", "time": 6332.83, "timestamp": "01:45:32", "text": "する。"}, {"type": "subtitle", "time": 6335.99, "timestamp": "01:45:35", "text": "わかった。うん。そんなことは絶対にさせてはいけない"}, {"type": "subtitle", "time": 6339.35, "timestamp": "01:45:39", "text": "インド人コミュニティの人々は"}, {"type": "subtitle", "time": 6341.35, "timestamp": "01:45:41", "text": "YouTuberとかには慣れていない、"}, {"type": "subtitle", "time": 6343.83, "timestamp": "01:45:43", "text": "右？彼らは実際のユーチューバーに慣れている"}, {"type": "subtitle", "time": 6345.83, "timestamp": "01:45:45", "text": "そして顔を出す者すべてと"}, {"type": "subtitle", "time": 6348.07, "timestamp": "01:45:48", "text": "すべて、ですよね？だから、もしあなたが"}, {"type": "subtitle", "time": 6349.59, "timestamp": "01:45:49", "text": "顔を見せないなら、彼らはこう言うだろう"}, {"type": "subtitle", "time": 6352.87, "timestamp": "01:45:52", "text": "顔出し 顔出し 顔出し 顔出し"}, {"type": "subtitle", "time": 6355.27, "timestamp": "01:45:55", "text": "そうやって明らかになるんですよね？"}, {"type": "subtitle", "time": 6357.51, "timestamp": "01:45:57", "text": "でも、彼らに知らせなければならない"}, {"type": "subtitle", "time": 6359.27, "timestamp": "01:45:59", "text": "これが私の顔です。あなたはあなた自身です"}]
[{"type": "subtitle", "time": 18120.07, "timestamp": "05:02:00", "text": "何か。えっと、あれ。私は必要ない"}, {"type": "subtitle", "time": 18124.27, "timestamp": "05:02:04", "text": "それ。ライフルポッド。続けましょう"}, {"type": "subtitle", "time": 18128.27, "timestamp": "05:02:08", "text": "それ。えっと、何を捨てればいいですか？"}, {"type": "subtitle", "time": 18131.19, "timestamp": "05:02:11", "text": "ええと、私の中には木材を捨てたい部分もありますが、"}, {"type": "subtitle", "time": 18134.27, "timestamp": "05:02:14", "text": "しかし、それは重要なことだ。しかし、"}, {"type": "subtitle", "time": 18136.708, "timestamp": "05:02:16", "text": "ああ、あのね？捨てて"}, {"type": "subtitle", "time": 18139.35, "timestamp": "05:02:19", "text": "適切な。必要ないと思う。これ"}, {"type": "subtitle", "time": 18141.35, "timestamp": "05:02:21", "text": "しかし、それは重要です。だから私は"}, {"type": "subtitle", "time": 18144.07, "timestamp": "05:02:24", "text": "それを選んでいる。よし、"}, {"type": "subtitle", "time": 18145.59, "timestamp": "05:02:25", "text": "すべて。私たちは略奪したと思う"}, {"type": "subtitle", "time": 18148.708, "timestamp": "05:02:28", "text": "すべて。今すぐ行く必要がある"}, {"type": "subtitle", "time": 18164.708, "timestamp": "05:02:44", "text": "燃料。あ、待って。ディーゼルは必要ないのか？"}, {"type": "subtitle", "time": 18167.31, "timestamp": "05:02:47", "text": "あるいは何か別のこと？おっと。"}, {"type": "subtitle", "time": 18171.27, "timestamp": "05:02:51", "text": "えっと、この木材は捨てたいんだけど"}, {"type": "subtitle", "time": 18172.43, "timestamp": "05:02:52", "text": "もの。"}, {"type": "subtitle", "time": 18175.19, "timestamp": "05:02:55", "text": "あ、ちょっと待って。があるべきだ"}]
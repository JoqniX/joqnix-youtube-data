[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "試験を受けて合格した。それから彼は"}, {"type": "subtitle", "time": 7503.91, "timestamp": "02:05:03", "text": "彼はソロ奨学金を獲得しました。"}, {"type": "subtitle", "time": 7506.79, "timestamp": "02:05:06", "text": "すると彼は文字通り行くことができる"}, {"type": "subtitle", "time": 7509.589, "timestamp": "02:05:09", "text": "日本に無料で行ったと思う"}, {"type": "subtitle", "time": 7512.31, "timestamp": "02:05:12", "text": "わからない、それはとてもクールだ、わからない"}, {"type": "subtitle", "time": 7514.629, "timestamp": "02:05:14", "text": "全部はそうだけど、私が聞いたのはそういうことだった"}, {"type": "subtitle", "time": 7517.83, "timestamp": "02:05:17", "text": "他の人たちから聞いた話や、父に話したこと"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "あるいは何か、アカデミーの人たちへ、でも私は"}, {"type": "subtitle", "time": 7525.07, "timestamp": "02:05:25", "text": "ああ、でもそうだ"}, {"type": "subtitle", "time": 7527.43, "timestamp": "02:05:27", "text": "えっと、私は人々を助け始めました"}, {"type": "subtitle", "time": 7530.109, "timestamp": "02:05:30", "text": "いい国だ、いい国だ"}, {"type": "subtitle", "time": 7535.27, "timestamp": "02:05:35", "text": "私にとっては良いことです。私は実際に、ええと"}, {"type": "subtitle", "time": 7539.91, "timestamp": "02:05:39", "text": "ほら、そこに落ち着けよ、それに私の側も"}, {"type": "subtitle", "time": 7541.589, "timestamp": "02:05:41", "text": "もの。私はただそこに定住したいだけなんです"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "もの。洗濯可能なら、私のものを手に入れるかもしれない"}, {"type": "subtitle", "time": 7546.31, "timestamp": "02:05:46", "text": "すべて大丈夫、両親を呼べる"}, {"type": "subtitle", "time": 7548.27, "timestamp": "02:05:48", "text": "そこに家族がいます"}, {"type": "subtitle", "time": 7550.629, "timestamp": "02:05:50", "text": "何かで彼らを何かで扱う"}, {"type": "subtitle", "time": 7555.47, "timestamp": "02:05:55", "text": "いいことか何か、私の"}, {"type": "subtitle", "time": 7558.629, "timestamp": "02:05:58", "text": "個人的には賢明なチューブサイドが欲しい"}]
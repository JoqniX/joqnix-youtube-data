[{"type": "subtitle", "time": 12002.309, "timestamp": "03:20:02", "text": "あの、何か食べるものはありますか？私は"}, {"type": "subtitle", "time": 12004.19, "timestamp": "03:20:04", "text": "19歳くらい"}, {"type": "subtitle", "time": 12008.269, "timestamp": "03:20:08", "text": "HP。ありがとうございます。ありがとう。感謝"}, {"type": "subtitle", "time": 12015.83, "timestamp": "03:20:15", "text": "神。何てことだ。私は実際に彼は実際に"}, {"type": "subtitle", "time": 12019.19, "timestamp": "03:20:19", "text": "物をくれた。何てことだ。彼は実際に"}, {"type": "subtitle", "time": 12025.19, "timestamp": "03:20:25", "text": "しかし、それは実際に私の"}, {"type": "subtitle", "time": 12033.83, "timestamp": "03:20:33", "text": "そうです。何てことだ。ええと、木材を手に入れるために。私は持っている"}, {"type": "subtitle", "time": 12036.63, "timestamp": "03:20:36", "text": "木材。木材830個。わからない、わからない"}, {"type": "subtitle", "time": 12048.75, "timestamp": "03:20:48", "text": "それ。作物を読み込むことはできません"}]
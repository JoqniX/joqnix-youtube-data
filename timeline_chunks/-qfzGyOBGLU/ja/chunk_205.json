[{"type": "subtitle", "time": 12305.79, "timestamp": "03:25:05", "text": "上。私はただ"}, {"type": "subtitle", "time": 12309.83, "timestamp": "03:25:09", "text": "ライブ。ああ、神様。ああ、神様。ああ、神様。ああ、神様。おお"}, {"type": "subtitle", "time": 12317.95, "timestamp": "03:25:17", "text": "神。おお"}, {"type": "subtitle", "time": 12327.229, "timestamp": "03:25:27", "text": "私？"}, {"type": "subtitle", "time": 12330.349, "timestamp": "03:25:30", "text": "はぁ？彼らは"}, {"type": "subtitle", "time": 12339.229, "timestamp": "03:25:39", "text": "NPC。私は"}, {"type": "subtitle", "time": 12341.83, "timestamp": "03:25:41", "text": "怖がった。私は怖いです。あのね？私は"}, {"type": "subtitle", "time": 12344.51, "timestamp": "03:25:44", "text": "戻るつもりだ。うん。こんにちは、"}, {"type": "subtitle", "time": 12351.83, "timestamp": "03:25:51", "text": "あなた？戻りましょう。これは何でもない。私 私"}, {"type": "subtitle", "time": 12355.11, "timestamp": "03:25:55", "text": "私は行く必要があります。"}]
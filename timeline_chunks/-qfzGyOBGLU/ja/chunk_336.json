[{"type": "subtitle", "time": 20162.07, "timestamp": "05:36:02", "text": "バッグ。遊ぶための機材を持っていません"}, {"type": "subtitle", "time": 20164.47, "timestamp": "05:36:04", "text": "と。よし、じゃあ戻りましょうか。"}, {"type": "subtitle", "time": 20176.31, "timestamp": "05:36:16", "text": "サ。だから、水分補給は済んでいる。私は健康で"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "良いものすべて。良い。私は"}, {"type": "subtitle", "time": 20186.548, "timestamp": "05:36:26", "text": "良い。森の近くに住んでいるので、"}, {"type": "subtitle", "time": 20189.628, "timestamp": "05:36:29", "text": "私にとっては楽だ。わかった。私"}, {"type": "subtitle", "time": 20193.07, "timestamp": "05:36:33", "text": "それが私の"}, {"type": "subtitle", "time": 20199.16, "timestamp": "05:36:39", "text": "家。わかった。"}]
[{"type": "subtitle", "time": 19440.47, "timestamp": "05:24:00", "text": "小規模な製油所を建設する。わかった。つまり、これは"}, {"type": "subtitle", "time": 19444.39, "timestamp": "05:24:04", "text": "原油をくれ、原油を、何か正しいものを。"}, {"type": "subtitle", "time": 19446.55, "timestamp": "05:24:06", "text": "何について改良すればいいのかわからない"}, {"type": "subtitle", "time": 19456.11, "timestamp": "05:24:16", "text": "わかった。そして私はこれらをアップグレードできると信じています"}, {"type": "subtitle", "time": 19458.91, "timestamp": "05:24:18", "text": "もの。アップグレード"}, {"type": "subtitle", "time": 19461.99, "timestamp": "05:24:21", "text": "木材。うん、たぶんアップグレードした方がいいと思う"}, {"type": "subtitle", "time": 19479.59, "timestamp": "05:24:39", "text": "一瞬。それで、ライフル銃の部品を手に入れたんです。"}, {"type": "subtitle", "time": 19482.03, "timestamp": "05:24:42", "text": "ライフルとか色々作れるよ"}, {"type": "subtitle", "time": 19485.43, "timestamp": "05:24:45", "text": "どうやら。いいね。いいね。"}, {"type": "subtitle", "time": 19488.15, "timestamp": "05:24:48", "text": "金属製の道路標識もある。私たちは"}, {"type": "subtitle", "time": 19498.868, "timestamp": "05:24:58", "text": "あれ。こんにちは。それから、今は10時11分です。私"}]
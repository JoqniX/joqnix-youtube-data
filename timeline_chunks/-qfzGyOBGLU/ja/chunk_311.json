[{"type": "subtitle", "time": 18666.99, "timestamp": "05:11:06", "text": "大丈夫。わかった。えっと、私が欲しいのは小さいものです"}, {"type": "subtitle", "time": 18670.23, "timestamp": "05:11:10", "text": "低品質燃料を生産できる"}, {"type": "subtitle", "time": 18673.51, "timestamp": "05:11:13", "text": "原油。原油を入れることはできますか？"}, {"type": "subtitle", "time": 18676.15, "timestamp": "05:11:16", "text": "でも私の家は？"}, {"type": "subtitle", "time": 18677.67, "timestamp": "05:11:17", "text": "これは大量の油の匂いです"}, {"type": "subtitle", "time": 18681.03, "timestamp": "05:11:21", "text": "確保するのが難しい。上に置かなければならない"}, {"type": "subtitle", "time": 18685.39, "timestamp": "05:11:25", "text": "地形。わかった、地形に沿って置くよ"}, {"type": "subtitle", "time": 18688.91, "timestamp": "05:11:28", "text": "それから。ああ、とても暗い。おお"}, {"type": "subtitle", "time": 18691.83, "timestamp": "05:11:31", "text": "神。何が必要ですか？ライトが必要です"}, {"type": "subtitle", "time": 18694.75, "timestamp": "05:11:34", "text": "ソースですよね？"}, {"type": "subtitle", "time": 18697.07, "timestamp": "05:11:37", "text": "ライト、夜間視力、"}, {"type": "subtitle", "time": 18700.35, "timestamp": "05:11:40", "text": "ゴルシーリングライト。"}, {"type": "subtitle", "time": 18704.31, "timestamp": "05:11:44", "text": "ああ、サーチライトだ。サイレンのライト。フラッシャー"}, {"type": "subtitle", "time": 18708.99, "timestamp": "05:11:48", "text": "ライト。これらすべてには金属が必要です"}, {"type": "subtitle", "time": 18711.43, "timestamp": "05:11:51", "text": "断片。さて、問題は私が"}]
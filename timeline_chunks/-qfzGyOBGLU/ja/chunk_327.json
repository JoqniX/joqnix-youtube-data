[{"type": "subtitle", "time": 19621.83, "timestamp": "05:27:01", "text": "食べ物を持ってきて。だから、私たちは狩りをする必要があるので"}, {"type": "subtitle", "time": 19625.51, "timestamp": "05:27:05", "text": "たくさんの物。私たちは何かをしなければならない。うん。"}, {"type": "subtitle", "time": 19631.15, "timestamp": "05:27:11", "text": "そして、サーバーはリセットされると思います"}, {"type": "subtitle", "time": 19634.47, "timestamp": "05:27:14", "text": "すべて。サーバーは定期的にリセットされます"}, {"type": "subtitle", "time": 19636.39, "timestamp": "05:27:16", "text": "1ヶ月くらいかな。だから、それはある意味"}, {"type": "subtitle", "time": 19638.948, "timestamp": "05:27:18", "text": "痛みは大丈夫だ。しかし少なくとも重要なのは"}, {"type": "subtitle", "time": 19640.51, "timestamp": "05:27:20", "text": "私たちがプレイして"}, {"type": "subtitle", "time": 19644.75, "timestamp": "05:27:24", "text": "楽しむ。君は奇妙なゲームを選んだね"}, {"type": "subtitle", "time": 19647.83, "timestamp": "05:27:27", "text": "また、これをプレイしたかったので"}, {"type": "subtitle", "time": 19649.75, "timestamp": "05:27:29", "text": "その間。"}, {"type": "subtitle", "time": 19651.99, "timestamp": "05:27:31", "text": "友達と一緒で、"}, {"type": "subtitle", "time": 19657.39, "timestamp": "05:27:37", "text": "ビッグハルクコミュニティとかこれ"}, {"type": "subtitle", "time": 19661.19, "timestamp": "05:27:41", "text": "ゲームは、見て以来ずっと"}, {"type": "subtitle", "time": 19664.788, "timestamp": "05:27:44", "text": "オフラインのTV Rushサーバー関連の"}, {"type": "subtitle", "time": 19667.75, "timestamp": "05:27:47", "text": "ああ、私もプレイしたいな"}, {"type": "subtitle", "time": 19673.788, "timestamp": "05:27:53", "text": "そして購入から2年後"}]
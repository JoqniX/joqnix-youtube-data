[{"type": "subtitle", "time": 20835.628, "timestamp": "05:47:15", "text": "ここ？ああ、これは何でしょう？そして、"}, {"type": "subtitle", "time": 20837.868, "timestamp": "05:47:17", "text": "スイッチ。ああ、私は"}, {"type": "subtitle", "time": 20841.35, "timestamp": "05:47:21", "text": "忘れた。ラスはコーディング関連のものを持っている"}, {"type": "subtitle", "time": 20843.67, "timestamp": "05:47:23", "text": "if文と状態。ああ、君みたいに"}, {"type": "subtitle", "time": 20853.35, "timestamp": "05:47:33", "text": "[音楽]"}, {"type": "subtitle", "time": 20864.67, "timestamp": "05:47:44", "text": "それ？あれは誰だったの？何てことだ。"}, {"type": "subtitle", "time": 20867.35, "timestamp": "05:47:47", "text": "待って、待って、待って、待って、待って、待って。どうやって"}, {"type": "subtitle", "time": 20870.31, "timestamp": "05:47:50", "text": "確認すべきでしょうか？どうすれば確認できますか？どうすればいいですか"}, {"type": "subtitle", "time": 20873.23, "timestamp": "05:47:53", "text": "どうすれば確認できるのでしょうか"}, {"type": "subtitle", "time": 20875.868, "timestamp": "05:47:55", "text": "人？うん。調子はどうですか？おいおい、勘弁してくれよ。"}, {"type": "subtitle", "time": 20879.15, "timestamp": "05:47:59", "text": "マックスはこの男を見たことがあるよね？"}]
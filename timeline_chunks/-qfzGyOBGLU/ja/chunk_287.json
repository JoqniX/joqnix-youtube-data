[{"type": "subtitle", "time": 17225.83, "timestamp": "04:47:05", "text": "木材。えっと、今は"}, {"type": "subtitle", "time": 17227.83, "timestamp": "04:47:07", "text": "プライベートな世界？作れない、作れない"}, {"type": "subtitle", "time": 17230.27, "timestamp": "04:47:10", "text": "待って。プライベートワールドを作成できませんか、"}, {"type": "subtitle", "time": 17233.39, "timestamp": "04:47:13", "text": "何か？そのオプションは見当たりませんでした。"}, {"type": "subtitle", "time": 17236.15, "timestamp": "04:47:16", "text": "けれど。接続するように言われたのは"}, {"type": "subtitle", "time": 17279.83, "timestamp": "04:47:59", "text": "何？だから、もし私がXマークに当たったら、"}]
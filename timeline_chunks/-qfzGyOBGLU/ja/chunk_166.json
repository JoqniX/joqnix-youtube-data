[{"type": "subtitle", "time": 9961.63, "timestamp": "02:46:01", "text": "ハッキングした人物"}, {"type": "subtitle", "time": 9965.23, "timestamp": "02:46:05", "text": "私とサポートではできなかった"}, {"type": "subtitle", "time": 9969.11, "timestamp": "02:46:09", "text": "とても残念だ。"}, {"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "そしてそれはすべて私の父です"}, {"type": "subtitle", "time": 9974.23, "timestamp": "02:46:14", "text": "審査のために設定しなかったのは私の責任です"}, {"type": "subtitle", "time": 9978.07, "timestamp": "02:46:18", "text": "まあ、それなりにやるよ。だからそれは私の責任だ"}, {"type": "subtitle", "time": 9979.99, "timestamp": "02:46:19", "text": "主に。"}, {"type": "subtitle", "time": 9981.469, "timestamp": "02:46:21", "text": "しかしそれでも"}, {"type": "subtitle", "time": 10006.309, "timestamp": "02:46:46", "text": "痛み、えっと、誰かが私が感じていることを"}, {"type": "subtitle", "time": 10008.79, "timestamp": "02:46:48", "text": "非常にひどい。えっと、明日テストがあります"}, {"type": "subtitle", "time": 10011.67, "timestamp": "02:46:51", "text": "また朝がやってきた。こんにちは。よしよしよし。"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "うん、そうするべきだよ。うん、君"}, {"type": "subtitle", "time": 10016.07, "timestamp": "02:46:56", "text": "そうすべきだ。あなたは眠っている。プレス"}]
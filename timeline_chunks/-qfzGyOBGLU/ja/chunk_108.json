[{"type": "subtitle", "time": 6480.629, "timestamp": "01:48:00", "text": "槍？"}, {"type": "subtitle", "time": 6494.59, "timestamp": "01:48:14", "text": "亡くなった日本の配信者をTwitterでフォロー。待って、"}, {"type": "subtitle", "time": 6496.59, "timestamp": "01:48:16", "text": "誰が？"}, {"type": "subtitle", "time": 6499.75, "timestamp": "01:48:19", "text": "はぁ？待って、誰が亡くなったの？待って、待って、待って、"}, {"type": "subtitle", "time": 6506.629, "timestamp": "01:48:26", "text": "何？ああ、私もそれに気づいたと思います。おお、"}, {"type": "subtitle", "time": 6509.03, "timestamp": "01:48:29", "text": "うん。ええ、ええ。実際の忍野のように"}, {"type": "subtitle", "time": 6511.99, "timestamp": "01:48:31", "text": "何かが起こったんだよね？実際のパラソル"}, {"type": "subtitle", "time": 6515.27, "timestamp": "01:48:35", "text": "パラソーシャルビューアーが現れた"}, {"type": "subtitle", "time": 6518.229, "timestamp": "01:48:38", "text": "彼女に、そして彼女の内側を刺すように"}, {"type": "subtitle", "time": 6520.31, "timestamp": "01:48:40", "text": "本物。ああ、そうだ、そうだ、そうだ、そうだ。それ"}, {"type": "subtitle", "time": 6522.79, "timestamp": "01:48:42", "text": "1つ。はい、はい、はい。気づきました。おお"}, {"type": "subtitle", "time": 6534.31, "timestamp": "01:48:54", "text": "男。君には彼女がいるの？私は知っている"}]
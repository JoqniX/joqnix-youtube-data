[{"type": "subtitle", "time": 15192.189, "timestamp": "04:13:12", "text": "ええと、どうやら、ええと、"}, {"type": "subtitle", "time": 15204.67, "timestamp": "04:13:24", "text": "私の、もし私のためにいくつか欲しいなら"}, {"type": "subtitle", "time": 15208.03, "timestamp": "04:13:28", "text": "自転車を探している"}, {"type": "subtitle", "time": 15210.71, "timestamp": "04:13:30", "text": "胃の調子が悪い。キノコを食べよう。おお"}, {"type": "subtitle", "time": 15226.429, "timestamp": "04:13:46", "text": "六。ようこそ"}, {"type": "subtitle", "time": 15230.229, "timestamp": "04:13:50", "text": "補充します。この服は何ですか？ああ、私は"}, {"type": "subtitle", "time": 15234.469, "timestamp": "04:13:54", "text": "これで服を100着買えるよ。おお、"}]
[{"type": "subtitle", "time": 17477.27, "timestamp": "04:51:17", "text": "外。えっと、ゲーム内に音声はないんですか？"}, {"type": "subtitle", "time": 17479.47, "timestamp": "04:51:19", "text": "対話とか何か？そのため"}, {"type": "subtitle", "time": 17493.83, "timestamp": "04:51:33", "text": "マイク。宝くじは盗賊カメラの中にあります。"}, {"type": "subtitle", "time": 17495.07, "timestamp": "04:51:35", "text": "おお、"}, {"type": "subtitle", "time": 17510.11, "timestamp": "04:51:50", "text": "それ？何？山賊の野営地はありません。"}, {"type": "subtitle", "time": 17515.948, "timestamp": "04:51:55", "text": "おお、"}, {"type": "subtitle", "time": 17518.55, "timestamp": "04:51:58", "text": "放棄された鉱山基地、発電所、"}]
[{"type": "subtitle", "time": 3304.829, "timestamp": "00:55:04", "text": "知る。新人は美少年だ。とは"}, {"type": "subtitle", "time": 3312.95, "timestamp": "00:55:12", "text": "星。心配だよ。そして新しい"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "モデルにはたくさんの"}, {"type": "subtitle", "time": 3317.75, "timestamp": "00:55:17", "text": "疑惑やその他諸々、なぜなら"}, {"type": "subtitle", "time": 3321.349, "timestamp": "00:55:21", "text": "見た目と私自身の主張"}, {"type": "subtitle", "time": 3327.67, "timestamp": "00:55:27", "text": "人々が何かを言うことによって、または"}, {"type": "subtitle", "time": 3331.349, "timestamp": "00:55:31", "text": "私にはよく合うけれど、そうしなければならないような"}, {"type": "subtitle", "time": 3334.39, "timestamp": "00:55:34", "text": "それらの内容を受け入れる心の準備ができている"}, {"type": "subtitle", "time": 3336.43, "timestamp": "00:55:36", "text": "そしてこうなる"}, {"type": "subtitle", "time": 3350.069, "timestamp": "00:55:50", "text": "それで昨日、誰かがやって来て"}, {"type": "subtitle", "time": 3352.63, "timestamp": "00:55:52", "text": "ストリームで誰かが初めてチャットした"}, {"type": "subtitle", "time": 3354.43, "timestamp": "00:55:54", "text": "時間"}, {"type": "subtitle", "time": 3358.27, "timestamp": "00:55:58", "text": "推測。ええと、まず最初に"}]
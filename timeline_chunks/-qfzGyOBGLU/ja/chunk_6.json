[{"type": "subtitle", "time": 364.909, "timestamp": "00:06:04", "text": "Twitterをやらなきゃ"}, {"type": "subtitle", "time": 368.23, "timestamp": "00:06:08", "text": "私はツイッターとかそういうのはやってない"}, {"type": "subtitle", "time": 393.99, "timestamp": "00:06:33", "text": "私は自分がそうなのか分かりませんが、このようなタイプの"}, {"type": "subtitle", "time": 395.51, "timestamp": "00:06:35", "text": "こういうことは私に"}, {"type": "subtitle", "time": 397.43, "timestamp": "00:06:37", "text": "次回もさらに頑張ろうというモチベーション"}, {"type": "subtitle", "time": 399.35, "timestamp": "00:06:39", "text": "時間。私は両手を上げる"}, {"type": "subtitle", "time": 402.99, "timestamp": "00:06:42", "text": "フェニックス。まるで"}, {"type": "subtitle", "time": 407.15, "timestamp": "00:06:47", "text": "キワバ。確かに、確かに、確かに。"}]
[{"type": "subtitle", "time": 21363.23, "timestamp": "05:56:03", "text": "のために。つまり、どうやらこれらは"}, {"type": "subtitle", "time": 21366.548, "timestamp": "05:56:06", "text": "あれってどのゲームだったっけ？"}, {"type": "subtitle", "time": 21371.788, "timestamp": "05:56:11", "text": "忘れた。方舟でのサバイバル。ゲーム"}, {"type": "subtitle", "time": 21374.47, "timestamp": "05:56:14", "text": "崩壊するが、ここではそれは"}, {"type": "subtitle", "time": 21402.67, "timestamp": "05:56:42", "text": "弾丸はどうやって作るのですか？ああ、"}, {"type": "subtitle", "time": 21405.788, "timestamp": "05:56:45", "text": "神よ、私は考えもしなかった"}, {"type": "subtitle", "time": 21414.11, "timestamp": "05:56:54", "text": "持つ。これのために何を捨てればいいの？"}, {"type": "subtitle", "time": 21417.91, "timestamp": "05:56:57", "text": "あの、あのね？キャンディーを食べなさい。得る"}]
[{"type": "subtitle", "time": 19502.47, "timestamp": "05:25:02", "text": "そろそろ夕食を食べに行かなきゃ。私はしなければならない"}, {"type": "subtitle", "time": 19503.55, "timestamp": "05:25:03", "text": "夕食を食べる。"}, {"type": "subtitle", "time": 19507.11, "timestamp": "05:25:07", "text": "はい、そうします。私たちは戻る"}, {"type": "subtitle", "time": 19509.77, "timestamp": "05:25:09", "text": "再び狩りへ。"}, {"type": "subtitle", "time": 19512.67, "timestamp": "05:25:12", "text": "[音楽]"}, {"type": "subtitle", "time": 19515.75, "timestamp": "05:25:15", "text": "えっと、これどこに置いたっけ？わかった、"}, {"type": "subtitle", "time": 19524.07, "timestamp": "05:25:24", "text": "は。これくらいの弾丸なら耐えられる。"}, {"type": "subtitle", "time": 19526.15, "timestamp": "05:25:26", "text": "つまり、スタックは1つしか取れない、"}, {"type": "subtitle", "time": 19528.47, "timestamp": "05:25:28", "text": "信じる。それは良いことなのでしょうか？"}, {"type": "subtitle", "time": 19537.91, "timestamp": "05:25:37", "text": "良い。でも、お腹がペコペコなんです。食べ物が必要だ。"}, {"type": "subtitle", "time": 19547.628, "timestamp": "05:25:47", "text": "断片。いいえ、持っていません"}, {"type": "subtitle", "time": 19550.99, "timestamp": "05:25:50", "text": "さらに生の豚肉。わかった。えっと、ほらね"}]
[{"type": "subtitle", "time": 5643.39, "timestamp": "01:34:03", "text": "これ。私は海賊版を使いたくない"}, {"type": "subtitle", "time": 5647.709, "timestamp": "01:34:07", "text": "それ。つまり、それを支払った方が良い、"}, {"type": "subtitle", "time": 5650.55, "timestamp": "01:34:10", "text": "右？たった12ヶ月後"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "それは、私が永遠に所有できるものだ。でも私はただ"}, {"type": "subtitle", "time": 5657.03, "timestamp": "01:34:17", "text": "Ableton Live 13 が来ないことを願います"}, {"type": "subtitle", "time": 5659.83, "timestamp": "01:34:19", "text": "近いうちに。それが来たら、買わなければならない"}, {"type": "subtitle", "time": 5664.229, "timestamp": "01:34:24", "text": "13歳、男性。 12番スーツから13番スーツへ移す"}, {"type": "subtitle", "time": 5668.189, "timestamp": "01:34:28", "text": "スーツ。そしてそれは"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "高い。これらのライセンス、男、"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "これらのソフトウェア、他のすべてのソフトウェアは"}, {"type": "subtitle", "time": 5677.11, "timestamp": "01:34:37", "text": "このような。 FO Studioだけが"}, {"type": "subtitle", "time": 5683.75, "timestamp": "01:34:43", "text": "更新情報。しかし、もし大規模なアップデートが来たら"}, {"type": "subtitle", "time": 5690.629, "timestamp": "01:34:50", "text": "えっと、10個くらいアップデートを入れるべきですね。"}, {"type": "subtitle", "time": 5691.87, "timestamp": "01:34:51", "text": "右？"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "正直、なぜこんなものを置いたんだろう？平"}, {"type": "subtitle", "time": 5697.99, "timestamp": "01:34:57", "text": "Clip Studio Paintも同じものです。"}]
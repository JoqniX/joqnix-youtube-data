[{"type": "subtitle", "time": 13984.71, "timestamp": "03:53:04", "text": "ストリーム？部品を巡る戦いに挑む。"}, {"type": "subtitle", "time": 13987.429, "timestamp": "03:53:07", "text": "ああ、そこから部品が手に入るんですね。おお、"}, {"type": "subtitle", "time": 13999.55, "timestamp": "03:53:19", "text": "それはたくさん"}, {"type": "subtitle", "time": 14002.15, "timestamp": "03:53:22", "text": "階段。こちらには何もありません。なぜ"}, {"type": "subtitle", "time": 14003.469, "timestamp": "03:53:23", "text": "私が来たの？"}, {"type": "subtitle", "time": 14005.99, "timestamp": "03:53:25", "text": "ここ？待って、なぜ私はあなたができると思うのか"}, {"type": "subtitle", "time": 14017.79, "timestamp": "03:53:37", "text": "そこには。"}, {"type": "subtitle", "time": 14019.83, "timestamp": "03:53:39", "text": "こんにちは。あれが見えますか？誰かが"}, {"type": "subtitle", "time": 14029.07, "timestamp": "03:53:49", "text": "どうすればいいですか どうすればいいですか"}]
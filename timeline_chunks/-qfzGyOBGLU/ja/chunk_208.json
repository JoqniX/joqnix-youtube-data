[{"type": "subtitle", "time": 12481.51, "timestamp": "03:28:01", "text": "あなた。彼に姿を見せてはいけません。ただ作るだけ"}, {"type": "subtitle", "time": 12488.389, "timestamp": "03:28:08", "text": "場所。あの場所を突破しろ。わかった。"}, {"type": "subtitle", "time": 12489.95, "timestamp": "03:28:09", "text": "ああ神様、私は"}, {"type": "subtitle", "time": 12499.67, "timestamp": "03:28:19", "text": "[音楽]"}, {"type": "subtitle", "time": 12511.19, "timestamp": "03:28:31", "text": "うわぁ。そして、絶対に言わないで、"}, {"type": "subtitle", "time": 12512.67, "timestamp": "03:28:32", "text": "絶対にしないで"}, {"type": "subtitle", "time": 12516.71, "timestamp": "03:28:36", "text": "私はこの地獄のような場所から逃れられないと言っている。"}]
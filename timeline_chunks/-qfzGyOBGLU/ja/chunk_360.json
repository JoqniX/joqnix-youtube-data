[{"type": "subtitle", "time": 21607.948, "timestamp": "06:00:07", "text": "そして、とても楽しくなった。"}, {"type": "subtitle", "time": 21610.31, "timestamp": "06:00:10", "text": "ああ、私が思っていた通りだ。それは"}, {"type": "subtitle", "time": 21655.548, "timestamp": "06:00:55", "text": "何か。ああ、私たちは"}, {"type": "subtitle", "time": 21659.548, "timestamp": "06:00:59", "text": "それ。その石はそのままにしておいて。の"}]
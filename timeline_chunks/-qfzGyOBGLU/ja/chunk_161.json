[{"type": "subtitle", "time": 9660.95, "timestamp": "02:41:00", "text": "あなた？まあ、いいんだけどね。今日は"}, {"type": "subtitle", "time": 9664.95, "timestamp": "02:41:04", "text": "えーと、わかりません。持っていません。"}, {"type": "subtitle", "time": 9667.79, "timestamp": "02:41:07", "text": "どうやら塊茎の休息場所があるようだ"}, {"type": "subtitle", "time": 9671.71, "timestamp": "02:41:11", "text": "サーバ。 VTuberと入力してもいいですか？表示されるだろうか"}, {"type": "subtitle", "time": 9675.83, "timestamp": "02:41:15", "text": "上？いいえ、そうではありません。ああ、そうだね"}, {"type": "subtitle", "time": 9679.19, "timestamp": "02:41:19", "text": "ない。だから、VTuber Oという名前で。でも"}, {"type": "subtitle", "time": 9682.07, "timestamp": "02:41:22", "text": "ええ、とにかく、それで私たちは演奏します"}, {"type": "subtitle", "time": 9686.15, "timestamp": "02:41:26", "text": "今日、このサーバーでは、"}, {"type": "subtitle", "time": 9690.63, "timestamp": "02:41:30", "text": "SCAサーバー、Galaxy Blue。これはPVEです"}, {"type": "subtitle", "time": 9694.07, "timestamp": "02:41:34", "text": "バニラサーバー。これは良いことだ"}, {"type": "subtitle", "time": 9697.75, "timestamp": "02:41:37", "text": "ゲーム初心者向け。"}, {"type": "subtitle", "time": 9699.55, "timestamp": "02:41:39", "text": "私はゼロです"}, {"type": "subtitle", "time": 9702.83, "timestamp": "02:41:42", "text": "経験して怖いけど、"}, {"type": "subtitle", "time": 9706.15, "timestamp": "02:41:46", "text": "ワクワクするけど、ベストを尽くそう。はい、"}, {"type": "subtitle", "time": 9708.95, "timestamp": "02:41:48", "text": "少し待たなければならないかもしれません"}, {"type": "subtitle", "time": 9711.67, "timestamp": "02:41:51", "text": "接続してデータをロードする。ええ、そうかもしれません"}, {"type": "subtitle", "time": 9713.75, "timestamp": "02:41:53", "text": "少し待つ必要があります。そう、"}, {"type": "subtitle", "time": 9715.79, "timestamp": "02:41:55", "text": "それでは、少しお話しましょう。"}, {"type": "subtitle", "time": 9718.429, "timestamp": "02:41:58", "text": "はい、お元気でお過ごしでしょうか。"}]
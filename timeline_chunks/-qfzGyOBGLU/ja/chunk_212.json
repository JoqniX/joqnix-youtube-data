[{"type": "subtitle", "time": 12720.95, "timestamp": "03:32:00", "text": "うわぁ。このゲームには剣が登場します。"}, {"type": "subtitle", "time": 12738.19, "timestamp": "03:32:18", "text": "アドベンチャー。"}, {"type": "subtitle", "time": 12741.63, "timestamp": "03:32:21", "text": "ああ、なんてことだ、それは良い良い"}, {"type": "subtitle", "time": 12745.15, "timestamp": "03:32:25", "text": "プレーヤー。彼は殺しているのか"}, {"type": "subtitle", "time": 12747.99, "timestamp": "03:32:27", "text": "人？私は彼が持っていた品物を奪うことができた"}, {"type": "subtitle", "time": 12751.11, "timestamp": "03:32:31", "text": "くれた。ああ、わかりました。まず、"}, {"type": "subtitle", "time": 12753.229, "timestamp": "03:32:33", "text": "たくさん作る"}, {"type": "subtitle", "time": 12757.19, "timestamp": "03:32:37", "text": "包帯。それから私はバッグを買った。えっと、"}, {"type": "subtitle", "time": 12759.99, "timestamp": "03:32:39", "text": "今、駅を出たいのですか？はい。"}, {"type": "subtitle", "time": 12761.469, "timestamp": "03:32:41", "text": "はい、私は"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "する。ええと、ついてきてください。"}, {"type": "subtitle", "time": 12773.349, "timestamp": "03:32:53", "text": "神。これは何ですか？なぜ彼は骸骨なのか？"}]
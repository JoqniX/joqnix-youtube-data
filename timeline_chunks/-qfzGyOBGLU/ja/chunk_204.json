[{"type": "subtitle", "time": 12244.389, "timestamp": "03:24:04", "text": "わかったら、残りのことをやってください。"}, {"type": "subtitle", "time": 12257.99, "timestamp": "03:24:17", "text": "ええと、軍隊。あ、待って。私は"}, {"type": "subtitle", "time": 12260.229, "timestamp": "03:24:20", "text": "牧場だけどね。牧場とは、"}, {"type": "subtitle", "time": 12263.03, "timestamp": "03:24:23", "text": "なれ"}, {"type": "subtitle", "time": 12265.309, "timestamp": "03:24:25", "text": "ええと、アイテムがあります、"}, {"type": "subtitle", "time": 12274.67, "timestamp": "03:24:34", "text": "H. それは"}, {"type": "subtitle", "time": 12276.83, "timestamp": "03:24:36", "text": "プレーヤー？おお、"}, {"type": "subtitle", "time": 12280.75, "timestamp": "03:24:40", "text": "いいえ。向こうに誰かがいるのが見える"}, {"type": "subtitle", "time": 12284.67, "timestamp": "03:24:44", "text": "そこには。あそこに誰かがいるのが見える。"}, {"type": "subtitle", "time": 12292.83, "timestamp": "03:24:52", "text": "[音楽]"}]
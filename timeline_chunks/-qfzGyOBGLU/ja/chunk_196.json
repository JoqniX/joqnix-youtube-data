[{"type": "subtitle", "time": 11771.99, "timestamp": "03:16:11", "text": "えっと、ちょっと自分のことをするよ、探検するよ"}, {"type": "subtitle", "time": 11774.75, "timestamp": "03:16:14", "text": "この場所。私は初心者です"}, {"type": "subtitle", "time": 11778.469, "timestamp": "03:16:18", "text": "これ。それは選手を攻撃するプレーですか？はい、"}, {"type": "subtitle", "time": 11797.15, "timestamp": "03:16:37", "text": "外。ああ、"}, {"type": "subtitle", "time": 11808.83, "timestamp": "03:16:48", "text": "[音楽]"}, {"type": "subtitle", "time": 11811.83, "timestamp": "03:16:51", "text": "えっと、彼らは喧嘩するんですか？なぜ私は"}, {"type": "subtitle", "time": 11813.55, "timestamp": "03:16:53", "text": "彼らです"}, {"type": "subtitle", "time": 11817.269, "timestamp": "03:16:57", "text": "ファインティング？火の中に入りたい、"}]
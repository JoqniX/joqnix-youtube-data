[{"type": "subtitle", "time": 20882.35, "timestamp": "05:48:02", "text": "しかし今"}, {"type": "subtitle", "time": 20886.628, "timestamp": "05:48:06", "text": "神とキット・キティタは、"}, {"type": "subtitle", "time": 20887.948, "timestamp": "05:48:07", "text": "私にこれ"}, {"type": "subtitle", "time": 20890.35, "timestamp": "05:48:10", "text": "MP5とこれら"}, {"type": "subtitle", "time": 20893.43, "timestamp": "05:48:13", "text": "えっと、抽出ツールとかそういうもの。だから私は"}, {"type": "subtitle", "time": 20894.67, "timestamp": "05:48:14", "text": "彼をマークする"}, {"type": "subtitle", "time": 20897.83, "timestamp": "05:48:17", "text": "フレンドリー。ガーランド、彼は狙撃手がいる"}, {"type": "subtitle", "time": 20899.948, "timestamp": "05:48:19", "text": "彼の手。おお"}, {"type": "subtitle", "time": 20902.15, "timestamp": "05:48:22", "text": "う。何が起こっているのか分からない"}, {"type": "subtitle", "time": 20903.948, "timestamp": "05:48:23", "text": "男。おお"}, {"type": "subtitle", "time": 20906.91, "timestamp": "05:48:26", "text": "うん。だから私は"}, {"type": "subtitle", "time": 20911.15, "timestamp": "05:48:31", "text": "忘れてしまったけど、見たままにしておこう。それは"}, {"type": "subtitle", "time": 20918.548, "timestamp": "05:48:38", "text": "すべて。これを入手することは可能ですか？"}, {"type": "subtitle", "time": 20921.39, "timestamp": "05:48:41", "text": "プロパンガスタンク？"}, {"type": "subtitle", "time": 20923.15, "timestamp": "05:48:43", "text": "いいえ。"}, {"type": "subtitle", "time": 20934.51, "timestamp": "05:48:54", "text": "ここはガソリンスタンドです。"}, {"type": "subtitle", "time": 20936.75, "timestamp": "05:48:56", "text": "右？"}, {"type": "subtitle", "time": 20938.91, "timestamp": "05:48:58", "text": "ああ、私たちは"}]
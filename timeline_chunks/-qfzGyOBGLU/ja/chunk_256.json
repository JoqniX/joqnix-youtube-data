[{"type": "subtitle", "time": 15362.439, "timestamp": "04:16:02", "text": "荷物をいくつか片付ける。金属製の刃。私は それ。えっと、少し食べます"}, {"type": "subtitle", "time": 15374.469, "timestamp": "04:16:14", "text": "キノコ。よし、これでもっと"}, {"type": "subtitle", "time": 15376.349, "timestamp": "04:16:16", "text": "空間。わかった、"}, {"type": "subtitle", "time": 15380.469, "timestamp": "04:16:20", "text": "良い。それは金属製のパイプです。石。石。"}, {"type": "subtitle", "time": 15385.229, "timestamp": "04:16:25", "text": "はい、結構です。こんにちは。さて、これから"}, {"type": "subtitle", "time": 15388.309, "timestamp": "04:16:28", "text": "この男をこっちへ連れてきて、この男も"}, {"type": "subtitle", "time": 15389.389, "timestamp": "04:16:29", "text": "以上"}, {"type": "subtitle", "time": 15397.11, "timestamp": "04:16:37", "text": "よし、そこは良さそうだ"}, {"type": "subtitle", "time": 15412.87, "timestamp": "04:16:52", "text": "右？わからない。私は見つける必要がある"}, {"type": "subtitle", "time": 15414.83, "timestamp": "04:16:54", "text": "良い場所"}]
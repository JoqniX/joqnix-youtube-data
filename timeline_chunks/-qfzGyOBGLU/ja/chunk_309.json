[{"type": "subtitle", "time": 18542.27, "timestamp": "05:09:02", "text": "これは私の"}, {"type": "subtitle", "time": 18551.708, "timestamp": "05:09:11", "text": "見る。 H. わかりました。えっと、弾丸を"}, {"type": "subtitle", "time": 18555.11, "timestamp": "05:09:15", "text": "戻る。えっと、待って、待って、待って、待って。私は必要としている"}, {"type": "subtitle", "time": 18558.788, "timestamp": "05:09:18", "text": "ライト。えっと、これですよね？ライト。ああ、"}, {"type": "subtitle", "time": 18560.59, "timestamp": "05:09:20", "text": "ああ、ついに"}, {"type": "subtitle", "time": 18564.948, "timestamp": "05:09:24", "text": "ライト。ああ、大変だった。"}, {"type": "subtitle", "time": 18570.59, "timestamp": "05:09:30", "text": "でも、あれは良かった。暑い。それで"}, {"type": "subtitle", "time": 18574.91, "timestamp": "05:09:34", "text": "えーと、それで私たちは、えーと"}, {"type": "subtitle", "time": 18577.708, "timestamp": "05:09:37", "text": "作る"}, {"type": "subtitle", "time": 18581.07, "timestamp": "05:09:41", "text": "もう1つは2つ"}, {"type": "subtitle", "time": 18584.788, "timestamp": "05:09:44", "text": "彼ら。低品質燃料をリクエストします"}, {"type": "subtitle", "time": 18588.59, "timestamp": "05:09:48", "text": "フェンス。必要ない。研究母"}, {"type": "subtitle", "time": 18598.11, "timestamp": "05:09:58", "text": "えっと、自動販売機。わかった。わかった。えっと、待って。"}]
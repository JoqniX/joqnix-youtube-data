[{"type": "subtitle", "time": 19811.35, "timestamp": "05:30:11", "text": "それ。全部持って行った。よし、いいね。こんにちは、私たちは"}, {"type": "subtitle", "time": 19818.15, "timestamp": "05:30:18", "text": "もの。作成する必要があるか、"}, {"type": "subtitle", "time": 19820.39, "timestamp": "05:30:20", "text": "何？こっちに置きましょう。私たちには必要だ"}, {"type": "subtitle", "time": 19823.708, "timestamp": "05:30:23", "text": "脂肪"}, {"type": "subtitle", "time": 19828.91, "timestamp": "05:30:28", "text": "こちらには骨と肉があります。私は"}, {"type": "subtitle", "time": 19834.27, "timestamp": "05:30:34", "text": "もう片方はどこにあるの？脂肪"}, {"type": "subtitle", "time": 19838.35, "timestamp": "05:30:38", "text": "骨。骨を入れてください。置く"}, {"type": "subtitle", "time": 19848.51, "timestamp": "05:30:48", "text": "それ。もう一つあれ"}]
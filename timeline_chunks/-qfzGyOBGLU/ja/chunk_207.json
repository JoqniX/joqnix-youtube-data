[{"type": "subtitle", "time": 12422.309, "timestamp": "03:27:02", "text": "すべて。私は近づいています 私は近づいています"}, {"type": "subtitle", "time": 12432.51, "timestamp": "03:27:12", "text": "[音楽]"}, {"type": "subtitle", "time": 12441.67, "timestamp": "03:27:21", "text": "エレベーターはありません。でも、"}, {"type": "subtitle", "time": 12443.71, "timestamp": "03:27:23", "text": "電話"}, {"type": "subtitle", "time": 12446.07, "timestamp": "03:27:26", "text": "何？よし、何かあるようだ"}, {"type": "subtitle", "time": 12451.79, "timestamp": "03:27:31", "text": "[音楽]"}, {"type": "subtitle", "time": 12457.01, "timestamp": "03:27:37", "text": "ここ。これらのデータは読み込むことができません。"}, {"type": "subtitle", "time": 12459.229, "timestamp": "03:27:39", "text": "[音楽]"}, {"type": "subtitle", "time": 12476.91, "timestamp": "03:27:56", "text": "否定しなさい、彼に見せてはいけない"}]
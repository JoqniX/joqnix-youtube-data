[{"type": "subtitle", "time": 6543.109, "timestamp": "01:49:03", "text": "だが、もし私が何らかの状況にある場合"}, {"type": "subtitle", "time": 6545.59, "timestamp": "01:49:05", "text": "公にすべきではない関係"}, {"type": "subtitle", "time": 6547.87, "timestamp": "01:49:07", "text": "明らかにする"}, {"type": "subtitle", "time": 6550.91, "timestamp": "01:49:10", "text": "本当に必要になるまでは"}, {"type": "subtitle", "time": 6557.669, "timestamp": "01:49:17", "text": "壊れる何か"}, {"type": "subtitle", "time": 6564.59, "timestamp": "01:49:24", "text": "顔。"}, {"type": "subtitle", "time": 6567.229, "timestamp": "01:49:27", "text": "うん。そしてもしもし"}, {"type": "subtitle", "time": 6569.75, "timestamp": "01:49:29", "text": "アイドル的な観点から考えると、"}, {"type": "subtitle", "time": 6573.109, "timestamp": "01:49:33", "text": "右？もしあなたが私と同じように考えているなら"}, {"type": "subtitle", "time": 6575.669, "timestamp": "01:49:35", "text": "最近Hol Lifeで起こったこと、"}, {"type": "subtitle", "time": 6578.229, "timestamp": "01:49:38", "text": "右？ドラマの話はしたくない"}, {"type": "subtitle", "time": 6582.149, "timestamp": "01:49:42", "text": "いろいろあるけど、うんうん、人々は"}, {"type": "subtitle", "time": 6584.629, "timestamp": "01:49:44", "text": "あなたが女性クリエイターや"}, {"type": "subtitle", "time": 6587.51, "timestamp": "01:49:47", "text": "男性クリエイターが他のクリエイターとコラボレーションする場合"}, {"type": "subtitle", "time": 6591.91, "timestamp": "01:49:51", "text": "他のクリエイター、例えば"}, {"type": "subtitle", "time": 6594.229, "timestamp": "01:49:54", "text": "異なる性別の観客は"}]
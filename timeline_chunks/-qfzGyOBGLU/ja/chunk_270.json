[{"type": "subtitle", "time": 16219.03, "timestamp": "04:30:19", "text": "リスト。待って。ドアの上で遊ぶ"}, {"type": "subtitle", "time": 16221.51, "timestamp": "04:30:21", "text": "鍵を作成するために必要なもの。 1位"}, {"type": "subtitle", "time": 16229.95, "timestamp": "04:30:29", "text": "ドア。不思議"}, {"type": "subtitle", "time": 16233.229, "timestamp": "04:30:33", "text": "シーン。ああ、この二人。"}, {"type": "subtitle", "time": 16239.229, "timestamp": "04:30:39", "text": "フレンドリー。"}, {"type": "subtitle", "time": 16248.309, "timestamp": "04:30:48", "text": "はい。わかった。ドアを作らなければならない。これ"}, {"type": "subtitle", "time": 16256.83, "timestamp": "04:30:56", "text": "神。ああ、両開きドアにしよう"}]
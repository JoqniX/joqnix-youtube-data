[{"type": "subtitle", "time": 20280.43, "timestamp": "05:38:00", "text": "右？そして空っぽの物、"}, {"type": "subtitle", "time": 20283.47, "timestamp": "05:38:03", "text": "うん、わかるよ"}, {"type": "subtitle", "time": 20287.43, "timestamp": "05:38:07", "text": "これ。ええ、私は自分の"}, {"type": "subtitle", "time": 20289.628, "timestamp": "05:38:09", "text": "夕食を済ませて戻ってきて"}, {"type": "subtitle", "time": 20291.708, "timestamp": "05:38:11", "text": "少し。"}, {"type": "subtitle", "time": 20304.47, "timestamp": "05:38:24", "text": "1秒。私は後ろに戻ります。"}]
[{"type": "subtitle", "time": 11401.349, "timestamp": "03:10:01", "text": "NPC？何が起こるかわからない。それは電話です。待って、"}, {"type": "subtitle", "time": 11403.95, "timestamp": "03:10:03", "text": "電話をかけることはできません。待って、"}, {"type": "subtitle", "time": 11427.79, "timestamp": "03:10:27", "text": "幽霊"}, {"type": "subtitle", "time": 11431.349, "timestamp": "03:10:31", "text": "暗い。この地下鉄システムとは何ですか？待って、"}, {"type": "subtitle", "time": 11433.63, "timestamp": "03:10:33", "text": "これは"}, {"type": "subtitle", "time": 11436.87, "timestamp": "03:10:36", "text": "地下鉄？あれは地下鉄ですか？"}, {"type": "subtitle", "time": 11441.03, "timestamp": "03:10:41", "text": "ああ、地下鉄だ。ああ、地下鉄だ。"}, {"type": "subtitle", "time": 11442.429, "timestamp": "03:10:42", "text": "ああ、"}, {"type": "subtitle", "time": 11444.67, "timestamp": "03:10:44", "text": "神。開ける"}]
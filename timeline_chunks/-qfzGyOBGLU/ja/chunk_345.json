[{"type": "subtitle", "time": 20706.628, "timestamp": "05:45:06", "text": "しばらく前にリグの作業は完了しました。私はできません。それで、"}, {"type": "subtitle", "time": 20710.788, "timestamp": "05:45:10", "text": "ガソリンスタンドに行きましょう。"}, {"type": "subtitle", "time": 20718.548, "timestamp": "05:45:18", "text": "場所。今のところ、ええ、3人と会いました"}, {"type": "subtitle", "time": 20727.23, "timestamp": "05:45:27", "text": "遠い。 ３人全員が私に"}, {"type": "subtitle", "time": 20730.548, "timestamp": "05:45:30", "text": "本当に良いものですね。そして私は"}, {"type": "subtitle", "time": 20748.75, "timestamp": "05:45:48", "text": "2つあります。それらを"}]
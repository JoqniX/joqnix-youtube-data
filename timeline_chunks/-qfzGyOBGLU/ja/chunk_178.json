[{"type": "subtitle", "time": 10680.309, "timestamp": "02:58:00", "text": "私の経歴、ですよね？君たちは欲しい"}, {"type": "subtitle", "time": 10682.23, "timestamp": "02:58:02", "text": "背景ですか、それとも皆さんはこれを希望しますか?"}, {"type": "subtitle", "time": 10685.38, "timestamp": "02:58:05", "text": "ゲームの音声？"}, {"type": "subtitle", "time": 10698.95, "timestamp": "02:58:18", "text": "[笑い]"}, {"type": "subtitle", "time": 10707.75, "timestamp": "02:58:27", "text": "一人で。それで、木材を手に入れた。私が何を"}, {"type": "subtitle", "time": 10715.03, "timestamp": "02:58:35", "text": "キャンプファイヤー。私はハンマーを作ることができます。わかった、"}, {"type": "subtitle", "time": 10717.55, "timestamp": "02:58:37", "text": "ハンマーを作ります"}, {"type": "subtitle", "time": 10720.55, "timestamp": "02:58:40", "text": "良い。建築計画書ではない。良い"}, {"type": "subtitle", "time": 10729.55, "timestamp": "02:58:49", "text": "クラフト？作成する。私"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "待って。いや、それはチームだよ。えっと、待って。どのように"}, {"type": "subtitle", "time": 10734.67, "timestamp": "02:58:54", "text": "私は工作をしていますか？"}, {"type": "subtitle", "time": 10737.99, "timestamp": "02:58:57", "text": "わかった。ああ、自動的にクラフトします"}]
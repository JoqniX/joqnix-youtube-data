[{"type": "subtitle", "time": 19033.75, "timestamp": "05:17:13", "text": "行く。なぜ私にそれを入れられないと言うのですか"}, {"type": "subtitle", "time": 19042.03, "timestamp": "05:17:22", "text": "本物？"}, {"type": "subtitle", "time": 19055.07, "timestamp": "05:17:35", "text": "シーリング。うん。こんにちは、Roku。どうやって"}, {"type": "subtitle", "time": 19058.07, "timestamp": "05:17:38", "text": "何をしているの？あなたは寝ているはずなのに、"}, {"type": "subtitle", "time": 19065.43, "timestamp": "05:17:45", "text": "上？床の骨組み。"}]
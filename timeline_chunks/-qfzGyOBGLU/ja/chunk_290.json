[{"type": "subtitle", "time": 17401.91, "timestamp": "04:50:01", "text": "ストリーム。それはポーカーゲームのようなもの"}, {"type": "subtitle", "time": 17404.07, "timestamp": "04:50:04", "text": "ゲームみたいな感じですよね？"}, {"type": "subtitle", "time": 17406.868, "timestamp": "04:50:06", "text": "その場所はどこにあるのですか？または、またはする"}, {"type": "subtitle", "time": 17408.948, "timestamp": "04:50:08", "text": "人々がその場所を作るか何か"}, {"type": "subtitle", "time": 17413.43, "timestamp": "04:50:13", "text": "宝くじみたいな感じ"}, {"type": "subtitle", "time": 17415.67, "timestamp": "04:50:15", "text": "ダーツを投げたり"}, {"type": "subtitle", "time": 17419.51, "timestamp": "04:50:19", "text": "何かを手に入れようとして、"}]
[{"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "行く？彼はどこへ行ったのか？何てことだ。私は"}, {"type": "subtitle", "time": 15708.229, "timestamp": "04:21:48", "text": "私の最初の食べ物は野生動物の食べ物ですが、"}, {"type": "subtitle", "time": 15709.55, "timestamp": "04:21:49", "text": "私の"}, {"type": "subtitle", "time": 15712.83, "timestamp": "04:21:52", "text": "鹿。私は試しました"}]
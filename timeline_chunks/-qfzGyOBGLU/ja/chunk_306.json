[{"type": "subtitle", "time": 18361.31, "timestamp": "05:06:01", "text": "[音楽]"}, {"type": "subtitle", "time": 18367.19, "timestamp": "05:06:07", "text": "自分？待って、私の家はどこ？"}, {"type": "subtitle", "time": 18370.708, "timestamp": "05:06:10", "text": "ああ、どこに置いたか覚えていない"}, {"type": "subtitle", "time": 18401.11, "timestamp": "05:06:41", "text": "そして、もし私がそれを殺していないなら、なぜ私はそれを殺したのか"}, {"type": "subtitle", "time": 18403.788, "timestamp": "05:06:43", "text": "ストレージ？しかし"}, {"type": "subtitle", "time": 18417.948, "timestamp": "05:06:57", "text": "待って。私は覚えていません"}]
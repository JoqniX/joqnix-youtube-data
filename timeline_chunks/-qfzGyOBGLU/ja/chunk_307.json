[{"type": "subtitle", "time": 18422.39, "timestamp": "05:07:02", "text": "方法。トーチを受け継ぐべきだった。"}, {"type": "subtitle", "time": 18426.55, "timestamp": "05:07:06", "text": "確かN102だったと思いますよね？はい。"}, {"type": "subtitle", "time": 18432.75, "timestamp": "05:07:12", "text": "先に。それは"}, {"type": "subtitle", "time": 18441.628, "timestamp": "05:07:21", "text": "あれ。目的は家に帰ることです"}, {"type": "subtitle", "time": 18444.23, "timestamp": "05:07:24", "text": "安全に。それが一番重要な点です。ああ神様、"}, {"type": "subtitle", "time": 18445.788, "timestamp": "05:07:25", "text": "そこには"}, {"type": "subtitle", "time": 18457.39, "timestamp": "05:07:37", "text": "N1 付近だと思います"}, {"type": "subtitle", "time": 18460.59, "timestamp": "05:07:40", "text": "O. 私は信じます"}, {"type": "subtitle", "time": 18464.27, "timestamp": "05:07:44", "text": "これは森ですか？私は"}, {"type": "subtitle", "time": 18467.27, "timestamp": "05:07:47", "text": "怖がった。逃げた方がいいと思う"}, {"type": "subtitle", "time": 18469.788, "timestamp": "05:07:49", "text": "このことから"}, {"type": "subtitle", "time": 18473.47, "timestamp": "05:07:53", "text": "森へまっすぐ行くのではなく"}]
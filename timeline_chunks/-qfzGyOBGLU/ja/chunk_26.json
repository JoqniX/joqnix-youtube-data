[{"type": "subtitle", "time": 1579.19, "timestamp": "00:26:19", "text": "Copaユーザーの皆様、copi販売を統合します"}, {"type": "subtitle", "time": 1581.35, "timestamp": "00:26:21", "text": "当社の新しいミートンウィジェット。あなたならどうしますか？"}, {"type": "subtitle", "time": 1583.47, "timestamp": "00:26:23", "text": "何が理にかなっているだろうか"}, {"type": "subtitle", "time": 1586.35, "timestamp": "00:26:26", "text": "あなた？"}, {"type": "subtitle", "time": 1589.75, "timestamp": "00:26:29", "text": "ああ、乳母はたくさんの肉を作っている"}, {"type": "subtitle", "time": 1604.549, "timestamp": "00:26:44", "text": "私は、もし私が"}, {"type": "subtitle", "time": 1609.029, "timestamp": "00:26:49", "text": "この訪問を購入するのに15日、いや16日遅れたので、"}, {"type": "subtitle", "time": 1611.19, "timestamp": "00:26:51", "text": "最低限の金額で済ませることもできたはずだ。あなた"}]
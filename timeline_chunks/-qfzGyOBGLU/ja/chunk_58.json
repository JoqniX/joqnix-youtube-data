[{"type": "subtitle", "time": 3482.549, "timestamp": "00:58:02", "text": "午前 4:00 午前 6:00 私は失くしました"}, {"type": "subtitle", "time": 3483.74, "timestamp": "00:58:03", "text": "ダイヤモンドのつるはしと"}, {"type": "subtitle", "time": 3486.03, "timestamp": "00:58:06", "text": "[音楽]"}, {"type": "subtitle", "time": 3505.309, "timestamp": "00:58:25", "text": "持ち物の名前をもう一度付け直さないといけないな。"}, {"type": "subtitle", "time": 3508.95, "timestamp": "00:58:28", "text": "えっと、私は待った方がいいと思います"}, {"type": "subtitle", "time": 3512.03, "timestamp": "00:58:32", "text": "新しいサーバーが登場します。"}, {"type": "subtitle", "time": 3515.589, "timestamp": "00:58:35", "text": "右？死なないのではなくログインする"}, {"type": "subtitle", "time": 3516.99, "timestamp": "00:58:36", "text": "そして全て。"}, {"type": "subtitle", "time": 3520.47, "timestamp": "00:58:40", "text": "うん、だって一生懸命頑張ったんだもん。私は"}, {"type": "subtitle", "time": 3524.789, "timestamp": "00:58:44", "text": "一度に私に与えられたクエスト。私"}, {"type": "subtitle", "time": 3526.71, "timestamp": "00:58:46", "text": "ズームしていたけどね。視聴できます"}, {"type": "subtitle", "time": 3529.63, "timestamp": "00:58:49", "text": "ヴォード。あなたはするであろう"}, {"type": "subtitle", "time": 3531.789, "timestamp": "00:58:51", "text": "知る。私は"}, {"type": "subtitle", "time": 3535.23, "timestamp": "00:58:55", "text": "スライドでズームして"}]
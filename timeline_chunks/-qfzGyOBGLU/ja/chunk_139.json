[{"type": "subtitle", "time": 8346.469, "timestamp": "02:19:06", "text": "ここ。これは実に興味深い。"}, {"type": "subtitle", "time": 8364.87, "timestamp": "02:19:24", "text": "ああ、ユーザー作成物を置くことができ、"}, {"type": "subtitle", "time": 8376.75, "timestamp": "02:19:36", "text": "使うかもしれない"}, {"type": "subtitle", "time": 8380.03, "timestamp": "02:19:40", "text": "私がそうするかもしれない"}, {"type": "subtitle", "time": 8388.27, "timestamp": "02:19:48", "text": "ああ、気にしないで。おお、"}, {"type": "subtitle", "time": 8391.59, "timestamp": "02:19:51", "text": "大丈夫。元のIPアドレスを次のように入力できます"}, {"type": "subtitle", "time": 8394.23, "timestamp": "02:19:54", "text": "青いアーカイブの下にファンを置く"}, {"type": "subtitle", "time": 8397.03, "timestamp": "02:19:57", "text": "オリジナルの知的財産権など。そうです、わかりました。"}, {"type": "subtitle", "time": 8398.63, "timestamp": "02:19:58", "text": "わかった。わかった。わかった。わかった。わかった。"}]
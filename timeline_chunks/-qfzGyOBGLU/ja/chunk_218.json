[{"type": "subtitle", "time": 13080.269, "timestamp": "03:38:00", "text": "行く？何てことだ。あなたはそうしなければならない"}, {"type": "subtitle", "time": 13083.91, "timestamp": "03:38:03", "text": "冗談だよ。冗談でしょう。負けました"}, {"type": "subtitle", "time": 13085.75, "timestamp": "03:38:05", "text": "私の支え。"}, {"type": "subtitle", "time": 13090.91, "timestamp": "03:38:10", "text": "私は心の支えを失ってしまった。とんでもない。いいえ"}, {"type": "subtitle", "time": 13102.229, "timestamp": "03:38:22", "text": "うわあ、すごいね。今、フライドチキンを食べています"}, {"type": "subtitle", "time": 13105.95, "timestamp": "03:38:25", "text": "翼。ああ、お腹を空かせないでよ。"}, {"type": "subtitle", "time": 13107.93, "timestamp": "03:38:27", "text": "B、君は私を"}, {"type": "subtitle", "time": 13111.15, "timestamp": "03:38:31", "text": "[音楽]"}, {"type": "subtitle", "time": 13113.59, "timestamp": "03:38:33", "text": "お腹がすいた。はぁ？"}]
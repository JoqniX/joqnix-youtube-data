[{"type": "subtitle", "time": 13880.71, "timestamp": "03:51:20", "text": "それ？次は斧を作る必要がある。待って、"}, {"type": "subtitle", "time": 13889.79, "timestamp": "03:51:29", "text": "よし、私はたくさん持っていると思うよ。"}, {"type": "subtitle", "time": 13894.349, "timestamp": "03:51:34", "text": "製作。製作。検索方法は？"}, {"type": "subtitle", "time": 13896.429, "timestamp": "03:51:36", "text": "斧石"}, {"type": "subtitle", "time": 13899.55, "timestamp": "03:51:39", "text": "つるはし。 200"}, {"type": "subtitle", "time": 13903.71, "timestamp": "03:51:43", "text": "木材。待て、それはつるはしだ。待って、"}, {"type": "subtitle", "time": 13909.67, "timestamp": "03:51:49", "text": "何か。道具のことですよね？わかった。えっと、"}, {"type": "subtitle", "time": 13912.55, "timestamp": "03:51:52", "text": "釣り竿、懐中電灯、石、手斧。"}, {"type": "subtitle", "time": 13915.51, "timestamp": "03:51:55", "text": "ああ、これは手斧ですか？ああ、手斧だ。わかった、"}, {"type": "subtitle", "time": 13917.469, "timestamp": "03:51:57", "text": "今、私は見つけなければならない"}]
[{"type": "subtitle", "time": 6607.47, "timestamp": "01:50:07", "text": "アイドル文化"}, {"type": "subtitle", "time": 6610.95, "timestamp": "01:50:10", "text": "あれ。ああ、ジュガールとかクソみたいなやつ。"}, {"type": "subtitle", "time": 6614.709, "timestamp": "01:50:14", "text": "ああ、気分が悪かったよ。何？何？どうやって"}, {"type": "subtitle", "time": 6618.51, "timestamp": "01:50:18", "text": "彼女は対処しなければならないことがたくさんある"}, {"type": "subtitle", "time": 6621.83, "timestamp": "01:50:21", "text": "すでに？くそ。 Coro V2は、"}, {"type": "subtitle", "time": 6624.229, "timestamp": "01:50:24", "text": "レベル。彼らはこれらの問題への対処法を知っている"}, {"type": "subtitle", "time": 6626.31, "timestamp": "01:50:26", "text": "状況と憎しみとすべて"}, {"type": "subtitle", "time": 6628.91, "timestamp": "01:50:28", "text": "魔女狩りとかそういう類のこと"}, {"type": "subtitle", "time": 6632.149, "timestamp": "01:50:32", "text": "わあ、どうやってやるんだろう？私も"}, {"type": "subtitle", "time": 6635.95, "timestamp": "01:50:35", "text": "敏感な人、そして私は"}, {"type": "subtitle", "time": 6637.79, "timestamp": "01:50:37", "text": "窒息する"}, {"type": "subtitle", "time": 6641.47, "timestamp": "01:50:41", "text": "私は、どうすればいいのかわかりません"}, {"type": "subtitle", "time": 6649.59, "timestamp": "01:50:49", "text": "ドゥル。私はdshaを食べるのが大好きです"}, {"type": "subtitle", "time": 6653.669, "timestamp": "01:50:53", "text": "このフォーク。ニース。だから私は"}]
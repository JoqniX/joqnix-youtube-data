[{"type": "subtitle", "time": 5222.31, "timestamp": "01:27:02", "text": "何も支払わずに使える、なぜなら私は所有しているから"}, {"type": "subtitle", "time": 5223.229, "timestamp": "01:27:03", "text": "の"}, {"type": "subtitle", "time": 5227.55, "timestamp": "01:27:07", "text": "FLの究極版"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "スタジオ。私は「FLを使おう」と思ったんです。"}, {"type": "subtitle", "time": 5232.709, "timestamp": "01:27:12", "text": "私は、私は使わないつもりです"}, {"type": "subtitle", "time": 5235.27, "timestamp": "01:27:15", "text": "それ以外は。しかし、私はAbletonに気づきました"}, {"type": "subtitle", "time": 5238.99, "timestamp": "01:27:18", "text": "私にとってより良いのは"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "なぜなら、"}, {"type": "subtitle", "time": 5243.35, "timestamp": "01:27:23", "text": "インストラクターはAbletonも勧めた。"}, {"type": "subtitle", "time": 5245.51, "timestamp": "01:27:25", "text": "ライブをやりたいから、もっと良くなるよ"}, {"type": "subtitle", "time": 5247.55, "timestamp": "01:27:27", "text": "編集とコンサート"}, {"type": "subtitle", "time": 5251.83, "timestamp": "01:27:31", "text": "そういうことですよね？音楽制作だけではない。"}, {"type": "subtitle", "time": 5255.03, "timestamp": "01:27:35", "text": "自分の曲を演奏したい"}, {"type": "subtitle", "time": 5258.07, "timestamp": "01:27:38", "text": "そして、それを試してみる。つまりAbletonは"}, {"type": "subtitle", "time": 5259.229, "timestamp": "01:27:39", "text": "より良い"}, {"type": "subtitle", "time": 5262.75, "timestamp": "01:27:42", "text": "再生など、あらゆることにおいて。プレイする"}]
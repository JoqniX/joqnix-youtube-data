[{"type": "subtitle", "time": 7562.07, "timestamp": "02:06:02", "text": "中に入るために、えーと"}, {"type": "subtitle", "time": 7568.95, "timestamp": "02:06:08", "text": "日本に行けた仕事だったのに"}, {"type": "subtitle", "time": 7571.189, "timestamp": "02:06:11", "text": "私はできた、私はしなかった、私はこう思った"}, {"type": "subtitle", "time": 7572.95, "timestamp": "02:06:12", "text": "それは不可能だよ、君は僕の家族を知っているだろう"}, {"type": "subtitle", "time": 7576.03, "timestamp": "02:06:16", "text": "同意すらしないだろう。私はこう思った"}, {"type": "subtitle", "time": 7578.629, "timestamp": "02:06:18", "text": "不必要なことを考えすぎてジャンプ"}, {"type": "subtitle", "time": 7581.75, "timestamp": "02:06:21", "text": "私は結論を早合点してしまったが、実際には"}, {"type": "subtitle", "time": 7584.87, "timestamp": "02:06:24", "text": "これらすべてについて真剣に調査した"}, {"type": "subtitle", "time": 7587.75, "timestamp": "02:06:27", "text": "そして、まるで、まるで、まるで、そうではないかのように提示する。"}, {"type": "subtitle", "time": 7589.83, "timestamp": "02:06:29", "text": "対峙した、彼らと話した、話をした"}, {"type": "subtitle", "time": 7591.43, "timestamp": "02:06:31", "text": "彼らと私のすべてをプレゼンテーションしました"}, {"type": "subtitle", "time": 7593.669, "timestamp": "02:06:33", "text": "私が行ったような調査"}, {"type": "subtitle", "time": 7595.43, "timestamp": "02:06:35", "text": "アカデミーとこれとこれと研究"}, {"type": "subtitle", "time": 7597.589, "timestamp": "02:06:37", "text": "価格やその他諸々は"}, {"type": "subtitle", "time": 7599.669, "timestamp": "02:06:39", "text": "これが私が欲しいものだと言った"}, {"type": "subtitle", "time": 7602.55, "timestamp": "02:06:42", "text": "正直に言うと、私が彼らと率直に話したとき"}, {"type": "subtitle", "time": 7604.87, "timestamp": "02:06:44", "text": "彼らは「そうだよ」と言った"}, {"type": "subtitle", "time": 7608.069, "timestamp": "02:06:48", "text": "私に送ってくれるとか色々"}, {"type": "subtitle", "time": 7610.39, "timestamp": "02:06:50", "text": "私が何を決めたとしても、それはあなたのものです"}, {"type": "subtitle", "time": 7612.189, "timestamp": "02:06:52", "text": "人生とかそういうもの"}, {"type": "subtitle", "time": 7615.189, "timestamp": "02:06:55", "text": "私は自分がとても"}, {"type": "subtitle", "time": 7616.91, "timestamp": "02:06:56", "text": "オーバーインカー右"}]
[{"type": "subtitle", "time": 2286.43, "timestamp": "00:38:06", "text": "[音楽]"}, {"type": "subtitle", "time": 2290.23, "timestamp": "00:38:10", "text": "ええと、私は、私は、私は、私が思うに、"}, {"type": "subtitle", "time": 2292.55, "timestamp": "00:38:12", "text": "集中しすぎるゲームに"}, {"type": "subtitle", "time": 2296.43, "timestamp": "00:38:16", "text": "FPS、私もそうなった、私もそうなった"}, {"type": "subtitle", "time": 2299.27, "timestamp": "00:38:19", "text": "静かにして、私はそうすべきだと思う"}, {"type": "subtitle", "time": 2301.03, "timestamp": "00:38:21", "text": "実際にインディーゲームをプレイする"}, {"type": "subtitle", "time": 2313.829, "timestamp": "00:38:33", "text": "多くの。気づいたのですが、私には必要なものがあります"}]
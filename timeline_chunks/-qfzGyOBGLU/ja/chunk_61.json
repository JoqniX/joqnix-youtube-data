[{"type": "subtitle", "time": 3661.95, "timestamp": "01:01:01", "text": "マルチストリームのやつ、もし"}, {"type": "subtitle", "time": 3669.95, "timestamp": "01:01:09", "text": "死んだ。 1つ"}, {"type": "subtitle", "time": 3673.069, "timestamp": "01:01:13", "text": "2番。ストライプ"}, {"type": "subtitle", "time": 3686.99, "timestamp": "01:01:26", "text": "4ドル。それは"}, {"type": "subtitle", "time": 3689.71, "timestamp": "01:01:29", "text": "更新"}, {"type": "subtitle", "time": 3695.069, "timestamp": "01:01:35", "text": "4月9日に。だから私は少し"}, {"type": "subtitle", "time": 3696.99, "timestamp": "01:01:36", "text": "時間"}, {"type": "subtitle", "time": 3701.069, "timestamp": "01:01:41", "text": "城と共に"}, {"type": "subtitle", "time": 3703.95, "timestamp": "01:01:43", "text": "研究所。わかった。すると問題は"}, {"type": "subtitle", "time": 3706.789, "timestamp": "01:01:46", "text": "ワークスペースと私のGoogleアカウントは非公開です"}, {"type": "subtitle", "time": 3709.19, "timestamp": "01:01:49", "text": "1つはすぐに終了する"}, {"type": "subtitle", "time": 3711.109, "timestamp": "01:01:51", "text": "保管場所が不足しているため。私はしなければならない"}, {"type": "subtitle", "time": 3713.51, "timestamp": "01:01:53", "text": "それについて何か。"}]
[{"type": "subtitle", "time": 4566.27, "timestamp": "01:16:06", "text": "知っている？それで"}, {"type": "subtitle", "time": 4577.189, "timestamp": "01:16:17", "text": "うん。うん。うん。うん。うん。そこには"}, {"type": "subtitle", "time": 4580.07, "timestamp": "01:16:20", "text": "Figma のコンバーターなど。"}, {"type": "subtitle", "time": 4586.27, "timestamp": "01:16:26", "text": "はい。それってすごくかっこいいよね。"}, {"type": "subtitle", "time": 4589.11, "timestamp": "01:16:29", "text": "ウェブスタジオ向けのものもあると思います"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "良い。しかし、その後は適切に行う必要があります"}, {"type": "subtitle", "time": 4598.55, "timestamp": "01:16:38", "text": "あなたのWeb Pigma Figmaデザインは適切に作成されています。"}, {"type": "subtitle", "time": 4600.709, "timestamp": "01:16:40", "text": "適切に分離されていない場合、"}]
[{"type": "subtitle", "time": 483.749, "timestamp": "00:08:03", "text": "今日。ああ、アスターが持っているものの量は"}, {"type": "subtitle", "time": 487.11, "timestamp": "00:08:07", "text": "そんなことをするのは正気の沙汰ではない。"}, {"type": "subtitle", "time": 489.71, "timestamp": "00:08:09", "text": "自分のお金をたくさん払う"}, {"type": "subtitle", "time": 492.749, "timestamp": "00:08:12", "text": "これだけのためにポケットに入れる"}, {"type": "subtitle", "time": 495.43, "timestamp": "00:08:15", "text": "イベント。 2倍の金額を支払わなければなりません"}, {"type": "subtitle", "time": 498.909, "timestamp": "00:08:18", "text": "今はサーバーを処理するだけで、"}, {"type": "subtitle", "time": 502.189, "timestamp": "00:08:22", "text": "すべて。想像してみてください"}, {"type": "subtitle", "time": 504.35, "timestamp": "00:08:24", "text": "彼は"}, {"type": "subtitle", "time": 507.07, "timestamp": "00:08:27", "text": "クレイジー。彼は本当に情熱的だ"}]
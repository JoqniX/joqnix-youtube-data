[{"type": "subtitle", "time": 11533.95, "timestamp": "03:12:13", "text": "誰か。聞くところによると"}, {"type": "subtitle", "time": 11548.389, "timestamp": "03:12:28", "text": "何？これは寝袋です。それは食べ物ですか？"}, {"type": "subtitle", "time": 11551.99, "timestamp": "03:12:31", "text": "それはバナナです。待って、これ食べてもいい？いいえ。"}, {"type": "subtitle", "time": 11565.71, "timestamp": "03:12:45", "text": "兄弟。ああ、"}, {"type": "subtitle", "time": 11570.79, "timestamp": "03:12:50", "text": "神。何てことだ。何てことだ。怖くなった。"}]
[{"type": "subtitle", "time": 241.71, "timestamp": "00:04:01", "text": "実際に鋳造ガス研究所の費用を支払う必要がある"}, {"type": "subtitle", "time": 255.71, "timestamp": "00:04:15", "text": "支払う。私もプレイしていました"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "数時間前のMinecraft。シングル"}, {"type": "subtitle", "time": 260.43, "timestamp": "00:04:20", "text": "選手と私の夫"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "私は死んだ男を連れて行った。私は叫んだ"}, {"type": "subtitle", "time": 267.629, "timestamp": "00:04:27", "text": "昨日泣いた私は"}, {"type": "subtitle", "time": 271.23, "timestamp": "00:04:31", "text": "終わり。私は彼らに報告した。"}, {"type": "subtitle", "time": 274.469, "timestamp": "00:04:34", "text": "それで、「うん、何があったら教えてくれ」って感じだった。"}, {"type": "subtitle", "time": 277.12, "timestamp": "00:04:37", "text": "君の負けだ。私はあなたにあげる、私は"}, {"type": "subtitle", "time": 281.55, "timestamp": "00:04:41", "text": "[音楽]"}, {"type": "subtitle", "time": 283.99, "timestamp": "00:04:43", "text": "「私のものだ。」でもクエストは完了した。"}, {"type": "subtitle", "time": 285.55, "timestamp": "00:04:45", "text": "裏切り者"}, {"type": "subtitle", "time": 296.84000000000003, "timestamp": "00:04:56", "text": "その日、俺は全ての報酬を失ってしまったんだ。"}]
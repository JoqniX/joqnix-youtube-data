[{"type": "subtitle", "time": 4740.229, "timestamp": "01:19:00", "text": "5時半頃に疲れ果てたので、"}, {"type": "subtitle", "time": 4742.41, "timestamp": "01:19:02", "text": "3時か4時頃の昼寝"}, {"type": "subtitle", "time": 4744.75, "timestamp": "01:19:04", "text": "[音楽]"}, {"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "何か。必要ないと思う"}, {"type": "subtitle", "time": 4749.03, "timestamp": "01:19:09", "text": "正直言って、それくらいは。"}, {"type": "subtitle", "time": 4751.11, "timestamp": "01:19:11", "text": "つまり、DMグループだけで十分だと考えているのですね。"}, {"type": "subtitle", "time": 4753.83, "timestamp": "01:19:13", "text": "ジョカソンで招待するときは"}, {"type": "subtitle", "time": 4761.189, "timestamp": "01:19:21", "text": "けれど？ええ、もう1台のサーバーは"}, {"type": "subtitle", "time": 4764.11, "timestamp": "01:19:24", "text": "面倒くさい。うん、本当だよ、本当だよ、"}, {"type": "subtitle", "time": 4767.03, "timestamp": "01:19:27", "text": "真実。もしかしたら、自分のものにするかもしれない"}, {"type": "subtitle", "time": 4769.709, "timestamp": "01:19:29", "text": "サーバ。 VCを開いて"}, {"type": "subtitle", "time": 4773.99, "timestamp": "01:19:33", "text": "私は、私が知っている仲間全員を追加します"}, {"type": "subtitle", "time": 4775.95, "timestamp": "01:19:35", "text": "友人として出会った"}, {"type": "subtitle", "time": 4778.87, "timestamp": "01:19:38", "text": "そして彼らも参加できる。私はできる"}, {"type": "subtitle", "time": 4780.59, "timestamp": "01:19:40", "text": "次のようにする"}, {"type": "subtitle", "time": 4783.83, "timestamp": "01:19:43", "text": "それ。うん、それならうまくいくかもしれないね。私たちはできる"}, {"type": "subtitle", "time": 4786.229, "timestamp": "01:19:46", "text": "自社サーバーを使用する必要がある。それは"}, {"type": "subtitle", "time": 4787.47, "timestamp": "01:19:47", "text": "使用されていません"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "きちんと。もっと多くの人に話してもらいたいし、"}]
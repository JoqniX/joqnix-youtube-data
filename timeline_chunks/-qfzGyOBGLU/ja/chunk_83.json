[{"type": "subtitle", "time": 4980.99, "timestamp": "01:23:00", "text": "こういうことはたくさんやってきた。しかし"}, {"type": "subtitle", "time": 4986.75, "timestamp": "01:23:06", "text": "ええ、それも私個人のこだわりです。うん、"}, {"type": "subtitle", "time": 4989.87, "timestamp": "01:23:09", "text": "例えば、"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "えっと、私が何を得ようと"}, {"type": "subtitle", "time": 4998.39, "timestamp": "01:23:18", "text": "パートタイムで働いているか、フルタイムで働いているか、"}, {"type": "subtitle", "time": 5002.149, "timestamp": "01:23:22", "text": "フリーランスのフルタイムリモートワークで、"}, {"type": "subtitle", "time": 5011.59, "timestamp": "01:23:31", "text": "クラス。共通因数分解表に載っています。"}, {"type": "subtitle", "time": 5015.27, "timestamp": "01:23:35", "text": "うん、その通り、その通り、その通り。"}]
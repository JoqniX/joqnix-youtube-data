[{"type": "subtitle", "time": 5345.39, "timestamp": "01:29:05", "text": "たくさん"}, {"type": "subtitle", "time": 5348.629, "timestamp": "01:29:08", "text": "音楽に関する他のクラスメートや物事"}, {"type": "subtitle", "time": 5350.47, "timestamp": "01:29:10", "text": "クラス。彼らは提出すると思います"}, {"type": "subtitle", "time": 5352.31, "timestamp": "01:29:12", "text": "今週の彼らのプロジェクト。私はしなければならない"}, {"type": "subtitle", "time": 5354.79, "timestamp": "01:29:14", "text": "私もそうします。私は自分がしていることを知っている"}, {"type": "subtitle", "time": 5356.87, "timestamp": "01:29:16", "text": "ジャサン。私は文字通り数時間使うことができます"}, {"type": "subtitle", "time": 5360.07, "timestamp": "01:29:20", "text": "何時間も音楽に合わせて、それを学ぼうとします"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "前回私が教えようとした時よりも"}, {"type": "subtitle", "time": 5364.79, "timestamp": "01:29:24", "text": "あれ。実験して作業を進めます"}, {"type": "subtitle", "time": 5367.59, "timestamp": "01:29:27", "text": "自分でやっていくのではなく、"}, {"type": "subtitle", "time": 5369.91, "timestamp": "01:29:29", "text": "チュートリアルみたいなものだけど、実際には"}, {"type": "subtitle", "time": 5371.229, "timestamp": "01:29:31", "text": "何をすべきかを知る"}, {"type": "subtitle", "time": 5373.75, "timestamp": "01:29:33", "text": "する。とりあえず実験してやってみます"}, {"type": "subtitle", "time": 5375.39, "timestamp": "01:29:35", "text": "自分自身。それは"}, {"type": "subtitle", "time": 5377.83, "timestamp": "01:29:37", "text": "より良い。うん。私自身として、そしてただ"}, {"type": "subtitle", "time": 5379.83, "timestamp": "01:29:39", "text": "色々試してみて、流れに身を任せてみよう。行く"}, {"type": "subtitle", "time": 5383.149, "timestamp": "01:29:43", "text": "流れ。ええ、それは"}, {"type": "subtitle", "time": 5385.83, "timestamp": "01:29:45", "text": "より良い。だって、私がそれをやっている時でも"}, {"type": "subtitle", "time": 5388.59, "timestamp": "01:29:48", "text": "ストリーム、私は自分が"}, {"type": "subtitle", "time": 5397.99, "timestamp": "01:29:57", "text": "そこには。間違いなく数時間使うことができます"}]
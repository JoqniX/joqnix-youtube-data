[{"type": "subtitle", "time": 5822.31, "timestamp": "01:37:02", "text": "えっと、今日の私の優先事項です。そして"}, {"type": "subtitle", "time": 5826.47, "timestamp": "01:37:06", "text": "今日は5時半か6時から音楽の授業があります。"}, {"type": "subtitle", "time": 5828.79, "timestamp": "01:37:08", "text": "それで私は2日間それに対応するつもりです"}, {"type": "subtitle", "time": 5832.95, "timestamp": "01:37:12", "text": "時間。君たちはWモードになるだろう。えっと"}, {"type": "subtitle", "time": 5834.55, "timestamp": "01:37:14", "text": "はい、配信は継続されます。そうなる"}, {"type": "subtitle", "time": 5837.75, "timestamp": "01:37:17", "text": "Wモードで。私も参加します。えっと"}, {"type": "subtitle", "time": 5840.87, "timestamp": "01:37:20", "text": "でも宿題の音楽を提出しなくてはならない"}, {"type": "subtitle", "time": 5843.27, "timestamp": "01:37:23", "text": "プロジェクト関連資料。"}, {"type": "subtitle", "time": 5845.95, "timestamp": "01:37:25", "text": "しかし、私は問題を抱えています"}, {"type": "subtitle", "time": 5849.03, "timestamp": "01:37:29", "text": "エイブルトン。もう一つのものを買わなければならない。"}, {"type": "subtitle", "time": 5851.149, "timestamp": "01:37:31", "text": "私はお金がない"}, {"type": "subtitle", "time": 5860.07, "timestamp": "01:37:40", "text": "壊れた。海賊というよりは、"}, {"type": "subtitle", "time": 5863.189, "timestamp": "01:37:43", "text": "支払った方が良いのは、"}, {"type": "subtitle", "time": 5865.51, "timestamp": "01:37:45", "text": "レンタル。たった12ヶ月しか経っていないのに、"}, {"type": "subtitle", "time": 5867.83, "timestamp": "01:37:47", "text": "右？あなたはまだ学生ですか、そして私は"}, {"type": "subtitle", "time": 5869.91, "timestamp": "01:37:49", "text": "学校を卒業しましたか？私は私は"}, {"type": "subtitle", "time": 5878.95, "timestamp": "01:37:58", "text": "うん。しかし、ある意味では7月以降は"}]
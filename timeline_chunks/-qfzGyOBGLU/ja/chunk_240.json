[{"type": "subtitle", "time": 14412.95, "timestamp": "04:00:12", "text": "自分。ええ、そうですね。こんにちは、Xさん。ようこそ。"}, {"type": "subtitle", "time": 14414.469, "timestamp": "04:00:14", "text": "いらっしゃいませ。今日はどうやって私を見つけたの？どうやって"}, {"type": "subtitle", "time": 14416.11, "timestamp": "04:00:16", "text": "は"}, {"type": "subtitle", "time": 14421.07, "timestamp": "04:00:21", "text": "あなた？キスしてもいいですか？何？何？"}, {"type": "subtitle", "time": 14424.51, "timestamp": "04:00:24", "text": "はぁ？いいえ。"}, {"type": "subtitle", "time": 14433.99, "timestamp": "04:00:33", "text": "の上。 B、それはうまくいかないよ。ああ神様、なぜ"}, {"type": "subtitle", "time": 14437.229, "timestamp": "04:00:37", "text": "私は無駄にしている？私は「ああ、私は打っている」と思った"}, {"type": "subtitle", "time": 14443.189, "timestamp": "04:00:43", "text": "私のXは本当に良い人です。それで？おお。なぜ？おお"}, {"type": "subtitle", "time": 14449.59, "timestamp": "04:00:49", "text": "神。これは一体何ですか？理解できない"}, {"type": "subtitle", "time": 14455.309, "timestamp": "04:00:55", "text": "良い。ああ、何が"}]
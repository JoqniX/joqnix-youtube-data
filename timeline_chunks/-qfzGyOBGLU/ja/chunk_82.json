[{"type": "subtitle", "time": 4921.79, "timestamp": "01:22:01", "text": "いいえ、まだやっていません"}, {"type": "subtitle", "time": 4924.87, "timestamp": "01:22:04", "text": "まだ。私はクラウドGoogleを使ったことがありません"}, {"type": "subtitle", "time": 4927.79, "timestamp": "01:22:07", "text": "音楽関連のもののために、まだドライブの容量を節約しているところです。"}, {"type": "subtitle", "time": 4931.149, "timestamp": "01:22:11", "text": "ああ、私はOBS関連の用事でしかそこにいないんです"}, {"type": "subtitle", "time": 4946.47, "timestamp": "01:22:26", "text": "はい。微調整しているのは、"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "追跡情報を取得しました。私は文字通り"}, {"type": "subtitle", "time": 4952.83, "timestamp": "01:22:32", "text": "テーブルにだらりと座り、"}, {"type": "subtitle", "time": 4966.27, "timestamp": "01:22:46", "text": "ああ、決めなければならないことが山ほどある。"}, {"type": "subtitle", "time": 4974.709, "timestamp": "01:22:54", "text": "大きい。しかし、一番の問題はお金だ。"}, {"type": "subtitle", "time": 4978.07, "timestamp": "01:22:58", "text": "もしお金があったら、"}]
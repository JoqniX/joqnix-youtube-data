[{"type": "subtitle", "time": 4380.13, "timestamp": "01:13:00", "text": "痛み。ええ、そうです"}, {"type": "subtitle", "time": 4381.63, "timestamp": "01:13:01", "text": "[音楽]"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "私が実際に飲む必要があるのは"}, {"type": "subtitle", "time": 4404.43, "timestamp": "01:13:24", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 4407.59, "timestamp": "01:13:27", "text": "戻る。皆さん、水分補給を忘れないでくださいね。"}, {"type": "subtitle", "time": 4409.95, "timestamp": "01:13:29", "text": "忘れないでください"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "水分補給する。保留中の件数"}, {"type": "subtitle", "time": 4416.47, "timestamp": "01:13:36", "text": "今は狂っている。そして私はこう思った、"}, {"type": "subtitle", "time": 4418.95, "timestamp": "01:13:38", "text": "もうこのことは忘れよう"}, {"type": "subtitle", "time": 4422.63, "timestamp": "01:13:42", "text": "そしてゲームをいくつかプレイすれば、"}, {"type": "subtitle", "time": 4425.87, "timestamp": "01:13:45", "text": "君たちを楽しませたり、"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "何か。しかし、私は時々気づく"}, {"type": "subtitle", "time": 4430.83, "timestamp": "01:13:50", "text": "それ"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "ええ、何のために作られていないのですか"}, {"type": "subtitle", "time": 4436.87, "timestamp": "01:13:56", "text": "あなた？これはただ"}, {"type": "subtitle", "time": 4438.03, "timestamp": "01:13:58", "text": "ドメイン"}]
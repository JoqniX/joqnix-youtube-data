[{"type": "subtitle", "time": 18721.91, "timestamp": "05:12:01", "text": "断片？ああ、私たちができることは"}, {"type": "subtitle", "time": 18724.27, "timestamp": "05:12:04", "text": "もっと焚き火を。私"}, {"type": "subtitle", "time": 18743.47, "timestamp": "05:12:23", "text": "以上。でも、私には見えないんです。"}, {"type": "subtitle", "time": 18747.47, "timestamp": "05:12:27", "text": "では、"}, {"type": "subtitle", "time": 18753.788, "timestamp": "05:12:33", "text": "ここ。はい、彼の配置は"}, {"type": "subtitle", "time": 18758.15, "timestamp": "05:12:38", "text": "終わり。それから石の火が必要"}, {"type": "subtitle", "time": 18760.51, "timestamp": "05:12:40", "text": "家を暖める。"}, {"type": "subtitle", "time": 18774.708, "timestamp": "05:12:54", "text": "男。ああ、土台が必要だ。何てことだ。"}]
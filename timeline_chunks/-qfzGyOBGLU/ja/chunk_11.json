[{"type": "subtitle", "time": 665.59, "timestamp": "00:11:05", "text": "私のメンバーシップに何が起こったか確認してください"}, {"type": "subtitle", "time": 668.75, "timestamp": "00:11:08", "text": "拒否されるか、"}, {"type": "subtitle", "time": 671.35, "timestamp": "00:11:11", "text": "YouTube の人々はレビューしたかもしれないので、"}, {"type": "subtitle", "time": 673.829, "timestamp": "00:11:13", "text": "私の配信で病棟がプレイしているのを見て、"}, {"type": "subtitle", "time": 675.55, "timestamp": "00:11:15", "text": "こんな感じ"}, {"type": "subtitle", "time": 678.71, "timestamp": "00:11:18", "text": "いいえ、彼に会員権を与えることはできません。"}, {"type": "subtitle", "time": 682.35, "timestamp": "00:11:22", "text": "それは起こってほしくないことだ。"}, {"type": "subtitle", "time": 703.63, "timestamp": "00:11:43", "text": "[音楽]"}]
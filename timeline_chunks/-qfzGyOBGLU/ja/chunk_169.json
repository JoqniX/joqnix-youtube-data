[{"type": "subtitle", "time": 10142.389, "timestamp": "02:49:02", "text": "ステレオ。"}, {"type": "subtitle", "time": 10145.71, "timestamp": "02:49:05", "text": "待って。ユーザーインターフェースミュートグローバル"}, {"type": "subtitle", "time": 10149.71, "timestamp": "02:49:09", "text": "チャット。待って、どうやって検閲するの？待って、"}, {"type": "subtitle", "time": 10154.67, "timestamp": "02:49:14", "text": "どのストリーマーモードですか？はい、電源を入れられます"}, {"type": "subtitle", "time": 10159.469, "timestamp": "02:49:19", "text": "その経験。待って、どうやって設定するの？"}, {"type": "subtitle", "time": 10163.87, "timestamp": "02:49:23", "text": "私の出力マイク"}, {"type": "subtitle", "time": 10167.51, "timestamp": "02:49:27", "text": "あれ？ダックのオン/オフ広告を切り替える。自動"}, {"type": "subtitle", "time": 10170.79, "timestamp": "02:49:30", "text": "送信モード。無効になっている場合は挿入します"}, {"type": "subtitle", "time": 10172.75, "timestamp": "02:49:32", "text": "チャットを押すと"}, {"type": "subtitle", "time": 10176.469, "timestamp": "02:49:36", "text": "ボタン。 MIDI入力とは何ですか？ああ、できるよ"}, {"type": "subtitle", "time": 10179.429, "timestamp": "02:49:39", "text": "Rustで曲を演奏する。そうそう。うん。私"}, {"type": "subtitle", "time": 10182.63, "timestamp": "02:49:42", "text": "それは使えます。キーボードを使って"}, {"type": "subtitle", "time": 10184.51, "timestamp": "02:49:44", "text": "ここ。"}, {"type": "subtitle", "time": 10187.95, "timestamp": "02:49:47", "text": "ああ、私はDLCを買ったことを忘れませんでした"}, {"type": "subtitle", "time": 10193.07, "timestamp": "02:49:53", "text": "それ。はい。でも待て、操作方法だ。どのように"}, {"type": "subtitle", "time": 10197.11, "timestamp": "02:49:57", "text": "コミュニケーションに入りますか？"}, {"type": "subtitle", "time": 10198.67, "timestamp": "02:49:58", "text": "プッシュはどこにありますか?"}]
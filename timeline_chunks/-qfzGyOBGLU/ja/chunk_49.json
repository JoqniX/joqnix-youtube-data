[{"type": "subtitle", "time": 2943.109, "timestamp": "00:49:03", "text": "X1ですが、私は"}, {"type": "subtitle", "time": 2945.829, "timestamp": "00:49:05", "text": "左目の色と右目の色。だから私は"}, {"type": "subtitle", "time": 2949.15, "timestamp": "00:49:09", "text": "12 X I を置く"}, {"type": "subtitle", "time": 2952.069, "timestamp": "00:49:12", "text": "私は帽子の方が好きです。ご覧のとおり、"}, {"type": "subtitle", "time": 2954.549, "timestamp": "00:49:14", "text": "アクセサリー。"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "それから青いものと紫のもの。"}, {"type": "subtitle", "time": 2964.03, "timestamp": "00:49:24", "text": "紫またはすみれ色と黒"}, {"type": "subtitle", "time": 2965.29, "timestamp": "00:49:25", "text": "1つ。"}, {"type": "subtitle", "time": 2968.19, "timestamp": "00:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2972.069, "timestamp": "00:49:32", "text": "もちろん。気づいた。ちょっと待って。私は"}, {"type": "subtitle", "time": 2975.99, "timestamp": "00:49:35", "text": "あ、あ、待って。ありがとうございます"}, {"type": "subtitle", "time": 2979.15, "timestamp": "00:49:39", "text": "注目して"}, {"type": "subtitle", "time": 2981.71, "timestamp": "00:49:41", "text": "これ。"}, {"type": "subtitle", "time": 2983.39, "timestamp": "00:49:43", "text": "えっと、"}, {"type": "subtitle", "time": 2987.27, "timestamp": "00:49:47", "text": "待って。私は確認しただろうか？待って、私は"}, {"type": "subtitle", "time": 2990.95, "timestamp": "00:49:50", "text": "新型モデルにはその機能はありますか？私は私は"}, {"type": "subtitle", "time": 2993.39, "timestamp": "00:49:53", "text": "ほとんどのものを移植することになっている"}, {"type": "subtitle", "time": 2996.27, "timestamp": "00:49:56", "text": "ポートしない"}, {"type": "subtitle", "time": 2999.589, "timestamp": "00:49:59", "text": "古いものと同じように、最初のコンセプトは"}]
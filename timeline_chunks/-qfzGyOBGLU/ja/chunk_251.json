[{"type": "subtitle", "time": 15060.59, "timestamp": "04:11:00", "text": "ピックは必要ありません。ええと、"}, {"type": "subtitle", "time": 15063.79, "timestamp": "04:11:03", "text": "手斧。私たちは作ります"}, {"type": "subtitle", "time": 15066.55, "timestamp": "04:11:06", "text": "キャンプファイヤー。建築業者のやつ、これを渡して"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "同じように。ええと、ストレージを作ります"}, {"type": "subtitle", "time": 15078.51, "timestamp": "04:11:18", "text": "良い。"}, {"type": "subtitle", "time": 15104.07, "timestamp": "04:11:44", "text": "ああ、ここはポケモンのメインガレージだ"}, {"type": "subtitle", "time": 15118.83, "timestamp": "04:11:58", "text": "ここ？これは、これは、私が"}]
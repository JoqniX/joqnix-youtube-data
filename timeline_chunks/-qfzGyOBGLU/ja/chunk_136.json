[{"type": "subtitle", "time": 8181.43, "timestamp": "02:16:21", "text": "ああ、あの人たち。わかった。"}, {"type": "subtitle", "time": 8183.109, "timestamp": "02:16:23", "text": "わかった。わかった。それで大丈夫です。わかった。高い"}, {"type": "subtitle", "time": 8184.87, "timestamp": "02:16:24", "text": "学校でのロールプレイング。ロールプレイングはしない。おお、"}, {"type": "subtitle", "time": 8187.109, "timestamp": "02:16:27", "text": "うん。あの4人組のグループ。わかった。"}, {"type": "subtitle", "time": 8189.51, "timestamp": "02:16:29", "text": "わかった。わかった。それです。わかった。"}, {"type": "subtitle", "time": 8191.589, "timestamp": "02:16:31", "text": "彼らは『グランブルー』シーズン2を制作している。"}, {"type": "subtitle", "time": 8217.83, "timestamp": "02:16:57", "text": "ごめん。一体どういうことだ？"}]
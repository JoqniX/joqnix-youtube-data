[{"type": "subtitle", "time": 15307.59, "timestamp": "04:15:07", "text": "おお。ああ、なんて暗いんだ。では、まず"}, {"type": "subtitle", "time": 15308.75, "timestamp": "04:15:08", "text": "そして"}, {"type": "subtitle", "time": 15310.269, "timestamp": "04:15:10", "text": "まず第一に、"}, {"type": "subtitle", "time": 15313.469, "timestamp": "04:15:13", "text": "私たちは"}, {"type": "subtitle", "time": 15317.67, "timestamp": "04:15:17", "text": "今朝ですよね？"}, {"type": "subtitle", "time": 15318.59, "timestamp": "04:15:18", "text": "まず、"}, {"type": "subtitle", "time": 15330.189, "timestamp": "04:15:30", "text": "神。"}, {"type": "subtitle", "time": 15333.309, "timestamp": "04:15:33", "text": "製作。わかった。私の"}, {"type": "subtitle", "time": 15336.03, "timestamp": "04:15:36", "text": "弓？"}, {"type": "subtitle", "time": 15338.71, "timestamp": "04:15:38", "text": "こんにちは。ああ、こっちだよ。わかった。それで、"}, {"type": "subtitle", "time": 15340.87, "timestamp": "04:15:40", "text": "こういうものは捨ててしまいましょう。私"}, {"type": "subtitle", "time": 15342.03, "timestamp": "04:15:42", "text": "必要ない"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "それ。これも投げます。石。"}, {"type": "subtitle", "time": 15346.92, "timestamp": "04:15:46", "text": "石。 石。高品質の鉱石。わかった。何が"}, {"type": "subtitle", "time": 15350.8, "timestamp": "04:15:50", "text": "石。高品質の鉱石。わかった。何が これ？木製のバリケードカバー。わかった。私たちは"}, {"type": "subtitle", "time": 15353.68, "timestamp": "04:15:53", "text": "これ？木製のバリケードカバー。わかった。私たちは 狩猟用の弓を持って行け。私たちはバッグを持って行きます"}, {"type": "subtitle", "time": 15356.239, "timestamp": "04:15:56", "text": "狩猟用の弓を持って行け。私たちはバッグを持って行きます そして包帯。えっと、投げる必要がある"}, {"type": "subtitle", "time": 15359.439, "timestamp": "04:15:59", "text": "そして包帯。えっと、投げる必要がある 荷物をいくつか片付ける。金属製の刃。私は"}]
[{"type": "subtitle", "time": 5961.27, "timestamp": "01:39:21", "text": "ごめん。父が来て、私に"}, {"type": "subtitle", "time": 5965.229, "timestamp": "01:39:25", "text": "朝食。バナナを2本と"}, {"type": "subtitle", "time": 5968.47, "timestamp": "01:39:28", "text": "dsha。 Dshaと2つのDshaと2つのような"}, {"type": "subtitle", "time": 5971.669, "timestamp": "01:39:31", "text": "バナナとパパイヤジュース。わかった、それ"}, {"type": "subtitle", "time": 5974.55, "timestamp": "01:39:34", "text": "私を再生させてくれるかもしれない。それで私は"}, {"type": "subtitle", "time": 5977.35, "timestamp": "01:39:37", "text": "それ。えっと、それで私は言ったんです。そうすれば彼は私を助けてくれるでしょう"}, {"type": "subtitle", "time": 5979.229, "timestamp": "01:39:39", "text": "2,800人"}, {"type": "subtitle", "time": 5981.99, "timestamp": "01:39:41", "text": "明日。えっと、残りの"}, {"type": "subtitle", "time": 5983.79, "timestamp": "01:39:43", "text": "他のお金"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "定期購読料を支払います"}, {"type": "subtitle", "time": 5988.27, "timestamp": "01:39:48", "text": "私が持っているものすべてで"}, {"type": "subtitle", "time": 5991.59, "timestamp": "01:39:51", "text": "左。えっと、今は"}, {"type": "subtitle", "time": 5993.39, "timestamp": "01:39:53", "text": "私が持っているもの"}, {"type": "subtitle", "time": 5997.51, "timestamp": "01:39:57", "text": "左。えっと、じゃあ音楽配信をしましょう"}]
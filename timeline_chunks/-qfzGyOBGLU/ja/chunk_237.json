[{"type": "subtitle", "time": 14227.91, "timestamp": "03:57:07", "text": "死にかけている？ああ、いろいろ持ってるよ。私は手に入れた"}, {"type": "subtitle", "time": 14231.59, "timestamp": "03:57:11", "text": "もの。荷物が届いたよ。はい、どうぞ。さて、私は"}, {"type": "subtitle", "time": 14233.229, "timestamp": "03:57:13", "text": "私はそうしない"}, {"type": "subtitle", "time": 14236.229, "timestamp": "03:57:16", "text": "中毒。夕食は食べたよね？いいえ、私は"}, {"type": "subtitle", "time": 14237.229, "timestamp": "03:57:17", "text": "必要"}, {"type": "subtitle", "time": 14239.71, "timestamp": "03:57:19", "text": "食べる"}, {"type": "subtitle", "time": 14242.15, "timestamp": "03:57:22", "text": "すぐ。ああ、どこかに"}, {"type": "subtitle", "time": 14244.349, "timestamp": "03:57:24", "text": "放射線領域。"}, {"type": "subtitle", "time": 14261.229, "timestamp": "03:57:41", "text": "私たちは、私は"}, {"type": "subtitle", "time": 14273.309, "timestamp": "03:57:53", "text": "わーい。何もない"}]
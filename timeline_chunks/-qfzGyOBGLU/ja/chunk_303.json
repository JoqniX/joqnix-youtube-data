[{"type": "subtitle", "time": 18182.43, "timestamp": "05:03:02", "text": "戻る"}, {"type": "subtitle", "time": 18186.15, "timestamp": "05:03:06", "text": "バッグ。えっと、ホースを待ってください。"}, {"type": "subtitle", "time": 18188.03, "timestamp": "05:03:08", "text": "わかった。"}, {"type": "subtitle", "time": 18192.91, "timestamp": "05:03:12", "text": "いいえ。それも振ってみてください。金属片"}, {"type": "subtitle", "time": 18201.31, "timestamp": "05:03:21", "text": "下。最悪だ。私は失くしました"}, {"type": "subtitle", "time": 18203.67, "timestamp": "05:03:23", "text": "ロープがあって、暗くなってきた。私たちはする必要があります"}, {"type": "subtitle", "time": 18209.708, "timestamp": "05:03:29", "text": "[音楽]"}]
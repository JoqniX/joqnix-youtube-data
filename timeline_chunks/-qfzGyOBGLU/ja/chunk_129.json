[{"type": "subtitle", "time": 7742.95, "timestamp": "02:09:02", "text": "フォートナイト。フォートナイト。それが私の最初の"}, {"type": "subtitle", "time": 7744.55, "timestamp": "02:09:04", "text": "ゲームだけどね。だから私は好きだった"}, {"type": "subtitle", "time": 7796.069, "timestamp": "02:09:56", "text": "何？今すぐ実際の子供を殺したい。"}, {"type": "subtitle", "time": 7799.79, "timestamp": "02:09:59", "text": "今、私は自分が実際に言ったわけではないと分かっています"}]
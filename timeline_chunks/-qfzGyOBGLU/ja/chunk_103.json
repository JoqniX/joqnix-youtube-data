[{"type": "subtitle", "time": 6181.229, "timestamp": "01:43:01", "text": "午前6時に自動的に電源が入ります。"}, {"type": "subtitle", "time": 6184.79, "timestamp": "01:43:04", "text": "シャープはログを自動的に起動します"}, {"type": "subtitle", "time": 6187.03, "timestamp": "01:43:07", "text": "中に、私は削除しなければならないと思います"}, {"type": "subtitle", "time": 6190.07, "timestamp": "01:43:10", "text": "えっと、Windowsのログイン画面のことですね。うん、"}, {"type": "subtitle", "time": 6192.149, "timestamp": "01:43:12", "text": "だって、それが問題だったんだから。"}, {"type": "subtitle", "time": 6195.39, "timestamp": "01:43:15", "text": "でも、電源は入ります。"}, {"type": "subtitle", "time": 6197.91, "timestamp": "01:43:17", "text": "自動的にOBSが開き、"}, {"type": "subtitle", "time": 6199.99, "timestamp": "01:43:19", "text": "ストリーミングアプリなど、すべて。"}, {"type": "subtitle", "time": 6203.43, "timestamp": "01:43:23", "text": "VIPスタジオ、えーとサミー、ストリーマーボード、"}, {"type": "subtitle", "time": 6205.27, "timestamp": "01:43:25", "text": "バックグラウンドですべて、ブラウザ"}, {"type": "subtitle", "time": 6208.149, "timestamp": "01:43:28", "text": "サミの電話に関するもの、すべてが開かれる"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "uh 1 または 2 の不良ファイルにより自動的に"}, {"type": "subtitle", "time": 6216.47, "timestamp": "01:43:36", "text": "打ち上げから数分後。えーと、えーと、始めよう"}, {"type": "subtitle", "time": 6218.51, "timestamp": "01:43:38", "text": "OBSへのストリーミング"}, {"type": "subtitle", "time": 6223.189, "timestamp": "01:43:43", "text": "5分後には。だから65では"}, {"type": "subtitle", "time": 6225.59, "timestamp": "01:43:45", "text": "OBSが起動されたことを検知する。"}, {"type": "subtitle", "time": 6227.75, "timestamp": "01:43:47", "text": "起動したら、「ストリーミングを開始」をクリックしてください。"}, {"type": "subtitle", "time": 6229.669, "timestamp": "01:43:49", "text": "自動的にストリーミングを開始するように"}, {"type": "subtitle", "time": 6232.39, "timestamp": "01:43:52", "text": "この特定の時間。公開されます。それ"}, {"type": "subtitle", "time": 6235.35, "timestamp": "01:43:55", "text": "ロード画面と"}, {"type": "subtitle", "time": 6237.51, "timestamp": "01:43:57", "text": "自動的に話すモードに切り替わります"}]
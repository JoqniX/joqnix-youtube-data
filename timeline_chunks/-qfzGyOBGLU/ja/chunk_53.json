[{"type": "subtitle", "time": 3182.069, "timestamp": "00:53:02", "text": "多くの。でも、でも正直言って、"}, {"type": "subtitle", "time": 3185.67, "timestamp": "00:53:05", "text": "12は偶然の一致で、"}, {"type": "subtitle", "time": 3188.069, "timestamp": "00:53:08", "text": "そんなことが流行るとは思わなかった。"}, {"type": "subtitle", "time": 3191.349, "timestamp": "00:53:11", "text": "でも私の好きな数字は11です。"}, {"type": "subtitle", "time": 3193.99, "timestamp": "00:53:13", "text": "推測。多分。 12でも構わないよ"}, {"type": "subtitle", "time": 3199.109, "timestamp": "00:53:19", "text": "8月11日は私の誕生日だからです。だから私は"}, {"type": "subtitle", "time": 3201.23, "timestamp": "00:53:21", "text": "わからない。私はその数字が結構好きです"}, {"type": "subtitle", "time": 3203.95, "timestamp": "00:53:23", "text": "11. ということで、"}, {"type": "subtitle", "time": 3219.349, "timestamp": "00:53:39", "text": "それ。でも、新しいものには"}, {"type": "subtitle", "time": 3229.47, "timestamp": "00:53:49", "text": "ああ、今ならわかるよ"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "えっと、私が気づいたのは、"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "私は、えーと、より差別化されています"}]
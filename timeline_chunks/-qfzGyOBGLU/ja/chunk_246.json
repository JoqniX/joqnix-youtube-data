[{"type": "subtitle", "time": 14760.59, "timestamp": "04:06:00", "text": "ここ。もう遅い時間だ。私は必要としている"}, {"type": "subtitle", "time": 14763.229, "timestamp": "04:06:03", "text": "私は見つける必要がある"}, {"type": "subtitle", "time": 14783.229, "timestamp": "04:06:23", "text": "質問を表示"}, {"type": "subtitle", "time": 14786.389, "timestamp": "04:06:26", "text": "お尻。どこに電話すればいいですか"}, {"type": "subtitle", "time": 14788.75, "timestamp": "04:06:28", "text": "自宅で"}, {"type": "subtitle", "time": 14790.95, "timestamp": "04:06:30", "text": "シャワー？どういう意味ですか？私はしませんでした"}, {"type": "subtitle", "time": 14798.03, "timestamp": "04:06:38", "text": "シーッ。月。ええ、それは"}, {"type": "subtitle", "time": 14813.15, "timestamp": "04:06:53", "text": "[音楽]"}, {"type": "subtitle", "time": 14815.39, "timestamp": "04:06:55", "text": "遊ぶ"}, {"type": "subtitle", "time": 14818.349, "timestamp": "04:06:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 12663.309, "timestamp": "03:31:03", "text": "神。感謝"}, {"type": "subtitle", "time": 12667.67, "timestamp": "03:31:07", "text": "あなた。待って、待って。何？えっと、"}, {"type": "subtitle", "time": 12676.07, "timestamp": "03:31:16", "text": "HP。ああ、ありがとうございます。待って、君ならできるよ"}, {"type": "subtitle", "time": 12678.03, "timestamp": "03:31:18", "text": "このゲームでは。"}, {"type": "subtitle", "time": 12680.63, "timestamp": "03:31:20", "text": "おお。ありがとう。本当にありがとうございました。"}, {"type": "subtitle", "time": 12682.79, "timestamp": "03:31:22", "text": "えっと、何か欲しいものある？いくつか持っています"}, {"type": "subtitle", "time": 12685.67, "timestamp": "03:31:25", "text": "スクラップや金属くず。届けます"}, {"type": "subtitle", "time": 12692.349, "timestamp": "03:31:32", "text": "それ。えっと、スクラップ。はい、わかりました。"}, {"type": "subtitle", "time": 12695.71, "timestamp": "03:31:35", "text": "待って。えっと、これ"}, {"type": "subtitle", "time": 12703.15, "timestamp": "03:31:43", "text": "待って。いいえ、違います"}, {"type": "subtitle", "time": 12715.71, "timestamp": "03:31:55", "text": "これ。私は"}, {"type": "subtitle", "time": 12718.349, "timestamp": "03:31:58", "text": "迷路。"}]
[{"type": "subtitle", "time": 9600.79, "timestamp": "02:40:00", "text": "去った。えーと、神話みたいな、頭蓋骨のヘルメット"}, {"type": "subtitle", "time": 9604.27, "timestamp": "02:40:04", "text": "消えてしまった。全てが消え去った。"}, {"type": "subtitle", "time": 9607.07, "timestamp": "02:40:07", "text": "なぜ？何が"}, {"type": "subtitle", "time": 9610.63, "timestamp": "02:40:10", "text": "料金？例えば、私が私のところに行くと、"}, {"type": "subtitle", "time": 9614.23, "timestamp": "02:40:14", "text": "私の滴、何滴かお見せします"}, {"type": "subtitle", "time": 9616.59, "timestamp": "02:40:16", "text": "えっと、半分しかない"}, {"type": "subtitle", "time": 9620.309, "timestamp": "02:40:20", "text": "それ。ええと、もし私が今いる場所で見つけられれば。"}, {"type": "subtitle", "time": 9622.95, "timestamp": "02:40:22", "text": "うん。ポケモンガレージはここです。"}, {"type": "subtitle", "time": 9625.95, "timestamp": "02:40:25", "text": "それからホームレスの戦闘用覆い"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "パーカー。ミットの胸当て。だからそうではなかった"}, {"type": "subtitle", "time": 9631.91, "timestamp": "02:40:31", "text": "ヘルメット。ジャック・セプティカ貯蔵庫。負けました"}, {"type": "subtitle", "time": 9633.63, "timestamp": "02:40:33", "text": "それは"}, {"type": "subtitle", "time": 9638.07, "timestamp": "02:40:38", "text": "良い。リリージャケット。私は失った 私は愛している"}, {"type": "subtitle", "time": 9641.59, "timestamp": "02:40:41", "text": "ジャケットだったんだけど、なくしちゃった。"}, {"type": "subtitle", "time": 9644.55, "timestamp": "02:40:44", "text": "もしあの時このゲームを持っていたら"}, {"type": "subtitle", "time": 9648.469, "timestamp": "02:40:48", "text": "数年前、オフラインTVの錆び"}, {"type": "subtitle", "time": 9651.349, "timestamp": "02:40:51", "text": "えっと、何かが起こっていて、私は主張できたかもしれない"}, {"type": "subtitle", "time": 9653.99, "timestamp": "02:40:53", "text": "これら。うん。こんにちは、タイガランさん。あなたが"}, {"type": "subtitle", "time": 9655.71, "timestamp": "02:40:55", "text": "順調です。調子はどうですか"}]
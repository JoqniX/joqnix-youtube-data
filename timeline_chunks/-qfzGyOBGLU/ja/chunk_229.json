[{"type": "subtitle", "time": 13742.229, "timestamp": "03:49:02", "text": "肉。その代わりに、私は自分の武器を投げた。"}, {"type": "subtitle", "time": 13744.51, "timestamp": "03:49:04", "text": "武器"}, {"type": "subtitle", "time": 13747.87, "timestamp": "03:49:07", "text": "つまり、私たち全員が使える"}, {"type": "subtitle", "time": 13752.03, "timestamp": "03:49:12", "text": "これ。うん。こんにちは、タイガー。いらっしゃいませ。"}, {"type": "subtitle", "time": 13756.11, "timestamp": "03:49:16", "text": "いらっしゃいませ。いらっしゃいませ。いらっしゃいませ。どうやって"}, {"type": "subtitle", "time": 13758.95, "timestamp": "03:49:18", "text": "何をしているの？今日はどうやって私を見つけたの？私"}, {"type": "subtitle", "time": 13760.83, "timestamp": "03:49:20", "text": "あなたはここに来たばかりだと思います。"}, {"type": "subtitle", "time": 13778.99, "timestamp": "03:49:38", "text": "だから、木材を探さなければならない。"}, {"type": "subtitle", "time": 13795.59, "timestamp": "03:49:55", "text": "えっと、あそこに何かあります。え、何？何"}, {"type": "subtitle", "time": 13798.71, "timestamp": "03:49:58", "text": "これですか？テーブル。"}]
[{"type": "subtitle", "time": 1967.47, "timestamp": "00:32:47", "text": "マックス・ファンさん、こんにちは。ようこそ。温かい良い"}, {"type": "subtitle", "time": 1969.59, "timestamp": "00:32:49", "text": "朝。良い一日をお過ごしください。"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "ありがとう。あなたも。素晴らしい素晴らしい"}, {"type": "subtitle", "time": 1979.07, "timestamp": "00:32:59", "text": "ダウンロードの"}]
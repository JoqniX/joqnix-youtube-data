[{"type": "subtitle", "time": 16385.269, "timestamp": "04:33:05", "text": "1,000 ウッド アス。わかった。私はこれらを信じます"}, {"type": "subtitle", "time": 16388.15, "timestamp": "04:33:08", "text": "木材は再生する。また、お酒を飲んでもいいですか？"}, {"type": "subtitle", "time": 16408.869, "timestamp": "04:33:28", "text": "湖？はい、お酒は飲めます。ああ、私は"}, {"type": "subtitle", "time": 16411.429, "timestamp": "04:33:31", "text": "後ろのポケットみたいなやつ。ああ、そうすべきだ"}, {"type": "subtitle", "time": 16414.23, "timestamp": "04:33:34", "text": "次回はそれも持ってきてください。"}, {"type": "subtitle", "time": 16417.75, "timestamp": "04:33:37", "text": "よし、じゃあ2つ作ってみよう"}, {"type": "subtitle", "time": 16427.109, "timestamp": "04:33:47", "text": "ドア。 30秒で完了します。わかりました、それまで"}]
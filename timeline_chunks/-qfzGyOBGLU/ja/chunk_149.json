[{"type": "subtitle", "time": 8941.349, "timestamp": "02:29:01", "text": "どうやらブラッド・バカがハッキングしたらしい"}, {"type": "subtitle", "time": 8944.469, "timestamp": "02:29:04", "text": "何か。私は何なのか分かっていると思う"}, {"type": "subtitle", "time": 8947.429, "timestamp": "02:29:07", "text": "起こった。私は待つ。だからさっきはこうだった"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "サポート担当者と話す。うん。こんにちは"}, {"type": "subtitle", "time": 8953.19, "timestamp": "02:29:13", "text": "うん、アディティ。皆さん、お元気ですか？それで"}, {"type": "subtitle", "time": 8955.75, "timestamp": "02:29:15", "text": "ええ、先ほどUbisoftに連絡が取れました"}, {"type": "subtitle", "time": 8958.309, "timestamp": "02:29:18", "text": "サポートと彼らは"}, {"type": "subtitle", "time": 8959.75, "timestamp": "02:29:19", "text": "えっと、私の友達リクエストにアクセスできましたか？"}, {"type": "subtitle", "time": 8962.309, "timestamp": "02:29:22", "text": "無料。まだ持っていません、持っていなければなりません"}, {"type": "subtitle", "time": 8965.67, "timestamp": "02:29:25", "text": "フリーファイアをもう一度ダウンロードしてください。そうですね、希望"}, {"type": "subtitle", "time": 8969.59, "timestamp": "02:29:29", "text": "あなたはよくやっています。それで、連絡しました"}, {"type": "subtitle", "time": 8971.67, "timestamp": "02:29:31", "text": "サポートして、彼らが何て言ったか聞いてみて"}, {"type": "subtitle", "time": 8974.87, "timestamp": "02:29:34", "text": "残念ながら、どうすることもできません。私は"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "Epic Gamesで購入した際の領収書を渡しました"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "レインボーシックス シージ。それは何の役にも立たなかった。"}, {"type": "subtitle", "time": 8983.03, "timestamp": "02:29:43", "text": "彼らは「ええ、彼らは私の"}, {"type": "subtitle", "time": 8985.429, "timestamp": "02:29:45", "text": "回復のリクエストと"}, {"type": "subtitle", "time": 8987.309, "timestamp": "02:29:47", "text": "「あれこれ」私はこう思う。"}, {"type": "subtitle", "time": 8989.99, "timestamp": "02:29:49", "text": "\"何？\"そして、新しいアカウントを作成しました"}, {"type": "subtitle", "time": 8992.11, "timestamp": "02:29:52", "text": "そして推測"}]
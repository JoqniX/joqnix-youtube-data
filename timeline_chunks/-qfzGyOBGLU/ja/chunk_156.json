[{"type": "subtitle", "time": 9360.87, "timestamp": "02:36:00", "text": "エピックゲームズ。もしあなたがまだ請求していないなら"}, {"type": "subtitle", "time": 9363.03, "timestamp": "02:36:03", "text": "それは、あなたが請求できます。"}, {"type": "subtitle", "time": 9366.07, "timestamp": "02:36:06", "text": "ええと、私はゲームプレイを見ました"}, {"type": "subtitle", "time": 9368.309, "timestamp": "02:36:08", "text": "それの。とても美味しいです。待ちきれない。そして"}, {"type": "subtitle", "time": 9372.309, "timestamp": "02:36:12", "text": "富士山は本当にいいですね、えっと、"}, {"type": "subtitle", "time": 9375.75, "timestamp": "02:36:15", "text": "それって何？アディアル、ゲーム。アディアル。彼は好きだ"}, {"type": "subtitle", "time": 9378.07, "timestamp": "02:36:18", "text": "アダルはそういうゲームをする。彼はたくさん演奏します"}, {"type": "subtitle", "time": 9380.15, "timestamp": "02:36:20", "text": "雷とかそういう類。だから、待ちきれない。"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "うん。どうやらこのコラボレーションは"}, {"type": "subtitle", "time": 9384.469, "timestamp": "02:36:24", "text": "先週の金曜日のはずだったのですが、"}, {"type": "subtitle", "time": 9387.429, "timestamp": "02:36:27", "text": "追加するのを忘れていました。私はしたくない"}, {"type": "subtitle", "time": 9389.59, "timestamp": "02:36:29", "text": "私がうっかりやってしまったのと同じことをする"}, {"type": "subtitle", "time": 9391.67, "timestamp": "02:36:31", "text": "自転車の最前線で富士のように"}, {"type": "subtitle", "time": 9394.309, "timestamp": "02:36:34", "text": "コラボで彼について言及するのを忘れてしまった"}, {"type": "subtitle", "time": 9397.429, "timestamp": "02:36:37", "text": "スケジュールは、今回は"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "できる。でも、楽しみです"}, {"type": "subtitle", "time": 9403.95, "timestamp": "02:36:43", "text": "土曜日のコラボレーション。それでは、"}, {"type": "subtitle", "time": 9407.349, "timestamp": "02:36:47", "text": "最高。えっと、忘れてたんだけど、"}, {"type": "subtitle", "time": 9410.79, "timestamp": "02:36:50", "text": "えっと、Q&Aを残すのを忘れてしまいました"}, {"type": "subtitle", "time": 9413.75, "timestamp": "02:36:53", "text": "あれ。有効にしましょう。ちょっとまって。させて"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "Q&Aを有効にして質問できるようにします"}, {"type": "subtitle", "time": 9418.51, "timestamp": "02:36:58", "text": "質問"}]
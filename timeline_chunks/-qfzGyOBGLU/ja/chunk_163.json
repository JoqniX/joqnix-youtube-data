[{"type": "subtitle", "time": 9782.23, "timestamp": "02:43:02", "text": "私が持っているOBSのほとんどは"}, {"type": "subtitle", "time": 9784.03, "timestamp": "02:43:04", "text": "プラグインが多すぎます。だから、私は"}, {"type": "subtitle", "time": 9787.11, "timestamp": "02:43:07", "text": "バニラ。バニラとは新鮮なオブジェを意味します。しかし"}, {"type": "subtitle", "time": 9790.469, "timestamp": "02:43:10", "text": "しかし、それだけでは十分ではないだろう。私はしません"}, {"type": "subtitle", "time": 9793.59, "timestamp": "02:43:13", "text": "知る。でも、やってみることもできるけど、また、"}, {"type": "subtitle", "time": 9795.469, "timestamp": "02:43:15", "text": "に"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "えっと、何かを漏らさないように気をつけてください。"}, {"type": "subtitle", "time": 9801.51, "timestamp": "02:43:21", "text": "特にメールとかそういう類のもの。もし"}, {"type": "subtitle", "time": 9804.67, "timestamp": "02:43:24", "text": "これは私の公式メールアドレスです。"}, {"type": "subtitle", "time": 9807.59, "timestamp": "02:43:27", "text": "大丈夫、私の連絡先メールアドレスだから"}, {"type": "subtitle", "time": 9809.87, "timestamp": "02:43:29", "text": "同様に、"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "チャンネル、それで大丈夫です。その他その他"}, {"type": "subtitle", "time": 9815.19, "timestamp": "02:43:35", "text": "もの。それは良くない。そして私は忘れていました"}, {"type": "subtitle", "time": 9820.99, "timestamp": "02:43:40", "text": "えーっと、あれをやって。 1秒。おい、これ聞いてくれ"}, {"type": "subtitle", "time": 9823.309, "timestamp": "02:43:43", "text": "終わり。"}, {"type": "subtitle", "time": 9825.91, "timestamp": "02:43:45", "text": "インスタグラム。まだ午後10時だ。私にとって。"}, {"type": "subtitle", "time": 9827.349, "timestamp": "02:43:47", "text": "そして、なんと！どうしたの？何"}, {"type": "subtitle", "time": 9830.19, "timestamp": "02:43:50", "text": "何が起こったのか？ナン、気になるわ。何"}, {"type": "subtitle", "time": 9831.71, "timestamp": "02:43:51", "text": "何が起こったのか？"}, {"type": "subtitle", "time": 9834.429, "timestamp": "02:43:54", "text": "おお、"}]
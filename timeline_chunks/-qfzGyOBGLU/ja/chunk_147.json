[{"type": "subtitle", "time": 8821.99, "timestamp": "02:27:01", "text": "あと、今すぐ自分自身をリフレッシュしてリセットする必要がある。"}, {"type": "subtitle", "time": 8824.79, "timestamp": "02:27:04", "text": "ちょっと昼寝してきます。わかった、"}, {"type": "subtitle", "time": 8831.51, "timestamp": "02:27:11", "text": "体をリセットする必要がある。私はそうは思わない"}, {"type": "subtitle", "time": 8835.15, "timestamp": "02:27:15", "text": "ここに長くいるべきではない、"}, {"type": "subtitle", "time": 8845.19, "timestamp": "02:27:25", "text": "重要だ。なぜ私はカップルのように感じるのか"}, {"type": "subtitle", "time": 8849.03, "timestamp": "02:27:29", "text": "WSからの単語の単語は、"}, {"type": "subtitle", "time": 8875.27, "timestamp": "02:27:55", "text": "まるで最初からやり直しているみたいだ"}, {"type": "subtitle", "time": 8877.75, "timestamp": "02:27:57", "text": "そして私はいつもいつも入らなければならない"}]
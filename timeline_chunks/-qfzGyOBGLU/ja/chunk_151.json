[{"type": "subtitle", "time": 9061.349, "timestamp": "02:31:01", "text": "見て。いや、待って。見えますか？待って、"}, {"type": "subtitle", "time": 9068.23, "timestamp": "02:31:08", "text": "18. 彼らはユーザー名を変更しなかった。"}, {"type": "subtitle", "time": 9071.51, "timestamp": "02:31:11", "text": "彼らは私のアバターを変更しませんでした。彼らはこれ"}, {"type": "subtitle", "time": 9075.67, "timestamp": "02:31:15", "text": "メールアドレスなどを変更しただけです。だから私は"}, {"type": "subtitle", "time": 9079.19, "timestamp": "02:31:19", "text": "サポートに連絡したところ、少なくとも"}, {"type": "subtitle", "time": 9080.95, "timestamp": "02:31:20", "text": "彼らに尋ねた、せめて私に"}, {"type": "subtitle", "time": 9083.99, "timestamp": "02:31:23", "text": "復旧するために使用したメールアドレス"}, {"type": "subtitle", "time": 9087.51, "timestamp": "02:31:27", "text": "自分でやります。彼らは私にメールを送ってくれた"}, {"type": "subtitle", "time": 9090.309, "timestamp": "02:31:30", "text": "最初の文字をaとして、"}, {"type": "subtitle", "time": 9095.07, "timestamp": "02:31:35", "text": "最後の文字は six@gmail.com です。私は"}, {"type": "subtitle", "time": 9100.07, "timestamp": "02:31:40", "text": "何？何？私はメールを一切作成しません"}, {"type": "subtitle", "time": 9103.59, "timestamp": "02:31:43", "text": "キャラクターAとキャラクターのセックス"}, {"type": "subtitle", "time": 9106.309, "timestamp": "02:31:46", "text": "終わり。もしそれがアクィナの記述であれば、"}, {"type": "subtitle", "time": 9109.11, "timestamp": "02:31:49", "text": "エクシアとしてマークされます"}, {"type": "subtitle", "time": 9113.99, "timestamp": "02:31:53", "text": "アカウント。いいえ、絶対にそんなことはしません。"}, {"type": "subtitle", "time": 9116.71, "timestamp": "02:31:56", "text": "自分の Jocknik アカウントを使用する"}]
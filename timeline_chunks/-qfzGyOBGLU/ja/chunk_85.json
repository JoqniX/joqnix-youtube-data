[{"type": "subtitle", "time": 5102.87, "timestamp": "01:25:02", "text": "2,800。うん。だから私は"}, {"type": "subtitle", "time": 5105.229, "timestamp": "01:25:05", "text": "言っていた。問題点"}, {"type": "subtitle", "time": 5107.59, "timestamp": "01:25:07", "text": "あ、待って。なぜ私はMinecraftを持っているのか"}, {"type": "subtitle", "time": 5108.59, "timestamp": "01:25:08", "text": "もの"}, {"type": "subtitle", "time": 5112.87, "timestamp": "01:25:12", "text": "ここ？問題は、あなたの銀行残高が"}, {"type": "subtitle", "time": 5115.83, "timestamp": "01:25:15", "text": "存在しないか、銀行の問題が発生した場合、"}, {"type": "subtitle", "time": 5118.39, "timestamp": "01:25:18", "text": "他に方法はないのですか？"}, {"type": "subtitle", "time": 5120.35, "timestamp": "01:25:20", "text": "支払いのように"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "31.17ドルですよね？なぜなら、あなたが"}, {"type": "subtitle", "time": 5126.47, "timestamp": "01:25:26", "text": "Stripeなどを利用する場合、"}, {"type": "subtitle", "time": 5128.35, "timestamp": "01:25:28", "text": "彼らはあなたに支払うように言います"}, {"type": "subtitle", "time": 5131.75, "timestamp": "01:25:31", "text": "342ドル。そんなに多くは持っていません。"}, {"type": "subtitle", "time": 5135.75, "timestamp": "01:25:35", "text": "31.7ドルだけ支払えばいいんですよね？"}, {"type": "subtitle", "time": 5139.35, "timestamp": "01:25:39", "text": "だから、私は、"}, {"type": "subtitle", "time": 5143.99, "timestamp": "01:25:43", "text": "それを受け取ってください。これはたった31.17しかかかりません"}, {"type": "subtitle", "time": 5145.709, "timestamp": "01:25:45", "text": "私の"}, {"type": "subtitle", "time": 5148.65, "timestamp": "01:25:48", "text": "銀行。もしそうならなければ、私は終わりだ。"}, {"type": "subtitle", "time": 5150.91, "timestamp": "01:25:50", "text": "[音楽]"}]
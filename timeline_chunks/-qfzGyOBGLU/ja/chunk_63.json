[{"type": "subtitle", "time": 3782.549, "timestamp": "01:03:02", "text": "私には、文字通りただ"}, {"type": "subtitle", "time": 3783.95, "timestamp": "01:03:03", "text": "する"}, {"type": "subtitle", "time": 3791.069, "timestamp": "01:03:11", "text": "今。"}, {"type": "subtitle", "time": 3795.029, "timestamp": "01:03:15", "text": "3,400には最低残高もあります"}, {"type": "subtitle", "time": 3796.029, "timestamp": "01:03:16", "text": "もの。"}, {"type": "subtitle", "time": 3800.47, "timestamp": "01:03:20", "text": "えっと、ちょっと待って、計算しないといけない"}, {"type": "subtitle", "time": 3803.069, "timestamp": "01:03:23", "text": "費用"}, {"type": "subtitle", "time": 3807.15, "timestamp": "01:03:27", "text": "男、そしてそれは私がこれをやっているチャではない"}, {"type": "subtitle", "time": 3809.75, "timestamp": "01:03:29", "text": "たとえ何が起きても私は"}, {"type": "subtitle", "time": 3811.39, "timestamp": "01:03:31", "text": "確かにお金は"}, {"type": "subtitle", "time": 3814.95, "timestamp": "01:03:34", "text": "あなたたちから安全に、どんなお金でも"}, {"type": "subtitle", "time": 3818.39, "timestamp": "01:03:38", "text": "みんな、私たちにサポートをください"}, {"type": "subtitle", "time": 3820.39, "timestamp": "01:03:40", "text": "ジョアソンは安全であることを確認します"}, {"type": "subtitle", "time": 3821.309, "timestamp": "01:03:41", "text": "しないで"}]
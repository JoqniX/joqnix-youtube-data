[{"type": "subtitle", "time": 14903.269, "timestamp": "04:08:23", "text": "ここ。水樽。待って、待って、待って。"}, {"type": "subtitle", "time": 14906.79, "timestamp": "04:08:26", "text": "これは何ですか？低品質燃料。ああ、私は"}, {"type": "subtitle", "time": 14909.349, "timestamp": "04:08:29", "text": "ただ物を手に入れるだけ？"}, {"type": "subtitle", "time": 14912.55, "timestamp": "04:08:32", "text": "適切な容器。何てことだ。"}, {"type": "subtitle", "time": 14918.189, "timestamp": "04:08:38", "text": "容器？"}, {"type": "subtitle", "time": 14921.63, "timestamp": "04:08:41", "text": "容器。これは何ですか？水"}, {"type": "subtitle", "time": 14924.99, "timestamp": "04:08:44", "text": "戦い。ガラス。"}, {"type": "subtitle", "time": 14928.03, "timestamp": "04:08:48", "text": "カップはありません。"}]
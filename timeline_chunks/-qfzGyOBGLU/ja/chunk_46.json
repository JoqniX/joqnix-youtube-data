[{"type": "subtitle", "time": 2766.15, "timestamp": "00:46:06", "text": "パリッとした食感なので、私は自分のものが欲しいです。"}, {"type": "subtitle", "time": 2768.47, "timestamp": "00:46:08", "text": "音声関連のもの。渡りたくない"}, {"type": "subtitle", "time": 2778.03, "timestamp": "00:46:18", "text": "消音器。はい、確認してみます"}, {"type": "subtitle", "time": 2779.79, "timestamp": "00:46:19", "text": "今"}, {"type": "subtitle", "time": 2781.14, "timestamp": "00:46:21", "text": "設定と"}, {"type": "subtitle", "time": 2787.23, "timestamp": "00:46:27", "text": "ビデオ。理解できない"}, {"type": "subtitle", "time": 2791.19, "timestamp": "00:46:31", "text": "これ。どうですか？"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "音声が逆になっているのはどういうことですか？"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "えっ？そうそう。次にエコーキャンセレーションを行います。"}, {"type": "subtitle", "time": 2818.47, "timestamp": "00:46:58", "text": "ああ、電源が切れてる。ええ、エコーキャンセレーションですね。"}]
[{"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "これは何ですか？入力。燃料投入量。何？"}, {"type": "subtitle", "time": 11007.19, "timestamp": "03:03:27", "text": "もの？はい、どうぞ。私たちには光がある。これ"}, {"type": "subtitle", "time": 11025.15, "timestamp": "03:03:45", "text": "それは水ですか"}, {"type": "subtitle", "time": 11029.389, "timestamp": "03:03:49", "text": "良い。私はこれを飲むのに使えます。感謝"}]
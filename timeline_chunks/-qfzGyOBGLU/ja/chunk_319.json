[{"type": "subtitle", "time": 19141.51, "timestamp": "05:19:01", "text": "えっと、いくつか残念なことが起こりました"}, {"type": "subtitle", "time": 19146.628, "timestamp": "05:19:06", "text": "今日。 Ubisoftのアカウントを完全に失ってしまいました。"}, {"type": "subtitle", "time": 19148.47, "timestamp": "05:19:08", "text": "サポートに連絡しましたが、彼らは"}, {"type": "subtitle", "time": 19150.47, "timestamp": "05:19:10", "text": "アカウントを取り戻すのを手伝ってください。"}, {"type": "subtitle", "time": 19154.15, "timestamp": "05:19:14", "text": "彼らは私にヒントをくれた、マスター、マスター"}, {"type": "subtitle", "time": 19157.67, "timestamp": "05:19:17", "text": "私のアカウントJocknikのメール"}, {"type": "subtitle", "time": 19160.788, "timestamp": "05:19:20", "text": "アカウントにリンクされていたメールアドレス"}, {"type": "subtitle", "time": 19163.47, "timestamp": "05:19:23", "text": "どうやら誰かがハッキングしたらしい"}, {"type": "subtitle", "time": 19167.03, "timestamp": "05:19:27", "text": "それ。それは私が教えたメールアドレスではありません。"}, {"type": "subtitle", "time": 19169.83, "timestamp": "05:19:29", "text": "だから私は忘れられなかった"}, {"type": "subtitle", "time": 19172.628, "timestamp": "05:19:32", "text": "パスワードのやつをなくしてしまって、"}, {"type": "subtitle", "time": 19175.03, "timestamp": "05:19:35", "text": "全く役に立たない。私はさらに"}, {"type": "subtitle", "time": 19178.868, "timestamp": "05:19:38", "text": "私はレインボーを買ったのですが"}, {"type": "subtitle", "time": 19181.27, "timestamp": "05:19:41", "text": "Epic Gamesで配信中の『Six Siege』。私はさらに提供しました"}, {"type": "subtitle", "time": 19185.55, "timestamp": "05:19:45", "text": "彼らにはどうすることもできない。私は"}, {"type": "subtitle", "time": 19199.67, "timestamp": "05:19:59", "text": "自分。新しいアカウントを作成しなければならなかったので"}]
[{"type": "subtitle", "time": 9000.55, "timestamp": "02:30:00", "text": "次は自分のレベル18です。待って、見せてあげる"}, {"type": "subtitle", "time": 9007.87, "timestamp": "02:30:07", "text": "待って、何が起こったの？そう、Candexは"}, {"type": "subtitle", "time": 9010.87, "timestamp": "02:30:10", "text": "誰かが私をハッキングしたか、"}, {"type": "subtitle", "time": 9013.349, "timestamp": "02:30:13", "text": "何か。それは私の"}, {"type": "subtitle", "time": 9015.99, "timestamp": "02:30:15", "text": "ブラウザのクッキーが漏洩または盗まれた"}, {"type": "subtitle", "time": 9018.469, "timestamp": "02:30:18", "text": "何らかのソフトウェアか何かによって、一部が上書きされる。"}, {"type": "subtitle", "time": 9022.389, "timestamp": "02:30:22", "text": "そして私はたくさんのお金を失いました"}, {"type": "subtitle", "time": 9025.11, "timestamp": "02:30:25", "text": "Googleアカウントのようなアカウント"}, {"type": "subtitle", "time": 9027.59, "timestamp": "02:30:27", "text": "考え。しかしどうやらそのガキは"}, {"type": "subtitle", "time": 9030.79, "timestamp": "02:30:30", "text": "バッカ・ブラットは実際に私のものも奪った"}, {"type": "subtitle", "time": 9033.91, "timestamp": "02:30:33", "text": "何らかの理由でUbisoftの操作ができない。私"}, {"type": "subtitle", "time": 9036.469, "timestamp": "02:30:36", "text": "理由は分かりません。ええ、ご覧のとおりです"}, {"type": "subtitle", "time": 9039.91, "timestamp": "02:30:39", "text": "これはUbisoftの新しいアカウントです"}, {"type": "subtitle", "time": 9042.99, "timestamp": "02:30:42", "text": "接続する。暗闇でも見える"}, {"type": "subtitle", "time": 9047.67, "timestamp": "02:30:47", "text": "XAX on Xia。そうですね、もし私が"}, {"type": "subtitle", "time": 9049.469, "timestamp": "02:30:49", "text": "中へ"}, {"type": "subtitle", "time": 9052.95, "timestamp": "02:30:52", "text": "友達と私が"}, {"type": "subtitle", "time": 9055.15, "timestamp": "02:30:55", "text": "ああ、これは私の"}, {"type": "subtitle", "time": 9056.99, "timestamp": "02:30:56", "text": "アカウント。"}]
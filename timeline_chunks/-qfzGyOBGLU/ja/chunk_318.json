[{"type": "subtitle", "time": 19080.35, "timestamp": "05:18:00", "text": "えっと、私たちが作るか"}, {"type": "subtitle", "time": 19090.99, "timestamp": "05:18:10", "text": "[音楽]"}, {"type": "subtitle", "time": 19101.59, "timestamp": "05:18:21", "text": "ニース。編集作業をしてから寝ようかな。こんにちは、"}, {"type": "subtitle", "time": 19112.91, "timestamp": "05:18:32", "text": "は"}, {"type": "subtitle", "time": 19137.83, "timestamp": "05:18:57", "text": "屋根。あなたはどうですか？元気です。"}, {"type": "subtitle", "time": 19138.83, "timestamp": "05:18:58", "text": "あなたが知っている、"}]
[{"type": "subtitle", "time": 2413.31, "timestamp": "00:40:13", "text": "笑えば負けだ。そして"}, {"type": "subtitle", "time": 2430.31, "timestamp": "00:40:30", "text": "タグとか全部使わないといけないんだ。私"}, {"type": "subtitle", "time": 2438.99, "timestamp": "00:40:38", "text": "物事がどのように機能するのか理解しなければならない"}, {"type": "subtitle", "time": 2441.829, "timestamp": "00:40:41", "text": "今。時々、ちゃんとしたものが欲しいと思う"}, {"type": "subtitle", "time": 2444.99, "timestamp": "00:40:44", "text": "マネージャーまたは手伝ってくれる人"}, {"type": "subtitle", "time": 2453.99, "timestamp": "00:40:53", "text": "高価で、おそらくほとんどの場合"}, {"type": "subtitle", "time": 2456.109, "timestamp": "00:40:56", "text": "私は店長の言うことを聞かない。"}]
[{"type": "subtitle", "time": 8880.429, "timestamp": "02:28:00", "text": "そして相互作用し、"}, {"type": "subtitle", "time": 8886.19, "timestamp": "02:28:06", "text": "いいね、いいね、うん、本当にそうするよ"}, {"type": "subtitle", "time": 8890.349, "timestamp": "02:28:10", "text": "これ。はい、そうです。こんにちは。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 8893.99, "timestamp": "02:28:13", "text": "今日？皆さんお元気でお過ごしでしょうか。自分"}, {"type": "subtitle", "time": 8896.349, "timestamp": "02:28:16", "text": "私は"}, {"type": "subtitle", "time": 8900.19, "timestamp": "02:28:20", "text": "いい日だったけど、ちょっと台無しにしちゃった"}, {"type": "subtitle", "time": 8902.51, "timestamp": "02:28:22", "text": "ほんの数分"}, {"type": "subtitle", "time": 8905.55, "timestamp": "02:28:25", "text": "前。理由と内容を知りたい場合は"}, {"type": "subtitle", "time": 8909.99, "timestamp": "02:28:29", "text": "起こったのは、私がもしあなたがそうだったら"}, {"type": "subtitle", "time": 8911.99, "timestamp": "02:28:31", "text": "前回の配信にも参加していたと思います"}, {"type": "subtitle", "time": 8914.469, "timestamp": "02:28:34", "text": "Ubisoftのアカウントを紛失したことをお話ししました。"}, {"type": "subtitle", "time": 8917.75, "timestamp": "02:28:37", "text": "アカウントですよね？アクセス権を失いました。それで"}, {"type": "subtitle", "time": 8920.23, "timestamp": "02:28:40", "text": "ええ、だからもし私があなたたちが"}, {"type": "subtitle", "time": 8923.429, "timestamp": "02:28:43", "text": "覚えてる？昔はレインボーシックスをプレイしてたよね"}, {"type": "subtitle", "time": 8927.27, "timestamp": "02:28:47", "text": "シージとか他のゲームですよね？ええと、私たちは"}, {"type": "subtitle", "time": 8930.19, "timestamp": "02:28:50", "text": "私たちはレインボーシックス シージをプレイしていました。"}, {"type": "subtitle", "time": 8933.429, "timestamp": "02:28:53", "text": "Hyperscape、Twitch のすべて、そして"}, {"type": "subtitle", "time": 8935.389, "timestamp": "02:28:55", "text": "YouTubeとか、そういうやつだよね？戻って"}, {"type": "subtitle", "time": 8937.07, "timestamp": "02:28:57", "text": "日、"}]
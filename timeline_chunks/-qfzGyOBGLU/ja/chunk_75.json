[{"type": "subtitle", "time": 4501.39, "timestamp": "01:15:01", "text": "開発部分ではない。"}, {"type": "subtitle", "time": 4504.55, "timestamp": "01:15:04", "text": "ええ、つまりUIはCSSのようなもので、"}, {"type": "subtitle", "time": 4508.55, "timestamp": "01:15:08", "text": "右？ CSSみたいなもんだよね？となることによって"}, {"type": "subtitle", "time": 4511.31, "timestamp": "01:15:11", "text": "ウェブ経由で可能になります"}, {"type": "subtitle", "time": 4514.47, "timestamp": "01:15:14", "text": "スタジオ。ウェブスタジオって、あまり使われてないよね。"}, {"type": "subtitle", "time": 4516.35, "timestamp": "01:15:16", "text": "そしてそれが"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "もの。私はコーディングを知りませんし、"}, {"type": "subtitle", "time": 4521.59, "timestamp": "01:15:21", "text": "プログラミングをしたい。だから私は"}, {"type": "subtitle", "time": 4525.31, "timestamp": "01:15:25", "text": "ウェブ以外のことを何かしたい"}, {"type": "subtitle", "time": 4528.07, "timestamp": "01:15:28", "text": "スタジオ。 Web Studioの方が優れている。私は作ることができます"}, {"type": "subtitle", "time": 4529.229, "timestamp": "01:15:29", "text": "無制限"}, {"type": "subtitle", "time": 4533.75, "timestamp": "01:15:33", "text": "ウェブサイトはこちら。でも、額縁だったらよかったのに"}, {"type": "subtitle", "time": 4536.75, "timestamp": "01:15:36", "text": "あるいは何か"}, {"type": "subtitle", "time": 4540.43, "timestamp": "01:15:40", "text": "knowは大幅なアップグレードを受ける予定だよ。のように"}, {"type": "subtitle", "time": 4545.11, "timestamp": "01:15:45", "text": "アニメーション、新しいもの。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "もしくは、Web Studioが"}, {"type": "subtitle", "time": 4551.189, "timestamp": "01:15:51", "text": "アニメーションエンジンとアニメーションのようなもの"}, {"type": "subtitle", "time": 4553.43, "timestamp": "01:15:53", "text": "将来起こる出来事。"}, {"type": "subtitle", "time": 4556.669, "timestamp": "01:15:56", "text": "彼らは現在それに取り組んでいますが"}, {"type": "subtitle", "time": 4559.39, "timestamp": "01:15:59", "text": "ええ、どれくらいの期間"}]
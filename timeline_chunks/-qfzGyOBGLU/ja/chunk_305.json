[{"type": "subtitle", "time": 18300.51, "timestamp": "05:05:00", "text": "うん。使用"}, {"type": "subtitle", "time": 18316.628, "timestamp": "05:05:16", "text": "男が私にくれたライフル"}, {"type": "subtitle", "time": 18323.55, "timestamp": "05:05:23", "text": "それ。"}, {"type": "subtitle", "time": 18326.91, "timestamp": "05:05:26", "text": "ああ、これは何だ"}, {"type": "subtitle", "time": 18330.39, "timestamp": "05:05:30", "text": "春？ああ、金属製のバネを手に入れた。何"}, {"type": "subtitle", "time": 18334.708, "timestamp": "05:05:34", "text": "動きを避けたいのですが"}, {"type": "subtitle", "time": 18337.27, "timestamp": "05:05:37", "text": "物体における抵抗。"}, {"type": "subtitle", "time": 18340.788, "timestamp": "05:05:40", "text": "しかし、本当にこれは必要なのだろうか？分かりません。"}, {"type": "subtitle", "time": 18349.708, "timestamp": "05:05:49", "text": "それ。わかった。私たちの"}, {"type": "subtitle", "time": 18357.39, "timestamp": "05:05:57", "text": "集中。なんてこった。私の"}, {"type": "subtitle", "time": 18359.29, "timestamp": "05:05:59", "text": "家？冗談ですか"}]
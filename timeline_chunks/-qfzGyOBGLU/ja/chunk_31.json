[{"type": "subtitle", "time": 1875.389, "timestamp": "00:31:15", "text": "携帯電話を忘れました。電話"}, {"type": "subtitle", "time": 1879.149, "timestamp": "00:31:19", "text": "リンク。私の"}, {"type": "subtitle", "time": 1881.95, "timestamp": "00:31:21", "text": "電話。リンクが1つ。来て。"}, {"type": "subtitle", "time": 1890.789, "timestamp": "00:31:30", "text": "つまり、問題は私が音楽を作らなければならないということです。"}, {"type": "subtitle", "time": 1899.269, "timestamp": "00:31:39", "text": "私は音楽を作らなければならない。私は持っていません"}]
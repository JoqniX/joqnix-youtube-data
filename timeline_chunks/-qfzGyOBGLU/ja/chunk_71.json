[{"type": "subtitle", "time": 4262.31, "timestamp": "01:11:02", "text": "ルピッシュ。他の2つは850と950くらいです。"}, {"type": "subtitle", "time": 4264.99, "timestamp": "01:11:04", "text": "ではこれは"}, {"type": "subtitle", "time": 4268.91, "timestamp": "01:11:08", "text": "そう、それは宇宙だから"}, {"type": "subtitle", "time": 4271.63, "timestamp": "01:11:11", "text": "ドメインの隣"}, {"type": "subtitle", "time": 4274.39, "timestamp": "01:11:14", "text": "空間。私もそう思ってる"}, {"type": "subtitle", "time": 4275.99, "timestamp": "01:11:15", "text": "ウェブサイトとプロフェッショナルな"}, {"type": "subtitle", "time": 4277.75, "timestamp": "01:11:17", "text": "すべてとこれらのブランディング"}, {"type": "subtitle", "time": 4279.63, "timestamp": "01:11:19", "text": "物事だが、"}, {"type": "subtitle", "time": 4287.03, "timestamp": "01:11:27", "text": "推測。ただ、ただそう願うだけです"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "この圧倒的なものに溺れない"}, {"type": "subtitle", "time": 4290.91, "timestamp": "01:11:30", "text": "深さまたは"}, {"type": "subtitle", "time": 4293.55, "timestamp": "01:11:33", "text": "そんな若い頃に"}, {"type": "subtitle", "time": 4298.59, "timestamp": "01:11:38", "text": "年。私は若い星座だと思う"}, {"type": "subtitle", "time": 4318.87, "timestamp": "01:11:58", "text": "正直に言って止めたい"}]
[{"type": "subtitle", "time": 6665.189, "timestamp": "01:51:05", "text": "これは良いことだ。 D、食べてみて"}, {"type": "subtitle", "time": 6678.79, "timestamp": "01:51:18", "text": "フォーク。日本に行くのにいくらかかりますか？"}, {"type": "subtitle", "time": 6682.109, "timestamp": "01:51:22", "text": "高いです、ラックスのように"}, {"type": "subtitle", "time": 6685.43, "timestamp": "01:51:25", "text": "えっと、私の場合は、アカデミーに行って"}, {"type": "subtitle", "time": 6687.669, "timestamp": "01:51:27", "text": "日本語を学ぼう。私は既に知っています"}, {"type": "subtitle", "time": 6689.669, "timestamp": "01:51:29", "text": "日本語コンテンツなどが含まれています。だから私は"}, {"type": "subtitle", "time": 6691.75, "timestamp": "01:51:31", "text": "リスニング理解力はありますが、"}, {"type": "subtitle", "time": 6694.149, "timestamp": "01:51:34", "text": "文字を学びたいと思っていた"}, {"type": "subtitle", "time": 6699.75, "timestamp": "01:51:39", "text": "右。それで私はアカデミーに通って"}, {"type": "subtitle", "time": 6702.35, "timestamp": "01:51:42", "text": "もの。アカデミーの給料があるんだ"}, {"type": "subtitle", "time": 6705.91, "timestamp": "01:51:45", "text": "コース費用およびそのアカデミーの費用"}, {"type": "subtitle", "time": 6708.55, "timestamp": "01:51:48", "text": "彼ら自身は多くのことを処理します"}, {"type": "subtitle", "time": 6709.55, "timestamp": "01:51:49", "text": "の"}, {"type": "subtitle", "time": 6712.47, "timestamp": "01:51:52", "text": "ドキュメント 日本語 あなたの IRL"}, {"type": "subtitle", "time": 6714.55, "timestamp": "01:51:54", "text": "他のカードと同様に、ドキュメントも正しいです。"}, {"type": "subtitle", "time": 6717.109, "timestamp": "01:51:57", "text": "学校の卒業証書など、その他諸々"}, {"type": "subtitle", "time": 6719.589, "timestamp": "01:51:59", "text": "彼らはそれを日本語に翻訳して送る"}]
[{"type": "subtitle", "time": 8530.389, "timestamp": "02:22:10", "text": "キャラクター。カタフォリオは"}, {"type": "subtitle", "time": 8532.429, "timestamp": "02:22:12", "text": "良い"}, {"type": "subtitle", "time": 8536.55, "timestamp": "02:22:16", "text": "ファンアートを投稿するのに最適です。私は思う"}, {"type": "subtitle", "time": 8543.429, "timestamp": "02:22:23", "text": "それはとても、それほどでもない"}, {"type": "subtitle", "time": 8564.15, "timestamp": "02:22:44", "text": "右？うん。いずれは。はい。はい。はい。"}, {"type": "subtitle", "time": 8576.23, "timestamp": "02:22:56", "text": "キャラクター。ああ、これは私の"}, {"type": "subtitle", "time": 8578.87, "timestamp": "02:22:58", "text": "プロフィール。よし、ファンアートゴンダンがある"}]
[{"type": "subtitle", "time": 17169.59, "timestamp": "04:46:09", "text": "ああ、わかりました。この大きなものを"}, {"type": "subtitle", "time": 17182.23, "timestamp": "04:46:22", "text": "308. ええと、壁は"}, {"type": "subtitle", "time": 17184.708, "timestamp": "04:46:24", "text": "スティック。アップグレードしたら必ずアップグレードしてください"}, {"type": "subtitle", "time": 17188.19, "timestamp": "04:46:28", "text": "待って。棒のような形をした壁。これ"}, {"type": "subtitle", "time": 17195.55, "timestamp": "04:46:35", "text": "[音楽]"}, {"type": "subtitle", "time": 17200.15, "timestamp": "04:46:40", "text": "えっと、ああ、つまり"}]
[{"type": "subtitle", "time": 6842.31, "timestamp": "01:54:02", "text": "家。でも、そういうことは"}, {"type": "subtitle", "time": 6844.07, "timestamp": "01:54:04", "text": "変化。さて、日本に行くときは、"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "実際に外向的になる必要があり、"}, {"type": "subtitle", "time": 6849.91, "timestamp": "01:54:09", "text": "社会性を身につけ、一人で生き抜く。もうない"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "ママ、パパ、誰が私を救ってくれるの？"}, {"type": "subtitle", "time": 6856.629, "timestamp": "01:54:16", "text": "危機を救う。私は最善を尽くさなければならない"}, {"type": "subtitle", "time": 6860.31, "timestamp": "01:54:20", "text": "見知らぬ国で生き残る"}, {"type": "subtitle", "time": 6869.51, "timestamp": "01:54:29", "text": "ああ、それが問題なんです。ええ、日本には"}, {"type": "subtitle", "time": 6872.17, "timestamp": "01:54:32", "text": "より内向的。はい。はい。"}, {"type": "subtitle", "time": 6889.47, "timestamp": "01:54:49", "text": "本当に？彼らにとっては残念なことだ。良い"}, {"type": "subtitle", "time": 6895.669, "timestamp": "01:54:55", "text": "おお。つまり、私がノートパソコンを買ったら"}]
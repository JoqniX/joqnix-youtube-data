[{"type": "subtitle", "time": 12367.83, "timestamp": "03:26:07", "text": "殺す。では、もしそうなら、"}, {"type": "subtitle", "time": 12372.269, "timestamp": "03:26:12", "text": "この場所へ行く"}, {"type": "subtitle", "time": 12375.55, "timestamp": "03:26:15", "text": "ここ。ないことを願う"}, {"type": "subtitle", "time": 12378.309, "timestamp": "03:26:18", "text": "1つ。だから私たちは"}, {"type": "subtitle", "time": 12381.229, "timestamp": "03:26:21", "text": "地下鉄。地下鉄。"}, {"type": "subtitle", "time": 12385.03, "timestamp": "03:26:25", "text": "おお。何てことだ。非常に多くのピースによって。"}, {"type": "subtitle", "time": 12388.269, "timestamp": "03:26:28", "text": "初めて殺されたのは"}, {"type": "subtitle", "time": 12390.83, "timestamp": "03:26:30", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "ああ、まるでマインクラフトみたいだけど"}, {"type": "subtitle", "time": 12410.95, "timestamp": "03:26:50", "text": "生存。"}, {"type": "subtitle", "time": 12413.19, "timestamp": "03:26:53", "text": "物事を行う方法を構築する方法と"}]
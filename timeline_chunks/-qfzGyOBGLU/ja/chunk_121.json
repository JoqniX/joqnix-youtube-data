[{"type": "subtitle", "time": 7260.03, "timestamp": "02:01:00", "text": "いろいろなものをバランスよく"}, {"type": "subtitle", "time": 7290.629, "timestamp": "02:01:30", "text": "天国。言っておくけど、兄弟、逃げるよ"}, {"type": "subtitle", "time": 7293.03, "timestamp": "02:01:33", "text": "ガールフレンドは、たとえ全体に反対しても"}, {"type": "subtitle", "time": 7295.07, "timestamp": "02:01:35", "text": "ハラム"}, {"type": "subtitle", "time": 7296.589, "timestamp": "02:01:36", "text": "イベント。"}, {"type": "subtitle", "time": 7299.91, "timestamp": "02:01:39", "text": "何？私がそんなことをする理由があるだろうか？私の優先事項"}, {"type": "subtitle", "time": 7305.03, "timestamp": "02:01:45", "text": "これは冗談で、私の日本での将来はそうですよね？"}, {"type": "subtitle", "time": 7308.47, "timestamp": "02:01:48", "text": "なんで私がそう思うかって？そうしないといけないんだ、そうしないといけないんだ"}, {"type": "subtitle", "time": 7310.709, "timestamp": "02:01:50", "text": "実際、自分の基準を高く設定しなければならない"}, {"type": "subtitle", "time": 7313.95, "timestamp": "02:01:53", "text": "もし私が基準を下げたら"}, {"type": "subtitle", "time": 7316.55, "timestamp": "02:01:56", "text": "窒息するより、より高い方が良い"}, {"type": "subtitle", "time": 7318.35, "timestamp": "02:01:58", "text": "基準"}]
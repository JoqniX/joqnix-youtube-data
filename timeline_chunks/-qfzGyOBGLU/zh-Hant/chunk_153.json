[{"type": "subtitle", "time": 9184.79, "timestamp": "02:33:04", "text": "我的石頭丟了。"}, {"type": "subtitle", "time": 9187.349, "timestamp": "02:33:07", "text": "決不。  哇，老兄。我現在正在吃"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "炸雞翅。哦，別讓我餓了。  B，你讓我[音樂]餓了。嗯？  這是個"}, {"type": "subtitle", "time": 9207.83, "timestamp": "02:33:27", "text": "陷阱嗎？  這是什麼地方？笨蛋來了。想得到你。如果我們活了下來，沒錯，我們本來可以帶著很多東西"}, {"type": "subtitle", "time": 9210.07, "timestamp": "02:33:30", "text": "回家，可惜了。我的意思是，我還"}, {"type": "subtitle", "time": 9218.95, "timestamp": "02:33:38", "text": "可以回去拿他給"}, {"type": "subtitle", "time": 9229.75, "timestamp": "02:33:49", "text": "我的東西，對吧？你知道嗎？ 至少這樣做比較好。有人"}, {"type": "subtitle", "time": 9232.469, "timestamp": "02:33:52", "text": "專門開店賣這個嗎？"}, {"type": "subtitle", "time": 9235.19, "timestamp": "02:33:55", "text": "什麼？哦，天哪。哦"}]
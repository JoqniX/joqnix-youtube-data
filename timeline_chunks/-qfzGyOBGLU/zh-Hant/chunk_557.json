[{"type": "subtitle", "time": 33434.83, "timestamp": "09:17:14", "text": "哦，這個人當時就在裡面。有個粗魯的人。"}, {"type": "subtitle", "time": 33439.31, "timestamp": "09:17:19", "text": "我的天啊。  好的，我要"}, {"type": "subtitle", "time": 33441.35, "timestamp": "09:17:21", "text": "試試看「尼克斯在哪裡？」我（音樂）死了。慢慢來。別去那裡。"}, {"type": "subtitle", "time": 33443.268, "timestamp": "09:17:23", "text": "好好"}]
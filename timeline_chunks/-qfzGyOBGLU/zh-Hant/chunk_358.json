[{"type": "subtitle", "time": 21488.11, "timestamp": "05:58:08", "text": "你好 ID 哦，天哪，喲，她做了什麼，他做了"}, {"type": "subtitle", "time": 21513.51, "timestamp": "05:58:33", "text": "什麼？俱樂部僅限一家。"}, {"type": "subtitle", "time": 21525.43, "timestamp": "05:58:45", "text": "我的天哪。她做了什麼？是的。等等，等等，等等，等等，等等，等等。夠了。我"}, {"type": "subtitle", "time": 21537.75, "timestamp": "05:58:57", "text": "不需要會員名。等待。"}]
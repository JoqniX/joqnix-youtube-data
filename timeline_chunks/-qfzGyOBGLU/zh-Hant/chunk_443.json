[{"type": "subtitle", "time": 26586.788, "timestamp": "07:23:06", "text": "我不知道。嗯，"}, {"type": "subtitle", "time": 26589.67, "timestamp": "07:23:09", "text": "我不知道"}, {"type": "subtitle", "time": 26591.31, "timestamp": "07:23:11", "text": "。我的冒牌者症候群要發作了"}, {"type": "subtitle", "time": 26594.15, "timestamp": "07:23:14", "text": "。我的天哪。是"}, {"type": "subtitle", "time": 26606.39, "timestamp": "07:23:26", "text": "米茨基。  你好。你好，Mitski。好的。晚安.  好的。另外，我忘了跟大家說晚安。晚上好，札娜。晚上好，克洛諾斯。晚上好，第二位。晚上好，忍者。也祝自己"}, {"type": "subtitle", "time": 26608.91, "timestamp": "07:23:28", "text": "晚安。各位置物櫃晚上好。真是難以置信。"}, {"type": "subtitle", "time": 26626.788, "timestamp": "07:23:46", "text": "我簡直不敢相信，這感覺就像一場"}]
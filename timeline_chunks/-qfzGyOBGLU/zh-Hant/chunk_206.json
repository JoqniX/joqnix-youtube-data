[{"type": "subtitle", "time": 12378.309, "timestamp": "03:26:18", "text": "什麼？煉油廠煮沸油。  哦，步槍槍身。哇。那是什麼？好的。  等待。  呃，有點想扔掉什麼東西。呃，就是那個東西。我不需要它。步槍"}, {"type": "subtitle", "time": 12381.229, "timestamp": "03:26:21", "text": "吊艙。我們就保留這個吧。"}, {"type": "subtitle", "time": 12385.03, "timestamp": "03:26:25", "text": "呃，"}, {"type": "subtitle", "time": 12388.269, "timestamp": "03:26:28", "text": "我應該扔掉哪些東西"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "但這很重要"}, {"type": "subtitle", "time": 12410.95, "timestamp": "03:26:50", "text": "。但是，你知道嗎"}]
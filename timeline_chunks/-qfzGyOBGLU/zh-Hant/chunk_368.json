[{"type": "subtitle", "time": 22084.97, "timestamp": "06:08:04", "text": "等待。  Astron 的名字來自第三位"}, {"type": "subtitle", "time": 22095.91, "timestamp": "06:08:15", "text": "天使。好的。永恆的捨魯比烏姆，守護跨性別者的最高天使。"}, {"type": "subtitle", "time": 22133.07, "timestamp": "06:08:53", "text": "等等，這居然真的有用。這或許可行。這或許可行，夥計們。"}]
[{"type": "subtitle", "time": 13742.229, "timestamp": "03:49:02", "text": "好吧，我來伐木。我們走吧。  ["}, {"type": "subtitle", "time": 13744.51, "timestamp": "03:49:04", "text": "音樂] 什麼？"}, {"type": "subtitle", "time": 13747.87, "timestamp": "03:49:07", "text": "我們有[音樂]。我可以拿走"}, {"type": "subtitle", "time": 13752.03, "timestamp": "03:49:12", "text": "這個[音樂]箱子嗎"}, {"type": "subtitle", "time": 13758.95, "timestamp": "03:49:18", "text": "？好的，我也拿到那個箱子了。我也會變得很強壯。三個強者能得250分。三個強者能得300分。哇"}, {"type": "subtitle", "time": 13795.59, "timestamp": "03:49:55", "text": "呃，一棵中等大小的樹能產多少？ 400. 300."}]
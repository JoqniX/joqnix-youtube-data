[{"type": "subtitle", "time": 41701.426, "timestamp": "11:35:01", "text": "哦，我嚇壞了。"}, {"type": "subtitle", "time": 41705.746, "timestamp": "11:35:05", "text": "媽的。哦，不。我的天啊。我現在正在罵人。我這輩子都"}, {"type": "subtitle", "time": 41708.07, "timestamp": "11:35:08", "text": "不可能做到"}, {"type": "subtitle", "time": 41714.07, "timestamp": "11:35:14", "text": "驚喜了嗎"}, {"type": "subtitle", "time": 41731.83, "timestamp": "11:35:31", "text": "？我的天啊"}, {"type": "subtitle", "time": 41742.63, "timestamp": "11:35:42", "text": "。哦，都怪機器人。都怪機器人。為什麼我"}, {"type": "subtitle", "time": 41748.746, "timestamp": "11:35:48", "text": "要求你工作的時候你卻不工作？都是你的錯"}]
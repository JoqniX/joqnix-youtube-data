[{"type": "subtitle", "time": 14231.59, "timestamp": "03:57:11", "text": "，那首歌叫什麼名字？這是一首日本歌曲。我的天啊。哦，音樂之神。至少"}, {"type": "subtitle", "time": 14236.229, "timestamp": "03:57:16", "text": "我們"}, {"type": "subtitle", "time": 14237.229, "timestamp": "03:57:17", "text": "還能"}, {"type": "subtitle", "time": 14239.71, "timestamp": "03:57:19", "text": "弄到些木頭"}, {"type": "subtitle", "time": 14242.15, "timestamp": "03:57:22", "text": "。我們有動物"}, {"type": "subtitle", "time": 14244.349, "timestamp": "03:57:24", "text": "脂肪之類的東西。"}]
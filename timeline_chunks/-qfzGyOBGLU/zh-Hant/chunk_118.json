[{"type": "subtitle", "time": 7082.83, "timestamp": "01:58:02", "text": "，還是要做好預防措施。  好的。一定要做好預防措施。好的。"}, {"type": "subtitle", "time": 7091.589, "timestamp": "01:58:11", "text": "這樣，"}, {"type": "subtitle", "time": 7094.47, "timestamp": "01:58:14", "text": "你的其他家人或親人就不會感染"}, {"type": "subtitle", "time": 7123.55, "timestamp": "01:58:43", "text": "。你好嗎？  你好嗎？我很好。  我過得還不錯，但也不全是好事，因為我的育碧賬號丟了。"}]
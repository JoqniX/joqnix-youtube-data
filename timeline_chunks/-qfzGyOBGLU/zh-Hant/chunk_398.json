[{"type": "subtitle", "time": 23881.31, "timestamp": "06:38:01", "text": "或者就一個"}, {"type": "subtitle", "time": 23897.19, "timestamp": "06:38:17", "text": "5美元左右"}, {"type": "subtitle", "time": 23898.83, "timestamp": "06:38:18", "text": "，"}, {"type": "subtitle", "time": 23902.75, "timestamp": "06:38:22", "text": "對吧？我也想對10盧比之類的金額做同樣的事情。但我"}, {"type": "subtitle", "time": 23905.03, "timestamp": "06:38:25", "text": "不知道，夥計，因為我不想讓人們寄太多錢，你知道的。"}, {"type": "subtitle", "time": 23912.23, "timestamp": "06:38:32", "text": "你可以用它來道別。我不知道。關於超級坦克和超級貼紙的"}, {"type": "subtitle", "time": 23915.15, "timestamp": "06:38:35", "text": "最後想法"}, {"type": "subtitle", "time": 23939.708, "timestamp": "06:38:59", "text": "[音樂]。我好害怕，老兄。我很害怕。再見。  好的。明白為什麼嗎？我"}]
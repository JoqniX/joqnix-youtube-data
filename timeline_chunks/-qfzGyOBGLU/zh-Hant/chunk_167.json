[{"type": "subtitle", "time": 10024.389, "timestamp": "02:47:04", "text": "啊，這是寶可夢主"}, {"type": "subtitle", "time": 10044.87, "timestamp": "02:47:24", "text": "車庫的門。這是我打不開的那扇門。你好。請問有人在嗎"}, {"type": "subtitle", "time": 10053.429, "timestamp": "02:47:33", "text": "？這是我錯過的那波掉落。所以，我也會錯過"}, {"type": "subtitle", "time": 10058.59, "timestamp": "02:47:38", "text": "這個嗎？我的天啊。  哦，你好。請問有人在嗎？等等，Ash讓我們掉隊了。等等，不會吧。阿什身上有一塊鏽跡。  什麼？什麼？"}, {"type": "subtitle", "time": 10065.19, "timestamp": "02:47:45", "text": "我錯過了這個。哇。"}]
[{"type": "subtitle", "time": 37801.266, "timestamp": "10:30:01", "text": "什麼？大家好。歡迎收看。我回來了"}, {"type": "subtitle", "time": 37804.51, "timestamp": "10:30:04", "text": "。"}, {"type": "subtitle", "time": 37808.19, "timestamp": "10:30:08", "text": "在我的音樂中害羞上課了"}, {"type": "subtitle", "time": 37811.63, "timestamp": "10:30:11", "text": "。其實跟我的"}, {"type": "subtitle", "time": 37813.746, "timestamp": "10:30:13", "text": "老師聊了很多。他問我"}, {"type": "subtitle", "time": 37816.55, "timestamp": "10:30:16", "text": "日本那邊的狀況，我就跟他說了一下"}, {"type": "subtitle", "time": 37820.67, "timestamp": "10:30:20", "text": "。嗯，"}, {"type": "subtitle", "time": 37824.55, "timestamp": "10:30:24", "text": "挺好的。然後，我告訴他我一直在"}, {"type": "subtitle", "time": 37827.266, "timestamp": "10:30:27", "text": "直播什麼的。"}, {"type": "subtitle", "time": 37829.67, "timestamp": "10:30:29", "text": "因為我"}, {"type": "subtitle", "time": 37832.31, "timestamp": "10:30:32", "text": "又買了Ableton"}, {"type": "subtitle", "time": 37838.95, "timestamp": "10:30:38", "text": "Live的授權，所以我會更積極地"}, {"type": "subtitle", "time": 37840.35, "timestamp": "10:30:40", "text": "做"}, {"type": "subtitle", "time": 37842.87, "timestamp": "10:30:42", "text": "音樂。其實我"}, {"type": "subtitle", "time": 37844.906, "timestamp": "10:30:44", "text": "現在就想做，但我也"}, {"type": "subtitle", "time": 37847.47, "timestamp": "10:30:47", "text": "累了。我想做"}]
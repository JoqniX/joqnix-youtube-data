[{"type": "subtitle", "time": 11.589, "timestamp": "00:00:11", "text": "[音樂]"}, {"type": "subtitle", "time": 29.189, "timestamp": "00:00:29", "text": "歡迎來到 Joathon 第一部分的第 16 天"}, {"type": "subtitle", "time": 30.99, "timestamp": "00:00:30", "text": "。"}, {"type": "subtitle", "time": 34.389, "timestamp": "00:00:34", "text": "歡迎來到第一季度直播間，我"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "今天睡眠不足，所以我會在這裡睡覺。昨天是"}, {"type": "subtitle", "time": 42.03, "timestamp": "00:00:42", "text": "昨晚。我的意思是，"}, {"type": "subtitle", "time": 46.869, "timestamp": "00:00:46", "text": "今天一大早對我來說太難熬了"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "。我在《我的世界》裡死了。我死了，"}, {"type": "subtitle", "time": 52.31, "timestamp": "00:00:52", "text": "一切都結束了。我失去了一切。"}, {"type": "subtitle", "time": 53.869, "timestamp": "00:00:53", "text": "所以，說"}]
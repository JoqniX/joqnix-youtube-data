[{"type": "subtitle", "time": 5961.27, "timestamp": "01:39:21", "text": "兄弟，"}, {"type": "subtitle", "time": 5965.229, "timestamp": "01:39:25", "text": "我沒有錢，獎學金？是的。然後他就能去……他真的去了日本，"}, {"type": "subtitle", "time": 5968.47, "timestamp": "01:39:28", "text": "而且是免費的，我猜……我不知道，這太酷了，我不太了解全部情況，但這是"}, {"type": "subtitle", "time": 5977.35, "timestamp": "01:39:37", "text": "我從別人那裡聽說的，也是他告訴我爸爸"}]
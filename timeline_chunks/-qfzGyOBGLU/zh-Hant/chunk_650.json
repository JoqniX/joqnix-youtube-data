[{"type": "subtitle", "time": 39008.07, "timestamp": "10:50:08", "text": "翻唱了一首歌。這首，英文說唱，就像是英文說唱。英文，日文。哦，等等。"}, {"type": "subtitle", "time": 39036.39, "timestamp": "10:50:36", "text": "我想唱"}, {"type": "subtitle", "time": 39042.19, "timestamp": "10:50:42", "text": "這首歌。太輕鬆了。"}, {"type": "subtitle", "time": 39058.906, "timestamp": "10:50:58", "text": "你們知道這個模特兒很瘋狂嗎？看看這個。她很矮啊。她現在是短髮老婆了。"}]
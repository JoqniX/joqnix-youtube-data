[{"type": "subtitle", "time": 10202.99, "timestamp": "02:50:02", "text": "讲话？哦，语音传输站。"}, {"type": "subtitle", "time": 10205.83, "timestamp": "02:50:05", "text": "呃，我怎么知道我的声音是"}, {"type": "subtitle", "time": 10208.35, "timestamp": "02:50:08", "text": "正在发生？我该怎么做？"}, {"type": "subtitle", "time": 10210.91, "timestamp": "02:50:10", "text": "[音乐]"}, {"type": "subtitle", "time": 10215.389, "timestamp": "02:50:15", "text": "查看？等等，我怎么知道的？"}, {"type": "subtitle", "time": 10219.83, "timestamp": "02:50:19", "text": "这是音频吗？它没有“我的天哪”这样的感叹词。"}, {"type": "subtitle", "time": 10221.95, "timestamp": "02:50:21", "text": "我该如何更改"}, {"type": "subtitle", "time": 10224.87, "timestamp": "02:50:24", "text": "我的天哪！你开玩笑吧？不可能"}, {"type": "subtitle", "time": 10233.87, "timestamp": "02:50:33", "text": "美好的。所以，呃，你们在哪儿？"}, {"type": "subtitle", "time": 10237.95, "timestamp": "02:50:37", "text": "我们？如何打开地图？"}, {"type": "subtitle", "time": 10248.07, "timestamp": "02:50:48", "text": "这些。显然有16个人在"}]
[{"type": "subtitle", "time": 19320.91, "timestamp": "05:22:00", "text": "为什么我无法放置"}, {"type": "subtitle", "time": 19326.35, "timestamp": "05:22:06", "text": "这石头火的东西？哦，我的"}, {"type": "subtitle", "time": 19330.83, "timestamp": "05:22:10", "text": "上帝。啊，我的木头用完了。"}, {"type": "subtitle", "time": 19334.07, "timestamp": "05:22:14", "text": "尽管。你知道吗？我们装了一扇窗户"}, {"type": "subtitle", "time": 19337.83, "timestamp": "05:22:17", "text": "这边是门。为什么？风景"}, {"type": "subtitle", "time": 19351.628, "timestamp": "05:22:31", "text": "我认为我可以摧毁它。"}, {"type": "subtitle", "time": 19360.99, "timestamp": "05:22:40", "text": "呃，我"}, {"type": "subtitle", "time": 19365.31, "timestamp": "05:22:45", "text": "我知道如何摧毁"}]
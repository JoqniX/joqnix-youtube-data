[{"type": "subtitle", "time": 4740.229, "timestamp": "01:19:00", "text": "大概5点半就筋疲力尽了，所以我想……"}, {"type": "subtitle", "time": 4742.41, "timestamp": "01:19:02", "text": "像3点或凌晨1点那样小睡一会儿"}, {"type": "subtitle", "time": 4744.75, "timestamp": "01:19:04", "text": "[音乐]"}, {"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "某物。我觉得没必要。"}, {"type": "subtitle", "time": 4749.03, "timestamp": "01:19:09", "text": "说实话，就这么多。"}, {"type": "subtitle", "time": 4751.11, "timestamp": "01:19:11", "text": "所以，你觉得一个DM小组就足够了。"}, {"type": "subtitle", "time": 4753.83, "timestamp": "01:19:13", "text": "在我邀请参加 Jokathon 活动时"}, {"type": "subtitle", "time": 4761.189, "timestamp": "01:19:21", "text": "尽管？是的，再加一台服务器就好了。"}, {"type": "subtitle", "time": 4764.11, "timestamp": "01:19:24", "text": "麻烦。是啊，没错，没错。"}, {"type": "subtitle", "time": 4767.03, "timestamp": "01:19:27", "text": "真的。或许我会把它放在我自己的房间里。"}, {"type": "subtitle", "time": 4769.709, "timestamp": "01:19:29", "text": "服务器。打开 VC 设备"}, {"type": "subtitle", "time": 4773.99, "timestamp": "01:19:33", "text": "我会把我认识的所有人加进来。"}, {"type": "subtitle", "time": 4775.95, "timestamp": "01:19:35", "text": "相识为朋友"}, {"type": "subtitle", "time": 4778.87, "timestamp": "01:19:38", "text": "他们可以加入进来什么的。我可以"}, {"type": "subtitle", "time": 4780.59, "timestamp": "01:19:40", "text": "像这样做"}, {"type": "subtitle", "time": 4783.83, "timestamp": "01:19:43", "text": "那。是的，这或许可行。我们可以"}, {"type": "subtitle", "time": 4786.229, "timestamp": "01:19:46", "text": "必须使用我们自己的服务器。它正在"}, {"type": "subtitle", "time": 4787.47, "timestamp": "01:19:47", "text": "未使用"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "适当地。我希望更多的人参与讨论。"}]
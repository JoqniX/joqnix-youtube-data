[{"type": "subtitle", "time": 14820.11, "timestamp": "04:07:00", "text": "什么？所以"}, {"type": "subtitle", "time": 14824.55, "timestamp": "04:07:04", "text": "好的。啊，太晚了。"}, {"type": "subtitle", "time": 14825.71, "timestamp": "04:07:05", "text": "我"}, {"type": "subtitle", "time": 14847.75, "timestamp": "04:07:27", "text": "小提琴和键盘乐器。我有药物"}, {"type": "subtitle", "time": 14849.87, "timestamp": "04:07:29", "text": "键盘，这样我就可以把它用作"}, {"type": "subtitle", "time": 14852.15, "timestamp": "04:07:32", "text": "出色地。我们要去哪里？我们要走了"}, {"type": "subtitle", "time": 14858.95, "timestamp": "04:07:38", "text": "或许我们可以卖东西或者做东西。"}]
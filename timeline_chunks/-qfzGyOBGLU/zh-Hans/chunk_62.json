[{"type": "subtitle", "time": 3733.67, "timestamp": "01:02:13", "text": "工作区。我不记得都发生了什么"}, {"type": "subtitle", "time": 3741.15, "timestamp": "01:02:21", "text": "我 4月4日。"}, {"type": "subtitle", "time": 3745.589, "timestamp": "01:02:25", "text": "好的，那是4月4日，另一个是……"}, {"type": "subtitle", "time": 3747.069, "timestamp": "01:02:27", "text": "四月"}, {"type": "subtitle", "time": 3755.549, "timestamp": "01:02:35", "text": "付500，对吧？ 600"}, {"type": "subtitle", "time": 3759.03, "timestamp": "01:02:39", "text": "某物。 598. 为什么是钱"}, {"type": "subtitle", "time": 3765.789, "timestamp": "01:02:45", "text": "时间？好的，600"}, {"type": "subtitle", "time": 3769.75, "timestamp": "01:02:49", "text": "卢比。我的天哪，我到底有多少钱？"}, {"type": "subtitle", "time": 3772.109, "timestamp": "01:02:52", "text": "我付了钱"}, {"type": "subtitle", "time": 3775.27, "timestamp": "01:02:55", "text": "面对这一切，我们只会剩下一点点。"}, {"type": "subtitle", "time": 3776.99, "timestamp": "01:02:56", "text": "少量。"}, {"type": "subtitle", "time": 3779.39, "timestamp": "01:02:59", "text": "但音乐"}]
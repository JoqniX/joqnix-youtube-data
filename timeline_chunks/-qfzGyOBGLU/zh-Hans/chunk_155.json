[{"type": "subtitle", "time": 9300.309, "timestamp": "02:35:00", "text": "玩一款新游戏，这款游戏于"}, {"type": "subtitle", "time": 9302.71, "timestamp": "02:35:02", "text": "将于30日发布"}, {"type": "subtitle", "time": 9306.469, "timestamp": "02:35:06", "text": "十一月。它叫做战锤40000。"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "天色已黑。它就像《最后的最后》"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "《求生之路2》有点像，但更好。"}, {"type": "subtitle", "time": 9318.309, "timestamp": "02:35:18", "text": "有点儿。是的。呃，我迫不及待了"}, {"type": "subtitle", "time": 9320.79, "timestamp": "02:35:20", "text": "播放它。显然，我确实问过这个问题。"}, {"type": "subtitle", "time": 9323.349, "timestamp": "02:35:23", "text": "如果虚拟主播（VTuber）中有任何YouTuber的话"}, {"type": "subtitle", "time": 9325.71, "timestamp": "02:35:25", "text": "拥有它。显然没有人"}, {"type": "subtitle", "time": 9328.55, "timestamp": "02:35:28", "text": "然而。不，呃，没有人联系过我。"}, {"type": "subtitle", "time": 9330.389, "timestamp": "02:35:30", "text": "他们想提高得分。所以很可能"}, {"type": "subtitle", "time": 9333.51, "timestamp": "02:35:33", "text": "我会单人作战或者随机组队。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "呃，为了暗潮溪流。是的，就是这样。"}, {"type": "subtitle", "time": 9338.87, "timestamp": "02:35:38", "text": "美好的。周六，我们将举办一场合作活动。"}, {"type": "subtitle", "time": 9341.83, "timestamp": "02:35:41", "text": "与独一无二的富士富士一起直播。"}, {"type": "subtitle", "time": 9344.429, "timestamp": "02:35:44", "text": "我的天哪，我刚才是不是说了富士山？哦，我的"}, {"type": "subtitle", "time": 9346.51, "timestamp": "02:35:46", "text": "上帝。富士山"}, {"type": "subtitle", "time": 9349.03, "timestamp": "02:35:49", "text": "珠穆朗玛峰。是的，我们会和……一起玩。"}, {"type": "subtitle", "time": 9351.429, "timestamp": "02:35:51", "text": "富士珠穆朗玛峰之子。我们将开始射击。"}, {"type": "subtitle", "time": 9352.91, "timestamp": "02:35:52", "text": "这"}, {"type": "subtitle", "time": 9355.99, "timestamp": "02:35:55", "text": "空气。这是一颗星星。呃，所以是《星球大战》"}, {"type": "subtitle", "time": 9358.79, "timestamp": "02:35:58", "text": "Squadron游戏可以免费领取。"}]
[{"type": "subtitle", "time": 14280.75, "timestamp": "03:58:00", "text": "哦。"}, {"type": "subtitle", "time": 14311.99, "timestamp": "03:58:31", "text": "我买了一把木吉他。等等，我应该"}, {"type": "subtitle", "time": 14322.269, "timestamp": "03:58:42", "text": "害怕的。我觉得我可以。好吧，绝不"}, {"type": "subtitle", "time": 14324.87, "timestamp": "03:58:44", "text": "头脑。别理我。某人"}, {"type": "subtitle", "time": 14328.55, "timestamp": "03:58:48", "text": "住在这里。我只是在练习隐身。"}, {"type": "subtitle", "time": 14336.229, "timestamp": "03:58:56", "text": "[音乐]"}, {"type": "subtitle", "time": 14339.469, "timestamp": "03:58:59", "text": "这真酷。我可以得到"}]
[{"type": "subtitle", "time": 18182.43, "timestamp": "05:03:02", "text": "后退"}, {"type": "subtitle", "time": 18186.15, "timestamp": "05:03:06", "text": "包。呃，其实你得等水管通电。"}, {"type": "subtitle", "time": 18188.03, "timestamp": "05:03:08", "text": "好的。"}, {"type": "subtitle", "time": 18192.91, "timestamp": "05:03:12", "text": "不，也要挥动它。金属碎片"}, {"type": "subtitle", "time": 18201.31, "timestamp": "05:03:21", "text": "向下。糟糕。我输了"}, {"type": "subtitle", "time": 18203.67, "timestamp": "05:03:23", "text": "绳子，天色也渐渐暗了。我们需要"}, {"type": "subtitle", "time": 18209.708, "timestamp": "05:03:29", "text": "[音乐]"}]
[{"type": "subtitle", "time": 18721.91, "timestamp": "05:12:01", "text": "分段？哦，我们可以做的就是制造"}, {"type": "subtitle", "time": 18724.27, "timestamp": "05:12:04", "text": "更多篝火。我"}, {"type": "subtitle", "time": 18743.47, "timestamp": "05:12:23", "text": "超过。但我什么也看不见。"}, {"type": "subtitle", "time": 18747.47, "timestamp": "05:12:27", "text": "好的，让我们来制作你"}, {"type": "subtitle", "time": 18753.788, "timestamp": "05:12:33", "text": "这里。好的，他的职位是"}, {"type": "subtitle", "time": 18758.15, "timestamp": "05:12:38", "text": "完毕。然后我需要一个石火炉。"}, {"type": "subtitle", "time": 18760.51, "timestamp": "05:12:40", "text": "给你的家供暖。"}, {"type": "subtitle", "time": 18774.708, "timestamp": "05:12:54", "text": "男。哦，我需要粉底。我的天啊。"}]
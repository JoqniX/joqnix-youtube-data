[{"type": "subtitle", "time": 19260.67, "timestamp": "05:21:00", "text": "框架"}, {"type": "subtitle", "time": 19263.83, "timestamp": "05:21:03", "text": "尽管？你们有两人的房间吗？什么"}, {"type": "subtitle", "time": 19273.47, "timestamp": "05:21:13", "text": "精心制作的。其中两个。"}, {"type": "subtitle", "time": 19277.948, "timestamp": "05:21:17", "text": "哦。我的天啊。你没有那样做"}, {"type": "subtitle", "time": 19280.51, "timestamp": "05:21:20", "text": "我。圣"}, {"type": "subtitle", "time": 19284.55, "timestamp": "05:21:24", "text": "上帝。他没有那样对我。我的天啊。"}, {"type": "subtitle", "time": 19288.91, "timestamp": "05:21:28", "text": "我的天啊。我的天啊。我的天啊。哦，我的"}]
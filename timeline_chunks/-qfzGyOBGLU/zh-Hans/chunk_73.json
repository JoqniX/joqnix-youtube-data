[{"type": "subtitle", "time": 4380.13, "timestamp": "01:13:00", "text": "疼痛。是的，就是这样。"}, {"type": "subtitle", "time": 4381.63, "timestamp": "01:13:01", "text": "[音乐]"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "我其实需要喝点什么"}, {"type": "subtitle", "time": 4404.43, "timestamp": "01:13:24", "text": "好的。"}, {"type": "subtitle", "time": 4407.59, "timestamp": "01:13:27", "text": "后退。大家别忘了补充水分。"}, {"type": "subtitle", "time": 4409.95, "timestamp": "01:13:29", "text": "别忘了"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "补水。待办事项的数量"}, {"type": "subtitle", "time": 4416.47, "timestamp": "01:13:36", "text": "现在简直疯了。我当时就想，我就……"}, {"type": "subtitle", "time": 4418.95, "timestamp": "01:13:38", "text": "我还是把这件事忘了吧。"}, {"type": "subtitle", "time": 4422.63, "timestamp": "01:13:42", "text": "然后玩些游戏，这样就更……"}, {"type": "subtitle", "time": 4425.87, "timestamp": "01:13:45", "text": "你们觉得有趣吗？"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "某物。但我有时也会意识到"}, {"type": "subtitle", "time": 4430.83, "timestamp": "01:13:50", "text": "那"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "是啊，那些没被制造出来的东西到底是为了什么？"}, {"type": "subtitle", "time": 4436.87, "timestamp": "01:13:56", "text": "你？问题是，这只是为了……"}, {"type": "subtitle", "time": 4438.03, "timestamp": "01:13:58", "text": "领域"}]
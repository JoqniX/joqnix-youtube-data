[{"type": "subtitle", "time": 6480.629, "timestamp": "01:48:00", "text": "矛？"}, {"type": "subtitle", "time": 6494.59, "timestamp": "01:48:14", "text": "推特上有人提到了去世的日本主播。等待，"}, {"type": "subtitle", "time": 6496.59, "timestamp": "01:48:16", "text": "WHO？"}, {"type": "subtitle", "time": 6499.75, "timestamp": "01:48:19", "text": "嗯？等等，谁死了？等等，等等，等等"}, {"type": "subtitle", "time": 6506.629, "timestamp": "01:48:26", "text": "什么？啊，我想我注意到了。哦，"}, {"type": "subtitle", "time": 6509.03, "timestamp": "01:48:29", "text": "是的。是啊是啊。就像真正的忍野"}, {"type": "subtitle", "time": 6511.99, "timestamp": "01:48:31", "text": "那件事发生了，对吧？真正的阳伞"}, {"type": "subtitle", "time": 6515.27, "timestamp": "01:48:35", "text": "就像一个准社会观察者出现了"}, {"type": "subtitle", "time": 6518.229, "timestamp": "01:48:38", "text": "对她来说，就像刺伤了她一样。"}, {"type": "subtitle", "time": 6520.31, "timestamp": "01:48:40", "text": "真实的。哦耶，耶，耶，耶。那"}, {"type": "subtitle", "time": 6522.79, "timestamp": "01:48:42", "text": "一。好的，是的，好的。我注意到了。哦"}, {"type": "subtitle", "time": 6534.31, "timestamp": "01:48:54", "text": "男人。你有女朋友吗？我知道我是"}]
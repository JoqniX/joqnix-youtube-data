[{"type": "subtitle", "time": 5345.39, "timestamp": "01:29:05", "text": "太多了"}, {"type": "subtitle", "time": 5348.629, "timestamp": "01:29:08", "text": "音乐方面的事情和其他同学"}, {"type": "subtitle", "time": 5350.47, "timestamp": "01:29:10", "text": "班级。我认为他们会提交。"}, {"type": "subtitle", "time": 5352.31, "timestamp": "01:29:12", "text": "他们本周的项目。我必须"}, {"type": "subtitle", "time": 5354.79, "timestamp": "01:29:14", "text": "我自己也这么做。我知道我正在做什么"}, {"type": "subtitle", "time": 5356.87, "timestamp": "01:29:16", "text": "杰森。我真的可以花上几个小时"}, {"type": "subtitle", "time": 5360.07, "timestamp": "01:29:20", "text": "几个小时都泡在音乐里，努力学习它。"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "而不是上次我尝试教学的时候"}, {"type": "subtitle", "time": 5364.79, "timestamp": "01:29:24", "text": "东西。我打算先做些实验，然后再研究一下。"}, {"type": "subtitle", "time": 5367.59, "timestamp": "01:29:27", "text": "我自己动手做，而不是让它变得更……"}, {"type": "subtitle", "time": 5369.91, "timestamp": "01:29:29", "text": "就像一个教程之类的东西，但实际上并没有。"}, {"type": "subtitle", "time": 5371.229, "timestamp": "01:29:31", "text": "知道该做什么"}, {"type": "subtitle", "time": 5373.75, "timestamp": "01:29:33", "text": "做。我打算做个实验试试。"}, {"type": "subtitle", "time": 5375.39, "timestamp": "01:29:35", "text": "我。那是"}, {"type": "subtitle", "time": 5377.83, "timestamp": "01:29:37", "text": "更好的。是的。我自己，就像，只是"}, {"type": "subtitle", "time": 5379.83, "timestamp": "01:29:39", "text": "大胆尝试，然后放手去做。选择"}, {"type": "subtitle", "time": 5383.149, "timestamp": "01:29:43", "text": "流动。是的，就是这样。"}, {"type": "subtitle", "time": 5385.83, "timestamp": "01:29:45", "text": "更好的。因为即使我这样做的时候"}, {"type": "subtitle", "time": 5388.59, "timestamp": "01:29:48", "text": "直播的时候，我发现自己有点儿……"}, {"type": "subtitle", "time": 5397.99, "timestamp": "01:29:57", "text": "那里。你肯定可以花一些时间"}]
[{"type": "subtitle", "time": 6665.189, "timestamp": "01:51:05", "text": "这很好。 D，你应该试试吃"}, {"type": "subtitle", "time": 6678.79, "timestamp": "01:51:18", "text": "叉。去日本要多少钱？"}, {"type": "subtitle", "time": 6682.109, "timestamp": "01:51:22", "text": "它很贵，就像懒惰一样。"}, {"type": "subtitle", "time": 6685.43, "timestamp": "01:51:25", "text": "就我而言，我去了一所学院……"}, {"type": "subtitle", "time": 6687.669, "timestamp": "01:51:27", "text": "学习日语。我已经很熟悉了。"}, {"type": "subtitle", "time": 6689.669, "timestamp": "01:51:29", "text": "包含日语内容等等。所以，我"}, {"type": "subtitle", "time": 6691.75, "timestamp": "01:51:31", "text": "我可以有听力理解能力吗？"}, {"type": "subtitle", "time": 6694.149, "timestamp": "01:51:34", "text": "想学习字母和"}, {"type": "subtitle", "time": 6699.75, "timestamp": "01:51:39", "text": "正确的。所以我去了学院，"}, {"type": "subtitle", "time": 6702.35, "timestamp": "01:51:42", "text": "东西。所以还有学院工资之类的。"}, {"type": "subtitle", "time": 6705.91, "timestamp": "01:51:45", "text": "课程和学院的费用"}, {"type": "subtitle", "time": 6708.55, "timestamp": "01:51:48", "text": "他们自己处理很多事情，比如"}, {"type": "subtitle", "time": 6709.55, "timestamp": "01:51:49", "text": "这"}, {"type": "subtitle", "time": 6712.47, "timestamp": "01:51:52", "text": "文档日语呃你的现实生活"}, {"type": "subtitle", "time": 6714.55, "timestamp": "01:51:54", "text": "文档和其他卡片一样齐全"}, {"type": "subtitle", "time": 6717.109, "timestamp": "01:51:57", "text": "你的毕业证书之类的东西"}, {"type": "subtitle", "time": 6719.589, "timestamp": "01:51:59", "text": "他们把它翻译成日语并发送"}]
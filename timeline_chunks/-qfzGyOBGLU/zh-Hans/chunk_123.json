[{"type": "subtitle", "time": 7383.35, "timestamp": "02:03:03", "text": "在日本待了1年9个月，然后如果我"}, {"type": "subtitle", "time": 7387.189, "timestamp": "02:03:07", "text": "如果我能在一年内拿到N2证书之类的东西，那就通过了。"}, {"type": "subtitle", "time": 7391.75, "timestamp": "02:03:11", "text": "9个月后我必须将我的签证转换为"}, {"type": "subtitle", "time": 7395.83, "timestamp": "02:03:15", "text": "呃，签证又给了学生，对吧？"}, {"type": "subtitle", "time": 7398.79, "timestamp": "02:03:18", "text": "如果我没得到……，我想住在那儿。"}, {"type": "subtitle", "time": 7401.51, "timestamp": "02:03:21", "text": "这份工作很合适，所以我正在考虑……"}, {"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "上大学后，我会努力争取……"}, {"type": "subtitle", "time": 7405.75, "timestamp": "02:03:25", "text": "大学学位或同等学历"}, {"type": "subtitle", "time": 7408.55, "timestamp": "02:03:28", "text": "那里。为此，我必须得到一个好的"}, {"type": "subtitle", "time": 7411.99, "timestamp": "02:03:31", "text": "大学申请之类的。做我的"}, {"type": "subtitle", "time": 7415.43, "timestamp": "02:03:35", "text": "祝好，希望我能参加几个。"}, {"type": "subtitle", "time": 7416.43, "timestamp": "02:03:36", "text": "的"}, {"type": "subtitle", "time": 7419.43, "timestamp": "02:03:39", "text": "大学。那我就只能靠自己了，对吧？"}, {"type": "subtitle", "time": 7421.669, "timestamp": "02:03:41", "text": "我得找地方住，还有其他一切。"}, {"type": "subtitle", "time": 7423.589, "timestamp": "02:03:43", "text": "然后签证办好之后，一切都结束了。"}, {"type": "subtitle", "time": 7425.149, "timestamp": "02:03:45", "text": "完成了，然后就是"}, {"type": "subtitle", "time": 7427.91, "timestamp": "02:03:47", "text": "好的。我可以待在那里。但我可能"}, {"type": "subtitle", "time": 7429.51, "timestamp": "02:03:49", "text": "回到印度写我的"}, {"type": "subtitle", "time": 7431.51, "timestamp": "02:03:51", "text": "无知。"}, {"type": "subtitle", "time": 7433.669, "timestamp": "02:03:53", "text": "我最近发现，还有"}, {"type": "subtitle", "time": 7435.79, "timestamp": "02:03:55", "text": "国际分部"}, {"type": "subtitle", "time": 7438.95, "timestamp": "02:03:58", "text": "面向外国留学生。所以我在想"}]
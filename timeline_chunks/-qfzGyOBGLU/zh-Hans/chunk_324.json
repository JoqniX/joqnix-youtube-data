[{"type": "subtitle", "time": 19440.47, "timestamp": "05:24:00", "text": "小型炼油厂。好的。所以这将"}, {"type": "subtitle", "time": 19444.39, "timestamp": "05:24:04", "text": "给我原油，一些原油之类的东西，对吧？"}, {"type": "subtitle", "time": 19446.55, "timestamp": "05:24:06", "text": "我不知道该如何进一步完善它。"}, {"type": "subtitle", "time": 19456.11, "timestamp": "05:24:16", "text": "好的。我相信我可以升级这些。"}, {"type": "subtitle", "time": 19458.91, "timestamp": "05:24:18", "text": "东西。升级到"}, {"type": "subtitle", "time": 19461.99, "timestamp": "05:24:21", "text": "木头。是的，我应该升级一下我的"}, {"type": "subtitle", "time": 19479.59, "timestamp": "05:24:39", "text": "片刻。所以，我们得到了一个步枪部件。"}, {"type": "subtitle", "time": 19482.03, "timestamp": "05:24:42", "text": "我们可以造一支步枪之类的东西。"}, {"type": "subtitle", "time": 19485.43, "timestamp": "05:24:45", "text": "显然。凉爽的。凉爽的。"}, {"type": "subtitle", "time": 19488.15, "timestamp": "05:24:48", "text": "一些金属材质的路标。我们"}, {"type": "subtitle", "time": 19498.868, "timestamp": "05:24:58", "text": "东西。你好。现在是10点11分。我"}]
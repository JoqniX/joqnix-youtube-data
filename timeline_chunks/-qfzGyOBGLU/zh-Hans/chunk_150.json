[{"type": "subtitle", "time": 9000.55, "timestamp": "02:30:00", "text": "接下来我的目标是升到18级。等等，让我来展示一下"}, {"type": "subtitle", "time": 9007.87, "timestamp": "02:30:07", "text": "等等，发生了什么事？是的，Candex是"}, {"type": "subtitle", "time": 9010.87, "timestamp": "02:30:10", "text": "某个大笨蛋黑了我的号"}, {"type": "subtitle", "time": 9013.349, "timestamp": "02:30:13", "text": "某物。我觉得是因为我的"}, {"type": "subtitle", "time": 9015.99, "timestamp": "02:30:15", "text": "浏览器 cookie 泄露或被盗"}, {"type": "subtitle", "time": 9018.469, "timestamp": "02:30:18", "text": "被某些软件或其他东西覆盖。"}, {"type": "subtitle", "time": 9022.389, "timestamp": "02:30:22", "text": "我确实因此损失了很多钱。"}, {"type": "subtitle", "time": 9025.11, "timestamp": "02:30:25", "text": "呃，账户，比如谷歌账户。"}, {"type": "subtitle", "time": 9027.59, "timestamp": "02:30:27", "text": "想法。但显然，那个小鬼"}, {"type": "subtitle", "time": 9030.79, "timestamp": "02:30:30", "text": "巴卡·布拉特实际上也拿走了我的"}, {"type": "subtitle", "time": 9033.91, "timestamp": "02:30:33", "text": "不知何故，我的育碧游戏机失控了。我"}, {"type": "subtitle", "time": 9036.469, "timestamp": "02:30:36", "text": "不知道为什么。是的，正如你所看到的"}, {"type": "subtitle", "time": 9039.91, "timestamp": "02:30:39", "text": "这是我在育碧的一个新账号。"}, {"type": "subtitle", "time": 9042.99, "timestamp": "02:30:42", "text": "连接。所以你可以看到黑暗"}, {"type": "subtitle", "time": 9047.67, "timestamp": "02:30:47", "text": "XAX 在 Xia 上。所以，嗯，如果我要……"}, {"type": "subtitle", "time": 9049.469, "timestamp": "02:30:49", "text": "直接进入"}, {"type": "subtitle", "time": 9052.95, "timestamp": "02:30:52", "text": "朋友们，如果我……"}, {"type": "subtitle", "time": 9055.15, "timestamp": "02:30:55", "text": "嗯，是的，这是我的"}, {"type": "subtitle", "time": 9056.99, "timestamp": "02:30:56", "text": "帐户。"}]
[{"type": "subtitle", "time": 8181.43, "timestamp": "02:16:21", "text": "哦，那些人。好的。"}, {"type": "subtitle", "time": 8183.109, "timestamp": "02:16:23", "text": "好的。好的。好的。好的。高"}, {"type": "subtitle", "time": 8184.87, "timestamp": "02:16:24", "text": "学校角色扮演。不是角色扮演者。哦，"}, {"type": "subtitle", "time": 8187.109, "timestamp": "02:16:27", "text": "是的。那四个人。好的。"}, {"type": "subtitle", "time": 8189.51, "timestamp": "02:16:29", "text": "好的。好的。那个。好的。"}, {"type": "subtitle", "time": 8191.589, "timestamp": "02:16:31", "text": "他们正在制作《碧蓝幻想》第二季。"}, {"type": "subtitle", "time": 8217.83, "timestamp": "02:16:57", "text": "对不起。搞什么鬼？"}]
[{"type": "subtitle", "time": 12181.19, "timestamp": "03:23:01", "text": "某物。谁能给我个绷带？"}, {"type": "subtitle", "time": 12182.51, "timestamp": "03:23:02", "text": "至少。来"}, {"type": "subtitle", "time": 12184.75, "timestamp": "03:23:04", "text": "在。我得到了"}, {"type": "subtitle", "time": 12192.99, "timestamp": "03:23:12", "text": "耶。什么样的战利品？"}, {"type": "subtitle", "time": 12205.87, "timestamp": "03:23:25", "text": "我听到有人说"}, {"type": "subtitle", "time": 12207.469, "timestamp": "03:23:27", "text": "瓦姆普。"}, {"type": "subtitle", "time": 12210.51, "timestamp": "03:23:30", "text": "什么？我听到有人说"}, {"type": "subtitle", "time": 12229.19, "timestamp": "03:23:49", "text": "我想，我们还是穿过这片区域吧。"}, {"type": "subtitle", "time": 12232.469, "timestamp": "03:23:52", "text": "我不知道自己身在何处。我是什么？"}, {"type": "subtitle", "time": 12234.51, "timestamp": "03:23:54", "text": "应该怎么做？但它是"}, {"type": "subtitle", "time": 12237.269, "timestamp": "03:23:57", "text": "美好的。是啊，我们上楼吧。"}, {"type": "subtitle", "time": 12239.87, "timestamp": "03:23:59", "text": "这样我就可以看看了，你"}]
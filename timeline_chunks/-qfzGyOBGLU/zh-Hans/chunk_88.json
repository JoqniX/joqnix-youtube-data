[{"type": "subtitle", "time": 5285.11, "timestamp": "01:28:05", "text": "事情发生了，如果我不提交那件事的话。"}, {"type": "subtitle", "time": 5289.669, "timestamp": "01:28:09", "text": "对，就像我的项目一样，我觉得不是。"}, {"type": "subtitle", "time": 5291.83, "timestamp": "01:28:11", "text": "我哪儿也不去。我只是在浪费时间"}, {"type": "subtitle", "time": 5294.31, "timestamp": "01:28:14", "text": "你知道，还有钱，还有上课等等。"}, {"type": "subtitle", "time": 5296.629, "timestamp": "01:28:16", "text": "甚至都没能消除我的疑虑，"}, {"type": "subtitle", "time": 5300.43, "timestamp": "01:28:20", "text": "东西。音乐课程的合作方是"}, {"type": "subtitle", "time": 5304.51, "timestamp": "01:28:24", "text": "65,000。那可真是个巨大的"}, {"type": "subtitle", "time": 5308.229, "timestamp": "01:28:28", "text": "数量。我用自己的工资偿还贷款。"}, {"type": "subtitle", "time": 5309.55, "timestamp": "01:28:29", "text": "我"}, {"type": "subtitle", "time": 5312.95, "timestamp": "01:28:32", "text": "得到的虽然更少，但仍然喜欢"}, {"type": "subtitle", "time": 5317.11, "timestamp": "01:28:37", "text": "想办法支付。我恳求爸爸，可以吗？"}, {"type": "subtitle", "time": 5319.11, "timestamp": "01:28:39", "text": "你把它分成四个月分期付款，"}]
[{"type": "subtitle", "time": 11880.55, "timestamp": "03:18:00", "text": "好吧，我饿死了。我会死"}, {"type": "subtitle", "time": 11907.309, "timestamp": "03:18:27", "text": "正确的。他正要过来"}, {"type": "subtitle", "time": 11910.469, "timestamp": "03:18:30", "text": "我。 H. 不要开枪。不要开枪。我是"}, {"type": "subtitle", "time": 11919.15, "timestamp": "03:18:39", "text": "H."}]
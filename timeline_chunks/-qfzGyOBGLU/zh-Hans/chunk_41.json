[{"type": "subtitle", "time": 2464.67, "timestamp": "00:41:04", "text": "是的。但事实就是如此。"}, {"type": "subtitle", "time": 2477.03, "timestamp": "00:41:17", "text": "我意识到我叫得太多了。"}, {"type": "subtitle", "time": 2478.03, "timestamp": "00:41:18", "text": "我就像"}, {"type": "subtitle", "time": 2481.47, "timestamp": "00:41:21", "text": "真的不是尖叫，真的不是尖叫"}, {"type": "subtitle", "time": 2488.47, "timestamp": "00:41:28", "text": "我不知道。这是新事物还是……"}, {"type": "subtitle", "time": 2502.43, "timestamp": "00:41:42", "text": "知道。问得好。"}, {"type": "subtitle", "time": 2510.79, "timestamp": "00:41:50", "text": "知道。一秒钟。让我把麦克风插进去"}]
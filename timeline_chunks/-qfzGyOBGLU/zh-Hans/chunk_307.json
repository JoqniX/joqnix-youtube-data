[{"type": "subtitle", "time": 18422.39, "timestamp": "05:07:02", "text": "方式。应该把火炬带走的。"}, {"type": "subtitle", "time": 18426.55, "timestamp": "05:07:06", "text": "我记得是N102，对吧？是的。"}, {"type": "subtitle", "time": 18432.75, "timestamp": "05:07:12", "text": "前方。这将是一个"}, {"type": "subtitle", "time": 18441.628, "timestamp": "05:07:21", "text": "东西。目标是回家"}, {"type": "subtitle", "time": 18444.23, "timestamp": "05:07:24", "text": "安全地。这是最重要的事。我的天啊，"}, {"type": "subtitle", "time": 18445.788, "timestamp": "05:07:25", "text": "有"}, {"type": "subtitle", "time": 18457.39, "timestamp": "05:07:37", "text": "我相信它就在N1附近"}, {"type": "subtitle", "time": 18460.59, "timestamp": "05:07:40", "text": "哦，我相信我"}, {"type": "subtitle", "time": 18464.27, "timestamp": "05:07:44", "text": "这是森林吗？我是"}, {"type": "subtitle", "time": 18467.27, "timestamp": "05:07:47", "text": "害怕的。我认为逃跑更好。"}, {"type": "subtitle", "time": 18469.788, "timestamp": "05:07:49", "text": "由此"}, {"type": "subtitle", "time": 18473.47, "timestamp": "05:07:53", "text": "而不是直接前往森林"}]
[{"type": "subtitle", "time": 19621.83, "timestamp": "05:27:01", "text": "给我弄点吃的。所以，我们需要去狩猎。"}, {"type": "subtitle", "time": 19625.51, "timestamp": "05:27:05", "text": "很多东西。我们需要做些事情。是的。"}, {"type": "subtitle", "time": 19631.15, "timestamp": "05:27:11", "text": "我相信服务器会重置"}, {"type": "subtitle", "time": 19634.47, "timestamp": "05:27:14", "text": "一切。服务器将重置所有"}, {"type": "subtitle", "time": 19636.39, "timestamp": "05:27:16", "text": "一个月左右。所以，这有点像……"}, {"type": "subtitle", "time": 19638.948, "timestamp": "05:27:18", "text": "疼痛是正常的。但至少重要的是……"}, {"type": "subtitle", "time": 19640.51, "timestamp": "05:27:20", "text": "我们玩……"}, {"type": "subtitle", "time": 19644.75, "timestamp": "05:27:24", "text": "享受。你选了个奇怪的游戏。"}, {"type": "subtitle", "time": 19647.83, "timestamp": "05:27:27", "text": "再次玩这个游戏是因为我想玩一段时间。"}, {"type": "subtitle", "time": 19649.75, "timestamp": "05:27:29", "text": "尽管。"}, {"type": "subtitle", "time": 19651.99, "timestamp": "05:27:31", "text": "它和朋友在一起很好，就像……"}, {"type": "subtitle", "time": 19657.39, "timestamp": "05:27:37", "text": "大绿巨人社区等等"}, {"type": "subtitle", "time": 19661.19, "timestamp": "05:27:41", "text": "因为自从看了游戏之后就一直喜欢它"}, {"type": "subtitle", "time": 19664.788, "timestamp": "05:27:44", "text": "嗯，关于离线电视Rush服务器之类的东西，"}, {"type": "subtitle", "time": 19667.75, "timestamp": "05:27:47", "text": "我明白了，我也想玩。"}, {"type": "subtitle", "time": 19673.788, "timestamp": "05:27:53", "text": "购买两年后"}]
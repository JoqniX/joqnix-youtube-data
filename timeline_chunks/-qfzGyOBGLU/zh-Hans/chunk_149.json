[{"type": "subtitle", "time": 8941.349, "timestamp": "02:29:01", "text": "显然，布拉德·巴卡的某个大人物被黑客攻击了。"}, {"type": "subtitle", "time": 8944.469, "timestamp": "02:29:04", "text": "某物。我觉得我大概知道是什么"}, {"type": "subtitle", "time": 8947.429, "timestamp": "02:29:07", "text": "发生了。我等待。所以之前我就是这样"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "与支持人员交谈。是的。你好"}, {"type": "subtitle", "time": 8953.19, "timestamp": "02:29:13", "text": "是的，阿迪蒂。你们最近怎么样？所以"}, {"type": "subtitle", "time": 8955.75, "timestamp": "02:29:15", "text": "是的，之前我联系上了育碧。"}, {"type": "subtitle", "time": 8958.309, "timestamp": "02:29:18", "text": "支持他们"}, {"type": "subtitle", "time": 8959.75, "timestamp": "02:29:19", "text": "呃，你查看过我的好友请求吗？"}, {"type": "subtitle", "time": 8962.309, "timestamp": "02:29:22", "text": "自由的。我还没有，我得……"}, {"type": "subtitle", "time": 8965.67, "timestamp": "02:29:25", "text": "重新下载《Free Fire》。所以，是的，希望"}, {"type": "subtitle", "time": 8969.59, "timestamp": "02:29:29", "text": "你做得很好。是的，我联系了。"}, {"type": "subtitle", "time": 8971.67, "timestamp": "02:29:31", "text": "支持，你猜他们说了什么？"}, {"type": "subtitle", "time": 8974.87, "timestamp": "02:29:34", "text": "很遗憾，对此我无能为力。我甚至"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "我出示了我的 Epic Games 购买收据"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "彩虹六号：围攻。那并没有帮助。"}, {"type": "subtitle", "time": 8983.03, "timestamp": "02:29:43", "text": "他们说：“是的，他们拒绝了我的请求。”"}, {"type": "subtitle", "time": 8985.429, "timestamp": "02:29:45", "text": "请求，呃，我的恢复请求，"}, {"type": "subtitle", "time": 8987.309, "timestamp": "02:29:47", "text": "东西。” 我心想，"}, {"type": "subtitle", "time": 8989.99, "timestamp": "02:29:49", "text": "“什么？”我刚刚创建了一个新账户"}, {"type": "subtitle", "time": 8992.11, "timestamp": "02:29:52", "text": "猜猜看"}]
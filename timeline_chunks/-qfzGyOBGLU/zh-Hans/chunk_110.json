[{"type": "subtitle", "time": 6607.47, "timestamp": "01:50:07", "text": "偶像文化之类的东西"}, {"type": "subtitle", "time": 6610.95, "timestamp": "01:50:10", "text": "东西。是的，还有那些乱七八糟的东西。"}, {"type": "subtitle", "time": 6614.709, "timestamp": "01:50:14", "text": "老兄，我感觉糟透了。什么？什么？如何"}, {"type": "subtitle", "time": 6618.51, "timestamp": "01:50:18", "text": "她有很多事情要处理"}, {"type": "subtitle", "time": 6621.83, "timestamp": "01:50:21", "text": "已经？该死。 Coro V2 则有所不同。"}, {"type": "subtitle", "time": 6624.229, "timestamp": "01:50:24", "text": "等级。他们知道如何应对这些问题"}, {"type": "subtitle", "time": 6626.31, "timestamp": "01:50:26", "text": "种种境况、仇恨以及所有的一切"}, {"type": "subtitle", "time": 6628.91, "timestamp": "01:50:28", "text": "还有猎巫行动以及所有那些事"}, {"type": "subtitle", "time": 6632.149, "timestamp": "01:50:32", "text": "哇，他们是怎么做到的？我也是。"}, {"type": "subtitle", "time": 6635.95, "timestamp": "01:50:35", "text": "敏感的人，我，我，我"}, {"type": "subtitle", "time": 6637.79, "timestamp": "01:50:37", "text": "窒息"}, {"type": "subtitle", "time": 6641.47, "timestamp": "01:50:41", "text": "我，我不知道该怎么做"}, {"type": "subtitle", "time": 6649.59, "timestamp": "01:50:49", "text": "杜鲁。我喜欢我吃dsha的方式"}, {"type": "subtitle", "time": 6653.669, "timestamp": "01:50:53", "text": "这把叉子。好的。所以我不会得到我的"}]
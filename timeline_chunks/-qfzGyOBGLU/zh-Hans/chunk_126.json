[{"type": "subtitle", "time": 7562.07, "timestamp": "02:06:02", "text": "进入，就像进入一个呃"}, {"type": "subtitle", "time": 7568.95, "timestamp": "02:06:08", "text": "虽然这份工作你可以去日本。"}, {"type": "subtitle", "time": 7571.189, "timestamp": "02:06:11", "text": "我本来可以的，但我没有，我当时就像……"}, {"type": "subtitle", "time": 7572.95, "timestamp": "02:06:12", "text": "那不可能，你知道我的家人"}, {"type": "subtitle", "time": 7576.03, "timestamp": "02:06:16", "text": "甚至都不同意之类的。我当时就像"}, {"type": "subtitle", "time": 7578.629, "timestamp": "02:06:18", "text": "过度思考不必要的事情，然后跳"}, {"type": "subtitle", "time": 7581.75, "timestamp": "02:06:21", "text": "我草率地得出结论了，而实际上"}, {"type": "subtitle", "time": 7584.87, "timestamp": "02:06:24", "text": "确实对这一切进行过研究。"}, {"type": "subtitle", "time": 7587.75, "timestamp": "02:06:27", "text": "就像提出一样，不像"}, {"type": "subtitle", "time": 7589.83, "timestamp": "02:06:29", "text": "与他们对质，和他们交谈，进行了一次谈话。"}, {"type": "subtitle", "time": 7591.43, "timestamp": "02:06:31", "text": "和他们一起，并展示了我的所有东西"}, {"type": "subtitle", "time": 7593.669, "timestamp": "02:06:33", "text": "研究一些东西，比如我去了这个"}, {"type": "subtitle", "time": 7595.43, "timestamp": "02:06:35", "text": "学院、这个、这个和研究"}, {"type": "subtitle", "time": 7597.589, "timestamp": "02:06:37", "text": "价格之类的东西，这就是他们"}, {"type": "subtitle", "time": 7599.669, "timestamp": "02:06:39", "text": "我说这就是我想要的。"}, {"type": "subtitle", "time": 7602.55, "timestamp": "02:06:42", "text": "当我真正和他们坦诚交谈时，他们确实如此。"}, {"type": "subtitle", "time": 7604.87, "timestamp": "02:06:44", "text": "他们说，是啊，他们是。"}, {"type": "subtitle", "time": 7608.069, "timestamp": "02:06:48", "text": "愿意给我寄东西之类的"}, {"type": "subtitle", "time": 7610.39, "timestamp": "02:06:50", "text": "无论我做什么决定，都是你的。"}, {"type": "subtitle", "time": 7612.189, "timestamp": "02:06:52", "text": "生活和他们的东西"}, {"type": "subtitle", "time": 7615.189, "timestamp": "02:06:55", "text": "我说我很担心自己是这样一个人"}, {"type": "subtitle", "time": 7616.91, "timestamp": "02:06:56", "text": "右侧上墨"}]
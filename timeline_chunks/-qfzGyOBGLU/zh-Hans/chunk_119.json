[{"type": "subtitle", "time": 7150.55, "timestamp": "01:59:10", "text": "去体验真人幻想和真人假生活"}, {"type": "subtitle", "time": 7165.27, "timestamp": "01:59:25", "text": "我穷得叮当响。没关系。在"}, {"type": "subtitle", "time": 7169.589, "timestamp": "01:59:29", "text": "未来，如果你能赚钱的话，嗯……"}, {"type": "subtitle", "time": 7172.87, "timestamp": "01:59:32", "text": "运气好的话，最好还能攒下不少钱。"}, {"type": "subtitle", "time": 7175.03, "timestamp": "01:59:35", "text": "当然可以，要学会存钱。别这样"}, {"type": "subtitle", "time": 7176.75, "timestamp": "01:59:36", "text": "像我这样的。我没有那种东西叫"}, {"type": "subtitle", "time": 7178.27, "timestamp": "01:59:38", "text": "节省。"}, {"type": "subtitle", "time": 7181.109, "timestamp": "01:59:41", "text": "哦，是的，当你……当你能……的时候"}, {"type": "subtitle", "time": 7184.31, "timestamp": "01:59:44", "text": "积蓄够了，尽量多准备些东西。"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "试着像对待自己一样对待自己"}, {"type": "subtitle", "time": 7187.51, "timestamp": "01:59:47", "text": "假期。"}, {"type": "subtitle", "time": 7190.95, "timestamp": "01:59:50", "text": "所以你可以享受世界，或者去……"}, {"type": "subtitle", "time": 7193.35, "timestamp": "01:59:53", "text": "出国旅行之类的"}, {"type": "subtitle", "time": 7195.47, "timestamp": "01:59:55", "text": "参观或旅游相关活动"}, {"type": "subtitle", "time": 7198.87, "timestamp": "01:59:58", "text": "某物。是的。因为在某种程度上你会"}]
[{"type": "subtitle", "time": 9721.59, "timestamp": "02:42:01", "text": "Tigeran，你应该去……"}, {"type": "subtitle", "time": 9723.28, "timestamp": "02:42:03", "text": "床？"}, {"type": "subtitle", "time": 9725.51, "timestamp": "02:42:05", "text": "[音乐]"}, {"type": "subtitle", "time": 9729.07, "timestamp": "02:42:09", "text": "我想，让我调整一下"}, {"type": "subtitle", "time": 9731.15, "timestamp": "02:42:11", "text": "你在那里"}, {"type": "subtitle", "time": 9734.309, "timestamp": "02:42:14", "text": "去。是的，我等不及了。我不知道"}, {"type": "subtitle", "time": 9737.67, "timestamp": "02:42:17", "text": "事情最终会如何发展，我还不得而知，但我希望如此。"}, {"type": "subtitle", "time": 9743.429, "timestamp": "02:42:23", "text": "出色地。请稍等一秒。让我吹我的"}, {"type": "subtitle", "time": 9745.51, "timestamp": "02:42:25", "text": "屏幕。一秒钟。我需要关闭所有"}, {"type": "subtitle", "time": 9748.51, "timestamp": "02:42:28", "text": "后台应用程序。我"}, {"type": "subtitle", "time": 9750.95, "timestamp": "02:42:30", "text": "忘了。是啊，真是太悲惨了。"}, {"type": "subtitle", "time": 9753.27, "timestamp": "02:42:33", "text": "呃，马里奥·巴约夫特到底发生了什么事？"}, {"type": "subtitle", "time": 9756.23, "timestamp": "02:42:36", "text": "帐户。没关系。诸如此类的事情"}, {"type": "subtitle", "time": 9758.07, "timestamp": "02:42:38", "text": "事情发生了。我需要收紧我的"}, {"type": "subtitle", "time": 9761.51, "timestamp": "02:42:41", "text": "安全问题也再次出现，因为我做不到。"}, {"type": "subtitle", "time": 9762.75, "timestamp": "02:42:42", "text": "很多"}, {"type": "subtitle", "time": 9766.55, "timestamp": "02:42:46", "text": "因为我展示了我的采集卡，对吧？"}, {"type": "subtitle", "time": 9769.75, "timestamp": "02:42:49", "text": "呃，我不能，就像如果我想的话我可以做到一样。"}, {"type": "subtitle", "time": 9772.389, "timestamp": "02:42:52", "text": "我在我的游戏电脑上使用另一个 OBS，"}, {"type": "subtitle", "time": 9775.11, "timestamp": "02:42:55", "text": "用游戏录制之类的软件就行了，"}, {"type": "subtitle", "time": 9778.95, "timestamp": "02:42:58", "text": "但是如果我那样做，就会出现严重的卡顿。"}]
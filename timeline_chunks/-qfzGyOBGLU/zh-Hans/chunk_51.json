[{"type": "subtitle", "time": 3060.47, "timestamp": "00:51:00", "text": "星座赠送了配饰。不，"}, {"type": "subtitle", "time": 3062.069, "timestamp": "00:51:02", "text": "关键是，这两者是有区别的。患病的"}, {"type": "subtitle", "time": 3062.67, "timestamp": "00:51:02", "text": "告诉"}, {"type": "subtitle", "time": 3065.349, "timestamp": "00:51:05", "text": "你。我告诉你。我会告诉你"}, {"type": "subtitle", "time": 3068.71, "timestamp": "00:51:08", "text": "你现在看到的这个笑话是"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "想变得更酷，并且想"}, {"type": "subtitle", "time": 3073.39, "timestamp": "00:51:13", "text": "更加叛逆和"}, {"type": "subtitle", "time": 3076.03, "timestamp": "00:51:16", "text": "小子。想要融入社交圈"}, {"type": "subtitle", "time": 3078.589, "timestamp": "00:51:18", "text": "界。这就是他拥有的原因"}, {"type": "subtitle", "time": 3082.91, "timestamp": "00:51:22", "text": "打耳洞什么的都做了，对吧？"}, {"type": "subtitle", "time": 3087.51, "timestamp": "00:51:27", "text": "穿孔。新的那个太纯净了。"}, {"type": "subtitle", "time": 3090.829, "timestamp": "00:51:30", "text": "它描绘了"}, {"type": "subtitle", "time": 3094.43, "timestamp": "00:51:34", "text": "它所描绘的"}, {"type": "subtitle", "time": 3098.309, "timestamp": "00:51:38", "text": "开头部分，因为它不是，它是"}, {"type": "subtitle", "time": 3100.71, "timestamp": "00:51:40", "text": "现在正式版模型已发布。所以我不得不"}, {"type": "subtitle", "time": 3105.15, "timestamp": "00:51:45", "text": "成熟这一步需要慢慢来。"}, {"type": "subtitle", "time": 3108.549, "timestamp": "00:51:48", "text": "随着时间的推移，新模型慢慢地……"}, {"type": "subtitle", "time": 3110.71, "timestamp": "00:51:50", "text": "服装或其他什么东西我们会得到升级"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "新官方模型的未来。"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "然后，嗯，我要描绘一下"}]
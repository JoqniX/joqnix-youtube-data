[{"type": "subtitle", "time": 241.71, "timestamp": "00:04:01", "text": "实际上我需要为铸造气体实验室付费。"}, {"type": "subtitle", "time": 255.71, "timestamp": "00:04:15", "text": "支付。我当时也在玩"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "几个小时前玩的Minecraft。单身的"}, {"type": "subtitle", "time": 260.43, "timestamp": "00:04:20", "text": "球员和我的丈夫"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "我死了。我尖叫着说我"}, {"type": "subtitle", "time": 267.629, "timestamp": "00:04:27", "text": "昨天我哭了，我是"}, {"type": "subtitle", "time": 271.23, "timestamp": "00:04:31", "text": "完毕。我向他们汇报了情况。"}, {"type": "subtitle", "time": 274.469, "timestamp": "00:04:34", "text": "所以我就说：“好的，告诉我一声。”"}, {"type": "subtitle", "time": 277.12, "timestamp": "00:04:37", "text": "你输了。我会给你，我就像"}, {"type": "subtitle", "time": 281.55, "timestamp": "00:04:41", "text": "[音乐]"}, {"type": "subtitle", "time": 283.99, "timestamp": "00:04:43", "text": "我的。”但我还是完成了任务。"}, {"type": "subtitle", "time": 285.55, "timestamp": "00:04:45", "text": "背叛者"}, {"type": "subtitle", "time": 296.84000000000003, "timestamp": "00:04:56", "text": "今天一天下来，我所有的奖励都丢了，真是太可惜了。"}]
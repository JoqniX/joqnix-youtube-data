[{"type": "subtitle", "time": 15242.79, "timestamp": "04:14:02", "text": "10. 好的，这是第一个。那是衣服"}, {"type": "subtitle", "time": 15256.309, "timestamp": "04:14:16", "text": "clo。啊，我得放下东西。我"}, {"type": "subtitle", "time": 15265.51, "timestamp": "04:14:25", "text": "H：好了。我堵塞了。什么"}, {"type": "subtitle", "time": 15267.03, "timestamp": "04:14:27", "text": "我能做的所有东西？我可以制作"}, {"type": "subtitle", "time": 15270.03, "timestamp": "04:14:30", "text": "绷带和急救包。那将是"}, {"type": "subtitle", "time": 15272.51, "timestamp": "04:14:32", "text": "我相信"}, {"type": "subtitle", "time": 15282.91, "timestamp": "04:14:42", "text": "事物。弓。是的。是的。弓。那就是"}, {"type": "subtitle", "time": 15287.55, "timestamp": "04:14:47", "text": "事物。呃，武器。弓。"}, {"type": "subtitle", "time": 15290.91, "timestamp": "04:14:50", "text": "是的。服装。是的。呃"}, {"type": "subtitle", "time": 15293.07, "timestamp": "04:14:53", "text": "等待。"}, {"type": "subtitle", "time": 15296.229, "timestamp": "04:14:56", "text": "工艺。那我该如何获得箭头呢？我愿意"}, {"type": "subtitle", "time": 15297.79, "timestamp": "04:14:57", "text": "不是"}]
[{"type": "subtitle", "time": 12967.309, "timestamp": "03:36:07", "text": "祸根。他们杀了他"}, {"type": "subtitle", "time": 12982.389, "timestamp": "03:36:22", "text": "我等待。我的重载按钮是什么？ R. Oh"}, {"type": "subtitle", "time": 12984.429, "timestamp": "03:36:24", "text": "上帝。那是"}, {"type": "subtitle", "time": 12986.75, "timestamp": "03:36:26", "text": "为什么。"}, {"type": "subtitle", "time": 12989.91, "timestamp": "03:36:29", "text": "我当时正在按F1键，想着这件事。哦"}, {"type": "subtitle", "time": 12992.51, "timestamp": "03:36:32", "text": "我的上帝。没关系。它是"}, {"type": "subtitle", "time": 12995.07, "timestamp": "03:36:35", "text": "美好的。这是"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "男孩们要离开了。所以，那是什么？"}, {"type": "subtitle", "time": 13011.11, "timestamp": "03:36:51", "text": "再次？我听到有人说话。下雨了。它是"}, {"type": "subtitle", "time": 13013.95, "timestamp": "03:36:53", "text": "这是一只鹿。我可以杀人吗？"}, {"type": "subtitle", "time": 13019.07, "timestamp": "03:36:59", "text": "那"}]
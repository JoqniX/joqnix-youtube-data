[{"type": "subtitle", "time": 7320.75, "timestamp": "02:02:00", "text": "你自己觉得"}, {"type": "subtitle", "time": 7324.35, "timestamp": "02:02:04", "text": "是的，我读过。"}, {"type": "subtitle", "time": 7326.79, "timestamp": "02:02:06", "text": "一个环境优美、父母亲人友善的地方，景色宜人。"}, {"type": "subtitle", "time": 7328.109, "timestamp": "02:02:08", "text": "生活美好，朋友们。"}, {"type": "subtitle", "time": 7337.03, "timestamp": "02:02:17", "text": "那里。你还能要求什么呢？你"}, {"type": "subtitle", "time": 7340.229, "timestamp": "02:02:20", "text": "你身边都是好人，而且"}, {"type": "subtitle", "time": 7343.07, "timestamp": "02:02:23", "text": "支持你。"}, {"type": "subtitle", "time": 7345.07, "timestamp": "02:02:25", "text": "不。"}, {"type": "subtitle", "time": 7347.91, "timestamp": "02:02:27", "text": "好的。你是学生吗？你在学习吗？"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "离开这个国家？是的。是的。是的。所以，呃"}, {"type": "subtitle", "time": 7354.709, "timestamp": "02:02:34", "text": "计划是，呃，在日本你不能使用"}, {"type": "subtitle", "time": 7357.75, "timestamp": "02:02:37", "text": "呃，在那里你不能经常使用英语。不，"}, {"type": "subtitle", "time": 7360.39, "timestamp": "02:02:40", "text": "它完全是日式的。日本本地工作"}, {"type": "subtitle", "time": 7363.03, "timestamp": "02:02:43", "text": "一切。所以我正在计划……"}, {"type": "subtitle", "time": 7365.75, "timestamp": "02:02:45", "text": "问题是，我学习日语直到"}, {"type": "subtitle", "time": 7369.75, "timestamp": "02:02:49", "text": "商业级别 N2 或 N1 母语水平"}, {"type": "subtitle", "time": 7373.95, "timestamp": "02:02:53", "text": "最高级别的语言水平熟练度"}, {"type": "subtitle", "time": 7377.51, "timestamp": "02:02:57", "text": "等级。嗯，是的，我尽量那样做。"}]
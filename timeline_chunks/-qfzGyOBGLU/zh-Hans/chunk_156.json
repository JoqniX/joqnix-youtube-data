[{"type": "subtitle", "time": 9360.87, "timestamp": "02:36:00", "text": "Epic Games。如果你还没有认领"}, {"type": "subtitle", "time": 9363.03, "timestamp": "02:36:03", "text": "你可以认领它。"}, {"type": "subtitle", "time": 9366.07, "timestamp": "02:36:06", "text": "呃，我看过，我看过游戏画面了。"}, {"type": "subtitle", "time": 9368.309, "timestamp": "02:36:08", "text": "它的。太棒了。我等不及了。和"}, {"type": "subtitle", "time": 9372.309, "timestamp": "02:36:12", "text": "富士山真的很好，呃，你觉得呢？"}, {"type": "subtitle", "time": 9375.75, "timestamp": "02:36:15", "text": "叫它什么？ Adial 呃游戏。阿迪亚尔。他喜欢"}, {"type": "subtitle", "time": 9378.07, "timestamp": "02:36:18", "text": "ADAL 玩的就是这种游戏。他玩了很多"}, {"type": "subtitle", "time": 9380.15, "timestamp": "02:36:20", "text": "雷声之类的。所以我等不及了。"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "是的。显然，这次合作是"}, {"type": "subtitle", "time": 9384.469, "timestamp": "02:36:24", "text": "原本应该是上周五，但是"}, {"type": "subtitle", "time": 9387.429, "timestamp": "02:36:27", "text": "我忘了把它加上去。我不想"}, {"type": "subtitle", "time": 9389.59, "timestamp": "02:36:29", "text": "做了和我一样的事，我不小心也做了。"}, {"type": "subtitle", "time": 9391.67, "timestamp": "02:36:31", "text": "对于富士来说，就像在自行车前沿一样"}, {"type": "subtitle", "time": 9394.309, "timestamp": "02:36:34", "text": "合作中我忘了提到他"}, {"type": "subtitle", "time": 9397.429, "timestamp": "02:36:37", "text": "呃呃，日程安排，但这次我是"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "能够做到。是的，我很兴奋"}, {"type": "subtitle", "time": 9403.95, "timestamp": "02:36:43", "text": "周六的合作。那么，让我们开始吧！"}, {"type": "subtitle", "time": 9407.349, "timestamp": "02:36:47", "text": "最好的。嗯……我忘了我们本来应该……"}, {"type": "subtitle", "time": 9410.79, "timestamp": "02:36:50", "text": "呃，我忘了保留问答环节了。"}, {"type": "subtitle", "time": 9413.75, "timestamp": "02:36:53", "text": "东西。让我启用它。不挂断。让"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "我已启用问答功能，这样你就可以提问了。"}, {"type": "subtitle", "time": 9418.51, "timestamp": "02:36:58", "text": "问题"}]
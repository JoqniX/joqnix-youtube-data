[{"type": "subtitle", "time": 20706.628, "timestamp": "05:45:06", "text": "设备早就完成了。我不能。所以，"}, {"type": "subtitle", "time": 20710.788, "timestamp": "05:45:10", "text": "我们去加油站吧。"}, {"type": "subtitle", "time": 20718.548, "timestamp": "05:45:18", "text": "地方。到目前为止，是的，我遇到了三个人。"}, {"type": "subtitle", "time": 20727.23, "timestamp": "05:45:27", "text": "远的。他们三个都给了我"}, {"type": "subtitle", "time": 20730.548, "timestamp": "05:45:30", "text": "东西真的很好。我看到一个"}, {"type": "subtitle", "time": 20748.75, "timestamp": "05:45:48", "text": "有两个。把它们看作是"}]
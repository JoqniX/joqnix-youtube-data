[{"type": "subtitle", "time": 8530.389, "timestamp": "02:22:10", "text": "特点。我觉得卡塔福里奥是"}, {"type": "subtitle", "time": 8532.429, "timestamp": "02:22:12", "text": "好的"}, {"type": "subtitle", "time": 8536.55, "timestamp": "02:22:16", "text": "因发布同人作品而获得好评。我觉得我"}, {"type": "subtitle", "time": 8543.429, "timestamp": "02:22:23", "text": "这是一个非常……也不完全是。"}, {"type": "subtitle", "time": 8564.15, "timestamp": "02:22:44", "text": "正确的？是的。及时。是的。是的。是的。"}, {"type": "subtitle", "time": 8576.23, "timestamp": "02:22:56", "text": "人物。哦，这个我可以做我的"}, {"type": "subtitle", "time": 8578.87, "timestamp": "02:22:58", "text": "轮廓。好的，这里有一张粉丝艺术作品。"}]
[{"type": "subtitle", "time": 15307.59, "timestamp": "04:15:07", "text": "哦。我的天，好黑啊。所以，呃，首先"}, {"type": "subtitle", "time": 15308.75, "timestamp": "04:15:08", "text": "和"}, {"type": "subtitle", "time": 15310.269, "timestamp": "04:15:10", "text": "首先，"}, {"type": "subtitle", "time": 15313.469, "timestamp": "04:15:13", "text": "我们放"}, {"type": "subtitle", "time": 15317.67, "timestamp": "04:15:17", "text": "现在是早上，对吧？"}, {"type": "subtitle", "time": 15318.59, "timestamp": "04:15:18", "text": "首先和"}, {"type": "subtitle", "time": 15330.189, "timestamp": "04:15:30", "text": "上帝。"}, {"type": "subtitle", "time": 15333.309, "timestamp": "04:15:33", "text": "手工制作。好的。我的在哪里？"}, {"type": "subtitle", "time": 15336.03, "timestamp": "04:15:36", "text": "弓？"}, {"type": "subtitle", "time": 15338.71, "timestamp": "04:15:38", "text": "你好。哦，在这边。好的。所以，"}, {"type": "subtitle", "time": 15340.87, "timestamp": "04:15:40", "text": "咱们把这些东西扔掉吧。我"}, {"type": "subtitle", "time": 15342.03, "timestamp": "04:15:42", "text": "不需要"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "它。我也把这个扔出去。石头。"}, {"type": "subtitle", "time": 15346.92, "timestamp": "04:15:46", "text": "石头。 石头。优质矿石。好的。什么是"}, {"type": "subtitle", "time": 15350.8, "timestamp": "04:15:50", "text": "石头。优质矿石。好的。什么是 这？木制路障罩。好的。我们"}, {"type": "subtitle", "time": 15353.68, "timestamp": "04:15:53", "text": "这？木制路障罩。好的。我们 拿起猎弓。我们拿走袋子"}, {"type": "subtitle", "time": 15356.239, "timestamp": "04:15:56", "text": "拿起猎弓。我们拿走袋子 还有绷带。呃，我需要，我需要扔掉"}, {"type": "subtitle", "time": 15359.439, "timestamp": "04:15:59", "text": "还有绷带。呃，我需要，我需要扔掉 收拾一些东西。金属刀片。我接受"}]
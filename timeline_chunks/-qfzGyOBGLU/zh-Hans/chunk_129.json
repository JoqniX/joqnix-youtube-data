[{"type": "subtitle", "time": 7742.95, "timestamp": "02:09:02", "text": "堡垒之夜。堡垒之夜。那是我的第一次"}, {"type": "subtitle", "time": 7744.55, "timestamp": "02:09:04", "text": "游戏虽然有点……这就是我喜欢它的原因"}, {"type": "subtitle", "time": 7796.069, "timestamp": "02:09:56", "text": "什么？我现在想杀真正的孩子。"}, {"type": "subtitle", "time": 7799.79, "timestamp": "02:09:59", "text": "现在我知道我在哪里没说“实际”了"}]
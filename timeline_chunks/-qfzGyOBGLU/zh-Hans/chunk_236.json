[{"type": "subtitle", "time": 14165.11, "timestamp": "03:56:05", "text": "B. 什么也没有。石头在哪里？"}, {"type": "subtitle", "time": 14167.95, "timestamp": "03:56:07", "text": "为什么石头这么难雕琢？"}, {"type": "subtitle", "time": 14170.469, "timestamp": "03:56:10", "text": "寻找？你难道不喜欢捡起这些东西吗？"}, {"type": "subtitle", "time": 14172.95, "timestamp": "03:56:12", "text": "石头，或者说，如果是的话，那会是什么样子？"}, {"type": "subtitle", "time": 14175.269, "timestamp": "03:56:15", "text": "或者像《我的世界》之类的游戏，你可以玩，"}, {"type": "subtitle", "time": 14178.55, "timestamp": "03:56:18", "text": "你知道，攻击这些建筑"}, {"type": "subtitle", "time": 14180.75, "timestamp": "03:56:20", "text": "去拿东西。"}, {"type": "subtitle", "time": 14183.63, "timestamp": "03:56:23", "text": "是的，就像"}, {"type": "subtitle", "time": 14195.189, "timestamp": "03:56:35", "text": "什么？你什么时候有空？它"}, {"type": "subtitle", "time": 14198.15, "timestamp": "03:56:38", "text": "说实话，这要看情况。啊，我又回来了"}]
[{"type": "subtitle", "time": 21060.548, "timestamp": "05:51:00", "text": "在。好的。你最近怎么样？呃，艾德"}, {"type": "subtitle", "time": 21063.948, "timestamp": "05:51:03", "text": "白色标志。希望你一切都好。在"}, {"type": "subtitle", "time": 21068.47, "timestamp": "05:51:08", "text": "至少希望你一切都好。米娅。"}, {"type": "subtitle", "time": 21070.11, "timestamp": "05:51:10", "text": "哦，"}, {"type": "subtitle", "time": 21082.19, "timestamp": "05:51:22", "text": "帽子。真是个不寻常的宝藏地点啊！"}, {"type": "subtitle", "time": 21104.548, "timestamp": "05:51:44", "text": "我可以开这辆车吗？想象一下如果你能"}, {"type": "subtitle", "time": 21107.47, "timestamp": "05:51:47", "text": "开这辆车。但你需要补充燃料。"}, {"type": "subtitle", "time": 21111.51, "timestamp": "05:51:51", "text": "正确的？如果我能弄到一辆车就好了。"}]
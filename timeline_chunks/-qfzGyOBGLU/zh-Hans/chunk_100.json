[{"type": "subtitle", "time": 6000.31, "timestamp": "01:40:00", "text": "今天。我指的是今天的音乐环节。患病的"}, {"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "试着把作业做完。我会尽力"}, {"type": "subtitle", "time": 6004.229, "timestamp": "01:40:04", "text": "录制、保存项目或显示"}, {"type": "subtitle", "time": 6007.87, "timestamp": "01:40:07", "text": "在今天下午5:30的Zoom会议上。"}, {"type": "subtitle", "time": 6011.03, "timestamp": "01:40:11", "text": "班级。我们会尽力而为。呃，我只是"}, {"type": "subtitle", "time": 6013.47, "timestamp": "01:40:13", "text": "我想确保我涵盖所有内容。"}, {"type": "subtitle", "time": 6017.51, "timestamp": "01:40:17", "text": "主题。呃，我需要帮助，因为我"}, {"type": "subtitle", "time": 6020.79, "timestamp": "01:40:20", "text": "感觉自己在音乐方面遇到了困难。"}, {"type": "subtitle", "time": 6023.35, "timestamp": "01:40:23", "text": "我是否要禁止罢工？我不是"}, {"type": "subtitle", "time": 6027.109, "timestamp": "01:40:27", "text": "好的。哦，是木瓜汁。如何"}, {"type": "subtitle", "time": 6031.03, "timestamp": "01:40:31", "text": "你做？我不知道，伙计。说实话"}, {"type": "subtitle", "time": 6033.35, "timestamp": "01:40:33", "text": "与你。下次，就像那样"}, {"type": "subtitle", "time": 6037.31, "timestamp": "01:40:37", "text": "就在这一切发生之前，"}, {"type": "subtitle", "time": 6041.03, "timestamp": "01:40:41", "text": "正确的？我过去常常这样做"}, {"type": "subtitle", "time": 6043.189, "timestamp": "01:40:43", "text": "直播12小时。好的，我是12岁"}, {"type": "subtitle", "time": 6044.109, "timestamp": "01:40:44", "text": "小时"}, {"type": "subtitle", "time": 6047.109, "timestamp": "01:40:47", "text": "男。如果你仔细看，我大概会觉得你不错。"}, {"type": "subtitle", "time": 6049.669, "timestamp": "01:40:49", "text": "如果你环顾四周，你可能会……"}, {"type": "subtitle", "time": 6052.149, "timestamp": "01:40:52", "text": "我看到了BBC的文章，文章说："}, {"type": "subtitle", "time": 6054.87, "timestamp": "01:40:54", "text": "接下来是 Jockn，他直播 12 小时。"}, {"type": "subtitle", "time": 6057.189, "timestamp": "01:40:57", "text": "在 YouTube 上花几个小时之类的，对吧？"}]
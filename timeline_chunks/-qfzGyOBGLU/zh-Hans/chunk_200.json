[{"type": "subtitle", "time": 12002.309, "timestamp": "03:20:02", "text": "呃，你有吃的吗？我是"}, {"type": "subtitle", "time": 12004.19, "timestamp": "03:20:04", "text": "比如19"}, {"type": "subtitle", "time": 12008.269, "timestamp": "03:20:08", "text": "惠普。呃，谢谢。谢谢。感谢"}, {"type": "subtitle", "time": 12015.83, "timestamp": "03:20:15", "text": "上帝。我的天啊。我其实他其实"}, {"type": "subtitle", "time": 12019.19, "timestamp": "03:20:19", "text": "给了我东西。我的天啊。他其实"}, {"type": "subtitle", "time": 12025.19, "timestamp": "03:20:25", "text": "但这真的会增加我的"}, {"type": "subtitle", "time": 12033.83, "timestamp": "03:20:33", "text": "做。我的天啊。呃，去弄些木头。我有"}, {"type": "subtitle", "time": 12036.63, "timestamp": "03:20:36", "text": "木头。 830 木材。我不知道该怎么说"}, {"type": "subtitle", "time": 12048.75, "timestamp": "03:20:48", "text": "那。您无法加载作物"}]
[{"type": "subtitle", "time": 18000.628, "timestamp": "05:00:00", "text": "盒子。这是什么？齿轮。我觉得我"}, {"type": "subtitle", "time": 18002.75, "timestamp": "05:00:02", "text": "已经看过这个了"}, {"type": "subtitle", "time": 18006.75, "timestamp": "05:00:06", "text": "物品。我认为这很重要。我不"}, {"type": "subtitle", "time": 18011.15, "timestamp": "05:00:11", "text": "知道。呃，我有点需要"}, {"type": "subtitle", "time": 18014.07, "timestamp": "05:00:14", "text": "呃，我们要扔吗？你知道吗？患病的"}, {"type": "subtitle", "time": 18016.11, "timestamp": "05:00:16", "text": "只需移除"}, {"type": "subtitle", "time": 18025.43, "timestamp": "05:00:25", "text": "一个。还有更多路要走。好的。啊，"}, {"type": "subtitle", "time": 18028.11, "timestamp": "05:00:28", "text": "一把斧头。"}, {"type": "subtitle", "time": 18040.55, "timestamp": "05:00:40", "text": "这。想象一下，如果你摔倒了，你会……"}, {"type": "subtitle", "time": 18058.47, "timestamp": "05:00:58", "text": "人们。为什么我感觉它会……"}]
[{"type": "subtitle", "time": 19811.35, "timestamp": "05:30:11", "text": "它。我全拿走了。好的，不错。您好，我们"}, {"type": "subtitle", "time": 19818.15, "timestamp": "05:30:18", "text": "事物。我需要做一个你知道的"}, {"type": "subtitle", "time": 19820.39, "timestamp": "05:30:20", "text": "什么？我们把它放在这里。我们需要"}, {"type": "subtitle", "time": 19823.708, "timestamp": "05:30:23", "text": "脂肪"}, {"type": "subtitle", "time": 19828.91, "timestamp": "05:30:28", "text": "这边是骨头和肉。我拿"}, {"type": "subtitle", "time": 19834.27, "timestamp": "05:30:34", "text": "另一个在哪儿？胖的"}, {"type": "subtitle", "time": 19838.35, "timestamp": "05:30:38", "text": "骨。把骨头放进去。把"}, {"type": "subtitle", "time": 19848.51, "timestamp": "05:30:48", "text": "那。另一个"}]
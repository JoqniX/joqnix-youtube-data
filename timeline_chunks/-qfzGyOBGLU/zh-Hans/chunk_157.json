[{"type": "subtitle", "time": 9421.59, "timestamp": "02:37:01", "text": "溪流。好了，就到这里吧。"}, {"type": "subtitle", "time": 9424.27, "timestamp": "02:37:04", "text": "日程安排部分。记住，"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "呃，11月30日，你可以发送"}, {"type": "subtitle", "time": 9431.55, "timestamp": "02:37:11", "text": "你的生日祝福"}, {"type": "subtitle", "time": 9434.95, "timestamp": "02:37:14", "text": "Discord。呃，稍等一下。我需要躲起来"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "我的屏幕，因为我当时在我的私人服务器上。"}, {"type": "subtitle", "time": 9442.71, "timestamp": "02:37:22", "text": "之前因为我需要复制粘贴我的"}, {"type": "subtitle", "time": 9445.07, "timestamp": "02:37:25", "text": "备份"}, {"type": "subtitle", "time": 9449.349, "timestamp": "02:37:29", "text": "代码。别理我。是的。嗯……"}, {"type": "subtitle", "time": 9450.99, "timestamp": "02:37:30", "text": "你去。哦，"}, {"type": "subtitle", "time": 9453.15, "timestamp": "02:37:33", "text": "等待。"}, {"type": "subtitle", "time": 9456.91, "timestamp": "02:37:36", "text": "嗯，就是这样。好的，等等。让我来展示一下"}, {"type": "subtitle", "time": 9461.91, "timestamp": "02:37:41", "text": "这。你好。所以，嗯，30号那天我们会有一个"}, {"type": "subtitle", "time": 9463.91, "timestamp": "02:37:43", "text": "我会通过 Discord 宣布这件事。"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "也一样。所以，我们呃，这个频道生日快乐！"}, {"type": "subtitle", "time": 9468.63, "timestamp": "02:37:48", "text": "每个人都可以许愿。"}, {"type": "subtitle", "time": 9471.27, "timestamp": "02:37:51", "text": "你可以在这里发布你的生日祝福"}, {"type": "subtitle", "time": 9473.91, "timestamp": "02:37:53", "text": "我明白了，就像我们之前做的那样。"}, {"type": "subtitle", "time": 9478.15, "timestamp": "02:37:58", "text": "最近两三次航行（包括我）"}]
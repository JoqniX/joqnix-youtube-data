[{"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "店铺？等等，什么？绿卡。什么是"}, {"type": "subtitle", "time": 13204.51, "timestamp": "03:40:04", "text": "绿色的"}, {"type": "subtitle", "time": 13207.83, "timestamp": "03:40:07", "text": "卡片？是的。呃，我们走吧。我要"}, {"type": "subtitle", "time": 13224.389, "timestamp": "03:40:24", "text": "后退？一个陷阱。半自动机身。"}, {"type": "subtitle", "time": 13232.91, "timestamp": "03:40:32", "text": "有人为此开设了店铺吗？"}, {"type": "subtitle", "time": 13236.67, "timestamp": "03:40:36", "text": "某物？复合弓。等待，"}, {"type": "subtitle", "time": 13239.99, "timestamp": "03:40:39", "text": "什么？等等，这绳子我可以买两根。"}, {"type": "subtitle", "time": 13247.15, "timestamp": "03:40:47", "text": "那。哦，你们在开派对吗？"}, {"type": "subtitle", "time": 13259.11, "timestamp": "03:40:59", "text": "我做了些蠢事，然后我失去了我唯一的"}]
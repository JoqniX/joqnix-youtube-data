[{"type": "subtitle", "time": 15060.59, "timestamp": "04:11:00", "text": "不需要拨片。呃，我们会做一个"}, {"type": "subtitle", "time": 15063.79, "timestamp": "04:11:03", "text": "斧头。我们将制作一个"}, {"type": "subtitle", "time": 15066.55, "timestamp": "04:11:06", "text": "营火。那个建筑工人，把这个递给我"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "也一样。嗯，我们还会做一个储物间。"}, {"type": "subtitle", "time": 15078.51, "timestamp": "04:11:18", "text": "出色地。"}, {"type": "subtitle", "time": 15104.07, "timestamp": "04:11:44", "text": "啊，这里是宝可梦主车库"}, {"type": "subtitle", "time": 15118.83, "timestamp": "04:11:58", "text": "这里？这是……这是我要说的。"}]
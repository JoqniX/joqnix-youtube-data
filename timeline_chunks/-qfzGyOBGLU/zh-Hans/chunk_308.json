[{"type": "subtitle", "time": 18519.03, "timestamp": "05:08:39", "text": "结尾。哦，那闪电真壮观。那是"}, {"type": "subtitle", "time": 18521.47, "timestamp": "05:08:41", "text": "太酷了。"}, {"type": "subtitle", "time": 18524.628, "timestamp": "05:08:44", "text": "好的。呃，还记得乔克吗？你当时在哪儿？"}, {"type": "subtitle", "time": 18526.27, "timestamp": "05:08:46", "text": "把你的"}, {"type": "subtitle", "time": 18528.868, "timestamp": "05:08:48", "text": "家？对，就是这里。哦，那里"}, {"type": "subtitle", "time": 18532.788, "timestamp": "05:08:52", "text": "你是。我的家。温馨的家。我的天啊，"}, {"type": "subtitle", "time": 18534.868, "timestamp": "05:08:54", "text": "我到家了。"}, {"type": "subtitle", "time": 18536.99, "timestamp": "05:08:56", "text": "乔克回来了"}, {"type": "subtitle", "time": 18539.07, "timestamp": "05:08:59", "text": "家。"}]
[{"type": "subtitle", "time": 21540.83, "timestamp": "05:59:00", "text": "渲染相关的东西？呃，我有一块RTX显卡。"}, {"type": "subtitle", "time": 21543.868, "timestamp": "05:59:03", "text": "2060年即将到来"}, {"type": "subtitle", "time": 21547.39, "timestamp": "05:59:07", "text": "死了，但它仍然活着"}, {"type": "subtitle", "time": 21550.868, "timestamp": "05:59:10", "text": "虽然有点奇怪，但确实管用。这就是我"}, {"type": "subtitle", "time": 21557.35, "timestamp": "05:59:17", "text": "和。但问题是我不应该跑"}, {"type": "subtitle", "time": 21560.708, "timestamp": "05:59:20", "text": "背景中的任何事物。如果我这样做"}, {"type": "subtitle", "time": 21563.788, "timestamp": "05:59:23", "text": "会彻底崩溃"}, {"type": "subtitle", "time": 21566.19, "timestamp": "05:59:26", "text": "PC，也就是"}, {"type": "subtitle", "time": 21568.788, "timestamp": "05:59:28", "text": "难的。我认为这是因为……"}, {"type": "subtitle", "time": 21570.708, "timestamp": "05:59:30", "text": "温度问题，还有粘性。"}, {"type": "subtitle", "time": 21573.35, "timestamp": "05:59:33", "text": "风扇问题。它变得非常不稳定"}, {"type": "subtitle", "time": 21576.948, "timestamp": "05:59:36", "text": "片刻。是的，我的处理器是……"}]
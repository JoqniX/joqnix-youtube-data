[{"type": "subtitle", "time": 3304.829, "timestamp": "00:55:04", "text": "知道。新来的是个小鲜肉。什么是"}, {"type": "subtitle", "time": 3312.95, "timestamp": "00:55:12", "text": "星星。我很担心，伙计。以及新的"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "该型号将配备很多"}, {"type": "subtitle", "time": 3317.75, "timestamp": "00:55:17", "text": "指控以及所有的一切，因为如何"}, {"type": "subtitle", "time": 3321.349, "timestamp": "00:55:21", "text": "就其外观和我自己的指控而言"}, {"type": "subtitle", "time": 3327.67, "timestamp": "00:55:27", "text": "人们在此说一些事情，或者它"}, {"type": "subtitle", "time": 3331.349, "timestamp": "00:55:31", "text": "很适合我，但感觉就像我必须成为那样"}, {"type": "subtitle", "time": 3334.39, "timestamp": "00:55:34", "text": "做好心理准备接受这些东西"}, {"type": "subtitle", "time": 3336.43, "timestamp": "00:55:36", "text": "就像"}, {"type": "subtitle", "time": 3350.069, "timestamp": "00:55:50", "text": "昨天有人过来……"}, {"type": "subtitle", "time": 3352.63, "timestamp": "00:55:52", "text": "有人在直播中聊天，这是他第一次聊天。"}, {"type": "subtitle", "time": 3354.43, "timestamp": "00:55:54", "text": "时间我"}, {"type": "subtitle", "time": 3358.27, "timestamp": "00:55:58", "text": "猜测。呃，第一件事是"}]
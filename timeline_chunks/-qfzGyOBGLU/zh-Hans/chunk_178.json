[{"type": "subtitle", "time": 10680.309, "timestamp": "02:58:00", "text": "我的背景，对吧？你们想要吗？"}, {"type": "subtitle", "time": 10682.23, "timestamp": "02:58:02", "text": "背景图，还是你们想要这个？"}, {"type": "subtitle", "time": 10685.38, "timestamp": "02:58:05", "text": "游戏的音频？"}, {"type": "subtitle", "time": 10698.95, "timestamp": "02:58:18", "text": "[笑声]"}, {"type": "subtitle", "time": 10707.75, "timestamp": "02:58:27", "text": "独自的。于是，我弄到了一些木头。我什么"}, {"type": "subtitle", "time": 10715.03, "timestamp": "02:58:35", "text": "营火。我可以制作一把锤子。好的，"}, {"type": "subtitle", "time": 10717.55, "timestamp": "02:58:37", "text": "我们将打造一把锤子"}, {"type": "subtitle", "time": 10720.55, "timestamp": "02:58:40", "text": "出色地。这不是建筑设计图。出色地"}, {"type": "subtitle", "time": 10729.55, "timestamp": "02:58:49", "text": "工艺？创造。我"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "等待。不，那是团队。呃，等等。如何"}, {"type": "subtitle", "time": 10734.67, "timestamp": "02:58:54", "text": "我在做手工吗？"}, {"type": "subtitle", "time": 10737.99, "timestamp": "02:58:57", "text": "好的。哦，它会自动制作。"}]
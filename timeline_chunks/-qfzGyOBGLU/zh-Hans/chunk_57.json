[{"type": "subtitle", "time": 3428.71, "timestamp": "00:57:08", "text": "我昨天意识到我崩溃了。我"}, {"type": "subtitle", "time": 3432.069, "timestamp": "00:57:12", "text": "昨天学到这个词。崩溃了"}, {"type": "subtitle", "time": 3435.27, "timestamp": "00:57:15", "text": "我正在使用它。哇。我了解到"}, {"type": "subtitle", "time": 3437.75, "timestamp": "00:57:17", "text": "明白了崩溃的含义"}, {"type": "subtitle", "time": 3440.87, "timestamp": "00:57:20", "text": "我也用过。我的一个朋友，我"}, {"type": "subtitle", "time": 3442.67, "timestamp": "00:57:22", "text": "曾在VC上谈过"}, {"type": "subtitle", "time": 3445.51, "timestamp": "00:57:25", "text": "昨天你们聊得好像……"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "当时在 BRB。我当时就像隐形人一样，而且"}, {"type": "subtitle", "time": 3452.03, "timestamp": "00:57:32", "text": "会议和帮助人们的事情"}, {"type": "subtitle", "time": 3455.19, "timestamp": "00:57:35", "text": "东西。就像他们说的关于"}, {"type": "subtitle", "time": 3456.67, "timestamp": "00:57:36", "text": "崩溃了"}, {"type": "subtitle", "time": 3460.47, "timestamp": "00:57:40", "text": "我每次听到这个词都会想：哦，这真是个新词啊！"}, {"type": "subtitle", "time": 3463.63, "timestamp": "00:57:43", "text": "从未听说过或使用过"}, {"type": "subtitle", "time": 3470.95, "timestamp": "00:57:50", "text": "实际上。我可能确实遇到了崩溃。"}, {"type": "subtitle", "time": 3473.069, "timestamp": "00:57:53", "text": "昨晚。我"}, {"type": "subtitle", "time": 3476.43, "timestamp": "00:57:56", "text": "意思是，午夜，不是"}, {"type": "subtitle", "time": 3479.87, "timestamp": "00:57:59", "text": "午夜。嗯，是的。 6:00"}]
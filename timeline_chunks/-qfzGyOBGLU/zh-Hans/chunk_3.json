[{"type": "subtitle", "time": 184.07, "timestamp": "00:03:04", "text": "呃，是的，我喝了我的屁股"}, {"type": "subtitle", "time": 186.309, "timestamp": "00:03:06", "text": "现在感觉神清气爽。为什么会这样？"}, {"type": "subtitle", "time": 188.99, "timestamp": "00:03:08", "text": "感觉如此"}, {"type": "subtitle", "time": 191.35, "timestamp": "00:03:11", "text": "新鲜的？太酷了。我没想到"}, {"type": "subtitle", "time": 192.83, "timestamp": "00:03:12", "text": "忙碌就像"}, {"type": "subtitle", "time": 197.47, "timestamp": "00:03:17", "text": "我猜大概三周吧。两周前"}, {"type": "subtitle", "time": 200.03, "timestamp": "00:03:20", "text": "猜测"}, {"type": "subtitle", "time": 203.79, "timestamp": "00:03:23", "text": "大约230，而且显而易见。"}, {"type": "subtitle", "time": 207.67000000000002, "timestamp": "00:03:27", "text": "坐着。不。呃，是的，但我们当时就像是向上"}, {"type": "subtitle", "time": 212.35, "timestamp": "00:03:32", "text": "电脑引起的比特率波动"}, {"type": "subtitle", "time": 214.949, "timestamp": "00:03:34", "text": "硬币，但那是唯一的东西，但我"}, {"type": "subtitle", "time": 217.19, "timestamp": "00:03:37", "text": "切换了 Caster Labs 多主播"}, {"type": "subtitle", "time": 220.35, "timestamp": "00:03:40", "text": "服务器将切换到新加坡，而不是新加坡。"}, {"type": "subtitle", "time": 222.589, "timestamp": "00:03:42", "text": "美国"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "所以不是俄勒冈州的服务器，而是西部的服务器。"}, {"type": "subtitle", "time": 228.789, "timestamp": "00:03:48", "text": "就像真正的新加坡服务器一样"}, {"type": "subtitle", "time": 232.67000000000002, "timestamp": "00:03:52", "text": "延迟和其他方面都会有所改善。"}, {"type": "subtitle", "time": 234.35, "timestamp": "00:03:54", "text": "是的。"}, {"type": "subtitle", "time": 238.47, "timestamp": "00:03:58", "text": "是的，我需要支付明年四月的费用。呃"}]
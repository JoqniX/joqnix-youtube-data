[{"type": "subtitle", "time": 7620.629, "timestamp": "02:07:00", "text": "是的，我回来了，我只是想回来。"}, {"type": "subtitle", "time": 7622.47, "timestamp": "02:07:02", "text": "呃，进入娱乐行业工作或者"}, {"type": "subtitle", "time": 7626.47, "timestamp": "02:07:06", "text": "一些事情，并尝试推广我的"}, {"type": "subtitle", "time": 7628.709, "timestamp": "02:07:08", "text": "印第安人，来你的灌木丛之类的吧"}, {"type": "subtitle", "time": 7632.709, "timestamp": "02:07:12", "text": "还有，呃，带我……呃，带我……旅程"}, {"type": "subtitle", "time": 7636.75, "timestamp": "02:07:16", "text": "运动员旁边是更广泛的观众"}, {"type": "subtitle", "time": 7639.91, "timestamp": "02:07:19", "text": "并获得更多机会。或许会成为"}, {"type": "subtitle", "time": 7643.069, "timestamp": "02:07:23", "text": "偶像。我不知道是否"}, {"type": "subtitle", "time": 7645.51, "timestamp": "02:07:25", "text": "可能的。我怀疑我能否成为一名"}, {"type": "subtitle", "time": 7648.069, "timestamp": "02:07:28", "text": "偶像。但确实，不会有什么坏处。"}, {"type": "subtitle", "time": 7652.83, "timestamp": "02:07:32", "text": "[音乐]"}, {"type": "subtitle", "time": 7655.669, "timestamp": "02:07:35", "text": "尝试。那时他没有，他没有"}, {"type": "subtitle", "time": 7658.07, "timestamp": "02:07:38", "text": "他现在所拥有的知识已经相当丰富了。"}, {"type": "subtitle", "time": 7661.149, "timestamp": "02:07:41", "text": "[音乐]"}, {"type": "subtitle", "time": 7667.08, "timestamp": "02:07:47", "text": "知道。"}]
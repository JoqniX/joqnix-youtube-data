[{"type": "subtitle", "time": 7442.0, "timestamp": "02:04:02", "text": "给他们打电话，看看"}, {"type": "subtitle", "time": 7443.229, "timestamp": "02:04:03", "text": "[音乐]"}, {"type": "subtitle", "time": 7449.91, "timestamp": "02:04:09", "text": "呃，但是，呃，是啊，呃，它叫什么来着？"}, {"type": "subtitle", "time": 7452.47, "timestamp": "02:04:12", "text": "嗯，对于日本来说，我希望会有……"}, {"type": "subtitle", "time": 7457.03, "timestamp": "02:04:17", "text": "有办法，总有办法，但是，嗯，我想……"}, {"type": "subtitle", "time": 7458.629, "timestamp": "02:04:18", "text": "有国际分部或"}, {"type": "subtitle", "time": 7460.39, "timestamp": "02:04:20", "text": "这样我就可以在线参加考试了。"}, {"type": "subtitle", "time": 7463.43, "timestamp": "02:04:23", "text": "而不是返回印度"}, {"type": "subtitle", "time": 7466.91, "timestamp": "02:04:26", "text": "现在机票很贵，要40000。"}, {"type": "subtitle", "time": 7469.709, "timestamp": "02:04:29", "text": "D航班机票是"}, {"type": "subtitle", "time": 7472.35, "timestamp": "02:04:32", "text": "像40000次来回一样"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "兄弟，我没钱拿奖学金。"}, {"type": "subtitle", "time": 7478.55, "timestamp": "02:04:38", "text": "你知道我的老师有奖学金吗？"}, {"type": "subtitle", "time": 7480.99, "timestamp": "02:04:40", "text": "可以来"}, {"type": "subtitle", "time": 7484.629, "timestamp": "02:04:44", "text": "容易地。无需任何费用。是的，他们"}, {"type": "subtitle", "time": 7487.79, "timestamp": "02:04:47", "text": "奖学金涵盖相关费用。"}, {"type": "subtitle", "time": 7492.149, "timestamp": "02:04:52", "text": "是的。我得努力学习才行。我的老师"}, {"type": "subtitle", "time": 7495.43, "timestamp": "02:04:55", "text": "呃，我的老师他学过日语"}, {"type": "subtitle", "time": 7498.709, "timestamp": "02:04:58", "text": "从印度的家乡一直到N1和"}]
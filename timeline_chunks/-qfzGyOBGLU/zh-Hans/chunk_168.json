[{"type": "subtitle", "time": 10080.389, "timestamp": "02:48:00", "text": "老兵和仅限PVP的团队信息玩家"}, {"type": "subtitle", "time": 10082.87, "timestamp": "02:48:02", "text": "在团队信息中查看老将姓名。"}, {"type": "subtitle", "time": 10086.67, "timestamp": "02:48:06", "text": "好的。好的。所以，首先，首先"}, {"type": "subtitle", "time": 10089.23, "timestamp": "02:48:09", "text": "我需要做的事"}, {"type": "subtitle", "time": 10092.469, "timestamp": "02:48:12", "text": "因为我没有降低我的图形设置，所以我的图形设置比较低。"}, {"type": "subtitle", "time": 10097.87, "timestamp": "02:48:17", "text": "去"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "糟糕。呃，我不想游戏崩溃。"}, {"type": "subtitle", "time": 10107.79, "timestamp": "02:48:27", "text": "时间。"}, {"type": "subtitle", "time": 10111.99, "timestamp": "02:48:31", "text": "呃，我应该把这些调低吗？公司回来了。我是"}, {"type": "subtitle", "time": 10114.07, "timestamp": "02:48:34", "text": "我要怼这条评论。是的，我们"}, {"type": "subtitle", "time": 10115.469, "timestamp": "02:48:35", "text": "应该打他"}, {"type": "subtitle", "time": 10130.03, "timestamp": "02:48:50", "text": "呃，图像特效。是什么"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "这？环境音乐合集。镜头运动"}, {"type": "subtitle", "time": 10136.83, "timestamp": "02:48:56", "text": "模糊。我不喜欢动态模糊效果。制造"}, {"type": "subtitle", "time": 10139.99, "timestamp": "02:48:59", "text": "音乐。音量。好的。掌握"}]
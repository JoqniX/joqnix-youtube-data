[{"type": "subtitle", "time": 4681.87, "timestamp": "01:18:01", "text": "是的。我的意思是，我们有四个部分，但是"}, {"type": "subtitle", "time": 4684.63, "timestamp": "01:18:04", "text": "是的，其中一个环节是睡觉。"}, {"type": "subtitle", "time": 4687.669, "timestamp": "01:18:07", "text": "昨天我完成了一半的片段"}, {"type": "subtitle", "time": 4693.11, "timestamp": "01:18:13", "text": "我猜是从凌晨3点到6点。我做了，我做了"}, {"type": "subtitle", "time": 4695.55, "timestamp": "01:18:15", "text": "我直播了6场3分钟。"}, {"type": "subtitle", "time": 4698.03, "timestamp": "01:18:18", "text": "大约几个小时。不，不，不，不。 6"}, {"type": "subtitle", "time": 4701.35, "timestamp": "01:18:21", "text": "大约几个小时。现在游戏时间3小时，3小时"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "第四季度睡眠不足。"}, {"type": "subtitle", "time": 4713.79, "timestamp": "01:18:33", "text": "是的。所以，我打算做音乐。"}, {"type": "subtitle", "time": 4718.55, "timestamp": "01:18:38", "text": "今天我计划完成一些工作。"}, {"type": "subtitle", "time": 4721.87, "timestamp": "01:18:41", "text": "通过合作。塔和"}, {"type": "subtitle", "time": 4724.75, "timestamp": "01:18:44", "text": "一切。我的意思是，合作者并非"}, {"type": "subtitle", "time": 4726.75, "timestamp": "01:18:46", "text": "一定"}, {"type": "subtitle", "time": 4731.91, "timestamp": "01:18:51", "text": "需要，但是，嗯，这很难，但是我"}, {"type": "subtitle", "time": 4735.27, "timestamp": "01:18:55", "text": "感觉今天可能会很累，因为"}, {"type": "subtitle", "time": 4736.87, "timestamp": "01:18:56", "text": "一切。我不想有这种感觉"}]
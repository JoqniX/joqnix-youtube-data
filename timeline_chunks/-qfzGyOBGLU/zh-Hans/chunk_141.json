[{"type": "subtitle", "time": 8462.03, "timestamp": "02:21:02", "text": "等等，那可真是个大问题"}, {"type": "subtitle", "time": 8466.07, "timestamp": "02:21:06", "text": "事物。打扰一下。这是件大事。"}, {"type": "subtitle", "time": 8469.309, "timestamp": "02:21:09", "text": "勇敢的团队真是太棒了。"}, {"type": "subtitle", "time": 8473.27, "timestamp": "02:21:13", "text": "什么？ Brave Group 是我们的合作伙伴。我可以"}, {"type": "subtitle", "time": 8476.07, "timestamp": "02:21:16", "text": "能帮到你吗？哦，该死。该死。该死。"}, {"type": "subtitle", "time": 8476.44, "timestamp": "02:21:16", "text": "该死。 [音乐]"}, {"type": "subtitle", "time": 8477.8, "timestamp": "02:21:17", "text": "[音乐] 该死。我们将赠送观看门票"}, {"type": "subtitle", "time": 8480.319, "timestamp": "02:21:20", "text": "该死。我们将赠送观看门票 这。哦，不错。"}, {"type": "subtitle", "time": 8487.15, "timestamp": "02:21:27", "text": "特邀艺术家舞台。"}, {"type": "subtitle", "time": 8490.469, "timestamp": "02:21:30", "text": "等待临时三月。哦，应用程序"}, {"type": "subtitle", "time": 8498.309, "timestamp": "02:21:38", "text": "我认为它就在奖励层里。"}, {"type": "subtitle", "time": 8499.99, "timestamp": "02:21:39", "text": "这些人正在投票支持"}, {"type": "subtitle", "time": 8503.51, "timestamp": "02:21:43", "text": "呃，那些在“是的，库尼”的人"}, {"type": "subtitle", "time": 8504.99, "timestamp": "02:21:44", "text": "还"}, {"type": "subtitle", "time": 8508.429, "timestamp": "02:21:48", "text": "这里。所以，走吧"}, {"type": "subtitle", "time": 8512.309, "timestamp": "02:21:52", "text": "现在。如果铁鼠计划结束了，她就会……"}]
[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "指导原则。他们有“我的天哪，这……”"}, {"type": "subtitle", "time": 8586.91, "timestamp": "02:23:06", "text": "好得多。这样好多了。哦，我的"}, {"type": "subtitle", "time": 8589.67, "timestamp": "02:23:09", "text": "上帝。粉丝作品要求。好的，你可以"}, {"type": "subtitle", "time": 8606.63, "timestamp": "02:23:26", "text": "凉爽的。我的天哪，这太酷了！我想"}, {"type": "subtitle", "time": 8608.03, "timestamp": "02:23:28", "text": "要做"}, {"type": "subtitle", "time": 8618.07, "timestamp": "02:23:38", "text": "少量。她走了。我们可以把吉祥物放进去"}, {"type": "subtitle", "time": 8619.389, "timestamp": "02:23:39", "text": "超过"}, {"type": "subtitle", "time": 8623.309, "timestamp": "02:23:43", "text": "这里。呃，音乐会的所有吉祥物"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "飞机，因为我想让每个人都……"}, {"type": "subtitle", "time": 8628.79, "timestamp": "02:23:48", "text": "每个人都有自己独特的特点。"}]
[{"type": "subtitle", "time": 3545.63, "timestamp": "00:59:05", "text": "一。我的动作是"}, {"type": "subtitle", "time": 3547.87, "timestamp": "00:59:07", "text": "顶峰。但"}, {"type": "subtitle", "time": 3551.43, "timestamp": "00:59:11", "text": "是的。哦，当时已经很晚了。哦，我当时真是太"}, {"type": "subtitle", "time": 3561.19, "timestamp": "00:59:21", "text": "所以，是的，我会去。现在是10点12分。患病的"}, {"type": "subtitle", "time": 3564.789, "timestamp": "00:59:24", "text": "我去吃早餐，刷牙。"}, {"type": "subtitle", "time": 3566.99, "timestamp": "00:59:26", "text": "洗个澡，一切恢复正常"}, {"type": "subtitle", "time": 3571.39, "timestamp": "00:59:31", "text": "我。问题是我无法保留我的"}, {"type": "subtitle", "time": 3573.67, "timestamp": "00:59:33", "text": "讲师。我今天有课，对吧？"}, {"type": "subtitle", "time": 3576.95, "timestamp": "00:59:36", "text": "我真的必须提交一些东西。"}, {"type": "subtitle", "time": 3578.87, "timestamp": "00:59:38", "text": "今天。"}, {"type": "subtitle", "time": 3582.03, "timestamp": "00:59:42", "text": "事实是我"}, {"type": "subtitle", "time": 3587.109, "timestamp": "00:59:47", "text": "我无法接受我甚至都保存不了它的事实。"}]
[{"type": "subtitle", "time": 1502.87, "timestamp": "00:25:02", "text": "剩余天数（不包括今天）"}, {"type": "subtitle", "time": 1505.43, "timestamp": "00:25:05", "text": "还有四天就到期了，我得付钱，但我没钱。"}, {"type": "subtitle", "time": 1507.149, "timestamp": "00:25:07", "text": "有钱"}, {"type": "subtitle", "time": 1523.31, "timestamp": "00:25:23", "text": "我得走出舒适圈了。"}, {"type": "subtitle", "time": 1526.87, "timestamp": "00:25:26", "text": "所以，去做事，多做事，做很多事。"}]
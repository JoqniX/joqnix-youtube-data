[{"type": "subtitle", "time": 5643.39, "timestamp": "01:34:03", "text": "这。我不想盗版"}, {"type": "subtitle", "time": 5647.709, "timestamp": "01:34:07", "text": "它。比如，最好还是付钱。"}, {"type": "subtitle", "time": 5650.55, "timestamp": "01:34:10", "text": "正确的？仅仅过了12个月，之后"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "那份我可以永远拥有。但我只是"}, {"type": "subtitle", "time": 5657.03, "timestamp": "01:34:17", "text": "希望 Ableton Live 13 别来。"}, {"type": "subtitle", "time": 5659.83, "timestamp": "01:34:19", "text": "近期内不会。如果它来了，我就得买。"}, {"type": "subtitle", "time": 5664.229, "timestamp": "01:34:24", "text": "13，男。从第12花色转移到第13花色"}, {"type": "subtitle", "time": 5668.189, "timestamp": "01:34:28", "text": "套装。那将是"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "昂贵的。这些许可证，伙计，"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "这些软件，其他所有软件都是"}, {"type": "subtitle", "time": 5677.11, "timestamp": "01:34:37", "text": "像这样。只有FO Studio是这样的"}, {"type": "subtitle", "time": 5683.75, "timestamp": "01:34:43", "text": "更新。但如果迎来重大更新"}, {"type": "subtitle", "time": 5690.629, "timestamp": "01:34:50", "text": "他们应该发布大约10次更新，"}, {"type": "subtitle", "time": 5691.87, "timestamp": "01:34:51", "text": "正确的？"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "说实话，他们为什么要加这个？甚至"}, {"type": "subtitle", "time": 5697.99, "timestamp": "01:34:57", "text": "Clip Studio Paint 也是一样的。"}]
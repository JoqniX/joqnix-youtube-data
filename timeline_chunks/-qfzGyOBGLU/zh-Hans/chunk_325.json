[{"type": "subtitle", "time": 19502.47, "timestamp": "05:25:02", "text": "我该去吃晚饭了。我必须"}, {"type": "subtitle", "time": 19503.55, "timestamp": "05:25:03", "text": "吃晚饭。"}, {"type": "subtitle", "time": 19507.11, "timestamp": "05:25:07", "text": "是的，我会这么做。我们会回去"}, {"type": "subtitle", "time": 19509.77, "timestamp": "05:25:09", "text": "再次开始狩猎。"}, {"type": "subtitle", "time": 19512.67, "timestamp": "05:25:12", "text": "[音乐]"}, {"type": "subtitle", "time": 19515.75, "timestamp": "05:25:15", "text": "呃，我把这东西放哪儿了？好的，"}, {"type": "subtitle", "time": 19524.07, "timestamp": "05:25:24", "text": "是。能承受这么多子弹。"}, {"type": "subtitle", "time": 19526.15, "timestamp": "05:25:26", "text": "我的意思是，我们只能拿一叠，我"}, {"type": "subtitle", "time": 19528.47, "timestamp": "05:25:28", "text": "相信。那有什么好处呢？"}, {"type": "subtitle", "time": 19537.91, "timestamp": "05:25:37", "text": "好的。不过我饿坏了。我需要食物。"}, {"type": "subtitle", "time": 19547.628, "timestamp": "05:25:47", "text": "片段。哦不，我没有"}, {"type": "subtitle", "time": 19550.99, "timestamp": "05:25:50", "text": "更多生猪肉。好的。呃，你知道的"}]
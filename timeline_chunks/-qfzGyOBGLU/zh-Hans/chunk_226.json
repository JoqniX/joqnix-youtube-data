[{"type": "subtitle", "time": 13579.03, "timestamp": "03:46:19", "text": "疼痛。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 13581.99, "timestamp": "03:46:21", "text": "没关系。唐纳德·德里夫特，我来了"}, {"type": "subtitle", "time": 13584.95, "timestamp": "03:46:24", "text": "为你。未来。我来找你了。我是"}, {"type": "subtitle", "time": 13596.71, "timestamp": "03:46:36", "text": "时间。我对此一无所知。制作"}, {"type": "subtitle", "time": 13599.189, "timestamp": "03:46:39", "text": "睡袋。哦，我需要制作一个"}, {"type": "subtitle", "time": 13601.83, "timestamp": "03:46:41", "text": "用睡袋设置重生点。"}, {"type": "subtitle", "time": 13608.67, "timestamp": "03:46:48", "text": "学习。我的天哪。那么，首先……"}, {"type": "subtitle", "time": 13610.83, "timestamp": "03:46:50", "text": "第一的，"}, {"type": "subtitle", "time": 13613.63, "timestamp": "03:46:53", "text": "我们得到"}]
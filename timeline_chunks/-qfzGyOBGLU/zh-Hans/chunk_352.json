[{"type": "subtitle", "time": 21136.39, "timestamp": "05:52:16", "text": "啊，版权。版权。版权。哦"}, {"type": "subtitle", "time": 21140.03, "timestamp": "05:52:20", "text": "上帝。版权。我知道那首歌。那是"}, {"type": "subtitle", "time": 21142.91, "timestamp": "05:52:22", "text": "版权。我的天啊。 WHO"}, {"type": "subtitle", "time": 21153.07, "timestamp": "05:52:33", "text": "有人放了个收音机之类的东西，然后放了一个"}, {"type": "subtitle", "time": 21156.628, "timestamp": "05:52:36", "text": "歌曲。我的天啊。还有，等等，这是什么？"}, {"type": "subtitle", "time": 21166.75, "timestamp": "05:52:46", "text": "[音乐]"}, {"type": "subtitle", "time": 21169.43, "timestamp": "05:52:49", "text": "上帝。至少我们还能弄到些木头。我们"}, {"type": "subtitle", "time": 21173.18, "timestamp": "05:52:53", "text": "弄了些动物脂肪之类的东西。"}, {"type": "subtitle", "time": 21177.51, "timestamp": "05:52:57", "text": "[音乐]"}]
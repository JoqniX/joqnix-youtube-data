[{"type": "subtitle", "time": 483.749, "timestamp": "00:08:03", "text": "今天。天哪，Aster 的东西真多啊"}, {"type": "subtitle", "time": 487.11, "timestamp": "00:08:07", "text": "这样做简直是疯了。"}, {"type": "subtitle", "time": 489.71, "timestamp": "00:08:09", "text": "他自掏腰包支付了很多钱。"}, {"type": "subtitle", "time": 492.749, "timestamp": "00:08:12", "text": "口袋里专门用来装这个"}, {"type": "subtitle", "time": 495.43, "timestamp": "00:08:15", "text": "事件。你必须支付双倍的金额"}, {"type": "subtitle", "time": 498.909, "timestamp": "00:08:18", "text": "现在只需要处理服务器问题了。"}, {"type": "subtitle", "time": 502.189, "timestamp": "00:08:22", "text": "一切。想象一下"}, {"type": "subtitle", "time": 504.35, "timestamp": "00:08:24", "text": "兄弟，他是"}, {"type": "subtitle", "time": 507.07, "timestamp": "00:08:27", "text": "疯狂的。他真的很有热情。"}]
[{"type": "subtitle", "time": 19141.51, "timestamp": "05:19:01", "text": "呃，发生了一些不幸的事情。"}, {"type": "subtitle", "time": 19146.628, "timestamp": "05:19:06", "text": "今天。我的育碧账号彻底丢失了。"}, {"type": "subtitle", "time": 19148.47, "timestamp": "05:19:08", "text": "我联系了客服，但他们也无能为力。"}, {"type": "subtitle", "time": 19150.47, "timestamp": "05:19:10", "text": "请帮我找回我的账号。"}, {"type": "subtitle", "time": 19154.15, "timestamp": "05:19:14", "text": "他们给了我一个提示，主人，主人"}, {"type": "subtitle", "time": 19157.67, "timestamp": "05:19:17", "text": "我的账户 Jocknik 的电子邮件地址"}, {"type": "subtitle", "time": 19160.788, "timestamp": "05:19:20", "text": "它关联的电子邮件帐户"}, {"type": "subtitle", "time": 19163.47, "timestamp": "05:19:23", "text": "显然有人黑了系统。"}, {"type": "subtitle", "time": 19167.03, "timestamp": "05:19:27", "text": "它。这不是我提供的邮箱地址。"}, {"type": "subtitle", "time": 19169.83, "timestamp": "05:19:29", "text": "这就是我没有收到“忘记”的原因。"}, {"type": "subtitle", "time": 19172.628, "timestamp": "05:19:32", "text": "密码什么的，我弄丢了，他们"}, {"type": "subtitle", "time": 19175.03, "timestamp": "05:19:35", "text": "完全帮不了我。我甚至甚至"}, {"type": "subtitle", "time": 19178.868, "timestamp": "05:19:38", "text": "虽然我提供了我的呃，我买了彩虹"}, {"type": "subtitle", "time": 19181.27, "timestamp": "05:19:41", "text": "Epic Games 上的《彩虹六号：围攻》。我甚至还提供了"}, {"type": "subtitle", "time": 19185.55, "timestamp": "05:19:45", "text": "他们仍然无能为力。我就像"}, {"type": "subtitle", "time": 19199.67, "timestamp": "05:19:59", "text": "我。我不得不创建一个新账户，"}]
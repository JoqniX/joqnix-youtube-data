[{"type": "subtitle", "time": 21017.43, "timestamp": "05:50:17", "text": "有人浪费了木炭，仅仅是为了"}, {"type": "subtitle", "time": 21023.75, "timestamp": "05:50:23", "text": "他们。我什么都做不了。我考虑过"}, {"type": "subtitle", "time": 21025.75, "timestamp": "05:50:25", "text": "它一秒钟后就会爆炸，但没有爆炸。"}, {"type": "subtitle", "time": 21026.99, "timestamp": "05:50:26", "text": "感谢"}, {"type": "subtitle", "time": 21030.19, "timestamp": "05:50:30", "text": "上帝。显然，下雨了。"}, {"type": "subtitle", "time": 21033.35, "timestamp": "05:50:33", "text": "仍然。那么，让我们一起探索这片区域吧。"}, {"type": "subtitle", "time": 21036.31, "timestamp": "05:50:36", "text": "就在这里下面。等等，我来了吗？"}]
[{"type": "subtitle", "time": 9961.63, "timestamp": "02:46:01", "text": "黑客"}, {"type": "subtitle", "time": 9965.23, "timestamp": "02:46:05", "text": "我和我的支持团队都做不到。"}, {"type": "subtitle", "time": 9969.11, "timestamp": "02:46:09", "text": "非常遗憾。"}, {"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "而且这一切都是我的，我的"}, {"type": "subtitle", "time": 9974.23, "timestamp": "02:46:14", "text": "怪我没设置好兽医。"}, {"type": "subtitle", "time": 9978.07, "timestamp": "02:46:18", "text": "呃，做点公平的事。所以这事儿得怪我。"}, {"type": "subtitle", "time": 9979.99, "timestamp": "02:46:19", "text": "主要。"}, {"type": "subtitle", "time": 9981.469, "timestamp": "02:46:21", "text": "但仍然"}, {"type": "subtitle", "time": 10006.309, "timestamp": "02:46:46", "text": "疼痛，呃，等等，有人有……我感觉……"}, {"type": "subtitle", "time": 10008.79, "timestamp": "02:46:48", "text": "非常糟糕。呃，我明天要考试。"}, {"type": "subtitle", "time": 10011.67, "timestamp": "02:46:51", "text": "又是一个早晨。你好。好，好，好。"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "是的，你应该那样做。是的，你"}, {"type": "subtitle", "time": 10016.07, "timestamp": "02:46:56", "text": "应该这样做。你在睡觉。按"}]
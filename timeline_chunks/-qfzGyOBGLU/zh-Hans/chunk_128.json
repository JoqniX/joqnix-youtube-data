[{"type": "subtitle", "time": 7692.31, "timestamp": "02:08:12", "text": "她负责管理他的非法财产吗？不，我当时10岁。"}, {"type": "subtitle", "time": 7699.669, "timestamp": "02:08:19", "text": "假的。不，等等。我十年级时是"}, {"type": "subtitle", "time": 7702.31, "timestamp": "02:08:22", "text": "堡垒之夜。我当时正处于我的弧线中"}, {"type": "subtitle", "time": 7704.99, "timestamp": "02:08:24", "text": "成为电子竞技"}, {"type": "subtitle", "time": 7708.55, "timestamp": "02:08:28", "text": "职业游戏玩家"}, {"type": "subtitle", "time": 7712.31, "timestamp": "02:08:32", "text": "东西与来自 a 的资金争夺"}, {"type": "subtitle", "time": 7714.709, "timestamp": "02:08:34", "text": "Discord就像是给小孩子用的那种。"}, {"type": "subtitle", "time": 7717.51, "timestamp": "02:08:37", "text": "赌注大概10美元左右。工资"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "一对一之类的。我的天啊。等待"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "类似 Roblox 的游戏。不是 Roblox for Discord"}, {"type": "subtitle", "time": 7727.109, "timestamp": "02:08:47", "text": "Nitro 和一些我好像记得的东西"}, {"type": "subtitle", "time": 7730.31, "timestamp": "02:08:50", "text": "我人生中的那段弧线。是的，我以前"}, {"type": "subtitle", "time": 7732.629, "timestamp": "02:08:52", "text": "殴打孩子。不要殴打孩子。不，"}, {"type": "subtitle", "time": 7735.27, "timestamp": "02:08:55", "text": "别想歪了。旧方法。我"}]
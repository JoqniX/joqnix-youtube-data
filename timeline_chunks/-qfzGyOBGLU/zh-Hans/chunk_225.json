[{"type": "subtitle", "time": 13503.189, "timestamp": "03:45:03", "text": "再次。再见。嗨，茶。你好，Dracoon。能"}, {"type": "subtitle", "time": 13505.71, "timestamp": "03:45:05", "text": "你会做弓吗？我不会拉弓。"}, {"type": "subtitle", "time": 13522.229, "timestamp": "03:45:22", "text": "东西。我可以吗？哦，我可以，我可以做"}, {"type": "subtitle", "time": 13528.83, "timestamp": "03:45:28", "text": "什么？铲子底座。"}, {"type": "subtitle", "time": 13534.83, "timestamp": "03:45:34", "text": "他妈的？"}, {"type": "subtitle", "time": 13539.51, "timestamp": "03:45:39", "text": "呃，求生鱼陷阱。不。"}, {"type": "subtitle", "time": 13559.269, "timestamp": "03:45:59", "text": "蘑菇。我的天哪，我竟然吃了这么多"}]
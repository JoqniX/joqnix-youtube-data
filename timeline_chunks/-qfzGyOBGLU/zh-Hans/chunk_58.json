[{"type": "subtitle", "time": 3482.549, "timestamp": "00:58:02", "text": "凌晨 4:00 至 6:00 我丢了我的"}, {"type": "subtitle", "time": 3483.74, "timestamp": "00:58:03", "text": "钻石镐和"}, {"type": "subtitle", "time": 3486.03, "timestamp": "00:58:06", "text": "[音乐]"}, {"type": "subtitle", "time": 3505.309, "timestamp": "00:58:25", "text": "我得重新给我的东西起名字了。"}, {"type": "subtitle", "time": 3508.95, "timestamp": "00:58:28", "text": "嗯，我觉得最好还是等等。"}, {"type": "subtitle", "time": 3512.03, "timestamp": "00:58:32", "text": "新服务器即将上线，"}, {"type": "subtitle", "time": 3515.589, "timestamp": "00:58:35", "text": "正确的？与其死了，不如登录。"}, {"type": "subtitle", "time": 3516.99, "timestamp": "00:58:36", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 3520.47, "timestamp": "00:58:40", "text": "好吧，因为我努力工作了。我完成了"}, {"type": "subtitle", "time": 3524.789, "timestamp": "00:58:44", "text": "任务一次性交给了我。我"}, {"type": "subtitle", "time": 3526.71, "timestamp": "00:58:46", "text": "虽然当时正在放大。你可以观看"}, {"type": "subtitle", "time": 3529.63, "timestamp": "00:58:49", "text": "滑稽剧。你会"}, {"type": "subtitle", "time": 3531.789, "timestamp": "00:58:51", "text": "知道。我当时"}, {"type": "subtitle", "time": 3535.23, "timestamp": "00:58:55", "text": "使用幻灯片进行缩放和"}]
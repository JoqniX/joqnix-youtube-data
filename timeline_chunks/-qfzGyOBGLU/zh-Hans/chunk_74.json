[{"type": "subtitle", "time": 4440.99, "timestamp": "01:14:00", "text": "现在"}, {"type": "subtitle", "time": 4443.91, "timestamp": "01:14:03", "text": "但我连个能帮我的人都没有。"}, {"type": "subtitle", "time": 4446.55, "timestamp": "01:14:06", "text": "网站上的所有信息都由我提供"}, {"type": "subtitle", "time": 4449.35, "timestamp": "01:14:09", "text": "虽然我自己也买了网络工作室。"}, {"type": "subtitle", "time": 4451.31, "timestamp": "01:14:11", "text": "终身优惠"}, {"type": "subtitle", "time": 4453.39, "timestamp": "01:14:13", "text": "现在"}, {"type": "subtitle", "time": 4458.229, "timestamp": "01:14:18", "text": "但我想要的是，我的东西是……"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "当然，我也可以委托别人来做。"}, {"type": "subtitle", "time": 4461.99, "timestamp": "01:14:21", "text": "网站佣金全额支付。"}, {"type": "subtitle", "time": 4465.43, "timestamp": "01:14:25", "text": "有人，但我想要权力，所以我的"}, {"type": "subtitle", "time": 4467.669, "timestamp": "01:14:27", "text": "网站现在喜欢做出改变，"}, {"type": "subtitle", "time": 4470.59, "timestamp": "01:14:30", "text": "如果一段时间后我不喜欢，那就什么都不要了。"}, {"type": "subtitle", "time": 4473.35, "timestamp": "01:14:33", "text": "时间。我想要的不是打扰，而是那种感觉。"}, {"type": "subtitle", "time": 4477.27, "timestamp": "01:14:37", "text": "呃，那个网站开发人员一直都在。我想"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "我也想自己做，而且只有我一个人在寻找"}, {"type": "subtitle", "time": 4481.75, "timestamp": "01:14:41", "text": "Pepdev 的"}, {"type": "subtitle", "time": 4486.43, "timestamp": "01:14:46", "text": "呃，网页开发……呃，东西……呃，比如帮助"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "如果需要的话，就像……"}, {"type": "subtitle", "time": 4499.43, "timestamp": "01:14:59", "text": "克洛诺斯做不到吗？我可以画U，但是"}]
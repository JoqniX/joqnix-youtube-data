[{"type": "subtitle", "time": 19202.628, "timestamp": "05:20:02", "text": "东西。真是糟透了。"}, {"type": "subtitle", "time": 19205.67, "timestamp": "05:20:05", "text": "我买的游戏，那些游戏呃……"}, {"type": "subtitle", "time": 19207.67, "timestamp": "05:20:07", "text": "我玩过的游戏，我的成就，"}, {"type": "subtitle", "time": 19209.55, "timestamp": "05:20:09", "text": "一切"}, {"type": "subtitle", "time": 19212.99, "timestamp": "05:20:12", "text": "走了。就像这是我的"}, {"type": "subtitle", "time": 19216.27, "timestamp": "05:20:16", "text": "帐户。第18级"}, {"type": "subtitle", "time": 19220.39, "timestamp": "05:20:20", "text": "Jockn 的一切都消失了。 D 我必须"}, {"type": "subtitle", "time": 19227.19, "timestamp": "05:20:27", "text": "Jockn_exa 他们不能把我的con还给我"}, {"type": "subtitle", "time": 19230.55, "timestamp": "05:20:30", "text": "为什么？他们再次拒绝了我的请求。"}, {"type": "subtitle", "time": 19236.99, "timestamp": "05:20:36", "text": "要求"}, {"type": "subtitle", "time": 19239.788, "timestamp": "05:20:39", "text": "疼痛。除此之外，我一切都很好。"}, {"type": "subtitle", "time": 19248.51, "timestamp": "05:20:48", "text": "东西。就是那种东西"}, {"type": "subtitle", "time": 19255.31, "timestamp": "05:20:55", "text": "它。哦"}, {"type": "subtitle", "time": 19259.03, "timestamp": "05:20:59", "text": "上帝。地板框架。你用它做什么"}]
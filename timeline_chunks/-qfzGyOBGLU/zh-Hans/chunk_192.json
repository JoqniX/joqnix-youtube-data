[{"type": "subtitle", "time": 11533.95, "timestamp": "03:12:13", "text": "某人。我听说"}, {"type": "subtitle", "time": 11548.389, "timestamp": "03:12:28", "text": "什么？这是一个睡袋。那是食物吗？"}, {"type": "subtitle", "time": 11551.99, "timestamp": "03:12:31", "text": "那是一根香蕉。等等，我可以吃吗？不。"}, {"type": "subtitle", "time": 11565.71, "timestamp": "03:12:45", "text": "兄弟。哦，我的"}, {"type": "subtitle", "time": 11570.79, "timestamp": "03:12:50", "text": "上帝。我的天啊。我的天啊。我吓坏了。"}]
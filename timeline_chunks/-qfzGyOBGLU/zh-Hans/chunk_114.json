[{"type": "subtitle", "time": 6842.31, "timestamp": "01:54:02", "text": "家。但是，是的，那些东西必须是"}, {"type": "subtitle", "time": 6844.07, "timestamp": "01:54:04", "text": "改变。现在，当我要去日本的时候，我"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "必须真正变成一个外向的人，"}, {"type": "subtitle", "time": 6849.91, "timestamp": "01:54:09", "text": "独自社交和生存。不再"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "爸爸妈妈，谁来救我？"}, {"type": "subtitle", "time": 6856.629, "timestamp": "01:54:16", "text": "力挽狂澜。我必须尽我所能"}, {"type": "subtitle", "time": 6860.31, "timestamp": "01:54:20", "text": "在一个随机的、陌生的国家生存下去"}, {"type": "subtitle", "time": 6869.51, "timestamp": "01:54:29", "text": "哦，原来是这样。是的，日本有"}, {"type": "subtitle", "time": 6872.17, "timestamp": "01:54:32", "text": "比较内向。是的。是的。"}, {"type": "subtitle", "time": 6889.47, "timestamp": "01:54:49", "text": "真的吗？对他们来说不好。有利于"}, {"type": "subtitle", "time": 6895.669, "timestamp": "01:54:55", "text": "哦。所以，如果我买一台笔记本电脑，是不是就意味着……"}]
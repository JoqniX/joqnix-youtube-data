[{"type": "subtitle", "time": 15362.439, "timestamp": "04:16:02", "text": "收拾一些东西。金属刀片。我接受 它。嗯，我吃一些"}, {"type": "subtitle", "time": 15374.469, "timestamp": "04:16:14", "text": "蘑菇。好的，这样我就能获得更多了。"}, {"type": "subtitle", "time": 15376.349, "timestamp": "04:16:16", "text": "空间。好的，"}, {"type": "subtitle", "time": 15380.469, "timestamp": "04:16:20", "text": "好的。那是一根金属管。石头。石头。"}, {"type": "subtitle", "time": 15385.229, "timestamp": "04:16:25", "text": "好的。你好。现在，我们将得到"}, {"type": "subtitle", "time": 15388.309, "timestamp": "04:16:28", "text": "我们把这个人弄过来，还有这个人"}, {"type": "subtitle", "time": 15389.389, "timestamp": "04:16:29", "text": "超过"}, {"type": "subtitle", "time": 15397.11, "timestamp": "04:16:37", "text": "好的，那看起来是个好地方。"}, {"type": "subtitle", "time": 15412.87, "timestamp": "04:16:52", "text": "正确的？我不知道。我需要找到一个"}, {"type": "subtitle", "time": 15414.83, "timestamp": "04:16:54", "text": "好地方"}]
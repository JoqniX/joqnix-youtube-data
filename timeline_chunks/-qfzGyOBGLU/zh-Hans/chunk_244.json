[{"type": "subtitle", "time": 14658.67, "timestamp": "04:04:18", "text": "是的，这很难说。"}, {"type": "subtitle", "time": 14661.67, "timestamp": "04:04:21", "text": "死亡。哦，我也脱水了。哦，我的"}, {"type": "subtitle", "time": 14664.309, "timestamp": "04:04:24", "text": "上帝。那是石头吗？请告诉我。"}, {"type": "subtitle", "time": 14667.269, "timestamp": "04:04:27", "text": "哦，那是一块石头。这是一块石头。哦"}, {"type": "subtitle", "time": 14676.91, "timestamp": "04:04:36", "text": "[音乐]"}, {"type": "subtitle", "time": 14679.46, "timestamp": "04:04:39", "text": "[掌声]"}, {"type": "subtitle", "time": 14684.61, "timestamp": "04:04:44", "text": "[音乐]"}, {"type": "subtitle", "time": 14684.68, "timestamp": "04:04:44", "text": "[掌声]"}, {"type": "subtitle", "time": 14689.389, "timestamp": "04:04:49", "text": "[音乐]"}, {"type": "subtitle", "time": 14693.03, "timestamp": "04:04:53", "text": "最后。他妈的。"}, {"type": "subtitle", "time": 14697.85, "timestamp": "04:04:57", "text": "[掌声]"}]
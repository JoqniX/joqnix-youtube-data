[{"type": "subtitle", "time": 12367.83, "timestamp": "03:26:07", "text": "杀。所以，呃，如果真是那样的话，我们……"}, {"type": "subtitle", "time": 12372.269, "timestamp": "03:26:12", "text": "去这个地方"}, {"type": "subtitle", "time": 12375.55, "timestamp": "03:26:15", "text": "这里。希望没有"}, {"type": "subtitle", "time": 12378.309, "timestamp": "03:26:18", "text": "一。这就是为什么我们不去……"}, {"type": "subtitle", "time": 12381.229, "timestamp": "03:26:21", "text": "地铁。地铁。"}, {"type": "subtitle", "time": 12385.03, "timestamp": "03:26:25", "text": "哦。我的天啊。如此之多的碎片。"}, {"type": "subtitle", "time": 12388.269, "timestamp": "03:26:28", "text": "我第一次被……杀死"}, {"type": "subtitle", "time": 12390.83, "timestamp": "03:26:30", "text": "呃，你管它叫什么？"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "天哪，感觉就像在玩《我的世界》一样。"}, {"type": "subtitle", "time": 12410.95, "timestamp": "03:26:50", "text": "生存。"}, {"type": "subtitle", "time": 12413.19, "timestamp": "03:26:53", "text": "如何构建做事的方法以及"}]
[{"type": "subtitle", "time": 9541.23, "timestamp": "02:39:01", "text": "做？你好。回来了。我们走吧。"}, {"type": "subtitle", "time": 9545.55, "timestamp": "02:39:05", "text": "锈。昨天我安装了这个"}, {"type": "subtitle", "time": 9549.19, "timestamp": "02:39:09", "text": "游戏。让我来告诉你我为什么买"}, {"type": "subtitle", "time": 9552.389, "timestamp": "02:39:12", "text": "这款游戏。我的天，我不知道你们是不是"}, {"type": "subtitle", "time": 9556.309, "timestamp": "02:39:16", "text": "看到了我的推文。我的东西在哪儿？所以，"}, {"type": "subtitle", "time": 9560.55, "timestamp": "02:39:20", "text": "呃，我最近在推特上发过这条推文。如果我"}, {"type": "subtitle", "time": 9565.469, "timestamp": "02:39:25", "text": "可以找到。如果我能找到那个"}, {"type": "subtitle", "time": 9567.55, "timestamp": "02:39:27", "text": "鸣叫。在哪里？"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "你？对，就是这个。这条推文。我只是"}, {"type": "subtitle", "time": 9574.07, "timestamp": "02:39:34", "text": "我攒了很久的钱才买了Rust。和"}, {"type": "subtitle", "time": 9576.79, "timestamp": "02:39:36", "text": "现在我收集到的所有锈蚀掉落物"}, {"type": "subtitle", "time": 9578.63, "timestamp": "02:39:38", "text": "去年来自 Twitch。我全都"}, {"type": "subtitle", "time": 9583.429, "timestamp": "02:39:43", "text": "已到期。是的，每一滴我"}, {"type": "subtitle", "time": 9585.15, "timestamp": "02:39:45", "text": "研磨"}, {"type": "subtitle", "time": 9588.11, "timestamp": "02:39:48", "text": "抽搐。他们所有人"}, {"type": "subtitle", "time": 9592.95, "timestamp": "02:39:52", "text": "走了。裹尸布枪不见了。 SQC 呃呃项目"}, {"type": "subtitle", "time": 9597.23, "timestamp": "02:39:57", "text": "已经走了。宝可梦车库门是"}]
[{"type": "subtitle", "time": 16502.629, "timestamp": "04:35:02", "text": "那是不是我想的那样？"}, {"type": "subtitle", "time": 16504.269, "timestamp": "04:35:04", "text": "好的，"}, {"type": "subtitle", "time": 16506.75, "timestamp": "04:35:06", "text": "等待。我必须杀人"}, {"type": "subtitle", "time": 16510.83, "timestamp": "04:35:10", "text": "它。等等，我没有睡觉"}, {"type": "subtitle", "time": 16512.83, "timestamp": "04:35:12", "text": "包。"}, {"type": "subtitle", "time": 16515.869, "timestamp": "04:35:15", "text": "哦，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 16520.31, "timestamp": "04:35:20", "text": "等待。睡袋。多少？ 30块布。"}, {"type": "subtitle", "time": 16523.109, "timestamp": "04:35:23", "text": "等等，等等，等等，等等。我们先这样做，"}, {"type": "subtitle", "time": 16525.629, "timestamp": "04:35:25", "text": "然后我们把它杀了。"}, {"type": "subtitle", "time": 16529.429, "timestamp": "04:35:29", "text": "好的，就是这个意思。"}, {"type": "subtitle", "time": 16538.83, "timestamp": "04:35:38", "text": "呃，睡袋，"}, {"type": "subtitle", "time": 16541.83, "timestamp": "04:35:41", "text": "做手工，而且我的确有双开门。"}, {"type": "subtitle", "time": 16543.839, "timestamp": "04:35:43", "text": "出色地。"}]
[{"type": "subtitle", "time": 17040.708, "timestamp": "04:44:00", "text": "那。这是关于动物的什么趣闻？我没有"}, {"type": "subtitle", "time": 17042.708, "timestamp": "04:44:02", "text": "知道该如何处理它。我会保留"}, {"type": "subtitle", "time": 17047.07, "timestamp": "04:44:07", "text": "这笔钱归我。把这些东西留着"}, {"type": "subtitle", "time": 17049.47, "timestamp": "04:44:09", "text": "这里。我们需要"}, {"type": "subtitle", "time": 17052.43, "timestamp": "04:44:12", "text": "这块木头。我们可以持有"}, {"type": "subtitle", "time": 17055.75, "timestamp": "04:44:15", "text": "那。老问题：我应该就此结束吗？"}, {"type": "subtitle", "time": 17058.27, "timestamp": "04:44:18", "text": "等等，我还是保留我的旧款吧。"}, {"type": "subtitle", "time": 17061.11, "timestamp": "04:44:21", "text": "试试这些新东西"}, {"type": "subtitle", "time": 17065.708, "timestamp": "04:44:25", "text": "是的。好的，"}, {"type": "subtitle", "time": 17076.35, "timestamp": "04:44:36", "text": "去。让我们使用这个新的"}, {"type": "subtitle", "time": 17080.39, "timestamp": "04:44:40", "text": "东西。呃，你知道去那里吗？"}, {"type": "subtitle", "time": 17082.31, "timestamp": "04:44:42", "text": "找出金属部件？好的，好的。"}, {"type": "subtitle", "time": 17086.35, "timestamp": "04:44:46", "text": "好的。明白了。金属球。在那里"}, {"type": "subtitle", "time": 17089.67, "timestamp": "04:44:49", "text": "是。我也弄到了一把枪。我们走吧。"}, {"type": "subtitle", "time": 17092.27, "timestamp": "04:44:52", "text": "我们走吧。你坐"}, {"type": "subtitle", "time": 17095.19, "timestamp": "04:44:55", "text": "座位。莎莉，我不能用枪扫射别人，但是"}]
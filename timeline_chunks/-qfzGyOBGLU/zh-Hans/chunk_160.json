[{"type": "subtitle", "time": 9600.79, "timestamp": "02:40:00", "text": "走了。呃，就像……神话……骷髅头盔"}, {"type": "subtitle", "time": 9604.27, "timestamp": "02:40:04", "text": "已经走了。一切都消失了。"}, {"type": "subtitle", "time": 9607.07, "timestamp": "02:40:07", "text": "为什么？它做了什么？"}, {"type": "subtitle", "time": 9610.63, "timestamp": "02:40:10", "text": "成本？比如，如果我去我的……呃，如果我去"}, {"type": "subtitle", "time": 9614.23, "timestamp": "02:40:14", "text": "我的滴液，我会让你看看我有多少滴液液。"}, {"type": "subtitle", "time": 9616.59, "timestamp": "02:40:16", "text": "呃，它只有一半"}, {"type": "subtitle", "time": 9620.309, "timestamp": "02:40:20", "text": "它。呃，如果我能在这儿找到的话。"}, {"type": "subtitle", "time": 9622.95, "timestamp": "02:40:22", "text": "是的。宝可梦车库就在这里。"}, {"type": "subtitle", "time": 9625.95, "timestamp": "02:40:25", "text": "然后是流浪汉的战斗裹尸布"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "连帽衫。米特的胸甲。所以，事实并非如此。"}, {"type": "subtitle", "time": 9631.91, "timestamp": "02:40:31", "text": "头盔。杰克化粪池储存。我输了"}, {"type": "subtitle", "time": 9633.63, "timestamp": "02:40:33", "text": "即"}, {"type": "subtitle", "time": 9638.07, "timestamp": "02:40:38", "text": "出色地。莉莉外套。我失去了我所爱的人"}, {"type": "subtitle", "time": 9641.59, "timestamp": "02:40:41", "text": "外套，但我弄丢了。"}, {"type": "subtitle", "time": 9644.55, "timestamp": "02:40:44", "text": "如果我当时有这款游戏就好了，就像2代那样"}, {"type": "subtitle", "time": 9648.469, "timestamp": "02:40:48", "text": "几年前，在离线电视时代，呃，生锈了。"}, {"type": "subtitle", "time": 9651.349, "timestamp": "02:40:51", "text": "呃，发生了一些事，我本来可以声称自己是受害者。"}, {"type": "subtitle", "time": 9653.99, "timestamp": "02:40:53", "text": "这些。是的。你好 Tigeran。希望你"}, {"type": "subtitle", "time": 9655.71, "timestamp": "02:40:55", "text": "一切顺利。怎样"}]
[{"type": "subtitle", "time": 9480.79, "timestamp": "02:38:00", "text": "你可以许愿。是的，它仍然是"}, {"type": "subtitle", "time": 9483.59, "timestamp": "02:38:03", "text": "呃，还在制作中，呃，因为我没有"}, {"type": "subtitle", "time": 9487.19, "timestamp": "02:38:07", "text": "呃，我还没有对应的 suta。"}, {"type": "subtitle", "time": 9491.83, "timestamp": "02:38:11", "text": "但我仍然想要，我想要同样的……呃……"}, {"type": "subtitle", "time": 9494.15, "timestamp": "02:38:14", "text": "想要得到你们给予的同样待遇"}, {"type": "subtitle", "time": 9496.309, "timestamp": "02:38:16", "text": "我。我想看看它们，我想制作它们。"}, {"type": "subtitle", "time": 9499.51, "timestamp": "02:38:19", "text": "他们不应是独立的个体，而应是独立的个体。"}, {"type": "subtitle", "time": 9501.99, "timestamp": "02:38:21", "text": "就像他们的一部分也是我的一部分，但是"}, {"type": "subtitle", "time": 9503.91, "timestamp": "02:38:23", "text": "他们都是独立的个体"}, {"type": "subtitle", "time": 9506.95, "timestamp": "02:38:26", "text": "就是这样。是的，你也可以"}, {"type": "subtitle", "time": 9510.71, "timestamp": "02:38:30", "text": "也请在直播中许愿。呃，你必须"}, {"type": "subtitle", "time": 9513.83, "timestamp": "02:38:33", "text": "直接标记他，或者我觉得你可以。"}, {"type": "subtitle", "time": 9516.469, "timestamp": "02:38:36", "text": "可以这样做，或者用推特。它就在那里。"}, {"type": "subtitle", "time": 9519.27, "timestamp": "02:38:39", "text": "好了，就是这样。呃，等等，让我躲起来"}, {"type": "subtitle", "time": 9522.23, "timestamp": "02:38:42", "text": "又来了。我关闭了什么吗？什么"}, {"type": "subtitle", "time": 9525.03, "timestamp": "02:38:45", "text": "他们派你来的吗？那是富士山。您可以使用"}, {"type": "subtitle", "time": 9527.23, "timestamp": "02:38:47", "text": "它"}, {"type": "subtitle", "time": 9530.71, "timestamp": "02:38:50", "text": "溪流。我的天哪，你给了我富士山。哦"}, {"type": "subtitle", "time": 9531.87, "timestamp": "02:38:51", "text": "我的天啊，你"}, {"type": "subtitle", "time": 9534.55, "timestamp": "02:38:54", "text": "我的天哪。我会用那个。患病的"}, {"type": "subtitle", "time": 9537.389, "timestamp": "02:38:57", "text": "用那个。谢谢。你"}]
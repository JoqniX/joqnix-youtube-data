[{"type": "subtitle", "time": 21247.51, "timestamp": "05:54:07", "text": "美好的。我吃饱了。哦，我得走了。"}, {"type": "subtitle", "time": 21252.35, "timestamp": "05:54:12", "text": "回到家。我听说"}, {"type": "subtitle", "time": 21261.19, "timestamp": "05:54:21", "text": "我？这是个 b。把球踢出去。是的。"}, {"type": "subtitle", "time": 21266.19, "timestamp": "05:54:26", "text": "潜水气瓶。什么？什么？那是"}, {"type": "subtitle", "time": 21268.948, "timestamp": "05:54:28", "text": "凉爽的。好的，我需要删除一些东西。"}, {"type": "subtitle", "time": 21271.91, "timestamp": "05:54:31", "text": "呃，咱们把毛线帽摘了吧，因为我"}, {"type": "subtitle", "time": 21274.67, "timestamp": "05:54:34", "text": "已经有了"}, {"type": "subtitle", "time": 21281.788, "timestamp": "05:54:41", "text": "东西。火箭。我会保留它。"}, {"type": "subtitle", "time": 21284.788, "timestamp": "05:54:44", "text": "那里。更多东西。"}, {"type": "subtitle", "time": 21287.83, "timestamp": "05:54:47", "text": "当他击球时，球会运转起来。"}, {"type": "subtitle", "time": 21290.27, "timestamp": "05:54:50", "text": "就像绿巨人走路一样"}, {"type": "subtitle", "time": 21292.11, "timestamp": "05:54:52", "text": "某物。"}]
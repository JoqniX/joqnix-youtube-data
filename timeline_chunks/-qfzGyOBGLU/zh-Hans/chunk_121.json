[{"type": "subtitle", "time": 7260.03, "timestamp": "02:01:00", "text": "东西，他们正在平衡"}, {"type": "subtitle", "time": 7290.629, "timestamp": "02:01:30", "text": "天堂。我跟你说，兄弟，我会跑的"}, {"type": "subtitle", "time": 7293.03, "timestamp": "02:01:33", "text": "即使反对整个"}, {"type": "subtitle", "time": 7295.07, "timestamp": "02:01:35", "text": "哈拉姆"}, {"type": "subtitle", "time": 7296.589, "timestamp": "02:01:36", "text": "事件。"}, {"type": "subtitle", "time": 7299.91, "timestamp": "02:01:39", "text": "什么？我为什么要那样做？我的首要任务"}, {"type": "subtitle", "time": 7305.03, "timestamp": "02:01:45", "text": "这是我在日本的未来，对吧？"}, {"type": "subtitle", "time": 7308.47, "timestamp": "02:01:48", "text": "为什么我会说，是的，我必须，是的，我"}, {"type": "subtitle", "time": 7310.709, "timestamp": "02:01:50", "text": "实际上我必须把标准定得很高。"}, {"type": "subtitle", "time": 7313.95, "timestamp": "02:01:53", "text": "你知道，如果我降低标准，我就会"}, {"type": "subtitle", "time": 7316.55, "timestamp": "02:01:56", "text": "窒息，最好是更高。"}, {"type": "subtitle", "time": 7318.35, "timestamp": "02:01:58", "text": "标准"}]
[{"type": "subtitle", "time": 21302.548, "timestamp": "05:55:02", "text": "尽管。是的。三四颗子弹射向……"}, {"type": "subtitle", "time": 21309.548, "timestamp": "05:55:09", "text": "后退。有时候你必须这样做"}, {"type": "subtitle", "time": 21311.75, "timestamp": "05:55:11", "text": "对你来说必不可少的东西"}, {"type": "subtitle", "time": 21313.83, "timestamp": "05:55:13", "text": "生存。但在这方面，我们毫不保留。"}, {"type": "subtitle", "time": 21315.628, "timestamp": "05:55:15", "text": "一。淘。"}, {"type": "subtitle", "time": 21344.91, "timestamp": "05:55:44", "text": "好的。"}, {"type": "subtitle", "time": 21348.23, "timestamp": "05:55:48", "text": "所以，我们会吃掉那罐金枪鱼，然后拿走"}, {"type": "subtitle", "time": 21349.47, "timestamp": "05:55:49", "text": "这"}, {"type": "subtitle", "time": 21354.83, "timestamp": "05:55:54", "text": "空罐。我们可以生熊"}, {"type": "subtitle", "time": 21358.35, "timestamp": "05:55:58", "text": "肉。生鹿肉。我们可以保留这个"}]
[{"type": "subtitle", "time": 18542.27, "timestamp": "05:09:02", "text": "这是我"}, {"type": "subtitle", "time": 18551.708, "timestamp": "05:09:11", "text": "看。 H.好的。呃，让我们把子弹都装上。"}, {"type": "subtitle", "time": 18555.11, "timestamp": "05:09:15", "text": "后退。呃，等等，等等，等等，等等。我需要"}, {"type": "subtitle", "time": 18558.788, "timestamp": "05:09:18", "text": "光。呃，是这个吧？光。哦，我的"}, {"type": "subtitle", "time": 18560.59, "timestamp": "05:09:20", "text": "天哪，终于"}, {"type": "subtitle", "time": 18564.948, "timestamp": "05:09:24", "text": "光。我的天啊，这太难了。"}, {"type": "subtitle", "time": 18570.59, "timestamp": "05:09:30", "text": "但那很好。也很热。所以"}, {"type": "subtitle", "time": 18574.91, "timestamp": "05:09:34", "text": "嗯，所以我们需要我们的……"}, {"type": "subtitle", "time": 18577.708, "timestamp": "05:09:37", "text": "制作"}, {"type": "subtitle", "time": 18581.07, "timestamp": "05:09:41", "text": "另一个制作两个"}, {"type": "subtitle", "time": 18584.788, "timestamp": "05:09:44", "text": "他们。呃，请求低等级燃料呃"}, {"type": "subtitle", "time": 18588.59, "timestamp": "05:09:48", "text": "栅栏。我不需要它。研究母亲"}, {"type": "subtitle", "time": 18598.11, "timestamp": "05:09:58", "text": "呃，自动售货机。好的。好的。等等。"}]
[{"type": "subtitle", "time": 12133.229, "timestamp": "03:22:13", "text": "死的。留着吧。哦。好的。好的。好的。得到"}, {"type": "subtitle", "time": 12135.39, "timestamp": "03:22:15", "text": "你。"}, {"type": "subtitle", "time": 12137.229, "timestamp": "03:22:17", "text": "[音乐]"}, {"type": "subtitle", "time": 12140.429, "timestamp": "03:22:20", "text": "等等，让我打住。"}, {"type": "subtitle", "time": 12144.03, "timestamp": "03:22:24", "text": "警报。我的天哪，我10岁了。"}, {"type": "subtitle", "time": 12153.79, "timestamp": "03:22:33", "text": "不。哦，护目镜上沾满了黏液。"}, {"type": "subtitle", "time": 12156.63, "timestamp": "03:22:36", "text": "我可以把它添加到我的角色上吗？哦，我"}, {"type": "subtitle", "time": 12158.55, "timestamp": "03:22:38", "text": "喝杯降温水。一种护目镜"}, {"type": "subtitle", "time": 12167.469, "timestamp": "03:22:47", "text": "看起来很酷。我的天哪，我看起来"}]
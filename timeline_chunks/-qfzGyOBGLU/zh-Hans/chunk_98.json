[{"type": "subtitle", "time": 5881.669, "timestamp": "01:38:01", "text": "可以说我会用学校语言"}, {"type": "subtitle", "time": 5883.83, "timestamp": "01:38:03", "text": "学校"}, {"type": "subtitle", "time": 5886.47, "timestamp": "01:38:06", "text": "呃，语言学校，如果你把那也算进去的话。"}, {"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "现为大学四年级学生。是的，某种程度上来说，"}, {"type": "subtitle", "time": 5895.51, "timestamp": "01:38:15", "text": "你应该去演你的音乐剧，而不是"}, {"type": "subtitle", "time": 5899.03, "timestamp": "01:38:19", "text": "提供平台。不，他们提供"}, {"type": "subtitle", "time": 5901.149, "timestamp": "01:38:21", "text": "教育"}, {"type": "subtitle", "time": 5904.629, "timestamp": "01:38:24", "text": "执照。对，就是这样。他们要么"}, {"type": "subtitle", "time": 5908.31, "timestamp": "01:38:28", "text": "告诉你去免费试用或者盗版。"}, {"type": "subtitle", "time": 5912.55, "timestamp": "01:38:32", "text": "或者尽量晚些再买。你"}, {"type": "subtitle", "time": 5917.229, "timestamp": "01:38:37", "text": "现在就需要这款软件。然后"}, {"type": "subtitle", "time": 5921.149, "timestamp": "01:38:41", "text": "呃，然后就是许可证那件事。"}, {"type": "subtitle", "time": 5925.51, "timestamp": "01:38:45", "text": "显然，许可证就像是……"}, {"type": "subtitle", "time": 5927.59, "timestamp": "01:38:47", "text": "我是一名学生，我无法获得驾照。"}]
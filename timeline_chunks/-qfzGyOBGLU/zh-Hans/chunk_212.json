[{"type": "subtitle", "time": 12720.95, "timestamp": "03:32:00", "text": "哇。这个游戏里有剑。"}, {"type": "subtitle", "time": 12738.19, "timestamp": "03:32:18", "text": "冒险。"}, {"type": "subtitle", "time": 12741.63, "timestamp": "03:32:21", "text": "我的天哪，这真是太好了"}, {"type": "subtitle", "time": 12745.15, "timestamp": "03:32:25", "text": "玩家。他是否在杀人？"}, {"type": "subtitle", "time": 12747.99, "timestamp": "03:32:27", "text": "人？我本可以拿走他那些东西。"}, {"type": "subtitle", "time": 12751.11, "timestamp": "03:32:31", "text": "给了我。哦，好的。首先，我们需要"}, {"type": "subtitle", "time": 12753.229, "timestamp": "03:32:33", "text": "制作很多"}, {"type": "subtitle", "time": 12757.19, "timestamp": "03:32:37", "text": "绷带。然后我买了一个包。呃，做"}, {"type": "subtitle", "time": 12759.99, "timestamp": "03:32:39", "text": "你现在想离开车站吗？是的。"}, {"type": "subtitle", "time": 12761.469, "timestamp": "03:32:41", "text": "是的，我"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "做。呃，跟我来。"}, {"type": "subtitle", "time": 12773.349, "timestamp": "03:32:53", "text": "上帝。这是什么？他为什么是骷髅？"}]
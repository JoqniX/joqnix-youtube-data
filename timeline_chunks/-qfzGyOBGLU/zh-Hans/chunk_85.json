[{"type": "subtitle", "time": 5102.87, "timestamp": "01:25:02", "text": "2,800。是的。这就是为什么我"}, {"type": "subtitle", "time": 5105.229, "timestamp": "01:25:05", "text": "正说着。这个问题"}, {"type": "subtitle", "time": 5107.59, "timestamp": "01:25:07", "text": "哦，等等。为什么我有 Minecraft"}, {"type": "subtitle", "time": 5108.59, "timestamp": "01:25:08", "text": "事物"}, {"type": "subtitle", "time": 5112.87, "timestamp": "01:25:12", "text": "这里？问题在于你的银行余额"}, {"type": "subtitle", "time": 5115.83, "timestamp": "01:25:15", "text": "如果银行账户不存在或者出现银行问题，你"}, {"type": "subtitle", "time": 5118.39, "timestamp": "01:25:18", "text": "你没有其他办法了吗？"}, {"type": "subtitle", "time": 5120.35, "timestamp": "01:25:20", "text": "比如支付"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "31.17美元，对吧？因为唯一一件事就是你"}, {"type": "subtitle", "time": 5126.47, "timestamp": "01:25:26", "text": "看看你是不是去Stripe或其他什么地方消费，"}, {"type": "subtitle", "time": 5128.35, "timestamp": "01:25:28", "text": "他们让你付钱"}, {"type": "subtitle", "time": 5131.75, "timestamp": "01:25:31", "text": "342美元。我没有那么多。"}, {"type": "subtitle", "time": 5135.75, "timestamp": "01:25:35", "text": "我只想付31.7美元的那笔钱，对吧？"}, {"type": "subtitle", "time": 5139.35, "timestamp": "01:25:39", "text": "所以，我希望我能在……的时候付款"}, {"type": "subtitle", "time": 5143.99, "timestamp": "01:25:43", "text": "收到。这只需要31.17美元。"}, {"type": "subtitle", "time": 5145.709, "timestamp": "01:25:45", "text": "我的"}, {"type": "subtitle", "time": 5148.65, "timestamp": "01:25:48", "text": "银行。如果不行，那我就完蛋了。"}, {"type": "subtitle", "time": 5150.91, "timestamp": "01:25:50", "text": "[音乐]"}]
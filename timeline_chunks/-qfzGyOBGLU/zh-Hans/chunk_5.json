[{"type": "subtitle", "time": 318.59, "timestamp": "00:05:18", "text": "最糟糕的是，我把地图弄丢了。"}, {"type": "subtitle", "time": 321.43, "timestamp": "00:05:21", "text": "尽管。我从……那里得到的地图数量"}, {"type": "subtitle", "time": 324.749, "timestamp": "00:05:24", "text": "酒馆。我把它们弄丢了"}, {"type": "subtitle", "time": 328.029, "timestamp": "00:05:28", "text": "全部。我想和哈比比人做交易"}, {"type": "subtitle", "time": 330.83, "timestamp": "00:05:30", "text": "贾西玛和"}]
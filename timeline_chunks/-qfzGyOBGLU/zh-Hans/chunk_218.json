[{"type": "subtitle", "time": 13080.269, "timestamp": "03:38:00", "text": "去？我的天啊。你必须是"}, {"type": "subtitle", "time": 13083.91, "timestamp": "03:38:03", "text": "开玩笑的。你肯定在开玩笑吧。我输了"}, {"type": "subtitle", "time": 13085.75, "timestamp": "03:38:05", "text": "我的磐石。"}, {"type": "subtitle", "time": 13090.91, "timestamp": "03:38:10", "text": "我的石头丢了。决不。不"}, {"type": "subtitle", "time": 13102.229, "timestamp": "03:38:22", "text": "哇，老兄。我现在正在吃炸鸡"}, {"type": "subtitle", "time": 13105.95, "timestamp": "03:38:25", "text": "翅膀。哦，别让我饿了。"}, {"type": "subtitle", "time": 13107.93, "timestamp": "03:38:27", "text": "B，你让我"}, {"type": "subtitle", "time": 13111.15, "timestamp": "03:38:31", "text": "[音乐]"}, {"type": "subtitle", "time": 13113.59, "timestamp": "03:38:33", "text": "饥饿的。嗯？"}]
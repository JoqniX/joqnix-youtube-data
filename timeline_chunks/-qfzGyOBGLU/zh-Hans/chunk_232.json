[{"type": "subtitle", "time": 13926.95, "timestamp": "03:52:06", "text": "石头。是的。你好，阿迪蒂。欢迎回来。"}, {"type": "subtitle", "time": 13929.269, "timestamp": "03:52:09", "text": "好的，这是一块石头，对吧？我可以"}, {"type": "subtitle", "time": 13930.349, "timestamp": "03:52:10", "text": "我觉得"}, {"type": "subtitle", "time": 13937.189, "timestamp": "03:52:17", "text": "不。怎么会是哦，是的。石头应该是"}, {"type": "subtitle", "time": 13945.55, "timestamp": "03:52:25", "text": "忘了这些是地形"}, {"type": "subtitle", "time": 13948.63, "timestamp": "03:52:28", "text": "东西。所以它应该闪闪发光。但"}, {"type": "subtitle", "time": 13963.87, "timestamp": "03:52:43", "text": "上帝。这是什么？哦，是的"}, {"type": "subtitle", "time": 13968.389, "timestamp": "03:52:48", "text": "哦，什么？我们上去看看吧"}, {"type": "subtitle", "time": 13975.83, "timestamp": "03:52:55", "text": "这里？哦，对，我忘了问了。老虎队"}, {"type": "subtitle", "time": 13977.75, "timestamp": "03:52:57", "text": "你今天是怎么找到我的频道的？如何"}]
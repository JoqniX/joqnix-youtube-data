[{"type": "subtitle", "time": 6960.03, "timestamp": "01:56:00", "text": "要么是jocknik"}, {"type": "subtitle", "time": 6964.31, "timestamp": "01:56:04", "text": "或者我是jocknik或者音乐方面的别名"}, {"type": "subtitle", "time": 6967.99, "timestamp": "01:56:07", "text": "我有。嗯，是的，如果这两个都能做到的话"}, {"type": "subtitle", "time": 6970.55, "timestamp": "01:56:10", "text": "如果能想办法赚钱，那么，是的，我会。"}, {"type": "subtitle", "time": 6973.589, "timestamp": "01:56:13", "text": "用那个来买，呃，如果人们真的"}, {"type": "subtitle", "time": 6975.91, "timestamp": "01:56:15", "text": "听听我的歌，然后，嗯，我就会明白"}, {"type": "subtitle", "time": 6979.109, "timestamp": "01:56:19", "text": "我先创作音乐，然后再做那件事。"}, {"type": "subtitle", "time": 6981.189, "timestamp": "01:56:21", "text": "是的，那笔钱将会用于"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "到那时，还有V型管之类的东西。"}, {"type": "subtitle", "time": 6986.79, "timestamp": "01:56:26", "text": "我想我大概是要去当虚拟主播了。所以，是的，谁"}, {"type": "subtitle", "time": 6989.83, "timestamp": "01:56:29", "text": "真的想玩X游戏吗？是的，我想"}, {"type": "subtitle", "time": 6992.55, "timestamp": "01:56:32", "text": "实验。我想参加VR聊天或"}, {"type": "subtitle", "time": 6995.27, "timestamp": "01:56:35", "text": "比如，我想抱着我的VR设备睡觉。"}, {"type": "subtitle", "time": 6997.669, "timestamp": "01:56:37", "text": "戴上耳机之类的。我想睡觉了"}, {"type": "subtitle", "time": 7000.55, "timestamp": "01:56:40", "text": "在草地上或其他什么地方，"}, {"type": "subtitle", "time": 7003.83, "timestamp": "01:56:43", "text": "比如，“是啊，生活真美好。”然后我"}, {"type": "subtitle", "time": 7005.87, "timestamp": "01:56:45", "text": "醒来后摘下耳机。我是"}, {"type": "subtitle", "time": 7008.99, "timestamp": "01:56:48", "text": "我不想回到过去。"}, {"type": "subtitle", "time": 7011.669, "timestamp": "01:56:51", "text": "现实。我不想去上课。"}, {"type": "subtitle", "time": 7014.91, "timestamp": "01:56:54", "text": "我想在虚拟现实中睡觉。我是一名"}, {"type": "subtitle", "time": 7019.109, "timestamp": "01:56:59", "text": "舒舒服服地窝在床上。"}]
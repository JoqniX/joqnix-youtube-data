[{"type": "subtitle", "time": 11.589, "timestamp": "00:00:11", "text": "[音乐]"}, {"type": "subtitle", "time": 29.189, "timestamp": "00:00:29", "text": "欢迎来到 Joathon 的第 16 天"}, {"type": "subtitle", "time": 30.99, "timestamp": "00:00:30", "text": "一。欢迎来到"}, {"type": "subtitle", "time": 34.389, "timestamp": "00:00:34", "text": "欢迎来到第一季度直播"}, {"type": "subtitle", "time": 36.87, "timestamp": "00:00:36", "text": "以及我将在哪里睡觉，因为我是"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "今天睡眠不足。昨天是"}, {"type": "subtitle", "time": 42.03, "timestamp": "00:00:42", "text": "昨晚。我是说"}, {"type": "subtitle", "time": 46.869, "timestamp": "00:00:46", "text": "今天清晨对我来说太难熬了。"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "对我来说太多了。我在《我的世界》里死了。我"}, {"type": "subtitle", "time": 52.31, "timestamp": "00:00:52", "text": "一切都死了。我失去了一切。"}, {"type": "subtitle", "time": 53.869, "timestamp": "00:00:53", "text": "所以，这是痛苦。"}]
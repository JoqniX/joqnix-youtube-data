[{"type": "subtitle", "time": 5961.27, "timestamp": "01:39:21", "text": "对不起。我爸爸来了，他给了我"}, {"type": "subtitle", "time": 5965.229, "timestamp": "01:39:25", "text": "早餐。我弄到了两根香蕉和"}, {"type": "subtitle", "time": 5968.47, "timestamp": "01:39:28", "text": "dsha。 Dsha 和两个 dsha 和像两个"}, {"type": "subtitle", "time": 5971.669, "timestamp": "01:39:31", "text": "香蕉和木瓜汁。好的，就是这样。"}, {"type": "subtitle", "time": 5974.55, "timestamp": "01:39:34", "text": "或许能让我重获新生。所以我跟"}, {"type": "subtitle", "time": 5977.35, "timestamp": "01:39:37", "text": "那。呃，所以我说，他会帮我的。"}, {"type": "subtitle", "time": 5979.229, "timestamp": "01:39:39", "text": "2,800"}, {"type": "subtitle", "time": 5981.99, "timestamp": "01:39:41", "text": "明天。嗯，那我接下来就用剩下的……"}, {"type": "subtitle", "time": 5983.79, "timestamp": "01:39:43", "text": "把钱用于其他用途"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "订阅，我目前会付费"}, {"type": "subtitle", "time": 5988.27, "timestamp": "01:39:48", "text": "用我所拥有的一切"}, {"type": "subtitle", "time": 5991.59, "timestamp": "01:39:51", "text": "左边。嗯，我目前会用以下方式付款"}, {"type": "subtitle", "time": 5993.39, "timestamp": "01:39:53", "text": "无论我拥有什么"}, {"type": "subtitle", "time": 5997.51, "timestamp": "01:39:57", "text": "左边。呃，那我们开始音乐直播吧"}]
[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "参加了考试并通过了。然后他"}, {"type": "subtitle", "time": 7503.91, "timestamp": "02:05:03", "text": "他获得了个人奖学金。"}, {"type": "subtitle", "time": 7506.79, "timestamp": "02:05:06", "text": "然后他就可以去了，就像他真的可以去一样。"}, {"type": "subtitle", "time": 7509.589, "timestamp": "02:05:09", "text": "我猜我是免费去了日本。"}, {"type": "subtitle", "time": 7512.31, "timestamp": "02:05:12", "text": "我不知道，这太酷了，我不知道"}, {"type": "subtitle", "time": 7514.629, "timestamp": "02:05:14", "text": "整件事我都听到了，就是这样。"}, {"type": "subtitle", "time": 7517.83, "timestamp": "02:05:17", "text": "从其他人那里以及他告诉我爸爸的事情"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "或者别的什么，对学院派人士来说，但我"}, {"type": "subtitle", "time": 7525.07, "timestamp": "02:05:25", "text": "嗯，是的"}, {"type": "subtitle", "time": 7527.43, "timestamp": "02:05:27", "text": "呃，我开始帮助别人来帮助我"}, {"type": "subtitle", "time": 7530.109, "timestamp": "02:05:30", "text": "好国家，真好"}, {"type": "subtitle", "time": 7535.27, "timestamp": "02:05:35", "text": "对我来说是好事，我实际上要去……"}, {"type": "subtitle", "time": 7539.91, "timestamp": "02:05:39", "text": "你知道，就安顿在那里，还有我在旁边"}, {"type": "subtitle", "time": 7541.589, "timestamp": "02:05:41", "text": "事物。我只想在那儿定居下来。"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "东西。如果可水洗的话，也许可以买我的。"}, {"type": "subtitle", "time": 7546.31, "timestamp": "02:05:46", "text": "一切都好，我可以联系到我的父母。"}, {"type": "subtitle", "time": 7548.27, "timestamp": "02:05:48", "text": "家人在那里"}, {"type": "subtitle", "time": 7550.629, "timestamp": "02:05:50", "text": "用某种东西犒劳他们。"}, {"type": "subtitle", "time": 7555.47, "timestamp": "02:05:55", "text": "好或者你知道的，当呃，我的"}, {"type": "subtitle", "time": 7558.629, "timestamp": "02:05:58", "text": "个人就像管子边一样明智，我想要"}]
[{"type": "subtitle", "time": 9844.51, "timestamp": "02:44:04", "text": "我是，而且我一直在思考"}, {"type": "subtitle", "time": 9852.269, "timestamp": "02:44:12", "text": "[音乐]"}, {"type": "subtitle", "time": 9856.23, "timestamp": "02:44:16", "text": "男。我以前经常突然发飙，就像我以前那样"}, {"type": "subtitle", "time": 9859.67, "timestamp": "02:44:19", "text": "在《Hyperscape》中获得大量奖杯。"}, {"type": "subtitle", "time": 9862.469, "timestamp": "02:44:22", "text": "我全都弄丢了。我以前玩过那个。"}, {"type": "subtitle", "time": 9866.309, "timestamp": "02:44:26", "text": "游戏与痛苦。没事的，狗狗。它是"}, {"type": "subtitle", "time": 9875.07, "timestamp": "02:44:35", "text": "不过，没关系。挥之不去的遗憾。"}, {"type": "subtitle", "time": 9879.55, "timestamp": "02:44:39", "text": "不，我不知道。我可能得了一氧化碳中毒。哦"}, {"type": "subtitle", "time": 9882.11, "timestamp": "02:44:42", "text": "不。哦，不。"}, {"type": "subtitle", "time": 9886.469, "timestamp": "02:44:46", "text": "什么？你确定吗？当然。应该得到呃"}, {"type": "subtitle", "time": 9892.71, "timestamp": "02:44:52", "text": "某物。是的。是的。是的。而且"}, {"type": "subtitle", "time": 9896.87, "timestamp": "02:44:56", "text": "喝……喝……等等，那是什么？"}]
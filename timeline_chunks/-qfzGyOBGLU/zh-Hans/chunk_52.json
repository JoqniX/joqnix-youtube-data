[{"type": "subtitle", "time": 3120.99, "timestamp": "00:52:00", "text": "描绘成长"}, {"type": "subtitle", "time": 3123.63, "timestamp": "00:52:03", "text": "它添加了以下元素"}, {"type": "subtitle", "time": 3125.309, "timestamp": "00:52:05", "text": "生长"}, {"type": "subtitle", "time": 3127.069, "timestamp": "00:52:07", "text": "喜欢"}, {"type": "subtitle", "time": 3131.27, "timestamp": "00:52:11", "text": "是的，我有点想成为……"}, {"type": "subtitle", "time": 3134.309, "timestamp": "00:52:14", "text": "不良少年，你看的是什么类型的漫画？"}, {"type": "subtitle", "time": 3137.19, "timestamp": "00:52:17", "text": "当时读到大卫的配饰"}, {"type": "subtitle", "time": 3139.23, "timestamp": "00:52:19", "text": "不"}, {"type": "subtitle", "time": 3142.71, "timestamp": "00:52:22", "text": "我知道我当时就想，是啊，我的意思是，我一直"}, {"type": "subtitle", "time": 3146.069, "timestamp": "00:52:26", "text": "想要佩戴饰品或打耳洞"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "或者一些我永远无法拥有的东西"}, {"type": "subtitle", "time": 3151.27, "timestamp": "00:52:31", "text": "放在我的架子上。所以我决定要……"}, {"type": "subtitle", "time": 3152.75, "timestamp": "00:52:32", "text": "模型有"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "它。那会怎样？那会怎样？"}, {"type": "subtitle", "time": 3157.71, "timestamp": "00:52:37", "text": "感觉怎么样？我"}, {"type": "subtitle", "time": 3166.47, "timestamp": "00:52:46", "text": "它。我得好好研究一下我的主人。是的。"}, {"type": "subtitle", "time": 3169.549, "timestamp": "00:52:49", "text": "有点emo风格。是的。是的。那就是"}, {"type": "subtitle", "time": 3173.03, "timestamp": "00:52:53", "text": "那件事发生的时候。但我意识到了这一点"}, {"type": "subtitle", "time": 3174.75, "timestamp": "00:52:54", "text": "不适合我"}, {"type": "subtitle", "time": 3176.829, "timestamp": "00:52:56", "text": "很多"}, {"type": "subtitle", "time": 3179.349, "timestamp": "00:52:59", "text": "记忆术。我意识到它不适合我。"}]
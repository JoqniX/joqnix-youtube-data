[{"type": "subtitle", "time": 2100.95, "timestamp": "00:35:00", "text": "按钮的描述里也有。我们已经完成了"}, {"type": "subtitle", "time": 2103.829, "timestamp": "00:35:03", "text": "第一个按钮的第二部分，也就是第二个补丁部分"}, {"type": "subtitle", "time": 2105.51, "timestamp": "00:35:05", "text": "。是的"}, {"type": "subtitle", "time": 2109.43, "timestamp": "00:35:09", "text": "。现在是删除"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "逻辑。"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "我想做删除逻辑，但我"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "发现我忘记修改"}, {"type": "subtitle", "time": 2125.829, "timestamp": "00:35:25", "text": "事件了。呃，这个事件……呃，"}, {"type": "subtitle", "time": 2128.47, "timestamp": "00:35:28", "text": "忘记修改事件了。呃，不，我"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "忘记延长活动时间了。"}, {"type": "subtitle", "time": 2132.71, "timestamp": "00:35:32", "text": "你可能已经注意到"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "我的服务器上从昨天开始就有一个Discord活动了。"}, {"type": "subtitle", "time": 2139.91, "timestamp": "00:35:39", "text": "是的，我在测试一些"}, {"type": "subtitle", "time": 2142.79, "timestamp": "00:35:42", "text": "东西，"}, {"type": "subtitle", "time": 2145.51, "timestamp": "00:35:45", "text": "我忘记延长它的时间了，而且我的按钮"}, {"type": "subtitle", "time": 2148.069, "timestamp": "00:35:48", "text": "没有运行，因为我"}, {"type": "subtitle", "time": 2153.109, "timestamp": "00:35:53", "text": "开启了Cloudflare Warp。这导致了一些问题。我"}, {"type": "subtitle", "time": 2156.71, "timestamp": "00:35:56", "text": "不得不为此设置一个故障保护机制。"}, {"type": "subtitle", "time": 2159.91, "timestamp": "00:35:59", "text": "所以它跳过了按钮，"}]
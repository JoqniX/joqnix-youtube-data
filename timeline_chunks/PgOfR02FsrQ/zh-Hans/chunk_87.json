[{"type": "subtitle", "time": 5220.95, "timestamp": "01:27:00", "text": "没有直播，而且 Discord 活动也没有"}, {"type": "subtitle", "time": 5223.75, "timestamp": "01:27:03", "text": "激活，那就只是安排好的"}, {"type": "subtitle", "time": 5227.669, "timestamp": "01:27:07", "text": "活动。 如果我"}, {"type": "subtitle", "time": 5230.629, "timestamp": "01:27:10", "text": "从控制面板更改 YouTube 标题，控制"}, {"type": "subtitle", "time": 5234.149, "timestamp": "01:27:14", "text": "面板的标题也会自动更新。"}, {"type": "subtitle", "time": 5238.47, "timestamp": "01:27:18", "text": "这是其中之一。 第二个是，"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "哦，等等。 标题之类的东西。 对不起。 呃，"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "标题那部分，如果标题有任何更改的话"}, {"type": "subtitle", "time": 5247.27, "timestamp": "01:27:27", "text": "。 如果[嗤笑] Discord 标题"}, {"type": "subtitle", "time": 5249.669, "timestamp": "01:27:29", "text": "与 YouTube 标题"}, {"type": "subtitle", "time": 5251.83, "timestamp": "01:27:31", "text": "不同，它就会复制"}, {"type": "subtitle", "time": 5254.629, "timestamp": "01:27:34", "text": "YouTube 标题。 是的。 是的。 所以，如果我在"}, {"type": "subtitle", "time": 5256.87, "timestamp": "01:27:36", "text": "YouTube 控制面板中更改"}, {"type": "subtitle", "time": 5259.669, "timestamp": "01:27:39", "text": "标题，它这次就会同步更新"}, {"type": "subtitle", "time": 5263.27, "timestamp": "01:27:43", "text": "。 第二点是，"}, {"type": "subtitle", "time": 5266.95, "timestamp": "01:27:46", "text": "如果"}, {"type": "subtitle", "time": 5269.43, "timestamp": "01:27:49", "text": "非直播节目的开始时间发生了"}, {"type": "subtitle", "time": 5272.629, "timestamp": "01:27:52", "text": "变化，它将更新开始"}, {"type": "subtitle", "time": 5276.79, "timestamp": "01:27:56", "text": "时间和新的结束时间，新的结束时间将"}]
[{"type": "subtitle", "time": 10380.79, "timestamp": "02:53:00", "text": "只有Spirit和Orange做了反应，他们"}, {"type": "subtitle", "time": 10383.349, "timestamp": "02:53:03", "text": "为这个视频做了直播，我"}, {"type": "subtitle", "time": 10385.75, "timestamp": "02:53:05", "text": "没有……"}, {"type": "subtitle", "time": 10389.11, "timestamp": "02:53:09", "text": "我不知道Jasmine和Astra有没有"}, {"type": "subtitle", "time": 10391.51, "timestamp": "02:53:11", "text": "反应，我不知道他们有没有……"}, {"type": "subtitle", "time": 10396.389, "timestamp": "02:53:16", "text": "[嗤之以鼻]"}, {"type": "subtitle", "time": 10401.99, "timestamp": "02:53:21", "text": "还有[音乐]是啊，所以……但是再说一遍 不是"}, {"type": "subtitle", "time": 10406.15, "timestamp": "02:53:26", "text": "每个人都愿意冒这个"}, {"type": "subtitle", "time": 10409.51, "timestamp": "02:53:29", "text": "险，你知道，"}, {"type": "subtitle", "time": 10415.11, "timestamp": "02:53:35", "text": "在自己的频道里谈论这些狗血剧情什么的，对吧？"}, {"type": "subtitle", "time": 10420.309, "timestamp": "02:53:40", "text": "所以，"}, {"type": "subtitle", "time": 10422.389, "timestamp": "02:53:42", "text": "我觉得最糟糕的人，"}, {"type": "subtitle", "time": 10424.95, "timestamp": "02:53:44", "text": "甚至征服我们的人，只有那些……对，"}, {"type": "subtitle", "time": 10431.269, "timestamp": "02:53:51", "text": "没错，就是这样，"}, {"type": "subtitle", "time": 10435.59, "timestamp": "02:53:55", "text": "我的情况就是这样。所以，一"}, {"type": "subtitle", "time": 10439.11, "timestamp": "02:53:59", "text": "开始，就像一"}]
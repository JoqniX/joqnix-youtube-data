[{"type": "subtitle", "time": 1860.95, "timestamp": "00:31:00", "text": "所有事情都脱节了。 我注意到最近几周，呃，大概"}, {"type": "subtitle", "time": 1864.549, "timestamp": "00:31:04", "text": "两周前吧[嗤笑]，"}, {"type": "subtitle", "time": 1867.669, "timestamp": "00:31:07", "text": "我经常会走神，然后就想，"}, {"type": "subtitle", "time": 1871.029, "timestamp": "00:31:11", "text": "“等等，我忘了，"}, {"type": "subtitle", "time": 1877.19, "timestamp": "00:31:17", "text": "点到的时候，"}, {"type": "subtitle", "time": 1881.43, "timestamp": "00:31:21", "text": "我觉得老师应该知道，但"}, {"type": "subtitle", "time": 1885.19, "timestamp": "00:31:25", "text": "我还是能回答，所以还行。不过"}, {"type": "subtitle", "time": 1890.23, "timestamp": "00:31:30", "text": "有时候我还是会搞混，比如我这是在哪儿？"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "我刚才在哪儿？这是哪个问题？"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "第三个问题？好吧，第三个问题。所以被点到的时候，"}, {"type": "subtitle", "time": 1900.549, "timestamp": "00:31:40", "text": "我就想，好吧，我得"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "读第三个问题，还是第一个？"}, {"type": "subtitle", "time": 1905.35, "timestamp": "00:31:45", "text": "[笑]"}, {"type": "subtitle", "time": 1908.389, "timestamp": "00:31:48", "text": "有时候他们会发现我"}, {"type": "subtitle", "time": 1911.956, "timestamp": "00:31:51", "text": "注意力不集中。"}, {"type": "subtitle", "time": 1919.162, "timestamp": "00:31:59", "text": "所以"}, {"type": "subtitle", "time": 1919.909, "timestamp": "00:31:59", "text": "[嗤笑]"}]
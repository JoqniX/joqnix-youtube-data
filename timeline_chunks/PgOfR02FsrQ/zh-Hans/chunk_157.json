[{"type": "subtitle", "time": 9467.59, "timestamp": "02:37:47", "text": "她去见了我母亲的律师。 哦，结果"}, {"type": "subtitle", "time": 9469.75, "timestamp": "02:37:49", "text": "怎么样？"}, {"type": "subtitle", "time": 9472.63, "timestamp": "02:37:52", "text": "气氛太紧张了。 是啊，跟律师见面"}, {"type": "subtitle", "time": 9475.429, "timestamp": "02:37:55", "text": "太紧张了。 你知道"}, {"type": "subtitle", "time": 9478.15, "timestamp": "02:37:58", "text": "我第一次见到我的律师时，他跟我说了什么吗？"}]
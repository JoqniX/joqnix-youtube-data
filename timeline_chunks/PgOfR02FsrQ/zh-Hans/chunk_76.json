[{"type": "subtitle", "time": 4564.55, "timestamp": "01:16:04", "text": "我只是想看看它能不能把"}, {"type": "subtitle", "time": 4569.189, "timestamp": "01:16:09", "text": "今天的直播变成一个活动，因为"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "我已经在直播了。 它知道我"}, {"type": "subtitle", "time": 4576.79, "timestamp": "01:16:16", "text": "在线。 所以，我其实就是想知道"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "。 哦，是的"}, {"type": "subtitle", "time": 4595.189, "timestamp": "01:16:35", "text": "，确实如此。 它会识别出来。"}, {"type": "subtitle", "time": 4597.99, "timestamp": "01:16:37", "text": "没关系。"}, {"type": "subtitle", "time": 4602.55, "timestamp": "01:16:42", "text": "昨天的流正在处理中，"}, {"type": "subtitle", "time": 4605.83, "timestamp": "01:16:45", "text": "时间只差"}, {"type": "subtitle", "time": 4609.59, "timestamp": "01:16:49", "text": "一秒[音乐]变化，呃，做一个补丁"}, {"type": "subtitle", "time": 4612.39, "timestamp": "01:16:52", "text": "来改变时间。 所以它一直将"}, {"type": "subtitle", "time": 4615.669, "timestamp": "01:16:55", "text": "时间延长到 6 小时，"}]
[{"type": "subtitle", "time": 2582.87, "timestamp": "00:43:02", "text": "呃，我们来测试一下其中一个逻辑。我发送"}, {"type": "subtitle", "time": 2585.304, "timestamp": "00:43:05", "text": "当前流。"}, {"type": "subtitle", "time": 2586.95, "timestamp": "00:43:06", "text": "[嗤笑]"}, {"type": "subtitle", "time": 2598.87, "timestamp": "00:43:18", "text": "我在线了。是的。是的"}, {"type": "subtitle", "time": 2623.589, "timestamp": "00:43:43", "text": "60秒的常规修补"}, {"type": "subtitle", "time": 2638.47, "timestamp": "00:43:58", "text": "我有个问题。"}]
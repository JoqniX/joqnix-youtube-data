[{"type": "subtitle", "time": 1263.029, "timestamp": "00:21:03", "text": "道德理想有关，"}, {"type": "subtitle", "time": 1265.59, "timestamp": "00:21:05", "text": "感觉就像，嗯，我已经有一个即将推出的"}, {"type": "subtitle", "time": 1269.51, "timestamp": "00:21:09", "text": "模型了，只是我没钱买"}, {"type": "subtitle", "time": 1273.979, "timestamp": "00:21:13", "text": "它，也没钱把它展示出来。"}, {"type": "subtitle", "time": 1274.549, "timestamp": "00:21:14", "text": "[音乐]"}, {"type": "subtitle", "time": 1278.39, "timestamp": "00:21:18", "text": "呃，这样我就可以用它来直播了。"}, {"type": "subtitle", "time": 1280.789, "timestamp": "00:21:20", "text": "嗯，当然，我也可以用"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "免费的模型，但我感觉我得"}, {"type": "subtitle", "time": 1286.23, "timestamp": "00:21:26", "text": "坚持我的运动品牌或者我"}, {"type": "subtitle", "time": 1289.11, "timestamp": "00:21:29", "text": "角色的形象等等。然后"}, {"type": "subtitle", "time": 1294.39, "timestamp": "00:21:34", "text": "我又想，等等，"}, {"type": "subtitle", "time": 1297.35, "timestamp": "00:21:37", "text": "我玩游戏的时候会改变我的角色，"}, {"type": "subtitle", "time": 1299.43, "timestamp": "00:21:39", "text": "我会努力让自己看起来更像我"}, {"type": "subtitle", "time": 1302.07, "timestamp": "00:21:42", "text": "。如果我能做到这一点，为什么"}, {"type": "subtitle", "time": 1304.31, "timestamp": "00:21:44", "text": "我不直接用一个随机的免费"}, {"type": "subtitle", "time": 1307.51, "timestamp": "00:21:47", "text": "模型直播，或者用一个可以自定义成"}, {"type": "subtitle", "time": 1311.51, "timestamp": "00:21:51", "text": "Mimi模样的模型呢？[嗤笑]"}, {"type": "subtitle", "time": 1313.99, "timestamp": "00:21:53", "text": "是的，这也是"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "我想这么做的原因之一。我不"}]
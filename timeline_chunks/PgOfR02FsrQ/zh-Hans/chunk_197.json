[{"type": "subtitle", "time": 11820.79, "timestamp": "03:17:00", "text": "我不知道。老实说，作为一名YouTuber，"}, {"type": "subtitle", "time": 11824.15, "timestamp": "03:17:04", "text": "我一开始并不想透露我来自印度的哪个地区，"}, {"type": "subtitle", "time": 11833.269, "timestamp": "03:17:13", "text": "但是自从BBC的文章"}, {"type": "subtitle", "time": 11837.75, "timestamp": "03:17:17", "text": "出来之后，呃，它就暴露了我来自"}, {"type": "subtitle", "time": 11841.03, "timestamp": "03:17:21", "text": "印度的哪个地区。我"}, {"type": "subtitle", "time": 11844.55, "timestamp": "03:17:24", "text": "没有具体说明，我要求他们"}, {"type": "subtitle", "time": 11847.59, "timestamp": "03:17:27", "text": "修改，草稿也在那里，"}, {"type": "subtitle", "time": 11849.91, "timestamp": "03:17:29", "text": "但是，"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "嗯，是的，就是这样，然后我自己慢慢地"}, {"type": "subtitle", "time": 11859.59, "timestamp": "03:17:39", "text": "说了出来，因为如果我…… 我出道的时候就"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "说过，我知道，但是我的母语"}, {"type": "subtitle", "time": 11865.91, "timestamp": "03:17:45", "text": "不是我熟悉的语言，如果我会说或者知道的话，"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "那也没关系。不过，"}, {"type": "subtitle", "time": 11872.389, "timestamp": "03:17:52", "text": "我看到其他一些YouTuber会"}, {"type": "subtitle", "time": 11874.389, "timestamp": "03:17:54", "text": "公开他们的背景，比如他们在哪里，"}, {"type": "subtitle", "time": 11876.87, "timestamp": "03:17:56", "text": "来自印度的哪个地方"}, {"type": "subtitle", "time": 11878.469, "timestamp": "03:17:58", "text": "等等。"}]
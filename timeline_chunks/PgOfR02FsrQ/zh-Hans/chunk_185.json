[{"type": "subtitle", "time": 11101.67, "timestamp": "03:05:01", "text": "我碰巧看到了"}, {"type": "subtitle", "time": 11104.23, "timestamp": "03:05:04", "text": "那个帖子被存档了，但不知为何，今天凌晨两点我又把"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "所有内容重新读了一遍，"}, {"type": "subtitle", "time": 11111.83, "timestamp": "03:05:11", "text": "因为我睡不着。[音乐]"}, {"type": "subtitle", "time": 11114.15, "timestamp": "03:05:14", "text": "那真是个愚蠢的"}, {"type": "subtitle", "time": 11136.15, "timestamp": "03:05:36", "text": "，我在推特上"}, {"type": "subtitle", "time": 11141.59, "timestamp": "03:05:41", "text": "注意到有些人把我拉黑了。"}, {"type": "subtitle", "time": 11144.309, "timestamp": "03:05:44", "text": "我就想，“好吧，"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "好吧，没关系。” 就这样吧。”"}, {"type": "subtitle", "time": 11153.03, "timestamp": "03:05:53", "text": "嗯，"}, {"type": "subtitle", "time": 11156.23, "timestamp": "03:05:56", "text": "所以我就问他，"}, {"type": "subtitle", "time": 11159.91, "timestamp": "03:05:59", "text": "除了英语和日语，你还会其他语言吗？"}]
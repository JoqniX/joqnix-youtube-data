[{"type": "subtitle", "time": 2281.43, "timestamp": "00:38:01", "text": "不然我就会一直想着， 哦，"}, {"type": "subtitle", "time": 2284.47, "timestamp": "00:38:04", "text": "大家会怎么想？这个"}, {"type": "subtitle", "time": 2286.71, "timestamp": "00:38:06", "text": "那个，这个，这个那个，那个，"}, {"type": "subtitle", "time": 2289.829, "timestamp": "00:38:09", "text": "还有这个。"}, {"type": "subtitle", "time": 2292.71, "timestamp": "00:38:12", "text": "我们永远不会发布我想做的想法"}, {"type": "subtitle", "time": 2297.51, "timestamp": "00:38:17", "text": "之类的东西，对吧？所以，"}, {"type": "subtitle", "time": 2300.47, "timestamp": "00:38:20", "text": "即使是"}, {"type": "subtitle", "time": 2305.03, "timestamp": "00:38:25", "text": "我和萨宾娜一起做的这个代码自动化之类的东西，也"}, {"type": "subtitle", "time": 2308.31, "timestamp": "00:38:28", "text": "太极端了，"}, {"type": "subtitle", "time": 2312.95, "timestamp": "00:38:32", "text": "太过了，"}, {"type": "subtitle", "time": 2317.27, "timestamp": "00:38:37", "text": "完全没必要。"}, {"type": "subtitle", "time": 2320.71, "timestamp": "00:38:40", "text": "没人会想要它，不需要它，但"}, {"type": "subtitle", "time": 2324.63, "timestamp": "00:38:44", "text": "以前没人做过，"}, {"type": "subtitle", "time": 2328.87, "timestamp": "00:38:48", "text": "或者可能有人做过，但"}, {"type": "subtitle", "time": 2331.99, "timestamp": "00:38:51", "text": "据"}, {"type": "subtitle", "time": 2335.43, "timestamp": "00:38:55", "text": "我所知，我身边的人都没做过"}, {"type": "subtitle", "time": 2339.589, "timestamp": "00:38:59", "text": "。而且，我想做。"}]
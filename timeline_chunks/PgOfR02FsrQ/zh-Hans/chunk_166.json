[{"type": "subtitle", "time": 9960.63, "timestamp": "02:46:00", "text": "好的。 等等，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 9963.269, "timestamp": "02:46:03", "text": "为什么最后一张"}, {"type": "subtitle", "time": 9967.269, "timestamp": "02:46:07", "text": "图片被更改了，它仍然是一张图片？"}, {"type": "subtitle", "time": 9970.309, "timestamp": "02:46:10", "text": "我的天啊。"}, {"type": "subtitle", "time": 9972.55, "timestamp": "02:46:12", "text": "我的上帝。"}, {"type": "subtitle", "time": 9976.23, "timestamp": "02:46:16", "text": "我父亲不会玩弄任何虚假的游戏。"}, {"type": "subtitle", "time": 9996.23, "timestamp": "02:46:36", "text": "是的，你得等等，所以我"}, {"type": "subtitle", "time": 9997.67, "timestamp": "02:46:37", "text": "觉得律师得帮你写"}, {"type": "subtitle", "time": 9999.91, "timestamp": "02:46:39", "text": "声明。 不，或者录下来，然后把"}, {"type": "subtitle", "time": 10003.51, "timestamp": "02:46:43", "text": "总统塞进箱子里。"}, {"type": "subtitle", "time": 10006.309, "timestamp": "02:46:46", "text": "哦，是啊，类似的事情太多了"}, {"type": "subtitle", "time": 10009.349, "timestamp": "02:46:49", "text": "。 不，（嗤之以鼻）"}]
[{"type": "subtitle", "time": 11883.03, "timestamp": "03:18:03", "text": "这太疯狂了。就"}, {"type": "subtitle", "time": 11885.269, "timestamp": "03:18:05", "text": "我而言，我很想"}, {"type": "subtitle", "time": 11887.269, "timestamp": "03:18:07", "text": "公开，但感觉更像是在装模作样，"}, {"type": "subtitle", "time": 11891.75, "timestamp": "03:18:11", "text": "因为我"}, {"type": "subtitle", "time": 11899.03, "timestamp": "03:18:19", "text": "是的。如果你让我用"}, {"type": "subtitle", "time": 11902.79, "timestamp": "03:18:22", "text": "我的母语说那种语言，我就会去"}, {"type": "subtitle", "time": 11905.91, "timestamp": "03:18:25", "text": "谷歌搜索怎么说对。"}, {"type": "subtitle", "time": 11908.71, "timestamp": "03:18:28", "text": "因为"}, {"type": "subtitle", "time": 11911.67, "timestamp": "03:18:31", "text": "我以前做过一个调查，一个"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "研究人员来找我，让我做一个关于"}, {"type": "subtitle", "time": 11918.15, "timestamp": "03:18:38", "text": "学习日语的人的调查"}, {"type": "subtitle", "time": 11920.71, "timestamp": "03:18:40", "text": "。调查里有一个问题，"}, {"type": "subtitle", "time": 11924.87, "timestamp": "03:18:44", "text": "让我回答一些关于我自己的事情，比如"}, {"type": "subtitle", "time": 11926.87, "timestamp": "03:18:46", "text": "我的梦想等等"}, {"type": "subtitle", "time": 11929.75, "timestamp": "03:18:49", "text": "。然后还有一个关于"}, {"type": "subtitle", "time": 11934.883, "timestamp": "03:18:54", "text": "太阳和风的故事。"}, {"type": "subtitle", "time": 11935.75, "timestamp": "03:18:55", "text": "[嗤笑]"}, {"type": "subtitle", "time": 11938.87, "timestamp": "03:18:58", "text": "太阳和风。我得把"}]
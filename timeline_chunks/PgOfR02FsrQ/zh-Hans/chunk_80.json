[{"type": "subtitle", "time": 4800.47, "timestamp": "01:20:00", "text": "因为我觉得我"}, {"type": "subtitle", "time": 4803.91, "timestamp": "01:20:03", "text": "一般不太擅长说话，如果没有话题，"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "如果没有人谈论任何话题让"}, {"type": "subtitle", "time": 4809.11, "timestamp": "01:20:09", "text": "我说，我就不知道该说什么了。 但我"}, {"type": "subtitle", "time": 4811.03, "timestamp": "01:20:11", "text": "感觉，作为主播，我"}, {"type": "subtitle", "time": 4813.43, "timestamp": "01:20:13", "text": "应该多说点话。 我应该"}, {"type": "subtitle", "time": 4815.99, "timestamp": "01:20:15", "text": "自己选话题，然后继续聊各种"}, {"type": "subtitle", "time": 4818.95, "timestamp": "01:20:18", "text": "事情，对吧？"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "所以我一直在做实验。 所以，我"}, {"type": "subtitle", "time": 4824.87, "timestamp": "01:20:24", "text": "现在仍然需要进行实验。"}, {"type": "subtitle", "time": 4826.95, "timestamp": "01:20:26", "text": "我会尽量"}, {"type": "subtitle", "time": 4830.63, "timestamp": "01:20:30", "text": "早起，然后进行一些"}, {"type": "subtitle", "time": 4833.83, "timestamp": "01:20:33", "text": "晨间直播之类的。"}, {"type": "subtitle", "time": 4836.63, "timestamp": "01:20:36", "text": "希望我不会太打扰到你。 我希望它"}, {"type": "subtitle", "time": 4839.27, "timestamp": "01:20:39", "text": "不会变成"}, {"type": "subtitle", "time": 4842.229, "timestamp": "01:20:42", "text": "质量重于数量，或者数量重于"}, {"type": "subtitle", "time": 4844.95, "timestamp": "01:20:44", "text": "质量之类的任何情况。 这就是"}, {"type": "subtitle", "time": 4847.99, "timestamp": "01:20:47", "text": "我的问题所在。 我经常直播。 我非常喜欢这个直播"}, {"type": "subtitle", "time": 4850.63, "timestamp": "01:20:50", "text": "。"}, {"type": "subtitle", "time": 4853.51, "timestamp": "01:20:53", "text": "从某种意义上说，这是数量重于质量的"}, {"type": "subtitle", "time": 4855.75, "timestamp": "01:20:55", "text": "问题。"}, {"type": "subtitle", "time": 4859.27, "timestamp": "01:20:59", "text": "我想看你写代码。  [笑声]"}]
[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "这真的很少见，但我可以转"}, {"type": "subtitle", "time": 604.23, "timestamp": "00:10:04", "text": "专业什么的。申请"}, {"type": "subtitle", "time": 612.421, "timestamp": "00:10:12", "text": "时间会证明一切。我现在也不知道"}, {"type": "subtitle", "time": 614.069, "timestamp": "00:10:14", "text": "。[嗤笑] 是"}, {"type": "subtitle", "time": 621.99, "timestamp": "00:10:21", "text": "我本来以为我可以摆脱学生生活，"}, {"type": "subtitle", "time": 624.23, "timestamp": "00:10:24", "text": "但看来它会"}, {"type": "subtitle", "time": 626.832, "timestamp": "00:10:26", "text": "永远伴随着我。[笑]"}, {"type": "subtitle", "time": 627.75, "timestamp": "00:10:27", "text": "[倒吸一口凉气]"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "如果我当初没有"}, {"type": "subtitle", "time": 634.15, "timestamp": "00:10:34", "text": "在生活中偷懒，而是认真学习，"}, {"type": "subtitle", "time": 638.389, "timestamp": "00:10:38", "text": "完成所有的事情，我本来可以的。但现在"}, {"type": "subtitle", "time": 642.31, "timestamp": "00:10:42", "text": "我意识到，是啊，有很多事情"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "好了，我刚才说到哪儿了？嗯，"}, {"type": "subtitle", "time": 659.59, "timestamp": "00:10:59", "text": "直播……我还想说，"}]
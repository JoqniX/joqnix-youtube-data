[{"type": "subtitle", "time": 10861.59, "timestamp": "03:01:01", "text": "[笑]"}, {"type": "subtitle", "time": 10863.75, "timestamp": "03:01:03", "text": "真的，第二次暗杀就要"}, {"type": "subtitle", "time": 10868.79, "timestamp": "03:01:08", "text": "但是，"}, {"type": "subtitle", "time": 10872.389, "timestamp": "03:01:12", "text": "我明白了，如果人们"}, {"type": "subtitle", "time": 10874.87, "timestamp": "03:01:14", "text": "嫉妒你，或者不同意你的观点，或者"}, {"type": "subtitle", "time": 10880.07, "timestamp": "03:01:20", "text": "其他什么原因，他们会怎么做。嗯，或者，"}, {"type": "subtitle", "time": 10882.63, "timestamp": "03:01:22", "text": "我不知道，他们会做很多事来"}, {"type": "subtitle", "time": 10885.75, "timestamp": "03:01:25", "text": "搞垮你，我"}, {"type": "subtitle", "time": 10887.67, "timestamp": "03:01:27", "text": "不明白，但这种事发生在"}, {"type": "subtitle", "time": 10890.469, "timestamp": "03:01:30", "text": "我身上了，现在我"}, {"type": "subtitle", "time": 10914.23, "timestamp": "03:01:54", "text": "即使你在视频里看到了"}, {"type": "subtitle", "time": 10919.91, "timestamp": "03:01:59", "text": "关于人际关系的这种变数，我还是害怕谈恋爱"}]
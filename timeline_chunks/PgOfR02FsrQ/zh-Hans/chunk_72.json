[{"type": "subtitle", "time": 4323.11, "timestamp": "01:12:03", "text": "好的。 所以，这个人实际上会去"}, {"type": "subtitle", "time": 4339.83, "timestamp": "01:12:19", "text": "没有其他逻辑可言了。"}, {"type": "subtitle", "time": 4356.87, "timestamp": "01:12:36", "text": "删除它。"}, {"type": "subtitle", "time": 4358.39, "timestamp": "01:12:38", "text": "耶。"}, {"type": "subtitle", "time": 4373.03, "timestamp": "01:12:53", "text": "我的意思是，没错，删除逻辑"}, {"type": "subtitle", "time": 4375.189, "timestamp": "01:12:55", "text": "实际上更容易理解。 别担心，不会"}, {"type": "subtitle", "time": 4378.55, "timestamp": "01:12:58", "text": "像某些人说的那么久，"}]
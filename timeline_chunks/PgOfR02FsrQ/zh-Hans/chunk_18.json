[{"type": "subtitle", "time": 1085.99, "timestamp": "00:18:05", "text": "呃，我"}, {"type": "subtitle", "time": 1087.75, "timestamp": "00:18:07", "text": "上周就该做个演讲了。我感觉"}, {"type": "subtitle", "time": 1089.83, "timestamp": "00:18:09", "text": "糟透了。我一直盼着能拖到下周。我的"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "哇。"}, {"type": "subtitle", "time": 1100.47, "timestamp": "00:18:20", "text": "我们居然拖延到"}, {"type": "subtitle", "time": 1103.669, "timestamp": "00:18:23", "text": "这种程度，真是不可思议。但我能理解。我能"}, {"type": "subtitle", "time": 1105.83, "timestamp": "00:18:25", "text": "理解。"}, {"type": "subtitle", "time": 1107.909, "timestamp": "00:18:27", "text": "这就是为什么我还要做日语作业之"}, {"type": "subtitle", "time": 1111.83, "timestamp": "00:18:31", "text": "类的。不，我一直拖到"}, {"type": "subtitle", "time": 1113.909, "timestamp": "00:18:33", "text": "最后一刻，结果为此付出了惨痛的代价，"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "因为我迟到了，"}, {"type": "subtitle", "time": 1122.549, "timestamp": "00:18:42", "text": "而且，呃，本来应该有个"}, {"type": "subtitle", "time": 1125.909, "timestamp": "00:18:45", "text": "突击考试之类的，或者说试卷之类的，"}, {"type": "subtitle", "time": 1129.11, "timestamp": "00:18:49", "text": "我想直播"}, {"type": "subtitle", "time": 1131.27, "timestamp": "00:18:51", "text": "复习什么的，因为如果"}, {"type": "subtitle", "time": 1134.23, "timestamp": "00:18:54", "text": "直播的话，我就能真正地"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "[哼]复习了。所以我就想"}, {"type": "subtitle", "time": 1138.47, "timestamp": "00:18:58", "text": "这么做。然后Sammy的事发生了。"}]
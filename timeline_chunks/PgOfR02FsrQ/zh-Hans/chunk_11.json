[{"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "我没睡。嗯，我熬夜了。"}, {"type": "subtitle", "time": 667.19, "timestamp": "00:11:07", "text": "晚上。我没在电脑旁。如果"}, {"type": "subtitle", "time": 670.389, "timestamp": "00:11:10", "text": "我在电脑旁做我的事，比如"}, {"type": "subtitle", "time": 673.509, "timestamp": "00:11:13", "text": "工作上的事。是的，我今天没直播，"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "因为我一整天都沉迷"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "于此。呃，我大概下午5点56分醒来。"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "我真的很想开"}, {"type": "subtitle", "time": 687.59, "timestamp": "00:11:27", "text": "个直播。然后我就想，"}, {"type": "subtitle", "time": 690.23, "timestamp": "00:11:30", "text": "“好吧，算了，这是"}, {"type": "subtitle", "time": 693.67, "timestamp": "00:11:33", "text": "周末。” 我还是休息一下吧。 我"}, {"type": "subtitle", "time": 697.269, "timestamp": "00:11:37", "text": "想看动漫。 我今天想放松一下。”所以，"}, {"type": "subtitle", "time": 699.91, "timestamp": "00:11:39", "text": "我悠闲地待着，但也稍微"}, {"type": "subtitle", "time": 702.31, "timestamp": "00:11:42", "text": "工作了一会儿。一切都很"}, {"type": "subtitle", "time": 704.63, "timestamp": "00:11:44", "text": "顺利，"}, {"type": "subtitle", "time": 709.67, "timestamp": "00:11:49", "text": "活动什么的。嗯，就"}, {"type": "subtitle", "time": 712.87, "timestamp": "00:11:52", "text": "代码活动方面来说，只剩下"}, {"type": "subtitle", "time": 716.31, "timestamp": "00:11:56", "text": "删除工作了。"}, {"type": "subtitle", "time": 719.829, "timestamp": "00:11:59", "text": "除此之外，一切都很好。至于"}]
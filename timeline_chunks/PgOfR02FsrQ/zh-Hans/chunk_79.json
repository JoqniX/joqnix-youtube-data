[{"type": "subtitle", "time": 4742.07, "timestamp": "01:19:02", "text": "。 人们永远"}, {"type": "subtitle", "time": 4744.149, "timestamp": "01:19:04", "text": "不会知道我一边聊天一边一直在"}, {"type": "subtitle", "time": 4748.229, "timestamp": "01:19:08", "text": "玩游戏。 你好，克拉。"}, {"type": "subtitle", "time": 4755.59, "timestamp": "01:19:15", "text": "展示。 那是我"}, {"type": "subtitle", "time": 4759.43, "timestamp": "01:19:19", "text": "训练自己多说话的方法之一，"}, {"type": "subtitle", "time": 4761.99, "timestamp": "01:19:21", "text": "因为我不太擅长"}, {"type": "subtitle", "time": 4765.11, "timestamp": "01:19:25", "text": "闲聊。 我现在很少说话，也不怎么发"}, {"type": "subtitle", "time": 4768.229, "timestamp": "01:19:28", "text": "话题什么的。 所以它让"}, {"type": "subtitle", "time": 4771.11, "timestamp": "01:19:31", "text": "我感觉更像是一种"}, {"type": "subtitle", "time": 4774.31, "timestamp": "01:19:34", "text": "挑战，我过去常常设定这样的目标："}, {"type": "subtitle", "time": 4777.11, "timestamp": "01:19:37", "text": "随机选出五个话题，然后"}, {"type": "subtitle", "time": 4781.27, "timestamp": "01:19:41", "text": "谈论它们。 你"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "随便聊些话题，然后就聊聊"}, {"type": "subtitle", "time": 4786.785, "timestamp": "01:19:46", "text": "。 看看我能用音乐将故事延伸到什么程度"}, {"type": "subtitle", "time": 4789.99, "timestamp": "01:19:49", "text": "。 看看我能"}, {"type": "subtitle", "time": 4794.55, "timestamp": "01:19:54", "text": "胡乱说多少话。"}, {"type": "subtitle", "time": 4796.63, "timestamp": "01:19:56", "text": "所以，"}]
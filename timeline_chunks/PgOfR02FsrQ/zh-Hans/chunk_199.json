[{"type": "subtitle", "time": 11944.07, "timestamp": "03:19:04", "text": "它念出来。"}, {"type": "subtitle", "time": 11947.11, "timestamp": "03:19:07", "text": "在《海洋奇缘》里，我 我只能用谷歌"}, {"type": "subtitle", "time": 11950.469, "timestamp": "03:19:10", "text": "翻译来听，然后想办法"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "模仿，或者读那种蹩脚的英语"}, {"type": "subtitle", "time": 11957.67, "timestamp": "03:19:17", "text": "版本。[嗤笑]"}, {"type": "subtitle", "time": 11965.349, "timestamp": "03:19:25", "text": "我会说话，但总是失败。一样一样"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "我的天哪。一样。"}, {"type": "subtitle", "time": 11986.309, "timestamp": "03:19:46", "text": "直到今天，我甚至都看不懂公交车、"}, {"type": "subtitle", "time": 11990.71, "timestamp": "03:19:50", "text": "商店之类的招牌。如果输入了，"}, {"type": "subtitle", "time": 11994.469, "timestamp": "03:19:54", "text": "我得花好长时间把"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "每个字母都列出来，然后再"}]
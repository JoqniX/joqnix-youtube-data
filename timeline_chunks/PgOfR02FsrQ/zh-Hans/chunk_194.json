[{"type": "subtitle", "time": 11688.95, "timestamp": "03:14:48", "text": "我想念我的家乡。等等，你不在"}, {"type": "subtitle", "time": 11691.269, "timestamp": "03:14:51", "text": "钦奈？哦，是的。等等，你是说，"}, {"type": "subtitle", "time": 11693.99, "timestamp": "03:14:53", "text": "等等，你是不是那个在"}, {"type": "subtitle", "time": 11697.19, "timestamp": "03:14:57", "text": "班加罗尔的人，为了你的"}]
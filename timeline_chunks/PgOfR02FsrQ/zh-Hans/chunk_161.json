[{"type": "subtitle", "time": 9660.07, "timestamp": "02:41:00", "text": "呃，如果真的……呃，"}, {"type": "subtitle", "time": 9663.51, "timestamp": "02:41:03", "text": "如果我真的想让"}, {"type": "subtitle", "time": 9671.27, "timestamp": "02:41:11", "text": "他们会抽出时间吗？我明白，他们是"}, {"type": "subtitle", "time": 9673.91, "timestamp": "02:41:13", "text": "高等法院的律师，他们"}, {"type": "subtitle", "time": 9677.03, "timestamp": "02:41:17", "text": "很忙，他们早上很忙，不，"}, {"type": "subtitle", "time": 9679.59, "timestamp": "02:41:19", "text": "他们"}, {"type": "subtitle", "time": 9681.75, "timestamp": "02:41:21", "text": "晚上"}, {"type": "subtitle", "time": 9683.83, "timestamp": "02:41:23", "text": "法院结束后才到办公室。"}, {"type": "subtitle", "time": 9686.896, "timestamp": "02:41:26", "text": "他们要处理的工作和案件实在太多了。"}, {"type": "subtitle", "time": 9691.67, "timestamp": "02:41:31", "text": "[嗤笑] 我们会到达那里的。 但是，"}, {"type": "subtitle", "time": 9695.67, "timestamp": "02:41:35", "text": "我觉得如果"}, {"type": "subtitle", "time": 9697.11, "timestamp": "02:41:37", "text": "我只是"}, {"type": "subtitle", "time": 9700.309, "timestamp": "02:41:40", "text": "想着"}, {"type": "subtitle", "time": 9702.389, "timestamp": "02:41:42", "text": "不停地打电话、不停地"}, {"type": "subtitle", "time": 9706.547, "timestamp": "02:41:46", "text": "骚扰他们，事情就会容易得多。"}, {"type": "subtitle", "time": 9708.309, "timestamp": "02:41:48", "text": "[笑声] 你知道，太烦人也不"}, {"type": "subtitle", "time": 9717.51, "timestamp": "02:41:57", "text": "那里的助理负责接听预约电话、"}, {"type": "subtitle", "time": 9719.51, "timestamp": "02:41:59", "text": "协调各项事宜。 是的。 是的。"}]
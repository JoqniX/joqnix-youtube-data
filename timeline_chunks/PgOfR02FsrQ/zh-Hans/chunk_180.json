[{"type": "subtitle", "time": 10800.63, "timestamp": "03:00:00", "text": "为什么我认为，这"}, {"type": "subtitle", "time": 10802.79, "timestamp": "03:00:02", "text": "也是律师指出的一点，"}, {"type": "subtitle", "time": 10812.07, "timestamp": "03:00:12", "text": "我不认为情况更糟，对吧？那个"}, {"type": "subtitle", "time": 10816.07, "timestamp": "03:00:16", "text": "牧师还在，我"}, {"type": "subtitle", "time": 10819.349, "timestamp": "03:00:19", "text": "知道他还在联系我，但是，呃，我已经"}, {"type": "subtitle", "time": 10821.75, "timestamp": "03:00:21", "text": "屏蔽了他。但是，呃，是的"}, {"type": "subtitle", "time": 10829.03, "timestamp": "03:00:29", "text": "[倒吸一口凉气]，即使在"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "互联网上，在被证明有罪之前，一切都是…… 正好"}, {"type": "subtitle", "time": 10841.59, "timestamp": "03:00:41", "text": "我只能祈祷自己别再"}, {"type": "subtitle", "time": 10844.15, "timestamp": "03:00:44", "text": "卷入另一场闹剧"}, {"type": "subtitle", "time": 10847.429, "timestamp": "03:00:47", "text": "什么的，因为人们会借此机会炒作之前那件事，然后"}, {"type": "subtitle", "time": 10855.349, "timestamp": "03:00:55", "text": "他们会说，哦，他这样那样，然后就像真的"}]
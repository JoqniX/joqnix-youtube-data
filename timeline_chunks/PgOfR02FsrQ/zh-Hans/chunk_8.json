[{"type": "subtitle", "time": 485.35, "timestamp": "00:08:05", "text": "哦，对。最近，我一直想"}, {"type": "subtitle", "time": 493.67, "timestamp": "00:08:13", "text": "我喜欢它的画面风格，它更像是"}, {"type": "subtitle", "time": 497.27, "timestamp": "00:08:17", "text": "魂系游戏，融合了角色扮演元素"}, {"type": "subtitle", "time": 499.909, "timestamp": "00:08:19", "text": "。"}, {"type": "subtitle", "time": 503.189, "timestamp": "00:08:23", "text": "我更喜欢单人游戏。它也有"}, {"type": "subtitle", "time": 507.27, "timestamp": "00:08:27", "text": "合作模式，但主要是单人"}, {"type": "subtitle", "time": 510.23, "timestamp": "00:08:30", "text": "游戏。游戏里有一个充满情感的世界，有"}, {"type": "chat", "time": 511.532, "timestamp": "00:08:31", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I told my psychiatrist that I feel inadequate because I still don’t have a college degree."}, {"type": "subtitle", "time": 513.35, "timestamp": "00:08:33", "text": "很多事情可以做。感觉很适合我，"}, {"type": "subtitle", "time": 516.149, "timestamp": "00:08:36", "text": "嗯……[哼]"}, {"type": "subtitle", "time": 523.11, "timestamp": "00:08:43", "text": "因为我喜欢刷怪。我喜欢"}, {"type": "subtitle", "time": 526.55, "timestamp": "00:08:46", "text": "制作物品。我喜欢沉浸"}, {"type": "subtitle", "time": 538.55, "timestamp": "00:08:58", "text": "我跟我的心理医生说，我觉得自己很"}]
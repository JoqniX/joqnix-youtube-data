[{"type": "subtitle", "time": 1922.31, "timestamp": "00:32:02", "text": "不满足的"}, {"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "你觉得我话多吗？"}, {"type": "subtitle", "time": 1935.83, "timestamp": "00:32:15", "text": "我……"}, {"type": "subtitle", "time": 1938.87, "timestamp": "00:32:18", "text": "其实我不知道我是不是话"}, {"type": "subtitle", "time": 1947.35, "timestamp": "00:32:27", "text": "当然。我的意思是，"}, {"type": "subtitle", "time": 1949.509, "timestamp": "00:32:29", "text": "如果你是主播，你就得"}, {"type": "subtitle", "time": 1953.11, "timestamp": "00:32:33", "text": "话多。就是这样，对吧？你"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "得不停地说。"}]
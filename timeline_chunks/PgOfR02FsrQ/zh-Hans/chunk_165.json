[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "我很好奇打官司的费用到底有多高？"}, {"type": "subtitle", "time": 9911.269, "timestamp": "02:45:11", "text": "诽谤之类的案件是不是特别贵？ 是不是"}, {"type": "subtitle", "time": 9918.87, "timestamp": "02:45:18", "text": "我的意思是，就像我的法律声明里写明我"}, {"type": "subtitle", "time": 9922.469, "timestamp": "02:45:22", "text": "可以起诉别人一样。 我可以就"}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": "精神损害和个人信息泄露提起诉讼，对吧？"}, {"type": "subtitle", "time": 9931.11, "timestamp": "02:45:31", "text": "她公开谈论这些事，"}, {"type": "subtitle", "time": 9937.269, "timestamp": "02:45:37", "text": "但确实，她受到的情感伤害很大。   就在"}]
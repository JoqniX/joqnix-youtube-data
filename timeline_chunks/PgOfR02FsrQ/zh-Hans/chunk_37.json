[{"type": "subtitle", "time": 2220.39, "timestamp": "00:37:00", "text": "比如"}, {"type": "subtitle", "time": 2224.39, "timestamp": "00:37:04", "text": "我开始"}, {"type": "subtitle", "time": 2227.03, "timestamp": "00:37:07", "text": "直播之后的事情。"}, {"type": "subtitle", "time": 2231.27, "timestamp": "00:37:11", "text": "就想聊聊推特，聊聊"}, {"type": "subtitle", "time": 2234.71, "timestamp": "00:37:14", "text": "推特上那些"}, {"type": "subtitle", "time": 2238.71, "timestamp": "00:37:18", "text": "乱七八糟的事情。比如"}, {"type": "subtitle", "time": 2241.51, "timestamp": "00:37:21", "text": "这个那个。"}, {"type": "subtitle", "time": 2246.79, "timestamp": "00:37:26", "text": "我在推特上的经历，或者其他什么"}, {"type": "subtitle", "time": 2251.349, "timestamp": "00:37:31", "text": "。然后我意识到，我"}, {"type": "subtitle", "time": 2254.31, "timestamp": "00:37:34", "text": "应该这么做吗？"}, {"type": "subtitle", "time": 2256.47, "timestamp": "00:37:36", "text": "但是，是的，我不应该给自己设限"}, {"type": "subtitle", "time": 2260.39, "timestamp": "00:37:40", "text": "太多。这就是我的风格。呃，如果我"}, {"type": "subtitle", "time": 2263.349, "timestamp": "00:37:43", "text": "想做，那就去做。就去做，就"}, {"type": "subtitle", "time": 2267.75, "timestamp": "00:37:47", "text": "去做。[笑]"}, {"type": "subtitle", "time": 2276.069, "timestamp": "00:37:56", "text": "这大概就是我进步的方式，"}, {"type": "subtitle", "time": 2278.79, "timestamp": "00:37:58", "text": "对吧？"}]
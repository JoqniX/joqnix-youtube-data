[{"type": "subtitle", "time": 5821.27, "timestamp": "01:37:01", "text": "我甚至想过，如果我能"}, {"type": "subtitle", "time": 5823.27, "timestamp": "01:37:03", "text": "自己想办法做出来呢？"}, {"type": "subtitle", "time": 5826.55, "timestamp": "01:37:06", "text": "类似地，类似于"}, {"type": "subtitle", "time": 5829.03, "timestamp": "01:37:09", "text": "聊天中有人输入"}, {"type": "subtitle", "time": 5834.07, "timestamp": "01:37:14", "text": "感叹号“拥抱”或“爱”来向"}, {"type": "subtitle", "time": 5836.47, "timestamp": "01:37:16", "text": "另一个用户发送消息的功能，会有一定几率触发，就像"}, {"type": "subtitle", "time": 5845.189, "timestamp": "01:37:25", "text": "掷骰子一样"}, {"type": "subtitle", "time": 5853.27, "timestamp": "01:37:33", "text": "我相信有人已经实现了这个功能，我可以"}, {"type": "subtitle", "time": 5855.109, "timestamp": "01:37:35", "text": "直接从 Sammy Discord 复制按钮，"}, {"type": "subtitle", "time": 5857.99, "timestamp": "01:37:37", "text": "或者我自己想办法实现"}, {"type": "subtitle", "time": 5860.55, "timestamp": "01:37:40", "text": "。 我只需要动动脑筋，或者"}, {"type": "subtitle", "time": 5864.272, "timestamp": "01:37:44", "text": "如果我遇到困难，我可以……我想"}, {"type": "subtitle", "time": 5866.149, "timestamp": "01:37:46", "text": "[笑声]"}, {"type": "chat", "time": 5879.047, "timestamp": "01:37:59", "author": "@TheDivineGokuBlack", "avatar": "https://yt4.ggpht.com/x2pzeEVaf1zyUBkZCrzTAzUJCua_ZlOHqOBCVhiADyCWmaW54l65hftnOmbOFY2vCGVSXGk5Ng=s64-c-k-c0x00ffffff-no-rj", "message": "Chatgpt is the goat"}]
[{"type": "subtitle", "time": 10441.51, "timestamp": "02:54:01", "text": "开始那样，他们就像"}, {"type": "subtitle", "time": 10444.55, "timestamp": "02:54:04", "text": "受害者，不想……不想走"}, {"type": "subtitle", "time": 10446.55, "timestamp": "02:54:06", "text": "法律途径。"}, {"type": "subtitle", "time": 10448.95, "timestamp": "02:54:08", "text": "他们就是"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "这样。"}, {"type": "subtitle", "time": 10454.15, "timestamp": "02:54:14", "text": "我不知道。我不应该说"}, {"type": "subtitle", "time": 10456.79, "timestamp": "02:54:16", "text": "太多，伙计。这……（笑）这……"}, {"type": "subtitle", "time": 10458.79, "timestamp": "02:54:18", "text": "只是……（倒吸一口气）"}, {"type": "subtitle", "time": 10460.87, "timestamp": "02:54:20", "text": "有很多事情我觉得"}, {"type": "subtitle", "time": 10466.389, "timestamp": "02:54:26", "text": "也很有趣。嗯……（笑）"}, {"type": "subtitle", "time": 10469.03, "timestamp": "02:54:29", "text": "嗯……"}, {"type": "subtitle", "time": 10484.87, "timestamp": "02:54:44", "text": "我再多说吧。没关系。没关系。都"}, {"type": "subtitle", "time": 10488.469, "timestamp": "02:54:48", "text": "过去了。"}, {"type": "subtitle", "time": 10491.67, "timestamp": "02:54:51", "text": "我是说，我今天一直在想这件事。"}, {"type": "subtitle", "time": 10494.55, "timestamp": "02:54:54", "text": "嗯，其实是今天，因为我"}, {"type": "subtitle", "time": 10496.71, "timestamp": "02:54:56", "text": "晚上睡不着。不，我其实在"}, {"type": "subtitle", "time": 10499.51, "timestamp": "02:54:59", "text": "想做一个视频，因为我已经很久没做"}]
[{"type": "subtitle", "time": 4863.669, "timestamp": "01:21:03", "text": "嘿，左边那边还有更多屏幕呢"}, {"type": "subtitle", "time": 4867.59, "timestamp": "01:21:07", "text": "。 我的天啊。 别担心，"}, {"type": "subtitle", "time": 4878.229, "timestamp": "01:21:18", "text": "。"}, {"type": "subtitle", "time": 4881.99, "timestamp": "01:21:21", "text": "另外，嗯，我一直在想，我确实"}, {"type": "subtitle", "time": 4888.55, "timestamp": "01:21:28", "text": "我认为你只需要找到保持"}, {"type": "subtitle", "time": 4899.189, "timestamp": "01:21:39", "text": "我还想实现垂直流"}, {"type": "subtitle", "time": 4902.721, "timestamp": "01:21:42", "text": "。 是的。 垂直流。 好的。"}, {"type": "subtitle", "time": 4912.149, "timestamp": "01:21:52", "text": "我做的这套系统，这整个系统，都只适用于"}, {"type": "subtitle", "time": 4915.51, "timestamp": "01:21:55", "text": "水平安装。 好的？ 如果垂直方向的"}, {"type": "subtitle", "time": 4918.87, "timestamp": "01:21:58", "text": "气流进入回路，那可就糟了"}]
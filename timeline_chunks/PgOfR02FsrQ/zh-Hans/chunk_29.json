[{"type": "subtitle", "time": 1741.669, "timestamp": "00:29:01", "text": "我会一直[哼]说个不停"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "。 这更像是一种练习，教我"}, {"type": "subtitle", "time": 1749.11, "timestamp": "00:29:09", "text": "如何才能持续说话，因为"}, {"type": "subtitle", "time": 1751.669, "timestamp": "00:29:11", "text": "我其实是个不爱说话的人。 我不太爱说话，"}, {"type": "subtitle", "time": 1754.389, "timestamp": "00:29:14", "text": "我觉得即使我在直播玩游戏"}, {"type": "subtitle", "time": 1756.71, "timestamp": "00:29:16", "text": "，如果是那种非常"}, {"type": "subtitle", "time": 1758.95, "timestamp": "00:29:18", "text": "专注的直播，我也会"}, {"type": "subtitle", "time": 1761.669, "timestamp": "00:29:21", "text": "非常安静专注，我觉得这样"}, {"type": "subtitle", "time": 1763.99, "timestamp": "00:29:23", "text": "不好。 我当时想（音乐），如果聊天室里没有人谈论某个话题，我"}, {"type": "subtitle", "time": 1766.23, "timestamp": "00:29:26", "text": "就不能做纯粹的聊天内容，"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "甚至不能做任何形式的聊天"}, {"type": "subtitle", "time": 1775.43, "timestamp": "00:29:35", "text": "。 所以我尝试"}, {"type": "subtitle", "time": 1779.029, "timestamp": "00:29:39", "text": "通过讨论如何想出"}, {"type": "subtitle", "time": 1782.149, "timestamp": "00:29:42", "text": "话题、编故事、创作一个"}, {"type": "subtitle", "time": 1785.83, "timestamp": "00:29:45", "text": "易于理解的故事等等来反复练习。 我"}, {"type": "subtitle", "time": 1787.505, "timestamp": "00:29:47", "text": "做不到那些[笑声]"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "[倒吸一口凉气]，是"}, {"type": "subtitle", "time": 1792.549, "timestamp": "00:29:52", "text": "的，我做不到，但是，嗯，是的，"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "我以前会一边玩"}]
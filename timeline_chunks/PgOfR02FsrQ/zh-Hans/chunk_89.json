[{"type": "subtitle", "time": 5340.07, "timestamp": "01:29:00", "text": "分钟、每五分钟、每三分钟、每两分钟，"}, {"type": "subtitle", "time": 5342.709, "timestamp": "01:29:02", "text": "它都会不断地将三两分钟加"}, {"type": "subtitle", "time": 5346.161, "timestamp": "01:29:06", "text": "三两分钟添加到事件中。"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "[笑声和惊叹声]"}, {"type": "subtitle", "time": 5349.99, "timestamp": "01:29:09", "text": "嗯，"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "但这感觉真不错。   是的"}, {"type": "subtitle", "time": 5353.92, "timestamp": "01:29:13", "text": "。   是的 。 嗯，"}, {"type": "subtitle", "time": 5356.96, "timestamp": "01:29:16", "text": "。 嗯， 我还要执行最后的删除逻辑，"}, {"type": "subtitle", "time": 5361.92, "timestamp": "01:29:21", "text": "我还要执行最后的删除逻辑， 我现在就去做。 然后"}, {"type": "subtitle", "time": 5363.92, "timestamp": "01:29:23", "text": "我现在就去做。 然后 我就要开始着手制作"}, {"type": "subtitle", "time": 5365.44, "timestamp": "01:29:25", "text": "我就要开始着手制作 公告"}, {"type": "subtitle", "time": 5371.75, "timestamp": "01:29:31", "text": "按钮了[嗤笑]呃之类的东西。"}, {"type": "subtitle", "time": 5374.31, "timestamp": "01:29:34", "text": "嗯，所以我们把之前为活动所做的一切都复制过来，"}, {"type": "subtitle", "time": 5377.189, "timestamp": "01:29:37", "text": "然后把同样的逻辑应用到"}, {"type": "subtitle", "time": 5380.629, "timestamp": "01:29:40", "text": "播音员那部分。 播音员不需要"}, {"type": "subtitle", "time": 5383.51, "timestamp": "01:29:43", "text": "像[音乐]删除逻辑那样的功能，只需要"}, {"type": "subtitle", "time": 5386.629, "timestamp": "01:29:46", "text": "补丁功能就行了。"}, {"type": "subtitle", "time": 5389.03, "timestamp": "01:29:49", "text": "显示名称警告。 我刚才"}, {"type": "subtitle", "time": 5391.43, "timestamp": "01:29:51", "text": "看到了什么？ 警告。"}, {"type": "subtitle", "time": 5394.07, "timestamp": "01:29:54", "text": "Better Studio Webocket 未安装。"}, {"type": "subtitle", "time": 5396.79, "timestamp": "01:29:56", "text": "什么？ 哦，对了，我没有运行 Web"}]
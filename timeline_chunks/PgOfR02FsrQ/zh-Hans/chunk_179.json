[{"type": "subtitle", "time": 10740.309, "timestamp": "02:59:00", "text": "呃，是的，所有看过我节目的人，"}, {"type": "subtitle", "time": 10742.79, "timestamp": "02:59:02", "text": "这些年来都认识我，甚至包括"}, {"type": "subtitle", "time": 10745.75, "timestamp": "02:59:05", "text": "我关系亲近的人，他们都说，是"}, {"type": "subtitle", "time": 10748.009, "timestamp": "02:59:08", "text": "啊，我不认识他"}, {"type": "subtitle", "time": 10748.63, "timestamp": "02:59:08", "text": "[笑]，"}, {"type": "subtitle", "time": 10751.269, "timestamp": "02:59:11", "text": "但这份文件说得太对了，"}, {"type": "subtitle", "time": 10755.03, "timestamp": "02:59:15", "text": "至少他可以等我的"}, {"type": "subtitle", "time": 10761.349, "timestamp": "02:59:21", "text": "大家的反应让我"}, {"type": "subtitle", "time": 10763.269, "timestamp": "02:59:23", "text": "觉得我像个罪犯似的"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "。"}, {"type": "subtitle", "time": 10768.87, "timestamp": "02:59:28", "text": "然后，然后，还有我的事情。不，我在现实生活中"}, {"type": "subtitle", "time": 10771.19, "timestamp": "02:59:31", "text": "遇到的事情，我是现实"}, {"type": "subtitle", "time": 10774.309, "timestamp": "02:59:34", "text": "生活中的受害者，"}, {"type": "subtitle", "time": 10775.83, "timestamp": "02:59:35", "text": "对吧？"}, {"type": "subtitle", "time": 10778.389, "timestamp": "02:59:38", "text": "那和网上的事情相比。网上的事情根本算不上什么，那是"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "两个人之间的事情，双方都"}, {"type": "subtitle", "time": 10790.309, "timestamp": "02:59:50", "text": "参与其中，对吧？和"}, {"type": "subtitle", "time": 10792.55, "timestamp": "02:59:52", "text": "我在现实生活中遇到的事情相比，那根本"}]
[{"type": "subtitle", "time": 6062.95, "timestamp": "01:41:02", "text": "。"}, {"type": "subtitle", "time": 6066.015, "timestamp": "01:41:06", "text": "サミーはTwitchのコマンドをたくさん持っているけど、"}, {"type": "subtitle", "time": 6074.39, "timestamp": "01:41:14", "text": "コメントを読んで、うん、"}, {"type": "subtitle", "time": 6083.35, "timestamp": "01:41:23", "text": "コメントへのリンクを貼らないといけないんだよね。"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "君がやってることはすごくクールだよ。 まるで"}, {"type": "subtitle", "time": 6092.629, "timestamp": "01:41:32", "text": "自分のアカウントではなく、他の人の配信に参加して、自分の配信で"}, {"type": "subtitle", "time": 6095.83, "timestamp": "01:41:35", "text": "コマンドを実行できるようなものです。 それは"}, {"type": "subtitle", "time": 6097.83, "timestamp": "01:41:37", "text": "次のレベルの話だ。 それはまさに"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "チャタリーノの行動そのものですね。"}, {"type": "subtitle", "time": 6104.229, "timestamp": "01:41:44", "text": "他の人のチャットを読んだり、配信コンテンツを見たりできる仕組み。"}, {"type": "subtitle", "time": 6106.95, "timestamp": "01:41:46", "text": "ええと、"}, {"type": "subtitle", "time": 6109.27, "timestamp": "01:41:49", "text": "ゲーム機を持っているのは良いことですね。"}, {"type": "subtitle", "time": 6113.91, "timestamp": "01:41:53", "text": "コンソールもありますよ。 何てことだ。 すごくかっこいい。 クレイジー・"}, {"type": "subtitle", "time": 6116.47, "timestamp": "01:41:56", "text": "ディオ、"}, {"type": "subtitle", "time": 6118.229, "timestamp": "01:41:58", "text": "クレイジー。"}]
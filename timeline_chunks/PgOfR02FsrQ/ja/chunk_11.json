[{"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "寝てないって言いたかったんだ。一"}, {"type": "subtitle", "time": 667.19, "timestamp": "00:11:07", "text": "晩中起きてたんだ。  PC ではやってない。もし"}, {"type": "subtitle", "time": 670.389, "timestamp": "00:11:10", "text": "PC で Sammy の仕事や"}, {"type": "subtitle", "time": 673.509, "timestamp": "00:11:13", "text": "仕事をしていたら。そう、"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "今日は一日中"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "これに張り付いていたので、ストリーミングはしなかった。えーと、午後 5 時 6 分に起きた。"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "本当にストリームをやりたかった"}, {"type": "subtitle", "time": 687.59, "timestamp": "00:11:27", "text": "。それから、"}, {"type": "subtitle", "time": 690.23, "timestamp": "00:11:30", "text": "「よし、"}, {"type": "subtitle", "time": 693.67, "timestamp": "00:11:33", "text": "週末だから」と思った。 ゆっくり休むよ。 私は"}, {"type": "subtitle", "time": 697.269, "timestamp": "00:11:37", "text": "アニメを見たい。 今日はのんびりしたい。だから、"}, {"type": "subtitle", "time": 699.91, "timestamp": "00:11:39", "text": "ゆっくり時間をかけて作業したけど、"}, {"type": "subtitle", "time": 702.31, "timestamp": "00:11:42", "text": "少しは作業もした。"}, {"type": "subtitle", "time": 709.67, "timestamp": "00:11:49", "text": "イベントとかは完全にうまく機能している。えーと、この"}, {"type": "subtitle", "time": 712.87, "timestamp": "00:11:52", "text": "コードのイベント関連のことだけ。あとは"}, {"type": "subtitle", "time": 716.31, "timestamp": "00:11:56", "text": "削除する作業だけ。"}, {"type": "subtitle", "time": 719.829, "timestamp": "00:11:59", "text": "それ以外は全て順調。"}]
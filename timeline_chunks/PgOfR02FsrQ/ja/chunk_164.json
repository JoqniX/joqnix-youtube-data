[{"type": "subtitle", "time": 9842.79, "timestamp": "02:44:02", "text": "GPDに送り込んだ。だからGPDは"}, {"type": "subtitle", "time": 9845.67, "timestamp": "02:44:05", "text": "独裁者がそれを使って見つけるかもしれないと知っている。"}, {"type": "subtitle", "time": 9856.71, "timestamp": "02:44:16", "text": "私も法的声明を報告していた。だから"}, {"type": "subtitle", "time": 9859.67, "timestamp": "02:44:19", "text": "クレイジーな男だ。受け取りたくない。"}, {"type": "subtitle", "time": 9861.75, "timestamp": "02:44:21", "text": "あなたは私についてたくさんの嘘をついていたから、私は"}, {"type": "subtitle", "time": 9874.309, "timestamp": "02:44:34", "text": "[鼻を鳴らす] ちょっと"}, {"type": "subtitle", "time": 9877.429, "timestamp": "02:44:37", "text": "待って、"}, {"type": "subtitle", "time": 9880.309, "timestamp": "02:44:40", "text": "聞いていいのかどうかわからないんだけど、あなたの物って実際に"}, {"type": "subtitle", "time": 9883.11, "timestamp": "02:44:43", "text": "ケースとかになるの？"}, {"type": "subtitle", "time": 9888.638, "timestamp": "02:44:48", "text": "それとも、法的通知のようなものですか？それとも、えーと"}, {"type": "subtitle", "time": 9891.349, "timestamp": "02:44:51", "text": "[鼻を鳴らす] 何て言うんだっけ？"}, {"type": "subtitle", "time": 9893.75, "timestamp": "02:44:53", "text": "えっと、中止命令とかそういう類のものですか？"}, {"type": "subtitle", "time": 9895.83, "timestamp": "02:44:55", "text": "それとも実際に裁判になるんですか"}, {"type": "subtitle", "time": 9898.07, "timestamp": "02:44:58", "text": "？"}]
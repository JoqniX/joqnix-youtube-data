[{"type": "subtitle", "time": 3302.549, "timestamp": "00:55:02", "text": "ほら、ほら、ほら、ほら。 追加しました。午後1時24分"}, {"type": "subtitle", "time": 3323.51, "timestamp": "00:55:23", "text": "カウントを変更するのを忘れていました。 だから、"}, {"type": "subtitle", "time": 3328.63, "timestamp": "00:55:28", "text": "この映像は配信用に撮影しなかったんです。"}, {"type": "subtitle", "time": 3331.109, "timestamp": "00:55:31", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 3334.309, "timestamp": "00:55:34", "text": "。 待って、待って、待って。"}, {"type": "subtitle", "time": 3337.67, "timestamp": "00:55:37", "text": "じゃあ、最後の日をリロードする前に"}, {"type": "subtitle", "time": 3340.71, "timestamp": "00:55:40", "text": "382だけ入力して、"}]
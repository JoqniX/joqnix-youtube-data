[{"type": "subtitle", "time": 12320.469, "timestamp": "03:25:20", "text": "うん、でも、これを早く終わらせたい"}, {"type": "subtitle", "time": 12324.71, "timestamp": "03:25:24", "text": "。すごく早く。そうすれば、"}, {"type": "subtitle", "time": 12326.71, "timestamp": "03:25:26", "text": "朝食を食べて"}, {"type": "subtitle", "time": 12328.229, "timestamp": "03:25:28", "text": "寝られる。"}, {"type": "subtitle", "time": 12330.389, "timestamp": "03:25:30", "text": "すぐに終わるよ。"}, {"type": "subtitle", "time": 12341.67, "timestamp": "03:25:41", "text": "削除するだけのはずだったのに、"}, {"type": "subtitle", "time": 12343.99, "timestamp": "03:25:43", "text": "画像を作っている私を見て。 いろいろあったけど、"}, {"type": "subtitle", "time": 12348.192, "timestamp": "03:25:48", "text": "パッチのところでまだ詰まってる。"}]
[{"type": "subtitle", "time": 2100.95, "timestamp": "00:35:00", "text": "ボタンの説明にも書いてあります。最初のボタンの2番目の部分、"}, {"type": "subtitle", "time": 2103.829, "timestamp": "00:35:03", "text": "2番目のパッチ部分は完了です"}, {"type": "subtitle", "time": 2105.51, "timestamp": "00:35:05", "text": "。"}, {"type": "subtitle", "time": 2109.43, "timestamp": "00:35:09", "text": "はい。次は削除"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "ロジックです。"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "削除ロジックを実行したかったのですが、イベントを変更するのを"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "忘れていたことに気づきました。イベントを変更するのを"}, {"type": "subtitle", "time": 2128.47, "timestamp": "00:35:28", "text": "忘れていました。"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "イベントの時間を延長するのを忘れていました。"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "昨日から私のサーバーでDiscordイベントがあったことに気づいたかもしれません。"}, {"type": "subtitle", "time": 2139.91, "timestamp": "00:35:39", "text": "ええ、いくつかテストしていたのですが、"}, {"type": "subtitle", "time": 2145.51, "timestamp": "00:35:45", "text": "延長するのを忘れていて、"}, {"type": "subtitle", "time": 2148.069, "timestamp": "00:35:48", "text": "Cloudflare"}, {"type": "subtitle", "time": 2153.109, "timestamp": "00:35:53", "text": "Warpをオンにしていたため、ボタンが実行されませんでした。いくつかの問題が発生しました。そのため、フェイルセーフを"}, {"type": "subtitle", "time": 2156.71, "timestamp": "00:35:56", "text": "作成する必要がありました。"}]
[{"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "。 それで、もしかして、私の"}, {"type": "subtitle", "time": 5898.229, "timestamp": "01:38:18", "text": "チャットをスキャンしたとか？"}, {"type": "subtitle", "time": 5902.229, "timestamp": "01:38:22", "text": "おお。 どうやって？ 待って。 そうそう。 そうそう。"}, {"type": "subtitle", "time": 5905.109, "timestamp": "01:38:25", "text": "待って。 あなたはそれを監視しているのです。"}, {"type": "subtitle", "time": 5907.43, "timestamp": "01:38:27", "text": "何？ それはまさにチャタリーノの言動そのものだ"}, {"type": "subtitle", "time": 5913.99, "timestamp": "01:38:33", "text": "チャットに参加できましたね。 おお、これは"}, {"type": "subtitle", "time": 5916.673, "timestamp": "01:38:36", "text": "すごい。 それはすごくクールですね。"}, {"type": "subtitle", "time": 5918.149, "timestamp": "01:38:38", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 5928.629, "timestamp": "01:38:48", "text": "どうやってハードコーディングしたんですか？それとも"}, {"type": "subtitle", "time": 5931.669, "timestamp": "01:38:51", "text": "ハードコーディングしたんですか？それとも、"}, {"type": "subtitle", "time": 5939.03, "timestamp": "01:38:59", "text": "サミーとかストリーマー"}]
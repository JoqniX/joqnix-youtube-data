[{"type": "subtitle", "time": 5044.79, "timestamp": "01:24:04", "text": "うん。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 5047.189, "timestamp": "01:24:07", "text": "楽になるよ。"}, {"type": "subtitle", "time": 5051.75, "timestamp": "01:24:11", "text": "えっと、ここにベース64"}, {"type": "subtitle", "time": 5054.55, "timestamp": "01:24:14", "text": "とコードはありますか？ それをコピー＆"}, {"type": "subtitle", "time": 5064.149, "timestamp": "01:24:24", "text": "私は、あらゆる可能性に対応できる解決策を持ちたい"}, {"type": "subtitle", "time": 5067.783, "timestamp": "01:24:27", "text": "。"}, {"type": "subtitle", "time": 5079.573, "timestamp": "01:24:39", "text": "再読み込みすると、"}, {"type": "subtitle", "time": 5082.47, "timestamp": "01:24:42", "text": "[歌いながら]イベントが作成されたと教えてくれるでしょう。"}, {"type": "subtitle", "time": 5085.59, "timestamp": "01:24:45", "text": "現在、稼働中です。"}, {"type": "subtitle", "time": 5090.709, "timestamp": "01:24:50", "text": "えーと、ビデオのイベントIDはこれです。"}, {"type": "subtitle", "time": 5096.149, "timestamp": "01:24:56", "text": "終了時刻以外何も変更されていません。"}, {"type": "subtitle", "time": 5099.669, "timestamp": "01:24:59", "text": "ああ、わかりました。 わかった。 しかし、"}]
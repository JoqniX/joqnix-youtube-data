[{"type": "subtitle", "time": 2041.509, "timestamp": "00:34:01", "text": "スケジュール開始時間が"}, {"type": "subtitle", "time": 2044.47, "timestamp": "00:34:04", "text": "変更された場合、"}, {"type": "subtitle", "time": 2048.31, "timestamp": "00:34:08", "text": "今後のストリームのために更新される。いいえ、"}, {"type": "subtitle", "time": 2051.589, "timestamp": "00:34:11", "text": "1つ目は自動パッチです。"}, {"type": "subtitle", "time": 2062.79, "timestamp": "00:34:22", "text": "6時間を過ぎた場合、そうですよね？"}, {"type": "subtitle", "time": 2065.669, "timestamp": "00:34:25", "text": "はい。パッチが継続されます。つまり、いつでも常に"}, {"type": "subtitle", "time": 2069.75, "timestamp": "00:34:29", "text": "6時間進んでいます。例えば、"}, {"type": "subtitle", "time": 2073.99, "timestamp": "00:34:33", "text": "ストリーミング配信をしているとします。  5時間です。"}, {"type": "subtitle", "time": 2076.629, "timestamp": "00:34:36", "text": "ボタンが実行されると、"}, {"type": "subtitle", "time": 2079.909, "timestamp": "00:34:39", "text": "現在の時間に基づいて延長され、さらに"}, {"type": "subtitle", "time": 2082.629, "timestamp": "00:34:42", "text": "6時間追加され、"}, {"type": "subtitle", "time": 2091.909, "timestamp": "00:34:51", "text": "はい。つまり、2番目のステップは、"}, {"type": "subtitle", "time": 2093.99, "timestamp": "00:34:53", "text": "説明に書きました。"}, {"type": "subtitle", "time": 2096.629, "timestamp": "00:34:56", "text": "このビデオでも、"}, {"type": "subtitle", "time": 2098.79, "timestamp": "00:34:58", "text": "イベント作成"}]
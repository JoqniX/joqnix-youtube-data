[{"type": "subtitle", "time": 541.35, "timestamp": "00:09:01", "text": "ないから自分は不十分だと感じるって言ったんだ"}, {"type": "subtitle", "time": 543.509, "timestamp": "00:09:03", "text": "。"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "まあ、いいんだけどね。僕"}, {"type": "subtitle", "time": 549.35, "timestamp": "00:09:09", "text": "にも同じことが言えるし。"}, {"type": "subtitle", "time": 557.59, "timestamp": "00:09:17", "text": "学位が取れる日が来たら、たぶん30歳になると思う。"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "学位って、そう、"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "日本で2年間語学を"}, {"type": "subtitle", "time": 572.47, "timestamp": "00:09:32", "text": "勉強しなきゃいけないから、もう一度学位を取らなきゃいけないんだ。 日本で、"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "言語を完全に習得したら、"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "大学に出願しないといけないんだけど、その頃にはたぶん"}, {"type": "subtitle", "time": 581.636, "timestamp": "00:09:41", "text": "30代になってるよね。"}, {"type": "subtitle", "time": 582.71, "timestamp": "00:09:42", "text": "[笑い]"}, {"type": "subtitle", "time": 585.35, "timestamp": "00:09:45", "text": "私もそれを知ってショックを受けたよ。ああ、そうだね"}, {"type": "subtitle", "time": 590.79, "timestamp": "00:09:50", "text": "。もしくは、運が良ければ、"}, {"type": "subtitle", "time": 595.99, "timestamp": "00:09:55", "text": "今の学位を変えて、[鼻を鳴らす] うーん、"}]
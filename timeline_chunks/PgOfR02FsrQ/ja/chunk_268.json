[{"type": "subtitle", "time": 16081.08, "timestamp": "04:28:01", "text": "、順調です。"}, {"type": "subtitle", "time": 16082.149, "timestamp": "04:28:02", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 16102.309, "timestamp": "04:28:22", "text": "まだ眠くありません。寝ます。"}, {"type": "subtitle", "time": 16104.79, "timestamp": "04:28:24", "text": "はい、寝ます。完了しました。完了しました。ついに完了しました。ついに完了しました。"}, {"type": "subtitle", "time": 16116.149, "timestamp": "04:28:36", "text": "寝ます。寝ます"}, {"type": "subtitle", "time": 16124.389, "timestamp": "04:28:44", "text": "ただ このコマンドをここに置く"}, {"type": "subtitle", "time": 16131.51, "timestamp": "04:28:51", "text": "ええと、"}]
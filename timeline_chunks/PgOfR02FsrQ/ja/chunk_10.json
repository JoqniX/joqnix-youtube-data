[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "それは本当に稀だけど、"}, {"type": "subtitle", "time": 604.23, "timestamp": "00:10:04", "text": "今の学位を変えたり、"}, {"type": "subtitle", "time": 612.421, "timestamp": "00:10:12", "text": "時間が経てば分かるよ。"}, {"type": "subtitle", "time": 614.069, "timestamp": "00:10:14", "text": "今はまだ分からないけど。[鼻を鳴らす]"}, {"type": "subtitle", "time": 621.99, "timestamp": "00:10:21", "text": "学生生活から抜け出せると思っていたんだ"}, {"type": "subtitle", "time": 624.23, "timestamp": "00:10:24", "text": "けど、どうやら"}, {"type": "subtitle", "time": 626.832, "timestamp": "00:10:26", "text": "永遠に続くみたいだね。[笑い]"}, {"type": "subtitle", "time": 627.75, "timestamp": "00:10:27", "text": "[息を呑む]"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "もし私が"}, {"type": "subtitle", "time": 634.15, "timestamp": "00:10:34", "text": "人生で怠けずに、ちゃんと勉強して、"}, {"type": "subtitle", "time": 638.389, "timestamp": "00:10:38", "text": "すべてを終わらせていたら、抜け出せたかもしれない。でも今は、やるべきことがたくさんあるって"}, {"type": "subtitle", "time": 642.31, "timestamp": "00:10:42", "text": "気づいた"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "どこまで話したっけ？えーと、"}, {"type": "subtitle", "time": 659.59, "timestamp": "00:10:59", "text": "ストリーム配信もしてたんだけど、"}]
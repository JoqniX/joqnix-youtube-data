[{"type": "subtitle", "time": 1982.697, "timestamp": "00:33:02", "text": "[笑い]"}, {"type": "subtitle", "time": 1994.23, "timestamp": "00:33:14", "text": "今のところ、"}, {"type": "subtitle", "time": 1997.75, "timestamp": "00:33:17", "text": "作成作業はうまくいって、パッチに関しては良い感じ"}, {"type": "subtitle", "time": 2001.19, "timestamp": "00:33:21", "text": "。タイトル変更があった場合、例えば"}, {"type": "subtitle", "time": 2003.83, "timestamp": "00:33:23", "text": "YouTubeでタイトルを変更した場合、"}, {"type": "subtitle", "time": 2007.43, "timestamp": "00:33:27", "text": "それを直接変更する必要がある。YouTube"}, {"type": "subtitle", "time": 2010.63, "timestamp": "00:33:30", "text": "側で変更があった場合、"}, {"type": "subtitle", "time": 2013.83, "timestamp": "00:33:33", "text": "ファイルを読み込んで"}, {"type": "subtitle", "time": 2016.71, "timestamp": "00:33:36", "text": "古いタイトルと新しいタイトルを二重に比較する。"}, {"type": "subtitle", "time": 2020.789, "timestamp": "00:33:40", "text": "変更を認識する。同じではない。Discord"}, {"type": "subtitle", "time": 2026.549, "timestamp": "00:33:46", "text": "イベントでタイトルを自動的に更新する。"}]
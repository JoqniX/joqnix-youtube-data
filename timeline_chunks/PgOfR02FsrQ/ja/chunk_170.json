[{"type": "subtitle", "time": 10203.429, "timestamp": "02:50:03", "text": "ソーシャルメディアだけでは難しく、"}, {"type": "subtitle", "time": 10206.23, "timestamp": "02:50:06", "text": "サイバーセル関連の作業をしなければならないからです"}, {"type": "chat", "time": 10208.752, "timestamp": "02:50:08", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Priests are dangerous."}, {"type": "subtitle", "time": 10209.83, "timestamp": "02:50:09", "text": "。 そのプロセスには何日もかかるんだよ"}, {"type": "subtitle", "time": 10211.429, "timestamp": "02:50:11", "text": "。"}, {"type": "subtitle", "time": 10221.83, "timestamp": "02:50:21", "text": "長いことのようなもので、"}, {"type": "subtitle", "time": 10225.269, "timestamp": "02:50:25", "text": "もし私が"}, {"type": "subtitle", "time": 10227.429, "timestamp": "02:50:27", "text": "この"}, {"type": "subtitle", "time": 10230.389, "timestamp": "02:50:30", "text": "独立系ユーチューバーや企業に関わっているすべての人を訴えたいと思ったら、それは私が"}, {"type": "subtitle", "time": 10236.469, "timestamp": "02:50:36", "text": "才能やその他諸々の理由で会社を訴えることになるということなので"}, {"type": "subtitle", "time": 10240.469, "timestamp": "02:50:40", "text": "、それはもっと"}, {"type": "subtitle", "time": 10246.63, "timestamp": "02:50:46", "text": "大変になるでしょう。 いや、もっとずっと先まで行くよ"}, {"type": "subtitle", "time": 10249.91, "timestamp": "02:50:49", "text": "。   だから"}, {"type": "subtitle", "time": 10254.63, "timestamp": "02:50:54", "text": "私は、「これはちょっとやりすぎだ」と思ったんです"}, {"type": "subtitle", "time": 10258.063, "timestamp": "02:50:58", "text": "。 でも、ほら、もし私が企業に入社したら、"}]
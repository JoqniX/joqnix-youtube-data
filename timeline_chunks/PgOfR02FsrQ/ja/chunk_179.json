[{"type": "subtitle", "time": 10740.309, "timestamp": "02:59:00", "text": "見てた人はみんな私を知ってた。"}, {"type": "subtitle", "time": 10742.79, "timestamp": "02:59:02", "text": "長年親しくしてた"}, {"type": "subtitle", "time": 10745.75, "timestamp": "02:59:05", "text": "人たちでさえ、みんな「"}, {"type": "subtitle", "time": 10748.009, "timestamp": "02:59:08", "text": "ああ、彼のこと知らない」って感じだった。"}, {"type": "subtitle", "time": 10748.63, "timestamp": "02:59:08", "text": "[笑い]"}, {"type": "subtitle", "time": 10751.269, "timestamp": "02:59:11", "text": "でもこの文書は本当に真実で、"}, {"type": "subtitle", "time": 10755.03, "timestamp": "02:59:15", "text": "少なくとも彼は私の"}, {"type": "subtitle", "time": 10761.349, "timestamp": "02:59:21", "text": "みんなの反応が、まるで"}, {"type": "subtitle", "time": 10763.269, "timestamp": "02:59:23", "text": "私が犯罪者か"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "何かみたいだった。"}, {"type": "subtitle", "time": 10768.87, "timestamp": "02:59:28", "text": "それから、それから私のもの。いや、現実世界で"}, {"type": "subtitle", "time": 10771.19, "timestamp": "02:59:31", "text": "私が被害者になった時に何が起こったか"}, {"type": "subtitle", "time": 10774.309, "timestamp": "02:59:34", "text": "、"}, {"type": "subtitle", "time": 10775.83, "timestamp": "02:59:35", "text": "そうでしょ？"}, {"type": "subtitle", "time": 10778.389, "timestamp": "02:59:38", "text": "それはオンラインと比較される。オンラインは、"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "二人の間で交わされた、両者が関わっていた、深刻なことと見なされるようなものではない。そう、現実世界で私が直面していることと"}, {"type": "subtitle", "time": 10792.55, "timestamp": "02:59:52", "text": "比べれば、それは何でもない。だから、"}]
[{"type": "subtitle", "time": 11883.03, "timestamp": "03:18:03", "text": "すごいことです。"}, {"type": "subtitle", "time": 11885.269, "timestamp": "03:18:05", "text": "私の場合は、"}, {"type": "subtitle", "time": 11887.269, "timestamp": "03:18:07", "text": "それを明らかにしたいのですが、"}, {"type": "subtitle", "time": 11899.03, "timestamp": "03:18:19", "text": "もし"}, {"type": "subtitle", "time": 11902.79, "timestamp": "03:18:22", "text": "その言語で話せと言われたら、"}, {"type": "subtitle", "time": 11905.91, "timestamp": "03:18:25", "text": "どう言うのかグーグルで検索するでしょう。"}, {"type": "subtitle", "time": 11908.71, "timestamp": "03:18:28", "text": "なぜなら、私が"}, {"type": "subtitle", "time": 11920.71, "timestamp": "03:18:40", "text": "日本語を勉強している人たちにアンケートを取るために研究者が来たとき、そうだったからです。自分の夢など、"}, {"type": "subtitle", "time": 11924.87, "timestamp": "03:18:44", "text": "自分自身について答える質問がありました"}, {"type": "subtitle", "time": 11929.75, "timestamp": "03:18:49", "text": "。それから、"}, {"type": "subtitle", "time": 11934.883, "timestamp": "03:18:54", "text": "太陽と風の話がありました。"}, {"type": "subtitle", "time": 11935.75, "timestamp": "03:18:55", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 11938.87, "timestamp": "03:18:58", "text": "太陽と風。話さなければならない、"}]
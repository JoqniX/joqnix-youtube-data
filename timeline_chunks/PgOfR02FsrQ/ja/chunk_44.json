[{"type": "subtitle", "time": 2641.589, "timestamp": "00:44:01", "text": "脱水症状になった場合、どうしますか？"}, {"type": "subtitle", "time": 2643.589, "timestamp": "00:44:03", "text": "もちろん、今は水を飲むでしょうが、水を"}, {"type": "subtitle", "time": 2646.15, "timestamp": "00:44:06", "text": "飲み続けても、"}, {"type": "subtitle", "time": 2650.55, "timestamp": "00:44:10", "text": "喉が"}, {"type": "subtitle", "time": 2657.67, "timestamp": "00:44:17", "text": "少し変な感じで乾いていて、まだ"}, {"type": "subtitle", "time": 2661.349, "timestamp": "00:44:21", "text": "正常ではなく、以前のようにはならないような気がします"}, {"type": "subtitle", "time": 2669.91, "timestamp": "00:44:29", "text": "水を飲んで、"}, {"type": "subtitle", "time": 2679.349, "timestamp": "00:44:39", "text": "それが、私が"}, {"type": "subtitle", "time": 2681.19, "timestamp": "00:44:41", "text": "夜眠れなかった理由でもあります。「よし、"}, {"type": "subtitle", "time": 2694.71, "timestamp": "00:44:54", "text": "病気に発展するのは嫌なんです。私の場合、ほとんどの場合そうなるからです。   私はもっ​​と具合が悪くなるでしょう"}]
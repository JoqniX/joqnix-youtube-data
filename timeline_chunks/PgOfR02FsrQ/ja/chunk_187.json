[{"type": "subtitle", "time": 11226.63, "timestamp": "03:07:06", "text": "Talkっていうアプリで韓国人の友達、知り合い、もしくは友達と知り合えたんです。"}, {"type": "subtitle", "time": 11230.389, "timestamp": "03:07:10", "text": "話したりして。彼はLeague of"}, {"type": "subtitle", "time": 11233.03, "timestamp": "03:07:13", "text": "Legendsのプレイヤーだったんです。「私も"}, {"type": "subtitle", "time": 11236.87, "timestamp": "03:07:16", "text": "プレイしたい」って言って、"}, {"type": "subtitle", "time": 11239.83, "timestamp": "03:07:19", "text": "一緒にプレイしたくなったんです。それで、彼は"}, {"type": "subtitle", "time": 11243.03, "timestamp": "03:07:23", "text": "韓国のゲームアカウントを作ってくれたんです。IDとかが必要だったから"}, {"type": "subtitle", "time": 11244.63, "timestamp": "03:07:24", "text": "。それでも"}, {"type": "subtitle", "time": 11247.67, "timestamp": "03:07:27", "text": "感謝してた。 彼にそのことで。ああ、なんてこと。"}, {"type": "subtitle", "time": 11254.71, "timestamp": "03:07:34", "text": "うん。彼はどうしてるかな。ずいぶん"}, {"type": "subtitle", "time": 11258.309, "timestamp": "03:07:38", "text": "長い間会ってないから。Hello Talkにログインして"}, {"type": "subtitle", "time": 11260.469, "timestamp": "03:07:40", "text": "人と話したり、日本語の練習をしたりしてるんだ"}, {"type": "subtitle", "time": 11263.03, "timestamp": "03:07:43", "text": "。"}, {"type": "subtitle", "time": 11265.75, "timestamp": "03:07:45", "text": "もちろん。D。実は、"}, {"type": "subtitle", "time": 11269.394, "timestamp": "03:07:49", "text": "犬の名前でHello Talkのアカウントを作ろうと思ってたんだ。"}, {"type": "subtitle", "time": 11270.469, "timestamp": "03:07:50", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 11274.309, "timestamp": "03:07:54", "text": "そうすれば、自分のビデオの自分として、えーと、"}, {"type": "subtitle", "time": 11277.03, "timestamp": "03:07:57", "text": "話したり、人と会ったり、"}]
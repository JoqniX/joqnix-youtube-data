[{"type": "subtitle", "time": 485.35, "timestamp": "00:08:05", "text": "。最近、"}, {"type": "subtitle", "time": 493.67, "timestamp": "00:08:13", "text": "雰囲気がすごく好きで、"}, {"type": "subtitle", "time": 497.27, "timestamp": "00:08:17", "text": "RPG要素のあるソウルライクゲームみたいな感じ"}, {"type": "subtitle", "time": 499.909, "timestamp": "00:08:19", "text": "。"}, {"type": "subtitle", "time": 503.189, "timestamp": "00:08:23", "text": "僕はシングルプレイヤー派なんだ"}, {"type": "subtitle", "time": 507.27, "timestamp": "00:08:27", "text": "けど、協力プレイもあるし、基本的にはシングル"}, {"type": "subtitle", "time": 510.23, "timestamp": "00:08:30", "text": "プレイヤー。世界観があって、"}, {"type": "chat", "time": 511.532, "timestamp": "00:08:31", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I told my psychiatrist that I feel inadequate because I still don’t have a college degree."}, {"type": "subtitle", "time": 513.35, "timestamp": "00:08:33", "text": "やることもたくさんある。僕好みのゲームだと思う。"}, {"type": "subtitle", "time": 516.149, "timestamp": "00:08:36", "text": "[鼻を鳴らす] レベル上げが好きだし、"}, {"type": "subtitle", "time": 526.55, "timestamp": "00:08:46", "text": "クラフトも好きだし、何にでも没頭するのが好きなんだ"}, {"type": "subtitle", "time": 538.55, "timestamp": "00:08:58", "text": "精神科医に、大学の学位が"}]
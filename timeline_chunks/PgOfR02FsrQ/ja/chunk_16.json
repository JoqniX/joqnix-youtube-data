[{"type": "subtitle", "time": 960.23, "timestamp": "00:16:00", "text": "Sammyのことで一生懸命働いてるご褒美に。今の"}, {"type": "subtitle", "time": 963.829, "timestamp": "00:16:03", "text": "ペースはすごく"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "遅いんだ。遅すぎる。Chad"}, {"type": "subtitle", "time": 970.87, "timestamp": "00:16:10", "text": "GPTを使ってるからかな？それとも"}, {"type": "subtitle", "time": 975.269, "timestamp": "00:16:15", "text": "コンプレックスが大きすぎるからかな？"}, {"type": "subtitle", "time": 978.571, "timestamp": "00:16:18", "text": "頭の中には成功したいというアイデアがあって、まるで"}, {"type": "subtitle", "time": 981.11, "timestamp": "00:16:21", "text": "コーディングみたいで、"}, {"type": "subtitle", "time": 983.59, "timestamp": "00:16:23", "text": "試行錯誤の連続で、当然ミスもある。"}, {"type": "subtitle", "time": 985.67, "timestamp": "00:16:25", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 990.389, "timestamp": "00:16:30", "text": "間違いも出てくるし、時間の半分は問題を見つけて"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "解決する方法を探すのに費やすんだ。"}, {"type": "subtitle", "time": 998.87, "timestamp": "00:16:38", "text": "うん、最近はそういうことばかり"}, {"type": "subtitle", "time": 1006.47, "timestamp": "00:16:46", "text": "かなりクレイジーだよ。"}, {"type": "chat", "time": 1016.702, "timestamp": "00:16:56", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "for me its over-complicate things and procrasinating"}]
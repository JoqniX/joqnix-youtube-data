[{"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "私がしたことはすべてアッラーの"}, {"type": "subtitle", "time": 4226.229, "timestamp": "01:10:26", "text": "。   「"}, {"type": "subtitle", "time": 4228.63, "timestamp": "01:10:28", "text": "おはようございます」という答えは何ですか？ こんにちは。"}, {"type": "subtitle", "time": 4230.95, "timestamp": "01:10:30", "text": "こんにちは。 楽しい日曜日を。"}, {"type": "subtitle", "time": 4248.07, "timestamp": "01:10:48", "text": "午前中はいかがでしたか？ ああ、まだ"}, {"type": "subtitle", "time": 4252.95, "timestamp": "01:10:52", "text": "目覚めていない。 こんにちは。 あ、こんにちは。"}, {"type": "subtitle", "time": 4255.91, "timestamp": "01:10:55", "text": "よく眠れたことを願っています。"}, {"type": "subtitle", "time": 4258.39, "timestamp": "01:10:58", "text": "土曜日は良い一日でしたか？ 昨日は配信できませんでした"}]
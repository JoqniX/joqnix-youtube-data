[{"type": "subtitle", "time": 6807.35, "timestamp": "01:53:27", "text": "ええ、地元の人がよく行く小道がありますよ。"}, {"type": "subtitle", "time": 6811.91, "timestamp": "01:53:31", "text": "今日の配信のサムネイルもダウンロードされました。 基本的には同じ"}, {"type": "subtitle", "time": 6815.109, "timestamp": "01:53:35", "text": "サムネイルだけど、まあね。"}, {"type": "subtitle", "time": 6826.55, "timestamp": "01:53:46", "text": "それに、そろそろ父が去る時期ですよね"}]
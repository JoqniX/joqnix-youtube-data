[{"type": "subtitle", "time": 11944.07, "timestamp": "03:19:04", "text": "声に出して読むことについてもう一度話します。"}, {"type": "subtitle", "time": 11947.11, "timestamp": "03:19:07", "text": "モアナでは、それができなかったので、Google"}, {"type": "subtitle", "time": 11950.469, "timestamp": "03:19:10", "text": "翻訳を使って音声を聞き、"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "何とか真似するか、"}, {"type": "subtitle", "time": 11957.67, "timestamp": "03:19:17", "text": "マングリッシュ版を読むしかありませんでした。[鼻を鳴らす]"}, {"type": "subtitle", "time": 11965.349, "timestamp": "03:19:25", "text": "話せるけどいつも失敗します。同じです"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "ああ、なんてことだ。同じです。"}, {"type": "subtitle", "time": 11986.309, "timestamp": "03:19:46", "text": "今でもバスや"}, {"type": "subtitle", "time": 11990.71, "timestamp": "03:19:50", "text": "店の看板などを読むことさえできません。文字が書かれている場合、"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "文字を一つずつリストアップして"}]
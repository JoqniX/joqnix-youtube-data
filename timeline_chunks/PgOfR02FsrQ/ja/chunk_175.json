[{"type": "subtitle", "time": 10501.99, "timestamp": "02:55:01", "text": "しばらくビデオを作っていなかったから。 いろいろ"}, {"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": "話そうと思ってたんだけど"}, {"type": "subtitle", "time": 10507.59, "timestamp": "02:55:07", "text": "、なんで"}, {"type": "subtitle", "time": 10511.75, "timestamp": "02:55:11", "text": "自分のドラマのこととか、"}, {"type": "subtitle", "time": 10514.23, "timestamp": "02:55:14", "text": "VTing スピアがどれだけ"}, {"type": "subtitle", "time": 10518.15, "timestamp": "02:55:18", "text": "有害かとか、あれこれとか、自分の"}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "経験とかを話してるんだろうって思った。それが"}, {"type": "subtitle", "time": 10524.15, "timestamp": "02:55:24", "text": "私が作りたいコンテンツなのか"}, {"type": "subtitle", "time": 10526.79, "timestamp": "02:55:26", "text": "疑問に思った。それで、"}, {"type": "subtitle", "time": 10529.51, "timestamp": "02:55:29", "text": "「よし、"}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "何かをしたいと思って、自分で"}, {"type": "subtitle", "time": 10532.87, "timestamp": "02:55:32", "text": "制限してアイデアを捨てるっていう方向で進んでるんだ"}, {"type": "subtitle", "time": 10536.15, "timestamp": "02:55:36", "text": "」って思った。それから、"}, {"type": "subtitle", "time": 10538.469, "timestamp": "02:55:38", "text": "「よし、やりたいならやればいい」って思った"}, {"type": "subtitle", "time": 10541.59, "timestamp": "02:55:41", "text": "。  「やりたくないなら、やらなくていいよ。」"}, {"type": "subtitle", "time": 10543.91, "timestamp": "02:55:43", "text": "私は困惑していて、"}, {"type": "subtitle", "time": 10546.309, "timestamp": "02:55:46", "text": "混乱していて、"}, {"type": "subtitle", "time": 10550.23, "timestamp": "02:55:50", "text": "Twitterのことについて話そうかと思っていました。[鼻で笑う]"}, {"type": "subtitle", "time": 10553.03, "timestamp": "02:55:53", "text": "なぜなら、私はTwitterをほとんど使わないからです。Twitterを"}, {"type": "subtitle", "time": 10555.349, "timestamp": "02:55:55", "text": "開くたびに、また別のVtuberの騒動、"}, {"type": "subtitle", "time": 10557.67, "timestamp": "02:55:57", "text": "あれこれと。[鼻で笑う] まあ、"}]
[{"type": "subtitle", "time": 9482.309, "timestamp": "02:38:02", "text": "そして私の階段のすべてで、弁護士が私に何と言ったか知っていますか？ 彼は"}, {"type": "subtitle", "time": 9488.07, "timestamp": "02:38:08", "text": "2日目にこう言った。「ああ、"}, {"type": "subtitle", "time": 9491.03, "timestamp": "02:38:11", "text": "1日目に彼は私に"}, {"type": "subtitle", "time": 9493.669, "timestamp": "02:38:13", "text": "返事をくれた。それで私は少し"}, {"type": "subtitle", "time": 9494.469, "timestamp": "02:38:14", "text": "[音楽]"}, {"type": "subtitle", "time": 9498.55, "timestamp": "02:38:18", "text": "もっとオーカッシュになった。そして2日目に"}, {"type": "subtitle", "time": 9501.27, "timestamp": "02:38:21", "text": "彼に会いに行ったとき、彼はこう言った。「オーカ、"}, {"type": "subtitle", "time": 9503.99, "timestamp": "02:38:23", "text": "1日目[音楽]1日目に君が来て、"}, {"type": "subtitle", "time": 9506.79, "timestamp": "02:38:26", "text": "最初の夜に"}, {"type": "subtitle", "time": 9508.63, "timestamp": "02:38:28", "text": "状況について話してくれたとき、"}, {"type": "subtitle", "time": 9511.11, "timestamp": "02:38:31", "text": "君に起こっているすべてのことは、まるで"}, {"type": "subtitle", "time": 9514.15, "timestamp": "02:38:34", "text": "犯罪者が"}, {"type": "subtitle", "time": 9523.27, "timestamp": "02:38:43", "text": "でも今はもっと明るくて"}, {"type": "subtitle", "time": 9526.07, "timestamp": "02:38:46", "text": "自由だよ、だって今は自分が犯罪者じゃないってわかってるから。"}, {"type": "subtitle", "time": 9529.91, "timestamp": "02:38:49", "text": "[音楽] だって"}, {"type": "subtitle", "time": 9533.67, "timestamp": "02:38:53", "text": "私は、"}, {"type": "subtitle", "time": 9536.07, "timestamp": "02:38:56", "text": "今まで起こったこと全部のせいで自分が"}]
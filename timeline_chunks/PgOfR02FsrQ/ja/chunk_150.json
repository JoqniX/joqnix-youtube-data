[{"type": "subtitle", "time": 9008.71, "timestamp": "02:30:08", "text": "YouTubeのハッシュ。 私はYouTubeの"}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "ハッシュ値を持っていません。 どうやってそこにたどり着くのか、ああ、なんてことだ"}, {"type": "subtitle", "time": 9019.51, "timestamp": "02:30:19", "text": "ハッシュ。 待って、サミーはハシシ系のもの持ってる"}, {"type": "subtitle", "time": 9027.99, "timestamp": "02:30:27", "text": "ドキュメントを確認してみます。"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "16進数値は16進文字列のハッシュ値ですか？"}, {"type": "subtitle", "time": 9036.07, "timestamp": "02:30:36", "text": "ああ、文字列ハッシュがあるんですね。 何てことだ。"}, {"type": "subtitle", "time": 9038.15, "timestamp": "02:30:38", "text": "ハッシュ化は、さまざまな種類の入力の"}, {"type": "subtitle", "time": 9040.309, "timestamp": "02:30:40", "text": "真正性と完全性を検証するために使用できる暗号化プロセスです"}, {"type": "subtitle", "time": 9044.63, "timestamp": "02:30:44", "text": "。"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "ドーナツストリングを「わあ、そんなものがあるなんて知らなかった」に変更できます"}]
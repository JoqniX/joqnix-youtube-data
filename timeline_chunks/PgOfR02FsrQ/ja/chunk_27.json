[{"type": "subtitle", "time": 1621.19, "timestamp": "00:27:01", "text": "眠らなかったけど、お風呂に入った。さっぱりした。"}, {"type": "subtitle", "time": 1623.35, "timestamp": "00:27:03", "text": "さっぱりした。それで、"}, {"type": "subtitle", "time": 1625.51, "timestamp": "00:27:05", "text": "「よし、"}, {"type": "subtitle", "time": 1628.31, "timestamp": "00:27:08", "text": "眠らないぞ」って思った。  「たぶんスマホをいじったり、"}, {"type": "subtitle", "time": 1631.11, "timestamp": "00:27:11", "text": "長めの動画を見たりして、そのまま"}, {"type": "subtitle", "time": 1633.35, "timestamp": "00:27:13", "text": "寝ると思う。」"}, {"type": "subtitle", "time": 1635.029, "timestamp": "00:27:15", "text": "それで私は「ちょっと待って」と思った。"}, {"type": "subtitle", "time": 1654.87, "timestamp": "00:27:34", "text": "7になるよ。 だから、"}, {"type": "subtitle", "time": 1657.51, "timestamp": "00:27:37", "text": "この配信はいつまで続くか分からないけど、おそらくずっと続けるつもりです"}, {"type": "subtitle", "time": 1661.029, "timestamp": "00:27:41", "text": "。 今日は授業があります。 今日は"}, {"type": "subtitle", "time": 1664.31, "timestamp": "00:27:44", "text": "日曜日なのは分かっているのですが、先生が"}, {"type": "subtitle", "time": 1666.71, "timestamp": "00:27:46", "text": "数日間病気で休んでいたんです。"}, {"type": "subtitle", "time": 1672.789, "timestamp": "00:27:52", "text": "今日は授業があります。"}, {"type": "subtitle", "time": 1675.43, "timestamp": "00:27:55", "text": "だから"}, {"type": "subtitle", "time": 1678.47, "timestamp": "00:27:58", "text": "夕方、"}]
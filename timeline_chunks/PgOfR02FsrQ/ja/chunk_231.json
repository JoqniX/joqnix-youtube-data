[{"type": "subtitle", "time": 13862.55, "timestamp": "03:51:02", "text": "あなたが勝っている場合だと思います。はい、"}, {"type": "subtitle", "time": 13865.189, "timestamp": "03:51:05", "text": "イベント関連のことはほぼ終わりました。"}, {"type": "subtitle", "time": 13868.79, "timestamp": "03:51:08", "text": "アナウンス関連のことは後でやります。"}, {"type": "subtitle", "time": 13872.71, "timestamp": "03:51:12", "text": "ええと、条件付きの新しい機能もいくつか追加しました"}, {"type": "subtitle", "time": 13875.51, "timestamp": "03:51:15", "text": "。イベント"}, {"type": "subtitle", "time": 13877.189, "timestamp": "03:51:17", "text": "にサムネイルがない場合、サムネイルを更新します"}, {"type": "subtitle", "time": 13880.95, "timestamp": "03:51:20", "text": "。だから"}, {"type": "subtitle", "time": 13884.07, "timestamp": "03:51:24", "text": "今日は"}, {"type": "subtitle", "time": 13886.79, "timestamp": "03:51:26", "text": "これを終わらせるのに少し遅れました。1"}, {"type": "subtitle", "time": 13890.229, "timestamp": "03:51:30", "text": "時間前、2時間前には終わっているはずでした。"}, {"type": "subtitle", "time": 13893.67, "timestamp": "03:51:33", "text": "簡単な修正のはずでしたが、"}]
[{"type": "subtitle", "time": 11820.79, "timestamp": "03:17:00", "text": "ない。正直、YouTuberとして、"}, {"type": "subtitle", "time": 11830.79, "timestamp": "03:17:10", "text": "最初は自分がインドのどの地域出身なのかを明かしたくなかったんだ"}, {"type": "subtitle", "time": 11833.269, "timestamp": "03:17:13", "text": "けど、BBCの記事とかが"}, {"type": "subtitle", "time": 11837.75, "timestamp": "03:17:17", "text": "出てから、自分が"}, {"type": "subtitle", "time": 11841.03, "timestamp": "03:17:21", "text": "インドのどの地域出身なのかがバレてしまった。私は具体的に言ってないけど、"}, {"type": "subtitle", "time": 11847.59, "timestamp": "03:17:27", "text": "変更するように頼んだし、下書きもあった"}, {"type": "subtitle", "time": 11849.91, "timestamp": "03:17:29", "text": "けど、まあ、そういうこともあるし、"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "私自身も"}, {"type": "subtitle", "time": 11856.79, "timestamp": "03:17:36", "text": "時間をかけてそうしました。"}, {"type": "subtitle", "time": 11859.59, "timestamp": "03:17:39", "text": "デビューしていたら、自分の"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "言語は"}, {"type": "subtitle", "time": 11865.91, "timestamp": "03:17:45", "text": "知らない言語だと話していたので、"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "それはそれでいいのですが、"}, {"type": "subtitle", "time": 11872.389, "timestamp": "03:17:52", "text": "他のYouTuberが"}, {"type": "subtitle", "time": 11874.389, "timestamp": "03:17:54", "text": "自分の出身地や"}, {"type": "subtitle", "time": 11876.87, "timestamp": "03:17:56", "text": "インドのどの地域出身かなどをオープンにしているのを見ました"}, {"type": "subtitle", "time": 11878.469, "timestamp": "03:17:58", "text": "。それは"}]
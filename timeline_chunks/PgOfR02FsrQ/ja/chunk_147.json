[{"type": "subtitle", "time": 8821.349, "timestamp": "02:27:01", "text": "私はその逆をします。 等しくない。 私は"}, {"type": "subtitle", "time": 8833.19, "timestamp": "02:27:13", "text": "うん。 これでうまくいくはずです。 そうしなければならない。 そうに違いない"}, {"type": "subtitle", "time": 8859.67, "timestamp": "02:27:39", "text": "。"}, {"type": "subtitle", "time": 8863.99, "timestamp": "02:27:43", "text": "削除を終わらせて、それからたぶん、"}, {"type": "subtitle", "time": 8865.91, "timestamp": "02:27:45", "text": "よし、2"}, {"type": "subtitle", "time": 8868.469, "timestamp": "02:27:48", "text": "時間ストリーミングした。 後で配信のお知らせのために別の配信をした方がいいでしょうか"}, {"type": "subtitle", "time": 8872.23, "timestamp": "02:27:52", "text": "？"}, {"type": "subtitle", "time": 8876.652, "timestamp": "02:27:56", "text": "ちょっと朝食を食べに行きたい。"}, {"type": "subtitle", "time": 8877.91, "timestamp": "02:27:57", "text": "[鼻を鳴らす]"}]
[{"type": "subtitle", "time": 1807.51, "timestamp": "00:30:07", "text": "トークシーンでは、トークシーンで"}, {"type": "subtitle", "time": 1811.11, "timestamp": "00:30:11", "text": "気軽にチャットしたり、"}, {"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "話題について話したりします。バックグラウンド"}, {"type": "subtitle", "time": 1816.325, "timestamp": "00:30:16", "text": "でゲームをしているとは誰も知りません。"}, {"type": "subtitle", "time": 1828.87, "timestamp": "00:30:28", "text": "もちろんです。"}, {"type": "subtitle", "time": 1835.51, "timestamp": "00:30:35", "text": "日本語の授業やその他のオンライン授業を受けている間、バックグラウンドでゲームをすればいいんじゃないかと思ったんだけど、"}, {"type": "subtitle", "time": 1838.87, "timestamp": "00:30:38", "text": "そうでしょ？ でも私はそうしません。"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "特に日本語の授業では、"}, {"type": "subtitle", "time": 1843.35, "timestamp": "00:30:43", "text": "できる限り集中して授業を受けるようにしているからです。 私は"}, {"type": "subtitle", "time": 1851.029, "timestamp": "00:30:51", "text": "そして、気が散った瞬間に、"}, {"type": "subtitle", "time": 1855.11, "timestamp": "00:30:55", "text": "すべてを失ったような気がします。 まるで私が"}, {"type": "subtitle", "time": 1857.669, "timestamp": "00:30:57", "text": "すべてを忘れてしまうかのように。 私はあらゆることに関して、世間から完全に隔絶されている"}]
[{"type": "subtitle", "time": 1263.029, "timestamp": "00:21:03", "text": "道徳観とか、そういうのが問題で、もう"}, {"type": "subtitle", "time": 1265.59, "timestamp": "00:21:05", "text": "次の"}, {"type": "subtitle", "time": 1269.51, "timestamp": "00:21:09", "text": "モデルは用意してあるのに、お金がないからそれを公開できない、って感じだったんです。"}, {"type": "subtitle", "time": 1274.549, "timestamp": "00:21:14", "text": "[音楽]"}, {"type": "subtitle", "time": 1278.39, "timestamp": "00:21:18", "text": "ええと、それで配信して、愛を表現できるのに。もちろん"}, {"type": "subtitle", "time": 1280.789, "timestamp": "00:21:20", "text": "、"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "無料で使えるものを使うこともできるんですけど、自分の"}, {"type": "subtitle", "time": 1286.23, "timestamp": "00:21:26", "text": "ブランドイメージとか、"}, {"type": "subtitle", "time": 1289.11, "timestamp": "00:21:29", "text": "キャラクターの外見とか、そういうものにこだわりたいんです。それから、"}, {"type": "subtitle", "time": 1299.43, "timestamp": "00:21:39", "text": "ゲームとかやってるとき、キャラクターを変えたりもするじゃないですか。自分らしくなろうと努力するんです"}, {"type": "subtitle", "time": 1302.07, "timestamp": "00:21:42", "text": "。それができるなら、"}, {"type": "subtitle", "time": 1304.31, "timestamp": "00:21:44", "text": "無料で使えるモデルで配信したり、ミミみたいに"}, {"type": "subtitle", "time": 1307.51, "timestamp": "00:21:47", "text": "カスタマイズできるモデルで配信したりすればいいんじゃないですか"}, {"type": "subtitle", "time": 1311.51, "timestamp": "00:21:51", "text": "？[鼻で笑う]"}, {"type": "subtitle", "time": 1313.99, "timestamp": "00:21:53", "text": "ええ、それも"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "私がそうしたい理由の一つです。分からないけど、他にも色々ありました。 えーっと、"}]
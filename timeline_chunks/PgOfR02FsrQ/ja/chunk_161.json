[{"type": "subtitle", "time": 9671.27, "timestamp": "02:41:11", "text": "時間を見つけてくれるでしょうか。"}, {"type": "subtitle", "time": 9673.91, "timestamp": "02:41:13", "text": "高等裁判所の弁護士ですから忙しいのは分かります。"}, {"type": "subtitle", "time": 9677.03, "timestamp": "02:41:17", "text": "朝から忙しいですし、"}, {"type": "subtitle", "time": 9683.83, "timestamp": "02:41:23", "text": "裁判が終わってから夕方に事務所に来るんです。"}, {"type": "subtitle", "time": 9686.896, "timestamp": "02:41:26", "text": "彼らにはやらなければならない仕事や案件が山ほどある。"}, {"type": "subtitle", "time": 9691.67, "timestamp": "02:41:31", "text": "[鼻を鳴らす] きっとたどり着けるさ。 でも、もし私が"}, {"type": "subtitle", "time": 9700.309, "timestamp": "02:41:40", "text": "考えていたのが「電話をかけ続けて、電話をかけ続けて、"}, {"type": "subtitle", "time": 9706.547, "timestamp": "02:41:46", "text": "彼らをすごくイライラさせなきゃいけない」ということだけだったら、もっと楽だったと思う。"}, {"type": "subtitle", "time": 9708.309, "timestamp": "02:41:48", "text": "[笑い] あまりに人をイライラさせるのも"}, {"type": "subtitle", "time": 9717.51, "timestamp": "02:41:57", "text": "現地で予約を受け付け、"}, {"type": "subtitle", "time": 9719.51, "timestamp": "02:41:59", "text": "調整を行うアシスタント。 うん。 うん。"}]
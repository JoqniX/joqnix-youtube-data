[{"type": "subtitle", "time": 11520.79, "timestamp": "03:12:00", "text": "。私の父はタミル語をよく話します。"}, {"type": "subtitle", "time": 11523.269, "timestamp": "03:12:03", "text": "ああ、彼は"}, {"type": "subtitle", "time": 11525.349, "timestamp": "03:12:05", "text": "友達やクラスメートなどがいるから知っているんですね。ああ、"}, {"type": "subtitle", "time": 11527.51, "timestamp": "03:12:07", "text": "待って。彼は以前、私のマドラスか何かで働いていました"}, {"type": "subtitle", "time": 11531.51, "timestamp": "03:12:11", "text": "。私はチェンナイで育ちました。"}, {"type": "subtitle", "time": 11533.75, "timestamp": "03:12:13", "text": "ああ、私は人生で初めてチェンナイに行きました"}, {"type": "subtitle", "time": 11537.83, "timestamp": "03:12:17", "text": "。素敵でした。道がとても"}, {"type": "subtitle", "time": 11543.03, "timestamp": "03:12:23", "text": "[笑い] まったく"}, {"type": "subtitle", "time": 11559.51, "timestamp": "03:12:39", "text": "ええ、でもクレイジーです"}, {"type": "subtitle", "time": 11563.349, "timestamp": "03:12:43", "text": "。足元も"}, {"type": "subtitle", "time": 11571.51, "timestamp": "03:12:51", "text": "ええ、まったく違います。"}]
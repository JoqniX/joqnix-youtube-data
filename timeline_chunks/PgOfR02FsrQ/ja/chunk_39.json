[{"type": "subtitle", "time": 2342.79, "timestamp": "00:39:02", "text": "よし、このどこからともなく頭に浮かんだ"}, {"type": "subtitle", "time": 2349.91, "timestamp": "00:39:09", "text": "奇妙なアイデアをどうやって実現するかを学ぶために時間を費やそう。"}, {"type": "subtitle", "time": 2354.15, "timestamp": "00:39:14", "text": "そして、それを実現したんだ」と思ったんだ。"}, {"type": "subtitle", "time": 2372.71, "timestamp": "00:39:32", "text": "僕は、"}, {"type": "subtitle", "time": 2375.349, "timestamp": "00:39:35", "text": "Discordのカスタムアクティビティみたいなことをビンゴのようにやってたんだ"}, {"type": "subtitle", "time": 2377.03, "timestamp": "00:39:37", "text": "。ライブ配信中は"}, {"type": "subtitle", "time": 2379.109, "timestamp": "00:39:39", "text": "いつもやってた。ライブ配信中であること、"}, {"type": "subtitle", "time": 2393.19, "timestamp": "00:39:53", "text": "どのプラットフォームで何をしているかなどを表示するアクティビティみたいなものを用意してたんだ。"}]
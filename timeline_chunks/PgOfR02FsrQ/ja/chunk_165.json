[{"type": "subtitle", "time": 9904.63, "timestamp": "02:45:04", "text": "裁判費用ってどれくらいかかるのか気になっていました。"}, {"type": "subtitle", "time": 9911.269, "timestamp": "02:45:11", "text": "名誉毀損とかそういうのって、結構高いんですか？ それは"}, {"type": "subtitle", "time": 9918.87, "timestamp": "02:45:18", "text": "つまり、私の法的通知には、私は"}, {"type": "subtitle", "time": 9922.469, "timestamp": "02:45:22", "text": "人々を訴えることができると書いてあります。 私は"}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": "精神的苦痛と個人情報漏洩について訴訟を起こすことができますよね。"}, {"type": "subtitle", "time": 9931.11, "timestamp": "02:45:31", "text": "彼女はそういうことを公の場で話していた"}, {"type": "subtitle", "time": 9937.269, "timestamp": "02:45:37", "text": "けど、ええ、精神的なダメージは大きかったわ。   そこに"}]
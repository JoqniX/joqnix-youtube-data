[{"type": "subtitle", "time": 4800.47, "timestamp": "01:20:00", "text": "私は一般的に話すのが苦手だと思うんです。"}, {"type": "subtitle", "time": 4803.91, "timestamp": "01:20:03", "text": "話題がないとか、"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "誰も"}, {"type": "subtitle", "time": 4809.11, "timestamp": "01:20:09", "text": "私が話すような話題を話していないとかだと。 でも"}, {"type": "subtitle", "time": 4811.03, "timestamp": "01:20:11", "text": "、ストリーマーとしては、たくさん"}, {"type": "subtitle", "time": 4813.43, "timestamp": "01:20:13", "text": "喋るべきだと思うんです。"}, {"type": "subtitle", "time": 4815.99, "timestamp": "01:20:15", "text": "自分で話題を作って、それ"}, {"type": "subtitle", "time": 4818.95, "timestamp": "01:20:18", "text": "について話し続けるのが私の役目ですよね？"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "だから私は実験をしていたんです。 だから、今でも私は"}, {"type": "subtitle", "time": 4824.87, "timestamp": "01:20:24", "text": "実験を続けなければならないのです。"}, {"type": "subtitle", "time": 4830.63, "timestamp": "01:20:30", "text": "早起きして、"}, {"type": "subtitle", "time": 4833.83, "timestamp": "01:20:33", "text": "朝の配信とかをやってみようかな。   あまり迷惑をかけていないといいのですが"}, {"type": "subtitle", "time": 4836.63, "timestamp": "01:20:36", "text": "。 質"}, {"type": "subtitle", "time": 4842.229, "timestamp": "01:20:42", "text": "より量、いや量より"}, {"type": "subtitle", "time": 4844.95, "timestamp": "01:20:44", "text": "質といったものにならないことを願っています。 それが"}, {"type": "subtitle", "time": 4847.99, "timestamp": "01:20:47", "text": "私の問題点なんです。 私はよく配信をします。 この配信、"}, {"type": "subtitle", "time": 4850.63, "timestamp": "01:20:50", "text": "すごく好き。   ある"}, {"type": "subtitle", "time": 4853.51, "timestamp": "01:20:53", "text": "意味、質より量を重視する傾向にあると言えるでしょう"}, {"type": "subtitle", "time": 4855.75, "timestamp": "01:20:55", "text": "。   君が"}, {"type": "subtitle", "time": 4859.27, "timestamp": "01:20:59", "text": "コーディングするのを見たい。  [笑い]"}]
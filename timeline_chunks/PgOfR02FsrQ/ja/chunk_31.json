[{"type": "subtitle", "time": 1860.95, "timestamp": "00:31:00", "text": "。 最近気づいたんだけど、えーっと、"}, {"type": "subtitle", "time": 1864.549, "timestamp": "00:31:04", "text": "数週間前かな [鼻を鳴らす] 気が散ったりして、"}, {"type": "subtitle", "time": 1871.029, "timestamp": "00:31:11", "text": "「えーっと、待って。忘れちゃった。"}, {"type": "subtitle", "time": 1877.19, "timestamp": "00:31:17", "text": "呼ばれた時、"}, {"type": "subtitle", "time": 1881.43, "timestamp": "00:31:21", "text": "先生は知ってると思うけど、それでも"}, {"type": "subtitle", "time": 1885.19, "timestamp": "00:31:25", "text": "答えられるから、まあいいんだけど、それでも時々"}, {"type": "subtitle", "time": 1890.23, "timestamp": "00:31:30", "text": "混乱するんだ。なんでここ？どこ？"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "どの問題？"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "3問目？って。だから"}, {"type": "subtitle", "time": 1900.549, "timestamp": "00:31:40", "text": "呼ばれた時、「えーっと、"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "3問目を読まなきゃいけないのか、それとも1問目か」ってなるんだ。でも ["}, {"type": "subtitle", "time": 1905.35, "timestamp": "00:31:45", "text": "笑]"}, {"type": "subtitle", "time": 1911.956, "timestamp": "00:31:51", "text": "集中力が足りないってバレる時もあるんだ。"}, {"type": "subtitle", "time": 1919.162, "timestamp": "00:31:59", "text": "だから"}, {"type": "subtitle", "time": 1919.909, "timestamp": "00:31:59", "text": "[鼻を鳴らす]"}]
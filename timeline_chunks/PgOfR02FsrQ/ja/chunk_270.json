[{"type": "subtitle", "time": 16201.11, "timestamp": "04:30:01", "text": "マネージャー。明日か今夜、もしできれば"}, {"type": "subtitle", "time": 16203.83, "timestamp": "04:30:03", "text": "配信のお知らせをしますが、"}, {"type": "subtitle", "time": 16207.269, "timestamp": "04:30:07", "text": "配信外で行います。明日以降、"}, {"type": "subtitle", "time": 16209.269, "timestamp": "04:30:09", "text": "明後日以降は"}, {"type": "subtitle", "time": 16213.51, "timestamp": "04:30:13", "text": "ゲーム配信を行います。よし。"}, {"type": "subtitle", "time": 16216.63, "timestamp": "04:30:16", "text": "こんにちは。ということで、"}, {"type": "subtitle", "time": 16219.349, "timestamp": "04:30:19", "text": "私もそろそろ寝て"}, {"type": "subtitle", "time": 16223.349, "timestamp": "04:30:23", "text": "、"}, {"type": "subtitle", "time": 16225.99, "timestamp": "04:30:25", "text": "朝食などを食べに行くつもりです。なので、もし"}, {"type": "subtitle", "time": 16228.07, "timestamp": "04:30:28", "text": "今夜配信できれば配信します。そうでなければ、また"}, {"type": "subtitle", "time": 16230.422, "timestamp": "04:30:30", "text": "明日お会いしましょう。"}, {"type": "subtitle", "time": 16232.469, "timestamp": "04:30:32", "text": "[音楽] 最後まで見ていただきありがとうございました"}, {"type": "subtitle", "time": 16234.95, "timestamp": "04:30:34", "text": "。そして、こっそり見ていた方々、見てくれて"}, {"type": "subtitle", "time": 16237.75, "timestamp": "04:30:37", "text": "ありがとう。"}, {"type": "subtitle", "time": 16246.151, "timestamp": "04:30:46", "text": "。 [音楽]"}, {"type": "subtitle", "time": 16252.87, "timestamp": "04:30:52", "text": "おやすみなさい。"}]
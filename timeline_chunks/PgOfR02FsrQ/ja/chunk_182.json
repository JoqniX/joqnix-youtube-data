[{"type": "subtitle", "time": 10921.75, "timestamp": "03:02:01", "text": "。うん、それは本当、本当、"}, {"type": "subtitle", "time": 10946.469, "timestamp": "03:02:26", "text": "ああ、もしいくつか作らなきゃいけないとしたら、私は"}, {"type": "subtitle", "time": 10950.07, "timestamp": "03:02:30", "text": "行くかもしれない。"}, {"type": "subtitle", "time": 10953.83, "timestamp": "03:02:33", "text": "つまり、人間関係は怖いんだよ。もううんざりだ"}, {"type": "subtitle", "time": 10957.269, "timestamp": "03:02:37", "text": "。ああ、SLAは"}, {"type": "subtitle", "time": 10959.51, "timestamp": "03:02:39", "text": "壊れてる。もううんざりだ"}, {"type": "subtitle", "time": 10963.03, "timestamp": "03:02:43", "text": "。"}, {"type": "subtitle", "time": 10965.429, "timestamp": "03:02:45", "text": "十分苦しんだ。もう十分"}, {"type": "subtitle", "time": 10978.07, "timestamp": "03:02:58", "text": "十分苦しんだし、"}]
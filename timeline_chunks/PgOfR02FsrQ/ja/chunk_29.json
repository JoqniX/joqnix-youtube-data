[{"type": "subtitle", "time": 1741.669, "timestamp": "00:29:01", "text": "[鼻を鳴らして]話し続けるよ"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "。 それはどちらかというと、私が普段は"}, {"type": "subtitle", "time": 1751.669, "timestamp": "00:29:11", "text": "口数の少ない人間なので、どうすれば話し続けられるかという練習だったんです。 私はあまり話さないし、"}, {"type": "subtitle", "time": 1756.71, "timestamp": "00:29:16", "text": "ゲーム配信をしている時でも、すごく集中して配信している時などは、"}, {"type": "subtitle", "time": 1761.669, "timestamp": "00:29:21", "text": "すごく静かで集中している感じがして、"}, {"type": "subtitle", "time": 1763.99, "timestamp": "00:29:23", "text": "それは良くないことだと感じていました。 私は[音楽]チャット"}, {"type": "subtitle", "time": 1766.23, "timestamp": "00:29:26", "text": "タイプのコンテンツ"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "や、チャットで"}, {"type": "subtitle", "time": 1772.63, "timestamp": "00:29:32", "text": "話題について話している人がいない場合は一般的なチャットさえできないと思いました"}, {"type": "subtitle", "time": 1775.43, "timestamp": "00:29:35", "text": "。 だから、"}, {"type": "subtitle", "time": 1782.149, "timestamp": "00:29:42", "text": "話題を考え出すことや物語を作ること、"}, {"type": "subtitle", "time": 1785.83, "timestamp": "00:29:45", "text": "分かりやすい物語を作ることなどについて話しながら、ひたすら練習するようにしています。 私は"}, {"type": "subtitle", "time": 1787.505, "timestamp": "00:29:47", "text": "そういうのは苦手なんです [笑い]"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "[息を呑む]"}, {"type": "subtitle", "time": 1792.549, "timestamp": "00:29:52", "text": "でも、ええ、そういうのは苦手なんです。でも、ええ、"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "私は以前はバックグラウンドでゲームをプレイしてマルチタスクをしていました。ストリームはこんな感じになります。"}]
[{"type": "subtitle", "time": 5340.07, "timestamp": "01:29:00", "text": "分、5分、3分、2分ごとに、"}, {"type": "subtitle", "time": 5346.161, "timestamp": "01:29:06", "text": "イベントに3分2秒プラス3分2秒が追加され続けるということです。"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "[笑い声とため息]"}, {"type": "subtitle", "time": 5349.99, "timestamp": "01:29:09", "text": "ああ、"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "でもこれはいいですね。"}, {"type": "subtitle", "time": 5353.91, "timestamp": "01:29:13", "text": "うん。"}, {"type": "subtitle", "time": 5356.95, "timestamp": "01:29:16", "text": "まあ、そうですね。 ええと、"}, {"type": "subtitle", "time": 5361.91, "timestamp": "01:29:21", "text": "最後に削除ロジックを実行する必要があるので、"}, {"type": "subtitle", "time": 5363.91, "timestamp": "01:29:23", "text": "今からそれを実行しようと思います。 それから、"}, {"type": "subtitle", "time": 5367.776, "timestamp": "01:29:27", "text": "アナウンスアナウンスボタンの作業に取り掛かるつもりです。"}, {"type": "subtitle", "time": 5367.99, "timestamp": "01:29:27", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 5371.75, "timestamp": "01:29:31", "text": "えーと、ボタンです。   ええと、"}, {"type": "subtitle", "time": 5377.189, "timestamp": "01:29:37", "text": "イベントでやったことをそのまま再現して、アナウンサーの件にも同じロジックをコピーします"}, {"type": "subtitle", "time": 5380.629, "timestamp": "01:29:40", "text": "。 アナウンサーは、"}, {"type": "subtitle", "time": 5383.51, "timestamp": "01:29:43", "text": "[音楽] 削除ロジックのようなものは必要なく、"}, {"type": "subtitle", "time": 5386.629, "timestamp": "01:29:46", "text": "パッチ 1 が主なものです。"}, {"type": "subtitle", "time": 5389.03, "timestamp": "01:29:49", "text": "名前に関する警告を表示する。 今、私は何を"}, {"type": "subtitle", "time": 5391.43, "timestamp": "01:29:51", "text": "見たんだ？ 警告です。"}, {"type": "subtitle", "time": 5394.07, "timestamp": "01:29:54", "text": "Better Studio Webocketがインストールされていません。"}, {"type": "subtitle", "time": 5396.79, "timestamp": "01:29:56", "text": "何？ ああ、そうそう、私はウェブスタジオは使ってないよ"}]
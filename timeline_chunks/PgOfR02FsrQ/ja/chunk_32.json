[{"type": "subtitle", "time": 1922.31, "timestamp": "00:32:02", "text": "不満なラッパーが"}, {"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "よく喋ってると思う？"}, {"type": "subtitle", "time": 1938.87, "timestamp": "00:32:18", "text": "いや、よく喋ってるかどうかは分からない"}, {"type": "subtitle", "time": 1947.35, "timestamp": "00:32:27", "text": "確かに。つまり、"}, {"type": "subtitle", "time": 1949.509, "timestamp": "00:32:29", "text": "ストリーマーなら、"}, {"type": "subtitle", "time": 1953.11, "timestamp": "00:32:33", "text": "よく喋らなきゃいけないよね。そういうことだよね？"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "喋り続けなきゃいけない。喋り続けなきゃいけない。"}]
[{"type": "subtitle", "time": 1085.99, "timestamp": "00:18:05", "text": "えっと、先週やるはずだったプレゼンテーションがあるんだけど"}, {"type": "subtitle", "time": 1087.75, "timestamp": "00:18:07", "text": "。処理が"}, {"type": "subtitle", "time": 1089.83, "timestamp": "00:18:09", "text": "ひどくて。来週までずっと願ってた。なんてこった。"}, {"type": "subtitle", "time": 1100.47, "timestamp": "00:18:20", "text": "延ばしにしたか信じられない"}, {"type": "subtitle", "time": 1103.669, "timestamp": "00:18:23", "text": "。でも、共感できる。"}, {"type": "subtitle", "time": 1105.84, "timestamp": "00:18:25", "text": "共感できる。 だから日本語の宿題とか"}, {"type": "subtitle", "time": 1107.919, "timestamp": "00:18:27", "text": "だから日本語の宿題とか 。いや、ずっとギリギリまで"}, {"type": "subtitle", "time": 1111.84, "timestamp": "00:18:31", "text": "。いや、ずっとギリギリまで 先延ばしにしてたから、すごく苦労したんだ。"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "遅刻したし、えっと、"}, {"type": "subtitle", "time": 1125.909, "timestamp": "00:18:45", "text": "抜き打ち試験みたいなのがあったから、"}, {"type": "subtitle", "time": 1131.27, "timestamp": "00:18:51", "text": "復習とか全部配信したかったんだ。"}, {"type": "subtitle", "time": 1134.23, "timestamp": "00:18:54", "text": "配信でやれば、実際に"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "復習できるから。それで、やろうと思ったんだ"}, {"type": "subtitle", "time": 1138.47, "timestamp": "00:18:58", "text": "。それからサミーの件が起こった。"}]
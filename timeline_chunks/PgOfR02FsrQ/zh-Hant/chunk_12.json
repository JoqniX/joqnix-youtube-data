[{"type": "subtitle", "time": 722.389, "timestamp": "00:12:02", "text": "我需要"}, {"type": "subtitle", "time": 723.91, "timestamp": "00:12:03", "text": "手動傳送這個快拍。"}, {"type": "subtitle", "time": 731.11, "timestamp": "00:12:11", "text": "所以我需要輸入連結之類的，就是這種自動化"}, {"type": "subtitle", "time": 733.11, "timestamp": "00:12:13", "text": "流程。 [嗤笑] 現在快多了。我不用擔心了。我不用擔心忘記了。它是自動化的。"}, {"type": "subtitle", "time": 749.67, "timestamp": "00:12:29", "text": "Warframe。"}, {"type": "subtitle", "time": 756.15, "timestamp": "00:12:36", "text": "我想玩，但是現在這樣就夠了。嗯，我現在不想再玩遊戲了。"}, {"type": "subtitle", "time": 762.79, "timestamp": "00:12:42", "text": "我在考慮要不要開始玩，像是玩《Where Wins Meat》之類的遊戲，"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "然後我就想，啊，太多了，我會太沉迷，或者太投入。我會"}]
[{"type": "subtitle", "time": 1922.31, "timestamp": "00:32:02", "text": "歌手。"}, {"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "你覺得我話多嗎？我……其實我不知道我是不是話多。"}, {"type": "subtitle", "time": 1947.35, "timestamp": "00:32:27", "text": "當然。我的意思是，"}, {"type": "subtitle", "time": 1949.509, "timestamp": "00:32:29", "text": "如果你是主播，你就得話多。就是這樣，對吧？"}, {"type": "subtitle", "time": 1953.11, "timestamp": "00:32:33", "text": "你得不停地說"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "。你必須……繼續說下去。我一邊數數一邊吃香蕉。"}]
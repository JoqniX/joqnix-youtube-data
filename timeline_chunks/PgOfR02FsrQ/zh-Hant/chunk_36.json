[{"type": "subtitle", "time": 2162.63, "timestamp": "00:36:02", "text": "因為有故障保護機制來"}, {"type": "subtitle", "time": 2166.15, "timestamp": "00:36:06", "text": "防止任何崩潰發生。"}, {"type": "subtitle", "time": 2181.43, "timestamp": "00:36:21", "text": "說到所有這些"}, {"type": "subtitle", "time": 2184.15, "timestamp": "00:36:24", "text": "因為今天睡不著，我一直在"}, {"type": "subtitle", "time": 2186.95, "timestamp": "00:36:26", "text": "想各種各樣的事情"}, {"type": "subtitle", "time": 2189.43, "timestamp": "00:36:29", "text": "。"}, {"type": "subtitle", "time": 2194.069, "timestamp": "00:36:34", "text": "我到底在做什麼？我的生活、我的"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "創作等等，到底是怎麼回事？我"}, {"type": "subtitle", "time": 2202.63, "timestamp": "00:36:42", "text": "一直想做個視頻，"}, {"type": "subtitle", "time": 2205.43, "timestamp": "00:36:45", "text": "嗯，我想做個關於某個"}, {"type": "subtitle", "time": 2207.03, "timestamp": "00:36:47", "text": "主題的視頻。"}, {"type": "subtitle", "time": 2209.589, "timestamp": "00:36:49", "text": "然後我突然意識到，"}, {"type": "subtitle", "time": 2211.51, "timestamp": "00:36:51", "text": "談論虛擬主播之類的東西有什麼意義呢"}, {"type": "subtitle", "time": 2214.47, "timestamp": "00:36:54", "text": "？呃，那隻會引發各種"}, {"type": "subtitle", "time": 2216.79, "timestamp": "00:36:56", "text": "爭論什麼的。說實話，我本來想做一個關於這一切的視頻，"}]
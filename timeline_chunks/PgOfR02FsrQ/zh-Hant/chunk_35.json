[{"type": "subtitle", "time": 2100.95, "timestamp": "00:35:00", "text": "按鈕的描述裡也有。我們已經完成了第一個按鈕的第二部分，也就是"}, {"type": "subtitle", "time": 2103.829, "timestamp": "00:35:03", "text": "第二個補丁部分"}, {"type": "subtitle", "time": 2105.51, "timestamp": "00:35:05", "text": "。是的"}, {"type": "subtitle", "time": 2109.43, "timestamp": "00:35:09", "text": "。現在是刪除"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "邏輯。"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "我想做刪除邏輯，但我"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "發現我忘了修改"}, {"type": "subtitle", "time": 2125.829, "timestamp": "00:35:25", "text": "事件。呃，這事件……呃，"}, {"type": "subtitle", "time": 2128.47, "timestamp": "00:35:28", "text": "忘了修改事件。呃，不，我"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "忘了延長活動時間。"}, {"type": "subtitle", "time": 2132.71, "timestamp": "00:35:32", "text": "你可能已經注意到"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "我的伺服器上從昨天開始就有Discord活動了。"}, {"type": "subtitle", "time": 2139.91, "timestamp": "00:35:39", "text": "是的，我在測試"}, {"type": "subtitle", "time": 2142.79, "timestamp": "00:35:42", "text": "一些東西，"}, {"type": "subtitle", "time": 2145.51, "timestamp": "00:35:45", "text": "我忘記延長它的時間了，而且我的按鈕"}, {"type": "subtitle", "time": 2148.069, "timestamp": "00:35:48", "text": "沒有運行，因為我"}, {"type": "subtitle", "time": 2153.109, "timestamp": "00:35:53", "text": "開啟了Cloudflare Warp。這導致了一些問題。我"}, {"type": "subtitle", "time": 2156.71, "timestamp": "00:35:56", "text": "不得不為此設定一個故障保護機制。"}, {"type": "subtitle", "time": 2159.91, "timestamp": "00:35:59", "text": "所以它跳過了按鈕，"}]
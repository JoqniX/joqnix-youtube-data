[{"type": "subtitle", "time": 20040.628, "timestamp": "05:34:00", "text": "啊，我看到一个镜头。让我看看。"}, {"type": "subtitle", "time": 20043.03, "timestamp": "05:34:03", "text": "有点……该怎么说呢……太"}, {"type": "subtitle", "time": 20045.27, "timestamp": "05:34:05", "text": "我很喜欢动漫。动漫配音太多了"}, {"type": "subtitle", "time": 20046.83, "timestamp": "05:34:06", "text": "为了"}, {"type": "subtitle", "time": 20049.37, "timestamp": "05:34:09", "text": "我喜欢"}, {"type": "subtitle", "time": 20072.628, "timestamp": "05:34:32", "text": "这首歌，他们在冰上创作了一首歌"}, {"type": "subtitle", "time": 20075.75, "timestamp": "05:34:35", "text": "奶油味。是的。这个女孩喜欢"}, {"type": "subtitle", "time": 20079.35, "timestamp": "05:34:39", "text": "女孩问你是M吗？你做什么？"}, {"type": "subtitle", "time": 20081.99, "timestamp": "05:34:41", "text": "你喜欢吗？所以她的意思是说我喜欢饼干"}, {"type": "subtitle", "time": 20083.91, "timestamp": "05:34:43", "text": "还有奶油，另一个女孩说我"}, {"type": "subtitle", "time": 20086.628, "timestamp": "05:34:46", "text": "比如草莓味和其他口味"}, {"type": "subtitle", "time": 20090.788, "timestamp": "05:34:50", "text": "女孩说我喜欢巧克力薄荷味。我发送"}, {"type": "subtitle", "time": 20092.948, "timestamp": "05:34:52", "text": "我喜欢女孩。"}]
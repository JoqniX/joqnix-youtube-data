[{"type": "subtitle", "time": 13689.51, "timestamp": "03:48:09", "text": "如果下界不能用床，那该怎么办？"}, {"type": "subtitle", "time": 13692.469, "timestamp": "03:48:12", "text": "你愿意为检查站做些什么？"}, {"type": "subtitle", "time": 13695.03, "timestamp": "03:48:15", "text": "呃，没有检查站。"}, {"type": "subtitle", "time": 13697.75, "timestamp": "03:48:17", "text": "我的天啊。你会死，你会死。你死了，"}, {"type": "subtitle", "time": 13699.87, "timestamp": "03:48:19", "text": "你死了。您将返回"}, {"type": "subtitle", "time": 13711.83, "timestamp": "03:48:31", "text": "但这个地方很糟糕。"}, {"type": "subtitle", "time": 13713.67, "timestamp": "03:48:33", "text": "简直糟透了。"}, {"type": "subtitle", "time": 13718.99, "timestamp": "03:48:38", "text": "上帝。挑战"}, {"type": "subtitle", "time": 13721.55, "timestamp": "03:48:41", "text": "竞技场。让我去"}]
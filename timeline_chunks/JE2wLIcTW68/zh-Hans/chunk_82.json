[{"type": "subtitle", "time": 4920.75, "timestamp": "01:22:00", "text": "它是"}, {"type": "subtitle", "time": 4923.39, "timestamp": "01:22:03", "text": "好的，稍等一下。我目前有空"}, {"type": "subtitle", "time": 4930.47, "timestamp": "01:22:10", "text": "你。我发誓这次真的不是我。我"}, {"type": "subtitle", "time": 4933.189, "timestamp": "01:22:13", "text": "我向你保证"}, {"type": "subtitle", "time": 4935.83, "timestamp": "01:22:15", "text": "如何操作？"}, {"type": "subtitle", "time": 4940.07, "timestamp": "01:22:20", "text": "哦。嘿，鲁戈。你最喜欢的东西。"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "哦，"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "我要买它。"}, {"type": "subtitle", "time": 4946.229, "timestamp": "01:22:26", "text": "还有，再次为……感到抱歉"}, {"type": "subtitle", "time": 4949.11, "timestamp": "01:22:29", "text": "补充。"}, {"type": "subtitle", "time": 4950.629, "timestamp": "01:22:30", "text": "不，这很有趣，兄弟。来吧，做吧"}, {"type": "subtitle", "time": 4955.75, "timestamp": "01:22:35", "text": "这是什么？直截了当地"}, {"type": "subtitle", "time": 4959.07, "timestamp": "01:22:39", "text": "手榴弹。对，你只要按三就行了。"}, {"type": "subtitle", "time": 4962.229, "timestamp": "01:22:42", "text": "第三次将开始"}, {"type": "subtitle", "time": 4965.22, "timestamp": "01:22:45", "text": "制作"}, {"type": "subtitle", "time": 4978.39, "timestamp": "01:22:58", "text": "哦，后面有东西。哦，是的。"}]
[{"type": "subtitle", "time": 8644.15, "timestamp": "02:24:04", "text": "工作。你没上传吗？"}, {"type": "subtitle", "time": 8646.15, "timestamp": "02:24:06", "text": "视频缩略图。呃，是"}, {"type": "subtitle", "time": 8648.79, "timestamp": "02:24:08", "text": "因为我在做代班之类的"}, {"type": "subtitle", "time": 8652.15, "timestamp": "02:24:12", "text": "对吧？那么，我来告诉你为什么。一"}, {"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "第二。"}, {"type": "subtitle", "time": 8657.63, "timestamp": "02:24:17", "text": "所以，我引用了另一位创作者的作品。"}, {"type": "subtitle", "time": 8660.63, "timestamp": "02:24:20", "text": "我看到他们这么做了。所以，我"}, {"type": "subtitle", "time": 8663.349, "timestamp": "02:24:23", "text": "当时我就想，“哦，我也可以做同样的事。”"}, {"type": "subtitle", "time": 8664.63, "timestamp": "02:24:24", "text": "因为你必须这样想："}, {"type": "subtitle", "time": 8667.309, "timestamp": "02:24:27", "text": "就是这样。”好的，当你做代课老师的时候"}, {"type": "subtitle", "time": 8669.83, "timestamp": "02:24:29", "text": "按钮，对吧？我的意思是，如果你是一个"}, {"type": "subtitle", "time": 8671.429, "timestamp": "02:24:31", "text": "更大的创作者，你就能拥有"}, {"type": "subtitle", "time": 8673.19, "timestamp": "02:24:33", "text": "找人帮你制作缩略图，或者"}, {"type": "subtitle", "time": 8675.11, "timestamp": "02:24:35", "text": "一些东西，然后是所有这些东西。它"}, {"type": "subtitle", "time": 8676.87, "timestamp": "02:24:36", "text": "只需要五分钟，或者哦，我可以做"}, {"type": "subtitle", "time": 8681.03, "timestamp": "02:24:41", "text": "当然是我自己做的，但我感觉……"}, {"type": "subtitle", "time": 8683.27, "timestamp": "02:24:43", "text": "感觉疼痛难忍。所以，我"}, {"type": "subtitle", "time": 8685.91, "timestamp": "02:24:45", "text": "想到了这样做，然后"}, {"type": "subtitle", "time": 8689.15, "timestamp": "02:24:49", "text": "我提到的创作者是"}, {"type": "subtitle", "time": 8691.91, "timestamp": "02:24:51", "text": "苏罗斯。她跳了一段萨巴顿舞。我觉得她"}, {"type": "subtitle", "time": 8697.11, "timestamp": "02:24:57", "text": "呃，我现在正在做萨巴顿乐队的演出吗？"}]
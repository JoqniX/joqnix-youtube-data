[{"type": "subtitle", "time": 11642.63, "timestamp": "03:14:02", "text": "传奇。是的。"}, {"type": "subtitle", "time": 11645.349, "timestamp": "03:14:05", "text": "一开始，我没有"}, {"type": "subtitle", "time": 11647.11, "timestamp": "03:14:07", "text": "我打算去看，我的朋友订了票。"}, {"type": "subtitle", "time": 11649.03, "timestamp": "03:14:09", "text": "给我一张票。他也喜欢玩"}, {"type": "subtitle", "time": 11650.79, "timestamp": "03:14:10", "text": "我的世界"}, {"type": "subtitle", "time": 11653.11, "timestamp": "03:14:13", "text": "但他很少这样，好像他只是喜欢玩。"}, {"type": "subtitle", "time": 11655.19, "timestamp": "03:14:15", "text": "他好像就喜欢欺负人。"}, {"type": "subtitle", "time": 11657.11, "timestamp": "03:14:17", "text": "我的世界。"}, {"type": "subtitle", "time": 11660.87, "timestamp": "03:14:20", "text": "所以原本计划是出去玩，但他"}, {"type": "subtitle", "time": 11663.75, "timestamp": "03:14:23", "text": "已预订机票。于是我就看了。"}, {"type": "subtitle", "time": 11666.07, "timestamp": "03:14:26", "text": "我后悔了，我浪费了很多时间。"}, {"type": "subtitle", "time": 11668.389, "timestamp": "03:14:28", "text": "把钱投进去，然后就出去了。"}, {"type": "subtitle", "time": 11670.87, "timestamp": "03:14:30", "text": "间隔。"}, {"type": "subtitle", "time": 11672.87, "timestamp": "03:14:32", "text": "不值我花的钱。喜欢"}, {"type": "subtitle", "time": 11675.03, "timestamp": "03:14:35", "text": "如果我已经支付了大约300或400元，"}, {"type": "subtitle", "time": 11677.309, "timestamp": "03:14:37", "text": "这将是"}, {"type": "subtitle", "time": 11679.83, "timestamp": "03:14:39", "text": "值得。哦，等等。别告诉我你"}, {"type": "subtitle", "time": 11683.59, "timestamp": "03:14:43", "text": "哦，天哪。你真是浪费了"}, {"type": "subtitle", "time": 11686.71, "timestamp": "03:14:46", "text": "那玩意儿肯定值钱。我不是那个人"}, {"type": "subtitle", "time": 11689.03, "timestamp": "03:14:49", "text": "谁订的票？"}, {"type": "subtitle", "time": 11692.15, "timestamp": "03:14:52", "text": "但归根结底，那都是钱。"}, {"type": "subtitle", "time": 11696.63, "timestamp": "03:14:56", "text": "是的。等等，没事的。你在哪里？"}, {"type": "subtitle", "time": 11699.91, "timestamp": "03:14:59", "text": "呃，我还在城堡里。好的。"}]
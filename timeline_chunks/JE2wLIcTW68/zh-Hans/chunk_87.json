[{"type": "subtitle", "time": 5235.27, "timestamp": "01:27:15", "text": "贱人。啊哈！我藏在衣柜里。等待，"}, {"type": "subtitle", "time": 5237.03, "timestamp": "01:27:17", "text": "什么？不，不，不，不，不。我不在其中"}, {"type": "subtitle", "time": 5238.95, "timestamp": "01:27:18", "text": "壁橱。我要出柜了。"}, {"type": "subtitle", "time": 5240.31, "timestamp": "01:27:20", "text": "等等，不，不，不。那不是我的意思"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "意思是。这里没有涉及壁橱。"}, {"type": "subtitle", "time": 5247.55, "timestamp": "01:27:27", "text": "他妈的。不，不，不，不，不，不。就是这样。"}, {"type": "subtitle", "time": 5258.149, "timestamp": "01:27:38", "text": "基督。哦，他们都死了。是的。"}, {"type": "subtitle", "time": 5259.709, "timestamp": "01:27:39", "text": "迷人的。"}, {"type": "subtitle", "time": 5261.95, "timestamp": "01:27:41", "text": "好的。我不是"}]
[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "如果运气好的话，还能对敌人造成伤害。"}, {"type": "subtitle", "time": 1505.909, "timestamp": "00:25:05", "text": "是的。升级。势头。我们走吧。我们"}, {"type": "subtitle", "time": 1508.87, "timestamp": "00:25:08", "text": "翻滚小屋升级。当然。"}, {"type": "subtitle", "time": 1510.71, "timestamp": "00:25:10", "text": "走吧，兄弟。我们有足够的东西来做类似的事情"}, {"type": "subtitle", "time": 1512.549, "timestamp": "00:25:12", "text": "让我们看看能获得多少升级。"}, {"type": "subtitle", "time": 1515.19, "timestamp": "00:25:15", "text": "健康值提升，力量值提升。 H"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "没有无人机。呃，所以冲刺冲刺"}, {"type": "subtitle", "time": 1521.19, "timestamp": "00:25:21", "text": "速度固然好，但它占用大量资源。"}, {"type": "subtitle", "time": 1523.43, "timestamp": "00:25:23", "text": "感觉就像它开始消耗你的体力一样"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "很多。考验耐力。射程不错"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "为了得到东西，就像推动它一样"}, {"type": "subtitle", "time": 1530.63, "timestamp": "00:25:30", "text": "足够远。力量只存在于当下。"}, {"type": "subtitle", "time": 1533.909, "timestamp": "00:25:33", "text": "现在，就现在，你只需要积蓄力量。"}, {"type": "subtitle", "time": 1536.07, "timestamp": "00:25:36", "text": "他获得了力量砍击。"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "我也拿一个。是的。并非每个人都这么认为"}, {"type": "subtitle", "time": 1542.95, "timestamp": "00:25:42", "text": "共享。每个人都有自己的升级方案。"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "等等，你是说每个人都在吗？每个人都在吗？"}, {"type": "subtitle", "time": 1547.909, "timestamp": "00:25:47", "text": "身体完全健康？我100岁了。呃，头不是。"}, {"type": "subtitle", "time": 1550.75, "timestamp": "00:25:50", "text": "头。呃，做"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "毛刺。你不知道这个故障吗？是的，"}, {"type": "subtitle", "time": 1554.11, "timestamp": "00:25:54", "text": "你"}, {"type": "subtitle", "time": 1556.549, "timestamp": "00:25:56", "text": "不能玩那么长时间。你所做的是"}, {"type": "subtitle", "time": 1558.789, "timestamp": "00:25:58", "text": "就像你拿起一个医疗包，然后……"}]
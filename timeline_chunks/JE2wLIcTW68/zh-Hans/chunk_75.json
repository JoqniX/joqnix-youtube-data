[{"type": "subtitle", "time": 4500.87, "timestamp": "01:15:00", "text": "好的，我们来看看还有什么其他东西。"}, {"type": "subtitle", "time": 4533.75, "timestamp": "01:15:33", "text": "我去看看左边的房间。"}, {"type": "subtitle", "time": 4536.55, "timestamp": "01:15:36", "text": "好的。它还没开门，所以我希望"}, {"type": "subtitle", "time": 4550.99, "timestamp": "01:15:50", "text": "那是什么？令人毛骨悚然"}, {"type": "subtitle", "time": 4553.229, "timestamp": "01:15:53", "text": "爬行"}, {"type": "subtitle", "time": 4557.59, "timestamp": "01:15:57", "text": "令人毛骨悚然的、发出怪笑的大东西。是的。"}]
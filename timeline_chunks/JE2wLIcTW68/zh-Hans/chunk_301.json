[{"type": "subtitle", "time": 18060.628, "timestamp": "05:01:00", "text": "我只用它编辑我的歌曲。"}, {"type": "subtitle", "time": 18068.23, "timestamp": "05:01:08", "text": "我想创作音乐。我想创造"}, {"type": "subtitle", "time": 18069.75, "timestamp": "05:01:09", "text": "音乐。"}, {"type": "subtitle", "time": 18072.788, "timestamp": "05:01:12", "text": "只是我时间不够。"}, {"type": "subtitle", "time": 18075.67, "timestamp": "05:01:15", "text": "艺术也是如此。"}, {"type": "subtitle", "time": 18078.15, "timestamp": "05:01:18", "text": "你如何应对缺乏……"}, {"type": "subtitle", "time": 18085.75, "timestamp": "05:01:25", "text": "嗯，就像你一样，你脑子里也有一首歌。"}, {"type": "subtitle", "time": 18088.47, "timestamp": "05:01:28", "text": "但要在软件领域取得成功却很难。"}, {"type": "subtitle", "time": 18090.91, "timestamp": "05:01:30", "text": "片刻。"}, {"type": "subtitle", "time": 18093.75, "timestamp": "05:01:33", "text": "是啊，这就是我一直没能完成它的原因。"}, {"type": "subtitle", "time": 18096.15, "timestamp": "05:01:36", "text": "你知道我跟你讲的那首歌。"}, {"type": "subtitle", "time": 18098.39, "timestamp": "05:01:38", "text": "关于这首歌，就是我现在的这首"}, {"type": "subtitle", "time": 18102.868, "timestamp": "05:01:42", "text": "我只是唱了句“嗯”，歌词是我写的。"}, {"type": "subtitle", "time": 18106.15, "timestamp": "05:01:46", "text": "当时正在学习工作室，大概是那时。"}, {"type": "subtitle", "time": 18107.83, "timestamp": "05:01:47", "text": "2019年。"}, {"type": "subtitle", "time": 18112.31, "timestamp": "05:01:52", "text": "啊，呃，我从来没完成过。"}, {"type": "subtitle", "time": 18115.0, "timestamp": "05:01:55", "text": "直到现在。"}, {"type": "subtitle", "time": 18116.788, "timestamp": "05:01:56", "text": "[音乐]"}, {"type": "subtitle", "time": 18119.83, "timestamp": "05:01:59", "text": "顺便一提，底座是我做的。我 我 我 制作"}]
[{"type": "subtitle", "time": 10981.269, "timestamp": "03:03:01", "text": "现在。我看到了像《卫报》之类的东西。"}, {"type": "subtitle", "time": 10983.349, "timestamp": "03:03:03", "text": "是的，守护者很多。"}, {"type": "subtitle", "time": 10986.309, "timestamp": "03:03:06", "text": "这里有很多海洋遗迹。"}, {"type": "subtitle", "time": 10988.55, "timestamp": "03:03:08", "text": "不，我从未意识到我的塔就像"}, {"type": "subtitle", "time": 10992.469, "timestamp": "03:03:12", "text": "从他们的角度来看，我的基地看起来有点奇怪。它"}, {"type": "subtitle", "time": 10994.55, "timestamp": "03:03:14", "text": "做。它看起来像一列水下列车。"}, {"type": "subtitle", "time": 11020.07, "timestamp": "03:03:40", "text": "她还没到濒死状态。"}, {"type": "subtitle", "time": 11023.55, "timestamp": "03:03:43", "text": "我只是没那么优秀而已"}]
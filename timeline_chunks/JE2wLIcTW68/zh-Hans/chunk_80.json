[{"type": "subtitle", "time": 4804.95, "timestamp": "01:20:04", "text": "呃，我应该提升力量属性吗？"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "我？等等，你可以办一张口袋卡。"}, {"type": "subtitle", "time": 4809.43, "timestamp": "01:20:09", "text": "是的，我的力量要提升了。"}, {"type": "subtitle", "time": 4811.35, "timestamp": "01:20:11", "text": "我力气不够，摔倒了。"}, {"type": "subtitle", "time": 4813.51, "timestamp": "01:20:13", "text": "道路。"}, {"type": "subtitle", "time": 4816.91, "timestamp": "01:20:16", "text": "我只买一个。"}, {"type": "subtitle", "time": 4820.55, "timestamp": "01:20:20", "text": "更多的。你可以"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "他现在正在恢复意识。他得到了"}, {"type": "subtitle", "time": 4825.189, "timestamp": "01:20:25", "text": "矿。好的。是的，我们很好。什么"}, {"type": "subtitle", "time": 4827.51, "timestamp": "01:20:27", "text": "你刚才说什么？什么？矿井。你是"}, {"type": "subtitle", "time": 4832.47, "timestamp": "01:20:32", "text": "矿。好的。好的。呃，你们两个，两个"}, {"type": "subtitle", "time": 4835.35, "timestamp": "01:20:35", "text": "如果你购买大包装的保健品。哦，"}, {"type": "subtitle", "time": 4837.27, "timestamp": "01:20:37", "text": "当然！好的。已经有人拿走了"}, {"type": "subtitle", "time": 4838.95, "timestamp": "01:20:38", "text": "里面有一个。又一个。实际上，"}, {"type": "subtitle", "time": 4843.189, "timestamp": "01:20:43", "text": "你们三个都需要它。我很安全。"}, {"type": "subtitle", "time": 4844.87, "timestamp": "01:20:44", "text": "好的。好的。好的。保持"}, {"type": "subtitle", "time": 4847.99, "timestamp": "01:20:47", "text": "它。升级。"}, {"type": "subtitle", "time": 4849.669, "timestamp": "01:20:49", "text": "其实，因为我打算犯傻。"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "等等，等等，等等。我需要服用"}, {"type": "subtitle", "time": 4855.87, "timestamp": "01:20:55", "text": "给你准备了一个大的。不用担心。"}, {"type": "subtitle", "time": 4859.35, "timestamp": "01:20:59", "text": "H 宝宝。"}]
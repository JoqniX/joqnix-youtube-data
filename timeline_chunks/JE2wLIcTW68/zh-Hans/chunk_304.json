[{"type": "subtitle", "time": 18241.27, "timestamp": "05:04:01", "text": "哦，我看过约瑟夫儿子的内容。它是"}, {"type": "subtitle", "time": 18245.59, "timestamp": "05:04:05", "text": "他做这件事的方式太酷了。是的。"}, {"type": "subtitle", "time": 18248.708, "timestamp": "05:04:08", "text": "他是如何制作音效的？"}, {"type": "subtitle", "time": 18253.99, "timestamp": "05:04:13", "text": "还有别的什么？比如什么？我不知道。"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "视情况而定。他在教我。他是"}, {"type": "subtitle", "time": 18258.868, "timestamp": "05:04:18", "text": "你教过我，但我忘记了你教过我什么。"}, {"type": "subtitle", "time": 18262.31, "timestamp": "05:04:22", "text": "我。哦，不。"}, {"type": "subtitle", "time": 18264.55, "timestamp": "05:04:24", "text": "我输了。等等，我们本来就打算等。我们"}, {"type": "subtitle", "time": 18276.948, "timestamp": "05:04:36", "text": "你知道吗？我们去城堡吧。"}, {"type": "subtitle", "time": 18279.15, "timestamp": "05:04:39", "text": "我们坐下，然后"}]
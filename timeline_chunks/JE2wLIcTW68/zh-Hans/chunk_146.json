[{"type": "subtitle", "time": 8760.95, "timestamp": "02:26:00", "text": "YouTube。因此人们更喜欢"}, {"type": "subtitle", "time": 8764.23, "timestamp": "02:26:04", "text": "呃，不如改在 Twitch 上直播吧。"}, {"type": "subtitle", "time": 8766.63, "timestamp": "02:26:06", "text": "各种义卖活动之类的"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "确实如此。所以我用我的小玩意儿做了什么呢？"}, {"type": "subtitle", "time": 8772.95, "timestamp": "02:26:12", "text": "就像我参加运动马拉松一样"}, {"type": "subtitle", "time": 8777.389, "timestamp": "02:26:17", "text": "距离6月12日还有4个月，或者说已经过了一半时间"}, {"type": "subtitle", "time": 8779.07, "timestamp": "02:26:19", "text": "六月。"}, {"type": "subtitle", "time": 8782.79, "timestamp": "02:26:22", "text": "嗯，是的。所以我选择的做法是……"}, {"type": "subtitle", "time": 8785.87, "timestamp": "02:26:25", "text": "把淡蓝色涂满一个月"}, {"type": "subtitle", "time": 8789.59, "timestamp": "02:26:29", "text": "三月和淡紫色，那是我的"}, {"type": "subtitle", "time": 8792.11, "timestamp": "02:26:32", "text": "右眼。我的左眼是淡蓝色。"}, {"type": "subtitle", "time": 8796.95, "timestamp": "02:26:36", "text": "颜色。四月是紫色，我会……"}, {"type": "subtitle", "time": 8799.99, "timestamp": "02:26:39", "text": "我会像五月那样做，就像……"}, {"type": "subtitle", "time": 8802.95, "timestamp": "02:26:42", "text": "粉红色，六月会变成白色"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "颜色很重要，因为六月将是最后阶段。"}, {"type": "subtitle", "time": 8808.55, "timestamp": "02:26:48", "text": "参加本次活动。然后我要去日本"}, {"type": "subtitle", "time": 8811.469, "timestamp": "02:26:51", "text": "以及其他一些东西"}, {"type": "subtitle", "time": 8813.91, "timestamp": "02:26:53", "text": "七月。是的，很多事情。但"}, {"type": "subtitle", "time": 8816.309, "timestamp": "02:26:56", "text": "是的，在那之前我经常做所有的事情"}, {"type": "subtitle", "time": 8818.15, "timestamp": "02:26:58", "text": "游戏里我做了一个新的缩略图之类的东西"}]
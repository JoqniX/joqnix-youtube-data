[{"type": "subtitle", "time": 4560.47, "timestamp": "01:16:00", "text": "不用担心。别看它。你还好吗？"}, {"type": "subtitle", "time": 4563.91, "timestamp": "01:16:03", "text": "我的天哪，我尖叫得好厉害。"}, {"type": "subtitle", "time": 4572.47, "timestamp": "01:16:12", "text": "你可以大声尖叫。你不需要"}, {"type": "subtitle", "time": 4575.669, "timestamp": "01:16:15", "text": "害怕。这是一款恐怖游戏。"}, {"type": "subtitle", "time": 4599.43, "timestamp": "01:16:39", "text": "哦，你还活着。"}, {"type": "subtitle", "time": 4602.229, "timestamp": "01:16:42", "text": "好吧，让我来救你。有一个"}, {"type": "subtitle", "time": 4604.35, "timestamp": "01:16:44", "text": "更多的。呃"}]
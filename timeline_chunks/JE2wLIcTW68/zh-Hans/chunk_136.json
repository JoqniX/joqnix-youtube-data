[{"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "也像……是的。将来，你"}, {"type": "subtitle", "time": 8166.55, "timestamp": "02:16:06", "text": "你知道，如果事情变得一团糟，你知道，你"}, {"type": "subtitle", "time": 8167.87, "timestamp": "02:16:07", "text": "知道该怎么做"}, {"type": "subtitle", "time": 8176.79, "timestamp": "02:16:16", "text": "但是，呃，主要是因为当你"}, {"type": "subtitle", "time": 8179.99, "timestamp": "02:16:19", "text": "现在会有很多管材之类的东西。"}, {"type": "subtitle", "time": 8182.109, "timestamp": "02:16:22", "text": "将会发生的事情"}, {"type": "subtitle", "time": 8184.87, "timestamp": "02:16:24", "text": "你认识的人越多，这种情况就越容易发生。"}, {"type": "subtitle", "time": 8188.069, "timestamp": "02:16:28", "text": "你接触的人以及那些事，呃……"}, {"type": "subtitle", "time": 8190.069, "timestamp": "02:16:30", "text": "会有人试图接近你，"}, {"type": "subtitle", "time": 8192.23, "timestamp": "02:16:32", "text": "一切。"}, {"type": "subtitle", "time": 8196.549, "timestamp": "02:16:36", "text": "呃，你知道，比如说"}, {"type": "subtitle", "time": 8198.95, "timestamp": "02:16:38", "text": "比如说，你一直在直播"}, {"type": "subtitle", "time": 8202.709, "timestamp": "02:16:42", "text": "一段时间内，你或者慢慢地，嗯"}, {"type": "subtitle", "time": 8204.709, "timestamp": "02:16:44", "text": "建立受众群体等等"}, {"type": "subtitle", "time": 8209.27, "timestamp": "02:16:49", "text": "你最好的时候，有些人喜欢"}, {"type": "subtitle", "time": 8212.549, "timestamp": "02:16:52", "text": "有些观众可以靠得很近，而且"}, {"type": "subtitle", "time": 8216.07, "timestamp": "02:16:56", "text": "你知道，准社会主义是存在的。"}, {"type": "subtitle", "time": 8218.87, "timestamp": "02:16:58", "text": "我可是吃过苦头才明白的，我没明白。"}]
[{"type": "subtitle", "time": 10390.55, "timestamp": "02:53:10", "text": "这是谁？这里这些人的父亲也在其中。哦"}, {"type": "subtitle", "time": 10399.75, "timestamp": "02:53:19", "text": "该死。这就是你一直藏身的地方"}, {"type": "subtitle", "time": 10403.349, "timestamp": "02:53:23", "text": "这次。是的。"}, {"type": "subtitle", "time": 10406.55, "timestamp": "02:53:26", "text": "我的天啊。"}, {"type": "subtitle", "time": 10408.71, "timestamp": "02:53:28", "text": "我之所以向左转，是因为我当时"}, {"type": "subtitle", "time": 10411.03, "timestamp": "02:53:31", "text": "无聊的。"}, {"type": "subtitle", "time": 10413.349, "timestamp": "02:53:33", "text": "你本应该早就做到了。"}, {"type": "subtitle", "time": 10415.75, "timestamp": "02:53:35", "text": "其他人可能会错过之类的。不，不"}, {"type": "subtitle", "time": 10417.429, "timestamp": "02:53:37", "text": "不，不。他们会偷走它。但这是"}, {"type": "subtitle", "time": 10421.11, "timestamp": "02:53:41", "text": "我做了什么？我用“呃，来”屏蔽了这个。"}, {"type": "subtitle", "time": 10422.83, "timestamp": "02:53:42", "text": "这里。来"}, {"type": "subtitle", "time": 10425.67, "timestamp": "02:53:45", "text": "在。那我以前是怎么藏起来的呢？我屏蔽了"}, {"type": "subtitle", "time": 10430.469, "timestamp": "02:53:50", "text": "就是这样。啊，所以知道了……"}]
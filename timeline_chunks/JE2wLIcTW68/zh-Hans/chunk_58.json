[{"type": "subtitle", "time": 3482.95, "timestamp": "00:58:02", "text": "这样，然后我们就可以好了，你去拿"}, {"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "小件物品。我会着手处理这件事。"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "带着心跳的布娃娃跳。拿"}, {"type": "subtitle", "time": 3490.39, "timestamp": "00:58:10", "text": "所以你才这样。不，不，乔。你正在做的"}, {"type": "subtitle", "time": 3492.069, "timestamp": "00:58:12", "text": "但它就像你没有升级一样。"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "我确实这么做了。哦，如果你……请带上它"}, {"type": "subtitle", "time": 3497.67, "timestamp": "00:58:17", "text": "能。对，你跑，你跳，然后"}, {"type": "subtitle", "time": 3500.47, "timestamp": "00:58:20", "text": "救援。没事的。我只是要走了"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "把它放在外面，放在我的……"}, {"type": "subtitle", "time": 3507.829, "timestamp": "00:58:27", "text": "好吧，这是件大事，因为我们有……"}, {"type": "subtitle", "time": 3509.75, "timestamp": "00:58:29", "text": "不过，不要把它放进提取物里。"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "不，不，不，不。我们会这样说："}]
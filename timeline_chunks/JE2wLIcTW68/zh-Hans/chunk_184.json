[{"type": "subtitle", "time": 11050.67, "timestamp": "03:04:10", "text": "那里有个山洞。啊，"}, {"type": "subtitle", "time": 11055.349, "timestamp": "03:04:15", "text": "你好，洞穴。去哪儿？哦，是这个。"}, {"type": "subtitle", "time": 11057.349, "timestamp": "03:04:17", "text": "我的天啊。它就像一个完整的国家"}, {"type": "subtitle", "time": 11060.469, "timestamp": "03:04:20", "text": "这边。不。哇。"}, {"type": "subtitle", "time": 11062.63, "timestamp": "03:04:22", "text": "实际上，"}, {"type": "subtitle", "time": 11064.429, "timestamp": "03:04:24", "text": "多么大的"}, {"type": "subtitle", "time": 11067.67, "timestamp": "03:04:27", "text": "洞穴。水下可能存在洞穴。"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "哇。"}, {"type": "subtitle", "time": 11071.51, "timestamp": "03:04:31", "text": "是的，"}, {"type": "subtitle", "time": 11074.55, "timestamp": "03:04:34", "text": "它非常大。不。是的。你还没有"}, {"type": "subtitle", "time": 11076.95, "timestamp": "03:04:36", "text": "看到了很多更大的洞穴"}, {"type": "subtitle", "time": 11079.99, "timestamp": "03:04:39", "text": "比那还要糟糕。我的天哪。"}, {"type": "subtitle", "time": 11088.309, "timestamp": "03:04:48", "text": "博士用长矛杀死了墨西哥钝口螈"}]
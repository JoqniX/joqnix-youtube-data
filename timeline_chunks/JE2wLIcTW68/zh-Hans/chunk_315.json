[{"type": "subtitle", "time": 18902.948, "timestamp": "05:15:02", "text": "向上。是的。正确的。"}, {"type": "subtitle", "time": 18906.47, "timestamp": "05:15:06", "text": "你好。你好。所以，呃，兄弟，我需要做……"}, {"type": "subtitle", "time": 18917.43, "timestamp": "05:15:17", "text": "我知道如果我必须对我的朋友说，"}, {"type": "subtitle", "time": 18922.948, "timestamp": "05:15:22", "text": "差不多就是这样。哦，糟糕。你"}, {"type": "subtitle", "time": 18925.83, "timestamp": "05:15:25", "text": "听起来真像我的佩罗西。什么？"}, {"type": "subtitle", "time": 18928.67, "timestamp": "05:15:28", "text": "他妈的？我的"}, {"type": "subtitle", "time": 18931.67, "timestamp": "05:15:31", "text": "上帝。正确的。"}, {"type": "subtitle", "time": 18935.43, "timestamp": "05:15:35", "text": "我的天哪。是的。好的。那也太过了。"}, {"type": "subtitle", "time": 18938.55, "timestamp": "05:15:38", "text": "确实如此。"}, {"type": "subtitle", "time": 18941.35, "timestamp": "05:15:41", "text": "呃，我并不介意。我告诉你"}, {"type": "subtitle", "time": 18944.19, "timestamp": "05:15:44", "text": "后来才知道我在这方面很擅长。但"}, {"type": "subtitle", "time": 18947.11, "timestamp": "05:15:47", "text": "是的，我当时被各种事物包围着。"}, {"type": "subtitle", "time": 18949.43, "timestamp": "05:15:49", "text": "旁遮普人。所以我的口音是……"}, {"type": "subtitle", "time": 18952.868, "timestamp": "05:15:52", "text": "在那里，我感觉我能理解"}, {"type": "subtitle", "time": 18955.99, "timestamp": "05:15:55", "text": "几乎所有东西都是旁遮普语。我也可以"}, {"type": "subtitle", "time": 18958.628, "timestamp": "05:15:58", "text": "能理解，但我认为我不能"}]
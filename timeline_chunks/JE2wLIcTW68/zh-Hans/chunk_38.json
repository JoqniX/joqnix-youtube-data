[{"type": "subtitle", "time": 2282.63, "timestamp": "00:38:02", "text": "求助。"}, {"type": "subtitle", "time": 2285.43, "timestamp": "00:38:05", "text": "如果我抢到最高分就好了。"}, {"type": "subtitle", "time": 2287.349, "timestamp": "00:38:07", "text": "11."}, {"type": "subtitle", "time": 2291.15, "timestamp": "00:38:11", "text": "好的，给他20分。我可以做到。给他"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "后退。够了。够了。"}, {"type": "subtitle", "time": 2297.349, "timestamp": "00:38:17", "text": "操我。操我。哦，真倒霉。给它"}, {"type": "subtitle", "time": 2299.91, "timestamp": "00:38:19", "text": "对他来说。哦好的。好的。我把它给了"}, {"type": "subtitle", "time": 2307.589, "timestamp": "00:38:27", "text": "美好的。我当时已经……你的HP是多少？"}, {"type": "subtitle", "time": 2310.87, "timestamp": "00:38:30", "text": "现在？ 15. 前方项目。我今年19岁。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "让我直接走。"}, {"type": "subtitle", "time": 2315.75, "timestamp": "00:38:35", "text": "啊，够了。好的。好的。有一个"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "物品就在前方。我去拿。"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "是的。直行。哦，结束了。"}, {"type": "subtitle", "time": 2321.61, "timestamp": "00:38:41", "text": "这里。高脚杯。"}, {"type": "subtitle", "time": 2322.71, "timestamp": "00:38:42", "text": "[音乐]"}, {"type": "subtitle", "time": 2326.15, "timestamp": "00:38:46", "text": "是的，她猎杀那只鸭子很漂亮。"}, {"type": "subtitle", "time": 2328.069, "timestamp": "00:38:48", "text": "顺便一提。我不知道是不是"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "有意或无意。哦，当然。"}, {"type": "subtitle", "time": 2335.19, "timestamp": "00:38:55", "text": "确实。还有一件事。抓住"}, {"type": "subtitle", "time": 2337.109, "timestamp": "00:38:57", "text": "在。"}]
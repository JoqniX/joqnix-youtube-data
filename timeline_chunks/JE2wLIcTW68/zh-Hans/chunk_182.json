[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "拥有很多很多。他们"}, {"type": "subtitle", "time": 10923.349, "timestamp": "03:02:03", "text": "我猜是死了。还有很多海豚"}, {"type": "subtitle", "time": 10928.469, "timestamp": "03:02:08", "text": "出色地。海豚也死了。不，"}, {"type": "subtitle", "time": 10931.51, "timestamp": "03:02:11", "text": "他们可能会死。"}, {"type": "subtitle", "time": 10934.23, "timestamp": "03:02:14", "text": "它们可能会衰老之类的。不，"}, {"type": "subtitle", "time": 10937.03, "timestamp": "03:02:17", "text": "在这个游戏中，鱼类玩家的发挥非常不稳定。"}, {"type": "subtitle", "time": 10939.91, "timestamp": "03:02:19", "text": "它不像普通的宠物。不，所以他们"}, {"type": "subtitle", "time": 10950.15, "timestamp": "03:02:30", "text": "所以这个东西可以让你……"}, {"type": "subtitle", "time": 10953.91, "timestamp": "03:02:33", "text": "秃鹰的力量基本上是快速游泳之夜"}, {"type": "subtitle", "time": 10957.03, "timestamp": "03:02:37", "text": "能见度和无限氧气"}, {"type": "subtitle", "time": 10960.55, "timestamp": "03:02:40", "text": "永远，或者就像永远一样"}, {"type": "subtitle", "time": 10963.19, "timestamp": "03:02:43", "text": "特定区域永远处于特定状态"}, {"type": "subtitle", "time": 10965.429, "timestamp": "03:02:45", "text": "区域。好的。好的。存在一个限制"}, {"type": "subtitle", "time": 10968.309, "timestamp": "03:02:48", "text": "这条管道。不。啊，你不能带走它。"}, {"type": "subtitle", "time": 10970.87, "timestamp": "03:02:50", "text": "与你。好的。你可以打破它"}, {"type": "chat", "time": 10971.687, "timestamp": "03:02:51", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "drowned with spears kill axolotl fast"}, {"type": "subtitle", "time": 10977.75, "timestamp": "03:02:57", "text": "我喜欢来这里的路上"}]
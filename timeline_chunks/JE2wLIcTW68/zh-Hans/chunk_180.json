[{"type": "subtitle", "time": 10800.71, "timestamp": "03:00:00", "text": "什么？"}, {"type": "subtitle", "time": 10802.79, "timestamp": "03:00:02", "text": "情况正在改变。"}, {"type": "subtitle", "time": 10805.59, "timestamp": "03:00:05", "text": "因为我站着，而它在移动。"}, {"type": "subtitle", "time": 10808.95, "timestamp": "03:00:08", "text": "手。所有人都站着。哦，是它"}, {"type": "subtitle", "time": 10813.19, "timestamp": "03:00:13", "text": "做。所以呢？是的。哦，确实如此。哦，我"}, {"type": "subtitle", "time": 10816.79, "timestamp": "03:00:16", "text": "我不知道。"}, {"type": "subtitle", "time": 10818.15, "timestamp": "03:00:18", "text": "来，来，来。我来给你看"}, {"type": "subtitle", "time": 10825.309, "timestamp": "03:00:25", "text": "别……别跳上去"}, {"type": "subtitle", "time": 10828.309, "timestamp": "03:00:28", "text": "那。你知道吗？不，不，不是这里。"}, {"type": "subtitle", "time": 10830.71, "timestamp": "03:00:30", "text": "这里不行。我们可以直接跳。让我"}, {"type": "subtitle", "time": 10832.75, "timestamp": "03:00:32", "text": "这样做"}, {"type": "subtitle", "time": 10843.309, "timestamp": "03:00:43", "text": "感谢关注。呃，Rich E12，"}, {"type": "subtitle", "time": 10846.23, "timestamp": "03:00:46", "text": "欢迎。 Rich，欢迎。欢迎来到"}, {"type": "subtitle", "time": 10847.91, "timestamp": "03:00:47", "text": "溪流。今天你是怎么找到我的？怎样"}, {"type": "subtitle", "time": 10856.469, "timestamp": "03:00:56", "text": "那是什么？哦，对，我会跳。哦，我"}]
[{"type": "subtitle", "time": 3360.069, "timestamp": "00:56:00", "text": "它们会损坏我们的产品。"}, {"type": "subtitle", "time": 3362.069, "timestamp": "00:56:02", "text": "哦，"}, {"type": "subtitle", "time": 3364.71, "timestamp": "00:56:04", "text": "约翰，过来一下。我找到东西了。什么"}, {"type": "subtitle", "time": 3374.23, "timestamp": "00:56:14", "text": "我就是马桶。我的天啊。"}, {"type": "subtitle", "time": 3378.23, "timestamp": "00:56:18", "text": "我将把我的智慧传授给你。"}, {"type": "subtitle", "time": 3380.87, "timestamp": "00:56:20", "text": "等等，把我冲进马桶里。在哪里？"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "冲洗？通常情况下，就是你"}, {"type": "subtitle", "time": 3392.39, "timestamp": "00:56:32", "text": "大件物品。我的天哪。我的天哪。"}, {"type": "subtitle", "time": 3396.63, "timestamp": "00:56:36", "text": "我的天啊。我们很好。我被冲走了。"}, {"type": "subtitle", "time": 3399.75, "timestamp": "00:56:39", "text": "好的。好了，我们走吧。"}, {"type": "subtitle", "time": 3415.75, "timestamp": "00:56:55", "text": "啊，这边有个大件物品。它是"}]
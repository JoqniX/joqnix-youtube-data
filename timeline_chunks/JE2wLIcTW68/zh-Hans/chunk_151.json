[{"type": "subtitle", "time": 9061.91, "timestamp": "02:31:01", "text": "成功之后，再好好审视一下自己。真是如此"}, {"type": "subtitle", "time": 9064.51, "timestamp": "02:31:04", "text": "心中涌起一股强烈的情感，"}, {"type": "subtitle", "time": 9078.27, "timestamp": "02:31:18", "text": "是的。喜欢"}, {"type": "subtitle", "time": 9083.91, "timestamp": "02:31:23", "text": "那。就是这样。嗯，另外，我……我是一个"}, {"type": "subtitle", "time": 9086.63, "timestamp": "02:31:26", "text": "有点难相处。这就是我的原因"}, {"type": "subtitle", "time": 9088.91, "timestamp": "02:31:28", "text": "不要事先委托，因为"}, {"type": "subtitle", "time": 9091.75, "timestamp": "02:31:31", "text": "因为我的薪水太高，没必要和他们一起工作。"}, {"type": "subtitle", "time": 9093.83, "timestamp": "02:31:33", "text": "我太挑剔，也太注重专业性。"}, {"type": "subtitle", "time": 9096.03, "timestamp": "02:31:36", "text": "所以，最好还是由我来做。"}, {"type": "subtitle", "time": 9099.15, "timestamp": "02:31:39", "text": "我自己而不是……"}, {"type": "subtitle", "time": 9103.389, "timestamp": "02:31:43", "text": "就像被过度收费一样"}, {"type": "subtitle", "time": 9110.99, "timestamp": "02:31:50", "text": "是的。所以，我喜欢这样做。"}]
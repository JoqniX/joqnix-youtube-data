[{"type": "subtitle", "time": 14101.269, "timestamp": "03:55:01", "text": "电雷？兄弟，看起来太酷了。"}, {"type": "subtitle", "time": 14104.309, "timestamp": "03:55:04", "text": "好吧，我们无法打败那条龙。"}, {"type": "subtitle", "time": 14105.91, "timestamp": "03:55:05", "text": "剑。对不起，请原谅我。"}, {"type": "subtitle", "time": 14108.55, "timestamp": "03:55:08", "text": "否则我可能就杀人了。所以这是"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "一条龙。它有这些柱子，"}, {"type": "subtitle", "time": 14114.07, "timestamp": "03:55:14", "text": "使其再生。然后你需要打破僵局"}, {"type": "subtitle", "time": 14117.91, "timestamp": "03:55:17", "text": "它们各自构成方块。别把它弄坏了。不，"}, {"type": "subtitle", "time": 14121.269, "timestamp": "03:55:21", "text": "然后你必须杀死它，然后你"}, {"type": "subtitle", "time": 14123.67, "timestamp": "03:55:23", "text": "就像你结束游戏一样，释放你"}, {"type": "subtitle", "time": 14126.75, "timestamp": "03:55:26", "text": "游戏玩法，但游戏的主线剧情……"}, {"type": "subtitle", "time": 14156.429, "timestamp": "03:55:56", "text": "那是什么？不要来"}]
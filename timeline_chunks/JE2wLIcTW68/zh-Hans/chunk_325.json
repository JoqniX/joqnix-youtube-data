[{"type": "subtitle", "time": 19501.788, "timestamp": "05:25:01", "text": "告诉我的奶奶，玛吉那件事"}, {"type": "subtitle", "time": 19506.47, "timestamp": "05:25:06", "text": "就像重新开始之前那样。"}, {"type": "subtitle", "time": 19509.788, "timestamp": "05:25:09", "text": "我一直觉得它就像"}, {"type": "subtitle", "time": 19512.31, "timestamp": "05:25:12", "text": "玛吉，玛吉，大概是这个名字。我"}, {"type": "subtitle", "time": 19519.03, "timestamp": "05:25:19", "text": "玛吉，玛吉。"}, {"type": "subtitle", "time": 19520.11, "timestamp": "05:25:20", "text": "是的。"}, {"type": "subtitle", "time": 19523.51, "timestamp": "05:25:23", "text": "我就像"}, {"type": "subtitle", "time": 19525.27, "timestamp": "05:25:25", "text": "听我说几句。嘿，"}, {"type": "subtitle", "time": 19527.35, "timestamp": "05:25:27", "text": "听我说"}, {"type": "subtitle", "time": 19529.43, "timestamp": "05:25:29", "text": "或者别的什么。"}, {"type": "subtitle", "time": 19531.51, "timestamp": "05:25:31", "text": "感觉俚语太多了"}, {"type": "subtitle", "time": 19534.868, "timestamp": "05:25:34", "text": "旁遮普语。每个地区都有类似的"}, {"type": "subtitle", "time": 19536.99, "timestamp": "05:25:36", "text": "不同的旁遮普语俚语。如果他们说话"}, {"type": "subtitle", "time": 19539.91, "timestamp": "05:25:39", "text": "旁遮普语就是这样。"}, {"type": "subtitle", "time": 19546.708, "timestamp": "05:25:46", "text": "所以就像，就像，本地人"}, {"type": "subtitle", "time": 19548.628, "timestamp": "05:25:48", "text": "来自旁遮普邦的旁遮普人，他们有"}, {"type": "subtitle", "time": 19552.07, "timestamp": "05:25:52", "text": "它带有不同的口音，"}, {"type": "subtitle", "time": 19554.31, "timestamp": "05:25:54", "text": "它不一样。"}, {"type": "subtitle", "time": 19557.43, "timestamp": "05:25:57", "text": "就像 dopuri 和 bihari 不一样一样。"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "比如比哈尔语就不一样了。"}]
[{"type": "subtitle", "time": 11881.269, "timestamp": "03:18:01", "text": "哦，很安全。最后。我们走吧。"}, {"type": "subtitle", "time": 11883.75, "timestamp": "03:18:03", "text": "到处都是水。我会等待。"}, {"type": "subtitle", "time": 11886.309, "timestamp": "03:18:06", "text": "我会解决这个问题。等待。"}, {"type": "subtitle", "time": 11895.429, "timestamp": "03:18:15", "text": "我重制了Zuki的图书馆装置。"}, {"type": "subtitle", "time": 11903.469, "timestamp": "03:18:23", "text": "[音乐]"}, {"type": "subtitle", "time": 11905.55, "timestamp": "03:18:25", "text": "该死。一"}, {"type": "subtitle", "time": 11908.469, "timestamp": "03:18:28", "text": "第二。是的，我有一个新的……型号"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "作品。是啊，但问题是我有"}, {"type": "subtitle", "time": 11914.59, "timestamp": "03:18:34", "text": "为了筹集资金，我必须支付费用。"}, {"type": "subtitle", "time": 11918.309, "timestamp": "03:18:38", "text": "艺术。不，这件艺术品已经完成了。我必须"}, {"type": "subtitle", "time": 11920.15, "timestamp": "03:18:40", "text": "支付修改费用和艺术费用"}, {"type": "subtitle", "time": 11925.429, "timestamp": "03:18:45", "text": "那玩意儿和……装备都很贵。不，"}, {"type": "subtitle", "time": 11927.83, "timestamp": "03:18:47", "text": "这个地方怎么样？"}, {"type": "subtitle", "time": 11930.79, "timestamp": "03:18:50", "text": "是的，我希望能够首次亮相。这"}, {"type": "subtitle", "time": 11933.229, "timestamp": "03:18:53", "text": "新型号。它真漂亮。"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "D. 它真漂亮。它真漂亮。"}]
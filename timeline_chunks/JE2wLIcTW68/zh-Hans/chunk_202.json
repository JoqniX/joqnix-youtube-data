[{"type": "subtitle", "time": 12121.19, "timestamp": "03:22:01", "text": "我的天哪。"}, {"type": "subtitle", "time": 12131.83, "timestamp": "03:22:11", "text": "好了，现在你可以去我的基地了。"}, {"type": "subtitle", "time": 12135.349, "timestamp": "03:22:15", "text": "正确的？你好。"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "他凭空消失了。等待，"}, {"type": "subtitle", "time": 12147.75, "timestamp": "03:22:27", "text": "呃，那在哪儿？我的照片呢？"}, {"type": "subtitle", "time": 12150.15, "timestamp": "03:22:30", "text": "等等，你可以上传真实照片并点赞。"}, {"type": "subtitle", "time": 12153.75, "timestamp": "03:22:33", "text": "一个框架之类的东西。是的，如果你制作一个"}, {"type": "subtitle", "time": 12168.15, "timestamp": "03:22:48", "text": "哦，我该怎么办？嗯，你知道吗？乔，"}, {"type": "subtitle", "time": 12170.469, "timestamp": "03:22:50", "text": "到我这里来。"}, {"type": "subtitle", "time": 12172.79, "timestamp": "03:22:52", "text": "伙计们，你们知道吗？最后"}, {"type": "subtitle", "time": 12174.87, "timestamp": "03:22:54", "text": "就是那个东西，对吧？"}, {"type": "subtitle", "time": 12178.389, "timestamp": "03:22:58", "text": "原计划只做两个手套。"}]
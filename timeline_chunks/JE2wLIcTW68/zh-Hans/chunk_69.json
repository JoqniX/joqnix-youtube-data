[{"type": "subtitle", "time": 4141.03, "timestamp": "01:09:01", "text": "该死。你真是个失败者，伙计。你是"}, {"type": "subtitle", "time": 4147.59, "timestamp": "01:09:07", "text": "约翰，你真是个彻头彻尾的失败者。我"}, {"type": "subtitle", "time": 4149.349, "timestamp": "01:09:09", "text": "他本想和我和平相处，结果却杀了我。"}, {"type": "subtitle", "time": 4158.149, "timestamp": "01:09:18", "text": "真够呛。"}, {"type": "subtitle", "time": 4160.789, "timestamp": "01:09:20", "text": "就像我刚才说的，跑步并没有离开他"}, {"type": "subtitle", "time": 4163.87, "timestamp": "01:09:23", "text": "头脑。是的，我不这么认为"}, {"type": "subtitle", "time": 4173.349, "timestamp": "01:09:33", "text": "哦，你可以改变颜色。好的。是的。"}, {"type": "subtitle", "time": 4179.55, "timestamp": "01:09:39", "text": "请告诉我何时开始"}, {"type": "subtitle", "time": 4183.43, "timestamp": "01:09:43", "text": "再次。准备好？"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "是的。我们走吧。你好。"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "准备好了吗？准备好了吗？是的。我是"}, {"type": "subtitle", "time": 4193.829, "timestamp": "01:09:53", "text": "我们走吧。"}, {"type": "subtitle", "time": 4195.91, "timestamp": "01:09:55", "text": "为什么我们说话像南方公园一样？"}]
[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "哦，不。好的。哦，乔克，你为什么看着"}, {"type": "subtitle", "time": 4685.189, "timestamp": "01:18:05", "text": "是吗？我看过了。是的，上面是这么说的。"}, {"type": "subtitle", "time": 4686.87, "timestamp": "01:18:06", "text": "偷窃。"}, {"type": "subtitle", "time": 4688.35, "timestamp": "01:18:08", "text": "哦，我的"}, {"type": "subtitle", "time": 4692.79, "timestamp": "01:18:12", "text": "上帝。哦，我们来提取。唱过原版歌吗？"}, {"type": "subtitle", "time": 4712.79, "timestamp": "01:18:32", "text": "哦。我的天啊。进去"}, {"type": "subtitle", "time": 4725.89, "timestamp": "01:18:45", "text": "我不知道我是怎么死的。"}]
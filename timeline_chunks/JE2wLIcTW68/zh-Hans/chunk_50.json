[{"type": "subtitle", "time": 3005.86, "timestamp": "00:50:05", "text": "我"}, {"type": "subtitle", "time": 3008.829, "timestamp": "00:50:08", "text": "[音乐]"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "什么？不，不。我需要把它用作……"}, {"type": "subtitle", "time": 3044.069, "timestamp": "00:50:44", "text": "手榴弹。这就是我不竞选的原因。"}, {"type": "subtitle", "time": 3046.39, "timestamp": "00:50:46", "text": "哦好的。哦，等等，等等，等等。哦，"}, {"type": "subtitle", "time": 3047.43, "timestamp": "00:50:47", "text": "好的。好的。给我，把那个给我。给"}, {"type": "subtitle", "time": 3051.75, "timestamp": "00:50:51", "text": "我就是那样。好了。妈的。离开"}, {"type": "subtitle", "time": 3054.109, "timestamp": "00:50:54", "text": "从战利品中。远离"}]
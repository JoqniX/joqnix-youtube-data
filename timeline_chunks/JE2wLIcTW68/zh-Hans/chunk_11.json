[{"type": "subtitle", "time": 661.15, "timestamp": "00:11:01", "text": "还有恐爱症之类的。"}, {"type": "subtitle", "time": 664.389, "timestamp": "00:11:04", "text": "是啊，他就像个V字形。"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "他就像个V。是啊，他上瘾了。"}, {"type": "subtitle", "time": 672.79, "timestamp": "00:11:12", "text": "游戏因为哦，操。哦，不。哦，是的。"}, {"type": "subtitle", "time": 675.43, "timestamp": "00:11:15", "text": "嗯，是的，当你看到当你看到"}, {"type": "subtitle", "time": 678.31, "timestamp": "00:11:18", "text": "那个老人，他看不见，但他"}, {"type": "subtitle", "time": 680.79, "timestamp": "00:11:20", "text": "他能治愈疾病，而且他的治疗非常精准。"}, {"type": "subtitle", "time": 684.949, "timestamp": "00:11:24", "text": "镜头。我的天啊。还有瞄准板。注意安全"}, {"type": "subtitle", "time": 689.35, "timestamp": "00:11:29", "text": "当他上来的时候。安静。最后输家"}, {"type": "subtitle", "time": 691.75, "timestamp": "00:11:31", "text": "站在那里。太搞笑了。你曾是"}, {"type": "subtitle", "time": 695.389, "timestamp": "00:11:35", "text": "我好像知道他做什么似的。我无法说"}, {"type": "subtitle", "time": 696.91, "timestamp": "00:11:36", "text": "任何事物。"}, {"type": "subtitle", "time": 701.75, "timestamp": "00:11:41", "text": "你起床了。我该如何起床？"}, {"type": "subtitle", "time": 704.47, "timestamp": "00:11:44", "text": "这是什么？"}, {"type": "subtitle", "time": 706.63, "timestamp": "00:11:46", "text": "是的，你们打架。"}, {"type": "subtitle", "time": 709.269, "timestamp": "00:11:49", "text": "如何？我没有枪。呃，不。你"}, {"type": "subtitle", "time": 710.63, "timestamp": "00:11:50", "text": "选择你周围的事物，就像"}, {"type": "subtitle", "time": 713.829, "timestamp": "00:11:53", "text": "你必须用来战斗的武器。"}, {"type": "subtitle", "time": 716.19, "timestamp": "00:11:56", "text": "我们一对一。"}]
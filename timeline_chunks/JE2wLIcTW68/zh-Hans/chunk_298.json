[{"type": "subtitle", "time": 17880.868, "timestamp": "04:58:00", "text": "设置它。什么？怎么会这样？呃"}, {"type": "subtitle", "time": 17885.23, "timestamp": "04:58:05", "text": "我哼着歌，就像我哼歌一样"}, {"type": "subtitle", "time": 17890.628, "timestamp": "04:58:10", "text": "我根据……创作歌词"}, {"type": "subtitle", "time": 17893.83, "timestamp": "04:58:13", "text": "它。不，一般来说，比如说我知道"}, {"type": "subtitle", "time": 17897.67, "timestamp": "04:58:17", "text": "没什么。正确的。嗯？所以你"}, {"type": "subtitle", "time": 17900.15, "timestamp": "04:58:20", "text": "伙计们首先得创作歌词，或者"}, {"type": "subtitle", "time": 17902.39, "timestamp": "04:58:22", "text": "你得先搞定音乐。如何"}, {"type": "subtitle", "time": 17909.708, "timestamp": "04:58:29", "text": "说实话，是音乐。喜欢"}, {"type": "subtitle", "time": 17912.47, "timestamp": "04:58:32", "text": "视情况而定。你其实可以写歌词"}, {"type": "subtitle", "time": 17916.15, "timestamp": "04:58:36", "text": "然后你就可以创作它了。"}, {"type": "subtitle", "time": 17918.55, "timestamp": "04:58:38", "text": "呃，你可以制作背景音乐，"}, {"type": "subtitle", "time": 17920.59, "timestamp": "04:58:40", "text": "东西"}, {"type": "subtitle", "time": 17923.91, "timestamp": "04:58:43", "text": "或者音乐听起来太多了。它是"}, {"type": "subtitle", "time": 17927.39, "timestamp": "04:58:47", "text": "只是没有节奏。它是"}, {"type": "subtitle", "time": 17931.35, "timestamp": "04:58:51", "text": "和创作一样重要。你你你"}, {"type": "subtitle", "time": 17934.43, "timestamp": "04:58:54", "text": "需要了解一些非常基础的东西"}]
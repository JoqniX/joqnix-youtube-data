[{"type": "subtitle", "time": 11585.59, "timestamp": "03:13:05", "text": "我的天啊。"}, {"type": "subtitle", "time": 11589.03, "timestamp": "03:13:09", "text": "好的。我给她拿了卫生纸。"}, {"type": "subtitle", "time": 11601.51, "timestamp": "03:13:21", "text": "好的。我的天啊。爬行者。哦，你真的这么做了吗？"}, {"type": "subtitle", "time": 11604.07, "timestamp": "03:13:24", "text": "看过《我的世界》电影吗？"}, {"type": "subtitle", "time": 11606.309, "timestamp": "03:13:26", "text": "是的，我看了，看完就离开了。"}, {"type": "subtitle", "time": 11611.51, "timestamp": "03:13:31", "text": "面试就像间隔。啊，为什么？它"}, {"type": "subtitle", "time": 11626.07, "timestamp": "03:13:46", "text": "是的，我昨天在应用程序上看了。"}, {"type": "subtitle", "time": 11629.51, "timestamp": "03:13:49", "text": "我不等了，我不知道为什么。"}, {"type": "subtitle", "time": 11632.229, "timestamp": "03:13:52", "text": "感觉像是没做完的事情。我看见"}, {"type": "subtitle", "time": 11634.51, "timestamp": "03:13:54", "text": "绿幕之类的东西。我当时就像"}, {"type": "subtitle", "time": 11637.59, "timestamp": "03:13:57", "text": "实际等待"}, {"type": "subtitle", "time": 11639.269, "timestamp": "03:13:59", "text": "这部电影是根据《我的世界》改编的。"}]
[{"type": "subtitle", "time": 16566.789, "timestamp": "04:36:06", "text": "真好。你太坏了。阿斯特拉。哦，我的"}, {"type": "subtitle", "time": 16569.429, "timestamp": "04:36:09", "text": "上帝。正确的。兄弟，我是最厉害的人。"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "我从没说过我是好人。嘿，"}, {"type": "subtitle", "time": 16576.709, "timestamp": "04:36:16", "text": "你说我可以呼吸。 Aa。那是"}, {"type": "subtitle", "time": 16578.551, "timestamp": "04:36:18", "text": "好的。那是另一边的情况。好的。"}, {"type": "subtitle", "time": 16581.189, "timestamp": "04:36:21", "text": "这是另一面。什么？什么？哦"}, {"type": "subtitle", "time": 16583.51, "timestamp": "04:36:23", "text": "是啊，我忘了。"}, {"type": "subtitle", "time": 16586.07, "timestamp": "04:36:26", "text": "工作。别介意。别担心，我可以的"}, {"type": "subtitle", "time": 16589.349, "timestamp": "04:36:29", "text": "可以得到那个。不用担心，"}, {"type": "subtitle", "time": 16597.39, "timestamp": "04:36:37", "text": "[笑声]"}, {"type": "subtitle", "time": 16599.709, "timestamp": "04:36:39", "text": "嗯，"}, {"type": "subtitle", "time": 16602.709, "timestamp": "04:36:42", "text": "好的。等待"}, {"type": "subtitle", "time": 16606.551, "timestamp": "04:36:46", "text": "他刚去世，还说了句好话。"}, {"type": "subtitle", "time": 16615.109, "timestamp": "04:36:55", "text": "好了，各位。"}]
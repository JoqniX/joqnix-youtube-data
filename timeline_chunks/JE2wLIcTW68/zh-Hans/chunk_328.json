[{"type": "subtitle", "time": 19682.47, "timestamp": "05:28:02", "text": "别叫醒我。搞什么鬼？你"}, {"type": "subtitle", "time": 19685.99, "timestamp": "05:28:05", "text": "其实还可以。你听起来真像我"}, {"type": "subtitle", "time": 19693.03, "timestamp": "05:28:13", "text": "我不知道。感觉好像要来了"}, {"type": "subtitle", "time": 19718.47, "timestamp": "05:28:38", "text": "兄弟，我不知道。我的朋友说话了。"}, {"type": "subtitle", "time": 19720.39, "timestamp": "05:28:40", "text": "典型的。他不喜欢我"}, {"type": "subtitle", "time": 19722.868, "timestamp": "05:28:42", "text": "我会说，因为我显然不会。"}, {"type": "subtitle", "time": 19730.868, "timestamp": "05:28:50", "text": "不，其实挺好的。有点像"}, {"type": "subtitle", "time": 19733.43, "timestamp": "05:28:53", "text": "准确的。我不知道。"}, {"type": "subtitle", "time": 19735.99, "timestamp": "05:28:55", "text": "我现在意识到，我说话的时候经常出错。"}, {"type": "subtitle", "time": 19739.03, "timestamp": "05:28:59", "text": "旁遮普语和汉维语有时"}]
[{"type": "subtitle", "time": 11703.51, "timestamp": "03:15:03", "text": "好吧，那我给你缠上卫生纸。"}, {"type": "subtitle", "time": 11705.59, "timestamp": "03:15:05", "text": "我该如何把卫生纸递给我？是什么？"}, {"type": "subtitle", "time": 11707.15, "timestamp": "03:15:07", "text": "命令？ TP"}, {"type": "subtitle", "time": 11709.99, "timestamp": "03:15:09", "text": "/TP 然后空格 输入名称"}, {"type": "subtitle", "time": 11713.349, "timestamp": "03:15:13", "text": "你想用 TP 攻击的人，然后是空间"}, {"type": "subtitle", "time": 11716.95, "timestamp": "03:15:16", "text": "把你的名字写在你要首先放置的人身上"}, {"type": "subtitle", "time": 11718.269, "timestamp": "03:15:18", "text": "该名称"}, {"type": "subtitle", "time": 11720.87, "timestamp": "03:15:20", "text": "像你想用TP（可能是指某种翻译或工具）的那种人"}, {"type": "subtitle", "time": 11723.11, "timestamp": "03:15:23", "text": "以及你想传送的第二个人的名字。"}, {"type": "subtitle", "time": 11725.469, "timestamp": "03:15:25", "text": "知道了。知道了。知道了。"}, {"type": "subtitle", "time": 11728.79, "timestamp": "03:15:28", "text": "你好。好的，我接到突袭任务了。一秒钟。啊，"}, {"type": "subtitle", "time": 11731.19, "timestamp": "03:15:31", "text": "你好，伊萨。感谢你们的突袭。"}, {"type": "subtitle", "time": 11732.67, "timestamp": "03:15:32", "text": "欢迎光临"}, {"type": "subtitle", "time": 11735.79, "timestamp": "03:15:35", "text": "袭击者。欢迎各位掠夺者。你好。"}, {"type": "subtitle", "time": 11740.15, "timestamp": "03:15:40", "text": "你好。我的天啊。"}, {"type": "subtitle", "time": 11743.349, "timestamp": "03:15:43", "text": "突袭之类的。那次突袭就像……"}, {"type": "subtitle", "time": 11746.469, "timestamp": "03:15:46", "text": "主播结束了她的直播。"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "对，就是Twitch上的那个直播。"}, {"type": "subtitle", "time": 11753.63, "timestamp": "03:15:53", "text": "哦，是在Twitch上。好的。好的。"}, {"type": "subtitle", "time": 11756.389, "timestamp": "03:15:56", "text": "是的。 15分钟。呃，谢谢你。"}, {"type": "subtitle", "time": 11759.63, "timestamp": "03:15:59", "text": "连续三晚。"}]
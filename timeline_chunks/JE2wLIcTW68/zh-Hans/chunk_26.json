[{"type": "subtitle", "time": 1560.549, "timestamp": "00:26:00", "text": "嘘，别买，但就像在……"}, {"type": "subtitle", "time": 1562.95, "timestamp": "00:26:02", "text": "船舶启动引擎时"}, {"type": "subtitle", "time": 1565.669, "timestamp": "00:26:05", "text": "事情发生后，开始狂按E键，然后"}, {"type": "subtitle", "time": 1567.19, "timestamp": "00:26:07", "text": "在加载画面之间，你"}, {"type": "subtitle", "time": 1570.07, "timestamp": "00:26:10", "text": "真正地吃掉它。太疯狂了。"}, {"type": "subtitle", "time": 1571.83, "timestamp": "00:26:11", "text": "好的。我还要问：你如何获得"}, {"type": "subtitle", "time": 1573.99, "timestamp": "00:26:13", "text": "如何进入阁楼？哦，是的。"}, {"type": "subtitle", "time": 1575.19, "timestamp": "00:26:15", "text": "坚持，稍等。我会为你做的。不"}, {"type": "subtitle", "time": 1577.43, "timestamp": "00:26:17", "text": "担心。我喜欢打开"}, {"type": "subtitle", "time": 1580.149, "timestamp": "00:26:20", "text": "阁楼。通常在这一侧。哦，"}, {"type": "subtitle", "time": 1584.029, "timestamp": "00:26:24", "text": "这里是。找到了。好的。送我上去。"}, {"type": "subtitle", "time": 1589.11, "timestamp": "00:26:29", "text": "所以，不。不，送我上去。送我上去。"}, {"type": "subtitle", "time": 1591.11, "timestamp": "00:26:31", "text": "好的。上架"}, {"type": "subtitle", "time": 1594.47, "timestamp": "00:26:34", "text": "好的。是的。好了。等待。"}, {"type": "subtitle", "time": 1597.51, "timestamp": "00:26:37", "text": "等待。算了。算了。是的。他让"}, {"type": "subtitle", "time": 1604.07, "timestamp": "00:26:44", "text": "好的。好的。你有什么？哦，"}, {"type": "subtitle", "time": 1605.43, "timestamp": "00:26:45", "text": "那里。哦，东西真多。我"}, {"type": "subtitle", "time": 1607.35, "timestamp": "00:26:47", "text": "也就是说，有两个。有手榴弹吗？"}, {"type": "subtitle", "time": 1609.19, "timestamp": "00:26:49", "text": "盒？我可以要那个吗？两者都有。"}, {"type": "subtitle", "time": 1612.31, "timestamp": "00:26:52", "text": "这里有一颗普通的人体手榴弹和一个"}, {"type": "subtitle", "time": 1615.43, "timestamp": "00:26:55", "text": "手榴弹。两者都是"}, {"type": "subtitle", "time": 1618.63, "timestamp": "00:26:58", "text": "我的天哪。"}]
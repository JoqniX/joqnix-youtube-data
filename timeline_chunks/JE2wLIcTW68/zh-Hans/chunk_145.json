[{"type": "subtitle", "time": 8700.389, "timestamp": "02:25:00", "text": "正确的。她不是。等等，她结束了吗？"}, {"type": "subtitle", "time": 8701.309, "timestamp": "02:25:01", "text": "她"}, {"type": "subtitle", "time": 8706.95, "timestamp": "02:25:06", "text": "萨巴顿？哦，她确实这么做了。哦，她确实这么做了。哦。"}, {"type": "subtitle", "time": 8709.389, "timestamp": "02:25:09", "text": "哦是的。她五年"}, {"type": "subtitle", "time": 8713.55, "timestamp": "02:25:13", "text": "周年纪念日。等等，是吗？"}, {"type": "subtitle", "time": 8715.309, "timestamp": "02:25:15", "text": "超过？"}, {"type": "subtitle", "time": 8719.11, "timestamp": "02:25:19", "text": "嗯？结束了。哦，是的。所以，她做了"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "萨巴顿乐队。这五位都是五位。"}, {"type": "subtitle", "time": 8725.19, "timestamp": "02:25:25", "text": "周年纪念缎子。好的。所以，当"}, {"type": "subtitle", "time": 8727.83, "timestamp": "02:25:27", "text": "她以前在YouTube上做过，看起来"}, {"type": "subtitle", "time": 8730.309, "timestamp": "02:25:30", "text": "像这样。她放了一个单数"}, {"type": "subtitle", "time": 8732.349, "timestamp": "02:25:32", "text": "缩略图"}, {"type": "subtitle", "time": 8734.71, "timestamp": "02:25:34", "text": "一切都对吧？"}, {"type": "subtitle", "time": 8736.95, "timestamp": "02:25:36", "text": "就是这样。所以我就想，“哦，所以这"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "这样做没问题。”然后就一直如此"}, {"type": "subtitle", "time": 8741.349, "timestamp": "02:25:41", "text": "然后，她不得不停止这样做。"}, {"type": "subtitle", "time": 8743.67, "timestamp": "02:25:43", "text": "现在用 YouTube 有点麻烦。"}, {"type": "subtitle", "time": 8746.71, "timestamp": "02:25:46", "text": "只需每隔 11 小时设置一次直播，50"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "呃，45分钟，你得剪掉"}, {"type": "subtitle", "time": 8749.75, "timestamp": "02:25:49", "text": "直播并创建一个新的直播流"}, {"type": "subtitle", "time": 8751.95, "timestamp": "02:25:51", "text": "一切都对吧？这真是太……"}, {"type": "subtitle", "time": 8754.55, "timestamp": "02:25:54", "text": "麻烦。有些创作者不想这样做"}, {"type": "subtitle", "time": 8756.63, "timestamp": "02:25:56", "text": "那太麻烦了"}]
[{"type": "subtitle", "time": 11820.71, "timestamp": "03:17:00", "text": "嗯，是的，我们正在进行一场马拉松活动，那就是"}, {"type": "subtitle", "time": 11824.269, "timestamp": "03:17:04", "text": "就像我一样。我的天啊。"}, {"type": "subtitle", "time": 11827.51, "timestamp": "03:17:07", "text": "爬行者。嗯，我就像在尝试……"}, {"type": "subtitle", "time": 11830.389, "timestamp": "03:17:10", "text": "为我的新模型筹集资金。是的。"}, {"type": "subtitle", "time": 11836.389, "timestamp": "03:17:16", "text": "等等，你不需要订阅。它是"}, {"type": "subtitle", "time": 11843.07, "timestamp": "03:17:23", "text": "没关系。"}, {"type": "subtitle", "time": 11846.79, "timestamp": "03:17:26", "text": "是啊，但我不知道你想要什么。"}, {"type": "subtitle", "time": 11850.55, "timestamp": "03:17:30", "text": "得到。难道我不会得到什么特别的东西吗？"}, {"type": "subtitle", "time": 11853.349, "timestamp": "03:17:33", "text": "我能得到什么？我的天啊。你是什​​么"}, {"type": "subtitle", "time": 11860.63, "timestamp": "03:17:40", "text": "呃，我现在什么都没有。我"}, {"type": "subtitle", "time": 11863.469, "timestamp": "03:17:43", "text": "想做一些定制的东西，比如"}, {"type": "subtitle", "time": 11865.83, "timestamp": "03:17:45", "text": "壁纸日历。当你这样做的时候，"}, {"type": "subtitle", "time": 11867.429, "timestamp": "03:17:47", "text": "你那样做的时候，我就会订阅。"}, {"type": "subtitle", "time": 11870.15, "timestamp": "03:17:50", "text": "他们。是的。"}, {"type": "subtitle", "time": 11872.469, "timestamp": "03:17:52", "text": "是的。一旦我拿到新模型，我就会……"}]
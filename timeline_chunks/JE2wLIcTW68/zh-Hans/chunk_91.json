[{"type": "subtitle", "time": 5463.8, "timestamp": "01:31:03", "text": "不是。他正在做最后的准备。"}, {"type": "subtitle", "time": 5468.669, "timestamp": "01:31:08", "text": "那里我们"}, {"type": "subtitle", "time": 5472.03, "timestamp": "01:31:12", "text": "去。男孩们是"}, {"type": "subtitle", "time": 5476.47, "timestamp": "01:31:16", "text": "后退。嘿，我们走吧。当然。现在我们"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "得到了"}, {"type": "subtitle", "time": 5483.189, "timestamp": "01:31:23", "text": "即使疲惫不堪。是啊，我知道，对吧？等待，"}, {"type": "subtitle", "time": 5489.35, "timestamp": "01:31:29", "text": "我是一台HP。我的天啊。哦，我可以做80个。"}, {"type": "subtitle", "time": 5497.59, "timestamp": "01:31:37", "text": "他妈的。好的。好的。耶稣。我给你"}, {"type": "subtitle", "time": 5501.43, "timestamp": "01:31:41", "text": "回来了，兄弟。谢谢。你是什​​么意思？"}, {"type": "subtitle", "time": 5504.189, "timestamp": "01:31:44", "text": "什么？"}, {"type": "subtitle", "time": 5508.39, "timestamp": "01:31:48", "text": "好的。我喜欢我再次喜欢的方式"}, {"type": "subtitle", "time": 5510.87, "timestamp": "01:31:50", "text": "在断开连接之前，洋子留下了一个令人震惊的消息。"}, {"type": "subtitle", "time": 5518.55, "timestamp": "01:31:58", "text": "是的。顺便说一句，伙计们还在呢。"}]
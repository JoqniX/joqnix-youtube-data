[{"type": "subtitle", "time": 1082.71, "timestamp": "00:18:02", "text": "上帝。我的天啊。我就说这么多。"}, {"type": "subtitle", "time": 1088.83, "timestamp": "00:18:08", "text": "哦，天哪。跑步。"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "跑步。别拿这张卡"}, {"type": "subtitle", "time": 1094.789, "timestamp": "00:18:14", "text": "与你。就让它待在那里吧。"}, {"type": "subtitle", "time": 1105.71, "timestamp": "00:18:25", "text": "我就是一堵墙。我就是一堵墙。我不是"}, {"type": "subtitle", "time": 1108.63, "timestamp": "00:18:28", "text": "一。我只不过是一堵墙而已。我，我是一个"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "墙。我是一堵墙。我是一堵墙。我是一名"}, {"type": "subtitle", "time": 1126.47, "timestamp": "00:18:46", "text": "未来。我是一堵墙。我是一堵墙。我是一名"}, {"type": "subtitle", "time": 1128.63, "timestamp": "00:18:48", "text": "墙。我是一堵墙。我一无是处。我是一名"}, {"type": "subtitle", "time": 1130.789, "timestamp": "00:18:50", "text": "我就是一堵墙。我是一块砖头。我已完成"}]
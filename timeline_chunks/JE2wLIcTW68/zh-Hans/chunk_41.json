[{"type": "subtitle", "time": 2461.589, "timestamp": "00:41:01", "text": "我对这种药水简直欲罢不能。哦，我的"}, {"type": "subtitle", "time": 2464.829, "timestamp": "00:41:04", "text": "天哪，他竟然得到了药水。"}, {"type": "subtitle", "time": 2472.349, "timestamp": "00:41:12", "text": "等等，等等，等等。嘿"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "哟，你看"}, {"type": "subtitle", "time": 2482.55, "timestamp": "00:41:22", "text": "呃，它让你对……产生感情。"}, {"type": "subtitle", "time": 2485.99, "timestamp": "00:41:25", "text": "其他的。好了，各位。大家快跑"}, {"type": "subtitle", "time": 2488.23, "timestamp": "00:41:28", "text": "在船上，你们说着浪漫的话。"}, {"type": "subtitle", "time": 2489.589, "timestamp": "00:41:29", "text": "等等，等等。大家快跑！"}, {"type": "subtitle", "time": 2492.309, "timestamp": "00:41:32", "text": "那艘船。我会在那里。对，快跑。"}, {"type": "subtitle", "time": 2493.829, "timestamp": "00:41:33", "text": "跑就行了。"}, {"type": "subtitle", "time": 2517.23, "timestamp": "00:41:57", "text": "等待。我死了吗？对不起。"}]
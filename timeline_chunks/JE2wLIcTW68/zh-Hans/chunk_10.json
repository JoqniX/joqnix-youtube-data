[{"type": "subtitle", "time": 601.35, "timestamp": "00:10:01", "text": "我觉得那家伙是瞎子，而且如果"}, {"type": "subtitle", "time": 604.15, "timestamp": "00:10:04", "text": "你试图发出噪音，他就杀了你。我"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "思考。我不知道。"}, {"type": "subtitle", "time": 610.07, "timestamp": "00:10:10", "text": "哦真的吗？现在不行。是的。"}, {"type": "subtitle", "time": 612.31, "timestamp": "00:10:12", "text": "哦，如果你拿到他的头，他就能复活。"}, {"type": "subtitle", "time": 614.15, "timestamp": "00:10:14", "text": "或者别的什么。"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "我也这么认为。是的。哇。"}, {"type": "subtitle", "time": 620.87, "timestamp": "00:10:20", "text": "太酷了！"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "是的，那是其中一种怪物类型。"}, {"type": "subtitle", "time": 624.069, "timestamp": "00:10:24", "text": "我觉得他不应该在这里。"}, {"type": "subtitle", "time": 626.71, "timestamp": "00:10:26", "text": "这么早。"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "是孵化场，对吧？哦，罗科想加入"}, {"type": "subtitle", "time": 631.75, "timestamp": "00:10:31", "text": "我们。罗科也想加入。他可能想要"}, {"type": "subtitle", "time": 633.269, "timestamp": "00:10:33", "text": "加入我们。是是是，当然是，当然。哦，"}, {"type": "subtitle", "time": 636.71, "timestamp": "00:10:36", "text": "是的。是的，他可以。他可以。是的，就是这样。"}, {"type": "subtitle", "time": 639.35, "timestamp": "00:10:39", "text": "打开。看看服务器上的东西。我"}, {"type": "subtitle", "time": 641.269, "timestamp": "00:10:41", "text": "我觉得他……是啊，是啊，是啊。我认为他"}, {"type": "subtitle", "time": 647.91, "timestamp": "00:10:47", "text": "我觉得Roco很擅长恐怖游戏。"}, {"type": "subtitle", "time": 651.19, "timestamp": "00:10:51", "text": "现在。他是恐鬼症专家。"}, {"type": "subtitle", "time": 656.15, "timestamp": "00:10:56", "text": "是的。是的。是的。或者我可以进行软重启。"}, {"type": "subtitle", "time": 657.91, "timestamp": "00:10:57", "text": "那才叫男人。那个人疯了"}]
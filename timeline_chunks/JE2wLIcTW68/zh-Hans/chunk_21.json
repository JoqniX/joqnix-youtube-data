[{"type": "subtitle", "time": 1265.83, "timestamp": "00:21:05", "text": "我快疯了。我能看出来。"}, {"type": "subtitle", "time": 1283.68, "timestamp": "00:21:23", "text": "哦，她来了。"}, {"type": "subtitle", "time": 1295.029, "timestamp": "00:21:35", "text": "哦，瞧。这是什么？"}, {"type": "subtitle", "time": 1297.43, "timestamp": "00:21:37", "text": "哦，那可真难。好的，MJ。是"}, {"type": "subtitle", "time": 1298.95, "timestamp": "00:21:38", "text": "我就把购物车放这儿了，因为"}, {"type": "subtitle", "time": 1301.029, "timestamp": "00:21:41", "text": "就像我们已经拥有的比我们拥有的还要多一样"}, {"type": "subtitle", "time": 1303.43, "timestamp": "00:21:43", "text": "既然有需要，我们不妨尝试一下。"}, {"type": "subtitle", "time": 1307.75, "timestamp": "00:21:47", "text": "而且我们还能获得额外的利润。"}, {"type": "subtitle", "time": 1310.549, "timestamp": "00:21:50", "text": "好的。就像，就像，呃，那是什么？"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "还有其他游戏吗？呃，致命公司，你知道的。"}, {"type": "subtitle", "time": 1317.35, "timestamp": "00:21:57", "text": "哦，致命的。好的。好的。是啊，我的头"}, {"type": "subtitle", "time": 1319.75, "timestamp": "00:21:59", "text": "疼。先生，您应该躺下。喝"}]
[{"type": "subtitle", "time": 13323.429, "timestamp": "03:42:03", "text": "让它再来一次。"}, {"type": "subtitle", "time": 13327.03, "timestamp": "03:42:07", "text": "那是什么声音？哦，天哪，就是这样。"}, {"type": "subtitle", "time": 13329.19, "timestamp": "03:42:09", "text": "在熔岩中。"}, {"type": "subtitle", "time": 13332.07, "timestamp": "03:42:12", "text": "你身处熔岩之中。我是国王"}, {"type": "subtitle", "time": 13358.469, "timestamp": "03:42:38", "text": "所以，在这里，你就能得到一些东西。"}, {"type": "subtitle", "time": 13362.309, "timestamp": "03:42:42", "text": "比钻石更坚硬。金下界矿。"}, {"type": "subtitle", "time": 13366.15, "timestamp": "03:42:46", "text": "是的。我现在给你的盔甲。"}, {"type": "subtitle", "time": 13378.349, "timestamp": "03:42:58", "text": "机器。我的天啊。"}]
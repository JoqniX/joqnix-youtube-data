[{"type": "subtitle", "time": 13394.87, "timestamp": "03:43:14", "text": "等等，这里有个法师吗？"}, {"type": "subtitle", "time": 13402.469, "timestamp": "03:43:22", "text": "瞧，我这就给你演示。把那个蝴蝶结拿出来"}, {"type": "subtitle", "time": 13404.87, "timestamp": "03:43:24", "text": "它能让你在水上行走。它不"}, {"type": "subtitle", "time": 13408.429, "timestamp": "03:43:28", "text": "让你在熔岩上行走。"}, {"type": "subtitle", "time": 13411.75, "timestamp": "03:43:31", "text": "什么？真的吗？"}, {"type": "subtitle", "time": 13416.67, "timestamp": "03:43:36", "text": "哦，"}, {"type": "subtitle", "time": 13418.51, "timestamp": "03:43:38", "text": "哇。这"}, {"type": "subtitle", "time": 13435.99, "timestamp": "03:43:55", "text": "我是克隆人吗？"}]
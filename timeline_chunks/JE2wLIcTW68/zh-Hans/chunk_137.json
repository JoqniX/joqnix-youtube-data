[{"type": "subtitle", "time": 8221.589, "timestamp": "02:17:01", "text": "了解准社会主义是什么，直到……"}, {"type": "subtitle", "time": 8223.27, "timestamp": "02:17:03", "text": "直到"}, {"type": "subtitle", "time": 8225.11, "timestamp": "02:17:05", "text": "呃，等等，我甚至不知道我是"}, {"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "亲身经历过。我当时想，我没有"}, {"type": "subtitle", "time": 8230.95, "timestamp": "02:17:10", "text": "知道。是的。直到我……一个朋友"}, {"type": "subtitle", "time": 8233.75, "timestamp": "02:17:13", "text": "我的家人跟我说过这件事。哦，这是这个"}, {"type": "subtitle", "time": 8237.429, "timestamp": "02:17:17", "text": "这种常见的情况等等。然后"}, {"type": "subtitle", "time": 8240.629, "timestamp": "02:17:20", "text": "我在推特上看到了一些风波。我的天啊。"}, {"type": "subtitle", "time": 8243.509, "timestamp": "02:17:23", "text": "VTuber 的推特世界简直太疯狂了。每一个"}, {"type": "subtitle", "time": 8246.11, "timestamp": "02:17:26", "text": "单次。剧情"}, {"type": "subtitle", "time": 8249.07, "timestamp": "02:17:29", "text": "剧情 剧情 剧情"}, {"type": "subtitle", "time": 8255.91, "timestamp": "02:17:35", "text": "那。你在计划你的……嗯"}, {"type": "subtitle", "time": 8258.629, "timestamp": "02:17:38", "text": "你是那种想成为 YouTuber 的人吗？"}, {"type": "subtitle", "time": 8261.75, "timestamp": "02:17:41", "text": "就像你正计划出道做准备一样"}, {"type": "subtitle", "time": 8271.349, "timestamp": "02:17:51", "text": "一切？明天的直播将是"}]
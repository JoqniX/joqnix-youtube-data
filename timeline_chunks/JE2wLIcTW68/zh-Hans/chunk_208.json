[{"type": "subtitle", "time": 12483.07, "timestamp": "03:28:03", "text": "这里的问题很有技巧性。"}, {"type": "subtitle", "time": 12489.51, "timestamp": "03:28:09", "text": "什么是冒险模式？"}, {"type": "subtitle", "time": 12492.71, "timestamp": "03:28:12", "text": "呃，它会让你穿过去，但是"}, {"type": "subtitle", "time": 12501.19, "timestamp": "03:28:21", "text": "啊兄弟，如果我现在再次成为神，我会……"}, {"type": "subtitle", "time": 12502.11, "timestamp": "03:28:22", "text": "杀"}, {"type": "subtitle", "time": 12509.19, "timestamp": "03:28:29", "text": "你知道吗？我单手就能杀了你。"}, {"type": "subtitle", "time": 12511.67, "timestamp": "03:28:31", "text": "那"}, {"type": "subtitle", "time": 12514.91, "timestamp": "03:28:34", "text": "好的，乔，我给你看点东西。"}, {"type": "subtitle", "time": 12524.51, "timestamp": "03:28:44", "text": "屏幕即时"}, {"type": "subtitle", "time": 12528.87, "timestamp": "03:28:48", "text": "出去。那是什么？如何？"}, {"type": "subtitle", "time": 12531.91, "timestamp": "03:28:51", "text": "那是我获得的一种强化道具。看？来"}, {"type": "subtitle", "time": 12534.07, "timestamp": "03:28:54", "text": "回到“别杀我”那一集。来"}, {"type": "subtitle", "time": 12538.269, "timestamp": "03:28:58", "text": "回归正常的生存状态。"}, {"type": "subtitle", "time": 12539.45, "timestamp": "03:28:59", "text": "好的。"}]
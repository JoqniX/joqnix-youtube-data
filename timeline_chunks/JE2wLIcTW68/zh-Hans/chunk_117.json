[{"type": "subtitle", "time": 7031.589, "timestamp": "01:57:11", "text": "框架。好的，让我来做这件事。"}, {"type": "subtitle", "time": 7034.629, "timestamp": "01:57:14", "text": "今天。呃，然后收拾东西睡觉吧。"}, {"type": "subtitle", "time": 7037.109, "timestamp": "01:57:17", "text": "我们明天见。第25天是"}, {"type": "subtitle", "time": 7051.43, "timestamp": "01:57:31", "text": "日志？飞机报告。这就是今天的"}, {"type": "subtitle", "time": 7052.83, "timestamp": "01:57:32", "text": "溪流。好的。好的。"}, {"type": "subtitle", "time": 7061.95, "timestamp": "01:57:41", "text": "好的。呃，加入一个"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "分线器。如何分割棋盘。我是否"}, {"type": "subtitle", "time": 7069.149, "timestamp": "01:57:49", "text": "昨天就分开了？让我加倍"}, {"type": "subtitle", "time": 7073.83, "timestamp": "01:57:53", "text": "查看。呃，这是25。25一次就已经是了。"}, {"type": "subtitle", "time": 7076.91, "timestamp": "01:57:56", "text": "呃，已经发布了，对吧？是的。"}]
[{"type": "subtitle", "time": 3300.15, "timestamp": "00:55:00", "text": "等等，我们不能用这种提取方法。"}, {"type": "subtitle", "time": 3301.67, "timestamp": "00:55:01", "text": "观点。"}, {"type": "subtitle", "time": 3302.95, "timestamp": "00:55:02", "text": "不，我们得找一个新的。某人"}, {"type": "subtitle", "time": 3304.63, "timestamp": "00:55:04", "text": "随身携带这张卡。我会找到新的罐子"}, {"type": "subtitle", "time": 3307.51, "timestamp": "00:55:07", "text": "请给我们10点马力好吗？哦，"}, {"type": "subtitle", "time": 3309.349, "timestamp": "00:55:09", "text": "好的。就像按住按钮一样"}, {"type": "subtitle", "time": 3310.99, "timestamp": "00:55:10", "text": "这"}, {"type": "subtitle", "time": 3314.47, "timestamp": "00:55:14", "text": "生成。好了，我做完了。"}, {"type": "subtitle", "time": 3316.15, "timestamp": "00:55:16", "text": "谁还需要经验值？它不会"}, {"type": "subtitle", "time": 3319.069, "timestamp": "00:55:19", "text": "帮我。好的，我要走了"}, {"type": "subtitle", "time": 3321.43, "timestamp": "00:55:21", "text": "抢劫。我会找到的，我会找到的"}, {"type": "subtitle", "time": 3323.67, "timestamp": "00:55:23", "text": "提炼。听起来不错。我心想。是的，"}, {"type": "subtitle", "time": 3326.63, "timestamp": "00:55:26", "text": "那很好。另外，也带上这个。"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "谢谢。好的。你还需要一个"}, {"type": "subtitle", "time": 3331.91, "timestamp": "00:55:31", "text": "惠普。当心。是啊，我正需要一个。"}, {"type": "subtitle", "time": 3333.47, "timestamp": "00:55:33", "text": "好的，我们需要做一些"}, {"type": "subtitle", "time": 3335.75, "timestamp": "00:55:35", "text": "空间。小矮人。杀死小矮人。感谢"}, {"type": "subtitle", "time": 3339.27, "timestamp": "00:55:39", "text": "你。哦，小矮人。"}, {"type": "subtitle", "time": 3340.95, "timestamp": "00:55:40", "text": "还会有更多。哦，还有"}, {"type": "subtitle", "time": 3343.109, "timestamp": "00:55:43", "text": "肯定会更多。好的，"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "我在这里。好的，请跟随。哦，在你身后。"}, {"type": "subtitle", "time": 3347.589, "timestamp": "00:55:47", "text": "你身后。工作。你已经摆脱了那份工作。杀"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "小矮人们。拿起来就打。"}, {"type": "subtitle", "time": 3352.309, "timestamp": "00:55:52", "text": "把他们打倒在地。他们会来找你吗？"}]
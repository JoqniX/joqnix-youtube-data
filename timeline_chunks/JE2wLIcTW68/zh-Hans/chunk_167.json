[{"type": "subtitle", "time": 10032.269, "timestamp": "02:47:12", "text": "你好。我做了当东道主的事"}, {"type": "subtitle", "time": 10035.75, "timestamp": "02:47:15", "text": "今天。我可以给你展示一些很酷的东西。我"}, {"type": "subtitle", "time": 10039.429, "timestamp": "02:47:19", "text": "今天客串了一下主持人。"}, {"type": "subtitle", "time": 10048.11, "timestamp": "02:47:28", "text": "选择。等等，我可以展示我"}, {"type": "subtitle", "time": 10051.309, "timestamp": "02:47:31", "text": "我今天玩了游戏屋。"}, {"type": "subtitle", "time": 10055.309, "timestamp": "02:47:35", "text": "好吧，我完全不知道该怎么办了。"}, {"type": "subtitle", "time": 10058.429, "timestamp": "02:47:38", "text": "做。嗯"}, {"type": "subtitle", "time": 10061.91, "timestamp": "02:47:41", "text": "选择 D 之后是什么？什么是"}, {"type": "subtitle", "time": 10065.03, "timestamp": "02:47:45", "text": "新锻造？我想试试这些。"}, {"type": "subtitle", "time": 10067.83, "timestamp": "02:47:47", "text": "还有其他一些东西。"}, {"type": "subtitle", "time": 10073.389, "timestamp": "02:47:53", "text": "虽然是插件。"}, {"type": "subtitle", "time": 10076.349, "timestamp": "02:47:56", "text": "纸织物"}, {"type": "subtitle", "time": 10079.67, "timestamp": "02:47:59", "text": "锻造。所以，呃，毁灭的诞生是"}]
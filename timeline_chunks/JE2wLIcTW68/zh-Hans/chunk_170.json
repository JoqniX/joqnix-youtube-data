[{"type": "subtitle", "time": 10211.03, "timestamp": "02:50:11", "text": "F锻造模具和织物。他们俩"}, {"type": "subtitle", "time": 10223.59, "timestamp": "02:50:23", "text": "已支持。什么是aruka？"}, {"type": "subtitle", "time": 10225.63, "timestamp": "02:50:25", "text": "什么是"}, {"type": "subtitle", "time": 10229.71, "timestamp": "02:50:29", "text": "速度？这些就像旧版本一样，我"}, {"type": "subtitle", "time": 10233.55, "timestamp": "02:50:33", "text": "猜测。瀑布。真是"}, {"type": "subtitle", "time": 10235.309, "timestamp": "02:50:35", "text": "姓名。"}, {"type": "subtitle", "time": 10239.23, "timestamp": "02:50:39", "text": "好的。这些就像"}, {"type": "subtitle", "time": 10257.469, "timestamp": "02:50:57", "text": "有趣的。必须等它……"}]
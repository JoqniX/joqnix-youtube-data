[{"type": "subtitle", "time": 18003.75, "timestamp": "05:00:03", "text": "哦，压缩。好的。呃呃呃"}, {"type": "subtitle", "time": 18008.27, "timestamp": "05:00:08", "text": "它的组成可以告诉你"}, {"type": "subtitle", "time": 18011.35, "timestamp": "05:00:11", "text": "那它叫什么来着？符号。"}, {"type": "subtitle", "time": 18013.27, "timestamp": "05:00:13", "text": "无论你唱什么，它都可能像"}, {"type": "subtitle", "time": 18016.868, "timestamp": "05:00:16", "text": "检测其符号。哦，你做了FL"}, {"type": "subtitle", "time": 18018.19, "timestamp": "05:00:18", "text": "现在开机了。所以，"}, {"type": "subtitle", "time": 18021.43, "timestamp": "05:00:21", "text": "如果我没记错的话，爱迪生和牛顿"}, {"type": "subtitle", "time": 18023.59, "timestamp": "05:00:23", "text": "插件。啊，"}, {"type": "subtitle", "time": 18029.43, "timestamp": "05:00:29", "text": "我也这么认为。我的天哪，我好想念E Studio。"}, {"type": "subtitle", "time": 18031.67, "timestamp": "05:00:31", "text": "你知道吗，有趣的是，我买了"}, {"type": "subtitle", "time": 18034.628, "timestamp": "05:00:34", "text": "E Studio 和 I 的终极版"}, {"type": "subtitle", "time": 18038.47, "timestamp": "05:00:38", "text": "别无选择，我只好用Ableton了。"}, {"type": "subtitle", "time": 18041.35, "timestamp": "05:00:41", "text": "现场音乐制作课程。所以"}, {"type": "subtitle", "time": 18044.47, "timestamp": "05:00:44", "text": "我必须向工作室彻底坦白一切。"}, {"type": "subtitle", "time": 18047.99, "timestamp": "05:00:47", "text": "购买 Ableton Live。"}, {"type": "subtitle", "time": 18051.27, "timestamp": "05:00:51", "text": "哇。我们过去常常使用裂缝"}, {"type": "subtitle", "time": 18055.03, "timestamp": "05:00:55", "text": "版本。相同的。我也是。"}, {"type": "subtitle", "time": 18057.35, "timestamp": "05:00:57", "text": "我电脑里还装着破解版的FL Studio。"}]
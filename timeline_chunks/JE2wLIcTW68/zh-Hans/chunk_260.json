[{"type": "subtitle", "time": 15605.75, "timestamp": "04:20:05", "text": "哦，对了，阿斯塔……阿斯塔说"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "他血液甜美。你能试试吗？"}, {"type": "subtitle", "time": 15610.83, "timestamp": "04:20:10", "text": "把他哄上去？好吧，绝不"}, {"type": "subtitle", "time": 15615.229, "timestamp": "04:20:15", "text": "头脑。伙计们，别听他们的。"}, {"type": "subtitle", "time": 15626.03, "timestamp": "04:20:26", "text": "我什么也没说。我说"}, {"type": "subtitle", "time": 15629.11, "timestamp": "04:20:29", "text": "没有什么。你是什​​么意思？"}, {"type": "subtitle", "time": 15631.67, "timestamp": "04:20:31", "text": "你为什么跟在我后面？别杀我"}, {"type": "subtitle", "time": 15634.71, "timestamp": "04:20:34", "text": "因为我想，我想，谁偷了我的"}, {"type": "subtitle", "time": 15637.83, "timestamp": "04:20:37", "text": "裤子？裤子？"}, {"type": "subtitle", "time": 15645.71, "timestamp": "04:20:45", "text": "我还有多余的一双。不用担心。"}]
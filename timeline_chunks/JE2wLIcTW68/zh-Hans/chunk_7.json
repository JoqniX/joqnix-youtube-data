[{"type": "subtitle", "time": 429.67, "timestamp": "00:07:09", "text": "哟，走吧，兄弟。当然。等待，"}, {"type": "subtitle", "time": 433.189, "timestamp": "00:07:13", "text": "它上面写着“呃，比如它”吗？"}, {"type": "subtitle", "time": 442.909, "timestamp": "00:07:22", "text": "并不真地。不，你可以看到某种程度的"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "好的。"}, {"type": "subtitle", "time": 446.35, "timestamp": "00:07:26", "text": "你刚才就是这么做的。"}, {"type": "subtitle", "time": 449.27, "timestamp": "00:07:29", "text": "它。我的天啊。好了，我们走吧。开始"}, {"type": "subtitle", "time": 451.189, "timestamp": "00:07:31", "text": "游戏。"}, {"type": "subtitle", "time": 458.23, "timestamp": "00:07:38", "text": "哦，所以你可以在加载过程中说话。"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "顺便提一下，是屏幕。哦，不错。哦，该死"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "是的。我们走吧。领头人，伙计。"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "我猜的。哦，是的。所以，乔，这是"}, {"type": "subtitle", "time": 469.99, "timestamp": "00:07:49", "text": "你可以做一件很酷的事。好的。什么时候"}, {"type": "subtitle", "time": 471.35, "timestamp": "00:07:51", "text": "你上下打量，它会让你向上倾斜。"}, {"type": "subtitle", "time": 472.71, "timestamp": "00:07:52", "text": "向下，就像你有文字一样"}]
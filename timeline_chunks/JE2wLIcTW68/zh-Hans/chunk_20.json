[{"type": "subtitle", "time": 1205.19, "timestamp": "00:20:05", "text": "是的。他正上楼来。我们很好。"}, {"type": "subtitle", "time": 1209.75, "timestamp": "00:20:09", "text": "我们正在放松。艾登。艾登。"}, {"type": "subtitle", "time": 1210.909, "timestamp": "00:20:10", "text": "哦"}, {"type": "subtitle", "time": 1215.43, "timestamp": "00:20:15", "text": "上帝。哦，她现在缠着我了。好的。这"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "感觉就像《小小梦魇》或者"}, {"type": "subtitle", "time": 1220.95, "timestamp": "00:20:20", "text": "某物。确实如此。哦，是的。确实如此。"}, {"type": "subtitle", "time": 1223.83, "timestamp": "00:20:23", "text": "正确的？"}, {"type": "subtitle", "time": 1226.19, "timestamp": "00:20:26", "text": "我从来没玩过那个游戏。"}, {"type": "subtitle", "time": 1228.029, "timestamp": "00:20:28", "text": "方式。说"}, {"type": "subtitle", "time": 1238.95, "timestamp": "00:20:38", "text": "她又进房间了吗？"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "决不。正确的。不，不，她太过分了。"}, {"type": "subtitle", "time": 1243.11, "timestamp": "00:20:43", "text": "她走路时不说话吗？就像她"}, {"type": "subtitle", "time": 1244.39, "timestamp": "00:20:44", "text": "未激活，她不会生成任何内容"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "噪音。我的天哪。"}, {"type": "subtitle", "time": 1249.149, "timestamp": "00:20:49", "text": "那是"}, {"type": "subtitle", "time": 1253.19, "timestamp": "00:20:53", "text": "伤心。坏消息。"}, {"type": "subtitle", "time": 1255.51, "timestamp": "00:20:55", "text": "我们下去吗？别说那种话。"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "聊天。你在输入什么？我不"}]
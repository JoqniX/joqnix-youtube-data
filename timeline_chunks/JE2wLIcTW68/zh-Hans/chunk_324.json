[{"type": "subtitle", "time": 19441.43, "timestamp": "05:24:01", "text": "是的。是的。是的。捣蛋鬼。"}, {"type": "subtitle", "time": 19479.35, "timestamp": "05:24:39", "text": "哦，你的口音很地道吗？"}, {"type": "subtitle", "time": 19481.59, "timestamp": "05:24:41", "text": "兄弟，我有一半旁遮普血统。你是什​​么"}, {"type": "subtitle", "time": 19485.83, "timestamp": "05:24:45", "text": "意思是？哦，我的奶奶说旁遮普语"}, {"type": "subtitle", "time": 19487.35, "timestamp": "05:24:47", "text": "适当地。"}, {"type": "subtitle", "time": 19490.15, "timestamp": "05:24:50", "text": "哦，不。我母亲那边的亲戚会说话。"}, {"type": "subtitle", "time": 19492.07, "timestamp": "05:24:52", "text": "旁遮普语。"}, {"type": "subtitle", "time": 19495.67, "timestamp": "05:24:55", "text": "哦好的。有道理。这就是原因。所以，我"}, {"type": "subtitle", "time": 19498.47, "timestamp": "05:24:58", "text": "现在我知道了，就像我的保姆以前总是那样。"}]
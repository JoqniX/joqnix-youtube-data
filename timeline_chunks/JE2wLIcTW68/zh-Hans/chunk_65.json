[{"type": "subtitle", "time": 3901.15, "timestamp": "01:05:01", "text": "你说得对。好的。我们无法拯救"}, {"type": "subtitle", "time": 3904.39, "timestamp": "01:05:04", "text": "他们。乔。不，我们救不了他们。跑步"}, {"type": "subtitle", "time": 3906.789, "timestamp": "01:05:06", "text": "后退。跑回去。不，不，拿去吧。拿"}, {"type": "subtitle", "time": 3908.71, "timestamp": "01:05:08", "text": "它。带上它。他们情况不太好，"}, {"type": "subtitle", "time": 3911.829, "timestamp": "01:05:11", "text": "美好的。乔克。乔克。呃，伙计们，你们可以保存"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "我们。你可以，你可以直接拿走我们的头。"}, {"type": "subtitle", "time": 3917.19, "timestamp": "01:05:17", "text": "在卡车上。该死的。"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "哦。哦，不。不，不，不。我跟你说过。"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "在这些方面跟踪我们。狗，记住"}]
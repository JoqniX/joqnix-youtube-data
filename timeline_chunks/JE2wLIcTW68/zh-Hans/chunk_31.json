[{"type": "subtitle", "time": 1861.269, "timestamp": "00:31:01", "text": "顺便说一句，这几乎就是代码了。好的。"}, {"type": "subtitle", "time": 1862.789, "timestamp": "00:31:02", "text": "我们越是深入了解第一个问题，就越会发现这一点。"}, {"type": "subtitle", "time": 1865.51, "timestamp": "00:31:05", "text": "四分之一越好，对吧？是的。一次"}, {"type": "subtitle", "time": 1868.789, "timestamp": "00:31:08", "text": "让我再把它捡起来。正确的。"}, {"type": "subtitle", "time": 1876.47, "timestamp": "00:31:16", "text": "我拿到了王冠。对不起。拉屎。"}, {"type": "subtitle", "time": 1878.99, "timestamp": "00:31:18", "text": "他妈的。得到一个"}, {"type": "subtitle", "time": 1882.63, "timestamp": "00:31:22", "text": "王冠。他们应该看看我"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "[音乐]"}, {"type": "subtitle", "time": 1891.669, "timestamp": "00:31:31", "text": "哦，你也可以像这样查看……"}, {"type": "subtitle", "time": 1893.43, "timestamp": "00:31:33", "text": "铲子之类的东西。你看，这里有个东西"}, {"type": "subtitle", "time": 1900.549, "timestamp": "00:31:40", "text": "我们应该躲藏起来。"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "是的。"}, {"type": "subtitle", "time": 1905.669, "timestamp": "00:31:45", "text": "好的。如果你躲在这些东西里，"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "别忘了关门。喜欢，"}, {"type": "subtitle", "time": 1917.99, "timestamp": "00:31:57", "text": "我看到了物理空间。那是什么意思？"}, {"type": "subtitle", "time": 1919.99, "timestamp": "00:31:59", "text": "声音？我想你可以躲在里面。"}]
[{"type": "subtitle", "time": 10321.19, "timestamp": "02:52:01", "text": "房子？我的天啊。来。你还没见过"}, {"type": "subtitle", "time": 10322.87, "timestamp": "02:52:02", "text": "现在这是我的房子。来，来。这是我的"}, {"type": "subtitle", "time": 10325.99, "timestamp": "02:52:05", "text": "是城堡吧？这是新情况。没人看见"}, {"type": "subtitle", "time": 10328.07, "timestamp": "02:52:08", "text": "关于这件事。过来。你还没见过"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "我的基地？没有。你有基地吗？"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "你觉得我得了什么病？过来。"}, {"type": "subtitle", "time": 10338.83, "timestamp": "02:52:18", "text": "过来。好的。什么"}, {"type": "subtitle", "time": 10341.389, "timestamp": "02:52:21", "text": "这"}, {"type": "subtitle", "time": 10345.389, "timestamp": "02:52:25", "text": "那是什么？神社"}, {"type": "subtitle", "time": 10347.469, "timestamp": "02:52:27", "text": "是吗？"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "那是两只眼睛吗？那双眼睛"}, {"type": "subtitle", "time": 10354.389, "timestamp": "02:52:34", "text": "眨眼。我的天啊。"}, {"type": "subtitle", "time": 10357.15, "timestamp": "02:52:37", "text": "我们制作这个视频的原因是"}, {"type": "subtitle", "time": 10360.71, "timestamp": "02:52:40", "text": "你，我的天哪。"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "哦，这是一把小钥匙。搞什么鬼？"}, {"type": "subtitle", "time": 10368.79, "timestamp": "02:52:48", "text": "你也做一个吧。这个区域。"}, {"type": "subtitle", "time": 10371.51, "timestamp": "02:52:51", "text": "这是什么？"}, {"type": "subtitle", "time": 10375.309, "timestamp": "02:52:55", "text": "这是我的基地。那是我的房间。那是"}]
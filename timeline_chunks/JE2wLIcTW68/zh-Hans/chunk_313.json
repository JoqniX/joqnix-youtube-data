[{"type": "subtitle", "time": 18781.11, "timestamp": "05:13:01", "text": "我很高兴我们努力寻找他们。我"}, {"type": "subtitle", "time": 18789.75, "timestamp": "05:13:09", "text": "为什么我听到了僵尸的声音？"}, {"type": "subtitle", "time": 18792.708, "timestamp": "05:13:12", "text": "对，就是这个原因。看，看，看，看呃"}, {"type": "subtitle", "time": 18796.31, "timestamp": "05:13:16", "text": "右上角有个柱状物。"}, {"type": "subtitle", "time": 18798.23, "timestamp": "05:13:18", "text": "从城堡入口处就能看到。"}, {"type": "subtitle", "time": 18801.03, "timestamp": "05:13:21", "text": "你看，那儿有个风车之类的东西。"}, {"type": "subtitle", "time": 18804.07, "timestamp": "05:13:24", "text": "是的。啊，在那儿。好的。好的。"}, {"type": "subtitle", "time": 18806.868, "timestamp": "05:13:26", "text": "是的。我们就坐这儿吧。还有更多"}, {"type": "subtitle", "time": 18809.23, "timestamp": "05:13:29", "text": "建造，"}, {"type": "subtitle", "time": 18831.03, "timestamp": "05:13:51", "text": "我不知道。我不知道你"}]
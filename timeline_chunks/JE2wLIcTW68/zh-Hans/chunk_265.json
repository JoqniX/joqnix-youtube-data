[{"type": "subtitle", "time": 15914.309, "timestamp": "04:25:14", "text": "知道。我知道。你看，它正在给予一个"}, {"type": "subtitle", "time": 15915.55, "timestamp": "04:25:15", "text": "钻石"}, {"type": "subtitle", "time": 15918.79, "timestamp": "04:25:18", "text": "三月。不，不是。哦，去那里。"}, {"type": "subtitle", "time": 15922.349, "timestamp": "04:25:22", "text": "好的。你知道那是什么吗，乔？这是"}, {"type": "subtitle", "time": 15925.83, "timestamp": "04:25:25", "text": "三木的船体。"}, {"type": "subtitle", "time": 15929.269, "timestamp": "04:25:29", "text": "去死吧，去死吧，去死吧。"}, {"type": "subtitle", "time": 15932.07, "timestamp": "04:25:32", "text": "是的，这是一座纪念碑。这是一座纪念碑。"}, {"type": "subtitle", "time": 15934.56, "timestamp": "04:25:34", "text": "纪念碑。 过来。你在干什么？"}, {"type": "subtitle", "time": 15937.359, "timestamp": "04:25:37", "text": "过来。你在干什么？ 他今天状态不错。他很安静。"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "今天。我喜欢那首歌。"}]
[{"type": "subtitle", "time": 7381.47, "timestamp": "02:03:01", "text": "控制板。让我来做这件事吧。"}, {"type": "subtitle", "time": 7385.91, "timestamp": "02:03:05", "text": "快的。推。推。我不想看。"}, {"type": "subtitle", "time": 7387.99, "timestamp": "02:03:07", "text": "哦，我还有这支笔。哦，等等。"}, {"type": "subtitle", "time": 7391.83, "timestamp": "02:03:11", "text": "耽误。让我取消置顶。对不起。呃，"}, {"type": "subtitle", "time": 7394.629, "timestamp": "02:03:14", "text": "我们需要改变一些东西，例如"}, {"type": "subtitle", "time": 7397.109, "timestamp": "02:03:17", "text": "作为"}, {"type": "subtitle", "time": 7400.589, "timestamp": "02:03:20", "text": "呃，有些东西，例如"}, {"type": "subtitle", "time": 7403.35, "timestamp": "02:03:23", "text": "呃，给我买杯咖啡的链接，对吧？那"}, {"type": "subtitle", "time": 7405.39, "timestamp": "02:03:25", "text": "在印度行不通。"}, {"type": "subtitle", "time": 7408.99, "timestamp": "02:03:28", "text": "所以，因为 Stripe 太糟糕了"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "为什么要请我喝咖啡？我需要移除"}, {"type": "subtitle", "time": 7430.83, "timestamp": "02:03:50", "text": "眨。我有时觉得我应该"}, {"type": "subtitle", "time": 7434.589, "timestamp": "02:03:54", "text": "把乔森那玩意儿放上去"}, {"type": "subtitle", "time": 7436.669, "timestamp": "02:03:56", "text": "顶部"}, {"type": "subtitle", "time": 7439.629, "timestamp": "02:03:59", "text": "开始于此"}]
[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "希望今天能睡个好觉。我喜欢不像"}, {"type": "subtitle", "time": 6425.43, "timestamp": "01:47:05", "text": "昨天我凌晨五点才睡。"}, {"type": "subtitle", "time": 6427.87, "timestamp": "01:47:07", "text": "不想"}, {"type": "subtitle", "time": 6431.03, "timestamp": "01:47:11", "text": "睡觉。陪我喝杯啤酒吧。我应该吃吗？"}, {"type": "subtitle", "time": 6438.109, "timestamp": "01:47:18", "text": "O."}, {"type": "subtitle", "time": 6455.17, "timestamp": "01:47:35", "text": "我刚刚意识到啤酒与……不同"}]
[{"type": "subtitle", "time": 18663.11, "timestamp": "05:11:03", "text": "嗯，是的。轮到你了。去做。我愿意做。"}, {"type": "subtitle", "time": 18666.59, "timestamp": "05:11:06", "text": "我会审判你。现在我将审判你。"}, {"type": "subtitle", "time": 18668.51, "timestamp": "05:11:08", "text": "好的。"}, {"type": "subtitle", "time": 18672.31, "timestamp": "05:11:12", "text": "嘿。好的。呃，你想学什么？"}, {"type": "subtitle", "time": 18676.07, "timestamp": "05:11:16", "text": "旁遮普语工作？你拥有某样东西。"}, {"type": "subtitle", "time": 18677.868, "timestamp": "05:11:17", "text": "我只是"}, {"type": "subtitle", "time": 18679.788, "timestamp": "05:11:19", "text": "你好"}, {"type": "subtitle", "time": 18687.91, "timestamp": "05:11:27", "text": "呃兄弟，问题是我有……"}, {"type": "subtitle", "time": 18689.19, "timestamp": "05:11:29", "text": "非常糟糕的事情，因为我两个都认识。"}, {"type": "subtitle", "time": 18692.07, "timestamp": "05:11:32", "text": "语言：哈拉尼语和旁遮普语。所以当"}, {"type": "subtitle", "time": 18694.39, "timestamp": "05:11:34", "text": "我说的有些东西我混杂在一起了。"}, {"type": "subtitle", "time": 18701.99, "timestamp": "05:11:41", "text": "好的。啊。啊。所以我的两个"}, {"type": "subtitle", "time": 18704.91, "timestamp": "05:11:44", "text": "语言真是糟透了。"}, {"type": "subtitle", "time": 18708.67, "timestamp": "05:11:48", "text": "是的。相同的。我不知道，我一个也不认识。"}, {"type": "subtitle", "time": 18712.23, "timestamp": "05:11:52", "text": "语言。我真的不知道。我混合"}, {"type": "subtitle", "time": 18714.868, "timestamp": "05:11:54", "text": "精通所有语言，并且会说一些话"}]
[{"type": "subtitle", "time": 15756.349, "timestamp": "04:22:36", "text": "我几乎记得每一件事"}, {"type": "subtitle", "time": 15763.07, "timestamp": "04:22:43", "text": "相同的。她过去常常带"}, {"type": "subtitle", "time": 15766.03, "timestamp": "04:22:46", "text": "歌词关于学校。"}, {"type": "subtitle", "time": 15769.75, "timestamp": "04:22:49", "text": "嗯，我们以前喜欢最后才写歌词。"}, {"type": "subtitle", "time": 15772.75, "timestamp": "04:22:52", "text": "几分钟的坏孩子真有趣"}, {"type": "subtitle", "time": 15777.429, "timestamp": "04:22:57", "text": "兄弟，我可是辛格的超级粉丝。"}]
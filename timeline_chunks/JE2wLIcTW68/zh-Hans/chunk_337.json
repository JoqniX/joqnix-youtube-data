[{"type": "subtitle", "time": 20221.19, "timestamp": "05:37:01", "text": "哎呀，我不擅长这个，但是之后……"}, {"type": "subtitle", "time": 20227.39, "timestamp": "05:37:07", "text": "实际上"}, {"type": "subtitle", "time": 20230.23, "timestamp": "05:37:10", "text": "好的。我的记忆力很差。我仍然"}, {"type": "subtitle", "time": 20232.868, "timestamp": "05:37:12", "text": "我看不懂片假名。我只能阅读"}, {"type": "subtitle", "time": 20235.91, "timestamp": "05:37:15", "text": "平假名。嗯，两个很像，我可以，我可以"}, {"type": "subtitle", "time": 20237.75, "timestamp": "05:37:17", "text": "现在就把桌子摆好。我会打字"}, {"type": "subtitle", "time": 20239.27, "timestamp": "05:37:19", "text": "一切。"}]
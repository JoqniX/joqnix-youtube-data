[{"type": "subtitle", "time": 20165.43, "timestamp": "05:36:05", "text": "我喜欢那首歌。"}, {"type": "subtitle", "time": 20168.31, "timestamp": "05:36:08", "text": "你的日语歌唱得真好。你如何"}, {"type": "subtitle", "time": 20172.07, "timestamp": "05:36:12", "text": "用相同的乐谱和相同的音高演唱"}, {"type": "subtitle", "time": 20174.868, "timestamp": "05:36:14", "text": "还有别的什么？苏科雷。"}, {"type": "subtitle", "time": 20177.51, "timestamp": "05:36:17", "text": "我学会了。我非常喜欢这首歌。"}, {"type": "subtitle", "time": 20179.91, "timestamp": "05:36:19", "text": "我还学习了日语。你想要"}, {"type": "subtitle", "time": 20181.75, "timestamp": "05:36:21", "text": "听到了吗？"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "不，其实我学的是假名。"}, {"type": "subtitle", "time": 20197.67, "timestamp": "05:36:37", "text": "而当最终……"}, {"type": "subtitle", "time": 20199.91, "timestamp": "05:36:39", "text": "理解其含义就像……"}, {"type": "subtitle", "time": 20201.51, "timestamp": "05:36:41", "text": "这一点我可以解读成任何内容"}, {"type": "subtitle", "time": 20203.59, "timestamp": "05:36:43", "text": "我是日本人，但我不知道该怎么喜欢我"}, {"type": "subtitle", "time": 20205.27, "timestamp": "05:36:45", "text": "我不知道它的意思，但我能读懂。"}, {"type": "subtitle", "time": 20208.868, "timestamp": "05:36:48", "text": "任何东西。哦。呃，我明白了。"}, {"type": "subtitle", "time": 20210.708, "timestamp": "05:36:50", "text": "表现不错。比如我不擅长"}]
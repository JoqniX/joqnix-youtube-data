[{"type": "subtitle", "time": 13023.59, "timestamp": "03:37:03", "text": "哦，最后一件事。"}, {"type": "subtitle", "time": 13026.63, "timestamp": "03:37:06", "text": "不，那是我的敌人。"}, {"type": "subtitle", "time": 13029.75, "timestamp": "03:37:09", "text": "是的，我知道走路"}, {"type": "subtitle", "time": 13034.309, "timestamp": "03:37:14", "text": "行走的声音。对，那就是破折号。"}, {"type": "subtitle", "time": 13046.07, "timestamp": "03:37:26", "text": "我没事。而一般的说唱歌手都是如此"}, {"type": "subtitle", "time": 13048.95, "timestamp": "03:37:28", "text": "马和驴杂交。"}, {"type": "subtitle", "time": 13051.11, "timestamp": "03:37:31", "text": "哦，我们可以，你可以养马，而且"}, {"type": "subtitle", "time": 13057.91, "timestamp": "03:37:37", "text": "哇。如果你让驴和马交配，"}, {"type": "subtitle", "time": 13060.87, "timestamp": "03:37:40", "text": "它会把一些东西混合在一起。"}, {"type": "subtitle", "time": 13064.11, "timestamp": "03:37:44", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "哇。哦，他们添加的东西各不相同。"}]
[{"type": "subtitle", "time": 17942.39, "timestamp": "04:59:02", "text": "就像这样，你你"}, {"type": "subtitle", "time": 17944.59, "timestamp": "04:59:04", "text": "需要哼唱它"}, {"type": "subtitle", "time": 17948.948, "timestamp": "04:59:08", "text": "以及相应的歌词"}, {"type": "subtitle", "time": 17950.19, "timestamp": "04:59:10", "text": "就像节拍"}, {"type": "subtitle", "time": 17955.47, "timestamp": "04:59:15", "text": "签名四杆 1x4 等等。"}, {"type": "subtitle", "time": 17965.51, "timestamp": "04:59:25", "text": "我使用了插件。就像我小时候那样"}, {"type": "subtitle", "time": 17969.35, "timestamp": "04:59:29", "text": "现在学习，我的老师教导我们"}, {"type": "subtitle", "time": 17972.39, "timestamp": "04:59:32", "text": "插件之类的东西。真酷。我当时"}, {"type": "subtitle", "time": 17975.51, "timestamp": "04:59:35", "text": "太震惊了。我简直震惊了，我们竟然可以"}, {"type": "subtitle", "time": 17979.27, "timestamp": "04:59:39", "text": "这样做。我的天，那太酷了。"}, {"type": "subtitle", "time": 17982.39, "timestamp": "04:59:42", "text": "你使用了哪些插件？我不"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "务必牢记。这是哪种类型的喜欢"}, {"type": "subtitle", "time": 17988.07, "timestamp": "04:59:48", "text": "呃，音频方面的东西？"}, {"type": "subtitle", "time": 17992.47, "timestamp": "04:59:52", "text": "不，那就像是……呃，最基础的那种"}, {"type": "subtitle", "time": 17995.91, "timestamp": "04:59:55", "text": "噪音装置。你可以像压缩一样压缩"}, {"type": "subtitle", "time": 17999.91, "timestamp": "04:59:59", "text": "噪音之类的，然后"}]
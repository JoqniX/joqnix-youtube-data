[{"type": "subtitle", "time": 17341.75, "timestamp": "04:49:01", "text": "就像那部电影一样。"}, {"type": "subtitle", "time": 17345.83, "timestamp": "04:49:05", "text": "是的。是的，他们做不到。哇。"}, {"type": "subtitle", "time": 17347.35, "timestamp": "04:49:07", "text": "它就像电影一样，但它是……"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "真相。哦，什么？这是什么？是新的"}, {"type": "subtitle", "time": 17353.67, "timestamp": "04:49:13", "text": "某种僵尸。我会杀了你。是的，"}, {"type": "subtitle", "time": 17356.31, "timestamp": "04:49:16", "text": "那就是"}, {"type": "subtitle", "time": 17358.31, "timestamp": "04:49:18", "text": "伙计们，这个世界不属于你们。"}, {"type": "subtitle", "time": 17360.31, "timestamp": "04:49:20", "text": "不规则的。"}, {"type": "subtitle", "time": 17363.15, "timestamp": "04:49:23", "text": "死吧，死吧，"}, {"type": "subtitle", "time": 17366.47, "timestamp": "04:49:26", "text": "去死吧，去死吧。过来。过来。死，"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "死。哦，不。我的天哪。我的天哪。你吹了吗？"}, {"type": "subtitle", "time": 17374.15, "timestamp": "04:49:34", "text": "城堡里有什么事吗？不，不。它是"}, {"type": "subtitle", "time": 17377.59, "timestamp": "04:49:37", "text": "城堡下方。不用担心。"}, {"type": "subtitle", "time": 17381.19, "timestamp": "04:49:41", "text": "我该如何下去？我没有界限感。"}, {"type": "subtitle", "time": 17382.55, "timestamp": "04:49:42", "text": "等等，等等，等等。我会用卫生纸把你缠起来。一"}, {"type": "subtitle", "time": 17384.628, "timestamp": "04:49:44", "text": "第二。一秒钟。让我杀"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "每个人。好的。"}, {"type": "subtitle", "time": 17390.39, "timestamp": "04:49:50", "text": "炸毁城堡。你的意思是喜欢放"}, {"type": "subtitle", "time": 17393.19, "timestamp": "04:49:53", "text": "那里？"}, {"type": "subtitle", "time": 17395.51, "timestamp": "04:49:55", "text": "您尚未进入游戏。等待。好的，你"}, {"type": "subtitle", "time": 17399.11, "timestamp": "04:49:59", "text": "是。好的。你不在风险投资行业。好的。我是"}]
[{"type": "subtitle", "time": 16262.149, "timestamp": "04:31:02", "text": "你知道，这是我最喜欢的歌。我"}, {"type": "subtitle", "time": 16265.429, "timestamp": "04:31:05", "text": "我真的很喜欢这首歌。"}, {"type": "subtitle", "time": 16267.349, "timestamp": "04:31:07", "text": "嗯。"}, {"type": "subtitle", "time": 16269.59, "timestamp": "04:31:09", "text": "我知道。我知道更多旁遮普语歌曲。让"}, {"type": "subtitle", "time": 16270.49, "timestamp": "04:31:10", "text": "我真的试着"}, {"type": "subtitle", "time": 16279.95, "timestamp": "04:31:19", "text": "你知道一个非常古老的"}, {"type": "subtitle", "time": 16301.87, "timestamp": "04:31:41", "text": "[音乐]"}, {"type": "subtitle", "time": 16304.229, "timestamp": "04:31:44", "text": "不同的。等等，是我崩溃了吗？还是你也崩溃了？"}, {"type": "subtitle", "time": 16307.429, "timestamp": "04:31:47", "text": "有人坠机了吗？我没有坠机。"}, {"type": "subtitle", "time": 16309.75, "timestamp": "04:31:49", "text": "是的，你离开了。"}, {"type": "subtitle", "time": 16311.55, "timestamp": "04:31:51", "text": "你"}]
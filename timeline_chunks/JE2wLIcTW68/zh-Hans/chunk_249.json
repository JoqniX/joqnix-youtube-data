[{"type": "subtitle", "time": 14943.349, "timestamp": "04:09:03", "text": "我对显示器有点担心。它显示"}, {"type": "subtitle", "time": 14946.469, "timestamp": "04:09:06", "text": "屏幕黑屏了一会儿，因为这台显示器"}, {"type": "subtitle", "time": 14964.309, "timestamp": "04:09:24", "text": "那就去做吧。需要时间冷却下来"}, {"type": "subtitle", "time": 14970.79, "timestamp": "04:09:30", "text": "正确的。我应该明天做。不，不"}, {"type": "subtitle", "time": 14973.51, "timestamp": "04:09:33", "text": "不。睡前。是的。不，但我确实有。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "哦，是的。你知道吗？我会这么做"}, {"type": "subtitle", "time": 14975.95, "timestamp": "04:09:35", "text": "这"}, {"type": "subtitle", "time": 14984.71, "timestamp": "04:09:44", "text": "而不是放置木板。好的。"}, {"type": "subtitle", "time": 14987.87, "timestamp": "04:09:47", "text": "好，让我听听……"}, {"type": "subtitle", "time": 14992.91, "timestamp": "04:09:52", "text": "游戏。现在音频效果如何？请告诉我。"}, {"type": "subtitle", "time": 14999.71, "timestamp": "04:09:59", "text": "哦，我的"}]
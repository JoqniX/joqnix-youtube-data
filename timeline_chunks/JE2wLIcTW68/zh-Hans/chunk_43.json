[{"type": "subtitle", "time": 2583.829, "timestamp": "00:43:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 2587.27, "timestamp": "00:43:07", "text": "那真是一记本垒打。"}, {"type": "subtitle", "time": 2590.79, "timestamp": "00:43:10", "text": "你的东西。我在这里放了一些。"}, {"type": "subtitle", "time": 2593.589, "timestamp": "00:43:13", "text": "等等，你的体力就在这里。你掉了"}, {"type": "subtitle", "time": 2597.99, "timestamp": "00:43:17", "text": "它。我能获得足够的耐力吗？是的，"}, {"type": "subtitle", "time": 2599.91, "timestamp": "00:43:19", "text": "当然。"}, {"type": "subtitle", "time": 2601.67, "timestamp": "00:43:21", "text": "我们获得了两份体力。我们走吧。一个"}, {"type": "subtitle", "time": 2604.15, "timestamp": "00:43:24", "text": "你。那在哪儿？有件事。它是"}, {"type": "subtitle", "time": 2606.309, "timestamp": "00:43:26", "text": "在另一边。一秒钟。我们能"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "用棒球棍击倒怪物？"}, {"type": "subtitle", "time": 2612.63, "timestamp": "00:43:32", "text": "嗯，可以，但是很贵。患病的"}, {"type": "subtitle", "time": 2621.03, "timestamp": "00:43:41", "text": "强壮有力。好的。某个运动员。快点。"}, {"type": "subtitle", "time": 2624.75, "timestamp": "00:43:44", "text": "我去。呃，按 Q 键即可变成布娃娃"}, {"type": "subtitle", "time": 2629.19, "timestamp": "00:43:49", "text": "第一的。好的。给我。谢谢。"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "好的。"}, {"type": "subtitle", "time": 2633.23, "timestamp": "00:43:53", "text": "哦，谢谢。"}, {"type": "subtitle", "time": 2637.99, "timestamp": "00:43:57", "text": "好的。我可以拿到手榴弹吗？是的。"}, {"type": "subtitle", "time": 2639.43, "timestamp": "00:43:59", "text": "有时并没有。有时候那里"}]
[{"type": "subtitle", "time": 18180.51, "timestamp": "05:03:00", "text": "是的，一个声音"}, {"type": "subtitle", "time": 18185.03, "timestamp": "05:03:05", "text": "盒。呃，不。不。呃，呃，我正在做……"}, {"type": "subtitle", "time": 18187.43, "timestamp": "05:03:07", "text": "合作项目。"}, {"type": "subtitle", "time": 18189.03, "timestamp": "05:03:09", "text": "所以，我还没做过。我必须"}, {"type": "subtitle", "time": 18192.23, "timestamp": "05:03:12", "text": "说出来。我没有我喜欢的东西"}, {"type": "subtitle", "time": 18193.75, "timestamp": "05:03:13", "text": "一切都会像……一样赐给我。"}, {"type": "subtitle", "time": 18195.27, "timestamp": "05:03:15", "text": "故事之类的。我只是想说几句话。"}, {"type": "subtitle", "time": 18197.11, "timestamp": "05:03:17", "text": "它。"}, {"type": "subtitle", "time": 18205.868, "timestamp": "05:03:25", "text": "她将教导"}, {"type": "subtitle", "time": 18209.27, "timestamp": "05:03:29", "text": "我。哇。我想试试。我就像"}, {"type": "subtitle", "time": 18220.83, "timestamp": "05:03:40", "text": "射击。那将是"}, {"type": "subtitle", "time": 18230.39, "timestamp": "05:03:50", "text": "你可以吸引女性观众。"}, {"type": "subtitle", "time": 18233.51, "timestamp": "05:03:53", "text": "是的，我有个朋友叫乔希。他确实如此"}, {"type": "subtitle", "time": 18236.788, "timestamp": "05:03:56", "text": "他是一名 AMR 内容创作者。他只做"}, {"type": "subtitle", "time": 18238.47, "timestamp": "05:03:58", "text": "那。"}]
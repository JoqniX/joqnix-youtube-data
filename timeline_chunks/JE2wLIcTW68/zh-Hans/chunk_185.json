[{"type": "subtitle", "time": 11107.75, "timestamp": "03:05:07", "text": "下雨了。我不知道你还能做这个"}, {"type": "subtitle", "time": 11111.03, "timestamp": "03:05:11", "text": "定制型木筏。不，那真搞笑。"}, {"type": "subtitle", "time": 11112.309, "timestamp": "03:05:12", "text": "足够的。"}, {"type": "subtitle", "time": 11114.11, "timestamp": "03:05:14", "text": "哦，这是"}, {"type": "subtitle", "time": 11117.91, "timestamp": "03:05:17", "text": "香草。这是。哇，这好多了"}, {"type": "subtitle", "time": 11137.55, "timestamp": "03:05:37", "text": "你看，我的样子很酷，对吧？"}, {"type": "subtitle", "time": 11144.71, "timestamp": "03:05:44", "text": "你玩《我的世界》多久了？"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "为了？"}, {"type": "subtitle", "time": 11149.75, "timestamp": "03:05:49", "text": "你什么时候开始的？"}, {"type": "subtitle", "time": 11152.469, "timestamp": "03:05:52", "text": "我很闷。"}, {"type": "subtitle", "time": 11155.44, "timestamp": "03:05:55", "text": "发生了什么？"}]
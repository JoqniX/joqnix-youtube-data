[{"type": "subtitle", "time": 16740.949, "timestamp": "04:39:00", "text": "好了，各位，都看着我。瞧瞧"}, {"type": "subtitle", "time": 16743.109, "timestamp": "04:39:03", "text": "在天空中。我正在为……做点什么"}, {"type": "subtitle", "time": 16744.869, "timestamp": "04:39:04", "text": "你们。"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "我正在制作……我正在制作一个基地。那是我的"}, {"type": "subtitle", "time": 16750.869, "timestamp": "04:39:10", "text": "最初就像这个区域，这个"}, {"type": "subtitle", "time": 16753.109, "timestamp": "04:39:13", "text": "特定的土地。我想制作一个"}, {"type": "subtitle", "time": 16757.029, "timestamp": "04:39:17", "text": "这里是房子。让我现在就把它做好。"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "你好。"}, {"type": "subtitle", "time": 16771.349, "timestamp": "04:39:31", "text": "某物？好的，我去拿我的东西。"}, {"type": "subtitle", "time": 16777.43, "timestamp": "04:39:37", "text": "我的天哪。贾玛，你就待在这里吧。"}, {"type": "subtitle", "time": 16781.03, "timestamp": "04:39:41", "text": "现在。等等，看看天空中的……"}, {"type": "subtitle", "time": 16782.31, "timestamp": "04:39:42", "text": "天空。"}, {"type": "subtitle", "time": 16784.708, "timestamp": "04:39:44", "text": "我的动画和着色器一切"}, {"type": "subtitle", "time": 16788.15, "timestamp": "04:39:48", "text": "关机了，所以我看不到我现在看到的东西。"}, {"type": "subtitle", "time": 16789.47, "timestamp": "04:39:49", "text": "哦，现在"}, {"type": "subtitle", "time": 16792.03, "timestamp": "04:39:52", "text": "什么？等等，是"}, {"type": "subtitle", "time": 16795.83, "timestamp": "04:39:55", "text": "自动的。嗯？是的，我正在做这件事。"}]
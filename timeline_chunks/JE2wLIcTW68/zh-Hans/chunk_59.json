[{"type": "subtitle", "time": 3546.589, "timestamp": "00:59:06", "text": "[音乐]"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "当心。记住，还有不同的"}, {"type": "subtitle", "time": 3578.95, "timestamp": "00:59:38", "text": "倾向于我"}, {"type": "subtitle", "time": 3583.67, "timestamp": "00:59:43", "text": "我听到你移动了那张牌。哦，"}, {"type": "subtitle", "time": 3585.99, "timestamp": "00:59:45", "text": "有点远。为什么"}, {"type": "subtitle", "time": 3588.789, "timestamp": "00:59:48", "text": "你就这么放着不管了？我不知道该怎么做"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "是真的带着它，伙计。"}, {"type": "subtitle", "time": 3594.63, "timestamp": "00:59:54", "text": "我当时没带着它。我以为你是……"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "你一直在坚持不懈地努力。留着吧。"}]
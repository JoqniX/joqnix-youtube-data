[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "嗯，差不多就是这样。"}, {"type": "subtitle", "time": 1684.63, "timestamp": "00:28:04", "text": "我的天，它爆炸了。狗"}, {"type": "subtitle", "time": 1688.87, "timestamp": "00:28:08", "text": "死？不，不，不。我不这么认为。嘿，"}, {"type": "subtitle", "time": 1691.83, "timestamp": "00:28:11", "text": "好了。"}, {"type": "subtitle", "time": 1693.909, "timestamp": "00:28:13", "text": "叉子插进我们的……它确实砸碎了。"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "到处都是损坏。"}, {"type": "subtitle", "time": 1699.269, "timestamp": "00:28:19", "text": "是的。好了，大家准备好了。呃，打我们。"}, {"type": "subtitle", "time": 1702.31, "timestamp": "00:28:22", "text": "准备好了吗？不，不，不。打我们。你去"}, {"type": "subtitle", "time": 1703.909, "timestamp": "00:28:23", "text": "领取一份健康包并带进来。"}, {"type": "subtitle", "time": 1705.83, "timestamp": "00:28:25", "text": "那艘船。"}, {"type": "subtitle", "time": 1708.87, "timestamp": "00:28:28", "text": "实际去做。好的，稍等。"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "为什么不呢？"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "嗯，我选大的。这"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "猎人一号。"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "我的天啊，"}, {"type": "subtitle", "time": 1724.63, "timestamp": "00:28:44", "text": "那。我们走吧。好了，上船吧。"}, {"type": "subtitle", "time": 1727.029, "timestamp": "00:28:47", "text": "上船，准备出发"}, {"type": "subtitle", "time": 1734.549, "timestamp": "00:28:54", "text": "快，快。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "你收到了吗？"}, {"type": "subtitle", "time": 1739.669, "timestamp": "00:28:59", "text": "等待。重新装弹。"}]
[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "尽我们所能。不，不，不，不。我们开始吧"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "得到“不，不，不”。让我们尽可能多地获取"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "第一季度就能做到。所以，第二个"}, {"type": "subtitle", "time": 1991.269, "timestamp": "00:33:11", "text": "其中一种方法会更容易。好的。忽略"}, {"type": "subtitle", "time": 1997.19, "timestamp": "00:33:17", "text": "它会随机选择目标人群。是吗？"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "现在跟着我，或者他妈的，它看起来"}, {"type": "subtitle", "time": 2002.47, "timestamp": "00:33:22", "text": "兄弟，为了炸弹。"}, {"type": "subtitle", "time": 2003.99, "timestamp": "00:33:23", "text": "把它从购物车旁移开，否则我"}, {"type": "subtitle", "time": 2018.31, "timestamp": "00:33:38", "text": "不，不，不。你得把它留着"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "秘密。你至少得把它保留下来。"}, {"type": "subtitle", "time": 2021.149, "timestamp": "00:33:41", "text": "喜欢"}, {"type": "subtitle", "time": 2023.59, "timestamp": "00:33:43", "text": "很有意思，因为你会想，“是啊，它"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "会杀了你的，伙计。”好像没人会杀了你似的。"}, {"type": "subtitle", "time": 2027.07, "timestamp": "00:33:47", "text": "查出。"}, {"type": "subtitle", "time": 2029.23, "timestamp": "00:33:49", "text": "是的，"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "恐怖分子胡闹，发现哦我的天"}, {"type": "subtitle", "time": 2035.43, "timestamp": "00:33:55", "text": "上帝。"}]
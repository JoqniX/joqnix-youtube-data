[{"type": "subtitle", "time": 18368.788, "timestamp": "05:06:08", "text": "你为什么总是诉诸暴力？"}, {"type": "subtitle", "time": 18381.75, "timestamp": "05:06:21", "text": "是的，"}, {"type": "subtitle", "time": 18404.07, "timestamp": "05:06:44", "text": "哦，是的。我的天啊。我的天啊。我是"}, {"type": "subtitle", "time": 18405.75, "timestamp": "05:06:45", "text": "垂死。我要死了。我要死了。我要死了。"}, {"type": "subtitle", "time": 18409.23, "timestamp": "05:06:49", "text": "你在哪里？你在哪里？别死"}, {"type": "subtitle", "time": 18411.91, "timestamp": "05:06:51", "text": "然后。对吧，乔克？她不应该死。"}, {"type": "subtitle", "time": 18414.55, "timestamp": "05:06:54", "text": "正确的？是的。"}, {"type": "subtitle", "time": 18417.11, "timestamp": "05:06:57", "text": "听着，听听乔克怎么说。"}]
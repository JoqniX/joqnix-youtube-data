[{"type": "subtitle", "time": 1020.269, "timestamp": "00:17:00", "text": "好的。好的。哦，我的"}, {"type": "subtitle", "time": 1041.27, "timestamp": "00:17:21", "text": "但敌人也存在。"}, {"type": "subtitle", "time": 1042.99, "timestamp": "00:17:22", "text": "好了，伙计们。我是"}, {"type": "subtitle", "time": 1046.87, "timestamp": "00:17:26", "text": "未来。那么，谁才是真正的怪物？"}, {"type": "subtitle", "time": 1049.35, "timestamp": "00:17:29", "text": "怪物之类的东西。 100 冲刺。我们可以"}, {"type": "subtitle", "time": 1050.029, "timestamp": "00:17:30", "text": "只是"}, {"type": "subtitle", "time": 1054.31, "timestamp": "00:17:34", "text": "直接拿走东西。打扰一下。耶稣。哦。"}, {"type": "subtitle", "time": 1056.789, "timestamp": "00:17:36", "text": "哦，等等。不要碰它。不要碰"}, {"type": "subtitle", "time": 1059.35, "timestamp": "00:17:39", "text": "这。好的。不要碰它。为什么？"}, {"type": "subtitle", "time": 1061.43, "timestamp": "00:17:41", "text": "实际上，并非如此。不要碰娃娃。它是"}, {"type": "subtitle", "time": 1063.59, "timestamp": "00:17:43", "text": "一个可怕的娃娃。用购物车拿过来。"}, {"type": "subtitle", "time": 1066.15, "timestamp": "00:17:46", "text": "把推车带来。不，不，别带。"}, {"type": "subtitle", "time": 1068.95, "timestamp": "00:17:48", "text": "直接滴在提取物上。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "是的。乔，把它捡起来。快点。去做。"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "是的，你可以试试，乔。是的。是的。做"}, {"type": "subtitle", "time": 1076.23, "timestamp": "00:17:56", "text": "把它捡起来。快点。这个。那是我的"}, {"type": "subtitle", "time": 1078.83, "timestamp": "00:17:58", "text": "计划。可怕。哦，我的"}]
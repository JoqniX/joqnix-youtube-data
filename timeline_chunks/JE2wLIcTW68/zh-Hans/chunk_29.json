[{"type": "subtitle", "time": 1744.19, "timestamp": "00:29:04", "text": "100. 走吧，作弊者们。它被称为"}, {"type": "subtitle", "time": 1756.23, "timestamp": "00:29:16", "text": "爆炸速度。我直接按E键就行了吗？"}, {"type": "subtitle", "time": 1758.71, "timestamp": "00:29:18", "text": "对，按E键。对，就按E键。呃，"}, {"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "谁最了解耐力？是的，确实如此。"}, {"type": "subtitle", "time": 1766.549, "timestamp": "00:29:26", "text": "那我就选择精神速度吧。"}, {"type": "subtitle", "time": 1769.51, "timestamp": "00:29:29", "text": "是的。好的。哦，乔。所以，这就是……"}, {"type": "subtitle", "time": 1778.23, "timestamp": "00:29:38", "text": "兄弟，你这枪法有点烂。你好，"}, {"type": "subtitle", "time": 1780.07, "timestamp": "00:29:40", "text": "塞莱斯蒂亚。欢迎来到直播间。我的目标是"}, {"type": "subtitle", "time": 1782.31, "timestamp": "00:29:42", "text": "为了坚果。"}, {"type": "subtitle", "time": 1785.029, "timestamp": "00:29:45", "text": "哇。好的，那个目标是我得到的"}, {"type": "subtitle", "time": 1788.149, "timestamp": "00:29:48", "text": "兄弟，我得造成溅射伤害。"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "好的，其他人来选这个切法。"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "时间。我肯定会四处看看。"}, {"type": "subtitle", "time": 1796.07, "timestamp": "00:29:56", "text": "我是猎人。我的意思是，我可以做到"}, {"type": "subtitle", "time": 1798.23, "timestamp": "00:29:58", "text": "如果需要，可以加入购物车。哦，你可以直接获取"}]
[{"type": "subtitle", "time": 12001.269, "timestamp": "03:20:01", "text": "如何？如何？我现在就想知道。它是怎么做到的？"}, {"type": "subtitle", "time": 12009.349, "timestamp": "03:20:09", "text": "等等，怎么做到的？实际上，我想知道"}, {"type": "subtitle", "time": 12023.99, "timestamp": "03:20:23", "text": "我不知道。来自一位名叫"}, {"type": "subtitle", "time": 12036.229, "timestamp": "03:20:36", "text": "不，是你。是你。你……"}, {"type": "subtitle", "time": 12038.95, "timestamp": "03:20:38", "text": "忘记？我给了他。等等，我怎么会给"}, {"type": "subtitle", "time": 12043.75, "timestamp": "03:20:43", "text": "他？我的天啊。你居然忘了。"}, {"type": "subtitle", "time": 12046.71, "timestamp": "03:20:46", "text": "不，不，不，不。我很确定我"}, {"type": "subtitle", "time": 12050.79, "timestamp": "03:20:50", "text": "我没有把任何东西送给任何人。"}, {"type": "subtitle", "time": 12059.11, "timestamp": "03:20:59", "text": "过来。我来给你演示一下。"}]
[{"type": "subtitle", "time": 17287.7, "timestamp": "04:48:07", "text": "他去世了"}, {"type": "subtitle", "time": 17288.99, "timestamp": "04:48:08", "text": "[音乐]"}, {"type": "subtitle", "time": 17291.99, "timestamp": "04:48:11", "text": "整个那个，你管它叫什么？"}, {"type": "subtitle", "time": 17294.868, "timestamp": "04:48:14", "text": "你还记得他叫什么名字吗？"}, {"type": "subtitle", "time": 17297.83, "timestamp": "04:48:17", "text": "嗯，爬行者"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "去。有很多“是啊”，因为"}, {"type": "subtitle", "time": 17320.75, "timestamp": "04:48:40", "text": "别来。别来。不"}, {"type": "subtitle", "time": 17332.83, "timestamp": "04:48:52", "text": "正确的？我会杀了他们"}, {"type": "subtitle", "time": 17337.51, "timestamp": "04:48:57", "text": "全部。僵尸。等待。蜘蛛可以骑。不。"}, {"type": "subtitle", "time": 17339.59, "timestamp": "04:48:59", "text": "骷髅也能骑。蜘蛛。什么？"}]
[{"type": "subtitle", "time": 1621.269, "timestamp": "00:27:01", "text": "哦，是的。我需要这个。我需要那个。拿"}, {"type": "subtitle", "time": 1623.51, "timestamp": "00:27:03", "text": "那。那是什么？购买冲击"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "波浪矿。哦不，不是冲击波。对不起。"}, {"type": "subtitle", "time": 1628.149, "timestamp": "00:27:08", "text": "我以为那是地雷。不，不。"}, {"type": "subtitle", "time": 1631.43, "timestamp": "00:27:11", "text": "我丢了一颗手榴弹。所以，我猜"}, {"type": "subtitle", "time": 1634.149, "timestamp": "00:27:14", "text": "哦，是的。这个。这。"}, {"type": "subtitle", "time": 1638.63, "timestamp": "00:27:18", "text": "哦好的。这个多少钱？ 35. 所以，"}, {"type": "subtitle", "time": 1641.269, "timestamp": "00:27:21", "text": "我给自己升级了一间小型度假屋。"}, {"type": "subtitle", "time": 1644.31, "timestamp": "00:27:24", "text": "谁购买了力量升级？"}, {"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "我们要把它给乔。好的。 WHO"}, {"type": "subtitle", "time": 1649.909, "timestamp": "00:27:29", "text": "购买了体力升级？我。"}, {"type": "subtitle", "time": 1653.43, "timestamp": "00:27:33", "text": "谁购买了射程升级？"}, {"type": "subtitle", "time": 1657.51, "timestamp": "00:27:37", "text": "我没有。等等，什么？乔克。我觉得你"}, {"type": "subtitle", "time": 1659.51, "timestamp": "00:27:39", "text": "不小心捡到了。不，等等。不，我"}, {"type": "subtitle", "time": 1662.23, "timestamp": "00:27:42", "text": "振作起来。我想我拿了"}, {"type": "subtitle", "time": 1663.99, "timestamp": "00:27:43", "text": "力量。"}, {"type": "subtitle", "time": 1665.99, "timestamp": "00:27:45", "text": "这个。"}, {"type": "subtitle", "time": 1669.35, "timestamp": "00:27:49", "text": "哦，是射程。哦，不。"}, {"type": "subtitle", "time": 1673.43, "timestamp": "00:27:53", "text": "我的意思是，我们可以买到它。没关系。"}, {"type": "subtitle", "time": 1675.789, "timestamp": "00:27:55", "text": "是的，确实如此。这一切都是"}, {"type": "subtitle", "time": 1679.11, "timestamp": "00:27:59", "text": "正确的。就这些吗？"}]
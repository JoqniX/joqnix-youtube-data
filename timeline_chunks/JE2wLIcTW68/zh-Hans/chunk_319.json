[{"type": "subtitle", "time": 19146.35, "timestamp": "05:19:06", "text": "好的。"}, {"type": "subtitle", "time": 19149.628, "timestamp": "05:19:09", "text": "呃，然后"}, {"type": "subtitle", "time": 19152.628, "timestamp": "05:19:12", "text": "就像 Changa 看到什么东西一样，兄弟，应该怎么做？"}, {"type": "subtitle", "time": 19157.19, "timestamp": "05:19:17", "text": "我跟你说，这事儿很自然。"}, {"type": "subtitle", "time": 19159.59, "timestamp": "05:19:19", "text": "我喜欢这样，我可以很自然地做到。"}, {"type": "subtitle", "time": 19163.27, "timestamp": "05:19:23", "text": "现在有人跟我说话吗？"}, {"type": "subtitle", "time": 19173.11, "timestamp": "05:19:33", "text": "好的，你可以这样做，而且你可以"}, {"type": "subtitle", "time": 19179.19, "timestamp": "05:19:39", "text": "旁遮普人喜欢那个女孩，还有一些东西"}, {"type": "subtitle", "time": 19181.628, "timestamp": "05:19:41", "text": "就像那样"}, {"type": "subtitle", "time": 19185.83, "timestamp": "05:19:45", "text": "那是什么？"}, {"type": "subtitle", "time": 19193.51, "timestamp": "05:19:53", "text": "事物。好的。是的。是的。就像那样"}, {"type": "subtitle", "time": 19196.23, "timestamp": "05:19:56", "text": "歌曲或者类似我去的时候"}, {"type": "subtitle", "time": 19198.708, "timestamp": "05:19:58", "text": "理发店里，他们把旁遮普歌曲放在那里"}]
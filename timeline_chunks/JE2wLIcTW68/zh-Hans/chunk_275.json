[{"type": "subtitle", "time": 16501.029, "timestamp": "04:35:01", "text": "现在有了地牢和酒馆之类的东西。是的。"}, {"type": "subtitle", "time": 16502.629, "timestamp": "04:35:02", "text": "是的。是的。是的。实际情况"}, {"type": "subtitle", "time": 16516.15, "timestamp": "04:35:16", "text": "哦，下面有个箱子。我可以吗？"}, {"type": "subtitle", "time": 16518.23, "timestamp": "04:35:18", "text": "去？"}, {"type": "subtitle", "time": 16519.59, "timestamp": "04:35:19", "text": "只要你没死，你就可以进去。"}, {"type": "subtitle", "time": 16534.629, "timestamp": "04:35:34", "text": "我是什么？我要死了。什么？是的，你"}, {"type": "subtitle", "time": 16537.51, "timestamp": "04:35:37", "text": "我只是说我不会死。我说如果你"}, {"type": "subtitle", "time": 16539.15, "timestamp": "04:35:39", "text": "别死，你可以走了"}, {"type": "subtitle", "time": 16543.109, "timestamp": "04:35:43", "text": "地点视你的技能而定。"}, {"type": "subtitle", "time": 16545.51, "timestamp": "04:35:45", "text": "哦，我想是的"}, {"type": "subtitle", "time": 16547.67, "timestamp": "04:35:47", "text": "坏的。"}, {"type": "subtitle", "time": 16549.551, "timestamp": "04:35:49", "text": "兄弟，如果你无法在某些方面生存下去……"}, {"type": "subtitle", "time": 16553.59, "timestamp": "04:35:53", "text": "有些地方，你不具备相应的技能。"}, {"type": "subtitle", "time": 16556.949, "timestamp": "04:35:56", "text": "她能学会。她能学会。 D."}, {"type": "subtitle", "time": 16558.39, "timestamp": "04:35:58", "text": "是的。我从没见过这种情况。她不能"}, {"type": "subtitle", "time": 16559.51, "timestamp": "04:35:59", "text": "学习。她能学会。她可以"}]
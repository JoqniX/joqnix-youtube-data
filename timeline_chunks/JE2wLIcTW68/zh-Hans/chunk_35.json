[{"type": "subtitle", "time": 2100.39, "timestamp": "00:35:00", "text": "别加入那个皇室船员队伍。什么"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "如果我输入“如何复活Kto？”会发生什么？"}, {"type": "subtitle", "time": 2108.63, "timestamp": "00:35:08", "text": "我们可以。当我们完成四分之一的工作时，"}, {"type": "subtitle", "time": 2110.39, "timestamp": "00:35:10", "text": "如果你有的话，那就是你复活的时候。"}, {"type": "subtitle", "time": 2113.109, "timestamp": "00:35:13", "text": "他的脑袋要么在配额上，要么在其他地方。"}, {"type": "subtitle", "time": 2116.47, "timestamp": "00:35:16", "text": "我想应该是船吧。所以，把他放进去就行了。"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "船。他会没事的。或者你需要……"}, {"type": "subtitle", "time": 2121.829, "timestamp": "00:35:21", "text": "摸摸他，对吧，我的天。好的"}, {"type": "subtitle", "time": 2123.91, "timestamp": "00:35:23", "text": "一。"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "好的，这样可以。那家伙还是哦"}, {"type": "subtitle", "time": 2127.31, "timestamp": "00:35:27", "text": "我的"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "我看到了一种叫做猫咪的东西，或者"}]
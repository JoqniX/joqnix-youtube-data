[{"type": "subtitle", "time": 9484.429, "timestamp": "02:38:04", "text": "[音乐]"}, {"type": "subtitle", "time": 9486.349, "timestamp": "02:38:06", "text": "知道。"}, {"type": "subtitle", "time": 9492.23, "timestamp": "02:38:12", "text": "好的。第27天，我们做了"}, {"type": "subtitle", "time": 9499.469, "timestamp": "02:38:19", "text": "我做了什么？"}, {"type": "subtitle", "time": 9507.27, "timestamp": "02:38:27", "text": "今天？今天我警告了所有人"}, {"type": "subtitle", "time": 9522.87, "timestamp": "02:38:42", "text": "警告。是的，我当时警告了一半的人。"}, {"type": "subtitle", "time": 9525.03, "timestamp": "02:38:45", "text": "天。"}, {"type": "subtitle", "time": 9527.349, "timestamp": "02:38:47", "text": "我唯一一次回来是在五点。"}, {"type": "subtitle", "time": 9529.95, "timestamp": "02:38:49", "text": "火印。我在火灾中做了什么"}, {"type": "subtitle", "time": 9533.309, "timestamp": "02:38:53", "text": "标记？我们玩"}, {"type": "subtitle", "time": 9539.63, "timestamp": "02:38:59", "text": "顶点。作息时间就是这样。我们做到了"}]
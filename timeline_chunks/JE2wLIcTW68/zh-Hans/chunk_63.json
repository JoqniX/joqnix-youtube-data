[{"type": "subtitle", "time": 3785.309, "timestamp": "01:03:05", "text": "那。好了。好的，完美。"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "呃，好的。把钱袋和这些放好。"}, {"type": "subtitle", "time": 3791.63, "timestamp": "01:03:11", "text": "卡片上的小物件。好的。"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "卡片。瞧瞧那家伙，贱人。好的。哟。"}, {"type": "subtitle", "time": 3800.23, "timestamp": "01:03:20", "text": "电脑。我的天啊。太棒了。"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "这个也一样，对吧？"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "再次。嗯，是的，就是每一个小细节"}, {"type": "subtitle", "time": 3808.47, "timestamp": "01:03:28", "text": "物品。把它放进那个东西里。我是说，"}, {"type": "subtitle", "time": 3811.27, "timestamp": "01:03:31", "text": "因为我真的"}, {"type": "subtitle", "time": 3813.99, "timestamp": "01:03:33", "text": "呃，这些电脑怎么样？我们把它举起来"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "需要帮助。"}, {"type": "subtitle", "time": 3825.349, "timestamp": "01:03:45", "text": "不，我们很好。我们很好。为什么？我们为何如此"}, {"type": "subtitle", "time": 3827.91, "timestamp": "01:03:47", "text": "站在这里？"}, {"type": "subtitle", "time": 3832.309, "timestamp": "01:03:52", "text": "好的。比如什么？再次。不，不，不。"}, {"type": "subtitle", "time": 3835.51, "timestamp": "01:03:55", "text": "好的。好的。呃，不。不。为什么？不，停。"}, {"type": "subtitle", "time": 3836.75, "timestamp": "01:03:56", "text": "停止。停止。停止。"}, {"type": "subtitle", "time": 3838.87, "timestamp": "01:03:58", "text": "停止。我正把它举到身体一侧。"}]
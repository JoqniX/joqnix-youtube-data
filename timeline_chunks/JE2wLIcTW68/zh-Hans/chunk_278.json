[{"type": "subtitle", "time": 16683.349, "timestamp": "04:38:03", "text": "好的。接下来是乔。然后是阿斯特拉，对吧？ ITP 到 ITP"}, {"type": "subtitle", "time": 16685.029, "timestamp": "04:38:05", "text": "你。"}, {"type": "subtitle", "time": 16687.109, "timestamp": "04:38:07", "text": "不，他不在这里。我看不见他。"}, {"type": "subtitle", "time": 16689.67, "timestamp": "04:38:09", "text": "他在哪儿？哦，他飞起来了。什么？"}, {"type": "subtitle", "time": 16691.269, "timestamp": "04:38:11", "text": "是的。是的，我正在做一些事情。我告诉"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "我要去做一件事。正确的。"}, {"type": "subtitle", "time": 16699.75, "timestamp": "04:38:19", "text": "保持在这条线以下。我来给你看"}, {"type": "subtitle", "time": 16703.709, "timestamp": "04:38:23", "text": "给我的棍子添点酷炫的东西。"}, {"type": "subtitle", "time": 16706.91, "timestamp": "04:38:26", "text": "嗯，我的天哪，我需要"}, {"type": "subtitle", "time": 16715.949, "timestamp": "04:38:35", "text": "奥比迪安和"}, {"type": "subtitle", "time": 16719.67, "timestamp": "04:38:39", "text": "呃，你想让我教你旁遮普语吗？"}, {"type": "subtitle", "time": 16727.189, "timestamp": "04:38:47", "text": "一秒钟。好的，我去拿我的东西。"}, {"type": "subtitle", "time": 16730.789, "timestamp": "04:38:50", "text": "你可以教书。哦，"}, {"type": "subtitle", "time": 16731.869, "timestamp": "04:38:51", "text": "让我"}, {"type": "subtitle", "time": 16734.47, "timestamp": "04:38:54", "text": "思考。等等，你为什么要这么做？"}, {"type": "subtitle", "time": 16736.949, "timestamp": "04:38:56", "text": "下界传送门？"}, {"type": "subtitle", "time": 16739.51, "timestamp": "04:38:59", "text": "不，你做不到。"}]
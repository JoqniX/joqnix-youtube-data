[{"type": "subtitle", "time": 10860.15, "timestamp": "03:01:00", "text": "我忘了我还有赏金任务。我给了你赏金。"}, {"type": "subtitle", "time": 10880.95, "timestamp": "03:01:20", "text": "亲爱的，跳进水里。这是什么？"}, {"type": "subtitle", "time": 10884.99, "timestamp": "03:01:24", "text": "竹子 R。你可以制作竹子。哦"}, {"type": "subtitle", "time": 10888.63, "timestamp": "03:01:28", "text": "我的。这是什么？这是个合同。它"}, {"type": "subtitle", "time": 10890.95, "timestamp": "03:01:30", "text": "它能让你在水中看清东西，而且"}, {"type": "subtitle", "time": 10893.269, "timestamp": "03:01:33", "text": "让你得以呼吸。"}, {"type": "subtitle", "time": 10895.59, "timestamp": "03:01:35", "text": "我永远不会"}, {"type": "subtitle", "time": 10898.389, "timestamp": "03:01:38", "text": "我能听到心跳声。"}, {"type": "subtitle", "time": 10901.59, "timestamp": "03:01:41", "text": "那是一个导管。"}, {"type": "subtitle", "time": 10904.15, "timestamp": "03:01:44", "text": "该死。"}, {"type": "subtitle", "time": 10906.55, "timestamp": "03:01:46", "text": "所以现在你可以在水下待多久？"}, {"type": "subtitle", "time": 10911.469, "timestamp": "03:01:51", "text": "你想要。另外，我还有很多豇豆。"}, {"type": "subtitle", "time": 10914.309, "timestamp": "03:01:54", "text": "哇。就像 axelottals 是"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "像是这个地方的守护者之类的。"}, {"type": "subtitle", "time": 10919.429, "timestamp": "03:01:59", "text": "就像把它包围起来一样。是的，我用过"}]
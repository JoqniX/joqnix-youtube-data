[{"type": "subtitle", "time": 19921.11, "timestamp": "05:32:01", "text": "[音乐]"}, {"type": "subtitle", "time": 19925.03, "timestamp": "05:32:05", "text": "有人给我做了一个西红柿。什么？它是"}, {"type": "subtitle", "time": 19934.548, "timestamp": "05:32:14", "text": "是的。他们让我像狗一样唱马拉拉姆歌"}, {"type": "subtitle", "time": 19937.75, "timestamp": "05:32:17", "text": "歌曲。但别告诉我我不能"}, {"type": "subtitle", "time": 19940.31, "timestamp": "05:32:20", "text": "唱马拉拉姆歌。我不听。"}, {"type": "subtitle", "time": 19944.15, "timestamp": "05:32:24", "text": "你必须唱歌。你有。是的。不"}, {"type": "subtitle", "time": 19946.23, "timestamp": "05:32:26", "text": "去做。你正在学习唱歌。你"}, {"type": "subtitle", "time": 19948.75, "timestamp": "05:32:28", "text": "必须唱一首马拉拉姆歌。你觉得我"}, {"type": "subtitle", "time": 19951.19, "timestamp": "05:32:31", "text": "学习？不，我根本不学英语"}, {"type": "subtitle", "time": 19953.91, "timestamp": "05:32:33", "text": "歌曲。 D. 我就用日语吧"}, {"type": "subtitle", "time": 19955.91, "timestamp": "05:32:35", "text": "原因不明。"}, {"type": "subtitle", "time": 19965.27, "timestamp": "05:32:45", "text": "你知道，你知道，我们能唱这首歌。"}, {"type": "subtitle", "time": 19969.31, "timestamp": "05:32:49", "text": "哦，不。不，不，不，不。我听到一个"}]
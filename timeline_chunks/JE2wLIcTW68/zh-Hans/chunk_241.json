[{"type": "subtitle", "time": 14461.59, "timestamp": "04:01:01", "text": "但你本来可以拥有"}, {"type": "subtitle", "time": 14464.469, "timestamp": "04:01:04", "text": "我像个疯子一样刷完了电影活动。"}, {"type": "subtitle", "time": 14466.71, "timestamp": "04:01:06", "text": "正在做。是的，我做过。我做了。我"}, {"type": "subtitle", "time": 14469.03, "timestamp": "04:01:09", "text": "不要使用石油。"}, {"type": "subtitle", "time": 14474.07, "timestamp": "04:01:14", "text": "啊，不。基岩版和Java版都有。不，我"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "买了一个，但是是从 Bedrock 买的。这"}, {"type": "subtitle", "time": 14478.389, "timestamp": "04:01:18", "text": "蓝色的那个，还有红色的那个抖音视频我都拍了"}, {"type": "subtitle", "time": 14481.59, "timestamp": "04:01:21", "text": "没收到。不，是那个"}, {"type": "subtitle", "time": 14485.59, "timestamp": "04:01:25", "text": "我的世界活动，一部电影活动。是的，"}, {"type": "subtitle", "time": 14488.309, "timestamp": "04:01:28", "text": "当你观看时，那就是……"}, {"type": "subtitle", "time": 14492.229, "timestamp": "04:01:32", "text": "蓝色的那个。我是指橙色的那个。"}, {"type": "subtitle", "time": 14494.309, "timestamp": "04:01:34", "text": "就是抖音那个。不是抖音那个。"}, {"type": "subtitle", "time": 14496.15, "timestamp": "04:01:36", "text": "你通过参加活动获得的那个"}, {"type": "subtitle", "time": 14500.63, "timestamp": "04:01:40", "text": "我当时正在基岩上研磨它。"}, {"type": "subtitle", "time": 14503.229, "timestamp": "04:01:43", "text": "是的，这件事过去了。"}, {"type": "subtitle", "time": 14505.91, "timestamp": "04:01:45", "text": "今天。你必须挖矿，你必须"}, {"type": "subtitle", "time": 14509.59, "timestamp": "04:01:49", "text": "保护自己免受小猪和其他许多动物的侵害"}]
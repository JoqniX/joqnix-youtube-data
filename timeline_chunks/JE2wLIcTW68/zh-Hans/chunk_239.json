[{"type": "subtitle", "time": 14349.91, "timestamp": "03:59:09", "text": "现在好些了吗？"}, {"type": "subtitle", "time": 14351.91, "timestamp": "03:59:11", "text": "我在飞行。"}, {"type": "subtitle", "time": 14355.59, "timestamp": "03:59:15", "text": "等等，什么？你飞行情况如何？"}, {"type": "subtitle", "time": 14358.229, "timestamp": "03:59:18", "text": "比如你打败了boss，然后你发现"}, {"type": "subtitle", "time": 14361.67, "timestamp": "03:59:21", "text": "在那座城市里，你将获得翅膀，"}, {"type": "subtitle", "time": 14364.07, "timestamp": "03:59:24", "text": "它会让你飞翔。等等，你真的……"}, {"type": "subtitle", "time": 14365.75, "timestamp": "03:59:25", "text": "必须在不击败boss的情况下完成此操作"}, {"type": "subtitle", "time": 14368.03, "timestamp": "03:59:28", "text": "打败boss了吗？你可以做到。"}, {"type": "subtitle", "time": 14370.87, "timestamp": "03:59:30", "text": "不。你必须这样做，你可以做到，但是你"}, {"type": "subtitle", "time": 14372.75, "timestamp": "03:59:32", "text": "必须建造"}, {"type": "subtitle", "time": 14375.71, "timestamp": "03:59:35", "text": "建造直到找到一座城市"}, {"type": "subtitle", "time": 14378.229, "timestamp": "03:59:38", "text": "你自己。哦"}, {"type": "subtitle", "time": 14381.189, "timestamp": "03:59:41", "text": "所以，从 Boss 战区域的边缘开始"}, {"type": "subtitle", "time": 14383.349, "timestamp": "03:59:43", "text": "你必须修建一条笔直的道路，直到"}, {"type": "subtitle", "time": 14385.51, "timestamp": "03:59:45", "text": "你找到某个城市。"}, {"type": "subtitle", "time": 14387.189, "timestamp": "03:59:47", "text": "啊，"}]
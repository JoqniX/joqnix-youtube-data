[{"type": "subtitle", "time": 18481.43, "timestamp": "05:08:01", "text": "[音乐]"}, {"type": "subtitle", "time": 18484.708, "timestamp": "05:08:04", "text": "不，我们的房子比那边漂亮得多。"}, {"type": "subtitle", "time": 18487.11, "timestamp": "05:08:07", "text": "这。"}, {"type": "subtitle", "time": 18489.19, "timestamp": "05:08:09", "text": "呃，嗯，错觉可不是什么好事。"}, {"type": "subtitle", "time": 18491.35, "timestamp": "05:08:11", "text": "你知道。"}, {"type": "subtitle", "time": 18503.19, "timestamp": "05:08:23", "text": "紫晶。"}, {"type": "subtitle", "time": 18506.55, "timestamp": "05:08:26", "text": "应该说"}, {"type": "subtitle", "time": 18508.67, "timestamp": "05:08:28", "text": "因为他害怕。"}, {"type": "subtitle", "time": 18510.75, "timestamp": "05:08:30", "text": "正确的？我不"}, {"type": "subtitle", "time": 18515.11, "timestamp": "05:08:35", "text": "知道。你在哪里？"}, {"type": "subtitle", "time": 18518.31, "timestamp": "05:08:38", "text": "我是。好的。没关系。我不需要"}, {"type": "subtitle", "time": 18523.35, "timestamp": "05:08:43", "text": "那。我已经有64颗绿宝石了。"}, {"type": "subtitle", "time": 18536.948, "timestamp": "05:08:56", "text": "我是蚊子。我看到你在飞翔。"}, {"type": "subtitle", "time": 18538.51, "timestamp": "05:08:58", "text": "好的。所以"}]
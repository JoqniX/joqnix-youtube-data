[{"type": "subtitle", "time": 11953.429, "timestamp": "03:19:13", "text": "是的。嗯，是的。是的。是的。这位保姆。"}, {"type": "subtitle", "time": 11955.07, "timestamp": "03:19:15", "text": "这"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "哦，这是"}, {"type": "subtitle", "time": 11963.429, "timestamp": "03:19:23", "text": "哦，是的。哦，是的。我们无法带来"}, {"type": "subtitle", "time": 11966.229, "timestamp": "03:19:26", "text": "这"}, {"type": "subtitle", "time": 11968.389, "timestamp": "03:19:28", "text": "确切地。"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "我的天啊。我想通过私信提醒你一下。"}, {"type": "subtitle", "time": 11977.349, "timestamp": "03:19:37", "text": "带上那件武器去吓唬阿斯特拉。"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "我会去拿我想要的武器，就像我"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "别害怕。什么武器？光盘"}, {"type": "subtitle", "time": 11987.99, "timestamp": "03:19:47", "text": "归航盘。"}, {"type": "subtitle", "time": 11990.83, "timestamp": "03:19:50", "text": "哦，你是怎么做到的？"}, {"type": "subtitle", "time": 11995.429, "timestamp": "03:19:55", "text": "不，我的意思是，我不知道该如何回答这个问题。"}]
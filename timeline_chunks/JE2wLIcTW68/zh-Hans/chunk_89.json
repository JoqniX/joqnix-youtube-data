[{"type": "subtitle", "time": 5341.91, "timestamp": "01:29:01", "text": "我。我的天啊。好的，我这就去"}, {"type": "subtitle", "time": 5350.79, "timestamp": "01:29:10", "text": "这。好了。他快要死了。"}, {"type": "subtitle", "time": 5355.43, "timestamp": "01:29:15", "text": "车卡不够用"}, {"type": "subtitle", "time": 5357.11, "timestamp": "01:29:17", "text": "由于规则限制，剩余分数不多。"}, {"type": "subtitle", "time": 5369.229, "timestamp": "01:29:29", "text": "这里。我们在这件事上得到了多少"}, {"type": "subtitle", "time": 5372.189, "timestamp": "01:29:32", "text": "婊子？ 5,000。他妈的"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "我的天，看来我们用不上你了。"}, {"type": "subtitle", "time": 5392.47, "timestamp": "01:29:52", "text": "凉爽的。别看它。不要看"}]
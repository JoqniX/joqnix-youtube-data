[{"type": "subtitle", "time": 14186.71, "timestamp": "03:56:26", "text": "我的天啊。我看到了。"}, {"type": "subtitle", "time": 14190.55, "timestamp": "03:56:30", "text": "呃，左转停下。我还弄坏了什么东西。"}, {"type": "subtitle", "time": 14193.59, "timestamp": "03:56:33", "text": "我想那对我来说意义非凡。需要"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "再次找到它。"}, {"type": "subtitle", "time": 14203.51, "timestamp": "03:56:43", "text": "哦，是的，我不能。我们不能使用滑梯"}, {"type": "subtitle", "time": 14212.389, "timestamp": "03:56:52", "text": "我找不到任何人。"}, {"type": "subtitle", "time": 14214.79, "timestamp": "03:56:54", "text": "你可以再次在首领处重生。"}, {"type": "subtitle", "time": 14218.87, "timestamp": "03:56:58", "text": "哦，等等。什么？那是什么？"}]
[{"type": "subtitle", "time": 1441.11, "timestamp": "00:24:01", "text": "这边很多，兄弟。好的，我们开始吧"}, {"type": "subtitle", "time": 1443.99, "timestamp": "00:24:03", "text": "把它拿回去。快点。"}, {"type": "subtitle", "time": 1445.35, "timestamp": "00:24:05", "text": "我要去清理道路"}, {"type": "subtitle", "time": 1448.47, "timestamp": "00:24:08", "text": "因为我的HP也就只有1点。那不是"}, {"type": "subtitle", "time": 1469.51, "timestamp": "00:24:29", "text": "死的。不。我的天哪。我的天啊。那"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "我们赚了很多钱。是的。打扰一下。"}, {"type": "subtitle", "time": 1480.549, "timestamp": "00:24:40", "text": "我们走吧。当然。等待。乔。停留"}, {"type": "subtitle", "time": 1487.35, "timestamp": "00:24:47", "text": "什么？那是什么？不，当你跳跃时，"}, {"type": "subtitle", "time": 1488.87, "timestamp": "00:24:48", "text": "当你奔跑、跳跃并撞到某人时"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "按下Q键，它会像翻滚发射一样发射出去。"}, {"type": "subtitle", "time": 1494.71, "timestamp": "00:24:54", "text": "这真是太棒了。是的，我喜欢"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "翻滚发射。就像51岁一样。真搞笑。"}, {"type": "subtitle", "time": 1499.51, "timestamp": "00:24:59", "text": "同时，也喜欢它"}]
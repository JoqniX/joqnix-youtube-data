[{"type": "subtitle", "time": 17043.628, "timestamp": "04:44:03", "text": "呃，我们可以上去，对吧？有一个"}, {"type": "subtitle", "time": 17048.43, "timestamp": "04:44:08", "text": "阳台。该死。阳台之类的。"}, {"type": "subtitle", "time": 17057.99, "timestamp": "04:44:17", "text": "是的，我们可以，您可以进行定制。你"}, {"type": "subtitle", "time": 17061.35, "timestamp": "04:44:21", "text": "你可以在其中做自己想做的事。哦，"}, {"type": "subtitle", "time": 17068.948, "timestamp": "04:44:28", "text": "高的。你身体有弹性，所以不会死。"}, {"type": "subtitle", "time": 17071.67, "timestamp": "04:44:31", "text": "是的，我知道。但我恐高。"}, {"type": "subtitle", "time": 17075.27, "timestamp": "04:44:35", "text": "尽管。就是这样。哦，我忘了……"}, {"type": "subtitle", "time": 17083.75, "timestamp": "04:44:43", "text": "你获得了赏金。把鞋子给我。"}, {"type": "subtitle", "time": 17087.27, "timestamp": "04:44:47", "text": "是的。是的。我当时穿着那个bo形的东西"}, {"type": "subtitle", "time": 17089.59, "timestamp": "04:44:49", "text": "这么长时间以来。"}, {"type": "subtitle", "time": 17093.59, "timestamp": "04:44:53", "text": "你看，这就是主宫殿。我可以"}, {"type": "subtitle", "time": 17096.31, "timestamp": "04:44:56", "text": "把它布置成卧室的样子。等等，我"}]
[{"type": "subtitle", "time": 19380.628, "timestamp": "05:23:00", "text": "[音乐]"}, {"type": "subtitle", "time": 19408.15, "timestamp": "05:23:28", "text": "我觉得，嗯，我可以。"}, {"type": "subtitle", "time": 19410.15, "timestamp": "05:23:30", "text": "好的。呃"}, {"type": "subtitle", "time": 19421.19, "timestamp": "05:23:41", "text": "说话很得体的孩子。什么是 shar？我"}, {"type": "subtitle", "time": 19424.39, "timestamp": "05:23:44", "text": "认为他明白他并不无辜，而且"}, {"type": "subtitle", "time": 19428.39, "timestamp": "05:23:48", "text": "幼稚的。啊，天真无邪啊。然后那个东西"}, {"type": "subtitle", "time": 19431.03, "timestamp": "05:23:51", "text": "他跟那个小屁孩什么的混在一起。没有小屁孩"}, {"type": "subtitle", "time": 19434.948, "timestamp": "05:23:54", "text": "就像……呃，叛逆者。不像是什么"}, {"type": "subtitle", "time": 19438.07, "timestamp": "05:23:58", "text": "单词？呃，就像个惹事生非的人。"}]
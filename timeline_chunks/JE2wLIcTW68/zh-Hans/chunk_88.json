[{"type": "subtitle", "time": 5281.99, "timestamp": "01:28:01", "text": "我。闭嘴。"}, {"type": "subtitle", "time": 5304.27, "timestamp": "01:28:24", "text": "我。是什么？"}, {"type": "subtitle", "time": 5305.95, "timestamp": "01:28:25", "text": "那玩意儿？"}, {"type": "subtitle", "time": 5309.51, "timestamp": "01:28:29", "text": "兄弟，我罩着你。别担心，"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "伙伴。我们将幸福长久地生活下去。"}, {"type": "subtitle", "time": 5315.629, "timestamp": "01:28:35", "text": "对我们来说，生活。我很漂亮"}, {"type": "subtitle", "time": 5319.629, "timestamp": "01:28:39", "text": "当然。嗯，这样可以。那"}, {"type": "subtitle", "time": 5326.669, "timestamp": "01:28:46", "text": "等等，等等，等等。"}, {"type": "subtitle", "time": 5328.79, "timestamp": "01:28:48", "text": "好的。好的。好的。我们很好。我们"}, {"type": "subtitle", "time": 5335.03, "timestamp": "01:28:55", "text": "后退。我没空搭理你"}, {"type": "subtitle", "time": 5338.59, "timestamp": "01:28:58", "text": "废话。滚开"}]
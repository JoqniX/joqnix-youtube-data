[{"type": "subtitle", "time": 12180.91, "timestamp": "03:23:00", "text": "应该被传唤。那是唯一的"}, {"type": "subtitle", "time": 12183.67, "timestamp": "03:23:03", "text": "计划。当你们无法做到的时候"}, {"type": "subtitle", "time": 12187.11, "timestamp": "03:23:07", "text": "干掉那两个，对吧？我喜欢我"}, {"type": "subtitle", "time": 12191.19, "timestamp": "03:23:11", "text": "我私下跟版主说要把它干掉，但是"}, {"type": "subtitle", "time": 12193.67, "timestamp": "03:23:13", "text": "他们中没有人杀死它。我没有"}, {"type": "subtitle", "time": 12195.429, "timestamp": "03:23:15", "text": "知道是谁再次制造了它，"}, {"type": "subtitle", "time": 12198.63, "timestamp": "03:23:18", "text": "再次。不是我。"}, {"type": "subtitle", "time": 12200.79, "timestamp": "03:23:20", "text": "什么？"}, {"type": "subtitle", "time": 12202.87, "timestamp": "03:23:22", "text": "所以显然，这并非计划之内的事情。"}, {"type": "subtitle", "time": 12205.269, "timestamp": "03:23:25", "text": "很多下界护手。"}, {"type": "subtitle", "time": 12209.71, "timestamp": "03:23:29", "text": "起泡的。谁性格活泼开朗？等待。这是什么？"}, {"type": "subtitle", "time": 12214.15, "timestamp": "03:23:34", "text": "这是什么？起泡的。哦，等等。哦，"}, {"type": "subtitle", "time": 12215.99, "timestamp": "03:23:35", "text": "对不起。对不起。对不起。对不起。对不起。"}, {"type": "subtitle", "time": 12218.15, "timestamp": "03:23:38", "text": "来自 Bubbly 的钻石。对不起。对不起。"}, {"type": "subtitle", "time": 12221.83, "timestamp": "03:23:41", "text": "对不起。点击它。嗯嗯。拿着吧。拿"}, {"type": "subtitle", "time": 12223.75, "timestamp": "03:23:43", "text": "它。对不起。对不起。起泡的。持有任何物品"}, {"type": "subtitle", "time": 12226.95, "timestamp": "03:23:46", "text": "你把它给。哇。"}, {"type": "subtitle", "time": 12230.55, "timestamp": "03:23:50", "text": "这是一个难缠的魔像。等待。哦，不。的"}, {"type": "subtitle", "time": 12232.79, "timestamp": "03:23:52", "text": "哦，不。职位。它会回来的"}, {"type": "subtitle", "time": 12235.269, "timestamp": "03:23:55", "text": "到达目的地。它会回来的。那是"}, {"type": "subtitle", "time": 12237.59, "timestamp": "03:23:57", "text": "平淡无奇的东西。"}]
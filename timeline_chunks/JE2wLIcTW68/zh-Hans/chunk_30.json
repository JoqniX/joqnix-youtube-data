[{"type": "subtitle", "time": 1802.149, "timestamp": "00:30:02", "text": "在这辆车里。直接放进购物车就行了。"}, {"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "是的，"}, {"type": "subtitle", "time": 1805.83, "timestamp": "00:30:05", "text": "听着。我在店里说"}, {"type": "subtitle", "time": 1808.47, "timestamp": "00:30:08", "text": "那里有一架羽毛无人机。我正在打电话"}, {"type": "subtitle", "time": 1811.269, "timestamp": "00:30:11", "text": "我先预定了。有人能帮帮我吗？"}, {"type": "subtitle", "time": 1814.07, "timestamp": "00:30:14", "text": "这里。"}, {"type": "subtitle", "time": 1816.31, "timestamp": "00:30:16", "text": "请帮帮我们。记住，这是物理学。"}, {"type": "subtitle", "time": 1818.31, "timestamp": "00:30:18", "text": "基于。所以这也取决于你喜欢什么"}, {"type": "subtitle", "time": 1819.909, "timestamp": "00:30:19", "text": "不，不，别放。不，不，就保持这样吧。"}, {"type": "subtitle", "time": 1821.99, "timestamp": "00:30:21", "text": "提炼。哦，对，保持萃取状态。"}, {"type": "subtitle", "time": 1825.75, "timestamp": "00:30:25", "text": "是的，大件物品总是在提取过程中出现。"}, {"type": "subtitle", "time": 1828.389, "timestamp": "00:30:28", "text": "如果超过……是的。如果是这样的话"}, {"type": "subtitle", "time": 1830.47, "timestamp": "00:30:30", "text": "如果超过了，那就总是想保持下去。"}, {"type": "subtitle", "time": 1832.95, "timestamp": "00:30:32", "text": "就在附近。好的。我们可以把那个东西拿掉吗？"}, {"type": "subtitle", "time": 1835.75, "timestamp": "00:30:35", "text": "还是真的要等等？不，我们可以。是"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "好的。我们很好。好的。呃，不，不，不。"}, {"type": "subtitle", "time": 1839.75, "timestamp": "00:30:39", "text": "我们不等。好的。把它带回来。带来"}, {"type": "subtitle", "time": 1842.31, "timestamp": "00:30:42", "text": "把它还回去。我的天哪。我的天哪。我的天哪。好的。"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "好的。没关系。没关系。离开"}, {"type": "subtitle", "time": 1847.389, "timestamp": "00:30:47", "text": "它在那里。不，不。呃，那个哥布林的东西是"}, {"type": "subtitle", "time": 1850.549, "timestamp": "00:30:50", "text": "呃，打火机。所以，大家还是小心点吧。是"}]
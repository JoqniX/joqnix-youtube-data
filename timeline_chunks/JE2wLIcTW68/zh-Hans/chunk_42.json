[{"type": "subtitle", "time": 2523.67, "timestamp": "00:42:03", "text": "好像有时间限制之类的。"}, {"type": "subtitle", "time": 2525.71, "timestamp": "00:42:05", "text": "头屁股在哪儿？不，不，总有一天会实现的。"}, {"type": "subtitle", "time": 2529.91, "timestamp": "00:42:09", "text": "限制。绝对没问题。"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "我没事。是的，他一直躲藏着。哦，我的"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "上帝。你说的“躲藏”是什么意思？我当时"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "吃东西啦，兄弟。快点。"}, {"type": "subtitle", "time": 2540.47, "timestamp": "00:42:20", "text": "晚餐时间到了。哦，我要羞辱别人了。"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "你太难了。晚餐时间。你是什​​么"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "意思是？是的。你知道吗？好的。更多的"}, {"type": "subtitle", "time": 2548.309, "timestamp": "00:42:28", "text": "升级。等等，那是什么？"}, {"type": "subtitle", "time": 2563.109, "timestamp": "00:42:43", "text": "那。兄弟，你这次没打中。挥动"}, {"type": "subtitle", "time": 2571.39, "timestamp": "00:42:51", "text": "这东西是"}, {"type": "subtitle", "time": 2576.15, "timestamp": "00:42:56", "text": "说得对。嘿，乔。过来。嘿，乔。"}]
[{"type": "subtitle", "time": 18124.07, "timestamp": "05:02:04", "text": "合成器音垫什么的，嗯，是的。"}, {"type": "subtitle", "time": 18127.27, "timestamp": "05:02:07", "text": "我当时非常沮丧。我不喜欢它。"}, {"type": "subtitle", "time": 18128.708, "timestamp": "05:02:08", "text": "所以我就想，“好吧，你知道吗？”"}, {"type": "subtitle", "time": 18130.868, "timestamp": "05:02:10", "text": "我干脆花钱请人帮我做算了。我"}, {"type": "subtitle", "time": 18134.788, "timestamp": "05:02:14", "text": "我不想独自去做这件事。"}, {"type": "subtitle", "time": 18137.11, "timestamp": "05:02:17", "text": "是的。安排妥当等等。"}, {"type": "subtitle", "time": 18171.03, "timestamp": "05:02:51", "text": "哦，糟糕。我得努力搞清楚“哦，糟糕”。"}, {"type": "subtitle", "time": 18174.788, "timestamp": "05:02:54", "text": "我忘了。我得去做ASMR。"}, {"type": "subtitle", "time": 18177.27, "timestamp": "05:02:57", "text": "哦，为什么？"}]
[{"type": "subtitle", "time": 9793.63, "timestamp": "02:43:13", "text": "无限"}, {"type": "subtitle", "time": 9798.75, "timestamp": "02:43:18", "text": "钥匙。她拥有Mato皮肤。"}, {"type": "subtitle", "time": 9802.15, "timestamp": "02:43:22", "text": "什么？我的天啊。 Suki，兄弟。我想要"}, {"type": "subtitle", "time": 9804.91, "timestamp": "02:43:24", "text": "玩《无限》，"}, {"type": "subtitle", "time": 9806.07, "timestamp": "02:43:26", "text": "男人。"}, {"type": "subtitle", "time": 9808.19, "timestamp": "02:43:28", "text": "[音乐]"}, {"type": "subtitle", "time": 9811.27, "timestamp": "02:43:31", "text": "嗯。总之，我应该停止滚动页面了。"}]
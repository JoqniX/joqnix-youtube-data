[{"type": "subtitle", "time": 3242.63, "timestamp": "00:54:02", "text": "那里。她的屁股也在那里吗？哦好的。"}, {"type": "subtitle", "time": 3256.549, "timestamp": "00:54:16", "text": "死？我应该这么做，对吧？全部"}, {"type": "subtitle", "time": 3261.549, "timestamp": "00:54:21", "text": "我的朋友们都死了。我的天啊。哦"}, {"type": "subtitle", "time": 3265.1, "timestamp": "00:54:25", "text": "我的上帝。"}, {"type": "subtitle", "time": 3285.19, "timestamp": "00:54:45", "text": "这个。"}, {"type": "subtitle", "time": 3287.43, "timestamp": "00:54:47", "text": "我们可以把它放在卡片里。我会做我"}, {"type": "subtitle", "time": 3290.23, "timestamp": "00:54:50", "text": "非常抱歉。我不是故意吓你的。"}, {"type": "subtitle", "time": 3294.23, "timestamp": "00:54:54", "text": "我不是故意用瞄准镜吓唬你的。"}, {"type": "subtitle", "time": 3297.67, "timestamp": "00:54:57", "text": "等等，这是什么？之前放置的东西"}]
[{"type": "subtitle", "time": 17105.23, "timestamp": "04:45:05", "text": "如何？什么？等待。"}, {"type": "subtitle", "time": 17107.788, "timestamp": "04:45:07", "text": "嗯？"}, {"type": "subtitle", "time": 17118.628, "timestamp": "04:45:18", "text": "等等，你们也这样吗？"}, {"type": "subtitle", "time": 17125.51, "timestamp": "04:45:25", "text": "嗯？"}, {"type": "subtitle", "time": 17137.99, "timestamp": "04:45:37", "text": "我的天啊。我的天哪。我快要死了。"}, {"type": "subtitle", "time": 17140.91, "timestamp": "04:45:40", "text": "别死。"}, {"type": "subtitle", "time": 17144.27, "timestamp": "04:45:44", "text": "什么？为什么？我不能"}, {"type": "subtitle", "time": 17147.35, "timestamp": "04:45:47", "text": "帮助。我们就像真的置身其中"}, {"type": "subtitle", "time": 17149.51, "timestamp": "04:45:49", "text": "云。"}, {"type": "subtitle", "time": 17152.788, "timestamp": "04:45:52", "text": "你们在哪儿？"}, {"type": "subtitle", "time": 17155.75, "timestamp": "04:45:55", "text": "我在城堡里，但我可以使用僵尸形态。"}, {"type": "subtitle", "time": 17159.35, "timestamp": "04:45:59", "text": "为什么？呃，因为肯定得有个地下室。"}]
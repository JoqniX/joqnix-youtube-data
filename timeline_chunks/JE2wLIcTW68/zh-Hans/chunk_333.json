[{"type": "subtitle", "time": 19994.91, "timestamp": "05:33:14", "text": "等待。先干掉这个"}, {"type": "subtitle", "time": 19997.47, "timestamp": "05:33:17", "text": "事物。是的。好的。它是"}, {"type": "subtitle", "time": 20001.15, "timestamp": "05:33:21", "text": "走了。它并没有消失。它仍然是"}, {"type": "subtitle", "time": 20006.27, "timestamp": "05:33:26", "text": "这里。好的。我把它杀了。嘿。"}, {"type": "subtitle", "time": 20033.35, "timestamp": "05:33:53", "text": "你弄到我鼻子上了。我不知道为什么"}, {"type": "subtitle", "time": 20035.99, "timestamp": "05:33:55", "text": "它很可爱。"}, {"type": "subtitle", "time": 20038.07, "timestamp": "05:33:58", "text": "我不知道。"}]
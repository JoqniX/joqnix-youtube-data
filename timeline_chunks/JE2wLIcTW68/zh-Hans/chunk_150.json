[{"type": "subtitle", "time": 9001.83, "timestamp": "02:30:01", "text": "除非我真的非常需要，否则我不会自己做这件事。"}, {"type": "subtitle", "time": 9005.95, "timestamp": "02:30:05", "text": "爱它。我要求佣金"}, {"type": "subtitle", "time": 9008.23, "timestamp": "02:30:08", "text": "某人。大多数时候我更喜欢"}, {"type": "subtitle", "time": 9011.03, "timestamp": "02:30:11", "text": "我自己做，因为如果你做"}, {"type": "subtitle", "time": 9013.07, "timestamp": "02:30:13", "text": "你自己就能体会到这种感觉。"}, {"type": "subtitle", "time": 9015.83, "timestamp": "02:30:15", "text": "算是取得成就之类的吧？"}, {"type": "subtitle", "time": 9019.27, "timestamp": "02:30:19", "text": "成就，或者类似那种东西，啊"}, {"type": "subtitle", "time": 9022.51, "timestamp": "02:30:22", "text": "是的，是我做的。是我自己做的。"}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "我。我为……做了一件事"}, {"type": "subtitle", "time": 9029.63, "timestamp": "02:30:29", "text": "我。那种感觉真好。"}, {"type": "subtitle", "time": 9034.71, "timestamp": "02:30:34", "text": "正确的？ M，但同样的道理也适用于你。"}, {"type": "subtitle", "time": 9036.91, "timestamp": "02:30:36", "text": "如果你在接委托之类的活儿的话"}, {"type": "subtitle", "time": 9039.429, "timestamp": "02:30:39", "text": "没错，你只应该……"}, {"type": "subtitle", "time": 9040.83, "timestamp": "02:30:40", "text": "提供"}, {"type": "subtitle", "time": 9045.59, "timestamp": "02:30:45", "text": "优质产品，给您带来优质体验。"}, {"type": "subtitle", "time": 9048.389, "timestamp": "02:30:48", "text": "客户而不是一个"}, {"type": "subtitle", "time": 9051.75, "timestamp": "02:30:51", "text": "非常无聊，或者说制作非常粗糙。"}, {"type": "subtitle", "time": 9053.51, "timestamp": "02:30:53", "text": "把事情做好，你的客户就不会……"}, {"type": "subtitle", "time": 9056.95, "timestamp": "02:30:56", "text": "满意了吧，所以，是的，一些事情"}, {"type": "subtitle", "time": 9059.51, "timestamp": "02:30:59", "text": "满足他人或满足"}]
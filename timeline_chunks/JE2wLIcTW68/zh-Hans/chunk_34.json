[{"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "真是个混蛋。"}, {"type": "subtitle", "time": 2045.9, "timestamp": "00:34:05", "text": "我很好。我很好。"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "哟，最近怎么样？"}, {"type": "subtitle", "time": 2057.829, "timestamp": "00:34:17", "text": "我的天啊。好的，我这就到。"}, {"type": "subtitle", "time": 2067.03, "timestamp": "00:34:27", "text": "它不见了吗？呃，Crater已经死了。火山口"}, {"type": "subtitle", "time": 2069.51, "timestamp": "00:34:29", "text": "已死亡。"}, {"type": "subtitle", "time": 2072.23, "timestamp": "00:34:32", "text": "我的天啊。我们难道不能杀死它吗？"}, {"type": "subtitle", "time": 2076.629, "timestamp": "00:34:36", "text": "某物？我可以试试。"}, {"type": "subtitle", "time": 2091.99, "timestamp": "00:34:51", "text": "什么？我杀了那只鸭子。嘿，不错。"}, {"type": "subtitle", "time": 2095.069, "timestamp": "00:34:55", "text": "我们走吧。那是角。"}, {"type": "subtitle", "time": 2097.27, "timestamp": "00:34:57", "text": "拉屎。那是地雷。好的。别别"}]
[{"type": "subtitle", "time": 16155.51, "timestamp": "04:29:15", "text": "[音乐]"}, {"type": "subtitle", "time": 16183.67, "timestamp": "04:29:43", "text": "爸爸，你在做什么？"}, {"type": "subtitle", "time": 16185.91, "timestamp": "04:29:45", "text": "等等，是我吗？"}, {"type": "subtitle", "time": 16188.95, "timestamp": "04:29:48", "text": "他现在就在我的城堡里。"}, {"type": "subtitle", "time": 16191.189, "timestamp": "04:29:51", "text": "我正在骑着那把霍格沃茨扫帚"}, {"type": "subtitle", "time": 16194.229, "timestamp": "04:29:54", "text": "竖起来。你知道吗？我可以拥有"}, {"type": "subtitle", "time": 16197.03, "timestamp": "04:29:57", "text": "一些很酷的东西。我不会再等了。我让我"}, {"type": "subtitle", "time": 16199.03, "timestamp": "04:29:59", "text": "给我一秒钟。让我来做一次"}]
[{"type": "subtitle", "time": 17762.07, "timestamp": "04:56:02", "text": "是的，我的课程快要结束了。"}, {"type": "subtitle", "time": 17764.628, "timestamp": "04:56:04", "text": "啊"}, {"type": "subtitle", "time": 17768.39, "timestamp": "04:56:08", "text": "是的，我没有证书，但是"}, {"type": "subtitle", "time": 17771.43, "timestamp": "04:56:11", "text": "知道该怎么做。"}, {"type": "subtitle", "time": 17780.07, "timestamp": "04:56:20", "text": "我想创作属于我自己的原创作品。我心地善良"}, {"type": "subtitle", "time": 17783.27, "timestamp": "04:56:23", "text": "正在努力。我有歌词，"}, {"type": "subtitle", "time": 17785.59, "timestamp": "04:56:25", "text": "东西，"}, {"type": "subtitle", "time": 17787.91, "timestamp": "04:56:27", "text": "但事实并非如此"}, {"type": "subtitle", "time": 17790.708, "timestamp": "04:56:30", "text": "这跟动漫之类的东西无关。"}, {"type": "subtitle", "time": 17802.31, "timestamp": "04:56:42", "text": "就这么说。是的。"}, {"type": "subtitle", "time": 17804.59, "timestamp": "04:56:44", "text": "喜欢"}, {"type": "subtitle", "time": 17807.31, "timestamp": "04:56:47", "text": "随机发生的"}, {"type": "subtitle", "time": 17817.35, "timestamp": "04:56:57", "text": "坐着，我对人工智能很熟悉，所以我做了一个"}]
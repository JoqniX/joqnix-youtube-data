[{"type": "subtitle", "time": 8521.99, "timestamp": "02:22:01", "text": "在直播中直播你正在进行的工作"}, {"type": "subtitle", "time": 8524.23, "timestamp": "02:22:04", "text": "直播电视之类的东西，还有那些人"}, {"type": "subtitle", "time": 8526.79, "timestamp": "02:22:06", "text": "看着你直播就像那样"}, {"type": "subtitle", "time": 8529.27, "timestamp": "02:22:09", "text": "有经验的电视直播人员可以"}, {"type": "subtitle", "time": 8532.389, "timestamp": "02:22:12", "text": "指导你，教你如何做，比如如何做。"}, {"type": "subtitle", "time": 8534.83, "timestamp": "02:22:14", "text": "做得更好。"}, {"type": "subtitle", "time": 8537.95, "timestamp": "02:22:17", "text": "一切都像这样"}, {"type": "subtitle", "time": 8545.389, "timestamp": "02:22:25", "text": "还不错，这有点像"}, {"type": "subtitle", "time": 8547.89, "timestamp": "02:22:27", "text": "好的。我有"}, {"type": "subtitle", "time": 8550.91, "timestamp": "02:22:30", "text": "[音乐]"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "好的。是的。如果你正在从事以下工作"}, {"type": "subtitle", "time": 8564.429, "timestamp": "02:22:44", "text": "你自己的模型之类的，祝你好运"}, {"type": "subtitle", "time": 8567.87, "timestamp": "02:22:47", "text": "那。我祝你"}, {"type": "subtitle", "time": 8571.03, "timestamp": "02:22:51", "text": "最好的。嗯。"}, {"type": "subtitle", "time": 8573.51, "timestamp": "02:22:53", "text": "如果你是……的优势是……"}, {"type": "subtitle", "time": 8577.11, "timestamp": "02:22:57", "text": "你自己的艺术家和索具师，呃，是吗？"}, {"type": "subtitle", "time": 8579.429, "timestamp": "02:22:59", "text": "你可以不断添加新内容"}]
[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "他这样做是为了避税。不要这样做"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "它。你的税是什么？这不是婚姻"}, {"type": "subtitle", "time": 5596.709, "timestamp": "01:33:16", "text": "我们来修这辆车吧。"}, {"type": "subtitle", "time": 5627.47, "timestamp": "01:33:47", "text": "我正把购物车推进来。"}, {"type": "subtitle", "time": 5631.709, "timestamp": "01:33:51", "text": "在我们之前"}, {"type": "subtitle", "time": 5635.83, "timestamp": "01:33:55", "text": "他轻轻地就在那里。好的。有一个"}]
[{"type": "subtitle", "time": 18421.35, "timestamp": "05:07:01", "text": "我要死了。这里有些绿色的东西。"}, {"type": "subtitle", "time": 18425.91, "timestamp": "05:07:05", "text": "哦，不。想让我给你看电视吗？"}, {"type": "subtitle", "time": 18429.03, "timestamp": "05:07:09", "text": "或许。我在这里。不用担心。我只是"}, {"type": "subtitle", "time": 18432.07, "timestamp": "05:07:12", "text": "独自冒险是因为我觉得"}, {"type": "subtitle", "time": 18436.07, "timestamp": "05:07:16", "text": "强大的。不，宝贝。"}, {"type": "subtitle", "time": 18437.99, "timestamp": "05:07:17", "text": "为什么？等待。"}, {"type": "subtitle", "time": 18440.03, "timestamp": "05:07:20", "text": "因为有些事"}, {"type": "subtitle", "time": 18443.35, "timestamp": "05:07:23", "text": "绿色的。我想得到它。"}, {"type": "subtitle", "time": 18457.34, "timestamp": "05:07:37", "text": "我们开始吧"}, {"type": "subtitle", "time": 18470.39, "timestamp": "05:07:50", "text": "洞穴。等等，这里离我家不近吗？"}, {"type": "subtitle", "time": 18473.43, "timestamp": "05:07:53", "text": "哦，确实如此。这是。这就是我建造它的原因。"}, {"type": "subtitle", "time": 18474.55, "timestamp": "05:07:54", "text": "这里。"}, {"type": "subtitle", "time": 18476.708, "timestamp": "05:07:56", "text": "啊，"}, {"type": "subtitle", "time": 18479.53, "timestamp": "05:07:59", "text": "你可以把它当作你的新家。"}]
[{"type": "subtitle", "time": 5168.83, "timestamp": "01:26:08", "text": "哦，我的"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "上帝。我做不到，是吗？是的，"}, {"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "在狭小的空间里穿长袍很困难。"}, {"type": "subtitle", "time": 5179.189, "timestamp": "01:26:19", "text": "啊哈。你这个蠢货。过来这边或"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "矿。甚至在其他地方。"}, {"type": "subtitle", "time": 5185.189, "timestamp": "01:26:25", "text": "各位，我们还活着吗？我死了。哦，绝不"}, {"type": "subtitle", "time": 5186.669, "timestamp": "01:26:26", "text": "头脑。某人的"}, {"type": "subtitle", "time": 5188.99, "timestamp": "01:26:28", "text": "死的。那不是"}, {"type": "subtitle", "time": 5193.87, "timestamp": "01:26:33", "text": "好的。好了，回到正题。"}, {"type": "subtitle", "time": 5195.99, "timestamp": "01:26:35", "text": "程序。我不知道具体流程。"}, {"type": "subtitle", "time": 5204.79, "timestamp": "01:26:44", "text": "意思是。操？这里是谁？什么？什么？什么？"}, {"type": "subtitle", "time": 5206.59, "timestamp": "01:26:46", "text": "胶带"}, {"type": "subtitle", "time": 5208.59, "timestamp": "01:26:48", "text": "手榴弹。哦，"}, {"type": "subtitle", "time": 5211.87, "timestamp": "01:26:51", "text": "好的。看来我们就收下这些吧。"}]
[{"type": "subtitle", "time": 195.11, "timestamp": "00:03:15", "text": "好的。我承认吧。我承认"}, {"type": "subtitle", "time": 198.71, "timestamp": "00:03:18", "text": "给你们。你好。"}, {"type": "subtitle", "time": 202.07, "timestamp": "00:03:22", "text": "好了。你好。我的天啊。聊天，"}, {"type": "subtitle", "time": 204.949, "timestamp": "00:03:24", "text": "我们走吧。等等，我到底有多少人？"}, {"type": "subtitle", "time": 208.149, "timestamp": "00:03:28", "text": "这里有什么？坚持，稍等。"}, {"type": "subtitle", "time": 210.309, "timestamp": "00:03:30", "text": "我这里有大约18个人。好的。"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "哦，这是什么游戏？"}, {"type": "subtitle", "time": 215.589, "timestamp": "00:03:35", "text": "我的天啊。我是"}, {"type": "subtitle", "time": 218.63, "timestamp": "00:03:38", "text": "我既兴奋又担心。哦，你曾经是"}, {"type": "subtitle", "time": 220.949, "timestamp": "00:03:40", "text": "比赛日程一。比赛怎么样？"}, {"type": "subtitle", "time": 224.07, "timestamp": "00:03:44", "text": "是的，我当时是在按计划行事，兄弟。我 我"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "我沉迷于这款游戏。这真是太"}, {"type": "subtitle", "time": 230.309, "timestamp": "00:03:50", "text": "乐趣。我从来没有对过。我一直都在 我一直都在"}, {"type": "subtitle", "time": 235.03, "timestamp": "00:03:55", "text": "等待就像我一样，为了法律"}, {"type": "subtitle", "time": 238.22899999999998, "timestamp": "00:03:58", "text": "游戏的重新打包版已经发布了，而且我"}]
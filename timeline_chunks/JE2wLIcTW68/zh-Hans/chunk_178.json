[{"type": "subtitle", "time": 10680.03, "timestamp": "02:58:00", "text": "像"}, {"type": "subtitle", "time": 10683.51, "timestamp": "02:58:03", "text": "哇。她在那款游戏上投入了太多精力。哦"}, {"type": "subtitle", "time": 10712.51, "timestamp": "02:58:32", "text": "把床抬起来。哦，你有一个特大号的"}, {"type": "subtitle", "time": 10716.309, "timestamp": "02:58:36", "text": "床。三居室。哦，我的"}, {"type": "subtitle", "time": 10719.19, "timestamp": "02:58:39", "text": "我的天啊。在这里，你知道，你知道，我"}, {"type": "subtitle", "time": 10721.99, "timestamp": "02:58:41", "text": "我在这里睡了大概六晚吧。"}, {"type": "subtitle", "time": 10724.95, "timestamp": "02:58:44", "text": "七次。我在这里睡过觉。"}, {"type": "subtitle", "time": 10726.95, "timestamp": "02:58:46", "text": "再次。"}, {"type": "subtitle", "time": 10728.79, "timestamp": "02:58:48", "text": "哇。"}, {"type": "subtitle", "time": 10735.59, "timestamp": "02:58:55", "text": "你好，M。欢迎。"}]
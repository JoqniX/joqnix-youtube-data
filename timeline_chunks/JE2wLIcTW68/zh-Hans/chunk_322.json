[{"type": "subtitle", "time": 19332.31, "timestamp": "05:22:12", "text": "是的，意思是你好，问候，尤里。"}, {"type": "subtitle", "time": 19335.23, "timestamp": "05:22:15", "text": "呃，我的名字是"}, {"type": "subtitle", "time": 19338.15, "timestamp": "05:22:18", "text": "阿斯特拉。你好吗？"}, {"type": "subtitle", "time": 19345.67, "timestamp": "05:22:25", "text": "等等，你对Suki也做了这种事吗？"}, {"type": "subtitle", "time": 19348.628, "timestamp": "05:22:28", "text": "不，我忘了对苏琪做这件事。我会的"}, {"type": "subtitle", "time": 19351.23, "timestamp": "05:22:31", "text": "下次见到她的时候我会告诉她。"}, {"type": "subtitle", "time": 19359.11, "timestamp": "05:22:39", "text": "我不懂任何语言。我知道像"}, {"type": "subtitle", "time": 19360.19, "timestamp": "05:22:40", "text": "每一个"}, {"type": "subtitle", "time": 19371.59, "timestamp": "05:22:51", "text": "我是印度人，但我不知道该教什么。"}, {"type": "subtitle", "time": 19374.628, "timestamp": "05:22:54", "text": "他。就是这样。我该怎么做？"}, {"type": "subtitle", "time": 19376.15, "timestamp": "05:22:56", "text": "开始？这就是问题所在。喜欢的话就点赞吧"}, {"type": "subtitle", "time": 19379.07, "timestamp": "05:22:59", "text": "想学一个句子？我可以做到。"}]
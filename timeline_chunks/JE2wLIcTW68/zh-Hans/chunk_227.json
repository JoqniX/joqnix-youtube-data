[{"type": "subtitle", "time": 13622.91, "timestamp": "03:47:02", "text": "现在，换一把镐，然后……"}, {"type": "subtitle", "time": 13634.55, "timestamp": "03:47:14", "text": "好的。呃，"}, {"type": "subtitle", "time": 13637.269, "timestamp": "03:47:17", "text": "等待。那是什么？"}, {"type": "subtitle", "time": 13640.389, "timestamp": "03:47:20", "text": "那是岩浆。我喜欢它的这一点"}, {"type": "subtitle", "time": 13643.83, "timestamp": "03:47:23", "text": "关注我。已关注。我不"}, {"type": "subtitle", "time": 13654.55, "timestamp": "03:47:34", "text": "太酷了！你可以杀死其他人"}, {"type": "subtitle", "time": 13656.15, "timestamp": "03:47:36", "text": "结构。"}, {"type": "subtitle", "time": 13659.03, "timestamp": "03:47:39", "text": "为什么它们没有燃烧？因为他们"}]
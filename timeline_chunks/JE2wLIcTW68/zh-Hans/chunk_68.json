[{"type": "subtitle", "time": 4085.829, "timestamp": "01:08:05", "text": "我的天啊。我将是最后的幸存者。"}, {"type": "subtitle", "time": 4108.45, "timestamp": "01:08:28", "text": "啊哈。妈的。"}, {"type": "subtitle", "time": 4118.99, "timestamp": "01:08:38", "text": "啊哈。啊哈。"}, {"type": "subtitle", "time": 4122.11, "timestamp": "01:08:42", "text": "哦。啊。不。"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "不。嘿，乔。和平，伙计。和平。快点。"}, {"type": "subtitle", "time": 4128.55, "timestamp": "01:08:48", "text": "我们必须为和平而活，伙计。是的。"}]
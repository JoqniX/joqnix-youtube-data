[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "我的意思是，我会保护自己。"}, {"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "我打算直接过去看看。"}, {"type": "subtitle", "time": 2348.31, "timestamp": "00:39:08", "text": "在。哦，第二个就更远了。"}, {"type": "subtitle", "time": 2351.51, "timestamp": "00:39:11", "text": "门。谁来拉一下。这是什么？"}, {"type": "subtitle", "time": 2355.19, "timestamp": "00:39:15", "text": "哦，对了，还有第二个。所以"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "提取量像这样增加"}, {"type": "subtitle", "time": 2361.109, "timestamp": "00:39:21", "text": "之后还会有两个。"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "然后之后会是三个"}, {"type": "subtitle", "time": 2365.109, "timestamp": "00:39:25", "text": "而且它好像一直在这样上涨。"}, {"type": "subtitle", "time": 2376.15, "timestamp": "00:39:36", "text": "哦，还有一件。好的。我们走吧。是"}, {"type": "subtitle", "time": 2378.87, "timestamp": "00:39:38", "text": "这里什么都没有吗？哦，别忘了"}, {"type": "subtitle", "time": 2380.47, "timestamp": "00:39:40", "text": "打开这些货架，对吧？是的。"}, {"type": "subtitle", "time": 2382.95, "timestamp": "00:39:42", "text": "别忘了打开贝壳。是的。"}, {"type": "subtitle", "time": 2385.03, "timestamp": "00:39:45", "text": "好的。是的。记住要打开"}, {"type": "subtitle", "time": 2387.829, "timestamp": "00:39:47", "text": "嘘。"}, {"type": "subtitle", "time": 2389.47, "timestamp": "00:39:49", "text": "当然！"}, {"type": "subtitle", "time": 2391.19, "timestamp": "00:39:51", "text": "兄弟。你当时是想做什么？"}, {"type": "subtitle", "time": 2393.349, "timestamp": "00:39:53", "text": "有什么事吗，伙计？"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "我插上一根铁钉，然后……"}]
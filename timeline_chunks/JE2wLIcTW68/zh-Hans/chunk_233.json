[{"type": "subtitle", "time": 13982.15, "timestamp": "03:53:02", "text": "她很有创造力，这样她就能飞翔。"}, {"type": "subtitle", "time": 13986.79, "timestamp": "03:53:06", "text": "我的天，太可怕了。好了，现在我们跳"}, {"type": "subtitle", "time": 13995.349, "timestamp": "03:53:15", "text": "已经。末影龙。"}, {"type": "subtitle", "time": 13997.389, "timestamp": "03:53:17", "text": "哦，它在我的车里看起来真是酷毙了。"}, {"type": "subtitle", "time": 14002.469, "timestamp": "03:53:22", "text": "着色器。看起来真酷。太酷了。"}, {"type": "subtitle", "time": 14004.95, "timestamp": "03:53:24", "text": "没有什么。为什么？"}, {"type": "subtitle", "time": 14007.03, "timestamp": "03:53:27", "text": "我们应该跳双跳吗？二段跳和"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "来飞吧。"}, {"type": "subtitle", "time": 14012.95, "timestamp": "03:53:32", "text": "你们知道吗，伙计们？"}, {"type": "subtitle", "time": 14015.59, "timestamp": "03:53:35", "text": "我需要/想要共享屏幕。我"}, {"type": "subtitle", "time": 14017.11, "timestamp": "03:53:37", "text": "想和你共享屏幕。真是太"}, {"type": "subtitle", "time": 14021.349, "timestamp": "03:53:41", "text": "酷毙了。哦，你肯定认识这个组合。"}, {"type": "subtitle", "time": 14026.83, "timestamp": "03:53:46", "text": "是的。"}]
[{"type": "subtitle", "time": 1922.87, "timestamp": "00:32:02", "text": "听起来怎么样？呃，这很正常。"}, {"type": "subtitle", "time": 1925.269, "timestamp": "00:32:05", "text": "这是声音。哦，不。这就是……"}, {"type": "subtitle", "time": 1929.509, "timestamp": "00:32:09", "text": "步行。不，不，是环境噪音。"}, {"type": "subtitle", "time": 1934.149, "timestamp": "00:32:14", "text": "那肯定没问题。这边有把锁。"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "我想那部分就到此为止了。哦，我的"}, {"type": "subtitle", "time": 1938.23, "timestamp": "00:32:18", "text": "天哪，有什么东西在动。哦，等等。为什么"}, {"type": "subtitle", "time": 1947.19, "timestamp": "00:32:27", "text": "哦，是的。嗯，是的。"}, {"type": "subtitle", "time": 1953.909, "timestamp": "00:32:33", "text": "这里还有一个大立方体，我"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "需要你所有的"}, {"type": "subtitle", "time": 1957.75, "timestamp": "00:32:37", "text": "我认为你应该把它当作……"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "第二个。"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "好的。我们需要所有人，我们需要所有人的参与"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "击中鸭子。"}, {"type": "subtitle", "time": 1966.71, "timestamp": "00:32:46", "text": "别让它打到鸭子。无论你"}, {"type": "subtitle", "time": 1968.389, "timestamp": "00:32:48", "text": "做。"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "赶紧行动。我的天啊。是的。我的意思是，他"}, {"type": "subtitle", "time": 1974.149, "timestamp": "00:32:54", "text": "可以跳上去，但如果撞到箱子上，"}, {"type": "subtitle", "time": 1976.23, "timestamp": "00:32:56", "text": "呃，我们会把它放进购物车里，就在……旁边"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "这一次，方式不同了。大车。好的，就是这样。"}, {"type": "subtitle", "time": 1979.909, "timestamp": "00:32:59", "text": "在我们右边。我们来试试，我们来试试能不能得到"}]
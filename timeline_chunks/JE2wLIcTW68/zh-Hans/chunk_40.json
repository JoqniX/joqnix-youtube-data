[{"type": "subtitle", "time": 2404.79, "timestamp": "00:40:04", "text": "下午。现在，我奉命前往"}, {"type": "subtitle", "time": 2407.03, "timestamp": "00:40:07", "text": "去商店，所以对我来说不行。该死，那是"}, {"type": "subtitle", "time": 2409.829, "timestamp": "00:40:09", "text": "真糟糕。好好照顾自己"}, {"type": "subtitle", "time": 2412.03, "timestamp": "00:40:12", "text": "你自己，"}, {"type": "subtitle", "time": 2415.03, "timestamp": "00:40:15", "text": "先生。哦，哇，哇，哇，哇，哇。"}, {"type": "subtitle", "time": 2417.75, "timestamp": "00:40:17", "text": "哦，我真庆幸我躲过了你。"}, {"type": "subtitle", "time": 2419.51, "timestamp": "00:40:19", "text": "拉屎。"}, {"type": "subtitle", "time": 2423.51, "timestamp": "00:40:23", "text": "绝对没出什么岔子。"}, {"type": "subtitle", "time": 2431.03, "timestamp": "00:40:31", "text": "好的。"}, {"type": "subtitle", "time": 2435.349, "timestamp": "00:40:35", "text": "是的。好的。最后一项。是什么"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "我猜这是期末考试。有一些"}, {"type": "subtitle", "time": 2438.43, "timestamp": "00:40:38", "text": "贝壳"}]
[{"type": "subtitle", "time": 2642.309, "timestamp": "00:44:02", "text": "什么也不是。"}, {"type": "subtitle", "time": 2645.27, "timestamp": "00:44:05", "text": "哦，不错。"}, {"type": "subtitle", "time": 2647.109, "timestamp": "00:44:07", "text": "你知道吗？我会把健康值提上去。"}, {"type": "subtitle", "time": 2655.109, "timestamp": "00:44:15", "text": "还有一枚手榴弹。又一个该死的"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "爬虫的背面。是的。谢谢。嗯，我"}, {"type": "subtitle", "time": 2660.95, "timestamp": "00:44:20", "text": "也就是说，又一颗手榴弹。"}, {"type": "subtitle", "time": 2669.51, "timestamp": "00:44:29", "text": "就这些吗？就这些了。人类"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "这是一颗超大的手榴弹。"}, {"type": "subtitle", "time": 2680.069, "timestamp": "00:44:40", "text": "不。等等，什么？不。操。不，是我做的。"}, {"type": "subtitle", "time": 2683.349, "timestamp": "00:44:43", "text": "好了，我把它关掉了。呃，既然我们有"}, {"type": "subtitle", "time": 2685.349, "timestamp": "00:44:45", "text": "钱，我要带个地图玩家"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "计数升级，这样我就知道谁死了。地狱"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "是的。我们也要买那架无人机吗？"}, {"type": "subtitle", "time": 2693.67, "timestamp": "00:44:53", "text": "呃，零抓取开始。绝对不行。它是"}, {"type": "subtitle", "time": 2697.27, "timestamp": "00:44:57", "text": "无用。哦，好吧。那"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "羽毛无人机。羽毛无人机是"}]
[{"type": "subtitle", "time": 5055.51, "timestamp": "01:24:15", "text": "哦，还有更多物品。杯。"}, {"type": "subtitle", "time": 5057.91, "timestamp": "01:24:17", "text": "我要自杀。"}, {"type": "subtitle", "time": 5066.75, "timestamp": "01:24:26", "text": "这。那个"}, {"type": "subtitle", "time": 5069.43, "timestamp": "01:24:29", "text": "我觉得是他拿下的。"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "被吓了一跳，然后死了。不，他"}, {"type": "subtitle", "time": 5072.79, "timestamp": "01:24:32", "text": "已断开连接。"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "是吗？"}, {"type": "subtitle", "time": 5076.629, "timestamp": "01:24:36", "text": "妈的。是的。搞什么鬼？什么"}, {"type": "subtitle", "time": 5078.79, "timestamp": "01:24:38", "text": "发生了吗？"}, {"type": "subtitle", "time": 5081.99, "timestamp": "01:24:41", "text": "我先告辞了。哦，"}, {"type": "subtitle", "time": 5083.669, "timestamp": "01:24:43", "text": "小心。"}, {"type": "subtitle", "time": 5085.83, "timestamp": "01:24:45", "text": "感谢您的参与。 Roco，谢谢"}, {"type": "subtitle", "time": 5088.07, "timestamp": "01:24:48", "text": "加入我们。我的意思是，嗯，我们拭目以待。"}, {"type": "subtitle", "time": 5091.95, "timestamp": "01:24:51", "text": "下次见。进而"}, {"type": "subtitle", "time": 5096.149, "timestamp": "01:24:56", "text": "又一个新生儿。晚安。晚安"}, {"type": "subtitle", "time": 5099.6, "timestamp": "01:24:59", "text": "晚安 长袍。长袍。长袍。长袍。"}]
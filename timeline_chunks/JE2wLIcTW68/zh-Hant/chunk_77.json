[{"type": "subtitle", "time": 4654.99, "timestamp": "01:17:34", "text": "你"}, {"type": "subtitle", "time": 4659.75, "timestamp": "01:17:39", "text": "錯過了。我剛才是在嚇唬你。  好的，放進車裡。我"}, {"type": "subtitle", "time": 4661.43, "timestamp": "01:17:41", "text": "可以像"}, {"type": "subtitle", "time": 4665.59, "timestamp": "01:17:45", "text": "進保險箱一樣進去。好了，我們走吧。  你想擔任指揮嗎？不，我們還是別那樣做了"}]
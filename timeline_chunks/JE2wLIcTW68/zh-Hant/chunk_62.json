[{"type": "subtitle", "time": 3723.19, "timestamp": "01:02:03", "text": "物品推進去。我是指，那輛車。好的。呃，"}, {"type": "subtitle", "time": 3726.63, "timestamp": "01:02:06", "text": "誰還好？呃，喬，還有誰力氣大？"}, {"type": "subtitle", "time": 3729.43, "timestamp": "01:02:09", "text": "誰有力量？我有頁眉。  好的。"}, {"type": "subtitle", "time": 3731.51, "timestamp": "01:02:11", "text": "你有多少力量？"}, {"type": "subtitle", "time": 3737.109, "timestamp": "01:02:17", "text": "一。好的。哦，不。我正在處理。別說了，"}, {"type": "subtitle", "time": 3741.19, "timestamp": "01:02:21", "text": "好吧，我們有人真的可以像這樣，"}, {"type": "subtitle", "time": 3743.43, "timestamp": "01:02:23", "text": "看，看看我。哦，有人這樣拉它"}, {"type": "subtitle", "time": 3745.75, "timestamp": "01:02:25", "text": "。讓我們調整一下這個"}, {"type": "subtitle", "time": 3748.87, "timestamp": "01:02:28", "text": "道具的角度。"}, {"type": "subtitle", "time": 3749.91, "timestamp": "01:02:29", "text": "我覺得應該豎著放"}, {"type": "subtitle", "time": 3751.75, "timestamp": "01:02:31", "text": "，對吧？所以，就像是，是的，"}, {"type": "subtitle", "time": 3753.829, "timestamp": "01:02:33", "text": "顯然是垂直的，但是先傾斜這個角度，"}, {"type": "subtitle", "time": 3758.23, "timestamp": "01:02:38", "text": "因為哦，它很"}, {"type": "subtitle", "time": 3761.91, "timestamp": "01:02:41", "text": "漂亮，哦，天哪。好的。好的。首先，我們把"}, {"type": "subtitle", "time": 3764.15, "timestamp": "01:02:44", "text": "它調整成這樣，這樣在推動的時候它就不會進行"}, {"type": "subtitle", "time": 3765.51, "timestamp": "01:02:45", "text": "計算了。好的。好的。  好的。"}, {"type": "subtitle", "time": 3768.789, "timestamp": "01:02:48", "text": "不，不，不。"}, {"type": "subtitle", "time": 3770.23, "timestamp": "01:02:50", "text": "所以，時間到了，我們"}, {"type": "subtitle", "time": 3773.109, "timestamp": "01:02:53", "text": "就把它推進去。好的。呃，關於這件事，等一下。"}, {"type": "subtitle", "time": 3774.309, "timestamp": "01:02:54", "text": "我有個主意。我會一直關注這件事"}, {"type": "subtitle", "time": 3777.19, "timestamp": "01:02:57", "text": "。我的天哪。"}]
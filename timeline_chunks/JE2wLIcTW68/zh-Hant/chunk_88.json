[{"type": "subtitle", "time": 5281.99, "timestamp": "01:28:01", "text": "我遠點。閉嘴。  好吧，夥計。"}, {"type": "subtitle", "time": 5304.27, "timestamp": "01:28:24", "text": "我。那是什麼"}, {"type": "subtitle", "time": 5305.95, "timestamp": "01:28:25", "text": "玩意兒？  兄弟，我罩著你。別擔心，老兄。"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "我們將過著幸福長久的"}, {"type": "subtitle", "time": 5315.629, "timestamp": "01:28:35", "text": "生活。我很確定。嗯，這樣可以。這樣可行。誰在"}, {"type": "subtitle", "time": 5326.669, "timestamp": "01:28:46", "text": "等等，等等，等等。  好的。好的。好的。我們很好。我們是古馳。你"}, {"type": "subtitle", "time": 5335.03, "timestamp": "01:28:55", "text": "回來試試！我沒空聽你胡說八道。滾開！我的天啊。好了，我這就走。去他媽的"}]
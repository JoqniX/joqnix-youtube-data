[{"type": "subtitle", "time": 23647.03, "timestamp": "06:34:07", "text": "知道。  哇。你知道嗎？好的。給你。好的。"}, {"type": "subtitle", "time": 23677.19, "timestamp": "06:34:37", "text": "做。  絕不。絕不。"}, {"type": "subtitle", "time": 23683.59, "timestamp": "06:34:43", "text": "什麼？這是我的爸爸。不要在這個問題上"}, {"type": "subtitle", "time": 23687.67, "timestamp": "06:34:47", "text": "掉以輕心。  好的。  什麼？好的。我只放了一個"}, {"type": "subtitle", "time": 23690.548, "timestamp": "06:34:50", "text": "蘋果。"}, {"type": "subtitle", "time": 23695.99, "timestamp": "06:34:55", "text": "好了，現在已經檢查過了。  山谷裡響起掌聲。我也想要這個。  好的"}]
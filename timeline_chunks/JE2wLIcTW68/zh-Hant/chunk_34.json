[{"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "情況，[ __ ]。  我"}, {"type": "subtitle", "time": 2045.9, "timestamp": "00:34:05", "text": "很好。我很好。"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "喲，怎麼了？我的天哪。"}, {"type": "subtitle", "time": 2057.829, "timestamp": "00:34:17", "text": "好的，我"}, {"type": "subtitle", "time": 2067.03, "timestamp": "00:34:27", "text": "不見了嗎？呃，Crater已經死了。火山口已死。"}, {"type": "subtitle", "time": 2072.23, "timestamp": "00:34:32", "text": "我的天啊。我們能不能別把它殺了"}, {"type": "subtitle", "time": 2076.629, "timestamp": "00:34:36", "text": "？我可以試試。"}, {"type": "subtitle", "time": 2091.99, "timestamp": "00:34:51", "text": "什麼？我殺了那隻鴨子。嘿，不錯。  我們"}, {"type": "subtitle", "time": 2095.069, "timestamp": "00:34:55", "text": "走吧。那是角。"}, {"type": "subtitle", "time": 2097.27, "timestamp": "00:34:57", "text": "拉屎。那是地雷。好的。千萬"}]
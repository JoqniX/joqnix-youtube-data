[{"type": "subtitle", "time": 7260.87, "timestamp": "02:01:00", "text": "等等，我很驚訝"}, {"type": "subtitle", "time": 7263.03, "timestamp": "02:01:03", "text": "我居然沒收到"}, {"type": "subtitle", "time": 7266.709, "timestamp": "02:01:06", "text": "任何關於中世紀格鬥"}, {"type": "subtitle", "time": 7268.47, "timestamp": "02:01:08", "text": "遊戲的警告，對吧？那裡有很多"}, {"type": "subtitle", "time": 7271.669, "timestamp": "02:01:11", "text": "血跡飛濺之類的東西。那場比賽並"}, {"type": "subtitle", "time": 7274.91, "timestamp": "02:01:14", "text": "沒有讓我明白，WA"}, {"type": "subtitle", "time": 7278.83, "timestamp": "02:01:18", "text": "顯然並沒有被下架。難以置信，我當時真的非常"}, {"type": "subtitle", "time": 7281.87, "timestamp": "02:01:21", "text": "驚訝，就像……"}, {"type": "subtitle", "time": 7285.87, "timestamp": "02:01:25", "text": "嗯……騎士精神遊戲一樣，對吧？"}, {"type": "subtitle", "time": 7287.55, "timestamp": "02:01:27", "text": "騎士精神。我"}, {"type": "subtitle", "time": 7291.83, "timestamp": "02:01:31", "text": "忘了。呃，那款遊戲叫《騎士精神2》還是《騎士精神"}, {"type": "subtitle", "time": 7293.91, "timestamp": "02:01:33", "text": "3》之類的。那款遊戲"}, {"type": "subtitle", "time": 7296.27, "timestamp": "02:01:36", "text": "應該是……"}, {"type": "subtitle", "time": 7300.47, "timestamp": "02:01:40", "text": "嗯……不是那種……呃……該怎麼稱呼它呢？"}, {"type": "subtitle", "time": 7305.43, "timestamp": "02:01:45", "text": "如果我沒記錯的話，在線觀看時有嚴格的規定。"}, {"type": "subtitle", "time": 7308.229, "timestamp": "02:01:48", "text": "我注意到那裡沒有那些遊戲"}, {"type": "subtitle", "time": 7310.149, "timestamp": "02:01:50", "text": "。他們有一份特定的"}, {"type": "subtitle", "time": 7314.149, "timestamp": "02:01:54", "text": "遊戲列表，其中有些遊戲"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "需要安裝大量的感應器之類的東西，"}, {"type": "subtitle", "time": 7318.87, "timestamp": "02:01:58", "text": "而且你不能進行直播之類的操作，因為這"}]
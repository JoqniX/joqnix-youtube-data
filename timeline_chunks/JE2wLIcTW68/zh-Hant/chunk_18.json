[{"type": "subtitle", "time": 1082.71, "timestamp": "00:18:02", "text": "。我的天啊。我就說這麼多。"}, {"type": "subtitle", "time": 1088.83, "timestamp": "00:18:08", "text": "哦，天哪。跑步。"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "跑步。不要把這張卡帶走"}, {"type": "subtitle", "time": 1094.789, "timestamp": "00:18:14", "text": "。就讓它待在那裡吧。"}, {"type": "subtitle", "time": 1105.71, "timestamp": "00:18:25", "text": "我就是一堵牆。我就是一堵牆。我只是個無名小卒"}, {"type": "subtitle", "time": 1108.63, "timestamp": "00:18:28", "text": "。我只不過是一堵牆而已。我就是一"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "堵牆。我是一堵牆。我是一堵牆。我是一"}, {"type": "subtitle", "time": 1126.48, "timestamp": "00:18:46", "text": "。我是一堵牆。我是一堵牆。我是一 堵牆。我是一堵牆。我一無是處。我"}, {"type": "subtitle", "time": 1128.64, "timestamp": "00:18:48", "text": "堵牆。我是一堵牆。我一無是處。我 是一堵牆。我是一塊磚頭。我是"}, {"type": "subtitle", "time": 1130.799, "timestamp": "00:18:50", "text": "是一堵牆。我是一塊磚頭。我是 由磚塊組成的。"}]
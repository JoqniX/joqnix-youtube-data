[{"type": "subtitle", "time": 3673.829, "timestamp": "01:01:13", "text": "我怎麼總是失手呢？"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "呃，你們檢查過冰箱嗎？哦，這裡東西真多。"}, {"type": "subtitle", "time": 3678.309, "timestamp": "01:01:18", "text": "哦，這裡有很多"}, {"type": "subtitle", "time": 3702.63, "timestamp": "01:01:42", "text": "，那是撤離點。"}, {"type": "subtitle", "time": 3704.069, "timestamp": "01:01:44", "text": "這正是我想要的效果。快點。"}, {"type": "subtitle", "time": 3705.27, "timestamp": "01:01:45", "text": "我現在要開始學習了。不再"}, {"type": "subtitle", "time": 3709.109, "timestamp": "01:01:49", "text": "睡了。嘿，走吧，瑞恩。終於，"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "終於。哦好的。嗯，這需要"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "大量的團隊合作。是的，我"}, {"type": "subtitle", "time": 3717.75, "timestamp": "01:01:57", "text": "知道。我們需要兩個團隊，一個負責把"}, {"type": "subtitle", "time": 3719.91, "timestamp": "01:01:59", "text": "大件物品推進去，另一個負責迅速把小件"}]
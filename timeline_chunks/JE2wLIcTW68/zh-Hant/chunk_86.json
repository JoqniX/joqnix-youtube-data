[{"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "地方。  各位，"}, {"type": "subtitle", "time": 5185.189, "timestamp": "01:26:25", "text": "我們還活著嗎？我死了。哦，沒事了。有人死了。那可不好。好了，我們"}, {"type": "subtitle", "time": 5193.87, "timestamp": "01:26:33", "text": "繼續進行操作"}, {"type": "subtitle", "time": 5195.99, "timestamp": "01:26:35", "text": "流程。就程序而言，我不知道我的意思是什麼。操？這裡是誰？"}, {"type": "subtitle", "time": 5204.79, "timestamp": "01:26:44", "text": "什麼？什麼？什麼？"}, {"type": "subtitle", "time": 5206.59, "timestamp": "01:26:46", "text": "膠帶"}, {"type": "subtitle", "time": 5208.59, "timestamp": "01:26:48", "text": "手榴彈。哦好的"}, {"type": "subtitle", "time": 5211.87, "timestamp": "01:26:51", "text": "。看來我們就收下這些吧。  [音樂]"}]
[{"type": "subtitle", "time": 2700.79, "timestamp": "00:45:00", "text": "好得多。"}, {"type": "subtitle", "time": 2702.95, "timestamp": "00:45:02", "text": "現在沒有別的了。呃，如果"}, {"type": "subtitle", "time": 2704.47, "timestamp": "00:45:04", "text": "有人想獲得"}, {"type": "subtitle", "time": 2706.95, "timestamp": "00:45:06", "text": "健康，他們可以。我已經給自己買了一份"}, {"type": "subtitle", "time": 2709.589, "timestamp": "00:45:09", "text": "健康保險。哦，等等。哦，"}, {"type": "subtitle", "time": 2711.99, "timestamp": "00:45:11", "text": "等等。這是……哦，這裡不是廁所。"}, {"type": "subtitle", "time": 2714.069, "timestamp": "00:45:14", "text": "我做不到不用上廁所。該死的"}, {"type": "subtitle", "time": 2716.87, "timestamp": "00:45:16", "text": "。好的，那我就買這個吧。好的。  我的"}, {"type": "subtitle", "time": 2719.829, "timestamp": "00:45:19", "text": "天哪，各位。看，是"}, {"type": "subtitle", "time": 2722.87, "timestamp": "00:45:22", "text": "Na。存在衝刺速度。"}, {"type": "subtitle", "time": 2724.39, "timestamp": "00:45:24", "text": "如果你需要的話，可以升級衝刺速度。不，"}, {"type": "subtitle", "time": 2732.87, "timestamp": "00:45:32", "text": "我們正在進行「所有人的HP都滿了嗎？」的測試。"}, {"type": "subtitle", "time": 2736.55, "timestamp": "00:45:36", "text": "我到100了。我到95了。"}, {"type": "subtitle", "time": 2738.309, "timestamp": "00:45:38", "text": "等等，這邊有免費的東西"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "。等等，算了。它不是免費的。"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "如果你想的話，你可以利用這個漏洞。我可以嗎？"}, {"type": "subtitle", "time": 2747.75, "timestamp": "00:45:47", "text": "它不是免費的。如何利用這個漏洞？呃，"}, {"type": "subtitle", "time": 2750.23, "timestamp": "00:45:50", "text": "所以一旦飛船啟動，就開始狂按"}, {"type": "subtitle", "time": 2752.95, "timestamp": "00:45:52", "text": "E 鍵。好了，上船吧。開始"}, {"type": "subtitle", "time": 2756.55, "timestamp": "00:45:56", "text": "狂按E鍵。大家準備好了嗎？是的。現在就開始"}, {"type": "subtitle", "time": 2758.43, "timestamp": "00:45:58", "text": "發送垃圾郵件"}]
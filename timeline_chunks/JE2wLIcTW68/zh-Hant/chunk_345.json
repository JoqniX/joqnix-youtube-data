[{"type": "subtitle", "time": 20701.11, "timestamp": "05:45:01", "text": "這讓我想起了諾基亞。有點像"}, {"type": "subtitle", "time": 20703.43, "timestamp": "05:45:03", "text": "。是啊。不，現在是四月。現在，我們可以唱這首歌了。 [音樂]"}, {"type": "subtitle", "time": 20717.43, "timestamp": "05:45:17", "text": "我有一根骨頭。抱歉。我有一根骨頭。對。我就知道。我就知道。我的天哪。"}, {"type": "subtitle", "time": 20743.15, "timestamp": "05:45:43", "text": "我就"}, {"type": "subtitle", "time": 20746.99, "timestamp": "05:45:46", "text": "知道。你等著瞧。你等著瞧。我的天哪。我要上來殺了你。"}]
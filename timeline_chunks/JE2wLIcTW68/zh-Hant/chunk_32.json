[{"type": "subtitle", "time": 1922.87, "timestamp": "00:32:02", "text": "聽起來怎麼樣？呃，這很正常。"}, {"type": "subtitle", "time": 1925.269, "timestamp": "00:32:05", "text": "這是聲音。哦，不。這就是"}, {"type": "subtitle", "time": 1929.509, "timestamp": "00:32:09", "text": "行走。不，不，是環境噪音。"}, {"type": "subtitle", "time": 1934.149, "timestamp": "00:32:14", "text": "那肯定沒問題。這邊有把鎖。"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "我想那部分就到此為止了。我的"}, {"type": "subtitle", "time": 1938.23, "timestamp": "00:32:18", "text": "天哪，有什麼東西在動。哦，等等。為什麼"}, {"type": "subtitle", "time": 1947.19, "timestamp": "00:32:27", "text": "哦，是的。嗯，是的。  是的"}, {"type": "subtitle", "time": 1953.909, "timestamp": "00:32:33", "text": "這裡還有一個大立方體，我"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "需要你所有的東西，"}, {"type": "subtitle", "time": 1957.75, "timestamp": "00:32:37", "text": "我想你應該把它當作"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "第二個。"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "好的。我們需要所有人，所有人齊心協力，否則就"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "完蛋了。"}, {"type": "subtitle", "time": 1966.71, "timestamp": "00:32:46", "text": "別讓它打到鴨子。無論你"}, {"type": "subtitle", "time": 1968.389, "timestamp": "00:32:48", "text": "做什麼。"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "趕緊行動。我的天啊。是的。我的意思是，他"}, {"type": "subtitle", "time": 1974.149, "timestamp": "00:32:54", "text": "可以跳上去，但如果撞到箱子，"}, {"type": "subtitle", "time": 1976.23, "timestamp": "00:32:56", "text": "呃，順便說一下，這次我們會把它放進購物車裡"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "。大車。好的，它就"}, {"type": "subtitle", "time": 1979.909, "timestamp": "00:32:59", "text": "在我們右邊。讓我們盡力爭取盡可能"}]
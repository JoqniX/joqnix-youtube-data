[{"type": "subtitle", "time": 21672.27, "timestamp": "06:01:12", "text": "為什麼這樣"}, {"type": "subtitle", "time": 21675.83, "timestamp": "06:01:15", "text": "？他們是小鬼。別說小鬼。我的天哪。我"}, {"type": "subtitle", "time": 21678.07, "timestamp": "06:01:18", "text": "喜歡你叫我布拉德的時候。布拉德，你在哪裡？你在哪裡？好吧。是的。過來，過來，"}, {"type": "subtitle", "time": 21687.948, "timestamp": "06:01:27", "text": "過來。你……為什麼"}, {"type": "subtitle", "time": 21694.07, "timestamp": "06:01:34", "text": "我打不到你？什麼？哦"}, {"type": "subtitle", "time": 21696.15, "timestamp": "06:01:36", "text": "，不。不。不。不。為什麼？就是這樣。嘿，什麼"}, {"type": "subtitle", "time": 21699.75, "timestamp": "06:01:39", "text": "？什麼？這個？嗯？"}, {"type": "subtitle", "time": 21707.39, "timestamp": "06:01:47", "text": "什麼？你剛才說……你剛才說的是狗？哦，哇。你真壞。才怪。哦。哦，我殺了他。我殺了他"}]
[{"type": "subtitle", "time": 4262.47, "timestamp": "01:11:02", "text": "那是遊戲中毫髮無傷的怪物"}, {"type": "subtitle", "time": 4264.07, "timestamp": "01:11:04", "text": "。是的。瞧瞧這東西，夥計。真"}, {"type": "subtitle", "time": 4265.95, "timestamp": "01:11:05", "text": "搞笑。"}, {"type": "subtitle", "time": 4269.35, "timestamp": "01:11:09", "text": "哦，你錯過了他。是那個拿著"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "不是他。不用擔心。那"}, {"type": "subtitle", "time": 4314.63, "timestamp": "01:11:54", "text": "等等，他看不到我們。不，他不能。他"}]
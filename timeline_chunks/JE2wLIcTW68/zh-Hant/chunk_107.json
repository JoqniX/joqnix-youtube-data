[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "希望今天能睡個好覺。我喜歡今天，不像"}, {"type": "subtitle", "time": 6425.43, "timestamp": "01:47:05", "text": "昨天，我凌晨5點就睡了。我本來"}, {"type": "subtitle", "time": 6427.87, "timestamp": "01:47:07", "text": "不想"}, {"type": "subtitle", "time": 6431.03, "timestamp": "01:47:11", "text": "睡覺。陪我喝杯啤酒吧。我該喝"}, {"type": "subtitle", "time": 6438.109, "timestamp": "01:47:18", "text": "哦，"}, {"type": "subtitle", "time": 6455.17, "timestamp": "01:47:35", "text": "我剛剛才意識到啤酒和"}]
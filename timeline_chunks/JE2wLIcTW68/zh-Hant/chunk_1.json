[{"type": "subtitle", "time": 61.67, "timestamp": "00:01:01", "text": "害怕。我"}, {"type": "subtitle", "time": 64.789, "timestamp": "00:01:04", "text": "現在心裡百感交集。我什至不知道"}, {"type": "subtitle", "time": 67.55, "timestamp": "00:01:07", "text": "發生了什麼，也不知道接下來會發生什麼"}, {"type": "subtitle", "time": 70.95, "timestamp": "00:01:10", "text": "。但我所能做的，我所能做的，我所知道的只有一件事："}, {"type": "subtitle", "time": 86.03, "timestamp": "00:01:26", "text": "嗯，等一下"}, {"type": "subtitle", "time": 94.19, "timestamp": "00:01:34", "text": "呃，我的世界。"}, {"type": "subtitle", "time": 101.27000000000001, "timestamp": "00:01:41", "text": "好的。報告。遊戲有教程"}]
[{"type": "subtitle", "time": 21782.47, "timestamp": "06:03:02", "text": "哦，天哪。我還"}, {"type": "subtitle", "time": 21785.43, "timestamp": "06:03:05", "text": "活著。哦不。不。哦，我"}, {"type": "subtitle", "time": 21804.07, "timestamp": "06:03:24", "text": "的天哪。這隻貓真煩人。哦，等等。我可以把他放到船上，然後搭船傳送，對吧"}, {"type": "subtitle", "time": 21814.628, "timestamp": "06:03:34", "text": "什麼意思？只有你會被傳送"}, {"type": "subtitle", "time": 21824.15, "timestamp": "06:03:44", "text": "。木板會傳送你。為什麼？過來。過來。過來。你好。過來。過來。為什麼生孩子這麼難？是啊。是啊。過來。待在那裡。過來。拿著這個。先拿著這個。過來。過來。我的天哪。哦，等等"}, {"type": "chat", "time": 21832.712, "timestamp": "06:03:52", "author": "@YoshinoForger", "avatar": "https://yt4.ggpht.com/8gvoFZRCC3O1WtnuXJ-8nNaJku7JJTjtn6w5sm-PHzI80a-qpWom6sTXzcrDXoKhi0Ggs3FkOg=s64-c-k-c0x00ffffff-no-rj", "message": "😂😂😂😂"}]
[{"type": "subtitle", "time": 7889.95, "timestamp": "02:11:29", "text": "走吧。是的，她很會講笑話。我喜歡《"}, {"type": "subtitle", "time": 7892.709, "timestamp": "02:11:32", "text": "時空之輪》。夥計，我以後也想委託她做專案"}, {"type": "subtitle", "time": 7895.39, "timestamp": "02:11:35", "text": "。用於表情之類的"}, {"type": "subtitle", "time": 7898.91, "timestamp": "02:11:38", "text": "東西，不過確實"}, {"type": "subtitle", "time": 7901.75, "timestamp": "02:11:41", "text": "很貴。委託他人工作可能會很"}, {"type": "subtitle", "time": 7907.669, "timestamp": "02:11:47", "text": "昂貴。哦，演出費啊。我有"}, {"type": "subtitle", "time": 7916.47, "timestamp": "02:11:56", "text": "還有紙杯蛋糕口味的，以及聊天口味和"}, {"type": "subtitle", "time": 7919.83, "timestamp": "02:11:59", "text": "馬卡龍口味的。那三個是 YouTube"}]
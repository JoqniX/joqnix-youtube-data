[{"type": "subtitle", "time": 10321.19, "timestamp": "02:52:01", "text": "H. [音樂] F 鍛造模具和織物。他們倆都做好準備了"}, {"type": "subtitle", "time": 10322.87, "timestamp": "02:52:02", "text": "。阿魯阿魯爾阿魯卡支援。什麼是aruka？  什麼是速度"}, {"type": "subtitle", "time": 10325.99, "timestamp": "02:52:05", "text": "？我猜這些應該是舊版吧。"}, {"type": "subtitle", "time": 10328.07, "timestamp": "02:52:08", "text": "瀑布。真是個好名字。  好的。這些就像是老版的Neo Forge。哦，這個也很有趣。需要等待載入完成。還有"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "插件。現在"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "你可以像這樣輕鬆安裝它。這簡直太瘋狂了！  她聽音樂嗎"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "？你好。你好。  很多音樂。"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "沒關係。  等等，你還有東西？我把熔岩裡的一切都摧毀了。  你何時摧毀了我的城堡？不，不，不。我毀了"}, {"type": "subtitle", "time": 10375.309, "timestamp": "02:52:55", "text": "我的房子。那是你自己的房子嗎？我的天啊"}]
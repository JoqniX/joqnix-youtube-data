[{"type": "subtitle", "time": 3785.309, "timestamp": "01:03:05", "text": "。好了。好的，完美。"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "呃，好的。把錢袋和這些"}, {"type": "subtitle", "time": 3791.63, "timestamp": "01:03:11", "text": "小東西放在卡片裡。好的。"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "卡片。瞧瞧那傢伙，賤人。好的。喲。"}, {"type": "subtitle", "time": 3800.23, "timestamp": "01:03:20", "text": "電腦。我的天啊。太棒了。"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "這個也是一樣，對吧？"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "再次。嗯，是的，就是所有的小"}, {"type": "subtitle", "time": 3808.47, "timestamp": "01:03:28", "text": "物件。把它放進那個東西裡。我的意思是，"}, {"type": "subtitle", "time": 3811.27, "timestamp": "01:03:31", "text": "因為我真的……呃，"}, {"type": "subtitle", "time": 3813.99, "timestamp": "01:03:33", "text": "這些電腦怎麼樣？我們先把它抬起來，"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "需要幫助。  不，"}, {"type": "subtitle", "time": 3825.349, "timestamp": "01:03:45", "text": "我們很好。我們很好。為什麼？我們為什麼"}, {"type": "subtitle", "time": 3827.91, "timestamp": "01:03:47", "text": "站在這裡？  好的。"}, {"type": "subtitle", "time": 3832.309, "timestamp": "01:03:52", "text": "比如什麼？再次。不，不，不。  好的。好的。呃，不。不。"}, {"type": "subtitle", "time": 3835.51, "timestamp": "01:03:55", "text": "為什麼？不，停。  停止。停止。停止"}, {"type": "subtitle", "time": 3836.75, "timestamp": "01:03:56", "text": "。"}, {"type": "subtitle", "time": 3838.87, "timestamp": "01:03:58", "text": "停止。我正把它舉到身體一側。"}]
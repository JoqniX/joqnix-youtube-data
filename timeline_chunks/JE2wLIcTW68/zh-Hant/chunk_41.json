[{"type": "subtitle", "time": 2461.589, "timestamp": "00:41:01", "text": "這種藥水欲罷不能。我的天啊"}, {"type": "subtitle", "time": 2464.829, "timestamp": "00:41:04", "text": "，他居然得到了藥水。  喲，很高興見到你。哇"}, {"type": "subtitle", "time": 2472.349, "timestamp": "00:41:12", "text": "哇，哇。嘿"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "，"}, {"type": "subtitle", "time": 2482.55, "timestamp": "00:41:22", "text": "嗯，它讓你對"}, {"type": "subtitle", "time": 2485.99, "timestamp": "00:41:25", "text": "他人產生同情心。好了，各位。大家跑到"}, {"type": "subtitle", "time": 2488.23, "timestamp": "00:41:28", "text": "船上，然後你說浪漫的話。  等等，等等。所有人"}, {"type": "subtitle", "time": 2489.589, "timestamp": "00:41:29", "text": "，所有人快跑到"}, {"type": "subtitle", "time": 2492.309, "timestamp": "00:41:32", "text": "船上去。我會在那裡。對，快跑。  跑就行了。  大家"}, {"type": "subtitle", "time": 2517.23, "timestamp": "00:41:57", "text": "。我死了嗎？對不起。"}]
[{"type": "subtitle", "time": 26521.59, "timestamp": "07:22:01", "text": "知道。嗯哼。它和奧利奧是同一家公司的產品，我也嚐過奧利奧口味的麥片"}, {"type": "subtitle", "time": 26524.39, "timestamp": "07:22:04", "text": "。有一種"}, {"type": "subtitle", "time": 26526.468, "timestamp": "07:22:06", "text": "奧利奧口味的麥片。等等，"}, {"type": "subtitle", "time": 26529.67, "timestamp": "07:22:09", "text": "什麼？是的，它不是印度的。就像24小時營業一樣。價格非常昂貴。它和芬達口味一樣都是進口的。就像那個閃光燈一樣。我非常確定 Blinket 會有。  哦好的。"}, {"type": "subtitle", "time": 26547.07, "timestamp": "07:22:27", "text": "奧利奧麥片。  我試過了。挺好的。  奧利奧。它的名字是奧利奧。"}, {"type": "subtitle", "time": 26556.15, "timestamp": "07:22:36", "text": "哇。你甚至還記得這個名字？"}, {"type": "subtitle", "time": 26570.59, "timestamp": "07:22:50", "text": "我記憶力很好。順便說一句，我有奧利奧餅乾。該死。我可以吃奧利奧餅乾。好的。"}]
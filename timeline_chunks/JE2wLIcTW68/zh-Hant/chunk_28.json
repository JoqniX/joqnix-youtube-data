[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "嗯，差不多就是這樣。"}, {"type": "subtitle", "time": 1684.63, "timestamp": "00:28:04", "text": "我的天，它爆炸了。狗"}, {"type": "subtitle", "time": 1688.87, "timestamp": "00:28:08", "text": "死了嗎？不，不，不。我不這麼認為。嘿，"}, {"type": "subtitle", "time": 1691.83, "timestamp": "00:28:11", "text": "給你。"}, {"type": "subtitle", "time": 1693.909, "timestamp": "00:28:13", "text": "叉子插進我們的…它"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "像到處一樣造成嚴重破壞。"}, {"type": "subtitle", "time": 1699.269, "timestamp": "00:28:19", "text": "是的。好了，大家準備好了。呃，打我們。"}, {"type": "subtitle", "time": 1702.31, "timestamp": "00:28:22", "text": "準備好了嗎？不，不，不。打我們。你"}, {"type": "subtitle", "time": 1703.909, "timestamp": "00:28:23", "text": "去撿一個醫療包，然後把它帶進"}, {"type": "subtitle", "time": 1705.83, "timestamp": "00:28:25", "text": "太空船。"}, {"type": "subtitle", "time": 1708.87, "timestamp": "00:28:28", "text": "實際去做。好的，稍等。"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "為什麼不呢？"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "嗯，我選大的。"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "獵人那個。  我的天"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "，"}, {"type": "subtitle", "time": 1724.63, "timestamp": "00:28:44", "text": "走吧。好了，上船吧。"}, {"type": "subtitle", "time": 1727.029, "timestamp": "00:28:47", "text": "上船，準備開始"}, {"type": "subtitle", "time": 1734.549, "timestamp": "00:28:54", "text": "快，快。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "你收到了嗎？"}, {"type": "subtitle", "time": 1739.669, "timestamp": "00:28:59", "text": "等待。重新裝彈。"}]
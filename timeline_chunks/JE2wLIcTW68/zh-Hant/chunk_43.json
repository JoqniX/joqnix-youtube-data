[{"type": "subtitle", "time": 2583.829, "timestamp": "00:43:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 2587.27, "timestamp": "00:43:07", "text": "那真是一記全壘打。"}, {"type": "subtitle", "time": 2590.79, "timestamp": "00:43:10", "text": "你的東西。我在這裡放了一些。"}, {"type": "subtitle", "time": 2593.589, "timestamp": "00:43:13", "text": "等等，你的體力就在這裡。你把它掉了"}, {"type": "subtitle", "time": 2597.99, "timestamp": "00:43:17", "text": "。我能獲得足夠的耐力嗎？當然可以"}, {"type": "subtitle", "time": 2599.91, "timestamp": "00:43:19", "text": "。"}, {"type": "subtitle", "time": 2601.67, "timestamp": "00:43:21", "text": "我們獲得了兩份體力。我們走吧。給"}, {"type": "subtitle", "time": 2604.15, "timestamp": "00:43:24", "text": "你一個。那在哪裡？有件事。它"}, {"type": "subtitle", "time": 2606.309, "timestamp": "00:43:26", "text": "在另一邊。一秒鐘。我們能用"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "棒球棒打死那個怪物嗎？"}, {"type": "subtitle", "time": 2612.63, "timestamp": "00:43:32", "text": "嗯，可以，但是很貴。我還要"}, {"type": "subtitle", "time": 2621.03, "timestamp": "00:43:41", "text": "強壯有力。好的。某個運動員。快點。"}, {"type": "subtitle", "time": 2624.75, "timestamp": "00:43:44", "text": "我去。呃，先按Q鍵將角色變成布娃娃"}, {"type": "subtitle", "time": 2629.19, "timestamp": "00:43:49", "text": "。好的。給我。謝謝。  好的。"}, {"type": "subtitle", "time": 2633.23, "timestamp": "00:43:53", "text": "哦，謝謝。"}, {"type": "subtitle", "time": 2637.99, "timestamp": "00:43:57", "text": "好的。我可以拿到手榴彈嗎？是的。"}, {"type": "subtitle", "time": 2639.43, "timestamp": "00:43:59", "text": "有時並沒有。有時候什麼都沒有"}]
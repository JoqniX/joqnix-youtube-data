[{"type": "subtitle", "time": 1744.19, "timestamp": "00:29:04", "text": "100. 走吧，作弊者們。它被稱為"}, {"type": "subtitle", "time": 1756.23, "timestamp": "00:29:16", "text": "爆炸速度。我直接按E鍵就行了嗎？"}, {"type": "subtitle", "time": 1758.71, "timestamp": "00:29:18", "text": "對，按E鍵。對，就按E鍵。呃，"}, {"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "誰有提到耐力？是的，確實如此。"}, {"type": "subtitle", "time": 1766.549, "timestamp": "00:29:26", "text": "那我就選擇精神速度吧。  是的"}, {"type": "subtitle", "time": 1769.51, "timestamp": "00:29:29", "text": "。好的。哦，喬。這就是"}, {"type": "subtitle", "time": 1778.23, "timestamp": "00:29:38", "text": "兄弟，你這槍法有點爛。你好，"}, {"type": "subtitle", "time": 1780.07, "timestamp": "00:29:40", "text": "塞拉斯蒂婭。歡迎來到直播間。我的目標是"}, {"type": "subtitle", "time": 1782.31, "timestamp": "00:29:42", "text": "堅果。"}, {"type": "subtitle", "time": 1785.029, "timestamp": "00:29:45", "text": "哇。好吧，我的目標是"}, {"type": "subtitle", "time": 1788.149, "timestamp": "00:29:48", "text": "造成濺射傷害，兄弟。"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "好的，這次由別人來選切菜"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "。我肯定會四處看看。"}, {"type": "subtitle", "time": 1796.07, "timestamp": "00:29:56", "text": "我是獵人。我的意思是，"}, {"type": "subtitle", "time": 1798.23, "timestamp": "00:29:58", "text": "如果你需要的話，我可以幫忙做購物車。哦，你可以直接"}]
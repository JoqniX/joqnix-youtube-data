[{"type": "subtitle", "time": 1020.269, "timestamp": "00:17:00", "text": "好的。我的"}, {"type": "subtitle", "time": 1041.27, "timestamp": "00:17:21", "text": "但敵人也存在。  好了，"}, {"type": "subtitle", "time": 1042.99, "timestamp": "00:17:22", "text": "夥計們。我"}, {"type": "subtitle", "time": 1046.87, "timestamp": "00:17:26", "text": "來了。那麼，誰才是真正的怪物呢？"}, {"type": "subtitle", "time": 1049.35, "timestamp": "00:17:29", "text": "怪物之類的東西。 100 衝刺。我們可以"}, {"type": "subtitle", "time": 1054.31, "timestamp": "00:17:34", "text": "直接拿走東西。打擾一下。耶穌。哦。  哦"}, {"type": "subtitle", "time": 1056.789, "timestamp": "00:17:36", "text": "，等等。不要碰它。不要碰它"}, {"type": "subtitle", "time": 1059.35, "timestamp": "00:17:39", "text": "。好的。不要碰它。為什麼？"}, {"type": "subtitle", "time": 1061.43, "timestamp": "00:17:41", "text": "實際上，並非如此。不要碰娃娃。這是"}, {"type": "subtitle", "time": 1063.59, "timestamp": "00:17:43", "text": "一個可怕的娃娃。用購物車拿過來。  把"}, {"type": "subtitle", "time": 1066.15, "timestamp": "00:17:46", "text": "推車帶來。不，不，別帶。"}, {"type": "subtitle", "time": 1068.95, "timestamp": "00:17:48", "text": "直接滴在萃取物上。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "是的。喬，把它撿起來。快點。去做。"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "是的，你可以試試，喬。是的。是的。請務必撿起來"}, {"type": "subtitle", "time": 1076.23, "timestamp": "00:17:56", "text": "。快點。這個。這就是我的"}, {"type": "subtitle", "time": 1078.83, "timestamp": "00:17:58", "text": "計劃。可怕。我的天啊"}]
[{"type": "subtitle", "time": 2404.79, "timestamp": "00:40:04", "text": "下午。現在我被命令去"}, {"type": "subtitle", "time": 2407.03, "timestamp": "00:40:07", "text": "商店，所以不行。真倒楣。"}, {"type": "subtitle", "time": 2415.03, "timestamp": "00:40:15", "text": "先生，請您保重身體。哦，哇，哇，哇，哇，哇。"}, {"type": "subtitle", "time": 2417.75, "timestamp": "00:40:17", "text": "哦，我真慶幸躲過了你這趟麻煩事"}, {"type": "subtitle", "time": 2419.51, "timestamp": "00:40:19", "text": "。"}, {"type": "subtitle", "time": 2423.51, "timestamp": "00:40:23", "text": "絕對沒出什麼岔子。  好的。"}, {"type": "subtitle", "time": 2431.03, "timestamp": "00:40:31", "text": "。  是的。"}, {"type": "subtitle", "time": 2435.349, "timestamp": "00:40:35", "text": "好的。最後一項。"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "我猜這是期末考。這裡有一些"}, {"type": "subtitle", "time": 2438.43, "timestamp": "00:40:38", "text": "貝殼"}]
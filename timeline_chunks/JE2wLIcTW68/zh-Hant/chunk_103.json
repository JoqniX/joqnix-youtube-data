[{"type": "subtitle", "time": 6205.79, "timestamp": "01:43:25", "text": "嗯，還是找不到紅色的陣雨，它們"}, {"type": "subtitle", "time": 6210.79, "timestamp": "01:43:30", "text": "發出聲音。它叫"}, {"type": "subtitle", "time": 6222.27, "timestamp": "01:43:42", "text": "很累。所以，"}, {"type": "subtitle", "time": 6226.86, "timestamp": "01:43:46", "text": "一位疲憊的騎師。  [音樂] 噠噠噠噠。  [音樂] 嗯，鍶鍶。"}]
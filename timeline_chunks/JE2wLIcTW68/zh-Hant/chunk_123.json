[{"type": "subtitle", "time": 7381.47, "timestamp": "02:03:01", "text": "。讓我馬上辦一下"}, {"type": "subtitle", "time": 7385.91, "timestamp": "02:03:05", "text": "。推。推。我不想看。"}, {"type": "subtitle", "time": 7387.99, "timestamp": "02:03:07", "text": "哦，我還有這支筆。哦"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "為什麼要請我喝咖啡？我需要去掉"}, {"type": "subtitle", "time": 7430.83, "timestamp": "02:03:50", "text": "閃爍。我有時覺得應該"}, {"type": "subtitle", "time": 7434.589, "timestamp": "02:03:54", "text": "把 Joathon 的事放在"}, {"type": "subtitle", "time": 7439.629, "timestamp": "02:03:59", "text": "開頭，因為那件事"}]
[{"type": "subtitle", "time": 2282.63, "timestamp": "00:38:02", "text": "。  如果我"}, {"type": "subtitle", "time": 2285.43, "timestamp": "00:38:05", "text": "搶到最高分就好了。"}, {"type": "subtitle", "time": 2287.349, "timestamp": "00:38:07", "text": "11."}, {"type": "subtitle", "time": 2291.15, "timestamp": "00:38:11", "text": "好吧，給他 20 分。我可以做到。把他還給他。夠了"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "。夠了。"}, {"type": "subtitle", "time": 2297.349, "timestamp": "00:38:17", "text": "操我。操我。哦"}, {"type": "subtitle", "time": 2299.91, "timestamp": "00:38:19", "text": "，真倒楣。給"}, {"type": "subtitle", "time": 2307.589, "timestamp": "00:38:27", "text": "美好的。我當時已經…你現在的HP是多少"}, {"type": "subtitle", "time": 2310.87, "timestamp": "00:38:30", "text": "？ 15. 前方項目。我19歲了。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "讓我直接往前走。"}, {"type": "subtitle", "time": 2315.75, "timestamp": "00:38:35", "text": "啊，夠了。好的。好的。前面有一件"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "物品。我去拿。  是的。"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "直行。哦，在"}, {"type": "subtitle", "time": 2321.61, "timestamp": "00:38:41", "text": "這邊。高腳杯。"}, {"type": "subtitle", "time": 2322.71, "timestamp": "00:38:42", "text": "[音樂]"}, {"type": "subtitle", "time": 2326.15, "timestamp": "00:38:46", "text": "順便說一句，是的，她獵殺那隻鴨子很漂亮"}, {"type": "subtitle", "time": 2328.069, "timestamp": "00:38:48", "text": "。我不知道這是"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "不是故意的。哦，當然。"}, {"type": "subtitle", "time": 2335.19, "timestamp": "00:38:55", "text": "確實。還有一件事。堅持，"}, {"type": "subtitle", "time": 2337.109, "timestamp": "00:38:57", "text": "稍等。"}]
[{"type": "subtitle", "time": 21966.15, "timestamp": "06:06:06", "text": "。你知道嗎？我"}, {"type": "subtitle", "time": 21976.948, "timestamp": "06:06:16", "text": "。這裡是韓國。這是什麼？哦，小心"}, {"type": "subtitle", "time": 22007.43, "timestamp": "06:06:47", "text": "。好吧。"}, {"type": "subtitle", "time": 22009.35, "timestamp": "06:06:49", "text": "我什麼都沒有。哦，我的天哪。我又找到一隻貓。哦，我的天。哦，等等。這是另一隻。好吧。為什麼……你在"}, {"type": "subtitle", "time": 22018.03, "timestamp": "06:06:58", "text": "這裡？我的天啊。粉筆。把它們殺了，再弄一隻新的。什麼？太殘忍了。你是嗎？他是巴基莫諾。希望你忘了。"}]
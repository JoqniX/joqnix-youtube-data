[{"type": "subtitle", "time": 1265.83, "timestamp": "00:21:05", "text": "我快瘋了。我看得出來。"}, {"type": "subtitle", "time": 1283.68, "timestamp": "00:21:23", "text": "哦，她來了。"}, {"type": "subtitle", "time": 1295.029, "timestamp": "00:21:35", "text": "哦，瞧。這是什麼？"}, {"type": "subtitle", "time": 1297.43, "timestamp": "00:21:37", "text": "哦，那可真難。好的，MJ。我們"}, {"type": "subtitle", "time": 1298.95, "timestamp": "00:21:38", "text": "打算把購物車放在這裡，因為"}, {"type": "subtitle", "time": 1301.029, "timestamp": "00:21:41", "text": "我們擁有的已經超過了所需"}, {"type": "subtitle", "time": 1303.43, "timestamp": "00:21:43", "text": "，所以我們不妨再進"}, {"type": "subtitle", "time": 1307.75, "timestamp": "00:21:47", "text": "一些貨，這樣就能獲得額外的利潤。"}, {"type": "subtitle", "time": 1310.549, "timestamp": "00:21:50", "text": "好的。就像，就像，呃，"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "另一個遊戲是什麼？呃，致命公司，你知道的。"}, {"type": "subtitle", "time": 1317.35, "timestamp": "00:21:57", "text": "哦，致命的。好的。好的。是啊，我頭痛"}, {"type": "subtitle", "time": 1319.75, "timestamp": "00:21:59", "text": "。先生，您應該躺下。喝點"}]
[{"type": "subtitle", "time": 1205.19, "timestamp": "00:20:05", "text": "啊。他正上樓來。我們很好。"}, {"type": "subtitle", "time": 1209.75, "timestamp": "00:20:09", "text": "我們正在放鬆。艾登。艾登。  我的"}, {"type": "subtitle", "time": 1215.43, "timestamp": "00:20:15", "text": "天哪。哦，她現在纏著我了。好的。"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "感覺有點像《小夢魘》之"}, {"type": "subtitle", "time": 1220.95, "timestamp": "00:20:20", "text": "類的遊戲。確實如此。哦，是的。確實如此，"}, {"type": "subtitle", "time": 1223.83, "timestamp": "00:20:23", "text": "對吧？"}, {"type": "subtitle", "time": 1226.19, "timestamp": "00:20:26", "text": "順便說一句，我從來沒玩過那個遊戲"}, {"type": "subtitle", "time": 1228.029, "timestamp": "00:20:28", "text": "。說到"}, {"type": "subtitle", "time": 1238.95, "timestamp": "00:20:38", "text": "她又進房間了嗎？"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "決不。正確的。不，不，她太過分了。"}, {"type": "subtitle", "time": 1243.11, "timestamp": "00:20:43", "text": "她走路時不說話嗎？就像她"}, {"type": "subtitle", "time": 1244.39, "timestamp": "00:20:44", "text": "沒有被激活時，她不會發出任何"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "聲音。我的天哪。  真令人"}, {"type": "subtitle", "time": 1253.19, "timestamp": "00:20:53", "text": "難過。壞消息。"}, {"type": "subtitle", "time": 1255.51, "timestamp": "00:20:55", "text": "我們下去嗎？別說那種話，"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "聊天。你在輸入什麼？我不會說"}]
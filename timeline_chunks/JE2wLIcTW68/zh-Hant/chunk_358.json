[{"type": "subtitle", "time": 21489.91, "timestamp": "05:58:09", "text": "夥計們。你們在哪裡？過來。"}, {"type": "subtitle", "time": 21493.67, "timestamp": "05:58:13", "text": "哦，不。我死了嗎？沒有。沒有。什麼？他們在哪裡？他們來了嗎？不，他們沒來。"}, {"type": "subtitle", "time": 21502.948, "timestamp": "05:58:22", "text": "我的天哪。我本來想說些什麼。我的天哪。我要說什麼來著？好吧，我忘了。算了。等等，我的貓真的死了嗎？哦，算了。好吧，她在這裡。好吧。"}, {"type": "subtitle", "time": 21522.75, "timestamp": "05:58:42", "text": "你好。過來。"}, {"type": "subtitle", "time": 21539.75, "timestamp": "05:58:59", "text": "我的不見了。哦"}]
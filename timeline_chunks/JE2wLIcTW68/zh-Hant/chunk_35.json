[{"type": "subtitle", "time": 2100.39, "timestamp": "00:35:00", "text": "別加入那位皇室船員隊伍。"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "如果我輸入“如何復活Kto？”會發生什麼？"}, {"type": "subtitle", "time": 2108.63, "timestamp": "00:35:08", "text": "我們可以。我想，當我們完成四分之一的任務後，"}, {"type": "subtitle", "time": 2110.39, "timestamp": "00:35:10", "text": "如果你的"}, {"type": "subtitle", "time": 2113.109, "timestamp": "00:35:13", "text": "頭顱已經達到配額或是在"}, {"type": "subtitle", "time": 2116.47, "timestamp": "00:35:16", "text": "船上，你就會復活。所以，把他放進"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "船上就好了。他會沒事的。還是說你需要"}, {"type": "subtitle", "time": 2121.829, "timestamp": "00:35:21", "text": "在這裡碰他一下？哦，天哪。好"}, {"type": "subtitle", "time": 2123.91, "timestamp": "00:35:23", "text": "一個。"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "好的，這樣可以。那傢伙還是……"}, {"type": "subtitle", "time": 2127.31, "timestamp": "00:35:27", "text": "我的天。"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "我看到的是叫「貓咪」之類的"}]
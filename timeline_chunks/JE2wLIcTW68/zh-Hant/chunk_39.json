[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "我的意思是，我會保護自己。"}, {"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "我打算直接去看看發生了什麼"}, {"type": "subtitle", "time": 2348.31, "timestamp": "00:39:08", "text": "稍等。哦，第二個就在那"}, {"type": "subtitle", "time": 2351.51, "timestamp": "00:39:11", "text": "扇門後面。誰來拉一下。這是什麼？"}, {"type": "subtitle", "time": 2355.19, "timestamp": "00:39:15", "text": "哦，對了，還有第二個。所以"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "萃取率會這樣增加，嗯，"}, {"type": "subtitle", "time": 2361.109, "timestamp": "00:39:21", "text": "之後會有 2，"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "然後會有 3，"}, {"type": "subtitle", "time": 2365.109, "timestamp": "00:39:25", "text": "就像"}, {"type": "subtitle", "time": 2376.15, "timestamp": "00:39:36", "text": "哦，還有一件。好的。我們走吧。"}, {"type": "subtitle", "time": 2378.87, "timestamp": "00:39:38", "text": "這裡什麼都沒有嗎？哦，別忘了"}, {"type": "subtitle", "time": 2380.47, "timestamp": "00:39:40", "text": "打開這些架子，好嗎？是的。"}, {"type": "subtitle", "time": 2382.95, "timestamp": "00:39:42", "text": "別忘了打開貝殼。是的。  好的。是的"}, {"type": "subtitle", "time": 2385.03, "timestamp": "00:39:45", "text": "。記住要打開"}, {"type": "subtitle", "time": 2387.829, "timestamp": "00:39:47", "text": "sh。"}, {"type": "subtitle", "time": 2389.47, "timestamp": "00:39:49", "text": "當然，"}, {"type": "subtitle", "time": 2391.19, "timestamp": "00:39:51", "text": "兄弟。哥們兒，你當時是不是想"}, {"type": "subtitle", "time": 2393.349, "timestamp": "00:39:53", "text": "做點什麼？"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "我用鐵釘把東西釘進去，然後把"}]
[{"type": "subtitle", "time": 3482.95, "timestamp": "00:58:02", "text": "然後我們就可以了。好的，你去拿"}, {"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "這些小件物品吧。我會"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "用心形布娃娃跳躍來練習這個。"}, {"type": "subtitle", "time": 3490.39, "timestamp": "00:58:10", "text": "這就是為什麼你要…不，不，喬。你確實在做"}, {"type": "subtitle", "time": 3492.069, "timestamp": "00:58:12", "text": "，但感覺你沒有升級，"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "而我已經升級了。哦，如果可以的話，請帶上它"}, {"type": "subtitle", "time": 3497.67, "timestamp": "00:58:17", "text": "。對，你跑、跳，然後去"}, {"type": "subtitle", "time": 3500.47, "timestamp": "00:58:20", "text": "救援。沒事的。我打算把"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "它放在外面，然後放在我的……"}, {"type": "subtitle", "time": 3507.829, "timestamp": "00:58:27", "text": "好吧，就是那個大東西，因為我們有……呃……"}, {"type": "subtitle", "time": 3509.75, "timestamp": "00:58:29", "text": "不過，別把它放在提取物裡。"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "不，不，不，不。我們會把它放在「是」的旁邊"}]
[{"type": "subtitle", "time": 29101.27, "timestamp": "08:05:01", "text": "所以你想來待6個月，因為你接下來要一直待在日本。所以，至少也算是罰款吧"}, {"type": "subtitle", "time": 29103.75, "timestamp": "08:05:03", "text": "。等待。那你去日本的時候會帶你的"}, {"type": "subtitle", "time": 29106.31, "timestamp": "08:05:06", "text": "電腦嗎？"}, {"type": "subtitle", "time": 29109.11, "timestamp": "08:05:09", "text": "我不能帶走我的電腦。由於行李限額，我現在只能帶"}, {"type": "subtitle", "time": 29124.868, "timestamp": "08:05:24", "text": "少量物品。那你"}, {"type": "subtitle", "time": 29127.27, "timestamp": "08:05:27", "text": "會買這台電腦嗎？在那兒買台電腦。那"}, {"type": "subtitle", "time": 29131.51, "timestamp": "08:05:31", "text": "我得從那裡買一台筆記型電腦。那就像是說"}, {"type": "subtitle", "time": 29134.388, "timestamp": "08:05:34", "text": "不要從印度買東西，要從日本買，日本更好，對，更好。你知道，在日本，"}, {"type": "subtitle", "time": 29140.548, "timestamp": "08:05:40", "text": "你可以從二手市場買到很多好東西，像是科技"}, {"type": "subtitle", "time": 29149.43, "timestamp": "08:05:49", "text": "產品。"}, {"type": "subtitle", "time": 29152.43, "timestamp": "08:05:52", "text": "哦，對，因為我認識一些來自布拉特納的日本朋友，他們告訴我，在二手市場可以淘到"}]
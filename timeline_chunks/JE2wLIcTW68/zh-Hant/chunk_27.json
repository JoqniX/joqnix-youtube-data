[{"type": "subtitle", "time": 1621.269, "timestamp": "00:27:01", "text": "哦，是的。我需要這個。我需要那個。吃我一拳"}, {"type": "subtitle", "time": 1623.51, "timestamp": "00:27:03", "text": "。那是什麼？購買衝擊波"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "地雷。喔不，不是衝擊波。對不起。"}, {"type": "subtitle", "time": 1628.149, "timestamp": "00:27:08", "text": "我以為那是地雷。不，不。"}, {"type": "subtitle", "time": 1631.43, "timestamp": "00:27:11", "text": "我丟了一顆手榴彈。所以，我猜是"}, {"type": "subtitle", "time": 1634.149, "timestamp": "00:27:14", "text": "哦，是的。這個。這。"}, {"type": "subtitle", "time": 1638.63, "timestamp": "00:27:18", "text": "哦好的。這個多少錢？ 35. 所以，"}, {"type": "subtitle", "time": 1641.269, "timestamp": "00:27:21", "text": "我給自己買了一個翻滾小屋升級包。"}, {"type": "subtitle", "time": 1644.31, "timestamp": "00:27:24", "text": "誰買了力量升級？"}, {"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "我們要把它給喬。好的。是誰"}, {"type": "subtitle", "time": 1649.909, "timestamp": "00:27:29", "text": "買了體力升級？我。"}, {"type": "subtitle", "time": 1653.43, "timestamp": "00:27:33", "text": "誰買了射程升級？"}, {"type": "subtitle", "time": 1657.51, "timestamp": "00:27:37", "text": "我沒有。等等，什麼？喬克。我想你是"}, {"type": "subtitle", "time": 1659.51, "timestamp": "00:27:39", "text": "誤拿的。不，等等。不，我振作起來了"}, {"type": "subtitle", "time": 1662.23, "timestamp": "00:27:42", "text": "。我覺得我獲得了"}, {"type": "subtitle", "time": 1663.99, "timestamp": "00:27:43", "text": "力量。"}, {"type": "subtitle", "time": 1665.99, "timestamp": "00:27:45", "text": "這個。"}, {"type": "subtitle", "time": 1669.35, "timestamp": "00:27:49", "text": "哦，是射程。哦，不。"}, {"type": "subtitle", "time": 1673.43, "timestamp": "00:27:53", "text": "我的意思是，我們可以買到它。沒關係。  是的"}, {"type": "subtitle", "time": 1675.789, "timestamp": "00:27:55", "text": "，確實如此。"}, {"type": "subtitle", "time": 1679.11, "timestamp": "00:27:59", "text": "沒關係。就這些嗎？"}]
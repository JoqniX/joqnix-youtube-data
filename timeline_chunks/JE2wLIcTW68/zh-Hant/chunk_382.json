[{"type": "subtitle", "time": 22942.21, "timestamp": "06:22:22", "text": "什麼東西？感覺真好。他控制了我的"}, {"type": "subtitle", "time": 22962.57, "timestamp": "06:22:42", "text": "哇。雙倍的陪伴在你身邊。"}, {"type": "subtitle", "time": 22964.868, "timestamp": "06:22:44", "text": "[音樂]"}, {"type": "subtitle", "time": 22971.83, "timestamp": "06:22:51", "text": "不，如何關閉雲朵動畫"}, {"type": "subtitle", "time": 22973.67, "timestamp": "06:22:53", "text": "？點選退出選項。  視訊設定。  是的。"}]
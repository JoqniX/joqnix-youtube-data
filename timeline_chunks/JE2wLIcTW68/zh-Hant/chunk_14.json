[{"type": "subtitle", "time": 842.629, "timestamp": "00:14:02", "text": "碰巧遇到了那個老頭。"}, {"type": "subtitle", "time": 845.269, "timestamp": "00:14:05", "text": "等等，那個老人，那個盲人，"}, {"type": "subtitle", "time": 848.829, "timestamp": "00:14:08", "text": "在第一張地圖裡其實相當罕見。"}, {"type": "subtitle", "time": 850.629, "timestamp": "00:14:10", "text": "什麼？"}, {"type": "subtitle", "time": 853.67, "timestamp": "00:14:13", "text": "我看到有人在"}, {"type": "subtitle", "time": 856.47, "timestamp": "00:14:16", "text": "推車，突然那傢伙從"}, {"type": "subtitle", "time": 858.55, "timestamp": "00:14:18", "text": "門裡衝出來，一槍"}, {"type": "subtitle", "time": 861.75, "timestamp": "00:14:21", "text": "斃命。"}, {"type": "subtitle", "time": 863.829, "timestamp": "00:14:23", "text": "是的。"}, {"type": "subtitle", "time": 867.13, "timestamp": "00:14:27", "text": "你真是個徹頭徹尾的失敗者。"}, {"type": "subtitle", "time": 871.71, "timestamp": "00:14:31", "text": "好吧，我們"}, {"type": "subtitle", "time": 875.67, "timestamp": "00:14:35", "text": "去死吧。好吧，我們"}, {"type": "subtitle", "time": 887.67, "timestamp": "00:14:47", "text": "檢查大家的水分是否足夠。"}, {"type": "subtitle", "time": 889.99, "timestamp": "00:14:49", "text": "謝謝。"}, {"type": "subtitle", "time": 894.87, "timestamp": "00:14:54", "text": "我喝你。嘿，稅務員是什麼？誰"}, {"type": "subtitle", "time": 897.949, "timestamp": "00:14:57", "text": "是稅務員？稅務員是……這"}]
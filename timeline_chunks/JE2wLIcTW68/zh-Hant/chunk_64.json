[{"type": "subtitle", "time": 3841.349, "timestamp": "01:04:01", "text": "直接從底部提起就行了。誰來"}, {"type": "subtitle", "time": 3843.51, "timestamp": "01:04:03", "text": "扶住。  好了。"}, {"type": "subtitle", "time": 3847.91, "timestamp": "01:04:07", "text": "某人。是的。好的。太多了。太多了。太多了。太多了。  好的。好的。好的。準備好。"}, {"type": "subtitle", "time": 3854.549, "timestamp": "01:04:14", "text": "呃，我們需要不，"}, {"type": "subtitle", "time": 3863.109, "timestamp": "01:04:23", "text": "停止。停止。停止。完美的。哦好的。"}, {"type": "subtitle", "time": 3864.87, "timestamp": "01:04:24", "text": "不，那個按鍵沒有"}, {"type": "subtitle", "time": 3868.549, "timestamp": "01:04:28", "text": "其他按鍵的剪下。呃，就是這個。這。好的。  呃"}, {"type": "subtitle", "time": 3870.309, "timestamp": "01:04:30", "text": "，留著這張卡吧。不，不，不。請將"}, {"type": "subtitle", "time": 3872.39, "timestamp": "01:04:32", "text": "卡片放在背面。好的。我把它拉"}, {"type": "subtitle", "time": 3874.789, "timestamp": "01:04:34", "text": "進來。我把它拉進來。人們把它推到"}, {"type": "subtitle", "time": 3879.349, "timestamp": "01:04:39", "text": "裡面。好的。準備好？大家準備好了嗎？去。"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "蘑菇。推。推。誰能幫我解決"}, {"type": "subtitle", "time": 3884.15, "timestamp": "01:04:44", "text": "這個CPU的問題？是的，我"}, {"type": "subtitle", "time": 3887.51, "timestamp": "01:04:47", "text": "會負責剪輯。真爛。做這張卡片。做這張"}, {"type": "subtitle", "time": 3892.789, "timestamp": "01:04:52", "text": "卡片。呃，你趕緊跑出那裡。"}, {"type": "subtitle", "time": 3894.309, "timestamp": "01:04:54", "text": "不，是角度。調整角度。調整角度。  調整角度。不用擔心。不用擔心。  不用"}, {"type": "subtitle", "time": 3896.789, "timestamp": "01:04:56", "text": "擔心。不，它會壞的，"}, {"type": "subtitle", "time": 3898.71, "timestamp": "01:04:58", "text": "兄弟。"}]
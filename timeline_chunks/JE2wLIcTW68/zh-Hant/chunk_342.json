[{"type": "subtitle", "time": 20525.51, "timestamp": "05:42:05", "text": "喜歡那首歌。你你日文唱得"}, {"type": "subtitle", "time": 20553.19, "timestamp": "05:42:33", "text": "真好。"}, {"type": "subtitle", "time": 20558.548, "timestamp": "05:42:38", "text": "你是怎麼一邊唱一邊看樂譜、音高什麼的？ Sukore。我學的。我真的很喜歡這首歌。我也學了日文。"}, {"type": "subtitle", "time": 20564.11, "timestamp": "05:42:44", "text": "你想"}]
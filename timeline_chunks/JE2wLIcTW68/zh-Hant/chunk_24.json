[{"type": "subtitle", "time": 1441.11, "timestamp": "00:24:01", "text": "這邊忙得不可開交。好吧，我們"}, {"type": "subtitle", "time": 1443.99, "timestamp": "00:24:03", "text": "收回剛才的話。快點。"}, {"type": "subtitle", "time": 1445.35, "timestamp": "00:24:05", "text": "我要去開路，"}, {"type": "subtitle", "time": 1448.47, "timestamp": "00:24:08", "text": "因為我的生命值只有1點。"}, {"type": "subtitle", "time": 1469.51, "timestamp": "00:24:29", "text": "死的。不。我的天哪。我的天啊。那"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "我們賺了很多錢。是的。打擾一下。  我們"}, {"type": "subtitle", "time": 1480.549, "timestamp": "00:24:40", "text": "走吧。當然。等待。喬。待在"}, {"type": "subtitle", "time": 1487.35, "timestamp": "00:24:47", "text": "什麼？那是什麼？不，當你跳躍、奔跑"}, {"type": "subtitle", "time": 1488.87, "timestamp": "00:24:48", "text": "、跳躍並擊中某人並"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "按下 Q 鍵時，會產生類似翻滾發射的效果，"}, {"type": "subtitle", "time": 1494.71, "timestamp": "00:24:54", "text": "這真的很酷。是的，我喜歡"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "翻滾發射。就像51歲一樣。真搞笑。"}, {"type": "subtitle", "time": 1499.51, "timestamp": "00:24:59", "text": "同時，如果"}]
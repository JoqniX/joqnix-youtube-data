[{"type": "subtitle", "time": 4381.149, "timestamp": "01:13:01", "text": "車裡嗎？"}, {"type": "subtitle", "time": 4383.03, "timestamp": "01:13:03", "text": "耶穌，別再到處帶著祂的頭顱了"}, {"type": "subtitle", "time": 4410.07, "timestamp": "01:13:30", "text": "我知道這是件大事。讓我們"}, {"type": "subtitle", "time": 4412.63, "timestamp": "01:13:32", "text": "把它放在萃取處。我建議"}, {"type": "subtitle", "time": 4426.229, "timestamp": "01:13:46", "text": "好的，我們先別急著推進去。好的，我們就繼續這樣下去。"}, {"type": "subtitle", "time": 4429.59, "timestamp": "01:13:49", "text": "好，一定要"}]
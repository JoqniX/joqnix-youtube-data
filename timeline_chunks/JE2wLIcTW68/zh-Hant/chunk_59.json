[{"type": "subtitle", "time": 3546.589, "timestamp": "00:59:06", "text": "[音樂]"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "當心。記住，不同的"}, {"type": "subtitle", "time": 3578.95, "timestamp": "00:59:38", "text": "聯絡人傾向於「我"}, {"type": "subtitle", "time": 3583.67, "timestamp": "00:59:43", "text": "聽說你移動了卡片」。哦，有點"}, {"type": "subtitle", "time": 3585.99, "timestamp": "00:59:45", "text": "遠。"}, {"type": "subtitle", "time": 3588.789, "timestamp": "00:59:48", "text": "你為什麼就這麼走了？我不知道"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "帶著它到底有多真實，老兄。"}, {"type": "subtitle", "time": 3594.63, "timestamp": "00:59:54", "text": "我當時沒帶著它。你……我以為"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "你是……繼續前進。留著吧。"}]
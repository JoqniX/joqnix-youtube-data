[{"type": "subtitle", "time": 4085.829, "timestamp": "01:08:05", "text": "天啊。我將是最後的倖存者。"}, {"type": "subtitle", "time": 4108.45, "timestamp": "01:08:28", "text": "啊哈。媽的。"}, {"type": "subtitle", "time": 4118.99, "timestamp": "01:08:38", "text": "啊哈。啊哈。  哦。啊。不，不。"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "嘿，喬。和平，夥計。和平。快點。"}, {"type": "subtitle", "time": 4128.55, "timestamp": "01:08:48", "text": "我們必須為和平而活，夥計。是的。  快點"}]
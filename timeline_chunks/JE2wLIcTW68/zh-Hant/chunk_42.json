[{"type": "subtitle", "time": 2523.67, "timestamp": "00:42:03", "text": "時間限制之類的。"}, {"type": "subtitle", "time": 2525.71, "timestamp": "00:42:05", "text": "頭屁股在哪裡？不，不，是有時間"}, {"type": "subtitle", "time": 2529.91, "timestamp": "00:42:09", "text": "限制的。絕對沒問題。"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "我沒事。是的，他一直躲藏著。我的天啊。"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "你說的「躲藏」是什麼意思？我在"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "吃飯呢，兄弟。快點。"}, {"type": "subtitle", "time": 2540.47, "timestamp": "00:42:20", "text": "晚餐時間到了。哦，我一定要讓"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "你丟盡臉面。晚餐時間。你是什​​麼"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "意思？是的。你知道嗎？好的。更多"}, {"type": "subtitle", "time": 2548.309, "timestamp": "00:42:28", "text": "升級。等等，那是什麼？"}, {"type": "subtitle", "time": 2563.109, "timestamp": "00:42:43", "text": "。兄弟，你這次沒打中。揮棒落空。"}, {"type": "subtitle", "time": 2571.39, "timestamp": "00:42:51", "text": "這東西"}, {"type": "subtitle", "time": 2576.15, "timestamp": "00:42:56", "text": "太對了。嘿，喬。過來。嘿，喬。  是的。是的。"}]
[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "他這樣做是為了避稅。別"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "這麼做。你的稅是什麼？這不是婚姻"}, {"type": "subtitle", "time": 5596.709, "timestamp": "01:33:16", "text": "修這輛車吧。"}, {"type": "subtitle", "time": 5627.47, "timestamp": "01:33:47", "text": "推著購物車進來，然後"}, {"type": "subtitle", "time": 5631.709, "timestamp": "01:33:51", "text": "我們"}, {"type": "subtitle", "time": 5635.83, "timestamp": "01:33:55", "text": "輕輕地……他就在那裡。好的。"}]
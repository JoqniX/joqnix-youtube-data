[{"type": "subtitle", "time": 5822.709, "timestamp": "01:37:02", "text": "你也"}, {"type": "subtitle", "time": 5825.03, "timestamp": "01:37:05", "text": "想……好的。是的，我想我也會"}, {"type": "subtitle", "time": 5827.75, "timestamp": "01:37:07", "text": "結束。哦，玩得很開心。  你好。嘿，真好玩。是啊"}, {"type": "subtitle", "time": 5830.07, "timestamp": "01:37:10", "text": "，那真的很有趣。"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "再見。你好。  再見。"}, {"type": "subtitle", "time": 5839.75, "timestamp": "01:37:19", "text": "講話。晚安。  晚安。晚安"}, {"type": "subtitle", "time": 5843.27, "timestamp": "01:37:23", "text": "。呃，這遊戲很快就能結束"}, {"type": "subtitle", "time": 5846.27, "timestamp": "01:37:26", "text": "，對吧？好的，夠了。"}, {"type": "subtitle", "time": 5862.83, "timestamp": "01:37:42", "text": "好的，希望你們喜歡這個"}, {"type": "subtitle", "time": 5866.91, "timestamp": "01:37:46", "text": "倉庫。我的天哪，我尖叫了好多次。"}, {"type": "subtitle", "time": 5875.189, "timestamp": "01:37:55", "text": "為什麼我對恐怖片這麼不感冒？是的。為什麼我對恐怖片這麼不感冒"}]
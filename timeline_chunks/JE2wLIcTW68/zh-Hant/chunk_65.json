[{"type": "subtitle", "time": 3901.15, "timestamp": "01:05:01", "text": "你說得對。好的。我們救不了"}, {"type": "subtitle", "time": 3904.39, "timestamp": "01:05:04", "text": "他們。喬。不，我們救不了他們。跑"}, {"type": "subtitle", "time": 3906.789, "timestamp": "01:05:06", "text": "回去。跑回去。不，不，拿去吧。拿著吧。"}, {"type": "subtitle", "time": 3908.71, "timestamp": "01:05:08", "text": "帶上它。他們沒事，"}, {"type": "subtitle", "time": 3911.829, "timestamp": "01:05:11", "text": "好吧。喬克。喬克。呃，夥計們，你們可以救救"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "我們。你可以直接把我們的頭顱拉到"}, {"type": "subtitle", "time": 3917.19, "timestamp": "01:05:17", "text": "卡車上。該死的。"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "哦。哦，不。不，不，不。我告訴過你，"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "這些東西會追蹤我們。狗狗，還記得"}]
[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "多的東西。不，不，不，不。"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "不，不，不。讓我們"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "在第一季盡可能多地取得成績。所以，第二"}, {"type": "subtitle", "time": 1991.269, "timestamp": "00:33:11", "text": "個會比較容易。好的。忽略「"}, {"type": "subtitle", "time": 1997.19, "timestamp": "00:33:17", "text": "它會隨機選擇目標人群。"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "現在它是在跟蹤我嗎？還是他媽的在找"}, {"type": "subtitle", "time": 2002.47, "timestamp": "00:33:22", "text": "炸彈，兄弟？"}, {"type": "subtitle", "time": 2003.99, "timestamp": "00:33:23", "text": "把它從購物車旁邊移開，否則我"}, {"type": "subtitle", "time": 2018.31, "timestamp": "00:33:38", "text": "不，不，不。你必須保守"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "秘密。你至少得讓它保持"}, {"type": "subtitle", "time": 2023.59, "timestamp": "00:33:43", "text": "神秘感，因為你會想，「是啊，它"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "會要了你的命，夥計。」好像沒人會"}, {"type": "subtitle", "time": 2027.07, "timestamp": "00:33:47", "text": "發現似的。"}, {"type": "subtitle", "time": 2029.23, "timestamp": "00:33:49", "text": "是的，"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "恐怖分子胡鬧，然後發現了我的"}, {"type": "subtitle", "time": 2035.43, "timestamp": "00:33:55", "text": "天哪。"}]
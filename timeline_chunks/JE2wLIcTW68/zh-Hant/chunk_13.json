[{"type": "subtitle", "time": 780.47, "timestamp": "00:13:00", "text": "這個也是嗎？這不對。不，不，"}, {"type": "subtitle", "time": 782.55, "timestamp": "00:13:02", "text": "不，不。我會玩，但是已經過去一段時間了"}, {"type": "subtitle", "time": 786.069, "timestamp": "00:13:06", "text": "，所以我有點忘了。"}, {"type": "subtitle", "time": 789.03, "timestamp": "00:13:09", "text": "我記得上次你好像也"}, {"type": "subtitle", "time": 791.23, "timestamp": "00:13:11", "text": "一直死掉。我記得這件事。  是的。"}, {"type": "subtitle", "time": 798.15, "timestamp": "00:13:18", "text": "哦，等等。羅的加入。  是的，你可以邀請他。哦，確實如此。我可以邀請你。  他在"}, {"type": "subtitle", "time": 831.03, "timestamp": "00:13:51", "text": "那裡。  你好。  嘿。嘿。嘿。  [音樂] 哦，他來了。好的。你好。你好。  你好。"}, {"type": "subtitle", "time": 835.829, "timestamp": "00:13:55", "text": "大家最近怎麼樣？你做得"}, {"type": "subtitle", "time": 839.269, "timestamp": "00:13:59", "text": "很好。好的。 Jo 運行了第一張地圖。然後喬"}]
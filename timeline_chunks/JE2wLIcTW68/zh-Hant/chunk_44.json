[{"type": "subtitle", "time": 2642.309, "timestamp": "00:44:02", "text": "。"}, {"type": "subtitle", "time": 2645.27, "timestamp": "00:44:05", "text": "哦，不錯。"}, {"type": "subtitle", "time": 2647.109, "timestamp": "00:44:07", "text": "你知道嗎？我會把健康值提上去。  我的天啊"}, {"type": "subtitle", "time": 2655.109, "timestamp": "00:44:15", "text": "手榴彈。又一個"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "變態回來了。是的。謝謝。嗯，我的"}, {"type": "subtitle", "time": 2660.95, "timestamp": "00:44:20", "text": "意思是，又是一顆手榴彈。"}, {"type": "subtitle", "time": 2669.51, "timestamp": "00:44:29", "text": "？就這些了。人體"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "這是一顆超大的手榴彈。"}, {"type": "subtitle", "time": 2680.069, "timestamp": "00:44:40", "text": "不。等等，什麼？不。操。不，是我做的。"}, {"type": "subtitle", "time": 2683.349, "timestamp": "00:44:43", "text": "好了，我把它關掉了。嗯，既然我們"}, {"type": "subtitle", "time": 2685.349, "timestamp": "00:44:45", "text": "有錢，我就打算升級地圖玩家"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "數量，這樣我就能知道誰死了。當然"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "。我們也要買那架無人機嗎？"}, {"type": "subtitle", "time": 2693.67, "timestamp": "00:44:53", "text": "呃，零抓取開始。絕對不行。沒用的"}, {"type": "subtitle", "time": 2697.27, "timestamp": "00:44:57", "text": "。哦，好吧。那架"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "羽毛無人機。羽毛無人機要"}]
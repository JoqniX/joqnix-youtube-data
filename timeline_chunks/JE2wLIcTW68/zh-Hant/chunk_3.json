[{"type": "subtitle", "time": 195.11, "timestamp": "00:03:15", "text": "好的。我承認吧。我承認吧"}, {"type": "subtitle", "time": 198.71, "timestamp": "00:03:18", "text": "。你好。  好了。你好。"}, {"type": "subtitle", "time": 202.07, "timestamp": "00:03:22", "text": "我的天啊。聊吧，"}, {"type": "subtitle", "time": 204.949, "timestamp": "00:03:24", "text": "走吧。等等，"}, {"type": "subtitle", "time": 208.149, "timestamp": "00:03:28", "text": "這裡有多少人？堅持，稍等。"}, {"type": "subtitle", "time": 210.309, "timestamp": "00:03:30", "text": "我這裡有大約18個人。好的。"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "哦，這是什麼遊戲？  我的"}, {"type": "subtitle", "time": 215.589, "timestamp": "00:03:35", "text": "天啊。我既"}, {"type": "subtitle", "time": 218.63, "timestamp": "00:03:38", "text": "興奮又擔心。哦，你們當時在"}, {"type": "subtitle", "time": 220.949, "timestamp": "00:03:40", "text": "打第一檔比賽。比賽怎麼樣？"}, {"type": "subtitle", "time": 224.07, "timestamp": "00:03:44", "text": "是的，我當時是在按計劃行事，兄弟。我"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "沉迷於這款遊戲。這太"}, {"type": "subtitle", "time": 230.309, "timestamp": "00:03:50", "text": "有趣了。我從來沒有對過。我一直在等，等著"}, {"type": "subtitle", "time": 238.22899999999998, "timestamp": "00:03:58", "text": "遊戲的合法重製版出來，我"}]
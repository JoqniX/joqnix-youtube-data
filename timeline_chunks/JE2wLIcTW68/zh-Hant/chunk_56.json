[{"type": "subtitle", "time": 3360.069, "timestamp": "00:56:00", "text": "它們會損壞我們的產品。"}, {"type": "subtitle", "time": 3362.069, "timestamp": "00:56:02", "text": "哦，"}, {"type": "subtitle", "time": 3364.71, "timestamp": "00:56:04", "text": "約翰，過來一下。我找到東西了。"}, {"type": "subtitle", "time": 3374.23, "timestamp": "00:56:14", "text": "我就是馬桶。我的天啊。"}, {"type": "subtitle", "time": 3378.23, "timestamp": "00:56:18", "text": "我將把我的智慧傳授給你。"}, {"type": "subtitle", "time": 3380.87, "timestamp": "00:56:20", "text": "等等，把我沖進馬桶裡。"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "沖水口在哪裡？通常就在"}, {"type": "subtitle", "time": 3392.39, "timestamp": "00:56:32", "text": "大件物品旁邊。我的天哪。我的天哪。  我的天啊"}, {"type": "subtitle", "time": 3396.63, "timestamp": "00:56:36", "text": "。我們很好。我被沖走了。  好的"}, {"type": "subtitle", "time": 3399.75, "timestamp": "00:56:39", "text": "。好了，我們走吧。"}, {"type": "subtitle", "time": 3415.75, "timestamp": "00:56:55", "text": "啊，這邊有個大件物品。夥計們，它可能是"}]
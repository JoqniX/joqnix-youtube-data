[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "運氣好的話，它還能對敵人造成傷害。  是的"}, {"type": "subtitle", "time": 1505.909, "timestamp": "00:25:05", "text": "。升級。勢頭。我們走吧。我們正在"}, {"type": "subtitle", "time": 1508.87, "timestamp": "00:25:08", "text": "升級翻滾小屋。當然。"}, {"type": "subtitle", "time": 1510.71, "timestamp": "00:25:10", "text": "走吧，兄弟。我們有足夠的資源，"}, {"type": "subtitle", "time": 1512.549, "timestamp": "00:25:12", "text": "看看我們能升級多少次。"}, {"type": "subtitle", "time": 1515.19, "timestamp": "00:25:15", "text": "健康值提升，力量值提升。"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "沒有無人機。嗯，衝刺"}, {"type": "subtitle", "time": 1521.19, "timestamp": "00:25:21", "text": "速度雖然不錯，但是會消耗大量"}, {"type": "subtitle", "time": 1523.43, "timestamp": "00:25:23", "text": "體力，就像會迅速消耗你的精力一樣"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "。考驗耐力。射程"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "對於獲取物品並將其推到"}, {"type": "subtitle", "time": 1530.63, "timestamp": "00:25:30", "text": "足夠遠的地方都很有幫助。力量只存在於當下。"}, {"type": "subtitle", "time": 1533.909, "timestamp": "00:25:33", "text": "現在，就現在，你只需要積蓄力量。"}, {"type": "subtitle", "time": 1536.07, "timestamp": "00:25:36", "text": "他獲得了力量砍擊。"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "我也拿一個。是的。並非所有人都知道"}, {"type": "subtitle", "time": 1542.95, "timestamp": "00:25:42", "text": "。每個人都有自己的升級方案。"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "等等，你們都說所有人的"}, {"type": "subtitle", "time": 1547.909, "timestamp": "00:25:47", "text": "身體狀況都很好嗎？我100歲了。呃，頭不是"}, {"type": "subtitle", "time": 1550.75, "timestamp": "00:25:50", "text": "頭。呃，做個"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "故障。你不知道這個故障嗎？是啊，"}, {"type": "subtitle", "time": 1554.11, "timestamp": "00:25:54", "text": "你"}, {"type": "subtitle", "time": 1556.549, "timestamp": "00:25:56", "text": "不能一直玩下去。你的做法"}, {"type": "subtitle", "time": 1558.789, "timestamp": "00:25:58", "text": "就像是在飛船裡拿一個醫療包，"}]
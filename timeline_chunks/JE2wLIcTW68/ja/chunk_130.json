[{"type": "subtitle", "time": 7800.149, "timestamp": "02:10:00", "text": "何て言うんだっけスケジュールから"}, {"type": "subtitle", "time": 7802.39, "timestamp": "02:10:02", "text": "テンプレートをいじってみた"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "VAスケジュールのコードと"}, {"type": "subtitle", "time": 7805.79, "timestamp": "02:10:05", "text": "使用目的"}, {"type": "subtitle", "time": 7810.069, "timestamp": "02:10:10", "text": "自分のスケジュールに合わせて調整する、"}, {"type": "subtitle", "time": 7814.069, "timestamp": "02:10:14", "text": "でも、これはすごくクールだ。のように"}, {"type": "subtitle", "time": 7815.47, "timestamp": "02:10:15", "text": "コラボみたいに"}, {"type": "subtitle", "time": 7828.069, "timestamp": "02:10:28", "text": "サービス。ええ、それは依存しています"}, {"type": "subtitle", "time": 7832.189, "timestamp": "02:10:32", "text": "設計、部品スケジュール、協力パートナー。"}, {"type": "subtitle", "time": 7835.27, "timestamp": "02:10:35", "text": "そう、まさにそこなんです。これらだけ"}, {"type": "subtitle", "time": 7839.51, "timestamp": "02:10:39", "text": "パートナーは、V2 スケジュールを次のように取得できます。"}, {"type": "subtitle", "time": 7842.149, "timestamp": "02:10:42", "text": "はい、通行できます。"}, {"type": "subtitle", "time": 7844.069, "timestamp": "02:10:44", "text": "自動スケジュールからのデザイン"}, {"type": "subtitle", "time": 7847.149, "timestamp": "02:10:47", "text": "これらのクリエイターたち。"}, {"type": "subtitle", "time": 7849.75, "timestamp": "02:10:49", "text": "そう、Vスケジュールは手に入らないよ"}, {"type": "subtitle", "time": 7851.47, "timestamp": "02:10:51", "text": "なぜならそれは"}, {"type": "subtitle", "time": 7854.04, "timestamp": "02:10:54", "text": "は 洗濯可能なもの。"}]
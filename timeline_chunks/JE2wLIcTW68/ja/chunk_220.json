[{"type": "subtitle", "time": 13212.309, "timestamp": "03:40:12", "text": "これで彼女は死なない。それは問題ではありません"}, {"type": "subtitle", "time": 13214.87, "timestamp": "03:40:14", "text": "何回殺されるか。いや、違う。"}, {"type": "subtitle", "time": 13217.83, "timestamp": "03:40:17", "text": "私 私"}, {"type": "subtitle", "time": 13219.91, "timestamp": "03:40:19", "text": "中に入ってください。"}, {"type": "subtitle", "time": 13222.71, "timestamp": "03:40:22", "text": "心配ない。私たちは冥界にいる。"}, {"type": "subtitle", "time": 13242.55, "timestamp": "03:40:42", "text": "何？それが天気です。来て。"}, {"type": "subtitle", "time": 13244.309, "timestamp": "03:40:44", "text": "うん。うん。"}]
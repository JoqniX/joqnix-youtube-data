[{"type": "subtitle", "time": 8644.15, "timestamp": "02:24:04", "text": "仕事。アップロードしなかったの？"}, {"type": "subtitle", "time": 8646.15, "timestamp": "02:24:06", "text": "あなたの動画のサムネイル。えっと、それは"}, {"type": "subtitle", "time": 8648.79, "timestamp": "02:24:08", "text": "サブアトンみたいなことをしているから"}, {"type": "subtitle", "time": 8652.15, "timestamp": "02:24:12", "text": "そういうことですよね？では、その理由をお話ししましょう。 1つ"}, {"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "2番。"}, {"type": "subtitle", "time": 8657.63, "timestamp": "02:24:17", "text": "そこで、私は別のクリエイターを参照しました"}, {"type": "subtitle", "time": 8660.63, "timestamp": "02:24:20", "text": "そして、私は彼らがそれを実行したのを目撃した。だから私は"}, {"type": "subtitle", "time": 8663.349, "timestamp": "02:24:23", "text": "「ああ、私も同じことができる」"}, {"type": "subtitle", "time": 8664.63, "timestamp": "02:24:24", "text": "だって、こう考えなきゃいけないんだもん"}, {"type": "subtitle", "time": 8667.309, "timestamp": "02:24:27", "text": "これです。"}, {"type": "subtitle", "time": 8669.83, "timestamp": "02:24:29", "text": "ボタンですよね？つまり、もしあなたが"}, {"type": "subtitle", "time": 8671.429, "timestamp": "02:24:31", "text": "より大きなクリエイター、そうすれば"}, {"type": "subtitle", "time": 8673.19, "timestamp": "02:24:33", "text": "サムネイルを作成してくれる人、または"}, {"type": "subtitle", "time": 8675.11, "timestamp": "02:24:35", "text": "何かがあって、それから色々なもの。それ"}, {"type": "subtitle", "time": 8676.87, "timestamp": "02:24:36", "text": "たった5分で済むよ、ああ、できるよ"}, {"type": "subtitle", "time": 8681.03, "timestamp": "02:24:41", "text": "もちろん私自身ですが、"}, {"type": "subtitle", "time": 8683.27, "timestamp": "02:24:43", "text": "痛みがひどすぎるように感じた。だから私は"}, {"type": "subtitle", "time": 8685.91, "timestamp": "02:24:45", "text": "こうしようと思ったのですが、"}, {"type": "subtitle", "time": 8689.15, "timestamp": "02:24:49", "text": "私が言及したクリエイターは"}, {"type": "subtitle", "time": 8691.91, "timestamp": "02:24:51", "text": "スロス。彼女はサバトンを演奏した。彼女は"}, {"type": "subtitle", "time": 8697.11, "timestamp": "02:24:57", "text": "えっと、今サバトンをやってるんだけど、もし私が"}]
[{"type": "subtitle", "time": 16862.07, "timestamp": "04:41:02", "text": "ほら、私がこれを選んだようにできた"}, {"type": "subtitle", "time": 16864.23, "timestamp": "04:41:04", "text": "私の城のための特別な場所。のように"}, {"type": "subtitle", "time": 16867.75, "timestamp": "04:41:07", "text": "これ。ここは私の城になるだろう。"}, {"type": "subtitle", "time": 16870.47, "timestamp": "04:41:10", "text": "これは"}, {"type": "subtitle", "time": 16874.628, "timestamp": "04:41:14", "text": "おお。あ、待って。これらは旗です。おお。おお"}, {"type": "subtitle", "time": 16878.47, "timestamp": "04:41:18", "text": "我が神よ。私は落ちている。何？私は見た"}, {"type": "subtitle", "time": 16881.11, "timestamp": "04:41:21", "text": "ファン向けのレッドストーンアニメーションと"}, {"type": "subtitle", "time": 16883.99, "timestamp": "04:41:23", "text": "私のYouTubeチャンネルにあるもの。何らかの理由で、"}, {"type": "subtitle", "time": 16886.67, "timestamp": "04:41:26", "text": "レッドストーンを勧められています"}, {"type": "subtitle", "time": 16889.59, "timestamp": "04:41:29", "text": "もの。そして私は、"}, {"type": "subtitle", "time": 16892.55, "timestamp": "04:41:32", "text": "アニメーション付きの旗とか。"}, {"type": "subtitle", "time": 16895.35, "timestamp": "04:41:35", "text": "それはすごくクールですね。"}, {"type": "subtitle", "time": 16904.55, "timestamp": "04:41:44", "text": "はい。はい。なぜここにゾンビがいるんだ？"}, {"type": "subtitle", "time": 16912.15, "timestamp": "04:41:52", "text": "ここは一体地獄なのか？何？わかった。何？何？"}, {"type": "subtitle", "time": 16914.43, "timestamp": "04:41:54", "text": "何？何？死ぬ。"}]
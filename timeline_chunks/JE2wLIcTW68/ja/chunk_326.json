[{"type": "subtitle", "time": 19561.99, "timestamp": "05:26:01", "text": "言語は違うが、人々は混乱している"}, {"type": "subtitle", "time": 19563.75, "timestamp": "05:26:03", "text": "それ。"}, {"type": "subtitle", "time": 19569.948, "timestamp": "05:26:09", "text": "ビハールは、えーと、"}, {"type": "subtitle", "time": 19574.47, "timestamp": "05:26:14", "text": "ニと何か、そして、えーと、ブリ"}, {"type": "subtitle", "time": 19575.708, "timestamp": "05:26:15", "text": "は"}, {"type": "subtitle", "time": 19584.23, "timestamp": "05:26:24", "text": "違いを覚えている"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "わあ、今日はたくさんのことを学んでいる。"}, {"type": "subtitle", "time": 19594.628, "timestamp": "05:26:34", "text": "おお。"}, {"type": "subtitle", "time": 19596.948, "timestamp": "05:26:36", "text": "ええ、ハラニのことは知っていますが、"}, {"type": "subtitle", "time": 19598.868, "timestamp": "05:26:38", "text": "今すぐ話してください。非常に"}, {"type": "subtitle", "time": 19604.948, "timestamp": "05:26:44", "text": "私にとってはごく自然なことだ。ええ、分かります。"}, {"type": "subtitle", "time": 19608.23, "timestamp": "05:26:48", "text": "知っていることは理解できます。しかし、どのように"}, {"type": "subtitle", "time": 19615.27, "timestamp": "05:26:55", "text": "歌ってみるよ"}, {"type": "subtitle", "time": 19619.19, "timestamp": "05:26:59", "text": "何かが邪魔をしている。私は知っている、私は知っている"}]
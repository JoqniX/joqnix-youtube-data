[{"type": "subtitle", "time": 960.069, "timestamp": "00:16:00", "text": "例えば、これらの物体を見ると"}, {"type": "subtitle", "time": 963.189, "timestamp": "00:16:03", "text": "見て、痛いよ。"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "カートの中の物を見ると、"}, {"type": "subtitle", "time": 967.91, "timestamp": "00:16:07", "text": "黄色い印のようなものが見えるでしょう。だからあなたは"}, {"type": "subtitle", "time": 970.31, "timestamp": "00:16:10", "text": "それは、あなたが知っているように、それは、あなたができる、それは"}, {"type": "subtitle", "time": 974.15, "timestamp": "00:16:14", "text": "売れるもの。わかった。そうそう。わかった。"}, {"type": "subtitle", "time": 977.03, "timestamp": "00:16:17", "text": "ここに皿があります。そして、ちょっと待って"}, {"type": "subtitle", "time": 983.11, "timestamp": "00:16:23", "text": "そしてタブキーを押してください。"}, {"type": "subtitle", "time": 987.43, "timestamp": "00:16:27", "text": "うん。印の上に黄色いものが見えます"}, {"type": "subtitle", "time": 989.509, "timestamp": "00:16:29", "text": "地図。うん。それは、それが問題なんです"}, {"type": "subtitle", "time": 992.71, "timestamp": "00:16:32", "text": "他の人が見た物体。いいえ、"}, {"type": "subtitle", "time": 995.269, "timestamp": "00:16:35", "text": "近くに敵がいる。"}, {"type": "subtitle", "time": 997.91, "timestamp": "00:16:37", "text": "わかった。気をつけて。カードも持ってきてください"}, {"type": "subtitle", "time": 999.189, "timestamp": "00:16:39", "text": "そうすれば、"}, {"type": "subtitle", "time": 1002.069, "timestamp": "00:16:42", "text": "プロセス。ああ、黄色は貴重な、"}, {"type": "subtitle", "time": 1004.47, "timestamp": "00:16:44", "text": "右？"}, {"type": "subtitle", "time": 1007.79, "timestamp": "00:16:47", "text": "黄色のアイテム。はい。おお、"}, {"type": "subtitle", "time": 1011.03, "timestamp": "00:16:51", "text": "アイテム。そうそう。ええ、表示されていますね。"}, {"type": "subtitle", "time": 1012.71, "timestamp": "00:16:52", "text": "わかった。"}, {"type": "subtitle", "time": 1014.949, "timestamp": "00:16:54", "text": "うん。"}, {"type": "subtitle", "time": 1017.189, "timestamp": "00:16:57", "text": "ああ、誰"}]
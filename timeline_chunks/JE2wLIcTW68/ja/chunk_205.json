[{"type": "subtitle", "time": 12302.95, "timestamp": "03:25:02", "text": "それはあなたの助手です。待って。いいえ。"}, {"type": "subtitle", "time": 12305.75, "timestamp": "03:25:05", "text": "それは一つのことだけを行う。クッキーをあげました。今"}, {"type": "subtitle", "time": 12307.349, "timestamp": "03:25:07", "text": "ランダムなクッキーを落とすと、"}, {"type": "subtitle", "time": 12310.03, "timestamp": "03:25:10", "text": "すべて集めて"}, {"type": "subtitle", "time": 12312.99, "timestamp": "03:25:12", "text": "自分。見る？ああ、それは"}, {"type": "subtitle", "time": 12315.91, "timestamp": "03:25:15", "text": "ヘルパー。だから、ダイヤモンドを与えれば、"}, {"type": "subtitle", "time": 12318.55, "timestamp": "03:25:18", "text": "ダイヤモンドを採掘して、私にくれ。いいえ、それは"}, {"type": "subtitle", "time": 12320.469, "timestamp": "03:25:20", "text": "私のものにはしない。物を拾うだけです"}, {"type": "subtitle", "time": 12323.349, "timestamp": "03:25:23", "text": "それは地面にある。では、もし"}, {"type": "subtitle", "time": 12324.79, "timestamp": "03:25:24", "text": "何かを作っていると壊れてしまう"}, {"type": "subtitle", "time": 12327.03, "timestamp": "03:25:27", "text": "何か今、"}, {"type": "subtitle", "time": 12333.95, "timestamp": "03:25:33", "text": "小さな"}, {"type": "subtitle", "time": 12336.9, "timestamp": "03:25:36", "text": "妖精、妖精。"}, {"type": "subtitle", "time": 12338.91, "timestamp": "03:25:38", "text": "[音楽]"}, {"type": "subtitle", "time": 12355.91, "timestamp": "03:25:55", "text": "それはこれからずっと私のそばに留まるでしょう。"}, {"type": "subtitle", "time": 12358.229, "timestamp": "03:25:58", "text": "おお、"}]
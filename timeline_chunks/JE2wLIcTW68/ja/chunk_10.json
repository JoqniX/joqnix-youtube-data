[{"type": "subtitle", "time": 601.35, "timestamp": "00:10:01", "text": "私はその男は盲目だと思うし、もし"}, {"type": "subtitle", "time": 604.15, "timestamp": "00:10:04", "text": "騒ぎを起こそうとすると、彼はあなたを殺す。私"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "考える。よくわからない。"}, {"type": "subtitle", "time": 610.07, "timestamp": "00:10:10", "text": "まあ、本当に？今はまだだめだ。うん。"}, {"type": "subtitle", "time": 612.31, "timestamp": "00:10:12", "text": "ああ、頭を手に入れれば、彼は蘇生できる"}, {"type": "subtitle", "time": 614.15, "timestamp": "00:10:14", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "そう思います。うん。おお。"}, {"type": "subtitle", "time": 620.87, "timestamp": "00:10:20", "text": "それはすごくクールですね。"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "ええ、あれはモンスターの一種でしたね。"}, {"type": "subtitle", "time": 624.069, "timestamp": "00:10:24", "text": "彼はここにいるべきではなかったと思う"}, {"type": "subtitle", "time": 626.71, "timestamp": "00:10:26", "text": "こんなに早く。"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "スポーン地点のことですよね？ああ、ロコが参加したい"}, {"type": "subtitle", "time": 631.75, "timestamp": "00:10:31", "text": "私たち。ロコも参加したがっていた。彼は望むかもしれない"}, {"type": "subtitle", "time": 633.269, "timestamp": "00:10:33", "text": "私たちと一緒に参加しませんか。ええ、もちろん、もちろんです。おお、"}, {"type": "subtitle", "time": 636.71, "timestamp": "00:10:36", "text": "うん。ええ、彼ならできますよ。彼はできる。ええ、そうです"}, {"type": "subtitle", "time": 639.35, "timestamp": "00:10:39", "text": "開ける。サーバーにあるものを見てください。私"}, {"type": "subtitle", "time": 641.269, "timestamp": "00:10:41", "text": "彼はそう思う。うん、うん、うん。彼は"}, {"type": "subtitle", "time": 647.91, "timestamp": "00:10:47", "text": "ロコはホラーゲームが得意だと思う"}, {"type": "subtitle", "time": 651.19, "timestamp": "00:10:51", "text": "今。彼はファズモフォビアの専門家だ。"}, {"type": "subtitle", "time": 656.15, "timestamp": "00:10:56", "text": "はい。はい。はい。もしくは、ソフトリセットを実行することもできます。"}, {"type": "subtitle", "time": 657.91, "timestamp": "00:10:57", "text": "それが男というものだ。あの男は狂っている"}]
[{"type": "subtitle", "time": 8880.23, "timestamp": "02:28:00", "text": "わかった。すべての動画のアップデート"}, {"type": "subtitle", "time": 8883.07, "timestamp": "02:28:03", "text": "ゲームシーン。ああ、いいね。"}, {"type": "subtitle", "time": 8884.91, "timestamp": "02:28:04", "text": "ニース。それは"}, {"type": "subtitle", "time": 8889.87, "timestamp": "02:28:09", "text": "良い。わかった。私は一体何をしていたんだっけ？私"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "忘れた。うん、ビリーをアップロードする必要がある"}, {"type": "subtitle", "time": 8894.469, "timestamp": "02:28:14", "text": "ビリー、今だ。"}, {"type": "subtitle", "time": 8897.429, "timestamp": "02:28:17", "text": "YouTube はこれらのストリームを配信しているので"}, {"type": "subtitle", "time": 8899.99, "timestamp": "02:28:19", "text": "ビリーにとって2時間12時間です。"}, {"type": "subtitle", "time": 8903.429, "timestamp": "02:28:23", "text": "動画の制限時間は10時間で、"}, {"type": "subtitle", "time": 8905.75, "timestamp": "02:28:25", "text": "ファイル制限は"}, {"type": "subtitle", "time": 8909.349, "timestamp": "02:28:29", "text": "アップロードできるファイルの制限は16GBです。"}, {"type": "subtitle", "time": 8912.15, "timestamp": "02:28:32", "text": "レベルアップシステムが異なる"}, {"type": "subtitle", "time": 8915.51, "timestamp": "02:28:35", "text": "YouTubeでは32GBものデータをアップロードできます"}, {"type": "subtitle", "time": 8918.55, "timestamp": "02:28:38", "text": "ビデオ映像など、4K映像"}, {"type": "subtitle", "time": 8921.03, "timestamp": "02:28:41", "text": "それで、ビリービリーは"}, {"type": "subtitle", "time": 8923.03, "timestamp": "02:28:43", "text": "千個くらい必要だ"}, {"type": "subtitle", "time": 8927.11, "timestamp": "02:28:47", "text": "000 サブスクライバー フォロー ファン ファン OK フォロワー"}, {"type": "subtitle", "time": 8930.95, "timestamp": "02:28:50", "text": "追加要素をアンロックするには100万ドルか何か"}, {"type": "subtitle", "time": 8932.11, "timestamp": "02:28:52", "text": "物と"}, {"type": "subtitle", "time": 8934.95, "timestamp": "02:28:54", "text": "追加コンテンツは全てアップロードされていません"}, {"type": "subtitle", "time": 8938.309, "timestamp": "02:28:58", "text": "そして、スケジューリングも同様に、スケジューリングは"}]
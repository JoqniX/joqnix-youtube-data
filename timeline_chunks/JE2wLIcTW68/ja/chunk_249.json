[{"type": "subtitle", "time": 14943.349, "timestamp": "04:09:03", "text": "モニターのことが心配です。それは"}, {"type": "subtitle", "time": 14946.469, "timestamp": "04:09:06", "text": "このモニターはしばらく黒い画面になります"}, {"type": "subtitle", "time": 14964.309, "timestamp": "04:09:24", "text": "だから、やってみろ。冷めるには時間がかかるだろう"}, {"type": "subtitle", "time": 14970.79, "timestamp": "04:09:30", "text": "右。明日やるべきだ。いいえ、いいえ、"}, {"type": "subtitle", "time": 14973.51, "timestamp": "04:09:33", "text": "いいえ。寝る前に。うん。いいえ、でも私はそう思います。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "そうそう。あのね？私はそれをやります"}, {"type": "subtitle", "time": 14975.95, "timestamp": "04:09:35", "text": "の"}, {"type": "subtitle", "time": 14984.71, "timestamp": "04:09:44", "text": "ボードを置くのではなく。わかった。"}, {"type": "subtitle", "time": 14987.87, "timestamp": "04:09:47", "text": "それでは、"}, {"type": "subtitle", "time": 14992.91, "timestamp": "04:09:52", "text": "ゲーム。音声はどうですか？お知らせ下さい。"}, {"type": "subtitle", "time": 14999.71, "timestamp": "04:09:59", "text": "ああ、"}]
[{"type": "subtitle", "time": 15362.79, "timestamp": "04:16:02", "text": "私も意見を述べさせてください。したい"}, {"type": "subtitle", "time": 15365.269, "timestamp": "04:16:05", "text": "問題点を把握する。実際"}, {"type": "subtitle", "time": 15369.55, "timestamp": "04:16:09", "text": "OBS？私はOBSを1年間運用しています"}, {"type": "subtitle", "time": 15373.87, "timestamp": "04:16:13", "text": "170時間2分と"}, {"type": "subtitle", "time": 15381.47, "timestamp": "04:16:21", "text": "おお。わかった。これは入力ではありません。入力は"}, {"type": "subtitle", "time": 15397.11, "timestamp": "04:16:37", "text": "え？はい。はい。はい。こんにちは。所有。えっと、"}, {"type": "subtitle", "time": 15400.71, "timestamp": "04:16:40", "text": "ゲーム内で少しお話できますか？"}, {"type": "subtitle", "time": 15405.189, "timestamp": "04:16:45", "text": "私は、あなたがたがテストしなければならなかったもののうちの1つをテストしたい"}, {"type": "subtitle", "time": 15411.189, "timestamp": "04:16:51", "text": "ゲーム内ゲーム内。あ、待って、"}, {"type": "subtitle", "time": 15413.91, "timestamp": "04:16:53", "text": "待って、待って。 1秒。ええ、ゲームの中でね。私"}, {"type": "subtitle", "time": 15417.269, "timestamp": "04:16:57", "text": "ゲーム中です。ああ、神様。教えて、彼女は"}, {"type": "subtitle", "time": 15419.59, "timestamp": "04:16:59", "text": "声は「待って、自分で聞かせて」という感じだった。"}]
[{"type": "subtitle", "time": 18003.75, "timestamp": "05:00:03", "text": "ああ、圧縮だ。わかった。あぁあぁあ"}, {"type": "subtitle", "time": 18008.27, "timestamp": "05:00:08", "text": "構成は、あなたに伝えることができます"}, {"type": "subtitle", "time": 18011.35, "timestamp": "05:00:11", "text": "それは何て言うんだっけ？表記法。"}, {"type": "subtitle", "time": 18013.27, "timestamp": "05:00:13", "text": "あなたが何を歌っているにせよ、それは"}, {"type": "subtitle", "time": 18016.868, "timestamp": "05:00:16", "text": "その表記法を検出する。ああ、FLをやったんだね"}, {"type": "subtitle", "time": 18018.19, "timestamp": "05:00:18", "text": "現在スタジオにて。それで、"}, {"type": "subtitle", "time": 18021.43, "timestamp": "05:00:21", "text": "エジソンとニュートンだったかな、確か"}, {"type": "subtitle", "time": 18023.59, "timestamp": "05:00:23", "text": "プラグイン。ああ、"}, {"type": "subtitle", "time": 18029.43, "timestamp": "05:00:29", "text": "そう思います。ああ、Eスタジオが恋しい。"}, {"type": "subtitle", "time": 18031.67, "timestamp": "05:00:31", "text": "面白いことに、私は"}, {"type": "subtitle", "time": 18034.628, "timestamp": "05:00:34", "text": "E Studio の究極版と I"}, {"type": "subtitle", "time": 18038.47, "timestamp": "05:00:38", "text": "他に方法がなかったので、Abletonを選びました"}, {"type": "subtitle", "time": 18041.35, "timestamp": "05:00:41", "text": "音楽制作コースのようなライブ配信。それで"}, {"type": "subtitle", "time": 18044.47, "timestamp": "05:00:44", "text": "スタジオのために完全に料理をしなければならなかったし"}, {"type": "subtitle", "time": 18047.99, "timestamp": "05:00:47", "text": "Ableton Liveを購入する。"}, {"type": "subtitle", "time": 18051.27, "timestamp": "05:00:51", "text": "おお。私たちは以前はクラックを使っていました"}, {"type": "subtitle", "time": 18055.03, "timestamp": "05:00:55", "text": "バージョン。同じ。私も。"}, {"type": "subtitle", "time": 18057.35, "timestamp": "05:00:57", "text": "私はまだFL Studioのクラック版を持っています。"}]
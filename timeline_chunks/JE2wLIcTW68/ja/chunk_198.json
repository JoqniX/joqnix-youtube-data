[{"type": "subtitle", "time": 11881.269, "timestamp": "03:18:01", "text": "ああ、安全ですよ。ついに。さあ行こう。"}, {"type": "subtitle", "time": 11883.75, "timestamp": "03:18:03", "text": "至る所に水がある。待ちます。"}, {"type": "subtitle", "time": 11886.309, "timestamp": "03:18:06", "text": "私が直します。待って。"}, {"type": "subtitle", "time": 11895.429, "timestamp": "03:18:15", "text": "ズキのライブラリみたいなものを作り直しました。"}, {"type": "subtitle", "time": 11903.469, "timestamp": "03:18:23", "text": "[音楽]"}, {"type": "subtitle", "time": 11905.55, "timestamp": "03:18:25", "text": "くそ。 1つ"}, {"type": "subtitle", "time": 11908.469, "timestamp": "03:18:28", "text": "2番。ええ、新しいモデルがあります"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "作品全体。ええ、でも問題は、私には"}, {"type": "subtitle", "time": 11914.59, "timestamp": "03:18:34", "text": "資金を調達するために、私は支払わなければならない"}, {"type": "subtitle", "time": 11918.309, "timestamp": "03:18:38", "text": "美術。いいえ、作品は完成しました。私はただ"}, {"type": "subtitle", "time": 11920.15, "timestamp": "03:18:40", "text": "修正とアートの費用を支払う"}, {"type": "subtitle", "time": 11925.429, "timestamp": "03:18:45", "text": "あれこれと、ええと、リギングは高価です。いいえ、"}, {"type": "subtitle", "time": 11927.83, "timestamp": "03:18:47", "text": "この場所はどうですか？"}, {"type": "subtitle", "time": 11930.79, "timestamp": "03:18:50", "text": "ええ、デビューできたらいいなと思っています。の"}, {"type": "subtitle", "time": 11933.229, "timestamp": "03:18:53", "text": "新モデル。とても綺麗ですね。"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "D. とても綺麗ですね。とても綺麗です。"}]
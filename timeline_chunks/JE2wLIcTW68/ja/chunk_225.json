[{"type": "subtitle", "time": 13511.07, "timestamp": "03:45:11", "text": "待って、これは"}, {"type": "subtitle", "time": 13516.15, "timestamp": "03:45:16", "text": "私は、それにはニンジンが必要だと思った。"}, {"type": "subtitle", "time": 13524.83, "timestamp": "03:45:24", "text": "それ以外の場合または"}, {"type": "subtitle", "time": 13527.15, "timestamp": "03:45:27", "text": "何か。何か"}, {"type": "subtitle", "time": 13530.389, "timestamp": "03:45:30", "text": "緑。キノコの一種。"}, {"type": "subtitle", "time": 13545.429, "timestamp": "03:45:45", "text": "私の記憶が正しければ、それはニンジンだったと思う。"}, {"type": "subtitle", "time": 13548.349, "timestamp": "03:45:48", "text": "待って、ちょっと待って"}, {"type": "subtitle", "time": 13550.95, "timestamp": "03:45:50", "text": "これ。君に投げるよ。あ、待って。"}]
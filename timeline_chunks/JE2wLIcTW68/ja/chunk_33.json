[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "できる限り。いや、いや、いや、いや。さあ"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "いや、いや、いや。できるだけ多く手に入れよう"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "第1四半期に缶詰。では、2番目"}, {"type": "subtitle", "time": 1991.269, "timestamp": "00:33:11", "text": "片方の方が簡単だろう。わかった。無視してください"}, {"type": "subtitle", "time": 1997.19, "timestamp": "00:33:17", "text": "それは無作為に人々を標的にする。それは"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "今私をフォローしているか、それとも[ __ ]しているか見ています"}, {"type": "subtitle", "time": 2002.47, "timestamp": "00:33:22", "text": "爆弾のためだよ、兄弟。"}, {"type": "subtitle", "time": 2003.99, "timestamp": "00:33:23", "text": "カートから離してください、さもないと私は"}, {"type": "subtitle", "time": 2018.31, "timestamp": "00:33:38", "text": "いや、いや、いや。君はそれを保持しなければならない"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "秘密。少なくともそれを保持する必要がある"}, {"type": "subtitle", "time": 2021.149, "timestamp": "00:33:41", "text": "のように"}, {"type": "subtitle", "time": 2023.59, "timestamp": "00:33:43", "text": "興味深いのは、「うん、それは"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "殺すぞ、おい。」誰も殺さないだろう"}, {"type": "subtitle", "time": 2027.07, "timestamp": "00:33:47", "text": "探し出す。"}, {"type": "subtitle", "time": 2029.23, "timestamp": "00:33:49", "text": "うん、"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "恐ろしいものがふざけて見つけるああ私の"}, {"type": "subtitle", "time": 2035.43, "timestamp": "00:33:55", "text": "神。"}]
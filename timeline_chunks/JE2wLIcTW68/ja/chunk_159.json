[{"type": "subtitle", "time": 9544.59, "timestamp": "02:39:04", "text": "久しぶりにApexをプレイ"}, {"type": "subtitle", "time": 9548.59, "timestamp": "02:39:08", "text": "長い年月が経つにつれて"}, {"type": "subtitle", "time": 9555.07, "timestamp": "02:39:15", "text": "時間。ピューピューと剥がすのは楽しかったし、"}, {"type": "subtitle", "time": 9560.27, "timestamp": "02:39:20", "text": "でも私は"}, {"type": "subtitle", "time": 9563.15, "timestamp": "02:39:23", "text": "最高で"}, {"type": "subtitle", "time": 9567.71, "timestamp": "02:39:27", "text": "ええと、私たちはある意味"}, {"type": "subtitle", "time": 9570.91, "timestamp": "02:39:30", "text": "すべて視聴中"}, {"type": "subtitle", "time": 9575.389, "timestamp": "02:39:35", "text": "ほとんどの日のほとんどの"}, {"type": "subtitle", "time": 9580.429, "timestamp": "02:39:40", "text": "遅くまで寝ていた日にテストしました"}, {"type": "subtitle", "time": 9582.75, "timestamp": "02:39:42", "text": "そこにいて、私は"}, {"type": "subtitle", "time": 9593.309, "timestamp": "02:39:53", "text": "クラス。その後、私たちは"}]
[{"type": "subtitle", "time": 18368.788, "timestamp": "05:06:08", "text": "なぜいつも暴力的な手段を使うのか？"}, {"type": "subtitle", "time": 18381.75, "timestamp": "05:06:21", "text": "うん、"}, {"type": "subtitle", "time": 18404.07, "timestamp": "05:06:44", "text": "そうそう。何てことだ。何てことだ。私は"}, {"type": "subtitle", "time": 18405.75, "timestamp": "05:06:45", "text": "死にかけている。私は死にかけている。私は死にかけている。私は死にかけている。"}, {"type": "subtitle", "time": 18409.23, "timestamp": "05:06:49", "text": "どこにいるの？どこにいるの？死ぬな"}, {"type": "subtitle", "time": 18411.91, "timestamp": "05:06:51", "text": "それから。そうだろ、ジョック？彼女は死ぬべきではない、"}, {"type": "subtitle", "time": 18414.55, "timestamp": "05:06:54", "text": "右？うん。"}, {"type": "subtitle", "time": 18417.11, "timestamp": "05:06:57", "text": "ほら、ジョックの言うことを聞いてみて。"}]
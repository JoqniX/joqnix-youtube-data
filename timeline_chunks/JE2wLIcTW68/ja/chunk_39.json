[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "つまり、私は彼女を守る。"}, {"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "まっすぐ進んで見てみよう"}, {"type": "subtitle", "time": 2348.31, "timestamp": "00:39:08", "text": "の上。ああ、2つ目はそれを超える"}, {"type": "subtitle", "time": 2351.51, "timestamp": "00:39:11", "text": "ドア。誰かあれを引っ張って。これは何ですか？"}, {"type": "subtitle", "time": 2355.19, "timestamp": "00:39:15", "text": "ああ、そうそう、2つ目もあるね。だから"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "抽出は次のように増加します"}, {"type": "subtitle", "time": 2361.109, "timestamp": "00:39:21", "text": "この後にはまた2つあります"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "そしてその後は3つ"}, {"type": "subtitle", "time": 2365.109, "timestamp": "00:39:25", "text": "そして、それはどんどん上がっていく"}, {"type": "subtitle", "time": 2376.15, "timestamp": "00:39:36", "text": "ああ、もう一つ。ニース。さあ行こう。は"}, {"type": "subtitle", "time": 2378.87, "timestamp": "00:39:38", "text": "ここには何も入っていないの？ああ、忘れないで"}, {"type": "subtitle", "time": 2380.47, "timestamp": "00:39:40", "text": "これらの棚を開けるんですよね？うん。"}, {"type": "subtitle", "time": 2382.95, "timestamp": "00:39:42", "text": "殻を開けるのを忘れないでください。うん。"}, {"type": "subtitle", "time": 2385.03, "timestamp": "00:39:45", "text": "わかった。うん。開けるのを忘れないでください"}, {"type": "subtitle", "time": 2387.829, "timestamp": "00:39:47", "text": "sh。"}, {"type": "subtitle", "time": 2389.47, "timestamp": "00:39:49", "text": "もちろん、"}, {"type": "subtitle", "time": 2391.19, "timestamp": "00:39:51", "text": "兄弟。あなたは何をしようとしていましたか"}, {"type": "subtitle", "time": 2393.349, "timestamp": "00:39:53", "text": "何かあったのかい？"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "私は鉄の釘を打って"}]
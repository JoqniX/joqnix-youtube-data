[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "プレイする準備はできています"}, {"type": "subtitle", "time": 242.47, "timestamp": "00:04:02", "text": "正直に言って、私が見つけられる人なら誰でも。ああ、わかりました。"}, {"type": "subtitle", "time": 244.39, "timestamp": "00:04:04", "text": "わかった。"}, {"type": "subtitle", "time": 247.19, "timestamp": "00:04:07", "text": "このゲームにすごくハマってるんだ、だって私は"}, {"type": "subtitle", "time": 249.71, "timestamp": "00:04:09", "text": "麻薬栽培がこんなに大変だとは思いもしなかった"}, {"type": "subtitle", "time": 253.429, "timestamp": "00:04:13", "text": "楽しい。冗談だよ。えっと、"}, {"type": "subtitle", "time": 255.35, "timestamp": "00:04:15", "text": "現実世界ではどうすればいいですか？正直に、"}, {"type": "subtitle", "time": 258.069, "timestamp": "00:04:18", "text": "そのゲームで麻薬を栽培するってどういうこと？何？"}, {"type": "subtitle", "time": 260.55, "timestamp": "00:04:20", "text": "あれは恐ろしいと思った。つまり、あなたは"}, {"type": "subtitle", "time": 263.99, "timestamp": "00:04:23", "text": "これは麻薬ディーラーゲームのジョークです。うん。おお"}, {"type": "subtitle", "time": 266.469, "timestamp": "00:04:26", "text": "我が神よ。わかった。 Who's Who が主催しています。"}, {"type": "subtitle", "time": 269.749, "timestamp": "00:04:29", "text": "道？あの、私が司会をしましょうか？"}, {"type": "subtitle", "time": 271.83, "timestamp": "00:04:31", "text": "コラボ企画ですよね？これはコラボレーション作品です。あなた"}, {"type": "subtitle", "time": 274.469, "timestamp": "00:04:34", "text": "ホストするべきである。私は最高の友達"}, {"type": "subtitle", "time": 278.55, "timestamp": "00:04:38", "text": "コンピュータとインターネットがホストする必要があります。わかった。"}, {"type": "subtitle", "time": 282.87, "timestamp": "00:04:42", "text": "何か問題があれば、お知らせします。"}, {"type": "chat", "time": 284.859, "timestamp": "00:04:44", "author": "@SuperheroKaYT", "avatar": "https://yt4.ggpht.com/PAYjDFB-1cymIsBSOu3Yh8g0gs-I3ddxXl_qSfTkZyuRxDz1owul2E1GB3eq-R7XyhdQW8RY-aU=s64-c-k-c0x00ffffff-no-rj", "message": "hello hello ♥"}, {"type": "subtitle", "time": 287.27, "timestamp": "00:04:47", "text": "うん。わかった。さよなら。大丈夫だよ。私にさせて"}, {"type": "subtitle", "time": 291.51, "timestamp": "00:04:51", "text": "スイッチ。ちょっと待ってください。"}, {"type": "subtitle", "time": 293.67, "timestamp": "00:04:53", "text": "これは本当に美しい音色です。"}, {"type": "subtitle", "time": 297.51, "timestamp": "00:04:57", "text": "何てことだ。どういう意味ですか？"}, {"type": "subtitle", "time": 299.67, "timestamp": "00:04:59", "text": "あ、そういえば、チャットで伝えるのを忘れてた。"}]
[{"type": "subtitle", "time": 3901.15, "timestamp": "01:05:01", "text": "あなたが正しい。わかった。私たちは救うことができない"}, {"type": "subtitle", "time": 3904.39, "timestamp": "01:05:04", "text": "彼ら。ジョー。いいえ。彼らを救うことはできません。走る"}, {"type": "subtitle", "time": 3906.789, "timestamp": "01:05:06", "text": "戻る。引き返してください。いや、いや。受け取って。取る"}, {"type": "subtitle", "time": 3908.71, "timestamp": "01:05:08", "text": "それ。私たちと一緒に持って行ってください。彼らは大丈夫ではない、"}, {"type": "subtitle", "time": 3911.829, "timestamp": "01:05:11", "text": "大丈夫。ジョック。ジョック。えっと、みんな、保存できます"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "私たち。あなたは私たちの頭を取ることができます"}, {"type": "subtitle", "time": 3917.19, "timestamp": "01:05:17", "text": "トラックの上で。ちくしょう。"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "おお。なんてこった。いや、いや、いや。言ったでしょ。"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "そういったものを通して、私たちを追跡する。犬よ、覚えておいて"}]
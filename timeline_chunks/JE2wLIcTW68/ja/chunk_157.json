[{"type": "subtitle", "time": 9434.389, "timestamp": "02:37:14", "text": "これ。ジョッキーはそうしないと言うだろう"}, {"type": "subtitle", "time": 9436.389, "timestamp": "02:37:16", "text": "これをストリームで表示し、"}, {"type": "subtitle", "time": 9438.07, "timestamp": "02:37:18", "text": "すべて。"}, {"type": "subtitle", "time": 9440.349, "timestamp": "02:37:20", "text": "これは"}, {"type": "subtitle", "time": 9442.87, "timestamp": "02:37:22", "text": "あなたがプロ意識を持っている"}, {"type": "subtitle", "time": 9445.83, "timestamp": "02:37:25", "text": "右。でも私はインディーズだし、"}, {"type": "subtitle", "time": 9447.63, "timestamp": "02:37:27", "text": "好きなようにする"}, {"type": "subtitle", "time": 9450.75, "timestamp": "02:37:30", "text": "ランク、そして私は"}, {"type": "subtitle", "time": 9454.27, "timestamp": "02:37:34", "text": "専門職の地位にある企業系の"}, {"type": "subtitle", "time": 9458.23, "timestamp": "02:37:38", "text": "ロシアのインディーズレベルは悪くて、私もそれが悪いと分かっています。"}, {"type": "subtitle", "time": 9461.27, "timestamp": "02:37:41", "text": "心配しないで、"}, {"type": "subtitle", "time": 9462.91, "timestamp": "02:37:42", "text": "新モデルと"}]
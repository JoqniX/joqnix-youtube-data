[{"type": "subtitle", "time": 2100.39, "timestamp": "00:35:00", "text": "あの王室の乗組員には加わらない方がいい。何"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "Ktoを復活させるにはどうすればいいですか？と入力するとどうなりますか？"}, {"type": "subtitle", "time": 2108.63, "timestamp": "00:35:08", "text": "我々はできる。四半期が終わると、"}, {"type": "subtitle", "time": 2110.39, "timestamp": "00:35:10", "text": "その時、蘇生されます"}, {"type": "subtitle", "time": 2113.109, "timestamp": "00:35:13", "text": "彼の頭は割り当てか"}, {"type": "subtitle", "time": 2116.47, "timestamp": "00:35:16", "text": "船だと思う。だから、彼を"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "船。彼は大丈夫だろう。それとも、"}, {"type": "subtitle", "time": 2121.829, "timestamp": "00:35:21", "text": "彼をここに触れてください。ああ、神様。ニース"}, {"type": "subtitle", "time": 2123.91, "timestamp": "00:35:23", "text": "1つ。"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "よし、それでいい。あの男はまだああ"}, {"type": "subtitle", "time": 2127.31, "timestamp": "00:35:27", "text": "私の"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "私は[ __ ]と呼ばれるものを見た"}]
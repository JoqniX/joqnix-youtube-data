[{"type": "subtitle", "time": 10321.19, "timestamp": "02:52:01", "text": "家？何てことだ。来る。あなたは見ていない"}, {"type": "subtitle", "time": 10322.87, "timestamp": "02:52:02", "text": "今は私の家です。さあ、さあ。これは私の"}, {"type": "subtitle", "time": 10325.99, "timestamp": "02:52:05", "text": "お城ですよね？これは新しい。誰も見ていなかった"}, {"type": "subtitle", "time": 10328.07, "timestamp": "02:52:08", "text": "これについて。ここに来て。あなたは見ていない"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "私の拠点？いいえ。基地をお持ちですか？"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "私が何を持っていると思いますか？ここに来て。"}, {"type": "subtitle", "time": 10338.83, "timestamp": "02:52:18", "text": "ここに来て。わかった。何"}, {"type": "subtitle", "time": 10341.389, "timestamp": "02:52:21", "text": "の"}, {"type": "subtitle", "time": 10345.389, "timestamp": "02:52:25", "text": "それは何ですか？神社"}, {"type": "subtitle", "time": 10347.469, "timestamp": "02:52:27", "text": "それは"}, {"type": "subtitle", "time": 10354.389, "timestamp": "02:52:34", "text": "まばたき。何てことだ。"}, {"type": "subtitle", "time": 10357.15, "timestamp": "02:52:37", "text": "そして、私たちはこれを作ったのは"}, {"type": "subtitle", "time": 10360.71, "timestamp": "02:52:40", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "ああ、小さな鍵ですね。一体どういうことだ？"}, {"type": "subtitle", "time": 10368.79, "timestamp": "02:52:48", "text": "あなたも作ってみてください。この地域。"}, {"type": "subtitle", "time": 10371.51, "timestamp": "02:52:51", "text": "これは何ですか？"}, {"type": "subtitle", "time": 10375.309, "timestamp": "02:52:55", "text": "ここは私の拠点です。そこが私の部屋です。それは"}]
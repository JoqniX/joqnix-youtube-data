[{"type": "subtitle", "time": 17464.75, "timestamp": "04:51:04", "text": "あらら。私は気にしない"}, {"type": "subtitle", "time": 17468.55, "timestamp": "04:51:08", "text": "それ。ほら、そこにゾンビが一体見えるよ。"}, {"type": "subtitle", "time": 17473.15, "timestamp": "04:51:13", "text": "ゾンビがいる。私にはそれが見えます。ああ、"}, {"type": "subtitle", "time": 17477.27, "timestamp": "04:51:17", "text": "神。おお。そうそう。うん。"}, {"type": "subtitle", "time": 17499.03, "timestamp": "04:51:39", "text": "人生？現実世界ってどんなものだろう。現実世界では、"}, {"type": "subtitle", "time": 17501.03, "timestamp": "04:51:41", "text": "そんなにたくさんのライトを付ける必要があるの？"}, {"type": "chat", "time": 17506.779, "timestamp": "04:51:46", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "yes"}, {"type": "subtitle", "time": 17507.12, "timestamp": "04:51:47", "text": "私は思う"}, {"type": "subtitle", "time": 17508.75, "timestamp": "04:51:48", "text": "[音楽]"}, {"type": "subtitle", "time": 17511.59, "timestamp": "04:51:51", "text": "それで。現実世界と同じように、"}]
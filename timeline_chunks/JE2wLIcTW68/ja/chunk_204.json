[{"type": "subtitle", "time": 12242.07, "timestamp": "03:24:02", "text": "うん。何？バニラとは何ですか？"}, {"type": "subtitle", "time": 12244.63, "timestamp": "03:24:04", "text": "基本的にはバニラですね。バニラ。基本的に"}, {"type": "subtitle", "time": 12247.99, "timestamp": "03:24:07", "text": "改造されていないゲームバージョン。オリジナル"}, {"type": "subtitle", "time": 12250.55, "timestamp": "03:24:10", "text": "1つ。"}, {"type": "subtitle", "time": 12253.19, "timestamp": "03:24:13", "text": "基本的に、これらは"}, {"type": "subtitle", "time": 12255.03, "timestamp": "03:24:15", "text": "Minecraftのアップデートで、しかし彼らは"}, {"type": "subtitle", "time": 12257.67, "timestamp": "03:24:17", "text": "それらを披露する機会を得る。まるで彼らが"}, {"type": "subtitle", "time": 12259.349, "timestamp": "03:24:19", "text": "マインクラフトで投票が行われたんだけど"}, {"type": "subtitle", "time": 12262.229, "timestamp": "03:24:22", "text": "アップデートのたびに何か表示される。そうそう。これら"}, {"type": "subtitle", "time": 12265.269, "timestamp": "03:24:25", "text": "ええ、これらは除外されていました。だから私は"}, {"type": "subtitle", "time": 12267.51, "timestamp": "03:24:27", "text": "MODを使って追加しました。どうやらそれは"}, {"type": "subtitle", "time": 12269.67, "timestamp": "03:24:29", "text": "そうであるべきだと思うが、それがそうかどうかはわからない"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "か否か、"}, {"type": "subtitle", "time": 12275.349, "timestamp": "03:24:35", "text": "ええ、これは公式のMinecraft MODです。"}, {"type": "subtitle", "time": 12277.11, "timestamp": "03:24:37", "text": "じゃあ、路地はどうなの？"}, {"type": "subtitle", "time": 12278.309, "timestamp": "03:24:38", "text": "もの？"}, {"type": "subtitle", "time": 12280.71, "timestamp": "03:24:40", "text": "アリはバニラ味だ。"}, {"type": "subtitle", "time": 12282.79, "timestamp": "03:24:42", "text": "このバージョンには含まれていません。"}, {"type": "subtitle", "time": 12288.15, "timestamp": "03:24:48", "text": "いいえ、そうです。そうです。そうです。アリはWowにいる。"}, {"type": "subtitle", "time": 12290.66, "timestamp": "03:24:50", "text": "うん。見る、"}, {"type": "subtitle", "time": 12291.83, "timestamp": "03:24:51", "text": "[音楽]"}, {"type": "subtitle", "time": 12294.59, "timestamp": "03:24:54", "text": "見て。大丈夫。"}, {"type": "subtitle", "time": 12298.79, "timestamp": "03:24:58", "text": "離れて。それは何ですか？"}]
[{"type": "subtitle", "time": 18601.75, "timestamp": "05:10:01", "text": "今すぐお前を殺す。あなたはもういない。あなたは"}, {"type": "subtitle", "time": 18604.868, "timestamp": "05:10:04", "text": "去った。待って、どうすればいいか考えてみるから"}, {"type": "subtitle", "time": 18611.03, "timestamp": "05:10:11", "text": "出てくる。はい、ジャンプしてWを押します。Wを押し続けます。"}, {"type": "subtitle", "time": 18615.51, "timestamp": "05:10:15", "text": "ああ、ここにもう一つエメラルドが見える。おお、"}, {"type": "subtitle", "time": 18619.35, "timestamp": "05:10:19", "text": "わかった。ネットはこちら。"}, {"type": "subtitle", "time": 18622.628, "timestamp": "05:10:22", "text": "何？これは何ですか？"}, {"type": "subtitle", "time": 18625.39, "timestamp": "05:10:25", "text": "これ。なぜここに雲があるのですか？"}, {"type": "subtitle", "time": 18634.55, "timestamp": "05:10:34", "text": "ビデオ。"}, {"type": "subtitle", "time": 18637.51, "timestamp": "05:10:37", "text": "まあ、座って空振りすることもできるよ。"}, {"type": "subtitle", "time": 18639.75, "timestamp": "05:10:39", "text": "まるで水の中に座っているかのように"}, {"type": "subtitle", "time": 18642.31, "timestamp": "05:10:42", "text": "ジャグジー。"}, {"type": "subtitle", "time": 18650.15, "timestamp": "05:10:50", "text": "でも、それもまた良いことだ。"}, {"type": "subtitle", "time": 18656.63, "timestamp": "05:10:56", "text": "では、私たちは彼に何を教えるべきでしょうか？"}, {"type": "subtitle", "time": 18659.43, "timestamp": "05:10:59", "text": "[音楽]"}]
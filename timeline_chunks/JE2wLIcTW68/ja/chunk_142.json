[{"type": "subtitle", "time": 8521.99, "timestamp": "02:22:01", "text": "作業中のものをストリーミング配信する"}, {"type": "subtitle", "time": 8524.23, "timestamp": "02:22:04", "text": "生放送のテレビの企画と、"}, {"type": "subtitle", "time": 8526.79, "timestamp": "02:22:06", "text": "あなたがストリーミング配信しているのを見ていると、"}, {"type": "subtitle", "time": 8529.27, "timestamp": "02:22:09", "text": "経験豊富な生放送テレビの人々は"}, {"type": "subtitle", "time": 8532.389, "timestamp": "02:22:12", "text": "あなたを導き、どのように教えるか"}, {"type": "subtitle", "time": 8534.83, "timestamp": "02:22:14", "text": "もっと良くして"}, {"type": "subtitle", "time": 8537.95, "timestamp": "02:22:17", "text": "すべてが"}, {"type": "subtitle", "time": 8545.389, "timestamp": "02:22:25", "text": "いいよ、それはちょっと"}, {"type": "subtitle", "time": 8547.89, "timestamp": "02:22:27", "text": "良い。私は持っている"}, {"type": "subtitle", "time": 8550.91, "timestamp": "02:22:30", "text": "[音楽]"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "良い。ええ、そうですね。もしあなたが"}, {"type": "subtitle", "time": 8564.429, "timestamp": "02:22:44", "text": "自分のモデルとか色々、頑張ってね"}, {"type": "subtitle", "time": 8567.87, "timestamp": "02:22:47", "text": "それ。あなたに"}, {"type": "subtitle", "time": 8571.03, "timestamp": "02:22:51", "text": "最高。うん。"}, {"type": "subtitle", "time": 8573.51, "timestamp": "02:22:53", "text": "そして、あなたがプラスポイントであるならば、"}, {"type": "subtitle", "time": 8577.11, "timestamp": "02:22:57", "text": "あなた自身のアーティストとリガーは、"}, {"type": "subtitle", "time": 8579.429, "timestamp": "02:22:59", "text": "新しいものをどんどん追加できます"}]
[{"type": "subtitle", "time": 17400.43, "timestamp": "04:50:00", "text": "で"}, {"type": "subtitle", "time": 17402.91, "timestamp": "04:50:02", "text": "VC。わかった。いいえ、私は"}, {"type": "subtitle", "time": 17407.19, "timestamp": "04:50:07", "text": "つまり、私には見えなかったということです。"}, {"type": "subtitle", "time": 17410.55, "timestamp": "04:50:10", "text": "うん、受け取って。何か持って行って。私は置きます"}, {"type": "subtitle", "time": 17412.83, "timestamp": "04:50:12", "text": "の"}, {"type": "subtitle", "time": 17419.39, "timestamp": "04:50:19", "text": "物と光。提灯を置きましょう。"}, {"type": "subtitle", "time": 17422.868, "timestamp": "04:50:22", "text": "ランタン。魂の灯籠。いいえ、普通です"}, {"type": "subtitle", "time": 17429.43, "timestamp": "04:50:29", "text": "なぜここにあるのか？なぜなら私たちは"}, {"type": "subtitle", "time": 17431.99, "timestamp": "04:50:31", "text": "浮島が今、上空に浮かんでいる。"}]
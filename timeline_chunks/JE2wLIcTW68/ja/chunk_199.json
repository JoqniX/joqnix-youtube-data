[{"type": "subtitle", "time": 11953.429, "timestamp": "03:19:13", "text": "はい。ええ、そうです。はい。はい。このベビーシッター。"}, {"type": "subtitle", "time": 11955.07, "timestamp": "03:19:15", "text": "これ"}, {"type": "subtitle", "time": 11963.429, "timestamp": "03:19:23", "text": "そうそう。そうそう。私たちは連れて行くことができませんでした"}, {"type": "subtitle", "time": 11966.229, "timestamp": "03:19:26", "text": "の"}, {"type": "subtitle", "time": 11968.389, "timestamp": "03:19:28", "text": "その通り。"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "何てことだ。 DMでリマインダーを送りたいのですが"}, {"type": "subtitle", "time": 11977.349, "timestamp": "03:19:37", "text": "その武器を持ってきてアストラを脅かす。"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "私はどんな武器が欲しいか決める"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "怖がらないで。どんな武器？ディスク"}, {"type": "subtitle", "time": 11987.99, "timestamp": "03:19:47", "text": "ホーミングディスク。"}, {"type": "subtitle", "time": 11990.83, "timestamp": "03:19:50", "text": "ああ、どうやって作ったんですか？"}, {"type": "subtitle", "time": 11995.429, "timestamp": "03:19:55", "text": "いいえ、つまり、私はまた答えを知りません"}]
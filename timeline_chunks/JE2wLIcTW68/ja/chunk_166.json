[{"type": "subtitle", "time": 9987.309, "timestamp": "02:46:27", "text": "アストラ。こんにちは。"}, {"type": "subtitle", "time": 9991.03, "timestamp": "02:46:31", "text": "こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 9997.59, "timestamp": "02:46:37", "text": "今？よくやったね。私は"}, {"type": "subtitle", "time": 10002.63, "timestamp": "02:46:42", "text": "シャワー？私たちが話していたやつです。あなたは"}, {"type": "subtitle", "time": 10010.38, "timestamp": "02:46:50", "text": "掃除をします"}, {"type": "subtitle", "time": 10016.61, "timestamp": "02:46:56", "text": "あなた。は"}, {"type": "subtitle", "time": 10018.75, "timestamp": "02:46:58", "text": "[音楽]"}]
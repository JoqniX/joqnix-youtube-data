[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "彼は税金対策のためにそうしているのだ。しないでください"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "それ。あなたは税金をいくら払っていますか？それは結婚ではない"}, {"type": "subtitle", "time": 5596.709, "timestamp": "01:33:16", "text": "ここでは車の作業をしましょう。"}, {"type": "subtitle", "time": 5627.47, "timestamp": "01:33:47", "text": "カートを運び入れます"}, {"type": "subtitle", "time": 5631.709, "timestamp": "01:33:51", "text": "前に私たちはただ"}, {"type": "subtitle", "time": 5635.83, "timestamp": "01:33:55", "text": "彼はすぐそこにいる。わかった。そこには"}]
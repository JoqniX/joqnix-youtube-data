[{"type": "subtitle", "time": 20040.628, "timestamp": "05:34:00", "text": "ああ、これはチャンスだ。これを見せてください。"}, {"type": "subtitle", "time": 20043.03, "timestamp": "05:34:03", "text": "なんというか、どう言えばいいかな"}, {"type": "subtitle", "time": 20045.27, "timestamp": "05:34:05", "text": "私にとってはアニメがたくさんある。アニメボイスが多すぎる"}, {"type": "subtitle", "time": 20046.83, "timestamp": "05:34:06", "text": "のために"}, {"type": "subtitle", "time": 20049.37, "timestamp": "05:34:09", "text": "私みたいに"}, {"type": "subtitle", "time": 20072.628, "timestamp": "05:34:32", "text": "そしてこの曲は氷上で歌われる"}, {"type": "subtitle", "time": 20075.75, "timestamp": "05:34:35", "text": "クリーム風味。うん。女の子は"}, {"type": "subtitle", "time": 20079.35, "timestamp": "05:34:39", "text": "女の子が「あなたはMですか、何をしますか」と聞いています"}, {"type": "subtitle", "time": 20081.99, "timestamp": "05:34:41", "text": "気に入りましたか？彼女は「クッキーが好き」と言っている"}, {"type": "subtitle", "time": 20083.91, "timestamp": "05:34:43", "text": "そしてクリームと、もう一人の女の子は私が"}, {"type": "subtitle", "time": 20086.628, "timestamp": "05:34:46", "text": "イチゴ味など"}, {"type": "subtitle", "time": 20090.788, "timestamp": "05:34:50", "text": "女の子は「チョコミントが好き」と言いました。送ります"}, {"type": "subtitle", "time": 20092.948, "timestamp": "05:34:52", "text": "私は女の子が好きです。"}]
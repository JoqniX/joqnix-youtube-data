[{"type": "subtitle", "time": 723.269, "timestamp": "00:12:03", "text": "くそ。このゲームは何ですか？私はしません"}, {"type": "subtitle", "time": 726.069, "timestamp": "00:12:06", "text": "この男の気持ちがわかる。よし。えっと、いつ"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "負けると、チャンスが訪れる。"}, {"type": "subtitle", "time": 731.509, "timestamp": "00:12:11", "text": "負けると、デスマッチになる"}, {"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "最後に残った人が最大の損失です。"}, {"type": "subtitle", "time": 740.71, "timestamp": "00:12:20", "text": "何でも。それはすごくクールですね。なぜこれが"}, {"type": "subtitle", "time": 743.389, "timestamp": "00:12:23", "text": "ゲームってすごく楽しい？"}, {"type": "subtitle", "time": 747.43, "timestamp": "00:12:27", "text": "いや、すごい。それはすごくクールですね。"}, {"type": "subtitle", "time": 754.949, "timestamp": "00:12:34", "text": "いいえ。私を愛して。それでは始めましょう。 1つ"}, {"type": "subtitle", "time": 757.43, "timestamp": "00:12:37", "text": "もっと。それでは始めましょう。それでは始めましょう。うん。は"}, {"type": "subtitle", "time": 759.19, "timestamp": "00:12:39", "text": "ロッカが参加する？ところで、ちょっと"}, {"type": "subtitle", "time": 761.59, "timestamp": "00:12:41", "text": "それは不運だったと言う、なぜならそれはとても"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "最初のマップが古いものになるのは珍しい"}, {"type": "subtitle", "time": 768.629, "timestamp": "00:12:48", "text": "男。ああ、そうだけど、彼は唯一の人だ"}, {"type": "subtitle", "time": 771.35, "timestamp": "00:12:51", "text": "音によって活性化される。だから"}, {"type": "subtitle", "time": 773.19, "timestamp": "00:12:53", "text": "他の敵もいるから、"}, {"type": "subtitle", "time": 775.67, "timestamp": "00:12:55", "text": "彼らへの対処法を知っている。よし。"}, {"type": "subtitle", "time": 778.23, "timestamp": "00:12:58", "text": "うん、行こう。それでは始めましょう。待って、"}]
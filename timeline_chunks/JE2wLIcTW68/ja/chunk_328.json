[{"type": "subtitle", "time": 19682.47, "timestamp": "05:28:02", "text": "起こさないで。一体どういうことだ？あなた"}, {"type": "subtitle", "time": 19685.99, "timestamp": "05:28:05", "text": "実際、大丈夫です。あなたは実際に私と同じように聞こえます"}, {"type": "subtitle", "time": 19693.03, "timestamp": "05:28:13", "text": "わからない。来るような気がした"}, {"type": "subtitle", "time": 19718.47, "timestamp": "05:28:38", "text": "いや、わからないよ。私の友人は話す"}, {"type": "subtitle", "time": 19720.39, "timestamp": "05:28:40", "text": "典型的な、ごく普通のこと。彼は私が"}, {"type": "subtitle", "time": 19722.868, "timestamp": "05:28:42", "text": "どうやら私は話さないので"}, {"type": "subtitle", "time": 19730.868, "timestamp": "05:28:50", "text": "いや、実際は良いですよ。まあ、そんな感じ"}, {"type": "subtitle", "time": 19733.43, "timestamp": "05:28:53", "text": "正確な。わからない。"}, {"type": "subtitle", "time": 19735.99, "timestamp": "05:28:55", "text": "今、話すときに混乱していることに気づきました"}, {"type": "subtitle", "time": 19739.03, "timestamp": "05:28:59", "text": "パンジャブ語とハンヴィ語（時々）"}]
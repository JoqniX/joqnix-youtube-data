[{"type": "subtitle", "time": 14101.269, "timestamp": "03:55:01", "text": "電気の雷？おい、それめっちゃかっこいいじゃん。"}, {"type": "subtitle", "time": 14104.309, "timestamp": "03:55:04", "text": "わかりました、私たちはドラゴンを倒すことはできません"}, {"type": "subtitle", "time": 14105.91, "timestamp": "03:55:05", "text": "剣。すみません、許していただけるんですね。"}, {"type": "subtitle", "time": 14108.55, "timestamp": "03:55:08", "text": "さもなければ、私は殺していたかもしれない。これは"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "ドラゴン。これには柱があり、"}, {"type": "subtitle", "time": 14114.07, "timestamp": "03:55:14", "text": "それを再生する。次に、"}, {"type": "subtitle", "time": 14117.91, "timestamp": "03:55:17", "text": "それぞれがブロックです。壊さないでください。いいえ、"}, {"type": "subtitle", "time": 14121.269, "timestamp": "03:55:21", "text": "それからそれを殺して、それから"}, {"type": "subtitle", "time": 14123.67, "timestamp": "03:55:23", "text": "自由にゲームを終了させる"}, {"type": "subtitle", "time": 14126.75, "timestamp": "03:55:26", "text": "プレイするが、ゲームのメインストーリー"}, {"type": "subtitle", "time": 14156.429, "timestamp": "03:55:56", "text": "それは何ですか？来ないでください"}]
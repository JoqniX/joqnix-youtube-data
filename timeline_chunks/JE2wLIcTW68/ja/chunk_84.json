[{"type": "subtitle", "time": 5055.51, "timestamp": "01:24:15", "text": "ああ、他にも商品があるんですね。トロフィー。"}, {"type": "subtitle", "time": 5057.91, "timestamp": "01:24:17", "text": "私は自殺する。"}, {"type": "subtitle", "time": 5066.75, "timestamp": "01:24:26", "text": "これ。 1つ"}, {"type": "subtitle", "time": 5069.43, "timestamp": "01:24:29", "text": "えっと、彼が手に入れたと思う"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "びっくりして死んでしまった。いいえ、彼は"}, {"type": "subtitle", "time": 5072.79, "timestamp": "01:24:32", "text": "接続が切断されました。"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "彼はそうしたのか？"}, {"type": "subtitle", "time": 5076.629, "timestamp": "01:24:36", "text": "ああ、くそ。うん。一体どういうことだ？何"}, {"type": "subtitle", "time": 5078.79, "timestamp": "01:24:38", "text": "何が起こったのか？"}, {"type": "subtitle", "time": 5081.99, "timestamp": "01:24:41", "text": "それでは失礼します。おお、"}, {"type": "subtitle", "time": 5083.669, "timestamp": "01:24:43", "text": "気をつけて。"}, {"type": "subtitle", "time": 5085.83, "timestamp": "01:24:45", "text": "ご参加いただきありがとうございます。ロコ、ありがとう"}, {"type": "subtitle", "time": 5088.07, "timestamp": "01:24:48", "text": "参加していただきありがとうございます。つまり、まあ、どうなるか見てみましょう"}, {"type": "subtitle", "time": 5091.95, "timestamp": "01:24:51", "text": "次は君の番だよ。その後"}, {"type": "subtitle", "time": 5096.149, "timestamp": "01:24:56", "text": "また一人、新生児が生まれた。おやすみ。おやすみ"}, {"type": "subtitle", "time": 5099.59, "timestamp": "01:24:59", "text": "おやすみなさい"}]
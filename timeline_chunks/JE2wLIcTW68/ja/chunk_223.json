[{"type": "subtitle", "time": 13394.87, "timestamp": "03:43:14", "text": "待って、魔法使いがいるの？"}, {"type": "subtitle", "time": 13402.469, "timestamp": "03:43:22", "text": "ほら、見せてあげるよ。その弓みたいなものを見せて"}, {"type": "subtitle", "time": 13404.87, "timestamp": "03:43:24", "text": "水の上を歩けるようになる。そうではない"}, {"type": "subtitle", "time": 13408.429, "timestamp": "03:43:28", "text": "溶岩の上を歩かせてあげるよ。"}, {"type": "subtitle", "time": 13411.75, "timestamp": "03:43:31", "text": "何？本当に？"}, {"type": "subtitle", "time": 13416.67, "timestamp": "03:43:36", "text": "おお、"}, {"type": "subtitle", "time": 13418.51, "timestamp": "03:43:38", "text": "おお。の"}, {"type": "subtitle", "time": 13435.99, "timestamp": "03:43:55", "text": "私はクローン/クローンですか？"}]
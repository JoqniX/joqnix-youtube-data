[{"type": "subtitle", "time": 11107.75, "timestamp": "03:05:07", "text": "雨が降っている。こんなことができるなんて知らなかった"}, {"type": "subtitle", "time": 11111.03, "timestamp": "03:05:11", "text": "特注タイプのいかだ。いや、それは面白い"}, {"type": "subtitle", "time": 11112.309, "timestamp": "03:05:12", "text": "十分。"}, {"type": "subtitle", "time": 11114.11, "timestamp": "03:05:14", "text": "ああ、これは"}, {"type": "subtitle", "time": 11117.91, "timestamp": "03:05:17", "text": "バニラ。そうです。わあ、これはずっといい"}, {"type": "subtitle", "time": 11137.55, "timestamp": "03:05:37", "text": "ほら、俺の見た目、かっこいいだろ？"}, {"type": "subtitle", "time": 11144.71, "timestamp": "03:05:44", "text": "マインクラフトを始めてどれくらいになりますか？"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "のために？"}, {"type": "subtitle", "time": 11149.75, "timestamp": "03:05:49", "text": "いつから始めましたか？"}, {"type": "subtitle", "time": 11152.469, "timestamp": "03:05:52", "text": "私は退屈していました。"}, {"type": "subtitle", "time": 11155.44, "timestamp": "03:05:55", "text": "どうしたの？"}]
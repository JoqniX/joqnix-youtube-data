[{"type": "subtitle", "time": 17597.03, "timestamp": "04:53:17", "text": "ああ、なんてことだ、君たちはどうしてこんな風なんだ？"}, {"type": "subtitle", "time": 17600.47, "timestamp": "04:53:20", "text": "彼女は私の一番好きな歌手です。"}, {"type": "subtitle", "time": 17610.15, "timestamp": "04:53:30", "text": "聞く。ええ、彼女をフォローしています。私はついていきます"}, {"type": "subtitle", "time": 17631.708, "timestamp": "04:53:51", "text": "カバーオーディオ。その"}, {"type": "subtitle", "time": 17638.59, "timestamp": "04:53:58", "text": "いくつかは"}]
[{"type": "subtitle", "time": 11703.51, "timestamp": "03:15:03", "text": "わかった、じゃあトイレットペーパーで叩いてやるよ。"}, {"type": "subtitle", "time": 11705.59, "timestamp": "03:15:05", "text": "私にTPを送るにはどうすればいいですか？何が"}, {"type": "subtitle", "time": 11707.15, "timestamp": "03:15:07", "text": "指示？ TP"}, {"type": "subtitle", "time": 11709.99, "timestamp": "03:15:09", "text": "/TP の後にスペースを入れて名前を入力します"}, {"type": "subtitle", "time": 11713.349, "timestamp": "03:15:13", "text": "TPしたい相手にスペース"}, {"type": "subtitle", "time": 11716.95, "timestamp": "03:15:16", "text": "最初に誰にあなたの名前を記入しますか"}, {"type": "subtitle", "time": 11718.269, "timestamp": "03:15:18", "text": "名前"}, {"type": "subtitle", "time": 11720.87, "timestamp": "03:15:20", "text": "あなたがトイレットペーパーを投げつけたいような人"}, {"type": "subtitle", "time": 11723.11, "timestamp": "03:15:23", "text": "そして、TPしたい相手の2番目の名前。"}, {"type": "subtitle", "time": 11725.469, "timestamp": "03:15:25", "text": "わかった。わかった。わかった。"}, {"type": "subtitle", "time": 11728.79, "timestamp": "03:15:28", "text": "こんにちは。よし、襲撃を受けた。 1秒。ああ、"}, {"type": "subtitle", "time": 11731.19, "timestamp": "03:15:31", "text": "こんにちは、イイサさん。襲撃してくれてありがとう。"}, {"type": "subtitle", "time": 11732.67, "timestamp": "03:15:32", "text": "ようこそ"}, {"type": "subtitle", "time": 11735.79, "timestamp": "03:15:35", "text": "襲撃者。レイダーズの皆さん、ようこそ。こんにちは。"}, {"type": "subtitle", "time": 11740.15, "timestamp": "03:15:40", "text": "こんにちは。何てことだ。"}, {"type": "subtitle", "time": 11743.349, "timestamp": "03:15:43", "text": "襲撃事件。その襲撃は、"}, {"type": "subtitle", "time": 11746.469, "timestamp": "03:15:46", "text": "配信者が配信を終了します。"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "ああ、Twitchのあれだよ。"}, {"type": "subtitle", "time": 11753.63, "timestamp": "03:15:53", "text": "ああ、Twitchでね。わかった。わかった。"}, {"type": "subtitle", "time": 11756.389, "timestamp": "03:15:56", "text": "うん。 15分。ええと、ありがとうございます"}, {"type": "subtitle", "time": 11759.63, "timestamp": "03:15:59", "text": "3日間の夜を通してフォローアップする。"}]
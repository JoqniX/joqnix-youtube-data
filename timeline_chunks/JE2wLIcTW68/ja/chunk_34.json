[{"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "シナリオのクソ女。"}, {"type": "subtitle", "time": 2045.9, "timestamp": "00:34:05", "text": "私は大丈夫です。私は大丈夫です。"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "よう、元気？"}, {"type": "subtitle", "time": 2057.829, "timestamp": "00:34:17", "text": "何てことだ。よし、そこに着くよ"}, {"type": "subtitle", "time": 2067.03, "timestamp": "00:34:27", "text": "なくなってしまったのですか？ええと、クレーターは死んでしまいました。クレーター"}, {"type": "subtitle", "time": 2069.51, "timestamp": "00:34:29", "text": "死亡した。"}, {"type": "subtitle", "time": 2072.23, "timestamp": "00:34:32", "text": "何てことだ。殺すことはできないのか、"}, {"type": "subtitle", "time": 2076.629, "timestamp": "00:34:36", "text": "何か？実際に試してみます。"}, {"type": "subtitle", "time": 2091.99, "timestamp": "00:34:51", "text": "何？私はアヒルを殺した。いいね。"}, {"type": "subtitle", "time": 2095.069, "timestamp": "00:34:55", "text": "さあ行こう。それはホーンだ。"}, {"type": "subtitle", "time": 2097.27, "timestamp": "00:34:57", "text": "くそっ。あれは地雷だ。わかった。やめて、やめて"}]
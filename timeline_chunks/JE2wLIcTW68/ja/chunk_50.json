[{"type": "subtitle", "time": 3005.86, "timestamp": "00:50:05", "text": "私"}, {"type": "subtitle", "time": 3008.829, "timestamp": "00:50:08", "text": "[音楽]"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "何？いいえ。いいえ。私はそれを"}, {"type": "subtitle", "time": 3044.069, "timestamp": "00:50:44", "text": "手榴弾。だから私はそれを運営していないのです。"}, {"type": "subtitle", "time": 3046.39, "timestamp": "00:50:46", "text": "ああ、わかりました。あ、待って、待って、待って。おお、"}, {"type": "subtitle", "time": 3047.43, "timestamp": "00:50:47", "text": "わかった。わかった。それをくれ。それをくれ。与える"}, {"type": "subtitle", "time": 3051.75, "timestamp": "00:50:51", "text": "それは私にも当てはまる。はい、どうぞ。ああ、くそ。離れて"}, {"type": "subtitle", "time": 3054.109, "timestamp": "00:50:54", "text": "戦利品から。から離れて"}]
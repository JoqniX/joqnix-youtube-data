[{"type": "subtitle", "time": 429.67, "timestamp": "00:07:09", "text": "よぉ、行こうぜ。もちろんさ。待って、"}, {"type": "subtitle", "time": 433.189, "timestamp": "00:07:13", "text": "それは、それは、それは、それは"}, {"type": "subtitle", "time": 442.909, "timestamp": "00:07:22", "text": "あまり。いいえ、ある程度は"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "わかった。"}, {"type": "subtitle", "time": 446.35, "timestamp": "00:07:26", "text": "あなたは今まさにそれをしました"}, {"type": "subtitle", "time": 449.27, "timestamp": "00:07:29", "text": "それ。何てことだ。よし、行こう。始める"}, {"type": "subtitle", "time": 451.189, "timestamp": "00:07:31", "text": "ゲーム。"}, {"type": "subtitle", "time": 458.23, "timestamp": "00:07:38", "text": "ああ、ロード中に話せるんですね"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "ちなみに、スクリーンのことです。おお、いいね。ああ、なんてことだ"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "うん。さあ行こう。村長、男。"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "推測ですが。そうそう。それで、ジョー、これは"}, {"type": "subtitle", "time": 469.99, "timestamp": "00:07:49", "text": "何か面白いことができるよ。わかった。いつ"}, {"type": "subtitle", "time": 471.35, "timestamp": "00:07:51", "text": "上下を見渡すと、上向きに傾く"}, {"type": "subtitle", "time": 472.71, "timestamp": "00:07:52", "text": "そして下へ、そしてテキストがあるように"}]
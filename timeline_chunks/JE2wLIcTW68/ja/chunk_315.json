[{"type": "subtitle", "time": 18902.948, "timestamp": "05:15:02", "text": "上。うん。右。"}, {"type": "subtitle", "time": 18906.47, "timestamp": "05:15:06", "text": "こんにちは。こんにちは。それで、えっと、兄弟、私は"}, {"type": "subtitle", "time": 18917.43, "timestamp": "05:15:17", "text": "友達に言わなきゃいけないとしたら、"}, {"type": "subtitle", "time": 18922.948, "timestamp": "05:15:22", "text": "そんな感じ。ああ、しまった。あなた"}, {"type": "subtitle", "time": 18925.83, "timestamp": "05:15:25", "text": "本当に私のペロシに似ている。何"}, {"type": "subtitle", "time": 18928.67, "timestamp": "05:15:28", "text": "くそ？私の"}, {"type": "subtitle", "time": 18931.67, "timestamp": "05:15:31", "text": "神。右。"}, {"type": "subtitle", "time": 18935.43, "timestamp": "05:15:35", "text": "ああ、神様。うん。わかった。それはあまりにも"}, {"type": "subtitle", "time": 18938.55, "timestamp": "05:15:38", "text": "実際、正確です。"}, {"type": "subtitle", "time": 18941.35, "timestamp": "05:15:41", "text": "ええと、気にしません。教えてあげよう"}, {"type": "subtitle", "time": 18944.19, "timestamp": "05:15:44", "text": "後で、私がその点で優れている理由を説明します。しかし"}, {"type": "subtitle", "time": 18947.11, "timestamp": "05:15:47", "text": "ええ、私はあらゆるものに囲まれていました"}, {"type": "subtitle", "time": 18949.43, "timestamp": "05:15:49", "text": "パンジャブ人。だから私はアクセントを"}, {"type": "subtitle", "time": 18952.868, "timestamp": "05:15:52", "text": "そこにいて、私は理解できると思う"}, {"type": "subtitle", "time": 18955.99, "timestamp": "05:15:55", "text": "ほとんどすべてがパンジャブ語です。私もできます"}, {"type": "subtitle", "time": 18958.628, "timestamp": "05:15:58", "text": "理解できると思うけど、私にはできないと思う"}]
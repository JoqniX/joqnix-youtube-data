[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "なんてこった。良い。ああ、ジョック、どうして君は"}, {"type": "subtitle", "time": 4685.189, "timestamp": "01:18:05", "text": "それについて？私はそれを見た。ええ、そう書いてありました"}, {"type": "subtitle", "time": 4686.87, "timestamp": "01:18:06", "text": "ヨインク。"}, {"type": "subtitle", "time": 4688.35, "timestamp": "01:18:08", "text": "ああ、"}, {"type": "subtitle", "time": 4692.79, "timestamp": "01:18:12", "text": "神。ああ、抽出してみましょう。オリジナル曲を"}, {"type": "subtitle", "time": 4712.79, "timestamp": "01:18:32", "text": "おお。何てことだ。乗る"}, {"type": "subtitle", "time": 4725.89, "timestamp": "01:18:45", "text": "自分がどうやって死んだのか分からない。"}]
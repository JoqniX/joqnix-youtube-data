[{"type": "subtitle", "time": 20108.75, "timestamp": "05:35:08", "text": "それはまるで日本人のようだ"}, {"type": "subtitle", "time": 20127.51, "timestamp": "05:35:27", "text": "はい。実際は、もっと"}, {"type": "subtitle", "time": 20134.15, "timestamp": "05:35:34", "text": "うん。うん。うん。ラシュカンは夢を見ない"}, {"type": "subtitle", "time": 20137.11, "timestamp": "05:35:37", "text": "バニーガールの。うん。うん。何か"}, {"type": "subtitle", "time": 20140.23, "timestamp": "05:35:40", "text": "あれがバニーガールだ。"}]
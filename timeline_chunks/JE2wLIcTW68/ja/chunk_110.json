[{"type": "subtitle", "time": 6604.229, "timestamp": "01:50:04", "text": "うん、私も同じことができたらいいのに。"}, {"type": "subtitle", "time": 6623.91, "timestamp": "01:50:23", "text": "ブラウザ なぜなら時々誤って"}, {"type": "subtitle", "time": 6625.31, "timestamp": "01:50:25", "text": "私が見せるもの"}, {"type": "subtitle", "time": 6650.629, "timestamp": "01:50:50", "text": "悪い。この桟橋を食べさせてくれ。わかった。だって私は"}]
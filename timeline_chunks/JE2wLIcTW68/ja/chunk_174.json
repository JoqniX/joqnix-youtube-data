[{"type": "subtitle", "time": 10441.99, "timestamp": "02:54:01", "text": "へ歩いていく"}, {"type": "subtitle", "time": 10443.51, "timestamp": "02:54:03", "text": "うん。"}, {"type": "subtitle", "time": 10446.07, "timestamp": "02:54:06", "text": "なぜ？"}, {"type": "subtitle", "time": 10450.19, "timestamp": "02:54:10", "text": "あれがマグマだ。それは"}, {"type": "subtitle", "time": 10452.87, "timestamp": "02:54:12", "text": "マグマ。くそ。"}, {"type": "subtitle", "time": 10455.11, "timestamp": "02:54:15", "text": "なぜそれを持っているのですか？"}, {"type": "subtitle", "time": 10459.19, "timestamp": "02:54:19", "text": "エレベーターはそういう仕組みで動くんです。うん。"}, {"type": "subtitle", "time": 10462.95, "timestamp": "02:54:22", "text": "上へ行かなければならない。どうやら、"}, {"type": "subtitle", "time": 10465.389, "timestamp": "02:54:25", "text": "降りてきてください。"}, {"type": "subtitle", "time": 10469.75, "timestamp": "02:54:29", "text": "くそ。実際には、あなたはヒッチハイクが必要です。"}, {"type": "subtitle", "time": 10472.71, "timestamp": "02:54:32", "text": "今、左折しました。ああ、使えるよ"}, {"type": "subtitle", "time": 10481.83, "timestamp": "02:54:41", "text": "ああ、ハニーはそんなに早く寝るわけじゃないよ。ああ。"}, {"type": "subtitle", "time": 10485.11, "timestamp": "02:54:45", "text": "ああ、これは蜂蜜よりも速い。その"}, {"type": "subtitle", "time": 10494.269, "timestamp": "02:54:54", "text": "おお。うん。しかし左と"}, {"type": "subtitle", "time": 10496.11, "timestamp": "02:54:56", "text": "右。何"}]
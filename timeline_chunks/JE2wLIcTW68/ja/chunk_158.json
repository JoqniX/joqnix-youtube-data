[{"type": "subtitle", "time": 9484.429, "timestamp": "02:38:04", "text": "[音楽]"}, {"type": "subtitle", "time": 9486.349, "timestamp": "02:38:06", "text": "知る。"}, {"type": "subtitle", "time": 9492.23, "timestamp": "02:38:12", "text": "わかった。 27日目に、私たちは"}, {"type": "subtitle", "time": 9499.469, "timestamp": "02:38:19", "text": "私は何をしたの？"}, {"type": "subtitle", "time": 9507.27, "timestamp": "02:38:27", "text": "今日？今日は、"}, {"type": "subtitle", "time": 9522.87, "timestamp": "02:38:42", "text": "警告。ええ、半分の人に警告していたんです"}, {"type": "subtitle", "time": 9525.03, "timestamp": "02:38:45", "text": "日。"}, {"type": "subtitle", "time": 9527.349, "timestamp": "02:38:47", "text": "私が戻ってきたのは5時だけだった"}, {"type": "subtitle", "time": 9529.95, "timestamp": "02:38:49", "text": "火災痕跡。火事の中で私は何をしたのか"}, {"type": "subtitle", "time": 9533.309, "timestamp": "02:38:53", "text": "マーク？私たちは遊んだ"}, {"type": "subtitle", "time": 9539.63, "timestamp": "02:38:59", "text": "頂点。そういう睡眠スケジュールだった。私たちは"}]
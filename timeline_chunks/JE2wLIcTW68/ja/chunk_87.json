[{"type": "subtitle", "time": 5235.27, "timestamp": "01:27:15", "text": "[ __ ]。ああ！私はクローゼットの中にいる。待って、"}, {"type": "subtitle", "time": 5237.03, "timestamp": "01:27:17", "text": "何？いや、いや、いや、いや、いや。私は"}, {"type": "subtitle", "time": 5238.95, "timestamp": "01:27:18", "text": "クローゼット。私はカミングアウトします。"}, {"type": "subtitle", "time": 5240.31, "timestamp": "01:27:20", "text": "待って、いや、いや、いや。それは私が"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "意味。クローゼットは関係ありません。"}, {"type": "subtitle", "time": 5247.55, "timestamp": "01:27:27", "text": "くそ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。それは"}, {"type": "subtitle", "time": 5258.149, "timestamp": "01:27:38", "text": "キリスト。ああ、二人とも死んでしまったんだ。うん。"}, {"type": "subtitle", "time": 5259.709, "timestamp": "01:27:39", "text": "素敵な。"}, {"type": "subtitle", "time": 5261.95, "timestamp": "01:27:41", "text": "わかった。私は違う"}]
[{"type": "subtitle", "time": 11585.59, "timestamp": "03:13:05", "text": "何てことだ。"}, {"type": "subtitle", "time": 11589.03, "timestamp": "03:13:09", "text": "わかった。私は彼女にトイレットペーパーをあげた。"}, {"type": "subtitle", "time": 11601.51, "timestamp": "03:13:21", "text": "わかった。何てことだ。クリーパー。ああ、そうだったの？"}, {"type": "subtitle", "time": 11604.07, "timestamp": "03:13:24", "text": "マインクラフトの映画を観ますか？"}, {"type": "subtitle", "time": 11606.309, "timestamp": "03:13:26", "text": "ええ、見ました。"}, {"type": "subtitle", "time": 11611.51, "timestamp": "03:13:31", "text": "インタビューのような休憩時間。ああ、なぜ？それ"}, {"type": "subtitle", "time": 11626.07, "timestamp": "03:13:46", "text": "うん、昨日アプリで見たよ"}, {"type": "subtitle", "time": 11629.51, "timestamp": "03:13:49", "text": "そして私は待たない、なぜだかわからない"}, {"type": "subtitle", "time": 11632.229, "timestamp": "03:13:52", "text": "何か未完成のものがあるような気がした。私は見た"}, {"type": "subtitle", "time": 11634.51, "timestamp": "03:13:54", "text": "グリーンスクリーンとか、そういうもの。私はこう思った"}, {"type": "subtitle", "time": 11637.59, "timestamp": "03:13:57", "text": "実際に待つ"}, {"type": "subtitle", "time": 11639.269, "timestamp": "03:13:59", "text": "この映画はマインクラフトに基づいています"}]
[{"type": "subtitle", "time": 12067.83, "timestamp": "03:21:07", "text": "こんにちは。つまり、これは、私たちは"}, {"type": "subtitle", "time": 12069.75, "timestamp": "03:21:09", "text": "サーバーを再訪する。イベントは"}, {"type": "subtitle", "time": 12072.349, "timestamp": "03:21:12", "text": "終了した。これは、これはSMPによるものです"}, {"type": "subtitle", "time": 12077.03, "timestamp": "03:21:17", "text": "アストレイティは破滅と呼ばれた。でもそれは多かった"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "インド人ユーチューバーの。私たちは"}, {"type": "subtitle", "time": 12084.469, "timestamp": "03:21:24", "text": "ストーリーベースのSMPのようなもの、またはSMP。"}, {"type": "subtitle", "time": 12087.51, "timestamp": "03:21:27", "text": "でも、私がこれをあなたにあげたのはいつですか？"}, {"type": "subtitle", "time": 12090.95, "timestamp": "03:21:30", "text": "私はウィザーローズについてのみ話しています"}, {"type": "subtitle", "time": 12093.63, "timestamp": "03:21:33", "text": "そして金色。"}, {"type": "subtitle", "time": 12097.75, "timestamp": "03:21:37", "text": "うん。でも、私があなたにディスクを渡したのはいつでしたっけ？"}, {"type": "subtitle", "time": 12111.15, "timestamp": "03:21:51", "text": "そして、ああ、なんてことだ。何？何"}, {"type": "subtitle", "time": 12114.71, "timestamp": "03:21:54", "text": "一体どういうことだ？神社を見てください"}, {"type": "subtitle", "time": 12119.03, "timestamp": "03:21:59", "text": "かわいい。わかりました、また来ます。わかった。"}]
[{"type": "subtitle", "time": 18481.43, "timestamp": "05:08:01", "text": "[音楽]"}, {"type": "subtitle", "time": 18484.708, "timestamp": "05:08:04", "text": "いいえ、私たちの家は"}, {"type": "subtitle", "time": 18487.11, "timestamp": "05:08:07", "text": "これ。"}, {"type": "subtitle", "time": 18489.19, "timestamp": "05:08:09", "text": "ええと、幻想は良いものではありません。"}, {"type": "subtitle", "time": 18491.35, "timestamp": "05:08:11", "text": "あなたが知っている。"}, {"type": "subtitle", "time": 18503.19, "timestamp": "05:08:23", "text": "アメジスト。"}, {"type": "subtitle", "time": 18506.55, "timestamp": "05:08:26", "text": "言うべきこと"}, {"type": "subtitle", "time": 18508.67, "timestamp": "05:08:28", "text": "彼は怖がっているから、"}, {"type": "subtitle", "time": 18510.75, "timestamp": "05:08:30", "text": "右？私はしません"}, {"type": "subtitle", "time": 18515.11, "timestamp": "05:08:35", "text": "知る。ところで、あなたはどこにいるのですか？"}, {"type": "subtitle", "time": 18518.31, "timestamp": "05:08:38", "text": "私は。わかった。大丈夫。私は必要ない"}, {"type": "subtitle", "time": 18523.35, "timestamp": "05:08:43", "text": "それ。私は既にエメラルドを64個持っています。"}, {"type": "subtitle", "time": 18536.948, "timestamp": "05:08:56", "text": "私はあなたが蚊だ。君が飛んでいるのが見えるよ。"}, {"type": "subtitle", "time": 18538.51, "timestamp": "05:08:58", "text": "わかった。それで"}]
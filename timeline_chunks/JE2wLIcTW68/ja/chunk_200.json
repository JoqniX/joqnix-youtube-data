[{"type": "subtitle", "time": 12001.269, "timestamp": "03:20:01", "text": "どうやって？どうやって？今すぐ知りたい。どうやって"}, {"type": "subtitle", "time": 12009.349, "timestamp": "03:20:09", "text": "え、どうやって？実際、私は知りたい"}, {"type": "subtitle", "time": 12023.99, "timestamp": "03:20:23", "text": "分かりません。誰かから"}, {"type": "subtitle", "time": 12036.229, "timestamp": "03:20:36", "text": "いいえ、あなたでした。あなただったんですね。あなたは"}, {"type": "subtitle", "time": 12038.95, "timestamp": "03:20:38", "text": "忘れる？私は彼にあげた。待って、どうやって私は"}, {"type": "subtitle", "time": 12043.75, "timestamp": "03:20:43", "text": "彼？何てことだ。あなたは本当に忘れていましたね。"}, {"type": "subtitle", "time": 12046.71, "timestamp": "03:20:46", "text": "いいえ、いいえ、いいえ、いいえ。私はかなり確信しています"}, {"type": "subtitle", "time": 12050.79, "timestamp": "03:20:50", "text": "私は自分の持ち物を誰にも渡していません。"}, {"type": "subtitle", "time": 12059.11, "timestamp": "03:20:59", "text": "ここに来て。お見せしましょう。"}]
[{"type": "subtitle", "time": 10032.269, "timestamp": "02:47:12", "text": "こんにちは。私はプレイホストをしました"}, {"type": "subtitle", "time": 10035.75, "timestamp": "02:47:15", "text": "今日。面白いものを見せてあげられるよ。私"}, {"type": "subtitle", "time": 10039.429, "timestamp": "02:47:19", "text": "今日はホスト役をやってみた。"}, {"type": "subtitle", "time": 10048.11, "timestamp": "02:47:28", "text": "選ぶ。待って、私は見せることができます"}, {"type": "subtitle", "time": 10051.309, "timestamp": "02:47:31", "text": "今日は、おままごとハウスで遊んだみたいだ。"}, {"type": "subtitle", "time": 10055.309, "timestamp": "02:47:35", "text": "えっと、何をすればいいのか全く分かりません"}, {"type": "subtitle", "time": 10058.429, "timestamp": "02:47:38", "text": "する。えっと"}, {"type": "subtitle", "time": 10061.91, "timestamp": "02:47:41", "text": "「Dを選択」の後には何があるの？何が"}, {"type": "subtitle", "time": 10065.03, "timestamp": "02:47:45", "text": "ネオフォージ？これらを試してみたいですね"}, {"type": "subtitle", "time": 10067.83, "timestamp": "02:47:47", "text": "などなど。"}, {"type": "subtitle", "time": 10073.389, "timestamp": "02:47:53", "text": "プラグインですが"}, {"type": "subtitle", "time": 10076.349, "timestamp": "02:47:56", "text": "紙生地"}, {"type": "subtitle", "time": 10079.67, "timestamp": "02:47:59", "text": "フォージ。それで、えーと、破滅の誕生は"}]
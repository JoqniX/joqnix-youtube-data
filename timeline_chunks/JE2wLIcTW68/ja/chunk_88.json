[{"type": "subtitle", "time": 5281.99, "timestamp": "01:28:01", "text": "自分。黙れ。"}, {"type": "subtitle", "time": 5304.27, "timestamp": "01:28:24", "text": "自分。何が"}, {"type": "subtitle", "time": 5305.95, "timestamp": "01:28:25", "text": "あれ？"}, {"type": "subtitle", "time": 5309.51, "timestamp": "01:28:29", "text": "大丈夫だよ、相棒。心配しないで、"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "相棒。私たちは長く幸せに暮らすでしょう"}, {"type": "subtitle", "time": 5315.629, "timestamp": "01:28:35", "text": "私たちにとっての人生。私はかなり"}, {"type": "subtitle", "time": 5319.629, "timestamp": "01:28:39", "text": "もちろん。うん、それでいいよ。それ"}, {"type": "subtitle", "time": 5326.669, "timestamp": "01:28:46", "text": "うわ、うわ、うわ。"}, {"type": "subtitle", "time": 5328.79, "timestamp": "01:28:48", "text": "わかった。わかった。よし。私たちは大丈夫です。私たちは"}, {"type": "subtitle", "time": 5335.03, "timestamp": "01:28:55", "text": "戻る。お前らのことに構ってる暇はない"}, {"type": "subtitle", "time": 5338.59, "timestamp": "01:28:58", "text": "でたらめだ。離れて"}]
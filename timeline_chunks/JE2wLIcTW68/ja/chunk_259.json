[{"type": "subtitle", "time": 15541.75, "timestamp": "04:19:01", "text": "ああ、君の声はもうめちゃくちゃだよ。"}, {"type": "subtitle", "time": 15546.07, "timestamp": "04:19:06", "text": "ああ、それはきっと今より前のことだろう。良くなった？"}, {"type": "subtitle", "time": 15557.11, "timestamp": "04:19:17", "text": "まあ、それは君たちにとって辛いことだよ。ああ、"}, {"type": "subtitle", "time": 15558.71, "timestamp": "04:19:18", "text": "神。"}, {"type": "subtitle", "time": 15561.99, "timestamp": "04:19:21", "text": "なぜ寝ているのですか？"}, {"type": "subtitle", "time": 15565.83, "timestamp": "04:19:25", "text": "私は死が怖い。ああ、"}, {"type": "subtitle", "time": 15569.349, "timestamp": "04:19:29", "text": "神。あなたは今、"}, {"type": "subtitle", "time": 15578.95, "timestamp": "04:19:38", "text": "おお。だから、あなたがすることは、目を覚ますことです"}, {"type": "subtitle", "time": 15580.71, "timestamp": "04:19:40", "text": "上へ、私を信じて、そして戻る"}, {"type": "subtitle", "time": 15582.99, "timestamp": "04:19:42", "text": "眠る。"}, {"type": "subtitle", "time": 15586.309, "timestamp": "04:19:46", "text": "ニース。そして洞窟は実際にはエレクトラ"}, {"type": "subtitle", "time": 15589.03, "timestamp": "04:19:49", "text": "洞窟との組み合わせが本当に素敵だ。"}, {"type": "subtitle", "time": 15592.309, "timestamp": "04:19:52", "text": "これは標準機能です。"}, {"type": "subtitle", "time": 15595.189, "timestamp": "04:19:55", "text": "えっと、マントは何？うん。うん。うん。それ"}, {"type": "subtitle", "time": 15599.03, "timestamp": "04:19:59", "text": "ネイティブです。それは本来の姿です。おお。ジョー、"}]
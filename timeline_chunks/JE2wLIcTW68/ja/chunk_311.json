[{"type": "subtitle", "time": 18663.11, "timestamp": "05:11:03", "text": "ええ、そうですね。次はあなたの番です。やってみろ。私がやります。"}, {"type": "subtitle", "time": 18666.59, "timestamp": "05:11:06", "text": "私はあなたを裁く。今、あなたを裁きます。"}, {"type": "subtitle", "time": 18668.51, "timestamp": "05:11:08", "text": "わかった。"}, {"type": "subtitle", "time": 18672.31, "timestamp": "05:11:12", "text": "おい。わかった。えっと、何を学びたいですか？"}, {"type": "subtitle", "time": 18676.07, "timestamp": "05:11:16", "text": "パンジャブ語の仕事？あなたは何かを持っている。"}, {"type": "subtitle", "time": 18677.868, "timestamp": "05:11:17", "text": "私はただ"}, {"type": "subtitle", "time": 18679.788, "timestamp": "05:11:19", "text": "こんにちは"}, {"type": "subtitle", "time": 18687.91, "timestamp": "05:11:27", "text": "えっと、兄弟、問題は、私は"}, {"type": "subtitle", "time": 18689.19, "timestamp": "05:11:29", "text": "非常に悪いことです。なぜなら私は両方を知っているからです。"}, {"type": "subtitle", "time": 18692.07, "timestamp": "05:11:32", "text": "言語：ハラニ語、パンジャブ語。だから"}, {"type": "subtitle", "time": 18694.39, "timestamp": "05:11:34", "text": "私は他のことを混ぜて話している"}, {"type": "subtitle", "time": 18701.99, "timestamp": "05:11:41", "text": "わかった。ああ。ああ。だから私の両方とも"}, {"type": "subtitle", "time": 18704.91, "timestamp": "05:11:44", "text": "言語はめちゃくちゃだ。"}, {"type": "subtitle", "time": 18708.67, "timestamp": "05:11:48", "text": "うん。同じ。私は知らない"}, {"type": "subtitle", "time": 18712.23, "timestamp": "05:11:52", "text": "言語。私には、ただ分からないんです。私は混ぜます"}, {"type": "subtitle", "time": 18714.868, "timestamp": "05:11:54", "text": "すべての言語を話します"}]
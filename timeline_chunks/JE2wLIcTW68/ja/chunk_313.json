[{"type": "subtitle", "time": 18781.11, "timestamp": "05:13:01", "text": "私たちが彼らを探し出そうとしていることが素晴らしいと思います。私"}, {"type": "subtitle", "time": 18789.75, "timestamp": "05:13:09", "text": "なぜゾンビの声が聞こえるのか？"}, {"type": "subtitle", "time": 18792.708, "timestamp": "05:13:12", "text": "ええ、それが理由です。見て、見て、見て、あぁ"}, {"type": "subtitle", "time": 18796.31, "timestamp": "05:13:16", "text": "右上に柱のようなものがある"}, {"type": "subtitle", "time": 18798.23, "timestamp": "05:13:18", "text": "城の入り口からすぐ。"}, {"type": "subtitle", "time": 18801.03, "timestamp": "05:13:21", "text": "ほら、風車みたいなものがあるでしょ。"}, {"type": "subtitle", "time": 18804.07, "timestamp": "05:13:24", "text": "うん。ああ、そこだ。わかった。わかった。"}, {"type": "subtitle", "time": 18806.868, "timestamp": "05:13:26", "text": "うん。ここに座りましょう。さらに"}, {"type": "subtitle", "time": 18809.23, "timestamp": "05:13:29", "text": "建てる、"}, {"type": "subtitle", "time": 18831.03, "timestamp": "05:13:51", "text": "知りませんでした。あなたが"}]
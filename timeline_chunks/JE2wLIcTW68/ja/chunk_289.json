[{"type": "subtitle", "time": 17341.75, "timestamp": "04:49:01", "text": "まるであの映画みたいだ。"}, {"type": "subtitle", "time": 17345.83, "timestamp": "04:49:05", "text": "うん。ええ、彼らにはできません。おお。"}, {"type": "subtitle", "time": 17347.35, "timestamp": "04:49:07", "text": "映画みたいだけど、"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "真実。え、何？これは何ですか？新しい"}, {"type": "subtitle", "time": 17353.67, "timestamp": "04:49:13", "text": "一種のゾンビ。私はあなたを殺します。うん、"}, {"type": "subtitle", "time": 17356.31, "timestamp": "04:49:16", "text": "それは"}, {"type": "subtitle", "time": 17358.31, "timestamp": "04:49:18", "text": "みんな、この世界は"}, {"type": "subtitle", "time": 17360.31, "timestamp": "04:49:20", "text": "不規則な。"}, {"type": "subtitle", "time": 17363.15, "timestamp": "04:49:23", "text": "死ね、死ね、"}, {"type": "subtitle", "time": 17366.47, "timestamp": "04:49:26", "text": "死ね、死ね。ここに来て。ここに来て。死ぬ、"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "死ぬ。なんてこった。ああ、なんてことだ。ああ、なんてことだ。吹いたの？"}, {"type": "subtitle", "time": 17374.15, "timestamp": "04:49:34", "text": "城の中に何かある？いや、いや。その"}, {"type": "subtitle", "time": 17377.59, "timestamp": "04:49:37", "text": "城の下。心配しないで。"}, {"type": "subtitle", "time": 17381.19, "timestamp": "04:49:41", "text": "どうやって降りればいいですか？私には境界線がない。"}, {"type": "subtitle", "time": 17382.55, "timestamp": "04:49:42", "text": "待って、待って、待って。トイレットペーパーで殴ってやる。 1つ"}, {"type": "subtitle", "time": 17384.628, "timestamp": "04:49:44", "text": "2番。 1秒。殺させてくれ"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "みんな。わかった。"}, {"type": "subtitle", "time": 17390.39, "timestamp": "04:49:50", "text": "城を爆破せよ。つまり、"}, {"type": "subtitle", "time": 17393.19, "timestamp": "04:49:53", "text": "そこには？"}, {"type": "subtitle", "time": 17395.51, "timestamp": "04:49:55", "text": "あなたはゲームに参加していません。待って。はい、"}, {"type": "subtitle", "time": 17399.11, "timestamp": "04:49:59", "text": "は。わかった。あなたはVC（バーチャルコミュニティ）には参加していません。わかった。私は"}]
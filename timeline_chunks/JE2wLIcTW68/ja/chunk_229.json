[{"type": "subtitle", "time": 13744.349, "timestamp": "03:49:04", "text": "ああ、なるほど。では、皆さんにこれを送ります"}, {"type": "subtitle", "time": 13748.389, "timestamp": "03:49:08", "text": "アリーナ。これ、見える？"}, {"type": "subtitle", "time": 13751.11, "timestamp": "03:49:11", "text": "え、何？クリックするだけです。それ"}, {"type": "subtitle", "time": 13765.87, "timestamp": "03:49:25", "text": "うん。"}, {"type": "subtitle", "time": 13768.95, "timestamp": "03:49:28", "text": "そして、これが重要な点です。ネザーですよね？"}, {"type": "subtitle", "time": 13780.229, "timestamp": "03:49:40", "text": "これ、マジでかっこいいじゃん。"}, {"type": "subtitle", "time": 13783.91, "timestamp": "03:49:43", "text": "うん。いいえ、そうではありません。"}, {"type": "subtitle", "time": 13786.55, "timestamp": "03:49:46", "text": "ここは俺の縄張りだぜ、兄弟。"}, {"type": "subtitle", "time": 13789.91, "timestamp": "03:49:49", "text": "私を見て。怖い。"}, {"type": "subtitle", "time": 13793.349, "timestamp": "03:49:53", "text": "きっといい感じだよ。それはどんな状況でもクールではない"}]
[{"type": "subtitle", "time": 5341.91, "timestamp": "01:29:01", "text": "自分。何てことだ。わかりました、私はただ"}, {"type": "subtitle", "time": 5350.79, "timestamp": "01:29:10", "text": "これ。よし、これでいい。彼は死ぬだろう、"}, {"type": "subtitle", "time": 5355.43, "timestamp": "01:29:15", "text": "カードには車が足りません"}, {"type": "subtitle", "time": 5357.11, "timestamp": "01:29:17", "text": "ルールにより、ポイントが残されています"}, {"type": "subtitle", "time": 5369.229, "timestamp": "01:29:29", "text": "ここ。これにいくら入ったか"}, {"type": "subtitle", "time": 5372.189, "timestamp": "01:29:32", "text": "[ __ ]？ 5,000。くそ"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "まあ、君は使わないと思うけど、"}, {"type": "subtitle", "time": 5392.47, "timestamp": "01:29:52", "text": "いいね。見ないで。見ないでください"}]
[{"type": "subtitle", "time": 14186.71, "timestamp": "03:56:26", "text": "何てことだ。見たよ。"}, {"type": "subtitle", "time": 14190.55, "timestamp": "03:56:30", "text": "えっと、左に止まって。私も何かを壊してしまいました。"}, {"type": "subtitle", "time": 14193.59, "timestamp": "03:56:33", "text": "それは私にとって何か意味のあることだったと思う。必要"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "それを再び見つけるために。"}, {"type": "subtitle", "time": 14203.51, "timestamp": "03:56:43", "text": "ああ、無理だよ。スライドは使えません"}, {"type": "subtitle", "time": 14212.389, "timestamp": "03:56:52", "text": "誰も見つからない。"}, {"type": "subtitle", "time": 14214.79, "timestamp": "03:56:54", "text": "ボスのところで再びスポーンできます"}, {"type": "subtitle", "time": 14218.87, "timestamp": "03:56:58", "text": "あ、待って。何？それは何ですか？"}]
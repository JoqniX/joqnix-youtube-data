[{"type": "subtitle", "time": 4560.47, "timestamp": "01:16:00", "text": "心配しないで。見ないで。大丈夫？"}, {"type": "subtitle", "time": 4563.91, "timestamp": "01:16:03", "text": "ああ、もう、すごく叫んじゃう。"}, {"type": "subtitle", "time": 4572.47, "timestamp": "01:16:12", "text": "大声で叫んでも構いません。あなたは"}, {"type": "subtitle", "time": 4575.669, "timestamp": "01:16:15", "text": "怖がってください。これは恐ろしいゲームだ。"}, {"type": "subtitle", "time": 4599.43, "timestamp": "01:16:39", "text": "ああ、生きてたんですね。"}, {"type": "subtitle", "time": 4602.229, "timestamp": "01:16:42", "text": "よし、私が君を助けてあげよう。 1つあります"}, {"type": "subtitle", "time": 4604.35, "timestamp": "01:16:44", "text": "もっと。えーと"}]
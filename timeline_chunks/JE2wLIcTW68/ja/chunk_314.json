[{"type": "subtitle", "time": 18846.43, "timestamp": "05:14:06", "text": "やめて、やめて、やめて。うん、ただ座って"}, {"type": "subtitle", "time": 18849.75, "timestamp": "05:14:09", "text": "それ。これに座ってください。うん。なぜ私たちは"}, {"type": "subtitle", "time": 18852.15, "timestamp": "05:14:12", "text": "ここに座っていますか？これは恐ろしい。何？これ"}, {"type": "subtitle", "time": 18874.788, "timestamp": "05:14:34", "text": "わかった。うん。私があなたに教えていたことは、"}, {"type": "subtitle", "time": 18885.11, "timestamp": "05:14:45", "text": "わかった。"}]
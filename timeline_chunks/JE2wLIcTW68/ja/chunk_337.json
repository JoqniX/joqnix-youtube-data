[{"type": "subtitle", "time": 20221.19, "timestamp": "05:37:01", "text": "くそ、私はそれが得意じゃないけど、その後は"}, {"type": "subtitle", "time": 20227.39, "timestamp": "05:37:07", "text": "それは実際には"}, {"type": "subtitle", "time": 20230.23, "timestamp": "05:37:10", "text": "ニース。私の記憶力はとても悪い。私はまだ"}, {"type": "subtitle", "time": 20232.868, "timestamp": "05:37:12", "text": "カタカナが読めません。私は読むことしかできません"}, {"type": "subtitle", "time": 20235.91, "timestamp": "05:37:15", "text": "ひらがな。ああ、とてもよくできる、できる"}, {"type": "subtitle", "time": 20237.75, "timestamp": "05:37:17", "text": "今すぐテーブルを作ってください。私はタイピングできます"}, {"type": "subtitle", "time": 20239.27, "timestamp": "05:37:19", "text": "すべて。"}]
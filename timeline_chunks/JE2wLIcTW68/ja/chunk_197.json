[{"type": "subtitle", "time": 11820.71, "timestamp": "03:17:00", "text": "ええ、チャットマラソンを開催します。"}, {"type": "subtitle", "time": 11824.269, "timestamp": "03:17:04", "text": "えっと、私、私。何てことだ。"}, {"type": "subtitle", "time": 11827.51, "timestamp": "03:17:07", "text": "クリーパー。えーっと、私は"}, {"type": "subtitle", "time": 11830.389, "timestamp": "03:17:10", "text": "新しいモデルのための資金を集めます。ええ、そうですね。"}, {"type": "subtitle", "time": 11836.389, "timestamp": "03:17:16", "text": "待って、購読する必要はありません。その"}, {"type": "subtitle", "time": 11843.07, "timestamp": "03:17:23", "text": "大丈夫。"}, {"type": "subtitle", "time": 11846.79, "timestamp": "03:17:26", "text": "ええ、でもあなたが何を望んでいるのか分かりません"}, {"type": "subtitle", "time": 11850.55, "timestamp": "03:17:30", "text": "得る。私には何か特別な特典はないの？"}, {"type": "subtitle", "time": 11853.349, "timestamp": "03:17:33", "text": "何がもらえるの？何てことだ。あなたは何を"}, {"type": "subtitle", "time": 11860.63, "timestamp": "03:17:40", "text": "ええと、今のところ何もありません。私"}, {"type": "subtitle", "time": 11863.469, "timestamp": "03:17:43", "text": "カスタムのものをやりたかった"}, {"type": "subtitle", "time": 11865.83, "timestamp": "03:17:45", "text": "壁紙カレンダー。そうすると、"}, {"type": "subtitle", "time": 11867.429, "timestamp": "03:17:47", "text": "そうしたら、私は購読します"}, {"type": "subtitle", "time": 11870.15, "timestamp": "03:17:50", "text": "彼ら。うん。"}, {"type": "subtitle", "time": 11872.469, "timestamp": "03:17:52", "text": "うん。新しいモデルを手に入れたら、"}]
[{"type": "subtitle", "time": 8221.589, "timestamp": "02:17:01", "text": "パラソーシャルリズムが何であるかを知るまで、そして"}, {"type": "subtitle", "time": 8223.27, "timestamp": "02:17:03", "text": "それまで"}, {"type": "subtitle", "time": 8225.11, "timestamp": "02:17:05", "text": "えっと、私は自分が"}, {"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "それを経験している。私はそうしなかった"}, {"type": "subtitle", "time": 8230.95, "timestamp": "02:17:10", "text": "知る。うん。友人が"}, {"type": "subtitle", "time": 8233.75, "timestamp": "02:17:13", "text": "私の夫が教えてくれた。ああ、これは"}, {"type": "subtitle", "time": 8237.429, "timestamp": "02:17:17", "text": "こういうありふれたことすべて。それから"}, {"type": "subtitle", "time": 8240.629, "timestamp": "02:17:20", "text": "Twitterでちょっとした騒ぎを見かけました。何てことだ。"}, {"type": "subtitle", "time": 8243.509, "timestamp": "02:17:23", "text": "VTuberのTwitterってマジでヤバいよ。毎"}, {"type": "subtitle", "time": 8246.11, "timestamp": "02:17:26", "text": "一度だけ。ドラマドラマ"}, {"type": "subtitle", "time": 8249.07, "timestamp": "02:17:29", "text": "ドラマ ドラマ ドラマ"}, {"type": "subtitle", "time": 8255.91, "timestamp": "02:17:35", "text": "それ。あなたは計画していますか、あなたは"}, {"type": "subtitle", "time": 8258.629, "timestamp": "02:17:38", "text": "あなたは将来有望なYouTuberですか、それとも"}, {"type": "subtitle", "time": 8261.75, "timestamp": "02:17:41", "text": "デビューに向けて準備しているみたいだね"}, {"type": "subtitle", "time": 8271.349, "timestamp": "02:17:51", "text": "すべて？明日の配信は"}]
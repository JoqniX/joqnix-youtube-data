[{"type": "subtitle", "time": 5406.87, "timestamp": "01:30:06", "text": "くそっ、なんてこった。"}, {"type": "subtitle", "time": 5410.79, "timestamp": "01:30:10", "text": "暑い中でも食事はできますか？イエス・キリスト。"}, {"type": "subtitle", "time": 5431.47, "timestamp": "01:30:31", "text": "ここ。おお、"}, {"type": "subtitle", "time": 5435.35, "timestamp": "01:30:35", "text": "うん。これで十分でしょう？"}, {"type": "subtitle", "time": 5445.11, "timestamp": "01:30:45", "text": "それで十分です。よし。君たちは"}, {"type": "subtitle", "time": 5446.27, "timestamp": "01:30:46", "text": "取得"}, {"type": "subtitle", "time": 5459.95, "timestamp": "01:30:59", "text": "言う。ああ、彼は"}]
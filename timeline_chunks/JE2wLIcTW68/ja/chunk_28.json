[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "ええ、だいたいそんなところです。"}, {"type": "subtitle", "time": 1684.63, "timestamp": "00:28:04", "text": "ああ、なんてことだ、爆発するぞ。犬は"}, {"type": "subtitle", "time": 1688.87, "timestamp": "00:28:08", "text": "死ぬのか？いや、いや、いや。私はそうは思わない。おい、"}, {"type": "subtitle", "time": 1691.83, "timestamp": "00:28:11", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 1693.909, "timestamp": "00:28:13", "text": "フォークが私たちのところに刺さると、それは砕け散ります"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "至る所に被害が出ている。"}, {"type": "subtitle", "time": 1699.269, "timestamp": "00:28:19", "text": "はい。よし、みんな準備はいいか。えっと、私たちを攻撃してください。"}, {"type": "subtitle", "time": 1702.31, "timestamp": "00:28:22", "text": "準備はいいですか？いや、いや、いや。ご連絡ください。あなたが行く"}, {"type": "subtitle", "time": 1703.909, "timestamp": "00:28:23", "text": "救急パックを取って持ってきて"}, {"type": "subtitle", "time": 1705.83, "timestamp": "00:28:25", "text": "船。"}, {"type": "subtitle", "time": 1708.87, "timestamp": "00:28:28", "text": "実際にやってみる。ちょっと待ってください。"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "じゃあ、大きい方をください。の"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "ハンター1。"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "ああ神様、"}, {"type": "subtitle", "time": 1724.63, "timestamp": "00:28:44", "text": "それ。さあ行こう。よし、船に乗って。"}, {"type": "subtitle", "time": 1727.029, "timestamp": "00:28:47", "text": "船に乗り込んで出発の準備をしよう"}, {"type": "subtitle", "time": 1734.549, "timestamp": "00:28:54", "text": "早く、早く。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "届きましたか？"}, {"type": "subtitle", "time": 1739.669, "timestamp": "00:28:59", "text": "待って。再装填中。"}]
[{"type": "subtitle", "time": 1441.11, "timestamp": "00:24:01", "text": "こっちの方がずっといいよ、兄弟。よし、"}, {"type": "subtitle", "time": 1443.99, "timestamp": "00:24:03", "text": "取り消してください。来て。"}, {"type": "subtitle", "time": 1445.35, "timestamp": "00:24:05", "text": "私は道を切り開くつもりです"}, {"type": "subtitle", "time": 1448.47, "timestamp": "00:24:08", "text": "だって、私のHPはたった1しかないんだから。それは違う"}, {"type": "subtitle", "time": 1469.51, "timestamp": "00:24:29", "text": "死んだ。いや。ああ、なんてことだ。何てことだ。それ"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "私たちはたくさんのお金を手に入れた。うん。すみません。"}, {"type": "subtitle", "time": 1480.549, "timestamp": "00:24:40", "text": "さあ行こう。もちろんさ。待って。ジョー。滞在する"}, {"type": "subtitle", "time": 1487.35, "timestamp": "00:24:47", "text": "何？それは何ですか？いいえ、ジャンプするとき、"}, {"type": "subtitle", "time": 1488.87, "timestamp": "00:24:48", "text": "走って、ジャンプして、誰かにぶつかって、"}, {"type": "subtitle", "time": 1491.43, "timestamp": "00:24:51", "text": "Qを押すと、タンブル発射のような動作をします。"}, {"type": "subtitle", "time": 1494.71, "timestamp": "00:24:54", "text": "それは本当に素晴らしいですね。うん、好きだよ"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "タンブル発射。 51歳くらいかな。面白いよね。"}, {"type": "subtitle", "time": 1499.51, "timestamp": "00:24:59", "text": "そして同時に、"}]
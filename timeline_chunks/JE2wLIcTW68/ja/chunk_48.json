[{"type": "subtitle", "time": 2886.109, "timestamp": "00:48:06", "text": "このシェービング"}, {"type": "subtitle", "time": 2888.39, "timestamp": "00:48:08", "text": "それ。落とさないでください。作らないで"}, {"type": "subtitle", "time": 2889.55, "timestamp": "00:48:09", "text": "秋。"}, {"type": "subtitle", "time": 2891.99, "timestamp": "00:48:11", "text": "はい。感動的だ。ああ、わかりました。わかった、"}, {"type": "subtitle", "time": 2893.47, "timestamp": "00:48:13", "text": "私たちは大丈夫です。だった"}, {"type": "chat", "time": 2894.145, "timestamp": "00:48:14", "author": "@Lilian-y1d4r", "avatar": "https://yt4.ggpht.com/ytr0i5Y4EE58Wz8h9uca0G-vK1kLwqiHtSKXrLPHsVOn_4eQj4wFnVbIdoCk5MXCJX0wMczxOw=s64-c-k-c0x00ffffff-no-rj", "message": "My name is pronounced (kl-eb)"}, {"type": "subtitle", "time": 2905.39, "timestamp": "00:48:25", "text": "ああ、ちょっと恥ずかしがり屋な感じ。"}, {"type": "subtitle", "time": 2910.47, "timestamp": "00:48:30", "text": "ああ。えっと、私の名前はラザ・Kです。"}, {"type": "subtitle", "time": 2914.63, "timestamp": "00:48:34", "text": "ケル・カルブ。わかったよ、ケル。わかった。"}, {"type": "subtitle", "time": 2919.349, "timestamp": "00:48:39", "text": "こんにちは、カル。配信へようこ​​そ。"}, {"type": "subtitle", "time": 2922.71, "timestamp": "00:48:42", "text": "お元気でお過ごしでしょうか。これは誰ですか？おお、"}, {"type": "subtitle", "time": 2927.03, "timestamp": "00:48:47", "text": "あれは彼女のお尻だ。わかった。どうしたの？"}]
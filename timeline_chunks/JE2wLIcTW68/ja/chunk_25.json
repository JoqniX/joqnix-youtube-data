[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "運が良ければ敵にダメージを与える。"}, {"type": "subtitle", "time": 1505.909, "timestamp": "00:25:05", "text": "うん。アップグレードしてください。勢い。さあ行こう。私たちは"}, {"type": "subtitle", "time": 1508.87, "timestamp": "00:25:08", "text": "タンブルロッジのアップグレード。もちろんさ。"}, {"type": "subtitle", "time": 1510.71, "timestamp": "00:25:10", "text": "さあ行こうぜ、相棒。十分な量があります"}, {"type": "subtitle", "time": 1512.549, "timestamp": "00:25:12", "text": "どれだけアップグレードできるか見てみましょう。"}, {"type": "subtitle", "time": 1515.19, "timestamp": "00:25:15", "text": "体力強化、筋力強化。 H"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "ドローンは存在しない。えっと、スプリントスプリント"}, {"type": "subtitle", "time": 1521.19, "timestamp": "00:25:21", "text": "スピードは良いが、多くの"}, {"type": "subtitle", "time": 1523.43, "timestamp": "00:25:23", "text": "まるでスタミナを消耗し始めるかのようだ"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "たくさん。体力を取ってください。範囲は良好です"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "物を手に入れるため、そしてそれを押すのが好きです"}, {"type": "subtitle", "time": 1530.63, "timestamp": "00:25:30", "text": "十分に遠く離れて。強さは今のためのものだ。"}, {"type": "subtitle", "time": 1533.909, "timestamp": "00:25:33", "text": "今は、今はただ力を蓄えてください。"}, {"type": "subtitle", "time": 1536.07, "timestamp": "00:25:36", "text": "彼は力強い一撃を食らう。"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "私も1つもらいます。うん。みんなそうじゃない"}, {"type": "subtitle", "time": 1542.95, "timestamp": "00:25:42", "text": "共有しました。誰もが自分なりのアップグレードを持っている。"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "待って、みんなはみんな"}, {"type": "subtitle", "time": 1547.909, "timestamp": "00:25:47", "text": "完全に健康ですか？私は100です。ええと、頭は"}, {"type": "subtitle", "time": 1550.75, "timestamp": "00:25:50", "text": "頭。えっと、"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "不具合。その不具合を知らないのですか？うん、"}, {"type": "subtitle", "time": 1554.11, "timestamp": "00:25:54", "text": "あなた"}, {"type": "subtitle", "time": 1556.549, "timestamp": "00:25:56", "text": "そんなに長くはプレイできない。あなたがすべきことは"}, {"type": "subtitle", "time": 1558.789, "timestamp": "00:25:58", "text": "ヘルスパックを手に取って"}]
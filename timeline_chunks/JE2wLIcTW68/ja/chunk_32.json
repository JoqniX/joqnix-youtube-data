[{"type": "subtitle", "time": 1922.87, "timestamp": "00:32:02", "text": "どう思いますか？ええ、それは普通のことです。"}, {"type": "subtitle", "time": 1925.269, "timestamp": "00:32:05", "text": "良いですね。なんてこった。それが"}, {"type": "subtitle", "time": 1929.509, "timestamp": "00:32:09", "text": "歩く。いやいや、環境音だよ。"}, {"type": "subtitle", "time": 1934.149, "timestamp": "00:32:14", "text": "それは間違いない。ここに鍵がかかっています。"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "その地域については以上だと思います。ああ、"}, {"type": "subtitle", "time": 1938.23, "timestamp": "00:32:18", "text": "ああ、何かが動いている。あ、待って。なぜ"}, {"type": "subtitle", "time": 1947.19, "timestamp": "00:32:27", "text": "そうそう。ええ、そうですね。"}, {"type": "subtitle", "time": 1953.909, "timestamp": "00:32:33", "text": "また、ここには大きな立方体があり、"}, {"type": "subtitle", "time": 1956.47, "timestamp": "00:32:36", "text": "すべてが必要です"}, {"type": "subtitle", "time": 1957.75, "timestamp": "00:32:37", "text": "私は、"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "2つ目。"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "わかった。全員が必要です、全員が必要です、または"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "アヒルを撃て。"}, {"type": "subtitle", "time": 1966.71, "timestamp": "00:32:46", "text": "アヒルに当てないように。あなたが何であれ"}, {"type": "subtitle", "time": 1968.389, "timestamp": "00:32:48", "text": "する。"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "飛びついてみろ。何てことだ。うん。つまり、彼は"}, {"type": "subtitle", "time": 1974.149, "timestamp": "00:32:54", "text": "飛び乗ることはできますが、ケースに当たれば、"}, {"type": "subtitle", "time": 1976.23, "timestamp": "00:32:56", "text": "えーと、これをカートに入れます、"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "今回は、そういうやり方で。カート。はい、それは"}, {"type": "subtitle", "time": 1979.909, "timestamp": "00:32:59", "text": "私たちの右側に。試してみましょう 試してみましょう"}]
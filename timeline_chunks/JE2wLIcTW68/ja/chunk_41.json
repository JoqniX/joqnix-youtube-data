[{"type": "subtitle", "time": 2461.589, "timestamp": "00:41:01", "text": "この薬、いくら飲んでも飽きない。ああ、"}, {"type": "subtitle", "time": 2464.829, "timestamp": "00:41:04", "text": "ああ、彼がその薬を手に入れたなんて。"}, {"type": "subtitle", "time": 2472.349, "timestamp": "00:41:12", "text": "うわ、うわ、うわ。おい"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "よぉ、見て"}, {"type": "subtitle", "time": 2482.55, "timestamp": "00:41:22", "text": "ええと、それはあなたに感情を抱かせます"}, {"type": "subtitle", "time": 2485.99, "timestamp": "00:41:25", "text": "その他。さあ、皆さん。みんな走って"}, {"type": "subtitle", "time": 2488.23, "timestamp": "00:41:28", "text": "船上で、あなたはロマンチックなことを言う。"}, {"type": "subtitle", "time": 2489.589, "timestamp": "00:41:29", "text": "待って、待って。みんな、みんな走って"}, {"type": "subtitle", "time": 2492.309, "timestamp": "00:41:32", "text": "船。私はそこにいます。ああ、とにかく走れ。"}, {"type": "subtitle", "time": 2493.839, "timestamp": "00:41:33", "text": "とにかく走れ。 みなさん、こんにちは。わかった。"}, {"type": "subtitle", "time": 2517.23, "timestamp": "00:41:57", "text": "待って。私は死んだのか？ごめん。"}]
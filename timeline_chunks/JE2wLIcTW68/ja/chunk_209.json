[{"type": "subtitle", "time": 12548.229, "timestamp": "03:29:08", "text": "ああ、わかった。戻ってくる。うん。関係ない"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "何度殺しても、"}, {"type": "subtitle", "time": 12551.389, "timestamp": "03:29:11", "text": "恋に落ちる。"}, {"type": "subtitle", "time": 12554.87, "timestamp": "03:29:14", "text": "ああ、こうしてあなたは神になったのですね。ああ、"}, {"type": "subtitle", "time": 12557.429, "timestamp": "03:29:17", "text": "神。いいえ、私はこうして神になったのではありません。"}, {"type": "subtitle", "time": 12559.75, "timestamp": "03:29:19", "text": "これが私が好きな理由の一つです"}, {"type": "subtitle", "time": 12562.95, "timestamp": "03:29:22", "text": "私のお気に入りの一つ。くそ。"}, {"type": "subtitle", "time": 12576.51, "timestamp": "03:29:36", "text": "これ。何"}, {"type": "subtitle", "time": 12581.03, "timestamp": "03:29:41", "text": "え？ハートは何個ありますか"}, {"type": "subtitle", "time": 12588.14, "timestamp": "03:29:48", "text": "世界？"}, {"type": "subtitle", "time": 12589.55, "timestamp": "03:29:49", "text": "[音楽]"}, {"type": "subtitle", "time": 12593.91, "timestamp": "03:29:53", "text": "おお。待って。だからもし私が"}, {"type": "subtitle", "time": 12597.469, "timestamp": "03:29:57", "text": "黄金のリンゴを食べる。わかった。"}]
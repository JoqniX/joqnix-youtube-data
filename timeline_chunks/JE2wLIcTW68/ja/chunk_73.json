[{"type": "subtitle", "time": 4381.149, "timestamp": "01:13:01", "text": "車？"}, {"type": "subtitle", "time": 4383.03, "timestamp": "01:13:03", "text": "イエス様、彼の首を持ち運ぶのはやめてください"}, {"type": "subtitle", "time": 4410.07, "timestamp": "01:13:30", "text": "これは、私が知っているように、大きなアイテムです。さあ"}, {"type": "subtitle", "time": 4412.63, "timestamp": "01:13:32", "text": "これを抽出場所に置いてください。私は、"}, {"type": "subtitle", "time": 4426.229, "timestamp": "01:13:46", "text": "よし、まだ無理やり押し込むのはやめよう。わかった、"}, {"type": "subtitle", "time": 4429.59, "timestamp": "01:13:49", "text": "このまま続けていきましょう。わかった、"}]
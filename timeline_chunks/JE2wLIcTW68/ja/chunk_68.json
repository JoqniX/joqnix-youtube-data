[{"type": "subtitle", "time": 4085.829, "timestamp": "01:08:05", "text": "何てことだ。最後に残るのは私だ。"}, {"type": "subtitle", "time": 4108.45, "timestamp": "01:08:28", "text": "ああ。ああ、くそ。"}, {"type": "subtitle", "time": 4118.99, "timestamp": "01:08:38", "text": "ああ。ああ。"}, {"type": "subtitle", "time": 4122.11, "timestamp": "01:08:42", "text": "おお。ああ。いいえ。"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "いいえ。ねえ、ジョー。平和だよ、相棒。平和。来て。"}, {"type": "subtitle", "time": 4128.55, "timestamp": "01:08:48", "text": "俺たちは平和のために生きなきゃいけないんだよ。うん。"}]
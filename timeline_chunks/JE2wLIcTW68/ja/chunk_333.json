[{"type": "subtitle", "time": 19994.91, "timestamp": "05:33:14", "text": "待って。まずこれを殺せ"}, {"type": "subtitle", "time": 19997.47, "timestamp": "05:33:17", "text": "もの。うん。わかった。その"}, {"type": "subtitle", "time": 20001.15, "timestamp": "05:33:21", "text": "去った。それは消え去ったわけではない。それはまだ"}, {"type": "subtitle", "time": 20006.27, "timestamp": "05:33:26", "text": "ここ。わかった。私はそれを殺した。おい。"}, {"type": "subtitle", "time": 20033.35, "timestamp": "05:33:53", "text": "あなたは私の鼻をくすぐったわ。理由がわからない"}, {"type": "subtitle", "time": 20035.99, "timestamp": "05:33:55", "text": "かわいいですね。"}, {"type": "subtitle", "time": 20038.07, "timestamp": "05:33:58", "text": "わからない。"}]
[{"type": "subtitle", "time": 1621.269, "timestamp": "00:27:01", "text": "そうそう。これが必要だ。それが必要だ。取る"}, {"type": "subtitle", "time": 1623.51, "timestamp": "00:27:03", "text": "それ。それは何ですか？ショックを買う"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "波動地雷。ああ、衝撃波は勘弁してくれ。ごめん。"}, {"type": "subtitle", "time": 1628.149, "timestamp": "00:27:08", "text": "地雷だと思った。いや、いや。"}, {"type": "subtitle", "time": 1631.43, "timestamp": "00:27:11", "text": "私は手榴弾を落とした。だから、私は推測する"}, {"type": "subtitle", "time": 1634.149, "timestamp": "00:27:14", "text": "そうそう。これです。これ。"}, {"type": "subtitle", "time": 1638.63, "timestamp": "00:27:18", "text": "ああ、わかりました。これはいくらですか？ 35. ということで、"}, {"type": "subtitle", "time": 1641.269, "timestamp": "00:27:21", "text": "私はタンブルロッジのアップグレード版を購入しました。"}, {"type": "subtitle", "time": 1644.31, "timestamp": "00:27:24", "text": "誰が筋力アップグレードを購入したのですか？"}, {"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "ジョーにあげるつもりだ。わかった。誰が"}, {"type": "subtitle", "time": 1649.909, "timestamp": "00:27:29", "text": "スタミナアップグレードを購入しましたか？自分。"}, {"type": "subtitle", "time": 1653.43, "timestamp": "00:27:33", "text": "では、航続距離のアップグレードを購入したのは誰ですか？"}, {"type": "subtitle", "time": 1657.51, "timestamp": "00:27:37", "text": "私はしませんでした。え、何？ジョック。あなただと思う"}, {"type": "subtitle", "time": 1659.51, "timestamp": "00:27:39", "text": "誤って拾ってしまった。いや、待って。いいえ、私は"}, {"type": "subtitle", "time": 1662.23, "timestamp": "00:27:42", "text": "力を要した。私は"}, {"type": "subtitle", "time": 1663.99, "timestamp": "00:27:43", "text": "強さ。"}, {"type": "subtitle", "time": 1665.99, "timestamp": "00:27:45", "text": "これです。"}, {"type": "subtitle", "time": 1669.35, "timestamp": "00:27:49", "text": "ああ、それは射程距離のことですね。なんてこった。"}, {"type": "subtitle", "time": 1673.43, "timestamp": "00:27:53", "text": "つまり、私たちはそれを購入できるということです。大丈夫。"}, {"type": "subtitle", "time": 1675.789, "timestamp": "00:27:55", "text": "ええ、そうです。すべて"}, {"type": "subtitle", "time": 1679.11, "timestamp": "00:27:59", "text": "右。それだけですか？"}]
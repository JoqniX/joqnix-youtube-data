[{"type": "subtitle", "time": 13323.429, "timestamp": "03:42:03", "text": "もう一度やらせてみよう。"}, {"type": "subtitle", "time": 13327.03, "timestamp": "03:42:07", "text": "あの音は何だ？ああ、それは"}, {"type": "subtitle", "time": 13329.19, "timestamp": "03:42:09", "text": "溶岩の中で。"}, {"type": "subtitle", "time": 13332.07, "timestamp": "03:42:12", "text": "あなたは溶岩の中にいる。私は王様です"}, {"type": "subtitle", "time": 13358.469, "timestamp": "03:42:38", "text": "ということで、ここで何かが得られます"}, {"type": "subtitle", "time": 13362.309, "timestamp": "03:42:42", "text": "ダイヤモンドよりも強い。金のネザライト。"}, {"type": "subtitle", "time": 13366.15, "timestamp": "03:42:46", "text": "うん。今、あなたにこの鎧をあげます。"}, {"type": "subtitle", "time": 13378.349, "timestamp": "03:42:58", "text": "機械。何てことだ。"}]
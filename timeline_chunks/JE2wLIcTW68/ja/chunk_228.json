[{"type": "subtitle", "time": 13689.51, "timestamp": "03:48:09", "text": "ネザーでベッドが使えない場合、どうすればいいでしょうか"}, {"type": "subtitle", "time": 13692.469, "timestamp": "03:48:12", "text": "チェックポイントとして何をしますか？"}, {"type": "subtitle", "time": 13695.03, "timestamp": "03:48:15", "text": "ええと、チェックポイントはありません。"}, {"type": "subtitle", "time": 13697.75, "timestamp": "03:48:17", "text": "何てことだ。死ぬんだ、死ぬんだ。あなたは死ぬ、"}, {"type": "subtitle", "time": 13699.87, "timestamp": "03:48:19", "text": "あなたは死ぬ。あなたは戻ってきます"}, {"type": "subtitle", "time": 13711.83, "timestamp": "03:48:31", "text": "でもここはひどい場所だ。"}, {"type": "subtitle", "time": 13713.67, "timestamp": "03:48:33", "text": "絶対に嫌だ。"}, {"type": "subtitle", "time": 13718.99, "timestamp": "03:48:38", "text": "神。ガントレット"}, {"type": "subtitle", "time": 13721.55, "timestamp": "03:48:41", "text": "アリーナ。私を"}]
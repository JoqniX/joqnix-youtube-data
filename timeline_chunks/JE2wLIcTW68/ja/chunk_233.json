[{"type": "subtitle", "time": 13982.15, "timestamp": "03:53:02", "text": "彼女が飛べるように創造力を発揮する。"}, {"type": "subtitle", "time": 13986.79, "timestamp": "03:53:06", "text": "ああ、それは怖い。よし、今からジャンプしよう"}, {"type": "subtitle", "time": 13995.349, "timestamp": "03:53:15", "text": "すでに。エンダードラゴン。"}, {"type": "subtitle", "time": 13997.389, "timestamp": "03:53:17", "text": "ああ、私の"}, {"type": "subtitle", "time": 14002.469, "timestamp": "03:53:22", "text": "シェーダー。すごくかっこいいですね。すごくかっこいい。"}, {"type": "subtitle", "time": 14004.95, "timestamp": "03:53:24", "text": "何もない。なぜ？"}, {"type": "subtitle", "time": 14007.03, "timestamp": "03:53:27", "text": "二段ジャンプをするべきでしょうか？ダブルジャンプと"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "さあ、飛んで来い。"}, {"type": "subtitle", "time": 14012.95, "timestamp": "03:53:32", "text": "みんな、知ってる？"}, {"type": "subtitle", "time": 14015.59, "timestamp": "03:53:35", "text": "画面共有をしたいです。私"}, {"type": "subtitle", "time": 14017.11, "timestamp": "03:53:37", "text": "画面共有したいです。それはとても"}, {"type": "subtitle", "time": 14021.349, "timestamp": "03:53:41", "text": "めちゃくちゃクール。ああ、そのグループ知ってるよね。"}, {"type": "subtitle", "time": 14026.83, "timestamp": "03:53:46", "text": "うん。"}]
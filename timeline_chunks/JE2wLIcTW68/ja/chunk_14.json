[{"type": "subtitle", "time": 842.639, "timestamp": "00:14:02", "text": "ジョーは老人にばったり出くわした。 待って、あの老人、盲目の男は"}, {"type": "subtitle", "time": 845.279, "timestamp": "00:14:05", "text": "待って、あの老人、盲目の男は 実際、最初のマップではかなり珍しい。"}, {"type": "subtitle", "time": 848.839, "timestamp": "00:14:08", "text": "実際、最初のマップではかなり珍しい。 何？"}, {"type": "subtitle", "time": 850.639, "timestamp": "00:14:10", "text": "何？ 私はジョークを扱っているのを見ました"}, {"type": "subtitle", "time": 853.68, "timestamp": "00:14:13", "text": "私はジョークを扱っているのを見ました カートと、どこからともなくあの男が現れた"}, {"type": "subtitle", "time": 856.48, "timestamp": "00:14:16", "text": "カートと、どこからともなくあの男が現れた ドアから出てきたら、彼は撃った"}, {"type": "subtitle", "time": 858.56, "timestamp": "00:14:18", "text": "ドアから出てきたら、彼は撃った マジで。"}, {"type": "subtitle", "time": 861.76, "timestamp": "00:14:21", "text": "マジで。 うん。"}, {"type": "subtitle", "time": 863.8389999999999, "timestamp": "00:14:23", "text": "うん。 そして君は負け犬の王様だ。"}, {"type": "subtitle", "time": 867.14, "timestamp": "00:14:27", "text": "そして君は負け犬の王様だ。 [音楽]"}, {"type": "subtitle", "time": 871.71, "timestamp": "00:14:31", "text": "よし、"}, {"type": "subtitle", "time": 875.67, "timestamp": "00:14:35", "text": "死ぬ。わかった、"}, {"type": "subtitle", "time": 887.67, "timestamp": "00:14:47", "text": "水分補給チェックをしましょう。"}, {"type": "subtitle", "time": 889.99, "timestamp": "00:14:49", "text": "ありがとう。"}, {"type": "subtitle", "time": 894.87, "timestamp": "00:14:54", "text": "私はあなたを飲む。おいおい、税務署員って何？誰が"}, {"type": "subtitle", "time": 897.949, "timestamp": "00:14:57", "text": "税務署員ですか？税務署は"}]
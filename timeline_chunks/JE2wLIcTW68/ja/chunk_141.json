[{"type": "subtitle", "time": 8461.349, "timestamp": "02:21:01", "text": "ライブ2D Discordに参加している場合、または"}, {"type": "subtitle", "time": 8463.51, "timestamp": "02:21:03", "text": "あなたはライブ2Dのチュートリアルを見ています"}, {"type": "subtitle", "time": 8465.51, "timestamp": "02:21:05", "text": "もの、"}, {"type": "subtitle", "time": 8469.11, "timestamp": "02:21:09", "text": "えーと、彼らは、ライブ2Dディスコードで彼らは"}, {"type": "subtitle", "time": 8472.95, "timestamp": "02:21:12", "text": "最近、新しいワークショップのようなものが始まりました"}, {"type": "subtitle", "time": 8476.15, "timestamp": "02:21:16", "text": "com ライブ2D初心者"}, {"type": "subtitle", "time": 8479.19, "timestamp": "02:21:19", "text": "チュートリアルシリーズみたいな感じ。"}, {"type": "subtitle", "time": 8481.51, "timestamp": "02:21:21", "text": "ライブ2Dの1つだと思う"}, {"type": "subtitle", "time": 8484.55, "timestamp": "02:21:24", "text": "リガークリエイターはボランティアで"}, {"type": "subtitle", "time": 8487.27, "timestamp": "02:21:27", "text": "自分たち自身に教えるように"}, {"type": "subtitle", "time": 8491.03, "timestamp": "02:21:31", "text": "えーと、えーと、チュートリアルやガイドを作成します"}, {"type": "subtitle", "time": 8494.71, "timestamp": "02:21:34", "text": "初心者は、やり方を知っていると思います"}, {"type": "subtitle", "time": 8498.27, "timestamp": "02:21:38", "text": "索具とか、その他諸々。"}, {"type": "subtitle", "time": 8500.71, "timestamp": "02:21:40", "text": "うん、そうするべきだよ。"}, {"type": "subtitle", "time": 8505.429, "timestamp": "02:21:45", "text": "えっと、私は何人か友達を作りました"}, {"type": "subtitle", "time": 8507.469, "timestamp": "02:21:47", "text": "ライフデューティーショー"}, {"type": "subtitle", "time": 8510.389, "timestamp": "02:21:50", "text": "最近、いくつか質問しなければならなかったので"}, {"type": "subtitle", "time": 8512.79, "timestamp": "02:21:52", "text": "私のモデル関連のアドバイスやその他"}, {"type": "subtitle", "time": 8515.03, "timestamp": "02:21:55", "text": "現在開発中です。"}, {"type": "subtitle", "time": 8517.03, "timestamp": "02:21:57", "text": "えっと、気づいたんだけど"}, {"type": "subtitle", "time": 8519.389, "timestamp": "02:21:59", "text": "仕事中はいつでも"}]
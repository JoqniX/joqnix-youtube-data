[{"type": "subtitle", "time": 7381.47, "timestamp": "02:03:01", "text": "パネル。実際にやらせてください"}, {"type": "subtitle", "time": 7385.91, "timestamp": "02:03:05", "text": "素早い。押す。押す。見たくない。"}, {"type": "subtitle", "time": 7387.99, "timestamp": "02:03:07", "text": "ああ、このペンはまだ持ってるよ。あ、待って。"}, {"type": "subtitle", "time": 7391.83, "timestamp": "02:03:11", "text": "我慢する。これを固定解除させてください。ごめん。えっと、"}, {"type": "subtitle", "time": 7394.629, "timestamp": "02:03:14", "text": "私たちはいくつかのことを変える必要があります。"}, {"type": "subtitle", "time": 7397.109, "timestamp": "02:03:17", "text": "として"}, {"type": "subtitle", "time": 7400.589, "timestamp": "02:03:20", "text": "ええと、例えば"}, {"type": "subtitle", "time": 7403.35, "timestamp": "02:03:23", "text": "えっと、コーヒーをご馳走してくれるリンクですよね？それ"}, {"type": "subtitle", "time": 7405.39, "timestamp": "02:03:25", "text": "インドでは使えません。"}, {"type": "subtitle", "time": 7408.99, "timestamp": "02:03:28", "text": "だから、Stripeはブーだから"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "なぜ私にコーヒーをおごってくれるの？削除する必要があります"}, {"type": "subtitle", "time": 7430.83, "timestamp": "02:03:50", "text": "まばたきする。時々、私は"}, {"type": "subtitle", "time": 7434.589, "timestamp": "02:03:54", "text": "ジョアソンのやつを着る"}, {"type": "subtitle", "time": 7436.669, "timestamp": "02:03:56", "text": "トップ"}, {"type": "subtitle", "time": 7439.629, "timestamp": "02:03:59", "text": "始まりは"}]
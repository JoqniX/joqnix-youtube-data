[{"type": "subtitle", "time": 12180.91, "timestamp": "03:23:00", "text": "召喚されるべきである。それが唯一の"}, {"type": "subtitle", "time": 12183.67, "timestamp": "03:23:03", "text": "プラン。そして、あなたたちができなかったとき"}, {"type": "subtitle", "time": 12187.11, "timestamp": "03:23:07", "text": "あの２人を殺すんだろ？私は好きです"}, {"type": "subtitle", "time": 12191.19, "timestamp": "03:23:11", "text": "私のモッドにそれを殺せとささやいたが、"}, {"type": "subtitle", "time": 12193.67, "timestamp": "03:23:13", "text": "彼らの誰もそれを殺せなかった。そして私はそうしない"}, {"type": "subtitle", "time": 12195.429, "timestamp": "03:23:15", "text": "誰がそれを再び生成したのかを知り、"}, {"type": "subtitle", "time": 12198.63, "timestamp": "03:23:18", "text": "また。私ではありません。"}, {"type": "subtitle", "time": 12200.79, "timestamp": "03:23:20", "text": "何？"}, {"type": "subtitle", "time": 12202.87, "timestamp": "03:23:22", "text": "どうやらそれは計画されていなかったようだ"}, {"type": "subtitle", "time": 12205.269, "timestamp": "03:23:25", "text": "ネザーガントレットがたくさん。"}, {"type": "subtitle", "time": 12209.71, "timestamp": "03:23:29", "text": "泡立つ。陽気なのは誰？待って。これですか"}, {"type": "subtitle", "time": 12214.15, "timestamp": "03:23:34", "text": "これは一体何ですか？泡立つ。あ、待って。おお、"}, {"type": "subtitle", "time": 12215.99, "timestamp": "03:23:35", "text": "ごめん。ごめん。ごめん。ごめん。ごめん。"}, {"type": "subtitle", "time": 12218.15, "timestamp": "03:23:38", "text": "バブリーのダイヤモンド。ごめん。ごめん。"}, {"type": "subtitle", "time": 12221.83, "timestamp": "03:23:41", "text": "ごめん。それをクリックしてください。いやいや。それを受け取って。取る"}, {"type": "subtitle", "time": 12223.75, "timestamp": "03:23:43", "text": "それ。ごめん。ごめん。泡立つ。アイテムを保管する"}, {"type": "subtitle", "time": 12226.95, "timestamp": "03:23:46", "text": "あなたがそれを与えるのです。おお。"}, {"type": "subtitle", "time": 12230.55, "timestamp": "03:23:50", "text": "それは手強いゴーレムだ。待って。なんてこった。その"}, {"type": "subtitle", "time": 12232.79, "timestamp": "03:23:52", "text": "なんてこった。そのポジション。それは戻ってくるだろう"}, {"type": "subtitle", "time": 12235.269, "timestamp": "03:23:55", "text": "その場所へ。それは戻ってくるだろう。それは"}, {"type": "subtitle", "time": 12237.59, "timestamp": "03:23:57", "text": "バニラ味。"}]
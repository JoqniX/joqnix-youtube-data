[{"type": "subtitle", "time": 2240.23, "timestamp": "00:37:20", "text": "ああ、気にしないで。"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "車はどこですか？"}, {"type": "subtitle", "time": 2243.79, "timestamp": "00:37:23", "text": "真っ直ぐ"}, {"type": "subtitle", "time": 2247.31, "timestamp": "00:37:27", "text": "先に。まっすぐ、まっすぐ、"}, {"type": "subtitle", "time": 2249.79, "timestamp": "00:37:29", "text": "真っ直ぐ。よし、"}, {"type": "subtitle", "time": 2253.349, "timestamp": "00:37:33", "text": "えっと、商品を入れましょうか？えっと、"}, {"type": "subtitle", "time": 2256.47, "timestamp": "00:37:36", "text": "それだけ？しかし、まだまだ続くでしょう。"}, {"type": "subtitle", "time": 2257.829, "timestamp": "00:37:37", "text": "ええと、もっとあると思いますが、"}, {"type": "subtitle", "time": 2260.15, "timestamp": "00:37:40", "text": "他にもできることがあるよね？それで、"}, {"type": "subtitle", "time": 2264.39, "timestamp": "00:37:44", "text": "入れろ。入れろ。入れろ。"}, {"type": "subtitle", "time": 2271.75, "timestamp": "00:37:51", "text": "ええ、それは全く見当違いですね。少し与えてください"}, {"type": "subtitle", "time": 2273.71, "timestamp": "00:37:53", "text": "助ける"}, {"type": "subtitle", "time": 2277.19, "timestamp": "00:37:57", "text": "ゆりかご。うん。"}, {"type": "subtitle", "time": 2279.67, "timestamp": "00:37:59", "text": "はい、これでいいでしょう。彼がそこにいる。彼にあげて"}]
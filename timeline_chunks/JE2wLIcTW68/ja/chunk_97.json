[{"type": "subtitle", "time": 5822.709, "timestamp": "01:37:02", "text": "バイバイ。ああ、神様。バイバイ。バイバイ。あなたも"}, {"type": "subtitle", "time": 5825.03, "timestamp": "01:37:05", "text": "わかった。うん、そう思うよ"}, {"type": "subtitle", "time": 5827.75, "timestamp": "01:37:07", "text": "終わりも同様です。ああ、楽しい時間を過ごしている。"}, {"type": "subtitle", "time": 5830.07, "timestamp": "01:37:10", "text": "こんにちは。いやあ、楽しかったよ。ええ、それは"}, {"type": "subtitle", "time": 5832.39, "timestamp": "01:37:12", "text": "本当に楽しかった。"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "また後で。こんにちは。"}, {"type": "subtitle", "time": 5839.75, "timestamp": "01:37:19", "text": "また後で。話す。おやすみ。"}, {"type": "subtitle", "time": 5843.27, "timestamp": "01:37:23", "text": "おやすみ。おやすみ。えっと、それはすぐに"}, {"type": "subtitle", "time": 5846.27, "timestamp": "01:37:26", "text": "ゲームですよね？はい、結構です"}, {"type": "subtitle", "time": 5852.03, "timestamp": "01:37:32", "text": "それは"}, {"type": "subtitle", "time": 5859.47, "timestamp": "01:37:39", "text": "全て"}, {"type": "subtitle", "time": 5862.83, "timestamp": "01:37:42", "text": "はい、皆さんが楽しんでくれるといいな。"}, {"type": "subtitle", "time": 5866.91, "timestamp": "01:37:46", "text": "リポジトリ。ああ、なんてことだ、私は叫んだんだ、だから"}, {"type": "subtitle", "time": 5871.709, "timestamp": "01:37:51", "text": "多くの。なぜ私はこんなに弱いのか"}, {"type": "subtitle", "time": 5875.189, "timestamp": "01:37:55", "text": "ホラー？うん。なぜ私はこんなに弱いのか"}]
[{"type": "subtitle", "time": 4920.75, "timestamp": "01:22:00", "text": "その"}, {"type": "subtitle", "time": 4923.39, "timestamp": "01:22:03", "text": "ちょっと待って。私は暇です"}, {"type": "subtitle", "time": 4930.47, "timestamp": "01:22:10", "text": "あなた。今回は本当に私じゃないんです。私"}, {"type": "subtitle", "time": 4933.189, "timestamp": "01:22:13", "text": "私はあなたに約束します"}, {"type": "subtitle", "time": 4935.83, "timestamp": "01:22:15", "text": "やり方。"}, {"type": "subtitle", "time": 4940.07, "timestamp": "01:22:20", "text": "おお。やあ、ルゴ。あなたの好きなもの。"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "おお、"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "買います。"}, {"type": "subtitle", "time": 4946.229, "timestamp": "01:22:26", "text": "また、改めて申し訳ないのですが、"}, {"type": "subtitle", "time": 4949.11, "timestamp": "01:22:29", "text": "補体。"}, {"type": "subtitle", "time": 4950.629, "timestamp": "01:22:30", "text": "いや、面白いよ、兄弟。さあ、やってみよう"}, {"type": "subtitle", "time": 4955.75, "timestamp": "01:22:35", "text": "これは一体何ですか？まさにストレートな"}, {"type": "subtitle", "time": 4959.07, "timestamp": "01:22:39", "text": "手榴弾。ええ、3を押すだけです"}, {"type": "subtitle", "time": 4962.229, "timestamp": "01:22:42", "text": "3回目が始まります"}, {"type": "subtitle", "time": 4965.22, "timestamp": "01:22:45", "text": "作る"}, {"type": "subtitle", "time": 4978.39, "timestamp": "01:22:58", "text": "ああ、後ろに何かある。そうそう。"}]
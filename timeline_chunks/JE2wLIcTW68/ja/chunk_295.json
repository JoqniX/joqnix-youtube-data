[{"type": "subtitle", "time": 17708.41, "timestamp": "04:55:08", "text": "わかった。"}, {"type": "subtitle", "time": 17714.868, "timestamp": "04:55:14", "text": "あのね？私は歌を習っています。"}, {"type": "subtitle", "time": 17717.27, "timestamp": "04:55:17", "text": "兄弟。"}, {"type": "subtitle", "time": 17720.23, "timestamp": "04:55:20", "text": "ああ、お手伝いできますよ。私は古典を学びました"}, {"type": "subtitle", "time": 17723.11, "timestamp": "04:55:23", "text": "2つくらいの制作。ええ、私は"}, {"type": "subtitle", "time": 17725.75, "timestamp": "04:55:25", "text": "音楽制作も手がけた。私はやり方を知っています"}, {"type": "subtitle", "time": 17731.35, "timestamp": "04:55:31", "text": "FL Studio を使って、え、何？本当に？"}, {"type": "subtitle", "time": 17736.03, "timestamp": "04:55:36", "text": "うん。何？私はカラオケができます。"}, {"type": "subtitle", "time": 17740.708, "timestamp": "04:55:40", "text": "いやあ、すごい。天才的だ。"}, {"type": "subtitle", "time": 17745.51, "timestamp": "04:55:45", "text": "私はAbleton Liveでそれを学んでいます。"}, {"type": "subtitle", "time": 17749.75, "timestamp": "04:55:49", "text": "そうそう。それはいいです。君ならできるよ。"}, {"type": "subtitle", "time": 17752.39, "timestamp": "04:55:52", "text": "おお。以前はそれを習っていました。私は以前は"}, {"type": "subtitle", "time": 17756.31, "timestamp": "04:55:56", "text": "授業はあったがロックダウンが起こり、"}, {"type": "subtitle", "time": 17758.31, "timestamp": "04:55:58", "text": "証明書は取得できなかったが"}]
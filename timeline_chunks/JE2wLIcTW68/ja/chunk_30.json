[{"type": "subtitle", "time": 1802.149, "timestamp": "00:30:02", "text": "この車の中で。カートに乗ってください。"}, {"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "はい、"}, {"type": "subtitle", "time": 1805.83, "timestamp": "00:30:05", "text": "ただ聞いてください。お店で言ってたんだけど"}, {"type": "subtitle", "time": 1808.47, "timestamp": "00:30:08", "text": "羽根のドローンがいる。電話しています"}, {"type": "subtitle", "time": 1811.269, "timestamp": "00:30:11", "text": "先に予約しておきます。誰かこれを手伝ってくれないか"}, {"type": "subtitle", "time": 1814.07, "timestamp": "00:30:14", "text": "ここ。"}, {"type": "subtitle", "time": 1816.31, "timestamp": "00:30:16", "text": "私たちを助けてください。そう、これは物理学だということを忘れないで。"}, {"type": "subtitle", "time": 1818.31, "timestamp": "00:30:18", "text": "基づいています。それはまた、どのような"}, {"type": "subtitle", "time": 1819.909, "timestamp": "00:30:19", "text": "いや、いや、入れないで。いやいや、"}, {"type": "subtitle", "time": 1821.99, "timestamp": "00:30:21", "text": "抽出する。ああ、抽出液のままにしておいてね。"}, {"type": "subtitle", "time": 1825.75, "timestamp": "00:30:25", "text": "ええ、大きな品物はいつも抽出時に出てきます。"}, {"type": "subtitle", "time": 1828.389, "timestamp": "00:30:28", "text": "そして、それが超過している場合は、はい。そしてもしそれが"}, {"type": "subtitle", "time": 1830.47, "timestamp": "00:30:30", "text": "それを超えると、常にそれを維持するのが好きになります"}, {"type": "subtitle", "time": 1832.95, "timestamp": "00:30:32", "text": "その近くに。わかった。その物体を取り除けますか？"}, {"type": "subtitle", "time": 1835.75, "timestamp": "00:30:35", "text": "それとも、実際に待つべきだろうか？いいえ、できます。だった"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "良い。私たちは大丈夫です。わかった。いや、いや、いや。"}, {"type": "subtitle", "time": 1839.75, "timestamp": "00:30:39", "text": "私たちは待たない。わかった。復活させてくれ。持ってくる"}, {"type": "subtitle", "time": 1842.31, "timestamp": "00:30:42", "text": "それを返してください。ああ、神様。ああ、神様。ああ、神様。わかった。"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "わかった。大丈夫。大丈夫。立ち去る"}, {"type": "subtitle", "time": 1847.389, "timestamp": "00:30:47", "text": "そこに置いておく。いや、いや。えっと、ゴブリンの件は"}, {"type": "subtitle", "time": 1850.549, "timestamp": "00:30:50", "text": "えっと、ライター。だから、とにかく気をつけてください。なれ"}]
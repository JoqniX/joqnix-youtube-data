[{"type": "subtitle", "time": 1393.51, "timestamp": "00:23:13", "text": "わかった。結婚したいですか？"}, {"type": "subtitle", "time": 1396.029, "timestamp": "00:23:16", "text": "指輪をはめて"}, {"type": "subtitle", "time": 1398.669, "timestamp": "00:23:18", "text": "指。ウィズ。"}, {"type": "subtitle", "time": 1403.789, "timestamp": "00:23:23", "text": "おい、Qは君を11歳くらいに見せるよ。何だって？わーい。おお、"}, {"type": "subtitle", "time": 1405.75, "timestamp": "00:23:25", "text": "うん。よし。ああ、たくさんあるよ"}, {"type": "subtitle", "time": 1407.43, "timestamp": "00:23:27", "text": "そこには。ええ、他にもたくさんあります"}, {"type": "subtitle", "time": 1409.59, "timestamp": "00:23:29", "text": "あそこの冷蔵庫。まるで"}, {"type": "subtitle", "time": 1410.95, "timestamp": "00:23:30", "text": "中には小さなテディベアも入っていました。"}, {"type": "subtitle", "time": 1412.51, "timestamp": "00:23:32", "text": "右？"}, {"type": "subtitle", "time": 1414.789, "timestamp": "00:23:34", "text": "はい、だいたいそんなところです。そして私たちは"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "持って行けばよかったと思う"}, {"type": "subtitle", "time": 1424.39, "timestamp": "00:23:44", "text": "手。いいえ、もう一つあります。"}, {"type": "subtitle", "time": 1425.71, "timestamp": "00:23:45", "text": "ああ、あと1つだけ"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "アイテム。よし、君ならできる。私は信じます"}, {"type": "subtitle", "time": 1430.789, "timestamp": "00:23:50", "text": "あなた"}, {"type": "subtitle", "time": 1439.59, "timestamp": "00:23:59", "text": "どうしたの？ああ、なんてこった。そうすることで"}]
[{"type": "subtitle", "time": 9793.63, "timestamp": "02:43:13", "text": "無限"}, {"type": "subtitle", "time": 9798.75, "timestamp": "02:43:18", "text": "鍵。彼女はマトスキンを持っている。"}, {"type": "subtitle", "time": 9802.15, "timestamp": "02:43:22", "text": "何？何てことだ。スキ、兄弟。したい"}, {"type": "subtitle", "time": 9804.91, "timestamp": "02:43:24", "text": "インフィニティをプレイ、"}, {"type": "subtitle", "time": 9806.07, "timestamp": "02:43:26", "text": "男。"}, {"type": "subtitle", "time": 9808.19, "timestamp": "02:43:28", "text": "[音楽]"}, {"type": "subtitle", "time": 9811.27, "timestamp": "02:43:31", "text": "うん。とにかく、スクロールは止めなきゃ。"}]
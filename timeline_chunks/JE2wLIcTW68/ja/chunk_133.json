[{"type": "subtitle", "time": 7983.189, "timestamp": "02:13:03", "text": "こんにちは、先ほどX2であなたをフォローしました。ああ、ありがとう"}, {"type": "subtitle", "time": 7985.3, "timestamp": "02:13:05", "text": "あなた。ありがとうございます"}, {"type": "subtitle", "time": 7992.069, "timestamp": "02:13:12", "text": "続く。今日はどうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 8008.709, "timestamp": "02:13:28", "text": "あなた？うん、メディア対応のスケジュールは良いね。"}, {"type": "subtitle", "time": 8012.39, "timestamp": "02:13:32", "text": "そう、ツイートする必要がある"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "えーっと、今日やったことの要約と"}, {"type": "subtitle", "time": 8017.629, "timestamp": "02:13:37", "text": "明日のスケジュールが必要です"}, {"type": "subtitle", "time": 8021.069, "timestamp": "02:13:41", "text": "ストリーム。実際にやらせてください"}, {"type": "subtitle", "time": 8023.95, "timestamp": "02:13:43", "text": "素早い。"}, {"type": "subtitle", "time": 8027.709, "timestamp": "02:13:47", "text": "明日。明日。明日。明日。"}, {"type": "subtitle", "time": 8032.9, "timestamp": "02:13:52", "text": "えっと"}, {"type": "subtitle", "time": 8035.229, "timestamp": "02:13:55", "text": "[音楽]"}, {"type": "subtitle", "time": 8039.069, "timestamp": "02:13:59", "text": "明日。えっと、今ストリームに参加しました"}]
[{"type": "subtitle", "time": 302.71, "timestamp": "00:05:02", "text": "私たちには美しくて素晴らしい友達がいます"}, {"type": "subtitle", "time": 306.55, "timestamp": "00:05:06", "text": "私たちと一緒に、ジョックとクトも一緒です。挨拶したり、おしゃべりしたりしましょう。"}, {"type": "subtitle", "time": 309.27, "timestamp": "00:05:09", "text": "ただの友達二人。いいね。"}, {"type": "subtitle", "time": 312.55, "timestamp": "00:05:12", "text": "どういう意味ですか？あなたたちは友達ですよね。"}, {"type": "subtitle", "time": 314.469, "timestamp": "00:05:14", "text": "友達になりたくない。おお。おお。"}, {"type": "subtitle", "time": 318.55, "timestamp": "00:05:18", "text": "この男。このクソ野郎、マジで。"}, {"type": "subtitle", "time": 321.83, "timestamp": "00:05:21", "text": "ジョー、ゲームを作ったの？ええ、そうです。私はただ"}, {"type": "subtitle", "time": 325.07, "timestamp": "00:05:25", "text": "ゲームを作った"}, {"type": "subtitle", "time": 327.59, "timestamp": "00:05:27", "text": "私の読み込み中。"}, {"type": "subtitle", "time": 329.67, "timestamp": "00:05:29", "text": "おお、"}, {"type": "subtitle", "time": 333.43, "timestamp": "00:05:33", "text": "なぜロード中の音楽がこんなに"}, {"type": "subtitle", "time": 335.59000000000003, "timestamp": "00:05:35", "text": "快適だったのでミュートしなければならなかった"}, {"type": "subtitle", "time": 338.07, "timestamp": "00:05:38", "text": "気が散る。では、あなたを招待しましょう"}, {"type": "subtitle", "time": 340.469, "timestamp": "00:05:40", "text": "みんな。私は参加できると分かっています。"}, {"type": "subtitle", "time": 342.23, "timestamp": "00:05:42", "text": "彼を招待してみてはどうですか？わかった、行くよ"}, {"type": "subtitle", "time": 344.71, "timestamp": "00:05:44", "text": "Discordに参加する。"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "[音楽]"}, {"type": "subtitle", "time": 358.59000000000003, "timestamp": "00:05:58", "text": "ああ、Discordのことですか？ああ、わかりました。"}]
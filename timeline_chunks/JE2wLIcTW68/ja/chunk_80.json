[{"type": "subtitle", "time": 4804.95, "timestamp": "01:20:04", "text": "えっと、筋力アップグレードをすべきでしょうか？"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "自分自身？待って、ポケットカードも手に入るよ。"}, {"type": "subtitle", "time": 4809.43, "timestamp": "01:20:09", "text": "うん、筋力アップのアップグレードを受けるんだ。"}, {"type": "subtitle", "time": 4811.35, "timestamp": "01:20:11", "text": "私は力尽きて転倒しそうになっている。"}, {"type": "subtitle", "time": 4813.51, "timestamp": "01:20:13", "text": "道。"}, {"type": "subtitle", "time": 4816.91, "timestamp": "01:20:16", "text": "私はただ一つ手に入れるだけです"}, {"type": "subtitle", "time": 4820.55, "timestamp": "01:20:20", "text": "もっと。あなたは出来る"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "彼は今、その心構えができつつある。彼は"}, {"type": "subtitle", "time": 4825.189, "timestamp": "01:20:25", "text": "私の。わかった。ええ、私たちは大丈夫です。何が"}, {"type": "subtitle", "time": 4827.51, "timestamp": "01:20:27", "text": "今、そう言ったの？何？鉱山。あなたは"}, {"type": "subtitle", "time": 4832.47, "timestamp": "01:20:32", "text": "私の。わかった。わかった。ええと、お二人とも、お二人とも"}, {"type": "subtitle", "time": 4835.35, "timestamp": "01:20:35", "text": "大きな健康パックを選んだ場合。おお、"}, {"type": "subtitle", "time": 4837.27, "timestamp": "01:20:37", "text": "もちろんさ。わかった。誰かがすでに"}, {"type": "subtitle", "time": 4838.95, "timestamp": "01:20:38", "text": "中に1人。またか。実は、"}, {"type": "subtitle", "time": 4843.189, "timestamp": "01:20:43", "text": "あなたたち３人全員に必要です。私は無事です。"}, {"type": "subtitle", "time": 4844.87, "timestamp": "01:20:44", "text": "よし。よし。よし。保つ"}, {"type": "subtitle", "time": 4847.99, "timestamp": "01:20:47", "text": "それ。アップグレードしてください。"}, {"type": "subtitle", "time": 4849.669, "timestamp": "01:20:49", "text": "実際、私はバカなことを言うつもりです。"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "待って、待って、待って。私は"}, {"type": "subtitle", "time": 4855.87, "timestamp": "01:20:55", "text": "あなたには大きめのものを。心配しないで。"}, {"type": "subtitle", "time": 4859.35, "timestamp": "01:20:59", "text": "Hベイビー。"}]
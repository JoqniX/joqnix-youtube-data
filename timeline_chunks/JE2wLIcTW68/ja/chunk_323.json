[{"type": "subtitle", "time": 19380.628, "timestamp": "05:23:00", "text": "[音楽]"}, {"type": "subtitle", "time": 19408.15, "timestamp": "05:23:28", "text": "考える：うん、できるよ。"}, {"type": "subtitle", "time": 19410.15, "timestamp": "05:23:30", "text": "わかった。えっと"}, {"type": "subtitle", "time": 19421.19, "timestamp": "05:23:41", "text": "スピーキングはいい子だよ。シャーとは何ですか？私"}, {"type": "subtitle", "time": 19424.39, "timestamp": "05:23:44", "text": "彼は無実ではないと理解していると思う"}, {"type": "subtitle", "time": 19428.39, "timestamp": "05:23:48", "text": "世間知らずだ。ああ、無邪気だね。それから、あの物"}, {"type": "subtitle", "time": 19431.03, "timestamp": "05:23:51", "text": "彼はガキか何かの中にいる。生意気なガキじゃない"}, {"type": "subtitle", "time": 19434.948, "timestamp": "05:23:54", "text": "えーと、非行少年みたいな感じ。いいえ、何ですか"}, {"type": "subtitle", "time": 19438.07, "timestamp": "05:23:58", "text": "言葉？えっと、トラブルメーカーみたいな感じ。"}]
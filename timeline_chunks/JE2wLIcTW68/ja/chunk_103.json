[{"type": "subtitle", "time": 6205.79, "timestamp": "01:43:25", "text": "えっと、赤いシャワーはまだ見つかりません"}, {"type": "subtitle", "time": 6210.79, "timestamp": "01:43:30", "text": "彼らの音を発していた。それは"}, {"type": "subtitle", "time": 6222.27, "timestamp": "01:43:42", "text": "疲れた。それで"}, {"type": "subtitle", "time": 6226.86, "timestamp": "01:43:46", "text": "疲れた騎手。"}]
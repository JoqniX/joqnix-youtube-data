[{"type": "subtitle", "time": 18241.27, "timestamp": "05:04:01", "text": "ああ、ジョセフの息子のコンテンツは見たことがあるよ。その"}, {"type": "subtitle", "time": 18245.59, "timestamp": "05:04:05", "text": "彼のやり方、すごくかっこいい。うん。"}, {"type": "subtitle", "time": 18248.708, "timestamp": "05:04:08", "text": "彼はどうやって効果音を出しているの？"}, {"type": "subtitle", "time": 18253.99, "timestamp": "05:04:13", "text": "とかそういうの？どのような？分かりません。"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "状況による。彼は私に教えていた。彼は"}, {"type": "subtitle", "time": 18258.868, "timestamp": "05:04:18", "text": "教えてくれたけど、教えたことを忘れてしまった"}, {"type": "subtitle", "time": 18262.31, "timestamp": "05:04:22", "text": "自分。なんてこった。"}, {"type": "subtitle", "time": 18264.55, "timestamp": "05:04:24", "text": "負けました。待って、私たちは待つつもりだったんだ。私たちは"}, {"type": "subtitle", "time": 18276.948, "timestamp": "05:04:36", "text": "あのね？お城へ行こう。"}, {"type": "subtitle", "time": 18279.15, "timestamp": "05:04:39", "text": "座ってから"}]
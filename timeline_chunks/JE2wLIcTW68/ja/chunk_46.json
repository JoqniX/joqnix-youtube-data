[{"type": "subtitle", "time": 2769.87, "timestamp": "00:46:09", "text": "o.クリック。はい、私はHPの契約者です。さあ行こう。"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "スタミナ。えーと、マップのプレイヤー数と"}, {"type": "subtitle", "time": 2774.79, "timestamp": "00:46:14", "text": "健康。"}, {"type": "subtitle", "time": 2779.03, "timestamp": "00:46:19", "text": "手榴弾を1つだけ持ち歩いても大丈夫でしょうか？"}, {"type": "subtitle", "time": 2780.55, "timestamp": "00:46:20", "text": "うん、"}, {"type": "subtitle", "time": 2782.109, "timestamp": "00:46:22", "text": "私たちは殺すことができる"}, {"type": "subtitle", "time": 2789.27, "timestamp": "00:46:29", "text": "神。"}, {"type": "subtitle", "time": 2791.829, "timestamp": "00:46:31", "text": "頭のケツ。それは私が触ってもいないもの"}, {"type": "subtitle", "time": 2794.95, "timestamp": "00:46:34", "text": "それ。ケツってどういう意味？"}, {"type": "subtitle", "time": 2796.91, "timestamp": "00:46:36", "text": "私は触りもしなかった"}, {"type": "subtitle", "time": 2798.589, "timestamp": "00:46:38", "text": "それ"}, {"type": "subtitle", "time": 2810.71, "timestamp": "00:46:50", "text": "1つ。何てことだ。"}, {"type": "subtitle", "time": 2818.75, "timestamp": "00:46:58", "text": "私の睾丸をいじるのはやめてください。おお"}]
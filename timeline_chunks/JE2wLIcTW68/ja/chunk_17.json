[{"type": "subtitle", "time": 1020.269, "timestamp": "00:17:00", "text": "わかった。ニース。ああ、"}, {"type": "subtitle", "time": 1041.27, "timestamp": "00:17:21", "text": "しかし、敵も存在する。"}, {"type": "subtitle", "time": 1042.99, "timestamp": "00:17:22", "text": "さあ、みんな。私は"}, {"type": "subtitle", "time": 1046.87, "timestamp": "00:17:26", "text": "来るよ。では、その怪物とは一体誰なのか？"}, {"type": "subtitle", "time": 1049.35, "timestamp": "00:17:29", "text": "モンスターか何か。 100メートル走。我々はできる"}, {"type": "subtitle", "time": 1050.029, "timestamp": "00:17:30", "text": "ただ"}, {"type": "subtitle", "time": 1056.789, "timestamp": "00:17:36", "text": "あ、待って。これに触らないでください。触らないで"}, {"type": "subtitle", "time": 1059.35, "timestamp": "00:17:39", "text": "これ。わかった。触らないでください。なぜ？"}, {"type": "subtitle", "time": 1061.43, "timestamp": "00:17:41", "text": "実際は、いいえ。人形に触らないでください。その"}, {"type": "subtitle", "time": 1063.59, "timestamp": "00:17:43", "text": "怖い人形。カートに入れてこちらへ持ってきてください。"}, {"type": "subtitle", "time": 1066.15, "timestamp": "00:17:46", "text": "カートを持ってきてください。だめだ。だめだ。持ってこなくていい。"}, {"type": "subtitle", "time": 1068.95, "timestamp": "00:17:48", "text": "抽出液に直接塗布してください。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "うん。拾って、ジョー。来て。やってみろ。"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "うん、やってみてもいいよ、ジョー。うん。うん。する"}, {"type": "subtitle", "time": 1076.23, "timestamp": "00:17:56", "text": "拾い上げてください。来て。これです。それが私の"}, {"type": "subtitle", "time": 1078.83, "timestamp": "00:17:58", "text": "プラン。最悪。ああ、"}]
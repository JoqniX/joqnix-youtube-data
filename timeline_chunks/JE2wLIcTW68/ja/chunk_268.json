[{"type": "subtitle", "time": 16093.51, "timestamp": "04:28:13", "text": "パンジャブ語の歌。いつも本当に"}, {"type": "subtitle", "time": 16105.269, "timestamp": "04:28:25", "text": "うん。あ、すみません。あなたをミュートにしていたのを忘れていました。私"}, {"type": "subtitle", "time": 16107.429, "timestamp": "04:28:27", "text": "君たちは遊ぶつもりだと思ったよ"}, {"type": "subtitle", "time": 16110.95, "timestamp": "04:28:30", "text": "Discordでパンジャブ語の歌を聴こう。ああ、ミュートにしてたよ。"}, {"type": "subtitle", "time": 16114.149, "timestamp": "04:28:34", "text": "ええ、そうですね。えっと、"}, {"type": "subtitle", "time": 16118.389, "timestamp": "04:28:38", "text": "うん。ダンスに重点が置かれているんじゃないの？"}, {"type": "subtitle", "time": 16125.63, "timestamp": "04:28:45", "text": "大丈夫。"}, {"type": "subtitle", "time": 16129.269, "timestamp": "04:28:49", "text": "待って。あら、サテンダー・サッハって知ってる？私"}, {"type": "subtitle", "time": 16134.269, "timestamp": "04:28:54", "text": "それを知っておくべきだ。ああ、私は彼を愛している。私は彼の"}, {"type": "subtitle", "time": 16137.429, "timestamp": "04:28:57", "text": "歌。ウダリアを知っていますか？私のお気に入りです"}]
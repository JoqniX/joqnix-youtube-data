[{"type": "subtitle", "time": 16390.15, "timestamp": "04:33:10", "text": "待って、ネザーでは飛べるの？"}, {"type": "subtitle", "time": 16393.75, "timestamp": "04:33:13", "text": "あなたはできる。あなたは欲しい"}, {"type": "subtitle", "time": 16395.429, "timestamp": "04:33:15", "text": "ええ、でも障害が多すぎます"}, {"type": "subtitle", "time": 16397.67, "timestamp": "04:33:17", "text": "今。だから、"}, {"type": "subtitle", "time": 16402.869, "timestamp": "04:33:22", "text": "[音楽]"}, {"type": "subtitle", "time": 16406.709, "timestamp": "04:33:26", "text": "そんなことが可能だとは知りませんでした。"}, {"type": "subtitle", "time": 16409.109, "timestamp": "04:33:29", "text": "待って、待って。どこへ行くのですか？"}, {"type": "subtitle", "time": 16413.83, "timestamp": "04:33:33", "text": "行くの？私はただここにいるだけです。私は持っています"}, {"type": "chat", "time": 16419.586, "timestamp": "04:33:39", "author": "@Astro-9999", "avatar": "https://yt4.ggpht.com/I0atDf8aJGAiY3Z-U4COpBQFW4_qYnJ5GkhRqDK8dE_sjbhzV3NcVv5LuXD4hdY7IHeyOXW2OQ=s64-c-k-c0x00ffffff-no-rj", "message": "she singing so good but also you might get copyright (small chance)"}, {"type": "subtitle", "time": 16422.23, "timestamp": "04:33:42", "text": "ジョー。ジョーは死ぬだろう。来て。いいえ、私は持っています"}, {"type": "subtitle", "time": 16425.51, "timestamp": "04:33:45", "text": "即効性のある健康法を試してみた。"}, {"type": "subtitle", "time": 16428.789, "timestamp": "04:33:48", "text": "パワーを上げたのですか？"}, {"type": "subtitle", "time": 16432.47, "timestamp": "04:33:52", "text": "無限？うん。えっと、それからスペース。いいえ。"}, {"type": "subtitle", "time": 16434.39, "timestamp": "04:33:54", "text": "いや、そういう仕組みじゃないんです。もしあなたが"}, {"type": "subtitle", "time": 16436.709, "timestamp": "04:33:56", "text": "無限の後に再びスペースが必要"}, {"type": "subtitle", "time": 16438.47, "timestamp": "04:33:58", "text": "1から"}]
[{"type": "subtitle", "time": 17287.7, "timestamp": "04:48:07", "text": "彼は亡くなった"}, {"type": "subtitle", "time": 17288.99, "timestamp": "04:48:08", "text": "[音楽]"}, {"type": "subtitle", "time": 17291.99, "timestamp": "04:48:11", "text": "全体、それは何と呼ぶんだっけ？"}, {"type": "subtitle", "time": 17294.868, "timestamp": "04:48:14", "text": "彼の名前は何でしたっけ？"}, {"type": "subtitle", "time": 17297.83, "timestamp": "04:48:17", "text": "えっと、クリーパー"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "行くよ。たくさんあります。"}, {"type": "subtitle", "time": 17320.75, "timestamp": "04:48:40", "text": "来ないでください。来ないでください。しないで"}, {"type": "subtitle", "time": 17332.83, "timestamp": "04:48:52", "text": "右？私は彼らを殺す"}, {"type": "subtitle", "time": 17337.51, "timestamp": "04:48:57", "text": "全て。ゾンビ。待って。クモは乗ることができる。いいえ。"}, {"type": "subtitle", "time": 17339.59, "timestamp": "04:48:59", "text": "骸骨も乗れる。スパイダー。何だって？"}]
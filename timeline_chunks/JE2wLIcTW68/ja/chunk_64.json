[{"type": "subtitle", "time": 3841.349, "timestamp": "01:04:01", "text": "下から持ち上げるだけでいいんです。誰か"}, {"type": "subtitle", "time": 3843.51, "timestamp": "01:04:03", "text": "所有。"}, {"type": "subtitle", "time": 3847.91, "timestamp": "01:04:07", "text": "はい、どうぞ。誰か。うん。わかった。あまりにも"}, {"type": "subtitle", "time": 3849.91, "timestamp": "01:04:09", "text": "多くの。過度に。過度に。過度に。"}, {"type": "subtitle", "time": 3854.549, "timestamp": "01:04:14", "text": "わかった。わかった。わかった。準備ができて。ええと、いいえ、"}, {"type": "subtitle", "time": 3863.109, "timestamp": "01:04:23", "text": "わかった。停止。停止。停止。完璧。おお、"}, {"type": "subtitle", "time": 3864.87, "timestamp": "01:04:24", "text": "わかった。いいえ。それはクリッピングがありません"}, {"type": "subtitle", "time": 3868.549, "timestamp": "01:04:28", "text": "異なるキー。ええと、これです。これ。わかった。"}, {"type": "subtitle", "time": 3870.309, "timestamp": "01:04:30", "text": "ええと、そのカードは取っておいてください。いや、いや、いや。保つ"}, {"type": "subtitle", "time": 3872.39, "timestamp": "01:04:32", "text": "裏面にカードがあります。わかった。これを引っ張る"}, {"type": "subtitle", "time": 3874.789, "timestamp": "01:04:34", "text": "入れる。これを引っ張るよ。人々はこれを推す"}, {"type": "subtitle", "time": 3879.349, "timestamp": "01:04:39", "text": "内部。わかった。準備ができて？皆さん、準備はいいですか？行く。"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "ドロドロ。押す。押す。誰か手伝ってくれ"}, {"type": "subtitle", "time": 3884.15, "timestamp": "01:04:44", "text": "このCPU。うん、私はやるよ"}, {"type": "subtitle", "time": 3887.51, "timestamp": "01:04:47", "text": "私がカットします。最悪だ。カードを実行してください。する"}, {"type": "subtitle", "time": 3888.27, "timestamp": "01:04:48", "text": "の"}, {"type": "subtitle", "time": 3892.789, "timestamp": "01:04:52", "text": "カード。えっと、そこから逃げ出すんだ。"}, {"type": "subtitle", "time": 3894.309, "timestamp": "01:04:54", "text": "いいえ、アングルです。角度をつけて。角度をつけて。"}, {"type": "subtitle", "time": 3895.51, "timestamp": "01:04:55", "text": "角度をつけて。心配しないで。心配しないで。"}, {"type": "subtitle", "time": 3896.789, "timestamp": "01:04:56", "text": "心配しないで。いいえ。壊れます。"}, {"type": "subtitle", "time": 3898.71, "timestamp": "01:04:58", "text": "兄弟。"}]
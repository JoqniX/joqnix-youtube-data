[{"type": "subtitle", "time": 5529.99, "timestamp": "01:32:09", "text": "おお、いいね。こちらにはテレビがありますよ。それで、"}, {"type": "subtitle", "time": 5533.03, "timestamp": "01:32:13", "text": "私は「一緒にやってみよう」という企画に取り組んでいます。"}, {"type": "subtitle", "time": 5537.07, "timestamp": "01:32:17", "text": "こちらにテレビと3つの物があります。"}, {"type": "subtitle", "time": 5549.43, "timestamp": "01:32:29", "text": "わかった。いや、いや。 3ドア。はい。"}, {"type": "subtitle", "time": 5551.43, "timestamp": "01:32:31", "text": "移動中に突き攻撃を使うことができます"}, {"type": "subtitle", "time": 5554.629, "timestamp": "01:32:34", "text": "逆向きに。私は知らない、"}, {"type": "subtitle", "time": 5556.07, "timestamp": "01:32:36", "text": "抽出？あなたのすぐ後ろにいます。右"}, {"type": "subtitle", "time": 5557.59, "timestamp": "01:32:37", "text": "あなたの後ろに。あなたのすぐ後ろにいます。右"}, {"type": "subtitle", "time": 5558.51, "timestamp": "01:32:38", "text": "後ろに"}, {"type": "subtitle", "time": 5560.75, "timestamp": "01:32:40", "text": "あなた。"}, {"type": "subtitle", "time": 5578.87, "timestamp": "01:32:58", "text": "あなたに指輪をあげたいんです。結婚して下さい？"}]
[{"type": "subtitle", "time": 3482.95, "timestamp": "00:58:02", "text": "この中で、それから私たちは、よし、あなたは取りに行く"}, {"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "より小さな品物。これについては取り組んでみます"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "ハート型の布人形がジャンプします。取っていく"}, {"type": "subtitle", "time": 3490.39, "timestamp": "00:58:10", "text": "だから、いや、いや、ジョー。あなたはやっている"}, {"type": "subtitle", "time": 3492.069, "timestamp": "00:58:12", "text": "アップグレードはできませんが、"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "私はそうします。ああ、もしあなたが"}, {"type": "subtitle", "time": 3497.67, "timestamp": "00:58:17", "text": "できる。そう、走ってジャンプして、それから"}, {"type": "subtitle", "time": 3500.47, "timestamp": "00:58:20", "text": "レスキュー。ええ、大丈夫です。私はただ行くだけです"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "外に置いて、私のゲットに置く"}, {"type": "subtitle", "time": 3507.829, "timestamp": "00:58:27", "text": "オーケー、大きなもの、なぜなら私たちは"}, {"type": "subtitle", "time": 3509.75, "timestamp": "00:58:29", "text": "ただし、抽出液の中には入れないでください。"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "いや、いや、いや、いや。こう言いましょう"}]
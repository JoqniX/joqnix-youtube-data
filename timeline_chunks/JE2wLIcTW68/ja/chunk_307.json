[{"type": "subtitle", "time": 18421.35, "timestamp": "05:07:01", "text": "私は死にかけている。何か緑色のものがある。"}, {"type": "subtitle", "time": 18425.91, "timestamp": "05:07:05", "text": "なんてこった。テレビで見てほしいですか？"}, {"type": "subtitle", "time": 18429.03, "timestamp": "05:07:09", "text": "多分。私はここにいます。心配しないで。私はただ"}, {"type": "subtitle", "time": 18432.07, "timestamp": "05:07:12", "text": "一人で冒険するのは、"}, {"type": "subtitle", "time": 18436.07, "timestamp": "05:07:16", "text": "強力だ。いいえ、ベイビー。"}, {"type": "subtitle", "time": 18437.99, "timestamp": "05:07:17", "text": "なぜ？待って。"}, {"type": "subtitle", "time": 18440.03, "timestamp": "05:07:20", "text": "何かがあるから"}, {"type": "subtitle", "time": 18443.35, "timestamp": "05:07:23", "text": "緑。私はそれを手に入れたい。"}, {"type": "subtitle", "time": 18457.34, "timestamp": "05:07:37", "text": "さあ"}, {"type": "subtitle", "time": 18470.39, "timestamp": "05:07:50", "text": "洞窟。あれ、これって私の家の近くじゃない？"}, {"type": "subtitle", "time": 18473.43, "timestamp": "05:07:53", "text": "ああ、そうだね。そうです。だから私はそれを作ったのです"}, {"type": "subtitle", "time": 18474.55, "timestamp": "05:07:54", "text": "ここ。"}, {"type": "subtitle", "time": 18476.708, "timestamp": "05:07:56", "text": "ああ、"}, {"type": "subtitle", "time": 18479.53, "timestamp": "05:07:59", "text": "そこをあなたの新しい家として扱っても構いません。"}]
[{"type": "subtitle", "time": 4654.99, "timestamp": "01:17:34", "text": "あなた"}, {"type": "subtitle", "time": 4659.75, "timestamp": "01:17:39", "text": "見逃した。私はあなたを怖がらせようとしていたんです。"}, {"type": "subtitle", "time": 4661.43, "timestamp": "01:17:41", "text": "はい、車に入れてください。私はただ"}, {"type": "subtitle", "time": 4665.59, "timestamp": "01:17:45", "text": "金庫を開けてください。よし、行こう。"}, {"type": "subtitle", "time": 4668.149, "timestamp": "01:17:48", "text": "先頭に立ちたいのか？いや、やめよう"}]
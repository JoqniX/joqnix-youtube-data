[{"type": "subtitle", "time": 15661.269, "timestamp": "04:21:01", "text": "鎧。あの音は何だったのか？何？待って。"}, {"type": "subtitle", "time": 15689.75, "timestamp": "04:21:29", "text": "あのね？私はそうすべきだった 私はそうすべきだった"}, {"type": "subtitle", "time": 15699.189, "timestamp": "04:21:39", "text": "俺がお前を殺せるってことは分かってるだろ。あなたは"}, {"type": "subtitle", "time": 15702.87, "timestamp": "04:21:42", "text": "同じ剣。わかった。"}]
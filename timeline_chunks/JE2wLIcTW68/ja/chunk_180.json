[{"type": "subtitle", "time": 10800.71, "timestamp": "03:00:00", "text": "何？"}, {"type": "subtitle", "time": 10802.79, "timestamp": "03:00:02", "text": "変化している。"}, {"type": "subtitle", "time": 10805.59, "timestamp": "03:00:05", "text": "なぜなら私は立っていて、それが動いているから"}, {"type": "subtitle", "time": 10808.95, "timestamp": "03:00:08", "text": "手。全員が立っている。ああ、それは"}, {"type": "subtitle", "time": 10813.19, "timestamp": "03:00:13", "text": "そうです。だから何？うん。ああ、そうだね。ああ、私は"}, {"type": "subtitle", "time": 10816.79, "timestamp": "03:00:16", "text": "知らなかった。"}, {"type": "subtitle", "time": 10818.15, "timestamp": "03:00:18", "text": "さあ、さあ、さあ。お見せします"}, {"type": "subtitle", "time": 10825.309, "timestamp": "03:00:25", "text": "飛び乗らないで"}, {"type": "subtitle", "time": 10828.309, "timestamp": "03:00:28", "text": "それ。あのね？いや、いや、ここはダメだ。"}, {"type": "subtitle", "time": 10830.71, "timestamp": "03:00:30", "text": "ここでは違う。私たちは直接ジャンプできます。私にさせて"}, {"type": "subtitle", "time": 10832.75, "timestamp": "03:00:32", "text": "そうしてください"}, {"type": "subtitle", "time": 10843.309, "timestamp": "03:00:43", "text": "フォローありがとうございます。リッチE12、"}, {"type": "subtitle", "time": 10846.23, "timestamp": "03:00:46", "text": "いらっしゃいませ。リッチさん、ようこそ。ようこそ"}, {"type": "subtitle", "time": 10847.91, "timestamp": "03:00:47", "text": "ストリーム。今日はどうやって私を見つけたの？調子はどうですか"}, {"type": "subtitle", "time": 10856.469, "timestamp": "03:00:56", "text": "それは何ですか？ああ、ジャンプできるよ。ああ、私は"}]
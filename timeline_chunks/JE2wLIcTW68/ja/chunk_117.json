[{"type": "subtitle", "time": 7031.589, "timestamp": "01:57:11", "text": "フレーム。よし、じゃあこれをやろう"}, {"type": "subtitle", "time": 7034.629, "timestamp": "01:57:14", "text": "今日。えっと、それから包んで寝てください。"}, {"type": "subtitle", "time": 7037.109, "timestamp": "01:57:17", "text": "また明日お会いしましょう。 25日目は"}, {"type": "subtitle", "time": 7051.43, "timestamp": "01:57:31", "text": "ログ？飛行機の報告。それが今日の"}, {"type": "subtitle", "time": 7052.83, "timestamp": "01:57:32", "text": "ストリーム。わかった。わかった。"}, {"type": "subtitle", "time": 7061.95, "timestamp": "01:57:41", "text": "わかった。参加する"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "スプリッター。盤面を分割する方法。私は"}, {"type": "subtitle", "time": 7069.149, "timestamp": "01:57:49", "text": "昨日分けたの？倍にさせてください"}, {"type": "subtitle", "time": 7073.83, "timestamp": "01:57:53", "text": "チェック。えっと、これは25です。25はもう"}, {"type": "subtitle", "time": 7076.91, "timestamp": "01:57:56", "text": "えっと、投稿したんですよね？うん。"}]
[{"type": "subtitle", "time": 12601.15, "timestamp": "03:30:01", "text": "待って。えっと"}, {"type": "subtitle", "time": 12602.9, "timestamp": "03:30:02", "text": "F3ゴールデン"}, {"type": "subtitle", "time": 12604.11, "timestamp": "03:30:04", "text": "[音楽]"}, {"type": "subtitle", "time": 12606.87, "timestamp": "03:30:06", "text": "りんご。魅惑のリンゴとは"}, {"type": "subtitle", "time": 12608.389, "timestamp": "03:30:08", "text": "する？"}, {"type": "subtitle", "time": 12611.55, "timestamp": "03:30:11", "text": "それを食べなさい。魅惑的な食事をお楽しみください。私は...するだろう"}, {"type": "subtitle", "time": 12614.229, "timestamp": "03:30:14", "text": "「いいえ、いいえ」をクリックするだけでいいと言っている。あなたはできる"}, {"type": "subtitle", "time": 12616.55, "timestamp": "03:30:16", "text": "マウスの中央ボタンをクリックするだけです。ただ"}, {"type": "subtitle", "time": 12618.71, "timestamp": "03:30:18", "text": "マウスの中央ボタンをクリックしてください。おお、"}, {"type": "subtitle", "time": 12621.349, "timestamp": "03:30:21", "text": "それは確かに存在する。知りませんでした。おお。"}, {"type": "subtitle", "time": 12630.87, "timestamp": "03:30:30", "text": "いや、それは生存のためだ。 H どうやって作るの？"}, {"type": "subtitle", "time": 12631.95, "timestamp": "03:30:31", "text": "自分自身"}, {"type": "subtitle", "time": 12633.63, "timestamp": "03:30:33", "text": "お腹がすいた？"}, {"type": "subtitle", "time": 12636.309, "timestamp": "03:30:36", "text": "待って、ほら、ハートが5つ増えるよ"}, {"type": "subtitle", "time": 12638.469, "timestamp": "03:30:38", "text": "黄金の魔法のリンゴのせいだ。"}, {"type": "subtitle", "time": 12640.19, "timestamp": "03:30:40", "text": "うん、君"}, {"type": "subtitle", "time": 12644.19, "timestamp": "03:30:44", "text": "知ってるかい、君もこれを手に入れるかもしれないよ。えっと、でも"}, {"type": "subtitle", "time": 12646.99, "timestamp": "03:30:46", "text": "それから待って、犬は"}, {"type": "subtitle", "time": 12650.429, "timestamp": "03:30:50", "text": "ストリーミング配信。待って、待って。私はできる"}]
[{"type": "subtitle", "time": 16262.149, "timestamp": "04:31:02", "text": "それは、ほら、私の大好きな曲なの。私"}, {"type": "subtitle", "time": 16265.429, "timestamp": "04:31:05", "text": "この曲、本当に大好きです。"}, {"type": "subtitle", "time": 16267.349, "timestamp": "04:31:07", "text": "うん。"}, {"type": "subtitle", "time": 16269.59, "timestamp": "04:31:09", "text": "知っている。私はもっ​​と多くのパンジャブ語の歌を知っています。させて"}, {"type": "subtitle", "time": 16270.49, "timestamp": "04:31:10", "text": "実際に試してみよう"}, {"type": "subtitle", "time": 16279.95, "timestamp": "04:31:19", "text": "見つける とても古い"}, {"type": "subtitle", "time": 16301.87, "timestamp": "04:31:41", "text": "[音楽]"}, {"type": "subtitle", "time": 16304.229, "timestamp": "04:31:44", "text": "違う。待って、私がクラッシュしたの？それともあなたも？"}, {"type": "subtitle", "time": 16307.429, "timestamp": "04:31:47", "text": "男たちが墜落したのか？私は墜落しなかった。"}, {"type": "subtitle", "time": 16309.75, "timestamp": "04:31:49", "text": "ああ、君は去ったんだね。"}, {"type": "subtitle", "time": 16311.55, "timestamp": "04:31:51", "text": "あなた"}]
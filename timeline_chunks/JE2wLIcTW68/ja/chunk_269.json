[{"type": "subtitle", "time": 16155.51, "timestamp": "04:29:15", "text": "[音楽]"}, {"type": "subtitle", "time": 16183.67, "timestamp": "04:29:43", "text": "お父さん、何してるの？"}, {"type": "subtitle", "time": 16185.91, "timestamp": "04:29:45", "text": "え、私？"}, {"type": "subtitle", "time": 16188.95, "timestamp": "04:29:48", "text": "彼はまさに私の城の上にいる。"}, {"type": "subtitle", "time": 16191.189, "timestamp": "04:29:51", "text": "私はホグワーツのあのほうきをやっている"}, {"type": "subtitle", "time": 16194.229, "timestamp": "04:29:54", "text": "突き出ている。あのね？私は持っています"}, {"type": "subtitle", "time": 16197.03, "timestamp": "04:29:57", "text": "いくつか素敵なもの。私は待たない。私は私に"}, {"type": "subtitle", "time": 16199.03, "timestamp": "04:29:59", "text": "ちょっと待ってください。 1つやってみよう"}]
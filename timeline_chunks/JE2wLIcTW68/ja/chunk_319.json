[{"type": "subtitle", "time": 19146.35, "timestamp": "05:19:06", "text": "わかった。"}, {"type": "subtitle", "time": 19149.628, "timestamp": "05:19:09", "text": "えっと、それから"}, {"type": "subtitle", "time": 19152.628, "timestamp": "05:19:12", "text": "チャンガが何かを見たらどうするべきか"}, {"type": "subtitle", "time": 19157.19, "timestamp": "05:19:17", "text": "ごく自然なことだとお伝えします"}, {"type": "subtitle", "time": 19159.59, "timestamp": "05:19:19", "text": "好きなんです、自然にできます"}, {"type": "subtitle", "time": 19163.27, "timestamp": "05:19:23", "text": "誰か今すぐ私と話して"}, {"type": "subtitle", "time": 19173.11, "timestamp": "05:19:33", "text": "はい、そうできますし、"}, {"type": "subtitle", "time": 19179.19, "timestamp": "05:19:39", "text": "パンジャブ人は女の子が好きで何か"}, {"type": "subtitle", "time": 19181.628, "timestamp": "05:19:41", "text": "あんな感じ"}, {"type": "subtitle", "time": 19185.83, "timestamp": "05:19:45", "text": "あれは何だったんだ？"}, {"type": "subtitle", "time": 19193.51, "timestamp": "05:19:53", "text": "もの。わかった。うん。うん。あんな風に"}, {"type": "subtitle", "time": 19196.23, "timestamp": "05:19:56", "text": "歌とか、私が行ったときみたいな"}, {"type": "subtitle", "time": 19198.708, "timestamp": "05:19:58", "text": "理髪店ではパンジャブ語の歌を流している"}]
[{"type": "subtitle", "time": 15914.309, "timestamp": "04:25:14", "text": "知る。知っている。見て、それは"}, {"type": "subtitle", "time": 15915.55, "timestamp": "04:25:15", "text": "ダイヤモンド"}, {"type": "subtitle", "time": 15918.79, "timestamp": "04:25:18", "text": "ミツキ。いいえ、違います。ああ、そこへ行って。"}, {"type": "subtitle", "time": 15922.349, "timestamp": "04:25:22", "text": "わかった。ジョー、それが何なのか分かる？これは"}, {"type": "subtitle", "time": 15925.83, "timestamp": "04:25:25", "text": "ミツキの船体。"}, {"type": "subtitle", "time": 15929.269, "timestamp": "04:25:29", "text": "死ね、死ね、死ね。"}, {"type": "subtitle", "time": 15932.07, "timestamp": "04:25:32", "text": "ええ、記念碑ですね。それは記念碑だ。"}, {"type": "subtitle", "time": 15934.55, "timestamp": "04:25:34", "text": "記念碑。"}, {"type": "subtitle", "time": 15937.349, "timestamp": "04:25:37", "text": "ここに来て。何してるの？"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "今日。私はあの曲が大好きです。"}]
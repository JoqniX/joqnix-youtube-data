[{"type": "subtitle", "time": 1205.19, "timestamp": "00:20:05", "text": "うん。彼は二階に上がってくる。私たちは大丈夫です。"}, {"type": "subtitle", "time": 1209.75, "timestamp": "00:20:09", "text": "私たちはリラックスしています。エイデン。エイデン。"}, {"type": "subtitle", "time": 1210.909, "timestamp": "00:20:10", "text": "おお"}, {"type": "subtitle", "time": 1215.43, "timestamp": "00:20:15", "text": "神。ああ、彼女が今私に襲いかかっている。わかった。これ"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "リトルナイトメアか何かみたい"}, {"type": "subtitle", "time": 1220.95, "timestamp": "00:20:20", "text": "何か。そうです。そうそう。そうです、"}, {"type": "subtitle", "time": 1223.83, "timestamp": "00:20:23", "text": "右？"}, {"type": "subtitle", "time": 1226.19, "timestamp": "00:20:26", "text": "私はそのゲームをプレイしたことがありません。"}, {"type": "subtitle", "time": 1228.029, "timestamp": "00:20:28", "text": "方法。話す"}, {"type": "subtitle", "time": 1238.95, "timestamp": "00:20:38", "text": "彼女は再び部屋に入ったのか？"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "とんでもない。右。いや、いや。彼女はやりすぎだ。"}, {"type": "subtitle", "time": 1243.11, "timestamp": "00:20:43", "text": "彼女は静かに歩く人ですか？彼女が"}, {"type": "subtitle", "time": 1244.39, "timestamp": "00:20:44", "text": "活性化されていないので、彼女は何もしません"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "ノイズ。ああ、神様。"}, {"type": "subtitle", "time": 1249.149, "timestamp": "00:20:49", "text": "それは"}, {"type": "subtitle", "time": 1253.19, "timestamp": "00:20:53", "text": "悲しい。悪い知らせです。"}, {"type": "subtitle", "time": 1255.51, "timestamp": "00:20:55", "text": "降りるべきでしょうか？そんなことを言うな、"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "チャット。何を入力していますか？私はそうは思わない"}]
[{"type": "subtitle", "time": 1082.71, "timestamp": "00:18:02", "text": "神。何てことだ。私が言いたいのはそれだけです。"}, {"type": "subtitle", "time": 1088.83, "timestamp": "00:18:08", "text": "ああ、大変だ。走る。"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "走る。カードを受け取らないでください。"}, {"type": "subtitle", "time": 1094.789, "timestamp": "00:18:14", "text": "あなたと。そこに置いておきましょう。"}, {"type": "subtitle", "time": 1105.71, "timestamp": "00:18:25", "text": "私は壁だ。私は壁だ。私は"}, {"type": "subtitle", "time": 1108.63, "timestamp": "00:18:28", "text": "1つ。私はただの壁でしかない。私は私は"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "壁。私は壁だ。私は壁だ。私は"}, {"type": "subtitle", "time": 1126.47, "timestamp": "00:18:46", "text": "来るよ。私は壁だ。私は壁だ。私は"}, {"type": "subtitle", "time": 1128.63, "timestamp": "00:18:48", "text": "壁。私は壁だ。私は何者でもない。私は"}, {"type": "subtitle", "time": 1130.789, "timestamp": "00:18:50", "text": "私は壁だ。私はレンガです。私は作られた"}]
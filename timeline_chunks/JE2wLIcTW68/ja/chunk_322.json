[{"type": "subtitle", "time": 19332.31, "timestamp": "05:22:12", "text": "ええ、それは「こんにちは、ご挨拶申し上げます、ユーリ」という意味です。"}, {"type": "subtitle", "time": 19335.23, "timestamp": "05:22:15", "text": "えっと、私の名前は"}, {"type": "subtitle", "time": 19338.15, "timestamp": "05:22:18", "text": "アストラ。元気ですか？"}, {"type": "subtitle", "time": 19345.67, "timestamp": "05:22:25", "text": "待って、スージーにやったの？"}, {"type": "subtitle", "time": 19348.628, "timestamp": "05:22:28", "text": "いいえ、スージーにやるのを忘れていました。そうします"}, {"type": "subtitle", "time": 19351.23, "timestamp": "05:22:31", "text": "次に彼女に会った時にそうするつもりだ。"}, {"type": "subtitle", "time": 19359.11, "timestamp": "05:22:39", "text": "私はどの言語も知りません。知ってるよ、"}, {"type": "subtitle", "time": 19360.19, "timestamp": "05:22:40", "text": "毎"}, {"type": "subtitle", "time": 19371.59, "timestamp": "05:22:51", "text": "インド人ですが、何を教えればいいのかわかりません"}, {"type": "subtitle", "time": 19374.628, "timestamp": "05:22:54", "text": "彼。そこが問題なんです。どうすればいいか"}, {"type": "subtitle", "time": 19376.15, "timestamp": "05:22:56", "text": "始める？それが問題なんです。いいね"}, {"type": "subtitle", "time": 19379.07, "timestamp": "05:22:59", "text": "文章を覚えたいなら、できますよ。"}]
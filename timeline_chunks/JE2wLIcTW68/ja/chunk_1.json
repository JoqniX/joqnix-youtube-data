[{"type": "subtitle", "time": 61.67, "timestamp": "00:01:01", "text": "怖がった。私はたくさんのことを感じています"}, {"type": "subtitle", "time": 64.789, "timestamp": "00:01:04", "text": "今の私の心境。私にはわからない"}, {"type": "subtitle", "time": 67.55, "timestamp": "00:01:07", "text": "何が起こっているのか、何が起こるのか"}, {"type": "subtitle", "time": 70.95, "timestamp": "00:01:10", "text": "下。でも、私ができること、私ができること、私が知っていること"}, {"type": "subtitle", "time": 71.87, "timestamp": "00:01:11", "text": "は"}, {"type": "subtitle", "time": 86.03, "timestamp": "00:01:26", "text": "えっと、1つ目"}, {"type": "subtitle", "time": 94.19, "timestamp": "00:01:34", "text": "えっと、マインクラフト。"}, {"type": "subtitle", "time": 101.27000000000001, "timestamp": "00:01:41", "text": "わかった。報告。チュートリアルがあります"}, {"type": "subtitle", "time": 102.10900000000001, "timestamp": "00:01:42", "text": "の"}]
[{"type": "subtitle", "time": 16740.949, "timestamp": "04:39:00", "text": "よし、みんな、私を見て。見てみて"}, {"type": "subtitle", "time": 16743.109, "timestamp": "04:39:03", "text": "空に。私は何かを作っています"}, {"type": "subtitle", "time": 16744.869, "timestamp": "04:39:04", "text": "君たち。"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "土台を作っています。それは私の"}, {"type": "subtitle", "time": 16750.869, "timestamp": "04:39:10", "text": "最初は、このエリアのように、"}, {"type": "subtitle", "time": 16753.109, "timestamp": "04:39:13", "text": "特定の土地。私は作りたかった"}, {"type": "subtitle", "time": 16757.029, "timestamp": "04:39:17", "text": "ここに家があります。今すぐ作らせてください。"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "こんにちは。"}, {"type": "subtitle", "time": 16771.349, "timestamp": "04:39:31", "text": "何か？よし、荷物を持ってくるよ"}, {"type": "subtitle", "time": 16777.43, "timestamp": "04:39:37", "text": "ああ、私の墓よ。ジャマ、ここにいて"}, {"type": "subtitle", "time": 16781.03, "timestamp": "04:39:41", "text": "今。そして待って、空を見てください"}, {"type": "subtitle", "time": 16782.31, "timestamp": "04:39:42", "text": "空。"}, {"type": "subtitle", "time": 16784.708, "timestamp": "04:39:44", "text": "私のアニメーションとシェーダーすべて"}, {"type": "subtitle", "time": 16788.15, "timestamp": "04:39:48", "text": "電源が切れているので、今見えているものが見えません。"}, {"type": "subtitle", "time": 16789.47, "timestamp": "04:39:49", "text": "ああ、今"}, {"type": "subtitle", "time": 16792.03, "timestamp": "04:39:52", "text": "何？待って、それは"}, {"type": "subtitle", "time": 16795.83, "timestamp": "04:39:55", "text": "自動。はぁ？ええ、まさにそれをやっています"}]
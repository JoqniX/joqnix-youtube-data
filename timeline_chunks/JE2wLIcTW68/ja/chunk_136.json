[{"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "ああ、そうですね。将来、あなたは"}, {"type": "subtitle", "time": 8166.55, "timestamp": "02:16:06", "text": "ほら、もし物事がややこしくなったら、ほら、"}, {"type": "subtitle", "time": 8167.87, "timestamp": "02:16:07", "text": "何をすべきかを知る"}, {"type": "subtitle", "time": 8176.79, "timestamp": "02:16:16", "text": "でも、主にあなたが"}, {"type": "subtitle", "time": 8179.99, "timestamp": "02:16:19", "text": "チューブとか色々あるよ"}, {"type": "subtitle", "time": 8182.109, "timestamp": "02:16:22", "text": "物事の"}, {"type": "subtitle", "time": 8184.87, "timestamp": "02:16:24", "text": "出会う人が増えるほど"}, {"type": "subtitle", "time": 8188.069, "timestamp": "02:16:28", "text": "交流する人たちとか、そういう人たち"}, {"type": "subtitle", "time": 8190.069, "timestamp": "02:16:30", "text": "あなたに近づこうとする人たちがいて、"}, {"type": "subtitle", "time": 8192.23, "timestamp": "02:16:32", "text": "すべて。"}, {"type": "subtitle", "time": 8196.549, "timestamp": "02:16:36", "text": "えーと、例えば"}, {"type": "subtitle", "time": 8198.95, "timestamp": "02:16:38", "text": "えーっと、例えばあなたがストリーミング配信をしているとしましょう"}, {"type": "subtitle", "time": 8202.709, "timestamp": "02:16:42", "text": "しばらくの間、あなたは、またはゆっくりと、ええと"}, {"type": "subtitle", "time": 8204.709, "timestamp": "02:16:44", "text": "観客を増やしたり、いろいろなことをしたり"}, {"type": "subtitle", "time": 8209.27, "timestamp": "02:16:49", "text": "最高の時、一部の人々は"}, {"type": "subtitle", "time": 8212.549, "timestamp": "02:16:52", "text": "一部の視聴者は、"}, {"type": "subtitle", "time": 8216.07, "timestamp": "02:16:56", "text": "パラソーシャル主義ってあるよね"}, {"type": "subtitle", "time": 8218.87, "timestamp": "02:16:58", "text": "俺は苦労して学んだんだよ、俺は"}]
[{"type": "subtitle", "time": 11642.63, "timestamp": "03:14:02", "text": "伝説。うん。"}, {"type": "subtitle", "time": 11645.349, "timestamp": "03:14:05", "text": "そして最初は私は持っていなかった"}, {"type": "subtitle", "time": 11647.11, "timestamp": "03:14:07", "text": "観る予定で、友達が予約した"}, {"type": "subtitle", "time": 11649.03, "timestamp": "03:14:09", "text": "私のチケットです。彼は遊ぶのも好きだ"}, {"type": "subtitle", "time": 11650.79, "timestamp": "03:14:10", "text": "マインクラフト"}, {"type": "subtitle", "time": 11653.11, "timestamp": "03:14:13", "text": "しかし、彼はただ遊ぶのが好きなだけなので、めったに"}, {"type": "subtitle", "time": 11655.19, "timestamp": "03:14:15", "text": "彼はただいじめるのが好きなだけ"}, {"type": "subtitle", "time": 11657.11, "timestamp": "03:14:17", "text": "マインクラフト。"}, {"type": "subtitle", "time": 11660.87, "timestamp": "03:14:20", "text": "だから、遊びに行く予定だったんだけど、"}, {"type": "subtitle", "time": 11663.75, "timestamp": "03:14:23", "text": "チケットを予約しました。それで私はそれを見て"}, {"type": "subtitle", "time": 11666.07, "timestamp": "03:14:26", "text": "後悔したし、多くの時間を無駄にした。"}, {"type": "subtitle", "time": 11668.389, "timestamp": "03:14:28", "text": "お金を払って出かけた"}, {"type": "subtitle", "time": 11670.87, "timestamp": "03:14:30", "text": "間隔。"}, {"type": "subtitle", "time": 11672.87, "timestamp": "03:14:32", "text": "支払った金額に見合う価値はなかった。のように"}, {"type": "subtitle", "time": 11675.03, "timestamp": "03:14:35", "text": "もし私が300か400くらい支払ったとしたら、"}, {"type": "subtitle", "time": 11677.309, "timestamp": "03:14:37", "text": "だろう"}, {"type": "subtitle", "time": 11679.83, "timestamp": "03:14:39", "text": "価値がある。あ、待って。私に言わないで"}, {"type": "subtitle", "time": 11683.59, "timestamp": "03:14:43", "text": "実際、ああ、神様。あなたは本当に無駄にした"}, {"type": "subtitle", "time": 11686.71, "timestamp": "03:14:46", "text": "そんなものに金を払うなんて。私はそうではなかった"}, {"type": "subtitle", "time": 11689.03, "timestamp": "03:14:49", "text": "誰が予約したの？"}, {"type": "subtitle", "time": 11692.15, "timestamp": "03:14:52", "text": "とはいえ、結局はお金だ。"}, {"type": "subtitle", "time": 11696.63, "timestamp": "03:14:56", "text": "うん。待って、大丈夫だよ。どこにいるの？"}, {"type": "subtitle", "time": 11699.91, "timestamp": "03:14:59", "text": "ええと、私はまだ城にいます。わかった。"}]
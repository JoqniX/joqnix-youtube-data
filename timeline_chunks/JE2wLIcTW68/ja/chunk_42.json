[{"type": "subtitle", "time": 2523.67, "timestamp": "00:42:03", "text": "時間制限か何かがあるんだ。"}, {"type": "subtitle", "time": 2525.71, "timestamp": "00:42:05", "text": "頭の悪い奴はどこだ？いいえ。いいえ。時があります"}, {"type": "subtitle", "time": 2529.91, "timestamp": "00:42:09", "text": "制限。絶対に大丈夫だよ。"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "私は元気です。ええ、彼は隠れていました。ああ、"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "神。隠すってどういう意味ですか？私は"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "食べてるんだよ、兄弟。来て。"}, {"type": "subtitle", "time": 2540.47, "timestamp": "00:42:20", "text": "夕食の時間です。ああ、恥をかかせてやる"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "あなたは本当に大変ですね。夕食の時間です。あなたは何を"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "平均？うん。あのね？わかった。もっと"}, {"type": "subtitle", "time": 2548.309, "timestamp": "00:42:28", "text": "アップグレード。待って、あれは何？"}, {"type": "subtitle", "time": 2563.109, "timestamp": "00:42:43", "text": "それ。空振りだよ、相棒。スイングする"}, {"type": "subtitle", "time": 2571.39, "timestamp": "00:42:51", "text": "これは"}, {"type": "subtitle", "time": 2576.15, "timestamp": "00:42:56", "text": "まさにその通り。やあ、ジョー。ここに来て。やあ、ジョー。"}]
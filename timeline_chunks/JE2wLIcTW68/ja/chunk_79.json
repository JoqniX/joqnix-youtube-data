[{"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "何てことだ。待って、私はまだ生きている。ニース。"}, {"type": "subtitle", "time": 4759.11, "timestamp": "01:19:19", "text": "なぜタンブル発射なのか？私はすでに"}, {"type": "subtitle", "time": 4761.11, "timestamp": "01:19:21", "text": "それ。ごめん。"}, {"type": "subtitle", "time": 4764.149, "timestamp": "01:19:24", "text": "それは、えっと"}, {"type": "subtitle", "time": 4767.91, "timestamp": "01:19:27", "text": "頑張ってみます。心配しないで。鋼鉄。"}, {"type": "subtitle", "time": 4768.75, "timestamp": "01:19:28", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 4770.55, "timestamp": "01:19:30", "text": "[音楽]"}, {"type": "subtitle", "time": 4772.149, "timestamp": "01:19:32", "text": "えーと、ところで、お二人とも"}, {"type": "subtitle", "time": 4773.43, "timestamp": "01:19:33", "text": "健康状態が非常に低いので、"}, {"type": "subtitle", "time": 4776.63, "timestamp": "01:19:36", "text": "不具合。私を上へ送ってください。私にも一片送ってください。"}, {"type": "subtitle", "time": 4779.91, "timestamp": "01:19:39", "text": "お願いします。健康状態をアップグレードした方が良いでしょうか？"}, {"type": "subtitle", "time": 4782.83, "timestamp": "01:19:42", "text": "持続する。持続する。あなた"}, {"type": "subtitle", "time": 4785.43, "timestamp": "01:19:45", "text": "ロコ、どこに行ったの？私はここにいます。"}, {"type": "subtitle", "time": 4788.63, "timestamp": "01:19:48", "text": "私はここにいます。わかった。あなたにぴったりのデバイスを用意しました。"}, {"type": "subtitle", "time": 4791.43, "timestamp": "01:19:51", "text": "それは何ですか？"}, {"type": "subtitle", "time": 4793.23, "timestamp": "01:19:53", "text": "よし。見て。調べてみる"}, {"type": "subtitle", "time": 4794.83, "timestamp": "01:19:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1265.83, "timestamp": "00:21:05", "text": "私は気が狂いそうだ。分かりますよ。"}, {"type": "subtitle", "time": 1283.68, "timestamp": "00:21:23", "text": "ああ、彼女が来るわ。"}, {"type": "subtitle", "time": 1295.029, "timestamp": "00:21:35", "text": "ああ、見て。これは何ですか？"}, {"type": "subtitle", "time": 1297.43, "timestamp": "00:21:37", "text": "ああ、それは大変ですね。わかったよ、MJ。だった"}, {"type": "subtitle", "time": 1298.95, "timestamp": "00:21:38", "text": "カートはここに置いておくつもりです"}, {"type": "subtitle", "time": 1301.029, "timestamp": "00:21:41", "text": "すでに私たちが持っている以上のもの"}, {"type": "subtitle", "time": 1303.43, "timestamp": "00:21:43", "text": "必要だから、手に入れようとしてもいいだろう"}, {"type": "subtitle", "time": 1307.75, "timestamp": "00:21:47", "text": "そうすれば、さらに利益を上げることができます。"}, {"type": "subtitle", "time": 1310.549, "timestamp": "00:21:50", "text": "わかった。えっと、何ですか"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "他のゲーム？ええと、リーサル・カンパニーですよ。"}, {"type": "subtitle", "time": 1317.35, "timestamp": "00:21:57", "text": "ああ、致命的だ。わかった。わかった。うん、頭が"}, {"type": "subtitle", "time": 1319.75, "timestamp": "00:21:59", "text": "痛い。横になってください、旦那様。飲む"}]
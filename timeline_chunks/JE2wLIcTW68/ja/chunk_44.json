[{"type": "subtitle", "time": 2642.309, "timestamp": "00:44:02", "text": "何もない。"}, {"type": "subtitle", "time": 2645.27, "timestamp": "00:44:05", "text": "おお、いいね。"}, {"type": "subtitle", "time": 2647.109, "timestamp": "00:44:07", "text": "あのね？健康状態を上げます。"}, {"type": "subtitle", "time": 2655.109, "timestamp": "00:44:15", "text": "もう一つ手榴弾がある。またしてもクソ野郎"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "クリーパーバック。うん。ありがとう。ええと、私は"}, {"type": "subtitle", "time": 2660.95, "timestamp": "00:44:20", "text": "つまり、もう一つ手榴弾だ。"}, {"type": "subtitle", "time": 2669.51, "timestamp": "00:44:29", "text": "それだけですか？以上です。人間"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "それは巨大な手榴弾だ。"}, {"type": "subtitle", "time": 2680.069, "timestamp": "00:44:40", "text": "いや。待って、何？いや。クソ。いいえ、私がやったんです。"}, {"type": "subtitle", "time": 2683.349, "timestamp": "00:44:43", "text": "はい、閉じました。ええと、私たちは"}, {"type": "subtitle", "time": 2685.349, "timestamp": "00:44:45", "text": "お金、マッププレイヤーを連れて行きます"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "誰が死んだのか分かるように、カウントを更新してください。地獄"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "うん。ドローンも購入すべきでしょうか？"}, {"type": "subtitle", "time": 2693.67, "timestamp": "00:44:53", "text": "えっと、ゼログラブゴー。絶対に嫌だ。その"}, {"type": "subtitle", "time": 2697.27, "timestamp": "00:44:57", "text": "使い物にならない。ああ、わかりました。そのその"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "羽根のドローン。羽根ドローンは"}]
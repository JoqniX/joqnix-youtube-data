[{"type": "subtitle", "time": 14226.71, "timestamp": "03:57:06", "text": "ボス。そしてそれは、そしてそれは"}, {"type": "subtitle", "time": 14229.269, "timestamp": "03:57:09", "text": "大きなものみたいに。"}, {"type": "subtitle", "time": 14231.79, "timestamp": "03:57:11", "text": "それは物を作り、そして落とす。"}, {"type": "subtitle", "time": 14235.349, "timestamp": "03:57:15", "text": "ちくしょう"}, {"type": "subtitle", "time": 14238.63, "timestamp": "03:57:18", "text": "ああ、黒曜石の心臓よ。これは、えっと"}, {"type": "subtitle", "time": 14239.77, "timestamp": "03:57:19", "text": "地球駆動"}, {"type": "subtitle", "time": 14259.83, "timestamp": "03:57:39", "text": "ブロック、そしてここはノースカロライナ州の都市です"}, {"type": "subtitle", "time": 14266.91, "timestamp": "03:57:46", "text": "うん。どこでどこで"}, {"type": "subtitle", "time": 14277.87, "timestamp": "03:57:57", "text": "飛び上がれ。うん。そしてこのものが"}]
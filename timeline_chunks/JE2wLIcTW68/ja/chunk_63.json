[{"type": "subtitle", "time": 3785.309, "timestamp": "01:03:05", "text": "それ。よし、これでいい。はい、完璧です。"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "ああ、わかった。お金の入った袋とこれら"}, {"type": "subtitle", "time": 3791.63, "timestamp": "01:03:11", "text": "カードの中の小さなもの。わかった。"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "カード。あれを見てみろよ、[ __ ]。ニース。よお。"}, {"type": "subtitle", "time": 3800.23, "timestamp": "01:03:20", "text": "コンピューター。何てことだ。すごくかっこいい。"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "これもそうですよね？"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "もう一度。ええ、ほんの少し"}, {"type": "subtitle", "time": 3808.47, "timestamp": "01:03:28", "text": "アイテム。それを入れて。つまり、"}, {"type": "subtitle", "time": 3811.27, "timestamp": "01:03:31", "text": "なぜなら私は本当に"}, {"type": "subtitle", "time": 3813.99, "timestamp": "01:03:33", "text": "えっと、これらのコンピューターはどうですか？私たちはそれを持ち上げます"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "助けが必要です。"}, {"type": "subtitle", "time": 3825.349, "timestamp": "01:03:45", "text": "いいえ、大丈夫です。大丈夫です。なぜ？なぜ私たちは"}, {"type": "subtitle", "time": 3827.91, "timestamp": "01:03:47", "text": "ここに立っているのか？"}, {"type": "subtitle", "time": 3832.309, "timestamp": "01:03:52", "text": "わかった。どのような？もう一度。いや、いや、いや。"}, {"type": "subtitle", "time": 3835.51, "timestamp": "01:03:55", "text": "わかった。わかった。いや、違うよ。いいえ。なぜですか？ダメだ。やめろ。"}, {"type": "subtitle", "time": 3836.75, "timestamp": "01:03:56", "text": "停止。停止。停止。"}, {"type": "subtitle", "time": 3838.87, "timestamp": "01:03:58", "text": "停止。それを自分の横に持ち上げます。"}]
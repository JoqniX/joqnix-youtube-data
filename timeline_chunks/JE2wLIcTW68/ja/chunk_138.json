[{"type": "subtitle", "time": 8286.629, "timestamp": "02:18:06", "text": "ドラマ。背筋を伸ばして座らせてください。私"}, {"type": "subtitle", "time": 8289.07, "timestamp": "02:18:09", "text": "私の姿勢を崩してはいけない"}, {"type": "subtitle", "time": 8292.389, "timestamp": "02:18:12", "text": "椅子。今、計画を立てているところです。おお、いいね。"}, {"type": "subtitle", "time": 8303.349, "timestamp": "02:18:23", "text": "そこには。水分補給をしましょう。全員に思い出させてください。"}, {"type": "subtitle", "time": 8305.349, "timestamp": "02:18:25", "text": "モデル制作とか、そういう作業に取り組んでいます。こんにちは、"}, {"type": "subtitle", "time": 8306.75, "timestamp": "02:18:26", "text": "幸運を。良い"}, {"type": "subtitle", "time": 8310.07, "timestamp": "02:18:30", "text": "運。ほら、君が望むならそうすることもできるよ"}, {"type": "subtitle", "time": 8313.349, "timestamp": "02:18:33", "text": "無料モデルを試してみるのもいいでしょう。"}, {"type": "subtitle", "time": 8316.469, "timestamp": "02:18:36", "text": "または車を見て、チューブと"}, {"type": "subtitle", "time": 8318.91, "timestamp": "02:18:38", "text": "すべては"}, {"type": "subtitle", "time": 8322.629, "timestamp": "02:18:42", "text": "あなた。うん。そして、あなたも好きになれる"}, {"type": "subtitle", "time": 8324.79, "timestamp": "02:18:44", "text": "独自のモデルを作成する"}, {"type": "subtitle", "time": 8329.03, "timestamp": "02:18:49", "text": "サイドラインのモデルを希望する場合は"}, {"type": "subtitle", "time": 8331.669, "timestamp": "02:18:51", "text": "PNGチューブもそうですが、"}, {"type": "subtitle", "time": 8333.549, "timestamp": "02:18:53", "text": "やりたいなら"}]
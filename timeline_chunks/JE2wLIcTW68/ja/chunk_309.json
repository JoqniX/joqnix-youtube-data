[{"type": "subtitle", "time": 18542.628, "timestamp": "05:09:02", "text": "君は、私が見ている人だ。"}, {"type": "subtitle", "time": 18544.948, "timestamp": "05:09:04", "text": "飛行機の操縦を学びたいですか？あなたは"}, {"type": "subtitle", "time": 18548.39, "timestamp": "05:09:08", "text": "まるでWみたいだ。君は魚みたいだ。"}, {"type": "subtitle", "time": 18551.11, "timestamp": "05:09:11", "text": "おお、"}, {"type": "subtitle", "time": 18553.91, "timestamp": "05:09:13", "text": "待って。本当に？"}, {"type": "subtitle", "time": 18563.23, "timestamp": "05:09:23", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 18565.91, "timestamp": "05:09:25", "text": "わかった。そうそう。うん。うん。見た目は"}, {"type": "subtitle", "time": 18575.91, "timestamp": "05:09:35", "text": "私はこうやって水中に潜ることができます。おお。"}, {"type": "subtitle", "time": 18580.31, "timestamp": "05:09:40", "text": "うん。あなたは死なない。私とは違ってね。負けました"}, {"type": "subtitle", "time": 18582.788, "timestamp": "05:09:42", "text": "私の二つの心。"}, {"type": "subtitle", "time": 18598.47, "timestamp": "05:09:58", "text": "力。黙れ。はい、今から行きます"}]
[{"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "モップがあったと想像して、"}, {"type": "subtitle", "time": 12979.07, "timestamp": "03:36:19", "text": "インクを拭き取る"}, {"type": "subtitle", "time": 12983.67, "timestamp": "03:36:23", "text": "モップ。彼らはそうすべきだった。"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "今はこのままにしておいてください。うん。うん。"}, {"type": "subtitle", "time": 12991.429, "timestamp": "03:36:31", "text": "あなたは私を創造したばかりで、これからあなたは"}, {"type": "subtitle", "time": 12994.67, "timestamp": "03:36:34", "text": "このままにしておいてください。ニース。その"}, {"type": "subtitle", "time": 12998.389, "timestamp": "03:36:38", "text": "私のミスです。"}, {"type": "subtitle", "time": 13012.309, "timestamp": "03:36:52", "text": "その音は何ですか？私はそれが好きです。"}]
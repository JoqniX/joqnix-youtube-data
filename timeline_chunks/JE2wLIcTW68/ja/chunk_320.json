[{"type": "subtitle", "time": 19201.51, "timestamp": "05:20:01", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 19206.708, "timestamp": "05:20:06", "text": "理髪店。その男はたくさん"}, {"type": "subtitle", "time": 19210.31, "timestamp": "05:20:10", "text": "ヒンディー語の歌の。私は「うわあ」と思いました。待って、"}, {"type": "subtitle", "time": 19218.07, "timestamp": "05:20:18", "text": "いや、いや、いや。床屋はそんなことはしない"}, {"type": "subtitle", "time": 19219.91, "timestamp": "05:20:19", "text": "歌。"}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "それは歌と呼ばれるものですか？ブリって何でしたっけ？"}, {"type": "subtitle", "time": 19228.31, "timestamp": "05:20:28", "text": "しかし、それは言語です。上向きまたは"}, {"type": "subtitle", "time": 19232.15, "timestamp": "05:20:32", "text": "ビハール州側？わからない。"}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "自制すべきなのは私だけだ。あなたが知っている"}, {"type": "subtitle", "time": 19257.67, "timestamp": "05:20:57", "text": "何？どうでも。"}]
[{"type": "subtitle", "time": 16501.029, "timestamp": "04:35:01", "text": "ダンジョンと酒場の件ですね。うん。"}, {"type": "subtitle", "time": 16502.629, "timestamp": "04:35:02", "text": "うん。うん。ええ、そうですね。実際の"}, {"type": "subtitle", "time": 16516.15, "timestamp": "04:35:16", "text": "ああ、あそこに宝箱がある。できますか"}, {"type": "subtitle", "time": 16518.23, "timestamp": "04:35:18", "text": "行く？"}, {"type": "subtitle", "time": 16519.59, "timestamp": "04:35:19", "text": "まあ、死ななければ、中に入ることができます"}, {"type": "subtitle", "time": 16534.629, "timestamp": "04:35:34", "text": "私は何者ですか？私は死にかけている。何？うん、君"}, {"type": "subtitle", "time": 16537.51, "timestamp": "04:35:37", "text": "「私は死なない」とだけ言った。もしあなたが"}, {"type": "subtitle", "time": 16539.15, "timestamp": "04:35:39", "text": "死なないで、行け"}, {"type": "subtitle", "time": 16543.109, "timestamp": "04:35:43", "text": "あなたのスキル次第で、どこでも働けます。"}, {"type": "subtitle", "time": 16545.51, "timestamp": "04:35:45", "text": "ああ、それは"}, {"type": "subtitle", "time": 16547.67, "timestamp": "04:35:47", "text": "悪い。"}, {"type": "subtitle", "time": 16549.551, "timestamp": "04:35:49", "text": "兄弟、もしあなたが特定の状況で生き残れないなら"}, {"type": "subtitle", "time": 16553.59, "timestamp": "04:35:53", "text": "あなたには必要なスキルセットがない場所。"}, {"type": "subtitle", "time": 16556.949, "timestamp": "04:35:56", "text": "彼女は学ぶことができる。彼女は学ぶことができる。 D."}, {"type": "subtitle", "time": 16558.39, "timestamp": "04:35:58", "text": "うん。私はそんな光景を一度も見たことがない。彼女はできない"}, {"type": "subtitle", "time": 16559.51, "timestamp": "04:35:59", "text": "学ぶ。彼女は学ぶことができる。彼女はできる"}]
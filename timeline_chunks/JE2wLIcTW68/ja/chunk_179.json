[{"type": "subtitle", "time": 10748.71, "timestamp": "02:59:08", "text": "ああ、どうやって作ったの？"}, {"type": "subtitle", "time": 10750.91, "timestamp": "02:59:10", "text": "青？"}, {"type": "subtitle", "time": 10758.79, "timestamp": "02:59:18", "text": "ああ、すごいですね。トリムはこんな感じ"}, {"type": "subtitle", "time": 10762.469, "timestamp": "02:59:22", "text": "今は違う。うん、でも私はこれが好き"}, {"type": "subtitle", "time": 10764.23, "timestamp": "02:59:24", "text": "見た目が良いので、特にトリムが良い"}, {"type": "subtitle", "time": 10767.11, "timestamp": "02:59:27", "text": "金と一緒に使うとき。だから私は"}, {"type": "subtitle", "time": 10769.99, "timestamp": "02:59:29", "text": "アイアンマンっぽい見た目。ああ、これと同じ"}, {"type": "subtitle", "time": 10774.469, "timestamp": "02:59:34", "text": "このようにトリミングしてください。ああ、トリムはこんな感じ"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "異なる異なるパターン。いいえ。ええ。"}, {"type": "subtitle", "time": 10778.95, "timestamp": "02:59:38", "text": "でも、私が好きなのはこれだけです。たくさんあります"}, {"type": "subtitle", "time": 10781.03, "timestamp": "02:59:41", "text": "異なるものを組み合わせることができ、"}, {"type": "subtitle", "time": 10783.269, "timestamp": "02:59:43", "text": "知ってるけど、それは、それは、"}, {"type": "subtitle", "time": 10784.87, "timestamp": "02:59:44", "text": "ウェブサイトがあるのはご存知でしょう"}, {"type": "subtitle", "time": 10786.87, "timestamp": "02:59:46", "text": "さまざまなものを試すことができます"}, {"type": "subtitle", "time": 10788.469, "timestamp": "02:59:48", "text": "パターンやトリムを見つけると、"}, {"type": "subtitle", "time": 10791.11, "timestamp": "02:59:51", "text": "ループに必要なものです。おお"}, {"type": "subtitle", "time": 10793.349, "timestamp": "02:59:53", "text": "それは確かに存在する。"}, {"type": "subtitle", "time": 10798.95, "timestamp": "02:59:58", "text": "アニメーション化？"}]
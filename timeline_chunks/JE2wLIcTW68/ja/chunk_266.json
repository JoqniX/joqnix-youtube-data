[{"type": "subtitle", "time": 15985.07, "timestamp": "04:26:25", "text": "くそ、君に送るよ"}, {"type": "subtitle", "time": 15991.51, "timestamp": "04:26:31", "text": "良い。とても素敵です。私も持っています"}, {"type": "subtitle", "time": 16001.67, "timestamp": "04:26:41", "text": "ああ、ジョーはなんだか調子が悪そうだ。いいえ、いいえ、"}, {"type": "subtitle", "time": 16005.349, "timestamp": "04:26:45", "text": "いや、いや、いや。私は、えーと、"}, {"type": "subtitle", "time": 16007.75, "timestamp": "04:26:47", "text": "君にパンジャブ語を学ばせてあげるよ。来て、"}, {"type": "subtitle", "time": 16010.67, "timestamp": "04:26:50", "text": "ジョー。どこにいるの？"}, {"type": "subtitle", "time": 16013.75, "timestamp": "04:26:53", "text": "わかった。うん、いいね。これは"}, {"type": "subtitle", "time": 16016.07, "timestamp": "04:26:56", "text": "大丈夫。これは大丈夫でしょう。あなたが知っている"}]
[{"type": "subtitle", "time": 18124.07, "timestamp": "05:02:04", "text": "シンセパッドとか全部だけど、うん、"}, {"type": "subtitle", "time": 18127.27, "timestamp": "05:02:07", "text": "私はとてもイライラした。私はそれが好きではありませんでした。"}, {"type": "subtitle", "time": 18128.708, "timestamp": "05:02:08", "text": "だから私はこう思った。「よし、じゃあこうしよう。"}, {"type": "subtitle", "time": 18130.868, "timestamp": "05:02:10", "text": "誰かにお金を払ってやってもらおう。私"}, {"type": "subtitle", "time": 18134.788, "timestamp": "05:02:14", "text": "一人でやりたくないんです。"}, {"type": "subtitle", "time": 18137.11, "timestamp": "05:02:17", "text": "うん。配置も何もかも。"}, {"type": "subtitle", "time": 18171.03, "timestamp": "05:02:51", "text": "ああ、しまった。私は「あぁ、やばい」に取り組まなければならない。"}, {"type": "subtitle", "time": 18174.788, "timestamp": "05:02:54", "text": "忘れた。 ASMRに取り組まなければならない。"}, {"type": "subtitle", "time": 18177.27, "timestamp": "05:02:57", "text": "ああ、なぜ？"}]
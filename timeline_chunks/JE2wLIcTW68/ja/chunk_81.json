[{"type": "subtitle", "time": 4861.03, "timestamp": "01:21:01", "text": "大きい方。 1つ。一つしかない"}, {"type": "subtitle", "time": 4867.59, "timestamp": "01:21:07", "text": "むっとしてた。転がし続けろ。ローリング。"}, {"type": "subtitle", "time": 4870.43, "timestamp": "01:21:10", "text": "ローリング。ローリング。ローリング。私"}, {"type": "subtitle", "time": 4872.669, "timestamp": "01:21:12", "text": "愛してる"}, {"type": "subtitle", "time": 4881.59, "timestamp": "01:21:21", "text": "スパム。スパム。スパム。スパム。そのままにしておいてください"}, {"type": "subtitle", "time": 4890.95, "timestamp": "01:21:30", "text": "わかった。 51."}, {"type": "subtitle", "time": 4900.59, "timestamp": "01:21:40", "text": "さあ行こう。わかった。さあ行こう。ああ、なんてことだ"}, {"type": "subtitle", "time": 4903.11, "timestamp": "01:21:43", "text": "うん。転がる、転がる、転がる、"}, {"type": "subtitle", "time": 4909.669, "timestamp": "01:21:49", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 4914.79, "timestamp": "01:21:54", "text": "あ、すみません。ええ、そうです。それは邸宅です。感謝"}]
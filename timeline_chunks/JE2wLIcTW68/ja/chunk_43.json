[{"type": "subtitle", "time": 2583.829, "timestamp": "00:43:03", "text": "何てことだ。"}, {"type": "subtitle", "time": 2587.27, "timestamp": "00:43:07", "text": "あれはホームランだった。"}, {"type": "subtitle", "time": 2590.79, "timestamp": "00:43:10", "text": "あなたの持ち物。ここにいくつか投稿しました。"}, {"type": "subtitle", "time": 2593.589, "timestamp": "00:43:13", "text": "待って、あなたのスタミナはここにあります。落としました"}, {"type": "subtitle", "time": 2597.99, "timestamp": "00:43:17", "text": "それ。体力をつけることはできますか？うん、"}, {"type": "subtitle", "time": 2599.91, "timestamp": "00:43:19", "text": "もちろん。"}, {"type": "subtitle", "time": 2601.67, "timestamp": "00:43:21", "text": "スタミナが2つあります。さあ行こう。 1つ"}, {"type": "subtitle", "time": 2604.15, "timestamp": "00:43:24", "text": "あなた。そこはどこですか？一つ問題がある。その"}, {"type": "subtitle", "time": 2606.309, "timestamp": "00:43:26", "text": "反対側に。 1秒。私たちはできますか"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "野球バットでモンスターをボングする？"}, {"type": "subtitle", "time": 2612.63, "timestamp": "00:43:32", "text": "ええ、できますよ。でも、高いです。病気"}, {"type": "subtitle", "time": 2621.03, "timestamp": "00:43:41", "text": "大きくて強い。わかった。誰かスポーツマン。来て。"}, {"type": "subtitle", "time": 2624.75, "timestamp": "00:43:44", "text": "私が行きます。えっと、Qキーを押して人形にしてください"}, {"type": "subtitle", "time": 2629.19, "timestamp": "00:43:49", "text": "初め。わかった。それを私にください。ありがとう。"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "わかった。"}, {"type": "subtitle", "time": 2633.23, "timestamp": "00:43:53", "text": "ああ、ありがとうございます。"}, {"type": "subtitle", "time": 2637.99, "timestamp": "00:43:57", "text": "ニース。手榴弾をもらえますか？はい。"}, {"type": "subtitle", "time": 2639.43, "timestamp": "00:43:59", "text": "時にはそうでない場合もある。時々"}]
[{"type": "subtitle", "time": 3723.19, "timestamp": "01:02:03", "text": "アイテムを。つまり、車のことです。わかった。えっと、"}, {"type": "subtitle", "time": 3726.63, "timestamp": "01:02:06", "text": "大丈夫な人。えっと、ジョー、力のある人は誰？"}, {"type": "subtitle", "time": 3729.43, "timestamp": "01:02:09", "text": "誰が力を持っているのか？ヘッダーは持っています。"}, {"type": "subtitle", "time": 3731.51, "timestamp": "01:02:11", "text": "わかった。あなたはどれくらいの力を持っていますか？どうやって"}, {"type": "subtitle", "time": 3734.15, "timestamp": "01:02:14", "text": "あなたはどれだけの強みを持っていますか？ 1つ。 1つ。"}, {"type": "subtitle", "time": 3737.109, "timestamp": "01:02:17", "text": "1つ。わかった。なんてこった。了解しました。降りる"}, {"type": "subtitle", "time": 3739.03, "timestamp": "01:02:19", "text": "の"}, {"type": "subtitle", "time": 3741.19, "timestamp": "01:02:21", "text": "よし、誰かが実際に引っ張ることができる"}, {"type": "subtitle", "time": 3743.43, "timestamp": "01:02:23", "text": "ほら、私を見て。ああ、誰かが引っ張った"}, {"type": "subtitle", "time": 3745.75, "timestamp": "01:02:25", "text": "こんな感じ。これを別の角度から見てみましょう"}, {"type": "subtitle", "time": 3748.87, "timestamp": "01:02:28", "text": "全ての小道具。"}, {"type": "subtitle", "time": 3749.91, "timestamp": "01:02:29", "text": "私たちはそれを持つべきだと思う"}, {"type": "subtitle", "time": 3751.75, "timestamp": "01:02:31", "text": "垂直に、ですよね？だから、そうですね、"}, {"type": "subtitle", "time": 3753.829, "timestamp": "01:02:33", "text": "明らかに垂直方向ですが、角度も"}, {"type": "subtitle", "time": 3758.23, "timestamp": "01:02:38", "text": "まずはこちらです。ああ、これは"}, {"type": "subtitle", "time": 3761.91, "timestamp": "01:02:41", "text": "いいね。ああ、神様。わかった。わかった。まず、"}, {"type": "subtitle", "time": 3764.15, "timestamp": "01:02:44", "text": "こう角度をつけて"}, {"type": "subtitle", "time": 3765.51, "timestamp": "01:02:45", "text": "押しながら計算する。わかった。わかった。"}, {"type": "subtitle", "time": 3768.789, "timestamp": "01:02:48", "text": "わかった。いや、いや、いや。"}, {"type": "subtitle", "time": 3770.23, "timestamp": "01:02:50", "text": "だから、時間が経つと、"}, {"type": "subtitle", "time": 3773.109, "timestamp": "01:02:53", "text": "押し込むだけです。はい。ええと、これについては、"}, {"type": "subtitle", "time": 3774.309, "timestamp": "01:02:54", "text": "1秒。いい考えがある。私はただ"}, {"type": "subtitle", "time": 3777.19, "timestamp": "01:02:57", "text": "これを常に最優先事項として管理する。おお、"}]
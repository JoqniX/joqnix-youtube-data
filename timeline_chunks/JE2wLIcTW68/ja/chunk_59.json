[{"type": "subtitle", "time": 3546.589, "timestamp": "00:59:06", "text": "[音楽]"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "気をつけて。異なることを覚えておいてください"}, {"type": "subtitle", "time": 3578.95, "timestamp": "00:59:38", "text": "私を支持する連絡担当者"}, {"type": "subtitle", "time": 3583.67, "timestamp": "00:59:43", "text": "あなたがカードを動かす音が聞こえました。おお、"}, {"type": "subtitle", "time": 3585.99, "timestamp": "00:59:45", "text": "それはちょっと遠いですね。なぜ"}, {"type": "subtitle", "time": 3588.789, "timestamp": "00:59:48", "text": "そのままにしておけばいいんじゃない？どうすればいいのかわからない"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "本物がそれを運んでいたんだよ。"}, {"type": "subtitle", "time": 3594.63, "timestamp": "00:59:54", "text": "私はそれを持っていませんでした。あなたは私が思った"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "あなたはそれを続け、前進し続けた。そのままにしておいてください。"}]
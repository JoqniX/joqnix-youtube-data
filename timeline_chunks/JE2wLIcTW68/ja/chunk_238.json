[{"type": "subtitle", "time": 14281.07, "timestamp": "03:58:01", "text": "うん。これはあなたに"}, {"type": "subtitle", "time": 14284.309, "timestamp": "03:58:04", "text": "シャー。そしてこのボートは特にこれ"}, {"type": "subtitle", "time": 14285.95, "timestamp": "03:58:05", "text": "ボートに乗せる"}, {"type": "subtitle", "time": 14291.71, "timestamp": "03:58:11", "text": "もの"}, {"type": "subtitle", "time": 14295.07, "timestamp": "03:58:15", "text": "より軽く、これが"}, {"type": "subtitle", "time": 14298.07, "timestamp": "03:58:18", "text": "実在物。何も触らないでください。私はただ"}, {"type": "subtitle", "time": 14300.55, "timestamp": "03:58:20", "text": "現状維持したい。しかし、それは"}, {"type": "subtitle", "time": 14302.03, "timestamp": "03:58:22", "text": "あなた"}, {"type": "subtitle", "time": 14311.83, "timestamp": "03:58:31", "text": "胸に付いてくるのか、それとも"}, {"type": "subtitle", "time": 14315.75, "timestamp": "03:58:35", "text": "あのね？バービー人形を思い出す。"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "バービー。"}, {"type": "subtitle", "time": 14320.59, "timestamp": "03:58:40", "text": "うん。"}, {"type": "subtitle", "time": 14324.229, "timestamp": "03:58:44", "text": "なんて素敵なんでしょう。"}, {"type": "subtitle", "time": 14326.429, "timestamp": "03:58:46", "text": "おお、"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "私だけでしょうか、それともストリームが苦戦しているのでしょうか？"}, {"type": "subtitle", "time": 14332.67, "timestamp": "03:58:52", "text": "ええ、苦戦していますね。私のDiscordと"}, {"type": "subtitle", "time": 14336.309, "timestamp": "03:58:56", "text": "すべて。ああ、もうやめよう。私にさせて"}]
[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "今日はぐっすり眠れますように。私は好きではない"}, {"type": "subtitle", "time": 6425.43, "timestamp": "01:47:05", "text": "昨日は午前5時に寝ました。"}, {"type": "subtitle", "time": 6427.87, "timestamp": "01:47:07", "text": "したくない"}, {"type": "subtitle", "time": 6431.03, "timestamp": "01:47:11", "text": "寝る。一緒にビールを飲もうよ。食べるべきか"}, {"type": "subtitle", "time": 6438.109, "timestamp": "01:47:18", "text": "O."}, {"type": "subtitle", "time": 6455.17, "timestamp": "01:47:35", "text": "ビールは"}]
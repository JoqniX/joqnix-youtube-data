[{"type": "subtitle", "time": 4262.47, "timestamp": "01:11:02", "text": "これはこのモンスターの中で最も無傷だ"}, {"type": "subtitle", "time": 4264.07, "timestamp": "01:11:04", "text": "ゲーム。うん。あれを見てみろよ。その"}, {"type": "subtitle", "time": 4265.95, "timestamp": "01:11:05", "text": "面白い。"}, {"type": "subtitle", "time": 4269.35, "timestamp": "01:11:09", "text": "ああ、あなたは彼がいなくて寂しかったのね。あの男は"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "犯人はその男ではない。心配しないで。それは、えーと"}, {"type": "subtitle", "time": 4314.63, "timestamp": "01:11:54", "text": "待って、彼は私たちが見えていないはずだ。いいえ、彼はできません。彼"}]
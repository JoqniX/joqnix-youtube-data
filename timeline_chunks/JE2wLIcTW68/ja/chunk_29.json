[{"type": "subtitle", "time": 1744.19, "timestamp": "00:29:04", "text": "100. さあ、ズルをする人たちよ。それは"}, {"type": "subtitle", "time": 1756.23, "timestamp": "00:29:16", "text": "爆発的なスピード。 Eキーを押せばいいですか？"}, {"type": "subtitle", "time": 1758.71, "timestamp": "00:29:18", "text": "うん、Eを押して。うん、Eを押すだけ。あー、"}, {"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "スタミナについて誰が言っていたのか？ええ、そうですね。"}, {"type": "subtitle", "time": 1766.549, "timestamp": "00:29:26", "text": "それなら、スピリットスピードを選びます。"}, {"type": "subtitle", "time": 1769.51, "timestamp": "00:29:29", "text": "はい。わかった。ああ、ジョー。つまり、これが"}, {"type": "subtitle", "time": 1778.23, "timestamp": "00:29:38", "text": "おい、お前の狙いはちょっと悪かったぞ。こんにちは、"}, {"type": "subtitle", "time": 1780.07, "timestamp": "00:29:40", "text": "セレスティア。配信へようこ​​そ。私は目指します"}, {"type": "subtitle", "time": 1782.31, "timestamp": "00:29:42", "text": "ナッツのために。"}, {"type": "subtitle", "time": 1785.029, "timestamp": "00:29:45", "text": "おお。わかった、わかった、その目的は私が得た"}, {"type": "subtitle", "time": 1788.149, "timestamp": "00:29:48", "text": "範囲攻撃をしないといけないんだよ、兄弟。"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "よし、誰か他の人にこのカットを選んでもらおう"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "時間。もちろん、いろいろ見て回りますよ。"}, {"type": "subtitle", "time": 1796.07, "timestamp": "00:29:56", "text": "私はハンターだ。つまり、私は"}, {"type": "subtitle", "time": 1798.23, "timestamp": "00:29:58", "text": "必要であればカートに入れてください。ああ、あなたはただ手に入れることができます"}]
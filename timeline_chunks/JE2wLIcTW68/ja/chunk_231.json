[{"type": "subtitle", "time": 13863.83, "timestamp": "03:51:03", "text": "うん。はい、どうぞ。見る？"}, {"type": "subtitle", "time": 13871.429, "timestamp": "03:51:11", "text": "ええと、中に入ってください。中へどうぞ。立つ"}, {"type": "subtitle", "time": 13874.269, "timestamp": "03:51:14", "text": "それ。"}, {"type": "subtitle", "time": 13879.229, "timestamp": "03:51:19", "text": "うん。了解しました。了解しました。その中間。"}, {"type": "subtitle", "time": 13881.59, "timestamp": "03:51:21", "text": "うん。まるで"}, {"type": "subtitle", "time": 13889.99, "timestamp": "03:51:29", "text": "私は持っていません"}, {"type": "subtitle", "time": 13906.91, "timestamp": "03:51:46", "text": "激怒"}, {"type": "subtitle", "time": 13909.59, "timestamp": "03:51:49", "text": "要塞。ポータルを見つける必要があります"}, {"type": "subtitle", "time": 13912.07, "timestamp": "03:51:52", "text": "ここで作成できます。できるのは"}, {"type": "subtitle", "time": 13916.51, "timestamp": "03:51:56", "text": "それを見つけてください。うん。見つけるだけ"}]
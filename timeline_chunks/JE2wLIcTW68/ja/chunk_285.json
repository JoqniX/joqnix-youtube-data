[{"type": "subtitle", "time": 17105.23, "timestamp": "04:45:05", "text": "どうやって？何だって？待って。"}, {"type": "subtitle", "time": 17107.788, "timestamp": "04:45:07", "text": "はぁ？"}, {"type": "subtitle", "time": 17118.628, "timestamp": "04:45:18", "text": "待って、君たちも"}, {"type": "subtitle", "time": 17125.51, "timestamp": "04:45:25", "text": "はぁ？"}, {"type": "subtitle", "time": 17137.99, "timestamp": "04:45:37", "text": "何てことだ。ああ、なんてことだ。私は死にかけている。"}, {"type": "subtitle", "time": 17140.91, "timestamp": "04:45:40", "text": "死ぬな。"}, {"type": "subtitle", "time": 17144.27, "timestamp": "04:45:44", "text": "何？なぜ？私はできません"}, {"type": "subtitle", "time": 17147.35, "timestamp": "04:45:47", "text": "ヘルプ。私たちは文字通り"}, {"type": "subtitle", "time": 17149.51, "timestamp": "04:45:49", "text": "雲。"}, {"type": "subtitle", "time": 17152.788, "timestamp": "04:45:52", "text": "君たちはどこにいたの？"}, {"type": "subtitle", "time": 17155.75, "timestamp": "04:45:55", "text": "私は城の中にいるが、ゾンビを使うことができる。"}, {"type": "subtitle", "time": 17159.35, "timestamp": "04:45:59", "text": "なぜ？地下室があるはずだから"}]
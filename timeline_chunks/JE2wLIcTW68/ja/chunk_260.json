[{"type": "subtitle", "time": 15605.75, "timestamp": "04:20:05", "text": "あ、そういえば、アスタはアスタが言ってた"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "彼は甘い血を持っている。試してみてもいいですか？"}, {"type": "subtitle", "time": 15610.83, "timestamp": "04:20:10", "text": "彼を吸い取る？わかった、絶対にない"}, {"type": "subtitle", "time": 15615.229, "timestamp": "04:20:15", "text": "心。みんな、聞かないで"}, {"type": "subtitle", "time": 15626.03, "timestamp": "04:20:26", "text": "私は何も言わなかった。私は言った"}, {"type": "subtitle", "time": 15629.11, "timestamp": "04:20:29", "text": "何もない。どういう意味ですか？"}, {"type": "subtitle", "time": 15631.67, "timestamp": "04:20:31", "text": "なぜ私の後を追ってくるの？私を殺さないで"}, {"type": "subtitle", "time": 15634.71, "timestamp": "04:20:34", "text": "なぜなら私はしたいから私はしたいから私の"}, {"type": "subtitle", "time": 15637.83, "timestamp": "04:20:37", "text": "ズボン？ズボン？"}, {"type": "subtitle", "time": 15645.71, "timestamp": "04:20:45", "text": "予備のペアがあります。心配しないで。"}]
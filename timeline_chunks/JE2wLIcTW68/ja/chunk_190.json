[{"type": "subtitle", "time": 11400.79, "timestamp": "03:10:00", "text": "きれいな女性が登場する何か"}, {"type": "subtitle", "time": 11403.59, "timestamp": "03:10:03", "text": "箱か何かで人がやってきて"}, {"type": "subtitle", "time": 11406.15, "timestamp": "03:10:06", "text": "ここで待ち合わせましょう。うん。"}, {"type": "subtitle", "time": 11409.349, "timestamp": "03:10:09", "text": "それは何と呼ばれていますか？待って、こうやって。"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "そう、フォークみたいにね。ええ、ありました"}, {"type": "subtitle", "time": 11415.83, "timestamp": "03:10:15", "text": "そんな感じ。うん、"}, {"type": "subtitle", "time": 11423.59, "timestamp": "03:10:23", "text": "これは一体何だと思いますか？"}, {"type": "subtitle", "time": 11440.03, "timestamp": "03:10:40", "text": "ベルも付けるつもりだった"}, {"type": "subtitle", "time": 11442.79, "timestamp": "03:10:42", "text": "彼女が眠っている間に私たちが"}, {"type": "subtitle", "time": 11445.19, "timestamp": "03:10:45", "text": "彼女を起こして。"}, {"type": "subtitle", "time": 11456.15, "timestamp": "03:10:56", "text": "ジョー、私たちの基地を見た？"}, {"type": "subtitle", "time": 11459.11, "timestamp": "03:10:59", "text": "我々の基地は破壊された。"}]
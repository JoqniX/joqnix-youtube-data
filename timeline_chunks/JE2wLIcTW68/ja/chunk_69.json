[{"type": "subtitle", "time": 4141.03, "timestamp": "01:09:01", "text": "くそ。お前は本当に負け犬だな。あなたは"}, {"type": "subtitle", "time": 4147.59, "timestamp": "01:09:07", "text": "ジョン、君は負け犬の王様だよ。私"}, {"type": "subtitle", "time": 4149.349, "timestamp": "01:09:09", "text": "彼は和平を申し出たのに、私を殺した。"}, {"type": "subtitle", "time": 4158.149, "timestamp": "01:09:18", "text": "いやあ、すごかったな。"}, {"type": "subtitle", "time": 4160.789, "timestamp": "01:09:20", "text": "先ほども言ったように、ランは彼の"}, {"type": "subtitle", "time": 4163.87, "timestamp": "01:09:23", "text": "心。うん、そうは思わない"}, {"type": "subtitle", "time": 4173.349, "timestamp": "01:09:33", "text": "ああ、色を変えることができるよ。ニース。うん。"}, {"type": "subtitle", "time": 4179.55, "timestamp": "01:09:39", "text": "開始時期を教えてください"}, {"type": "subtitle", "time": 4183.43, "timestamp": "01:09:43", "text": "また。準備ができて？"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "うん。さあ行こう。こんにちは。"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "準備はいいですか？準備はできたか？うん。私は"}, {"type": "subtitle", "time": 4193.829, "timestamp": "01:09:53", "text": "さあ行こう。"}, {"type": "subtitle", "time": 4195.91, "timestamp": "01:09:55", "text": "なぜ私たちはサウスパークのような話し方をするのでしょうか？"}]
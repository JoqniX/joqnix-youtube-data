[{"type": "subtitle", "time": 19621.67, "timestamp": "05:27:01", "text": "たくさんの曲を知っている。私の弟は"}, {"type": "subtitle", "time": 19625.19, "timestamp": "05:27:05", "text": "アリアーニの曲。うん。"}, {"type": "subtitle", "time": 19634.31, "timestamp": "05:27:14", "text": "話すときに私の声のトーンが適切に変わります"}, {"type": "subtitle", "time": 19639.19, "timestamp": "05:27:19", "text": "私の周り。うん、好きになれるよ。うん、私も"}, {"type": "subtitle", "time": 19641.19, "timestamp": "05:27:21", "text": "知る。あなたは恐怖を感じるでしょう"}, {"type": "subtitle", "time": 19642.47, "timestamp": "05:27:22", "text": "私が話す方法。あなたは考えるでしょう"}, {"type": "subtitle", "time": 19644.47, "timestamp": "05:27:24", "text": "それはなんて失礼なことか。でも、それは失礼なことではない。"}, {"type": "subtitle", "time": 19646.948, "timestamp": "05:27:26", "text": "わかってる、わかってるよ。うん、わかってる。"}, {"type": "subtitle", "time": 19649.83, "timestamp": "05:27:29", "text": "問題とはそういうものだ。ええ、それは"}, {"type": "subtitle", "time": 19656.708, "timestamp": "05:27:36", "text": "私は歌を知っている。わかりません。私はしません"}, {"type": "subtitle", "time": 19658.788, "timestamp": "05:27:38", "text": "何も思いつかないと思う"}, {"type": "subtitle", "time": 19674.91, "timestamp": "05:27:54", "text": "それ。ああ、"}, {"type": "subtitle", "time": 19678.47, "timestamp": "05:27:58", "text": "神。人々は今、寝ています。"}]
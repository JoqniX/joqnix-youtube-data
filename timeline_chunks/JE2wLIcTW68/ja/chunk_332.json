[{"type": "subtitle", "time": 19921.11, "timestamp": "05:32:01", "text": "[音楽]"}, {"type": "subtitle", "time": 19925.03, "timestamp": "05:32:05", "text": "誰かが私にトマトを作ってくれた。何？その"}, {"type": "subtitle", "time": 19934.548, "timestamp": "05:32:14", "text": "うん。彼らは私を犬にしてマララムを歌わせた"}, {"type": "subtitle", "time": 19937.75, "timestamp": "05:32:17", "text": "歌。でも、私にはできないなんて言わないで"}, {"type": "subtitle", "time": 19940.31, "timestamp": "05:32:20", "text": "マララム語の歌を歌ってください。私は聞きません。"}, {"type": "subtitle", "time": 19944.15, "timestamp": "05:32:24", "text": "歌わなければならない。はい、ありますね。しないで"}, {"type": "subtitle", "time": 19946.23, "timestamp": "05:32:26", "text": "やってみて。あなたは歌い方を学んでいます。あなた"}, {"type": "subtitle", "time": 19948.75, "timestamp": "05:32:28", "text": "マララムを歌わなければならない。あなたは私が"}, {"type": "subtitle", "time": 19951.19, "timestamp": "05:32:31", "text": "学ぶ？いいえ、私は英語を勉強していません"}, {"type": "subtitle", "time": 19953.91, "timestamp": "05:32:33", "text": "歌。 D. 日本語で行く"}, {"type": "subtitle", "time": 19955.91, "timestamp": "05:32:35", "text": "何らかの理由で。"}, {"type": "subtitle", "time": 19965.27, "timestamp": "05:32:45", "text": "ほら、ほら、私たちはそれを歌えるよ。"}, {"type": "subtitle", "time": 19969.31, "timestamp": "05:32:49", "text": "なんてこった。いや、いや、いや、いや。私は聞いた"}]
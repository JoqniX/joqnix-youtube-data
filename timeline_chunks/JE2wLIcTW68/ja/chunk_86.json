[{"type": "subtitle", "time": 5168.83, "timestamp": "01:26:08", "text": "ああ、"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "神。それはできないんですね？ええ、"}, {"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "狭い場所ではローブを着るのは難しい。"}, {"type": "subtitle", "time": 5179.189, "timestamp": "01:26:19", "text": "ああ。このバカ女。こっちに来い、もしくは"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "私の。他の場所でも。"}, {"type": "subtitle", "time": 5185.189, "timestamp": "01:26:25", "text": "みんな、僕たち生きてる？私は死んだ。ああ、決して"}, {"type": "subtitle", "time": 5186.669, "timestamp": "01:26:26", "text": "心。誰かの"}, {"type": "subtitle", "time": 5188.99, "timestamp": "01:26:28", "text": "死んだ。それは違う"}, {"type": "subtitle", "time": 5193.87, "timestamp": "01:26:33", "text": "良い。よし、"}, {"type": "subtitle", "time": 5195.99, "timestamp": "01:26:35", "text": "手順。手順については、わかりません"}, {"type": "subtitle", "time": 5204.79, "timestamp": "01:26:44", "text": "平均。ここに誰がいるんだ？何？何？何？"}, {"type": "subtitle", "time": 5206.59, "timestamp": "01:26:46", "text": "ダクトテープ"}, {"type": "subtitle", "time": 5208.59, "timestamp": "01:26:48", "text": "手榴弾。おお、"}, {"type": "subtitle", "time": 5211.87, "timestamp": "01:26:51", "text": "わかった。それなら、それをもらおう。"}]
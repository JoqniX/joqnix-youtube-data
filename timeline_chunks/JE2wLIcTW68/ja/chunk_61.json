[{"type": "subtitle", "time": 3673.829, "timestamp": "01:01:13", "text": "どうしてこんなに外してしまうんだろう？"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "えっと、君たち冷蔵庫の中確認した？おお、"}, {"type": "subtitle", "time": 3678.309, "timestamp": "01:01:18", "text": "ここにはたくさんの商品があります。おお、"}, {"type": "subtitle", "time": 3702.63, "timestamp": "01:01:42", "text": "ええ、そこが脱出地点でした。"}, {"type": "subtitle", "time": 3704.069, "timestamp": "01:01:44", "text": "それが私の狙いでした。来て。"}, {"type": "subtitle", "time": 3705.27, "timestamp": "01:01:45", "text": "これから勉強します。もうない"}, {"type": "subtitle", "time": 3709.109, "timestamp": "01:01:49", "text": "寝ている。さあ、行こう、ライアン。ついに、"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "ついに。ああ、わかりました。えーと、これは"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "チームワークなど、多くのことを必要とします。ええ、私は"}, {"type": "subtitle", "time": 3717.75, "timestamp": "01:01:57", "text": "知る。 2 チームくらいでプッシュする必要がある"}, {"type": "subtitle", "time": 3719.91, "timestamp": "01:01:59", "text": "大きなアイテムを素早く押し込み、小さなアイテムを素早く押し込む"}]
[{"type": "subtitle", "time": 11050.67, "timestamp": "03:04:10", "text": "洞窟がある。ああ、"}, {"type": "subtitle", "time": 11055.349, "timestamp": "03:04:15", "text": "こんにちは、洞窟。彼らはどこへ行くのか？ああ、これだ。"}, {"type": "subtitle", "time": 11057.349, "timestamp": "03:04:17", "text": "何てことだ。まるで国全体みたいだ"}, {"type": "subtitle", "time": 11060.469, "timestamp": "03:04:20", "text": "こちらです。いや、すごい。"}, {"type": "subtitle", "time": 11062.63, "timestamp": "03:04:22", "text": "実は、"}, {"type": "subtitle", "time": 11064.429, "timestamp": "03:04:24", "text": "なんて大きな"}, {"type": "subtitle", "time": 11067.67, "timestamp": "03:04:27", "text": "洞窟。水中にも洞窟が存在する可能性がある。"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "おお。"}, {"type": "subtitle", "time": 11071.51, "timestamp": "03:04:31", "text": "うん、"}, {"type": "subtitle", "time": 11074.55, "timestamp": "03:04:34", "text": "とても大きい。いいえ。ええ。あなたはまだ"}, {"type": "subtitle", "time": 11076.95, "timestamp": "03:04:36", "text": "見たところ、大きな洞窟がたくさんある。"}, {"type": "subtitle", "time": 11079.99, "timestamp": "03:04:39", "text": "それよりも。ああ、神様。"}, {"type": "subtitle", "time": 11088.309, "timestamp": "03:04:48", "text": "槍を持った博士がアセロットを殺す"}]
[{"type": "subtitle", "time": 19864.03, "timestamp": "05:31:04", "text": "うん。私にさせて"}, {"type": "subtitle", "time": 19874.548, "timestamp": "05:31:14", "text": "[音楽]"}, {"type": "subtitle", "time": 19878.31, "timestamp": "05:31:18", "text": "それは聞いたことがない。なんてこった。わかった。待って。"}, {"type": "subtitle", "time": 19913.51, "timestamp": "05:31:53", "text": "ニース。そして私はとても奇妙でとても"}]
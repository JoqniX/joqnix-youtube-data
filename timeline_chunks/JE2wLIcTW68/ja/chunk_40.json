[{"type": "subtitle", "time": 2404.79, "timestamp": "00:40:04", "text": "午後。今、私は行くように命じられた"}, {"type": "subtitle", "time": 2407.03, "timestamp": "00:40:07", "text": "お店に行くには行かなくていいので、私には無理です。くそ、それは"}, {"type": "subtitle", "time": 2409.829, "timestamp": "00:40:09", "text": "最悪だ。まあ、しっかり世話して"}, {"type": "subtitle", "time": 2412.03, "timestamp": "00:40:12", "text": "あなた自身、"}, {"type": "subtitle", "time": 2415.03, "timestamp": "00:40:15", "text": "お客様。ああ、うわ、うわ、うわ、うわ、うわ。"}, {"type": "subtitle", "time": 2417.75, "timestamp": "00:40:17", "text": "ああ、あなたを避けられて本当によかった"}, {"type": "subtitle", "time": 2419.51, "timestamp": "00:40:19", "text": "くそっ。"}, {"type": "subtitle", "time": 2423.51, "timestamp": "00:40:23", "text": "絶対にめちゃくちゃじゃなかった。"}, {"type": "subtitle", "time": 2431.03, "timestamp": "00:40:31", "text": "わかった。"}, {"type": "subtitle", "time": 2435.349, "timestamp": "00:40:35", "text": "うん。よし。最後の項目です。何ですか"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "おそらく期末試験でしょう。いくつかあります"}, {"type": "subtitle", "time": 2438.43, "timestamp": "00:40:38", "text": "貝殻"}]
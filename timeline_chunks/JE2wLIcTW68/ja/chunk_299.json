[{"type": "subtitle", "time": 17942.39, "timestamp": "04:59:02", "text": "つまり、こうなるということです。"}, {"type": "subtitle", "time": 17944.59, "timestamp": "04:59:04", "text": "口ずさむ必要がある"}, {"type": "subtitle", "time": 17948.948, "timestamp": "04:59:08", "text": "そして歌詞によると"}, {"type": "subtitle", "time": 17950.19, "timestamp": "04:59:10", "text": "ビートのように"}, {"type": "subtitle", "time": 17955.47, "timestamp": "04:59:15", "text": "シグネチャーの4バー1x4、その他諸々。"}, {"type": "subtitle", "time": 17965.51, "timestamp": "04:59:25", "text": "私はプラグインを使用しました。私が"}, {"type": "subtitle", "time": 17969.35, "timestamp": "04:59:29", "text": "今、私の先生が私たちに教えてくれたこと"}, {"type": "subtitle", "time": 17972.39, "timestamp": "04:59:32", "text": "プラグインとかそういうもの。あれはすごかった。私は"}, {"type": "subtitle", "time": 17975.51, "timestamp": "04:59:35", "text": "とてもショックだった。私たちはとてもショックを受けました"}, {"type": "subtitle", "time": 17979.27, "timestamp": "04:59:39", "text": "これをしてください。ああ、あれはすごくかっこよかった。"}, {"type": "subtitle", "time": 17982.39, "timestamp": "04:59:42", "text": "どのプラグインを使用しましたか？私はしません"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "本当に覚えておいてください。それはどのようなタイプですか"}, {"type": "subtitle", "time": 17988.07, "timestamp": "04:59:48", "text": "えっと、オーディオ関係？"}, {"type": "subtitle", "time": 17992.47, "timestamp": "04:59:52", "text": "いや、それは、えーと、最初のすごく基本的なものだったんだ"}, {"type": "subtitle", "time": 17995.91, "timestamp": "04:59:55", "text": "ノイズのようなもの。圧縮できます"}, {"type": "subtitle", "time": 17999.91, "timestamp": "04:59:59", "text": "騒音とか色々あってそれから"}]
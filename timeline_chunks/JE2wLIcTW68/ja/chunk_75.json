[{"type": "subtitle", "time": 4500.87, "timestamp": "01:15:00", "text": "よし、他に何があるか見てみよう"}, {"type": "subtitle", "time": 4533.75, "timestamp": "01:15:33", "text": "左側の部屋を見てみます。"}, {"type": "subtitle", "time": 4536.55, "timestamp": "01:15:36", "text": "わかった。開いていないので、"}, {"type": "subtitle", "time": 4550.99, "timestamp": "01:15:50", "text": "それは何ですか？不気味な"}, {"type": "subtitle", "time": 4553.229, "timestamp": "01:15:53", "text": "気味の悪い"}, {"type": "subtitle", "time": 4557.59, "timestamp": "01:15:57", "text": "不気味に笑う巨大なもの。うん。"}]
[{"type": "subtitle", "time": 20165.43, "timestamp": "05:36:05", "text": "私はその曲が好きです。"}, {"type": "subtitle", "time": 20168.31, "timestamp": "05:36:08", "text": "あなたは日本語の歌がとても上手ですね。どうやって"}, {"type": "subtitle", "time": 20172.07, "timestamp": "05:36:12", "text": "同じ記譜法と音程で歌う"}, {"type": "subtitle", "time": 20174.868, "timestamp": "05:36:14", "text": "とかそういうの？スコレ。"}, {"type": "subtitle", "time": 20177.51, "timestamp": "05:36:17", "text": "私はそれを学んだ。私はこの曲が本当に好きです。"}, {"type": "subtitle", "time": 20179.91, "timestamp": "05:36:19", "text": "私も日本語を学びました。あなたはしたい"}, {"type": "subtitle", "time": 20181.75, "timestamp": "05:36:21", "text": "聞こえましたか？"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "いいえ、実は私はひながなを習いました"}, {"type": "subtitle", "time": 20197.67, "timestamp": "05:36:37", "text": "そしてついに"}, {"type": "subtitle", "time": 20199.91, "timestamp": "05:36:39", "text": "意味を理解する"}, {"type": "subtitle", "time": 20201.51, "timestamp": "05:36:41", "text": "何でも読み取れるポイント"}, {"type": "subtitle", "time": 20203.59, "timestamp": "05:36:43", "text": "日本語ですが、私は好きになる方法がわかりませんでした"}, {"type": "subtitle", "time": 20205.27, "timestamp": "05:36:45", "text": "意味は分からなかったけど、読むことはできる"}, {"type": "subtitle", "time": 20208.868, "timestamp": "05:36:48", "text": "何でも何でも。おお。ああ、それを手に入れたよ"}, {"type": "subtitle", "time": 20210.708, "timestamp": "05:36:50", "text": "良いですね。私は"}]
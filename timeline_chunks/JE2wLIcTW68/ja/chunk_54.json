[{"type": "subtitle", "time": 3242.63, "timestamp": "00:54:02", "text": "そこには。彼女のお尻もそこにあるのか？ああ、わかりました。"}, {"type": "subtitle", "time": 3256.549, "timestamp": "00:54:16", "text": "死ぬのか？私はこれをやらなきゃいけないんだよね？全て"}, {"type": "subtitle", "time": 3261.549, "timestamp": "00:54:21", "text": "私の友人は死んでしまった。何てことだ。おお"}, {"type": "subtitle", "time": 3265.1, "timestamp": "00:54:25", "text": "我が神よ。"}, {"type": "subtitle", "time": 3285.19, "timestamp": "00:54:45", "text": "これです。"}, {"type": "subtitle", "time": 3287.43, "timestamp": "00:54:47", "text": "カードに入れておけますよ。私は作ります"}, {"type": "subtitle", "time": 3290.23, "timestamp": "00:54:50", "text": "本当に申し訳ありません。怖がらせるつもりはなかったんです。"}, {"type": "subtitle", "time": 3294.23, "timestamp": "00:54:54", "text": "あなたを怖がらせるつもりはなかったんです。"}, {"type": "subtitle", "time": 3297.67, "timestamp": "00:54:57", "text": "待って、これは何？前に置いたもの"}]
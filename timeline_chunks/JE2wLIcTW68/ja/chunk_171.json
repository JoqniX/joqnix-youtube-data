[{"type": "subtitle", "time": 10260.79, "timestamp": "02:51:00", "text": "負荷。そしてプラグイン。これで簡単に"}, {"type": "subtitle", "time": 10263.67, "timestamp": "02:51:03", "text": "このようにインストールしてください。どれだけクレイジーか"}, {"type": "subtitle", "time": 10275.59, "timestamp": "02:51:15", "text": "は"}, {"type": "subtitle", "time": 10294.99, "timestamp": "02:51:34", "text": "彼女"}, {"type": "subtitle", "time": 10297.21, "timestamp": "02:51:37", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 10300.63, "timestamp": "02:51:40", "text": "[音楽]"}, {"type": "subtitle", "time": 10309.15, "timestamp": "02:51:49", "text": "え、まだ荷物持ってるの？私は破壊した"}, {"type": "subtitle", "time": 10313.03, "timestamp": "02:51:53", "text": "溶岩の中に全てが。"}, {"type": "subtitle", "time": 10315.03, "timestamp": "02:51:55", "text": "いつ私の城を破壊したのですか？いいえ、いいえ、"}, {"type": "subtitle", "time": 10318.55, "timestamp": "02:51:58", "text": "いいえ。私は破壊しました それはあなた自身のものですか"}]
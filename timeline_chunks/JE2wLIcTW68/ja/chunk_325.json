[{"type": "subtitle", "time": 19501.788, "timestamp": "05:25:01", "text": "私のナヌにマギーに何か言って"}, {"type": "subtitle", "time": 19506.47, "timestamp": "05:25:06", "text": "やり直す前の状態のようなもの。"}, {"type": "subtitle", "time": 19509.788, "timestamp": "05:25:09", "text": "私はいつもそれを"}, {"type": "subtitle", "time": 19512.31, "timestamp": "05:25:12", "text": "マギー、マギー、そんな感じ。私"}, {"type": "subtitle", "time": 19519.03, "timestamp": "05:25:19", "text": "マギー、マギー。"}, {"type": "subtitle", "time": 19520.11, "timestamp": "05:25:20", "text": "うん。"}, {"type": "subtitle", "time": 19523.51, "timestamp": "05:25:23", "text": "私はこんな感じ"}, {"type": "subtitle", "time": 19525.27, "timestamp": "05:25:25", "text": "そんな感じの話を聞いてください。おい、"}, {"type": "subtitle", "time": 19527.35, "timestamp": "05:25:27", "text": "私の話を聞いて下さい"}, {"type": "subtitle", "time": 19529.43, "timestamp": "05:25:29", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 19531.51, "timestamp": "05:25:31", "text": "スラングが多すぎる"}, {"type": "subtitle", "time": 19534.868, "timestamp": "05:25:34", "text": "パンジャブ語。どの地域にも"}, {"type": "subtitle", "time": 19536.99, "timestamp": "05:25:36", "text": "さまざまなパンジャブ語のスラング。彼らが話す場合"}, {"type": "subtitle", "time": 19539.91, "timestamp": "05:25:39", "text": "パンジャブ語はそういう感じだ。"}, {"type": "subtitle", "time": 19546.708, "timestamp": "05:25:46", "text": "だからネイティブのように"}, {"type": "subtitle", "time": 19548.628, "timestamp": "05:25:48", "text": "パンジャブ出身のパンジャブ人は"}, {"type": "subtitle", "time": 19552.07, "timestamp": "05:25:52", "text": "アクセントが異なり、"}, {"type": "subtitle", "time": 19554.31, "timestamp": "05:25:54", "text": "それは違う。"}, {"type": "subtitle", "time": 19557.43, "timestamp": "05:25:57", "text": "ドプリとビハリは違う"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "ビハール語は異なり、"}]
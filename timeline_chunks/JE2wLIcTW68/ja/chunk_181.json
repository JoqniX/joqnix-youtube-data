[{"type": "subtitle", "time": 10860.15, "timestamp": "03:01:00", "text": "懸賞金がかかっていることを忘れていた。私はあなたに報奨金を与えた。"}, {"type": "subtitle", "time": 10880.95, "timestamp": "03:01:20", "text": "ねえ、水に飛び込んで。これは何ですか？"}, {"type": "subtitle", "time": 10884.99, "timestamp": "03:01:24", "text": "竹 R。竹を作ることができます。おお"}, {"type": "subtitle", "time": 10888.63, "timestamp": "03:01:28", "text": "私の。これは何ですか？これはコンデントです。それ"}, {"type": "subtitle", "time": 10890.95, "timestamp": "03:01:30", "text": "水の中が見えるようになるでしょう"}, {"type": "subtitle", "time": 10893.269, "timestamp": "03:01:33", "text": "息が楽になるよ。"}, {"type": "subtitle", "time": 10895.59, "timestamp": "03:01:35", "text": "私は決して"}, {"type": "subtitle", "time": 10898.389, "timestamp": "03:01:38", "text": "心臓の音が聞こえる。"}, {"type": "subtitle", "time": 10901.59, "timestamp": "03:01:41", "text": "それは導管です。"}, {"type": "subtitle", "time": 10904.15, "timestamp": "03:01:44", "text": "くそ。"}, {"type": "subtitle", "time": 10906.55, "timestamp": "03:01:46", "text": "これで、水中にいられる時間は"}, {"type": "subtitle", "time": 10911.469, "timestamp": "03:01:51", "text": "あなたが望むもの。それに、私はアクセロットをたくさん持っています。"}, {"type": "subtitle", "time": 10914.309, "timestamp": "03:01:54", "text": "おお。アクセロタルは"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "この場所の守護者か何か。"}, {"type": "subtitle", "time": 10919.429, "timestamp": "03:01:59", "text": "それはまるでそれを取り囲むようなものだ。ええ、使いました"}]
[{"type": "subtitle", "time": 7087.51, "timestamp": "01:58:07", "text": "26 パート1とパート1。うん。"}, {"type": "subtitle", "time": 7089.589, "timestamp": "01:58:09", "text": "昨日は、廃墟誕生イベントでした。"}, {"type": "subtitle", "time": 7090.83, "timestamp": "01:58:10", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 7095.149, "timestamp": "01:58:15", "text": "うん。私にやらせてください。スプリット"}, {"type": "subtitle", "time": 7104.709, "timestamp": "01:58:24", "text": "ここ。タイムスタンプをコピーして分割します"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "スプリット。さて、これがパート1で、パート2です。"}, {"type": "subtitle", "time": 7126.109, "timestamp": "01:58:46", "text": "一部"}, {"type": "subtitle", "time": 7136.189, "timestamp": "01:58:56", "text": "[音楽]"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "歌を歌う。新しいインスタンスを作成する必要があります"}]
[{"type": "subtitle", "time": 19441.43, "timestamp": "05:24:01", "text": "うん。うん。うん。トラブルメーカー。"}, {"type": "subtitle", "time": 19479.35, "timestamp": "05:24:39", "text": "ああ、あなたはちゃんとしたアクセントをお持ちですか？"}, {"type": "subtitle", "time": 19481.59, "timestamp": "05:24:41", "text": "俺は半分パンジャブ人だよ、兄弟。あなたは何を"}, {"type": "subtitle", "time": 19485.83, "timestamp": "05:24:45", "text": "平均？ああ、私の祖母はパンジャブ語を話す"}, {"type": "subtitle", "time": 19487.35, "timestamp": "05:24:47", "text": "きちんと。"}, {"type": "subtitle", "time": 19490.15, "timestamp": "05:24:50", "text": "なんてこった。母方の家族が話す"}, {"type": "subtitle", "time": 19492.07, "timestamp": "05:24:52", "text": "パンジャブ語で。"}, {"type": "subtitle", "time": 19495.67, "timestamp": "05:24:55", "text": "ああ、わかりました。なるほど。それが理由です。だから私は"}, {"type": "subtitle", "time": 19498.47, "timestamp": "05:24:58", "text": "私の乳母がいつもそうしていたように、今ではわかる"}]
[{"type": "subtitle", "time": 661.15, "timestamp": "00:11:01", "text": "恐怖症とかそういうのもね。"}, {"type": "subtitle", "time": 664.389, "timestamp": "00:11:04", "text": "ああ、彼はV字型みたいなものだ。"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "彼はVみたいだ。ああ、彼は中毒だ"}, {"type": "subtitle", "time": 672.79, "timestamp": "00:11:12", "text": "ゲームはああ、くそ。なんてこった。そうそう。"}, {"type": "subtitle", "time": 675.43, "timestamp": "00:11:15", "text": "ああ、"}, {"type": "subtitle", "time": 678.31, "timestamp": "00:11:18", "text": "老人は、彼は目が見えないが、"}, {"type": "subtitle", "time": 680.79, "timestamp": "00:11:20", "text": "治癒能力があり、非常に正確です"}, {"type": "subtitle", "time": 684.949, "timestamp": "00:11:24", "text": "ショット。何てことだ。そして、照準盤。お気をつけて"}, {"type": "subtitle", "time": 689.35, "timestamp": "00:11:29", "text": "彼が上がってきたとき。静かに。最後の敗者"}, {"type": "subtitle", "time": 691.75, "timestamp": "00:11:31", "text": "そこに立ってください。あれはすごく面白かった。あなたは"}, {"type": "subtitle", "time": 695.389, "timestamp": "00:11:35", "text": "まるで私が彼の仕事を知っているかのように。言えません"}, {"type": "subtitle", "time": 696.91, "timestamp": "00:11:36", "text": "何でも。"}, {"type": "subtitle", "time": 701.75, "timestamp": "00:11:41", "text": "あなたは起き上がります。どうやって起き上がればいいですか？"}, {"type": "subtitle", "time": 704.47, "timestamp": "00:11:44", "text": "これは何ですか？"}, {"type": "subtitle", "time": 706.63, "timestamp": "00:11:46", "text": "そう、君は戦うんだ。"}, {"type": "subtitle", "time": 709.269, "timestamp": "00:11:49", "text": "どうやって？私は銃を持っていません。いや、違うよ。あなた"}, {"type": "subtitle", "time": 710.63, "timestamp": "00:11:50", "text": "周りのものを選んでください"}, {"type": "subtitle", "time": 713.829, "timestamp": "00:11:53", "text": "戦闘で使用する武器。"}, {"type": "subtitle", "time": 716.19, "timestamp": "00:11:56", "text": "1対1で勝負だ。"}]
[{"type": "subtitle", "time": 2282.63, "timestamp": "00:38:02", "text": "助けてください。"}, {"type": "subtitle", "time": 2285.43, "timestamp": "00:38:05", "text": "最大数を確保しておけばよかったのに。"}, {"type": "subtitle", "time": 2287.349, "timestamp": "00:38:07", "text": "11."}, {"type": "subtitle", "time": 2291.15, "timestamp": "00:38:11", "text": "よし、彼に20点あげよう。私ならできる。彼にあげて"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "戻る。もう十分だ。もう十分だ。"}, {"type": "subtitle", "time": 2297.349, "timestamp": "00:38:17", "text": "くそっ。くそっ。ああ、くそ。それをあげて"}, {"type": "subtitle", "time": 2299.91, "timestamp": "00:38:19", "text": "彼にとって。ああ、わかりました。わかった。私はそれを"}, {"type": "subtitle", "time": 2307.589, "timestamp": "00:38:27", "text": "大丈夫。私はすでにHPは"}, {"type": "subtitle", "time": 2310.87, "timestamp": "00:38:30", "text": "今すぐ？ 15．次の項目。私は19歳です。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "では、まっすぐ進みましょう。"}, {"type": "subtitle", "time": 2315.75, "timestamp": "00:38:35", "text": "ああ、もう十分だ。わかった。わかった。そこには"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "まっすぐ前方に物体があります。私が取りに行ってきます。"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "うん。まっすぐ。ああ、終わった"}, {"type": "subtitle", "time": 2321.61, "timestamp": "00:38:41", "text": "ここ。ゴブレット。"}, {"type": "subtitle", "time": 2322.71, "timestamp": "00:38:42", "text": "[音楽]"}, {"type": "subtitle", "time": 2326.15, "timestamp": "00:38:46", "text": "ああ、彼女はアヒルをうまく仕留めたね。"}, {"type": "subtitle", "time": 2328.069, "timestamp": "00:38:48", "text": "ところで。それが"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "意図的かどうかは別として。ああ、もちろんです。"}, {"type": "subtitle", "time": 2335.19, "timestamp": "00:38:55", "text": "絶対に。もう一つあります。所有"}, {"type": "subtitle", "time": 2337.109, "timestamp": "00:38:57", "text": "の上。"}]
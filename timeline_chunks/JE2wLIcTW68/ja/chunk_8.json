[{"type": "subtitle", "time": 492.23, "timestamp": "00:08:12", "text": "2番。 1秒。 1秒。見てください"}, {"type": "subtitle", "time": 499.35, "timestamp": "00:08:19", "text": "わかった。やってみましょう。やってみましょう。やってみましょう。"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "何てことだ。"}, {"type": "subtitle", "time": 504.469, "timestamp": "00:08:24", "text": "えっと、税務署員って何ですか？たぶん私は"}, {"type": "subtitle", "time": 507.27, "timestamp": "00:08:27", "text": "料金がかかりますよね？このゲームで12個持ってるよ。"}, {"type": "subtitle", "time": 510.71, "timestamp": "00:08:30", "text": "おお。わかった。では、このドル記号は何を意味するのでしょうか？"}, {"type": "subtitle", "time": 512.31, "timestamp": "00:08:32", "text": "手？"}, {"type": "subtitle", "time": 514.389, "timestamp": "00:08:34", "text": "どうやって押すのか？あなたはカードを保持します"}, {"type": "subtitle", "time": 515.99, "timestamp": "00:08:35", "text": "そこから押し動かすんです。ただ"}, {"type": "subtitle", "time": 517.829, "timestamp": "00:08:37", "text": "それを握って、このように動かすだけです。"}, {"type": "subtitle", "time": 520.07, "timestamp": "00:08:40", "text": "どうやってこれを保持するか、そしてこれを取り除けば"}, {"type": "subtitle", "time": 522.87, "timestamp": "00:08:42", "text": "子供。左クリック。左クリック。ああ、左"}, {"type": "subtitle", "time": 526.43, "timestamp": "00:08:46", "text": "クリック。うん。はい、どうぞ。"}, {"type": "subtitle", "time": 530.15, "timestamp": "00:08:50", "text": "ニース。はい、こちらへ来てください。"}, {"type": "subtitle", "time": 531.75, "timestamp": "00:08:51", "text": "えーと、あなたはすべてを見るべきなんです"}, {"type": "subtitle", "time": 534.71, "timestamp": "00:08:54", "text": "隅々まで探して、どこにあるか見てみる。それで、"}, {"type": "subtitle", "time": 535.79, "timestamp": "00:08:55", "text": "こういうのを見ると"}, {"type": "subtitle", "time": 538.23, "timestamp": "00:08:58", "text": "ハイライトされているので、そのまま手に取ってください。くそ。なぜなら"}, {"type": "subtitle", "time": 539.91, "timestamp": "00:08:59", "text": "それらのいくつかは奇妙な効果のようなものです"}]
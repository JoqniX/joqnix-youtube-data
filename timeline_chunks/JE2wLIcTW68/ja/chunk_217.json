[{"type": "subtitle", "time": 13023.59, "timestamp": "03:37:03", "text": "ああ、最後のことだ。"}, {"type": "subtitle", "time": 13026.63, "timestamp": "03:37:06", "text": "いや、あれは私の敵だった。"}, {"type": "subtitle", "time": 13029.75, "timestamp": "03:37:09", "text": "ええ、私は歩いていることを知っています"}, {"type": "subtitle", "time": 13034.309, "timestamp": "03:37:14", "text": "靴音。ええ、それがダッシュです。"}, {"type": "subtitle", "time": 13046.07, "timestamp": "03:37:26", "text": "大丈夫です。そして一般的なラッパーは"}, {"type": "subtitle", "time": 13048.95, "timestamp": "03:37:28", "text": "馬とロバを一緒に繁殖させる。"}, {"type": "subtitle", "time": 13051.11, "timestamp": "03:37:31", "text": "ああ、馬を繁殖させて"}, {"type": "subtitle", "time": 13057.91, "timestamp": "03:37:37", "text": "おお。ロバと馬を交配させると、"}, {"type": "subtitle", "time": 13060.87, "timestamp": "03:37:40", "text": "それは何かを混ぜ合わせるだろう。"}, {"type": "subtitle", "time": 13064.11, "timestamp": "03:37:44", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "おお。ああ、彼らは違うものを追加している"}]
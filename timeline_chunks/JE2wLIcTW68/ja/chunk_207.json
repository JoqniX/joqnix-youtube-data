[{"type": "subtitle", "time": 12421.429, "timestamp": "03:27:01", "text": "ごめん。ごめん。ごめん。ごめん。ごめん。私はそうしました"}, {"type": "subtitle", "time": 12423.389, "timestamp": "03:27:03", "text": "何もない。約束します。約束します。私"}, {"type": "subtitle", "time": 12426.07, "timestamp": "03:27:06", "text": "約束。殺さないで。殺さないで。殺さないで"}, {"type": "subtitle", "time": 12438.71, "timestamp": "03:27:18", "text": "私はあなたを殺しているわけではありません。でも、そう思う"}, {"type": "subtitle", "time": 12441.349, "timestamp": "03:27:21", "text": "みつきのように、あなたは多くのことを学びました"}, {"type": "subtitle", "time": 12443.269, "timestamp": "03:27:23", "text": "マインクラフト関連のものですよね？それはあなたの"}, {"type": "subtitle", "time": 12446.469, "timestamp": "03:27:26", "text": "初めてです。うん。ええ、そうしました。今私は"}, {"type": "subtitle", "time": 12448.469, "timestamp": "03:27:28", "text": "色々なことを知っている。私はできる 私はできる 私は自分の"}, {"type": "subtitle", "time": 12451.51, "timestamp": "03:27:31", "text": "自分の家を持つ。しかし、今は小さすぎる。だから彼女は"}, {"type": "subtitle", "time": 12454.71, "timestamp": "03:27:34", "text": "忘れっぽい。何てことだ。"}]
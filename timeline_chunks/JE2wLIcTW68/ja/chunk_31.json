[{"type": "subtitle", "time": 1861.269, "timestamp": "00:31:01", "text": "ちなみに、これはほぼコードです。わかった。"}, {"type": "subtitle", "time": 1862.789, "timestamp": "00:31:02", "text": "最初の段階でより多くの情報を得るほど"}, {"type": "subtitle", "time": 1865.51, "timestamp": "00:31:05", "text": "4分の1の方がいいですよね？うん。一度"}, {"type": "subtitle", "time": 1868.789, "timestamp": "00:31:08", "text": "もう一度言いますが、これをちょっと拾い上げましょう。右。"}, {"type": "subtitle", "time": 1876.47, "timestamp": "00:31:16", "text": "ええ、私は王冠を手に入れました。ごめん。くそっ。"}, {"type": "subtitle", "time": 1878.99, "timestamp": "00:31:18", "text": "くそ。手に入れた"}, {"type": "subtitle", "time": 1882.63, "timestamp": "00:31:22", "text": "クラウン。彼らは私を"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1891.669, "timestamp": "00:31:31", "text": "ああ、このようにチェックすることもできます。"}, {"type": "subtitle", "time": 1893.43, "timestamp": "00:31:33", "text": "シャベルとかそういうもの。見て、"}, {"type": "subtitle", "time": 1900.549, "timestamp": "00:31:40", "text": "私たちは隠れるべきだ。"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "うん。"}, {"type": "subtitle", "time": 1905.669, "timestamp": "00:31:45", "text": "わかった。この物の中に隠れると、"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "ドアを閉めるのを忘れないでください。のように、"}, {"type": "subtitle", "time": 1917.99, "timestamp": "00:31:57", "text": "私は物理学の宇宙を見た。それは何"}, {"type": "subtitle", "time": 1919.99, "timestamp": "00:31:59", "text": "音？そこなら隠れられると思うよ。"}]
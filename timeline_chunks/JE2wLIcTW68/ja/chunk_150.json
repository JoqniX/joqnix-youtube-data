[{"type": "subtitle", "time": 9001.83, "timestamp": "02:30:01", "text": "私自身は、本当に本当に必要な時以外は"}, {"type": "subtitle", "time": 9005.95, "timestamp": "02:30:05", "text": "大好きです。手数料を請求します"}, {"type": "subtitle", "time": 9008.23, "timestamp": "02:30:08", "text": "誰か。ほとんどの場合、私は"}, {"type": "subtitle", "time": 9011.03, "timestamp": "02:30:11", "text": "自分で作る、なぜなら、もしあなたが作るなら"}, {"type": "subtitle", "time": 9013.07, "timestamp": "02:30:13", "text": "自分でその感覚"}, {"type": "subtitle", "time": 9015.83, "timestamp": "02:30:15", "text": "何かの功績とか、そういうことですよね？"}, {"type": "subtitle", "time": 9019.27, "timestamp": "02:30:19", "text": "達成とか、そういうやつ、ああ"}, {"type": "subtitle", "time": 9022.51, "timestamp": "02:30:22", "text": "はい、やりました。私は自分で作りました"}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "自分自身。私は何かをしました"}, {"type": "subtitle", "time": 9029.63, "timestamp": "02:30:29", "text": "自分自身。その感覚はとても気持ちいい。"}, {"type": "subtitle", "time": 9034.71, "timestamp": "02:30:34", "text": "右？ Mですが、uにも同じことが当てはまります"}, {"type": "subtitle", "time": 9036.91, "timestamp": "02:30:36", "text": "依頼を受けて仕事をする場合"}, {"type": "subtitle", "time": 9039.429, "timestamp": "02:30:39", "text": "そう、あなたはただ"}, {"type": "subtitle", "time": 9040.83, "timestamp": "02:30:40", "text": "提供する"}, {"type": "subtitle", "time": 9045.59, "timestamp": "02:30:45", "text": "高品質の製品をあなたの"}, {"type": "subtitle", "time": 9048.389, "timestamp": "02:30:48", "text": "クライアントではなく、"}, {"type": "subtitle", "time": 9051.75, "timestamp": "02:30:51", "text": "本当に退屈、もしくは本当に出来が悪い"}, {"type": "subtitle", "time": 9053.51, "timestamp": "02:30:53", "text": "あなたのクライアントは正しく行動しないでしょう"}, {"type": "subtitle", "time": 9056.95, "timestamp": "02:30:56", "text": "満足したよね、だから何か"}, {"type": "subtitle", "time": 9059.51, "timestamp": "02:30:59", "text": "他の人を満足させる、または満足させる"}]
[{"type": "subtitle", "time": 10981.269, "timestamp": "03:03:01", "text": "今。守護者とかそういうのを見たよ。"}, {"type": "subtitle", "time": 10983.349, "timestamp": "03:03:03", "text": "ええ、守護者はたくさんいますよ。"}, {"type": "subtitle", "time": 10986.309, "timestamp": "03:03:06", "text": "海底遺跡がたくさんある。"}, {"type": "subtitle", "time": 10988.55, "timestamp": "03:03:08", "text": "いいえ、私のタワーが"}, {"type": "subtitle", "time": 10992.469, "timestamp": "03:03:12", "text": "彼らから見ると、私の基地はちょっと変に見える。それ"}, {"type": "subtitle", "time": 10994.55, "timestamp": "03:03:14", "text": "そうです。まるで水中列車のようだ"}, {"type": "subtitle", "time": 11020.07, "timestamp": "03:03:40", "text": "彼女はそれほど死にかけていない。"}, {"type": "subtitle", "time": 11023.55, "timestamp": "03:03:43", "text": "私はそれほど優れていない"}]
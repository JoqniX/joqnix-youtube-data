[{"type": "subtitle", "time": 9374.03, "timestamp": "02:36:14", "text": "ストリーム。よし、明日は"}, {"type": "subtitle", "time": 9376.349, "timestamp": "02:36:16", "text": "えっと"}, {"type": "subtitle", "time": 9384.5, "timestamp": "02:36:24", "text": "友達。こんにちは、いいですね"}, {"type": "subtitle", "time": 9396.95, "timestamp": "02:36:36", "text": "ストリームは10時頃に配信されます。"}, {"type": "subtitle", "time": 9400.27, "timestamp": "02:36:40", "text": "また眠くなるだろう"}, {"type": "subtitle", "time": 9402.51, "timestamp": "02:36:42", "text": "また。"}, {"type": "subtitle", "time": 9404.69, "timestamp": "02:36:44", "text": "えっと、9時30分"}, {"type": "subtitle", "time": 9410.07, "timestamp": "02:36:50", "text": "午後それは"}, {"type": "subtitle", "time": 9411.87, "timestamp": "02:36:51", "text": "[音楽]"}]
[{"type": "subtitle", "time": 8100.31, "timestamp": "02:15:00", "text": "ビジネスとクラブ限定で、"}, {"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "他のサブは知らないけど、使ってるよ"}, {"type": "subtitle", "time": 8116.51, "timestamp": "02:15:16", "text": "えっと、これに関するDMはありますか？"}, {"type": "subtitle", "time": 8119.31, "timestamp": "02:15:19", "text": "神様、いいえ、私のDMは"}, {"type": "subtitle", "time": 8122.95, "timestamp": "02:15:22", "text": "閉店しました。実際、ほとんど閉まっている"}, {"type": "subtitle", "time": 8125.83, "timestamp": "02:15:25", "text": "が"}, {"type": "subtitle", "time": 8128.39, "timestamp": "02:15:28", "text": "共同作業の物、あなたが持っているもの"}, {"type": "subtitle", "time": 8130.189, "timestamp": "02:15:30", "text": "に"}, {"type": "subtitle", "time": 8132.629, "timestamp": "02:15:32", "text": "えっと、ただ新しい友達を作ろうとしただけです。"}, {"type": "subtitle", "time": 8134.87, "timestamp": "02:15:34", "text": "ああ、なるほど。なるほど。おい、これは車だぞ。あなた"}, {"type": "subtitle", "time": 8143.109, "timestamp": "02:15:43", "text": "信じて、だって今私は試しているから"}, {"type": "subtitle", "time": 8145.589, "timestamp": "02:15:45", "text": "人との悪い経験をいくつか"}, {"type": "subtitle", "time": 8149.03, "timestamp": "02:15:49", "text": "過去。だから、私は厳密には"}, {"type": "subtitle", "time": 8151.669, "timestamp": "02:15:51", "text": "DiscordのDMは当面制限します"}, {"type": "subtitle", "time": 8152.99, "timestamp": "02:15:52", "text": "その他"}, {"type": "subtitle", "time": 8155.149, "timestamp": "02:15:55", "text": "ソーシャル。うん。"}, {"type": "subtitle", "time": 8159.189, "timestamp": "02:15:59", "text": "うん。うん。あなたもそうすべきだと思う"}]
[{"type": "subtitle", "time": 5463.8, "timestamp": "01:31:03", "text": "そうではなかった。彼は準備万端だ。"}, {"type": "subtitle", "time": 5468.669, "timestamp": "01:31:08", "text": "そこで私たちは"}, {"type": "subtitle", "time": 5472.03, "timestamp": "01:31:12", "text": "行く。少年たちは"}, {"type": "subtitle", "time": 5476.47, "timestamp": "01:31:16", "text": "戻る。さあ、行こう。もちろんさ。今私たちは"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "手に入れた"}, {"type": "subtitle", "time": 5483.189, "timestamp": "01:31:23", "text": "疲れていても。うん、わかるよね？待って、"}, {"type": "subtitle", "time": 5489.35, "timestamp": "01:31:29", "text": "私はHP1です。何てことだ。ああ、80ならできるよ。"}, {"type": "subtitle", "time": 5497.59, "timestamp": "01:31:37", "text": "くそ。わかった。わかった。イエス。あなたにあげます"}, {"type": "subtitle", "time": 5501.43, "timestamp": "01:31:41", "text": "戻ってきてくれよ、兄弟。ありがとう。どういう意味ですか？"}, {"type": "subtitle", "time": 5504.189, "timestamp": "01:31:44", "text": "何？"}, {"type": "subtitle", "time": 5508.39, "timestamp": "01:31:48", "text": "わかった。私は、私が、私が、私が、ええと、もう一度"}, {"type": "subtitle", "time": 5510.87, "timestamp": "01:31:50", "text": "ヨーコは接続を切る前に、衝撃的な事実を残した。"}, {"type": "subtitle", "time": 5518.55, "timestamp": "01:31:58", "text": "うん。ちなみに、彼らはまだ健在です。"}]
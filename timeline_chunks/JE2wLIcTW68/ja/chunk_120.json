[{"type": "subtitle", "time": 7213.87, "timestamp": "02:00:13", "text": "わかった。投稿とこれと"}, {"type": "subtitle", "time": 7216.629, "timestamp": "02:00:16", "text": "これ。それを2つのファイルに分割し、"}, {"type": "subtitle", "time": 7220.55, "timestamp": "02:00:20", "text": "輸出。わかった。さあ、待って、私はただ"}, {"type": "subtitle", "time": 7221.149, "timestamp": "02:00:21", "text": "する"}, {"type": "subtitle", "time": 7224.229, "timestamp": "02:00:24", "text": "それ。そう、このロシアのやつは"}, {"type": "subtitle", "time": 7227.03, "timestamp": "02:00:27", "text": "このゲームを今すぐプレイしよう。どのゲームだったか忘れた"}, {"type": "subtitle", "time": 7231.75, "timestamp": "02:00:31", "text": "それ？しかし、それらのRobloxゲームは、そのゲームです"}, {"type": "subtitle", "time": 7232.91, "timestamp": "02:00:32", "text": "親切"}, {"type": "subtitle", "time": 7235.669, "timestamp": "02:00:35", "text": "彼らが私にチャンネルをくれそうになった"}, {"type": "subtitle", "time": 7237.43, "timestamp": "02:00:37", "text": "YouTubeの男性に著作権侵害の申し立て"}, {"type": "subtitle", "time": 7243.51, "timestamp": "02:00:43", "text": "ビリービリー、それは違う"}, {"type": "subtitle", "time": 7245.79, "timestamp": "02:00:45", "text": "雨の地域と"}, {"type": "subtitle", "time": 7248.39, "timestamp": "02:00:48", "text": "あれは、あそこでは何もかも違う仕組みになっている。"}, {"type": "subtitle", "time": 7250.99, "timestamp": "02:00:50", "text": "著作権侵害にならないように"}, {"type": "subtitle", "time": 7255.709, "timestamp": "02:00:55", "text": "グロテスクでない限り何でもいい"}]
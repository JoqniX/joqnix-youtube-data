[{"type": "subtitle", "time": 3300.15, "timestamp": "00:55:00", "text": "待って、この抽出方法は使えません"}, {"type": "subtitle", "time": 3301.67, "timestamp": "00:55:01", "text": "ポイント。"}, {"type": "subtitle", "time": 3302.95, "timestamp": "00:55:02", "text": "いいえ、新しいものを見つけなければなりません。誰か"}, {"type": "subtitle", "time": 3304.63, "timestamp": "00:55:04", "text": "カードを持ち歩く。新しい缶を見つける"}, {"type": "subtitle", "time": 3307.51, "timestamp": "00:55:07", "text": "10HPくらいください。おお、"}, {"type": "subtitle", "time": 3309.349, "timestamp": "00:55:09", "text": "わかった。ボタンを押し続けるように"}, {"type": "subtitle", "time": 3310.99, "timestamp": "00:55:10", "text": "の"}, {"type": "subtitle", "time": 3314.47, "timestamp": "00:55:14", "text": "スポーン。はい、これで終わりです。"}, {"type": "subtitle", "time": 3316.15, "timestamp": "00:55:16", "text": "誰がまた経験値を必要とするだろうか？それは"}, {"type": "subtitle", "time": 3319.069, "timestamp": "00:55:19", "text": "助けて。わかった、行くよ"}, {"type": "subtitle", "time": 3321.43, "timestamp": "00:55:21", "text": "略奪する。私は見つけます 私は見つけます"}, {"type": "subtitle", "time": 3323.67, "timestamp": "00:55:23", "text": "抽出する。いいですね。私はそう思った。うん、"}, {"type": "subtitle", "time": 3326.63, "timestamp": "00:55:26", "text": "それはすばらしい。これも受け取ってください。"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "ありがとう。よし。あと1つ必要です"}, {"type": "subtitle", "time": 3331.91, "timestamp": "00:55:31", "text": "HP。気をつけて。うん、私も欲しいな。"}, {"type": "subtitle", "time": 3333.47, "timestamp": "00:55:33", "text": "よし、いくつか作らなきゃ"}, {"type": "subtitle", "time": 3335.75, "timestamp": "00:55:35", "text": "空間。小人。[ __ ]を殺せ。感謝"}, {"type": "subtitle", "time": 3339.27, "timestamp": "00:55:39", "text": "あなた。ああ、ノームたち。"}, {"type": "subtitle", "time": 3340.95, "timestamp": "00:55:40", "text": "まだ続くよ。ああ、"}, {"type": "subtitle", "time": 3343.109, "timestamp": "00:55:43", "text": "間違いなくそうなるだろう。よし、"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "私はここにいます。はい、ついてきてください。あ、後ろだよ。"}, {"type": "subtitle", "time": 3347.589, "timestamp": "00:55:47", "text": "あなたの後ろに。仕事。仕事はもう終わった。殺す"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "小人たち。拾い上げて叩くだけ"}, {"type": "subtitle", "time": 3352.309, "timestamp": "00:55:52", "text": "彼らを地面に倒す。彼らはあなたのところに来ますか？"}]
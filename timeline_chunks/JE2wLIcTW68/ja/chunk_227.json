[{"type": "subtitle", "time": 13622.91, "timestamp": "03:47:02", "text": "さあ、つるはしを変えて"}, {"type": "subtitle", "time": 13634.55, "timestamp": "03:47:14", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 13637.269, "timestamp": "03:47:17", "text": "待って。それは何ですか？"}, {"type": "subtitle", "time": 13640.389, "timestamp": "03:47:20", "text": "それはマグマです。私はそれが大好きです"}, {"type": "subtitle", "time": 13643.83, "timestamp": "03:47:23", "text": "私をフォローしています。あなたをフォローしています。私はしません"}, {"type": "subtitle", "time": 13654.55, "timestamp": "03:47:34", "text": "これはすごくクールだ。他のものを殺すことができます"}, {"type": "subtitle", "time": 13656.15, "timestamp": "03:47:36", "text": "構造。"}, {"type": "subtitle", "time": 13659.03, "timestamp": "03:47:39", "text": "なぜ燃えないのか？なぜなら彼らは"}]
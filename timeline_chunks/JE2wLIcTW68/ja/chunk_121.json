[{"type": "subtitle", "time": 7260.87, "timestamp": "02:01:00", "text": "あれHって、それを見て驚いた"}, {"type": "subtitle", "time": 7263.03, "timestamp": "02:01:03", "text": "私は受け取らなかった"}, {"type": "subtitle", "time": 7266.709, "timestamp": "02:01:06", "text": "中世の戦闘はどれも"}, {"type": "subtitle", "time": 7268.47, "timestamp": "02:01:08", "text": "ゲームですよね？そこにはたくさんの"}, {"type": "subtitle", "time": 7271.669, "timestamp": "02:01:11", "text": "血痕とか色々。そのゲームは"}, {"type": "subtitle", "time": 7274.91, "timestamp": "02:01:14", "text": "WAが取られなかったのは理解できない"}, {"type": "subtitle", "time": 7278.83, "timestamp": "02:01:18", "text": "どうやら下がったようだ。信じられないことに、私はとても"}, {"type": "subtitle", "time": 7281.87, "timestamp": "02:01:21", "text": "驚いた"}, {"type": "subtitle", "time": 7285.87, "timestamp": "02:01:25", "text": "えーっと、騎士道ゲームですよね？"}, {"type": "subtitle", "time": 7287.55, "timestamp": "02:01:27", "text": "騎士道精神。私"}, {"type": "subtitle", "time": 7291.83, "timestamp": "02:01:31", "text": "忘れた。えっと、あのゲームはChivalary 2か"}, {"type": "subtitle", "time": 7293.91, "timestamp": "02:01:33", "text": "３つかそれくらい。そのゲームは"}, {"type": "subtitle", "time": 7296.27, "timestamp": "02:01:36", "text": "であるはず"}, {"type": "subtitle", "time": 7300.47, "timestamp": "02:01:40", "text": "えっと、そうじゃなくて、何て言うんだっけ？"}, {"type": "subtitle", "time": 7302.31, "timestamp": "02:01:42", "text": "それには厳格なルールがある"}, {"type": "subtitle", "time": 7305.43, "timestamp": "02:01:45", "text": "確かストリーミング配信されていたはずです。"}, {"type": "subtitle", "time": 7308.229, "timestamp": "02:01:48", "text": "ゲームはそれらのゲームではないことに気づきました"}, {"type": "subtitle", "time": 7310.149, "timestamp": "02:01:50", "text": "そこには。彼らは特定のリストを持っている"}, {"type": "subtitle", "time": 7314.149, "timestamp": "02:01:54", "text": "重たいゲームではない"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "センサーなどを設置しなければならない"}, {"type": "subtitle", "time": 7318.87, "timestamp": "02:01:58", "text": "そして、ストリーミング配信はしてはいけない"}]
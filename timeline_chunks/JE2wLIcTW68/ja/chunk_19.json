[{"type": "subtitle", "time": 1151.19, "timestamp": "00:19:11", "text": "ああ、彼女はめちゃくちゃ動作が遅いんだよ、みんな。"}, {"type": "subtitle", "time": 1153.75, "timestamp": "00:19:13", "text": "私はあなたの後ろにいます。"}, {"type": "subtitle", "time": 1155.75, "timestamp": "00:19:15", "text": "どういう意味ですか？ああ、そうだね。によって"}, {"type": "subtitle", "time": 1157.669, "timestamp": "00:19:17", "text": "じゃあ、そんなに走らないで。それはあなたの"}, {"type": "subtitle", "time": 1161.75, "timestamp": "00:19:21", "text": "スタミナ。オーケー、ああ、そうだ"}, {"type": "subtitle", "time": 1164.39, "timestamp": "00:19:24", "text": "黄色い方。はい、持ってきます"}, {"type": "subtitle", "time": 1166.87, "timestamp": "00:19:26", "text": "これは抽出の話に戻ります。"}, {"type": "subtitle", "time": 1178.19, "timestamp": "00:19:38", "text": "容疑者"}, {"type": "subtitle", "time": 1181.43, "timestamp": "00:19:41", "text": "戻って"}, {"type": "subtitle", "time": 1184.19, "timestamp": "00:19:44", "text": "ああ、くそ。彼女はここにいる。くそ"}, {"type": "subtitle", "time": 1187.789, "timestamp": "00:19:47", "text": "それ。身を隠せ。しないで"}, {"type": "subtitle", "time": 1190.07, "timestamp": "00:19:50", "text": "あなたは大丈夫そうね。あなたは死ぬかもしれない。私はとても"}, {"type": "subtitle", "time": 1194.549, "timestamp": "00:19:54", "text": "死んだ。私はもう死にそうだ。私は飛び上がった。そうそう。"}, {"type": "subtitle", "time": 1198.15, "timestamp": "00:19:58", "text": "私は隠れていなければならないんですよね？"}]
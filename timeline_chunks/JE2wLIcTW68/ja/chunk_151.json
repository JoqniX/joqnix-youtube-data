[{"type": "subtitle", "time": 9061.91, "timestamp": "02:31:01", "text": "それを作った後のあなた自身。それはとても"}, {"type": "subtitle", "time": 9064.51, "timestamp": "02:31:04", "text": "心の中で大きな感情が湧き上がり、"}, {"type": "subtitle", "time": 9078.27, "timestamp": "02:31:18", "text": "うん。のように"}, {"type": "subtitle", "time": 9083.91, "timestamp": "02:31:23", "text": "それ。そういうことですね。えっと、それに私は"}, {"type": "subtitle", "time": 9086.63, "timestamp": "02:31:26", "text": "扱いにくい。だから私は"}, {"type": "subtitle", "time": 9088.91, "timestamp": "02:31:28", "text": "依頼する前に"}, {"type": "subtitle", "time": 9091.75, "timestamp": "02:31:31", "text": "なぜなら、私は給料が高すぎるので一緒に仕事をすることができないからです。"}, {"type": "subtitle", "time": 9093.83, "timestamp": "02:31:33", "text": "私はこだわりが強すぎるし、プロ意識が高すぎるんです。"}, {"type": "subtitle", "time": 9096.03, "timestamp": "02:31:36", "text": "だから、私がやった方がいい"}, {"type": "subtitle", "time": 9099.15, "timestamp": "02:31:39", "text": "自分自身が、"}, {"type": "subtitle", "time": 9103.389, "timestamp": "02:31:43", "text": "過剰請求されたような"}, {"type": "subtitle", "time": 9110.99, "timestamp": "02:31:50", "text": "うん。だから、私は"}]
[{"type": "subtitle", "time": 12904.389, "timestamp": "03:35:04", "text": "ニース。"}, {"type": "subtitle", "time": 12907.59, "timestamp": "03:35:07", "text": "それはもう私の物ではない。"}, {"type": "subtitle", "time": 12936.469, "timestamp": "03:35:36", "text": "ボスバーはどうやって作ったんですか？"}, {"type": "subtitle", "time": 12937.79, "timestamp": "03:35:37", "text": "いいえ、私は"}, {"type": "subtitle", "time": 12940.389, "timestamp": "03:35:40", "text": "働く。"}, {"type": "subtitle", "time": 12945.03, "timestamp": "03:35:45", "text": "ああ、思い出させるのを忘れてたよ。"}, {"type": "subtitle", "time": 12959.429, "timestamp": "03:35:59", "text": "あなたは何をしましたか？この惨状を見てください。"}]
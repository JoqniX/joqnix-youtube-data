[{"type": "subtitle", "time": 2700.79, "timestamp": "00:45:00", "text": "より良い。"}, {"type": "subtitle", "time": 2702.95, "timestamp": "00:45:02", "text": "もう他に何もない。えっと、もし誰かが"}, {"type": "subtitle", "time": 2704.47, "timestamp": "00:45:04", "text": "欲しい人がいたら"}, {"type": "subtitle", "time": 2706.95, "timestamp": "00:45:06", "text": "健康であれば、彼らはできる。私はすでに1つ購入しました"}, {"type": "subtitle", "time": 2709.589, "timestamp": "00:45:09", "text": "自分の健康のために。あ、待って。私はああ、"}, {"type": "subtitle", "time": 2711.99, "timestamp": "00:45:11", "text": "待って。これは…ああ、それはトイレじゃない。"}, {"type": "subtitle", "time": 2714.069, "timestamp": "00:45:14", "text": "トイレをサボるなんて無理だ。くそっ"}, {"type": "subtitle", "time": 2716.87, "timestamp": "00:45:16", "text": "それ。わかりました、ではこれを買います。わかった。"}, {"type": "subtitle", "time": 2719.829, "timestamp": "00:45:19", "text": "ああ、みんな。見て、それは、それは"}, {"type": "subtitle", "time": 2722.87, "timestamp": "00:45:22", "text": "ナ。スプリント速度というものがある。そこには"}, {"type": "subtitle", "time": 2724.39, "timestamp": "00:45:24", "text": "必要であれば、スプリント速度をアップグレードできます。いいえ、"}, {"type": "subtitle", "time": 2732.87, "timestamp": "00:45:32", "text": "全員のHPは満タンですか？"}, {"type": "subtitle", "time": 2736.55, "timestamp": "00:45:36", "text": "私は100です。私は95です。"}, {"type": "subtitle", "time": 2738.309, "timestamp": "00:45:38", "text": "待って、あそこに無料のものがあるよ"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "ここ。いや、やっぱりいいや。無料ではありません。"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "やりたければ、そのグリッチを使っても構いません。できますか"}, {"type": "subtitle", "time": 2747.75, "timestamp": "00:45:47", "text": "無料ではありません。そのグリッチのやり方は？えっと、"}, {"type": "subtitle", "time": 2750.23, "timestamp": "00:45:50", "text": "船が動き出したら、スパムを開始"}, {"type": "subtitle", "time": 2752.95, "timestamp": "00:45:52", "text": "E がそれについています。よし、船に乗って。始める"}, {"type": "subtitle", "time": 2756.55, "timestamp": "00:45:56", "text": "Eを連打。みんな準備はいい？うん。始める"}, {"type": "subtitle", "time": 2758.43, "timestamp": "00:45:58", "text": "スパム行為"}]
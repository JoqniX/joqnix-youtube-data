[{"type": "subtitle", "time": 13283.95, "timestamp": "03:41:23", "text": "また、耐火性、事故時の健康への影響も"}, {"type": "subtitle", "time": 13286.03, "timestamp": "03:41:26", "text": "再生"}, {"type": "subtitle", "time": 13287.87, "timestamp": "03:41:27", "text": "抵抗。"}, {"type": "subtitle", "time": 13295.91, "timestamp": "03:41:35", "text": "どこ？"}, {"type": "subtitle", "time": 13297.429, "timestamp": "03:41:37", "text": "おお、"}, {"type": "subtitle", "time": 13300.75, "timestamp": "03:41:40", "text": "何？それは それは それは それは"}, {"type": "subtitle", "time": 13308.63, "timestamp": "03:41:48", "text": "[音楽]"}, {"type": "subtitle", "time": 13311.67, "timestamp": "03:41:51", "text": "何かが撃たれたとき"}, {"type": "subtitle", "time": 13314.95, "timestamp": "03:41:54", "text": "それでは、左クリックしてみましょう。あなた"}, {"type": "subtitle", "time": 13317.269, "timestamp": "03:41:57", "text": "それをそらすことができる。"}]
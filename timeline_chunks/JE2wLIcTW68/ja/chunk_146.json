[{"type": "subtitle", "time": 8760.95, "timestamp": "02:26:00", "text": "YouTube。そのため人々は"}, {"type": "subtitle", "time": 8764.23, "timestamp": "02:26:04", "text": "えっと、代わりにTwitchでやってみて。"}, {"type": "subtitle", "time": 8766.63, "timestamp": "02:26:06", "text": "サブマラソンとかイベントとか"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "彼らはそうする。それで、私が自分の物でやったことは"}, {"type": "subtitle", "time": 8772.95, "timestamp": "02:26:12", "text": "ジョッカソンに参加しているので"}, {"type": "subtitle", "time": 8777.389, "timestamp": "02:26:17", "text": "6月12日まであと4ヶ月、または"}, {"type": "subtitle", "time": 8779.07, "timestamp": "02:26:19", "text": "6月。"}, {"type": "subtitle", "time": 8782.79, "timestamp": "02:26:22", "text": "ええ、そうですね。それで私が選んだのは、"}, {"type": "subtitle", "time": 8785.87, "timestamp": "02:26:25", "text": "パステルブルーの色を月の"}, {"type": "subtitle", "time": 8789.59, "timestamp": "02:26:29", "text": "3月とパステルパープルは私の"}, {"type": "subtitle", "time": 8792.11, "timestamp": "02:26:32", "text": "右目。パステルブルーは私の左目でした"}, {"type": "subtitle", "time": 8796.95, "timestamp": "02:26:36", "text": "色。 4月は紫色で、私は…"}, {"type": "subtitle", "time": 8799.99, "timestamp": "02:26:39", "text": "私は5月のようにするでしょう"}, {"type": "subtitle", "time": 8802.95, "timestamp": "02:26:42", "text": "ピンクがかった色で、6月は白っぽい色になります"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "色を塗って、6月が最後の追い込みだから"}, {"type": "subtitle", "time": 8808.55, "timestamp": "02:26:48", "text": "このイベントのために。それから日本に行く"}, {"type": "subtitle", "time": 8811.469, "timestamp": "02:26:51", "text": "そして、"}, {"type": "subtitle", "time": 8813.91, "timestamp": "02:26:53", "text": "7月。ええ、いろいろありました。しかし"}, {"type": "subtitle", "time": 8816.309, "timestamp": "02:26:56", "text": "ええ、その前は毎日"}, {"type": "subtitle", "time": 8818.15, "timestamp": "02:26:58", "text": "ゲームで新しいサムネイルなどを作成する"}]
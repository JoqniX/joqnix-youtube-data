[{"type": "subtitle", "time": 13581.11, "timestamp": "03:46:21", "text": "ああ、来たよ。待って、それはできないよ。"}, {"type": "subtitle", "time": 13597.99, "timestamp": "03:46:37", "text": "菌類。わかった。私はそれを与える、私はそれを与える、私はそれを与える"}, {"type": "subtitle", "time": 13607.51, "timestamp": "03:46:47", "text": "えっと、それはあなたのインベントリの中にあります。入れる"}]
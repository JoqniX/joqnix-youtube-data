[{"type": "subtitle", "time": 18060.628, "timestamp": "05:01:00", "text": "私は自分の曲の編集はすべてこのソフトで行っています。"}, {"type": "subtitle", "time": 18068.23, "timestamp": "05:01:08", "text": "私は音楽を作りたい。私は作りたい"}, {"type": "subtitle", "time": 18069.75, "timestamp": "05:01:09", "text": "音楽。"}, {"type": "subtitle", "time": 18072.788, "timestamp": "05:01:12", "text": "ただ、時間が足りないんです。"}, {"type": "subtitle", "time": 18075.67, "timestamp": "05:01:15", "text": "芸術についても同じことが言える。"}, {"type": "subtitle", "time": 18078.15, "timestamp": "05:01:18", "text": "不足にどう対処しますか"}, {"type": "subtitle", "time": 18085.75, "timestamp": "05:01:25", "text": "ああ、君も心の中に歌があるよね"}, {"type": "subtitle", "time": 18088.47, "timestamp": "05:01:28", "text": "しかし、それをソフトウェアで実現するのは難しい"}, {"type": "subtitle", "time": 18090.91, "timestamp": "05:01:30", "text": "一瞬。"}, {"type": "subtitle", "time": 18093.75, "timestamp": "05:01:33", "text": "そう、だから私はそれを完成させなかったんだ。"}, {"type": "subtitle", "time": 18096.15, "timestamp": "05:01:36", "text": "私が話していた歌、知ってるでしょ？"}, {"type": "subtitle", "time": 18098.39, "timestamp": "05:01:38", "text": "曲について、現在の"}, {"type": "subtitle", "time": 18102.868, "timestamp": "05:01:42", "text": "歌ったばかりです。歌詞を書いたのは"}, {"type": "subtitle", "time": 18106.15, "timestamp": "05:01:46", "text": "スタジオを学んでいた頃で、"}, {"type": "subtitle", "time": 18107.83, "timestamp": "05:01:47", "text": "2019年。"}, {"type": "subtitle", "time": 18112.31, "timestamp": "05:01:52", "text": "ああ、えっと、私は一度も完成させたことがない"}, {"type": "subtitle", "time": 18115.0, "timestamp": "05:01:55", "text": "今までずっとそうだった。"}, {"type": "subtitle", "time": 18116.788, "timestamp": "05:01:56", "text": "[音楽]"}, {"type": "subtitle", "time": 18119.83, "timestamp": "05:01:59", "text": "ちなみに、土台は私が作りました。私は私が作った"}]
[{"type": "subtitle", "time": 12121.19, "timestamp": "03:22:01", "text": "ああ、神様。"}, {"type": "subtitle", "time": 12131.83, "timestamp": "03:22:11", "text": "さあ、私の基地に行きましょう。"}, {"type": "subtitle", "time": 12135.349, "timestamp": "03:22:15", "text": "右？こんにちは。"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "そして彼は忽然と姿を消した。待って、"}, {"type": "subtitle", "time": 12147.75, "timestamp": "03:22:27", "text": "えっと、それはどこですか？私の写真はどこ？"}, {"type": "subtitle", "time": 12150.15, "timestamp": "03:22:30", "text": "待って、実際の写真を入れていいね"}, {"type": "subtitle", "time": 12153.75, "timestamp": "03:22:33", "text": "フレームとか色々。ええ、もしあなたが"}, {"type": "subtitle", "time": 12168.15, "timestamp": "03:22:48", "text": "ああ、どうすればいいの？ ええと、知ってる？ジョー、"}, {"type": "subtitle", "time": 12170.469, "timestamp": "03:22:50", "text": "うちにおいで。"}, {"type": "subtitle", "time": 12172.79, "timestamp": "03:22:52", "text": "みんな、知ってる？最後の"}, {"type": "subtitle", "time": 12174.87, "timestamp": "03:22:54", "text": "あれのことですよね？"}, {"type": "subtitle", "time": 12178.389, "timestamp": "03:22:58", "text": "2つのガントレットだけが計画されていた"}]
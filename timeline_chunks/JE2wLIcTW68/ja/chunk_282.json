[{"type": "subtitle", "time": 16922.23, "timestamp": "04:42:02", "text": "何？こちらです。これを"}, {"type": "subtitle", "time": 16923.91, "timestamp": "04:42:03", "text": "スキル？"}, {"type": "subtitle", "time": 16924.99, "timestamp": "04:42:04", "text": "シャット"}, {"type": "subtitle", "time": 16930.99, "timestamp": "04:42:10", "text": "上。だからできないんです。はい、クラウドです。"}, {"type": "subtitle", "time": 16943.788, "timestamp": "04:42:23", "text": "F. わかりました。私たちを入り口まで連れて行ってくれた。"}, {"type": "subtitle", "time": 16949.51, "timestamp": "04:42:29", "text": "ワ。待って、これは早すぎた。あなたは"}, {"type": "subtitle", "time": 16952.43, "timestamp": "04:42:32", "text": "見る。うん。これは私の"}, {"type": "subtitle", "time": 16955.19, "timestamp": "04:42:35", "text": "城。ここに来て。"}, {"type": "subtitle", "time": 16958.31, "timestamp": "04:42:38", "text": "そして、見てください。そして城を建てるとき、"}, {"type": "subtitle", "time": 16960.07, "timestamp": "04:42:40", "text": "既に城を一つ所有している。これはいいえです、"}, {"type": "subtitle", "time": 16970.868, "timestamp": "04:42:50", "text": "これがエントリーです。来て。わかった。"}, {"type": "subtitle", "time": 16973.75, "timestamp": "04:42:53", "text": "とても居心地が良くて、こじんまりとしています。 E、"}, {"type": "subtitle", "time": 16975.67, "timestamp": "04:42:55", "text": "頭がある。何？あれはドラゴンだ。"}, {"type": "subtitle", "time": 16978.47, "timestamp": "04:42:58", "text": "あれはドラゴンだ。それを打ち負かさなければならない。"}, {"type": "subtitle", "time": 16979.83, "timestamp": "04:42:59", "text": "ああ、しまった。"}]
[{"type": "subtitle", "time": 16355.92, "timestamp": "04:32:35", "text": "私の環境では音声にノイズが入ります。"}, {"type": "subtitle", "time": 16357.51, "timestamp": "04:32:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16359.91, "timestamp": "04:32:39", "text": "え、何？誰の音声ですか？私の。ああ、まあまあ"}, {"type": "subtitle", "time": 16371.71, "timestamp": "04:32:51", "text": "下。"}]
[{"type": "subtitle", "time": 10500.389, "timestamp": "02:55:00", "text": "えっと、Zulkセンサーですか？"}, {"type": "subtitle", "time": 10503.11, "timestamp": "02:55:03", "text": "それは基本的にドアのようなもの"}, {"type": "subtitle", "time": 10509.83, "timestamp": "02:55:09", "text": "私の家。ということで、こちらです。何てことだ。"}, {"type": "subtitle", "time": 10511.83, "timestamp": "02:55:11", "text": "ええ、私は自分の動物をすべて救った"}, {"type": "subtitle", "time": 10515.429, "timestamp": "02:55:15", "text": "戦争。ここは私の基地だ。"}, {"type": "subtitle", "time": 10522.75, "timestamp": "02:55:22", "text": "これは何ですか"}, {"type": "subtitle", "time": 10525.83, "timestamp": "02:55:25", "text": "もの？ DVD再生のようなものですか？何が"}, {"type": "subtitle", "time": 10528.71, "timestamp": "02:55:28", "text": "それ？偽物と同じ。これは何ですか？それはそれは"}, {"type": "subtitle", "time": 10531.269, "timestamp": "02:55:31", "text": "音はスピーカーのように見える。だから私は"}, {"type": "subtitle", "time": 10534.15, "timestamp": "02:55:34", "text": "ただ置くだけです。しかし、それは増加します"}, {"type": "subtitle", "time": 10536.79, "timestamp": "02:55:36", "text": "打撃力"}, {"type": "subtitle", "time": 10540.469, "timestamp": "02:55:40", "text": "吹く。うん。例えば、私が"}, {"type": "subtitle", "time": 10544.71, "timestamp": "02:55:44", "text": "TND、それは持っていて、それは持っているような"}, {"type": "subtitle", "time": 10547.99, "timestamp": "02:55:47", "text": "ダメージ。しかし、これと周りを置くと"}, {"type": "subtitle", "time": 10550.79, "timestamp": "02:55:50", "text": "TNDを爆破すると、2倍または"}, {"type": "subtitle", "time": 10553.75, "timestamp": "02:55:53", "text": "被害は3倍。それは簡略化します"}, {"type": "subtitle", "time": 10557.11, "timestamp": "02:55:57", "text": "それ。バニラ味のやつだよ。"}]
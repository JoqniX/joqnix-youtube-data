[{"type": "subtitle", "time": 19441.43, "timestamp": "05:24:01", "text": "Yeah. Yeah. Yeah. Troublemaker."}, {"type": "subtitle", "time": 19479.35, "timestamp": "05:24:39", "text": "Oh, do you have a proper accent?"}, {"type": "subtitle", "time": 19481.59, "timestamp": "05:24:41", "text": "I am half Punjabi, bro. What do you"}, {"type": "subtitle", "time": 19485.83, "timestamp": "05:24:45", "text": "mean? Oh, my nani speaks in Punjabi"}, {"type": "subtitle", "time": 19487.35, "timestamp": "05:24:47", "text": "properly."}, {"type": "subtitle", "time": 19490.15, "timestamp": "05:24:50", "text": "Oh, no. My mother's side family speaks"}, {"type": "subtitle", "time": 19492.07, "timestamp": "05:24:52", "text": "in Punjabi."}, {"type": "subtitle", "time": 19495.67, "timestamp": "05:24:55", "text": "Oh, okay. Makes sense. That's why. So, I"}, {"type": "subtitle", "time": 19498.47, "timestamp": "05:24:58", "text": "know now like my nanny always used to"}]
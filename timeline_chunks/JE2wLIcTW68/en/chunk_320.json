[{"type": "subtitle", "time": 19201.51, "timestamp": "05:20:01", "text": "or something."}, {"type": "subtitle", "time": 19206.708, "timestamp": "05:20:06", "text": "Barber shop. The guy was putting a lot"}, {"type": "subtitle", "time": 19210.31, "timestamp": "05:20:10", "text": "of Hindi songs. I was like, \"Wow.\" Wait,"}, {"type": "subtitle", "time": 19218.07, "timestamp": "05:20:18", "text": "No, no, no. The barber won't play that"}, {"type": "subtitle", "time": 19219.91, "timestamp": "05:20:19", "text": "song."}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "Is it called song? What is Buri again?"}, {"type": "subtitle", "time": 19228.31, "timestamp": "05:20:28", "text": "Bur is that is a language. Up side or"}, {"type": "subtitle", "time": 19232.15, "timestamp": "05:20:32", "text": "Bih side? I don't know."}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "only I should control myself. You know"}, {"type": "subtitle", "time": 19257.67, "timestamp": "05:20:57", "text": "what? Never mind."}]
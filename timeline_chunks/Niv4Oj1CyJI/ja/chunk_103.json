[{"type": "subtitle", "time": 6182.95, "timestamp": "01:43:02", "text": "問題は、最近彼らが新"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "機能を発表したことです。"}, {"type": "subtitle", "time": 6186.79, "timestamp": "01:43:06", "text": "有料機能があり、"}, {"type": "subtitle", "time": 6195.51, "timestamp": "01:43:15", "text": "ストリーミング中に編集できるビデオ編集機能があります。これは"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "将来のものですが、サブスクリプション"}, {"type": "chat", "time": 6198.664, "timestamp": "01:43:18", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "ohh nicee"}, {"type": "subtitle", "time": 6200.709, "timestamp": "01:43:20", "text": "モデルです。しかし、これに関しては、私がBeamstreamで使用しているような"}, {"type": "subtitle", "time": 6206.07, "timestamp": "01:43:26", "text": "クラウドベースのマルチリーマーを発表しました。Beamstreamは独自の"}, {"type": "subtitle", "time": 6215.51, "timestamp": "01:43:35", "text": "クラウドサービスで、独自の方法で行っています。Melは"}, {"type": "subtitle", "time": 6221.91, "timestamp": "01:43:41", "text": "自分のローカルハードウェアを使ってローカルで実行したり、"}, {"type": "subtitle", "time": 6232.31, "timestamp": "01:43:52", "text": "最近Twitterで見たクラウド用の新機能を追加したりしました。"}, {"type": "subtitle", "time": 6238.709, "timestamp": "01:43:58", "text": "それで、これを試して"}]
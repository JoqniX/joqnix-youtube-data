[{"type": "subtitle", "time": 5880.79, "timestamp": "01:38:00", "text": "。ええ。ええ"}, {"type": "subtitle", "time": 5882.39, "timestamp": "01:38:02", "text": "。"}, {"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "さて、問題は、"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "あなたのウェブサイトの作業はどうですか？"}, {"type": "subtitle", "time": 5892.31, "timestamp": "01:38:12", "text": "前回のフレーム以来、何もしていません。ええ、"}, {"type": "subtitle", "time": 5894.39, "timestamp": "01:38:14", "text": "忘れましたか？いいえ、昨日です。ええと、"}, {"type": "subtitle", "time": 5896.39, "timestamp": "01:38:16", "text": "昨日は"}, {"type": "subtitle", "time": 5900.07, "timestamp": "01:38:20", "text": "徹夜しましたよね？そして丸一"}, {"type": "subtitle", "time": 5903.35, "timestamp": "01:38:23", "text": "日ぐっすり眠りました。 午後4時"}, {"type": "subtitle", "time": 5909.189, "timestamp": "01:38:29", "text": "か5時に寝て、午前"}, {"type": "chat", "time": 5910.547, "timestamp": "01:38:30", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "were u able to do that button"}, {"type": "subtitle", "time": 5914.07, "timestamp": "01:38:34", "text": "9時か10時頃に起きました。それから"}, {"type": "subtitle", "time": 5915.91, "timestamp": "01:38:35", "text": "また寝ました。12時に起きました。12時からは"}, {"type": "subtitle", "time": 5918.87, "timestamp": "01:38:38", "text": "、映画やYouTube動画などを見ていました。"}, {"type": "subtitle", "time": 5925.109, "timestamp": "01:38:45", "text": "実は今日、サンダーボールを観ました。"}, {"type": "subtitle", "time": 5927.35, "timestamp": "01:38:47", "text": "ええ、今朝です。"}, {"type": "subtitle", "time": 5932.87, "timestamp": "01:38:52", "text": "一昨日観ながら寝てしまったので。それで、"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "「よし、最後まで観よう」と思いました。"}, {"type": "subtitle", "time": 5937.91, "timestamp": "01:38:57", "text": "ボタンとかボタン関連のことはできるかもしれません。何とかします"}]
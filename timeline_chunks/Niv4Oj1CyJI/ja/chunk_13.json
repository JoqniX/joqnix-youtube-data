[{"type": "subtitle", "time": 780.069, "timestamp": "00:13:00", "text": "それが実際に起こったことです。"}, {"type": "subtitle", "time": 784.23, "timestamp": "00:13:04", "text": "ニース。 それはすごくクールですね。 ニース。 ニース。"}, {"type": "subtitle", "time": 787.35, "timestamp": "00:13:07", "text": "毎日欠かさず練習を続ければ、いつか必ずそのレベルに到達できるでしょう"}, {"type": "subtitle", "time": 789.11, "timestamp": "00:13:09", "text": "。 心配しないで。"}, {"type": "subtitle", "time": 793.59, "timestamp": "00:13:13", "text": "練習しなくてはならない。 練習しなきゃ。"}, {"type": "subtitle", "time": 797.19, "timestamp": "00:13:17", "text": "つまり、このセクション全体、つまり"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "3つ星から次の2番目の"}, {"type": "subtitle", "time": 802.389, "timestamp": "00:13:22", "text": "3つ星までのセクション全体です。"}, {"type": "subtitle", "time": 803.35, "timestamp": "00:13:23", "text": "うん。"}, {"type": "subtitle", "time": 808.55, "timestamp": "00:13:28", "text": "来週の第2部で取り上げます。"}, {"type": "subtitle", "time": 809.59, "timestamp": "00:13:29", "text": "こんにちは。"}, {"type": "subtitle", "time": 811.99, "timestamp": "00:13:31", "text": "そして残りの3つ目の部分は、"}, {"type": "subtitle", "time": 813.509, "timestamp": "00:13:33", "text": "基本的に"}, {"type": "subtitle", "time": 815.99, "timestamp": "00:13:35", "text": "6行くらいしかなくて、"}, {"type": "subtitle", "time": 818.389, "timestamp": "00:13:38", "text": "3つ目の部分で曲全体を締めくくります"}, {"type": "subtitle", "time": 820.47, "timestamp": "00:13:40", "text": "。"}, {"type": "subtitle", "time": 822.55, "timestamp": "00:13:42", "text": "うん。 終わった。"}, {"type": "subtitle", "time": 824.23, "timestamp": "00:13:44", "text": "うん。"}, {"type": "subtitle", "time": 826.87, "timestamp": "00:13:46", "text": "各セクションを練習する時間を確保できるので、いちいち全てに"}, {"type": "subtitle", "time": 828.629, "timestamp": "00:13:48", "text": "戸惑うことなく取り組める、とだけ言っておけばいいんです。"}, {"type": "subtitle", "time": 830.389, "timestamp": "00:13:50", "text": "それが、"}, {"type": "subtitle", "time": 832.79, "timestamp": "00:13:52", "text": "あなたにとって問題の一つだったのだと思います。"}, {"type": "subtitle", "time": 834.79, "timestamp": "00:13:54", "text": "歌詞の一部で混乱したようですね。"}, {"type": "subtitle", "time": 837.11, "timestamp": "00:13:57", "text": "え、そうだったっけ？ ええ、それは私たちが"}, {"type": "subtitle", "time": 839.43, "timestamp": "00:13:59", "text": "待っていたからでした。この歌のことだったのでしょうか？"}]
[{"type": "subtitle", "time": 4142.07, "timestamp": "01:09:02", "text": "アニメはこれが初めてだと思う"}, {"type": "subtitle", "time": 4143.03, "timestamp": "01:09:03", "text": "。"}, {"type": "subtitle", "time": 4146.709, "timestamp": "01:09:06", "text": "ええ、つまり、その人は複数の"}, {"type": "subtitle", "time": 4149.13, "timestamp": "01:09:09", "text": "エンディング曲を持っていたということですね。"}, {"type": "subtitle", "time": 4150.55, "timestamp": "01:09:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "カナリア・カナリアがそうだったから知っていただけです"}, {"type": "subtitle", "time": 4157.43, "timestamp": "01:09:17", "text": "。 歌手と"}, {"type": "subtitle", "time": 4159.03, "timestamp": "01:09:19", "text": "プロデューサー。 うん。"}, {"type": "subtitle", "time": 4162.55, "timestamp": "01:09:22", "text": "待って、"}, {"type": "subtitle", "time": 4169.829, "timestamp": "01:09:29", "text": "え、何？ そう、彼が"}, {"type": "subtitle", "time": 4171.91, "timestamp": "01:09:31", "text": "エンディング曲の一つを歌ったようにね。"}, {"type": "subtitle", "time": 4174.87, "timestamp": "01:09:34", "text": "何？ かっこいい。 すごくかっこいい。"}, {"type": "subtitle", "time": 4176.789, "timestamp": "01:09:36", "text": "えっと、どうやらエンディング曲が複数あるみたいですね"}, {"type": "subtitle", "time": 4180.07, "timestamp": "01:09:40", "text": "。 それが私が分かったことです。"}, {"type": "subtitle", "time": 4181.669, "timestamp": "01:09:41", "text": "何？ ニース。"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "ええ、そういうアニメもありますね。"}, {"type": "subtitle", "time": 4187.269, "timestamp": "01:09:47", "text": "ええ、そういうライムもありますよ。 あなたが正しい。   『"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "ロード・オブ・ザ・ミステリーズ』はご覧になりましたか？"}, {"type": "subtitle", "time": 4193.03, "timestamp": "01:09:53", "text": "どちらの主ですか？"}, {"type": "subtitle", "time": 4195.35, "timestamp": "01:09:55", "text": "ミステリーアニメ。 これは中国のアニメ"}, {"type": "subtitle", "time": 4197.99, "timestamp": "01:09:57", "text": "か犬です。"}, {"type": "subtitle", "time": 4199.51, "timestamp": "01:09:59", "text": "えーと、"}]
[{"type": "subtitle", "time": 2613.03, "timestamp": "00:43:33", "text": "君はもっと自信を持って歌ったよ。   だから"}, {"type": "subtitle", "time": 2615.91, "timestamp": "00:43:35", "text": "彼はそう言っているのです。 でも"}, {"type": "subtitle", "time": 2617.91, "timestamp": "00:43:37", "text": "、彼は以前より自信を持って話しているね。 たとえ"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "一つ間違えたとしても、"}, {"type": "subtitle", "time": 2622.79, "timestamp": "00:43:42", "text": "実際にはもっと自信を持って話す方が"}, {"type": "subtitle", "time": 2625.75, "timestamp": "00:43:45", "text": "ずっと良く聞こえる。 だから"}, {"type": "subtitle", "time": 2627.589, "timestamp": "00:43:47", "text": "自信満々に「うん」って感じなんだよ。"}, {"type": "subtitle", "time": 2629.75, "timestamp": "00:43:49", "text": "こんにちは。   まるで突然"}, {"type": "subtitle", "time": 2637.829, "timestamp": "00:43:57", "text": "自信が湧いてくるような感じ。   何てことだ"}, {"type": "subtitle", "time": 2639.03, "timestamp": "00:43:59", "text": "。"}]
[{"type": "subtitle", "time": 360.31, "timestamp": "00:06:00", "text": "共有すればいいですか？"}, {"type": "subtitle", "time": 362.39, "timestamp": "00:06:02", "text": "後でマイクをいくつか送りますね。"}, {"type": "subtitle", "time": 365.189, "timestamp": "00:06:05", "text": "うん、うん。"}, {"type": "subtitle", "time": 368.55, "timestamp": "00:06:08", "text": "えっと、ところで、"}, {"type": "subtitle", "time": 371.35, "timestamp": "00:06:11", "text": "ミックスはダウンロード済みですよね？"}, {"type": "subtitle", "time": 372.95, "timestamp": "00:06:12", "text": "はい。 はい。 はい。"}, {"type": "subtitle", "time": 376.309, "timestamp": "00:06:16", "text": "うん。 えっと、再生してみて。"}, {"type": "subtitle", "time": 379.749, "timestamp": "00:06:19", "text": "音楽には著作権があります。 心配しないで。"}, {"type": "subtitle", "time": 382.15, "timestamp": "00:06:22", "text": "ああ、そうすると警告か"}, {"type": "subtitle", "time": 383.99, "timestamp": "00:06:23", "text": "何かを受けることになるよ。 この"}, {"type": "subtitle", "time": 385.99, "timestamp": "00:06:25", "text": "ピアノインストゥルメンタルには著作"}, {"type": "subtitle", "time": 387.909, "timestamp": "00:06:27", "text": "権侵害の申し立てはありません。 だから、"}, {"type": "subtitle", "time": 389.43, "timestamp": "00:06:29", "text": "プレイしても大丈夫だよ。"}, {"type": "subtitle", "time": 391.189, "timestamp": "00:06:31", "text": "ああ、わかりました。   わかった"}, {"type": "subtitle", "time": 394.30899999999997, "timestamp": "00:06:34", "text": "。 今、それを聴きました。"}, {"type": "subtitle", "time": 396.469, "timestamp": "00:06:36", "text": "一発撮りで済ませました。"}, {"type": "subtitle", "time": 398.39, "timestamp": "00:06:38", "text": "本当に最悪とかじゃないといいんだけど。 ただ聞いてみてください"}, {"type": "subtitle", "time": 400.95, "timestamp": "00:06:40", "text": "。"}]
[{"type": "subtitle", "time": 124.63, "timestamp": "00:02:04", "text": "曲全体をすっかり忘れてしまったんだと思います。"}, {"type": "subtitle", "time": 127.35, "timestamp": "00:02:07", "text": "うん、私も。 久しぶりですね。 私"}, {"type": "subtitle", "time": 130.55, "timestamp": "00:02:10", "text": "も。 忘れた。"}, {"type": "subtitle", "time": 133.27, "timestamp": "00:02:13", "text": "私はその歌を忘れてはいなかった。"}, {"type": "subtitle", "time": 135.35, "timestamp": "00:02:15", "text": "あなたが歌を忘れたって話してたんだよ。   そうしたのですか"}, {"type": "subtitle", "time": 136.55, "timestamp": "00:02:16", "text": "？"}, {"type": "subtitle", "time": 140.22899999999998, "timestamp": "00:02:20", "text": "いいえ、今日聞いた曲です。"}, {"type": "subtitle", "time": 143.27, "timestamp": "00:02:23", "text": "表紙があった。 カバー曲を聴いた時、"}, {"type": "subtitle", "time": 144.71, "timestamp": "00:02:24", "text": "「ああ、これだ！"}, {"type": "subtitle", "time": 148.15, "timestamp": "00:02:28", "text": "」って思ったんです。 うん。 さよなら。   わかった"}, {"type": "subtitle", "time": 151.99, "timestamp": "00:02:31", "text": "。 うん。 えっと、"}, {"type": "subtitle", "time": 155.91, "timestamp": "00:02:35", "text": "いつかゾルに一緒にその曲をカバーしてもらおうとしているんです。"}, {"type": "subtitle", "time": 156.79, "timestamp": "00:02:36", "text": "はい。"}, {"type": "subtitle", "time": 157.50900000000001, "timestamp": "00:02:37", "text": "私はそうするつもりです。それが"}, {"type": "subtitle", "time": 159.35, "timestamp": "00:02:39", "text": "私の計画です。"}, {"type": "subtitle", "time": 162.71, "timestamp": "00:02:42", "text": "うん、私がカバーするよ。"}, {"type": "subtitle", "time": 166.869, "timestamp": "00:02:46", "text": "だから、私のウェブカメラが"}, {"type": "subtitle", "time": 170.47, "timestamp": "00:02:50", "text": "切断されていると思います。 今起きていること。"}, {"type": "subtitle", "time": 173.91, "timestamp": "00:02:53", "text": "ああ、モデルが固まった。 ああ、大丈夫です。"}, {"type": "subtitle", "time": 175.91, "timestamp": "00:02:55", "text": "大丈夫。 心配ない。"}, {"type": "subtitle", "time": 178.63, "timestamp": "00:02:58", "text": "うん。 わかった。 ええと、もうずいぶん経ちましたね"}]
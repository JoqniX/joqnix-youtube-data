[{"type": "subtitle", "time": 4203.75, "timestamp": "01:10:03", "text": "神様、えーと、私は"}, {"type": "subtitle", "time": 4207.189, "timestamp": "01:10:07", "text": "スーパーキューブを見たことがないと思いますが、私は"}, {"type": "subtitle", "time": 4209.83, "timestamp": "01:10:09", "text": "スーパーキュートを見て、それから"}, {"type": "subtitle", "time": 4212.709, "timestamp": "01:10:12", "text": "インスピレーションを受けて、ライトノベルを全部読みました。"}, {"type": "subtitle", "time": 4217.75, "timestamp": "01:10:17", "text": "ライトノベル、えーと、"}, {"type": "subtitle", "time": 4221.35, "timestamp": "01:10:21", "text": "韓国語のやつ、何て言うんだっけ、"}, {"type": "subtitle", "time": 4236.55, "timestamp": "01:10:36", "text": "スーパーキューブ。"}, {"type": "subtitle", "time": 4238.39, "timestamp": "01:10:38", "text": "スーパーキューブとかいうやつ。   わかった"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "。 わかった。 私は、自分が知っている"}, {"type": "subtitle", "time": 4249.669, "timestamp": "01:10:49", "text": "知識の中でどれが好きかを確認するために、自分の脳を徹底的に調べなければならないと思いました。 それで私は「"}, {"type": "subtitle", "time": 4252.149, "timestamp": "01:10:52", "text": "どうですか？」と尋ねました。"}, {"type": "subtitle", "time": 4255.11, "timestamp": "01:10:55", "text": "ええ、とてもキューブ的な本ですね。"}]
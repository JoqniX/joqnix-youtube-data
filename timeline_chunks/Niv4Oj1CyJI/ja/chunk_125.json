[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "もう一度購入する必要があります。"}, {"type": "subtitle", "time": 7504.95, "timestamp": "02:05:04", "text": "ええ、でも、私たちはこれを成し遂げることができます。"}, {"type": "subtitle", "time": 7509.27, "timestamp": "02:05:09", "text": "ちょっと歌の練習をするから、少しの間"}, {"type": "subtitle", "time": 7513.669, "timestamp": "02:05:13", "text": "リラックスしよう。 ウェブ"}, {"type": "subtitle", "time": 7517.03, "timestamp": "02:05:17", "text": "サイト関連のことは私がやります。 この後、さらに"}, {"type": "subtitle", "time": 7519.83, "timestamp": "02:05:19", "text": "1時間続けます。 それでおしまい。 たった1"}, {"type": "subtitle", "time": 7521.83, "timestamp": "02:05:21", "text": "時間。   じゃあ、"}, {"type": "subtitle", "time": 7527.99, "timestamp": "02:05:27", "text": "今日は歌ったり色々やったから、ペシュ語で歌ってみようかな"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "。 ええ、"}, {"type": "subtitle", "time": 7534.629, "timestamp": "02:05:34", "text": "今日は練習するだけにしましょう。"}, {"type": "subtitle", "time": 7543.91, "timestamp": "02:05:43", "text": "他に流れている曲はあります"}, {"type": "subtitle", "time": 7554.55, "timestamp": "02:05:54", "text": "サンプルをバッファリングします。 わかった。"}]
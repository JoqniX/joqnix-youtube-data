[{"type": "subtitle", "time": 6911.75, "timestamp": "01:55:11", "text": "そして彼女は、アニメに基づいて、このために生のおっぱいを手に入れたんだと"}, {"type": "subtitle", "time": 6914.47, "timestamp": "01:55:14", "text": "思う。 しかし"}, {"type": "subtitle", "time": 6924.55, "timestamp": "01:55:24", "text": "ええ、新しいリミックスアルバムは16日に発売されます"}, {"type": "subtitle", "time": 6927.43, "timestamp": "01:55:27", "text": "。 楽しみです。 今夜は一晩中それを"}, {"type": "subtitle", "time": 6929.91, "timestamp": "01:55:29", "text": "聴くつもりです"}, {"type": "subtitle", "time": 6932.149, "timestamp": "01:55:32", "text": "。   ええ"}, {"type": "subtitle", "time": 6934.629, "timestamp": "01:55:34", "text": "、でも、神"}, {"type": "subtitle", "time": 6938.47, "timestamp": "01:55:38", "text": "サバキのwikiに行けば、コミュニティが"}, {"type": "subtitle", "time": 6942.07, "timestamp": "01:55:42", "text": "作成したwikiがありますよ。 だから、神崎に関するものをたくさん見たり読んだりできるんです"}, {"type": "subtitle", "time": 6945.03, "timestamp": "01:55:45", "text": "。 その"}, {"type": "subtitle", "time": 6947.189, "timestamp": "01:55:47", "text": "背後には一体誰がいたのですか？ 音楽"}, {"type": "subtitle", "time": 6949.43, "timestamp": "01:55:49", "text": "プロデューサー全員、"}, {"type": "subtitle", "time": 6953.75, "timestamp": "01:55:53", "text": "ユーチューバー全員など。彼らは、ええ、"}, {"type": "subtitle", "time": 6955.83, "timestamp": "01:55:55", "text": "そうですね。 うん。 うん。 衣装は全て"}, {"type": "subtitle", "time": 6959.35, "timestamp": "01:55:59", "text": "ここにあります。 ヒナドリの衣装、アーラの衣装"}]
[{"type": "subtitle", "time": 5101.91, "timestamp": "01:25:01", "text": "ええ。ええ。"}, {"type": "subtitle", "time": 5104.31, "timestamp": "01:25:04", "text": "さようなら。"}, {"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "閉じる。"}, {"type": "subtitle", "time": 5113.11, "timestamp": "01:25:13", "text": "よし、もう一度歌詞を歌おう"}, {"type": "subtitle", "time": 5114.07, "timestamp": "01:25:14", "text": "。"}, {"type": "subtitle", "time": 5117.669, "timestamp": "01:25:17", "text": "こんにちは。ちょっと待って。ちょっと待って。ああ、なんてことだ。"}, {"type": "subtitle", "time": 5119.99, "timestamp": "01:25:19", "text": "お願い。マウス。"}, {"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "ああ、ウェブサイトを別のタブで開いていた。"}, {"type": "subtitle", "time": 5125.43, "timestamp": "01:25:25", "text": "大丈夫。今は自由だ。よし。よし。うまくいった"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "？"}, {"type": "subtitle", "time": 5129.03, "timestamp": "01:25:29", "text": "今はそうじゃない？"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "よし。この別のブラウザを閉じよう。"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "よし。こんにちは。今は大丈夫。よし。あー、"}, {"type": "subtitle", "time": 5140.229, "timestamp": "01:25:40", "text": "わかった。"}, {"type": "subtitle", "time": 5142.79, "timestamp": "01:25:42", "text": "ストリームが終わる前に、もう1つだけ。"}, {"type": "subtitle", "time": 5148.149, "timestamp": "01:25:48", "text": "ミステリーをたくさん見なきゃいけないよ。お願い。うん"}]
[{"type": "subtitle", "time": 6422.95, "timestamp": "01:47:02", "text": "スターウォーズじゃないです。PRB、ゆっくりでいいですよ。"}, {"type": "subtitle", "time": 6426.79, "timestamp": "01:47:06", "text": "そう、Bethesda。あのゲームはバグだらけでした。"}, {"type": "subtitle", "time": 6429.109, "timestamp": "01:47:09", "text": "パッチとか色々あって、ブランチを"}, {"type": "subtitle", "time": 6433.59, "timestamp": "01:47:13", "text": "たくさん作らなきゃいけなかったんです。アップデートが配信されるまで時間がかかりました"}, {"type": "subtitle", "time": 6436.47, "timestamp": "01:47:16", "text": "。ええ、本当に"}, {"type": "chat", "time": 6438.872, "timestamp": "01:47:18", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "starfield"}, {"type": "subtitle", "time": 6444.229, "timestamp": "01:47:24", "text": "ああ、そうですね。月曜日のコラボと"}, {"type": "subtitle", "time": 6447.59, "timestamp": "01:47:27", "text": "日曜日のコラボの前に、Pam、"}, {"type": "subtitle", "time": 6450.95, "timestamp": "01:47:30", "text": "日曜日はFastpiaのコラボがありますよね。そう、Starfield。"}, {"type": "subtitle", "time": 6453.75, "timestamp": "01:47:33", "text": "ええ。PCを整理して、"}, {"type": "subtitle", "time": 6459.27, "timestamp": "01:47:39", "text": "ダウンロードフォルダとか不要なものを削除しないといけません"}, {"type": "subtitle", "time": 6461.91, "timestamp": "01:47:41", "text": "。ドライブがまたいっぱいになってきています。"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "Vのアップロードを終わらせなきゃいけないと"}, {"type": "subtitle", "time": 6470.55, "timestamp": "01:47:50", "text": "思う。えっと、保留中のものがたくさんある。"}, {"type": "subtitle", "time": 6473.27, "timestamp": "01:47:53", "text": "今日中に終わらせるよ。"}, {"type": "subtitle", "time": 6475.83, "timestamp": "01:47:55", "text": "全部終わらせる。"}, {"type": "subtitle", "time": 6479.59, "timestamp": "01:47:59", "text": "今日は歌のイベントだから見せるんだ。"}]
[{"type": "subtitle", "time": 4501.51, "timestamp": "01:15:01", "text": "これは牛です。 ココの？"}, {"type": "subtitle", "time": 4505.189, "timestamp": "01:15:05", "text": "この女性？このサイバー"}, {"type": "subtitle", "time": 4507.189, "timestamp": "01:15:07", "text": "レディみたいな？たぶん"}, {"type": "subtitle", "time": 4509.03, "timestamp": "01:15:09", "text": "これだと思う。"}, {"type": "subtitle", "time": 4512.07, "timestamp": "01:15:12", "text": "たぶん。たぶん。そうだと思う。"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "くそ。これはすごくいい。まるで"}, {"type": "subtitle", "time": 4520.149, "timestamp": "01:15:20", "text": "サイボーグか"}, {"type": "subtitle", "time": 4523.35, "timestamp": "01:15:23", "text": "何かみたい。銃とか色々あるし。時々、"}, {"type": "subtitle", "time": 4524.95, "timestamp": "01:15:24", "text": "本当にいい"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "キャラクターがいることにちょっと驚く。"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "うん。"}, {"type": "subtitle", "time": 4531.83, "timestamp": "01:15:31", "text": "それにメディアも完全にアニメーション化されてる。"}, {"type": "subtitle", "time": 4534.87, "timestamp": "01:15:34", "text": "完全にアニメーション化されてる。まるで"}, {"type": "subtitle", "time": 4538.63, "timestamp": "01:15:38", "text": "実際のアニメのウェブサイトみたい。"}, {"type": "subtitle", "time": 4546.229, "timestamp": "01:15:46", "text": "。えっと、残り"}, {"type": "subtitle", "time": 4549.27, "timestamp": "01:15:49", "text": "のエピソードを待ってるんだ。いや、"}, {"type": "subtitle", "time": 4552.31, "timestamp": "01:15:52", "text": "エンディングは複数ないみたいだね。うん。待って、"}, {"type": "subtitle", "time": 4554.63, "timestamp": "01:15:54", "text": "テーマソングの「すべて表示」ボタンがある"}, {"type": "subtitle", "time": 4557.03, "timestamp": "01:15:57", "text": "。いや、"}, {"type": "subtitle", "time": 4559.75, "timestamp": "01:15:59", "text": "たくさんの曲を入れるつもりだと思う。"}]
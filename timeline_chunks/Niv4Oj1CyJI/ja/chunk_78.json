[{"type": "subtitle", "time": 4683.75, "timestamp": "01:18:03", "text": "[音楽]"}, {"type": "subtitle", "time": 4685.669, "timestamp": "01:18:05", "text": "あ、別のページがあるんだ"}, {"type": "subtitle", "time": 4688.149, "timestamp": "01:18:08", "text": "キャラクターに関しては、詳細に言うと、"}, {"type": "subtitle", "time": 4695.35, "timestamp": "01:18:15", "text": "ハイグのことだと思う。あ、待って。これ。ああ、わかった。こんな感じ。"}, {"type": "subtitle", "time": 4697.99, "timestamp": "01:18:17", "text": "うん、これは私を引っ張るためだと思う"}, {"type": "subtitle", "time": 4698.87, "timestamp": "01:18:18", "text": "。"}, {"type": "subtitle", "time": 4701.51, "timestamp": "01:18:21", "text": "この暗号化されたものは何？"}, {"type": "subtitle", "time": 4703.669, "timestamp": "01:18:23", "text": "これを解読したら、メッセージ"}, {"type": "subtitle", "time": 4708.55, "timestamp": "01:18:28", "text": "素晴らしい。すごく"}, {"type": "subtitle", "time": 4712.39, "timestamp": "01:18:32", "text": "アニメーションっぽいのがクールだね。"}, {"type": "subtitle", "time": 4715.27, "timestamp": "01:18:35", "text": "デザインにすごく力を入れているみたい。"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "うん。"}, {"type": "subtitle", "time": 4720.63, "timestamp": "01:18:40", "text": "ああ、サイドバーみたいなのもあるね"}, {"type": "subtitle", "time": 4724.709, "timestamp": "01:18:44", "text": "。"}, {"type": "subtitle", "time": 4726.63, "timestamp": "01:18:46", "text": "読める？"}, {"type": "subtitle", "time": 4729.11, "timestamp": "01:18:49", "text": "どれ？ああ、"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "上の横にあるやつ、映画、ニュース、"}, {"type": "subtitle", "time": 4732.55, "timestamp": "01:18:52", "text": "セッションみたいなやつ。"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "メニューもあるね。"}]
[{"type": "subtitle", "time": 2821.99, "timestamp": "00:47:01", "text": "明日。 ところで、何時頃が空いていますか"}, {"type": "subtitle", "time": 2823.27, "timestamp": "00:47:03", "text": "？   わからない"}, {"type": "subtitle", "time": 2829.91, "timestamp": "00:47:09", "text": "。 明日。 えっと、何時ですか？"}, {"type": "subtitle", "time": 2832.63, "timestamp": "00:47:12", "text": "夜か夕方か？ うん、そうだね。"}, {"type": "subtitle", "time": 2835.75, "timestamp": "00:47:15", "text": "うん。 ええ、時間は作れますよ。 心配ない。"}, {"type": "subtitle", "time": 2837.589, "timestamp": "00:47:17", "text": "10分から20分くらいでいいんです。それだけです。"}, {"type": "subtitle", "time": 2841.829, "timestamp": "00:47:21", "text": "はい、そうします。 うん。   わかった"}, {"type": "subtitle", "time": 2842.23, "timestamp": "00:47:22", "text": "。"}, {"type": "subtitle", "time": 2846.55, "timestamp": "00:47:26", "text": "もう少しスクロールしてください。 わかった。"}, {"type": "subtitle", "time": 2848.39, "timestamp": "00:47:28", "text": "おい。 えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 2851.51, "timestamp": "00:47:31", "text": "。 はい、どうぞ。"}, {"type": "subtitle", "time": 2856.23, "timestamp": "00:47:36", "text": "おい。 えっと、最初から"}, {"type": "subtitle", "time": 2857.27, "timestamp": "00:47:37", "text": "最後まで歌ってください。"}, {"type": "subtitle", "time": 2858.95, "timestamp": "00:47:38", "text": "こんにちは。"}, {"type": "subtitle", "time": 2860.71, "timestamp": "00:47:40", "text": "あなたが全てを覚えていてくれることを願っています。"}, {"type": "subtitle", "time": 2862.39, "timestamp": "00:47:42", "text": "うん。 うん。"}, {"type": "subtitle", "time": 2864.4, "timestamp": "00:47:44", "text": "うん。 ３、２、１、ゴー。"}]
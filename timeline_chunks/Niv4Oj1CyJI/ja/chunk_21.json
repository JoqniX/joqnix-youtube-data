[{"type": "subtitle", "time": 1271.83, "timestamp": "00:21:11", "text": "歌うのではなく、声を伸ばすときなどのボーカルエフェクト。"}, {"type": "subtitle", "time": 1288.47, "timestamp": "00:21:28", "text": "それについて一度も心配したことがありませんでした。 そこが"}, {"type": "subtitle", "time": 1289.51, "timestamp": "00:21:29", "text": "問題なんです。"}, {"type": "subtitle", "time": 1297.11, "timestamp": "00:21:37", "text": "歌うとき、"}, {"type": "subtitle", "time": 1299.909, "timestamp": "00:21:39", "text": "少しひび割れたような感じになるんだけど、どちらかというと"}, {"type": "subtitle", "time": 1302.31, "timestamp": "00:21:42", "text": "ワッフル"}, {"type": "subtitle", "time": 1305.19, "timestamp": "00:21:45", "text": "効果みたいな感じかな。"}, {"type": "subtitle", "time": 1307.75, "timestamp": "00:21:47", "text": "私自身でさえ、自分がそういう"}, {"type": "subtitle", "time": 1310.789, "timestamp": "00:21:50", "text": "歌い方が好きなのかどうかわからない。 それが問題なんです。"}, {"type": "subtitle", "time": 1312.789, "timestamp": "00:21:52", "text": "私はただそれを歌うだけです"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "。"}, {"type": "subtitle", "time": 1317.11, "timestamp": "00:21:57", "text": "彼はただ歌うだけだった。"}, {"type": "subtitle", "time": 1317.99, "timestamp": "00:21:57", "text": "うん。   わかった"}]
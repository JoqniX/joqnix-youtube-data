[{"type": "subtitle", "time": 543.35, "timestamp": "00:09:03", "text": "ああ、長い結び目がある。いや、もっと長い"}, {"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "結び目だ。"}, {"type": "subtitle", "time": 546.87, "timestamp": "00:09:06", "text": "おお。"}, {"type": "subtitle", "time": 548.71, "timestamp": "00:09:08", "text": "うん。"}, {"type": "subtitle", "time": 551.91, "timestamp": "00:09:11", "text": "待って、ここにどうやって表記を入れるの？"}, {"type": "subtitle", "time": 555.269, "timestamp": "00:09:15", "text": "うーん、それは難しいだろうね。 さて、"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "それらも追加しますか？"}, {"type": "subtitle", "time": 562.23, "timestamp": "00:09:22", "text": "ちなみに、それは反響する。   ああ。"}, {"type": "subtitle", "time": 573.43, "timestamp": "00:09:33", "text": "よし、消したよ。 ちょっと待って、調子はどう"}, {"type": "subtitle", "time": 575.75, "timestamp": "00:09:35", "text": "？ 待って、"}, {"type": "subtitle", "time": 577.75, "timestamp": "00:09:37", "text": "それは"}, {"type": "subtitle", "time": 580.31, "timestamp": "00:09:40", "text": "ストリーマーボーイのストリーマーモードだよ。"}, {"type": "subtitle", "time": 583.829, "timestamp": "00:09:43", "text": "待って、どうなの？   私が"}, {"type": "subtitle", "time": 590.389, "timestamp": "00:09:50", "text": "声を発するときのように、あなたのマイクと私のマイクの両方を見ることができます。   ああ"}, {"type": "subtitle", "time": 594.15, "timestamp": "00:09:54", "text": "、"}, {"type": "subtitle", "time": 597.11, "timestamp": "00:09:57", "text": "次の部分を聴くことができます。"}, {"type": "subtitle", "time": 597.99, "timestamp": "00:09:57", "text": "ええ、いい"}]
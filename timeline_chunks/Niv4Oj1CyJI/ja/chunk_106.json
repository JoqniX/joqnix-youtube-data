[{"type": "subtitle", "time": 6362.87, "timestamp": "01:46:02", "text": "オーディオ。彼らはソースプロファイラーを持っています。彼らはそれを持っていると思います"}, {"type": "subtitle", "time": 6364.629, "timestamp": "01:46:04", "text": "。波形。"}, {"type": "subtitle", "time": 6367.189, "timestamp": "01:46:07", "text": "彼らはオーディオフェッチ機能を持っていると思います。"}, {"type": "subtitle", "time": 6369.59, "timestamp": "01:46:09", "text": "はい、基本的にほとんどのものを持っています"}, {"type": "subtitle", "time": 6379.75, "timestamp": "01:46:19", "text": "切り替えることはできますが、わかりません。"}, {"type": "subtitle", "time": 6382.95, "timestamp": "01:46:22", "text": "MELをインストールしてみます。あれ、"}, {"type": "subtitle", "time": 6386.39, "timestamp": "01:46:26", "text": "MELってインストールしてなかったっけ？実は、一度もしてない"}, {"type": "subtitle", "time": 6393.109, "timestamp": "01:46:33", "text": "面白い。Microsoftを選んだのも面白いですね。Microsoftは、"}, {"type": "subtitle", "time": 6400.95, "timestamp": "01:46:40", "text": "ご存知ないかもしれませんが、"}, {"type": "chat", "time": 6401.344, "timestamp": "01:46:41", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "bro brb"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "アップデートを配信するのに時間がかかるんです。Bethesda"}, {"type": "subtitle", "time": 6410.31, "timestamp": "01:46:50", "text": "の宇宙ゲームをプレイした時に知りました"}, {"type": "chat", "time": 6413.406, "timestamp": "01:46:53", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "yep true"}, {"type": "subtitle", "time": 6413.83, "timestamp": "01:46:53", "text": "。名前は何でしたっけ？"}, {"type": "subtitle", "time": 6417.99, "timestamp": "01:46:57", "text": "忘れました。Bethesdaの宇宙ゲーム。"}]
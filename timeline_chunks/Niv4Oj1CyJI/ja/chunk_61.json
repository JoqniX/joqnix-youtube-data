[{"type": "subtitle", "time": 3669.03, "timestamp": "01:01:09", "text": "オーケー。 言葉遣いを間違えてしまったと思います"}, {"type": "subtitle", "time": 3672.47, "timestamp": "01:01:12", "text": "。 うん。   わかった"}, {"type": "subtitle", "time": 3674.71, "timestamp": "01:01:14", "text": "。"}, {"type": "subtitle", "time": 3678.63, "timestamp": "01:01:18", "text": "君が重要な部分を見逃したんだ。"}, {"type": "subtitle", "time": 3680.549, "timestamp": "01:01:20", "text": "要するに、名前を忘れてしまったんですね。   いいえ。ああ"}, {"type": "subtitle", "time": 3704.63, "timestamp": "01:01:44", "text": "待って、ミックスを聴かせてくれ。"}, {"type": "subtitle", "time": 3708.07, "timestamp": "01:01:48", "text": "おそらくこれくらいでしょう。"}]
[{"type": "subtitle", "time": 3065.829, "timestamp": "00:51:05", "text": "うん。"}, {"type": "subtitle", "time": 3066.23, "timestamp": "00:51:06", "text": "ニース。"}, {"type": "subtitle", "time": 3075.03, "timestamp": "00:51:15", "text": "その単語を言ってみて」と言いそうになった。"}, {"type": "subtitle", "time": 3077.75, "timestamp": "00:51:17", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 3079.829, "timestamp": "00:51:19", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 3082.549, "timestamp": "00:51:22", "text": "ラージって言うと、なんだか違和感がある気がする。"}, {"type": "subtitle", "time": 3085.19, "timestamp": "00:51:25", "text": "何が起こったのか分かりません。 わかりません"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "。 もう一度最初から全部歌ってみてもいいかもしれない"}, {"type": "subtitle", "time": 3090.87, "timestamp": "00:51:30", "text": "けど、さっきのミスとかを考えると、最終的には"}, {"type": "subtitle", "time": 3096.71, "timestamp": "00:51:36", "text": "君に任せるよ。   わかった"}]
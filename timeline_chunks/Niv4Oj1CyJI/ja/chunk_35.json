[{"type": "subtitle", "time": 2107.43, "timestamp": "00:35:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2110.55, "timestamp": "00:35:10", "text": "うん、でも大丈夫だよ。"}, {"type": "subtitle", "time": 2113.03, "timestamp": "00:35:13", "text": "心配しないで。 私はただ、"}, {"type": "subtitle", "time": 2115.43, "timestamp": "00:35:15", "text": "その上に寺院があるような気がしたのですが、ただ"}, {"type": "subtitle", "time": 2117.51, "timestamp": "00:35:17", "text": "それを聴いて、たくさん"}, {"type": "subtitle", "time": 2119.75, "timestamp": "00:35:19", "text": "練習しただけです。 私は"}, {"type": "subtitle", "time": 2121.75, "timestamp": "00:35:21", "text": "その曲を1"}, {"type": "subtitle", "time": 2123.829, "timestamp": "00:35:23", "text": "ヶ月くらい毎日練習したと思います。 これで十分だったと思う。"}, {"type": "subtitle", "time": 2126.31, "timestamp": "00:35:26", "text": "ああ、いいね。"}]
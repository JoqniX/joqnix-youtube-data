[{"type": "subtitle", "time": 7142.47, "timestamp": "01:59:02", "text": "。 ああ、"}, {"type": "subtitle", "time": 7145.99, "timestamp": "01:59:05", "text": "ボーカロイドもあるよ。 咳には彼女独自の"}, {"type": "subtitle", "time": 7149.75, "timestamp": "01:59:09", "text": "歌声がある。 これはCFのホワイトバージョンみたいなものだ。   ええ"}, {"type": "subtitle", "time": 7156.1, "timestamp": "01:59:16", "text": "えっと"}, {"type": "subtitle", "time": 7159.109, "timestamp": "01:59:19", "text": "[音楽]"}, {"type": "subtitle", "time": 7161.109, "timestamp": "01:59:21", "text": "H"}, {"type": "subtitle", "time": 7162.709, "timestamp": "01:59:22", "text": "2021。"}, {"type": "subtitle", "time": 7174.629, "timestamp": "01:59:34", "text": "よし、開けられるかどうか見てみましょう。 また、"}, {"type": "subtitle", "time": 7176.55, "timestamp": "01:59:36", "text": "メルスタジオは完成しました。 よし、では"}, {"type": "subtitle", "time": 7179.27, "timestamp": "01:59:39", "text": "これを見せて。 複数のプラットフォームへライブ配信。"}, {"type": "subtitle", "time": 7182.709, "timestamp": "01:59:42", "text": "仮想カメラ、スマートコーナー半径、"}, {"type": "subtitle", "time": 7185.27, "timestamp": "01:59:45", "text": "内蔵モーショントランジション、オールインワン"}, {"type": "subtitle", "time": 7189.43, "timestamp": "01:59:49", "text": "モーションキャプチャ。 ああ、それはいいですね。"}, {"type": "subtitle", "time": 7191.99, "timestamp": "01:59:51", "text": "タッチ操作による音声キャプチャで、一"}, {"type": "subtitle", "time": 7194.47, "timestamp": "01:59:54", "text": "人あたりのトラックを記録できます。 ああ、彼らは松の音を流しているんだ。 それは"}, {"type": "subtitle", "time": 7197.75, "timestamp": "01:59:57", "text": "すばらしい。 ああ、彼らはOBSにこれを実装しました。これは"}, {"type": "subtitle", "time": 7199.99, "timestamp": "01:59:59", "text": "OBSで最も要望の多かった機能です。 彼らはそんなことはし"}]
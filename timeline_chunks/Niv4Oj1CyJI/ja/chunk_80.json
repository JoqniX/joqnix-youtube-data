[{"type": "subtitle", "time": 4801.99, "timestamp": "01:20:01", "text": "。なるほど。"}, {"type": "subtitle", "time": 4805.669, "timestamp": "01:20:05", "text": "彼女が"}, {"type": "subtitle", "time": 4808.87, "timestamp": "01:20:08", "text": "海外の人たちに向けて投稿した写真、見た？"}, {"type": "subtitle", "time": 4811.51, "timestamp": "01:20:11", "text": "ああ、うん。うん。うん。"}, {"type": "subtitle", "time": 4813.669, "timestamp": "01:20:13", "text": "インスタグラムで見たよ。"}, {"type": "subtitle", "time": 4815.75, "timestamp": "01:20:15", "text": "うん。まあね。"}, {"type": "subtitle", "time": 4824.31, "timestamp": "01:20:24", "text": "読めるの？"}, {"type": "subtitle", "time": 4829.51, "timestamp": "01:20:29", "text": "読めないよ。見えない。"}, {"type": "subtitle", "time": 4831.51, "timestamp": "01:20:31", "text": "漢字が多すぎる。漢字の横に"}, {"type": "subtitle", "time": 4834.31, "timestamp": "01:20:34", "text": "ひらがなを書いてるの？あはら以外はね"}, {"type": "subtitle", "time": 4838.229, "timestamp": "01:20:38", "text": "。"}, {"type": "subtitle", "time": 4845.43, "timestamp": "01:20:45", "text": "最初のコマから"}, {"type": "subtitle", "time": 4849.189, "timestamp": "01:20:49", "text": "ひらがなが見えるでしょ。次はどこ？読んでみようかな"}, {"type": "subtitle", "time": 4859.75, "timestamp": "01:20:59", "text": "[音楽]"}]
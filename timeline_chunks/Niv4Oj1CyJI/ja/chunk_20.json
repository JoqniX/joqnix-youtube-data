[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "、途切れてしまった。"}, {"type": "subtitle", "time": 1202.95, "timestamp": "00:20:02", "text": "それは止まらなかった。"}, {"type": "subtitle", "time": 1204.15, "timestamp": "00:20:04", "text": "実際には途切れてはいなかった。"}, {"type": "subtitle", "time": 1206.15, "timestamp": "00:20:06", "text": "そうはなりませんでした。 ちょっと待って。 では、"}, {"type": "subtitle", "time": 1208.23, "timestamp": "00:20:08", "text": "5秒間だけやってみましょう。 待って、どうやって数えるの？"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "5秒。 わかった。 こんにちは。  ３、２、１。"}, {"type": "subtitle", "time": 1221.11, "timestamp": "00:20:21", "text": "切れてしまったのですか？"}, {"type": "subtitle", "time": 1223.75, "timestamp": "00:20:23", "text": "ええ、2秒後ですね。 大丈夫です。   いずれにせよ、まだ"}, {"type": "subtitle", "time": 1226.789, "timestamp": "00:20:26", "text": "ウォーミングアップ段階だ。   いや"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "、違うよ。"}, {"type": "subtitle", "time": 1231.43, "timestamp": "00:20:31", "text": "もう一度試してください。   わかった"}, {"type": "subtitle", "time": 1233.99, "timestamp": "00:20:33", "text": "。"}, {"type": "subtitle", "time": 1245.909, "timestamp": "00:20:45", "text": "切れちゃったんですよね？"}, {"type": "subtitle", "time": 1247.19, "timestamp": "00:20:47", "text": "うん。"}, {"type": "subtitle", "time": 1250.95, "timestamp": "00:20:50", "text": "こんにちは。 声が裏返ったり、声が裏返ったりしたことをどうやって検出するのですか"}]
[{"type": "subtitle", "time": 4322.31, "timestamp": "01:12:02", "text": "おお。 そうそう。 テレビシリーズが"}, {"type": "subtitle", "time": 4326.07, "timestamp": "01:12:06", "text": "放送されている。 あなたはそれをそこから読んだのですか？"}, {"type": "subtitle", "time": 4327.99, "timestamp": "01:12:07", "text": "私はそのテレビシリーズを観ました。"}, {"type": "subtitle", "time": 4330.39, "timestamp": "01:12:10", "text": "「ああ、これはいいな」と思った。 それで私は"}, {"type": "subtitle", "time": 4333.03, "timestamp": "01:12:13", "text": "「わかった、見るよ。"}, {"type": "subtitle", "time": 4334.79, "timestamp": "01:12:14", "text": "でも中国のアニメは読むよ」って言ったの。あなたが"}, {"type": "subtitle", "time": 4336.47, "timestamp": "01:12:16", "text": "それを見たなんて驚きだわ。"}, {"type": "subtitle", "time": 4338.47, "timestamp": "01:12:18", "text": "もちろん。中国のアニメが大好き。"}, {"type": "subtitle", "time": 4341.35, "timestamp": "01:12:21", "text": "何ていうやつだっけ？リンク"}, {"type": "subtitle", "time": 4343.91, "timestamp": "01:12:23", "text": "クリックを見たの。第3シーズンを見なきゃ。まだ見てないの？見てないよ"}, {"type": "chat", "time": 4347.041, "timestamp": "01:12:27", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "is it manhwa or manhua (the chinese comic) ?"}, {"type": "subtitle", "time": 4347.91, "timestamp": "01:12:27", "text": "。"}, {"type": "subtitle", "time": 4351.27, "timestamp": "01:12:31", "text": "第2シーズンは2つしか覚えてない。ピンクの髪の女の子。"}, {"type": "subtitle", "time": 4353.83, "timestamp": "01:12:33", "text": "その後の双子。見てない"}, {"type": "subtitle", "time": 4354.79, "timestamp": "01:12:34", "text": "。第"}, {"type": "subtitle", "time": 4357.27, "timestamp": "01:12:37", "text": "3シーズンには出てこないと思う。"}, {"type": "subtitle", "time": 4358.4, "timestamp": "01:12:38", "text": "いや。"}, {"type": "subtitle", "time": 4360.07, "timestamp": "01:12:40", "text": "[音楽]"}, {"type": "subtitle", "time": 4361.99, "timestamp": "01:12:41", "text": "待って。出てくるの？"}, {"type": "subtitle", "time": 4363.51, "timestamp": "01:12:43", "text": "いや。ああ"}, {"type": "subtitle", "time": 4370.63, "timestamp": "01:12:50", "text": "えっと、マナかマナ？マナだよ、"}, {"type": "subtitle", "time": 4374.229, "timestamp": "01:12:54", "text": "今は中国語だから。"}, {"type": "subtitle", "time": 4376.63, "timestamp": "01:12:56", "text": "つまり、リンクはアニメだけ。"}, {"type": "subtitle", "time": 4379.83, "timestamp": "01:12:59", "text": "オリジナルを知らないでしょ。アニメだけ。"}]
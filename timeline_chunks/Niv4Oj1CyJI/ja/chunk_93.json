[{"type": "subtitle", "time": 5581.669, "timestamp": "01:33:01", "text": "すごく楽しかったよ。"}, {"type": "subtitle", "time": 5583.99, "timestamp": "01:33:03", "text": "うん、"}, {"type": "subtitle", "time": 5586.07, "timestamp": "01:33:06", "text": "君のアクセントから君の出身地を当てたよ"}, {"type": "subtitle", "time": 5598.47, "timestamp": "01:33:18", "text": "ああ、"}, {"type": "subtitle", "time": 5598.95, "timestamp": "01:33:18", "text": "どれ？"}, {"type": "subtitle", "time": 5601.75, "timestamp": "01:33:21", "text": "そう、"}, {"type": "subtitle", "time": 5603.669, "timestamp": "01:33:23", "text": "私の声にアクセントがあるんだ。まさにそれを"}, {"type": "subtitle", "time": 5605.91, "timestamp": "01:33:25", "text": "聞いてたんだ。ああ"}, {"type": "subtitle", "time": 5608.31, "timestamp": "01:33:28", "text": "。誰かが"}, {"type": "subtitle", "time": 5611.35, "timestamp": "01:33:31", "text": "私の出身地を当てたって言ってたよ。 アクセントから私がどこから来たのか"}, {"type": "chat", "time": 5612.575, "timestamp": "01:33:32", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "the way u pronounced kozhikode"}, {"type": "subtitle", "time": 5612.87, "timestamp": "01:33:32", "text": "。"}, {"type": "subtitle", "time": 5616.629, "timestamp": "01:33:36", "text": "ああ、私は、アクセントから私がどこから来たのか"}, {"type": "subtitle", "time": 5619.91, "timestamp": "01:33:39", "text": "推測できない人がいるなんて理解できません"}, {"type": "subtitle", "time": 5622.87, "timestamp": "01:33:42", "text": "。"}, {"type": "subtitle", "time": 5625.59, "timestamp": "01:33:45", "text": "視聴者には、私の声はどう聞こえるでしょうか？どう"}, {"type": "subtitle", "time": 5627.32, "timestamp": "01:33:47", "text": "聞こえるでしょうか？"}, {"type": "subtitle", "time": 5629.189, "timestamp": "01:33:49", "text": "[音楽]"}, {"type": "subtitle", "time": 5631.43, "timestamp": "01:33:51", "text": "ああ、"}, {"type": "subtitle", "time": 5635.03, "timestamp": "01:33:55", "text": "ライブでもあります。彼らが本当に"}, {"type": "subtitle", "time": 5638.07, "timestamp": "01:33:58", "text": "テレビで生放送デビューしたことを忘れていました。"}]
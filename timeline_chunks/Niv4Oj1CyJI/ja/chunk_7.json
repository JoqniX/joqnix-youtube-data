[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "彼らは大丈夫だと思いますか？"}, {"type": "subtitle", "time": 424.309, "timestamp": "00:07:04", "text": "ああ、ピアノとか、その他諸々。"}, {"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "聞こえますよ、ええ、"}, {"type": "subtitle", "time": 429.189, "timestamp": "00:07:09", "text": "期待していました。"}, {"type": "subtitle", "time": 431.27, "timestamp": "00:07:11", "text": "ええ、ちなみに音声は共有できますよ"}, {"type": "subtitle", "time": 432.23, "timestamp": "00:07:12", "text": "。"}, {"type": "subtitle", "time": 434.629, "timestamp": "00:07:14", "text": "ああ、わかった。 どうすればいいですか？ どうすればいいですか"}, {"type": "subtitle", "time": 437.99, "timestamp": "00:07:17", "text": "？ あ、待って。 えっと、Discord。 不和。"}, {"type": "subtitle", "time": 439.27, "timestamp": "00:07:19", "text": "不和。 うん。"}, {"type": "subtitle", "time": 454.39, "timestamp": "00:07:34", "text": "どうすればいいですか。 えっと、"}, {"type": "subtitle", "time": 458.23, "timestamp": "00:07:38", "text": "画面全体に表示しようと思います。 しかし、あなたは耳を傾けてくれるだろうか？"}, {"type": "subtitle", "time": 460.07, "timestamp": "00:07:40", "text": "聞こえるかどうか確認させてください。 わかった。"}, {"type": "subtitle", "time": 460.469, "timestamp": "00:07:40", "text": "うん。"}, {"type": "subtitle", "time": 466.469, "timestamp": "00:07:46", "text": "私はします。"}]
[{"type": "subtitle", "time": 7801.83, "timestamp": "02:10:01", "text": "一方、"}, {"type": "subtitle", "time": 7805.109, "timestamp": "02:10:05", "text": "音は分裂したようだった。 それは"}, {"type": "subtitle", "time": 7807.83, "timestamp": "02:10:07", "text": "本当に長くて、まるで最初からこうあるべきだったかのように分割されていた"}, {"type": "subtitle", "time": 7811.91, "timestamp": "02:10:11", "text": "。"}, {"type": "subtitle", "time": 7823.189, "timestamp": "02:10:23", "text": "音声は正しく分離されていると思います"}, {"type": "subtitle", "time": 7825.35, "timestamp": "02:10:25", "text": "。 インス"}, {"type": "subtitle", "time": 7829.27, "timestamp": "02:10:29", "text": "トゥルメンタルだけが聞こえるのか、それとも"}, {"type": "chat", "time": 7852.27, "timestamp": "02:10:52", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "👍"}]
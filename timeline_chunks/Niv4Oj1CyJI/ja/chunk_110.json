[{"type": "subtitle", "time": 6626.55, "timestamp": "01:50:26", "text": "オーケー。 歌を歌うような感じですね。"}, {"type": "subtitle", "time": 6629.43, "timestamp": "01:50:29", "text": "歌ってみようかな。"}, {"type": "subtitle", "time": 6634.87, "timestamp": "01:50:34", "text": "君を待てないのは分かっているよ。 私のものを使ってもいいですか？ はい"}, {"type": "subtitle", "time": 6650.629, "timestamp": "01:50:50", "text": "。"}, {"type": "subtitle", "time": 6653.59, "timestamp": "01:50:53", "text": "歌のリレーでもやろうかな。 それが何であれ。 他にもいくつか"}, {"type": "subtitle", "time": 6656.31, "timestamp": "01:50:56", "text": "追加したい曲"}]
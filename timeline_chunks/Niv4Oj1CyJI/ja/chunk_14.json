[{"type": "subtitle", "time": 841.91, "timestamp": "00:14:01", "text": "いいえ、レモンと一緒でした。 そう、レモンは"}, {"type": "subtitle", "time": 842.949, "timestamp": "00:14:02", "text": "レモンだった。   何てことだ"}, {"type": "subtitle", "time": 845.67, "timestamp": "00:14:05", "text": "。"}, {"type": "subtitle", "time": 850.47, "timestamp": "00:14:10", "text": "レモン。 ええ、すごく混乱しました。 おお。   あまりその"}, {"type": "subtitle", "time": 856.23, "timestamp": "00:14:16", "text": "曲を聴いていなかったからだと思う。 私は、実際に"}, {"type": "subtitle", "time": 858.15, "timestamp": "00:14:18", "text": "曲を聴くことが"}, {"type": "subtitle", "time": 861.03, "timestamp": "00:14:21", "text": "重要だと思う。"}, {"type": "subtitle", "time": 862.87, "timestamp": "00:14:22", "text": "うん。 たくさんのこと。"}, {"type": "subtitle", "time": 864.949, "timestamp": "00:14:24", "text": "ミックスを再生しましょう。"}, {"type": "subtitle", "time": 868.25, "timestamp": "00:14:28", "text": "ああ、残りの1つ。 わかった。"}, {"type": "subtitle", "time": 870.069, "timestamp": "00:14:30", "text": "【音楽】以上です"}, {"type": "subtitle", "time": 873.0, "timestamp": "00:14:33", "text": "。"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "[音楽]"}]
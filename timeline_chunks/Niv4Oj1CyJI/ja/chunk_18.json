[{"type": "subtitle", "time": 1082.549, "timestamp": "00:18:02", "text": "1ヶ月で終わらせたいって言ってたじゃないか。"}, {"type": "subtitle", "time": 1084.23, "timestamp": "00:18:04", "text": "さよなら。"}, {"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "動画の再生には時間がかかります。 だから、"}, {"type": "subtitle", "time": 1092.23, "timestamp": "00:18:12", "text": "ビデオ制作とミキシング、"}, {"type": "subtitle", "time": 1094.15, "timestamp": "00:18:14", "text": "マスタリング作業には2ヶ月くらいかかるんじゃないかと考えています。 私が"}, {"type": "subtitle", "time": 1095.909, "timestamp": "00:18:15", "text": "全部やるつもりなので、"}, {"type": "subtitle", "time": 1097.99, "timestamp": "00:18:17", "text": "かなり時間がかかるでしょう。"}, {"type": "subtitle", "time": 1099.669, "timestamp": "00:18:19", "text": "うん。 それでは、曲から始めましょう"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "。"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "こんにちは。   好きですか？ まずは"}, {"type": "subtitle", "time": 1107.909, "timestamp": "00:18:27", "text": "ウォーミングアップの運動から始めてもらえますか"}, {"type": "subtitle", "time": 1109.75, "timestamp": "00:18:29", "text": "？"}, {"type": "subtitle", "time": 1112.789, "timestamp": "00:18:32", "text": "えーっと、ウォーミングアップの練習で、"}, {"type": "subtitle", "time": 1116.23, "timestamp": "00:18:36", "text": "1つの音符を伸ばすだけなんだけど、"}, {"type": "subtitle", "time": 1119.59, "timestamp": "00:18:39", "text": "壊れないといいな。"}, {"type": "subtitle", "time": 1122.23, "timestamp": "00:18:42", "text": "昨日の配信ではちょっと壊れやすかったけど、まあいいかな"}, {"type": "subtitle", "time": 1124.15, "timestamp": "00:18:44", "text": "。"}, {"type": "subtitle", "time": 1127.35, "timestamp": "00:18:47", "text": "ああ、騒音は捨てられるといいんだけど。"}, {"type": "subtitle", "time": 1130.71, "timestamp": "00:18:50", "text": "そう、すごく"}, {"type": "subtitle", "time": 1133.75, "timestamp": "00:18:53", "text": "長い音を出そうとすると、途中で音が途切れてしまうんです。"}, {"type": "subtitle", "time": 1137.029, "timestamp": "00:18:57", "text": "ああ、あれね。 えっと、待って。"}]
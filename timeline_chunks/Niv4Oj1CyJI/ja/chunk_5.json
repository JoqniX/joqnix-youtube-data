[{"type": "subtitle", "time": 302.39, "timestamp": "00:05:02", "text": "。 後ほど伺います。"}, {"type": "subtitle", "time": 306.55, "timestamp": "00:05:06", "text": "ミュージックビデオの制作を呼びかける必要があります。"}, {"type": "subtitle", "time": 309.35, "timestamp": "00:05:09", "text": "ミュージックビデオ。 それはまるで、私たちにはやらなければならないことが山ほどあるかのようだ"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "。 いいえ、それは、それは、"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "ああ、シンプルなもので十分です。例えば、"}, {"type": "subtitle", "time": 317.83, "timestamp": "00:05:17", "text": "下半分にサブタイトルがあるだけで、"}, {"type": "subtitle", "time": 321.59, "timestamp": "00:05:21", "text": "みんながカバーを作ります。"}, {"type": "subtitle", "time": 324.31, "timestamp": "00:05:24", "text": "それが私の目指すところです。 私が"}, {"type": "subtitle", "time": 331.99, "timestamp": "00:05:31", "text": "。 それはすばらしい。   わかった"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "。 あの、"}, {"type": "subtitle", "time": 335.749, "timestamp": "00:05:35", "text": "マイクは持ってきましたか？"}, {"type": "subtitle", "time": 338.71, "timestamp": "00:05:38", "text": "マイク？ マイクはまだ少し壊れている。 私は"}, {"type": "subtitle", "time": 340.07, "timestamp": "00:05:40", "text": "誰一人買っていません。"}, {"type": "subtitle", "time": 343.749, "timestamp": "00:05:43", "text": "いいえ、VIPスタジオのような場所のことです。"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "おお。 おお。 おお。"}, {"type": "subtitle", "time": 349.27, "timestamp": "00:05:49", "text": "正直、どう配置すればいいのか分かりません。"}, {"type": "subtitle", "time": 352.07, "timestamp": "00:05:52", "text": "うんうん。 それはまるでアイテムのようなものだ。 えーと、星が見えますか？"}, {"type": "subtitle", "time": 358.23, "timestamp": "00:05:58", "text": "ええ、いくつかあったと思います。えーと、どうやって"}]
[{"type": "subtitle", "time": 1321.27, "timestamp": "00:22:01", "text": "。 それでは、歌詞を見ていきましょう。"}, {"type": "subtitle", "time": 1322.95, "timestamp": "00:22:02", "text": "こんにちは。"}, {"type": "subtitle", "time": 1325.75, "timestamp": "00:22:05", "text": "私が一行歌うので、あなたは「"}, {"type": "subtitle", "time": 1327.029, "timestamp": "00:22:07", "text": "イェー」と歌ってください。"}, {"type": "subtitle", "time": 1328.549, "timestamp": "00:22:08", "text": "うん。 あなたの言っていることを繰り返します。"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "こんにちは。"}, {"type": "subtitle", "time": 1333.99, "timestamp": "00:22:13", "text": "待って。 私のことですね。あ"}, {"type": "subtitle", "time": 1356.63, "timestamp": "00:22:36", "text": "また。 ちゃんと聞き取れませんでした。"}, {"type": "subtitle", "time": 1358.47, "timestamp": "00:22:38", "text": "え、ちゃんと聞き取れなかったの？ うん。   わかった"}, {"type": "subtitle", "time": 1361.669, "timestamp": "00:22:41", "text": "。 ちょっと待って、ちょっと変更させて。  1"}, {"type": "subtitle", "time": 1363.43, "timestamp": "00:22:43", "text": "秒。"}, {"type": "subtitle", "time": 1366.47, "timestamp": "00:22:46", "text": "冒頭部分が"}]
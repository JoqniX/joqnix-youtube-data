[{"type": "subtitle", "time": 185.27, "timestamp": "00:03:05", "text": "。 えっと、えっと、"}, {"type": "subtitle", "time": 187.27, "timestamp": "00:03:07", "text": "最後にコラボしたのはいつでしたっけ？"}, {"type": "subtitle", "time": 190.79, "timestamp": "00:03:10", "text": "ええ、私がその役目だったのは1ヶ月間だけでした"}, {"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "。"}, {"type": "subtitle", "time": 195.67, "timestamp": "00:03:15", "text": "はい、だって自分のチャンネルから戻ってきたんですもの。"}, {"type": "subtitle", "time": 203.75, "timestamp": "00:03:23", "text": "試験は"}, {"type": "subtitle", "time": 205.589, "timestamp": "00:03:25", "text": "自由を奪うものだと思う。"}, {"type": "subtitle", "time": 208.07, "timestamp": "00:03:28", "text": "ああ、もう終わったよ。 それが"}, {"type": "subtitle", "time": 211.82999999999998, "timestamp": "00:03:31", "text": "自由であることを願います。 ああ、なんてことだ。 ああ、あの拷問の記憶は今"}, {"type": "subtitle", "time": 221.67000000000002, "timestamp": "00:03:41", "text": "。 ええと、そうですね、"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "ダサがまた私に歌を教えてくれる予定です"}, {"type": "subtitle", "time": 226.55, "timestamp": "00:03:46", "text": "。"}, {"type": "subtitle", "time": 228.71, "timestamp": "00:03:48", "text": "うん、もう一度その歌詞を歌ってよ。そうすれば"}, {"type": "subtitle", "time": 230.789, "timestamp": "00:03:50", "text": "君とコラボして"}, {"type": "subtitle", "time": 234.63, "timestamp": "00:03:54", "text": "ミュージックビデオを作れるし、きっと"}, {"type": "subtitle", "time": 237.27, "timestamp": "00:03:57", "text": "楽しい経験になると思うよ。"}]
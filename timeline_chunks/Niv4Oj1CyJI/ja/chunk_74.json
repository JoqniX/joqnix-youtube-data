[{"type": "subtitle", "time": 4441.83, "timestamp": "01:14:01", "text": "恐竜ではなく、"}, {"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "ゴジラのような感じです"}, {"type": "subtitle", "time": 4449.03, "timestamp": "01:14:09", "text": "。"}, {"type": "subtitle", "time": 4451.51, "timestamp": "01:14:11", "text": "ああ、"}, {"type": "subtitle", "time": 4453.83, "timestamp": "01:14:13", "text": "そうです、キャラクターです。"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "ああ、"}, {"type": "subtitle", "time": 4463.11, "timestamp": "01:14:23", "text": "この男、この花のようなもの。"}, {"type": "subtitle", "time": 4465.83, "timestamp": "01:14:25", "text": "ああ、花があるのですか？ええ、"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "彼らは持っています。ええ、それは"}, {"type": "subtitle", "time": 4472.709, "timestamp": "01:14:32", "text": "ショーです。彼女は"}, {"type": "subtitle", "time": 4475.75, "timestamp": "01:14:35", "text": "ヘッドバンドをしています。どこにあるのでしょうか？"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "彼女は知っていますか？ええ。ええ。"}, {"type": "subtitle", "time": 4479.03, "timestamp": "01:14:39", "text": "彼女の頭の花です。"}, {"type": "subtitle", "time": 4480.55, "timestamp": "01:14:40", "text": "ああ、"}, {"type": "subtitle", "time": 4481.35, "timestamp": "01:14:41", "text": "そうです。"}, {"type": "subtitle", "time": 4485.189, "timestamp": "01:14:45", "text": "それで、その存在は、これは"}, {"type": "subtitle", "time": 4487.59, "timestamp": "01:14:47", "text": "誰なのかわかりません。これは、"}, {"type": "subtitle", "time": 4493.51, "timestamp": "01:14:53", "text": "これはハリサキのものだと思います。そうかもしれません。わかりません"}, {"type": "subtitle", "time": 4497.35, "timestamp": "01:14:57", "text": "。これはリムスです。"}]
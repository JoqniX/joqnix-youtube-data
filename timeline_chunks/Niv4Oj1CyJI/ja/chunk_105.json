[{"type": "subtitle", "time": 6300.47, "timestamp": "01:45:00", "text": "ピクセルアート効果。いくつかの効果があると思います"}, {"type": "subtitle", "time": 6303.35, "timestamp": "01:45:03", "text": "。3D効果。 それをクリアにダウンします"}, {"type": "subtitle", "time": 6306.709, "timestamp": "01:45:06", "text": "。彼らはそれを持っていません。私はそれが必要です。"}, {"type": "subtitle", "time": 6309.99, "timestamp": "01:45:09", "text": "えーと、ツナミュージック。彼らは音楽の"}, {"type": "subtitle", "time": 6313.59, "timestamp": "01:45:13", "text": "何かを持っていると思います。コンポブラー。彼らは内蔵の"}, {"type": "subtitle", "time": 6315.99, "timestamp": "01:45:15", "text": "ブラー機能を持っています。マスクなど。彼らはそれを持っています。"}, {"type": "subtitle", "time": 6325.35, "timestamp": "01:45:25", "text": "カウントダウン。彼らはそれを持っていると思います。確信はありません。シーンドキュメントも私が使用しているものです。キャプション。確認する必要があります。えーと、描画。はい"}, {"type": "subtitle", "time": 6327.27, "timestamp": "01:45:27", "text": "、描画。描画機能。"}, {"type": "subtitle", "time": 6331.75, "timestamp": "01:45:31", "text": "それはピクセルだけだと思います。ピクセル。何？あれは何と"}, {"type": "subtitle", "time": 6339.27, "timestamp": "01:45:39", "text": "何という名前でしたっけ？ああ、"}, {"type": "subtitle", "time": 6348.79, "timestamp": "01:45:48", "text": "忘れました。えーと、OBSのような"}, {"type": "subtitle", "time": 6353.109, "timestamp": "01:45:53", "text": "ストリーミングソフトウェアがありました。えーと、何という"}, {"type": "subtitle", "time": 6355.75, "timestamp": "01:45:55", "text": "名前でしたっけ？プリズムスタジオ。彼らは"}, {"type": "subtitle", "time": 6359.669, "timestamp": "01:45:59", "text": "モバイルアプリを持っていますが、ピクセルではありません。はい。JR doi"}]
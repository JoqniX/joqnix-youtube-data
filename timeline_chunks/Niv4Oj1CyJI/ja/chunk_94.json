[{"type": "subtitle", "time": 5641.59, "timestamp": "01:34:01", "text": "ああ、彼らは今テレビで生放送をしています。待って、"}, {"type": "subtitle", "time": 5644.149, "timestamp": "01:34:04", "text": "今日ですか？ああ、今やっています。ああ、"}, {"type": "subtitle", "time": 5646.149, "timestamp": "01:34:06", "text": "今やっています。"}, {"type": "chat", "time": 5646.818, "timestamp": "01:34:06", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "only Keralites can pronounce it correctly "}, {"type": "subtitle", "time": 5658.709, "timestamp": "01:34:18", "text": "リンクではないと思います。"}, {"type": "chat", "time": 5658.953, "timestamp": "01:34:18", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "and maybe few others"}, {"type": "subtitle", "time": 5661.669, "timestamp": "01:34:21", "text": "リンクをコピーさせてください。"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "ええ、少し見てみようと思います"}, {"type": "subtitle", "time": 5664.39, "timestamp": "01:34:24", "text": "。"}, {"type": "subtitle", "time": 5666.92, "timestamp": "01:34:26", "text": "こんにちは。"}, {"type": "subtitle", "time": 5669.51, "timestamp": "01:34:29", "text": "[音楽]"}, {"type": "subtitle", "time": 5671.83, "timestamp": "01:34:31", "text": "ええ。ええ、ストリームを終了できます。"}, {"type": "subtitle", "time": 5679.35, "timestamp": "01:34:39", "text": "毎日練習してください。"}, {"type": "subtitle", "time": 5680.79, "timestamp": "01:34:40", "text": "はい。"}, {"type": "chat", "time": 5681.8, "timestamp": "01:34:41", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "kerlalites*"}, {"type": "subtitle", "time": 5687.99, "timestamp": "01:34:47", "text": "どこにいても時間を作ることを忘れないでください。外にいても、"}, {"type": "subtitle", "time": 5691.43, "timestamp": "01:34:51", "text": "誰かが日本語で笑ったり歌ったりしても"}, {"type": "subtitle", "time": 5694.79, "timestamp": "01:34:54", "text": "、"}, {"type": "subtitle", "time": 5696.229, "timestamp": "01:34:56", "text": "練習してください。"}, {"type": "chat", "time": 5697.791, "timestamp": "01:34:57", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "daze sounds so excited"}]
[{"type": "subtitle", "time": 930.629, "timestamp": "00:15:30", "text": "ああ、ピアノ、とても素敵ですね。"}, {"type": "subtitle", "time": 933.269, "timestamp": "00:15:33", "text": "ピアノは本当に素晴らしい。"}, {"type": "subtitle", "time": 934.629, "timestamp": "00:15:34", "text": "はい、"}, {"type": "subtitle", "time": 936.15, "timestamp": "00:15:36", "text": "このライブ配信が"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "終わったら、説明欄にクレジットを記載しておきます。  Pは本当にすごくいい感じですね。"}, {"type": "subtitle", "time": 942.47, "timestamp": "00:15:42", "text": "うん、Pは本当にいい人だよ。 だから、黒"}, {"type": "subtitle", "time": 944.55, "timestamp": "00:15:44", "text": "バージョンも通常バージョンも、"}, {"type": "subtitle", "time": 947.35, "timestamp": "00:15:47", "text": "私たち二人とも歌わないといけないみたいな感じなんだよ。"}, {"type": "subtitle", "time": 948.87, "timestamp": "00:15:48", "text": "ええ、その通りです。"}, {"type": "subtitle", "time": 953.59, "timestamp": "00:15:53", "text": "ああ、わかりました。 では、２、３、４、５。"}, {"type": "subtitle", "time": 955.59, "timestamp": "00:15:55", "text": "こんにちは。"}, {"type": "subtitle", "time": 959.43, "timestamp": "00:15:59", "text": "基本的には、あなたに"}]
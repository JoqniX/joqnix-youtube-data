[{"type": "subtitle", "time": 6061.83, "timestamp": "01:41:01", "text": "ああ、"}, {"type": "subtitle", "time": 6063.35, "timestamp": "01:41:03", "text": "[音楽]のせいでした。"}, {"type": "subtitle", "time": 6074.79, "timestamp": "01:41:14", "text": "zipを大量に消費しているんです。ええ、arcを開くことができません。もし"}, {"type": "subtitle", "time": 6077.03, "timestamp": "01:41:17", "text": "こうなら、どうやって"}, {"type": "subtitle", "time": 6085.109, "timestamp": "01:41:25", "text": "ええ。あと、オーバーレイについてですが、"}, {"type": "subtitle", "time": 6088.39, "timestamp": "01:41:28", "text": "私のウェブサイトをOBSオーバーレイを配置する方法として使っていますよ"}, {"type": "subtitle", "time": 6093.51, "timestamp": "01:41:33", "text": "ね？"}, {"type": "subtitle", "time": 6096.55, "timestamp": "01:41:36", "text": "ジョックアクティビティのことですよね？"}, {"type": "subtitle", "time": 6098.95, "timestamp": "01:41:38", "text": "ジョックネクストアクティビティ。"}, {"type": "chat", "time": 6099.282, "timestamp": "01:41:39", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "close chrome tabs"}, {"type": "subtitle", "time": 6102.07, "timestamp": "01:41:42", "text": "アクティビティの状態は明らかです。"}, {"type": "subtitle", "time": 6108.39, "timestamp": "01:41:48", "text": "ここからコンソールログを削除しようと思っています。"}, {"type": "chat", "time": 6112.228, "timestamp": "01:41:52", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "and u can start with light games"}, {"type": "subtitle", "time": 6113.43, "timestamp": "01:41:53", "text": "ノーショントリガーが"}, {"type": "subtitle", "time": 6115.99, "timestamp": "01:41:55", "text": "作動しているときはいつでもコンソールログを削除する必要があります。"}, {"type": "subtitle", "time": 6119.109, "timestamp": "01:41:59", "text": "コンソールログが多すぎると、多くのcing がブラウザを大量に"}]
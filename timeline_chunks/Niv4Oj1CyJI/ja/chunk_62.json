[{"type": "subtitle", "time": 3729.109, "timestamp": "01:02:09", "text": "よし、たくさん"}, {"type": "subtitle", "time": 3731.51, "timestamp": "01:02:11", "text": "歌ってみよう。 もう一度"}, {"type": "subtitle", "time": 3732.47, "timestamp": "01:02:12", "text": "。"}, {"type": "subtitle", "time": 3733.51, "timestamp": "01:02:13", "text": "こんにちは。"}, {"type": "subtitle", "time": 3735.829, "timestamp": "01:02:15", "text": "スピードが少し"}, {"type": "subtitle", "time": 3738.63, "timestamp": "01:02:18", "text": "速いのは分かっているけど、そうじゃないと思うよ。 だから、"}, {"type": "subtitle", "time": 3740.95, "timestamp": "01:02:20", "text": "君がスピードに追いついてくれることを願っているよ。"}, {"type": "subtitle", "time": 3742.63, "timestamp": "01:02:22", "text": "あ、待って。 ゆっくり進むべきでしょうか？ もっと"}, {"type": "subtitle", "time": 3743.829, "timestamp": "01:02:23", "text": "ゆっくり進みます。   もっと"}, {"type": "subtitle", "time": 3746.549, "timestamp": "01:02:26", "text": "ゆっくり進みます。 わかった。 はい、それで結構です。   よし"}, {"type": "subtitle", "time": 3749.589, "timestamp": "01:02:29", "text": "。"}, {"type": "subtitle", "time": 3756.41, "timestamp": "01:02:36", "text": "それは正しい。"}, {"type": "subtitle", "time": 3767.349, "timestamp": "01:02:47", "text": "[音楽]"}, {"type": "subtitle", "time": 3768.64, "timestamp": "01:02:48", "text": "ゲットチェチ。"}]
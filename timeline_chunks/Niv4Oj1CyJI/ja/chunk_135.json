[{"type": "subtitle", "time": 8128.31, "timestamp": "02:15:28", "text": "ああ、大丈夫ですよ。 時間をかけて練習していきます。"}, {"type": "subtitle", "time": 8131.43, "timestamp": "02:15:31", "text": "ええと、その時間は"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "曲全体を通して私を監督してくれるでしょう。 彼女は"}, {"type": "subtitle", "time": 8136.79, "timestamp": "02:15:36", "text": "私に今すぐカバーしてほしいと思っている。 だから、この6月は"}, {"type": "chat", "time": 8141.138, "timestamp": "02:15:41", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "practice makes us perfect"}, {"type": "subtitle", "time": 8141.75, "timestamp": "02:15:41", "text": "美しい月だった。"}, {"type": "subtitle", "time": 8145.669, "timestamp": "02:15:45", "text": "Cの曲をやってみよう。だって、やらない理由なんてないでしょ？"}, {"type": "subtitle", "time": 8150.87, "timestamp": "02:15:50", "text": "えっと、これはスローソングになります。 ええと、"}, {"type": "subtitle", "time": 8153.669, "timestamp": "02:15:53", "text": "これは完璧な「はい」ですね。"}, {"type": "subtitle", "time": 8157.669, "timestamp": "02:15:57", "text": "Hソング。 さあ行こう。   さあ行こう"}]
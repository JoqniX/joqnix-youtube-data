[{"type": "subtitle", "time": 734.31, "timestamp": "00:12:14", "text": "[音楽]"}, {"type": "subtitle", "time": 736.25, "timestamp": "00:12:16", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 746.71, "timestamp": "00:12:26", "text": "【音楽】"}, {"type": "subtitle", "time": 749.59, "timestamp": "00:12:29", "text": "また長めの音符。 わかった。"}, {"type": "subtitle", "time": 753.99, "timestamp": "00:12:33", "text": "その部分について、より長い注釈を付ける必要はありません。 実は、一発で歌えたから歌っただけなんです"}, {"type": "subtitle", "time": 755.75, "timestamp": "00:12:35", "text": "。"}, {"type": "subtitle", "time": 757.75, "timestamp": "00:12:37", "text": "歌ったのは、"}, {"type": "subtitle", "time": 759.67, "timestamp": "00:12:39", "text": "そう、長い音符じゃないから。"}, {"type": "subtitle", "time": 760.79, "timestamp": "00:12:40", "text": "歌う必要はありません。"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "待って、これが最初のテイクだ。 おお。 どうやってやったの？"}, {"type": "subtitle", "time": 766.31, "timestamp": "00:12:46", "text": "ああ、"}, {"type": "subtitle", "time": 769.03, "timestamp": "00:12:49", "text": "動いてたんだよ。 コラボレーションがあって、私は自分の"}, {"type": "subtitle", "time": 773.509, "timestamp": "00:12:53", "text": "ナレーション用のサンプルを作る必要があると思ったので、ワンテイクで録音してインストゥルメンタルに"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "乗せて"}, {"type": "subtitle", "time": 778.069, "timestamp": "00:12:58", "text": "完成させようと思いました。"}]
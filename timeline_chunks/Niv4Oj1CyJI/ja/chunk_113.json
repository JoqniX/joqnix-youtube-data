[{"type": "subtitle", "time": 6785.75, "timestamp": "01:53:05", "text": "アップロードしたと思う"}, {"type": "subtitle", "time": 6788.79, "timestamp": "01:53:08", "text": "？ えっと、確かコンサートの映像を1つアップロードしたと思うんだけど"}, {"type": "subtitle", "time": 6793.189, "timestamp": "01:53:13", "text": "。"}, {"type": "subtitle", "time": 6796.629, "timestamp": "01:53:16", "text": "彼女がそれを見つけたら…いや、彼女はそうしなかった"}, {"type": "subtitle", "time": 6800.79, "timestamp": "01:53:20", "text": "。 動画の中にありますか？"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "ああ、わかった。 そうではないと思います。 これはもう"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "6ヶ月くらい前から続いています。 どこですか？ ああ、それは"}, {"type": "subtitle", "time": 6809.91, "timestamp": "01:53:29", "text": "プライベートでした。 ああ、非公開になっているけど、"}, {"type": "subtitle", "time": 6813.35, "timestamp": "01:53:33", "text": "レムがアップロードしたと思う。 コンサートの"}, {"type": "subtitle", "time": 6817.109, "timestamp": "01:53:37", "text": "方だったの？"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "ああ、彼らはそれをほんの少ししか撮らなかったんだ。 うん。"}, {"type": "subtitle", "time": 6824.55, "timestamp": "01:53:44", "text": "もっとから、からから、から。"}, {"type": "subtitle", "time": 6834.629, "timestamp": "01:53:54", "text": "でも、コンサートでは"}, {"type": "subtitle", "time": 6837.99, "timestamp": "01:53:57", "text": "もっと低音域の音源が手に入るんだよね。 それらはまるで、歌っている"}]
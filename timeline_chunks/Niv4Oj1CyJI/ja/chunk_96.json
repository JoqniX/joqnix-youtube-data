[{"type": "subtitle", "time": 5765.43, "timestamp": "01:36:05", "text": "うん。 うん。 うん。 うん。 行く。 うん。"}, {"type": "subtitle", "time": 5769.43, "timestamp": "01:36:09", "text": "楽しんでるよ。 えーと、わからない。"}, {"type": "subtitle", "time": 5771.91, "timestamp": "01:36:11", "text": "リレーみたいなことはやってないと思う。 うん、リレーみたいなこともできたかもしれない。 えーと"}, {"type": "subtitle", "time": 5776.709, "timestamp": "01:36:16", "text": "、リレーみたいな。"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "えーと、Cが30分間"}, {"type": "subtitle", "time": 5787.03, "timestamp": "01:36:27", "text": "ライブ2Dをデビューさせて、それからリムが30分間ライブ2Dを"}, {"type": "subtitle", "time": 5789.59, "timestamp": "01:36:29", "text": "デビューさせる、みたいな。"}, {"type": "subtitle", "time": 5792.87, "timestamp": "01:36:32", "text": "Vtuberのリレーデビューリレーみたいな感じだ"}, {"type": "subtitle", "time": 5795.03, "timestamp": "01:36:35", "text": "けど、 ああ、うんうん、"}, {"type": "subtitle", "time": 5796.709, "timestamp": "01:36:36", "text": "リレーみたいなことをしてる。"}, {"type": "subtitle", "time": 5799.51, "timestamp": "01:36:39", "text": "スケジュールがあるのを忘れてた。"}, {"type": "subtitle", "time": 5802.39, "timestamp": "01:36:42", "text": "君に送ったと思う。"}, {"type": "subtitle", "time": 5805.51, "timestamp": "01:36:45", "text": "うん、それぞれ1時間ずつ。 えーと、それぞれ1時間ずつかな"}, {"type": "subtitle", "time": 5807.51, "timestamp": "01:36:47", "text": "。 じゃあ"}, {"type": "subtitle", "time": 5810.149, "timestamp": "01:36:50", "text": "、行く。"}, {"type": "subtitle", "time": 5814.39, "timestamp": "01:36:54", "text": "でも、楽しんでね。"}, {"type": "subtitle", "time": 5818.39, "timestamp": "01:36:58", "text": "良い一日を。"}]
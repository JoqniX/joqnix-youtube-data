[{"type": "subtitle", "time": 3066.23, "timestamp": "00:51:06", "text": "。  我唱一句，你唱一句，然後是「耶」。  是的。我重複一遍"}, {"type": "subtitle", "time": 3079.829, "timestamp": "00:51:19", "text": "你剛才"}, {"type": "subtitle", "time": 3082.549, "timestamp": "00:51:22", "text": "說的話。  你好。  你好。  等待。你是說我的哦，對不起。你好。嘿，又見面了。我沒聽清楚。  等等，"}]
[{"type": "subtitle", "time": 6309.99, "timestamp": "01:45:09", "text": "呃，好的。還有一件事，你知道，如果直播在"}, {"type": "subtitle", "time": 6322.39, "timestamp": "01:45:22", "text": "我說話之前結束了，你得看很多懸疑劇。拜託。嗯。"}, {"type": "subtitle", "time": 6325.35, "timestamp": "01:45:25", "text": "呃，《魔女之王》，《我的動漫之王》。只有三集。是新"}, {"type": "subtitle", "time": 6339.27, "timestamp": "01:45:39", "text": "哦，"}, {"type": "subtitle", "time": 6355.75, "timestamp": "01:45:55", "text": "？哦，這部。嗯"}, {"type": "subtitle", "time": 6359.669, "timestamp": "01:45:59", "text": "。中國動漫系列。MS真棒。哦，畫質很好。哇，順便說一句，畫質真的很好。很好。"}]
[{"type": "subtitle", "time": 6274.31, "timestamp": "01:44:34", "text": "我的天哪。拜託。鼠標。哦，我把網站"}, {"type": "subtitle", "time": 6277.189, "timestamp": "01:44:37", "text": "放在另一個"}, {"type": "subtitle", "time": 6280.31, "timestamp": "01:44:40", "text": "標籤頁了。沒關係。現在自由了。好的。好的。它能用了嗎？現在不行了嗎？好的。讓我關掉另一個瀏覽器。好的。"}, {"type": "subtitle", "time": 6292.79, "timestamp": "01:44:52", "text": "嗨。現在好了。好的。"}]
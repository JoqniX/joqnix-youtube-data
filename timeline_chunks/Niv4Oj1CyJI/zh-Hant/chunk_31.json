[{"type": "subtitle", "time": 1873.11, "timestamp": "00:31:13", "text": "會把他們製作的這兩個翻唱版本發給你，Mafu Mafu 唱的是主唱部分，Sor 也發布了另一個版本，也是他唱的主唱部分"}, {"type": "subtitle", "time": 1886.549, "timestamp": "00:31:26", "text": "。基本上，同一首歌有"}, {"type": "subtitle", "time": 1900.07, "timestamp": "00:31:40", "text": "兩個版本，只是唱的歌詞不一樣"}]
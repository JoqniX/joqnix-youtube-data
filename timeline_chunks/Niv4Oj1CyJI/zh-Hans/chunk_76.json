[{"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "哦，也许这就是原因。也许他们会有"}, {"type": "subtitle", "time": 4564.47, "timestamp": "01:16:04", "text": "多个。现在只有一个。也许会有多个。是"}, {"type": "subtitle", "time": 4570.47, "timestamp": "01:16:10", "text": "啊。是新歌还是"}, {"type": "subtitle", "time": 4573.51, "timestamp": "01:16:13", "text": "老歌？他们好像在"}, {"type": "subtitle", "time": 4577.43, "timestamp": "01:16:17", "text": "重新利用VWP的一首歌。我"}, {"type": "subtitle", "time": 4580.149, "timestamp": "01:16:20", "text": "觉得是新的。 一。"}, {"type": "subtitle", "time": 4582.229, "timestamp": "01:16:22", "text": "我觉得应该是新的。"}, {"type": "subtitle", "time": 4586.07, "timestamp": "01:16:26", "text": "哇，真好听。"}, {"type": "subtitle", "time": 4587.86, "timestamp": "01:16:27", "text": "你听过"}, {"type": "subtitle", "time": 4592.87, "timestamp": "01:16:32", "text": "第一集里的那首[音乐]歌吗？"}, {"type": "subtitle", "time": 4599.11, "timestamp": "01:16:39", "text": "它不是片头曲，而是"}, {"type": "subtitle", "time": 4601.189, "timestamp": "01:16:41", "text": "动画"}, {"type": "subtitle", "time": 4603.43, "timestamp": "01:16:43", "text": "第一集里的一首歌。"}, {"type": "subtitle", "time": 4614.87, "timestamp": "01:16:54", "text": "都不是。"}, {"type": "subtitle", "time": 4616.55, "timestamp": "01:16:56", "text": "他们四年前就发行了"}, {"type": "subtitle", "time": 4618.229, "timestamp": "01:16:58", "text": "。"}, {"type": "subtitle", "time": 4619.99, "timestamp": "01:16:59", "text": "啊，好的。是的。"}]
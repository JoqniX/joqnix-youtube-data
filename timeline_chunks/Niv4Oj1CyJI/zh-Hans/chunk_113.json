[{"type": "subtitle", "time": 6785.75, "timestamp": "01:53:05", "text": "我想呃，他们上传了呃，其中一个"}, {"type": "subtitle", "time": 6788.79, "timestamp": "01:53:08", "text": "什么？ 呃，如果我没记错的话，他们好像上传了其中一场"}, {"type": "subtitle", "time": 6793.189, "timestamp": "01:53:13", "text": "演唱会。"}, {"type": "subtitle", "time": 6796.629, "timestamp": "01:53:16", "text": "如果我能找到她的话……呃，不，她"}, {"type": "subtitle", "time": 6800.79, "timestamp": "01:53:20", "text": "没有。 视频里有吗？"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "呃，好的。 我认为不是。 这种情况已经持续"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "6个月了。 哦，原来"}, {"type": "subtitle", "time": 6809.91, "timestamp": "01:53:29", "text": "是私人的。 哦，它是私有的。但"}, {"type": "subtitle", "time": 6813.35, "timestamp": "01:53:33", "text": "我认为蕾姆上传了它。 是演唱会那场吗"}, {"type": "subtitle", "time": 6817.109, "timestamp": "01:53:37", "text": "？"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "哦，他们只拍了几张照片。 是的。"}, {"type": "subtitle", "time": 6824.55, "timestamp": "01:53:44", "text": "更多来自来自来自"}, {"type": "subtitle", "time": 6834.629, "timestamp": "01:53:54", "text": "但是，演唱会上确实能听到"}, {"type": "subtitle", "time": 6837.99, "timestamp": "01:53:57", "text": "很多低档的东西。 它们就像一出故事"}]
[{"type": "subtitle", "time": 4801.99, "timestamp": "01:20:01", "text": "粉丝。所以我明白了。你看到"}, {"type": "subtitle", "time": 4805.669, "timestamp": "01:20:05", "text": "她发的那些照片了吗？像是"}, {"type": "subtitle", "time": 4808.87, "timestamp": "01:20:08", "text": "给海外粉丝的观察？"}, {"type": "subtitle", "time": 4811.51, "timestamp": "01:20:11", "text": "哦。哦，是的。是的。是的。我在"}, {"type": "subtitle", "time": 4813.669, "timestamp": "01:20:13", "text": "Instagram上看到了。是的。算是吧。挺不错的。"}, {"type": "subtitle", "time": 4824.31, "timestamp": "01:20:24", "text": "你能看懂吗？"}, {"type": "subtitle", "time": 4829.51, "timestamp": "01:20:29", "text": "我看不懂。看不清。"}, {"type": "subtitle", "time": 4831.51, "timestamp": "01:20:31", "text": "汉字太多了。"}, {"type": "subtitle", "time": 4834.31, "timestamp": "01:20:34", "text": "他们是不是在"}, {"type": "subtitle", "time": 4836.709, "timestamp": "01:20:36", "text": "一些汉字旁边加了平假名？是"}, {"type": "subtitle", "time": 4838.229, "timestamp": "01:20:38", "text": "的。Ahara，"}, {"type": "subtitle", "time": 4842.149, "timestamp": "01:20:42", "text": "所以"}, {"type": "subtitle", "time": 4845.43, "timestamp": "01:20:45", "text": "从第一格开始，"}, {"type": "subtitle", "time": 4849.189, "timestamp": "01:20:49", "text": "你知道你看到了平假名，接下来"}, {"type": "subtitle", "time": 4851.43, "timestamp": "01:20:51", "text": "你在哪里？"}, {"type": "subtitle", "time": 4859.75, "timestamp": "01:20:59", "text": "[音乐] 对"}]
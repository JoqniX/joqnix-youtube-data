[{"type": "subtitle", "time": 7623.03, "timestamp": "02:07:03", "text": "首歌。 呃，这首歌怎么样？"}, {"type": "subtitle", "time": 7625.669, "timestamp": "02:07:05", "text": "为什么其他歌曲会被"}, {"type": "subtitle", "time": 7631.589, "timestamp": "02:07:11", "text": "别跟我说是因为"}, {"type": "subtitle", "time": 7634.709, "timestamp": "02:07:14", "text": "使用率低。 呃，我得腾出地方放"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "好的。 我们来看看还有哪些歌。好的。"}, {"type": "subtitle", "time": 7654.709, "timestamp": "02:07:34", "text": "嗯，长篇故事。 我们会唱歌。 我们可以把"}, {"type": "subtitle", "time": 7656.47, "timestamp": "02:07:36", "text": "这个做得很高。 对不起。 因为它已经被"}, {"type": "subtitle", "time": 7660.149, "timestamp": "02:07:40", "text": "关起来了。 请不要告诉我。 好的。 所以，"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "我们能做到。"}, {"type": "subtitle", "time": 7665.35, "timestamp": "02:07:45", "text": "嗯，今天，是的，我们可以做八个。"}, {"type": "subtitle", "time": 7666.629, "timestamp": "02:07:46", "text": "我们当时正在练习的那架无人机很漂亮"}, {"type": "subtitle", "time": 7669.43, "timestamp": "02:07:49", "text": "。 好的。 我们能做到。 好的。   我们就来弹奏"}, {"type": "subtitle", "time": 7671.669, "timestamp": "02:07:51", "text": "第八首歌吧，因为这是"}, {"type": "subtitle", "time": 7674.709, "timestamp": "02:07:54", "text": "我们今天一直在学的歌。"}, {"type": "subtitle", "time": 7678.47, "timestamp": "02:07:58", "text": "好的。 我们去唱歌吧。"}]
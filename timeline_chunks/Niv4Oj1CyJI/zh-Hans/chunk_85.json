[{"type": "subtitle", "time": 5101.91, "timestamp": "01:25:01", "text": "啊。是啊。"}, {"type": "subtitle", "time": 5104.31, "timestamp": "01:25:04", "text": "再见。"}, {"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "关闭。"}, {"type": "subtitle", "time": 5113.11, "timestamp": "01:25:13", "text": "好吧，我们来唱歌吧。 歌词再说一遍"}, {"type": "subtitle", "time": 5114.07, "timestamp": "01:25:14", "text": "。"}, {"type": "subtitle", "time": 5117.669, "timestamp": "01:25:17", "text": "嗨。等一下。让我……让我……哦，我的天哪。"}, {"type": "subtitle", "time": 5119.99, "timestamp": "01:25:19", "text": "拜托。鼠标。"}, {"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "哦，我把网站放在另一个标签页了。"}, {"type": "subtitle", "time": 5125.43, "timestamp": "01:25:25", "text": "没关系。现在自由了。好的。"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "好的。它能用了吗？"}, {"type": "subtitle", "time": 5129.03, "timestamp": "01:25:29", "text": "现在不行了吗？"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "好的。让我关掉另一个浏览器。"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "好的。嗨。现在好了。"}, {"type": "subtitle", "time": 5137.11, "timestamp": "01:25:37", "text": "好的。呃，"}, {"type": "subtitle", "time": 5140.229, "timestamp": "01:25:40", "text": "好的。还有一件事，你知道，"}, {"type": "subtitle", "time": 5142.79, "timestamp": "01:25:42", "text": "如果直播在我说话之前结束了"}, {"type": "subtitle", "time": 5145.43, "timestamp": "01:25:45", "text": "，你得看很多"}, {"type": "subtitle", "time": 5148.149, "timestamp": "01:25:48", "text": "悬疑剧。拜托。"}, {"type": "subtitle", "time": 5151.51, "timestamp": "01:25:51", "text": "嗯。呃，《魔女之王》，《"}, {"type": "subtitle", "time": 5155.03, "timestamp": "01:25:55", "text": "我的动漫之王》。只有三"}, {"type": "subtitle", "time": 5156.79, "timestamp": "01:25:56", "text": "集。"}]
[{"type": "subtitle", "time": 6962.39, "timestamp": "01:56:02", "text": "服装、Subame 的服装。"}, {"type": "subtitle", "time": 6965.35, "timestamp": "01:56:05", "text": "嗯，这是虚拟"}, {"type": "subtitle", "time": 6967.43, "timestamp": "01:56:07", "text": "蔬菜系列产品之一。 我认为这不会出现"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "在本季动画中。 我"}, {"type": "subtitle", "time": 6971.91, "timestamp": "01:56:11", "text": "认为"}, {"type": "subtitle", "time": 6974.87, "timestamp": "01:56:14", "text": "根据星"}, {"type": "subtitle", "time": 6979.669, "timestamp": "01:56:19", "text": "贺家的故事发展，这一点会在第二季中展现出来。 是的，"}, {"type": "subtitle", "time": 6983.43, "timestamp": "01:56:23", "text": "这些也属于"}, {"type": "subtitle", "time": 6986.47, "timestamp": "01:56:26", "text": "虚拟女巫现象（VWP）的范畴"}, {"type": "subtitle", "time": 6988.629, "timestamp": "01:56:28", "text": "。 所以我觉得这"}, {"type": "subtitle", "time": 6991.669, "timestamp": "01:56:31", "text": "大概就是动画第二季的全部内容了。"}, {"type": "subtitle", "time": 6995.35, "timestamp": "01:56:35", "text": "现在服装种类真多。"}, {"type": "subtitle", "time": 6997.83, "timestamp": "01:56:37", "text": "我很兴奋他们会在动画中如何呈现这一点。"}, {"type": "subtitle", "time": 7000.149, "timestamp": "01:56:40", "text": "是的，他们目前在第一季动画中就有这个，"}, {"type": "subtitle", "time": 7006.229, "timestamp": "01:56:46", "text": "他们会在当前的动画季中展示这一点。 我很"}, {"type": "subtitle", "time": 7009.35, "timestamp": "01:56:49", "text": "兴奋，进展速度会降低。"}, {"type": "subtitle", "time": 7011.99, "timestamp": "01:56:51", "text": "海"}, {"type": "subtitle", "time": 7017.669, "timestamp": "01:56:57", "text": "K2。 对，就是那个金色的东西。"}, {"type": "subtitle", "time": 7019.669, "timestamp": "01:56:59", "text": "太酷了。"}]
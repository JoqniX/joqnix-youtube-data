[{"type": "subtitle", "time": 4501.51, "timestamp": "01:15:01", "text": "这是 牛。那可可的呢？是"}, {"type": "subtitle", "time": 4505.189, "timestamp": "01:15:05", "text": "这边这位女士吗？就像这位赛博格"}, {"type": "subtitle", "time": 4507.189, "timestamp": "01:15:07", "text": "女士？"}, {"type": "subtitle", "time": 4509.03, "timestamp": "01:15:09", "text": "我觉得是她。"}, {"type": "subtitle", "time": 4512.07, "timestamp": "01:15:12", "text": "也许吧。也许吧。我觉得是。"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "该死。这太棒了。"}, {"type": "subtitle", "time": 4520.149, "timestamp": "01:15:20", "text": "就像……就像个赛博格或者"}, {"type": "subtitle", "time": 4523.35, "timestamp": "01:15:23", "text": "别的什么。所以有枪之类的。有时候真没"}, {"type": "subtitle", "time": 4524.95, "timestamp": "01:15:24", "text": "想到他们能塑造出这么棒的"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "角色。是"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "啊。"}, {"type": "subtitle", "time": 4531.83, "timestamp": "01:15:31", "text": "而且媒体部分真的是全动画制作的。"}, {"type": "subtitle", "time": 4534.88, "timestamp": "01:15:34", "text": "是全动画制作的。 呃，就像一个真正的动漫网站。"}, {"type": "subtitle", "time": 4538.64, "timestamp": "01:15:38", "text": "呃，就像一个真正的动漫网站。 真的很好。"}, {"type": "subtitle", "time": 4546.229, "timestamp": "01:15:46", "text": "哦。嗯，我"}, {"type": "subtitle", "time": 4549.27, "timestamp": "01:15:49", "text": "现在在等剩下的剧集了。不，我猜他们"}, {"type": "subtitle", "time": 4552.31, "timestamp": "01:15:52", "text": "没有多个结局。是啊。等等，"}, {"type": "subtitle", "time": 4554.63, "timestamp": "01:15:54", "text": "主题曲有个“全部查看”按钮"}, {"type": "subtitle", "time": 4557.03, "timestamp": "01:15:57", "text": "。哦不，我觉得他们会"}, {"type": "subtitle", "time": 4559.75, "timestamp": "01:15:59", "text": "放很多歌。"}]
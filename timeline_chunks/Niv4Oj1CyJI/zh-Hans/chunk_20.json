[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "，它断线了。"}, {"type": "subtitle", "time": 1202.95, "timestamp": "00:20:02", "text": "它并没有停止。 实际上并没有断线"}, {"type": "subtitle", "time": 1204.15, "timestamp": "00:20:04", "text": "。"}, {"type": "subtitle", "time": 1206.15, "timestamp": "00:20:06", "text": "没有。 好的，等等。 那我就做"}, {"type": "subtitle", "time": 1208.23, "timestamp": "00:20:08", "text": "五秒钟吧。 等等，你怎么数数？"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "5秒。 好的。 你好。 三、二、一。"}, {"type": "subtitle", "time": 1221.11, "timestamp": "00:20:21", "text": "它断了吗？   是的"}, {"type": "subtitle", "time": 1223.75, "timestamp": "00:20:23", "text": "，两秒钟后。 没关系。"}, {"type": "subtitle", "time": 1226.789, "timestamp": "00:20:26", "text": "我们还只是热身而已。"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "呃，不。"}, {"type": "subtitle", "time": 1231.43, "timestamp": "00:20:31", "text": "再试一次。"}, {"type": "subtitle", "time": 1233.99, "timestamp": "00:20:33", "text": "好的。"}, {"type": "subtitle", "time": 1245.909, "timestamp": "00:20:45", "text": "它断线了，对吧？   是的"}, {"type": "subtitle", "time": 1247.19, "timestamp": "00:20:47", "text": "。"}, {"type": "subtitle", "time": 1250.95, "timestamp": "00:20:50", "text": "你好。 你如何判断自己是否……呃，"}, {"type": "subtitle", "time": 1253.75, "timestamp": "00:20:53", "text": "你是否……呃，你的声音是否出现破音之"}]
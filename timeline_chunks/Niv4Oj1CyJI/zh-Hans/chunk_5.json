[{"type": "subtitle", "time": 302.39, "timestamp": "00:05:02", "text": "。 我们会过来。"}, {"type": "subtitle", "time": 306.55, "timestamp": "00:05:06", "text": "我们需要呼吁制作音乐视频。"}, {"type": "subtitle", "time": 309.35, "timestamp": "00:05:09", "text": "音乐视频。 感觉我们要做的事情太多了"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "。 不，"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "哦，就像一个简单的就够了，就像"}, {"type": "subtitle", "time": 317.83, "timestamp": "00:05:17", "text": "在底部加个副标题，就像一半那样，"}, {"type": "subtitle", "time": 321.59, "timestamp": "00:05:21", "text": "每个人都可以做封面。"}, {"type": "subtitle", "time": 324.31, "timestamp": "00:05:24", "text": "这就是我想要达到的效果。 我负责绘制"}, {"type": "subtitle", "time": 331.99, "timestamp": "00:05:31", "text": "。 那很好。"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "好的。 嗯，"}, {"type": "subtitle", "time": 335.749, "timestamp": "00:05:35", "text": "你带麦克风了吗？"}, {"type": "subtitle", "time": 338.71, "timestamp": "00:05:38", "text": "麦克风？ 麦克风还是有点坏。 我"}, {"type": "subtitle", "time": 340.07, "timestamp": "00:05:40", "text": "没买任何人。"}, {"type": "subtitle", "time": 343.749, "timestamp": "00:05:43", "text": "不，我的意思是像在贵宾影城里那样。"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "哦。 哦。 哦。 我不知道该怎么放置它"}, {"type": "subtitle", "time": 349.27, "timestamp": "00:05:49", "text": "。"}, {"type": "subtitle", "time": 352.07, "timestamp": "00:05:52", "text": "嗯哼。 它就像一件物品。 呃，你看到"}, {"type": "subtitle", "time": 354.55, "timestamp": "00:05:54", "text": "星星了吗？"}, {"type": "subtitle", "time": 358.23, "timestamp": "00:05:58", "text": "是的，我想我有一些……等等，"}]
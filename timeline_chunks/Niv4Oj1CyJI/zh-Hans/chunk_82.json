[{"type": "subtitle", "time": 4922.95, "timestamp": "01:22:02", "text": "好吧，就是那种词汇，好吧，呃，"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "哇，他/她/她，像个很酷的家伙，像个"}, {"type": "subtitle", "time": 4933.03, "timestamp": "01:22:13", "text": "del类型的，"}, {"type": "subtitle", "time": 4933.83, "timestamp": "01:22:13", "text": "所以"}, {"type": "subtitle", "time": 4938.07, "timestamp": "01:22:18", "text": "不知为何让我想起了《"}, {"type": "subtitle", "time": 4941.189, "timestamp": "01:22:21", "text": "最伟大的"}, {"type": "subtitle", "time": 4951.35, "timestamp": "01:22:31", "text": "漫画里，是的，"}, {"type": "subtitle", "time": 4956.31, "timestamp": "01:22:36", "text": "它太可爱了，伙计，"}, {"type": "subtitle", "time": 4958.79, "timestamp": "01:22:38", "text": "我不在乎。哦，它们都在那里。《"}, {"type": "subtitle", "time": 4963.11, "timestamp": "01:22:43", "text": "巧克力人生》。全巧克力。"}, {"type": "subtitle", "time": 4964.629, "timestamp": "01:22:44", "text": "哦，你做了。感觉怎么样？是的"}, {"type": "subtitle", "time": 4967.51, "timestamp": "01:22:47", "text": "，很好。还有冰淇淋，"}, {"type": "subtitle", "time": 4969.99, "timestamp": "01:22:49", "text": "像三个。"}, {"type": "subtitle", "time": 4975.51, "timestamp": "01:22:55", "text": "你好。"}]
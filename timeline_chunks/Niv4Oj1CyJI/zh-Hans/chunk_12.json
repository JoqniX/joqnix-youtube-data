[{"type": "subtitle", "time": 734.31, "timestamp": "00:12:14", "text": "[音乐]"}, {"type": "subtitle", "time": 736.25, "timestamp": "00:12:16", "text": "哦，好的。"}, {"type": "subtitle", "time": 746.71, "timestamp": "00:12:26", "text": "[音乐]"}, {"type": "subtitle", "time": 749.59, "timestamp": "00:12:29", "text": "又一个较长的音符。 知道了。"}, {"type": "subtitle", "time": 753.99, "timestamp": "00:12:33", "text": "那部分不需要写太长的注释。 实际上，我只是唱了一下，"}, {"type": "subtitle", "time": 755.75, "timestamp": "00:12:35", "text": "因为一遍就过了。 我"}, {"type": "subtitle", "time": 757.75, "timestamp": "00:12:37", "text": "只是唱了一下，因为，"}, {"type": "subtitle", "time": 759.67, "timestamp": "00:12:39", "text": "嗯，这不是一个长音。 你"}, {"type": "subtitle", "time": 760.79, "timestamp": "00:12:40", "text": "不必唱这首歌。"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "等等，这是第一遍。 哇。"}, {"type": "subtitle", "time": 766.31, "timestamp": "00:12:46", "text": "你是怎么做到的？是的，"}, {"type": "subtitle", "time": 769.03, "timestamp": "00:12:49", "text": "我当时正在搬家。 我们当时在合作，我说"}, {"type": "subtitle", "time": 770.949, "timestamp": "00:12:50", "text": "我们需要"}, {"type": "subtitle", "time": 773.509, "timestamp": "00:12:53", "text": "为我的配音制作一个样本，然后我说，好吧，"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "我们录一遍，把它放到"}, {"type": "subtitle", "time": 778.069, "timestamp": "00:12:58", "text": "伴奏上完成就行了。   事情就是这样"}]
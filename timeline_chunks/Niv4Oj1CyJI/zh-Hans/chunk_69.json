[{"type": "subtitle", "time": 4142.07, "timestamp": "01:09:02", "text": "这将是第一部以这种方式呈现的动画"}, {"type": "subtitle", "time": 4143.03, "timestamp": "01:09:03", "text": "。"}, {"type": "subtitle", "time": 4146.709, "timestamp": "01:09:06", "text": "是的，我的意思是，这个人确实有多首"}, {"type": "subtitle", "time": 4149.13, "timestamp": "01:09:09", "text": "片尾曲。"}, {"type": "subtitle", "time": 4150.55, "timestamp": "01:09:10", "text": "[音乐]"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "我只知道是因为 Canary Canaria 就像是其中之一"}, {"type": "subtitle", "time": 4157.43, "timestamp": "01:09:17", "text": "。 歌手和"}, {"type": "subtitle", "time": 4159.03, "timestamp": "01:09:19", "text": "制作人。 是的。"}, {"type": "subtitle", "time": 4162.55, "timestamp": "01:09:22", "text": "等等，"}, {"type": "subtitle", "time": 4171.91, "timestamp": "01:09:31", "text": "片尾曲。"}, {"type": "subtitle", "time": 4174.87, "timestamp": "01:09:34", "text": "什么？ 这很酷。 太酷了。"}, {"type": "subtitle", "time": 4176.789, "timestamp": "01:09:36", "text": "呃，好像有好几首片尾曲"}, {"type": "subtitle", "time": 4180.07, "timestamp": "01:09:40", "text": "。 这就是我发现的情况。"}, {"type": "subtitle", "time": 4181.669, "timestamp": "01:09:41", "text": "什么？ 好的。"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "是的，有些动漫就是这样。"}, {"type": "subtitle", "time": 4187.269, "timestamp": "01:09:47", "text": "是的，有些青柠会这样。 你说得对。"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "你看过《神秘之王》吗？"}, {"type": "subtitle", "time": 4193.03, "timestamp": "01:09:53", "text": "哪一位之主？"}, {"type": "subtitle", "time": 4195.35, "timestamp": "01:09:55", "text": "悬疑类动漫。 这是中国动漫"}, {"type": "subtitle", "time": 4197.99, "timestamp": "01:09:57", "text": "或者狗。"}, {"type": "subtitle", "time": 4199.51, "timestamp": "01:09:59", "text": "呃，"}]
[{"type": "subtitle", "time": 1268.31, "timestamp": "00:21:08", "text": "比如当我……呃，按住不"}, {"type": "subtitle", "time": 1271.83, "timestamp": "00:21:11", "text": "唱歌的时候，会有一些声音效果。 呃，"}, {"type": "subtitle", "time": 1288.47, "timestamp": "00:21:28", "text": "我从来没为此担心过。 就是这样。"}, {"type": "subtitle", "time": 1297.11, "timestamp": "00:21:37", "text": "我喜欢唱歌，但"}, {"type": "subtitle", "time": 1299.909, "timestamp": "00:21:39", "text": "唱歌的时候声音里会有点沙哑，有点像"}, {"type": "subtitle", "time": 1302.31, "timestamp": "00:21:42", "text": "华夫饼的"}, {"type": "subtitle", "time": 1305.19, "timestamp": "00:21:45", "text": "声音。"}, {"type": "subtitle", "time": 1307.75, "timestamp": "00:21:47", "text": "连我自己都不知道我"}, {"type": "subtitle", "time": 1310.789, "timestamp": "00:21:50", "text": "唱歌是不是那样。 就是那件事。"}, {"type": "subtitle", "time": 1312.789, "timestamp": "00:21:52", "text": "我就唱这首歌"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "。"}, {"type": "subtitle", "time": 1317.11, "timestamp": "00:21:57", "text": "他只会唱歌唱歌。   是的"}, {"type": "subtitle", "time": 1317.99, "timestamp": "00:21:57", "text": "。"}]
[{"type": "subtitle", "time": 4203.75, "timestamp": "01:10:03", "text": "主啊，呃，那是什么？"}, {"type": "subtitle", "time": 4207.189, "timestamp": "01:10:07", "text": "我想我还没看过《超级"}, {"type": "subtitle", "time": 4209.83, "timestamp": "01:10:09", "text": "魔方》，但我看过《超级可爱》，然后我"}, {"type": "subtitle", "time": 4212.709, "timestamp": "01:10:12", "text": "受到了启发，然后我读完了整本轻"}, {"type": "subtitle", "time": 4217.75, "timestamp": "01:10:17", "text": "小说，轻小说，不，是那个，"}, {"type": "subtitle", "time": 4221.35, "timestamp": "01:10:21", "text": "呃，它叫什么来着，那个韩国的东西，我在"}, {"type": "subtitle", "time": 4236.55, "timestamp": "01:10:36", "text": "呃，《超级魔方》。"}, {"type": "subtitle", "time": 4238.39, "timestamp": "01:10:38", "text": "超级立方体之类的东西。"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "好的。 好的。 我当时想，我需要超负荷"}, {"type": "subtitle", "time": 4247.43, "timestamp": "01:10:47", "text": "运转我的大脑，看看我知道自己喜欢什么，也"}, {"type": "subtitle", "time": 4249.669, "timestamp": "01:10:49", "text": "知道很多知识。 于是我就问，感觉"}, {"type": "subtitle", "time": 4252.149, "timestamp": "01:10:52", "text": "怎么样？"}, {"type": "subtitle", "time": 4255.11, "timestamp": "01:10:55", "text": "是的，这本书的版式很方正。   这本书有"}]
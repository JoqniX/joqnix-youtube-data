[{"type": "subtitle", "time": 185.27, "timestamp": "00:03:05", "text": "过去一段时间了。 嗯……嗯……"}, {"type": "subtitle", "time": 187.27, "timestamp": "00:03:07", "text": "我们上次合作是什么时候？"}, {"type": "subtitle", "time": 190.79, "timestamp": "00:03:10", "text": "是的，那一个月我"}, {"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "就是那个人。"}, {"type": "subtitle", "time": 195.67, "timestamp": "00:03:15", "text": "是的，因为我刚从我的频道回来。"}, {"type": "subtitle", "time": 203.75, "timestamp": "00:03:23", "text": "考试比"}, {"type": "subtitle", "time": 205.589, "timestamp": "00:03:25", "text": "自由更重要。   是的"}, {"type": "subtitle", "time": 208.07, "timestamp": "00:03:28", "text": "，一切都结束了。 我希望那是"}, {"type": "subtitle", "time": 211.82999999999998, "timestamp": "00:03:31", "text": "自由。 我的天哪。 哦，那段酷刑经历"}, {"type": "subtitle", "time": 221.67000000000002, "timestamp": "00:03:41", "text": "好的。 嗯，是的，我们会，我们会，"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "Dasa会再次教我唱歌"}, {"type": "subtitle", "time": 226.55, "timestamp": "00:03:46", "text": "。"}, {"type": "subtitle", "time": 228.71, "timestamp": "00:03:48", "text": "对，再唱一遍那些歌词，这样"}, {"type": "subtitle", "time": 230.789, "timestamp": "00:03:50", "text": "我就可以和你合作制作"}, {"type": "subtitle", "time": 234.63, "timestamp": "00:03:54", "text": "音乐视频了，"}, {"type": "subtitle", "time": 237.27, "timestamp": "00:03:57", "text": "我觉得那会是一次很有趣的经历。   是的，那"}]
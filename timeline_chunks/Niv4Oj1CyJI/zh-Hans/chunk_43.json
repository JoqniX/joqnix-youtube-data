[{"type": "subtitle", "time": 2613.03, "timestamp": "00:43:33", "text": "他唱得比你自信多了。"}, {"type": "subtitle", "time": 2615.91, "timestamp": "00:43:35", "text": "这就是他这么说的原因。"}, {"type": "subtitle", "time": 2617.91, "timestamp": "00:43:37", "text": "不过，他现在说话更有信心了。"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "即使你犯了一个错误，听起来"}, {"type": "subtitle", "time": 2622.79, "timestamp": "00:43:42", "text": "反而会更有自信，效果也会"}, {"type": "subtitle", "time": 2625.75, "timestamp": "00:43:45", "text": "更好。 所以它才会"}, {"type": "subtitle", "time": 2627.589, "timestamp": "00:43:47", "text": "自信地说“是的”。"}, {"type": "subtitle", "time": 2629.75, "timestamp": "00:43:49", "text": "你好。"}, {"type": "subtitle", "time": 2634.309, "timestamp": "00:43:54", "text": "就像突然之间，"}, {"type": "subtitle", "time": 2637.829, "timestamp": "00:43:57", "text": "自信心一下子就提升了。"}, {"type": "subtitle", "time": 2639.03, "timestamp": "00:43:59", "text": "我的天啊。"}]
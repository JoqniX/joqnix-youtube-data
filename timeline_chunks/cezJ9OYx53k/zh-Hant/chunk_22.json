[{"type": "subtitle", "time": 1321.669, "timestamp": "00:22:01", "text": "並加以擴展。"}, {"type": "subtitle", "time": 1323.75, "timestamp": "00:22:03", "text": "利維坦是誰來著？"}, {"type": "subtitle", "time": 1325.35, "timestamp": "00:22:05", "text": "這種增強功能（音樂）使我們能夠進行"}, {"type": "subtitle", "time": 1326.07, "timestamp": "00:22:06", "text": "檢測。"}, {"type": "subtitle", "time": 1328.23, "timestamp": "00:22:08", "text": "幸運的是，並非所有這些頻率都與"}, {"type": "subtitle", "time": 1330.87, "timestamp": "00:22:10", "text": "利維坦有關。未被"}, {"type": "subtitle", "time": 1332.63, "timestamp": "00:22:12", "text": "分配到關鍵任務的花童已被"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "派往調查。"}, {"type": "subtitle", "time": 1337.11, "timestamp": "00:22:17", "text": "海岸守護者也將部分"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "計算用於"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "我們當中沒有人能夠識別這種異常情況。"}, {"type": "subtitle", "time": 1344.87, "timestamp": "00:22:24", "text": "海岸守護者在氣溶膠中。"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "時隔這麼久終於見到短跑選手了"}, {"type": "subtitle", "time": 1363.99, "timestamp": "00:22:43", "text": "。  我並沒有刻意練習捕手角色。於是我開始做點什麼，然後"}]
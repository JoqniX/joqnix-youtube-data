[{"type": "subtitle", "time": 1265.029, "timestamp": "00:21:05", "text": "黑人表演的。好了，我們走吧。"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "他們現在更改了用戶介面和其他所有內容"}, {"type": "subtitle", "time": 1278.789, "timestamp": "00:21:18", "text": "他們改變了很多用戶界面和其他很多"}, {"type": "subtitle", "time": 1291.909, "timestamp": "00:21:31", "text": "呃，不用告訴我音頻電平。"}, {"type": "subtitle", "time": 1303.029, "timestamp": "00:21:43", "text": "瓦倫蒂娜在一起了。"}, {"type": "subtitle", "time": 1305.83, "timestamp": "00:21:45", "text": "A組開始資料預處理。"}, {"type": "subtitle", "time": 1307.99, "timestamp": "00:21:47", "text": "B組部署地面乾擾"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "消除器。 [音樂]"}, {"type": "subtitle", "time": 1312.549, "timestamp": "00:21:52", "text": "哦，羅孚。黑岸幫不久前找回了"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "索倫諾迪亞人的寶石。我的"}, {"type": "subtitle", "time": 1317.83, "timestamp": "00:21:57", "text": "意思是，利維坦的本質。"}, {"type": "subtitle", "time": 1319.83, "timestamp": "00:21:59", "text": "Teis 系統對音樂進行了深入分析"}]
[{"type": "subtitle", "time": 1980.389, "timestamp": "00:33:00", "text": "這意味著人們我們必須做好的，什麼是什麼，然後就跳到這個"}, {"type": "subtitle", "time": 1990.557, "timestamp": "00:33:10", "text": "我們必須完成整個任務。"}, {"type": "subtitle", "time": 1991.11, "timestamp": "00:33:11", "text": "[嗤笑]"}, {"type": "subtitle", "time": 1994.07, "timestamp": "00:33:14", "text": "然後"}, {"type": "subtitle", "time": 1997.029, "timestamp": "00:33:17", "text": "就像在"}, {"type": "subtitle", "time": 1999.99, "timestamp": "00:33:19", "text": "夜之城一樣。"}, {"type": "subtitle", "time": 2003.83, "timestamp": "00:33:23", "text": "那我或許會把它做成兩集影集。"}, {"type": "subtitle", "time": 2018.95, "timestamp": "00:33:38", "text": "[清喉嚨]"}, {"type": "subtitle", "time": 2021.99, "timestamp": "00:33:41", "text": "如果我跳過某些內容，請不要介意。"}]
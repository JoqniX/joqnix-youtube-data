[{"type": "subtitle", "time": 1521.51, "timestamp": "00:25:21", "text": "這很糟糕。情況非常糟糕。"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "看看我的"}, {"type": "subtitle", "time": 1523.83, "timestamp": "00:25:23", "text": "釀酒小姐。我們理解您的"}, {"type": "subtitle", "time": 1524.63, "timestamp": "00:25:24", "text": "擔憂，"}, {"type": "subtitle", "time": 1526.87, "timestamp": "00:25:26", "text": "但 Teis 系統擁有完整的…"}, {"type": "subtitle", "time": 1530.31, "timestamp": "00:25:30", "text": "您更信任那些電線而不是我。昨晚我夢見"}, {"type": "subtitle", "time": 1534.47, "timestamp": "00:25:34", "text": "窗外有三棟倒扣的房子。那可不是什麼"}, {"type": "subtitle", "time": 1537.83, "timestamp": "00:25:37", "text": "好兆頭。我感到精力充沛。"}, {"type": "subtitle", "time": 1541.35, "timestamp": "00:25:41", "text": "哦，她糟透了。有生命的東西是……"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "不是我們不信任你，布林小姐"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "。就是你上次"}, {"type": "subtitle", "time": 1549.75, "timestamp": "00:25:49", "text": "夢見黑貓跳舞的那次。 Teis 完成全面診斷後，我們將"}, {"type": "subtitle", "time": 1551.669, "timestamp": "00:25:51", "text": "開始平行[音樂]觀測"}, {"type": "subtitle", "time": 1556.07, "timestamp": "00:25:56", "text": "。這是為了大家在"}, {"type": "subtitle", "time": 1557.11, "timestamp": "00:25:57", "text": "黑暗中的安全。  呃，"}]
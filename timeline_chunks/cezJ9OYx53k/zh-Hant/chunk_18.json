[{"type": "subtitle", "time": 1082.39, "timestamp": "00:18:02", "text": "。我會調整到我能看清的位置"}, {"type": "subtitle", "time": 1085.83, "timestamp": "00:18:05", "text": "。聊天室裡有人可以打點"}, {"type": "subtitle", "time": 1093.75, "timestamp": "00:18:13", "text": "得怎麼樣？我今天過得"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "很好。呃，我的一天才剛開始。"}, {"type": "subtitle", "time": 1099.35, "timestamp": "00:18:19", "text": "我最喜歡的角色是強盜。我"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "也是。計時器是做什麼用的？計時器就是"}, {"type": "subtitle", "time": 1105.19, "timestamp": "00:18:25", "text": "時鐘。計時器就是時鐘。你好，"}, {"type": "subtitle", "time": 1109.43, "timestamp": "00:18:29", "text": "星星們。目前為止，食物怎麼樣？呃，"}, {"type": "subtitle", "time": 1112.63, "timestamp": "00:18:32", "text": "日本料理。呃，是“我們我們我們”，我正在"}, {"type": "subtitle", "time": 1116.07, "timestamp": "00:18:36", "text": "改編它。適應它。  很"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "粗糙。  是的。"}, {"type": "subtitle", "time": 1123.327, "timestamp": "00:18:43", "text": "我們破產了。呃，我們快餓死了。"}, {"type": "subtitle", "time": 1134.789, "timestamp": "00:18:54", "text": "我的團隊是 ro 和 ammonet。 Aminate是誰"}, {"type": "subtitle", "time": 1138.87, "timestamp": "00:18:58", "text": "？莫奈是誰？我常常"}]
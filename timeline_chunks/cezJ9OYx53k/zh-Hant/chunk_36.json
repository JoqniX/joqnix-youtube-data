[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "她被這個"}, {"type": "subtitle", "time": 2191.589, "timestamp": "00:36:31", "text": "如果你不經常玩遊戲，不，"}, {"type": "subtitle", "time": 2193.51, "timestamp": "00:36:33", "text": "你會忘記劇情的。我遇到的情況就是這樣"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "。我忘了故事內容了。"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "雷諾西塔之後發生了什麼事？我們為什麼會在"}, {"type": "subtitle", "time": 2201.43, "timestamp": "00:36:41", "text": "這裡？"}]
[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "，我想我沒去過這裡。我"}, {"type": "subtitle", "time": 1205.51, "timestamp": "00:20:05", "text": "剛剛解鎖了傳送點，"}, {"type": "subtitle", "time": 1211.669, "timestamp": "00:20:11", "text": "現在好像多了很多城市，對吧？"}, {"type": "subtitle", "time": 1215.909, "timestamp": "00:20:15", "text": "還有更多地區。"}, {"type": "subtitle", "time": 1219.19, "timestamp": "00:20:19", "text": "是的，有黑人表演。我知道。"}, {"type": "subtitle", "time": 1221.99, "timestamp": "00:20:21", "text": "羅亞森林是什麼？我想，這大概是個新地方吧"}, {"type": "subtitle", "time": 1234.87, "timestamp": "00:20:34", "text": "一想到沒有廚師"}, {"type": "subtitle", "time": 1245.19, "timestamp": "00:20:45", "text": "請容許我暫時保守這個秘密"}, {"type": "subtitle", "time": 1245.83, "timestamp": "00:20:45", "text": "。"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "等等，那是卡拉。等等，我們可不是來"}, {"type": "subtitle", "time": 1256.31, "timestamp": "00:20:56", "text": "這裡"}]
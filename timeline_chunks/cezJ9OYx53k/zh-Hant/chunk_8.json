[{"type": "subtitle", "time": 486.71, "timestamp": "00:08:06", "text": "我想給你看這條推文，但"}, {"type": "subtitle", "time": 491.67, "timestamp": "00:08:11", "text": "登入手續太麻煩了。快點。"}, {"type": "subtitle", "time": 495.67, "timestamp": "00:08:15", "text": "我忘了登出帳號。"}, {"type": "subtitle", "time": 510.39, "timestamp": "00:08:30", "text": "我再補充一點，這樣你們就能看到了。"}, {"type": "subtitle", "time": 517.19, "timestamp": "00:08:37", "text": "等等，我們該怎麼辦？哦，視窗捕獲。"}, {"type": "subtitle", "time": 524.47, "timestamp": "00:08:44", "text": "糾正我。"}, {"type": "subtitle", "time": 529.03, "timestamp": "00:08:49", "text": "是的，如推文所說。嗯，等等，讓我"}, {"type": "subtitle", "time": 531.91, "timestamp": "00:08:51", "text": "調整一下大小。抱歉，袖口有點問題。是的。所以，"}, {"type": "subtitle", "time": 535.11, "timestamp": "00:08:55", "text": "如果你不知道的話，去年我向"}, {"type": "subtitle", "time": 538.949, "timestamp": "00:08:58", "text": "Quero 遊戲抱怨，因為"}]
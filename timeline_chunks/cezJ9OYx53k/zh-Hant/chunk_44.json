[{"type": "subtitle", "time": 2665.51, "timestamp": "00:44:25", "text": "穩定。一旦你擴張，就會慢慢"}, {"type": "subtitle", "time": 2667.27, "timestamp": "00:44:27", "text": "腐蝕你的目標群。他們"}, {"type": "subtitle", "time": 2669.109, "timestamp": "00:44:29", "text": "反腐敗的輔助手段體現在"}, {"type": "subtitle", "time": 2670.87, "timestamp": "00:44:30", "text": "穩定性上。  攻擊"}, {"type": "subtitle", "time": 2682.87, "timestamp": "00:44:42", "text": "時減少。如果體力耗盡，探索"}, {"type": "subtitle", "time": 2688.63, "timestamp": "00:44:48", "text": "將終止。你馬厩裡的所有物品是什麼？  受到影響時會減少，同時鑽石穩定性也會喪失。爆炸將會"}]
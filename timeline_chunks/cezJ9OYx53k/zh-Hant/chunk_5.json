[{"type": "subtitle", "time": 300.95, "timestamp": "00:05:00", "text": "沒錯，"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "露西和麗貝卡也參加了比賽，所以情況很"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "瘋狂。那麼，嗯，我們今天的"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "直播就從Sang開始。呃，我已經"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "很久沒玩環形波了。"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "所以，我們必須"}, {"type": "subtitle", "time": 323.99, "timestamp": "00:05:23", "text": "進行一次非常大的時間跳躍，才能"}, {"type": "subtitle", "time": 327.493, "timestamp": "00:05:27", "text": "進行這次聯動劇情活動。所以"}, {"type": "subtitle", "time": 329.99, "timestamp": "00:05:29", "text": "[嗤笑]今天的直播只講合作"}, {"type": "subtitle", "time": 332.31, "timestamp": "00:05:32", "text": "故事。你好。合作"}, {"type": "subtitle", "time": 334.23, "timestamp": "00:05:34", "text": "故事結束後，我們將結束直播。"}, {"type": "subtitle", "time": 337.99, "timestamp": "00:05:37", "text": "來。你好。呃，我不太清楚合作故事有多長"}, {"type": "subtitle", "time": 340.79, "timestamp": "00:05:40", "text": "。嗯，就像交換一樣，大概"}, {"type": "subtitle", "time": 349.99, "timestamp": "00:05:49", "text": "現在你可以更清楚地看到聊天內容了。 （嗤笑）"}, {"type": "subtitle", "time": 352.79, "timestamp": "00:05:52", "text": "我添加了一些東西，而且我們的"}, {"type": "subtitle", "time": 357.624, "timestamp": "00:05:57", "text": "背景也很酷。"}, {"type": "subtitle", "time": 358.93399999999997, "timestamp": "00:05:58", "text": "[哼]"}]
[{"type": "subtitle", "time": 1560.23, "timestamp": "00:26:00", "text": "等你忙完了，"}, {"type": "subtitle", "time": 1564.149, "timestamp": "00:26:04", "text": "但是那些不朽者就太老了，"}, {"type": "subtitle", "time": 1566.31, "timestamp": "00:26:06", "text": "我知道，對吧？我想回來"}, {"type": "subtitle", "time": 1568.95, "timestamp": "00:26:08", "text": "快速處理一些事情，你知道，修繕一下"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "娛樂設施。各種聲音此起彼伏，彷彿陷入了僵局，糾纏不清"}, {"type": "subtitle", "time": 1577.99, "timestamp": "00:26:17", "text": "。僵局。它被困"}, {"type": "subtitle", "time": 1580.87, "timestamp": "00:26:20", "text": "在某種陣型中。它根本不應該存在"}, {"type": "subtitle", "time": 1582.39, "timestamp": "00:26:22", "text": "於這個世界。  是的"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "。等等，我們在說什麼？"}, {"type": "subtitle", "time": 1588.47, "timestamp": "00:26:28", "text": "或許我也能幫忙破解這個謎題。"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "實際上，我已經給你看過了。"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "等等，我們真的要進行"}, {"type": "subtitle", "time": 1606.789, "timestamp": "00:26:46", "text": "前傳任務之類的？"}, {"type": "subtitle", "time": 1614.71, "timestamp": "00:26:54", "text": "我的天啊。哦，確實如此。  那"}]
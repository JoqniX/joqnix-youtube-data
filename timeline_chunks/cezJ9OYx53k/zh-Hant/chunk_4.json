[{"type": "subtitle", "time": 243.27, "timestamp": "00:04:03", "text": "大家好，早安！你好。你好。  哎呀，"}, {"type": "subtitle", "time": 244.869, "timestamp": "00:04:04", "text": "我今天嗓子啞了"}, {"type": "subtitle", "time": 246.39, "timestamp": "00:04:06", "text": "。  你好。"}, {"type": "subtitle", "time": 250.47, "timestamp": "00:04:10", "text": "呃，我們有機器人。讓我來扮演"}, {"type": "subtitle", "time": 254.149, "timestamp": "00:04:14", "text": "這個人吧。  我勒個去"}, {"type": "subtitle", "time": 260.027, "timestamp": "00:04:20", "text": "？讓它消失吧。 [哼]"}, {"type": "subtitle", "time": 261.27, "timestamp": "00:04:21", "text": "[清嗓子]"}, {"type": "subtitle", "time": 264.07, "timestamp": "00:04:24", "text": "大家好。所以今天我們要演奏的是《"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "凋零之波》。我已經很久沒玩"}, {"type": "subtitle", "time": 269.189, "timestamp": "00:04:29", "text": "這個遊戲了。"}, {"type": "subtitle", "time": 272.87, "timestamp": "00:04:32", "text": "所以，我很興奮能嘗試[音樂]，"}, {"type": "subtitle", "time": 276.07, "timestamp": "00:04:36", "text": "當然，只是因為……嗯，這次有"}, {"type": "subtitle", "time": 279.749, "timestamp": "00:04:39", "text": "個特別的合作，"}, {"type": "subtitle", "time": 284.23, "timestamp": "00:04:44", "text": "而且故事也很好，嗯，自從遊戲發售後動畫也上映以來，我就一直是《"}, {"type": "subtitle", "time": 287.11, "timestamp": "00:04:47", "text": "賽博朋克2077》的忠實粉絲"}, {"type": "subtitle", "time": 294.31, "timestamp": "00:04:54", "text": "。我想我"}, {"type": "subtitle", "time": 297.189, "timestamp": "00:04:57", "text": "以前也在直播中玩過這款遊戲"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "。"}]
[{"type": "subtitle", "time": 1140.95, "timestamp": "00:19:00", "text": "做飯，因為我其實還不會"}, {"type": "subtitle", "time": 1143.51, "timestamp": "00:19:03", "text": "做飯。呃，我的室友正在"}, {"type": "subtitle", "time": 1147.11, "timestamp": "00:19:07", "text": "做菜。我今年必須學習一些東西，我的"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "目標是學習烹飪之類的技能，"}, {"type": "subtitle", "time": 1152.31, "timestamp": "00:19:12", "text": "這樣在"}, {"type": "subtitle", "time": 1155.11, "timestamp": "00:19:15", "text": "我畢業兩年後，課程結束後我才能自食其力"}, {"type": "subtitle", "time": 1157.35, "timestamp": "00:19:17", "text": "。現在我也要"}, {"type": "subtitle", "time": 1159.19, "timestamp": "00:19:19", "text": "生存下去，所以無論如何我都必須學會做菜"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "好的，我可以連接聊天視窗了。僅僅做到"}, {"type": "subtitle", "time": 1174.63, "timestamp": "00:19:34", "text": "我的工會等級是75級。我忘了。"}, {"type": "subtitle", "time": 1177.19, "timestamp": "00:19:37", "text": "我已經很久沒玩"}, {"type": "subtitle", "time": 1180.39, "timestamp": "00:19:40", "text": "這個遊戲了。"}, {"type": "subtitle", "time": 1184.15, "timestamp": "00:19:44", "text": "我唯一記得的就是我到達了"}, {"type": "subtitle", "time": 1187.35, "timestamp": "00:19:47", "text": "雷尼塔。"}, {"type": "subtitle", "time": 1189.99, "timestamp": "00:19:49", "text": "我"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "和raita在這裡做任務。故事"}, {"type": "subtitle", "time": 1195.83, "timestamp": "00:19:55", "text": "之類的。"}, {"type": "subtitle", "time": 1197.669, "timestamp": "00:19:57", "text": "嗯，是的"}]
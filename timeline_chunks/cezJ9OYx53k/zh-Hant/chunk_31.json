[{"type": "subtitle", "time": 1878.07, "timestamp": "00:31:18", "text": "這部劇是單元劇。  我查一下。一秒鐘。  經受海浪的考驗。如何進行夜之城任務。  提前解鎖第三章的跳過功能。在這個選單中啟用快速載入跳過功能後，跳過"}, {"type": "subtitle", "time": 1879.669, "timestamp": "00:31:19", "text": "內容直到到達學校，那時你"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "應該就能完成合作了。"}]
[{"type": "subtitle", "time": 360.07, "timestamp": "00:06:00", "text": "[清嗓子] 我今天嗓子啞了"}, {"type": "subtitle", "time": 362.23, "timestamp": "00:06:02", "text": "。"}, {"type": "subtitle", "time": 364.07, "timestamp": "00:06:04", "text": "嗨，"}, {"type": "subtitle", "time": 366.07, "timestamp": "00:06:06", "text": "海浪。"}, {"type": "subtitle", "time": 368.309, "timestamp": "00:06:08", "text": "希望你能聽到音頻。我會把背景音樂關掉。"}, {"type": "subtitle", "time": 373.83, "timestamp": "00:06:13", "text": "嗯，這樣應該就夠了。請告訴"}, {"type": "subtitle", "time": 377.11, "timestamp": "00:06:17", "text": "我音量是否過大"}, {"type": "subtitle", "time": 379.35, "timestamp": "00:06:19", "text": "。"}, {"type": "subtitle", "time": 382.39, "timestamp": "00:06:22", "text": "好的。我沒有，"}, {"type": "subtitle", "time": 385.35, "timestamp": "00:06:25", "text": "呃，正如你所看到的，是的，我實際上買了，我"}, {"type": "subtitle", "time": 392.07, "timestamp": "00:06:32", "text": "聽著，"}, {"type": "subtitle", "time": 396.15, "timestamp": "00:06:36", "text": "我實際上買了 Luna 的訂閱，"}, {"type": "subtitle", "time": 399.544, "timestamp": "00:06:39", "text": "所以我就想，我太需要 Lucy 了。"}, {"type": "subtitle", "time": 401.51, "timestamp": "00:06:41", "text": "[笑聲]"}, {"type": "subtitle", "time": 403.99, "timestamp": "00:06:43", "text": "那麼，在"}, {"type": "subtitle", "time": 407.909, "timestamp": "00:06:47", "text": "我開始之前還有一件事。"}, {"type": "subtitle", "time": 410.79, "timestamp": "00:06:50", "text": "如果你看過我的推特，讓我把那條"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "推文找出來。"}, {"type": "subtitle", "time": 415.67, "timestamp": "00:06:55", "text": "呃，讓我把那條推文找出來。我"}, {"type": "subtitle", "time": 419.27, "timestamp": "00:06:59", "text": "想給你看看這個。"}]
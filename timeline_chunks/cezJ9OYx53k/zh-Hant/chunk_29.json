[{"type": "subtitle", "time": 1767.83, "timestamp": "00:29:27", "text": "我有點糊塗了。等待。"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "另外，我認領了麗貝卡，她是"}, {"type": "subtitle", "time": 1788.23, "timestamp": "00:29:48", "text": "所以，基本上，我們是在做"}, {"type": "subtitle", "time": 1790.47, "timestamp": "00:29:50", "text": "La La Lro"}, {"type": "subtitle", "time": 1793.51, "timestamp": "00:29:53", "text": "區域的任務，對吧？"}, {"type": "subtitle", "time": 1795.909, "timestamp": "00:29:55", "text": "但我什麼時候才能開始夜之城"}]
[{"type": "subtitle", "time": 1446.71, "timestamp": "00:24:06", "text": "混亂之中，我發現[音樂]傳遞著一種"}, {"type": "subtitle", "time": 1449.83, "timestamp": "00:24:09", "text": "支離破碎的訊息。"}, {"type": "subtitle", "time": 1462.47, "timestamp": "00:24:22", "text": "我們已經分離出一組不斷"}, {"type": "subtitle", "time": 1466.07, "timestamp": "00:24:26", "text": "變化的空間座標。"}, {"type": "subtitle", "time": 1468.63, "timestamp": "00:24:28", "text": "一個指向未知地點。"}, {"type": "subtitle", "time": 1470.549, "timestamp": "00:24:30", "text": "留下那個訊息的另一個人非常清楚"}, {"type": "subtitle", "time": 1472.87, "timestamp": "00:24:32", "text": "黑色海岸在哪裡。  哦"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "，它幾乎會說話了。我忘了。"}, {"type": "subtitle", "time": 1478.71, "timestamp": "00:24:38", "text": "如果"}, {"type": "subtitle", "time": 1492.39, "timestamp": "00:24:52", "text": "你不信任我，沒關係，但至少信任我的船長。  我們已經告訴你了。  我會去看看。  好的。是麗貝卡嗎？我會把座標發給你，我忘了你是直男，"}, {"type": "subtitle", "time": 1494.71, "timestamp": "00:24:54", "text": "必須留在這裡繼續隔離"}, {"type": "subtitle", "time": 1496.71, "timestamp": "00:24:56", "text": "和追蹤周圍嵌入的訊息，"}]
[{"type": "subtitle", "time": 542.79, "timestamp": "00:09:02", "text": "我沒有在遊戲中領取我的"}, {"type": "subtitle", "time": 548.31, "timestamp": "00:09:08", "text": "生日蛋糕。在遊戲中，"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "每當你"}, {"type": "subtitle", "time": 552.07, "timestamp": "00:09:12", "text": "過生日的時候，他們都會給你一個蛋糕、"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "一頂帽子或其他特別的"}, {"type": "subtitle", "time": 559.11, "timestamp": "00:09:19", "text": "飾品之類的東西。"}, {"type": "subtitle", "time": 561.91, "timestamp": "00:09:21", "text": "哦，等等。我的直播快要結束了。啊，"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "Wi-Fi"}, {"type": "subtitle", "time": 574.71, "timestamp": "00:09:34", "text": "我剛剛才注意到這一點。哦，不。"}, {"type": "subtitle", "time": 577.509, "timestamp": "00:09:37", "text": "什麼？"}, {"type": "subtitle", "time": 584.31, "timestamp": "00:09:44", "text": "如果情況這樣下去，我就什麼都做不了了"}]
[{"type": "subtitle", "time": 1265.029, "timestamp": "00:21:05", "text": "ブラックショーのことだ。 よし、行こう。"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "そして、UIなどもすべて変更されたので"}, {"type": "subtitle", "time": 1278.789, "timestamp": "00:21:18", "text": "UIやその他多くの部分が大幅に変更されました"}, {"type": "subtitle", "time": 1291.909, "timestamp": "00:21:31", "text": "音声レベルについては教えてくれなくて結構です。   わかった"}, {"type": "subtitle", "time": 1303.029, "timestamp": "00:21:43", "text": "ヴァレンティーナだけ。"}, {"type": "subtitle", "time": 1305.83, "timestamp": "00:21:45", "text": "グループAはデータ準備処理を開始する。"}, {"type": "subtitle", "time": 1307.99, "timestamp": "00:21:47", "text": "グループBは地上干渉"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "抑制装置を配備する。  [音楽]"}, {"type": "subtitle", "time": 1312.549, "timestamp": "00:21:52", "text": "ああ、ローバー。 ブラックショアーズは"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "つい最近、スロノディアンの宝石を取り戻した。"}, {"type": "subtitle", "time": 1317.83, "timestamp": "00:21:57", "text": "つまり、リヴァイアサンの本質のことです。"}, {"type": "subtitle", "time": 1319.83, "timestamp": "00:21:59", "text": "Teisシステムは音楽の詳細な分析を行い、"}]
[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "彼女は今、このブラック"}, {"type": "subtitle", "time": 2191.589, "timestamp": "00:36:31", "text": "ゲームをプレイしないと、"}, {"type": "subtitle", "time": 2193.51, "timestamp": "00:36:33", "text": "ストーリーを忘れてしまうよ。"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "私にも同じことが起こりました。 その話を忘れてしまった。"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "レノシータの後はどうなったのか？ 私たちはなぜ"}, {"type": "subtitle", "time": 2201.43, "timestamp": "00:36:41", "text": "ここにいるのか？"}]
[{"type": "subtitle", "time": 360.07, "timestamp": "00:06:00", "text": "[咳払いをする] 今日は声が出ない"}, {"type": "subtitle", "time": 362.23, "timestamp": "00:06:02", "text": "。"}, {"type": "subtitle", "time": 364.07, "timestamp": "00:06:04", "text": "こんにちは、"}, {"type": "subtitle", "time": 366.07, "timestamp": "00:06:06", "text": "波。"}, {"type": "subtitle", "time": 368.309, "timestamp": "00:06:08", "text": "音声が聞こえるといいのですが。"}, {"type": "subtitle", "time": 370.55, "timestamp": "00:06:10", "text": "BGMをミュートします。"}, {"type": "subtitle", "time": 373.83, "timestamp": "00:06:13", "text": "ええと、これで十分でしょう。"}, {"type": "subtitle", "time": 377.11, "timestamp": "00:06:17", "text": "音声が大きすぎる"}, {"type": "subtitle", "time": 379.35, "timestamp": "00:06:19", "text": "かどうか教えてください。   よし"}, {"type": "subtitle", "time": 382.39, "timestamp": "00:06:22", "text": "。 ええと、ご覧のとおり、"}, {"type": "subtitle", "time": 385.35, "timestamp": "00:06:25", "text": "私は実際に購入しました。"}, {"type": "subtitle", "time": 396.15, "timestamp": "00:06:36", "text": "私は実際にLunaのサブスクリプションを購入しました。"}, {"type": "subtitle", "time": 399.544, "timestamp": "00:06:39", "text": "だから、私は「ルーシーがどうしても必要だ」と思ったのです。"}, {"type": "subtitle", "time": 401.51, "timestamp": "00:06:41", "text": "[笑い] では"}, {"type": "subtitle", "time": 403.99, "timestamp": "00:06:43", "text": "、"}, {"type": "subtitle", "time": 407.909, "timestamp": "00:06:47", "text": "始める前にもう一つ。"}, {"type": "subtitle", "time": 410.79, "timestamp": "00:06:50", "text": "もし私のツイッターを見たなら、"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "そのツイートを表示させてください。   えっと、"}, {"type": "subtitle", "time": 415.67, "timestamp": "00:06:55", "text": "ツイートを表示させてください。"}, {"type": "subtitle", "time": 419.27, "timestamp": "00:06:59", "text": "これをお見せしたいんです。"}]
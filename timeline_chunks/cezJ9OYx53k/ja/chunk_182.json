[{"type": "subtitle", "time": 10921.19, "timestamp": "03:02:01", "text": "サイバーパンクのクエストをやりたいとは思うんですが、"}, {"type": "subtitle", "time": 10923.67, "timestamp": "03:02:03", "text": "かなりスキップしなければなりません。 あまり"}, {"type": "subtitle", "time": 10930.63, "timestamp": "03:02:10", "text": "これはまずい。   こうやって続けていくうちに、もう"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "これを飛ばすことはできないような気がしてきた。   自分自身を"}, {"type": "subtitle", "time": 10949.83, "timestamp": "03:02:29", "text": "ああ、彼女が来た。"}, {"type": "subtitle", "time": 10954.07, "timestamp": "03:02:34", "text": "費用はかからなかった。 えーっと、20万くらい、"}, {"type": "subtitle", "time": 10958.23, "timestamp": "03:02:38", "text": "20万くらいかな、えーっと、"}, {"type": "subtitle", "time": 10961.19, "timestamp": "03:02:41", "text": "25万"}, {"type": "subtitle", "time": 10962.79, "timestamp": "03:02:42", "text": "5500"}, {"type": "subtitle", "time": 10971.83, "timestamp": "03:02:51", "text": "あー、15万円ですね。 え、何？"}, {"type": "subtitle", "time": 10974.71, "timestamp": "03:02:54", "text": "いいえ、2つあるはずです。 え、何？"}]
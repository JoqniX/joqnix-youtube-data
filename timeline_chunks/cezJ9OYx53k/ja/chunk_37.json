[{"type": "subtitle", "time": 2221.75, "timestamp": "00:37:01", "text": "逃げろ、ああ"}, {"type": "subtitle", "time": 2248.069, "timestamp": "00:37:28", "text": "私は彼の関数を使います。"}, {"type": "subtitle", "time": 2250.87, "timestamp": "00:37:30", "text": "僕はスパイダーマンだ。 え、"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "私は今、現実と"}, {"type": "subtitle", "time": 2261.51, "timestamp": "00:37:41", "text": "重力を破壊したのだろうか？"}, {"type": "subtitle", "time": 2269.91, "timestamp": "00:37:49", "text": "オーケー、この人たちは、東京を舞台にしたゴーストランナーという"}, {"type": "subtitle", "time": 2273.51, "timestamp": "00:37:53", "text": "別のゲームを思い出させます"}]
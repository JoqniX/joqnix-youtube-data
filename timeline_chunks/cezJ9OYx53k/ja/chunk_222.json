[{"type": "subtitle", "time": 13321.91, "timestamp": "03:42:01", "text": "ああ、自分のことを片付けてきなよ。 私がやります"}, {"type": "subtitle", "time": 13335.943, "timestamp": "03:42:15", "text": "え、彼女今スケートしたの？"}, {"type": "subtitle", "time": 13337.67, "timestamp": "03:42:17", "text": "[笑い] 何だって？"}, {"type": "subtitle", "time": 13343.67, "timestamp": "03:42:23", "text": "四角く滑った。"}, {"type": "subtitle", "time": 13346.95, "timestamp": "03:42:26", "text": "さて、これが今回のクエストです。"}]
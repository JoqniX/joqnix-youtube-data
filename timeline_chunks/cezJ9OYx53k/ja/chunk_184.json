[{"type": "subtitle", "time": 11040.71, "timestamp": "03:04:00", "text": "カスタマイズできるんだ。例えば、"}, {"type": "subtitle", "time": 11046.469, "timestamp": "03:04:06", "text": "64GBのRAMが必要だったり、32GBのRAMが必要だったり、"}, {"type": "subtitle", "time": 11048.389, "timestamp": "03:04:08", "text": "クーラーが必要だったり、LANケーブルが必要だったり、"}, {"type": "subtitle", "time": 11050.79, "timestamp": "03:04:10", "text": "ヘッドホン、スピーカー、モニター、"}, {"type": "subtitle", "time": 11054.55, "timestamp": "03:04:14", "text": "キーボードが必要だったり、アドオンのものなら何でもカスタマイズできるんだ"}, {"type": "subtitle", "time": 11057.83, "timestamp": "03:04:17", "text": "。 それで、2TV"}, {"type": "subtitle", "time": 11062.55, "timestamp": "03:04:22", "text": "SSD NVMe SSDを購入し、"}, {"type": "subtitle", "time": 11070.71, "timestamp": "03:04:30", "text": "自宅のPC用にインドからNVMe SSDを持ち帰りました。 つまり、それが第"}, {"type": "subtitle", "time": 11072.95, "timestamp": "03:04:32", "text": "3世代です。つまり、下位互換性があるということです。 だから、私は"}, {"type": "subtitle", "time": 11076.63, "timestamp": "03:04:36", "text": "2つのSSD、内蔵SSD、"}, {"type": "subtitle", "time": 11080.23, "timestamp": "03:04:40", "text": "NVMe SSDを持っていて、それから、"}, {"type": "subtitle", "time": 11086.389, "timestamp": "03:04:46", "text": "テレビと500のSSDの2つ、合計3つのSSDを持ってきました。 つまり、合計で"}, {"type": "subtitle", "time": 11090.87, "timestamp": "03:04:50", "text": "6台のSSD、もしくは5台のSSDを持っていることになります。"}, {"type": "subtitle", "time": 11093.429, "timestamp": "03:04:53", "text": "ハードディスクドライブはありません。  １、２、３、４、５"}, {"type": "subtitle", "time": 11096.71, "timestamp": "03:04:56", "text": "。  １、２、３、４。 ええ、"}, {"type": "subtitle", "time": 11099.03, "timestamp": "03:04:59", "text": "4つです。 右。"}]
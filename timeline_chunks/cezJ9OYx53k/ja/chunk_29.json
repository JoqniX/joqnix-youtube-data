[{"type": "subtitle", "time": 1767.83, "timestamp": "00:29:27", "text": "混乱しています。 待って。"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "それと、私はレベッカを請求したので、彼女は"}, {"type": "subtitle", "time": 1788.23, "timestamp": "00:29:48", "text": "つまり、基本的にはララロエリアのクエストをやっているということですよね"}, {"type": "subtitle", "time": 1793.51, "timestamp": "00:29:53", "text": "？"}, {"type": "subtitle", "time": 1795.909, "timestamp": "00:29:55", "text": "でも、ナイトシティのクエストはいつ始まるんですか"}]
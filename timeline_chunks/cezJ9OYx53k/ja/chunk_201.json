[{"type": "subtitle", "time": 12063.91, "timestamp": "03:21:03", "text": "ああ、そうだったよ。"}, {"type": "subtitle", "time": 12095.75, "timestamp": "03:21:35", "text": "私は裕福な家庭の出身ではありません"}, {"type": "subtitle", "time": 12102.87, "timestamp": "03:21:42", "text": "私は夢を追いかけるためにここに来た。そして、必ずそれを成し遂げる"}, {"type": "subtitle", "time": 12106.229, "timestamp": "03:21:46", "text": "。"}, {"type": "subtitle", "time": 12108.229, "timestamp": "03:21:48", "text": "私は生きている。   だから"}, {"type": "subtitle", "time": 12111.269, "timestamp": "03:21:51", "text": "、私の家族が何をしているかは"}, {"type": "subtitle", "time": 12112.71, "timestamp": "03:21:52", "text": "関係ないんです。"}]
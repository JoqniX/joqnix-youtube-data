[{"type": "subtitle", "time": 3553.91, "timestamp": "00:59:13", "text": "よし、行こう。"}, {"type": "subtitle", "time": 3575.99, "timestamp": "00:59:35", "text": "ナミポイントは、"}, {"type": "subtitle", "time": 3577.99, "timestamp": "00:59:37", "text": "アナミ市の探索に役立ちます。 異なるナミコンを選択することで、"}, {"type": "subtitle", "time": 3582.47, "timestamp": "00:59:42", "text": "探索中に様々なサポートスキルを発動できるようになります。"}, {"type": "subtitle", "time": 3584.39, "timestamp": "00:59:44", "text": "ナミコンバッジを着用すると、"}, {"type": "subtitle", "time": 3588.549, "timestamp": "00:59:48", "text": "オナメでの最大安定性が向上します。 都市によって異なる"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "特別な特定のステッカーセットが付属しています"}, {"type": "subtitle", "time": 3599.67, "timestamp": "00:59:59", "text": "名前ポーンマッチ"}]
[{"type": "subtitle", "time": 6249.669, "timestamp": "01:44:09", "text": "覚えているのは、"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "パイロットの人たちに会って、"}, {"type": "subtitle", "time": 6255.99, "timestamp": "01:44:15", "text": "コンサートみたいなことをして、ダンスをしたということだけだ。 いや、あの"}, {"type": "subtitle", "time": 6259.109, "timestamp": "01:44:19", "text": "ダンスは"}, {"type": "subtitle", "time": 6270.95, "timestamp": "01:44:30", "text": "私はそう信じている。"}, {"type": "subtitle", "time": 6273.83, "timestamp": "01:44:33", "text": "その後どうなったのかは分かりません。   久しぶりですね"}, {"type": "subtitle", "time": 6288.709, "timestamp": "01:44:48", "text": "それらは、あなたが"}]
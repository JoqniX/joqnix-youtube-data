[{"type": "subtitle", "time": 12010.389, "timestamp": "03:20:10", "text": "。 裏切られていないものが"}, {"type": "subtitle", "time": 12016.55, "timestamp": "03:20:16", "text": "第3章"}, {"type": "subtitle", "time": 12019.75, "timestamp": "03:20:19", "text": "プロローグを凌駕するとき。 待って、私たちは脱出しているの？ ああ、私たちは"}, {"type": "subtitle", "time": 12031.51, "timestamp": "03:20:31", "text": "私たちはレナのことはしませんでした。  50人中3人しか見えない。"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "私は大きく飛躍した。 えっと、つまり、"}, {"type": "subtitle", "time": 12046.469, "timestamp": "03:20:46", "text": "大丈夫だよ。"}]
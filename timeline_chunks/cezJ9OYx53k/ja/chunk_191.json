[{"type": "subtitle", "time": 11467.67, "timestamp": "03:11:07", "text": "家族に"}, {"type": "subtitle", "time": 11470.309, "timestamp": "03:11:10", "text": "フォレストカードで送金してもらい、"}, {"type": "subtitle", "time": 11472.79, "timestamp": "03:11:12", "text": "コンビニで支払いました。"}, {"type": "subtitle", "time": 11475.99, "timestamp": "03:11:15", "text": "到着まで5日くらいかかりました。"}, {"type": "subtitle", "time": 11482.79, "timestamp": "03:11:22", "text": "ここでは、少なくともコンビニエンスストアで現地決済ができるように、多くのことが許されている。 よかった。"}]
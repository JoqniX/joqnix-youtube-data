[{"type": "subtitle", "time": 4594.55, "timestamp": "01:16:34", "text": "それと、いつヒーローがアンロックされたんですか？"}, {"type": "subtitle", "time": 4600.87, "timestamp": "01:16:40", "text": "旅行者を見るのはこれが初めてです。 つまり、えーと、ヒーロー並みの"}, {"type": "subtitle", "time": 4602.79, "timestamp": "01:16:42", "text": "スキルを持つ強盗ってこと。"}, {"type": "subtitle", "time": 4604.87, "timestamp": "01:16:44", "text": "物語の重要な部分をかなり見逃してしまったような気がするんだけど"}]
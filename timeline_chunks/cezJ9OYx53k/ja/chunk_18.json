[{"type": "subtitle", "time": 1082.39, "timestamp": "00:18:02", "text": "そうですね。 私が見やすいように調整します"}, {"type": "subtitle", "time": 1085.83, "timestamp": "00:18:05", "text": "。 チャットで誰か"}, {"type": "subtitle", "time": 1093.75, "timestamp": "00:18:13", "text": "今日はどうですか？ 今日は"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "いい日だ。 えっと、私の1日は始まったばかりです。"}, {"type": "subtitle", "time": 1099.35, "timestamp": "00:18:19", "text": "えっと、私の一番好きなキャラクターは強盗です。 私も"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "。 タイマーは何のためにあるのですか？ タイマーは"}, {"type": "subtitle", "time": 1105.19, "timestamp": "00:18:25", "text": "時計です。 タイマーは時計です。 こんにちは、"}, {"type": "subtitle", "time": 1109.43, "timestamp": "00:18:29", "text": "星たち。 食事はどうですか？ えっと、"}, {"type": "subtitle", "time": 1112.63, "timestamp": "00:18:32", "text": "日本食。 ええと、私たちは、私たちは、私は"}, {"type": "subtitle", "time": 1116.07, "timestamp": "00:18:36", "text": "それを適応させています。 それに対応する。"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "大変だ。"}, {"type": "subtitle", "time": 1121.43, "timestamp": "00:18:41", "text": "うん。"}, {"type": "subtitle", "time": 1123.327, "timestamp": "00:18:43", "text": "そして、私たちは破産寸前です。 ああ、お腹がペコペコです。"}, {"type": "subtitle", "time": 1134.789, "timestamp": "00:18:54", "text": "私のチームはroとammonetです。"}, {"type": "subtitle", "time": 1138.87, "timestamp": "00:18:58", "text": "アミノとは誰ですか？ モネとは誰ですか？ 私は"}]
[{"type": "subtitle", "time": 13092.229, "timestamp": "03:38:12", "text": "第3章"}, {"type": "subtitle", "time": 13095.59, "timestamp": "03:38:15", "text": "まだ輝きを放っていない星々。 わかった。"}, {"type": "subtitle", "time": 13102.15, "timestamp": "03:38:22", "text": "昨日のスターライトです。"}, {"type": "subtitle", "time": 13105.03, "timestamp": "03:38:25", "text": "続編は、同じで同じです。"}, {"type": "subtitle", "time": 13107.429, "timestamp": "03:38:27", "text": "続編が多すぎる。   えっと"}]
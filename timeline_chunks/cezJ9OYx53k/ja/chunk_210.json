[{"type": "subtitle", "time": 12604.229, "timestamp": "03:30:04", "text": "そして、私はただプロを進めて"}, {"type": "subtitle", "time": 12606.79, "timestamp": "03:30:06", "text": "ドックエリアをロックし、コラボ"}, {"type": "subtitle", "time": 12616.07, "timestamp": "03:30:16", "text": "イベントのストーリーに早送りすることができます。"}, {"type": "subtitle", "time": 12618.15, "timestamp": "03:30:18", "text": "おそらく明日、コラボ"}]
[{"type": "subtitle", "time": 1140.95, "timestamp": "00:19:00", "text": "料理をたくさんしますが、まだ"}, {"type": "subtitle", "time": 1143.51, "timestamp": "00:19:03", "text": "料理の仕方がわかりません。 えっと、ルームメイトが"}, {"type": "subtitle", "time": 1147.11, "timestamp": "00:19:07", "text": "料理してるんです。 今年は"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "料理などを学ぶことを目標にしています。そうすれば、"}, {"type": "subtitle", "time": 1157.35, "timestamp": "00:19:17", "text": "卒業後2年間のコース修了後も、自分で生きていけるからです。 今は"}, {"type": "subtitle", "time": 1159.19, "timestamp": "00:19:19", "text": "生き延びなければならないので、何としても料理を覚えなければならない"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "はい、チャットに接続できます。"}, {"type": "subtitle", "time": 1174.63, "timestamp": "00:19:34", "text": "私の組合レベルは75です。忘れていました。"}, {"type": "subtitle", "time": 1180.39, "timestamp": "00:19:40", "text": "このゲームは本当に久しぶりにプレイした。"}, {"type": "subtitle", "time": 1184.15, "timestamp": "00:19:44", "text": "覚えているのは、"}, {"type": "subtitle", "time": 1187.35, "timestamp": "00:19:47", "text": "レイニタにたどり着いたということだけです。"}, {"type": "subtitle", "time": 1189.99, "timestamp": "00:19:49", "text": "私はライタで、"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "ここでクエストをやっていました。 物語"}, {"type": "subtitle", "time": 1195.83, "timestamp": "00:19:55", "text": "とかそういう類のもの。   ええ"}]
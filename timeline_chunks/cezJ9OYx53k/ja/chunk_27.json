[{"type": "subtitle", "time": 1620.39, "timestamp": "00:27:00", "text": "待って、水没した都市なのか。"}, {"type": "subtitle", "time": 1622.07, "timestamp": "00:27:02", "text": "よし、これは"}, {"type": "subtitle", "time": 1626.149, "timestamp": "00:27:06", "text": "世界がひっくり返ったように見える。 川は逆流する"}, {"type": "subtitle", "time": 1629.43, "timestamp": "00:27:09", "text": "。 太陽と月がずれてしまう"}, {"type": "subtitle", "time": 1634.23, "timestamp": "00:27:14", "text": "。 翡翠の仏像は視線を落とした。"}, {"type": "subtitle", "time": 1634.549, "timestamp": "00:27:14", "text": "でも"}, {"type": "subtitle", "time": 1635.669, "timestamp": "00:27:15", "text": "、彼女は"}, {"type": "subtitle", "time": 1639.19, "timestamp": "00:27:19", "text": "眼鏡をかけるのに向いていないわ。"}, {"type": "subtitle", "time": 1642.31, "timestamp": "00:27:22", "text": "あれは"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "ナイトシティだ。"}, {"type": "subtitle", "time": 1645.909, "timestamp": "00:27:25", "text": "ベッドが私を呼んでいる。 もう寝なくちゃ。"}, {"type": "subtitle", "time": 1649.51, "timestamp": "00:27:29", "text": "こんにちは。 あなたは一晩中オレンジ色を食べて起きていた。"}, {"type": "subtitle", "time": 1651.51, "timestamp": "00:27:31", "text": "おお。"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "うん。 うん。 少し寝なさい。 すべて"}, {"type": "subtitle", "time": 1655.59, "timestamp": "00:27:35", "text": "順調です。 すべて順調です。   ご"}, {"type": "subtitle", "time": 1667.19, "timestamp": "00:27:47", "text": "言語を変えて"}, {"type": "subtitle", "time": 1669.83, "timestamp": "00:27:49", "text": "楽しもう。 街を散策したり、遊んだりして楽しんでください。"}, {"type": "subtitle", "time": 1672.63, "timestamp": "00:27:52", "text": "こんにちは。"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "通り。"}, {"type": "subtitle", "time": 1678.23, "timestamp": "00:27:58", "text": "こんにちは。"}]
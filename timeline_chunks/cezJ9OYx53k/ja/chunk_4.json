[{"type": "subtitle", "time": 243.27, "timestamp": "00:04:03", "text": "こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 244.869, "timestamp": "00:04:04", "text": "ああ、"}, {"type": "subtitle", "time": 246.39, "timestamp": "00:04:06", "text": "今日は声が出ないよ。"}, {"type": "subtitle", "time": 250.47, "timestamp": "00:04:10", "text": "こんにちは。 ええと、ボットがあります。 ちょっと、"}, {"type": "subtitle", "time": 254.149, "timestamp": "00:04:14", "text": "この人になりきらせてください。"}, {"type": "subtitle", "time": 256.469, "timestamp": "00:04:16", "text": "なんてこった"}, {"type": "subtitle", "time": 260.027, "timestamp": "00:04:20", "text": "？ それは消え去るべきだ。  [鼻を鳴らす]"}, {"type": "subtitle", "time": 261.27, "timestamp": "00:04:21", "text": "[咳払いをする]"}, {"type": "subtitle", "time": 264.07, "timestamp": "00:04:24", "text": "みなさん、こんにちは。 今日は、ええと、ウィザリング・ウェーブ"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "スをやります。 私は"}, {"type": "subtitle", "time": 269.189, "timestamp": "00:04:29", "text": "このゲームを長い間プレイしていません。   だから、もちろん、"}, {"type": "subtitle", "time": 279.749, "timestamp": "00:04:39", "text": "特別なコラボレーションが行われていて、"}, {"type": "subtitle", "time": 284.23, "timestamp": "00:04:44", "text": "ストーリーも良く、ゲーム発売後にアニメがリリースされて以来、"}, {"type": "subtitle", "time": 287.11, "timestamp": "00:04:47", "text": "サイバーパンク・ジャーナリズムの大ファンなので、試してみるのが楽しみです"}, {"type": "subtitle", "time": 294.31, "timestamp": "00:04:54", "text": "。 過去に"}, {"type": "subtitle", "time": 297.189, "timestamp": "00:04:57", "text": "配信でこのゲームをプレイしたこともあると思います"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "。"}]
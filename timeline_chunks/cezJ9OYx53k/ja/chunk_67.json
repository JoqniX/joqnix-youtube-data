[{"type": "subtitle", "time": 4025.67, "timestamp": "01:07:05", "text": "よし、いいね。"}, {"type": "subtitle", "time": 4033.75, "timestamp": "01:07:13", "text": "。 本当はやりたくないんだけど、"}, {"type": "subtitle", "time": 4035.51, "timestamp": "01:07:15", "text": "サイバーパンク関連の番組を観たいんだ。"}, {"type": "subtitle", "time": 4037.029, "timestamp": "01:07:17", "text": "まさかこんなにたくさんのことをやらなきゃいけないなんて知らなかったよ"}, {"type": "subtitle", "time": 4041.349, "timestamp": "01:07:21", "text": "。 もっとよく調べておくべきだった。"}, {"type": "subtitle", "time": 4053.029, "timestamp": "01:07:33", "text": "臆病さかな。"}, {"type": "subtitle", "time": 4054.87, "timestamp": "01:07:34", "text": "見て、私の誕生日ケーキが来たわ。 だから、"}]
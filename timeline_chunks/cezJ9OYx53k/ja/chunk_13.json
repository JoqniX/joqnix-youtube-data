[{"type": "subtitle", "time": 781.35, "timestamp": "00:13:01", "text": "悪い日ですか？ ああ、今日は最悪だ。 わかった。 ワには彼"}, {"type": "subtitle", "time": 788.389, "timestamp": "00:13:08", "text": "おお。"}, {"type": "subtitle", "time": 791.75, "timestamp": "00:13:11", "text": "こんにちは。 え、君はキックなの？ それは"}, {"type": "subtitle", "time": 794.71, "timestamp": "00:13:14", "text": "私よりも多い。"}, {"type": "subtitle", "time": 796.79, "timestamp": "00:13:16", "text": "君は調子がいいよ。   ちょっと"}, {"type": "subtitle", "time": 802.069, "timestamp": "00:13:22", "text": "待って。"}, {"type": "subtitle", "time": 808.924, "timestamp": "00:13:28", "text": "ああ、そうだね。 ああ、シゴット。 あなたが知っている。"}, {"type": "subtitle", "time": 810.47, "timestamp": "00:13:30", "text": "[笑い]"}, {"type": "subtitle", "time": 812.629, "timestamp": "00:13:32", "text": "ああ、わかった"}, {"type": "subtitle", "time": 814.389, "timestamp": "00:13:34", "text": "。"}, {"type": "subtitle", "time": 818.15, "timestamp": "00:13:38", "text": "えっと、ビットレートをもっと下げた方がいいと思う"}, {"type": "subtitle", "time": 825.99, "timestamp": "00:13:45", "text": "ダイナミックビットレートはオンにしています。"}, {"type": "subtitle", "time": 830.71, "timestamp": "00:13:50", "text": "ですから、それは問題にならないはずです。"}, {"type": "subtitle", "time": 835.67, "timestamp": "00:13:55", "text": "デモでは160m KBBSくらいになる予定です。"}, {"type": "subtitle", "time": 839.43, "timestamp": "00:13:59", "text": "それがより恐ろしい点だ。"}]
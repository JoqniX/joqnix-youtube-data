[{"type": "subtitle", "time": 18700.55, "timestamp": "05:11:40", "text": "すべては、"}, {"type": "subtitle", "time": 18703.99, "timestamp": "05:11:43", "text": "彼が"}, {"type": "subtitle", "time": 18706.39, "timestamp": "05:11:46", "text": "密かに"}, {"type": "subtitle", "time": 18708.628, "timestamp": "05:11:48", "text": "何かをしたり、科学や"}, {"type": "subtitle", "time": 18710.868, "timestamp": "05:11:50", "text": "未来的なものに取り組んだりしているような感じがする。 だから、"}, {"type": "subtitle", "time": 18712.23, "timestamp": "05:11:52", "text": "世界征服を企む人たちが、"}, {"type": "subtitle", "time": 18719.19, "timestamp": "05:11:59", "text": "これらの怪物のサンプルを使って何かを作ったり、何かを実行したりするだろう。そしてそれが"}]
[{"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "ああ、"}, {"type": "subtitle", "time": 968.31, "timestamp": "00:16:08", "text": "ゴーストチャット。"}, {"type": "subtitle", "time": 970.87, "timestamp": "00:16:10", "text": "おい。 えっと。 あ、待って。 これを"}, {"type": "subtitle", "time": 972.47, "timestamp": "00:16:12", "text": "もう一度やらなければならない。"}, {"type": "subtitle", "time": 975.59, "timestamp": "00:16:15", "text": "やあ、相棒。   えっと"}, {"type": "subtitle", "time": 977.829, "timestamp": "00:16:17", "text": "、ちょっと待ってください。 ちょっとダウンロードさせてください"}, {"type": "subtitle", "time": 979.749, "timestamp": "00:16:19", "text": "。"}, {"type": "subtitle", "time": 982.23, "timestamp": "00:16:22", "text": "これで、"}, {"type": "subtitle", "time": 984.466, "timestamp": "00:16:24", "text": "今はシングルモニターでもチャットを読むことができるようになりました。 ということで、"}, {"type": "subtitle", "time": 985.59, "timestamp": "00:16:25", "text": "[咳払いをして喉を整える]"}, {"type": "subtitle", "time": 993.67, "timestamp": "00:16:33", "text": "ああ、"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "これをやらなきゃ。"}, {"type": "subtitle", "time": 1000.31, "timestamp": "00:16:40", "text": "何？ これをコピーして、"}, {"type": "subtitle", "time": 1013.11, "timestamp": "00:16:53", "text": "何？ 私はあなたを真似していません。 え、何？ コピー。"}, {"type": "subtitle", "time": 1016.389, "timestamp": "00:16:56", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 1018.71, "timestamp": "00:16:58", "text": "ええ、そうですね。 遅れてごめんなさい。 コメント。"}]
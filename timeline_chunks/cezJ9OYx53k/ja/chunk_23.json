[{"type": "subtitle", "time": 1398.149, "timestamp": "00:23:18", "text": "最近の休暇時間はどれくらいですか？"}, {"type": "subtitle", "time": 1399.909, "timestamp": "00:23:19", "text": "時間は十分ありますよ。"}, {"type": "subtitle", "time": 1403.51, "timestamp": "00:23:23", "text": "最近の私の休みの時間は、"}, {"type": "subtitle", "time": 1407.43, "timestamp": "00:23:27", "text": "放課後の午後5時頃です。"}, {"type": "subtitle", "time": 1409.99, "timestamp": "00:23:29", "text": "5時30分。"}, {"type": "subtitle", "time": 1412.31, "timestamp": "00:23:32", "text": "それから、オンライン授業や"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "その他の用事がある日もあります。"}, {"type": "subtitle", "time": 1418.87, "timestamp": "00:23:38", "text": "うん。 ほとんど眠れない。   調子は"}, {"type": "subtitle", "time": 1421.43, "timestamp": "00:23:41", "text": "どうだい"}, {"type": "subtitle", "time": 1424.47, "timestamp": "00:23:44", "text": "？ 彼女はとても綺麗だ。"}, {"type": "subtitle", "time": 1427.11, "timestamp": "00:23:47", "text": "これはまた、音楽における"}, {"type": "subtitle", "time": 1429.029, "timestamp": "00:23:49", "text": "周波数"}, {"type": "subtitle", "time": 1432.149, "timestamp": "00:23:52", "text": "特徴ライブラリの大規模な拡張も意味します。 検証段階であるうちに、それを展開する必要があった"}, {"type": "subtitle", "time": 1434.87, "timestamp": "00:23:54", "text": "。"}, {"type": "subtitle", "time": 1437.27, "timestamp": "00:23:57", "text": "データ量が膨大で、もっと"}]
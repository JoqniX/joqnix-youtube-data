[{"type": "subtitle", "time": 10987.03, "timestamp": "03:03:07", "text": "ああ、そうですね、"}, {"type": "subtitle", "time": 10989.51, "timestamp": "03:03:09", "text": "151,000くらいでしょうか"}, {"type": "subtitle", "time": 10991.269, "timestamp": "03:03:11", "text": "。"}, {"type": "subtitle", "time": 10995.91, "timestamp": "03:03:15", "text": "今は5060搭載のノートパソコンです。 しかし、唯一の"}, {"type": "subtitle", "time": 11000.95, "timestamp": "03:03:20", "text": "制限はRAMです。  RAMは"}, {"type": "subtitle", "time": 11006.23, "timestamp": "03:03:26", "text": "16GBです。  32GBのものが欲しかったのですが、"}, {"type": "subtitle", "time": 11011.03, "timestamp": "03:03:31", "text": "後で買おうと思いました。"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "例えば、アップグレードが必要になった場合、それも可能です"}, {"type": "subtitle", "time": 11016.23, "timestamp": "03:03:36", "text": "。 私はあの"}, {"type": "subtitle", "time": 11021.75, "timestamp": "03:03:41", "text": "2TVストレージ、つまりNVMe SSDというものが本当に欲しかったんです。"}, {"type": "subtitle", "time": 11024.309, "timestamp": "03:03:44", "text": "それで、"}, {"type": "subtitle", "time": 11027.269, "timestamp": "03:03:47", "text": "151万ルピーのモデルを選んだんだけど、ノート"}, {"type": "subtitle", "time": 11031.429, "timestamp": "03:03:51", "text": "パソコン本体が15万"}, {"type": "subtitle", "time": 11033.83, "timestamp": "03:03:53", "text": "ルピーくらいで、"}, {"type": "subtitle", "time": 11038.07, "timestamp": "03:03:58", "text": "5万ルピーか1万5千ルピーくらいだと思うんだけど、好きなものを追加して"}]
[{"type": "subtitle", "time": 1560.23, "timestamp": "00:26:00", "text": "えっと、あなたが食べ終わる頃には、"}, {"type": "subtitle", "time": 1564.149, "timestamp": "00:26:04", "text": "不死身の人たちは年を取りすぎていて、そうですよね"}, {"type": "subtitle", "time": 1566.31, "timestamp": "00:26:06", "text": "？ ちょっと用事を済ませに"}, {"type": "subtitle", "time": 1568.95, "timestamp": "00:26:08", "text": "、"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "楽しい時間を少しやり直そうと思って戻ってきたんだ。 声が止まることなく流れ込んでくる。まるで、絡み合った糸で"}, {"type": "subtitle", "time": 1574.39, "timestamp": "00:26:14", "text": "完全に膠着状態に陥っているようだ"}, {"type": "subtitle", "time": 1577.99, "timestamp": "00:26:17", "text": "。 膠着状態。 それは"}, {"type": "subtitle", "time": 1580.87, "timestamp": "00:26:20", "text": "陣形の中に閉じ込められている。 そんなものは、"}, {"type": "subtitle", "time": 1582.39, "timestamp": "00:26:22", "text": "この世界に存在すべきではない。"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "うん。 待って、私たちは何について話しているの？"}, {"type": "subtitle", "time": 1588.47, "timestamp": "00:26:28", "text": "もしかしたら、これも解決できるかもしれない。"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "実際、私はあなたに見せましたよ。"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "待って、これは本当にコラボのストーリーをやっているの？"}, {"type": "subtitle", "time": 1606.789, "timestamp": "00:26:46", "text": "事前クエスト"}, {"type": "subtitle", "time": 1614.71, "timestamp": "00:26:54", "text": "。 ああ、そうだね。   あれは"}]
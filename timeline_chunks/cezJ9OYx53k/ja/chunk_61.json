[{"type": "subtitle", "time": 3670.95, "timestamp": "01:01:10", "text": "私は運が悪い。"}, {"type": "subtitle", "time": 3672.95, "timestamp": "01:01:12", "text": "私はこれを4つ持っています。 だから、とりあえず"}, {"type": "subtitle", "time": 3684.39, "timestamp": "01:01:24", "text": "でも、"}, {"type": "subtitle", "time": 3688.309, "timestamp": "01:01:28", "text": "ストーリーを全部プレイすれば、たくさんの"}, {"type": "subtitle", "time": 3691.19, "timestamp": "01:01:31", "text": "リソースが手に入るからいいよね？"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "しかし、やはり問題は時間だ。"}, {"type": "subtitle", "time": 3701.67, "timestamp": "01:01:41", "text": "私には土曜日と、"}, {"type": "subtitle", "time": 3705.03, "timestamp": "01:01:45", "text": "長時間配信できる日しかありません。"}]
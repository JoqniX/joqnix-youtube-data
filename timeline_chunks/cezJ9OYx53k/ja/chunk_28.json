[{"type": "subtitle", "time": 1681.51, "timestamp": "00:28:01", "text": "では、"}, {"type": "subtitle", "time": 1684.71, "timestamp": "00:28:04", "text": "音声を日本語に変更します。   つまり、これもまた"}, {"type": "subtitle", "time": 1687.19, "timestamp": "00:28:07", "text": "語学"}, {"type": "subtitle", "time": 1720.31, "timestamp": "00:28:40", "text": "、待って。 メインクエストで輸送ドックに到達する"}, {"type": "subtitle", "time": 1722.87, "timestamp": "00:28:42", "text": "。 第3章、第一幕。"}, {"type": "subtitle", "time": 1724.87, "timestamp": "00:28:44", "text": "伝達力の下で燃えているもの。"}, {"type": "subtitle", "time": 1727.99, "timestamp": "00:28:47", "text": "まだ"}, {"type": "subtitle", "time": 1731.19, "timestamp": "00:28:51", "text": "第3章をアンロックしていないプレイヤーは、次の"}]
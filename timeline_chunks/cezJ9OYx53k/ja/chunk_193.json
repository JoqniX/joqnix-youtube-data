[{"type": "subtitle", "time": 11580.95, "timestamp": "03:13:00", "text": "配信活動はどうやって行えばいいですか？ どうすればいいですか"}, {"type": "subtitle", "time": 11585.03, "timestamp": "03:13:05", "text": "？ いいえ。わかりました"}, {"type": "subtitle", "time": 11586.63, "timestamp": "03:13:06", "text": "。"}, {"type": "subtitle", "time": 11590.07, "timestamp": "03:13:10", "text": "もし私が何も持たずにここに来て、"}, {"type": "subtitle", "time": 11593.91, "timestamp": "03:13:13", "text": "ここから貯金して、それから"}, {"type": "subtitle", "time": 11595.99, "timestamp": "03:13:15", "text": "ここから貯金したら、現実世界に集中する必要はありません"}, {"type": "subtitle", "time": 11599.99, "timestamp": "03:13:19", "text": "。 集中すればいい。 わかった。 しかし、"}, {"type": "subtitle", "time": 11603.51, "timestamp": "03:13:23", "text": "バックアッププランはどうでしょうか？ 現実世界に集中して、自分の義務などをすべて果たす場合のように使われます"}, {"type": "subtitle", "time": 11609.59, "timestamp": "03:13:29", "text": "。 私の趣味とかはどうなの"}, {"type": "subtitle", "time": 11611.11, "timestamp": "03:13:31", "text": "？"}, {"type": "subtitle", "time": 11613.03, "timestamp": "03:13:33", "text": "誰がそれをやるんだ？"}, {"type": "subtitle", "time": 11618.469, "timestamp": "03:13:38", "text": "インターネットカフェに行くのも、今では高くつくようになるだろう。"}, {"type": "subtitle", "time": 11620.309, "timestamp": "03:13:40", "text": "ここにゲームカフェがあるかどうかは分かりません。"}, {"type": "subtitle", "time": 11624.389, "timestamp": "03:13:44", "text": "費用がかさむだろう。 いいえ、私に何ができるでしょうか？ つまり、"}, {"type": "subtitle", "time": 11628.229, "timestamp": "03:13:48", "text": "電話はいいけど、電話もね。 私は今でも"}, {"type": "subtitle", "time": 11631.91, "timestamp": "03:13:51", "text": "古いインド製の携帯電話を使っています。もう"}, {"type": "subtitle", "time": 11634.469, "timestamp": "03:13:54", "text": "4年になります"}, {"type": "subtitle", "time": 11636.71, "timestamp": "03:13:56", "text": "。"}, {"type": "subtitle", "time": 11639.269, "timestamp": "03:13:59", "text": "うん。 そう、"}]
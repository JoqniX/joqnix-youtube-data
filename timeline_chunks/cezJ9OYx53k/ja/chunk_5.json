[{"type": "subtitle", "time": 300.95, "timestamp": "00:05:00", "text": "でも、"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "ルーシーとレベッカがゲームに出てるから、"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "すごいことだよね。 では、今日の"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "配信はSangさんから始めます。 えっと、"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "リングウェーブは長い間プレイしてないんです。"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "だから、"}, {"type": "subtitle", "time": 327.493, "timestamp": "00:05:27", "text": "コラボストーリーのイベントをプレイするためには、かなり長い時間スキップをしなければならないんです。 ということで、"}, {"type": "subtitle", "time": 329.99, "timestamp": "00:05:29", "text": "今日の配信は"}, {"type": "subtitle", "time": 332.31, "timestamp": "00:05:32", "text": "コラボの話だけです。 こんにちは。 コラボ"}, {"type": "subtitle", "time": 334.23, "timestamp": "00:05:34", "text": "ストーリーが終わったら、配信を終了します。"}, {"type": "subtitle", "time": 337.99, "timestamp": "00:05:37", "text": "来る。 こんにちは。 えっと、"}, {"type": "subtitle", "time": 340.79, "timestamp": "00:05:40", "text": "コラボストーリーがどれくらいの長さなのかよくわからないんです。 ええと、交換は"}, {"type": "subtitle", "time": 349.99, "timestamp": "00:05:49", "text": "（鼻を鳴らして）これでチャットがもっと"}, {"type": "subtitle", "time": 352.79, "timestamp": "00:05:52", "text": "よく見えるよ。 いくつか要素を追加したし、"}, {"type": "subtitle", "time": 357.624, "timestamp": "00:05:57", "text": "背景もかっこいいものになったよ。"}, {"type": "subtitle", "time": 358.93399999999997, "timestamp": "00:05:58", "text": "[鼻を鳴らす]"}]
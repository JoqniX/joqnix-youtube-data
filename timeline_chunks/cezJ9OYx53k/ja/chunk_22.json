[{"type": "subtitle", "time": 1321.669, "timestamp": "00:22:01", "text": "それを拡張した。"}, {"type": "subtitle", "time": 1323.75, "timestamp": "00:22:03", "text": "リヴァイアサンって誰だったっけ？"}, {"type": "subtitle", "time": 1325.35, "timestamp": "00:22:05", "text": "この強化（音楽）により、"}, {"type": "subtitle", "time": 1326.07, "timestamp": "00:22:06", "text": "検出が可能になります。"}, {"type": "subtitle", "time": 1328.23, "timestamp": "00:22:08", "text": "幸いなことに、これらの周波数のすべてが"}, {"type": "subtitle", "time": 1330.87, "timestamp": "00:22:10", "text": "リヴァイアサンに関連しているわけではない。"}, {"type": "subtitle", "time": 1332.63, "timestamp": "00:22:12", "text": "重要な任務に就いていないブルームベアラーが"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "調査のために派遣された。"}, {"type": "subtitle", "time": 1337.11, "timestamp": "00:22:17", "text": "海岸監視員は、計算の一部を、"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "私たちの誰もこの異常を特定できないことに費やしています。"}, {"type": "subtitle", "time": 1344.87, "timestamp": "00:22:24", "text": "ショアキーパーはエアロゼルの中にいる。"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "久しぶりにショートキーパーを見ることができた"}, {"type": "subtitle", "time": 1361.029, "timestamp": "00:22:41", "text": "私はこれらのキャッチャー"}, {"type": "subtitle", "time": 1363.99, "timestamp": "00:22:43", "text": "ゲームを熱心にプレイしていません。 だから私は何かを始め、それから"}]
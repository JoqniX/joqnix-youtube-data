[{"type": "subtitle", "time": 1446.71, "timestamp": "00:24:06", "text": "その混沌の中で、私は音楽の中に"}, {"type": "subtitle", "time": 1449.83, "timestamp": "00:24:09", "text": "断片的なメッセージを見出した。"}, {"type": "subtitle", "time": 1462.47, "timestamp": "00:24:22", "text": "我々は、絶えず"}, {"type": "subtitle", "time": 1466.07, "timestamp": "00:24:26", "text": "変化する一連の空間座標を分離した。"}, {"type": "subtitle", "time": 1468.63, "timestamp": "00:24:28", "text": "一つは未知の場所を指し示している。"}, {"type": "subtitle", "time": 1470.549, "timestamp": "00:24:30", "text": "そのメッセージを残したもう一人の人物は、"}, {"type": "subtitle", "time": 1472.87, "timestamp": "00:24:32", "text": "黒い海岸がどこにあるのかを正確に知っていた。   ああ"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "、まるで喋り出すかのようだ。 忘れた。"}, {"type": "subtitle", "time": 1478.71, "timestamp": "00:24:38", "text": "私を信用しなくても構わないが、"}, {"type": "subtitle", "time": 1481.029, "timestamp": "00:24:41", "text": "少なくとも私の船長は信用してほしい。"}, {"type": "subtitle", "time": 1483.51, "timestamp": "00:24:43", "text": "すでにお伝えしたとおりです。"}, {"type": "subtitle", "time": 1490.149, "timestamp": "00:24:50", "text": "。 レベッカですか？ 座標を送信します。"}, {"type": "subtitle", "time": 1492.39, "timestamp": "00:24:52", "text": "あなたがストレートであることを忘れていました。"}]
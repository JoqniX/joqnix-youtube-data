[{"type": "subtitle", "time": 1923.11, "timestamp": "00:32:03", "text": "ああ、神様。 そして、"}, {"type": "subtitle", "time": 1926.149, "timestamp": "00:32:06", "text": "医者に行くには、ファストトラックを通らなければなりません。"}, {"type": "subtitle", "time": 1928.389, "timestamp": "00:32:08", "text": "必ず書き直してください。つまり、"}, {"type": "subtitle", "time": 1936.31, "timestamp": "00:32:16", "text": "あなたが家にいないときに、最初に追跡すると、"}, {"type": "subtitle", "time": 1959.11, "timestamp": "00:32:39", "text": "表示されませんが、"}, {"type": "subtitle", "time": 1969.75, "timestamp": "00:32:49", "text": "待ってください、問題は、"}, {"type": "subtitle", "time": 1975.75, "timestamp": "00:32:55", "text": "そのクエストにスキップしてから、ああ、つまり、私たちがしなければならないことは何ですか、何ですか、"}]
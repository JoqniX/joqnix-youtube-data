[{"type": "subtitle", "time": 1984.149, "timestamp": "00:33:04", "text": "オーケー。"}, {"type": "subtitle", "time": 1990.557, "timestamp": "00:33:10", "text": "私たちはクエスト全体をやり遂げなければならない。"}, {"type": "subtitle", "time": 1991.11, "timestamp": "00:33:11", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 1999.99, "timestamp": "00:33:19", "text": "それからナイトシティをやります。"}, {"type": "subtitle", "time": 2003.83, "timestamp": "00:33:23", "text": "それなら、2部構成のシリーズにしようかな。   わかった"}, {"type": "subtitle", "time": 2018.95, "timestamp": "00:33:38", "text": "[咳払い] ちょっとスキップしてもいいですよ"}, {"type": "subtitle", "time": 2021.99, "timestamp": "00:33:41", "text": "。 えっと、"}]
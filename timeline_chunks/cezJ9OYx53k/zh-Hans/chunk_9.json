[{"type": "subtitle", "time": 542.79, "timestamp": "00:09:02", "text": "我没有在游戏中领取我的"}, {"type": "subtitle", "time": 548.31, "timestamp": "00:09:08", "text": "生日蛋糕。在游戏中，"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "每当"}, {"type": "subtitle", "time": 552.07, "timestamp": "00:09:12", "text": "你过生日的时候，他们都会给你一个蛋糕、一顶"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "帽子或者其他特别的"}, {"type": "subtitle", "time": 559.11, "timestamp": "00:09:19", "text": "饰品之类的东西。"}, {"type": "subtitle", "time": 561.91, "timestamp": "00:09:21", "text": "哦，等等。 我的直播快要结束了。 啊，"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "Wi-Fi"}, {"type": "subtitle", "time": 574.71, "timestamp": "00:09:34", "text": "我刚刚才注意到这一点。 哦，不。"}, {"type": "subtitle", "time": 577.509, "timestamp": "00:09:37", "text": "什么？"}, {"type": "subtitle", "time": 584.31, "timestamp": "00:09:44", "text": "如果情况这样下去，我就什么都做不了了"}]
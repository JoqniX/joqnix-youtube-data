[{"type": "subtitle", "time": 1265.029, "timestamp": "00:21:05", "text": "黑人表演的。 好了，我们走吧。"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "他们现在更改了用户界面和其他所有内容"}, {"type": "subtitle", "time": 1278.789, "timestamp": "00:21:18", "text": "他们改动了很多用户界面和其他很多"}, {"type": "subtitle", "time": 1291.909, "timestamp": "00:21:31", "text": "呃，不用告诉我音频电平。"}, {"type": "subtitle", "time": 1303.029, "timestamp": "00:21:43", "text": "瓦伦蒂娜了。"}, {"type": "subtitle", "time": 1305.83, "timestamp": "00:21:45", "text": "A组开始数据预处理。"}, {"type": "subtitle", "time": 1307.99, "timestamp": "00:21:47", "text": "B组部署地面干扰"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "消除器。  [音乐]"}, {"type": "subtitle", "time": 1312.549, "timestamp": "00:21:52", "text": "哦，罗孚。 黑岸帮不久前找回了"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "索伦诺迪亚人的宝石。 我的"}, {"type": "subtitle", "time": 1317.83, "timestamp": "00:21:57", "text": "意思是，利维坦的本质。"}, {"type": "subtitle", "time": 1319.83, "timestamp": "00:21:59", "text": "Teis 系统对音乐进行了深入分析"}]
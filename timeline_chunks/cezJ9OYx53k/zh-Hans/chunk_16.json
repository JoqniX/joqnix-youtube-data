[{"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "呃，"}, {"type": "subtitle", "time": 968.31, "timestamp": "00:16:08", "text": "幽灵聊天。"}, {"type": "subtitle", "time": 970.87, "timestamp": "00:16:10", "text": "嘿。 呃。 哦，等等。 我得再做一遍"}, {"type": "subtitle", "time": 972.47, "timestamp": "00:16:12", "text": "。"}, {"type": "subtitle", "time": 975.59, "timestamp": "00:16:15", "text": "嘿，伙计。"}, {"type": "subtitle", "time": 977.829, "timestamp": "00:16:17", "text": "呃，稍等一下。 让我下载一下"}, {"type": "subtitle", "time": 979.749, "timestamp": "00:16:19", "text": "。"}, {"type": "subtitle", "time": 982.23, "timestamp": "00:16:22", "text": "所以，我"}, {"type": "subtitle", "time": 984.466, "timestamp": "00:16:24", "text": "现在可以在单显示器上阅读聊天记录了。 所以，"}, {"type": "subtitle", "time": 985.59, "timestamp": "00:16:25", "text": "（咳嗽并清了清嗓子）"}, {"type": "subtitle", "time": 993.67, "timestamp": "00:16:33", "text": "哦，"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "我应该这样做。"}, {"type": "subtitle", "time": 1000.31, "timestamp": "00:16:40", "text": "什么？ 我这就把这段复制下来，"}, {"type": "subtitle", "time": 1013.11, "timestamp": "00:16:53", "text": "什么？ 我没有抄袭你。 哦，什么？ 复制。"}, {"type": "subtitle", "time": 1016.389, "timestamp": "00:16:56", "text": "放在这里。"}, {"type": "subtitle", "time": 1018.71, "timestamp": "00:16:58", "text": "嗯，是的。 抱歉耽搁了。 评论。"}]
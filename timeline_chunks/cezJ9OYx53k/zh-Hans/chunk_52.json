[{"type": "subtitle", "time": 3128.15, "timestamp": "00:52:08", "text": "并将它们切开。   这是"}, {"type": "subtitle", "time": 3155.349, "timestamp": "00:52:35", "text": "你好，卡丽莎。 欢迎。 我明白这个笑话了。"}, {"type": "subtitle", "time": 3157.781, "timestamp": "00:52:37", "text": "我点击“酿造”。 规则不是我定的。"}, {"type": "subtitle", "time": 3158.549, "timestamp": "00:52:38", "text": "[笑声]"}, {"type": "subtitle", "time": 3162.47, "timestamp": "00:52:42", "text": "谢谢你们的到来，这对我意义重大。"}]
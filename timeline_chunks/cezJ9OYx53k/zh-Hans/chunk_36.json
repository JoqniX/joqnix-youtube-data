[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "她被这个黑洞裂缝吸进去了"}, {"type": "subtitle", "time": 2191.589, "timestamp": "00:36:31", "text": "如果你不经常玩游戏，不，"}, {"type": "subtitle", "time": 2193.51, "timestamp": "00:36:33", "text": "你会忘记剧情的。"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "我遇到的情况就是这样。 我忘了故事内容了。"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "雷诺西塔之后发生了什么？ 我们为什么会在"}, {"type": "subtitle", "time": 2201.43, "timestamp": "00:36:41", "text": "这里？"}]
[{"type": "subtitle", "time": 1620.39, "timestamp": "00:27:00", "text": "Wait吗？一座被淹没在水下的城市。"}, {"type": "subtitle", "time": 1622.07, "timestamp": "00:27:02", "text": "好吧，我觉得这"}, {"type": "subtitle", "time": 1623.269, "timestamp": "00:27:03", "text": "看起来就像"}, {"type": "subtitle", "time": 1626.149, "timestamp": "00:27:06", "text": "世界颠倒了一样。 河流逆流"}, {"type": "subtitle", "time": 1629.43, "timestamp": "00:27:09", "text": "而上。 太阳和月亮从"}, {"type": "subtitle", "time": 1634.23, "timestamp": "00:27:14", "text": "水槽里掉了出来。 玉佛垂下了目光。"}, {"type": "subtitle", "time": 1634.549, "timestamp": "00:27:14", "text": "但是，"}, {"type": "subtitle", "time": 1635.669, "timestamp": "00:27:15", "text": "哦，她戴"}, {"type": "subtitle", "time": 1639.19, "timestamp": "00:27:19", "text": "眼镜不太好。"}, {"type": "subtitle", "time": 1642.31, "timestamp": "00:27:22", "text": "那是"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "夜之城。"}, {"type": "subtitle", "time": 1645.909, "timestamp": "00:27:25", "text": "我的床在召唤我。 我得去睡觉了。"}, {"type": "subtitle", "time": 1649.51, "timestamp": "00:27:29", "text": "你好。 你整晚都没睡，橙子。"}, {"type": "subtitle", "time": 1651.51, "timestamp": "00:27:31", "text": "哇。   是的"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "。 是的。 去睡一会儿吧。 一切都好"}, {"type": "subtitle", "time": 1655.59, "timestamp": "00:27:35", "text": "。 一切都好。"}, {"type": "subtitle", "time": 1667.19, "timestamp": "00:27:47", "text": "让我换个语言来"}, {"type": "subtitle", "time": 1669.83, "timestamp": "00:27:49", "text": "欣赏一下。 享受你的街道和玩耍时光。"}, {"type": "subtitle", "time": 1672.63, "timestamp": "00:27:52", "text": "你好。"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "街道。"}, {"type": "subtitle", "time": 1678.23, "timestamp": "00:27:58", "text": "你好。"}]
[{"type": "subtitle", "time": 17950.948, "timestamp": "04:59:10", "text": "我是一台HP。 搞什么鬼？"}, {"type": "subtitle", "time": 17953.59, "timestamp": "04:59:13", "text": "我有一台惠普电脑。"}, {"type": "subtitle", "time": 17956.628, "timestamp": "04:59:16", "text": "等等，（喘气）我只剩1点HP了。"}, {"type": "subtitle", "time": 17959.91, "timestamp": "04:59:19", "text": "等等，什么？ 那不是横纲吗？"}, {"type": "subtitle", "time": 17963.51, "timestamp": "04:59:23", "text": "另外，"}, {"type": "subtitle", "time": 17976.868, "timestamp": "04:59:36", "text": "呃，完成主线任务。 呃，你看，在"}, {"type": "subtitle", "time": 17979.11, "timestamp": "04:59:39", "text": "逐渐消融的夜空下寻找最佳"}, {"type": "subtitle", "time": 17980.788, "timestamp": "04:59:40", "text": "体验吧。"}]
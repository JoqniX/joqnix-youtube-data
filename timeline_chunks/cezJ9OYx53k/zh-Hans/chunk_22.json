[{"type": "subtitle", "time": 1321.669, "timestamp": "00:22:01", "text": "并加以扩展。"}, {"type": "subtitle", "time": 1323.75, "timestamp": "00:22:03", "text": "利维坦是谁来着？"}, {"type": "subtitle", "time": 1325.35, "timestamp": "00:22:05", "text": "这种增强功能（音乐）使我们能够进行"}, {"type": "subtitle", "time": 1326.07, "timestamp": "00:22:06", "text": "检测。"}, {"type": "subtitle", "time": 1328.23, "timestamp": "00:22:08", "text": "幸运的是，并非所有这些频率都与"}, {"type": "subtitle", "time": 1330.87, "timestamp": "00:22:10", "text": "利维坦有关。 未被"}, {"type": "subtitle", "time": 1332.63, "timestamp": "00:22:12", "text": "分配到关键任务的花童已被"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "派往调查。"}, {"type": "subtitle", "time": 1337.11, "timestamp": "00:22:17", "text": "海岸守护者还将部分"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "计算用于"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "我们当中没有人能够识别这种异常情况。"}, {"type": "subtitle", "time": 1344.87, "timestamp": "00:22:24", "text": "海岸守护者在气溶胶中。"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "时隔这么久终于见到短跑运动员了"}, {"type": "subtitle", "time": 1361.029, "timestamp": "00:22:41", "text": "我并没有刻意练习捕手"}, {"type": "subtitle", "time": 1363.99, "timestamp": "00:22:43", "text": "角色。 于是我开始做点什么，然后"}]
[{"type": "subtitle", "time": 6249.669, "timestamp": "01:44:09", "text": "我只记得"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "我遇到了飞行员们，然后我们一起参加了"}, {"type": "subtitle", "time": 6255.99, "timestamp": "01:44:15", "text": "音乐会，跳了舞。 不，我们本来应该"}, {"type": "subtitle", "time": 6259.109, "timestamp": "01:44:19", "text": "和那个"}, {"type": "subtitle", "time": 6270.95, "timestamp": "01:44:30", "text": "我仍然相信这一点。 我不知道"}, {"type": "subtitle", "time": 6273.83, "timestamp": "01:44:33", "text": "接下来发生了什么。"}, {"type": "subtitle", "time": 6288.709, "timestamp": "01:44:48", "text": "它们就像你可能"}]
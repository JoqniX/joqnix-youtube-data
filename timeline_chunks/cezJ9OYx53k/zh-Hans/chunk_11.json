[{"type": "subtitle", "time": 661.03, "timestamp": "00:11:01", "text": "今年8月生日的时候还可以再获得一个角色。"}, {"type": "subtitle", "time": 664.167, "timestamp": "00:11:04", "text": "想象一下，你可以免费创建两个角色。"}, {"type": "subtitle", "time": 664.79, "timestamp": "00:11:04", "text": "[叹气和喘息]"}, {"type": "subtitle", "time": 667.67, "timestamp": "00:11:07", "text": "哦，是的。 但我对这个故事了解得还很落后"}, {"type": "subtitle", "time": 670.63, "timestamp": "00:11:10", "text": "。 要做的事情太多了。 但是，"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "我们会尽力做好……嗯……"}, {"type": "subtitle", "time": 677.67, "timestamp": "00:11:17", "text": "玩网络俱乐部那"}, {"type": "subtitle", "time": 679.887, "timestamp": "00:11:19", "text": "件事。 我"}, {"type": "subtitle", "time": 681.269, "timestamp": "00:11:21", "text": "（嗤笑）"}, {"type": "subtitle", "time": 684.23, "timestamp": "00:11:24", "text": "现在唯一让我担心的事情"}, {"type": "subtitle", "time": 691.11, "timestamp": "00:11:31", "text": "就是我的网络。 我不知道为什么我"}, {"type": "subtitle", "time": 697.572, "timestamp": "00:11:37", "text": "有那么糟糕吗？"}, {"type": "subtitle", "time": 698.31, "timestamp": "00:11:38", "text": "[嗤笑]"}]
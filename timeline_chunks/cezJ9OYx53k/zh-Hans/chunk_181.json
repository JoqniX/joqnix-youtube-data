[{"type": "subtitle", "time": 10865.349, "timestamp": "03:01:05", "text": "然后我就说，“是啊，我买了一台"}, {"type": "subtitle", "time": 10867.67, "timestamp": "03:01:07", "text": "日本电脑。”"}, {"type": "subtitle", "time": 10869.59, "timestamp": "03:01:09", "text": "呃，"}, {"type": "subtitle", "time": 10872.15, "timestamp": "03:01:12", "text": "对了"}, {"type": "subtitle", "time": 10875.75, "timestamp": "03:01:15", "text": "，你是不是忘了？"}, {"type": "subtitle", "time": 10891.429, "timestamp": "03:01:31", "text": "让我看看指南之类的东西。"}, {"type": "subtitle", "time": 10894.55, "timestamp": "03:01:34", "text": "呃，你做了一件无法解释的事。 是的，我"}, {"type": "subtitle", "time": 10896.07, "timestamp": "03:01:36", "text": "觉得"}]
[{"type": "subtitle", "time": 11821.429, "timestamp": "03:17:01", "text": "好的。 肖克守门员正在发出某种"}, {"type": "subtitle", "time": 11828.229, "timestamp": "03:17:08", "text": "但那是你的照片。 那是个人隐私。 我"}, {"type": "subtitle", "time": 11844.95, "timestamp": "03:17:24", "text": "给我。 我不需要。 他做"}, {"type": "subtitle", "time": 11847.99, "timestamp": "03:17:27", "text": "商业方面的工作。 那是欺负他。 我可以"}, {"type": "subtitle", "time": 11860.95, "timestamp": "03:17:40", "text": "太空集体。 这是什么？"}, {"type": "subtitle", "time": 11863.59, "timestamp": "03:17:43", "text": "由"}, {"type": "subtitle", "time": 11866.309, "timestamp": "03:17:46", "text": "不同国家和组织开展的国际科学研究"}]
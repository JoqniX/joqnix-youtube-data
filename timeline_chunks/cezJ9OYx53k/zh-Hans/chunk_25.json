[{"type": "subtitle", "time": 1521.51, "timestamp": "00:25:21", "text": "这很糟糕。 情况非常糟糕。"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "看看我的"}, {"type": "subtitle", "time": 1523.83, "timestamp": "00:25:23", "text": "酿酒小姐。 我们理解您的"}, {"type": "subtitle", "time": 1524.63, "timestamp": "00:25:24", "text": "担忧，"}, {"type": "subtitle", "time": 1526.87, "timestamp": "00:25:26", "text": "但 Teis 系统拥有完整的……"}, {"type": "subtitle", "time": 1530.31, "timestamp": "00:25:30", "text": "您更信任那些电线而不是我。 昨晚我梦见"}, {"type": "subtitle", "time": 1534.47, "timestamp": "00:25:34", "text": "窗外有三栋倒扣的房子。 那可不是什么"}, {"type": "subtitle", "time": 1537.83, "timestamp": "00:25:37", "text": "好兆头。 我感到精力充沛。"}, {"type": "subtitle", "time": 1541.35, "timestamp": "00:25:41", "text": "哦，她糟透了。 有生命的东西是……"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "并不是我们不信任你，"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "布林小姐。 就是你上次"}, {"type": "subtitle", "time": 1549.75, "timestamp": "00:25:49", "text": "梦见黑猫跳舞的那次。  Teis 完成全面诊断后，我们将"}, {"type": "subtitle", "time": 1551.669, "timestamp": "00:25:51", "text": "开始平行[音乐]观测"}, {"type": "subtitle", "time": 1556.07, "timestamp": "00:25:56", "text": "。 这是为了大家在"}, {"type": "subtitle", "time": 1557.11, "timestamp": "00:25:57", "text": "黑暗中的安全。"}]
[{"type": "subtitle", "time": 11428.469, "timestamp": "03:10:28", "text": "顺便说一下，我需要继续"}, {"type": "subtitle", "time": 11430.07, "timestamp": "03:10:30", "text": "购买。 我的意思是，我花了3000块买了个鼠标来"}, {"type": "subtitle", "time": 11433.19, "timestamp": "03:10:33", "text": "弥补这件事。 哦，是的。 老鼠"}, {"type": "subtitle", "time": 11436.55, "timestamp": "03:10:36", "text": "自由了。 我有一款罗技G304鼠标。 它是"}, {"type": "subtitle", "time": 11439.696, "timestamp": "03:10:39", "text": "免费的。 这就是我想要这台"}, {"type": "subtitle", "time": 11440.23, "timestamp": "03:10:40", "text": "（音乐）"}, {"type": "subtitle", "time": 11446.79, "timestamp": "03:10:46", "text": "他们收到了一份报价。 所以这就是我急着"}, {"type": "subtitle", "time": 11452.95, "timestamp": "03:10:52", "text": "去拿它的原因。 我不知怎么就遇到了她，"}, {"type": "subtitle", "time": 11454.87, "timestamp": "03:10:54", "text": "因为"}, {"type": "subtitle", "time": 11457.11, "timestamp": "03:10:57", "text": "我当时在日本还没有银行账户，也没有信用卡或借记卡，所以"}]
[{"type": "subtitle", "time": 12063.91, "timestamp": "03:21:03", "text": "啊，是的，我做了。"}, {"type": "subtitle", "time": 12095.75, "timestamp": "03:21:35", "text": "我并非出身富裕家庭"}, {"type": "subtitle", "time": 12102.87, "timestamp": "03:21:42", "text": "我来这里是为了追逐我的梦想，我一定会"}, {"type": "subtitle", "time": 12106.229, "timestamp": "03:21:46", "text": "实现它。"}, {"type": "subtitle", "time": 12108.229, "timestamp": "03:21:48", "text": "我活着。"}, {"type": "subtitle", "time": 12111.269, "timestamp": "03:21:51", "text": "所以，我家人做什么都无关紧要"}, {"type": "subtitle", "time": 12112.71, "timestamp": "03:21:52", "text": "。"}]
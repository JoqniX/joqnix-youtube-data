[{"type": "subtitle", "time": 1140.95, "timestamp": "00:19:00", "text": "做饭，因为我其实还不会"}, {"type": "subtitle", "time": 1143.51, "timestamp": "00:19:03", "text": "做饭。 呃，我的室友正在"}, {"type": "subtitle", "time": 1147.11, "timestamp": "00:19:07", "text": "做饭。 我今年必须学习一些东西，我的"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "目标是学习烹饪之类的技能，"}, {"type": "subtitle", "time": 1152.31, "timestamp": "00:19:12", "text": "这样在"}, {"type": "subtitle", "time": 1155.11, "timestamp": "00:19:15", "text": "我毕业两年后，课程结束后我才能自食其力"}, {"type": "subtitle", "time": 1157.35, "timestamp": "00:19:17", "text": "。 现在我也要"}, {"type": "subtitle", "time": 1159.19, "timestamp": "00:19:19", "text": "生存下去，所以无论如何我都必须学会做饭"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "好的，我可以连接聊天窗口了。 仅仅做到"}, {"type": "subtitle", "time": 1174.63, "timestamp": "00:19:34", "text": "我的工会等级是75级。我忘了。"}, {"type": "subtitle", "time": 1177.19, "timestamp": "00:19:37", "text": "我已经很久没玩"}, {"type": "subtitle", "time": 1180.39, "timestamp": "00:19:40", "text": "这个游戏了。"}, {"type": "subtitle", "time": 1184.15, "timestamp": "00:19:44", "text": "我唯一记得的就是我到达了"}, {"type": "subtitle", "time": 1187.35, "timestamp": "00:19:47", "text": "雷尼塔。"}, {"type": "subtitle", "time": 1189.99, "timestamp": "00:19:49", "text": "我"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "和raita在这里做任务。 故事"}, {"type": "subtitle", "time": 1195.83, "timestamp": "00:19:55", "text": "之类的。"}, {"type": "subtitle", "time": 1197.669, "timestamp": "00:19:57", "text": "嗯，是的"}]
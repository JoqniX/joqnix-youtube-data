[{"type": "subtitle", "time": 1446.71, "timestamp": "00:24:06", "text": "混乱之中，我发现[音乐]传递着一种"}, {"type": "subtitle", "time": 1449.83, "timestamp": "00:24:09", "text": "支离破碎的信息。"}, {"type": "subtitle", "time": 1462.47, "timestamp": "00:24:22", "text": "我们已经分离出一组不断"}, {"type": "subtitle", "time": 1466.07, "timestamp": "00:24:26", "text": "变化的空间坐标。"}, {"type": "subtitle", "time": 1468.63, "timestamp": "00:24:28", "text": "一个指向未知地点。"}, {"type": "subtitle", "time": 1470.549, "timestamp": "00:24:30", "text": "留下那条信息的另一个人非常清楚"}, {"type": "subtitle", "time": 1472.87, "timestamp": "00:24:32", "text": "黑色海岸在哪里。"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "哦，它几乎会说话了。 我忘了。"}, {"type": "subtitle", "time": 1478.71, "timestamp": "00:24:38", "text": "如果你不信任我，没关系，但"}, {"type": "subtitle", "time": 1481.029, "timestamp": "00:24:41", "text": "至少信任我的船长。"}, {"type": "subtitle", "time": 1483.51, "timestamp": "00:24:43", "text": "我们已经告诉过你了。"}, {"type": "subtitle", "time": 1490.149, "timestamp": "00:24:50", "text": "好的。 是丽贝卡吗？ 我会把坐标发给你，"}, {"type": "subtitle", "time": 1492.39, "timestamp": "00:24:52", "text": "我忘了你是直男，"}, {"type": "subtitle", "time": 1494.71, "timestamp": "00:24:54", "text": "必须留在这里继续隔离"}, {"type": "subtitle", "time": 1496.71, "timestamp": "00:24:56", "text": "和追踪周围嵌入的信息，"}]
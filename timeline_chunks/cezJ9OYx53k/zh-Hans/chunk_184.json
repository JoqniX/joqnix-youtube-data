[{"type": "subtitle", "time": 11040.71, "timestamp": "03:04:00", "text": "你可以添加各种配件，进行个性化定制，"}, {"type": "subtitle", "time": 11043.269, "timestamp": "03:04:03", "text": "比如你"}, {"type": "subtitle", "time": 11046.469, "timestamp": "03:04:06", "text": "需要64GB内存、32GB内存、"}, {"type": "subtitle", "time": 11048.389, "timestamp": "03:04:08", "text": "散热器、网线、"}, {"type": "subtitle", "time": 11050.79, "timestamp": "03:04:10", "text": "耳机、扬声器、显示器、"}, {"type": "subtitle", "time": 11054.55, "timestamp": "03:04:14", "text": "键盘等等，任何你想要的东西都可以定制，"}, {"type": "subtitle", "time": 11057.83, "timestamp": "03:04:17", "text": "比如附加配件。 所以我买了一块 2TV"}, {"type": "subtitle", "time": 11062.55, "timestamp": "03:04:22", "text": "SSD NVME SSD，"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "然后我又从印度把一块 NVME SSD 带回了"}, {"type": "subtitle", "time": 11070.71, "timestamp": "03:04:30", "text": "家里的电脑用。 这就是第三代产品。"}, {"type": "subtitle", "time": 11072.95, "timestamp": "03:04:32", "text": "它向下兼容。 所以我"}, {"type": "subtitle", "time": 11076.63, "timestamp": "03:04:36", "text": "有两个固态硬盘，内置固态硬盘，"}, {"type": "subtitle", "time": 11080.23, "timestamp": "03:04:40", "text": "NVME 固态硬盘，然后我又带来了"}, {"type": "subtitle", "time": 11083.67, "timestamp": "03:04:43", "text": "另外三个固态硬盘，"}, {"type": "subtitle", "time": 11086.389, "timestamp": "03:04:46", "text": "一个装在电视上，另一个装在 500 块硬盘上。 所以我总共"}, {"type": "subtitle", "time": 11090.87, "timestamp": "03:04:50", "text": "有六个固态硬盘，或者五个固态硬盘。"}, {"type": "subtitle", "time": 11093.429, "timestamp": "03:04:53", "text": "没有硬盘。 一、二、三、"}, {"type": "subtitle", "time": 11096.71, "timestamp": "03:04:56", "text": "四、五。 一、二、三、四。 对，"}, {"type": "subtitle", "time": 11099.03, "timestamp": "03:04:59", "text": "四个。 正确的。"}]
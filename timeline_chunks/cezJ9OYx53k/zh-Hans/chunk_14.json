[{"type": "subtitle", "time": 841.59, "timestamp": "00:14:01", "text": "有人在监视某人。 我现场看过你的表演"}, {"type": "subtitle", "time": 844.55, "timestamp": "00:14:04", "text": "。 你好，阿拉托。 等等，"}, {"type": "subtitle", "time": 849.03, "timestamp": "00:14:09", "text": "印度现在几点？ 现在是早上7点。是的"}, {"type": "subtitle", "time": 851.829, "timestamp": "00:14:11", "text": "。 这个时候大家都应该已经睡觉了"}, {"type": "subtitle", "time": 858.47, "timestamp": "00:14:18", "text": "但现在才上午 10 点，"}, {"type": "subtitle", "time": 861.03, "timestamp": "00:14:21", "text": "对我来说 10 点就变成 11 点了。"}, {"type": "subtitle", "time": 865.91, "timestamp": "00:14:25", "text": "感谢关注。 星光黯淡。"}, {"type": "subtitle", "time": 872.71, "timestamp": "00:14:32", "text": "我的网络很差。 是啊，情况很糟糕。"}, {"type": "subtitle", "time": 877.99, "timestamp": "00:14:37", "text": "请告诉我"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "视频流的延迟情况，因为我的比特率很差。 所以，"}, {"type": "subtitle", "time": 890.79, "timestamp": "00:14:50", "text": "我用的是以太网，不是Wi-Fi。 那情况就"}]
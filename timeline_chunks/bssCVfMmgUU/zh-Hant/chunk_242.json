[{"type": "subtitle", "time": 14525.51, "timestamp": "04:02:05", "text": "12點。"}, {"type": "subtitle", "time": 14529.11, "timestamp": "04:02:09", "text": "哪個？ 12. 不，不，不，不是12。哦，是"}, {"type": "subtitle", "time": 14532.229, "timestamp": "04:02:12", "text": "10。我10點開始直播的。抱歉。我"}, {"type": "subtitle", "time": 14534.71, "timestamp": "04:02:14", "text": "必須開始第二次直播，不，"}, {"type": "subtitle", "time": 14537.349, "timestamp": "04:02:17", "text": "我有 15 個小時的時間來做"}, {"type": "subtitle", "time": 14539.67, "timestamp": "04:02:19", "text": "第二次直播，對吧。"}, {"type": "subtitle", "time": 14543.189, "timestamp": "04:02:23", "text": "但是，第二部分直播我必須爭取完美地持續12個小時嗎"}, {"type": "subtitle", "time": 14546.389, "timestamp": "04:02:26", "text": "？只不過是V而已"}, {"type": "subtitle", "time": 14550.229, "timestamp": "04:02:30", "text": "。我現在這樣想有什麼意義呢？"}, {"type": "subtitle", "time": 14554.55, "timestamp": "04:02:34", "text": "放W有什麼意義？為什麼我不能直接結束"}, {"type": "subtitle", "time": 14558.87, "timestamp": "04:02:38", "text": "直播？我當時就想，「兄弟，這話是"}, {"type": "subtitle", "time": 14569.75, "timestamp": "04:02:49", "text": "好的。嗯，我覺得從七月開始，我"}, {"type": "subtitle", "time": 14576.309, "timestamp": "04:02:56", "text": "因為"}, {"type": "subtitle", "time": 14579.59, "timestamp": "04:02:59", "text": "在這九個月裡，天知道會"}]
[{"type": "subtitle", "time": 741.35, "timestamp": "00:12:21", "text": "所以，我希望這是為了我們。我一直很"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "好奇。  你的另一個怎麼樣了？為什麼變成了橘色？  發生了什麼事？你轉世了嗎？  女巫。呃，所以那東西是"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "女巫。我覺得她很友善。她詛咒了我。  而我現在變成了一個橘子"}, {"type": "subtitle", "time": 757.59, "timestamp": "00:12:37", "text": "。"}, {"type": "subtitle", "time": 760.31, "timestamp": "00:12:40", "text": "哦，不。我不知道該"}, {"type": "subtitle", "time": 762.71, "timestamp": "00:12:42", "text": "如何變回"}, {"type": "subtitle", "time": 765.11, "timestamp": "00:12:45", "text": "外星人。  這個橘子好可愛。實話實說。  我在"}]
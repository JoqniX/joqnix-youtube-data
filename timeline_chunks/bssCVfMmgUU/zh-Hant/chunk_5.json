[{"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "所以，"}, {"type": "subtitle", "time": 312.79, "timestamp": "00:05:12", "text": "我"}, {"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "想我得把它綁在我的上臂上。因為如果我把它戴在手腕上，就像我們以前散步時"}, {"type": "subtitle", "time": 338.95, "timestamp": "00:05:38", "text": "戴手錶一樣。問題在於我慢跑的時候，它會像B一樣突然發作，而且抖得厲害。但目前唯一的問題是我將無法閱讀聊天記錄。我該如何進行聊天呢？  這就是我的"}, {"type": "subtitle", "time": 353.749, "timestamp": "00:05:53", "text": "問題，我該怎麼辦？"}, {"type": "subtitle", "time": 356.95, "timestamp": "00:05:56", "text": "我該怎麼辦？就像我隨身帶著另一支手機一樣，因為你知道，這就像跑步時用的東西"}]
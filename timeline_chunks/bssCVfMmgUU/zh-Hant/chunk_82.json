[{"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "向右跳。我向右跳。哦"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "，我還有一秒鐘。音量有點大。讓"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "我……遊戲音量。遊戲音量。是的。你知道怎麼控制"}, {"type": "subtitle", "time": 4964.47, "timestamp": "01:22:44", "text": "遊戲音量嗎？應該有個音量設定。把它調到1就行了。我就是這樣"}, {"type": "subtitle", "time": 4972.79, "timestamp": "01:22:52", "text": "玩的。哦，原來如此。好的。好的。不，沒事了。現在沒事了。好的。我們走吧。所以，有很多種方法。"}]
[{"type": "subtitle", "time": 6263.03, "timestamp": "01:44:23", "text": "哦，我死了。沒關係。沒關係。我得到了它。  我們"}, {"type": "subtitle", "time": 6267.27, "timestamp": "01:44:27", "text": "走吧。  我的天啊。"}, {"type": "subtitle", "time": 6273.59, "timestamp": "01:44:33", "text": "我們是怎麼做到的？我們"}, {"type": "subtitle", "time": 6276.87, "timestamp": "01:44:36", "text": "結束吧。  我剛才輕輕敲了一下W。"}, {"type": "subtitle", "time": 6282.709, "timestamp": "01:44:42", "text": "好的，等一下。  您好，有了十字架我們很安全。他們過河了嗎？  我想知道。"}, {"type": "subtitle", "time": 6295.51, "timestamp": "01:44:55", "text": "我看到他們就這樣倒下了。  看。  好的。  如何過河？過河的最佳方法是"}]
[{"type": "subtitle", "time": 5850.0, "timestamp": "01:37:30", "text": "怎麼做，因為他們兩個同時跳。等等。 R2。 R2。 R2。聊天。好的。能給我們示範一下嗎？哦，他們要開始了。你……"}, {"type": "subtitle", "time": 5855.99, "timestamp": "01:37:35", "text": "為什麼不跳，兄弟？呃，鮑比，不。不。"}, {"type": "subtitle", "time": 5858.149, "timestamp": "01:37:38", "text": "為什麼？為什麼他們用她的名字？我不知道。"}, {"type": "subtitle", "time": 5861.83, "timestamp": "01:37:41", "text": "這……這"}, {"type": "subtitle", "time": 5863.75, "timestamp": "01:37:43", "text": "太緊張了。看看我……我把boss打壞了……"}]
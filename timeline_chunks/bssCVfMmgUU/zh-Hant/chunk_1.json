[{"type": "subtitle", "time": 70.71000000000001, "timestamp": "00:01:10", "text": "想保持身體健康，因為我免疫力低下，很容易生病。呃，所以我想讓我的身體保持健康。是的。"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "嗯，回到今天的錄音工作，我"}, {"type": "subtitle", "time": 83.27, "timestamp": "00:01:23", "text": "做到了。好的。所以，跑步這件事是"}, {"type": "subtitle", "time": 87.03, "timestamp": "00:01:27", "text": "好事。嗯，你可以清楚地聽到"}, {"type": "subtitle", "time": 90.31, "timestamp": "00:01:30", "text": "我的聲音，你可以聽到我跺腳的"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "聲音，那種小小的「嗯嗯」的"}, {"type": "subtitle", "time": 100.71000000000001, "timestamp": "00:01:40", "text": "腳步聲。  但問題是，"}, {"type": "subtitle", "time": 112.789, "timestamp": "00:01:52", "text": "當我騎著踏板車時，車輛噪音、方向燈噪音、喇叭噪音，"}]
[{"type": "subtitle", "time": 961.509, "timestamp": "00:16:01", "text": "不干了。」瓦倫特的情況也是一樣。我當時在玩 Valent。我當時正處於一連串的失利之中。"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "我當時就想，「不，我需要安靜。我可不想把假期浪費在連敗上，我"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "現在正沉浸在"}, {"type": "subtitle", "time": 990.23, "timestamp": "00:16:30", "text": "閱讀中呢。"}, {"type": "subtitle", "time": 993.59, "timestamp": "00:16:33", "text": "我一直在看"}, {"type": "subtitle", "time": 997.269, "timestamp": "00:16:37", "text": "漫畫和網絡漫畫。哦，哪些？網絡漫畫。哪個？好的。我最近剛"}, {"type": "subtitle", "time": 1005.11, "timestamp": "00:16:45", "text": "看完《特魯爾作戰》。"}, {"type": "subtitle", "time": 1008.629, "timestamp": "00:16:48", "text": "可惜作者現在處於刊狀態。對。 啊，所以是漫畫。麼的。有很多類似的。"}, {"type": "subtitle", "time": 1012.79, "timestamp": "00:16:52", "text": "我"}, {"type": "subtitle", "time": 1015.11, "timestamp": "00:16:55", "text": "想"}, {"type": "subtitle", "time": 1018.15, "timestamp": "00:16:58", "text": "我"}]
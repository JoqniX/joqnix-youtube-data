[{"type": "subtitle", "time": 4740.55, "timestamp": "01:19:00", "text": "起來了嗎？好。好。我要"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "跳了。好。好。不錯。跳。跳。跳。"}, {"type": "subtitle", "time": 4772.39, "timestamp": "01:19:32", "text": "哦，不。不。不。啊。就差一點。就差一點。就差一點。就差一點。我的天哪。不。沒事的。沒事的。來。來。走。走。走。走。走。走。走。走。走。走。"}, {"type": "subtitle", "time": 4781.75, "timestamp": "01:19:41", "text": "我們能讓他加速嗎？我的"}]
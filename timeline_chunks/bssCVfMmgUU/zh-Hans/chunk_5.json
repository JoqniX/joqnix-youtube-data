[{"type": "subtitle", "time": 300.87, "timestamp": "00:05:00", "text": "这就是我的问题，我当时就想，该怎么办？"}, {"type": "subtitle", "time": 304.39, "timestamp": "00:05:04", "text": "我愿意？我该怎么办？我有点喜欢"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "我带了另一部手机，因为……"}, {"type": "subtitle", "time": 310.469, "timestamp": "00:05:10", "text": "就像你现在知道的，慢跑之类的运动"}, {"type": "subtitle", "time": 312.79, "timestamp": "00:05:12", "text": "每当这时，我都会这样做。"}, {"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "真希望我能有个眼部监视器之类的东西。"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "就像你一样，你知道"}, {"type": "subtitle", "time": 321.27, "timestamp": "00:05:21", "text": "你知道，就像……那个东西……哪个"}, {"type": "subtitle", "time": 323.83, "timestamp": "00:05:23", "text": "寿司龙使用或喜欢当你在"}, {"type": "subtitle", "time": 326.07, "timestamp": "00:05:26", "text": "外科医学领域或其他类似领域"}, {"type": "subtitle", "time": 327.99, "timestamp": "00:05:27", "text": "你是不是在做手术之类的？"}, {"type": "subtitle", "time": 330.71, "timestamp": "00:05:30", "text": "就像一个基于人工智能的东西，你可以在其中……"}, {"type": "subtitle", "time": 334.95, "timestamp": "00:05:34", "text": "和医生们一起，然后戴上这个……"}, {"type": "subtitle", "time": 336.71, "timestamp": "00:05:36", "text": "玻璃之类的东西。不完整"}, {"type": "subtitle", "time": 338.95, "timestamp": "00:05:38", "text": "眼镜。只针对一只眼睛。它"}, {"type": "subtitle", "time": 341.83, "timestamp": "00:05:41", "text": "会有一个类似 Windows 的屏幕，或者"}, {"type": "subtitle", "time": 344.71, "timestamp": "00:05:44", "text": "里面有东西，你只需要……穿戴"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "它，你真的可以亲眼看到，就像"}, {"type": "subtitle", "time": 349.11, "timestamp": "00:05:49", "text": "你正在看第二个显示器，或者"}, {"type": "subtitle", "time": 351.59000000000003, "timestamp": "00:05:51", "text": "某物。是的。是的。我真希望我也有那个"}, {"type": "subtitle", "time": 353.749, "timestamp": "00:05:53", "text": "事物，"}, {"type": "subtitle", "time": 356.95, "timestamp": "00:05:56", "text": "但这是现实生活，而且是在印度，所以我必须……"}, {"type": "subtitle", "time": 358.469, "timestamp": "00:05:58", "text": "是"}]
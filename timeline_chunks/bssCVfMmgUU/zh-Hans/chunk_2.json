[{"type": "subtitle", "time": 120.23, "timestamp": "00:02:00", "text": "它们之间有点冲突。我的音频"}, {"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "周围的噪音也随之而来。"}, {"type": "subtitle", "time": 127.03, "timestamp": "00:02:07", "text": "变成一个单音节信号之类的东西。"}, {"type": "subtitle", "time": 130.309, "timestamp": "00:02:10", "text": "我不知道为什么，但我可能觉得"}, {"type": "subtitle", "time": 133.51, "timestamp": "00:02:13", "text": "我的麦克风是立体声麦克风。它是冷凝器"}, {"type": "subtitle", "time": 138.63, "timestamp": "00:02:18", "text": "麦克风之类的东西。但问题甚至在于……"}, {"type": "subtitle", "time": 140.79, "timestamp": "00:02:20", "text": "噪声抑制级别三"}, {"type": "subtitle", "time": 143.75, "timestamp": "00:02:23", "text": "麦克风。"}, {"type": "subtitle", "time": 147.51, "timestamp": "00:02:27", "text": "它现在仍然有点儿像样。"}, {"type": "subtitle", "time": 150.63, "timestamp": "00:02:30", "text": "所以，呃，我正在考虑要不要这么做"}, {"type": "subtitle", "time": 152.47, "timestamp": "00:02:32", "text": "我目前使用的噪声抑制功能"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "目前我的直播设备是这个麦克风。我"}, {"type": "subtitle", "time": 157.82999999999998, "timestamp": "00:02:37", "text": "想到了拥有那个"}, {"type": "subtitle", "time": 160.79, "timestamp": "00:02:40", "text": "只有我出门在外的时候，比如开车什么的。"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "当我感觉像是要……的时候"}, {"type": "subtitle", "time": 164.949, "timestamp": "00:02:44", "text": "如果我们这样做，就会进行流式传输。"}, {"type": "subtitle", "time": 167.99, "timestamp": "00:02:47", "text": "直播会像这样"}, {"type": "subtitle", "time": 177.67000000000002, "timestamp": "00:02:57", "text": "[音乐]"}]
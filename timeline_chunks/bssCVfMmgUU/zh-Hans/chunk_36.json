[{"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "好的。好的。好的。很好。电话。呃，"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "好的。呃，电话是。没关系。没有人"}, {"type": "subtitle", "time": 2171.91, "timestamp": "00:36:11", "text": "谢谢你让我让我们……让我们"}, {"type": "subtitle", "time": 2179.99, "timestamp": "00:36:19", "text": "给东西充电。但我该如何装备它呢？"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "按住并按 E 键。"}, {"type": "subtitle", "time": 2184.47, "timestamp": "00:36:24", "text": "哦，"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "耶。你做到了。现在，如果你按下 Tab 键，"}, {"type": "subtitle", "time": 2190.79, "timestamp": "00:36:30", "text": "你可以看到你的升级。"}, {"type": "subtitle", "time": 2201.829, "timestamp": "00:36:41", "text": "正确的？"}, {"type": "subtitle", "time": 2205.27, "timestamp": "00:36:45", "text": "是的。我没事，因为我们需要跑。是的。"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "不。是的。跑步是唯一"}, {"type": "subtitle", "time": 2212.23, "timestamp": "00:36:52", "text": "哦好的。"}]
[{"type": "subtitle", "time": 9243.19, "timestamp": "02:34:03", "text": "拥有众多追随者。她看起来像"}, {"type": "subtitle", "time": 9246.309, "timestamp": "02:34:06", "text": "她就像个老大。"}, {"type": "subtitle", "time": 9247.99, "timestamp": "02:34:07", "text": "踢。"}, {"type": "subtitle", "time": 9249.91, "timestamp": "02:34:09", "text": "是的，"}, {"type": "subtitle", "time": 9253.59, "timestamp": "02:34:13", "text": "真酷。我喜欢……我喜欢……呃"}, {"type": "subtitle", "time": 9259.11, "timestamp": "02:34:19", "text": "动画礼物之类的东西。"}, {"type": "subtitle", "time": 9260.71, "timestamp": "02:34:20", "text": "所以，"}, {"type": "subtitle", "time": 9265.83, "timestamp": "02:34:25", "text": "她是一名3D建模师，她使用3D模型相关的东西。"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "真酷。"}, {"type": "subtitle", "time": 9270.71, "timestamp": "02:34:30", "text": "我看看这里有没有印度人。"}, {"type": "subtitle", "time": 9279.83, "timestamp": "02:34:39", "text": "只有我一个人。只有我一个人。为什么"}, {"type": "subtitle", "time": 9286.71, "timestamp": "02:34:46", "text": "当我观看自己的表演时，一切都很正常。"}, {"type": "subtitle", "time": 9290.55, "timestamp": "02:34:50", "text": "但是你看，有时候它会显示我离线。"}, {"type": "subtitle", "time": 9294.95, "timestamp": "02:34:54", "text": "我不明白。我不明白。"}]
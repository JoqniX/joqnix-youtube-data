[{"type": "subtitle", "time": 1142.15, "timestamp": "00:19:02", "text": "这就像是对男人的爱，对吧？真的"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "美丽。说实话，当我开始阅读的时候"}, {"type": "subtitle", "time": 1148.07, "timestamp": "00:19:08", "text": "YouTube美妆频道真是太烦人了"}, {"type": "subtitle", "time": 1150.71, "timestamp": "00:19:10", "text": "读。我不知道原因，但是"}, {"type": "subtitle", "time": 1158.789, "timestamp": "00:19:18", "text": "或许是因为……"}, {"type": "subtitle", "time": 1161.909, "timestamp": "00:19:21", "text": "从头到尾，她都做不到。"}, {"type": "subtitle", "time": 1165.669, "timestamp": "00:19:25", "text": "弄清楚真正的美究竟是什么。"}, {"type": "subtitle", "time": 1176.95, "timestamp": "00:19:36", "text": "有趣的。我想涉猎一下这个领域。"}, {"type": "subtitle", "time": 1179.51, "timestamp": "00:19:39", "text": "显然，我本来应该……呃，现在我"}, {"type": "subtitle", "time": 1181.75, "timestamp": "00:19:41", "text": "我觉得我休息之后会有更多空闲时间。"}, {"type": "subtitle", "time": 1183.909, "timestamp": "00:19:43", "text": "本月有考试。我想我还会有更多"}, {"type": "subtitle", "time": 1186.47, "timestamp": "00:19:46", "text": "我有空闲时间，所以可以涉猎这些领域。"}, {"type": "subtitle", "time": 1188.15, "timestamp": "00:19:48", "text": "慢慢地。"}, {"type": "subtitle", "time": 1191.83, "timestamp": "00:19:51", "text": "我本应该去报到的。"}, {"type": "subtitle", "time": 1195.11, "timestamp": "00:19:55", "text": "原定下个月在日本，但"}, {"type": "subtitle", "time": 1197.27, "timestamp": "00:19:57", "text": "呃，很遗憾，因为战争的缘故。"}]
[{"type": "subtitle", "time": 8461.51, "timestamp": "02:21:01", "text": "就像和克莱姆森大学的人一起玩一样。比如，哦"}, {"type": "subtitle", "time": 8468.469, "timestamp": "02:21:08", "text": "H"}, {"type": "subtitle", "time": 8471.27, "timestamp": "02:21:11", "text": "感觉就像我一直在等，我只是，我只是重新"}, {"type": "subtitle", "time": 8475.11, "timestamp": "02:21:15", "text": "我直到她告诉我的时候才意识到这一点"}, {"type": "subtitle", "time": 8478.15, "timestamp": "02:21:18", "text": "我告诉她这是我们第一次见面。我"}, {"type": "subtitle", "time": 8483.51, "timestamp": "02:21:23", "text": "当时我就想，等等，我们之前可能聊过。"}, {"type": "subtitle", "time": 8487.11, "timestamp": "02:21:27", "text": "为什么我们没有？我的天啊。"}, {"type": "subtitle", "time": 8488.95, "timestamp": "02:21:28", "text": "是的。再见。"}, {"type": "subtitle", "time": 8490.79, "timestamp": "02:21:30", "text": "谢谢邀请。是的。谢谢"}, {"type": "subtitle", "time": 8493.91, "timestamp": "02:21:33", "text": "期待您的光临。这对我意义重大。感谢"}, {"type": "subtitle", "time": 8508.15, "timestamp": "02:21:48", "text": "我的天啊。我现在感觉自己像个群众演员，但是"}, {"type": "subtitle", "time": 8511.19, "timestamp": "02:21:51", "text": "我不是。"}, {"type": "chat", "time": 8513.859, "timestamp": "02:21:53", "author": "@Clemency_YT", "avatar": "https://yt4.ggpht.com/rezfMTjQgJnHN8tVRRib6_L8uljH-sirLaERneM0eFXx4IVCDS-_D50zQ3DibKqY-hzBv7-l7w=s64-c-k-c0x00ffffff-no-rj", "message": "but it felt like we had an interaction before xD"}, {"type": "subtitle", "time": 8514.71, "timestamp": "02:21:54", "text": "但我很高兴我主动联系了对方。"}, {"type": "subtitle", "time": 8516.55, "timestamp": "02:21:56", "text": "到克拉姆萨。"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "是的。"}]
[{"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "自 2023 年起。我想应该是 24。是的。一"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "或者两年。是的。在你的直播中，但是"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "好像我们以前从未这样互动过一样"}, {"type": "subtitle", "time": 552.31, "timestamp": "00:09:12", "text": "就像打电话玩游戏一样"}, {"type": "subtitle", "time": 554.949, "timestamp": "00:09:14", "text": "一起。"}, {"type": "subtitle", "time": 559.75, "timestamp": "00:09:19", "text": "是的，这是我们的首次合作。我们走吧。"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "上次我想我应该是……嗯，我想我……"}, {"type": "subtitle", "time": 566.79, "timestamp": "00:09:26", "text": "我发现了你"}, {"type": "subtitle", "time": 569.19, "timestamp": "00:09:29", "text": "很久以前。那是什么时候的事？那次你"}, {"type": "subtitle", "time": 571.11, "timestamp": "00:09:31", "text": "首次亮相。你还记得这件事吗？"}, {"type": "subtitle", "time": 574.63, "timestamp": "00:09:34", "text": "是的。是的。是的。是的。是的。"}, {"type": "subtitle", "time": 577.11, "timestamp": "00:09:37", "text": "是的，已经很久很久了。"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "自从。 N"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "是的。最近生活怎么样？你好吗？"}, {"type": "subtitle", "time": 586.47, "timestamp": "00:09:46", "text": "到过？"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "我的意思是，我的考试已经结束了，所以"}, {"type": "subtitle", "time": 592.23, "timestamp": "00:09:52", "text": "就像我的休闲时光一直持续到……"}, {"type": "subtitle", "time": 594.71, "timestamp": "00:09:54", "text": "比如我的课又开始了。所以，我已经"}, {"type": "subtitle", "time": 598.31, "timestamp": "00:09:58", "text": "我已经尽我所能了"}]
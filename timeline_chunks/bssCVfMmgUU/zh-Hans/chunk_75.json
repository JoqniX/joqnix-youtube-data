[{"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "我的天啊。"}, {"type": "subtitle", "time": 4506.709, "timestamp": "01:15:06", "text": "好的。等等。是的，我们可以滚动查看。"}, {"type": "subtitle", "time": 4509.14, "timestamp": "01:15:09", "text": "将物品拉近。"}, {"type": "subtitle", "time": 4510.95, "timestamp": "01:15:10", "text": "[音乐]"}, {"type": "subtitle", "time": 4514.229, "timestamp": "01:15:14", "text": "啊，谢谢你带来的雨水，沃尔特·森。"}, {"type": "subtitle", "time": 4517.669, "timestamp": "01:15:17", "text": "欢迎来到突袭者队。"}, {"type": "subtitle", "time": 4534.87, "timestamp": "01:15:34", "text": "欢迎。欢迎。"}, {"type": "subtitle", "time": 4536.31, "timestamp": "01:15:36", "text": "祝您度过美好的一天，并拥有一个美好的夜晚！"}, {"type": "subtitle", "time": 4538.47, "timestamp": "01:15:38", "text": "溪流。谢谢。你也是。祝你一切顺利"}]
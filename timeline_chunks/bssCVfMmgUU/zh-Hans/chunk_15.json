[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "铁。哦我的天哪，我忘了……"}, {"type": "subtitle", "time": 905.269, "timestamp": "00:15:05", "text": "姓名。铁血地狱犬"}, {"type": "subtitle", "time": 909.75, "timestamp": "00:15:09", "text": "某物。地狱犬。伊恩"}, {"type": "subtitle", "time": 911.67, "timestamp": "00:15:11", "text": "呃"}, {"type": "subtitle", "time": 913.91, "timestamp": "00:15:13", "text": "我不知道这算不算复仇。"}, {"type": "subtitle", "time": 917.75, "timestamp": "00:15:17", "text": "但我读过《地狱之门》。"}, {"type": "subtitle", "time": 920.949, "timestamp": "00:15:20", "text": "哦，这是铁血者的铁血复仇。"}, {"type": "subtitle", "time": 922.87, "timestamp": "00:15:22", "text": "剑。"}, {"type": "subtitle", "time": 927.509, "timestamp": "00:15:27", "text": "哦，我还没看过。啊"}, {"type": "subtitle", "time": 929.829, "timestamp": "00:15:29", "text": "好的，我把名字发给你，你看看。"}, {"type": "subtitle", "time": 932.55, "timestamp": "00:15:32", "text": "虽然我在私信里，但你可以看看。"}, {"type": "subtitle", "time": 934.71, "timestamp": "00:15:34", "text": "稍后再处理。"}, {"type": "subtitle", "time": 938.23, "timestamp": "00:15:38", "text": "是的，牦牛"}, {"type": "subtitle", "time": 942.31, "timestamp": "00:15:42", "text": "我不知道，我没看过。"}, {"type": "subtitle", "time": 943.99, "timestamp": "00:15:43", "text": "[音乐]"}, {"type": "subtitle", "time": 948.15, "timestamp": "00:15:48", "text": "像这样的狂欢节游行太多了。"}, {"type": "subtitle", "time": 951.269, "timestamp": "00:15:51", "text": "我主要读言情小说，或者如果是的话……"}, {"type": "subtitle", "time": 953.189, "timestamp": "00:15:53", "text": "喜欢"}, {"type": "subtitle", "time": 957.189, "timestamp": "00:15:57", "text": "你喜欢那个邪恶的家伙吗？"}]
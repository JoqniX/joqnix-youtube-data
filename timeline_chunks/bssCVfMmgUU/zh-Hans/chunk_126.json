[{"type": "subtitle", "time": 7562.31, "timestamp": "02:06:02", "text": "想换个游戏吗？我们将陷入困境"}, {"type": "subtitle", "time": 7580.709, "timestamp": "02:06:20", "text": "哦，这里没有表达情感之类的功能。"}, {"type": "subtitle", "time": 7588.47, "timestamp": "02:06:28", "text": "这到底是怎么回事？"}, {"type": "subtitle", "time": 7590.629, "timestamp": "02:06:30", "text": "喜欢"}, {"type": "subtitle", "time": 7595.189, "timestamp": "02:06:35", "text": "这到底是怎么回事？我很困惑。"}, {"type": "subtitle", "time": 7597.35, "timestamp": "02:06:37", "text": "哪一个？"}, {"type": "subtitle", "time": 7601.51, "timestamp": "02:06:41", "text": "就像我们差点就成功了一样。是的，"}, {"type": "subtitle", "time": 7603.99, "timestamp": "02:06:43", "text": "我们几乎就要成功了，结果它却弹开了。"}, {"type": "subtitle", "time": 7607.35, "timestamp": "02:06:47", "text": "我们回来了。是因为链条……"}, {"type": "subtitle", "time": 7610.31, "timestamp": "02:06:50", "text": "比如阻止"}]
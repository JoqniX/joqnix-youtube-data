[{"type": "subtitle", "time": 1622.47, "timestamp": "00:27:02", "text": "Repo 还是 Valerin？哪一个？ Roblox 也"}, {"type": "subtitle", "time": 1625.51, "timestamp": "00:27:05", "text": "有此选项。我们不能，我想我有"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "三个都是。你什么意思？你是什么意思？"}, {"type": "subtitle", "time": 1630.87, "timestamp": "00:27:10", "text": "你抛硬币决定？"}, {"type": "subtitle", "time": 1634.789, "timestamp": "00:27:14", "text": "我不知道。喜欢"}, {"type": "subtitle", "time": 1642.39, "timestamp": "00:27:22", "text": "仓库呢？"}, {"type": "subtitle", "time": 1647.19, "timestamp": "00:27:27", "text": "我们可以玩 Repo，但我会给你。我很糟糕"}, {"type": "subtitle", "time": 1650.47, "timestamp": "00:27:30", "text": "在那场比赛中。嘿，我们可以尽力而为。"}, {"type": "subtitle", "time": 1657.99, "timestamp": "00:27:37", "text": "我不太喜欢恐怖片，所以……"}, {"type": "subtitle", "time": 1663.59, "timestamp": "00:27:43", "text": "等等，你喜欢恐怖片吗？"}, {"type": "subtitle", "time": 1667.43, "timestamp": "00:27:47", "text": "我喜欢恐怖片。什么？"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "我喜欢恐怖片。我认为就是这个。"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "肯定会很有趣。我的天啊，"}]
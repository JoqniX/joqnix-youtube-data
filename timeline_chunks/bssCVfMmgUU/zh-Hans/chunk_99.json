[{"type": "subtitle", "time": 5943.59, "timestamp": "01:39:03", "text": "我的天啊。我听到了“我的天哪”。哦，等等。"}, {"type": "subtitle", "time": 5960.629, "timestamp": "01:39:20", "text": "现在到了。"}, {"type": "subtitle", "time": 5978.87, "timestamp": "01:39:38", "text": "而这"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "哦好的。感谢上帝。好的。好的。好的。"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "不，不，不，不。你可以把我拉起来。拉"}, {"type": "subtitle", "time": 5993.03, "timestamp": "01:39:53", "text": "我把我叫醒。让我上去。"}, {"type": "subtitle", "time": 5996.149, "timestamp": "01:39:56", "text": "我的天啊。我的天啊。这很难。"}, {"type": "subtitle", "time": 5999.51, "timestamp": "01:39:59", "text": "好的，我先来。希望我能做到。好的。"}]
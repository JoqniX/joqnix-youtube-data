[{"type": "subtitle", "time": 9840.95, "timestamp": "02:44:00", "text": "就像我以前那样，或者说，我以前是怎么做的"}, {"type": "subtitle", "time": 9843.03, "timestamp": "02:44:03", "text": "我把它弄丢了？公司已经不复存在了。"}, {"type": "chat", "time": 9844.43, "timestamp": "02:44:04", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohhh"}, {"type": "subtitle", "time": 9845.75, "timestamp": "02:44:05", "text": "公司解散后，他们离开了。所以，我"}, {"type": "subtitle", "time": 9847.99, "timestamp": "02:44:07", "text": "我的无线网络连接中断了。那些人"}, {"type": "subtitle", "time": 9851.11, "timestamp": "02:44:11", "text": "它曾帮助过我，也曾帮助过我，但我失去了它。所以，"}, {"type": "subtitle", "time": 9853.99, "timestamp": "02:44:13", "text": "我感觉好像还是有人在。"}, {"type": "subtitle", "time": 9856.309, "timestamp": "02:44:16", "text": "合作方"}, {"type": "subtitle", "time": 9859.11, "timestamp": "02:44:19", "text": "呃，合作方，其中一个日本……呃，不"}, {"type": "subtitle", "time": 9861.51, "timestamp": "02:44:21", "text": "我将与 CNV 块茎进行合作。"}, {"type": "subtitle", "time": 9865.83, "timestamp": "02:44:25", "text": "Screwy Raven，她向我认识的一家机构求助。"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "代表。虽然她能够联系上"}, {"type": "subtitle", "time": 9870.55, "timestamp": "02:44:30", "text": "她还问过他们关于她的东西的事。"}, {"type": "subtitle", "time": 9873.11, "timestamp": "02:44:33", "text": "我的东西，他们说：“你需要"}, {"type": "subtitle", "time": 9875.269, "timestamp": "02:44:35", "text": "拥有观点。你需要更多"}, {"type": "subtitle", "time": 9877.67, "timestamp": "02:44:37", "text": "有人会来看你的视频什么的。"}, {"type": "subtitle", "time": 9879.51, "timestamp": "02:44:39", "text": "你需要达到一定的浏览量。"}, {"type": "subtitle", "time": 9881.51, "timestamp": "02:44:41", "text": "以及你频道里的其他内容。只有我们"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "可以采取一些措施。你观看"}, {"type": "subtitle", "time": 9885.59, "timestamp": "02:44:45", "text": "你上传的内容是什么？"}, {"type": "subtitle", "time": 9887.59, "timestamp": "02:44:47", "text": "无效之类的。你知道，你必须"}, {"type": "chat", "time": 9888.335, "timestamp": "02:44:48", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ahh"}, {"type": "subtitle", "time": 9890.23, "timestamp": "02:44:50", "text": "有中文字幕之类的。制作"}, {"type": "subtitle", "time": 9892.55, "timestamp": "02:44:52", "text": "你的视频更有趣、更精彩。"}, {"type": "subtitle", "time": 9896.15, "timestamp": "02:44:56", "text": "没有东西。他们他们"}, {"type": "subtitle", "time": 9898.469, "timestamp": "02:44:58", "text": "指出了许多关键分析"}]
[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "如果现在有人问起的话……"}, {"type": "subtitle", "time": 423.99, "timestamp": "00:07:03", "text": "如果有人来问我，你是不是"}, {"type": "subtitle", "time": 426.629, "timestamp": "00:07:06", "text": "YouTuber之类的东西，我会做什么？"}, {"type": "subtitle", "time": 433.27, "timestamp": "00:07:13", "text": "还有一种情况是，之后"}, {"type": "subtitle", "time": 436.39, "timestamp": "00:07:16", "text": "我不想再像以前那样走路了。"}, {"type": "subtitle", "time": 440.71, "timestamp": "00:07:20", "text": "去店里喝咖啡。"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "呃，它其实就像一家户外用品商店。呃"}, {"type": "subtitle", "time": 447.11, "timestamp": "00:07:27", "text": "所以你把车停在附近，"}, {"type": "subtitle", "time": 449.749, "timestamp": "00:07:29", "text": "就像离商店很近一样，就像我一样"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "就那样喝咖啡。所以"}, {"type": "subtitle", "time": 454.95, "timestamp": "00:07:34", "text": "嗯"}, {"type": "subtitle", "time": 461.35, "timestamp": "00:07:41", "text": "问题是，那里的那些人会"}, {"type": "subtitle", "time": 464.87, "timestamp": "00:07:44", "text": "那里会有警察，嗯，警察，呃"}, {"type": "subtitle", "time": 469.189, "timestamp": "00:07:49", "text": "警察，呃，人，警察，不是"}, {"type": "subtitle", "time": 471.189, "timestamp": "00:07:51", "text": "像警察一样的人"}, {"type": "subtitle", "time": 474.07, "timestamp": "00:07:54", "text": "来喝咖啡和……"}, {"type": "subtitle", "time": 477.029, "timestamp": "00:07:57", "text": "早餐之类的东西"}]
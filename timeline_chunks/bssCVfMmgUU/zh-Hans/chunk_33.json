[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "我的天哪。我的天啊。没打到你。"}, {"type": "subtitle", "time": 1987.59, "timestamp": "00:33:07", "text": "我的天啊。他来了。离开。对不起。"}, {"type": "subtitle", "time": 1994.63, "timestamp": "00:33:14", "text": "你好，鱼儿们。等一下。那是吗？"}, {"type": "subtitle", "time": 2003.269, "timestamp": "00:33:23", "text": "好的。你好。"}, {"type": "subtitle", "time": 2016.389, "timestamp": "00:33:36", "text": "一家客用品商店。不。商店。"}, {"type": "subtitle", "time": 2020.389, "timestamp": "00:33:40", "text": "找到这家店。购物。多少马力"}, {"type": "subtitle", "time": 2024.149, "timestamp": "00:33:44", "text": "你有吗？呃，我吃饱了。我吃饱了"}, {"type": "subtitle", "time": 2026.149, "timestamp": "00:33:46", "text": "实际上。"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "好的。所以，它不会击中你。"}, {"type": "subtitle", "time": 2031.669, "timestamp": "00:33:51", "text": "你想要什么？我们可以弄到一些"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "或许会升级。"}, {"type": "subtitle", "time": 2038.22, "timestamp": "00:33:58", "text": "不知道。我们需要做些什么？"}]
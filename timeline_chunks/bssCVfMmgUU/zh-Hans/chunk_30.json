[{"type": "subtitle", "time": 1800.47, "timestamp": "00:30:00", "text": "好的。是的，那样可行。请随意"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "我是"}, {"type": "subtitle", "time": 1815.11, "timestamp": "00:30:15", "text": "你好。你好。我觉得我的声音是"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "h"}, {"type": "subtitle", "time": 1822.71, "timestamp": "00:30:22", "text": "游戏中。我不知道。出于某种原因，"}, {"type": "subtitle", "time": 1826.71, "timestamp": "00:30:26", "text": "我的麦克风在游戏中无法识别我的声音。所以，"}, {"type": "subtitle", "time": 1829.19, "timestamp": "00:30:29", "text": "大多数时候，我感觉自己像是在念咒语。"}]
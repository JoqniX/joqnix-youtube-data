[{"type": "subtitle", "time": 666.55, "timestamp": "00:11:06", "text": "就像我在看你的 YouTube 频道一样"}, {"type": "subtitle", "time": 668.55, "timestamp": "00:11:08", "text": "还有你对待橙子的方式"}, {"type": "subtitle", "time": 672.47, "timestamp": "00:11:12", "text": "到处都好可爱。"}, {"type": "subtitle", "time": 674.87, "timestamp": "00:11:14", "text": "是的，我只是想把它放在那里。"}, {"type": "subtitle", "time": 676.79, "timestamp": "00:11:16", "text": "我的缩略图，它就在上面。"}, {"type": "subtitle", "time": 678.79, "timestamp": "00:11:18", "text": "到处。"}, {"type": "subtitle", "time": 681.11, "timestamp": "00:11:21", "text": "但我就是。"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "是的，真的很不错。嗯。所以，"}, {"type": "subtitle", "time": 688.63, "timestamp": "00:11:28", "text": "你的虚拟试管体验如何？是什么激发了灵感"}, {"type": "subtitle", "time": 691.43, "timestamp": "00:11:31", "text": "你会去YouTube之类的网站吗？我总是"}, {"type": "subtitle", "time": 695.35, "timestamp": "00:11:35", "text": "想问你这个问题。哦，我真的"}, {"type": "subtitle", "time": 698.23, "timestamp": "00:11:38", "text": "我喜欢玩游戏之类的。"}, {"type": "subtitle", "time": 700.47, "timestamp": "00:11:40", "text": "东西，我以前经常看这个。"}, {"type": "subtitle", "time": 703.75, "timestamp": "00:11:43", "text": "主播们，我就觉得他们就像……"}, {"type": "subtitle", "time": 705.59, "timestamp": "00:11:45", "text": "玩游戏，他们喋喋不休，而我"}, {"type": "subtitle", "time": 709.67, "timestamp": "00:11:49", "text": "就像我一个人放松的时候那样。"}, {"type": "subtitle", "time": 712.31, "timestamp": "00:11:52", "text": "我会和我的想象中的自己说话"}, {"type": "subtitle", "time": 714.31, "timestamp": "00:11:54", "text": "观众什么的，然后我就想，我可以"}, {"type": "subtitle", "time": 717.19, "timestamp": "00:11:57", "text": "照做。我也会这么做。就是这样。"}, {"type": "subtitle", "time": 719.19, "timestamp": "00:11:59", "text": "基本上，我开始直播，但是"}]
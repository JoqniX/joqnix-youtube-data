[{"type": "subtitle", "time": 7270.229, "timestamp": "02:01:10", "text": "不，不要再来了。是的。好的。站在这里。"}, {"type": "subtitle", "time": 7272.709, "timestamp": "02:01:12", "text": "我会尽力去做。"}, {"type": "subtitle", "time": 7275.99, "timestamp": "02:01:15", "text": "好的。好的。我想如果你进入……"}, {"type": "subtitle", "time": 7277.99, "timestamp": "02:01:17", "text": "在平台上，我可能会掉下去。"}, {"type": "subtitle", "time": 7287.83, "timestamp": "02:01:27", "text": "是的，我挥杆。你回来了。它是"}, {"type": "subtitle", "time": 7290.39, "timestamp": "02:01:30", "text": "就是他们。"}, {"type": "subtitle", "time": 7292.709, "timestamp": "02:01:32", "text": "又是他们。哦，那些家伙来了"}, {"type": "subtitle", "time": 7294.31, "timestamp": "02:01:34", "text": "后退。"}, {"type": "subtitle", "time": 7310.55, "timestamp": "02:01:50", "text": "好的。你是怎么做到的？你是"}]
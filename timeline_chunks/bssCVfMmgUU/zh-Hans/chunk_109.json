[{"type": "subtitle", "time": 6547.109, "timestamp": "01:49:07", "text": "是的。"}, {"type": "subtitle", "time": 6549.669, "timestamp": "01:49:09", "text": "你知道，这次我们可以这么做了。"}, {"type": "subtitle", "time": 6558.229, "timestamp": "01:49:18", "text": "哦，试着把我拉起来。"}, {"type": "subtitle", "time": 6562.39, "timestamp": "01:49:22", "text": "我打算跳。"}, {"type": "subtitle", "time": 6566.709, "timestamp": "01:49:26", "text": "我的天啊。好的，我去。是的。不，不"}, {"type": "subtitle", "time": 6569.189, "timestamp": "01:49:29", "text": "不，不，不，不，不。"}, {"type": "subtitle", "time": 6571.27, "timestamp": "01:49:31", "text": "我觉得这不可能。"}, {"type": "subtitle", "time": 6574.79, "timestamp": "01:49:34", "text": "等待。呃，试着"}, {"type": "subtitle", "time": 6578.55, "timestamp": "01:49:38", "text": "是的，我们可以试试，但是……一秒钟。"}, {"type": "subtitle", "time": 6580.79, "timestamp": "01:49:40", "text": "试着设身处地地想一想。"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "常设。"}, {"type": "subtitle", "time": 6585.109, "timestamp": "01:49:45", "text": "好的。好的。够了。好的。好的。"}, {"type": "subtitle", "time": 6588.87, "timestamp": "01:49:48", "text": "我要跳下去。好的。好的。在哪里？"}, {"type": "subtitle", "time": 6590.39, "timestamp": "01:49:50", "text": "你遇到延迟了吗？"}]
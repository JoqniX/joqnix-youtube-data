[{"type": "subtitle", "time": 12240.55, "timestamp": "03:24:00", "text": "选择器宏并将其放入文件夹中"}, {"type": "subtitle", "time": 12243.67, "timestamp": "03:24:03", "text": "像这样。然后开始行动。所以呢"}, {"type": "subtitle", "time": 12246.229, "timestamp": "03:24:06", "text": "现在，当我说话的时候，事情就会发生。"}, {"type": "subtitle", "time": 12249.99, "timestamp": "03:24:09", "text": "不显示，而且当我不说话的时候"}, {"type": "subtitle", "time": 12253.03, "timestamp": "03:24:13", "text": "它会显露出来，也会隐藏起来。现在就看"}, {"type": "subtitle", "time": 12256.389, "timestamp": "03:24:16", "text": "现在就能得到正确的效果"}, {"type": "subtitle", "time": 12258.55, "timestamp": "03:24:18", "text": "我会教你如何让它更均衡。"}, {"type": "subtitle", "time": 12260.07, "timestamp": "03:24:20", "text": "更好的。"}, {"type": "subtitle", "time": 12263.11, "timestamp": "03:24:23", "text": "进入激活状态。无非活跃状态"}, {"type": "subtitle", "time": 12269.11, "timestamp": "03:24:29", "text": "我们可以设定一个时间。好的。 F"}, {"type": "subtitle", "time": 12273.19, "timestamp": "03:24:33", "text": "如果 F 音频是我的麦克风，并且输出"}, {"type": "chat", "time": 12277.26, "timestamp": "03:24:37", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hey btw have you watched danplan if yes how much"}, {"type": "subtitle", "time": 12277.83, "timestamp": "03:24:37", "text": "音量输出音量为零"}, {"type": "subtitle", "time": 12280.389, "timestamp": "03:24:40", "text": "10秒"}, {"type": "subtitle", "time": 12288.95, "timestamp": "03:24:48", "text": "是的。"}, {"type": "subtitle", "time": 12294.15, "timestamp": "03:24:54", "text": "嗯，等等，我们等一分钟。"}, {"type": "subtitle", "time": 12297.83, "timestamp": "03:24:57", "text": "好的。 Lex 至少持续 1 分钟。"}]
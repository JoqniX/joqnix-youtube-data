[{"type": "subtitle", "time": 10384.389, "timestamp": "02:53:04", "text": "我听到他大声尖叫。好的，我"}, {"type": "subtitle", "time": 10388.389, "timestamp": "02:53:08", "text": "我想我已尽力听到这么多了"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "我需要上传 1 2 3 4 5 6 7 8 9"}, {"type": "subtitle", "time": 10396.309, "timestamp": "02:53:16", "text": "10、11、11 个片段。"}, {"type": "subtitle", "time": 10398.389, "timestamp": "02:53:18", "text": "还有 Twitch。"}, {"type": "subtitle", "time": 10400.23, "timestamp": "02:53:20", "text": "我不知道有没有人剪辑过相关视频。"}, {"type": "subtitle", "time": 10403.19, "timestamp": "02:53:23", "text": "从那时起，我就再也没有在Twitch上直播过。"}, {"type": "subtitle", "time": 10406.07, "timestamp": "02:53:26", "text": "但对于 Twitch 来说是这样。"}, {"type": "subtitle", "time": 10407.59, "timestamp": "02:53:27", "text": "嗯，"}, {"type": "subtitle", "time": 10410.309, "timestamp": "02:53:30", "text": "所以这更像是一种"}, {"type": "subtitle", "time": 10413.19, "timestamp": "02:53:33", "text": "是的，Twitch，没什么精彩片段。"}, {"type": "subtitle", "time": 10416.07, "timestamp": "02:53:36", "text": "呃，我觉得这是我做的。我不知道。"}, {"type": "subtitle", "time": 10417.99, "timestamp": "02:53:37", "text": "没错，就是 Twitch。"}, {"type": "subtitle", "time": 10420.23, "timestamp": "02:53:40", "text": "呃，哦，等等，等等，等等，等等。那里"}, {"type": "subtitle", "time": 10423.269, "timestamp": "02:53:43", "text": "有一些。我觉得他很懒。"}, {"type": "chat", "time": 10423.738, "timestamp": "02:53:43", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "do you know kiwi shio"}, {"type": "subtitle", "time": 10424.95, "timestamp": "02:53:44", "text": "是的，是的，是的，有一些来自"}, {"type": "subtitle", "time": 10428.79, "timestamp": "02:53:48", "text": "抽搐。我得去完成剩下的一个。"}, {"type": "subtitle", "time": 10432.87, "timestamp": "02:53:52", "text": "或两个。是的。你认识岸尾吗？"}]
[{"type": "subtitle", "time": 1020.47, "timestamp": "00:17:00", "text": "搜索网站。就像我"}, {"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "一个都找不到。就像我发现的那样"}, {"type": "subtitle", "time": 1026.549, "timestamp": "00:17:06", "text": "尺寸合适，但我找不到我想要的那款手镯。"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "寻找。嗯哼。"}, {"type": "subtitle", "time": 1033.35, "timestamp": "00:17:13", "text": "是的。找到合适的人。所以"}, {"type": "subtitle", "time": 1035.429, "timestamp": "00:17:15", "text": "展示，就像有时候你不会那样"}, {"type": "subtitle", "time": 1037.829, "timestamp": "00:17:17", "text": "买那些市面上能买到的，但是"}, {"type": "subtitle", "time": 1040.309, "timestamp": "00:17:20", "text": "有时你会遇到……该怎么称呼它呢？"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "是的。随机的。"}, {"type": "subtitle", "time": 1045.829, "timestamp": "00:17:25", "text": "是的。喜欢"}, {"type": "subtitle", "time": 1049.11, "timestamp": "00:17:29", "text": "那我就不剧透太多了，我会说……"}, {"type": "subtitle", "time": 1051.35, "timestamp": "00:17:31", "text": "因为我做的事情而受到评判"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "好的。"}, {"type": "subtitle", "time": 1061.43, "timestamp": "00:17:41", "text": "动漫呢？你在看吗？"}, {"type": "subtitle", "time": 1063.27, "timestamp": "00:17:43", "text": "日本动画片？"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "那么漫画呢？漫画。不，不是。"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "漫画也是。我更像一个"}]
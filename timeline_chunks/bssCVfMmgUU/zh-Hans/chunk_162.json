[{"type": "subtitle", "time": 9720.309, "timestamp": "02:42:00", "text": "我的电脑出了点问题。我想要"}, {"type": "subtitle", "time": 9724.07, "timestamp": "02:42:04", "text": "涉猎一些领域，比如……"}, {"type": "subtitle", "time": 9726.95, "timestamp": "02:42:06", "text": "垂直多级。"}, {"type": "subtitle", "time": 9730.469, "timestamp": "02:42:10", "text": "我现在想做垂直多路复现。"}, {"type": "subtitle", "time": 9733.59, "timestamp": "02:42:13", "text": "我知道这有点过分，但我还是想说，嗯。"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "为什么不呢？我想试试看效果如何"}, {"type": "subtitle", "time": 9738.71, "timestamp": "02:42:18", "text": "如果我能更好地发展我的频道，那就太好了。"}, {"type": "subtitle", "time": 9741.51, "timestamp": "02:42:21", "text": "垂直方向更好，我想试试。"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "流媒体"}, {"type": "subtitle", "time": 9745.27, "timestamp": "02:42:25", "text": "但问题在于资金问题。"}, {"type": "subtitle", "time": 9748.79, "timestamp": "02:42:28", "text": "对，等等，我可以免费做，我是"}, {"type": "chat", "time": 9748.799, "timestamp": "02:42:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah"}, {"type": "subtitle", "time": 9751.91, "timestamp": "02:42:31", "text": "使用光束流，这样我就可以做到这一点。"}, {"type": "subtitle", "time": 9754.469, "timestamp": "02:42:34", "text": "所以从某种意义上说，这意味着我想要"}, {"type": "subtitle", "time": 9758.55, "timestamp": "02:42:38", "text": "我得对我的 OBS 设置进行一些调整，这样我们"}, {"type": "subtitle", "time": 9762.23, "timestamp": "02:42:42", "text": "得清理一些东西，还有……"}, {"type": "subtitle", "time": 9765.11, "timestamp": "02:42:45", "text": "还有，比利，我得去买点东西。"}, {"type": "subtitle", "time": 9768.309, "timestamp": "02:42:48", "text": "对付比利比利。我仍然"}, {"type": "subtitle", "time": 9770.55, "timestamp": "02:42:50", "text": "我正在努力奋斗。我得去做……呃"}, {"type": "subtitle", "time": 9772.309, "timestamp": "02:42:52", "text": "介绍视频。我得开始了。"}, {"type": "subtitle", "time": 9776.309, "timestamp": "02:42:56", "text": "现在都在制作视频什么的，对吧？"}, {"type": "subtitle", "time": 9778.87, "timestamp": "02:42:58", "text": "所以，很多事情都岌岌可危，对吧？"}]
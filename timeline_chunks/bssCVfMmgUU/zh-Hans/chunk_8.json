[{"type": "subtitle", "time": 480.629, "timestamp": "00:08:00", "text": "他们会说，是的，那只是今天的情况。"}, {"type": "subtitle", "time": 483.029, "timestamp": "00:08:03", "text": "我仍然戴着头盔，而且我当时"}, {"type": "subtitle", "time": 487.11, "timestamp": "00:08:07", "text": "我一边喝咖啡一边想：嗯……"}, {"type": "subtitle", "time": 491.589, "timestamp": "00:08:11", "text": "就在这附近，嗯，我当时就像在散步一样。"}, {"type": "subtitle", "time": 493.99, "timestamp": "00:08:13", "text": "像商店旁边那样，像"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "字面上平静而安静地交谈"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "因为人们是"}, {"type": "subtitle", "time": 503.029, "timestamp": "00:08:23", "text": "大家好。"}, {"type": "subtitle", "time": 506.71, "timestamp": "00:08:26", "text": "欢迎来到Jakatan第91天第二部分"}, {"type": "subtitle", "time": 510.15, "timestamp": "00:08:30", "text": "溪流。接下来我们将迎来第二位嘉宾。"}, {"type": "subtitle", "time": 516.79, "timestamp": "00:08:36", "text": "夜幕降临。我们有克莱门斯在。你好。"}, {"type": "subtitle", "time": 521.75, "timestamp": "00:08:41", "text": "你好。你好，姐姐。你好吗？"}, {"type": "subtitle", "time": 525.67, "timestamp": "00:08:45", "text": "我想你，我一直都很好。它是"}, {"type": "subtitle", "time": 527.75, "timestamp": "00:08:47", "text": "好久不见。我想这是我们的第一个"}, {"type": "subtitle", "time": 529.829, "timestamp": "00:08:49", "text": "互动时间。你们互动过吗？"}, {"type": "subtitle", "time": 532.949, "timestamp": "00:08:52", "text": "前？是的。我想应该是的。这"}, {"type": "subtitle", "time": 536.47, "timestamp": "00:08:56", "text": "和很多其他东西一样。第一次。第一个"}, {"type": "subtitle", "time": 538.949, "timestamp": "00:08:58", "text": "时间。但我认为我之前见过你。"}]
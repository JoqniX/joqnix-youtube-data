[{"type": "subtitle", "time": 785.91, "timestamp": "00:13:05", "text": "所以，拥有一个……的优势或许在于……"}, {"type": "subtitle", "time": 789.19, "timestamp": "00:13:09", "text": "像哥哥一样的兄长。"}, {"type": "subtitle", "time": 791.11, "timestamp": "00:13:11", "text": "是的。"}, {"type": "subtitle", "time": 794.55, "timestamp": "00:13:14", "text": "我总是看到你在玩漫威游戏"}, {"type": "subtitle", "time": 798.55, "timestamp": "00:13:18", "text": "对手、瓦尔等等。我当时就想，哇，"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "克莱门斯真是个游戏迷。"}, {"type": "subtitle", "time": 806.23, "timestamp": "00:13:26", "text": "一直都在忙碌奔波。是的，我当时是"}, {"type": "subtitle", "time": 809.11, "timestamp": "00:13:29", "text": "那段时间我正处于连败之中。"}, {"type": "subtitle", "time": 811.269, "timestamp": "00:13:31", "text": "我上次玩赛车游戏。我当时"}, {"type": "subtitle", "time": 813.59, "timestamp": "00:13:33", "text": "比如，“绝对不行，我才不玩呢！”"}, {"type": "subtitle", "time": 819.35, "timestamp": "00:13:39", "text": "瓦伦特的情况也一样。我当时在玩"}, {"type": "subtitle", "time": 821.35, "timestamp": "00:13:41", "text": "瓦伦特。我当时处于一场惨败之中。"}, {"type": "subtitle", "time": 823.269, "timestamp": "00:13:43", "text": "条纹。我当时就想，“不，我需要我的"}, {"type": "subtitle", "time": 826.87, "timestamp": "00:13:46", "text": "和平。我不会把假期浪费在……"}, {"type": "subtitle", "time": 829.43, "timestamp": "00:13:49", "text": "连败"}, {"type": "subtitle", "time": 831.59, "timestamp": "00:13:51", "text": "我最近一直在疯狂读书。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "我一直在看漫画，网络"}, {"type": "subtitle", "time": 837.91, "timestamp": "00:13:57", "text": "曲调。哦，哪些？网络音乐。哪个"}]
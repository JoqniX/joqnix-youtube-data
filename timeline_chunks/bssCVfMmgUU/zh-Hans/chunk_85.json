[{"type": "subtitle", "time": 5100.709, "timestamp": "01:25:00", "text": "可能会发生。我大概三天前买的。"}, {"type": "subtitle", "time": 5103.27, "timestamp": "01:25:03", "text": "很久以前，我当时就想，我没想到会这样。"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "我以为你喜欢停电"}, {"type": "subtitle", "time": 5112.95, "timestamp": "01:25:12", "text": "或者像你跟我说的那样。是的。"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "是的。是的。城市里的东西。呃，等等。它是"}, {"type": "subtitle", "time": 5119.189, "timestamp": "01:25:19", "text": "11:56。哦，为什么他们不把它剪掉呢？我"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "不知道。我当时想，“哦，他们是……”"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "准备剪掉它。” 所以，就像昨天一样。"}, {"type": "subtitle", "time": 5125.99, "timestamp": "01:25:25", "text": "他们没剪，因为今天是星期一。"}, {"type": "subtitle", "time": 5128.55, "timestamp": "01:25:28", "text": "昨天和今天。"}, {"type": "subtitle", "time": 5130.87, "timestamp": "01:25:30", "text": "所以，我不知道上次发生了什么。"}, {"type": "subtitle", "time": 5133.35, "timestamp": "01:25:33", "text": "时间。连续三天。他们是"}, {"type": "subtitle", "time": 5136.07, "timestamp": "01:25:36", "text": "大约在11:30左右切断三角洲城的拍摄。"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "并在 12:30 或"}, {"type": "subtitle", "time": 5141.75, "timestamp": "01:25:41", "text": "某物。"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "是的。作者：Zaka。好的，我又回来了。"}, {"type": "subtitle", "time": 5150.87, "timestamp": "01:25:50", "text": "你想玩什么游戏？我得到了"}, {"type": "subtitle", "time": 5153.27, "timestamp": "01:25:53", "text": "使困惑。东西太多了。"}, {"type": "subtitle", "time": 5158.25, "timestamp": "01:25:58", "text": "比如，你和我一样有多少？"}]
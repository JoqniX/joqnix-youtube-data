[{"type": "subtitle", "time": 6423.189, "timestamp": "01:47:03", "text": "糟糕。是的，你现在可以冲刺了。所以，"}, {"type": "subtitle", "time": 6426.55, "timestamp": "01:47:06", "text": "我们应该一起冲刺然后跳跃吗？"}, {"type": "subtitle", "time": 6428.629, "timestamp": "01:47:08", "text": "好的，我们开始吧。好的。三，"}, {"type": "subtitle", "time": 6435.189, "timestamp": "01:47:15", "text": "试着加入链条。链子，链子。"}, {"type": "subtitle", "time": 6437.03, "timestamp": "01:47:17", "text": "链子，链子。哦，它没有。"}, {"type": "subtitle", "time": 6439.43, "timestamp": "01:47:19", "text": "碰撞箱。"}, {"type": "subtitle", "time": 6441.59, "timestamp": "01:47:21", "text": "不，并非如此。"}, {"type": "subtitle", "time": 6471.669, "timestamp": "01:47:51", "text": "我又摔倒了。我打算用这个"}, {"type": "subtitle", "time": 6473.669, "timestamp": "01:47:53", "text": "游戏。"}]
[{"type": "subtitle", "time": 1321.35, "timestamp": "00:22:01", "text": "这只是一款需要……的电子游戏。"}, {"type": "subtitle", "time": 1325.43, "timestamp": "00:22:05", "text": "烤。哇。"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "我曾经对你们所有人都着迷。然后我的"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "朋友拉我玩《Valerant》。我仍然"}, {"type": "subtitle", "time": 1339.59, "timestamp": "00:22:19", "text": "讨厌那个游戏。我玩那个游戏只是因为"}, {"type": "subtitle", "time": 1344.95, "timestamp": "00:22:24", "text": "你好。"}, {"type": "subtitle", "time": 1348.39, "timestamp": "00:22:28", "text": "我真的非常喜欢，嗯，我有点着迷了。"}, {"type": "subtitle", "time": 1352.789, "timestamp": "00:22:32", "text": "以及僵尸恐怖游戏。"}, {"type": "subtitle", "time": 1354.31, "timestamp": "00:22:34", "text": "哦"}, {"type": "subtitle", "time": 1357.75, "timestamp": "00:22:37", "text": "是的，我喜欢僵尸游戏。"}, {"type": "subtitle", "time": 1360.07, "timestamp": "00:22:40", "text": "嗯。"}, {"type": "subtitle", "time": 1363.27, "timestamp": "00:22:43", "text": "我不知道，呃，他们是"}, {"type": "subtitle", "time": 1366.07, "timestamp": "00:22:46", "text": "我的朋友就像他们一样"}, {"type": "subtitle", "time": 1368.789, "timestamp": "00:22:48", "text": "如果他们想的话，请介绍给我。"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "他们说，请介绍我认识新朋友吧。"}, {"type": "subtitle", "time": 1373.19, "timestamp": "00:22:53", "text": "她勾引了鬼魂，而我……"}, {"type": "subtitle", "time": 1376.87, "timestamp": "00:22:56", "text": "请问，我为什么会出名？"}]
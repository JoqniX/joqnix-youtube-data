[{"type": "subtitle", "time": 13440.389, "timestamp": "03:44:00", "text": "迫不及待想试试DND了"}, {"type": "subtitle", "time": 13443.189, "timestamp": "03:44:03", "text": "一些"}, {"type": "subtitle", "time": 13447.189, "timestamp": "03:44:07", "text": "迫不及待想尝试！迫不及待想去做！"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "[音乐]"}, {"type": "subtitle", "time": 13462.55, "timestamp": "03:44:22", "text": "问题是，她的第二个名字"}, {"type": "subtitle", "time": 13465.83, "timestamp": "03:44:25", "text": "第二个姓氏有点难填。"}, {"type": "subtitle", "time": 13468.229, "timestamp": "03:44:28", "text": "对我来说，所以我没说出口。"}, {"type": "subtitle", "time": 13470.95, "timestamp": "03:44:30", "text": "声音很大，因为我不想让她把它糟蹋了。"}, {"type": "subtitle", "time": 13473.91, "timestamp": "03:44:33", "text": "我不想显得太粗鲁。所以"}, {"type": "subtitle", "time": 13476.79, "timestamp": "03:44:36", "text": "我叫她意大利人，我希望不会这样。"}, {"type": "subtitle", "time": 13479.429, "timestamp": "03:44:39", "text": "太多了。"}, {"type": "subtitle", "time": 13495.83, "timestamp": "03:44:55", "text": "然后"}, {"type": "subtitle", "time": 13498.469, "timestamp": "03:44:58", "text": "临近傍晚。"}]
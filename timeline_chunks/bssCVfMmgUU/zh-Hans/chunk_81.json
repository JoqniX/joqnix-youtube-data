[{"type": "subtitle", "time": 4860.87, "timestamp": "01:21:00", "text": "你的手机"}, {"type": "subtitle", "time": 4871.189, "timestamp": "01:21:11", "text": "请不要谈论我为什么会有那种感觉。"}, {"type": "subtitle", "time": 4874.95, "timestamp": "01:21:14", "text": "姓名。我没有收到通知。"}, {"type": "subtitle", "time": 4878.149, "timestamp": "01:21:18", "text": "你没明白。"}, {"type": "subtitle", "time": 4881.83, "timestamp": "01:21:21", "text": "哦，朋友们，我想。"}, {"type": "subtitle", "time": 4884.39, "timestamp": "01:21:24", "text": "哦，明白了。我得到了它。"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "呃，我的冷知识。这是什么？好的。"}, {"type": "subtitle", "time": 4889.59, "timestamp": "01:21:29", "text": "接受。那是你，对吧？"}, {"type": "subtitle", "time": 4896.149, "timestamp": "01:21:36", "text": "呃"}, {"type": "subtitle", "time": 4898.709, "timestamp": "01:21:38", "text": "我们不评判。是的。我们不谈论"}, {"type": "subtitle", "time": 4919.75, "timestamp": "01:21:59", "text": "你玩过哪些恐怖游戏？"}]
[{"type": "subtitle", "time": 6723.99, "timestamp": "01:52:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 6726.709, "timestamp": "01:52:06", "text": "这真是件了不起的事。是的，有点像"}, {"type": "subtitle", "time": 6729.189, "timestamp": "01:52:09", "text": "让我压力很大。"}, {"type": "subtitle", "time": 6742.07, "timestamp": "01:52:22", "text": "如果这就是全部，我很好奇该如何计算。"}, {"type": "subtitle", "time": 6744.47, "timestamp": "01:52:24", "text": "链子连在一起就是。"}, {"type": "subtitle", "time": 6747.03, "timestamp": "01:52:27", "text": "我认为最初的链条是"}, {"type": "subtitle", "time": 6749.109, "timestamp": "01:52:29", "text": "真的"}, {"type": "subtitle", "time": 6767.51, "timestamp": "01:52:47", "text": "我不知道是不是每个人都做到了这一点。"}, {"type": "subtitle", "time": 6769.43, "timestamp": "01:52:49", "text": "远的。"}, {"type": "subtitle", "time": 6771.03, "timestamp": "01:52:51", "text": "耶，我们是哦，等等。还有更多"}, {"type": "subtitle", "time": 6773.91, "timestamp": "01:52:53", "text": "那里的人。我当时很高兴我们"}, {"type": "subtitle", "time": 6776.87, "timestamp": "01:52:56", "text": "他们是第一个走到这一步的。"}]
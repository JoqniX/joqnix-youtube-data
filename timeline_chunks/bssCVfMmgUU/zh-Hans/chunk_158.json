[{"type": "subtitle", "time": 9481.59, "timestamp": "02:38:01", "text": "如果下周一切顺利的话"}, {"type": "subtitle", "time": 9483.83, "timestamp": "02:38:03", "text": "我放了一张大家的合照。"}, {"type": "subtitle", "time": 9486.87, "timestamp": "02:38:06", "text": "我跟谁合作过等等。"}, {"type": "subtitle", "time": 9489.83, "timestamp": "02:38:09", "text": "我本来就应该那样做。"}, {"type": "subtitle", "time": 9492.15, "timestamp": "02:38:12", "text": "但现在"}, {"type": "subtitle", "time": 9495.91, "timestamp": "02:38:15", "text": "那个计划已经行不通了。"}, {"type": "subtitle", "time": 9501.51, "timestamp": "02:38:21", "text": "所以我就想，我该怎么办？我仍然想要"}, {"type": "subtitle", "time": 9504.87, "timestamp": "02:38:24", "text": "我仍然要拍集体照。"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "与所有人，"}, {"type": "subtitle", "time": 9509.51, "timestamp": "02:38:29", "text": "把每个人的模型都放进去之类的。它是"}, {"type": "subtitle", "time": 9511.67, "timestamp": "02:38:31", "text": "就像我自己的活动一样，"}, {"type": "subtitle", "time": 9514.15, "timestamp": "02:38:34", "text": "频道活动，对吧？"}, {"type": "chat", "time": 9514.663, "timestamp": "02:38:34", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "now the photo would be even bigger"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "另外，我还需要检查一下"}, {"type": "chat", "time": 9522.654, "timestamp": "02:38:42", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "than how it was like"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "我相信人们可能已经有了"}, {"type": "chat", "time": 9526.464, "timestamp": "02:38:46", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "now"}, {"type": "subtitle", "time": 9528.309, "timestamp": "02:38:48", "text": "是的。现在照片会更大。"}, {"type": "subtitle", "time": 9530.79, "timestamp": "02:38:50", "text": "是的。还"}, {"type": "subtitle", "time": 9534.87, "timestamp": "02:38:54", "text": "还有反馈帖。有人"}, {"type": "subtitle", "time": 9536.55, "timestamp": "02:38:56", "text": "任何人"}]
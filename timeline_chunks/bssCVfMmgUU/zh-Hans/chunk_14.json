[{"type": "subtitle", "time": 841.91, "timestamp": "00:14:01", "text": "一？好的。我最近完成了"}, {"type": "subtitle", "time": 845.99, "timestamp": "00:14:05", "text": "特鲁尔行动。作者目前处于休假状态。"}, {"type": "subtitle", "time": 848.949, "timestamp": "00:14:08", "text": "令人遗憾。"}, {"type": "subtitle", "time": 852.949, "timestamp": "00:14:12", "text": "是啊，那件武器简直一团糟。"}, {"type": "subtitle", "time": 855.11, "timestamp": "00:14:15", "text": "还有什么？有很多"}, {"type": "subtitle", "time": 857.829, "timestamp": "00:14:17", "text": "持续的网络基调。"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "嗯。"}, {"type": "subtitle", "time": 867.59, "timestamp": "00:14:27", "text": "我不知道。我想漫画就是漫画吧"}, {"type": "subtitle", "time": 870.629, "timestamp": "00:14:30", "text": "漫画就不一样了。网络调音是"}, {"type": "subtitle", "time": 873.75, "timestamp": "00:14:33", "text": "就像韩国那种彩色字体一样，"}, {"type": "subtitle", "time": 878.949, "timestamp": "00:14:38", "text": "正确的？是的。是的。啊，原来是魔法。是的。"}, {"type": "subtitle", "time": 883.35, "timestamp": "00:14:43", "text": "哦，我不知道。我就是知道"}, {"type": "subtitle", "time": 886.71, "timestamp": "00:14:46", "text": "就像漫画一样。我不知道。我"}, {"type": "subtitle", "time": 889.67, "timestamp": "00:14:49", "text": "我只是读一些吸引我的东西。"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "兴趣。哦，那真不错。你有吗？"}, {"type": "subtitle", "time": 897.59, "timestamp": "00:14:57", "text": "读一下铁……呃，那是什么来着？复仇"}]
[{"type": "subtitle", "time": 4322.48, "timestamp": "01:12:02", "text": "是 没有，没有"}, {"type": "subtitle", "time": 4354.149, "timestamp": "01:12:34", "text": "是的。"}, {"type": "subtitle", "time": 4357.27, "timestamp": "01:12:37", "text": "明白了。明白了。"}, {"type": "subtitle", "time": 4369.59, "timestamp": "01:12:49", "text": "我的天哪，达基。出去。"}, {"type": "subtitle", "time": 4373.35, "timestamp": "01:12:53", "text": "你为什么非得这样？我的天哪。我要去"}, {"type": "subtitle", "time": 4375.75, "timestamp": "01:12:55", "text": "我的天啊。不要挡在我前面。"}, {"type": "subtitle", "time": 4378.229, "timestamp": "01:12:58", "text": "小鸭子。"}]
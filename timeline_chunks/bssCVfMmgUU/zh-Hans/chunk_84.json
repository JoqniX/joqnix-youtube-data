[{"type": "subtitle", "time": 5051.43, "timestamp": "01:24:11", "text": "你听到了吗？你好。是的。"}, {"type": "subtitle", "time": 5055.43, "timestamp": "01:24:15", "text": "最后。我的天啊，互联网瘫痪了。"}, {"type": "subtitle", "time": 5058.47, "timestamp": "01:24:18", "text": "所以现在发生的事情是，自从我开始直播以来……"}, {"type": "subtitle", "time": 5060.79, "timestamp": "01:24:20", "text": "就这24小时，以及现在的一切，就是这样。"}, {"type": "subtitle", "time": 5062.629, "timestamp": "01:24:22", "text": "我需要下载 V 上传文件"}, {"type": "subtitle", "time": 5065.75, "timestamp": "01:24:25", "text": "一切。所以，如果……呃，所以我"}, {"type": "subtitle", "time": 5069.35, "timestamp": "01:24:29", "text": "我给我的Geo Fiber充值了，30MB套餐"}, {"type": "subtitle", "time": 5072.229, "timestamp": "01:24:32", "text": "现在。所以我在开始时给它充了电。"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "本月到期。整个过程"}, {"type": "subtitle", "time": 5079.43, "timestamp": "01:24:39", "text": "数据已过期，尽管它显示如此"}, {"type": "subtitle", "time": 5082.55, "timestamp": "01:24:42", "text": "无限。我不知道我是怎么结束的。"}, {"type": "subtitle", "time": 5086.229, "timestamp": "01:24:46", "text": "数据。这样可行。是的，就像上面说的那样。"}, {"type": "subtitle", "time": 5089.99, "timestamp": "01:24:49", "text": "无限。数据流量不限，但是"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "我已经完全完成了数据处理。所以，就是这样。"}, {"type": "subtitle", "time": 5094.709, "timestamp": "01:24:54", "text": "显示红色。所以，我不得不买。"}, {"type": "subtitle", "time": 5097.91, "timestamp": "01:24:57", "text": "再买一次。幸好，我想到了这一点。"}]
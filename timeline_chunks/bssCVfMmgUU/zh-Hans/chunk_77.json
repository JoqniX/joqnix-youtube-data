[{"type": "subtitle", "time": 4623.189, "timestamp": "01:17:03", "text": "快跑，快跑。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 4624.79, "timestamp": "01:17:04", "text": "是的。逃走就好。逃脱。逃脱。"}, {"type": "subtitle", "time": 4627.199, "timestamp": "01:17:07", "text": "逃脱。 我的天啊。"}, {"type": "subtitle", "time": 4629.28, "timestamp": "01:17:09", "text": "我的天啊。 查看地图。我的天哪。它为什么会在那里？"}, {"type": "subtitle", "time": 4632.48, "timestamp": "01:17:12", "text": "查看地图。我的天哪。它为什么会在那里？ 它为什么要逃跑？"}, {"type": "subtitle", "time": 4638.79, "timestamp": "01:17:18", "text": "你身后。你身后。你身后。跑步。"}, {"type": "subtitle", "time": 4642.87, "timestamp": "01:17:22", "text": "跑步。跑步。跑步。我死了。我死了。"}, {"type": "subtitle", "time": 4645.35, "timestamp": "01:17:25", "text": "我的天哪。你死定了。我死了。我死了。"}, {"type": "subtitle", "time": 4647.35, "timestamp": "01:17:27", "text": "哦，没关系。没关系。是的。是的。"}, {"type": "subtitle", "time": 4652.47, "timestamp": "01:17:32", "text": "去。去。去。去。去。去。去。去。我的天哪。"}, {"type": "subtitle", "time": 4661.83, "timestamp": "01:17:41", "text": "那你转身就走吧。是的。不，不，不，不。"}, {"type": "subtitle", "time": 4663.189, "timestamp": "01:17:43", "text": "不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不"}, {"type": "subtitle", "time": 4664.709, "timestamp": "01:17:44", "text": "不。"}, {"type": "subtitle", "time": 4667.83, "timestamp": "01:17:47", "text": "请不要死。请不要死。"}, {"type": "subtitle", "time": 4677.27, "timestamp": "01:17:57", "text": "没关系。"}]
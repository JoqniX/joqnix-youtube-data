[{"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "你好。"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "耶。我当时在玩单人模式的这款游戏。"}, {"type": "subtitle", "time": 1883.19, "timestamp": "00:31:23", "text": "视频，但我之后并没有这么做。"}, {"type": "subtitle", "time": 1886.549, "timestamp": "00:31:26", "text": "一级，因为我害怕。"}, {"type": "subtitle", "time": 1889.35, "timestamp": "00:31:29", "text": "但是你，你说你擅长"}, {"type": "subtitle", "time": 1891.43, "timestamp": "00:31:31", "text": "恐怖。"}, {"type": "subtitle", "time": 1894.389, "timestamp": "00:31:34", "text": "我说我喜欢，但我从没说过我擅长"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "它。好的。"}, {"type": "subtitle", "time": 1899.35, "timestamp": "00:31:39", "text": "我的天啊。"}, {"type": "subtitle", "time": 1902.31, "timestamp": "00:31:42", "text": "上面有一些很贵的东西。"}, {"type": "subtitle", "time": 1904.549, "timestamp": "00:31:44", "text": "那里。"}, {"type": "subtitle", "time": 1913.75, "timestamp": "00:31:53", "text": "现在怎么办？我们可以……我们可以把它举起来"}, {"type": "subtitle", "time": 1918.23, "timestamp": "00:31:58", "text": "把它们放在一起，然后放进……"}]
[{"type": "subtitle", "time": 17947.69, "timestamp": "04:59:07", "text": "就是这样。"}, {"type": "subtitle", "time": 17964.31, "timestamp": "04:59:24", "text": "2026年3月底。"}, {"type": "subtitle", "time": 17967.03, "timestamp": "04:59:27", "text": "这是我即将发布的一项重大声明。"}, {"type": "subtitle", "time": 17970.788, "timestamp": "04:59:30", "text": "你知道，从某种程度上说，这会限制我。"}, {"type": "subtitle", "time": 17976.788, "timestamp": "04:59:36", "text": "很多。我觉得不应该限制更多像这样"}, {"type": "subtitle", "time": 17980.39, "timestamp": "04:59:40", "text": "如果有人捐赠2000美元会发生什么？"}, {"type": "subtitle", "time": 17983.19, "timestamp": "04:59:43", "text": "对我来说之类的。会发生什么？哦，"}, {"type": "subtitle", "time": 17985.19, "timestamp": "04:59:45", "text": "不。不，那绝不可能发生。"}, {"type": "subtitle", "time": 17989.19, "timestamp": "04:59:49", "text": "但想想看，"}, {"type": "subtitle", "time": 17992.868, "timestamp": "04:59:52", "text": "兄弟，如果有人真的强迫我"}, {"type": "subtitle", "time": 17996.31, "timestamp": "04:59:56", "text": "最后，Jo，我要永远和他一起嗨。"}, {"type": "chat", "time": 17997.175, "timestamp": "04:59:57", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "when that happens we happy"}, {"type": "subtitle", "time": 17999.27, "timestamp": "04:59:59", "text": "很多。但这永远不会发生。"}]
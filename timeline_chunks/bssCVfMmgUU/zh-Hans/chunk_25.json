[{"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "人有时候会很刻薄。哇。是的。是的，"}, {"type": "subtitle", "time": 1507.99, "timestamp": "00:25:07", "text": "这就是互联网。"}, {"type": "subtitle", "time": 1512.07, "timestamp": "00:25:12", "text": "我想我算是吃一堑长一智了。"}, {"type": "subtitle", "time": 1515.59, "timestamp": "00:25:15", "text": "有些人真是令人毛骨悚然，行为怪异。和"}, {"type": "subtitle", "time": 1517.51, "timestamp": "00:25:17", "text": "是的。"}, {"type": "subtitle", "time": 1523.19, "timestamp": "00:25:23", "text": "当你能够上网时"}, {"type": "subtitle", "time": 1525.99, "timestamp": "00:25:25", "text": "人们可以是你，你可以像你一样遇到他们"}, {"type": "subtitle", "time": 1528.71, "timestamp": "00:25:28", "text": "像有这样各种各样的人"}, {"type": "subtitle", "time": 1534.31, "timestamp": "00:25:34", "text": "比如各种各样的。是的"}, {"type": "subtitle", "time": 1537.19, "timestamp": "00:25:37", "text": "世上形形色色的人都有。"}, {"type": "subtitle", "time": 1543.43, "timestamp": "00:25:43", "text": "所以，你有什么计划吗？比如……"}, {"type": "subtitle", "time": 1547.269, "timestamp": "00:25:47", "text": "未来会有完整模型和其他内容吗？喜欢"}, {"type": "subtitle", "time": 1551.35, "timestamp": "00:25:51", "text": "嗯，你现在就像个可爱的小橘子。"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "塔玛尔，对吧？你有没有过这样的经历？"}, {"type": "subtitle", "time": 1558.47, "timestamp": "00:25:58", "text": "人形之类的？我的确有这个计划"}]
[{"type": "subtitle", "time": 1389.11, "timestamp": "00:23:09", "text": "我不喜欢玩那种游戏。"}, {"type": "subtitle", "time": 1391.27, "timestamp": "00:23:11", "text": "那"}, {"type": "subtitle", "time": 1395.43, "timestamp": "00:23:15", "text": "战术射击游戏之类的？你"}, {"type": "subtitle", "time": 1397.99, "timestamp": "00:23:17", "text": "等等，你喜欢FPS类型的游戏吗？我"}, {"type": "subtitle", "time": 1400.63, "timestamp": "00:23:20", "text": "你应该喜欢第一人称射击游戏吧？是的，我的确"}, {"type": "subtitle", "time": 1403.51, "timestamp": "00:23:23", "text": "帧率。我"}, {"type": "subtitle", "time": 1406.39, "timestamp": "00:23:26", "text": "以前不喜欢这样，因为我没玩过。"}, {"type": "subtitle", "time": 1409.029, "timestamp": "00:23:29", "text": "就像大多数故事模式游戏一样"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "时间就像以前一样，就像我以前一样。"}, {"type": "subtitle", "time": 1414.549, "timestamp": "00:23:34", "text": "开始直播的时候，我以前经常玩游戏"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "是的，我当时没有任何经验。"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "直到像竞争之类的事情发生"}, {"type": "subtitle", "time": 1429.35, "timestamp": "00:23:49", "text": "我进去之后的东西，尤其是……"}, {"type": "subtitle", "time": 1432.47, "timestamp": "00:23:52", "text": "孟买的服务器体验并不愉快。"}, {"type": "subtitle", "time": 1434.71, "timestamp": "00:23:54", "text": "我有经验，但同时我也有……"}, {"type": "subtitle", "time": 1437.43, "timestamp": "00:23:57", "text": "我对它有很多美好的回忆。所以，我"}]
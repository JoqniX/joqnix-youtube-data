[{"type": "subtitle", "time": 1680.71, "timestamp": "00:28:00", "text": "这肯定会很有趣。"}, {"type": "subtitle", "time": 1684.31, "timestamp": "00:28:04", "text": "呃，你好吗？真吓人。在此"}, {"type": "subtitle", "time": 1686.87, "timestamp": "00:28:06", "text": "游戏里有很多突然吓人的桥段，我"}, {"type": "subtitle", "time": 1689.35, "timestamp": "00:28:09", "text": "喜欢"}, {"type": "subtitle", "time": 1693.029, "timestamp": "00:28:13", "text": "那充满活力、觉察力强的东西拥抱着你"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "然后还有那个令人毛骨悚然的小孩。你"}, {"type": "subtitle", "time": 1698.95, "timestamp": "00:28:18", "text": "你完全可以揍那个孩子一顿。我的意思是，如果"}, {"type": "subtitle", "time": 1701.99, "timestamp": "00:28:21", "text": "你们有不止两个玩家，"}, {"type": "subtitle", "time": 1704.63, "timestamp": "00:28:24", "text": "就像我和我的朋友们一样，我们"}, {"type": "subtitle", "time": 1707.51, "timestamp": "00:28:27", "text": "就像把它扔来扔去一样。是的，我们"}, {"type": "chat", "time": 1707.777, "timestamp": "00:28:27", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yo"}, {"type": "subtitle", "time": 1710.07, "timestamp": "00:28:30", "text": "杀死了婴儿。"}, {"type": "subtitle", "time": 1717.269, "timestamp": "00:28:37", "text": "我不知道我当时过得很艰难。"}, {"type": "subtitle", "time": 1719.83, "timestamp": "00:28:39", "text": "眼睛那玩意儿就像我能看见一样"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "大多数时候，我死在了眼睛里。"}, {"type": "subtitle", "time": 1727.269, "timestamp": "00:28:47", "text": "是的，是的"}, {"type": "subtitle", "time": 1729.75, "timestamp": "00:28:49", "text": "邀请您"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "你在那里"}]
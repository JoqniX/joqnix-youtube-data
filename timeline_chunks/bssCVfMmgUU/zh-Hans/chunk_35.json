[{"type": "subtitle", "time": 2101.03, "timestamp": "00:35:01", "text": "你好。你好。这是怎么回事？我是吗？我不是吗？"}, {"type": "subtitle", "time": 2103.19, "timestamp": "00:35:03", "text": "可听见的？是的。是的，你能行。它是"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "现在开始游戏。你必须靠近"}, {"type": "subtitle", "time": 2108.79, "timestamp": "00:35:08", "text": "让你听到你打字的声音。哦，是哦，"}, {"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "你好。你到底是什么人？什么是"}, {"type": "subtitle", "time": 2115.51, "timestamp": "00:35:15", "text": "你？它是绿色的吗？哦，我是我是"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "白色的。"}, {"type": "subtitle", "time": 2122.55, "timestamp": "00:35:22", "text": "我是什么颜色的？你也是白人。"}, {"type": "subtitle", "time": 2125.51, "timestamp": "00:35:25", "text": "我想要那个东西。我可以改。我"}, {"type": "subtitle", "time": 2127.829, "timestamp": "00:35:27", "text": "能"}, {"type": "subtitle", "time": 2130.47, "timestamp": "00:35:30", "text": "哦，你可以改的。"}, {"type": "subtitle", "time": 2135.349, "timestamp": "00:35:35", "text": "是的。它在哪里？哦，粉色。哦，那是"}, {"type": "subtitle", "time": 2143.19, "timestamp": "00:35:43", "text": "我是粉色的还是不是粉色的？哦，你是"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "粉色的。是的。是的。"}]
[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "现在。我想养大比利比利"}, {"type": "subtitle", "time": 9783.75, "timestamp": "02:43:03", "text": "频道等等，做了很多"}, {"type": "subtitle", "time": 9788.23, "timestamp": "02:43:08", "text": "因为我想在那里直播。"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "我喜欢在那里看直播。"}, {"type": "subtitle", "time": 9795.59, "timestamp": "02:43:15", "text": "我会竭尽全力去实现这个目标。"}, {"type": "subtitle", "time": 9798.389, "timestamp": "02:43:18", "text": "再去那里直播。"}, {"type": "subtitle", "time": 9800.389, "timestamp": "02:43:20", "text": "是的。"}, {"type": "chat", "time": 9803.557, "timestamp": "02:43:23", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "again ?"}, {"type": "subtitle", "time": 9804.15, "timestamp": "02:43:24", "text": "就是这样。然后，"}, {"type": "subtitle", "time": 9805.83, "timestamp": "02:43:25", "text": "嗯"}, {"type": "subtitle", "time": 9808.95, "timestamp": "02:43:28", "text": "实际上有很多事情，因为我"}, {"type": "subtitle", "time": 9811.75, "timestamp": "02:43:31", "text": "不必担心"}, {"type": "subtitle", "time": 9814.63, "timestamp": "02:43:34", "text": "因为我不需要在那里直播。"}, {"type": "subtitle", "time": 9816.71, "timestamp": "02:43:36", "text": "再次。是的，我的无线网络断了。你"}, {"type": "subtitle", "time": 9819.67, "timestamp": "02:43:39", "text": "需要无线网络才能向中国传输视频流。"}, {"type": "subtitle", "time": 9823.99, "timestamp": "02:43:43", "text": "流水线才能相信。他们不允许"}, {"type": "subtitle", "time": 9826.55, "timestamp": "02:43:46", "text": "印度人喜欢来自该地区的外国人。他们确实如此"}, {"type": "subtitle", "time": 9828.95, "timestamp": "02:43:48", "text": "不允许外国人入境。你必须拥有一个"}, {"type": "subtitle", "time": 9831.75, "timestamp": "02:43:51", "text": "特定白名单。要么你必须"}, {"type": "subtitle", "time": 9834.309, "timestamp": "02:43:54", "text": "加入代理机构并获得白名单"}, {"type": "chat", "time": 9835.879, "timestamp": "02:43:55", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "how did ya lost it"}, {"type": "subtitle", "time": 9836.309, "timestamp": "02:43:56", "text": "在它们下面。利用机构资源"}]
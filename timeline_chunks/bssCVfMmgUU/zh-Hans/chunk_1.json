[{"type": "subtitle", "time": 62.549, "timestamp": "00:01:02", "text": "由于缺乏免疫力，很容易生病。"}, {"type": "subtitle", "time": 66.07, "timestamp": "00:01:06", "text": "我猜也是。呃，所以"}, {"type": "subtitle", "time": 70.71000000000001, "timestamp": "00:01:10", "text": "我想让我的身体得到喂养"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "呃，回到今天的录音话题……"}, {"type": "subtitle", "time": 83.27, "timestamp": "00:01:23", "text": "做过。好的。所以，跑步这件事是"}, {"type": "subtitle", "time": 87.03, "timestamp": "00:01:27", "text": "好的。呃，你能清楚地听到我和你说话。"}, {"type": "subtitle", "time": 90.31, "timestamp": "00:01:30", "text": "能听到我跺脚的声音，"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "轻微的“呃呃”脚步声。"}, {"type": "subtitle", "time": 96.71000000000001, "timestamp": "00:01:36", "text": "但问题出在我……"}, {"type": "subtitle", "time": 98.31, "timestamp": "00:01:38", "text": "小型摩托车，"}, {"type": "subtitle", "time": 100.71000000000001, "timestamp": "00:01:40", "text": "车辆噪音、指示灯噪音"}, {"type": "subtitle", "time": 103.67, "timestamp": "00:01:43", "text": "喇叭声，呃，周围的车"}, {"type": "subtitle", "time": 106.38900000000001, "timestamp": "00:01:46", "text": "噪音，呃，车辆噪音。是的。所以，"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "音频变得呃"}, {"type": "subtitle", "time": 112.789, "timestamp": "00:01:52", "text": "如果用我制作人的术语来说，那就是 Gome，但是"}, {"type": "subtitle", "time": 116.469, "timestamp": "00:01:56", "text": "它有点像那种该怎么称呼它呢？"}]
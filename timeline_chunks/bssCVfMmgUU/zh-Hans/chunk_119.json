[{"type": "subtitle", "time": 7140.95, "timestamp": "01:59:00", "text": "呃，"}, {"type": "subtitle", "time": 7144.95, "timestamp": "01:59:04", "text": "鲍比，不。不。为什么？他们为什么利用她"}, {"type": "subtitle", "time": 7147.99, "timestamp": "01:59:07", "text": "姓名？我不知道。这真是太"}, {"type": "subtitle", "time": 7152.47, "timestamp": "01:59:12", "text": "压力很大。看看我打破的"}, {"type": "subtitle", "time": 7154.229, "timestamp": "01:59:14", "text": "老板"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "我的天哪。我不知道。"}, {"type": "subtitle", "time": 7161.51, "timestamp": "01:59:21", "text": "我们需要把握时机。为什么会玩这个游戏？"}, {"type": "subtitle", "time": 7171.35, "timestamp": "01:59:31", "text": "好的。所以，你们是怎么做的？我们是怎么做的？"}, {"type": "subtitle", "time": 7174.87, "timestamp": "01:59:34", "text": "我们不停地冲刺、冲刺、跳跃。"}, {"type": "subtitle", "time": 7185.99, "timestamp": "01:59:45", "text": "让我输入"}, {"type": "subtitle", "time": 7194.79, "timestamp": "01:59:54", "text": "好的。所以，呃，我就说……"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "去做。过来。我只想说，去做吧。"}, {"type": "subtitle", "time": 7199.75, "timestamp": "01:59:59", "text": "抓住"}]
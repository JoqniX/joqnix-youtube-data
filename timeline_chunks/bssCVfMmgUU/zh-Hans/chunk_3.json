[{"type": "subtitle", "time": 180.07, "timestamp": "00:03:00", "text": "好了，我回来了。我回来了。呃，如果你是"}, {"type": "subtitle", "time": 182.47, "timestamp": "00:03:02", "text": "直播的时候，会是我，呃，就像"}, {"type": "subtitle", "time": 185.75, "timestamp": "00:03:05", "text": "呃，我会像这样开始直播……"}, {"type": "subtitle", "time": 188.869, "timestamp": "00:03:08", "text": "在我家，然后设置了 OBS，"}, {"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "一切，就像……得到一切"}, {"type": "subtitle", "time": 194.39, "timestamp": "00:03:14", "text": "准备好了，你马上就会听到。"}, {"type": "subtitle", "time": 197.43, "timestamp": "00:03:17", "text": "我打开车库门，然后就像"}, {"type": "subtitle", "time": 199.67000000000002, "timestamp": "00:03:19", "text": "把我的踏板车推到外面的路上"}, {"type": "subtitle", "time": 202.55, "timestamp": "00:03:22", "text": "而且我很喜欢做这样的设置。所以，将会是"}, {"type": "subtitle", "time": 205.03, "timestamp": "00:03:25", "text": "就像我们会去一样"}, {"type": "subtitle", "time": 209.43, "timestamp": "00:03:29", "text": "嗯，我们走吧，我们开车。"}, {"type": "subtitle", "time": 212.949, "timestamp": "00:03:32", "text": "呃，去步行的地方。我把车停好"}, {"type": "subtitle", "time": 217.75, "timestamp": "00:03:37", "text": "车辆。我把我的东西放进去，比如什么麦克风"}, {"type": "subtitle", "time": 221.11, "timestamp": "00:03:41", "text": "额外的麦克风，还有那个适配器之类的东西。"}, {"type": "subtitle", "time": 223.43, "timestamp": "00:03:43", "text": "一切。这就是我的想法。"}, {"type": "subtitle", "time": 225.50900000000001, "timestamp": "00:03:45", "text": "我不得不把钱包里所有东西都装进水里。"}, {"type": "subtitle", "time": 229.75, "timestamp": "00:03:49", "text": "把所有东西都装进瓶子里，放在后备箱上。"}, {"type": "subtitle", "time": 232.07, "timestamp": "00:03:52", "text": "可爱的。等等，那是储藏区"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "踏板车或自行车。是的。我得走了"}, {"type": "subtitle", "time": 237.99, "timestamp": "00:03:57", "text": "空空如也。空的。"}]
[{"type": "subtitle", "time": 6065.6, "timestamp": "01:41:05", "text": "跳。跳。跳。哦，不。不。不。A。所以 关闭。就差一点。就差一点。就差一点。"}, {"type": "subtitle", "time": 6068.96, "timestamp": "01:41:08", "text": "关闭。就差一点。就差一点。就差一点。 我的天啊。不。"}, {"type": "subtitle", "time": 6071.44, "timestamp": "01:41:11", "text": "我的天啊。不。 没关系。没关系。来。来。去。"}, {"type": "subtitle", "time": 6072.96, "timestamp": "01:41:12", "text": "没关系。没关系。来。来。去。 去。去。去。去。去。去。去。去。"}, {"type": "subtitle", "time": 6081.91, "timestamp": "01:41:21", "text": "我们能让他加速吗？我的天啊。为什么是我"}, {"type": "subtitle", "time": 6094.709, "timestamp": "01:41:34", "text": "好的。跳。"}, {"type": "subtitle", "time": 6108.23, "timestamp": "01:41:48", "text": "改变。"}, {"type": "subtitle", "time": 6109.99, "timestamp": "01:41:49", "text": "[音乐]"}, {"type": "subtitle", "time": 6112.95, "timestamp": "01:41:52", "text": "好了，我走了。"}]
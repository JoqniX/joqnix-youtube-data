[{"type": "subtitle", "time": 720.87, "timestamp": "00:12:00", "text": "从未想过视频驱动的东西"}, {"type": "subtitle", "time": 723.509, "timestamp": "00:12:03", "text": "在那之前，我哥哥建议我……"}, {"type": "subtitle", "time": 725.829, "timestamp": "00:12:05", "text": "如果你不想展示你的"}, {"type": "subtitle", "time": 729.43, "timestamp": "00:12:09", "text": "你可能会像杀死一个PNG角色一样面对它"}, {"type": "subtitle", "time": 741.35, "timestamp": "00:12:21", "text": "这就是我入行的大致过程。"}, {"type": "subtitle", "time": 743.509, "timestamp": "00:12:23", "text": "那很好。"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "哇。真好。你的兄弟是"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "一位虚拟主播粉丝。这也太酷了吧。我 我"}, {"type": "subtitle", "time": 753.91, "timestamp": "00:12:33", "text": "会说就像我哥哥一样"}, {"type": "subtitle", "time": 757.59, "timestamp": "00:12:37", "text": "YouTuber粉丝。他确实会关注他喜欢的东西"}, {"type": "subtitle", "time": 760.31, "timestamp": "00:12:40", "text": "直播之类的。好像我什么都没有似的"}, {"type": "subtitle", "time": 762.71, "timestamp": "00:12:42", "text": "关于 Twitch 的想法，就像……"}, {"type": "subtitle", "time": 765.11, "timestamp": "00:12:45", "text": "他做了很多，因为他也喜欢玩游戏。"}, {"type": "subtitle", "time": 767.35, "timestamp": "00:12:47", "text": "我基本上是因为以下原因才开始玩游戏的："}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "他"}, {"type": "subtitle", "time": 771.91, "timestamp": "00:12:51", "text": "东西。是的。"}, {"type": "subtitle", "time": 775.59, "timestamp": "00:12:55", "text": "我以前不玩游戏。他就是那种人"}]
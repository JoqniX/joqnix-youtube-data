[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "[音乐]"}, {"type": "subtitle", "time": 4984.47, "timestamp": "01:23:04", "text": "你加入游戏后请告诉我。患病的"}, {"type": "subtitle", "time": 4998.44, "timestamp": "01:23:18", "text": "游戏。"}, {"type": "subtitle", "time": 5001.27, "timestamp": "01:23:21", "text": "[音乐]"}, {"type": "subtitle", "time": 5003.27, "timestamp": "01:23:23", "text": "等等，等等。你想，你想做"}, {"type": "subtitle", "time": 5010.95, "timestamp": "01:23:30", "text": "猜猜平均值。"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "妊娠。那是什么？"}, {"type": "subtitle", "time": 5016.07, "timestamp": "01:23:36", "text": "如何？是啊，就像你花了多少钱一样。"}, {"type": "subtitle", "time": 5020.149, "timestamp": "01:23:40", "text": "知道？就像脑腐烂一样"}, {"type": "subtitle", "time": 5022.55, "timestamp": "01:23:42", "text": "你对它了解多少？脑腐烂"}, {"type": "subtitle", "time": 5025.83, "timestamp": "01:23:45", "text": "梦想。如果我记得"}, {"type": "subtitle", "time": 5031.11, "timestamp": "01:23:51", "text": "嗯，扎娜的儿子扎娜教了我这个"}]
[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "所以，我不得不把手机绑在……"}, {"type": "subtitle", "time": 243.35, "timestamp": "00:04:03", "text": "我的肘部。等待。弯头。不。手臂。等待。"}, {"type": "subtitle", "time": 246.55, "timestamp": "00:04:06", "text": "不。手。不。那该怎么称呼呢？"}, {"type": "subtitle", "time": 249.50900000000001, "timestamp": "00:04:09", "text": "你这东西的一部分？呃，做什么"}, {"type": "subtitle", "time": 251.91, "timestamp": "00:04:11", "text": "你管那叫灵活运用"}, {"type": "subtitle", "time": 253.50900000000001, "timestamp": "00:04:13", "text": "你的肌肉之类的？那是什么？"}, {"type": "subtitle", "time": 256.469, "timestamp": "00:04:16", "text": "身体的哪个部分又被叫作？手臂。"}, {"type": "subtitle", "time": 259.189, "timestamp": "00:04:19", "text": "不，手臂指的是整条手臂。不。不。手。"}, {"type": "subtitle", "time": 262.15, "timestamp": "00:04:22", "text": "不。然后就是等待，你怎么办？"}, {"type": "subtitle", "time": 264.629, "timestamp": "00:04:24", "text": "那叫什么？上臂。是的。谢谢。"}, {"type": "subtitle", "time": 268.23, "timestamp": "00:04:28", "text": "上臂。是的。所以，我得把……"}, {"type": "subtitle", "time": 271.749, "timestamp": "00:04:31", "text": "我上臂上好像有个东西。因为如果"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "我把它戴在手腕上，就像我戴着​​我的"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "像我们以前通常做的那样观看"}, {"type": "subtitle", "time": 280.95, "timestamp": "00:04:40", "text": "步行溪流。问题在于何时"}, {"type": "subtitle", "time": 283.749, "timestamp": "00:04:43", "text": "我在慢跑，感觉就像出发了一样"}, {"type": "subtitle", "time": 287.03, "timestamp": "00:04:47", "text": "像B一样，也喜欢摇晃过度。但"}, {"type": "subtitle", "time": 290.469, "timestamp": "00:04:50", "text": "问题是，目前唯一的问题是"}, {"type": "subtitle", "time": 294.23, "timestamp": "00:04:54", "text": "我将无法阅读聊天记录。什么"}, {"type": "subtitle", "time": 297.59000000000003, "timestamp": "00:04:57", "text": "我可以聊天吗？"}]
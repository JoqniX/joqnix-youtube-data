[{"type": "subtitle", "time": 2.71, "timestamp": "00:00:02", "text": "讲故事这套东西彻底崩坏了，对吧？"}, {"type": "subtitle", "time": 5.269, "timestamp": "00:00:05", "text": "现在我很兴奋。对不起。我是"}, {"type": "subtitle", "time": 7.67, "timestamp": "00:00:07", "text": "还在研究中。如果你正在经历"}, {"type": "subtitle", "time": 9.75, "timestamp": "00:00:09", "text": "训练弧线，我们最终能练出六块腹肌吗？"}, {"type": "chat", "time": 10.234, "timestamp": "00:00:10", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight's Guest - Clemency | https://x.com/duhitsclem | https://www.youtube.com/@Clemency_rig... | https://www.instagram.com/clemency_th... "}, {"type": "subtitle", "time": 12.15, "timestamp": "00:00:12", "text": "腹肌版的Jock？"}, {"type": "subtitle", "time": 16.39, "timestamp": "00:00:16", "text": "我想知道"}, {"type": "subtitle", "time": 26.55, "timestamp": "00:00:26", "text": "因为呃，我不是，我是，我简直太超级了"}, {"type": "subtitle", "time": 29.509, "timestamp": "00:00:29", "text": "瘦弱，而且如果人们看到我，他们会……"}, {"type": "subtitle", "time": 32.63, "timestamp": "00:00:32", "text": "就像吃点东西一样，你为什么？你为什么？"}, {"type": "subtitle", "time": 36.229, "timestamp": "00:00:36", "text": "不吃食物"}, {"type": "subtitle", "time": 39.51, "timestamp": "00:00:39", "text": "他们就是这么说的，所以我不懂性。"}, {"type": "subtitle", "time": 41.75, "timestamp": "00:00:41", "text": "等等"}, {"type": "subtitle", "time": 46.31, "timestamp": "00:00:46", "text": "我的意思是，健康的身体就等于良好的"}, {"type": "subtitle", "time": 49.83, "timestamp": "00:00:49", "text": "心态和良好的心态，也许吧。"}, {"type": "subtitle", "time": 51.91, "timestamp": "00:00:51", "text": "不，我不想"}, {"type": "subtitle", "time": 54.069, "timestamp": "00:00:54", "text": "至少要记住六个事实。我只想拥有我的身体"}, {"type": "subtitle", "time": 56.15, "timestamp": "00:00:56", "text": "保持健康"}, {"type": "subtitle", "time": 58.549, "timestamp": "00:00:58", "text": "因为我太容易……了"}]
[{"type": "subtitle", "time": 17164.628, "timestamp": "04:46:04", "text": "时刻"}, {"type": "subtitle", "time": 17170.788, "timestamp": "04:46:10", "text": "来自各种类型"}, {"type": "subtitle", "time": 17173.11, "timestamp": "04:46:13", "text": "杂七杂八"}, {"type": "subtitle", "time": 17175.11, "timestamp": "04:46:15", "text": "他们"}, {"type": "subtitle", "time": 17177.27, "timestamp": "04:46:17", "text": "显示这些"}, {"type": "subtitle", "time": 17179.43, "timestamp": "04:46:19", "text": "这些人，"}, {"type": "subtitle", "time": 17184.948, "timestamp": "04:46:24", "text": "这些嗯，贯穿这些贯穿"}, {"type": "subtitle", "time": 17187.03, "timestamp": "04:46:27", "text": "溪流，"}, {"type": "subtitle", "time": 17188.948, "timestamp": "04:46:28", "text": "我觉得我应该做点什么，比如"}, {"type": "subtitle", "time": 17193.03, "timestamp": "04:46:33", "text": "这是第100天。不过现在是第91天。"}, {"type": "subtitle", "time": 17195.19, "timestamp": "04:46:35", "text": "我应该这样做吗？我觉得我应该这样做。"}, {"type": "subtitle", "time": 17197.27, "timestamp": "04:46:37", "text": "应该在第100天发布，或者"}, {"type": "subtitle", "time": 17199.83, "timestamp": "04:46:39", "text": "某物。但我还是得打赌。"}, {"type": "subtitle", "time": 17202.628, "timestamp": "04:46:42", "text": "等等，今天是92岁。"}, {"type": "subtitle", "time": 17209.03, "timestamp": "04:46:49", "text": "92 93 94 95 96 97 98 99 100 第 19 名"}, {"type": "subtitle", "time": 17218.708, "timestamp": "04:46:58", "text": "[音乐]"}]
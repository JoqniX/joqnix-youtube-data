[{"type": "subtitle", "time": 1263.11, "timestamp": "00:21:03", "text": "一年内完成整个N2项目"}, {"type": "subtitle", "time": 1265.75, "timestamp": "00:21:05", "text": "他们就是这么说的。所以从接下来开始"}, {"type": "subtitle", "time": 1268.95, "timestamp": "00:21:08", "text": "从下个月开始我的N4课程，所以"}, {"type": "subtitle", "time": 1277.43, "timestamp": "00:21:17", "text": "但是，对，我还有这个Joathon的东西。"}, {"type": "subtitle", "time": 1286.23, "timestamp": "00:21:26", "text": "祝你好运，你一定能行。耶。"}, {"type": "subtitle", "time": 1289.669, "timestamp": "00:21:29", "text": "嗯，所以……"}, {"type": "subtitle", "time": 1291.909, "timestamp": "00:21:31", "text": "目前为止你最喜欢的游戏是什么？"}, {"type": "subtitle", "time": 1300.31, "timestamp": "00:21:40", "text": "就像我开始直播的时候一样"}, {"type": "subtitle", "time": 1302.549, "timestamp": "00:21:42", "text": "比如主要玩原神。然后我"}, {"type": "subtitle", "time": 1305.43, "timestamp": "00:21:45", "text": "《守望先锋2》发售时我简直着迷了。"}, {"type": "subtitle", "time": 1308.549, "timestamp": "00:21:48", "text": "就这样。我以为我擅长"}, {"type": "subtitle", "time": 1312.47, "timestamp": "00:21:52", "text": "直到我交到朋友，我才开始玩《守望先锋2》。"}, {"type": "subtitle", "time": 1315.75, "timestamp": "00:21:55", "text": "他们就像在嘲讽我有多糟糕一样。"}]
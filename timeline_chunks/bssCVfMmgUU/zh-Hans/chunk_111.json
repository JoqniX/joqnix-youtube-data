[{"type": "subtitle", "time": 6667.35, "timestamp": "01:51:07", "text": "哦，我们得一起跳。我的天哪。"}, {"type": "subtitle", "time": 6669.03, "timestamp": "01:51:09", "text": "呃。哦，等等。等等，等等，等等。我认为"}, {"type": "subtitle", "time": 6671.75, "timestamp": "01:51:11", "text": "是短跑和跳跃。"}, {"type": "subtitle", "time": 6675.43, "timestamp": "01:51:15", "text": "好的。待在拐角处。"}, {"type": "subtitle", "time": 6677.59, "timestamp": "01:51:17", "text": "不要跳。我会冲刺和跳跃。好的。"}, {"type": "subtitle", "time": 6679.99, "timestamp": "01:51:19", "text": "去。去。走到旁边去。好的。好的。"}, {"type": "subtitle", "time": 6685.03, "timestamp": "01:51:25", "text": "好的。好的。好的。你好。三、二、一。"}, {"type": "subtitle", "time": 6686.629, "timestamp": "01:51:26", "text": "你好。跳。跳。跳。跳。跳。跳。"}, {"type": "subtitle", "time": 6689.92, "timestamp": "01:51:29", "text": "跳。跳。跳。跳。跳。跳。 我们成功了。"}, {"type": "subtitle", "time": 6692.719, "timestamp": "01:51:32", "text": "我们成功了。 这不是结束。"}, {"type": "subtitle", "time": 6695.119, "timestamp": "01:51:35", "text": "这不是结束。 还有更多。"}]
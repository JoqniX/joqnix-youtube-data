[{"type": "subtitle", "time": 2280.95, "timestamp": "00:38:00", "text": "是的，你可以看到那里的物品。所以，"}, {"type": "subtitle", "time": 2284.39, "timestamp": "00:38:04", "text": "你所能做的就是……但也许我可以"}, {"type": "subtitle", "time": 2290.31, "timestamp": "00:38:10", "text": "让你向上。呃，按Q键。"}, {"type": "subtitle", "time": 2296.39, "timestamp": "00:38:16", "text": "是的，我会把你放在那个位置。"}, {"type": "subtitle", "time": 2304.069, "timestamp": "00:38:24", "text": "你看到什么可以买的东西了吗？"}, {"type": "subtitle", "time": 2308.47, "timestamp": "00:38:28", "text": "我什么也看不见。什么也没有。还没结束"}, {"type": "subtitle", "time": 2311.99, "timestamp": "00:38:31", "text": "这里。你可以上去。是的，你"}, {"type": "subtitle", "time": 2319.75, "timestamp": "00:38:39", "text": "嗯，别在意。尽量起床"}, {"type": "subtitle", "time": 2328.71, "timestamp": "00:38:48", "text": "我差点就来找你了。啊，"}, {"type": "subtitle", "time": 2332.39, "timestamp": "00:38:52", "text": "让我计时。"}, {"type": "subtitle", "time": 2338.87, "timestamp": "00:38:58", "text": "我完全没想到我们能发射升空。"}]
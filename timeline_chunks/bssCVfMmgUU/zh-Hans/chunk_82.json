[{"type": "subtitle", "time": 4921.35, "timestamp": "01:22:01", "text": "罗布乐思？"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "Roblox 的门。我试过了。"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "然后是祷告环节。我做到了。和"}, {"type": "subtitle", "time": 4931.91, "timestamp": "01:22:11", "text": "你最害怕的是什么？"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "那些事中最让我害怕的是什么？这"}, {"type": "subtitle", "time": 4937.43, "timestamp": "01:22:17", "text": "是那个令人毛骨悚然的火柴人吗？"}, {"type": "subtitle", "time": 4942.95, "timestamp": "01:22:22", "text": "还有那个巨大的怪物，呃，悄悄靠近。"}, {"type": "subtitle", "time": 4944.95, "timestamp": "01:22:24", "text": "悄悄靠近你，还有那份恩典"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "所有的一切。嗯，是的。"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "我忘了所有的一切"}, {"type": "subtitle", "time": 4954.87, "timestamp": "01:22:34", "text": "那些怪物确实存在，但没错，就是这样。"}, {"type": "subtitle", "time": 4957.75, "timestamp": "01:22:37", "text": "现在节奏太快了，所以你很容易忘记……"}, {"type": "subtitle", "time": 4961.91, "timestamp": "01:22:41", "text": "有点儿，但也算是吧。"}, {"type": "subtitle", "time": 4964.47, "timestamp": "01:22:44", "text": "我的天啊，为什么有人会制作恐怖游戏？"}, {"type": "subtitle", "time": 4972.79, "timestamp": "01:22:52", "text": "是啊，这样人们就可以玩游戏，然后玩得很烂。"}, {"type": "subtitle", "time": 4976.149, "timestamp": "01:22:56", "text": "在游戏中就像是“是的”。去他妈的其他人"}, {"type": "subtitle", "time": 4978.55, "timestamp": "01:22:58", "text": "虽然是游戏，但我仍然会玩。我不知道"}, {"type": "subtitle", "time": 4979.77, "timestamp": "01:22:59", "text": "为什么。"}]
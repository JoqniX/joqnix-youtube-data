[{"type": "subtitle", "time": 8281.11, "timestamp": "02:18:01", "text": "尽管。在你离开之前，你"}, {"type": "subtitle", "time": 8282.95, "timestamp": "02:18:02", "text": "有什么要宣布的吗？"}, {"type": "subtitle", "time": 8286.309, "timestamp": "02:18:06", "text": "更新或其他任何你想说的"}, {"type": "subtitle", "time": 8289.19, "timestamp": "02:18:09", "text": "分享？"}, {"type": "subtitle", "time": 8292.79, "timestamp": "02:18:12", "text": "哦，我不认为我当初计划的那样……"}, {"type": "subtitle", "time": 8296.389, "timestamp": "02:18:16", "text": "自从我开始直播以来，我的直播就一直很火爆。"}, {"type": "subtitle", "time": 8300.79, "timestamp": "02:18:20", "text": "笔记本电脑。呃，我计划练习一下。"}, {"type": "subtitle", "time": 8305.349, "timestamp": "02:18:25", "text": "我很快会开始弹吉他。哦，是的。"}, {"type": "subtitle", "time": 8308.389, "timestamp": "02:18:28", "text": "我看过你的Instagram账号了。"}, {"type": "subtitle", "time": 8310.469, "timestamp": "02:18:30", "text": "在那里你可以唱歌和弹吉他。它"}, {"type": "subtitle", "time": 8313.589, "timestamp": "02:18:33", "text": "太好了，我的天哪，我"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "正在尝试。我还在学习。"}, {"type": "subtitle", "time": 8317.509, "timestamp": "02:18:37", "text": "[音乐]"}, {"type": "subtitle", "time": 8319.75, "timestamp": "02:18:39", "text": "你应该在直播中多这样做。"}, {"type": "subtitle", "time": 8323.99, "timestamp": "02:18:43", "text": "出色地。肯定会很棒。我迫不及待地想"}, {"type": "subtitle", "time": 8325.83, "timestamp": "02:18:45", "text": "YouTube 是为 YouTube 而生的。但是，你呢？"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "上传过翻唱歌曲了吗？"}, {"type": "subtitle", "time": 8331.589, "timestamp": "02:18:51", "text": "我还没上传过我的吉他照片。"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "因为我什么都没学到。"}, {"type": "subtitle", "time": 8338.87, "timestamp": "02:18:58", "text": "它就像几个和弦，而不是像……"}]
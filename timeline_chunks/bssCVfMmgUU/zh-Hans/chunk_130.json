[{"type": "subtitle", "time": 7802.229, "timestamp": "02:10:02", "text": "Jenn，她在你手下的工作太棒了！"}, {"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "死了。这意味着什么？等等，是"}, {"type": "subtitle", "time": 7811.99, "timestamp": "02:10:11", "text": "难道我真的不知道吗？我不知道。"}, {"type": "subtitle", "time": 7815.83, "timestamp": "02:10:15", "text": "我该怎么解释呢？我"}, {"type": "subtitle", "time": 7817.669, "timestamp": "02:10:17", "text": "有"}, {"type": "subtitle", "time": 7827.189, "timestamp": "02:10:27", "text": "基本上，这里下面的人都死了。啊，"}, {"type": "chat", "time": 7828.997, "timestamp": "02:10:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "like hair dyed under but a layer of natural hair is over the dyed hair"}, {"type": "subtitle", "time": 7829.109, "timestamp": "02:10:29", "text": "在“哦，是的”下面。是的。在你的之下"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "非常好。我的天啊。"}, {"type": "subtitle", "time": 7835.91, "timestamp": "02:10:35", "text": "哦，是的，我喜欢。就像染发剂一样"}, {"type": "subtitle", "time": 7838.069, "timestamp": "02:10:38", "text": "好的。好的。但我有一头卷发"}, {"type": "subtitle", "time": 7841.189, "timestamp": "02:10:41", "text": "那样看起来会很糟糕。"}, {"type": "subtitle", "time": 7844.55, "timestamp": "02:10:44", "text": "哦，我也是。卷发帮。"}, {"type": "subtitle", "time": 7849.03, "timestamp": "02:10:49", "text": "我们走吧。过来。我们走吧。"}, {"type": "subtitle", "time": 7854.229, "timestamp": "02:10:54", "text": "我的个人风格真的很酷。"}]
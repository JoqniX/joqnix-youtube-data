[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "从爱好到阅读等等。哦，"}, {"type": "subtitle", "time": 607.75, "timestamp": "00:10:07", "text": "呃呃，那虚拟教学呢？你一直"}, {"type": "subtitle", "time": 609.43, "timestamp": "00:10:09", "text": "流媒体？哦，是的。我认为你一直"}, {"type": "subtitle", "time": 611.509, "timestamp": "00:10:11", "text": "是流媒体吗？"}, {"type": "subtitle", "time": 614.87, "timestamp": "00:10:14", "text": "是的。但是因为我没有太多东西。"}, {"type": "subtitle", "time": 618.47, "timestamp": "00:10:18", "text": "设置好了，所以我一直没直播。"}, {"type": "subtitle", "time": 620.9, "timestamp": "00:10:20", "text": "似乎还有几个月。"}, {"type": "subtitle", "time": 624.389, "timestamp": "00:10:24", "text": "[音乐]"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "所以，我希望是给我们的。我一直"}, {"type": "subtitle", "time": 629.509, "timestamp": "00:10:29", "text": "好奇的。"}, {"type": "subtitle", "time": 631.75, "timestamp": "00:10:31", "text": "你的另一个怎么样了？为什么"}, {"type": "subtitle", "time": 635.43, "timestamp": "00:10:35", "text": "你变成橙色了吗？"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "发生了什么？你转世了吗？"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "女巫。呃，所以那东西是个女巫。我"}, {"type": "subtitle", "time": 646.71, "timestamp": "00:10:46", "text": "我觉得她很友善。她诅咒了我。"}, {"type": "subtitle", "time": 650.949, "timestamp": "00:10:50", "text": "而我现在变成了一个橙子。哦，不。我"}, {"type": "subtitle", "time": 654.31, "timestamp": "00:10:54", "text": "不知道如何变回外星人"}, {"type": "subtitle", "time": 657.03, "timestamp": "00:10:57", "text": "再次。"}]
[{"type": "subtitle", "time": 7441.43, "timestamp": "02:04:01", "text": "哦，"}, {"type": "subtitle", "time": 7443.27, "timestamp": "02:04:03", "text": "我死了。没关系。没关系。我得到了"}, {"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "我们走吧。"}, {"type": "subtitle", "time": 7453.51, "timestamp": "02:04:13", "text": "我的天啊。我们是怎么做到的？我们开始吧"}, {"type": "subtitle", "time": 7456.07, "timestamp": "02:04:16", "text": "关闭。"}, {"type": "subtitle", "time": 7461.27, "timestamp": "02:04:21", "text": "我只是轻轻敲了敲W。"}, {"type": "subtitle", "time": 7498.95, "timestamp": "02:04:58", "text": "带着十字架。他们过河了吗？"}]
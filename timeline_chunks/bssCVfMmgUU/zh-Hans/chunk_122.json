[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "哦，对，我只要狂按跳跃键就能看到。所以"}, {"type": "subtitle", "time": 7326.31, "timestamp": "02:02:06", "text": "我们必须把握好时机，对吧？哦，我的"}, {"type": "subtitle", "time": 7328.39, "timestamp": "02:02:08", "text": "上帝。把握好时机。我认为我们必须"}, {"type": "subtitle", "time": 7338.07, "timestamp": "02:02:18", "text": "好的，过来。回去"}, {"type": "subtitle", "time": 7340.79, "timestamp": "02:02:20", "text": "就我而言。"}, {"type": "subtitle", "time": 7345.51, "timestamp": "02:02:25", "text": "好的，按住Shift键。好的。好的。"}, {"type": "subtitle", "time": 7348.709, "timestamp": "02:02:28", "text": "三。你知道吗？我们可以在这里，"}, {"type": "subtitle", "time": 7350.709, "timestamp": "02:02:30", "text": "然后跳下去。"}, {"type": "subtitle", "time": 7359.43, "timestamp": "02:02:39", "text": "数数。"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "好的。数数。正确的。所以，三个。我们走"}, {"type": "subtitle", "time": 7364.39, "timestamp": "02:02:44", "text": "其中一个来自"}, {"type": "subtitle", "time": 7370.229, "timestamp": "02:02:50", "text": "顶部。三。二。一。跳。啊。"}, {"type": "subtitle", "time": 7373.03, "timestamp": "02:02:53", "text": "几乎。几乎。几乎全部。啊。"}, {"type": "subtitle", "time": 7375.91, "timestamp": "02:02:55", "text": "哦。没关系。没关系。没关系。尝试"}, {"type": "subtitle", "time": 7378.55, "timestamp": "02:02:58", "text": "朝着“是”的方向走去。是的。是的。"}]
[{"type": "subtitle", "time": 16442.551, "timestamp": "04:34:02", "text": "已转移至 206 年 4 月。"}, {"type": "subtitle", "time": 16445.029, "timestamp": "04:34:05", "text": "哦，这样可行。"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "我的国家。"}, {"type": "subtitle", "time": 16453.99, "timestamp": "04:34:13", "text": "虽然我一开始就提到过我"}, {"type": "subtitle", "time": 16456.551, "timestamp": "04:34:16", "text": "Jakathon 将于 6 月中旬结束。"}, {"type": "subtitle", "time": 16459.51, "timestamp": "04:34:19", "text": "因为我会在七月份取消六月份的行程，但是"}, {"type": "subtitle", "time": 16462.629, "timestamp": "04:34:22", "text": "幸运的是，我的七月过得很顺利，感谢上帝。"}, {"type": "subtitle", "time": 16469.75, "timestamp": "04:34:29", "text": "取消并转移到呃"}, {"type": "subtitle", "time": 16472.789, "timestamp": "04:34:32", "text": "这件事就发生在我的国家。这"}, {"type": "subtitle", "time": 16475.189, "timestamp": "04:34:35", "text": "这意味着"}, {"type": "subtitle", "time": 16483.59, "timestamp": "04:34:43", "text": "等等，我们数数六月、七月和八月吧。"}, {"type": "subtitle", "time": 16485.59, "timestamp": "04:34:45", "text": "九月 十月 十一月 十二月"}, {"type": "subtitle", "time": 16488.551, "timestamp": "04:34:48", "text": "一月 二月 三月"}]
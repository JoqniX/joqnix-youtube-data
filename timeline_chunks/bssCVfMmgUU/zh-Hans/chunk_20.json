[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "这件事现在发生在印度。印度巴基斯坦"}, {"type": "subtitle", "time": 1202.95, "timestamp": "00:20:02", "text": "因为今天我的学院打电话"}, {"type": "subtitle", "time": 1205.99, "timestamp": "00:20:05", "text": "让我和家人喜欢开会，"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "其他应该去的学生"}, {"type": "subtitle", "time": 1210.95, "timestamp": "00:20:10", "text": "呃，下个月的入学申请，七月份的入学申请。"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "他们说他们有点像JP"}, {"type": "subtitle", "time": 1216.31, "timestamp": "00:20:16", "text": "日本学校他们有点……"}, {"type": "subtitle", "time": 1219.11, "timestamp": "00:20:19", "text": "取消或推迟了这件事"}, {"type": "subtitle", "time": 1224.71, "timestamp": "00:20:24", "text": "与移民有关。所以他们说呃呃呃"}, {"type": "subtitle", "time": 1228.71, "timestamp": "00:20:28", "text": "他们说推迟到2026年4月。"}, {"type": "subtitle", "time": 1232.07, "timestamp": "00:20:32", "text": "我当时就想，“哇。”我当时已经准备好了"}, {"type": "subtitle", "time": 1235.029, "timestamp": "00:20:35", "text": "好像我把一切都准备好了。"}, {"type": "subtitle", "time": 1238.87, "timestamp": "00:20:38", "text": "就像现在这样，“哦，我必须……”"}, {"type": "subtitle", "time": 1241.029, "timestamp": "00:20:41", "text": "“在这里待六个月。”"}, {"type": "subtitle", "time": 1242.789, "timestamp": "00:20:42", "text": "是的。"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "我现在必须在这里待8个月。哦"}, {"type": "subtitle", "time": 1248.63, "timestamp": "00:20:48", "text": "但他们说他们会给我呃"}, {"type": "subtitle", "time": 1251.35, "timestamp": "00:20:51", "text": "课程，下一阶段的课程"}, {"type": "subtitle", "time": 1253.59, "timestamp": "00:20:53", "text": "自由的。所以我现在算是赶上了。"}, {"type": "subtitle", "time": 1256.149, "timestamp": "00:20:56", "text": "一切。嗯，既然我要去那里。"}, {"type": "subtitle", "time": 1258.47, "timestamp": "00:20:58", "text": "现在像这样学习，我可以轻松地"}]
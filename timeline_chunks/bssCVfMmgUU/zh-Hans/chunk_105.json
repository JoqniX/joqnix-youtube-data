[{"type": "subtitle", "time": 6301.59, "timestamp": "01:45:01", "text": "等待。什么？"}, {"type": "subtitle", "time": 6303.35, "timestamp": "01:45:03", "text": "是的。没关系。没关系。跳下去。"}, {"type": "subtitle", "time": 6306.149, "timestamp": "01:45:06", "text": "跳。跳上去 不要跳上去"}, {"type": "subtitle", "time": 6308.31, "timestamp": "01:45:08", "text": "东西。只是"}, {"type": "subtitle", "time": 6311.03, "timestamp": "01:45:11", "text": "我觉得我可以。"}, {"type": "subtitle", "time": 6313.99, "timestamp": "01:45:13", "text": "兄弟，我为什么会被困在这里？我可以"}, {"type": "subtitle", "time": 6317.03, "timestamp": "01:45:17", "text": "可以拉动它。是的。是的。试着拉一下。尝试"}, {"type": "subtitle", "time": 6320.629, "timestamp": "01:45:20", "text": "拉一下试试。我可以告诉你，"}, {"type": "subtitle", "time": 6324.39, "timestamp": "01:45:24", "text": "没有显示。"}, {"type": "subtitle", "time": 6326.79, "timestamp": "01:45:26", "text": "这是什么游戏？哦，我被困住了。"}, {"type": "subtitle", "time": 6337.83, "timestamp": "01:45:37", "text": "我要出去。是的。哦，等等，等等。"}, {"type": "subtitle", "time": 6342.39, "timestamp": "01:45:42", "text": "等等，等等，等等，等等。试试拉我。"}, {"type": "subtitle", "time": 6344.79, "timestamp": "01:45:44", "text": "哦，是的。我想我打算"}, {"type": "subtitle", "time": 6348.229, "timestamp": "01:45:48", "text": "跳。好了，我们走吧。"}, {"type": "subtitle", "time": 6357.27, "timestamp": "01:45:57", "text": "走吧，我们出发。"}]
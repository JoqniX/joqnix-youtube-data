[{"type": "subtitle", "time": 5161.51, "timestamp": "01:26:01", "text": "[音乐]"}, {"type": "subtitle", "time": 5164.31, "timestamp": "01:26:04", "text": "你想尝试什么？我很好"}, {"type": "subtitle", "time": 5167.51, "timestamp": "01:26:07", "text": "随心所欲地做任何事，比如"}, {"type": "subtitle", "time": 5170.47, "timestamp": "01:26:10", "text": "等待。哦，你在里面，好的，等等。患病的"}, {"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "加入游戏。你正在猜测"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "梗图之类的东西。是的，我就是这个意思。"}, {"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "说道。你拥有多少表情包？"}, {"type": "subtitle", "time": 5180.47, "timestamp": "01:26:20", "text": "知识？我对梗的了解为零。"}, {"type": "subtitle", "time": 5182.709, "timestamp": "01:26:22", "text": "实际上，"}, {"type": "subtitle", "time": 5186.149, "timestamp": "01:26:26", "text": "让我们来看看。我很兴奋地想看看能有多少"}, {"type": "subtitle", "time": 5195.51, "timestamp": "01:26:35", "text": "你好。糟糕，你来了。是的。"}, {"type": "subtitle", "time": 5199.11, "timestamp": "01:26:39", "text": "好的。一秒钟。"}, {"type": "subtitle", "time": 5208.229, "timestamp": "01:26:48", "text": "哦。罗布乐思"}, {"type": "subtitle", "time": 5217.75, "timestamp": "01:26:57", "text": "它现在应该随时都能捕捉到时间。"}, {"type": "subtitle", "time": 5219.669, "timestamp": "01:26:59", "text": "请调高音量开始游戏。"}]
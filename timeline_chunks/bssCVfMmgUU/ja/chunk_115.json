[{"type": "subtitle", "time": 6900.07, "timestamp": "01:55:00", "text": "いや、待って。私は思う"}, {"type": "subtitle", "time": 6902.95, "timestamp": "01:55:02", "text": "上階へ上がる方法がある。ここからジャンプできます"}, {"type": "subtitle", "time": 6909.91, "timestamp": "01:55:09", "text": "私たちは起き上がることができる。"}, {"type": "subtitle", "time": 6912.87, "timestamp": "01:55:12", "text": "私たちはもっと上を目指すべきだと思う。"}, {"type": "subtitle", "time": 6922.95, "timestamp": "01:55:22", "text": "転ばないで。"}, {"type": "subtitle", "time": 6925.51, "timestamp": "01:55:25", "text": "はい、できますよ。"}, {"type": "subtitle", "time": 6933.589, "timestamp": "01:55:33", "text": "わかった。"}, {"type": "subtitle", "time": 6941.99, "timestamp": "01:55:41", "text": "ああ、なんてことだ。私はこれが嫌いだ。私はこれが嫌いだ。私はしません"}, {"type": "subtitle", "time": 6943.99, "timestamp": "01:55:43", "text": "今、それを覚えておいてください。今思い出した。"}, {"type": "subtitle", "time": 6946.39, "timestamp": "01:55:46", "text": "なぜあなたが"}]
[{"type": "subtitle", "time": 180.07, "timestamp": "00:03:00", "text": "はい、戻ってきました。戻ってきました。えっと、もしあなたが"}, {"type": "subtitle", "time": 182.47, "timestamp": "00:03:02", "text": "ストリーム配信をするのは私です。"}, {"type": "subtitle", "time": 185.75, "timestamp": "00:03:05", "text": "えーっと、ストリームは次のように始めます"}, {"type": "subtitle", "time": 188.869, "timestamp": "00:03:08", "text": "私の家でOBSをセットアップして"}, {"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "すべてを手に入れて"}, {"type": "subtitle", "time": 194.39, "timestamp": "00:03:14", "text": "準備はできています、そして私は文字通りあなたが聞くことになるでしょう"}, {"type": "subtitle", "time": 197.43, "timestamp": "00:03:17", "text": "私がガレージのゲートを開けると、"}, {"type": "subtitle", "time": 199.67000000000002, "timestamp": "00:03:19", "text": "スクーターを道路に出す"}, {"type": "subtitle", "time": 202.55, "timestamp": "00:03:22", "text": "そして、その設定をするのが好きなんです。だから、"}, {"type": "subtitle", "time": 205.03, "timestamp": "00:03:25", "text": "まるで私たちが行くように"}, {"type": "subtitle", "time": 209.43, "timestamp": "00:03:29", "text": "えっと、車で行きます"}, {"type": "subtitle", "time": 212.949, "timestamp": "00:03:32", "text": "ええと、歩いて行く場所へ。私は駐車します"}, {"type": "subtitle", "time": 217.75, "timestamp": "00:03:37", "text": "車両。私は自分のものをマイクのように入れた"}, {"type": "subtitle", "time": 221.11, "timestamp": "00:03:41", "text": "追加のマイク、アダプター、そして"}, {"type": "subtitle", "time": 223.43, "timestamp": "00:03:43", "text": "すべて。それが私の考えです。"}, {"type": "subtitle", "time": 225.50900000000001, "timestamp": "00:03:45", "text": "私は財布の中のもの全てを水に浸さなければならなかった"}, {"type": "subtitle", "time": 229.75, "timestamp": "00:03:49", "text": "トランクの上にボトルを全部置いておく。"}, {"type": "subtitle", "time": 232.07, "timestamp": "00:03:52", "text": "かわいい。待って、それは"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "スクーターか自転車。うん。そして私は行かなければならない"}, {"type": "subtitle", "time": 237.99, "timestamp": "00:03:57", "text": "空っぽのようだ。空の。"}]
[{"type": "subtitle", "time": 12240.55, "timestamp": "03:24:00", "text": "セレクターマクロを作成してフォルダに保存します"}, {"type": "subtitle", "time": 12243.67, "timestamp": "03:24:03", "text": "このような。さあ、始めてみよう。だから何"}, {"type": "subtitle", "time": 12246.229, "timestamp": "03:24:06", "text": "私が話しているときに何が起こるかというと、"}, {"type": "subtitle", "time": 12249.99, "timestamp": "03:24:09", "text": "見せないで、私が話していないとき"}, {"type": "subtitle", "time": 12253.03, "timestamp": "03:24:13", "text": "それは現れたり、隠れたりする。さあさあ見てみよう"}, {"type": "subtitle", "time": 12256.389, "timestamp": "03:24:16", "text": "あなたは今、正しい効果を得ています"}, {"type": "subtitle", "time": 12258.55, "timestamp": "03:24:18", "text": "どうすれば均等にできるか教えてあげよう"}, {"type": "subtitle", "time": 12260.07, "timestamp": "03:24:20", "text": "より良い。"}, {"type": "subtitle", "time": 12263.11, "timestamp": "03:24:23", "text": "アクティブ状態に移行する。非アクティブなし"}, {"type": "subtitle", "time": 12269.11, "timestamp": "03:24:29", "text": "時間を指定できる状態です。わかった。 F"}, {"type": "subtitle", "time": 12273.19, "timestamp": "03:24:33", "text": "Fオーディオが私のマイクで、出力が"}, {"type": "chat", "time": 12277.26, "timestamp": "03:24:37", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hey btw have you watched danplan if yes how much"}, {"type": "subtitle", "time": 12277.83, "timestamp": "03:24:37", "text": "ボリューム出力ボリュームはゼロです"}, {"type": "subtitle", "time": 12280.389, "timestamp": "03:24:40", "text": "10秒"}, {"type": "subtitle", "time": 12288.95, "timestamp": "03:24:48", "text": "うん。"}, {"type": "subtitle", "time": 12294.15, "timestamp": "03:24:54", "text": "えっと、ちょっと待ってください、1分だけ時間をください。"}, {"type": "subtitle", "time": 12297.83, "timestamp": "03:24:57", "text": "わかった。少なくとも1分間はLex 1を使用してください。"}]
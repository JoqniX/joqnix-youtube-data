[{"type": "subtitle", "time": 13440.389, "timestamp": "03:44:00", "text": "DNDを試すのが待ちきれない"}, {"type": "subtitle", "time": 13443.189, "timestamp": "03:44:03", "text": "いくつかの"}, {"type": "subtitle", "time": 13447.189, "timestamp": "03:44:07", "text": "早く試してみたい 早くやってみたい"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "[音楽]"}, {"type": "subtitle", "time": 13462.55, "timestamp": "03:44:22", "text": "問題は、彼女の2番目の名前が"}, {"type": "subtitle", "time": 13465.83, "timestamp": "03:44:25", "text": "2番目の姓は少し難しい"}, {"type": "subtitle", "time": 13468.229, "timestamp": "03:44:28", "text": "私にとってはそうだったので、私はそれを口に出さなかった"}, {"type": "subtitle", "time": 13470.95, "timestamp": "03:44:30", "text": "大声で言ったのは、彼女に台無しにされたくなかったからだ。"}, {"type": "subtitle", "time": 13473.91, "timestamp": "03:44:33", "text": "あまり失礼な言い方はしたくないんです。それで"}, {"type": "subtitle", "time": 13476.79, "timestamp": "03:44:36", "text": "私は彼女をイタリア人と呼んだが、そうならないことを願う"}, {"type": "subtitle", "time": 13479.429, "timestamp": "03:44:39", "text": "過度に。"}, {"type": "subtitle", "time": 13495.83, "timestamp": "03:44:55", "text": "それから"}, {"type": "subtitle", "time": 13498.469, "timestamp": "03:44:58", "text": "夜に向かって。"}]
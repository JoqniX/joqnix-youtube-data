[{"type": "subtitle", "time": 5051.43, "timestamp": "01:24:11", "text": "聞こえますか？こんにちは。うん。"}, {"type": "subtitle", "time": 5055.43, "timestamp": "01:24:15", "text": "ついに。ああ、なんてことだ、インターネットが死んだ。"}, {"type": "subtitle", "time": 5058.47, "timestamp": "01:24:18", "text": "それで、私がストリーミング配信を始めたときに何が起こったかというと"}, {"type": "subtitle", "time": 5060.79, "timestamp": "01:24:20", "text": "この24時間、そして今はすべて、"}, {"type": "subtitle", "time": 5062.629, "timestamp": "01:24:22", "text": "Vアップロードをダウンロードする必要があります"}, {"type": "subtitle", "time": 5065.75, "timestamp": "01:24:25", "text": "すべて。だからもしもし、えっと、私は"}, {"type": "subtitle", "time": 5069.35, "timestamp": "01:24:29", "text": "ジオファイバーの30MBプランをチャージしました。"}, {"type": "subtitle", "time": 5072.229, "timestamp": "01:24:32", "text": "今。だから、最初に充電した"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "その月になると期限切れになります。全て"}, {"type": "subtitle", "time": 5079.43, "timestamp": "01:24:39", "text": "データは期限切れです"}, {"type": "subtitle", "time": 5082.55, "timestamp": "01:24:42", "text": "無制限。どうやって終わったのか分からない"}, {"type": "subtitle", "time": 5086.229, "timestamp": "01:24:46", "text": "データ。それで大丈夫です。うん、書いてある通り"}, {"type": "subtitle", "time": 5089.99, "timestamp": "01:24:49", "text": "無制限。データは無制限ですが、"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "データの処理をすべて終えました。だから、"}, {"type": "subtitle", "time": 5094.709, "timestamp": "01:24:54", "text": "赤色で表示されています。だから、買わなければならなかった"}, {"type": "subtitle", "time": 5097.91, "timestamp": "01:24:57", "text": "また買います。ありがたいことに、私はこう考えました"}]
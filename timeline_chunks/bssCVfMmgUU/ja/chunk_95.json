[{"type": "subtitle", "time": 5700.95, "timestamp": "01:35:00", "text": "わかった。では、どうぞ。いいえ。何ですか？わかった。"}, {"type": "subtitle", "time": 5711.43, "timestamp": "01:35:11", "text": "わかった。待って。 １、２、１、１、２。"}, {"type": "subtitle", "time": 5713.669, "timestamp": "01:35:13", "text": "わかった。"}, {"type": "subtitle", "time": 5716.31, "timestamp": "01:35:16", "text": "何てことだ。"}, {"type": "subtitle", "time": 5734.31, "timestamp": "01:35:34", "text": "こっちにトイレみたいなのがあるよ。なぜ"}, {"type": "subtitle", "time": 5738.149, "timestamp": "01:35:38", "text": "こっちにトイレはありますか？"}, {"type": "subtitle", "time": 5740.229, "timestamp": "01:35:40", "text": "これらは何ですか？これらは無料のものですか？"}, {"type": "subtitle", "time": 5756.87, "timestamp": "01:35:56", "text": "あ、待って。"}, {"type": "subtitle", "time": 5759.11, "timestamp": "01:35:59", "text": "でも、私はそれを着ています。待って、私は着ることができます"}]
[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "めちゃくちゃ魅力的だ。"}, {"type": "subtitle", "time": 7683.51, "timestamp": "02:08:03", "text": "わからない。うん、彼は"}, {"type": "subtitle", "time": 7685.75, "timestamp": "02:08:05", "text": "ただ待っている"}, {"type": "subtitle", "time": 7693.669, "timestamp": "02:08:13", "text": "手のために。"}, {"type": "chat", "time": 7695.173, "timestamp": "02:08:15", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaA"}, {"type": "subtitle", "time": 7696.55, "timestamp": "02:08:16", "text": "えっと、手用です。えっと"}, {"type": "subtitle", "time": 7698.709, "timestamp": "02:08:18", "text": "h"}, {"type": "subtitle", "time": 7701.669, "timestamp": "02:08:21", "text": "それは何と呼ばれますか？"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "手用ですか？"}, {"type": "subtitle", "time": 7707.589, "timestamp": "02:08:27", "text": "ああ、例えば、手が、"}, {"type": "subtitle", "time": 7710.95, "timestamp": "02:08:30", "text": "可愛い手袋とか、そういうもの。いいえ"}, {"type": "subtitle", "time": 7713.27, "timestamp": "02:08:33", "text": "それはとても綺麗ですね。"}, {"type": "subtitle", "time": 7715.669, "timestamp": "02:08:35", "text": "うん。"}, {"type": "subtitle", "time": 7719.83, "timestamp": "02:08:39", "text": "私も最近その動画を見ました"}, {"type": "subtitle", "time": 7721.43, "timestamp": "02:08:41", "text": "手作り"}, {"type": "subtitle", "time": 7725.27, "timestamp": "02:08:45", "text": "手袋とそれ"}, {"type": "subtitle", "time": 7727.83, "timestamp": "02:08:47", "text": "もう一度見つけてください。お送りします。その"}, {"type": "subtitle", "time": 7730.709, "timestamp": "02:08:50", "text": "とてもとても綺麗です。"}, {"type": "subtitle", "time": 7733.51, "timestamp": "02:08:53", "text": "はい。はい。そして私は美しいものを見たい"}, {"type": "subtitle", "time": 7738.31, "timestamp": "02:08:58", "text": "[音楽]"}]
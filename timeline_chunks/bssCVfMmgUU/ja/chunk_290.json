[{"type": "subtitle", "time": 17400.628, "timestamp": "04:50:00", "text": "えーと、配信回数が限られているなど。"}, {"type": "subtitle", "time": 17402.708, "timestamp": "04:50:02", "text": "えっと"}, {"type": "subtitle", "time": 17406.708, "timestamp": "04:50:06", "text": "限られた流れ、限られた流れ。"}, {"type": "subtitle", "time": 17412.07, "timestamp": "04:50:12", "text": "私はこれからも最善を尽くします"}, {"type": "subtitle", "time": 17417.03, "timestamp": "04:50:17", "text": "それで"}, {"type": "subtitle", "time": 17420.23, "timestamp": "04:50:20", "text": "私が"}, {"type": "subtitle", "time": 17430.23, "timestamp": "04:50:30", "text": "ええと、続けます。私は止まらない"}, {"type": "subtitle", "time": 17433.11, "timestamp": "04:50:33", "text": "私がそこにいる間は、静けさが保たれる。"}, {"type": "subtitle", "time": 17435.51, "timestamp": "04:50:35", "text": "そして"}, {"type": "subtitle", "time": 17447.51, "timestamp": "04:50:47", "text": "これらすべて、"}, {"type": "subtitle", "time": 17452.55, "timestamp": "04:50:52", "text": "これらすべては、これらすべては、すべて"}, {"type": "subtitle", "time": 17455.43, "timestamp": "04:50:55", "text": "この"}]
[{"type": "subtitle", "time": 6487.83, "timestamp": "01:48:07", "text": "ジャンプ。"}, {"type": "subtitle", "time": 6491.109, "timestamp": "01:48:11", "text": "ああ、これは嫌いじゃないよ。ああ、嫌いだ"}, {"type": "subtitle", "time": 6498.79, "timestamp": "01:48:18", "text": "わかった。"}, {"type": "subtitle", "time": 6504.31, "timestamp": "01:48:24", "text": "ああ、私は死んだ。私は、"}, {"type": "subtitle", "time": 6519.35, "timestamp": "01:48:39", "text": "ああ、私たちは待てますよ。待つことはできます。"}, {"type": "subtitle", "time": 6520.79, "timestamp": "01:48:40", "text": "大丈夫。大丈夫。大丈夫。その"}, {"type": "subtitle", "time": 6522.31, "timestamp": "01:48:42", "text": "わかった。"}, {"type": "subtitle", "time": 6526.229, "timestamp": "01:48:46", "text": "何てことだ。どうやって生きているんだ？調子はどうですか"}, {"type": "subtitle", "time": 6530.31, "timestamp": "01:48:50", "text": "生きてるの？わかった。来る。来る。来る。来る。"}, {"type": "subtitle", "time": 6531.59, "timestamp": "01:48:51", "text": "登る。登る。登る。登る。登る。"}]
[{"type": "subtitle", "time": 8343.99, "timestamp": "02:19:03", "text": "歌。ええ、今取り組んでいます。えっと"}, {"type": "subtitle", "time": 8347.75, "timestamp": "02:19:07", "text": "うん、頑張ってね。あなたの幸運を祈っています。"}, {"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "私も楽器を習うべきだ。"}, {"type": "subtitle", "time": 8352.95, "timestamp": "02:19:12", "text": "うん、どれを選べばいいのか分からない。"}, {"type": "subtitle", "time": 8355.19, "timestamp": "02:19:15", "text": "ギターか何か？ピアノ？私はしません"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "知る。"}, {"type": "subtitle", "time": 8360.15, "timestamp": "02:19:20", "text": "ピアノを弾いてみてください。私たちはバンドを組むことができなかった。"}, {"type": "subtitle", "time": 8362.07, "timestamp": "02:19:22", "text": "うん、"}, {"type": "subtitle", "time": 8366.87, "timestamp": "02:19:26", "text": "さあ行こう。ピアノ。バンド演奏もいいかもしれない。"}, {"type": "subtitle", "time": 8369.99, "timestamp": "02:19:29", "text": "ええ、MIDIキーボードは持っていますよ。しかし、"}, {"type": "subtitle", "time": 8372.87, "timestamp": "02:19:32", "text": "問題は、ソフトウェアを見つけなければならないということです。"}, {"type": "subtitle", "time": 8375.669, "timestamp": "02:19:35", "text": "ピアノを接続して学ぶことができます"}, {"type": "subtitle", "time": 8378.95, "timestamp": "02:19:38", "text": "ソフトウェアを使って一緒に学ぶのが好きです。"}, {"type": "subtitle", "time": 8381.91, "timestamp": "02:19:41", "text": "いや、そういう類のものではない。それは"}, {"type": "subtitle", "time": 8385.03, "timestamp": "02:19:45", "text": "痛み。まあ、どこかで解決策を見つけるよ"}, {"type": "subtitle", "time": 8391.91, "timestamp": "02:19:51", "text": "ええ、今日はありがとうございました。"}, {"type": "subtitle", "time": 8394.309, "timestamp": "02:19:54", "text": "もっと一緒に過ごせたらいいな"}, {"type": "subtitle", "time": 8396.389, "timestamp": "02:19:56", "text": "未来。ええ、8時までここにいます"}, {"type": "subtitle", "time": 8399.27, "timestamp": "02:19:59", "text": "もう数ヶ月になります。もし私がそうだったら"}]
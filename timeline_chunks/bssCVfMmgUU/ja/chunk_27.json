[{"type": "subtitle", "time": 1622.47, "timestamp": "00:27:02", "text": "レポかヴァレリンか？どれ？ Robloxも"}, {"type": "subtitle", "time": 1625.51, "timestamp": "00:27:05", "text": "オプションがあります。私たちはできないと思います私は"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "３つすべて。どういう意味ですか？"}, {"type": "subtitle", "time": 1630.87, "timestamp": "00:27:10", "text": "コイントスは？"}, {"type": "subtitle", "time": 1634.789, "timestamp": "00:27:14", "text": "わからない。のように"}, {"type": "subtitle", "time": 1642.39, "timestamp": "00:27:22", "text": "リポジトリはどうですか？"}, {"type": "subtitle", "time": 1647.19, "timestamp": "00:27:27", "text": "レポをプレイすることもできるけど、君に任せるよ。私は悪い"}, {"type": "subtitle", "time": 1650.47, "timestamp": "00:27:30", "text": "その試合で。まあ、私たちは最善を尽くしますよ。"}, {"type": "subtitle", "time": 1657.99, "timestamp": "00:27:37", "text": "私はホラーが苦手なので、"}, {"type": "subtitle", "time": 1663.59, "timestamp": "00:27:43", "text": "待って、あなたはホラーが好きですか？"}, {"type": "subtitle", "time": 1667.43, "timestamp": "00:27:47", "text": "私はホラーが好きです。何？"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "私はホラーが好きです。これはこれだと思います"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "楽しそうだ。何てことだ、"}]
[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "[音楽]"}, {"type": "subtitle", "time": 4984.47, "timestamp": "01:23:04", "text": "ゲームに参加したら教えてください。病気"}, {"type": "subtitle", "time": 4998.44, "timestamp": "01:23:18", "text": "ゲーム。"}, {"type": "subtitle", "time": 5001.27, "timestamp": "01:23:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5003.27, "timestamp": "01:23:23", "text": "待って、待って。あなたはあなたがしたいこと"}, {"type": "subtitle", "time": 5010.95, "timestamp": "01:23:30", "text": "平均値を推測してください。"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "ゲスティン。それは何ですか？"}, {"type": "subtitle", "time": 5016.07, "timestamp": "01:23:36", "text": "どうやって？うん、どれくらい"}, {"type": "subtitle", "time": 5020.149, "timestamp": "01:23:40", "text": "知る？脳の腐敗とは"}, {"type": "subtitle", "time": 5022.55, "timestamp": "01:23:42", "text": "それについてどれくらい知っていますか？脳の腐敗"}, {"type": "subtitle", "time": 5025.83, "timestamp": "01:23:45", "text": "夢。もし私が覚えていたら"}, {"type": "subtitle", "time": 5031.11, "timestamp": "01:23:51", "text": "えっと、ザナの息子ザナがこれについて教えてくれた"}]
[{"type": "subtitle", "time": 16512.39, "timestamp": "04:35:12", "text": "では、1、2、3と順番に並んでください。"}, {"type": "subtitle", "time": 16517.59, "timestamp": "04:35:17", "text": "4 5 6 7 8 9 10 11"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "つまり、私には11ヶ月の猶予があるということだ"}, {"type": "subtitle", "time": 16522.789, "timestamp": "04:35:22", "text": "私と一緒に。"}, {"type": "subtitle", "time": 16528.709, "timestamp": "04:35:28", "text": "だから私はそうではなかった"}, {"type": "subtitle", "time": 16531.67, "timestamp": "04:35:31", "text": "できなかった"}, {"type": "subtitle", "time": 16537.59, "timestamp": "04:35:37", "text": "ジョアトンの目標を達成するために"}, {"type": "subtitle", "time": 16541.91, "timestamp": "04:35:41", "text": "えっと、資金援助のために地元の人に連絡してください"}, {"type": "subtitle", "time": 16552.551, "timestamp": "04:35:52", "text": "モデルI 私は"}, {"type": "subtitle", "time": 16554.15, "timestamp": "04:35:54", "text": "続く"}, {"type": "subtitle", "time": 16557.99, "timestamp": "04:35:57", "text": "行う"}]
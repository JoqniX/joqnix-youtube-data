[{"type": "subtitle", "time": 361.43, "timestamp": "00:06:01", "text": "あまり凝ったものにしないで。それが1つ目の点です"}, {"type": "subtitle", "time": 363.67, "timestamp": "00:06:03", "text": "あまりにも。みんなが私を見ていた。私は"}, {"type": "subtitle", "time": 367.029, "timestamp": "00:06:07", "text": "他人の視線を気にして"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "あまりにも。それはまた、"}, {"type": "subtitle", "time": 372.79, "timestamp": "00:06:12", "text": "私が慣れようとしていること"}, {"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "えっと、このトレーニングをしている間は"}, {"type": "subtitle", "time": 377.909, "timestamp": "00:06:17", "text": "私が毎日自分で録画しているアーク"}, {"type": "subtitle", "time": 379.99, "timestamp": "00:06:19", "text": "話せる相手もいないし、"}, {"type": "subtitle", "time": 382.469, "timestamp": "00:06:22", "text": "配信とか、そういうこと全部のためのトレーニング。"}, {"type": "subtitle", "time": 385.59, "timestamp": "00:06:25", "text": "最近はこんな感じ"}, {"type": "subtitle", "time": 387.99, "timestamp": "00:06:27", "text": "うん、いつでも自分のレコードから"}, {"type": "subtitle", "time": 390.629, "timestamp": "00:06:30", "text": "家は今、通り過ぎていく"}, {"type": "subtitle", "time": 393.189, "timestamp": "00:06:33", "text": "による"}, {"type": "subtitle", "time": 396.39, "timestamp": "00:06:36", "text": "人々は、彼らが見ているもの、すごい"}, {"type": "subtitle", "time": 399.67, "timestamp": "00:06:39", "text": "この男はよく喋る"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "英語で彼は英語で話しています"}, {"type": "subtitle", "time": 404.30899999999997, "timestamp": "00:06:44", "text": "彼はそうしているし、彼らはそれを見て"}, {"type": "subtitle", "time": 414.30899999999997, "timestamp": "00:06:54", "text": "質問は、はい。たくさんのもの"}, {"type": "subtitle", "time": 416.30899999999997, "timestamp": "00:06:56", "text": "プライバシーなど"}]
[{"type": "subtitle", "time": 5161.51, "timestamp": "01:26:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5164.31, "timestamp": "01:26:04", "text": "えっと、何を試してみたいですか？元気です"}, {"type": "subtitle", "time": 5167.51, "timestamp": "01:26:07", "text": "あなたが望むものなら何でも、"}, {"type": "subtitle", "time": 5170.47, "timestamp": "01:26:10", "text": "待って。ああ、あなたはオーケー、待って。病気"}, {"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "ゲームに参加しよう。あなたは推測の中にいます"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "ミームみたいなもの。ええ、それが私の"}, {"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "と言っている。ミームはどれくらいありますか"}, {"type": "subtitle", "time": 5180.47, "timestamp": "01:26:20", "text": "知識？ミームに関する知識はゼロです。"}, {"type": "subtitle", "time": 5182.709, "timestamp": "01:26:22", "text": "実は、"}, {"type": "subtitle", "time": 5186.149, "timestamp": "01:26:26", "text": "見てみましょう。どれだけ"}, {"type": "subtitle", "time": 5195.51, "timestamp": "01:26:35", "text": "こんにちは。あら、あなたがここにいらっしゃったんですね。うん。"}, {"type": "subtitle", "time": 5199.11, "timestamp": "01:26:39", "text": "わかった。 1秒。"}, {"type": "subtitle", "time": 5208.229, "timestamp": "01:26:48", "text": "おお。ロブロックス"}, {"type": "subtitle", "time": 5217.75, "timestamp": "01:26:57", "text": "もうすぐ撮影できるはずだ。"}, {"type": "subtitle", "time": 5219.669, "timestamp": "01:26:59", "text": "ゲームをプレイするには音量を上げてください。"}]
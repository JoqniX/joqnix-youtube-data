[{"type": "subtitle", "time": 17822.788, "timestamp": "04:57:02", "text": "[音楽]"}, {"type": "subtitle", "time": 17831.19, "timestamp": "04:57:11", "text": "えっと、もし"}, {"type": "subtitle", "time": 17836.07, "timestamp": "04:57:16", "text": "苦労を止めろ、この苦労を止めろ。"}, {"type": "subtitle", "time": 17841.43, "timestamp": "04:57:21", "text": "私は日本に行きます。まるでその男のようだ"}, {"type": "subtitle", "time": 17844.39, "timestamp": "04:57:24", "text": "aは新型モデル用だった"}, {"type": "subtitle", "time": 17846.39, "timestamp": "04:57:26", "text": "そして、私はそれを正しく行いたいのです。付け加えたい"}, {"type": "subtitle", "time": 17852.15, "timestamp": "04:57:32", "text": "正しい方法で、そして正しく行う"}, {"type": "subtitle", "time": 17864.868, "timestamp": "04:57:44", "text": "そしてそれが私が知っている唯一の方法です"}, {"type": "subtitle", "time": 17867.99, "timestamp": "04:57:47", "text": "もの。だから、私はそれを続け、"}, {"type": "subtitle", "time": 17870.07, "timestamp": "04:57:50", "text": "短い時間で戻ってくるかどうか疑わしい"}, {"type": "subtitle", "time": 17872.788, "timestamp": "04:57:52", "text": "ストリーム"}, {"type": "subtitle", "time": 17874.65, "timestamp": "04:57:54", "text": "短い"}, {"type": "subtitle", "time": 17875.83, "timestamp": "04:57:55", "text": "[音楽]"}]
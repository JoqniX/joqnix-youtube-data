[{"type": "subtitle", "time": 13103.51, "timestamp": "03:38:23", "text": "夕方に、"}, {"type": "subtitle", "time": 13108.6, "timestamp": "03:38:28", "text": "もしかしたら私たちはコラボレーションしていたのかもしれません"}, {"type": "subtitle", "time": 13117.67, "timestamp": "03:38:37", "text": "初めて一緒に時間を過ごして話をした"}, {"type": "subtitle", "time": 13123.67, "timestamp": "03:38:43", "text": "これまで。私たちはサブブームを通じて知り合ったのですが"}, {"type": "subtitle", "time": 13129.59, "timestamp": "03:38:49", "text": "グループでの共同作業を通じて。良い、"}, {"type": "subtitle", "time": 13134.63, "timestamp": "03:38:54", "text": "えーと、これは実際には私たちの、これは私たちの"}, {"type": "subtitle", "time": 13136.309, "timestamp": "03:38:56", "text": "初め"}, {"type": "subtitle", "time": 13139.67, "timestamp": "03:38:59", "text": "適切な相互作用"}]
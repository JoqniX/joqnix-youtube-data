[{"type": "subtitle", "time": 6667.35, "timestamp": "01:51:07", "text": "ああ、一緒にジャンプしなくちゃ。ああ、神様。"}, {"type": "subtitle", "time": 6669.03, "timestamp": "01:51:09", "text": "えっと。あ、待って。待って、待って、待って。私は思う"}, {"type": "subtitle", "time": 6671.75, "timestamp": "01:51:11", "text": "短距離走とジャンプだ。"}, {"type": "subtitle", "time": 6675.43, "timestamp": "01:51:15", "text": "わかった。角にある宿泊施設に滞在してください。"}, {"type": "subtitle", "time": 6677.59, "timestamp": "01:51:17", "text": "飛び降りないで。私は全力疾走してジャンプする。わかった。"}, {"type": "subtitle", "time": 6679.99, "timestamp": "01:51:19", "text": "行く。行く。横へ移動してください。わかった。わかった。"}, {"type": "subtitle", "time": 6685.03, "timestamp": "01:51:25", "text": "わかった。わかった。わかった。こんにちは。 ３、２、１。"}, {"type": "subtitle", "time": 6686.629, "timestamp": "01:51:26", "text": "こんにちは。ジャンプ。ジャンプ。ジャンプ。ジャンプ。ジャンプ。ジャンプ。"}, {"type": "subtitle", "time": 6689.92, "timestamp": "01:51:29", "text": "ジャンプ。ジャンプ。ジャンプ。ジャンプ。ジャンプ。ジャンプ。 やったぞ。"}, {"type": "subtitle", "time": 6692.719, "timestamp": "01:51:32", "text": "やったぞ。 これは終わりではない。"}, {"type": "subtitle", "time": 6695.119, "timestamp": "01:51:35", "text": "これは終わりではない。 まだ続きがあります。"}]
[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "ああ、神様。何てことだ。君には当たってないよ。"}, {"type": "subtitle", "time": 1987.59, "timestamp": "00:33:07", "text": "何てことだ。彼が来る。どこかに行って。ごめん。"}, {"type": "subtitle", "time": 1994.63, "timestamp": "00:33:14", "text": "こんにちは、魚さん。ちょっと待って。それは"}, {"type": "subtitle", "time": 2003.269, "timestamp": "00:33:23", "text": "よし。こんにちは。"}, {"type": "subtitle", "time": 2016.389, "timestamp": "00:33:36", "text": "ゲストショップ。いいえ。ショップ。"}, {"type": "subtitle", "time": 2020.389, "timestamp": "00:33:40", "text": "お店を探してください。買い物。馬力はどれくらいですか"}, {"type": "subtitle", "time": 2024.149, "timestamp": "00:33:44", "text": "あなたが持っている？ああ、もうお腹いっぱいです。お腹がいっぱいです"}, {"type": "subtitle", "time": 2026.149, "timestamp": "00:33:46", "text": "実は。"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "わかった。だから、あなたには響かないのです。"}, {"type": "subtitle", "time": 2031.669, "timestamp": "00:33:51", "text": "何が欲しいですか？いくつか手に入れることができます"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "アップグレードの可能性もある。"}, {"type": "subtitle", "time": 2038.22, "timestamp": "00:33:58", "text": "全く分からない。そのためには、具体的に何が必要なのでしょうか？"}]
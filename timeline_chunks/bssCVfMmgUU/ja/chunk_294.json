[{"type": "subtitle", "time": 17650.948, "timestamp": "04:54:10", "text": "そして私は"}, {"type": "subtitle", "time": 17654.39, "timestamp": "04:54:14", "text": "間違いなく、私は戻れるかどうか疑っています"}, {"type": "subtitle", "time": 17658.47, "timestamp": "04:54:18", "text": "ストリームに戻る"}, {"type": "subtitle", "time": 17663.11, "timestamp": "04:54:23", "text": "通常のストリームのタイプ uh タイプ"}, {"type": "subtitle", "time": 17669.59, "timestamp": "04:54:29", "text": "もう。でも大丈夫。私は"}, {"type": "subtitle", "time": 17671.67, "timestamp": "04:54:31", "text": "保つ"}, {"type": "subtitle", "time": 17674.868, "timestamp": "04:54:34", "text": "大丈夫です。"}, {"type": "subtitle", "time": 17680.07, "timestamp": "04:54:40", "text": "わかった。えっと、私はコミュニティを待っています。"}, {"type": "subtitle", "time": 17681.59, "timestamp": "04:54:41", "text": "引き続きご検討ください"}, {"type": "subtitle", "time": 17683.35, "timestamp": "04:54:43", "text": "最高だよ、そしてこれからも自分らしくいてね。ありがとう"}, {"type": "subtitle", "time": 17685.59, "timestamp": "04:54:45", "text": "来てくれて、応援してくれてありがとう"}, {"type": "subtitle", "time": 17688.47, "timestamp": "04:54:48", "text": "旅。私は瞬間瞬間が大好きです。"}, {"type": "subtitle", "time": 17695.03, "timestamp": "04:54:55", "text": "願っています"}, {"type": "subtitle", "time": 17697.51, "timestamp": "04:54:57", "text": "それに"}, {"type": "subtitle", "time": 17699.99, "timestamp": "04:54:59", "text": "そこにいるでしょう"}]
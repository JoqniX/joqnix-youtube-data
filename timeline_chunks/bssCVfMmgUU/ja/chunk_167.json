[{"type": "subtitle", "time": 10021.349, "timestamp": "02:47:01", "text": "アレクサーとのコラボレーションも良かった。わかった、"}, {"type": "subtitle", "time": 10023.51, "timestamp": "02:47:03", "text": "これです"}, {"type": "subtitle", "time": 10026.07, "timestamp": "02:47:06", "text": "ズキナとDJとのコラボレーションも"}, {"type": "subtitle", "time": 10028.07, "timestamp": "02:47:08", "text": "良い。"}, {"type": "subtitle", "time": 10029.83, "timestamp": "02:47:09", "text": "それは良い。"}, {"type": "subtitle", "time": 10033.03, "timestamp": "02:47:13", "text": "はい、まだ78です。よし、アップロードできます。"}, {"type": "subtitle", "time": 10037.19, "timestamp": "02:47:17", "text": "それらの。それらをアップロードできます。"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "えっと"}, {"type": "subtitle", "time": 10041.349, "timestamp": "02:47:21", "text": "77と78"}, {"type": "subtitle", "time": 10044.23, "timestamp": "02:47:24", "text": "77と"}, {"type": "subtitle", "time": 10046.87, "timestamp": "02:47:26", "text": "77 パート1。"}, {"type": "subtitle", "time": 10050.63, "timestamp": "02:47:30", "text": "さて、問題は、私が何をする必要があるかということです"}, {"type": "subtitle", "time": 10053.75, "timestamp": "02:47:33", "text": "24時間配信できますか、それとも1回だけ配信できますか？"}, {"type": "subtitle", "time": 10057.19, "timestamp": "02:47:37", "text": "しばらくして、ある日は8時間か"}, {"type": "subtitle", "time": 10059.11, "timestamp": "02:47:39", "text": "何かあるだけで、それだけ？やるべきでしょうか？"}, {"type": "subtitle", "time": 10062.389, "timestamp": "02:47:42", "text": "その形式がいいですか、それとも別の形式でやった方がいいですか？"}, {"type": "subtitle", "time": 10065.59, "timestamp": "02:47:45", "text": "2つのフォーマット？おはようございます。パート1のように、"}, {"type": "subtitle", "time": 10067.51, "timestamp": "02:47:47", "text": "パート2、12時間、12時間。私はそうすべきでしょうか"}, {"type": "subtitle", "time": 10070.07, "timestamp": "02:47:50", "text": "それか、わからないよ。で"}, {"type": "subtitle", "time": 10073.67, "timestamp": "02:47:53", "text": "この点については、私には分かりません。"}, {"type": "subtitle", "time": 10077.19, "timestamp": "02:47:57", "text": "現時点では、私自身も何が"}]
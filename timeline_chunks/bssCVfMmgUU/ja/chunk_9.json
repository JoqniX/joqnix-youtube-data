[{"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "えっと、2023年から。24年だったかな。うん。 1つには"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "または2年。うん。あなたの配信では"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "まるで私たちがこれまでこんな風に交流したことがないかのように"}, {"type": "subtitle", "time": 552.31, "timestamp": "00:09:12", "text": "通話中やゲームをしているときのように"}, {"type": "subtitle", "time": 554.949, "timestamp": "00:09:14", "text": "一緒に。"}, {"type": "subtitle", "time": 559.75, "timestamp": "00:09:19", "text": "はい、これが私たちにとって初めてのコラボレーションです。さあ行こう。"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "前回は、私は、えっと、私は"}, {"type": "subtitle", "time": 566.79, "timestamp": "00:09:26", "text": "私はあなたを発見しました"}, {"type": "subtitle", "time": 569.19, "timestamp": "00:09:29", "text": "ずっと昔。それはいつのことだった？あの時"}, {"type": "subtitle", "time": 571.11, "timestamp": "00:09:31", "text": "デビューしたばかりだった。覚えていますか？"}, {"type": "subtitle", "time": 574.63, "timestamp": "00:09:34", "text": "うん。うん。うん。うん。うん。"}, {"type": "subtitle", "time": 577.11, "timestamp": "00:09:37", "text": "ええ、本当に久しぶりですね"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "以来。 N"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "うん。最近の生活はどうですか？どのように"}, {"type": "subtitle", "time": 586.47, "timestamp": "00:09:46", "text": "された？"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "つまり、試験は終わったので、"}, {"type": "subtitle", "time": 592.23, "timestamp": "00:09:52", "text": "まるで私のリラックスタイムが続くみたい"}, {"type": "subtitle", "time": 594.71, "timestamp": "00:09:54", "text": "授業がまた始まるみたいだ。だから、私は"}, {"type": "subtitle", "time": 598.31, "timestamp": "00:09:58", "text": "できる限りのことをしてきた"}]
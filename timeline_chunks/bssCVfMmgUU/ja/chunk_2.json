[{"type": "subtitle", "time": 120.23, "timestamp": "00:02:00", "text": "なんだかちぐはぐな感じがする。私のオーディオ"}, {"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "周囲の騒音がぶつかり合う"}, {"type": "subtitle", "time": 127.03, "timestamp": "00:02:07", "text": "1 つのスタジオ、1 つの信号、または何かに。"}, {"type": "subtitle", "time": 130.309, "timestamp": "00:02:10", "text": "理由はわからないけど、たぶん私は"}, {"type": "subtitle", "time": 133.51, "timestamp": "00:02:13", "text": "私のマイクはステレオマイクです。これはコンデンサーです"}, {"type": "subtitle", "time": 138.63, "timestamp": "00:02:18", "text": "マイクみたいなもの。しかし問題は、"}, {"type": "subtitle", "time": 140.79, "timestamp": "00:02:20", "text": "ノイズ抑制レベル3"}, {"type": "subtitle", "time": 143.75, "timestamp": "00:02:23", "text": "マイク。"}, {"type": "subtitle", "time": 147.51, "timestamp": "00:02:27", "text": "まあ、まだ多少は機能している。"}, {"type": "subtitle", "time": 150.63, "timestamp": "00:02:30", "text": "それで、私はこれを"}, {"type": "subtitle", "time": 152.47, "timestamp": "00:02:32", "text": "現在、私の"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "現在、配信用のマイクとして使っています。私"}, {"type": "subtitle", "time": 157.82999999999998, "timestamp": "00:02:37", "text": "それを持つことを考えた"}, {"type": "subtitle", "time": 160.79, "timestamp": "00:02:40", "text": "運転中とか外出している時だけ"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "私が行くとき、それは"}, {"type": "subtitle", "time": 164.949, "timestamp": "00:02:44", "text": "ストリームを配信する場合、"}, {"type": "subtitle", "time": 167.99, "timestamp": "00:02:47", "text": "ストリームすると、"}, {"type": "subtitle", "time": 177.67000000000002, "timestamp": "00:02:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "インドで今まさに起こった出来事です。インド パキスタン"}, {"type": "subtitle", "time": 1202.95, "timestamp": "00:20:02", "text": "そのため、今日私のアカデミーは"}, {"type": "subtitle", "time": 1205.99, "timestamp": "00:20:05", "text": "私と家族が会議を好きで"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "行く予定の他の学生"}, {"type": "subtitle", "time": 1210.95, "timestamp": "00:20:10", "text": "来月（7月）の入学についてです。"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "彼らはJPが"}, {"type": "subtitle", "time": 1216.31, "timestamp": "00:20:16", "text": "日本の学校では、彼らはちょっと"}, {"type": "subtitle", "time": 1219.11, "timestamp": "00:20:19", "text": "キャンセルまたは延期"}, {"type": "subtitle", "time": 1224.71, "timestamp": "00:20:24", "text": "移民問題に関して。それで彼らは「うーうーうー」と言った"}, {"type": "subtitle", "time": 1228.71, "timestamp": "00:20:28", "text": "彼らは、2026年4月に延期されたと言った。"}, {"type": "subtitle", "time": 1232.07, "timestamp": "00:20:32", "text": "だから私は「うわあ」って思ったんです。私は準備ができた"}, {"type": "subtitle", "time": 1235.029, "timestamp": "00:20:35", "text": "まるで私が全て準備したかのように。"}, {"type": "subtitle", "time": 1238.87, "timestamp": "00:20:38", "text": "今は「ああ、私は"}, {"type": "subtitle", "time": 1241.029, "timestamp": "00:20:41", "text": "「ここに6ヶ月滞在します。」"}, {"type": "subtitle", "time": 1242.789, "timestamp": "00:20:42", "text": "うん。"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "私はこれから8ヶ月間ここにいなければならない。 O"}, {"type": "subtitle", "time": 1248.63, "timestamp": "00:20:48", "text": "でも彼らは私に"}, {"type": "subtitle", "time": 1251.35, "timestamp": "00:20:51", "text": "クラス、次のレベルのクラス"}, {"type": "subtitle", "time": 1253.59, "timestamp": "00:20:53", "text": "無料。だから私は追いついた"}, {"type": "subtitle", "time": 1256.149, "timestamp": "00:20:56", "text": "すべて。それで、私がそこに行くので"}, {"type": "subtitle", "time": 1258.47, "timestamp": "00:20:58", "text": "今は勉強をしているので簡単に"}]
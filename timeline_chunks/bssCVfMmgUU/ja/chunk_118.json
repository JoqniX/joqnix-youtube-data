[{"type": "subtitle", "time": 7093.03, "timestamp": "01:58:13", "text": "私は怖いです。"}, {"type": "subtitle", "time": 7102.229, "timestamp": "01:58:22", "text": "いいえ。"}, {"type": "subtitle", "time": 7105.669, "timestamp": "01:58:25", "text": "私たちに教えてください。いいえ。"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "どうすればいいのかわからない、両方ともジャンプするから"}, {"type": "subtitle", "time": 7111.43, "timestamp": "01:58:31", "text": "同じ。"}, {"type": "subtitle", "time": 7116.149, "timestamp": "01:58:36", "text": "待って。 R2。 R2。 R2。チャット。わかった。出来ますか"}, {"type": "subtitle", "time": 7136.55, "timestamp": "01:58:56", "text": "あなたはなぜジャンプしないのですか、"}, {"type": "subtitle", "time": 7138.55, "timestamp": "01:58:58", "text": "兄弟？"}]
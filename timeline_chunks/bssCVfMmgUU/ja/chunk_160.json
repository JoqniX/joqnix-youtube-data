[{"type": "subtitle", "time": 9601.03, "timestamp": "02:40:01", "text": "のように"}, {"type": "subtitle", "time": 9603.51, "timestamp": "02:40:03", "text": "VTuberとしてカイサに連絡が取れるといいですね"}, {"type": "subtitle", "time": 9605.51, "timestamp": "02:40:05", "text": "文化とソーシャルメディアのすべてになる"}, {"type": "subtitle", "time": 9607.67, "timestamp": "02:40:07", "text": "日本から私たちの国への連絡と橋"}, {"type": "subtitle", "time": 9611.91, "timestamp": "02:40:11", "text": "自国。これはインド製です"}, {"type": "subtitle", "time": 9614.63, "timestamp": "02:40:14", "text": "我々の国へ。これはインド人です。"}, {"type": "subtitle", "time": 9619.03, "timestamp": "02:40:19", "text": "わかった。あなたがどなたであれ、ありがとうございます。"}, {"type": "subtitle", "time": 9621.91, "timestamp": "02:40:21", "text": "18番。"}, {"type": "subtitle", "time": 9625.349, "timestamp": "02:40:25", "text": "第3クォーター 午後9時午前 3 時まで。"}, {"type": "subtitle", "time": 9628.309, "timestamp": "02:40:28", "text": "この人は夜型人間だ。夜間"}, {"type": "subtitle", "time": 9631.91, "timestamp": "02:40:31", "text": "今のところ、何らかの課題が山積している。"}, {"type": "chat", "time": 9632.878, "timestamp": "02:40:32", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I guess I need a twitter"}, {"type": "subtitle", "time": 9635.11, "timestamp": "02:40:35", "text": "『エルダーリング エクソススペース』のようなゲームをプレイしてみてください。"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "よし、それで、今はできると思うから"}, {"type": "subtitle", "time": 9641.429, "timestamp": "02:40:41", "text": "する"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "エルダーリングをプレイできるようになった気がする"}, {"type": "subtitle", "time": 9653.03, "timestamp": "02:40:53", "text": "そして、そういう種類のゲーム。私はそれで構いません"}, {"type": "subtitle", "time": 9655.11, "timestamp": "02:40:55", "text": "そういうチャレンジをするのは"}, {"type": "subtitle", "time": 9658.309, "timestamp": "02:40:58", "text": "俺はそこに8ヶ月いるんだ、兄弟。"}]
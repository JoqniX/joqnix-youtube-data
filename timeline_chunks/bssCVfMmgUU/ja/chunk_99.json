[{"type": "subtitle", "time": 5943.59, "timestamp": "01:39:03", "text": "何てことだ。 「オーマイゴッド」と聞こえました。あ、待って。"}, {"type": "subtitle", "time": 5960.629, "timestamp": "01:39:20", "text": "今、ここにいる。"}, {"type": "subtitle", "time": 5978.87, "timestamp": "01:39:38", "text": "そしてこれ"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "ああ、わかりました。ああ、助かった。ニース。ニース。わかった。"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "いや、いや、いや、いや。私を引き上げてくれてもいいですよ。引く"}, {"type": "subtitle", "time": 5993.03, "timestamp": "01:39:53", "text": "私を起こして。泊めてくれ。"}, {"type": "subtitle", "time": 5996.149, "timestamp": "01:39:56", "text": "何てことだ。何てことだ。これは難しい。"}, {"type": "subtitle", "time": 5999.51, "timestamp": "01:39:59", "text": "よし、じゃあ私が先に言うね。できればそうしたいです。わかった。"}]
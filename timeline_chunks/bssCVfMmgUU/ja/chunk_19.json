[{"type": "subtitle", "time": 1142.15, "timestamp": "00:19:02", "text": "それは、人間に対する愛のようなものですよね？真実"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "美しさ。正直に言うと、読み始めたとき"}, {"type": "subtitle", "time": 1148.07, "timestamp": "00:19:08", "text": "YouTubeの美しさ、とてもイライラしました"}, {"type": "subtitle", "time": 1150.71, "timestamp": "00:19:10", "text": "読む。理由はわからないが、"}, {"type": "subtitle", "time": 1158.789, "timestamp": "00:19:18", "text": "たぶんそれは"}, {"type": "subtitle", "time": 1161.909, "timestamp": "00:19:21", "text": "最初から最後まで、彼女はできなかった"}, {"type": "subtitle", "time": 1165.669, "timestamp": "00:19:25", "text": "真の美しさとは一体何なのかを見極める"}, {"type": "subtitle", "time": 1176.95, "timestamp": "00:19:36", "text": "面白い。私もこれに少し手を出してみたい。"}, {"type": "subtitle", "time": 1179.51, "timestamp": "00:19:39", "text": "どうやら、私は今"}, {"type": "subtitle", "time": 1181.75, "timestamp": "00:19:41", "text": "の後にもっと自由時間があると思う"}, {"type": "subtitle", "time": 1183.909, "timestamp": "00:19:43", "text": "今月は試験があります。もっと欲しいと思う"}, {"type": "subtitle", "time": 1186.47, "timestamp": "00:19:46", "text": "自由時間があるので、これらに手を出せる"}, {"type": "subtitle", "time": 1188.15, "timestamp": "00:19:48", "text": "ゆっくり。"}, {"type": "subtitle", "time": 1191.83, "timestamp": "00:19:51", "text": "私は初回面談に行く予定だったのですが"}, {"type": "subtitle", "time": 1195.11, "timestamp": "00:19:55", "text": "日本では来月になるはずだったが"}, {"type": "subtitle", "time": 1197.27, "timestamp": "00:19:57", "text": "ああ、残念ながら戦争のせいで"}]
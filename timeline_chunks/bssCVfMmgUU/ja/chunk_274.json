[{"type": "subtitle", "time": 16442.551, "timestamp": "04:34:02", "text": "206年の4月にシフトしました。"}, {"type": "subtitle", "time": 16445.029, "timestamp": "04:34:05", "text": "ああ、これはうまくいくよ。"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "私の国。"}, {"type": "subtitle", "time": 16453.99, "timestamp": "04:34:13", "text": "最初に私は"}, {"type": "subtitle", "time": 16456.551, "timestamp": "04:34:16", "text": "ジャカソンは6月中旬までに終了するだろう"}, {"type": "subtitle", "time": 16459.51, "timestamp": "04:34:19", "text": "6月は7月までにキャンセルする予定だが"}, {"type": "subtitle", "time": 16462.629, "timestamp": "04:34:22", "text": "幸運にも私の7月は"}, {"type": "subtitle", "time": 16469.75, "timestamp": "04:34:29", "text": "キャンセルされ、変更されました。"}, {"type": "subtitle", "time": 16472.789, "timestamp": "04:34:32", "text": "それは私の国で起こった出来事だった。これ"}, {"type": "subtitle", "time": 16475.189, "timestamp": "04:34:35", "text": "それはつまり"}, {"type": "subtitle", "time": 16479.59, "timestamp": "04:34:39", "text": "これは私が持っていることを意味します これは私が持っていることを意味します"}, {"type": "subtitle", "time": 16483.59, "timestamp": "04:34:43", "text": "ちょっと待って、6月、7月、8月を数えてみよう"}, {"type": "subtitle", "time": 16485.59, "timestamp": "04:34:45", "text": "9月 10月 11月 12月"}, {"type": "subtitle", "time": 16488.551, "timestamp": "04:34:48", "text": "1月 2月 3月"}]
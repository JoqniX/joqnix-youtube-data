[{"type": "subtitle", "time": 1800.47, "timestamp": "00:30:00", "text": "わかった。うん、それでいいよ。遠慮なく"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "私は"}, {"type": "subtitle", "time": 1815.11, "timestamp": "00:30:15", "text": "こんにちは。こんにちは。私の声は"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "h"}, {"type": "subtitle", "time": 1822.71, "timestamp": "00:30:22", "text": "ゲーム内で。わからない。何らかの理由で、"}, {"type": "subtitle", "time": 1826.71, "timestamp": "00:30:26", "text": "ゲーム中にマイクが私の声を拾ってくれません。それで、"}, {"type": "subtitle", "time": 1829.19, "timestamp": "00:30:29", "text": "ほとんどの場合、私は詠唱しているような感じ"}]
[{"type": "subtitle", "time": 4449.75, "timestamp": "01:14:09", "text": "何かあるはずだ。それはそうであるはずだ"}, {"type": "subtitle", "time": 4459.03, "timestamp": "01:14:19", "text": "[音楽]"}, {"type": "subtitle", "time": 4461.669, "timestamp": "01:14:21", "text": "あのカモは本当にうざい。"}, {"type": "subtitle", "time": 4472.149, "timestamp": "01:14:32", "text": "何か見えますか？"}, {"type": "subtitle", "time": 4474.229, "timestamp": "01:14:34", "text": "黄色の点？"}, {"type": "subtitle", "time": 4488.31, "timestamp": "01:14:48", "text": "何かが残っているはずだ。開く"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "引き出しと冷蔵庫、"}, {"type": "subtitle", "time": 4496.55, "timestamp": "01:14:56", "text": "ああ、そうだね。何かある。カエル。"}, {"type": "subtitle", "time": 4499.91, "timestamp": "01:14:59", "text": "蛙。気をつけて。"}]
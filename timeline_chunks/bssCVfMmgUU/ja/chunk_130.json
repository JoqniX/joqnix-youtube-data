[{"type": "subtitle", "time": 7802.229, "timestamp": "02:10:02", "text": "ジェン、彼女の作品はあなたの下でとても素晴らしいです"}, {"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "亡くなった。それはどういう意味ですか？待って、それは"}, {"type": "subtitle", "time": 7811.99, "timestamp": "02:10:11", "text": "わからない、みたいな感じ？よくわからない。"}, {"type": "subtitle", "time": 7815.83, "timestamp": "02:10:15", "text": "どう説明すればいいでしょうか？私"}, {"type": "subtitle", "time": 7817.669, "timestamp": "02:10:17", "text": "持っている"}, {"type": "subtitle", "time": 7827.189, "timestamp": "02:10:27", "text": "基本的に、ここより下の人は死んでいます。ああ、"}, {"type": "chat", "time": 7828.997, "timestamp": "02:10:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "like hair dyed under but a layer of natural hair is over the dyed hair"}, {"type": "subtitle", "time": 7829.109, "timestamp": "02:10:29", "text": "ああ、そうだね。うん。あなたの下では"}, {"type": "subtitle", "time": 7832.069, "timestamp": "02:10:32", "text": "本当に良い。何てことだ。"}, {"type": "subtitle", "time": 7835.91, "timestamp": "02:10:35", "text": "ああ、気に入ったよ。ヘアカラーや"}, {"type": "subtitle", "time": 7838.069, "timestamp": "02:10:38", "text": "わかった。わかった。でも私はくせ毛なんです"}, {"type": "subtitle", "time": 7841.189, "timestamp": "02:10:41", "text": "そして、それは見栄えが悪いだろう。"}, {"type": "subtitle", "time": 7844.55, "timestamp": "02:10:44", "text": "ああ、私もです。巻き毛仲間。"}, {"type": "subtitle", "time": 7849.03, "timestamp": "02:10:49", "text": "さあ行こう。ここに来て。さあ行こう。"}, {"type": "subtitle", "time": 7854.229, "timestamp": "02:10:54", "text": "私のアンダータイプは本当にクールです。"}]
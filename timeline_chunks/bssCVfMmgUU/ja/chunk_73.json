[{"type": "subtitle", "time": 4396.31, "timestamp": "01:13:16", "text": "そこには。ええ、ここには何もありませんでした。私"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "何もなかった。二階へ上がってください。行く"}, {"type": "subtitle", "time": 4421.83, "timestamp": "01:13:41", "text": "2階へ。二階へ上がってください。"}, {"type": "subtitle", "time": 4424.31, "timestamp": "01:13:44", "text": "2階には何もありません。あ、待って。"}, {"type": "subtitle", "time": 4427.59, "timestamp": "01:13:47", "text": "私の言っていることが聞こえますか？待って。ええ、できます"}]
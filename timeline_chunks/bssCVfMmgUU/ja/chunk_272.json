[{"type": "subtitle", "time": 16323.11, "timestamp": "04:32:03", "text": "ええと、私は言ったのですが"}, {"type": "subtitle", "time": 16325.11, "timestamp": "04:32:05", "text": "最初は"}, {"type": "subtitle", "time": 16331.03, "timestamp": "04:32:11", "text": "私は6月中旬までにヨアトンを終わらせるつもりだ"}, {"type": "subtitle", "time": 16334.309, "timestamp": "04:32:14", "text": "しかし残念ながら"}, {"type": "subtitle", "time": 16337.269, "timestamp": "04:32:17", "text": "により"}, {"type": "subtitle", "time": 16347.59, "timestamp": "04:32:27", "text": "えーと、何らかの合併症により"}, {"type": "subtitle", "time": 16350.07, "timestamp": "04:32:30", "text": "合併症"}, {"type": "subtitle", "time": 16351.83, "timestamp": "04:32:31", "text": "えっと"}, {"type": "subtitle", "time": 16354.149, "timestamp": "04:32:34", "text": "ああ、悲しいことに"}, {"type": "subtitle", "time": 16356.71, "timestamp": "04:32:36", "text": "しかし残念ながら"}, {"type": "subtitle", "time": 16359.91, "timestamp": "04:32:39", "text": "いや、"}, {"type": "subtitle", "time": 16364.63, "timestamp": "04:32:44", "text": "6月中旬に日本に行く予定なので"}, {"type": "subtitle", "time": 16370.07, "timestamp": "04:32:50", "text": "7月末までに"}, {"type": "subtitle", "time": 16373.51, "timestamp": "04:32:53", "text": "6月ですが、私は行く予定です"}]
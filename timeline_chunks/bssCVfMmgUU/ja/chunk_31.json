[{"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "こんにちは。"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "わーい。私はこのゲームをシングルモードでプレイしていました"}, {"type": "subtitle", "time": 1883.19, "timestamp": "00:31:23", "text": "ビデオは作ったけど、その後はやらなかった"}, {"type": "subtitle", "time": 1886.549, "timestamp": "00:31:26", "text": "怖かったからレベル1にした。"}, {"type": "subtitle", "time": 1889.35, "timestamp": "00:31:29", "text": "でも、あなたは得意だと言っていましたよね"}, {"type": "subtitle", "time": 1891.43, "timestamp": "00:31:31", "text": "ホラー。"}, {"type": "subtitle", "time": 1894.389, "timestamp": "00:31:34", "text": "私は好きだと言っただけで、得意だとは言っていません"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "それ。わかった。"}, {"type": "subtitle", "time": 1899.35, "timestamp": "00:31:39", "text": "何てことだ。"}, {"type": "subtitle", "time": 1902.31, "timestamp": "00:31:42", "text": "高価なものもある"}, {"type": "subtitle", "time": 1904.549, "timestamp": "00:31:44", "text": "そこには。"}, {"type": "subtitle", "time": 1913.75, "timestamp": "00:31:53", "text": "ああ、次はどうすればいいの？持ち上げることができます"}, {"type": "subtitle", "time": 1918.23, "timestamp": "00:31:58", "text": "一緒に持って、それを"}]
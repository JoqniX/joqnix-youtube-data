[{"type": "subtitle", "time": 6301.59, "timestamp": "01:45:01", "text": "待って。何？"}, {"type": "subtitle", "time": 6303.35, "timestamp": "01:45:03", "text": "うん。大丈夫。大丈夫。ただ飛び降りればいい。"}, {"type": "subtitle", "time": 6306.149, "timestamp": "01:45:06", "text": "ジャンプ。ジャンプする ジャンプしないで"}, {"type": "subtitle", "time": 6308.31, "timestamp": "01:45:08", "text": "あれ。ただ"}, {"type": "subtitle", "time": 6311.03, "timestamp": "01:45:11", "text": "私はできると思います。"}, {"type": "subtitle", "time": 6313.99, "timestamp": "01:45:13", "text": "なあ、なんで俺はこんな状態なんだ？私はできる"}, {"type": "subtitle", "time": 6317.03, "timestamp": "01:45:17", "text": "引っ張れるよ。うん。うん。引っ張ってみて。試す"}, {"type": "subtitle", "time": 6320.629, "timestamp": "01:45:20", "text": "引っ張ってみて。あなたにそれは言える"}, {"type": "subtitle", "time": 6324.39, "timestamp": "01:45:24", "text": "表示されない。"}, {"type": "subtitle", "time": 6326.79, "timestamp": "01:45:26", "text": "これは何のゲームですか？ああ、私は行き詰まっています"}, {"type": "subtitle", "time": 6337.83, "timestamp": "01:45:37", "text": "私はここから出ていく。うん。あ、待って、待って、"}, {"type": "subtitle", "time": 6342.39, "timestamp": "01:45:42", "text": "待って、待って、待って、待って。私を引っ張ってみて。"}, {"type": "subtitle", "time": 6344.79, "timestamp": "01:45:44", "text": "そうそう。私は"}, {"type": "subtitle", "time": 6348.229, "timestamp": "01:45:48", "text": "ジャンプ。よし、行こう。"}, {"type": "subtitle", "time": 6357.27, "timestamp": "01:45:57", "text": "さあ、行こう。"}]
[{"type": "subtitle", "time": 480.629, "timestamp": "00:08:00", "text": "彼らはそう言うだろう、それは今日だけだ"}, {"type": "subtitle", "time": 483.029, "timestamp": "00:08:03", "text": "私はまだヘルメットをかぶっていて、"}, {"type": "subtitle", "time": 487.11, "timestamp": "00:08:07", "text": "コーヒーを飲んで、私は「えっと」って感じでした"}, {"type": "subtitle", "time": 491.589, "timestamp": "00:08:11", "text": "この近くで、えっと、私は歩いていました"}, {"type": "subtitle", "time": 493.99, "timestamp": "00:08:13", "text": "店の横のような側面、そして"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "文字通り穏やかに静かに話す"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "なぜなら人々は"}, {"type": "subtitle", "time": 503.029, "timestamp": "00:08:23", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 506.71, "timestamp": "00:08:26", "text": "ジャカタン91日目パート2へようこそ"}, {"type": "subtitle", "time": 510.15, "timestamp": "00:08:30", "text": "ストリーム。それでは、2人目のゲストをお迎えしましょう。"}, {"type": "subtitle", "time": 516.79, "timestamp": "00:08:36", "text": "夜の。クレメンスが出演しています。こんにちは。"}, {"type": "subtitle", "time": 521.75, "timestamp": "00:08:41", "text": "こんにちは。こんにちは、そして妹さん。元気かい？"}, {"type": "subtitle", "time": 525.67, "timestamp": "00:08:45", "text": "私は、自分が良い子だったと思っています。その"}, {"type": "subtitle", "time": 527.75, "timestamp": "00:08:47", "text": "久しぶりですね。これは私たちの最初の"}, {"type": "subtitle", "time": 529.829, "timestamp": "00:08:49", "text": "時間相互作用。交流しましたか？"}, {"type": "subtitle", "time": 532.949, "timestamp": "00:08:52", "text": "前に？はい、そうです。そうかもしれないね。これ"}, {"type": "subtitle", "time": 536.47, "timestamp": "00:08:56", "text": "多くに似ている。初めてです。最初に"}, {"type": "subtitle", "time": 538.949, "timestamp": "00:08:58", "text": "時間。でも、あなたを見かけたことがあると思います"}]
[{"type": "subtitle", "time": 9541.03, "timestamp": "02:39:01", "text": "何か書いてください。これは提案投稿です。"}, {"type": "subtitle", "time": 9543.03, "timestamp": "02:39:03", "text": "人々はこう書いたかもしれないと思う"}, {"type": "subtitle", "time": 9545.349, "timestamp": "02:39:05", "text": "何か。"}, {"type": "subtitle", "time": 9548.55, "timestamp": "02:39:08", "text": "何か返答はありますか？"}, {"type": "subtitle", "time": 9551.51, "timestamp": "02:39:11", "text": "19. 以前は17でした。"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "えっと、両方とも3つ"}, {"type": "chat", "time": 9567.424, "timestamp": "02:39:27", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "look at you being all professional"}, {"type": "subtitle", "time": 9568.389, "timestamp": "02:39:28", "text": "第2四半期と第3四半期。"}, {"type": "subtitle", "time": 9570.71, "timestamp": "02:39:30", "text": "でも落ち着いて。本当のところは"}, {"type": "subtitle", "time": 9572.55, "timestamp": "02:39:32", "text": "私の側から恐怖を感じて"}, {"type": "subtitle", "time": 9577.59, "timestamp": "02:39:37", "text": "続きなので、あなたを応援したいです"}, {"type": "subtitle", "time": 9580.55, "timestamp": "02:39:40", "text": "日本の幸運を祈っています。"}, {"type": "subtitle", "time": 9582.63, "timestamp": "02:39:42", "text": "サポート"}, {"type": "subtitle", "time": 9584.55, "timestamp": "02:39:44", "text": "えっと、君はかっこよく見えると思うよ、"}, {"type": "subtitle", "time": 9587.11, "timestamp": "02:39:47", "text": "本当に理解しにくいので、まあいいです"}, {"type": "subtitle", "time": 9590.71, "timestamp": "02:39:50", "text": "私としては変更は推奨しません"}, {"type": "subtitle", "time": 9592.389, "timestamp": "02:39:52", "text": "ホラーゲームをプレイできるなら"}, {"type": "subtitle", "time": 9593.99, "timestamp": "02:39:53", "text": "叫んで怖がれば、"}, {"type": "subtitle", "time": 9596.71, "timestamp": "02:39:56", "text": "罰を受けてスライスを食べなければならない"}, {"type": "subtitle", "time": 9599.03, "timestamp": "02:39:59", "text": "青唐辛子や毛皮などでも、あなたは"}]
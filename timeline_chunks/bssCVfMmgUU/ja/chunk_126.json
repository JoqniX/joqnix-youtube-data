[{"type": "subtitle", "time": 7562.31, "timestamp": "02:06:02", "text": "ゲームを変えたいですか？私たちは立ち往生するだろう"}, {"type": "subtitle", "time": 7580.709, "timestamp": "02:06:20", "text": "ああ、感情表現とかそういうのは一切できないんだね。"}, {"type": "subtitle", "time": 7588.47, "timestamp": "02:06:28", "text": "それは一体どういう仕組みなの？"}, {"type": "subtitle", "time": 7590.629, "timestamp": "02:06:30", "text": "のように"}, {"type": "subtitle", "time": 7595.189, "timestamp": "02:06:35", "text": "それは一体どういう仕組みなの？私は混乱しています。"}, {"type": "subtitle", "time": 7597.35, "timestamp": "02:06:37", "text": "どれ？"}, {"type": "subtitle", "time": 7601.51, "timestamp": "02:06:41", "text": "私たちがどれほどそれに近いところまで到達したか、というように。うん、"}, {"type": "subtitle", "time": 7603.99, "timestamp": "02:06:43", "text": "私たちはもう少しでそこにたどり着くところだったが、それは跳ね返ってしまった。"}, {"type": "subtitle", "time": 7607.35, "timestamp": "02:06:47", "text": "私たちを戻して。チェーンが"}, {"type": "subtitle", "time": 7610.31, "timestamp": "02:06:50", "text": "防止するなど"}]
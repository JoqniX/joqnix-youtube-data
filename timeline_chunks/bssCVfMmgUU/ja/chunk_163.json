[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "今。ビリービリーを育てたい"}, {"type": "subtitle", "time": 9783.75, "timestamp": "02:43:03", "text": "チャンネルやその他すべて、そしてたくさんのことを"}, {"type": "subtitle", "time": 9788.23, "timestamp": "02:43:08", "text": "そこで配信したいから"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "そして、私はそこで配信するのが大好きです。"}, {"type": "subtitle", "time": 9795.59, "timestamp": "02:43:15", "text": "私は、"}, {"type": "subtitle", "time": 9798.389, "timestamp": "02:43:18", "text": "もう一度そこで配信してください。"}, {"type": "subtitle", "time": 9800.389, "timestamp": "02:43:20", "text": "ええ、そうですね。"}, {"type": "chat", "time": 9803.557, "timestamp": "02:43:23", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "again ?"}, {"type": "subtitle", "time": 9804.15, "timestamp": "02:43:24", "text": "まあ、そういうことだ。それから、"}, {"type": "subtitle", "time": 9805.83, "timestamp": "02:43:25", "text": "えっと"}, {"type": "subtitle", "time": 9808.95, "timestamp": "02:43:28", "text": "実際、私はたくさんのことを"}, {"type": "subtitle", "time": 9811.75, "timestamp": "02:43:31", "text": "心配する必要はありません"}, {"type": "subtitle", "time": 9814.63, "timestamp": "02:43:34", "text": "そこで配信する必要がないので"}, {"type": "subtitle", "time": 9816.71, "timestamp": "02:43:36", "text": "また。ええ、無線LANが使えなくなりました。あなた"}, {"type": "subtitle", "time": 9819.67, "timestamp": "02:43:39", "text": "中国へストリーミングするにはワイヤレス接続が必要です"}, {"type": "subtitle", "time": 9823.99, "timestamp": "02:43:43", "text": "信じるためにストリーミングする。彼らは許可しない"}, {"type": "subtitle", "time": 9826.55, "timestamp": "02:43:46", "text": "インドは地域出身の外国人を好む。彼らはそうする"}, {"type": "subtitle", "time": 9828.95, "timestamp": "02:43:48", "text": "外国人の入国を許可しない。持っていなければならない"}, {"type": "subtitle", "time": 9831.75, "timestamp": "02:43:51", "text": "特定のホワイトリスト。どちらかを選ばなければならない"}, {"type": "subtitle", "time": 9834.309, "timestamp": "02:43:54", "text": "代理店に加入してホワイトリストに登録しましょう"}, {"type": "chat", "time": 9835.879, "timestamp": "02:43:55", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "how did ya lost it"}, {"type": "subtitle", "time": 9836.309, "timestamp": "02:43:56", "text": "彼らの下で。機関のリソースを活用する"}]
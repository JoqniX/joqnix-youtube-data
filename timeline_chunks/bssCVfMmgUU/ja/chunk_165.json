[{"type": "subtitle", "time": 9900.79, "timestamp": "02:45:00", "text": "分析的、批判的"}, {"type": "subtitle", "time": 9903.67, "timestamp": "02:45:03", "text": "私のビリーに対する建設的な批判"}, {"type": "subtitle", "time": 9906.309, "timestamp": "02:45:06", "text": "ビリーアカウント私のチャンネルメイン"}, {"type": "subtitle", "time": 9908.79, "timestamp": "02:45:08", "text": "Vアカウントのメインアカウントではないアカウント。"}, {"type": "subtitle", "time": 9911.349, "timestamp": "02:45:11", "text": "それで私は「わかった」って感じだった"}, {"type": "subtitle", "time": 9914.389, "timestamp": "02:45:14", "text": "それは理解できるが、"}, {"type": "subtitle", "time": 9917.349, "timestamp": "02:45:17", "text": "痛みを感じるのは理解できますが、"}, {"type": "subtitle", "time": 9920.71, "timestamp": "02:45:20", "text": "それは確かに痛みだ。"}, {"type": "subtitle", "time": 9928.389, "timestamp": "02:45:28", "text": "成功したら一生懸命働きたい"}, {"type": "subtitle", "time": 9931.269, "timestamp": "02:45:31", "text": "いい結果。"}, {"type": "subtitle", "time": 9932.63, "timestamp": "02:45:32", "text": "ビリー・ビリーといえば、"}, {"type": "subtitle", "time": 9934.71, "timestamp": "02:45:34", "text": "Vをアップロードすればいいんですよね？もう一度確認させてください"}, {"type": "subtitle", "time": 9937.03, "timestamp": "02:45:37", "text": "私はどれだけの成果を上げたのだろうか。昨日私は"}, {"type": "chat", "time": 9938.381, "timestamp": "02:45:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hmm hmm"}, {"type": "subtitle", "time": 9942.63, "timestamp": "02:45:42", "text": "7つ、いや5つか6つのVをアップロードしました。"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "えっと"}, {"type": "subtitle", "time": 9951.67, "timestamp": "02:45:51", "text": "私は、"}, {"type": "subtitle", "time": 9953.99, "timestamp": "02:45:53", "text": "声明　私はジャカタンについて書くだけです"}, {"type": "subtitle", "time": 9956.309, "timestamp": "02:45:56", "text": "少ししたら、そう言ってください。"}, {"type": "subtitle", "time": 9959.269, "timestamp": "02:45:59", "text": "イベントはもっと長引く予定です"}]
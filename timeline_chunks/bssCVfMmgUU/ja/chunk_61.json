[{"type": "subtitle", "time": 3661.99, "timestamp": "01:01:01", "text": "いいえ、私が拾います。"}, {"type": "subtitle", "time": 3691.43, "timestamp": "01:01:31", "text": "はい、大丈夫です。大丈夫。 9Kですよね？"}, {"type": "subtitle", "time": 3696.069, "timestamp": "01:01:36", "text": "えっと、君は身をかがめる、それは君の"}, {"type": "subtitle", "time": 3698.47, "timestamp": "01:01:38", "text": "それは彼のせいだ。それは"}, {"type": "subtitle", "time": 3705.349, "timestamp": "01:01:45", "text": "それは何かのようだった。"}, {"type": "subtitle", "time": 3709.43, "timestamp": "01:01:49", "text": "ああ、一つあるよ。おお。"}, {"type": "subtitle", "time": 3714.15, "timestamp": "01:01:54", "text": "何てことだ。またか。誓って言いますが、このアヒルは。"}, {"type": "subtitle", "time": 3718.63, "timestamp": "01:01:58", "text": "私の持ち物"}]
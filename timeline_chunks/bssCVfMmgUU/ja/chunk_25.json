[{"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "人は意地悪なこともある。おお。うん。うん、"}, {"type": "subtitle", "time": 1507.99, "timestamp": "00:25:07", "text": "インターネットのことだ。"}, {"type": "subtitle", "time": 1512.07, "timestamp": "00:25:12", "text": "私は、"}, {"type": "subtitle", "time": 1515.59, "timestamp": "00:25:15", "text": "気味が悪くて変な人もいるものだ。そして"}, {"type": "subtitle", "time": 1517.51, "timestamp": "00:25:17", "text": "うん。"}, {"type": "subtitle", "time": 1523.19, "timestamp": "00:25:23", "text": "インターネットにアクセスできるようになると"}, {"type": "subtitle", "time": 1525.99, "timestamp": "00:25:25", "text": "人々はあなたになれる、あなたは会うことができます"}, {"type": "subtitle", "time": 1528.71, "timestamp": "00:25:28", "text": "さまざまなタイプの人々がいる"}, {"type": "subtitle", "time": 1534.31, "timestamp": "00:25:34", "text": "様々な種類があるのが好きです。そうですね"}, {"type": "subtitle", "time": 1537.19, "timestamp": "00:25:37", "text": "世の中には実に様々な人がいる。"}, {"type": "subtitle", "time": 1543.43, "timestamp": "00:25:43", "text": "それで、何か計画はありますか？"}, {"type": "subtitle", "time": 1547.269, "timestamp": "00:25:47", "text": "将来的にはフルモデルとかそういうのも出るのかな？のように"}, {"type": "subtitle", "time": 1551.35, "timestamp": "00:25:51", "text": "えっと、今はあなたは小さくてかわいいオレンジみたい"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "タマルだよね？これまで"}, {"type": "subtitle", "time": 1558.47, "timestamp": "00:25:58", "text": "人型形態とか、そういうもの？私は計画しています"}]
[{"type": "subtitle", "time": 6423.189, "timestamp": "01:47:03", "text": "あらら。うん、もう全力疾走できるよ。それで、"}, {"type": "subtitle", "time": 6426.55, "timestamp": "01:47:06", "text": "一緒に全力疾走してジャンプしようか？"}, {"type": "subtitle", "time": 6428.629, "timestamp": "01:47:08", "text": "よし、そうしよう。よし。三つ、"}, {"type": "subtitle", "time": 6435.189, "timestamp": "01:47:15", "text": "チェーンに加わろうとしてみてください。チェーンチェーン。"}, {"type": "subtitle", "time": 6437.03, "timestamp": "01:47:17", "text": "チェーンチェーン。ああ、それは持っていない"}, {"type": "subtitle", "time": 6439.43, "timestamp": "01:47:19", "text": "衝突判定ボックス。"}, {"type": "subtitle", "time": 6441.59, "timestamp": "01:47:21", "text": "いいえ、そうではありません。"}, {"type": "subtitle", "time": 6471.669, "timestamp": "01:47:51", "text": "私はまた転んでしまった。これを使うつもりです"}, {"type": "subtitle", "time": 6473.669, "timestamp": "01:47:53", "text": "ゲーム。"}]
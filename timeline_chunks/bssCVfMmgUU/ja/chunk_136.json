[{"type": "subtitle", "time": 8160.95, "timestamp": "02:16:00", "text": "今のところ、スケジュールはかなりめちゃくちゃだ。"}, {"type": "subtitle", "time": 8163.35, "timestamp": "02:16:03", "text": "こんにちは。"}, {"type": "subtitle", "time": 8167.03, "timestamp": "02:16:07", "text": "だから、昨日私は"}, {"type": "subtitle", "time": 8169.75, "timestamp": "02:16:09", "text": "友達とおしゃべりしたり、"}, {"type": "subtitle", "time": 8175.75, "timestamp": "02:16:15", "text": "すべてが終わって、時刻は3時頃だった。"}, {"type": "subtitle", "time": 8179.189, "timestamp": "02:16:19", "text": "午前3時。ああ、そうだね。私たちはただおしゃべりしていただけ"}, {"type": "subtitle", "time": 8183.35, "timestamp": "02:16:23", "text": "恥ずかしい瞬間や、私たちの過去について。私たちは"}, {"type": "subtitle", "time": 8186.55, "timestamp": "02:16:26", "text": "過去の出来事を懐かしんでいた"}, {"type": "subtitle", "time": 8189.51, "timestamp": "02:16:29", "text": "それは不快だった"}, {"type": "subtitle", "time": 8191.75, "timestamp": "02:16:31", "text": "ああ、それでまた眠りについたんだ"}, {"type": "subtitle", "time": 8194.95, "timestamp": "02:16:34", "text": "4時だ。直さなきゃ。私は"}, {"type": "subtitle", "time": 8196.91, "timestamp": "02:16:36", "text": "回転。"}, {"type": "subtitle", "time": 8198.79, "timestamp": "02:16:38", "text": "[音楽]"}, {"type": "subtitle", "time": 8200.309, "timestamp": "02:16:40", "text": "それ"}, {"type": "subtitle", "time": 8202.469, "timestamp": "02:16:42", "text": "うん、"}, {"type": "subtitle", "time": 8206.629, "timestamp": "02:16:46", "text": "午前7時か8時頃に寝たと思います。"}, {"type": "subtitle", "time": 8209.03, "timestamp": "02:16:49", "text": "私は10時に行かなければならなかった"}, {"type": "subtitle", "time": 8213.669, "timestamp": "02:16:53", "text": "今日もアカデミーです。だから11時か10時。だから私は"}, {"type": "subtitle", "time": 8218.469, "timestamp": "02:16:58", "text": "ほとんど眠れなかった。ああ、もう寝なさい。行く"}]
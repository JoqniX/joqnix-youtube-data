[{"type": "subtitle", "time": 8461.51, "timestamp": "02:21:01", "text": "クレムソン大学の学生たちと過ごすような感じ。ああ、"}, {"type": "subtitle", "time": 8468.469, "timestamp": "02:21:08", "text": "H"}, {"type": "subtitle", "time": 8471.27, "timestamp": "02:21:11", "text": "待って、ただ、ただ"}, {"type": "subtitle", "time": 8475.11, "timestamp": "02:21:15", "text": "彼女が言った時に私はそれに気づいた"}, {"type": "subtitle", "time": 8478.15, "timestamp": "02:21:18", "text": "これが私たちの最初のやり取りだということを私に伝えてください。私"}, {"type": "subtitle", "time": 8483.51, "timestamp": "02:21:23", "text": "えっと、前に話したことがあるかも"}, {"type": "subtitle", "time": 8487.11, "timestamp": "02:21:27", "text": "なぜなのか、しかし私たちはそうしていない。何てことだ。"}, {"type": "subtitle", "time": 8488.95, "timestamp": "02:21:28", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 8490.79, "timestamp": "02:21:30", "text": "お招きいただきありがとうございます。はい。ありがとう"}, {"type": "subtitle", "time": 8493.91, "timestamp": "02:21:33", "text": "来てくれてありがとう。それは本当に大きな意味があります。感謝"}, {"type": "subtitle", "time": 8508.15, "timestamp": "02:21:48", "text": "何てことだ。今はエキストラのような気分だけど、"}, {"type": "subtitle", "time": 8511.19, "timestamp": "02:21:51", "text": "私は違います。"}, {"type": "chat", "time": 8513.859, "timestamp": "02:21:53", "author": "@Clemency_YT", "avatar": "https://yt4.ggpht.com/rezfMTjQgJnHN8tVRRib6_L8uljH-sirLaERneM0eFXx4IVCDS-_D50zQ3DibKqY-hzBv7-l7w=s64-c-k-c0x00ffffff-no-rj", "message": "but it felt like we had an interaction before xD"}, {"type": "subtitle", "time": 8514.71, "timestamp": "02:21:54", "text": "でも、連絡を取ってよかったと思っています"}, {"type": "subtitle", "time": 8516.55, "timestamp": "02:21:56", "text": "クラムサへ。"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "うん。"}]
[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "そして、もし誰かが今尋ねたら"}, {"type": "subtitle", "time": 423.99, "timestamp": "00:07:03", "text": "もし誰かが私に「あなたは"}, {"type": "subtitle", "time": 426.629, "timestamp": "00:07:06", "text": "YouTuberとかそういうの、私が何をするか"}, {"type": "subtitle", "time": 433.27, "timestamp": "00:07:13", "text": "また、その後"}, {"type": "subtitle", "time": 436.39, "timestamp": "00:07:16", "text": "私は、私が行くようなウォーキングを終えました"}, {"type": "subtitle", "time": 440.71, "timestamp": "00:07:20", "text": "コーヒーを飲むために店に行く。"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "えっと、実際はアウトドアショップみたいな感じですね。えっと"}, {"type": "subtitle", "time": 447.11, "timestamp": "00:07:27", "text": "だから、車を近くに駐車して"}, {"type": "subtitle", "time": 449.749, "timestamp": "00:07:29", "text": "お店の近くで、"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "そんな風にコーヒーを飲むんだ。それで"}, {"type": "subtitle", "time": 454.95, "timestamp": "00:07:34", "text": "えっと"}, {"type": "subtitle", "time": 458.629, "timestamp": "00:07:38", "text": "ええ、コーヒーとか飲みますよ。それで"}, {"type": "subtitle", "time": 461.35, "timestamp": "00:07:41", "text": "問題は、そこにいる人々が"}, {"type": "subtitle", "time": 464.87, "timestamp": "00:07:44", "text": "警察みたいな人がいるだろう、えっと、警察"}, {"type": "subtitle", "time": 469.189, "timestamp": "00:07:49", "text": "警察、人々、警察官ではない"}, {"type": "subtitle", "time": 471.189, "timestamp": "00:07:51", "text": "警察官のような人々"}, {"type": "subtitle", "time": 474.07, "timestamp": "00:07:54", "text": "コーヒーとスナックを食べに来ました"}, {"type": "subtitle", "time": 477.029, "timestamp": "00:07:57", "text": "朝食みたいなもの"}]
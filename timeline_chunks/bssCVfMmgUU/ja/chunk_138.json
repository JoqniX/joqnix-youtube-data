[{"type": "subtitle", "time": 8281.11, "timestamp": "02:18:01", "text": "けれど。そして、出発する前に、"}, {"type": "subtitle", "time": 8282.95, "timestamp": "02:18:02", "text": "何かお知らせや"}, {"type": "subtitle", "time": 8286.309, "timestamp": "02:18:06", "text": "更新またはその他何かご希望があれば"}, {"type": "subtitle", "time": 8289.19, "timestamp": "02:18:09", "text": "共有？"}, {"type": "subtitle", "time": 8292.79, "timestamp": "02:18:12", "text": "ああ、私は計画していたようには思わない"}, {"type": "subtitle", "time": 8296.389, "timestamp": "02:18:16", "text": "私は自分のストリームを配信しているので、"}, {"type": "subtitle", "time": 8300.79, "timestamp": "02:18:20", "text": "ラップトップ。えっと、練習する予定だったんだけど"}, {"type": "subtitle", "time": 8305.349, "timestamp": "02:18:25", "text": "近々ギターを使ったセッションを予定しています。そうそう。"}, {"type": "subtitle", "time": 8308.389, "timestamp": "02:18:28", "text": "あなたのインスタグラムの投稿を見ました"}, {"type": "subtitle", "time": 8310.469, "timestamp": "02:18:30", "text": "そこでは歌を歌い、ギターを演奏します。それ"}, {"type": "subtitle", "time": 8313.589, "timestamp": "02:18:33", "text": "とても良いので、ああ、私は"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "試している。私はまだ勉強中です。"}, {"type": "subtitle", "time": 8317.509, "timestamp": "02:18:37", "text": "[音楽]"}, {"type": "subtitle", "time": 8319.75, "timestamp": "02:18:39", "text": "ストリームではもっとそうするべきだ"}, {"type": "subtitle", "time": 8323.99, "timestamp": "02:18:43", "text": "良い。すごくいいですよ。待ちきれない"}, {"type": "subtitle", "time": 8325.83, "timestamp": "02:18:45", "text": "YouTubeのためのYouTube。でもあなたは"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "カバー曲はもうアップロードしましたか？"}, {"type": "subtitle", "time": 8331.589, "timestamp": "02:18:51", "text": "ギターと一緒にアップロードしていません"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "だって、私はまだ何も学んでいないから。"}, {"type": "subtitle", "time": 8338.87, "timestamp": "02:18:58", "text": "それはまるでいくつかのコードで、"}]
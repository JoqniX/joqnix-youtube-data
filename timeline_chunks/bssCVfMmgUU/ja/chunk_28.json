[{"type": "subtitle", "time": 1680.71, "timestamp": "00:28:00", "text": "これは面白くなりそうだ。"}, {"type": "subtitle", "time": 1684.31, "timestamp": "00:28:04", "text": "えっと、お元気ですか？気味が悪い。この"}, {"type": "subtitle", "time": 1686.87, "timestamp": "00:28:06", "text": "このゲームにはジャンプスケアが多すぎるし、"}, {"type": "subtitle", "time": 1689.35, "timestamp": "00:28:09", "text": "のように"}, {"type": "subtitle", "time": 1693.029, "timestamp": "00:28:13", "text": "あなたを抱きしめる、活気に満ちた意識的なもの"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "それから、あの不気味な子供のやつ。あなた"}, {"type": "subtitle", "time": 1698.95, "timestamp": "00:28:18", "text": "あなたはあの子供を殴り倒すこともできるでしょう。つまり、もし"}, {"type": "subtitle", "time": 1701.99, "timestamp": "00:28:21", "text": "プレイヤーが2人以上いる場合、"}, {"type": "subtitle", "time": 1704.63, "timestamp": "00:28:24", "text": "僕と友達は、"}, {"type": "subtitle", "time": 1707.51, "timestamp": "00:28:27", "text": "まるでそれを投げ回しているようだった。はい、私たちは"}, {"type": "chat", "time": 1707.777, "timestamp": "00:28:27", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yo"}, {"type": "subtitle", "time": 1710.07, "timestamp": "00:28:30", "text": "赤ん坊を殺した。"}, {"type": "subtitle", "time": 1717.269, "timestamp": "00:28:37", "text": "そして、私は自分が苦労したことを知りません"}, {"type": "subtitle", "time": 1719.83, "timestamp": "00:28:39", "text": "目のようなものが、私が見ることができるようにやってきます"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "ほとんどの場合、私は死んでいた目"}, {"type": "subtitle", "time": 1727.269, "timestamp": "00:28:47", "text": "うん、そうだ"}, {"type": "subtitle", "time": 1729.75, "timestamp": "00:28:49", "text": "あなたを招待します"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "そこにいた"}]
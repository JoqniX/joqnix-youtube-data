[{"type": "subtitle", "time": 1389.11, "timestamp": "00:23:09", "text": "それは私が好きなプレイスタイルではありません。"}, {"type": "subtitle", "time": 1391.27, "timestamp": "00:23:11", "text": "では"}, {"type": "subtitle", "time": 1395.43, "timestamp": "00:23:15", "text": "タクティカルシューターとか？あなたは"}, {"type": "subtitle", "time": 1397.99, "timestamp": "00:23:17", "text": "えっと、FPS系のゲームが好きなんですか？私"}, {"type": "subtitle", "time": 1400.63, "timestamp": "00:23:20", "text": "あなたはFPSが好きだと思いますよね？ええ、そうです"}, {"type": "subtitle", "time": 1403.51, "timestamp": "00:23:23", "text": "FPS。私"}, {"type": "subtitle", "time": 1406.39, "timestamp": "00:23:26", "text": "以前は好きではなかったけど、プレイしていない"}, {"type": "subtitle", "time": 1409.029, "timestamp": "00:23:29", "text": "ストーリーモードのゲームのように、ほとんどの"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "昔みたいに、以前みたいに"}, {"type": "subtitle", "time": 1414.549, "timestamp": "00:23:34", "text": "ストリーミングを始めた頃は、"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "そうだった、私は経験がなかった"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "競争とかそういうのが続くまでは"}, {"type": "subtitle", "time": 1429.35, "timestamp": "00:23:49", "text": "私が入った時のこと、特に"}, {"type": "subtitle", "time": 1432.47, "timestamp": "00:23:52", "text": "ムンバイのサーバーは快適ではなかった"}, {"type": "subtitle", "time": 1434.71, "timestamp": "00:23:54", "text": "経験はあったが、同時に私は"}, {"type": "subtitle", "time": 1437.43, "timestamp": "00:23:57", "text": "それにはとても良い思い出がたくさんあります。だから私は"}]
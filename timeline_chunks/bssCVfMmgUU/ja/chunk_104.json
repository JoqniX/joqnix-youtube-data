[{"type": "subtitle", "time": 6246.229, "timestamp": "01:44:06", "text": "すべきだ"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "えーと"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "音量。 1つだけ入れてください。私"}, {"type": "subtitle", "time": 6259.91, "timestamp": "01:44:19", "text": "それが私の自己との遊び方だ。"}, {"type": "subtitle", "time": 6263.03, "timestamp": "01:44:23", "text": "ああ、そういうことか。わかった。わかった。いいえ、それは"}, {"type": "subtitle", "time": 6265.43, "timestamp": "01:44:25", "text": "わかった。今はもう大丈夫です。よし。さあ"}, {"type": "subtitle", "time": 6267.27, "timestamp": "01:44:27", "text": "行く。"}, {"type": "subtitle", "time": 6270.629, "timestamp": "01:44:30", "text": "つまり、これには複数の方法があるということです。"}, {"type": "subtitle", "time": 6273.59, "timestamp": "01:44:33", "text": "どちらをやりたいですか？"}, {"type": "subtitle", "time": 6276.87, "timestamp": "01:44:36", "text": "どれ？保存。ジャンプする必要がある"}, {"type": "subtitle", "time": 6282.709, "timestamp": "01:44:42", "text": "一緒に。これですよね？うん。わかった。ジャンプ。"}, {"type": "subtitle", "time": 6295.51, "timestamp": "01:44:55", "text": "行き詰まってしまった。行き詰まってしまった。行き詰まってしまった。試してみてください"}, {"type": "subtitle", "time": 6299.03, "timestamp": "01:44:59", "text": "引き上げてくれ。あなたは"}]
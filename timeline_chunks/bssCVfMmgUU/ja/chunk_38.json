[{"type": "subtitle", "time": 2280.95, "timestamp": "00:38:00", "text": "そう、そこにアイテムが見えるでしょう。それで、"}, {"type": "subtitle", "time": 2284.39, "timestamp": "00:38:04", "text": "あなたにできることはただ"}, {"type": "subtitle", "time": 2290.31, "timestamp": "00:38:10", "text": "あなたを上に押し上げる。えっと、Qを押してください。"}, {"type": "subtitle", "time": 2296.39, "timestamp": "00:38:16", "text": "ああ、君をそこに載せるよ。"}, {"type": "subtitle", "time": 2304.069, "timestamp": "00:38:24", "text": "何か見えるものはありますか？"}, {"type": "subtitle", "time": 2308.47, "timestamp": "00:38:28", "text": "何も見えない。何もありません。終わってない"}, {"type": "subtitle", "time": 2311.99, "timestamp": "00:38:31", "text": "ここ。そこまで登れるよ。うん、君"}, {"type": "subtitle", "time": 2319.75, "timestamp": "00:38:39", "text": "ええ、気にしないでください。まで上げてみてください"}, {"type": "subtitle", "time": 2328.71, "timestamp": "00:38:48", "text": "私はもう少しであなたのところへ行くところだった。ああ、"}, {"type": "subtitle", "time": 2332.39, "timestamp": "00:38:52", "text": "時間を計らせてください。"}, {"type": "subtitle", "time": 2338.87, "timestamp": "00:38:58", "text": "打ち上げられるなんて思ってもみなかった"}]
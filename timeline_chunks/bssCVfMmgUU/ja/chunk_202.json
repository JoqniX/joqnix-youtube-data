[{"type": "subtitle", "time": 12121.429, "timestamp": "03:22:01", "text": "現在のシーンを選択します"}, {"type": "subtitle", "time": 12130.95, "timestamp": "03:22:10", "text": "えっと、ミュートミュートミュートミュートはどこ？私はできる"}, {"type": "subtitle", "time": 12132.79, "timestamp": "03:22:12", "text": "できます、はい、切り替えることができます。うん。"}, {"type": "subtitle", "time": 12134.87, "timestamp": "03:22:14", "text": "うん。うん。うん。これはうまくいきます。わかった。私たちは"}, {"type": "subtitle", "time": 12136.87, "timestamp": "03:22:16", "text": "切り替え可能にしておけませんか？トグル"}, {"type": "subtitle", "time": 12139.03, "timestamp": "03:22:19", "text": "作品。わかった。つまり、"}, {"type": "subtitle", "time": 12141.99, "timestamp": "03:22:21", "text": "起こるだろう。わかった。もし私がそうでないなら"}, {"type": "subtitle", "time": 12148.63, "timestamp": "03:22:28", "text": "私が話していないときは、表示と非表示が行われます"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "この物。それでは、ここでは"}, {"type": "subtitle", "time": 12156.469, "timestamp": "03:22:36", "text": "チェックを外してください。そのためアイコンは表示されません"}, {"type": "subtitle", "time": 12159.11, "timestamp": "03:22:39", "text": "でも、私が始めると、"}, {"type": "subtitle", "time": 12162.63, "timestamp": "03:22:42", "text": "こんな感じです。これは私が話していることです"}, {"type": "subtitle", "time": 12165.11, "timestamp": "03:22:45", "text": "静かにするとミュートが表示されます"}, {"type": "subtitle", "time": 12173.03, "timestamp": "03:22:53", "text": "そして私が話すとき"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "私が話さないと、"}]
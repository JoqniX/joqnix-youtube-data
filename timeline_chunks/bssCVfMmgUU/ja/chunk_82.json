[{"type": "subtitle", "time": 4921.35, "timestamp": "01:22:01", "text": "Roblox？"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "Robloxのドアのこと。試してみました。"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "それから、恩寵の儀式。やったよ。そして"}, {"type": "subtitle", "time": 4931.91, "timestamp": "01:22:11", "text": "一番怖かったことは何ですか？"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "それらの中で、私が一番怖かったのは何だったか？これ"}, {"type": "subtitle", "time": 4937.43, "timestamp": "01:22:17", "text": "不気味な棒人間みたいなやつ"}, {"type": "subtitle", "time": 4942.95, "timestamp": "01:22:22", "text": "そして大きな結合モンスターが忍び寄ってくる"}, {"type": "subtitle", "time": 4944.95, "timestamp": "01:22:24", "text": "あなたに忍び寄る、そして恵みの人"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "すべて、一つ残らず。ああ、そうだね。"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "私は何を忘れたのか"}, {"type": "subtitle", "time": 4954.87, "timestamp": "01:22:34", "text": "モンスターだったけど、そう、"}, {"type": "subtitle", "time": 4957.75, "timestamp": "01:22:37", "text": "今はペースが速いので、"}, {"type": "subtitle", "time": 4961.91, "timestamp": "01:22:41", "text": "少しはそうだけど、うん。"}, {"type": "subtitle", "time": 4964.47, "timestamp": "01:22:44", "text": "ああ、一体なぜ人々はホラーゲームを作るのだろうか？"}, {"type": "subtitle", "time": 4972.79, "timestamp": "01:22:52", "text": "そう、そうすればみんなが遊んで下手くそになれる"}, {"type": "subtitle", "time": 4976.149, "timestamp": "01:22:56", "text": "ゲームでは「はい」のように。他の奴らを[ __ ]するだけ"}, {"type": "subtitle", "time": 4978.55, "timestamp": "01:22:58", "text": "ゲームだけど、今でもプレイしている。わからない"}, {"type": "subtitle", "time": 4979.77, "timestamp": "01:22:59", "text": "なぜ。"}]
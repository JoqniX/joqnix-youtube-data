[{"type": "subtitle", "time": 6723.99, "timestamp": "01:52:03", "text": "何てことだ。"}, {"type": "subtitle", "time": 6726.709, "timestamp": "01:52:06", "text": "これはすごいことだ。ええ、それはちょっと"}, {"type": "subtitle", "time": 6729.189, "timestamp": "01:52:09", "text": "ストレスが溜まる。"}, {"type": "subtitle", "time": 6742.07, "timestamp": "01:52:22", "text": "これがどうしてなのか不思議に思う"}, {"type": "subtitle", "time": 6744.47, "timestamp": "01:52:24", "text": "鎖で繋がれている。"}, {"type": "subtitle", "time": 6747.03, "timestamp": "01:52:27", "text": "元のチェーンは"}, {"type": "subtitle", "time": 6749.109, "timestamp": "01:52:29", "text": "本当に"}, {"type": "subtitle", "time": 6767.51, "timestamp": "01:52:47", "text": "みんながこれを作ったかどうかはわからない"}, {"type": "subtitle", "time": 6769.43, "timestamp": "01:52:49", "text": "遠い。"}, {"type": "subtitle", "time": 6771.03, "timestamp": "01:52:51", "text": "やったー、私たちは ああ、待って。さらに"}, {"type": "subtitle", "time": 6773.91, "timestamp": "01:52:53", "text": "そこにいる人々。私たちは"}, {"type": "subtitle", "time": 6776.87, "timestamp": "01:52:56", "text": "ここまでたどり着いたのは彼らが最初だった。"}]
[{"type": "subtitle", "time": 7441.43, "timestamp": "02:04:01", "text": "おお、"}, {"type": "subtitle", "time": 7443.27, "timestamp": "02:04:03", "text": "私は死んだ。大丈夫。大丈夫。私は手に入れた"}, {"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "さあ行こう。"}, {"type": "subtitle", "time": 7453.51, "timestamp": "02:04:13", "text": "何てことだ。どうやってそれを成し遂げたのか？さあ"}, {"type": "subtitle", "time": 7456.07, "timestamp": "02:04:16", "text": "近い。"}, {"type": "subtitle", "time": 7461.27, "timestamp": "02:04:21", "text": "私はただWをタップするだけです。"}, {"type": "subtitle", "time": 7498.95, "timestamp": "02:04:58", "text": "十字架と共に。彼らはそこを越えたのか？"}]
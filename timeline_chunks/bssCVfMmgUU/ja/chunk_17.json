[{"type": "subtitle", "time": 1020.47, "timestamp": "00:17:00", "text": "サイトを検索する。まるで"}, {"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "一つも見つからなかった。私が見つけたように"}, {"type": "subtitle", "time": 1026.549, "timestamp": "00:17:06", "text": "サイズは大きいですが、マノが見つかりませんでした"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "探している。うんうん。"}, {"type": "subtitle", "time": 1033.35, "timestamp": "00:17:13", "text": "うん。適切なものを見つけること。だから"}, {"type": "subtitle", "time": 1035.429, "timestamp": "00:17:15", "text": "見せると、時々そうしない"}, {"type": "subtitle", "time": 1037.829, "timestamp": "00:17:17", "text": "出回っているものを入手してください。"}, {"type": "subtitle", "time": 1040.309, "timestamp": "00:17:20", "text": "時々、なんて言うんだっけ？"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "うん。ランダムに選んだもの。"}, {"type": "subtitle", "time": 1045.829, "timestamp": "00:17:25", "text": "うん。のように"}, {"type": "subtitle", "time": 1049.11, "timestamp": "00:17:29", "text": "あまりネタバレはしないでおこうと思うんだけど、"}, {"type": "subtitle", "time": 1051.35, "timestamp": "00:17:31", "text": "私がどんな種類の物を持っているかで判断される"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "わかった。"}, {"type": "subtitle", "time": 1061.43, "timestamp": "00:17:41", "text": "アニメはどうですか？ご覧になっていますか？"}, {"type": "subtitle", "time": 1063.27, "timestamp": "00:17:43", "text": "アニメ？"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "では、マンガはどうでしょうか？マンガ。いいえ、違います"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "マンガも同様です。私はどちらかというと"}]
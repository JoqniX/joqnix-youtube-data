[{"type": "subtitle", "time": 4860.87, "timestamp": "01:21:00", "text": "あなたの電話"}, {"type": "subtitle", "time": 4871.189, "timestamp": "01:21:11", "text": "私がなぜそれを持っているのかについては話さないでください"}, {"type": "subtitle", "time": 4874.95, "timestamp": "01:21:14", "text": "名前。通知は表示されませんでした。"}, {"type": "subtitle", "time": 4878.149, "timestamp": "01:21:18", "text": "あなたは理解していない。"}, {"type": "subtitle", "time": 4881.83, "timestamp": "01:21:21", "text": "ああ、友よ、と私は思う。"}, {"type": "subtitle", "time": 4884.39, "timestamp": "01:21:24", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "えっと、私の雑学。これは何ですか？わかった。"}, {"type": "subtitle", "time": 4889.59, "timestamp": "01:21:29", "text": "受け入れる。それってあなたですよね？"}, {"type": "subtitle", "time": 4896.149, "timestamp": "01:21:36", "text": "えっと"}, {"type": "subtitle", "time": 4898.709, "timestamp": "01:21:38", "text": "私たちは人を裁かない。はい。私たちは話しません"}, {"type": "subtitle", "time": 4919.75, "timestamp": "01:21:59", "text": "どんなホラーゲームをプレイしたことがありますか？"}]
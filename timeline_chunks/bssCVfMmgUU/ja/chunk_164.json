[{"type": "subtitle", "time": 9840.95, "timestamp": "02:44:00", "text": "以前と同じように、あるいはどのように"}, {"type": "subtitle", "time": 9843.03, "timestamp": "02:44:03", "text": "私はそれを失くしてしまうのか？その会社は消滅した。"}, {"type": "chat", "time": 9844.43, "timestamp": "02:44:04", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohhh"}, {"type": "subtitle", "time": 9845.75, "timestamp": "02:44:05", "text": "会社は解散し、撤退した。だから私は"}, {"type": "subtitle", "time": 9847.99, "timestamp": "02:44:07", "text": "無線LAN接続が切断されました。人々は"}, {"type": "subtitle", "time": 9851.11, "timestamp": "02:44:11", "text": "助けてくれたのに、何もかも失ってしまった。それで、"}, {"type": "subtitle", "time": 9853.99, "timestamp": "02:44:13", "text": "私はまだ誰かがいた"}, {"type": "subtitle", "time": 9856.309, "timestamp": "02:44:16", "text": "コラボレーションパートナー"}, {"type": "subtitle", "time": 9859.11, "timestamp": "02:44:19", "text": "コラボパートナー、日本のパートナーの1人、いや"}, {"type": "subtitle", "time": 9861.51, "timestamp": "02:44:21", "text": "私がコラボレーションするCNVチューバーたち。"}, {"type": "subtitle", "time": 9865.83, "timestamp": "02:44:25", "text": "スクリューイー・レイヴンは、私の代理店に尋ねました"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "代理で。彼女はつながることができた"}, {"type": "subtitle", "time": 9870.55, "timestamp": "02:44:30", "text": "彼女は自分の持ち物のために彼らに尋ねた"}, {"type": "subtitle", "time": 9873.11, "timestamp": "02:44:33", "text": "私の荷物を持って、彼らは「あなたは"}, {"type": "subtitle", "time": 9875.269, "timestamp": "02:44:35", "text": "意見を持つ。もっと必要です"}, {"type": "subtitle", "time": 9877.67, "timestamp": "02:44:37", "text": "人々があなたの動画を見に来る、といった感じです。"}, {"type": "subtitle", "time": 9879.51, "timestamp": "02:44:39", "text": "一定数の視聴回数が必要です"}, {"type": "subtitle", "time": 9881.51, "timestamp": "02:44:41", "text": "そして、あなたのチャンネルにあるもの。その時だけ私たち"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "それに対して何かできることがある。見て"}, {"type": "subtitle", "time": 9885.59, "timestamp": "02:44:45", "text": "あなたがアップロードしているコンテンツとは"}, {"type": "subtitle", "time": 9887.59, "timestamp": "02:44:47", "text": "無効とか色々。ほら、君は"}, {"type": "chat", "time": 9888.335, "timestamp": "02:44:48", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ahh"}, {"type": "subtitle", "time": 9890.23, "timestamp": "02:44:50", "text": "中国語の字幕とか付いてるよ。作る"}, {"type": "subtitle", "time": 9892.55, "timestamp": "02:44:52", "text": "あなたの動画はもっと面白くて良いですね。"}, {"type": "subtitle", "time": 9896.15, "timestamp": "02:44:56", "text": "余計なものは何もありません。彼らは、彼らは、彼らは"}, {"type": "subtitle", "time": 9898.469, "timestamp": "02:44:58", "text": "多くの批判的分析を指摘した"}]
[{"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "何てことだ。"}, {"type": "subtitle", "time": 4506.709, "timestamp": "01:15:06", "text": "わかった。待って。はい、スクロールインして"}, {"type": "subtitle", "time": 4509.14, "timestamp": "01:15:09", "text": "商品を近づけてください。"}, {"type": "subtitle", "time": 4510.95, "timestamp": "01:15:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4514.229, "timestamp": "01:15:14", "text": "ああ、ウォルター・ソン、雨をありがとう。"}, {"type": "subtitle", "time": 4517.669, "timestamp": "01:15:17", "text": "レイダースへようこそ。"}, {"type": "subtitle", "time": 4534.87, "timestamp": "01:15:34", "text": "いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 4536.31, "timestamp": "01:15:36", "text": "素敵な一日と素晴らしい"}, {"type": "subtitle", "time": 4538.47, "timestamp": "01:15:38", "text": "ストリーム。ありがとう。あなたも。良い一日を"}]
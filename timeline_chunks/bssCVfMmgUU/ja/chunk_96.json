[{"type": "subtitle", "time": 5762.629, "timestamp": "01:36:02", "text": "それ。そうそう。これはこれのためだけだと思います"}, {"type": "subtitle", "time": 5772.47, "timestamp": "01:36:12", "text": "わかった。なぜ私は"}, {"type": "subtitle", "time": 5785.35, "timestamp": "01:36:25", "text": "[音楽]"}, {"type": "subtitle", "time": 5793.35, "timestamp": "01:36:33", "text": "ああ、エヴァ。私はここにいます。私が見えますか？"}, {"type": "subtitle", "time": 5796.629, "timestamp": "01:36:36", "text": "おやおや。うん。うん。なるほど。"}, {"type": "subtitle", "time": 5800.07, "timestamp": "01:36:40", "text": "ジャンプしてみる。"}, {"type": "chat", "time": 5803.537, "timestamp": "01:36:43", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "thats a new way to enter"}, {"type": "subtitle", "time": 5812.709, "timestamp": "01:36:52", "text": "あれは新しい子だ"}, {"type": "subtitle", "time": 5815.43, "timestamp": "01:36:55", "text": "それらのスキンすべてで。"}]
[{"type": "subtitle", "time": 62.549, "timestamp": "00:01:02", "text": "免疫力が低いため、病気にかかりやすい"}, {"type": "subtitle", "time": 66.07, "timestamp": "00:01:06", "text": "私は推測する。えっと、"}, {"type": "subtitle", "time": 70.71000000000001, "timestamp": "00:01:10", "text": "体に栄養を与えたい"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "えっと、今日の録音に戻りますが"}, {"type": "subtitle", "time": 83.27, "timestamp": "00:01:23", "text": "した。わかった。それで、ジョギングの件は"}, {"type": "subtitle", "time": 87.03, "timestamp": "00:01:27", "text": "良い。ええと、私の声がはっきりと聞こえますし、"}, {"type": "subtitle", "time": 90.31, "timestamp": "00:01:30", "text": "私が足を踏み鳴らす音が聞こえる、"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "小さな「あーあー」という足音。"}, {"type": "subtitle", "time": 96.71000000000001, "timestamp": "00:01:36", "text": "しかし問題は私が"}, {"type": "subtitle", "time": 98.31, "timestamp": "00:01:38", "text": "スクーター、"}, {"type": "subtitle", "time": 100.71000000000001, "timestamp": "00:01:40", "text": "車両の騒音、インジケーターの騒音、"}, {"type": "subtitle", "time": 103.67, "timestamp": "00:01:43", "text": "クラクションの音、周囲の車"}, {"type": "subtitle", "time": 106.38900000000001, "timestamp": "00:01:46", "text": "騒音、ええと、車両の騒音。うん。だから、"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "音声が"}, {"type": "subtitle", "time": 112.789, "timestamp": "00:01:52", "text": "プロデューサー用語で言うなら、ゴメだけど、"}, {"type": "subtitle", "time": 116.469, "timestamp": "00:01:56", "text": "それは何て言うんだっけ？"}]
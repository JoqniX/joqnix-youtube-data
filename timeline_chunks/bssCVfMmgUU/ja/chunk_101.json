[{"type": "subtitle", "time": 6065.6, "timestamp": "01:41:05", "text": "ジャンプ。ジャンプ。ジャンプ。なんてこった。いいえ。いいえ。A。だから 近い。あと少しだったのに。あと少しだったのに。あと少しだったのに。"}, {"type": "subtitle", "time": 6068.96, "timestamp": "01:41:08", "text": "近い。あと少しだったのに。あと少しだったのに。あと少しだったのに。 何てことだ。いいえ。"}, {"type": "subtitle", "time": 6071.44, "timestamp": "01:41:11", "text": "何てことだ。いいえ。 大丈夫。大丈夫。来る。来る。行く。"}, {"type": "subtitle", "time": 6072.96, "timestamp": "01:41:12", "text": "大丈夫。大丈夫。来る。来る。行く。 行く。行く。行く。行く。行く。行く。行く。行く。"}, {"type": "subtitle", "time": 6081.91, "timestamp": "01:41:21", "text": "彼を急がせることはできますか？何てことだ。なぜ私は"}, {"type": "subtitle", "time": 6094.709, "timestamp": "01:41:34", "text": "わかった。ジャンプ。"}, {"type": "subtitle", "time": 6108.23, "timestamp": "01:41:48", "text": "変化させる。"}, {"type": "subtitle", "time": 6109.99, "timestamp": "01:41:49", "text": "[音楽]"}, {"type": "subtitle", "time": 6112.95, "timestamp": "01:41:52", "text": "はい、私はもう行ってしまいました。"}]
[{"type": "subtitle", "time": 5100.709, "timestamp": "01:25:00", "text": "起こりうるかもしれない。 3日前に買った"}, {"type": "subtitle", "time": 5103.27, "timestamp": "01:25:03", "text": "前に、私は予想していなかった"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "君は停電が好きかと思ったよ"}, {"type": "subtitle", "time": 5112.95, "timestamp": "01:25:12", "text": "もしくは、あなたが私に言ったようなこと。うん。"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "うん。うん。都市の何か。えっと、待って。その"}, {"type": "subtitle", "time": 5119.189, "timestamp": "01:25:19", "text": "11時56分ああ、なぜカットしなかったんだろう？私"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "わからない。私は「ああ、彼らは"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "切るつもりだ。」だから、昨日のように"}, {"type": "subtitle", "time": 5125.99, "timestamp": "01:25:25", "text": "月曜日だからカットしなかった"}, {"type": "subtitle", "time": 5128.55, "timestamp": "01:25:28", "text": "昨日と今日。"}, {"type": "subtitle", "time": 5130.87, "timestamp": "01:25:30", "text": "だから、前回何が起こったのかはわからない"}, {"type": "subtitle", "time": 5133.35, "timestamp": "01:25:33", "text": "時間。 ３日間連続で。彼らはいた"}, {"type": "subtitle", "time": 5136.07, "timestamp": "01:25:36", "text": "デルタシティを11時半頃にカットする"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "そして12時30分に再び電源を入れるか"}, {"type": "subtitle", "time": 5141.75, "timestamp": "01:25:41", "text": "何か。"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "うん。ザカ著。はい、私は戻ってきました"}, {"type": "subtitle", "time": 5150.87, "timestamp": "01:25:50", "text": "何をプレイしたいですか？私は手に入れた"}, {"type": "subtitle", "time": 5153.27, "timestamp": "01:25:53", "text": "混乱した。たくさんのものがある"}, {"type": "subtitle", "time": 5158.25, "timestamp": "01:25:58", "text": "君は僕みたいにどれくらい持ってるの？"}]
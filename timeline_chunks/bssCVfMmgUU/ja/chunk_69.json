[{"type": "subtitle", "time": 4146.39, "timestamp": "01:09:06", "text": "ああ、手配しなくてはならない。"}, {"type": "subtitle", "time": 4149.189, "timestamp": "01:09:09", "text": "よし、もっと物が必要だ。ああ、私は今"}, {"type": "subtitle", "time": 4151.51, "timestamp": "01:09:11", "text": "壊したの？ああ、怪物が来た。"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "気をつけて。ここにいてください。そして"}, {"type": "subtitle", "time": 4176.39, "timestamp": "01:09:36", "text": "私は死んだ。"}, {"type": "subtitle", "time": 4194.31, "timestamp": "01:09:54", "text": "何てことだ。まさか死んだなんて言わないで。"}, {"type": "chat", "time": 4195.924, "timestamp": "01:09:55", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "look for the body"}, {"type": "subtitle", "time": 4196.55, "timestamp": "01:09:56", "text": "ええ、私は死にました。"}, {"type": "subtitle", "time": 4199.43, "timestamp": "01:09:59", "text": "いいえ。"}]
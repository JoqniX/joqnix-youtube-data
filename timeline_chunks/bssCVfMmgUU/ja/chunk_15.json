[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "鉄。ああ、大変だ、忘れてた"}, {"type": "subtitle", "time": 905.269, "timestamp": "00:15:05", "text": "名前。鉄血のヘルハウンドまたは"}, {"type": "subtitle", "time": 909.75, "timestamp": "00:15:09", "text": "何か。地獄の番犬。イアン"}, {"type": "subtitle", "time": 911.67, "timestamp": "00:15:11", "text": "えーと"}, {"type": "subtitle", "time": 913.91, "timestamp": "00:15:13", "text": "復讐についてはよくわからない"}, {"type": "subtitle", "time": 917.75, "timestamp": "00:15:17", "text": "何か読んだことがあるけど、ヘルバウンドは読んだことがある。"}, {"type": "subtitle", "time": 920.949, "timestamp": "00:15:20", "text": "ああ、鉄血の鉄の復讐だ"}, {"type": "subtitle", "time": 922.87, "timestamp": "00:15:22", "text": "剣。"}, {"type": "subtitle", "time": 927.509, "timestamp": "00:15:27", "text": "ああ、それは読んでいません。ああ"}, {"type": "subtitle", "time": 929.829, "timestamp": "00:15:29", "text": "はい、名前を送って確認します"}, {"type": "subtitle", "time": 932.55, "timestamp": "00:15:32", "text": "DMで確認できるよ"}, {"type": "subtitle", "time": 934.71, "timestamp": "00:15:34", "text": "後でやります。"}, {"type": "subtitle", "time": 938.23, "timestamp": "00:15:38", "text": "ああ、ヤク"}, {"type": "subtitle", "time": 942.31, "timestamp": "00:15:42", "text": "だから、私は知らないんです。まだ読んでいないので。"}, {"type": "subtitle", "time": 943.99, "timestamp": "00:15:43", "text": "[音楽]"}, {"type": "subtitle", "time": 948.15, "timestamp": "00:15:48", "text": "そういう仮装はたくさんあるよ。"}, {"type": "subtitle", "time": 951.269, "timestamp": "00:15:51", "text": "私は主にロマンス小説などを読んでいます。"}, {"type": "subtitle", "time": 953.189, "timestamp": "00:15:53", "text": "のように"}, {"type": "subtitle", "time": 957.189, "timestamp": "00:15:57", "text": "悪役が好きですか？"}]
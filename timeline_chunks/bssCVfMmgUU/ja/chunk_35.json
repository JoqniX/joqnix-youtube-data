[{"type": "subtitle", "time": 2101.03, "timestamp": "00:35:01", "text": "こんにちは。こんにちは。どうしたの？私はそうなのか、そうではないのか"}, {"type": "subtitle", "time": 2103.19, "timestamp": "00:35:03", "text": "可聴？うん。ええ、あなたならできますよ。その"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "さあ、ゲームを始めよう。近づかなければならない"}, {"type": "subtitle", "time": 2108.79, "timestamp": "00:35:08", "text": "あなたがタイプする音を聞く。ああ、それはああ、"}, {"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "こんにちは。一体何者なんだ？何が"}, {"type": "subtitle", "time": 2115.51, "timestamp": "00:35:15", "text": "あなた？緑色ですか、それとも緑色ですか？ああ、私は私は"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "白。"}, {"type": "subtitle", "time": 2122.55, "timestamp": "00:35:22", "text": "私は何色ですか？あなたも白人ですね。"}, {"type": "subtitle", "time": 2125.51, "timestamp": "00:35:25", "text": "私はそれが欲しい。私はそれを変更できます。私"}, {"type": "subtitle", "time": 2127.829, "timestamp": "00:35:27", "text": "できる"}, {"type": "subtitle", "time": 2130.47, "timestamp": "00:35:30", "text": "ああ、それは変更できますよ。"}, {"type": "subtitle", "time": 2135.349, "timestamp": "00:35:35", "text": "はい。どこですか？ああ、ピンク。ああ、それは"}, {"type": "subtitle", "time": 2143.19, "timestamp": "00:35:43", "text": "私はピンク色？それともピンク色じゃないの？ああ、あなたは"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "ピンク。はい。はい。"}]
[{"type": "subtitle", "time": 18061.83, "timestamp": "05:01:01", "text": "心。うん、あのね？私はただそうではない"}, {"type": "subtitle", "time": 18063.59, "timestamp": "05:01:03", "text": "今すぐ考えなければならない。知っている"}, {"type": "subtitle", "time": 18066.23, "timestamp": "05:01:06", "text": "そうすべきではない。 H 私はただ心配しているだけです"}, {"type": "subtitle", "time": 18069.99, "timestamp": "05:01:09", "text": "舞台裏の話だよ。えっと、"}, {"type": "subtitle", "time": 18072.708, "timestamp": "05:01:12", "text": "そのお金は移動に必要で、"}, {"type": "subtitle", "time": 18075.91, "timestamp": "05:01:15", "text": "進歩のためなら何でも、"}, {"type": "subtitle", "time": 18078.628, "timestamp": "05:01:18", "text": "あなたが知っている。もしジョアトンがうまく働けば、"}, {"type": "chat", "time": 18082.217, "timestamp": "05:01:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "handle it when it happens dude"}, {"type": "subtitle", "time": 18082.39, "timestamp": "05:01:22", "text": "そうだ、それなら私は日本で自由に過ごせる。私"}, {"type": "subtitle", "time": 18085.11, "timestamp": "05:01:25", "text": "人生にきちんと集中できるようになる。私は必要ない"}, {"type": "subtitle", "time": 18089.19, "timestamp": "05:01:29", "text": "3つのパートタイムの仕事など。"}, {"type": "subtitle", "time": 18091.43, "timestamp": "05:01:31", "text": "以前は3つのパートタイムの仕事をしていたとか。"}, {"type": "subtitle", "time": 18093.19, "timestamp": "05:01:33", "text": "もしくはパートタイムの仕事を2つとか、"}, {"type": "subtitle", "time": 18097.19, "timestamp": "05:01:37", "text": "まるで排水のように、自分をすり潰すように"}, {"type": "subtitle", "time": 18099.03, "timestamp": "05:01:39", "text": "負債やその他すべてを返済する"}, {"type": "subtitle", "time": 18102.47, "timestamp": "05:01:42", "text": "モデルも何もかも。いいえ。ええ。しかし"}, {"type": "subtitle", "time": 18105.27, "timestamp": "05:01:45", "text": "ええ、最初の2,000が終わったら、"}, {"type": "subtitle", "time": 18107.11, "timestamp": "05:01:47", "text": "YouTube から稼いだお金、"}, {"type": "subtitle", "time": 18109.19, "timestamp": "05:01:49", "text": "何か今、私は残りのお金が必要です、"}, {"type": "subtitle", "time": 18112.23, "timestamp": "05:01:52", "text": "必要な資産にそれを使わなければならない"}, {"type": "subtitle", "time": 18114.39, "timestamp": "05:01:54", "text": "デビューのために、デビューさせなきゃいけないから"}]
[{"type": "subtitle", "time": 841.91, "timestamp": "00:14:01", "text": "1つ？わかった。最近完了しました"}, {"type": "subtitle", "time": 845.99, "timestamp": "00:14:05", "text": "トゥルル作戦。著者は休養中です"}, {"type": "subtitle", "time": 848.949, "timestamp": "00:14:08", "text": "残念ながら。"}, {"type": "subtitle", "time": 852.949, "timestamp": "00:14:12", "text": "それは、あの武器はひどい状態です。"}, {"type": "subtitle", "time": 855.11, "timestamp": "00:14:15", "text": "他に何か？たくさんあるような"}, {"type": "subtitle", "time": 857.829, "timestamp": "00:14:17", "text": "継続的なウェブ上のトーン。"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "うん。"}, {"type": "subtitle", "time": 867.59, "timestamp": "00:14:27", "text": "わからない。マンガはマンガだと思う"}, {"type": "subtitle", "time": 870.629, "timestamp": "00:14:30", "text": "マンガは違う。ウェブチューンは"}, {"type": "subtitle", "time": 873.75, "timestamp": "00:14:33", "text": "韓国風のカラータイプみたいに、"}, {"type": "subtitle", "time": 878.949, "timestamp": "00:14:38", "text": "右？うん。うん。ああ、マナか。うん。"}, {"type": "subtitle", "time": 883.35, "timestamp": "00:14:43", "text": "ああ、全く分かりません。私はただ知っている"}, {"type": "subtitle", "time": 886.71, "timestamp": "00:14:46", "text": "マンガみたいなものがあるよ。わからない。私"}, {"type": "subtitle", "time": 889.67, "timestamp": "00:14:49", "text": "興味を引くものなら何でも読んでください"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "興味。ああ、それはいいですね。持っていますか？"}, {"type": "subtitle", "time": 897.59, "timestamp": "00:14:57", "text": "鉄を読んでください、えっと、何でしたっけ？復讐"}]
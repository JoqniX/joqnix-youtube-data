[{"type": "subtitle", "time": 15480.71, "timestamp": "04:18:00", "text": "これが表示されない場合は、設定画面に移動してください。"}, {"type": "subtitle", "time": 15483.59, "timestamp": "04:18:03", "text": "設定、詳細設定、"}, {"type": "subtitle", "time": 15486.229, "timestamp": "04:18:06", "text": "開発者モードをオンにしてください。わかった。その時だけ"}, {"type": "subtitle", "time": 15489.59, "timestamp": "04:18:09", "text": "あなたはこれを見ることができます。わかった。"}, {"type": "subtitle", "time": 15492.55, "timestamp": "04:18:12", "text": "それでは、ユーザーIDをコピーしてください。"}, {"type": "subtitle", "time": 15495.51, "timestamp": "04:18:15", "text": "リンク先に戻ってください。"}, {"type": "subtitle", "time": 15503.269, "timestamp": "04:18:23", "text": "他人のIDを使って"}, {"type": "subtitle", "time": 15506.389, "timestamp": "04:18:26", "text": "あなたが望むもの。残りの"}, {"type": "subtitle", "time": 15508.95, "timestamp": "04:18:28", "text": "もの。もしあなたが望むなら、そうすることもできます。もし"}, {"type": "subtitle", "time": 15511.51, "timestamp": "04:18:31", "text": "いいえ、必要ありません。やらなければならない。そして"}, {"type": "subtitle", "time": 15514.71, "timestamp": "04:18:34", "text": "これをするだけでアクティブになります"}, {"type": "subtitle", "time": 15516.469, "timestamp": "04:18:36", "text": "リンク。"}, {"type": "subtitle", "time": 15519.99, "timestamp": "04:18:39", "text": "これはうまくいくでしょう。私もそうしました。または"}, {"type": "subtitle", "time": 15521.67, "timestamp": "04:18:41", "text": "より良いのは、常にグループを使用することです"}, {"type": "subtitle", "time": 15524.95, "timestamp": "04:18:44", "text": "リンク。自動的に更新されます。"}, {"type": "subtitle", "time": 15532.389, "timestamp": "04:18:52", "text": "または、知りたい場合は"}, {"type": "subtitle", "time": 15535.99, "timestamp": "04:18:55", "text": "富士リンク、リアクティブリアクティブに行くだけです"}, {"type": "subtitle", "time": 15538.95, "timestamp": "04:18:58", "text": "フジリアクティブ.フジ.テ."}]
[{"type": "subtitle", "time": 17164.628, "timestamp": "04:46:04", "text": "瞬間"}, {"type": "subtitle", "time": 17170.788, "timestamp": "04:46:10", "text": "あらゆる種類の"}, {"type": "subtitle", "time": 17173.11, "timestamp": "04:46:13", "text": "ランダムな"}, {"type": "subtitle", "time": 17175.11, "timestamp": "04:46:15", "text": "彼らは"}, {"type": "subtitle", "time": 17177.27, "timestamp": "04:46:17", "text": "これらを表示"}, {"type": "subtitle", "time": 17179.43, "timestamp": "04:46:19", "text": "これらの人たちは、"}, {"type": "subtitle", "time": 17184.948, "timestamp": "04:46:24", "text": "これらは、"}, {"type": "subtitle", "time": 17187.03, "timestamp": "04:46:27", "text": "流れ、"}, {"type": "subtitle", "time": 17188.948, "timestamp": "04:46:28", "text": "何かするべきだと思う"}, {"type": "subtitle", "time": 17193.03, "timestamp": "04:46:33", "text": "これは100日目のことです。でも実際は91日目です。"}, {"type": "subtitle", "time": 17195.19, "timestamp": "04:46:35", "text": "私はそうすべきだと思う"}, {"type": "subtitle", "time": 17197.27, "timestamp": "04:46:37", "text": "100日目に投稿すべきか、"}, {"type": "subtitle", "time": 17199.83, "timestamp": "04:46:39", "text": "何か。しかし、やはり賭けざるを得ない。"}, {"type": "subtitle", "time": 17202.628, "timestamp": "04:46:42", "text": "待って、今日は92年だ。"}, {"type": "subtitle", "time": 17209.03, "timestamp": "04:46:49", "text": "92 93 94 95 96 97 98 99 100 19位"}, {"type": "subtitle", "time": 17218.708, "timestamp": "04:46:58", "text": "[音楽]"}]
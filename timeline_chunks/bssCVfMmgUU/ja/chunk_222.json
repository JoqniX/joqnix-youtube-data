[{"type": "subtitle", "time": 13322.95, "timestamp": "03:42:02", "text": "ほら、私が気づいたことの一つは、"}, {"type": "subtitle", "time": 13326.469, "timestamp": "03:42:06", "text": "私の雰囲気は誰とでもうまくやっていけるかな？"}, {"type": "subtitle", "time": 13329.349, "timestamp": "03:42:09", "text": "あらゆる異なる異なるI"}, {"type": "subtitle", "time": 13332.469, "timestamp": "03:42:12", "text": "これまで多くの人々とコラボレーションしてきました"}, {"type": "subtitle", "time": 13334.389, "timestamp": "03:42:14", "text": "それぞれ異なる雰囲気を持っている。"}, {"type": "subtitle", "time": 13337.429, "timestamp": "03:42:17", "text": "さまざまなタイプのサイレントタイプ"}, {"type": "subtitle", "time": 13341.349, "timestamp": "03:42:21", "text": "あまり話さないタイプ。うーんハイパー"}, {"type": "subtitle", "time": 13344.87, "timestamp": "03:42:24", "text": "エネルギッシュなタイプと追い越しタイプ。 A"}, {"type": "subtitle", "time": 13347.19, "timestamp": "03:42:27", "text": "実に様々なタイプの人々。いいえ、"}, {"type": "subtitle", "time": 13351.11, "timestamp": "03:42:31", "text": "会話好きなタイプの人たちですよね？"}, {"type": "subtitle", "time": 13353.83, "timestamp": "03:42:33", "text": "私はみんなと仲良くできるかな？"}, {"type": "subtitle", "time": 13355.51, "timestamp": "03:42:35", "text": "もの？"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "私はそんなに話しやすくて気楽な人間ですか？"}, {"type": "subtitle", "time": 13359.83, "timestamp": "03:42:39", "text": "と？"}, {"type": "subtitle", "time": 13366.92, "timestamp": "03:42:46", "text": "ああ、神様。"}, {"type": "subtitle", "time": 13369.99, "timestamp": "03:42:49", "text": "[音楽]"}]
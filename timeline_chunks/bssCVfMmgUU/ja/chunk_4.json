[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "だから、電話をストラップで固定しなければならなかった"}, {"type": "subtitle", "time": 243.35, "timestamp": "00:04:03", "text": "私の肘。待って。肘。いいえ。腕。待って。"}, {"type": "subtitle", "time": 246.55, "timestamp": "00:04:06", "text": "いいえ。手。いいえ。それを何と呼ぶのですか？"}, {"type": "subtitle", "time": 249.50900000000001, "timestamp": "00:04:09", "text": "あなたのこの物の一部ですか？えっと、何"}, {"type": "subtitle", "time": 251.91, "timestamp": "00:04:11", "text": "それをフレックスと呼ぶんだ"}, {"type": "subtitle", "time": 253.50900000000001, "timestamp": "00:04:13", "text": "筋肉とかそういうやつ？それは何ですか"}, {"type": "subtitle", "time": 256.469, "timestamp": "00:04:16", "text": "体の部位が再び呼ばれましたか？アーム。"}, {"type": "subtitle", "time": 259.189, "timestamp": "00:04:19", "text": "いいえ。腕とは腕全体のことです。いいえ。いいえ。手。"}, {"type": "subtitle", "time": 262.15, "timestamp": "00:04:22", "text": "いいえ。そして、待つことになります。"}, {"type": "subtitle", "time": 264.629, "timestamp": "00:04:24", "text": "それを何と呼ぶ？上腕。うん。ありがとう。"}, {"type": "subtitle", "time": 268.23, "timestamp": "00:04:28", "text": "上腕。うん。だから、私はストラップを締めなければならない"}, {"type": "subtitle", "time": 271.749, "timestamp": "00:04:31", "text": "二の腕にあるものだと思います。なぜならもし"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "まるで自分の"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "普段のように見てください"}, {"type": "subtitle", "time": 280.95, "timestamp": "00:04:40", "text": "散歩道。問題はいつ"}, {"type": "subtitle", "time": 283.749, "timestamp": "00:04:43", "text": "ジョギングをしています、それはまるで"}, {"type": "subtitle", "time": 287.03, "timestamp": "00:04:47", "text": "Bが好きで、震えすぎるのも好き。しかし"}, {"type": "subtitle", "time": 290.469, "timestamp": "00:04:50", "text": "問題は、現在唯一の問題は"}, {"type": "subtitle", "time": 294.23, "timestamp": "00:04:54", "text": "チャットを読むことができません。何"}, {"type": "subtitle", "time": 297.59000000000003, "timestamp": "00:04:57", "text": "チャットでは何をすればいいですか？"}]
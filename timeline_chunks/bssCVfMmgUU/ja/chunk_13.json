[{"type": "subtitle", "time": 785.91, "timestamp": "00:13:05", "text": "では、おそらく、"}, {"type": "subtitle", "time": 789.19, "timestamp": "00:13:09", "text": "兄のような年上の兄弟。"}, {"type": "subtitle", "time": 791.11, "timestamp": "00:13:11", "text": "うん。"}, {"type": "subtitle", "time": 794.55, "timestamp": "00:13:14", "text": "いつもマーベルをプレイしているのを見かけます"}, {"type": "subtitle", "time": 798.55, "timestamp": "00:13:18", "text": "ライバルとかヴァルとか、そういうの。うわぁ、"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "クレメンスは筋金入りのゲーマーだ。"}, {"type": "subtitle", "time": 806.23, "timestamp": "00:13:26", "text": "常にその苦闘の中にいる。ええ、私は"}, {"type": "subtitle", "time": 809.11, "timestamp": "00:13:29", "text": "その件に関しては、私は連敗していた"}, {"type": "subtitle", "time": 811.269, "timestamp": "00:13:31", "text": "最後にドライバーをプレイしたのはいつだったか。私は"}, {"type": "subtitle", "time": 813.59, "timestamp": "00:13:33", "text": "「いや、絶対やらないよ」"}, {"type": "subtitle", "time": 819.35, "timestamp": "00:13:39", "text": "ヴァレントについても同じことが言える。私は遊んでいました"}, {"type": "subtitle", "time": 821.35, "timestamp": "00:13:41", "text": "ヴァレント。私はひどく負けていた"}, {"type": "subtitle", "time": 823.269, "timestamp": "00:13:43", "text": "連勝。私は「いや、私には"}, {"type": "subtitle", "time": 826.87, "timestamp": "00:13:46", "text": "平和。私は休暇を無駄にしない"}, {"type": "subtitle", "time": 829.43, "timestamp": "00:13:49", "text": "連敗"}, {"type": "subtitle", "time": 831.59, "timestamp": "00:13:51", "text": "そして今、読書にハマっているんです。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "私はマンガやウェブを読んでいます"}, {"type": "subtitle", "time": 837.91, "timestamp": "00:13:57", "text": "曲。ああ、どれのことですか？ウェブ上の楽曲。どれの"}]
[{"type": "subtitle", "time": 7503.35, "timestamp": "02:05:03", "text": "私は知りたいです。彼らが落ちているのが見える"}, {"type": "subtitle", "time": 7505.35, "timestamp": "02:05:05", "text": "このような。"}, {"type": "subtitle", "time": 7508.149, "timestamp": "02:05:08", "text": "見て。"}, {"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "わかった。"}, {"type": "subtitle", "time": 7516.0, "timestamp": "02:05:16", "text": "どうすればいいですか？ 一番良い渡る方法は？"}, {"type": "subtitle", "time": 7517.27, "timestamp": "02:05:17", "text": "[音楽]"}, {"type": "subtitle", "time": 7520.629, "timestamp": "02:05:20", "text": "延長二段跳び。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "はぁ？"}, {"type": "subtitle", "time": 7525.589, "timestamp": "02:05:25", "text": "わかった。少し。"}, {"type": "subtitle", "time": 7528.709, "timestamp": "02:05:28", "text": "わかった。三つ。私が言うとき"}, {"type": "subtitle", "time": 7532.39, "timestamp": "02:05:32", "text": "ジャンプして、前に進んで全力疾走する。わかった。"}, {"type": "subtitle", "time": 7534.709, "timestamp": "02:05:34", "text": "わかった。わかった。何が起ころうとも、"}, {"type": "subtitle", "time": 7543.35, "timestamp": "02:05:43", "text": "はい。はい。はい。はい。ああ。なんてこった。その"}, {"type": "subtitle", "time": 7544.87, "timestamp": "02:05:44", "text": "わかった。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 7548.95, "timestamp": "02:05:48", "text": "わかった。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 7552.39, "timestamp": "02:05:52", "text": "私は立ち直った。うん。私たちは追い出された"}, {"type": "subtitle", "time": 7554.47, "timestamp": "02:05:54", "text": "戻る。"}, {"type": "subtitle", "time": 7558.79, "timestamp": "02:05:58", "text": "それは不公平だ。それは不公平だ。おお、あなたは"}]
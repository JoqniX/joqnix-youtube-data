[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "趣味から読書などまで。おお、"}, {"type": "subtitle", "time": 607.75, "timestamp": "00:10:07", "text": "えーと、VTingはどうですか？あなたは"}, {"type": "subtitle", "time": 609.43, "timestamp": "00:10:09", "text": "ストリーミング配信？そうそう。あなたは"}, {"type": "subtitle", "time": 611.509, "timestamp": "00:10:11", "text": "ストリーミング配信ですよね？"}, {"type": "subtitle", "time": 614.87, "timestamp": "00:10:14", "text": "うん。でも、あまり持っていないので"}, {"type": "subtitle", "time": 618.47, "timestamp": "00:10:18", "text": "設定していたので、ストリーミング配信はしていませんでした。"}, {"type": "subtitle", "time": 620.9, "timestamp": "00:10:20", "text": "数ヶ月のようだ。"}, {"type": "subtitle", "time": 624.389, "timestamp": "00:10:24", "text": "[音楽]"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "だから、それが私たちに向けられたものであることを願っています。私は"}, {"type": "subtitle", "time": 629.509, "timestamp": "00:10:29", "text": "好奇心旺盛。"}, {"type": "subtitle", "time": 631.75, "timestamp": "00:10:31", "text": "もう一つのやつはどうなったの？なぜ"}, {"type": "subtitle", "time": 635.43, "timestamp": "00:10:35", "text": "あなたはオレンジ色に変身したのですか？"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "どうしたの？あなたは生まれ変わったのですか？"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "魔女。えっと、つまり、それは魔女なんです。私"}, {"type": "subtitle", "time": 646.71, "timestamp": "00:10:46", "text": "彼女は親切な人だと思った。彼女は私を呪った。"}, {"type": "subtitle", "time": 650.949, "timestamp": "00:10:50", "text": "そして今、私はオレンジだ。なんてこった。そして私は"}, {"type": "subtitle", "time": 654.31, "timestamp": "00:10:54", "text": "宇宙人に戻る方法がわからない"}, {"type": "subtitle", "time": 657.03, "timestamp": "00:10:57", "text": "また。"}]
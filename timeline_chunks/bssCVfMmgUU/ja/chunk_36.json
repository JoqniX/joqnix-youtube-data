[{"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "わかった。良い。わかった。さて、よし。電話。えっと、"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "良い。ええと、電話は。大丈夫。誰も"}, {"type": "subtitle", "time": 2171.91, "timestamp": "00:36:11", "text": "私たちにさせてくれてありがとう"}, {"type": "subtitle", "time": 2179.99, "timestamp": "00:36:19", "text": "物を充電する。でも、どうやって装備すればいいの？"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "それを押したままEキーを押してください。"}, {"type": "subtitle", "time": 2184.47, "timestamp": "00:36:24", "text": "おお、"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "わーい。やったね。さて、タブキーを押すと、"}, {"type": "subtitle", "time": 2190.79, "timestamp": "00:36:30", "text": "アップグレード内容が表示されます。"}, {"type": "subtitle", "time": 2201.829, "timestamp": "00:36:41", "text": "右？"}, {"type": "subtitle", "time": 2205.27, "timestamp": "00:36:45", "text": "うん。私は大丈夫です。私たちは走る必要があります。うん。"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "いいえ。ええ。走ることは唯一の"}, {"type": "subtitle", "time": 2212.23, "timestamp": "00:36:52", "text": "ああ、わかりました。"}]
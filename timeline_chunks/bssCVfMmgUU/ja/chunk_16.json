[{"type": "subtitle", "time": 961.509, "timestamp": "00:16:01", "text": "マナス物語の種類は？ああ、私はまだ"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "それらを読んでください。私はただそれらを読むのが好きです"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "今は、ゆっくりとした優しいロマンスを。素晴らしい。"}, {"type": "subtitle", "time": 971.99, "timestamp": "00:16:11", "text": "うん。"}, {"type": "subtitle", "time": 980.68, "timestamp": "00:16:20", "text": "えっと"}, {"type": "subtitle", "time": 984.31, "timestamp": "00:16:24", "text": "[音楽]"}, {"type": "subtitle", "time": 986.949, "timestamp": "00:16:26", "text": "私は思う"}, {"type": "subtitle", "time": 990.23, "timestamp": "00:16:30", "text": "私は何かを読んだ。名前を忘れてしまった"}, {"type": "subtitle", "time": 993.59, "timestamp": "00:16:33", "text": "それの。以前はよくここに行っていました"}, {"type": "subtitle", "time": 997.269, "timestamp": "00:16:37", "text": "人間とウェブを読むための非公式サイト"}, {"type": "subtitle", "time": 1001.03, "timestamp": "00:16:41", "text": "曲。だから、流行っているものは何でも"}, {"type": "subtitle", "time": 1005.11, "timestamp": "00:16:45", "text": "読む。私は友達にメールを送っていた"}, {"type": "subtitle", "time": 1008.629, "timestamp": "00:16:48", "text": "教えて、わかった、私は読む必要があるけど、できない"}, {"type": "subtitle", "time": 1012.79, "timestamp": "00:16:52", "text": "閲覧するには違法なサイトであることが判明しました。私は"}, {"type": "subtitle", "time": 1015.11, "timestamp": "00:16:55", "text": "のように"}, {"type": "subtitle", "time": 1018.15, "timestamp": "00:16:58", "text": "Redditを見てみた"}]
[{"type": "subtitle", "time": 4623.189, "timestamp": "01:17:03", "text": "走れ、走れ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 4624.79, "timestamp": "01:17:04", "text": "うん。ただ逃げろ。逃げる。逃げる。"}, {"type": "subtitle", "time": 4627.199, "timestamp": "01:17:07", "text": "逃げる。 何てことだ。"}, {"type": "subtitle", "time": 4629.28, "timestamp": "01:17:09", "text": "何てことだ。 地図を確認してください。ああ、神様。なぜそこにあるのですか？"}, {"type": "subtitle", "time": 4632.48, "timestamp": "01:17:12", "text": "地図を確認してください。ああ、神様。なぜそこにあるのですか？ なぜ逃げているのか？"}, {"type": "subtitle", "time": 4638.79, "timestamp": "01:17:18", "text": "あなたの後ろにいます。あなたの後ろにいます。あなたの後ろにいます。走る。"}, {"type": "subtitle", "time": 4642.87, "timestamp": "01:17:22", "text": "走る。走る。走る。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 4645.35, "timestamp": "01:17:25", "text": "ああ、神様。お前は死んだ。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 4647.35, "timestamp": "01:17:27", "text": "ああ、大丈夫ですよ。大丈夫。うん。うん。"}, {"type": "subtitle", "time": 4652.47, "timestamp": "01:17:32", "text": "行く。行く。行く。行く。行く。行く。行く。行く。ああ、神様。"}, {"type": "subtitle", "time": 4661.83, "timestamp": "01:17:41", "text": "それなら、振り返ってみろ。うん。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 4663.189, "timestamp": "01:17:43", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 4664.719, "timestamp": "01:17:44", "text": "いいえ。 死なないでください。死なないでください。"}, {"type": "subtitle", "time": 4667.84, "timestamp": "01:17:47", "text": "死なないでください。死なないでください。 おお。"}, {"type": "subtitle", "time": 4677.27, "timestamp": "01:17:57", "text": "大丈夫。"}]
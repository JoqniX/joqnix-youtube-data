[{"type": "subtitle", "time": 13144.229, "timestamp": "03:39:04", "text": "コラボレーションのようなもの。"}, {"type": "subtitle", "time": 13150.68, "timestamp": "03:39:10", "text": "話したり一緒に過ごしたりするのは本当に楽しかった"}, {"type": "subtitle", "time": 13152.389, "timestamp": "03:39:12", "text": "[音楽]"}, {"type": "subtitle", "time": 13154.389, "timestamp": "03:39:14", "text": "e"}, {"type": "subtitle", "time": 13156.63, "timestamp": "03:39:16", "text": "彼女は本当に"}, {"type": "subtitle", "time": 13171.83, "timestamp": "03:39:31", "text": "チャットする。私は妻たちを本当に愛していました"}, {"type": "subtitle", "time": 13175.19, "timestamp": "03:39:35", "text": "そして私たちは"}, {"type": "subtitle", "time": 13178.63, "timestamp": "03:39:38", "text": "私たちはさまざまなことについて話しました"}, {"type": "subtitle", "time": 13181.67, "timestamp": "03:39:41", "text": "トピックと"}, {"type": "subtitle", "time": 13183.83, "timestamp": "03:39:43", "text": "共有された"}, {"type": "subtitle", "time": 13186.79, "timestamp": "03:39:46", "text": "お互いの"}, {"type": "subtitle", "time": 13189.429, "timestamp": "03:39:49", "text": "物語"}, {"type": "subtitle", "time": 13194.389, "timestamp": "03:39:54", "text": "そしてある意味で私たちは知り合ったような気がします"}, {"type": "subtitle", "time": 13198.469, "timestamp": "03:39:58", "text": "お互いに"}]
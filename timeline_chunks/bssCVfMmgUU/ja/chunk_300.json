[{"type": "subtitle", "time": 18000.868, "timestamp": "05:00:00", "text": "そんなことは絶対に起こらない。だから、"}, {"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "大丈夫。私は考える必要すらありません"}, {"type": "subtitle", "time": 18018.23, "timestamp": "05:00:18", "text": "問題は、今私が決めなければならないことです"}, {"type": "subtitle", "time": 18021.99, "timestamp": "05:00:21", "text": "モデルに関すること。実は、"}, {"type": "subtitle", "time": 18024.23, "timestamp": "05:00:24", "text": "このモデルには多くの問題がある"}, {"type": "subtitle", "time": 18027.91, "timestamp": "05:00:27", "text": "そして私は「どうしたらいいのかわからない」という感じでした。"}, {"type": "subtitle", "time": 18029.99, "timestamp": "05:00:29", "text": "もしあなたが誰か"}, {"type": "subtitle", "time": 18032.628, "timestamp": "05:00:32", "text": "Disanのコラボを見たよ、君は"}, {"type": "subtitle", "time": 18036.15, "timestamp": "05:00:36", "text": "ディサンが私にどれだけ話していたかを見るために"}, {"type": "subtitle", "time": 18040.23, "timestamp": "05:00:40", "text": "彼が言及した多くのこと"}, {"type": "subtitle", "time": 18042.31, "timestamp": "05:00:42", "text": "それは本当です。私は対処しなければならない"}, {"type": "subtitle", "time": 18045.75, "timestamp": "05:00:45", "text": "誰かが指摘すれば、疑惑は"}, {"type": "subtitle", "time": 18047.59, "timestamp": "05:00:47", "text": "人為的ミスとかそういう類のこと"}, {"type": "subtitle", "time": 18051.03, "timestamp": "05:00:51", "text": "右？だから私はこう思った、「おい、俺は何をすればいいんだ？」"}, {"type": "subtitle", "time": 18052.708, "timestamp": "05:00:52", "text": "この点ですか？"}, {"type": "subtitle", "time": 18056.07, "timestamp": "05:00:56", "text": "私がしたかったのはただ確保することだけだった"}, {"type": "subtitle", "time": 18059.27, "timestamp": "05:00:59", "text": "現時点では、私自身のモデルとなっている。私はしません"}]
[{"type": "subtitle", "time": 3600.23, "timestamp": "01:00:00", "text": "あれこそが怪物だ。もしあなたがもしあなたが"}, {"type": "subtitle", "time": 3605.75, "timestamp": "01:00:05", "text": "彼をここに留めておいて。ああ、これだ。わかった。わかった。"}, {"type": "subtitle", "time": 3610.069, "timestamp": "01:00:10", "text": "おお。ああ、引きずっていけると思うよ。うん。"}, {"type": "subtitle", "time": 3613.03, "timestamp": "01:00:13", "text": "その"}, {"type": "subtitle", "time": 3614.789, "timestamp": "01:00:14", "text": "プラグ"}, {"type": "subtitle", "time": 3618.23, "timestamp": "01:00:18", "text": "自分。私はそうは思わない。私たちは置くことができます"}, {"type": "subtitle", "time": 3621.349, "timestamp": "01:00:21", "text": "はい、設置できます。"}, {"type": "chat", "time": 3621.568, "timestamp": "01:00:21", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "if you throw the chalice on the storage board does it still loses value"}, {"type": "subtitle", "time": 3623.589, "timestamp": "01:00:23", "text": "置くことができます"}, {"type": "subtitle", "time": 3627.589, "timestamp": "01:00:27", "text": "この中で。警備員にはいないと思う、"}, {"type": "subtitle", "time": 3638.309, "timestamp": "01:00:38", "text": "1秒。調整させてください。"}, {"type": "subtitle", "time": 3647.43, "timestamp": "01:00:47", "text": "えっと、どうやって回転させればいいんですか？それは間違いです。"}, {"type": "subtitle", "time": 3649.51, "timestamp": "01:00:49", "text": "私はそれを殺そうとしているのか？ああ、いや、いや、いや、"}, {"type": "subtitle", "time": 3654.39, "timestamp": "01:00:54", "text": "いや、いや。どうやって持ち上げればいいですか？"}, {"type": "subtitle", "time": 3659.51, "timestamp": "01:00:59", "text": "何かお手伝いしましょうか？いいえ。どのように機能するのですか？"}]
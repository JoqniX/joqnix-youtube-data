[{"type": "subtitle", "time": 6364.79, "timestamp": "01:46:04", "text": "いいえ。"}, {"type": "subtitle", "time": 6367.99, "timestamp": "01:46:07", "text": "ああ、私たちは今どこにいるんだろう？ここはどこですか？我々は持っています"}, {"type": "subtitle", "time": 6371.27, "timestamp": "01:46:11", "text": "やり直す。"}, {"type": "subtitle", "time": 6373.91, "timestamp": "01:46:13", "text": "最初からやり直さなければならない。"}, {"type": "subtitle", "time": 6376.229, "timestamp": "01:46:16", "text": "えっと、"}, {"type": "subtitle", "time": 6377.83, "timestamp": "01:46:17", "text": "いいえ。"}, {"type": "subtitle", "time": 6380.07, "timestamp": "01:46:20", "text": "向こうに飛び移ってもいいですか？"}, {"type": "subtitle", "time": 6383.75, "timestamp": "01:46:23", "text": "あの岩か何か？"}, {"type": "subtitle", "time": 6385.669, "timestamp": "01:46:25", "text": "何てことだ。"}, {"type": "subtitle", "time": 6393.99, "timestamp": "01:46:33", "text": "待って、それは省略してもいいよ。見えますか"}, {"type": "subtitle", "time": 6396.47, "timestamp": "01:46:36", "text": "鎖？"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "私はそうは思わない。私たちは手に入れるつもりです"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "立ち往生"}, {"type": "subtitle", "time": 6404.47, "timestamp": "01:46:44", "text": "それについて。ああ、できればいいんだけど"}, {"type": "subtitle", "time": 6407.189, "timestamp": "01:46:47", "text": "行くのではなく、好きになれたらいいのに"}, {"type": "subtitle", "time": 6410.149, "timestamp": "01:46:50", "text": "ずっと下まで。いいえ、"}, {"type": "subtitle", "time": 6414.55, "timestamp": "01:46:54", "text": "私たちはやって来る。そうそう。やってくる。そして"}]
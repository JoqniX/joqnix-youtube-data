[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "ああ、ジャンプを連打すれば見えるよ。それで"}, {"type": "subtitle", "time": 7326.31, "timestamp": "02:02:06", "text": "タイミングをうまく計らないといけないよね？ああ、"}, {"type": "subtitle", "time": 7328.39, "timestamp": "02:02:08", "text": "神。タイミングをうまく計る。私たちはそうしなければならないと思う"}, {"type": "subtitle", "time": 7338.07, "timestamp": "02:02:18", "text": "はい、こちらへ来てください。戻る"}, {"type": "subtitle", "time": 7340.79, "timestamp": "02:02:20", "text": "私の立場について。"}, {"type": "subtitle", "time": 7345.51, "timestamp": "02:02:25", "text": "はい、Shiftキーを押したままにしてください。わかった。わかった。"}, {"type": "subtitle", "time": 7348.709, "timestamp": "02:02:28", "text": "三つ。あのね？私たちはここにいて"}, {"type": "subtitle", "time": 7350.709, "timestamp": "02:02:30", "text": "そしてジャンプする。"}, {"type": "subtitle", "time": 7359.43, "timestamp": "02:02:39", "text": "数えてください。"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "わかった。カウント。右。つまり、３つですね。行くよ"}, {"type": "subtitle", "time": 7364.39, "timestamp": "02:02:44", "text": "から来るものと共に"}, {"type": "subtitle", "time": 7370.229, "timestamp": "02:02:50", "text": "トップ。三つ。二。 1つ。ジャンプ。ああ。"}, {"type": "subtitle", "time": 7373.03, "timestamp": "02:02:53", "text": "ほとんど。ほとんど。ほとんど。ああ。"}, {"type": "subtitle", "time": 7375.91, "timestamp": "02:02:55", "text": "おお。大丈夫。大丈夫。大丈夫。試す"}, {"type": "subtitle", "time": 7378.55, "timestamp": "02:02:58", "text": "そうだ、その方向へ向かう。うん。うん。"}]
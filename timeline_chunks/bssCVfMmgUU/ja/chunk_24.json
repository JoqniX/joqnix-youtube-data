[{"type": "subtitle", "time": 1440.63, "timestamp": "00:24:00", "text": "それほどひどいとは言わない。"}, {"type": "subtitle", "time": 1442.87, "timestamp": "00:24:02", "text": "ああ、ムンバイではプレイしないよ"}, {"type": "subtitle", "time": 1446.47, "timestamp": "00:24:06", "text": "サーバー。それはやりすぎだ。"}, {"type": "subtitle", "time": 1450.07, "timestamp": "00:24:10", "text": "怖いですね。確かに恐ろしいですね。それは"}, {"type": "subtitle", "time": 1454.71, "timestamp": "00:24:14", "text": "怖い。本当に怖いし、怖いです"}, {"type": "subtitle", "time": 1458.23, "timestamp": "00:24:18", "text": "マイクをオンにすることさえできない。悪い"}, {"type": "subtitle", "time": 1460.63, "timestamp": "00:24:20", "text": "オープニングマイクなどの経験。だから私は"}, {"type": "subtitle", "time": 1463.11, "timestamp": "00:24:23", "text": "「ああ、絶対に開かないよ」って感じだった"}, {"type": "subtitle", "time": 1465.99, "timestamp": "00:24:25", "text": "マロールのマイク、そして特に"}, {"type": "subtitle", "time": 1470.07, "timestamp": "00:24:30", "text": "ムンバイでのサービスは決してありません。ええ、"}, {"type": "subtitle", "time": 1471.909, "timestamp": "00:24:31", "text": "レディ"}, {"type": "subtitle", "time": 1475.269, "timestamp": "00:24:35", "text": "ええ、マガジンを開けるたびに"}, {"type": "subtitle", "time": 1478.47, "timestamp": "00:24:38", "text": "キッチンに行くと、"}, {"type": "subtitle", "time": 1481.669, "timestamp": "00:24:41", "text": "キッチンに私を入れたいなんて、それは安全じゃない"}, {"type": "subtitle", "time": 1485.75, "timestamp": "00:24:45", "text": "誰にとっても、私にとっても"}, {"type": "subtitle", "time": 1488.71, "timestamp": "00:24:48", "text": "家を焼き払う。"}, {"type": "subtitle", "time": 1491.19, "timestamp": "00:24:51", "text": "あなたは間違った人に頼んでいます"}, {"type": "subtitle", "time": 1494.07, "timestamp": "00:24:54", "text": "キッチン。では、なぜ彼らはそんなことを言うのでしょうか？"}]
[{"type": "subtitle", "time": 1748.71, "timestamp": "00:29:08", "text": "招待状は届きましたか？"}, {"type": "subtitle", "time": 1757.029, "timestamp": "00:29:17", "text": "こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "僕もそう思うよ"}, {"type": "subtitle", "time": 1764.07, "timestamp": "00:29:24", "text": "ゲームのようにしないで"}, {"type": "subtitle", "time": 1765.909, "timestamp": "00:29:25", "text": "範囲。"}, {"type": "subtitle", "time": 1769.51, "timestamp": "00:29:29", "text": "えっと、つまり、あなたにとってどちらが良いですか？何"}, {"type": "subtitle", "time": 1772.07, "timestamp": "00:29:32", "text": "あなたは何をしたいですか？"}, {"type": "subtitle", "time": 1773.99, "timestamp": "00:29:33", "text": "つまり、もっと楽しいのは"}, {"type": "subtitle", "time": 1777.909, "timestamp": "00:29:37", "text": "ゲーム。さらに怒鳴り声が響く。うん、"}, {"type": "subtitle", "time": 1782.87, "timestamp": "00:29:42", "text": "さらに怒鳴り声が響く。こんにちは。よし、やってみよう。えっと、私は"}, {"type": "subtitle", "time": 1786.389, "timestamp": "00:29:46", "text": "Discordで会いましょう。だからそれは"}, {"type": "subtitle", "time": 1789.11, "timestamp": "00:29:49", "text": "いや、いや、いや。待って。私は私は"}, {"type": "subtitle", "time": 1791.029, "timestamp": "00:29:51", "text": "ユーザーボリュームを下げて"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "ゲーム内で話すときなどは"}]
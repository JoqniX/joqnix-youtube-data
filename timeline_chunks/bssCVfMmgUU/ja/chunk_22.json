[{"type": "subtitle", "time": 1321.35, "timestamp": "00:22:01", "text": "これは、"}, {"type": "subtitle", "time": 1325.43, "timestamp": "00:22:05", "text": "ロースト。おお。"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "私はあなたたち全員に夢中だった。それから私の"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "友人たちが私をヴァレラントに連れて行ってくれた。私はまだ"}, {"type": "subtitle", "time": 1339.59, "timestamp": "00:22:19", "text": "あのゲーム、大嫌い。私がそれをプレイするのは"}, {"type": "subtitle", "time": 1344.95, "timestamp": "00:22:24", "text": "こんにちは。"}, {"type": "subtitle", "time": 1348.39, "timestamp": "00:22:28", "text": "私は、ええと、ちょっと夢中になっているような感じで大好きです"}, {"type": "subtitle", "time": 1352.789, "timestamp": "00:22:32", "text": "ゾンビホラーゲーム付き。"}, {"type": "subtitle", "time": 1354.31, "timestamp": "00:22:34", "text": "おお"}, {"type": "subtitle", "time": 1357.75, "timestamp": "00:22:37", "text": "はい、ゾンビゲームが大好きです。"}, {"type": "subtitle", "time": 1360.07, "timestamp": "00:22:40", "text": "うん。"}, {"type": "subtitle", "time": 1363.27, "timestamp": "00:22:43", "text": "そして、彼らが"}, {"type": "subtitle", "time": 1366.07, "timestamp": "00:22:46", "text": "私の友達は、"}, {"type": "subtitle", "time": 1368.789, "timestamp": "00:22:48", "text": "彼らが私を紹介しようとするなら"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "新しい人を紹介してくれと彼らは言う"}, {"type": "subtitle", "time": 1373.19, "timestamp": "00:22:53", "text": "彼女は幽霊を誘惑する人で、私は"}, {"type": "subtitle", "time": 1376.87, "timestamp": "00:22:56", "text": "すみません、なぜ私は有名になったのですか？"}]
[{"type": "subtitle", "time": 6547.109, "timestamp": "01:49:07", "text": "うん。"}, {"type": "subtitle", "time": 6549.669, "timestamp": "01:49:09", "text": "ほら、今度はこうできるよ"}, {"type": "subtitle", "time": 6558.229, "timestamp": "01:49:18", "text": "ああ、私を引き上げてみて。"}, {"type": "subtitle", "time": 6562.39, "timestamp": "01:49:22", "text": "私は飛び降ります。"}, {"type": "subtitle", "time": 6566.709, "timestamp": "01:49:26", "text": "何てことだ。わかりました、行きます。うん。いいえ、いいえ、"}, {"type": "subtitle", "time": 6569.189, "timestamp": "01:49:29", "text": "いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 6571.27, "timestamp": "01:49:31", "text": "それは不可能か何かだと思う。"}, {"type": "subtitle", "time": 6574.79, "timestamp": "01:49:34", "text": "待って。えっと、試してみて"}, {"type": "subtitle", "time": 6578.55, "timestamp": "01:49:38", "text": "ええ、やってみますが、そうですね。 1秒。"}, {"type": "subtitle", "time": 6580.79, "timestamp": "01:49:40", "text": "私がいる場所にいてみてください"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "立っている。"}, {"type": "subtitle", "time": 6585.109, "timestamp": "01:49:45", "text": "わかった。わかった。もう十分だ。わかった。わかった。"}, {"type": "subtitle", "time": 6588.87, "timestamp": "01:49:48", "text": "私は飛び降りるつもりだ。わかった。わかった。どこに"}, {"type": "subtitle", "time": 6590.39, "timestamp": "01:49:50", "text": "ラグってる？"}]
[{"type": "subtitle", "time": 2.71, "timestamp": "00:00:02", "text": "ストーリーテリングって本当に壊れてるよね"}, {"type": "subtitle", "time": 5.269, "timestamp": "00:00:05", "text": "今は興奮しているから。ごめんなさい。私は"}, {"type": "subtitle", "time": 7.67, "timestamp": "00:00:07", "text": "まだ作業中です。もしあなたが"}, {"type": "subtitle", "time": 9.75, "timestamp": "00:00:09", "text": "トレーニングアーク、私たちはいつかシックスパックを手に入れることができるのだろうか？"}, {"type": "chat", "time": 10.234, "timestamp": "00:00:10", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight's Guest - Clemency | https://x.com/duhitsclem | https://www.youtube.com/@Clemency_rig... | https://www.instagram.com/clemency_th... "}, {"type": "subtitle", "time": 12.15, "timestamp": "00:00:12", "text": "腹筋版のジョック？"}, {"type": "subtitle", "time": 16.39, "timestamp": "00:00:16", "text": "ふむ、不思議だ"}, {"type": "subtitle", "time": 26.55, "timestamp": "00:00:26", "text": "だって、私はそうじゃないし、すごく"}, {"type": "subtitle", "time": 29.509, "timestamp": "00:00:29", "text": "痩せていて、もし人が私を見たら"}, {"type": "subtitle", "time": 32.63, "timestamp": "00:00:32", "text": "何か食べ物を食べてください、なぜ、なぜ"}, {"type": "subtitle", "time": 36.229, "timestamp": "00:00:36", "text": "食べ物を食べないジョック"}, {"type": "subtitle", "time": 39.51, "timestamp": "00:00:39", "text": "彼らはそう言うから、私はセックスを知らない"}, {"type": "subtitle", "time": 41.75, "timestamp": "00:00:41", "text": "など"}, {"type": "subtitle", "time": 46.31, "timestamp": "00:00:46", "text": "つまり、健康な体は良い"}, {"type": "subtitle", "time": 49.83, "timestamp": "00:00:49", "text": "メンタリティと良い考え方 いいえ、たぶん"}, {"type": "subtitle", "time": 51.91, "timestamp": "00:00:51", "text": "いいえ、私は望みません"}, {"type": "subtitle", "time": 54.069, "timestamp": "00:00:54", "text": "6つくらいの事実をまとめてください。私はただ自分の体が欲しい"}, {"type": "subtitle", "time": 56.15, "timestamp": "00:00:56", "text": "健康であること"}, {"type": "subtitle", "time": 58.549, "timestamp": "00:00:58", "text": "私は"}]
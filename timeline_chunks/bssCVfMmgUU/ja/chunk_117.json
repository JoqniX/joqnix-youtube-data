[{"type": "subtitle", "time": 7021.75, "timestamp": "01:57:01", "text": "おお。何てことだ。"}, {"type": "subtitle", "time": 7024.31, "timestamp": "01:57:04", "text": "来て。"}, {"type": "subtitle", "time": 7036.95, "timestamp": "01:57:16", "text": "おお、"}, {"type": "subtitle", "time": 7055.75, "timestamp": "01:57:35", "text": "ああ、私には回転しているように見える。"}, {"type": "subtitle", "time": 7058.47, "timestamp": "01:57:38", "text": "何てことだ。何てことだ。私たちは何をしなければならないのか"}, {"type": "subtitle", "time": 7060.55, "timestamp": "01:57:40", "text": "する？なんてこった。"}, {"type": "subtitle", "time": 7064.07, "timestamp": "01:57:44", "text": "どうすればいいのでしょうか？"}, {"type": "subtitle", "time": 7065.91, "timestamp": "01:57:45", "text": "H"}, {"type": "subtitle", "time": 7068.149, "timestamp": "01:57:48", "text": "同時に。"}, {"type": "subtitle", "time": 7070.55, "timestamp": "01:57:50", "text": "よし、他の人に任せよう"}, {"type": "subtitle", "time": 7079.589, "timestamp": "01:57:59", "text": "ああ、でも、死にかけの群衆がいるよ。"}]
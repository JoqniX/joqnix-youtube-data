[{"type": "subtitle", "time": 300.87, "timestamp": "00:05:00", "text": "それが私の疑問です。何をすればいいのでしょうか"}, {"type": "subtitle", "time": 304.39, "timestamp": "00:05:04", "text": "私はします？私は何をしますか？まあ、私は"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "別の電話を持ってきてください。"}, {"type": "subtitle", "time": 310.469, "timestamp": "00:05:10", "text": "ジョギングみたいな感じで、"}, {"type": "subtitle", "time": 312.79, "timestamp": "00:05:12", "text": "こういう時に私は"}, {"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "視線モニターか何かがあればよかったのに"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "あなたも知っているように"}, {"type": "subtitle", "time": 321.27, "timestamp": "00:05:21", "text": "えっと、あの、あの、"}, {"type": "subtitle", "time": 323.83, "timestamp": "00:05:23", "text": "寿司ドラゴンは、あなたが"}, {"type": "subtitle", "time": 326.07, "timestamp": "00:05:26", "text": "外科医療分野か何か"}, {"type": "subtitle", "time": 327.99, "timestamp": "00:05:27", "text": "手術か何かをしているのなら"}, {"type": "subtitle", "time": 330.71, "timestamp": "00:05:30", "text": "AIベースのもののように、"}, {"type": "subtitle", "time": 334.95, "timestamp": "00:05:34", "text": "医者と一緒にこれを着る"}, {"type": "subtitle", "time": 336.71, "timestamp": "00:05:36", "text": "ガラス製の何か。完全なものではない"}, {"type": "subtitle", "time": 338.95, "timestamp": "00:05:38", "text": "眼鏡。片目だけです。それ"}, {"type": "subtitle", "time": 341.83, "timestamp": "00:05:41", "text": "ウィンドウのような画面、"}, {"type": "subtitle", "time": 344.71, "timestamp": "00:05:44", "text": "中に何か入っていて、ただ着るだけ"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "それを見れば、まるで"}, {"type": "subtitle", "time": 349.11, "timestamp": "00:05:49", "text": "セカンドモニターを見ているか、"}, {"type": "subtitle", "time": 351.59000000000003, "timestamp": "00:05:51", "text": "何か。うん。うん。私もそれが欲しい"}, {"type": "subtitle", "time": 353.749, "timestamp": "00:05:53", "text": "もの、"}, {"type": "subtitle", "time": 356.95, "timestamp": "00:05:56", "text": "でもそれは現実世界で、インドなので、"}, {"type": "subtitle", "time": 358.469, "timestamp": "00:05:58", "text": "なれ"}]
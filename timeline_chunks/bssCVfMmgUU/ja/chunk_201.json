[{"type": "subtitle", "time": 12061.429, "timestamp": "03:21:01", "text": "出力ボリュームはこの物より上にあります"}, {"type": "subtitle", "time": 12070.71, "timestamp": "03:21:10", "text": "ええと、わかりました。私はこれをどうやったのか忘れてしまった"}, {"type": "subtitle", "time": 12074.55, "timestamp": "03:21:14", "text": "再び動作するようになった。ちょっと待ってください。えっと、移動"}, {"type": "subtitle", "time": 12076.87, "timestamp": "03:21:16", "text": "選択接続が切断されました。わかった、"}, {"type": "subtitle", "time": 12079.03, "timestamp": "03:21:19", "text": "待って。これとこれをリンクするにはどうすればいいですか？"}, {"type": "subtitle", "time": 12086.15, "timestamp": "03:21:26", "text": "倍量作らないといけないかもしれない"}, {"type": "subtitle", "time": 12090.55, "timestamp": "03:21:30", "text": "これに関するマクロ。さて、ショーに出演している1人がいます"}, {"type": "subtitle", "time": 12093.59, "timestamp": "03:21:33", "text": "PNG州。もう1つは、"}, {"type": "subtitle", "time": 12107.349, "timestamp": "03:21:47", "text": "つまり、あなたが探しているのはシーンアイテムです"}, {"type": "subtitle", "time": 12118.95, "timestamp": "03:21:58", "text": "私は探しています"}]
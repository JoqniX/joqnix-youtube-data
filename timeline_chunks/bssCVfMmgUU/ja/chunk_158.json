[{"type": "subtitle", "time": 9481.59, "timestamp": "02:38:01", "text": "来週、物事が順調に進み、"}, {"type": "subtitle", "time": 9483.83, "timestamp": "02:38:03", "text": "みんなで撮った集合写真を載せた"}, {"type": "subtitle", "time": 9486.87, "timestamp": "02:38:06", "text": "誰とコラボしたかとか、そういうことだよね"}, {"type": "subtitle", "time": 9489.83, "timestamp": "02:38:09", "text": "それが私のやるべきことだった。"}, {"type": "subtitle", "time": 9492.15, "timestamp": "02:38:12", "text": "しかし今は"}, {"type": "subtitle", "time": 9495.91, "timestamp": "02:38:15", "text": "その計画はもうなくなってしまった。"}, {"type": "subtitle", "time": 9501.51, "timestamp": "02:38:21", "text": "だから私は、「どうすればいいんだろう？」と思ったんです。私はまだ欲しい"}, {"type": "subtitle", "time": 9504.87, "timestamp": "02:38:24", "text": "私はまだグループ写真を撮らなければならない"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "みんなと一緒に、"}, {"type": "subtitle", "time": 9509.51, "timestamp": "02:38:29", "text": "みんなのモデルを入れたりして。その"}, {"type": "subtitle", "time": 9511.67, "timestamp": "02:38:31", "text": "私自身のイベントのようなものになるでしょう、"}, {"type": "subtitle", "time": 9514.15, "timestamp": "02:38:34", "text": "チャンネルイベントですよね？"}, {"type": "chat", "time": 9514.663, "timestamp": "02:38:34", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "now the photo would be even bigger"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "また、確認する必要があるのは"}, {"type": "chat", "time": 9522.654, "timestamp": "02:38:42", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "than how it was like"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "きっと人々は"}, {"type": "chat", "time": 9526.464, "timestamp": "02:38:46", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "now"}, {"type": "subtitle", "time": 9528.309, "timestamp": "02:38:48", "text": "うん。これで写真がさらに大きくなります。"}, {"type": "subtitle", "time": 9530.79, "timestamp": "02:38:50", "text": "うん。また"}, {"type": "subtitle", "time": 9534.87, "timestamp": "02:38:54", "text": "フィードバック投稿も参照してください。誰かが"}, {"type": "subtitle", "time": 9536.55, "timestamp": "02:38:56", "text": "誰でも"}]
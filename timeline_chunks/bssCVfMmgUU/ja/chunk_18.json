[{"type": "subtitle", "time": 1081.43, "timestamp": "00:18:01", "text": "韓国ドラマの出演者みたい。韓国ドラマ。待って、何？"}, {"type": "subtitle", "time": 1083.99, "timestamp": "00:18:03", "text": "Kをちょっと試してみたいのですが"}, {"type": "subtitle", "time": 1086.23, "timestamp": "00:18:06", "text": "ドラマチックな展開。あなたは何をしますか？"}, {"type": "subtitle", "time": 1089.909, "timestamp": "00:18:09", "text": "Kドラマ初心者におすすめの作品は？私は"}, {"type": "subtitle", "time": 1092.549, "timestamp": "00:18:12", "text": "ホラー以外ならどんなジャンルでも大丈夫です。私"}, {"type": "subtitle", "time": 1099.59, "timestamp": "00:18:19", "text": "わかった。もしあなたがロマンスが好きで、"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "感覚的には、今は夏だ。私たちの"}, {"type": "subtitle", "time": 1104.87, "timestamp": "00:18:24", "text": "愛する、私たちの愛する夏。とても"}, {"type": "subtitle", "time": 1106.549, "timestamp": "00:18:26", "text": "良い。"}, {"type": "subtitle", "time": 1109.029, "timestamp": "00:18:29", "text": "ああ、私たちの愛する"}, {"type": "subtitle", "time": 1111.75, "timestamp": "00:18:31", "text": "私たちの愛する夏。"}, {"type": "subtitle", "time": 1114.549, "timestamp": "00:18:34", "text": "私たちは愛しています"}, {"type": "subtitle", "time": 1117.35, "timestamp": "00:18:37", "text": "夏。ああ、これだ。それは"}, {"type": "subtitle", "time": 1120.63, "timestamp": "00:18:40", "text": "すぐにググれる。ああ、これだ。それは"}, {"type": "subtitle", "time": 1125.19, "timestamp": "00:18:45", "text": "三角関係？それが見えるとき"}, {"type": "subtitle", "time": 1131.669, "timestamp": "00:18:51", "text": "愛を見たいなら"}, {"type": "subtitle", "time": 1133.99, "timestamp": "00:18:53", "text": "三角形１、それは真の美しさであり、"}, {"type": "subtitle", "time": 1138.549, "timestamp": "00:18:58", "text": "好きです、それは、えーと"}]
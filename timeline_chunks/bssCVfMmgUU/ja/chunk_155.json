[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "ジョッカソン。"}, {"type": "subtitle", "time": 9304.23, "timestamp": "02:35:04", "text": "これは今すぐ変えなければならない。あなたは思う"}, {"type": "subtitle", "time": 9307.75, "timestamp": "02:35:07", "text": "ジョアトン1.0とか2.0って呼ぶべきかな"}, {"type": "subtitle", "time": 9310.23, "timestamp": "02:35:10", "text": "それとも何か別のこと？いや、いや、いや。問題は"}, {"type": "subtitle", "time": 9314.07, "timestamp": "02:35:14", "text": "ジョックマラソンはいつの時代も続くでしょう。えっと、"}, {"type": "subtitle", "time": 9316.23, "timestamp": "02:35:16", "text": "ただそれは"}, {"type": "subtitle", "time": 9318.309, "timestamp": "02:35:18", "text": "つまり、ジョッカソンという名前は使用できます"}, {"type": "subtitle", "time": 9320.55, "timestamp": "02:35:20", "text": "今後の安息日とかのために。それは"}, {"type": "subtitle", "time": 9323.91, "timestamp": "02:35:23", "text": "なぜ2025年と書いたかというと、"}, {"type": "subtitle", "time": 9326.55, "timestamp": "02:35:26", "text": "一年中そういう感じ"}, {"type": "chat", "time": 9328.792, "timestamp": "02:35:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "let's keep it like that the name"}, {"type": "subtitle", "time": 9331.67, "timestamp": "02:35:31", "text": "考える。ええと、でもある意味では私たちは"}, {"type": "subtitle", "time": 9335.99, "timestamp": "02:35:35", "text": "それを丸一年間続けるつもりだ。それで"}, {"type": "subtitle", "time": 9338.309, "timestamp": "02:35:38", "text": "その名前のままにしておいてください。うん。うん。"}, {"type": "subtitle", "time": 9340.399, "timestamp": "02:35:40", "text": "うん。 資金調達目標を設定しました"}, {"type": "subtitle", "time": 9344.96, "timestamp": "02:35:44", "text": "資金調達目標を設定しました えーと"}, {"type": "subtitle", "time": 9351.27, "timestamp": "02:35:51", "text": "えっと、でも6月以降は引っ越す予定です"}, {"type": "subtitle", "time": 9354.55, "timestamp": "02:35:54", "text": "日本が新たな章を切り開く。"}, {"type": "subtitle", "time": 9356.389, "timestamp": "02:35:56", "text": "ああ、州を書かなければならない"}, {"type": "subtitle", "time": 9359.75, "timestamp": "02:35:59", "text": "公式声明ですよね？ H"}]
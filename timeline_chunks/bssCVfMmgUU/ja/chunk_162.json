[{"type": "subtitle", "time": 9720.309, "timestamp": "02:42:00", "text": "私のパソコン関係はちょっと厄介です。したい"}, {"type": "subtitle", "time": 9724.07, "timestamp": "02:42:04", "text": "いくつか試してみます。"}, {"type": "subtitle", "time": 9726.95, "timestamp": "02:42:06", "text": "垂直多重リーミング。"}, {"type": "subtitle", "time": 9730.469, "timestamp": "02:42:10", "text": "今度は垂直方向のマルチリーミング加工をしたいです。"}, {"type": "subtitle", "time": 9733.59, "timestamp": "02:42:13", "text": "やりすぎだって分かってるけど、うん"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "なぜだめですか？私はそれがどのように"}, {"type": "subtitle", "time": 9738.71, "timestamp": "02:42:18", "text": "もし私が自分のチャンネルをより良く成長させることができれば"}, {"type": "subtitle", "time": 9741.51, "timestamp": "02:42:21", "text": "もっといいですよね。縦向きで試してみたいです。"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "ストリーミング"}, {"type": "subtitle", "time": 9745.27, "timestamp": "02:42:25", "text": "しかし問題はお金の問題だ"}, {"type": "subtitle", "time": 9748.79, "timestamp": "02:42:28", "text": "いや、待って、無料でできるよ。"}, {"type": "chat", "time": 9748.799, "timestamp": "02:42:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah"}, {"type": "subtitle", "time": 9751.91, "timestamp": "02:42:31", "text": "ビームストリームを使って、それができるように"}, {"type": "subtitle", "time": 9754.469, "timestamp": "02:42:34", "text": "つまり、私が望むことは"}, {"type": "subtitle", "time": 9758.55, "timestamp": "02:42:38", "text": "OBSの設定を刷新する必要があるので、"}, {"type": "subtitle", "time": 9762.23, "timestamp": "02:42:42", "text": "いくつか物を取り除かなければならないし、"}, {"type": "subtitle", "time": 9765.11, "timestamp": "02:42:45", "text": "ビリー、ビリー、何か手に入れなきゃ"}, {"type": "subtitle", "time": 9768.309, "timestamp": "02:42:48", "text": "ビリー・ビリーについて何とかしてくれ。私はまだ"}, {"type": "subtitle", "time": 9770.55, "timestamp": "02:42:50", "text": "頑張っています。私は、えーと、"}, {"type": "subtitle", "time": 9772.309, "timestamp": "02:42:52", "text": "紹介ビデオ。始めなければならない"}, {"type": "subtitle", "time": 9776.309, "timestamp": "02:42:56", "text": "今は動画制作とか色々やってるんだよね？"}, {"type": "subtitle", "time": 9778.87, "timestamp": "02:42:58", "text": "つまり、多くのことがかかっているということですね。"}]
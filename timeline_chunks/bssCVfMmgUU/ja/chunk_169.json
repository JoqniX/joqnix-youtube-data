[{"type": "subtitle", "time": 10145.75, "timestamp": "02:49:05", "text": "私はできる限りのことをすべてやっています。"}, {"type": "subtitle", "time": 10155.269, "timestamp": "02:49:15", "text": "そして、それだけでは十分ではない。私は感じます"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "おそらく私が価値を認めていないから"}, {"type": "subtitle", "time": 10159.51, "timestamp": "02:49:19", "text": "自分自身とか、そういう類のもの。わからない。しかし"}, {"type": "chat", "time": 10162.271, "timestamp": "02:49:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey listen listen hard work always payoff I learned it hard way dude doing everything you can right now is the best 👌"}, {"type": "chat", "time": 10168.831, "timestamp": "02:49:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "no one is perfect alright"}, {"type": "subtitle", "time": 10174.79, "timestamp": "02:49:34", "text": "問題は、もしかしたら私は"}, {"type": "subtitle", "time": 10177.429, "timestamp": "02:49:37", "text": "この勤勉のパターンに従うと、"}, {"type": "subtitle", "time": 10180.63, "timestamp": "02:49:40", "text": "オフとか、何か。いつか努力が"}, {"type": "subtitle", "time": 10182.95, "timestamp": "02:49:42", "text": "一種の返済のようなものですが、"}, {"type": "subtitle", "time": 10186.87, "timestamp": "02:49:46", "text": "必ずしもそうとは限らない"}, {"type": "subtitle", "time": 10189.75, "timestamp": "02:49:49", "text": "方法。もしかしたら私は"}, {"type": "subtitle", "time": 10194.07, "timestamp": "02:49:54", "text": "より賢く働くこと、より一生懸命働くこと。"}, {"type": "subtitle", "time": 10196.389, "timestamp": "02:49:56", "text": "あなたが知っている、"}, {"type": "subtitle", "time": 10199.67, "timestamp": "02:49:59", "text": "それが理由かもしれない"}]
[{"type": "subtitle", "time": 7140.95, "timestamp": "01:59:00", "text": "えっと、"}, {"type": "subtitle", "time": 7144.95, "timestamp": "01:59:04", "text": "ボビー、ダメだよ。いいえ。なぜですか？なぜ彼女を使うのか"}, {"type": "subtitle", "time": 7147.99, "timestamp": "01:59:07", "text": "名前？わからない。これはとても"}, {"type": "subtitle", "time": 7152.47, "timestamp": "01:59:12", "text": "ストレスが溜まる。私が壊したのを見てください"}, {"type": "subtitle", "time": 7154.229, "timestamp": "01:59:14", "text": "ボス"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "ああ、なんてことだ。わからない。"}, {"type": "subtitle", "time": 7161.51, "timestamp": "01:59:21", "text": "タイミングを計る必要がある。なぜこのゲームなのか？"}, {"type": "subtitle", "time": 7171.35, "timestamp": "01:59:31", "text": "わかった。では、私たちはどのように、"}, {"type": "subtitle", "time": 7174.87, "timestamp": "01:59:34", "text": "私たちは全力疾走し、全力疾走し、ジャンプする。"}, {"type": "subtitle", "time": 7185.99, "timestamp": "01:59:45", "text": "入力させてください"}, {"type": "subtitle", "time": 7194.79, "timestamp": "01:59:54", "text": "わかった。じゃあ、えーと、えーと、私はこう言うことにします"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "やってみて。ここに来て。とにかくやってみろ、とだけ言っておこう。"}, {"type": "subtitle", "time": 7199.75, "timestamp": "01:59:59", "text": "所有"}]
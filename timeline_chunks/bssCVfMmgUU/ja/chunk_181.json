[{"type": "subtitle", "time": 10860.309, "timestamp": "03:01:00", "text": "そうするの？人々はそれを"}, {"type": "subtitle", "time": 10862.55, "timestamp": "03:01:02", "text": "農業"}, {"type": "subtitle", "time": 10866.63, "timestamp": "03:01:06", "text": "犬はただ農業をしているだけです"}, {"type": "subtitle", "time": 10868.389, "timestamp": "03:01:08", "text": "私にはわからない。私は人々に"}, {"type": "subtitle", "time": 10871.269, "timestamp": "03:01:11", "text": "何かを言う"}, {"type": "subtitle", "time": 10873.67, "timestamp": "03:01:13", "text": "もちろん、終了する選択肢はあります"}, {"type": "subtitle", "time": 10876.23, "timestamp": "03:01:16", "text": "ストリームを開始し、通常どおりストリームを開始します"}, {"type": "subtitle", "time": 10879.75, "timestamp": "03:01:19", "text": "しかし、またもや私はバカみたいに言った"}, {"type": "chat", "time": 10881.23, "timestamp": "03:01:21", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "listen dude don't be mad not many people care as you think they do"}, {"type": "subtitle", "time": 10883.349, "timestamp": "03:01:23", "text": "24時間それを続けるつもりです"}, {"type": "subtitle", "time": 10885.83, "timestamp": "03:01:25", "text": "十分な休憩を取りながら、"}, {"type": "subtitle", "time": 10890.87, "timestamp": "03:01:30", "text": "休息と流れが"}, {"type": "subtitle", "time": 10893.269, "timestamp": "03:01:33", "text": "悪いことをしないで。あなたほど気にかけてくれる人は多くない"}, {"type": "subtitle", "time": 10896.71, "timestamp": "03:01:36", "text": "彼らは気にしないと思う"}, {"type": "subtitle", "time": 10900.55, "timestamp": "03:01:40", "text": "うーん、いや、それはむしろ軌道を設定するようなものだ"}, {"type": "subtitle", "time": 10902.71, "timestamp": "03:01:42", "text": "今すぐ録画"}, {"type": "subtitle", "time": 10905.19, "timestamp": "03:01:45", "text": "部外者の視点で考えてみてください"}, {"type": "subtitle", "time": 10906.79, "timestamp": "03:01:46", "text": "視点"}, {"type": "subtitle", "time": 10909.75, "timestamp": "03:01:49", "text": "あなたは私のことを全く知らない、あなたは誰か"}, {"type": "chat", "time": 10913.09, "timestamp": "03:0
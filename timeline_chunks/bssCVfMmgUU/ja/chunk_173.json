[{"type": "subtitle", "time": 10384.389, "timestamp": "02:53:04", "text": "彼が叫ぶのが聞こえたほど大きな声だった。はい、私は"}, {"type": "subtitle", "time": 10388.389, "timestamp": "02:53:08", "text": "ここまで来たと思う"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "そして、1 2 3 4 5 6 7 8 9 をアップロードしなければなりません"}, {"type": "subtitle", "time": 10396.309, "timestamp": "02:53:16", "text": "10 11 11 クリップ。"}, {"type": "subtitle", "time": 10398.389, "timestamp": "02:53:18", "text": "そしてTwitch。"}, {"type": "subtitle", "time": 10400.23, "timestamp": "02:53:20", "text": "誰かがクリップを作ったかどうかはわかりません"}, {"type": "subtitle", "time": 10403.19, "timestamp": "02:53:23", "text": "それ以来Twitchから離れて、"}, {"type": "subtitle", "time": 10406.07, "timestamp": "02:53:26", "text": "しかし、Twitchの場合はそうではない。"}, {"type": "subtitle", "time": 10407.59, "timestamp": "02:53:27", "text": "えっと、"}, {"type": "subtitle", "time": 10410.309, "timestamp": "02:53:30", "text": "これはどちらかというと"}, {"type": "subtitle", "time": 10413.19, "timestamp": "02:53:33", "text": "うん、Twitchにはあまりクリップがないね。"}, {"type": "subtitle", "time": 10416.07, "timestamp": "02:53:36", "text": "えっと、これ、私が作ったと思う。わからない。"}, {"type": "subtitle", "time": 10417.99, "timestamp": "02:53:37", "text": "まあ、Twitchですね。"}, {"type": "subtitle", "time": 10420.23, "timestamp": "02:53:40", "text": "あぁ、ちょっと待って、待って、待って、待って。そこには"}, {"type": "subtitle", "time": 10423.269, "timestamp": "02:53:43", "text": "いくつかあります。彼は怠け者だと思うよ、みんな。"}, {"type": "chat", "time": 10423.738, "timestamp": "02:53:43", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "do you know kiwi shio"}, {"type": "subtitle", "time": 10424.95, "timestamp": "02:53:44", "text": "うんうんうん、いくつかあるよ"}, {"type": "subtitle", "time": 10428.79, "timestamp": "02:53:48", "text": "トゥイッチ。 1つだけ仕上げなければならない"}, {"type": "subtitle", "time": 10432.87, "timestamp": "02:53:52", "text": "または2つ。ええ、そうですね。岸尾さんを知っていますか？"}]
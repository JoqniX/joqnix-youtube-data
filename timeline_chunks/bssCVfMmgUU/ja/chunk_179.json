[{"type": "subtitle", "time": 10742.469, "timestamp": "02:59:02", "text": "そうすべきでしょうか？問題は、ジョッカソン"}, {"type": "subtitle", "time": 10744.95, "timestamp": "02:59:04", "text": "通常のジョッカソン配信のように"}, {"type": "subtitle", "time": 10750.389, "timestamp": "02:59:10", "text": "JocknがVをプレイしているように見える"}, {"type": "subtitle", "time": 10753.75, "timestamp": "02:59:13", "text": "彼の配信のことですよね？想像してみてください"}, {"type": "subtitle", "time": 10757.19, "timestamp": "02:59:17", "text": "あなたの、何がより良いか知っていますか？"}, {"type": "subtitle", "time": 10759.19, "timestamp": "02:59:19", "text": "説明はこうなります。どこ"}, {"type": "subtitle", "time": 10761.75, "timestamp": "02:59:21", "text": "報酬ですか？"}, {"type": "subtitle", "time": 10764.71, "timestamp": "02:59:24", "text": "えっと"}, {"type": "subtitle", "time": 10767.03, "timestamp": "02:59:27", "text": "うん、えっと、ちょっと待って"}, {"type": "subtitle", "time": 10770.23, "timestamp": "02:59:30", "text": "共有埋め込み。"}, {"type": "subtitle", "time": 10775.03, "timestamp": "02:59:35", "text": "埋め込みリンクをコピーしてください。ここにコピー＆ペーストしてください。"}, {"type": "subtitle", "time": 10778.07, "timestamp": "02:59:38", "text": "こうなるだろう。"}, {"type": "subtitle", "time": 10785.269, "timestamp": "02:59:45", "text": "全画面表示にしてください。それは"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "このような。これは盾みたいなものです。これ"}, {"type": "subtitle", "time": 10790.309, "timestamp": "02:59:50", "text": "シールドみたいなものです。私と来て。ジョン"}, {"type": "subtitle", "time": 10793.19, "timestamp": "02:59:53", "text": "ヨアトンの上にヨアトンを演じる。おお、"}, {"type": "subtitle", "time": 10795.75, "timestamp": "02:59:55", "text": "わかった。はい、はい、はい。"}, {"type": "subtitle", "time": 10798.389, "timestamp": "02:59:58", "text": "これが品質を見る基準です。"}]
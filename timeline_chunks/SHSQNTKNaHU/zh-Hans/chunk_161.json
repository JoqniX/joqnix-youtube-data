[{"type": "subtitle", "time": 9672.55, "timestamp": "02:41:12", "text": "哦，我的天哪，我的下巴都快掉到红灯了。 喂。"}, {"type": "subtitle", "time": 9675.27, "timestamp": "02:41:15", "text": "不，我只是偶然路过那里"}, {"type": "subtitle", "time": 9676.87, "timestamp": "02:41:16", "text": "。"}, {"type": "subtitle", "time": 9681.429, "timestamp": "02:41:21", "text": "我这么说。"}, {"type": "subtitle", "time": 9683.429, "timestamp": "02:41:23", "text": "Brh."}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "它就像一个细胞神经"}]
[{"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "所以，我不知道我要去哪里。 我"}, {"type": "subtitle", "time": 446.87, "timestamp": "00:07:26", "text": "我认识一个油管博主，她专门做"}, {"type": "subtitle", "time": 450.55, "timestamp": "00:07:30", "text": "魔法少女 Kiraakira 的虚拟偶像，一个"}, {"type": "subtitle", "time": 452.30899999999997, "timestamp": "00:07:32", "text": "原宿"}, {"type": "subtitle", "time": 454.55, "timestamp": "00:07:34", "text": "人，"}, {"type": "subtitle", "time": 457.83, "timestamp": "00:07:37", "text": "她的虚拟偶像形象"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "就像一个来自原宿"}, {"type": "subtitle", "time": 469.029, "timestamp": "00:07:49", "text": "新宿的外星人，充满了魔法气息。 是啊，我应该"}, {"type": "subtitle", "time": 472.469, "timestamp": "00:07:52", "text": "告诉他们：“是的，我现在在"}, {"type": "subtitle", "time": 474.869, "timestamp": "00:07:54", "text": "新宿。”"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "伙计，"}]
[{"type": "subtitle", "time": 732.31, "timestamp": "00:12:12", "text": "Sukia、Sukia、Sika以及"}, {"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "新宿的其他地方，所以太太，你"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "欢迎，是的，那边就是"}, {"type": "subtitle", "time": 752.47, "timestamp": "00:12:32", "text": "我刚才在找"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "地方给我的充电器充电，"}, {"type": "subtitle", "time": 759.829, "timestamp": "00:12:39", "text": "想把我的移动电源充满"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "到100%，就像昨天那样，但是真的"}, {"type": "subtitle", "time": 769.19, "timestamp": "00:12:49", "text": "太难了。"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "所以，我最后还是买下了这个人。 我"}, {"type": "subtitle", "time": 774.47, "timestamp": "00:12:54", "text": "不知道你能不能看到，但这是"}, {"type": "subtitle", "time": 779.19, "timestamp": "00:12:59", "text": "一个充电口充电器。 我租了个"}]
[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "。 所以，我吃了四包品客"}, {"type": "subtitle", "time": 9308.23, "timestamp": "02:35:08", "text": "薯片，呃，我还"}, {"type": "subtitle", "time": 9312.79, "timestamp": "02:35:12", "text": "吃了一份炸鸡，呃，一份"}, {"type": "subtitle", "time": 9315.75, "timestamp": "02:35:15", "text": "无骨炸鸡。 就是这样。 我"}, {"type": "subtitle", "time": 9318.782, "timestamp": "02:35:18", "text": "想这就是我的晚餐了。"}, {"type": "subtitle", "time": 9319.349, "timestamp": "02:35:19", "text": "[笑声]"}, {"type": "subtitle", "time": 9322.15, "timestamp": "02:35:22", "text": "那女孩只是害怕而已。 我们被"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "一只蟑螂吓得魂飞魄散。"}, {"type": "subtitle", "time": 9328.15, "timestamp": "02:35:28", "text": "我的天啊。 你应该看看那一幕。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "当时的感觉就像：哦，等等。 上文。 丰田。"}, {"type": "subtitle", "time": 9356.389, "timestamp": "02:35:56", "text": "哇。"}, {"type": "subtitle", "time": 9358.95, "timestamp": "02:35:58", "text": "看看它"}]
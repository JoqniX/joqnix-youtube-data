[{"type": "subtitle", "time": 1022.389, "timestamp": "00:17:02", "text": "驿站之类的地方，这些地方都没有"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "厕所。 好的。 于是，我去了"}, {"type": "subtitle", "time": 1028.15, "timestamp": "00:17:08", "text": "7-Eleven便利店。 我问那个人：“你"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "知道附近有没有厕所吗？"}, {"type": "subtitle", "time": 1033.029, "timestamp": "00:17:13", "text": "情况紧急。” 他回答说：“我"}, {"type": "subtitle", "time": 1037.11, "timestamp": "00:17:17", "text": "不知道。” 我当时就想，"}, {"type": "subtitle", "time": 1040.63, "timestamp": "00:17:20", "text": "他看我的眼神里充满了痛苦。 我"}, {"type": "subtitle", "time": 1043.11, "timestamp": "00:17:23", "text": "不知道该说什么，但感觉"}, {"type": "subtitle", "time": 1046.23, "timestamp": "00:17:26", "text": "他好像很讨厌我似的。 我"}, {"type": "subtitle", "time": 1049.83, "timestamp": "00:17:29", "text": "心想，兄弟，你为什么会这样？好像你应该"}, {"type": "subtitle", "time": 1055.59, "timestamp": "00:17:35", "text": "以正式的方式对待顾客似的。 你只要告诉"}, {"type": "subtitle", "time": 1059.43, "timestamp": "00:17:39", "text": "我厕所怎么走就行了。 你可以用比较"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "委婉的方式说出来。 但是，是的，我"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "我不得不去那里看看，因为我"}]
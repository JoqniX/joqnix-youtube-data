[{"type": "subtitle", "time": 9444.95, "timestamp": "02:37:24", "text": "我们去了日本，那里的人都很有钱，是的，这里"}, {"type": "subtitle", "time": 9450.07, "timestamp": "02:37:30", "text": "是新宿，所以这是一个富人区，"}, {"type": "subtitle", "time": 9452.87, "timestamp": "02:37:32", "text": "更确切地说是一个富人区。"}, {"type": "subtitle", "time": 9456.389, "timestamp": "02:37:36", "text": "兄弟，我去了"}, {"type": "subtitle", "time": 9459.67, "timestamp": "02:37:39", "text": "日本的红灯区，真是太"}, {"type": "subtitle", "time": 9463.19, "timestamp": "02:37:43", "text": "疯狂了，有些人问我，呃，"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "你想按摩吗之类的。[笑声]"}, {"type": "subtitle", "time": 9469.19, "timestamp": "02:37:49", "text": "景色很吓人。"}, {"type": "subtitle", "time": 9472.15, "timestamp": "02:37:52", "text": "不，更可怕的是那些在"}, {"type": "subtitle", "time": 9476.07, "timestamp": "02:37:56", "text": "外面寻找"}]
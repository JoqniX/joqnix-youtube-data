[{"type": "subtitle", "time": 8601.83, "timestamp": "02:23:21", "text": "，这个移动电源，这个电池"}, {"type": "subtitle", "time": 8604.23, "timestamp": "02:23:24", "text": "快没电了。 它不是，它是，它是"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "闪闪发光的。 最后一盏灯闪闪发光。 妈的"}, {"type": "subtitle", "time": 8610.55, "timestamp": "02:23:30", "text": "。 我觉得我得把这个退货。"}, {"type": "subtitle", "time": 8613.67, "timestamp": "02:23:33", "text": "等等，我得尽快把这个退回去。"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "哦不，"}, {"type": "subtitle", "time": 8617.83, "timestamp": "02:23:37", "text": "各位。"}, {"type": "subtitle", "time": 8619.59, "timestamp": "02:23:39", "text": "我得把这个退掉，或者带另一个移动"}, {"type": "subtitle", "time": 8631.59, "timestamp": "02:23:51", "text": "我得把这个退回去。"}]
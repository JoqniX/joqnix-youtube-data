[{"type": "subtitle", "time": 3544.15, "timestamp": "00:59:04", "text": "？ 是的。 所以他们就像"}, {"type": "subtitle", "time": 3548.15, "timestamp": "00:59:08", "text": "皮条客之类的。 他们会专门找"}, {"type": "subtitle", "time": 3551.829, "timestamp": "00:59:11", "text": "游客，然后设陷阱套牢他们，比如问他们要不要"}, {"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "按摩，要不要"}, {"type": "subtitle", "time": 3558.789, "timestamp": "00:59:18", "text": "这个那个等等。然后他们会"}, {"type": "subtitle", "time": 3562.71, "timestamp": "00:59:22", "text": "想方设法让你上钩。 而且我"}, {"type": "subtitle", "time": 3566.15, "timestamp": "00:59:26", "text": "无论如何都不能那样做，"}, {"type": "subtitle", "time": 3571.03, "timestamp": "00:59:31", "text": "因为我是一名学生，我"}, {"type": "subtitle", "time": 3573.51, "timestamp": "00:59:33", "text": "不应该做任何不好的事情，以免被遣返"}, {"type": "subtitle", "time": 3576.23, "timestamp": "00:59:36", "text": "回国。 我"}, {"type": "subtitle", "time": 3579.27, "timestamp": "00:59:39", "text": "不想那样。 我来这里是因为我想"}, {"type": "subtitle", "time": 3581.571, "timestamp": "00:59:41", "text": "追逐我的梦想。"}, {"type": "subtitle", "time": 3582.549, "timestamp": "00:59:42", "text": "[音乐]"}, {"type": "subtitle", "time": 3584.63, "timestamp": "00:59:44", "text": "嗯，"}, {"type": "subtitle", "time": 3590.15, "timestamp": "00:59:50", "text": "你想看看蛋糕吗？ 是的，"}, {"type": "subtitle", "time": 3592.95, "timestamp": "00:59:52", "text": "如果你愿意的话，可以用这个代码发送"}]
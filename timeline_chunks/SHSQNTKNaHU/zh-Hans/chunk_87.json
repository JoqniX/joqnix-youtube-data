[{"type": "subtitle", "time": 5220.47, "timestamp": "01:27:00", "text": "哦，等等。 这就像是穿越伊斯兰教法，但又"}, {"type": "subtitle", "time": 5223.675, "timestamp": "01:27:03", "text": "不是穿越伊斯兰教法。 我们必须走了。"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "现在有很多人正在过马路。"}, {"type": "subtitle", "time": 5249.75, "timestamp": "01:27:29", "text": "新宿主要 2 大道。"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "但我还要上课。 我"}, {"type": "subtitle", "time": 5262.149, "timestamp": "01:27:42", "text": "明天要上学。"}, {"type": "subtitle", "time": 5276.629, "timestamp": "01:27:56", "text": "我想我们，我想我们离开了，我想"}]
[{"type": "subtitle", "time": 8897.349, "timestamp": "02:28:17", "text": "不，我没有电池。"}, {"type": "subtitle", "time": 8901.59, "timestamp": "02:28:21", "text": "不，等等。 如果我再吃一个呢？"}, {"type": "subtitle", "time": 8904.63, "timestamp": "02:28:24", "text": "我打算这么做。"}, {"type": "subtitle", "time": 8907.429, "timestamp": "02:28:27", "text": "如果我再拿一个充电器，也许"}, {"type": "subtitle", "time": 8910.23, "timestamp": "02:28:30", "text": "我会……如果我再拿一个充电器，"}, {"type": "subtitle", "time": 8913.83, "timestamp": "02:28:33", "text": "然后再试一次呢？"}, {"type": "subtitle", "time": 8915.51, "timestamp": "02:28:35", "text": "但同样，它的"}, {"type": "subtitle", "time": 8918.309, "timestamp": "02:28:38", "text": "价格也会更高。"}, {"type": "subtitle", "time": 8921.99, "timestamp": "02:28:41", "text": "不，我可以这样写，但我觉得"}, {"type": "subtitle", "time": 8925.59, "timestamp": "02:28:45", "text": "你以后会明白的。"}, {"type": "subtitle", "time": 8927.67, "timestamp": "02:28:47", "text": "我们已经直播了3个小时了。 正确的。"}, {"type": "subtitle", "time": 8929.99, "timestamp": "02:28:49", "text": "所以，"}, {"type": "subtitle", "time": 8931.75, "timestamp": "02:28:51", "text": "我得一路返回"}, {"type": "subtitle", "time": 8936.23, "timestamp": "02:28:56", "text": "那里，对吧？ 最好的方法。"}, {"type": "subtitle", "time": 8938.95, "timestamp": "02:28:58", "text": "你好。 欢迎回来，阿拉斯。"}]
[{"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "我需要坐下来休息一会儿。"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "这么累。"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "我不知道。"}, {"type": "subtitle", "time": 1003.11, "timestamp": "00:16:43", "text": "今天我想跟你说件事。 今天你知道“你好”之后发生了什么"}, {"type": "subtitle", "time": 1006.55, "timestamp": "00:16:46", "text": "。   是的"}, {"type": "subtitle", "time": 1010.949, "timestamp": "00:16:50", "text": "。 呃，在"}, {"type": "subtitle", "time": 1013.03, "timestamp": "00:16:53", "text": "我结束公开赌博活动之后"}, {"type": "subtitle", "time": 1015.59, "timestamp": "00:16:55", "text": "，我"}, {"type": "subtitle", "time": 1019.91, "timestamp": "00:16:59", "text": "非常想去洗手间。 我去了71号公路、迷你"}]
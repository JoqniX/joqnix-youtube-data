[{"type": "subtitle", "time": 9361.67, "timestamp": "02:36:01", "text": "散发出的气场。 看看那些车"}, {"type": "subtitle", "time": 9365.83, "timestamp": "02:36:05", "text": "。 新树花真是太不一样了。"}, {"type": "subtitle", "time": 9367.75, "timestamp": "02:36:07", "text": "新宿真是太不一样了。 还有，忍者，"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "你也在这里。 你好。"}, {"type": "subtitle", "time": 9374.309, "timestamp": "02:36:14", "text": "忍者最近怎么样了？"}, {"type": "subtitle", "time": 9381.59, "timestamp": "02:36:21", "text": "大学之恋。"}, {"type": "subtitle", "time": 9383.349, "timestamp": "02:36:23", "text": "等等，我想去哥斯拉主题"}, {"type": "subtitle", "time": 9384.95, "timestamp": "02:36:24", "text": "公园。 我想再给你们看一遍哥斯拉"}, {"type": "subtitle", "time": 9386.309, "timestamp": "02:36:26", "text": "。"}, {"type": "subtitle", "time": 9389.349, "timestamp": "02:36:29", "text": "我不知道它什么时候会发出那种"}, {"type": "subtitle", "time": 9392.63, "timestamp": "02:36:32", "text": "咆哮声。 我想带你去看看那个"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "哥斯拉"}, {"type": "subtitle", "time": 9396.309, "timestamp": "02:36:36", "text": "玩意儿。"}, {"type": "subtitle", "time": 9397.99, "timestamp": "02:36:37", "text": "那是兰博基尼吗？ 这是一辆"}, {"type": "subtitle", "time": 9400.55, "timestamp": "02:36:40", "text": "兰博基尼。"}, {"type": "subtitle", "time": 9414.63, "timestamp": "02:36:54", "text": "生病了真是太疯狂了[笑声]。 不，不。祝你"}, {"type": "subtitle", "time": 9417.19, "timestamp": "02:36:57", "text": "早日康复。"}, {"type": "subtitle", "time": 9418.95, "timestamp": "02:36:58", "text": "尽快开始滚动。"}]
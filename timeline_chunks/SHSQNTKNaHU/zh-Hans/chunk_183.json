[{"type": "subtitle", "time": 10980.23, "timestamp": "03:03:00", "text": "。 呃，现在应该8、9点了，我得"}, {"type": "subtitle", "time": 10981.67, "timestamp": "03:03:01", "text": "回去了。"}, {"type": "subtitle", "time": 10984.15, "timestamp": "03:03:04", "text": "我得赶火车，对吧？ 如果我"}, {"type": "subtitle", "time": 10988.15, "timestamp": "03:03:08", "text": "能赶上回家的火车，我就可以收拾东西"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "哦，有人想要什么东西。 我觉得我当时"}, {"type": "subtitle", "time": 11003.67, "timestamp": "03:03:23", "text": "为什么？ 你可以拍张照片。 只有我？"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "不，"}, {"type": "subtitle", "time": 11013.03, "timestamp": "03:03:33", "text": "这里不是音乐，而是这些可爱的东西。 为什么说它是"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "某种"}, {"type": "subtitle", "time": 11017.99, "timestamp": "03:03:37", "text": "刀？"}, {"type": "subtitle", "time": 11019.837, "timestamp": "03:03:39", "text": "我有"}, {"type": "subtitle", "time": 11038.71, "timestamp": "03:03:58", "text": "等等，"}]
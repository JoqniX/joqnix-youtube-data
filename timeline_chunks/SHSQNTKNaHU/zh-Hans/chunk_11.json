[{"type": "subtitle", "time": 662.389, "timestamp": "00:11:02", "text": "我昨天待在网吧。"}, {"type": "subtitle", "time": 664.63, "timestamp": "00:11:04", "text": "嗯，"}, {"type": "subtitle", "time": 669.75, "timestamp": "00:11:09", "text": "我醒来后一切都焕然一新。 我"}, {"type": "subtitle", "time": 672.63, "timestamp": "00:11:12", "text": "搞砸了。"}, {"type": "subtitle", "time": 675.99, "timestamp": "00:11:15", "text": "我现在要说的是，当你查看"}, {"type": "subtitle", "time": 678.63, "timestamp": "00:11:18", "text": "谷歌地图时，会看到一些赞助"}, {"type": "subtitle", "time": 683.19, "timestamp": "00:11:23", "text": "广告之类的东西，还有我之前想去的那所学校——"}, {"type": "subtitle", "time": 687.43, "timestamp": "00:11:27", "text": "三国中学。 它明明"}, {"type": "subtitle", "time": 689.75, "timestamp": "00:11:29", "text": "在新宿，"}, {"type": "subtitle", "time": 693.35, "timestamp": "00:11:33", "text": "但我去的时候，我"}, {"type": "subtitle", "time": 695.43, "timestamp": "00:11:35", "text": "跟着地图来到了新宿，却发现它不是"}, {"type": "subtitle", "time": 700.63, "timestamp": "00:11:40", "text": "新宿。 好像是在 Tam Tada Manom​​e 之"}, {"type": "subtitle", "time": 703.269, "timestamp": "00:11:43", "text": "类的。 我得坐JR"}, {"type": "subtitle", "time": 708.47, "timestamp": "00:11:48", "text": "17号"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "线去那里，大概两站就到了，"}]
[{"type": "subtitle", "time": 9878.79, "timestamp": "02:44:38", "text": "兄弟。 我看到了，就像我看到了，就像呃，墓穴，呃，"}, {"type": "subtitle", "time": 9882.469, "timestamp": "02:44:42", "text": "汤姆女孩，或者叫什么来着？ 嗯，就是那些男"}, {"type": "subtitle", "time": 9885.11, "timestamp": "02:44:45", "text": "扮女装"}, {"type": "subtitle", "time": 9889.429, "timestamp": "02:44:49", "text": "做那种事的人。 我的天啊。"}, {"type": "subtitle", "time": 9893.59, "timestamp": "02:44:53", "text": "当然，这是接待员区域。 所以，"}, {"type": "subtitle", "time": 9896.309, "timestamp": "02:44:56", "text": "这就是哥斯拉那件事。 我正在寻找"}]
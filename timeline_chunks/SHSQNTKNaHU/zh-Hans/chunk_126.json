[{"type": "subtitle", "time": 7579.43, "timestamp": "02:06:19", "text": "哭？"}, {"type": "subtitle", "time": 7581.43, "timestamp": "02:06:21", "text": "我要换工作。 我要切换场景了。 我要"}, {"type": "subtitle", "time": 7590.709, "timestamp": "02:06:30", "text": "我换个场景了，兄弟。"}, {"type": "subtitle", "time": 7599.27, "timestamp": "02:06:39", "text": "所以租用它需要支付一定的"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "费用吗？ 这取决于你的使用时长和"}, {"type": "subtitle", "time": 7603.109, "timestamp": "02:06:43", "text": "付费金额，但你可以每天支付 360 元"}, {"type": "subtitle", "time": 7604.95, "timestamp": "02:06:44", "text": "。 电池续航时间可达120"}, {"type": "subtitle", "time": 7606.79, "timestamp": "02:06:46", "text": "小时。 好的，明白了。"}, {"type": "subtitle", "time": 7610.629, "timestamp": "02:06:50", "text": "演示演示。 呃，那我应该把它退回去吗"}, {"type": "subtitle", "time": 7613.83, "timestamp": "02:06:53", "text": "？ 我可以在任何地方退货吗？还是"}, {"type": "subtitle", "time": 7615.99, "timestamp": "02:06:55", "text": "必须退回到我取货的地方"}]
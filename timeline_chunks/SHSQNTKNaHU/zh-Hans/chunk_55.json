[{"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "回车站的路吧。 呃，"}, {"type": "subtitle", "time": 3306.309, "timestamp": "00:55:06", "text": "操，兄弟。"}, {"type": "subtitle", "time": 3308.79, "timestamp": "00:55:08", "text": "他妈的。 我感觉自己被人跟踪了。"}, {"type": "subtitle", "time": 3312.71, "timestamp": "00:55:12", "text": "拉屎。 拉屎。"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "各位，"}, {"type": "subtitle", "time": 3343.589, "timestamp": "00:55:43", "text": "我不该来这里。"}, {"type": "subtitle", "time": 3346.23, "timestamp": "00:55:46", "text": "我没有那种能力，我内心没有那种力量"}]
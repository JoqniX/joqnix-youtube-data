[{"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "我现在好害怕，因为"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "那里有保安，还有人专门"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "针对外国人。 他们"}, {"type": "subtitle", "time": 3981.67, "timestamp": "01:06:21", "text": "走过来问我要不要"}, {"type": "subtitle", "time": 3985.829, "timestamp": "01:06:25", "text": "按摩之类的，呃，都是些18岁以上才能享受的东西。"}, {"type": "subtitle", "time": 3988.069, "timestamp": "01:06:28", "text": "所以，我有点害怕。 我之前把麦克风静音了"}, {"type": "subtitle", "time": 3992.069, "timestamp": "01:06:32", "text": "，但是，哦，这是什么？ 哦，这"}, {"type": "subtitle", "time": 3994.309, "timestamp": "01:06:34", "text": "是棒球相关的玩意儿。   在"}, {"type": "subtitle", "time": 4019.99, "timestamp": "01:06:59", "text": "这里酒店和酒吧真多，"}]
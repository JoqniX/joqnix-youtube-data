[{"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "ちょっと座りたいんです。"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "すごく疲れた。"}, {"type": "subtitle", "time": 982.56, "timestamp": "00:16:22", "text": "。 今日はとても不安定な日だ。"}, {"type": "subtitle", "time": 1003.11, "timestamp": "00:16:43", "text": "今日、あなたに一つ話したいことがあるんです。 今日、あなたは「こんにちは」の後に何が起こったのかを知っています"}, {"type": "subtitle", "time": 1006.55, "timestamp": "00:16:46", "text": "。"}, {"type": "subtitle", "time": 1010.949, "timestamp": "00:16:50", "text": "うん。 えーっと、"}, {"type": "subtitle", "time": 1013.03, "timestamp": "00:16:53", "text": "オープンゲームとか色々やってた後、すごくトイレに行きたかったんです"}, {"type": "subtitle", "time": 1019.91, "timestamp": "00:16:59", "text": "。  71号線やミニストップなどに行ってみたけど、どこにも"}]
[{"type": "subtitle", "time": 7063.109, "timestamp": "01:57:43", "text": "事故の後で夕食に行ったと仮定しましょう。 ええ、そうでしたね"}, {"type": "subtitle", "time": 7066.55, "timestamp": "01:57:46", "text": "。 あなたは夕食に出かけました。 それで、"}, {"type": "subtitle", "time": 7069.35, "timestamp": "01:57:49", "text": "角にある大きな建物のカメラ、"}, {"type": "subtitle", "time": 7071.83, "timestamp": "01:57:51", "text": "広告みたいなのを見ました。 そういうことってたくさんあるよね"}, {"type": "subtitle", "time": 7074.55, "timestamp": "01:57:54", "text": "。"}, {"type": "subtitle", "time": 7077.75, "timestamp": "01:57:57", "text": "モバイルバッテリーを返品するために、またあのセブンイレブンに戻るんだ。またそこまで歩いて行くつもりだよ"}]
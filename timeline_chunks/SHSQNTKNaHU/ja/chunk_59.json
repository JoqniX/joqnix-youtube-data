[{"type": "subtitle", "time": 3544.15, "timestamp": "00:59:04", "text": "傘を持ったオレンジ色の男の人、見える？ うん。 つまり、彼らは"}, {"type": "subtitle", "time": 3548.15, "timestamp": "00:59:08", "text": "ポン引きか何かみたいなものなんですね。 彼らは"}, {"type": "subtitle", "time": 3551.829, "timestamp": "00:59:11", "text": "観光客を見つけて罠にかけたり、「"}, {"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "マッサージはいかがですか？」「"}, {"type": "subtitle", "time": 3558.789, "timestamp": "00:59:18", "text": "あれやこれやはいかがですか？」などと声をかけたりして、"}, {"type": "subtitle", "time": 3562.71, "timestamp": "00:59:22", "text": "あなたを罠にかけようとするんです。 そして、私は"}, {"type": "subtitle", "time": 3566.15, "timestamp": "00:59:26", "text": "基本的にどんなことがあってもそれはできません。"}, {"type": "subtitle", "time": 3571.03, "timestamp": "00:59:31", "text": "なぜなら私は学生であり、"}, {"type": "subtitle", "time": 3576.23, "timestamp": "00:59:36", "text": "母国に送り返されるような悪いことは何もしてはいけないからです。 私はそれを望んでいません"}, {"type": "subtitle", "time": 3579.27, "timestamp": "00:59:39", "text": "。 私は"}, {"type": "subtitle", "time": 3581.571, "timestamp": "00:59:41", "text": "夢を追いかけるためにここにいます。"}, {"type": "subtitle", "time": 3582.549, "timestamp": "00:59:42", "text": "[音楽]"}, {"type": "subtitle", "time": 3584.63, "timestamp": "00:59:44", "text": "ええと、これが"}, {"type": "subtitle", "time": 3590.15, "timestamp": "00:59:50", "text": "ケーキを見たいですか？ はい、よろしければ"}, {"type": "subtitle", "time": 3592.95, "timestamp": "00:59:52", "text": "このコードで送ってください"}]
[{"type": "subtitle", "time": 2161.67, "timestamp": "00:36:01", "text": "コーヒーショップ。 わかった。 あの場所を覚えている人はいますか"}, {"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "？ だって、またそこに行くんだから"}, {"type": "subtitle", "time": 2166.95, "timestamp": "00:36:06", "text": "。 わかった。 セブンイレブン。"}, {"type": "subtitle", "time": 2170.63, "timestamp": "00:36:10", "text": "ドーナツ。 ドーナツ屋さん。"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "待って。 時計塔があります。"}, {"type": "subtitle", "time": 2192.55, "timestamp": "00:36:32", "text": "見えますか？ 時計塔があります。"}, {"type": "subtitle", "time": 2203.119, "timestamp": "00:36:43", "text": "。 ここからは私が引き継ぎました。  S"}]
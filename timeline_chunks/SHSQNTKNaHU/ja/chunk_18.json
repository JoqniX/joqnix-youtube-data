[{"type": "subtitle", "time": 1080.23, "timestamp": "00:18:00", "text": "新宿の近くにいないので、下へ行かなければなりませんでした。"}, {"type": "subtitle", "time": 1082.95, "timestamp": "00:18:02", "text": "昨日、"}, {"type": "subtitle", "time": 1085.99, "timestamp": "00:18:05", "text": "配信のために真里市に来たのと同じように、"}, {"type": "subtitle", "time": 1088.07, "timestamp": "00:18:08", "text": "新宿に来て"}, {"type": "subtitle", "time": 1093.11, "timestamp": "00:18:13", "text": "配信をしようと思って"}, {"type": "subtitle", "time": 1094.95, "timestamp": "00:18:14", "text": "新宿に来たのですが、"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "駅に着いた時に"}, {"type": "subtitle", "time": 1099.99, "timestamp": "00:18:19", "text": "トイレを見つけて"}, {"type": "subtitle", "time": 1103.51, "timestamp": "00:18:23", "text": "そこに行ったら、「おいおい、あそこは寝室だったぞ。教えてくれればよかったのに」って感じでした。でも、"}, {"type": "subtitle", "time": 1124.39, "timestamp": "00:18:44", "text": "こういうところの人はどうやって暮らしてるんだろう？ とても"}, {"type": "subtitle", "time": 1126.71, "timestamp": "00:18:46", "text": "混乱しています。"}, {"type": "subtitle", "time": 1129.19, "timestamp": "00:18:49", "text": "コンビニかもしれない。 コンビニに行ったのです"}, {"type": "subtitle", "time": 1131.99, "timestamp": "00:18:51", "text": "が、"}, {"type": "subtitle", "time": 1137.59, "timestamp": "00:18:57", "text": "うん。"}]
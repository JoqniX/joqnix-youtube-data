[{"type": "subtitle", "time": 7579.43, "timestamp": "02:06:19", "text": "泣くべき？"}, {"type": "subtitle", "time": 7581.43, "timestamp": "02:06:21", "text": "乗り換えます。 場面転換します。"}, {"type": "subtitle", "time": 7590.709, "timestamp": "02:06:30", "text": "シーンを変えるよ、兄弟。"}, {"type": "subtitle", "time": 7599.27, "timestamp": "02:06:39", "text": "レンタル"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "料金みたいな感じなら大丈夫だよ。 利用期間や料金によって異なります"}, {"type": "subtitle", "time": 7603.109, "timestamp": "02:06:43", "text": "が、1日あたり360ドルで利用できます"}, {"type": "subtitle", "time": 7604.95, "timestamp": "02:06:44", "text": "。 バッテリーは120"}, {"type": "subtitle", "time": 7606.79, "timestamp": "02:06:46", "text": "時間持続します。 はい、わかりました。"}, {"type": "subtitle", "time": 7610.629, "timestamp": "02:06:50", "text": "デモデモ。 えっと、どこに返品すればいいんでしょうか"}, {"type": "subtitle", "time": 7613.83, "timestamp": "02:06:53", "text": "？ どこで返却しても大丈夫ですか？それとも、"}, {"type": "subtitle", "time": 7615.99, "timestamp": "02:06:55", "text": "受け取った場所に返却した方が良いでしょうか"}]
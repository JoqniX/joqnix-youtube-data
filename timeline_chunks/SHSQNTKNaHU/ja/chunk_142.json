[{"type": "subtitle", "time": 8523.429, "timestamp": "02:22:03", "text": "あなたは本当に車が好きなんですね？ 私は、"}, {"type": "subtitle", "time": 8526.95, "timestamp": "02:22:06", "text": "Evo Speedや"}, {"type": "subtitle", "time": 8529.349, "timestamp": "02:22:09", "text": "他のレースゲームをよくプレイしていたので、車が少し好きなんです。 だから、"}, {"type": "subtitle", "time": 8554.469, "timestamp": "02:22:34", "text": "新宿駅はどこにあるのか、どれくらい行けばいいのかなど、誰かに聞きたいんです"}, {"type": "subtitle", "time": 8574.469, "timestamp": "02:22:54", "text": "売れたと思います。"}]
[{"type": "subtitle", "time": 2003.59, "timestamp": "00:33:23", "text": "でもまだ、今日は雨が降るかもしれない。   なんてこった。   俺、さっき立ち寄ったセブンイレブンがまだ"}, {"type": "subtitle", "time": 2008.47, "timestamp": "00:33:28", "text": "見つからないんだよ"}, {"type": "subtitle", "time": 2012.63, "timestamp": "00:33:32", "text": "、"}, {"type": "subtitle", "time": 2014.31, "timestamp": "00:33:34", "text": "兄弟。 待って、待って、待って。 見つけたと思う"}, {"type": "subtitle", "time": 2017.43, "timestamp": "00:33:37", "text": "。 あ、待って。 雨が降っている。 ああ、くそ。"}, {"type": "subtitle", "time": 2021.909, "timestamp": "00:33:41", "text": "何だって、何だって、ああ神様、雨が降ってる。   ああ、なんてことだ"}]
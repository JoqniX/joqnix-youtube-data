[{"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "怖いんです。用心棒とか、"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "外国人を狙っている人たちがいるから。 彼らは"}, {"type": "subtitle", "time": 3981.67, "timestamp": "01:06:21", "text": "私に近づいてきて、「"}, {"type": "subtitle", "time": 3985.829, "timestamp": "01:06:25", "text": "マッサージはいかがですか？」とか、18歳以上向けのサービスとか言ってきました。   だから、"}, {"type": "subtitle", "time": 3988.069, "timestamp": "01:06:28", "text": "ちょっと怖いんです。 先ほどマイクをミュートにしたのですが、あれ"}, {"type": "subtitle", "time": 3992.069, "timestamp": "01:06:32", "text": "、これは何でしょう？ ああ、これは"}, {"type": "subtitle", "time": 3994.309, "timestamp": "01:06:34", "text": "野球関連のものですね。"}, {"type": "subtitle", "time": 4019.99, "timestamp": "01:06:59", "text": "ホテルやバーがたくさんあって、すごいですね"}]
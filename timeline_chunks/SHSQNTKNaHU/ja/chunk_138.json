[{"type": "subtitle", "time": 8283.589, "timestamp": "02:18:03", "text": "私は。   あなたにも分かると"}, {"type": "subtitle", "time": 8292.95, "timestamp": "02:18:12", "text": "ええ、あなたは生きていますね。 こんにちは、アヤン。"}, {"type": "subtitle", "time": 8298.309, "timestamp": "02:18:18", "text": "バッグの中身を確認させてください。"}, {"type": "subtitle", "time": 8300.87, "timestamp": "02:18:20", "text": "私のゴジラはどこに行ったの"}, {"type": "subtitle", "time": 8302.23, "timestamp": "02:18:22", "text": "？"}, {"type": "subtitle", "time": 8313.349, "timestamp": "02:18:33", "text": "ゴジラがいるのは反対側だと思うけど、よくわからない"}, {"type": "subtitle", "time": 8325.429, "timestamp": "02:18:45", "text": "よし、モバイルバッテリーを手に入れた。 はい、結構です。"}, {"type": "subtitle", "time": 8335.589, "timestamp": "02:18:55", "text": "誰かが俺に話しかけてきたんだよ、兄弟。"}, {"type": "subtitle", "time": 8339.349, "timestamp": "02:18:59", "text": "誰かが私に話しかけてきた。"}]
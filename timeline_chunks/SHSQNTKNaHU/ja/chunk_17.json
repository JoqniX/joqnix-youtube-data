[{"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "トイレがなかった。 わかった。 それで、セブンイレブンに行った"}, {"type": "subtitle", "time": 1028.15, "timestamp": "00:17:08", "text": "。 私はその男性に「"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "近くにトイレがあるか知っていますか？"}, {"type": "subtitle", "time": 1033.029, "timestamp": "00:17:13", "text": "緊急事態なんです」と尋ねました。 彼は「わから"}, {"type": "subtitle", "time": 1037.11, "timestamp": "00:17:17", "text": "ない」という感じだった。 そして私は、"}, {"type": "subtitle", "time": 1040.63, "timestamp": "00:17:20", "text": "彼が私を見る目つきが、とても苦痛に満ちていたと思った。 何と"}, {"type": "subtitle", "time": 1043.11, "timestamp": "00:17:23", "text": "言ったらいいのか分からないけど、まるで彼が私を"}, {"type": "subtitle", "time": 1046.23, "timestamp": "00:17:26", "text": "嫌っているみたいだった。 俺は、「おい"}, {"type": "subtitle", "time": 1049.83, "timestamp": "00:17:29", "text": "、なんでそんなに"}, {"type": "subtitle", "time": 1055.59, "timestamp": "00:17:35", "text": "丁寧な態度で客を扱わなきゃいけないんだよ」って感じだった。"}, {"type": "subtitle", "time": 1059.43, "timestamp": "00:17:39", "text": "トイレへの行き方を教えてくれればいいのに。 それを"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "丁寧に言うこともできる。 でも、"}]
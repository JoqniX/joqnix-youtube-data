[{"type": "subtitle", "time": 9361.67, "timestamp": "02:36:01", "text": "。 あそこの車を見てください"}, {"type": "subtitle", "time": 9365.83, "timestamp": "02:36:05", "text": "。 新宿はとても違う。"}, {"type": "subtitle", "time": 9367.75, "timestamp": "02:36:07", "text": "新宿は全然違う。 それから、ニンジャ、"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "君もここにいるんだね。 こんにちは。"}, {"type": "subtitle", "time": 9374.309, "timestamp": "02:36:14", "text": "忍者の調子はどうですか？"}, {"type": "subtitle", "time": 9381.59, "timestamp": "02:36:21", "text": "大学生活が大好き。"}, {"type": "subtitle", "time": 9383.349, "timestamp": "02:36:23", "text": "待って、ゴジラのところに行きたい"}, {"type": "subtitle", "time": 9384.95, "timestamp": "02:36:24", "text": "。 もう一度ゴジラをお見せしたい"}, {"type": "subtitle", "time": 9386.309, "timestamp": "02:36:26", "text": "。   いつ"}, {"type": "subtitle", "time": 9392.63, "timestamp": "02:36:32", "text": "咆哮するのかは分かりません。"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "ゴジラの"}, {"type": "subtitle", "time": 9396.309, "timestamp": "02:36:36", "text": "やつを見せてあげたいんだ。"}, {"type": "subtitle", "time": 9397.99, "timestamp": "02:36:37", "text": "あれはランボルギーニですか？ それは"}, {"type": "subtitle", "time": 9400.55, "timestamp": "02:36:40", "text": "ランボルギーニです。"}, {"type": "subtitle", "time": 9414.63, "timestamp": "02:36:54", "text": "笑）病気になるなんて。 いいえ、いいえ。"}, {"type": "subtitle", "time": 9417.19, "timestamp": "02:36:57", "text": "早く良くなってね。"}, {"type": "subtitle", "time": 9418.95, "timestamp": "02:36:58", "text": "すぐに始めよう。   さあ、始めよう"}]
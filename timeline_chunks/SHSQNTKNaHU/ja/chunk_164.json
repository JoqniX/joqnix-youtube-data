[{"type": "subtitle", "time": 9878.79, "timestamp": "02:44:38", "text": "兄弟。 えっと、お墓とか、お"}, {"type": "subtitle", "time": 9882.469, "timestamp": "02:44:42", "text": "墓の女の子とか、なんて言うんだっけ？ えっと、"}, {"type": "subtitle", "time": 9885.11, "timestamp": "02:44:45", "text": "女性の格好をして"}, {"type": "subtitle", "time": 9889.429, "timestamp": "02:44:49", "text": "そういうことをする男性たち。 何てことだ。"}, {"type": "subtitle", "time": 9893.59, "timestamp": "02:44:53", "text": "もちろん、ここはホステスエリアです。 それが"}, {"type": "subtitle", "time": 9896.309, "timestamp": "02:44:56", "text": "ゴジラの件です。 私はそれを探しています"}]
[{"type": "subtitle", "time": 8342.629, "timestamp": "02:19:02", "text": "ああ、これはいいですね。 わかった。   わかった"}, {"type": "subtitle", "time": 8345.11, "timestamp": "02:19:05", "text": "。 そうだとすれば、もし"}, {"type": "subtitle", "time": 8346.95, "timestamp": "02:19:06", "text": "どこかに返品できるとしたら、"}, {"type": "subtitle", "time": 8364.23, "timestamp": "02:19:24", "text": "配信が途切れていないことを教えてくださってありがとうございます"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "。"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "これは本当に素敵ですね。 新宿には少なくとも、"}, {"type": "subtitle", "time": 8383.349, "timestamp": "02:19:43", "text": "こういう地区とか通りみたいな"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "ものがあるよね？ こっちにあるこの類の"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "もので、"}, {"type": "subtitle", "time": 8391.429, "timestamp": "02:19:51", "text": "黄色で、その他いろいろある。"}, {"type": "subtitle", "time": 8395.349, "timestamp": "02:19:55", "text": "ゴジラ通りはカラチのような青色だった"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "。"}]
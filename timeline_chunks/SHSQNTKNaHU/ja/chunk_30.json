[{"type": "subtitle", "time": 1812.87, "timestamp": "00:30:12", "text": "とても大きな建物です。   そこへ"}, {"type": "subtitle", "time": 1815.43, "timestamp": "00:30:15", "text": "行って、"}, {"type": "subtitle", "time": 1818.47, "timestamp": "00:30:18", "text": "どんなところか見てみたい。 あの"}, {"type": "subtitle", "time": 1825.99, "timestamp": "00:30:25", "text": "おいおい、勘弁してくれよ。 スケートボード。"}, {"type": "subtitle", "time": 1833.669, "timestamp": "00:30:33", "text": "逃げ場がないんだ。 それは"}, {"type": "subtitle", "time": 1852.23, "timestamp": "00:30:52", "text": "、今日はただ"}, {"type": "subtitle", "time": 1856.389, "timestamp": "00:30:56", "text": "探検してみましょう。 土曜日にここに来ればよかったなと思う"}, {"type": "subtitle", "time": 1858.95, "timestamp": "00:30:58", "text": "。 翌日も泊まってもいいし、"}]
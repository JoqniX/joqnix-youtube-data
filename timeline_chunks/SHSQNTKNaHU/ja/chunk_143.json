[{"type": "subtitle", "time": 8601.83, "timestamp": "02:23:21", "text": "も、このモバイルバッテリー、このバッテリーが"}, {"type": "subtitle", "time": 8604.23, "timestamp": "02:23:24", "text": "切れそうです。 それは、それは、それは、それは、それは、"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "キラキラしているということです。 最後の光がキラキラと輝いている。 ああ、くそ"}, {"type": "subtitle", "time": 8610.55, "timestamp": "02:23:30", "text": "。 これは返品した方がいいと思う。"}, {"type": "subtitle", "time": 8613.67, "timestamp": "02:23:33", "text": "待って、これはすぐに返品しないといけない。   ああ"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "、"}, {"type": "subtitle", "time": 8617.83, "timestamp": "02:23:37", "text": "みんな。"}, {"type": "subtitle", "time": 8619.59, "timestamp": "02:23:39", "text": "これを返品するか、別の"}, {"type": "subtitle", "time": 8631.59, "timestamp": "02:23:51", "text": "これは返品しないといけないですね。   もう"}]
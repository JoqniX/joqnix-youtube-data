[{"type": "subtitle", "time": 10264.95, "timestamp": "02:51:04", "text": "彼がそれを見るべきだったのは、それが"}, {"type": "subtitle", "time": 10270.15, "timestamp": "02:51:10", "text": "動き始めた時とかそういう時だったはずだ。"}, {"type": "subtitle", "time": 10274.15, "timestamp": "02:51:14", "text": "それは午後6時頃だった。"}, {"type": "subtitle", "time": 10288.55, "timestamp": "02:51:28", "text": "だから、向こう側を見ると、"}, {"type": "subtitle", "time": 10305.11, "timestamp": "02:51:45", "text": "建物の屋上に湾曲したテレビがあるのが見えます。 うん。 そしてその"}, {"type": "subtitle", "time": 10306.79, "timestamp": "02:51:46", "text": "先には新宿駅がある。"}, {"type": "subtitle", "time": 10309.83, "timestamp": "02:51:49", "text": "それでは、家に帰りましょう。"}]
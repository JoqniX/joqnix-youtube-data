[{"type": "subtitle", "time": 7783.43, "timestamp": "02:09:43", "text": "なぜ私にはわからないのか？ なぜ私は物が見えないのか"}, {"type": "subtitle", "time": 7785.669, "timestamp": "02:09:45", "text": "？"}, {"type": "subtitle", "time": 7793.27, "timestamp": "02:09:53", "text": "このフルーツミックスがいいかもしれない"}, {"type": "subtitle", "time": 7795.43, "timestamp": "02:09:55", "text": "。   もう一度言わせてください"}, {"type": "subtitle", "time": 7798.87, "timestamp": "02:09:58", "text": "。   もしかしたら、"}]
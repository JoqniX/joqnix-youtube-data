[{"type": "subtitle", "time": 1210.71, "timestamp": "00:20:10", "text": "私が住むことはできません"}, {"type": "subtitle", "time": 1213.27, "timestamp": "00:20:13", "text": "。そこは居住エリアではありません。 それで、"}, {"type": "subtitle", "time": 1243.51, "timestamp": "00:20:43", "text": "私は新宿駅の近くにいました。 まるで"}, {"type": "subtitle", "time": 1245.59, "timestamp": "00:20:45", "text": "そこに大きな像か"}, {"type": "subtitle", "time": 1249.19, "timestamp": "00:20:49", "text": "何かがあったかのようだった。 うん。 ええ、"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "今日のことについて気になっていたんです。   えっと、あと、"}, {"type": "subtitle", "time": 1258.87, "timestamp": "00:20:58", "text": "ヨギサンかメイハガンに聞きたいのですが、"}]
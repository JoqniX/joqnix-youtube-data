[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "。 あの画面。 すごくいいよ、兄弟。"}, {"type": "subtitle", "time": 11112.23, "timestamp": "03:05:12", "text": "ストリームが途切れたら教えてくださいね。"}, {"type": "subtitle", "time": 11113.91, "timestamp": "03:05:13", "text": "ネットワーク障害が発生するでしょう。 ぜひ教えてくださいね。"}, {"type": "subtitle", "time": 11125.03, "timestamp": "03:05:25", "text": "一番面白いのは猫だ"}, {"type": "subtitle", "time": 11127.91, "timestamp": "03:05:27", "text": "。 猫だよ。 あと、提灯"}]
[{"type": "subtitle", "time": 8760.469, "timestamp": "02:26:00", "text": "Twitchは正常に動作していますか？ よし、Twitchは正常に"}, {"type": "subtitle", "time": 8763.99, "timestamp": "02:26:03", "text": "動作している。 キック。 ああ、キックもちゃんと機能してるよ。   わかりました"}, {"type": "subtitle", "time": 8770.07, "timestamp": "02:26:10", "text": "返して、そのまま"}, {"type": "subtitle", "time": 8774.07, "timestamp": "02:26:14", "text": "歩きましょう。 私のモバイルバッテリーを使って、"}, {"type": "subtitle", "time": 8778.23, "timestamp": "02:26:18", "text": "家に帰りましょう。 駅に戻る。"}, {"type": "subtitle", "time": 8809.75, "timestamp": "02:26:49", "text": "それは、"}, {"type": "subtitle", "time": 8812.309, "timestamp": "02:26:52", "text": "カークラブの退職条件となるトラックだ。 何？"}]
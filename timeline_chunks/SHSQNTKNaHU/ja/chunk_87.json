[{"type": "subtitle", "time": 5220.47, "timestamp": "01:27:00", "text": "あ、待って。 シャリア・クロッシングに似ているが、"}, {"type": "subtitle", "time": 5223.675, "timestamp": "01:27:03", "text": "シラ・クロッシングではない。 行かなければならない。"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "今、本当にたくさんの人が渡っています。"}, {"type": "subtitle", "time": 5249.75, "timestamp": "01:27:29", "text": "新宿大通り2番地。"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "でも、私には品格がある。 明日学校があります"}, {"type": "subtitle", "time": 5262.149, "timestamp": "01:27:42", "text": "。"}]
[{"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "新宿のスキアやシカ、その他の場所もあって、また"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "充電器を差し込んで"}, {"type": "subtitle", "time": 759.829, "timestamp": "00:12:39", "text": "モバイルバッテリーを"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "昨日みたいに100%までフル充電できる場所を探してたんだけど、すごく"}, {"type": "subtitle", "time": 769.19, "timestamp": "00:12:49", "text": "難しいんだ。"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "それで、結局この人を買うことになったんです。"}, {"type": "subtitle", "time": 774.47, "timestamp": "00:12:54", "text": "見えるかどうかわかりませんが、これは"}, {"type": "subtitle", "time": 779.19, "timestamp": "00:12:59", "text": "充電ポート付きの充電器です。"}]
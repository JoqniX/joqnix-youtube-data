[{"type": "subtitle", "time": 4157.99, "timestamp": "01:09:17", "text": "嬉しい。 ええ、昨日港で買いました"}, {"type": "subtitle", "time": 4159.749, "timestamp": "01:09:19", "text": "。   私は"}, {"type": "subtitle", "time": 4162.87, "timestamp": "01:09:22", "text": "この傘のことをずっと忘れないだろう。"}, {"type": "subtitle", "time": 4164.47, "timestamp": "01:09:24", "text": "「そうそう、これは"}, {"type": "subtitle", "time": 4172.95, "timestamp": "01:09:32", "text": "このホストとKカップのためにイナトシティで買った傘なんだよ」って言うと思う。 ええと、結局、"}, {"type": "subtitle", "time": 4188.47, "timestamp": "01:09:48", "text": "6番出口か何かだったと思います。"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "新宿"}, {"type": "subtitle", "time": 4198.149, "timestamp": "01:09:58", "text": "6 番出口。ああ、"}]
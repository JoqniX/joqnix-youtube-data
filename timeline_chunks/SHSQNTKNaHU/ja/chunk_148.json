[{"type": "subtitle", "time": 8897.349, "timestamp": "02:28:17", "text": "いいえ、バッテリーは持っていません。   いや"}, {"type": "subtitle", "time": 8901.59, "timestamp": "02:28:21", "text": "、待って。 もう一つ飲んだらどうなる？   そうするつもりです"}, {"type": "subtitle", "time": 8904.63, "timestamp": "02:28:24", "text": "。"}, {"type": "subtitle", "time": 8910.23, "timestamp": "02:28:30", "text": "別の充電器を使って、もう一度やってみたらどうだろう"}, {"type": "subtitle", "time": 8913.83, "timestamp": "02:28:33", "text": "？"}, {"type": "subtitle", "time": 8915.51, "timestamp": "02:28:35", "text": "しかし、やはり値段は高くなるだろう"}, {"type": "subtitle", "time": 8918.309, "timestamp": "02:28:38", "text": "。"}, {"type": "subtitle", "time": 8921.99, "timestamp": "02:28:41", "text": "いいえ、でも、"}, {"type": "subtitle", "time": 8925.59, "timestamp": "02:28:45", "text": "後で分かると思いますよ。"}, {"type": "subtitle", "time": 8927.67, "timestamp": "02:28:47", "text": "私たちはもう3時間配信しています。 右。"}, {"type": "subtitle", "time": 8929.99, "timestamp": "02:28:49", "text": "じゃあ、また"}, {"type": "subtitle", "time": 8936.23, "timestamp": "02:28:56", "text": "あそこまで戻らないといけないってことですよね？ 最良の方法。"}, {"type": "subtitle", "time": 8938.95, "timestamp": "02:28:58", "text": "こんにちは。 おかえりなさい、アラス。"}]
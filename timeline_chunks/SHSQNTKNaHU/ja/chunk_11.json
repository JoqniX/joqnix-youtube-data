[{"type": "subtitle", "time": 662.389, "timestamp": "00:11:02", "text": "昨日はネットカフェに泊まりました。"}, {"type": "subtitle", "time": 664.63, "timestamp": "00:11:04", "text": "ああ、目が"}, {"type": "subtitle", "time": 669.75, "timestamp": "00:11:09", "text": "覚めたら、すべてがすっきりしていた。 私はしくじった"}, {"type": "subtitle", "time": 672.63, "timestamp": "00:11:12", "text": "。"}, {"type": "subtitle", "time": 675.99, "timestamp": "00:11:15", "text": "今、"}, {"type": "subtitle", "time": 678.63, "timestamp": "00:11:18", "text": "Google マップを見ると、スポンサー"}, {"type": "subtitle", "time": 683.19, "timestamp": "00:11:23", "text": "広告のようなものがあって、私が通っていた"}, {"type": "subtitle", "time": 687.43, "timestamp": "00:11:27", "text": "三国高校が行こうとしていた学校です。 それは新宿にあったのです"}, {"type": "subtitle", "time": 693.35, "timestamp": "00:11:33", "text": "が、私が"}, {"type": "subtitle", "time": 695.43, "timestamp": "00:11:35", "text": "地図を頼りに新宿に行ったのに、そこではなかったのです"}, {"type": "subtitle", "time": 700.63, "timestamp": "00:11:40", "text": "。 それは『たむたまのめ』か"}, {"type": "subtitle", "time": 703.269, "timestamp": "00:11:43", "text": "何かだったと思う。"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "JR17線でそこに行かないといけないんだけど、2駅くらいで、"}]
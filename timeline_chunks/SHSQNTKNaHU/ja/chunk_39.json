[{"type": "subtitle", "time": 2344.71, "timestamp": "00:39:04", "text": "昨日の配信はどうでしたか？ 皆さんは"}, {"type": "subtitle", "time": 2347.91, "timestamp": "00:39:07", "text": "気に入ってくれましたか？ 電話が揺れているのは分かっています"}, {"type": "subtitle", "time": 2350.87, "timestamp": "00:39:10", "text": "。 私は"}, {"type": "subtitle", "time": 2354.63, "timestamp": "00:39:14", "text": "品質向上など、改善を望んでいます。 私はそうしたいと思っています。"}, {"type": "subtitle", "time": 2357.43, "timestamp": "00:39:17", "text": "いつかスタビライザーか"}, {"type": "subtitle", "time": 2368.95, "timestamp": "00:39:28", "text": "ここは一体何ですか？"}]
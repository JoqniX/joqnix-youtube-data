[{"type": "subtitle", "time": 10980.23, "timestamp": "03:03:00", "text": "うん。 えっと、8時か9時になると思うので、"}, {"type": "subtitle", "time": 10981.67, "timestamp": "03:03:01", "text": "戻らなきゃ。"}, {"type": "subtitle", "time": 10984.15, "timestamp": "03:03:04", "text": "電車に乗らなきゃいけないんだよね？"}, {"type": "subtitle", "time": 10988.15, "timestamp": "03:03:08", "text": "帰りの電車があれば、荷物をまとめて"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "おっと、何か欲しい人がいるみたいですね。"}, {"type": "subtitle", "time": 11003.67, "timestamp": "03:03:23", "text": "なぜ？ 写真を撮ってもいいですよ。 私だけ？"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "いいえ、"}, {"type": "subtitle", "time": 11010.469, "timestamp": "03:03:30", "text": "音楽ではありません。"}, {"type": "subtitle", "time": 11013.03, "timestamp": "03:03:33", "text": "ここにはかわいいものがあります。 なぜそれが"}, {"type": "subtitle", "time": 11017.99, "timestamp": "03:03:37", "text": "ナイフの一種なのか？"}, {"type": "subtitle", "time": 11038.71, "timestamp": "03:03:58", "text": "待って、"}]
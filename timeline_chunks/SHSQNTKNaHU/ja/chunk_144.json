[{"type": "subtitle", "time": 8673.03, "timestamp": "02:24:33", "text": "兄弟。 私はセブンイレブンに戻ってきました"}, {"type": "subtitle", "time": 8675.51, "timestamp": "02:24:35", "text": "。"}, {"type": "subtitle", "time": 8683.75, "timestamp": "02:24:43", "text": "私は歩き続け、歩き続け、"}, {"type": "subtitle", "time": 8687.75, "timestamp": "02:24:47", "text": "歩き続け、そして"}, {"type": "subtitle", "time": 8691.19, "timestamp": "02:24:51", "text": "ドクターコーヒーショップに戻ってきました。 何てことだ。"}, {"type": "subtitle", "time": 8694.79, "timestamp": "02:24:54", "text": "私は本当にここに戻ってきたんです。 私をからかってるの"}, {"type": "subtitle", "time": 8698.63, "timestamp": "02:24:58", "text": "？ ゴジラの場所を探すつもりだったんだけど、たまたま"}]
[{"type": "subtitle", "time": 8951.91, "timestamp": "02:29:11", "text": "バッテリーが切れる前にやることですね。 ちょっと場面転換しましょう"}, {"type": "subtitle", "time": 8975.91, "timestamp": "02:29:35", "text": "いやー、急速充電って本当に素晴らしいね。 そうです。"}, {"type": "subtitle", "time": 8977.83, "timestamp": "02:29:37", "text": "私のモバイルバッテリーは、他のどんなものよりも優れている"}, {"type": "subtitle", "time": 8981.75, "timestamp": "02:29:41", "text": "。 正直に言わせてもらうとね"}, {"type": "subtitle", "time": 8984.79, "timestamp": "02:29:44", "text": "。"}]
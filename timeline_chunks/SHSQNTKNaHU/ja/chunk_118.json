[{"type": "subtitle", "time": 7083.75, "timestamp": "01:58:03", "text": "。 えっと、それは新宿"}, {"type": "subtitle", "time": 7090.39, "timestamp": "01:58:10", "text": "駅だから。 そこから"}, {"type": "subtitle", "time": 7094.07, "timestamp": "01:58:14", "text": "電車に乗って、いろいろとやっていきます。"}, {"type": "subtitle", "time": 7096.39, "timestamp": "01:58:16", "text": "でも、すごくお腹が空いた。"}, {"type": "subtitle", "time": 7117.189, "timestamp": "01:58:37", "text": "今どこにいるのか分かりません。   私は"}, {"type": "subtitle", "time": 7120.709, "timestamp": "01:58:40", "text": "ここを通ったのだろうか？"}]
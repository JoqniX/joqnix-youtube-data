[{"type": "subtitle", "time": 9613.27, "timestamp": "02:40:13", "text": "さて、戻ってきました。 戻ってきました。 すみません、"}, {"type": "subtitle", "time": 9616.23, "timestamp": "02:40:16", "text": "地図を確認する必要がありました。 それでは、"}, {"type": "subtitle", "time": 9619.83, "timestamp": "02:40:19", "text": "ゴジラの頭の部分に行きましょう。"}, {"type": "subtitle", "time": 9621.59, "timestamp": "02:40:21", "text": "よし、"}, {"type": "subtitle", "time": 9624.95, "timestamp": "02:40:24", "text": "じゃあゴジラの頭の方へ行こう。"}, {"type": "subtitle", "time": 9628.23, "timestamp": "02:40:28", "text": "いいえ、私はまっすぐ行くと"}]
[{"type": "subtitle", "time": 630.47, "timestamp": "00:10:30", "text": "今、生放送中ですか？ 生放送中ですか？"}, {"type": "subtitle", "time": 640.31, "timestamp": "00:10:40", "text": "私は戻ってきたのでしょうか？ 私は戻ってきたのでしょうか？"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "今日何が起こっているのか教えてください。"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "昨日の東京での"}, {"type": "subtitle", "time": 650.23, "timestamp": "00:10:50", "text": "配信と同じように、とてもうまくいきました。"}, {"type": "subtitle", "time": 653.35, "timestamp": "00:10:53", "text": "では、今日何が起こったのでしょうか？ なぜ"}, {"type": "subtitle", "time": 656.87, "timestamp": "00:10:56", "text": "新宿はこんなにも辛いのか？ それに、今日はバッグがすごく"}, {"type": "subtitle", "time": 659.19, "timestamp": "00:10:59", "text": "重い。"}]
[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "バッグの中にプリングルズが入っていた。 それで、プリングルスのポテトチップスを4枚と、"}, {"type": "subtitle", "time": 9312.79, "timestamp": "02:35:12", "text": "フライドチキン、"}, {"type": "subtitle", "time": 9315.75, "timestamp": "02:35:15", "text": "骨なしのフライドチキンを食べました。 それでおしまい。 これが"}, {"type": "subtitle", "time": 9318.782, "timestamp": "02:35:18", "text": "私の夕食だと思う。"}, {"type": "subtitle", "time": 9319.349, "timestamp": "02:35:19", "text": "[笑い]"}, {"type": "subtitle", "time": 9322.15, "timestamp": "02:35:22", "text": "あの女の子はただ怖がっているだけだよ。 ゴキブリのせいで、私たちはものすごく怖がっている"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "。   何てことだ"}, {"type": "subtitle", "time": 9328.15, "timestamp": "02:35:28", "text": "。 あれは見ておくべきだったよ。 何てことだ"}, {"type": "subtitle", "time": 9332.07, "timestamp": "02:35:32", "text": "。 あれは見ておくべきだったよ。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "あれは「あ、待って」って感じだった。 前述の通り。 トヨタ。"}, {"type": "subtitle", "time": 9356.389, "timestamp": "02:35:56", "text": "おお。"}, {"type": "subtitle", "time": 9358.95, "timestamp": "02:35:58", "text": "オーラを見てください。ここから発せられているオーラを見てください"}]
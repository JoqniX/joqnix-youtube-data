[{"type": "subtitle", "time": 662.389, "timestamp": "00:11:02", "text": "我昨天待在網咖。"}, {"type": "subtitle", "time": 664.63, "timestamp": "00:11:04", "text": "嗯，"}, {"type": "subtitle", "time": 669.75, "timestamp": "00:11:09", "text": "我醒來後一切都煥然一新。我搞砸了。"}, {"type": "subtitle", "time": 675.99, "timestamp": "00:11:15", "text": "我現在要說的是，當你查看"}, {"type": "subtitle", "time": 678.63, "timestamp": "00:11:18", "text": "谷歌地圖時，會看到一些贊助"}, {"type": "subtitle", "time": 683.19, "timestamp": "00:11:23", "text": "廣告之類的東西，還有我之前想去的那所學校——三國中學"}, {"type": "subtitle", "time": 687.43, "timestamp": "00:11:27", "text": "。它明明在新宿，但我去的時候，"}, {"type": "subtitle", "time": 693.35, "timestamp": "00:11:33", "text": "我"}, {"type": "subtitle", "time": 695.43, "timestamp": "00:11:35", "text": "跟著地圖來到了新宿，卻發現它"}, {"type": "subtitle", "time": 700.63, "timestamp": "00:11:40", "text": "不是新宿。好像是在 Tam Tada Manom​​ee 之"}, {"type": "subtitle", "time": 703.269, "timestamp": "00:11:43", "text": "類的。我得坐JR"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "17號線去那裡，大概兩站就到了，而且那裡還有"}]
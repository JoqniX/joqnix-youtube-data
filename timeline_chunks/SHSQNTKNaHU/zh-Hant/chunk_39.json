[{"type": "subtitle", "time": 2344.71, "timestamp": "00:39:04", "text": "昨天的直播怎麼樣？你們"}, {"type": "subtitle", "time": 2347.91, "timestamp": "00:39:07", "text": "喜歡嗎？我知道手機螢幕抖動什麼的"}, {"type": "subtitle", "time": 2350.87, "timestamp": "00:39:10", "text": "。我希望能夠提升"}, {"type": "subtitle", "time": 2354.63, "timestamp": "00:39:14", "text": "質量，例如進行升級。我確實想那樣做。"}, {"type": "subtitle", "time": 2357.43, "timestamp": "00:39:17", "text": "總有一天我們會買個穩定器之"}, {"type": "subtitle", "time": 2368.95, "timestamp": "00:39:28", "text": "這是什麼地方？看看"}]
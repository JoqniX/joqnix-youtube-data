[{"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "兄弟。所以，很多人都用像"}, {"type": "subtitle", "time": 2295.829, "timestamp": "00:38:15", "text": "45號這樣的小雨傘給我寄雨傘。"}, {"type": "subtitle", "time": 2299.03, "timestamp": "00:38:19", "text": "看來我並不孤單。"}, {"type": "subtitle", "time": 2317.99, "timestamp": "00:38:37", "text": "我不想讓我的手機沾水。我"}, {"type": "subtitle", "time": 2320.31, "timestamp": "00:38:40", "text": "之前嘗試用我的普通行動​​電源充電，但是出現了"}, {"type": "subtitle", "time": 2324.47, "timestamp": "00:38:44", "text": "錯誤，因為"}, {"type": "subtitle", "time": 2326.87, "timestamp": "00:38:46", "text": "它顯示"}]
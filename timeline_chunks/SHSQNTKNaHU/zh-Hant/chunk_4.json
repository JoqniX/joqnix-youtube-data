[{"type": "subtitle", "time": 240.47, "timestamp": "00:04:00", "text": "提前通知你。呃，還有一個壞消息，"}, {"type": "subtitle", "time": 243.27, "timestamp": "00:04:03", "text": "就是我找不到為"}, {"type": "subtitle", "time": 245.91, "timestamp": "00:04:05", "text": "我的行動"}, {"type": "subtitle", "time": 248.55, "timestamp": "00:04:08", "text": "電源充電的方法。我覺得我需要再買"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "一個行動電源。好的，我們"}, {"type": "subtitle", "time": 255.50900000000001, "timestamp": "00:04:15", "text": "稍後再做。是的，我這裡有個類似"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "臨時充電寶的接口，可以"}, {"type": "subtitle", "time": 261.43, "timestamp": "00:04:21", "text": "租用。這是我"}, {"type": "subtitle", "time": 263.749, "timestamp": "00:04:23", "text": "直播時為手機充電的方式，這樣我就可以提供"}, {"type": "subtitle", "time": 265.749, "timestamp": "00:04:25", "text": "一些直播畫面和"}, {"type": "subtitle", "time": 267.83, "timestamp": "00:04:27", "text": "其他素材給大家了。不會，所以不會卡頓或"}, {"type": "subtitle", "time": 269.43, "timestamp": "00:04:29", "text": "什麼的。  是的"}, {"type": "subtitle", "time": 273.51, "timestamp": "00:04:33", "text": "，我只希望一切順利。呃，"}, {"type": "subtitle", "time": 276.15, "timestamp": "00:04:36", "text": "而且不在乎。"}, {"type": "subtitle", "time": 277.909, "timestamp": "00:04:37", "text": "我還想說什麼？我想說的是，"}, {"type": "subtitle", "time": 282.87, "timestamp": "00:04:42", "text": "嗯，我們會進行很多散步之類的活動"}, {"type": "subtitle", "time": 285.11, "timestamp": "00:04:45", "text": "。一會兒我會把攝影機展示一下"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "。  嗯"}, {"type": "subtitle", "time": 292.55, "timestamp": "00:04:52", "text": "，咱們聊聊今天發生的"}]
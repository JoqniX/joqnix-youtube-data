[{"type": "subtitle", "time": 1701.59, "timestamp": "00:28:21", "text": "呃，"}, {"type": "subtitle", "time": 1711.11, "timestamp": "00:28:31", "text": "等等，你們現在能聽清楚了嗎？我摘下了"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "耳機。"}, {"type": "subtitle", "time": 1717.029, "timestamp": "00:28:37", "text": "我感覺麥克風好像是"}, {"type": "subtitle", "time": 1727.35, "timestamp": "00:28:47", "text": "是的，我的麥克風錄到你了。我甚至還"}, {"type": "subtitle", "time": 1733.99, "timestamp": "00:28:53", "text": "請核實。我認為應用程式"}, {"type": "subtitle", "time": 1738.549, "timestamp": "00:28:58", "text": "中的音訊設備選擇存在一些問題"}]
[{"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "所以，我不知道我要去哪裡。我"}, {"type": "subtitle", "time": 446.87, "timestamp": "00:07:26", "text": "我認識一個油管博主，她專門做"}, {"type": "subtitle", "time": 450.55, "timestamp": "00:07:30", "text": "魔法少女 Kiraakira 的虛擬偶像，一個原宿人，"}, {"type": "subtitle", "time": 457.83, "timestamp": "00:07:37", "text": "她的虛擬偶像形象就像"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "一個來自原宿新宿的外星人，充滿了魔法氣息"}, {"type": "subtitle", "time": 469.029, "timestamp": "00:07:49", "text": "。是啊，我應該"}, {"type": "subtitle", "time": 472.469, "timestamp": "00:07:52", "text": "告訴他們：「是的，我現在在"}, {"type": "subtitle", "time": 474.869, "timestamp": "00:07:54", "text": "新宿。」"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "夥計，"}]
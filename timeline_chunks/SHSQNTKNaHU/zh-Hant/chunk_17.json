[{"type": "subtitle", "time": 1022.389, "timestamp": "00:17:02", "text": "附近有沒有"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "廁所嗎？情況緊急。」他回答說：「我不知道。」我當時就想，他看我的眼神充滿了痛苦。"}, {"type": "subtitle", "time": 1028.15, "timestamp": "00:17:08", "text": "我不"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "知道該說什麼，但感覺"}, {"type": "subtitle", "time": 1033.029, "timestamp": "00:17:13", "text": "他好像很討厭"}, {"type": "subtitle", "time": 1037.11, "timestamp": "00:17:17", "text": "我似的。我心想，兄弟，你為什麼會這樣？好像你應該以正式的方式對待顧客似的。你只要告訴我廁所怎麼走就行了。你可以用比較委婉的方式說出來。但是，是的，我今天經歷了一件非常"}, {"type": "subtitle", "time": 1040.63, "timestamp": "00:17:20", "text": "奇怪的事情，我"}, {"type": "subtitle", "time": 1043.11, "timestamp": "00:17:23", "text": "不得不去那裡看看，因為我想，好吧，我不在新宿附近。  就像昨天我去馬納托市直播一樣，我想著"}]
[{"type": "subtitle", "time": 9729.349, "timestamp": "02:42:09", "text": "瘋狂了。他們在那裡貼了個貼紙。  好的。各位，稍等一下。我這就看看地圖。好的。我可能要"}, {"type": "subtitle", "time": 9758.389, "timestamp": "02:42:38", "text": "斷線了。  很高興再次見到你。好的，我們回來了。我們回來了。"}, {"type": "subtitle", "time": 9776.95, "timestamp": "02:42:56", "text": "抱歉，我得查一下地圖"}]
[{"type": "subtitle", "time": 1805.269, "timestamp": "00:30:05", "text": "看看這些大樓，蓋得真"}, {"type": "subtitle", "time": 1812.87, "timestamp": "00:30:12", "text": "高大。"}, {"type": "subtitle", "time": 1815.43, "timestamp": "00:30:15", "text": "我想去"}, {"type": "subtitle", "time": 1818.47, "timestamp": "00:30:18", "text": "看看那是什麼情況。看看那個"}, {"type": "subtitle", "time": 1825.99, "timestamp": "00:30:25", "text": "哦，拜託。滑板運動。"}, {"type": "subtitle", "time": 1833.669, "timestamp": "00:30:33", "text": "那邊根本逃不掉。太"}, {"type": "subtitle", "time": 1852.23, "timestamp": "00:30:52", "text": "，今天我們打算四處"}, {"type": "subtitle", "time": 1856.389, "timestamp": "00:30:56", "text": "逛逛。我真希望我是"}, {"type": "subtitle", "time": 1858.95, "timestamp": "00:30:58", "text": "星期六來的。我第二天晚上可以留宿，明天我得去玩溜溜球。"}]
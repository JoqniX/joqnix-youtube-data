[{"type": "subtitle", "time": 4157.99, "timestamp": "01:09:17", "text": "看到了這一點，對吧？  哇。"}, {"type": "subtitle", "time": 4161.03, "timestamp": "01:09:21", "text": "我覺得新宿很適合"}, {"type": "subtitle", "time": 4162.87, "timestamp": "01:09:22", "text": "這種氛圍。你看，"}, {"type": "subtitle", "time": 4164.47, "timestamp": "01:09:24", "text": "這裡有些人長得像韓國流行偶像。  我的狗叔叔。  我感覺自己好像根本不知道自己身在何處。  高興的。是的，我昨天在Minato買的。  我永遠都會記得這把傘。我會說：「是的，這是我從稻戶"}, {"type": "subtitle", "time": 4194.55, "timestamp": "01:09:54", "text": "市買來給這位主人的雨傘和咖啡膠囊。」呃，畢竟是71號浸泡池。我想應該是"}]
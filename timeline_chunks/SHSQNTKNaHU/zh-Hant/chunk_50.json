[{"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "等等，你們還記得"}, {"type": "subtitle", "time": 3023.829, "timestamp": "00:50:23", "text": "我拿充電器的那家咖啡店叫什麼名字嗎"}, {"type": "subtitle", "time": 3026.79, "timestamp": "00:50:26", "text": "？"}, {"type": "subtitle", "time": 3030.549, "timestamp": "00:50:30", "text": "咖啡廳.不。呃，"}, {"type": "subtitle", "time": 3050.95, "timestamp": "00:50:50", "text": "遊戲三人組站。"}, {"type": "subtitle", "time": 3053.03, "timestamp": "00:50:53", "text": "哇。我想去看看，但我沒"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "時間。"}]
[{"type": "subtitle", "time": 1210.71, "timestamp": "00:20:10", "text": "我不能住在那裡，那不是居住"}, {"type": "subtitle", "time": 1213.27, "timestamp": "00:20:13", "text": "區。所以，"}, {"type": "subtitle", "time": 1243.51, "timestamp": "00:20:43", "text": "我當時在新宿站附近。它們就像那裡曾經有一座"}, {"type": "subtitle", "time": 1245.59, "timestamp": "00:20:45", "text": "巨大的雕像之類的東西"}, {"type": "subtitle", "time": 1249.19, "timestamp": "00:20:49", "text": "。是的。是的，我一直在"}, {"type": "subtitle", "time": 1251.27, "timestamp": "00:20:51", "text": "想"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "今天會發生什麼。  呃，還有，"}, {"type": "subtitle", "time": 1258.87, "timestamp": "00:20:58", "text": "Yogisan 或 Mayhagan，"}]
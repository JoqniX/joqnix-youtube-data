[{"type": "subtitle", "time": 489.67, "timestamp": "00:08:09", "text": "讓我現在就去做。  嗯……"}, {"type": "subtitle", "time": 499.11, "timestamp": "00:08:19", "text": "我不知道自己要去哪裡。我想去"}, {"type": "subtitle", "time": 502.07, "timestamp": "00:08:22", "text": "一些地方看看。呃，那裡有個"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "國家公園，但要付500美元"}, {"type": "subtitle", "time": 506.95, "timestamp": "00:08:26", "text": "。我身上沒帶現金。我可以用現金，但我不想這麼做。我當時就想："}]
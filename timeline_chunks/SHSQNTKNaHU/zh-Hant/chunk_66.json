[{"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "我現在好害怕，因為那裡有"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "保安，還有人專門"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "針對外國人。他們"}, {"type": "subtitle", "time": 3981.67, "timestamp": "01:06:21", "text": "走過來問我要不要"}, {"type": "subtitle", "time": 3985.829, "timestamp": "01:06:25", "text": "按摩之類的，呃，都是些18歲以上才能享受的東西。"}, {"type": "subtitle", "time": 3988.069, "timestamp": "01:06:28", "text": "所以，我有點害怕。我之前把麥克風靜音了"}, {"type": "subtitle", "time": 3992.069, "timestamp": "01:06:32", "text": "，但是，哦，這是什麼？哦，這"}, {"type": "subtitle", "time": 3994.309, "timestamp": "01:06:34", "text": "是棒球相關的玩意兒。  在"}, {"type": "subtitle", "time": 4019.99, "timestamp": "01:06:59", "text": "這裡飯店和酒吧真多，哇！"}]
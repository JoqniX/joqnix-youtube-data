[{"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "我的天哪。"}, {"type": "subtitle", "time": 7269.91, "timestamp": "02:01:09", "text": "如果他死了，我就要揍他一顿。"}, {"type": "subtitle", "time": 7281.43, "timestamp": "02:01:21", "text": "不，"}, {"type": "subtitle", "time": 7298.629, "timestamp": "02:01:38", "text": "布莱恩，这家伙在胡言乱语。"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "呃，他拿走了好东西。 我发誓他"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "拿的都是好东西。"}]
[{"type": "subtitle", "time": 663.35, "timestamp": "00:11:03", "text": "稍等（笑声）。 工作地点在哪里？ 好的，"}, {"type": "subtitle", "time": 666.389, "timestamp": "00:11:06", "text": "我再运行一遍。"}, {"type": "subtitle", "time": 669.99, "timestamp": "00:11:09", "text": "为什么是现在？ 巴卡。"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "好的。 游戏。 好的。 等待。 呃。 天哪，我的"}, {"type": "subtitle", "time": 678.577, "timestamp": "00:11:18", "text": "电脑快不行了。 哦，不。 不，不，不，不，不。"}, {"type": "subtitle", "time": 679.59, "timestamp": "00:11:19", "text": "[笑声]"}, {"type": "subtitle", "time": 689.67, "timestamp": "00:11:29", "text": "兄弟。 什么？"}, {"type": "subtitle", "time": 692.15, "timestamp": "00:11:32", "text": "等等，你甚至都看不到……你"}, {"type": "subtitle", "time": 703.91, "timestamp": "00:11:43", "text": "艺术十字路口等等，为什么听不到声音？"}, {"type": "subtitle", "time": 705.99, "timestamp": "00:11:45", "text": "嗯？"}, {"type": "subtitle", "time": 708.63, "timestamp": "00:11:48", "text": "我向你们介绍这些艺术创作者。 哦，找到了"}, {"type": "subtitle", "time": 711.67, "timestamp": "00:11:51", "text": "。 好的，第四个位置。 好的，我的"}, {"type": "subtitle", "time": 715.99, "timestamp": "00:11:55", "text": "排名提高了，对吧？ 怀尔德三世。"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "好的，新东西到了。"}]
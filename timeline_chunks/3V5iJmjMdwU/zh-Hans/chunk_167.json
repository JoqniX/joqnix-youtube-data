[{"type": "subtitle", "time": 10021.51, "timestamp": "02:47:01", "text": "，对吧？ 我不明白。 但"}, {"type": "subtitle", "time": 10023.75, "timestamp": "02:47:03", "text": "有时有效，有时"}, {"type": "subtitle", "time": 10038.95, "timestamp": "02:47:18", "text": "，这件事已经办完了。 接下来"}, {"type": "subtitle", "time": 10041.99, "timestamp": "02:47:21", "text": "我要做的就是修补所有这些"}, {"type": "subtitle", "time": 10044.63, "timestamp": "02:47:24", "text": "旧的流媒体，让它们显示“流媒体"}, {"type": "subtitle", "time": 10047.19, "timestamp": "02:47:27", "text": "已结束”之类的提示"}, {"type": "subtitle", "time": 10051.269, "timestamp": "02:47:31", "text": "。 呃，我得"}, {"type": "subtitle", "time": 10054.63, "timestamp": "02:47:34", "text": "研究一下终结按钮，就是"}, {"type": "subtitle", "time": 10056.469, "timestamp": "02:47:36", "text": "这个。"}, {"type": "subtitle", "time": 10059.429, "timestamp": "02:47:39", "text": "然后最后一个，我想到那时，"}, {"type": "subtitle", "time": 10064.87, "timestamp": "02:47:44", "text": "所有这些 1 2 3 4 5 6 7 8 9"}, {"type": "subtitle", "time": 10068.55, "timestamp": "02:47:48", "text": "9 的东西，我已经 3 个"}, {"type": "subtitle", "time": 10071.269, "timestamp": "02:47:51", "text": "月专注于这件事了，"}, {"type": "subtitle", "time": 10079.19, "timestamp": "02:47:59", "text": "。"}]
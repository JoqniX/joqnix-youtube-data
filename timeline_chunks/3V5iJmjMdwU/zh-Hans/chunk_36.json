[{"type": "subtitle", "time": 2163.99, "timestamp": "00:36:03", "text": "谨慎。 不过，我现在想要的是幸存者那款"}, {"type": "subtitle", "time": 2170.71, "timestamp": "00:36:10", "text": "我能放进去的战利品越多越好"}, {"type": "subtitle", "time": 2177.109, "timestamp": "00:36:17", "text": "哦，是的。"}, {"type": "subtitle", "time": 2180.71, "timestamp": "00:36:20", "text": "这次就以发型为重点吧，为什么不呢？"}, {"type": "subtitle", "time": 2184.39, "timestamp": "00:36:24", "text": "我在省钱。"}, {"type": "subtitle", "time": 2186.405, "timestamp": "00:36:26", "text": "我正在存钱。"}, {"type": "subtitle", "time": 2187.829, "timestamp": "00:36:27", "text": "[笑声]"}, {"type": "subtitle", "time": 2190.55, "timestamp": "00:36:30", "text": "我选发夹。 我打算"}, {"type": "subtitle", "time": 2202.39, "timestamp": "00:36:42", "text": "为了探险，让我先把一些东西卸下来。"}, {"type": "subtitle", "time": 2205.91, "timestamp": "00:36:45", "text": "战斗物品。 我们可以扔掉一些"}, {"type": "subtitle", "time": 2207.75, "timestamp": "00:36:47", "text": "巴雷塔。"}, {"type": "subtitle", "time": 2215.75, "timestamp": "00:36:55", "text": "生存用品。 我们可以扔掉一些我会"}, {"type": "subtitle", "time": 2218.63, "timestamp": "00:36:58", "text": "用到的"}]
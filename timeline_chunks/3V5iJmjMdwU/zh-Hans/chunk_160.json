[{"type": "subtitle", "time": 9601.19, "timestamp": "02:40:01", "text": "想逛逛橱窗，我就会"}, {"type": "subtitle", "time": 9603.59, "timestamp": "02:40:03", "text": "买，但我没钱。 我必须"}, {"type": "subtitle", "time": 9606.389, "timestamp": "02:40:06", "text": "释放出一百万的潜能。"}, {"type": "subtitle", "time": 9610.23, "timestamp": "02:40:10", "text": "但我需要达到500万的粉丝量。"}, {"type": "subtitle", "time": 9614.469, "timestamp": "02:40:14", "text": "好了，我们这边就到此为止吧。"}, {"type": "subtitle", "time": 9619.349, "timestamp": "02:40:19", "text": "呃，我快要犯困了。"}, {"type": "subtitle", "time": 9621.59, "timestamp": "02:40:21", "text": "呃，"}, {"type": "subtitle", "time": 9640.55, "timestamp": "02:40:40", "text": "哦，结果"}, {"type": "subtitle", "time": 9649.03, "timestamp": "02:40:49", "text": "睡觉。 你好，培根。"}, {"type": "subtitle", "time": 9651.91, "timestamp": "02:40:51", "text": "老兄，说真的，培根，我觉得自己太"}, {"type": "subtitle", "time": 9655.67, "timestamp": "02:40:55", "text": "倒霉了。 就像我一样，我参加了两三次女"}, {"type": "subtitle", "time": 9658.07, "timestamp": "02:40:58", "text": "族长活动，但什么也没得到"}]
[{"type": "subtitle", "time": 9366.95, "timestamp": "02:36:06", "text": "你好。 是啊，不过我很快就要睡觉了"}, {"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "。 我快要结束了。"}, {"type": "subtitle", "time": 9376.469, "timestamp": "02:36:16", "text": "双筒望远镜。 呃，我不需要。"}, {"type": "subtitle", "time": 9393.75, "timestamp": "02:36:33", "text": "巡逻车。 巡逻车的后门。"}, {"type": "subtitle", "time": 9395.429, "timestamp": "02:36:35", "text": "什么？"}, {"type": "subtitle", "time": 9402.55, "timestamp": "02:36:42", "text": "2,00"}, {"type": "subtitle", "time": 9412.309, "timestamp": "02:36:52", "text": "我想如果我给它很多不同种类的"}, {"type": "subtitle", "time": 9416.389, "timestamp": "02:36:56", "text": "种子。 不，这样不是更好吗？"}]
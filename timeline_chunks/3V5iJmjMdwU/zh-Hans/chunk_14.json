[{"type": "subtitle", "time": 876.389, "timestamp": "00:14:36", "text": "我的天哪，我的电脑快不行了。 垂死。"}, {"type": "subtitle", "time": 880.389, "timestamp": "00:14:40", "text": "靠近点。"}, {"type": "subtitle", "time": 882.31, "timestamp": "00:14:42", "text": "我宣布过吗？ 好吧，我"}, {"type": "subtitle", "time": 885.509, "timestamp": "00:14:45", "text": "死了。 我死了。"}, {"type": "subtitle", "time": 897.59, "timestamp": "00:14:57", "text": "什么？ 呃，关掉这个。"}]
[{"type": "subtitle", "time": 485.11, "timestamp": "00:08:05", "text": "好的，我看看能不能检查一下。 好的。"}, {"type": "subtitle", "time": 487.589, "timestamp": "00:08:07", "text": "是的，当"}, {"type": "subtitle", "time": 489.189, "timestamp": "00:08:09", "text": "你的频道同时运行两个多流，一个是"}, {"type": "subtitle", "time": 491.27, "timestamp": "00:08:11", "text": "未公开的流，一个是公开的"}, {"type": "subtitle", "time": 493.589, "timestamp": "00:08:13", "text": "流时，我想，这会把一切都搞砸"}, {"type": "subtitle", "time": 495.99, "timestamp": "00:08:15", "text": "。"}, {"type": "subtitle", "time": 504.79, "timestamp": "00:08:24", "text": "，我今天想到了扮演我们的"}, {"type": "subtitle", "time": 508.07, "timestamp": "00:08:28", "text": "创造者。 嗯，游戏应该已经开始了"}, {"type": "subtitle", "time": 511.029, "timestamp": "00:08:31", "text": "。 让我们祈祷我的电脑"}, {"type": "subtitle", "time": 514.7090000000001, "timestamp": "00:08:34", "text": "不要崩溃或彻底罢工。"}, {"type": "subtitle", "time": 517.5889999999999, "timestamp": "00:08:37", "text": "真主啊，我不想你"}, {"type": "subtitle", "time": 519.829, "timestamp": "00:08:39", "text": "今天就离我而去。"}, {"type": "subtitle", "time": 522.149, "timestamp": "00:08:42", "text": "我只希望并祈祷它真的"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "有效。 我还是关掉浏览器以防"}, {"type": "subtitle", "time": 532.47, "timestamp": "00:08:52", "text": "万一吧。 这是什么？  86 无。"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "你是谁？ 我的天啊。"}]
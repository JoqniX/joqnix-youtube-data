[{"type": "subtitle", "time": 541.99, "timestamp": "00:09:01", "text": "我一直播就开始出问题。"}, {"type": "subtitle", "time": 544.55, "timestamp": "00:09:04", "text": "命令行 86。"}, {"type": "subtitle", "time": 549.269, "timestamp": "00:09:09", "text": "谁在 86 中？ 搞什么鬼，兄弟？ 让我"}, {"type": "subtitle", "time": 551.35, "timestamp": "00:09:11", "text": "安静地直播吧。 你应该"}, {"type": "subtitle", "time": 554.15, "timestamp": "00:09:14", "text": "发布公告之类的。"}, {"type": "subtitle", "time": 559.99, "timestamp": "00:09:19", "text": "目标。"}, {"type": "subtitle", "time": 561.75, "timestamp": "00:09:21", "text": "哦，"}, {"type": "subtitle", "time": 563.67, "timestamp": "00:09:23", "text": "不是。 兄弟，你说的“没有"}, {"type": "subtitle", "time": 573.19, "timestamp": "00:09:33", "text": "我的天哪。 水平的。 匆忙。 匆忙。"}, {"type": "subtitle", "time": 575.91, "timestamp": "00:09:35", "text": "横卧的女士。 它就在那里。"}, {"type": "subtitle", "time": 577.67, "timestamp": "00:09:37", "text": "什么？"}, {"type": "subtitle", "time": 587.19, "timestamp": "00:09:47", "text": "我想，我想"}, {"type": "subtitle", "time": 589.91, "timestamp": "00:09:49", "text": "罚款。"}, {"type": "subtitle", "time": 591.67, "timestamp": "00:09:51", "text": "乳霜"}, {"type": "subtitle", "time": 598.389, "timestamp": "00:09:58", "text": "怎么会这样损坏呢？ 你不"}]
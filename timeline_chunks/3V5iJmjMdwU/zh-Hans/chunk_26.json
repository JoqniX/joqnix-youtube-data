[{"type": "subtitle", "time": 1574.39, "timestamp": "00:26:14", "text": "呃，"}, {"type": "subtitle", "time": 1580.39, "timestamp": "00:26:20", "text": "我的天哪。（叹气）"}, {"type": "subtitle", "time": 1583.35, "timestamp": "00:26:23", "text": "发布这条愚蠢的公告。 迪奥，"}, {"type": "subtitle", "time": 1590.31, "timestamp": "00:26:30", "text": "。   是的"}, {"type": "subtitle", "time": 1595.35, "timestamp": "00:26:35", "text": "。 好的。 最终，枪支管制"}, {"type": "subtitle", "time": 1598.39, "timestamp": "00:26:38", "text": "公告发布了。 好的。 最后。"}, {"type": "subtitle", "time": 1601.11, "timestamp": "00:26:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 1603.35, "timestamp": "00:26:43", "text": "好的，我会解决这些问题。 我找到了"}, {"type": "subtitle", "time": 1605.35, "timestamp": "00:26:45", "text": "问题所在。 我会修好它们。 等等，"}, {"type": "subtitle", "time": 1608.149, "timestamp": "00:26:48", "text": "Discord服务器还在运行吗？"}, {"type": "subtitle", "time": 1611.269, "timestamp": "00:26:51", "text": "兄弟，那根本就不是在跑。 啊，那就这样吧"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "。 它会自动运行。"}, {"type": "subtitle", "time": 1616.39, "timestamp": "00:26:56", "text": "节省。"}, {"type": "subtitle", "time": 1618.63, "timestamp": "00:26:58", "text": "好的，下一条路。 我会确保这些……"}]
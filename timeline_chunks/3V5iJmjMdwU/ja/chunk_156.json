[{"type": "subtitle", "time": 9366.95, "timestamp": "02:36:06", "text": "こんにちは。 うん、でももうすぐ寝るよ"}, {"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "。 もう終わりにします。"}, {"type": "subtitle", "time": 9376.469, "timestamp": "02:36:16", "text": "双眼鏡。 えっと、必要ありません。"}, {"type": "subtitle", "time": 9393.75, "timestamp": "02:36:33", "text": "パトカー。 パトカーの後部ドア。"}, {"type": "subtitle", "time": 9395.429, "timestamp": "02:36:35", "text": "何？"}, {"type": "subtitle", "time": 9402.55, "timestamp": "02:36:42", "text": "2,00"}, {"type": "subtitle", "time": 9412.309, "timestamp": "02:36:52", "text": "色々な種を沢山与えたらいいと思います"}, {"type": "subtitle", "time": 9416.389, "timestamp": "02:36:56", "text": "。 いいえ。そのほうがいいんじゃないですか？"}]
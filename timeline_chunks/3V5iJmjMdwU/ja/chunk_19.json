[{"type": "subtitle", "time": 1149.27, "timestamp": "00:19:09", "text": "したがって、処理日数は忍耐が予想される"}, {"type": "subtitle", "time": 1160.15, "timestamp": "00:19:20", "text": "兄弟のために無効なボディを予約します。"}, {"type": "subtitle", "time": 1162.549, "timestamp": "00:19:22", "text": "いくつか殺してみます。  [笑い] ああ、なんてことだ"}, {"type": "subtitle", "time": 1165.27, "timestamp": "00:19:25", "text": "。"}, {"type": "subtitle", "time": 1178.87, "timestamp": "00:19:38", "text": "ナラニ。"}, {"type": "subtitle", "time": 1182.933, "timestamp": "00:19:42", "text": "null とはどういう意味ですか?"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "[笑い] 誰が"}, {"type": "subtitle", "time": 1187.669, "timestamp": "00:19:47", "text": "待っていますか?"}]
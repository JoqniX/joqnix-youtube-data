[{"type": "subtitle", "time": 10140.162, "timestamp": "02:49:00", "text": "日本の会社で働くのは無理だと思います。 私はここで死ぬだろう。"}, {"type": "subtitle", "time": 10145.03, "timestamp": "02:49:05", "text": "そして彼らはとても厳格で、とても"}, {"type": "subtitle", "time": 10147.269, "timestamp": "02:49:07", "text": "苦痛です。 だから私は決してそんなことはしないと思います"}, {"type": "subtitle", "time": 10150.71, "timestamp": "02:49:10", "text": "。 いいえ。 いいえ。 いいえ。"}, {"type": "subtitle", "time": 10158.23, "timestamp": "02:49:18", "text": "、ええと、私はそう思うので"}, {"type": "subtitle", "time": 10160.469, "timestamp": "02:49:20", "text": "、今週はもっとストリームをすべきかどうか考えています。"}, {"type": "subtitle", "time": 10163.11, "timestamp": "02:49:23", "text": "試験は"}, {"type": "subtitle", "time": 10167.429, "timestamp": "02:49:27", "text": "日曜日にあり、金曜日までに出発しなければならないからです。"}, {"type": "subtitle", "time": 10169.91, "timestamp": "02:49:29", "text": "さて、今日はもう火曜日ですね。 ということで、1"}, {"type": "subtitle", "time": 10173.11, "timestamp": "02:49:33", "text": "2 3 あと3日あります。 だから、ストリーミングの回数を"}, {"type": "subtitle", "time": 10177.91, "timestamp": "02:49:37", "text": "減らしてみようかと考えていました。"}, {"type": "subtitle", "time": 10179.51, "timestamp": "02:49:39", "text": "ああ、"}, {"type": "subtitle", "time": 10182.469, "timestamp": "02:49:42", "text": "最後のストリーム。 つまり、ストリーミングはたった1時間です。   わかった"}, {"type": "subtitle", "time": 10186.79, "timestamp": "02:49:46", "text": "。 ええ、1時間の配信の"}, {"type": "subtitle", "time": 10197.75, "timestamp": "02:49:57", "text": "日本のものを配信するかどうかはわかりません。 つまり、"}]
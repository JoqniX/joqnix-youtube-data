[{"type": "subtitle", "time": 485.11, "timestamp": "00:08:05", "text": "。 わかった。"}, {"type": "subtitle", "time": 487.589, "timestamp": "00:08:07", "text": "そうですね、チャンネルで 2 つのマルチ ストリームを"}, {"type": "subtitle", "time": 489.189, "timestamp": "00:08:09", "text": "実行している場合、1 つは"}, {"type": "subtitle", "time": 491.27, "timestamp": "00:08:11", "text": "非公開ストリームで、もう 1 つは公開"}, {"type": "subtitle", "time": 493.589, "timestamp": "00:08:13", "text": "ストリームなので、すべてが台無しになると"}, {"type": "subtitle", "time": 495.99, "timestamp": "00:08:15", "text": "思います。"}, {"type": "subtitle", "time": 504.79, "timestamp": "00:08:24", "text": "、今日は私たちのクリエイターたちとプレイしようと思いました"}, {"type": "subtitle", "time": 508.07, "timestamp": "00:08:28", "text": "。 えっと、ゲームはオープンだと"}, {"type": "subtitle", "time": 511.029, "timestamp": "00:08:31", "text": "思います。 私の PC が"}, {"type": "subtitle", "time": 514.7090000000001, "timestamp": "00:08:34", "text": "故障したり諦めたりしないように祈りましょう。"}, {"type": "subtitle", "time": 517.5889999999999, "timestamp": "00:08:37", "text": "アッラーよ、私はあなたが"}, {"type": "subtitle", "time": 519.829, "timestamp": "00:08:39", "text": "今日死ぬことを望みません。"}, {"type": "subtitle", "time": 522.149, "timestamp": "00:08:42", "text": "私はただそれが実際に機能することを望み、祈るだけです"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "。 念のためブラウザを閉じておきます"}, {"type": "subtitle", "time": 532.47, "timestamp": "00:08:52", "text": "。 これは何ですか？  86 なし。"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "あなたは誰ですか？ 何てことだ。"}]
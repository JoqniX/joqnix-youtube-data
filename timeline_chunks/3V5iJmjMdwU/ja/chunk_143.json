[{"type": "subtitle", "time": 8584.389, "timestamp": "02:23:04", "text": "初めてじゃないよ。"}, {"type": "subtitle", "time": 8587.27, "timestamp": "02:23:07", "text": "クソッ、おい。 何も持っていませんでした。 そして私は"}, {"type": "subtitle", "time": 8591.19, "timestamp": "02:23:11", "text": "とてもいいですね。"}, {"type": "subtitle", "time": 8592.79, "timestamp": "02:23:12", "text": "どうもありがとう。"}, {"type": "subtitle", "time": 8595.99, "timestamp": "02:23:15", "text": "うん。 うん。 うん。 ありがとう。 最初の"}, {"type": "subtitle", "time": 8598.23, "timestamp": "02:23:18", "text": "2 つが文字通りあと 2 つ必要です。 もっとください"}, {"type": "subtitle", "time": 8600.23, "timestamp": "02:23:20", "text": "。 もう1つ下さい。"}, {"type": "subtitle", "time": 8603.75, "timestamp": "02:23:23", "text": "何？ しかし、この材料をどのように使用して、"}, {"type": "subtitle", "time": 8620.544, "timestamp": "02:23:40", "text": "919."}, {"type": "subtitle", "time": 8626.71, "timestamp": "02:23:46", "text": "みなさん、こんにちは。"}, {"type": "subtitle", "time": 8635.03, "timestamp": "02:23:55", "text": "ああ、これは本当に忙しい。 やあみんな。 ああ、"}]
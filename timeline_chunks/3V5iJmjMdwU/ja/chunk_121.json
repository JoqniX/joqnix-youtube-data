[{"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "。   ごめん"}, {"type": "subtitle", "time": 7269.91, "timestamp": "02:01:09", "text": "もし彼が死んだら、私は彼を殴り倒すつもりだ。"}, {"type": "subtitle", "time": 7281.43, "timestamp": "02:01:21", "text": "いや。"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "いいえ。"}, {"type": "subtitle", "time": 7298.629, "timestamp": "02:01:38", "text": "ブライアン、この男はグープしているよ。   グープをちょうだい"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "ええと、彼は良いものを持っていきました。 彼は"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "良いものを盗んだと断言します。"}]
[{"type": "subtitle", "time": 7401.43, "timestamp": "02:03:21", "text": "ああ、女王、えーと、女"}, {"type": "subtitle", "time": 7405.109, "timestamp": "02:03:25", "text": "家長的なものはわかりませんでした。"}, {"type": "subtitle", "time": 7409.75, "timestamp": "02:03:29", "text": "うわー、私は女家長の男を理解できなかった。"}, {"type": "subtitle", "time": 7428.39, "timestamp": "02:03:48", "text": "この人、すごく助けてくれたよね？"}]
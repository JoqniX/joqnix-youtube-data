[{"type": "subtitle", "time": 1080.15, "timestamp": "00:18:00", "text": "密告者を捕まえることです。 スズメバチを産ませましょう。 それは"}, {"type": "subtitle", "time": 1086.95, "timestamp": "00:18:06", "text": "スズメバチを殺すより簡単な方法です。 でも、大きくていい銃が必要なんだ。"}, {"type": "subtitle", "time": 1090.71, "timestamp": "00:18:10", "text": "紫色のティアの銃。 ショックなことではないよ。"}, {"type": "subtitle", "time": 1099.35, "timestamp": "00:18:19", "text": "、これは簡単ですね。"}, {"type": "subtitle", "time": 1101.669, "timestamp": "00:18:21", "text": "ダムが使えるようになりました。"}, {"type": "subtitle", "time": 1105.27, "timestamp": "00:18:25", "text": "ダムはそれを実行するのに適したマップになります"}, {"type": "subtitle", "time": 1108.71, "timestamp": "00:18:28", "text": "。 うん。 うん。 ダムはそれを実行するのに適したマップになります"}, {"type": "subtitle", "time": 1117.669, "timestamp": "00:18:37", "text": "うん。 これを行うにはダムが適したマップになります"}]
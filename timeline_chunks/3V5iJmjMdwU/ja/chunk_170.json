[{"type": "subtitle", "time": 10203.349, "timestamp": "02:50:03", "text": "今は教科書のような日本語のことをやってみたいんです。 教科書を"}, {"type": "subtitle", "time": 10205.91, "timestamp": "02:50:05", "text": "最初から最後まで逆さに書いてみてください。 私はそれを24時間"}, {"type": "subtitle", "time": 10210.07, "timestamp": "02:50:10", "text": "365日やりたいです。 ぜひそうしたいです。   構わない"}, {"type": "subtitle", "time": 10212.55, "timestamp": "02:50:12", "text": "けど、"}, {"type": "subtitle", "time": 10233.269, "timestamp": "02:50:33", "text": "うーん、ストリームが安定していませんでした。 そうですね、"}, {"type": "subtitle", "time": 10237.03, "timestamp": "02:50:37", "text": "ストリーミングをしなかったり、ただ"}, {"type": "subtitle", "time": 10239.51, "timestamp": "02:50:39", "text": "プロになったりすると、先延ばしにすることが"}, {"type": "subtitle", "time": 10242.15, "timestamp": "02:50:42", "text": "多くなります。 私は何か他のことをするつもりです。"}, {"type": "subtitle", "time": 10244.389, "timestamp": "02:50:44", "text": "文字通り"}, {"type": "subtitle", "time": 10246.87, "timestamp": "02:50:46", "text": "毎日何かをやらなきゃいけない。 私はそれを"}, {"type": "subtitle", "time": 10250.63, "timestamp": "02:50:50", "text": "きちんとやっていなかったので、それは良くありません。 私はもう"}, {"type": "subtitle", "time": 10254.55, "timestamp": "02:50:54", "text": "クラスで一番弱いんです。 えっと、"}, {"type": "subtitle", "time": 10257.03, "timestamp": "02:50:57", "text": "漢字の練習が足りないので、"}, {"type": "subtitle", "time": 10259.83, "timestamp": "02:50:59", "text": "練習を始めないといけません。 しかし、"}]
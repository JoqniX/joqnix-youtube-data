[{"type": "subtitle", "time": 7334.55, "timestamp": "02:02:14", "text": "ああ、リーパー。 俺は何を"}, {"type": "subtitle", "time": 7335.43, "timestamp": "02:02:15", "text": "残すか分かってるよ。"}, {"type": "subtitle", "time": 7366.95, "timestamp": "02:02:46", "text": "アークオービターが飛行中です。 安全"}, {"type": "subtitle", "time": 7367.99, "timestamp": "02:02:47", "text": "窓が閉まります。"}, {"type": "subtitle", "time": 7371.109, "timestamp": "02:02:51", "text": "はい、終わりました。"}, {"type": "subtitle", "time": 7374.07, "timestamp": "02:02:54", "text": "繰り返しますが、10分です。"}, {"type": "subtitle", "time": 7376.87, "timestamp": "02:02:56", "text": "こんにちは。"}, {"type": "subtitle", "time": 7379.669, "timestamp": "02:02:59", "text": "待ってください、誰かが実際に開けました。 ああ、"}]
[{"type": "subtitle", "time": 1202.39, "timestamp": "00:20:02", "text": "ああ、悪くないね。 平和的に配信させてください。"}, {"type": "subtitle", "time": 1212.549, "timestamp": "00:20:12", "text": "簡単に作れる方法があればいいのですが。   ああ、なんてことだ"}, {"type": "subtitle", "time": 1215.59, "timestamp": "00:20:15", "text": "。 ライブ配信する前に、なぜ"}, {"type": "subtitle", "time": 1217.669, "timestamp": "00:20:17", "text": "別のテストストリームを作成して"}, {"type": "subtitle", "time": 1220.07, "timestamp": "00:20:20", "text": "すべてをテストする必要があるのでしょうか"}, {"type": "subtitle", "time": 1224.63, "timestamp": "00:20:24", "text": "?  [鼻で笑う] 正直に言うと。"}, {"type": "subtitle", "time": 1228.23, "timestamp": "00:20:28", "text": "とにかく、ゲームを始めましょう。"}, {"type": "subtitle", "time": 1230.789, "timestamp": "00:20:30", "text": "私はここに閉じ込められてしまうでしょう。 そうそう。 うん。 おお。"}, {"type": "subtitle", "time": 1232.789, "timestamp": "00:20:32", "text": "そうそう。 そうそう。"}, {"type": "subtitle", "time": 1235.59, "timestamp": "00:20:35", "text": "前回の実行でトレントブループリントを取得しました。 忘れた。 そうそう。"}, {"type": "subtitle", "time": 1237.669, "timestamp": "00:20:37", "text": "うん。 うん。"}, {"type": "subtitle", "time": 1241.669, "timestamp": "00:20:41", "text": "ああ忘れてた。 そうそう。 いいものを手に入れたよね"}, {"type": "subtitle", "time": 1243.99, "timestamp": "00:20:43", "text": "？ うん。 忘れた。 俺はそんな"}, {"type": "subtitle", "time": 1251.11, "timestamp": "00:20:51", "text": "。 すごくかっこいいですね。 はい、あれとあれをいただきます"}, {"type": "subtitle", "time": 1253.27, "timestamp": "00:20:53", "text": "。"}, {"type": "chat", "time": 1257.87, "timestamp": "00:20:57", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "Did you finish the expedition?"}]
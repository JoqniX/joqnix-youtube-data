[{"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "ああ、ついに試合ができた。   さあ行こう"}, {"type": "subtitle", "time": 7942.87, "timestamp": "02:12:22", "text": "待って、それはまだマットトラックですよね？"}, {"type": "subtitle", "time": 7970.629, "timestamp": "02:12:50", "text": "ああ、そうなんですね。 わかった。 わかった。 わかった。 わかった。"}, {"type": "subtitle", "time": 7971.75, "timestamp": "02:12:51", "text": "発射塔まで行きます。"}, {"type": "subtitle", "time": 7974.47, "timestamp": "02:12:54", "text": "発射塔へ行きましょう。"}, {"type": "subtitle", "time": 7976.709, "timestamp": "02:12:56", "text": "その前に、いくつか偵察する必要がある"}]
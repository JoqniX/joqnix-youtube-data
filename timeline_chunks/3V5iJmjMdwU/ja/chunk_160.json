[{"type": "subtitle", "time": 9601.19, "timestamp": "02:40:01", "text": "ウィンドウショッピングがしたければ、"}, {"type": "subtitle", "time": 9603.59, "timestamp": "02:40:03", "text": "買いたいのですが、お金がありません。 私は100"}, {"type": "subtitle", "time": 9606.389, "timestamp": "02:40:06", "text": "万で解き放たれなければなりません。"}, {"type": "subtitle", "time": 9610.23, "timestamp": "02:40:10", "text": "ただし、500万に達する必要があります。"}, {"type": "subtitle", "time": 9614.469, "timestamp": "02:40:14", "text": "さあ、ここで終わりにしましょう。"}, {"type": "subtitle", "time": 9619.349, "timestamp": "02:40:19", "text": "うーん、寝すぎちゃう。"}, {"type": "subtitle", "time": 9621.59, "timestamp": "02:40:21", "text": "えっと、あぁ"}, {"type": "subtitle", "time": 9640.55, "timestamp": "02:40:40", "text": "、"}, {"type": "subtitle", "time": 9649.03, "timestamp": "02:40:49", "text": "寝る。 こんにちは、ベーコン。"}, {"type": "subtitle", "time": 9651.91, "timestamp": "02:40:51", "text": "正直に言うと、ベーコン、僕はとても"}, {"type": "subtitle", "time": 9655.67, "timestamp": "02:40:55", "text": "不運だと思うよ。 私も3つか2つの女性家長イベントに参加しましたが、何も得られませんでした"}]
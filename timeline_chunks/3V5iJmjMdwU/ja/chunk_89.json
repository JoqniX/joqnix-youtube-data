[{"type": "subtitle", "time": 5340.31, "timestamp": "01:29:00", "text": "ああ、彼はそれを取らない。わかった、私が取るよ"}, {"type": "subtitle", "time": 5342.79, "timestamp": "01:29:02", "text": "。"}, {"type": "subtitle", "time": 5344.709, "timestamp": "01:29:04", "text": "しかし、ここには何もありません。"}, {"type": "subtitle", "time": 5347.91, "timestamp": "01:29:07", "text": "彼はどこへ行くのですか？   何てことだ"}, {"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "。"}, {"type": "subtitle", "time": 5361.43, "timestamp": "01:29:21", "text": "それで、ええと、戦略は何ですか? 次はジョックン。   ああ"}, {"type": "subtitle", "time": 5364.39, "timestamp": "01:29:24", "text": "、誰かがすでにこれを略奪しました。"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "最初にここに来たかったのですが、"}, {"type": "subtitle", "time": 5398.07, "timestamp": "01:29:58", "text": "ああ、電球。 はい。   他に"}]
[{"type": "subtitle", "time": 9911.99, "timestamp": "02:45:11", "text": "後で考えます。 ああ、でもそうだ、"}, {"type": "subtitle", "time": 9913.67, "timestamp": "02:45:13", "text": "私は"}, {"type": "subtitle", "time": 9918.55, "timestamp": "02:45:18", "text": "チームのためにいくつか仕事をしたんだ。 えっと、"}, {"type": "subtitle", "time": 9921.349, "timestamp": "02:45:21", "text": "えっと、今後のストリーム情報を更新しました"}, {"type": "subtitle", "time": 9923.51, "timestamp": "02:45:23", "text": "。   えっと、私が"}, {"type": "subtitle", "time": 9926.87, "timestamp": "02:45:26", "text": "彼らに見せてあげましょう。 何だあぁ"}, {"type": "subtitle", "time": 9931.75, "timestamp": "02:45:31", "text": "、そうだ。 昨日はこれをやっていました。   だから"}, {"type": "subtitle", "time": 9935.269, "timestamp": "02:45:35", "text": "彼らはアークをプレイできなかったのです。"}, {"type": "subtitle", "time": 9939.729, "timestamp": "02:45:39", "text": "そうそう。 そして今、それが私に起こったのです。 そうそう。"}, {"type": "subtitle", "time": 9946.23, "timestamp": "02:45:46", "text": "ああそうだね。 それが理由です。 そうそう。"}, {"type": "subtitle", "time": 9948.71, "timestamp": "02:45:48", "text": "そうそう。 そこで、今後のストリームを更新しました"}, {"type": "subtitle", "time": 9951.03, "timestamp": "02:45:51", "text": "。 以前はこの埋め込みのようでした。"}, {"type": "subtitle", "time": 9953.59, "timestamp": "02:45:53", "text": "こんな感じにしてみました。"}, {"type": "subtitle", "time": 9956.389, "timestamp": "02:45:56", "text": "したがって、6 件を超えるストリームが"}, {"type": "subtitle", "time": 9958.63, "timestamp": "02:45:58", "text": "スケジュールされている場合は、互換性リストに表示されます。"}]
[{"type": "subtitle", "time": 8310.709, "timestamp": "02:18:30", "text": "これらはマトラのものじゃないですか？"}, {"type": "subtitle", "time": 8313.429, "timestamp": "02:18:33", "text": "マトリックスまたは"}, {"type": "subtitle", "time": 8316.469, "timestamp": "02:18:36", "text": "ビープ音にしてください。 彼ら全員が略奪品を奪ったんだ。   来て"}, {"type": "subtitle", "time": 8320.309, "timestamp": "02:18:40", "text": "。 私のために少し取っておいてください。"}, {"type": "subtitle", "time": 8322.95, "timestamp": "02:18:42", "text": "ああ、いや。"}]
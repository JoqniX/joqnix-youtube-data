[{"type": "subtitle", "time": 8905.19, "timestamp": "02:28:25", "text": "これでメインのトラックイベントは終了です。"}, {"type": "subtitle", "time": 8908.15, "timestamp": "02:28:28", "text": "酉年行事って何ですか？"}, {"type": "subtitle", "time": 8920.79, "timestamp": "02:28:40", "text": "今日はどこで締めくくりましょうか？ それも"}, {"type": "subtitle", "time": 8925.83, "timestamp": "02:28:45", "text": "短い流れでした。 そうですね"}]
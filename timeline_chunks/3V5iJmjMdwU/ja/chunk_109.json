[{"type": "subtitle", "time": 6542.07, "timestamp": "01:49:02", "text": "また、もし死ぬことになったら、何を持っていけばいいのかも知りたいです。"}, {"type": "subtitle", "time": 6545.189, "timestamp": "01:49:05", "text": "えっと、ローズ"}, {"type": "subtitle", "time": 6567.43, "timestamp": "01:49:27", "text": "ああ、２つあるよ。 小さいのと"}, {"type": "subtitle", "time": 6570.31, "timestamp": "01:49:30", "text": "大きいの。"}]
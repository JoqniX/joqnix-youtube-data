[{"type": "subtitle", "time": 9782.389, "timestamp": "02:43:02", "text": "会計クラスがあると思っていましたが、もちろん、"}, {"type": "subtitle", "time": 9785.349, "timestamp": "02:43:05", "text": "コスト計算など、生き残るためのものであって、生存"}, {"type": "subtitle", "time": 9788.55, "timestamp": "02:43:08", "text": "能力を測るものではありません。つまり、"}, {"type": "subtitle", "time": 9791.59, "timestamp": "02:43:11", "text": "日本に行くと、"}, {"type": "subtitle", "time": 9795.11, "timestamp": "02:43:15", "text": "お金や財務のバランスを取る方法などを学び、"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "簡単に破産しないようにするのです。どこでも、あっという間に"}, {"type": "subtitle", "time": 9807.11, "timestamp": "02:43:27", "text": "お金を失ってしまうのが目に見えています。 わかった。 いいえ、"}, {"type": "subtitle", "time": 9809.51, "timestamp": "02:43:29", "text": "大学を休むことはできません。 私は今大学に行かなければなりません。   取得した単位を"}, {"type": "subtitle", "time": 9817.349, "timestamp": "02:43:37", "text": "新しい大学に移して確認しなければなりません。"}, {"type": "subtitle", "time": 9820.389, "timestamp": "02:43:40", "text": "なので、おそらく日本にあるインド大使館から新しい試験を受けることになるでしょう。"}, {"type": "subtitle", "time": 9827.83, "timestamp": "02:43:47", "text": "特別な許可があればそこから受験できるからです"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "。"}, {"type": "subtitle", "time": 9837.59, "timestamp": "02:43:57", "text": "Arcはプレイしませんでした。 はい、"}]
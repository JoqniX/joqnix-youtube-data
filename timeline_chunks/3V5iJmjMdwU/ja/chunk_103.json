[{"type": "subtitle", "time": 6211.75, "timestamp": "01:43:31", "text": "待って、これは一体何なの？"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "女家長、"}, {"type": "subtitle", "time": 6214.31, "timestamp": "01:43:34", "text": "襲撃者たち、背後に気をつけろ。"}, {"type": "subtitle", "time": 6216.39, "timestamp": "01:43:36", "text": "あなたの近くで女家長が目撃されました。"}, {"type": "subtitle", "time": 6219.51, "timestamp": "01:43:39", "text": "どこへ行くときも"}, {"type": "subtitle", "time": 6223.43, "timestamp": "01:43:43", "text": "常に彼女の子供たちから目を離さないようにしてください。   よし"}]
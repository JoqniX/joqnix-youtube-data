[{"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "ああ、それは夜襲だ。 よし、"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "ショットといえば、"}, {"type": "subtitle", "time": 4958.229, "timestamp": "01:22:38", "text": "時々、特定の"}, {"type": "subtitle", "time": 4962.629, "timestamp": "01:22:42", "text": "トピックや自分自身のことについてビデオを作ることもありますが、"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "なぜ？ それで、"}, {"type": "subtitle", "time": 4978.709, "timestamp": "01:22:58", "text": "どういう意味ですか?"}]
[{"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "酒後駕車的年齡。 [笑聲] 是的。  哇。  哦，"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "我做了什麼？我做了什麼？  那種盾牌。  呃，繃帶"}, {"type": "subtitle", "time": 4958.229, "timestamp": "01:22:38", "text": "我們去進行夜襲吧。  我們盡量不要否認。  哦"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "，他確實這麼做了。  說到拍照，我現在得多拍幾張了。"}]
[{"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "真好。  哦，拜託。  有什麼好"}, {"type": "subtitle", "time": 5361.43, "timestamp": "01:29:21", "text": "東西嗎？  加濕器。"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "我該如何到達這裡？  不，兄弟，兄弟，兄弟，兄弟。  我沒跳成功。"}, {"type": "subtitle", "time": 5398.07, "timestamp": "01:29:58", "text": "哦，不。  哦，他不接受。好吧，我要接受了。  但這裡什麼都沒有。他要去哪裡？  我的"}]
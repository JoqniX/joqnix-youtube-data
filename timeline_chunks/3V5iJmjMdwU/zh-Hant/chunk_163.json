[{"type": "subtitle", "time": 9791.59, "timestamp": "02:43:11", "text": "我等廣告重新出現再說。廣告結束後，我會"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "重複一次。好的，別擔心。  好的，"}, {"type": "subtitle", "time": 9807.11, "timestamp": "02:43:27", "text": "我當時正在嘗試。是的，我讀過。我讀過那篇文章。  好的。我剛才說的是，是的，我要去上金融課，我的意思是，等18號NET"}, {"type": "subtitle", "time": 9820.389, "timestamp": "02:43:40", "text": "考試結束後再去上課。"}]
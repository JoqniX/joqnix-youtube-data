[{"type": "subtitle", "time": 22083.03, "timestamp": "06:08:03", "text": "I mean, cuz like I bought a lot of stuff"}, {"type": "subtitle", "time": 22092.47, "timestamp": "06:08:12", "text": "I remember when Po was testing the new"}, {"type": "subtitle", "time": 22096.948, "timestamp": "06:08:16", "text": "site for that. I I bulk ordered every"}, {"type": "subtitle", "time": 22100.708, "timestamp": "06:08:20", "text": "single thing like x 99 times. Every"}, {"type": "subtitle", "time": 22103.59, "timestamp": "06:08:23", "text": "single item hoping that I'll get it for"}, {"type": "subtitle", "time": 22108.458, "timestamp": "06:08:28", "text": "free. Then that never happened."}, {"type": "subtitle", "time": 22110.47, "timestamp": "06:08:30", "text": "[laughter]"}, {"type": "subtitle", "time": 22113.59, "timestamp": "06:08:33", "text": "Oh my god. Like the confirmation email"}, {"type": "subtitle", "time": 22115.67, "timestamp": "06:08:35", "text": "came like you have to pay like this much"}, {"type": "subtitle", "time": 22118.708, "timestamp": "06:08:38", "text": "of rupees. I'm like oh it wasn't it"}, {"type": "subtitle", "time": 22122.47, "timestamp": "06:08:42", "text": "free. It said zero. There was a bug"}, {"type": "subtitle", "time": 22124.07, "timestamp": "06:08:44", "text": "where it said zero."}, {"type": "subtitle", "time": 22127.454, "timestamp": "06:08:47", "text": ">> But I was about to resell it to"}, {"type": "subtitle", "time": 22128.31, "timestamp": "06:08:48", "text": "[laughter]"}, {"type": "subtitle", "time": 22130.708, "timestamp": "06:08:50", "text": "flip it. Flip it back to them for like"}, {"type": "subtitle", "time": 22132.39, "timestamp": "06:08:52", "text": "profit."}, {"type": "subtitle", "time": 22138.708, "timestamp": "06:08:58", "text": "By the way guys, I'm a 2D animator"}]
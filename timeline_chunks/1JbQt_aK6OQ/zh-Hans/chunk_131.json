[{"type": "subtitle", "time": 7861.83, "timestamp": "02:11:01", "text": "我玩。好的，就是这个。"}, {"type": "subtitle", "time": 7864.47, "timestamp": "02:11:04", "text": "最终幻想。"}, {"type": "subtitle", "time": 7866.31, "timestamp": "02:11:06", "text": "原子卡完成了它。匈牙利之星"}, {"type": "subtitle", "time": 7869.189, "timestamp": "02:11:09", "text": "铁路停运。"}, {"type": "subtitle", "time": 7871.189, "timestamp": "02:11:11", "text": "他们找到了。他们发现它已经完成了。"}, {"type": "subtitle", "time": 7873.669, "timestamp": "02:11:13", "text": "结束了。它们就像已经完成了一样。高尔夫球"}, {"type": "subtitle", "time": 7877.35, "timestamp": "02:11:17", "text": "它发布。霍格沃茨之遗。我完成了。"}, {"type": "subtitle", "time": 7878.87, "timestamp": "02:11:18", "text": "完全的。"}, {"type": "subtitle", "time": 7881.109, "timestamp": "02:11:21", "text": "好的。我们还有很多比赛要打。"}, {"type": "subtitle", "time": 7882.709, "timestamp": "02:11:22", "text": "添加。"}, {"type": "subtitle", "time": 7895.91, "timestamp": "02:11:35", "text": "2021年。"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "然后粘贴到这里。而且这很好"}]
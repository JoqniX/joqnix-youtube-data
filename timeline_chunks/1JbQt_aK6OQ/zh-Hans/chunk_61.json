[{"type": "subtitle", "time": 3674.63, "timestamp": "01:01:14", "text": "这款游戏又一次面世了。"}, {"type": "subtitle", "time": 3677.27, "timestamp": "01:01:17", "text": "2024"}, {"type": "subtitle", "time": 3680.63, "timestamp": "01:01:20", "text": "24岁那年我就不玩了。我不能"}, {"type": "subtitle", "time": 3694.87, "timestamp": "01:01:34", "text": "我打算在2024年玩这款游戏。我的电脑坏了。"}, {"type": "subtitle", "time": 3697.43, "timestamp": "01:01:37", "text": "当天"}, {"type": "subtitle", "time": 3699.109, "timestamp": "01:01:39", "text": "和"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "我把它放在这里。"}, {"type": "subtitle", "time": 3708.069, "timestamp": "01:01:48", "text": "我不确定我是否应该这样做，嗯……"}, {"type": "subtitle", "time": 3711.589, "timestamp": "01:01:51", "text": "不太确定是否应该给个评分。"}, {"type": "subtitle", "time": 3714.549, "timestamp": "01:01:54", "text": "系统。这就像我在给动漫打分一样。"}, {"type": "subtitle", "time": 3718.069, "timestamp": "01:01:58", "text": "东西。我不知道"}]
[{"type": "subtitle", "time": 8345.91, "timestamp": "02:19:05", "text": "《使命召唤》在哪里？好的，明白了。"}, {"type": "subtitle", "time": 8349.589, "timestamp": "02:19:09", "text": "呃，把它放在那儿。感觉不错。好的"}, {"type": "subtitle", "time": 8357.19, "timestamp": "02:19:17", "text": "然后关闭它。我们会放《消逝的光芒》。"}, {"type": "subtitle", "time": 8360.505, "timestamp": "02:19:20", "text": "好的。我们会放《消逝的光芒》。我"}, {"type": "subtitle", "time": 8361.669, "timestamp": "02:19:21", "text": "[清嗓子] 看完《消逝的光芒》"}, {"type": "subtitle", "time": 8363.27, "timestamp": "02:19:23", "text": "实际上。"}, {"type": "subtitle", "time": 8372.15, "timestamp": "02:19:32", "text": "以及 2015 年 20 日。"}, {"type": "subtitle", "time": 8376.629, "timestamp": "02:19:36", "text": "完成了。下载这个。"}, {"type": "subtitle", "time": 8384.23, "timestamp": "02:19:44", "text": "我在2023年玩过它。"}, {"type": "subtitle", "time": 8387.27, "timestamp": "02:19:47", "text": "已全部完成。精彩的比赛。"}, {"type": "subtitle", "time": 8390.07, "timestamp": "02:19:50", "text": "非常喜欢"}, {"type": "subtitle", "time": 8393.19, "timestamp": "02:19:53", "text": "我制作的系列作品。"}, {"type": "subtitle", "time": 8396.07, "timestamp": "02:19:56", "text": "两年前。"}, {"type": "subtitle", "time": 8399.349, "timestamp": "02:19:59", "text": "是的，我们四月份"}]
[{"type": "subtitle", "time": 362.87, "timestamp": "00:06:02", "text": "我真正感到难过的事情"}, {"type": "subtitle", "time": 365.99, "timestamp": "00:06:05", "text": "我对银行的UPI支付方式不满意。"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "原来还有一种东西叫BI，是吗？"}, {"type": "subtitle", "time": 373.029, "timestamp": "00:06:13", "text": "点或在 Jock 前面，在 jox 后面"}, {"type": "subtitle", "time": 376.469, "timestamp": "00:06:16", "text": "有一些数字，729，那就是我"}, {"type": "subtitle", "time": 378.95, "timestamp": "00:06:18", "text": "追赶[喘息]"}, {"type": "subtitle", "time": 382.469, "timestamp": "00:06:22", "text": "重新生成它 关闭应用程序 打开它"}, {"type": "subtitle", "time": 384.79, "timestamp": "00:06:24", "text": "再次关闭应用程序，就像这样"}, {"type": "subtitle", "time": 388.87, "timestamp": "00:06:28", "text": "这就是我向上帝祈祷的，[笑声]"}, {"type": "subtitle", "time": 392.87, "timestamp": "00:06:32", "text": "真是太奇怪了。但我感觉自己就像……"}, {"type": "subtitle", "time": 395.99, "timestamp": "00:06:35", "text": "至少我得到了它，我仍然感到高兴。"}, {"type": "subtitle", "time": 398.95, "timestamp": "00:06:38", "text": "工作，对吧？它没有显示我的名字"}, {"type": "subtitle", "time": 400.71, "timestamp": "00:06:40", "text": "不再是了。"}, {"type": "subtitle", "time": 402.39, "timestamp": "00:06:42", "text": "是的，"}, {"type": "subtitle", "time": 405.51, "timestamp": "00:06:45", "text": "它不需要呃，显示我的名字"}, {"type": "subtitle", "time": 407.909, "timestamp": "00:06:47", "text": "不再是了。我对此感到非常高兴。"}, {"type": "subtitle", "time": 409.909, "timestamp": "00:06:49", "text": "那。"}, {"type": "subtitle", "time": 414.39, "timestamp": "00:06:54", "text": "我真的真的呃"}, {"type": "subtitle", "time": 417.229, "timestamp": "00:06:57", "text": "嗯，很高兴。"}, {"type": "subtitle", "time": 419.11, "timestamp": "00:06:59", "text": "[嗤笑]"}]
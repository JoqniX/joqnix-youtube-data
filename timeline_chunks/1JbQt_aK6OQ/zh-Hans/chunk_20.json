[{"type": "subtitle", "time": 1200.63, "timestamp": "00:20:00", "text": "我会。好吧，行。"}, {"type": "subtitle", "time": 1203.19, "timestamp": "00:20:03", "text": "等等，如果我扫描这个呢？我会吗？"}, {"type": "subtitle", "time": 1205.35, "timestamp": "00:20:05", "text": "真的得到了什么吗？"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "让我来……让我拿一下手机。"}, {"type": "subtitle", "time": 1221.51, "timestamp": "00:20:21", "text": "它真的有效。拉屎。实际上"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "付款。哦，我给自己发了一份"}, {"type": "subtitle", "time": 1235.909, "timestamp": "00:20:35", "text": "卢比。 [笑声]"}, {"type": "subtitle", "time": 1254.39, "timestamp": "00:20:54", "text": "如果真是那样的话？我想放"}, {"type": "subtitle", "time": 1256.39, "timestamp": "00:20:56", "text": "某物[哼声]"}]
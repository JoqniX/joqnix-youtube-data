[{"type": "subtitle", "time": 1442.71, "timestamp": "00:24:02", "text": "当前卡片已打开"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "5,000。幸好，是5000或"}, {"type": "subtitle", "time": 1449.029, "timestamp": "00:24:09", "text": "10,000。所以，我得花5000块钱才能开门营业。"}, {"type": "subtitle", "time": 1451.269, "timestamp": "00:24:11", "text": "当前账户。几天后，"}, {"type": "subtitle", "time": 1455.35, "timestamp": "00:24:15", "text": "账户已激活。所以，呃"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "联邦银行，有一款应用程序"}, {"type": "subtitle", "time": 1459.83, "timestamp": "00:24:19", "text": "企业，美联储公司。在美联储公司"}, {"type": "subtitle", "time": 1462.39, "timestamp": "00:24:22", "text": "我更换应用程序后遇到了一些问题。"}, {"type": "subtitle", "time": 1469.59, "timestamp": "00:24:29", "text": "[笑声]"}, {"type": "subtitle", "time": 1473.11, "timestamp": "00:24:33", "text": "所以，嗯，是的。所以，我改变了"}, {"type": "subtitle", "time": 1476.789, "timestamp": "00:24:36", "text": "数字。所以，因为我改了，呃，Fedco"}, {"type": "subtitle", "time": 1478.87, "timestamp": "00:24:38", "text": "应用程序无法识别找零号码。"}, {"type": "subtitle", "time": 1480.95, "timestamp": "00:24:40", "text": "它只对我第一个输入的数字有效。"}, {"type": "subtitle", "time": 1483.75, "timestamp": "00:24:43", "text": "已注册，呃，报名参加了本次活动"}, {"type": "subtitle", "time": 1487.43, "timestamp": "00:24:47", "text": "帐户。所以，"}, {"type": "subtitle", "time": 1490.149, "timestamp": "00:24:50", "text": "等等，谁添加了我的设备？谁是"}, {"type": "subtitle", "time": 1492.87, "timestamp": "00:24:52", "text": "梅尔文？这是谁？这人是谁？等等，我……"}, {"type": "subtitle", "time": 1496.23, "timestamp": "00:24:56", "text": "有人试图连接到我的电脑吗？"}, {"type": "subtitle", "time": 1498.63, "timestamp": "00:24:58", "text": "谁是我的？等等，旅舍的人"}]
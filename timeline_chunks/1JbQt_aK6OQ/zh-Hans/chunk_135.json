[{"type": "subtitle", "time": 8105.669, "timestamp": "02:15:05", "text": "啊，真可怕。我的天哪。吞噬是"}, {"type": "subtitle", "time": 8107.75, "timestamp": "02:15:07", "text": "可怕的。"}, {"type": "subtitle", "time": 8110.47, "timestamp": "02:15:10", "text": "吞噬。"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "希拉扎德也完成了。我最初"}, {"type": "subtitle", "time": 8125.91, "timestamp": "02:15:25", "text": "玩过了。是的。"}, {"type": "subtitle", "time": 8128.629, "timestamp": "02:15:28", "text": "接下来是《使命召唤：现代战争》。"}, {"type": "subtitle", "time": 8137.75, "timestamp": "02:15:37", "text": "等等，我应该直接做个标签页分组吗？"}, {"type": "subtitle", "time": 8153.83, "timestamp": "02:15:53", "text": "我该如何在这里进行标签分组呢？"}]
[{"type": "subtitle", "time": 7442.07, "timestamp": "02:04:02", "text": "我说我真的很想玩"}, {"type": "subtitle", "time": 7445.669, "timestamp": "02:04:05", "text": "比如像Suika那样的游戏，但我买不起。"}, {"type": "subtitle", "time": 7448.709, "timestamp": "02:04:08", "text": "例如任天堂Switch。我当时非常难过。"}, {"type": "subtitle", "time": 7450.47, "timestamp": "02:04:10", "text": "天。"}, {"type": "subtitle", "time": 7452.55, "timestamp": "02:04:12", "text": "我当时正在直播，然后有人"}, {"type": "subtitle", "time": 7454.87, "timestamp": "02:04:14", "text": "实际上，我当时正在观察我，而我显然是"}, {"type": "subtitle", "time": 7458.709, "timestamp": "02:04:18", "text": "碰巧其中一位是开发人员，他们"}, {"type": "subtitle", "time": 7461.189, "timestamp": "02:04:21", "text": "给我发了一封电子邮件到我的商务邮箱。"}, {"type": "subtitle", "time": 7464.229, "timestamp": "02:04:24", "text": "邮件和类似内容告诉我查看一下"}, {"type": "subtitle", "time": 7467.076, "timestamp": "02:04:27", "text": "我玩了这个游戏，并且试玩了一下。我很喜欢。"}, {"type": "subtitle", "time": 7467.669, "timestamp": "02:04:27", "text": "[笑声]"}, {"type": "subtitle", "time": 7477.35, "timestamp": "02:04:37", "text": "呃，猴子便盆。"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "哦，他们在这里有条目。"}, {"type": "subtitle", "time": 7483.99, "timestamp": "02:04:43", "text": "这款游戏发布了。我会保存这张图片。"}, {"type": "subtitle", "time": 7485.589, "timestamp": "02:04:45", "text": "作为"}]
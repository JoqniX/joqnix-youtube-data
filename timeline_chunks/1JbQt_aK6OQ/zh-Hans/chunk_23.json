[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "注意到 Tarscape 和一些印度人"}, {"type": "subtitle", "time": 1383.19, "timestamp": "00:23:03", "text": "创造者"}, {"type": "subtitle", "time": 1386.149, "timestamp": "00:23:06", "text": "使用ICIC银行。"}, {"type": "subtitle", "time": 1389.35, "timestamp": "00:23:09", "text": "好像有关于零零的传闻"}, {"type": "subtitle", "time": 1391.909, "timestamp": "00:23:11", "text": "账户或零费用账户等等。但是我的"}, {"type": "subtitle", "time": 1396.07, "timestamp": "00:23:16", "text": "爸爸说他也注册了一个账号，内容是："}, {"type": "subtitle", "time": 1398.549, "timestamp": "00:23:18", "text": "因为他们说是零，呃，零"}, {"type": "subtitle", "time": 1401.75, "timestamp": "00:23:21", "text": "跨性别呃零之类的东西。呃"}, {"type": "subtitle", "time": 1404.31, "timestamp": "00:23:24", "text": "但问题是，过了一段时间后……"}, {"type": "subtitle", "time": 1406.789, "timestamp": "00:23:26", "text": "他们会从你这里拿走很多钱。"}, {"type": "subtitle", "time": 1408.549, "timestamp": "00:23:28", "text": "或者别的什么"}, {"type": "subtitle", "time": 1412.07, "timestamp": "00:23:32", "text": "呃，如果你呃，如果你没有遇到……"}, {"type": "subtitle", "time": 1413.669, "timestamp": "00:23:33", "text": "你处于某种平衡状态或其他什么状态"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "随便什么都行，诸如此类。所以他"}, {"type": "subtitle", "time": 1418.39, "timestamp": "00:23:38", "text": "认为与联邦政府无关，不是"}, {"type": "subtitle", "time": 1422.47, "timestamp": "00:23:42", "text": "虽然跟IC有关，但我说我还是会去。"}, {"type": "subtitle", "time": 1424.549, "timestamp": "00:23:44", "text": "周五的时候再检查一下所有情况。但"}, {"type": "subtitle", "time": 1426.71, "timestamp": "00:23:46", "text": "是的，所以我做的就是创建了一个电流"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "注册账号后，我成为了"}, {"type": "subtitle", "time": 1435.669, "timestamp": "00:23:55", "text": "现在全部归原作者所有。所以我做了一个"}, {"type": "subtitle", "time": 1437.27, "timestamp": "00:23:57", "text": "呃"}]
[{"type": "subtitle", "time": 14100.07, "timestamp": "03:55:00", "text": "是的。我的脚碰到了电缆，"}, {"type": "chat", "time": 14103.934, "timestamp": "03:55:03", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "your feet?"}, {"type": "subtitle", "time": 14112.79, "timestamp": "03:55:12", "text": "呃，我的电脑放在桌子底下。不。"}, {"type": "subtitle", "time": 14116.79, "timestamp": "03:55:16", "text": "呃，所以这就是为什么我的所有线路布置都是这样的。"}, {"type": "subtitle", "time": 14120.07, "timestamp": "03:55:20", "text": "在我的桌子底下。所以我保留了那台电脑。"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "向下。所以，我不小心……"}, {"type": "subtitle", "time": 14126.309, "timestamp": "03:55:26", "text": "我伸展双腿，触碰到了力量"}, {"type": "subtitle", "time": 14129.189, "timestamp": "03:55:29", "text": "电缆突然断电了。"}, {"type": "subtitle", "time": 14132.229, "timestamp": "03:55:32", "text": "整台电脑。我必须像重新连接一样"}, {"type": "subtitle", "time": 14135.03, "timestamp": "03:55:35", "text": "轻轻摇晃一下，让它带电。"}, {"type": "subtitle", "time": 14139.269, "timestamp": "03:55:39", "text": "就像打开它那样。"}, {"type": "subtitle", "time": 14141.91, "timestamp": "03:55:41", "text": "事情就是这样发生的。"}, {"type": "subtitle", "time": 14144.55, "timestamp": "03:55:44", "text": "现在是晚上11点。我来完成这件事。"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "然后去睡觉。好的。真的太晚了。"}, {"type": "subtitle", "time": 14151.269, "timestamp": "03:55:51", "text": "我还没好。我应该拿一个"}, {"type": "subtitle", "time": 14153.67, "timestamp": "03:55:53", "text": "休息。"}]
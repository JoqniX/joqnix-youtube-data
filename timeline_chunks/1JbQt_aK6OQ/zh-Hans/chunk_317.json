[{"type": "subtitle", "time": 19025.99, "timestamp": "05:17:05", "text": "嗯"}, {"type": "chat", "time": 19030.124, "timestamp": "05:17:10", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "not just content creation but its uses in all other stuff"}, {"type": "subtitle", "time": 19032.15, "timestamp": "05:17:12", "text": "就像你明明负担得起却不会那样。"}, {"type": "subtitle", "time": 19033.91, "timestamp": "05:17:13", "text": "买得起"}, {"type": "subtitle", "time": 19037.91, "timestamp": "05:17:17", "text": "呃，比如付钱请人画画之类的。"}, {"type": "chat", "time": 19039.223, "timestamp": "05:17:19", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "like medical and operation"}, {"type": "subtitle", "time": 19041.43, "timestamp": "05:17:21", "text": "以及所有你可以用的东西，嗯，你可以"}, {"type": "subtitle", "time": 19044.15, "timestamp": "05:17:24", "text": "委托一位合适的艺术家，然后……"}, {"type": "chat", "time": 19045.664, "timestamp": "05:17:25", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "space machine"}, {"type": "subtitle", "time": 19046.55, "timestamp": "05:17:26", "text": "它而不是人工智能之类的东西。没关系。"}, {"type": "subtitle", "time": 19049.91, "timestamp": "05:17:29", "text": "从某种意义上说，这有点像盗版，对吧？我们所有人"}, {"type": "subtitle", "time": 19052.07, "timestamp": "05:17:32", "text": "优先处理比赛，因为我们做不到"}, {"type": "subtitle", "time": 19055.27, "timestamp": "05:17:35", "text": "买得起。但随着时间的推移，当我们"}, {"type": "subtitle", "time": 19058.628, "timestamp": "05:17:38", "text": "我们买得起那款游戏，就买了。"}, {"type": "subtitle", "time": 19060.708, "timestamp": "05:17:40", "text": "购买游戏，支持开发者。"}, {"type": "subtitle", "time": 19063.67, "timestamp": "05:17:43", "text": "不，同样的事情仍然可以做到这一点。那是"}, {"type": "subtitle", "time": 19066.628, "timestamp": "05:17:46", "text": "为了人工智能艺术等等，对吧？其他"}, {"type": "subtitle", "time": 19069.43, "timestamp": "05:17:49", "text": "人工智能在很多领域都发挥着重要作用"}, {"type": "subtitle", "time": 19072.15, "timestamp": "05:17:52", "text": "科技进步，对吧？"}, {"type": "subtitle", "time": 19073.67, "timestamp": "05:17:53", "text": "医疗手术。是的。是的。"}, {"type": "subtitle", "time": 19075.91, "timestamp": "05:17:55", "text": "一切。不管你说什么。是的。"}]
[{"type": "subtitle", "time": 5825.109, "timestamp": "01:37:05", "text": "好的。我当时在做什么？ [笑声]我的"}, {"type": "subtitle", "time": 5828.229, "timestamp": "01:37:08", "text": "东西坏了。我不知道为什么。和"}, {"type": "subtitle", "time": 5832.31, "timestamp": "01:37:12", "text": "我的东西不再是东西了。"}, {"type": "subtitle", "time": 5835.03, "timestamp": "01:37:15", "text": "让我"}, {"type": "subtitle", "time": 5839.03, "timestamp": "01:37:19", "text": "我大概能猜到发生了什么。"}, {"type": "subtitle", "time": 5848.47, "timestamp": "01:37:28", "text": "[咳嗽]"}, {"type": "subtitle", "time": 5858.07, "timestamp": "01:37:38", "text": "兄弟，你不能，我甚至都无法互动。"}, {"type": "subtitle", "time": 5861.91, "timestamp": "01:37:41", "text": "就这样。这东西到底坏到什么程度了？"}, {"type": "subtitle", "time": 5872.629, "timestamp": "01:37:52", "text": "为什么我无法互动？为什么我不能？"}]
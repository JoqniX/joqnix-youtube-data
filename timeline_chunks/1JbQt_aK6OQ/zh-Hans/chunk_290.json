[{"type": "subtitle", "time": 17413.83, "timestamp": "04:50:13", "text": "好的，下一个是《Rumble Wish》。"}, {"type": "subtitle", "time": 17416.628, "timestamp": "04:50:16", "text": "这款游戏已经凉了，他们停止了。"}, {"type": "subtitle", "time": 17419.19, "timestamp": "04:50:19", "text": "这款游戏的开发。他们拿走了它"}, {"type": "subtitle", "time": 17420.948, "timestamp": "04:50:20", "text": "向下。"}, {"type": "subtitle", "time": 17424.07, "timestamp": "04:50:24", "text": "真令人难过。我很高兴我至少拥有过一个。"}, {"type": "subtitle", "time": 17425.75, "timestamp": "04:50:25", "text": "这条信息流。我们结束了游戏。"}, {"type": "subtitle", "time": 17428.788, "timestamp": "04:50:28", "text": "也。那是一款大逃杀游戏。真的"}, {"type": "subtitle", "time": 17430.948, "timestamp": "04:50:30", "text": "游戏挺好玩的。"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "但它死了真是太可惜了。 [音乐]"}, {"type": "subtitle", "time": 17437.27, "timestamp": "04:50:37", "text": "它有第二季。"}, {"type": "subtitle", "time": 17440.788, "timestamp": "04:50:40", "text": "仅此而已。"}]
[{"type": "subtitle", "time": 15660.309, "timestamp": "04:21:00", "text": "遥远的未来。"}, {"type": "subtitle", "time": 15673.99, "timestamp": "04:21:13", "text": "在睡眠中"}, {"type": "subtitle", "time": 15683.83, "timestamp": "04:21:23", "text": "我们读完了《火焰之间》"}, {"type": "subtitle", "time": 15685.99, "timestamp": "04:21:25", "text": "后退。"}, {"type": "subtitle", "time": 15688.95, "timestamp": "04:21:28", "text": "吉祥物。尚未决定。它不是"}, {"type": "subtitle", "time": 15692.309, "timestamp": "04:21:32", "text": "决定了。不，我们从未证实过。我们"}, {"type": "chat", "time": 15692.486, "timestamp": "04:21:32", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "so what your mascot? stars?"}, {"type": "subtitle", "time": 15694.55, "timestamp": "04:21:34", "text": "从来没有呃"}, {"type": "subtitle", "time": 15698.469, "timestamp": "04:21:38", "text": "我们还没有正式最终确定下来。"}, {"type": "subtitle", "time": 15700.63, "timestamp": "04:21:40", "text": "曾经。"}, {"type": "subtitle", "time": 15703.429, "timestamp": "04:21:43", "text": "所以，从某种意义上说，我没有吉祥物。"}, {"type": "subtitle", "time": 15705.83, "timestamp": "04:21:45", "text": "角色尚未成型。"}, {"type": "subtitle", "time": 15709.59, "timestamp": "04:21:49", "text": "就像我说的，嗯，呃，我仍然"}, {"type": "subtitle", "time": 15713.189, "timestamp": "04:21:53", "text": "我正在思考我想要什么样的吉祥物。"}, {"type": "subtitle", "time": 15715.349, "timestamp": "04:21:55", "text": "特点。"}, {"type": "subtitle", "time": 15719.67, "timestamp": "04:21:59", "text": "我想到了一些诸如天体之类的想法。"}]
[{"type": "subtitle", "time": 6365.51, "timestamp": "01:46:05", "text": "好吧，我会在2024年死去，而我玩过这个游戏。"}, {"type": "subtitle", "time": 6367.669, "timestamp": "01:46:07", "text": "204."}, {"type": "subtitle", "time": 6369.669, "timestamp": "01:46:09", "text": "如果我点击这里，就会跳转到……"}, {"type": "subtitle", "time": 6373.109, "timestamp": "01:46:13", "text": "地狱潜水员去那玩意儿。好的。"}, {"type": "subtitle", "time": 6375.109, "timestamp": "01:46:15", "text": "我们受够了地狱潜水员。现在"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "已添加内容警告。"}, {"type": "subtitle", "time": 6382.149, "timestamp": "01:46:22", "text": "入伍是接下来的下一步。"}, {"type": "subtitle", "time": 6387.27, "timestamp": "01:46:27", "text": "我"}, {"type": "subtitle", "time": 6390.629, "timestamp": "01:46:30", "text": "时不时地玩它"}, {"type": "subtitle", "time": 6394.229, "timestamp": "01:46:34", "text": "如果是和里克一起的话。所以我会这样写："}, {"type": "subtitle", "time": 6402.47, "timestamp": "01:46:42", "text": "我会把入伍的那张图和照片都加上。"}, {"type": "subtitle", "time": 6406.629, "timestamp": "01:46:46", "text": "我太需要帮助了"}, {"type": "subtitle", "time": 6409.51, "timestamp": "01:46:49", "text": "死的。我已经添加了图片。我什么时候"}, {"type": "subtitle", "time": 6413.83, "timestamp": "01:46:53", "text": "第一股 H 入伍"}, {"type": "subtitle", "time": 6417.669, "timestamp": "01:46:57", "text": "2024年？我在2024年玩了很多游戏。"}]
[{"type": "subtitle", "time": 17161.51, "timestamp": "04:46:01", "text": "不，"}, {"type": "subtitle", "time": 17163.75, "timestamp": "04:46:03", "text": "我把一切都处理好了。使命召唤战争"}, {"type": "subtitle", "time": 17167.19, "timestamp": "04:46:07", "text": "区。我想检查一下一件事。"}, {"type": "subtitle", "time": 17169.99, "timestamp": "04:46:09", "text": "我应该把“战区一”还是“战区”"}, {"type": "subtitle", "time": 17172.23, "timestamp": "04:46:12", "text": "2022年？"}, {"type": "subtitle", "time": 17177.35, "timestamp": "04:46:17", "text": "把2022年改成战区不是更好吗？"}, {"type": "subtitle", "time": 17181.83, "timestamp": "04:46:21", "text": "呃，我把它写成2022年战区，因为"}, {"type": "subtitle", "time": 17184.39, "timestamp": "04:46:24", "text": "是的，我会把2022年战争区也写进去。呃，我"}, {"type": "subtitle", "time": 17204.31, "timestamp": "04:46:44", "text": "和"}, {"type": "subtitle", "time": 17206.31, "timestamp": "04:46:46", "text": "战区。"}, {"type": "subtitle", "time": 17212.07, "timestamp": "04:46:52", "text": "好了，我们快完成了。只剩下几个了"}, {"type": "subtitle", "time": 17214.31, "timestamp": "04:46:54", "text": "终极击杀。我们结束了这场比赛，但是"}, {"type": "subtitle", "time": 17218.55, "timestamp": "04:46:58", "text": "是不是出了个新的DLC？"}]
[{"type": "subtitle", "time": 17521.35, "timestamp": "04:52:01", "text": "游戏，但仍然有很多。"}, {"type": "subtitle", "time": 17524.23, "timestamp": "04:52:04", "text": "令人毛骨悚然的怪异时刻。我不知道该怎么做"}, {"type": "subtitle", "time": 17528.788, "timestamp": "04:52:08", "text": "谈谈这件事。太可怕了。"}, {"type": "subtitle", "time": 17537.27, "timestamp": "04:52:17", "text": "我很惊讶我居然还没被封号。"}, {"type": "subtitle", "time": 17540.708, "timestamp": "04:52:20", "text": "因为有很多粗俗的言语"}, {"type": "subtitle", "time": 17543.59, "timestamp": "04:52:23", "text": "就像游戏中的人一样被利用了"}, {"type": "subtitle", "time": 17546.39, "timestamp": "04:52:26", "text": "那个服务器简直太糟糕了。他们说"}, {"type": "subtitle", "time": 17551.11, "timestamp": "04:52:31", "text": "很多脏话。所以，在这一边就像"}, {"type": "subtitle", "time": 17553.91, "timestamp": "04:52:33", "text": "在右侧你可以看到它"}, {"type": "subtitle", "time": 17557.75, "timestamp": "04:52:37", "text": "聊天。从某种意义上说，如果这一点被明显地表现出来的话。"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "直播中，这都是我的错，对吧？"}, {"type": "subtitle", "time": 17565.43, "timestamp": "04:52:45", "text": "但如果换成别人这么说，我就不会这么说了。"}, {"type": "subtitle", "time": 17567.83, "timestamp": "04:52:47", "text": "直播之后，它就成了我的"}, {"type": "subtitle", "time": 17570.47, "timestamp": "04:52:50", "text": "是错的，对吧？我的频道将被接管"}, {"type": "subtitle", "time": 17575.75, "timestamp": "04:52:55", "text": "往下掉或者别的什么，对吧？但我认为我"}, {"type": "subtitle", "time": 17578.15, "timestamp": "04:52:58", "text": "我记得我切掉了一些"}]
[{"type": "subtitle", "time": 10206.79, "timestamp": "02:50:06", "text": "我展示我的最好方式是什么"}, {"type": "subtitle", "time": 10211.19, "timestamp": "02:50:11", "text": "呃，伙计，伙计，伙计？我会扫描我自己的。"}, {"type": "subtitle", "time": 10240.95, "timestamp": "02:50:40", "text": "它不显示。"}, {"type": "subtitle", "time": 10248.892, "timestamp": "02:50:48", "text": "没有显示出来。"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "[清嗓子]"}, {"type": "subtitle", "time": 10252.55, "timestamp": "02:50:52", "text": "我的天啊。它不显示工资。哦"}, {"type": "subtitle", "time": 10255.19, "timestamp": "02:50:55", "text": "天哪，我恨你。"}]
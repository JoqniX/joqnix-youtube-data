[{"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "希望我的电脑能运行。但我会的"}, {"type": "subtitle", "time": 485.43, "timestamp": "00:08:05", "text": "想玩《战地》系列游戏。 [笑声]"}, {"type": "subtitle", "time": 488.309, "timestamp": "00:08:08", "text": "我喜欢SH游戏。每当他们发布"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "新的，这是我尝试的传统。"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "我尽我所能加入其中，融入其中。"}, {"type": "subtitle", "time": 497.35, "timestamp": "00:08:17", "text": "就像我尝试去玩一样。"}, {"type": "subtitle", "time": 505.749, "timestamp": "00:08:25", "text": "是的，我们会这么做。让"}, {"type": "subtitle", "time": 507.909, "timestamp": "00:08:27", "text": "让我再三检查，确保我的"}, {"type": "subtitle", "time": 511.589, "timestamp": "00:08:31", "text": "标题和一切都变了。"}, {"type": "subtitle", "time": 514.07, "timestamp": "00:08:34", "text": "呃，就是这个东西。你们想让我……"}, {"type": "subtitle", "time": 516.87, "timestamp": "00:08:36", "text": "请发送UPI ID？我没有。我总是"}, {"type": "subtitle", "time": 519.909, "timestamp": "00:08:39", "text": "它说要把菜品代码发过来，但是"}, {"type": "subtitle", "time": 524.71, "timestamp": "00:08:44", "text": "你知道，嗯……让我……我还没做完"}, {"type": "subtitle", "time": 530.47, "timestamp": "00:08:50", "text": "我连二维码都还没做好呢。"}, {"type": "subtitle", "time": 531.43, "timestamp": "00:08:51", "text": "QR [嗤笑]"}, {"type": "subtitle", "time": 533.03, "timestamp": "00:08:53", "text": "代码"}, {"type": "subtitle", "time": 535.269, "timestamp": "00:08:55", "text": "发电机。"}]
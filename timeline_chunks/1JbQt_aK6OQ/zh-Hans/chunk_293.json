[{"type": "subtitle", "time": 17580.23, "timestamp": "04:53:00", "text": "那条溪流上的斑点。所以，没问题。"}, {"type": "subtitle", "time": 17583.27, "timestamp": "04:53:03", "text": "我们很安全。"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "有一天我收到了一件衬衫。"}, {"type": "subtitle", "time": 17599.11, "timestamp": "04:53:19", "text": "我相信是这个。"}, {"type": "subtitle", "time": 17601.19, "timestamp": "04:53:21", "text": "不是这个。"}, {"type": "subtitle", "time": 17615.35, "timestamp": "04:53:35", "text": "是这台吗？"}, {"type": "subtitle", "time": 17617.51, "timestamp": "04:53:37", "text": "啊，是的。是的。就是这个。是的。是的。"}, {"type": "subtitle", "time": 17620.31, "timestamp": "04:53:40", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 17623.19, "timestamp": "04:53:43", "text": "空间站"}]
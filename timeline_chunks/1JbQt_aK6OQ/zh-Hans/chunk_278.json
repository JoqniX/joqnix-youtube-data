[{"type": "subtitle", "time": 16680.789, "timestamp": "04:38:00", "text": "溪流，还有会发出哨声的溪流。呃"}, {"type": "subtitle", "time": 16683.99, "timestamp": "04:38:03", "text": "然后是钢琴学习频道 Dualingo。所以"}, {"type": "subtitle", "time": 16686.31, "timestamp": "04:38:06", "text": "我原本想把所有这些都展示出来……"}, {"type": "subtitle", "time": 16690.709, "timestamp": "04:38:10", "text": "网站也是如此。是的，从某种意义上说。"}, {"type": "subtitle", "time": 16693.99, "timestamp": "04:38:13", "text": "接下来是游戏环节。"}, {"type": "subtitle", "time": 16699.83, "timestamp": "04:38:19", "text": "像这样用指法演奏"}, {"type": "subtitle", "time": 16701.59, "timestamp": "04:38:21", "text": "版本。"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "呃，如果我现在去我的积分页面，会在哪里？"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "我的所有模型和所有内容版权归原作者所有"}, {"type": "subtitle", "time": 16708.47, "timestamp": "04:38:28", "text": "这里。所以我打算这样写。人们"}, {"type": "subtitle", "time": 16712.07, "timestamp": "04:38:32", "text": "可以点击标签页。游戏"}, {"type": "subtitle", "time": 16715.029, "timestamp": "04:38:35", "text": "将会展示游戏相关内容，"}, {"type": "subtitle", "time": 16716.551, "timestamp": "04:38:36", "text": "其他流媒体内容将"}, {"type": "subtitle", "time": 16719.429, "timestamp": "04:38:39", "text": "像这样展示在这里。"}, {"type": "subtitle", "time": 16722.23, "timestamp": "04:38:42", "text": "所以那些不看我直播的人"}, {"type": "subtitle", "time": 16724.629, "timestamp": "04:38:44", "text": "YouTube，如果他们通过 Twitch 观看我的直播的话。"}, {"type": "subtitle", "time": 16726.47, "timestamp": "04:38:46", "text": "踢，他们还可以检查"}, {"type": "subtitle", "time": 16729.029, "timestamp": "04:38:49", "text": "如果他们偶然发现了这个网站的话。"}, {"type": "subtitle", "time": 16730.869, "timestamp": "04:38:50", "text": "他们可以看到我玩过的所有游戏"}, {"type": "subtitle", "time": 16733.83, "timestamp": "04:38:53", "text": "我还有哪些游戏没玩过？等等。"}, {"type": "subtitle", "time": 16736.869, "timestamp": "04:38:56", "text": "是的。然后我就可以时不时地……"}, {"type": "subtitle", "time": 16738.789, "timestamp": "04:38:58", "text": "只要我能，我就可以……"}]
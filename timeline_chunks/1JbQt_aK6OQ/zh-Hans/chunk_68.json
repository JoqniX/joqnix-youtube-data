[{"type": "subtitle", "time": 4083.75, "timestamp": "01:08:03", "text": "到2024年，我的评分将达到这个水平。"}, {"type": "subtitle", "time": 4086.069, "timestamp": "01:08:06", "text": "我第一次玩《凋零》是什么时候？"}, {"type": "subtitle", "time": 4088.63, "timestamp": "01:08:08", "text": "波浪？让我查一下。"}, {"type": "subtitle", "time": 4090.789, "timestamp": "01:08:10", "text": "我从未玩过《凋零之浪》。"}, {"type": "subtitle", "time": 4093.349, "timestamp": "01:08:13", "text": "自从。正确的。"}, {"type": "subtitle", "time": 4097.91, "timestamp": "01:08:17", "text": "我在 2024 年 24 日玩了 Withering Waves。"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "我会给它五星好评。实际上，"}, {"type": "subtitle", "time": 4103.43, "timestamp": "01:08:23", "text": "这是一款好游戏。哦，"}, {"type": "subtitle", "time": 4105.99, "timestamp": "01:08:25", "text": "等待。我不需要给它评分"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "已完成的……呃，未完成的游戏。它是"}, {"type": "subtitle", "time": 4111.99, "timestamp": "01:08:31", "text": "应该是为"}, {"type": "subtitle", "time": 4115.749, "timestamp": "01:08:35", "text": "它应该是为我还没玩过的游戏准备的。"}, {"type": "subtitle", "time": 4119.829, "timestamp": "01:08:39", "text": "我不玩。我做完了，对吧？"}, {"type": "subtitle", "time": 4121.99, "timestamp": "01:08:41", "text": "哦，是的。"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "接下来是"}, {"type": "subtitle", "time": 4128.47, "timestamp": "01:08:48", "text": "真空战士。"}, {"type": "subtitle", "time": 4133.269, "timestamp": "01:08:53", "text": "真空战士一出现就像……"}]
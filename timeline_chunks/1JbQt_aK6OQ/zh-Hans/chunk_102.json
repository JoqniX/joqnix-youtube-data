[{"type": "subtitle", "time": 6141.669, "timestamp": "01:42:21", "text": "为什么它不见了？你好。为什么是L"}, {"type": "subtitle", "time": 6144.55, "timestamp": "01:42:24", "text": "各种各样的？"}, {"type": "subtitle", "time": 6149.35, "timestamp": "01:42:29", "text": "为什么IGT中缺少它？什么？"}, {"type": "subtitle", "time": 6153.43, "timestamp": "01:42:33", "text": "怎么会漏掉这个呢？发生了什么？"}, {"type": "subtitle", "time": 6155.43, "timestamp": "01:42:35", "text": "好了，找到了。我要这张照片。"}, {"type": "subtitle", "time": 6158.31, "timestamp": "01:42:38", "text": "非常感谢。"}, {"type": "subtitle", "time": 6162.301, "timestamp": "01:42:42", "text": "我把“史诗级”放在这里。"}]
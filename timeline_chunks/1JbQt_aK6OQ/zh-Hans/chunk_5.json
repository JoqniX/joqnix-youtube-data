[{"type": "subtitle", "time": 300.23, "timestamp": "00:05:00", "text": "正确的？所以，如果你们愿意的话，如果你们愿意的话"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "给呃，就像"}, {"type": "subtitle", "time": 306.469, "timestamp": "00:05:06", "text": "呃，如果你想支持我之类的，"}, {"type": "subtitle", "time": 309.67, "timestamp": "00:05:09", "text": "正确的？我想，我想确保"}, {"type": "subtitle", "time": 312.71, "timestamp": "00:05:12", "text": "这种事时有发生。呃，没有裁员的地方"}, {"type": "subtitle", "time": 314.87, "timestamp": "00:05:14", "text": "某物。所以我拿到了全额款项。"}, {"type": "subtitle", "time": 317.909, "timestamp": "00:05:17", "text": "你想发送给"}, {"type": "subtitle", "time": 322.15, "timestamp": "00:05:22", "text": "我和所有的一切，对吧？所以就这样"}, {"type": "subtitle", "time": 331.029, "timestamp": "00:05:31", "text": "所以，嗯，这就是我当时在想什么。"}, {"type": "subtitle", "time": 336.55, "timestamp": "00:05:36", "text": "也许我不这样做更好。"}, {"type": "subtitle", "time": 340.87, "timestamp": "00:05:40", "text": "Razor Bon 的东西已经有了。呃，KYC"}, {"type": "subtitle", "time": 343.029, "timestamp": "00:05:43", "text": "问题太多了。所以我就想，"}, {"type": "subtitle", "time": 347.11, "timestamp": "00:05:47", "text": "“好吧，你知道吗？算了。忘了它吧。”"}, {"type": "subtitle", "time": 350.31, "timestamp": "00:05:50", "text": "它。忘了它。”"}, {"type": "subtitle", "time": 351.83, "timestamp": "00:05:51", "text": "呃，"}, {"type": "subtitle", "time": 355.749, "timestamp": "00:05:55", "text": "忘了它。但是，嗯，我还是坚持吧。"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "目前暂时把钱存在银行。你知道唯一"}]
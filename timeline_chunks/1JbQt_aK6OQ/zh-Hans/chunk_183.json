[{"type": "subtitle", "time": 10980.95, "timestamp": "03:03:00", "text": "因为我相信我给她买了一款游戏。"}, {"type": "subtitle", "time": 10983.83, "timestamp": "03:03:03", "text": "后退。所以她就说：“是啊，那是什么？”"}, {"type": "subtitle", "time": 10992.95, "timestamp": "03:03:12", "text": "[咳嗽并清嗓子]"}, {"type": "subtitle", "time": 10994.63, "timestamp": "03:03:14", "text": "每分钟节拍数？"}, {"type": "subtitle", "time": 10996.63, "timestamp": "03:03:16", "text": "星空。"}, {"type": "subtitle", "time": 10999.83, "timestamp": "03:03:19", "text": "我停止玩这个游戏了。谁还记得？"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "星空？我当时做了很多事"}, {"type": "subtitle", "time": 11005.03, "timestamp": "03:03:25", "text": "故障，"}, {"type": "subtitle", "time": 11009.67, "timestamp": "03:03:29", "text": "兄弟。我的天啊。我当时做了很多事。"}, {"type": "subtitle", "time": 11018.63, "timestamp": "03:03:38", "text": "我靠卖矿产赚了数百万美元。"}, {"type": "subtitle", "time": 11022.469, "timestamp": "03:03:42", "text": "还有铜、金之类的东西。呃"}, {"type": "subtitle", "time": 11024.71, "timestamp": "03:03:44", "text": "我的天哪，我至今还记得这件事。哦，我的"}, {"type": "subtitle", "time": 11031.03, "timestamp": "03:03:51", "text": "我们其实取消了。我掉了"}]
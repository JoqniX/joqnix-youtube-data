[{"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "两年前。圣哉上帝。"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "我刚刚停止玩游戏了。"}, {"type": "subtitle", "time": 11966.87, "timestamp": "03:19:26", "text": "我们本来可以拍很多系列剧，"}, {"type": "subtitle", "time": 11974.55, "timestamp": "03:19:34", "text": "整理得真整齐。我们完成了"}, {"type": "subtitle", "time": 11983.59, "timestamp": "03:19:43", "text": "史上最佳游戏。"}, {"type": "subtitle", "time": 11987.269, "timestamp": "03:19:47", "text": "我第一次玩这个游戏就成了霓虹人"}, {"type": "subtitle", "time": 11998.229, "timestamp": "03:19:58", "text": "我想和意大利的狗一起玩耍。"}]
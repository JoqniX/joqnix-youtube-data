[{"type": "subtitle", "time": 9063.11, "timestamp": "02:31:03", "text": "实际上，我已经全部完成了。"}, {"type": "subtitle", "time": 9066.23, "timestamp": "02:31:06", "text": "等等，我真的全部完成了吗？"}, {"type": "subtitle", "time": 9068.469, "timestamp": "02:31:08", "text": "等等，你们还记得如果我有"}, {"type": "subtitle", "time": 9071.349, "timestamp": "02:31:11", "text": "都做完了吗？我没有，对吧？哦，我"}, {"type": "subtitle", "time": 9076.07, "timestamp": "02:31:16", "text": "从未有过。我把它掉地上了。哦，对不起。"}, {"type": "subtitle", "time": 9078.389, "timestamp": "02:31:18", "text": "我们会把奥利收尾的。你想要我吗？"}, {"type": "subtitle", "time": 9081.75, "timestamp": "02:31:21", "text": "总有一天会把奥利（Ollie）的尸体弄掉吗？"}, {"type": "subtitle", "time": 9084.469, "timestamp": "02:31:24", "text": "我当时是在胡闹，对吧？而不是"}, {"type": "subtitle", "time": 9087.59, "timestamp": "02:31:27", "text": "游戏结束。"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "我应该把游戏通关。搞定了。它是"}, {"type": "subtitle", "time": 9098.87, "timestamp": "02:31:38", "text": "蓝色协议。"}, {"type": "subtitle", "time": 9103.349, "timestamp": "02:31:43", "text": "你知道蓝色协议呃呃头巾吗"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "游戏玩到一半就放弃了？但是但是但是但是"}, {"type": "subtitle", "time": 9111.51, "timestamp": "02:31:51", "text": "蓝色协议星共振即将到来。"}, {"type": "subtitle", "time": 9119.67, "timestamp": "02:31:59", "text": "宝贝，它就要来了。它要来了。"}]
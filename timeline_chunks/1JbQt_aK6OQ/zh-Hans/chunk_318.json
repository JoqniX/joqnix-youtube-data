[{"type": "subtitle", "time": 19080.39, "timestamp": "05:18:00", "text": "这很有帮助。喜欢"}, {"type": "subtitle", "time": 19082.55, "timestamp": "05:18:02", "text": "人们会……人们，大多数人都很生气"}, {"type": "subtitle", "time": 19086.708, "timestamp": "05:18:06", "text": "在艺术方面，因为它嗯，我在"}, {"type": "subtitle", "time": 19089.03, "timestamp": "05:18:09", "text": "音乐行业也是如此。大多数人"}, {"type": "subtitle", "time": 19091.51, "timestamp": "05:18:11", "text": "不喜欢人工智能音乐"}, {"type": "subtitle", "time": 19095.11, "timestamp": "05:18:15", "text": "生产者不喜欢人工智能的发展，"}, {"type": "subtitle", "time": 19099.83, "timestamp": "05:18:19", "text": "那东西也是那样。有些人喜欢它"}, {"type": "subtitle", "time": 19102.39, "timestamp": "05:18:22", "text": "对某些人来说，这是好事。"}, {"type": "subtitle", "time": 19104.788, "timestamp": "05:18:24", "text": "不。我不知道。"}, {"type": "subtitle", "time": 19106.948, "timestamp": "05:18:26", "text": "在其他创意领域，现在需要"}, {"type": "subtitle", "time": 19108.708, "timestamp": "05:18:28", "text": "离开工作岗位和所有的一切"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "那里有，但如果你需要的话也可以这样。"}, {"type": "subtitle", "time": 19114.708, "timestamp": "05:18:34", "text": "灵感，你可以做到这一点，你知道人工智能"}, {"type": "subtitle", "time": 19116.788, "timestamp": "05:18:36", "text": "音乐提示等等，你就能得到"}, {"type": "subtitle", "time": 19120.15, "timestamp": "05:18:40", "text": "歌曲创作的灵感来源"}, {"type": "subtitle", "time": 19122.47, "timestamp": "05:18:42", "text": "你使用那份章程并进行操作"}, {"type": "subtitle", "time": 19125.19, "timestamp": "05:18:45", "text": "你可以用它创作属于你自己的歌曲。"}, {"type": "subtitle", "time": 19127.35, "timestamp": "05:18:47", "text": "现在"}, {"type": "subtitle", "time": 19133.75, "timestamp": "05:18:53", "text": "很多事物都有好有坏。"}, {"type": "subtitle", "time": 19135.91, "timestamp": "05:18:55", "text": "不过是关于某件事。那就是"}, {"type": "subtitle", "time": 19139.03, "timestamp": "05:18:59", "text": "事物。我也是这么想的。"}]
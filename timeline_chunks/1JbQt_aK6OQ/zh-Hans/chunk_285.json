[{"type": "subtitle", "time": 17101.67, "timestamp": "04:45:01", "text": "嗯"}, {"type": "subtitle", "time": 17104.15, "timestamp": "04:45:04", "text": "包括运输方面的一切。我"}, {"type": "subtitle", "time": 17106.788, "timestamp": "04:45:06", "text": "我觉得我做不到。但我想要"}, {"type": "subtitle", "time": 17108.708, "timestamp": "04:45:08", "text": "不过要学会它。至少我想卖掉"}, {"type": "subtitle", "time": 17112.628, "timestamp": "04:45:12", "text": "一些本地商品。"}, {"type": "subtitle", "time": 17116.07, "timestamp": "04:45:16", "text": "了解它的运作方式。我会的"}, {"type": "subtitle", "time": 17118.708, "timestamp": "04:45:18", "text": "先买便宜的贴纸吧。像30"}, {"type": "subtitle", "time": 17121.99, "timestamp": "04:45:21", "text": "卢比，40卢比左右。"}, {"type": "subtitle", "time": 17128.868, "timestamp": "04:45:28", "text": "好，我们试试。"}, {"type": "subtitle", "time": 17132.07, "timestamp": "04:45:32", "text": "好的。战争"}, {"type": "subtitle", "time": 17134.39, "timestamp": "04:45:34", "text": "肖恩。我"}, {"type": "subtitle", "time": 17137.59, "timestamp": "04:45:37", "text": "我可以取消吗？我停了下来"}, {"type": "subtitle", "time": 17140.31, "timestamp": "04:45:40", "text": "别再播放那个了。还没下载"}, {"type": "subtitle", "time": 17142.31, "timestamp": "04:45:42", "text": "从那时起。"}, {"type": "subtitle", "time": 17147.75, "timestamp": "04:45:47", "text": "嗯，玩笑毛绒玩具，你知道，有一天，我"}, {"type": "subtitle", "time": 17150.628, "timestamp": "04:45:50", "text": "必须找到制造商，或者"}, {"type": "subtitle", "time": 17159.03, "timestamp": "04:45:59", "text": "学会织毛衣等等。"}]
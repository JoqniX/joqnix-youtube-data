[{"type": "chat", "time": 16502.498, "timestamp": "04:35:02", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "?"}, {"type": "chat", "time": 16504.776, "timestamp": "04:35:04", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "le me see"}, {"type": "subtitle", "time": 16512.07, "timestamp": "04:35:12", "text": "如果我能找到《毁灭战士3》就好了。它在哪儿？"}, {"type": "subtitle", "time": 16515.67, "timestamp": "04:35:15", "text": "厄运。所以，我有，嗯，我有男朋友"}, {"type": "subtitle", "time": 16520.869, "timestamp": "04:35:20", "text": "Doom 3 版本。普通版 Doom 3。有吗？"}, {"type": "subtitle", "time": 16523.029, "timestamp": "04:35:23", "text": "对，我觉得是《毁灭战士3》。没错，就是它。"}, {"type": "subtitle", "time": 16525.67, "timestamp": "04:35:25", "text": "毁灭战士3。"}, {"type": "chat", "time": 16528.36, "timestamp": "04:35:28", "author": "@Azzuverse.vtuber", "avatar": "https://yt4.ggpht.com/A43ri-DnihSUe9VpNGkX-aeSqEs_wGSQApSgewstaYGLVmPV7rVMdh70J-PFmQdWg-h3rgUkPg=s64-c-k-c0x00ffffff-no-rj", "message": "hiee"}, {"type": "subtitle", "time": 16529.99, "timestamp": "04:35:29", "text": "你好 Aisa，欢迎来到"}, {"type": "subtitle", "time": 16533.029, "timestamp": "04:35:33", "text": "后屋内部"}, {"type": "subtitle", "time": 16537.91, "timestamp": "04:35:37", "text": "我们可以"}, {"type": "subtitle", "time": 16540.869, "timestamp": "04:35:40", "text": "我完成了“后屋系列”的创作。"}, {"type": "subtitle", "time": 16544.949, "timestamp": "04:35:44", "text": "我猜我玩完之后又玩了一遍。"}, {"type": "subtitle", "time": 16546.629, "timestamp": "04:35:46", "text": "最初我和Zuchi一起玩。我"}, {"type": "subtitle", "time": 16551.029, "timestamp": "04:35:51", "text": "和吸血鬼维克一起玩的"}, {"type": "subtitle", "time": 16553.269, "timestamp": "04:35:53", "text": "复古吸血鬼。"}, {"type": "subtitle", "time": 16554.869, "timestamp": "04:35:54", "text": "嗯"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "然后，通过你们的网站，哦，我们是"}, {"type": "subtitle", "time": 16559.91, "timestamp": "04:35:59", "text": "我们正在开发一个新页面。"}]
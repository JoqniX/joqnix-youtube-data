[{"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "今天。我安装了该应用程序。我不得不等待"}, {"type": "subtitle", "time": 1565.59, "timestamp": "00:26:05", "text": "让他们给我激活码"}, {"type": "subtitle", "time": 1569.029, "timestamp": "00:26:09", "text": "令牌等等。所以，我已经把应用设置好了。"}, {"type": "subtitle", "time": 1573.909, "timestamp": "00:26:13", "text": "合众国际社。我现在唯一后悔的就是"}, {"type": "subtitle", "time": 1576.549, "timestamp": "00:26:16", "text": "我唯一后悔的是，你"}, {"type": "subtitle", "time": 1579.909, "timestamp": "00:26:19", "text": "现在可以看到，他们把这个商业计划搞定了。"}, {"type": "subtitle", "time": 1584.07, "timestamp": "00:26:24", "text": "Next 前面有个点。我最初想要"}, {"type": "subtitle", "time": 1588.87, "timestamp": "00:26:28", "text": "就像FPL上的jocknicks一样，但"}, {"type": "subtitle", "time": 1593.19, "timestamp": "00:26:33", "text": "但我尝试的时候，他们也给我打了号。"}, {"type": "subtitle", "time": 1595.029, "timestamp": "00:26:35", "text": "他们没有提供设置选项。"}, {"type": "subtitle", "time": 1599.35, "timestamp": "00:26:39", "text": "自定义 UPI ID。所以这也是个b"}, {"type": "subtitle", "time": 1603.669, "timestamp": "00:26:43", "text": "真可惜。普通人用的普通应用"}, {"type": "subtitle", "time": 1607.269, "timestamp": "00:26:47", "text": "那家银行，呃，那个应用程序让你选择"}, {"type": "subtitle", "time": 1611.43, "timestamp": "00:26:51", "text": "你的 UPI ID，但是是企业版的"}, {"type": "subtitle", "time": 1614.31, "timestamp": "00:26:54", "text": "那个美联储合作应用程序不允许您"}, {"type": "subtitle", "time": 1617.669, "timestamp": "00:26:57", "text": "选择。所以最初是8个。"}]
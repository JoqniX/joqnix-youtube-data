[{"type": "subtitle", "time": 8408.389, "timestamp": "02:20:08", "text": "《消逝的光芒》完结了。现在这款游戏是"}, {"type": "subtitle", "time": 8412.15, "timestamp": "02:20:12", "text": "已经消失了"}, {"type": "subtitle", "time": 8414.55, "timestamp": "02:20:14", "text": "是的。十六进制定义。这是一场精彩的比赛"}, {"type": "subtitle", "time": 8417.59, "timestamp": "02:20:17", "text": "但他们及时制止了。我的育碧"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "拔掉了插头"}, {"type": "subtitle", "time": 8431.27, "timestamp": "02:20:31", "text": "嗯，"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "把它放在这里。"}, {"type": "subtitle", "time": 8446.07, "timestamp": "02:20:46", "text": "我在 2023 年玩过它。"}, {"type": "subtitle", "time": 8450.897, "timestamp": "02:20:50", "text": "这是一场精彩的比赛。不错。"}, {"type": "subtitle", "time": 8452.07, "timestamp": "02:20:52", "text": "[咳嗽并清嗓子]"}, {"type": "subtitle", "time": 8458.309, "timestamp": "02:20:58", "text": "下一个是原子卡。我完成了这项任务"}]
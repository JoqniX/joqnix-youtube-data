[{"type": "subtitle", "time": 11913.19, "timestamp": "03:18:33", "text": "沃霍尔说，哦，是的，我从没玩过"}, {"type": "subtitle", "time": 11916.55, "timestamp": "03:18:36", "text": "这。我也付了钱。"}, {"type": "subtitle", "time": 11919.59, "timestamp": "03:18:39", "text": "那很久以前。"}, {"type": "subtitle", "time": 11921.75, "timestamp": "03:18:41", "text": "天哪，游戏太多了，我根本玩不了。"}, {"type": "subtitle", "time": 11924.309, "timestamp": "03:18:44", "text": "停止播放。"}, {"type": "subtitle", "time": 11931.67, "timestamp": "03:18:51", "text": "我完全保留了它。"}, {"type": "subtitle", "time": 11933.75, "timestamp": "03:18:53", "text": "如果我有这么多钱，我就可以"}, {"type": "subtitle", "time": 11935.91, "timestamp": "03:18:55", "text": "做了很多事。"}, {"type": "subtitle", "time": 11938.79, "timestamp": "03:18:58", "text": "兄弟，我为什么会这样"}]
[{"type": "subtitle", "time": 17462.628, "timestamp": "04:51:02", "text": "呃"}, {"type": "subtitle", "time": 17465.19, "timestamp": "04:51:05", "text": "我上次直播是什么时候？两年"}, {"type": "subtitle", "time": 17467.51, "timestamp": "04:51:07", "text": "回去吧？"}, {"type": "subtitle", "time": 17478.948, "timestamp": "04:51:18", "text": "好的。我们几乎已经接近了"}, {"type": "subtitle", "time": 17481.11, "timestamp": "04:51:21", "text": "结尾。我终于可以"}, {"type": "subtitle", "time": 17485.11, "timestamp": "04:51:25", "text": "结束空间站的工作。哦，是的，我会"}, {"type": "subtitle", "time": 17488.39, "timestamp": "04:51:28", "text": "永远不要玩太空站游戏。"}, {"type": "subtitle", "time": 17492.15, "timestamp": "04:51:32", "text": "呃，我对这方面有不好的回忆。"}, {"type": "subtitle", "time": 17494.39, "timestamp": "04:51:34", "text": "更像是受到了同辈压力。"}, {"type": "subtitle", "time": 17497.11, "timestamp": "04:51:37", "text": "一个俄罗斯V2呃俄罗斯查看器，"}, {"type": "subtitle", "time": 17499.91, "timestamp": "04:51:39", "text": "那时已经到了。呃，他们碰巧"}, {"type": "subtitle", "time": 17503.11, "timestamp": "04:51:43", "text": "他们碰巧得到了Toxiki。"}, {"type": "subtitle", "time": 17505.35, "timestamp": "04:51:45", "text": "我们不再说话了。是的，他们"}, {"type": "subtitle", "time": 17508.07, "timestamp": "04:51:48", "text": "是他们把我带过来的。"}, {"type": "subtitle", "time": 17512.708, "timestamp": "04:51:52", "text": "比赛期间，兄弟，"}, {"type": "subtitle", "time": 17516.23, "timestamp": "04:51:56", "text": "有很多令人毛骨悚然的时刻。"}, {"type": "subtitle", "time": 17517.75, "timestamp": "04:51:57", "text": "上帝，"}, {"type": "subtitle", "time": 17519.67, "timestamp": "04:51:59", "text": "我知道我扮演的角色是在扮演某种角色。"}]
[{"type": "subtitle", "time": 18124.31, "timestamp": "05:02:04", "text": "现在我们要做的最后一件事是……"}, {"type": "subtitle", "time": 18134.39, "timestamp": "05:02:14", "text": "好了，暂停一下。我必须移除"}, {"type": "subtitle", "time": 18137.59, "timestamp": "05:02:17", "text": "你来自"}, {"type": "subtitle", "time": 18144.39, "timestamp": "05:02:24", "text": "旧卡片之类的东西？我们不需要你"}, {"type": "subtitle", "time": 18152.07, "timestamp": "05:02:32", "text": "好的，这件事暂时搁置了，对吧？我们将制作"}, {"type": "subtitle", "time": 18171.51, "timestamp": "05:02:51", "text": "[咳嗽]"}, {"type": "subtitle", "time": 18175.03, "timestamp": "05:02:55", "text": "所以从某种意义上说，人们可以审视所有这些"}, {"type": "subtitle", "time": 18177.51, "timestamp": "05:02:57", "text": "我玩过的游戏。您可以点击"}, {"type": "subtitle", "time": 18179.67, "timestamp": "05:02:59", "text": "播放列表里可以看到我的评分"}]
[{"type": "subtitle", "time": 12181.429, "timestamp": "03:23:01", "text": "我以前常在我的电脑上播放的那些老歌"}, {"type": "subtitle", "time": 12217.429, "timestamp": "03:23:37", "text": "但说实话，各位，呃，所有"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "我现在做的这些额外的事情。"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "说实话，你不需要我觉得我"}, {"type": "subtitle", "time": 12225.75, "timestamp": "03:23:45", "text": "我没有做更多额外的事情"}, {"type": "subtitle", "time": 12231.51, "timestamp": "03:23:51", "text": "我不知道。"}]
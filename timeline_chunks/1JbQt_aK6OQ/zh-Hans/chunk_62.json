[{"type": "subtitle", "time": 3725.91, "timestamp": "01:02:05", "text": "好的。萎缩波，新星，真空"}, {"type": "subtitle", "time": 3729.67, "timestamp": "01:02:09", "text": "清洁工、项目画布、养鸡工"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "森林，"}, {"type": "subtitle", "time": 3734.309, "timestamp": "01:02:14", "text": "枯萎的波浪，"}, {"type": "subtitle", "time": 3735.91, "timestamp": "01:02:15", "text": "枯萎"}, {"type": "subtitle", "time": 3745.75, "timestamp": "01:02:25", "text": "你好，泷纱。欢迎光临。晚上好。"}, {"type": "subtitle", "time": 3748.87, "timestamp": "01:02:28", "text": "好的，我们会保存这张图片。"}, {"type": "subtitle", "time": 3756.23, "timestamp": "01:02:36", "text": "保存一下。"}, {"type": "subtitle", "time": 3758.309, "timestamp": "01:02:38", "text": "天气沉浸其中，令人窒息。正确的。"}, {"type": "subtitle", "time": 3761.589, "timestamp": "01:02:41", "text": "直通 noa。"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "患病的"}]
[{"type": "subtitle", "time": 7320.39, "timestamp": "02:02:00", "text": "完成了吗？我好困惑。"}, {"type": "subtitle", "time": 7325.109, "timestamp": "02:02:05", "text": "我应该写“已完成”吗？或者我的意思是，我可以"}, {"type": "subtitle", "time": 7327.51, "timestamp": "02:02:07", "text": "总是反复播放，"}, {"type": "subtitle", "time": 7330.629, "timestamp": "02:02:10", "text": "但我不知道是否应该保留它。"}, {"type": "subtitle", "time": 7333.189, "timestamp": "02:02:13", "text": "就是这样。"}, {"type": "subtitle", "time": 7344.47, "timestamp": "02:02:24", "text": "好的。三。我挺喜欢的"}, {"type": "subtitle", "time": 7346.629, "timestamp": "02:02:26", "text": "致命公司。和朋友一起玩很开心。"}, {"type": "subtitle", "time": 7349.589, "timestamp": "02:02:29", "text": "所以，我给它四星。"}, {"type": "subtitle", "time": 7352.149, "timestamp": "02:02:32", "text": "那么，让我们来看看我们都更新了哪些内容。"}, {"type": "subtitle", "time": 7354.47, "timestamp": "02:02:34", "text": "所有游戏播放列表。让我来回顾一下。"}, {"type": "subtitle", "time": 7357.83, "timestamp": "02:02:37", "text": "我的应用。"}, {"type": "subtitle", "time": 7360.55, "timestamp": "02:02:40", "text": "好的。所以，因为森林是"}, {"type": "subtitle", "time": 7362.709, "timestamp": "02:02:42", "text": "这是我将来想玩的游戏。"}, {"type": "subtitle", "time": 7365.589, "timestamp": "02:02:45", "text": "呃，忽略这条信息。"}, {"type": "subtitle", "time": 7369.189, "timestamp": "02:02:49", "text": "邮政。好的。这些游戏已经完成"}, {"type": "subtitle", "time": 7373.91, "timestamp": "02:02:53", "text": "游戏。你为什么这么小？哦，你为什么？"}, {"type": "subtitle", "time": 7376.229, "timestamp": "02:02:56", "text": "这么小？"}, {"type": "subtitle", "time": 7378.149, "timestamp": "02:02:58", "text": "是啊，除此之外，还有什么呢？为什么会这样？"}]
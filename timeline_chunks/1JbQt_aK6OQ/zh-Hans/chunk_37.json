[{"type": "subtitle", "time": 2221.51, "timestamp": "00:37:01", "text": "能够看到交易备注"}, {"type": "subtitle", "time": 2224.47, "timestamp": "00:37:04", "text": "可能不太确定，因为现在的问题是……"}, {"type": "subtitle", "time": 2227.43, "timestamp": "00:37:07", "text": "不要在有人做出某项举动时收到通知"}, {"type": "subtitle", "time": 2230.39, "timestamp": "00:37:10", "text": "那个二维码玩意儿[嗤笑]"}, {"type": "subtitle", "time": 2232.95, "timestamp": "00:37:12", "text": "你好，迈尔森，希望你一切都好。"}, {"type": "subtitle", "time": 2238.069, "timestamp": "00:37:18", "text": "虽然还病着，但我还活着"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "好的，让我登录一下胖子公司的应用程序。"}, {"type": "subtitle", "time": 2243.67, "timestamp": "00:37:23", "text": "如果发生这种情况，它不会通知我。"}, {"type": "subtitle", "time": 2248.23, "timestamp": "00:37:28", "text": "任何人都可以发送任何东西。"}, {"type": "subtitle", "time": 2253.109, "timestamp": "00:37:33", "text": "有点奇怪，呃，Fed Corp.应用程序。"}, {"type": "subtitle", "time": 2255.181, "timestamp": "00:37:35", "text": "我刚设置好我的M引脚之类的东西。"}, {"type": "subtitle", "time": 2257.03, "timestamp": "00:37:37", "text": "[笑声]"}, {"type": "subtitle", "time": 2260.15, "timestamp": "00:37:40", "text": "真是太麻烦了。"}, {"type": "subtitle", "time": 2265.109, "timestamp": "00:37:45", "text": "好的。嗯，是的，它没告诉我。"}, {"type": "subtitle", "time": 2268.31, "timestamp": "00:37:48", "text": "它没有告诉我。"}, {"type": "subtitle", "time": 2271.19, "timestamp": "00:37:51", "text": "我的天啊。等等，我看到卡托斯了。哦，是的。"}, {"type": "subtitle", "time": 2273.67, "timestamp": "00:37:53", "text": "是的。谢谢你给的10卢比，D。"}, {"type": "subtitle", "time": 2276.15, "timestamp": "00:37:56", "text": "作品。看，"}, {"type": "subtitle", "time": 2278.39, "timestamp": "00:37:58", "text": "但我做不到。"}]
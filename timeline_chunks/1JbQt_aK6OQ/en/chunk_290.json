[{"type": "subtitle", "time": 17413.83, "timestamp": "04:50:13", "text": "Okay, next one is Rumble Wish."}, {"type": "subtitle", "time": 17416.628, "timestamp": "04:50:16", "text": "This game died and they stopped the"}, {"type": "subtitle", "time": 17419.19, "timestamp": "04:50:19", "text": "development of this game. They took it"}, {"type": "subtitle", "time": 17420.948, "timestamp": "04:50:20", "text": "down."}, {"type": "subtitle", "time": 17424.07, "timestamp": "04:50:24", "text": "It was sad. I'm glad I at least had one"}, {"type": "subtitle", "time": 17425.75, "timestamp": "04:50:25", "text": "stream of this. We finished the game,"}, {"type": "subtitle", "time": 17428.788, "timestamp": "04:50:28", "text": "too. It was a battle royale game. Really"}, {"type": "subtitle", "time": 17430.948, "timestamp": "04:50:30", "text": "fun game though,"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "but it sucks that it died. [music]"}, {"type": "subtitle", "time": 17437.27, "timestamp": "04:50:37", "text": "It had a season two,"}, {"type": "subtitle", "time": 17440.788, "timestamp": "04:50:40", "text": "but that's about it."}]
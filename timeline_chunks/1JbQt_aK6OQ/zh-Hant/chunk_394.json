[{"type": "subtitle", "time": 23641.67, "timestamp": "06:34:01", "text": "喵以前也不相信我"}, {"type": "subtitle", "time": 23643.67, "timestamp": "06:34:03", "text": "。然後我以前也不相信我見到他的時候，心想：“我的天哪。 」因為他個子也很高。他"}, {"type": "subtitle", "time": 23646.628, "timestamp": "06:34:06", "text": "看起來有6英尺高。 哇。我個子高嗎？我現在缺錢了。我不知道。我不記得了。你才到我肩膀"}, {"type": "subtitle", "time": 23675.99, "timestamp": "06:34:35", "text": "那麼高。[笑聲] 我的天哪。目前我單身。我之前在和人"}, {"type": "subtitle", "time": 23678.31, "timestamp": "06:34:38", "text": "交往，但是，嗯，最後沒成。僅僅因為我個子高。"}, {"type": "subtitle", "time": 23699.59, "timestamp": "06:34:59", "text": "[笑聲]"}, {"type": "subtitle", "time": 23699.75, "timestamp": "06:34:59", "text": "我的天哪。目前我單身"}]
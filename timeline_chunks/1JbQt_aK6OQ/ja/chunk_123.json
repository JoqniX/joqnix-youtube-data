[{"type": "subtitle", "time": 7380.709, "timestamp": "02:03:00", "text": "小さい？"}, {"type": "subtitle", "time": 7383.83, "timestamp": "02:03:03", "text": "これを変更する必要はありますか？なぜこれが"}, {"type": "subtitle", "time": 7385.91, "timestamp": "02:03:05", "text": "小さい？"}, {"type": "subtitle", "time": 7389.27, "timestamp": "02:03:09", "text": "試合を中止する。まあ、悪くないゲームだった。私"}, {"type": "subtitle", "time": 7392.629, "timestamp": "02:03:12", "text": "プレイを止めた。保留中を追加する必要があります"}, {"type": "subtitle", "time": 7396.31, "timestamp": "02:03:16", "text": "そうですね、そうですよね？そして私はこれを直さなければならない"}, {"type": "subtitle", "time": 7402.39, "timestamp": "02:03:22", "text": "何もない。私はヌルなものを特定できませんでした"}, {"type": "subtitle", "time": 7406.31, "timestamp": "02:03:26", "text": "これらのいくつかには表示されません"}, {"type": "subtitle", "time": 7409.75, "timestamp": "02:03:29", "text": "1つ。それを見せないように。"}, {"type": "subtitle", "time": 7411.51, "timestamp": "02:03:31", "text": "うん。"}, {"type": "subtitle", "time": 7415.189, "timestamp": "02:03:35", "text": "まあ、そうですね。セクターズエッジをクリアしました"}, {"type": "subtitle", "time": 7418.31, "timestamp": "02:03:38", "text": "そして私たちはリーサルカンパニーを終えました"}, {"type": "subtitle", "time": 7421.109, "timestamp": "02:03:41", "text": "次はモンキーパーティーです。これは私の"}, {"type": "subtitle", "time": 7425.51, "timestamp": "02:03:45", "text": "実際に手に入れた最初のゲーム"}, {"type": "subtitle", "time": 7428.55, "timestamp": "02:03:48", "text": "開発者からのメール。"}, {"type": "subtitle", "time": 7431.03, "timestamp": "02:03:51", "text": "ああ、これが史上初のゲームだ"}, {"type": "subtitle", "time": 7434.149, "timestamp": "02:03:54", "text": "実際には開発者が来て"}, {"type": "subtitle", "time": 7437.03, "timestamp": "02:03:57", "text": "連絡もくれたし、いろいろと。私はします"}, {"type": "subtitle", "time": 7439.91, "timestamp": "02:03:59", "text": "この試合のことは決して忘れないで。私はこう思った"}]
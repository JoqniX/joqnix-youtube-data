[{"type": "subtitle", "time": 6365.51, "timestamp": "01:46:05", "text": "わかった、私は2024年に死ぬだろう、そして私はそれをプレイした"}, {"type": "subtitle", "time": 6367.669, "timestamp": "01:46:07", "text": "204."}, {"type": "subtitle", "time": 6369.669, "timestamp": "01:46:09", "text": "これをクリックすると、"}, {"type": "subtitle", "time": 6373.109, "timestamp": "01:46:13", "text": "地獄のダイバーたちが何かに。はい、結構です。"}, {"type": "subtitle", "time": 6375.109, "timestamp": "01:46:15", "text": "地獄のダイバーたちとはもうおしまいだ。今"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "登録コンテンツに関する警告も実施済みです。"}, {"type": "subtitle", "time": 6382.149, "timestamp": "01:46:22", "text": "入隊は、その次の次の段階だ。"}, {"type": "subtitle", "time": 6387.27, "timestamp": "01:46:27", "text": "私"}, {"type": "subtitle", "time": 6390.629, "timestamp": "01:46:30", "text": "時々プレイする"}, {"type": "subtitle", "time": 6394.229, "timestamp": "01:46:34", "text": "リックと一緒ならね。では、次のように述べます。"}, {"type": "subtitle", "time": 6402.47, "timestamp": "01:46:42", "text": "入隊した人と画像を追加します"}, {"type": "subtitle", "time": 6406.629, "timestamp": "01:46:46", "text": "ヘルのために私も"}, {"type": "subtitle", "time": 6409.51, "timestamp": "01:46:49", "text": "死んだ。画像は既に追加済みです。いつ私は"}, {"type": "subtitle", "time": 6413.83, "timestamp": "01:46:53", "text": "最初のストリームHが登​​録されました"}, {"type": "subtitle", "time": 6417.669, "timestamp": "01:46:57", "text": "2024年？私は2024でたくさんのゲームをプレイしました。"}]
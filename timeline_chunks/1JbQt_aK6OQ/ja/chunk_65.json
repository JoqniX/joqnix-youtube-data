[{"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "さて、最後は鶏の世話だ。"}, {"type": "subtitle", "time": 3905.91, "timestamp": "01:05:05", "text": "ああ、実際にはカテゴリーがある"}, {"type": "subtitle", "time": 3912.71, "timestamp": "01:05:12", "text": "今、お元気ですか？私は、"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "そして保存する。見せる"}, {"type": "subtitle", "time": 3930.71, "timestamp": "01:05:30", "text": "ここへ行ってください"}, {"type": "subtitle", "time": 3933.75, "timestamp": "01:05:33", "text": "そしてそれを画像として保存します。"}, {"type": "subtitle", "time": 3942.069, "timestamp": "01:05:42", "text": "また、せっかくここにいるのだから、"}, {"type": "subtitle", "time": 3944.309, "timestamp": "01:05:44", "text": "森のサンズをプレイしたい"}, {"type": "subtitle", "time": 3948.549, "timestamp": "01:05:48", "text": "同じように。では、それをそのまま入れておきます。"}, {"type": "subtitle", "time": 3950.71, "timestamp": "01:05:50", "text": "万一に備えて。"}, {"type": "subtitle", "time": 3953.109, "timestamp": "01:05:53", "text": "わかった。"}, {"type": "subtitle", "time": 3957.19, "timestamp": "01:05:57", "text": "森の息子たち。これは"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "ええと、これは計画されたゲームになります。わかった。"}]
[{"type": "subtitle", "time": 2462.79, "timestamp": "00:41:02", "text": "金メダルが取れる"}, {"type": "subtitle", "time": 2466.309, "timestamp": "00:41:06", "text": "我々によれば、新しい死すべき黄金"}, {"type": "subtitle", "time": 2468.95, "timestamp": "00:41:08", "text": "しかし、それは奇妙に見える。いいえ、そうします"}, {"type": "subtitle", "time": 2471.829, "timestamp": "00:41:11", "text": "こうするしかない。いいえ、"}, {"type": "subtitle", "time": 2514.47, "timestamp": "00:41:54", "text": "それって見栄えいいかな？"}]
[{"type": "subtitle", "time": 8345.91, "timestamp": "02:19:05", "text": "Call of Dutyはどこにありますか？はい、わかりました。"}, {"type": "subtitle", "time": 8349.589, "timestamp": "02:19:09", "text": "えっと、そこに置いてください。そして、それは良かった。良い"}, {"type": "subtitle", "time": 8357.19, "timestamp": "02:19:17", "text": "そして、それを閉じます。 『ダイイングライト』をプレイしよう。"}, {"type": "subtitle", "time": 8360.505, "timestamp": "02:19:20", "text": "わかった。 『ダイイングライト』をプレイしよう。私"}, {"type": "subtitle", "time": 8361.669, "timestamp": "02:19:21", "text": "[咳払い] Dying Light をクリアしました"}, {"type": "subtitle", "time": 8363.27, "timestamp": "02:19:23", "text": "実は。"}, {"type": "subtitle", "time": 8372.15, "timestamp": "02:19:32", "text": "そして2015年20月。"}, {"type": "subtitle", "time": 8376.629, "timestamp": "02:19:36", "text": "完了しました。こちらをダウンロードしてください。"}, {"type": "subtitle", "time": 8384.23, "timestamp": "02:19:44", "text": "私は2023年にそれをプレイしました。"}, {"type": "subtitle", "time": 8387.27, "timestamp": "02:19:47", "text": "完全に完了しました。いい試合だった。"}, {"type": "subtitle", "time": 8390.07, "timestamp": "02:19:50", "text": "本当に大好きです"}, {"type": "subtitle", "time": 8393.19, "timestamp": "02:19:53", "text": "私が制作したシリーズです。"}, {"type": "subtitle", "time": 8396.07, "timestamp": "02:19:56", "text": "2年前。"}, {"type": "subtitle", "time": 8399.349, "timestamp": "02:19:59", "text": "ええ、4月に"}]
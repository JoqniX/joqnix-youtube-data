[{"type": "subtitle", "time": 18181.75, "timestamp": "05:03:01", "text": "同じように"}, {"type": "subtitle", "time": 18184.23, "timestamp": "05:03:04", "text": "5段階評価。"}, {"type": "subtitle", "time": 18186.31, "timestamp": "05:03:06", "text": "えっと、"}, {"type": "subtitle", "time": 18190.708, "timestamp": "05:03:10", "text": "ええ、上部にフィルターシステムを設置します"}, {"type": "subtitle", "time": 18192.868, "timestamp": "05:03:12", "text": "将来。ご心配なく、私たちが"}, {"type": "subtitle", "time": 18196.07, "timestamp": "05:03:16", "text": "それ。だから、もし私がそれらをやりたいと思ったら"}, {"type": "subtitle", "time": 18211.19, "timestamp": "05:03:31", "text": "また、ゲームをしたり、"}, {"type": "subtitle", "time": 18221.75, "timestamp": "05:03:41", "text": "うん、"}, {"type": "subtitle", "time": 18224.788, "timestamp": "05:03:44", "text": "評価は必要ありません"}, {"type": "subtitle", "time": 18229.27, "timestamp": "05:03:49", "text": "ゲームの場合"}, {"type": "subtitle", "time": 18233.59, "timestamp": "05:03:53", "text": "プレイカテゴリデータベースにあるもの"}, {"type": "subtitle", "time": 18237.99, "timestamp": "05:03:57", "text": "保留中など。"}]
[{"type": "subtitle", "time": 4324.35, "timestamp": "01:12:04", "text": "1年前にプレイしました。"}, {"type": "subtitle", "time": 4329.59, "timestamp": "01:12:09", "text": "これは、公に"}, {"type": "subtitle", "time": 4333.03, "timestamp": "01:12:13", "text": "自分が数学が苦手だということが明らかになった。"}, {"type": "subtitle", "time": 4335.189, "timestamp": "01:12:15", "text": "私が電卓を使っているという事実"}, {"type": "subtitle", "time": 4338.39, "timestamp": "01:12:18", "text": "これは私がどれだけこの分野に不慣れかを示している。私はします"}, {"type": "subtitle", "time": 4344.55, "timestamp": "01:12:24", "text": "流れの中にいた人たちにとって、"}, {"type": "subtitle", "time": 4360.47, "timestamp": "01:12:40", "text": "わかった。これまでのところ、ええと、見てみましょう。えーと、ストリーム"}, {"type": "subtitle", "time": 4362.63, "timestamp": "01:12:42", "text": "ギャラリー。"}, {"type": "subtitle", "time": 4364.87, "timestamp": "01:12:44", "text": "だから、アップデートされているはずですよね？私"}, {"type": "subtitle", "time": 4368.07, "timestamp": "01:12:48", "text": "ゲームをたくさん追加しました"}, {"type": "subtitle", "time": 4370.39, "timestamp": "01:12:50", "text": "プレイ中。"}, {"type": "subtitle", "time": 4372.95, "timestamp": "01:12:52", "text": "問題は、そうではないと分かっているということだ"}]
[{"type": "subtitle", "time": 3611.27, "timestamp": "01:00:11", "text": "ええと、無限に"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "ニキ。"}, {"type": "subtitle", "time": 3615.43, "timestamp": "01:00:15", "text": "インフィニティニキが発売された。何年"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "また？"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "無限。"}, {"type": "subtitle", "time": 3635.51, "timestamp": "01:00:35", "text": "そして、私の背中から画像を載せます"}, {"type": "subtitle", "time": 3645.19, "timestamp": "01:00:45", "text": "そして私はそれを7時に演奏しました"}]
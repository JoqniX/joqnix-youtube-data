[{"type": "subtitle", "time": 17161.51, "timestamp": "04:46:01", "text": "いいえ、"}, {"type": "subtitle", "time": 17163.75, "timestamp": "04:46:03", "text": "私は全てを正しました。コール オブ デューティ ウォー"}, {"type": "subtitle", "time": 17167.19, "timestamp": "04:46:07", "text": "ゾーン。一つ確認しておきたいことがあります。"}, {"type": "subtitle", "time": 17169.99, "timestamp": "04:46:09", "text": "War Zone 1 と War Zone のどちらを入れるべきか"}, {"type": "subtitle", "time": 17172.23, "timestamp": "04:46:12", "text": "2022年？"}, {"type": "subtitle", "time": 17177.35, "timestamp": "04:46:17", "text": "2022年の戦場と表記した方が良いのではないでしょうか？"}, {"type": "subtitle", "time": 17181.83, "timestamp": "04:46:21", "text": "えーと、2022年の戦争地帯と書きます。"}, {"type": "subtitle", "time": 17184.39, "timestamp": "04:46:24", "text": "うん、2022年の戦場って書いておくよ。えっと、私は"}, {"type": "subtitle", "time": 17204.31, "timestamp": "04:46:44", "text": "と"}, {"type": "subtitle", "time": 17206.31, "timestamp": "04:46:46", "text": "戦場。"}, {"type": "subtitle", "time": 17212.07, "timestamp": "04:46:52", "text": "よし、もうすぐ終わりだ。あと少しだけ"}, {"type": "subtitle", "time": 17214.31, "timestamp": "04:46:54", "text": "究極の一撃。このゲームは終了しましたが、"}, {"type": "subtitle", "time": 17218.55, "timestamp": "04:46:58", "text": "新しいDLCが出たんですよね？"}]
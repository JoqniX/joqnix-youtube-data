[{"type": "subtitle", "time": 13204.229, "timestamp": "03:40:04", "text": "頂点"}, {"type": "subtitle", "time": 13213.51, "timestamp": "03:40:13", "text": "役職"}, {"type": "subtitle", "time": 13216.229, "timestamp": "03:40:16", "text": "Apexの新シーズンが始まりました。"}, {"type": "subtitle", "time": 13224.07, "timestamp": "03:40:24", "text": "Apex 2019 をプレイするのが恋しい"}, {"type": "subtitle", "time": 13228.389, "timestamp": "03:40:28", "text": "2019年。初めてのApex配信でApexをプレイしました。"}, {"type": "subtitle", "time": 13233.03, "timestamp": "03:40:33", "text": "私がストリーミングを始めたとき"}, {"type": "subtitle", "time": 13235.03, "timestamp": "03:40:35", "text": "Vubing以前。"}, {"type": "subtitle", "time": 13238.229, "timestamp": "03:40:38", "text": "私は初日からApexをプレイしています。以前ストリーミング配信した"}, {"type": "subtitle", "time": 13242.07, "timestamp": "03:40:42", "text": "ヴービングは長い背中の男だ。ずっと昔"}, {"type": "subtitle", "time": 13243.83, "timestamp": "03:40:43", "text": "2019年。"}, {"type": "subtitle", "time": 13246.63, "timestamp": "03:40:46", "text": "うん。私はもうそれらのWSを持っていません。"}, {"type": "subtitle", "time": 13249.349, "timestamp": "03:40:49", "text": "すべてなくなってしまった。"}, {"type": "subtitle", "time": 13251.83, "timestamp": "03:40:51", "text": "初日、Apex。"}, {"type": "subtitle", "time": 13254.63, "timestamp": "03:40:54", "text": "いいえ、3 の後に Apex をプレイしたのは私です"}]
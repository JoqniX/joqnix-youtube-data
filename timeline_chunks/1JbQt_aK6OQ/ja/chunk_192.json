[{"type": "subtitle", "time": 11526.469, "timestamp": "03:12:06", "text": "また。皆さん、夕食は召し上がりましたか？私"}, {"type": "subtitle", "time": 11530.15, "timestamp": "03:12:10", "text": "この後、夕食を食べに行かなければならない。"}, {"type": "subtitle", "time": 11543.349, "timestamp": "03:12:23", "text": "私がこのゲームを初めて配信したのはいつだったでしょうか？ 2023年、"}]
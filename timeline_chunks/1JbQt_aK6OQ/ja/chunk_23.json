[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "タールスケープと数人のインド人"}, {"type": "subtitle", "time": 1383.19, "timestamp": "00:23:03", "text": "クリエイター"}, {"type": "subtitle", "time": 1386.149, "timestamp": "00:23:06", "text": "ICIC銀行を利用してください。"}, {"type": "subtitle", "time": 1389.35, "timestamp": "00:23:09", "text": "ゼロについての噂がある"}, {"type": "subtitle", "time": 1391.909, "timestamp": "00:23:11", "text": "アカウントまたは手数料無料アカウントなど。しかし私の"}, {"type": "subtitle", "time": 1396.07, "timestamp": "00:23:16", "text": "父は、アカウントも作成したと言っていました。"}, {"type": "subtitle", "time": 1398.549, "timestamp": "00:23:18", "text": "なぜなら彼らはゼロだと言ったから"}, {"type": "subtitle", "time": 1401.75, "timestamp": "00:23:21", "text": "トランスゼロとか何とか。えっと"}, {"type": "subtitle", "time": 1404.31, "timestamp": "00:23:24", "text": "しかし、しばらくすると"}, {"type": "subtitle", "time": 1406.789, "timestamp": "00:23:26", "text": "彼らはあなたからたくさんのお金を奪うでしょう"}, {"type": "subtitle", "time": 1408.549, "timestamp": "00:23:28", "text": "あるいは何か"}, {"type": "subtitle", "time": 1412.07, "timestamp": "00:23:32", "text": "えーと、もしあなたが、もしあなたが満たされていないなら"}, {"type": "subtitle", "time": 1413.669, "timestamp": "00:23:33", "text": "あなたはバランスを崩しているか何か"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "まあ、そんな感じ。だから彼は"}, {"type": "subtitle", "time": 1418.39, "timestamp": "00:23:38", "text": "連邦政府とは関係ないと考えられていたが、そうではなかった。"}, {"type": "subtitle", "time": 1422.47, "timestamp": "00:23:42", "text": "ICに関係するけど、それでも行くと言った"}, {"type": "subtitle", "time": 1424.549, "timestamp": "00:23:44", "text": "金曜日に確認して、すべて完了。しかし"}, {"type": "subtitle", "time": 1426.71, "timestamp": "00:23:46", "text": "ええ、それで私がやったことは、電流を流すことでした"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "アカウント登録後、私自身を"}, {"type": "subtitle", "time": 1435.669, "timestamp": "00:23:55", "text": "すべて所有権が移った。だから私は"}, {"type": "subtitle", "time": 1437.27, "timestamp": "00:23:57", "text": "えーと"}]
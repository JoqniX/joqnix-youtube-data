[{"type": "subtitle", "time": 17521.35, "timestamp": "04:52:01", "text": "ゲームだけど、それでもすごくたくさんあった"}, {"type": "subtitle", "time": 17524.23, "timestamp": "04:52:04", "text": "不気味で奇妙な瞬間。どうすればいいのかわからない"}, {"type": "subtitle", "time": 17528.788, "timestamp": "04:52:08", "text": "それについて話し合う。とても不気味だった。"}, {"type": "subtitle", "time": 17537.27, "timestamp": "04:52:17", "text": "まだアカウント停止になっていないことに驚いています"}, {"type": "subtitle", "time": 17540.708, "timestamp": "04:52:20", "text": "なぜなら、たくさんの差別的な言葉があったからです。"}, {"type": "subtitle", "time": 17543.59, "timestamp": "04:52:23", "text": "それはそのゲームの人々のように使われた"}, {"type": "subtitle", "time": 17546.39, "timestamp": "04:52:26", "text": "あのサーバーはめちゃくちゃひどかった。彼らは言った"}, {"type": "subtitle", "time": 17551.11, "timestamp": "04:52:31", "text": "たくさんの汚い言葉。だからこの側では"}, {"type": "subtitle", "time": 17553.91, "timestamp": "04:52:33", "text": "右側には、"}, {"type": "subtitle", "time": 17557.75, "timestamp": "04:52:37", "text": "チャット。ある意味で、これが目に見える形で示されるならば"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "配信中だった場合、それは私の責任ですよね？"}, {"type": "subtitle", "time": 17565.43, "timestamp": "04:52:45", "text": "でも、もし他の誰かがそう言ったら、私は"}, {"type": "subtitle", "time": 17567.83, "timestamp": "04:52:47", "text": "生放送すると、それは私の"}, {"type": "subtitle", "time": 17570.47, "timestamp": "04:52:50", "text": "間違いですよね？私のチャンネルは"}, {"type": "subtitle", "time": 17575.75, "timestamp": "04:52:55", "text": "ダウンとか、そういう感じですよね？でも私は"}, {"type": "subtitle", "time": 17578.15, "timestamp": "04:52:58", "text": "切り落とした 私はいくつかの切り落としたことを覚えている"}]
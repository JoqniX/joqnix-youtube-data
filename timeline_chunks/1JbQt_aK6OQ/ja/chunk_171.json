[{"type": "subtitle", "time": 10264.389, "timestamp": "02:51:04", "text": "私はブルースタックを持っていますか？"}, {"type": "subtitle", "time": 10266.55, "timestamp": "02:51:06", "text": "私はブルースタックを持っています。わかりました、お見せします"}, {"type": "subtitle", "time": 10269.99, "timestamp": "02:51:09", "text": "あなた。待って、それってできるの？ああ、私は"}, {"type": "subtitle", "time": 10273.91, "timestamp": "02:51:13", "text": "知る。私はそうは思わない、待って、どうすればいいの"}, {"type": "subtitle", "time": 10288.15, "timestamp": "02:51:28", "text": "私には無理だと思う。おっと。"}, {"type": "subtitle", "time": 10300.389, "timestamp": "02:51:40", "text": "そこで私たちは「うん」について脱線した。"}, {"type": "subtitle", "time": 10303.429, "timestamp": "02:51:43", "text": "そう、UPIならそれができるんです。これ"}, {"type": "subtitle", "time": 10307.188, "timestamp": "02:51:47", "text": "ちなみに、これはインドでのみ有効です。"}, {"type": "subtitle", "time": 10307.844, "timestamp": "02:51:47", "text": "[咳]"}, {"type": "subtitle", "time": 10308.87, "timestamp": "02:51:48", "text": "[咳払い]"}, {"type": "subtitle", "time": 10314.15, "timestamp": "02:51:54", "text": "ええ、将来は"}, {"type": "subtitle", "time": 10316.79, "timestamp": "02:51:56", "text": "私は～と一緒に行こうと思っています"}]
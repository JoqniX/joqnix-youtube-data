[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "私はあなたが欲しいです。あなたに見てもらいたいんです。いいえ。わかりました。"}, {"type": "subtitle", "time": 843.67, "timestamp": "00:14:03", "text": "大丈夫。 [鼻を鳴らす]"}, {"type": "subtitle", "time": 864.71, "timestamp": "00:14:24", "text": "えっと、色。ああ、色を変えることができる"}, {"type": "subtitle", "time": 866.55, "timestamp": "00:14:26", "text": "で"}, {"type": "subtitle", "time": 879.91, "timestamp": "00:14:39", "text": "私はこれが好きだけど、好きではない"}, {"type": "subtitle", "time": 887.43, "timestamp": "00:14:47", "text": "普通のタイプもいいですね。硬化形状。"}, {"type": "subtitle", "time": 890.47, "timestamp": "00:14:50", "text": "（笑い）"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "そこには。実に様々な形と色。形状"}, {"type": "subtitle", "time": 897.829, "timestamp": "00:14:57", "text": "あなたが待つように。星をもらえますか？"}]
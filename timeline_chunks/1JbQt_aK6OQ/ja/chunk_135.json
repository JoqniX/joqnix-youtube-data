[{"type": "subtitle", "time": 8105.669, "timestamp": "02:15:05", "text": "ああ、不気味だ。ああ、なんてことだ。貪り食うとは"}, {"type": "subtitle", "time": 8107.75, "timestamp": "02:15:07", "text": "怖い。"}, {"type": "subtitle", "time": 8110.47, "timestamp": "02:15:10", "text": "貪り食う。"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "シラザードも完成しました。最初は"}, {"type": "subtitle", "time": 8125.91, "timestamp": "02:15:25", "text": "プレイしました。うん。"}, {"type": "subtitle", "time": 8128.629, "timestamp": "02:15:28", "text": "次は『コール オブ デューティ モダン・ウォーフェア』です。"}, {"type": "subtitle", "time": 8137.75, "timestamp": "02:15:37", "text": "待って、タブグループを作ればいいかな"}, {"type": "subtitle", "time": 8153.83, "timestamp": "02:15:53", "text": "ここでタブグループを作成するにはどうすればよいですか？"}]
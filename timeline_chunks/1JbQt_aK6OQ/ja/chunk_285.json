[{"type": "subtitle", "time": 17101.67, "timestamp": "04:45:01", "text": "そして、えっと"}, {"type": "subtitle", "time": 17104.15, "timestamp": "04:45:04", "text": "配送のこととか、その他諸々。私"}, {"type": "subtitle", "time": 17106.788, "timestamp": "04:45:06", "text": "私にはそれはできないと思います。でも私は"}, {"type": "subtitle", "time": 17108.708, "timestamp": "04:45:08", "text": "でも、それを学んでください。少なくとも私は売りたい"}, {"type": "subtitle", "time": 17112.628, "timestamp": "04:45:12", "text": "地元で販売されているグッズもあります。"}, {"type": "subtitle", "time": 17116.07, "timestamp": "04:45:16", "text": "物事がどのように進むのかを学びましょう。そうします"}, {"type": "subtitle", "time": 17118.708, "timestamp": "04:45:18", "text": "まずはステッカーから。安く手に入るよ。 30歳くらい"}, {"type": "subtitle", "time": 17121.99, "timestamp": "04:45:21", "text": "ルピー、40ルピーくらいかな。"}, {"type": "subtitle", "time": 17128.868, "timestamp": "04:45:28", "text": "では、やってみましょう。"}, {"type": "subtitle", "time": 17132.07, "timestamp": "04:45:32", "text": "わかった。戦争"}, {"type": "subtitle", "time": 17134.39, "timestamp": "04:45:34", "text": "ショーン。私"}, {"type": "subtitle", "time": 17137.59, "timestamp": "04:45:37", "text": "キャンセルしてもいいですか？私は止まった"}, {"type": "subtitle", "time": 17140.31, "timestamp": "04:45:40", "text": "それをプレイするのをやめた。ダウンロードしていません"}, {"type": "subtitle", "time": 17142.31, "timestamp": "04:45:42", "text": "それ以来ずっと。"}, {"type": "subtitle", "time": 17147.75, "timestamp": "04:45:47", "text": "えっと、ある日、ほら、私は"}, {"type": "subtitle", "time": 17150.628, "timestamp": "04:45:50", "text": "そのためには製造業者を見つける必要があるか、"}, {"type": "subtitle", "time": 17159.03, "timestamp": "04:45:59", "text": "編み物とか、何でも覚えなさい。"}]
[{"type": "subtitle", "time": 20521.19, "timestamp": "05:42:01", "text": "外へ"}, {"type": "subtitle", "time": 20524.39, "timestamp": "05:42:04", "text": "著作権証明書"}, {"type": "subtitle", "time": 20527.43, "timestamp": "05:42:07", "text": "えーと、いろいろ。"}, {"type": "chat", "time": 20527.609, "timestamp": "05:42:07", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "@Amartyajit his razor pay scam"}, {"type": "subtitle", "time": 20529.83, "timestamp": "05:42:09", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 20531.83, "timestamp": "05:42:11", "text": "そして彼らは未だに何も分かっていない。そして"}, {"type": "subtitle", "time": 20534.07, "timestamp": "05:42:14", "text": "それから私は彼女に尋ねた"}, {"type": "subtitle", "time": 20537.11, "timestamp": "05:42:17", "text": "えっと、他に何かありますか？"}, {"type": "subtitle", "time": 20541.91, "timestamp": "05:42:21", "text": "インフルエンサーとかクリエイターとか"}, {"type": "subtitle", "time": 20544.23, "timestamp": "05:42:24", "text": "オンラインクリエイターはRazor Payを利用していますか？どうやって"}, {"type": "subtitle", "time": 20546.548, "timestamp": "05:42:26", "text": "あなたは彼らのためにそうするのですか？すると彼らはこう言った"}, {"type": "chat", "time": 20547.036, "timestamp": "05:42:27", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "they still call you huh"}, {"type": "subtitle", "time": 20549.43, "timestamp": "05:42:29", "text": "彼らは皆著作権の問題をやったり、"}, {"type": "subtitle", "time": 20552.628, "timestamp": "05:42:32", "text": "何か。私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 20554.39, "timestamp": "05:42:34", "text": "著作権を登録するには"}, {"type": "subtitle", "time": 20557.11, "timestamp": "05:42:37", "text": "政府手数料などの娯楽"}, {"type": "subtitle", "time": 20559.51, "timestamp": "05:42:39", "text": "それ自体は10,000～12,000くらいです。"}, {"type": "subtitle", "time": 20561.91, "timestamp": "05:42:41", "text": "聖なる弁護士。"}, {"type": "subtitle", "time": 20563.91, "timestamp": "05:42:43", "text": "弁護士はおそらく次のような料金を請求するでしょう"}, {"type": "subtitle", "time": 20565.27, "timestamp": "05:42:45", "text": "20,000。"}, {"type": "subtitle", "time": 20567.43, "timestamp": "05:42:47", "text": "聖なる。"}, {"type": "subtitle", "time": 20569.59, "timestamp": "05:42:49", "text": "いいえ、"}, {"type": "subtitle", "time": 20571.75, "timestamp": "05:42:51", "text": "私は（笑）お金がないんです。"}, {"type": "subtitle", "time": 20574.788, "timestamp": "05:42:54", "text": "何てことだ。ええ、私は人種差別的なことはしません"}, {"type": "subtitle", "time": 20576.708, "timestamp": "05:42:56", "text": "祈り。"}]
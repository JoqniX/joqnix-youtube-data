[{"type": "subtitle", "time": 16680.789, "timestamp": "04:38:00", "text": "小川、そして笛のような音を立てる小川も。えっと"}, {"type": "subtitle", "time": 16683.99, "timestamp": "04:38:03", "text": "それからピアノ学習のストリーム、Dualingo。それで"}, {"type": "subtitle", "time": 16686.31, "timestamp": "04:38:06", "text": "私はこれらすべてを"}, {"type": "subtitle", "time": 16690.709, "timestamp": "04:38:10", "text": "ウェブサイトも同様です。そうですね、ある意味では。"}, {"type": "subtitle", "time": 16693.99, "timestamp": "04:38:13", "text": "これはゲームの部分です。"}, {"type": "subtitle", "time": 16697.029, "timestamp": "04:38:17", "text": "ここからがゲームパートです。だから私は"}, {"type": "subtitle", "time": 16699.83, "timestamp": "04:38:19", "text": "タブのようにこのようにする"}, {"type": "subtitle", "time": 16701.59, "timestamp": "04:38:21", "text": "バージョン。"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "えっと、クレジットページに移動したら"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "私のモデルとすべてのクレジットは"}, {"type": "subtitle", "time": 16708.47, "timestamp": "04:38:28", "text": "ここ。では、このように作ります。人々"}, {"type": "subtitle", "time": 16712.07, "timestamp": "04:38:32", "text": "タブボタンをクリックできます。ゲーム"}, {"type": "subtitle", "time": 16715.029, "timestamp": "04:38:35", "text": "ゲーム関連のものをお見せします。"}, {"type": "subtitle", "time": 16716.551, "timestamp": "04:38:36", "text": "他のストリームコンテンツは"}, {"type": "subtitle", "time": 16719.429, "timestamp": "04:38:39", "text": "このように表示されています。"}, {"type": "subtitle", "time": 16722.23, "timestamp": "04:38:42", "text": "だから私を見ていない人たちは"}, {"type": "subtitle", "time": 16724.629, "timestamp": "04:38:44", "text": "YouTube で、もし彼らが Twitch から私を見ているなら"}, {"type": "subtitle", "time": 16726.47, "timestamp": "04:38:46", "text": "そしてキックすると、彼らはチェックすることもできます"}, {"type": "subtitle", "time": 16729.029, "timestamp": "04:38:49", "text": "もし彼らが偶然そのウェブサイトを見つけたら。"}, {"type": "subtitle", "time": 16730.869, "timestamp": "04:38:50", "text": "彼らは私がプレイしたすべてのゲームを見ることができます"}, {"type": "subtitle", "time": 16733.83, "timestamp": "04:38:53", "text": "私がまだプレイしていないゲームなど"}, {"type": "subtitle", "time": 16736.869, "timestamp": "04:38:56", "text": "うん。それから私は時々"}, {"type": "subtitle", "time": 16738.789, "timestamp": "04:38:58", "text": "できるときはいつでも"}]
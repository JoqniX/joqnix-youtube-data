[{"type": "subtitle", "time": 11129.83, "timestamp": "03:05:29", "text": "ホーク・ジャマ・ウォーフロック。彼らはこれを止めた"}, {"type": "subtitle", "time": 11132.469, "timestamp": "03:05:32", "text": "あのゲームをやってる奴。彼らは、彼らは"}, {"type": "subtitle", "time": 11136.71, "timestamp": "03:05:36", "text": "彼らがこれを止めた"}, {"type": "subtitle", "time": 11140.389, "timestamp": "03:05:40", "text": "ゲーム。彼らはそれを撤去した。発達"}, {"type": "subtitle", "time": 11144.55, "timestamp": "03:05:44", "text": "終わった。 2019年、"}]
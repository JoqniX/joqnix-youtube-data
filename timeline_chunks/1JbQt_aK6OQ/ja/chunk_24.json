[{"type": "subtitle", "time": 1440.39, "timestamp": "00:24:00", "text": "えっと、私は彼らに作ってもらうよう頼みました"}, {"type": "subtitle", "time": 1442.71, "timestamp": "00:24:02", "text": "現在のカードが開きました"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "5,000。ありがたいことに、5,000 か"}, {"type": "subtitle", "time": 1449.029, "timestamp": "00:24:09", "text": "10,000。だから、開店するために5000ドル払わなければならなかった"}, {"type": "subtitle", "time": 1451.269, "timestamp": "00:24:11", "text": "当座預金。数日後、"}, {"type": "subtitle", "time": 1455.35, "timestamp": "00:24:15", "text": "アカウントが有効化されました。それで、えーと"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "連邦銀行にはアプリがあります"}, {"type": "subtitle", "time": 1459.83, "timestamp": "00:24:19", "text": "企業、連邦準備制度理事会（FRB）"}, {"type": "subtitle", "time": 1462.39, "timestamp": "00:24:22", "text": "アプリを変更してからいくつか問題が発生しました"}, {"type": "subtitle", "time": 1469.59, "timestamp": "00:24:29", "text": "[笑い]"}, {"type": "subtitle", "time": 1473.11, "timestamp": "00:24:33", "text": "ええ、そうですね。そこで私は"}, {"type": "subtitle", "time": 1476.789, "timestamp": "00:24:36", "text": "番号。だから、私が変更したので、フェドコ"}, {"type": "subtitle", "time": 1478.87, "timestamp": "00:24:38", "text": "アプリはお釣りの番号には対応していません。"}, {"type": "subtitle", "time": 1480.95, "timestamp": "00:24:40", "text": "最初に指定した番号でのみ機能します"}, {"type": "subtitle", "time": 1483.75, "timestamp": "00:24:43", "text": "登録済み、えーと、現在サインアップ済み"}, {"type": "subtitle", "time": 1487.43, "timestamp": "00:24:47", "text": "アカウント。それで、"}, {"type": "subtitle", "time": 1490.149, "timestamp": "00:24:50", "text": "待って、誰が私のデバイスを追加したの？誰が"}, {"type": "subtitle", "time": 1492.87, "timestamp": "00:24:52", "text": "メルビン？誰？この男は誰？待って、"}, {"type": "subtitle", "time": 1496.23, "timestamp": "00:24:56", "text": "誰かが私のPCに接続しようとした？"}, {"type": "subtitle", "time": 1498.63, "timestamp": "00:24:58", "text": "私の誰？待って、ホステルの人たちは"}]
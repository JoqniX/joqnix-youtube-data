[{"type": "subtitle", "time": 7442.07, "timestamp": "02:04:02", "text": "どれだけ本当にプレイしたかったかを伝える"}, {"type": "subtitle", "time": 7445.669, "timestamp": "02:04:05", "text": "えーと、スイカのゲームみたいな感じだけど、買えないんだ"}, {"type": "subtitle", "time": 7448.709, "timestamp": "02:04:08", "text": "ニンテンドースイッチのように。私はとても悲しかった"}, {"type": "subtitle", "time": 7450.47, "timestamp": "02:04:10", "text": "日。"}, {"type": "subtitle", "time": 7452.55, "timestamp": "02:04:12", "text": "ストリームで実行していたら、誰かが"}, {"type": "subtitle", "time": 7454.87, "timestamp": "02:04:14", "text": "実際に私を見ていたのは"}, {"type": "subtitle", "time": 7458.709, "timestamp": "02:04:18", "text": "たまたま開発者だったのですが、"}, {"type": "subtitle", "time": 7461.189, "timestamp": "02:04:21", "text": "私のメールビジネスにメールが届きました"}, {"type": "subtitle", "time": 7464.229, "timestamp": "02:04:24", "text": "メールといいねでチェックするように言われた"}, {"type": "subtitle", "time": 7467.076, "timestamp": "02:04:27", "text": "ゲームを試してみた。楽しかったです。"}, {"type": "subtitle", "time": 7467.669, "timestamp": "02:04:27", "text": "[笑い]"}, {"type": "subtitle", "time": 7477.35, "timestamp": "02:04:37", "text": "えっと、猿のおまる。"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "ああ、ここに彼らの記事があるんですね。"}, {"type": "subtitle", "time": 7483.99, "timestamp": "02:04:43", "text": "このゲームが発売されました。画像を保存します"}, {"type": "subtitle", "time": 7485.589, "timestamp": "02:04:45", "text": "として"}]
[{"type": "subtitle", "time": 3321.51, "timestamp": "00:55:21", "text": "追加処理はどのように行われるのですか？インスタグラム"}, {"type": "subtitle", "time": 3331.91, "timestamp": "00:55:31", "text": "わかった。今はただここを見ているだけでいい。待って。"}, {"type": "subtitle", "time": 3335.03, "timestamp": "00:55:35", "text": "ボディカメラ。"}, {"type": "subtitle", "time": 3338.63, "timestamp": "00:55:38", "text": "ああ、ここにある。"}, {"type": "subtitle", "time": 3341.349, "timestamp": "00:55:41", "text": "ほら、私たちは"}, {"type": "subtitle", "time": 3349.75, "timestamp": "00:55:49", "text": "彼女"}]
[{"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "私のPCで処理できるといいのですが。でも私は"}, {"type": "subtitle", "time": 485.43, "timestamp": "00:08:05", "text": "バトルフィールドをプレイしたい。 [笑い]"}, {"type": "subtitle", "time": 488.309, "timestamp": "00:08:08", "text": "私はSHゲームが大好きです。彼らがリリースするたびに"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "新しいもの、それは私が試みる伝統です"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "参加するために最善を尽くし、参加し、"}, {"type": "subtitle", "time": 497.35, "timestamp": "00:08:17", "text": "僕も演奏しようと努力してるよ。"}, {"type": "subtitle", "time": 505.749, "timestamp": "00:08:25", "text": "ええ、そうしますよ。させて"}, {"type": "subtitle", "time": 507.909, "timestamp": "00:08:27", "text": "もう一度確認して、"}, {"type": "subtitle", "time": 511.589, "timestamp": "00:08:31", "text": "タイトルとすべてが変わりました"}, {"type": "subtitle", "time": 514.07, "timestamp": "00:08:34", "text": "えっと、これ。皆さんは私に"}, {"type": "subtitle", "time": 516.87, "timestamp": "00:08:36", "text": "UPI IDを送信しますか？私はしていません。私はいつも"}, {"type": "subtitle", "time": 519.909, "timestamp": "00:08:39", "text": "料理コードで送ったと言ったが、"}, {"type": "subtitle", "time": 524.71, "timestamp": "00:08:44", "text": "あのー、えっと、えっと、私はまだ"}, {"type": "subtitle", "time": 530.47, "timestamp": "00:08:50", "text": "まだQRコードすら作ってないんです。"}, {"type": "subtitle", "time": 531.43, "timestamp": "00:08:51", "text": "QR [鼻を鳴らす]"}, {"type": "subtitle", "time": 533.03, "timestamp": "00:08:53", "text": "コード"}, {"type": "subtitle", "time": 535.269, "timestamp": "00:08:55", "text": "ジェネレータ。"}]
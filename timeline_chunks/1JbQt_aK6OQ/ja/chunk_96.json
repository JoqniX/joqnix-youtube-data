[{"type": "chat", "time": 5767.295, "timestamp": "01:36:07", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "its buffering"}, {"type": "subtitle", "time": 5769.03, "timestamp": "01:36:09", "text": "えっと、スマホアプリを再読み込みしてください。もしあなたが"}, {"type": "subtitle", "time": 5770.79, "timestamp": "01:36:10", "text": "携帯電話から見ている、あなたは見ている"}, {"type": "subtitle", "time": 5781.51, "timestamp": "01:36:21", "text": "ストリームを遡ることはできません。"}, {"type": "subtitle", "time": 5788.629, "timestamp": "01:36:28", "text": "それは常に上流側で動作します。"}, {"type": "subtitle", "time": 5792.95, "timestamp": "01:36:32", "text": "これは少しは役に立つかもしれない。"}, {"type": "subtitle", "time": 5796.07, "timestamp": "01:36:36", "text": "うん。うん。そして私たちは日常に戻った"}, {"type": "subtitle", "time": 5800.47, "timestamp": "01:36:40", "text": "遅延。一瞬正常に戻る"}, {"type": "subtitle", "time": 5802.07, "timestamp": "01:36:42", "text": "遅れ"}, {"type": "subtitle", "time": 5804.07, "timestamp": "01:36:44", "text": "いつものように。"}, {"type": "subtitle", "time": 5807.43, "timestamp": "01:36:47", "text": "よし、それは良いことだ。"}, {"type": "subtitle", "time": 5810.47, "timestamp": "01:36:50", "text": "あちらで何が起こったのかは知らないが、"}, {"type": "subtitle", "time": 5818.07, "timestamp": "01:36:58", "text": "皆さん、おかえりなさい。"}]
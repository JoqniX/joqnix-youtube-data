[{"type": "subtitle", "time": 19682.708, "timestamp": "05:28:02", "text": "Instagramにも行ったし、TikTokにも行った。"}, {"type": "subtitle", "time": 19686.23, "timestamp": "05:28:06", "text": "同じように。 TikTokでストリーミング配信を試してみました。それ"}, {"type": "subtitle", "time": 19686.788, "timestamp": "05:28:06", "text": "音楽だった"}, {"type": "subtitle", "time": 19689.43, "timestamp": "05:28:09", "text": "面倒くさい。でも、これらの垂直の流れは"}, {"type": "subtitle", "time": 19692.07, "timestamp": "05:28:12", "text": "以前はInstagramを利用していました"}, {"type": "subtitle", "time": 19695.03, "timestamp": "05:28:15", "text": "えっと、YouTubeの映像。何チャンネルと"}, {"type": "subtitle", "time": 19698.07, "timestamp": "05:28:18", "text": "TikTokにもいくつかあります。では、"}, {"type": "subtitle", "time": 19700.708, "timestamp": "05:28:20", "text": "それ以外？そしてツイッター。"}, {"type": "subtitle", "time": 19703.43, "timestamp": "05:28:23", "text": "そう、TwitterはTwitterだった"}, {"type": "subtitle", "time": 19705.59, "timestamp": "05:28:25", "text": "水平。そしてキックがあった"}, {"type": "subtitle", "time": 19707.75, "timestamp": "05:28:27", "text": "水平。トゥイッチは水平に動いていた。"}, {"type": "subtitle", "time": 19709.99, "timestamp": "05:28:29", "text": "YouTubeはそこにあった。そしてFacebookは"}, {"type": "subtitle", "time": 19712.628, "timestamp": "05:28:32", "text": "水平方向。そう、あの時私は"}, {"type": "subtitle", "time": 19715.51, "timestamp": "05:28:35", "text": "デュアルPC構成だった。"}, {"type": "subtitle", "time": 19717.75, "timestamp": "05:28:37", "text": "私がこれらすべてをしている間、"}, {"type": "subtitle", "time": 19720.868, "timestamp": "05:28:40", "text": "この垂直エンコードセッション全体と"}, {"type": "subtitle", "time": 19724.31, "timestamp": "05:28:44", "text": "水平方向はストリームPCで行われました。"}, {"type": "subtitle", "time": 19726.39, "timestamp": "05:28:46", "text": "つまり、私が今持っているこのPCのことです"}, {"type": "subtitle", "time": 19729.75, "timestamp": "05:28:49", "text": "今。それ以来、私のゲーム用PCは壊れてしまいました。だから私は"}, {"type": "subtitle", "time": 19734.948, "timestamp": "05:28:54", "text": "えっと、もうそれはできない"}, {"type": "chat", "time": 19736.864, "timestamp": "05:28:56", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "@sarthak sharma yes he is the guy"}, {"type": "subtitle", "time": 19738.788, "timestamp": "05:28:58", "text": "CPU使用率が高いためです。いいえ。"}]
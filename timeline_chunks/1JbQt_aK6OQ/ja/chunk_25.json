[{"type": "subtitle", "time": 1501.83, "timestamp": "00:25:01", "text": "私のPCに接続しようとしていますか？一体どういうことだ？"}, {"type": "subtitle", "time": 1504.07, "timestamp": "00:25:04", "text": "え、何？"}, {"type": "subtitle", "time": 1506.63, "timestamp": "00:25:06", "text": "あぁ、私のページへの接続をやめてください。おお、"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "これは何ですか？これは誰ですか？ A34。"}, {"type": "subtitle", "time": 1517.669, "timestamp": "00:25:17", "text": "これは誰の携帯電話ですか？私はインドにはいません。私"}, {"type": "subtitle", "time": 1522.95, "timestamp": "00:25:22", "text": "来年3月しか日本に行けない"}, {"type": "subtitle", "time": 1525.11, "timestamp": "00:25:25", "text": "戦争の出来事が今起こった。インド パキスタン"}, {"type": "subtitle", "time": 1527.909, "timestamp": "00:25:27", "text": "そのため、彼らはすべてを放火した"}, {"type": "subtitle", "time": 1529.909, "timestamp": "00:25:29", "text": "すべての"}, {"type": "subtitle", "time": 1532.07, "timestamp": "00:25:32", "text": "インド人学生が日本に行くのを阻止したり、"}, {"type": "subtitle", "time": 1537.269, "timestamp": "00:25:37", "text": "移民関係の何かで、えっと"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "今月は日本にいるはずだった"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "2つ目に、これは私が"}, {"type": "subtitle", "time": 1545.51, "timestamp": "00:25:45", "text": "日本だけど、できなかった"}, {"type": "subtitle", "time": 1548.47, "timestamp": "00:25:48", "text": "でも、来年の3月には私もそこにいますよ"}, {"type": "subtitle", "time": 1550.95, "timestamp": "00:25:50", "text": "えっと、3月末には行かなきゃいけないんです。"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "何があっても、その頃には私は終わっているだろう"}, {"type": "subtitle", "time": 1557.029, "timestamp": "00:25:57", "text": "N4 4で。そう、N4とN3ですね。それで、"}, {"type": "subtitle", "time": 1559.75, "timestamp": "00:25:59", "text": "うん。ええ、銀行に預金しました"}]
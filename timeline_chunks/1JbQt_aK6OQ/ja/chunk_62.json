[{"type": "subtitle", "time": 3725.91, "timestamp": "01:02:05", "text": "わかった。衰退の波、再生、真空"}, {"type": "subtitle", "time": 3729.67, "timestamp": "01:02:09", "text": "クリーナー、プロジェクトキャンバス、鶏の世話、"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "森、"}, {"type": "subtitle", "time": 3734.309, "timestamp": "01:02:14", "text": "枯れゆく波、"}, {"type": "subtitle", "time": 3735.91, "timestamp": "01:02:15", "text": "枯れていく"}, {"type": "subtitle", "time": 3745.75, "timestamp": "01:02:25", "text": "こんにちは、タキサさん。ようこそ。こんばんは。"}, {"type": "subtitle", "time": 3748.87, "timestamp": "01:02:28", "text": "はい、画像を保存します。"}, {"type": "subtitle", "time": 3756.23, "timestamp": "01:02:36", "text": "それを保存しておいて。"}, {"type": "subtitle", "time": 3758.309, "timestamp": "01:02:38", "text": "天候は浸かって、ストレノバも。右。"}, {"type": "subtitle", "time": 3761.589, "timestamp": "01:02:41", "text": "ストレートノア。"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "病気"}]
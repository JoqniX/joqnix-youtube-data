[{"type": "subtitle", "time": 6962.629, "timestamp": "01:56:02", "text": "2021年が来ることを願います。"}, {"type": "subtitle", "time": 6988.39, "timestamp": "01:56:28", "text": "2021年。古いゲームを多数表示する。私はそれをプレイしました"}, {"type": "subtitle", "time": 6993.189, "timestamp": "01:56:33", "text": "2021年に。え？いいえ、私は2021年のすべてのゲームをプレイします"}, {"type": "subtitle", "time": 6995.669, "timestamp": "01:56:35", "text": "ゲーム。私は2024年にそれをプレイしました。"}, {"type": "subtitle", "time": 6999.99, "timestamp": "01:56:39", "text": "それはとても素晴らしいですね。いつプレイしたっけ？"}, {"type": "subtitle", "time": 7009.51, "timestamp": "01:56:49", "text": "私はこれが好きだ。次はエコー・ノヴァです。"}, {"type": "subtitle", "time": 7013.35, "timestamp": "01:56:53", "text": "これも楽しかったのを覚えています"}]
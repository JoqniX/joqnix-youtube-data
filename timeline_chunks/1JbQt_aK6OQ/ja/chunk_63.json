[{"type": "subtitle", "time": 3783.349, "timestamp": "01:03:03", "text": "えっと、他に何かありますか？"}, {"type": "subtitle", "time": 3787.91, "timestamp": "01:03:07", "text": "ええと、掃除機戦士。"}, {"type": "subtitle", "time": 3790.47, "timestamp": "01:03:10", "text": "ああ、そのゲームは一度もプレイしたことがない。"}, {"type": "subtitle", "time": 3794.71, "timestamp": "01:03:14", "text": "以来。いいえ。真空"}, {"type": "subtitle", "time": 3803.99, "timestamp": "01:03:23", "text": "ああ、彼らにはそれがないんだ。私は覚えています"}, {"type": "subtitle", "time": 3812.63, "timestamp": "01:03:32", "text": "O"}, {"type": "subtitle", "time": 3817.91, "timestamp": "01:03:37", "text": "えーと、真空戦士"}, {"type": "subtitle", "time": 3820.23, "timestamp": "01:03:40", "text": "ゲーム。"}, {"type": "subtitle", "time": 3823.99, "timestamp": "01:03:43", "text": "すると、このような画像が得られます。"}, {"type": "subtitle", "time": 3826.39, "timestamp": "01:03:46", "text": "うん、これでうまくいくよ。"}, {"type": "subtitle", "time": 3829.818, "timestamp": "01:03:49", "text": "この画像で大丈夫です。"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "私は思う。ええ、これで十分でしょう。"}, {"type": "subtitle", "time": 3838.789, "timestamp": "01:03:58", "text": "わかった。保存"}]
[{"type": "subtitle", "time": 10980.95, "timestamp": "03:03:00", "text": "だって、私は彼女にゲームを買ってあげたと思うから"}, {"type": "subtitle", "time": 10983.83, "timestamp": "03:03:03", "text": "戻る。それで彼女は「ええ、何が"}, {"type": "subtitle", "time": 10992.95, "timestamp": "03:03:12", "text": "[咳払いをする]"}, {"type": "subtitle", "time": 10994.63, "timestamp": "03:03:14", "text": "BPM？"}, {"type": "subtitle", "time": 10996.63, "timestamp": "03:03:16", "text": "スターフィールド。"}, {"type": "subtitle", "time": 10999.83, "timestamp": "03:03:19", "text": "私はこのゲームを止めた。誰が覚えているだろうか"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "スターフィールド？私はとても多くのことをしていました"}, {"type": "subtitle", "time": 11005.03, "timestamp": "03:03:25", "text": "不具合、"}, {"type": "subtitle", "time": 11009.67, "timestamp": "03:03:29", "text": "兄弟。何てことだ。私はたくさんのことをしていました"}, {"type": "subtitle", "time": 11018.63, "timestamp": "03:03:38", "text": "私は鉱物を売って何百万ドルも稼いでいた"}, {"type": "subtitle", "time": 11022.469, "timestamp": "03:03:42", "text": "銅、金、その他諸々。えっと"}, {"type": "subtitle", "time": 11024.71, "timestamp": "03:03:44", "text": "ああ、今でも覚えているよ。ああ、"}, {"type": "subtitle", "time": 11031.03, "timestamp": "03:03:51", "text": "実際にはキャンセルしました。私は落とした"}]
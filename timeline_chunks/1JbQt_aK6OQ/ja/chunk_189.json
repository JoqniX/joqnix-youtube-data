[{"type": "subtitle", "time": 11343.51, "timestamp": "03:09:03", "text": "こんにちは、ホグワーツまで終わりました。"}, {"type": "subtitle", "time": 11346.309, "timestamp": "03:09:06", "text": "麻雀ソウルハイのライブ配信。終わった"}, {"type": "subtitle", "time": 11347.83, "timestamp": "03:09:07", "text": "それ。それを乗り越える。私はまだ"}, {"type": "subtitle", "time": 11350.87, "timestamp": "03:09:10", "text": "もう完全に乗り越えなさい。ストリームが必要"}, {"type": "subtitle", "time": 11353.99, "timestamp": "03:09:13", "text": "支配者。落としました。いいえ、もう終わりました。"}, {"type": "subtitle", "time": 11357.67, "timestamp": "03:09:17", "text": "ダカン、落としちゃったよ。ハンカの影響"}, {"type": "subtitle", "time": 11361.11, "timestamp": "03:09:21", "text": "所有。フォールガイズ。タジオ・アモング・アス"}, {"type": "subtitle", "time": 11367.19, "timestamp": "03:09:27", "text": "猫がきちんと並んでいます。終わったよ。"}, {"type": "subtitle", "time": 11370.15, "timestamp": "03:09:30", "text": "ウォーハンマーはそれを廃止した。トルムはそれを落とした。"}, {"type": "subtitle", "time": 11372.87, "timestamp": "03:09:32", "text": "飛行隊。うん、私がそれを手に入れるまで"}, {"type": "subtitle", "time": 11375.59, "timestamp": "03:09:35", "text": "そこには。"}, {"type": "subtitle", "time": 11385.75, "timestamp": "03:09:45", "text": "私がプレイしたゲームの数"}, {"type": "subtitle", "time": 11394.309, "timestamp": "03:09:54", "text": "きっとそうだろう"}]
[{"type": "subtitle", "time": 17413.83, "timestamp": "04:50:13", "text": "さて、次はランブル・ウィッシュです。"}, {"type": "subtitle", "time": 17416.628, "timestamp": "04:50:16", "text": "このゲームは死んで、彼らは"}, {"type": "subtitle", "time": 17419.19, "timestamp": "04:50:19", "text": "このゲームの開発。彼らはそれを奪った"}, {"type": "subtitle", "time": 17420.948, "timestamp": "04:50:20", "text": "下。"}, {"type": "subtitle", "time": 17424.07, "timestamp": "04:50:24", "text": "悲しかった。少なくとも1つ持っていてよかった"}, {"type": "subtitle", "time": 17425.75, "timestamp": "04:50:25", "text": "このストリーム。私たちはゲームを終えました。"}, {"type": "subtitle", "time": 17428.788, "timestamp": "04:50:28", "text": "あまりにも。それはバトルロイヤルゲームだった。本当に"}, {"type": "subtitle", "time": 17430.948, "timestamp": "04:50:30", "text": "楽しいゲームだったけどね。"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "でも、それがなくなってしまったのは残念だ。 [音楽]"}, {"type": "subtitle", "time": 17437.27, "timestamp": "04:50:37", "text": "シーズン2があり、"}, {"type": "subtitle", "time": 17440.788, "timestamp": "04:50:40", "text": "しかし、それくらいです。"}]
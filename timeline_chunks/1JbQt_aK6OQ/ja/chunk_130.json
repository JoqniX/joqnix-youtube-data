[{"type": "subtitle", "time": 7812.79, "timestamp": "02:10:12", "text": "そして"}, {"type": "subtitle", "time": 7819.75, "timestamp": "02:10:19", "text": "コンテンツ警告が非公開になる期間はどれくらいですか？"}, {"type": "subtitle", "time": 7824.069, "timestamp": "02:10:24", "text": "これらすべてが追加された。ああ、わかった。"}, {"type": "subtitle", "time": 7826.069, "timestamp": "02:10:26", "text": "むさぼり食う、"}, {"type": "subtitle", "time": 7829.669, "timestamp": "02:10:29", "text": "チラザード、パラソショー、モダン・ウォーフェア"}, {"type": "subtitle", "time": 7833.99, "timestamp": "02:10:33", "text": "3、BPM、カウンターストライク、"}, {"type": "subtitle", "time": 7837.35, "timestamp": "02:10:37", "text": "PUBG、つまりスピード・アンバウンドはスキップした。"}, {"type": "subtitle", "time": 7840.47, "timestamp": "02:10:40", "text": "スターフィールドはプレイしませんでした。えーと、ハルク化した、"}, {"type": "subtitle", "time": 7843.669, "timestamp": "02:10:43", "text": "彼らはそれをスキップした。いや、くそ、終わらせた。"}, {"type": "subtitle", "time": 7847.83, "timestamp": "02:10:47", "text": "アイドルショット、保留中。えっと、ナカラ"}, {"type": "subtitle", "time": 7849.83, "timestamp": "02:10:49", "text": "キャンセル。"}, {"type": "subtitle", "time": 7854.79, "timestamp": "02:10:54", "text": "保留中。保留中。"}, {"type": "subtitle", "time": 7858.55, "timestamp": "02:10:58", "text": "ブループロトコルは結局実現しなかった。"}]
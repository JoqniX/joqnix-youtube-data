text": "えっと"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "そして、あなたのウェブサイトでは、"}, {"type": "subtitle", "time": 16559.91, "timestamp": "04:35:59", "text": "新しいページを作成中です。"}]
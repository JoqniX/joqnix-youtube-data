[{"type": "subtitle", "time": 14541.11, "timestamp": "04:02:21", "text": "原神の配信が34回。私たちはそうします"}, {"type": "subtitle", "time": 14550.469, "timestamp": "04:02:30", "text": "今は、私は自分の"}, {"type": "subtitle", "time": 14553.67, "timestamp": "04:02:33", "text": "今はプレイリストを作成中です。だから私はそうすることができる"}, {"type": "subtitle", "time": 14556.79, "timestamp": "04:02:36", "text": "またまた、何度も。"}, {"type": "subtitle", "time": 14559.189, "timestamp": "04:02:39", "text": "マネール、もし私がこのゲームをクリアしたら"}, {"type": "subtitle", "time": 14561.269, "timestamp": "04:02:41", "text": "正しい。"}]
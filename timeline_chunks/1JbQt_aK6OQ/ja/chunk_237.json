[{"type": "subtitle", "time": 14227.429, "timestamp": "03:57:07", "text": "完了状況を判断するのは難しい"}, {"type": "subtitle", "time": 14235.91, "timestamp": "03:57:15", "text": "でもシングルプレイヤーもプレイしました"}, {"type": "subtitle", "time": 14242.15, "timestamp": "03:57:22", "text": "えっと"}, {"type": "subtitle", "time": 14246.63, "timestamp": "03:57:26", "text": "キャンペーン、あるいは何であれ、"}, {"type": "subtitle", "time": 14271.03, "timestamp": "03:57:51", "text": "ああ、本当に久しぶりだ。あなたを見た"}, {"type": "subtitle", "time": 14273.429, "timestamp": "03:57:53", "text": "最後にあなたに会ってから。生活はどうでしたか？おお"}, {"type": "subtitle", "time": 14275.879, "timestamp": "03:57:55", "text": "神。私がこれを初めてプレイしたのはいつだったかな？ 2022年。"}]
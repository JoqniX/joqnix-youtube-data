[{"type": "subtitle", "time": 4921.91, "timestamp": "01:22:01", "text": "えっと、"}, {"type": "subtitle", "time": 4924.07, "timestamp": "01:22:04", "text": "保管場所のアイデアがあります。"}, {"type": "subtitle", "time": 4925.59, "timestamp": "01:22:05", "text": "1秒。わかった。あなたは見ないでしょう"}, {"type": "subtitle", "time": 4928.87, "timestamp": "01:22:08", "text": "一瞬でもいいから何でもいい。 1秒。 1つ"}, {"type": "subtitle", "time": 4948.229, "timestamp": "01:22:28", "text": "もう片方は削除できます。"}, {"type": "subtitle", "time": 4950.87, "timestamp": "01:22:30", "text": "それで十分でしょうか？良いと思います"}, {"type": "subtitle", "time": 4962.149, "timestamp": "01:22:42", "text": "ええ、そうですね、私たちはすべてを追加しています"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "私が以前プレイしたゲームは"}, {"type": "subtitle", "time": 4967.27, "timestamp": "01:22:47", "text": "ウェブサイトをカテゴリとして扱う。 [音楽] うーん"}, {"type": "subtitle", "time": 4969.669, "timestamp": "01:22:49", "text": "だから、みんなが知りたいのは"}, {"type": "subtitle", "time": 4971.91, "timestamp": "01:22:51", "text": "私がプレイしたゲーム、私がプレイしたすべてのゲーム"}, {"type": "subtitle", "time": 4973.99, "timestamp": "01:22:53", "text": "遊びたいゲームは、"}, {"type": "subtitle", "time": 4976.629, "timestamp": "01:22:56", "text": "ドロップした、私がキャンセルしたすべてのゲーム、ええと"}, {"type": "subtitle", "time": 4978.55, "timestamp": "01:22:58", "text": "私がクリアしたすべてのゲームは、"}]
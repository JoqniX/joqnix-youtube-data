[{"type": "subtitle", "time": 18124.31, "timestamp": "05:02:04", "text": "そして最後にやらなければならないことは"}, {"type": "subtitle", "time": 18134.39, "timestamp": "05:02:14", "text": "よし、ちょっと待ってくれ。削除しなければならない"}, {"type": "subtitle", "time": 18137.59, "timestamp": "05:02:17", "text": "あなたから"}, {"type": "subtitle", "time": 18144.39, "timestamp": "05:02:24", "text": "古いカードみたいなやつ？私たちはあなたを必要としていません"}, {"type": "subtitle", "time": 18152.07, "timestamp": "05:02:32", "text": "よし、これは保留中だよね？私たちは作ります"}, {"type": "subtitle", "time": 18171.51, "timestamp": "05:02:51", "text": "[咳]"}, {"type": "subtitle", "time": 18175.03, "timestamp": "05:02:55", "text": "つまり、人々はすべての"}, {"type": "subtitle", "time": 18177.51, "timestamp": "05:02:57", "text": "私がプレイしたゲーム。クリックできます"}, {"type": "subtitle", "time": 18179.67, "timestamp": "05:02:59", "text": "プレイリストを見ると、私の評価が確認できます。"}]
[{"type": "subtitle", "time": 14100.07, "timestamp": "03:55:00", "text": "うん。私の足が電線に触れて"}, {"type": "chat", "time": 14103.934, "timestamp": "03:55:03", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "your feet?"}, {"type": "subtitle", "time": 14112.79, "timestamp": "03:55:12", "text": "えっと、私はパソコンを机の下に置いています。いいえ。"}, {"type": "subtitle", "time": 14116.79, "timestamp": "03:55:16", "text": "ええと、だから私の配線設定はすべて"}, {"type": "subtitle", "time": 14120.07, "timestamp": "03:55:20", "text": "私の机の下にあります。だから私はPCをそのままにしておいた"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "下。だから、私がうっかり"}, {"type": "subtitle", "time": 14126.309, "timestamp": "03:55:26", "text": "足を伸ばしたら、パワーに触れた"}, {"type": "subtitle", "time": 14129.189, "timestamp": "03:55:29", "text": "ケーブルが文字通りオフになった"}, {"type": "subtitle", "time": 14132.229, "timestamp": "03:55:32", "text": "PC全体。再接続する必要がある"}, {"type": "subtitle", "time": 14135.03, "timestamp": "03:55:35", "text": "少し振ってパワーを与えて"}, {"type": "subtitle", "time": 14139.269, "timestamp": "03:55:39", "text": "電源を入れるとか、そういうこと全部です。"}, {"type": "subtitle", "time": 14141.91, "timestamp": "03:55:41", "text": "そして、まさにその通りになった。"}, {"type": "subtitle", "time": 14144.55, "timestamp": "03:55:44", "text": "しかも、今は午後11時です。これを終わらせます"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "そして、寝なさい。わかった。本当に遅い時間だ"}, {"type": "subtitle", "time": 14151.269, "timestamp": "03:55:51", "text": "そして、私はまだ病気です。私は取るべき"}, {"type": "subtitle", "time": 14153.67, "timestamp": "03:55:53", "text": "休む。"}]
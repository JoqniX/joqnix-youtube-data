[{"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "今日。アプリを設定しました。待たなければならなかった"}, {"type": "subtitle", "time": 1565.59, "timestamp": "00:26:05", "text": "彼らが私にアクティベーションを与えるために"}, {"type": "subtitle", "time": 1569.029, "timestamp": "00:26:09", "text": "トークンなど。それで、アプリをセットアップしました。"}, {"type": "subtitle", "time": 1573.909, "timestamp": "00:26:13", "text": "UPI。今私が後悔しているのはただ一つ"}, {"type": "subtitle", "time": 1576.549, "timestamp": "00:26:16", "text": "ここで唯一後悔しているのは、"}, {"type": "subtitle", "time": 1579.909, "timestamp": "00:26:19", "text": "今ならわかる、彼らはこのビジネスを"}, {"type": "subtitle", "time": 1584.07, "timestamp": "00:26:24", "text": "「次へ」の前にドットを付けます。最初は"}, {"type": "subtitle", "time": 1588.87, "timestamp": "00:26:28", "text": "FPLのジョックニックスのように、"}, {"type": "subtitle", "time": 1593.19, "timestamp": "00:26:33", "text": "でも、私が試してみたら、彼らも数字を載せてきたんです。"}, {"type": "subtitle", "time": 1595.029, "timestamp": "00:26:35", "text": "設定するオプションがありません"}, {"type": "subtitle", "time": 1599.35, "timestamp": "00:26:39", "text": "カスタムUPI ID。それもまた、"}, {"type": "subtitle", "time": 1603.669, "timestamp": "00:26:43", "text": "残念だ。普通の人のための普通のアプリ"}, {"type": "subtitle", "time": 1607.269, "timestamp": "00:26:47", "text": "その銀行、そのアプリでは選択できます"}, {"type": "subtitle", "time": 1611.43, "timestamp": "00:26:51", "text": "あなたのUPI IDですが、ビジネスバージョンです"}, {"type": "subtitle", "time": 1614.31, "timestamp": "00:26:54", "text": "その連邦協同組合アプリでは、"}, {"type": "subtitle", "time": 1617.669, "timestamp": "00:26:57", "text": "選ぶ。最初は8くらいだった"}]
[{"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "2年前。聖なる神よ。"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "私はただプレイをやめただけです。"}, {"type": "subtitle", "time": 11966.87, "timestamp": "03:19:26", "text": "私たちは、"}, {"type": "subtitle", "time": 11974.55, "timestamp": "03:19:34", "text": "きちんと整理されていますね。完了しました"}, {"type": "subtitle", "time": 11983.59, "timestamp": "03:19:43", "text": "史上最高のゲーム。"}, {"type": "subtitle", "time": 11987.269, "timestamp": "03:19:47", "text": "最初にプレイしてネオニアンになった"}, {"type": "subtitle", "time": 11998.229, "timestamp": "03:19:58", "text": "私は犬と遊びたい イタリア"}]
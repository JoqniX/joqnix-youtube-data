[{"type": "subtitle", "time": 4503.189, "timestamp": "01:15:03", "text": "さて、ここから先は内容に関する警告です。地獄の潜水夫が死亡"}, {"type": "subtitle", "time": 4504.79, "timestamp": "01:15:04", "text": "島"}, {"type": "subtitle", "time": 4507.83, "timestamp": "01:15:07", "text": "戦闘から除隊した。"}, {"type": "subtitle", "time": 4516.709, "timestamp": "01:15:16", "text": "戦闘の達人は鋼鉄の反響点を避ける"}, {"type": "subtitle", "time": 4525.59, "timestamp": "01:15:25", "text": "リーサル・カンパニー・モンキー・パーティ・ハーフソード"}, {"type": "subtitle", "time": 4529.99, "timestamp": "01:15:29", "text": "そして期末試験はその分だけ負担が増える可能性がある。わかった。"}, {"type": "subtitle", "time": 4537.75, "timestamp": "01:15:37", "text": "森の息子たち。"}, {"type": "subtitle", "time": 4540.55, "timestamp": "01:15:40", "text": "それも付け加えたい"}, {"type": "subtitle", "time": 4545.189, "timestamp": "01:15:45", "text": "なぜなら、これは私がプレイしたいゲームだからです。"}]
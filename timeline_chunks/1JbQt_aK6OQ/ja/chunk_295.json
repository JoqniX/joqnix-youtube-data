[{"type": "subtitle", "time": 17701.99, "timestamp": "04:55:01", "text": "いいえ、"}, {"type": "subtitle", "time": 17747.43, "timestamp": "04:55:47", "text": "よし、ニックの件はこれで終わりだ。最後の一つは"}, {"type": "subtitle", "time": 17750.23, "timestamp": "04:55:50", "text": "錆。私が本当にプレイしたいゲーム"}, {"type": "subtitle", "time": 17753.03, "timestamp": "04:55:53", "text": "他の人たちと一緒にいるが、誰も遊んでいない。私は"}]
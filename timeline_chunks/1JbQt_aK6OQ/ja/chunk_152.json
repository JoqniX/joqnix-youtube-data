[{"type": "subtitle", "time": 9126.63, "timestamp": "02:32:06", "text": "これはゲームの完全なリニューアルです。"}, {"type": "subtitle", "time": 9129.485, "timestamp": "02:32:09", "text": "ええ、私はこれを待っています。"}, {"type": "subtitle", "time": 9131.429, "timestamp": "02:32:11", "text": "[笑い]"}, {"type": "subtitle", "time": 9138.23, "timestamp": "02:32:18", "text": "私は待っています。史上最高のゲーム。今行ってる。"}, {"type": "subtitle", "time": 9141.275, "timestamp": "02:32:21", "text": "早く実現してほしい。まあ、2023年ですね。"}, {"type": "subtitle", "time": 9141.99, "timestamp": "02:32:21", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 9144.389, "timestamp": "02:32:24", "text": "プレイしました。完了しました。私は思う"}, {"type": "subtitle", "time": 9147.51, "timestamp": "02:32:27", "text": "完了したとみなしても良いでしょう。いいえ、私は"}, {"type": "subtitle", "time": 9179.91, "timestamp": "02:32:59", "text": "[鼻を鳴らす]"}]
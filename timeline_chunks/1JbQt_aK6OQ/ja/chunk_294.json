[{"type": "subtitle", "time": 17650.39, "timestamp": "04:54:10", "text": "私の配信には遅延はありませんよね？"}, {"type": "subtitle", "time": 17654.23, "timestamp": "04:54:14", "text": "二重チェック。はい、低遅延です。"}, {"type": "subtitle", "time": 17671.19, "timestamp": "04:54:31", "text": "そして2年前、私はそれをストリーミングで視聴しました"}, {"type": "subtitle", "time": 17686.39, "timestamp": "04:54:46", "text": "ニック女神の勝利"}, {"type": "subtitle", "time": 17689.27, "timestamp": "04:54:49", "text": "女神 このゲームをプレイしたことがない"}, {"type": "subtitle", "time": 17693.51, "timestamp": "04:54:53", "text": "それ以来、私はたった1回しか配信していません。"}, {"type": "subtitle", "time": 17696.31, "timestamp": "04:54:56", "text": "ただそれは３時間もかかるんだ。ああ、神様、私は決して"}, {"type": "subtitle", "time": 17699.43, "timestamp": "04:54:59", "text": "このゲームに触れた。はぁ？"}]
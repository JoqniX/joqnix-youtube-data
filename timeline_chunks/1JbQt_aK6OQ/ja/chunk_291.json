[{"type": "subtitle", "time": 17462.628, "timestamp": "04:51:02", "text": "えーと"}, {"type": "subtitle", "time": 17465.19, "timestamp": "04:51:05", "text": "最後に配信したのはいつだったっけ？ 2年"}, {"type": "subtitle", "time": 17467.51, "timestamp": "04:51:07", "text": "戻る、ですよね？"}, {"type": "subtitle", "time": 17478.948, "timestamp": "04:51:18", "text": "わかった。私たちはもうすぐ"}, {"type": "subtitle", "time": 17481.11, "timestamp": "04:51:21", "text": "終わり。そしてついに"}, {"type": "subtitle", "time": 17485.11, "timestamp": "04:51:25", "text": "宇宙ステーションの整備を完了する。ああ、そうだね"}, {"type": "subtitle", "time": 17488.39, "timestamp": "04:51:28", "text": "Space Stationは絶対にプレイしないでください。"}, {"type": "subtitle", "time": 17492.15, "timestamp": "04:51:32", "text": "うーん、これに関しては嫌な思い出があるんです。"}, {"type": "subtitle", "time": 17494.39, "timestamp": "04:51:34", "text": "むしろ私は同調圧力に負けた"}, {"type": "subtitle", "time": 17497.11, "timestamp": "04:51:37", "text": "ロシアのV2、ロシアの視聴者"}, {"type": "subtitle", "time": 17499.91, "timestamp": "04:51:39", "text": "その頃には到着していた。えっと、彼らはたまたま"}, {"type": "subtitle", "time": 17503.11, "timestamp": "04:51:43", "text": "彼らはたまたまトキシキを手に入れた。"}, {"type": "subtitle", "time": 17505.35, "timestamp": "04:51:45", "text": "私たちはもう話さない。でも、そうだね。"}, {"type": "subtitle", "time": 17508.07, "timestamp": "04:51:48", "text": "彼らが私を連れてきたんです"}, {"type": "subtitle", "time": 17512.708, "timestamp": "04:51:52", "text": "このゲームとこのゲームの間、兄弟、"}, {"type": "subtitle", "time": 17516.23, "timestamp": "04:51:56", "text": "ぞっとするような場面がたくさんあった。"}, {"type": "subtitle", "time": 17517.75, "timestamp": "04:51:57", "text": "神、"}, {"type": "subtitle", "time": 17519.67, "timestamp": "04:51:59", "text": "私が知っている役割はロールプレイングです"}]
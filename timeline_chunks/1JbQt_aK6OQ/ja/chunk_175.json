[{"type": "subtitle", "time": 10505.03, "timestamp": "02:55:05", "text": "そもそもなぜ私はそれを買ったのだろうか？私"}, {"type": "subtitle", "time": 10518.95, "timestamp": "02:55:18", "text": "行かなければ海賊版をダウンロードできたのに"}, {"type": "subtitle", "time": 10523.11, "timestamp": "02:55:23", "text": "再生するために。私はしません"}, {"type": "subtitle", "time": 10528.581, "timestamp": "02:55:28", "text": "配信でご覧ください。うわー、すごいね。"}, {"type": "subtitle", "time": 10530.55, "timestamp": "02:55:30", "text": "[笑い]"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "[咳払い]"}]
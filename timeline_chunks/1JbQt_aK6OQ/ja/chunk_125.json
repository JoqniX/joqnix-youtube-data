[{"type": "subtitle", "time": 7516.709, "timestamp": "02:05:16", "text": "猿のパーティー。"}, {"type": "subtitle", "time": 7519.83, "timestamp": "02:05:19", "text": "えーっと、これは本当に楽しかったよ。"}, {"type": "subtitle", "time": 7522.87, "timestamp": "02:05:22", "text": "ハッケンスラッシュ"}, {"type": "subtitle", "time": 7531.91, "timestamp": "02:05:31", "text": "いや、遅延なんて言わないでくれ。"}, {"type": "subtitle", "time": 7534.79, "timestamp": "02:05:34", "text": "待って、待って、どれだったっけ？はい、"}, {"type": "subtitle", "time": 7537.43, "timestamp": "02:05:37", "text": "遅延なし。はい、はい、はい。ああ、やめて"}, {"type": "subtitle", "time": 7547.75, "timestamp": "02:05:47", "text": "ここにコピーして貼り付けてください。"}, {"type": "subtitle", "time": 7550.55, "timestamp": "02:05:50", "text": "半分の剣。彼らはベータ版を探していた"}, {"type": "subtitle", "time": 7554.149, "timestamp": "02:05:54", "text": "テスターたちと私は率先して行動した。"}, {"type": "subtitle", "time": 7556.229, "timestamp": "02:05:56", "text": "とても良かったです。そして開発者たち"}, {"type": "subtitle", "time": 7559.669, "timestamp": "02:05:59", "text": "半分を作った人たちもやってきた"}]
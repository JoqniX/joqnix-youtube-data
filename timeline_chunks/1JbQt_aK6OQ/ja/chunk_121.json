[{"type": "subtitle", "time": 7261.83, "timestamp": "02:01:01", "text": "INV塊茎。いいえ、彼らは彼らは彼らは"}, {"type": "subtitle", "time": 7264.39, "timestamp": "02:01:04", "text": "まるで致命的な会社の会議のように"}, {"type": "subtitle", "time": 7268.07, "timestamp": "02:01:08", "text": "毎晩9時か10時頃に音楽が流れる"}, {"type": "subtitle", "time": 7270.55, "timestamp": "02:01:10", "text": "神話級のプレイヤーも、みんな同じようにやっている。"}, {"type": "subtitle", "time": 7273.35, "timestamp": "02:01:13", "text": "だから私は以前、ヴィックと一緒に参加していました。これは"}, {"type": "subtitle", "time": 7277.03, "timestamp": "02:01:17", "text": "私が配信したのはこれだけです。私は信じている"}, {"type": "subtitle", "time": 7280.07, "timestamp": "02:01:20", "text": "今までで一番まともな配信だった。私は思う"}, {"type": "subtitle", "time": 7283.35, "timestamp": "02:01:23", "text": "他の人の配信に参加しました"}, {"type": "subtitle", "time": 7286.629, "timestamp": "02:01:26", "text": "たいてい。これって2023年頃の話だよね？うん、"}, {"type": "subtitle", "time": 7291.109, "timestamp": "02:01:31", "text": "2023年のことでした。それで、2023年にプレイして、"}, {"type": "subtitle", "time": 7295.83, "timestamp": "02:01:35", "text": "リーサル・カンパニーが発売されたのは"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "えーと、リーサル・カンパニーが発売された"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "私たちは2023年にできる。"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "2023年ですね。ええ。同じ年ですよね？私たちは"}, {"type": "subtitle", "time": 7312.07, "timestamp": "02:01:52", "text": "次のようなゲームを待つことができますか"}, {"type": "subtitle", "time": 7314.229, "timestamp": "02:01:54", "text": "マルチプレイヤーでは、参加して"}, {"type": "subtitle", "time": 7316.39, "timestamp": "02:01:56", "text": "もの。何を書けばいいですか？入れるべきでしょうか"}]
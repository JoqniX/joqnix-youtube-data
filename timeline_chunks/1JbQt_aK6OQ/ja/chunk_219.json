[{"type": "subtitle", "time": 13141.349, "timestamp": "03:39:01", "text": "ああ、君が恋しいよ。彼らはこれを止めた"}, {"type": "subtitle", "time": 13145.03, "timestamp": "03:39:05", "text": "ゲームは永遠に続くよ、マジで。なぜ？サイクル・フロンティア"}, {"type": "subtitle", "time": 13146.95, "timestamp": "03:39:06", "text": "とても良かった。私がプレイしたのはこれが初めてでした"}]
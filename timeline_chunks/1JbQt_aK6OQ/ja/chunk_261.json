[{"type": "subtitle", "time": 15660.319, "timestamp": "04:21:00", "text": "遠い未来。 それはいいですね。はぁ？"}, {"type": "subtitle", "time": 15673.99, "timestamp": "04:21:13", "text": "眠りの中で"}, {"type": "subtitle", "time": 15683.83, "timestamp": "04:21:23", "text": "私たちは「炎のパス」を終えました"}, {"type": "subtitle", "time": 15685.99, "timestamp": "04:21:25", "text": "戻る。"}, {"type": "subtitle", "time": 15688.95, "timestamp": "04:21:28", "text": "マスコット。まだ決まっていない。そうではありません"}, {"type": "subtitle", "time": 15692.309, "timestamp": "04:21:32", "text": "決めた。いいえ、私たちはそれを確認していません。私たちは"}, {"type": "chat", "time": 15692.486, "timestamp": "04:21:32", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "so what your mascot? stars?"}, {"type": "subtitle", "time": 15694.55, "timestamp": "04:21:34", "text": "絶対にない"}, {"type": "subtitle", "time": 15698.469, "timestamp": "04:21:38", "text": "まだ正式には決定していません"}, {"type": "subtitle", "time": 15700.63, "timestamp": "04:21:40", "text": "これまで。"}, {"type": "subtitle", "time": 15703.429, "timestamp": "04:21:43", "text": "だから、ある意味、私にはマスコットはいないんです"}, {"type": "subtitle", "time": 15705.83, "timestamp": "04:21:45", "text": "まだキャラクターがいない。"}, {"type": "subtitle", "time": 15709.59, "timestamp": "04:21:49", "text": "さっきも言ったように、えっと、まだ"}, {"type": "subtitle", "time": 15713.189, "timestamp": "04:21:53", "text": "マスコットとして何が欲しいか考えている"}, {"type": "subtitle", "time": 15715.349, "timestamp": "04:21:55", "text": "キャラクター。"}, {"type": "subtitle", "time": 15719.67, "timestamp": "04:21:59", "text": "私は天体のようなアイデアを思いつきました"}]
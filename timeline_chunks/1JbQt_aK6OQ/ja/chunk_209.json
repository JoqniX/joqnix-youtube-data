[{"type": "subtitle", "time": 12562.71, "timestamp": "03:29:22", "text": "最初にストリーミングしたとき"}, {"type": "subtitle", "time": 12570.469, "timestamp": "03:29:30", "text": "最高のゲームで、星5つを獲得できます"}, {"type": "subtitle", "time": 12573.11, "timestamp": "03:29:33", "text": "自分。"}, {"type": "subtitle", "time": 12576.229, "timestamp": "03:29:36", "text": "わかった。香港に到着しました"}, {"type": "subtitle", "time": 12578.95, "timestamp": "03:29:38", "text": "インパクト。"}, {"type": "subtitle", "time": 12584.309, "timestamp": "03:29:44", "text": "いや、違うよ。ええ、そうですね。えーと、スターの皆さん"}, {"type": "subtitle", "time": 12588.87, "timestamp": "03:29:48", "text": "この飛行隊は勝利を急いでいる。"}, {"type": "subtitle", "time": 12591.91, "timestamp": "03:29:51", "text": "駅の轟音、チャットしました"}, {"type": "subtitle", "time": 12593.91, "timestamp": "03:29:53", "text": "ウルトラキルウォーゾーンの奥"}, {"type": "subtitle", "time": 12597.83, "timestamp": "03:29:57", "text": "ルーム 新世界 モフォビア ショッピングリスト"}]
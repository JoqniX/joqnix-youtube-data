[{"type": "subtitle", "time": 13320.469, "timestamp": "03:42:00", "text": "ヴァレランドは、ニサンジが"}, {"type": "subtitle", "time": 13323.67, "timestamp": "03:42:03", "text": "インドもそこにいた。ナンジイン"}, {"type": "subtitle", "time": 13327.03, "timestamp": "03:42:07", "text": "あの頃が懐かしいよ。私は覚えている"}, {"type": "subtitle", "time": 13330.79, "timestamp": "03:42:10", "text": "今日でも、昔ヴィハンに尋ねたように"}, {"type": "subtitle", "time": 13332.95, "timestamp": "03:42:12", "text": "アルファ版は入手できた？手に入れましたか？"}, {"type": "subtitle", "time": 13335.59, "timestamp": "03:42:15", "text": "ベータキー？ヴァレリン、ストリーミング配信するべきだよ"}, {"type": "subtitle", "time": 13338.309, "timestamp": "03:42:18", "text": "それとかそういうのと一緒に。それから数秒後"}]
[{"type": "subtitle", "time": 8047.589, "timestamp": "02:14:07", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 8073.83, "timestamp": "02:14:33", "text": "最初はチラスをプレイして"}, {"type": "subtitle", "time": 8076.709, "timestamp": "02:14:36", "text": "えっと"}, {"type": "subtitle", "time": 8080.709, "timestamp": "02:14:40", "text": "2023年。そうだね。 2023年。良い試合だった。私"}, {"type": "subtitle", "time": 8084.39, "timestamp": "02:14:44", "text": "楽しかったし、すごく叫んだ"}, {"type": "subtitle", "time": 8087.589, "timestamp": "02:14:47", "text": "私が賃貸住宅に住んでいたという点を指摘しておきます。ない"}, {"type": "subtitle", "time": 8089.669, "timestamp": "02:14:49", "text": "レンタルした。ええと、私は賃貸の家に住んでいました"}, {"type": "subtitle", "time": 8093.03, "timestamp": "02:14:53", "text": "その時間に置く。ああ、神様、私は叫んだ"}]
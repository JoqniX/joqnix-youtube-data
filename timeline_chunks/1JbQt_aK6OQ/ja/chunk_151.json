[{"type": "subtitle", "time": 9063.11, "timestamp": "02:31:03", "text": "実は全部終わったんです。"}, {"type": "subtitle", "time": 9066.23, "timestamp": "02:31:06", "text": "えっと、本当に全部終わったのかな？"}, {"type": "subtitle", "time": 9068.469, "timestamp": "02:31:08", "text": "待って、もし私が"}, {"type": "subtitle", "time": 9071.349, "timestamp": "02:31:11", "text": "すべて完了しましたか？私はそうしなかったよね？ああ、私は"}, {"type": "subtitle", "time": 9076.07, "timestamp": "02:31:16", "text": "決してそうはならなかった。落としてしまった。あ、すみません。"}, {"type": "subtitle", "time": 9078.389, "timestamp": "02:31:18", "text": "オリーを片付けるぞ。私を求めてるの？"}, {"type": "subtitle", "time": 9081.75, "timestamp": "02:31:21", "text": "いつかOllieを終わらせる？"}, {"type": "subtitle", "time": 9084.469, "timestamp": "02:31:24", "text": "ふざけてたんだよ、そうだろ？そしてそうではない"}, {"type": "subtitle", "time": 9087.59, "timestamp": "02:31:27", "text": "ゲームをクリアする。"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "ゲームをクリアしなくてはならない。完了しました。その"}, {"type": "subtitle", "time": 9098.87, "timestamp": "02:31:38", "text": "ブループロトコル。"}, {"type": "subtitle", "time": 9103.349, "timestamp": "02:31:43", "text": "青いプロトコル、えーとバンダナって知ってた？"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "ゲームをやめたの？でもでも"}, {"type": "subtitle", "time": 9111.51, "timestamp": "02:31:51", "text": "ブループロトコルの星共鳴が到来する。"}, {"type": "subtitle", "time": 9115.349, "timestamp": "02:31:55", "text": "ブループロトコルの恒星共鳴が到来する。"}, {"type": "subtitle", "time": 9119.67, "timestamp": "02:31:59", "text": "もうすぐだよ、ベイビー。それはもうすぐ来る。"}]
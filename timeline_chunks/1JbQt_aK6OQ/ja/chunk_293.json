[{"type": "subtitle", "time": 17580.23, "timestamp": "04:53:00", "text": "その小川のほとり。だから、大丈夫です。"}, {"type": "subtitle", "time": 17583.27, "timestamp": "04:53:03", "text": "私たちは無事です。"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "ある日、私はシャツを手に入れた。"}, {"type": "subtitle", "time": 17599.11, "timestamp": "04:53:19", "text": "これは信じる。"}, {"type": "subtitle", "time": 17601.19, "timestamp": "04:53:21", "text": "これは違う。"}, {"type": "subtitle", "time": 17615.35, "timestamp": "04:53:35", "text": "これが探していたものだろうか？"}, {"type": "subtitle", "time": 17617.51, "timestamp": "04:53:37", "text": "ああ、そうですね。はい。これだ。はい。はい。"}, {"type": "subtitle", "time": 17620.31, "timestamp": "04:53:40", "text": "はい。はい。はい。"}, {"type": "subtitle", "time": 17623.19, "timestamp": "04:53:43", "text": "宇宙ステーション"}]
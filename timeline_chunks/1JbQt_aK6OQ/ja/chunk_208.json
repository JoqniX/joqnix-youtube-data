[{"type": "subtitle", "time": 12480.87, "timestamp": "03:28:00", "text": "この時。最後までやり遂げてみます。わかった。"}, {"type": "subtitle", "time": 12483.99, "timestamp": "03:28:03", "text": "これらのゲーム。いいえ、最後までやり遂げてみます。"}, {"type": "subtitle", "time": 12485.99, "timestamp": "03:28:05", "text": "持久力ストリームをやって、"}, {"type": "subtitle", "time": 12489.269, "timestamp": "03:28:09", "text": "終わらせろ。わかった。"}, {"type": "subtitle", "time": 12516.389, "timestamp": "03:28:36", "text": "ハイ、バッドサード。ああ、神様。感情のジェットコースター"}, {"type": "subtitle", "time": 12519.51, "timestamp": "03:28:39", "text": "史上最高のコースターゲーム。"}, {"type": "subtitle", "time": 12522.469, "timestamp": "03:28:42", "text": "あれは確かにすごかった。"}, {"type": "subtitle", "time": 12525.269, "timestamp": "03:28:45", "text": "オマイの影響力は凄まじかった。私はまだ願っています"}, {"type": "subtitle", "time": 12527.83, "timestamp": "03:28:47", "text": "あのゲームをもう一度プレイしたい。"}]
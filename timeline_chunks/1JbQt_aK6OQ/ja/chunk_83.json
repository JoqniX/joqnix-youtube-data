[{"type": "subtitle", "time": 4981.11, "timestamp": "01:23:01", "text": "私のウェブサイトで確認してください。もちろん。もちろん。"}, {"type": "subtitle", "time": 4984.39, "timestamp": "01:23:04", "text": "現在、コンテンツ警告を追加中です。それで"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "これまで私たちはピークを気にしないで追加しました"}, {"type": "subtitle", "time": 4990.79, "timestamp": "01:23:10", "text": "ここ。ページを更新させてください。私"}, {"type": "subtitle", "time": 4993.669, "timestamp": "01:23:13", "text": "アップデートしました。わかった。今後は"}, {"type": "subtitle", "time": 4995.59, "timestamp": "01:23:15", "text": "1つ"}, {"type": "subtitle", "time": 4998.47, "timestamp": "01:23:18", "text": "ええ、条件付きにする必要があります"}, {"type": "subtitle", "time": 5002.709, "timestamp": "01:23:22", "text": "コード。プレイした年がない場合は"}, {"type": "subtitle", "time": 5007.35, "timestamp": "01:23:27", "text": "ある特定のことをする、そういう類のこと。"}, {"type": "subtitle", "time": 5021.59, "timestamp": "01:23:41", "text": "何とか解決します。でも、プレイする"}, {"type": "subtitle", "time": 5029.35, "timestamp": "01:23:49", "text": "[咳払い]応答性を高めます"}, {"type": "subtitle", "time": 5031.59, "timestamp": "01:23:51", "text": "後で。でも、とにかく終わらせる必要がある"}, {"type": "subtitle", "time": 5035.59, "timestamp": "01:23:55", "text": "そのコンテンツ警告を更新します。追加しましたか？"}]
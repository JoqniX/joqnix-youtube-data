[{"type": "subtitle", "time": 10081.75, "timestamp": "02:48:01", "text": "オンラインアカウントやIMPSのようなものですか？良い、"}, {"type": "subtitle", "time": 10084.469, "timestamp": "02:48:04", "text": "まさに両方の良いところを兼ね備えていると言えるでしょう。"}, {"type": "subtitle", "time": 10086.95, "timestamp": "02:48:06", "text": "UPIはあなたの銀行口座を仮想"}, {"type": "subtitle", "time": 10089.269, "timestamp": "02:48:09", "text": "支払い先住所。それをあなたの"}, {"type": "subtitle", "time": 10091.59, "timestamp": "02:48:11", "text": "超クールな銀行のペットの名前、つまり"}, {"type": "subtitle", "time": 10093.269, "timestamp": "02:48:13", "text": "アカウントを覚えておく必要はありません"}, {"type": "subtitle", "time": 10095.75, "timestamp": "02:48:15", "text": "名義人名、長い口座番号、または"}, {"type": "subtitle", "time": 10098.15, "timestamp": "02:48:18", "text": "IFSCコード。クールな音楽を選んでください"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "VPA とクールな方法の準備をしましょう"}, {"type": "subtitle", "time": 10102.87, "timestamp": "02:48:22", "text": "銀行。では、何がそんなにユニークで特別なのでしょうか？"}, {"type": "subtitle", "time": 10105.51, "timestamp": "02:48:25", "text": "UPIについて？まずは送信することから始めましょう"}, {"type": "subtitle", "time": 10108.23, "timestamp": "02:48:28", "text": "お金。 UPIを使えば、簡単に送金できます。"}, {"type": "subtitle", "time": 10111.51, "timestamp": "02:48:31", "text": "UPI VPAをお持ちの方ならどなたでも"}, {"type": "subtitle", "time": 10113.269, "timestamp": "02:48:33", "text": "ワンクリック。 [音楽] 収集できます"}, {"type": "subtitle", "time": 10116.95, "timestamp": "02:48:36", "text": "お金もね。つまり、UPIは"}, {"type": "subtitle", "time": 10119.11, "timestamp": "02:48:39", "text": "支払いを行うだけでなく、"}, {"type": "chat", "time": 10120.813, "timestamp": "02:48:40", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "bro bacc"}, {"type": "subtitle", "time": 10122.309, "timestamp": "02:48:42", "text": "VPAを使用するだけで支払いが可能です。商人"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "この機能も利用できます。彼らは使用できる"}, {"type": "subtitle", "time": 10127.429, "timestamp": "02:48:47", "text": "UPIで予定している請求書を請求する"}, {"type": "subtitle", "time": 10129.83, "timestamp": "02:48:49", "text": "支払う。そして、あなたの都合に合わせて"}, {"type": "subtitle", "time": 10132.63, "timestamp": "02:48:52", "text": "に関して言えば、UPI では、"}, {"type": "subtitle", "time": 10135.59, "timestamp": "02:48:55", "text": "請求書を分担しましょう。最後に、"}, {"type": "subtitle", "time": 10138.389, "timestamp": "02:48:58", "text": "QRコードを使ってお支払いください。これで、"}]
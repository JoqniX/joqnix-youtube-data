[{"type": "subtitle", "time": 362.87, "timestamp": "00:06:02", "text": "私が本当に悲しんでいること、"}, {"type": "subtitle", "time": 365.99, "timestamp": "00:06:05", "text": "銀行のUPIに不満があります。"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "BIと呼ばれるものがあるってこと？"}, {"type": "subtitle", "time": 373.029, "timestamp": "00:06:13", "text": "ドット、またはジョックの前、ジョックスの後"}, {"type": "subtitle", "time": 376.469, "timestamp": "00:06:16", "text": "729という数字があるのですが、"}, {"type": "subtitle", "time": 378.95, "timestamp": "00:06:18", "text": "（息を呑む）"}, {"type": "subtitle", "time": 382.469, "timestamp": "00:06:22", "text": "アプリを閉じて再生成し、アプリを開いて"}, {"type": "subtitle", "time": 384.79, "timestamp": "00:06:24", "text": "アプリを再び閉じて、"}, {"type": "subtitle", "time": 388.87, "timestamp": "00:06:28", "text": "それが私の神です、[笑い]"}, {"type": "subtitle", "time": 392.87, "timestamp": "00:06:32", "text": "本当に変だよ。でも私は"}, {"type": "subtitle", "time": 395.99, "timestamp": "00:06:35", "text": "少なくとも手に入れることができて、今でも幸せです"}, {"type": "subtitle", "time": 398.95, "timestamp": "00:06:38", "text": "仕事ですよね？私の名前は表示されません"}, {"type": "subtitle", "time": 400.71, "timestamp": "00:06:40", "text": "もう。"}, {"type": "subtitle", "time": 402.39, "timestamp": "00:06:42", "text": "うん、"}, {"type": "subtitle", "time": 405.51, "timestamp": "00:06:45", "text": "私の名前を表示する必要はありません"}, {"type": "subtitle", "time": 407.909, "timestamp": "00:06:47", "text": "もう。そして私は本当に嬉しいです"}, {"type": "subtitle", "time": 409.909, "timestamp": "00:06:49", "text": "それ。"}, {"type": "subtitle", "time": 414.39, "timestamp": "00:06:54", "text": "本当に本当にえっと"}, {"type": "subtitle", "time": 417.229, "timestamp": "00:06:57", "text": "ええ、それは嬉しいです。"}, {"type": "subtitle", "time": 419.11, "timestamp": "00:06:59", "text": "[鼻を鳴らす]"}]
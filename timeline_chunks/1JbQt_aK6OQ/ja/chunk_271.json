[{"type": "subtitle", "time": 16261.91, "timestamp": "04:31:01", "text": "新世界。ああ、バトルフィールド"}, {"type": "subtitle", "time": 16269.99, "timestamp": "04:31:09", "text": "私はそういうプレイリストを作ったことがない。ああ、"}, {"type": "subtitle", "time": 16281.189, "timestamp": "04:31:21", "text": "新世界。これはアマゾンのゲームだった"}, {"type": "subtitle", "time": 16284.229, "timestamp": "04:31:24", "text": "支払済み。私はそれを一度もプレイしたことがない"}, {"type": "subtitle", "time": 16294.389, "timestamp": "04:31:34", "text": "新世界。"}, {"type": "subtitle", "time": 16297.75, "timestamp": "04:31:37", "text": "ニューワールドはまだ"}, {"type": "subtitle", "time": 16300.63, "timestamp": "04:31:40", "text": "まあ、そういうことかな。"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "見つかりません。"}, {"type": "subtitle", "time": 16307.75, "timestamp": "04:31:47", "text": "ああ、わかりました。新世界"}, {"type": "subtitle", "time": 16312.55, "timestamp": "04:31:52", "text": "エテルナムにて。何？"}, {"type": "subtitle", "time": 16315.83, "timestamp": "04:31:55", "text": "アマゾン。こんにちは。何？待って、それは"}, {"type": "subtitle", "time": 16317.67, "timestamp": "04:31:57", "text": "Amazonのゲームですよね？何が起こったのか"}, {"type": "subtitle", "time": 16319.429, "timestamp": "04:31:59", "text": "あなた？"}]
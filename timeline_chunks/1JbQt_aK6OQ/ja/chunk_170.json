[{"type": "subtitle", "time": 10206.79, "timestamp": "02:50:06", "text": "私の"}, {"type": "subtitle", "time": 10211.19, "timestamp": "02:50:11", "text": "えっと、相棒、相棒、相棒？私は自分のものをスキャンします"}, {"type": "subtitle", "time": 10240.95, "timestamp": "02:50:40", "text": "表示されません。"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "[咳払い]"}, {"type": "subtitle", "time": 10252.55, "timestamp": "02:50:52", "text": "何てことだ。給与額は表示されません。おお"}, {"type": "subtitle", "time": 10255.19, "timestamp": "02:50:55", "text": "ああ、お前が憎い。"}]
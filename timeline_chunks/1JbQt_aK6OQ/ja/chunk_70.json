[{"type": "subtitle", "time": 4207.99, "timestamp": "01:10:07", "text": "神"}, {"type": "subtitle", "time": 4223.669, "timestamp": "01:10:23", "text": "えっと、"}, {"type": "subtitle", "time": 4233.11, "timestamp": "01:10:33", "text": "これは2024年に発売されました。2024年。そして私は"}, {"type": "subtitle", "time": 4236.07, "timestamp": "01:10:36", "text": "そして私はそれをやり遂げた。"}, {"type": "subtitle", "time": 4238.31, "timestamp": "01:10:38", "text": "あるいはジョーンのゲーム。もちろん、"}, {"type": "subtitle", "time": 4241.83, "timestamp": "01:10:41", "text": "終わったよ。 [鼻を鳴らす]"}]
[{"type": "subtitle", "time": 4083.75, "timestamp": "01:08:03", "text": "2024年、私の評価はこれくらいになるでしょう。"}, {"type": "subtitle", "time": 4086.069, "timestamp": "01:08:06", "text": "私が初めてWitheringをプレイしたのはいつだったかな"}, {"type": "subtitle", "time": 4088.63, "timestamp": "01:08:08", "text": "波？確認してみます。"}, {"type": "subtitle", "time": 4090.789, "timestamp": "01:08:10", "text": "私はウィザリング・ウェーブスを一度もプレイしたことがありません。"}, {"type": "subtitle", "time": 4093.349, "timestamp": "01:08:13", "text": "以来。右。"}, {"type": "subtitle", "time": 4097.91, "timestamp": "01:08:17", "text": "私は2024年24日にWithering Wavesをプレイしました。"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "星5つをつけます。実は、"}, {"type": "subtitle", "time": 4103.43, "timestamp": "01:08:23", "text": "良いゲームです。おお、"}, {"type": "subtitle", "time": 4105.99, "timestamp": "01:08:25", "text": "待って。評価を付ける必要はありません"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "完了したゲーム、いや、未完了のゲーム。その"}, {"type": "subtitle", "time": 4111.99, "timestamp": "01:08:31", "text": "本来は"}, {"type": "subtitle", "time": 4115.749, "timestamp": "01:08:35", "text": "これは私がまだプレイしていないゲームのためのものです"}, {"type": "subtitle", "time": 4119.829, "timestamp": "01:08:39", "text": "私は参加しません。終わったよね？"}, {"type": "subtitle", "time": 4121.99, "timestamp": "01:08:41", "text": "そうそう。"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "次は"}, {"type": "subtitle", "time": 4128.47, "timestamp": "01:08:48", "text": "掃除機戦士。"}, {"type": "subtitle", "time": 4133.269, "timestamp": "01:08:53", "text": "Vacuum Warrior は次のように出てきました。"}]
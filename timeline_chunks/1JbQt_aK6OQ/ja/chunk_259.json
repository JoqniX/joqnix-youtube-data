[{"type": "subtitle", "time": 15540.63, "timestamp": "04:19:00", "text": "その名前の別の意味。いいえ。だから私の"}, {"type": "subtitle", "time": 15543.67, "timestamp": "04:19:03", "text": "私の考えは"}, {"type": "subtitle", "time": 15546.229, "timestamp": "04:19:06", "text": "えっと、私のアイデアはコンステラーに"}, {"type": "chat", "time": 15549.853, "timestamp": "04:19:09", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "i thought its about concert or something"}, {"type": "subtitle", "time": 15550.07, "timestamp": "04:19:10", "text": "そしてコンサートプレートは私にとって意味があります"}, {"type": "subtitle", "time": 15551.83, "timestamp": "04:19:11", "text": "ファンダム名。いいえ、それはコミュニティです"}, {"type": "subtitle", "time": 15554.87, "timestamp": "04:19:14", "text": "名前。だから、"}, {"type": "subtitle", "time": 15558.149, "timestamp": "04:19:18", "text": "時間とともに意味が変わる。私たちには"}, {"type": "subtitle", "time": 15560.149, "timestamp": "04:19:20", "text": "マスコット"}, {"type": "subtitle", "time": 15562.79, "timestamp": "04:19:22", "text": "えーと、コミュニティのためのキャラクター"}, {"type": "subtitle", "time": 15565.51, "timestamp": "04:19:25", "text": "コンサート形式の演劇"}, {"type": "subtitle", "time": 15569.91, "timestamp": "04:19:29", "text": "まだ。えっと、でも将来は私の"}, {"type": "subtitle", "time": 15572.07, "timestamp": "04:19:32", "text": "デビューは終了し、新しいモデルと"}, {"type": "subtitle", "time": 15574.07, "timestamp": "04:19:34", "text": "すべて完了しました。いいえ、将来私は"}, {"type": "subtitle", "time": 15578.87, "timestamp": "04:19:38", "text": "マスコットみたいなものを用意する予定です。"}, {"type": "subtitle", "time": 15581.269, "timestamp": "04:19:41", "text": "うん。"}, {"type": "subtitle", "time": 15583.99, "timestamp": "04:19:43", "text": "だから、みんな私の考えは"}, {"type": "subtitle", "time": 15587.03, "timestamp": "04:19:47", "text": "コンサートで誰もがユニークなアイデンティティを持つ"}, {"type": "subtitle", "time": 15590.149, "timestamp": "04:19:50", "text": "プレート、別名コンステラー。だから、"}, {"type": "subtitle", "time": 15592.309, "timestamp": "04:19:52", "text": "どのようなタイプの星座を選ぶか"}, {"type": "subtitle", "time": 15596.95, "timestamp": "04:19:56", "text": "なりたい。独自のタイプのマスコットを追加してください"}]
[{"type": "subtitle", "time": 6543.189, "timestamp": "01:49:03", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 6545.91, "timestamp": "01:49:05", "text": "地獄は終わった。"}, {"type": "subtitle", "time": 6548.87, "timestamp": "01:49:08", "text": "活動停止も完了しました。右。私は"}, {"type": "subtitle", "time": 6552.31, "timestamp": "01:49:12", "text": "無限の結果がもたらされる。"}, {"type": "subtitle", "time": 6554.55, "timestamp": "01:49:14", "text": "ファイヤーライト84。これも私が"}, {"type": "subtitle", "time": 6573.59, "timestamp": "01:49:33", "text": "そして"}, {"type": "subtitle", "time": 6581.35, "timestamp": "01:49:41", "text": "良い試合だった。"}, {"type": "subtitle", "time": 6589.91, "timestamp": "01:49:49", "text": "フェアファイアーファーライト"}, {"type": "subtitle", "time": 6591.985, "timestamp": "01:49:51", "text": "84."}, {"type": "subtitle", "time": 6592.87, "timestamp": "01:49:52", "text": "[鼻を鳴らす]"}]
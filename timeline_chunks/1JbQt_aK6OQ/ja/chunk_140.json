[{"type": "subtitle", "time": 8408.389, "timestamp": "02:20:08", "text": "『ダイイングライト』は終了しました。今、ゲームは"}, {"type": "subtitle", "time": 8412.15, "timestamp": "02:20:12", "text": "消えてしまった"}, {"type": "subtitle", "time": 8414.55, "timestamp": "02:20:14", "text": "うん。 16進数で定義されています。これは良い試合だった"}, {"type": "subtitle", "time": 8417.59, "timestamp": "02:20:17", "text": "しかし、彼らはそれを正しく阻止した。私のUbisoft"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "プラグを抜いた"}, {"type": "subtitle", "time": 8431.27, "timestamp": "02:20:31", "text": "えっと、"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "そして、ここに置いてください。"}, {"type": "subtitle", "time": 8446.07, "timestamp": "02:20:46", "text": "そして私は2023年にそれをプレイしました。"}, {"type": "subtitle", "time": 8450.897, "timestamp": "02:20:50", "text": "良い試合だった。悪くない。"}, {"type": "subtitle", "time": 8452.07, "timestamp": "02:20:52", "text": "[咳払いをする]"}, {"type": "subtitle", "time": 8458.309, "timestamp": "02:20:58", "text": "次はアトミックカードです。これを終えました"}]
[{"type": "subtitle", "time": 7201.83, "timestamp": "02:00:01", "text": "戻る。"}, {"type": "subtitle", "time": 7203.589, "timestamp": "02:00:03", "text": "これは私の最初の配信でした"}, {"type": "subtitle", "time": 7205.75, "timestamp": "02:00:05", "text": "アカウントがハッキングされました。"}, {"type": "subtitle", "time": 7208.07, "timestamp": "02:00:08", "text": "ハッカーが私のアカウントを乗っ取った。これ"}, {"type": "subtitle", "time": 7212.149, "timestamp": "02:00:12", "text": "3年前の2021年のことでした。"}, {"type": "subtitle", "time": 7216.39, "timestamp": "02:00:16", "text": "うん、いい試合だったよ。えっと、"}, {"type": "subtitle", "time": 7225.669, "timestamp": "02:00:25", "text": "プレイリストのリンクをコピーして貼り付けます"}, {"type": "chat", "time": 7234.579, "timestamp": "02:00:34", "author": "@KyoIshigami", "avatar": "https://yt4.ggpht.com/Vk96zC92zdcFPVokKpYh2X89w6oCedMkQgFe9loVTqhrxx50jr2lV7W_ycIZerJg_8xaG56JvA=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "chat", "time": 7237.883, "timestamp": "02:00:37", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Kyo Ishigami~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 7239.109, "timestamp": "02:00:39", "text": "こんにちは。"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "こんばんは。"}, {"type": "subtitle", "time": 7244.95, "timestamp": "02:00:44", "text": "次はリーサル・カンパニーです。"}, {"type": "subtitle", "time": 7246.87, "timestamp": "02:00:46", "text": "リーサル・カンパニー。覚えていると思う"}, {"type": "subtitle", "time": 7250.629, "timestamp": "02:00:50", "text": "何度もプレイしたけど、やったよ"}, {"type": "subtitle", "time": 7252.888, "timestamp": "02:00:52", "text": "配信停止。"}, {"type": "subtitle", "time": 7253.99, "timestamp": "02:00:53", "text": "[笑い]"}, {"type": "subtitle", "time": 7257.43, "timestamp": "02:00:57", "text": "ほとんどは配信外でやっていました。ほとんどの"}]
[{"type": "subtitle", "time": 12181.429, "timestamp": "03:23:01", "text": "私が昔演奏していたローウィの曲"}, {"type": "subtitle", "time": 12217.429, "timestamp": "03:23:37", "text": "でも正直に言うと、えーとみんな"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "今、私がやっている追加的なこと。"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "正直に言うと、私は"}, {"type": "subtitle", "time": 12225.75, "timestamp": "03:23:45", "text": "私がやらないところでさらにさらにさらにやる"}, {"type": "subtitle", "time": 12231.51, "timestamp": "03:23:51", "text": "わからない。"}]
[{"type": "subtitle", "time": 1682.71, "timestamp": "00:28:02", "text": "まあ、いいんですけどね。 729は"}, {"type": "subtitle", "time": 1685.669, "timestamp": "00:28:05", "text": "悪くないと思う。"}, {"type": "subtitle", "time": 1688.23, "timestamp": "00:28:08", "text": "ああ、でもそうだね。"}, {"type": "subtitle", "time": 1691.19, "timestamp": "00:28:11", "text": "そう、それで私は"}, {"type": "subtitle", "time": 1693.909, "timestamp": "00:28:13", "text": "UPIの構造とか全部。だからあなたは"}, {"type": "subtitle", "time": 1698.549, "timestamp": "00:28:18", "text": "ここにUPI IDを入力する必要があります。"}, {"type": "subtitle", "time": 1701.029, "timestamp": "00:28:21", "text": "これ。 PNは実際にはあなたの販売業者です"}, {"type": "subtitle", "time": 1704.07, "timestamp": "00:28:24", "text": "名前または支払い名アカウント"}, {"type": "subtitle", "time": 1706.63, "timestamp": "00:28:26", "text": "ユーザー名。 CUがあなたの通貨です。 MCは"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "加盟店コード。スタースケープの"}, {"type": "subtitle", "time": 1714.95, "timestamp": "00:28:34", "text": "サブスケープ um Starscape は、簡単な支払い方法を使用しています"}, {"type": "subtitle", "time": 1716.47, "timestamp": "00:28:36", "text": "ICICI。"}, {"type": "subtitle", "time": 1718.389, "timestamp": "00:28:38", "text": "そう、スタースケープと数人の人たち"}, {"type": "subtitle", "time": 1720.31, "timestamp": "00:28:40", "text": "Redditで気づいたこと、そして彼らが"}, {"type": "subtitle", "time": 1725.43, "timestamp": "00:28:45", "text": "ICICIまたはイージーペイをご利用ください。そうですね、私たちにとっては"}, {"type": "subtitle", "time": 1727.909, "timestamp": "00:28:47", "text": "ストリーマーエンターテイナー、これは"}, {"type": "subtitle", "time": 1730.95, "timestamp": "00:28:50", "text": "加盟店コード7829はエンターテイメント用です"}, {"type": "subtitle", "time": 1733.269, "timestamp": "00:28:53", "text": "およびレクリエーションサービス。"}, {"type": "subtitle", "time": 1737.07, "timestamp": "00:28:57", "text": "TNは実際には説明文です。そうですね"}, {"type": "subtitle", "time": 1739.51, "timestamp": "00:28:59", "text": "[笑い] だから、このスキャンを試したら"}]
[{"type": "subtitle", "time": 16741.99, "timestamp": "04:39:01", "text": "リストデータベースをここから更新してください"}, {"type": "subtitle", "time": 16749.189, "timestamp": "04:39:09", "text": "そしてそれが私がやってきたことです"}, {"type": "subtitle", "time": 16750.949, "timestamp": "04:39:10", "text": "それが私たちがしていることです"}, {"type": "subtitle", "time": 16752.463, "timestamp": "04:39:12", "text": "今日"}, {"type": "subtitle", "time": 16754.23, "timestamp": "04:39:14", "text": "[笑い] 私は決して"}, {"type": "subtitle", "time": 16757.269, "timestamp": "04:39:17", "text": "ウェブサイトは完成しましたが、"}, {"type": "subtitle", "time": 16759.99, "timestamp": "04:39:19", "text": "誰かからインスピレーションを受けると、"}, {"type": "subtitle", "time": 16763.349, "timestamp": "04:39:23", "text": "そうしたいんだけど、でも"}, {"type": "subtitle", "time": 16766.869, "timestamp": "04:39:26", "text": "今日、銀行のUPIを手に入れました。それで、ついに"}, {"type": "subtitle", "time": 16769.83, "timestamp": "04:39:29", "text": "UPI決済に対応しました。 QRコードをスキャンできます"}, {"type": "subtitle", "time": 16771.99, "timestamp": "04:39:31", "text": "コード。ああ、ピン留めされている"}, {"type": "subtitle", "time": 16775.75, "timestamp": "04:39:35", "text": "チャットでコメントしてください。チャットでコメントを固定しました。"}, {"type": "subtitle", "time": 16777.91, "timestamp": "04:39:37", "text": "次に、スポーツマンが表示されます。私の"}, {"type": "subtitle", "time": 16784.788, "timestamp": "04:39:44", "text": "私はインド人として個人情報を晒される心配はありません"}, {"type": "subtitle", "time": 16795.11, "timestamp": "04:39:55", "text": "おお。えっと"}]
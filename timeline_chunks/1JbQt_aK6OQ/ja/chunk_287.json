[{"type": "subtitle", "time": 17221.11, "timestamp": "04:47:01", "text": "ああ、このゲームは終わったよ。しかし"}, {"type": "subtitle", "time": 17223.51, "timestamp": "04:47:03", "text": "うん、"}, {"type": "subtitle", "time": 17240.23, "timestamp": "04:47:20", "text": "ウルトラキル"}, {"type": "subtitle", "time": 17244.15, "timestamp": "04:47:24", "text": "小文字で殺す権利"}, {"type": "subtitle", "time": 17247.75, "timestamp": "04:47:27", "text": "2020年にこれを終えたので、"}, {"type": "subtitle", "time": 17250.788, "timestamp": "04:47:30", "text": "完了しました。"}, {"type": "subtitle", "time": 17260.31, "timestamp": "04:47:40", "text": "これを置くよ。"}, {"type": "subtitle", "time": 17263.35, "timestamp": "04:47:43", "text": "最初にUltrakillを配信したのは2回目くらいだったかな"}, {"type": "subtitle", "time": 17265.67, "timestamp": "04:47:45", "text": "数年前のこと。"}, {"type": "subtitle", "time": 17275.99, "timestamp": "04:47:55", "text": "良い試合だった。星5つ"}, {"type": "subtitle", "time": 17277.51, "timestamp": "04:47:57", "text": "星。"}]
[{"type": "subtitle", "time": 1320.789, "timestamp": "00:22:00", "text": "これを今、どのように行えばよいですか？"}, {"type": "subtitle", "time": 1324.149, "timestamp": "00:22:04", "text": "これをグーグルで調べてみます。"}, {"type": "subtitle", "time": 1339.19, "timestamp": "00:22:19", "text": "私がランダムに登録しているという事実"}, {"type": "subtitle", "time": 1351.43, "timestamp": "00:22:31", "text": "えっと、"}, {"type": "subtitle", "time": 1357.27, "timestamp": "00:22:37", "text": "1つ。"}, {"type": "subtitle", "time": 1360.549, "timestamp": "00:22:40", "text": "どうやってそう思ったのですか？私は、えっと、私は"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "銀行のUPIを手に入れました。ついに手に入れた"}, {"type": "subtitle", "time": 1368.07, "timestamp": "00:22:48", "text": "銀行VPI。"}, {"type": "subtitle", "time": 1370.789, "timestamp": "00:22:50", "text": "治療コードの下に名前を追加してください。何が"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "これ？それで、えーと、問題は"}, {"type": "subtitle", "time": 1378.95, "timestamp": "00:22:58", "text": "ええと、私はフェデラル銀行を選びました。えっと、それで、私は"}]
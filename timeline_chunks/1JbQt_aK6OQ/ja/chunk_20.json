[{"type": "subtitle", "time": 1200.63, "timestamp": "00:20:00", "text": "私はします。わかった、いいよ。"}, {"type": "subtitle", "time": 1203.19, "timestamp": "00:20:03", "text": "待って、これをスキャンしたらどうなる？私は"}, {"type": "subtitle", "time": 1205.35, "timestamp": "00:20:05", "text": "実際に何か得られるのか？"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "やらせてください。電話を取ってきて"}, {"type": "subtitle", "time": 1221.51, "timestamp": "00:20:21", "text": "実際、効果があります。くそっ。実際には"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "支払い。ああ、私は自分自身に送った"}, {"type": "subtitle", "time": 1235.909, "timestamp": "00:20:35", "text": "ルピー。 [笑い]"}, {"type": "subtitle", "time": 1254.39, "timestamp": "00:20:54", "text": "もしそうなら？私は置きたい"}, {"type": "subtitle", "time": 1256.39, "timestamp": "00:20:56", "text": "何か [鼻を鳴らす]"}]
[{"type": "subtitle", "time": 9182.95, "timestamp": "02:33:02", "text": "ここに置いておきます。"}, {"type": "subtitle", "time": 9185.27, "timestamp": "02:33:05", "text": "私たちは文字通り思い出の道を辿っています。"}, {"type": "subtitle", "time": 9192.79, "timestamp": "02:33:12", "text": "わかった。ブループロトコルバトルビット。これは"}, {"type": "subtitle", "time": 9194.71, "timestamp": "02:33:14", "text": "良い試合だった。楽しかったです。私が"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "面白半分でピューピュー撃ちたかっただけ"}, {"type": "subtitle", "time": 9200.15, "timestamp": "02:33:20", "text": "ここに来てこのゲームをプレイしよう。それはとても"}, {"type": "subtitle", "time": 9203.349, "timestamp": "02:33:23", "text": "良い試合だった。バトルベット。"}, {"type": "subtitle", "time": 9212.671, "timestamp": "02:33:32", "text": "バトルベット リマスター版。"}, {"type": "subtitle", "time": 9214.23, "timestamp": "02:33:34", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 9223.03, "timestamp": "02:33:43", "text": "23歳ですよね？私は2年間音楽を演奏しました"}, {"type": "subtitle", "time": 9230.07, "timestamp": "02:33:50", "text": "最初の配信は2年前でした。"}, {"type": "subtitle", "time": 9233.03, "timestamp": "02:33:53", "text": "2023年6月"}, {"type": "subtitle", "time": 9236.15, "timestamp": "02:33:56", "text": "初めてのゲーム。"}, {"type": "subtitle", "time": 9238.71, "timestamp": "02:33:58", "text": "でも、私は何度も死んだ。でも楽しかったよ。我々は持っていた"}]
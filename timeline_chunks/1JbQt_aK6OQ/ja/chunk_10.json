[{"type": "subtitle", "time": 600.389, "timestamp": "00:10:00", "text": "もっと綺麗だし、何もかも。"}, {"type": "subtitle", "time": 603.91, "timestamp": "00:10:03", "text": "えーっと、私のロゴを追加して"}, {"type": "subtitle", "time": 610.87, "timestamp": "00:10:10", "text": "私のロゴとか色々"}, {"type": "subtitle", "time": 614.069, "timestamp": "00:10:14", "text": "見た目も綺麗だし、何も問題ない。させて"}, {"type": "subtitle", "time": 616.949, "timestamp": "00:10:16", "text": "私にできるかどうか試してみます。"}, {"type": "subtitle", "time": 619.829, "timestamp": "00:10:19", "text": "皆さん、テストを手伝ってもらえませんか？"}, {"type": "subtitle", "time": 621.59, "timestamp": "00:10:21", "text": "外？"}, {"type": "subtitle", "time": 625.509, "timestamp": "00:10:25", "text": "良いリンカーを作成してください。"}, {"type": "subtitle", "time": 632.55, "timestamp": "00:10:32", "text": "より動的なコードを作成しましょう"}, {"type": "subtitle", "time": 637.35, "timestamp": "00:10:37", "text": "あなたのソーシャルメディアアカウントへのリンクを貼ってください。これは何ですか？えっと、"}, {"type": "subtitle", "time": 639.59, "timestamp": "00:10:39", "text": "クーポン"}, {"type": "subtitle", "time": 644.15, "timestamp": "00:10:44", "text": "バーチャルカードとソーシャルメディアの組み合わせ。"}, {"type": "subtitle", "time": 645.99, "timestamp": "00:10:45", "text": "いいえ、それは望みません。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "えっと、QRコード。"}]
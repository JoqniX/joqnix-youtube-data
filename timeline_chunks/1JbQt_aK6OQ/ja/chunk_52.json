[{"type": "subtitle", "time": 3131.109, "timestamp": "00:52:11", "text": "次"}, {"type": "subtitle", "time": 3138.069, "timestamp": "00:52:18", "text": "ここに追加して、ここへ移動してください。"}, {"type": "subtitle", "time": 3146.87, "timestamp": "00:52:26", "text": "昨日、いくつか項目を追加しました。"}, {"type": "subtitle", "time": 3149.349, "timestamp": "00:52:29", "text": "ピークを追加しました。ゲームを追加しました"}, {"type": "subtitle", "time": 3151.99, "timestamp": "00:52:31", "text": "ホールを掘って、星空パーティーを開く。右。"}, {"type": "subtitle", "time": 3154.069, "timestamp": "00:52:34", "text": "残りのゲームも追加します"}, {"type": "subtitle", "time": 3155.99, "timestamp": "00:52:35", "text": "ここ。"}, {"type": "subtitle", "time": 3160.309, "timestamp": "00:52:40", "text": "えっと、マーベルライバルズを追加しないと。右。"}, {"type": "subtitle", "time": 3177.51, "timestamp": "00:52:57", "text": "壮大だ [笑い声と鼻息]"}]
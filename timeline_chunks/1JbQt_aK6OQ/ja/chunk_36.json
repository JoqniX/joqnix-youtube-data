[{"type": "subtitle", "time": 2162.55, "timestamp": "00:36:02", "text": "あれ。どうやらキャッシュレス決済では5％の手数料がかかるようだ"}, {"type": "subtitle", "time": 2165.51, "timestamp": "00:36:05", "text": "ここから切り取った。だからあなたもできる"}, {"type": "subtitle", "time": 2168.31, "timestamp": "00:36:08", "text": "ここみたいに、こういうのも好きです。"}, {"type": "subtitle", "time": 2171.03, "timestamp": "00:36:11", "text": "しかし、これは必要ないように感じます。できる"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "文字通り銀行のものを使えばいい、私の"}, {"type": "subtitle", "time": 2176.71, "timestamp": "00:36:16", "text": "現金を使わずに直接支払うことができます。私"}, {"type": "subtitle", "time": 2180.71, "timestamp": "00:36:20", "text": "削除するか、残しておく必要があるかもしれない"}, {"type": "subtitle", "time": 2183.03, "timestamp": "00:36:23", "text": "多分。わからない。しかし唯一のことは"}, {"type": "subtitle", "time": 2187.19, "timestamp": "00:36:27", "text": "Cashfree が得意なのは、人々が"}, {"type": "subtitle", "time": 2189.51, "timestamp": "00:36:29", "text": "希望に応じてカスタムメッセージを作成する"}, {"type": "subtitle", "time": 2192.15, "timestamp": "00:36:32", "text": "寄付する。いいえ。ええ。うん。うん。もし彼らが"}, {"type": "subtitle", "time": 2194.95, "timestamp": "00:36:34", "text": "寄付したい、または"}, {"type": "subtitle", "time": 2198.71, "timestamp": "00:36:38", "text": "何か、彼らが好きになる方法が欲しい"}, {"type": "chat", "time": 2199.585, "timestamp": "00:36:39", "author": "@meow_miko", "avatar": "https://yt4.ggpht.com/ASvDvYYIzbsKhRZHUW96TfjrUSWXRG124t_MDqszJYXjA87uEcIZVvjFBsBfRncMogN0tWEt0iI=s64-c-k-c0x00ffffff-no-rj", "message": "Haii Joq I hope u are well ❤‍🩹"}, {"type": "subtitle", "time": 2201.67, "timestamp": "00:36:41", "text": "えっと、なんて呼ぶんだっけ？えっと、書いてください"}, {"type": "chat", "time": 2205.722, "timestamp": "00:36:45", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Manal Umbra - VT~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2206.95, "timestamp": "00:36:46", "text": "UPI関連のメッセージ。のために"}, {"type": "subtitle", "time": 2209.67, "timestamp": "00:36:49", "text": "UPIのやつ、コードをスキャンすると"}, {"type": "subtitle", "time": 2211.51, "timestamp": "00:36:51", "text": "そして全て。いいえ。"}, {"type": "subtitle", "time": 2214.63, "timestamp": "00:36:54", "text": "えーと、取引があるような"}, {"type": "subtitle", "time": 2217.349, "timestamp": "00:36:57", "text": "そこでコメントするが、問題は私がそうしないということだ"}]
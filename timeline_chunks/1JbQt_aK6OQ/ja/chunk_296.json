[{"type": "subtitle", "time": 17784.07, "timestamp": "04:56:24", "text": "Jがいたんだ。今でもプレイしてるよ。一時停止しました。"}, {"type": "subtitle", "time": 17792.948, "timestamp": "04:56:32", "text": "残りは"}, {"type": "subtitle", "time": 17795.59, "timestamp": "04:56:35", "text": "保留中。"}, {"type": "subtitle", "time": 17798.47, "timestamp": "04:56:38", "text": "気づいたかもしれませんが、私は"}, {"type": "subtitle", "time": 17801.99, "timestamp": "04:56:41", "text": "カテゴリーが保留状態になりました。そうではないことは分かっています"}, {"type": "subtitle", "time": 17804.788, "timestamp": "04:56:44", "text": "ウェブサイトにはまだ掲載されていませんが、追加する予定です"}, {"type": "subtitle", "time": 17807.43, "timestamp": "04:56:47", "text": "遅かれ早かれそうなるだろう。"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "寝る前、この直後、"}, {"type": "subtitle", "time": 17811.99, "timestamp": "04:56:51", "text": "追加しておきますね。"}, {"type": "subtitle", "time": 17815.59, "timestamp": "04:56:55", "text": "最初にプレイしたのは2022年だったよね？はい。"}]
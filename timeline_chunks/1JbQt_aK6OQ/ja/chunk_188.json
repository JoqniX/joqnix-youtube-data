[{"type": "subtitle", "time": 11292.469, "timestamp": "03:08:12", "text": "2023年27日ですよね？行進。わかった。私たちは"}, {"type": "subtitle", "time": 11295.349, "timestamp": "03:08:15", "text": "到達する、到達する"}, {"type": "subtitle", "time": 11297.59, "timestamp": "03:08:17", "text": "えーと"}, {"type": "subtitle", "time": 11301.11, "timestamp": "03:08:21", "text": "私たちは到達しようとしています、えっと、何と呼ぶんですか"}, {"type": "subtitle", "time": 11302.79, "timestamp": "03:08:22", "text": "それ？私たちは[咳払い]到達するつもりです"}, {"type": "subtitle", "time": 11307.03, "timestamp": "03:08:27", "text": "もうすぐ2022年だ。わかった。 2023年。私も終わりました"}, {"type": "subtitle", "time": 11328.07, "timestamp": "03:08:48", "text": "私は23日に配信しました。"}, {"type": "subtitle", "time": 11337.11, "timestamp": "03:08:57", "text": "9つのシリーズがあります"}]
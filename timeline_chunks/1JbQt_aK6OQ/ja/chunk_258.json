[{"type": "subtitle", "time": 15481.349, "timestamp": "04:18:01", "text": "やり方を知らない、なぜなら最初は"}, {"type": "subtitle", "time": 15484.63, "timestamp": "04:18:04", "text": "私のファンネームはコネリッシュです"}, {"type": "subtitle", "time": 15487.429, "timestamp": "04:18:07", "text": "コネラー しかし、どうやらグーグルで検索すると"}, {"type": "subtitle", "time": 15491.67, "timestamp": "04:18:11", "text": "コンステラー、それは遊戯王のカードです。えっと、"}, {"type": "subtitle", "time": 15494.71, "timestamp": "04:18:14", "text": "これは遊戯王カードです。それは"}, {"type": "subtitle", "time": 15498.149, "timestamp": "04:18:18", "text": "それは光です。遊戯王カードか"}, {"type": "subtitle", "time": 15500.95, "timestamp": "04:18:20", "text": "何か、"}, {"type": "subtitle", "time": 15503.429, "timestamp": "04:18:23", "text": "右？だから私は「いや、私は欲しくない」と言った"}, {"type": "chat", "time": 15504.082, "timestamp": "04:18:24", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "what's the meaning?"}, {"type": "subtitle", "time": 15506.55, "timestamp": "04:18:26", "text": "「他のものと同じ名前である」ということで、"}, {"type": "subtitle", "time": 15510.149, "timestamp": "04:18:30", "text": "K を作りたかった"}, {"type": "subtitle", "time": 15513.75, "timestamp": "04:18:33", "text": "Cの代わりに。つまり、星座。コンステラ"}, {"type": "chat", "time": 15514.999, "timestamp": "04:18:34", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "oh constellar"}, {"type": "subtitle", "time": 15516.309, "timestamp": "04:18:36", "text": "その意味は、星の集まりのようなものだ。"}, {"type": "subtitle", "time": 15519.59, "timestamp": "04:18:39", "text": "君たちはまるで星座みたいだよね？"}, {"type": "subtitle", "time": 15523.75, "timestamp": "04:18:43", "text": "うん。ある意味、コンステラーも"}, {"type": "subtitle", "time": 15525.91, "timestamp": "04:18:45", "text": "constellarには意味がありません。私"}, {"type": "subtitle", "time": 15527.83, "timestamp": "04:18:47", "text": "推測するに、唯一の意味は"}, {"type": "subtitle", "time": 15530.149, "timestamp": "04:18:50", "text": "jocknikに接続し、"}, {"type": "subtitle", "time": 15532.149, "timestamp": "04:18:52", "text": "星座や星のように"}, {"type": "subtitle", "time": 15535.269, "timestamp": "04:18:55", "text": "すべてが一つにまとまると、こうなります。"}, {"type": "subtitle", "time": 15537.269, "timestamp": "04:18:57", "text": "うん。そしてコンサートも開催されました"}]
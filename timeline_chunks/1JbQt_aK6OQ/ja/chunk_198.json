[{"type": "subtitle", "time": 11913.19, "timestamp": "03:18:33", "text": "ウォーハウアーは「ああ、私は一度もプレイしたことがない」"}, {"type": "subtitle", "time": 11916.55, "timestamp": "03:18:36", "text": "これ。私もこれにお金を払った"}, {"type": "subtitle", "time": 11919.59, "timestamp": "03:18:39", "text": "ずっと昔の話です。"}, {"type": "subtitle", "time": 11921.75, "timestamp": "03:18:41", "text": "ああ、ゲームが多すぎて"}, {"type": "subtitle", "time": 11924.309, "timestamp": "03:18:44", "text": "プレイを止めた。"}, {"type": "subtitle", "time": 11931.67, "timestamp": "03:18:51", "text": "私はそれを完全にそのまま保管しました。"}, {"type": "subtitle", "time": 11933.75, "timestamp": "03:18:53", "text": "もしこれだけのお金があったら、"}, {"type": "subtitle", "time": 11935.91, "timestamp": "03:18:55", "text": "本当にたくさんのことを成し遂げた。"}, {"type": "subtitle", "time": 11938.79, "timestamp": "03:18:58", "text": "兄弟、なぜ私は"}]
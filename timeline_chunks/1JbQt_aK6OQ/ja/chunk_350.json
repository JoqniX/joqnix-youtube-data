[{"type": "subtitle", "time": 21001.27, "timestamp": "05:50:01", "text": "それなら私はこうするだけです"}, {"type": "subtitle", "time": 21004.948, "timestamp": "05:50:04", "text": "ああ、他のものも調べてみるよ"}, {"type": "subtitle", "time": 21007.27, "timestamp": "05:50:07", "text": "声優のような資質"}, {"type": "subtitle", "time": 21010.548, "timestamp": "05:50:10", "text": "もし可能なら。何かあれば"}, {"type": "subtitle", "time": 21012.548, "timestamp": "05:50:12", "text": "再キュービング"}, {"type": "subtitle", "time": 21014.628, "timestamp": "05:50:14", "text": "経営は全く異なる。"}, {"type": "subtitle", "time": 21016.708, "timestamp": "05:50:16", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 21018.708, "timestamp": "05:50:18", "text": "わからない。ええ、もしそれが"}, {"type": "subtitle", "time": 21021.19, "timestamp": "05:50:21", "text": "仕事はしないから、音楽だけをやろう。もしその新しい"}, {"type": "subtitle", "time": 21024.47, "timestamp": "05:50:24", "text": "音楽はうまくいかないので、私はただ"}, {"type": "subtitle", "time": 21028.868, "timestamp": "05:50:28", "text": "えっと、ファッションデザインとか何か"}, {"type": "subtitle", "time": 21032.39, "timestamp": "05:50:32", "text": "誰かの下で働いたり、カフェを開いたりする"}, {"type": "subtitle", "time": 21035.59, "timestamp": "05:50:35", "text": "あるいは、そんな感じ。わからない。もっとあります"}, {"type": "chat", "time": 21037.077, "timestamp": "05:50:37", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "she need a proper and very good mods for this"}, {"type": "subtitle", "time": 21038.07, "timestamp": "05:50:38", "text": "多数のバックアッププラン。"}, {"type": "subtitle", "time": 21042.548, "timestamp": "05:50:42", "text": "やってみます、もしくは作業します"}, {"type": "subtitle", "time": 21045.91, "timestamp": "05:50:45", "text": "ただあちらで普通の労働者になって"}, {"type": "subtitle", "time": 21049.312, "timestamp": "05:50:49", "text": "そしてゆっくりとオーナーの地位を奪っていく"}, {"type": "subtitle", "time": 21052.31, "timestamp": "05:50:52", "text": "[笑い]とかそんな感じ。わからない。"}, {"type": "subtitle", "time": 21055.51, "timestamp": "05:50:55", "text": "さあ、どうだろうね。私ができる限り"}]
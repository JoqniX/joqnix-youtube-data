[{"type": "subtitle", "time": 11645.67, "timestamp": "03:14:05", "text": "誰かジョッカソンのこと覚えてる？"}, {"type": "subtitle", "time": 11647.99, "timestamp": "03:14:07", "text": "ストリームは猫を終えたものでした"}, {"type": "subtitle", "time": 11650.95, "timestamp": "03:14:10", "text": "きちんと整理されている？"}, {"type": "subtitle", "time": 11653.429, "timestamp": "03:14:13", "text": "そして問題は、これらのゲームのほとんどが"}, {"type": "subtitle", "time": 11659.779, "timestamp": "03:14:19", "text": "ヨアトンの期間中に完成させた。"}, {"type": "subtitle", "time": 11661.75, "timestamp": "03:14:21", "text": "[鼻を鳴らす]"}]
[{"type": "subtitle", "time": 780.15, "timestamp": "00:13:00", "text": "アストラル寄付のようなものをアストラルに"}, {"type": "subtitle", "time": 782.87, "timestamp": "00:13:02", "text": "ジョックへの寄付。"}, {"type": "subtitle", "time": 799.509, "timestamp": "00:13:19", "text": "えーと、ジョギングのためのアストラル寄付。これです。"}, {"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "うん。うん。うん。これです。あなたも"}, {"type": "subtitle", "time": 806.15, "timestamp": "00:13:26", "text": "HTTPSも可能"}, {"type": "subtitle", "time": 808.47, "timestamp": "00:13:28", "text": "uh onexa.link"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "スラッシュピ。"}, {"type": "subtitle", "time": 814.55, "timestamp": "00:13:34", "text": "あなたもこうすることができます。これにより、"}, {"type": "subtitle", "time": 816.31, "timestamp": "00:13:36", "text": "あなたの携帯電話で。もしあなたがそれを行っているなら"}, {"type": "subtitle", "time": 819.829, "timestamp": "00:13:39", "text": "あなたの電話、あなたはそれを手に入れることができます、または"}, {"type": "subtitle", "time": 823.509, "timestamp": "00:13:43", "text": "それ以外は問題ありません。えっと、私が計画していることは"}, {"type": "subtitle", "time": 828.31, "timestamp": "00:13:48", "text": "今日は、このUPI IDを作成する日です。はぁ？"}, {"type": "subtitle", "time": 832.389, "timestamp": "00:13:52", "text": "QRコードを作成します。"}, {"type": "subtitle", "time": 835.11, "timestamp": "00:13:55", "text": "それは正当なことではないでしょうか？ [笑い]"}, {"type": "subtitle", "time": 838.069, "timestamp": "00:13:58", "text": "おい、そんなことしないでくれよ。"}]
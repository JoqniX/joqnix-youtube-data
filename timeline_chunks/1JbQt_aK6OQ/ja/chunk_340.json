[{"type": "subtitle", "time": 20400.07, "timestamp": "05:40:00", "text": "Shopifyは高すぎると気づいた。私"}, {"type": "chat", "time": 20401.658, "timestamp": "05:40:01", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "@Free Spirit i know you watching, answer me"}, {"type": "subtitle", "time": 20402.39, "timestamp": "05:40:02", "text": "買えない。"}, {"type": "subtitle", "time": 20404.628, "timestamp": "05:40:04", "text": "Shopify。"}, {"type": "subtitle", "time": 20407.83, "timestamp": "05:40:07", "text": "誤って無料トライアルを有効にしてしまいました"}, {"type": "subtitle", "time": 20411.03, "timestamp": "05:40:11", "text": "Shopifyライト。そして私は気づいた、ああ、"}, {"type": "subtitle", "time": 20413.67, "timestamp": "05:40:13", "text": "ShopifyにはUPIという機能があります。彼らは"}, {"type": "subtitle", "time": 20417.11, "timestamp": "05:40:17", "text": "Razer Payとキャッシュレス決済。あの二人"}, {"type": "subtitle", "time": 20420.868, "timestamp": "05:40:20", "text": "Shopify向けにUPIの設定が完了しました。"}, {"type": "subtitle", "time": 20422.708, "timestamp": "05:40:22", "text": "だから私はこう思った、"}, {"type": "subtitle", "time": 20427.91, "timestamp": "05:40:27", "text": "それで、200枚のスライドからなるPPTを入手しました。"}, {"type": "subtitle", "time": 20429.03, "timestamp": "05:40:29", "text": "うん。"}, {"type": "subtitle", "time": 20432.07, "timestamp": "05:40:32", "text": "会合のようなもの。私たちは"}, {"type": "subtitle", "time": 20433.83, "timestamp": "05:40:33", "text": "明日の準備をします。"}, {"type": "subtitle", "time": 20435.03, "timestamp": "05:40:35", "text": "わかった。"}, {"type": "subtitle", "time": 20437.59, "timestamp": "05:40:37", "text": "そして今、私はさらに100枚のスライドを手に入れました"}, {"type": "subtitle", "time": 20439.75, "timestamp": "05:40:39", "text": "それを追加する必要がある"}, {"type": "subtitle", "time": 20443.19, "timestamp": "05:40:43", "text": "聖なる神よ。"}, {"type": "subtitle", "time": 20449.98, "timestamp": "05:40:49", "text": "楽しい。"}]
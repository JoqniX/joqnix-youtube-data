[{"type": "subtitle", "time": 2580.734, "timestamp": "00:43:00", "text": "等等。这就像一款恐怖游戏。"}, {"type": "subtitle", "time": 2581.513, "timestamp": "00:43:01", "text": "模仿者"}, {"type": "subtitle", "time": 2587.875, "timestamp": "00:43:07", "text": "午夜班。它就像一个大"}, {"type": "subtitle", "time": 2590.322, "timestamp": "00:43:10", "text": "你知道，就像那种很棒的类型"}, {"type": "subtitle", "time": 2591.861, "timestamp": "00:43:11", "text": "你知道，就是分身。"}, {"type": "subtitle", "time": 2592.793, "timestamp": "00:43:12", "text": "是的。"}, {"type": "subtitle", "time": 2597.261, "timestamp": "00:43:17", "text": "我们或许应该玩玩。"}, {"type": "subtitle", "time": 2600.52, "timestamp": "00:43:20", "text": "是的。我不想和你玩。"}, {"type": "subtitle", "time": 2602.137, "timestamp": "00:43:22", "text": "因为他们根本不会说话。"}, {"type": "subtitle", "time": 2606.234, "timestamp": "00:43:26", "text": "是的。"}, {"type": "subtitle", "time": 2610.363, "timestamp": "00:43:30", "text": "就像保持沉默，只是做事一样。"}, {"type": "subtitle", "time": 2614.345, "timestamp": "00:43:34", "text": "比如什么？谈论事情。 ？ 玩游戏的时候怎么说话？"}, {"type": "subtitle", "time": 2619.469, "timestamp": "00:43:39", "text": "精确的。你为什么不说话？"}, {"type": "subtitle", "time": 2621.597, "timestamp": "00:43:41", "text": "你玩的时候？你的专注力如何？"}, {"type": "subtitle", "time": 2621.96, "timestamp": "00:43:41", "text": "是？"}, {"type": "subtitle", "time": 2623.088, "timestamp": "00:43:43", "text": "该死。"}, {"type": "subtitle", "time": 2625.426, "timestamp": "00:43:45", "text": "我太专注了。对不起。"}, {"type": "subtitle", "time": 2630.237, "timestamp": "00:43:50", "text": "是的。我们甚至都不能玩游戏。"}, {"type": "subtitle", "time": 2637.396, "timestamp": "00:43:57", "text": "冷静下来。我们没有办法，该怎么做……"}, {"type": "subtitle", "time": 2639.369, "timestamp": "00:43:59", "text": "那款关于攀爬的游戏叫什么名字？"}]
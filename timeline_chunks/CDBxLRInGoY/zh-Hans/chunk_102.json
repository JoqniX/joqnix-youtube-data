[{"type": "subtitle", "time": 6120.134, "timestamp": "01:42:00", "text": "好了，我的2小时直播。"}, {"type": "subtitle", "time": 6122.555, "timestamp": "01:42:02", "text": "已经过去两个小时了。"}, {"type": "subtitle", "time": 6125.849, "timestamp": "01:42:05", "text": "是的。"}, {"type": "subtitle", "time": 6128.78, "timestamp": "01:42:08", "text": "太疯狂了。"}, {"type": "subtitle", "time": 6133.413, "timestamp": "01:42:13", "text": "是的。你知道吗？我们应该玩"}, {"type": "subtitle", "time": 6137.168, "timestamp": "01:42:17", "text": "总有一天会达到巅峰。如果你想玩的话，"}, {"type": "subtitle", "time": 6137.722, "timestamp": "01:42:17", "text": "告诉我。"}, {"type": "subtitle", "time": 6141.694, "timestamp": "01:42:21", "text": "哦，是的，是的，是的。真的吗？当然。"}, {"type": "subtitle", "time": 6152.929, "timestamp": "01:42:32", "text": "是的。我有朋友一起玩吗？"}, {"type": "subtitle", "time": 6159.702, "timestamp": "01:42:39", "text": "是的，相当不错。那就是"}, {"type": "subtitle", "time": 6161.788, "timestamp": "01:42:41", "text": "我停止玩手机游戏的原因"}, {"type": "subtitle", "time": 6166.306, "timestamp": "01:42:46", "text": "竞争对手。因为我孤身一人。"}, {"type": "subtitle", "time": 6166.634, "timestamp": "01:42:46", "text": "玩。"}, {"type": "subtitle", "time": 6170.453, "timestamp": "01:42:50", "text": "我想知道如果我没有……会发生什么。"}, {"type": "subtitle", "time": 6173.119, "timestamp": "01:42:53", "text": "没人陪我玩。那"}, {"type": "subtitle", "time": 6176.144, "timestamp": "01:42:56", "text": "我会玩哪些游戏之类的？我总是"}, {"type": "subtitle", "time": 6176.906, "timestamp": "01:42:56", "text": "我问这个问题。"}, {"type": "subtitle", "time": 6179.179, "timestamp": "01:42:59", "text": "这就是我玩《哈迪斯》这类游戏的原因，你知道的。"}]
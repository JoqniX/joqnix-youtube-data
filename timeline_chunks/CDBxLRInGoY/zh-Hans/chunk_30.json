[{"type": "subtitle", "time": 1804.08, "timestamp": "00:30:04", "text": "是的。哦，你现在可以说了吗？"}, {"type": "subtitle", "time": 1809.047, "timestamp": "00:30:09", "text": "正确的。"}, {"type": "subtitle", "time": 1811.892, "timestamp": "00:30:11", "text": "我的天啊。不，别告诉我。"}, {"type": "subtitle", "time": 1814.22, "timestamp": "00:30:14", "text": "我不记得了。好了，就是这样。"}, {"type": "subtitle", "time": 1816.41, "timestamp": "00:30:16", "text": "非常接近。你知道以前发生过什么吗？"}, {"type": "subtitle", "time": 1818.724, "timestamp": "00:30:18", "text": "在那个时代，你会怎么说？你已经"}, {"type": "subtitle", "time": 1821.164, "timestamp": "00:30:21", "text": "毒"}, {"type": "subtitle", "time": 1825.442, "timestamp": "00:30:25", "text": "中毒的严重程度会是什么？"}, {"type": "subtitle", "time": 1826.272, "timestamp": "00:30:26", "text": "请说一句话？"}, {"type": "subtitle", "time": 1834.669, "timestamp": "00:30:34", "text": "我的上帝。我当时就想，什么？"}, {"type": "subtitle", "time": 1837.763, "timestamp": "00:30:37", "text": "天哪，他是不是中风了？ 那到底是什么东西？什么？"}, {"type": "subtitle", "time": 1844.8029999999999, "timestamp": "00:30:44", "text": "美好的旧时光。非常好。"}, {"type": "subtitle", "time": 1848.455, "timestamp": "00:30:48", "text": "美好的旧时光。那已经是好久以前的事了。"}, {"type": "subtitle", "time": 1849.102, "timestamp": "00:30:49", "text": "两年。"}, {"type": "subtitle", "time": 1852.901, "timestamp": "00:30:52", "text": "是的，那已经是旧闻了。你当时就像是，"}, {"type": "subtitle", "time": 1854.414, "timestamp": "00:30:54", "text": "你当时真是对我厌烦透了。"}, {"type": "subtitle", "time": 1859.493, "timestamp": "00:30:59", "text": "我真是受够你了。当然。经过"}]
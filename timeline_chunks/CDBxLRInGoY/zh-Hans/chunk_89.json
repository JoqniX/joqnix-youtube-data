[{"type": "subtitle", "time": 5364.361, "timestamp": "01:29:24", "text": "这辆车。嗯。哦，今晚我有"}, {"type": "subtitle", "time": 5371.409, "timestamp": "01:29:31", "text": "又是一个夜晚。不，只是一件小事。"}, {"type": "subtitle", "time": 5379.349, "timestamp": "01:29:39", "text": "权力。我？"}, {"type": "subtitle", "time": 5381.425, "timestamp": "01:29:41", "text": "不，我拿不起来。"}, {"type": "subtitle", "time": 5387.365, "timestamp": "01:29:47", "text": "是啊，你为什么不玩呢？我上去了好多地方。"}, {"type": "subtitle", "time": 5393.764, "timestamp": "01:29:53", "text": "水平很高，你知道的。我认为是52。"}, {"type": "subtitle", "time": 5397.575, "timestamp": "01:29:57", "text": "兄弟，我卡在30岁了。怎么办？"}]
[{"type": "subtitle", "time": 3904.265, "timestamp": "01:05:04", "text": "快点。你不能，你不能，你不能"}, {"type": "subtitle", "time": 3907.341, "timestamp": "01:05:07", "text": "要为朋友付出努力。快点 。"}, {"type": "subtitle", "time": 3909.293, "timestamp": "01:05:09", "text": "快点。"}, {"type": "subtitle", "time": 3912.684, "timestamp": "01:05:12", "text": "如果你愿意，我们可以一起玩漫威宿敌。"}, {"type": "subtitle", "time": 3913.159, "timestamp": "01:05:13", "text": "他们想要。"}, {"type": "subtitle", "time": 3924.438, "timestamp": "01:05:24", "text": "等等，你到底有没有安装它？我？"}, {"type": "subtitle", "time": 3926.572, "timestamp": "01:05:26", "text": "我没有安装它。我们可以玩"}, {"type": "subtitle", "time": 3929.77, "timestamp": "01:05:29", "text": "又是新的一天。你懂的，眨眨眼。"}, {"type": "subtitle", "time": 3931.293, "timestamp": "01:05:31", "text": "这样可行。"}, {"type": "subtitle", "time": 3936.568, "timestamp": "01:05:36", "text": "是的。与此同时，我总可以"}, {"type": "subtitle", "time": 3938.663, "timestamp": "01:05:38", "text": "进入游戏，探索一切"}, {"type": "subtitle", "time": 3940.593, "timestamp": "01:05:40", "text": "新设计是为了方便他们"}, {"type": "subtitle", "time": 3940.98, "timestamp": "01:05:40", "text": "玩。"}, {"type": "subtitle", "time": 3943.169, "timestamp": "01:05:43", "text": "是的。"}, {"type": "subtitle", "time": 3949.769, "timestamp": "01:05:49", "text": "但是，没错，伙计们，当他们玩漫威游戏的时候。"}, {"type": "subtitle", "time": 3952.156, "timestamp": "01:05:52", "text": "竞争对手们，别让女人影响了你们。"}, {"type": "subtitle", "time": 3955.119, "timestamp": "01:05:55", "text": "去烦他们一下，好吗？别让"}]
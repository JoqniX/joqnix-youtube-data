[{"type": "subtitle", "time": 5882.072, "timestamp": "01:38:02", "text": "我想念Roku。"}, {"type": "subtitle", "time": 5884.343, "timestamp": "01:38:04", "text": "用户评价。这就像……"}, {"type": "subtitle", "time": 5886.983, "timestamp": "01:38:06", "text": "用户评价。你觉得怎么样？"}, {"type": "subtitle", "time": 5892.451, "timestamp": "01:38:12", "text": "这个项目？我的意思是，这对……有好处吗？"}, {"type": "subtitle", "time": 5895.092, "timestamp": "01:38:15", "text": "你觉得头疼吗？多少？"}, {"type": "subtitle", "time": 5897.182, "timestamp": "01:38:17", "text": "他有什么问题？多少次"}, {"type": "subtitle", "time": 5901.159, "timestamp": "01:38:21", "text": "她在你的信息里哭了吗？请把这个给我们"}, {"type": "subtitle", "time": 5901.733, "timestamp": "01:38:21", "text": "审查。"}, {"type": "subtitle", "time": 5903.995, "timestamp": "01:38:23", "text": "是的。"}, {"type": "subtitle", "time": 5909.629, "timestamp": "01:38:29", "text": "你是个好朋友。别担心"}, {"type": "subtitle", "time": 5915.158, "timestamp": "01:38:35", "text": "那。听到这个消息我很高兴。出色的。"}, {"type": "subtitle", "time": 5920.147, "timestamp": "01:38:40", "text": "我还记得我初到日本时的情景。"}, {"type": "subtitle", "time": 5920.796, "timestamp": "01:38:40", "text": "我和……谈过"}, {"type": "subtitle", "time": 5925.137, "timestamp": "01:38:45", "text": "是的，今年。"}, {"type": "subtitle", "time": 5931.626, "timestamp": "01:38:51", "text": "我立刻给他讲故事，"}]
[{"type": "subtitle", "time": 1562.124, "timestamp": "00:26:02", "text": "。我刚才是不是说它不错？是 贫穷也挺好的。在哪种类型中"}, {"type": "subtitle", "time": 1566.357, "timestamp": "00:26:06", "text": "贫穷也挺好的。在哪种类型中 你住在桥的哪个位置？"}, {"type": "subtitle", "time": 1573.36, "timestamp": "00:26:13", "text": "不，我不是那个意思。我想要"}, {"type": "subtitle", "time": 1576.167, "timestamp": "00:26:16", "text": "我的意思是，嗯，我的意思是，我是什么意思？"}, {"type": "subtitle", "time": 1579.189, "timestamp": "00:26:19", "text": "我是什么意思？我是什么意思？嗯？"}, {"type": "subtitle", "time": 1584.41, "timestamp": "00:26:24", "text": "你知道，这种情况我们每个人都会遇到。"}, {"type": "subtitle", "time": 1586.692, "timestamp": "00:26:26", "text": "我们只是随便说说而已。"}, {"type": "subtitle", "time": 1589.283, "timestamp": "00:26:29", "text": "完成句子。就这样"}, {"type": "subtitle", "time": 1591.286, "timestamp": "00:26:31", "text": "这说明你词汇量匮乏。"}, {"type": "subtitle", "time": 1596.432, "timestamp": "00:26:36", "text": "太完美了。词汇？嗯，是的。"}, {"type": "subtitle", "time": 1599.603, "timestamp": "00:26:39", "text": "我的英语很差。所以我觉得很难"}, {"type": "subtitle", "time": 1600.496, "timestamp": "00:26:40", "text": "词汇。"}, {"type": "subtitle", "time": 1604.948, "timestamp": "00:26:44", "text": "是的。谁的英语很好？ ？"}, {"type": "subtitle", "time": 1606.888, "timestamp": "00:26:46", "text": "是的。你"}, {"type": "subtitle", "time": 1609.919, "timestamp": "00:26:49", "text": "你会说英语，你呼吸的空气里都充满了英语。"}, {"type": "subtitle", "time": 1612.097, "timestamp": "00:26:52", "text": "或许你会留下来。"}, {"type": "subtitle", "time": 1614.218, "timestamp": "00:26:54", "text": "他真是尤里这里一位相当出色的年轻人。哦，"}, {"type": "subtitle", "time": 1614.882, "timestamp": "00:26:54", "text": "快点。"}, {"type": "subtitle", "time": 1616.662, "timestamp": "00:26:56", "text": "哦是的。是的。是的。"}, {"type": "subtitle", "time": 1618.879, "timestamp": "00:26:58", "text": "我们开着灯。海之血 。"}, {"type": "subtitle", "time": 1619.442, "timestamp": "00:26:59", "text": "。 哦是的。是的。他们都擅长"}]
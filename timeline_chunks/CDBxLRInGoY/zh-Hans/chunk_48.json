[{"type": "subtitle", "time": 2882.397, "timestamp": "00:48:02", "text": "我不打算玩。我们不会……我们不会 玩。"}, {"type": "subtitle", "time": 2883.038, "timestamp": "00:48:03", "text": "玩。 进入巅峰。"}, {"type": "subtitle", "time": 2888.172, "timestamp": "00:48:08", "text": "不，我现在不会下载。"}, {"type": "subtitle", "time": 2890.404, "timestamp": "00:48:10", "text": "我甚至无法控制自己。"}, {"type": "subtitle", "time": 2893.251, "timestamp": "00:48:13", "text": "你知道我现在在做什么吗？"}, {"type": "subtitle", "time": 2895.549, "timestamp": "00:48:15", "text": "同样在这里？你知道我在做什么吗？"}, {"type": "subtitle", "time": 2898.62, "timestamp": "00:48:18", "text": "现在？我躺着。我的"}, {"type": "subtitle", "time": 2900.611, "timestamp": "00:48:20", "text": "电脑在我头顶上方，我"}, {"type": "subtitle", "time": 2903.302, "timestamp": "00:48:23", "text": "我在放松。让我放松一下"}, {"type": "subtitle", "time": 2904.738, "timestamp": "00:48:24", "text": "在我跟你说话的时候。"}, {"type": "subtitle", "time": 2909.03, "timestamp": "00:48:29", "text": "如果你想玩《Peak》，你可以"}, {"type": "subtitle", "time": 2911.436, "timestamp": "00:48:31", "text": "应该早点说的。你知道，这只是"}, {"type": "subtitle", "time": 2913.705, "timestamp": "00:48:33", "text": "你做了这一切，我们才有了今天的成就。"}, {"type": "subtitle", "time": 2915.419, "timestamp": "00:48:35", "text": "是的，这是一个，这是一个……"}, {"type": "subtitle", "time": 2919.008, "timestamp": "00:48:39", "text": "确切地。这就是我这么说的原因。"}, {"type": "subtitle", "time": 2920.584, "timestamp": "00:48:40", "text": "我们应该玩午夜换班游戏"}, {"type": "subtitle", "time": 2922.794, "timestamp": "00:48:42", "text": "总有一天，你知道的。眨眼，眨眼。"}, {"type": "subtitle", "time": 2924.953, "timestamp": "00:48:44", "text": "拜托，伙计们。你不喜欢……"}, {"type": "subtitle", "time": 2934.513, "timestamp": "00:48:54", "text": "吓了一跳？他们不喜欢吗？不"}, {"type": "subtitle", "time": 2936.627, "timestamp": "00:48:56", "text": "恐慌。但我发不出声。"}]
[{"type": "subtitle", "time": 3364.043, "timestamp": "00:56:04", "text": "福里斯特，如果你愿意的话，总有一天会的。经过 假设。"}, {"type": "subtitle", "time": 3373.522, "timestamp": "00:56:13", "text": "是的，你应该玩《Valorant》。"}, {"type": "subtitle", "time": 3379.388, "timestamp": "00:56:19", "text": "不，不，不。我宁愿不这样做。"}, {"type": "subtitle", "time": 3384.871, "timestamp": "00:56:24", "text": "我宁愿不这样做，因为我知道"}, {"type": "subtitle", "time": 3387.825, "timestamp": "00:56:27", "text": "我不打算玩。我永远不会玩它 。你知道我在冥界待了多少个小时吗？"}, {"type": "subtitle", "time": 3392.582, "timestamp": "00:56:32", "text": "。你知道我在冥界待了多少个小时吗？ 现在有2个吗？"}, {"type": "subtitle", "time": 3396.178, "timestamp": "00:56:36", "text": "哈迪斯2. 哦，"}, {"type": "subtitle", "time": 3404.013, "timestamp": "00:56:44", "text": "你知道，就是那种roguelike游戏。出色地，"}, {"type": "subtitle", "time": 3405.0, "timestamp": "00:56:45", "text": "可能是 Rust。"}, {"type": "subtitle", "time": 3407.17, "timestamp": "00:56:47", "text": "20 小时后，我想用 Rust。"}, {"type": "subtitle", "time": 3414.131, "timestamp": "00:56:54", "text": "拜托，老兄。如果你年纪还不算大，"}, {"type": "subtitle", "time": 3415.308, "timestamp": "00:56:55", "text": "兄弟。"}, {"type": "subtitle", "time": 3417.461, "timestamp": "00:56:57", "text": "另外，我觉得你需要很多东西。"}, {"type": "subtitle", "time": 3419.303, "timestamp": "00:56:59", "text": "大约10个人玩Rust"}, {"type": "subtitle", "time": 3419.83, "timestamp": "00:56:59", "text": "还。"}]
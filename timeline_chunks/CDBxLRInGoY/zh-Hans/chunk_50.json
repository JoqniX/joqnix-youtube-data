[{"type": "subtitle", "time": 3002.107, "timestamp": "00:50:02", "text": "是的。你要去"}, {"type": "subtitle", "time": 3005.186, "timestamp": "00:50:05", "text": "是的。对不起。我当时正在下载。"}, {"type": "subtitle", "time": 3008.727, "timestamp": "00:50:08", "text": "你说话的时候我们跳了起来。想"}, {"type": "subtitle", "time": 3019.675, "timestamp": "00:50:19", "text": "现在练习说“就像我想要的那样”"}, {"type": "subtitle", "time": 3020.237, "timestamp": "00:50:20", "text": "挑战。"}, {"type": "subtitle", "time": 3024.255, "timestamp": "00:50:24", "text": "所以，你当时在玩游戏吗？只是"}, {"type": "subtitle", "time": 3026.091, "timestamp": "00:50:26", "text": "你说话的时候“正处于巅峰状态”。"}, {"type": "subtitle", "time": 3027.81, "timestamp": "00:50:27", "text": "和我们一起吗？这就是你的工作吗？"}, {"type": "subtitle", "time": 3030.181, "timestamp": "00:50:30", "text": "不，不，不。跳跃。"}, {"type": "subtitle", "time": 3032.029, "timestamp": "00:50:32", "text": "飞跃。"}, {"type": "subtitle", "time": 3035.272, "timestamp": "00:50:35", "text": "如何与你一起做到。” 高峰“"}, {"type": "subtitle", "time": 3038.184, "timestamp": "00:50:38", "text": "下次。并不真地。"}, {"type": "subtitle", "time": 3041.196, "timestamp": "00:50:41", "text": "夜班。快点。快点。转移"}, {"type": "subtitle", "time": 3047.489, "timestamp": "00:50:47", "text": "午夜时分。快点。快点。我不知道。"}, {"type": "subtitle", "time": 3048.85, "timestamp": "00:50:48", "text": "五四只火鸡。"}, {"type": "subtitle", "time": 3053.228, "timestamp": "00:50:53", "text": "我的天啊。这是其中之一"}, {"type": "subtitle", "time": 3058.309, "timestamp": "00:50:58", "text": "1,000。我不这么认为。"}]
[{"type": "subtitle", "time": 3541.348, "timestamp": "00:59:01", "text": "这是一种上瘾行为，对吧？如果你停下来"}, {"type": "subtitle", "time": 3543.447, "timestamp": "00:59:03", "text": "喝一杯酒，然后再喝一杯。"}, {"type": "subtitle", "time": 3544.201, "timestamp": "00:59:04", "text": "你还想要更多。"}, {"type": "subtitle", "time": 3547.618, "timestamp": "00:59:07", "text": "这就是这款游戏对我的影响。"}, {"type": "subtitle", "time": 3550.345, "timestamp": "00:59:10", "text": "我找到了我们能玩的最好的游戏"}, {"type": "subtitle", "time": 3551.047, "timestamp": "00:59:11", "text": "一起玩。"}, {"type": "subtitle", "time": 3553.141, "timestamp": "00:59:13", "text": "他们三个。"}, {"type": "subtitle", "time": 3553.952, "timestamp": "00:59:13", "text": "别说"}, {"type": "subtitle", "time": 3556.093, "timestamp": "00:59:16", "text": "鸟类游戏三。"}, {"type": "subtitle", "time": 3559.065, "timestamp": "00:59:19", "text": "鸟类游戏三"}, {"type": "subtitle", "time": 3562.236, "timestamp": "00:59:22", "text": "感觉就像我们只是在互相啄食一样。"}, {"type": "subtitle", "time": 3568.024, "timestamp": "00:59:28", "text": "我们断绝了联系。你是"}, {"type": "subtitle", "time": 3568.512, "timestamp": "00:59:28", "text": "鸟。"}, {"type": "subtitle", "time": 3574.718, "timestamp": "00:59:34", "text": "你对另一个发出“咔咔咔”的声音。"}, {"type": "subtitle", "time": 3576.702, "timestamp": "00:59:36", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 3580.426, "timestamp": "00:59:40", "text": "让我看看评价。"}, {"type": "subtitle", "time": 3584.301, "timestamp": "00:59:44", "text": "我们需要添加一些机器人之类的东西。"}, {"type": "subtitle", "time": 3586.027, "timestamp": "00:59:46", "text": "直到我们有更多玩家为止"}, {"type": "subtitle", "time": 3586.434, "timestamp": "00:59:46", "text": "真实的。"}, {"type": "subtitle", "time": 3590.269, "timestamp": "00:59:50", "text": "他"}, {"type": "subtitle", "time": 3596.808, "timestamp": "00:59:56", "text": "这就像是“你知道吗？”我认为"}, {"type": "subtitle", "time": 3598.822, "timestamp": "00:59:58", "text": "看来我们只能玩毛步枪了。"}]
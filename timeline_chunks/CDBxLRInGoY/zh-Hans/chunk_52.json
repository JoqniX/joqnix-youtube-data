[{"type": "subtitle", "time": 3120.662, "timestamp": "00:52:00", "text": "是的。你玩过另一款游戏吗？"}, {"type": "subtitle", "time": 3122.558, "timestamp": "00:52:02", "text": "叫做“和朋友打赌”？"}, {"type": "subtitle", "time": 3127.508, "timestamp": "00:52:07", "text": "和朋友们打赌。呃，就这么简单。"}, {"type": "subtitle", "time": 3130.856, "timestamp": "00:52:10", "text": "打赌？不，感觉不像，你知道吗？"}, {"type": "subtitle", "time": 3135.274, "timestamp": "00:52:15", "text": "就是那个赌场追踪器。是的。"}, {"type": "subtitle", "time": 3139.673, "timestamp": "00:52:19", "text": "是的。它给了我那种感觉。"}, {"type": "subtitle", "time": 3141.86, "timestamp": "00:52:21", "text": "有一款名为“机器”的新游戏"}, {"type": "subtitle", "time": 3143.947, "timestamp": "00:52:23", "text": "派对“人们正在玩”。"}, {"type": "subtitle", "time": 3149.763, "timestamp": "00:52:29", "text": "啊，是的。是的。我看到了。我看到了。有一个"}, {"type": "subtitle", "time": 3150.853, "timestamp": "00:52:30", "text": "发射，呃"}, {"type": "subtitle", "time": 3151.316, "timestamp": "00:52:31", "text": "是的"}, {"type": "subtitle", "time": 3153.941, "timestamp": "00:52:33", "text": "目前正在进行目录征集活动。"}, {"type": "subtitle", "time": 3156.942, "timestamp": "00:52:36", "text": "真是太血腥了，不是吗？"}, {"type": "subtitle", "time": 3158.53, "timestamp": "00:52:38", "text": "血。"}, {"type": "subtitle", "time": 3165.048, "timestamp": "00:52:45", "text": "是的。呃，那是什么游戏来着？ ？"}, {"type": "subtitle", "time": 3171.747, "timestamp": "00:52:51", "text": "巴克。是的，巴克肖特。我认为是"}, {"type": "subtitle", "time": 3173.928, "timestamp": "00:52:53", "text": "类似那样，但是……就像"}, {"type": "subtitle", "time": 3176.825, "timestamp": "00:52:56", "text": "《马里奥派对》也是。你和你的"}, {"type": "subtitle", "time": 3178.87, "timestamp": "00:52:58", "text": "朋友，但只有我们三个。"}]
[{"type": "subtitle", "time": 5523.148, "timestamp": "01:32:03", "text": "是的，只有一个玩家。"}, {"type": "subtitle", "time": 5527.988, "timestamp": "01:32:07", "text": "我做到了。其他人是什么样的人？"}, {"type": "subtitle", "time": 5530.524, "timestamp": "01:32:10", "text": "是的，那就是我。这就是我。"}, {"type": "subtitle", "time": 5532.806, "timestamp": "01:32:12", "text": "对，就是这样。"}, {"type": "subtitle", "time": 5540.829, "timestamp": "01:32:20", "text": "我做了。我想我记得。"}, {"type": "subtitle", "time": 5541.256, "timestamp": "01:32:21", "text": "我"}, {"type": "subtitle", "time": 5547.944, "timestamp": "01:32:27", "text": "所以。于是我想，“好吧，我们走吧。”"}, {"type": "subtitle", "time": 5550.555, "timestamp": "01:32:30", "text": "让玩家能够快速地独自玩这款游戏。"}, {"type": "subtitle", "time": 5555.72, "timestamp": "01:32:35", "text": "我把时间都花在看速通视频上了。"}, {"type": "subtitle", "time": 5563.193, "timestamp": "01:32:43", "text": "我玩过所有游戏，而且都是速通。是的，甚至"}, {"type": "subtitle", "time": 5565.235, "timestamp": "01:32:45", "text": "不知为何，我开始看Palworld了。"}, {"type": "subtitle", "time": 5565.677, "timestamp": "01:32:45", "text": "原因。"}, {"type": "subtitle", "time": 5570.992, "timestamp": "01:32:50", "text": "是的，就像"}, {"type": "subtitle", "time": 5574.717, "timestamp": "01:32:54", "text": "速通所有游戏。不"}, {"type": "subtitle", "time": 5576.424, "timestamp": "01:32:56", "text": "我们当时并不是想玩得开心。"}]
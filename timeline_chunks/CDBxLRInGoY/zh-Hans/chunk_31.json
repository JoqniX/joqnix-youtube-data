[{"type": "subtitle", "time": 1862.105, "timestamp": "00:31:02", "text": "假设。谁说的？甚至连这都不是。"}, {"type": "subtitle", "time": 1863.046, "timestamp": "00:31:03", "text": "它甚至算不上一个"}, {"type": "subtitle", "time": 1866.629, "timestamp": "00:31:06", "text": "这让我想起了……"}, {"type": "subtitle", "time": 1874.152, "timestamp": "00:31:14", "text": "安托。没有比赛。没有生活。"}, {"type": "subtitle", "time": 1876.101, "timestamp": "00:31:16", "text": "哦，"}, {"type": "subtitle", "time": 1879.05, "timestamp": "00:31:19", "text": "是的。"}, {"type": "subtitle", "time": 1882.507, "timestamp": "00:31:22", "text": "更何况我根本不看动漫，但是"}, {"type": "subtitle", "time": 1884.29, "timestamp": "00:31:24", "text": "即便如此，我还是明白了这个典故。"}, {"type": "subtitle", "time": 1890.97, "timestamp": "00:31:30", "text": "是的。是的。不错的动漫。不错的动漫。"}, {"type": "subtitle", "time": 1894.518, "timestamp": "00:31:34", "text": "是的。永远不会有第二个了。"}, {"type": "subtitle", "time": 1895.084, "timestamp": "00:31:35", "text": "季节。"}, {"type": "subtitle", "time": 1898.834, "timestamp": "00:31:38", "text": "是的。它有续集吗？ ？"}, {"type": "subtitle", "time": 1902.29, "timestamp": "00:31:42", "text": "我觉得他写过轻小说。是的。"}, {"type": "subtitle", "time": 1905.971, "timestamp": "00:31:45", "text": "现在是晚上吗？好的。一部轻小说"}, {"type": "subtitle", "time": 1908.36, "timestamp": "00:31:48", "text": "这未免太夸张了。"}, {"type": "subtitle", "time": 1910.616, "timestamp": "00:31:50", "text": "你知道，就像续集一样"}, {"type": "subtitle", "time": 1914.674, "timestamp": "00:31:54", "text": "第二季之类的。小说"}, {"type": "subtitle", "time": 1916.491, "timestamp": "00:31:56", "text": "我觉得没那么亮。"}]
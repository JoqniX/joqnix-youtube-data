[{"type": "subtitle", "time": 6002.485, "timestamp": "01:40:02", "text": "我的天啊。哦，不。因为"}, {"type": "subtitle", "time": 6004.362, "timestamp": "01:40:04", "text": "你同意吗？快点。"}, {"type": "subtitle", "time": 6005.395, "timestamp": "01:40:05", "text": "你必须如此。"}, {"type": "subtitle", "time": 6019.996, "timestamp": "01:40:19", "text": "是的。去吃点东西吧。"}, {"type": "subtitle", "time": 6026.547, "timestamp": "01:40:26", "text": "是的，我当时想找点东西吃。"}, {"type": "subtitle", "time": 6028.651, "timestamp": "01:40:28", "text": "我意识到我一无所有。"}, {"type": "subtitle", "time": 6031.668, "timestamp": "01:40:31", "text": "我只有水。于是我喝了水。"}, {"type": "subtitle", "time": 6032.332, "timestamp": "01:40:32", "text": "于是我来到了这里。"}, {"type": "subtitle", "time": 6036.791, "timestamp": "01:40:36", "text": "我们俩的情况一样。"}, {"type": "subtitle", "time": 6037.984, "timestamp": "01:40:37", "text": "是的。"}, {"type": "subtitle", "time": 6041.995, "timestamp": "01:40:41", "text": "不，那里有吃的，你知道的。绝对不行"}, {"type": "subtitle", "time": 6045.826, "timestamp": "01:40:45", "text": "我想吃那个，你懂我的意思吧。"}, {"type": "subtitle", "time": 6046.916, "timestamp": "01:40:46", "text": "我是说。知道？"}, {"type": "subtitle", "time": 6051.827, "timestamp": "01:40:51", "text": "我的天哪。是的。你知道你什么时候有"}, {"type": "subtitle", "time": 6053.429, "timestamp": "01:40:53", "text": "同一种东西太多，你就不想再吃了。"}, {"type": "subtitle", "time": 6054.254, "timestamp": "01:40:54", "text": "再吃一次？"}]
[{"type": "subtitle", "time": 2823.726, "timestamp": "00:47:03", "text": "游戏。所以我觉得是这样。 这款游戏不会像，你知道的，"}, {"type": "subtitle", "time": 2826.351, "timestamp": "00:47:06", "text": "这款游戏不会像，你知道的， 一款在线服务型游戏。并非如此"}, {"type": "subtitle", "time": 2831.134, "timestamp": "00:47:11", "text": "一款在线服务型游戏。并非如此 就像《使命召唤》之类的游戏，没错。"}, {"type": "subtitle", "time": 2833.386, "timestamp": "00:47:13", "text": "就像《使命召唤》之类的游戏，没错。 你知道。"}, {"type": "subtitle", "time": 2838.863, "timestamp": "00:47:18", "text": "就像生活一样。"}, {"type": "subtitle", "time": 2843.302, "timestamp": "00:47:23", "text": "是的，我认为它仍然会收到"}, {"type": "subtitle", "time": 2848.904, "timestamp": "00:47:28", "text": "更新信息，对吧？我认为"}, {"type": "subtitle", "time": 2850.737, "timestamp": "00:47:30", "text": "大多数独立游戏并非如此。"}, {"type": "subtitle", "time": 2852.215, "timestamp": "00:47:32", "text": "你知道，就是那种现场服务。"}, {"type": "subtitle", "time": 2856.426, "timestamp": "00:47:36", "text": "所以，我会说这是一场游戏"}, {"type": "subtitle", "time": 2858.966, "timestamp": "00:47:38", "text": "在线服务就像……什么？顶点，"}, {"type": "subtitle", "time": 2862.099, "timestamp": "00:47:42", "text": "正如我刚才所说，《使命召唤》……"}, {"type": "subtitle", "time": 2867.216, "timestamp": "00:47:47", "text": "《守望先锋》、《漫威劲敌》等游戏"}, {"type": "subtitle", "time": 2869.273, "timestamp": "00:47:49", "text": "你知道，他们通常会打架，他们明白这一点。"}, {"type": "subtitle", "time": 2871.445, "timestamp": "00:47:51", "text": "实时更新，直到它们"}, {"type": "subtitle", "time": 2876.143, "timestamp": "00:47:56", "text": "被遗弃并达到极限。好的 没有"}, {"type": "subtitle", "time": 2876.991, "timestamp": "00:47:56", "text": "没有 就这些了，伙计。"}, {"type": "subtitle", "time": 2878.954, "timestamp": "00:47:58", "text": "就这些了，伙计。 进入巅峰。"}, {"type": "subtitle", "time": 2879.86, "timestamp": "00:47:59", "text": "进入巅峰。 我不打算玩。我们不会……我们不会"}]
[{"type": "subtitle", "time": 3842.267, "timestamp": "01:04:02", "text": "我不在乎它是什么。我更喜欢Shift键。"}, {"type": "subtitle", "time": 3850.536, "timestamp": "01:04:10", "text": "午夜时分。哦，不。好吧。那"}, {"type": "subtitle", "time": 3851.69, "timestamp": "01:04:11", "text": "我们呢？"}, {"type": "subtitle", "time": 3855.14, "timestamp": "01:04:15", "text": "是的，我也觉得这个主意不错。"}, {"type": "subtitle", "time": 3859.025, "timestamp": "01:04:19", "text": "我的天啊。各位，这是个约会。是"}, {"type": "subtitle", "time": 3877.717, "timestamp": "01:04:37", "text": "约会。约会定好了。脸。哦，拜"}, {"type": "subtitle", "time": 3881.976, "timestamp": "01:04:41", "text": "上帝。等等，你有计划吗？"}, {"type": "subtitle", "time": 3886.955, "timestamp": "01:04:46", "text": "等等，我没玩懂这个游戏。哪个 ？"}, {"type": "subtitle", "time": 3887.189, "timestamp": "01:04:47", "text": "？ 是的。"}, {"type": "subtitle", "time": 3889.8, "timestamp": "01:04:49", "text": "嘿，午夜。"}, {"type": "subtitle", "time": 3896.334, "timestamp": "01:04:56", "text": "那就买给他吧。快点。"}, {"type": "subtitle", "time": 3899.374, "timestamp": "01:04:59", "text": "我现在身无分文。不能。"}]
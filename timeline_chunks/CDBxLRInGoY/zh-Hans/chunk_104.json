[{"type": "subtitle", "time": 6246.047, "timestamp": "01:44:06", "text": "所以，如果已经有了交易，就赶紧成交吧。"}, {"type": "subtitle", "time": 6248.791, "timestamp": "01:44:08", "text": "等等，啊，是的。我必须"}, {"type": "subtitle", "time": 6254.839, "timestamp": "01:44:14", "text": "结束直播。我来了。所以"}, {"type": "subtitle", "time": 6259.32, "timestamp": "01:44:19", "text": "是的，我们会完成的。抱歉"}, {"type": "subtitle", "time": 6262.104, "timestamp": "01:44:22", "text": "直播时间很短，只有2个小时。"}, {"type": "subtitle", "time": 6262.805, "timestamp": "01:44:22", "text": "但是如果。"}, {"type": "subtitle", "time": 6265.004, "timestamp": "01:44:25", "text": "图表上小于 6。"}, {"type": "subtitle", "time": 6269.434, "timestamp": "01:44:29", "text": "2 小时很短，而 6 小时很长。"}, {"type": "subtitle", "time": 6273.868, "timestamp": "01:44:33", "text": "你知道，你知道该怎么做"}, {"type": "subtitle", "time": 6277.717, "timestamp": "01:44:37", "text": "你知道我觉得我的身高有多矮吗？"}, {"type": "subtitle", "time": 6280.405, "timestamp": "01:44:40", "text": "对我来说，4个小时的直播时间太短了。"}, {"type": "subtitle", "time": 6282.892, "timestamp": "01:44:42", "text": "我们过去常说短，但现在是"}, {"type": "subtitle", "time": 6288.169, "timestamp": "01:44:48", "text": "只要，但它高于"}, {"type": "subtitle", "time": 6288.669, "timestamp": "01:44:48", "text": "平均的。"}, {"type": "subtitle", "time": 6290.969, "timestamp": "01:44:50", "text": "是的。"}]
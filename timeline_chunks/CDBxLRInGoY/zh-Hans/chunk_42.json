[{"type": "subtitle", "time": 2521.498, "timestamp": "00:42:01", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 2525.124, "timestamp": "00:42:05", "text": "呃，你为什么不加入我们呢？"}, {"type": "subtitle", "time": 2526.135, "timestamp": "00:42:06", "text": "平行线，布拉德？"}, {"type": "subtitle", "time": 2530.368, "timestamp": "00:42:10", "text": "好的。好的。哇。哇。什么样的"}, {"type": "subtitle", "time": 2535.346, "timestamp": "00:42:15", "text": "这是敲诈勒索的手段吗？什么？茶"}, {"type": "subtitle", "time": 2537.232, "timestamp": "00:42:17", "text": "你还记得那些旧时光吗？"}, {"type": "subtitle", "time": 2540.693, "timestamp": "00:42:20", "text": "我们以前玩过那个游戏。经过"}, {"type": "subtitle", "time": 2543.597, "timestamp": "00:42:23", "text": "为什么他们不加入我们，一起探讨“为什么？”"}, {"type": "subtitle", "time": 2546.509, "timestamp": "00:42:26", "text": "因为我能。"}, {"type": "subtitle", "time": 2550.175, "timestamp": "00:42:30", "text": "拜托，伙计们。因为你可以。"}, {"type": "subtitle", "time": 2558.257, "timestamp": "00:42:38", "text": "哦，闭嘴。闭上你的“你知道吗？” 我们应该玩什么游戏？大概"}, {"type": "subtitle", "time": 2560.453, "timestamp": "00:42:40", "text": "我们应该玩什么游戏？大概 比如午夜轮班之类的，因为"}, {"type": "subtitle", "time": 2562.51, "timestamp": "00:42:42", "text": "比如午夜轮班之类的，因为 他们会尿裤子的。"}, {"type": "subtitle", "time": 2570.359, "timestamp": "00:42:50", "text": "就是这样，对吧？只有一个"}, {"type": "subtitle", "time": 2571.645, "timestamp": "00:42:51", "text": "你在射击变形怪吗？"}, {"type": "chat", "time": 2574.803, "timestamp": "00:42:54", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "You can still post your birthday wishes for me here - https://onxa.link/JoqniXBDay2026"}, {"type": "subtitle", "time": 2576.067, "timestamp": "00:42:56", "text": "你射杀了变形怪，你就……"}, {"type": "subtitle", "time": 2578.322, "timestamp": "00:42:58", "text": "家庭作业，你知道，就是做家务。"}]
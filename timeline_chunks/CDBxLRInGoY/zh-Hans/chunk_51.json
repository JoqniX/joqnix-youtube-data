[{"type": "subtitle", "time": 3061.067, "timestamp": "00:51:01", "text": "50"}, {"type": "subtitle", "time": 3062.243, "timestamp": "00:51:02", "text": "400。"}, {"type": "subtitle", "time": 3066.25, "timestamp": "00:51:06", "text": "哦，那是400。"}, {"type": "subtitle", "time": 3067.402, "timestamp": "00:51:07", "text": "夜班。"}, {"type": "subtitle", "time": 3071.807, "timestamp": "00:51:11", "text": "是的。哦，我忘了你在日本。"}, {"type": "subtitle", "time": 3081.082, "timestamp": "00:51:21", "text": "是的。躲起来，假装。"}, {"type": "subtitle", "time": 3088.257, "timestamp": "00:51:28", "text": "不，不，不。你，你才是人类。"}, {"type": "subtitle", "time": 3090.51, "timestamp": "00:51:30", "text": "你必须杀死那些伪装的人。"}, {"type": "subtitle", "time": 3092.008, "timestamp": "00:51:32", "text": "是的。"}, {"type": "subtitle", "time": 3095.486, "timestamp": "00:51:35", "text": "嘿，你对这方面了解得应该少一些。"}, {"type": "subtitle", "time": 3097.35, "timestamp": "00:51:37", "text": "为了让游戏更有趣。"}, {"type": "subtitle", "time": 3098.055, "timestamp": "00:51:38", "text": "知道，"}, {"type": "subtitle", "time": 3100.109, "timestamp": "00:51:40", "text": "这才是享受游戏的方式。"}, {"type": "subtitle", "time": 3102.851, "timestamp": "00:51:42", "text": "这是真的。如果有人破坏了你的兴致，"}, {"type": "subtitle", "time": 3105.796, "timestamp": "00:51:45", "text": "情况很糟糕。那？"}, {"type": "subtitle", "time": 3109.961, "timestamp": "00:51:49", "text": "是的，就像你一样。关于树木和"}, {"type": "subtitle", "time": 3110.608, "timestamp": "00:51:50", "text": "那些东西。"}, {"type": "subtitle", "time": 3111.122, "timestamp": "00:51:51", "text": "是的。"}, {"type": "subtitle", "time": 3116.336, "timestamp": "00:51:56", "text": "你随时都可以问我，对吧？"}]
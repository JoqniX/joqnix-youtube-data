[{"type": "subtitle", "time": 5221.194, "timestamp": "01:27:01", "text": "我滑倒了。呃，我觉得我不应该……"}, {"type": "subtitle", "time": 5221.788, "timestamp": "01:27:01", "text": "垂死。"}, {"type": "subtitle", "time": 5239.547, "timestamp": "01:27:19", "text": "我的天啊。绿色保鲜器。那是"}, {"type": "subtitle", "time": 5247.483, "timestamp": "01:27:27", "text": "该死。科迪在你家吗？ 你不打算吃晚饭吗？"}, {"type": "subtitle", "time": 5255.823, "timestamp": "01:27:35", "text": "其实没什么奇怪的。你难道不能吗？"}, {"type": "subtitle", "time": 5256.543, "timestamp": "01:27:36", "text": "准备点什么吗？"}, {"type": "subtitle", "time": 5261.6, "timestamp": "01:27:41", "text": "好的，那么它的特别之处是什么？"}, {"type": "subtitle", "time": 5269.707, "timestamp": "01:27:49", "text": "苏格兰佬？哦，那真是……哦，我的意思是，"}, {"type": "subtitle", "time": 5274.598, "timestamp": "01:27:54", "text": "生日派对结束了。那次我吃了"}]
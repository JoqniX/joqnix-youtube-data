[{"type": "subtitle", "time": 3601.426, "timestamp": "01:00:01", "text": "我想我们就玩这个游戏吧。不再"}, {"type": "subtitle", "time": 3604.438, "timestamp": "01:00:04", "text": "伙计们，给乔布多出点主意吧。不再"}, {"type": "subtitle", "time": 3605.754, "timestamp": "01:00:05", "text": "给乔提供更多建议。"}, {"type": "subtitle", "time": 3611.849, "timestamp": "01:00:11", "text": "是的。呃，你最近在玩什么抽卡游戏？"}, {"type": "subtitle", "time": 3613.111, "timestamp": "01:00:13", "text": "最近玩过吗？"}, {"type": "subtitle", "time": 3617.857, "timestamp": "01:00:17", "text": "哦，当然。扭蛋游戏。这"}, {"type": "subtitle", "time": 3622.889, "timestamp": "01:00:22", "text": "我的人生彻底毁了。原因何在"}, {"type": "subtitle", "time": 3624.754, "timestamp": "01:00:24", "text": "我生活中一直在做着各种事情。"}, {"type": "subtitle", "time": 3629.651, "timestamp": "01:00:29", "text": "唯一，我生命中唯一是"}, {"type": "subtitle", "time": 3630.17, "timestamp": "01:00:30", "text": "可重复。"}, {"type": "subtitle", "time": 3637.299, "timestamp": "01:00:37", "text": "我确实努力过"}, {"type": "subtitle", "time": 3641.735, "timestamp": "01:00:41", "text": "我一直积极参与游戏，只是因为……才停止的。"}, {"type": "subtitle", "time": 3645.111, "timestamp": "01:00:45", "text": "赛博朋克那一套。我玩了，而且"}, {"type": "subtitle", "time": 3647.873, "timestamp": "01:00:47", "text": "我停下来了，正在下载。它"}, {"type": "subtitle", "time": 3649.649, "timestamp": "01:00:49", "text": "我又下载了一遍，只是为了获取"}, {"type": "subtitle", "time": 3651.099, "timestamp": "01:00:51", "text": "在游戏中抢到我的蛋糕。"}, {"type": "subtitle", "time": 3655.619, "timestamp": "01:00:55", "text": "我打算下载原神。"}]
[{"type": "subtitle", "time": 5104.844, "timestamp": "01:25:04", "text": "是的。哦，那也是事实。"}, {"type": "subtitle", "time": 5109.055, "timestamp": "01:25:09", "text": "是的，大宗师。"}, {"type": "subtitle", "time": 5112.802, "timestamp": "01:25:12", "text": "再看看我。我几乎说不出话来。"}, {"type": "subtitle", "time": 5116.75, "timestamp": "01:25:16", "text": "嗯，关键在于学会放手。"}, {"type": "subtitle", "time": 5119.273, "timestamp": "01:25:19", "text": "放手吧。"}, {"type": "subtitle", "time": 5122.13, "timestamp": "01:25:22", "text": "彻底放下吧。别这么想。"}, {"type": "subtitle", "time": 5123.835, "timestamp": "01:25:23", "text": "你必须彻底放手。仅有的"}, {"type": "subtitle", "time": 5126.452, "timestamp": "01:25:26", "text": "稍微松开一点。只是感觉"}, {"type": "subtitle", "time": 5129.79, "timestamp": "01:25:29", "text": "舒服的。这就是我对约伯在事物中的看法。"}, {"type": "subtitle", "time": 5133.324, "timestamp": "01:25:33", "text": "所以。你知道吗，他到现在还没放手？"}, {"type": "subtitle", "time": 5136.632, "timestamp": "01:25:36", "text": "但我感觉这样更自在"}, {"type": "subtitle", "time": 5137.526, "timestamp": "01:25:37", "text": "我保持沉默。"}, {"type": "subtitle", "time": 5139.503, "timestamp": "01:25:39", "text": "是的。"}, {"type": "subtitle", "time": 5142.084, "timestamp": "01:25:42", "text": "是的，这是真的。是的，各位。不"}, {"type": "subtitle", "time": 5144.511, "timestamp": "01:25:44", "text": "我们聊了很多。有讨论吗？"}, {"type": "subtitle", "time": 5144.83, "timestamp": "01:25:44", "text": "这里？"}, {"type": "subtitle", "time": 5150.511, "timestamp": "01:25:50", "text": "呃，我们还能说什么呢？"}, {"type": "subtitle", "time": 5155.462, "timestamp": "01:25:55", "text": "有一天，当周围非常安静的时候，"}]
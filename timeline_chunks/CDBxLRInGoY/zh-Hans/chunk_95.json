[{"type": "subtitle", "time": 5700.868, "timestamp": "01:35:00", "text": "我有一些问题。很多什么"}, {"type": "subtitle", "time": 5702.724, "timestamp": "01:35:02", "text": "谈完多少，多少"}, {"type": "subtitle", "time": 5705.353, "timestamp": "01:35:05", "text": "已经过去多久了？就像一个小时那么长"}, {"type": "subtitle", "time": 5706.802, "timestamp": "01:35:06", "text": "平均的？太疯狂了。"}, {"type": "subtitle", "time": 5710.641, "timestamp": "01:35:10", "text": "我突然想到一个主意。"}, {"type": "subtitle", "time": 5715.331, "timestamp": "01:35:15", "text": "我脑子里突然就冒出了这个想法。就像 够了。"}, {"type": "subtitle", "time": 5728.582, "timestamp": "01:35:28", "text": "我想问你一个问题。嗯，？ 你觉得我怎么样？我们一直是朋友"}, {"type": "subtitle", "time": 5732.144, "timestamp": "01:35:32", "text": "你觉得我怎么样？我们一直是朋友 这么久了。"}, {"type": "subtitle", "time": 5738.452, "timestamp": "01:35:38", "text": "糟糕的决定。"}, {"type": "subtitle", "time": 5740.351, "timestamp": "01:35:40", "text": "是的。什么？"}, {"type": "subtitle", "time": 5747.727, "timestamp": "01:35:47", "text": "不，我开玩笑的。这只是个玩笑。当然是这样"}, {"type": "subtitle", "time": 5751.027, "timestamp": "01:35:51", "text": "开玩笑。但如果真是这样，他就不会是你的朋友了。"}, {"type": "subtitle", "time": 5754.57, "timestamp": "01:35:54", "text": "你知道，那样做你会是个糟糕的朋友。那"}, {"type": "subtitle", "time": 5755.579, "timestamp": "01:35:55", "text": "确实如此。"}, {"type": "subtitle", "time": 5758.903, "timestamp": "01:35:58", "text": "或许我现在是在骗你。"}, {"type": "subtitle", "time": 5759.975, "timestamp": "01:35:59", "text": "相同的。谁知道呢？"}]
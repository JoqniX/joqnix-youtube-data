[{"type": "subtitle", "time": 4871.113, "timestamp": "01:21:11", "text": "不错。你玩过吗？"}, {"type": "subtitle", "time": 4872.137, "timestamp": "01:21:12", "text": "以前玩过英雄射击游戏吗？"}, {"type": "subtitle", "time": 4876.224, "timestamp": "01:21:16", "text": "不。"}, {"type": "subtitle", "time": 4879.818, "timestamp": "01:21:19", "text": "真的吗？呃，Apex。"}, {"type": "subtitle", "time": 4885.206, "timestamp": "01:21:25", "text": "那不是英雄射击游戏。他是个英雄 。"}, {"type": "subtitle", "time": 4885.937, "timestamp": "01:21:25", "text": "。 战斗英雄。"}, {"type": "subtitle", "time": 4892.782, "timestamp": "01:21:32", "text": "所以，你的意思是……"}, {"type": "subtitle", "time": 4894.814, "timestamp": "01:21:34", "text": "《Valorant》是一款英雄射击游戏。我会给你"}, {"type": "subtitle", "time": 4898.346, "timestamp": "01:21:38", "text": "打脖子一巴掌。说出来。"}, {"type": "subtitle", "time": 4901.809, "timestamp": "01:21:41", "text": "并非如此。"}, {"type": "subtitle", "time": 4907.158, "timestamp": "01:21:47", "text": "是的，我也是这么想的。我也是这么想的。绝不。"}, {"type": "subtitle", "time": 4909.755, "timestamp": "01:21:49", "text": "我玩过。好的，又出现了一个新的。"}, {"type": "subtitle", "time": 4914.788, "timestamp": "01:21:54", "text": "好的。这将非常困难。非常"}, {"type": "subtitle", "time": 4917.867, "timestamp": "01:21:57", "text": "难以解释。非常困难。"}, {"type": "subtitle", "time": 4918.732, "timestamp": "01:21:58", "text": "解释。"}]
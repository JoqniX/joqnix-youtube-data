[{"type": "subtitle", "time": 4621.249, "timestamp": "01:17:01", "text": "这几乎是不可能的。所以，去做吧。"}, {"type": "subtitle", "time": 4623.158, "timestamp": "01:17:03", "text": "我以第二高的难度完成了比赛。"}, {"type": "subtitle", "time": 4633.025, "timestamp": "01:17:13", "text": "高的。是的。更别提，嗯哼，"}, {"type": "subtitle", "time": 4635.595, "timestamp": "01:17:15", "text": "我刚刚新建了一个文件，你知道吗？"}, {"type": "subtitle", "time": 4638.23, "timestamp": "01:17:18", "text": "我根本没做那件事。我认为"}, {"type": "subtitle", "time": 4643.368, "timestamp": "01:17:23", "text": "我应该这么做。目的"}, {"type": "subtitle", "time": 4645.132, "timestamp": "01:17:25", "text": "游戏玩法就是不断死亡，然后不断进步。"}, {"type": "subtitle", "time": 4652.866, "timestamp": "01:17:32", "text": "过程。所以，是的，提到这一点。"}, {"type": "subtitle", "time": 4655.191, "timestamp": "01:17:35", "text": "《哈迪斯2》比《哈迪斯2》难得多。"}, {"type": "subtitle", "time": 4657.395, "timestamp": "01:17:37", "text": "首先，就我所见，还有更多"}, {"type": "subtitle", "time": 4662.509, "timestamp": "01:17:42", "text": "难的。或者正如我喜欢称呼它的那样，"}, {"type": "subtitle", "time": 4664.349, "timestamp": "01:17:44", "text": "它比……多了很多愚蠢的东西"}, {"type": "subtitle", "time": 4677.323, "timestamp": "01:17:57", "text": "上一场比赛。嗯哼。是的，我希望如此。"}, {"type": "subtitle", "time": 4679.842, "timestamp": "01:17:59", "text": "我很期待和你一起玩《漫威宿敌》。"}]
[{"type": "subtitle", "time": 3304.58, "timestamp": "00:55:04", "text": "我看到了。游戏。嘿，你试过这个吗？"}, {"type": "subtitle", "time": 3309.561, "timestamp": "00:55:09", "text": "游戏叫什么？"}, {"type": "subtitle", "time": 3310.05, "timestamp": "00:55:10", "text": "被禁足了吗？"}, {"type": "subtitle", "time": 3314.105, "timestamp": "00:55:14", "text": "明白了。"}, {"type": "subtitle", "time": 3315.194, "timestamp": "00:55:15", "text": "是的。"}, {"type": "subtitle", "time": 3319.359, "timestamp": "00:55:19", "text": "不知道。另一个游戏叫……？"}, {"type": "subtitle", "time": 3324.134, "timestamp": "00:55:24", "text": "哦，等等。哦，RuneScape 有一个"}, {"type": "subtitle", "time": 3326.433, "timestamp": "00:55:26", "text": "新游戏，《龙之荒野》。什么是"}, {"type": "subtitle", "time": 3332.26, "timestamp": "00:55:32", "text": "这？是的。是的，我们一场都没玩过。"}, {"type": "subtitle", "time": 3336.224, "timestamp": "00:55:36", "text": "大型多人在线角色扮演游戏（MMORPG）。不。开放。因为"}, {"type": "subtitle", "time": 3338.925, "timestamp": "00:55:38", "text": "我们需要玩更多角色扮演游戏吗？你知道"}, {"type": "subtitle", "time": 3340.13, "timestamp": "00:55:40", "text": "他们需要多长时间？"}, {"type": "subtitle", "time": 3342.984, "timestamp": "00:55:42", "text": "是的，在这个世界里生存和创造。"}, {"type": "subtitle", "time": 3345.914, "timestamp": "00:55:45", "text": "打开。真的。"}, {"type": "subtitle", "time": 3348.654, "timestamp": "00:55:48", "text": "好了，我们正在玩《翻转世界》游戏。 。这就是开放世界生存游戏。"}, {"type": "subtitle", "time": 3350.834, "timestamp": "00:55:50", "text": "。这就是开放世界生存游戏。 ， 不？"}, {"type": "subtitle", "time": 3351.769, "timestamp": "00:55:51", "text": "， 不？ 是的。我们可以玩《Sons of the》"}, {"type": "subtitle", "time": 3356.468, "timestamp": "00:55:56", "text": "是的。我们可以玩《Sons of the》 福里斯特，如果你愿意的话，总有一天会的。经过"}]
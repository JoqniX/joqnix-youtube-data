[{"type": "subtitle", "time": 2283.206, "timestamp": "00:38:03", "text": "那太好了。哪个音频？是的，"}, {"type": "subtitle", "time": 2285.731, "timestamp": "00:38:05", "text": "对音频做出反应，并，呃，改变"}, {"type": "subtitle", "time": 2294.629, "timestamp": "00:38:14", "text": "镜头将跟随我们前进。所以"}, {"type": "subtitle", "time": 2297.714, "timestamp": "00:38:17", "text": "是的，非常好。就好像它有"}, {"type": "subtitle", "time": 2303.354, "timestamp": "00:38:23", "text": "它具有多种功能和效果。"}, {"type": "subtitle", "time": 2305.445, "timestamp": "00:38:25", "text": "站不稳，甚至还有眼部问题"}, {"type": "subtitle", "time": 2309.793, "timestamp": "00:38:29", "text": "鱼。你还记得这件事吗？什么"}, {"type": "subtitle", "time": 2311.648, "timestamp": "00:38:31", "text": "那到底是什么东西？你不知道我"}, {"type": "subtitle", "time": 2318.351, "timestamp": "00:38:38", "text": "我以前用过那个鱼形装置。这到底是怎么回事"}, {"type": "subtitle", "time": 2324.561, "timestamp": "00:38:44", "text": "这是吗？这到底是什么鬼东西？"}, {"type": "subtitle", "time": 2329.413, "timestamp": "00:38:49", "text": "想象一下如果我张开嘴的话，"}, {"type": "subtitle", "time": 2330.777, "timestamp": "00:38:50", "text": "我可以说，“哇，"}, {"type": "subtitle", "time": 2339.268, "timestamp": "00:38:59", "text": "哇。哇，哇。” 但没错，她确实有一些"}]
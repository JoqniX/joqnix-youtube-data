[{"type": "subtitle", "time": 4381.651, "timestamp": "01:13:01", "text": "角色扮演或表演"}, {"type": "subtitle", "time": 4382.471, "timestamp": "01:13:02", "text": "另一个角色。"}, {"type": "subtitle", "time": 4386.749, "timestamp": "01:13:06", "text": "是的，那我觉得你不太像个……"}, {"type": "subtitle", "time": 4401.177, "timestamp": "01:13:21", "text": "擅长这个。我吃了这个披萨。我"}, {"type": "subtitle", "time": 4402.995, "timestamp": "01:13:22", "text": "我为那些观看的人感到难过。"}, {"type": "subtitle", "time": 4406.714, "timestamp": "01:13:26", "text": "我真的很喜欢这张我的照片。"}, {"type": "subtitle", "time": 4407.47, "timestamp": "01:13:27", "text": "我想，应该是引言吧。"}, {"type": "subtitle", "time": 4415.542, "timestamp": "01:13:35", "text": "我很伤心。我为这些人感到难过。"}, {"type": "subtitle", "time": 4421.355, "timestamp": "01:13:41", "text": "是的。我记得有一次我广播"}, {"type": "subtitle", "time": 4423.939, "timestamp": "01:13:43", "text": "我说：“请停止这种行为。”"}, {"type": "subtitle", "time": 4428.906, "timestamp": "01:13:48", "text": "“游戏”。降低。赶紧完成这件事。"}, {"type": "subtitle", "time": 4439.352, "timestamp": "01:13:59", "text": "拜托了，兄弟。他们可能会说 “哇，你真有那么坏吗，兄弟？”"}]
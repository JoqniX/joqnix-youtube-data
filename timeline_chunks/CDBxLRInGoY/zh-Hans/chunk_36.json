[{"type": "subtitle", "time": 2165.76, "timestamp": "00:36:05", "text": "给我个惊喜。我不知道的事"}, {"type": "subtitle", "time": 2167.976, "timestamp": "00:36:07", "text": "这种事不会发生在你我身上，这是件新鲜事。"}, {"type": "subtitle", "time": 2173.022, "timestamp": "00:36:13", "text": "一些创新的东西。某种吸引人的东西"}, {"type": "subtitle", "time": 2173.547, "timestamp": "00:36:13", "text": "注意力。"}, {"type": "subtitle", "time": 2181.023, "timestamp": "00:36:21", "text": "但你想看到什么？"}, {"type": "subtitle", "time": 2182.127, "timestamp": "00:36:22", "text": "除了很棒的一对鞋？"}, {"type": "subtitle", "time": 2195.161, "timestamp": "00:36:35", "text": "我可以关掉摄像头。是的，"}, {"type": "subtitle", "time": 2197.739, "timestamp": "00:36:37", "text": "我当时就想，真的吗？这是怎么回事？"}, {"type": "subtitle", "time": 2201.654, "timestamp": "00:36:41", "text": "感觉如何？就像一套完整的装置，就像"}, {"type": "subtitle", "time": 2203.972, "timestamp": "00:36:43", "text": "他们用汽车之类的东西来做这件事，比如……"}, {"type": "subtitle", "time": 2211.689, "timestamp": "00:36:51", "text": "只需缩小画面即可。是的。"}, {"type": "subtitle", "time": 2216.178, "timestamp": "00:36:56", "text": "哇。它广泛应用于编辑领域。"}]
[{"type": "subtitle", "time": 2349.217, "timestamp": "00:39:09", "text": "愚蠢的耳朵。你咳嗽吗？"}, {"type": "subtitle", "time": 2351.183, "timestamp": "00:39:11", "text": "打喷嚏？我无法告诉你。"}, {"type": "subtitle", "time": 2354.899, "timestamp": "00:39:14", "text": "他咳​​嗽了。告诉他带点东西去"}, {"type": "subtitle", "time": 2357.018, "timestamp": "00:39:17", "text": "咳嗽之类的。他快要死了。"}, {"type": "subtitle", "time": 2363.223, "timestamp": "00:39:23", "text": "因为下雨，天气也很冷。"}, {"type": "subtitle", "time": 2369.076, "timestamp": "00:39:29", "text": "啊，是的。朋友，别生病。不"}, {"type": "subtitle", "time": 2369.73, "timestamp": "00:39:29", "text": "生病的。"}, {"type": "subtitle", "time": 2375.8, "timestamp": "00:39:35", "text": "我很高兴我带了戒指。"}, {"type": "subtitle", "time": 2376.99, "timestamp": "00:39:36", "text": "因为今天下了很多雨。"}, {"type": "subtitle", "time": 2381.314, "timestamp": "00:39:41", "text": "我的天啊。让我猜猜看"}, {"type": "subtitle", "time": 2383.493, "timestamp": "00:39:43", "text": "雨中汽车的颜色。它是粉色的吗？"}, {"type": "subtitle", "time": 2385.958, "timestamp": "00:39:45", "text": "不。黑色。"}, {"type": "subtitle", "time": 2391.276, "timestamp": "00:39:51", "text": "啊，黑色。为什么？你为什么这么认为"}, {"type": "subtitle", "time": 2391.841, "timestamp": "00:39:51", "text": "什么是粉色？"}, {"type": "subtitle", "time": 2394.727, "timestamp": "00:39:54", "text": "不知道。"}]
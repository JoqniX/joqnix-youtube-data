[{"type": "subtitle", "time": 6420.721, "timestamp": "01:47:00", "text": "今晚来陪陪我吧。虽然"}, {"type": "subtitle", "time": 6422.638, "timestamp": "01:47:02", "text": "直播应该更像一场派对。"}, {"type": "subtitle", "time": 6424.72, "timestamp": "01:47:04", "text": "派对结束后，感觉就像"}, {"type": "subtitle", "time": 6428.997, "timestamp": "01:47:08", "text": "普通的直播。节目《想要那个》"}, {"type": "subtitle", "time": 6432.774, "timestamp": "01:47:12", "text": "这是一场普通的现场直播。然后我意识到"}, {"type": "subtitle", "time": 6434.555, "timestamp": "01:47:14", "text": "他意识到自己必须这样做。"}, {"type": "subtitle", "time": 6438.701, "timestamp": "01:47:18", "text": "活动后的派对。但是，"}, {"type": "subtitle", "time": 6441.128, "timestamp": "01:47:21", "text": "说实话，还不错。"}, {"type": "subtitle", "time": 6446.767, "timestamp": "01:47:26", "text": "与朋友聊天"}, {"type": "subtitle", "time": 6448.828, "timestamp": "01:47:28", "text": "放松一下，简单点。"}, {"type": "subtitle", "time": 6456.662, "timestamp": "01:47:36", "text": "我通过玩游戏来分散注意力。我通常会这样做"}, {"type": "subtitle", "time": 6463.834, "timestamp": "01:47:43", "text": "这种情况偶尔会发生，但很少见。嗯，是的。"}, {"type": "subtitle", "time": 6465.872, "timestamp": "01:47:45", "text": "在生日板上，"}, {"type": "subtitle", "time": 6471.497, "timestamp": "01:47:51", "text": "还是那种，他们管它叫什么来着？"}, {"type": "subtitle", "time": 6474.534, "timestamp": "01:47:54", "text": "关闭。你仍然可以祝贺我。"}, {"type": "subtitle", "time": 6477.408, "timestamp": "01:47:57", "text": "一切都好。迟来的祝贺"}, {"type": "subtitle", "time": 6479.434, "timestamp": "01:47:59", "text": "我们随时欢迎他们。即使"}]
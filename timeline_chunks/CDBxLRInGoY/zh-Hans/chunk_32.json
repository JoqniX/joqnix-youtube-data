[{"type": "subtitle", "time": 1924.152, "timestamp": "00:32:04", "text": "哦，谢谢。那是来自《是的，"}, {"type": "subtitle", "time": 1927.75, "timestamp": "00:32:07", "text": "那是你的室友。那"}, {"type": "subtitle", "time": 1932.199, "timestamp": "00:32:12", "text": "没错，我还以为是你呢。就说声“保佑你”。"}, {"type": "subtitle", "time": 1932.889, "timestamp": "00:32:12", "text": "就我而言。"}, {"type": "subtitle", "time": 1934.398, "timestamp": "00:32:14", "text": "是的。是的。"}, {"type": "subtitle", "time": 1938.593, "timestamp": "00:32:18", "text": "和"}, {"type": "subtitle", "time": 1943.613, "timestamp": "00:32:23", "text": "我感觉不到，我不知道，这不适合我。"}, {"type": "subtitle", "time": 1946.004, "timestamp": "00:32:26", "text": "我的生日已经过去二十年了，而且已经"}, {"type": "subtitle", "time": 1949.102, "timestamp": "00:32:29", "text": "学期。永远不要想"}, {"type": "subtitle", "time": 1951.805, "timestamp": "00:32:31", "text": "因为你知道你完蛋了"}, {"type": "subtitle", "time": 1952.106, "timestamp": "00:32:32", "text": "老的"}, {"type": "subtitle", "time": 1954.959, "timestamp": "00:32:34", "text": "并看到"}, {"type": "subtitle", "time": 1960.52, "timestamp": "00:32:40", "text": "老兄，我的意思是，我就是一颗星座。"}, {"type": "subtitle", "time": 1963.442, "timestamp": "00:32:43", "text": "我年纪大了，真的很老了，但是"}, {"type": "subtitle", "time": 1965.688, "timestamp": "00:32:45", "text": "是的"}, {"type": "subtitle", "time": 1968.91, "timestamp": "00:32:48", "text": "对，该死的养老院，就是这样。"}, {"type": "subtitle", "time": 1969.284, "timestamp": "00:32:49", "text": "全部"}, {"type": "subtitle", "time": 1974.849, "timestamp": "00:32:54", "text": "我的天哪，这不可能是结局吧"}, {"type": "subtitle", "time": 1978.753, "timestamp": "00:32:58", "text": "而不是说“呃，你是什么意思？”是"}]
[{"type": "subtitle", "time": 1622.173, "timestamp": "00:27:02", "text": "哦是的。是的。他们都擅长 英语。"}, {"type": "subtitle", "time": 1637.233, "timestamp": "00:27:17", "text": "是的。他们的英语真好。他们要走了。"}, {"type": "subtitle", "time": 1640.908, "timestamp": "00:27:20", "text": "哦，我忘了。那好吧。哦，我是"}, {"type": "subtitle", "time": 1645.619, "timestamp": "00:27:25", "text": "被夹在两个旧墨西哥卷饼中间。经过"}, {"type": "subtitle", "time": 1646.246, "timestamp": "00:27:26", "text": "假设。"}, {"type": "subtitle", "time": 1649.619, "timestamp": "00:27:29", "text": "我知道。我知道。"}, {"type": "subtitle", "time": 1654.646, "timestamp": "00:27:34", "text": "是的。你什么时候开始学日语？"}, {"type": "subtitle", "time": 1659.725, "timestamp": "00:27:39", "text": "当我学习日语的时候。因为"}, {"type": "subtitle", "time": 1662.644, "timestamp": "00:27:42", "text": "我需要学习日语吗？为什么？"}, {"type": "subtitle", "time": 1665.756, "timestamp": "00:27:45", "text": "不？为什么不呢？为什么？"}, {"type": "subtitle", "time": 1668.92, "timestamp": "00:27:48", "text": "好吧。我没有这样的梦想"}, {"type": "subtitle", "time": 1670.845, "timestamp": "00:27:50", "text": "找个日本女朋友。这"}, {"type": "subtitle", "time": 1673.049, "timestamp": "00:27:53", "text": "好的。我不打算学日语。"}, {"type": "subtitle", "time": 1675.352, "timestamp": "00:27:55", "text": "你们两个不一样。你们俩"}, {"type": "subtitle", "time": 1678.251, "timestamp": "00:27:58", "text": "它们不一样。什么？为什么是我？"}]
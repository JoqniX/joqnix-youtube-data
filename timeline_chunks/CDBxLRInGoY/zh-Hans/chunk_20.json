[{"type": "subtitle", "time": 1200.076, "timestamp": "00:20:00", "text": "仅有的"}, {"type": "subtitle", "time": 1203.425, "timestamp": "00:20:03", "text": "是的。这就是主播的生活吗？"}, {"type": "subtitle", "time": 1204.078, "timestamp": "00:20:04", "text": "什么样的"}, {"type": "subtitle", "time": 1209.473, "timestamp": "00:20:09", "text": "是的。非常好。所有因素都与此相反。"}, {"type": "subtitle", "time": 1211.007, "timestamp": "00:20:11", "text": "溪流。或不？"}, {"type": "subtitle", "time": 1221.32, "timestamp": "00:20:21", "text": "是的。唉，真麻烦。所以"}, {"type": "subtitle", "time": 1221.861, "timestamp": "00:20:21", "text": "昨天"}, {"type": "subtitle", "time": 1230.455, "timestamp": "00:20:30", "text": "互联网，它在某种程度上影响了我"}, {"type": "subtitle", "time": 1232.91, "timestamp": "00:20:32", "text": "我平时做的事情出了点问题，我"}, {"type": "subtitle", "time": 1242.924, "timestamp": "00:20:42", "text": "我当时就想，这是我的网络吗？但"}, {"type": "subtitle", "time": 1245.297, "timestamp": "00:20:45", "text": "是的，今天也是，昨天你知道的"}, {"type": "subtitle", "time": 1252.105, "timestamp": "00:20:52", "text": "我玩了《Rumble》。那确实有帮助。隆隆"}]
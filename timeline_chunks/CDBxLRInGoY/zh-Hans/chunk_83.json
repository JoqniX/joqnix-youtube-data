[{"type": "subtitle", "time": 4981.589, "timestamp": "01:23:01", "text": "我说看这个真的太累了。"}, {"type": "subtitle", "time": 4982.179, "timestamp": "01:23:02", "text": "那场比赛。"}, {"type": "subtitle", "time": 4985.305, "timestamp": "01:23:05", "text": "你就是这么说的。"}, {"type": "subtitle", "time": 4994.719, "timestamp": "01:23:14", "text": "很有趣。你可知道？就这样吧"}, {"type": "subtitle", "time": 4996.922, "timestamp": "01:23:16", "text": "经过。我认为我们会玩皮科，因为"}, {"type": "subtitle", "time": 4999.074, "timestamp": "01:23:19", "text": "我觉得玩大师级对决模式会很棒。"}, {"type": "subtitle", "time": 5001.592, "timestamp": "01:23:21", "text": "头痛。因为？"}, {"type": "subtitle", "time": 5002.409, "timestamp": "01:23:22", "text": "是的。"}, {"type": "subtitle", "time": 5006.143, "timestamp": "01:23:26", "text": "是的，因为它包含的东西太多了。"}, {"type": "subtitle", "time": 5008.789, "timestamp": "01:23:28", "text": "通过。更不用说每"}, {"type": "subtitle", "time": 5011.444, "timestamp": "01:23:31", "text": "那个该死的人是个威胁。而且没有"}, {"type": "subtitle", "time": 5013.379, "timestamp": "01:23:33", "text": "提到大家都会扔东西"}, {"type": "subtitle", "time": 5014.395, "timestamp": "01:23:34", "text": "聊天中的侮辱。"}, {"type": "subtitle", "time": 5019.22, "timestamp": "01:23:39", "text": "哦，还有那个。"}, {"type": "subtitle", "time": 5025.743, "timestamp": "01:23:45", "text": "是的。这些人真是太糟糕了。你知道为什么吗？"}, {"type": "subtitle", "time": 5027.28, "timestamp": "01:23:47", "text": "我为什么离开？我离开是因为……"}, {"type": "subtitle", "time": 5028.26, "timestamp": "01:23:48", "text": "毒性太大。"}, {"type": "subtitle", "time": 5035.128, "timestamp": "01:23:55", "text": "或许。多人游戏"}, {"type": "subtitle", "time": 5035.761, "timestamp": "01:23:55", "text": "通常，"}, {"type": "subtitle", "time": 5039.602, "timestamp": "01:23:59", "text": "你已经知道了。我很少感到压力，对吧？ 你知道？我生活中没什么压力。"}]
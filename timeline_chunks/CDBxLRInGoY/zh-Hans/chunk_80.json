[{"type": "subtitle", "time": 4802.725, "timestamp": "01:20:02", "text": "。猜猜看，猜猜我们的性格是怎样的？ 你可以在《漫威宿敌》中扮演他。"}, {"type": "subtitle", "time": 4805.235, "timestamp": "01:20:05", "text": "你可以在《漫威宿敌》中扮演他。 或者她。快点。你想让谁上场？"}, {"type": "subtitle", "time": 4808.975, "timestamp": "01:20:08", "text": "或者她。快点。你想让谁上场？ ？"}, {"type": "subtitle", "time": 4819.06, "timestamp": "01:20:19", "text": "呃，我不知道。我不知道。"}, {"type": "subtitle", "time": 4827.722, "timestamp": "01:20:27", "text": "快点。你认为我死了吗？ 有人吗？有人想玩吗？"}, {"type": "subtitle", "time": 4832.375, "timestamp": "01:20:32", "text": "有人吗？有人想玩吗？ 你以前没玩过英雄射击游戏吗？"}, {"type": "subtitle", "time": 4844.203, "timestamp": "01:20:44", "text": "哦，它藏起来了。"}, {"type": "subtitle", "time": 4847.805, "timestamp": "01:20:47", "text": "他藏着秘密。折断"}, {"type": "subtitle", "time": 4851.422, "timestamp": "01:20:51", "text": "他们背着我们做着秘密的事情"}, {"type": "subtitle", "time": 4856.172, "timestamp": "01:20:56", "text": "相机。好吧。"}, {"type": "subtitle", "time": 4857.054, "timestamp": "01:20:57", "text": "我进入了"}]
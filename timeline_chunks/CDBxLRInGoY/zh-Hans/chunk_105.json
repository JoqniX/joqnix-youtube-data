[{"type": "subtitle", "time": 6301.368, "timestamp": "01:45:01", "text": "感谢今天到场的每一位。"}, {"type": "subtitle", "time": 6315.389, "timestamp": "01:45:15", "text": "是的，布拉德和贾姆。是的。他们仍在继续使用"}, {"type": "subtitle", "time": 6316.491, "timestamp": "01:45:16", "text": "你面前的标志"}, {"type": "subtitle", "time": 6324.238, "timestamp": "01:45:24", "text": "我尊重。我的团队值得尊重。"}, {"type": "subtitle", "time": 6329.335, "timestamp": "01:45:29", "text": "我只是想给你提供一个不同的视角。"}, {"type": "subtitle", "time": 6336.787, "timestamp": "01:45:36", "text": "是的，谢谢你今天，谢谢你。"}, {"type": "subtitle", "time": 6340.425, "timestamp": "01:45:40", "text": "今晚来和我一起吧。我玩得很开心"}, {"type": "subtitle", "time": 6347.747, "timestamp": "01:45:47", "text": "今晚。谢谢你邀请我。是的，"}, {"type": "subtitle", "time": 6350.878, "timestamp": "01:45:50", "text": "感谢您加入本群。我当时"}, {"type": "subtitle", "time": 6355.279, "timestamp": "01:45:55", "text": "我在想，今天我要做什么呢？我思考着……"}, {"type": "subtitle", "time": 6356.928, "timestamp": "01:45:56", "text": "给他们打电话，我们将继续执行计划。"}]
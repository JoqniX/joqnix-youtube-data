[{"type": "subtitle", "time": 3960.05, "timestamp": "01:06:00", "text": "影响他们。那是什么？每个女人"}, {"type": "subtitle", "time": 3961.907, "timestamp": "01:06:01", "text": "在 Marvel Rivals 中，请继续"}, {"type": "subtitle", "time": 3962.626, "timestamp": "01:06:02", "text": "冷静下来。"}, {"type": "subtitle", "time": 3965.345, "timestamp": "01:06:05", "text": "所以别让它影响到你。"}, {"type": "subtitle", "time": 3966.448, "timestamp": "01:06:06", "text": "伙计们。好的。"}, {"type": "subtitle", "time": 3969.609, "timestamp": "01:06:09", "text": "好的。 别让狗……为什么会有这些"}, {"type": "subtitle", "time": 3971.759, "timestamp": "01:06:11", "text": "别让狗……为什么会有这些 两个乔？二？我们还是别这么做了……"}, {"type": "subtitle", "time": 3977.429, "timestamp": "01:06:17", "text": "两个乔？二？我们还是别这么做了…… 是的。你个子小，你却很大。"}, {"type": "subtitle", "time": 3984.047, "timestamp": "01:06:24", "text": "哦。哦，找到了。跳跃之王。是"}, {"type": "subtitle", "time": 3984.547, "timestamp": "01:06:24", "text": "正在播放。"}, {"type": "subtitle", "time": 3987.621, "timestamp": "01:06:27", "text": "嗯，是的。我正在折磨自己"}, {"type": "subtitle", "time": 3994.519, "timestamp": "01:06:34", "text": "说话。别看它。你要去……就是这样。"}, {"type": "subtitle", "time": 3995.87, "timestamp": "01:06:35", "text": "“我会像这样，”是的，"}, {"type": "subtitle", "time": 3999.613, "timestamp": "01:06:39", "text": "我会问：“老头子怎么样了？”"}, {"type": "subtitle", "time": 4002.314, "timestamp": "01:06:42", "text": "“我会一路下去，重新开始我的……”"}, {"type": "subtitle", "time": 4005.42, "timestamp": "01:06:45", "text": "进步。我当时就像个疯子一样"}, {"type": "subtitle", "time": 4008.413, "timestamp": "01:06:48", "text": "我就是这样。我不会完成它。"}, {"type": "subtitle", "time": 4012.992, "timestamp": "01:06:52", "text": "我希望我能通关《跳跃之王》。"}, {"type": "subtitle", "time": 4016.73, "timestamp": "01:06:56", "text": "总有一天。我们应该玩游戏"}, {"type": "subtitle", "time": 4019.077, "timestamp": "01:06:59", "text": "就像《恶魔城》之类的游戏，你知道的。"}]
[{"type": "subtitle", "time": 1980.168, "timestamp": "00:33:00", "text": "就像一位慈祥的爷爷。"}, {"type": "subtitle", "time": 1987.668, "timestamp": "00:33:07", "text": "祖父。我的天啊。哦是的。"}, {"type": "subtitle", "time": 1989.207, "timestamp": "00:33:09", "text": "我也有白头发。"}, {"type": "subtitle", "time": 1993.132, "timestamp": "00:33:13", "text": "我的天啊。此时此刻，我是"}, {"type": "subtitle", "time": 1993.929, "timestamp": "00:33:13", "text": "杀了我"}, {"type": "subtitle", "time": 1996.756, "timestamp": "00:33:16", "text": "这一点。我在自嘲"}, {"type": "subtitle", "time": 1997.096, "timestamp": "00:33:17", "text": "相同的。"}, {"type": "subtitle", "time": 2000.612, "timestamp": "00:33:20", "text": "有可能。有可能。"}, {"type": "subtitle", "time": 2003.573, "timestamp": "00:33:23", "text": "是的。该死。"}, {"type": "subtitle", "time": 2011.648, "timestamp": "00:33:31", "text": "天哪，看看你的模特在看着我"}, {"type": "subtitle", "time": 2012.418, "timestamp": "00:33:32", "text": "固定地"}, {"type": "subtitle", "time": 2017.737, "timestamp": "00:33:37", "text": "我突然意识到，我只是"}, {"type": "subtitle", "time": 2020.584, "timestamp": "00:33:40", "text": "有一天，他用充满威胁的眼神看着我。"}, {"type": "subtitle", "time": 2025.532, "timestamp": "00:33:45", "text": "不用担心。总有一天我会"}, {"type": "subtitle", "time": 2025.873, "timestamp": "00:33:45", "text": "移动。"}, {"type": "subtitle", "time": 2034.252, "timestamp": "00:33:54", "text": "但愿如此。哦，我必须"}, {"type": "subtitle", "time": 2038.594, "timestamp": "00:33:58", "text": "我必须继续前进"}]
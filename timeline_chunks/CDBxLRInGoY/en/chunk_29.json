[{"type": "subtitle", "time": 1744.215, "timestamp": "00:29:04", "text": "Yes, very aggressive. Meow. Yes,"}, {"type": "subtitle", "time": 1746.6, "timestamp": "00:29:06", "text": "probably. Who knows?"}, {"type": "subtitle", "time": 1752.937, "timestamp": "00:29:12", "text": "Yes. Or Dutch. I'd like to"}, {"type": "subtitle", "time": 1754.085, "timestamp": "00:29:14", "text": "learn Dutch."}, {"type": "subtitle", "time": 1757.518, "timestamp": "00:29:17", "text": "Yes, you know French, right?"}, {"type": "subtitle", "time": 1763.26, "timestamp": "00:29:23", "text": "Yes. Sadly, yes."}, {"type": "subtitle", "time": 1766.381, "timestamp": "00:29:26", "text": "Sadly, yes. I'm"}, {"type": "subtitle", "time": 1774.192, "timestamp": "00:29:34", "text": "just being nice. Why?"}, {"type": "subtitle", "time": 1785.879, "timestamp": "00:29:45", "text": "Vett. Say that just like that? I don't"}, {"type": "subtitle", "time": 1790.574, "timestamp": "00:29:50", "text": "know. I remember when I used to struggle with"}, {"type": "subtitle", "time": 1792.268, "timestamp": "00:29:52", "text": "that word for the bread thing."}, {"type": "subtitle", "time": 1795.711, "timestamp": "00:29:55", "text": "It starts with C. I"}, {"type": "subtitle", "time": 1796.64, "timestamp": "00:29:56", "text": "just said the... You just"}, {"type": "subtitle", "time": 1799.102, "timestamp": "00:29:59", "text": "said it right now."}]
[{"type": "subtitle", "time": 5104.844, "timestamp": "01:25:04", "text": "Yeah. Oh, that, that's true too."}, {"type": "subtitle", "time": 5109.055, "timestamp": "01:25:09", "text": "Yes, Grandmaster General. Just"}, {"type": "subtitle", "time": 5112.802, "timestamp": "01:25:12", "text": "look at me. I can barely speak."}, {"type": "subtitle", "time": 5116.75, "timestamp": "01:25:16", "text": "Um, it's about letting go."}, {"type": "subtitle", "time": 5119.273, "timestamp": "01:25:19", "text": "Letting go."}, {"type": "subtitle", "time": 5122.13, "timestamp": "01:25:22", "text": "Releasing it completely. Don't think you have to"}, {"type": "subtitle", "time": 5123.835, "timestamp": "01:25:23", "text": "let go completely. Just"}, {"type": "subtitle", "time": 5126.452, "timestamp": "01:25:26", "text": "let go a little. Just get"}, {"type": "subtitle", "time": 5129.79, "timestamp": "01:25:29", "text": "comfortable. It's like I see Job in things like this"}, {"type": "subtitle", "time": 5133.324, "timestamp": "01:25:33", "text": ". He still hasn't let go, you know?"}, {"type": "subtitle", "time": 5136.632, "timestamp": "01:25:36", "text": "But I feel more comfortable when"}, {"type": "subtitle", "time": 5137.526, "timestamp": "01:25:37", "text": "I'm silent."}, {"type": "subtitle", "time": 5139.503, "timestamp": "01:25:39", "text": "Yeah."}, {"type": "subtitle", "time": 5142.084, "timestamp": "01:25:42", "text": "Yeah, that's true. Yeah, guys."}, {"type": "subtitle", "time": 5144.511, "timestamp": "01:25:44", "text": "We don't talk much. Is there any talking"}, {"type": "subtitle", "time": 5144.83, "timestamp": "01:25:44", "text": "here?"}, {"type": "subtitle", "time": 5150.511, "timestamp": "01:25:50", "text": "Uh, what can we say?"}, {"type": "subtitle", "time": 5155.462, "timestamp": "01:25:55", "text": "One day, when I'm really quiet,"}]
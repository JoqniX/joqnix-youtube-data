[{"type": "subtitle", "time": 6002.485, "timestamp": "01:40:02", "text": "Oh my God. Oh, no. Why"}, {"type": "subtitle", "time": 6004.362, "timestamp": "01:40:04", "text": "are you okay with that? Come on."}, {"type": "subtitle", "time": 6005.395, "timestamp": "01:40:05", "text": "You have to be."}, {"type": "subtitle", "time": 6019.996, "timestamp": "01:40:19", "text": "So, yeah. Go get something to eat."}, {"type": "subtitle", "time": 6026.547, "timestamp": "01:40:26", "text": "Yeah, I was trying to grab something to eat"}, {"type": "subtitle", "time": 6028.651, "timestamp": "01:40:28", "text": "and I realized I don't have anything. I"}, {"type": "subtitle", "time": 6031.668, "timestamp": "01:40:31", "text": "only have water. So I drank the water"}, {"type": "subtitle", "time": 6032.332, "timestamp": "01:40:32", "text": "and came here. We're"}, {"type": "subtitle", "time": 6036.791, "timestamp": "01:40:36", "text": "both in the same boat."}, {"type": "subtitle", "time": 6037.984, "timestamp": "01:40:37", "text": "So, yeah."}, {"type": "subtitle", "time": 6041.995, "timestamp": "01:40:41", "text": "No, there's food there, you know. I just don't"}, {"type": "subtitle", "time": 6045.826, "timestamp": "01:40:45", "text": "want to eat that stuff, if you know what I"}, {"type": "subtitle", "time": 6046.916, "timestamp": "01:40:46", "text": "mean. You know?"}, {"type": "subtitle", "time": 6051.827, "timestamp": "01:40:51", "text": "Oh, God. Yeah. You know when you've had"}, {"type": "subtitle", "time": 6053.429, "timestamp": "01:40:53", "text": "too much of the same thing and you don't want to"}, {"type": "subtitle", "time": 6054.254, "timestamp": "01:40:54", "text": "eat it again?"}]
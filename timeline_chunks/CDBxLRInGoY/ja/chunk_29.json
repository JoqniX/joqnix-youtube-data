[{"type": "subtitle", "time": 1744.215, "timestamp": "00:29:04", "text": "はい、非常に攻撃的です。ニャー。うん、"}, {"type": "subtitle", "time": 1746.6, "timestamp": "00:29:06", "text": "おそらく。知るか？"}, {"type": "subtitle", "time": 1752.937, "timestamp": "00:29:12", "text": "はい。あるいはオランダ語。をお願いします。"}, {"type": "subtitle", "time": 1754.085, "timestamp": "00:29:14", "text": "オランダ語を学ぼう。"}, {"type": "subtitle", "time": 1757.518, "timestamp": "00:29:17", "text": "はい、あなたはもうフランス語が話せますよね？"}, {"type": "subtitle", "time": 1763.26, "timestamp": "00:29:23", "text": "はい。残念ながら、そうです。"}, {"type": "subtitle", "time": 1774.192, "timestamp": "00:29:34", "text": "私はただ親切にしているだけです。なぜなら？"}, {"type": "subtitle", "time": 1785.879, "timestamp": "00:29:45", "text": "ベット。そう言うんですか？たったそれだけ？いいえ"}, {"type": "subtitle", "time": 1790.574, "timestamp": "00:29:50", "text": "彼。昔レスリングをしていた時のことを覚えている"}, {"type": "subtitle", "time": 1792.268, "timestamp": "00:29:52", "text": "それはパンと呼ばれるものを指す言葉です。"}, {"type": "subtitle", "time": 1795.711, "timestamp": "00:29:55", "text": "Cで始まる。"}, {"type": "subtitle", "time": 1796.64, "timestamp": "00:29:56", "text": "私はただ言った"}, {"type": "subtitle", "time": 1799.102, "timestamp": "00:29:59", "text": "今まさにそれを言ったじゃないか。"}]
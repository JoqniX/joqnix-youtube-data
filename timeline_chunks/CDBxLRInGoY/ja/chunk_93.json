[{"type": "subtitle", "time": 5583.74, "timestamp": "01:33:03", "text": "はい、自分がゲームをしていることは自覚しています。"}, {"type": "subtitle", "time": 5589.567, "timestamp": "01:33:09", "text": "はい、おっしゃる通りです。私は気づきました"}, {"type": "subtitle", "time": 5593.091, "timestamp": "01:33:13", "text": "私は何を言っているんだ？なぜプレイしているのですか？"}, {"type": "subtitle", "time": 5593.689, "timestamp": "01:33:13", "text": "ビデオゲーム？"}, {"type": "subtitle", "time": 5596.705, "timestamp": "01:33:16", "text": "楽しむ。"}, {"type": "subtitle", "time": 5604.4, "timestamp": "01:33:24", "text": "しかし、私にそう尋ねるなら、"}, {"type": "subtitle", "time": 5631.938, "timestamp": "01:33:51", "text": "あなた…はい。待って、なぜ私はできないの？"}, {"type": "subtitle", "time": 5635.367, "timestamp": "01:33:55", "text": "自分のサーバーにアクセスするにはどうすればよいですか？待って、あなたはそうしなかったの？"}, {"type": "subtitle", "time": 5637.033, "timestamp": "01:33:57", "text": "アップデートしましたか？待って、"}]
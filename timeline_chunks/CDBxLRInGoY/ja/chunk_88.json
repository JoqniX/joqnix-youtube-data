[{"type": "subtitle", "time": 5284.649, "timestamp": "01:28:04", "text": "フライドチキンとチャパティ。私たちはできなかった"}, {"type": "subtitle", "time": 5302.268, "timestamp": "01:28:22", "text": "私たちは話をする時間を持つことができた。ください"}, {"type": "subtitle", "time": 5304.662, "timestamp": "01:28:24", "text": "1秒。水と…を持って行きます。"}, {"type": "subtitle", "time": 5305.021, "timestamp": "01:28:25", "text": "食べる。"}, {"type": "subtitle", "time": 5309.331, "timestamp": "01:28:29", "text": "ねえ、これは無料配信だよ、"}, {"type": "subtitle", "time": 5312.947, "timestamp": "01:28:32", "text": "だから心配しないでください。それは"}, {"type": "subtitle", "time": 5314.897, "timestamp": "01:28:34", "text": "アフターパーティーの参加者全員がそこにいる"}, {"type": "subtitle", "time": 5330.453, "timestamp": "01:28:50", "text": "生き延びている。もしそれがとても素敵なら"}]
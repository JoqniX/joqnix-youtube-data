[{"type": "subtitle", "time": 1622.173, "timestamp": "00:27:02", "text": "ああ、そうだね。はい。どちらも得意なのは 英語。"}, {"type": "subtitle", "time": 1637.233, "timestamp": "00:27:17", "text": "はい。彼らは英語がとても上手だ。彼らは去っていく。"}, {"type": "subtitle", "time": 1640.908, "timestamp": "00:27:20", "text": "ああ、忘れてた。しかたがない。ああ、私は"}, {"type": "subtitle", "time": 1645.619, "timestamp": "00:27:25", "text": "古いタコス2つに挟まれて身動きが取れない。による"}, {"type": "subtitle", "time": 1646.246, "timestamp": "00:27:26", "text": "想定。"}, {"type": "subtitle", "time": 1649.619, "timestamp": "00:27:29", "text": "知っている。知っている。"}, {"type": "subtitle", "time": 1654.646, "timestamp": "00:27:34", "text": "はい。いつ日本語を習う予定ですか？"}, {"type": "subtitle", "time": 1659.725, "timestamp": "00:27:39", "text": "私が日本語を学ぶとき。なぜなら"}, {"type": "subtitle", "time": 1662.644, "timestamp": "00:27:42", "text": "日本語を学ぶ必要はありますか？なぜ？"}, {"type": "subtitle", "time": 1665.756, "timestamp": "00:27:45", "text": "いいえ？なぜだめですか？なぜ？"}, {"type": "subtitle", "time": 1668.92, "timestamp": "00:27:48", "text": "大丈夫。私は夢を持っていません"}, {"type": "subtitle", "time": 1670.845, "timestamp": "00:27:50", "text": "日本人の彼女を作る。これ"}, {"type": "subtitle", "time": 1673.049, "timestamp": "00:27:53", "text": "良い。私は日本語を習うつもりはありません。"}, {"type": "subtitle", "time": 1675.352, "timestamp": "00:27:55", "text": "あなたたち二人は違う。あなたたち二人"}, {"type": "subtitle", "time": 1678.251, "timestamp": "00:27:58", "text": "それらは異なる。何？なぜ私なの？"}]
[{"type": "subtitle", "time": 6481.405, "timestamp": "01:48:01", "text": "彼らは1ヶ月ほど経ってからお祝いの言葉をかけてくれるでしょう。"}, {"type": "subtitle", "time": 6483.994, "timestamp": "01:48:03", "text": "それはいいです。それでも私は読むつもりだ。"}, {"type": "subtitle", "time": 6488.19, "timestamp": "01:48:08", "text": "ええと、そうなんです、私の誕生日と"}, {"type": "subtitle", "time": 6491.676, "timestamp": "01:48:11", "text": "全て順調だった。ご出席いただきありがとうございました。"}, {"type": "subtitle", "time": 6493.408, "timestamp": "01:48:13", "text": "カウントダウンストリームへ、そして"}, {"type": "subtitle", "time": 6496.719, "timestamp": "01:48:16", "text": "昨日の誕生日配信。そしてもし、"}, {"type": "subtitle", "time": 6498.734, "timestamp": "01:48:18", "text": "まるで、"}, {"type": "subtitle", "time": 6502.243, "timestamp": "01:48:22", "text": "今日もまた同じレベルだ。つまり、そう、私は"}, {"type": "subtitle", "time": 6506.348, "timestamp": "01:48:26", "text": "レベルですよね？新年。私はアップロードしました"}, {"type": "subtitle", "time": 6511.047, "timestamp": "01:48:31", "text": "レベル。私は1階プラス1階に昇格しました。おお、"}, {"type": "subtitle", "time": 6513.33, "timestamp": "01:48:33", "text": "新しい自分として、"}, {"type": "subtitle", "time": 6522.039, "timestamp": "01:48:42", "text": "ある意味では、そうだと思います。ああ、そうだね。えっと、"}, {"type": "subtitle", "time": 6523.987, "timestamp": "01:48:43", "text": "ここで終わらせて、明日また終わらせよう"}, {"type": "subtitle", "time": 6528.699, "timestamp": "01:48:48", "text": "配信するかもしれないし、しないかもしれない。 ？ 知るか？明日私は"}, {"type": "subtitle", "time": 6531.462, "timestamp": "01:48:51", "text": "知るか？明日私は 仕事。すごく疲れるだろうな。それで"}, {"type": "subtitle", "time": 6538.405, "timestamp": "01:48:58", "text": "仕事。すごく疲れるだろうな。それで 彼は眠らなければならないかもしれない。しかし"}]
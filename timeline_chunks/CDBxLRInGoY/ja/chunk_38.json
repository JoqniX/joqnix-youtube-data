[{"type": "subtitle", "time": 2283.206, "timestamp": "00:38:03", "text": "それは良いですね。どの音声ですか？うん、"}, {"type": "subtitle", "time": 2285.731, "timestamp": "00:38:05", "text": "音声に反応して、えーと、"}, {"type": "subtitle", "time": 2294.629, "timestamp": "00:38:14", "text": "今後、カメラの活用を進めていきます。それで"}, {"type": "subtitle", "time": 2297.714, "timestamp": "00:38:17", "text": "はい、とても良いです。まるで"}, {"type": "subtitle", "time": 2303.354, "timestamp": "00:38:23", "text": "これは多くの機能と効果を持つ"}, {"type": "subtitle", "time": 2305.445, "timestamp": "00:38:25", "text": "不安定で、目も何かあった"}, {"type": "subtitle", "time": 2309.793, "timestamp": "00:38:29", "text": "魚の。これ、覚えていますか？何"}, {"type": "subtitle", "time": 2311.648, "timestamp": "00:38:31", "text": "あれは何だ？あなたは私が何をしているか知らない"}, {"type": "subtitle", "time": 2318.351, "timestamp": "00:38:38", "text": "以前は魚のやつを使っていた。一体どういうことだ"}, {"type": "subtitle", "time": 2324.561, "timestamp": "00:38:44", "text": "これですか？これは一体何だ？"}, {"type": "subtitle", "time": 2329.413, "timestamp": "00:38:49", "text": "もし私が口を開けていたら、"}, {"type": "subtitle", "time": 2330.777, "timestamp": "00:38:50", "text": "「わあ、"}, {"type": "subtitle", "time": 2339.268, "timestamp": "00:38:59", "text": "おお。わあ、わあ。」でも、確かに彼女はいくつか持っている。"}]
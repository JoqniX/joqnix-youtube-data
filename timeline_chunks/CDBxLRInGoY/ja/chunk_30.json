[{"type": "subtitle", "time": 1804.08, "timestamp": "00:30:04", "text": "はい。ああ、今すぐ言ってくれますか？"}, {"type": "subtitle", "time": 1809.047, "timestamp": "00:30:09", "text": "正しい。"}, {"type": "subtitle", "time": 1811.892, "timestamp": "00:30:11", "text": "何てことだ。いいえ、私に言わないでください。"}, {"type": "subtitle", "time": 1814.22, "timestamp": "00:30:14", "text": "覚えていない。よし、それは"}, {"type": "subtitle", "time": 1816.41, "timestamp": "00:30:16", "text": "かなり近い。昔はどんなことが起きていたか知っていますか？"}, {"type": "subtitle", "time": 1818.724, "timestamp": "00:30:18", "text": "当時、そう言うべきだったのでしょうか？あなたはすでに"}, {"type": "subtitle", "time": 1821.164, "timestamp": "00:30:21", "text": "毒"}, {"type": "subtitle", "time": 1826.272, "timestamp": "00:30:26", "text": "何か一言言ってみようか？"}, {"type": "subtitle", "time": 1834.669, "timestamp": "00:30:34", "text": "我が神よ。私は「何？」って感じだった。"}, {"type": "subtitle", "time": 1837.763, "timestamp": "00:30:37", "text": "えっ、彼は脳卒中を起こしてるの？ あれはいったい何だ？何？"}, {"type": "subtitle", "time": 1844.8029999999999, "timestamp": "00:30:44", "text": "古き良き時代。とても良い。"}, {"type": "subtitle", "time": 1848.455, "timestamp": "00:30:48", "text": "古き良き時代。それはずいぶん前のことだった"}, {"type": "subtitle", "time": 1849.102, "timestamp": "00:30:49", "text": "2年。"}, {"type": "subtitle", "time": 1852.901, "timestamp": "00:30:52", "text": "ええ、それはもう古いニュースです。あなたはこう言った、"}, {"type": "subtitle", "time": 1854.414, "timestamp": "00:30:54", "text": "あなたは私にうんざりしていた。"}, {"type": "subtitle", "time": 1859.493, "timestamp": "00:30:59", "text": "もうあなたにはうんざりよ。もちろん。による"}]
[{"type": "subtitle", "time": 1862.105, "timestamp": "00:31:02", "text": "想定。誰がそう言ったの？それすらも違う。"}, {"type": "subtitle", "time": 1863.046, "timestamp": "00:31:03", "text": "それは"}, {"type": "subtitle", "time": 1874.152, "timestamp": "00:31:14", "text": "アエント。ゲームなし。生命がない。"}, {"type": "subtitle", "time": 1876.101, "timestamp": "00:31:16", "text": "おお、"}, {"type": "subtitle", "time": 1879.05, "timestamp": "00:31:19", "text": "うん。"}, {"type": "subtitle", "time": 1882.507, "timestamp": "00:31:22", "text": "言うまでもなく私はアニメを見ませんが、"}, {"type": "subtitle", "time": 1884.29, "timestamp": "00:31:24", "text": "それでも、そのネタは理解できた。"}, {"type": "subtitle", "time": 1890.97, "timestamp": "00:31:30", "text": "はい。はい。良いアニメです。良いアニメです。"}, {"type": "subtitle", "time": 1894.518, "timestamp": "00:31:34", "text": "はい。二度とこのようなことは起こらないだろう。"}, {"type": "subtitle", "time": 1895.084, "timestamp": "00:31:35", "text": "季節。"}, {"type": "subtitle", "time": 1898.834, "timestamp": "00:31:38", "text": "はい。続編はあるの？ ？"}, {"type": "subtitle", "time": 1902.29, "timestamp": "00:31:42", "text": "彼はライトノベルを書いていると思う。うん。"}, {"type": "subtitle", "time": 1905.971, "timestamp": "00:31:45", "text": "夜ですか？わかった。ライトノベル"}, {"type": "subtitle", "time": 1908.36, "timestamp": "00:31:48", "text": "それはかなり大げさな言い方だ。"}, {"type": "subtitle", "time": 1910.616, "timestamp": "00:31:50", "text": "続編のために、ほら、"}, {"type": "subtitle", "time": 1914.674, "timestamp": "00:31:54", "text": "シーズン2とか、そんな感じのやつ。小説"}, {"type": "subtitle", "time": 1916.491, "timestamp": "00:31:56", "text": "そんなに軽いとは思わない。"}]
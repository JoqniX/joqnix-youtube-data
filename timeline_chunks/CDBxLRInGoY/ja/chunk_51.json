[{"type": "subtitle", "time": 3061.067, "timestamp": "00:51:01", "text": "50"}, {"type": "subtitle", "time": 3062.243, "timestamp": "00:51:02", "text": "400。"}, {"type": "subtitle", "time": 3066.25, "timestamp": "00:51:06", "text": "ああ、それは400ですね。"}, {"type": "subtitle", "time": 3067.402, "timestamp": "00:51:07", "text": "深夜勤務。"}, {"type": "subtitle", "time": 3071.807, "timestamp": "00:51:11", "text": "はい。ああ、あなたが日本にいることを忘れていました。"}, {"type": "subtitle", "time": 3081.082, "timestamp": "00:51:21", "text": "はい。隠れて、ふりをする。"}, {"type": "subtitle", "time": 3088.257, "timestamp": "00:51:28", "text": "いや、いや、いや。君こそが人間だ。"}, {"type": "subtitle", "time": 3090.51, "timestamp": "00:51:30", "text": "偽りの人間を殺さなければならない。"}, {"type": "subtitle", "time": 3092.008, "timestamp": "00:51:32", "text": "うん。"}, {"type": "subtitle", "time": 3095.486, "timestamp": "00:51:35", "text": "ねえ、君は"}, {"type": "subtitle", "time": 3097.35, "timestamp": "00:51:37", "text": "ゲームをもっと面白くするため。"}, {"type": "subtitle", "time": 3098.055, "timestamp": "00:51:38", "text": "知る、"}, {"type": "subtitle", "time": 3100.109, "timestamp": "00:51:40", "text": "それがゲームの楽しみ方だ。"}, {"type": "subtitle", "time": 3102.851, "timestamp": "00:51:42", "text": "それは本当だ。もし誰かがあなたの楽しみを台無しにしたら、"}, {"type": "subtitle", "time": 3105.796, "timestamp": "00:51:45", "text": "それは良くない。それ？"}, {"type": "subtitle", "time": 3109.961, "timestamp": "00:51:49", "text": "あなたと同じように、そうです。木々について"}, {"type": "subtitle", "time": 3110.608, "timestamp": "00:51:50", "text": "それら。"}, {"type": "subtitle", "time": 3111.122, "timestamp": "00:51:51", "text": "うん。"}, {"type": "subtitle", "time": 3114.171, "timestamp": "00:51:54", "text": "はい。何かについて混乱している場合は、"}, {"type": "subtitle", "time": 3116.336, "timestamp": "00:51:56", "text": "いつでも私に聞いていいんですよ？"}]
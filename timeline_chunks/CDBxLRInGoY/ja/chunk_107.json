[{"type": "subtitle", "time": 6420.721, "timestamp": "01:47:00", "text": "今夜来て、一緒にいてくれないか。それでも"}, {"type": "subtitle", "time": 6422.638, "timestamp": "01:47:02", "text": "配信はもっとパーティーのような感じであるべきだ"}, {"type": "subtitle", "time": 6424.72, "timestamp": "01:47:04", "text": "パーティーの後は、"}, {"type": "subtitle", "time": 6428.997, "timestamp": "01:47:08", "text": "通常のライブ配信。ショーはそれを望んでいた"}, {"type": "subtitle", "time": 6432.774, "timestamp": "01:47:12", "text": "それはごく普通の生放送だった。そして私は気づいた"}, {"type": "subtitle", "time": 6434.555, "timestamp": "01:47:14", "text": "彼はそれをしなければならないことに気づいた"}, {"type": "subtitle", "time": 6438.701, "timestamp": "01:47:18", "text": "イベント後のパーティー。しかし、もし、"}, {"type": "subtitle", "time": 6441.128, "timestamp": "01:47:21", "text": "正直言って、良かったよ。"}, {"type": "subtitle", "time": 6446.767, "timestamp": "01:47:26", "text": "友達とチャットして"}, {"type": "subtitle", "time": 6448.828, "timestamp": "01:47:28", "text": "合間にリラックスして、"}, {"type": "subtitle", "time": 6456.662, "timestamp": "01:47:36", "text": "ゲームをして気を紛らわせる。私は普段そうする"}, {"type": "subtitle", "time": 6463.834, "timestamp": "01:47:43", "text": "そういうことも時々あるが、稀なことだ。ええ、そうですね。"}, {"type": "subtitle", "time": 6465.872, "timestamp": "01:47:45", "text": "誕生日ボードに、"}, {"type": "subtitle", "time": 6471.497, "timestamp": "01:47:51", "text": "それはまだ、なんて言うんだっけ？"}, {"type": "subtitle", "time": 6474.534, "timestamp": "01:47:54", "text": "閉店しました。今でも私を祝福してくれて構いませんよ。"}, {"type": "subtitle", "time": 6477.408, "timestamp": "01:47:57", "text": "すべて順調です。遅ればせながら、おめでとうございます。"}, {"type": "subtitle", "time": 6479.434, "timestamp": "01:47:59", "text": "彼らはいつでも大歓迎です。たとえ"}]
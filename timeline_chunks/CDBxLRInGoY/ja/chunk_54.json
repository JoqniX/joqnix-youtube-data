[{"type": "subtitle", "time": 3240.575, "timestamp": "00:54:00", "text": "仕様、ゲームだと思います。"}, {"type": "subtitle", "time": 3244.168, "timestamp": "00:54:04", "text": "うん。"}, {"type": "subtitle", "time": 3249.305, "timestamp": "00:54:09", "text": "えっと、3Dとか何かあったんですか？なぜなら"}, {"type": "subtitle", "time": 3250.75, "timestamp": "00:54:10", "text": "あれは2Dだったんですよね？"}, {"type": "subtitle", "time": 3255.15, "timestamp": "00:54:15", "text": "3Dモデルがあります。私たちは言った"}, {"type": "chat", "time": 3255.502, "timestamp": "00:54:15", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "poke poke"}, {"type": "subtitle", "time": 3259.572, "timestamp": "00:54:19", "text": "私は2Dモデルを持っていました。あれは2Dですよね？"}, {"type": "subtitle", "time": 3263.708, "timestamp": "00:54:23", "text": "いいえ、3Dモデルは以前からありました"}, {"type": "subtitle", "time": 3270.058, "timestamp": "00:54:30", "text": "また。待って、彼らはどこでモデルを使っているの？"}, {"type": "subtitle", "time": 3270.333, "timestamp": "00:54:30", "text": "3D？"}, {"type": "subtitle", "time": 3277.15, "timestamp": "00:54:37", "text": "えーっと、ショットのアニメーションでは"}, {"type": "subtitle", "time": 3277.837, "timestamp": "00:54:37", "text": "お粥の？"}, {"type": "subtitle", "time": 3280.459, "timestamp": "00:54:40", "text": "それだけです。"}, {"type": "subtitle", "time": 3285.357, "timestamp": "00:54:45", "text": "はい。そうすれば、よりリアルに見える。"}, {"type": "subtitle", "time": 3287.008, "timestamp": "00:54:47", "text": "来て。あなた..."}, {"type": "subtitle", "time": 3293.607, "timestamp": "00:54:53", "text": "来て。おお。おお。"}, {"type": "subtitle", "time": 3295.906, "timestamp": "00:54:55", "text": "ああ、ストリームが失敗しているようですね。"}]
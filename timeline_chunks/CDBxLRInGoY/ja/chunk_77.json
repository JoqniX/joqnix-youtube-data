[{"type": "subtitle", "time": 4621.249, "timestamp": "01:17:01", "text": "それはほぼ不可能だ。だから、とにかくやってみよう"}, {"type": "subtitle", "time": 4623.158, "timestamp": "01:17:03", "text": "2番目に高い難易度でクリアしました"}, {"type": "subtitle", "time": 4633.025, "timestamp": "01:17:13", "text": "高い。はい。言うまでもなく、うんうん、"}, {"type": "subtitle", "time": 4635.595, "timestamp": "01:17:15", "text": "新しいファイルを作ったばかりなんだよ。"}, {"type": "subtitle", "time": 4638.23, "timestamp": "01:17:18", "text": "私はそんなことはしていません。私は思う"}, {"type": "subtitle", "time": 4643.368, "timestamp": "01:17:23", "text": "そうするべきだ。目的は"}, {"type": "subtitle", "time": 4645.132, "timestamp": "01:17:25", "text": "このゲームは、死んで上達していくゲームです。"}, {"type": "subtitle", "time": 4652.866, "timestamp": "01:17:32", "text": "プロセス。そう、それを言及すると"}, {"type": "subtitle", "time": 4655.191, "timestamp": "01:17:35", "text": "Hades 2 は、"}, {"type": "subtitle", "time": 4657.395, "timestamp": "01:17:37", "text": "まず、私の見るところ、"}, {"type": "subtitle", "time": 4662.509, "timestamp": "01:17:42", "text": "難しい。あるいは私が好んで呼ぶように、"}, {"type": "subtitle", "time": 4664.349, "timestamp": "01:17:44", "text": "それは、"}, {"type": "subtitle", "time": 4677.323, "timestamp": "01:17:57", "text": "前のゲーム。うんうん。ええ、そう願っています。"}, {"type": "subtitle", "time": 4679.842, "timestamp": "01:17:59", "text": "あなたと一緒にマーベル・ライバルズをプレイするのが楽しみです。"}]
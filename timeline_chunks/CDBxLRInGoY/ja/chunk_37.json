[{"type": "subtitle", "time": 2220.981, "timestamp": "00:37:00", "text": "私が持っているのはそれだけです。ズームと"}, {"type": "subtitle", "time": 2226.113, "timestamp": "00:37:06", "text": "辺境性。インポートしましたか？"}, {"type": "subtitle", "time": 2227.004, "timestamp": "00:37:07", "text": "ライブ2Dモデル？"}, {"type": "subtitle", "time": 2230.338, "timestamp": "00:37:10", "text": "いいえ。写真でしか使いません。"}, {"type": "subtitle", "time": 2233.41, "timestamp": "00:37:13", "text": "私はただ使っているだけです"}, {"type": "subtitle", "time": 2235.611, "timestamp": "00:37:15", "text": "ああ、カメラのズーム機能ですね。わかった。"}, {"type": "subtitle", "time": 2236.139, "timestamp": "00:37:16", "text": "うん、"}, {"type": "subtitle", "time": 2241.454, "timestamp": "00:37:21", "text": "それはまるでセッション全体のようなもの"}, {"type": "subtitle", "time": 2241.815, "timestamp": "00:37:21", "text": "写真。"}, {"type": "subtitle", "time": 2245.12, "timestamp": "00:37:25", "text": "私はすでにトラッキングを使用していると思っていました 。"}, {"type": "subtitle", "time": 2249.212, "timestamp": "00:37:29", "text": "いいえ、フォローアップはありません。それは難しい。"}, {"type": "subtitle", "time": 2253.367, "timestamp": "00:37:33", "text": "ライブ配信するため"}, {"type": "subtitle", "time": 2258.359, "timestamp": "00:37:38", "text": "胸の大きさはどれくらいか、"}, {"type": "subtitle", "time": 2258.909, "timestamp": "00:37:38", "text": "そんな感じ。"}, {"type": "subtitle", "time": 2262.342, "timestamp": "00:37:42", "text": "いいえ、色の組み合わせとか全部、そして"}, {"type": "subtitle", "time": 2264.059, "timestamp": "00:37:44", "text": "いくつか誤りがあります。"}, {"type": "subtitle", "time": 2269.667, "timestamp": "00:37:49", "text": "わかった、あのね？おっしゃることは理解できます。"}, {"type": "subtitle", "time": 2270.278, "timestamp": "00:37:50", "text": "もしかして。"}, {"type": "subtitle", "time": 2276.182, "timestamp": "00:37:56", "text": "はい、音声ファイルで出力できると思います。"}]
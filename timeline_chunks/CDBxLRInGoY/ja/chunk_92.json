[{"type": "subtitle", "time": 5523.148, "timestamp": "01:32:03", "text": "はい、プレイヤーは1人だけです。"}, {"type": "subtitle", "time": 5527.988, "timestamp": "01:32:07", "text": "やったよ。他の人はどんな人ですか？"}, {"type": "subtitle", "time": 5530.524, "timestamp": "01:32:10", "text": "はい、私です。それは私です。"}, {"type": "subtitle", "time": 5532.806, "timestamp": "01:32:12", "text": "はい、そうです。"}, {"type": "subtitle", "time": 5540.829, "timestamp": "01:32:20", "text": "私はそれをしました。覚えているような気がする。"}, {"type": "subtitle", "time": 5541.256, "timestamp": "01:32:21", "text": "私が"}, {"type": "subtitle", "time": 5545.275, "timestamp": "01:32:25", "text": "私にはその大会に出場するお金がなかった"}, {"type": "subtitle", "time": 5547.944, "timestamp": "01:32:27", "text": "それで。だから私は「よし、行こう」と思った。"}, {"type": "subtitle", "time": 5550.555, "timestamp": "01:32:30", "text": "1人プレイで短時間で遊べるようにするため。"}, {"type": "subtitle", "time": 5555.72, "timestamp": "01:32:35", "text": "私はスピードランの動画を見て時間を過ごしました。"}, {"type": "subtitle", "time": 5563.193, "timestamp": "01:32:43", "text": "私はあらゆるゲームのスピードランをやっています。はい、"}, {"type": "subtitle", "time": 5565.235, "timestamp": "01:32:45", "text": "なぜかパルワールドを見始めた"}, {"type": "subtitle", "time": 5565.677, "timestamp": "01:32:45", "text": "理由。"}, {"type": "subtitle", "time": 5570.992, "timestamp": "01:32:50", "text": "はい、それは"}, {"type": "subtitle", "time": 5574.717, "timestamp": "01:32:54", "text": "すべてのゲームをスピードランする。いいえ"}, {"type": "subtitle", "time": 5576.424, "timestamp": "01:32:56", "text": "私たちは楽しもうとしていたわけではなかった。"}]
[{"type": "subtitle", "time": 5104.844, "timestamp": "01:25:04", "text": "はい。ああ、それも本当ですね。"}, {"type": "subtitle", "time": 5109.055, "timestamp": "01:25:09", "text": "はい、グランドマスタージェネラル。"}, {"type": "subtitle", "time": 5112.802, "timestamp": "01:25:12", "text": "じっと私を見て。私はほとんど話すことができません。"}, {"type": "subtitle", "time": 5116.75, "timestamp": "01:25:16", "text": "ええと、それは手放すことなんです。"}, {"type": "subtitle", "time": 5119.273, "timestamp": "01:25:19", "text": "放っておいて。"}, {"type": "subtitle", "time": 5122.13, "timestamp": "01:25:22", "text": "完全に手放しなさい。そんなことは考えないで"}, {"type": "subtitle", "time": 5123.835, "timestamp": "01:25:23", "text": "完全に手放さなければならない。のみ"}, {"type": "subtitle", "time": 5126.452, "timestamp": "01:25:26", "text": "少し緩めてください。ただ感じる"}, {"type": "subtitle", "time": 5129.79, "timestamp": "01:25:29", "text": "快適。私は物事をヨブの視点から捉えています"}, {"type": "subtitle", "time": 5133.324, "timestamp": "01:25:33", "text": "それで。彼はまだ諦めていないんだよ。"}, {"type": "subtitle", "time": 5136.632, "timestamp": "01:25:36", "text": "でも私は"}, {"type": "subtitle", "time": 5137.526, "timestamp": "01:25:37", "text": "私は沈黙する。"}, {"type": "subtitle", "time": 5139.503, "timestamp": "01:25:39", "text": "うん。"}, {"type": "subtitle", "time": 5142.084, "timestamp": "01:25:42", "text": "はい、本当です。はい、皆さん。いいえ"}, {"type": "subtitle", "time": 5144.511, "timestamp": "01:25:44", "text": "私たちはよく話をする。何か話は出ていますか？"}, {"type": "subtitle", "time": 5144.83, "timestamp": "01:25:44", "text": "ここ？"}, {"type": "subtitle", "time": 5150.511, "timestamp": "01:25:50", "text": "ええと、何と言えばいいでしょうか？"}, {"type": "subtitle", "time": 5155.462, "timestamp": "01:25:55", "text": "ある日、とても静かな日に、"}]
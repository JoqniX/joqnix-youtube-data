[{"type": "subtitle", "time": 3601.426, "timestamp": "01:00:01", "text": "それなら、それで遊ぼうかな。もうない"}, {"type": "subtitle", "time": 3604.438, "timestamp": "01:00:04", "text": "ジョブにもっとアイデアを与えてあげてよ、みんな。もうない"}, {"type": "subtitle", "time": 3605.754, "timestamp": "01:00:05", "text": "ジョーにもっとアイデアをあげて。"}, {"type": "subtitle", "time": 3611.849, "timestamp": "01:00:11", "text": "はい。えっと、どんなガチャゲームをプレイしてるんですか？"}, {"type": "subtitle", "time": 3613.111, "timestamp": "01:00:13", "text": "最近プレイしましたか？"}, {"type": "subtitle", "time": 3617.857, "timestamp": "01:00:17", "text": "もちろんです。ガチャゲーム。の"}, {"type": "subtitle", "time": 3622.889, "timestamp": "01:00:22", "text": "私の存在の破滅。理由は"}, {"type": "subtitle", "time": 3624.754, "timestamp": "01:00:24", "text": "私が人生でタスクを続けているもの、"}, {"type": "subtitle", "time": 3629.651, "timestamp": "01:00:29", "text": "私の人生で唯一のことは、"}, {"type": "subtitle", "time": 3630.17, "timestamp": "01:00:30", "text": "再現可能。"}, {"type": "subtitle", "time": 3637.299, "timestamp": "01:00:37", "text": "私は努力した"}, {"type": "subtitle", "time": 3641.735, "timestamp": "01:00:41", "text": "私は積極的にプレイし、"}, {"type": "subtitle", "time": 3645.111, "timestamp": "01:00:45", "text": "サイバーパンク的なもの。私はプレイして、"}, {"type": "subtitle", "time": 3647.873, "timestamp": "01:00:47", "text": "作業を中断してダウンロードしています。それ"}, {"type": "subtitle", "time": 3649.649, "timestamp": "01:00:49", "text": "もう一度ダウンロードしたのは、"}, {"type": "subtitle", "time": 3651.099, "timestamp": "01:00:51", "text": "ゲーム内で私のケーキを取って。"}, {"type": "subtitle", "time": 3655.619, "timestamp": "01:00:55", "text": "原神をダウンロードして"}]
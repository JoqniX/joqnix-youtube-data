[{"type": "subtitle", "time": 4502.022, "timestamp": "01:15:02", "text": "友人。これが真実だ。私...私は 心臓。はい、私は"}, {"type": "subtitle", "time": 4504.436, "timestamp": "01:15:04", "text": "心臓。はい、私は 私は19歳ですが、30歳で"}, {"type": "subtitle", "time": 4506.798, "timestamp": "01:15:06", "text": "私は19歳ですが、30歳で とてもたくさん。ええ、もちろんですよ、友よ。もちろん"}, {"type": "subtitle", "time": 4509.718, "timestamp": "01:15:09", "text": "とてもたくさん。ええ、もちろんですよ、友よ。もちろん 。"}, {"type": "subtitle", "time": 4509.878, "timestamp": "01:15:09", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 4510.973, "timestamp": "01:15:10", "text": "何てことだ。 はい。はい。はい。はい。はい。はい。何"}, {"type": "subtitle", "time": 4514.953, "timestamp": "01:15:14", "text": "はい。はい。はい。はい。はい。はい。何 なれ。君が幸せになれるなら、それでいいんだよ、友よ。それ"}, {"type": "subtitle", "time": 4517.681, "timestamp": "01:15:17", "text": "なれ。君が幸せになれるなら、それでいいんだよ、友よ。それ それはあなたを幸せにする。はい。さあ、ジョー。"}, {"type": "subtitle", "time": 4525.945, "timestamp": "01:15:25", "text": "それはあなたを幸せにする。はい。さあ、ジョー。 もっと頑張らなければならない。あなたの"}, {"type": "subtitle", "time": 4528.04, "timestamp": "01:15:28", "text": "もっと頑張らなければならない。あなたの ジャンプには勢いがない。"}, {"type": "subtitle", "time": 4533.716, "timestamp": "01:15:33", "text": "あなたを見ていると本当に気が滅入ります。"}, {"type": "subtitle", "time": 4539.663, "timestamp": "01:15:39", "text": "だから私は…に焦点を当てたくない。"}, {"type": "subtitle", "time": 4542.795, "timestamp": "01:15:42", "text": "できるかどうか試してみようと思います。"}, {"type": "subtitle", "time": 4549.46, "timestamp": "01:15:49", "text": "もし私が"}, {"type": "subtitle", "time": 4551.397, "timestamp": "01:15:51", "text": "今は話したり遊んだりして、私は去るだろう"}, {"type": "subtitle", "time": 4557.013, "timestamp": "01:15:57", "text": "かなり良い。来て。来て。"}]
[{"type": "subtitle", "time": 5364.361, "timestamp": "01:29:24", "text": "この車。うん。ああ、今夜は"}, {"type": "subtitle", "time": 5371.409, "timestamp": "01:29:31", "text": "もう一晩。いいえ、ほんの少しだけです"}, {"type": "subtitle", "time": 5379.349, "timestamp": "01:29:39", "text": "権力の。私？"}, {"type": "subtitle", "time": 5381.425, "timestamp": "01:29:41", "text": "いいえ、拾うことはできません。"}, {"type": "subtitle", "time": 5387.365, "timestamp": "01:29:47", "text": "はい、一緒にプレイしてみませんか？私はかなり上昇しました"}, {"type": "subtitle", "time": 5393.764, "timestamp": "01:29:53", "text": "高いレベルのね。 52だと思います。"}, {"type": "subtitle", "time": 5397.575, "timestamp": "01:29:57", "text": "兄さん、僕は30歳で止まってるんだ。どうすればいいの？"}]
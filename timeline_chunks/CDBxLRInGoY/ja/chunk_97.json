[{"type": "subtitle", "time": 5821.414, "timestamp": "01:37:01", "text": "長い間。しばらくの間"}, {"type": "subtitle", "time": 5824.404, "timestamp": "01:37:04", "text": "ねえ、私たちってどれくらい前から友達だったっけ？"}, {"type": "subtitle", "time": 5831.795, "timestamp": "01:37:11", "text": "はい。待って、なぜこんな感じがするんだろう"}, {"type": "subtitle", "time": 5833.448, "timestamp": "01:37:13", "text": "ライブ配信をしていた場合"}, {"type": "subtitle", "time": 5834.52, "timestamp": "01:37:14", "text": "友情の日について？"}, {"type": "subtitle", "time": 5837.84, "timestamp": "01:37:17", "text": "フレンドシップ・デーから生中継。おお、"}, {"type": "subtitle", "time": 5843.015, "timestamp": "01:37:23", "text": "我が神よ。来て！"}, {"type": "subtitle", "time": 5855.902, "timestamp": "01:37:35", "text": "はい、ずいぶん長い年月が経ちましたね。私たち"}, {"type": "subtitle", "time": 5857.907, "timestamp": "01:37:37", "text": "私たちは知り合いだし、今でも連絡を取り合っているし、"}, {"type": "subtitle", "time": 5858.178, "timestamp": "01:37:38", "text": "それ。"}, {"type": "subtitle", "time": 5870.3, "timestamp": "01:37:50", "text": "非常にきれい。はい。私も返品します。 。私たちは長い付き合いです。"}, {"type": "subtitle", "time": 5875.376, "timestamp": "01:37:55", "text": "。私たちは長い付き合いです。 私たちは長い付き合いです。"}, {"type": "subtitle", "time": 5879.981, "timestamp": "01:37:59", "text": "私が一番恋しいのは誰か、知っていますか？"}]
[{"type": "subtitle", "time": 2349.217, "timestamp": "00:39:09", "text": "バカな耳。咳をしていますか、"}, {"type": "subtitle", "time": 2351.183, "timestamp": "00:39:11", "text": "くしゃみ？私には分かりません。"}, {"type": "subtitle", "time": 2354.899, "timestamp": "00:39:14", "text": "彼は咳をしている。彼に何かを持って行くように言ってください"}, {"type": "subtitle", "time": 2357.018, "timestamp": "00:39:17", "text": "咳とか、そんな感じのやつ。彼は死にかけている。"}, {"type": "subtitle", "time": 2363.223, "timestamp": "00:39:23", "text": "雨のせいで寒いのも理由の一つです。"}, {"type": "subtitle", "time": 2369.076, "timestamp": "00:39:29", "text": "ああ、そうですね。病気にならないでね、友よ。しないで"}, {"type": "subtitle", "time": 2369.73, "timestamp": "00:39:29", "text": "病気。"}, {"type": "subtitle", "time": 2375.8, "timestamp": "00:39:35", "text": "指輪を持ってきてよかった。"}, {"type": "subtitle", "time": 2376.99, "timestamp": "00:39:36", "text": "今日は雨がたくさん降ったから。"}, {"type": "subtitle", "time": 2381.314, "timestamp": "00:39:41", "text": "何てことだ。推測させてください"}, {"type": "subtitle", "time": 2383.493, "timestamp": "00:39:43", "text": "雨の中の車の色。ピンク色でしたか？"}, {"type": "subtitle", "time": 2385.958, "timestamp": "00:39:45", "text": "いいえ。黒です。"}, {"type": "subtitle", "time": 2391.276, "timestamp": "00:39:51", "text": "ああ、黒だ。なぜ？なぜそう思うのですか"}, {"type": "subtitle", "time": 2391.841, "timestamp": "00:39:51", "text": "ピンクとは何ですか？"}, {"type": "subtitle", "time": 2394.727, "timestamp": "00:39:54", "text": "わからない。"}]
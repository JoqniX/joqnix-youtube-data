[{"type": "subtitle", "time": 1980.168, "timestamp": "00:33:00", "text": "まるで祖父のような存在だ。"}, {"type": "subtitle", "time": 1987.668, "timestamp": "00:33:07", "text": "祖父。何てことだ。ああ、そうだね。"}, {"type": "subtitle", "time": 1989.207, "timestamp": "00:33:09", "text": "私も白髪です。"}, {"type": "subtitle", "time": 1993.132, "timestamp": "00:33:13", "text": "何てことだ。現時点で私は"}, {"type": "subtitle", "time": 1993.929, "timestamp": "00:33:13", "text": "殺してくれ"}, {"type": "subtitle", "time": 1996.756, "timestamp": "00:33:16", "text": "この点です。私は自分自身をからかっている"}, {"type": "subtitle", "time": 1997.096, "timestamp": "00:33:17", "text": "同じ。"}, {"type": "subtitle", "time": 2000.612, "timestamp": "00:33:20", "text": "そうかもしれない。そうかもしれない。"}, {"type": "subtitle", "time": 2003.573, "timestamp": "00:33:23", "text": "はい。くそ。"}, {"type": "subtitle", "time": 2011.648, "timestamp": "00:33:31", "text": "神様、私の方を見ているあなたのモデルを見てください"}, {"type": "subtitle", "time": 2012.418, "timestamp": "00:33:32", "text": "固定して"}, {"type": "subtitle", "time": 2017.737, "timestamp": "00:33:37", "text": "今気づいたんだけど、"}, {"type": "subtitle", "time": 2020.584, "timestamp": "00:33:40", "text": "ある日、彼は私を威嚇するように見つめた。"}, {"type": "subtitle", "time": 2025.532, "timestamp": "00:33:45", "text": "心配しないで。いつか私は"}, {"type": "subtitle", "time": 2025.873, "timestamp": "00:33:45", "text": "動く。"}, {"type": "subtitle", "time": 2034.252, "timestamp": "00:33:54", "text": "そうですね、そう願っています。ああ、私は"}, {"type": "subtitle", "time": 2038.594, "timestamp": "00:33:58", "text": "私は進み続けなければならない"}]
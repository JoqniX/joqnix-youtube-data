[{"type": "subtitle", "time": 6120.134, "timestamp": "01:42:00", "text": "さて、私の2時間配信です。"}, {"type": "subtitle", "time": 6122.555, "timestamp": "01:42:02", "text": "もう2時間経った。"}, {"type": "subtitle", "time": 6125.849, "timestamp": "01:42:05", "text": "うん。"}, {"type": "subtitle", "time": 6128.78, "timestamp": "01:42:08", "text": "それはおかしい。"}, {"type": "subtitle", "time": 6133.413, "timestamp": "01:42:13", "text": "はい。あのね？私たちは遊ぶべきだ"}, {"type": "subtitle", "time": 6137.168, "timestamp": "01:42:17", "text": "いつかピークを迎える日が来る。そして、もしあなたがそれをプレイしたいなら、"}, {"type": "subtitle", "time": 6137.722, "timestamp": "01:42:17", "text": "教えて。"}, {"type": "subtitle", "time": 6141.694, "timestamp": "01:42:21", "text": "ああ、そうそうそう。本当に？もちろん。"}, {"type": "subtitle", "time": 6152.929, "timestamp": "01:42:32", "text": "はい。一緒に遊んでくれる友達はいますか？"}, {"type": "subtitle", "time": 6159.702, "timestamp": "01:42:39", "text": "はい、とてもいいですね。それは"}, {"type": "subtitle", "time": 6161.788, "timestamp": "01:42:41", "text": "私がモバイルゲームをやめた理由"}, {"type": "subtitle", "time": 6166.306, "timestamp": "01:42:46", "text": "ライバル。私には一緒にいてくれる人がいなかったからです。"}, {"type": "subtitle", "time": 6166.634, "timestamp": "01:42:46", "text": "遊ぶ。"}, {"type": "subtitle", "time": 6170.453, "timestamp": "01:42:50", "text": "もし私が持っていなかったらどうなるだろうか"}, {"type": "subtitle", "time": 6173.119, "timestamp": "01:42:53", "text": "一緒に遊ぶ相手がいない。それ"}, {"type": "subtitle", "time": 6176.144, "timestamp": "01:42:56", "text": "私がどんなゲームをプレイするのか、とかそういうことですか？私はいつも"}, {"type": "subtitle", "time": 6176.906, "timestamp": "01:42:56", "text": "私はそれを尋ねます。"}, {"type": "subtitle", "time": 6179.179, "timestamp": "01:42:59", "text": "だから僕はHadesみたいなゲームをプレイするんだよ。"}]
[{"type": "subtitle", "time": 3120.662, "timestamp": "00:52:00", "text": "はい。他のゲームは試してみましたか？"}, {"type": "subtitle", "time": 3122.558, "timestamp": "00:52:02", "text": "「友達と賭けをする」と呼ばれていますか？"}, {"type": "subtitle", "time": 3127.508, "timestamp": "00:52:07", "text": "友達と賭けをしよう。ええと、単純に"}, {"type": "subtitle", "time": 3130.856, "timestamp": "00:52:10", "text": "賭け、いや、そんな感じはしないよ、"}, {"type": "subtitle", "time": 3135.274, "timestamp": "00:52:15", "text": "あのカジノ追跡ツールのことね。うん。"}, {"type": "subtitle", "time": 3139.673, "timestamp": "00:52:19", "text": "はい。それは私にそれを与えてくれる。"}, {"type": "subtitle", "time": 3141.86, "timestamp": "00:52:21", "text": "「マシン」という新しいゲームがあります。"}, {"type": "subtitle", "time": 3143.947, "timestamp": "00:52:23", "text": "人々が遊んでいるパーティー。"}, {"type": "subtitle", "time": 3149.763, "timestamp": "00:52:29", "text": "ああ、そうですね。はい。それを見たよ。それを見たよ。があります"}, {"type": "subtitle", "time": 3150.853, "timestamp": "00:52:30", "text": "発射、えーと"}, {"type": "subtitle", "time": 3151.316, "timestamp": "00:52:31", "text": "うん"}, {"type": "subtitle", "time": 3153.941, "timestamp": "00:52:33", "text": "現在、ディレクトリサービスのキャンペーンを実施中です。"}, {"type": "subtitle", "time": 3156.942, "timestamp": "00:52:36", "text": "本当に血なまぐさい話ですよね？"}, {"type": "subtitle", "time": 3158.53, "timestamp": "00:52:38", "text": "血。"}, {"type": "subtitle", "time": 3165.048, "timestamp": "00:52:45", "text": "はい。えっと、あのゲームって何だったっけ？ ？"}, {"type": "subtitle", "time": 3171.747, "timestamp": "00:52:51", "text": "バック。はい、バックショットです。それは"}, {"type": "subtitle", "time": 3173.928, "timestamp": "00:52:53", "text": "それに似ているけど、それはまるで"}, {"type": "subtitle", "time": 3176.825, "timestamp": "00:52:56", "text": "マリオパーティもね。あなたは"}, {"type": "subtitle", "time": 3178.87, "timestamp": "00:52:58", "text": "友達ではあるけど、私たち３人だけだよ。"}]
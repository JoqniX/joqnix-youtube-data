[{"type": "subtitle", "time": 3002.107, "timestamp": "00:50:02", "text": "はい。あなたは"}, {"type": "subtitle", "time": 3005.186, "timestamp": "00:50:05", "text": "はい。ごめん。ちょうどダウンロードしていたところでした"}, {"type": "subtitle", "time": 3008.727, "timestamp": "00:50:08", "text": "あなたが話している間に、私たちは飛び上がりました。欲しい"}, {"type": "subtitle", "time": 3019.675, "timestamp": "00:50:19", "text": "練習して、今私が望んでいたように言う"}, {"type": "subtitle", "time": 3020.237, "timestamp": "00:50:20", "text": "チャレンジ。"}, {"type": "subtitle", "time": 3024.255, "timestamp": "00:50:24", "text": "それで、あなたはプレイしていましたか？ただ"}, {"type": "subtitle", "time": 3026.091, "timestamp": "00:50:26", "text": "「君はピークをプレイしている」と話しながら"}, {"type": "subtitle", "time": 3027.81, "timestamp": "00:50:27", "text": "私たちと一緒に？それがあなたの仕事ですか？"}, {"type": "subtitle", "time": 3030.181, "timestamp": "00:50:30", "text": "いや、いや、いや。ジャンプ。"}, {"type": "subtitle", "time": 3032.029, "timestamp": "00:50:32", "text": "跳躍。"}, {"type": "subtitle", "time": 3035.272, "timestamp": "00:50:35", "text": "あなたと一緒にそれをする方法。」ピーク「"}, {"type": "subtitle", "time": 3038.184, "timestamp": "00:50:38", "text": "次回。あまり。"}, {"type": "subtitle", "time": 3041.196, "timestamp": "00:50:41", "text": "深夜勤務。来て。来て。シフト"}, {"type": "subtitle", "time": 3047.489, "timestamp": "00:50:47", "text": "真夜中に。来て。来て。わからない。"}, {"type": "subtitle", "time": 3048.85, "timestamp": "00:50:48", "text": "七面鳥5羽。"}, {"type": "subtitle", "time": 3053.228, "timestamp": "00:50:53", "text": "何てことだ。それは一つです"}, {"type": "subtitle", "time": 3058.309, "timestamp": "00:50:58", "text": "1,000。私はそうは思わない。"}]
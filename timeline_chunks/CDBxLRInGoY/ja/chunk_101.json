[{"type": "subtitle", "time": 6063.534, "timestamp": "01:41:03", "text": "はい。袋のような気分になったことはありますか？"}, {"type": "subtitle", "time": 6064.046, "timestamp": "01:41:04", "text": "プラスチック？"}, {"type": "subtitle", "time": 6071.62, "timestamp": "01:41:11", "text": "ああ、私もそう言おうと思っていました。レディー・ガガの曲ですか？"}, {"type": "subtitle", "time": 6075.289, "timestamp": "01:41:15", "text": "いいえ、ケイティ・ペリーです。ケイティ・ペリーの曲、"}, {"type": "subtitle", "time": 6075.816, "timestamp": "01:41:15", "text": "真実？"}, {"type": "subtitle", "time": 6076.668, "timestamp": "01:41:16", "text": "ケイティ・ペリー。"}, {"type": "subtitle", "time": 6082.006, "timestamp": "01:41:22", "text": "はい。インド訛りで言わないで。 、 お願いします。"}, {"type": "subtitle", "time": 6086.352, "timestamp": "01:41:26", "text": "インド訛りで話してみた。それ？"}, {"type": "subtitle", "time": 6089.259, "timestamp": "01:41:29", "text": "ケイティ・ペリー。"}, {"type": "subtitle", "time": 6092.464, "timestamp": "01:41:32", "text": "ケイティ、ケイティ。ケイティ。"}, {"type": "subtitle", "time": 6095.377, "timestamp": "01:41:35", "text": "ケイティ。ケイティ。ケイティ。"}, {"type": "subtitle", "time": 6096.619, "timestamp": "01:41:36", "text": "ケイティ。わかった。"}, {"type": "subtitle", "time": 6098.569, "timestamp": "01:41:38", "text": "うん。"}, {"type": "subtitle", "time": 6099.65, "timestamp": "01:41:39", "text": "ケイティ・ペリー。"}, {"type": "subtitle", "time": 6100.809, "timestamp": "01:41:40", "text": "うん。"}, {"type": "subtitle", "time": 6108.467, "timestamp": "01:41:48", "text": "もうすぐ午後10時だ。あなたのために。すでに"}, {"type": "subtitle", "time": 6111.164, "timestamp": "01:41:51", "text": "そうです。配信は8時に始めたんじゃなかったっけ？"}, {"type": "subtitle", "time": 6115.386, "timestamp": "01:41:55", "text": "あなたのために？君のために？あなたのために？"}]
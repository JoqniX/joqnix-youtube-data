[{"type": "subtitle", "time": 4560.029, "timestamp": "01:16:00", "text": "わかった。だから…だから、もしかしたら…"}, {"type": "subtitle", "time": 4565.045, "timestamp": "01:16:05", "text": "80年代。 80年代とは何ですか？ 88年の"}, {"type": "subtitle", "time": 4566.169, "timestamp": "01:16:06", "text": "2人か3人？"}, {"type": "subtitle", "time": 4570.747, "timestamp": "01:16:10", "text": "二。友よ、その３人は誰だったんだ？ 誰がでっち上げをしているんだ"}, {"type": "subtitle", "time": 4572.233, "timestamp": "01:16:12", "text": "誰がでっち上げをしているんだ 未来？"}, {"type": "subtitle", "time": 4589.911, "timestamp": "01:16:29", "text": "これは…あれは…ああ、あれは"}, {"type": "subtitle", "time": 4596.036, "timestamp": "01:16:36", "text": "初め。言うまでもなく私は57歳です"}, {"type": "subtitle", "time": 4602.127, "timestamp": "01:16:42", "text": "最初の作品では数時間。はい。ええ、あれですね。"}, {"type": "subtitle", "time": 4608.361, "timestamp": "01:16:48", "text": "このゲームに終わりはない。しかし…それでも。"}, {"type": "subtitle", "time": 4615.116, "timestamp": "01:16:55", "text": "はい。まあ、終わらせることはできないけど、"}, {"type": "subtitle", "time": 4617.751, "timestamp": "01:16:57", "text": "最高難易度でプレイできます。"}]
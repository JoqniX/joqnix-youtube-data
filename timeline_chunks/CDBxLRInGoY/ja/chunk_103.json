[{"type": "subtitle", "time": 6181.672, "timestamp": "01:43:01", "text": "ハデスやストーリーゲームは"}, {"type": "subtitle", "time": 6184.1, "timestamp": "01:43:04", "text": "1人のプレイヤーがプレイできます"}, {"type": "subtitle", "time": 6184.804, "timestamp": "01:43:04", "text": "あなたのアカウント。"}, {"type": "subtitle", "time": 6186.248, "timestamp": "01:43:06", "text": "うん。"}, {"type": "subtitle", "time": 6188.742, "timestamp": "01:43:08", "text": "プレイヤーは1人。"}, {"type": "subtitle", "time": 6193.939, "timestamp": "01:43:13", "text": "それだけです。はい。とにかく、私は"}, {"type": "subtitle", "time": 6196.297, "timestamp": "01:43:16", "text": "先生、ここで彼は終わりにしたいのです、なぜなら"}, {"type": "subtitle", "time": 6198.538, "timestamp": "01:43:18", "text": "彼はとても疲れているし、私もそうだ。"}, {"type": "subtitle", "time": 6199.659, "timestamp": "01:43:19", "text": "とても疲れています。"}, {"type": "subtitle", "time": 6204.912, "timestamp": "01:43:24", "text": "はい。問題ない。"}, {"type": "subtitle", "time": 6208.517, "timestamp": "01:43:28", "text": "はい。はい、完了できます。"}, {"type": "subtitle", "time": 6211.147, "timestamp": "01:43:31", "text": "私たちは2時間話しました。"}, {"type": "subtitle", "time": 6212.934, "timestamp": "01:43:32", "text": "来て。"}, {"type": "subtitle", "time": 6213.983, "timestamp": "01:43:33", "text": "うん。"}, {"type": "subtitle", "time": 6215.33, "timestamp": "01:43:35", "text": "私たちはほとんど何も話さなかった。"}, {"type": "subtitle", "time": 6215.888, "timestamp": "01:43:35", "text": "わーい。"}, {"type": "subtitle", "time": 6217.807, "timestamp": "01:43:37", "text": "はい、2時間話しました。"}, {"type": "subtitle", "time": 6221.635, "timestamp": "01:43:41", "text": "いいえ、私たちはほとんど何も話しませんでした。私たちは話さなかった。"}, {"type": "subtitle", "time": 6225.538, "timestamp": "01:43:45", "text": "私に一体何が起こったのだろう。私は"}, {"type": "subtitle", "time": 6226.856, "timestamp": "01:43:46", "text": "実生活で忙しい。"}, {"type": "subtitle", "time": 6232.422, "timestamp": "01:43:52", "text": "生前はあまり話すことができなかった"}, {"type": "subtitle", "time": 6233.759, "timestamp": "01:43:53", "text": "本物。はい。はい。"}, {"type": "subtitle", "time": 6236.856, "timestamp": "01:43:56", "text": "はい。私は話すことができませんでした"}]
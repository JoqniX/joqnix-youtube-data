[{"type": "subtitle", "time": 6361.024, "timestamp": "01:46:01", "text": "単純。私は次の日の計画を立てます"}, {"type": "subtitle", "time": 6362.989, "timestamp": "01:46:02", "text": "あなたが言ったように、あなたができる"}, {"type": "subtitle", "time": 6364.673, "timestamp": "01:46:04", "text": "ホラーゲームをプレイするか"}, {"type": "subtitle", "time": 6370.536, "timestamp": "01:46:10", "text": "真実。大丈夫、"}, {"type": "subtitle", "time": 6380.14, "timestamp": "01:46:20", "text": "私はそれを行うことができます。はい。はい。はい、そうかもしれません。"}, {"type": "subtitle", "time": 6381.331, "timestamp": "01:46:21", "text": "私たちはここを離れるべきだ。"}, {"type": "subtitle", "time": 6383.642, "timestamp": "01:46:23", "text": "ああ、今日はありがとうございました。"}, {"type": "subtitle", "time": 6388.397, "timestamp": "01:46:28", "text": "私からも感謝をお伝えください。"}, {"type": "subtitle", "time": 6390.489, "timestamp": "01:46:30", "text": "うん。"}, {"type": "subtitle", "time": 6391.786, "timestamp": "01:46:31", "text": "バイバイ。"}, {"type": "subtitle", "time": 6409.849, "timestamp": "01:46:49", "text": "またさよなら？よし、あれはレッドだった"}, {"type": "subtitle", "time": 6415.567, "timestamp": "01:46:55", "text": "そして三日月ゆる。お二人ともありがとうございました"}]
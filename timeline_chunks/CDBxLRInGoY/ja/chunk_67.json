[{"type": "subtitle", "time": 4021.023, "timestamp": "01:07:01", "text": "あれは何でしょう？"}, {"type": "subtitle", "time": 4024.127, "timestamp": "01:07:04", "text": "そう、メトロイドヴァニア系のゲームのことだよ。 。"}, {"type": "subtitle", "time": 4030.002, "timestamp": "01:07:10", "text": "ええ、あなたはそれが好きなんですね。持っている"}, {"type": "subtitle", "time": 4036.157, "timestamp": "01:07:16", "text": "重力回路？あのゲーム？"}, {"type": "subtitle", "time": 4041.065, "timestamp": "01:07:21", "text": "はい。私たちの親友であるVがそれをプレイしました。"}, {"type": "subtitle", "time": 4041.453, "timestamp": "01:07:21", "text": "ゲーム。"}, {"type": "subtitle", "time": 4042.632, "timestamp": "01:07:22", "text": "うん、"}, {"type": "subtitle", "time": 4043.791, "timestamp": "01:07:23", "text": "時間。"}, {"type": "subtitle", "time": 4047.362, "timestamp": "01:07:27", "text": "たった60時間。"}, {"type": "subtitle", "time": 4051.072, "timestamp": "01:07:31", "text": "もっとたくさんいると思う。私は思う"}, {"type": "subtitle", "time": 4053.463, "timestamp": "01:07:33", "text": "私はかなり低いハードルを設定しています。信じる"}, {"type": "subtitle", "time": 4054.675, "timestamp": "01:07:34", "text": "それらはさらに多い。"}, {"type": "subtitle", "time": 4056.823, "timestamp": "01:07:36", "text": "無料ではありません。"}, {"type": "subtitle", "time": 4058.76, "timestamp": "01:07:38", "text": "はい、間違いなくもっと必要です。"}, {"type": "subtitle", "time": 4067.197, "timestamp": "01:07:47", "text": "私は1,900持っています。ああ、これは、えっと、"}, {"type": "subtitle", "time": 4071.452, "timestamp": "01:07:51", "text": "それは何という名前ですか？仮面ライダー。"}, {"type": "subtitle", "time": 4078.102, "timestamp": "01:07:58", "text": "大丈夫。そして、それは事実です。むしろこうだ"}, {"type": "subtitle", "time": 4079.032, "timestamp": "01:07:59", "text": "ロックマンかヴェイルか。"}]
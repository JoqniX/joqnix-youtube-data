[{"type": "subtitle", "time": 4381.651, "timestamp": "01:13:01", "text": "ロールプレイングまたは演技"}, {"type": "subtitle", "time": 4382.471, "timestamp": "01:13:02", "text": "別のキャラクター。"}, {"type": "subtitle", "time": 4386.749, "timestamp": "01:13:06", "text": "はい、それならあなたはあまり"}, {"type": "subtitle", "time": 4401.177, "timestamp": "01:13:21", "text": "それに関しては得意だ。私はこのピザを食べました。自分"}, {"type": "subtitle", "time": 4402.995, "timestamp": "01:13:22", "text": "見ている人たちが気の毒に思います。"}, {"type": "subtitle", "time": 4406.714, "timestamp": "01:13:26", "text": "私は自分のこのビジュアルが本当に好きです"}, {"type": "subtitle", "time": 4407.47, "timestamp": "01:13:27", "text": "イントロだと思う。"}, {"type": "subtitle", "time": 4415.542, "timestamp": "01:13:35", "text": "私は悲しいです。私は彼らが気の毒だと思う。"}, {"type": "subtitle", "time": 4421.355, "timestamp": "01:13:41", "text": "はい。かつて放送した時のことを覚えている"}, {"type": "subtitle", "time": 4423.939, "timestamp": "01:13:43", "text": "私は「お願いだからやめてください」と言いました。"}, {"type": "subtitle", "time": 4428.906, "timestamp": "01:13:48", "text": "\"ゲーム\"。より低い。これを終わらせてください。"}, {"type": "subtitle", "time": 4439.352, "timestamp": "01:13:59", "text": "お願いだ、兄弟。彼らはおそらくこう言うだろう 「うわ、そんなにひどいのか、兄さん？」"}]
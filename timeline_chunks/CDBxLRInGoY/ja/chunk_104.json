[{"type": "subtitle", "time": 6246.047, "timestamp": "01:44:06", "text": "だから、もし取引があるなら、成立させましょう。"}, {"type": "subtitle", "time": 6248.791, "timestamp": "01:44:08", "text": "待って、ああ、そうだ。私はしなければならない"}, {"type": "subtitle", "time": 6254.839, "timestamp": "01:44:14", "text": "配信を終了します。今行ってる。それで"}, {"type": "subtitle", "time": 6259.32, "timestamp": "01:44:19", "text": "はい、必ずやり遂げます。申し訳ありません"}, {"type": "subtitle", "time": 6262.104, "timestamp": "01:44:22", "text": "短い配信、つまり2時間だった、"}, {"type": "subtitle", "time": 6262.805, "timestamp": "01:44:22", "text": "しかし、もし。"}, {"type": "subtitle", "time": 6265.004, "timestamp": "01:44:25", "text": "グラフ上では6未満。"}, {"type": "subtitle", "time": 6269.434, "timestamp": "01:44:29", "text": "2時間は短い。6時間だと長いくらいだ。"}, {"type": "subtitle", "time": 6273.868, "timestamp": "01:44:33", "text": "ほら、ほら、"}, {"type": "subtitle", "time": 6277.717, "timestamp": "01:44:37", "text": "君は私が自分の"}, {"type": "subtitle", "time": 6280.405, "timestamp": "01:44:40", "text": "ストリーミング配信は、4時間くらいだと私にとっては短い。"}, {"type": "subtitle", "time": 6282.892, "timestamp": "01:44:42", "text": "以前は短いと言っていましたが、今は"}, {"type": "subtitle", "time": 6288.169, "timestamp": "01:44:48", "text": "長くは続くが、それは"}, {"type": "subtitle", "time": 6288.669, "timestamp": "01:44:48", "text": "平均。"}, {"type": "subtitle", "time": 6290.969, "timestamp": "01:44:50", "text": "うん。"}, {"type": "subtitle", "time": 6299.297, "timestamp": "01:44:59", "text": "はい。これで終わりにします。ありがとう"}]
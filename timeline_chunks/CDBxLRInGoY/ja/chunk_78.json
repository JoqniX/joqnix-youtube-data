[{"type": "subtitle", "time": 4684.224, "timestamp": "01:18:04", "text": "彼らは新しいキャラクターを登場させた。それ"}, {"type": "subtitle", "time": 4685.181, "timestamp": "01:18:05", "text": "このキャラクターは発売されたのですか？"}, {"type": "subtitle", "time": 4690.056, "timestamp": "01:18:10", "text": "彼らは新しいキャラクターを2人導入したと思う。"}, {"type": "subtitle", "time": 4694.349, "timestamp": "01:18:14", "text": "今シーズン。ジュビリーと、えーと、"}, {"type": "subtitle", "time": 4701.39, "timestamp": "01:18:21", "text": "フード。そしてジュビリーは戦略家のような存在で、"}, {"type": "subtitle", "time": 4704.121, "timestamp": "01:18:24", "text": "ほら、ダメージだよ。そしてザ・フッドは"}, {"type": "subtitle", "time": 4707.113, "timestamp": "01:18:27", "text": "グロックみたいな銃を持った戦車、ほら、"}, {"type": "subtitle", "time": 4714.089, "timestamp": "01:18:34", "text": "拳銃2丁。私たちは何をプレイするだろうか、"}, {"type": "subtitle", "time": 4716.741, "timestamp": "01:18:36", "text": "私たちの役割は何になるのでしょうか？みんな、"}, {"type": "subtitle", "time": 4721.609, "timestamp": "01:18:41", "text": "彼らは癒し手の役割を担うだろう。はい、彼らは既に知っています。"}, {"type": "subtitle", "time": 4724.075, "timestamp": "01:18:44", "text": "誰がヒーラー役を演じるだろうか、誰が"}, {"type": "subtitle", "time": 4730.273, "timestamp": "01:18:50", "text": "タンク役は誰で、DPS役は誰ですか？ああ、そうだね。がある"}, {"type": "subtitle", "time": 4732.192, "timestamp": "01:18:52", "text": "似たような新しいキャラクター"}, {"type": "subtitle", "time": 4732.291, "timestamp": "01:18:52", "text": "に"}]
[{"type": "subtitle", "time": 5221.194, "timestamp": "01:27:01", "text": "私は滑ってしまった。えっと、私はそうすべきではないと思います"}, {"type": "subtitle", "time": 5221.788, "timestamp": "01:27:01", "text": "死にかけている。"}, {"type": "subtitle", "time": 5239.547, "timestamp": "01:27:19", "text": "何てことだ。野菜用クリスパー。それは"}, {"type": "subtitle", "time": 5247.483, "timestamp": "01:27:27", "text": "くそ。コディはあなたの家にいますか？ 夕食でも食べに行かないの？"}, {"type": "subtitle", "time": 5255.823, "timestamp": "01:27:35", "text": "実際、何もおかしなことはない。できないの？"}, {"type": "subtitle", "time": 5256.543, "timestamp": "01:27:36", "text": "何か準備するものはありますか？"}, {"type": "subtitle", "time": 5261.6, "timestamp": "01:27:41", "text": "では、何が特別なのでしょうか？"}, {"type": "subtitle", "time": 5269.707, "timestamp": "01:27:49", "text": "ジョックニック？ああ、それは…ああ、つまり、"}, {"type": "subtitle", "time": 5274.598, "timestamp": "01:27:54", "text": "誕生日パーティーは終わった。私が食べたあの時"}]
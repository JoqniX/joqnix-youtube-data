[{"type": "subtitle", "time": 1562.124, "timestamp": "00:26:02", "text": "。今、いいって言ったっけ？は 貧乏なのも悪くない。どのようなタイプの"}, {"type": "subtitle", "time": 1566.357, "timestamp": "00:26:06", "text": "貧乏なのも悪くない。どのようなタイプの 橋のどこにお住まいですか？"}, {"type": "subtitle", "time": 1573.36, "timestamp": "00:26:13", "text": "いいえ、そういう意味ではありませんでした。私は"}, {"type": "subtitle", "time": 1576.167, "timestamp": "00:26:16", "text": "つまり、えっと、つまり、どういう意味だったかな"}, {"type": "subtitle", "time": 1579.189, "timestamp": "00:26:19", "text": "どういう意味だったんだろう？どういう意味だったんだろう？はぁ？"}, {"type": "subtitle", "time": 1584.41, "timestamp": "00:26:24", "text": "ただ、まあ、誰にでも起こりうることだからね。"}, {"type": "subtitle", "time": 1586.692, "timestamp": "00:26:26", "text": "私たちはただ、言いたいことを言っているだけだよ。"}, {"type": "subtitle", "time": 1589.283, "timestamp": "00:26:29", "text": "文を完成させる。それだけです"}, {"type": "subtitle", "time": 1591.286, "timestamp": "00:26:31", "text": "それは、あなたが語彙力に欠けていることを示しています。"}, {"type": "subtitle", "time": 1596.432, "timestamp": "00:26:36", "text": "完璧だ。語彙？ええ、そうです。"}, {"type": "subtitle", "time": 1599.603, "timestamp": "00:26:39", "text": "私の英語は下手です。だから、難しいと思う"}, {"type": "subtitle", "time": 1600.496, "timestamp": "00:26:40", "text": "語彙。"}, {"type": "subtitle", "time": 1604.948, "timestamp": "00:26:44", "text": "はい。英語がとても上手な人は誰ですか？ ？"}, {"type": "subtitle", "time": 1606.888, "timestamp": "00:26:46", "text": "はい。あなた"}, {"type": "subtitle", "time": 1609.919, "timestamp": "00:26:49", "text": "あなたは英語を話し、英語を呼吸し、"}, {"type": "subtitle", "time": 1612.097, "timestamp": "00:26:52", "text": "もしかしたら、あなたはここに留まるかもしれませんね。"}, {"type": "subtitle", "time": 1614.218, "timestamp": "00:26:54", "text": "彼はここユーリではなかなか立派な青年だ。おお、"}, {"type": "subtitle", "time": 1614.882, "timestamp": "00:26:54", "text": "来て。"}, {"type": "subtitle", "time": 1616.662, "timestamp": "00:26:56", "text": "ああ、そうだね。はい。はい。"}, {"type": "subtitle", "time": 1618.879, "timestamp": "00:26:58", "text": "明かりをつけています。海の血 。"}, {"type": "subtitle", "time": 1619.442, "timestamp": "00:26:59", "text": "。 ああ、そうだね。はい。どちらも得意なのは"}]
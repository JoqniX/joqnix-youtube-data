[{"type": "subtitle", "time": 3785.686, "timestamp": "01:03:05", "text": "ニンジン。よし、みんな、行こう。"}, {"type": "subtitle", "time": 3787.685, "timestamp": "01:03:07", "text": "深夜に「シフト」をプレイする必要がある。"}, {"type": "subtitle", "time": 3789.861, "timestamp": "01:03:09", "text": "来て。おお、"}, {"type": "subtitle", "time": 3792.966, "timestamp": "01:03:12", "text": "私たちは皆、遊ぶ。"}, {"type": "subtitle", "time": 3797.911, "timestamp": "01:03:17", "text": "どちらも当てはまります。あった。みんなで遊ぶ"}, {"type": "subtitle", "time": 3799.969, "timestamp": "01:03:19", "text": "一緒に。私たちはみんな一緒に叫んだ。"}, {"type": "subtitle", "time": 3808.695, "timestamp": "01:03:28", "text": "はい。心配しないで、私はあなたに"}, {"type": "subtitle", "time": 3811.97, "timestamp": "01:03:31", "text": "他愛もない話をしている。あなたにはさせません"}, {"type": "subtitle", "time": 3814.844, "timestamp": "01:03:34", "text": "濃縮物。いや、いや、いや、"}, {"type": "subtitle", "time": 3824.833, "timestamp": "01:03:44", "text": "兄弟。または、M をプレイすることもできます"}, {"type": "subtitle", "time": 3825.317, "timestamp": "01:03:45", "text": "ライバル。"}, {"type": "subtitle", "time": 3833.936, "timestamp": "01:03:53", "text": "マーベル・ライバルズ。一緒に遊びませんか？"}]
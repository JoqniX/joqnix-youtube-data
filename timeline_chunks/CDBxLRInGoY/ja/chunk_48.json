[{"type": "subtitle", "time": 2882.397, "timestamp": "00:48:02", "text": "私は参加しません。私たちはそうするつもりはありません...私たちはそうするつもりはありません 遊ぶ。"}, {"type": "subtitle", "time": 2883.038, "timestamp": "00:48:03", "text": "遊ぶ。 ピークへ入ろう。"}, {"type": "subtitle", "time": 2888.172, "timestamp": "00:48:08", "text": "いいえ、今はダウンロードしません。"}, {"type": "subtitle", "time": 2890.404, "timestamp": "00:48:10", "text": "私は自分自身さえもコントロールできていない。"}, {"type": "subtitle", "time": 2893.251, "timestamp": "00:48:13", "text": "私が今何をしているか知っていますか？"}, {"type": "subtitle", "time": 2895.549, "timestamp": "00:48:15", "text": "こっちも一緒？私が何をしているか知っていますか？"}, {"type": "subtitle", "time": 2898.62, "timestamp": "00:48:18", "text": "今すぐ？私は横になっています。私の"}, {"type": "subtitle", "time": 2900.611, "timestamp": "00:48:20", "text": "コンピューターは私の頭上にあり、私は"}, {"type": "subtitle", "time": 2903.302, "timestamp": "00:48:23", "text": "リラックスしています。リラックスさせてください"}, {"type": "subtitle", "time": 2904.738, "timestamp": "00:48:24", "text": "私があなたと話している間に。"}, {"type": "subtitle", "time": 2909.03, "timestamp": "00:48:29", "text": "Peakをプレイしたいなら、"}, {"type": "subtitle", "time": 2911.436, "timestamp": "00:48:31", "text": "もっと早く言うべきだった。ほら、ただ"}, {"type": "subtitle", "time": 2913.705, "timestamp": "00:48:33", "text": "あなたがこれらすべてを成し遂げたおかげで、私たちはここにいるのです。"}, {"type": "subtitle", "time": 2915.419, "timestamp": "00:48:35", "text": "はい、それは、それは…"}, {"type": "subtitle", "time": 2919.008, "timestamp": "00:48:39", "text": "その通り。だから私はこう言うのです"}, {"type": "subtitle", "time": 2920.584, "timestamp": "00:48:40", "text": "Shift at Midnightをプレイしよう"}, {"type": "subtitle", "time": 2922.794, "timestamp": "00:48:42", "text": "いつかきっとね。ウインク、ウインク。"}, {"type": "subtitle", "time": 2924.953, "timestamp": "00:48:44", "text": "さあ、みんな。好きじゃないですか"}, {"type": "subtitle", "time": 2934.513, "timestamp": "00:48:54", "text": "ちょっとびっくりした？彼らはそれが気に入らないのだろうか？いいえ"}, {"type": "subtitle", "time": 2936.627, "timestamp": "00:48:56", "text": "パニック。でも、私は叫ぶことができない。"}]
[{"type": "subtitle", "time": 3960.05, "timestamp": "01:06:00", "text": "彼らに影響を与える。何だって？すべての女性"}, {"type": "subtitle", "time": 3961.907, "timestamp": "01:06:01", "text": "Marvel Rivalsでは、"}, {"type": "subtitle", "time": 3962.626, "timestamp": "01:06:02", "text": "落ち着け。"}, {"type": "subtitle", "time": 3965.345, "timestamp": "01:06:05", "text": "だから、それに影響されないでください。"}, {"type": "subtitle", "time": 3966.448, "timestamp": "01:06:06", "text": "みんな。わかった。"}, {"type": "subtitle", "time": 3969.609, "timestamp": "01:06:09", "text": "わかった。 犬を放さないで…なぜそこに"}, {"type": "subtitle", "time": 3971.759, "timestamp": "01:06:11", "text": "犬を放さないで…なぜそこに ジョスが二人？二？やめよう…"}, {"type": "subtitle", "time": 3977.429, "timestamp": "01:06:17", "text": "ジョスが二人？二？やめよう… はい。小さい君、大きい君。"}, {"type": "subtitle", "time": 3984.047, "timestamp": "01:06:24", "text": "おお。ああ、あった。ジャンプキング。は"}, {"type": "subtitle", "time": 3984.547, "timestamp": "01:06:24", "text": "プレイ中。"}, {"type": "subtitle", "time": 3987.621, "timestamp": "01:06:27", "text": "ええ、そうです。私は自分を苦しめながら"}, {"type": "subtitle", "time": 3994.519, "timestamp": "01:06:34", "text": "話す。見ないで。あなたは…ただ"}, {"type": "subtitle", "time": 3995.87, "timestamp": "01:06:35", "text": "「私はこうなります」はい、"}, {"type": "subtitle", "time": 3999.613, "timestamp": "01:06:39", "text": "「おじいさんは元気？」って聞くよ。"}, {"type": "subtitle", "time": 4002.314, "timestamp": "01:06:42", "text": "「私は一番下まで行って、私の"}, {"type": "subtitle", "time": 4005.42, "timestamp": "01:06:45", "text": "進捗。私はまるで狂人のように"}, {"type": "subtitle", "time": 4008.413, "timestamp": "01:06:48", "text": "私はこういう人間です。私はそれを最後までやり遂げません。"}, {"type": "subtitle", "time": 4012.992, "timestamp": "01:06:52", "text": "ジャンプキングを最後までやり遂げたい"}, {"type": "subtitle", "time": 4016.73, "timestamp": "01:06:56", "text": "いつか。ゲームをしよう"}, {"type": "subtitle", "time": 4019.077, "timestamp": "01:06:59", "text": "キャッスルヴァニアみたいな感じ、わかるだろ？"}]
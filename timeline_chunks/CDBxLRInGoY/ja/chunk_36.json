[{"type": "subtitle", "time": 2165.76, "timestamp": "00:36:05", "text": "私を驚かせて。私が知らないこと"}, {"type": "subtitle", "time": 2167.976, "timestamp": "00:36:07", "text": "それは私やあなたには起こらないだろう、全く新しいことだ。"}, {"type": "subtitle", "time": 2173.022, "timestamp": "00:36:13", "text": "何か革新的なもの。何か"}, {"type": "subtitle", "time": 2173.547, "timestamp": "00:36:13", "text": "注意。"}, {"type": "subtitle", "time": 2181.023, "timestamp": "00:36:21", "text": "でも、あなたは一体何を見たいのですか？"}, {"type": "subtitle", "time": 2182.127, "timestamp": "00:36:22", "text": "素晴らしいペアであることに加えて？"}, {"type": "subtitle", "time": 2195.161, "timestamp": "00:36:35", "text": "カメラをオフにできます。うん、"}, {"type": "subtitle", "time": 2197.739, "timestamp": "00:36:37", "text": "私は「え、マジで、それってどういうこと？」って思った。"}, {"type": "subtitle", "time": 2201.654, "timestamp": "00:36:41", "text": "感じる？まるで完全なセットアップのように、"}, {"type": "subtitle", "time": 2203.972, "timestamp": "00:36:43", "text": "彼らは車か何かを使ってそれをやるんだ、例えば..."}, {"type": "subtitle", "time": 2211.689, "timestamp": "00:36:51", "text": "ズームアウトするだけでいいんです。うん。"}, {"type": "subtitle", "time": 2216.178, "timestamp": "00:36:56", "text": "おお。編集作業で広く使われている。"}]
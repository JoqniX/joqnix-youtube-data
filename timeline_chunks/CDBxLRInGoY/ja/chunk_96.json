[{"type": "subtitle", "time": 5760.878, "timestamp": "01:36:00", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 5769.187, "timestamp": "01:36:09", "text": "遊んでいます。ほんの冗談です。あなたは"}, {"type": "subtitle", "time": 5776.55, "timestamp": "01:36:16", "text": "親友のジョー。本気ですか？"}, {"type": "subtitle", "time": 5782.145, "timestamp": "01:36:22", "text": "わかった。私は真剣です。はい。はい。はい。"}, {"type": "subtitle", "time": 5784.557, "timestamp": "01:36:24", "text": "はい。はい。自分を疑う必要はありません。"}, {"type": "subtitle", "time": 5784.934, "timestamp": "01:36:24", "text": "同じ。"}, {"type": "subtitle", "time": 5786.059, "timestamp": "01:36:26", "text": "わかった。"}, {"type": "subtitle", "time": 5792.408, "timestamp": "01:36:32", "text": "うん。"}, {"type": "subtitle", "time": 5795.382, "timestamp": "01:36:35", "text": "それがあなたが知りたかったすべてだったのですね。それ"}, {"type": "subtitle", "time": 5795.967, "timestamp": "01:36:35", "text": "それだけです。"}, {"type": "subtitle", "time": 5796.432, "timestamp": "01:36:36", "text": "いいえ。"}, {"type": "subtitle", "time": 5797.919, "timestamp": "01:36:37", "text": "意見は必要ない。"}, {"type": "subtitle", "time": 5800.157, "timestamp": "01:36:40", "text": "はい。はい。意見が欲しい。"}, {"type": "subtitle", "time": 5803.737, "timestamp": "01:36:43", "text": "いいえ、もう違います。もうない。いいえ、"}, {"type": "subtitle", "time": 5806.172, "timestamp": "01:36:46", "text": "言おうと思っていた"}, {"type": "subtitle", "time": 5814.716, "timestamp": "01:36:54", "text": "言おうと思ってたんだけど、えっと、考えてたんだ"}]
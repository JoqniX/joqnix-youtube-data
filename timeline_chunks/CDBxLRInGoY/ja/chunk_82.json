[{"type": "subtitle", "time": 4923.195, "timestamp": "01:22:03", "text": "彼らが追加したので、とても難しいでしょう"}, {"type": "subtitle", "time": 4925.715, "timestamp": "01:22:05", "text": "ゲームに新しい要素が加わりました。だからそれぞれ"}, {"type": "subtitle", "time": 4927.577, "timestamp": "01:22:07", "text": "そのキャラクターには既にチームがある"}, {"type": "subtitle", "time": 4930.055, "timestamp": "01:22:10", "text": "含まれています。そして、彼らは改善して"}, {"type": "subtitle", "time": 4932.172, "timestamp": "01:22:12", "text": "あなたのキャラクターとか、そんな感じのもの。そうです、そうです"}, {"type": "subtitle", "time": 4935.98, "timestamp": "01:22:15", "text": "複雑な話だよ、みんな。それは複雑です。へ"}, {"type": "subtitle", "time": 4947.389, "timestamp": "01:22:27", "text": "1時間も残っていないし、時間がない。おお、"}, {"type": "subtitle", "time": 4950.301, "timestamp": "01:22:30", "text": "時代を超越した。 PEをプレイしていますか？"}, {"type": "subtitle", "time": 4950.904, "timestamp": "01:22:30", "text": "バカ？"}, {"type": "subtitle", "time": 4954.569, "timestamp": "01:22:34", "text": "ええ、退屈でした。私はこう思った。"}, {"type": "subtitle", "time": 4955.948, "timestamp": "01:22:35", "text": "よし、やってみよう。"}, {"type": "subtitle", "time": 4960.435, "timestamp": "01:22:40", "text": "そしてあなたは退屈していた。おお。"}, {"type": "subtitle", "time": 4961.942, "timestamp": "01:22:41", "text": "いや、私はこう思った"}, {"type": "subtitle", "time": 4966.02, "timestamp": "01:22:46", "text": "いや、いや、いや。つまり、彼はこう言った"}, {"type": "subtitle", "time": 4970.681, "timestamp": "01:22:50", "text": "いいえ。ああ、もう一方のゲームは面倒だったよ。"}, {"type": "subtitle", "time": 4974.822, "timestamp": "01:22:54", "text": "だから私は「わかった」と思った。"}, {"type": "subtitle", "time": 4976.316, "timestamp": "01:22:56", "text": "\"私が試してみます。\""}, {"type": "subtitle", "time": 4978.226, "timestamp": "01:22:58", "text": "いいえ。"}, {"type": "subtitle", "time": 4979.049, "timestamp": "01:22:59", "text": "これをやってください。"}]
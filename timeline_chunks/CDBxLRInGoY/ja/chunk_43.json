[{"type": "subtitle", "time": 2580.734, "timestamp": "00:43:00", "text": "などなど。まるでホラーゲームみたいだ。"}, {"type": "subtitle", "time": 2581.513, "timestamp": "00:43:01", "text": "模倣者"}, {"type": "subtitle", "time": 2587.875, "timestamp": "00:43:07", "text": "深夜0時からの勤務。それは大きな"}, {"type": "subtitle", "time": 2590.322, "timestamp": "00:43:10", "text": "素晴らしい種類の、ほら、"}, {"type": "subtitle", "time": 2591.861, "timestamp": "00:43:11", "text": "ドッペルゲンガー、わかるでしょ？"}, {"type": "subtitle", "time": 2592.793, "timestamp": "00:43:12", "text": "うん。"}, {"type": "subtitle", "time": 2597.261, "timestamp": "00:43:17", "text": "プレイしてみるべきだろう。"}, {"type": "subtitle", "time": 2600.52, "timestamp": "00:43:20", "text": "はい。あなたとは遊びたくない。"}, {"type": "subtitle", "time": 2602.137, "timestamp": "00:43:22", "text": "彼らはそもそも話さないからだ。"}, {"type": "subtitle", "time": 2606.234, "timestamp": "00:43:26", "text": "うん。"}, {"type": "subtitle", "time": 2610.363, "timestamp": "00:43:30", "text": "それはまるで黙って、ただ行動するようなものです"}, {"type": "subtitle", "time": 2614.345, "timestamp": "00:43:34", "text": "例えばどんなことですか？物事について話し合う。 ？ ゲームをプレイしながら、どのように会話しますか？"}, {"type": "subtitle", "time": 2619.469, "timestamp": "00:43:39", "text": "ちょうど。なぜ話さないのですか？"}, {"type": "subtitle", "time": 2621.597, "timestamp": "00:43:41", "text": "遊んでいる間は？あなたはどれくらい集中していますか？"}, {"type": "subtitle", "time": 2621.96, "timestamp": "00:43:41", "text": "は？"}, {"type": "subtitle", "time": 2623.088, "timestamp": "00:43:43", "text": "くそ。"}, {"type": "subtitle", "time": 2625.426, "timestamp": "00:43:45", "text": "集中しすぎている。ごめんなさい。"}, {"type": "subtitle", "time": 2630.237, "timestamp": "00:43:50", "text": "はい。ゲームすらできない"}, {"type": "subtitle", "time": 2637.396, "timestamp": "00:43:57", "text": "落ち着け。私たちには方法がありません、どうすればいいのでしょうか..."}, {"type": "subtitle", "time": 2639.369, "timestamp": "00:43:59", "text": "物を登るゲームって何ですか？"}]
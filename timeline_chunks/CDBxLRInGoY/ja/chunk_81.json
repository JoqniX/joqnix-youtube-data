[{"type": "subtitle", "time": 4871.113, "timestamp": "01:21:11", "text": "悪くない。これまでにプレイしたことがありますか"}, {"type": "subtitle", "time": 4872.137, "timestamp": "01:21:12", "text": "ヒーローシューターの過去作？"}, {"type": "subtitle", "time": 4876.224, "timestamp": "01:21:16", "text": "いいえ。"}, {"type": "subtitle", "time": 4879.818, "timestamp": "01:21:19", "text": "え、本当に？えっと、エイペックス。"}, {"type": "subtitle", "time": 4885.206, "timestamp": "01:21:25", "text": "それはヒーローシューティングゲームではない。彼は英雄だ 。"}, {"type": "subtitle", "time": 4885.937, "timestamp": "01:21:25", "text": "。 戦闘の英雄。"}, {"type": "subtitle", "time": 4892.782, "timestamp": "01:21:32", "text": "つまり、あなたはこう言おうとしているのですね"}, {"type": "subtitle", "time": 4894.814, "timestamp": "01:21:34", "text": "Valorantはヒーローシューティングゲームです。あなたにあげます"}, {"type": "subtitle", "time": 4898.346, "timestamp": "01:21:38", "text": "首筋を平手打ちされた。そう言ってください。"}, {"type": "subtitle", "time": 4901.809, "timestamp": "01:21:41", "text": "そうではありません。"}, {"type": "subtitle", "time": 4907.158, "timestamp": "01:21:47", "text": "ええ、私もそう思いました。私もそう思いました。一度もない。"}, {"type": "subtitle", "time": 4909.755, "timestamp": "01:21:49", "text": "プレイしました。はい、新しいのが出ました。"}, {"type": "subtitle", "time": 4914.788, "timestamp": "01:21:54", "text": "わかりました。それは非常に困難だろう。とても"}, {"type": "subtitle", "time": 4917.867, "timestamp": "01:21:57", "text": "説明するのが難しい。非常に難しい。"}, {"type": "subtitle", "time": 4918.732, "timestamp": "01:21:58", "text": "説明する。"}]
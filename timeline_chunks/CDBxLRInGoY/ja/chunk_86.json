[{"type": "subtitle", "time": 5161.987, "timestamp": "01:26:01", "text": "あなたは話してもいいですよ。絶対に"}, {"type": "subtitle", "time": 5166.364, "timestamp": "01:26:06", "text": "私もこの会話に参加できます。に"}, {"type": "subtitle", "time": 5168.22, "timestamp": "01:26:08", "text": "どういう意味ですか？ジョックは"}, {"type": "subtitle", "time": 5168.942, "timestamp": "01:26:08", "text": "会話。"}, {"type": "subtitle", "time": 5172.451, "timestamp": "01:26:12", "text": "それは議論の一部だ。"}, {"type": "subtitle", "time": 5181.841, "timestamp": "01:26:21", "text": "はい、そうです。はい。はい。それは"}, {"type": "subtitle", "time": 5184.591, "timestamp": "01:26:24", "text": "爆弾？何？"}, {"type": "subtitle", "time": 5192.56, "timestamp": "01:26:32", "text": "まるで爆弾のようだ。そんなに遠くに住んでいるのですか？"}, {"type": "subtitle", "time": 5202.124, "timestamp": "01:26:42", "text": "下がって下がって。"}, {"type": "subtitle", "time": 5208.046, "timestamp": "01:26:48", "text": "はい、私はそう思います。ああ、そうです。"}, {"type": "subtitle", "time": 5211.177, "timestamp": "01:26:51", "text": "私は今ここにいます。あなたは戦っています"}, {"type": "subtitle", "time": 5211.788, "timestamp": "01:26:51", "text": "起きる。"}, {"type": "subtitle", "time": 5214.867, "timestamp": "01:26:54", "text": "はい、私はわざと死にます。"}]
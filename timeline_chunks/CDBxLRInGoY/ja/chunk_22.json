[{"type": "subtitle", "time": 1321.8, "timestamp": "00:22:01", "text": "マルチストリーマーはそれを送信していません"}, {"type": "subtitle", "time": 1327.109, "timestamp": "00:22:07", "text": "えー、b、えーと、ランブル。だからそれは"}, {"type": "subtitle", "time": 1333.953, "timestamp": "00:22:13", "text": "迷惑。私一人、私一人が３回か３回払った"}, {"type": "subtitle", "time": 1337.12, "timestamp": "00:22:17", "text": "これで4ドル。だから"}, {"type": "subtitle", "time": 1340.351, "timestamp": "00:22:20", "text": "3つの宛先に送信します。それで、えーと、"}, {"type": "subtitle", "time": 1342.809, "timestamp": "00:22:22", "text": "4人に送信しているんですね。それで、"}, {"type": "subtitle", "time": 1344.05, "timestamp": "00:22:24", "text": "送信されていません。"}, {"type": "subtitle", "time": 1349.196, "timestamp": "00:22:29", "text": "ええ、でもそうですね。"}, {"type": "subtitle", "time": 1351.171, "timestamp": "00:22:31", "text": "つまり、サイトを騙そうとしているということだ。"}, {"type": "subtitle", "time": 1351.432, "timestamp": "00:22:31", "text": "ウェブ。"}, {"type": "subtitle", "time": 1355.3029999999999, "timestamp": "00:22:35", "text": "はい。メルが頑張っているから、"}, {"type": "subtitle", "time": 1357.608, "timestamp": "00:22:37", "text": "マルチメルドとキャスターラボ、えーと、あの"}, {"type": "subtitle", "time": 1360.242, "timestamp": "00:22:40", "text": "私は両方のサービスを利用しています。"}, {"type": "subtitle", "time": 1365.109, "timestamp": "00:22:45", "text": "同じ人たち。ええと、キャスターラボの人たちは"}, {"type": "subtitle", "time": 1368.768, "timestamp": "00:22:48", "text": "彼はメルのためにそれを無償でやってくれた。メルは自由だ。"}, {"type": "subtitle", "time": 1373.876, "timestamp": "00:22:53", "text": "Casterは有料サービスです。ええ、そうです。"}, {"type": "subtitle", "time": 1376.356, "timestamp": "00:22:56", "text": "えっと、つまり、彼が使っているウランアプリのことです"}]
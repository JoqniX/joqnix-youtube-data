[{"type": "subtitle", "time": 2100.676, "timestamp": "00:35:00", "text": "Live 2Dより それで、何をご希望ですか？"}, {"type": "subtitle", "time": 2102.026, "timestamp": "00:35:02", "text": "それで、何をご希望ですか？ 私の意見は？"}, {"type": "subtitle", "time": 2103.044, "timestamp": "00:35:03", "text": "私の意見は？ はい。それで、何をご希望ですか？"}, {"type": "subtitle", "time": 2105.512, "timestamp": "00:35:05", "text": "はい。それで、何をご希望ですか？ 期待していることは何ですか？"}, {"type": "subtitle", "time": 2107.655, "timestamp": "00:35:07", "text": "期待していることは何ですか？ ライブ2Dバージョン"}, {"type": "subtitle", "time": 2116.777, "timestamp": "00:35:16", "text": "巨乳？大きな胸は"}, {"type": "subtitle", "time": 2120.495, "timestamp": "00:35:20", "text": "何か見どころがあるはずだ。持っている"}, {"type": "subtitle", "time": 2122.199, "timestamp": "00:35:22", "text": "私の考えは正しいでしょうか、それとも間違っているでしょうか？"}, {"type": "subtitle", "time": 2127.684, "timestamp": "00:35:27", "text": "素晴らしい動き、良い体格。知る"}, {"type": "subtitle", "time": 2128.554, "timestamp": "00:35:28", "text": "どういう意味かって？"}, {"type": "subtitle", "time": 2131.776, "timestamp": "00:35:31", "text": "彼が何を言っているのか、私たちは皆分かっている。 ？ 私の言っていること、分かりますか？"}, {"type": "subtitle", "time": 2137.659, "timestamp": "00:35:37", "text": "彼らの人となりはご存知でしょう。ほら、２つ"}, {"type": "subtitle", "time": 2146.516, "timestamp": "00:35:46", "text": "素晴らしい個性を持った人々。来て。ああ、神様"}, {"type": "subtitle", "time": 2151.151, "timestamp": "00:35:51", "text": "私の。でも、そうですね、見てみたいですね。"}, {"type": "subtitle", "time": 2154.321, "timestamp": "00:35:54", "text": "うーん、クールなスイッチって感じかな。"}, {"type": "subtitle", "time": 2156.824, "timestamp": "00:35:56", "text": "きっと私を驚かせるようなことが起こるだろうね。"}]
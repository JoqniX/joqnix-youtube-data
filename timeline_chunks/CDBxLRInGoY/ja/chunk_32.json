[{"type": "subtitle", "time": 1924.152, "timestamp": "00:32:04", "text": "ああ、乾杯。それはイエスからのものでした。"}, {"type": "subtitle", "time": 1927.75, "timestamp": "00:32:07", "text": "あれは君のルームメイトだったんだ。それ"}, {"type": "subtitle", "time": 1932.199, "timestamp": "00:32:12", "text": "そうだった、あなただと思った。ただ「お大事に」と言えばいい。"}, {"type": "subtitle", "time": 1932.889, "timestamp": "00:32:12", "text": "私としては。"}, {"type": "subtitle", "time": 1934.398, "timestamp": "00:32:14", "text": "はい。はい。"}, {"type": "subtitle", "time": 1938.593, "timestamp": "00:32:18", "text": "そして"}, {"type": "subtitle", "time": 1943.613, "timestamp": "00:32:23", "text": "感じない、わからない、私には合わない。"}, {"type": "subtitle", "time": 1946.004, "timestamp": "00:32:26", "text": "私の誕生日から20年が経ち、"}, {"type": "subtitle", "time": 1949.102, "timestamp": "00:32:29", "text": "学期。考えない"}, {"type": "subtitle", "time": 1951.805, "timestamp": "00:32:31", "text": "だって、自分がめちゃくちゃだって分かってるんだから"}, {"type": "subtitle", "time": 1952.106, "timestamp": "00:32:32", "text": "古い"}, {"type": "subtitle", "time": 1954.959, "timestamp": "00:32:34", "text": "そして見る"}, {"type": "subtitle", "time": 1960.52, "timestamp": "00:32:40", "text": "おい、つまり俺は星座だ"}, {"type": "subtitle", "time": 1963.442, "timestamp": "00:32:43", "text": "私はもう年寄り、本当に年寄りだけど、"}, {"type": "subtitle", "time": 1965.688, "timestamp": "00:32:45", "text": "うん"}, {"type": "subtitle", "time": 1968.91, "timestamp": "00:32:48", "text": "そう、あの忌々しい老人ホーム、それだ"}, {"type": "subtitle", "time": 1969.284, "timestamp": "00:32:49", "text": "全て"}, {"type": "subtitle", "time": 1974.849, "timestamp": "00:32:54", "text": "ああ、神様、あなたが終わらせるなんてありえない"}, {"type": "subtitle", "time": 1978.753, "timestamp": "00:32:58", "text": "「えっと、どういう意味ですか？」と言う代わりには"}]
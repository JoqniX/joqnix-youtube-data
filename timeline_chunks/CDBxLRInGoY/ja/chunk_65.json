[{"type": "subtitle", "time": 3904.265, "timestamp": "01:05:04", "text": "来て。できない、できない、できない"}, {"type": "subtitle", "time": 3907.341, "timestamp": "01:05:07", "text": "友達のために努力しよう。来て 。"}, {"type": "subtitle", "time": 3909.293, "timestamp": "01:05:09", "text": "来て。"}, {"type": "subtitle", "time": 3912.684, "timestamp": "01:05:12", "text": "マーベルライバルズをプレイできます"}, {"type": "subtitle", "time": 3913.159, "timestamp": "01:05:13", "text": "彼らはそれを望んでいる。"}, {"type": "subtitle", "time": 3924.438, "timestamp": "01:05:24", "text": "待って、インストール済みなの？それとも未インストールなの？自分？"}, {"type": "subtitle", "time": 3926.572, "timestamp": "01:05:26", "text": "インストールしていません。遊べるよ"}, {"type": "subtitle", "time": 3929.77, "timestamp": "01:05:29", "text": "また別の日に。ほら、ウインク。"}, {"type": "subtitle", "time": 3931.293, "timestamp": "01:05:31", "text": "それで大丈夫です。"}, {"type": "subtitle", "time": 3936.568, "timestamp": "01:05:36", "text": "はい。その間、私はいつでも"}, {"type": "subtitle", "time": 3938.663, "timestamp": "01:05:38", "text": "ゲームに参加してすべてを発見しよう"}, {"type": "subtitle", "time": 3940.593, "timestamp": "01:05:40", "text": "彼らにとってより簡単になるように"}, {"type": "subtitle", "time": 3940.98, "timestamp": "01:05:40", "text": "遊ぶ。"}, {"type": "subtitle", "time": 3943.169, "timestamp": "01:05:43", "text": "うん。"}, {"type": "subtitle", "time": 3949.769, "timestamp": "01:05:49", "text": "でも、みんな、彼らがマーベルをプレイするとき"}, {"type": "subtitle", "time": 3952.156, "timestamp": "01:05:52", "text": "ライバル諸君、女に惑わされるな"}, {"type": "subtitle", "time": 3955.119, "timestamp": "01:05:55", "text": "彼らを困らせてください、いいですか？させないで"}]
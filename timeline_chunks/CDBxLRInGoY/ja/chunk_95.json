[{"type": "subtitle", "time": 5700.868, "timestamp": "01:35:00", "text": "いくつか質問があります。その多くが"}, {"type": "subtitle", "time": 5702.724, "timestamp": "01:35:02", "text": "いくらで話すか、いくらで"}, {"type": "subtitle", "time": 5705.353, "timestamp": "01:35:05", "text": "どれくらいの時間が経過しましたか？ 1時間くらいで"}, {"type": "subtitle", "time": 5706.802, "timestamp": "01:35:06", "text": "平均？なんてことだ。"}, {"type": "subtitle", "time": 5710.641, "timestamp": "01:35:10", "text": "今、いい考えが浮かんだ。"}, {"type": "subtitle", "time": 5715.331, "timestamp": "01:35:15", "text": "ふと思いついたんです。まるで もう十分だ。"}, {"type": "subtitle", "time": 5728.582, "timestamp": "01:35:28", "text": "質問させてください。えっと、？ 私のことをどう思いますか？私たちは友達です"}, {"type": "subtitle", "time": 5732.144, "timestamp": "01:35:32", "text": "私のことをどう思いますか？私たちは友達です 長い間。"}, {"type": "subtitle", "time": 5738.452, "timestamp": "01:35:38", "text": "悪い判断だった。"}, {"type": "subtitle", "time": 5740.351, "timestamp": "01:35:40", "text": "はい。何？"}, {"type": "subtitle", "time": 5747.727, "timestamp": "01:35:47", "text": "いや、冗談だよ。それは冗談です。もちろんそうだ"}, {"type": "subtitle", "time": 5751.027, "timestamp": "01:35:51", "text": "ジョーク。でも、もし彼があなたの友達だったら"}, {"type": "subtitle", "time": 5754.57, "timestamp": "01:35:54", "text": "君は悪い友達だよ。それ"}, {"type": "subtitle", "time": 5755.579, "timestamp": "01:35:55", "text": "それもまた事実だ。"}, {"type": "subtitle", "time": 5758.903, "timestamp": "01:35:58", "text": "もしかしたら、今あなたに嘘をついているのかもしれません。"}, {"type": "subtitle", "time": 5759.975, "timestamp": "01:35:59", "text": "同じ。知るか？"}]
[{"type": "subtitle", "time": 1200.076, "timestamp": "00:20:00", "text": "のみ"}, {"type": "subtitle", "time": 1203.425, "timestamp": "00:20:03", "text": "はい。これはストリーマーの生活ですか、それとも"}, {"type": "subtitle", "time": 1204.078, "timestamp": "00:20:04", "text": "どのような"}, {"type": "subtitle", "time": 1209.473, "timestamp": "00:20:09", "text": "はい。とても良い。あらゆるものがそれに反対している。"}, {"type": "subtitle", "time": 1211.007, "timestamp": "00:20:11", "text": "流れ。か否か？"}, {"type": "subtitle", "time": 1221.32, "timestamp": "00:20:21", "text": "はい。ああ、これは面倒くさい。それで"}, {"type": "subtitle", "time": 1221.861, "timestamp": "00:20:21", "text": "昨日"}, {"type": "subtitle", "time": 1230.455, "timestamp": "00:20:30", "text": "インターネットは、ある意味で私に"}, {"type": "subtitle", "time": 1232.91, "timestamp": "00:20:32", "text": "いつものことと私自身に問題があります"}, {"type": "subtitle", "time": 1242.924, "timestamp": "00:20:42", "text": "「これって私のインターネット？」って感じだった。しかし"}, {"type": "subtitle", "time": 1245.297, "timestamp": "00:20:45", "text": "はい、今日も、昨日も、ご存知のとおり"}, {"type": "subtitle", "time": 1252.105, "timestamp": "00:20:52", "text": "私はランブルをやりました。そしてそれは効果があった。ランブル"}]
[{"type": "subtitle", "time": 6301.368, "timestamp": "01:45:01", "text": "本日お越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 6315.389, "timestamp": "01:45:15", "text": "ブラッドとジャム、そうだね。はい。彼らはまだ使っている"}, {"type": "subtitle", "time": 6316.491, "timestamp": "01:45:16", "text": "目の前の標識"}, {"type": "subtitle", "time": 6324.238, "timestamp": "01:45:24", "text": "私は尊敬します。私のチームは尊敬に値する。"}, {"type": "subtitle", "time": 6329.335, "timestamp": "01:45:29", "text": "私はあなたに別の視点を提供しているのです。"}, {"type": "subtitle", "time": 6336.787, "timestamp": "01:45:36", "text": "はい、今日はありがとうございました。"}, {"type": "subtitle", "time": 6340.425, "timestamp": "01:45:40", "text": "今夜、私と一緒に来てください。楽しい時間を過ごしました"}, {"type": "subtitle", "time": 6347.747, "timestamp": "01:45:47", "text": "今夜。ご招待いただきありがとうございます。うん、"}, {"type": "subtitle", "time": 6350.878, "timestamp": "01:45:50", "text": "グループにご参加いただきありがとうございます。私は"}, {"type": "subtitle", "time": 6355.279, "timestamp": "01:45:55", "text": "今日は何をしようかと考えている。そして私は考えた"}, {"type": "subtitle", "time": 6356.928, "timestamp": "01:45:56", "text": "彼らに電話して、計画を続けましょう"}]
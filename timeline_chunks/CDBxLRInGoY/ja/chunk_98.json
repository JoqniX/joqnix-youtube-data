[{"type": "subtitle", "time": 5882.072, "timestamp": "01:38:02", "text": "ロクが恋しい。"}, {"type": "subtitle", "time": 5884.343, "timestamp": "01:38:04", "text": "顧客レビュー。これはまるで"}, {"type": "subtitle", "time": 5886.983, "timestamp": "01:38:06", "text": "顧客レビュー。どう思いましたか？"}, {"type": "subtitle", "time": 5892.451, "timestamp": "01:38:12", "text": "このプロジェクト？つまり、それは"}, {"type": "subtitle", "time": 5895.092, "timestamp": "01:38:15", "text": "それはあなたにとって頭痛の種でしたか？幾つか？"}, {"type": "subtitle", "time": 5897.182, "timestamp": "01:38:17", "text": "彼にはどんな質問があったのか？何回"}, {"type": "subtitle", "time": 5901.159, "timestamp": "01:38:21", "text": "彼女はあなたのメッセージの中で泣いていましたか？それをください"}, {"type": "subtitle", "time": 5901.733, "timestamp": "01:38:21", "text": "レビュー。"}, {"type": "subtitle", "time": 5903.995, "timestamp": "01:38:23", "text": "うん。"}, {"type": "subtitle", "time": 5909.629, "timestamp": "01:38:29", "text": "あなたは良い友達です。心配しないでください"}, {"type": "subtitle", "time": 5915.158, "timestamp": "01:38:35", "text": "それ。それを聞いて嬉しいです。素晴らしい。"}, {"type": "subtitle", "time": 5920.147, "timestamp": "01:38:40", "text": "日本に来た時のことを今でも覚えています。"}, {"type": "subtitle", "time": 5920.796, "timestamp": "01:38:40", "text": "私は話しました"}, {"type": "subtitle", "time": 5925.137, "timestamp": "01:38:45", "text": "はい、今年です。"}, {"type": "subtitle", "time": 5931.626, "timestamp": "01:38:51", "text": "私はすぐに彼に物語を語り、"}]
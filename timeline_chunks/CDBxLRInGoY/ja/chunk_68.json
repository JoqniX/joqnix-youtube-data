[{"type": "subtitle", "time": 4083.471, "timestamp": "01:08:03", "text": "Macのように。"}, {"type": "subtitle", "time": 4088.456, "timestamp": "01:08:08", "text": "ロックマン。あのね？ロックマン。"}, {"type": "subtitle", "time": 4091.688, "timestamp": "01:08:11", "text": "はい。はい。"}, {"type": "subtitle", "time": 4103.165, "timestamp": "01:08:23", "text": "このような。さらに言うまでもなく、"}, {"type": "subtitle", "time": 4104.495, "timestamp": "01:08:24", "text": "このゲームには続編が出る予定です。"}, {"type": "subtitle", "time": 4108.767, "timestamp": "01:08:28", "text": "ああ、重力を見てごらん。"}, {"type": "subtitle", "time": 4112.893, "timestamp": "01:08:32", "text": "はい、グラビティサーキットもです。"}, {"type": "subtitle", "time": 4116.08, "timestamp": "01:08:36", "text": "おお、それはなかなか良いですね。"}, {"type": "subtitle", "time": 4125.274, "timestamp": "01:08:45", "text": "あの男が"}, {"type": "subtitle", "time": 4125.793, "timestamp": "01:08:45", "text": "プレイしてください。"}, {"type": "subtitle", "time": 4129.435, "timestamp": "01:08:49", "text": "彼がそうしてくれるといいな。"}, {"type": "subtitle", "time": 4134.27, "timestamp": "01:08:54", "text": "はい。彼はまたプレーするだろうから、どうなるか見てみよう。"}, {"type": "subtitle", "time": 4136.338, "timestamp": "01:08:56", "text": "「ねえ、これを演奏してみて」と言うでしょう。"}]
[{"type": "subtitle", "time": 2943.265, "timestamp": "00:49:03", "text": "心の中で泣いてもいいんだよ。以上です。"}, {"type": "subtitle", "time": 2944.603, "timestamp": "00:49:04", "text": "それはいいですね。"}, {"type": "subtitle", "time": 2949.666, "timestamp": "00:49:09", "text": "いつでも泣いていいんだよ。"}, {"type": "subtitle", "time": 2956.409, "timestamp": "00:49:16", "text": "何てことだ。私の言っていることは正しいですか、アル？"}, {"type": "subtitle", "time": 2959.67, "timestamp": "00:49:19", "text": "つまり、あなたの言う通りです。そして彼はただ泣くだけだった。"}, {"type": "subtitle", "time": 2962.374, "timestamp": "00:49:22", "text": "彼は続けて、両方とも言い続けている"}, {"type": "subtitle", "time": 2962.884, "timestamp": "00:49:22", "text": "名前。"}, {"type": "subtitle", "time": 2964.132, "timestamp": "00:49:24", "text": "うん、"}, {"type": "subtitle", "time": 2966.222, "timestamp": "00:49:26", "text": "私は両方の名前を言い続けています。持っている"}, {"type": "subtitle", "time": 2967.348, "timestamp": "00:49:27", "text": "何か問題でも？"}, {"type": "subtitle", "time": 2973.109, "timestamp": "00:49:33", "text": "どちらを使えばいいのか、いつも忘れてしまう。"}, {"type": "subtitle", "time": 2977.22, "timestamp": "00:49:37", "text": "1つだけ残しておけばいい。いいえ、私ではありません"}, {"type": "subtitle", "time": 2977.883, "timestamp": "00:49:37", "text": "それは重要です。"}, {"type": "subtitle", "time": 2980.133, "timestamp": "00:49:40", "text": "ああ、つまりあなたは彼らのことを全く気にしていないということですか？"}, {"type": "subtitle", "time": 2981.808, "timestamp": "00:49:41", "text": "いいえ、私はあなたをそう呼ぶことにします。"}, {"type": "subtitle", "time": 2983.432, "timestamp": "00:49:43", "text": "わかった。"}, {"type": "subtitle", "time": 2984.686, "timestamp": "00:49:44", "text": "プロフェッショナルな印象を受ける。"}, {"type": "subtitle", "time": 2988.127, "timestamp": "00:49:48", "text": "彼らはあなたのチャンネルに登録することができます。多分"}, {"type": "subtitle", "time": 2989.457, "timestamp": "00:49:49", "text": "平。知るか？"}, {"type": "subtitle", "time": 2998.556, "timestamp": "00:49:58", "text": "わかった。機器を接続しないのですか？"}, {"type": "subtitle", "time": 2999.14, "timestamp": "00:49:59", "text": "ほら、これか？"}]
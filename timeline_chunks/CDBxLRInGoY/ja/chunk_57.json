[{"type": "subtitle", "time": 3424.108, "timestamp": "00:57:04", "text": "ああ、そうだね。はい、その通りです。何について"}, {"type": "subtitle", "time": 3424.985, "timestamp": "00:57:04", "text": "私たちは話していましたか？"}, {"type": "subtitle", "time": 3428.396, "timestamp": "00:57:08", "text": "生き残る。どんなゲームができるだろうか"}, {"type": "subtitle", "time": 3428.68, "timestamp": "00:57:08", "text": "遊ぶ"}, {"type": "subtitle", "time": 3431.819, "timestamp": "00:57:11", "text": "将来一緒にいる？誰も言わなかった"}, {"type": "subtitle", "time": 3432.658, "timestamp": "00:57:12", "text": "生存。"}, {"type": "subtitle", "time": 3435.076, "timestamp": "00:57:15", "text": "なるほど。なるほど。"}, {"type": "subtitle", "time": 3436.041, "timestamp": "00:57:16", "text": "こんにちは。"}, {"type": "subtitle", "time": 3443.67, "timestamp": "00:57:23", "text": "彼に感謝してください。きっとあなたはそう思わないでしょう。"}, {"type": "subtitle", "time": 3445.207, "timestamp": "00:57:25", "text": "声が聞こえたので"}, {"type": "subtitle", "time": 3447.128, "timestamp": "00:57:27", "text": "再びエネルギーが必要になり、"}, {"type": "subtitle", "time": 3447.657, "timestamp": "00:57:27", "text": "電話。"}, {"type": "subtitle", "time": 3451.564, "timestamp": "00:57:31", "text": "心配しないで。"}, {"type": "subtitle", "time": 3458.082, "timestamp": "00:57:38", "text": "はい。マーベル・ライバルズ。何が起こったのか"}, {"type": "subtitle", "time": 3460.388, "timestamp": "00:57:40", "text": "それ？あなたはマーベルライバルズのプロですか？"}, {"type": "subtitle", "time": 3462.919, "timestamp": "00:57:42", "text": "真実？"}, {"type": "subtitle", "time": 3464.649, "timestamp": "00:57:44", "text": "うん。"}, {"type": "subtitle", "time": 3468.303, "timestamp": "00:57:48", "text": "私は…私はマーベルとの鎖を断ち切った"}, {"type": "subtitle", "time": 3473.218, "timestamp": "00:57:53", "text": "ライバル。私はもうNetEaseの奴隷ではない 。それ？"}, {"type": "subtitle", "time": 3476.187, "timestamp": "00:57:56", "text": "。それ？ もうない。"}, {"type": "subtitle", "time": 3477.933, "timestamp": "00:57:57", "text": "もうない。 いいえ、もしよろしければ一緒にプレイできますよ。できる"}]
[{"type": "subtitle", "time": 4981.589, "timestamp": "01:23:01", "text": "見ていて本当に疲れたと言った"}, {"type": "subtitle", "time": 4982.179, "timestamp": "01:23:02", "text": "あのゲーム。"}, {"type": "subtitle", "time": 4985.305, "timestamp": "01:23:05", "text": "あなたはそう言ったね。"}, {"type": "subtitle", "time": 4994.719, "timestamp": "01:23:14", "text": "楽しいよ。知っていましたか？そのままにしておいて"}, {"type": "subtitle", "time": 4996.922, "timestamp": "01:23:16", "text": "合格。ピコをプレイすると思うのは"}, {"type": "subtitle", "time": 4999.074, "timestamp": "01:23:19", "text": "マスターライバルズをプレイするのは素晴らしいと思います"}, {"type": "subtitle", "time": 5001.592, "timestamp": "01:23:21", "text": "頭痛。なぜなら？"}, {"type": "subtitle", "time": 5002.409, "timestamp": "01:23:22", "text": "うん。"}, {"type": "subtitle", "time": 5006.143, "timestamp": "01:23:26", "text": "はい、なぜならそれはあまりにも多くのものを含んでいるからです"}, {"type": "subtitle", "time": 5008.789, "timestamp": "01:23:28", "text": "通過。言うまでもなく、"}, {"type": "subtitle", "time": 5011.444, "timestamp": "01:23:31", "text": "あの忌々しい奴は脅威だ。そして、"}, {"type": "subtitle", "time": 5013.379, "timestamp": "01:23:33", "text": "みんなが投げるだろうと述べる"}, {"type": "subtitle", "time": 5014.395, "timestamp": "01:23:34", "text": "チャットでの侮辱。"}, {"type": "subtitle", "time": 5019.22, "timestamp": "01:23:39", "text": "ああ、それもね。"}, {"type": "subtitle", "time": 5025.743, "timestamp": "01:23:45", "text": "はい。有害な人たちだよ。理由を知っていますか？"}, {"type": "subtitle", "time": 5027.28, "timestamp": "01:23:47", "text": "なぜ私は去ったのか？私が去ったのは"}, {"type": "subtitle", "time": 5028.26, "timestamp": "01:23:48", "text": "毒性が強すぎる。"}, {"type": "subtitle", "time": 5035.128, "timestamp": "01:23:55", "text": "多分。マルチプレイヤーゲーム"}, {"type": "subtitle", "time": 5035.761, "timestamp": "01:23:55", "text": "いつもの、"}, {"type": "subtitle", "time": 5039.602, "timestamp": "01:23:59", "text": "あなたはもう知っているでしょう。私はあまりストレスを感じないですよね？ あなたが知っている？私は人生でストレスを感じたりはしません。"}]
[{"type": "subtitle", "time": 1140.394, "timestamp": "00:19:00", "text": "ええ、私は後退していると言ったんです。"}, {"type": "subtitle", "time": 1144.515, "timestamp": "00:19:04", "text": "ええ、行ったり来たりしています。"}, {"type": "subtitle", "time": 1149.589, "timestamp": "00:19:09", "text": "いいえ、ただ後退していただけです。そうじゃない"}, {"type": "subtitle", "time": 1151.714, "timestamp": "00:19:11", "text": "前方へ、後方のみ 。"}, {"type": "subtitle", "time": 1157.969, "timestamp": "00:19:17", "text": "後退することによってのみ。もし私たちが"}, {"type": "subtitle", "time": 1158.957, "timestamp": "00:19:18", "text": "一度移動する。"}, {"type": "subtitle", "time": 1163.01, "timestamp": "00:19:23", "text": "はい、あんなものを見たのは初めてでした。"}, {"type": "subtitle", "time": 1165.788, "timestamp": "00:19:25", "text": "私の人生すべて。方程式は一つもない"}, {"type": "subtitle", "time": 1167.373, "timestamp": "00:19:27", "text": "数学がそれを解決する。"}, {"type": "subtitle", "time": 1171.045, "timestamp": "00:19:31", "text": "はい、私は"}, {"type": "subtitle", "time": 1175.76, "timestamp": "00:19:35", "text": "時計の秒数。何が見えるか"}, {"type": "subtitle", "time": 1178.097, "timestamp": "00:19:38", "text": "遅延とか色々あって、すごく遅れてるよ。"}, {"type": "subtitle", "time": 1183.392, "timestamp": "00:19:43", "text": "それ。この遅延は重大なものだと思う。"}, {"type": "subtitle", "time": 1185.316, "timestamp": "00:19:45", "text": "なぜなら、自分のアイコンが表示されたからです。"}, {"type": "subtitle", "time": 1190.081, "timestamp": "00:19:50", "text": "はい、少し"}, {"type": "subtitle", "time": 1191.369, "timestamp": "00:19:51", "text": "うん。"}, {"type": "subtitle", "time": 1195.284, "timestamp": "00:19:55", "text": "はい、そういうことが起こると少しイライラしますね。"}, {"type": "subtitle", "time": 1199.28, "timestamp": "00:19:59", "text": "それで。ええ、まさにその通りです。"}]
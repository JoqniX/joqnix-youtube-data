[{"type": "subtitle", "time": 3304.58, "timestamp": "00:55:04", "text": "分かりますよ。ゲーム。ねえ、これ試したことある？"}, {"type": "subtitle", "time": 3309.561, "timestamp": "00:55:09", "text": "ゲームの名前は…？"}, {"type": "subtitle", "time": 3310.05, "timestamp": "00:55:10", "text": "外出禁止？"}, {"type": "subtitle", "time": 3314.105, "timestamp": "00:55:14", "text": "理解した。"}, {"type": "subtitle", "time": 3315.194, "timestamp": "00:55:15", "text": "うん。"}, {"type": "subtitle", "time": 3319.359, "timestamp": "00:55:19", "text": "全く分からない。あの別のゲームの名前は…？"}, {"type": "subtitle", "time": 3324.134, "timestamp": "00:55:24", "text": "あ、待って。ああ、RuneScapeには"}, {"type": "subtitle", "time": 3326.433, "timestamp": "00:55:26", "text": "新作ゲーム、ドラゴンワイルズ。何が"}, {"type": "subtitle", "time": 3332.26, "timestamp": "00:55:32", "text": "これ？はい。はい、私たちはまだプレイしていません。"}, {"type": "subtitle", "time": 3336.224, "timestamp": "00:55:36", "text": "MMORPG。いいえ。開いています。なぜなら"}, {"type": "subtitle", "time": 3338.925, "timestamp": "00:55:38", "text": "私たちはもっとRPGをプレイする必要があるのだろうか？あなたが知っている"}, {"type": "subtitle", "time": 3340.13, "timestamp": "00:55:40", "text": "どれくらい時間がかかりますか？"}, {"type": "subtitle", "time": 3342.984, "timestamp": "00:55:42", "text": "はい、この世界でのサバイバルとクラフトです"}, {"type": "subtitle", "time": 3345.914, "timestamp": "00:55:45", "text": "開ける。真実。"}, {"type": "subtitle", "time": 3348.654, "timestamp": "00:55:48", "text": "よし、フリッピングワールドをプレイしよう 。それはオープンワールドサバイバルだ。"}, {"type": "subtitle", "time": 3350.834, "timestamp": "00:55:50", "text": "。それはオープンワールドサバイバルだ。 、 いいえ？"}, {"type": "subtitle", "time": 3351.769, "timestamp": "00:55:51", "text": "、 いいえ？ はい、そうです。私たちはサンズ・オブ・ザ・"}, {"type": "subtitle", "time": 3356.468, "timestamp": "00:55:56", "text": "はい、そうです。私たちはサンズ・オブ・ザ・ 森よ、いつか君が望むなら。による"}]
[{"type": "subtitle", "time": 3541.348, "timestamp": "00:59:01", "text": "中毒症状ですよね？もしあなたが止まったら"}, {"type": "subtitle", "time": 3543.447, "timestamp": "00:59:03", "text": "お酒を飲んで、また飲む、"}, {"type": "subtitle", "time": 3544.201, "timestamp": "00:59:04", "text": "あなたはもっと欲しい。"}, {"type": "subtitle", "time": 3547.618, "timestamp": "00:59:07", "text": "そして、それがこのゲームが私に与える影響なのです。"}, {"type": "subtitle", "time": 3550.345, "timestamp": "00:59:10", "text": "私たちは最高のゲームを見つけました"}, {"type": "subtitle", "time": 3551.047, "timestamp": "00:59:11", "text": "一緒に遊ぼう。"}, {"type": "subtitle", "time": 3553.141, "timestamp": "00:59:13", "text": "３人とも。"}, {"type": "subtitle", "time": 3553.952, "timestamp": "00:59:13", "text": "言わないで"}, {"type": "subtitle", "time": 3556.093, "timestamp": "00:59:16", "text": "バードゲーム3。"}, {"type": "subtitle", "time": 3559.065, "timestamp": "00:59:19", "text": "鳥のゲーム3"}, {"type": "subtitle", "time": 3562.236, "timestamp": "00:59:22", "text": "まるでお互いをつつき合っているような感じで"}, {"type": "subtitle", "time": 3568.024, "timestamp": "00:59:28", "text": "私たちは互いに連絡を絶った。あなたは"}, {"type": "subtitle", "time": 3568.512, "timestamp": "00:59:28", "text": "鳥。"}, {"type": "subtitle", "time": 3574.718, "timestamp": "00:59:34", "text": "相手に「カカカカ」と言いましょう。"}, {"type": "subtitle", "time": 3576.702, "timestamp": "00:59:36", "text": "はい。はい。はい。はい。"}, {"type": "subtitle", "time": 3580.426, "timestamp": "00:59:40", "text": "レビューを確認させてください。"}, {"type": "subtitle", "time": 3584.301, "timestamp": "00:59:44", "text": "ボットか何かを追加する必要がある"}, {"type": "subtitle", "time": 3586.027, "timestamp": "00:59:46", "text": "プレイヤーが増えるまで"}, {"type": "subtitle", "time": 3586.434, "timestamp": "00:59:46", "text": "本物。"}, {"type": "subtitle", "time": 3590.269, "timestamp": "00:59:50", "text": "彼"}, {"type": "subtitle", "time": 3596.808, "timestamp": "00:59:56", "text": "それはまるで「ねえ、知ってる？」私は思う"}, {"type": "subtitle", "time": 3598.822, "timestamp": "00:59:58", "text": "たぶん、マウライフルで遊ぶことになるんだろうな。"}]
[{"type": "subtitle", "time": 3721.271, "timestamp": "01:02:01", "text": "それが発売された。場所と日時"}, {"type": "subtitle", "time": 3722.208, "timestamp": "01:02:02", "text": "このゲームはいつ発売されましたか？"}, {"type": "subtitle", "time": 3730.559, "timestamp": "01:02:10", "text": "私はこのゲームをプレイするべきではないと感じている 。それは206年前に開始された。"}, {"type": "subtitle", "time": 3752.711, "timestamp": "01:02:32", "text": "くそ。どういう意味ですか"}, {"type": "subtitle", "time": 3755.113, "timestamp": "01:02:35", "text": "何もない？あなたはブリットに何か言っていましたね。"}, {"type": "subtitle", "time": 3759.096, "timestamp": "01:02:39", "text": "はい、あなたは私に意見を述べていました"}, {"type": "subtitle", "time": 3761.882, "timestamp": "01:02:41", "text": "私はあなたに頼んでいません。もちろん、それでも"}, {"type": "subtitle", "time": 3762.48, "timestamp": "01:02:42", "text": "聞いています。"}, {"type": "subtitle", "time": 3771.669, "timestamp": "01:02:51", "text": "人影はない。私は何て言ったの？私"}, {"type": "subtitle", "time": 3778.009, "timestamp": "01:02:58", "text": "ニンジンを食べなければならない、"}, {"type": "subtitle", "time": 3779.69, "timestamp": "01:02:59", "text": "男。何か食べないと。"}]
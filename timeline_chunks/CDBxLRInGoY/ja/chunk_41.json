[{"type": "subtitle", "time": 2462.565, "timestamp": "00:41:02", "text": "ラベンダーって青色ですよね？そうなんですか？"}, {"type": "subtitle", "time": 2466.372, "timestamp": "00:41:06", "text": "はい。確認してみます。"}, {"type": "subtitle", "time": 2470.828, "timestamp": "00:41:10", "text": "青色です。"}, {"type": "subtitle", "time": 2472.909, "timestamp": "00:41:12", "text": "はい、青色です…"}, {"type": "subtitle", "time": 2476.01, "timestamp": "00:41:16", "text": "はい、それは…それはまるで…"}, {"type": "subtitle", "time": 2481.511, "timestamp": "00:41:21", "text": "色の一種だと思う。それは…それは色です。"}, {"type": "subtitle", "time": 2489.188, "timestamp": "00:41:29", "text": "はい。はい。少し待ってください。色"}, {"type": "subtitle", "time": 2493.627, "timestamp": "00:41:33", "text": "それは外の独自の王国に存在し、"}, {"type": "subtitle", "time": 2497.24, "timestamp": "00:41:37", "text": "私は推測する。ああ、そうですね。それは家族の伝統です"}, {"type": "subtitle", "time": 2501.962, "timestamp": "00:41:41", "text": "紫色のやつからだと思う。ああ、そうですね。"}, {"type": "subtitle", "time": 2513.522, "timestamp": "00:41:53", "text": "紫。えっと、あの時のこと覚えてる？"}, {"type": "subtitle", "time": 2515.061, "timestamp": "00:41:55", "text": "私たちはよく旅行ごっこをして遊んでいました…"}]
[{"type": "subtitle", "time": 6002.485, "timestamp": "01:40:02", "text": "何てことだ。なんてこった。なぜなら"}, {"type": "subtitle", "time": 6004.362, "timestamp": "01:40:04", "text": "あなたはそれに賛成ですか？来て。"}, {"type": "subtitle", "time": 6005.395, "timestamp": "01:40:05", "text": "そうでなければならない。"}, {"type": "subtitle", "time": 6019.996, "timestamp": "01:40:19", "text": "はい、そうです。何か食べに行きなさい。"}, {"type": "subtitle", "time": 6026.547, "timestamp": "01:40:26", "text": "はい、何か食べ物をつかもうとしていました。"}, {"type": "subtitle", "time": 6028.651, "timestamp": "01:40:28", "text": "そして私は、自分には何も持っていないことに気づいた。"}, {"type": "subtitle", "time": 6031.668, "timestamp": "01:40:31", "text": "私には水しかありません。それで私は水を飲んだ"}, {"type": "subtitle", "time": 6032.332, "timestamp": "01:40:32", "text": "そして私はここに来た。"}, {"type": "subtitle", "time": 6036.791, "timestamp": "01:40:36", "text": "私たちは二人とも同じ状況に置かれている。"}, {"type": "subtitle", "time": 6037.984, "timestamp": "01:40:37", "text": "はい、そうです。"}, {"type": "subtitle", "time": 6041.995, "timestamp": "01:40:41", "text": "いや、そこには食べ物があるんだよ。絶対にダメ"}, {"type": "subtitle", "time": 6045.826, "timestamp": "01:40:45", "text": "あれを食べたいんです、分かりますよね？"}, {"type": "subtitle", "time": 6046.916, "timestamp": "01:40:46", "text": "つまり。知る？"}, {"type": "subtitle", "time": 6051.827, "timestamp": "01:40:51", "text": "ああ、神様。はい。いつあなたが"}, {"type": "subtitle", "time": 6053.429, "timestamp": "01:40:53", "text": "同じものが多すぎると、もう欲しくなくなる"}, {"type": "subtitle", "time": 6054.254, "timestamp": "01:40:54", "text": "もう一度食べる？"}]
[{"type": "subtitle", "time": 5949.892, "timestamp": "01:39:09", "text": "私は全てを見せた。 Rokuはどこにありますか？"}, {"type": "subtitle", "time": 5952.15, "timestamp": "01:39:12", "text": "男？ Rokuに何が起こったのですか？"}, {"type": "subtitle", "time": 5955.53, "timestamp": "01:39:15", "text": "おお。あの男のことは口にしないで。いいえ"}, {"type": "subtitle", "time": 5957.448, "timestamp": "01:39:17", "text": "そのような言及。それはまるで"}, {"type": "subtitle", "time": 5959.995, "timestamp": "01:39:19", "text": "葬儀屋。彼は来るだろう。言及なし"}, {"type": "subtitle", "time": 5960.58, "timestamp": "01:39:20", "text": "あの男。"}, {"type": "subtitle", "time": 5963.786, "timestamp": "01:39:23", "text": "彼はいずれ来るだろう。"}, {"type": "subtitle", "time": 5966.293, "timestamp": "01:39:26", "text": "はい。はい。誰もあの男を好きじゃない。に"}, {"type": "subtitle", "time": 5969.152, "timestamp": "01:39:29", "text": "誰もあの男を好きじゃない。彼は何をしたのですか？"}, {"type": "subtitle", "time": 5972.974, "timestamp": "01:39:32", "text": "彼は何をしたのですか？それは存在した。"}, {"type": "subtitle", "time": 5975.723, "timestamp": "01:39:35", "text": "ああ、残念。"}, {"type": "subtitle", "time": 5981.022, "timestamp": "01:39:41", "text": "いやいや、私たちは皆Rokuが大好きです。はい、友よ 。"}, {"type": "subtitle", "time": 5984.385, "timestamp": "01:39:44", "text": "素晴らしい友人。"}, {"type": "subtitle", "time": 5988.903, "timestamp": "01:39:48", "text": "はい。素晴らしい友人。とてもゲイ、とても"}, {"type": "subtitle", "time": 5992.994, "timestamp": "01:39:52", "text": "同性愛者、非常に同性愛者。いいえ。"}]
[{"type": "subtitle", "time": 1080.426, "timestamp": "00:18:00", "text": "私たちにはMakeがあります。パンとここに"}, {"type": "subtitle", "time": 1083.967, "timestamp": "00:18:03", "text": "私たち。あなたは話してもいいですよ。"}, {"type": "subtitle", "time": 1090.627, "timestamp": "00:18:10", "text": "話し合えますよ。今なら話せる。 ! わーい！"}, {"type": "subtitle", "time": 1096.379, "timestamp": "00:18:16", "text": "ついに地下室から出られた。はい、承知いたしました。"}, {"type": "subtitle", "time": 1103.348, "timestamp": "00:18:23", "text": "はい。元気ですか？どうやって"}, {"type": "subtitle", "time": 1108.186, "timestamp": "00:18:28", "text": "私たちは？良い質問ですね。どんな感じですか？"}, {"type": "subtitle", "time": 1112.479, "timestamp": "00:18:32", "text": "人生とは何か？"}, {"type": "subtitle", "time": 1118.055, "timestamp": "00:18:38", "text": "人生？人生は予測不可能だ。どこ"}, {"type": "subtitle", "time": 1118.485, "timestamp": "00:18:38", "text": "私の"}, {"type": "subtitle", "time": 1121.038, "timestamp": "00:18:41", "text": "わかった。ストリームが実行中です。わかった。"}, {"type": "subtitle", "time": 1123.568, "timestamp": "00:18:43", "text": "怖くなった。私はストリームが"}, {"type": "subtitle", "time": 1124.925, "timestamp": "00:18:44", "text": "ストリームが実行中です。"}, {"type": "subtitle", "time": 1128.083, "timestamp": "00:18:48", "text": "はい、あなたは最初から正しかった"}, {"type": "subtitle", "time": 1131.131, "timestamp": "00:18:51", "text": "ストリーム。あなたは「in」のポイントは"}, {"type": "subtitle", "time": 1134.211, "timestamp": "00:18:54", "text": "私は生きている。それは上がったり下がったりする。私にも起こっている。"}, {"type": "subtitle", "time": 1134.541, "timestamp": "00:18:54", "text": "自分。"}]
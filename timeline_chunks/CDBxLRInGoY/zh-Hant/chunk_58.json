[{"type": "subtitle", "time": 3480.479, "timestamp": "00:58:00", "text": "不，如果你想玩的話，我們可以玩。能 播放它。我的意思是，我不是說我們不能，"}, {"type": "subtitle", "time": 3483.882, "timestamp": "00:58:03", "text": "播放它。我的意思是，我不是說我們不能， 我只是想說，我已經不是以前的我了。"}, {"type": "subtitle", "time": 3486.262, "timestamp": "00:58:06", "text": "我只是想說，我已經不是以前的我了。 前。我不是。我知道如果我上場，"}, {"type": "subtitle", "time": 3493.123, "timestamp": "00:58:13", "text": "前。我不是。我知道如果我上場， 我認識的一些人仍然"}, {"type": "subtitle", "time": 3495.388, "timestamp": "00:58:15", "text": "我認識的一些人仍然 他們玩那個遊戲，他們會邀請我一起玩。"}, {"type": "subtitle", "time": 3497.714, "timestamp": "00:58:17", "text": "他們玩那個遊戲，他們會邀請我一起玩。 資格賽結束後，我還會回來的。"}, {"type": "subtitle", "time": 3500.039, "timestamp": "00:58:20", "text": "資格賽結束後，我還會回來的。 你知道，這就是起點。"}, {"type": "subtitle", "time": 3505.882, "timestamp": "00:58:25", "text": "啊，是的。"}, {"type": "subtitle", "time": 3506.53, "timestamp": "00:58:26", "text": "我知道。"}, {"type": "subtitle", "time": 3514.254, "timestamp": "00:58:34", "text": "不過如果你想玩的話，我們可以一起玩。"}, {"type": "subtitle", "time": 3516.093, "timestamp": "00:58:36", "text": "你想玩M機器人遊戲嗎？"}, {"type": "subtitle", "time": 3522.592, "timestamp": "00:58:42", "text": "或許。我的意思是，如果你願意的話，我一定會參加。"}, {"type": "subtitle", "time": 3525.339, "timestamp": "00:58:45", "text": "你以前會玩，但現在你說不玩了，"}, {"type": "subtitle", "time": 3525.889, "timestamp": "00:58:45", "text": "我不知道。"}, {"type": "subtitle", "time": 3528.405, "timestamp": "00:58:48", "text": "等等，我有個主意。你在幹什麼？"}, {"type": "subtitle", "time": 3530.211, "timestamp": "00:58:50", "text": "你的意思是，我拒絕了嗎？不，不。"}, {"type": "subtitle", "time": 3532.761, "timestamp": "00:58:52", "text": "我說我還是玩不了。"}, {"type": "subtitle", "time": 3536.264, "timestamp": "00:58:56", "text": "但我知道，如果我這麼做，就等於擁有了"}]
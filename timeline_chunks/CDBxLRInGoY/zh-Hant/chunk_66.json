[{"type": "subtitle", "time": 3960.05, "timestamp": "01:06:00", "text": "影響他們。那是什麼？每個女人"}, {"type": "subtitle", "time": 3961.907, "timestamp": "01:06:01", "text": "在 Marvel Rivals 中，請繼續"}, {"type": "subtitle", "time": 3962.626, "timestamp": "01:06:02", "text": "冷靜下來。"}, {"type": "subtitle", "time": 3965.345, "timestamp": "01:06:05", "text": "所以別讓它影響你。"}, {"type": "subtitle", "time": 3966.448, "timestamp": "01:06:06", "text": "夥計們。好的。"}, {"type": "subtitle", "time": 3969.609, "timestamp": "01:06:09", "text": "好的。 別讓狗狗…為什麼會有這些"}, {"type": "subtitle", "time": 3971.759, "timestamp": "01:06:11", "text": "別讓狗狗…為什麼會有這些 兩個喬？二？我們還是別這麼做了…"}, {"type": "subtitle", "time": 3977.429, "timestamp": "01:06:17", "text": "兩個喬？二？我們還是別這麼做了… 是的。你個子小，你卻很大。"}, {"type": "subtitle", "time": 3984.047, "timestamp": "01:06:24", "text": "哦。哦，找到了。跳躍之王。是"}, {"type": "subtitle", "time": 3984.547, "timestamp": "01:06:24", "text": "正在播放。"}, {"type": "subtitle", "time": 3987.621, "timestamp": "01:06:27", "text": "嗯，是的。我正在折磨自己"}, {"type": "subtitle", "time": 3994.519, "timestamp": "01:06:34", "text": "說話。別看它。你要去……就是這樣。"}, {"type": "subtitle", "time": 3995.87, "timestamp": "01:06:35", "text": "「我會像這樣，」是的，"}, {"type": "subtitle", "time": 3999.613, "timestamp": "01:06:39", "text": "我會問：“老頭子怎麼樣了？”"}, {"type": "subtitle", "time": 4002.314, "timestamp": "01:06:42", "text": "「我會一路下去，重新開始我的…」"}, {"type": "subtitle", "time": 4005.42, "timestamp": "01:06:45", "text": "進步。我當時就像個瘋子一樣"}, {"type": "subtitle", "time": 4008.413, "timestamp": "01:06:48", "text": "我就是這樣。我不會完成它。"}, {"type": "subtitle", "time": 4012.992, "timestamp": "01:06:52", "text": "我希望我能通關《跳躍之王》。"}, {"type": "subtitle", "time": 4016.73, "timestamp": "01:06:56", "text": "總有一天。我們應該玩遊戲"}, {"type": "subtitle", "time": 4019.077, "timestamp": "01:06:59", "text": "就像《惡魔城》之類的遊戲，你知道的。"}]
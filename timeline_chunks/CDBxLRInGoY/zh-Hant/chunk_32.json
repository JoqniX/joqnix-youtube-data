[{"type": "subtitle", "time": 1924.152, "timestamp": "00:32:04", "text": "哦，謝謝。那是來自《是的，"}, {"type": "subtitle", "time": 1927.75, "timestamp": "00:32:07", "text": "那是你的室友。那"}, {"type": "subtitle", "time": 1932.199, "timestamp": "00:32:12", "text": "沒錯，我還以為是你。就說聲「保佑你」。"}, {"type": "subtitle", "time": 1932.889, "timestamp": "00:32:12", "text": "就我而言。"}, {"type": "subtitle", "time": 1934.398, "timestamp": "00:32:14", "text": "是的。是的。"}, {"type": "subtitle", "time": 1938.593, "timestamp": "00:32:18", "text": "和"}, {"type": "subtitle", "time": 1943.613, "timestamp": "00:32:23", "text": "我感覺不到，我不知道，這不適合我。"}, {"type": "subtitle", "time": 1946.004, "timestamp": "00:32:26", "text": "我的生日已經過去二十年了，而且已經"}, {"type": "subtitle", "time": 1949.102, "timestamp": "00:32:29", "text": "學期。永遠不要想"}, {"type": "subtitle", "time": 1951.805, "timestamp": "00:32:31", "text": "因為你知道你完蛋了"}, {"type": "subtitle", "time": 1952.106, "timestamp": "00:32:32", "text": "老的"}, {"type": "subtitle", "time": 1954.959, "timestamp": "00:32:34", "text": "並看到"}, {"type": "subtitle", "time": 1960.52, "timestamp": "00:32:40", "text": "老兄，我的意思是，我就是一顆星座。"}, {"type": "subtitle", "time": 1963.442, "timestamp": "00:32:43", "text": "我年紀大了，真的很老了，但是"}, {"type": "subtitle", "time": 1965.688, "timestamp": "00:32:45", "text": "是的"}, {"type": "subtitle", "time": 1968.91, "timestamp": "00:32:48", "text": "對，該死的養老院，就是這樣。"}, {"type": "subtitle", "time": 1969.284, "timestamp": "00:32:49", "text": "全部"}, {"type": "subtitle", "time": 1974.849, "timestamp": "00:32:54", "text": "我的天哪，這不可能是結局吧"}, {"type": "subtitle", "time": 1978.753, "timestamp": "00:32:58", "text": "而不是說「呃，你是什麼意思？」是"}]
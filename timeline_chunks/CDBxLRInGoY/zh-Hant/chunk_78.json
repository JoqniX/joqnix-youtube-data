[{"type": "subtitle", "time": 4684.224, "timestamp": "01:18:04", "text": "他們推出了一個新角色。那"}, {"type": "subtitle", "time": 4685.181, "timestamp": "01:18:05", "text": "他們推出過這個角色嗎？"}, {"type": "subtitle", "time": 4690.056, "timestamp": "01:18:10", "text": "我想，他們引入了兩個新角色。"}, {"type": "subtitle", "time": 4694.349, "timestamp": "01:18:14", "text": "本賽季。他們是 Jubilee 和，呃，The"}, {"type": "subtitle", "time": 4701.39, "timestamp": "01:18:21", "text": "兜帽。而朱比利就像一位戰略家，"}, {"type": "subtitle", "time": 4704.121, "timestamp": "01:18:24", "text": "你知道，就是損害。而《街區》就像"}, {"type": "subtitle", "time": 4707.113, "timestamp": "01:18:27", "text": "一輛坦克，上面裝著格洛克手槍之類的東西，你知道的。"}, {"type": "subtitle", "time": 4714.089, "timestamp": "01:18:34", "text": "兩把手槍。我們會玩什麼遊戲？"}, {"type": "subtitle", "time": 4716.741, "timestamp": "01:18:36", "text": "我們的角色會是什麼？夥計們，"}, {"type": "subtitle", "time": 4721.609, "timestamp": "01:18:41", "text": "他們將扮演治療者的角色。是的，他們已經知道了。"}, {"type": "subtitle", "time": 4724.075, "timestamp": "01:18:44", "text": "誰來扮演治療師，誰會…"}, {"type": "subtitle", "time": 4730.273, "timestamp": "01:18:50", "text": "坦克和輸出位。哦是的。有"}, {"type": "subtitle", "time": 4732.192, "timestamp": "01:18:52", "text": "一些類似的新角色"}, {"type": "subtitle", "time": 4732.291, "timestamp": "01:18:52", "text": "到"}]
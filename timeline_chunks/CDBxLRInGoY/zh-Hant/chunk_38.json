[{"type": "subtitle", "time": 2283.206, "timestamp": "00:38:03", "text": "那太好了。哪個音訊？是的，"}, {"type": "subtitle", "time": 2285.731, "timestamp": "00:38:05", "text": "對音頻做出反應，並，呃，改變"}, {"type": "subtitle", "time": 2294.629, "timestamp": "00:38:14", "text": "鏡頭將跟隨我們前進。所以"}, {"type": "subtitle", "time": 2297.714, "timestamp": "00:38:17", "text": "是的，非常好。就好像它有"}, {"type": "subtitle", "time": 2303.354, "timestamp": "00:38:23", "text": "它具有多種功能和效果。"}, {"type": "subtitle", "time": 2305.445, "timestamp": "00:38:25", "text": "站不穩，甚至還有眼睛問題"}, {"type": "subtitle", "time": 2309.793, "timestamp": "00:38:29", "text": "魚。你還記得這件事嗎？什麼"}, {"type": "subtitle", "time": 2311.648, "timestamp": "00:38:31", "text": "那到底是什麼東西？你不知道我"}, {"type": "subtitle", "time": 2318.351, "timestamp": "00:38:38", "text": "我以前用過那個魚形裝置。這到底是怎麼回事"}, {"type": "subtitle", "time": 2324.561, "timestamp": "00:38:44", "text": "這是嗎？這到底是什麼鬼東西？"}, {"type": "subtitle", "time": 2329.413, "timestamp": "00:38:49", "text": "想像一下如果我張開嘴的話，"}, {"type": "subtitle", "time": 2330.777, "timestamp": "00:38:50", "text": "我可以說，「哇，"}, {"type": "subtitle", "time": 2339.268, "timestamp": "00:38:59", "text": "哇。哇，哇。 」 但沒錯，她確實有一些"}]
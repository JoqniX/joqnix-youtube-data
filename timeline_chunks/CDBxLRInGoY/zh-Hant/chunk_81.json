[{"type": "subtitle", "time": 4871.113, "timestamp": "01:21:11", "text": "不錯。你玩過嗎？"}, {"type": "subtitle", "time": 4872.137, "timestamp": "01:21:12", "text": "以前玩過英雄射擊遊戲嗎？"}, {"type": "subtitle", "time": 4876.224, "timestamp": "01:21:16", "text": "不。"}, {"type": "subtitle", "time": 4879.818, "timestamp": "01:21:19", "text": "真的嗎？呃，Apex。"}, {"type": "subtitle", "time": 4885.206, "timestamp": "01:21:25", "text": "那不是英雄射擊遊戲。他是個英雄 。"}, {"type": "subtitle", "time": 4885.937, "timestamp": "01:21:25", "text": "。 戰鬥英雄。"}, {"type": "subtitle", "time": 4892.782, "timestamp": "01:21:32", "text": "所以，你的意思是…"}, {"type": "subtitle", "time": 4894.814, "timestamp": "01:21:34", "text": "《Valorant》是一款英雄射擊遊戲。我會給你"}, {"type": "subtitle", "time": 4898.346, "timestamp": "01:21:38", "text": "打脖子一巴掌。說出來。"}, {"type": "subtitle", "time": 4901.809, "timestamp": "01:21:41", "text": "並非如此。"}, {"type": "subtitle", "time": 4907.158, "timestamp": "01:21:47", "text": "是的，我也是這麼想的。我也是這麼想的。絕不。"}, {"type": "subtitle", "time": 4909.755, "timestamp": "01:21:49", "text": "我玩過。好的，又出現了一個新的。"}, {"type": "subtitle", "time": 4914.788, "timestamp": "01:21:54", "text": "好的。這將非常困難。非常"}, {"type": "subtitle", "time": 4917.867, "timestamp": "01:21:57", "text": "難以解釋。非常困難。"}, {"type": "subtitle", "time": 4918.732, "timestamp": "01:21:58", "text": "解釋。"}]
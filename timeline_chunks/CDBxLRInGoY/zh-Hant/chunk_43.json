[{"type": "subtitle", "time": 2580.734, "timestamp": "00:43:00", "text": "等等。這就像一款恐怖遊戲。"}, {"type": "subtitle", "time": 2581.513, "timestamp": "00:43:01", "text": "模仿者"}, {"type": "subtitle", "time": 2587.875, "timestamp": "00:43:07", "text": "午夜班。它就像一個大"}, {"type": "subtitle", "time": 2590.322, "timestamp": "00:43:10", "text": "你知道，就像那種很棒的類型"}, {"type": "subtitle", "time": 2591.861, "timestamp": "00:43:11", "text": "你知道，就是分身。"}, {"type": "subtitle", "time": 2592.793, "timestamp": "00:43:12", "text": "是的。"}, {"type": "subtitle", "time": 2597.261, "timestamp": "00:43:17", "text": "我們或許應該玩玩。"}, {"type": "subtitle", "time": 2600.52, "timestamp": "00:43:20", "text": "是的。我不想跟你玩。"}, {"type": "subtitle", "time": 2602.137, "timestamp": "00:43:22", "text": "因為他們根本不會說話。"}, {"type": "subtitle", "time": 2606.234, "timestamp": "00:43:26", "text": "是的。"}, {"type": "subtitle", "time": 2610.363, "timestamp": "00:43:30", "text": "就像保持沉默，只是做事一樣。"}, {"type": "subtitle", "time": 2614.345, "timestamp": "00:43:34", "text": "比如什麼？談論事情。 ？ 玩遊戲的時候怎麼說話？"}, {"type": "subtitle", "time": 2619.469, "timestamp": "00:43:39", "text": "精確的。為什麼不說話？"}, {"type": "subtitle", "time": 2621.597, "timestamp": "00:43:41", "text": "你玩的時候？你的專注力如何？"}, {"type": "subtitle", "time": 2621.96, "timestamp": "00:43:41", "text": "是？"}, {"type": "subtitle", "time": 2623.088, "timestamp": "00:43:43", "text": "該死。"}, {"type": "subtitle", "time": 2625.426, "timestamp": "00:43:45", "text": "我太專注了。對不起。"}, {"type": "subtitle", "time": 2630.237, "timestamp": "00:43:50", "text": "是的。我們甚至不能玩遊戲。"}, {"type": "subtitle", "time": 2637.396, "timestamp": "00:43:57", "text": "冷靜下來。我們沒有辦法，該怎麼做…"}, {"type": "subtitle", "time": 2639.369, "timestamp": "00:43:59", "text": "那款關於攀爬的遊戲叫什麼名字？"}]
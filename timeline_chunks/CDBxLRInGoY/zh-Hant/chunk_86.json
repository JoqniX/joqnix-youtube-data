[{"type": "subtitle", "time": 5161.987, "timestamp": "01:26:01", "text": "你可以發言。確實"}, {"type": "subtitle", "time": 5166.364, "timestamp": "01:26:06", "text": "我可以加入這場對話。到"}, {"type": "subtitle", "time": 5168.22, "timestamp": "01:26:08", "text": "你是什​​麼意思？喬克不在球隊裡"}, {"type": "subtitle", "time": 5168.942, "timestamp": "01:26:08", "text": "對話。"}, {"type": "subtitle", "time": 5172.451, "timestamp": "01:26:12", "text": "這是對話的一部分。"}, {"type": "subtitle", "time": 5181.841, "timestamp": "01:26:21", "text": "它在「是」裡。是的。是的。那是…"}, {"type": "subtitle", "time": 5184.591, "timestamp": "01:26:24", "text": "炸彈？什麼？"}, {"type": "subtitle", "time": 5192.56, "timestamp": "01:26:32", "text": "它看起來像顆炸彈。你離得那麼遠嗎？"}, {"type": "subtitle", "time": 5202.124, "timestamp": "01:26:42", "text": "返回返回。"}, {"type": "subtitle", "time": 5208.046, "timestamp": "01:26:48", "text": "是的，我想我是。哦，是的。"}, {"type": "subtitle", "time": 5211.177, "timestamp": "01:26:51", "text": "我現在在這裡。你正在為此奮鬥"}, {"type": "subtitle", "time": 5211.788, "timestamp": "01:26:51", "text": "起床。"}, {"type": "subtitle", "time": 5214.867, "timestamp": "01:26:54", "text": "是的，我是故意去死的。"}]
[{"type": "subtitle", "time": 3660.89, "timestamp": "01:01:00", "text": "哦，對了，元神剛剛發布了納特蘭"}, {"type": "subtitle", "time": 3662.751, "timestamp": "01:01:02", "text": "今天。那？"}, {"type": "subtitle", "time": 3671.807, "timestamp": "01:01:11", "text": "是的，正是如此。感覺今天就像…"}, {"type": "subtitle", "time": 3673.12, "timestamp": "01:01:13", "text": "更新至7.0。"}, {"type": "subtitle", "time": 3679.437, "timestamp": "01:01:19", "text": "7.0。哦，它有七個版本。該死的"}, {"type": "subtitle", "time": 3680.346, "timestamp": "01:01:20", "text": "也就是說，以後再說。"}, {"type": "subtitle", "time": 3681.672, "timestamp": "01:01:21", "text": "是的，"}, {"type": "subtitle", "time": 3685.615, "timestamp": "01:01:25", "text": "你正在實現這個目標。"}, {"type": "subtitle", "time": 3693.779, "timestamp": "01:01:33", "text": "是的，我們到了。作為？該死 。這位旅行者一直在從…出發"}, {"type": "subtitle", "time": 3696.042, "timestamp": "01:01:36", "text": "。這位旅行者一直在從…出發 逐個地點，但不是到那個地方。"}, {"type": "subtitle", "time": 3698.372, "timestamp": "01:01:38", "text": "逐個地點，但不是到那個地方。 不，不，不。"}, {"type": "subtitle", "time": 3708.856, "timestamp": "01:01:48", "text": "或許是研究工作。嗯，我想是的。"}, {"type": "subtitle", "time": 3709.886, "timestamp": "01:01:49", "text": "七年。"}, {"type": "subtitle", "time": 3713.129, "timestamp": "01:01:53", "text": "是的。"}, {"type": "subtitle", "time": 3715.717, "timestamp": "01:01:55", "text": "我希望他們能做些什麼。"}, {"type": "subtitle", "time": 3716.664, "timestamp": "01:01:56", "text": "就像這十年一樣"}]
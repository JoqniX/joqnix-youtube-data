[{"type": "subtitle", "time": 2521.498, "timestamp": "00:42:01", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 2525.124, "timestamp": "00:42:05", "text": "呃，為什麼不加入我們呢？"}, {"type": "subtitle", "time": 2526.135, "timestamp": "00:42:06", "text": "平行線，布拉德？"}, {"type": "subtitle", "time": 2530.368, "timestamp": "00:42:10", "text": "好的。好的。哇。哇。什麼樣的"}, {"type": "subtitle", "time": 2535.346, "timestamp": "00:42:15", "text": "這是敲詐勒索的手段嗎？什麼？茶"}, {"type": "subtitle", "time": 2537.232, "timestamp": "00:42:17", "text": "你還記得那些舊時光嗎？"}, {"type": "subtitle", "time": 2540.693, "timestamp": "00:42:20", "text": "我們以前玩過那個遊戲。經過"}, {"type": "subtitle", "time": 2543.597, "timestamp": "00:42:23", "text": "為什麼他們不加入我們，一起探討“為什麼？”"}, {"type": "subtitle", "time": 2546.509, "timestamp": "00:42:26", "text": "因為我能。"}, {"type": "subtitle", "time": 2550.175, "timestamp": "00:42:30", "text": "拜託，夥計們。因為你可以。"}, {"type": "subtitle", "time": 2558.257, "timestamp": "00:42:38", "text": "哦，閉嘴。閉上你的“你知道嗎？” 我們該玩什麼遊戲？大概"}, {"type": "subtitle", "time": 2560.453, "timestamp": "00:42:40", "text": "我們該玩什麼遊戲？大概 例如午夜輪班之類的，因為"}, {"type": "subtitle", "time": 2562.51, "timestamp": "00:42:42", "text": "例如午夜輪班之類的，因為 他們會尿褲子的。"}, {"type": "subtitle", "time": 2570.359, "timestamp": "00:42:50", "text": "就是這樣，對吧？只有一個"}, {"type": "subtitle", "time": 2571.645, "timestamp": "00:42:51", "text": "你在射擊變形怪嗎？"}, {"type": "chat", "time": 2574.803, "timestamp": "00:42:54", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "You can still post your birthday wishes for me here - https://onxa.link/JoqniXBDay2026"}, {"type": "subtitle", "time": 2576.067, "timestamp": "00:42:56", "text": "你射殺了變形怪，你就…"}, {"type": "subtitle", "time": 2578.322, "timestamp": "00:42:58", "text": "家庭作業，你知道，就是做家事。"}]
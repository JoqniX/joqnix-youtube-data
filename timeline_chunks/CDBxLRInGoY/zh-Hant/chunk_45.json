[{"type": "subtitle", "time": 2700.029, "timestamp": "00:45:00", "text": "8月11日更新。"}, {"type": "subtitle", "time": 2701.65, "timestamp": "00:45:01", "text": "所以，就像昨天一樣。"}, {"type": "subtitle", "time": 2714.624, "timestamp": "00:45:14", "text": "終點，最後的攀登。不，我是在告訴你"}, {"type": "subtitle", "time": 2731.749, "timestamp": "00:45:31", "text": "他們可能會有DLC或其他一些東西。"}, {"type": "subtitle", "time": 2733.662, "timestamp": "00:45:33", "text": "重要的修正，但是"}, {"type": "subtitle", "time": 2739.316, "timestamp": "00:45:39", "text": "真的，因為這是最後一個了"}, {"type": "subtitle", "time": 2741.186, "timestamp": "00:45:41", "text": "重大更新，我們想到了"}, {"type": "subtitle", "time": 2743.394, "timestamp": "00:45:43", "text": "回答一些我確信會得到解答的問題"}, {"type": "subtitle", "time": 2746.025, "timestamp": "00:45:46", "text": "將會顯現。如果您還有任何疑問，或者"}, {"type": "subtitle", "time": 2747.866, "timestamp": "00:45:47", "text": "遊戲出現問題，請問如何解決？"}, {"type": "subtitle", "time": 2750.119, "timestamp": "00:45:50", "text": "請聯絡我們諮詢相關事宜。哪個"}, {"type": "subtitle", "time": 2751.682, "timestamp": "00:45:51", "text": "最新的重大更新是什麼？"}, {"type": "subtitle", "time": 2753.874, "timestamp": "00:45:53", "text": "呃，正如我們從一開始就說的那樣 Peak 不是一款服務型遊戲"}, {"type": "subtitle", "time": 2755.859, "timestamp": "00:45:55", "text": "Peak 不是一款服務型遊戲 活。我們計劃推出"}, {"type": "subtitle", "time": 2757.729, "timestamp": "00:45:57", "text": "活。我們計劃推出 一場在…結束的遊戲"}, {"type": "subtitle", "time": 2759.559, "timestamp": "00:45:59", "text": "一場在…結束的遊戲 發布和任何更新"}]
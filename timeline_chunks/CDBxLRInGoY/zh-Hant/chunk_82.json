[{"type": "subtitle", "time": 4923.195, "timestamp": "01:22:03", "text": "這將非常困難，因為他們增加了"}, {"type": "subtitle", "time": 4925.715, "timestamp": "01:22:05", "text": "遊戲新增內容。所以每個"}, {"type": "subtitle", "time": 4927.577, "timestamp": "01:22:07", "text": "這個角色已經擁有一支團隊。"}, {"type": "subtitle", "time": 4930.055, "timestamp": "01:22:10", "text": "已包含在內。然後，他們改進了"}, {"type": "subtitle", "time": 4932.172, "timestamp": "01:22:12", "text": "你的角色或類似的東西。是，是"}, {"type": "subtitle", "time": 4935.98, "timestamp": "01:22:15", "text": "事情很複雜，各位。情況很複雜。至"}, {"type": "subtitle", "time": 4947.389, "timestamp": "01:22:27", "text": "不到一個小時了，我沒時間了。哦，"}, {"type": "subtitle", "time": 4950.301, "timestamp": "01:22:30", "text": "永恆的。你在上體育課嗎？"}, {"type": "subtitle", "time": 4950.904, "timestamp": "01:22:30", "text": "白痴？"}, {"type": "subtitle", "time": 4954.569, "timestamp": "01:22:34", "text": "是的，我當時很無聊。我當時就想，"}, {"type": "subtitle", "time": 4955.948, "timestamp": "01:22:35", "text": "好的，我們試試看。"}, {"type": "subtitle", "time": 4960.435, "timestamp": "01:22:40", "text": "你當時感到無聊。哦。"}, {"type": "subtitle", "time": 4961.942, "timestamp": "01:22:41", "text": "不，我當時就像"}, {"type": "subtitle", "time": 4966.02, "timestamp": "01:22:46", "text": "不，不，不。我的意思是，他說過"}, {"type": "subtitle", "time": 4970.681, "timestamp": "01:22:50", "text": "不。呃，另一款遊戲真是太難玩了。"}, {"type": "subtitle", "time": 4974.822, "timestamp": "01:22:54", "text": "於是我想，“好吧。”"}, {"type": "subtitle", "time": 4976.316, "timestamp": "01:22:56", "text": "“我會盡力。”"}, {"type": "subtitle", "time": 4978.226, "timestamp": "01:22:58", "text": "不。"}, {"type": "subtitle", "time": 4979.049, "timestamp": "01:22:59", "text": "這樣做。"}]
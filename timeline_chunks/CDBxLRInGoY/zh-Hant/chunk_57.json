[{"type": "subtitle", "time": 3424.108, "timestamp": "00:57:04", "text": "哦是的。是的，沒錯，沒錯。關於什麼"}, {"type": "subtitle", "time": 3424.985, "timestamp": "00:57:04", "text": "我們剛才在聊天嗎？"}, {"type": "subtitle", "time": 3428.396, "timestamp": "00:57:08", "text": "生存。我們可以玩哪些遊戲？"}, {"type": "subtitle", "time": 3428.68, "timestamp": "00:57:08", "text": "玩"}, {"type": "subtitle", "time": 3431.819, "timestamp": "00:57:11", "text": "未來一起嗎？沒人說"}, {"type": "subtitle", "time": 3432.658, "timestamp": "00:57:12", "text": "生存。"}, {"type": "subtitle", "time": 3435.076, "timestamp": "00:57:15", "text": "我懂了。我懂了。"}, {"type": "subtitle", "time": 3436.041, "timestamp": "00:57:16", "text": "你好。"}, {"type": "subtitle", "time": 3443.67, "timestamp": "00:57:23", "text": "謝謝你。我敢肯定你不知道。"}, {"type": "subtitle", "time": 3445.207, "timestamp": "00:57:25", "text": "我聽到了，因為我的聲音傳了出去。"}, {"type": "subtitle", "time": 3447.128, "timestamp": "00:57:27", "text": "能量又回來了，我不得不切換到"}, {"type": "subtitle", "time": 3447.657, "timestamp": "00:57:27", "text": "電話。"}, {"type": "subtitle", "time": 3451.564, "timestamp": "00:57:31", "text": "不用擔心。"}, {"type": "subtitle", "time": 3458.082, "timestamp": "00:57:38", "text": "是的。漫威勁敵。發生了什麼事？"}, {"type": "subtitle", "time": 3460.388, "timestamp": "00:57:40", "text": "那？你是漫威宿敵（Marvel Rivals）的職業玩家嗎？"}, {"type": "subtitle", "time": 3462.919, "timestamp": "00:57:42", "text": "真的？"}, {"type": "subtitle", "time": 3464.649, "timestamp": "00:57:44", "text": "是的。"}, {"type": "subtitle", "time": 3468.303, "timestamp": "00:57:48", "text": "我……我已經掙脫了漫威的束縛。"}, {"type": "subtitle", "time": 3473.218, "timestamp": "00:57:53", "text": "競爭對手。我不再是網易的奴隸 。那？"}, {"type": "subtitle", "time": 3476.187, "timestamp": "00:57:56", "text": "。那？ 不再。"}, {"type": "subtitle", "time": 3477.933, "timestamp": "00:57:57", "text": "不再。 不，如果你想玩的話，我們可以玩。能"}]
[{"type": "subtitle", "time": 1804.08, "timestamp": "00:30:04", "text": "是的。哦，你現在可以說了嗎？"}, {"type": "subtitle", "time": 1809.047, "timestamp": "00:30:09", "text": "正確的。"}, {"type": "subtitle", "time": 1811.892, "timestamp": "00:30:11", "text": "我的天啊。不，別告訴我。"}, {"type": "subtitle", "time": 1814.22, "timestamp": "00:30:14", "text": "我不記得了。好了，就是這樣。"}, {"type": "subtitle", "time": 1816.41, "timestamp": "00:30:16", "text": "非常接近。你知道以前發生過什麼事嗎？"}, {"type": "subtitle", "time": 1818.724, "timestamp": "00:30:18", "text": "在那個時代，你會怎麼說？你已經"}, {"type": "subtitle", "time": 1821.164, "timestamp": "00:30:21", "text": "毒"}, {"type": "subtitle", "time": 1825.442, "timestamp": "00:30:25", "text": "中毒的嚴重程度會是什麼？"}, {"type": "subtitle", "time": 1826.272, "timestamp": "00:30:26", "text": "請說一句話？"}, {"type": "subtitle", "time": 1834.669, "timestamp": "00:30:34", "text": "我的上帝。我當時就想，什麼？"}, {"type": "subtitle", "time": 1837.763, "timestamp": "00:30:37", "text": "天哪，他是不是中風了？ 那到底是什麼東西？什麼？"}, {"type": "subtitle", "time": 1844.8029999999999, "timestamp": "00:30:44", "text": "美好的舊時光。非常好。"}, {"type": "subtitle", "time": 1848.455, "timestamp": "00:30:48", "text": "美好的舊時光。那已經是好久以前的事了。"}, {"type": "subtitle", "time": 1849.102, "timestamp": "00:30:49", "text": "兩年。"}, {"type": "subtitle", "time": 1852.901, "timestamp": "00:30:52", "text": "是的，那已經是舊聞了。你當時就像是，"}, {"type": "subtitle", "time": 1854.414, "timestamp": "00:30:54", "text": "你當時真是對我厭煩透了。"}, {"type": "subtitle", "time": 1859.493, "timestamp": "00:30:59", "text": "我真是受夠你了。當然。經過"}]
[{"type": "subtitle", "time": 5104.844, "timestamp": "01:25:04", "text": "是的。哦，那也是事實。"}, {"type": "subtitle", "time": 5109.055, "timestamp": "01:25:09", "text": "是的，大宗師。"}, {"type": "subtitle", "time": 5112.802, "timestamp": "01:25:12", "text": "再看看我。我幾乎說不出話來。"}, {"type": "subtitle", "time": 5116.75, "timestamp": "01:25:16", "text": "嗯，關鍵在於學會放手。"}, {"type": "subtitle", "time": 5119.273, "timestamp": "01:25:19", "text": "放手吧。"}, {"type": "subtitle", "time": 5122.13, "timestamp": "01:25:22", "text": "徹底放下吧。別這麼想。"}, {"type": "subtitle", "time": 5123.835, "timestamp": "01:25:23", "text": "你必須徹底放手。僅有的"}, {"type": "subtitle", "time": 5126.452, "timestamp": "01:25:26", "text": "稍微鬆開一點。只是感覺"}, {"type": "subtitle", "time": 5129.79, "timestamp": "01:25:29", "text": "舒服的。這就是我對約伯在事物中的看法。"}, {"type": "subtitle", "time": 5133.324, "timestamp": "01:25:33", "text": "所以。你知道嗎，他到現在還沒放手？"}, {"type": "subtitle", "time": 5136.632, "timestamp": "01:25:36", "text": "但我覺得這樣更自在"}, {"type": "subtitle", "time": 5137.526, "timestamp": "01:25:37", "text": "我保持沉默。"}, {"type": "subtitle", "time": 5139.503, "timestamp": "01:25:39", "text": "是的。"}, {"type": "subtitle", "time": 5142.084, "timestamp": "01:25:42", "text": "是的，這是真的。是的，各位。不"}, {"type": "subtitle", "time": 5144.511, "timestamp": "01:25:44", "text": "我們聊了很多。有討論嗎？"}, {"type": "subtitle", "time": 5144.83, "timestamp": "01:25:44", "text": "這裡？"}, {"type": "subtitle", "time": 5150.511, "timestamp": "01:25:50", "text": "呃，我們還能說什麼呢？"}, {"type": "subtitle", "time": 5155.462, "timestamp": "01:25:55", "text": "有一天，當周圍非常安靜的時候，"}]
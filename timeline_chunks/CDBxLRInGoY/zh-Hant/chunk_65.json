[{"type": "subtitle", "time": 3904.265, "timestamp": "01:05:04", "text": "快點。你不能，你不能，你不能"}, {"type": "subtitle", "time": 3907.341, "timestamp": "01:05:07", "text": "要為朋友付出努力。快點 。"}, {"type": "subtitle", "time": 3909.293, "timestamp": "01:05:09", "text": "快點。"}, {"type": "subtitle", "time": 3912.684, "timestamp": "01:05:12", "text": "如果你願意，我們可以一起玩漫威宿敵。"}, {"type": "subtitle", "time": 3913.159, "timestamp": "01:05:13", "text": "他們想要。"}, {"type": "subtitle", "time": 3924.438, "timestamp": "01:05:24", "text": "等等，你到底有沒有安裝它？我？"}, {"type": "subtitle", "time": 3926.572, "timestamp": "01:05:26", "text": "我沒有安裝它。我們可以玩"}, {"type": "subtitle", "time": 3929.77, "timestamp": "01:05:29", "text": "又是新的一天。你懂的，眨眨眼。"}, {"type": "subtitle", "time": 3931.293, "timestamp": "01:05:31", "text": "這樣可行。"}, {"type": "subtitle", "time": 3936.568, "timestamp": "01:05:36", "text": "是的。同時，我總可以"}, {"type": "subtitle", "time": 3938.663, "timestamp": "01:05:38", "text": "進入遊戲，探索一切"}, {"type": "subtitle", "time": 3940.593, "timestamp": "01:05:40", "text": "新設計是為了方便他們"}, {"type": "subtitle", "time": 3940.98, "timestamp": "01:05:40", "text": "玩。"}, {"type": "subtitle", "time": 3943.169, "timestamp": "01:05:43", "text": "是的。"}, {"type": "subtitle", "time": 3949.769, "timestamp": "01:05:49", "text": "但是，沒錯，夥計們，當他們玩漫威遊戲的時候。"}, {"type": "subtitle", "time": 3952.156, "timestamp": "01:05:52", "text": "競爭對手們，別讓女人影響了你們。"}, {"type": "subtitle", "time": 3955.119, "timestamp": "01:05:55", "text": "去煩他們一下，好嗎？別讓"}]
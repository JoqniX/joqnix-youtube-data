[{"type": "subtitle", "time": 1080.426, "timestamp": "00:18:00", "text": "我們有 Make。麵包，還有這裡"}, {"type": "subtitle", "time": 1083.967, "timestamp": "00:18:03", "text": "我們。你可以發言。"}, {"type": "subtitle", "time": 1090.627, "timestamp": "00:18:10", "text": "我們可以談談。我們現在可以談了。 ！ 耶！"}, {"type": "subtitle", "time": 1096.379, "timestamp": "00:18:16", "text": "終於離開地下室了。是的，先生。"}, {"type": "subtitle", "time": 1103.348, "timestamp": "00:18:23", "text": "是的。你好嗎？如何"}, {"type": "subtitle", "time": 1108.186, "timestamp": "00:18:28", "text": "我們是嗎？問得好。感覺如何？"}, {"type": "subtitle", "time": 1112.479, "timestamp": "00:18:32", "text": "生命是什麼？"}, {"type": "subtitle", "time": 1118.055, "timestamp": "00:18:38", "text": "生活？人生充滿變數。在哪裡"}, {"type": "subtitle", "time": 1118.485, "timestamp": "00:18:38", "text": "是我的"}, {"type": "subtitle", "time": 1121.038, "timestamp": "00:18:41", "text": "好的。直播正在進行。好的。"}, {"type": "subtitle", "time": 1123.568, "timestamp": "00:18:43", "text": "我嚇壞了。我以為這條溪流是"}, {"type": "subtitle", "time": 1124.925, "timestamp": "00:18:44", "text": "直播正在進行。"}, {"type": "subtitle", "time": 1128.083, "timestamp": "00:18:48", "text": "是的，你一開始就說對了。"}, {"type": "subtitle", "time": 1131.131, "timestamp": "00:18:51", "text": "溪流。你說「在」的重點是"}, {"type": "subtitle", "time": 1134.211, "timestamp": "00:18:54", "text": "我還活著，情緒有起有落。這事也發生在我身上。"}, {"type": "subtitle", "time": 1134.541, "timestamp": "00:18:54", "text": "我。"}]
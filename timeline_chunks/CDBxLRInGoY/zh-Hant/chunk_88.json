[{"type": "subtitle", "time": 5284.649, "timestamp": "01:28:04", "text": "炸雞和印度薄餅。我們做不到"}, {"type": "subtitle", "time": 5302.268, "timestamp": "01:28:22", "text": "我們有時間交談。給我"}, {"type": "subtitle", "time": 5304.662, "timestamp": "01:28:24", "text": "一秒鐘。我會帶水和一些…"}, {"type": "subtitle", "time": 5305.021, "timestamp": "01:28:25", "text": "吃。"}, {"type": "subtitle", "time": 5309.331, "timestamp": "01:28:29", "text": "嘿，這是免費直播。"}, {"type": "subtitle", "time": 5312.947, "timestamp": "01:28:32", "text": "所以別擔心。雖然它是"}, {"type": "subtitle", "time": 5314.897, "timestamp": "01:28:34", "text": "整個派對結束後，他們都在那裡。"}, {"type": "subtitle", "time": 5330.453, "timestamp": "01:28:50", "text": "倖存下來。如果真那麼好的話"}]
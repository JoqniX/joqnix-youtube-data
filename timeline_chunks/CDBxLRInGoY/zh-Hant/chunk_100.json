[{"type": "subtitle", "time": 6002.485, "timestamp": "01:40:02", "text": "我的天啊。哦，不。因為"}, {"type": "subtitle", "time": 6004.362, "timestamp": "01:40:04", "text": "你同意嗎？快點。"}, {"type": "subtitle", "time": 6005.395, "timestamp": "01:40:05", "text": "你必須如此。"}, {"type": "subtitle", "time": 6019.996, "timestamp": "01:40:19", "text": "是的。去吃點東西吧。"}, {"type": "subtitle", "time": 6026.547, "timestamp": "01:40:26", "text": "是的，我當時想找點東西吃。"}, {"type": "subtitle", "time": 6028.651, "timestamp": "01:40:28", "text": "我意識到我一無所有。"}, {"type": "subtitle", "time": 6031.668, "timestamp": "01:40:31", "text": "我只有水。於是我喝了水。"}, {"type": "subtitle", "time": 6032.332, "timestamp": "01:40:32", "text": "於是我來到了這裡。"}, {"type": "subtitle", "time": 6036.791, "timestamp": "01:40:36", "text": "我們倆的情況一樣。"}, {"type": "subtitle", "time": 6037.984, "timestamp": "01:40:37", "text": "是的。"}, {"type": "subtitle", "time": 6041.995, "timestamp": "01:40:41", "text": "不，那裡有吃的，你知道的。絕對不行"}, {"type": "subtitle", "time": 6045.826, "timestamp": "01:40:45", "text": "我想吃那個，你懂我的意思吧。"}, {"type": "subtitle", "time": 6046.916, "timestamp": "01:40:46", "text": "我是說。知道？"}, {"type": "subtitle", "time": 6051.827, "timestamp": "01:40:51", "text": "我的天哪。是的。你知道你什麼時候有"}, {"type": "subtitle", "time": 6053.429, "timestamp": "01:40:53", "text": "同一種東西太多，你就不想再吃了。"}, {"type": "subtitle", "time": 6054.254, "timestamp": "01:40:54", "text": "再吃一次？"}]
[{"type": "subtitle", "time": 5523.148, "timestamp": "01:32:03", "text": "是的，只有一個玩家。"}, {"type": "subtitle", "time": 5527.988, "timestamp": "01:32:07", "text": "我做到了。其他人是什麼樣的人？"}, {"type": "subtitle", "time": 5530.524, "timestamp": "01:32:10", "text": "是的，那就是我。這就是我。"}, {"type": "subtitle", "time": 5532.806, "timestamp": "01:32:12", "text": "對，就是這樣。"}, {"type": "subtitle", "time": 5540.829, "timestamp": "01:32:20", "text": "我做了。我想我記得。"}, {"type": "subtitle", "time": 5541.256, "timestamp": "01:32:21", "text": "我"}, {"type": "subtitle", "time": 5547.944, "timestamp": "01:32:27", "text": "所以。於是我想，“好吧，我們走吧。”"}, {"type": "subtitle", "time": 5550.555, "timestamp": "01:32:30", "text": "讓玩家能夠快速地獨自玩這款遊戲。"}, {"type": "subtitle", "time": 5555.72, "timestamp": "01:32:35", "text": "我把時間都花在看速通影片了。"}, {"type": "subtitle", "time": 5563.193, "timestamp": "01:32:43", "text": "我玩過所有遊戲，而且都是速通。是的，甚至"}, {"type": "subtitle", "time": 5565.235, "timestamp": "01:32:45", "text": "不知為何，我開始看Palworld了。"}, {"type": "subtitle", "time": 5565.677, "timestamp": "01:32:45", "text": "原因。"}, {"type": "subtitle", "time": 5570.992, "timestamp": "01:32:50", "text": "是的，就像"}, {"type": "subtitle", "time": 5574.717, "timestamp": "01:32:54", "text": "速通所有遊戲。不"}, {"type": "subtitle", "time": 5576.424, "timestamp": "01:32:56", "text": "我們當時並不是想玩得開心。"}]
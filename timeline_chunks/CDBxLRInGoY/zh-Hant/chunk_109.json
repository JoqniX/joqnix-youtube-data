[{"type": "subtitle", "time": 6540.127, "timestamp": "01:49:00", "text": "他可能需要睡覺。但 後天直播仍無法觀看。"}, {"type": "subtitle", "time": 6542.389, "timestamp": "01:49:02", "text": "後天直播仍無法觀看。 雖然已經安排好了，但我會再安排一次。"}, {"type": "subtitle", "time": 6544.198, "timestamp": "01:49:04", "text": "雖然已經安排好了，但我會再安排一次。 直播結束後，和Hiroana一起…"}, {"type": "subtitle", "time": 6550.487, "timestamp": "01:49:10", "text": "直播結束後，和Hiroana一起… 我玩《Big Walk》，我玩《Big Walk》。"}, {"type": "subtitle", "time": 6557.252, "timestamp": "01:49:17", "text": "我玩《Big Walk》，我玩《Big Walk》。 所以歡迎隨時過來。"}, {"type": "subtitle", "time": 6559.386, "timestamp": "01:49:19", "text": "所以歡迎隨時過來。 後天，也就是星期五，就在這裡。他"}, {"type": "subtitle", "time": 6562.761, "timestamp": "01:49:22", "text": "後天，也就是星期五，就在這裡。他 週六我們將與…合作"}, {"type": "subtitle", "time": 6564.71, "timestamp": "01:49:24", "text": "週六我們將與…合作 Sherisa 代表 Shashingo 出戰"}, {"type": "subtitle", "time": 6569.334, "timestamp": "01:49:29", "text": "Sherisa 代表 Shashingo 出戰 一起學習日語，一起學習"}, {"type": "subtitle", "time": 6571.684, "timestamp": "01:49:31", "text": "一起學習日語，一起學習 日本人玩攝影遊戲。他"}, {"type": "subtitle", "time": 6577.33, "timestamp": "01:49:37", "text": "日本人玩攝影遊戲。他 星期天休息。是的，星期四。"}, {"type": "subtitle", "time": 6580.256, "timestamp": "01:49:40", "text": "星期天休息。是的，星期四。 星期天休息。所以"}, {"type": "subtitle", "time": 6582.532, "timestamp": "01:49:42", "text": "星期天休息。所以 我不知道該怎麼辦。或許我會做得更多"}, {"type": "subtitle", "time": 6584.581, "timestamp": "01:49:44", "text": "我不知道該怎麼辦。或許我會做得更多 流。是的。再次感謝"}, {"type": "subtitle", "time": 6589.686, "timestamp": "01:49:49", "text": "流。是的。再次感謝 那些來的人。到時見"}, {"type": "subtitle", "time": 6592.537, "timestamp": "01:49:52", "text": "那些來的人。到時見 下一個。再見。謝謝你們的光臨。"}]
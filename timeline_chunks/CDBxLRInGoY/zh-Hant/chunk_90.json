[{"type": "subtitle", "time": 5402.422, "timestamp": "01:30:02", "text": "是？我到處逛逛。"}, {"type": "subtitle", "time": 5405.864, "timestamp": "01:30:05", "text": "我解鎖了，呃，我解鎖了"}, {"type": "subtitle", "time": 5411.166, "timestamp": "01:30:11", "text": "恐怖分子及其領導人。那"}, {"type": "subtitle", "time": 5418.575, "timestamp": "01:30:18", "text": "就這樣。是的，boss會施法。"}, {"type": "subtitle", "time": 5423.784, "timestamp": "01:30:23", "text": "你知道，這張地圖能提供大約 16,000 點經驗值。"}, {"type": "subtitle", "time": 5439.679, "timestamp": "01:30:39", "text": "原則。我當時很害怕。"}, {"type": "subtitle", "time": 5452.113, "timestamp": "01:30:52", "text": "這真的很值得，因為我從來沒有"}, {"type": "subtitle", "time": 5457.449, "timestamp": "01:30:57", "text": "我根本沒看完。是的。"}]
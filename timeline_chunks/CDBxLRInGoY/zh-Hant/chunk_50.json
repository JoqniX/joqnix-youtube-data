[{"type": "subtitle", "time": 3002.107, "timestamp": "00:50:02", "text": "是的。你要去"}, {"type": "subtitle", "time": 3005.186, "timestamp": "00:50:05", "text": "是的。對不起。我當時正在下載。"}, {"type": "subtitle", "time": 3008.727, "timestamp": "00:50:08", "text": "你說話的時候我們跳了起來。想"}, {"type": "subtitle", "time": 3019.675, "timestamp": "00:50:19", "text": "現在練習說“就像我想要的那樣”"}, {"type": "subtitle", "time": 3020.237, "timestamp": "00:50:20", "text": "挑戰。"}, {"type": "subtitle", "time": 3024.255, "timestamp": "00:50:24", "text": "所以，你當時在玩遊戲嗎？只是"}, {"type": "subtitle", "time": 3026.091, "timestamp": "00:50:26", "text": "你說話的時候「正處於巔峰狀態」。"}, {"type": "subtitle", "time": 3027.81, "timestamp": "00:50:27", "text": "和我們一起嗎？這就是你的工作嗎？"}, {"type": "subtitle", "time": 3030.181, "timestamp": "00:50:30", "text": "不，不，不。跳躍。"}, {"type": "subtitle", "time": 3032.029, "timestamp": "00:50:32", "text": "飛躍。"}, {"type": "subtitle", "time": 3035.272, "timestamp": "00:50:35", "text": "如何與你一起做到。 ” 高峰“"}, {"type": "subtitle", "time": 3038.184, "timestamp": "00:50:38", "text": "下次。並不真地。"}, {"type": "subtitle", "time": 3041.196, "timestamp": "00:50:41", "text": "夜班。快點。快點。轉移"}, {"type": "subtitle", "time": 3047.489, "timestamp": "00:50:47", "text": "午夜時分。快點。快點。我不知道。"}, {"type": "subtitle", "time": 3048.85, "timestamp": "00:50:48", "text": "五四隻火雞。"}, {"type": "subtitle", "time": 3053.228, "timestamp": "00:50:53", "text": "我的天啊。這是其中之一"}, {"type": "subtitle", "time": 3058.309, "timestamp": "00:50:58", "text": "1,000。我不這麼認為。"}]
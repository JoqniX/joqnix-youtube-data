[{"type": "subtitle", "time": 2349.217, "timestamp": "00:39:09", "text": "愚蠢的耳朵。你咳嗽嗎？"}, {"type": "subtitle", "time": 2351.183, "timestamp": "00:39:11", "text": "打噴嚏？我無法告訴你。"}, {"type": "subtitle", "time": 2354.899, "timestamp": "00:39:14", "text": "他咳​​嗽了。叫他帶點東西去"}, {"type": "subtitle", "time": 2357.018, "timestamp": "00:39:17", "text": "咳嗽之類的。他快要死了。"}, {"type": "subtitle", "time": 2363.223, "timestamp": "00:39:23", "text": "因為下雨，天氣也很冷。"}, {"type": "subtitle", "time": 2369.076, "timestamp": "00:39:29", "text": "啊，是的。朋友，別生病。不"}, {"type": "subtitle", "time": 2369.73, "timestamp": "00:39:29", "text": "生病的。"}, {"type": "subtitle", "time": 2375.8, "timestamp": "00:39:35", "text": "我很高興我帶了戒指。"}, {"type": "subtitle", "time": 2376.99, "timestamp": "00:39:36", "text": "因為今天下了很多雨。"}, {"type": "subtitle", "time": 2381.314, "timestamp": "00:39:41", "text": "我的天啊。讓我猜猜看"}, {"type": "subtitle", "time": 2383.493, "timestamp": "00:39:43", "text": "雨中汽車的顏色。它是粉紅色的嗎？"}, {"type": "subtitle", "time": 2385.958, "timestamp": "00:39:45", "text": "不。黑色。"}, {"type": "subtitle", "time": 2391.276, "timestamp": "00:39:51", "text": "啊，黑色。為什麼？為什麼這麼認為"}, {"type": "subtitle", "time": 2391.841, "timestamp": "00:39:51", "text": "什麼是粉色？"}, {"type": "subtitle", "time": 2394.727, "timestamp": "00:39:54", "text": "不知道。"}]
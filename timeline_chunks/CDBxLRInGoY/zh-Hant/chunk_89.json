[{"type": "subtitle", "time": 5364.361, "timestamp": "01:29:24", "text": "這輛車。嗯。哦，今晚我有"}, {"type": "subtitle", "time": 5371.409, "timestamp": "01:29:31", "text": "又是一個夜晚。不，只是一件小事。"}, {"type": "subtitle", "time": 5379.349, "timestamp": "01:29:39", "text": "權力。我？"}, {"type": "subtitle", "time": 5381.425, "timestamp": "01:29:41", "text": "不，我拿不起來。"}, {"type": "subtitle", "time": 5387.365, "timestamp": "01:29:47", "text": "是啊，為什麼不玩呢？我上去好多地方了。"}, {"type": "subtitle", "time": 5393.764, "timestamp": "01:29:53", "text": "水平很高，你知道的。我認為是52。"}, {"type": "subtitle", "time": 5397.575, "timestamp": "01:29:57", "text": "兄弟，我卡在30歲了。怎麼辦？"}]
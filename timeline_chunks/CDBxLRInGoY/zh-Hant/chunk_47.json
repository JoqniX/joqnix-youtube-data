[{"type": "subtitle", "time": 2823.726, "timestamp": "00:47:03", "text": "遊戲。所以我覺得是這樣。 這款遊戲不會像，你知道的，"}, {"type": "subtitle", "time": 2826.351, "timestamp": "00:47:06", "text": "這款遊戲不會像，你知道的， 一款線上服務型遊戲。並非如此"}, {"type": "subtitle", "time": 2831.134, "timestamp": "00:47:11", "text": "一款線上服務型遊戲。並非如此 就像《決勝時刻》之類的遊戲，沒錯。"}, {"type": "subtitle", "time": 2833.386, "timestamp": "00:47:13", "text": "就像《決勝時刻》之類的遊戲，沒錯。 你知道。"}, {"type": "subtitle", "time": 2838.863, "timestamp": "00:47:18", "text": "就像生活一樣。"}, {"type": "subtitle", "time": 2843.302, "timestamp": "00:47:23", "text": "是的，我認為它仍然會收到"}, {"type": "subtitle", "time": 2848.904, "timestamp": "00:47:28", "text": "更新信息，對吧？我認為"}, {"type": "subtitle", "time": 2850.737, "timestamp": "00:47:30", "text": "大多數獨立遊戲並非如此。"}, {"type": "subtitle", "time": 2852.215, "timestamp": "00:47:32", "text": "你知道，就是那種現場服務。"}, {"type": "subtitle", "time": 2856.426, "timestamp": "00:47:36", "text": "所以，我會說這是一場遊戲"}, {"type": "subtitle", "time": 2858.966, "timestamp": "00:47:38", "text": "線上服務就像…什麼？頂點，"}, {"type": "subtitle", "time": 2862.099, "timestamp": "00:47:42", "text": "正如我剛才所說，《決勝時刻》…"}, {"type": "subtitle", "time": 2867.216, "timestamp": "00:47:47", "text": "《鬥陣特攻》、《漫威勁敵》等遊戲"}, {"type": "subtitle", "time": 2869.273, "timestamp": "00:47:49", "text": "你知道，他們通常會打架，他們明白這一點。"}, {"type": "subtitle", "time": 2871.445, "timestamp": "00:47:51", "text": "即時更新，直到它們"}, {"type": "subtitle", "time": 2876.143, "timestamp": "00:47:56", "text": "被遺棄並達到極限。好的 沒有"}, {"type": "subtitle", "time": 2876.991, "timestamp": "00:47:56", "text": "沒有 就這些了，夥計。"}, {"type": "subtitle", "time": 2878.954, "timestamp": "00:47:58", "text": "就這些了，夥計。 進入巔峰。"}, {"type": "subtitle", "time": 2879.86, "timestamp": "00:47:59", "text": "進入巔峰。 我不打算玩。我們不會…我們不會"}]
[{"type": "subtitle", "time": 4381.651, "timestamp": "01:13:01", "text": "角色扮演或表演"}, {"type": "subtitle", "time": 4382.471, "timestamp": "01:13:02", "text": "另一個角色。"}, {"type": "subtitle", "time": 4386.749, "timestamp": "01:13:06", "text": "是的，那我覺得你不太像個…"}, {"type": "subtitle", "time": 4401.177, "timestamp": "01:13:21", "text": "擅長這個。我吃了這個披薩。我"}, {"type": "subtitle", "time": 4402.995, "timestamp": "01:13:22", "text": "我為那些觀看的人感到難過。"}, {"type": "subtitle", "time": 4406.714, "timestamp": "01:13:26", "text": "我真的很喜歡這張我的照片。"}, {"type": "subtitle", "time": 4407.47, "timestamp": "01:13:27", "text": "我想，應該是引言吧。"}, {"type": "subtitle", "time": 4415.542, "timestamp": "01:13:35", "text": "我很傷心。我為這些人感到難過。"}, {"type": "subtitle", "time": 4421.355, "timestamp": "01:13:41", "text": "是的。我記得有一次我廣播"}, {"type": "subtitle", "time": 4423.939, "timestamp": "01:13:43", "text": "我說：“請停止這種行為。”"}, {"type": "subtitle", "time": 4428.906, "timestamp": "01:13:48", "text": "「遊戲」。降低。趕緊完成這件事。"}, {"type": "subtitle", "time": 4439.352, "timestamp": "01:13:59", "text": "拜託了，兄弟。他們可能會說 “哇，你真有那麼壞嗎，兄弟？”"}]
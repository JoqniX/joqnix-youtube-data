[{"type": "subtitle", "time": 1622.173, "timestamp": "00:27:02", "text": "哦是的。是的。他們都擅長 英語。"}, {"type": "subtitle", "time": 1637.233, "timestamp": "00:27:17", "text": "是的。他們的英語真好。他們要走了。"}, {"type": "subtitle", "time": 1640.908, "timestamp": "00:27:20", "text": "哦，我忘了。那好吧。哦，我是"}, {"type": "subtitle", "time": 1645.619, "timestamp": "00:27:25", "text": "被夾在兩個舊墨西哥捲餅中間。經過"}, {"type": "subtitle", "time": 1646.246, "timestamp": "00:27:26", "text": "假設。"}, {"type": "subtitle", "time": 1649.619, "timestamp": "00:27:29", "text": "我知道。我知道。"}, {"type": "subtitle", "time": 1654.646, "timestamp": "00:27:34", "text": "是的。你什麼時候開始學日文？"}, {"type": "subtitle", "time": 1659.725, "timestamp": "00:27:39", "text": "當我學習日語的時候。因為"}, {"type": "subtitle", "time": 1662.644, "timestamp": "00:27:42", "text": "我需要學習日文嗎？為什麼？"}, {"type": "subtitle", "time": 1665.756, "timestamp": "00:27:45", "text": "不？為什麼不呢？為什麼？"}, {"type": "subtitle", "time": 1668.92, "timestamp": "00:27:48", "text": "好吧。我沒有這樣的夢想"}, {"type": "subtitle", "time": 1670.845, "timestamp": "00:27:50", "text": "找個日本女朋友。這"}, {"type": "subtitle", "time": 1673.049, "timestamp": "00:27:53", "text": "好的。我不打算學日文。"}, {"type": "subtitle", "time": 1675.352, "timestamp": "00:27:55", "text": "你們兩個不一樣。你們兩位"}, {"type": "subtitle", "time": 1678.251, "timestamp": "00:27:58", "text": "它們不一樣。什麼？為什麼是我？"}]
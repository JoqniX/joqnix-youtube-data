[{"type": "subtitle", "time": 3304.58, "timestamp": "00:55:04", "text": "我看到了。遊戲。嘿，你試過這個嗎？"}, {"type": "subtitle", "time": 3309.561, "timestamp": "00:55:09", "text": "遊戲叫什麼？"}, {"type": "subtitle", "time": 3310.05, "timestamp": "00:55:10", "text": "被禁足了嗎？"}, {"type": "subtitle", "time": 3314.105, "timestamp": "00:55:14", "text": "明白了。"}, {"type": "subtitle", "time": 3315.194, "timestamp": "00:55:15", "text": "是的。"}, {"type": "subtitle", "time": 3319.359, "timestamp": "00:55:19", "text": "不知道。另一個遊戲叫…？"}, {"type": "subtitle", "time": 3324.134, "timestamp": "00:55:24", "text": "哦，等等。哦，RuneScape 有一個"}, {"type": "subtitle", "time": 3326.433, "timestamp": "00:55:26", "text": "新遊戲，《龍之荒野》。什麼是"}, {"type": "subtitle", "time": 3332.26, "timestamp": "00:55:32", "text": "這？是的。是的，我們一場都沒玩過。"}, {"type": "subtitle", "time": 3336.224, "timestamp": "00:55:36", "text": "大型多人線上角色扮演遊戲（MMORPG）。不。開放。因為"}, {"type": "subtitle", "time": 3338.925, "timestamp": "00:55:38", "text": "我們需要玩更多角色扮演遊戲嗎？你知道"}, {"type": "subtitle", "time": 3340.13, "timestamp": "00:55:40", "text": "他們需要多長時間？"}, {"type": "subtitle", "time": 3342.984, "timestamp": "00:55:42", "text": "是的，在這個世界生存和創造。"}, {"type": "subtitle", "time": 3345.914, "timestamp": "00:55:45", "text": "打開。真的。"}, {"type": "subtitle", "time": 3348.654, "timestamp": "00:55:48", "text": "好了，我們正在玩《翻轉世界》遊戲。 。這就是開放世界生存遊戲。"}, {"type": "subtitle", "time": 3350.834, "timestamp": "00:55:50", "text": "。這就是開放世界生存遊戲。 ， 不？"}, {"type": "subtitle", "time": 3351.769, "timestamp": "00:55:51", "text": "， 不？ 是的。我們可以玩《Sons of the》"}, {"type": "subtitle", "time": 3356.468, "timestamp": "00:55:56", "text": "是的。我們可以玩《Sons of the》 福里斯特，如果你願意的話，總有一天會的。經過"}]
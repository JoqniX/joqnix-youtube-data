[{"type": "subtitle", "time": 5700.868, "timestamp": "01:35:00", "text": "我有一些問題。很多什麼"}, {"type": "subtitle", "time": 5702.724, "timestamp": "01:35:02", "text": "談完多少，多少"}, {"type": "subtitle", "time": 5705.353, "timestamp": "01:35:05", "text": "已經過去多久了？就像一個小時那麼長"}, {"type": "subtitle", "time": 5706.802, "timestamp": "01:35:06", "text": "平均的？太瘋狂了。"}, {"type": "subtitle", "time": 5710.641, "timestamp": "01:35:10", "text": "我突然想到一個主意。"}, {"type": "subtitle", "time": 5715.331, "timestamp": "01:35:15", "text": "我腦中突然就冒出了這個想法。就像 夠了。"}, {"type": "subtitle", "time": 5728.582, "timestamp": "01:35:28", "text": "我想問你一個問題。嗯，？ 你覺得我怎麼樣？我們一直是朋友"}, {"type": "subtitle", "time": 5732.144, "timestamp": "01:35:32", "text": "你覺得我怎麼樣？我們一直是朋友 這麼久了。"}, {"type": "subtitle", "time": 5738.452, "timestamp": "01:35:38", "text": "糟糕的決定。"}, {"type": "subtitle", "time": 5740.351, "timestamp": "01:35:40", "text": "是的。什麼？"}, {"type": "subtitle", "time": 5747.727, "timestamp": "01:35:47", "text": "不，我開玩笑的。這只是個玩笑。當然是這樣"}, {"type": "subtitle", "time": 5751.027, "timestamp": "01:35:51", "text": "開玩笑。但如果真是這樣，他就不會是你的朋友了。"}, {"type": "subtitle", "time": 5754.57, "timestamp": "01:35:54", "text": "你知道，那樣做你會是個糟糕的朋友。那"}, {"type": "subtitle", "time": 5755.579, "timestamp": "01:35:55", "text": "確實如此。"}, {"type": "subtitle", "time": 5758.903, "timestamp": "01:35:58", "text": "或許我現在是在騙你。"}, {"type": "subtitle", "time": 5759.975, "timestamp": "01:35:59", "text": "相同的。誰知道呢？"}]
[{"type": "subtitle", "time": 6361.024, "timestamp": "01:46:01", "text": "簡單的。我將計劃第二天"}, {"type": "subtitle", "time": 6362.989, "timestamp": "01:46:02", "text": "就像你說的，就像你可以"}, {"type": "subtitle", "time": 6364.673, "timestamp": "01:46:04", "text": "玩恐怖遊戲或"}, {"type": "subtitle", "time": 6370.536, "timestamp": "01:46:10", "text": "真的。好吧，"}, {"type": "subtitle", "time": 6380.14, "timestamp": "01:46:20", "text": "我能做到。是的。是的。或許吧。"}, {"type": "subtitle", "time": 6381.331, "timestamp": "01:46:21", "text": "我們應該離開了。"}, {"type": "subtitle", "time": 6383.642, "timestamp": "01:46:23", "text": "什麼？謝謝你今天的一切。"}, {"type": "subtitle", "time": 6388.397, "timestamp": "01:46:28", "text": "謝謝你，替我謝謝你。"}, {"type": "subtitle", "time": 6390.489, "timestamp": "01:46:30", "text": "是的。"}, {"type": "subtitle", "time": 6391.786, "timestamp": "01:46:31", "text": "再見。"}, {"type": "subtitle", "time": 6409.849, "timestamp": "01:46:49", "text": "又要說再見了嗎？好了，那是紅。"}, {"type": "subtitle", "time": 6415.567, "timestamp": "01:46:55", "text": "和 Yur Mikasuki。謝謝你們兩位"}]
[{"type": "subtitle", "time": 1862.105, "timestamp": "00:31:02", "text": "假設。誰說的？甚至連這都不是。"}, {"type": "subtitle", "time": 1863.046, "timestamp": "00:31:03", "text": "它甚至不算是一個"}, {"type": "subtitle", "time": 1866.629, "timestamp": "00:31:06", "text": "這讓我想起了…"}, {"type": "subtitle", "time": 1874.152, "timestamp": "00:31:14", "text": "安托。沒有比賽。沒有生活。"}, {"type": "subtitle", "time": 1876.101, "timestamp": "00:31:16", "text": "哦，"}, {"type": "subtitle", "time": 1879.05, "timestamp": "00:31:19", "text": "是的。"}, {"type": "subtitle", "time": 1882.507, "timestamp": "00:31:22", "text": "更何況我根本不看動漫，但是"}, {"type": "subtitle", "time": 1884.29, "timestamp": "00:31:24", "text": "即便如此，我還是明白了這個典故。"}, {"type": "subtitle", "time": 1890.97, "timestamp": "00:31:30", "text": "是的。是的。不錯的動漫。不錯的動漫。"}, {"type": "subtitle", "time": 1894.518, "timestamp": "00:31:34", "text": "是的。永遠不會有第二個了。"}, {"type": "subtitle", "time": 1895.084, "timestamp": "00:31:35", "text": "季節。"}, {"type": "subtitle", "time": 1898.834, "timestamp": "00:31:38", "text": "是的。它有續集嗎？ ？"}, {"type": "subtitle", "time": 1902.29, "timestamp": "00:31:42", "text": "我覺得他寫過輕小說。是的。"}, {"type": "subtitle", "time": 1905.971, "timestamp": "00:31:45", "text": "現在是晚上嗎？好的。一部輕小說"}, {"type": "subtitle", "time": 1908.36, "timestamp": "00:31:48", "text": "這未免太誇張了。"}, {"type": "subtitle", "time": 1910.616, "timestamp": "00:31:50", "text": "你知道，就像續集一樣"}, {"type": "subtitle", "time": 1914.674, "timestamp": "00:31:54", "text": "第二季之類的。小說"}, {"type": "subtitle", "time": 1916.491, "timestamp": "00:31:56", "text": "我覺得沒那麼亮。"}]
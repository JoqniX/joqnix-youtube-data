[{"type": "subtitle", "time": 6181.672, "timestamp": "01:43:01", "text": "你知道，《哈迪斯》和故事遊戲"}, {"type": "subtitle", "time": 6184.1, "timestamp": "01:43:04", "text": "單人遊戲，你可以和玩家一起玩。"}, {"type": "subtitle", "time": 6184.804, "timestamp": "01:43:04", "text": "您的帳戶。"}, {"type": "subtitle", "time": 6186.248, "timestamp": "01:43:06", "text": "是的。"}, {"type": "subtitle", "time": 6188.742, "timestamp": "01:43:08", "text": "一名玩家。"}, {"type": "subtitle", "time": 6193.939, "timestamp": "01:43:13", "text": "就這樣。是的。總之，我認為"}, {"type": "subtitle", "time": 6196.297, "timestamp": "01:43:16", "text": "先生，他想就此結束，因為他"}, {"type": "subtitle", "time": 6198.538, "timestamp": "01:43:18", "text": "他很累，我也很累。"}, {"type": "subtitle", "time": 6199.659, "timestamp": "01:43:19", "text": "現在非常累。"}, {"type": "subtitle", "time": 6204.912, "timestamp": "01:43:24", "text": "是的。沒問題。"}, {"type": "subtitle", "time": 6208.517, "timestamp": "01:43:28", "text": "是的。是的，我們可以完成了。"}, {"type": "subtitle", "time": 6211.147, "timestamp": "01:43:31", "text": "我們聊了兩個小時。"}, {"type": "subtitle", "time": 6212.934, "timestamp": "01:43:32", "text": "快點。"}, {"type": "subtitle", "time": 6213.983, "timestamp": "01:43:33", "text": "是的。"}, {"type": "subtitle", "time": 6215.33, "timestamp": "01:43:35", "text": "我們幾乎沒說什麼。"}, {"type": "subtitle", "time": 6215.888, "timestamp": "01:43:35", "text": "耶。"}, {"type": "subtitle", "time": 6217.807, "timestamp": "01:43:37", "text": "是的，我們聊了兩個小時。"}, {"type": "subtitle", "time": 6221.635, "timestamp": "01:43:41", "text": "不，我們幾乎沒說什麼。我們沒說話。"}, {"type": "subtitle", "time": 6225.538, "timestamp": "01:43:45", "text": "我不知道我身上發生了什麼事。我一直"}, {"type": "subtitle", "time": 6226.856, "timestamp": "01:43:46", "text": "現實生活中很忙。"}, {"type": "subtitle", "time": 6232.422, "timestamp": "01:43:52", "text": "你生前話不多。"}, {"type": "subtitle", "time": 6233.759, "timestamp": "01:43:53", "text": "真實的。是的。是的。"}, {"type": "subtitle", "time": 6236.856, "timestamp": "01:43:56", "text": "是的。我無法與…交談"}]
[{"type": "subtitle", "time": 6301.368, "timestamp": "01:45:01", "text": "感謝今天到場的每一位。"}, {"type": "subtitle", "time": 6315.389, "timestamp": "01:45:15", "text": "是的，布拉德和賈姆。是的。他們仍在繼續使用"}, {"type": "subtitle", "time": 6316.491, "timestamp": "01:45:16", "text": "你面前的標誌"}, {"type": "subtitle", "time": 6324.238, "timestamp": "01:45:24", "text": "我尊重。我的團隊值得尊敬。"}, {"type": "subtitle", "time": 6329.335, "timestamp": "01:45:29", "text": "我只是想給你一個不同的視角。"}, {"type": "subtitle", "time": 6336.787, "timestamp": "01:45:36", "text": "是的，謝謝你今天，謝謝你。"}, {"type": "subtitle", "time": 6340.425, "timestamp": "01:45:40", "text": "今晚來和我一起吧。我玩得很開心"}, {"type": "subtitle", "time": 6347.747, "timestamp": "01:45:47", "text": "今晚。謝謝你邀請我。是的，"}, {"type": "subtitle", "time": 6350.878, "timestamp": "01:45:50", "text": "感謝您加入本群。我當時"}, {"type": "subtitle", "time": 6355.279, "timestamp": "01:45:55", "text": "我在想，今天我要做什麼呢？我思考著…"}, {"type": "subtitle", "time": 6356.928, "timestamp": "01:45:56", "text": "給他們打電話，我們將繼續執行計劃。"}]
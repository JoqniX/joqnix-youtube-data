[{"type": "subtitle", "time": 3842.267, "timestamp": "01:04:02", "text": "我不在乎它是什麼。我比較喜歡Shift鍵。"}, {"type": "subtitle", "time": 3850.536, "timestamp": "01:04:10", "text": "午夜時分。哦，不。好吧。那"}, {"type": "subtitle", "time": 3851.69, "timestamp": "01:04:11", "text": "我們呢？"}, {"type": "subtitle", "time": 3855.14, "timestamp": "01:04:15", "text": "是的，我也覺得這個主意不錯。"}, {"type": "subtitle", "time": 3859.025, "timestamp": "01:04:19", "text": "我的天啊。各位，這是個約會。是"}, {"type": "subtitle", "time": 3877.717, "timestamp": "01:04:37", "text": "約會。約會定好了。臉。哦，拜"}, {"type": "subtitle", "time": 3881.976, "timestamp": "01:04:41", "text": "上帝。等等，你有計畫嗎？"}, {"type": "subtitle", "time": 3886.955, "timestamp": "01:04:46", "text": "等等，我沒玩懂這個遊戲。哪個 ？"}, {"type": "subtitle", "time": 3887.189, "timestamp": "01:04:47", "text": "？ 是的。"}, {"type": "subtitle", "time": 3889.8, "timestamp": "01:04:49", "text": "嘿，午夜。"}, {"type": "subtitle", "time": 3896.334, "timestamp": "01:04:56", "text": "那就買給他吧。快點。"}, {"type": "subtitle", "time": 3899.374, "timestamp": "01:04:59", "text": "我現在身無分文。不能。"}]
[{"type": "subtitle", "time": 6420.721, "timestamp": "01:47:00", "text": "今晚來陪我吧。雖然"}, {"type": "subtitle", "time": 6422.638, "timestamp": "01:47:02", "text": "直播應該要更像一場派對。"}, {"type": "subtitle", "time": 6424.72, "timestamp": "01:47:04", "text": "派對結束後，感覺就像"}, {"type": "subtitle", "time": 6428.997, "timestamp": "01:47:08", "text": "普通的直播。節目《想要那個》"}, {"type": "subtitle", "time": 6432.774, "timestamp": "01:47:12", "text": "這是一場普通的現場直播。然後我意識到"}, {"type": "subtitle", "time": 6434.555, "timestamp": "01:47:14", "text": "他意識到自己必須這麼做。"}, {"type": "subtitle", "time": 6438.701, "timestamp": "01:47:18", "text": "活動後的派對。但是，"}, {"type": "subtitle", "time": 6441.128, "timestamp": "01:47:21", "text": "說實話，還不錯。"}, {"type": "subtitle", "time": 6446.767, "timestamp": "01:47:26", "text": "與朋友聊天"}, {"type": "subtitle", "time": 6448.828, "timestamp": "01:47:28", "text": "放鬆一下，簡單點。"}, {"type": "subtitle", "time": 6456.662, "timestamp": "01:47:36", "text": "我透過玩遊戲來分散注意力。我通常會這樣做"}, {"type": "subtitle", "time": 6463.834, "timestamp": "01:47:43", "text": "這種情況偶爾會發生，但很少見。嗯，是的。"}, {"type": "subtitle", "time": 6465.872, "timestamp": "01:47:45", "text": "在生日板上，"}, {"type": "subtitle", "time": 6471.497, "timestamp": "01:47:51", "text": "還是那種，他們管它叫什麼來著？"}, {"type": "subtitle", "time": 6474.534, "timestamp": "01:47:54", "text": "關閉。你仍然可以祝賀我。"}, {"type": "subtitle", "time": 6477.408, "timestamp": "01:47:57", "text": "一切都好。遲來的祝賀"}, {"type": "subtitle", "time": 6479.434, "timestamp": "01:47:59", "text": "我們隨時歡迎他們。即使"}]
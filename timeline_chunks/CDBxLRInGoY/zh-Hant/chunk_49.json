[{"type": "subtitle", "time": 2943.265, "timestamp": "00:49:03", "text": "你可以默默流淚。就是這樣。"}, {"type": "subtitle", "time": 2944.603, "timestamp": "00:49:04", "text": "那太好了。"}, {"type": "subtitle", "time": 2949.666, "timestamp": "00:49:09", "text": "你知道，你隨時都可以哭。"}, {"type": "subtitle", "time": 2956.409, "timestamp": "00:49:16", "text": "我的天啊。我說得對嗎，阿魯？"}, {"type": "subtitle", "time": 2959.67, "timestamp": "00:49:19", "text": "我的意思是，你說得對。然後他就哭了。"}, {"type": "subtitle", "time": 2962.374, "timestamp": "00:49:22", "text": "他繼續說，他繼續說著兩者"}, {"type": "subtitle", "time": 2962.884, "timestamp": "00:49:22", "text": "姓名。"}, {"type": "subtitle", "time": 2964.132, "timestamp": "00:49:24", "text": "是的，"}, {"type": "subtitle", "time": 2966.222, "timestamp": "00:49:26", "text": "我一直念著這兩個名字。有"}, {"type": "subtitle", "time": 2967.348, "timestamp": "00:49:27", "text": "有什麼問題嗎？"}, {"type": "subtitle", "time": 2973.109, "timestamp": "00:49:33", "text": "我總是忘記該用哪一個。"}, {"type": "subtitle", "time": 2977.22, "timestamp": "00:49:37", "text": "留一個就好。不，不是我。"}, {"type": "subtitle", "time": 2977.883, "timestamp": "00:49:37", "text": "這很重要。"}, {"type": "subtitle", "time": 2980.133, "timestamp": "00:49:40", "text": "哦，所以你一個都不在乎？"}, {"type": "subtitle", "time": 2981.808, "timestamp": "00:49:41", "text": "不，我就要這麼叫你。"}, {"type": "subtitle", "time": 2983.432, "timestamp": "00:49:43", "text": "好的。"}, {"type": "subtitle", "time": 2984.686, "timestamp": "00:49:44", "text": "聽起來很專業。"}, {"type": "subtitle", "time": 2988.127, "timestamp": "00:49:48", "text": "他們可以去訂閱你。或許"}, {"type": "subtitle", "time": 2989.457, "timestamp": "00:49:49", "text": "甚至。誰知道呢？"}, {"type": "subtitle", "time": 2998.556, "timestamp": "00:49:58", "text": "好的。你不打算連接你的設備嗎？"}, {"type": "subtitle", "time": 2999.14, "timestamp": "00:49:59", "text": "是這兒嗎？"}]
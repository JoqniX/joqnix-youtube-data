[{"type": "subtitle", "time": 1744.215, "timestamp": "00:29:04", "text": "是的，非常具有攻擊性。喵。是的，"}, {"type": "subtitle", "time": 1746.6, "timestamp": "00:29:06", "text": "大概。誰知道呢？"}, {"type": "subtitle", "time": 1752.937, "timestamp": "00:29:12", "text": "是的。或荷蘭語。我想"}, {"type": "subtitle", "time": 1754.085, "timestamp": "00:29:14", "text": "學習荷蘭語。"}, {"type": "subtitle", "time": 1757.518, "timestamp": "00:29:17", "text": "是的，你已經會法語了，對吧？"}, {"type": "subtitle", "time": 1763.26, "timestamp": "00:29:23", "text": "是的。很遺憾，是的。"}, {"type": "subtitle", "time": 1774.192, "timestamp": "00:29:34", "text": "我只是出於好心。因為？"}, {"type": "subtitle", "time": 1785.879, "timestamp": "00:29:45", "text": "維特。這麼說？就這樣？不"}, {"type": "subtitle", "time": 1790.574, "timestamp": "00:29:50", "text": "他。我記得我以前和…摔跤"}, {"type": "subtitle", "time": 1792.268, "timestamp": "00:29:52", "text": "就是麵包這個字。"}, {"type": "subtitle", "time": 1795.711, "timestamp": "00:29:55", "text": "它以C開頭。"}, {"type": "subtitle", "time": 1796.64, "timestamp": "00:29:56", "text": "我剛才說了"}, {"type": "subtitle", "time": 1799.102, "timestamp": "00:29:59", "text": "你剛才就說了。"}]
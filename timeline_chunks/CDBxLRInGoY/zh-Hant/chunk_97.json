[{"type": "subtitle", "time": 5821.414, "timestamp": "01:37:01", "text": "許久。一段時間"}, {"type": "subtitle", "time": 5824.404, "timestamp": "01:37:04", "text": "親愛的，我們認識多久了？"}, {"type": "subtitle", "time": 5831.795, "timestamp": "01:37:11", "text": "是的。等等，為什麼感覺像是"}, {"type": "subtitle", "time": 5833.448, "timestamp": "01:37:13", "text": "如果我們正在進行直播"}, {"type": "subtitle", "time": 5834.52, "timestamp": "01:37:14", "text": "友誼日？"}, {"type": "subtitle", "time": 5837.84, "timestamp": "01:37:17", "text": "友誼日現場直播。哦，"}, {"type": "subtitle", "time": 5843.015, "timestamp": "01:37:23", "text": "我的上帝。快點！"}, {"type": "subtitle", "time": 5855.902, "timestamp": "01:37:35", "text": "是的，很多年過去了。我們"}, {"type": "subtitle", "time": 5857.907, "timestamp": "01:37:37", "text": "我們彼此認識，現在還保持聯繫，一切都好。"}, {"type": "subtitle", "time": 5858.178, "timestamp": "01:37:38", "text": "那。"}, {"type": "subtitle", "time": 5870.3, "timestamp": "01:37:50", "text": "很漂亮。是的。我也要退貨。 。我們認識很久了。"}, {"type": "subtitle", "time": 5875.376, "timestamp": "01:37:55", "text": "。我們認識很久了。 我們認識很久了。"}, {"type": "subtitle", "time": 5879.981, "timestamp": "01:37:59", "text": "你知道我最想念誰嗎？"}]
[{"type": "subtitle", "time": 5469.654, "timestamp": "01:31:09", "text": "是的。是的。我們可以試試看「豬」這個遊戲。"}, {"type": "subtitle", "time": 5472.298, "timestamp": "01:31:12", "text": "一起。等等，你有豬吧？"}, {"type": "subtitle", "time": 5474.558, "timestamp": "01:31:14", "text": "哦是的。是的，你有豬。"}, {"type": "subtitle", "time": 5480.506, "timestamp": "01:31:20", "text": "那次我們買了一頭豬。我們一起玩吧？ ？那"}, {"type": "subtitle", "time": 5485.764, "timestamp": "01:31:25", "text": "我們一起玩吧？我認為"}, {"type": "subtitle", "time": 5489.034, "timestamp": "01:31:29", "text": "我也這麼認為，而且他一直死。"}, {"type": "subtitle", "time": 5499.438, "timestamp": "01:31:39", "text": "但後來我看到你扮演"}, {"type": "subtitle", "time": 5501.498, "timestamp": "01:31:41", "text": "背景就像獨自一人，然後你獨自一人"}, {"type": "subtitle", "time": 5507.895, "timestamp": "01:31:47", "text": "以及所有的一切。等等，我"}, {"type": "subtitle", "time": 5510.687, "timestamp": "01:31:50", "text": "我也這麼認為。"}, {"type": "subtitle", "time": 5515.324, "timestamp": "01:31:55", "text": "我記性不好，但我記得一些事。"}, {"type": "subtitle", "time": 5515.671, "timestamp": "01:31:55", "text": "所以。"}, {"type": "subtitle", "time": 5518.61, "timestamp": "01:31:58", "text": "我當時是一個人玩的。很多。"}]
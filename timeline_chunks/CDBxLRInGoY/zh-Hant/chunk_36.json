[{"type": "subtitle", "time": 2165.76, "timestamp": "00:36:05", "text": "給我個驚喜。我不知道的事"}, {"type": "subtitle", "time": 2167.976, "timestamp": "00:36:07", "text": "這種事不會發生在你我身上，這是件新鮮事。"}, {"type": "subtitle", "time": 2173.022, "timestamp": "00:36:13", "text": "一些創新的東西。某種吸引人的東西"}, {"type": "subtitle", "time": 2173.547, "timestamp": "00:36:13", "text": "注意力。"}, {"type": "subtitle", "time": 2181.023, "timestamp": "00:36:21", "text": "但你想看到什麼？"}, {"type": "subtitle", "time": 2182.127, "timestamp": "00:36:22", "text": "除了很棒的一對鞋？"}, {"type": "subtitle", "time": 2195.161, "timestamp": "00:36:35", "text": "我可以關掉攝影機。是的，"}, {"type": "subtitle", "time": 2197.739, "timestamp": "00:36:37", "text": "我當時就想，真的嗎？這是怎麼回事？"}, {"type": "subtitle", "time": 2201.654, "timestamp": "00:36:41", "text": "感覺如何？就像一套完整的裝置，就像"}, {"type": "subtitle", "time": 2203.972, "timestamp": "00:36:43", "text": "他們用汽車之類的東西來做這件事，比如…"}, {"type": "subtitle", "time": 2211.689, "timestamp": "00:36:51", "text": "只需縮小畫面即可。是的。"}, {"type": "subtitle", "time": 2216.178, "timestamp": "00:36:56", "text": "哇。它廣泛應用於編輯領域。"}]
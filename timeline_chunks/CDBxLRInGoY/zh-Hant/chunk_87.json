[{"type": "subtitle", "time": 5221.194, "timestamp": "01:27:01", "text": "我滑倒了。呃，我覺得我不應該…"}, {"type": "subtitle", "time": 5221.788, "timestamp": "01:27:01", "text": "垂死。"}, {"type": "subtitle", "time": 5239.547, "timestamp": "01:27:19", "text": "我的天啊。綠色保鮮器。那是"}, {"type": "subtitle", "time": 5247.483, "timestamp": "01:27:27", "text": "該死。科迪在你家嗎？ 你不打算吃晚餐嗎？"}, {"type": "subtitle", "time": 5255.823, "timestamp": "01:27:35", "text": "其實沒什麼奇怪的。你不能嗎？"}, {"type": "subtitle", "time": 5256.543, "timestamp": "01:27:36", "text": "準備點什麼嗎？"}, {"type": "subtitle", "time": 5261.6, "timestamp": "01:27:41", "text": "好的，那麼它的特別之處是什麼？"}, {"type": "subtitle", "time": 5269.707, "timestamp": "01:27:49", "text": "蘇格蘭佬？哦，那真是……哦，我的意思是，"}, {"type": "subtitle", "time": 5274.598, "timestamp": "01:27:54", "text": "生日派對結束了。那次我吃了"}]
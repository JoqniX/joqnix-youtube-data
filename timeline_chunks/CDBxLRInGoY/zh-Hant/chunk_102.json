[{"type": "subtitle", "time": 6120.134, "timestamp": "01:42:00", "text": "好了，我的2小時直播。"}, {"type": "subtitle", "time": 6122.555, "timestamp": "01:42:02", "text": "已經過去兩個小時了。"}, {"type": "subtitle", "time": 6125.849, "timestamp": "01:42:05", "text": "是的。"}, {"type": "subtitle", "time": 6128.78, "timestamp": "01:42:08", "text": "太瘋狂了。"}, {"type": "subtitle", "time": 6133.413, "timestamp": "01:42:13", "text": "是的。你知道嗎？我們應該玩"}, {"type": "subtitle", "time": 6137.168, "timestamp": "01:42:17", "text": "總有一天會達到巔峰。如果你想玩的話，"}, {"type": "subtitle", "time": 6137.722, "timestamp": "01:42:17", "text": "告訴我。"}, {"type": "subtitle", "time": 6141.694, "timestamp": "01:42:21", "text": "哦，是的，是的，是的。真的嗎？當然。"}, {"type": "subtitle", "time": 6152.929, "timestamp": "01:42:32", "text": "是的。我有朋友一起玩嗎？"}, {"type": "subtitle", "time": 6159.702, "timestamp": "01:42:39", "text": "是的，相當不錯。那就是"}, {"type": "subtitle", "time": 6161.788, "timestamp": "01:42:41", "text": "我停止玩手機遊戲的原因"}, {"type": "subtitle", "time": 6166.306, "timestamp": "01:42:46", "text": "競爭對手。因為我孤身一人。"}, {"type": "subtitle", "time": 6166.634, "timestamp": "01:42:46", "text": "玩。"}, {"type": "subtitle", "time": 6170.453, "timestamp": "01:42:50", "text": "我想知道如果我沒有…會發生什麼。"}, {"type": "subtitle", "time": 6173.119, "timestamp": "01:42:53", "text": "沒人陪我玩。那"}, {"type": "subtitle", "time": 6176.144, "timestamp": "01:42:56", "text": "我會玩哪些遊戲之類的？我總是"}, {"type": "subtitle", "time": 6176.906, "timestamp": "01:42:56", "text": "我問這個問題。"}, {"type": "subtitle", "time": 6179.179, "timestamp": "01:42:59", "text": "這就是我玩《哈迪斯》這類遊戲的原因，你知道的。"}]
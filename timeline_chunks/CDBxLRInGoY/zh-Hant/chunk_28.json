[{"type": "subtitle", "time": 1680.55, "timestamp": "00:28:00", "text": "你們也把我算在內嗎？為什麼要把我算在內？ ？"}, {"type": "subtitle", "time": 1680.692, "timestamp": "00:28:00", "text": "？ 貝蒂，你想要個亞洲女孩。是的。"}, {"type": "subtitle", "time": 1683.029, "timestamp": "00:28:03", "text": "貝蒂，你想要個亞洲女孩。是的。 你想找個亞洲女人，你知道的。"}, {"type": "subtitle", "time": 1685.595, "timestamp": "00:28:05", "text": "你想找個亞洲女人，你知道的。 具備很多優秀品質，對吧？"}, {"type": "subtitle", "time": 1688.405, "timestamp": "00:28:08", "text": "具備很多優秀品質，對吧？  不。"}, {"type": "subtitle", "time": 1694.581, "timestamp": "00:28:14", "text": "不。哦，拜託。哇。"}, {"type": "subtitle", "time": 1698.941, "timestamp": "00:28:18", "text": "總之，我們先把這個話題放在一邊。"}, {"type": "subtitle", "time": 1704.531, "timestamp": "00:28:24", "text": "我的天啊。"}, {"type": "subtitle", "time": 1713.31, "timestamp": "00:28:33", "text": "是的。我們離開是因為一個英國人。"}, {"type": "subtitle", "time": 1719.999, "timestamp": "00:28:39", "text": "我的日語還在進步中。我不會"}, {"type": "subtitle", "time": 1724.141, "timestamp": "00:28:44", "text": "說謊。如果我想學習一門語言，"}, {"type": "subtitle", "time": 1726.126, "timestamp": "00:28:46", "text": "我可能會學習德語，或者"}, {"type": "subtitle", "time": 1728.049, "timestamp": "00:28:48", "text": "德語。"}, {"type": "subtitle", "time": 1735.56, "timestamp": "00:28:55", "text": "這是一種非常非常嚇人的聲音。相信"}, {"type": "subtitle", "time": 1736.483, "timestamp": "00:28:56", "text": "那將是件好事。"}, {"type": "subtitle", "time": 1737.998, "timestamp": "00:28:57", "text": "極具攻擊性。"}]
[{"type": "subtitle", "time": 5882.072, "timestamp": "01:38:02", "text": "我想念Roku。"}, {"type": "subtitle", "time": 5884.343, "timestamp": "01:38:04", "text": "用戶評價。這就像…"}, {"type": "subtitle", "time": 5886.983, "timestamp": "01:38:06", "text": "用戶評價。你覺得怎麼樣？"}, {"type": "subtitle", "time": 5892.451, "timestamp": "01:38:12", "text": "這個項目？我的意思是，這對……有好處嗎？"}, {"type": "subtitle", "time": 5895.092, "timestamp": "01:38:15", "text": "你覺得頭痛嗎？多少？"}, {"type": "subtitle", "time": 5897.182, "timestamp": "01:38:17", "text": "他有什麼問題？多少次"}, {"type": "subtitle", "time": 5901.159, "timestamp": "01:38:21", "text": "她在你的訊息裡哭了嗎？請把這個給我們"}, {"type": "subtitle", "time": 5901.733, "timestamp": "01:38:21", "text": "審查。"}, {"type": "subtitle", "time": 5903.995, "timestamp": "01:38:23", "text": "是的。"}, {"type": "subtitle", "time": 5909.629, "timestamp": "01:38:29", "text": "你是個好朋友。別擔心"}, {"type": "subtitle", "time": 5915.158, "timestamp": "01:38:35", "text": "那。聽到這個消息我很高興。出色的。"}, {"type": "subtitle", "time": 5920.147, "timestamp": "01:38:40", "text": "我還記得我初到日本時的情景。"}, {"type": "subtitle", "time": 5920.796, "timestamp": "01:38:40", "text": "我和…談過"}, {"type": "subtitle", "time": 5925.137, "timestamp": "01:38:45", "text": "是的，今年。"}, {"type": "subtitle", "time": 5931.626, "timestamp": "01:38:51", "text": "我立刻跟他講故事，"}]
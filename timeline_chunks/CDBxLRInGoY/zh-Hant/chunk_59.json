[{"type": "subtitle", "time": 3541.348, "timestamp": "00:59:01", "text": "這是一種上癮行為，對吧？如果你停下來"}, {"type": "subtitle", "time": 3543.447, "timestamp": "00:59:03", "text": "喝一杯酒，然後再喝一杯。"}, {"type": "subtitle", "time": 3544.201, "timestamp": "00:59:04", "text": "你還想要更多。"}, {"type": "subtitle", "time": 3547.618, "timestamp": "00:59:07", "text": "這就是這款遊戲對我的影響。"}, {"type": "subtitle", "time": 3550.345, "timestamp": "00:59:10", "text": "我找到了我們能玩的最好的遊戲"}, {"type": "subtitle", "time": 3551.047, "timestamp": "00:59:11", "text": "一起玩。"}, {"type": "subtitle", "time": 3553.141, "timestamp": "00:59:13", "text": "他們三個。"}, {"type": "subtitle", "time": 3553.952, "timestamp": "00:59:13", "text": "別說"}, {"type": "subtitle", "time": 3556.093, "timestamp": "00:59:16", "text": "鳥類遊戲三。"}, {"type": "subtitle", "time": 3559.065, "timestamp": "00:59:19", "text": "鳥類遊戲三"}, {"type": "subtitle", "time": 3562.236, "timestamp": "00:59:22", "text": "感覺就像我們只是在互相啄食一樣。"}, {"type": "subtitle", "time": 3568.024, "timestamp": "00:59:28", "text": "我們斷絕了聯繫。你是"}, {"type": "subtitle", "time": 3568.512, "timestamp": "00:59:28", "text": "鳥。"}, {"type": "subtitle", "time": 3574.718, "timestamp": "00:59:34", "text": "你對另一個發出「咔咔咔」的聲音。"}, {"type": "subtitle", "time": 3576.702, "timestamp": "00:59:36", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 3580.426, "timestamp": "00:59:40", "text": "讓我看看評價。"}, {"type": "subtitle", "time": 3584.301, "timestamp": "00:59:44", "text": "我們需要添加一些機器人之類的東西。"}, {"type": "subtitle", "time": 3586.027, "timestamp": "00:59:46", "text": "直到我們有更多玩家為止"}, {"type": "subtitle", "time": 3586.434, "timestamp": "00:59:46", "text": "真實的。"}, {"type": "subtitle", "time": 3590.269, "timestamp": "00:59:50", "text": "他"}, {"type": "subtitle", "time": 3596.808, "timestamp": "00:59:56", "text": "這就像是「你知道嗎？」我認為"}, {"type": "subtitle", "time": 3598.822, "timestamp": "00:59:58", "text": "看來我們只能玩毛步槍了。"}]
[{"type": "subtitle", "time": 2882.397, "timestamp": "00:48:02", "text": "我不打算玩。我們不會…我們不會 玩。"}, {"type": "subtitle", "time": 2883.038, "timestamp": "00:48:03", "text": "玩。 進入巔峰。"}, {"type": "subtitle", "time": 2888.172, "timestamp": "00:48:08", "text": "不，我現在不會下載。"}, {"type": "subtitle", "time": 2890.404, "timestamp": "00:48:10", "text": "我甚至無法控制自己。"}, {"type": "subtitle", "time": 2893.251, "timestamp": "00:48:13", "text": "你知道我現在在做什麼嗎？"}, {"type": "subtitle", "time": 2895.549, "timestamp": "00:48:15", "text": "同樣在這裡？你知道我在做什麼嗎？"}, {"type": "subtitle", "time": 2898.62, "timestamp": "00:48:18", "text": "現在？我躺著。我的"}, {"type": "subtitle", "time": 2900.611, "timestamp": "00:48:20", "text": "電腦在我頭頂上方，我"}, {"type": "subtitle", "time": 2903.302, "timestamp": "00:48:23", "text": "我在放鬆。讓我放鬆一下"}, {"type": "subtitle", "time": 2904.738, "timestamp": "00:48:24", "text": "在我跟你說話的時候。"}, {"type": "subtitle", "time": 2909.03, "timestamp": "00:48:29", "text": "如果你想玩《Peak》，你可以"}, {"type": "subtitle", "time": 2911.436, "timestamp": "00:48:31", "text": "應該早點說的。你知道，這只是"}, {"type": "subtitle", "time": 2913.705, "timestamp": "00:48:33", "text": "你做了這一切，我們才有了今天的成就。"}, {"type": "subtitle", "time": 2915.419, "timestamp": "00:48:35", "text": "是的，這是一個，這是一個…"}, {"type": "subtitle", "time": 2919.008, "timestamp": "00:48:39", "text": "確切地。這就是我這麼說的原因。"}, {"type": "subtitle", "time": 2920.584, "timestamp": "00:48:40", "text": "我們應該玩午夜換班遊戲"}, {"type": "subtitle", "time": 2922.794, "timestamp": "00:48:42", "text": "總有一天，你知道的。眨眼，眨眼。"}, {"type": "subtitle", "time": 2924.953, "timestamp": "00:48:44", "text": "拜託，夥計們。你不喜歡…"}, {"type": "subtitle", "time": 2934.513, "timestamp": "00:48:54", "text": "嚇了一跳？他們不喜歡嗎？不"}, {"type": "subtitle", "time": 2936.627, "timestamp": "00:48:56", "text": "恐慌。但我發不出聲。"}]
[{"type": "subtitle", "time": 4326.787, "timestamp": "01:12:06", "text": "感謝各位提供的GTA相關內容。"}, {"type": "subtitle", "time": 4332.033, "timestamp": "01:12:12", "text": "總之，事情就是這樣。這只是因為"}, {"type": "subtitle", "time": 4333.371, "timestamp": "01:12:13", "text": "老年人的童年。"}, {"type": "subtitle", "time": 4337.148, "timestamp": "01:12:17", "text": "朋友，那是懷舊。"}, {"type": "subtitle", "time": 4338.729, "timestamp": "01:12:18", "text": "是的。"}, {"type": "subtitle", "time": 4344.104, "timestamp": "01:12:24", "text": "就像每種遊戲類型一樣"}, {"type": "subtitle", "time": 4346.572, "timestamp": "01:12:26", "text": "《黑暗靈魂》喚起了人們的懷舊之情。對，就是這樣。"}, {"type": "subtitle", "time": 4347.839, "timestamp": "01:12:27", "text": "基本上所有東西。"}, {"type": "subtitle", "time": 4350.767, "timestamp": "01:12:30", "text": "我剛剛意識到，它是"}, {"type": "subtitle", "time": 4356.759, "timestamp": "01:12:36", "text": "簡直就是GTA 5。好吧。那"}, {"type": "subtitle", "time": 4358.154, "timestamp": "01:12:38", "text": "你會傳達沒有人有"}, {"type": "subtitle", "time": 4361.207, "timestamp": "01:12:41", "text": "之前播出過嗎？那場比賽。"}, {"type": "subtitle", "time": 4366.529, "timestamp": "01:12:46", "text": "我還沒嘗試過角色扮演遊戲。"}, {"type": "subtitle", "time": 4369.8, "timestamp": "01:12:49", "text": "角色扮演。我需要參與其中。去哪裡"}, {"type": "subtitle", "time": 4370.204, "timestamp": "01:12:50", "text": "你打算……？"}, {"type": "subtitle", "time": 4372.231, "timestamp": "01:12:52", "text": "不。"}, {"type": "subtitle", "time": 4374.184, "timestamp": "01:12:54", "text": "角色扮演遊戲。你不這樣做嗎？"}, {"type": "subtitle", "time": 4375.865, "timestamp": "01:12:55", "text": "現在在玩角色扮演遊戲嗎？我是誰？"}, {"type": "subtitle", "time": 4377.823, "timestamp": "01:12:57", "text": "正在做？不，我只是做我自己。"}, {"type": "subtitle", "time": 4379.808, "timestamp": "01:12:59", "text": "相同的。這就是問題所在。不能"}]
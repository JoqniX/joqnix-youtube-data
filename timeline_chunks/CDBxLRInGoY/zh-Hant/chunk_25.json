[{"type": "subtitle", "time": 1500.043, "timestamp": "00:25:00", "text": "其中一個來自Caster Labs，另外還有"}, {"type": "subtitle", "time": 1506.851, "timestamp": "00:25:06", "text": "這是我之前在 Cloudflare 上做的。然後"}, {"type": "subtitle", "time": 1511.03, "timestamp": "00:25:11", "text": "是的，花了20.24分鐘。"}, {"type": "subtitle", "time": 1515.981, "timestamp": "00:25:15", "text": "我把它怎麼處理了？嘿，就…"}, {"type": "subtitle", "time": 1522.448, "timestamp": "00:25:22", "text": "這個人是"}, {"type": "subtitle", "time": 1526.492, "timestamp": "00:25:26", "text": "這個人挺好的。這個人是"}, {"type": "subtitle", "time": 1527.766, "timestamp": "00:25:27", "text": "極好的。哇。"}, {"type": "subtitle", "time": 1530.383, "timestamp": "00:25:30", "text": "我身無分文，但我還是做了這件事。"}, {"type": "subtitle", "time": 1534.893, "timestamp": "00:25:34", "text": "每個窮小子都精力充沛"}, {"type": "subtitle", "time": 1540.958, "timestamp": "00:25:40", "text": "不知何故。太瘋狂了。哦是的，"}, {"type": "subtitle", "time": 1545.209, "timestamp": "00:25:45", "text": "挺好的。"}, {"type": "subtitle", "time": 1548.263, "timestamp": "00:25:48", "text": "是的，我總是忘記這件事。是的，"}, {"type": "subtitle", "time": 1549.646, "timestamp": "00:25:49", "text": "貧窮也挺好的。"}, {"type": "subtitle", "time": 1552.203, "timestamp": "00:25:52", "text": "不，貧窮並不好受。"}, {"type": "subtitle", "time": 1557.668, "timestamp": "00:25:57", "text": "不，不，不，不。我不是那個意思。 。我剛剛是說它不錯？是"}]
[{"type": "subtitle", "time": 4083.471, "timestamp": "01:08:03", "text": "就像Mac電腦一樣。"}, {"type": "subtitle", "time": 4088.456, "timestamp": "01:08:08", "text": "洛克人。你知道嗎？洛克人。"}, {"type": "subtitle", "time": 4091.688, "timestamp": "01:08:11", "text": "是的。是的。"}, {"type": "subtitle", "time": 4103.165, "timestamp": "01:08:23", "text": "像這樣。更別提這一點了。"}, {"type": "subtitle", "time": 4104.495, "timestamp": "01:08:24", "text": "這款遊戲將會推出續作。"}, {"type": "subtitle", "time": 4108.767, "timestamp": "01:08:28", "text": "瞧瞧重力！"}, {"type": "subtitle", "time": 4112.893, "timestamp": "01:08:32", "text": "是的，重力賽道也是。"}, {"type": "subtitle", "time": 4116.08, "timestamp": "01:08:36", "text": "哦，那相當不錯。"}, {"type": "subtitle", "time": 4125.274, "timestamp": "01:08:45", "text": "你大概看得出來那傢伙要…"}, {"type": "subtitle", "time": 4125.793, "timestamp": "01:08:45", "text": "播放它。"}, {"type": "subtitle", "time": 4129.435, "timestamp": "01:08:49", "text": "我希望他能做到。"}, {"type": "subtitle", "time": 4134.27, "timestamp": "01:08:54", "text": "是的。他還會再上場比賽，我們拭目以待。"}, {"type": "subtitle", "time": 4136.338, "timestamp": "01:08:56", "text": "我們會說：“嘿，放這個。”"}]
[{"type": "subtitle", "time": 3120.662, "timestamp": "00:52:00", "text": "是的。你玩過另一款遊戲嗎？"}, {"type": "subtitle", "time": 3122.558, "timestamp": "00:52:02", "text": "叫做「跟朋友打賭」？"}, {"type": "subtitle", "time": 3127.508, "timestamp": "00:52:07", "text": "和朋友們打賭。呃，就這麼簡單。"}, {"type": "subtitle", "time": 3130.856, "timestamp": "00:52:10", "text": "打賭？不，感覺不像，你知道嗎？"}, {"type": "subtitle", "time": 3135.274, "timestamp": "00:52:15", "text": "就是那個賭場追蹤器。是的。"}, {"type": "subtitle", "time": 3139.673, "timestamp": "00:52:19", "text": "是的。它給了我那種感覺。"}, {"type": "subtitle", "time": 3141.86, "timestamp": "00:52:21", "text": "有一款名為「機器」的新遊戲"}, {"type": "subtitle", "time": 3143.947, "timestamp": "00:52:23", "text": "派對“人們正在玩”。"}, {"type": "subtitle", "time": 3149.763, "timestamp": "00:52:29", "text": "啊，是的。是的。我看到了。我看到了。有一個"}, {"type": "subtitle", "time": 3150.853, "timestamp": "00:52:30", "text": "發射，呃"}, {"type": "subtitle", "time": 3151.316, "timestamp": "00:52:31", "text": "是的"}, {"type": "subtitle", "time": 3153.941, "timestamp": "00:52:33", "text": "目前正在進行目錄徵集活動。"}, {"type": "subtitle", "time": 3156.942, "timestamp": "00:52:36", "text": "真是太血腥了，不是嗎？"}, {"type": "subtitle", "time": 3158.53, "timestamp": "00:52:38", "text": "血。"}, {"type": "subtitle", "time": 3165.048, "timestamp": "00:52:45", "text": "是的。呃，那是什麼遊戲來著？ ？"}, {"type": "subtitle", "time": 3171.747, "timestamp": "00:52:51", "text": "巴克。是的，巴克肖特。我認為是"}, {"type": "subtitle", "time": 3173.928, "timestamp": "00:52:53", "text": "類似那樣，但是…就像"}, {"type": "subtitle", "time": 3176.825, "timestamp": "00:52:56", "text": "《瑪利歐派對》也是。你和你的"}, {"type": "subtitle", "time": 3178.87, "timestamp": "00:52:58", "text": "朋友，但只有我們三個。"}]
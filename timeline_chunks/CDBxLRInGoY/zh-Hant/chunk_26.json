[{"type": "subtitle", "time": 1562.124, "timestamp": "00:26:02", "text": "。我剛剛是說它不錯？是 貧窮也挺好的。在哪種類型中"}, {"type": "subtitle", "time": 1566.357, "timestamp": "00:26:06", "text": "貧窮也挺好的。在哪種類型中 你住在橋的哪個位置？"}, {"type": "subtitle", "time": 1573.36, "timestamp": "00:26:13", "text": "不，我不是那個意思。我想要"}, {"type": "subtitle", "time": 1576.167, "timestamp": "00:26:16", "text": "我的意思是，嗯，我的意思是，我是什麼意思？"}, {"type": "subtitle", "time": 1579.189, "timestamp": "00:26:19", "text": "我是什麼意思？我是什麼意思？嗯？"}, {"type": "subtitle", "time": 1584.41, "timestamp": "00:26:24", "text": "你知道，這種情況我們每個人都會遇到。"}, {"type": "subtitle", "time": 1586.692, "timestamp": "00:26:26", "text": "我們只是隨便說說而已。"}, {"type": "subtitle", "time": 1589.283, "timestamp": "00:26:29", "text": "完成句子。就這樣"}, {"type": "subtitle", "time": 1591.286, "timestamp": "00:26:31", "text": "這說明你詞彙量匱乏。"}, {"type": "subtitle", "time": 1596.432, "timestamp": "00:26:36", "text": "太完美了。詞彙？嗯，是的。"}, {"type": "subtitle", "time": 1599.603, "timestamp": "00:26:39", "text": "我的英語很差。所以我覺得很難"}, {"type": "subtitle", "time": 1600.496, "timestamp": "00:26:40", "text": "詞彙。"}, {"type": "subtitle", "time": 1604.948, "timestamp": "00:26:44", "text": "是的。誰的英語很好？ ？"}, {"type": "subtitle", "time": 1606.888, "timestamp": "00:26:46", "text": "是的。你"}, {"type": "subtitle", "time": 1609.919, "timestamp": "00:26:49", "text": "你會說英語，你呼吸的空氣裡都充滿了英語。"}, {"type": "subtitle", "time": 1612.097, "timestamp": "00:26:52", "text": "或許你會留下來。"}, {"type": "subtitle", "time": 1614.218, "timestamp": "00:26:54", "text": "他真是尤里這裡相當出色的年輕人。哦，"}, {"type": "subtitle", "time": 1614.882, "timestamp": "00:26:54", "text": "快點。"}, {"type": "subtitle", "time": 1616.662, "timestamp": "00:26:56", "text": "哦是的。是的。是的。"}, {"type": "subtitle", "time": 1618.879, "timestamp": "00:26:58", "text": "我們開著燈。海之血 。"}, {"type": "subtitle", "time": 1619.442, "timestamp": "00:26:59", "text": "。 哦是的。是的。他們都擅長"}]
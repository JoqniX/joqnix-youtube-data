[{"type": "subtitle", "time": 4621.249, "timestamp": "01:17:01", "text": "這幾乎是不可能的。所以，去做吧。"}, {"type": "subtitle", "time": 4623.158, "timestamp": "01:17:03", "text": "我以第二高的難度完成了比賽。"}, {"type": "subtitle", "time": 4633.025, "timestamp": "01:17:13", "text": "高的。是的。更別提，嗯哼，"}, {"type": "subtitle", "time": 4635.595, "timestamp": "01:17:15", "text": "我剛剛新建了一個文件，你知道嗎？"}, {"type": "subtitle", "time": 4638.23, "timestamp": "01:17:18", "text": "我根本沒做那件事。我認為"}, {"type": "subtitle", "time": 4643.368, "timestamp": "01:17:23", "text": "我應該這麼做。目的"}, {"type": "subtitle", "time": 4645.132, "timestamp": "01:17:25", "text": "遊戲玩法就是不斷死亡，然後不斷進步。"}, {"type": "subtitle", "time": 4652.866, "timestamp": "01:17:32", "text": "過程。所以，是的，提到這一點。"}, {"type": "subtitle", "time": 4655.191, "timestamp": "01:17:35", "text": "《哈迪斯2》比《哈迪斯2》難得多。"}, {"type": "subtitle", "time": 4657.395, "timestamp": "01:17:37", "text": "首先，就我所見，還有更多"}, {"type": "subtitle", "time": 4662.509, "timestamp": "01:17:42", "text": "難的。或者正如我喜歡稱呼它的那樣，"}, {"type": "subtitle", "time": 4664.349, "timestamp": "01:17:44", "text": "它比…多了很多愚蠢的東西"}, {"type": "subtitle", "time": 4677.323, "timestamp": "01:17:57", "text": "上一場比賽。嗯哼。是的，我希望如此。"}, {"type": "subtitle", "time": 4679.842, "timestamp": "01:17:59", "text": "我很期待和你一起玩《漫威宿敵》。"}]
[{"type": "subtitle", "time": 3181.352, "timestamp": "00:53:01", "text": "我們需要四個。還有誰能"}, {"type": "subtitle", "time": 3188.865, "timestamp": "00:53:08", "text": "想加入嗎？你認識這樣的人嗎？呃，喲，喲"}, {"type": "subtitle", "time": 3190.695, "timestamp": "00:53:10", "text": "我想把V帶到這裡。"}, {"type": "subtitle", "time": 3199.757, "timestamp": "00:53:19", "text": "你的電腦處理不了。您的電腦沒有"}, {"type": "subtitle", "time": 3200.224, "timestamp": "00:53:20", "text": "能"}, {"type": "subtitle", "time": 3203.852, "timestamp": "00:53:23", "text": "連Buckshot的多人遊戲都做不到"}, {"type": "subtitle", "time": 3204.358, "timestamp": "00:53:24", "text": "輪盤賭。"}, {"type": "subtitle", "time": 3206.471, "timestamp": "00:53:26", "text": "是的，"}, {"type": "subtitle", "time": 3221.264, "timestamp": "00:53:41", "text": "他的電腦配置最高。你覺得"}, {"type": "subtitle", "time": 3223.541, "timestamp": "00:53:43", "text": "那個“星體”，你知道那他媽的是什麼嗎？"}, {"type": "subtitle", "time": 3224.616, "timestamp": "00:53:44", "text": "什麼是派對動物？"}, {"type": "subtitle", "time": 3228.388, "timestamp": "00:53:48", "text": "跟他們一起玩，對吧？"}, {"type": "subtitle", "time": 3231.939, "timestamp": "00:53:51", "text": "現在他不能出去參加派對了，現在他不能了"}, {"type": "subtitle", "time": 3232.288, "timestamp": "00:53:52", "text": "能"}, {"type": "subtitle", "time": 3234.889, "timestamp": "00:53:54", "text": "因為它長得更多了。"}, {"type": "subtitle", "time": 3238.297, "timestamp": "00:53:58", "text": "是的，它長大了，現在它擁有更多了。"}]
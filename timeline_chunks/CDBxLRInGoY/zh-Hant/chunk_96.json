[{"type": "subtitle", "time": 5760.878, "timestamp": "01:36:00", "text": "哦是的。"}, {"type": "subtitle", "time": 5769.187, "timestamp": "01:36:09", "text": "我正在玩遊戲。我只是在開玩笑。你是"}, {"type": "subtitle", "time": 5776.55, "timestamp": "01:36:16", "text": "好朋友，喬。你是認真的？"}, {"type": "subtitle", "time": 5782.145, "timestamp": "01:36:22", "text": "好的。我是認真的。是的。是的。是的。"}, {"type": "subtitle", "time": 5784.557, "timestamp": "01:36:24", "text": "是的。是的。你無需懷疑自己。"}, {"type": "subtitle", "time": 5784.934, "timestamp": "01:36:24", "text": "相同的。"}, {"type": "subtitle", "time": 5786.059, "timestamp": "01:36:26", "text": "好的。"}, {"type": "subtitle", "time": 5792.408, "timestamp": "01:36:32", "text": "是的。"}, {"type": "subtitle", "time": 5795.382, "timestamp": "01:36:35", "text": "這就是你想知道的全部。那"}, {"type": "subtitle", "time": 5795.967, "timestamp": "01:36:35", "text": "就這樣。"}, {"type": "subtitle", "time": 5796.432, "timestamp": "01:36:36", "text": "不。"}, {"type": "subtitle", "time": 5797.919, "timestamp": "01:36:37", "text": "你不需要別人的意見。"}, {"type": "subtitle", "time": 5800.157, "timestamp": "01:36:40", "text": "是的。是的。我需要一些意見。"}, {"type": "subtitle", "time": 5803.737, "timestamp": "01:36:43", "text": "不，不再是這樣了。不再。不，"}, {"type": "subtitle", "time": 5806.172, "timestamp": "01:36:46", "text": "我本來想說"}]
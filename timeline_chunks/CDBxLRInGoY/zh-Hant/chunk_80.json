[{"type": "subtitle", "time": 4802.725, "timestamp": "01:20:02", "text": "。猜猜看，猜猜我們的個性是怎麼樣的？ 你可以在《漫威宿敵》中扮演他。"}, {"type": "subtitle", "time": 4805.235, "timestamp": "01:20:05", "text": "你可以在《漫威宿敵》中扮演他。 或者她。快點。你想讓誰上場？"}, {"type": "subtitle", "time": 4808.975, "timestamp": "01:20:08", "text": "或者她。快點。你想讓誰上場？ ？"}, {"type": "subtitle", "time": 4819.06, "timestamp": "01:20:19", "text": "呃，我不知道。我不知道。"}, {"type": "subtitle", "time": 4827.722, "timestamp": "01:20:27", "text": "快點。你認為我死了嗎？ 有人嗎？有人想玩嗎？"}, {"type": "subtitle", "time": 4832.375, "timestamp": "01:20:32", "text": "有人嗎？有人想玩嗎？ 你以前沒玩過英雄射擊遊戲嗎？"}, {"type": "subtitle", "time": 4844.203, "timestamp": "01:20:44", "text": "哦，它藏起來了。"}, {"type": "subtitle", "time": 4847.805, "timestamp": "01:20:47", "text": "他藏著秘密。折斷"}, {"type": "subtitle", "time": 4851.422, "timestamp": "01:20:51", "text": "他們背著我們做著秘密的事情"}, {"type": "subtitle", "time": 4856.172, "timestamp": "01:20:56", "text": "相機。好吧。"}, {"type": "subtitle", "time": 4857.054, "timestamp": "01:20:57", "text": "我進入了"}]
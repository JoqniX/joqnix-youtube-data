[{"type": "subtitle", "time": 3601.426, "timestamp": "01:00:01", "text": "我想我們就玩這個遊戲吧。不再"}, {"type": "subtitle", "time": 3604.438, "timestamp": "01:00:04", "text": "夥計們，給喬布多出點主意吧。不再"}, {"type": "subtitle", "time": 3605.754, "timestamp": "01:00:05", "text": "給喬更多建議。"}, {"type": "subtitle", "time": 3611.849, "timestamp": "01:00:11", "text": "是的。呃，你最近在玩什麼抽卡遊戲？"}, {"type": "subtitle", "time": 3613.111, "timestamp": "01:00:13", "text": "最近玩過嗎？"}, {"type": "subtitle", "time": 3617.857, "timestamp": "01:00:17", "text": "哦，當然。扭蛋遊戲。這"}, {"type": "subtitle", "time": 3622.889, "timestamp": "01:00:22", "text": "我的人生徹底毀了。原因何在"}, {"type": "subtitle", "time": 3624.754, "timestamp": "01:00:24", "text": "我生活中一直在做著各種事情。"}, {"type": "subtitle", "time": 3629.651, "timestamp": "01:00:29", "text": "唯一，我人生唯一是"}, {"type": "subtitle", "time": 3630.17, "timestamp": "01:00:30", "text": "可重複。"}, {"type": "subtitle", "time": 3637.299, "timestamp": "01:00:37", "text": "我確實努力過"}, {"type": "subtitle", "time": 3641.735, "timestamp": "01:00:41", "text": "我一直積極參與遊戲，只是因為…才停止的。"}, {"type": "subtitle", "time": 3645.111, "timestamp": "01:00:45", "text": "賽博朋克那一套。我玩了，而且"}, {"type": "subtitle", "time": 3647.873, "timestamp": "01:00:47", "text": "我停下來了，正在下載。它"}, {"type": "subtitle", "time": 3649.649, "timestamp": "01:00:49", "text": "我又下載了一遍，只是為了獲取"}, {"type": "subtitle", "time": 3651.099, "timestamp": "01:00:51", "text": "在遊戲中搶到我的蛋糕。"}, {"type": "subtitle", "time": 3655.619, "timestamp": "01:00:55", "text": "我打算下載原神。"}]
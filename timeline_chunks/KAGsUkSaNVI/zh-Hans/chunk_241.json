[{"type": "subtitle", "time": 14461.75, "timestamp": "04:01:01", "text": "每个人都走了一半。阻止他们。"}, {"type": "subtitle", "time": 14483.67, "timestamp": "04:01:23", "text": "我的天啊。"}, {"type": "subtitle", "time": 14486.55, "timestamp": "04:01:26", "text": "那真是一次漂亮的关键球。我的天啊。准备好"}, {"type": "subtitle", "time": 14510.55, "timestamp": "04:01:50", "text": "我不是个记仇的人，但今天"}]
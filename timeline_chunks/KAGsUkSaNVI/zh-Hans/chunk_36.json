[{"type": "subtitle", "time": 2160.71, "timestamp": "00:36:00", "text": "我的天啊。出口。是的，实际上呃"}, {"type": "subtitle", "time": 2163.19, "timestamp": "00:36:03", "text": "哪个更好？无论我是什么"}, {"type": "subtitle", "time": 2164.71, "timestamp": "00:36:04", "text": "玩耍"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "在后面的房间里。逃离"}, {"type": "subtitle", "time": 2169.67, "timestamp": "00:36:09", "text": "浴室的图形效果似乎有所提升。"}, {"type": "subtitle", "time": 2172.79, "timestamp": "00:36:12", "text": "呃，逃脱的好处在于"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "后面的房间里没有安全空间。"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "显然，他们的接待大厅是一个安全空间。"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "这里，但在逃脱后房间"}, {"type": "subtitle", "time": 2182.39, "timestamp": "00:36:22", "text": "你那里有一个实体已经准备好了"}, {"type": "subtitle", "time": 2185.829, "timestamp": "00:36:25", "text": "杀了你。事情就是这样。"}, {"type": "subtitle", "time": 2187.069, "timestamp": "00:36:27", "text": "所以，"}, {"type": "subtitle", "time": 2191.109, "timestamp": "00:36:31", "text": "主持人是杰奎·尼克先生。是的，我即将发布"}, {"type": "subtitle", "time": 2191.87, "timestamp": "00:36:31", "text": "这"}, {"type": "subtitle", "time": 2196.55, "timestamp": "00:36:36", "text": "G. 我为什么会打开反恐精英？"}, {"type": "subtitle", "time": 2199.349, "timestamp": "00:36:39", "text": "尼克先生，请您停止玩游戏好吗？"}, {"type": "subtitle", "time": 2202.43, "timestamp": "00:36:42", "text": "反恐精英？不，不"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "不。我不小心打开了，对不起。"}, {"type": "subtitle", "time": 2215.91, "timestamp": "00:36:55", "text": "别人能听到你说话吗？"}, {"type": "subtitle", "time": 2219.109, "timestamp": "00:36:59", "text": "你会说话吗？你好。你好。你好。"}]
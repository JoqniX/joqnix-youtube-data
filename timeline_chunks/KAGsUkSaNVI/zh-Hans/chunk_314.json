[{"type": "subtitle", "time": 18841.91, "timestamp": "05:14:01", "text": "别走。"}, {"type": "subtitle", "time": 18844.31, "timestamp": "05:14:04", "text": "我在这片太空找到了一个家，而且"}, {"type": "subtitle", "time": 18845.83, "timestamp": "05:14:05", "text": "我会不惜一切代价留住他们。"}, {"type": "subtitle", "time": 18848.07, "timestamp": "05:14:08", "text": "安全的。"}, {"type": "subtitle", "time": 18850.47, "timestamp": "05:14:10", "text": "你只有一份工作。尽可能多地击倒"}, {"type": "subtitle", "time": 18876.55, "timestamp": "05:14:36", "text": "我的天啊。击拳。不。某种程度上。"}, {"type": "subtitle", "time": 18897.15, "timestamp": "05:14:57", "text": "正确的？哦，那是我的"}]
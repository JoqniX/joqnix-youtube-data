[{"type": "subtitle", "time": 4921.03, "timestamp": "01:22:01", "text": "打。拉屎。"}, {"type": "subtitle", "time": 4923.59, "timestamp": "01:22:03", "text": "我疯了。稍等片刻。是的。"}, {"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "它们很好。"}, {"type": "subtitle", "time": 4928.95, "timestamp": "01:22:08", "text": "啊，来了。你可以把它隐藏起来。你不能"}, {"type": "subtitle", "time": 4931.31, "timestamp": "01:22:11", "text": "抓住我。你抓不到"}, {"type": "subtitle", "time": 4933.79, "timestamp": "01:22:13", "text": "我。你抓不到我"}, {"type": "subtitle", "time": 4937.11, "timestamp": "01:22:17", "text": "现在。你亲眼看到我陷入那种境地了。"}, {"type": "subtitle", "time": 4939.55, "timestamp": "01:22:19", "text": "那该怎么称呼呢？"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "使用“确定”。我需要用两次吗？"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "某物？我不需要。好的，请"}, {"type": "subtitle", "time": 4958.149, "timestamp": "01:22:38", "text": "稍等一下。杏仁。杏仁水。"}, {"type": "subtitle", "time": 4963.75, "timestamp": "01:22:43", "text": "是的。好的。温暖舒适。好的。"}, {"type": "subtitle", "time": 4966.149, "timestamp": "01:22:46", "text": "他还在那儿吗？我不"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "我认为他是。"}, {"type": "subtitle", "time": 4970.83, "timestamp": "01:22:50", "text": "没关系。"}]
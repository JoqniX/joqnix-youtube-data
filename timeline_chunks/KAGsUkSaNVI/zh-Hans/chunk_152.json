[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "别想把我打倒太久。那是"}, {"type": "subtitle", "time": 9148.63, "timestamp": "02:32:28", "text": "我想我应该是快乐的吧。"}, {"type": "subtitle", "time": 9150.309, "timestamp": "02:32:30", "text": "无法承受。我正在寻找其中一个"}, {"type": "subtitle", "time": 9160.07, "timestamp": "02:32:40", "text": "你以为你骗不了我。别招惹"}, {"type": "subtitle", "time": 9161.59, "timestamp": "02:32:41", "text": "蜘蛛。"}]
[{"type": "subtitle", "time": 17832.27, "timestamp": "04:57:12", "text": "六。"}, {"type": "subtitle", "time": 17837.99, "timestamp": "04:57:17", "text": "呃，娜娜九岁了。呃，八号今年八岁。"}, {"type": "subtitle", "time": 17841.868, "timestamp": "04:57:21", "text": "Seven 就是 Roku。"}, {"type": "subtitle", "time": 17844.28, "timestamp": "04:57:24", "text": "Roku。 八。八。"}, {"type": "subtitle", "time": 17847.08, "timestamp": "04:57:27", "text": "八。八。 娜娜。等待。网球。等待。"}, {"type": "subtitle", "time": 17852.0, "timestamp": "04:57:32", "text": "娜娜。等待。网球。等待。 你们在等吗？现在是10，所以呢？"}, {"type": "subtitle", "time": 17856.04, "timestamp": "04:57:36", "text": "你们在等吗？现在是10，所以呢？ 是七，然后娜娜等娜娜是"}, {"type": "subtitle", "time": 17859.798, "timestamp": "04:57:39", "text": "是七，然后娜娜等娜娜是 七"}, {"type": "subtitle", "time": 17861.718, "timestamp": "04:57:41", "text": "七 哈蒂"}, {"type": "subtitle", "time": 17863.798, "timestamp": "04:57:43", "text": "哈蒂 等等，nan是什么？然后等等，n听起来像什么？"}, {"type": "subtitle", "time": 17868.28, "timestamp": "04:57:48", "text": "等等，nan是什么？然后等等，n听起来像什么？ 哈娜不是汉娜"}, {"type": "subtitle", "time": 17871.16, "timestamp": "04:57:51", "text": "哈娜不是汉娜 我是娜娜"}, {"type": "subtitle", "time": 17874.28, "timestamp": "04:57:54", "text": "我是娜娜 15日"}]
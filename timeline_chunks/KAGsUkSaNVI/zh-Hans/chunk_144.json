[{"type": "subtitle", "time": 8644.309, "timestamp": "02:24:04", "text": "总得有人守护银河系。可能"}, {"type": "subtitle", "time": 8676.07, "timestamp": "02:24:36", "text": "我在这片太空找到了一个家，而且"}, {"type": "subtitle", "time": 8677.67, "timestamp": "02:24:37", "text": "我会不惜一切代价留住他们。"}, {"type": "subtitle", "time": 8679.59, "timestamp": "02:24:39", "text": "安全的。"}, {"type": "subtitle", "time": 8683.75, "timestamp": "02:24:43", "text": "攻击前30秒。准备。"}, {"type": "subtitle", "time": 8688.309, "timestamp": "02:24:48", "text": "轮到我了。现在，“星爵”是他的头衔吗？"}]
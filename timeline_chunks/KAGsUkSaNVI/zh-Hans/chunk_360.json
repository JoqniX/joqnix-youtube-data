[{"type": "subtitle", "time": 21607.91, "timestamp": "06:00:07", "text": "升级。操，兄弟。"}, {"type": "subtitle", "time": 21610.19, "timestamp": "06:00:10", "text": "好的，我把它们做得超级棒"}, {"type": "subtitle", "time": 21623.39, "timestamp": "06:00:23", "text": "我。我应该"}, {"type": "subtitle", "time": 21654.67, "timestamp": "06:00:54", "text": "兄弟。他一击即中"}, {"type": "subtitle", "time": 21659.39, "timestamp": "06:00:59", "text": "我。等等，这太难了。好的，全力以赴"}]
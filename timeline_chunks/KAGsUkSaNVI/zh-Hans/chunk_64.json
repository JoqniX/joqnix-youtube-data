[{"type": "subtitle", "time": 3844.19, "timestamp": "01:04:04", "text": "得到"}, {"type": "subtitle", "time": 3848.309, "timestamp": "01:04:08", "text": "它。然后是内森·艾伦。好了，我们走吧。"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "你很厉害。我喜欢我们一起玩耍的时候"}, {"type": "subtitle", "time": 3852.23, "timestamp": "01:04:12", "text": "和大约20个人一起。你"}, {"type": "subtitle", "time": 3854.309, "timestamp": "01:04:14", "text": "杰夫，你还记得吗？"}, {"type": "subtitle", "time": 3855.63, "timestamp": "01:04:15", "text": "哦，"}, {"type": "subtitle", "time": 3859.029, "timestamp": "01:04:19", "text": "是的。你记得好像曾经有过……"}, {"type": "subtitle", "time": 3861.91, "timestamp": "01:04:21", "text": "这里就像终极多人游戏一样。等待，"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "呃呃，焦虑药，那个令人毛骨悚然的呃呃家伙"}, {"type": "subtitle", "time": 3877.99, "timestamp": "01:04:37", "text": "确实就像那里一样。是的，他已经结束了。"}, {"type": "subtitle", "time": 3881.029, "timestamp": "01:04:41", "text": "那里。所以，呃，你还记得吗？好的，我们"}, {"type": "subtitle", "time": 3881.87, "timestamp": "01:04:41", "text": "去"}, {"type": "subtitle", "time": 3884.63, "timestamp": "01:04:44", "text": "径直走向尸体所在的门口。"}, {"type": "subtitle", "time": 3891.51, "timestamp": "01:04:51", "text": "尸体在哪儿来着？我认为是"}, {"type": "subtitle", "time": 3894.71, "timestamp": "01:04:54", "text": "就像直的之类的。好的，我是"}, {"type": "subtitle", "time": 3897.109, "timestamp": "01:04:57", "text": "保持。稍等片刻。不要离开"}]
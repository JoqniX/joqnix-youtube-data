[{"type": "subtitle", "time": 12576.51, "timestamp": "03:29:36", "text": "治愈问号。治愈问号。"}, {"type": "subtitle", "time": 12579.429, "timestamp": "03:29:39", "text": "你好。愈合。问号。在哪里？愈合。"}, {"type": "subtitle", "time": 12587.429, "timestamp": "03:29:47", "text": "我应该扮演另一个角色。不能"}, {"type": "subtitle", "time": 12589.19, "timestamp": "03:29:49", "text": "让我长时间保持低落。遗忘将"}]
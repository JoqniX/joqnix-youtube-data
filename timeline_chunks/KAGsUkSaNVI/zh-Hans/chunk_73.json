[{"type": "subtitle", "time": 4383.669, "timestamp": "01:13:03", "text": "死了。你是怎么死的？对，就是那根电缆"}, {"type": "subtitle", "time": 4388.229, "timestamp": "01:13:08", "text": "那家伙把我弄伤了。他吓了一跳。啊，我"}, {"type": "subtitle", "time": 4389.95, "timestamp": "01:13:09", "text": "复活了。它是"}, {"type": "subtitle", "time": 4392.95, "timestamp": "01:13:12", "text": "美好的。他还在吗？我只是"}, {"type": "subtitle", "time": 4396.07, "timestamp": "01:13:16", "text": "嘲讽那家伙。"}, {"type": "subtitle", "time": 4402.27, "timestamp": "01:13:22", "text": "这里？好的。是的，我正在……我正在……"}, {"type": "subtitle", "time": 4406.07, "timestamp": "01:13:26", "text": "药片。谢谢你，兄弟。你在哪里？"}, {"type": "subtitle", "time": 4407.95, "timestamp": "01:13:27", "text": "我只是在嘲讽他"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "男。这就是可以嘲讽的对象："}, {"type": "subtitle", "time": 4415.51, "timestamp": "01:13:35", "text": "但你到底在哪里？哦，我是"}, {"type": "subtitle", "time": 4419.03, "timestamp": "01:13:39", "text": "就在这里。"}, {"type": "subtitle", "time": 4422.07, "timestamp": "01:13:42", "text": "我不知道K是在哪里被枪击的。"}, {"type": "subtitle", "time": 4424.229, "timestamp": "01:13:44", "text": "好的。我在大厅里。我在"}, {"type": "subtitle", "time": 4426.79, "timestamp": "01:13:46", "text": "门。我打开了门。我的天啊，那真是太……"}, {"type": "subtitle", "time": 4429.59, "timestamp": "01:13:49", "text": "乐趣。好的。是的。等待。未来。我是"}, {"type": "subtitle", "time": 4431.43, "timestamp": "01:13:51", "text": "未来。"}, {"type": "subtitle", "time": 4434.63, "timestamp": "01:13:54", "text": "总之，我会找到你的。"}, {"type": "subtitle", "time": 4438.79, "timestamp": "01:13:58", "text": "我离门口很近。我到门口了。"}]
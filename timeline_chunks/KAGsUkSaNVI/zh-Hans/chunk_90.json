[{"type": "subtitle", "time": 5401.11, "timestamp": "01:30:01", "text": "我没有导航设备。"}, {"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "好的。脚应该放在这里。"}, {"type": "subtitle", "time": 5406.35, "timestamp": "01:30:06", "text": "发送。好的。"}, {"type": "subtitle", "time": 5409.229, "timestamp": "01:30:09", "text": "好的。乔纳森需要"}, {"type": "subtitle", "time": 5413.83, "timestamp": "01:30:13", "text": "脚。脚。"}, {"type": "subtitle", "time": 5417.35, "timestamp": "01:30:17", "text": "是的。镜子碎了。哦，真可怕"}, {"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "面孔。是啊，那边有些诡异的面孔。"}, {"type": "subtitle", "time": 5424.31, "timestamp": "01:30:24", "text": "好的。我有什么？我有什么？我"}, {"type": "subtitle", "time": 5428.39, "timestamp": "01:30:28", "text": "帮帮忙。好的。我有一个鼻子和一个"}, {"type": "subtitle", "time": 5435.51, "timestamp": "01:30:35", "text": "别看。"}, {"type": "subtitle", "time": 5438.629, "timestamp": "01:30:38", "text": "我在那里吗？我就像在看着它一样。"}, {"type": "subtitle", "time": 5442.709, "timestamp": "01:30:42", "text": "公司还没倒闭。"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "它不见了。它不见了。它不见了。"}, {"type": "subtitle", "time": 5447.99, "timestamp": "01:30:47", "text": "我跑步时带了一瓶杏仁水。"}, {"type": "subtitle", "time": 5449.75, "timestamp": "01:30:49", "text": "两杯Hello Lemonade。你好吗？"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "每天都过得很顺利。"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "所以，我们需要找到镜子。"}, {"type": "subtitle", "time": 5459.189, "timestamp": "01:30:59", "text": "尽管。不。哦，真的吗？是的。破碎"}]
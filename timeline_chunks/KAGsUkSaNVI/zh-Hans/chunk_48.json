[{"type": "subtitle", "time": 2880.23, "timestamp": "00:48:00", "text": "鼠标灵敏度过高。"}, {"type": "subtitle", "time": 2883.75, "timestamp": "00:48:03", "text": "你们这里能买到手电筒吗？哦，你"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "可以观察你的耐力。我，我接受"}, {"type": "subtitle", "time": 2892.19, "timestamp": "00:48:12", "text": "手电筒"}, {"type": "subtitle", "time": 2896.95, "timestamp": "00:48:16", "text": "当时钟也能够计时的时候。好的。我 我 我"}, {"type": "subtitle", "time": 2898.71, "timestamp": "00:48:18", "text": "仍然不知道该如何喜欢这个人物"}, {"type": "subtitle", "time": 2901.27, "timestamp": "00:48:21", "text": "关于这些，因为没有人……"}, {"type": "subtitle", "time": 2902.95, "timestamp": "00:48:22", "text": "设法找到了这张照片"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "证明了侵略性的危险性，但"}, {"type": "subtitle", "time": 2923.43, "timestamp": "00:48:43", "text": "也受噪音影响，并被直接的……吓到"}, {"type": "subtitle", "time": 2926.71, "timestamp": "00:48:46", "text": "它被直接图标吓到了。不是，而是"}, {"type": "subtitle", "time": 2929.51, "timestamp": "00:48:49", "text": "你只要看一眼它，就会被它杀死。"}, {"type": "subtitle", "time": 2931.67, "timestamp": "00:48:51", "text": "所以当你面对面地看着它时……"}, {"type": "subtitle", "time": 2934.549, "timestamp": "00:48:54", "text": "聪明点，试试看，有时候需要跑。"}, {"type": "subtitle", "time": 2936.95, "timestamp": "00:48:56", "text": "这样做并没有什么帮助。我们有"}, {"type": "subtitle", "time": 2939.91, "timestamp": "00:48:59", "text": "喜欢保持静止？所以这意味着我们"}]
[{"type": "subtitle", "time": 13387.59, "timestamp": "03:43:07", "text": "月亮萦绕着你。我的天哪，月亮"}, {"type": "subtitle", "time": 13400.11, "timestamp": "03:43:20", "text": "这款游戏是"}, {"type": "subtitle", "time": 13402.71, "timestamp": "03:43:22", "text": "难的。我玩得越多，得到的就越多。"}, {"type": "subtitle", "time": 13425.51, "timestamp": "03:43:45", "text": "这样就可以了。"}, {"type": "subtitle", "time": 13432.469, "timestamp": "03:43:52", "text": "你必须坚持战斗，直到我们"}]
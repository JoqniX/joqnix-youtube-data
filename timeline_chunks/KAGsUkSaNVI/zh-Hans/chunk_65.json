[{"type": "subtitle", "time": 3906.39, "timestamp": "01:05:06", "text": "好的。这里为什么没有尸体？"}, {"type": "subtitle", "time": 3908.789, "timestamp": "01:05:08", "text": "等等，这里不是我们要去的地方吗？这是"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "顺便说一句，不是那个地方。"}, {"type": "subtitle", "time": 3914.309, "timestamp": "01:05:14", "text": "你听到了吗？"}, {"type": "subtitle", "time": 3928.63, "timestamp": "01:05:28", "text": "我们真的吗？哦。哦，是的。眼球。我们得到了一个"}, {"type": "subtitle", "time": 3941.27, "timestamp": "01:05:41", "text": "好的。那么，这个地方究竟在哪里呢？"}, {"type": "chat", "time": 3942.212, "timestamp": "01:05:42", "author": "@IzumiIzu", "avatar": "https://yt4.ggpht.com/SHqyZzaYrIQLj32Wpl-K1gIv-ExIiNBC_Ht7FB5JHXGyDJeL_7dou322O73N-N6FnAtDsp0isQ=s64-c-k-c0x00ffffff-no-rj", "message": "cheeizu raiddd"}, {"type": "subtitle", "time": 3944.39, "timestamp": "01:05:44", "text": "我忘了这里是辐射治疗室。"}, {"type": "subtitle", "time": 3946.23, "timestamp": "01:05:46", "text": "是的，这里就是你需要的地方"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "就像得到一份西装革履的工作一样。是的。是的，"}, {"type": "subtitle", "time": 3951.589, "timestamp": "01:05:51", "text": "我就在你身后。等等，你们在哪儿？"}, {"type": "subtitle", "time": 3959.75, "timestamp": "01:05:59", "text": "你？哦好的。你好。事情就是这样。"}]
[{"type": "subtitle", "time": 4323.35, "timestamp": "01:12:03", "text": "[音乐]"}, {"type": "subtitle", "time": 4326.47, "timestamp": "01:12:06", "text": "哦，是的。好的。所以，我们就来到这里了。我们开始吧"}, {"type": "subtitle", "time": 4335.35, "timestamp": "01:12:15", "text": "我喜欢这只狗狗，它不喜欢做爱。"}, {"type": "subtitle", "time": 4337.75, "timestamp": "01:12:17", "text": "警告、尖叫或其他什么声音。确实如此。"}, {"type": "subtitle", "time": 4340.51, "timestamp": "01:12:20", "text": "没有什么。他看起来就像"}, {"type": "subtitle", "time": 4344.87, "timestamp": "01:12:24", "text": "是的。我认为我们可以走这条路。"}, {"type": "subtitle", "time": 4348.149, "timestamp": "01:12:28", "text": "哦，是有线电视安装工。有线电视安装工。"}, {"type": "subtitle", "time": 4352.87, "timestamp": "01:12:32", "text": "跑步。啊。我的天啊。哦，你得跑了。"}, {"type": "subtitle", "time": 4356.55, "timestamp": "01:12:36", "text": "是的。哦，我的天啊。我的意思是，你不会"}, {"type": "subtitle", "time": 4358.79, "timestamp": "01:12:38", "text": "需要跑。你仍然可以保持静止，"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "也。哦，那样也行。不，不，不"}, {"type": "subtitle", "time": 4364.55, "timestamp": "01:12:44", "text": "不。它会杀人。它会杀人。它，它会杀人。"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "实际上。"}, {"type": "subtitle", "time": 4368.07, "timestamp": "01:12:48", "text": "你快要死了吗？"}, {"type": "subtitle", "time": 4374.31, "timestamp": "01:12:54", "text": "好的。好的。存货。存货。"}, {"type": "subtitle", "time": 4379.99, "timestamp": "01:12:59", "text": "存货。杏仁水。啊，你死了。我"}]
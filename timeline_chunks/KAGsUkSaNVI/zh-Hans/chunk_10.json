[{"type": "subtitle", "time": 600.75, "timestamp": "00:10:00", "text": "毕业什么的。"}, {"type": "subtitle", "time": 603.91, "timestamp": "00:10:03", "text": "嗯，是的，我还会在这里。我们可以"}, {"type": "subtitle", "time": 605.829, "timestamp": "00:10:05", "text": "仍然合作，我想合作的人"}, {"type": "subtitle", "time": 607.389, "timestamp": "00:10:07", "text": "合作"}, {"type": "subtitle", "time": 608.99, "timestamp": "00:10:08", "text": "和，"}, {"type": "subtitle", "time": 612.75, "timestamp": "00:10:12", "text": "一切。所以，我会这么做。"}, {"type": "subtitle", "time": 617.23, "timestamp": "00:10:17", "text": "五月。我看着我的"}, {"type": "subtitle", "time": 620.829, "timestamp": "00:10:20", "text": "最好的。我刚醒"}, {"type": "subtitle", "time": 623.949, "timestamp": "00:10:23", "text": "向上。是的。"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "嗯，今天的计划是进行枯萎处理。"}, {"type": "subtitle", "time": 631.35, "timestamp": "00:10:31", "text": "波浪和外阴。嗯，Mua 和嗯"}, {"type": "subtitle", "time": 633.11, "timestamp": "00:10:33", "text": "首先我们来玩漫威驱动。我们拭目以待。"}, {"type": "subtitle", "time": 636.23, "timestamp": "00:10:36", "text": "目前来看，它是否有效尚待观察。呃，为了"}, {"type": "subtitle", "time": 639.19, "timestamp": "00:10:39", "text": "如果我可以上传它，也可以不上传它，如果"}, {"type": "subtitle", "time": 640.829, "timestamp": "00:10:40", "text": "我会玩这个游戏。"}, {"type": "subtitle", "time": 643.47, "timestamp": "00:10:43", "text": "东西。那是我会做的事。"}, {"type": "subtitle", "time": 647.19, "timestamp": "00:10:47", "text": "查看。如果不行，呃，那还是"}, {"type": "subtitle", "time": 650.35, "timestamp": "00:10:50", "text": "卡顿等等。然后我想称之为"}, {"type": "subtitle", "time": 653.389, "timestamp": "00:10:53", "text": "退出。没关系。"}, {"type": "subtitle", "time": 657.47, "timestamp": "00:10:57", "text": "嗯，是的，这是其中一点。"}, {"type": "subtitle", "time": 659.55, "timestamp": "00:10:59", "text": "等等"}]
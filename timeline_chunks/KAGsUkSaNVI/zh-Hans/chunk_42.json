[{"type": "subtitle", "time": 2520.589, "timestamp": "00:42:00", "text": "不知道你为什么像在锻造一样。"}, {"type": "subtitle", "time": 2524.63, "timestamp": "00:42:04", "text": "这里。看看大厅，就像“哦，我”"}, {"type": "subtitle", "time": 2528.23, "timestamp": "00:42:08", "text": "再见。那就是你。你好，杰奎先生。"}, {"type": "subtitle", "time": 2530.23, "timestamp": "00:42:10", "text": "你好。你看起来像个实体，"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "方式。我愿意。耶稣基督。不要看"}, {"type": "subtitle", "time": 2536.95, "timestamp": "00:42:16", "text": "看着我。哦，我的天啊。"}, {"type": "subtitle", "time": 2541.349, "timestamp": "00:42:21", "text": "顺便说一句，你看上去很可怕。我愿意。"}, {"type": "subtitle", "time": 2543.829, "timestamp": "00:42:23", "text": "哦。"}, {"type": "subtitle", "time": 2545.55, "timestamp": "00:42:25", "text": "我的天啊。"}, {"type": "subtitle", "time": 2548.87, "timestamp": "00:42:28", "text": "哇。欢迎。你好。你好。黄色的。"}, {"type": "subtitle", "time": 2551.349, "timestamp": "00:42:31", "text": "黄色的。好的。一秒钟。当然。那是"}, {"type": "subtitle", "time": 2554.069, "timestamp": "00:42:34", "text": "绝对会吓你一跳。那是一个非常"}, {"type": "subtitle", "time": 2556.87, "timestamp": "00:42:36", "text": "令人毛骨悚然的突发惊吓。让我放"}, {"type": "subtitle", "time": 2561.03, "timestamp": "00:42:41", "text": "我不知道。工作组合就像"}, {"type": "subtitle", "time": 2562.71, "timestamp": "00:42:42", "text": "呃，Instagram故事里提到的那些药丸"}, {"type": "subtitle", "time": 2565.589, "timestamp": "00:42:45", "text": "用来使你平静下来。他们将使用"}, {"type": "subtitle", "time": 2569.589, "timestamp": "00:42:49", "text": "你的焦虑。谢谢游戏。真的真的"}, {"type": "subtitle", "time": 2571.91, "timestamp": "00:42:51", "text": "谢谢。哦，等等，图腾那玩意儿"}, {"type": "subtitle", "time": 2577.589, "timestamp": "00:42:57", "text": "也出现了。哦，那太酷了。"}, {"type": "subtitle", "time": 2579.109, "timestamp": "00:42:59", "text": "反正，"}]
[{"type": "subtitle", "time": 8347.11, "timestamp": "02:19:07", "text": "小心。坏人。绝不错过。"}, {"type": "subtitle", "time": 8349.429, "timestamp": "02:19:09", "text": "这件事躲不开。知道你在哪里"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "到过。双杀。"}, {"type": "subtitle", "time": 8373.429, "timestamp": "02:19:33", "text": "双杀。那是三个。 KO。 KO。 KO。"}, {"type": "subtitle", "time": 8379.389, "timestamp": "02:19:39", "text": "排。五。那是"}, {"type": "subtitle", "time": 8383.11, "timestamp": "02:19:43", "text": "惊人的。六连胜。干得好。"}]
[{"type": "subtitle", "time": 4140.149, "timestamp": "01:09:00", "text": "中间偏上的那个是我们需要的。"}, {"type": "subtitle", "time": 4142.149, "timestamp": "01:09:02", "text": "找到脚。"}, {"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "好的。"}, {"type": "subtitle", "time": 4145.91, "timestamp": "01:09:05", "text": "谁掉了牙？詹妮弗失去了"}, {"type": "subtitle", "time": 4148.149, "timestamp": "01:09:08", "text": "牙齿。珍妮弗·莫莉。我刚刚放了"}, {"type": "subtitle", "time": 4149.749, "timestamp": "01:09:09", "text": "牙齿。"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "好的。"}, {"type": "subtitle", "time": 4154.349, "timestamp": "01:09:14", "text": "然后"}, {"type": "subtitle", "time": 4156.269, "timestamp": "01:09:16", "text": "呃，它"}, {"type": "subtitle", "time": 4158.59, "timestamp": "01:09:18", "text": "不是"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "玛琳。那是什么？内森·艾伦。得到"}, {"type": "subtitle", "time": 4163.11, "timestamp": "01:09:23", "text": "它。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "急诊室出了问题。好的。我们只需要"}, {"type": "subtitle", "time": 4170.709, "timestamp": "01:09:30", "text": "脚。这个人。好的。谁需要手指？"}, {"type": "subtitle", "time": 4173.99, "timestamp": "01:09:33", "text": "尽管？呃，就是这个人。他就是那个人"}, {"type": "subtitle", "time": 4177.269, "timestamp": "01:09:37", "text": "告诉我们。 WHO？乔纳森。乔纳森"}, {"type": "subtitle", "time": 4179.189, "timestamp": "01:09:39", "text": "他需要那只脚。我们需要找到"}, {"type": "subtitle", "time": 4182.709, "timestamp": "01:09:42", "text": "脚。什么？不。"}, {"type": "subtitle", "time": 4185.189, "timestamp": "01:09:45", "text": "你的库存里有这只脚吗？"}, {"type": "subtitle", "time": 4187.749, "timestamp": "01:09:47", "text": "我有手指。"}, {"type": "subtitle", "time": 4189.44, "timestamp": "01:09:49", "text": "手指。 是的。谁失去了手指？等等，我们……"}, {"type": "subtitle", "time": 4192.56, "timestamp": "01:09:52", "text": "是的。谁失去了手指？等等，我们…… 应该为所有人这样做吗？"}, {"type": "subtitle", "time": 4196.96, "timestamp": "01:09:56", "text": "应该为所有人这样做吗？ 我不知道。大概。哦，等等。做"}]
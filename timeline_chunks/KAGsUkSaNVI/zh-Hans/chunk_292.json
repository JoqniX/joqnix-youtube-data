[{"type": "subtitle", "time": 17520.628, "timestamp": "04:52:00", "text": "也意味着嗯哦，这个这个好的可以这个"}, {"type": "subtitle", "time": 17525.788, "timestamp": "04:52:05", "text": "我尊重你的称呼。"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "当你称呼某人时，你使用"}, {"type": "subtitle", "time": 17531.03, "timestamp": "04:52:11", "text": "在名字后面加上“儿子”的头衔以示……"}, {"type": "subtitle", "time": 17532.948, "timestamp": "04:52:12", "text": "使用时请尊重对方。"}, {"type": "subtitle", "time": 17536.628, "timestamp": "04:52:16", "text": "某人的名字，它没有"}, {"type": "subtitle", "time": 17540.75, "timestamp": "04:52:20", "text": "哦，明白了。"}, {"type": "subtitle", "time": 17543.99, "timestamp": "04:52:23", "text": "明白了。注意这些问候语，例如"}, {"type": "subtitle", "time": 17547.11, "timestamp": "04:52:27", "text": "hello 和 by 通常出现在 the 之前"}, {"type": "subtitle", "time": 17550.708, "timestamp": "04:52:30", "text": "英文名称，但在它之后"}, {"type": "subtitle", "time": 17553.99, "timestamp": "04:52:33", "text": "日本人。哦，等等。"}, {"type": "subtitle", "time": 17566.07, "timestamp": "04:52:46", "text": "哦，上帝随着时间的推移进步了很多。"}, {"type": "subtitle", "time": 17568.59, "timestamp": "04:52:48", "text": "哦，我还没看过"}, {"type": "subtitle", "time": 17570.11, "timestamp": "04:52:50", "text": "它。"}, {"type": "subtitle", "time": 17572.83, "timestamp": "04:52:52", "text": "去"}, {"type": "subtitle", "time": 17576.948, "timestamp": "04:52:56", "text": "我还没看过。天哪，真是这样，真是这样"}, {"type": "subtitle", "time": 17578.27, "timestamp": "04:52:58", "text": "很难"}]
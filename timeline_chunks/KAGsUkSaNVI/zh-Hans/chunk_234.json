[{"type": "subtitle", "time": 14042.309, "timestamp": "03:54:02", "text": "多重现实。很酷吧？我是"}, {"type": "subtitle", "time": 14044.269, "timestamp": "03:54:04", "text": "以蜘蛛侠为例"}, {"type": "subtitle", "time": 14047.79, "timestamp": "03:54:07", "text": "看。我只想玩游戏。"}, {"type": "subtitle", "time": 14049.71, "timestamp": "03:54:09", "text": "它和"}, {"type": "subtitle", "time": 14069.75, "timestamp": "03:54:29", "text": "总得有人阻止毁灭战士。我是说，"}, {"type": "subtitle", "time": 14073.11, "timestamp": "03:54:33", "text": "末日。我希望只有两个。"}, {"type": "subtitle", "time": 14075.189, "timestamp": "03:54:35", "text": "他们还有30秒就到。停留"}, {"type": "subtitle", "time": 14081.99, "timestamp": "03:54:41", "text": "哦，嗨，蜘蛛侠。我听说你是"}, {"type": "subtitle", "time": 14085.03, "timestamp": "03:54:45", "text": "协助治疗反应性呼吸道疾病"}, {"type": "subtitle", "time": 14088.07, "timestamp": "03:54:48", "text": "大概有一点点吧。我不能，我没有"}, {"type": "subtitle", "time": 14090.309, "timestamp": "03:54:50", "text": "知道如何"}, {"type": "subtitle", "time": 14093.51, "timestamp": "03:54:53", "text": "也找不到，直到TRD才找到。"}, {"type": "subtitle", "time": 14095.59, "timestamp": "03:54:55", "text": "一切都结束了，所有事情都回到了原点。"}, {"type": "subtitle", "time": 14098.71, "timestamp": "03:54:58", "text": "事情就是这样。我喜欢你的乐观精神。我们开始吧"}]
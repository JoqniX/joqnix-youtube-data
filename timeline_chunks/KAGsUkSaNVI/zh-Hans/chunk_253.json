[{"type": "subtitle", "time": 15193.99, "timestamp": "04:13:13", "text": "攻击前30秒。准备。"}, {"type": "subtitle", "time": 15197.59, "timestamp": "04:13:17", "text": "砍杀。你似乎心不在焉"}, {"type": "subtitle", "time": 15201.75, "timestamp": "04:13:21", "text": "那。听听你在我这儿胡言乱语"}, {"type": "subtitle", "time": 15205.149, "timestamp": "04:13:25", "text": "再次。过去与我交流的方式有时是"}, {"type": "subtitle", "time": 15207.99, "timestamp": "04:13:27", "text": "出色地。我懂了。"}, {"type": "subtitle", "time": 15210.55, "timestamp": "04:13:30", "text": "是的，我不会真的造成那种情况，但是……"}, {"type": "subtitle", "time": 15213.269, "timestamp": "04:13:33", "text": "或许你找到了一个更好的神。这"}, {"type": "subtitle", "time": 15219.75, "timestamp": "04:13:39", "text": "战斗将于 5、4、3、2、1 时开始。"}, {"type": "subtitle", "time": 15221.51, "timestamp": "04:13:41", "text": "我只需要完成任务即可。"}, {"type": "subtitle", "time": 15224.269, "timestamp": "04:13:44", "text": "区域。知道了。"}, {"type": "subtitle", "time": 15227.83, "timestamp": "04:13:47", "text": "说实话，我小时候并不喜欢雪。"}, {"type": "subtitle", "time": 15229.349, "timestamp": "04:13:49", "text": "有钱人总是试图抛弃"}]
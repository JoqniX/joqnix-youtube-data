[{"type": "subtitle", "time": 18662.39, "timestamp": "05:11:02", "text": "一。等等，我该怎么说呢？好的，我是"}, {"type": "subtitle", "time": 18664.868, "timestamp": "05:11:04", "text": "后退。呃"}, {"type": "subtitle", "time": 18667.99, "timestamp": "05:11:07", "text": "哦不，我被惩罚了。"}, {"type": "subtitle", "time": 18674.55, "timestamp": "05:11:14", "text": "糟了，情况不妙。"}, {"type": "subtitle", "time": 18679.03, "timestamp": "05:11:19", "text": "显然，相信他已经明白了。"}, {"type": "subtitle", "time": 18681.75, "timestamp": "05:11:21", "text": "这是挂机状态。"}, {"type": "subtitle", "time": 18689.78, "timestamp": "05:11:29", "text": "使用 Superango，获得更多优惠。"}, {"type": "subtitle", "time": 18691.67, "timestamp": "05:11:31", "text": "[笑声]"}, {"type": "subtitle", "time": 18699.67, "timestamp": "05:11:39", "text": "等等，等等。不，等等。在哪里？"}, {"type": "subtitle", "time": 18702.15, "timestamp": "05:11:42", "text": "浏览器？哦，他们刚才才明白。"}, {"type": "subtitle", "time": 18709.35, "timestamp": "05:11:49", "text": "你会读英文吗？ WHO？哪个管理员？"}, {"type": "subtitle", "time": 18712.708, "timestamp": "05:11:52", "text": "是哪个管理员举报我的，兄弟？"}, {"type": "subtitle", "time": 18714.55, "timestamp": "05:11:54", "text": "哪个管理员举报了我。我不去"}, {"type": "subtitle", "time": 18718.15, "timestamp": "05:11:58", "text": "相信。我发誓。我要来了"}]
[{"type": "subtitle", "time": 19981.628, "timestamp": "05:33:01", "text": "工作？哦，我的"}, {"type": "subtitle", "time": 19986.548, "timestamp": "05:33:06", "text": "上帝。我之前已经提过了，如果"}, {"type": "subtitle", "time": 19989.11, "timestamp": "05:33:09", "text": "如果你是一位想要成为艺术家的人"}, {"type": "subtitle", "time": 19991.83, "timestamp": "05:33:11", "text": "如果我是你的客户什么的，我会……"}, {"type": "subtitle", "time": 19994.35, "timestamp": "05:33:14", "text": "我不得不拒绝，因为我已经……"}, {"type": "subtitle", "time": 19997.628, "timestamp": "05:33:17", "text": "满的。呃，我是"}, {"type": "subtitle", "time": 20000.15, "timestamp": "05:33:20", "text": "破产了。我也身无分文。我已经"}, {"type": "subtitle", "time": 20003.11, "timestamp": "05:33:23", "text": "满的。我已经选好的人有"}, {"type": "subtitle", "time": 20005.31, "timestamp": "05:33:25", "text": "他们已经开始工作了。"}, {"type": "subtitle", "time": 20007.83, "timestamp": "05:33:27", "text": "一切。我正在参加 Jockathon 比赛"}, {"type": "subtitle", "time": 20010.39, "timestamp": "05:33:30", "text": "付钱给他们。就是这样。我的东西是"}, {"type": "subtitle", "time": 20012.47, "timestamp": "05:33:32", "text": "我的首秀已经全部订满了，一切都好。"}, {"type": "subtitle", "time": 20015.39, "timestamp": "05:33:35", "text": "已经全部完成。"}, {"type": "subtitle", "time": 20017.31, "timestamp": "05:33:37", "text": "所以"}, {"type": "subtitle", "time": 20021.628, "timestamp": "05:33:41", "text": "是的，我必须说不。"}, {"type": "subtitle", "time": 20025.43, "timestamp": "05:33:45", "text": "是的，我得说不。但是，再说一遍，"}, {"type": "subtitle", "time": 20028.07, "timestamp": "05:33:48", "text": "有些人实际上是……"}, {"type": "subtitle", "time": 20032.708, "timestamp": "05:33:52", "text": "还在寻找其他人和东西。所以……"}, {"type": "subtitle", "time": 20035.83, "timestamp": "05:33:55", "text": "我希望你能找到一位新客户，一位"}, {"type": "subtitle", "time": 20038.91, "timestamp": "05:33:58", "text": "谁需要帮助。但就目前而言，我还没加入。"}]
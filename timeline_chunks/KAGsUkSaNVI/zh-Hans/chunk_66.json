[{"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "谢了，别动。保持静止。哦"}, {"type": "subtitle", "time": 3968.95, "timestamp": "01:06:08", "text": "天哪，我死了。我被吓了一跳。"}, {"type": "subtitle", "time": 3971.67, "timestamp": "01:06:11", "text": "我获得了双跳皮肤。对不起。哦，我的"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "上帝。好像是……啊。是的。"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "显然，那张诡异的脸和那只狗"}, {"type": "subtitle", "time": 3980.029, "timestamp": "01:06:20", "text": "杀死了我们。"}, {"type": "subtitle", "time": 3984.15, "timestamp": "01:06:24", "text": "是的。好的。找到这个东西。这"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "门。是的。"}, {"type": "subtitle", "time": 3990.87, "timestamp": "01:06:30", "text": "你找到门了。真的吗？"}, {"type": "subtitle", "time": 3993.39, "timestamp": "01:06:33", "text": "我正跟着门走。闪闪发光的"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "东西。真的吗？你得到了闪亮的"}, {"type": "subtitle", "time": 4003.51, "timestamp": "01:06:43", "text": "在哪里"}, {"type": "subtitle", "time": 4006.789, "timestamp": "01:06:46", "text": "对我来说，这很明显"}, {"type": "subtitle", "time": 4008.27, "timestamp": "01:06:48", "text": "对我来说并非如此。"}, {"type": "subtitle", "time": 4011.349, "timestamp": "01:06:51", "text": "显示意味着这场比赛现在显示"}]
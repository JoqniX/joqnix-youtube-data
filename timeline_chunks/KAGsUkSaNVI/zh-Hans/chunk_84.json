[{"type": "subtitle", "time": 5042.31, "timestamp": "01:24:02", "text": "我想应该是那个地方。"}, {"type": "subtitle", "time": 5044.39, "timestamp": "01:24:04", "text": "这是什么？有一张纸条。中的一个"}, {"type": "subtitle", "time": 5046.07, "timestamp": "01:24:06", "text": "花瓶里装着东西。他们是如此"}, {"type": "subtitle", "time": 5049.59, "timestamp": "01:24:09", "text": "很难用手掰断。好的。"}, {"type": "subtitle", "time": 5051.99, "timestamp": "01:24:11", "text": "哦，我们需要问问我们是不是在废物处理中。"}, {"type": "subtitle", "time": 5054.95, "timestamp": "01:24:14", "text": "房间？"}, {"type": "subtitle", "time": 5057.189, "timestamp": "01:24:17", "text": "这里被狗狗追着跑来跑去"}, {"type": "subtitle", "time": 5059.75, "timestamp": "01:24:19", "text": "方式。"}, {"type": "subtitle", "time": 5062.709, "timestamp": "01:24:22", "text": "啊，"}, {"type": "subtitle", "time": 5065.11, "timestamp": "01:24:25", "text": "你也有吗？"}, {"type": "subtitle", "time": 5067.189, "timestamp": "01:24:27", "text": "呃，我有那把红钥匙。我拿到了红色"}, {"type": "subtitle", "time": 5073.83, "timestamp": "01:24:33", "text": "你拿到红色钥匙了吗？什么钥匙？"}, {"type": "subtitle", "time": 5076.55, "timestamp": "01:24:36", "text": "红色钥匙。"}, {"type": "subtitle", "time": 5078.31, "timestamp": "01:24:38", "text": "我们走吧。"}, {"type": "subtitle", "time": 5080.79, "timestamp": "01:24:40", "text": "鲨鱼，你拿到红钥匙了吗？在哪里？"}, {"type": "subtitle", "time": 5084.79, "timestamp": "01:24:44", "text": "红色钥匙？我拿到钥匙了。哦，我得到一个"}, {"type": "subtitle", "time": 5086.709, "timestamp": "01:24:46", "text": "鼻子。"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "长了个鼻子。好的。好了，我们走吧。得到一个"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "鼻子。"}, {"type": "subtitle", "time": 5094.229, "timestamp": "01:24:54", "text": "不。"}, {"type": "subtitle", "time": 5097.189, "timestamp": "01:24:57", "text": "我的天哪，杰克。停留。"}]
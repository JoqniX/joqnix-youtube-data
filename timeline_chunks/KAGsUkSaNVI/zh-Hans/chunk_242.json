[{"type": "subtitle", "time": 14522.15, "timestamp": "04:02:02", "text": "绝不能允许斯塔克之触蔓延开来。"}, {"type": "subtitle", "time": 14525.83, "timestamp": "04:02:05", "text": "更远。只剩60秒了。"}, {"type": "subtitle", "time": 14529.59, "timestamp": "04:02:09", "text": "哦，真是漂亮的招数，对吧？"}, {"type": "subtitle", "time": 14536.59, "timestamp": "04:02:16", "text": "拥有令人惊叹的"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "蜘蛛侠对你来说太粘人了。"}, {"type": "subtitle", "time": 14553.189, "timestamp": "04:02:33", "text": "阻止他们。"}, {"type": "subtitle", "time": 14559.51, "timestamp": "04:02:39", "text": "这次我一定要做得更好。无法给予"}]
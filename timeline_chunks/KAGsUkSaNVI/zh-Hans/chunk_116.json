[{"type": "subtitle", "time": 6961.75, "timestamp": "01:56:01", "text": "我还没付钱，因为我没钱。我"}, {"type": "subtitle", "time": 6963.51, "timestamp": "01:56:03", "text": "还没收到工资。什么也没有"}, {"type": "subtitle", "time": 6966.91, "timestamp": "01:56:06", "text": "给我安排的工作。我真的就在这里。"}, {"type": "subtitle", "time": 6970.07, "timestamp": "01:56:10", "text": "失业，身无分文，没有处女之身"}, {"type": "subtitle", "time": 6976.95, "timestamp": "01:56:16", "text": "的。像性爱女孩和未成年部分"}, {"type": "subtitle", "time": 6978.79, "timestamp": "01:56:18", "text": "因为我不在乎。是的，我"}, {"type": "subtitle", "time": 6980.55, "timestamp": "01:56:20", "text": "我首先需要专注于我的梦想。所以"}, {"type": "subtitle", "time": 6996.629, "timestamp": "01:56:36", "text": "[音乐]"}, {"type": "subtitle", "time": 6999.189, "timestamp": "01:56:39", "text": "用餐休息时间。顺便说一下，关于这顿饭"}, {"type": "subtitle", "time": 7001.83, "timestamp": "01:56:41", "text": "打破，你不能通过以下方式改变事物："}, {"type": "subtitle", "time": 7004.95, "timestamp": "01:56:44", "text": "道路。好的。 U 代表用餐休息时间，"}, {"type": "subtitle", "time": 7006.109, "timestamp": "01:56:46", "text": "正确的？"}, {"type": "subtitle", "time": 7008.83, "timestamp": "01:56:48", "text": "嗯，这取决于……"}, {"type": "subtitle", "time": 7011.95, "timestamp": "01:56:51", "text": "定时。我的当前系统时间。"}, {"type": "subtitle", "time": 7016.109, "timestamp": "01:56:56", "text": "好的。所以，中午12点到下午2点"}, {"type": "subtitle", "time": 7019.109, "timestamp": "01:56:59", "text": "下午不，12比3被认为是"}]
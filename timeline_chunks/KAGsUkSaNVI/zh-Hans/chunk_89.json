[{"type": "subtitle", "time": 5343.11, "timestamp": "01:29:03", "text": "上帝啊，看在主的份上，我看见你了。我"}, {"type": "subtitle", "time": 5345.75, "timestamp": "01:29:05", "text": "我没有，我没有，来"}, {"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "这里。过来。呃，你什么都有了。"}, {"type": "subtitle", "time": 5351.91, "timestamp": "01:29:11", "text": "正确的？是的。我们走吧。跑步"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "直的。直跑。直跑。"}, {"type": "subtitle", "time": 5356.55, "timestamp": "01:29:16", "text": "哦，是电缆啊，老兄。没关系。好的。"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "没关系。他只是很难过。它是"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "美好的。是的。是的。是的。是的。哦，那"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "那张令人毛骨悚然的脸。"}, {"type": "subtitle", "time": 5367.51, "timestamp": "01:29:27", "text": "突然惊吓。别看它。"}, {"type": "subtitle", "time": 5371.35, "timestamp": "01:29:31", "text": "突然惊吓。啊，该死。我们死了。是"}, {"type": "subtitle", "time": 5374.149, "timestamp": "01:29:34", "text": "我疯了吗？你死了吗？打电话给我"}, {"type": "subtitle", "time": 5377.07, "timestamp": "01:29:37", "text": "疯狂的。"}, {"type": "subtitle", "time": 5381.189, "timestamp": "01:29:41", "text": "什么？发生了什么？等等，你死了吗？"}, {"type": "subtitle", "time": 5382.79, "timestamp": "01:29:42", "text": "我没死。你在哪里？好的。好的。"}, {"type": "subtitle", "time": 5385.11, "timestamp": "01:29:45", "text": "好的。好的。我，我，我就像，呃，拥抱"}, {"type": "subtitle", "time": 5387.189, "timestamp": "01:29:47", "text": "此刻，这堵墙。就等着了"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "我感觉很诡异。好的。那家伙的"}, {"type": "subtitle", "time": 5393.27, "timestamp": "01:29:53", "text": "走了。那家伙走了。你在哪里？我们"}, {"type": "subtitle", "time": 5396.79, "timestamp": "01:29:56", "text": "直行。是的。直接前往"}, {"type": "subtitle", "time": 5398.629, "timestamp": "01:29:58", "text": "这边。我关注你了。我没有"}]
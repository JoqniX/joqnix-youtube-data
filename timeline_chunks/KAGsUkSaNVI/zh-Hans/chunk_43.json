[{"type": "subtitle", "time": 2581.27, "timestamp": "00:43:01", "text": "紫色粘液简直就像……"}, {"type": "subtitle", "time": 2584.63, "timestamp": "00:43:04", "text": "顺便一提，这是可以消耗的，不用担心。"}, {"type": "subtitle", "time": 2587.109, "timestamp": "00:43:07", "text": "等等，怎么才能得到它？你收到吗？"}, {"type": "subtitle", "time": 2589.03, "timestamp": "00:43:09", "text": "游戏？"}, {"type": "subtitle", "time": 2592.71, "timestamp": "00:43:12", "text": "实际上，你可以这么做。哦好的。过来。"}, {"type": "subtitle", "time": 2595.43, "timestamp": "00:43:15", "text": "把收音机带走。好的。一秒钟。来"}, {"type": "subtitle", "time": 2598.39, "timestamp": "00:43:18", "text": "这里。你死了吗？啊，耶稣基督。"}, {"type": "subtitle", "time": 2599.15, "timestamp": "00:43:19", "text": "我是"}, {"type": "subtitle", "time": 2603.51, "timestamp": "00:43:23", "text": "对不起。现在。你死了吗？当然。"}, {"type": "subtitle", "time": 2605.67, "timestamp": "00:43:25", "text": "哦，喝点酒自杀吧"}, {"type": "subtitle", "time": 2609.67, "timestamp": "00:43:29", "text": "杏仁水。杏仁。多么好心？"}, {"type": "subtitle", "time": 2611.87, "timestamp": "00:43:31", "text": "好的。实体"}, {"type": "subtitle", "time": 2614.23, "timestamp": "00:43:34", "text": "未知。它被称为细菌，"}, {"type": "subtitle", "time": 2615.51, "timestamp": "00:43:35", "text": "道路。我不知道你们为什么……"}, {"type": "subtitle", "time": 2618.589, "timestamp": "00:43:38", "text": "未知。你们真是太棒了"}, {"type": "subtitle", "time": 2620.349, "timestamp": "00:43:40", "text": "愚蠢的。"}, {"type": "subtitle", "time": 2623.67, "timestamp": "00:43:43", "text": "总之，杰克，你想玩吗？"}, {"type": "subtitle", "time": 2627.79, "timestamp": "00:43:47", "text": "带上收音机。带上收音机。"}, {"type": "subtitle", "time": 2630.39, "timestamp": "00:43:50", "text": "艾萨克电台。"}, {"type": "subtitle", "time": 2634.87, "timestamp": "00:43:54", "text": "乔克先生。是的，我是Y。是的。等等，等等，"}, {"type": "subtitle", "time": 2637.27, "timestamp": "00:43:57", "text": "等待。你没听见我说话吗？你好。你好。"}, {"type": "subtitle", "time": 2638.88, "timestamp": "00:43:58", "text": "你好。 我不这么认为。我把一切都改变了"}]
[{"type": "subtitle", "time": 19226.948, "timestamp": "05:20:26", "text": "我的天啊。"}, {"type": "subtitle", "time": 19230.708, "timestamp": "05:20:30", "text": "艾玛·弗罗斯特永不言败。"}, {"type": "subtitle", "time": 19235.03, "timestamp": "05:20:35", "text": "确切地。她从来不会这样做。"}, {"type": "subtitle", "time": 19236.99, "timestamp": "05:20:36", "text": "等等，艾玛·弗罗斯特是谁？"}, {"type": "subtitle", "time": 19250.47, "timestamp": "05:20:50", "text": "X战警。瞧瞧谁来了。"}]
[{"type": "subtitle", "time": 16327.51, "timestamp": "04:32:07", "text": "兄弟。这是"}, {"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "绿巨人。我要来杀了你"}, {"type": "subtitle", "time": 16336.309, "timestamp": "04:32:16", "text": "兄弟，"}, {"type": "subtitle", "time": 16339.67, "timestamp": "04:32:19", "text": "什么？我觉得我扭伤了肩膀。"}, {"type": "subtitle", "time": 16343.75, "timestamp": "04:32:23", "text": "我觉得我不能使用那个领主"}, {"type": "subtitle", "time": 16346.189, "timestamp": "04:32:26", "text": "最大限度"}, {"type": "subtitle", "time": 16348.95, "timestamp": "04:32:28", "text": "脉冲。保护我。他们团队的俘虏"}, {"type": "subtitle", "time": 16373.03, "timestamp": "04:32:53", "text": "兄弟。"}]
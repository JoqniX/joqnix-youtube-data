[{"type": "subtitle", "time": 3783.23, "timestamp": "01:03:03", "text": "马利·乔纳森"}, {"type": "subtitle", "time": 3786.47, "timestamp": "01:03:06", "text": "我记得，加伦多失去了耳朵。哦，"}, {"type": "subtitle", "time": 3788.23, "timestamp": "01:03:08", "text": "不。这是什么？脚。你有吗？"}, {"type": "subtitle", "time": 3791.109, "timestamp": "01:03:11", "text": "脚？脚？不，我没有那只脚。"}, {"type": "subtitle", "time": 3794.069, "timestamp": "01:03:14", "text": "哦，等等。这是什么？我不知道。"}, {"type": "subtitle", "time": 3795.15, "timestamp": "01:03:15", "text": "内森"}, {"type": "subtitle", "time": 3797.99, "timestamp": "01:03:17", "text": "艾伦。呃，耳朵丢了。所以，我有一个"}, {"type": "subtitle", "time": 3806.069, "timestamp": "01:03:26", "text": "糟糕。"}, {"type": "subtitle", "time": 3808.95, "timestamp": "01:03:28", "text": "好的。发生了什么？"}, {"type": "subtitle", "time": 3811.589, "timestamp": "01:03:31", "text": "我会服用抗焦虑药。是的，"}, {"type": "subtitle", "time": 3815.51, "timestamp": "01:03:35", "text": "我现在恢复正常了。你好。"}, {"type": "subtitle", "time": 3818.549, "timestamp": "01:03:38", "text": "那是什么？他的目标是什么？所以，"}, {"type": "subtitle", "time": 3822.15, "timestamp": "01:03:42", "text": "我们需要确定是左脚还是右脚。"}, {"type": "subtitle", "time": 3824.99, "timestamp": "01:03:44", "text": "脚。那是"}, {"type": "subtitle", "time": 3828.829, "timestamp": "01:03:48", "text": "呃，你听到了吗？"}, {"type": "subtitle", "time": 3832.07, "timestamp": "01:03:52", "text": "好的，珍妮弗，"}, {"type": "subtitle", "time": 3833.589, "timestamp": "01:03:53", "text": "[音乐]"}, {"type": "subtitle", "time": 3837.109, "timestamp": "01:03:57", "text": "我非常确定是乔纳森。"}, {"type": "subtitle", "time": 3839.51, "timestamp": "01:03:59", "text": "是的。所以，我们需要找到左脚。"}]
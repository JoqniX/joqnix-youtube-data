[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "月亮萦绕着你。我是如何挺过来的？"}, {"type": "subtitle", "time": 14296.67, "timestamp": "03:58:16", "text": "那。啊，"}, {"type": "subtitle", "time": 14298.389, "timestamp": "03:58:18", "text": "兄弟。"}, {"type": "subtitle", "time": 14300.71, "timestamp": "03:58:20", "text": "我逃不掉的。我无法运行"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "离开。"}, {"type": "subtitle", "time": 14306.15, "timestamp": "03:58:26", "text": "消失。"}, {"type": "subtitle", "time": 14319.03, "timestamp": "03:58:39", "text": "你需要让那辆车停下来。"}, {"type": "subtitle", "time": 14321.75, "timestamp": "03:58:41", "text": "轨道。"}, {"type": "subtitle", "time": 14334.87, "timestamp": "03:58:54", "text": "赐予我们混乱，让我们惊叹不已"}]
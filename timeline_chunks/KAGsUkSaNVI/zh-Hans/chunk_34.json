[{"type": "subtitle", "time": 2043.029, "timestamp": "00:34:03", "text": "我的天哪。这只是一张普通的PNG图片而已，老兄。"}, {"type": "subtitle", "time": 2047.11, "timestamp": "00:34:07", "text": "哇，原来如此！"}, {"type": "subtitle", "time": 2049.909, "timestamp": "00:34:09", "text": "黑屏，我的天哪，你知道我说的是哪一种吗？"}, {"type": "subtitle", "time": 2051.669, "timestamp": "00:34:11", "text": "我可能听不见你说话。"}, {"type": "subtitle", "time": 2055.909, "timestamp": "00:34:15", "text": "但我会……你知道，就……呃，重新开始。"}, {"type": "subtitle", "time": 2059.99, "timestamp": "00:34:19", "text": "别担心，马上就来。"}, {"type": "subtitle", "time": 2062.149, "timestamp": "00:34:22", "text": "它不是"}, {"type": "subtitle", "time": 2064.149, "timestamp": "00:34:24", "text": "我的天哪，你不在也没关系。"}, {"type": "subtitle", "time": 2066.79, "timestamp": "00:34:26", "text": "希望你参与游戏，你愿意吗？"}, {"type": "subtitle", "time": 2073.909, "timestamp": "00:34:33", "text": "游戏，我很抱歉。"}, {"type": "subtitle", "time": 2077.909, "timestamp": "00:34:37", "text": "哦，是的。大家最近怎么样？每个人。"}, {"type": "subtitle", "time": 2081.03, "timestamp": "00:34:41", "text": "是的。你好，布拉德。是的。你好，Mar。哦"}, {"type": "subtitle", "time": 2085.19, "timestamp": "00:34:45", "text": "真的吗？我的天哪。我已经拿到了"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "梯子和 J 不在这里。我希望如此。"}, {"type": "subtitle", "time": 2090.869, "timestamp": "00:34:50", "text": "不令人失望。"}, {"type": "subtitle", "time": 2093.589, "timestamp": "00:34:53", "text": "我的天啊。它甚至还没重启。哦"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "男人。"}, {"type": "subtitle", "time": 2097.51, "timestamp": "00:34:57", "text": "真的吗？"}]
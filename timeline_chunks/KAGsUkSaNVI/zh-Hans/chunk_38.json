[{"type": "subtitle", "time": 2282.03, "timestamp": "00:38:02", "text": "是的，我刚把它添加进去了。"}, {"type": "subtitle", "time": 2286.47, "timestamp": "00:38:06", "text": "就像……呃……头像……"}, {"type": "subtitle", "time": 2288.43, "timestamp": "00:38:08", "text": "车间。"}, {"type": "subtitle", "time": 2291.03, "timestamp": "00:38:11", "text": "是的。但这并不是说你可以成为"}, {"type": "subtitle", "time": 2294.0, "timestamp": "00:38:14", "text": "如果你愿意，可以叫他巨石强森。"}, {"type": "subtitle", "time": 2297.03, "timestamp": "00:38:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2304.349, "timestamp": "00:38:24", "text": "如何才能像他那样"}, {"type": "subtitle", "time": 2308.15, "timestamp": "00:38:28", "text": "我甚至不知道该如何才能像那样。"}, {"type": "subtitle", "time": 2310.63, "timestamp": "00:38:30", "text": "对，就是那些动物方面的东西。我"}, {"type": "subtitle", "time": 2314.31, "timestamp": "00:38:34", "text": "不知道怎么才能得到那些"}, {"type": "subtitle", "time": 2316.19, "timestamp": "00:38:36", "text": "皮肤和"}, {"type": "subtitle", "time": 2320.15, "timestamp": "00:38:40", "text": "每天玩这个游戏真是够呛。"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "不。什么？等待。我听起来像是在演奏这个"}, {"type": "subtitle", "time": 2329.75, "timestamp": "00:38:49", "text": "每天都玩游戏。什么？"}, {"type": "subtitle", "time": 2332.23, "timestamp": "00:38:52", "text": "不，不，不。我不会那样做的。"}, {"type": "subtitle", "time": 2334.24, "timestamp": "00:38:54", "text": "每天都玩这个游戏。"}, {"type": "subtitle", "time": 2335.75, "timestamp": "00:38:55", "text": "[音乐]"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "好的。我开始玩游戏了。是的。是的。"}]
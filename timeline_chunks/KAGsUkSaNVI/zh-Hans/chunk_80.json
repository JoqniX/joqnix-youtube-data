[{"type": "subtitle", "time": 4802.31, "timestamp": "01:20:02", "text": "辐射场所。确实如此。但"}, {"type": "subtitle", "time": 4805.59, "timestamp": "01:20:05", "text": "我们还没有探索过那方面。不。呃"}, {"type": "subtitle", "time": 4807.27, "timestamp": "01:20:07", "text": "你如果那样做会死的。"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "地方。顺便一提，供您参考。不，就像……"}, {"type": "subtitle", "time": 4814.39, "timestamp": "01:20:14", "text": "一点。直到我们像"}, {"type": "subtitle", "time": 4816.31, "timestamp": "01:20:16", "text": "把脚拿下来。"}, {"type": "subtitle", "time": 4817.79, "timestamp": "01:20:17", "text": "哦，是的。"}, {"type": "subtitle", "time": 4824.229, "timestamp": "01:20:24", "text": "是的。工作，工作。我……好累。对不起。哦，"}, {"type": "subtitle", "time": 4827.189, "timestamp": "01:20:27", "text": "我们一起去散步吧。我的……也很少。"}, {"type": "subtitle", "time": 4829.03, "timestamp": "01:20:29", "text": "耐力。"}, {"type": "subtitle", "time": 4831.669, "timestamp": "01:20:31", "text": "是的。"}, {"type": "subtitle", "time": 4834.07, "timestamp": "01:20:34", "text": "好的。"}, {"type": "subtitle", "time": 4841.99, "timestamp": "01:20:41", "text": "其中之一是惊吓基地。所以我们跳"}, {"type": "subtitle", "time": 4849.27, "timestamp": "01:20:49", "text": "哦，突然惊吓。"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "他在那里。谢天谢地我没看。"}, {"type": "subtitle", "time": 4857.75, "timestamp": "01:20:57", "text": "他就像那种唯一能喜欢别人的人。"}]
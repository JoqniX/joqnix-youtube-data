[{"type": "subtitle", "time": 13031.269, "timestamp": "03:37:11", "text": "关联。敌人来了。这是"}, {"type": "subtitle", "time": 13044.389, "timestamp": "03:37:24", "text": "向上。真是天壤之别。"}, {"type": "subtitle", "time": 13061.19, "timestamp": "03:37:41", "text": "正如你的名字所暗示的那样，冷酷无情。"}, {"type": "subtitle", "time": 13079.99, "timestamp": "03:37:59", "text": "你好，阿斯特拉。我的天啊。 Jako，你过马路"}]
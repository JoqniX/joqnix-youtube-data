[{"type": "subtitle", "time": 5222.31, "timestamp": "01:27:02", "text": "这个人很怪。就像他那样"}, {"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "造成更大损失。就是这样。他确实"}, {"type": "subtitle", "time": 5227.83, "timestamp": "01:27:07", "text": "造成更大损失。而且，他不喜欢"}, {"type": "subtitle", "time": 5231.03, "timestamp": "01:27:11", "text": "务必遵守所有规则。真是太……"}, {"type": "subtitle", "time": 5232.43, "timestamp": "01:27:12", "text": "愚蠢的。"}, {"type": "subtitle", "time": 5235.95, "timestamp": "01:27:15", "text": "为什么？他应该会被吓到才对。"}, {"type": "subtitle", "time": 5242.07, "timestamp": "01:27:22", "text": "我们，但他不是。怪胎。是的。"}, {"type": "subtitle", "time": 5249.99, "timestamp": "01:27:29", "text": "如果我把他砍低位呢？"}, {"type": "subtitle", "time": 5251.55, "timestamp": "01:27:31", "text": "是的，我也是这么想的。"}, {"type": "subtitle", "time": 5255.59, "timestamp": "01:27:35", "text": "做过。真蠢。我当时就想，这……"}, {"type": "subtitle", "time": 5264.55, "timestamp": "01:27:44", "text": "好的。对了，你还活着。好的。"}, {"type": "subtitle", "time": 5266.55, "timestamp": "01:27:46", "text": "是的，我知道祂在你身后。我的天啊。"}, {"type": "subtitle", "time": 5268.87, "timestamp": "01:27:48", "text": "我的天啊。跑就行了。跑就行了。跑就行了。"}, {"type": "subtitle", "time": 5270.639, "timestamp": "01:27:50", "text": "跑就行了。 我要嘲讽他。"}, {"type": "subtitle", "time": 5278.79, "timestamp": "01:27:58", "text": "好的，谢谢。"}]
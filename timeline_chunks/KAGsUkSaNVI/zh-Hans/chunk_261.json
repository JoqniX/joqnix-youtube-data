[{"type": "subtitle", "time": 15669.91, "timestamp": "04:21:09", "text": "别招惹神奇蜘蛛侠。"}, {"type": "subtitle", "time": 15689.11, "timestamp": "04:21:29", "text": "必须解决炮塔问题。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "我的天啊。我死了。我死了。他们"}, {"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "一群人围攻了我。几乎是你的了。他们围攻了我"}, {"type": "subtitle", "time": 15713.11, "timestamp": "04:21:53", "text": "英雄出击。还在呼吸。仍然"}, {"type": "subtitle", "time": 15714.87, "timestamp": "04:21:54", "text": "斗争。"}, {"type": "subtitle", "time": 15718.95, "timestamp": "04:21:58", "text": "看哪，雷神降临。"}]
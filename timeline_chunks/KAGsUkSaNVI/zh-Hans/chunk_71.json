[{"type": "subtitle", "time": 4266.31, "timestamp": "01:11:06", "text": "所以，我有一只眼球和一个手指。如何"}, {"type": "subtitle", "time": 4269.75, "timestamp": "01:11:09", "text": "我死了吗？就像我被……杀死了一样"}, {"type": "subtitle", "time": 4272.87, "timestamp": "01:11:12", "text": "跳动的脚本脸。"}, {"type": "subtitle", "time": 4275.51, "timestamp": "01:11:15", "text": "一张吓人的脸。我也是。实际上，"}, {"type": "subtitle", "time": 4278.07, "timestamp": "01:11:18", "text": "狗什么也没做。它好像就是没发生过"}, {"type": "subtitle", "time": 4280.63, "timestamp": "01:11:20", "text": "工作。双重打击让我有点受伤。"}, {"type": "subtitle", "time": 4283.11, "timestamp": "01:11:23", "text": "少量。双倍喜欢就像给了我一个"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "咬一口，剩下的就交给……"}, {"type": "subtitle", "time": 4287.51, "timestamp": "01:11:27", "text": "突然惊吓。"}, {"type": "subtitle", "time": 4291.03, "timestamp": "01:11:31", "text": "好，我们一起去找那只脚吧。"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "稍等片刻。我需要一些"}, {"type": "subtitle", "time": 4297.27, "timestamp": "01:11:37", "text": "抗焦虑药。好的。我们走吧。第 1 章在哪里"}, {"type": "chat", "time": 4300.265, "timestamp": "01:11:40", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "joq used to do these?"}, {"type": "subtitle", "time": 4309.43, "timestamp": "01:11:49", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 4311.709, "timestamp": "01:11:51", "text": "F代表手电筒。"}]
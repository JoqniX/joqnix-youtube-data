[{"type": "subtitle", "time": 3485.51, "timestamp": "00:58:05", "text": "[音乐]"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "好了，他走了。他走了。我们走吧。"}, {"type": "subtitle", "time": 3495.99, "timestamp": "00:58:15", "text": "所以，我们签下了这名球员。现在，我们需要"}, {"type": "subtitle", "time": 3500.63, "timestamp": "00:58:20", "text": "去。好的。哦，是的。现在我们得走了"}, {"type": "subtitle", "time": 3503.03, "timestamp": "00:58:23", "text": "朝这个方向走。"}, {"type": "subtitle", "time": 3505.27, "timestamp": "00:58:25", "text": "是的，狗狗最后才到这里来。"}, {"type": "subtitle", "time": 3506.51, "timestamp": "00:58:26", "text": "时间。"}, {"type": "subtitle", "time": 3510.63, "timestamp": "00:58:30", "text": "是的。呃，我们走左边。"}, {"type": "subtitle", "time": 3512.87, "timestamp": "00:58:32", "text": "哦，那是什么？"}, {"type": "subtitle", "time": 3529.51, "timestamp": "00:58:49", "text": "还有一个很常见的地方"}, {"type": "subtitle", "time": 3533.109, "timestamp": "00:58:53", "text": "脸部像被召唤出来一样。"}]
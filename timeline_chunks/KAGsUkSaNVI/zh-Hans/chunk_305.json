[{"type": "subtitle", "time": 18301.628, "timestamp": "05:05:01", "text": "呃，"}, {"type": "subtitle", "time": 18304.59, "timestamp": "05:05:04", "text": "等待。用英语怎么说“正确”？"}, {"type": "subtitle", "time": 18307.628, "timestamp": "05:05:07", "text": "日本人？正确的。"}, {"type": "subtitle", "time": 18315.19, "timestamp": "05:05:15", "text": "正确的。我答对了。你怎么做？"}, {"type": "subtitle", "time": 18317.23, "timestamp": "05:05:17", "text": "曾是"}, {"type": "subtitle", "time": 18325.948, "timestamp": "05:05:25", "text": "呃，是我的"}, {"type": "subtitle", "time": 18328.19, "timestamp": "05:05:28", "text": "损失。我"}, {"type": "subtitle", "time": 18330.99, "timestamp": "05:05:30", "text": "韩元。"}, {"type": "subtitle", "time": 18334.43, "timestamp": "05:05:34", "text": "嗯？哦，八。哦。"}, {"type": "subtitle", "time": 18341.15, "timestamp": "05:05:41", "text": "好的。呃，最后"}, {"type": "subtitle", "time": 18353.32, "timestamp": "05:05:53", "text": "嗯，明天见。"}, {"type": "subtitle", "time": 18355.15, "timestamp": "05:05:55", "text": "[音乐]"}]
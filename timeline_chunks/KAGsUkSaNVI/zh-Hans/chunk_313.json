[{"type": "subtitle", "time": 18781.99, "timestamp": "05:13:01", "text": "伙计们。咱们玩吧，我要玩《毁灭战士》。"}, {"type": "subtitle", "time": 18783.23, "timestamp": "05:13:03", "text": "匹配"}, {"type": "subtitle", "time": 18786.13, "timestamp": "05:13:06", "text": "实际上还有更多"}, {"type": "subtitle", "time": 18792.19, "timestamp": "05:13:12", "text": "移动。我们开始吧"}, {"type": "subtitle", "time": 18795.83, "timestamp": "05:13:15", "text": "去。顺便说一句，我又回来了。说"}, {"type": "subtitle", "time": 18799.868, "timestamp": "05:13:19", "text": "[音乐]"}, {"type": "subtitle", "time": 18803.92, "timestamp": "05:13:23", "text": "你好。一些茶。红茶。"}, {"type": "subtitle", "time": 18820.67, "timestamp": "05:13:40", "text": "创始人。"}, {"type": "subtitle", "time": 18823.59, "timestamp": "05:13:43", "text": "圣托鲁姆。这件事你只能靠自己了。"}, {"type": "subtitle", "time": 18827.03, "timestamp": "05:13:47", "text": "时间宝贵，所以要慎重选择。谨慎选择。"}, {"type": "subtitle", "time": 18830.39, "timestamp": "05:13:50", "text": "她说：“有人赢得了这场战斗。”"}, {"type": "subtitle", "time": 18839.11, "timestamp": "05:13:59", "text": "倒计时 5 4 3 2 1 开始。"}]
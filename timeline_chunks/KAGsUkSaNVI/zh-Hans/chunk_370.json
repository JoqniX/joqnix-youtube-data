[{"type": "subtitle", "time": 22204.67, "timestamp": "06:10:04", "text": "这让我想要"}, {"type": "subtitle", "time": 22213.83, "timestamp": "06:10:13", "text": "困得不行。我只想睡觉"}, {"type": "subtitle", "time": 22216.03, "timestamp": "06:10:16", "text": "和"}, {"type": "subtitle", "time": 22220.628, "timestamp": "06:10:20", "text": "空调制冷。我知道我妈妈的事，她"}, {"type": "subtitle", "time": 22223.708, "timestamp": "06:10:23", "text": "她离不开空调。一如既往"}, {"type": "subtitle", "time": 22227.43, "timestamp": "06:10:27", "text": "空调和我没有空调的生活"}, {"type": "subtitle", "time": 22232.59, "timestamp": "06:10:32", "text": "已经有一段时间了。当我沉浸在"}, {"type": "subtitle", "time": 22237.51, "timestamp": "06:10:37", "text": "空调，我经常会遇到……嗯，该怎么称呼呢？"}, {"type": "subtitle", "time": 22240.19, "timestamp": "06:10:40", "text": "它？寒冷而"}, {"type": "subtitle", "time": 22243.868, "timestamp": "06:10:43", "text": "东西。可能发烧，也可能长了疙瘩。"}, {"type": "subtitle", "time": 22257.88, "timestamp": "06:10:57", "text": "我不明白为什么没人玩短线。"}]
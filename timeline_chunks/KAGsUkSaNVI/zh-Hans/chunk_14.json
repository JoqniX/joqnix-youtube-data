[{"type": "subtitle", "time": 843.35, "timestamp": "00:14:03", "text": "呃，我看到了Love Son发的帖子，什么？"}, {"type": "subtitle", "time": 845.269, "timestamp": "00:14:05", "text": "她利用自己的 YouTube 会员资格做到了这一点。"}, {"type": "subtitle", "time": 849.35, "timestamp": "00:14:09", "text": "东西。她发了一整篇帖子……"}, {"type": "subtitle", "time": 853.189, "timestamp": "00:14:13", "text": "给人们提供类似指导方针之类的东西"}, {"type": "chat", "time": 855.373, "timestamp": "00:14:15", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "thats why i have stopped midnight snacks too"}, {"type": "subtitle", "time": 856.31, "timestamp": "00:14:16", "text": "如何加入会员等等。"}, {"type": "subtitle", "time": 859.35, "timestamp": "00:14:19", "text": "你可以期待什么？为什么？呃，所有"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "那些东西太酷了，我！"}, {"type": "subtitle", "time": 864.23, "timestamp": "00:14:24", "text": "我也应该想到这一点。那是"}, {"type": "subtitle", "time": 867.59, "timestamp": "00:14:27", "text": "太酷了。我明白了，我喜欢这个事实"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "看着我那些富有创造力的朋友们……"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "其他创作者在某种程度上激励了我。"}, {"type": "subtitle", "time": 874.949, "timestamp": "00:14:34", "text": "你知道，我也想这样做"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "类似那样的东西，但是"}, {"type": "subtitle", "time": 882.11, "timestamp": "00:14:42", "text": "在我自己的混音中，在我自己的混音中"}, {"type": "subtitle", "time": 891.43, "timestamp": "00:14:51", "text": "是的，我也应该做点类似的事情。"}, {"type": "subtitle", "time": 894.71, "timestamp": "00:14:54", "text": "那是因为知道的人不多。"}, {"type": "subtitle", "time": 896.949, "timestamp": "00:14:56", "text": "那是一种会员制的东西"}, {"type": "subtitle", "time": 898.99, "timestamp": "00:14:58", "text": "一个"}]
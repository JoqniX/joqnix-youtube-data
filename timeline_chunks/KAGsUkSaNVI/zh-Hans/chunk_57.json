[{"type": "subtitle", "time": 3427.43, "timestamp": "00:57:07", "text": "总会来的。"}, {"type": "subtitle", "time": 3429.349, "timestamp": "00:57:09", "text": "这里到处都是血迹。"}, {"type": "subtitle", "time": 3431.99, "timestamp": "00:57:11", "text": "道路。"}, {"type": "subtitle", "time": 3435.349, "timestamp": "00:57:15", "text": "我错了吗？"}, {"type": "subtitle", "time": 3437.27, "timestamp": "00:57:17", "text": "没关系。我们可以只是这些只是"}, {"type": "subtitle", "time": 3438.95, "timestamp": "00:57:18", "text": "就像失去亲人一样。就像我可以这样"}, {"type": "subtitle", "time": 3441.589, "timestamp": "00:57:21", "text": "如果他们想的话，就把他们都踩扁。呃，让我"}, {"type": "subtitle", "time": 3444.069, "timestamp": "00:57:24", "text": "跺脚踢其中一个。没关系。"}, {"type": "subtitle", "time": 3446.63, "timestamp": "00:57:26", "text": "什么？"}, {"type": "subtitle", "time": 3450.63, "timestamp": "00:57:30", "text": "哦。哦，你看。拿起"}, {"type": "subtitle", "time": 3452.15, "timestamp": "00:57:32", "text": "盔甲。"}, {"type": "subtitle", "time": 3453.67, "timestamp": "00:57:33", "text": "好的。"}, {"type": "subtitle", "time": 3455.99, "timestamp": "00:57:35", "text": "真的什么都带不动了。"}, {"type": "subtitle", "time": 3458.309, "timestamp": "00:57:38", "text": "等等，是你捡到弹药还是我捡到的？我"}, {"type": "subtitle", "time": 3460.71, "timestamp": "00:57:40", "text": "但我有这个能力。"}, {"type": "subtitle", "time": 3463.43, "timestamp": "00:57:43", "text": "我也有这种能力。好的，那就好。"}, {"type": "subtitle", "time": 3467.349, "timestamp": "00:57:47", "text": "哦，这张脸好诡异。是的，我做了。"}, {"type": "subtitle", "time": 3469.95, "timestamp": "00:57:49", "text": "是的。"}]
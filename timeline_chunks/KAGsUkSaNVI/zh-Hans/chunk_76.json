[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "夹在门上。当然，那是"}, {"type": "subtitle", "time": 4563.51, "timestamp": "01:16:03", "text": "这其实很有道理。听着，你"}, {"type": "subtitle", "time": 4566.229, "timestamp": "01:16:06", "text": "你可以进来吗？来吧。你"}, {"type": "subtitle", "time": 4570.47, "timestamp": "01:16:10", "text": "不安全。坚持，稍等。真的吗？"}, {"type": "subtitle", "time": 4572.79, "timestamp": "01:16:12", "text": "真的吗？快点。我的天啊。你是"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "比这好得多。快点。我在里面"}, {"type": "subtitle", "time": 4577.83, "timestamp": "01:16:17", "text": "时钟。请给我一个钟。好的。能"}, {"type": "subtitle", "time": 4579.35, "timestamp": "01:16:19", "text": "你能自己解谜题吗？"}, {"type": "subtitle", "time": 4580.63, "timestamp": "01:16:20", "text": "我玩得很开心。是的。是的。"}, {"type": "subtitle", "time": 4583.189, "timestamp": "01:16:23", "text": "好的。好的。你玩得开心。"}, {"type": "subtitle", "time": 4586.55, "timestamp": "01:16:26", "text": "嘿，伙计。哥们儿，最近怎么样？"}, {"type": "subtitle", "time": 4588.07, "timestamp": "01:16:28", "text": "哟，你说得对，查德。这个地方是"}, {"type": "subtitle", "time": 4593.669, "timestamp": "01:16:33", "text": "我很高兴自己并不害怕，仅仅因为我"}, {"type": "subtitle", "time": 4596.55, "timestamp": "01:16:36", "text": "看了速通视频。想象一下如果我"}, {"type": "subtitle", "time": 4598.87, "timestamp": "01:16:38", "text": "没看的话我会哭的。不，不"}, {"type": "subtitle", "time": 4600.87, "timestamp": "01:16:40", "text": "不。没关系。顺便一提，速通"}, {"type": "subtitle", "time": 4602.95, "timestamp": "01:16:42", "text": "就像……那该怎么称呼呢？"}, {"type": "subtitle", "time": 4604.51, "timestamp": "01:16:44", "text": "那"}, {"type": "subtitle", "time": 4607.43, "timestamp": "01:16:47", "text": "谜题。不是后面的房间"}, {"type": "subtitle", "time": 4609.59, "timestamp": "01:16:49", "text": "恼人的。这是拼图放大图"}, {"type": "subtitle", "time": 4612.51, "timestamp": "01:16:52", "text": "其实是游戏。你好。我做了"}, {"type": "subtitle", "time": 4614.95, "timestamp": "01:16:54", "text": "东西。我觉得我做到了。为什么"}, {"type": "subtitle", "time": 4617.51, "timestamp": "01:16:57", "text": "不是？拜托，老兄。"}]
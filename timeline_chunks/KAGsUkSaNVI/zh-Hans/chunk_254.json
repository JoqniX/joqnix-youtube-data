[{"type": "subtitle", "time": 15247.309, "timestamp": "04:14:07", "text": "医生到底说了什么？"}, {"type": "subtitle", "time": 15249.469, "timestamp": "04:14:09", "text": "已下单。一个"}, {"type": "subtitle", "time": 15263.07, "timestamp": "04:14:23", "text": "想想你都做了些什么。"}, {"type": "subtitle", "time": 15265.429, "timestamp": "04:14:25", "text": "城堡。如果我们要……，我们就必须全力以赴。"}, {"type": "subtitle", "time": 15276.309, "timestamp": "04:14:36", "text": "引导我的长矛。我是那束光。"}, {"type": "subtitle", "time": 15279.03, "timestamp": "04:14:39", "text": "黑暗。"}, {"type": "subtitle", "time": 15288.79, "timestamp": "04:14:48", "text": "阶段。任务区域由你负责。不是"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "很不错，是吗？领土"}]
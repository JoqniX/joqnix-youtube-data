[{"type": "subtitle", "time": 23410.708, "timestamp": "06:30:10", "text": "啊，这延迟也太离谱了吧，兄弟。延迟是"}, {"type": "subtitle", "time": 23413.99, "timestamp": "06:30:13", "text": "疯狂的。我不能。我不能。我不能。我"}, {"type": "subtitle", "time": 23422.788, "timestamp": "06:30:22", "text": "嗯，"}, {"type": "subtitle", "time": 23440.468, "timestamp": "06:30:40", "text": "我应该换个平台玩吗？"}, {"type": "subtitle", "time": 23458.07, "timestamp": "06:30:58", "text": "我看上去好肉麻。护理包"}]
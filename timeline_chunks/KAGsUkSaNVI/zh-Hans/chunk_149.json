[{"type": "subtitle", "time": 8942.87, "timestamp": "02:29:02", "text": "一切都到此结束了。不"}, {"type": "subtitle", "time": 8946.15, "timestamp": "02:29:06", "text": "我的手表，亲爱的。"}, {"type": "subtitle", "time": 8965.23, "timestamp": "02:29:25", "text": "外观"}, {"type": "subtitle", "time": 8969.11, "timestamp": "02:29:29", "text": "就像你现在要捕捉的一样。"}, {"type": "subtitle", "time": 8971.429, "timestamp": "02:29:31", "text": "任务区域由你负责。那是"}, {"type": "subtitle", "time": 8973.99, "timestamp": "02:29:33", "text": "令人尴尬。"}, {"type": "subtitle", "time": 8991.27, "timestamp": "02:29:51", "text": "挥动鞭子。"}, {"type": "subtitle", "time": 8994.87, "timestamp": "02:29:54", "text": "别招惹神奇蜘蛛侠。"}]
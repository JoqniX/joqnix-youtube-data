[{"type": "subtitle", "time": 3726.03, "timestamp": "01:02:06", "text": "然后直接"}, {"type": "subtitle", "time": 3728.99, "timestamp": "01:02:08", "text": "直的。正确的。"}, {"type": "subtitle", "time": 3748.47, "timestamp": "01:02:28", "text": "不幸的是，当团队到达时"}, {"type": "subtitle", "time": 3750.51, "timestamp": "01:02:30", "text": "到达目的地后，他们就死了。"}, {"type": "subtitle", "time": 3753.19, "timestamp": "01:02:33", "text": "总共九具尸体。九"}, {"type": "subtitle", "time": 3755.03, "timestamp": "01:02:35", "text": "尸体。"}, {"type": "subtitle", "time": 3757.27, "timestamp": "01:02:37", "text": "团队全部收集完毕。所以，我们有 I"}, {"type": "subtitle", "time": 3761.67, "timestamp": "01:02:41", "text": "你有牙齿，而且我觉得它是"}, {"type": "subtitle", "time": 3764.15, "timestamp": "01:02:44", "text": "蚂蚁之类的东西。部分尸体"}, {"type": "subtitle", "time": 3766.15, "timestamp": "01:02:46", "text": "已找到。你的身体部位是什么？"}, {"type": "subtitle", "time": 3770.39, "timestamp": "01:02:50", "text": "库存里有什么？查一下就行。"}, {"type": "subtitle", "time": 3774.47, "timestamp": "01:02:54", "text": "一根手指。好的，珍妮弗。"}, {"type": "subtitle", "time": 3779.789, "timestamp": "01:02:59", "text": "詹妮弗·马利掉了牙。詹妮弗"}]
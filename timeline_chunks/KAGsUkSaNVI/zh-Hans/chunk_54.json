[{"type": "subtitle", "time": 3242.47, "timestamp": "00:54:02", "text": "降低。是的，我觉得自己疯了。给我一个"}, {"type": "subtitle", "time": 3245.79, "timestamp": "00:54:05", "text": "第二。我会像吃药一样服用。"}, {"type": "subtitle", "time": 3248.75, "timestamp": "00:54:08", "text": "是的。好的。等等，你怎么知道的？"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "你是不是疯了？呃，"}, {"type": "subtitle", "time": 3254.63, "timestamp": "00:54:14", "text": "你有点迷糊了。你在哪里？哦，我的"}, {"type": "subtitle", "time": 3256.95, "timestamp": "00:54:16", "text": "上帝。查克，过来。我正在速通"}, {"type": "subtitle", "time": 3258.79, "timestamp": "00:54:18", "text": "游戏。耶稣基督，人啊。我就在附近"}, {"type": "subtitle", "time": 3260.47, "timestamp": "00:54:20", "text": "你。"}, {"type": "subtitle", "time": 3263.91, "timestamp": "00:54:23", "text": "那是红色的吗？那是不是有点红？你是"}, {"type": "subtitle", "time": 3266.15, "timestamp": "00:54:26", "text": "将会遇到细菌。"}, {"type": "subtitle", "time": 3268.63, "timestamp": "00:54:28", "text": "细菌。什么？"}, {"type": "subtitle", "time": 3271.91, "timestamp": "00:54:31", "text": "就是那个卖面条的家伙。啊，"}, {"type": "subtitle", "time": 3275.349, "timestamp": "00:54:35", "text": "面条男。想跟你打个招呼"}, {"type": "subtitle", "time": 3279.51, "timestamp": "00:54:39", "text": "他？当然可以。想去打个招呼吗？哦，"}, {"type": "subtitle", "time": 3282.15, "timestamp": "00:54:42", "text": "好的。你能别再消失了吗？"}, {"type": "subtitle", "time": 3285.829, "timestamp": "00:54:45", "text": "耶稣基督。对不起。"}, {"type": "subtitle", "time": 3290.069, "timestamp": "00:54:50", "text": "哦，是的。哦好的。我们是不是应该放慢速度？"}, {"type": "subtitle", "time": 3294.23, "timestamp": "00:54:54", "text": "然后？美好的。我只是快速前进。"}, {"type": "subtitle", "time": 3296.47, "timestamp": "00:54:56", "text": "因为我不想哭，对吧？"}, {"type": "subtitle", "time": 3298.79, "timestamp": "00:54:58", "text": "我？"}]
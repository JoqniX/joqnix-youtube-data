[{"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "它运行良好。呃，有人问我一个问题"}, {"type": "subtitle", "time": 1935.029, "timestamp": "00:32:15", "text": "问题。你看过动漫吗？"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "最近？哦，我刚才在看一个"}, {"type": "subtitle", "time": 1941.59, "timestamp": "00:32:21", "text": "一边吃饭一边看动漫。"}, {"type": "subtitle", "time": 1945.549, "timestamp": "00:32:25", "text": "是哪部动漫呢？呃，它叫"}, {"type": "subtitle", "time": 1948.19, "timestamp": "00:32:28", "text": "沙伊。它叫做"}, {"type": "subtitle", "time": 1951.029, "timestamp": "00:32:31", "text": "沙伊。和"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "我喜欢这个动画。我喜欢这样"}, {"type": "subtitle", "time": 1956.95, "timestamp": "00:32:36", "text": "开头的过场动画。我喜欢这个。我参加了"}, {"type": "subtitle", "time": 1960.07, "timestamp": "00:32:40", "text": "非常喜欢。"}, {"type": "subtitle", "time": 1969.19, "timestamp": "00:32:49", "text": "它不起作用，但是你知道，它是"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "依然是一部杰作。是的，那就是我"}, {"type": "subtitle", "time": 1974.19, "timestamp": "00:32:54", "text": "猜测。"}, {"type": "subtitle", "time": 1977.59, "timestamp": "00:32:57", "text": "我喜欢我现在正在安装我的显卡。"}]
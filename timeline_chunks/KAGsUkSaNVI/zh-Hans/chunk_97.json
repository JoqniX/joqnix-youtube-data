[{"type": "subtitle", "time": 5821.43, "timestamp": "01:37:01", "text": "没有任何。感谢这场雨。我不"}, {"type": "subtitle", "time": 5823.35, "timestamp": "01:37:03", "text": "知道你是否还在，但补充"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "为了下雨。非常抱歉我迟到了。"}, {"type": "chat", "time": 5827.461, "timestamp": "01:37:07", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "my question is, which viewer would care to that level that they NEED to know exactly for what reason you're brb-ing and what kind of a task it is"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "我花了多长时间？嗯，30分钟。是的，我"}, {"type": "subtitle", "time": 5833.189, "timestamp": "01:37:13", "text": "刚才不是说30分钟吗？这"}, {"type": "chat", "time": 5839.114, "timestamp": "01:37:19", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "THAT WAS A VOD?, i thought that was you playing 😆"}, {"type": "subtitle", "time": 5842.39, "timestamp": "01:37:22", "text": "下午。我的问题是，哪条路？"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "需要关注的层面是"}, {"type": "subtitle", "time": 5846.07, "timestamp": "01:37:26", "text": "他们必须没有理由，除非……"}, {"type": "subtitle", "time": 5847.91, "timestamp": "01:37:27", "text": "你正在做什么，以及你正在执行什么类型的任务。"}, {"type": "subtitle", "time": 5851.31, "timestamp": "01:37:31", "text": "是？我当时以为是你。"}, {"type": "subtitle", "time": 5856.149, "timestamp": "01:37:36", "text": "正在播放。我的天哪。我应该怎么办"}, {"type": "subtitle", "time": 5858.229, "timestamp": "01:37:38", "text": "这样人们就能明白我是"}, {"type": "subtitle", "time": 5861.669, "timestamp": "01:37:41", "text": "不在那里，而且是个V字形。我甚至目测都……"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "保留了那个小玩意儿，一个小家伙"}, {"type": "subtitle", "time": 5867.91, "timestamp": "01:37:47", "text": "字面上写的是正在播放的录像。"}, {"type": "subtitle", "time": 5872.07, "timestamp": "01:37:52", "text": "是流，呃，是流板。乔克是"}, {"type": "subtitle", "time": 5875.43, "timestamp": "01:37:55", "text": "如果你不能回来，或者你，jock还会回来的。"}]
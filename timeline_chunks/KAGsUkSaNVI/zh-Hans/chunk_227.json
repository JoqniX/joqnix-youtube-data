[{"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "[音乐]"}, {"type": "subtitle", "time": 13637.99, "timestamp": "03:47:17", "text": "哦，所有的工作都完成了。 30秒"}, {"type": "subtitle", "time": 13640.07, "timestamp": "03:47:20", "text": "在你终结这个宇宙之前。但"}, {"type": "subtitle", "time": 13642.71, "timestamp": "03:47:22", "text": "不知为何，我总是能发现最糟糕的部分。"}, {"type": "subtitle", "time": 13646.07, "timestamp": "03:47:26", "text": "亲爱的，这可是高级定制时装。设计"}, {"type": "subtitle", "time": 13649.59, "timestamp": "03:47:29", "text": "由巨型康乃馨本​​人撰写。"}, {"type": "subtitle", "time": 13652.469, "timestamp": "03:47:32", "text": "哦，我的服装是自己带的。"}, {"type": "subtitle", "time": 13655.51, "timestamp": "03:47:35", "text": "权力。我几乎亲眼目睹了"}, {"type": "subtitle", "time": 13661.99, "timestamp": "03:47:41", "text": "[音乐]"}, {"type": "subtitle", "time": 13666.15, "timestamp": "03:47:46", "text": "战斗倒计时开始，五、四、三！"}, {"type": "subtitle", "time": 13668.15, "timestamp": "03:47:48", "text": "二。你只需要捕捉到"}, {"type": "subtitle", "time": 13671.55, "timestamp": "03:47:51", "text": "任务区域。知道了。这身装扮"}, {"type": "subtitle", "time": 13675.59, "timestamp": "03:47:55", "text": "在那里付钱。"}]
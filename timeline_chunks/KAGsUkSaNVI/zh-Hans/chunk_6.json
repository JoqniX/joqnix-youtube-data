[{"type": "subtitle", "time": 361.67, "timestamp": "00:06:01", "text": "月份，当我们开始七月六月的时候"}, {"type": "subtitle", "time": 363.629, "timestamp": "00:06:03", "text": "会吗？将会是"}, {"type": "subtitle", "time": 368.07, "timestamp": "00:06:08", "text": "80到100左右，我们会做的"}, {"type": "subtitle", "time": 370.99, "timestamp": "00:06:10", "text": "直到100"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "有可能，但我认为我做不到100个。"}, {"type": "subtitle", "time": 376.95, "timestamp": "00:06:16", "text": "是的，最多也就90度左右。"}, {"type": "subtitle", "time": 380.43, "timestamp": "00:06:20", "text": "令人遗憾的是。但没关系。它是"}, {"type": "subtitle", "time": 384.309, "timestamp": "00:06:24", "text": "好的。除非我认为……，否则这场马拉松不会结束。"}, {"type": "subtitle", "time": 389.469, "timestamp": "00:06:29", "text": "你知道，这件事终究会以某种方式结束。"}, {"type": "subtitle", "time": 392.30899999999997, "timestamp": "00:06:32", "text": "嗯，我还没决定我"}, {"type": "subtitle", "time": 394.83, "timestamp": "00:06:34", "text": "之后应该这样做"}, {"type": "subtitle", "time": 396.749, "timestamp": "00:06:36", "text": "工作。"}, {"type": "subtitle", "time": 406.87, "timestamp": "00:06:46", "text": "S，不过，嘿，今天我要玩的东西。"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "漫威劲敌。我刚下载了。我"}, {"type": "subtitle", "time": 411.67, "timestamp": "00:06:51", "text": "我只是想看看那场比赛会怎么发展。"}, {"type": "subtitle", "time": 413.51, "timestamp": "00:06:53", "text": "作品。如果行不通，我会"}, {"type": "subtitle", "time": 416.07, "timestamp": "00:06:56", "text": "卸载它。我有一个摄影合作项目"}, {"type": "subtitle", "time": 417.30899999999997, "timestamp": "00:06:57", "text": "做"}]
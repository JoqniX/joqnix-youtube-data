[{"type": "subtitle", "time": 18976.31, "timestamp": "05:16:16", "text": "但是这个功夫熊猫。我的天啊。"}, {"type": "subtitle", "time": 18990.07, "timestamp": "05:16:30", "text": "发明他的人应该去死。这里"}, {"type": "subtitle", "time": 18992.868, "timestamp": "05:16:32", "text": "他们来了。"}, {"type": "subtitle", "time": 19006.07, "timestamp": "05:16:46", "text": "这很难。别想把我打倒"}]
[{"type": "subtitle", "time": 4860.149, "timestamp": "01:21:00", "text": "实际上，一枪就能把我们杀死。好的，"}, {"type": "subtitle", "time": 4862.149, "timestamp": "01:21:02", "text": "这就是房子，这就是这个"}, {"type": "subtitle", "time": 4862.83, "timestamp": "01:21:02", "text": "是"}, {"type": "subtitle", "time": 4866.87, "timestamp": "01:21:06", "text": "放射性物质。哦，他来了。哦，来"}, {"type": "subtitle", "time": 4870.46, "timestamp": "01:21:10", "text": "在。你身上有股臭味。快点。"}, {"type": "subtitle", "time": 4872.39, "timestamp": "01:21:12", "text": "[音乐]"}, {"type": "subtitle", "time": 4874.47, "timestamp": "01:21:14", "text": "他现在一点也不可怕了。他就像……"}, {"type": "subtitle", "time": 4882.27, "timestamp": "01:21:22", "text": "哦，他让我们"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "疯狂的。我们不能像那样闲逛"}, {"type": "subtitle", "time": 4887.189, "timestamp": "01:21:27", "text": "他经常……放射治疗室。下一个区域是"}, {"type": "subtitle", "time": 4888.51, "timestamp": "01:21:28", "text": "完全"}, {"type": "subtitle", "time": 4890.11, "timestamp": "01:21:30", "text": "收音机"}, {"type": "subtitle", "time": 4893.07, "timestamp": "01:21:33", "text": "危险品。房间里的一些物品是"}, {"type": "subtitle", "time": 4896.709, "timestamp": "01:21:36", "text": "污染。所以，伙计，呃，我们该怎么做？"}, {"type": "subtitle", "time": 4899.189, "timestamp": "01:21:39", "text": "找到灭火器了吗？"}, {"type": "subtitle", "time": 4901.99, "timestamp": "01:21:41", "text": "有一个危险品处理场所，我可以在那里拿到"}, {"type": "subtitle", "time": 4904.79, "timestamp": "01:21:44", "text": "顺便提一下，我穿的是防护服。那么，在哪里？"}, {"type": "subtitle", "time": 4909.11, "timestamp": "01:21:49", "text": "我们现在就需要找到它。是的。是的。"}, {"type": "subtitle", "time": 4911.59, "timestamp": "01:21:51", "text": "我们走吧。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "哦，是的。我疯了。稍等片刻。"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "你在哪里？我离目标很近，我被击中了。我得到了"}]
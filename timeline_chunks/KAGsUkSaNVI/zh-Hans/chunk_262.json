[{"type": "subtitle", "time": 15730.67, "timestamp": "04:22:10", "text": "嗯？哇！我从未"}, {"type": "subtitle", "time": 15735.11, "timestamp": "04:22:15", "text": "错过。我们有客人来了。"}, {"type": "subtitle", "time": 15738.55, "timestamp": "04:22:18", "text": "不能碰。刷屏。狙击手。"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "蜘蛛侠。"}, {"type": "subtitle", "time": 15751.71, "timestamp": "04:22:31", "text": "他来自哪里？"}, {"type": "subtitle", "time": 15754.95, "timestamp": "04:22:34", "text": "队伍已过半程。艾玛的"}, {"type": "subtitle", "time": 15777.189, "timestamp": "04:22:57", "text": "首先赐予我们胜利。"}, {"type": "subtitle", "time": 15778.71, "timestamp": "04:22:58", "text": "你必须坚持战斗，直到我们"}]
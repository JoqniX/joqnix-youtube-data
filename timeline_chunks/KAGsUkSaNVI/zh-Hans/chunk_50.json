[{"type": "subtitle", "time": 3000.87, "timestamp": "00:50:00", "text": "不要尖叫。我不想。"}, {"type": "subtitle", "time": 3002.23, "timestamp": "00:50:02", "text": "你在哪里？你去哪儿？在哪里"}, {"type": "subtitle", "time": 3004.23, "timestamp": "00:50:04", "text": "你去了吗？在哪里？好的。我在这里。我是"}, {"type": "subtitle", "time": 3006.19, "timestamp": "00:50:06", "text": "这里。我在这里。"}, {"type": "subtitle", "time": 3009.91, "timestamp": "00:50:09", "text": "好的。请务必关注。"}, {"type": "subtitle", "time": 3014.03, "timestamp": "00:50:14", "text": "是的。我们尽力而为。所以，"}, {"type": "subtitle", "time": 3019.589, "timestamp": "00:50:19", "text": "首先，我认为我们需要得到"}, {"type": "subtitle", "time": 3021.75, "timestamp": "00:50:21", "text": "我的天啊，这游戏崩溃了好多次"}, {"type": "subtitle", "time": 3024.71, "timestamp": "00:50:24", "text": "疯了吧，老兄。等等，它崩溃了。在哪里"}, {"type": "subtitle", "time": 3033.069, "timestamp": "00:50:33", "text": "好了，我们需要找到那盘VHS录像带。"}, {"type": "subtitle", "time": 3035.79, "timestamp": "00:50:35", "text": "一。你知道那是哪里吗？"}, {"type": "subtitle", "time": 3038.39, "timestamp": "00:50:38", "text": "是啊，我忘了。"}, {"type": "subtitle", "time": 3045.19, "timestamp": "00:50:45", "text": "我喜欢你表达的方式。"}, {"type": "subtitle", "time": 3047.03, "timestamp": "00:50:47", "text": "你自己。我的天哪，约翰，我把你弄丢了。"}, {"type": "subtitle", "time": 3052.309, "timestamp": "00:50:52", "text": "好的，这里有一些女性的尖叫声。"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "没关系。"}, {"type": "subtitle", "time": 3056.71, "timestamp": "00:50:56", "text": "你不能说“女孩”，是吗？"}, {"type": "subtitle", "time": 3059.829, "timestamp": "00:50:59", "text": "你不能只说“女孩”。女性。耶稣"}]
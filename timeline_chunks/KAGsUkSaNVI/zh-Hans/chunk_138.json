[{"type": "subtitle", "time": 8283.83, "timestamp": "02:18:03", "text": "小心。回来吧，伙计们。"}, {"type": "subtitle", "time": 8286.87, "timestamp": "02:18:06", "text": "双杀。"}, {"type": "subtitle", "time": 8292.389, "timestamp": "02:18:12", "text": "那是三个。我可以砍杀。我从未失手。"}, {"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "哇。连胜四场。通常你必须"}, {"type": "subtitle", "time": 8297.589, "timestamp": "02:18:17", "text": "引导目标。用这支箭不行。"}, {"type": "subtitle", "time": 8300.79, "timestamp": "02:18:20", "text": "太棒了。好的。六连胜。方式"}, {"type": "subtitle", "time": 8304.629, "timestamp": "02:18:24", "text": "走吧。难以置信。"}, {"type": "subtitle", "time": 8305.629, "timestamp": "02:18:25", "text": "我得到了"}]
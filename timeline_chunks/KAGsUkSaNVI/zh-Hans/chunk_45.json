[{"type": "subtitle", "time": 2702.23, "timestamp": "00:45:02", "text": "好的。还有Instagram上的照片。等待，"}, {"type": "subtitle", "time": 2705.03, "timestamp": "00:45:05", "text": "对了，你说你喜欢什么？"}, {"type": "subtitle", "time": 2706.95, "timestamp": "00:45:06", "text": "你管这叫什么？是的。你说就像"}, {"type": "subtitle", "time": 2708.71, "timestamp": "00:45:08", "text": "你就像在看速通比赛一样"}, {"type": "subtitle", "time": 2712.47, "timestamp": "00:45:12", "text": "是这样，对吧？是的，我不小心这么做了"}, {"type": "subtitle", "time": 2715.99, "timestamp": "00:45:15", "text": "今天。我当时就想，嗯，这游戏真不错。"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "如果有人速通的话，那就是了。"}, {"type": "subtitle", "time": 2721.589, "timestamp": "00:45:21", "text": "我看了个25分钟的速通视频。我当时"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "感觉我有一半时间都在……"}, {"type": "subtitle", "time": 2728.15, "timestamp": "00:45:28", "text": "嘴巴像所有模式下一样张开着。我是"}, {"type": "subtitle", "time": 2730.03, "timestamp": "00:45:30", "text": "喜欢"}, {"type": "subtitle", "time": 2733.67, "timestamp": "00:45:33", "text": "哇，这家伙速度也太快了吧！"}, {"type": "subtitle", "time": 2737.27, "timestamp": "00:45:37", "text": "东西，他就像真的在走路一样。"}, {"type": "subtitle", "time": 2739.99, "timestamp": "00:45:39", "text": "对实体而言，就像什么都没有一样"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "他们服用抗焦虑药，然后"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "消失，就像冷静下来一样"}, {"type": "subtitle", "time": 2748.27, "timestamp": "00:45:48", "text": "某物。我当时就想，嗯，那是……"}, {"type": "subtitle", "time": 2751.109, "timestamp": "00:45:51", "text": "这是我们能做的。我们不喜欢跑步"}, {"type": "subtitle", "time": 2752.87, "timestamp": "00:45:52", "text": "远离实体某种程度。我们确实"}, {"type": "subtitle", "time": 2755.27, "timestamp": "00:45:55", "text": "他也朝那个方向走去。是的。是的。是的。"}, {"type": "subtitle", "time": 2757.04, "timestamp": "00:45:57", "text": "是的。 二。"}, {"type": "subtitle", "time": 2758.56, "timestamp": "00:45:58", "text": "二。 是的。你好，Hex Jama。是的。你好，凯莎。"}]
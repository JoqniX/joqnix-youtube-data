[{"type": "subtitle", "time": 4081.39, "timestamp": "01:08:01", "text": "猜测。"}, {"type": "subtitle", "time": 4083.71, "timestamp": "01:08:03", "text": "一直都是这样吗？"}, {"type": "subtitle", "time": 4086.63, "timestamp": "01:08:06", "text": "附近？哦，"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "你找到那扇打开的白色门了吗？"}, {"type": "subtitle", "time": 4092.95, "timestamp": "01:08:12", "text": "白色门？就像微微张开的一样。"}, {"type": "subtitle", "time": 4096.349, "timestamp": "01:08:16", "text": "好的，我正在等待……"}, {"type": "subtitle", "time": 4103.47, "timestamp": "01:08:23", "text": "H什么"}, {"type": "subtitle", "time": 4106.309, "timestamp": "01:08:26", "text": "发生了吗？你收到了吗？就这些吗？是"}, {"type": "subtitle", "time": 4110.39, "timestamp": "01:08:30", "text": "就这些吗？这会更难。好的。耶。我"}, {"type": "subtitle", "time": 4123.349, "timestamp": "01:08:43", "text": "先生和有线电视安装工在那边。"}, {"type": "subtitle", "time": 4125.99, "timestamp": "01:08:45", "text": "穴居人。有线电视安装工已经过来了。"}, {"type": "subtitle", "time": 4129.03, "timestamp": "01:08:49", "text": "径直向前。我们将前往这里。"}, {"type": "subtitle", "time": 4133.59, "timestamp": "01:08:53", "text": "到那个身体。我们公布了我们的研究结果。"}, {"type": "subtitle", "time": 4137.669, "timestamp": "01:08:57", "text": "所以，中间最上面的那个人……"}]
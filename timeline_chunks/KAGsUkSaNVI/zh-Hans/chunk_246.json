[{"type": "subtitle", "time": 14768.71, "timestamp": "04:06:08", "text": "烹饪。我的天啊。他叫什么名字？"}, {"type": "subtitle", "time": 14771.75, "timestamp": "04:06:11", "text": "铁拳。我的天啊。我回来了，宝贝。"}, {"type": "subtitle", "time": 14774.229, "timestamp": "04:06:14", "text": "我要杀了你。看着我。等待"}, {"type": "subtitle", "time": 14801.51, "timestamp": "04:06:41", "text": "等等，护盾。甜的。"}, {"type": "subtitle", "time": 14805.71, "timestamp": "04:06:45", "text": "哦，兄弟，这把枪。啊，那太好了。"}, {"type": "subtitle", "time": 14809.269, "timestamp": "04:06:49", "text": "库姆。我要去……我应该拿个F吗？"}, {"type": "subtitle", "time": 14810.87, "timestamp": "04:06:50", "text": "某物，"}]
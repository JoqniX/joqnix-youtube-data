[{"type": "subtitle", "time": 5580.39, "timestamp": "01:33:00", "text": "你们待在这儿。"}, {"type": "subtitle", "time": 5582.709, "timestamp": "01:33:02", "text": "哦好的。没关系。诡异的脸是"}, {"type": "subtitle", "time": 5585.91, "timestamp": "01:33:05", "text": "就在我们右侧旁边。别看。"}, {"type": "subtitle", "time": 5587.51, "timestamp": "01:33:07", "text": "别看。别看。就在那边。"}, {"type": "subtitle", "time": 5589.43, "timestamp": "01:33:09", "text": "他在那边。哦，它在那里。他是"}, {"type": "subtitle", "time": 5591.99, "timestamp": "01:33:11", "text": "那里。它不像直走那样或"}, {"type": "subtitle", "time": 5595.31, "timestamp": "01:33:15", "text": "某物。他就像在角落里一样。"}, {"type": "subtitle", "time": 5598.629, "timestamp": "01:33:18", "text": "微笑。真是太好了。哦。哦，他是"}, {"type": "subtitle", "time": 5600.31, "timestamp": "01:33:20", "text": "走了。"}, {"type": "subtitle", "time": 5602.87, "timestamp": "01:33:22", "text": "他走了。好的。好的。现在，我尝试"}, {"type": "subtitle", "time": 5605.47, "timestamp": "01:33:25", "text": "打开另一个"}, {"type": "subtitle", "time": 5608.39, "timestamp": "01:33:28", "text": "一。你打开了红色保险丝。"}, {"type": "subtitle", "time": 5610.79, "timestamp": "01:33:30", "text": "正确的？我要把它关掉。一个人的"}, {"type": "subtitle", "time": 5612.229, "timestamp": "01:33:32", "text": "走了。走了一个。中间那个不见了"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "现在。现在呢？哦，那个那个"}, {"type": "subtitle", "time": 5617.75, "timestamp": "01:33:37", "text": "第三个亮着，但中间那个……"}, {"type": "subtitle", "time": 5629.669, "timestamp": "01:33:49", "text": "哦，我搞砸了吗？"}, {"type": "subtitle", "time": 5633.07, "timestamp": "01:33:53", "text": "没有。所以，等等。"}]
[{"type": "subtitle", "time": 6300.87, "timestamp": "01:45:00", "text": "疼痛。我还看到了尚山，欢迎。"}, {"type": "subtitle", "time": 6302.229, "timestamp": "01:45:02", "text": "我不知道你是否还在那里，但是"}, {"type": "subtitle", "time": 6304.39, "timestamp": "01:45:04", "text": "是啊，我正在刷聊天记录，还有我的摩托车。"}, {"type": "subtitle", "time": 6311.03, "timestamp": "01:45:11", "text": "呃，珍，你好。还有忍者，你好。"}, {"type": "subtitle", "time": 6314.55, "timestamp": "01:45:14", "text": "克洛诺斯，你好。你好。伊萨米萨，我不"}, {"type": "subtitle", "time": 6315.83, "timestamp": "01:45:15", "text": "不知道你是否还在，但还是要谢谢你。"}, {"type": "subtitle", "time": 6318.629, "timestamp": "01:45:18", "text": "为了突袭和你好。晚上好。"}, {"type": "chat", "time": 6326.42, "timestamp": "01:45:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yes, good morning"}, {"type": "subtitle", "time": 6328.47, "timestamp": "01:45:28", "text": "下午。好的。呃，乔以前做过"}, {"type": "subtitle", "time": 6330.629, "timestamp": "01:45:30", "text": "这些。是的，我以前拍过恐怖片。"}, {"type": "chat", "time": 6332.322, "timestamp": "01:45:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "time to have breakfast"}, {"type": "subtitle", "time": 6333.109, "timestamp": "01:45:33", "text": "以前的东西。并非如此"}, {"type": "subtitle", "time": 6336.07, "timestamp": "01:45:36", "text": "我正在积极地逃离恐怖或"}, {"type": "subtitle", "time": 6337.99, "timestamp": "01:45:37", "text": "任何事物。这并不是说我们不能做"}, {"type": "subtitle", "time": 6341.55, "timestamp": "01:45:41", "text": "我在日本的时候就不再感到恐怖了。"}, {"type": "subtitle", "time": 6344.31, "timestamp": "01:45:44", "text": "任何事物。但是，是的，当然，我"}, {"type": "subtitle", "time": 6345.47, "timestamp": "01:45:45", "text": "需要做"}, {"type": "subtitle", "time": 6348.709, "timestamp": "01:45:48", "text": "恐怖。当我看到电脑上的游戏时，"}, {"type": "subtitle", "time": 6350.709, "timestamp": "01:45:50", "text": "我心想，兄弟，我得把那件事做完。"}, {"type": "chat", "time": 6355.348, "timestamp": "01:45:55", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "u do actively run way from horror tho 💀"}]
[{"type": "subtitle", "time": 3542.63, "timestamp": "00:59:02", "text": "难道不是这样吗？"}, {"type": "subtitle", "time": 3545.069, "timestamp": "00:59:05", "text": "呃，冷静点。乔，你能行的。呃，亲爱的"}, {"type": "subtitle", "time": 3560.8, "timestamp": "00:59:20", "text": "等待。我稍微扭了一下。"}, {"type": "subtitle", "time": 3562.87, "timestamp": "00:59:22", "text": "[音乐]"}, {"type": "subtitle", "time": 3574.03, "timestamp": "00:59:34", "text": "知道了。哦，等等。我不小心撞到了"}, {"type": "subtitle", "time": 3577.39, "timestamp": "00:59:37", "text": "我。我们走吧。这里我们放置"}, {"type": "subtitle", "time": 3581.589, "timestamp": "00:59:41", "text": "我相信是锁手。哦，是录像带。"}, {"type": "subtitle", "time": 3585.43, "timestamp": "00:59:45", "text": "你想选它吗？好，我们走吧。"}, {"type": "subtitle", "time": 3590.349, "timestamp": "00:59:50", "text": "我们开始吧"}, {"type": "subtitle", "time": 3593.03, "timestamp": "00:59:53", "text": "去。我可以和它互动，但我不会"}]
[{"type": "subtitle", "time": 16202.87, "timestamp": "04:30:02", "text": "我最想拯救世界的人就是他。"}, {"type": "subtitle", "time": 16205.59, "timestamp": "04:30:05", "text": "比你强。彼此彼此，娜特。给我看看"}, {"type": "subtitle", "time": 16209.51, "timestamp": "04:30:09", "text": "在那里我可以有机会体验毁灭。收到。我"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "不得不承认，进入这个圈子很有趣"}, {"type": "subtitle", "time": 16224.79, "timestamp": "04:30:24", "text": "战斗将于 5、4、3、2、1 时开始。"}, {"type": "subtitle", "time": 16226.229, "timestamp": "04:30:26", "text": "你只需要捕捉到"}, {"type": "subtitle", "time": 16228.95, "timestamp": "04:30:28", "text": "任务区域。知道了。"}, {"type": "subtitle", "time": 16230.87, "timestamp": "04:30:30", "text": "知道了。围绕一座城市运行的轨道"}, {"type": "subtitle", "time": 16233.51, "timestamp": "04:30:33", "text": "振金。抓到她了。抓到她了。你"}]
[{"type": "subtitle", "time": 17222.19, "timestamp": "04:47:02", "text": "呃，我的天哪，我"}, {"type": "subtitle", "time": 17225.35, "timestamp": "04:47:05", "text": "忘了。看带字幕的动漫。你学会了。我"}, {"type": "subtitle", "time": 17227.43, "timestamp": "04:47:07", "text": "照做。是的。"}, {"type": "subtitle", "time": 17231.11, "timestamp": "04:47:11", "text": "嗨，我是罗密欧，谢谢你。"}, {"type": "subtitle", "time": 17233.27, "timestamp": "04:47:13", "text": "顺道过来看看。已经很久了……"}, {"type": "subtitle", "time": 17235.07, "timestamp": "04:47:15", "text": "见过你。"}, {"type": "subtitle", "time": 17242.03, "timestamp": "04:47:22", "text": "运气。你好。"}, {"type": "subtitle", "time": 17279.15, "timestamp": "04:47:59", "text": "你好。很好"}]
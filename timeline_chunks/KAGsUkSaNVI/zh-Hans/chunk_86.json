[{"type": "subtitle", "time": 5162.51, "timestamp": "01:26:02", "text": "疯狂的。但别理他。没用"}, {"type": "subtitle", "time": 5164.95, "timestamp": "01:26:04", "text": "实际上。他实际上比别人快得多"}, {"type": "subtitle", "time": 5174.07, "timestamp": "01:26:14", "text": "它只管用了一秒钟。它适用于"}, {"type": "subtitle", "time": 5178.07, "timestamp": "01:26:18", "text": "过了一会儿，他就开始攻击。"}, {"type": "subtitle", "time": 5187.59, "timestamp": "01:26:27", "text": "哦。别死。好的。"}, {"type": "subtitle", "time": 5190.87, "timestamp": "01:26:30", "text": "我觉得我真的会死。他就像"}, {"type": "subtitle", "time": 5194.229, "timestamp": "01:26:34", "text": "陷入困境。哦不，他去世了。是的，我"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "实际上已经死了。"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "那很糟糕。我不能像……我不能像……那样做"}, {"type": "subtitle", "time": 5200.47, "timestamp": "01:26:40", "text": "周围很多地方。没关系。呃，试着复活"}, {"type": "subtitle", "time": 5202.55, "timestamp": "01:26:42", "text": "你自己。"}, {"type": "subtitle", "time": 5206.95, "timestamp": "01:26:46", "text": "是的。总之，我希望门就在附近。"}, {"type": "subtitle", "time": 5209.59, "timestamp": "01:26:49", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 5211.35, "timestamp": "01:26:51", "text": "而且它不像其他地方那样"}, {"type": "subtitle", "time": 5213.35, "timestamp": "01:26:53", "text": "很远。"}, {"type": "subtitle", "time": 5217.669, "timestamp": "01:26:57", "text": "我的天哪。我的天，这家伙。"}]
[{"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "荣耀即将属于你。"}, {"type": "subtitle", "time": 9074.309, "timestamp": "02:31:14", "text": "谁也无法阻止上帝。哦，我被静音了。我"}, {"type": "subtitle", "time": 9076.309, "timestamp": "02:31:16", "text": "刚才在说话，兄弟。我的天啊。我当时"}, {"type": "subtitle", "time": 9090.63, "timestamp": "02:31:30", "text": "你必须坚持战斗，直到我们"}, {"type": "subtitle", "time": 9113.19, "timestamp": "02:31:53", "text": "现在我抓到你了。"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "这些是人工智能。我简直太爱人工智能了。"}, {"type": "subtitle", "time": 9119.51, "timestamp": "02:31:59", "text": "疯狂的。"}]
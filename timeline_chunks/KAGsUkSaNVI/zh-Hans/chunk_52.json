[{"type": "subtitle", "time": 3124.39, "timestamp": "00:52:04", "text": "耳朵，呃，我们取耳朵和牙齿。我得到了"}, {"type": "subtitle", "time": 3127.51, "timestamp": "00:52:07", "text": "耳朵。好的。好的。"}, {"type": "subtitle", "time": 3130.069, "timestamp": "00:52:10", "text": "好的。你吃了吗？好的，很好。"}, {"type": "subtitle", "time": 3138.71, "timestamp": "00:52:18", "text": "哦，吃点抗焦虑药吧。我拿走了。"}, {"type": "subtitle", "time": 3140.95, "timestamp": "00:52:20", "text": "我再也受不了了。我无法接受"}, {"type": "subtitle", "time": 3145.19, "timestamp": "00:52:25", "text": "不再是了。你不能吗？好的。哦，"}, {"type": "subtitle", "time": 3147.87, "timestamp": "00:52:27", "text": "会有一个鬼魂出现。"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "少量。他来了。"}, {"type": "subtitle", "time": 3152.87, "timestamp": "00:52:32", "text": "在哪里？"}, {"type": "subtitle", "time": 3160.87, "timestamp": "00:52:40", "text": "不，我们只是用胶带粘起来。这是什么？手指。"}, {"type": "subtitle", "time": 3168.03, "timestamp": "00:52:48", "text": "是的。你好。欢迎。"}, {"type": "subtitle", "time": 3178.47, "timestamp": "00:52:58", "text": "总之，你想要什么？"}]
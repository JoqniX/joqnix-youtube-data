[{"type": "subtitle", "time": 5462.39, "timestamp": "01:31:02", "text": "镜子。你还记得吗？如果你记得的话。"}, {"type": "subtitle", "time": 5465.03, "timestamp": "01:31:05", "text": "还记得你有没有看到那些诡异的门吗？"}, {"type": "subtitle", "time": 5467.03, "timestamp": "01:31:07", "text": "那里？我这就把它关掉。哦，那"}, {"type": "subtitle", "time": 5467.87, "timestamp": "01:31:07", "text": "这"}, {"type": "subtitle", "time": 5470.79, "timestamp": "01:31:10", "text": "顺便说一下，把门放在桌子上。没关系。"}, {"type": "subtitle", "time": 5474.669, "timestamp": "01:31:14", "text": "好的。呃，这边。你在哪里？"}, {"type": "subtitle", "time": 5477.99, "timestamp": "01:31:17", "text": "在哪里？我感觉就像在打败"}, {"type": "subtitle", "time": 5480.149, "timestamp": "01:31:20", "text": "拉屎出来，是啊。是的。好的。好的。"}, {"type": "subtitle", "time": 5482.55, "timestamp": "01:31:22", "text": "好的。好的。是的。过来。过来。"}, {"type": "subtitle", "time": 5485.669, "timestamp": "01:31:25", "text": "就在这边。镜子碎了"}, {"type": "subtitle", "time": 5488.03, "timestamp": "01:31:28", "text": "这边。"}, {"type": "subtitle", "time": 5491.47, "timestamp": "01:31:31", "text": "哦，嘿，伙计。怎么样了？哦，我的"}, {"type": "subtitle", "time": 5494.149, "timestamp": "01:31:34", "text": "天哪，这些小鬼。你不会逃跑"}, {"type": "subtitle", "time": 5501.189, "timestamp": "01:31:41", "text": "约翰先生，您在哪里？哦，是的。超过"}, {"type": "subtitle", "time": 5503.99, "timestamp": "01:31:43", "text": "这里。这边。我会抓住你的。所以，我们"}, {"type": "subtitle", "time": 5512.99, "timestamp": "01:31:52", "text": "这里有一根蓝色的保险丝。作为"}, {"type": "chat", "time": 5515.996, "timestamp": "01:31:55", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "me coming back"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "一辆棕色的车。这里有个通风口。"}, {"type": "subtitle", "time": 5519.59, "timestamp": "01:31:59", "text": "打开。是的。等等，你有……"}]
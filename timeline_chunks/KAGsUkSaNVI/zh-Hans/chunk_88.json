[{"type": "subtitle", "time": 5281.75, "timestamp": "01:28:01", "text": "好了，J，我们离开这里吧。"}, {"type": "subtitle", "time": 5285.03, "timestamp": "01:28:05", "text": "让我们一探究竟。还有一个基地，我"}, {"type": "subtitle", "time": 5288.709, "timestamp": "01:28:08", "text": "相信。我没有收到验证码。"}, {"type": "subtitle", "time": 5290.79, "timestamp": "01:28:10", "text": "没关系。我们有脚了。我得到了"}, {"type": "subtitle", "time": 5293.79, "timestamp": "01:28:13", "text": "脚。不，我们需要代码。"}, {"type": "subtitle", "time": 5296.39, "timestamp": "01:28:16", "text": "尽管。你拿到钥匙了吗？等等，我"}, {"type": "subtitle", "time": 5300.39, "timestamp": "01:28:20", "text": "你认为钥匙很重要，对吧？"}, {"type": "subtitle", "time": 5302.47, "timestamp": "01:28:22", "text": "别死。我们走吧。我们走吧。我们走吧。"}, {"type": "subtitle", "time": 5306.95, "timestamp": "01:28:26", "text": "他还活着。他还活着。我的天啊。"}, {"type": "subtitle", "time": 5310.629, "timestamp": "01:28:30", "text": "他的身体来了。"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "不。我的天哪。"}, {"type": "subtitle", "time": 5317.99, "timestamp": "01:28:37", "text": "你这混蛋。那个混蛋。"}, {"type": "subtitle", "time": 5321.59, "timestamp": "01:28:41", "text": "他用身体阻挡。没关系。就像一根电缆"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "他没有用身体阻挡。顺便说一句，他"}, {"type": "subtitle", "time": 5327.11, "timestamp": "01:28:47", "text": "身体阻挡。当心。你得到了，你得到了"}, {"type": "subtitle", "time": 5329.43, "timestamp": "01:28:49", "text": "关键就在这里，对吧？如果我相信我得到了"}, {"type": "subtitle", "time": 5332.87, "timestamp": "01:28:52", "text": "红色钥匙。我拿到了红色钥匙。我明白了，我明白了"}, {"type": "subtitle", "time": 5336.39, "timestamp": "01:28:56", "text": "红色钥匙。好的。"}, {"type": "subtitle", "time": 5339.669, "timestamp": "01:28:59", "text": "好的。我知道我正在被唤醒。请。"}]
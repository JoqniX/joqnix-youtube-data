[{"type": "subtitle", "time": 3601.19, "timestamp": "01:00:01", "text": "我们没有武器。这"}, {"type": "subtitle", "time": 3605.03, "timestamp": "01:00:05", "text": "哦，等等。我放了“哦，是的”。等待。我该怎么做？"}, {"type": "subtitle", "time": 3607.03, "timestamp": "01:00:07", "text": "还要再来一份吗？"}, {"type": "subtitle", "time": 3609.99, "timestamp": "01:00:09", "text": "呃，我们没有，我们没有像我们这样的"}, {"type": "subtitle", "time": 3611.589, "timestamp": "01:00:11", "text": "不要像第二个那样"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "方式。我们也需要第二份。"}, {"type": "subtitle", "time": 3619.91, "timestamp": "01:00:19", "text": "我也这么认为。你无法与它互动。"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "稍等片刻。我们来试试吧。"}, {"type": "subtitle", "time": 3623.15, "timestamp": "01:00:23", "text": "为什么是我"}, {"type": "subtitle", "time": 3627.589, "timestamp": "01:00:27", "text": "我来做吗？是的。一人动了。哦，是的。"}, {"type": "subtitle", "time": 3629.67, "timestamp": "01:00:29", "text": "那里。哦，这就足够了。好的。好的。它"}, {"type": "subtitle", "time": 3636.069, "timestamp": "01:00:36", "text": "哦，我们要和它互动。"}, {"type": "subtitle", "time": 3637.829, "timestamp": "01:00:37", "text": "那里。"}, {"type": "subtitle", "time": 3639.63, "timestamp": "01:00:39", "text": "我认为你们需要互动。"}, {"type": "subtitle", "time": 3651.27, "timestamp": "01:00:51", "text": "呃，好的。知道了。那上面写了什么呢？"}]
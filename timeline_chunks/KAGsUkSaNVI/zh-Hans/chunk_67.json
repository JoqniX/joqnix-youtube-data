[{"type": "subtitle", "time": 4023.349, "timestamp": "01:07:03", "text": "运动员什么"}, {"type": "subtitle", "time": 4025.95, "timestamp": "01:07:05", "text": "我觉得是的。"}, {"type": "subtitle", "time": 4029.19, "timestamp": "01:07:09", "text": "耶稣第一。我仍在关注"}, {"type": "subtitle", "time": 4033.309, "timestamp": "01:07:13", "text": "顺便说一句，是你。在哪里？"}, {"type": "subtitle", "time": 4037.27, "timestamp": "01:07:17", "text": "心跳？我发现我找到了我的。"}, {"type": "subtitle", "time": 4040.39, "timestamp": "01:07:20", "text": "哦，是的。你找到门了吗？我们来……"}, {"type": "subtitle", "time": 4043.029, "timestamp": "01:07:23", "text": "我们去找扇门吧。找一扇门。呃，我们来吧"}, {"type": "subtitle", "time": 4051.029, "timestamp": "01:07:31", "text": "一起。它会像闪闪发光的"}, {"type": "subtitle", "time": 4053.39, "timestamp": "01:07:33", "text": "音效。跟着闪光走就行了。"}, {"type": "subtitle", "time": 4056.87, "timestamp": "01:07:36", "text": "灵魂的东西。"}, {"type": "subtitle", "time": 4059.109, "timestamp": "01:07:39", "text": "我会尽我所能的。你基本上"}, {"type": "subtitle", "time": 4061.51, "timestamp": "01:07:41", "text": "是的，一旦你找到那扇白门，就……"}, {"type": "subtitle", "time": 4065.51, "timestamp": "01:07:45", "text": "告诉我。我也会复活。我回来了"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "回到左边。耶稣基督。哦，"}, {"type": "subtitle", "time": 4073.029, "timestamp": "01:07:53", "text": "不。没关系。没关系。白色的呃"}, {"type": "subtitle", "time": 4075.71, "timestamp": "01:07:55", "text": "灵魂的东西呃来了"}, {"type": "subtitle", "time": 4078.51, "timestamp": "01:07:58", "text": "每隔15秒，我"}]
[{"type": "subtitle", "time": 7260.75, "timestamp": "02:01:00", "text": "是的。好的。呃，这个我的"}, {"type": "subtitle", "time": 7271.27, "timestamp": "02:01:11", "text": "睡过头了。睡得怎么样？我有一个想法"}, {"type": "chat", "time": 7271.849, "timestamp": "02:01:11", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "!lurk"}, {"type": "subtitle", "time": 7273.149, "timestamp": "02:01:13", "text": "也睡过头了。"}, {"type": "chat", "time": 7277.574, "timestamp": "02:01:17", "author": "@Fossabot", "avatar": "https://yt4.ggpht.com/Qae0Khsat_K9w3KLI_TUx-usVsmpNVDdoSaJjJqkO8yeQsjDwP1oZiwJ8s2cjd_lZ5HnnDuQ=s64-c-k-c0x00ffffff-no-rj", "message": "/me @Kronos is taking a nap (∪｡∪)｡｡｡zzZ 😴💤💤"}, {"type": "subtitle", "time": 7277.87, "timestamp": "02:01:17", "text": "如果这样的话，我就打算做这道菜。好的。"}, {"type": "subtitle", "time": 7289.229, "timestamp": "02:01:29", "text": "一。等等，等等，"}, {"type": "subtitle", "time": 7291.99, "timestamp": "02:01:31", "text": "等待。我需要获取当前流"}, {"type": "subtitle", "time": 7294.149, "timestamp": "02:01:34", "text": "现在。直播进行中。所以，我们必须玩。"}, {"type": "subtitle", "time": 7296.709, "timestamp": "02:01:36", "text": "使用 YouTube API。所以，我们必须得到"}, {"type": "subtitle", "time": 7299.91, "timestamp": "02:01:39", "text": "当前正在进行的流。然后，我们得到"}, {"type": "subtitle", "time": 7302.87, "timestamp": "02:01:42", "text": "即将直播。如果当前"}, {"type": "subtitle", "time": 7307.51, "timestamp": "02:01:47", "text": "当前直播标题不会更改"}, {"type": "subtitle", "time": 7310.03, "timestamp": "02:01:50", "text": "呃，制作睡过头节目"}, {"type": "subtitle", "time": 7313.75, "timestamp": "02:01:53", "text": "直立，或者我可以把它弄直，这样我就可以"}, {"type": "subtitle", "time": 7316.589, "timestamp": "02:01:56", "text": "把它修好，我们不需要这样做。"}, {"type": "subtitle", "time": 7319.83, "timestamp": "02:01:59", "text": "我们或许实际上并不需要这样做。"}]
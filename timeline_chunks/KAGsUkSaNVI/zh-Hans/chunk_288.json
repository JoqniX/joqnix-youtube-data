[{"type": "subtitle", "time": 17297.22, "timestamp": "04:48:17", "text": "你好，"}, {"type": "subtitle", "time": 17304.75, "timestamp": "04:48:24", "text": "肯。是的。"}, {"type": "subtitle", "time": 17308.23, "timestamp": "04:48:28", "text": "你好。呃，在我走之前，我需要问一下，是否"}, {"type": "subtitle", "time": 17311.11, "timestamp": "04:48:31", "text": "泰特还在发帖吗？是的，他确实有。他会的。"}, {"type": "subtitle", "time": 17314.35, "timestamp": "04:48:34", "text": "他每个星期六都在直播。"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "大概。偶像拍摄，就像那些"}, {"type": "subtitle", "time": 17319.99, "timestamp": "04:48:39", "text": "格斗游戏之类的。所以，所以，所以"}, {"type": "subtitle", "time": 17322.31, "timestamp": "04:48:42", "text": "州政府确实发布了公告。是的。是的。是的。做"}, {"type": "subtitle", "time": 17325.31, "timestamp": "04:48:45", "text": "你看过他的频道吗？是的，他确实如此。"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "邮政。他在推特上更活跃。如果"}, {"type": "subtitle", "time": 17330.47, "timestamp": "04:48:50", "text": "你有推特账号吗？请关注州政府账号。"}, {"type": "subtitle", "time": 17332.948, "timestamp": "04:48:52", "text": "Twitter，让你能够了解更多。"}, {"type": "subtitle", "time": 17336.11, "timestamp": "04:48:56", "text": "更新了他的情况。是的。"}]
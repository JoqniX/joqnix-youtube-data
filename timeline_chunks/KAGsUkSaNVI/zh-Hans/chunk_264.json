[{"type": "subtitle", "time": 15842.95, "timestamp": "04:24:02", "text": "我们参加的比赛数量是多少？"}, {"type": "subtitle", "time": 15845.83, "timestamp": "04:24:05", "text": "简直疯了。我们究竟有多少次真正地……"}, {"type": "subtitle", "time": 15851.51, "timestamp": "04:24:11", "text": "选择你的英雄或反派。我不是"}, {"type": "subtitle", "time": 15858.71, "timestamp": "04:24:18", "text": "我拥有变异能力，还有一个小恶魔。"}, {"type": "subtitle", "time": 15895.67, "timestamp": "04:24:55", "text": "每次战斗我都对自己说，我可能会去"}, {"type": "subtitle", "time": 15899.51, "timestamp": "04:24:59", "text": "倒下，但我会战斗到最后一刻。"}]
[{"type": "subtitle", "time": 420.39, "timestamp": "00:07:00", "text": "周六和《地狱潜水员》周六"}, {"type": "subtitle", "time": 422.23, "timestamp": "00:07:02", "text": "出色地。所以，我得下载地狱"}, {"type": "subtitle", "time": 424.79, "timestamp": "00:07:04", "text": "潜水员。现在，我的东西数量……"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "下载和卸载过程简直太疯狂了。"}, {"type": "subtitle", "time": 430.23, "timestamp": "00:07:10", "text": "感觉就像浪费了……"}, {"type": "subtitle", "time": 434.469, "timestamp": "00:07:14", "text": "嗯，时间或者这个东西。我离目标如此之近"}, {"type": "subtitle", "time": 439.07, "timestamp": "00:07:19", "text": "我的地理信息系统要变成哦，那要变成"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "筋疲力尽的。所以，新的一月也开始了。"}, {"type": "subtitle", "time": 448.51, "timestamp": "00:07:28", "text": "嗯，嗯"}, {"type": "subtitle", "time": 452.07, "timestamp": "00:07:32", "text": "弹出窗口，然后我们会上传这些文件。"}, {"type": "subtitle", "time": 454.51, "timestamp": "00:07:34", "text": "就我们目前的情况而言，我们拥有"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "完成了，很遗憾，这是第 49 天的第二部分。"}, {"type": "subtitle", "time": 461.469, "timestamp": "00:07:41", "text": "溪流有"}, {"type": "subtitle", "time": 465.029, "timestamp": "00:07:45", "text": "已经正式消失了"}, {"type": "subtitle", "time": 466.11, "timestamp": "00:07:46", "text": "消失"}, {"type": "subtitle", "time": 469.749, "timestamp": "00:07:49", "text": "没有留下任何录音。为什么"}, {"type": "subtitle", "time": 473.43, "timestamp": "00:07:53", "text": "我直播了20个小时吗？我们正在做这件事"}, {"type": "subtitle", "time": 477.029, "timestamp": "00:07:57", "text": "那条直播间里，我们正在讨论“我们该做什么”。"}]
[{"type": "subtitle", "time": 2943.43, "timestamp": "00:49:03", "text": "保持静止，就像前面所说的那样。"}, {"type": "subtitle", "time": 2947.109, "timestamp": "00:49:07", "text": "角落里或者类似躲在某个地方"}, {"type": "subtitle", "time": 2950.95, "timestamp": "00:49:10", "text": "但并没有什么帮助。我做了。你做到了"}, {"type": "subtitle", "time": 2954.069, "timestamp": "00:49:14", "text": "哪个？狗狗那只。是的，我会"}, {"type": "subtitle", "time": 2956.589, "timestamp": "00:49:16", "text": "去。好的，他有"}, {"type": "subtitle", "time": 2963.829, "timestamp": "00:49:23", "text": "我带着时针和分针。我们开始吧"}, {"type": "subtitle", "time": 2966.47, "timestamp": "00:49:26", "text": "我想，我们应该一起搬家吧。但顺便一提，"}, {"type": "subtitle", "time": 2968.95, "timestamp": "00:49:28", "text": "我没有手电筒。查克，你"}, {"type": "subtitle", "time": 2971.829, "timestamp": "00:49:31", "text": "没拿。 H"}, {"type": "subtitle", "time": 2974.309, "timestamp": "00:49:34", "text": "你从哪里弄到的？我没有从"}, {"type": "subtitle", "time": 2976.71, "timestamp": "00:49:36", "text": "等等，到我这里来。你在哪里？稍等"}, {"type": "subtitle", "time": 2981.51, "timestamp": "00:49:41", "text": "第二。它在第三个抽屉里。"}, {"type": "subtitle", "time": 2982.91, "timestamp": "00:49:42", "text": "我的天啊。"}, {"type": "subtitle", "time": 2987.109, "timestamp": "00:49:47", "text": "最后。如何为其配备？哦，不。呃"}, {"type": "subtitle", "time": 2988.63, "timestamp": "00:49:48", "text": "手电筒。"}, {"type": "subtitle", "time": 2990.79, "timestamp": "00:49:50", "text": "F."}, {"type": "subtitle", "time": 2994.39, "timestamp": "00:49:54", "text": "是的。我的天啊。"}, {"type": "subtitle", "time": 2997.349, "timestamp": "00:49:57", "text": "我们要速通一下。我将"}]
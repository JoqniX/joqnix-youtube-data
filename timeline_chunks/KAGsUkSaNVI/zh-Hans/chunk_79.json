[{"type": "subtitle", "time": 4741.51, "timestamp": "01:19:01", "text": "好的。那么，让我们实际操作一下吧。"}, {"type": "subtitle", "time": 4745.11, "timestamp": "01:19:05", "text": "实际的游戏。当然可以。我们来……"}, {"type": "subtitle", "time": 4748.149, "timestamp": "01:19:08", "text": "那。你在哪里？我在里面。"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "感觉真的很诡异，就像……"}, {"type": "subtitle", "time": 4753.189, "timestamp": "01:19:13", "text": "跟着有线电视安装工走。是的，跟着……"}, {"type": "subtitle", "time": 4755.27, "timestamp": "01:19:15", "text": "有线电视安装工。我就在附近。你看到了"}, {"type": "subtitle", "time": 4763.51, "timestamp": "01:19:23", "text": "真是太诡异了，就像……"}, {"type": "subtitle", "time": 4766.95, "timestamp": "01:19:26", "text": "陷入困境。呃，那是……"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "这很酷吗？"}, {"type": "subtitle", "time": 4772.95, "timestamp": "01:19:32", "text": "所以，我们知道是的。"}, {"type": "subtitle", "time": 4775.75, "timestamp": "01:19:35", "text": "好的。你在哪里？你现在在哪里？好的。"}, {"type": "subtitle", "time": 4780.63, "timestamp": "01:19:40", "text": "所以，我们把时钟那个拆开了。好的。我们"}, {"type": "subtitle", "time": 4782.79, "timestamp": "01:19:42", "text": "时钟那个做完了。我们需要这样做"}, {"type": "subtitle", "time": 4784.709, "timestamp": "01:19:44", "text": "身体部位。所以，是身体部位。对于"}, {"type": "subtitle", "time": 4786.91, "timestamp": "01:19:46", "text": "身体部位，我们需要找到"}, {"type": "subtitle", "time": 4792.149, "timestamp": "01:19:52", "text": "脚。至于脚，我们将前往"}, {"type": "subtitle", "time": 4794.03, "timestamp": "01:19:54", "text": "辐射"}, {"type": "subtitle", "time": 4796.39, "timestamp": "01:19:56", "text": "地方。哦，辐射。我们需要一个"}, {"type": "subtitle", "time": 4798.55, "timestamp": "01:19:58", "text": "虽然穿戴辐射防护服需要一些时间"}]
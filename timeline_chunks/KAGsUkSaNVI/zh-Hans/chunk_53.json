[{"type": "subtitle", "time": 3181.109, "timestamp": "00:53:01", "text": "等等，等等，等等。呃，不。我听到一个"}, {"type": "subtitle", "time": 3185.99, "timestamp": "00:53:05", "text": "鬼。等等，让我重新绑定一下我的按键。"}, {"type": "subtitle", "time": 3189.19, "timestamp": "00:53:09", "text": "一秒钟。库存在哪里？我想要"}, {"type": "subtitle", "time": 3191.19, "timestamp": "00:53:11", "text": "密切关注。"}, {"type": "subtitle", "time": 3195.109, "timestamp": "00:53:15", "text": "我想重新绑定我的物品栏按键"}, {"type": "subtitle", "time": 3198.79, "timestamp": "00:53:18", "text": "这样我就可以更快地装备物品了。"}, {"type": "subtitle", "time": 3201.67, "timestamp": "00:53:21", "text": "标签页。我把它设置成了 Tab 键。我的天啊，"}, {"type": "subtitle", "time": 3205.03, "timestamp": "00:53:25", "text": "那是张令人毛骨悚然的鬼脸。"}, {"type": "subtitle", "time": 3207.27, "timestamp": "00:53:27", "text": "那感觉就像突然吓了一跳，速度真快。"}, {"type": "subtitle", "time": 3210.47, "timestamp": "00:53:30", "text": "把你杀死。是的。是的。所以我相信"}, {"type": "subtitle", "time": 3212.15, "timestamp": "00:53:32", "text": "你"}, {"type": "subtitle", "time": 3215.19, "timestamp": "00:53:35", "text": "没看到。是的。你等到它"}, {"type": "subtitle", "time": 3221.75, "timestamp": "00:53:41", "text": "别看它。查克，你到底是什么人？"}, {"type": "subtitle", "time": 3223.589, "timestamp": "00:53:43", "text": "正在做？不，不，不，不。从侧面看"}, {"type": "subtitle", "time": 3226.91, "timestamp": "00:53:46", "text": "再次。我想你可以。我不"}, {"type": "subtitle", "time": 3231.27, "timestamp": "00:53:51", "text": "知道。它不见了。他走了。是的。去。"}, {"type": "subtitle", "time": 3233.67, "timestamp": "00:53:53", "text": "他真的跳到这里摔死了，就在这里。"}, {"type": "subtitle", "time": 3237.03, "timestamp": "00:53:57", "text": "方式。那是一件……那是一件事情。"}, {"type": "subtitle", "time": 3239.349, "timestamp": "00:53:59", "text": "哦，我疯了吗？稍等片刻。戳，"}]
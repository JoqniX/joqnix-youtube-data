[{"type": "subtitle", "time": 12781.11, "timestamp": "03:33:01", "text": "左边。让它重新运转起来。我当时"}, {"type": "subtitle", "time": 12783.83, "timestamp": "03:33:03", "text": "正在寻找其中一个。注意你的"}, {"type": "subtitle", "time": 12795.269, "timestamp": "03:33:15", "text": "我们花费的时间越长，无效性就越强。"}, {"type": "subtitle", "time": 12817.75, "timestamp": "03:33:37", "text": "保持趴着的状态。"}, {"type": "subtitle", "time": 12824.309, "timestamp": "03:33:44", "text": "你哪儿也去不了。我们赢了，我"}]
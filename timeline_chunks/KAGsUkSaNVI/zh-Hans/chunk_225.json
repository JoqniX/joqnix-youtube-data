[{"type": "subtitle", "time": 13506.59, "timestamp": "03:45:06", "text": "步"}, {"type": "subtitle", "time": 13520.469, "timestamp": "03:45:20", "text": "这肯定很长。月亮萦绕着你。"}, {"type": "subtitle", "time": 13523.51, "timestamp": "03:45:23", "text": "我讨厌月光。我是那束光"}, {"type": "subtitle", "time": 13527.349, "timestamp": "03:45:27", "text": "黑暗。月亮萦绕着你。"}, {"type": "subtitle", "time": 13529.67, "timestamp": "03:45:29", "text": "双杀。我的灯不行。你会"}, {"type": "subtitle", "time": 13531.11, "timestamp": "03:45:31", "text": "我们必须继续战斗，直到我们取得胜利。"}, {"type": "subtitle", "time": 13534.07, "timestamp": "03:45:34", "text": "优胜者。"}, {"type": "subtitle", "time": 13536.389, "timestamp": "03:45:36", "text": "啊。"}, {"type": "subtitle", "time": 13545.269, "timestamp": "03:45:45", "text": "我当时打得太烂了。"}, {"type": "subtitle", "time": 13554.55, "timestamp": "03:45:54", "text": "第三个呢？难道没有第三者吗？"}, {"type": "subtitle", "time": 13556.72, "timestamp": "03:45:56", "text": "战斗的"}]
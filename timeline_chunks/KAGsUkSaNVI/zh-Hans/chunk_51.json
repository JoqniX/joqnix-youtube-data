[{"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "我的天啊，杰克。"}, {"type": "subtitle", "time": 3064.71, "timestamp": "00:51:04", "text": "好的，这边走。"}, {"type": "subtitle", "time": 3066.91, "timestamp": "00:51:06", "text": "好吧，我相信你，因为你看到了……"}, {"type": "subtitle", "time": 3070.309, "timestamp": "00:51:10", "text": "speedun 和我做到了。没关系。它"}, {"type": "subtitle", "time": 3073.309, "timestamp": "00:51:13", "text": "没关系。所以，我们来吃杏仁。"}, {"type": "subtitle", "time": 3076.309, "timestamp": "00:51:16", "text": "想知道。什么？"}, {"type": "subtitle", "time": 3080.95, "timestamp": "00:51:20", "text": "好的，谢谢。我愿意。你想要那个吗？"}, {"type": "subtitle", "time": 3083.589, "timestamp": "00:51:23", "text": "快乐药丸。我们走吧。"}, {"type": "subtitle", "time": 3087.67, "timestamp": "00:51:27", "text": "我们需要找到那盘VHS录像带吗？"}, {"type": "subtitle", "time": 3091.109, "timestamp": "00:51:31", "text": "好的。哦，总之，你……我的天哪，还有……"}, {"type": "subtitle", "time": 3099.03, "timestamp": "00:51:39", "text": "只有一个。当我想到这一点时"}, {"type": "subtitle", "time": 3102.069, "timestamp": "00:51:42", "text": "一款恐怖游戏，我试着玩，然后我开始……"}, {"type": "subtitle", "time": 3105.03, "timestamp": "00:51:45", "text": "害怕，让我想想这是一款第一人称射击游戏"}, {"type": "subtitle", "time": 3109.589, "timestamp": "00:51:49", "text": "玩游戏，但请不要这样做。是的。第一人称射击游戏"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "游戏中你感觉自己离胜利非常近。好的。"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "过来。杰克，你在哪里？呃"}, {"type": "subtitle", "time": 3114.79, "timestamp": "00:51:54", "text": "门后。这扇门。这扇门。"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "这扇门。是的。是的。好的。过来。"}, {"type": "subtitle", "time": 3119.23, "timestamp": "00:51:59", "text": "我们正在采取"}]
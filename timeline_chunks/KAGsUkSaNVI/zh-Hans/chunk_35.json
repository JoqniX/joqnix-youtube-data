[{"type": "subtitle", "time": 2100.47, "timestamp": "00:35:00", "text": "约翰不会惹我。我给你发了消息"}, {"type": "subtitle", "time": 2102.87, "timestamp": "00:35:02", "text": "你们所有人，我没有为你们直播"}, {"type": "subtitle", "time": 2106.43, "timestamp": "00:35:06", "text": "顺便说一下，是在后面里面。如何"}, {"type": "subtitle", "time": 2109.91, "timestamp": "00:35:09", "text": "在内心深处，我拥有一个，我已经逃脱了。"}, {"type": "subtitle", "time": 2112.99, "timestamp": "00:35:12", "text": "背面和背面内部，所以它不会"}, {"type": "subtitle", "time": 2117.03, "timestamp": "00:35:17", "text": "不管你愿不愿意"}, {"type": "subtitle", "time": 2121.19, "timestamp": "00:35:21", "text": "你听说过大堂吗？"}, {"type": "subtitle", "time": 2123.349, "timestamp": "00:35:23", "text": "机器断开连接了。我回来了吗？"}, {"type": "subtitle", "time": 2126.19, "timestamp": "00:35:26", "text": "等待。好的。我可以邀请我应该是"}, {"type": "subtitle", "time": 2127.99, "timestamp": "00:35:27", "text": "后退。"}, {"type": "subtitle", "time": 2130.589, "timestamp": "00:35:30", "text": "我的天，真宽！"}, {"type": "subtitle", "time": 2133.47, "timestamp": "00:35:33", "text": "屏幕。我做了什么"}, {"type": "subtitle", "time": 2137.99, "timestamp": "00:35:37", "text": "做？我的天，这是宽屏！为什么是"}, {"type": "subtitle", "time": 2140.95, "timestamp": "00:35:40", "text": "这正常吗？我收到闪光灯了。我的桌面是"}, {"type": "subtitle", "time": 2142.19, "timestamp": "00:35:42", "text": "字面上地"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "闪光弹。为什么"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "我回来了吗？"}, {"type": "subtitle", "time": 2155.27, "timestamp": "00:35:55", "text": "甚至什么都不做。"}]
[{"type": "subtitle", "time": 17170.39, "timestamp": "04:46:10", "text": "呃呃，电视音量。嗯，我这就去。"}, {"type": "subtitle", "time": 17173.19, "timestamp": "04:46:13", "text": "降低翻译难度。我的家人是"}, {"type": "subtitle", "time": 17182.03, "timestamp": "04:46:22", "text": "好的。一秒钟。给我一个"}, {"type": "subtitle", "time": 17184.75, "timestamp": "04:46:24", "text": "少量。我该怎么做？"}, {"type": "subtitle", "time": 17206.75, "timestamp": "04:46:46", "text": "你好。"}, {"type": "subtitle", "time": 17209.47, "timestamp": "04:46:49", "text": "呃，我是"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "后退。我很快就回来，因为我得走了。"}, {"type": "subtitle", "time": 17215.27, "timestamp": "04:46:55", "text": "学校。嗨，Gamb。呃，你觉得怎么样？"}, {"type": "subtitle", "time": 17218.83, "timestamp": "04:46:58", "text": "又要用日语上课了。"}]
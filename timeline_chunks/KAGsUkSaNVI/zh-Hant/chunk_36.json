[{"type": "subtitle", "time": 2160.71, "timestamp": "00:36:00", "text": "我的天啊。出口。是啊，其實問題是，呃，"}, {"type": "subtitle", "time": 2163.19, "timestamp": "00:36:03", "text": "哪個比較好？我"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "在後面的房間玩什麼都行。"}, {"type": "subtitle", "time": 2172.79, "timestamp": "00:36:12", "text": "逃離浴室的畫面效果得到了提升，而逃離後屋的好處在於，"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "沒有安全空間。"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "顯然，他們的大廳在"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "這裡是一個安全的地方，但在逃生的後面房間裡，"}, {"type": "subtitle", "time": 2182.39, "timestamp": "00:36:22", "text": "有一個實體隨時準備"}, {"type": "subtitle", "time": 2185.829, "timestamp": "00:36:25", "text": "殺死你。事情就是這樣。"}, {"type": "subtitle", "time": 2187.069, "timestamp": "00:36:27", "text": "那麼，"}, {"type": "subtitle", "time": 2191.109, "timestamp": "00:36:31", "text": "主持人就是傑奎·尼克先生。是的，我正在啟動"}, {"type": "subtitle", "time": 2196.55, "timestamp": "00:36:36", "text": "G。我為什麼會打開反恐精英？  尼克先生"}, {"type": "subtitle", "time": 2199.349, "timestamp": "00:36:39", "text": "，請您停止玩"}, {"type": "subtitle", "time": 2202.43, "timestamp": "00:36:42", "text": "反恐精英好嗎？不，不，"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "不。我不小心打開了，對不起。  我的天啊。"}, {"type": "subtitle", "time": 2215.91, "timestamp": "00:36:55", "text": "別人聽得到你"}, {"type": "subtitle", "time": 2219.109, "timestamp": "00:36:59", "text": "說話嗎？  你會說話嗎？你好。你好。你好。  你好。你好。你好。  好的。好的"}]
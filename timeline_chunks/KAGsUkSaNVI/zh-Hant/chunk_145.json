[{"type": "subtitle", "time": 8711.59, "timestamp": "02:25:11", "text": "通常你需要預判"}, {"type": "subtitle", "time": 8715.07, "timestamp": "02:25:15", "text": "目標。用這支箭不行。  太棒了。好的。六連勝。幹得好。難以置信。  我得了五分。入選。  KO。 KO。 KO。  連勝三場。"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "小心。壞人。絕不錯過。  這件事"}, {"type": "subtitle", "time": 8728.63, "timestamp": "02:25:28", "text": "躲不開。"}, {"type": "subtitle", "time": 8742.15, "timestamp": "02:25:42", "text": "知道你去過哪裡"}]
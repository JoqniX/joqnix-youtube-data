[{"type": "subtitle", "time": 2043.029, "timestamp": "00:34:03", "text": "這只是一張普通的PNG圖片而已，老兄。"}, {"type": "subtitle", "time": 2047.11, "timestamp": "00:34:07", "text": "哇，原來如此，這就是"}, {"type": "subtitle", "time": 2049.909, "timestamp": "00:34:09", "text": "螢幕完全黑屏的原因。我的天啊，你知道嗎？"}, {"type": "subtitle", "time": 2051.669, "timestamp": "00:34:11", "text": "我可能聽不到你說話，"}, {"type": "subtitle", "time": 2055.909, "timestamp": "00:34:15", "text": "但我會…你知道，快速重啟一下。別"}, {"type": "subtitle", "time": 2059.99, "timestamp": "00:34:19", "text": "擔心，我會在這裡。"}, {"type": "subtitle", "time": 2064.149, "timestamp": "00:34:24", "text": "我的天啊，如果你不在也沒關係。我"}, {"type": "subtitle", "time": 2066.79, "timestamp": "00:34:26", "text": "希望你能進入遊戲。你在"}, {"type": "subtitle", "time": 2073.909, "timestamp": "00:34:33", "text": "遊戲裡嗎？非常抱歉。"}, {"type": "subtitle", "time": 2077.909, "timestamp": "00:34:37", "text": "哦，是的。大家最近怎麼樣？每個人。  是的。"}, {"type": "subtitle", "time": 2081.03, "timestamp": "00:34:41", "text": "你好，布拉德。是的。你好，瑪爾。哦，"}, {"type": "subtitle", "time": 2085.19, "timestamp": "00:34:45", "text": "真的嗎？我的天哪。我已經拿到"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "梯子了，但J不在。希望"}, {"type": "subtitle", "time": 2090.869, "timestamp": "00:34:50", "text": "不會讓人失望。"}, {"type": "subtitle", "time": 2093.589, "timestamp": "00:34:53", "text": "我的天啊。它甚至還沒重啟。我的天哪。"}, {"type": "subtitle", "time": 2097.51, "timestamp": "00:34:57", "text": "真的嗎？"}]
[{"type": "subtitle", "time": 3064.71, "timestamp": "00:51:04", "text": "好吧，我們需要"}, {"type": "subtitle", "time": 3066.91, "timestamp": "00:51:06", "text": "找到"}, {"type": "subtitle", "time": 3070.309, "timestamp": "00:51:10", "text": "VHS"}, {"type": "subtitle", "time": 3076.309, "timestamp": "00:51:16", "text": "錄影帶那盤了。"}, {"type": "subtitle", "time": 3080.95, "timestamp": "00:51:20", "text": "你知道那是哪裡嗎？  是啊，我忘了。  哦，我們又回到起點了"}, {"type": "subtitle", "time": 3083.589, "timestamp": "00:51:23", "text": "。 XD，我喜歡你表達自己的方式。我的天哪，約翰，我把你弄丟了。  好的，這裡有一些女性的"}, {"type": "subtitle", "time": 3087.67, "timestamp": "00:51:27", "text": "尖叫聲。  沒關係。  你不能說“女孩”，是嗎？"}, {"type": "subtitle", "time": 3091.109, "timestamp": "00:51:31", "text": "你不能只說「女孩」。女性。我的天哪，傑克。  好的，這邊走。  好吧，"}, {"type": "subtitle", "time": 3102.069, "timestamp": "00:51:42", "text": "我相信你，因為你看到了速跑，"}, {"type": "subtitle", "time": 3109.589, "timestamp": "00:51:49", "text": "而我也做到了。沒關係。沒關係。所以，就讓我們來品嚐一下這神奇的杏仁吧。什麼？"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "好的，謝謝。我願意。"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "你想要那個嗎？  快樂藥丸。"}, {"type": "subtitle", "time": 3119.23, "timestamp": "00:51:59", "text": "我們走吧。  我們需要找到那盤VHS錄影帶嗎？  好的"}]
[{"type": "subtitle", "time": 6300.87, "timestamp": "01:45:00", "text": "我得在晚上之後去。"}, {"type": "subtitle", "time": 6304.39, "timestamp": "01:45:04", "text": "我修改了「讓你的禮物更好」這句話。說實話，在我看來，你們這些直播的狗和懶惰的人簡直天壤之別，他們根本不在一個層面上"}, {"type": "subtitle", "time": 6314.55, "timestamp": "01:45:14", "text": "我理解你的意思是，你好像在說我懶惰之類的。  就像，嗯"}, {"type": "chat", "time": 6326.42, "timestamp": "01:45:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yes, good morning"}, {"type": "subtitle", "time": 6330.629, "timestamp": "01:45:30", "text": "我已經直播好幾個小時了。當然，"}, {"type": "chat", "time": 6332.322, "timestamp": "01:45:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "time to have breakfast"}, {"type": "subtitle", "time": 6336.07, "timestamp": "01:45:36", "text": "我也想休息一下，但這感覺糟透了。我"}, {"type": "subtitle", "time": 6337.99, "timestamp": "01:45:37", "text": "無法結束直播。我說過我會做24小時。呃"}, {"type": "subtitle", "time": 6344.31, "timestamp": "01:45:44", "text": "，Amber，我連24小時都撐不了。人生苦痛。"}, {"type": "subtitle", "time": 6348.709, "timestamp": "01:45:48", "text": "我還看到了尚山，歡迎。  我不知道你是否還在，不過，我正在瀏覽聊天記錄，我的手機好像有點卡頓"}, {"type": "chat", "time": 6355.348, "timestamp": "01:45:55", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "u do actively run way from horror tho 💀"}]
[{"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "它運行得很好。呃，有人問我"}, {"type": "subtitle", "time": 1935.029, "timestamp": "00:32:15", "text": "問題。你最近看過什麼動漫嗎"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "？哦，我當時一邊吃"}, {"type": "subtitle", "time": 1941.59, "timestamp": "00:32:21", "text": "晚餐一邊看動漫。  是哪部動漫呢？"}, {"type": "subtitle", "time": 1945.549, "timestamp": "00:32:25", "text": "呃，它叫"}, {"type": "subtitle", "time": 1948.19, "timestamp": "00:32:28", "text": "Shai。它叫沙伊。我非常"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "喜歡這部動畫。我喜歡這種"}, {"type": "subtitle", "time": 1956.95, "timestamp": "00:32:36", "text": "開頭動畫。我喜歡這個。我太"}, {"type": "subtitle", "time": 1960.07, "timestamp": "00:32:40", "text": "喜歡這個了。  是的"}, {"type": "subtitle", "time": 1969.19, "timestamp": "00:32:49", "text": "它沒能成功，但你知道，它"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "仍然是一部傑作。是的，我"}, {"type": "subtitle", "time": 1974.19, "timestamp": "00:32:54", "text": "猜是這樣。"}, {"type": "subtitle", "time": 1977.59, "timestamp": "00:32:57", "text": "我剛安裝完顯示卡"}]
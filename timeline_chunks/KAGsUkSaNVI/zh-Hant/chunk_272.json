[{"type": "subtitle", "time": 16327.51, "timestamp": "04:32:07", "text": "綠巨人。"}, {"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "我想先殺了他"}, {"type": "subtitle", "time": 16336.309, "timestamp": "04:32:16", "text": "二，四。我好多了。"}, {"type": "subtitle", "time": 16339.67, "timestamp": "04:32:19", "text": "什麼？搞什麼鬼？  那是一個更好的過人者。  什麼過境者？  雙殺。"}]
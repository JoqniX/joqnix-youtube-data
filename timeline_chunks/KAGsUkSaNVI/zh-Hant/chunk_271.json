[{"type": "subtitle", "time": 16274.309, "timestamp": "04:31:14", "text": "你沒能抓住「哦我的天哪，我在吸吮」。掙扎中。  入選。  我們有客人來了"}, {"type": "subtitle", "time": 16277.429, "timestamp": "04:31:17", "text": "。  我們走吧。"}, {"type": "subtitle", "time": 16302.229, "timestamp": "04:31:42", "text": "啊，我本來可以犧牲健康而不是戰鬥的。"}, {"type": "subtitle", "time": 16305.55, "timestamp": "04:31:45", "text": "我之前沒意識到竟然會有"}]
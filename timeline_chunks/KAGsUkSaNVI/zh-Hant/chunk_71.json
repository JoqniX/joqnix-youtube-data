[{"type": "subtitle", "time": 4266.31, "timestamp": "01:11:06", "text": "我有手指。  手指。  是的。誰失去了手指？等等，我們要為所有人這樣做嗎"}, {"type": "subtitle", "time": 4269.75, "timestamp": "01:11:09", "text": "？"}, {"type": "subtitle", "time": 4275.51, "timestamp": "01:11:15", "text": "我"}, {"type": "subtitle", "time": 4278.07, "timestamp": "01:11:18", "text": "不知道。大概。哦，等等。這樣做。試著把手指伸進"}, {"type": "subtitle", "time": 4280.63, "timestamp": "01:11:20", "text": "我們還沒放進去的任何一個洞。  好的。  嗯，放上去，然後就像…就像回去一樣。什麼也沒發生。"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "然後把它再拿過來，放到另一個容器裡。"}, {"type": "subtitle", "time": 4291.03, "timestamp": "01:11:31", "text": "好的。所以，我想，你是把它塗在屍體的血上面。  好的。我得到了它"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "。我把東西放在"}, {"type": "chat", "time": 4300.265, "timestamp": "01:11:40", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "joq used to do these?"}]
[{"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "不，我們需要的是程式碼。你拿到鑰匙了嗎"}, {"type": "subtitle", "time": 5351.91, "timestamp": "01:29:11", "text": "？等等，我覺得鑰匙很重要，對吧？  別死。我們走吧。我們走吧。我們走吧"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "。  他還活著。他還活著"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "。我的"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "天啊。  他的身體來了。  不。我的天哪。  你這混蛋。那個混蛋。  他用身體"}, {"type": "subtitle", "time": 5367.51, "timestamp": "01:29:27", "text": "阻擋。沒關係。就像有線電視安裝工人不會擋路一樣。順便說一句，他會用身體來阻擋。當心。"}, {"type": "subtitle", "time": 5374.149, "timestamp": "01:29:34", "text": "你有鑰匙，對吧？如果我相信我拿到了紅鑰匙。"}, {"type": "subtitle", "time": 5382.79, "timestamp": "01:29:42", "text": "我拿到了紅色鑰匙。我拿到紅鑰匙了。好的。  好的。"}, {"type": "subtitle", "time": 5385.11, "timestamp": "01:29:45", "text": "我知道我正在被喚醒。請。  上帝啊，"}, {"type": "subtitle", "time": 5387.189, "timestamp": "01:29:47", "text": "看在主的份上，"}, {"type": "subtitle", "time": 5398.629, "timestamp": "01:29:58", "text": "我看見你了。我沒有，我沒有，"}]
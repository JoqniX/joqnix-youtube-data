[{"type": "subtitle", "time": 5222.31, "timestamp": "01:27:02", "text": "毫無用處"}, {"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "。他速度比我們都快"}, {"type": "subtitle", "time": 5227.83, "timestamp": "01:27:07", "text": "。"}, {"type": "subtitle", "time": 5264.55, "timestamp": "01:27:44", "text": "，我其實已經死了。  那很糟糕。"}, {"type": "subtitle", "time": 5266.55, "timestamp": "01:27:46", "text": "我不太能做任何事。沒關係。呃，試著讓自己清醒。  是的。總之，"}]
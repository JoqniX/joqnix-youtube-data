[{"type": "subtitle", "time": 13444.95, "timestamp": "03:44:04", "text": "我找到其中一個了"}, {"type": "subtitle", "time": 13461.11, "timestamp": "03:44:21", "text": "賜予我們勝利吧"}, {"type": "subtitle", "time": 13464.229, "timestamp": "03:44:24", "text": "。  這就是你成為國王的原因。  這就是我們"}, {"type": "subtitle", "time": 13466.15, "timestamp": "03:44:26", "text": "戰鬥的地方。這值得您關注。現在我看到了。  耶，我們贏了。斯特拉太空港。  [音樂]"}, {"type": "subtitle", "time": 13469.59, "timestamp": "03:44:29", "text": "這裡的一切都感覺如此熟悉，卻又如此陌生。  攻擊前30秒。"}, {"type": "subtitle", "time": 13482.63, "timestamp": "03:44:42", "text": "準備。  我的訂單商店。"}]
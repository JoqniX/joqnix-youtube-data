[{"type": "subtitle", "time": 15507.429, "timestamp": "04:18:27", "text": "聽你再在我耳邊嘮叨幾句。過去也曾與我有過交流。我懂了。  是的，我不會直接導致這種情況，但也許你找到了"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "更好的神。"}, {"type": "subtitle", "time": 15527.11, "timestamp": "04:18:47", "text": "戰鬥將在 5、4、3、2、1 時開始。"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "我只需要佔領"}, {"type": "subtitle", "time": 15534.71, "timestamp": "04:18:54", "text": "任務區域。知道了。  說實話，我小時候"}, {"type": "subtitle", "time": 15536.71, "timestamp": "04:18:56", "text": "不喜歡雪。"}]
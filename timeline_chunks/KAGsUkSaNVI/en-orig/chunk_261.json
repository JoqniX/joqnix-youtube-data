[{"type": "subtitle", "time": 15669.91, "timestamp": "04:21:09", "text": "Don't mess with the Amazing Spider-Man."}, {"type": "subtitle", "time": 15689.11, "timestamp": "04:21:29", "text": "Turret must be dealt with."}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "Oh my god. I'm dead. I'm dead. They"}, {"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "ganged me. Almost yours. They ganged me"}, {"type": "subtitle", "time": 15713.11, "timestamp": "04:21:53", "text": "Hero working. Still breathing. Still"}, {"type": "subtitle", "time": 15714.87, "timestamp": "04:21:54", "text": "fighting."}, {"type": "subtitle", "time": 15718.95, "timestamp": "04:21:58", "text": "Behold the god of thunder."}]
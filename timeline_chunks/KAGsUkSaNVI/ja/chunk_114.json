[{"type": "subtitle", "time": 6840.95, "timestamp": "01:54:00", "text": "えっと、私は以前にもコマンドを出したことがありますよね？"}, {"type": "subtitle", "time": 6842.629, "timestamp": "01:54:02", "text": "以前にもコマンドを作成したことがあると思います。"}, {"type": "subtitle", "time": 6866.229, "timestamp": "01:54:26", "text": "コマンド。あ、待って。ただ置くだけではダメだ"}, {"type": "subtitle", "time": 6872.31, "timestamp": "01:54:32", "text": "もがく？そうそう。置くだけでいい"}, {"type": "subtitle", "time": 6873.39, "timestamp": "01:54:33", "text": "ここ。"}, {"type": "subtitle", "time": 6876.03, "timestamp": "01:54:36", "text": "騎手。ジョック。私の"}, {"type": "subtitle", "time": 6879.07, "timestamp": "01:54:39", "text": "男。ああ、ただ置けばいいだけ"}, {"type": "subtitle", "time": 6884.03, "timestamp": "01:54:44", "text": "ここ。わかった。これはジョックになるだろう"}, {"type": "subtitle", "time": 6897.07, "timestamp": "01:54:57", "text": "演技をするスポーツマン"}]
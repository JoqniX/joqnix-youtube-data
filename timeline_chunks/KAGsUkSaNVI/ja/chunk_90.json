[{"type": "subtitle", "time": 5401.11, "timestamp": "01:30:01", "text": "ナビゲーション機能がありません。"}, {"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "よし。足はここに置くべきです。"}, {"type": "subtitle", "time": 5406.35, "timestamp": "01:30:06", "text": "送信。わかった。"}, {"type": "subtitle", "time": 5409.229, "timestamp": "01:30:09", "text": "わかった。ジョナサンは"}, {"type": "subtitle", "time": 5413.83, "timestamp": "01:30:13", "text": "足。足。"}, {"type": "subtitle", "time": 5417.35, "timestamp": "01:30:17", "text": "うん。鏡が割れた。ああ、不気味な"}, {"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "顔。ああ、あそこにいる人たちは気味が悪いね。"}, {"type": "subtitle", "time": 5424.31, "timestamp": "01:30:24", "text": "わかった。何を持っているの？私は何を持っているのか？私"}, {"type": "subtitle", "time": 5428.39, "timestamp": "01:30:28", "text": "手伝ってください。わかった。私には鼻と"}, {"type": "subtitle", "time": 5435.51, "timestamp": "01:30:35", "text": "見ないで。"}, {"type": "subtitle", "time": 5438.629, "timestamp": "01:30:38", "text": "そこにありますか、私はそれを見ているようなものです"}, {"type": "subtitle", "time": 5442.709, "timestamp": "01:30:42", "text": "その会社はまだなくなっていない。"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "それはなくなってしまった。それはなくなってしまった。それはなくなってしまった。"}, {"type": "subtitle", "time": 5447.99, "timestamp": "01:30:47", "text": "私はアーモンドウォーターを1つ持って走っています。"}, {"type": "subtitle", "time": 5449.75, "timestamp": "01:30:49", "text": "ハローレモネード2個。お元気ですか？"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "毎日順調です。"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "だから、鏡を見つける必要がある"}, {"type": "subtitle", "time": 5459.189, "timestamp": "01:30:59", "text": "けれど。いいえ。え、そうなんですか？うん。壊れた"}]
[{"type": "subtitle", "time": 5222.31, "timestamp": "01:27:02", "text": "こいつ変な奴だ。彼がそうするように"}, {"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "さらなる被害。そこが問題なんです。彼はそうする"}, {"type": "subtitle", "time": 5227.83, "timestamp": "01:27:07", "text": "さらなる被害。さらに、彼は"}, {"type": "subtitle", "time": 5231.03, "timestamp": "01:27:11", "text": "ルールを全く守らない。それはとても"}, {"type": "subtitle", "time": 5232.43, "timestamp": "01:27:12", "text": "バカ。"}, {"type": "subtitle", "time": 5235.95, "timestamp": "01:27:15", "text": "なぜ？彼は"}, {"type": "subtitle", "time": 5242.07, "timestamp": "01:27:22", "text": "私たちにとってはそうかもしれないが、彼はそうではない。変人。うん。"}, {"type": "subtitle", "time": 5249.99, "timestamp": "01:27:29", "text": "もし私が彼にローカットを食らわせたらどうなるだろう？"}, {"type": "subtitle", "time": 5251.55, "timestamp": "01:27:31", "text": "ええ、それが私が"}, {"type": "subtitle", "time": 5255.59, "timestamp": "01:27:35", "text": "した。なんて馬鹿げてるんだ。私はこう思う、それは"}, {"type": "subtitle", "time": 5264.55, "timestamp": "01:27:44", "text": "わかった。ところで、あなたは生きていましたね。ニース。"}, {"type": "subtitle", "time": 5266.55, "timestamp": "01:27:46", "text": "ああ、分かったよ。彼は君の後ろにいる。何てことだ。"}, {"type": "subtitle", "time": 5268.87, "timestamp": "01:27:48", "text": "何てことだ。とにかく走れ。とにかく走れ。とにかく走れ。"}, {"type": "subtitle", "time": 5270.639, "timestamp": "01:27:50", "text": "とにかく走れ。 私は彼をからかうだろう。"}, {"type": "subtitle", "time": 5278.79, "timestamp": "01:27:58", "text": "はい、お願いします。"}]
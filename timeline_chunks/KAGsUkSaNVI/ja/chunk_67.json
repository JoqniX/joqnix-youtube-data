[{"type": "subtitle", "time": 4023.349, "timestamp": "01:07:03", "text": "ジョックって何？"}, {"type": "subtitle", "time": 4025.95, "timestamp": "01:07:05", "text": "そうですね、そう思います"}, {"type": "subtitle", "time": 4029.19, "timestamp": "01:07:09", "text": "まずイエス様を第一に考えなさい。私はまだフォローしています"}, {"type": "subtitle", "time": 4033.309, "timestamp": "01:07:13", "text": "ちなみに、あなたもですよ。どこにある"}, {"type": "subtitle", "time": 4037.27, "timestamp": "01:07:17", "text": "心拍？私は自分のものを見つけたのを見た。"}, {"type": "subtitle", "time": 4040.39, "timestamp": "01:07:20", "text": "そうそう。ドアは見つかりましたか？えーと"}, {"type": "subtitle", "time": 4043.029, "timestamp": "01:07:23", "text": "ドアを探しましょう。ドアを探してください。えっと、"}, {"type": "subtitle", "time": 4051.029, "timestamp": "01:07:31", "text": "一緒に。キラキラ光る"}, {"type": "subtitle", "time": 4053.39, "timestamp": "01:07:33", "text": "効果音。輝きを追って"}, {"type": "subtitle", "time": 4056.87, "timestamp": "01:07:36", "text": "魂みたいなもの。"}, {"type": "subtitle", "time": 4059.109, "timestamp": "01:07:39", "text": "俺は全力を尽くすよ。基本的に"}, {"type": "subtitle", "time": 4061.51, "timestamp": "01:07:41", "text": "ええ、白いドアを見つけたら、"}, {"type": "subtitle", "time": 4065.51, "timestamp": "01:07:45", "text": "知ってるよ。私もリスポーンします。私は戻ってきました"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "左に戻った。イエス・キリスト。おお、"}, {"type": "subtitle", "time": 4073.029, "timestamp": "01:07:53", "text": "いいえ。大丈夫。大丈夫。白い"}, {"type": "subtitle", "time": 4075.71, "timestamp": "01:07:55", "text": "魂のものが来る"}, {"type": "subtitle", "time": 4078.51, "timestamp": "01:07:58", "text": "15秒ごとに、私は"}]
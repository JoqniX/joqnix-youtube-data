[{"type": "subtitle", "time": 19140.51, "timestamp": "05:19:00", "text": "行くかもしれない"}, {"type": "subtitle", "time": 19142.51, "timestamp": "05:19:02", "text": "と"}, {"type": "subtitle", "time": 19149.03, "timestamp": "05:19:09", "text": "私の霜センサーを見てみましょう。ホワイト"}, {"type": "subtitle", "time": 19153.27, "timestamp": "05:19:13", "text": "女王はどんな時でも自分の欲しいものを手に入れる"}, {"type": "subtitle", "time": 19160.15, "timestamp": "05:19:20", "text": "君の仕事は一つだけだ。できるだけ多く"}]
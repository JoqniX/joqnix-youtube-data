[{"type": "subtitle", "time": 22620.11, "timestamp": "06:17:00", "text": "[音楽]"}, {"type": "subtitle", "time": 22622.628, "timestamp": "06:17:02", "text": "主よ、そのお金があれば私は"}, {"type": "subtitle", "time": 22632.708, "timestamp": "06:17:12", "text": "どうでも。私はもっ​​と多くのことができたはずだった。私"}, {"type": "subtitle", "time": 22644.11, "timestamp": "06:17:24", "text": "ひるむな。弱い企業は規模を拡大されるだろう。"}, {"type": "subtitle", "time": 22646.39, "timestamp": "06:17:26", "text": "ついに。エコー。そして私は料理されるのが大嫌いです"}, {"type": "subtitle", "time": 22666.788, "timestamp": "06:17:46", "text": "斧はいいし、あなたが手に入れるまでは"}, {"type": "subtitle", "time": 22674.23, "timestamp": "06:17:54", "text": "すべて。そうしないと、"}]
[{"type": "subtitle", "time": 4982.51, "timestamp": "01:23:02", "text": "「あの、あの気味の悪いやつに会ったっけ？」"}, {"type": "subtitle", "time": 4984.91, "timestamp": "01:23:04", "text": "ああ、これは"}, {"type": "subtitle", "time": 4987.79, "timestamp": "01:23:07", "text": "1. だから、これは"}, {"type": "subtitle", "time": 4990.95, "timestamp": "01:23:10", "text": "アーモンドウォーター。良さそうですね。病気"}, {"type": "subtitle", "time": 4994.79, "timestamp": "01:23:14", "text": "くらえ。あれが少なくなってきた。"}, {"type": "subtitle", "time": 4998.79, "timestamp": "01:23:18", "text": "だから、これに関するコードを見つける必要がある。"}, {"type": "subtitle", "time": 5002.31, "timestamp": "01:23:22", "text": "私たちはこれを好きになれません。"}, {"type": "subtitle", "time": 5004.629, "timestamp": "01:23:24", "text": "いいえ、ゲームごとに異なります"}, {"type": "subtitle", "time": 5007.51, "timestamp": "01:23:27", "text": "今。それが問題点です。"}, {"type": "subtitle", "time": 5011.43, "timestamp": "01:23:31", "text": "待って。えっと、5時35分ですよね？もし私たちが"}, {"type": "subtitle", "time": 5015.91, "timestamp": "01:23:35", "text": "あの時、こっちで？ええ、確かに努力はしましたよ。"}, {"type": "subtitle", "time": 5017.669, "timestamp": "01:23:37", "text": "はい、ドアを閉めます"}, {"type": "subtitle", "time": 5019.669, "timestamp": "01:23:39", "text": "場合。何か音が聞こえる。たとえ"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "クリップのようなあらゆる存在"}, {"type": "subtitle", "time": 5028.99, "timestamp": "01:23:48", "text": "これは"}, {"type": "subtitle", "time": 5034.709, "timestamp": "01:23:54", "text": "仕事。うまくいかない。わかった。それで、えーと、私たちは"}, {"type": "subtitle", "time": 5037.51, "timestamp": "01:23:57", "text": "探求する必要がある。あ、えっと、Iが必要です"}, {"type": "subtitle", "time": 5039.669, "timestamp": "01:23:59", "text": "今、ハンマーを私の手元に持っています。つまり、これは"}]
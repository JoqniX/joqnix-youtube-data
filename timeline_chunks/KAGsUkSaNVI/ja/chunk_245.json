[{"type": "subtitle", "time": 14705.59, "timestamp": "04:05:05", "text": "彼らは一つの宇宙からやってくる"}, {"type": "subtitle", "time": 14710.309, "timestamp": "04:05:10", "text": "私の人生の次の物語への災難。"}, {"type": "subtitle", "time": 14712.469, "timestamp": "04:05:12", "text": "素晴らしい、エディ。私たちは"}, {"type": "subtitle", "time": 14716.389, "timestamp": "04:05:16", "text": "またチームを組む話か。そうだよ、スパイダー。"}, {"type": "subtitle", "time": 14718.87, "timestamp": "04:05:18", "text": "それは問題ですか？あなたが"}, {"type": "subtitle", "time": 14720.79, "timestamp": "04:05:20", "text": "その汚い大きな舌を遠くへ持って行け"}, {"type": "subtitle", "time": 14733.63, "timestamp": "04:05:33", "text": "戦いの場所。 4 3 2"}, {"type": "subtitle", "time": 14736.15, "timestamp": "04:05:36", "text": "1. 彼らが確保するのを阻止しなければならない"}, {"type": "subtitle", "time": 14739.11, "timestamp": "04:05:39", "text": "ミッションエリア。"}, {"type": "subtitle", "time": 14742.15, "timestamp": "04:05:42", "text": "このような予測不可能な状況では。"}, {"type": "subtitle", "time": 14745.71, "timestamp": "04:05:45", "text": "待って、これは何？残る"}]
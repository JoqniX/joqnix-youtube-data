[{"type": "subtitle", "time": 1620.47, "timestamp": "00:27:00", "text": "今日は彼女の記念日で、そこで彼女は"}, {"type": "subtitle", "time": 1623.87, "timestamp": "00:27:03", "text": "彼女はこのことについてツイートした"}, {"type": "subtitle", "time": 1625.87, "timestamp": "00:27:05", "text": "芸術作品。"}, {"type": "subtitle", "time": 1627.87, "timestamp": "00:27:07", "text": "ニース。それは"}, {"type": "chat", "time": 1632.27, "timestamp": "00:27:12", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "oh ciel's on a hiatus? damn..."}, {"type": "chat", "time": 1635.614, "timestamp": "00:27:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "i hate her too now"}, {"type": "subtitle", "time": 1637.909, "timestamp": "00:27:17", "text": "それ？ C法。ああ、コウは"}, {"type": "subtitle", "time": 1639.149, "timestamp": "00:27:19", "text": "コンサート。"}, {"type": "subtitle", "time": 1643.269, "timestamp": "00:27:23", "text": "ニース。ご覧ください。何も望まない"}, {"type": "chat", "time": 1652.171, "timestamp": "00:27:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "(i shall hate anyone and everyone)"}, {"type": "subtitle", "time": 1662.149, "timestamp": "00:27:42", "text": "h.そう、これは新しい、新しい"}, {"type": "subtitle", "time": 1668.75, "timestamp": "00:27:48", "text": "歌手ではなく、ライブ演奏者。彼女は悲しい表情をしている"}, {"type": "subtitle", "time": 1671.269, "timestamp": "00:27:51", "text": "悲しみ。待って、忘れてた。えっと、"}, {"type": "subtitle", "time": 1673.549, "timestamp": "00:27:53", "text": "彼女は演じている"}, {"type": "subtitle", "time": 1676.35, "timestamp": "00:27:56", "text": "また？ええ、彼女は"}, {"type": "subtitle", "time": 1678.789, "timestamp": "00:27:58", "text": "ええ、二人とも一緒に描いています。"}]
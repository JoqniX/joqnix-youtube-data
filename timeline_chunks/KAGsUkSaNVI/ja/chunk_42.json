[{"type": "subtitle", "time": 2520.589, "timestamp": "00:42:00", "text": "なぜあなたが突き進むのか分からない"}, {"type": "subtitle", "time": 2524.63, "timestamp": "00:42:04", "text": "ここ。ロビーを見て、ああ、"}, {"type": "subtitle", "time": 2528.23, "timestamp": "00:42:08", "text": "またね。それはあなたです。こんにちは、ジャックさん。"}, {"type": "subtitle", "time": 2530.23, "timestamp": "00:42:10", "text": "こんにちは。あなたはまるで存在のようです"}, {"type": "subtitle", "time": 2533.43, "timestamp": "00:42:13", "text": "方法。私はします。イエス・キリスト。見ないで"}, {"type": "subtitle", "time": 2536.95, "timestamp": "00:42:16", "text": "私を見て。ああ、なんてこった。"}, {"type": "subtitle", "time": 2541.349, "timestamp": "00:42:21", "text": "ところで、あなたは恐ろしい顔をしていますよ。私はします。"}, {"type": "subtitle", "time": 2543.829, "timestamp": "00:42:23", "text": "おお。"}, {"type": "subtitle", "time": 2545.55, "timestamp": "00:42:25", "text": "何てことだ。"}, {"type": "subtitle", "time": 2548.87, "timestamp": "00:42:28", "text": "おお。いらっしゃいませ。こんにちは。こんにちは。黄色。"}, {"type": "subtitle", "time": 2551.349, "timestamp": "00:42:31", "text": "黄色。わかった。 1秒。もちろん。それは"}, {"type": "subtitle", "time": 2554.069, "timestamp": "00:42:34", "text": "確かにジャンプスケアだ。それはとても"}, {"type": "subtitle", "time": 2556.87, "timestamp": "00:42:36", "text": "恐ろしいジャンプスケア。置かせてください"}, {"type": "subtitle", "time": 2561.03, "timestamp": "00:42:41", "text": "わかりません。仕事の組み合わせはこんな感じでした"}, {"type": "subtitle", "time": 2562.71, "timestamp": "00:42:42", "text": "えっと、インスタグラムのストーリーの錠剤"}, {"type": "subtitle", "time": 2565.589, "timestamp": "00:42:45", "text": "あなたを落ち着かせるために使われます。彼らは使用するだろう"}, {"type": "subtitle", "time": 2569.589, "timestamp": "00:42:49", "text": "あなたの不安。ゲームありがとう。本当に本当に"}, {"type": "subtitle", "time": 2571.91, "timestamp": "00:42:51", "text": "感謝します。あ、待って、トーテムのやつ"}, {"type": "subtitle", "time": 2577.589, "timestamp": "00:42:57", "text": "も表示されます。ああ、それはすごくクールだね。"}, {"type": "subtitle", "time": 2579.109, "timestamp": "00:42:59", "text": "ともかく、"}]
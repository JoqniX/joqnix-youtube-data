[{"type": "subtitle", "time": 4200.63, "timestamp": "01:10:00", "text": "わからない。おそらく。あ、待って。する"}, {"type": "subtitle", "time": 4202.79, "timestamp": "01:10:02", "text": "これ。指をどれか1つに入れてみてください"}, {"type": "subtitle", "time": 4206.39, "timestamp": "01:10:06", "text": "それらのうち、私たちがまだ掲載していないもの。"}, {"type": "subtitle", "time": 4213.63, "timestamp": "01:10:13", "text": "ええ、それを置いて、ええと、行く"}, {"type": "subtitle", "time": 4215.99, "timestamp": "01:10:15", "text": "戻る。何も起こらなかった。それからそれを持って行ってください"}, {"type": "subtitle", "time": 4224.51, "timestamp": "01:10:24", "text": "わかった。だから、それを血液に塗ると"}, {"type": "subtitle", "time": 4228.63, "timestamp": "01:10:28", "text": "死体だと思います。"}, {"type": "subtitle", "time": 4232.39, "timestamp": "01:10:32", "text": "わかった。わかった。私がそこにそれを置いたんです。"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "よし。つまり、何も起こらなかったということですよね？"}, {"type": "subtitle", "time": 4236.47, "timestamp": "01:10:36", "text": "だから、私たちは連れて行くことができます、あなたは連れて行くことができます、私は"}, {"type": "subtitle", "time": 4242.95, "timestamp": "01:10:42", "text": "何かが起こった。ええ、ありますよ"}, {"type": "subtitle", "time": 4245.99, "timestamp": "01:10:45", "text": "音のように。音または"}, {"type": "subtitle", "time": 4247.59, "timestamp": "01:10:47", "text": "何か。"}, {"type": "subtitle", "time": 4251.03, "timestamp": "01:10:51", "text": "少し色味を。前回もそうしました。いいえ。"}, {"type": "subtitle", "time": 4254.55, "timestamp": "01:10:54", "text": "ああ、でも私たちはここで止めました。"}]
[{"type": "subtitle", "time": 188.589, "timestamp": "00:03:08", "text": "月？それでは、Twitchでライブ配信します。"}, {"type": "subtitle", "time": 191.27, "timestamp": "00:03:11", "text": "良い。ねえ、君のところに住まわせてくれないか、"}, {"type": "subtitle", "time": 193.50900000000001, "timestamp": "00:03:13", "text": "ビリー。ビリー、大丈夫だよ。私は"}, {"type": "subtitle", "time": 201.71, "timestamp": "00:03:21", "text": "また。私たちがどこへ行くにも"}, {"type": "subtitle", "time": 205.75, "timestamp": "00:03:25", "text": "ライブ。皆さん、ようこそ。いらっしゃいませ"}, {"type": "subtitle", "time": 208.22899999999998, "timestamp": "00:03:28", "text": "入って。ようこそ。ようこそ。温かい温かい"}, {"type": "subtitle", "time": 212.99, "timestamp": "00:03:32", "text": "皆さん、おはようございます。今日は5月です"}, {"type": "subtitle", "time": 217.35, "timestamp": "00:03:37", "text": "2025年1月1日、現在時刻は10時50分です。"}, {"type": "subtitle", "time": 221.50900000000001, "timestamp": "00:03:41", "text": "午前。もうすぐ午前11時になります。そして私はただ"}, {"type": "subtitle", "time": 224.27, "timestamp": "00:03:44", "text": "新しいと言いたい"}, {"type": "subtitle", "time": 226.67000000000002, "timestamp": "00:03:46", "text": "月。それは新しい"}, {"type": "subtitle", "time": 228.35, "timestamp": "00:03:48", "text": "月。"}, {"type": "subtitle", "time": 232.43, "timestamp": "00:03:52", "text": "そう、まさに"}, {"type": "subtitle", "time": 237.07, "timestamp": "00:03:57", "text": "えっと、私たちは"}]
[{"type": "subtitle", "time": 18662.39, "timestamp": "05:11:02", "text": "1つ。えっと、どう言えばいいんだろう？はい、私は"}, {"type": "subtitle", "time": 18664.868, "timestamp": "05:11:04", "text": "戻る。えっと"}, {"type": "subtitle", "time": 18667.99, "timestamp": "05:11:07", "text": "ああ、罰を受けた。"}, {"type": "subtitle", "time": 18674.55, "timestamp": "05:11:14", "text": "ああ、これはまずい。"}, {"type": "subtitle", "time": 18679.03, "timestamp": "05:11:19", "text": "どうやら、believeがそれを解明したようだ"}, {"type": "subtitle", "time": 18681.75, "timestamp": "05:11:21", "text": "これはAFK（離席）状態です。"}, {"type": "subtitle", "time": 18689.78, "timestamp": "05:11:29", "text": "Superangoでさらにお得に。"}, {"type": "subtitle", "time": 18691.67, "timestamp": "05:11:31", "text": "[笑い]"}, {"type": "subtitle", "time": 18699.67, "timestamp": "05:11:39", "text": "待って、待って。いや、待って。どこにあるの"}, {"type": "subtitle", "time": 18702.15, "timestamp": "05:11:42", "text": "ブラウザ？ああ、今やっと気づいたんだ"}, {"type": "subtitle", "time": 18709.35, "timestamp": "05:11:49", "text": "あなたは英語が読めますか？誰が？どの管理者ですか？"}, {"type": "subtitle", "time": 18712.708, "timestamp": "05:11:52", "text": "どの管理者が私を通報したんだ？"}, {"type": "subtitle", "time": 18714.55, "timestamp": "05:11:54", "text": "管理者が私を通報しました。私は行かない"}, {"type": "subtitle", "time": 18718.15, "timestamp": "05:11:58", "text": "信じる。私は誓います。行くよ"}]
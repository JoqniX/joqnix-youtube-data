[{"type": "subtitle", "time": 16202.87, "timestamp": "04:30:02", "text": "世界を救うなら、他に誰もいらない"}, {"type": "subtitle", "time": 16205.59, "timestamp": "04:30:05", "text": "あなたよりも。ナット、君にも同じように言ってあげるよ。見せて"}, {"type": "subtitle", "time": 16209.51, "timestamp": "04:30:09", "text": "破滅へのチャンスを得られる場所。了解しました。私"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "認めざるを得ないが、"}, {"type": "subtitle", "time": 16224.79, "timestamp": "04:30:24", "text": "戦闘開始まで5、4、3、2、1。"}, {"type": "subtitle", "time": 16226.229, "timestamp": "04:30:26", "text": "必要なのは、"}, {"type": "subtitle", "time": 16228.95, "timestamp": "04:30:28", "text": "任務地域。わかった。"}, {"type": "subtitle", "time": 16230.87, "timestamp": "04:30:30", "text": "わかった。都市を周回する"}, {"type": "subtitle", "time": 16233.51, "timestamp": "04:30:33", "text": "ヴィブラニウム。捕まえた。捕まえた。あなたは"}]
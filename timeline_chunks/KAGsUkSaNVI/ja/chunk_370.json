[{"type": "subtitle", "time": 22204.67, "timestamp": "06:10:04", "text": "私を"}, {"type": "subtitle", "time": 22213.83, "timestamp": "06:10:13", "text": "ひどく眠くなる。ただ眠りたいだけ"}, {"type": "subtitle", "time": 22216.03, "timestamp": "06:10:16", "text": "と共に"}, {"type": "subtitle", "time": 22220.628, "timestamp": "06:10:20", "text": "エアコンが効いていて寒い。私は母のことを知っている、彼女は"}, {"type": "subtitle", "time": 22223.708, "timestamp": "06:10:23", "text": "彼女はエアコンなしでは生きていけない。いつものように"}, {"type": "subtitle", "time": 22227.43, "timestamp": "06:10:27", "text": "エアコンなしで私は生きてきた"}, {"type": "subtitle", "time": 22232.59, "timestamp": "06:10:32", "text": "もうしばらく経ちます。そして私が日光浴をするとき"}, {"type": "subtitle", "time": 22237.51, "timestamp": "06:10:37", "text": "AC、私はよく、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 22240.19, "timestamp": "06:10:40", "text": "それ？寒くて"}, {"type": "subtitle", "time": 22243.868, "timestamp": "06:10:43", "text": "もの。発熱と発疹があるかもしれない"}, {"type": "subtitle", "time": 22257.88, "timestamp": "06:10:57", "text": "なんで誰もショートを使わないんだ"}]
[{"type": "subtitle", "time": 2100.47, "timestamp": "00:35:00", "text": "ジョンは私を困らせない。あなたにメッセージを送りました"}, {"type": "subtitle", "time": 2102.87, "timestamp": "00:35:02", "text": "私が配信しなかったすべての人"}, {"type": "subtitle", "time": 2106.43, "timestamp": "00:35:06", "text": "ちなみに、奥の方です。どうやって"}, {"type": "subtitle", "time": 2109.91, "timestamp": "00:35:09", "text": "内側には私は逃げ出した"}, {"type": "subtitle", "time": 2112.99, "timestamp": "00:35:12", "text": "後ろと後ろの内側に"}, {"type": "subtitle", "time": 2117.03, "timestamp": "00:35:17", "text": "あなたが望むなら、"}, {"type": "subtitle", "time": 2121.19, "timestamp": "00:35:21", "text": "ロビーって聞いたことありますか？"}, {"type": "subtitle", "time": 2123.349, "timestamp": "00:35:23", "text": "マシンが切断されました。私は戻ってきたのでしょうか？"}, {"type": "subtitle", "time": 2126.19, "timestamp": "00:35:26", "text": "待って。わかった。私は招待できます 私はそうするべきです"}, {"type": "subtitle", "time": 2127.99, "timestamp": "00:35:27", "text": "戻る。"}, {"type": "subtitle", "time": 2130.589, "timestamp": "00:35:30", "text": "なんてこった、広い"}, {"type": "subtitle", "time": 2133.47, "timestamp": "00:35:33", "text": "画面。私は何をしたのか"}, {"type": "subtitle", "time": 2137.99, "timestamp": "00:35:37", "text": "する？ああ、なんてことだ、ワイドスクリーンだ。なぜ"}, {"type": "subtitle", "time": 2140.95, "timestamp": "00:35:40", "text": "これは普通のことですか？フラッシュを入手しました。私のデスクトップは"}, {"type": "subtitle", "time": 2142.19, "timestamp": "00:35:42", "text": "文字通り"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "閃光弾。なぜ"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "私は戻ってきたのでしょうか？"}, {"type": "subtitle", "time": 2155.27, "timestamp": "00:35:55", "text": "何でもする。"}]
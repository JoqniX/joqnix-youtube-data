[{"type": "subtitle", "time": 16327.51, "timestamp": "04:32:07", "text": "兄弟。これは"}, {"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "ハルク。お前を殺しに行く"}, {"type": "subtitle", "time": 16336.309, "timestamp": "04:32:16", "text": "兄弟、"}, {"type": "subtitle", "time": 16339.67, "timestamp": "04:32:19", "text": "何？肩をひねったと思う。"}, {"type": "subtitle", "time": 16343.75, "timestamp": "04:32:23", "text": "私はそのロード・オブ・"}, {"type": "subtitle", "time": 16346.189, "timestamp": "04:32:26", "text": "最大"}, {"type": "subtitle", "time": 16348.95, "timestamp": "04:32:28", "text": "脈。私を守ってください。彼らのチームの捕獲"}, {"type": "subtitle", "time": 16373.03, "timestamp": "04:32:53", "text": "おいおい。"}]
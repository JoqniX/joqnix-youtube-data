[{"type": "subtitle", "time": 15193.99, "timestamp": "04:13:13", "text": "攻撃する30秒前。準備してください。"}, {"type": "subtitle", "time": 15197.59, "timestamp": "04:13:17", "text": "ハックアンドスラッシュ。あなたは気が散っているようです"}, {"type": "subtitle", "time": 15201.75, "timestamp": "04:13:21", "text": "それ。私の"}, {"type": "subtitle", "time": 15205.149, "timestamp": "04:13:25", "text": "また。過去は時折私と交流し、"}, {"type": "subtitle", "time": 15207.99, "timestamp": "04:13:27", "text": "良い。なるほど。"}, {"type": "subtitle", "time": 15210.55, "timestamp": "04:13:30", "text": "ええ、私はそれを引き起こすつもりはありませんが、"}, {"type": "subtitle", "time": 15213.269, "timestamp": "04:13:33", "text": "もしかしたら、あなたはもっと良い神を見つけたのかもしれない。の"}, {"type": "subtitle", "time": 15219.75, "timestamp": "04:13:39", "text": "戦闘開始まで5、4、3、2、1。"}, {"type": "subtitle", "time": 15221.51, "timestamp": "04:13:41", "text": "私がすべきことは、ミッションを遂行することだけです。"}, {"type": "subtitle", "time": 15224.269, "timestamp": "04:13:44", "text": "エリア。わかった。"}, {"type": "subtitle", "time": 15227.83, "timestamp": "04:13:47", "text": "正直言って、子供の頃は雪が好きじゃなかった。"}, {"type": "subtitle", "time": 15229.349, "timestamp": "04:13:49", "text": "高金は常に投げ捨てようとした"}]
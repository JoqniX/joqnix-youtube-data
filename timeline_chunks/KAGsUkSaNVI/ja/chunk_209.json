[{"type": "subtitle", "time": 12576.51, "timestamp": "03:29:36", "text": "疑問符を癒す。疑問符を癒す。"}, {"type": "subtitle", "time": 12579.429, "timestamp": "03:29:39", "text": "こんにちは。癒す。疑問符。どこ？癒す。"}, {"type": "subtitle", "time": 12587.429, "timestamp": "03:29:47", "text": "別の曲を演奏するべきだ。できない"}, {"type": "subtitle", "time": 12589.19, "timestamp": "03:29:49", "text": "私を長く抑えつけておくことはできない。忘却は"}]
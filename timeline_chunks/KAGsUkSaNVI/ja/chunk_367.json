[{"type": "subtitle", "time": 22031.83, "timestamp": "06:07:11", "text": "ボタン。おお、ナイスショット。"}, {"type": "subtitle", "time": 22034.67, "timestamp": "06:07:14", "text": "頭の動かし方を学ぶ必要がある"}, {"type": "subtitle", "time": 22038.67, "timestamp": "06:07:18", "text": "ショット。たとえ角度スナップがあっても"}, {"type": "subtitle", "time": 22041.59, "timestamp": "06:07:21", "text": "角度スナップをオンにしても"}, {"type": "subtitle", "time": 22044.548, "timestamp": "06:07:24", "text": "続けるには、まだ頭の動かし方を学ばなければならない"}]
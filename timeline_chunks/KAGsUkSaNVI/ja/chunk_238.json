[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "月があなたを悩ませる。どうやってクラッチしたんだろう？"}, {"type": "subtitle", "time": 14296.67, "timestamp": "03:58:16", "text": "それ。ああ、"}, {"type": "subtitle", "time": 14298.389, "timestamp": "03:58:18", "text": "兄弟。"}, {"type": "subtitle", "time": 14300.71, "timestamp": "03:58:20", "text": "私は逃げられなかった。私は走ることができなかった"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "離れて。"}, {"type": "subtitle", "time": 14306.15, "timestamp": "03:58:26", "text": "消えゆくもの。"}, {"type": "subtitle", "time": 14319.03, "timestamp": "03:58:39", "text": "その車両を停止させる必要があります"}, {"type": "subtitle", "time": 14321.75, "timestamp": "03:58:41", "text": "トラック。"}, {"type": "subtitle", "time": 14334.87, "timestamp": "03:58:54", "text": "素晴らしい混乱で私たちを喜ばせてください"}]
[{"type": "subtitle", "time": 5580.39, "timestamp": "01:33:00", "text": "ここにいて。"}, {"type": "subtitle", "time": 5582.709, "timestamp": "01:33:02", "text": "ああ、わかりました。それはいいです。不気味な顔は"}, {"type": "subtitle", "time": 5585.91, "timestamp": "01:33:05", "text": "私たちのすぐ右側にあります。見ないで。"}, {"type": "subtitle", "time": 5587.51, "timestamp": "01:33:07", "text": "見ないで。見ないで。あそこにあるよ。"}, {"type": "subtitle", "time": 5589.43, "timestamp": "01:33:09", "text": "彼はあそこにいる。ああ、そこにある。彼は"}, {"type": "subtitle", "time": 5591.99, "timestamp": "01:33:11", "text": "そこには。まっすぐ進むとか、"}, {"type": "subtitle", "time": 5595.31, "timestamp": "01:33:15", "text": "何か。彼は角にいる"}, {"type": "subtitle", "time": 5598.629, "timestamp": "01:33:18", "text": "笑顔。なんて親切なの。おお。ああ、彼は"}, {"type": "subtitle", "time": 5600.31, "timestamp": "01:33:20", "text": "去った。"}, {"type": "subtitle", "time": 5602.87, "timestamp": "01:33:22", "text": "彼はもういない。わかった。よし。さあ、私は試してみます"}, {"type": "subtitle", "time": 5605.47, "timestamp": "01:33:25", "text": "相手を向く"}, {"type": "subtitle", "time": 5608.39, "timestamp": "01:33:28", "text": "1つ。あなたは赤いヒューズを入れた、"}, {"type": "subtitle", "time": 5610.79, "timestamp": "01:33:30", "text": "右？それをオフにします。 1つ"}, {"type": "subtitle", "time": 5612.229, "timestamp": "01:33:32", "text": "去った。 1つなくなった。真ん中のやつがなくなった"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "今。今はどうでしょうか？ああ、その、その、その"}, {"type": "subtitle", "time": 5617.75, "timestamp": "01:33:37", "text": "3番目はオンになっているが、真ん中のは"}, {"type": "subtitle", "time": 5629.669, "timestamp": "01:33:49", "text": "ああ、何かしくじってしまったかな？"}, {"type": "subtitle", "time": 5633.07, "timestamp": "01:33:53", "text": "いいえ。では、待ってください。"}]
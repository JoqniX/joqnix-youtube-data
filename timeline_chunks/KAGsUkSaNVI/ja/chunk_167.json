[{"type": "subtitle", "time": 10030.87, "timestamp": "02:47:10", "text": "オレンジを捕獲したり、その他すべて。その"}, {"type": "subtitle", "time": 10033.71, "timestamp": "02:47:13", "text": "ただ、それはあまりにも"}, {"type": "subtitle", "time": 10036.87, "timestamp": "02:47:16", "text": "動作が遅い。アップロード用のVを付けましょう"}, {"type": "subtitle", "time": 10043.07, "timestamp": "02:47:23", "text": "よし、このゲームをプレイするから"}, {"type": "subtitle", "time": 10046.309, "timestamp": "02:47:26", "text": "でも、少なくとも私は"}, {"type": "subtitle", "time": 10060.75, "timestamp": "02:47:40", "text": "これで終わりにします。"}, {"type": "subtitle", "time": 10064.07, "timestamp": "02:47:44", "text": "少し。しばらくここを閉じます。"}, {"type": "subtitle", "time": 10066.99, "timestamp": "02:47:46", "text": "水とその他すべてを遮断する必要がある"}, {"type": "subtitle", "time": 10074.63, "timestamp": "02:47:54", "text": "素早い。水を減らして"}, {"type": "subtitle", "time": 10076.469, "timestamp": "02:47:56", "text": "すべて。だから、そうするつもりだ"}]
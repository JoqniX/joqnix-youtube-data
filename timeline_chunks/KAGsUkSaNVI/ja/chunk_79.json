[{"type": "subtitle", "time": 4741.51, "timestamp": "01:19:01", "text": "わかった。それでは実際に"}, {"type": "subtitle", "time": 4745.11, "timestamp": "01:19:05", "text": "実際の試合。ええ、もちろんです。えっと、やってみよう"}, {"type": "subtitle", "time": 4748.149, "timestamp": "01:19:08", "text": "それ。ところで、あなたはどこにいるのですか？私は中にいます。"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "まるで"}, {"type": "subtitle", "time": 4753.189, "timestamp": "01:19:13", "text": "ケーブル工事の作業員について行きましょう。はい、"}, {"type": "subtitle", "time": 4755.27, "timestamp": "01:19:15", "text": "ケーブルテレビの修理工。私は近くにいます。ご覧のとおり"}, {"type": "subtitle", "time": 4763.51, "timestamp": "01:19:23", "text": "こんな風に"}, {"type": "subtitle", "time": 4766.95, "timestamp": "01:19:26", "text": "追い詰められつつある。えっと、それは"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "これってクール？"}, {"type": "subtitle", "time": 4772.95, "timestamp": "01:19:32", "text": "だから、私たちは知っています。"}, {"type": "subtitle", "time": 4775.75, "timestamp": "01:19:35", "text": "わかった。あなたはどこにいましたか？あなたはどこにいますか？わかった。"}, {"type": "subtitle", "time": 4780.63, "timestamp": "01:19:40", "text": "それで、時計のやつを元に戻しました。わかった。私たちは"}, {"type": "subtitle", "time": 4782.79, "timestamp": "01:19:42", "text": "時計の1つを完成させました。私たちはする必要がある"}, {"type": "subtitle", "time": 4784.709, "timestamp": "01:19:44", "text": "体の方。では、体の部位について。のために"}, {"type": "subtitle", "time": 4786.91, "timestamp": "01:19:46", "text": "体の部位、見つける必要がある"}, {"type": "subtitle", "time": 4792.149, "timestamp": "01:19:52", "text": "足。足については、"}, {"type": "subtitle", "time": 4794.03, "timestamp": "01:19:54", "text": "放射線"}, {"type": "subtitle", "time": 4796.39, "timestamp": "01:19:56", "text": "場所。ああ、放射線。私たちには"}, {"type": "subtitle", "time": 4798.55, "timestamp": "01:19:58", "text": "放射線防護服を着て中に入る"}]
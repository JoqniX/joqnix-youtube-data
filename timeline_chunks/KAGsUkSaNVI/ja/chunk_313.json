[{"type": "subtitle", "time": 18781.99, "timestamp": "05:13:01", "text": "みんな。ドゥームをプレイしよう"}, {"type": "subtitle", "time": 18783.23, "timestamp": "05:13:03", "text": "マッチ"}, {"type": "subtitle", "time": 18786.13, "timestamp": "05:13:06", "text": "実際にはもっと"}, {"type": "subtitle", "time": 18792.19, "timestamp": "05:13:12", "text": "動き。さあ"}, {"type": "subtitle", "time": 18795.83, "timestamp": "05:13:15", "text": "行く。それから、ちなみに私は戻ってきました。言う"}, {"type": "subtitle", "time": 18799.868, "timestamp": "05:13:19", "text": "[音楽]"}, {"type": "subtitle", "time": 18803.92, "timestamp": "05:13:23", "text": "こんにちは。お茶を少し。紅茶。"}, {"type": "subtitle", "time": 18820.67, "timestamp": "05:13:40", "text": "創業者。"}, {"type": "subtitle", "time": 18823.59, "timestamp": "05:13:43", "text": "サント・サントルム。これは君一人だ"}, {"type": "subtitle", "time": 18827.03, "timestamp": "05:13:47", "text": "時間は限られているので、賢く選びましょう。賢明に選択してください。"}, {"type": "subtitle", "time": 18830.39, "timestamp": "05:13:50", "text": "彼女は言った、「誰かが戦いを挑む」"}, {"type": "subtitle", "time": 18839.11, "timestamp": "05:13:59", "text": "5、4、3、2、1でスタート。"}]
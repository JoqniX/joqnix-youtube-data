[{"type": "subtitle", "time": 2160.71, "timestamp": "00:36:00", "text": "何てことだ。出口。ええ、実際は"}, {"type": "subtitle", "time": 2163.19, "timestamp": "00:36:03", "text": "どちらが良いですか？私が何者であろうとも"}, {"type": "subtitle", "time": 2164.71, "timestamp": "00:36:04", "text": "再生中"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "奥の部屋の中。脱出"}, {"type": "subtitle", "time": 2169.67, "timestamp": "00:36:09", "text": "バスルームには強化されたグラフィックがあります"}, {"type": "subtitle", "time": 2172.79, "timestamp": "00:36:12", "text": "そして、脱出の良いところは"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "奥の部屋には安全な場所はありません。"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "どうやら彼らのロビーは安全な場所らしい"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "ここだが、脱出の裏部屋では"}, {"type": "subtitle", "time": 2182.39, "timestamp": "00:36:22", "text": "そこに準備されたエンティティがあります"}, {"type": "subtitle", "time": 2185.829, "timestamp": "00:36:25", "text": "お前を殺す。というわけで、そういうことです。"}, {"type": "subtitle", "time": 2187.069, "timestamp": "00:36:27", "text": "それで、"}, {"type": "subtitle", "time": 2191.109, "timestamp": "00:36:31", "text": "司会はジャック・ニック氏。はい、私は立ち上げます"}, {"type": "subtitle", "time": 2191.87, "timestamp": "00:36:31", "text": "の"}, {"type": "subtitle", "time": 2196.55, "timestamp": "00:36:36", "text": "G. なぜ私はカウンターストライクを開いたのか？"}, {"type": "subtitle", "time": 2199.349, "timestamp": "00:36:39", "text": "ニックさん、もう演奏をやめてください"}, {"type": "subtitle", "time": 2202.43, "timestamp": "00:36:42", "text": "カウンターストライク？いいえ、いいえ、"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "いいえ。誤って開いてしまいました。申し訳ありません。"}, {"type": "subtitle", "time": 2215.91, "timestamp": "00:36:55", "text": "周りの人に聞こえますか？"}, {"type": "subtitle", "time": 2219.109, "timestamp": "00:36:59", "text": "話せますか？こんにちは。こんにちは。こんにちは。"}]
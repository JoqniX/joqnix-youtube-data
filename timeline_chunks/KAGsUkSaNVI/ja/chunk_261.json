[{"type": "subtitle", "time": 15669.91, "timestamp": "04:21:09", "text": "アメイジング・スパイダーマンに手出しするな。"}, {"type": "subtitle", "time": 15689.11, "timestamp": "04:21:29", "text": "砲塔を何とかしなければならない。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "何てことだ。私は死んだ。私は死んだ。彼らは"}, {"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "集団で襲われた。もうすぐあなたのもの。彼らは私を集団で襲った"}, {"type": "subtitle", "time": 15713.11, "timestamp": "04:21:53", "text": "ヒーローが活躍中。まだ息をしている。まだ"}, {"type": "subtitle", "time": 15714.87, "timestamp": "04:21:54", "text": "ファインティング。"}, {"type": "subtitle", "time": 15718.95, "timestamp": "04:21:58", "text": "雷神を見よ。"}]
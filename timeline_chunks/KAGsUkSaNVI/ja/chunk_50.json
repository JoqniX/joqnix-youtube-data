[{"type": "subtitle", "time": 3000.87, "timestamp": "00:50:00", "text": "叫ばないで。私はしたくない。"}, {"type": "subtitle", "time": 3002.23, "timestamp": "00:50:02", "text": "どこにいるの？あなたは何処に行きましたか？どこ"}, {"type": "subtitle", "time": 3004.23, "timestamp": "00:50:04", "text": "行きましたか？どこ？わかった。私はここにいます。私は"}, {"type": "subtitle", "time": 3006.19, "timestamp": "00:50:06", "text": "ここ。私はここにいます。"}, {"type": "subtitle", "time": 3009.91, "timestamp": "00:50:09", "text": "わかった。必ずフォローしてください。"}, {"type": "subtitle", "time": 3014.03, "timestamp": "00:50:14", "text": "うん。私たちは最善を尽くします。それで、"}, {"type": "subtitle", "time": 3019.589, "timestamp": "00:50:19", "text": "まず、"}, {"type": "subtitle", "time": 3021.75, "timestamp": "00:50:21", "text": "ああ、このゲームはクラッシュしている"}, {"type": "subtitle", "time": 3024.71, "timestamp": "00:50:24", "text": "クレイジーだよ、君。待って、クラッシュしてる。どこ"}, {"type": "subtitle", "time": 3033.069, "timestamp": "00:50:33", "text": "よし、VHSテープを取り出さなきゃ。"}, {"type": "subtitle", "time": 3035.79, "timestamp": "00:50:35", "text": "1つ。その場所を知っていますか？"}, {"type": "subtitle", "time": 3038.39, "timestamp": "00:50:38", "text": "ああ、忘れてた。"}, {"type": "subtitle", "time": 3045.19, "timestamp": "00:50:45", "text": "あなたが表現している様子が大好きです"}, {"type": "subtitle", "time": 3047.03, "timestamp": "00:50:47", "text": "あなた自身。ああ、ジョン、私はあなたを失ってしまった。"}, {"type": "subtitle", "time": 3052.309, "timestamp": "00:50:52", "text": "はい、女性の叫び声が聞こえます。"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "それはいいです。"}, {"type": "subtitle", "time": 3056.71, "timestamp": "00:50:56", "text": "「女の子」って言っちゃダメなの？"}, {"type": "subtitle", "time": 3059.829, "timestamp": "00:50:59", "text": "ただ「女の子」と言うだけではダメです。女性。イエス"}]
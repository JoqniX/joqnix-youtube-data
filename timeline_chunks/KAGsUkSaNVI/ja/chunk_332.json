[{"type": "subtitle", "time": 19920.03, "timestamp": "05:32:00", "text": "日本語。そして"}, {"type": "subtitle", "time": 19922.708, "timestamp": "05:32:02", "text": "5番目は中国語になるだろう、なぜなら私はゆっくりと"}, {"type": "subtitle", "time": 19925.868, "timestamp": "05:32:05", "text": "ゆっくりと学ぶ"}, {"type": "subtitle", "time": 19931.91, "timestamp": "05:32:11", "text": "うん。"}, {"type": "subtitle", "time": 19952.35, "timestamp": "05:32:32", "text": "今日。それを閉じます"}, {"type": "subtitle", "time": 19960.75, "timestamp": "05:32:40", "text": "それで、今日はマーベルのテストをしました"}, {"type": "subtitle", "time": 19964.788, "timestamp": "05:32:44", "text": "反逆者たちは、車を運転するやり方に反抗的だった。"}, {"type": "subtitle", "time": 19970.15, "timestamp": "05:32:50", "text": "良い。私は必要だと感じています"}, {"type": "subtitle", "time": 19972.19, "timestamp": "05:32:52", "text": "[音楽]"}, {"type": "subtitle", "time": 19974.948, "timestamp": "05:32:54", "text": "実際、今月のほぼ終わり頃に。"}, {"type": "subtitle", "time": 19977.03, "timestamp": "05:32:57", "text": "現在、お得な割引キャンペーンを実施中です。"}, {"type": "subtitle", "time": 19978.75, "timestamp": "05:32:58", "text": "私の"}]
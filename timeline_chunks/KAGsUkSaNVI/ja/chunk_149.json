[{"type": "subtitle", "time": 8942.87, "timestamp": "02:29:02", "text": "つまり、これが全てが終わるということだ。オンではない"}, {"type": "subtitle", "time": 8946.15, "timestamp": "02:29:06", "text": "私の時計よ、ダーリン。"}, {"type": "subtitle", "time": 8965.23, "timestamp": "02:29:25", "text": "見た目"}, {"type": "subtitle", "time": 8969.11, "timestamp": "02:29:29", "text": "あなたのように今すぐ撮影したい。"}, {"type": "subtitle", "time": 8971.429, "timestamp": "02:29:31", "text": "任務区域はあなたのものです。それは"}, {"type": "subtitle", "time": 8973.99, "timestamp": "02:29:33", "text": "恥ずかしい。"}, {"type": "subtitle", "time": 8991.27, "timestamp": "02:29:51", "text": "鞭を振るえ。"}, {"type": "subtitle", "time": 8994.87, "timestamp": "02:29:54", "text": "アメイジング・スパイダーマンに手出しするな。"}]
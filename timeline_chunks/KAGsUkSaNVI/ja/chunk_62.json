[{"type": "subtitle", "time": 3726.03, "timestamp": "01:02:06", "text": "まっすぐ"}, {"type": "subtitle", "time": 3728.99, "timestamp": "01:02:08", "text": "真っ直ぐ。右。"}, {"type": "subtitle", "time": 3748.47, "timestamp": "01:02:28", "text": "残念ながら、チームが到着したとき"}, {"type": "subtitle", "time": 3750.51, "timestamp": "01:02:30", "text": "目的地で、彼らは死んだ。"}, {"type": "subtitle", "time": 3753.19, "timestamp": "01:02:33", "text": "遺体は合計9体。九"}, {"type": "subtitle", "time": 3755.03, "timestamp": "01:02:35", "text": "遺体。"}, {"type": "subtitle", "time": 3757.27, "timestamp": "01:02:37", "text": "チームは全てを集めた。ということで、私は"}, {"type": "subtitle", "time": 3761.67, "timestamp": "01:02:41", "text": "歯があって、私はそれが"}, {"type": "subtitle", "time": 3764.15, "timestamp": "01:02:44", "text": "アリか何か。遺体の一部"}, {"type": "subtitle", "time": 3766.15, "timestamp": "01:02:46", "text": "発見された。体のどの部分ですか"}, {"type": "subtitle", "time": 3770.39, "timestamp": "01:02:50", "text": "在庫に入っていますか？確認するだけです。"}, {"type": "subtitle", "time": 3774.47, "timestamp": "01:02:54", "text": "指一本。はい、ジェニファー。"}, {"type": "subtitle", "time": 3779.789, "timestamp": "01:02:59", "text": "ジェニファー・マーレイは歯を失った。ジェニファー"}]
[{"type": "subtitle", "time": 5100.95, "timestamp": "01:25:00", "text": "どこにいるの？そうそう。"}, {"type": "subtitle", "time": 5103.189, "timestamp": "01:25:03", "text": "どこにいるの？"}, {"type": "subtitle", "time": 5105.75, "timestamp": "01:25:05", "text": "待って。あなたの背後に光が見えます。おお、"}, {"type": "subtitle", "time": 5108.39, "timestamp": "01:25:08", "text": "犬はここにいます。犬はここにいます。によって"}, {"type": "subtitle", "time": 5111.03, "timestamp": "01:25:11", "text": "ところで、犬がここにいます。"}, {"type": "subtitle", "time": 5113.91, "timestamp": "01:25:13", "text": "まあ、本当に？うん。遊んでみよう"}, {"type": "subtitle", "time": 5116.27, "timestamp": "01:25:16", "text": "それ。"}, {"type": "subtitle", "time": 5118.59, "timestamp": "01:25:18", "text": "おい、それは違うはずだ"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "に。あなたは何を試しますか？試してみてください"}, {"type": "subtitle", "time": 5125.35, "timestamp": "01:25:25", "text": "じっとして攻撃せよ。ああ、彼はやっていない"}, {"type": "subtitle", "time": 5148.669, "timestamp": "01:25:48", "text": "ああ、神様。なぜ私は殴ろうとしたのか"}]
[{"type": "subtitle", "time": 8892.55, "timestamp": "02:28:12", "text": "爆破しなければならないものがある。"}, {"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "壊れない。サメの物体とは何ですか"}, {"type": "subtitle", "time": 8919.349, "timestamp": "02:28:39", "text": "ハルクみたいなサメみたいなやつ。"}, {"type": "subtitle", "time": 8921.99, "timestamp": "02:28:41", "text": "コヌは私に任務を与え、何も"}, {"type": "subtitle", "time": 8934.79, "timestamp": "02:28:54", "text": "戦いは5分後に始まる。 4 3 2 1。"}, {"type": "subtitle", "time": 8936.23, "timestamp": "02:28:56", "text": "必要なのは、"}, {"type": "subtitle", "time": 8939.429, "timestamp": "02:28:59", "text": "任務地域。わかった。"}]
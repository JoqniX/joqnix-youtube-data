[{"type": "subtitle", "time": 2702.23, "timestamp": "00:45:02", "text": "わかった。そしてインスタグラムもね。待って、"}, {"type": "subtitle", "time": 2705.03, "timestamp": "00:45:05", "text": "ところで、あなたは好きなように言いました"}, {"type": "subtitle", "time": 2706.95, "timestamp": "00:45:06", "text": "それは何と呼ぶのですか？はい。あなたは言ったように"}, {"type": "subtitle", "time": 2708.71, "timestamp": "00:45:08", "text": "スピードランを見ているような"}, {"type": "subtitle", "time": 2712.47, "timestamp": "00:45:12", "text": "これですよね？ええ、うっかりやってしまったんです"}, {"type": "subtitle", "time": 2715.99, "timestamp": "00:45:15", "text": "今日。私は「うーん、このゲームはなんて素晴らしいんだろう」と思った。"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "誰かがそれをスピードダンで走ったらどうなるだろうか。"}, {"type": "subtitle", "time": 2721.589, "timestamp": "00:45:21", "text": "25分間のスピードラン動画を見た。私は"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "半分くらいの時間は"}, {"type": "subtitle", "time": 2728.15, "timestamp": "00:45:28", "text": "口はどのモードでも開いたままだった。私は"}, {"type": "subtitle", "time": 2730.03, "timestamp": "00:45:30", "text": "のように"}, {"type": "subtitle", "time": 2733.67, "timestamp": "00:45:33", "text": "うわー、この人、一体どれだけの速さで走ってるんだ"}, {"type": "subtitle", "time": 2737.27, "timestamp": "00:45:37", "text": "いろいろなものがあって、彼は文字通り歩いている"}, {"type": "subtitle", "time": 2739.99, "timestamp": "00:45:39", "text": "何もないような存在に向かって"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "不安薬を服用して、"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "消える、落ち着く、"}, {"type": "subtitle", "time": 2748.27, "timestamp": "00:45:48", "text": "何か。私は「えっ、それは"}, {"type": "subtitle", "time": 2751.109, "timestamp": "00:45:51", "text": "私たちにできること。私たちは走るのが好きではなかった"}, {"type": "subtitle", "time": 2752.87, "timestamp": "00:45:52", "text": "ある存在から離れたような感じ。私たちは文字通り"}, {"type": "subtitle", "time": 2755.27, "timestamp": "00:45:55", "text": "彼もそちらへ向かって歩いて行った。うん。うん。うん。"}, {"type": "subtitle", "time": 2757.04, "timestamp": "00:45:57", "text": "うん。 二。"}, {"type": "subtitle", "time": 2758.56, "timestamp": "00:45:58", "text": "二。 うん。こんにちは、ヘックス・ジャマ。うん。こんにちは、カイサさん。"}]
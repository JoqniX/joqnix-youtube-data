[{"type": "subtitle", "time": 4081.39, "timestamp": "01:08:01", "text": "推測。"}, {"type": "subtitle", "time": 4083.71, "timestamp": "01:08:03", "text": "いつもそうだった"}, {"type": "subtitle", "time": 4086.63, "timestamp": "01:08:06", "text": "近く？おお、"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "白いドアが開いているのを見つけましたか？"}, {"type": "subtitle", "time": 4092.95, "timestamp": "01:08:12", "text": "白いドア？少し開いたような感じ。"}, {"type": "subtitle", "time": 4096.349, "timestamp": "01:08:16", "text": "はい、私は待っています"}, {"type": "subtitle", "time": 4103.47, "timestamp": "01:08:23", "text": "H 何"}, {"type": "subtitle", "time": 4106.309, "timestamp": "01:08:26", "text": "何が起こったのか？届きましたか？それだけですか？は"}, {"type": "subtitle", "time": 4110.39, "timestamp": "01:08:30", "text": "それだけ？それはより困難になるだろう。わかった。わーい。私"}, {"type": "subtitle", "time": 4123.349, "timestamp": "01:08:43", "text": "ケーブルテレビの作業員はあちらにいます。"}, {"type": "subtitle", "time": 4125.99, "timestamp": "01:08:45", "text": "原始人。ケーブルテレビの修理業者が来た"}, {"type": "subtitle", "time": 4129.03, "timestamp": "01:08:49", "text": "まっすぐ前だ。私たちはこちらへ行きます"}, {"type": "subtitle", "time": 4133.59, "timestamp": "01:08:53", "text": "その遺体へ。私たちは調査結果を発表しました。"}, {"type": "subtitle", "time": 4137.669, "timestamp": "01:08:57", "text": "それで、上の真ん中の男は"}]
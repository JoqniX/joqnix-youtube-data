[{"type": "subtitle", "time": 20100.75, "timestamp": "05:35:00", "text": "オファー。しかし"}, {"type": "subtitle", "time": 20116.628, "timestamp": "05:35:16", "text": "少しでも。ほとんどの場合、私は自分でやります。"}, {"type": "subtitle", "time": 20120.83, "timestamp": "05:35:20", "text": "だから、でも私の場合は、"}, {"type": "subtitle", "time": 20125.27, "timestamp": "05:35:25", "text": "えっと、私は既にもっと高品質なモデルを持っていました"}, {"type": "subtitle", "time": 20128.548, "timestamp": "05:35:28", "text": "準備した。だから、えーと"}, {"type": "subtitle", "time": 20141.91, "timestamp": "05:35:41", "text": "それ。それで、あなたは、ああ、ありがとう。あなたも"}, {"type": "subtitle", "time": 20144.868, "timestamp": "05:35:44", "text": "同じように。あなたの作品がうまくいくことを願っています"}, {"type": "subtitle", "time": 20147.75, "timestamp": "05:35:47", "text": "良い。もっと多くの顧客が見つかることを願っています。希望"}, {"type": "subtitle", "time": 20149.628, "timestamp": "05:35:49", "text": "あなたは自分の"}]
[{"type": "subtitle", "time": 2880.23, "timestamp": "00:48:00", "text": "マウスの感度が高すぎます。"}, {"type": "subtitle", "time": 2883.75, "timestamp": "00:48:03", "text": "ここで懐中電灯は手に入りますか？ああ、君"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "あなたの体力を見守ることができます。私は"}, {"type": "subtitle", "time": 2892.19, "timestamp": "00:48:12", "text": "懐中電灯"}, {"type": "subtitle", "time": 2896.95, "timestamp": "00:48:16", "text": "時計も同様にできる。わかった。私 私 私"}, {"type": "subtitle", "time": 2898.71, "timestamp": "00:48:18", "text": "フィギュアの描き方がまだよくわからない"}, {"type": "subtitle", "time": 2901.27, "timestamp": "00:48:21", "text": "誰も"}, {"type": "subtitle", "time": 2902.95, "timestamp": "00:48:22", "text": "この写真を検出することができました"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "攻撃的な危険性を証言しているが"}, {"type": "subtitle", "time": 2923.43, "timestamp": "00:48:43", "text": "また、騒音にも怯え、直接"}, {"type": "subtitle", "time": 2926.71, "timestamp": "00:48:46", "text": "直接的なアイコンに怯えている。いいえ、しかし"}, {"type": "subtitle", "time": 2929.51, "timestamp": "00:48:49", "text": "それを見ると、殺される。"}, {"type": "subtitle", "time": 2931.67, "timestamp": "00:48:51", "text": "だから、それを直接見るときは"}, {"type": "subtitle", "time": 2934.549, "timestamp": "00:48:54", "text": "賢く、走れる時もある"}, {"type": "subtitle", "time": 2936.95, "timestamp": "00:48:56", "text": "それではあまり役に立たない。私たちには"}, {"type": "subtitle", "time": 2939.91, "timestamp": "00:48:59", "text": "じっとしているのが好き？つまり、私たちは"}]
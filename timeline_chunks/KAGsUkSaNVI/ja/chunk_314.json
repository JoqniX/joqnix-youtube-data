[{"type": "subtitle", "time": 18841.91, "timestamp": "05:14:01", "text": "行かないで。"}, {"type": "subtitle", "time": 18844.31, "timestamp": "05:14:04", "text": "私は宇宙で家族を見つけた、"}, {"type": "subtitle", "time": 18845.83, "timestamp": "05:14:05", "text": "彼らを守るためなら何でもする"}, {"type": "subtitle", "time": 18848.07, "timestamp": "05:14:08", "text": "安全。"}, {"type": "subtitle", "time": 18850.47, "timestamp": "05:14:10", "text": "君にはたった一つの仕事がある。できるだけ多く"}, {"type": "subtitle", "time": 18876.55, "timestamp": "05:14:36", "text": "何てことだ。拳を突き合わせる。いいえ。何らかの"}, {"type": "subtitle", "time": 18897.15, "timestamp": "05:14:57", "text": "右？ああ、それは私の"}]
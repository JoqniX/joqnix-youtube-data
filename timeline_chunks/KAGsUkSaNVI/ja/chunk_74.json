[{"type": "subtitle", "time": 4447.43, "timestamp": "01:14:07", "text": "ああ、なんてことだ、私は今まで"}, {"type": "subtitle", "time": 4450.87, "timestamp": "01:14:10", "text": "自分がこんなに勇敢だなんて、想像もしていなかった。"}, {"type": "subtitle", "time": 4454.709, "timestamp": "01:14:14", "text": "見てください、Jさん。はい。言ってるでしょ、"}, {"type": "subtitle", "time": 4457.91, "timestamp": "01:14:17", "text": "君は勇敢な男の子だね。ええ、"}, {"type": "subtitle", "time": 4463.83, "timestamp": "01:14:23", "text": "私はあなたと一緒です。はい、時刻は5時35分です。"}, {"type": "subtitle", "time": 4466.709, "timestamp": "01:14:26", "text": "暗号か何かだと思う。 0535。"}, {"type": "subtitle", "time": 4469.75, "timestamp": "01:14:29", "text": "待って、それどこで見つけたの？"}, {"type": "subtitle", "time": 4471.59, "timestamp": "01:14:31", "text": "ああ、まさにドアのすぐそばにいます。その"}, {"type": "subtitle", "time": 4473.79, "timestamp": "01:14:33", "text": "私が死んだ場所。そこで私は"}, {"type": "subtitle", "time": 4477.669, "timestamp": "01:14:37", "text": "午前。どうせもうすぐ死んでしまうと思う。"}, {"type": "subtitle", "time": 4479.75, "timestamp": "01:14:39", "text": "私は文字通りドアのすぐそばにいます。ジャック1世"}, {"type": "subtitle", "time": 4485.03, "timestamp": "01:14:45", "text": "あなたがここで待っていたのを知っていた。ああ、わかった。"}, {"type": "subtitle", "time": 4488.63, "timestamp": "01:14:48", "text": "ケーブルテレビの修理業者がどこにいるか知ってる？"}, {"type": "subtitle", "time": 4493.43, "timestamp": "01:14:53", "text": "考えが変わった？えっと、私は"}, {"type": "subtitle", "time": 4495.51, "timestamp": "01:14:55", "text": "VHS。"}, {"type": "subtitle", "time": 4498.709, "timestamp": "01:14:58", "text": "あ、待って。あなたなの？いいえ、それはあなたです。私"}]
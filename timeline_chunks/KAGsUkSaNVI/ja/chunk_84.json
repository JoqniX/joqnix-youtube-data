[{"type": "subtitle", "time": 5042.31, "timestamp": "01:24:02", "text": "その場所だと思います。"}, {"type": "subtitle", "time": 5044.39, "timestamp": "01:24:04", "text": "これは何ですか？メモがあります。の1つ"}, {"type": "subtitle", "time": 5046.07, "timestamp": "01:24:06", "text": "花瓶には何かが入っている。彼らはとても"}, {"type": "subtitle", "time": 5049.59, "timestamp": "01:24:09", "text": "手で壊すのは難しい。わかった。"}, {"type": "subtitle", "time": 5051.99, "timestamp": "01:24:11", "text": "ああ、私たちは廃棄物の中にいるのでしょうか"}, {"type": "subtitle", "time": 5054.95, "timestamp": "01:24:14", "text": "部屋？"}, {"type": "subtitle", "time": 5057.189, "timestamp": "01:24:17", "text": "犬に追いかけ回されて"}, {"type": "subtitle", "time": 5059.75, "timestamp": "01:24:19", "text": "方法。"}, {"type": "subtitle", "time": 5062.709, "timestamp": "01:24:22", "text": "ああ、"}, {"type": "subtitle", "time": 5065.11, "timestamp": "01:24:25", "text": "あなたも持っていますか"}, {"type": "subtitle", "time": 5067.189, "timestamp": "01:24:27", "text": "えっと、赤い鍵を持っています。私は赤を手に入れました"}, {"type": "subtitle", "time": 5073.83, "timestamp": "01:24:33", "text": "赤い鍵は手に入れましたか？どの鍵ですか？"}, {"type": "subtitle", "time": 5076.55, "timestamp": "01:24:36", "text": "赤い鍵。"}, {"type": "subtitle", "time": 5078.31, "timestamp": "01:24:38", "text": "さあ行こう。"}, {"type": "subtitle", "time": 5080.79, "timestamp": "01:24:40", "text": "赤い鍵は手に入れたかい、シャーク？どこ"}, {"type": "subtitle", "time": 5084.79, "timestamp": "01:24:44", "text": "赤い鍵？鍵を手に入れた。ああ、私は"}, {"type": "subtitle", "time": 5086.709, "timestamp": "01:24:46", "text": "鼻。"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "鼻ができた。ニース。よし、行こう。手に入れた"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "鼻。"}, {"type": "subtitle", "time": 5094.229, "timestamp": "01:24:54", "text": "いいえ。"}, {"type": "subtitle", "time": 5097.189, "timestamp": "01:24:57", "text": "なんてことだ、ジャック。滞在する。"}]
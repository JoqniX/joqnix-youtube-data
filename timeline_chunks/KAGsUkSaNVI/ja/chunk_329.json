[{"type": "subtitle", "time": 19742.19, "timestamp": "05:29:02", "text": "あなたが尋ねている理由は"}, {"type": "subtitle", "time": 19744.19, "timestamp": "05:29:04", "text": "その時"}, {"type": "subtitle", "time": 19746.39, "timestamp": "05:29:06", "text": "いいえ、心配しないで、心配しないで、私は"}, {"type": "subtitle", "time": 19748.23, "timestamp": "05:29:08", "text": "複数のプラットフォームでストリーミング配信しない"}, {"type": "subtitle", "time": 19751.628, "timestamp": "05:29:11", "text": "心配する、えっと、待って待って待って待って、私は"}, {"type": "subtitle", "time": 19755.788, "timestamp": "05:29:15", "text": "ああ、これはちゃんと見ないと"}, {"type": "subtitle", "time": 19765.59, "timestamp": "05:29:25", "text": "ラグい待って待って待って待って待って待って、"}, {"type": "subtitle", "time": 19766.92, "timestamp": "05:29:26", "text": "待って、 待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 19774.15, "timestamp": "05:29:34", "text": "待って。いいえ、実は私はあなたを助けたいのです"}, {"type": "subtitle", "time": 19775.04, "timestamp": "05:29:35", "text": "あなたの"}, {"type": "subtitle", "time": 19776.99, "timestamp": "05:29:36", "text": "[音楽]"}, {"type": "subtitle", "time": 19779.948, "timestamp": "05:29:39", "text": "もの。私は"}, {"type": "subtitle", "time": 19782.948, "timestamp": "05:29:42", "text": "リスニング。えっと、ちょっと待ってください。えっと、どこが"}, {"type": "subtitle", "time": 19786.23, "timestamp": "05:29:46", "text": "翻訳者？大丈夫です。おお、"}, {"type": "subtitle", "time": 19790.548, "timestamp": "05:29:50", "text": "待って、待って、待って。クロサー。えっと、"}, {"type": "subtitle", "time": 19795.628, "timestamp": "05:29:55", "text": "ああ、心配しないで。えっと、私は"}, {"type": "subtitle", "time": 19799.3, "timestamp": "05:29:59", "text": "えーと話すのではなく"}]
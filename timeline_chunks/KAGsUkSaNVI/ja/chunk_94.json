[{"type": "subtitle", "time": 5645.11, "timestamp": "01:34:05", "text": "オレンジ。右。何てことだ。 3つ目は"}, {"type": "subtitle", "time": 5648.31, "timestamp": "01:34:08", "text": "外へ、ですよね？それは除外だ。では"}, {"type": "subtitle", "time": 5650.95, "timestamp": "01:34:10", "text": "今？ 2つ目。電源は入っていますか？"}, {"type": "subtitle", "time": 5661.11, "timestamp": "01:34:21", "text": "私はそれを理解しました。だろう。私は"}, {"type": "subtitle", "time": 5663.11, "timestamp": "01:34:23", "text": "スピード1。ああ、3つ目が始まった。三番目"}, {"type": "subtitle", "time": 5671.11, "timestamp": "01:34:31", "text": "ああ、そこにいたんですね。警官さん。"}, {"type": "subtitle", "time": 5678.47, "timestamp": "01:34:38", "text": "わかった。今はどうでしょうか？えーと、"}, {"type": "subtitle", "time": 5682.149, "timestamp": "01:34:42", "text": "３番がオンです。 2位はまだ確定していない。"}, {"type": "subtitle", "time": 5687.189, "timestamp": "01:34:47", "text": "2位はまだ確定していない。はい。 １、２。"}, {"type": "subtitle", "time": 5690.31, "timestamp": "01:34:50", "text": "待って、これが転換期を迎えているかどうか教えて。は"}, {"type": "subtitle", "time": 5692.229, "timestamp": "01:34:52", "text": "あれは最初のものだったの？ 1つなくなった。"}, {"type": "subtitle", "time": 5695.03, "timestamp": "01:34:55", "text": "1つなくなった。 1つなくなった。わかった。わかった。"}, {"type": "subtitle", "time": 5697.43, "timestamp": "01:34:57", "text": "1と3。真ん中のもの。右。手に入れた"}]
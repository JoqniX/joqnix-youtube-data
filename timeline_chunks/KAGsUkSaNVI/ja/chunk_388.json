[{"type": "subtitle", "time": 23292.67, "timestamp": "06:28:12", "text": "なぜ"}, {"type": "subtitle", "time": 23296.19, "timestamp": "06:28:16", "text": "子供？子供"}, {"type": "subtitle", "time": 23310.948, "timestamp": "06:28:30", "text": "こんにちは。どういう意味ですか？ああ、それは"}, {"type": "subtitle", "time": 23315.43, "timestamp": "06:28:35", "text": "ちびキャラモデル。ちびキャラモデル。"}, {"type": "subtitle", "time": 23317.67, "timestamp": "06:28:37", "text": "ドクター、私と一緒にいて、治療を続けてください。"}, {"type": "subtitle", "time": 23338.31, "timestamp": "06:28:58", "text": "救援物資が配達されています。スポンサー提供"}]
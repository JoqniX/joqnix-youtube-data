[{"type": "subtitle", "time": 21607.91, "timestamp": "06:00:07", "text": "アップグレードします。くそ、兄弟。"}, {"type": "subtitle", "time": 21610.19, "timestamp": "06:00:10", "text": "よし、超すごい"}, {"type": "subtitle", "time": 21623.39, "timestamp": "06:00:23", "text": "自分。そうするべきです。"}, {"type": "subtitle", "time": 21654.67, "timestamp": "06:00:54", "text": "兄弟。彼はワンタップした"}, {"type": "subtitle", "time": 21659.39, "timestamp": "06:00:59", "text": "自分。待って、それは難しすぎる。よし、全力でやろう"}]
[{"type": "subtitle", "time": 8283.83, "timestamp": "02:18:03", "text": "注意喚起。戻ってきてくれよ、みんな。"}, {"type": "subtitle", "time": 8286.87, "timestamp": "02:18:06", "text": "ダブルKO。"}, {"type": "subtitle", "time": 8292.389, "timestamp": "02:18:12", "text": "これで３つ目だ。私は切り裂くことができる。私は決して外さない。"}, {"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "おお。 4連勝。通常は"}, {"type": "subtitle", "time": 8297.589, "timestamp": "02:18:17", "text": "標的を導く。この矢では無理だ。"}, {"type": "subtitle", "time": 8300.79, "timestamp": "02:18:20", "text": "それは素晴らしいですね。ニース。 6連勝。方法"}, {"type": "subtitle", "time": 8304.629, "timestamp": "02:18:24", "text": "持ち帰り。信じられない。"}, {"type": "subtitle", "time": 8305.629, "timestamp": "02:18:25", "text": "私は手に入れた"}]
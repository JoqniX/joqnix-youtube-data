[{"type": "subtitle", "time": 22883.91, "timestamp": "06:21:23", "text": "シールドを構えて突撃する。"}, {"type": "subtitle", "time": 22886.15, "timestamp": "06:21:26", "text": "何てことだ。後ろから。もちろん。から"}, {"type": "subtitle", "time": 22888.67, "timestamp": "06:21:28", "text": "あなたの後ろに。"}, {"type": "subtitle", "time": 22891.67, "timestamp": "06:21:31", "text": "あなたナンド"}, {"type": "subtitle", "time": 22893.47, "timestamp": "06:21:33", "text": "一息ついた。それ"}, {"type": "subtitle", "time": 22910.39, "timestamp": "06:21:50", "text": "充電中"}]
[{"type": "subtitle", "time": 4323.35, "timestamp": "01:12:03", "text": "[音楽]"}, {"type": "subtitle", "time": 4326.47, "timestamp": "01:12:06", "text": "そうそう。わかった。それで、私たちはここに来たんです。さあ"}, {"type": "subtitle", "time": 4335.35, "timestamp": "01:12:15", "text": "私は犬が好きですが、"}, {"type": "subtitle", "time": 4337.75, "timestamp": "01:12:17", "text": "警告か叫び声か何か。そうです"}, {"type": "subtitle", "time": 4340.51, "timestamp": "01:12:20", "text": "何もない。彼はただ"}, {"type": "subtitle", "time": 4344.87, "timestamp": "01:12:24", "text": "うん。この方向で進めば良いと思う。"}, {"type": "subtitle", "time": 4348.149, "timestamp": "01:12:28", "text": "ああ、ケーブルテレビの修理業者さんね。ケーブルテレビの修理業者。"}, {"type": "subtitle", "time": 4352.87, "timestamp": "01:12:32", "text": "走る。ああ。何てことだ。ああ、逃げなきゃ。"}, {"type": "subtitle", "time": 4356.55, "timestamp": "01:12:36", "text": "はい。ああ、なんてこった。つまり、あなたはそうしない"}, {"type": "subtitle", "time": 4358.79, "timestamp": "01:12:38", "text": "走らなければならない。あなたはまだじっとしていても、"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "あまりにも。ああ、それもいいですね。いや、いや、いや、"}, {"type": "subtitle", "time": 4364.55, "timestamp": "01:12:44", "text": "いいえ。それは人を殺す。それは人を殺す。それは殺す"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "実は。"}, {"type": "subtitle", "time": 4368.07, "timestamp": "01:12:48", "text": "あなたは死にかけているのですか？"}, {"type": "subtitle", "time": 4374.31, "timestamp": "01:12:54", "text": "わかった。わかった。在庫。在庫。"}, {"type": "subtitle", "time": 4379.99, "timestamp": "01:12:59", "text": "在庫。アーモンドウォーター。ああ、あなたは亡くなったのですね。私"}]
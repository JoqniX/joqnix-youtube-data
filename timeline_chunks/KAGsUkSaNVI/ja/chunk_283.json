[{"type": "subtitle", "time": 16991.35, "timestamp": "04:43:11", "text": "こんにちは。そして、私たちは日本語を勉強します。こんにちは。"}, {"type": "subtitle", "time": 16994.19, "timestamp": "04:43:14", "text": "最後の配信、えっと、最後の"}, {"type": "subtitle", "time": 16997.83, "timestamp": "04:43:17", "text": "えっと、私たちはDualingoシリーズをやっていたのですが、"}, {"type": "subtitle", "time": 17001.19, "timestamp": "04:43:21", "text": "右？そして私たちはユニット3セクションに到達しました"}, {"type": "subtitle", "time": 17008.788, "timestamp": "04:43:28", "text": "こんにちは、配信へようこ​​そ。いらっしゃいませ、"}, {"type": "subtitle", "time": 17012.948, "timestamp": "04:43:32", "text": "ロミオゲームへようこそ。いらっしゃいませ。希望"}, {"type": "subtitle", "time": 17015.43, "timestamp": "04:43:35", "text": "あなたはよくやっています。私はただ"}, {"type": "subtitle", "time": 17018.67, "timestamp": "04:43:38", "text": "今日は日本語を話しているので、気にしないでください"}, {"type": "subtitle", "time": 17022.47, "timestamp": "04:43:42", "text": "自分。ようこそ、ようこそ。わたしもあなたが恋しい。希望"}, {"type": "subtitle", "time": 17024.67, "timestamp": "04:43:44", "text": "あなたがしてきたことは"}]
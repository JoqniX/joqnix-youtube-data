[{"type": "subtitle", "time": 13506.59, "timestamp": "03:45:06", "text": "ステップ"}, {"type": "subtitle", "time": 13520.469, "timestamp": "03:45:20", "text": "これは長くなりそうだ。月があなたを悩ませる。"}, {"type": "subtitle", "time": 13523.51, "timestamp": "03:45:23", "text": "月明かりが嫌いなんです。私は光です"}, {"type": "subtitle", "time": 13527.349, "timestamp": "03:45:27", "text": "暗闇。月があなたを悩ませる。"}, {"type": "subtitle", "time": 13529.67, "timestamp": "03:45:29", "text": "ダブルキル。私の光はできない。あなたは"}, {"type": "subtitle", "time": 13531.11, "timestamp": "03:45:31", "text": "我々は、"}, {"type": "subtitle", "time": 13534.07, "timestamp": "03:45:34", "text": "勝者。"}, {"type": "subtitle", "time": 13536.389, "timestamp": "03:45:36", "text": "ああ。"}, {"type": "subtitle", "time": 13545.269, "timestamp": "03:45:45", "text": "私はひどく下手なプレーをしていた。"}, {"type": "subtitle", "time": 13554.55, "timestamp": "03:45:54", "text": "3つ目はどうでしょうか？第三の選択肢はないのか？"}, {"type": "subtitle", "time": 13556.72, "timestamp": "03:45:56", "text": "ファイトの"}]
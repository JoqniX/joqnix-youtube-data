[{"type": "subtitle", "time": 3844.19, "timestamp": "01:04:04", "text": "手に入れた"}, {"type": "subtitle", "time": 3848.309, "timestamp": "01:04:08", "text": "それ。それからネイサンとエレン。よし、行こう。"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "あなたは上手い。プレイするのが好きなとき"}, {"type": "subtitle", "time": 3852.23, "timestamp": "01:04:12", "text": "他の20人くらいと一緒に参加した。あなた"}, {"type": "subtitle", "time": 3854.309, "timestamp": "01:04:14", "text": "ジェフ、覚えてるかい？"}, {"type": "subtitle", "time": 3855.63, "timestamp": "01:04:15", "text": "おお、"}, {"type": "subtitle", "time": 3859.029, "timestamp": "01:04:19", "text": "うん。覚えてる？"}, {"type": "subtitle", "time": 3861.91, "timestamp": "01:04:21", "text": "究極のマルチプレイヤー体験をここに。待って、"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "不安薬、気味の悪い男"}, {"type": "subtitle", "time": 3877.99, "timestamp": "01:04:37", "text": "まるで実際にそこにいるかのようだ。ああ、彼はもう終わった"}, {"type": "subtitle", "time": 3881.029, "timestamp": "01:04:41", "text": "そこには。えっと、覚えていますか？はい、"}, {"type": "subtitle", "time": 3881.87, "timestamp": "01:04:41", "text": "行く"}, {"type": "subtitle", "time": 3884.63, "timestamp": "01:04:44", "text": "遺体のあるドアへ直行。"}, {"type": "subtitle", "time": 3891.51, "timestamp": "01:04:51", "text": "遺体は一体どこにあったんだっけ？それは"}, {"type": "subtitle", "time": 3894.71, "timestamp": "01:04:54", "text": "ストレートとかそういう感じ。はい、私は"}, {"type": "subtitle", "time": 3897.109, "timestamp": "01:04:57", "text": "保持。ちょっと待ってください。行かないで"}]
[{"type": "subtitle", "time": 14223.99, "timestamp": "03:57:03", "text": "ファイターフィストはパンチを繰り出す準備ができている。あなたは"}, {"type": "subtitle", "time": 14234.15, "timestamp": "03:57:14", "text": "ここをチェックしてみて。"}, {"type": "subtitle", "time": 14237.349, "timestamp": "03:57:17", "text": "気をつけて。彼らはこちらに向かっている。"}, {"type": "subtitle", "time": 14245.99, "timestamp": "03:57:25", "text": "グラウンド・アンド・パウンド。まさに求めていたものだ。"}, {"type": "subtitle", "time": 14249.189, "timestamp": "03:57:29", "text": "ただ光を受け入れなさい。"}, {"type": "subtitle", "time": 14270.55, "timestamp": "03:57:50", "text": "ああ。"}, {"type": "subtitle", "time": 14274.15, "timestamp": "03:57:54", "text": "力を手に入れるのは私のことだ。"}, {"type": "subtitle", "time": 14276.469, "timestamp": "03:57:56", "text": "何てことだ。どうやってあれを掴んだんだろう？の"}]
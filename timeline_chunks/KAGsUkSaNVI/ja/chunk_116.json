[{"type": "subtitle", "time": 6961.75, "timestamp": "01:56:01", "text": "お金がないので支払っていません。私"}, {"type": "subtitle", "time": 6963.51, "timestamp": "01:56:03", "text": "給料が支払われていない。何もない"}, {"type": "subtitle", "time": 6966.91, "timestamp": "01:56:06", "text": "私にとっての仕事です。私は文字通りここにいます"}, {"type": "subtitle", "time": 6970.07, "timestamp": "01:56:10", "text": "失業中、無一文、独身、"}, {"type": "subtitle", "time": 6976.95, "timestamp": "01:56:16", "text": "の。セックスガールや処女喪失パートのように"}, {"type": "subtitle", "time": 6978.79, "timestamp": "01:56:18", "text": "だって、私はそんなこと気にしないから。でも、そうですね、"}, {"type": "subtitle", "time": 6980.55, "timestamp": "01:56:20", "text": "まずは自分の夢に集中する必要がある。それで"}, {"type": "subtitle", "time": 6996.629, "timestamp": "01:56:36", "text": "[音楽]"}, {"type": "subtitle", "time": 6999.189, "timestamp": "01:56:39", "text": "食事休憩。ちなみに、食事については"}, {"type": "subtitle", "time": 7001.83, "timestamp": "01:56:41", "text": "壊すと、物事を変えることはできません"}, {"type": "subtitle", "time": 7004.95, "timestamp": "01:56:44", "text": "道。わかった。食事休憩のために、"}, {"type": "subtitle", "time": 7006.109, "timestamp": "01:56:46", "text": "右？"}, {"type": "subtitle", "time": 7008.83, "timestamp": "01:56:48", "text": "えっと、それは"}, {"type": "subtitle", "time": 7011.95, "timestamp": "01:56:51", "text": "タイミング。現在のシステム時刻。"}, {"type": "subtitle", "time": 7016.109, "timestamp": "01:56:56", "text": "わかった。正午、12時から2時まで"}, {"type": "subtitle", "time": 7019.109, "timestamp": "01:56:59", "text": "午後いいえ、12時から3時までは"}]
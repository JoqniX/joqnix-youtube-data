[{"type": "subtitle", "time": 13444.95, "timestamp": "03:44:04", "text": "アアモトの目を通して。 Cキーが押せません"}, {"type": "subtitle", "time": 13461.11, "timestamp": "03:44:21", "text": "ここで成し遂げたことを誇りに思ってください。私に"}, {"type": "subtitle", "time": 13464.229, "timestamp": "03:44:24", "text": "もう少し時間が必要です。半分以上召喚した"}, {"type": "subtitle", "time": 13466.15, "timestamp": "03:44:26", "text": "宣教区域の。続けて。いいえ"}, {"type": "subtitle", "time": 13469.59, "timestamp": "03:44:29", "text": "心配事。私が君の味方だ。この魔法"}, {"type": "subtitle", "time": 13480.15, "timestamp": "03:44:40", "text": "裁判官、陪審員、死刑執行人。"}, {"type": "subtitle", "time": 13482.63, "timestamp": "03:44:42", "text": "覚悟しておいてください。どうやって"}]
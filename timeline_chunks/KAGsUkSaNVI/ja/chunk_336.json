[{"type": "subtitle", "time": 20162.86, "timestamp": "05:36:02", "text": "うん。良い"}, {"type": "subtitle", "time": 20164.99, "timestamp": "05:36:04", "text": "[音楽]"}, {"type": "subtitle", "time": 20178.11, "timestamp": "05:36:18", "text": "わかった。"}, {"type": "subtitle", "time": 20182.548, "timestamp": "05:36:22", "text": "えっと、もう夕方ですよね？私は持っている"}, {"type": "subtitle", "time": 20185.75, "timestamp": "05:36:25", "text": "地獄のダイバーたちのためのスペースを作るため。私は持っていません"}, {"type": "subtitle", "time": 20187.99, "timestamp": "05:36:27", "text": "地獄のダイバーのためのスペース 私はしなければならない"}, {"type": "subtitle", "time": 20190.548, "timestamp": "05:36:30", "text": "ダウンロード。コラボデーが翌日に控えている"}, {"type": "subtitle", "time": 20194.708, "timestamp": "05:36:34", "text": "明日。そして私は自分が何をしているのか分からない"}, {"type": "subtitle", "time": 20198.39, "timestamp": "05:36:38", "text": "これからどうするか分からない。スペース不足"}, {"type": "subtitle", "time": 20205.23, "timestamp": "05:36:45", "text": "25"}, {"type": "subtitle", "time": 20214.23, "timestamp": "05:36:54", "text": "アンインストールしますか？どのゲームをアンインストールすればいいですか？"}, {"type": "subtitle", "time": 20216.63, "timestamp": "05:36:56", "text": "私はヴァレラントを手に入れました。できました"}, {"type": "subtitle", "time": 20219.548, "timestamp": "05:36:59", "text": "[音楽]"}]
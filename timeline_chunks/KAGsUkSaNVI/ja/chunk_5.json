[{"type": "subtitle", "time": 302.15, "timestamp": "00:05:02", "text": "皆さん、ありがとう"}, {"type": "subtitle", "time": 305.59, "timestamp": "00:05:05", "text": "会員になる人は、"}, {"type": "subtitle", "time": 307.99, "timestamp": "00:05:07", "text": "キャスタル星座のために、本当にありがとう"}, {"type": "subtitle", "time": 309.629, "timestamp": "00:05:09", "text": "たくさん"}, {"type": "subtitle", "time": 311.95, "timestamp": "00:05:11", "text": "それと"}, {"type": "subtitle", "time": 314.07, "timestamp": "00:05:14", "text": "ご覧のとおり、"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "タイマーを増やしました。今は700時間です。"}, {"type": "subtitle", "time": 319.83, "timestamp": "00:05:19", "text": "それは"}, {"type": "subtitle", "time": 322.469, "timestamp": "00:05:22", "text": "ええと、それは文字通り、ええと、"}, {"type": "subtitle", "time": 323.71, "timestamp": "00:05:23", "text": "月"}, {"type": "subtitle", "time": 326.43, "timestamp": "00:05:26", "text": "全体"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "今月は、また別のセットになります"}, {"type": "subtitle", "time": 334.31, "timestamp": "00:05:34", "text": "えっと、今だと思いますよね"}, {"type": "subtitle", "time": 336.749, "timestamp": "00:05:36", "text": "今は51歳ですが、"}, {"type": "subtitle", "time": 338.01, "timestamp": "00:05:38", "text": "のように"}, {"type": "subtitle", "time": 339.95, "timestamp": "00:05:39", "text": "[音楽]"}, {"type": "subtitle", "time": 342.51, "timestamp": "00:05:42", "text": "えっと。"}, {"type": "subtitle", "time": 350.749, "timestamp": "00:05:50", "text": "5 6 7 8"}, {"type": "subtitle", "time": 354.67, "timestamp": "00:05:54", "text": "81 81 おそらく 80 または"}, {"type": "subtitle", "time": 359.11, "timestamp": "00:05:59", "text": "81 おそらく 80 80 の終わりに"}]
[{"type": "subtitle", "time": 3364.39, "timestamp": "00:56:04", "text": "方法。わかった。私たちはボーの家を見つけた。"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "うん。ニース。さあ行こう。アーモンドがあります"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "鳴って、それから鳴らない。"}, {"type": "subtitle", "time": 3374.069, "timestamp": "00:56:14", "text": "だから誰が誰なのかを突き止める必要があるし"}, {"type": "subtitle", "time": 3377.03, "timestamp": "00:56:17", "text": "誰ですか。それは行方不明の人々について"}, {"type": "subtitle", "time": 3379.67, "timestamp": "00:56:19", "text": "それらはこの場所で発見され、積み上げられていた。"}, {"type": "subtitle", "time": 3382.829, "timestamp": "00:56:22", "text": "発見された遺体の中には"}, {"type": "subtitle", "time": 3386.309, "timestamp": "00:56:26", "text": "いくつかの異常がありますが、Vについてはさらに"}, {"type": "subtitle", "time": 3388.63, "timestamp": "00:56:28", "text": "情報。 VHSテープが必要です"}, {"type": "subtitle", "time": 3391.75, "timestamp": "00:56:31", "text": "方法。わかった。血痕に注意してください。"}, {"type": "subtitle", "time": 3396.15, "timestamp": "00:56:36", "text": "コードを実行する必要があると書いてあります。それで"}, {"type": "subtitle", "time": 3397.71, "timestamp": "00:56:37", "text": "何"}, {"type": "subtitle", "time": 3401.349, "timestamp": "00:56:41", "text": "フリック？何？何だって？何かが"}, {"type": "subtitle", "time": 3404.549, "timestamp": "00:56:44", "text": "壁から切り離す。ジョー、"}, {"type": "subtitle", "time": 3406.549, "timestamp": "00:56:46", "text": "シャドウだと思ったけど違った"}, {"type": "subtitle", "time": 3409.109, "timestamp": "00:56:49", "text": "影。一体何なんだ？ああ、犬"}, {"type": "subtitle", "time": 3411.829, "timestamp": "00:56:51", "text": "もう少ししたら来ます。"}, {"type": "subtitle", "time": 3413.67, "timestamp": "00:56:53", "text": "クラブを見てください。彼らは、あなたが"}, {"type": "subtitle", "time": 3415.67, "timestamp": "00:56:55", "text": "行けるかもしれない。注意してください"}, {"type": "subtitle", "time": 3418.43, "timestamp": "00:56:58", "text": "血。"}]
[{"type": "subtitle", "time": 18301.628, "timestamp": "05:05:01", "text": "えっと、"}, {"type": "subtitle", "time": 18304.59, "timestamp": "05:05:04", "text": "待って。正しいとはどういう意味ですか"}, {"type": "subtitle", "time": 18307.628, "timestamp": "05:05:07", "text": "日本語？正しい。"}, {"type": "subtitle", "time": 18315.19, "timestamp": "05:05:15", "text": "正しい。正解だった。どうやって"}, {"type": "subtitle", "time": 18317.23, "timestamp": "05:05:17", "text": "だった"}, {"type": "subtitle", "time": 18325.948, "timestamp": "05:05:25", "text": "えっと、それは私の"}, {"type": "subtitle", "time": 18328.19, "timestamp": "05:05:28", "text": "損失。私"}, {"type": "subtitle", "time": 18330.99, "timestamp": "05:05:30", "text": "勝利した。"}, {"type": "subtitle", "time": 18334.43, "timestamp": "05:05:34", "text": "はぁ？ああ、8だ。おお。"}, {"type": "subtitle", "time": 18341.15, "timestamp": "05:05:41", "text": "ニース。えっと、最後"}, {"type": "subtitle", "time": 18353.32, "timestamp": "05:05:53", "text": "えっと、また明日。"}, {"type": "subtitle", "time": 18355.15, "timestamp": "05:05:55", "text": "[音楽]"}]
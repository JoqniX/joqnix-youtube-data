[{"type": "subtitle", "time": 7441.27, "timestamp": "02:04:01", "text": "モデレーターの指示。では、"}, {"type": "subtitle", "time": 7448.91, "timestamp": "02:04:08", "text": "ここでは、YouTube や Twitch など"}, {"type": "subtitle", "time": 7451.91, "timestamp": "02:04:11", "text": "どこでも。どうやってこれを作ったんだっけ？は"}, {"type": "subtitle", "time": 7453.149, "timestamp": "02:04:13", "text": "それは"}, {"type": "subtitle", "time": 7455.669, "timestamp": "02:04:15", "text": "プラットフォーム？両方のプラットフォームに対応しています。わかった。"}, {"type": "subtitle", "time": 7458.239, "timestamp": "02:04:18", "text": "わかった。 この男をこっちに置こう"}, {"type": "subtitle", "time": 7494.47, "timestamp": "02:04:54", "text": "後でゲームに切り替えます。与える"}, {"type": "subtitle", "time": 7496.229, "timestamp": "02:04:56", "text": "ちょっと待ってください。少し時間をください。私にさせて"}, {"type": "subtitle", "time": 7499.83, "timestamp": "02:04:59", "text": "料理する。私は料理人です。ティムです。ティムではない"}]
[{"type": "subtitle", "time": 14042.309, "timestamp": "03:54:02", "text": "複数の現実。かっこいいでしょ？私は"}, {"type": "subtitle", "time": 14044.269, "timestamp": "03:54:04", "text": "スパイダーマンと"}, {"type": "subtitle", "time": 14047.79, "timestamp": "03:54:07", "text": "見る。ただ遊びたいだけ"}, {"type": "subtitle", "time": 14049.71, "timestamp": "03:54:09", "text": "それと"}, {"type": "subtitle", "time": 14069.75, "timestamp": "03:54:29", "text": "誰かがドゥームを止めなければならない。つまり、"}, {"type": "subtitle", "time": 14073.11, "timestamp": "03:54:33", "text": "破滅。 2人だけであることを願います。"}, {"type": "subtitle", "time": 14075.189, "timestamp": "03:54:35", "text": "30秒後に来るよ。滞在する"}, {"type": "subtitle", "time": 14081.99, "timestamp": "03:54:41", "text": "ああ、やあ、スパイダーマン。聞いたところによると"}, {"type": "subtitle", "time": 14085.03, "timestamp": "03:54:45", "text": "TRDの支援"}, {"type": "subtitle", "time": 14088.07, "timestamp": "03:54:48", "text": "少しは、かな。できない、しない"}, {"type": "subtitle", "time": 14090.309, "timestamp": "03:54:50", "text": "やり方を知っている"}, {"type": "subtitle", "time": 14093.51, "timestamp": "03:54:53", "text": "どちらもですが、TRDまで見つけることができません"}, {"type": "subtitle", "time": 14095.59, "timestamp": "03:54:55", "text": "完了してすべてが元に戻ります"}, {"type": "subtitle", "time": 14098.71, "timestamp": "03:54:58", "text": "かつてはそうだった。あなたの楽観主義が好きです。さあ"}]
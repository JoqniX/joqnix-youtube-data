[{"type": "subtitle", "time": 4266.31, "timestamp": "01:11:06", "text": "つまり、私には目と指があるということです。どうやって"}, {"type": "subtitle", "time": 4269.75, "timestamp": "01:11:09", "text": "私は死んだのか？まるで私が死んだかのように"}, {"type": "subtitle", "time": 4272.87, "timestamp": "01:11:12", "text": "飛び跳ねるスクリプト顔。"}, {"type": "subtitle", "time": 4275.51, "timestamp": "01:11:15", "text": "びっくりさせるような顔。私も。実際、"}, {"type": "subtitle", "time": 4278.07, "timestamp": "01:11:18", "text": "犬は何もしなかった。それはただそうではなかった"}, {"type": "subtitle", "time": 4280.63, "timestamp": "01:11:20", "text": "仕事。二重のダメージで少し傷ついた"}, {"type": "subtitle", "time": 4283.11, "timestamp": "01:11:23", "text": "少し。ダブルいいねいいねをくれたらいいねを1つくれました"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "噛んで、残りは"}, {"type": "subtitle", "time": 4287.51, "timestamp": "01:11:27", "text": "ジャンプスケア。"}, {"type": "subtitle", "time": 4291.03, "timestamp": "01:11:31", "text": "よし、一緒に足を探しに行こう。"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "ちょっと待ってください。私はいくつか必要です"}, {"type": "subtitle", "time": 4297.27, "timestamp": "01:11:37", "text": "不安を和らげる薬。ニース。さあ行こう。 Ch.どこ"}, {"type": "chat", "time": 4300.265, "timestamp": "01:11:40", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "joq used to do these?"}, {"type": "subtitle", "time": 4309.43, "timestamp": "01:11:49", "text": "よし、行こう。"}, {"type": "subtitle", "time": 4311.709, "timestamp": "01:11:51", "text": "Fは懐中電灯のF。"}]
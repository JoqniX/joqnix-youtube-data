[{"type": "subtitle", "time": 16922.55, "timestamp": "04:42:02", "text": "現代の日本人。えーと、"}, {"type": "subtitle", "time": 16925.27, "timestamp": "04:42:05", "text": "最高。わかった。そして私は話すように努めます"}, {"type": "subtitle", "time": 16929.03, "timestamp": "04:42:09", "text": "今日の日本語で。わかった。私はそうするだろう"}, {"type": "subtitle", "time": 16932.03, "timestamp": "04:42:12", "text": "多分下手だけど、"}, {"type": "subtitle", "time": 16935.19, "timestamp": "04:42:15", "text": "わかった。私はまだ自分の"}, {"type": "subtitle", "time": 16966.03, "timestamp": "04:42:46", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 16972.788, "timestamp": "04:42:52", "text": "調整する。皆さんはどうですか？待って、"}, {"type": "subtitle", "time": 16975.31, "timestamp": "04:42:55", "text": "待って。日本語。私"}]
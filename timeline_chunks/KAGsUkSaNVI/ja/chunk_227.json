[{"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "[音楽]"}, {"type": "subtitle", "time": 13637.99, "timestamp": "03:47:17", "text": "ああ、WSは全部終わったよ。 30秒"}, {"type": "subtitle", "time": 13640.07, "timestamp": "03:47:20", "text": "この宇宙を終わらせる前に。しかし"}, {"type": "subtitle", "time": 13642.71, "timestamp": "03:47:22", "text": "どういうわけか、私はいつも最悪の部分ばかりを見つけてしまう。"}, {"type": "subtitle", "time": 13646.07, "timestamp": "03:47:26", "text": "これはホットなオートクチュールよ、ダーリン。デザイン"}, {"type": "subtitle", "time": 13649.59, "timestamp": "03:47:29", "text": "ジャンボカーネーション本人による。"}, {"type": "subtitle", "time": 13652.469, "timestamp": "03:47:32", "text": "ああ、私の衣装はたまたま私の"}, {"type": "subtitle", "time": 13655.51, "timestamp": "03:47:35", "text": "力。そして私は実際に見ている"}, {"type": "subtitle", "time": 13661.99, "timestamp": "03:47:41", "text": "[音楽]"}, {"type": "subtitle", "time": 13666.15, "timestamp": "03:47:46", "text": "戦闘開始まで5、4、3、"}, {"type": "subtitle", "time": 13668.15, "timestamp": "03:47:48", "text": "二。必要なのは、"}, {"type": "subtitle", "time": 13671.55, "timestamp": "03:47:51", "text": "任務地域。わかった。この服は"}, {"type": "subtitle", "time": 13675.59, "timestamp": "03:47:55", "text": "そこで支払う。"}]
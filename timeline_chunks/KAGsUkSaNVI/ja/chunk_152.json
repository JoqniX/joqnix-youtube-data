[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "私を長く抑えつけることはできない。それは"}, {"type": "subtitle", "time": 9148.63, "timestamp": "02:32:28", "text": "幸せだと思う"}, {"type": "subtitle", "time": 9150.309, "timestamp": "02:32:30", "text": "対処できない。私は"}, {"type": "subtitle", "time": 9160.07, "timestamp": "02:32:40", "text": "君は私を虜にしたと思ったよ。邪魔しないで"}, {"type": "subtitle", "time": 9161.59, "timestamp": "02:32:41", "text": "スパイダー。"}]
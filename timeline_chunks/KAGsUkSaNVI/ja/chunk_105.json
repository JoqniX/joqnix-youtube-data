[{"type": "subtitle", "time": 6300.87, "timestamp": "01:45:00", "text": "痛み。シャン・サムも見かけました。ようこそ。"}, {"type": "subtitle", "time": 6302.229, "timestamp": "01:45:02", "text": "あなたがまだそこにいるかどうかはわかりませんが、"}, {"type": "subtitle", "time": 6304.39, "timestamp": "01:45:04", "text": "うん、チャットとモーターをスクロールしてる"}, {"type": "subtitle", "time": 6311.03, "timestamp": "01:45:11", "text": "えっと、ジェン、こんにちは。そして、ニンジャ、こんにちは。"}, {"type": "subtitle", "time": 6314.55, "timestamp": "01:45:14", "text": "クロノス、こんにちは。こんにちは。イサミサ、私は"}, {"type": "subtitle", "time": 6315.83, "timestamp": "01:45:15", "text": "あなたがまだここにいるかどうかはわかりませんが、ありがとう"}, {"type": "subtitle", "time": 6318.629, "timestamp": "01:45:18", "text": "襲撃とこんにちは。こんばんは。"}, {"type": "chat", "time": 6326.42, "timestamp": "01:45:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yes, good morning"}, {"type": "subtitle", "time": 6328.47, "timestamp": "01:45:28", "text": "午後。わかった。ええと、ジョーは以前は"}, {"type": "subtitle", "time": 6330.629, "timestamp": "01:45:30", "text": "これら。はい、以前はホラー映画をやっていました。"}, {"type": "chat", "time": 6332.322, "timestamp": "01:45:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "time to have breakfast"}, {"type": "subtitle", "time": 6333.109, "timestamp": "01:45:33", "text": "昔の話だけどね。それはまるで"}, {"type": "subtitle", "time": 6336.07, "timestamp": "01:45:36", "text": "私はホラーから積極的に逃げている、"}, {"type": "subtitle", "time": 6337.99, "timestamp": "01:45:37", "text": "何でも。できないわけではない"}, {"type": "subtitle", "time": 6341.55, "timestamp": "01:45:41", "text": "日本にいるときはもうホラーは"}, {"type": "subtitle", "time": 6344.31, "timestamp": "01:45:44", "text": "何でも。でも、もちろん、私は"}, {"type": "subtitle", "time": 6345.47, "timestamp": "01:45:45", "text": "する必要がある"}, {"type": "subtitle", "time": 6348.709, "timestamp": "01:45:48", "text": "ホラー。 PCでゲームを見ると、"}, {"type": "subtitle", "time": 6350.709, "timestamp": "01:45:50", "text": "「おい、これを終わらせなきゃ」って感じだった。"}, {"type": "chat", "time": 6355.348, "timestamp": "01:45:55", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "u do actively run way from horror tho 💀"}]
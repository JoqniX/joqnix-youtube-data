[{"type": "subtitle", "time": 5162.51, "timestamp": "01:26:02", "text": "非常識な。でも、彼には手を出さないで。それは役に立たない"}, {"type": "subtitle", "time": 5164.95, "timestamp": "01:26:04", "text": "実は。彼は実際にはより速い"}, {"type": "subtitle", "time": 5174.07, "timestamp": "01:26:14", "text": "ほんの一瞬だけ効果がある。それは"}, {"type": "subtitle", "time": 5178.07, "timestamp": "01:26:18", "text": "一瞬の間を置いてから、彼は攻撃を始めた。"}, {"type": "subtitle", "time": 5187.59, "timestamp": "01:26:27", "text": "痛い。死ぬな。わかった。"}, {"type": "subtitle", "time": 5190.87, "timestamp": "01:26:30", "text": "私は本当に死ぬと思う。彼はまるで"}, {"type": "subtitle", "time": 5194.229, "timestamp": "01:26:34", "text": "閉じ込められる。ああ、彼は死んでしまった。ええ、私は"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "実際には亡くなった。"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "それはまずい。私は好きになれない 私は好きになれない"}, {"type": "subtitle", "time": 5200.47, "timestamp": "01:26:40", "text": "周囲にたくさんあります。大丈夫。蘇生を試みる"}, {"type": "subtitle", "time": 5202.55, "timestamp": "01:26:42", "text": "あなた自身。"}, {"type": "subtitle", "time": 5206.95, "timestamp": "01:26:46", "text": "うん。とにかく、ドアが近くにあるといいんだけど。"}, {"type": "subtitle", "time": 5209.59, "timestamp": "01:26:49", "text": "大丈夫。大丈夫。"}, {"type": "subtitle", "time": 5211.35, "timestamp": "01:26:51", "text": "そしてそれは他の場所とは違って"}, {"type": "subtitle", "time": 5213.35, "timestamp": "01:26:53", "text": "非常に遠い。"}, {"type": "subtitle", "time": 5217.669, "timestamp": "01:26:57", "text": "ああ、神様。ああ、この人ったら。"}]
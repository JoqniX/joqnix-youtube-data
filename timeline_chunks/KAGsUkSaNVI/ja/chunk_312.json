[{"type": "subtitle", "time": 18721.35, "timestamp": "05:12:01", "text": "あなたのために。君を迎えに行くよ。"}, {"type": "subtitle", "time": 18723.4, "timestamp": "05:12:03", "text": "冗談です。"}, {"type": "subtitle", "time": 18764.39, "timestamp": "05:12:44", "text": "そこには。待って、クラスはありますか？"}, {"type": "subtitle", "time": 18774.11, "timestamp": "05:12:54", "text": "ほとんどの人は都合がつかない"}, {"type": "subtitle", "time": 18777.788, "timestamp": "05:12:57", "text": "今日。でも、ピューピュー撃とう、"}]
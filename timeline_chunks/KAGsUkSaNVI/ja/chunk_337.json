[{"type": "subtitle", "time": 20222.628, "timestamp": "05:37:02", "text": "アンインストールします。私はリポジトリは作成しません。いいえ、私は"}, {"type": "subtitle", "time": 20224.59, "timestamp": "05:37:04", "text": "アンインストールできます"}, {"type": "subtitle", "time": 20227.39, "timestamp": "05:37:07", "text": "リポジトリ。インストールできませんでした"}, {"type": "subtitle", "time": 20229.788, "timestamp": "05:37:09", "text": "私がリポジトリである場合"}, {"type": "subtitle", "time": 20236.788, "timestamp": "05:37:16", "text": "Mリポジトリなら理解できる。"}, {"type": "subtitle", "time": 20238.31, "timestamp": "05:37:18", "text": "それから、こんなゲームがある"}, {"type": "subtitle", "time": 20240.91, "timestamp": "05:37:20", "text": "航海の"}, {"type": "subtitle", "time": 20244.548, "timestamp": "05:37:24", "text": "Neraは、デモ版があると思います。"}, {"type": "subtitle", "time": 20250.67, "timestamp": "05:37:30", "text": "えっと、そのゲームは第3四半期に発売されます"}, {"type": "subtitle", "time": 20254.79, "timestamp": "05:37:34", "text": "2025年。それは興味深いですね。"}, {"type": "subtitle", "time": 20260.67, "timestamp": "05:37:40", "text": "ええと、枯れていく"}, {"type": "subtitle", "time": 20274.788, "timestamp": "05:37:54", "text": "波？つまり、それを実行する前に、私は"}, {"type": "subtitle", "time": 20278.67, "timestamp": "05:37:58", "text": "まだアップロードしていないクリップがたくさんあります。"}]
[{"type": "subtitle", "time": 4802.31, "timestamp": "01:20:02", "text": "放射線発生場所。それもまた事実です。しかし"}, {"type": "subtitle", "time": 4805.59, "timestamp": "01:20:05", "text": "私たちはその側面を探求していません。いいえ。"}, {"type": "subtitle", "time": 4807.27, "timestamp": "01:20:07", "text": "そこに入ったら死ぬよ"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "場所。ちなみに、参考までに。いいえ、"}, {"type": "subtitle", "time": 4814.39, "timestamp": "01:20:14", "text": "若干。まるで"}, {"type": "subtitle", "time": 4816.31, "timestamp": "01:20:16", "text": "足元を狙え。"}, {"type": "subtitle", "time": 4817.79, "timestamp": "01:20:17", "text": "そうそう。"}, {"type": "subtitle", "time": 4824.229, "timestamp": "01:20:24", "text": "うん。仕事、仕事。疲れた。ごめん。おお、"}, {"type": "subtitle", "time": 4827.189, "timestamp": "01:20:27", "text": "一緒に散歩に行きましょう。私も少ない"}, {"type": "subtitle", "time": 4829.03, "timestamp": "01:20:29", "text": "スタミナ。"}, {"type": "subtitle", "time": 4831.669, "timestamp": "01:20:31", "text": "うん。"}, {"type": "subtitle", "time": 4834.07, "timestamp": "01:20:34", "text": "わかった。"}, {"type": "subtitle", "time": 4841.99, "timestamp": "01:20:41", "text": "一つはジャンプスケアのベースです。だから私たちはジャンプする"}, {"type": "subtitle", "time": 4849.27, "timestamp": "01:20:49", "text": "ああ、ジャンプスケア、ジャンプスケア。"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "彼はそこにいる。見なくてよかった"}, {"type": "subtitle", "time": 4857.75, "timestamp": "01:20:57", "text": "彼は、"}]
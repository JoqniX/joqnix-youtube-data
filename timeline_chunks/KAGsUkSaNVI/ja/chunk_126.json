[{"type": "subtitle", "time": 7565.95, "timestamp": "02:06:05", "text": "そうやって寝ると"}, {"type": "subtitle", "time": 7574.91, "timestamp": "02:06:14", "text": "桟橋で昼寝。アスリートはよく眠るんだろうな。私"}, {"type": "subtitle", "time": 7582.55, "timestamp": "02:06:22", "text": "寝る。これは"}, {"type": "subtitle", "time": 7603.39, "timestamp": "02:06:43", "text": "マイクミュート"}, {"type": "subtitle", "time": 7606.109, "timestamp": "02:06:46", "text": "たぶん、そしてこれは"}, {"type": "subtitle", "time": 7613.55, "timestamp": "02:06:53", "text": "寝坊した"}]
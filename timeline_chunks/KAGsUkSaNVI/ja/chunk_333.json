[{"type": "subtitle", "time": 19981.628, "timestamp": "05:33:01", "text": "仕事？ああ、"}, {"type": "subtitle", "time": 19986.548, "timestamp": "05:33:06", "text": "神。私はすでに言いましたが、"}, {"type": "subtitle", "time": 19989.11, "timestamp": "05:33:09", "text": "もしあなたがアーティストで、"}, {"type": "subtitle", "time": 19991.83, "timestamp": "05:33:11", "text": "あなたのクライアントか何かとして、私は"}, {"type": "subtitle", "time": 19994.35, "timestamp": "05:33:14", "text": "すでに"}, {"type": "subtitle", "time": 19997.628, "timestamp": "05:33:17", "text": "満杯。えっと、私は"}, {"type": "subtitle", "time": 20000.15, "timestamp": "05:33:20", "text": "壊れた。私もお金がないんです。私はすでに"}, {"type": "subtitle", "time": 20003.11, "timestamp": "05:33:23", "text": "満杯。私がすでに選んだ人々は"}, {"type": "subtitle", "time": 20005.31, "timestamp": "05:33:25", "text": "すでに仕事を開始し、"}, {"type": "subtitle", "time": 20007.83, "timestamp": "05:33:27", "text": "すべて。私はジョッカソンに参加しています"}, {"type": "subtitle", "time": 20010.39, "timestamp": "05:33:30", "text": "彼らに支払うため。それでおしまい。私の持ち物は"}, {"type": "subtitle", "time": 20012.47, "timestamp": "05:33:32", "text": "デビューに向けてすでに予定がいっぱいで、"}, {"type": "subtitle", "time": 20015.39, "timestamp": "05:33:35", "text": "完全に完了しました。"}, {"type": "subtitle", "time": 20017.31, "timestamp": "05:33:37", "text": "それで"}, {"type": "subtitle", "time": 20021.628, "timestamp": "05:33:41", "text": "ええ、いいえと言わざるを得ません。"}, {"type": "subtitle", "time": 20028.07, "timestamp": "05:33:48", "text": "実際に、"}, {"type": "subtitle", "time": 20032.708, "timestamp": "05:33:52", "text": "他の人や物を探している。えっと"}, {"type": "subtitle", "time": 20035.83, "timestamp": "05:33:55", "text": "新しいクライアントが見つかるといいですね。"}, {"type": "subtitle", "time": 20038.91, "timestamp": "05:33:58", "text": "困っている人。でも今のところ、私は"}]
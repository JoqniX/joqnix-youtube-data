[{"type": "subtitle", "time": 843.35, "timestamp": "00:14:03", "text": "えっと、ラブソンの投稿を見たんだけど"}, {"type": "subtitle", "time": 845.269, "timestamp": "00:14:05", "text": "彼女はYouTubeメンバーシップでそれを実行した"}, {"type": "subtitle", "time": 849.35, "timestamp": "00:14:09", "text": "あれ。彼女は投稿をまるまる一つ作った"}, {"type": "subtitle", "time": 853.189, "timestamp": "00:14:13", "text": "人々にガイドラインを与える"}, {"type": "chat", "time": 855.373, "timestamp": "00:14:15", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "thats why i have stopped midnight snacks too"}, {"type": "subtitle", "time": 856.31, "timestamp": "00:14:16", "text": "会員登録の方法など"}, {"type": "subtitle", "time": 859.35, "timestamp": "00:14:19", "text": "何が期待できるか、なぜ、えーと、すべて"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "あれってすごくかっこいいよね"}, {"type": "subtitle", "time": 864.23, "timestamp": "00:14:24", "text": "それも考えておくべきだった。それは"}, {"type": "subtitle", "time": 867.59, "timestamp": "00:14:27", "text": "すごくかっこいい。私が見ているのは、私はその事実が大好きです"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "私のクリエイティブな友人たちを見て"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "他のクリエイターたちが私にインスピレーションを与えてくれる"}, {"type": "subtitle", "time": 874.949, "timestamp": "00:14:34", "text": "あなたも知っているように、私もやりたいことがあります"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "そういう類のものだけど"}, {"type": "subtitle", "time": 882.11, "timestamp": "00:14:42", "text": "私自身のミックスで私自身のミックスで"}, {"type": "subtitle", "time": 891.43, "timestamp": "00:14:51", "text": "うん、私も何かするべきだね"}, {"type": "subtitle", "time": 894.71, "timestamp": "00:14:54", "text": "それはあまり多くの人が知らないから"}, {"type": "subtitle", "time": 896.949, "timestamp": "00:14:56", "text": "それは会員制のもので"}, {"type": "subtitle", "time": 898.99, "timestamp": "00:14:58", "text": "1"}]
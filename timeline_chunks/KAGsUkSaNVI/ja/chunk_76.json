[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "ドアにクリップで固定します。もちろん、それは"}, {"type": "subtitle", "time": 4563.51, "timestamp": "01:16:03", "text": "それは確かに理にかなっている。見て、君"}, {"type": "subtitle", "time": 4566.229, "timestamp": "01:16:06", "text": "中に入ってきてもいいですよ。あなた"}, {"type": "subtitle", "time": 4570.47, "timestamp": "01:16:10", "text": "安全とは言えない。持続する。本当に？"}, {"type": "subtitle", "time": 4572.79, "timestamp": "01:16:12", "text": "本当に？来て。何てことだ。あなたは"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "これよりはましだ。来て。私は中にいます"}, {"type": "subtitle", "time": 4577.83, "timestamp": "01:16:17", "text": "時計。時計をください。わかった。できる"}, {"type": "subtitle", "time": 4579.35, "timestamp": "01:16:19", "text": "私がいなくてもパズルを解けますか？"}, {"type": "subtitle", "time": 4580.63, "timestamp": "01:16:20", "text": "楽しんでいます。うん。うん。"}, {"type": "subtitle", "time": 4583.189, "timestamp": "01:16:23", "text": "わかった。わかった。楽しんでください。"}, {"type": "subtitle", "time": 4586.55, "timestamp": "01:16:26", "text": "おい、君。調子はどうだい？"}, {"type": "subtitle", "time": 4588.07, "timestamp": "01:16:28", "text": "ああ、チャド、君の言う通りだ。この場所は"}, {"type": "subtitle", "time": 4593.669, "timestamp": "01:16:33", "text": "私は怖くないから嬉しい"}, {"type": "subtitle", "time": 4596.55, "timestamp": "01:16:36", "text": "スピードランの動画を見た。もし私が"}, {"type": "subtitle", "time": 4598.87, "timestamp": "01:16:38", "text": "見なかったら泣いちゃうよ。いいえ、いいえ、"}, {"type": "subtitle", "time": 4600.87, "timestamp": "01:16:40", "text": "いいえ。大丈夫。ところで、スピードラン"}, {"type": "subtitle", "time": 4602.95, "timestamp": "01:16:42", "text": "それは、何て言うんだっけ？"}, {"type": "subtitle", "time": 4604.51, "timestamp": "01:16:44", "text": "そのその"}, {"type": "subtitle", "time": 4607.43, "timestamp": "01:16:47", "text": "パズル。奥の部屋ではない"}, {"type": "subtitle", "time": 4609.59, "timestamp": "01:16:49", "text": "迷惑な。これはパズルズームです"}, {"type": "subtitle", "time": 4612.51, "timestamp": "01:16:52", "text": "実際はゲームです。こんにちは。私は"}, {"type": "subtitle", "time": 4614.95, "timestamp": "01:16:54", "text": "あれ。やったと思う。なぜ"}, {"type": "subtitle", "time": 4617.51, "timestamp": "01:16:57", "text": "ない？おいおい、頼むよ。"}]
[{"type": "subtitle", "time": 3485.51, "timestamp": "00:58:05", "text": "[音楽]"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "よし、彼はもう行ってしまった。彼はもういない。さあ行こう。"}, {"type": "subtitle", "time": 3495.99, "timestamp": "00:58:15", "text": "というわけで、選手を獲得しました。さて、私たちは"}, {"type": "subtitle", "time": 3500.63, "timestamp": "00:58:20", "text": "行く。わかった。そうそう。さあ、行こう"}, {"type": "subtitle", "time": 3503.03, "timestamp": "00:58:23", "text": "この場所へ向かって。"}, {"type": "subtitle", "time": 3505.27, "timestamp": "00:58:25", "text": "うん、ここが犬が最後に来た場所だ"}, {"type": "subtitle", "time": 3506.51, "timestamp": "00:58:26", "text": "時間。"}, {"type": "subtitle", "time": 3510.63, "timestamp": "00:58:30", "text": "はい。ええと、左に進みます。"}, {"type": "subtitle", "time": 3512.87, "timestamp": "00:58:32", "text": "ああ、あれは何だ？"}, {"type": "subtitle", "time": 3529.51, "timestamp": "00:58:49", "text": "よくある場所もあります"}, {"type": "subtitle", "time": 3533.109, "timestamp": "00:58:53", "text": "顔が召喚されるような場所。"}]
[{"type": "subtitle", "time": 4140.149, "timestamp": "01:09:00", "text": "上中央にあるのは、"}, {"type": "subtitle", "time": 4142.149, "timestamp": "01:09:02", "text": "足を見つけてください。"}, {"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "わかった。"}, {"type": "subtitle", "time": 4145.91, "timestamp": "01:09:05", "text": "誰が歯をなくしたの？ジェニファーは"}, {"type": "subtitle", "time": 4148.149, "timestamp": "01:09:08", "text": "歯。ジェニファー・モリー。私はただ"}, {"type": "subtitle", "time": 4149.749, "timestamp": "01:09:09", "text": "歯。"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "ニース。"}, {"type": "subtitle", "time": 4154.349, "timestamp": "01:09:14", "text": "それから"}, {"type": "subtitle", "time": 4156.269, "timestamp": "01:09:16", "text": "えっと、それは"}, {"type": "subtitle", "time": 4158.59, "timestamp": "01:09:18", "text": "ではなかった"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "マレーネ。それは何だったのか？ネイサン・アレン。手に入れた"}, {"type": "subtitle", "time": 4163.11, "timestamp": "01:09:23", "text": "それ。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "救急救命室に連絡が取れなくなった。よし。必要なのは"}, {"type": "subtitle", "time": 4170.709, "timestamp": "01:09:30", "text": "足。この男。わかった。指なんて必要ない"}, {"type": "subtitle", "time": 4173.99, "timestamp": "01:09:33", "text": "けれど？えっと、この人。彼が"}, {"type": "subtitle", "time": 4177.269, "timestamp": "01:09:37", "text": "私たちに伝えている。誰が？ジョナサン。ジョナサン"}, {"type": "subtitle", "time": 4179.189, "timestamp": "01:09:39", "text": "男は足が必要だ。私たちは見つける必要がある"}, {"type": "subtitle", "time": 4182.709, "timestamp": "01:09:42", "text": "足。何？いいえ。"}, {"type": "subtitle", "time": 4185.189, "timestamp": "01:09:45", "text": "在庫にその足はありますか？"}, {"type": "subtitle", "time": 4187.749, "timestamp": "01:09:47", "text": "私には指がある。"}, {"type": "subtitle", "time": 4189.43, "timestamp": "01:09:49", "text": "指。"}, {"type": "subtitle", "time": 4192.55, "timestamp": "01:09:52", "text": "うん。誰が指をなくしたの？待って、私たちは"}, {"type": "subtitle", "time": 4196.95, "timestamp": "01:09:56", "text": "全員のためにそうするべきなのか？"}]
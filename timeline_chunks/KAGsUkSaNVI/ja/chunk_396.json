[{"type": "subtitle", "time": 23763.43, "timestamp": "06:36:03", "text": "パワーが鍵となる。私たちにはその恩恵がある。私たちは"}, {"type": "subtitle", "time": 23798.07, "timestamp": "06:36:38", "text": "私は攻撃を受けている。"}, {"type": "subtitle", "time": 23799.23, "timestamp": "06:36:39", "text": "私は持っている"}, {"type": "subtitle", "time": 23802.548, "timestamp": "06:36:42", "text": "周囲に印をつけてきた。"}, {"type": "subtitle", "time": 23804.708, "timestamp": "06:36:44", "text": "敵のシールドが破壊された。はい、今行きます。"}]
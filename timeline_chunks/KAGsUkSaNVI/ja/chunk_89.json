[{"type": "subtitle", "time": 5343.11, "timestamp": "01:29:03", "text": "神よ、主の愛にかけて、私はあなたを見ています。私"}, {"type": "subtitle", "time": 5345.75, "timestamp": "01:29:05", "text": "持っていない 持っていない 来てください"}, {"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "ここ。ここに来て。ああ、君は全部持ってるよ、"}, {"type": "subtitle", "time": 5351.91, "timestamp": "01:29:11", "text": "右？うん。さあ、行きましょう。走る"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "真っ直ぐ。まっすぐ走れ。まっすぐ走れ。"}, {"type": "subtitle", "time": 5356.55, "timestamp": "01:29:16", "text": "ああ、ケーブルだよ。大丈夫。わかった。"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "大丈夫です。彼はただ悲しんでいるだけだ。その"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "大丈夫。うん。うん。うん。うん。ああ、"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "あの不気味な顔。"}, {"type": "subtitle", "time": 5367.51, "timestamp": "01:29:27", "text": "ジャンプスケア。見ないで。"}, {"type": "subtitle", "time": 5371.35, "timestamp": "01:29:31", "text": "ジャンプスケア。ああ、ちくしょう。私たちは死んだ。午前"}, {"type": "subtitle", "time": 5374.149, "timestamp": "01:29:34", "text": "私は今、正気を失っているのか？あなたは死んだのですか？電話してね"}, {"type": "subtitle", "time": 5377.07, "timestamp": "01:29:37", "text": "非常識な。"}, {"type": "subtitle", "time": 5381.189, "timestamp": "01:29:41", "text": "何？どうしたの？え、死んだの？"}, {"type": "subtitle", "time": 5382.79, "timestamp": "01:29:42", "text": "私は死ななかった。どこにいるの？わかった。わかった。"}, {"type": "subtitle", "time": 5385.11, "timestamp": "01:29:45", "text": "わかった。わかった。私は、私は、えーとハグしているような"}, {"type": "subtitle", "time": 5387.189, "timestamp": "01:29:47", "text": "今のところ、壁は。ただ待っている"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "不気味な感じがした。わかった。その男は"}, {"type": "subtitle", "time": 5393.27, "timestamp": "01:29:53", "text": "去った。その男はもういない。どこにいるの？私たちは"}, {"type": "subtitle", "time": 5396.79, "timestamp": "01:29:56", "text": "真っ直ぐ進んで下さい。うん。まっすぐ行く"}, {"type": "subtitle", "time": 5398.629, "timestamp": "01:29:58", "text": "こちらです。フォローしています。私は持っていません"}]
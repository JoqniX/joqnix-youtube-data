[{"type": "subtitle", "time": 3124.39, "timestamp": "00:52:04", "text": "耳と、ええと、耳と歯を取ります。私は手に入れた"}, {"type": "subtitle", "time": 3127.51, "timestamp": "00:52:07", "text": "耳。わかった。ニース。"}, {"type": "subtitle", "time": 3130.069, "timestamp": "00:52:10", "text": "わかった。取ってください。 取ってください。 わかりました、いいですね。"}, {"type": "subtitle", "time": 3138.71, "timestamp": "00:52:18", "text": "ああ、不安を和らげる薬を飲んでください。私はそれを受け取った。"}, {"type": "subtitle", "time": 3140.95, "timestamp": "00:52:20", "text": "もうこれ以上は耐えられない。私は耐えられない"}, {"type": "subtitle", "time": 3145.19, "timestamp": "00:52:25", "text": "もう。あなたはできません？わかった。おお、"}, {"type": "subtitle", "time": 3147.87, "timestamp": "00:52:27", "text": "幽霊が1体やって来る"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "少し。彼が来る。"}, {"type": "subtitle", "time": 3152.87, "timestamp": "00:52:32", "text": "どこ？"}, {"type": "subtitle", "time": 3160.87, "timestamp": "00:52:40", "text": "いいえ、ただテープで録画するだけです。これは何ですか？指。"}, {"type": "subtitle", "time": 3168.03, "timestamp": "00:52:48", "text": "うん。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 3178.47, "timestamp": "00:52:58", "text": "ところで、あなたは何が欲しいのですか？"}]
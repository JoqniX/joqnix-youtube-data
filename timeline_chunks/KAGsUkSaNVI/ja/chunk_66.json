[{"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "ああ、じっとしてて。じっとしていてください。おお"}, {"type": "subtitle", "time": 3968.95, "timestamp": "01:06:08", "text": "ああ、私は死んだ。えっと、びっくりしました。"}, {"type": "subtitle", "time": 3971.67, "timestamp": "01:06:11", "text": "ダブルジャンプのスキンを手に入れました。ごめんなさい。ああ、"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "神。どうやら、えーっと、ああ。うん。"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "どうやら不気味な顔と犬"}, {"type": "subtitle", "time": 3980.029, "timestamp": "01:06:20", "text": "殺された。"}, {"type": "subtitle", "time": 3984.15, "timestamp": "01:06:24", "text": "うん。わかった。これを見つけてください。の"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "ドア。はい。"}, {"type": "subtitle", "time": 3990.87, "timestamp": "01:06:30", "text": "あなたはドアを見つけました。本当に？"}, {"type": "subtitle", "time": 3993.39, "timestamp": "01:06:33", "text": "私はドアの方を追っています。きらめく"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "あれ。本当に？きらめく"}, {"type": "subtitle", "time": 4003.51, "timestamp": "01:06:43", "text": "どこ"}, {"type": "subtitle", "time": 4006.789, "timestamp": "01:06:46", "text": "私にとってそれは"}, {"type": "subtitle", "time": 4008.27, "timestamp": "01:06:48", "text": "私にとってはそうではない"}, {"type": "subtitle", "time": 4011.349, "timestamp": "01:06:51", "text": "表示とは、このゲームが今表示されたことを意味します"}]
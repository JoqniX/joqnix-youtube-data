[{"type": "subtitle", "time": 3181.109, "timestamp": "00:53:01", "text": "待って、待って、待って。いや、違うよ。私は聞いた"}, {"type": "subtitle", "time": 3185.99, "timestamp": "00:53:05", "text": "おばけ。ちょっと待って、キーを再割り当てさせてください"}, {"type": "subtitle", "time": 3189.19, "timestamp": "00:53:09", "text": "1秒。在庫はどこにありますか？したい"}, {"type": "subtitle", "time": 3191.19, "timestamp": "00:53:11", "text": "メモしておいてください。"}, {"type": "subtitle", "time": 3195.109, "timestamp": "00:53:15", "text": "インベントリキーを再割り当てしたかったのですが"}, {"type": "subtitle", "time": 3198.79, "timestamp": "00:53:18", "text": "そうすれば、装備をより早く揃えられる。"}, {"type": "subtitle", "time": 3201.67, "timestamp": "00:53:21", "text": "タブ。私はそれをタブキーに割り当てました。ああ神様、"}, {"type": "subtitle", "time": 3205.03, "timestamp": "00:53:25", "text": "あれは不気味な幽霊の顔だ。"}, {"type": "subtitle", "time": 3207.27, "timestamp": "00:53:27", "text": "ジャンプスケアのような素早いもの"}, {"type": "subtitle", "time": 3210.47, "timestamp": "00:53:30", "text": "お前を死に至らしめる。うん。うん。だから私は信じています"}, {"type": "subtitle", "time": 3212.15, "timestamp": "00:53:32", "text": "あなた"}, {"type": "subtitle", "time": 3215.19, "timestamp": "00:53:35", "text": "見えない。うん。待って"}, {"type": "subtitle", "time": 3221.75, "timestamp": "00:53:41", "text": "見ないで。チャック、君は何をしているんだ？"}, {"type": "subtitle", "time": 3223.589, "timestamp": "00:53:43", "text": "何をしているの？いや、いや、いや、いや。横から"}, {"type": "subtitle", "time": 3226.91, "timestamp": "00:53:46", "text": "また。まあ、できると思うよ。私はしません"}, {"type": "subtitle", "time": 3231.27, "timestamp": "00:53:51", "text": "知る。それはなくなってしまった。彼はもういない。うん。行く。"}, {"type": "subtitle", "time": 3233.67, "timestamp": "00:53:53", "text": "彼は文字通りここで飛び降りて死ぬ、"}, {"type": "subtitle", "time": 3237.03, "timestamp": "00:53:57", "text": "方法。それはそういうことだ。"}, {"type": "subtitle", "time": 3239.349, "timestamp": "00:53:59", "text": "ああ、私は正気じゃないのか？ちょっと待ってください。ジャブ、"}]
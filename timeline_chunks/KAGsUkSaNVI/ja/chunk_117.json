[{"type": "subtitle", "time": 7024.95, "timestamp": "01:57:04", "text": "午後。だから3から4から6まで"}, {"type": "subtitle", "time": 7027.03, "timestamp": "01:57:07", "text": "夕方にそれをしてください。お茶と軽食は"}, {"type": "subtitle", "time": 7035.03, "timestamp": "01:57:15", "text": "4から6になります。12から12から3になります。"}, {"type": "subtitle", "time": 7039.91, "timestamp": "01:57:19", "text": "ええと、12時から3時までは昼食時間です。朝食"}, {"type": "subtitle", "time": 7042.35, "timestamp": "01:57:22", "text": "午前6時頃に置いた。"}, {"type": "subtitle", "time": 7046.91, "timestamp": "01:57:26", "text": "うん。午前6時から"}, {"type": "subtitle", "time": 7049.229, "timestamp": "01:57:29", "text": "11:59は"}, {"type": "chat", "time": 7050.211, "timestamp": "01:57:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"it depends on the time\" but who's gonna tell the pc your eating habits and sleeping times"}, {"type": "subtitle", "time": 7051.43, "timestamp": "01:57:31", "text": "朝食。ということで、新しいことをしよう"}, {"type": "subtitle", "time": 7054.109, "timestamp": "01:57:34", "text": "ここに何かあります。"}, {"type": "chat", "time": 7055.78, "timestamp": "01:57:35", "author": "@Mr_ManlyboiGD", "avatar": "https://yt4.ggpht.com/G1AKH_mcI3-RWIHy2mO6H6B6JXNipyogvmXCFqsEaEoeQgso511w9m3HI3usVOCSFqPPETLpZg=s64-c-k-c0x00ffffff-no-rj", "message": "WAKE UP, IT'S THE FIRST OF THE MONTH"}, {"type": "chat", "time": 7058.095, "timestamp": "01:57:38", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAg"}, {"type": "subtitle", "time": 7058.31, "timestamp": "01:57:38", "text": "食事中にそれが検出された場合"}, {"type": "subtitle", "time": 7067.189, "timestamp": "01:57:47", "text": "えっと、誰がPCにあなたの"}, {"type": "subtitle", "time": 7069.189, "timestamp": "01:57:49", "text": "えーと、食習慣と睡眠時間ですか？"}, {"type": "subtitle", "time": 7070.51, "timestamp": "01:57:50", "text": "その"}, {"type": "subtitle", "time": 7074.629, "timestamp": "01:57:54", "text": "大丈夫。こんにちは、モックス。配信へようこ​​そ。"}, {"type": "subtitle", "time": 7076.31, "timestamp": "01:57:56", "text": "だから、これを作ろうと思う"}, {"type": "subtitle", "time": 7078.189, "timestamp": "01:57:58", "text": "手動でではなく"}]
[{"type": "subtitle", "time": 4860.149, "timestamp": "01:21:00", "text": "一発で我々を殺せる。わかった、"}, {"type": "subtitle", "time": 4862.149, "timestamp": "01:21:02", "text": "これは家です これはこれです"}, {"type": "subtitle", "time": 4862.83, "timestamp": "01:21:02", "text": "は"}, {"type": "subtitle", "time": 4866.87, "timestamp": "01:21:06", "text": "放射能。ああ、彼がここにいる。ああ、おいで"}, {"type": "subtitle", "time": 4870.46, "timestamp": "01:21:10", "text": "の上。臭いよ。来て。"}, {"type": "subtitle", "time": 4872.39, "timestamp": "01:21:12", "text": "[音楽]"}, {"type": "subtitle", "time": 4874.47, "timestamp": "01:21:14", "text": "彼はもう怖くない。彼はまるで"}, {"type": "subtitle", "time": 4882.27, "timestamp": "01:21:22", "text": "ああ、彼は私たちに"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "非常識な。私たちは一緒にいることはできません"}, {"type": "subtitle", "time": 4887.189, "timestamp": "01:21:27", "text": "彼にはよく会います。放射線室。次のエリアは"}, {"type": "subtitle", "time": 4888.51, "timestamp": "01:21:28", "text": "完全に"}, {"type": "subtitle", "time": 4890.11, "timestamp": "01:21:30", "text": "無線"}, {"type": "subtitle", "time": 4893.07, "timestamp": "01:21:33", "text": "危険物。部屋の中にあるいくつかのアイテムは"}, {"type": "subtitle", "time": 4896.709, "timestamp": "01:21:36", "text": "汚染されている。それで、相棒、どうやって"}, {"type": "subtitle", "time": 4899.189, "timestamp": "01:21:39", "text": "消火器を探してください。"}, {"type": "subtitle", "time": 4901.99, "timestamp": "01:21:41", "text": "危険物を入手できる場所があります"}, {"type": "subtitle", "time": 4904.79, "timestamp": "01:21:44", "text": "ちなみに、防護服のことです。では、どこで"}, {"type": "subtitle", "time": 4909.11, "timestamp": "01:21:49", "text": "私たちは今すぐそれを見つけなければならない。うん。うん。"}, {"type": "subtitle", "time": 4911.59, "timestamp": "01:21:51", "text": "さあ行こう。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "そうそう。私は正気じゃない。ちょっと待ってください。"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "どこにいるの？私は近くにいて、撃たれた。私は手に入れた"}]
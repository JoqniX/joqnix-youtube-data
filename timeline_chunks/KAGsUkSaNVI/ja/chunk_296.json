[{"type": "subtitle", "time": 17767.59, "timestamp": "04:56:07", "text": "神。ああ、久しぶりだね。"}, {"type": "subtitle", "time": 17768.59, "timestamp": "04:56:08", "text": "サビ。"}, {"type": "subtitle", "time": 17770.43, "timestamp": "04:56:10", "text": "えっと、"}, {"type": "subtitle", "time": 17775.11, "timestamp": "04:56:15", "text": "待って。サビシは孤独だ。えっと、ちょっと待って。どうやって"}, {"type": "subtitle", "time": 17777.23, "timestamp": "04:56:17", "text": "それは"}, {"type": "subtitle", "time": 17781.59, "timestamp": "04:56:21", "text": "その間？どうやって"}, {"type": "subtitle", "time": 17782.67, "timestamp": "04:56:22", "text": "えーと"}, {"type": "subtitle", "time": 17787.708, "timestamp": "04:56:27", "text": "ああ、どうしてこんなにひどい翻訳をしてしまったんだろう？しかし"}, {"type": "subtitle", "time": 17791.948, "timestamp": "04:56:31", "text": "待って。ええと、大丈夫です。"}, {"type": "subtitle", "time": 17795.44, "timestamp": "04:56:35", "text": "こんにちは。えっと"}, {"type": "subtitle", "time": 17805.99, "timestamp": "04:56:45", "text": "キャンディー。おお"}, {"type": "subtitle", "time": 17807.39, "timestamp": "04:56:47", "text": "[音楽]"}, {"type": "subtitle", "time": 17809.55, "timestamp": "04:56:49", "text": "私の。こんにちは。"}, {"type": "subtitle", "time": 17811.15, "timestamp": "04:56:51", "text": "えっと"}, {"type": "subtitle", "time": 17816.83, "timestamp": "04:56:56", "text": "終わり。"}, {"type": "subtitle", "time": 17819.55, "timestamp": "04:56:59", "text": "続く。"}]
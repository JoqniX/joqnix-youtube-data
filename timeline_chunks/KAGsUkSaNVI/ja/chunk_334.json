[{"type": "subtitle", "time": 20064.15, "timestamp": "05:34:24", "text": "はい。わかった。戻ってきました。ここはどこ？"}, {"type": "subtitle", "time": 20066.03, "timestamp": "05:34:26", "text": "明日は"}, {"type": "subtitle", "time": 20067.788, "timestamp": "05:34:27", "text": "1"}, {"type": "subtitle", "time": 20071.708, "timestamp": "05:34:31", "text": "コラボレーション。正直、心配しないでください"}, {"type": "subtitle", "time": 20074.83, "timestamp": "05:34:34", "text": "価格。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 20079.27, "timestamp": "05:34:39", "text": "実は、私は大丈夫です。先ほども言ったように、私は大丈夫です。"}, {"type": "subtitle", "time": 20081.708, "timestamp": "05:34:41", "text": "私はすでに見つけました"}, {"type": "subtitle", "time": 20084.628, "timestamp": "05:34:44", "text": "アーティストたち。ええと、私はかなりこだわりが強い顧客なんです。私は持っている"}, {"type": "subtitle", "time": 20086.91, "timestamp": "05:34:46", "text": "私が探している特定のアートスタイル"}, {"type": "subtitle", "time": 20090.31, "timestamp": "05:34:50", "text": "のために。ええ、すでに連絡を取りました"}, {"type": "subtitle", "time": 20094.47, "timestamp": "05:34:54", "text": "私が自分の持ち物に関わりたかった人たち。"}, {"type": "subtitle", "time": 20096.51, "timestamp": "05:34:56", "text": "そして"}, {"type": "subtitle", "time": 20099.03, "timestamp": "05:34:59", "text": "うん、心配しないで。でもありがとう"}]
[{"type": "subtitle", "time": 18900.23, "timestamp": "05:15:00", "text": "殺す。あれは俺の仕留めたんだぜ、兄弟。それは私の"}, {"type": "subtitle", "time": 18920.948, "timestamp": "05:15:20", "text": "ブラッド、お前に寄生してやる。私は殺すつもりだ"}, {"type": "subtitle", "time": 18923.35, "timestamp": "05:15:23", "text": "あなた。もう一度やってみましょう。あなたの"}]
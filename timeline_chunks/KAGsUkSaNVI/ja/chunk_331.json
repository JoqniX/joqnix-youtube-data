[{"type": "subtitle", "time": 19860.35, "timestamp": "05:31:00", "text": "ええ、私はそうは思いません"}, {"type": "subtitle", "time": 19862.75, "timestamp": "05:31:02", "text": "えっと、私は"}, {"type": "subtitle", "time": 19865.07, "timestamp": "05:31:05", "text": "理解する"}, {"type": "subtitle", "time": 19868.99, "timestamp": "05:31:08", "text": "中国語。私は"}, {"type": "subtitle", "time": 19872.67, "timestamp": "05:31:12", "text": "すぐに覚えます。そして、もしあなたが"}, {"type": "subtitle", "time": 19878.39, "timestamp": "05:31:18", "text": "理解できないならいつでも入力できます"}, {"type": "subtitle", "time": 19883.39, "timestamp": "05:31:23", "text": "中国語でコメントを送ってください。私はできる"}, {"type": "subtitle", "time": 19887.948, "timestamp": "05:31:27", "text": "いつも私は"}, {"type": "subtitle", "time": 19905.91, "timestamp": "05:31:45", "text": "言語？それはインドの"}, {"type": "subtitle", "time": 19908.47, "timestamp": "05:31:48", "text": "言語。私はヒンディー語がわかりません。それでヒンディー語"}, {"type": "subtitle", "time": 19911.83, "timestamp": "05:31:51", "text": "第二言語となるでしょう。知っている。三番目"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "英語になります。 4番目は1番になるだろう。私は"}, {"type": "subtitle", "time": 19917.868, "timestamp": "05:31:57", "text": "現在学習中 それは、"}]
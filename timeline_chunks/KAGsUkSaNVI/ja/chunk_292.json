[{"type": "subtitle", "time": 17520.628, "timestamp": "04:52:00", "text": "また、えっと、これは、これは、大丈夫です、これは"}, {"type": "subtitle", "time": 17525.788, "timestamp": "04:52:05", "text": "大丈夫です、敬意を持って話しかけてください"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "誰かに話しかけるときは、"}, {"type": "subtitle", "time": 17531.03, "timestamp": "04:52:11", "text": "名前の後に息子という称号を付けて示す"}, {"type": "subtitle", "time": 17532.948, "timestamp": "04:52:12", "text": "これを使用する際は敬意を払ってください"}, {"type": "subtitle", "time": 17536.628, "timestamp": "04:52:16", "text": "誰かのファーストネームには"}, {"type": "subtitle", "time": 17540.75, "timestamp": "04:52:20", "text": "英語への翻訳　ああ、わかりました。"}, {"type": "subtitle", "time": 17543.99, "timestamp": "04:52:23", "text": "なるほど、分かりました。次のような挨拶に注目してください"}, {"type": "subtitle", "time": 17547.11, "timestamp": "04:52:27", "text": "こんにちはとbyはよく前に来ます"}, {"type": "subtitle", "time": 17550.708, "timestamp": "04:52:30", "text": "英語の名前だがその後"}, {"type": "subtitle", "time": 17553.99, "timestamp": "04:52:33", "text": "日本語。あ、待って。"}, {"type": "subtitle", "time": 17566.07, "timestamp": "04:52:46", "text": "ああ、神様は時を経て本当に良くなったものだ。"}, {"type": "subtitle", "time": 17568.59, "timestamp": "04:52:48", "text": "ああ、見ていない"}, {"type": "subtitle", "time": 17570.11, "timestamp": "04:52:50", "text": "それ。"}, {"type": "subtitle", "time": 17572.83, "timestamp": "04:52:52", "text": "行く"}, {"type": "subtitle", "time": 17576.948, "timestamp": "04:52:56", "text": "私はそれを見ていません。ああ、それはとてもとても"}, {"type": "subtitle", "time": 17578.27, "timestamp": "04:52:58", "text": "難しい"}]
[{"type": "subtitle", "time": 3242.47, "timestamp": "00:54:02", "text": "落とす。ええ、私は自分が正気じゃないと思います。私に"}, {"type": "subtitle", "time": 3245.79, "timestamp": "00:54:05", "text": "2番。私は錠剤のようなものを服用します。"}, {"type": "subtitle", "time": 3248.75, "timestamp": "00:54:08", "text": "うん。ニース。待って、どうしてそれを知っているの？"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "正気を失ったのか？えっと、"}, {"type": "subtitle", "time": 3254.63, "timestamp": "00:54:14", "text": "少しぼんやりする。どこにいるの？ああ、"}, {"type": "subtitle", "time": 3256.95, "timestamp": "00:54:16", "text": "神。チャック、こっちへ来なさい。私はスピードランニングをしている"}, {"type": "subtitle", "time": 3258.79, "timestamp": "00:54:18", "text": "ゲーム。イエス・キリストよ、おい。私は近くにいます"}, {"type": "subtitle", "time": 3260.47, "timestamp": "00:54:20", "text": "あなた。"}, {"type": "subtitle", "time": 3263.91, "timestamp": "00:54:23", "text": "あれは赤だった？ちょっと赤かった？あなたは"}, {"type": "subtitle", "time": 3266.15, "timestamp": "00:54:26", "text": "細菌に遭遇するだろう。"}, {"type": "subtitle", "time": 3268.63, "timestamp": "00:54:28", "text": "細菌。何？"}, {"type": "subtitle", "time": 3271.91, "timestamp": "00:54:31", "text": "あの、あの、あの麺屋さん。ああ、"}, {"type": "subtitle", "time": 3275.349, "timestamp": "00:54:35", "text": "麺屋。挨拶したい"}, {"type": "subtitle", "time": 3279.51, "timestamp": "00:54:39", "text": "彼？ええ、もちろんです。挨拶しに行きませんか？おお、"}, {"type": "subtitle", "time": 3282.15, "timestamp": "00:54:42", "text": "良い。もう姿を消すのをやめてくれませんか？"}, {"type": "subtitle", "time": 3285.829, "timestamp": "00:54:45", "text": "イエス・キリスト。ごめん。"}, {"type": "subtitle", "time": 3290.069, "timestamp": "00:54:50", "text": "そうそう。ああ、わかりました。ゆっくり進めましょう"}, {"type": "subtitle", "time": 3294.23, "timestamp": "00:54:54", "text": "それから？大丈夫。私はただ速く動いているだけです"}, {"type": "subtitle", "time": 3296.47, "timestamp": "00:54:56", "text": "泣きたくないから、"}, {"type": "subtitle", "time": 3298.79, "timestamp": "00:54:58", "text": "私？"}]
[{"type": "subtitle", "time": 18976.31, "timestamp": "05:16:16", "text": "でもこのカンフーパンダの男は。何てことだ。"}, {"type": "subtitle", "time": 18990.07, "timestamp": "05:16:30", "text": "彼を発明した奴は死ぬべきだ。ここ"}, {"type": "subtitle", "time": 18992.868, "timestamp": "05:16:32", "text": "彼らは来る。"}, {"type": "subtitle", "time": 19006.07, "timestamp": "05:16:46", "text": "これは難しい。私を落ち込ませることはできない"}]
[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "ここで私たちは演奏します"}, {"type": "subtitle", "time": 1865.71, "timestamp": "00:31:05", "text": "戻る。では、待ってください。"}, {"type": "chat", "time": 1869.3, "timestamp": "00:31:09", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "back when joq used to horror"}, {"type": "chat", "time": 1871.886, "timestamp": "00:31:11", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "good times"}, {"type": "subtitle", "time": 1874.87, "timestamp": "00:31:14", "text": "私は自分の配信者ではなかったか？さあ行こう。で"}, {"type": "subtitle", "time": 1889.59, "timestamp": "00:31:29", "text": "わかったよ、ジョン。私たち二人は一緒に、"}, {"type": "chat", "time": 1890.26, "timestamp": "00:31:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "私たちはまるで画面の中を飛び回っているかのようだ。"}, {"type": "subtitle", "time": 1895.11, "timestamp": "00:31:35", "text": "それについてどう思いますか？ズームインして"}, {"type": "subtitle", "time": 1897.83, "timestamp": "00:31:37", "text": "で"}, {"type": "subtitle", "time": 1899.43, "timestamp": "00:31:39", "text": "私の配信を視聴できます"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "欲しい。あ、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 1909.59, "timestamp": "00:31:49", "text": "[音楽]"}, {"type": "subtitle", "time": 1913.389, "timestamp": "00:31:53", "text": "うん、動き回ってたんだけど、"}]
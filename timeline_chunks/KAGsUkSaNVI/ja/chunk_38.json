[{"type": "subtitle", "time": 2282.03, "timestamp": "00:38:02", "text": "ええ、今追加しました"}, {"type": "subtitle", "time": 2286.47, "timestamp": "00:38:06", "text": "アバターみたいな"}, {"type": "subtitle", "time": 2288.43, "timestamp": "00:38:08", "text": "ワークショップ。"}, {"type": "subtitle", "time": 2291.03, "timestamp": "00:38:11", "text": "はい。しかし、それはあなたが"}, {"type": "subtitle", "time": 2294.0, "timestamp": "00:38:14", "text": "ドウェイン・ザ・ラブ・ジョンソンと呼んでもいいですよ。"}, {"type": "subtitle", "time": 2297.03, "timestamp": "00:38:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2304.349, "timestamp": "00:38:24", "text": "どうすればそんな風になれるのか"}, {"type": "subtitle", "time": 2308.15, "timestamp": "00:38:28", "text": "どうやって手に入れるか、たぶん。"}, {"type": "subtitle", "time": 2310.63, "timestamp": "00:38:30", "text": "ええ、動物関係のこととか、そういうこと全部です。私"}, {"type": "subtitle", "time": 2314.31, "timestamp": "00:38:34", "text": "どうやってそれらを入手するのか分かりません"}, {"type": "subtitle", "time": 2316.19, "timestamp": "00:38:36", "text": "肌と"}, {"type": "subtitle", "time": 2320.15, "timestamp": "00:38:40", "text": "毎日このゲームをプレイしてるよ。"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "いいえ。何ですか？待って。まるで私がこれを演奏しているように聞こえる"}, {"type": "subtitle", "time": 2329.75, "timestamp": "00:38:49", "text": "毎日ゲームをする。何？"}, {"type": "subtitle", "time": 2332.23, "timestamp": "00:38:52", "text": "いや、いや、いや。私が"}, {"type": "subtitle", "time": 2334.24, "timestamp": "00:38:54", "text": "毎日このゲームをプレイしてください。"}, {"type": "subtitle", "time": 2335.75, "timestamp": "00:38:55", "text": "[音楽]"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "わかった。私はゲームを始めた。はい。うん。"}]
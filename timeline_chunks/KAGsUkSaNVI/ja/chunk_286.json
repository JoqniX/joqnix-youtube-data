[{"type": "subtitle", "time": 17170.39, "timestamp": "04:46:10", "text": "テレビの音量を下げてください。ああ、そこに行くよ"}, {"type": "subtitle", "time": 17173.19, "timestamp": "04:46:13", "text": "翻訳を下げてください。私の家族は"}, {"type": "subtitle", "time": 17182.03, "timestamp": "04:46:22", "text": "わかった。 1秒。私に"}, {"type": "subtitle", "time": 17184.75, "timestamp": "04:46:24", "text": "少し。どうすればいいですか"}, {"type": "subtitle", "time": 17206.75, "timestamp": "04:46:46", "text": "こんにちは。"}, {"type": "subtitle", "time": 17209.47, "timestamp": "04:46:49", "text": "えっと、私は"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "戻る。すぐ戻るよ、行かなきゃいけないから"}, {"type": "subtitle", "time": 17215.27, "timestamp": "04:46:55", "text": "学校。こんにちは、ギャンブ。えっと、どう思いますか？"}, {"type": "subtitle", "time": 17218.83, "timestamp": "04:46:58", "text": "また日本語で学校に通うことになった。"}]
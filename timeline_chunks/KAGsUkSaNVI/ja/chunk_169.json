[{"type": "subtitle", "time": 10149.63, "timestamp": "02:49:09", "text": "うん。私は寝たの？"}, {"type": "subtitle", "time": 10153.87, "timestamp": "02:49:13", "text": "早い？ああ、それから夕食をとるために、"}, {"type": "subtitle", "time": 10156.55, "timestamp": "02:49:16", "text": "右？私がやりたいことはただ一つ、"}, {"type": "subtitle", "time": 10158.95, "timestamp": "02:49:18", "text": "右？ BRBに切り替えるたびに、"}, {"type": "subtitle", "time": 10162.63, "timestamp": "02:49:22", "text": "タイムスタンプを付けておけば、もっと分かりやすいです。いいえ、私は"}, {"type": "subtitle", "time": 10166.23, "timestamp": "02:49:26", "text": "V を通じて探していたので、BRB に行きました"}, {"type": "subtitle", "time": 10174.95, "timestamp": "02:49:34", "text": "この墓のような世界を探し求めて"}]
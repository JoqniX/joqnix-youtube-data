[{"type": "subtitle", "time": 480.469, "timestamp": "00:08:00", "text": "君はそれをスポーツマンのあれと呼ぶ"}, {"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "活動状態とすべての正しい"}, {"type": "subtitle", "time": 485.95, "timestamp": "00:08:05", "text": "私たちは今その物事の現状をどう考えているのか"}, {"type": "subtitle", "time": 489.79, "timestamp": "00:08:09", "text": "それらはもうなくなりました"}, {"type": "subtitle", "time": 493.95, "timestamp": "00:08:13", "text": "行ってしまった、私たちはその声を失ったが、私は大丈夫"}, {"type": "subtitle", "time": 497.43, "timestamp": "00:08:17", "text": "ほとんどがvだったと思うので大丈夫です"}, {"type": "subtitle", "time": 500.909, "timestamp": "00:08:20", "text": "寝ていたので気にしません"}, {"type": "subtitle", "time": 504.469, "timestamp": "00:08:24", "text": "5月に。私はできると分かっています"}, {"type": "subtitle", "time": 507.52, "timestamp": "00:08:27", "text": "同じことですよね？のように"}, {"type": "subtitle", "time": 509.23, "timestamp": "00:08:29", "text": "[音楽]"}, {"type": "subtitle", "time": 512.5889999999999, "timestamp": "00:08:32", "text": "えっと、私がそうしたいと思ったら配信を終了します"}, {"type": "subtitle", "time": 515.829, "timestamp": "00:08:35", "text": "睡眠とか、その他すべて。私はできると分かっています"}, {"type": "subtitle", "time": 516.909, "timestamp": "00:08:36", "text": "する"}, {"type": "subtitle", "time": 520.87, "timestamp": "00:08:40", "text": "そうだけど、よくわからない。私たちは"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "訪問とかそういうこと。とても痛いだろう"}, {"type": "subtitle", "time": 526.87, "timestamp": "00:08:46", "text": "あまり使わない場合。私たちは"}, {"type": "subtitle", "time": 530.269, "timestamp": "00:08:50", "text": "ここでは30日間について話している。 31日間"}, {"type": "subtitle", "time": 533.75, "timestamp": "00:08:53", "text": "ここ。だから、ある意味では私はそれでいいと思う"}, {"type": "subtitle", "time": 534.9, "timestamp": "00:08:54", "text": "VODを保持する"}, {"type": "subtitle", "time": 536.35, "timestamp": "00:08:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "わかったよ。それで、それはどこで見つけたんですか？"}, {"type": "subtitle", "time": 4504.63, "timestamp": "01:15:04", "text": "ここにあります。ちょっと待ってください。そのその"}, {"type": "subtitle", "time": 4507.11, "timestamp": "01:15:07", "text": "テーブル。こちらのテーブル。"}, {"type": "subtitle", "time": 4510.35, "timestamp": "01:15:10", "text": "ここにあります。それが仕事なんです。全て"}, {"type": "subtitle", "time": 4513.669, "timestamp": "01:15:13", "text": "右。ああ、5時35分。だから、私たちは"}, {"type": "subtitle", "time": 4515.99, "timestamp": "01:15:15", "text": "時計とプットプットそれプット私たちは"}, {"type": "subtitle", "time": 4518.709, "timestamp": "01:15:18", "text": "5時35分くらいに設定する必要がある。"}, {"type": "subtitle", "time": 4521.03, "timestamp": "01:15:21", "text": "では、ここが"}, {"type": "subtitle", "time": 4531.189, "timestamp": "01:15:31", "text": "ニース。あらら。おい。こんにちは、今行きます。"}, {"type": "subtitle", "time": 4533.43, "timestamp": "01:15:33", "text": "TJに行きます。今行ってる。行くよ"}, {"type": "subtitle", "time": 4536.149, "timestamp": "01:15:36", "text": "あなたへ。冗談だろ、おい。来る"}, {"type": "subtitle", "time": 4538.31, "timestamp": "01:15:38", "text": "の上。どこかに行って。臭いよ。どこ？どこ"}, {"type": "subtitle", "time": 4539.149, "timestamp": "01:15:39", "text": "それ"}, {"type": "subtitle", "time": 4542.47, "timestamp": "01:15:42", "text": "また？えっと、あ、待って。私は"}, {"type": "subtitle", "time": 4546.149, "timestamp": "01:15:46", "text": "死にかけている。私は死にかけている。ねえ、見て。あなた あなた"}, {"type": "subtitle", "time": 4548.95, "timestamp": "01:15:48", "text": "友達を助けることができない。ヘルプ。ヘルプ。その"}, {"type": "subtitle", "time": 4551.75, "timestamp": "01:15:51", "text": "わかった。その男は無視すればいい。"}, {"type": "subtitle", "time": 4554.149, "timestamp": "01:15:54", "text": "ええ、彼はただ"}, {"type": "subtitle", "time": 4558.31, "timestamp": "01:15:58", "text": "ああ、そうだね。ドアを閉めてください。閉じる。えっと、彼は"}]
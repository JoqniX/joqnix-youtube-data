[{"type": "subtitle", "time": 14522.15, "timestamp": "04:02:02", "text": "衝撃的な接触は拡大させてはならない"}, {"type": "subtitle", "time": 14525.83, "timestamp": "04:02:05", "text": "さらに遠く。残り時間はわずか60秒。"}, {"type": "subtitle", "time": 14529.59, "timestamp": "04:02:09", "text": "おお、素敵な動きですね？"}, {"type": "subtitle", "time": 14536.59, "timestamp": "04:02:16", "text": "素晴らしい"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "スパイダーマンは君には手に負えないほど粘着質だ。"}, {"type": "subtitle", "time": 14553.189, "timestamp": "04:02:33", "text": "彼らの行く手を阻めろ。"}, {"type": "subtitle", "time": 14559.51, "timestamp": "04:02:39", "text": "今回はもっとうまくやらなきゃ。あげられない"}]
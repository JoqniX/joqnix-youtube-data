[{"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "順調に推移している。えっと、人々は私に"}, {"type": "subtitle", "time": 1935.029, "timestamp": "00:32:15", "text": "質問。アニメを観たことはありますか？"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "最近？ああ、私はちょうど見ていたところ"}, {"type": "subtitle", "time": 1941.59, "timestamp": "00:32:21", "text": "夕食を食べながらアニメを見る。"}, {"type": "subtitle", "time": 1945.549, "timestamp": "00:32:25", "text": "どんなアニメですか？ええと、それは"}, {"type": "subtitle", "time": 1948.19, "timestamp": "00:32:28", "text": "シャイ。それは"}, {"type": "subtitle", "time": 1951.029, "timestamp": "00:32:31", "text": "シャイ。そして"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "このアニメーションが大好きです。私はこれが大好きです"}, {"type": "subtitle", "time": 1956.95, "timestamp": "00:32:36", "text": "冒頭のカットシーン。これ大好き。参加します"}, {"type": "subtitle", "time": 1960.07, "timestamp": "00:32:40", "text": "これが大好きです。"}, {"type": "subtitle", "time": 1969.19, "timestamp": "00:32:49", "text": "うまくいってないけど、まあ、"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "今もなお傑作である。はい、私です"}, {"type": "subtitle", "time": 1974.19, "timestamp": "00:32:54", "text": "推測。"}, {"type": "subtitle", "time": 1977.59, "timestamp": "00:32:57", "text": "GPUをインストールしているところが気に入っています"}]
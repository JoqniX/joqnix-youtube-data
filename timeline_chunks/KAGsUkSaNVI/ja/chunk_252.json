[{"type": "subtitle", "time": 15147.75, "timestamp": "04:12:27", "text": "ヒーローか悪役かを選んでください。私は違います"}, {"type": "subtitle", "time": 15150.229, "timestamp": "04:12:30", "text": "審査する。"}, {"type": "subtitle", "time": 15152.309, "timestamp": "04:12:32", "text": "圧力が高いほど、"}, {"type": "subtitle", "time": 15154.89, "timestamp": "04:12:34", "text": "ダイヤモンドを輝かせる。"}, {"type": "subtitle", "time": 15169.25, "timestamp": "04:12:49", "text": "ホーの漫画。"}]
[{"type": "subtitle", "time": 15363.429, "timestamp": "04:16:03", "text": "ミッションの半分以上を撮影しました"}, {"type": "subtitle", "time": 15382.149, "timestamp": "04:16:22", "text": "アイアンマン、私も一緒に行くよ"}, {"type": "subtitle", "time": 15390.229, "timestamp": "04:16:30", "text": "ああ、それは深すぎた。"}, {"type": "subtitle", "time": 15399.349, "timestamp": "04:16:39", "text": "ごめん。実は、私は勝っているんです。"}]
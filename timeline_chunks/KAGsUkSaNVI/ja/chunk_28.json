[{"type": "subtitle", "time": 1680.99, "timestamp": "00:28:00", "text": "見てください"}, {"type": "subtitle", "time": 1683.99, "timestamp": "00:28:03", "text": "これ。彼女は、ええと、二人とも"}, {"type": "subtitle", "time": 1687.99, "timestamp": "00:28:07", "text": "これに合わせて彼ら自身のシングルもリリースされる。"}, {"type": "subtitle", "time": 1690.71, "timestamp": "00:28:10", "text": "彼女は悲しみや孤独を描写し、"}, {"type": "subtitle", "time": 1694.31, "timestamp": "00:28:14", "text": "痛みや苦しみを描写し、"}, {"type": "subtitle", "time": 1697.149, "timestamp": "00:28:17", "text": "心、平和、喜び、"}, {"type": "subtitle", "time": 1702.71, "timestamp": "00:28:22", "text": "幸せ、悲しい、幸せ、悲しい、幸せ、悲しい、"}, {"type": "subtitle", "time": 1705.72, "timestamp": "00:28:25", "text": "幸せ、悲しい、幸せ、悲しい、 ハッピー。全て"}, {"type": "subtitle", "time": 1707.88, "timestamp": "00:28:27", "text": "ハッピー。全て そうですね、それは良い考えですよね？しかし"}, {"type": "chat", "time": 1715.899, "timestamp": "00:28:35", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "well lmao, i hate happiness then"}, {"type": "chat", "time": 1721.126, "timestamp": "00:28:41", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "AND sadness too"}]
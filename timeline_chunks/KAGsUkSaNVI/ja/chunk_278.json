[{"type": "subtitle", "time": 16680.8, "timestamp": "04:38:00", "text": "接合？うん。"}, {"type": "subtitle", "time": 16701.109, "timestamp": "04:38:21", "text": "[音楽]"}, {"type": "subtitle", "time": 16704.39, "timestamp": "04:38:24", "text": "アバター。わかった。わかった。ブラは参加しません。"}, {"type": "subtitle", "time": 16705.709, "timestamp": "04:38:25", "text": "それで、"}, {"type": "subtitle", "time": 16710.949, "timestamp": "04:38:30", "text": "えーと、クロノ、クロノ、あなたは"}, {"type": "subtitle", "time": 16712.949, "timestamp": "04:38:32", "text": "少し。"}, {"type": "subtitle", "time": 16738.109, "timestamp": "04:38:58", "text": "右。よし、私は"}]
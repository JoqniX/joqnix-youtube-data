[{"type": "subtitle", "time": 19517.59, "timestamp": "05:25:17", "text": "君がやりたいのを見たよ。うん、新しい"}, {"type": "subtitle", "time": 19519.91, "timestamp": "05:25:19", "text": "開発中のモデルです。私はこれをやっています"}, {"type": "subtitle", "time": 19522.868, "timestamp": "05:25:22", "text": "ジョッカソンはデビューをクラウドファンディングで資金調達する"}, {"type": "subtitle", "time": 19525.788, "timestamp": "05:25:25", "text": "あれ。本当に"}, {"type": "subtitle", "time": 19528.07, "timestamp": "05:25:28", "text": "高価ですが、新しいモデルがあります"}, {"type": "subtitle", "time": 19529.91, "timestamp": "05:25:29", "text": "作品。ということで、私たちはストリーミング配信をしています"}, {"type": "subtitle", "time": 19533.27, "timestamp": "05:25:33", "text": "毎日24時間連続で"}, {"type": "subtitle", "time": 19535.83, "timestamp": "05:25:35", "text": "3ヶ月。今日。これで今月になります"}, {"type": "subtitle", "time": 19555.34, "timestamp": "05:25:55", "text": "もの。ああ、エマ・フロスト。絶妙"}]
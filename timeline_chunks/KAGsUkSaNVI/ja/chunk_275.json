[{"type": "subtitle", "time": 16509.22, "timestamp": "04:35:09", "text": "ああ。ああ、私はとても"}, {"type": "subtitle", "time": 16526.07, "timestamp": "04:35:26", "text": "自分。私はそれを持っていません。私"}, {"type": "subtitle", "time": 16528.91, "timestamp": "04:35:28", "text": "アクティビティステータスを設定するのを忘れていました"}, {"type": "subtitle", "time": 16532.519, "timestamp": "04:35:32", "text": "一般公開されています。"}]
[{"type": "subtitle", "time": 16142.389, "timestamp": "04:29:02", "text": "彼らはほぼ成功している。"}, {"type": "subtitle", "time": 16144.87, "timestamp": "04:29:04", "text": "無駄だ。まあ、少なくとも私の矢筒は"}, {"type": "subtitle", "time": 16146.87, "timestamp": "04:29:06", "text": "補充しました。"}, {"type": "subtitle", "time": 16168.229, "timestamp": "04:29:28", "text": "[拍手]"}, {"type": "subtitle", "time": 16174.63, "timestamp": "04:29:34", "text": "それ。私は感受性が高すぎる。"}, {"type": "subtitle", "time": 16177.59, "timestamp": "04:29:37", "text": "ホークアイ。"}, {"type": "subtitle", "time": 16182.149, "timestamp": "04:29:42", "text": "私は1001なんとかに乗っています。"}, {"type": "subtitle", "time": 16184.95, "timestamp": "04:29:44", "text": "毎回の試合で、私は自分にこう言い聞かせる。行くかもしれない"}, {"type": "subtitle", "time": 16196.07, "timestamp": "04:29:56", "text": "知ってるでしょ、私のDPRは11,000なんだよ。"}]
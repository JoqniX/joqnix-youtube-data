[{"type": "subtitle", "time": 19226.948, "timestamp": "05:20:26", "text": "何てことだ。"}, {"type": "subtitle", "time": 19230.708, "timestamp": "05:20:30", "text": "エマ・フロストは決して諦めない。"}, {"type": "subtitle", "time": 19235.03, "timestamp": "05:20:35", "text": "その通り。彼女は決してそうしない。"}, {"type": "subtitle", "time": 19236.99, "timestamp": "05:20:36", "text": "待って、エマ・フロストって誰？"}, {"type": "subtitle", "time": 19250.47, "timestamp": "05:20:50", "text": "X-メン。誰が来たか見てごらん。"}]
[{"type": "subtitle", "time": 12781.11, "timestamp": "03:33:01", "text": "左。それを再び動かしてください。私は"}, {"type": "subtitle", "time": 12783.83, "timestamp": "03:33:03", "text": "これのどれかを探しています。目を覚ましてください"}, {"type": "subtitle", "time": 12795.269, "timestamp": "03:33:15", "text": "時間がかかればかかるほど、無効"}, {"type": "subtitle", "time": 12817.75, "timestamp": "03:33:37", "text": "そして、そのまま伏せたままでいてください。"}, {"type": "subtitle", "time": 12824.309, "timestamp": "03:33:44", "text": "あなたはどこにも行かない。私たちは勝った、私は"}]
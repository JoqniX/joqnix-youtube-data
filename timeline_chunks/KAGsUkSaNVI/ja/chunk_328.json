[{"type": "subtitle", "time": 19687.31, "timestamp": "05:28:07", "text": "ロキ、みんなに「いいね」をあげるのを忘れてたよ"}, {"type": "subtitle", "time": 19698.548, "timestamp": "05:28:18", "text": "大丈夫。情熱的に語り合えますか？これは何ですか"}, {"type": "subtitle", "time": 19701.75, "timestamp": "05:28:21", "text": "について？私は見知らぬ人とは話さない"}, {"type": "subtitle", "time": 19703.948, "timestamp": "05:28:23", "text": "そんな感じ。"}, {"type": "subtitle", "time": 19706.868, "timestamp": "05:28:26", "text": "嫌な経験をした。だから私は"}, {"type": "subtitle", "time": 19707.788, "timestamp": "05:28:27", "text": "本当に"}, {"type": "subtitle", "time": 19710.31, "timestamp": "05:28:30", "text": "注意深い。それはどんな内容ですか？何が"}, {"type": "subtitle", "time": 19712.868, "timestamp": "05:28:32", "text": "これはビジネスに関する話ですか？何が"}, {"type": "subtitle", "time": 19714.11, "timestamp": "05:28:34", "text": "これ"}, {"type": "subtitle", "time": 19718.39, "timestamp": "05:28:38", "text": "について？えっと、もしあなたが尋ねに来るなら"}, {"type": "subtitle", "time": 19720.23, "timestamp": "05:28:40", "text": "委託またはあなたが"}, {"type": "subtitle", "time": 19723.59, "timestamp": "05:28:43", "text": "アーティストか何か、私は受け取らない"}, {"type": "subtitle", "time": 19725.83, "timestamp": "05:28:45", "text": "何でも、私は自分の物を持っているから"}, {"type": "subtitle", "time": 19729.91, "timestamp": "05:28:49", "text": "既に予約済みです。そう、私は"}, {"type": "subtitle", "time": 19733.99, "timestamp": "05:28:53", "text": "えっと、Twitchをたくさん見てたから言ってるだけ"}, {"type": "subtitle", "time": 19739.23, "timestamp": "05:28:59", "text": "ペ・ウ・GFスポーツのコメント。えっと、もし"}]
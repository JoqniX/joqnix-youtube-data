[{"type": "subtitle", "time": 5462.39, "timestamp": "01:31:02", "text": "鏡。覚えてますか？"}, {"type": "subtitle", "time": 5465.03, "timestamp": "01:31:05", "text": "不気味なドアを見たかどうか覚えておいてください"}, {"type": "subtitle", "time": 5467.03, "timestamp": "01:31:07", "text": "そこには？これで終わりにします。ああ、"}, {"type": "subtitle", "time": 5467.87, "timestamp": "01:31:07", "text": "の"}, {"type": "subtitle", "time": 5470.79, "timestamp": "01:31:10", "text": "ちなみに、ドアをテーブルに載せてください。大丈夫です。"}, {"type": "subtitle", "time": 5474.669, "timestamp": "01:31:14", "text": "わかった。あ、こっちです。どこにいるの？"}, {"type": "subtitle", "time": 5477.99, "timestamp": "01:31:17", "text": "どこ？私はまるで、"}, {"type": "subtitle", "time": 5480.149, "timestamp": "01:31:20", "text": "うんちが出てくる。うん。良い。良い。"}, {"type": "subtitle", "time": 5482.55, "timestamp": "01:31:22", "text": "良い。良い。うん。ここに来て。ここに来て。"}, {"type": "subtitle", "time": 5485.669, "timestamp": "01:31:25", "text": "まっすぐこちらへ。鏡が割れている"}, {"type": "subtitle", "time": 5488.03, "timestamp": "01:31:28", "text": "こちらです。"}, {"type": "subtitle", "time": 5491.47, "timestamp": "01:31:31", "text": "ああ、やあ。調子はどう？ああ、"}, {"type": "subtitle", "time": 5494.149, "timestamp": "01:31:34", "text": "ああ、あのガキどもめ。逃げないで"}, {"type": "subtitle", "time": 5501.189, "timestamp": "01:31:41", "text": "ジョンさん、あなたはどこにいるのですか？そうそう。以上"}, {"type": "subtitle", "time": 5503.99, "timestamp": "01:31:43", "text": "ここ。こちらです。必ず捕まえてやる。だから私たちは"}, {"type": "subtitle", "time": 5512.99, "timestamp": "01:31:52", "text": "青いヒューズがあります。として"}, {"type": "chat", "time": 5515.996, "timestamp": "01:31:55", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "me coming back"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "茶色の車両。通気口があります"}, {"type": "subtitle", "time": 5519.59, "timestamp": "01:31:59", "text": "開ける。はい。待って、"}]
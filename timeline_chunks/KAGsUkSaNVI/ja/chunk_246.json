[{"type": "subtitle", "time": 14768.71, "timestamp": "04:06:08", "text": "料理について。何てことだ。彼のお名前は？"}, {"type": "subtitle", "time": 14771.75, "timestamp": "04:06:11", "text": "アイアンフィスト。何てことだ。戻ってきたよ、ベイビー。"}, {"type": "subtitle", "time": 14774.229, "timestamp": "04:06:14", "text": "お前を殺しに行く。私を見ていてください。待って"}, {"type": "subtitle", "time": 14801.51, "timestamp": "04:06:41", "text": "待て、シールド。甘い。"}, {"type": "subtitle", "time": 14805.71, "timestamp": "04:06:45", "text": "ああ、兄弟、この銃。ああ、それは素晴らしい。"}, {"type": "subtitle", "time": 14809.269, "timestamp": "04:06:49", "text": "クム。 Fを取るべきか、それとも"}, {"type": "subtitle", "time": 14810.87, "timestamp": "04:06:50", "text": "何か、"}]
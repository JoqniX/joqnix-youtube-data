[{"type": "subtitle", "time": 15730.67, "timestamp": "04:22:10", "text": "はぁ？うわー！私は決して"}, {"type": "subtitle", "time": 15735.11, "timestamp": "04:22:15", "text": "逃す。お客さんが来た。"}, {"type": "subtitle", "time": 15738.55, "timestamp": "04:22:18", "text": "触れることはできません。スパムメールを送れ。スナイパー。"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 15751.71, "timestamp": "04:22:31", "text": "彼はどこから来たのか？"}, {"type": "subtitle", "time": 15754.95, "timestamp": "04:22:34", "text": "チームは折り返し地点を過ぎた。エマの"}, {"type": "subtitle", "time": 15777.189, "timestamp": "04:22:57", "text": "まずは我々に勝利を与えてください。"}, {"type": "subtitle", "time": 15778.71, "timestamp": "04:22:58", "text": "君は戦い続けなければならない"}]
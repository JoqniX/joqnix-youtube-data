[{"type": "subtitle", "time": 3300.95, "timestamp": "00:55:00", "text": "よし、ここから出よう。えっと"}, {"type": "subtitle", "time": 3303.43, "timestamp": "00:55:03", "text": "検問所はどこですか？ええと、ここから。"}, {"type": "subtitle", "time": 3304.67, "timestamp": "00:55:04", "text": "ああ、わかりました。以上"}, {"type": "subtitle", "time": 3313.91, "timestamp": "00:55:13", "text": "どこにいるの？わかった。この場所、私は"}, {"type": "subtitle", "time": 3318.15, "timestamp": "00:55:18", "text": "考える。この場所だと思う。これです"}, {"type": "subtitle", "time": 3320.95, "timestamp": "00:55:20", "text": "それほど多くは見つかりませんでした。そこで私たちは"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "あのVHSテープ。"}, {"type": "subtitle", "time": 3327.43, "timestamp": "00:55:27", "text": "ああ、ここは放射能汚染された場所だ。"}, {"type": "subtitle", "time": 3330.39, "timestamp": "00:55:30", "text": "右？なんてこった。そうなんですか？いいえ、私たちは戻ってきました。私たちは"}, {"type": "subtitle", "time": 3342.069, "timestamp": "00:55:42", "text": "私たちはまだガジを見つけていません。しないで"}, {"type": "subtitle", "time": 3345.75, "timestamp": "00:55:45", "text": "離れる。わかった。出産ではない。私にください 私にください"}, {"type": "subtitle", "time": 3349.109, "timestamp": "00:55:49", "text": "ちょっと待ってください。それは違う。来て。"}, {"type": "subtitle", "time": 3351.67, "timestamp": "00:55:51", "text": "君ほどひどくはないよ。若くはない"}, {"type": "subtitle", "time": 3353.51, "timestamp": "00:55:53", "text": "あなた。来て。"}, {"type": "subtitle", "time": 3356.43, "timestamp": "00:55:56", "text": "それはどういう意味ですか？私は若くない"}, {"type": "subtitle", "time": 3358.87, "timestamp": "00:55:58", "text": "けれど。わかった。そうではない。わかった。"}, {"type": "subtitle", "time": 3359.95, "timestamp": "00:55:59", "text": "これ"}]
[{"type": "subtitle", "time": 15483.91, "timestamp": "04:18:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15507.429, "timestamp": "04:18:27", "text": "君が住んでいた場所では、君のことを何て呼ぶんだい？"}, {"type": "subtitle", "time": 15510.99, "timestamp": "04:18:30", "text": "どこから来たの？ダーリン、太もも"}, {"type": "subtitle", "time": 15514.07, "timestamp": "04:18:34", "text": "あるいは、決してない。ダーリン、"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "あなたはもっとよく知っているはずだ。"}, {"type": "subtitle", "time": 15519.349, "timestamp": "04:18:39", "text": "あなたのスタイルが好きです。見つけてよかった"}, {"type": "subtitle", "time": 15523.51, "timestamp": "04:18:43", "text": "クーラへの道。トーンではないが、"}, {"type": "subtitle", "time": 15527.11, "timestamp": "04:18:47", "text": "セット。戦いは5分後に始まる。"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "3 2 1. 必要なのは、"}, {"type": "subtitle", "time": 15534.71, "timestamp": "04:18:54", "text": "任務地域。わかった。"}, {"type": "subtitle", "time": 15536.71, "timestamp": "04:18:56", "text": "世界がスーパーヒーローを必要としていなかったら、"}]
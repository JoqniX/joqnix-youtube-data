[{"type": "subtitle", "time": 7658.39, "timestamp": "02:07:38", "text": "これらのコマンドは機能すると思います"}, {"type": "subtitle", "time": 7661.189, "timestamp": "02:07:41", "text": "今、もしあなたが、もし誰かが"}, {"type": "subtitle", "time": 7664.629, "timestamp": "02:07:44", "text": "それを試すために。倍にしようと思う"}, {"type": "subtitle", "time": 7672.79, "timestamp": "02:07:52", "text": "その物なしで、名前、ジョーク、演技をしてください。はい、私は"}, {"type": "subtitle", "time": 7676.709, "timestamp": "02:07:56", "text": "大文字の B、大文字の T を壊すと思った、"}, {"type": "subtitle", "time": 7679.27, "timestamp": "02:07:59", "text": "この大文字"}]
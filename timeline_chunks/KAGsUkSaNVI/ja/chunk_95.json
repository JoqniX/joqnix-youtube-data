[{"type": "subtitle", "time": 5704.07, "timestamp": "01:35:04", "text": "今はどうでしょうか？始まった。始まった。その"}, {"type": "subtitle", "time": 5706.47, "timestamp": "01:35:06", "text": "の上。ニース。ニース。ニース。始まった。全て"}, {"type": "subtitle", "time": 5708.55, "timestamp": "01:35:08", "text": "右。さあ行こう。"}, {"type": "subtitle", "time": 5711.83, "timestamp": "01:35:11", "text": "ここに来て。防護服を着る。いいえ。"}, {"type": "subtitle", "time": 5715.11, "timestamp": "01:35:15", "text": "さあ行こう。消火器を持ってきた。そして"}, {"type": "subtitle", "time": 5717.11, "timestamp": "01:35:17", "text": "これがある。"}, {"type": "subtitle", "time": 5721.51, "timestamp": "01:35:21", "text": "今すぐ使ってもいいですか？はい、できますよ。私は"}, {"type": "subtitle", "time": 5725.43, "timestamp": "01:35:25", "text": "2、2。わかった。好きなだけ取ることができます"}, {"type": "subtitle", "time": 5727.59, "timestamp": "01:35:27", "text": "お望み通りに。"}, {"type": "subtitle", "time": 5729.709, "timestamp": "01:35:29", "text": "はい。欲しい"}, {"type": "subtitle", "time": 5733.95, "timestamp": "01:35:33", "text": "アーモンド。私はもう気が狂いそうなのか？私に"}, {"type": "subtitle", "time": 5737.59, "timestamp": "01:35:37", "text": "2番。私の安全薬はどこ？"}, {"type": "subtitle", "time": 5739.95, "timestamp": "01:35:39", "text": "ニース。では、次に"}, {"type": "subtitle", "time": 5742.709, "timestamp": "01:35:42", "text": "放射線。うん。不安を満たす"}, {"type": "subtitle", "time": 5745.669, "timestamp": "01:35:45", "text": "ピル。うん。こんにちは。反芻動物。"}, {"type": "subtitle", "time": 5750.229, "timestamp": "01:35:50", "text": "ええ、そうですね。はい。さあ行こう。"}, {"type": "subtitle", "time": 5752.229, "timestamp": "01:35:52", "text": "あちらにもう1つあります。私は折りたたむ"}, {"type": "subtitle", "time": 5755.03, "timestamp": "01:35:55", "text": "不安を和らげる薬をニキビに。わかった。あなた"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "それを満たした。わかった。私もそれをいただきます。"}]
[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "スウィーニー。わかった。ええと、ティム・クック。私はしません"}, {"type": "subtitle", "time": 7515.91, "timestamp": "02:05:15", "text": "よし、これをさっとやって、"}, {"type": "subtitle", "time": 7525.709, "timestamp": "02:05:25", "text": "無料。待って、スポーツマンの夢"}, {"type": "subtitle", "time": 7528.51, "timestamp": "02:05:28", "text": "すでに"}, {"type": "subtitle", "time": 7531.149, "timestamp": "02:05:31", "text": "もの。ジョックは"}]
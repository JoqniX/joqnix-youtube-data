[{"type": "subtitle", "time": 361.67, "timestamp": "00:06:01", "text": "月と、私たちが 7 月を始めるとき"}, {"type": "subtitle", "time": 363.629, "timestamp": "00:06:03", "text": "それは"}, {"type": "subtitle", "time": 368.07, "timestamp": "00:06:08", "text": "80から100くらいまでやるよ"}, {"type": "subtitle", "time": 370.99, "timestamp": "00:06:10", "text": "100まで"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "100回はできないと思うけど"}, {"type": "subtitle", "time": 376.95, "timestamp": "00:06:16", "text": "うん、最高でも90か"}, {"type": "subtitle", "time": 380.43, "timestamp": "00:06:20", "text": "悲しいことに。でも大丈夫。その"}, {"type": "subtitle", "time": 384.309, "timestamp": "00:06:24", "text": "わかった。私が判断するまでヨアトンは終わらない"}, {"type": "subtitle", "time": 389.469, "timestamp": "00:06:29", "text": "ある意味で終わらせる必要があるんだよ。"}, {"type": "subtitle", "time": 392.30899999999997, "timestamp": "00:06:32", "text": "えっと、まだ決めてないんだけど"}, {"type": "subtitle", "time": 394.83, "timestamp": "00:06:34", "text": "後にすべきこと"}, {"type": "subtitle", "time": 396.749, "timestamp": "00:06:36", "text": "仕事。"}, {"type": "subtitle", "time": 406.87, "timestamp": "00:06:46", "text": "S. でも、今日は私がプレイするもの"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "マーベル・ライバルズ。今ダウンロードしました。私"}, {"type": "subtitle", "time": 411.67, "timestamp": "00:06:51", "text": "私はただそのゲームがどうなるか見てみたいだけです"}, {"type": "subtitle", "time": 413.51, "timestamp": "00:06:53", "text": "作品。うまくいかなければ、"}, {"type": "subtitle", "time": 416.07, "timestamp": "00:06:56", "text": "アンインストールしてください。写真コラボを"}, {"type": "subtitle", "time": 417.30899999999997, "timestamp": "00:06:57", "text": "する"}]
[{"type": "subtitle", "time": 17222.19, "timestamp": "04:47:02", "text": "ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 17225.35, "timestamp": "04:47:05", "text": "忘れた。アニメを字幕付きで視聴する。あなたは学ぶ。私"}, {"type": "subtitle", "time": 17227.43, "timestamp": "04:47:07", "text": "そうしてください。うん。"}, {"type": "subtitle", "time": 17231.11, "timestamp": "04:47:11", "text": "こんにちは、ロミオです。"}, {"type": "subtitle", "time": 17233.27, "timestamp": "04:47:13", "text": "ちょっと立ち寄ってみます。長い間"}, {"type": "subtitle", "time": 17235.07, "timestamp": "04:47:15", "text": "君を見たよ。"}, {"type": "subtitle", "time": 17242.03, "timestamp": "04:47:22", "text": "運。こんにちは。"}, {"type": "subtitle", "time": 17279.15, "timestamp": "04:47:59", "text": "こんにちは。良い"}]
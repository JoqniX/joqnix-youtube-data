[{"type": "subtitle", "time": 13577.469, "timestamp": "03:46:17", "text": "[音楽]"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "この試合に勝つには、一流のチームが必要だ"}, {"type": "subtitle", "time": 13598.55, "timestamp": "03:46:38", "text": "誰かが銀河を守らなければならない。かもしれない"}, {"type": "subtitle", "time": 13616.15, "timestamp": "03:46:56", "text": "歩く。スターロードは簡単だと思う"}]
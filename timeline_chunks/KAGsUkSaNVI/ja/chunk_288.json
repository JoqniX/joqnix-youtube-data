[{"type": "subtitle", "time": 17297.22, "timestamp": "04:48:17", "text": "こんにちは、"}, {"type": "subtitle", "time": 17304.75, "timestamp": "04:48:24", "text": "ケン。うん。"}, {"type": "subtitle", "time": 17308.23, "timestamp": "04:48:28", "text": "こんにちは。えっと、行く前に聞きたいのですが、"}, {"type": "subtitle", "time": 17311.11, "timestamp": "04:48:31", "text": "テイトはまだ投稿してるの？ええ、彼はそうしますよ。彼はそうする。"}, {"type": "subtitle", "time": 17314.35, "timestamp": "04:48:34", "text": "彼は毎週土曜日に配信している"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "おそらく。アイドルが撮影し、"}, {"type": "subtitle", "time": 17319.99, "timestamp": "04:48:39", "text": "格闘ゲームとか。だから、だから、だから"}, {"type": "subtitle", "time": 17322.31, "timestamp": "04:48:42", "text": "州は投稿する。うん。うん。うん。する"}, {"type": "subtitle", "time": 17325.31, "timestamp": "04:48:45", "text": "彼のチャンネルをチェックした？ええ、彼はそうします"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "役職。彼はTwitterの方が活発に活動している。もし"}, {"type": "subtitle", "time": 17330.47, "timestamp": "04:48:50", "text": "Twitter をお持ちでしたら、フォローしてください。"}, {"type": "subtitle", "time": 17332.948, "timestamp": "04:48:52", "text": "Twitter で、もっと多くのことを保存して、もっと"}, {"type": "subtitle", "time": 17336.11, "timestamp": "04:48:56", "text": "彼の最新情報をお届けします。ええ、そうですね。"}]
[{"type": "subtitle", "time": 15842.95, "timestamp": "04:24:02", "text": "試合数"}, {"type": "subtitle", "time": 15845.83, "timestamp": "04:24:05", "text": "正気じゃない。私たちは本当に何回"}, {"type": "subtitle", "time": 15851.51, "timestamp": "04:24:11", "text": "ヒーローか悪役かを選んでください。私は違います"}, {"type": "subtitle", "time": 15858.71, "timestamp": "04:24:18", "text": "私はミュータント能力と小さな悪魔を宿している。"}, {"type": "subtitle", "time": 15895.67, "timestamp": "04:24:55", "text": "毎回の試合で私は自分にこう言う、"}, {"type": "subtitle", "time": 15899.51, "timestamp": "04:24:59", "text": "落ち込んでいるが、最後まで戦い抜くつもりだ。"}]
[{"type": "subtitle", "time": 420.39, "timestamp": "00:07:00", "text": "土曜日とヘルダイバーズが土曜日に"}, {"type": "subtitle", "time": 422.23, "timestamp": "00:07:02", "text": "良い。だから、私は地獄をダウンロードしなければならない"}, {"type": "subtitle", "time": 424.79, "timestamp": "00:07:04", "text": "ダイバー。今、私が持っているものの量は"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "ダウンロードとアンインストールを繰り返すのは非常識だ。"}, {"type": "subtitle", "time": 430.23, "timestamp": "00:07:10", "text": "それは無駄の無駄のように感じます"}, {"type": "subtitle", "time": 434.469, "timestamp": "00:07:14", "text": "えっと、時間かこれ。私はとても近い"}, {"type": "subtitle", "time": 439.07, "timestamp": "00:07:19", "text": "私の地理のことはああ、それは"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "疲れ果てた。そして、新しい月も始まりました。"}, {"type": "subtitle", "time": 448.51, "timestamp": "00:07:28", "text": "まあ、まあ"}, {"type": "subtitle", "time": 452.07, "timestamp": "00:07:32", "text": "ポップして、保管庫をアップロードします。"}, {"type": "subtitle", "time": 454.51, "timestamp": "00:07:34", "text": "これまでのところ、"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "完了、そして悲しいことに49日目のパート2"}, {"type": "subtitle", "time": 461.469, "timestamp": "00:07:41", "text": "ストリームには"}, {"type": "subtitle", "time": 465.029, "timestamp": "00:07:45", "text": "正式に消えました"}, {"type": "subtitle", "time": 466.11, "timestamp": "00:07:46", "text": "消えた"}, {"type": "subtitle", "time": 469.749, "timestamp": "00:07:49", "text": "録音は残っていない。なぜ"}, {"type": "subtitle", "time": 473.43, "timestamp": "00:07:53", "text": "私は20時間も配信したの？私たちがそれを作る"}, {"type": "subtitle", "time": 477.029, "timestamp": "00:07:57", "text": "そのストリームは私たちが何をするかを作っていた"}]
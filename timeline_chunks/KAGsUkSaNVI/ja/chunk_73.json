[{"type": "subtitle", "time": 4383.669, "timestamp": "01:13:03", "text": "亡くなった。あなたはどのように亡くなったのですか？ええ、ケーブル"}, {"type": "subtitle", "time": 4388.229, "timestamp": "01:13:08", "text": "そいつにひどく殴られた。彼は驚いて飛び上がった。ああ、私は"}, {"type": "subtitle", "time": 4389.95, "timestamp": "01:13:09", "text": "復活した。その"}, {"type": "subtitle", "time": 4392.95, "timestamp": "01:13:12", "text": "大丈夫。彼はまだここにいますか？私はただ"}, {"type": "subtitle", "time": 4396.07, "timestamp": "01:13:16", "text": "その男をからかう。"}, {"type": "subtitle", "time": 4402.27, "timestamp": "01:13:22", "text": "ここ？わかった。ええ、私は自分の"}, {"type": "subtitle", "time": 4406.07, "timestamp": "01:13:26", "text": "錠剤。ありがとう、相棒。どこにいるの？"}, {"type": "subtitle", "time": 4407.95, "timestamp": "01:13:27", "text": "私はただからかっているだけです"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "男。これが、からかっても構わないということだ。"}, {"type": "subtitle", "time": 4415.51, "timestamp": "01:13:35", "text": "でも、あなたはどこにいるの？ああ、私は"}, {"type": "subtitle", "time": 4419.03, "timestamp": "01:13:39", "text": "この辺りのどこか。"}, {"type": "subtitle", "time": 4422.07, "timestamp": "01:13:42", "text": "Kがどこで撃たれたのかは知らない。"}, {"type": "subtitle", "time": 4424.229, "timestamp": "01:13:44", "text": "わかった。私はメインロビーにいます。私は"}, {"type": "subtitle", "time": 4426.79, "timestamp": "01:13:46", "text": "ドア。私はドアを開けた。ああ、それはとても"}, {"type": "subtitle", "time": 4429.59, "timestamp": "01:13:49", "text": "楽しい。わかった。うん。待って。近日公開。私は"}, {"type": "subtitle", "time": 4431.43, "timestamp": "01:13:51", "text": "来るよ。"}, {"type": "subtitle", "time": 4434.63, "timestamp": "01:13:54", "text": "とにかく、必ず君を見つけ出すよ。"}, {"type": "subtitle", "time": 4438.79, "timestamp": "01:13:58", "text": "私はドアの近くにいます。私はドアの前にいます。"}]
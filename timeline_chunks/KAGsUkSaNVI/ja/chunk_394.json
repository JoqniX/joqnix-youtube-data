[{"type": "subtitle", "time": 23676.35, "timestamp": "06:34:36", "text": "何が起こったのか？ああ、私は"}, {"type": "subtitle", "time": 23678.628, "timestamp": "06:34:38", "text": "禁止された？ビリー、ビリー、何が問題なの？"}, {"type": "subtitle", "time": 23686.548, "timestamp": "06:34:46", "text": "カテゴリ。ああ、システムメッセージですね。"}, {"type": "subtitle", "time": 23688.468, "timestamp": "06:34:48", "text": "どうでも。私は「一体どういうことだ」と思った。"}]
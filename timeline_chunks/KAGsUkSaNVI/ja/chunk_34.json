[{"type": "subtitle", "time": 2043.029, "timestamp": "00:34:03", "text": "ああ、大変だ。ただのPNG画像じゃないか。"}, {"type": "subtitle", "time": 2047.11, "timestamp": "00:34:07", "text": "すごい、それがまさにその理由です"}, {"type": "subtitle", "time": 2049.909, "timestamp": "00:34:09", "text": "黒い画面、ああ神様、あの"}, {"type": "subtitle", "time": 2051.669, "timestamp": "00:34:11", "text": "聞こえなくなってしまうので"}, {"type": "subtitle", "time": 2055.909, "timestamp": "00:34:15", "text": "でも、ただ再起動するだけです"}, {"type": "subtitle", "time": 2059.99, "timestamp": "00:34:19", "text": "すぐ行くから心配しないで、すぐ行くから"}, {"type": "subtitle", "time": 2062.149, "timestamp": "00:34:22", "text": "そうではありません"}, {"type": "subtitle", "time": 2064.149, "timestamp": "00:34:24", "text": "ああ、あなたがここにいなくても大丈夫です"}, {"type": "subtitle", "time": 2066.79, "timestamp": "00:34:26", "text": "ゲームに参加してほしいですか？"}, {"type": "subtitle", "time": 2073.909, "timestamp": "00:34:33", "text": "ゲーム、本当にごめんなさい。"}, {"type": "subtitle", "time": 2077.909, "timestamp": "00:34:37", "text": "そうそう。皆さん、お元気ですか？みんな。"}, {"type": "subtitle", "time": 2081.03, "timestamp": "00:34:41", "text": "うん。こんにちは、ブラッド。うん。こんにちは、マル。ああ。"}, {"type": "subtitle", "time": 2085.19, "timestamp": "00:34:45", "text": "本当に？ああ、なんてことだ。私はすでに"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "はしごがあって、Jはここにいません。それが"}, {"type": "subtitle", "time": 2090.869, "timestamp": "00:34:50", "text": "期待を裏切らなかった。"}, {"type": "subtitle", "time": 2093.589, "timestamp": "00:34:53", "text": "何てことだ。再起動すらしていない。おお"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "男。"}, {"type": "subtitle", "time": 2097.51, "timestamp": "00:34:57", "text": "本当に？"}]
[{"type": "subtitle", "time": 13031.269, "timestamp": "03:37:11", "text": "リンク。敵が到着した。これは"}, {"type": "subtitle", "time": 13044.389, "timestamp": "03:37:24", "text": "上。なんと大きな違いだろう。"}, {"type": "subtitle", "time": 13061.19, "timestamp": "03:37:41", "text": "あなたの名前が示すように冷酷で、"}, {"type": "subtitle", "time": 13079.99, "timestamp": "03:37:59", "text": "こんにちは、アストラ。何てことだ。ジャコ、君は"}]
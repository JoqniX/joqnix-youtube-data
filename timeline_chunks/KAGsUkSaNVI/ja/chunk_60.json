[{"type": "subtitle", "time": 3601.19, "timestamp": "01:00:01", "text": "我々には武器がない。の"}, {"type": "subtitle", "time": 3605.03, "timestamp": "01:00:05", "text": "あ、待って。 「ああ、そうだね」と書きました。待って。私は"}, {"type": "subtitle", "time": 3607.03, "timestamp": "01:00:07", "text": "おかわりはいかがですか？"}, {"type": "subtitle", "time": 3609.99, "timestamp": "01:00:09", "text": "えーと、私たちは、私たちは、"}, {"type": "subtitle", "time": 3611.589, "timestamp": "01:00:11", "text": "2番目のもののようなものではありません"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "方法。ええ、私たちも数秒必要です。"}, {"type": "subtitle", "time": 3619.91, "timestamp": "01:00:19", "text": "そう思います。それとやり取りすることはできません。"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "ちょっと待ってください。やってみましょう。"}, {"type": "subtitle", "time": 3623.15, "timestamp": "01:00:23", "text": "なぜ私は"}, {"type": "subtitle", "time": 3627.589, "timestamp": "01:00:27", "text": "私がやってるの？うん。 1人が動いた。そうそう。"}, {"type": "subtitle", "time": 3629.67, "timestamp": "01:00:29", "text": "そこには。ああ、もう十分だ。わかった。わかった。それ"}, {"type": "subtitle", "time": 3636.069, "timestamp": "01:00:36", "text": "ああ、それとやり取りするつもりだ"}, {"type": "subtitle", "time": 3637.829, "timestamp": "01:00:37", "text": "そこには。"}, {"type": "subtitle", "time": 3639.63, "timestamp": "01:00:39", "text": "交流する必要があると思います"}, {"type": "subtitle", "time": 3651.27, "timestamp": "01:00:51", "text": "ああ、わかった。わかった。さて、何て書いてあるの？"}]
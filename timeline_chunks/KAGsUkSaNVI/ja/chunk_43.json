[{"type": "subtitle", "time": 2581.27, "timestamp": "00:43:01", "text": "紫色の粘液は文字通り"}, {"type": "subtitle", "time": 2584.63, "timestamp": "00:43:04", "text": "ちなみに、心配すべき消費物"}, {"type": "subtitle", "time": 2587.109, "timestamp": "00:43:07", "text": "待って、それってどうやって手に入れるの？手に入れますか？"}, {"type": "subtitle", "time": 2589.03, "timestamp": "00:43:09", "text": "ゲーム？"}, {"type": "subtitle", "time": 2592.71, "timestamp": "00:43:12", "text": "実際、可能です。ああ、わかりました。ここに来て。"}, {"type": "subtitle", "time": 2595.43, "timestamp": "00:43:15", "text": "ラジオを持って行ってください。わかった。 1秒。来る"}, {"type": "subtitle", "time": 2598.39, "timestamp": "00:43:18", "text": "ここ。あなたは死んでいますか？ああ、イエス・キリスト。"}, {"type": "subtitle", "time": 2599.15, "timestamp": "00:43:19", "text": "私は"}, {"type": "subtitle", "time": 2603.51, "timestamp": "00:43:23", "text": "ごめん。今すぐ。あなたは死んでいますか？もちろん。"}, {"type": "subtitle", "time": 2605.67, "timestamp": "00:43:25", "text": "ああ、飲んで自殺する"}, {"type": "subtitle", "time": 2609.67, "timestamp": "00:43:29", "text": "アーモンドウォーター。アーモンド。なんて親切なの？"}, {"type": "subtitle", "time": 2611.87, "timestamp": "00:43:31", "text": "わかった。実在物"}, {"type": "subtitle", "time": 2614.23, "timestamp": "00:43:34", "text": "未知。それは細菌と呼ばれ、"}, {"type": "subtitle", "time": 2615.51, "timestamp": "00:43:35", "text": "道。君たちがなぜ"}, {"type": "subtitle", "time": 2618.589, "timestamp": "00:43:38", "text": "不明な発言。あなたたちはとても"}, {"type": "subtitle", "time": 2620.349, "timestamp": "00:43:40", "text": "バカ。"}, {"type": "subtitle", "time": 2623.67, "timestamp": "00:43:43", "text": "とにかく、ジャック、一緒に走ろうか？"}, {"type": "subtitle", "time": 2627.79, "timestamp": "00:43:47", "text": "ラジオを持って行ってください。ラジオを持って行ってください。"}, {"type": "subtitle", "time": 2630.39, "timestamp": "00:43:50", "text": "アイザックラジオ。"}, {"type": "subtitle", "time": 2634.87, "timestamp": "00:43:54", "text": "ジョックさん。はい、Yです。はい。待って、待って、"}, {"type": "subtitle", "time": 2637.27, "timestamp": "00:43:57", "text": "待って。私の声が聞こえないのか？こんにちは。こんにちは。"}, {"type": "subtitle", "time": 2638.88, "timestamp": "00:43:58", "text": "こんにちは。 私はそうは思わない。私はすべてを変えた"}]
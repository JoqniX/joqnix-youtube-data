[{"type": "subtitle", "time": 3906.39, "timestamp": "01:05:06", "text": "わかった。なぜここには死体が一つもないのですか？"}, {"type": "subtitle", "time": 3908.789, "timestamp": "01:05:08", "text": "あれ、ここじゃなかったっけ？これは"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "ちなみに、場所のことではありません。"}, {"type": "subtitle", "time": 3914.309, "timestamp": "01:05:14", "text": "聞こえますか？"}, {"type": "subtitle", "time": 3928.63, "timestamp": "01:05:28", "text": "ああ、そうだったのか。そうそう。眼球。私たちは"}, {"type": "subtitle", "time": 3941.27, "timestamp": "01:05:41", "text": "わかった。では、その場所は一体ど​​こなのでしょうか？"}, {"type": "chat", "time": 3942.212, "timestamp": "01:05:42", "author": "@IzumiIzu", "avatar": "https://yt4.ggpht.com/SHqyZzaYrIQLj32Wpl-K1gIv-ExIiNBC_Ht7FB5JHXGyDJeL_7dou322O73N-N6FnAtDsp0isQ=s64-c-k-c0x00ffffff-no-rj", "message": "cheeizu raiddd"}, {"type": "subtitle", "time": 3944.39, "timestamp": "01:05:44", "text": "ここが放射線室だったことを忘れていた。"}, {"type": "subtitle", "time": 3946.23, "timestamp": "01:05:46", "text": "ええ、ここはあなたが必要とする場所です"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "スーツを着るような仕事に就くこと。うん。うん、"}, {"type": "subtitle", "time": 3951.589, "timestamp": "01:05:51", "text": "私はあなたの後ろにいます。待って、どこに"}, {"type": "subtitle", "time": 3959.75, "timestamp": "01:05:59", "text": "あなた？ああ、わかりました。こんにちは。つまり、そういうことだったのです。"}]
[{"type": "subtitle", "time": 5281.75, "timestamp": "01:28:01", "text": "よし、J。ここから出よう。"}, {"type": "subtitle", "time": 5285.03, "timestamp": "01:28:05", "text": "調べてみましょう。もう一つ基地がある、"}, {"type": "subtitle", "time": 5288.709, "timestamp": "01:28:08", "text": "信じる。コードを受け取れませんでした。"}, {"type": "subtitle", "time": 5290.79, "timestamp": "01:28:10", "text": "それはいいです。足を手に入れた。私は"}, {"type": "subtitle", "time": 5293.79, "timestamp": "01:28:13", "text": "足。いいえ、コードが必要です。"}, {"type": "subtitle", "time": 5296.39, "timestamp": "01:28:16", "text": "けれど。鍵は手に入れましたか？待って、私は"}, {"type": "subtitle", "time": 5300.39, "timestamp": "01:28:20", "text": "鍵は重要だと思うよね？"}, {"type": "subtitle", "time": 5302.47, "timestamp": "01:28:22", "text": "死ぬな。さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 5306.95, "timestamp": "01:28:26", "text": "彼はまだ生きている。彼は生きている。何てことだ。"}, {"type": "subtitle", "time": 5310.629, "timestamp": "01:28:30", "text": "彼の体が来た。"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "いや。ああ、なんてことだ。"}, {"type": "subtitle", "time": 5317.99, "timestamp": "01:28:37", "text": "ああ、この野郎。あの野郎。"}, {"type": "subtitle", "time": 5321.59, "timestamp": "01:28:41", "text": "彼は体を張ってブロックする。大丈夫。ケーブルのように"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "男はボディブロックをしない。ところで、彼は"}, {"type": "subtitle", "time": 5327.11, "timestamp": "01:28:47", "text": "ボディブロック。気をつけて。あなたは手に入れました あなたは手に入れました"}, {"type": "subtitle", "time": 5329.43, "timestamp": "01:28:49", "text": "鍵はそこですよね？もし私が"}, {"type": "subtitle", "time": 5332.87, "timestamp": "01:28:52", "text": "赤い鍵。私は赤い鍵を手に入れた。私は手に入れた 私は手に入れた"}, {"type": "subtitle", "time": 5336.39, "timestamp": "01:28:56", "text": "赤い鍵。わかった。"}, {"type": "subtitle", "time": 5339.669, "timestamp": "01:28:59", "text": "わかった。蘇生されているのは分かっています。お願いします。"}]
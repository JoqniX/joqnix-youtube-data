[{"type": "subtitle", "time": 4921.03, "timestamp": "01:22:01", "text": "打つ。くそっ。"}, {"type": "subtitle", "time": 4923.59, "timestamp": "01:22:03", "text": "私は正気じゃない。ちょっと待ってください。うん。"}, {"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "彼らは良い人たちだ。"}, {"type": "subtitle", "time": 4928.95, "timestamp": "01:22:08", "text": "ああ、おいで。隠すことができます。あなたはできません"}, {"type": "subtitle", "time": 4931.31, "timestamp": "01:22:11", "text": "捕まえて。捕まえることはできない"}, {"type": "subtitle", "time": 4933.79, "timestamp": "01:22:13", "text": "自分。私を捕まえることはできない"}, {"type": "subtitle", "time": 4937.11, "timestamp": "01:22:17", "text": "今。あなたは私がそれに夢中になるのを文字通り見ました"}, {"type": "subtitle", "time": 4939.55, "timestamp": "01:22:19", "text": "あれってなんて言うんだっけ？"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "「OK」を使用してください。 2回使用する必要がありますか、"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "何か？必要ない。わかりました、"}, {"type": "subtitle", "time": 4958.149, "timestamp": "01:22:38", "text": "ちょっと待ってください。アーモンド。アーモンドウォーター。"}, {"type": "subtitle", "time": 4963.75, "timestamp": "01:22:43", "text": "うん。ニース。いい感じに温かくなっている。ニース。"}, {"type": "subtitle", "time": 4966.149, "timestamp": "01:22:46", "text": "彼はまだそこにいるのか？私はしません"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "彼はそう思う。"}, {"type": "subtitle", "time": 4970.83, "timestamp": "01:22:50", "text": "それはいいです。"}]
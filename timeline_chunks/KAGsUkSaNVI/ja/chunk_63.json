[{"type": "subtitle", "time": 3783.23, "timestamp": "01:03:03", "text": "マーレイ・ジョナサン"}, {"type": "subtitle", "time": 3786.47, "timestamp": "01:03:06", "text": "ガレンドは耳を失ったのだと思う。おお、"}, {"type": "subtitle", "time": 3788.23, "timestamp": "01:03:08", "text": "いいえ。これは何ですか？足。持っていますか"}, {"type": "subtitle", "time": 3791.109, "timestamp": "01:03:11", "text": "足？足？いいえ、私はその足を持っていません。"}, {"type": "subtitle", "time": 3794.069, "timestamp": "01:03:14", "text": "あ、待って。これは何ですか？わからない。"}, {"type": "subtitle", "time": 3795.15, "timestamp": "01:03:15", "text": "ネイサン"}, {"type": "subtitle", "time": 3797.99, "timestamp": "01:03:17", "text": "エレン。ええと、耳を失くしました。だから、私は"}, {"type": "subtitle", "time": 3806.069, "timestamp": "01:03:26", "text": "おっと。"}, {"type": "subtitle", "time": 3808.95, "timestamp": "01:03:28", "text": "わかった。どうしたの？"}, {"type": "subtitle", "time": 3811.589, "timestamp": "01:03:31", "text": "不安を抑える薬を服用します。そうですね、"}, {"type": "subtitle", "time": 3815.51, "timestamp": "01:03:35", "text": "今はもう正常です。こんにちは。"}, {"type": "subtitle", "time": 3818.549, "timestamp": "01:03:38", "text": "何だって？なぜそれが彼の目的だったのか？それで、"}, {"type": "subtitle", "time": 3822.15, "timestamp": "01:03:42", "text": "右足か左足を見つける必要がある"}, {"type": "subtitle", "time": 3824.99, "timestamp": "01:03:44", "text": "足。それは"}, {"type": "subtitle", "time": 3828.829, "timestamp": "01:03:48", "text": "えっと、今の聞こえましたか？"}, {"type": "subtitle", "time": 3832.07, "timestamp": "01:03:52", "text": "わかったよ、ジェニファー、"}, {"type": "subtitle", "time": 3833.589, "timestamp": "01:03:53", "text": "[音楽]"}, {"type": "subtitle", "time": 3837.109, "timestamp": "01:03:57", "text": "ジョナサンだと思う。"}, {"type": "subtitle", "time": 3839.51, "timestamp": "01:03:59", "text": "うん。だから、左足を見つける必要がある"}]
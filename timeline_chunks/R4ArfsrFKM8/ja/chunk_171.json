[{"type": "subtitle", "time": 10263.11, "timestamp": "02:51:03", "text": "滞在中に感じたこと"}, {"type": "subtitle", "time": 10265.269, "timestamp": "02:51:05", "text": "それについて、好きなこと、嫌いなこと"}, {"type": "subtitle", "time": 10267.349, "timestamp": "02:51:07", "text": "のように。"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "確かに良い"}, {"type": "subtitle", "time": 10271.03, "timestamp": "02:51:11", "text": "他の人にとっても視点となる。"}, {"type": "subtitle", "time": 10273.99, "timestamp": "02:51:13", "text": "うん、きっと楽しいよ。見るのが待ちきれない"}, {"type": "subtitle", "time": 10277.11, "timestamp": "02:51:17", "text": "物事がどう進むか。そして、私にとっては初めてのことです"}, {"type": "subtitle", "time": 10279.429, "timestamp": "02:51:19", "text": "そういう環境。私が行くわけではない"}, {"type": "subtitle", "time": 10282.309, "timestamp": "02:51:22", "text": "国外にいるか、一人でいる"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "一人っ子として、私は"}, {"type": "subtitle", "time": 10288.79, "timestamp": "02:51:28", "text": "非常に過保護に育てられ、甘やかされて育った。これ"}, {"type": "subtitle", "time": 10291.03, "timestamp": "02:51:31", "text": "それがあなたの独立した物語の始まりになるのでしょうね。"}, {"type": "subtitle", "time": 10294.15, "timestamp": "02:51:34", "text": "うん。だから、ワクワクしています。"}, {"type": "subtitle", "time": 10296.389, "timestamp": "02:51:36", "text": "それは良い。それは良い。探しています"}, {"type": "subtitle", "time": 10299.67, "timestamp": "02:51:39", "text": "その話を聞くのが楽しみです。はい。"}, {"type": "subtitle", "time": 10301.75, "timestamp": "02:51:41", "text": "はい。楽しみにしています、あなたに送ります"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "写真とか色々。いいえ、それは"}, {"type": "subtitle", "time": 10305.83, "timestamp": "02:51:45", "text": "良い。それは素晴らしいですね。もちろん。もちろん。"}, {"type": "subtitle", "time": 10308.15, "timestamp": "02:51:48", "text": "私に送ってください。私はいつも見たい"}, {"type": "subtitle", "time": 10310.55, "timestamp": "02:51:50", "text": "写真。"}, {"type": "subtitle", "time": 10312.67, "timestamp": "02:51:52", "text": "写真を見せて"}, {"type": "subtitle", "time": 10315.51, "timestamp": "02:51:55", "text": "もの。温泉で有名ですか？熱い"}, {"type": "subtitle", "time": 10317.99, "timestamp": "02:51:57", "text": "熱い温泉ですよね？だからホットなショーを見せて"}]
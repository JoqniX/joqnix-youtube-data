[{"type": "subtitle", "time": 14281.99, "timestamp": "03:58:01", "text": "原理原則とかそういうのを実行する。あなたは"}, {"type": "subtitle", "time": 14285.189, "timestamp": "03:58:05", "text": "他の人を指導し、"}, {"type": "subtitle", "time": 14287.83, "timestamp": "03:58:07", "text": "あれこれやらなければならない、プロらしく振る舞う"}, {"type": "subtitle", "time": 14290.87, "timestamp": "03:58:10", "text": "などなど、そういうことです。それで"}, {"type": "subtitle", "time": 14294.469, "timestamp": "03:58:14", "text": "これって私にも当てはまるよね？私 私 私"}, {"type": "subtitle", "time": 14297.15, "timestamp": "03:58:17", "text": "多くのものを紹介する"}, {"type": "subtitle", "time": 14300.269, "timestamp": "03:58:20", "text": "えーと、たくさん"}, {"type": "subtitle", "time": 14303.15, "timestamp": "03:58:23", "text": "えっと、たくさん"}, {"type": "subtitle", "time": 14307.03, "timestamp": "03:58:27", "text": "えっと、なんて言うんだっけ？誠実さ。いいえ"}, {"type": "subtitle", "time": 14312.229, "timestamp": "03:58:32", "text": "ああ、脆弱な脆弱なもの"}, {"type": "subtitle", "time": 14315.429, "timestamp": "03:58:35", "text": "必要のないものであり、"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "たくさん、そしてすべて。つまり、"}, {"type": "subtitle", "time": 14321.59, "timestamp": "03:58:41", "text": "私の側からのプロ意識の欠如"}, {"type": "subtitle", "time": 14324.95, "timestamp": "03:58:44", "text": "物事、ですよね？ゲストと"}, {"type": "subtitle", "time": 14328.269, "timestamp": "03:58:48", "text": "いろいろ、ちょっと"}, {"type": "subtitle", "time": 14331.11, "timestamp": "03:58:51", "text": "誇張して説明しすぎた"}, {"type": "subtitle", "time": 14333.189, "timestamp": "03:58:53", "text": "私の持ち物と一緒に。分かりません。そうしなければならなかった"}, {"type": "subtitle", "time": 14336.469, "timestamp": "03:58:56", "text": "私の次のモデルを見せたり、"}, {"type": "subtitle", "time": 14338.55, "timestamp": "03:58:58", "text": "ゲストやその他諸々"}]
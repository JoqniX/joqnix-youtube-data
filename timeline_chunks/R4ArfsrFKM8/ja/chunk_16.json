[{"type": "subtitle", "time": 961.829, "timestamp": "00:16:01", "text": "善行だけど、ちょっと手伝おうとしたんだけど"}, {"type": "subtitle", "time": 963.55, "timestamp": "00:16:03", "text": "私の残高"}, {"type": "subtitle", "time": 965.87, "timestamp": "00:16:05", "text": "今日は、"}, {"type": "subtitle", "time": 970.509, "timestamp": "00:16:10", "text": "料理。ええ、お皿を洗って、"}, {"type": "subtitle", "time": 973.509, "timestamp": "00:16:13", "text": "お茶とか、そういう類のもの全部。手助けするだけ"}, {"type": "subtitle", "time": 975.069, "timestamp": "00:16:15", "text": "と共に"}, {"type": "subtitle", "time": 978.67, "timestamp": "00:16:18", "text": "家族になるまで、"}, {"type": "subtitle", "time": 984.749, "timestamp": "00:16:24", "text": "所有"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "上。曲をいくつか削除する必要があるかもしれません"}, {"type": "subtitle", "time": 992.389, "timestamp": "00:16:32", "text": "列。選択する方法はありますか？"}, {"type": "subtitle", "time": 995.91, "timestamp": "00:16:35", "text": "SpotifyのQリストで曲を選択する"}, {"type": "subtitle", "time": 998.189, "timestamp": "00:16:38", "text": "代わりに削除する"}, {"type": "subtitle", "time": 1000.91, "timestamp": "00:16:40", "text": "クリックする"}, {"type": "subtitle", "time": 1002.749, "timestamp": "00:16:42", "text": "ゆっくり？私"}, {"type": "subtitle", "time": 1006.269, "timestamp": "00:16:46", "text": "ベッドから出なかったのが不思議だ"}, {"type": "subtitle", "time": 1009.59, "timestamp": "00:16:49", "text": "今日。それは私が"}, {"type": "subtitle", "time": 1013.509, "timestamp": "00:16:53", "text": "昔はすごく怠け者で、ベッドでくつろいでいた"}, {"type": "subtitle", "time": 1016.15, "timestamp": "00:16:56", "text": "YouTubeを見たり、アニメを見たり"}, {"type": "subtitle", "time": 1017.55, "timestamp": "00:16:57", "text": "視聴中"}]
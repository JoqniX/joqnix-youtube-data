[{"type": "subtitle", "time": 1380.75, "timestamp": "00:23:00", "text": "うん。"}, {"type": "subtitle", "time": 1382.51, "timestamp": "00:23:02", "text": "戻る。"}, {"type": "subtitle", "time": 1392.59, "timestamp": "00:23:12", "text": "これ。手に入れる"}, {"type": "subtitle", "time": 1396.43, "timestamp": "00:23:16", "text": "それ。そして、みんなが手に入れる"}, {"type": "subtitle", "time": 1403.43, "timestamp": "00:23:23", "text": "うん。まだ試していません。どのようにどのように"}, {"type": "subtitle", "time": 1409.83, "timestamp": "00:23:29", "text": "また？もしそうなったらどうなるか"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "それは永続的なものではありません。絶対に手に入れない"}, {"type": "subtitle", "time": 1420.789, "timestamp": "00:23:40", "text": "私からの永久的なヘッドパッドです。見てください"}, {"type": "subtitle", "time": 1431.909, "timestamp": "00:23:51", "text": "1つ。あ、待って。これは"}, {"type": "subtitle", "time": 1434.83, "timestamp": "00:23:54", "text": "ここ？待って、待って。私は"}, {"type": "subtitle", "time": 1438.95, "timestamp": "00:23:58", "text": "後ろに。我慢する。ちょっと待って。いつ"}]
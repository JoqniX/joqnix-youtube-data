[{"type": "subtitle", "time": 6661.43, "timestamp": "01:51:01", "text": "私の尊敬を勝ち取りたい。こんにちは。"}, {"type": "subtitle", "time": 6663.59, "timestamp": "01:51:03", "text": "わかった。それでは、挑戦を受けて立ちましょう。多分"}, {"type": "subtitle", "time": 6665.83, "timestamp": "01:51:05", "text": "君には、結局その素質があるんだ。私たちは"}, {"type": "subtitle", "time": 6667.59, "timestamp": "01:51:07", "text": "見てみよう。ええ、そうします。手に入れよう"}, {"type": "subtitle", "time": 6670.149, "timestamp": "01:51:10", "text": "期待が高まる。アイアンデール近郊の次のコース"}, {"type": "subtitle", "time": 6673.669, "timestamp": "01:51:13", "text": "はるかに厳しい挑戦を提供する。あなたはできる"}, {"type": "subtitle", "time": 6675.51, "timestamp": "01:51:15", "text": "このコースを走って準備してみましょう"}, {"type": "subtitle", "time": 6677.75, "timestamp": "01:51:17", "text": "また。受付でチェックインしてください。"}, {"type": "subtitle", "time": 6680.55, "timestamp": "01:51:20", "text": "リーダーボードは。開始できます"}, {"type": "subtitle", "time": 6683.27, "timestamp": "01:51:23", "text": "人種。次回、あなたの勝利がどうなるか見てみましょう"}, {"type": "subtitle", "time": 6685.59, "timestamp": "01:51:25", "text": "これは単なる偶然ではなかった。わかった、"}, {"type": "subtitle", "time": 6703.109, "timestamp": "01:51:43", "text": "ウィークス氏はこれを聞いて喜ぶだろうと思う"}, {"type": "subtitle", "time": 6711.589, "timestamp": "01:51:51", "text": "今日カメラを買いました。"}, {"type": "subtitle", "time": 6714.27, "timestamp": "01:51:54", "text": "ええ、それを削除しなければなりませんでした"}]
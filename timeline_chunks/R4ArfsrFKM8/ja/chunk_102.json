[{"type": "subtitle", "time": 6121.91, "timestamp": "01:42:01", "text": "[音楽]"}, {"type": "subtitle", "time": 6124.95, "timestamp": "01:42:04", "text": "そうですね、これで終わりにできると思います"}, {"type": "subtitle", "time": 6127.43, "timestamp": "01:42:07", "text": "よろしければ、上へどうぞ。"}, {"type": "subtitle", "time": 6130.95, "timestamp": "01:42:10", "text": "うん。それで、何かお好きなものはありますか？"}, {"type": "subtitle", "time": 6135.59, "timestamp": "01:42:15", "text": "最後に何かお伝えしたいことやメッセージはありますか？"}, {"type": "subtitle", "time": 6137.59, "timestamp": "01:42:17", "text": "私は"}, {"type": "subtitle", "time": 6140.31, "timestamp": "01:42:20", "text": "ジョックニックと過ごした時間は最高だったよ、みんな。あなたも"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "皆さん、購読していないか、"}, {"type": "subtitle", "time": 6145.91, "timestamp": "01:42:25", "text": "彼をインスタグラムでフォローして、"}, {"type": "subtitle", "time": 6149.189, "timestamp": "01:42:29", "text": "お前の家に行ったら、ぶっ飛ばしてやる。わかった、"}, {"type": "subtitle", "time": 6152.709, "timestamp": "01:42:32", "text": "ありがとう。私のチャンネルを購読した方がいいよ"}, {"type": "subtitle", "time": 6155.55, "timestamp": "01:42:35", "text": "本当に素敵な友人です。"}, {"type": "subtitle", "time": 6159.229, "timestamp": "01:42:39", "text": "はい、以上です。また、もしあなたが"}, {"type": "subtitle", "time": 6163.91, "timestamp": "01:42:43", "text": "今日はソンと楽しい時間を過ごしました。"}, {"type": "subtitle", "time": 6166.629, "timestamp": "01:42:46", "text": "YouTube、Twitch、"}, {"type": "subtitle", "time": 6169.189, "timestamp": "01:42:49", "text": "インスタグラム。"}, {"type": "subtitle", "time": 6171.75, "timestamp": "01:42:51", "text": "私はさらに誤情報を広めるつもりです"}, {"type": "subtitle", "time": 6174.709, "timestamp": "01:42:54", "text": "みんなと私の道中をしゃべり通る"}, {"type": "subtitle", "time": 6178.68, "timestamp": "01:42:58", "text": "それが私の人生であり、私のモットーです。"}]
[{"type": "subtitle", "time": 15860.309, "timestamp": "04:24:20", "text": "ああ、わかりました。午後11時。彼女は午後11時と言った。それで"}, {"type": "subtitle", "time": 15864.87, "timestamp": "04:24:24", "text": "愛する息子愛ASMRヒンディー語彼女は彼女と一緒に"}, {"type": "subtitle", "time": 15869.91, "timestamp": "04:24:29", "text": "8時から8時10時くらいにやるよ"}, {"type": "subtitle", "time": 15876.389, "timestamp": "04:24:36", "text": "午前8時。ああ、8時"}, {"type": "subtitle", "time": 15879.309, "timestamp": "04:24:39", "text": "朝。主よ、私は起きなければなりません"}, {"type": "subtitle", "time": 15883.11, "timestamp": "04:24:43", "text": "木曜日は晴れ。聖なる主よ、午前6時"}, {"type": "subtitle", "time": 15892.469, "timestamp": "04:24:52", "text": "7. うんうんうんうんうん。私はできない"}]
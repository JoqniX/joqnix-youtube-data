[{"type": "subtitle", "time": 5640.229, "timestamp": "01:34:00", "text": "ええ、ぜひそうしたいです。"}, {"type": "subtitle", "time": 5644.709, "timestamp": "01:34:04", "text": "私はPS4でスピードを求めています"}, {"type": "subtitle", "time": 5646.87, "timestamp": "01:34:06", "text": "そして全て。"}, {"type": "subtitle", "time": 5649.51, "timestamp": "01:34:09", "text": "はい。私はそれに身を投じるつもりだ。"}, {"type": "subtitle", "time": 5652.79, "timestamp": "01:34:12", "text": "ああ、いいね。ああ、あなたはPS4をお持ちなんですね。それは良い。"}, {"type": "subtitle", "time": 5655.83, "timestamp": "01:34:15", "text": "いいえ、コントローラー操作は得意ではありません。"}, {"type": "subtitle", "time": 5657.75, "timestamp": "01:34:17", "text": "私はコントローラー操作が本当に得意です。その"}, {"type": "subtitle", "time": 5661.43, "timestamp": "01:34:21", "text": "私もそう思う、私もそういうゲームを持ってる"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "モータルコンバットや鉄拳など。おお、"}, {"type": "subtitle", "time": 5669.03, "timestamp": "01:34:29", "text": "ニース。それを持っています。そうですね、"}, {"type": "subtitle", "time": 5671.91, "timestamp": "01:34:31", "text": "それはあまりハードコアじゃないよ。私はもっ​​と"}, {"type": "subtitle", "time": 5676.229, "timestamp": "01:34:36", "text": "流血沙汰のゲーマーは軟弱者より"}, {"type": "subtitle", "time": 5679.59, "timestamp": "01:34:39", "text": "ゲーマー。何てことだ。待って、あなたは"}, {"type": "subtitle", "time": 5681.75, "timestamp": "01:34:41", "text": "コントローラーが故障しましたか？"}, {"type": "subtitle", "time": 5683.51, "timestamp": "01:34:43", "text": "あるいは、タップするのが好きだから何か"}, {"type": "subtitle", "time": 5684.83, "timestamp": "01:34:44", "text": "非常に多くのものを押し"}, {"type": "subtitle", "time": 5687.91, "timestamp": "01:34:47", "text": "時間の経過とともにボタンは変化しますか？うん。今まで"}, {"type": "subtitle", "time": 5690.79, "timestamp": "01:34:50", "text": "PS4コントローラーが故障しました"}, {"type": "subtitle", "time": 5694.39, "timestamp": "01:34:54", "text": "あるいは何かがうまくいかなかったり、何も起こらなかったり？"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "いいえ。そうです。いいえ。いいえ。いいえ。いいえ。そうではありません。"}]
[{"type": "subtitle", "time": 3362.15, "timestamp": "00:56:02", "text": "でも、それは確かにクレイジーですね。私も"}, {"type": "subtitle", "time": 3364.63, "timestamp": "00:56:04", "text": "山に行ったり、そういうことをする。私は思う"}, {"type": "subtitle", "time": 3367.109, "timestamp": "00:56:07", "text": "雪が降るのを体験できるだろう"}, {"type": "subtitle", "time": 3371.51, "timestamp": "00:56:11", "text": "初めて。えっと、やったー。もし私が"}, {"type": "subtitle", "time": 3373.51, "timestamp": "00:56:13", "text": "うん。私が日本にいる間、"}, {"type": "subtitle", "time": 3376.63, "timestamp": "00:56:16", "text": "12月とかそういう時期ですね。だから、待ちきれないよ。"}, {"type": "subtitle", "time": 3379.349, "timestamp": "00:56:19", "text": "だから、ジョー、私はただ知っているんだ、"}, {"type": "subtitle", "time": 3382.549, "timestamp": "00:56:22", "text": "君はきっとすごく気に入るよ。"}, {"type": "subtitle", "time": 3386.069, "timestamp": "00:56:26", "text": "雰囲気の問題だよ。何てことだ。私はできません"}, {"type": "subtitle", "time": 3388.95, "timestamp": "00:56:28", "text": "説明してくれよ。私はとても幸せです"}, {"type": "chat", "time": 3391.132, "timestamp": "00:56:31", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "i hope i didnt missed anything :3"}, {"type": "subtitle", "time": 3392.23, "timestamp": "00:56:32", "text": "私がそれについて話しているとき。"}, {"type": "subtitle", "time": 3400.789, "timestamp": "00:56:40", "text": "写真とか送りますね。わかった。"}, {"type": "subtitle", "time": 3403.67, "timestamp": "00:56:43", "text": "はい。はい。ぜひ共有してください。私もそれを共有します"}, {"type": "subtitle", "time": 3405.349, "timestamp": "00:56:45", "text": "DM"}, {"type": "subtitle", "time": 3408.23, "timestamp": "00:56:48", "text": "チャット。残念ながらお伝えできません。うん、"}, {"type": "chat", "time": 3408.485, "timestamp": "00:56:48", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "the Modern Phones now have safety protection thats stops the mobile from overcharging"}, {"type": "subtitle", "time": 3415.589, "timestamp": "00:56:55", "text": "こんにちは。現代の携帯電話にはセキュリティ機能が備わっています"}, {"type": "subtitle", "time": 3417.829, "timestamp": "00:56:57", "text": "ストップを維持する保護"}, {"type": "subtitle", "time": 3419.75, "timestamp": "00:56:59", "text": "携帯電話の過剰請求を防ぐ。うん、本当だね。"}]
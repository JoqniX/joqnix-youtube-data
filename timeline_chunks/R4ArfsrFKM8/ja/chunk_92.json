[{"type": "subtitle", "time": 5521.03, "timestamp": "01:32:01", "text": "怖いのか？怖いです。はい。"}, {"type": "subtitle", "time": 5525.59, "timestamp": "01:32:05", "text": "ホラーは私の好みではありません。何てことだ。私は私です"}, {"type": "subtitle", "time": 5529.27, "timestamp": "01:32:09", "text": "一人でいるととても寂しい気持ちになります。私は"}, {"type": "subtitle", "time": 5531.189, "timestamp": "01:32:11", "text": "どのように対処するかを考えています"}, {"type": "subtitle", "time": 5533.99, "timestamp": "01:32:13", "text": "あなたは異国の地で、たった一人でいる。"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "悲しい気持ちです。"}, {"type": "subtitle", "time": 5541.91, "timestamp": "01:32:21", "text": "生き延びられるといいな。私も嬉しいです"}, {"type": "subtitle", "time": 5543.24, "timestamp": "01:32:23", "text": "君だよ。"}, {"type": "subtitle", "time": 5546.189, "timestamp": "01:32:26", "text": "[音楽]"}, {"type": "subtitle", "time": 5552.31, "timestamp": "01:32:32", "text": "Steamのリンクをお送りします。これ"}, {"type": "subtitle", "time": 5556.149, "timestamp": "01:32:36", "text": "開発者はChila's Artです。ええと、"}, {"type": "subtitle", "time": 5559.03, "timestamp": "01:32:39", "text": "Jalas Jalas Art のゲームがたくさん"}, {"type": "subtitle", "time": 5562.79, "timestamp": "01:32:42", "text": "また、もしよろしければ寄付してください"}, {"type": "subtitle", "time": 5565.669, "timestamp": "01:32:45", "text": "Patreon を通じて彼らをサポートする"}, {"type": "subtitle", "time": 5568.07, "timestamp": "01:32:48", "text": "開発者やその他諸々をプロジェクト化することができます"}, {"type": "subtitle", "time": 5570.39, "timestamp": "01:32:50", "text": "実際に自分を売り込んでみましょう。実際は"}, {"type": "subtitle", "time": 5572.31, "timestamp": "01:32:52", "text": "多くのユーチューバーがそれをやっています"}, {"type": "subtitle", "time": 5574.629, "timestamp": "01:32:54", "text": "人気のあるものも含め、すべて。彼らは手に入れた"}, {"type": "subtitle", "time": 5579.07, "timestamp": "01:32:59", "text": "彼ら自身は、パトレオンを取った"}]
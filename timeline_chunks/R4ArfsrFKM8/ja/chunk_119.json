[{"type": "subtitle", "time": 7141.03, "timestamp": "01:59:01", "text": "献身"}, {"type": "subtitle", "time": 7143.83, "timestamp": "01:59:03", "text": "これらはすべてとても楽しかった"}, {"type": "subtitle", "time": 7145.43, "timestamp": "01:59:05", "text": "イベント、コミュニティの管理、"}, {"type": "subtitle", "time": 7147.109, "timestamp": "01:59:07", "text": "すべて。また、それは良いことでもあります"}, {"type": "subtitle", "time": 7149.43, "timestamp": "01:59:09", "text": "学習経験でもあるので、"}, {"type": "subtitle", "time": 7151.03, "timestamp": "01:59:11", "text": "それにはそれなりの課題や問題点がある。それで、"}, {"type": "subtitle", "time": 7154.31, "timestamp": "01:59:14", "text": "やってみるのはちょっと楽しいよ、"}, {"type": "subtitle", "time": 7156.35, "timestamp": "01:59:16", "text": "知る。"}, {"type": "subtitle", "time": 7160.109, "timestamp": "01:59:20", "text": "うん。しかし、私は疑問を抱いていた。どうしたの"}, {"type": "subtitle", "time": 7163.669, "timestamp": "01:59:23", "text": "辞めたの？何が"}, {"type": "subtitle", "time": 7166.229, "timestamp": "01:59:26", "text": "あなたは去るのですか？ええ、ほぼそう言えます"}, {"type": "subtitle", "time": 7168.31, "timestamp": "01:59:28", "text": "それ。私は結局着ることになった"}, {"type": "subtitle", "time": 7171.03, "timestamp": "01:59:31", "text": "チューブ。ええと、時々そうするかもしれません"}, {"type": "subtitle", "time": 7173.51, "timestamp": "01:59:33", "text": "たまにはあるけど、それくらいだ。いいえ、私は"}, {"type": "subtitle", "time": 7177.43, "timestamp": "01:59:37", "text": "ただリラックスして、落ち着いて。リラックスしてくつろいでください。"}, {"type": "subtitle", "time": 7180.87, "timestamp": "01:59:40", "text": "うん。うん。私は今でもそれを覚えている"}, {"type": "subtitle", "time": 7183.91, "timestamp": "01:59:43", "text": "昨日あなたが来たとき、"}, {"type": "subtitle", "time": 7185.51, "timestamp": "01:59:45", "text": "デビュー配信の準備と"}, {"type": "subtitle", "time": 7188.47, "timestamp": "01:59:48", "text": "すべては今。何てことだ。覚えてるよ"}, {"type": "subtitle", "time": 7190.87, "timestamp": "01:59:50", "text": "広告を投稿している"}, {"type": "subtitle", "time": 7193.75, "timestamp": "01:59:53", "text": "バナーのように、それはあなたと"}, {"type": "subtitle", "time": 7197.149, "timestamp": "01:59:57", "text": "ミームとか色々と"}]
[{"type": "subtitle", "time": 6781.27, "timestamp": "01:53:01", "text": "動作が遅い？私はこれをしばらくプレイしています。"}, {"type": "subtitle", "time": 6798.95, "timestamp": "01:53:18", "text": "私の携帯電話は充電されていた。では、私は"}, {"type": "subtitle", "time": 6801.79, "timestamp": "01:53:21", "text": "私の電話を使ってもいいですか？えっと、これ"}, {"type": "subtitle", "time": 6804.709, "timestamp": "01:53:24", "text": "もの。顔認証にスマホを使ってもいいですか？"}, {"type": "subtitle", "time": 6807.91, "timestamp": "01:53:27", "text": "トラッキング？私は、あの電話のようなものを持っています"}, {"type": "subtitle", "time": 6810.31, "timestamp": "01:53:30", "text": "現在は保有者です。電話としても使用できます"}, {"type": "subtitle", "time": 6811.99, "timestamp": "01:53:31", "text": "あれ。ああ、それは素晴らしい"}, {"type": "subtitle", "time": 6815.07, "timestamp": "01:53:35", "text": "騎手としてのアイデア。あなた あなた"}, {"type": "subtitle", "time": 6839.149, "timestamp": "01:53:59", "text": "[音楽]"}]
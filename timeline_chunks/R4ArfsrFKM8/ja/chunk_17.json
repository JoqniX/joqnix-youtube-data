[{"type": "subtitle", "time": 1026.75, "timestamp": "00:17:06", "text": "バンガブランケットにくるまってぬくぬくと過ごす。"}, {"type": "subtitle", "time": 1027.87, "timestamp": "00:17:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1030.829, "timestamp": "00:17:10", "text": "ほら、私は愛してる"}, {"type": "subtitle", "time": 1033.829, "timestamp": "00:17:13", "text": "寄り添う。奇妙な事実を知っていますか"}, {"type": "subtitle", "time": 1036.63, "timestamp": "00:17:16", "text": "私について。自分が変なのは分かってるけど、変な"}, {"type": "subtitle", "time": 1038.35, "timestamp": "00:17:18", "text": "私についての事実"}, {"type": "subtitle", "time": 1041.309, "timestamp": "00:17:21", "text": "私が"}, {"type": "subtitle", "time": 1044.87, "timestamp": "00:17:24", "text": "睡眠中、時々、"}, {"type": "subtitle", "time": 1047.549, "timestamp": "00:17:27", "text": "いいよ、幸せ"}, {"type": "subtitle", "time": 1051.669, "timestamp": "00:17:31", "text": "モードは、ニャーニャー石をやって、行動します"}, {"type": "subtitle", "time": 1052.99, "timestamp": "00:17:32", "text": "猫のように"}, {"type": "subtitle", "time": 1054.909, "timestamp": "00:17:34", "text": "しかし、そして"}, {"type": "subtitle", "time": 1058.19, "timestamp": "00:17:38", "text": "もの。実際はアニメです"}, {"type": "subtitle", "time": 1060.99, "timestamp": "00:17:40", "text": "えっと、それは"}, {"type": "subtitle", "time": 1063.87, "timestamp": "00:17:43", "text": "えーと、私が表現したいこと"}, {"type": "subtitle", "time": 1066.51, "timestamp": "00:17:46", "text": "した。だから、"}, {"type": "subtitle", "time": 1068.43, "timestamp": "00:17:48", "text": "ギフト"}, {"type": "subtitle", "time": 1073.07, "timestamp": "00:17:53", "text": "それ。それを証明できるかどうかはわかりません"}]
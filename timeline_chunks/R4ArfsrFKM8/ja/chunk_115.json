[{"type": "subtitle", "time": 6901.27, "timestamp": "01:55:01", "text": "反対者は認めざるを得なくなるだろう"}, {"type": "subtitle", "time": 6909.589, "timestamp": "01:55:09", "text": "アマゾン。えっと、誰があなたを疑ったんですか？"}, {"type": "subtitle", "time": 6911.35, "timestamp": "01:55:11", "text": "なぜ誰かがあなたの能力を疑うのでしょうか"}, {"type": "subtitle", "time": 6914.229, "timestamp": "01:55:14", "text": "ほうきをアップグレードしますか？いいえ、あなたは驚くでしょう。"}, {"type": "subtitle", "time": 6916.629, "timestamp": "01:55:16", "text": "人々は自分のやり方に固執し、"}, {"type": "subtitle", "time": 6918.39, "timestamp": "01:55:18", "text": "うまく機能しているものをいじくり回すと"}, {"type": "subtitle", "time": 6920.189, "timestamp": "01:55:20", "text": "どういうわけか台無しに"}, {"type": "subtitle", "time": 6922.95, "timestamp": "01:55:22", "text": "それ。そういう人たちは"}, {"type": "subtitle", "time": 6924.709, "timestamp": "01:55:24", "text": "品質に伴う自由の感覚"}, {"type": "subtitle", "time": 6927.189, "timestamp": "01:55:27", "text": "ほうき飛行。また、彼らはすべてを評価しているわけではない"}, {"type": "subtitle", "time": 6929.669, "timestamp": "01:55:29", "text": "それは創作過程に関わるものです。"}, {"type": "subtitle", "time": 6931.75, "timestamp": "01:55:31", "text": "ローマに友達がいて、こんなお店を経営している"}, {"type": "subtitle", "time": 6934.79, "timestamp": "01:55:34", "text": "私の。あちらの方が状況は悪いと言っている。もちろん、"}, {"type": "subtitle", "time": 6936.87, "timestamp": "01:55:36", "text": "彼らは午後に昼寝をする"}, {"type": "subtitle", "time": 6939.31, "timestamp": "01:55:39", "text": "わかりました。そして、私たちは"}, {"type": "subtitle", "time": 6941.91, "timestamp": "01:55:41", "text": "機能強化？つまり、エリオット・スマイクが"}, {"type": "subtitle", "time": 6944.07, "timestamp": "01:55:44", "text": "反対意見に惑わされてしまったが、"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "クッション性は決して得られなかっただろう"}, {"type": "subtitle", "time": 6948.109, "timestamp": "01:55:48", "text": "魅力。私は聞きません"}, {"type": "subtitle", "time": 6950.95, "timestamp": "01:55:50", "text": "彼。ああ、これは本当に素晴らしい。それはそれは"}, {"type": "subtitle", "time": 6953.27, "timestamp": "01:55:53", "text": "まるで自分が本物のYouTuberになったような気分だ"}, {"type": "subtitle", "time": 6955.91, "timestamp": "01:55:55", "text": "モバイルの追跡設定とかそういうやつ。"}, {"type": "subtitle", "time": 6959.07, "timestamp": "01:55:59", "text": "ああ、これは"}]
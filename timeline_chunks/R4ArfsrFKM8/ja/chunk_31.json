[{"type": "subtitle", "time": 1865.389, "timestamp": "00:31:05", "text": "生活はどうでしたか？どうでしたか？"}, {"type": "subtitle", "time": 1868.63, "timestamp": "00:31:08", "text": "すばらしい？ああ、かなり詰め込まれているけど、それでも"}, {"type": "subtitle", "time": 1871.99, "timestamp": "00:31:11", "text": "いいことをしているし、いろいろと。まるで"}, {"type": "subtitle", "time": 1874.47, "timestamp": "00:31:14", "text": "忙しい日々、そして"}, {"type": "subtitle", "time": 1877.83, "timestamp": "00:31:17", "text": "私は本当に生産的ですが、なんとか"}, {"type": "subtitle", "time": 1883.029, "timestamp": "00:31:23", "text": "自分に時間を与えたり、"}, {"type": "subtitle", "time": 1885.35, "timestamp": "00:31:25", "text": "スキンケアとかで忙しくしよう"}, {"type": "subtitle", "time": 1887.75, "timestamp": "00:31:27", "text": "そんな感じ。つまり、基本的には私が"}, {"type": "subtitle", "time": 1891.11, "timestamp": "00:31:31", "text": "生産性を高めながら楽しむ。そう、それが"}, {"type": "subtitle", "time": 1893.51, "timestamp": "00:31:33", "text": "最近の生活は順調です。どうしたの？"}, {"type": "subtitle", "time": 1900.07, "timestamp": "00:31:40", "text": "あなた？私にとっては、ええと、ジョアソンを頑張っているところです。"}, {"type": "subtitle", "time": 1904.47, "timestamp": "00:31:44", "text": "そういうことだ。最高だよ。"}, {"type": "subtitle", "time": 1906.389, "timestamp": "00:31:46", "text": "来月、私は出発します"}, {"type": "subtitle", "time": 1910.149, "timestamp": "00:31:50", "text": "今。だから、私は1つしか持っていません。いいえ、今週は"}, {"type": "subtitle", "time": 1914.31, "timestamp": "00:31:54", "text": "そして来週が残っている、ということかな。私は"}, {"type": "subtitle", "time": 1916.789, "timestamp": "00:31:56", "text": "コラボレーションを終わらせようと考えている"}, {"type": "subtitle", "time": 1919.269, "timestamp": "00:31:59", "text": "来週の土曜日。"}]
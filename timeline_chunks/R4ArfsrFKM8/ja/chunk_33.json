[{"type": "subtitle", "time": 1981.19, "timestamp": "00:33:01", "text": "日で100です。"}, {"type": "subtitle", "time": 1983.669, "timestamp": "00:33:03", "text": "たくさんのこと。最高の幸運を祈っています"}, {"type": "subtitle", "time": 1987.269, "timestamp": "00:33:07", "text": "ああ、ジョー。ありがとう。"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "試験が本当に始まって"}, {"type": "subtitle", "time": 1992.549, "timestamp": "00:33:12", "text": "来週のように。なんてこった。そして"}, {"type": "subtitle", "time": 1994.789, "timestamp": "00:33:14", "text": "私はかなりストレスを感じています。私は"}, {"type": "subtitle", "time": 1996.71, "timestamp": "00:33:16", "text": "勉強とか色々頑張ってるんだけど、"}, {"type": "subtitle", "time": 1999.35, "timestamp": "00:33:19", "text": "大丈夫です。"}, {"type": "subtitle", "time": 2002.789, "timestamp": "00:33:22", "text": "うん。しばらく勉強していなかったので、"}, {"type": "subtitle", "time": 2006.029, "timestamp": "00:33:26", "text": "だから、私にとって勉強は本当に難しいんです。"}, {"type": "subtitle", "time": 2009.43, "timestamp": "00:33:29", "text": "ああ、君が僕みたいにならないのは分かるよ。私 私"}, {"type": "subtitle", "time": 2011.59, "timestamp": "00:33:31", "text": "試験があって大変です"}, {"type": "subtitle", "time": 2014.389, "timestamp": "00:33:34", "text": "しばらくすると、あなたの脳は"}, {"type": "subtitle", "time": 2017.59, "timestamp": "00:33:37", "text": "死んで、ただ存在しているだけ"}, {"type": "subtitle", "time": 2019.269, "timestamp": "00:33:39", "text": "何かがあなたの"}, {"type": "subtitle", "time": 2022.149, "timestamp": "00:33:42", "text": "頭。"}, {"type": "subtitle", "time": 2024.17, "timestamp": "00:33:44", "text": "私は男を感じることができる"}, {"type": "subtitle", "time": 2026.149, "timestamp": "00:33:46", "text": "[音楽]"}, {"type": "subtitle", "time": 2029.95, "timestamp": "00:33:49", "text": "感じますよ。えっと、私にとっては"}, {"type": "subtitle", "time": 2033.75, "timestamp": "00:33:53", "text": "いや、俺は勉強すらしないよ。試験がある"}]
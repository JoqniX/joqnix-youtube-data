[{"type": "subtitle", "time": 8342.07, "timestamp": "02:19:02", "text": "えーっと、ファイルのバックアップを取らないといけないんです"}, {"type": "subtitle", "time": 8345.27, "timestamp": "02:19:05", "text": "それに、自分の荷物も持っていけないから、他のものも。"}, {"type": "subtitle", "time": 8348.23, "timestamp": "02:19:08", "text": "SSDを試してみようと思うけど、"}, {"type": "subtitle", "time": 8351.429, "timestamp": "02:19:11", "text": "これはノートパソコンです。"}, {"type": "subtitle", "time": 8355.349, "timestamp": "02:19:15", "text": "ああ、ノートパソコンなので、"}, {"type": "subtitle", "time": 8359.349, "timestamp": "02:19:19", "text": "拡張物を買うような"}, {"type": "subtitle", "time": 8362.709, "timestamp": "02:19:22", "text": "SSDとハードディスク"}, {"type": "subtitle", "time": 8365.87, "timestamp": "02:19:25", "text": "または、または、あなたは、または、あなたは"}, {"type": "subtitle", "time": 8369.349, "timestamp": "02:19:29", "text": "スロット付きのノートパソコンを持っているような"}, {"type": "subtitle", "time": 8373.99, "timestamp": "02:19:33", "text": "おそらく、それを入れるための追加のスロットが欲しいのでしょう。"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "うん。そうすれば、ただ差し込むだけで"}, {"type": "subtitle", "time": 8378.07, "timestamp": "02:19:38", "text": "すべてのデータが直接SSDに保存されます"}, {"type": "subtitle", "time": 8379.83, "timestamp": "02:19:39", "text": "そのラップトップの中にあって、まだアクセスできる"}, {"type": "subtitle", "time": 8382.75, "timestamp": "02:19:42", "text": "それへ。"}, {"type": "subtitle", "time": 8385.91, "timestamp": "02:19:45", "text": "うん、それならうまくいくよ。うん。"}, {"type": "subtitle", "time": 8390.91, "timestamp": "02:19:50", "text": "うん。うん。うん。それは実際には"}, {"type": "subtitle", "time": 8395.83, "timestamp": "02:19:55", "text": "仕事。実は調べてみる必要があるんです。"}, {"type": "subtitle", "time": 8399.11, "timestamp": "02:19:59", "text": "うまくいくといいな。うん。うまくいけば"}]
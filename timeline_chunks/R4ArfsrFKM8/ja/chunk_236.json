[{"type": "subtitle", "time": 14160.51, "timestamp": "03:56:00", "text": "見るべきものがたくさんあります。"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "右？もっと注意深くならなければならない。あなた"}, {"type": "subtitle", "time": 14167.349, "timestamp": "03:56:07", "text": "「ああ、私は自由だ。私はできる」というわけにはいかない"}, {"type": "subtitle", "time": 14169.51, "timestamp": "03:56:09", "text": "「私が欲しいものは何でも」みたいな感じですよね？"}, {"type": "subtitle", "time": 14171.309, "timestamp": "03:56:11", "text": "インディーズ映画とは違う。あなたが持っている"}, {"type": "subtitle", "time": 14173.15, "timestamp": "03:56:13", "text": "に"}, {"type": "subtitle", "time": 14179.55, "timestamp": "03:56:19", "text": "もの。働かなければならない"}, {"type": "subtitle", "time": 14182.79, "timestamp": "03:56:22", "text": "難しい。もしそれが人生すべてに似ているなら、"}, {"type": "subtitle", "time": 14185.269, "timestamp": "03:56:25", "text": "努力する。"}, {"type": "subtitle", "time": 14188.389, "timestamp": "03:56:28", "text": "十分なスキルがない場合は、"}, {"type": "subtitle", "time": 14191.269, "timestamp": "03:56:31", "text": "例えば、アメリア・ワトソンは"}, {"type": "subtitle", "time": 14193.75, "timestamp": "03:56:33", "text": "歌とかそういうのに十分なスキルがある。"}, {"type": "subtitle", "time": 14196.79, "timestamp": "03:56:36", "text": "しかし、彼女はそれでも諦めなかった。"}, {"type": "subtitle", "time": 14199.59, "timestamp": "03:56:39", "text": "彼女の先祖たちは歌い、踊っていた"}, {"type": "subtitle", "time": 14202.07, "timestamp": "03:56:42", "text": "ステージに立つこと、ステージ上での出来事など。"}, {"type": "subtitle", "time": 14204.79, "timestamp": "03:56:44", "text": "彼女もそこにいられなかった"}, {"type": "subtitle", "time": 14207.269, "timestamp": "03:56:47", "text": "アイドルのように歌って踊る"}, {"type": "subtitle", "time": 14209.189, "timestamp": "03:56:49", "text": "彼女の遺伝子ですよね？彼女はいつも"}, {"type": "chat", "time": 14212.299, "timestamp": "03:56:52", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "I mean Hololive must be like next level pressure"}, {"type": "subtitle", "time": 14212.63, "timestamp": "03:56:52", "text": "座って下さい。しかし彼女はそれを自ら証明した"}, {"type": "subtitle", "time": 14214.469, "timestamp": "03:56:54", "text": "時間。彼女はそれを毎日練習した。"}, {"type": "subtitle", "time": 14218.349, "timestamp": "03:56:58", "text": "彼女は全てにおいて最善を尽くした。ゆっくり"}]
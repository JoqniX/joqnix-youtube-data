[{"type": "subtitle", "time": 10202.07, "timestamp": "02:50:02", "text": "将来的に。私は考えた"}, {"type": "subtitle", "time": 10205.269, "timestamp": "02:50:05", "text": "携帯電話を使って"}, {"type": "subtitle", "time": 10207.91, "timestamp": "02:50:07", "text": "いくつかの瞬間を捉え、もしかしたら"}, {"type": "subtitle", "time": 10210.63, "timestamp": "02:50:10", "text": "ナレーションか、あるいは単に"}, {"type": "subtitle", "time": 10213.269, "timestamp": "02:50:13", "text": "流れに身を任せて、楽しんでください。"}, {"type": "subtitle", "time": 10216.71, "timestamp": "02:50:16", "text": "えっと、YouTubeにアップするよ"}, {"type": "subtitle", "time": 10219.11, "timestamp": "02:50:19", "text": "今すぐ会員登録を。だから私はそうすべきではないと思った"}, {"type": "subtitle", "time": 10222.269, "timestamp": "02:50:22", "text": "次にそこに行く予定でも、活動しないで"}, {"type": "subtitle", "time": 10225.429, "timestamp": "02:50:25", "text": "月。私が活動を停止すると、そうなるかもしれない"}, {"type": "subtitle", "time": 10227.51, "timestamp": "02:50:27", "text": "サクラに起こったことと同じですよね？"}, {"type": "subtitle", "time": 10229.59, "timestamp": "02:50:29", "text": "彼女は2ヶ月間配信しなかったか、"}, {"type": "subtitle", "time": 10232.15, "timestamp": "02:50:32", "text": "2か月間活動しておらず、文字通り"}, {"type": "subtitle", "time": 10234.23, "timestamp": "02:50:34", "text": "YouTubeは収益化を廃止した"}, {"type": "subtitle", "time": 10237.51, "timestamp": "02:50:37", "text": "すべてがゼロに戻る。ああ、しまった。"}, {"type": "subtitle", "time": 10239.67, "timestamp": "02:50:39", "text": "それは残念だ。それは知りませんでした。"}, {"type": "subtitle", "time": 10243.11, "timestamp": "02:50:43", "text": "ああ、全てを失うんだ。 4,000人全員"}, {"type": "subtitle", "time": 10246.389, "timestamp": "02:50:46", "text": "視聴時間はリセットされます。それは"}, {"type": "subtitle", "time": 10250.55, "timestamp": "02:50:50", "text": "悪い。悪い。だから、私はただ"}, {"type": "subtitle", "time": 10253.429, "timestamp": "02:50:53", "text": "えっと、動画とかをアップロードして、どうなるか見てみよう"}, {"type": "subtitle", "time": 10257.11, "timestamp": "02:50:57", "text": "それで終わりだ。うん、いい感じだね。"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "自分の意見を述べることができます"}]
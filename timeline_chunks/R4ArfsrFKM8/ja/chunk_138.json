[{"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "2Dバージョンの私の2Dバージョン"}, {"type": "subtitle", "time": 8286.07, "timestamp": "02:18:06", "text": "カスタマイズ可能なものを見つけたんだけど"}, {"type": "subtitle", "time": 8289.349, "timestamp": "02:18:09", "text": "起動して、もっとよく見えるようにカスタマイズしました"}, {"type": "subtitle", "time": 8291.91, "timestamp": "02:18:11", "text": "私が見たいと思っていたものに、そして私は"}, {"type": "subtitle", "time": 8295.27, "timestamp": "02:18:15", "text": "それを使ってください。安っぽいタイプだ。"}, {"type": "subtitle", "time": 8297.11, "timestamp": "02:18:17", "text": "私が送った絵文字、覚えてるよね？その"}, {"type": "subtitle", "time": 8302.469, "timestamp": "02:18:22", "text": "そのデザインに基づいて。ああ、そうだね。"}, {"type": "subtitle", "time": 8308.87, "timestamp": "02:18:28", "text": "ええ、そういうことなんです。時々"}, {"type": "subtitle", "time": 8310.549, "timestamp": "02:18:30", "text": "うーん、本当に気をつけないと"}, {"type": "subtitle", "time": 8312.549, "timestamp": "02:18:32", "text": "Windowsを再インストールするとき"}, {"type": "subtitle", "time": 8314.23, "timestamp": "02:18:34", "text": "などなど、すべてバックアップする必要があります"}, {"type": "subtitle", "time": 8316.309, "timestamp": "02:18:36", "text": "物事。そして、バックしようとすることを想像してみてください"}, {"type": "subtitle", "time": 8318.469, "timestamp": "02:18:38", "text": "物事を上達させると、"}, {"type": "subtitle", "time": 8321.27, "timestamp": "02:18:41", "text": "あなたは本当に整理整頓が苦手ですね。私の持ち物は"}, {"type": "subtitle", "time": 8323.19, "timestamp": "02:18:43", "text": "とても整理されておらず、"}, {"type": "subtitle", "time": 8324.629, "timestamp": "02:18:44", "text": "バックアップすべきものとそうでないものを覚えておいてください"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "やってはいけないことを決めるのは、とてもとても難しいことです。"}, {"type": "subtitle", "time": 8329.799, "timestamp": "02:18:49", "text": "かなり難しいことだ。"}, {"type": "subtitle", "time": 8336.87, "timestamp": "02:18:56", "text": "バックアップしなきゃいけないものが山ほどある。私"}, {"type": "subtitle", "time": 8338.91, "timestamp": "02:18:58", "text": "忘れた"}]
[{"type": "subtitle", "time": 1922.71, "timestamp": "00:32:02", "text": "今日で2週目です。うん。による"}, {"type": "subtitle", "time": 1924.63, "timestamp": "00:32:04", "text": "来週の土曜日、私は"}, {"type": "subtitle", "time": 1926.47, "timestamp": "00:32:06", "text": "すべての"}, {"type": "subtitle", "time": 1929.43, "timestamp": "00:32:09", "text": "ああ、そうだね。 6月21日、私は"}, {"type": "subtitle", "time": 1931.99, "timestamp": "00:32:11", "text": "コラボレーションとか、その他諸々すべてに対応しています。"}, {"type": "subtitle", "time": 1933.83, "timestamp": "00:32:13", "text": "くそ。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "うん。そして私は、うーん、そうは思わない"}, {"type": "chat", "time": 1938.205, "timestamp": "00:32:18", "author": "@zephyrus7974", "avatar": "https://yt4.ggpht.com/JfzO9yJBgCTwx5iYOuRpHQTwEbH4a2nVduwoOVSVWWNy2uJtEuLnjZgYThfjnaNLUkzG5JOf=s64-c-k-c0x00ffffff-no-rj", "message": "im getting an ad for an adblocker"}, {"type": "subtitle", "time": 1940.43, "timestamp": "00:32:20", "text": "どれくらいかかるか分かる"}, {"type": "subtitle", "time": 1944.23, "timestamp": "00:32:24", "text": "実行中。私はその日を終わらせたいと思っています"}, {"type": "subtitle", "time": 1946.63, "timestamp": "00:32:26", "text": "荷物をまとめて出て行かなければならないような状況"}, {"type": "subtitle", "time": 1948.95, "timestamp": "00:32:28", "text": "だって、今退屈なんだもん。"}, {"type": "subtitle", "time": 1951.59, "timestamp": "00:32:31", "text": "私は、えっと、私は、これを"}, {"type": "subtitle", "time": 1955.509, "timestamp": "00:32:35", "text": "24時間。私は「えーと、したくない」って感じ"}, {"type": "subtitle", "time": 1958.87, "timestamp": "00:32:38", "text": "じっとしていてください。私はただ寄り道して"}, {"type": "subtitle", "time": 1962.07, "timestamp": "00:32:42", "text": "皆と一緒にこの瞬間を分かち合おう。"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "ええ、そうですね。うん。だから私は「うん、行くよ」って言ったんだ"}, {"type": "subtitle", "time": 1969.35, "timestamp": "00:32:49", "text": "えっと、私がそれを終わらせることができるまで。私はします"}, {"type": "subtitle", "time": 1971.19, "timestamp": "00:32:51", "text": "いい数字で締めくくりたいけど"}, {"type": "subtitle", "time": 1974.63, "timestamp": "00:32:54", "text": "100くらいかな。 89日目です。"}, {"type": "subtitle", "time": 1978.389, "timestamp": "00:32:58", "text": "明日は90歳になる。間違いない。うん。あと10件"}]
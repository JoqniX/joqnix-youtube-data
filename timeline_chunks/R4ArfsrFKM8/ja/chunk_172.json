[{"type": "subtitle", "time": 10320.07, "timestamp": "02:52:00", "text": "バネとか、その他諸々。"}, {"type": "subtitle", "time": 10323.269, "timestamp": "02:52:03", "text": "うん。待ちきれないよ。"}, {"type": "subtitle", "time": 10324.95, "timestamp": "02:52:04", "text": "それは良い。見てみましょう。あなたもそう思いませんか？"}, {"type": "subtitle", "time": 10327.75, "timestamp": "02:52:07", "text": "インドにも温泉はありますか？私"}, {"type": "subtitle", "time": 10331.269, "timestamp": "02:52:11", "text": "彼らはそう思う。わからない。ええ、私は"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "私もよくわかりません。でも、聞いたような気がする"}, {"type": "subtitle", "time": 10334.63, "timestamp": "02:52:14", "text": "ここには温泉があるが、"}, {"type": "subtitle", "time": 10337.51, "timestamp": "02:52:17", "text": "もちろん。うん。サウナなどがある"}, {"type": "subtitle", "time": 10339.269, "timestamp": "02:52:19", "text": "今の日本。存在するかどうかはわかりません"}, {"type": "subtitle", "time": 10340.95, "timestamp": "02:52:20", "text": "ここ。"}, {"type": "subtitle", "time": 10344.389, "timestamp": "02:52:24", "text": "サウナは利用できますが、馬は"}, {"type": "subtitle", "time": 10346.71, "timestamp": "02:52:26", "text": "自然な感じですよね？"}, {"type": "subtitle", "time": 10349.75, "timestamp": "02:52:29", "text": "人工的な。なので、どこにでも建てることができます。"}, {"type": "subtitle", "time": 10352.23, "timestamp": "02:52:32", "text": "しかし、温泉は自然のようなものです。だからそれは"}, {"type": "subtitle", "time": 10357.389, "timestamp": "02:52:37", "text": "見つけるのはちょっと難しいと思う。"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "ええ、おっしゃる通りです。うん。でも、そうですね、"}, {"type": "chat", "time": 10363.01, "timestamp": "02:52:43", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hello"}, {"type": "subtitle", "time": 10364.55, "timestamp": "02:52:44", "text": "温泉の写真も撮ってください。"}, {"type": "subtitle", "time": 10366.389, "timestamp": "02:52:46", "text": "うん、いい感じだね。いくつか"}, {"type": "chat", "time": 10366.938, "timestamp": "02:52:46", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "good morning"}, {"type": "subtitle", "time": 10369.269, "timestamp": "02:52:49", "text": "サルも同様に参加しています"}, {"type": "subtitle", "time": 10371.19, "timestamp": "02:52:51", "text": "ミッションアニメとか、そういうの全部。の"}, {"type": "subtitle", "time": 10379.03, "timestamp": "02:52:59", "text": "うん。それで、私は首都に行く"}]
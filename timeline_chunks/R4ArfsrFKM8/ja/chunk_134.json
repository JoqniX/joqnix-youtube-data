[{"type": "subtitle", "time": 8041.51, "timestamp": "02:14:01", "text": "H つまり、日本から買うと"}, {"type": "subtitle", "time": 8044.39, "timestamp": "02:14:04", "text": "日本のカスタムを手に入れるつもり"}, {"type": "subtitle", "time": 8047.47, "timestamp": "02:14:07", "text": "それについて声を発する。デフォルトでは「いいえ」になります"}, {"type": "subtitle", "time": 8049.91, "timestamp": "02:14:09", "text": "日本語。再インストールが必要になります"}, {"type": "subtitle", "time": 8053.589, "timestamp": "02:14:13", "text": "その物。うーん、分かりません。多分"}, {"type": "subtitle", "time": 8056.149, "timestamp": "02:14:16", "text": "そちらにはもっとお得な商品もありますよ。"}, {"type": "subtitle", "time": 8058.55, "timestamp": "02:14:18", "text": "可能性はある。我々が持っているもののように"}, {"type": "subtitle", "time": 8061.189, "timestamp": "02:14:21", "text": "輸入税などすべてここにあり、"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "そこでは仕入税が少なくなる可能性がある。"}, {"type": "subtitle", "time": 8064.069, "timestamp": "02:14:24", "text": "つまり、"}, {"type": "subtitle", "time": 8067.03, "timestamp": "02:14:27", "text": "そこにノートパソコンがある。可能性はある。"}, {"type": "subtitle", "time": 8069.83, "timestamp": "02:14:29", "text": "おそらくチェックすることをお勧めします"}, {"type": "subtitle", "time": 8073.35, "timestamp": "02:14:33", "text": "日本のオンライン小売店と"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "彼らがどのような仕様をどのような価格で提供しているか見てみましょう"}, {"type": "subtitle", "time": 8077.75, "timestamp": "02:14:37", "text": "そしてそれを私たちのオンラインと比較してください"}, {"type": "subtitle", "time": 8080.229, "timestamp": "02:14:40", "text": "ここにはお店があります。うん。そうすれば"}, {"type": "subtitle", "time": 8082.47, "timestamp": "02:14:42", "text": "価値があるかどうかよくわかる"}, {"type": "subtitle", "time": 8089.91, "timestamp": "02:14:49", "text": "うん。待って、ノートパソコンか"}, {"type": "subtitle", "time": 8092.47, "timestamp": "02:14:52", "text": "デスクトップ？デスクトップ版ですよね？うん、"}, {"type": "subtitle", "time": 8094.55, "timestamp": "02:14:54", "text": "私はデスクトップパソコンを使っています。"}, {"type": "subtitle", "time": 8097.03, "timestamp": "02:14:57", "text": "何かおすすめはありますか？"}, {"type": "subtitle", "time": 8099.669, "timestamp": "02:14:59", "text": "ゲーミングノートPCとかにも当てはまるの？私"}]
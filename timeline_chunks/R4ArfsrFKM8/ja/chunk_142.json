[{"type": "subtitle", "time": 8521.51, "timestamp": "02:22:01", "text": "自分。えっと、タイタンフォール2を覚えていますか？"}, {"type": "subtitle", "time": 8525.11, "timestamp": "02:22:05", "text": "私たちがコラボした？楽しかった。ええ、そうですね。"}, {"type": "subtitle", "time": 8527.83, "timestamp": "02:22:07", "text": "とても楽しかったよ。ええ、それは"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "本当に楽しかった。そして、サクラとエイペックス"}, {"type": "subtitle", "time": 8533.79, "timestamp": "02:22:13", "text": "もの。"}, {"type": "subtitle", "time": 8536.79, "timestamp": "02:22:16", "text": "ええ、私たちはたくさんのことを一緒にしました。"}, {"type": "subtitle", "time": 8539.23, "timestamp": "02:22:19", "text": "私は今でも彼らのことを覚えている。私はこう思う、"}, {"type": "subtitle", "time": 8545.79, "timestamp": "02:22:25", "text": "しかし"}, {"type": "subtitle", "time": 8549.51, "timestamp": "02:22:29", "text": "うん。ええ、そうですね。それからあなたはもっと忙しくなった"}, {"type": "subtitle", "time": 8552.15, "timestamp": "02:22:32", "text": "「ああ、そうだね」ファンタジーはどうですか"}, {"type": "subtitle", "time": 8554.389, "timestamp": "02:22:34", "text": "最近はどんなことが起こっているの？"}, {"type": "subtitle", "time": 8556.15, "timestamp": "02:22:36", "text": "順調に進んでいます。私は"}, {"type": "subtitle", "time": 8558.95, "timestamp": "02:22:38", "text": "最近はもっとリラックスしてのんびりしているから"}, {"type": "subtitle", "time": 8560.389, "timestamp": "02:22:40", "text": "私の作品はご存知でしょうし、"}, {"type": "subtitle", "time": 8564.389, "timestamp": "02:22:44", "text": "わかってるけど、まあまあうまくいってるよ"}, {"type": "subtitle", "time": 8567.389, "timestamp": "02:22:47", "text": "まあまあまともな出版社からの移転ですね。それで"}, {"type": "subtitle", "time": 8569.99, "timestamp": "02:22:49", "text": "基本的に10セントはもう責任者ではない"}, {"type": "subtitle", "time": 8573.83, "timestamp": "02:22:53", "text": "タワー・オブ・ファンタジーの。えっと、それは彼らの"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "オリジナルのスタジオは"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "中国のオリジナル出版社"}]
[{"type": "subtitle", "time": 361.83, "timestamp": "00:06:01", "text": "内部。だから私は外を内側に取り込む"}, {"type": "subtitle", "time": 366.07, "timestamp": "00:06:06", "text": "部屋と、どうやらその日、この"}, {"type": "subtitle", "time": 369.99, "timestamp": "00:06:09", "text": "車両、えっと、こんなことが今起こった"}, {"type": "subtitle", "time": 373.59, "timestamp": "00:06:13", "text": "そして私の部屋全体が"}, {"type": "subtitle", "time": 376.79, "timestamp": "00:06:16", "text": "ガス。私はまるで窒息しそうだった"}, {"type": "subtitle", "time": 380.07, "timestamp": "00:06:20", "text": "多く。ああ、痛い。そんな日が来る"}, {"type": "subtitle", "time": 382.029, "timestamp": "00:06:22", "text": "日々は"}, {"type": "subtitle", "time": 386.55, "timestamp": "00:06:26", "text": "痛み。もう話は終わりにしよう。えっと、"}, {"type": "subtitle", "time": 398.87, "timestamp": "00:06:38", "text": "モード。推奨設定、ウィンドウ"}, {"type": "subtitle", "time": 402.469, "timestamp": "00:06:42", "text": "キャプチャと観察に役立つ境界のない"}, {"type": "subtitle", "time": 404.11, "timestamp": "00:06:44", "text": "ゲーム。"}, {"type": "subtitle", "time": 413.83, "timestamp": "00:06:53", "text": "わかった。待って、枠線なしってどうやって使うの？"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "わかった。国境のない。"}]
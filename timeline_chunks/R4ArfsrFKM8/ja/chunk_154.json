[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "その時、私たちはたくさんの喧嘩をしていた"}, {"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "このアリーナとその他すべて、そしてその後"}, {"type": "subtitle", "time": 9247.03, "timestamp": "02:34:07", "text": "またしても、私はそれに対して非常に熱心だった。私"}, {"type": "subtitle", "time": 9249.95, "timestamp": "02:34:09", "text": "かなり、ただ持って行きたかっただけです"}, {"type": "subtitle", "time": 9252.55, "timestamp": "02:34:12", "text": "私がスターで見た体験"}, {"type": "subtitle", "time": 9254.95, "timestamp": "02:34:14", "text": "シチズンからタワーオブファンタジーへ、そしてそれは"}, {"type": "subtitle", "time": 9256.79, "timestamp": "02:34:16", "text": "私をずっと続けさせてくれたのは"}, {"type": "subtitle", "time": 9259.07, "timestamp": "02:34:19", "text": "タワーオブファンタジーに新しいイベントを導入"}, {"type": "subtitle", "time": 9262.469, "timestamp": "02:34:22", "text": "コミュニティがあり、私がそうすると、"}, {"type": "subtitle", "time": 9264.99, "timestamp": "02:34:24", "text": "Halのサーバー専用のコミュニティ"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "ノヴァで私は最終的に"}, {"type": "subtitle", "time": 9270.71, "timestamp": "02:34:30", "text": "最終的にリードを獲得したのは"}, {"type": "subtitle", "time": 9272.15, "timestamp": "02:34:32", "text": "うまく管理する私は最終的に"}, {"type": "subtitle", "time": 9274.469, "timestamp": "02:34:34", "text": "コミュニティマネージャーは、"}, {"type": "subtitle", "time": 9276.63, "timestamp": "02:34:36", "text": "高齢者の方々は、モッズやイングのために"}, {"type": "subtitle", "time": 9279.95, "timestamp": "02:34:39", "text": "管理者が辞任したので、"}, {"type": "subtitle", "time": 9283.349, "timestamp": "02:34:43", "text": "これらのイベントすべてを行うことに専念していた"}, {"type": "subtitle", "time": 9286.07, "timestamp": "02:34:46", "text": "そして、彼らがリードを譲ったものを管理"}, {"type": "subtitle", "time": 9289.03, "timestamp": "02:34:49", "text": "私にとって。そうやって私はリーダーになったのです"}, {"type": "subtitle", "time": 9292.79, "timestamp": "02:34:52", "text": "私のarogiサーバーと並んでそのサーバーは"}, {"type": "subtitle", "time": 9294.389, "timestamp": "02:34:54", "text": "のように"}, {"type": "subtitle", "time": 9296.91, "timestamp": "02:34:56", "text": "物事を確立し、コミュニティを運営する"}, {"type": "subtitle", "time": 9299.27, "timestamp": "02:34:59", "text": "イベント、さまざまなことをする"}]
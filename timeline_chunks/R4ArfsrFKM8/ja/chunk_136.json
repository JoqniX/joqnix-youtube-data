[{"type": "subtitle", "time": 8161.35, "timestamp": "02:16:01", "text": "最終的にはアップグレードするだけだよ、ねえ"}, {"type": "subtitle", "time": 8163.109, "timestamp": "02:16:03", "text": "同じCPUは不要です"}, {"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "将来的に別のCPUにアップグレードする"}, {"type": "subtitle", "time": 8167.109, "timestamp": "02:16:07", "text": "将来的に別のGPUにアップグレードする"}, {"type": "subtitle", "time": 8168.629, "timestamp": "02:16:08", "text": "あるいは、そんな感じ。きれい"}, {"type": "subtitle", "time": 8170.99, "timestamp": "02:16:10", "text": "ニース。"}, {"type": "subtitle", "time": 8172.75, "timestamp": "02:16:12", "text": "うん。それで"}, {"type": "subtitle", "time": 8175.83, "timestamp": "02:16:15", "text": "私は、"}, {"type": "subtitle", "time": 8180.47, "timestamp": "02:16:20", "text": "ミニPC？ミニPCは良いのか、それともそうでもないのか？"}, {"type": "subtitle", "time": 8184.229, "timestamp": "02:16:24", "text": "もちろん。レインボーはミニPCをハッキングするんだよ"}, {"type": "subtitle", "time": 8187.43, "timestamp": "02:16:27", "text": "ミニはいいみたいだけど、"}, {"type": "subtitle", "time": 8189.03, "timestamp": "02:16:29", "text": "モニターも必要だし、"}, {"type": "subtitle", "time": 8192.549, "timestamp": "02:16:32", "text": "それと並んで何か。ああ、それは[ __ ]ユー"}, {"type": "subtitle", "time": 8193.99, "timestamp": "02:16:33", "text": "別途キーボードも必要"}, {"type": "subtitle", "time": 8196.469, "timestamp": "02:16:36", "text": "そしてノートパソコンではマウスはすべて"}, {"type": "subtitle", "time": 8204.879, "timestamp": "02:16:44", "text": "確かにその通りです"}, {"type": "subtitle", "time": 8206.75, "timestamp": "02:16:46", "text": "[音楽]"}, {"type": "subtitle", "time": 8210.309, "timestamp": "02:16:50", "text": "うん、本当にいろいろあるよ"}, {"type": "subtitle", "time": 8211.95, "timestamp": "02:16:51", "text": "うん"}, {"type": "subtitle", "time": 8215.349, "timestamp": "02:16:55", "text": "それはあなたが本当に新しいものである"}, {"type": "subtitle", "time": 8217.86, "timestamp": "02:16:57", "text": "いつもそうだったわけではない。"}]
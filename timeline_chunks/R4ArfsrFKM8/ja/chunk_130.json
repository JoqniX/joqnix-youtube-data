[{"type": "subtitle", "time": 7803.35, "timestamp": "02:10:03", "text": "デッドマッチとか、えーとタグをプレイとか"}, {"type": "subtitle", "time": 7806.47, "timestamp": "02:10:06", "text": "何か。まるでウルトラが分割されていないかのようだ"}, {"type": "subtitle", "time": 7807.47, "timestamp": "02:10:07", "text": "ゲート。"}, {"type": "subtitle", "time": 7810.55, "timestamp": "02:10:10", "text": "えっと、そのゲームの名前は何でしたっけ？ああ、"}, {"type": "subtitle", "time": 7814.39, "timestamp": "02:10:14", "text": "神。えっと、ボディカメラ。そう、あのゲームね。ああ、"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "神。ボディカメラ。うん。ああ、わかりました。となることによって"}, {"type": "chat", "time": 7819.068, "timestamp": "02:10:19", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "cod ?"}, {"type": "subtitle", "time": 7822.95, "timestamp": "02:10:22", "text": "コンピューターで何かする。ええと、それは"}, {"type": "subtitle", "time": 7828.709, "timestamp": "02:10:28", "text": "まるで超リアルなゲームみたいだ。えっと、えっと、私は"}, {"type": "subtitle", "time": 7832.229, "timestamp": "02:10:32", "text": "ゲームを実行したときに、CPU が"}, {"type": "subtitle", "time": 7837.83, "timestamp": "02:10:37", "text": "GPUの使用率は完全に100%でした。だからたとえ私が"}, {"type": "subtitle", "time": 7839.91, "timestamp": "02:10:39", "text": "当時はマルチストリーミングで"}, {"type": "subtitle", "time": 7843.03, "timestamp": "02:10:43", "text": "5つのプラットフォームがあり、それはその時代のことでした"}, {"type": "subtitle", "time": 7845.91, "timestamp": "02:10:45", "text": "私は、えっと、私はしていなかったと思います"}, {"type": "subtitle", "time": 7848.39, "timestamp": "02:10:48", "text": "クラウドをローカルで実行しながら、"}, {"type": "subtitle", "time": 7851.51, "timestamp": "02:10:51", "text": "ヘビーゲーム。それで何が起こったかというと"}, {"type": "subtitle", "time": 7854.87, "timestamp": "02:10:54", "text": "モニターが真っ暗になった。"}]
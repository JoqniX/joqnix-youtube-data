[{"type": "subtitle", "time": 300.43, "timestamp": "00:05:00", "text": "あまりにも。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 304.469, "timestamp": "00:05:04", "text": "何をしているの？あ、待って。えっと、私は思う"}, {"type": "subtitle", "time": 306.51, "timestamp": "00:05:06", "text": "人工呼吸器を少し作動させる必要がある"}, {"type": "subtitle", "time": 309.55, "timestamp": "00:05:09", "text": "素早い。だから、"}, {"type": "subtitle", "time": 313.83, "timestamp": "00:05:13", "text": "週末には車があります"}, {"type": "subtitle", "time": 316.469, "timestamp": "00:05:16", "text": "私の家のように通り過ぎるものは"}, {"type": "subtitle", "time": 319.99, "timestamp": "00:05:19", "text": "道路脇の路肩。つまり、乗り物"}, {"type": "subtitle", "time": 322.83, "timestamp": "00:05:22", "text": "毒素を多く含む通路"}, {"type": "subtitle", "time": 325.43, "timestamp": "00:05:25", "text": "サボテンは蚊よけのため"}, {"type": "subtitle", "time": 328.87, "timestamp": "00:05:28", "text": "死ぬこと、そしてその他すべて。濃い霧がかかっている"}, {"type": "subtitle", "time": 331.51, "timestamp": "00:05:31", "text": "煙のようなもの。"}, {"type": "subtitle", "time": 333.469, "timestamp": "00:05:33", "text": "あなたが知っている、"}, {"type": "subtitle", "time": 336.15, "timestamp": "00:05:36", "text": "ええ、私は"}, {"type": "subtitle", "time": 338.87, "timestamp": "00:05:38", "text": "人工呼吸器みたいなもの。えっと、できない"}, {"type": "subtitle", "time": 342.07, "timestamp": "00:05:42", "text": "息をする。それは痛みだ。そして私の窓は"}, {"type": "subtitle", "time": 343.79, "timestamp": "00:05:43", "text": "こちらも閉店しました。"}, {"type": "subtitle", "time": 353.029, "timestamp": "00:05:53", "text": "上。いつかこれが"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "起こった、私は換気をしていた、"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "換気装置、ファンが回っている"}]
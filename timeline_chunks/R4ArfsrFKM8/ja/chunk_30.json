[{"type": "subtitle", "time": 1801.83, "timestamp": "00:30:01", "text": "ああ、すごく興奮したよ。うん。遊ぶ"}, {"type": "subtitle", "time": 1804.789, "timestamp": "00:30:04", "text": "君とかそういうやつ。私は持っていません 私は持っています"}, {"type": "subtitle", "time": 1808.31, "timestamp": "00:30:08", "text": "あなたの配信とかを見てます。私はします"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "時々乗るけど、私の人生は"}, {"type": "subtitle", "time": 1814.95, "timestamp": "00:30:14", "text": "最近は本当に荷物が詰まっていて、"}, {"type": "subtitle", "time": 1816.95, "timestamp": "00:30:16", "text": "それでもなんとかあなたの配信を見に来ました。"}, {"type": "subtitle", "time": 1819.11, "timestamp": "00:30:19", "text": "ええ、ついにチャンスが訪れました"}, {"type": "subtitle", "time": 1827.909, "timestamp": "00:30:27", "text": "ありがとう。ありがとう。私は 私は 私は いいえ"}, {"type": "subtitle", "time": 1830.47, "timestamp": "00:30:30", "text": "問題。あなたが私を見ているとは知らなかったし"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "いろいろあったけど、ありがとう。"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "ほとんどの場合、あなたはこう思う"}, {"type": "subtitle", "time": 1838.63, "timestamp": "00:30:38", "text": "活動的でない、または眠っているような状態。だから大丈夫だよ。"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "私はそこにいて、しばらく潜伏している"}, {"type": "subtitle", "time": 1852.75, "timestamp": "00:30:52", "text": "本日ここにお招きいただき、光栄です。ニース。"}, {"type": "subtitle", "time": 1856.95, "timestamp": "00:30:56", "text": "はい。えっと、あなたは活動休止中だったんですよね？"}]
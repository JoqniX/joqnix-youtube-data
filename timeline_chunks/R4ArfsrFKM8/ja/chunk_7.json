[{"type": "subtitle", "time": 421.309, "timestamp": "00:07:01", "text": "しかし、これだけはやってみてください。どうやら、"}, {"type": "subtitle", "time": 425.39, "timestamp": "00:07:05", "text": "えーっと、風、ジャンプのためのゲームキャプチャ"}, {"type": "subtitle", "time": 428.11, "timestamp": "00:07:08", "text": "ジャンプとは、"}, {"type": "subtitle", "time": 433.749, "timestamp": "00:07:13", "text": "痛みはあるけど、大丈夫。では、切り替えましょう"}, {"type": "subtitle", "time": 436.27, "timestamp": "00:07:16", "text": "さっと済ませて、あとはリラックスしよう。"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "わかった。私たちはここでくつろぎながら話をします"}, {"type": "subtitle", "time": 440.189, "timestamp": "00:07:20", "text": "ストリーム。"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "わかった。それでは、シーンをゲームに切り替えましょう。"}, {"type": "subtitle", "time": 453.07, "timestamp": "00:07:33", "text": "よし、ちょっと声を加えてみた"}, {"type": "subtitle", "time": 458.11, "timestamp": "00:07:38", "text": "コマンド。ということで、新しいものが"}, {"type": "subtitle", "time": 460.87, "timestamp": "00:07:40", "text": "トゥイッチ。たくさんのものを追加しました"}, {"type": "subtitle", "time": 462.749, "timestamp": "00:07:42", "text": "Twitch関連、"}, {"type": "subtitle", "time": 466.43, "timestamp": "00:07:46", "text": "男。うん、ネタバレしたくないんだ。"}, {"type": "subtitle", "time": 469.83, "timestamp": "00:07:49", "text": "でも、新しいものをお見せするのが待ちきれません"}, {"type": "subtitle", "time": 473.43, "timestamp": "00:07:53", "text": "私がTwitch関連でやったこと。"}, {"type": "subtitle", "time": 477.469, "timestamp": "00:07:57", "text": "これを使うのが待ち遠しい。多くの新しい"}, {"type": "subtitle", "time": 479.749, "timestamp": "00:07:59", "text": "もの。配信を楽しんでください。また、"}]
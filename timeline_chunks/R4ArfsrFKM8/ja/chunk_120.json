[{"type": "subtitle", "time": 7201.07, "timestamp": "02:00:01", "text": "サブレと、えーと"}, {"type": "subtitle", "time": 7204.87, "timestamp": "02:00:04", "text": "インヴァー、広告のような投稿をしたね"}, {"type": "subtitle", "time": 7207.03, "timestamp": "02:00:07", "text": "プロを宣伝するときのあれこれ"}, {"type": "subtitle", "time": 7209.589, "timestamp": "02:00:09", "text": "デビュー配信を宣伝しましょう。そうそう"}, {"type": "subtitle", "time": 7211.589, "timestamp": "02:00:11", "text": "ああ、やったよ。忘れてた。ええ、そうしました"}, {"type": "subtitle", "time": 7214.39, "timestamp": "02:00:14", "text": "あのポスターとか、全部。それ"}, {"type": "subtitle", "time": 7217.83, "timestamp": "02:00:17", "text": "とても独創的だった。私は誰も見たことがない"}, {"type": "subtitle", "time": 7221.87, "timestamp": "02:00:21", "text": "あの時のことだ。あれはすごくかっこよかった。そして"}, {"type": "subtitle", "time": 7225.27, "timestamp": "02:00:25", "text": "ええ、デビュー配信も"}, {"type": "subtitle", "time": 7228.95, "timestamp": "02:00:28", "text": "レベル。何てことだ。"}, {"type": "subtitle", "time": 7232.629, "timestamp": "02:00:32", "text": "はい。まさにその通りでした。それは少し"}, {"type": "subtitle", "time": 7234.07, "timestamp": "02:00:34", "text": "正直言って、気まずい。まるで私が見るように"}, {"type": "subtitle", "time": 7236.31, "timestamp": "02:00:36", "text": "今振り返ってみると、"}, {"type": "subtitle", "time": 7237.99, "timestamp": "02:00:37", "text": "追悼ストリーム、私はちょっと"}, {"type": "subtitle", "time": 7240.149, "timestamp": "02:00:40", "text": "当時私は恥ずかしかった"}, {"type": "subtitle", "time": 7241.589, "timestamp": "02:00:41", "text": "本当に話すのが上手で"}, {"type": "subtitle", "time": 7244.03, "timestamp": "02:00:44", "text": "すべて。だから私は"}, {"type": "subtitle", "time": 7247.589, "timestamp": "02:00:47", "text": "あなたみたいな人がこういうのを手に入れられる"}, {"type": "subtitle", "time": 7249.27, "timestamp": "02:00:49", "text": "不快な感じですよね？あなた"}, {"type": "subtitle", "time": 7251.99, "timestamp": "02:00:51", "text": "聞いてみたら、うーんって感じになるだろう"}, {"type": "subtitle", "time": 7254.87, "timestamp": "02:00:54", "text": "あなたは何と言いますか？ゾッとする感じ。うん。"}, {"type": "subtitle", "time": 7257.03, "timestamp": "02:00:57", "text": "うん。ゾッとする感じ。だからあなたはそう感じる"}, {"type": "subtitle", "time": 7259.99, "timestamp": "02:00:59", "text": "この男はちょっとあまり話していない"}]
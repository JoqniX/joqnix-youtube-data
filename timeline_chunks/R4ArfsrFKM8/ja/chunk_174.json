[{"type": "subtitle", "time": 10443.51, "timestamp": "02:54:03", "text": "待って。まるであなたが夢中になっているとき"}, {"type": "subtitle", "time": 10445.83, "timestamp": "02:54:05", "text": "新鮮な空気を吸いたいときは、"}, {"type": "subtitle", "time": 10449.83, "timestamp": "02:54:09", "text": "山々が見える、感じられる。山々を感じられる。"}, {"type": "subtitle", "time": 10453.349, "timestamp": "02:54:13", "text": "空からの景色を楽しみ、自然と一体になる"}, {"type": "subtitle", "time": 10456.83, "timestamp": "02:54:16", "text": "今はそんな感じです。はい。だから私は"}, {"type": "subtitle", "time": 10460.469, "timestamp": "02:54:20", "text": "興奮した。うまくいくといいな。"}, {"type": "subtitle", "time": 10462.55, "timestamp": "02:54:22", "text": "ええ、私もそう願っています。見た目"}, {"type": "subtitle", "time": 10466.67, "timestamp": "02:54:26", "text": "楽しみにしています。自分、"}, {"type": "subtitle", "time": 10469.15, "timestamp": "02:54:29", "text": "あまりにも。できない"}, {"type": "subtitle", "time": 10472.55, "timestamp": "02:54:32", "text": "待って。 12時です。いいえ、あなたも行くべきです"}, {"type": "subtitle", "time": 10475.349, "timestamp": "02:54:35", "text": "寝る。あなたはいつ寝ますか？実は、"}, {"type": "subtitle", "time": 10483.83, "timestamp": "02:54:43", "text": "でも、今日はありがとうございました。"}, {"type": "subtitle", "time": 10486.23, "timestamp": "02:54:46", "text": "本当に楽しい"}, {"type": "subtitle", "time": 10488.63, "timestamp": "02:54:48", "text": "はい、招待してくれてありがとう。"}, {"type": "subtitle", "time": 10490.95, "timestamp": "02:54:50", "text": "かなり楽しい1時間があっという間に過ぎました"}, {"type": "subtitle", "time": 10494.469, "timestamp": "02:54:54", "text": "それに気づいてもそうだね"}, {"type": "subtitle", "time": 10496.95, "timestamp": "02:54:56", "text": "うん、たくさん話したよ、本当に"}]
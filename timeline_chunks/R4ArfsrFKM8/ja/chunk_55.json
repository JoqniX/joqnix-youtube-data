[{"type": "subtitle", "time": 3301.19, "timestamp": "00:55:01", "text": "音声が聞こえないので最悪です"}, {"type": "subtitle", "time": 3305.47, "timestamp": "00:55:05", "text": "良い。私もナレーションを入れるべきだと思う"}, {"type": "subtitle", "time": 3309.43, "timestamp": "00:55:09", "text": "私の。でも、すぐにやめるべきだ。"}, {"type": "subtitle", "time": 3312.549, "timestamp": "00:55:12", "text": "うん、バッテリーが膨張するのは怖いよね。知っている"}, {"type": "subtitle", "time": 3316.03, "timestamp": "00:55:16", "text": "右。 Mパフ"}, {"type": "subtitle", "time": 3319.27, "timestamp": "00:55:19", "text": "バッテリーと、そう、私の携帯電話に問題がある"}, {"type": "subtitle", "time": 3322.87, "timestamp": "00:55:22", "text": "バッテリーはあまり長持ちしないので"}, {"type": "subtitle", "time": 3324.87, "timestamp": "00:55:24", "text": "2時間ごとに充電し続けなければならない"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "あるいは、そんな感じ。それほどひどい状況で、私は"}, {"type": "subtitle", "time": 3331.109, "timestamp": "00:55:31", "text": "常に充電しておくこと。"}, {"type": "subtitle", "time": 3333.27, "timestamp": "00:55:33", "text": "それが私の抱えていた問題でした。以前はよく＿＿していた"}, {"type": "subtitle", "time": 3335.51, "timestamp": "00:55:35", "text": "一晩中充電しておいてください"}, {"type": "subtitle", "time": 3338.87, "timestamp": "00:55:38", "text": "そしてそれはドーンと始まった。私はこう思った。"}, {"type": "subtitle", "time": 3343.03, "timestamp": "00:55:43", "text": "「ちくしょう。」私は自分の"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "自分の手で。やったよ。そして今はもう"}, {"type": "subtitle", "time": 3348.589, "timestamp": "00:55:48", "text": "良い携帯電話を持っている。古いものを使っています。"}, {"type": "subtitle", "time": 3352.39, "timestamp": "00:55:52", "text": "だから、次は新しい携帯電話が手に入るといいな。"}, {"type": "subtitle", "time": 3354.77, "timestamp": "00:55:54", "text": "年。"}]
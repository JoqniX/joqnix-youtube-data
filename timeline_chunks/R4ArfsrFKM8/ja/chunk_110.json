[{"type": "subtitle", "time": 6601.35, "timestamp": "01:50:01", "text": "[音楽]"}, {"type": "subtitle", "time": 6604.03, "timestamp": "01:50:04", "text": "これらを集めなくても構わないと思います"}, {"type": "subtitle", "time": 6606.31, "timestamp": "01:50:06", "text": "泡。主なことは、"}, {"type": "subtitle", "time": 6608.47, "timestamp": "01:50:08", "text": "に"}, {"type": "subtitle", "time": 6612.27, "timestamp": "01:50:12", "text": "[音楽]"}, {"type": "subtitle", "time": 6620.36, "timestamp": "01:50:20", "text": "良い。"}, {"type": "subtitle", "time": 6622.75, "timestamp": "01:50:22", "text": "[音楽]"}, {"type": "subtitle", "time": 6630.229, "timestamp": "01:50:30", "text": "指輪を見逃したのは、えっと"}, {"type": "subtitle", "time": 6632.91, "timestamp": "01:50:32", "text": "変動している。ああ、"}, {"type": "subtitle", "time": 6636.95, "timestamp": "01:50:36", "text": "神。何てことだ。指輪を逃してしまった。どうやって"}, {"type": "subtitle", "time": 6640.39, "timestamp": "01:50:40", "text": "とても順調だった。私はとても順調だった。"}, {"type": "subtitle", "time": 6643.109, "timestamp": "01:50:43", "text": "そして、それがあなたに必要なことではない"}, {"type": "subtitle", "time": 6647.59, "timestamp": "01:50:47", "text": "不正行為をした。大丈夫ですよ。あなたの勝ちです。"}, {"type": "subtitle", "time": 6650.229, "timestamp": "01:50:50", "text": "私はとても順調だった。決意のスキル"}, {"type": "subtitle", "time": 6652.149, "timestamp": "01:50:52", "text": "1つのシングルから"}, {"type": "subtitle", "time": 6654.31, "timestamp": "01:50:54", "text": "勝利には意味がある。"}, {"type": "subtitle", "time": 6656.39, "timestamp": "01:50:56", "text": "あなたはひどいわけではないけれど、それでも"}, {"type": "subtitle", "time": 6657.91, "timestamp": "01:50:57", "text": "あなた自身を証明しなければならない"}]
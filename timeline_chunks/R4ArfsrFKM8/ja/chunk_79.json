[{"type": "subtitle", "time": 4740.63, "timestamp": "01:19:00", "text": "将来、私に知らせてください。わーい。こんにちは、いとこです"}, {"type": "subtitle", "time": 4743.27, "timestamp": "01:19:03", "text": "1000人くらいになったらやろうと思ってる"}, {"type": "subtitle", "time": 4745.91, "timestamp": "01:19:05", "text": "あるいは、そんな感じ。小規模な"}, {"type": "subtitle", "time": 4750.63, "timestamp": "01:19:10", "text": "えっと、小さなカラオケのことです。うん。私はただ"}, {"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "楽しみたいと思って"}, {"type": "subtitle", "time": 4756.39, "timestamp": "01:19:16", "text": "私の地域の人々は楽しんでいます。だから"}, {"type": "subtitle", "time": 4759.669, "timestamp": "01:19:19", "text": "小規模なイベントか何か。初めて"}, {"type": "subtitle", "time": 4761.91, "timestamp": "01:19:21", "text": "そうします。私はこのことを考えていました。それで"}, {"type": "subtitle", "time": 4764.51, "timestamp": "01:19:24", "text": "うん、そうだね"}, {"type": "subtitle", "time": 4768.79, "timestamp": "01:19:28", "text": "ニース。うん。ジョーに言うと、"}, {"type": "subtitle", "time": 4772.27, "timestamp": "01:19:32", "text": "彼女の前でそのミームを言ってみて。これ"}, {"type": "subtitle", "time": 4775.83, "timestamp": "01:19:35", "text": "ジュース。それをしたいのですか？ああ、忘れてた"}, {"type": "subtitle", "time": 4778.63, "timestamp": "01:19:38", "text": "その線。おお、"}, {"type": "subtitle", "time": 4781.83, "timestamp": "01:19:41", "text": "彼はここに書き留めている"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "チャット。何てことだ。ジョー、君はそうするべきだよ。"}, {"type": "subtitle", "time": 4788.55, "timestamp": "01:19:48", "text": "さあ行こう。皆さん、ジョックに拍手をお願いします。私たちは"}, {"type": "subtitle", "time": 4791.95, "timestamp": "01:19:51", "text": "必要だ。彼を盛り上げる必要がある"}]
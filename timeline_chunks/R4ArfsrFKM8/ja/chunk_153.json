[{"type": "subtitle", "time": 9181.429, "timestamp": "02:33:01", "text": "彼が辞任し始めたら"}, {"type": "subtitle", "time": 9183.83, "timestamp": "02:33:03", "text": "私が最終的に担当することになったゲーム"}, {"type": "subtitle", "time": 9187.03, "timestamp": "02:33:07", "text": "ギルドとすべての管理、そして"}, {"type": "subtitle", "time": 9189.429, "timestamp": "02:33:09", "text": "どういうわけかそれはそのまま続いていった"}, {"type": "subtitle", "time": 9192.309, "timestamp": "02:33:12", "text": "側。えっと、以前はStar Citizenをプレイしていました。"}, {"type": "subtitle", "time": 9194.309, "timestamp": "02:33:14", "text": "右？うん。うん。それで、私が使っていた頃は"}, {"type": "subtitle", "time": 9198.429, "timestamp": "02:33:18", "text": "Star Citizenをプレイするために、以前は好きだったのですが"}, {"type": "subtitle", "time": 9201.03, "timestamp": "02:33:21", "text": "えっと、以前はこのコミュニティをこう見ていました"}, {"type": "subtitle", "time": 9203.19, "timestamp": "02:33:23", "text": "スター紙が主催するイベント"}, {"type": "subtitle", "time": 9205.349, "timestamp": "02:33:25", "text": "市民コミュニティと私はとても"}, {"type": "subtitle", "time": 9208.07, "timestamp": "02:33:28", "text": "彼らに触発されて、それは"}, {"type": "subtitle", "time": 9209.75, "timestamp": "02:33:29", "text": "私がタワーに持っていきたかった"}, {"type": "subtitle", "time": 9212.309, "timestamp": "02:33:32", "text": "ファンタジーも含まれる。だから私は"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "10月に旅を始めました"}, {"type": "subtitle", "time": 9219.03, "timestamp": "02:33:39", "text": "2022年、ある単純な出来事がきっかけとなり"}, {"type": "subtitle", "time": 9222.23, "timestamp": "02:33:42", "text": "2人によるPVPマッチで"}, {"type": "subtitle", "time": 9226.63, "timestamp": "02:33:46", "text": "イベントを企画するというアイデアを私にくれた。だから私は"}, {"type": "subtitle", "time": 9230.469, "timestamp": "02:33:50", "text": "PVPのためにこのイベントを企画しました。"}, {"type": "subtitle", "time": 9233.429, "timestamp": "02:33:53", "text": "とても楽しかった。私たちはPVPマッチをしました"}, {"type": "subtitle", "time": 9236.15, "timestamp": "02:33:56", "text": "続いている。たくさんの人が来てくれた"}, {"type": "subtitle", "time": 9239.11, "timestamp": "02:33:59", "text": "そこには約60～100人がいて、"}]
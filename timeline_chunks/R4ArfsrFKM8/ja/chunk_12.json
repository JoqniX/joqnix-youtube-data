[{"type": "subtitle", "time": 724.71, "timestamp": "00:12:04", "text": "不思議。ええと、できる限り長く滞在します。"}, {"type": "subtitle", "time": 726.55, "timestamp": "00:12:06", "text": "これがおそらく私が受け取る最後の配信になるでしょう"}, {"type": "subtitle", "time": 728.35, "timestamp": "00:12:08", "text": "監視する"}, {"type": "subtitle", "time": 731.629, "timestamp": "00:12:11", "text": "その間。願わくば"}, {"type": "subtitle", "time": 738.35, "timestamp": "00:12:18", "text": "それ？スティック"}, {"type": "subtitle", "time": 749.269, "timestamp": "00:12:29", "text": "ジャンプ。ジャンプ。それを飛び越えろ。ジャンプする"}, {"type": "subtitle", "time": 752.35, "timestamp": "00:12:32", "text": "そこには。そこへ飛び移ってください。行く"}, {"type": "subtitle", "time": 757.99, "timestamp": "00:12:37", "text": "上。ジャンプ。ああ。失敗。わかった。あなたは飛び上がる。"}, {"type": "subtitle", "time": 762.069, "timestamp": "00:12:42", "text": "ジャンプ。遅い。ジャンプ。長さ。短い。ジャンプ。"}, {"type": "subtitle", "time": 765.79, "timestamp": "00:12:45", "text": "失敗。わかった。飛び上がって。遅い"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "ジャンプ。ジャンプ。うん。ああ。私は作り続けています"}, {"type": "subtitle", "time": 772.509, "timestamp": "00:12:52", "text": "作る"}, {"type": "subtitle", "time": 779.35, "timestamp": "00:12:59", "text": "下。もし私が耐久レースをしたらどうなるだろうか"}]
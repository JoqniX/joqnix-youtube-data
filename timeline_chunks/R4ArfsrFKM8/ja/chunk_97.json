[{"type": "subtitle", "time": 5820.79, "timestamp": "01:37:00", "text": "うんうん。外部のものを入手できます"}, {"type": "subtitle", "time": 5824.109, "timestamp": "01:37:04", "text": "外部キャプチャカード"}, {"type": "subtitle", "time": 5827.75, "timestamp": "01:37:07", "text": "何かを接続し、HDMIケーブルの一方の端を接続します。"}, {"type": "subtitle", "time": 5829.99, "timestamp": "01:37:09", "text": "この物と他の物へのケーブル"}, {"type": "subtitle", "time": 5832.59, "timestamp": "01:37:12", "text": "コンピューターを終了するか、"}, {"type": "subtitle", "time": 5837.51, "timestamp": "01:37:17", "text": "USBデバイスを使えば、テレビに映像を入力できます。"}, {"type": "subtitle", "time": 5839.07, "timestamp": "01:37:19", "text": "テレビ"}, {"type": "subtitle", "time": 5843.27, "timestamp": "01:37:23", "text": "画面。それはそこにあるでしょう。うん。"}, {"type": "subtitle", "time": 5845.669, "timestamp": "01:37:25", "text": "それなら、直接そうしてください。そっちの方が簡単だろう"}, {"type": "subtitle", "time": 5849.35, "timestamp": "01:37:29", "text": "音声も収録されます。"}, {"type": "subtitle", "time": 5857.27, "timestamp": "01:37:37", "text": "もちろん。ところで、食事はしましたか？もう遅い時間だ。"}, {"type": "subtitle", "time": 5860.39, "timestamp": "01:37:40", "text": "正直に言うと、まだやったことがありません。でも私は"}, {"type": "subtitle", "time": 5863.83, "timestamp": "01:37:43", "text": "今日は予定があったので休んでください。私は持っていた"}, {"type": "subtitle", "time": 5865.99, "timestamp": "01:37:45", "text": "私のスナック類などは、少し前に全部取り出しました。"}, {"type": "subtitle", "time": 5876.95, "timestamp": "01:37:56", "text": "だから私は本当に嬉しい"}, {"type": "subtitle", "time": 5879.27, "timestamp": "01:37:59", "text": "コラボレーションとか色々やったよ。"}]
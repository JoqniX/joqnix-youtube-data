[{"type": "subtitle", "time": 14342.95, "timestamp": "03:59:02", "text": "間違っている。そして私はそれを認めました。私はしませんでした"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "論理的にきちんと考えてみてください。私はこう思った"}, {"type": "subtitle", "time": 14347.99, "timestamp": "03:59:07", "text": "そう、私は"}, {"type": "chat", "time": 14349.798, "timestamp": "03:59:09", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "lol"}, {"type": "subtitle", "time": 14349.99, "timestamp": "03:59:09", "text": "これを友達に見せてください。そういう"}, {"type": "subtitle", "time": 14352.79, "timestamp": "03:59:12", "text": "あれ。でも正直に言うと、"}, {"type": "subtitle", "time": 14355.83, "timestamp": "03:59:15", "text": "それは私が今まで考えうる中で最も愚かなことだった"}, {"type": "subtitle", "time": 14359.67, "timestamp": "03:59:19", "text": "する。誰でもできることです。何てことだ。一度もない"}, {"type": "subtitle", "time": 14363.99, "timestamp": "03:59:23", "text": "そうしてください。私は自分の例を挙げて説明します。私"}, {"type": "subtitle", "time": 14368.67, "timestamp": "03:59:28", "text": "今になって気づいた。どれほどひどいことになり得たか"}, {"type": "subtitle", "time": 14372.15, "timestamp": "03:59:32", "text": "された。そして、自分の"}, {"type": "subtitle", "time": 14374.389, "timestamp": "03:59:34", "text": "間違い。そして私はそうしなければならない"}, {"type": "subtitle", "time": 14376.389, "timestamp": "03:59:36", "text": "それはしないで。"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "私は、あなたを"}, {"type": "subtitle", "time": 14380.51, "timestamp": "03:59:40", "text": "知る"}, {"type": "subtitle", "time": 14384.63, "timestamp": "03:59:44", "text": "えっと、私は好きではないことを確認しなければなりません"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "それに乗っかって、同じことを続けて"}, {"type": "subtitle", "time": 14389.189, "timestamp": "03:59:49", "text": "物事を「ああ、私は大丈夫」と言う"}, {"type": "subtitle", "time": 14392.469, "timestamp": "03:59:52", "text": "私はプロフェッショナルです 私は知っています 私は持っています"}, {"type": "subtitle", "time": 14394.87, "timestamp": "03:59:54", "text": "いろいろな経験など、"}, {"type": "subtitle", "time": 14396.55, "timestamp": "03:59:56", "text": "他の人に教えるときは、「そうしないといけないよ」と言う"}, {"type": "subtitle", "time": 14399.99, "timestamp": "03:59:59", "text": "あれこれとあなたが私自身である間、"}]
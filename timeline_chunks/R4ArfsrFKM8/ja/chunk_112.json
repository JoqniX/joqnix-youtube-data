[{"type": "subtitle", "time": 6736.229, "timestamp": "01:52:16", "text": "ホグミー。ああ、彼は本当に背が高いね。彼は"}, {"type": "subtitle", "time": 6752.07, "timestamp": "01:52:32", "text": "今日は配信を少し遅らせざるを得ませんでした"}, {"type": "subtitle", "time": 6755.82, "timestamp": "01:52:35", "text": "寝坊したから11時まで。"}, {"type": "subtitle", "time": 6764.79, "timestamp": "01:52:44", "text": "[音楽]"}, {"type": "subtitle", "time": 6766.629, "timestamp": "01:52:46", "text": "ああ、何かを持って戻ってきたのね"}, {"type": "subtitle", "time": 6768.27, "timestamp": "01:52:48", "text": "報告。動作が少し遅い"}, {"type": "subtitle", "time": 6771.87, "timestamp": "01:52:51", "text": "理由。感じますか？"}, {"type": "subtitle", "time": 6774.79, "timestamp": "01:52:54", "text": "それ？解像度を下げる必要がありますか？"}, {"type": "subtitle", "time": 6777.31, "timestamp": "01:52:57", "text": "もの？なぜそうなるのか"}]
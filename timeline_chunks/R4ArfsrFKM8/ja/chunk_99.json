[{"type": "subtitle", "time": 5940.709, "timestamp": "01:39:00", "text": "うん。私は幸せです。とても気に入りました。私はとても"}, {"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "ハッピー。"}, {"type": "subtitle", "time": 5946.31, "timestamp": "01:39:06", "text": "そして私は、私たちが"}, {"type": "subtitle", "time": 5949.35, "timestamp": "01:39:09", "text": "例えば、もしあなたが望むなら、"}, {"type": "subtitle", "time": 5951.83, "timestamp": "01:39:11", "text": "ゲームか何かをした。私"}, {"type": "subtitle", "time": 5954.35, "timestamp": "01:39:14", "text": "言い忘れていました。そうだったっけ？"}, {"type": "subtitle", "time": 5958.149, "timestamp": "01:39:18", "text": "全く問題ありません。うん。もっと楽しかった"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "すごくいい話ができたから。私たちは"}, {"type": "subtitle", "time": 5964.229, "timestamp": "01:39:24", "text": "私たちの未来、私たちの過去、そして"}, {"type": "subtitle", "time": 5966.79, "timestamp": "01:39:26", "text": "それら全て。とても素敵です。だから今私は"}, {"type": "subtitle", "time": 5969.35, "timestamp": "01:39:29", "text": "あなたのことをもっと知りたい。いいえ、もし私たちが"}, {"type": "subtitle", "time": 5971.79, "timestamp": "01:39:31", "text": "ゲームをしていたのは、私たちだけだった"}, {"type": "subtitle", "time": 5974.55, "timestamp": "01:39:34", "text": "叫んでから遊ぶ。私たちはそうしないだろう"}, {"type": "subtitle", "time": 5976.55, "timestamp": "01:39:36", "text": "何らかの繋がりができたか、あるいは何か関係ができた。"}, {"type": "subtitle", "time": 5978.31, "timestamp": "01:39:38", "text": "右。"}, {"type": "subtitle", "time": 5980.149, "timestamp": "01:39:40", "text": "私たちのようなたまり場の方がもっといい"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "友人同士がビデオ会議で話している。"}, {"type": "subtitle", "time": 5983.89, "timestamp": "01:39:43", "text": "その通り。"}, {"type": "subtitle", "time": 5985.83, "timestamp": "01:39:45", "text": "[音楽]"}, {"type": "subtitle", "time": 5989.59, "timestamp": "01:39:49", "text": "だからDと私は、私がどんな感じだったか、すべてを気に入ってくれることを願っています"}, {"type": "subtitle", "time": 5991.75, "timestamp": "01:39:51", "text": "その日のデビュー配信を見て"}, {"type": "subtitle", "time": 5994.47, "timestamp": "01:39:54", "text": "うわー、こうやってやるんだ。私も"}, {"type": "subtitle", "time": 5997.03, "timestamp": "01:39:57", "text": "デビューに向けて、このように準備したい。"}, {"type": "subtitle", "time": 5999.189, "timestamp": "01:39:59", "text": "私はデビューしたことがない。"}]
[{"type": "subtitle", "time": 13681.429, "timestamp": "03:48:01", "text": "ほら、焦凍がいるよ。彼はとてもよくやっている。"}, {"type": "subtitle", "time": 13684.51, "timestamp": "03:48:04", "text": "ユサンは本当にうまくやっているよね"}, {"type": "subtitle", "time": 13688.389, "timestamp": "03:48:08", "text": "だから、人々は買えると思っている"}, {"type": "subtitle", "time": 13691.15, "timestamp": "03:48:11", "text": "IPアドレスが終了される場合"}, {"type": "subtitle", "time": 13695.11, "timestamp": "03:48:15", "text": "うーん、それは会社によりますね"}, {"type": "subtitle", "time": 13698.469, "timestamp": "03:48:18", "text": "あなたは法的に会社を買収することはできません"}, {"type": "subtitle", "time": 13701.349, "timestamp": "03:48:21", "text": "資産 それは会社の資産です なぜ"}, {"type": "subtitle", "time": 13705.59, "timestamp": "03:48:25", "text": "彼らはそれをあなたに渡すべきですよね？"}, {"type": "subtitle", "time": 13708.71, "timestamp": "03:48:28", "text": "よく考えてみて。聖なるものはたくさんあります"}, {"type": "subtitle", "time": 13710.469, "timestamp": "03:48:30", "text": "才能とナンティの才能を獲得した"}, {"type": "subtitle", "time": 13712.95, "timestamp": "03:48:32", "text": "卒業して、その他諸々を終えた。した"}, {"type": "subtitle", "time": 13716.309, "timestamp": "03:48:36", "text": "彼らのうちの誰かがモデルにお金を払うか、"}, {"type": "subtitle", "time": 13719.11, "timestamp": "03:48:39", "text": "彼らが以前持っていたものは何だったのか？いいえ、それは"}, {"type": "subtitle", "time": 13722.349, "timestamp": "03:48:42", "text": "会社の資産。会社製"}, {"type": "subtitle", "time": 13725.349, "timestamp": "03:48:45", "text": "資産は商品に非常によく使われます。"}, {"type": "subtitle", "time": 13727.03, "timestamp": "03:48:47", "text": "広告、"}, {"type": "subtitle", "time": 13730.71, "timestamp": "03:48:50", "text": "ポップアップストア、たくさんのテーマ"}, {"type": "subtitle", "time": 13734.63, "timestamp": "03:48:54", "text": "そういうことですよね？彼らの才能のために"}, {"type": "subtitle", "time": 13738.389, "timestamp": "03:48:58", "text": "彼らの知的財産権のために会社が所有する知的財産なので"}]
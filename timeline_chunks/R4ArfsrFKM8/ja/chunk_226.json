[{"type": "subtitle", "time": 13562.95, "timestamp": "03:46:02", "text": "ええ、そう言う人もいるでしょう"}, {"type": "subtitle", "time": 13566.51, "timestamp": "03:46:06", "text": "支配、トップと言う人もいる"}, {"type": "subtitle", "time": 13570.389, "timestamp": "03:46:10", "text": "拡張。誰だったか忘れてしまった。忘れた"}, {"type": "subtitle", "time": 13571.469, "timestamp": "03:46:11", "text": "誰が"}, {"type": "subtitle", "time": 13585.91, "timestamp": "03:46:25", "text": "ああ、そうだね。これを見て、これは"}, {"type": "subtitle", "time": 13588.67, "timestamp": "03:46:28", "text": "ユーゴスラビアの支配"}, {"type": "subtitle", "time": 13591.189, "timestamp": "03:46:31", "text": "これは支配だと仮定する"}, {"type": "subtitle", "time": 13593.87, "timestamp": "03:46:33", "text": "の"}, {"type": "subtitle", "time": 13597.99, "timestamp": "03:46:37", "text": "ええ、そうですね、例えばどんな色でも"}, {"type": "subtitle", "time": 13600.71, "timestamp": "03:46:40", "text": "彼らはただ詰め込んだだけだった"}, {"type": "subtitle", "time": 13603.67, "timestamp": "03:46:43", "text": "これは卒業式で、作らないで"}, {"type": "subtitle", "time": 13606.63, "timestamp": "03:46:46", "text": "まるで卒業式のように彼のビデオ"}, {"type": "subtitle", "time": 13608.03, "timestamp": "03:46:48", "text": "そして全ては"}, {"type": "subtitle", "time": 13611.91, "timestamp": "03:46:51", "text": "非公開です。これはそうです。"}, {"type": "subtitle", "time": 13614.229, "timestamp": "03:46:54", "text": "発表は終了だが、"}, {"type": "subtitle", "time": 13617.59, "timestamp": "03:46:57", "text": "解雇とは発表していない。"}]
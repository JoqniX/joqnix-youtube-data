[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "そうじゃないよね？なぜ私は何気なく"}, {"type": "subtitle", "time": 15063.229, "timestamp": "04:11:03", "text": "それらを時々すべて起動する？それは失礼だ。"}, {"type": "subtitle", "time": 15066.469, "timestamp": "04:11:06", "text": "はぁ？例えば、彼らが私の"}, {"type": "subtitle", "time": 15069.03, "timestamp": "04:11:09", "text": "ストリーム配信して、彼らは見て、"}, {"type": "subtitle", "time": 15071.87, "timestamp": "04:11:11", "text": "私がランダムに話しているのを聞いてください"}, {"type": "subtitle", "time": 15075.349, "timestamp": "04:11:15", "text": "それらとその他諸々。あなたならどう感じるでしょうか？"}, {"type": "subtitle", "time": 15079.269, "timestamp": "04:11:19", "text": "まるで私が話していたように"}, {"type": "subtitle", "time": 15082.309, "timestamp": "04:11:22", "text": "他の誰かが入ってきて"}, {"type": "subtitle", "time": 15084.75, "timestamp": "04:11:24", "text": "彼らはこう言う、"}, {"type": "subtitle", "time": 15088.87, "timestamp": "04:11:28", "text": "\"おお。\"そんな感じですよね？うん。私 私 私"}, {"type": "subtitle", "time": 15091.429, "timestamp": "04:11:31", "text": "気づいて、気付き始めた"}, {"type": "subtitle", "time": 15093.79, "timestamp": "04:11:33", "text": "私が犯した間違い"}, {"type": "subtitle", "time": 15096.389, "timestamp": "04:11:36", "text": "ジョアソンと私は、もっと上達すべきだと思う"}, {"type": "subtitle", "time": 15097.15, "timestamp": "04:11:37", "text": "から"}, {"type": "subtitle", "time": 15099.07, "timestamp": "04:11:39", "text": "それと"}, {"type": "subtitle", "time": 15102.63, "timestamp": "04:11:42", "text": "どこで間違えたのか理解して"}, {"type": "subtitle", "time": 15105.269, "timestamp": "04:11:45", "text": "またしても試行錯誤だ"}, {"type": "chat", "time": 15110.759, "timestamp": "04:11:50", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "good man learn from mistakes"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "わかった、いやいや、心配しないで、心配しないで"}, {"type": "subtitle", "time": 15116.15, "timestamp": "04:11:56", "text": "ただ、私はいくつかのことを理解しただけです"}, {"type": "subtitle", "time": 15118.469, "timestamp": "04:11:58", "text": "私がしてはいけないこと。なぜなら"}]
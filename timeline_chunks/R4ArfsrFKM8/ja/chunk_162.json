[{"type": "subtitle", "time": 9722.469, "timestamp": "02:42:02", "text": "それらを学び、私の"}, {"type": "subtitle", "time": 9724.87, "timestamp": "02:42:04", "text": "ワークフローも全て含めて。そしてそれは"}, {"type": "subtitle", "time": 9727.11, "timestamp": "02:42:07", "text": "称賛に値する？はい。"}, {"type": "subtitle", "time": 9734.55, "timestamp": "02:42:14", "text": "技術的なこと、すべてです。ああ、私は"}, {"type": "subtitle", "time": 9737.27, "timestamp": "02:42:17", "text": "今でも覚えているよ。それはすごくクールだね。"}, {"type": "subtitle", "time": 9739.59, "timestamp": "02:42:19", "text": "覚えてる？あの、これだよ"}, {"type": "subtitle", "time": 9741.67, "timestamp": "02:42:21", "text": "チャットをしたストリーム"}, {"type": "subtitle", "time": 9745.389, "timestamp": "02:42:25", "text": "コントロールボタン。私たちは皆"}, {"type": "subtitle", "time": 9749.27, "timestamp": "02:42:29", "text": "すべてのアルファベットを入力するか、上へ"}, {"type": "subtitle", "time": 9751.59, "timestamp": "02:42:31", "text": "下降とか色々。ああ、それは"}, {"type": "subtitle", "time": 9754.71, "timestamp": "02:42:34", "text": "楽しい。うん、楽しかったよ。そして私は覚えている"}, {"type": "subtitle", "time": 9757.11, "timestamp": "02:42:37", "text": "そうして、私は考えなければならなかった"}, {"type": "subtitle", "time": 9759.59, "timestamp": "02:42:39", "text": "物事をきちんと片付けて、それから私も"}, {"type": "subtitle", "time": 9761.349, "timestamp": "02:42:41", "text": "みんなが理解できるようにこの図表を作らなければならなかった"}, {"type": "subtitle", "time": 9763.99, "timestamp": "02:42:43", "text": "好きなものを知っている 以前は来る"}, {"type": "subtitle", "time": 9765.83, "timestamp": "02:42:45", "text": "自分のキャラクターやその他すべてをコントロールする。それで"}, {"type": "subtitle", "time": 9769.349, "timestamp": "02:42:49", "text": "あれはすごく楽しかった。"}, {"type": "subtitle", "time": 9771.87, "timestamp": "02:42:51", "text": "ええ、それは本当に"}, {"type": "subtitle", "time": 9777.11, "timestamp": "02:42:57", "text": "当時としては素敵で、しかもユニークだった。うん、君"}, {"type": "subtitle", "time": 9779.87, "timestamp": "02:42:59", "text": "ストリームボードでそれら全てを実行しました"}]
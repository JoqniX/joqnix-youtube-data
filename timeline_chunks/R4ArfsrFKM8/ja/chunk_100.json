[{"type": "subtitle", "time": 6002.149, "timestamp": "01:40:02", "text": "うん。早くデビューして、"}, {"type": "subtitle", "time": 6004.31, "timestamp": "01:40:04", "text": "デビュー配信、すごく緊張した。私は"}, {"type": "subtitle", "time": 6007.03, "timestamp": "01:40:07", "text": "睡眠不足なのは"}, {"type": "subtitle", "time": 6009.03, "timestamp": "01:40:09", "text": "まるでパニック状態だった。ああ、なんてことだ、"}, {"type": "subtitle", "time": 6012.229, "timestamp": "01:40:12", "text": "流れはどこへ行くのか？ああ、ついにこの時が来た。私"}, {"type": "subtitle", "time": 6015.27, "timestamp": "01:40:15", "text": "すごく不安だったけど、"}, {"type": "subtitle", "time": 6017.35, "timestamp": "01:40:17", "text": "できたと思う。"}, {"type": "subtitle", "time": 6019.51, "timestamp": "01:40:19", "text": "うん、本当にみんなにとって思い出深いね。"}, {"type": "subtitle", "time": 6022.75, "timestamp": "01:40:22", "text": "感じる。うん。本当に"}, {"type": "subtitle", "time": 6025.31, "timestamp": "01:40:25", "text": "良い。本当に"}, {"type": "subtitle", "time": 6028.31, "timestamp": "01:40:28", "text": "楽しかったし、あなたがやってくれて嬉しいよ。私は"}, {"type": "subtitle", "time": 6030.87, "timestamp": "01:40:30", "text": "君を誇りに思うよ。本当に楽しかった。感謝"}, {"type": "subtitle", "time": 6037.27, "timestamp": "01:40:37", "text": "そしておそらくデビューの頃には、あなたは"}, {"type": "subtitle", "time": 6039.35, "timestamp": "01:40:39", "text": "多くの人々もそうです。それは本当に"}, {"type": "subtitle", "time": 6042.95, "timestamp": "01:40:42", "text": "良い。あなたも私にインスピレーションを与えてくれました。感謝"}, {"type": "subtitle", "time": 6045.91, "timestamp": "01:40:45", "text": "あなた。それは本当に素晴らしいですね。とても素敵です"}, {"type": "subtitle", "time": 6048.629, "timestamp": "01:40:48", "text": "私が人々にインスピレーションを与えていると聞くこと。"}, {"type": "subtitle", "time": 6050.79, "timestamp": "01:40:50", "text": "私は決してできないと思っていた"}, {"type": "subtitle", "time": 6053.75, "timestamp": "01:40:53", "text": "それ。うん。まるで"}, {"type": "subtitle", "time": 6056.47, "timestamp": "01:40:56", "text": "YouTubeを始めた人たちは"}]
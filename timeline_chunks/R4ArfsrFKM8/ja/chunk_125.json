[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "ポータルがうまく機能していなかった。私"}, {"type": "subtitle", "time": 7503.75, "timestamp": "02:05:03", "text": "それはちょっと面倒くさいなと思った"}, {"type": "subtitle", "time": 7506.31, "timestamp": "02:05:06", "text": "私はすべての行動を"}, {"type": "subtitle", "time": 7508.39, "timestamp": "02:05:08", "text": "ストリーマーはとにかく終わったので、すべてのアクション"}, {"type": "subtitle", "time": 7510.39, "timestamp": "02:05:10", "text": "いずれにせよストリーマーボードに掲載されるだろう"}, {"type": "subtitle", "time": 7513.51, "timestamp": "02:05:13", "text": "ストリーマーボットを使えばいいんじゃない？"}, {"type": "subtitle", "time": 7516.79, "timestamp": "02:05:16", "text": "それを配信する。だから私はこれを作りました"}, {"type": "subtitle", "time": 7519.99, "timestamp": "02:05:19", "text": "3ページまるまる3ページ"}, {"type": "subtitle", "time": 7522.87, "timestamp": "02:05:22", "text": "複数のコントロールの異なるページ"}, {"type": "subtitle", "time": 7525.109, "timestamp": "02:05:25", "text": "トーナメントのあらゆる場面、または"}, {"type": "subtitle", "time": 7528.31, "timestamp": "02:05:28", "text": "チャンネル変更のような、いや、チャンネルではない"}, {"type": "subtitle", "time": 7531.55, "timestamp": "02:05:31", "text": "変更点 ええと、ボスが変更点を変える"}, {"type": "subtitle", "time": 7536.07, "timestamp": "02:05:36", "text": "えっと、すぐ後ろのスクリーンが動き始めます"}, {"type": "subtitle", "time": 7539.109, "timestamp": "02:05:39", "text": "ええと、試合に関する情報更新"}, {"type": "subtitle", "time": 7541.03, "timestamp": "02:05:41", "text": "選手自身は選手が好きです"}, {"type": "subtitle", "time": 7543.75, "timestamp": "02:05:43", "text": "対プレイヤー。つまり、それら全ては"}, {"type": "subtitle", "time": 7547.589, "timestamp": "02:05:47", "text": "ストリーマーデッキを通じて更新されました。おお、"}, {"type": "subtitle", "time": 7549.669, "timestamp": "02:05:49", "text": "ニース。そして、他に2人ほどいた"}, {"type": "subtitle", "time": 7551.83, "timestamp": "02:05:51", "text": "そういうことを手伝ってくれる。そうだった"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "まさに本格的なチームワークですね。うん、"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "それは、その一つです。うん。"}]
[{"type": "subtitle", "time": 9422.07, "timestamp": "02:37:02", "text": "それが私を奮い立たせたのです"}, {"type": "subtitle", "time": 9424.309, "timestamp": "02:37:04", "text": "そしてこのイベントを企画して、最終的に"}, {"type": "subtitle", "time": 9425.99, "timestamp": "02:37:05", "text": "両方のコミュニティマネージャーになる"}, {"type": "subtitle", "time": 9429.03, "timestamp": "02:37:09", "text": "私の傲慢なサーバーとファンタジーのt"}, {"type": "subtitle", "time": 9431.99, "timestamp": "02:37:11", "text": "SCAサーバー。"}, {"type": "subtitle", "time": 9433.23, "timestamp": "02:37:13", "text": "それは"}, {"type": "subtitle", "time": 9436.27, "timestamp": "02:37:16", "text": "ニース。なかなか良い"}, {"type": "subtitle", "time": 9439.99, "timestamp": "02:37:19", "text": "実際、良いですね。"}, {"type": "subtitle", "time": 9442.91, "timestamp": "02:37:22", "text": "何か計画はありますか？"}, {"type": "subtitle", "time": 9447.27, "timestamp": "02:37:27", "text": "将来は、Vubing であろうと、"}, {"type": "subtitle", "time": 9449.11, "timestamp": "02:37:29", "text": "それが空想であろうと、"}, {"type": "subtitle", "time": 9451.03, "timestamp": "02:37:31", "text": "完全に"}, {"type": "subtitle", "time": 9453.79, "timestamp": "02:37:33", "text": "別のゲームなど"}, {"type": "subtitle", "time": 9457.99, "timestamp": "02:37:37", "text": "など。今のところMはいいえ。私は今"}, {"type": "subtitle", "time": 9460.71, "timestamp": "02:37:40", "text": "今、私が何を言おうとしたら"}, {"type": "subtitle", "time": 9463.99, "timestamp": "02:37:43", "text": "私がやっていることは、自分自身を再発見することのようなものだ"}, {"type": "subtitle", "time": 9465.99, "timestamp": "02:37:45", "text": "今私が言いたいことは"}, {"type": "subtitle", "time": 9467.91, "timestamp": "02:37:47", "text": "自分が何に打ち込めるかを見つける"}, {"type": "subtitle", "time": 9472.79, "timestamp": "02:37:52", "text": "または、それを使って何かをする。"}, {"type": "subtitle", "time": 9475.19, "timestamp": "02:37:55", "text": "それがわかれば、私は"}, {"type": "subtitle", "time": 9478.7, "timestamp": "02:37:58", "text": "将来、どのような方向へ進んでいきたいか。"}]
[{"type": "subtitle", "time": 11460.07, "timestamp": "03:11:00", "text": "兄弟。ああ、しまった。"}, {"type": "subtitle", "time": 11468.23, "timestamp": "03:11:08", "text": "衝突する。衝突する。いや、違うよ。いいえ、そうはなりません。"}, {"type": "subtitle", "time": 11469.429, "timestamp": "03:11:09", "text": "衝突する。わかった。わかった。わかった。それは"}, {"type": "subtitle", "time": 11470.95, "timestamp": "03:11:10", "text": "日曜日。ある意味、それが日曜日というものだ。わかった。"}, {"type": "subtitle", "time": 11474.67, "timestamp": "03:11:14", "text": "わかった。わかった。わかった。午前1時"}, {"type": "subtitle", "time": 11476.99, "timestamp": "03:11:16", "text": "3時まで"}, {"type": "subtitle", "time": 11479.23, "timestamp": "03:11:19", "text": "午前。"}, {"type": "subtitle", "time": 11483.55, "timestamp": "03:11:23", "text": "日曜日。えーと、7月、6月"}, {"type": "subtitle", "time": 11491.349, "timestamp": "03:11:31", "text": "わかった。私のジャックは何ですか？ Rokuを置くかもしれない"}, {"type": "subtitle", "time": 11493.389, "timestamp": "03:11:33", "text": "土曜日に"}, {"type": "subtitle", "time": 11495.63, "timestamp": "03:11:35", "text": "実は。えっと"}, {"type": "subtitle", "time": 11497.309, "timestamp": "03:11:37", "text": "アマル"}, {"type": "subtitle", "time": 11506.51, "timestamp": "03:11:46", "text": "えっと、14日土曜日？土曜日"}, {"type": "subtitle", "time": 11508.38, "timestamp": "03:11:48", "text": "で で"}, {"type": "subtitle", "time": 11511.309, "timestamp": "03:11:51", "text": "[音楽]"}, {"type": "subtitle", "time": 11516.83, "timestamp": "03:11:56", "text": "タイミングを教えてください"}]
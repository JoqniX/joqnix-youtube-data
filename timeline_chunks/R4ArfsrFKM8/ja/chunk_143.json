[{"type": "subtitle", "time": 8580.309, "timestamp": "02:23:00", "text": "貧困ワールドゲームズ"}, {"type": "subtitle", "time": 8582.95, "timestamp": "02:23:02", "text": "タワー・オブ・ファンタジー・グローバルの責任者。"}, {"type": "subtitle", "time": 8586.07, "timestamp": "02:23:06", "text": "だから今彼らはそれを処理していて、その間"}, {"type": "subtitle", "time": 8587.429, "timestamp": "02:23:07", "text": "この過程には、"}, {"type": "subtitle", "time": 8589.99, "timestamp": "02:23:09", "text": "口座振替など、すべて。だからあなたは"}, {"type": "subtitle", "time": 8591.99, "timestamp": "02:23:11", "text": "アカウントを承認する必要がありました"}, {"type": "subtitle", "time": 8596.07, "timestamp": "02:23:16", "text": "譲渡しないと失効します。そうそう。それで"}, {"type": "subtitle", "time": 8598.75, "timestamp": "02:23:18", "text": "それら全てが実際に起こったのです。えっと、すべては終わった"}, {"type": "subtitle", "time": 8603.349, "timestamp": "02:23:23", "text": "4月末以降、"}, {"type": "subtitle", "time": 8607.59, "timestamp": "02:23:27", "text": "完全にPWGの支配下にあり、"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "すべて順調で、まあいい感じだと思います。"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "これがどうなるかはまだ判断するには早すぎる"}, {"type": "subtitle", "time": 8614.55, "timestamp": "02:23:34", "text": "移行とは、この移行が良いかどうかということです"}, {"type": "subtitle", "time": 8618.15, "timestamp": "02:23:38", "text": "あるいは悪いのは、それがちょうど2、3のようだったから"}, {"type": "subtitle", "time": 8621.11, "timestamp": "02:23:41", "text": "これまでの合計月数。"}, {"type": "subtitle", "time": 8623.349, "timestamp": "02:23:43", "text": "しかし、いずれ分かるだろう。しかし、"}, {"type": "subtitle", "time": 8626.23, "timestamp": "02:23:46", "text": "これまでのファンタジーは素晴らしかった。それでもあなたは"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "この素晴らしいカスタマイズで"}, {"type": "subtitle", "time": 8629.91, "timestamp": "02:23:49", "text": "他には特に何も得られない。うん。"}]
[{"type": "subtitle", "time": 8220.669, "timestamp": "02:17:00", "text": "[音楽]"}, {"type": "subtitle", "time": 8224.309, "timestamp": "02:17:04", "text": "M 私は額縁を見ているのが好きです"}, {"type": "subtitle", "time": 8228.629, "timestamp": "02:17:08", "text": "これは素晴らしいフレームワークですね。"}, {"type": "subtitle", "time": 8231.19, "timestamp": "02:17:11", "text": "なかなかいい感じ。そう、君が作れるように"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "自分のものを交換し、バッテリーを交換してください"}, {"type": "subtitle", "time": 8234.869, "timestamp": "02:17:14", "text": "すべて。"}, {"type": "subtitle", "time": 8240.669, "timestamp": "02:17:20", "text": "これは"}, {"type": "subtitle", "time": 8243.75, "timestamp": "02:17:23", "text": "ニース。良さそうですね。"}, {"type": "subtitle", "time": 8247.429, "timestamp": "02:17:27", "text": "私はモバイルプロセッサには詳しくありません"}, {"type": "subtitle", "time": 8251.709, "timestamp": "02:17:31", "text": "などなど。調べてみるのもいいかもしれませんね。"}, {"type": "subtitle", "time": 8255.95, "timestamp": "02:17:35", "text": "ニース。また、まだ持っていますか"}, {"type": "subtitle", "time": 8259.27, "timestamp": "02:17:39", "text": "3D関連の設定は完了しましたよね？あなたはそうではないのですか？"}, {"type": "subtitle", "time": 8262.389, "timestamp": "02:17:42", "text": "それを使う？えっと、実は3Dを紛失してしまいました"}, {"type": "subtitle", "time": 8265.509, "timestamp": "02:17:45", "text": "もの。新型モデルが回転した。私"}, {"type": "subtitle", "time": 8267.429, "timestamp": "02:17:47", "text": "ファイルとか全部失ってしまったんです。"}, {"type": "subtitle", "time": 8271.03, "timestamp": "02:17:51", "text": "なんてこった。えっと、パソコンをリセットする必要がありました。"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "それで、ファイルのバックアップを忘れて"}, {"type": "subtitle", "time": 8275.669, "timestamp": "02:17:55", "text": "だからWindowsを再インストールしたとき、"}, {"type": "subtitle", "time": 8277.99, "timestamp": "02:17:57", "text": "完全に見失ってしまった。だから今私は"}]
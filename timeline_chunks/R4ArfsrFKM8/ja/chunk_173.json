[{"type": "subtitle", "time": 10381.51, "timestamp": "02:53:01", "text": "GMA、マヤバシ。"}, {"type": "subtitle", "time": 10383.75, "timestamp": "02:53:03", "text": "おお、それは素晴らしいですね。だから、少なくともそれは"}, {"type": "subtitle", "time": 10385.19, "timestamp": "02:53:05", "text": "僻地のような場所。それはまるで"}, {"type": "subtitle", "time": 10387.429, "timestamp": "02:53:07", "text": "まるで都会のような環境が完璧だ。それで、"}, {"type": "subtitle", "time": 10390.55, "timestamp": "02:53:10", "text": "それは良い。都市部や農村部のような場所"}, {"type": "subtitle", "time": 10393.87, "timestamp": "02:53:13", "text": "山とかそういうもの。うん。 M. 本当です。"}, {"type": "subtitle", "time": 10398.469, "timestamp": "02:53:18", "text": "真実。それは食べ物です。えっと、あなたは住んでいますか、えっと"}, {"type": "subtitle", "time": 10400.389, "timestamp": "02:53:20", "text": "あなたは今のように山の近くに住んでいます"}, {"type": "subtitle", "time": 10402.23, "timestamp": "02:53:22", "text": "それとも、あなたは私たちと同じように、あなたは"}, {"type": "subtitle", "time": 10406.309, "timestamp": "02:53:26", "text": "市？ええと、インドで。うん。インドで。おお、"}, {"type": "subtitle", "time": 10408.79, "timestamp": "02:53:28", "text": "私は市街地にいます。都市、都市。おお、"}, {"type": "subtitle", "time": 10410.469, "timestamp": "02:53:30", "text": "あなたは市街地にいます。わかった。わかった。それで、"}, {"type": "subtitle", "time": 10412.389, "timestamp": "02:53:32", "text": "つまり、景色があまり見えなくなるってことですよね？それらの人々のために"}, {"type": "subtitle", "time": 10414.55, "timestamp": "02:53:34", "text": "山の種類とか、そういうもの。うん。少ない"}, {"type": "subtitle", "time": 10417.59, "timestamp": "02:53:37", "text": "ビュー。うん。うん。うん。それからそれは"}, {"type": "subtitle", "time": 10419.83, "timestamp": "02:53:39", "text": "気分転換にちょうどいい。誰かとして"}, {"type": "subtitle", "time": 10421.99, "timestamp": "02:53:41", "text": "山のそばに住んでいる人なら、"}, {"type": "subtitle", "time": 10424.309, "timestamp": "02:53:44", "text": "そこは良い環境だと保証します"}, {"type": "subtitle", "time": 10427.15, "timestamp": "02:53:47", "text": "山々のそばにいるとき。"}, {"type": "subtitle", "time": 10429.429, "timestamp": "02:53:49", "text": "特に雲が降りてくると"}, {"type": "subtitle", "time": 10432.15, "timestamp": "02:53:52", "text": "山々は、絶対に"}, {"type": "subtitle", "time": 10439.79, "timestamp": "02:53:59", "text": "うん。できない"}]
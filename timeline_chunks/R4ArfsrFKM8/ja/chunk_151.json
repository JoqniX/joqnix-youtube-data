[{"type": "subtitle", "time": 9060.27, "timestamp": "02:31:00", "text": "何か。致死"}, {"type": "subtitle", "time": 9063.75, "timestamp": "02:31:03", "text": "会社。それを試してみましたか？"}, {"type": "subtitle", "time": 9066.75, "timestamp": "02:31:06", "text": "ええ、私たちはリトルカンパニーを演奏しました"}, {"type": "subtitle", "time": 9071.07, "timestamp": "02:31:11", "text": "コミュニティ。えっと、それは終わりだったと思います"}, {"type": "subtitle", "time": 9073.75, "timestamp": "02:31:13", "text": "2023年か2024年だったか、正確には覚えていない。"}, {"type": "subtitle", "time": 9077.03, "timestamp": "02:31:17", "text": "でも、私たちはそれをプレイしました、それはかなり"}, {"type": "subtitle", "time": 9081.429, "timestamp": "02:31:21", "text": "楽しい小さな会社は本当に面白かった。"}, {"type": "subtitle", "time": 9083.59, "timestamp": "02:31:23", "text": "私たちもいくつかやったよ。そして私たちも"}, {"type": "subtitle", "time": 9088.79, "timestamp": "02:31:28", "text": "GTAオンラインも少しプレイしました。ええ、そして"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "他にも1つか2つあると思う"}, {"type": "subtitle", "time": 9093.79, "timestamp": "02:31:33", "text": "ゲームももっと増えるだろう。私は覚えていません"}, {"type": "subtitle", "time": 9096.63, "timestamp": "02:31:36", "text": "名前。ええ、もちろんチャットしていますよ。それで"}, {"type": "subtitle", "time": 9100.15, "timestamp": "02:31:40", "text": "それも他のテーマの一つで、"}, {"type": "subtitle", "time": 9102.15, "timestamp": "02:31:42", "text": "うん、3試合だと思う。"}, {"type": "subtitle", "time": 9104.95, "timestamp": "02:31:44", "text": "今、私の頭から思い出す"}, {"type": "subtitle", "time": 9113.51, "timestamp": "02:31:53", "text": "TFファンタジーコミュニティのようなコミュニティ"}, {"type": "subtitle", "time": 9115.83, "timestamp": "02:31:55", "text": "またはあなたのコミュニティのように"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "成長していくファンタジーコミュニティ"}]
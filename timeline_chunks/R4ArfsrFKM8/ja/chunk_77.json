[{"type": "subtitle", "time": 4620.27, "timestamp": "01:17:00", "text": "今では彼らは"}, {"type": "subtitle", "time": 4623.75, "timestamp": "01:17:03", "text": "それらを動かすのはそれらの中にあり、"}, {"type": "subtitle", "time": 4626.63, "timestamp": "01:17:06", "text": "あなたが知っていることすべて。つまり、それは内蔵されている"}, {"type": "subtitle", "time": 4628.87, "timestamp": "01:17:08", "text": "聴くときに持っているシステム"}, {"type": "subtitle", "time": 4631.83, "timestamp": "01:17:11", "text": "音楽。つまり、デフォルトではあなたは得意です"}, {"type": "subtitle", "time": 4635.11, "timestamp": "01:17:15", "text": "ダンシング。ええ、それは本当です。"}, {"type": "subtitle", "time": 4636.03, "timestamp": "01:17:16", "text": "本当に"}, {"type": "subtitle", "time": 4640.14, "timestamp": "01:17:20", "text": "楽しいダンスとか。"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "[音楽]"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "私はいつもこの考えを持っていたのですが、"}, {"type": "subtitle", "time": 4647.03, "timestamp": "01:17:27", "text": "チューブファンキーが人気になるか、"}, {"type": "subtitle", "time": 4649.83, "timestamp": "01:17:29", "text": "インドで一般化されてから1日後"}, {"type": "subtitle", "time": 4652.709, "timestamp": "01:17:32", "text": "何年も経ち、私には一つの願いがありました"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "私がやりたかったのは、えっと、私はあまりにも"}, {"type": "subtitle", "time": 4659.35, "timestamp": "01:17:39", "text": "路上ミュージシャンのことをするのは恥ずかしかった"}, {"type": "subtitle", "time": 4662.149, "timestamp": "01:17:42", "text": "今、私は路上で考えていた"}, {"type": "subtitle", "time": 4664.79, "timestamp": "01:17:44", "text": "誰かがいたと思う"}, {"type": "subtitle", "time": 4667.11, "timestamp": "01:17:47", "text": "どこかのユーチューバー、知らない"}, {"type": "subtitle", "time": 4669.189, "timestamp": "01:17:49", "text": "どこの国だったか、でも彼らは"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "テレビ画面で彼らは歌っていた"}, {"type": "subtitle", "time": 4675.43, "timestamp": "01:17:55", "text": "ロボットみたいなやつでYouTuberが盛り上がってる"}, {"type": "subtitle", "time": 4677.51, "timestamp": "01:17:57", "text": "このコーナーではテレビの動きやその他"}]
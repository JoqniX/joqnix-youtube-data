[{"type": "subtitle", "time": 8700.469, "timestamp": "02:25:00", "text": "それは本当に楽しかったし、"}, {"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "いろいろなことをして、ボス戦をして、"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "すべて。はい。はい。"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "後でいつでも試してみてください"}, {"type": "subtitle", "time": 8710.87, "timestamp": "02:25:10", "text": "もう一度プレイしたい。絶対にしないで、絶対に"}, {"type": "subtitle", "time": 8712.87, "timestamp": "02:25:12", "text": "退屈すぎるし、何もかもつまらない。その"}, {"type": "subtitle", "time": 8714.79, "timestamp": "02:25:14", "text": "それなりに楽しい。にたどり着く"}, {"type": "subtitle", "time": 8717.83, "timestamp": "02:25:17", "text": "物事を経験する。楽しいことがたくさんあります"}, {"type": "subtitle", "time": 8719.67, "timestamp": "02:25:19", "text": "イベントとか色々あるよ。私は覚えています"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "あなたの配信から見ています。私は"}, {"type": "subtitle", "time": 8723.51, "timestamp": "02:25:23", "text": "「ああ、なんてことだ、"}, {"type": "subtitle", "time": 8725.349, "timestamp": "02:25:25", "text": "このゲーム。"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "ニース。今ではさらに変化しています"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "以前にもそうだった。今、あなたはメッカをすべて手に入れた。"}, {"type": "subtitle", "time": 8733.55, "timestamp": "02:25:33", "text": "君は宇宙時代を手に入れたんだ。それで、それは"}, {"type": "subtitle", "time": 8738.71, "timestamp": "02:25:38", "text": "宇宙とメッカ。だから、ちょっと楽しいんです。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "それはいいですね。"}, {"type": "subtitle", "time": 8743.75, "timestamp": "02:25:43", "text": "はい。早くまた試してみたいです"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "うん。それで、来る予定はありますか？"}, {"type": "subtitle", "time": 8756.23, "timestamp": "02:25:56", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 8758.55, "timestamp": "02:25:58", "text": "うん。ちょっとやりすぎだと思う"}]
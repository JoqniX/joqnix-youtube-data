[{"type": "subtitle", "time": 13388.87, "timestamp": "03:43:08", "text": "もの。でも、もしあなたがほとんど知らないなら"}, {"type": "subtitle", "time": 13390.67, "timestamp": "03:43:10", "text": "これらのもののうち、私は"}, {"type": "subtitle", "time": 13393.11, "timestamp": "03:43:13", "text": "信じる、例えば、あなたがもし"}, {"type": "subtitle", "time": 13395.03, "timestamp": "03:43:15", "text": "あなたはまったくの初心者ですよね？もし"}, {"type": "subtitle", "time": 13398.469, "timestamp": "03:43:18", "text": "あなたは実績のある企業に入社します"}, {"type": "subtitle", "time": 13400.269, "timestamp": "03:43:20", "text": "ウムコーポレート"}, {"type": "subtitle", "time": 13404.389, "timestamp": "03:43:24", "text": "環境、そう、彼らは"}, {"type": "subtitle", "time": 13408.63, "timestamp": "03:43:28", "text": "あなたはそれのあらゆる側面を理解しているはずです。だからあなたは"}, {"type": "subtitle", "time": 13409.95, "timestamp": "03:43:29", "text": "明らかに"}, {"type": "subtitle", "time": 13412.87, "timestamp": "03:43:32", "text": "何が許され、何が許されないのかを理解する"}, {"type": "subtitle", "time": 13415.75, "timestamp": "03:43:35", "text": "許可されている、あなたが"}, {"type": "subtitle", "time": 13417.99, "timestamp": "03:43:37", "text": "彼らと一緒にここにいて、"}, {"type": "subtitle", "time": 13419.75, "timestamp": "03:43:39", "text": "社内で何がそうでないか"}, {"type": "subtitle", "time": 13421.59, "timestamp": "03:43:41", "text": "許可された。"}, {"type": "subtitle", "time": 13423.99, "timestamp": "03:43:43", "text": "誰と誰について共有できますか"}, {"type": "subtitle", "time": 13426.55, "timestamp": "03:43:46", "text": "そして、あなたが共有できないもの"}, {"type": "subtitle", "time": 13430.03, "timestamp": "03:43:50", "text": "家族などにも、たくさんの"}, {"type": "subtitle", "time": 13433.91, "timestamp": "03:43:53", "text": "この分野には多くの厳格さがある"}, {"type": "chat", "time": 13434.615, "timestamp": "03:43:54", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "yeah they are really strict with that"}, {"type": "subtitle", "time": 13437.15, "timestamp": "03:43:57", "text": "黒人のような人"}]
[{"type": "subtitle", "time": 11282.91, "timestamp": "03:08:02", "text": "後。確か彼の情報はこの辺りにあったはずだ。"}, {"type": "subtitle", "time": 11285.389, "timestamp": "03:08:05", "text": "素晴らしい。うん、彼に聞いてみないと"}, {"type": "subtitle", "time": 11288.59, "timestamp": "03:08:08", "text": "金曜日。金曜日までに、もし彼が"}, {"type": "subtitle", "time": 11291.269, "timestamp": "03:08:11", "text": "美しさを完成させた、と彼女は月曜日に言った。"}, {"type": "subtitle", "time": 11293.429, "timestamp": "03:08:13", "text": "火曜日。ええ、いくつか更新する必要があります"}, {"type": "subtitle", "time": 11296.429, "timestamp": "03:08:16", "text": "リストとか色々。"}, {"type": "subtitle", "time": 11299.63, "timestamp": "03:08:19", "text": "えっと、YPストリームは"}, {"type": "subtitle", "time": 11303.55, "timestamp": "03:08:23", "text": "興味がある。私は連絡を取った。"}, {"type": "subtitle", "time": 11309.83, "timestamp": "03:08:29", "text": "ええ、実は私はいくつか欲しいんです"}, {"type": "subtitle", "time": 11312.389, "timestamp": "03:08:32", "text": "最近知り合った新しい人たち。"}, {"type": "subtitle", "time": 11314.63, "timestamp": "03:08:34", "text": "グループのために協力し、"}, {"type": "subtitle", "time": 11315.63, "timestamp": "03:08:35", "text": "グループ"}, {"type": "subtitle", "time": 11319.23, "timestamp": "03:08:39", "text": "コラボですよね？だから、私はそれらを"}, {"type": "subtitle", "time": 11322.55, "timestamp": "03:08:42", "text": "良い。だから私は、"}, {"type": "subtitle", "time": 11329.99, "timestamp": "03:08:49", "text": "えっと、彼らに連絡を取っていると、まるで彼らが"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "ダウンしたので、返信がありませんでした"}]
[{"type": "subtitle", "time": 541.43, "timestamp": "00:09:01", "text": "今日はのんびり過ごそう。では、"}, {"type": "subtitle", "time": 542.67, "timestamp": "00:09:02", "text": "雰囲気"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "の上。私たちの赤ちゃんたちは何？何？幽霊の"}, {"type": "subtitle", "time": 549.07, "timestamp": "00:09:09", "text": "バブ。これは何ですか？"}, {"type": "subtitle", "time": 550.99, "timestamp": "00:09:10", "text": "ええ、"}, {"type": "subtitle", "time": 552.99, "timestamp": "00:09:12", "text": "こんにちは。どうでしたか"}, {"type": "subtitle", "time": 555.63, "timestamp": "00:09:15", "text": "日？そして、"}, {"type": "subtitle", "time": 560.43, "timestamp": "00:09:20", "text": "あなた？では、"}, {"type": "subtitle", "time": 563.99, "timestamp": "00:09:23", "text": "傷。待って、環境音は必要？"}, {"type": "subtitle", "time": 570.03, "timestamp": "00:09:30", "text": "それは多すぎるだろう。ああ、接尾辞が"}, {"type": "subtitle", "time": 572.71, "timestamp": "00:09:32", "text": "うるさい。待てよ、それは著作権を発生させるぞ。"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "何だって？ああ、いやだ。なぜ言わなかったの？"}, {"type": "subtitle", "time": 577.389, "timestamp": "00:09:37", "text": "前に？私はDMしました"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "ズキさん。ああ、くそ。ああ、確かに"}, {"type": "subtitle", "time": 586.55, "timestamp": "00:09:46", "text": "著作権。ああ、痛み。我慢する。我慢する。"}, {"type": "subtitle", "time": 588.91, "timestamp": "00:09:48", "text": "持ち上げてください。所有"}, {"type": "subtitle", "time": 593.55, "timestamp": "00:09:53", "text": "上。私の炎の針。私の針"}]
[{"type": "subtitle", "time": 5162.229, "timestamp": "01:26:02", "text": "うん。確かに、私たちはピューピューと撃つべきだ。それは"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "楽しい。"}, {"type": "subtitle", "time": 5166.39, "timestamp": "01:26:06", "text": "私たちは愛憎を実践すべきだ"}, {"type": "subtitle", "time": 5169.149, "timestamp": "01:26:09", "text": "関係"}, {"type": "chat", "time": 5170.297, "timestamp": "01:26:10", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "fr 😔"}, {"type": "subtitle", "time": 5172.39, "timestamp": "01:26:12", "text": "ヴァル。私は人々にプレイしないように言うつもりです"}, {"type": "subtitle", "time": 5175.99, "timestamp": "01:26:15", "text": "ヴァル、でもその時はヴァロをプレイしているよ"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "そして彼らはこう言うでしょう、「なぜあなたは"}, {"type": "subtitle", "time": 5180.87, "timestamp": "01:26:20", "text": "「ジャルプールをプレイしてるの？」って聞いたら、「だって"}, {"type": "subtitle", "time": 5182.87, "timestamp": "01:26:22", "text": "愛憎入り混じった感情を抱いています。"}, {"type": "subtitle", "time": 5185.59, "timestamp": "01:26:25", "text": "ごめん。私はあなたをお勧めしません"}, {"type": "subtitle", "time": 5188.39, "timestamp": "01:26:28", "text": "みんな。君たちに苦しんでほしくない"}, {"type": "subtitle", "time": 5191.91, "timestamp": "01:26:31", "text": "どうも。だから、私を苦しませてください"}, {"type": "chat", "time": 5194.105, "timestamp": "01:26:34", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "you should definetly try counter strike sometime"}, {"type": "subtitle", "time": 5196.79, "timestamp": "01:26:36", "text": "A"}, {"type": "subtitle", "time": 5200.55, "timestamp": "01:26:40", "text": "苦しみと沈黙。うん。大丈夫。"}, {"type": "subtitle", "time": 5205.11, "timestamp": "01:26:45", "text": "別のゲーム、Shinovaは試してみましたか？"}, {"type": "subtitle", "time": 5208.87, "timestamp": "01:26:48", "text": "いいえ、私はある日それを試したと思います、"}, {"type": "subtitle", "time": 5211.59, "timestamp": "01:26:51", "text": "思うけど、それは私のタイプでもなかったし、"}, {"type": "subtitle", "time": 5214.39, "timestamp": "01:26:54", "text": "もの。マーベルも、私は"}, {"type": "subtitle", "time": 5216.79, "timestamp": "01:26:56", "text": "2、3回くらい。私はプレイしましたが、"}, {"type": "subtitle", "time": 5218.83, "timestamp": "01:26:58", "text": "それから私は"}]
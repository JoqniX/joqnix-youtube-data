[{"type": "subtitle", "time": 1441.71, "timestamp": "00:24:01", "text": "これはどのようにして生まれたのですか？"}, {"type": "subtitle", "time": 1444.83, "timestamp": "00:24:04", "text": "こんにちは。待って、あなたは"}, {"type": "subtitle", "time": 1448.87, "timestamp": "00:24:08", "text": "それ。だから、私は行く必要がない。待って、私は"}, {"type": "subtitle", "time": 1451.87, "timestamp": "00:24:11", "text": "行くべきだと思う"}, {"type": "subtitle", "time": 1461.11, "timestamp": "00:24:21", "text": "推測する。午後5時30分ヘリクサン川。手に入れた"}, {"type": "subtitle", "time": 1463.909, "timestamp": "00:24:23", "text": "それ。ガッチャ。ズキさん、ありがとう"}, {"type": "subtitle", "time": 1466.39, "timestamp": "00:24:26", "text": "時間を変換する。それは長かった"}, {"type": "subtitle", "time": 1470.149, "timestamp": "00:24:30", "text": "ジャンプ。大丈夫。私たちならできる。おお、"}, {"type": "subtitle", "time": 1473.39, "timestamp": "00:24:33", "text": "いいえ。私たちにはできなかった。その"}, {"type": "subtitle", "time": 1475.87, "timestamp": "00:24:35", "text": "大丈夫。完全に"}, {"type": "subtitle", "time": 1478.51, "timestamp": "00:24:38", "text": "大丈夫。ブームブーム"}, {"type": "subtitle", "time": 1486.47, "timestamp": "00:24:46", "text": "できなかった。それは、"}, {"type": "subtitle", "time": 1489.95, "timestamp": "00:24:49", "text": "画面全体。ええ、気づいてますよ"}, {"type": "subtitle", "time": 1494.39, "timestamp": "00:24:54", "text": "それ。 H なので"}, {"type": "subtitle", "time": 1498.71, "timestamp": "00:24:58", "text": "えーと、メディアがいないと"}]
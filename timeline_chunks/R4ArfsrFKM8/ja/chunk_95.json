[{"type": "subtitle", "time": 5701.75, "timestamp": "01:35:01", "text": "スマッシュが好きなら損益分岐点に達する。壊さないで。"}, {"type": "subtitle", "time": 5704.07, "timestamp": "01:35:04", "text": "えーと、ボタンを連打しても"}, {"type": "subtitle", "time": 5706.47, "timestamp": "01:35:06", "text": "テクノロジーとかそういうのが好き。"}, {"type": "subtitle", "time": 5709.99, "timestamp": "01:35:09", "text": "うん。それは、ほとんどの場合、今はとても"}, {"type": "subtitle", "time": 5712.55, "timestamp": "01:35:12", "text": "私たちは、とても多くのことを押し付けていることに慣れています"}, {"type": "subtitle", "time": 5715.75, "timestamp": "01:35:15", "text": "ボタンを同時に押す。 M. そうですか。"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "そのために作られた。だから、それは習慣のようなものだ"}, {"type": "subtitle", "time": 5721.83, "timestamp": "01:35:21", "text": "自分の指紋がべったり付いてしまうこと。"}, {"type": "subtitle", "time": 5724.149, "timestamp": "01:35:24", "text": "それが最も"}, {"type": "subtitle", "time": 5728.47, "timestamp": "01:35:28", "text": "うーん、それってちょっと気持ち悪いね。特に私の"}, {"type": "subtitle", "time": 5731.75, "timestamp": "01:35:31", "text": "兄貴がそれを使うと、私は「いや、兄貴。"}, {"type": "subtitle", "time": 5734.709, "timestamp": "01:35:34", "text": "やらないよ。あなたは食べて"}, {"type": "subtitle", "time": 5736.149, "timestamp": "01:35:36", "text": "すべてと、同じものをプレイすること"}, {"type": "subtitle", "time": 5738.629, "timestamp": "01:35:38", "text": "物事。E."}, {"type": "subtitle", "time": 5741.189, "timestamp": "01:35:41", "text": "待って、君はブラックエディションを持ってるんだよね？"}, {"type": "subtitle", "time": 5743.99, "timestamp": "01:35:43", "text": "私も黒色のものを持っていると思います。そして私は"}, {"type": "subtitle", "time": 5746.47, "timestamp": "01:35:46", "text": "コントローラーが4つ以上あります。"}, {"type": "subtitle", "time": 5748.87, "timestamp": "01:35:48", "text": "ああ、それでパーティーで遊べるんですね"}, {"type": "subtitle", "time": 5751.669, "timestamp": "01:35:51", "text": "人々。ニース。ええ、周りには人がいます"}, {"type": "subtitle", "time": 5754.55, "timestamp": "01:35:54", "text": "来るとか、そういうこと全部。私はそれで遊んでいます"}, {"type": "subtitle", "time": 5757.83, "timestamp": "01:35:57", "text": "いいですね。うん。友達と楽しく過ごす"}]
[{"type": "subtitle", "time": 10080.15, "timestamp": "02:48:00", "text": "触る。はい。はい。いいですね。うん。"}, {"type": "subtitle", "time": 10081.99, "timestamp": "02:48:01", "text": "うん。 Gをプレイすべきです。"}, {"type": "subtitle", "time": 10083.59, "timestamp": "02:48:03", "text": "タワー・オブ・ファンタジーを一緒にプレイしよう。あなたがすべき"}, {"type": "subtitle", "time": 10085.75, "timestamp": "02:48:05", "text": "案内してください、もしあなたが"}, {"type": "subtitle", "time": 10089.03, "timestamp": "02:48:09", "text": "1日無料。もちろんです。いいですね。"}, {"type": "subtitle", "time": 10091.269, "timestamp": "02:48:11", "text": "うん、ノートパソコンを手に入れたら"}, {"type": "subtitle", "time": 10094.79, "timestamp": "02:48:14", "text": "すべて8月か7月までに解決する"}, {"type": "subtitle", "time": 10097.99, "timestamp": "02:48:17", "text": "もしくは何か、ええと、そうですね、"}, {"type": "subtitle", "time": 10100.71, "timestamp": "02:48:20", "text": "その後、日本で、私は必ず"}, {"type": "subtitle", "time": 10103.67, "timestamp": "02:48:23", "text": "配信したり、ゲームしたり、何かできますよ。それから"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "うん、時間を決めて一緒に遊ぼう"}, {"type": "subtitle", "time": 10110.15, "timestamp": "02:48:30", "text": "などなど。それは面白そうですね。待てません。"}, {"type": "subtitle", "time": 10115.59, "timestamp": "02:48:35", "text": "うん。ええ、そうですね。えっと、出発する前に、えっと"}, {"type": "subtitle", "time": 10118.389, "timestamp": "02:48:38", "text": "何かメッセージやお知らせはありますか？"}, {"type": "subtitle", "time": 10122.309, "timestamp": "02:48:42", "text": "あるいは、あなたが作りたいものなら何でも？"}, {"type": "subtitle", "time": 10124.15, "timestamp": "02:48:44", "text": "発表と言わなければならないとしたら、"}, {"type": "subtitle", "time": 10125.83, "timestamp": "02:48:45", "text": "あなたの幸運を祈っています"}, {"type": "subtitle", "time": 10130.389, "timestamp": "02:48:50", "text": "日本の努力と彼と同じように"}, {"type": "subtitle", "time": 10133.11, "timestamp": "02:48:53", "text": "あなたはそこに落ち着いて、"}, {"type": "subtitle", "time": 10136.389, "timestamp": "02:48:56", "text": "日本での生活を楽しんでください。うん、私も。私"}, {"type": "subtitle", "time": 10138.87, "timestamp": "02:48:58", "text": "同じことを願うだろう。"}]
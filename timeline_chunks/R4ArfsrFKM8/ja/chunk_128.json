[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "フルタイムの仕事を見つけて"}, {"type": "subtitle", "time": 7682.79, "timestamp": "02:08:02", "text": "そこに留まるか、修士号を取得するか、"}, {"type": "subtitle", "time": 7685.43, "timestamp": "02:08:05", "text": "何か。ああ、そんな感じ。了解"}, {"type": "subtitle", "time": 7689.83, "timestamp": "02:08:09", "text": "良い計画ですね。 M ええ、そして私は"}, {"type": "subtitle", "time": 7693.589, "timestamp": "02:08:13", "text": "モデルになるために、お金を稼ぐために頑張るよ"}, {"type": "subtitle", "time": 7696.31, "timestamp": "02:08:16", "text": "えっと、日本からパートタイムで、その他いろいろ"}, {"type": "subtitle", "time": 7699.83, "timestamp": "02:08:19", "text": "でも、20分しか許可されていない"}, {"type": "subtitle", "time": 7702.629, "timestamp": "02:08:22", "text": "週あたりの時間数。だから私は「うん、そうするよ」って言ったんだ"}, {"type": "subtitle", "time": 7704.709, "timestamp": "02:08:24", "text": "私が何ができるか見て、"}, {"type": "subtitle", "time": 7707.99, "timestamp": "02:08:27", "text": "即興で何でもやるんだ。」うん。"}, {"type": "subtitle", "time": 7712.109, "timestamp": "02:08:32", "text": "唯一の問題は騒音だ"}, {"type": "subtitle", "time": 7716.55, "timestamp": "02:08:36", "text": "苦情を申し立てる時"}, {"type": "subtitle", "time": 7720.55, "timestamp": "02:08:40", "text": "えっと、だって私はドメトリーにいるんです。えーと"}, {"type": "subtitle", "time": 7723.75, "timestamp": "02:08:43", "text": "どうやら、"}, {"type": "subtitle", "time": 7726.149, "timestamp": "02:08:46", "text": "4月入学の人たちはこう言っていました"}, {"type": "subtitle", "time": 7729.27, "timestamp": "02:08:49", "text": "室内で電話を受けることは不可能です"}, {"type": "subtitle", "time": 7731.43, "timestamp": "02:08:51", "text": "部屋は騒音と見なされる可能性がある"}, {"type": "subtitle", "time": 7733.589, "timestamp": "02:08:53", "text": "苦情と他のルームメイト"}, {"type": "subtitle", "time": 7735.43, "timestamp": "02:08:55", "text": "外国人は不満を言うだろうし"}, {"type": "subtitle", "time": 7738.95, "timestamp": "02:08:58", "text": "もの。だから少し難しいと彼らは言った"}]
[{"type": "subtitle", "time": 3120.47, "timestamp": "00:52:00", "text": "今は休みです。"}, {"type": "subtitle", "time": 3123.67, "timestamp": "00:52:03", "text": "うわ、それは素晴らしい。雪合戦のように"}, {"type": "subtitle", "time": 3125.51, "timestamp": "00:52:05", "text": "そして全て。"}, {"type": "subtitle", "time": 3127.75, "timestamp": "00:52:07", "text": "ええ、ぜひ訪れてみてください。きっと気に入るよ。"}, {"type": "subtitle", "time": 3129.51, "timestamp": "00:52:09", "text": "ジョー。きっと気に入りますよ。本当だよ。した"}, {"type": "subtitle", "time": 3131.67, "timestamp": "00:52:11", "text": "スキーとかするの？ネズミは"}, {"type": "subtitle", "time": 3136.069, "timestamp": "00:52:16", "text": "スキーをする。はい。はい、私もスキーをしました。"}, {"type": "subtitle", "time": 3138.549, "timestamp": "00:52:18", "text": "私はパラグライダーをしようと思っていたのですが"}, {"type": "subtitle", "time": 3141.75, "timestamp": "00:52:21", "text": "私もそう思うけど、彼らは"}, {"type": "subtitle", "time": 3143.91, "timestamp": "00:52:23", "text": "そこの労働者たちは空気が"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "細すぎて持ち運べない"}, {"type": "subtitle", "time": 3149.43, "timestamp": "00:52:29", "text": "重量的に危険だろう。だから私たちは"}, {"type": "subtitle", "time": 3151.75, "timestamp": "00:52:31", "text": "それはできなかった。"}, {"type": "subtitle", "time": 3155.03, "timestamp": "00:52:35", "text": "それに、チューブスライディングとか、そういうのもやったよ。"}, {"type": "subtitle", "time": 3158.63, "timestamp": "00:52:38", "text": "大きな雪の山がある"}, {"type": "subtitle", "time": 3160.87, "timestamp": "00:52:40", "text": "山の上のように。そこから先は"}, {"type": "subtitle", "time": 3163.27, "timestamp": "00:52:43", "text": "スロープのようにして、その上を滑ります"}, {"type": "subtitle", "time": 3165.67, "timestamp": "00:52:45", "text": "チューブとかそういうもの。それも素晴らしかった。私"}, {"type": "subtitle", "time": 3168.95, "timestamp": "00:52:48", "text": "氷の上にお尻を乗せて"}]
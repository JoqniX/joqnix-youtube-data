[{"type": "subtitle", "time": 5460.629, "timestamp": "01:31:00", "text": "教区は文字通り自分自身を想像してください"}, {"type": "subtitle", "time": 5463.43, "timestamp": "01:31:03", "text": "配信をしているYouTuberとその他すべて"}, {"type": "subtitle", "time": 5466.629, "timestamp": "01:31:06", "text": "そして突然、個人情報が晒される。あなた"}, {"type": "subtitle", "time": 5469.51, "timestamp": "01:31:09", "text": "視聴者がゲームをくれるので、"}, {"type": "subtitle", "time": 5472.31, "timestamp": "01:31:12", "text": "ダウンロードしてインストールすれば、ダウンロードできます。"}, {"type": "subtitle", "time": 5474.47, "timestamp": "01:31:14", "text": "インストールしてください。そのホラーゲームをプレイしてみて。後"}, {"type": "subtitle", "time": 5478.149, "timestamp": "01:31:18", "text": "しばらくすると、カメラが"}, {"type": "subtitle", "time": 5482.87, "timestamp": "01:31:22", "text": "配信で表示しています。それは、なんてことだ。"}, {"type": "subtitle", "time": 5485.51, "timestamp": "01:31:25", "text": "それは、それは、さらにホラーがある"}, {"type": "subtitle", "time": 5488.47, "timestamp": "01:31:28", "text": "ゲーム。これはホラーゲームです。だから、"}, {"type": "subtitle", "time": 5492.229, "timestamp": "01:31:32", "text": "ホラー系のものもたくさんあります。"}, {"type": "subtitle", "time": 5494.709, "timestamp": "01:31:34", "text": "ニース。あなたを殺そうとしている特定の人々"}, {"type": "subtitle", "time": 5496.47, "timestamp": "01:31:36", "text": "そして全て。隠れなければならない"}, {"type": "subtitle", "time": 5502.87, "timestamp": "01:31:42", "text": "うん。私がそのゲームをプレイしたおかげで、"}, {"type": "subtitle", "time": 5506.229, "timestamp": "01:31:46", "text": "日本の土鍋や"}, {"type": "subtitle", "time": 5508.87, "timestamp": "01:31:48", "text": "アパートはこんな感じです。だから私は行く"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "日本に行って、どういうことか理解しました"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "物事は、あるいは小さな物事のようなもので、"}, {"type": "subtitle", "time": 5517.669, "timestamp": "01:31:57", "text": "すべて。それはなかなかクールだね。違う"}]
[{"type": "subtitle", "time": 3181.43, "timestamp": "00:53:01", "text": "待って、これらのことについて共有したことがある？"}, {"type": "subtitle", "time": 3184.15, "timestamp": "00:53:04", "text": "あなたの配信でも？旅行。私"}, {"type": "subtitle", "time": 3186.71, "timestamp": "00:53:06", "text": "正直に言うと、誰も知らないから"}, {"type": "subtitle", "time": 3191.349, "timestamp": "00:53:11", "text": "尋ねたが気に入らない"}, {"type": "subtitle", "time": 3193.349, "timestamp": "00:53:13", "text": "その理由を共有するのは、"}, {"type": "subtitle", "time": 3195.03, "timestamp": "00:53:15", "text": "私はvlogを作ろうと思って"}, {"type": "subtitle", "time": 3199.27, "timestamp": "00:53:19", "text": "すべてはご存知のとおり"}, {"type": "subtitle", "time": 3201.75, "timestamp": "00:53:21", "text": "私の流れ、私の携帯電話は実際に大音量で鳴り響きました"}, {"type": "subtitle", "time": 3205.99, "timestamp": "00:53:25", "text": "旅行だから、うんうん、実際うん、それで何"}, {"type": "subtitle", "time": 3209.03, "timestamp": "00:53:29", "text": "私の携帯電話は、とても"}, {"type": "subtitle", "time": 3211.75, "timestamp": "00:53:31", "text": "私がそれを受け取った時はかなりひどい状態だった"}, {"type": "subtitle", "time": 3214.79, "timestamp": "00:53:34", "text": "そして電話のバッテリーは、"}, {"type": "subtitle", "time": 3219.03, "timestamp": "00:53:39", "text": "腫れ始めた。だからそれは大きくて"}, {"type": "subtitle", "time": 3221.19, "timestamp": "00:53:41", "text": "母は私に電話を使うなと言った。それで、"}, {"type": "subtitle", "time": 3223.589, "timestamp": "00:53:43", "text": "私は友人の携帯電話でなんとか生き延びていた。"}, {"type": "subtitle", "time": 3225.27, "timestamp": "00:53:45", "text": "だから、すべての写真を入手できなかったし、"}, {"type": "subtitle", "time": 3226.19, "timestamp": "00:53:46", "text": "もの。"}, {"type": "subtitle", "time": 3228.87, "timestamp": "00:53:48", "text": "でも、私はvlogを作ろうと思っていました"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "それらの。でも今は、"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "できる。でも、もしそうするなら、投稿します"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "そうすれば分かるよ。とても魔法みたいね、ジョー。私"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "誓う。わーい。"}]
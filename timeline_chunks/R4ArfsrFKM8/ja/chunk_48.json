[{"type": "subtitle", "time": 2880.47, "timestamp": "00:48:00", "text": "共有しなければならない。そのため、ゲームをストリーミング配信している間"}, {"type": "subtitle", "time": 2883.91, "timestamp": "00:48:03", "text": "などなど、私は"}, {"type": "subtitle", "time": 2886.79, "timestamp": "00:48:06", "text": "チャット。最も注目されているのは"}, {"type": "subtitle", "time": 2889.03, "timestamp": "00:48:09", "text": "チャットであ​​って、ゲームではない。それは"}, {"type": "subtitle", "time": 2891.349, "timestamp": "00:48:11", "text": "私がゲームが下手なのはなぜか、でもそれはすべて"}, {"type": "subtitle", "time": 2895.27, "timestamp": "00:48:15", "text": "右。チャットは重要だよ、マジで。うん。それで、"}, {"type": "subtitle", "time": 2899.349, "timestamp": "00:48:19", "text": "うん、ストリーミングは大好きだけど、"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "しばらく配信していなかったので、今は配信が恋しいです。うん。"}, {"type": "subtitle", "time": 2907.43, "timestamp": "00:48:27", "text": "えっと、いつ活動休止したんですか？"}, {"type": "subtitle", "time": 2909.829, "timestamp": "00:48:29", "text": "何？何？高さは"}, {"type": "subtitle", "time": 2912.349, "timestamp": "00:48:32", "text": "ストリーミング配信など、すべて含めて。"}, {"type": "subtitle", "time": 2916.549, "timestamp": "00:48:36", "text": "えっと、実はしばらくの間やってたんだけど"}, {"type": "subtitle", "time": 2920.75, "timestamp": "00:48:40", "text": "不在だった。私はある場所にいました"}, {"type": "subtitle", "time": 2923.67, "timestamp": "00:48:43", "text": "マナリはヒマーチャル・プラデーシュ州にあるような場所だ。だから私は"}, {"type": "subtitle", "time": 2926.79, "timestamp": "00:48:46", "text": "旅行に行った。その後、私は"}, {"type": "subtitle", "time": 2929.03, "timestamp": "00:48:49", "text": "私が十分に一貫性を保てるということは"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "週に2回くらいストリーミング配信するけど"}, {"type": "subtitle", "time": 2935.829, "timestamp": "00:48:55", "text": "残念ながら、それは実現しない。"}, {"type": "subtitle", "time": 2939.109, "timestamp": "00:48:59", "text": "そして毎日、"}]
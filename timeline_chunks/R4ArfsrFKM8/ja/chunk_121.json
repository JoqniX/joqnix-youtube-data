[{"type": "subtitle", "time": 7262.629, "timestamp": "02:01:02", "text": "マイクの前に立つような感じ。私"}, {"type": "subtitle", "time": 7264.39, "timestamp": "02:01:04", "text": "知る。"}, {"type": "subtitle", "time": 7267.109, "timestamp": "02:01:07", "text": "うん。当時あなたの作品を楽しんでいました"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "あまりにも。信じられない光景だった。私はあなたが"}, {"type": "subtitle", "time": 7274.95, "timestamp": "02:01:14", "text": "昔はたった一つだけだった"}, {"type": "subtitle", "time": 7278.149, "timestamp": "02:01:18", "text": "えっと、なんて言うんだっけ、ストリーマー"}, {"type": "subtitle", "time": 7281.27, "timestamp": "02:01:21", "text": "ボットサミレオオーブのやつ、覚えてるよね？"}, {"type": "subtitle", "time": 7284.07, "timestamp": "02:01:24", "text": "ポータル関連のものすべてに触れる"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "取引はした、それはストリーマーボットだが、"}, {"type": "subtitle", "time": 7289.83, "timestamp": "02:01:29", "text": "リーンボードはあなたが扱っていたものではありませんでした"}, {"type": "subtitle", "time": 7292.149, "timestamp": "02:01:32", "text": "オーイェーイェーリーンを使っていたのは彼らだった"}, {"type": "subtitle", "time": 7295.83, "timestamp": "02:01:35", "text": "ボードサミーうんうん、私はただ"}, {"type": "subtitle", "time": 7298.229, "timestamp": "02:01:38", "text": "ストリーマーボット ストリーマーボットとタッチ"}, {"type": "subtitle", "time": 7302.229, "timestamp": "02:01:42", "text": "写真、なんてこった。すごい、すごかった。おお"}, {"type": "subtitle", "time": 7304.55, "timestamp": "02:01:44", "text": "うん、すべてがめちゃくちゃだった"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "私がやったこと。ええ、そして"}, {"type": "subtitle", "time": 7311.35, "timestamp": "02:01:51", "text": "Figmaアニメーションとあなたが作ったものすべて"}, {"type": "subtitle", "time": 7314.39, "timestamp": "02:01:54", "text": "あなたのシーンが好きです。あなたは"}, {"type": "subtitle", "time": 7317.91, "timestamp": "02:01:57", "text": "ブレインストーミングとか、すごく楽しかった。"}]
[{"type": "subtitle", "time": 2701.99, "timestamp": "00:45:01", "text": "追跡も。このモデルでも"}, {"type": "subtitle", "time": 2706.55, "timestamp": "00:45:06", "text": "手の動きを追跡するRCSを搭載しています。ああ、そうだね"}, {"type": "subtitle", "time": 2709.349, "timestamp": "00:45:09", "text": "デビュー配信でやったよ"}, {"type": "subtitle", "time": 2712.47, "timestamp": "00:45:12", "text": "表情が豊かで、"}, {"type": "subtitle", "time": 2715.27, "timestamp": "00:45:15", "text": "モーション追跡機能とか付いてるよ。"}, {"type": "subtitle", "time": 2717.43, "timestamp": "00:45:17", "text": "待って、ウェブカメラかiPhoneか"}, {"type": "subtitle", "time": 2718.95, "timestamp": "00:45:18", "text": "Leap Motionを買ったのは"}, {"type": "subtitle", "time": 2721.829, "timestamp": "00:45:21", "text": "手作業によるトラッキング？いや、いや。えっと、好きですか？"}, {"type": "subtitle", "time": 2725.23, "timestamp": "00:45:25", "text": "ウェブカメラ経由のみですか？ああ、ウェブカメラだ。わかった。"}, {"type": "subtitle", "time": 2728.47, "timestamp": "00:45:28", "text": "わかった。 Leapを使っている友人がいます"}, {"type": "chat", "time": 2731.981, "timestamp": "00:45:31", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "no like hyper has it built in you to use external software for vroids"}, {"type": "subtitle", "time": 2732.069, "timestamp": "00:45:32", "text": "手の動きを追跡する機能を使ったモーション。"}, {"type": "subtitle", "time": 2734.63, "timestamp": "00:45:34", "text": "私はいくつか"}, {"type": "subtitle", "time": 2738.63, "timestamp": "00:45:38", "text": "いろいろあるけど、お金がないんだよね"}, {"type": "subtitle", "time": 2741.109, "timestamp": "00:45:41", "text": "今はもう無理です。"}, {"type": "subtitle", "time": 2743.99, "timestamp": "00:45:43", "text": "ギャングを壊滅させた。さあ行こう。貧乏なギャング"}, {"type": "subtitle", "time": 2752.79, "timestamp": "00:45:52", "text": "空隙処理に外部ソフトウェアを使用したことがありますか？"}, {"type": "subtitle", "time": 2756.23, "timestamp": "00:45:56", "text": "うん、ハイパーにはそれが組み込まれているけど、私が"}, {"type": "subtitle", "time": 2759.43, "timestamp": "00:45:59", "text": "使用方法
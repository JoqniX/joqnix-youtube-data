[{"type": "subtitle", "time": 841.11, "timestamp": "00:14:01", "text": "怒ってないの？待って、これはゲームですか"}, {"type": "subtitle", "time": 844.629, "timestamp": "00:14:04", "text": "激怒するはずだったの？私は欲しい 私は欲しい"}, {"type": "subtitle", "time": 848.069, "timestamp": "00:14:08", "text": "ベニー・フロイドのやつを試してみて。えっと"}, {"type": "subtitle", "time": 851.269, "timestamp": "00:14:11", "text": "あれってなんていう名前だったっけ？えっと、その一つ"}, {"type": "subtitle", "time": 854.23, "timestamp": "00:14:14", "text": "ハゲの男がいる"}, {"type": "subtitle", "time": 857.59, "timestamp": "00:14:17", "text": "えっと、ポットみたいなやつに。スピードランをしたい"}, {"type": "subtitle", "time": 861.949, "timestamp": "00:14:21", "text": "あるいは、そんな感じ。楽しいでしょう"}, {"type": "subtitle", "time": 865.71, "timestamp": "00:14:25", "text": "ゲーム。遊びたい"}, {"type": "subtitle", "time": 869.949, "timestamp": "00:14:29", "text": "それ。私はわざと蛇を連れて行きます"}, {"type": "subtitle", "time": 888.99, "timestamp": "00:14:48", "text": "それ。取らせてください"}, {"type": "subtitle", "time": 891.31, "timestamp": "00:14:51", "text": "上。それは長い"}, {"type": "subtitle", "time": 893.55, "timestamp": "00:14:53", "text": "ジャンプ。大丈夫です。"}, {"type": "subtitle", "time": 896.91, "timestamp": "00:14:56", "text": "大丈夫。それは短い"}, {"type": "subtitle", "time": 898.949, "timestamp": "00:14:58", "text": "ジャンプ。本当にプレイしたいの？それ"}]
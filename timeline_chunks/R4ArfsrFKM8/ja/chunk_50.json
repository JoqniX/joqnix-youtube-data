[{"type": "subtitle", "time": 3002.71, "timestamp": "00:50:02", "text": "愛。もしもう一度そこへ行けるなら、行きたい。"}, {"type": "subtitle", "time": 3005.589, "timestamp": "00:50:05", "text": "その9日間はとても貴重です"}, {"type": "subtitle", "time": 3008.549, "timestamp": "00:50:08", "text": "自分。何てことだ。私はできない、私はできない"}, {"type": "subtitle", "time": 3010.549, "timestamp": "00:50:10", "text": "その話はやめよう。たとえそれが"}, {"type": "subtitle", "time": 3013.349, "timestamp": "00:50:13", "text": "私が来てから2ヶ月くらい経ちました"}, {"type": "subtitle", "time": 3017.829, "timestamp": "00:50:17", "text": "戻ってきたけど、あのビデオとか色々ね。おお"}, {"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "我が神よ。まるで魔法のようだ。それはまるで"}, {"type": "subtitle", "time": 3023.99, "timestamp": "00:50:23", "text": "ファンタジーの世界。"}, {"type": "subtitle", "time": 3025.829, "timestamp": "00:50:25", "text": "私はまだノアに触れていないので、"}, {"type": "subtitle", "time": 3027.67, "timestamp": "00:50:27", "text": "触ってみたい！何てことだ。あなたがすべき。"}, {"type": "subtitle", "time": 3030.87, "timestamp": "00:50:30", "text": "あなたがすべき。あなたは別のレベルの"}, {"type": "subtitle", "time": 3034.03, "timestamp": "00:50:34", "text": "平和と、それに似た静けさ。何てことだ。した"}, {"type": "subtitle", "time": 3036.87, "timestamp": "00:50:36", "text": "バルコニーとかあるの？ただ"}, {"type": "subtitle", "time": 3039.43, "timestamp": "00:50:39", "text": "すばらしい。雪だるま。はい。建てましたか？"}, {"type": "subtitle", "time": 3042.79, "timestamp": "00:50:42", "text": "それ？はい、そうしました。私もそれをやった"}, {"type": "subtitle", "time": 3046.71, "timestamp": "00:50:46", "text": "雪の天使は地面または"}, {"type": "subtitle", "time": 3048.79, "timestamp": "00:50:48", "text": "ええ、そうしました。あなたに聞こうと思っていたのですが"}, {"type": "subtitle", "time": 3051.19, "timestamp": "00:50:51", "text": "それ。物語のジョークを言いましたか？ああ、"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "神。ええ、そうしました。"}, {"type": "subtitle", "time": 3056.23, "timestamp": "00:50:56", "text": "雪合戦しましたか？スノーボール"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "ああ、なんてことだと戦ってください。ええ、そうしました。"}]
[{"type": "subtitle", "time": 1087.63, "timestamp": "00:18:07", "text": "ああ、それから毛布とホット"}, {"type": "subtitle", "time": 1090.789, "timestamp": "00:18:10", "text": "ココアの小さなリードは良い。ええ、彼らは"}, {"type": "subtitle", "time": 1098.51, "timestamp": "00:18:18", "text": "良い。"}, {"type": "subtitle", "time": 1101.47, "timestamp": "00:18:21", "text": "うん。そして私は倒れた"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "また。ジャンプに失敗する。私たちはより長い"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "ジャンプ。私たちは失敗する。私たちは遠くからジャンプする。"}, {"type": "subtitle", "time": 1111.95, "timestamp": "00:18:31", "text": "私たちは成功する"}, {"type": "subtitle", "time": 1121.95, "timestamp": "00:18:41", "text": "ジャンプ"}, {"type": "subtitle", "time": 1123.47, "timestamp": "00:18:43", "text": "ブーム"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "ブープ。そうそう。えっと、ブープが"}, {"type": "subtitle", "time": 1129.31, "timestamp": "00:18:49", "text": "1"}, {"type": "subtitle", "time": 1132.71, "timestamp": "00:18:52", "text": "もの。それは知らなかった。えっと、もしあなたが"}, {"type": "subtitle", "time": 1135.669, "timestamp": "00:18:55", "text": "かわいい人になりたかったのに、人を鼻でつつく"}]
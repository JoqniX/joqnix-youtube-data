[{"type": "subtitle", "time": 6841.99, "timestamp": "01:54:01", "text": "時々、私には大きな理由があります"}, {"type": "subtitle", "time": 6844.47, "timestamp": "01:54:04", "text": "このグースネック式のものを買った。 1つ"}, {"type": "subtitle", "time": 6849.03, "timestamp": "01:54:09", "text": "デスク周りのレイアウトと、スマホを使うためのレイアウトです。"}, {"type": "subtitle", "time": 6852.47, "timestamp": "01:54:12", "text": "想像する。遠い遠い"}, {"type": "subtitle", "time": 6855.629, "timestamp": "01:54:15", "text": "遠い昔、"}, {"type": "subtitle", "time": 6860.149, "timestamp": "01:54:20", "text": "私は実際にiPhoneか何かを手に入れます"}, {"type": "subtitle", "time": 6863.75, "timestamp": "01:54:23", "text": "顔追跡用。すごくいいですよ。おお"}, {"type": "subtitle", "time": 6865.27, "timestamp": "01:54:25", "text": "我が神よ。いいえ、私は"}, {"type": "subtitle", "time": 6867.91, "timestamp": "01:54:27", "text": "実際にiPhoneを買うことはないけど、まあ、決して買わないよ。"}, {"type": "subtitle", "time": 6870.55, "timestamp": "01:54:30", "text": "ある日。わからない。"}, {"type": "subtitle", "time": 6872.709, "timestamp": "01:54:32", "text": "そして、顔追跡装置も。質問。"}, {"type": "subtitle", "time": 6875.83, "timestamp": "01:54:35", "text": "ほうきに記録をつけます。信じられない。レイさん"}, {"type": "subtitle", "time": 6877.91, "timestamp": "01:54:37", "text": "きっとショックを受けたに違いない。教えてください、"}, {"type": "subtitle", "time": 6879.91, "timestamp": "01:54:39", "text": "ほうき？少し乱気流があり、"}, {"type": "subtitle", "time": 6882.229, "timestamp": "01:54:42", "text": "スピードが少し足りないが、"}, {"type": "subtitle", "time": 6884.47, "timestamp": "01:54:44", "text": "十分だ。それは傾向があったと言わざるを得ない"}, {"type": "subtitle", "time": 6886.229, "timestamp": "01:54:46", "text": "特定の点で少し左にずれる"}, {"type": "subtitle", "time": 6888.709, "timestamp": "01:54:48", "text": "回転。かすかなシューッという音が聞こえた"}, {"type": "subtitle", "time": 6892.79, "timestamp": "01:54:52", "text": "浸した。ああ、ありがとうございます。まさに"}, {"type": "subtitle", "time": 6896.629, "timestamp": "01:54:56", "text": "私が知りたかったこと。漂流したってこと？私"}, {"type": "subtitle", "time": 6899.43, "timestamp": "01:54:59", "text": "直ちに業務に取り掛かる。たとえ"}]
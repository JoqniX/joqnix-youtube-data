[{"type": "subtitle", "time": 4922.39, "timestamp": "01:22:02", "text": "やったー。ほら、パンでさえも"}, {"type": "subtitle", "time": 4934.95, "timestamp": "01:22:14", "text": "神。ミームが多すぎる。私にはこういうものがあるんです"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "私が理解できない場所、または"}, {"type": "subtitle", "time": 4940.39, "timestamp": "01:22:20", "text": "何か。理解できません。それは、えっと"}, {"type": "subtitle", "time": 4943.99, "timestamp": "01:22:23", "text": "私はみんなが"}, {"type": "subtitle", "time": 4945.91, "timestamp": "01:22:25", "text": "小さい頃のように、あるいは"}, {"type": "subtitle", "time": 4947.35, "timestamp": "01:22:27", "text": "あなたは幼稚園児で、トムと"}, {"type": "subtitle", "time": 4949.35, "timestamp": "01:22:29", "text": "ジェリー、みんな笑ってるよね？私はそれほど変わっている"}, {"type": "subtitle", "time": 4951.189, "timestamp": "01:22:31", "text": "笑わずにじっと見つめている人が一人いる"}, {"type": "subtitle", "time": 4954.629, "timestamp": "01:22:34", "text": "トムと"}, {"type": "subtitle", "time": 4956.95, "timestamp": "01:22:36", "text": "なんでみんな笑ってるの？"}, {"type": "subtitle", "time": 4959.43, "timestamp": "01:22:39", "text": "なぜ群衆の騒音が聞こえるのですか？なぜ"}, {"type": "subtitle", "time": 4962.47, "timestamp": "01:22:42", "text": "あの音、聞こえた？これは何の景色だったのか"}, {"type": "subtitle", "time": 4965.79, "timestamp": "01:22:45", "text": "こんな感じ？ こんな感じ？ こんな感じ？それは"}, {"type": "subtitle", "time": 4970.47, "timestamp": "01:22:50", "text": "自分。何てことだ。あなたはミームを作るのが得意ですか？"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "ええと、正直に言うと分かりませんが、"}, {"type": "subtitle", "time": 4976.229, "timestamp": "01:22:56", "text": "たくさんのミームとかを認識できる。それで、"}, {"type": "subtitle", "time": 4979.43, "timestamp": "01:22:59", "text": "私は自分が生きているようには感じない"}]
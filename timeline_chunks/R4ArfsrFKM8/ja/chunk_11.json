[{"type": "subtitle", "time": 660.069, "timestamp": "00:11:00", "text": "ハリスによるストリームビート"}, {"type": "subtitle", "time": 662.03, "timestamp": "00:11:02", "text": "ヘラ。えーと"}, {"type": "subtitle", "time": 670.43, "timestamp": "00:11:10", "text": "少し。えっと、昔はサクルがいたんだけど、待って"}, {"type": "subtitle", "time": 674.269, "timestamp": "00:11:14", "text": "さくらアルバム。はい。"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "ネコ。待って、それは違う。これがそれだ。"}, {"type": "subtitle", "time": 681.069, "timestamp": "00:11:21", "text": "遊ぶ。おい。これを再生してください。"}, {"type": "subtitle", "time": 688.19, "timestamp": "00:11:28", "text": "はぁ？"}, {"type": "subtitle", "time": 697.71, "timestamp": "00:11:37", "text": "わかった。うん、これは良いね。さあ"}, {"type": "subtitle", "time": 699.47, "timestamp": "00:11:39", "text": "行く。"}, {"type": "subtitle", "time": 702.67, "timestamp": "00:11:42", "text": "こんにちは。目覚め"}, {"type": "subtitle", "time": 705.269, "timestamp": "00:11:45", "text": "上。私の美しい歌声が必要なら"}, {"type": "subtitle", "time": 708.949, "timestamp": "00:11:48", "text": "声で、聞いてください。話したい。いいえ、それは"}, {"type": "subtitle", "time": 710.35, "timestamp": "00:11:50", "text": "悪い。"}, {"type": "subtitle", "time": 713.389, "timestamp": "00:11:53", "text": "BTM。私の読み間違いでしょうか？"}, {"type": "subtitle", "time": 715.71, "timestamp": "00:11:55", "text": "ベイブス。私は疑問に思う。"}, {"type": "subtitle", "time": 716.87, "timestamp": "00:11:56", "text": "[音楽]"}]
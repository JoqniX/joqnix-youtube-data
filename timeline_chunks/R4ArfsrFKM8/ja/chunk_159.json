[{"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "えーっと、1試合だけやってみて、どうなるか見てみよう"}, {"type": "subtitle", "time": 9546.87, "timestamp": "02:39:06", "text": "行くし、何もかも。それは、それは"}, {"type": "subtitle", "time": 9550.23, "timestamp": "02:39:10", "text": "赤？わからない。いいえ、私が戻ってきたのです"}, {"type": "subtitle", "time": 9551.79, "timestamp": "02:39:11", "text": "その時私は"}, {"type": "subtitle", "time": 9555.27, "timestamp": "02:39:15", "text": "ラグールは私の新しい名前になった。"}, {"type": "subtitle", "time": 9559.51, "timestamp": "02:39:19", "text": "今年の初め。だから私はまだラグっています"}, {"type": "subtitle", "time": 9563.349, "timestamp": "02:39:23", "text": "去年。ええ、そうだと思います。"}, {"type": "subtitle", "time": 9565.59, "timestamp": "02:39:25", "text": "それについてコメントしたと思います"}, {"type": "subtitle", "time": 9569.03, "timestamp": "02:39:29", "text": "私はバトルフィールドのニッチな分野に入りました"}, {"type": "subtitle", "time": 9571.83, "timestamp": "02:39:31", "text": "その時点では1人だった。それで、なぜ私は"}, {"type": "subtitle", "time": 9574.309, "timestamp": "02:39:34", "text": "バトルフィールド1、バトルフィールド5へ、"}, {"type": "subtitle", "time": 9576.95, "timestamp": "02:39:36", "text": "すべて？うん。"}, {"type": "subtitle", "time": 9579.04, "timestamp": "02:39:39", "text": "うん。 ああ、どうだった？そういう感じだった"}, {"type": "subtitle", "time": 9582.96, "timestamp": "02:39:42", "text": "ああ、どうだった？そういう感じだった うまくいき始めたのは、うまくいかなくなってからだった。"}, {"type": "subtitle", "time": 9586.24, "timestamp": "02:39:46", "text": "うまくいき始めたのは、うまくいかなくなってからだった。 そして私は、私が学んだこと"}, {"type": "subtitle", "time": 9589.28, "timestamp": "02:39:49", "text": "そして私は、私が学んだこと 自分を追い込みすぎているのは、"}, {"type": "subtitle", "time": 9592.319, "timestamp": "02:39:52", "text": "自分を追い込みすぎているのは、 その時点で、すべてのストリームをクリップします"}, {"type": "subtitle", "time": 9597.28, "timestamp": "02:39:57", "text": "その時点で、すべてのストリームをクリップします 20～30個のクリップを次に"}]
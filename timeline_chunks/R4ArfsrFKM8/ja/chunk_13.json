[{"type": "subtitle", "time": 780.269, "timestamp": "00:13:00", "text": "月"}, {"type": "subtitle", "time": 782.91, "timestamp": "00:13:02", "text": "今日？私は"}, {"type": "subtitle", "time": 791.269, "timestamp": "00:13:11", "text": "けれど。ああ、なんてことだ。君の姿を見たのを覚えているよ"}, {"type": "subtitle", "time": 792.91, "timestamp": "00:13:12", "text": "遊ぶ"}, {"type": "subtitle", "time": 795.509, "timestamp": "00:13:15", "text": "これ。待って。ああ、君は"}, {"type": "subtitle", "time": 798.87, "timestamp": "00:13:18", "text": "TwitchのJump Kingの配信ですよね？"}, {"type": "subtitle", "time": 814.75, "timestamp": "00:13:34", "text": "睡眠を見る。"}, {"type": "subtitle", "time": 817.629, "timestamp": "00:13:37", "text": "よし、彼は"}, {"type": "subtitle", "time": 820.23, "timestamp": "00:13:40", "text": "寝る。つまり、試行錯誤のようなものです"}, {"type": "subtitle", "time": 822.87, "timestamp": "00:13:42", "text": "ゲーム。もし私が"}, {"type": "subtitle", "time": 823.79, "timestamp": "00:13:43", "text": "遊ぶ"}, {"type": "subtitle", "time": 826.31, "timestamp": "00:13:46", "text": "彼ら。うん。"}, {"type": "subtitle", "time": 829.389, "timestamp": "00:13:49", "text": "ああ、血みどろのゲームもある"}, {"type": "subtitle", "time": 833.23, "timestamp": "00:13:53", "text": "沸騰。うん。しかし、中には"}, {"type": "subtitle", "time": 837.35, "timestamp": "00:13:57", "text": "平和的、と言えるかもしれませんね。調子はどうですか"}]
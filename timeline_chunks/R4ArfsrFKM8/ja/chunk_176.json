[{"type": "subtitle", "time": 10562.23, "timestamp": "02:56:02", "text": "彼。一緒に過ごせたらいいな"}, {"type": "subtitle", "time": 10564.71, "timestamp": "02:56:04", "text": "将来においても、合意は続くでしょう。"}, {"type": "subtitle", "time": 10567.03, "timestamp": "02:56:07", "text": "未来の空想を思い描いた。私"}, {"type": "subtitle", "time": 10569.349, "timestamp": "02:56:09", "text": "本当にそのゲームが大好きで、"}, {"type": "subtitle", "time": 10572.79, "timestamp": "02:56:12", "text": "あのゲームの話に戻ろう。それで、私はちょうど"}, {"type": "subtitle", "time": 10574.91, "timestamp": "02:56:14", "text": "研磨後に燃え尽きたので"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "多くの。今でもそのために努力したことを覚えています"}, {"type": "subtitle", "time": 10581.67, "timestamp": "02:56:21", "text": "オレンジ、赤からオレンジのようなボウル"}, {"type": "subtitle", "time": 10588.03, "timestamp": "02:56:28", "text": "あれ。プライム、えーと、えーと、"}, {"type": "subtitle", "time": 10591.269, "timestamp": "02:56:31", "text": "収集品。昔はそうだったよ、"}, {"type": "subtitle", "time": 10593.51, "timestamp": "02:56:33", "text": "あれは本当に楽しかった。"}, {"type": "subtitle", "time": 10596.19, "timestamp": "02:56:36", "text": "そうですね、プレイするのが待ちきれません"}, {"type": "subtitle", "time": 10598.71, "timestamp": "02:56:38", "text": "また。もう一度プレイして"}, {"type": "subtitle", "time": 10602.469, "timestamp": "02:56:42", "text": "今後、コードとの交流をお楽しみください。そうですね、"}, {"type": "subtitle", "time": 10603.87, "timestamp": "02:56:43", "text": "楽しんでいただけましたら"}, {"type": "subtitle", "time": 10608.389, "timestamp": "02:56:48", "text": "Coの会社です。どうぞフォローしてください。"}, {"type": "subtitle", "time": 10612.469, "timestamp": "02:56:52", "text": "彼はTwitchで活動しており、YouTubeチャンネルも持っている。"}, {"type": "subtitle", "time": 10614.95, "timestamp": "02:56:54", "text": "そしてTwitterアカウントもある。彼は"}, {"type": "subtitle", "time": 10617.87, "timestamp": "02:56:57", "text": "Twitterもそうだ。リンクは"}]
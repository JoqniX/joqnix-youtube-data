[{"type": "subtitle", "time": 9360.59, "timestamp": "02:36:00", "text": "すべて同じ"}, {"type": "subtitle", "time": 9364.23, "timestamp": "02:36:04", "text": "芒と小さな鰓が何であれ"}, {"type": "subtitle", "time": 9368.469, "timestamp": "02:36:08", "text": "サーバー内で見つけることができ、そしてまた"}, {"type": "subtitle", "time": 9371.19, "timestamp": "02:36:11", "text": "それによってさらに成長した。えっと"}, {"type": "subtitle", "time": 9372.349, "timestamp": "02:36:12", "text": "一方、"}, {"type": "subtitle", "time": 9375.51, "timestamp": "02:36:15", "text": "アロギの物事は現状のまま進んでいた。私は終わりました"}, {"type": "subtitle", "time": 9378.59, "timestamp": "02:36:18", "text": "どういうわけか男が10人をリードすることになった"}, {"type": "subtitle", "time": 9382.03, "timestamp": "02:36:22", "text": "どういうわけかギルド。"}, {"type": "subtitle", "time": 9385.429, "timestamp": "02:36:25", "text": "そう、それが私のメインギルドだったんです。それ"}, {"type": "subtitle", "time": 9386.95, "timestamp": "02:36:26", "text": "私のメインギルドでした。そしてそれは"}, {"type": "subtitle", "time": 9390.07, "timestamp": "02:36:30", "text": "他の小規模なギルドやその他諸々。そして"}, {"type": "subtitle", "time": 9393.03, "timestamp": "02:36:33", "text": "とても楽しかった。とても楽しかった。それ"}, {"type": "subtitle", "time": 9394.95, "timestamp": "02:36:34", "text": "それでもかなり楽しい。しかし今ゲームは"}, {"type": "subtitle", "time": 9397.11, "timestamp": "02:36:37", "text": "衰退している。だから、それはあまりなくなってきました。"}, {"type": "subtitle", "time": 9400.55, "timestamp": "02:36:40", "text": "よりリラックスできて、物も少ない。"}, {"type": "subtitle", "time": 9403.27, "timestamp": "02:36:43", "text": "でも、基本的にはそれが私の"}, {"type": "subtitle", "time": 9405.63, "timestamp": "02:36:45", "text": "インスピレーションはStar Citizenコミュニティから得たものです"}, {"type": "subtitle", "time": 9409.83, "timestamp": "02:36:49", "text": "私をさらに行動へと駆り立てた出来事"}, {"type": "subtitle", "time": 9413.27, "timestamp": "02:36:53", "text": "そして、この感覚をもたらすように"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "コミュニティが一体となる感覚"}, {"type": "subtitle", "time": 9419.67, "timestamp": "02:36:59", "text": "一体感と、その他すべて。それで"}]
[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "日。こんにちは。まずは彼女のクワッドバイクから始めましょう"}, {"type": "subtitle", "time": 7088.27, "timestamp": "01:58:08", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 7090.709, "timestamp": "01:58:10", "text": "確かに。私一人だけです。わあ、すごい。あなた"}, {"type": "subtitle", "time": 7092.39, "timestamp": "01:58:12", "text": "実は、私の古い写真を持っているんです。"}, {"type": "subtitle", "time": 7095.43, "timestamp": "01:58:15", "text": "どうやってそれを見つけたのですか？あれはディスコだ"}, {"type": "subtitle", "time": 7096.75, "timestamp": "01:58:16", "text": "反応性"}, {"type": "subtitle", "time": 7100.63, "timestamp": "01:58:20", "text": "する。ああ、これ、見逃してたよ。"}, {"type": "subtitle", "time": 7102.47, "timestamp": "01:58:22", "text": "[笑い]"}, {"type": "subtitle", "time": 7105.91, "timestamp": "01:58:25", "text": "確かに。確かに。ディオ、君がいなくて寂しかったよ。その"}, {"type": "subtitle", "time": 7109.43, "timestamp": "01:58:29", "text": "ずっと前からそうだった。何てことだ。ええ、"}, {"type": "subtitle", "time": 7111.99, "timestamp": "01:58:31", "text": "えっと、何だったかな？ 3年"}, {"type": "subtitle", "time": 7113.99, "timestamp": "01:58:33", "text": "今、私はそう思う。ほとんど。ええ、そうですね。"}, {"type": "subtitle", "time": 7115.91, "timestamp": "01:58:35", "text": "もう3年経ったと思う。"}, {"type": "subtitle", "time": 7119.27, "timestamp": "01:58:39", "text": "ええ、3年ですね。はい。 3つまたは"}, {"type": "subtitle", "time": 7121.75, "timestamp": "01:58:41", "text": "4年間。うん。"}, {"type": "subtitle", "time": 7124.629, "timestamp": "01:58:44", "text": "最後に覚えているのは、"}, {"type": "subtitle", "time": 7131.91, "timestamp": "01:58:51", "text": "ええ、私は深く関わっています"}, {"type": "subtitle", "time": 7134.47, "timestamp": "01:58:54", "text": "タワー・オブ・ファンタジーがトーナメントを開催開始"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "などなど。はい。それはおかしい。の"}]
[{"type": "subtitle", "time": 9782.15, "timestamp": "02:43:02", "text": "今。うん。うん。それら全てが"}, {"type": "subtitle", "time": 9784.23, "timestamp": "02:43:04", "text": "ストリームボード。うん。"}, {"type": "subtitle", "time": 9785.71, "timestamp": "02:43:05", "text": "それは"}, {"type": "subtitle", "time": 9789.349, "timestamp": "02:43:09", "text": "ショック。そして、あなたがその時"}, {"type": "subtitle", "time": 9797.51, "timestamp": "02:43:17", "text": "Twitterユーザーの表示名がmの場合"}, {"type": "subtitle", "time": 9799.83, "timestamp": "02:43:19", "text": "ライブ配信を行うとき。ああ、そうだよ"}, {"type": "subtitle", "time": 9802.469, "timestamp": "02:43:22", "text": "ええ、そうしました。あなたはチュートリアルを完了しました"}, {"type": "subtitle", "time": 9805.03, "timestamp": "02:43:25", "text": "などなど。覚えてる？うん、そうだね"}, {"type": "subtitle", "time": 9809.349, "timestamp": "02:43:29", "text": "それを覚えておいてください。確かに見ましたよ。"}, {"type": "subtitle", "time": 9811.51, "timestamp": "02:43:31", "text": "あなたから学んだと思う"}, {"type": "subtitle", "time": 9815.11, "timestamp": "02:43:35", "text": "複数のチャンネルを作成し、さらに多くのものが好きです"}, {"type": "subtitle", "time": 9818.309, "timestamp": "02:43:38", "text": "もっと、そう、もっとコードとかそういうのだよね"}, {"type": "subtitle", "time": 9820.15, "timestamp": "02:43:40", "text": "チュートリアルを作成しました"}, {"type": "subtitle", "time": 9823.11, "timestamp": "02:43:43", "text": "それからあなたは美容関連のチャンネルを作りました"}, {"type": "subtitle", "time": 9826.23, "timestamp": "02:43:46", "text": "それらのすべては、待って、それは、"}, {"type": "subtitle", "time": 9828.51, "timestamp": "02:43:48", "text": "美しさか、それとも私は"}, {"type": "subtitle", "time": 9832.23, "timestamp": "02:43:52", "text": "単に他の人と間違えただけだよ"}, {"type": "subtitle", "time": 9836.23, "timestamp": "02:43:56", "text": "神様、あの美容品は何だったの？"}, {"type": "subtitle", "time": 9839.429, "timestamp": "02:43:59", "text": "何か、いや、これはもっとコードだった"}]
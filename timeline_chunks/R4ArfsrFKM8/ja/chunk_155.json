[{"type": "subtitle", "time": 9301.71, "timestamp": "02:35:01", "text": "そして全て。"}, {"type": "subtitle", "time": 9307.03, "timestamp": "02:35:07", "text": "そして、こんなことが起こったのです。だからこれはノヴァだ"}, {"type": "subtitle", "time": 9310.87, "timestamp": "02:35:10", "text": "サーバーは稼働し、そのうちの1つは合併だった。"}, {"type": "subtitle", "time": 9313.429, "timestamp": "02:35:13", "text": "SCA地域自体のすべての"}, {"type": "subtitle", "time": 9316.23, "timestamp": "02:35:16", "text": "Tower of Fantasyの全サーバーの地域"}, {"type": "subtitle", "time": 9319.11, "timestamp": "02:35:19", "text": "単一のバックエンドに統合されました"}, {"type": "subtitle", "time": 9321.27, "timestamp": "02:35:21", "text": "サーバ。つまり、"}, {"type": "subtitle", "time": 9322.95, "timestamp": "02:35:22", "text": "あなたがプレイしているサーバーが何であれ"}, {"type": "subtitle", "time": 9325.27, "timestamp": "02:35:25", "text": "H noa またはあなたが交流できるもの"}, {"type": "subtitle", "time": 9327.59, "timestamp": "02:35:27", "text": "基本的に他の誰に対しても。だからそれは"}, {"type": "subtitle", "time": 9330.87, "timestamp": "02:35:30", "text": "だから彼らはそのおまじないを使ったのです。だから、"}, {"type": "subtitle", "time": 9334.07, "timestamp": "02:35:34", "text": "mojo が起こった、えっと、私も char にいました"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "そのモジョが起こる前は私も"}, {"type": "subtitle", "time": 9337.83, "timestamp": "02:35:37", "text": "異なるギルドを獲得するような責任"}, {"type": "subtitle", "time": 9341.389, "timestamp": "02:35:41", "text": "東ノアディスクと呼ばれる船に乗って"}, {"type": "subtitle", "time": 9343.91, "timestamp": "02:35:43", "text": "サーバーが正しいので、私は異なるものを取得していました"}, {"type": "subtitle", "time": 9345.83, "timestamp": "02:35:45", "text": "さまざまなギルドが参加し、"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "彼らにクルーの​​役割を与えて、"}, {"type": "subtitle", "time": 9351.27, "timestamp": "02:35:51", "text": "それらを促進し、"}, {"type": "subtitle", "time": 9353.19, "timestamp": "02:35:53", "text": "彼らへの発表とその他すべて"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "そんな感じ。サーバー統合が進むと"}, {"type": "subtitle", "time": 9358.389, "timestamp": "02:35:58", "text": "起こった後、私はそれを拡張し始めました"}]
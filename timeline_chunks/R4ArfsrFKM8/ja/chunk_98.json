[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "私はとても幸せです"}, {"type": "subtitle", "time": 5885.43, "timestamp": "01:38:05", "text": "あなたの配信に出演できるチャンス。"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "そう、私はいつも充電したいと思っていたのですが"}, {"type": "subtitle", "time": 5895.91, "timestamp": "01:38:15", "text": "私はこう思った"}, {"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "それで私は「なんてことだ」と思った。そして私と"}, {"type": "subtitle", "time": 5902.229, "timestamp": "01:38:22", "text": "そうですね、私はあなたに会ったと思います。"}, {"type": "subtitle", "time": 5904.669, "timestamp": "01:38:24", "text": "ちゃんと話せるし、"}, {"type": "subtitle", "time": 5908.149, "timestamp": "01:38:28", "text": "えっと、待って、あなたはアストロズのMCだったよね？"}, {"type": "subtitle", "time": 5911.03, "timestamp": "01:38:31", "text": "ルーン誕生。"}, {"type": "subtitle", "time": 5913.669, "timestamp": "01:38:33", "text": "うんうん、そうだった、そうだった、そううんうん"}, {"type": "subtitle", "time": 5915.669, "timestamp": "01:38:35", "text": "そうすれば私は話すことができた"}, {"type": "subtitle", "time": 5918.95, "timestamp": "01:38:38", "text": "もっとあなたに。その前に私は思う"}, {"type": "subtitle", "time": 5920.95, "timestamp": "01:38:40", "text": "VCに参加した時のこと"}, {"type": "subtitle", "time": 5923.75, "timestamp": "01:38:43", "text": "私たちは初めてまともに話し合った。はい。"}, {"type": "subtitle", "time": 5927.669, "timestamp": "01:38:47", "text": "はい。でもこれは初めての"}, {"type": "subtitle", "time": 5930.07, "timestamp": "01:38:50", "text": "私たちが話した内容。"}, {"type": "subtitle", "time": 5933.27, "timestamp": "01:38:53", "text": "きちんとした話し合いを。うん。きちんとした話し合いを。"}, {"type": "subtitle", "time": 5935.82, "timestamp": "01:38:55", "text": "うん。本当に面白いジョークだった。"}, {"type": "subtitle", "time": 5937.59, "timestamp": "01:38:57", "text": "[音楽]"}]
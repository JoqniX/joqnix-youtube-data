[{"type": "subtitle", "time": 9122.389, "timestamp": "02:32:02", "text": "そしてそれが唯一のもののように成長した"}, {"type": "subtitle", "time": 9124.71, "timestamp": "02:32:04", "text": "他のさまざまなゲームにもあるので"}, {"type": "subtitle", "time": 9127.99, "timestamp": "02:32:07", "text": "他にもたくさんのゲームオプションがあります"}, {"type": "subtitle", "time": 9130.1, "timestamp": "02:32:10", "text": "話し合うようなこと。"}, {"type": "subtitle", "time": 9131.27, "timestamp": "02:32:11", "text": "[音楽]"}, {"type": "subtitle", "time": 9134.79, "timestamp": "02:32:14", "text": "はい。うん。どうやってこのすべてに携わるようになったのですか"}, {"type": "subtitle", "time": 9136.79, "timestamp": "02:32:16", "text": "これはファンタジーグループの考えのようなもので、"}, {"type": "subtitle", "time": 9138.309, "timestamp": "02:32:18", "text": "すべて？どうやってメインになったのですか"}, {"type": "subtitle", "time": 9142.55, "timestamp": "02:32:22", "text": "男？例えば、どうやってやったんですか？のように"}, {"type": "subtitle", "time": 9145.03, "timestamp": "02:32:25", "text": "ゲームを開始して、参加した人と出会いました"}, {"type": "subtitle", "time": 9147.429, "timestamp": "02:32:27", "text": "ランダムなクランとあなたが話した"}, {"type": "subtitle", "time": 9149.75, "timestamp": "02:32:29", "text": "人々はあなたを好きになり、あなたは"}, {"type": "subtitle", "time": 9152.309, "timestamp": "02:32:32", "text": "その機会とか、そういうこと。"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "ええ、基本的にはそんな感じです。私はただ"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "当時、クルーに加わったのは"}, {"type": "subtitle", "time": 9159.59, "timestamp": "02:32:39", "text": "面白い名前だし、私は面白いのが好き"}, {"type": "subtitle", "time": 9163.19, "timestamp": "02:32:43", "text": "名前。それで私は参加して、それからどういうわけか"}, {"type": "subtitle", "time": 9165.27, "timestamp": "02:32:45", "text": "結局、私の貢献は"}, {"type": "subtitle", "time": 9168.07, "timestamp": "02:32:48", "text": "どういうわけかより高い地位に就いた"}, {"type": "subtitle", "time": 9170.55, "timestamp": "02:32:50", "text": "そして私は提案された"}, {"type": "subtitle", "time": 9173.99, "timestamp": "02:32:53", "text": "当時のギルドのオーナーへの"}, {"type": "subtitle", "time": 9176.55, "timestamp": "02:32:56", "text": "そして彼はその提案を気に入ったので私は"}, {"type": "subtitle", "time": 9178.87, "timestamp": "02:32:58", "text": "それらを実装するために作られ、その後"}]
[{"type": "subtitle", "time": 7922.629, "timestamp": "02:12:02", "text": "カード、私は 28 2060 スーパー 2060 を持っていました"}, {"type": "subtitle", "time": 7925.99, "timestamp": "02:12:05", "text": "ツインファン、そのGPUに搭載されているZOTAC製のファン"}, {"type": "subtitle", "time": 7928.75, "timestamp": "02:12:08", "text": "ファンが固着して問題がありました"}, {"type": "subtitle", "time": 7932.709, "timestamp": "02:12:12", "text": "既にその件について問題提起されています。そして私はそれを直した"}, {"type": "subtitle", "time": 7935.669, "timestamp": "02:12:15", "text": "交換用のファンなどを手に入れる"}, {"type": "subtitle", "time": 7937.99, "timestamp": "02:12:17", "text": "保証期間が過ぎていたからだ。だから私は"}, {"type": "subtitle", "time": 7941.43, "timestamp": "02:12:21", "text": "別の注文を自分で注文しましたが、"}, {"type": "subtitle", "time": 7944.79, "timestamp": "02:12:24", "text": "動作するはずなのにGPUもオーバー"}, {"type": "subtitle", "time": 7946.79, "timestamp": "02:12:26", "text": "時は過ぎ去った。"}, {"type": "subtitle", "time": 7949.069, "timestamp": "02:12:29", "text": "くそ、それは最悪だ。"}, {"type": "subtitle", "time": 7953.27, "timestamp": "02:12:33", "text": "うん。そして私は「わあ」と思った。私はそうしない。それから私は"}, {"type": "subtitle", "time": 7955.75, "timestamp": "02:12:35", "text": "まるで既に日本へ向かっているかのようだった"}, {"type": "subtitle", "time": 7959.83, "timestamp": "02:12:39", "text": "それは計画されていたことだった。だから私は、えーっと"}, {"type": "subtitle", "time": 7961.75, "timestamp": "02:12:41", "text": "寒さに負けそうになって"}, {"type": "subtitle", "time": 7965.51, "timestamp": "02:12:45", "text": "もの。だから私は「よし、たぶん"}, {"type": "subtitle", "time": 7968.31, "timestamp": "02:12:48", "text": "そうなら、試してみるべきかもしれない"}, {"type": "subtitle", "time": 7970.95, "timestamp": "02:12:50", "text": "ノートパソコンを手に入れるため。そっちの方がいいよ。"}, {"type": "subtitle", "time": 7974.31, "timestamp": "02:12:54", "text": "まるで本当に手に入れたいような"}, {"type": "subtitle", "time": 7978.87, "timestamp": "02:12:58", "text": "同じセットアップ、同じ特定のPCスペック"}]
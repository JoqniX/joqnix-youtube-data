[{"type": "subtitle", "time": 10020.55, "timestamp": "02:47:00", "text": "確かに。確かに。"}, {"type": "subtitle", "time": 10022.19, "timestamp": "02:47:02", "text": "何が"}, {"type": "subtitle", "time": 10026.15, "timestamp": "02:47:06", "text": "これ？今想像して目を閉じると"}, {"type": "subtitle", "time": 10027.99, "timestamp": "02:47:07", "text": "目、私はその中にいるような気がする"}, {"type": "subtitle", "time": 10031.349, "timestamp": "02:47:11", "text": "空想にふけるとか、そんな感じ。私が"}, {"type": "subtitle", "time": 10033.19, "timestamp": "02:47:13", "text": "私たちが話していたのは"}, {"type": "subtitle", "time": 10035.99, "timestamp": "02:47:15", "text": "チャンネルありがとう、そして今私は感じています"}, {"type": "subtitle", "time": 10039.349, "timestamp": "02:47:19", "text": "えっと、あなたのところを訪ねていたんです"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "場所や何か、またはあなたの訪問"}, {"type": "subtitle", "time": 10044.349, "timestamp": "02:47:24", "text": "これらのことを説明しているストリーム"}, {"type": "subtitle", "time": 10047.91, "timestamp": "02:47:27", "text": "もの。私はそれを想像して"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "「え、神様が現実世界で私と一緒にいるの？」って感じだった"}, {"type": "subtitle", "time": 10056.67, "timestamp": "02:47:36", "text": "ここみたいじゃない、夢の中でもない"}, {"type": "subtitle", "time": 10061.59, "timestamp": "02:47:41", "text": "世界。何てことだ。いいえ。"}, {"type": "subtitle", "time": 10064.95, "timestamp": "02:47:44", "text": "うん。今日は本当に楽しかった。私は"}, {"type": "subtitle", "time": 10067.16, "timestamp": "02:47:47", "text": "またお話しましょう。"}, {"type": "subtitle", "time": 10069.03, "timestamp": "02:47:49", "text": "[音楽]"}, {"type": "subtitle", "time": 10070.63, "timestamp": "02:47:50", "text": "確かに。私たちが"}, {"type": "subtitle", "time": 10074.15, "timestamp": "02:47:54", "text": "最後に話した。真実。真実。うん。そうするべきです。"}, {"type": "subtitle", "time": 10076.469, "timestamp": "02:47:56", "text": "もっとあなたと話して、"}]
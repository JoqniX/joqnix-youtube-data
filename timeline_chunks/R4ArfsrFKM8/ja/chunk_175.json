[{"type": "subtitle", "time": 10500.469, "timestamp": "02:55:00", "text": "楽しい、うんうん"}, {"type": "subtitle", "time": 10503.07, "timestamp": "02:55:03", "text": "それは"}, {"type": "subtitle", "time": 10506.469, "timestamp": "02:55:06", "text": "いいわ、私もおやすみなさい。だからこれは"}, {"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "私が切った場所"}, {"type": "subtitle", "time": 10510.63, "timestamp": "02:55:10", "text": "電話を切る。よし。うん。"}, {"type": "subtitle", "time": 10513.349, "timestamp": "02:55:13", "text": "うん。うん。うん。ありがとう。持つ"}, {"type": "subtitle", "time": 10516.23, "timestamp": "02:55:16", "text": "素晴らしいですね。ありがとう。それと、おやすみなさい"}, {"type": "subtitle", "time": 10518.23, "timestamp": "02:55:18", "text": "あなたのチャットにも。私は持っていません"}, {"type": "subtitle", "time": 10519.83, "timestamp": "02:55:19", "text": "チャットを確認しましたが、おやすみなさい"}, {"type": "subtitle", "time": 10522.87, "timestamp": "02:55:22", "text": "彼ら。うん。おやすみなさい、チャットさん。みんな"}, {"type": "subtitle", "time": 10525.99, "timestamp": "02:55:25", "text": "さよならを言って出発する。"}, {"type": "subtitle", "time": 10530.389, "timestamp": "02:55:30", "text": "さよなら。よし。さあ、３、２、"}, {"type": "subtitle", "time": 10533.87, "timestamp": "02:55:33", "text": "1つ。ディンディン"}, {"type": "subtitle", "time": 10536.83, "timestamp": "02:55:36", "text": "チーン。こんにちは。それ"}, {"type": "subtitle", "time": 10540.87, "timestamp": "02:55:40", "text": "再会できて本当に楽しかったし、"}, {"type": "subtitle", "time": 10545.309, "timestamp": "02:55:45", "text": "コードと話してください。つまり、私は裁判を欠席した"}, {"type": "subtitle", "time": 10549.11, "timestamp": "02:55:49", "text": "多く。私は裁判をとても欠席しましたが、"}, {"type": "subtitle", "time": 10551.429, "timestamp": "02:55:51", "text": "今日Coと再会できたんだけど、"}, {"type": "subtitle", "time": 10555.79, "timestamp": "02:55:55", "text": "楽しい。"}, {"type": "subtitle", "time": 10558.59, "timestamp": "02:55:58", "text": "だから、私は"}]
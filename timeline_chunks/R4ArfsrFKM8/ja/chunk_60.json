[{"type": "subtitle", "time": 3605.829, "timestamp": "01:00:05", "text": "右？さあ、仕事に戻ったぜ、ベイビー。ニース。"}, {"type": "chat", "time": 3607.172, "timestamp": "01:00:07", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Confronting stream??"}, {"type": "subtitle", "time": 3608.95, "timestamp": "01:00:08", "text": "ニース。ニース。それは素晴らしいですね。と言えば"}, {"type": "subtitle", "time": 3613.589, "timestamp": "01:00:13", "text": "えーと、仕事関係のこと、えーと、覚えてるよ、えーと"}, {"type": "subtitle", "time": 3615.75, "timestamp": "01:00:15", "text": "えっと、あなたの友達はレイン・ピーター・シャンでした。"}, {"type": "subtitle", "time": 3620.47, "timestamp": "01:00:20", "text": "右？レインちゃんと私はその投稿を見ました。"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "あなたはそこにいた。彼女は成功したが、私はできなかった"}, {"type": "subtitle", "time": 3626.15, "timestamp": "01:00:26", "text": "予想していたわけではないが、彼女は本当に"}, {"type": "subtitle", "time": 3630.87, "timestamp": "01:00:30", "text": "いいね、君。うん、彼女はいい人だよ。私は"}, {"type": "subtitle", "time": 3633.75, "timestamp": "01:00:33", "text": "彼女もここから降ろして、彼女は"}, {"type": "subtitle", "time": 3636.789, "timestamp": "01:00:36", "text": "いつかコラボしたいと思ったけど、彼女は"}, {"type": "subtitle", "time": 3640.309, "timestamp": "01:00:40", "text": "彼女は試験などで忙しい。"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "ええ、彼女はめったに配信しませんが、"}, {"type": "subtitle", "time": 3645.829, "timestamp": "01:00:45", "text": "いい人だ。"}, {"type": "subtitle", "time": 3649.19, "timestamp": "01:00:49", "text": "ダズを通して彼女のことをたくさん耳にした。"}, {"type": "subtitle", "time": 3653.109, "timestamp": "01:00:53", "text": "ダズを知っていますか？いや、実は知ってるよ"}, {"type": "subtitle", "time": 3656.069, "timestamp": "01:00:56", "text": "このコミュニティではごく少数の人しかおらず、"}, {"type": "chat", "time": 3656.895, "timestamp": "01:00:56", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "the arts pretty good"}, {"type": "subtitle", "time": 3658.15, "timestamp": "01:00:58", "text": "だって、私は人付き合いが苦手だって言ったでしょ。"}]
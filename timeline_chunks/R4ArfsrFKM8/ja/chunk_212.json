[{"type": "subtitle", "time": 12723.03, "timestamp": "03:32:03", "text": "クリエイターが"}, {"type": "subtitle", "time": 12726.389, "timestamp": "03:32:06", "text": "エージェンシーに参加しよう、それは集団のようなものだ"}, {"type": "subtitle", "time": 12729.99, "timestamp": "03:32:09", "text": "グループはストリームチームのようなものだ"}, {"type": "subtitle", "time": 12732.71, "timestamp": "03:32:12", "text": "彼らはあなたに与えない、彼らは走らない"}, {"type": "subtitle", "time": 12735.83, "timestamp": "03:32:15", "text": "あなたにIPアドレスを与えないでください"}, {"type": "subtitle", "time": 12737.91, "timestamp": "03:32:17", "text": "それを使って伝統的なもの"}, {"type": "subtitle", "time": 12740.229, "timestamp": "03:32:20", "text": "企業関連のこと。いいえ、これはむしろ"}, {"type": "subtitle", "time": 12743.07, "timestamp": "03:32:23", "text": "あなたが署名する養子縁組の方法"}, {"type": "subtitle", "time": 12746.95, "timestamp": "03:32:26", "text": "グリッチスターのIPと彼らと一緒にいること"}, {"type": "subtitle", "time": 12749.03, "timestamp": "03:32:29", "text": "そして彼らのサービスやその他すべてを利用して、"}, {"type": "subtitle", "time": 12751.03, "timestamp": "03:32:31", "text": "管理プロジェクトとその他すべて"}, {"type": "subtitle", "time": 12754.309, "timestamp": "03:32:34", "text": "自分のヌードを初公開することもできます"}, {"type": "subtitle", "time": 12758.55, "timestamp": "03:32:38", "text": "代理店とのモデル"}, {"type": "subtitle", "time": 12760.71, "timestamp": "03:32:40", "text": "彼らが提供するサポートとつながり"}, {"type": "subtitle", "time": 12762.55, "timestamp": "03:32:42", "text": "社内の著者と彼らが"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "そこから与える、それが一般的に"}, {"type": "subtitle", "time": 12769.75, "timestamp": "03:32:49", "text": "養子縁組斡旋機関は機能しています。だから、もし私が"}, {"type": "subtitle", "time": 12773.51, "timestamp": "03:32:53", "text": "戻ってみると、カサンは"}, {"type": "subtitle", "time": 12775.03, "timestamp": "03:32:55", "text": "デビュー"}, {"type": "subtitle", "time": 12778.229, "timestamp": "03:32:58", "text": "グラスと一緒に、彼女は新しいものをデビューさせる"}]
[{"type": "subtitle", "time": 10620.389, "timestamp": "02:57:00", "text": "説明と固定されたコメント"}, {"type": "subtitle", "time": 10623.19, "timestamp": "02:57:03", "text": "今日配信しているすべてのプラットフォーム。"}, {"type": "subtitle", "time": 10626.269, "timestamp": "02:57:06", "text": "ええ、どうぞご自由にフォローしてください。"}, {"type": "subtitle", "time": 10630.07, "timestamp": "02:57:10", "text": "フォローする。こんにちは。そうは言っても、"}, {"type": "subtitle", "time": 10633.87, "timestamp": "02:57:13", "text": "正式に終了しました"}, {"type": "subtitle", "time": 10638.75, "timestamp": "02:57:18", "text": "本日のコラボ企画。当日"}, {"type": "subtitle", "time": 10641.11, "timestamp": "02:57:21", "text": "日曜日。ええ、日曜日のことです。"}, {"type": "subtitle", "time": 10643.349, "timestamp": "02:57:23", "text": "これで正式に終了です。"}, {"type": "subtitle", "time": 10647.11, "timestamp": "02:57:27", "text": "ええ、まだいくつかあります"}, {"type": "subtitle", "time": 10649.269, "timestamp": "02:57:29", "text": "ここに押し込まなければならない人たちと"}, {"type": "subtitle", "time": 10651.87, "timestamp": "02:57:31", "text": "そこに、そしてダブルのように"}, {"type": "subtitle", "time": 10655.71, "timestamp": "02:57:35", "text": "無料かどうか再確認して、"}, {"type": "subtitle", "time": 10658.71, "timestamp": "02:57:38", "text": "もの。たくさんのこと。明日は"}, {"type": "subtitle", "time": 10663.11, "timestamp": "02:57:43", "text": "午後3時のトムインド標準時、仕事開始時刻は午前6時です。"}, {"type": "subtitle", "time": 10668.55, "timestamp": "02:57:48", "text": "午後インド標準時午後10時30分、デイヴィサンにて。 ISTから"}, {"type": "subtitle", "time": 10673.349, "timestamp": "02:57:53", "text": "12. その後、午前2時にアビサンの深夜ストリームが配信されます。"}, {"type": "subtitle", "time": 10676.469, "timestamp": "02:57:56", "text": "午前4時まで。わかった。だから明日私は"}, {"type": "subtitle", "time": 10679.75, "timestamp": "02:57:59", "text": "深夜配信。えっと、実際に"}]
[{"type": "subtitle", "time": 7984.47, "timestamp": "02:13:04", "text": "ストリーム用PCは50 5600XとRyzen 5です"}, {"type": "subtitle", "time": 7988.39, "timestamp": "02:13:08", "text": "5600Xと1660か何か、あるいは"}, {"type": "subtitle", "time": 7992.069, "timestamp": "02:13:12", "text": "20シリーズか30シリーズか何かにアップグレードした"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "GPUデスクトップで、私はこうしようと思っていました"}, {"type": "subtitle", "time": 7997.189, "timestamp": "02:13:17", "text": "それで私は「ああ、もし私が"}, {"type": "subtitle", "time": 7999.27, "timestamp": "02:13:19", "text": "日本ではいずれノートパソコンが必要になるだろう"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "今。ノートパソコンを買った方がいいんじゃない？"}, {"type": "subtitle", "time": 8003.35, "timestamp": "02:13:23", "text": "運ぶのは大変だろう"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "すべて順調です日本少し"}, {"type": "subtitle", "time": 8009.189, "timestamp": "02:13:29", "text": "寮でもあるから難しい。"}, {"type": "subtitle", "time": 8011.99, "timestamp": "02:13:31", "text": "6か月後に引っ越すか、私が望むなら"}, {"type": "subtitle", "time": 8014.709, "timestamp": "02:13:34", "text": "滞在することもできますし、私も引っ越すことができます。"}, {"type": "subtitle", "time": 8022.069, "timestamp": "02:13:42", "text": "だから私はノートパソコンを買おうと思った"}, {"type": "subtitle", "time": 8026.229, "timestamp": "02:13:46", "text": "日本ですが、みんながそれを買っていると言っています"}, {"type": "subtitle", "time": 8028.069, "timestamp": "02:13:48", "text": "日本から買う方が良い"}, {"type": "subtitle", "time": 8032.149, "timestamp": "02:13:52", "text": "インド出身なので、よし、やってみようと思いました"}, {"type": "subtitle", "time": 8034.39, "timestamp": "02:13:54", "text": "それ。どう思いますか？の方が良いですか"}]
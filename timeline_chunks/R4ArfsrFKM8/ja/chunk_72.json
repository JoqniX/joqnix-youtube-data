[{"type": "subtitle", "time": 4320.07, "timestamp": "01:12:00", "text": "Kさん、あなたの好きな音楽は何ですか？おお、"}, {"type": "subtitle", "time": 4322.07, "timestamp": "01:12:02", "text": "あなたの好きなアーティストや作品は何ですか？"}, {"type": "subtitle", "time": 4325.91, "timestamp": "01:12:05", "text": "いや、本当にわからないよ。その"}, {"type": "subtitle", "time": 4328.31, "timestamp": "01:12:08", "text": "ファンクを聴くようなものだ、"}, {"type": "subtitle", "time": 4331.31, "timestamp": "01:12:11", "text": "ポップスを聴く、メタルを聴く、"}, {"type": "subtitle", "time": 4336.31, "timestamp": "01:12:16", "text": "ロック、私はラナ・デ・ヴァレーの曲を聴きます"}, {"type": "subtitle", "time": 4338.63, "timestamp": "01:12:18", "text": "曲も聴きます。ビリー・アイシュ"}, {"type": "subtitle", "time": 4341.35, "timestamp": "01:12:21", "text": "週末にはそれらの曲も全部聴きます"}, {"type": "subtitle", "time": 4344.91, "timestamp": "01:12:24", "text": "そしてボリウッドでは、私は聞きません"}, {"type": "subtitle", "time": 4347.75, "timestamp": "01:12:27", "text": "ボリウッドだけど、私は昔聴いていた"}, {"type": "subtitle", "time": 4349.35, "timestamp": "01:12:29", "text": "ボリウッド"}, {"type": "subtitle", "time": 4352.43, "timestamp": "01:12:32", "text": "2018年のような古い歌と"}, {"type": "subtitle", "time": 4355.75, "timestamp": "01:12:35", "text": "2012年にはそれらすべてが、しかし最近はただ"}, {"type": "subtitle", "time": 4358.27, "timestamp": "01:12:38", "text": "くそ、マジかよ。"}, {"type": "subtitle", "time": 4361.99, "timestamp": "01:12:41", "text": "うわぁ。それはもっと下品で、ただ"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "コピーされたり、クカの言葉のように"}, {"type": "subtitle", "time": 4369.03, "timestamp": "01:12:49", "text": "意味がない。だから私は"}, {"type": "subtitle", "time": 4371.27, "timestamp": "01:12:51", "text": "それらすべて"}, {"type": "subtitle", "time": 4374.149, "timestamp": "01:12:54", "text": "インディーズソング。インディーズ系の曲って何？おお、"}]
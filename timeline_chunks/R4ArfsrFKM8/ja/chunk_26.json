[{"type": "subtitle", "time": 1560.99, "timestamp": "00:26:00", "text": "ズキ。ジャンプ。"}, {"type": "subtitle", "time": 1562.52, "timestamp": "00:26:02", "text": "ジャンプ。 ジャンプ。ジャンプ。ジャンプ。"}, {"type": "subtitle", "time": 1570.23, "timestamp": "00:26:10", "text": "このキャラクターがかわいそうに思える。いつでも"}, {"type": "subtitle", "time": 1574.47, "timestamp": "00:26:14", "text": "彼は飛び降りるように、彼は打つように"}, {"type": "subtitle", "time": 1576.19, "timestamp": "00:26:16", "text": "の"}, {"type": "subtitle", "time": 1581.549, "timestamp": "00:26:21", "text": "えーっと、彼は、彼が彼の"}, {"type": "subtitle", "time": 1586.51, "timestamp": "00:26:26", "text": "顔から落ちた。感じないで"}, {"type": "subtitle", "time": 1595.669, "timestamp": "00:26:35", "text": "強い？このキャラクターの強みは何ですか？"}, {"type": "subtitle", "time": 1599.19, "timestamp": "00:26:39", "text": "この決意を持って"}, {"type": "subtitle", "time": 1611.59, "timestamp": "00:26:51", "text": "精神的に、いや、精神的に"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "強くて、体力的にも強い。それが理由です"}]
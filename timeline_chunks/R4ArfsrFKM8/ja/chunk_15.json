[{"type": "subtitle", "time": 901.11, "timestamp": "00:15:01", "text": "なるほど。それはあなたを激怒させる。病気"}, {"type": "subtitle", "time": 903.11, "timestamp": "00:15:03", "text": "いつでも、いつでも試すことができます。私はなりたい"}, {"type": "subtitle", "time": 906.47, "timestamp": "00:15:06", "text": "あの男。私は今でもPTSDを抱えています。あれは何でしょう"}, {"type": "subtitle", "time": 908.829, "timestamp": "00:15:08", "text": "ゲーム？私は"}, {"type": "subtitle", "time": 912.47, "timestamp": "00:15:12", "text": "男。いい試合だったと思う。私"}, {"type": "subtitle", "time": 930.509, "timestamp": "00:15:30", "text": "ゆっくり。はぁ？それでは、"}, {"type": "subtitle", "time": 932.189, "timestamp": "00:15:32", "text": "何か。"}, {"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "えっと、何か良いことがあったんですか？"}, {"type": "subtitle", "time": 940.43, "timestamp": "00:15:40", "text": "今日の男たち？何か良い行いをしましたか？"}, {"type": "subtitle", "time": 943.829, "timestamp": "00:15:43", "text": "今日？まるで何でもあり得るかのように。手助けする"}, {"type": "subtitle", "time": 946.87, "timestamp": "00:15:46", "text": "両親が家事をしたり、良いことをしたり"}, {"type": "subtitle", "time": 952.31, "timestamp": "00:15:52", "text": "もの。うん。"}, {"type": "subtitle", "time": 955.15, "timestamp": "00:15:55", "text": "今日は、ご存知の通りです。"}, {"type": "subtitle", "time": 958.79, "timestamp": "00:15:58", "text": "ええ、それはあまり良くないでしょう"}]
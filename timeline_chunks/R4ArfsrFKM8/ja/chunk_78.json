[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "通りには大勢の人がいて、"}, {"type": "subtitle", "time": 4682.709, "timestamp": "01:18:02", "text": "見てて気に入った。私が見たとき"}, {"type": "subtitle", "time": 4684.709, "timestamp": "01:18:04", "text": "あのビデオを見て、「ああ、なんてことだ、"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "それは私がやりたいことなんです。私"}, {"type": "subtitle", "time": 4689.43, "timestamp": "01:18:09", "text": "インドでもそれができたらいいのに。それ"}, {"type": "subtitle", "time": 4691.27, "timestamp": "01:18:11", "text": "素晴らしいでしょう。」しかし、インドの人々は"}, {"type": "subtitle", "time": 4694.229, "timestamp": "01:18:14", "text": "テレビを破壊する、またはテレビを奪う、または盗む"}, {"type": "subtitle", "time": 4697.35, "timestamp": "01:18:17", "text": "あるいは、そんな感じ。ああ、私は"}, {"type": "subtitle", "time": 4700.79, "timestamp": "01:18:20", "text": "それ。だから、私は2つのバフが欲しい"}, {"type": "subtitle", "time": 4705.43, "timestamp": "01:18:25", "text": "ボディガードがローリングを警備する"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "私のモデルが出ているテレビのやつ。それ"}, {"type": "subtitle", "time": 4710.59, "timestamp": "01:18:30", "text": "になるだろう"}, {"type": "subtitle", "time": 4712.59, "timestamp": "01:18:32", "text": "いいね。えっと"}, {"type": "subtitle", "time": 4714.63, "timestamp": "01:18:34", "text": "[音楽]"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "コンサートをやってみたいと思ったことはありますか？"}, {"type": "subtitle", "time": 4720.87, "timestamp": "01:18:40", "text": "そして、私たちのようにキャリアの中で何か特別なことをするのですか？私はします。"}, {"type": "subtitle", "time": 4725.03, "timestamp": "01:18:45", "text": "したいけど、君が手に入れるみたい"}, {"type": "subtitle", "time": 4726.79, "timestamp": "01:18:46", "text": "人々はそれを行う準備ができています"}, {"type": "subtitle", "time": 4729.51, "timestamp": "01:18:49", "text": "私はとても緊張するので"}, {"type": "subtitle", "time": 4733.99, "timestamp": "01:18:53", "text": "一人でやりたい。私は人々に"}, {"type": "subtitle", "time": 4736.39, "timestamp": "01:18:56", "text": "誰が私に加わるだろうか。参加したい場合は"}]
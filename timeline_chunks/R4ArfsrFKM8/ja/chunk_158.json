[{"type": "subtitle", "time": 9480.389, "timestamp": "02:38:00", "text": "[音楽]"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "持続する。あなたはまだアートを共有していますか"}, {"type": "subtitle", "time": 9485.55, "timestamp": "02:38:05", "text": "Twitter のようなファンシー"}, {"type": "subtitle", "time": 9488.63, "timestamp": "02:38:08", "text": "他人の作品？あなたはそれを気に入って、"}, {"type": "subtitle", "time": 9490.79, "timestamp": "02:38:10", "text": "Discordで共有しますか？私は今でも覚えている"}, {"type": "subtitle", "time": 9499.429, "timestamp": "02:38:19", "text": "それがいつだったかは覚えていないが、"}, {"type": "subtitle", "time": 9503.03, "timestamp": "02:38:23", "text": "本当に素晴らしかった。"}, {"type": "subtitle", "time": 9507.19, "timestamp": "02:38:27", "text": "あなたがツイートしたのを覚えている、あるいは"}, {"type": "subtitle", "time": 9509.59, "timestamp": "02:38:29", "text": "発表するということは、"}, {"type": "subtitle", "time": 9513.19, "timestamp": "02:38:33", "text": "遊んでいるとき、えっと、わからない"}, {"type": "subtitle", "time": 9515.11, "timestamp": "02:38:35", "text": "さまざまな種類のゲーム"}, {"type": "subtitle", "time": 9517.27, "timestamp": "02:38:37", "text": "飽きたり何かあったら、"}, {"type": "subtitle", "time": 9520.55, "timestamp": "02:38:40", "text": "特定のニッチな権利"}, {"type": "subtitle", "time": 9525.429, "timestamp": "02:38:45", "text": "当時、まるで西側諸国のようで、彼女のコードは"}, {"type": "subtitle", "time": 9528.71, "timestamp": "02:38:48", "text": "あの時、あなたが投稿したのを覚えている"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "それについて"}, {"type": "subtitle", "time": 9535.429, "timestamp": "02:38:55", "text": "えーと、多様性をうまく活用できていないのは"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "あなたとあなたは実際に行くかもしれません"}, {"type": "subtitle", "time": 9539.19, "timestamp": "02:38:59", "text": "何か"}]
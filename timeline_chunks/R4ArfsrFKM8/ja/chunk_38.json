[{"type": "subtitle", "time": 2281.589, "timestamp": "00:38:01", "text": "実際、しばらくの間チューブを知っていた"}, {"type": "subtitle", "time": 2283.109, "timestamp": "00:38:03", "text": "2020"}, {"type": "subtitle", "time": 2286.87, "timestamp": "00:38:06", "text": "私が、それが"}, {"type": "subtitle", "time": 2290.23, "timestamp": "00:38:10", "text": "一緒に、私は次のようなYouTuberを発見しました"}, {"type": "subtitle", "time": 2293.349, "timestamp": "00:38:13", "text": "インドではなく、普通のユーチューバーのように"}, {"type": "subtitle", "time": 2295.75, "timestamp": "00:38:15", "text": "他の地域にいた人たちとか。"}, {"type": "subtitle", "time": 2298.069, "timestamp": "00:38:18", "text": "うん。うん。だから私はかなり熱心に取り組んでいた"}, {"type": "subtitle", "time": 2301.03, "timestamp": "00:38:21", "text": "私もそれをやりたいし、"}, {"type": "subtitle", "time": 2303.829, "timestamp": "00:38:23", "text": "しかし、インドではそうはならないだろうと思った。"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "可能。だから私はそれを諦めて、それから"}, {"type": "subtitle", "time": 2309.589, "timestamp": "00:38:29", "text": "私は編集者としてのキャリアをスタートさせました。それで私は"}, {"type": "subtitle", "time": 2312.47, "timestamp": "00:38:32", "text": "しばらくの間、フリーランスとして働く"}, {"type": "subtitle", "time": 2316.47, "timestamp": "00:38:36", "text": "1年か2年くらい経って、それから私は"}, {"type": "subtitle", "time": 2318.95, "timestamp": "00:38:38", "text": "ある日、たまたま座っていたら"}, {"type": "subtitle", "time": 2322.23, "timestamp": "00:38:42", "text": "私の膝の上に、私は「なぜ作らないのか」と思った。"}, {"type": "subtitle", "time": 2326.15, "timestamp": "00:38:46", "text": "一時使用のためのモデル。だから私は実際に"}, {"type": "subtitle", "time": 2328.95, "timestamp": "00:38:48", "text": "最初のモデルを手に入れました"}, {"type": "subtitle", "time": 2332.87, "timestamp": "00:38:52", "text": "えっと、私はそれをAと名付けました。それはJburyではなく、"}, {"type": "subtitle", "time": 2338.069, "timestamp": "00:38:58", "text": "AV。わかった。そしてそれは赤い髪をしていて、ええと"}]
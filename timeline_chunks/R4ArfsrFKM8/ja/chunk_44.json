[{"type": "subtitle", "time": 2642.95, "timestamp": "00:44:02", "text": "ハイパー。そしてこれはしばらくの間、"}, {"type": "subtitle", "time": 2646.23, "timestamp": "00:44:06", "text": "ストリーミング配信のために何かしたかったんです。"}, {"type": "subtitle", "time": 2656.23, "timestamp": "00:44:16", "text": "わからない。ハイパーモデルは簡単に"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "Hyperアプリ外でのストリーム配信などに使用する場合。"}, {"type": "subtitle", "time": 2663.109, "timestamp": "00:44:23", "text": "いいえ、ハイパーアプリには"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "仮想カメラが起動しました。接続できます"}, {"type": "subtitle", "time": 2669.51, "timestamp": "00:44:29", "text": "OBSに送れば、そこに表示できます"}, {"type": "subtitle", "time": 2673.03, "timestamp": "00:44:33", "text": "永遠に。おお、いいね、いいね、いいね。しかし、"}, {"type": "subtitle", "time": 2675.03, "timestamp": "00:44:35", "text": "唯一の問題は、"}, {"type": "chat", "time": 2675.621, "timestamp": "00:44:35", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "hyper also got Hand Motion Capture"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "ハイパーからモデルを除外し、それが制限する"}, {"type": "subtitle", "time": 2681.349, "timestamp": "00:44:41", "text": "たくさんのこと"}, {"type": "subtitle", "time": 2683.67, "timestamp": "00:44:43", "text": "ハイパーが提供する機能は"}, {"type": "subtitle", "time": 2688.23, "timestamp": "00:44:48", "text": "本当に限られています。だから私はそれをやらなければならなかった"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "そうやって出て行く。また表現"}, {"type": "subtitle", "time": 2694.95, "timestamp": "00:44:54", "text": "的を射ていなかったし、いろいろと問題があった。"}, {"type": "subtitle", "time": 2698.349, "timestamp": "00:44:58", "text": "うん。ああ、どうやら手振り身振りが使えるようになったみたいですね"}]
[{"type": "subtitle", "time": 2040.07, "timestamp": "00:34:00", "text": "今月は確か20日、26日、28日だったと思います。"}, {"type": "subtitle", "time": 2042.07, "timestamp": "00:34:02", "text": "私は2つの試験しか受けられません"}, {"type": "subtitle", "time": 2044.63, "timestamp": "00:34:04", "text": "日本へ直行する。フライトは"}, {"type": "subtitle", "time": 2048.27, "timestamp": "00:34:08", "text": "おそらく30番目か31番目。"}, {"type": "subtitle", "time": 2052.47, "timestamp": "00:34:12", "text": "ええ、そうですね。だから私はこう思った"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "試験を2つ受けて、えっと、私は"}, {"type": "subtitle", "time": 2057.669, "timestamp": "00:34:17", "text": "それらが何なのかも知らないし、"}, {"type": "subtitle", "time": 2061.03, "timestamp": "00:34:21", "text": "研究した。くそ。それは私です。"}, {"type": "subtitle", "time": 2069.829, "timestamp": "00:34:29", "text": "でも、それはできない。できない、できない"}, {"type": "subtitle", "time": 2073.349, "timestamp": "00:34:33", "text": "それは日本での話だけどね。私の両親"}, {"type": "subtitle", "time": 2075.829, "timestamp": "00:34:35", "text": "今たくさんお金を使って、"}, {"type": "subtitle", "time": 2079.31, "timestamp": "00:34:39", "text": "実際にたくさん勉強して、よく勉強して、"}, {"type": "subtitle", "time": 2082.629, "timestamp": "00:34:42", "text": "良い仕事に就くとか、そういうこと。だから私は"}, {"type": "subtitle", "time": 2086.55, "timestamp": "00:34:46", "text": "一生懸命働きなさい。はい。努力しなければならない。しなければならない"}, {"type": "chat", "time": 2088.472, "timestamp": "00:34:48", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqx"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "挽く。うん。"}, {"type": "subtitle", "time": 2094.23, "timestamp": "00:34:54", "text": "ニース。ニース。そして私は覚えている、私は"}, {"type": "subtitle", "time": 2098.15, "timestamp": "00:34:58", "text": "あなたのチャンネルを見つけました"}]
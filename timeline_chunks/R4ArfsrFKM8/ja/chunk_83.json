[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "世間から隔絶されたような人。だから私は"}, {"type": "subtitle", "time": 4984.07, "timestamp": "01:23:04", "text": "ミームをすべて更新して、"}, {"type": "subtitle", "time": 4987.91, "timestamp": "01:23:07", "text": "今起こっていること、そして私は"}, {"type": "subtitle", "time": 4990.149, "timestamp": "01:23:10", "text": "模倣することができる。わからない。私はしていません"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "試してみました。ええ、以上です。"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "そういえば、ザナのことを思い出したよ"}, {"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "イタリアのミームを教えてくれた人。えっと、それ"}, {"type": "subtitle", "time": 5002.27, "timestamp": "01:23:22", "text": "どのイタリアのミーム？"}, {"type": "subtitle", "time": 5006.629, "timestamp": "01:23:26", "text": "えっと、名前を忘れました。野球"}, {"type": "subtitle", "time": 5009.43, "timestamp": "01:23:29", "text": "目が何かある悪者。それから"}, {"type": "subtitle", "time": 5013.229, "timestamp": "01:23:33", "text": "平野のワニ"}, {"type": "subtitle", "time": 5016.149, "timestamp": "01:23:36", "text": "頭。えっと"}, {"type": "chat", "time": 5016.206, "timestamp": "01:23:36", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "btw today is national best friend day "}, {"type": "subtitle", "time": 5018.39, "timestamp": "01:23:38", "text": "その舌。"}, {"type": "subtitle", "time": 5022.35, "timestamp": "01:23:42", "text": "うん。うん。うん。神。あれはバレリーナですか？"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "カパシーナ？それです。うん。何てことだ。"}, {"type": "subtitle", "time": 5029.51, "timestamp": "01:23:49", "text": "それは、"}, {"type": "chat", "time": 5033.078, "timestamp": "01:23:53", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "italian brainrot mentioned"}, {"type": "subtitle", "time": 5033.11, "timestamp": "01:23:53", "text": "その間。うん。それはすばらしい。"}, {"type": "subtitle", "time": 5035.189, "timestamp": "01:23:55", "text": "うん。ちなみに、今日は全国ベストデーです"}, {"type": "subtitle", "time": 5037.11, "timestamp": "01:23:57", "text": "友達の日。何てことだ。それはすばらしい。それ"}]
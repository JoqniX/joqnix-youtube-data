[{"type": "subtitle", "time": 9002.469, "timestamp": "02:30:02", "text": "他にプレイしているゲームはありますか？"}, {"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "ファンタジーよりも？何かお好きなものはありますか？"}, {"type": "subtitle", "time": 9009.51, "timestamp": "02:30:09", "text": "いいえ。それはたった1ドルの空想に過ぎない。おお"}, {"type": "subtitle", "time": 9010.27, "timestamp": "02:30:10", "text": "私の"}, {"type": "subtitle", "time": 9012.99, "timestamp": "02:30:12", "text": "神。どうやって滞在するの？"}, {"type": "subtitle", "time": 9015.99, "timestamp": "02:30:15", "text": "ひたむきな？それは正気の沙汰ではない。はい、できます"}, {"type": "subtitle", "time": 9017.83, "timestamp": "02:30:17", "text": "最近は気軽にプレイするだけです。のように"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "5分間ログインして、日々のタスクを完了し、"}, {"type": "subtitle", "time": 9021.51, "timestamp": "02:30:21", "text": "週刊誌、どうぞ。 5日間ログイン"}, {"type": "subtitle", "time": 9022.87, "timestamp": "02:30:22", "text": "分、毎日の作業とビデオをこなして"}, {"type": "subtitle", "time": 9026.469, "timestamp": "02:30:26", "text": "基本的にはそんな感じで。"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "えっと、時々、"}, {"type": "subtitle", "time": 9030.87, "timestamp": "02:30:30", "text": "物語に2、3時間を費やす"}, {"type": "subtitle", "time": 9033.469, "timestamp": "02:30:33", "text": "そして完了する"}, {"type": "subtitle", "time": 9035.83, "timestamp": "02:30:35", "text": "話。ストーリーはかなり良かった。もし"}, {"type": "subtitle", "time": 9037.11, "timestamp": "02:30:37", "text": "君は物語とかそういうのが好きなんだね、"}, {"type": "subtitle", "time": 9038.87, "timestamp": "02:30:38", "text": "確かに、好きになるのは楽しい。うん。"}, {"type": "subtitle", "time": 9048.389, "timestamp": "02:30:48", "text": "えっと、好きなパーティーゲームはありますか？"}, {"type": "subtitle", "time": 9052.309, "timestamp": "02:30:52", "text": "友達と遊ぶのが好きですか？どんな種類ですか"}, {"type": "subtitle", "time": 9054.55, "timestamp": "02:30:54", "text": "どのようなパーティーゲームのことですか？"}, {"type": "subtitle", "time": 9058.07, "timestamp": "02:30:58", "text": "パーティーゲーム、例えばレポとか"}]
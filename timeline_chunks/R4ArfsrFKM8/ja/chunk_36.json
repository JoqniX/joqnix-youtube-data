[{"type": "subtitle", "time": 2160.55, "timestamp": "00:36:00", "text": "私は隅っこにいて、悲しい気持ちだった。それで"}, {"type": "subtitle", "time": 2162.95, "timestamp": "00:36:02", "text": "それからまたストリーミングを始めました、"}, {"type": "subtitle", "time": 2165.19, "timestamp": "00:36:05", "text": "自分のモデルとか色々作ってるんだ。それで"}, {"type": "subtitle", "time": 2168.39, "timestamp": "00:36:08", "text": "初披露した。ええ、その討論会を見ました。"}, {"type": "subtitle", "time": 2170.63, "timestamp": "00:36:10", "text": "ストリーム。とても楽しかったです。私はとても"}, {"type": "chat", "time": 2170.832, "timestamp": "00:36:10", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "elllo"}, {"type": "subtitle", "time": 2174.23, "timestamp": "00:36:14", "text": "神経質。 「ああ、これは私の"}, {"type": "subtitle", "time": 2177.15, "timestamp": "00:36:17", "text": "私のオリジナルデビューのように"}, {"type": "subtitle", "time": 2180.23, "timestamp": "00:36:20", "text": "モデル。ああ、もうハイパーはやめてくれ"}, {"type": "subtitle", "time": 2183.109, "timestamp": "00:36:23", "text": "モデル。私は何かが欲しかったんです"}, {"type": "subtitle", "time": 2186.47, "timestamp": "00:36:26", "text": "それは私の本音を代弁している。それで、私は作っていた"}, {"type": "subtitle", "time": 2189.349, "timestamp": "00:36:29", "text": "私の性格に関連する何か"}, {"type": "subtitle", "time": 2191.27, "timestamp": "00:36:31", "text": "これが私が考えていたキャラクターデザインです"}, {"type": "subtitle", "time": 2194.15, "timestamp": "00:36:34", "text": "心の中で、そして私はかなりうまくやったと思う"}, {"type": "subtitle", "time": 2198.069, "timestamp": "00:36:38", "text": "良い。かなりよくできていたと思います。"}, {"type": "subtitle", "time": 2200.79, "timestamp": "00:36:40", "text": "うん。待って、これは3Dなのか、それとも3Dに見えるライブ映像なのか？"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "2D？"}, {"type": "subtitle", "time": 2206.069, "timestamp": "00:36:46", "text": "いいえ、3Dです。ああ、3D。最初はこうだった"}, {"type": "subtitle", "time": 2208.15, "timestamp": "00:36:48", "text": "ライト。ちょっと待って。軽いですか"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "2D？それからMMDのダンス動画を作ったんだね"}, {"type": "subtitle", "time": 2217.67, "timestamp": "00:36:57", "text": "それで私は「ああ、3Dなんだ」と思ったんです。はい。"}]
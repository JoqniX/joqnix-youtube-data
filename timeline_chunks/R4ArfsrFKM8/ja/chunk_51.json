[{"type": "subtitle", "time": 3061.43, "timestamp": "00:51:01", "text": "そして私はそれで顔を平手打ちされた"}, {"type": "subtitle", "time": 3065.589, "timestamp": "00:51:05", "text": "分厚い氷が張っていて、私の顔は真っ赤だった。ああ、それは"}, {"type": "subtitle", "time": 3067.99, "timestamp": "00:51:07", "text": "まるで友達が３人いるみたいだった"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "私のものです。私たちは好きだからプレイしていた"}, {"type": "subtitle", "time": 3071.99, "timestamp": "00:51:11", "text": "初めて見たんですよね？だから彼は"}, {"type": "subtitle", "time": 3073.75, "timestamp": "00:51:13", "text": "ランダムな目から氷を拾った"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "どこにもなくて、お互いに殴り始めた"}, {"type": "subtitle", "time": 3078.309, "timestamp": "00:51:18", "text": "他の男はただストレート"}, {"type": "subtitle", "time": 3082.549, "timestamp": "00:51:22", "text": "大きな雪玉のようなボールを投げ上げた"}, {"type": "subtitle", "time": 3084.79, "timestamp": "00:51:24", "text": "そしてそれは私の顔に落ちて、"}, {"type": "subtitle", "time": 3086.549, "timestamp": "00:51:26", "text": "頬が赤くなって、何も感じなかった"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "麻痺のせいで、それからたぶん"}, {"type": "subtitle", "time": 3092.23, "timestamp": "00:51:32", "text": "俺は彼に悪態をついたよ、兄弟、君は"}, {"type": "subtitle", "time": 3095.109, "timestamp": "00:51:35", "text": "頭はいい感じだったけど、怪我しちゃったし、あなたと"}, {"type": "subtitle", "time": 3097.589, "timestamp": "00:51:37", "text": "悪い点は、私がちょうど"}, {"type": "subtitle", "time": 3101.99, "timestamp": "00:51:41", "text": "2週間くらい前に矯正器具をつけたので、"}, {"type": "subtitle", "time": 3104.63, "timestamp": "00:51:44", "text": "痛みを感じていたら、その男が私を殴った。私"}, {"type": "subtitle", "time": 3107.349, "timestamp": "00:51:47", "text": "すごく腹が立った。何てことだ。彼はあなたを殴ったのですか？"}, {"type": "subtitle", "time": 3109.829, "timestamp": "00:51:49", "text": "何？私を食べもしなかったの？ああ、彼は打った"}, {"type": "subtitle", "time": 3111.829, "timestamp": "00:51:51", "text": "ボールを持った私。いいえ。ああ、そうですね。うん。"}, {"type": "subtitle", "time": 3114.79, "timestamp": "00:51:54", "text": "わかった。わかった。うん。だから、私はちょうど終わったところだった"}, {"type": "subtitle", "time": 3117.19, "timestamp": "00:51:57", "text": "彼と一緒に。 「おい、戻らなきゃ」って感じだった"}]
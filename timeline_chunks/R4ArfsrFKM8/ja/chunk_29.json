[{"type": "subtitle", "time": 1744.23, "timestamp": "00:29:04", "text": "間違い。ええ、また彼は倒れました"}, {"type": "subtitle", "time": 1745.31, "timestamp": "00:29:05", "text": "彼の"}, {"type": "subtitle", "time": 1753.31, "timestamp": "00:29:13", "text": "そこには。こんにちは"}, {"type": "subtitle", "time": 1756.789, "timestamp": "00:29:16", "text": "みんな。こんにちは。こんにちは。だから私たちは"}, {"type": "subtitle", "time": 1762.63, "timestamp": "00:29:22", "text": "88日目の始まり、パート2。えっと"}, {"type": "subtitle", "time": 1765.35, "timestamp": "00:29:25", "text": "待って、88年？それとも89年？何てことだ。うん"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "89日か88日パート2ストリーミングナイト"}, {"type": "subtitle", "time": 1772.029, "timestamp": "00:29:32", "text": "ストリーム。それでは、ゲストのジャルさんをお迎えします。"}, {"type": "subtitle", "time": 1774.59, "timestamp": "00:29:34", "text": "パリジャン。こんにちは、ジャル"}, {"type": "subtitle", "time": 1778.43, "timestamp": "00:29:38", "text": "教区。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 1781.11, "timestamp": "00:29:41", "text": "こんにちは。どうしたの？ジョーさん、ありがとう"}, {"type": "subtitle", "time": 1783.99, "timestamp": "00:29:43", "text": "今日は私を招待してください。わーい。ええ、私は"}, {"type": "subtitle", "time": 1786.31, "timestamp": "00:29:46", "text": "ようこそお越しくださいました。はい。そして感謝します"}, {"type": "subtitle", "time": 1788.549, "timestamp": "00:29:48", "text": "来てくれてありがとう。それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 1792.47, "timestamp": "00:29:52", "text": "問題ない。問題ない。"}, {"type": "subtitle", "time": 1795.19, "timestamp": "00:29:55", "text": "Dさん、お元気ですか？これが私たちにとって初めてのコラボレーションです。おお"}, {"type": "subtitle", "time": 1798.47, "timestamp": "00:29:58", "text": "我が神よ。はい、これが私たちにとって初めてのコラボレーションです。私の"}]
[{"type": "subtitle", "time": 602.59, "timestamp": "00:10:02", "text": "分。これは"}, {"type": "subtitle", "time": 605.75, "timestamp": "00:10:05", "text": "仕事？待って。ジャックが必要だ。中国風"}, {"type": "subtitle", "time": 609.07, "timestamp": "00:10:09", "text": "あるいは、そんな感じ。さあ"}, {"type": "subtitle", "time": 611.15, "timestamp": "00:10:11", "text": "見る。ない"}, {"type": "subtitle", "time": 620.91, "timestamp": "00:10:20", "text": "カバーは伝説ではない？ない"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "ひび割れた。いや、私はのんびりできる暇つぶしが必要なんだ。その"}, {"type": "subtitle", "time": 626.75, "timestamp": "00:10:26", "text": "良い、"}, {"type": "subtitle", "time": 633.829, "timestamp": "00:10:33", "text": "不眠症。夜中。あ、待って。夜中"}, {"type": "subtitle", "time": 636.35, "timestamp": "00:10:36", "text": "弱火のようで、"}, {"type": "subtitle", "time": 638.46, "timestamp": "00:10:38", "text": "右？私"}, {"type": "subtitle", "time": 639.71, "timestamp": "00:10:39", "text": "[音楽]"}, {"type": "subtitle", "time": 648.03, "timestamp": "00:10:48", "text": "やや低め。それは"}, {"type": "subtitle", "time": 657.11, "timestamp": "00:10:57", "text": "loi。つまり、演奏する曲を探すだけ"}]
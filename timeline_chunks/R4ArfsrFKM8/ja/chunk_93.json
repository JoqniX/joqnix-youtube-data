[{"type": "subtitle", "time": 5581.83, "timestamp": "01:33:01", "text": "購読して、彼らは自分たちで"}, {"type": "subtitle", "time": 5585.11, "timestamp": "01:33:05", "text": "ゲーム内では、モデルやその他が"}, {"type": "subtitle", "time": 5588.31, "timestamp": "01:33:08", "text": "バナーか何か、または広告"}, {"type": "subtitle", "time": 5593.35, "timestamp": "01:33:13", "text": "あるいは、そのような雑誌。それはすばらしい。"}, {"type": "subtitle", "time": 5596.39, "timestamp": "01:33:16", "text": "ええ、本当にたくさんあります。"}, {"type": "subtitle", "time": 5599.87, "timestamp": "01:33:19", "text": "たくさんのホラーゲーム。たくさんの"}, {"type": "subtitle", "time": 5603.91, "timestamp": "01:33:23", "text": "もの。ああ、お化け列車。"}, {"type": "subtitle", "time": 5606.95, "timestamp": "01:33:26", "text": "チャンネルラジオ局。とてもたくさん"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "日本の民話や"}, {"type": "subtitle", "time": 5611.11, "timestamp": "01:33:31", "text": "もの。"}, {"type": "subtitle", "time": 5615.79, "timestamp": "01:33:35", "text": "ああ、なるほど。なるほど。それはある意味"}, {"type": "subtitle", "time": 5618.47, "timestamp": "01:33:38", "text": "いいね。どうして私がそれを知っているのかは聞かないで"}, {"type": "subtitle", "time": 5620.95, "timestamp": "01:33:40", "text": "これ？他のユーチューバーの動画を見た"}, {"type": "subtitle", "time": 5623.11, "timestamp": "01:33:43", "text": "これをプレイしたら、「ああ、これは"}, {"type": "subtitle", "time": 5625.03, "timestamp": "01:33:45", "text": "いいね。\""}, {"type": "subtitle", "time": 5627.43, "timestamp": "01:33:47", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 5628.22, "timestamp": "01:33:48", "text": "それは"}, {"type": "subtitle", "time": 5629.629, "timestamp": "01:33:49", "text": "[音楽]"}, {"type": "subtitle", "time": 5633.59, "timestamp": "01:33:53", "text": "ニース。いつか挑戦してみたい。待って、"}, {"type": "subtitle", "time": 5637.27, "timestamp": "01:33:57", "text": "あなたはレースゲームが好きですか？"}]
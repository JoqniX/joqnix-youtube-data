[{"type": "subtitle", "time": 9963.15, "timestamp": "02:46:03", "text": "ああ、私が始めたときからずっと"}, {"type": "subtitle", "time": 9966.63, "timestamp": "02:46:06", "text": "Vチャネルのマ​​ルチリーミングは、"}, {"type": "subtitle", "time": 9970.07, "timestamp": "02:46:10", "text": "空っぽで非アクティブで、"}, {"type": "subtitle", "time": 9973.11, "timestamp": "02:46:13", "text": "マルチリーミングをしているのが申し訳ないと思うので"}, {"type": "subtitle", "time": 9975.19, "timestamp": "02:46:15", "text": "私が以前使っていたようなTwitch WSをアップロードする必要はありません"}, {"type": "subtitle", "time": 9976.81, "timestamp": "02:46:16", "text": "事前にやるべきこと。"}, {"type": "subtitle", "time": 9978.55, "timestamp": "02:46:18", "text": "[音楽]"}, {"type": "subtitle", "time": 9981.349, "timestamp": "02:46:21", "text": "そして、ショートパンツが登場した。それからみんな"}, {"type": "subtitle", "time": 9983.51, "timestamp": "02:46:23", "text": "短い形式のコンテンツを作り始め、"}, {"type": "subtitle", "time": 9986.87, "timestamp": "02:46:26", "text": "独自のチャンネルを作成する。今、"}, {"type": "subtitle", "time": 9989.59, "timestamp": "02:46:29", "text": "YouTubeはショート動画タブを追加しました。"}, {"type": "subtitle", "time": 9992.07, "timestamp": "02:46:32", "text": "短いタブは持っていませんでした。右。"}, {"type": "subtitle", "time": 9994.71, "timestamp": "02:46:34", "text": "うん。右。"}, {"type": "subtitle", "time": 9997.429, "timestamp": "02:46:37", "text": "それら全て。だから私は疑問に思う"}, {"type": "subtitle", "time": 10000.79, "timestamp": "02:46:40", "text": "ある意味でYouTubeはより多くの機能を提供してきた"}, {"type": "subtitle", "time": 10003.75, "timestamp": "02:46:43", "text": "それ以来ずっと。だから私は"}, {"type": "subtitle", "time": 10005.99, "timestamp": "02:46:45", "text": "未来はもっと良くなるだろう"}, {"type": "subtitle", "time": 10008.95, "timestamp": "02:46:48", "text": "そして視聴者のさらに詳しい情報"}, {"type": "subtitle", "time": 10010.79, "timestamp": "02:46:50", "text": "経験。彼らは状況を改善してくれるだろう。私"}, {"type": "subtitle", "time": 10012.79, "timestamp": "02:46:52", "text": "感じる"}, {"type": "subtitle", "time": 10015.23, "timestamp": "02:46:55", "text": "ええ、そうかもしれませんね。"}, {"type": "subtitle", "time": 10018.469, "timestamp": "02:46:58", "text": "うん。たくさんのこと。"}]
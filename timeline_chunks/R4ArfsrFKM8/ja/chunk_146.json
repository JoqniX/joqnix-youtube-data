[{"type": "subtitle", "time": 8762.389, "timestamp": "02:26:02", "text": "労力に見合うだけの見返りは少ない。ない限り"}, {"type": "subtitle", "time": 8764.309, "timestamp": "02:26:04", "text": "あなたは楽しみのためにそれをやっている。例えば、あなたが"}, {"type": "subtitle", "time": 8765.99, "timestamp": "02:26:05", "text": "プロとしてやろうとすると、それは"}, {"type": "subtitle", "time": 8771.03, "timestamp": "02:26:11", "text": "物事を手に入れるのに手間がかかりすぎる。うん。"}, {"type": "subtitle", "time": 8774.15, "timestamp": "02:26:14", "text": "楽しみながらやるのは良いことだ。はい。それを実行する"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "楽しむのはいいけど、これは"}, {"type": "subtitle", "time": 8780.39, "timestamp": "02:26:20", "text": "もう全然楽しくない。"}, {"type": "subtitle", "time": 8783.27, "timestamp": "02:26:23", "text": "[音楽]"}, {"type": "subtitle", "time": 8784.67, "timestamp": "02:26:24", "text": "よくやった。"}, {"type": "subtitle", "time": 8794.79, "timestamp": "02:26:34", "text": "私はマックスと話していて、"}, {"type": "subtitle", "time": 8797.83, "timestamp": "02:26:37", "text": "あなたについて話すと、私は"}, {"type": "subtitle", "time": 8800.15, "timestamp": "02:26:40", "text": "君がいなくて寂しいよ、と彼は言った。「ああ、彼はまだ"}, {"type": "subtitle", "time": 8803.63, "timestamp": "02:26:43", "text": "話し合い。あなたたち二人は今でも連絡を取り合ったりしているわね。"}, {"type": "subtitle", "time": 8805.309, "timestamp": "02:26:45", "text": "右。"}, {"type": "subtitle", "time": 8808.71, "timestamp": "02:26:48", "text": "うん。もう使わないと思ってたんだけど"}, {"type": "subtitle", "time": 8812.389, "timestamp": "02:26:52", "text": "アカウント。このDiscordアカウント。役に立たない"}, {"type": "subtitle", "time": 8816.87, "timestamp": "02:26:56", "text": "それ。サーバーが非アクティブだった"}, {"type": "subtitle", "time": 8819.429, "timestamp": "02:26:59", "text": "いつかはそうならないだろう。ああ、私の"}]
[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "モデルは、ご覧のとおり、彼女のメイン投稿が新しい"}, {"type": "subtitle", "time": 12784.87, "timestamp": "03:33:04", "text": "モデルは7月12日にデビューしたので、彼女は"}, {"type": "subtitle", "time": 12786.349, "timestamp": "03:33:06", "text": "新しい"}, {"type": "subtitle", "time": 12790.07, "timestamp": "03:33:10", "text": "彼女が参加している間モデル"}, {"type": "subtitle", "time": 12793.429, "timestamp": "03:33:13", "text": "公に知られている彼女は"}, {"type": "subtitle", "time": 12796.309, "timestamp": "03:33:16", "text": "グリスタスに加わったので、彼女は"}, {"type": "subtitle", "time": 12799.229, "timestamp": "03:33:19", "text": "参加モデルですよね？それは"}, {"type": "subtitle", "time": 12801.91, "timestamp": "03:33:21", "text": "これは彼女のデビュー作になる予定です"}, {"type": "subtitle", "time": 12803.83, "timestamp": "03:33:23", "text": "ストリーム。右？それでは、大きな"}, {"type": "subtitle", "time": 12807.03, "timestamp": "03:33:27", "text": "彼女は透明性を確保するために、それらの事項をリストアップした。"}, {"type": "subtitle", "time": 12809.59, "timestamp": "03:33:29", "text": "ああ、これはユーチューバーがいつもやっていることだ"}, {"type": "subtitle", "time": 12813.11, "timestamp": "03:33:33", "text": "それ以来、サンジとクロサンジのもの"}, {"type": "subtitle", "time": 12815.349, "timestamp": "03:33:35", "text": "そして全てが順調だった。新しい機関"}, {"type": "subtitle", "time": 12819.349, "timestamp": "03:33:39", "text": "ウィル"}, {"type": "subtitle", "time": 12822.55, "timestamp": "03:33:42", "text": "ブランドイメージの件、透明性のために"}, {"type": "subtitle", "time": 12824.63, "timestamp": "03:33:44", "text": "そうすれば人々は私たちが"}, {"type": "subtitle", "time": 12827.429, "timestamp": "03:33:47", "text": "正真正銘のやつ。これはどちらかというと"}, {"type": "subtitle", "time": 12829.99, "timestamp": "03:33:49", "text": "新設機関に推奨される戦術"}, {"type": "subtitle", "time": 12832.63, "timestamp": "03:33:52", "text": "そして、あなたが"}, {"type": "subtitle", "time": 12835.99, "timestamp": "03:33:55", "text": "西側がそうするのを見ることができるのは"}, {"type": "subtitle", "time": 12839.91, "timestamp": "03:33:59", "text": "代理店のドラマやその他諸々の反動"}]
[{"type": "subtitle", "time": 5224.91, "timestamp": "01:27:04", "text": "私が普段プレイするゲームとは違っていた。そうではなかった"}, {"type": "subtitle", "time": 5229.189, "timestamp": "01:27:09", "text": "えっと、私のタイプって基本的に私は"}, {"type": "subtitle", "time": 5233.83, "timestamp": "01:27:13", "text": "主にホラーゲームをプレイします。"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "P F それは何と呼ばれていますか？えっと、まず"}, {"type": "subtitle", "time": 5241.11, "timestamp": "01:27:21", "text": "人がゲームをプレイします。私はそうします。 FPS。"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "うん、"}, {"type": "subtitle", "time": 5246.07, "timestamp": "01:27:26", "text": "FPSゲーム。うん。"}, {"type": "subtitle", "time": 5248.55, "timestamp": "01:27:28", "text": "だから私はそうするのですが"}, {"type": "subtitle", "time": 5249.39, "timestamp": "01:27:29", "text": "その"}, {"type": "subtitle", "time": 5253.35, "timestamp": "01:27:33", "text": "わかった。うん、楽しいよ。そういう類のもの"}, {"type": "subtitle", "time": 5259.03, "timestamp": "01:27:39", "text": "ゲーム。ええ、ゲームはしますよ。だから、それは私"}, {"type": "subtitle", "time": 5262.55, "timestamp": "01:27:42", "text": "リトルナイトメアをやりたかったんだけど、"}, {"type": "subtitle", "time": 5265.35, "timestamp": "01:27:45", "text": "それから兄は私を甘やかそうと決めた"}, {"type": "subtitle", "time": 5268.55, "timestamp": "01:27:48", "text": "エンディング。だから、今はもうそのゲームはやらない。"}, {"type": "subtitle", "time": 5270.55, "timestamp": "01:27:50", "text": "なんてこった。"}, {"type": "subtitle", "time": 5272.79, "timestamp": "01:27:52", "text": "ええ、絶対にプレイするつもりでした"}, {"type": "subtitle", "time": 5274.95, "timestamp": "01:27:54", "text": "あのゲーム、すごかったよ。"}]
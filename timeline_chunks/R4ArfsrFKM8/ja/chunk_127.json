[{"type": "subtitle", "time": 7620.55, "timestamp": "02:07:00", "text": "まで？何を料理しているのですか？"}, {"type": "subtitle", "time": 7622.47, "timestamp": "02:07:02", "text": "日？"}, {"type": "subtitle", "time": 7624.95, "timestamp": "02:07:04", "text": "最近は料理ばかりしています。えっと、私は"}, {"type": "subtitle", "time": 7627.669, "timestamp": "02:07:07", "text": "モデル関係の仕事はジョアソンに任せる。私は持っている"}, {"type": "subtitle", "time": 7631.03, "timestamp": "02:07:11", "text": "新型モデルを開発中。"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "まあ、本当に？かっこいい。ええ、私は"}, {"type": "subtitle", "time": 7637.75, "timestamp": "02:07:17", "text": "新型モデルを開発中。だから、えっと"}, {"type": "subtitle", "time": 7640.47, "timestamp": "02:07:20", "text": "それには資金を調達する必要がある"}, {"type": "subtitle", "time": 7643.109, "timestamp": "02:07:23", "text": "来月日本に行くので"}, {"type": "subtitle", "time": 7646.069, "timestamp": "02:07:26", "text": "言語学。ええと、私も行きます"}, {"type": "subtitle", "time": 7648.79, "timestamp": "02:07:28", "text": "21ヶ月、1年、そして"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "数ヶ月。ああ、いいと思ったんだけど。"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "えっと、金額が少し多すぎるので"}, {"type": "subtitle", "time": 7658.709, "timestamp": "02:07:38", "text": "2000ドルって今は超大金だよね"}, {"type": "subtitle", "time": 7662.069, "timestamp": "02:07:42", "text": "それはかなりの量ですね。うん。あなたは滞在します"}, {"type": "subtitle", "time": 7664.95, "timestamp": "02:07:44", "text": "そこに21ヶ月間いて、それから"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "戻ってくる。そういうことなの？えっと、私は"}, {"type": "subtitle", "time": 7669.629, "timestamp": "02:07:49", "text": "のように"}, {"type": "subtitle", "time": 7672.79, "timestamp": "02:07:52", "text": "えっと、実は戻りたくないんです。"}, {"type": "subtitle", "time": 7675.43, "timestamp": "02:07:55", "text": "ああ、私もそこに行きたい。その後"}, {"type": "subtitle", "time": 7677.149, "timestamp": "02:07:57", "text": "語学コース 私はただ"}]
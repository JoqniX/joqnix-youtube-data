[{"type": "subtitle", "time": 12123.03, "timestamp": "03:22:03", "text": "えっと、もし私がそうであるべきなら、なぜそうではないのか、どこに"}, {"type": "subtitle", "time": 12127.19, "timestamp": "03:22:07", "text": "3D版のことですか？こんにちは、3Dの1つ"}, {"type": "subtitle", "time": 12130.83, "timestamp": "03:22:10", "text": "1つ。虚栄心のある3D"}, {"type": "subtitle", "time": 12135.429, "timestamp": "03:22:15", "text": "1つ。 3D版はどこにあるの？ああ、ジェニサ。"}, {"type": "subtitle", "time": 12139.469, "timestamp": "03:22:19", "text": "ああ、これがハッシュタグだ。ごめん"}, {"type": "subtitle", "time": 12153.95, "timestamp": "03:22:33", "text": "最も簡単なものは何ですか"}, {"type": "subtitle", "time": 12155.79, "timestamp": "03:22:35", "text": "反応性"}, {"type": "subtitle", "time": 12158.19, "timestamp": "03:22:38", "text": "簡単"}, {"type": "subtitle", "time": 12166.71, "timestamp": "03:22:46", "text": "忍者？あなたは私にあなたの"}, {"type": "subtitle", "time": 12170.389, "timestamp": "03:22:50", "text": "えーと、カム、OB、バーチャルカメラとか。私"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "仮想カメラをあなたに渡さなければならない"}, {"type": "subtitle", "time": 12176.389, "timestamp": "03:22:56", "text": "もの。私たちは皆お互いの"}, {"type": "subtitle", "time": 12179.59, "timestamp": "03:22:59", "text": "クロマキーのようなモデル"}]
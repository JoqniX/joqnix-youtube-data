[{"type": "subtitle", "time": 6240.75, "timestamp": "01:44:00", "text": "インスタグラム、そして"}, {"type": "subtitle", "time": 6244.27, "timestamp": "01:44:04", "text": "ツイッター。はい、どうぞご自由にフォローしてください。"}, {"type": "subtitle", "time": 6247.51, "timestamp": "01:44:07", "text": "ナカは一緒にいると本当に楽しい人だよ"}, {"type": "subtitle", "time": 6250.59, "timestamp": "01:44:10", "text": "一緒に出かけて話をして、"}, {"type": "subtitle", "time": 6257.91, "timestamp": "01:44:17", "text": "頭が良くて賢くて本当に"}, {"type": "subtitle", "time": 6260.91, "timestamp": "01:44:20", "text": "本当に才能豊かで、技術も高い。"}, {"type": "subtitle", "time": 6264.07, "timestamp": "01:44:24", "text": "うん。ダニー、今日は楽しかったよ。私は"}, {"type": "subtitle", "time": 6265.07, "timestamp": "01:44:25", "text": "良い"}, {"type": "subtitle", "time": 6273.07, "timestamp": "01:44:33", "text": "楽しい。こんにちは。"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "えっと、おしっこに行くべきか、それとも行かないべきか？"}, {"type": "subtitle", "time": 6280.47, "timestamp": "01:44:40", "text": "1秒。よし、始めよう"}, {"type": "subtitle", "time": 6291.43, "timestamp": "01:44:51", "text": "えっと、次はコードレッドコードです"}, {"type": "subtitle", "time": 6296.83, "timestamp": "01:44:56", "text": "コードは赤色ではありません。うん。えっと、今夜は"}]
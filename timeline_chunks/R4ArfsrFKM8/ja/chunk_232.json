[{"type": "subtitle", "time": 13922.309, "timestamp": "03:52:02", "text": "また、代理店によって異なりますが、"}, {"type": "subtitle", "time": 13926.229, "timestamp": "03:52:06", "text": "彼らは自分たちのルールを守る者に対して厳格だ"}, {"type": "subtitle", "time": 13929.189, "timestamp": "03:52:09", "text": "彼らの慣習、彼らのモットー、そして"}, {"type": "subtitle", "time": 13931.75, "timestamp": "03:52:11", "text": "彼らが確実にするすべて"}, {"type": "subtitle", "time": 13937.63, "timestamp": "03:52:17", "text": "問題を起こす者は、矯正される必要がある"}, {"type": "subtitle", "time": 13940.229, "timestamp": "03:52:20", "text": "うん"}, {"type": "subtitle", "time": 13942.11, "timestamp": "03:52:22", "text": "ああ、それら全部"}, {"type": "subtitle", "time": 13945.11, "timestamp": "03:52:25", "text": "いろいろあるけど、またこう考えてみよう"}, {"type": "subtitle", "time": 13947.349, "timestamp": "03:52:27", "text": "繰り返しますが、常に企業に参加して"}, {"type": "subtitle", "time": 13951.349, "timestamp": "03:52:31", "text": "あなたが望んでいた露出と、"}, {"type": "subtitle", "time": 13953.99, "timestamp": "03:52:33", "text": "そして、もし彼らが許可したり何かがあったりしたら、あるいはあなたが"}, {"type": "subtitle", "time": 13957.269, "timestamp": "03:52:37", "text": "左左、もしあなたの聴衆がまだ"}, {"type": "subtitle", "time": 13959.91, "timestamp": "03:52:39", "text": "自分のインディーズIPを見つけて理解し、"}, {"type": "subtitle", "time": 13961.83, "timestamp": "03:52:41", "text": "それはあなたにとって良いことですよね、あなたは見てきました"}, {"type": "subtitle", "time": 13963.67, "timestamp": "03:52:43", "text": "キーボードでそれを行う。私たちは、"}, {"type": "subtitle", "time": 13968.55, "timestamp": "03:52:48", "text": "サバサバことグラグラの新作と"}, {"type": "subtitle", "time": 13971.99, "timestamp": "03:52:51", "text": "インディーズ系のIPですよね？その他のもの。たくさんの"}, {"type": "subtitle", "time": 13974.71, "timestamp": "03:52:54", "text": "物事、ですよね？たくさんの例が出回っている"}, {"type": "subtitle", "time": 13977.91, "timestamp": "03:52:57", "text": "XC コーポのユーチューバーがすでにどのように"}]
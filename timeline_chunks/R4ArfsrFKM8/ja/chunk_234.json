[{"type": "subtitle", "time": 14041.83, "timestamp": "03:54:01", "text": "自分の名前を世に知らしめるため、ですよね？"}, {"type": "subtitle", "time": 14044.75, "timestamp": "03:54:04", "text": "そういう仕組み"}, {"type": "chat", "time": 14045.016, "timestamp": "03:54:05", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hahah"}, {"type": "subtitle", "time": 14048.63, "timestamp": "03:54:08", "text": "結局簡単じゃないから"}, {"type": "subtitle", "time": 14051.83, "timestamp": "03:54:11", "text": "あなたが参加するかどうか"}, {"type": "subtitle", "time": 14054.389, "timestamp": "03:54:14", "text": "既に設立されている機関"}, {"type": "subtitle", "time": 14057.83, "timestamp": "03:54:17", "text": "そして、こうは言えないようなこと"}, {"type": "subtitle", "time": 14059.75, "timestamp": "03:54:19", "text": "代理店として参加する予定です"}, {"type": "subtitle", "time": 14061.59, "timestamp": "03:54:21", "text": "もっと多くの聴衆を獲得するために、私は"}, {"type": "subtitle", "time": 14065.03, "timestamp": "03:54:25", "text": "何百万もの人がたくさんの速いチャットを持っています"}, {"type": "subtitle", "time": 14067.59, "timestamp": "03:54:27", "text": "寄付をする人など、いいえそれは"}, {"type": "subtitle", "time": 14070.07, "timestamp": "03:54:30", "text": "そうはならないよ、君は"}, {"type": "subtitle", "time": 14072.59, "timestamp": "03:54:32", "text": "非常に多くの巨大な量に直面している"}, {"type": "subtitle", "time": 14075.429, "timestamp": "03:54:35", "text": "プレッシャー。経営陣からの圧力、"}, {"type": "subtitle", "time": 14077.99, "timestamp": "03:54:37", "text": "オンラインであることによるプレッシャー、プレッシャー"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "君の仲間から。えーとピアピア"}, {"type": "subtitle", "time": 14085.429, "timestamp": "03:54:45", "text": "うん。同調圧力とかそういう類のもの。むしろ"}, {"type": "subtitle", "time": 14088.15, "timestamp": "03:54:48", "text": "彼らはあなたに同調圧力をかけているのです。"}, {"type": "subtitle", "time": 14090.95, "timestamp": "03:54:50", "text": "むしろ、あなたは"}, {"type": "subtitle", "time": 14094.87, "timestamp": "03:54:54", "text": "あなたの心は、私が良くないと思っている。私はできません"}, {"type": "subtitle", "time": 14097.269, "timestamp": "03:54:57", "text": "同世代の仲間に追いついたり、"}]
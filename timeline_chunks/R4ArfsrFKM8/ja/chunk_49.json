[{"type": "subtitle", "time": 2942.069, "timestamp": "00:49:02", "text": "私のような何かのニュース"}, {"type": "subtitle", "time": 2944.95, "timestamp": "00:49:04", "text": "プロジェクトや、試験が近づいているような"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "来週とかそういうこと。つまり、"}, {"type": "subtitle", "time": 2952.47, "timestamp": "00:49:12", "text": "スケジュールが本当に詰まっていて、"}, {"type": "subtitle", "time": 2955.43, "timestamp": "00:49:15", "text": "自分の社会生活を管理する方法を知っている"}, {"type": "subtitle", "time": 2957.19, "timestamp": "00:49:17", "text": "人生や個人的なことをストリーミングしながら"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "人生。だから、その点で苦労しているんです。"}, {"type": "subtitle", "time": 2962.309, "timestamp": "00:49:22", "text": "でも、よし、始めよう"}, {"type": "subtitle", "time": 2965.03, "timestamp": "00:49:25", "text": "現在配信中。私はただここに座っているわけにはいかない"}, {"type": "subtitle", "time": 2968.27, "timestamp": "00:49:28", "text": "そして、私の"}, {"type": "subtitle", "time": 2972.71, "timestamp": "00:49:32", "text": "私がいなくてもそこにいられるようにチャットチャット。"}, {"type": "subtitle", "time": 2975.67, "timestamp": "00:49:35", "text": "というわけで、配信を始めます。それは"}, {"type": "subtitle", "time": 2977.43, "timestamp": "00:49:37", "text": "ニース。"}, {"type": "subtitle", "time": 2979.19, "timestamp": "00:49:39", "text": "待って、ヒマーチャル・プラデーシュ州はどうだった？"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "あれ？ヒマーチャル・プラデーシュ州に登りましたか？"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "とかそういうの？待って、あれは山？"}, {"type": "subtitle", "time": 2985.99, "timestamp": "00:49:45", "text": "ええ、そうです。そうです。そうです。まるで"}, {"type": "subtitle", "time": 2989.19, "timestamp": "00:49:49", "text": "雪山とかそういうもの。それは"}, {"type": "subtitle", "time": 2991.67, "timestamp": "00:49:51", "text": "私の人生で最高の旅になる"}, {"type": "subtitle", "time": 2993.43, "timestamp": "00:49:53", "text": "正直。ベイビー、君は雪に触れたね。それ"}, {"type": "subtitle", "time": 2997.03, "timestamp": "00:49:57", "text": "「なんてこった」という意味です。初めて"}, {"type": "subtitle", "time": 2999.99, "timestamp": "00:49:59", "text": "雪が降っていて、本当に魔法みたいだったよ。私"}]
[{"type": "subtitle", "time": 3482.99, "timestamp": "00:58:02", "text": "そして、おそらくもっと多くのVlogを投稿し、"}, {"type": "subtitle", "time": 3485.99, "timestamp": "00:58:05", "text": "もの。そう、でもそれが私の未来なんだ"}, {"type": "subtitle", "time": 3489.03, "timestamp": "00:58:09", "text": "プラン。今のところ、私はまだ感じていません"}, {"type": "subtitle", "time": 3491.75, "timestamp": "00:58:11", "text": "自分にはかなり自信がある。だから私は"}, {"type": "subtitle", "time": 3494.47, "timestamp": "00:58:14", "text": "Vチューブとかやってるよ。それは"}, {"type": "subtitle", "time": 3497.99, "timestamp": "00:58:17", "text": "私がチューブを始めた理由の全てです。"}, {"type": "subtitle", "time": 3501.67, "timestamp": "00:58:21", "text": "うん。うん。最近のユーチューバーは"}, {"type": "subtitle", "time": 3504.309, "timestamp": "00:58:24", "text": "イアンのようなユーチューバーは、"}, {"type": "chat", "time": 3504.77, "timestamp": "00:58:24", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Here*"}, {"type": "subtitle", "time": 3506.23, "timestamp": "00:58:26", "text": "右のベールとその他を見た"}, {"type": "subtitle", "time": 3509.67, "timestamp": "00:58:29", "text": "彼らは現実世界でコンテンツを作っている"}, {"type": "subtitle", "time": 3514.99, "timestamp": "00:58:34", "text": "[音楽]"}, {"type": "subtitle", "time": 3523.27, "timestamp": "00:58:43", "text": "アストラはどうですか？"}, {"type": "subtitle", "time": 3528.789, "timestamp": "00:58:48", "text": "どうしたんだ、兄弟。すごく忙しかったよ、ああ、なんてことだ"}, {"type": "subtitle", "time": 3529.71, "timestamp": "00:58:49", "text": "ない"}, {"type": "subtitle", "time": 3533.829, "timestamp": "00:58:53", "text": "うん。自分の友達。何てことだ。うん。"}, {"type": "subtitle", "time": 3535.349, "timestamp": "00:58:55", "text": "待って。あなたは"}, {"type": "subtitle", "time": 3537.829, "timestamp": "00:58:57", "text": "昨日彼とコラボしたの？あなたはそうしましたか？"}]
[{"type": "subtitle", "time": 1263.59, "timestamp": "00:21:03", "text": "ここでこれをして、これをして、あれをする"}, {"type": "subtitle", "time": 1268.31, "timestamp": "00:21:08", "text": "ぜひここにも行ってみてください。ああ、なんて間抜けなんだろう"}, {"type": "subtitle", "time": 1270.669, "timestamp": "00:21:10", "text": "時々。あなた"}, {"type": "subtitle", "time": 1274.83, "timestamp": "00:21:14", "text": "わかってる、私はもう一方の"}, {"type": "subtitle", "time": 1276.75, "timestamp": "00:21:16", "text": "側。"}, {"type": "subtitle", "time": 1283.39, "timestamp": "00:21:23", "text": "ああ神様、ジョーが"}, {"type": "subtitle", "time": 1285.95, "timestamp": "00:21:25", "text": "進捗。ああ、私は"}, {"type": "subtitle", "time": 1288.71, "timestamp": "00:21:28", "text": "午前。明日の朝は配信しなければならない。おお、"}, {"type": "subtitle", "time": 1291.19, "timestamp": "00:21:31", "text": "楽しい時間でした。ニース。ニース。 S. 何時に"}, {"type": "subtitle", "time": 1293.87, "timestamp": "00:21:33", "text": "ストリーミング配信してるの？"}, {"type": "subtitle", "time": 1295.789, "timestamp": "00:21:35", "text": "[音楽]"}, {"type": "subtitle", "time": 1297.789, "timestamp": "00:21:37", "text": "ヘリックス。"}, {"type": "subtitle", "time": 1300.75, "timestamp": "00:21:40", "text": "うん。"}, {"type": "subtitle", "time": 1305.63, "timestamp": "00:21:45", "text": "ああ、そうだよ。私はミスターが恋しいです。"}, {"type": "subtitle", "time": 1308.029, "timestamp": "00:21:48", "text": "えっと、"}, {"type": "subtitle", "time": 1312.27, "timestamp": "00:21:52", "text": "ワタンダの日々"}, {"type": "subtitle", "time": 1314.87, "timestamp": "00:21:54", "text": "アレクサ。しばらく教会に行ってない"}, {"type": "subtitle", "time": 1317.31, "timestamp": "00:21:57", "text": "飛行機や"}]
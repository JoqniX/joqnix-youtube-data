[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "そしてゲームをする。"}, {"type": "subtitle", "time": 5762.149, "timestamp": "01:36:02", "text": "はい。"}, {"type": "subtitle", "time": 5764.229, "timestamp": "01:36:04", "text": "えっと、PS4のストリームはやらないの？"}, {"type": "subtitle", "time": 5767.91, "timestamp": "01:36:07", "text": "えっと、まだやってないけど、考えてるんだ"}, {"type": "subtitle", "time": 5770.79, "timestamp": "01:36:10", "text": "将来的にはPS4でのストリーミング配信も行う予定です。"}, {"type": "subtitle", "time": 5773.189, "timestamp": "01:36:13", "text": "うん、楽しそうだね。私はあなたが"}, {"type": "subtitle", "time": 5775.669, "timestamp": "01:36:15", "text": "直接そこへ行くか、"}, {"type": "subtitle", "time": 5778.07, "timestamp": "01:36:18", "text": "捕獲。えっと、私は"}, {"type": "subtitle", "time": 5781.43, "timestamp": "01:36:21", "text": "OBSを"}, {"type": "subtitle", "time": 5784.55, "timestamp": "01:36:24", "text": "PS4向けに放送していて、"}, {"type": "subtitle", "time": 5788.07, "timestamp": "01:36:28", "text": "そのように機能しますが、私は"}, {"type": "subtitle", "time": 5791.35, "timestamp": "01:36:31", "text": "YouTube動画か何かでそれを繋げる"}, {"type": "subtitle", "time": 5793.189, "timestamp": "01:36:33", "text": "だって、私はただストリーミングできるから"}, {"type": "subtitle", "time": 5796.229, "timestamp": "01:36:36", "text": "ノートパソコンのモデルなど、すべてについて。"}, {"type": "subtitle", "time": 5799.59, "timestamp": "01:36:39", "text": "だから、それをあなたに放送する必要がある"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "YouTube。だから、私は"}, {"type": "subtitle", "time": 5804.669, "timestamp": "01:36:44", "text": "YouTubeチャンネルか何かに接続してください。"}, {"type": "subtitle", "time": 5808.07, "timestamp": "01:36:48", "text": "うん。どうなるか見てみよう。"}, {"type": "subtitle", "time": 5810.07, "timestamp": "01:36:50", "text": "おそらく、"}, {"type": "subtitle", "time": 5813.109, "timestamp": "01:36:53", "text": "ハードキャプチャのような機器"}, {"type": "subtitle", "time": 5815.59, "timestamp": "01:36:55", "text": "そういうカード、手に入れなきゃいけなかったんだ。"}]
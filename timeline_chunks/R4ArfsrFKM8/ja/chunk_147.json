[{"type": "subtitle", "time": 8821.91, "timestamp": "02:27:01", "text": "Discordサーバー？ええ、そうですね。うん。うん。"}, {"type": "subtitle", "time": 8824.469, "timestamp": "02:27:04", "text": "それも活発に行われています。うん。うん。それで、"}, {"type": "subtitle", "time": 8828.15, "timestamp": "02:27:08", "text": "私は、カマはあなたではないかもしれないと思った"}, {"type": "subtitle", "time": 8830.95, "timestamp": "02:27:10", "text": "Discordで活発に活動していることを知っています。もしかしたら彼は"}, {"type": "subtitle", "time": 8833.23, "timestamp": "02:27:13", "text": "人生に焦点を当てて、"}, {"type": "subtitle", "time": 8837.469, "timestamp": "02:27:17", "text": "知る。私は気づいた"}, {"type": "subtitle", "time": 8840.23, "timestamp": "02:27:20", "text": "ええ、この件に関しては落ち込んでいました。のように"}, {"type": "subtitle", "time": 8841.19, "timestamp": "02:27:21", "text": "この電話はあなたができないことです"}, {"type": "subtitle", "time": 8847.87, "timestamp": "02:27:27", "text": "それは"}, {"type": "subtitle", "time": 8852.63, "timestamp": "02:27:32", "text": "ニース。だから私はVRストリームを覚えている"}, {"type": "subtitle", "time": 8856.07, "timestamp": "02:27:36", "text": "それはVRの何かだった、"}, {"type": "subtitle", "time": 8859.11, "timestamp": "02:27:39", "text": "Vaの配信は、うーん、かなり素晴らしかった"}, {"type": "subtitle", "time": 8861.27, "timestamp": "02:27:41", "text": "そして私はたくさんの人に会うことができました"}, {"type": "subtitle", "time": 8864.87, "timestamp": "02:27:44", "text": "アリがそこにいたかのように、その流れを通して"}, {"type": "subtitle", "time": 8867.349, "timestamp": "02:27:47", "text": "えっと、他にも何人か思い浮かぶ人がいる"}, {"type": "subtitle", "time": 8869.51, "timestamp": "02:27:49", "text": "そして私は出会い、私たちは一緒に過ごしました"}, {"type": "subtitle", "time": 8872.79, "timestamp": "02:27:52", "text": "私たちが6時間、7時間、8時間も費やした"}, {"type": "subtitle", "time": 8875.83, "timestamp": "02:27:55", "text": "VRチャットは世界から世界へと移動し、"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "それから私たちはラウンジにいました"}]
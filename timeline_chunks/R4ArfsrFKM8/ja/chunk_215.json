[{"type": "subtitle", "time": 12900.55, "timestamp": "03:35:00", "text": "覚えておいてください、それはまた"}, {"type": "subtitle", "time": 12903.03, "timestamp": "03:35:03", "text": "代理店。だから最小限になるだろう"}, {"type": "subtitle", "time": 12905.51, "timestamp": "03:35:05", "text": "それらの内容は、また彼らに与えられるからです"}, {"type": "subtitle", "time": 12908.309, "timestamp": "03:35:08", "text": "人材マネージャーと管理職"}, {"type": "subtitle", "time": 12910.309, "timestamp": "03:35:10", "text": "そこに行きます。あなたはまだ行かなければならない"}, {"type": "subtitle", "time": 12912.87, "timestamp": "03:35:12", "text": "経営陣を通じて"}, {"type": "subtitle", "time": 12916.389, "timestamp": "03:35:16", "text": "えーと、たとえ彼らがそうしなくても、"}, {"type": "subtitle", "time": 12919.03, "timestamp": "03:35:19", "text": "あなたの創作活動に影響を与えないでください。"}, {"type": "subtitle", "time": 12921.11, "timestamp": "03:35:21", "text": "経営陣に相談する必要があります"}, {"type": "subtitle", "time": 12924.229, "timestamp": "03:35:24", "text": "あなたの持ち物は、"}, {"type": "subtitle", "time": 12927.269, "timestamp": "03:35:27", "text": "代理店。そうですね、彼女も言及しています"}, {"type": "subtitle", "time": 12929.67, "timestamp": "03:35:29", "text": "彼女は経営陣の支援を受けている。すばらしい"}, {"type": "subtitle", "time": 12932.469, "timestamp": "03:35:32", "text": "経営陣のサポート。それは良い。"}, {"type": "subtitle", "time": 12936.389, "timestamp": "03:35:36", "text": "大きな大きな落とし穴の危険信号のようなもの"}, {"type": "subtitle", "time": 12939.83, "timestamp": "03:35:39", "text": "ほとんどのスタートアップエージェンシーが"}, {"type": "subtitle", "time": 12942.15, "timestamp": "03:35:42", "text": "経営陣がいない。もしあなたが"}, {"type": "subtitle", "time": 12946.389, "timestamp": "03:35:46", "text": "西洋などから才能ある人材を配置する"}, {"type": "subtitle", "time": 12949.51, "timestamp": "03:35:49", "text": "イギリスの才能や例えばJPのような"}, {"type": "subtitle", "time": 12951.91, "timestamp": "03:35:51", "text": "才能か何かあなたが必要とするもの"}, {"type": "subtitle", "time": 12955.19, "timestamp": "03:35:55", "text": "代理店オーナーとして採用を希望する"}, {"type": "subtitle", "time": 12958.87, "timestamp": "03:35:58", "text": "日本語担当マネージャーと英語担当マネージャー。 JP"}]
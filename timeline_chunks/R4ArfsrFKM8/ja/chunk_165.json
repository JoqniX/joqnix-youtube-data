[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "チュートリアルビデオをご覧ください。だから、混ぜてみよう"}, {"type": "subtitle", "time": 9904.309, "timestamp": "02:45:04", "text": "それは良い考えではないでしょう。それで"}, {"type": "subtitle", "time": 9906.87, "timestamp": "02:45:06", "text": "例えば、チュートリアルビデオを"}, {"type": "subtitle", "time": 9909.67, "timestamp": "02:45:09", "text": "ストリーミングチャンネルで、彼らは"}, {"type": "subtitle", "time": 9911.03, "timestamp": "02:45:11", "text": "すると彼らは"}, {"type": "subtitle", "time": 9912.55, "timestamp": "02:45:12", "text": "チュートリアルの代わりにストリーミング配信"}, {"type": "subtitle", "time": 9914.55, "timestamp": "02:45:14", "text": "そういうものには興味を失ってしまうだろう"}, {"type": "subtitle", "time": 9917.349, "timestamp": "02:45:17", "text": "そしてその時点で立ち去る。右？だから私は"}, {"type": "subtitle", "time": 9919.75, "timestamp": "02:45:19", "text": "全部分けておきたかっただけなので"}, {"type": "subtitle", "time": 9922.55, "timestamp": "02:45:22", "text": "彼らは、わかったとわかるようになるでしょう"}, {"type": "subtitle", "time": 9924.95, "timestamp": "02:45:24", "text": "このチャンネルを購読すると、"}, {"type": "subtitle", "time": 9927.19, "timestamp": "02:45:27", "text": "この件に関する情報を入手してください。だからもし私が"}, {"type": "subtitle", "time": 9929.67, "timestamp": "02:45:29", "text": "チュートリアルチャンネルを購読します"}, {"type": "subtitle", "time": 9931.59, "timestamp": "02:45:31", "text": "チュートリアル関連のものだけを入手してください。購読時に"}, {"type": "subtitle", "time": 9933.63, "timestamp": "02:45:33", "text": "えーと、バトルフィールド バトルフィールド クリップ"}, {"type": "subtitle", "time": 9935.83, "timestamp": "02:45:35", "text": "チャネル。バトルフィールドクリップしか入手できません"}, {"type": "subtitle", "time": 9946.389, "timestamp": "02:45:46", "text": "ニース。まだ考えているところです"}, {"type": "subtitle", "time": 9947.19, "timestamp": "02:45:47", "text": "のように"}, {"type": "subtitle", "time": 9950.19, "timestamp": "02:45:50", "text": "[音楽]"}, {"type": "subtitle", "time": 9955.59, "timestamp": "02:45:55", "text": "わあ、それはすごくかっこいいですね。えっと、私も"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "本当は分けておきたかったのですが、"}]
[{"type": "subtitle", "time": 14402.87, "timestamp": "04:00:02", "text": "あなた自身がプロトコルに従っていないため、"}, {"type": "subtitle", "time": 14405.87, "timestamp": "04:00:05", "text": "適切な形式が正しいです"}, {"type": "subtitle", "time": 14411.03, "timestamp": "04:00:11", "text": "悪い。うん。悪いのは、また何なのか"}, {"type": "subtitle", "time": 14413.99, "timestamp": "04:00:13", "text": "例えば良い例としては、"}, {"type": "subtitle", "time": 14416.67, "timestamp": "04:00:16", "text": "私、私自身"}, {"type": "subtitle", "time": 14419.349, "timestamp": "04:00:19", "text": "ライブ配信のユーチューバーや企業を視聴する"}, {"type": "subtitle", "time": 14422.55, "timestamp": "04:00:22", "text": "複数のエージェンシーのユーチューバーが視聴する"}, {"type": "subtitle", "time": 14425.269, "timestamp": "04:00:25", "text": "彼らのストリームを理解し、"}, {"type": "subtitle", "time": 14429.11, "timestamp": "04:00:29", "text": "ストリームでの彼らの行動などに反応するなど"}, {"type": "subtitle", "time": 14431.59, "timestamp": "04:00:31", "text": "すべてが彼らのやり方と同じように"}, {"type": "subtitle", "time": 14434.389, "timestamp": "04:00:34", "text": "そして、より批判的な分析"}, {"type": "subtitle", "time": 14437.03, "timestamp": "04:00:37", "text": "彼らが物事をどうやるか、あなたはこう思う"}, {"type": "subtitle", "time": 14439.99, "timestamp": "04:00:39", "text": "むしろ偶像化して、また維持する"}, {"type": "subtitle", "time": 14442.87, "timestamp": "04:00:42", "text": "彼らをロールモデルとして見ているんですよね？だからもしあなたが"}, {"type": "subtitle", "time": 14445.99, "timestamp": "04:00:45", "text": "あなた自身が正しいことをしていない"}, {"type": "subtitle", "time": 14448.389, "timestamp": "04:00:48", "text": "そして、もし他の誰かが"}, {"type": "subtitle", "time": 14451.51, "timestamp": "04:00:51", "text": "こういうことに従うんだよね？それはまずい"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "あまりにも。そう考える必要がある"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "そうですよね？翌日"}]
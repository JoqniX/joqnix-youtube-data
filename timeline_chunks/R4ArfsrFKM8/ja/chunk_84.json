[{"type": "subtitle", "time": 5042.149, "timestamp": "01:24:02", "text": "は。ああ、6月8日か。ああ、そうだったよ。何てことだ。"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "親友の日。親友の日。何てことだ。すべての"}, {"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "世界中のBFF、おめでとう"}, {"type": "subtitle", "time": 5051.669, "timestamp": "01:24:11", "text": "友人の日。何てことだ。私は"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "彼氏の日と言うために。何てことだ。何"}, {"type": "subtitle", "time": 5059.35, "timestamp": "01:24:19", "text": "一体俺は何をしているんだ？親友の日。"}, {"type": "subtitle", "time": 5067.03, "timestamp": "01:24:27", "text": "金曜日ってあるの？何てことだ。彼氏"}, {"type": "subtitle", "time": 5068.87, "timestamp": "01:24:28", "text": "日、ガールフレンドの日。私は思う 私は思う"}, {"type": "subtitle", "time": 5070.79, "timestamp": "01:24:30", "text": "がある。そうだと思います。がある。"}, {"type": "subtitle", "time": 5073.75, "timestamp": "01:24:33", "text": "ええ、ありますよ。いつですか？ 10月3日。"}, {"type": "subtitle", "time": 5076.87, "timestamp": "01:24:36", "text": "彼氏の日。ああ、それはまるで"}, {"type": "subtitle", "time": 5080.669, "timestamp": "01:24:40", "text": "行き過ぎだ。 8月1日。彼女"}, {"type": "subtitle", "time": 5087.35, "timestamp": "01:24:47", "text": "ジョー、誕生日はいつ？私のは"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "8月11日。次。次。私の鉱山も"}, {"type": "subtitle", "time": 5095.669, "timestamp": "01:24:55", "text": "8月に。ああ、8月だよ、みんな。さあ行こう。"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "うん。"}]
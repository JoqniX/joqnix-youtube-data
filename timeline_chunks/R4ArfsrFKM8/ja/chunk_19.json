[{"type": "subtitle", "time": 1142.35, "timestamp": "00:19:02", "text": "そして"}, {"type": "subtitle", "time": 1150.549, "timestamp": "00:19:10", "text": "行く。何かを作りたいのですが"}, {"type": "subtitle", "time": 1153.63, "timestamp": "00:19:13", "text": "チャットコマンドでヘッドパッドを操作できます"}, {"type": "subtitle", "time": 1159.75, "timestamp": "00:19:19", "text": "ユーザー名。待って、変更できない"}, {"type": "subtitle", "time": 1162.15, "timestamp": "00:19:22", "text": "離陸後の方向。いいえ。"}, {"type": "subtitle", "time": 1163.71, "timestamp": "00:19:23", "text": "できない"}, {"type": "subtitle", "time": 1167.51, "timestamp": "00:19:27", "text": "残念ながら。許可してくれない。まさにその通り"}, {"type": "subtitle", "time": 1169.87, "timestamp": "00:19:29", "text": "計算する"}, {"type": "subtitle", "time": 1173.11, "timestamp": "00:19:33", "text": "それ。そして、どれくらい長く押し続けるかが重要です"}, {"type": "subtitle", "time": 1174.669, "timestamp": "00:19:34", "text": "スペース"}, {"type": "subtitle", "time": 1178.43, "timestamp": "00:19:38", "text": "バー、短跳び、または長跳び"}, {"type": "subtitle", "time": 1182.789, "timestamp": "00:19:42", "text": "ジャンプ。そういうことですね。これはまるで私が"}, {"type": "subtitle", "time": 1185.59, "timestamp": "00:19:45", "text": "素早くスピードをタップしてスペースを押すと、"}, {"type": "subtitle", "time": 1188.31, "timestamp": "00:19:48", "text": "これ。 1秒間保持してこれをすると"}, {"type": "subtitle", "time": 1192.35, "timestamp": "00:19:52", "text": "long 2 は次のようになります。あなた"}, {"type": "subtitle", "time": 1196.95, "timestamp": "00:19:56", "text": "ほら、そういう風にタイミングを計らないといけないんだよ。頭"}, {"type": "subtitle", "time": 1199.669, "timestamp": "00:19:59", "text": "そんな感じ。ええ、私は作りたいんです"}]
[{"type": "subtitle", "time": 2523.99, "timestamp": "00:42:03", "text": "我完全被美人鱼这个主题吸引了。它就像"}, {"type": "subtitle", "time": 2527.109, "timestamp": "00:42:07", "text": "只是一个可爱的宠物名字，但它有……"}, {"type": "subtitle", "time": 2529.51, "timestamp": "00:42:09", "text": "我的个性。"}, {"type": "subtitle", "time": 2533.19, "timestamp": "00:42:13", "text": "所以这头发可能有点像……"}, {"type": "subtitle", "time": 2534.71, "timestamp": "00:42:14", "text": "给美人鱼之类的，因为它是"}, {"type": "subtitle", "time": 2538.23, "timestamp": "00:42:18", "text": "五彩缤纷。不。所以也许是头发，但"}, {"type": "subtitle", "time": 2542.47, "timestamp": "00:42:22", "text": "我的穿衣风格就代表了我。"}, {"type": "subtitle", "time": 2544.47, "timestamp": "00:42:24", "text": "所以这就像是美人鱼的结合体"}, {"type": "subtitle", "time": 2548.45, "timestamp": "00:42:28", "text": "还有我。这就是角色设计。"}, {"type": "subtitle", "time": 2550.39, "timestamp": "00:42:30", "text": "[音乐]"}, {"type": "subtitle", "time": 2553.67, "timestamp": "00:42:33", "text": "我注意到有人叫我“呃”。"}, {"type": "subtitle", "time": 2555.99, "timestamp": "00:42:35", "text": "仅限 Jalpuri。没人叫我贾尔普里"}, {"type": "subtitle", "time": 2558.71, "timestamp": "00:42:38", "text": "楼主。他们要么叫我JP，要么叫我Jalpuri。"}, {"type": "subtitle", "time": 2562.03, "timestamp": "00:42:42", "text": "所以我就说，保重。 Jelpuri 还不错。"}, {"type": "subtitle", "time": 2564.99, "timestamp": "00:42:44", "text": "是的，就是这样。"}, {"type": "subtitle", "time": 2568.63, "timestamp": "00:42:48", "text": "好的。你是否已经决定了你的社区"}, {"type": "subtitle", "time": 2571.91, "timestamp": "00:42:51", "text": "吉祥物、名字之类的东西？我"}, {"type": "subtitle", "time": 2575.19, "timestamp": "00:42:55", "text": "还没有。说实话，我还没有，但是"}, {"type": "subtitle", "time": 2577.829, "timestamp": "00:42:57", "text": "我一直太忙了，以至于我没有"}, {"type": "subtitle", "time": 2579.99, "timestamp": "00:42:59", "text": "甚至有时间专注于此"}]
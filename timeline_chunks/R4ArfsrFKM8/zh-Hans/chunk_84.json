[{"type": "subtitle", "time": 5042.149, "timestamp": "01:24:02", "text": "是。哦，6月8日。哦，确实如此。我的天啊。"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "闺蜜日。闺蜜日。我的天啊。致所有"}, {"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "全世界的好朋友们，祝你们节日快乐！"}, {"type": "subtitle", "time": 5051.669, "timestamp": "01:24:11", "text": "朋友节。我的天啊。我本该"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "祝男朋友节快乐。我的天啊。什么"}, {"type": "subtitle", "time": 5059.35, "timestamp": "01:24:19", "text": "我到底在干什么？闺蜜日。"}, {"type": "subtitle", "time": 5067.03, "timestamp": "01:24:27", "text": "有“BF日”吗？我的天啊。男朋友"}, {"type": "subtitle", "time": 5068.87, "timestamp": "01:24:28", "text": "女朋友日。我觉得我觉得"}, {"type": "subtitle", "time": 5070.79, "timestamp": "01:24:30", "text": "有。我认为有。有。"}, {"type": "subtitle", "time": 5073.75, "timestamp": "01:24:33", "text": "是的，有。是什么时候？ 10月3日。"}, {"type": "subtitle", "time": 5076.87, "timestamp": "01:24:36", "text": "男朋友日。我的天哪，那就像"}, {"type": "subtitle", "time": 5080.669, "timestamp": "01:24:40", "text": "太远了。八月一日。女朋友"}, {"type": "subtitle", "time": 5087.35, "timestamp": "01:24:47", "text": "乔，你的生日是什么时候？我的"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "8月11日。下一个。下一个。我的矿也是"}, {"type": "subtitle", "time": 5095.669, "timestamp": "01:24:55", "text": "八月份。哦，八月，伙计们。我们走吧。"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "是的。"}]
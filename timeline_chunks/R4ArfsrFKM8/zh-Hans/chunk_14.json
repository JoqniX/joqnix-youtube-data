[{"type": "subtitle", "time": 841.11, "timestamp": "00:14:01", "text": "你不生气吗？等等，这是游戏吗？"}, {"type": "subtitle", "time": 844.629, "timestamp": "00:14:04", "text": "应该是破烂的吗？我想要，我想要"}, {"type": "subtitle", "time": 848.069, "timestamp": "00:14:08", "text": "试试本尼·弗洛伊德那玩意儿。呃"}, {"type": "subtitle", "time": 851.269, "timestamp": "00:14:11", "text": "它叫什么来着？呃，就是那个"}, {"type": "subtitle", "time": 854.23, "timestamp": "00:14:14", "text": "有个秃头男"}, {"type": "subtitle", "time": 857.59, "timestamp": "00:14:17", "text": "呃，在一个锅里。我想速通"}, {"type": "subtitle", "time": 861.949, "timestamp": "00:14:21", "text": "或者类似的事情。这将是一次有趣的经历。"}, {"type": "subtitle", "time": 865.71, "timestamp": "00:14:25", "text": "游戏。我想玩"}, {"type": "subtitle", "time": 869.949, "timestamp": "00:14:29", "text": "那。我会故意带走那条蛇。"}, {"type": "subtitle", "time": 888.99, "timestamp": "00:14:48", "text": "它。让我去"}, {"type": "subtitle", "time": 891.31, "timestamp": "00:14:51", "text": "向上。那可真是一段漫长的时光。"}, {"type": "subtitle", "time": 893.55, "timestamp": "00:14:53", "text": "跳。没关系。"}, {"type": "subtitle", "time": 896.91, "timestamp": "00:14:56", "text": "美好的。那是一个短篇小说"}, {"type": "subtitle", "time": 898.949, "timestamp": "00:14:58", "text": "跳。你真的想玩吗？那"}]
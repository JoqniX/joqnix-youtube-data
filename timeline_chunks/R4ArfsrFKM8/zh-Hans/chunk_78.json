[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "街道上人山人海。"}, {"type": "subtitle", "time": 4682.709, "timestamp": "01:18:02", "text": "正在看，很喜欢这个。当我看到"}, {"type": "subtitle", "time": 4684.709, "timestamp": "01:18:04", "text": "看到那个视频，我就想，“我的天哪”，"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "那是我想做的事。我"}, {"type": "subtitle", "time": 4689.43, "timestamp": "01:18:09", "text": "真希望我在印度也能做到这一点。那"}, {"type": "subtitle", "time": 4691.27, "timestamp": "01:18:11", "text": "那太好了。”但印度人民会"}, {"type": "subtitle", "time": 4694.229, "timestamp": "01:18:14", "text": "毁坏电视机或拿走、偷走电视机"}, {"type": "subtitle", "time": 4697.35, "timestamp": "01:18:17", "text": "或者别的什么。我的天哪，我不想"}, {"type": "subtitle", "time": 4700.79, "timestamp": "01:18:20", "text": "那。所以，我想要两个增益效果"}, {"type": "subtitle", "time": 4705.43, "timestamp": "01:18:25", "text": "保镖保护滚动的"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "就是我模特所在的那个电视机。那"}, {"type": "subtitle", "time": 4710.59, "timestamp": "01:18:30", "text": "将"}, {"type": "subtitle", "time": 4712.59, "timestamp": "01:18:32", "text": "凉爽的。呃"}, {"type": "subtitle", "time": 4714.63, "timestamp": "01:18:34", "text": "[音乐]"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "你有没有想过办一场音乐会之类的活动？"}, {"type": "subtitle", "time": 4720.87, "timestamp": "01:18:40", "text": "以及你职业生涯中像我们一样的其他事情？我愿意。"}, {"type": "subtitle", "time": 4725.03, "timestamp": "01:18:45", "text": "我想，但感觉就像我会给你一些"}, {"type": "subtitle", "time": 4726.79, "timestamp": "01:18:46", "text": "人们已经做好准备，可以和他们一起完成这件事。"}, {"type": "subtitle", "time": 4729.51, "timestamp": "01:18:49", "text": "我，因为我非常紧张，所以我不"}, {"type": "subtitle", "time": 4733.99, "timestamp": "01:18:53", "text": "想独自完成。我会安排人……"}, {"type": "subtitle", "time": 4736.39, "timestamp": "01:18:56", "text": "谁将与我同行？如果你想加入"}]
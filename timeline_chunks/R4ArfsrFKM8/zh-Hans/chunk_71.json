[{"type": "subtitle", "time": 4260.79, "timestamp": "01:11:00", "text": "所以聊天室里的面包男是"}, {"type": "subtitle", "time": 4264.149, "timestamp": "01:11:04", "text": "就像面包是每个健壮的英国人一样"}, {"type": "subtitle", "time": 4267.83, "timestamp": "01:11:07", "text": "他很帅。所以我就想，哦，我是"}, {"type": "subtitle", "time": 4270.07, "timestamp": "01:11:10", "text": "也想到了《少年堡垒》的一些内容。"}, {"type": "subtitle", "time": 4272.95, "timestamp": "01:11:12", "text": "原因。"}, {"type": "subtitle", "time": 4274.27, "timestamp": "01:11:14", "text": "哦，我的"}, {"type": "subtitle", "time": 4282.149, "timestamp": "01:11:22", "text": "上帝。我甚至不知道这是哪个国家"}, {"type": "subtitle", "time": 4284.87, "timestamp": "01:11:24", "text": "这些角色出自。是的。"}, {"type": "subtitle", "time": 4288.55, "timestamp": "01:11:28", "text": "是的。但那也是一场很有趣的游戏啊。"}, {"type": "subtitle", "time": 4290.71, "timestamp": "01:11:30", "text": "是的，确实如此。这是。"}, {"type": "subtitle", "time": 4292.39, "timestamp": "01:11:32", "text": "[音乐]"}, {"type": "subtitle", "time": 4294.669, "timestamp": "01:11:34", "text": "真是太有趣了"}, {"type": "subtitle", "time": 4296.669, "timestamp": "01:11:36", "text": "游戏。"}, {"type": "subtitle", "time": 4300.229, "timestamp": "01:11:40", "text": "是的。你最喜欢的音乐类型是什么？"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "我想问是因为你好像……"}, {"type": "subtitle", "time": 4306.149, "timestamp": "01:11:46", "text": "Instagram上有歌曲之类的东西，对吧？"}, {"type": "subtitle", "time": 4309.189, "timestamp": "01:11:49", "text": "当你发布故事时。嘿，我的那里是"}, {"type": "subtitle", "time": 4312.63, "timestamp": "01:11:52", "text": "没有特定类型之类的。我就是喜欢"}, {"type": "subtitle", "time": 4315.35, "timestamp": "01:11:55", "text": "我喜欢的音乐。我真的没有"}, {"type": "subtitle", "time": 4317.51, "timestamp": "01:11:57", "text": "解释。很多人都在问"}]
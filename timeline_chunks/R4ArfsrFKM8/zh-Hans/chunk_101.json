[{"type": "subtitle", "time": 6060.629, "timestamp": "01:41:00", "text": "你和一些东西。不，你听不到你"}, {"type": "subtitle", "time": 6063.27, "timestamp": "01:41:03", "text": "很少听到别人这么说。不，我"}, {"type": "subtitle", "time": 6066.07, "timestamp": "01:41:06", "text": "还没有。不，我想……"}, {"type": "subtitle", "time": 6068.47, "timestamp": "01:41:08", "text": "我记得有个叫……的人"}, {"type": "subtitle", "time": 6073.51, "timestamp": "01:41:13", "text": "聊天的人说：“嗯，我给你打过电话。”"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "我还给 Jalpuri 打了电话什么的，然后我"}, {"type": "subtitle", "time": 6080.149, "timestamp": "01:41:20", "text": "看完你们所有人之后，我也会看的。"}, {"type": "subtitle", "time": 6082.47, "timestamp": "01:41:22", "text": "开始做YouTube之类的东西。有"}, {"type": "subtitle", "time": 6084.31, "timestamp": "01:41:24", "text": "有一个人跟我说我像"}, {"type": "subtitle", "time": 6088.39, "timestamp": "01:41:28", "text": "哇，真不错。"}, {"type": "subtitle", "time": 6090.189, "timestamp": "01:41:30", "text": "什么"}, {"type": "subtitle", "time": 6102.95, "timestamp": "01:41:42", "text": "现在每个人都好酷。"}, {"type": "subtitle", "time": 6106.39, "timestamp": "01:41:46", "text": "是啊，连你都很酷。你很酷。"}, {"type": "subtitle", "time": 6111.109, "timestamp": "01:41:51", "text": "乔。不，我只是随机出现的一个星座。"}, {"type": "subtitle", "time": 6113.51, "timestamp": "01:41:53", "text": "就是这样。我是一个随机的人"}]
[{"type": "subtitle", "time": 541.43, "timestamp": "00:09:01", "text": "今天好好放松一下。让我们来谈谈"}, {"type": "subtitle", "time": 542.67, "timestamp": "00:09:02", "text": "环境"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "在。我们的宝贝们在哪儿？什么？幽灵"}, {"type": "subtitle", "time": 549.07, "timestamp": "00:09:09", "text": "宝贝。这是什么？"}, {"type": "subtitle", "time": 550.99, "timestamp": "00:09:10", "text": "是的，"}, {"type": "subtitle", "time": 552.99, "timestamp": "00:09:12", "text": "你好。你过得怎么样？"}, {"type": "subtitle", "time": 555.63, "timestamp": "00:09:15", "text": "天？情况如何？"}, {"type": "subtitle", "time": 560.43, "timestamp": "00:09:20", "text": "你？好的，我们从……开始。"}, {"type": "subtitle", "time": 563.99, "timestamp": "00:09:23", "text": "划痕。等等，我需要环境音吗？"}, {"type": "subtitle", "time": 570.03, "timestamp": "00:09:30", "text": "那太多了。哦，这个后缀太过了。"}, {"type": "subtitle", "time": 572.71, "timestamp": "00:09:32", "text": "响亮。等等，这样做确实会产生版权。"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "什么？哦，不。你为什么不说"}, {"type": "subtitle", "time": 577.389, "timestamp": "00:09:37", "text": "前？我发了私信。"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "你，祖基。妈的。啊，确实如此。"}, {"type": "subtitle", "time": 586.55, "timestamp": "00:09:46", "text": "版权。啊，疼痛。耽误。耽误。"}, {"type": "subtitle", "time": 588.91, "timestamp": "00:09:48", "text": "举起手来。抓住"}, {"type": "subtitle", "time": 593.55, "timestamp": "00:09:53", "text": "向上。我的火焰之针。我的针"}]
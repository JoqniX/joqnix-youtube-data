[{"type": "subtitle", "time": 8700.469, "timestamp": "02:25:00", "text": "刷怪真的很有趣"}, {"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "做各种事情，打boss战，以及"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "一切。是的。是的。"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "以后想试的时候再试吧。"}, {"type": "subtitle", "time": 8710.87, "timestamp": "02:25:10", "text": "想再玩一遍。永远不要这样做，永远不要"}, {"type": "subtitle", "time": 8712.87, "timestamp": "02:25:12", "text": "太无聊了。它是"}, {"type": "subtitle", "time": 8714.79, "timestamp": "02:25:14", "text": "也算是有意思吧。到达"}, {"type": "subtitle", "time": 8717.83, "timestamp": "02:25:17", "text": "体验事物。有很多好玩的"}, {"type": "subtitle", "time": 8719.67, "timestamp": "02:25:19", "text": "现在有各种活动和事情要处理。我记得"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "通过直播观看。我当时"}, {"type": "subtitle", "time": 8723.51, "timestamp": "02:25:23", "text": "比如，“我的天哪，变化太大了……”"}, {"type": "subtitle", "time": 8725.349, "timestamp": "02:25:25", "text": "这款游戏。”"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "好的。现在它的变化甚至比以前更大了。"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "之前就发生过。现在你拥有了这一切，麦加。"}, {"type": "subtitle", "time": 8733.55, "timestamp": "02:25:33", "text": "你进入了太空时代。所以，呃……"}, {"type": "subtitle", "time": 8738.71, "timestamp": "02:25:38", "text": "太空和麦加。所以还挺有意思的。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "那真不错。"}, {"type": "subtitle", "time": 8743.75, "timestamp": "02:25:43", "text": "是的。迫不及待想再次尝试一下！"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "是的。那么，你有什么来访的计划吗？"}, {"type": "subtitle", "time": 8756.23, "timestamp": "02:25:56", "text": "我不这么认为。"}, {"type": "subtitle", "time": 8758.55, "timestamp": "02:25:58", "text": "嗯。我觉得有点太多了。"}]
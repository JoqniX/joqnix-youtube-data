[{"type": "subtitle", "time": 9002.469, "timestamp": "02:30:02", "text": "你最近玩过的其他游戏吗？"}, {"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "比幻想更甚？你喜欢什么？"}, {"type": "subtitle", "time": 9009.51, "timestamp": "02:30:09", "text": "没有。这只是一美元的幻想而已。哦"}, {"type": "subtitle", "time": 9010.27, "timestamp": "02:30:10", "text": "我的"}, {"type": "subtitle", "time": 9012.99, "timestamp": "02:30:12", "text": "上帝。你如何保持"}, {"type": "subtitle", "time": 9015.99, "timestamp": "02:30:15", "text": "投入的？太疯狂了。是的，你可以"}, {"type": "subtitle", "time": 9017.83, "timestamp": "02:30:17", "text": "最近就随便玩玩吧。喜欢"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "登录五分钟，完成你的日常工作。"}, {"type": "subtitle", "time": 9021.51, "timestamp": "02:30:21", "text": "每周，结束。登录五"}, {"type": "subtitle", "time": 9022.87, "timestamp": "02:30:22", "text": "分钟，完成你的日常任务和视频，"}, {"type": "subtitle", "time": 9026.469, "timestamp": "02:30:26", "text": "基本上就是这样。"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "呃，有时候当我想要做……的时候"}, {"type": "subtitle", "time": 9030.87, "timestamp": "02:30:30", "text": "这个故事，我花了两个多小时来讲述。"}, {"type": "subtitle", "time": 9033.469, "timestamp": "02:30:33", "text": "并完成"}, {"type": "subtitle", "time": 9035.83, "timestamp": "02:30:35", "text": "故事。故事还不错。如果"}, {"type": "subtitle", "time": 9037.11, "timestamp": "02:30:37", "text": "你喜欢故事之类的东西，是的"}, {"type": "subtitle", "time": 9038.87, "timestamp": "02:30:38", "text": "确实挺有意思的。是的。"}, {"type": "subtitle", "time": 9048.389, "timestamp": "02:30:48", "text": "还有，你有什么喜欢的派对游戏吗？"}, {"type": "subtitle", "time": 9052.309, "timestamp": "02:30:52", "text": "喜欢和朋友一起玩吗？什么类型的"}, {"type": "subtitle", "time": 9054.55, "timestamp": "02:30:54", "text": "你指的是哪种类型的派对游戏？"}, {"type": "subtitle", "time": 9058.07, "timestamp": "02:30:58", "text": "像你知道的那种派对游戏，比如 Repo 或"}]
[{"type": "subtitle", "time": 5460.629, "timestamp": "01:31:00", "text": "教区实际上就是把自己想象成"}, {"type": "subtitle", "time": 5463.43, "timestamp": "01:31:03", "text": "一个油管主播正在直播，等等"}, {"type": "subtitle", "time": 5466.629, "timestamp": "01:31:06", "text": "然后，毫无征兆地，你的个人信息就被曝光了。你"}, {"type": "subtitle", "time": 5469.51, "timestamp": "01:31:09", "text": "获得一个 g，你的观众会给你一个游戏"}, {"type": "subtitle", "time": 5472.31, "timestamp": "01:31:12", "text": "下载安装，然后你就可以下载了。"}, {"type": "subtitle", "time": 5474.47, "timestamp": "01:31:14", "text": "安装它。玩那个恐怖游戏。后"}, {"type": "subtitle", "time": 5478.149, "timestamp": "01:31:18", "text": "请稍等片刻，您的相机已开启。"}, {"type": "subtitle", "time": 5482.87, "timestamp": "01:31:22", "text": "正在直播。我的天哪。"}, {"type": "subtitle", "time": 5485.51, "timestamp": "01:31:25", "text": "就是这样，还有更多恐怖元素"}, {"type": "subtitle", "time": 5488.47, "timestamp": "01:31:28", "text": "游戏。这是一款恐怖游戏。所以，所以"}, {"type": "subtitle", "time": 5492.229, "timestamp": "01:31:32", "text": "还有很多恐怖题材的东西。"}, {"type": "subtitle", "time": 5494.709, "timestamp": "01:31:34", "text": "好的。有些人想杀你。"}, {"type": "subtitle", "time": 5496.47, "timestamp": "01:31:36", "text": "以及所有的一切。你必须躲藏起来"}, {"type": "subtitle", "time": 5502.87, "timestamp": "01:31:42", "text": "是的。因为我玩了那款游戏，我"}, {"type": "subtitle", "time": 5506.229, "timestamp": "01:31:46", "text": "有人明白日本人是如何看待或"}, {"type": "subtitle", "time": 5508.87, "timestamp": "01:31:48", "text": "公寓就像……既然我要走了"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "去了日本之后，我大概明白了是怎么回事。"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "事物就像小事一样，"}, {"type": "subtitle", "time": 5517.669, "timestamp": "01:31:57", "text": "一切。那挺酷的。不是"}]
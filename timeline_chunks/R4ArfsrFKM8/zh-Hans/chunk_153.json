[{"type": "subtitle", "time": 9181.429, "timestamp": "02:33:01", "text": "他一旦开始卸任，就会……"}, {"type": "subtitle", "time": 9183.83, "timestamp": "02:33:03", "text": "我最终接手的那场比赛"}, {"type": "subtitle", "time": 9187.03, "timestamp": "02:33:07", "text": "公会以及管理一切"}, {"type": "subtitle", "time": 9189.429, "timestamp": "02:33:09", "text": "不知怎么的，它就这么一直伴随着"}, {"type": "subtitle", "time": 9192.309, "timestamp": "02:33:12", "text": "边。嗯，我以前玩过《星际公民》。"}, {"type": "subtitle", "time": 9194.309, "timestamp": "02:33:14", "text": "正确的？是的。是的。所以，在我使用的时候"}, {"type": "subtitle", "time": 9198.429, "timestamp": "02:33:18", "text": "玩《星际公民》的时候，我以前很喜欢……"}, {"type": "subtitle", "time": 9201.03, "timestamp": "02:33:21", "text": "呃，就像我以前看到的这个社区一样"}, {"type": "subtitle", "time": 9203.19, "timestamp": "02:33:23", "text": "《星报》组织的活动"}, {"type": "subtitle", "time": 9205.349, "timestamp": "02:33:25", "text": "公民社区，我非常"}, {"type": "subtitle", "time": 9208.07, "timestamp": "02:33:28", "text": "受他们启发，这是一件……"}, {"type": "subtitle", "time": 9209.75, "timestamp": "02:33:29", "text": "我想带到塔楼"}, {"type": "subtitle", "time": 9212.309, "timestamp": "02:33:32", "text": "奇幻题材也是如此。所以，这就是我所在的地方。"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "我的旅程始于十月"}, {"type": "subtitle", "time": 9219.03, "timestamp": "02:33:39", "text": "2022年，一起简单的事件导致了……"}, {"type": "subtitle", "time": 9222.23, "timestamp": "02:33:42", "text": "两名玩家之间的PVP比赛结果"}, {"type": "subtitle", "time": 9226.63, "timestamp": "02:33:46", "text": "我有个组织活动的想法。所以，我"}, {"type": "subtitle", "time": 9230.469, "timestamp": "02:33:50", "text": "组织这次PVP活动，呃……"}, {"type": "subtitle", "time": 9233.429, "timestamp": "02:33:53", "text": "挺好玩的。我们进行了一场PVP比赛"}, {"type": "subtitle", "time": 9236.15, "timestamp": "02:33:56", "text": "正在进行中。当时来了很多人。"}, {"type": "subtitle", "time": 9239.11, "timestamp": "02:33:59", "text": "当时大约有60到100人在那里，"}]
[{"type": "subtitle", "time": 4620.27, "timestamp": "01:17:00", "text": "现在他们就像"}, {"type": "subtitle", "time": 4623.75, "timestamp": "01:17:03", "text": "正是它们内在的这种力量驱使它们行动。"}, {"type": "subtitle", "time": 4626.63, "timestamp": "01:17:06", "text": "你所知道的一切。所以它是内置的"}, {"type": "subtitle", "time": 4628.87, "timestamp": "01:17:08", "text": "你听歌时所拥有的系统"}, {"type": "subtitle", "time": 4631.83, "timestamp": "01:17:11", "text": "音乐。所以，你默认擅长"}, {"type": "subtitle", "time": 4635.11, "timestamp": "01:17:15", "text": "跳舞。是的，没错。"}, {"type": "subtitle", "time": 4636.03, "timestamp": "01:17:16", "text": "真的"}, {"type": "subtitle", "time": 4640.14, "timestamp": "01:17:20", "text": "跳舞什么的，挺好玩的。"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "[音乐]"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "我一直有这个想法，知道我们是否"}, {"type": "subtitle", "time": 4647.03, "timestamp": "01:17:27", "text": "管状时髦玩意儿变得流行起来或像"}, {"type": "subtitle", "time": 4649.83, "timestamp": "01:17:29", "text": "在印度，这种情况已经普遍存在了。"}, {"type": "subtitle", "time": 4652.709, "timestamp": "01:17:32", "text": "这么多年来，我一直有个愿望"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "我想做的就是，呃，因为我太"}, {"type": "subtitle", "time": 4659.35, "timestamp": "01:17:39", "text": "我以前很害羞，不敢做街头艺人那一套。"}, {"type": "subtitle", "time": 4662.149, "timestamp": "01:17:42", "text": "现在我站在街上，想着这些事。"}, {"type": "subtitle", "time": 4664.79, "timestamp": "01:17:44", "text": "我觉得好像有人……"}, {"type": "subtitle", "time": 4667.11, "timestamp": "01:17:47", "text": "我不知道某个油管博主是谁。"}, {"type": "subtitle", "time": 4669.189, "timestamp": "01:17:49", "text": "是哪个国家？但他们确实很喜欢"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "电视屏幕上，他们正在唱歌"}, {"type": "subtitle", "time": 4675.43, "timestamp": "01:17:55", "text": "YouTuber们都喜欢那个机器人玩意儿"}, {"type": "subtitle", "time": 4677.51, "timestamp": "01:17:57", "text": "电视搬家之类的东西在这个角落里"}]
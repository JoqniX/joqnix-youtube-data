[{"type": "subtitle", "time": 901.11, "timestamp": "00:15:01", "text": "有道理。这让你怒不可遏。患病的"}, {"type": "subtitle", "time": 903.11, "timestamp": "00:15:03", "text": "当然，你总可以试试。我想成为"}, {"type": "subtitle", "time": 906.47, "timestamp": "00:15:06", "text": "那个人。我仍然患有创伤后应激障碍。那是什么？"}, {"type": "subtitle", "time": 908.829, "timestamp": "00:15:08", "text": "游戏？我想成为"}, {"type": "subtitle", "time": 912.47, "timestamp": "00:15:12", "text": "男。感觉这游戏不错。我"}, {"type": "subtitle", "time": 930.509, "timestamp": "00:15:30", "text": "慢慢地。嗯？那么，我们来谈谈……"}, {"type": "subtitle", "time": 932.189, "timestamp": "00:15:32", "text": "某物。"}, {"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "呃，你那边发生什么好事了吗？"}, {"type": "subtitle", "time": 940.43, "timestamp": "00:15:40", "text": "今天各位？你做过什么好事吗？"}, {"type": "subtitle", "time": 943.829, "timestamp": "00:15:43", "text": "今天？仿佛它可以是任何东西。帮助"}, {"type": "subtitle", "time": 946.87, "timestamp": "00:15:46", "text": "你的父母，做家务，做好事"}, {"type": "subtitle", "time": 952.31, "timestamp": "00:15:52", "text": "东西。嗯。"}, {"type": "subtitle", "time": 955.15, "timestamp": "00:15:55", "text": "你知道，现在就是这样。"}, {"type": "subtitle", "time": 958.79, "timestamp": "00:15:58", "text": "嗯，是的，它不会那么好。"}]
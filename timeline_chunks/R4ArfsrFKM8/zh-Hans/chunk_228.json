[{"type": "subtitle", "time": 13681.429, "timestamp": "03:48:01", "text": "轰焦冻在那儿，他做得很好。"}, {"type": "subtitle", "time": 13684.51, "timestamp": "03:48:04", "text": "尤桑现在做得很好。"}, {"type": "subtitle", "time": 13688.389, "timestamp": "03:48:08", "text": "现在他们认为人们可以购买"}, {"type": "subtitle", "time": 13691.15, "timestamp": "03:48:11", "text": "如果他们被终止服务，则会收到他们的IP地址。"}, {"type": "subtitle", "time": 13695.11, "timestamp": "03:48:15", "text": "嗯，那得看具体公司了。"}, {"type": "subtitle", "time": 13698.469, "timestamp": "03:48:18", "text": "你不能合法地购买你的公司"}, {"type": "subtitle", "time": 13701.349, "timestamp": "03:48:21", "text": "资产，它是公司的资产，为什么？"}, {"type": "subtitle", "time": 13705.59, "timestamp": "03:48:25", "text": "他们应该把那个给你吧？"}, {"type": "subtitle", "time": 13708.71, "timestamp": "03:48:28", "text": "好好想想。有很多圣人"}, {"type": "subtitle", "time": 13710.469, "timestamp": "03:48:30", "text": "有才华的人和有才华的人"}, {"type": "subtitle", "time": 13712.95, "timestamp": "03:48:32", "text": "终止、毕业等等。做过"}, {"type": "subtitle", "time": 13716.309, "timestamp": "03:48:36", "text": "他们中的任何一个都要为自己的模型付费。"}, {"type": "subtitle", "time": 13719.11, "timestamp": "03:48:39", "text": "他们之前拥有的是什么？不，是"}, {"type": "subtitle", "time": 13722.349, "timestamp": "03:48:42", "text": "公司资产。公司制造"}, {"type": "subtitle", "time": 13725.349, "timestamp": "03:48:45", "text": "资产主要用于商品交易，"}, {"type": "subtitle", "time": 13727.03, "timestamp": "03:48:47", "text": "广告，"}, {"type": "subtitle", "time": 13730.71, "timestamp": "03:48:50", "text": "快闪店，很多主题店"}, {"type": "subtitle", "time": 13734.63, "timestamp": "03:48:54", "text": "东西，对吧？因为他们的才华"}, {"type": "subtitle", "time": 13738.389, "timestamp": "03:48:58", "text": "为了他们的知识产权，公司拥有知识产权。"}]
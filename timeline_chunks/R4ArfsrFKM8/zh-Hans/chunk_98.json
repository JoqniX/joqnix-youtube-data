[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "我很高兴我拥有了……"}, {"type": "subtitle", "time": 5885.43, "timestamp": "01:38:05", "text": "有机会参与你的直播。"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "所以，是的，我一直想充电，但是"}, {"type": "subtitle", "time": 5895.91, "timestamp": "01:38:15", "text": "我当时就像"}, {"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "所以当时我就想，我的天哪。我和我"}, {"type": "subtitle", "time": 5902.229, "timestamp": "01:38:22", "text": "我想，是的，我通过我认识了你。"}, {"type": "subtitle", "time": 5904.669, "timestamp": "01:38:24", "text": "能跟你好好说话之类的"}, {"type": "subtitle", "time": 5908.149, "timestamp": "01:38:28", "text": "等等，你是 Astros 的 MC 对吧？"}, {"type": "subtitle", "time": 5911.03, "timestamp": "01:38:31", "text": "符文诞生。"}, {"type": "subtitle", "time": 5913.669, "timestamp": "01:38:33", "text": "是啊是啊，我当时是啊是啊是啊"}, {"type": "subtitle", "time": 5915.669, "timestamp": "01:38:35", "text": "那样我就可以和……交谈了。"}, {"type": "subtitle", "time": 5918.95, "timestamp": "01:38:38", "text": "你更多。我想在那之前，我想"}, {"type": "subtitle", "time": 5920.95, "timestamp": "01:38:40", "text": "有一次我加入了风险投资公司，"}, {"type": "subtitle", "time": 5923.75, "timestamp": "01:38:43", "text": "我们第一次真正地交谈了。是的。"}, {"type": "subtitle", "time": 5927.669, "timestamp": "01:38:47", "text": "是的。但这就像是第一次……呃……"}, {"type": "subtitle", "time": 5930.07, "timestamp": "01:38:50", "text": "我们谈过一次。"}, {"type": "subtitle", "time": 5933.27, "timestamp": "01:38:53", "text": "好好谈谈。是的。好好谈谈。"}, {"type": "subtitle", "time": 5935.82, "timestamp": "01:38:55", "text": "是的。真是个有趣的笑话。"}, {"type": "subtitle", "time": 5937.59, "timestamp": "01:38:57", "text": "[音乐]"}]
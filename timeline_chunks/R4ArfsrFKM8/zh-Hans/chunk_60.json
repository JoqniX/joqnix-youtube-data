[{"type": "subtitle", "time": 3605.829, "timestamp": "01:00:05", "text": "正确的？我重回正轨了，宝贝。好的。"}, {"type": "chat", "time": 3607.172, "timestamp": "01:00:07", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Confronting stream??"}, {"type": "subtitle", "time": 3608.95, "timestamp": "01:00:08", "text": "好的。好的。太棒了。说到……"}, {"type": "subtitle", "time": 3613.589, "timestamp": "01:00:13", "text": "呃，生意上的事，呃，我记得……"}, {"type": "subtitle", "time": 3615.75, "timestamp": "01:00:15", "text": "呃，你的朋友是Rain Peter Shan，"}, {"type": "subtitle", "time": 3620.47, "timestamp": "01:00:20", "text": "正确的？我和Rain Chan都看到了这条帖子。"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "你当时也在场。她成功了，而我没有。"}, {"type": "subtitle", "time": 3626.15, "timestamp": "01:00:26", "text": "她甚至预料到了，但她真的"}, {"type": "subtitle", "time": 3630.87, "timestamp": "01:00:30", "text": "不错，兄弟。是的，她人很好。我想"}, {"type": "subtitle", "time": 3633.75, "timestamp": "01:00:33", "text": "把她也弄下去，因为她想下去。"}, {"type": "subtitle", "time": 3636.789, "timestamp": "01:00:36", "text": "她也曾想过有一天能和她合作，但她当时……"}, {"type": "subtitle", "time": 3640.309, "timestamp": "01:00:40", "text": "她忙着考试什么的。"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "是的，她很少直播，但她是个……"}, {"type": "subtitle", "time": 3645.829, "timestamp": "01:00:45", "text": "人很好。"}, {"type": "subtitle", "time": 3649.19, "timestamp": "01:00:49", "text": "我从达兹那里听说了不少关于她的事。"}, {"type": "subtitle", "time": 3653.109, "timestamp": "01:00:53", "text": "你认识达兹吗？不，我其实知道。"}, {"type": "subtitle", "time": 3656.069, "timestamp": "01:00:56", "text": "这个社区里只有少数人，"}, {"type": "chat", "time": 3656.895, "timestamp": "01:00:56", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "the arts pretty good"}, {"type": "subtitle", "time": 3658.15, "timestamp": "01:00:58", "text": "因为我告诉过你，我社交能力很差。"}]
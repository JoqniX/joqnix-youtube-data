[{"type": "subtitle", "time": 3301.19, "timestamp": "00:55:01", "text": "太糟糕了，因为音频没声音。"}, {"type": "subtitle", "time": 3305.47, "timestamp": "00:55:05", "text": "出色地。我觉得我也应该配音。"}, {"type": "subtitle", "time": 3309.43, "timestamp": "00:55:09", "text": "矿。不过最好还是尽快放弃吧。"}, {"type": "subtitle", "time": 3312.549, "timestamp": "00:55:12", "text": "是啊，电池鼓包确实很吓人。我知道"}, {"type": "subtitle", "time": 3316.03, "timestamp": "00:55:16", "text": "正确的。 M 泡芙"}, {"type": "subtitle", "time": 3319.27, "timestamp": "00:55:19", "text": "我的手机电池和电池都有问题。"}, {"type": "subtitle", "time": 3322.87, "timestamp": "00:55:22", "text": "电池续航时间不会很长，所以我"}, {"type": "subtitle", "time": 3324.87, "timestamp": "00:55:24", "text": "每隔两小时就得充电一次"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "或者别的什么。情况就是这么糟糕，而我"}, {"type": "subtitle", "time": 3331.109, "timestamp": "00:55:31", "text": "始终保持充电状态。"}, {"type": "subtitle", "time": 3333.27, "timestamp": "00:55:33", "text": "这就是我遇到的问题。我曾经"}, {"type": "subtitle", "time": 3335.51, "timestamp": "00:55:35", "text": "整晚都保持充电状态"}, {"type": "subtitle", "time": 3338.87, "timestamp": "00:55:38", "text": "它就像爆炸一样轰然爆发。我当时就想，"}, {"type": "subtitle", "time": 3343.03, "timestamp": "00:55:43", "text": "“该死，老兄。”我独自一人完成了这件事"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "亲手完成。我做到了。而现在我没有了"}, {"type": "subtitle", "time": 3348.589, "timestamp": "00:55:48", "text": "买一部好手机。我用的是旧款。"}, {"type": "subtitle", "time": 3352.39, "timestamp": "00:55:52", "text": "所以，希望我下一部手机能到手。"}, {"type": "subtitle", "time": 3354.77, "timestamp": "00:55:54", "text": "年。"}]
[{"type": "subtitle", "time": 11282.91, "timestamp": "03:08:02", "text": "后。我想我之前在这儿见过他。"}, {"type": "subtitle", "time": 11285.389, "timestamp": "03:08:05", "text": "惊人的。是的，我得问问他。"}, {"type": "subtitle", "time": 11288.59, "timestamp": "03:08:08", "text": "星期五。到周五，如果他"}, {"type": "subtitle", "time": 11291.269, "timestamp": "03:08:11", "text": "周一，她说：“美容搞定了。”"}, {"type": "subtitle", "time": 11293.429, "timestamp": "03:08:13", "text": "周二。是的，我得更新一些东西。"}, {"type": "subtitle", "time": 11296.429, "timestamp": "03:08:16", "text": "清单之类的东西。"}, {"type": "subtitle", "time": 11299.63, "timestamp": "03:08:19", "text": "嗯，YP Stream是"}, {"type": "subtitle", "time": 11303.55, "timestamp": "03:08:23", "text": "感兴趣的。我联系了对方。"}, {"type": "subtitle", "time": 11309.83, "timestamp": "03:08:29", "text": "是啊，问题是我想弄到一些"}, {"type": "subtitle", "time": 11312.389, "timestamp": "03:08:32", "text": "新来的人。呃，我最近认识的人。"}, {"type": "subtitle", "time": 11314.63, "timestamp": "03:08:34", "text": "与该团体合作，在一次会议上见面"}, {"type": "subtitle", "time": 11315.63, "timestamp": "03:08:35", "text": "一群"}, {"type": "subtitle", "time": 11319.23, "timestamp": "03:08:39", "text": "合作，对吧？所以，我想把它们弄到手。"}, {"type": "subtitle", "time": 11322.55, "timestamp": "03:08:42", "text": "出色地。所以，我正在考虑如何达到目标。"}, {"type": "subtitle", "time": 11329.99, "timestamp": "03:08:49", "text": "嗯，就像联系他们一样，如果他们是"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "所以，我没收到回复。"}]
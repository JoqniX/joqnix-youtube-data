[{"type": "subtitle", "time": 1026.75, "timestamp": "00:17:06", "text": "依偎在我的班加毯里吧。"}, {"type": "subtitle", "time": 1027.87, "timestamp": "00:17:07", "text": "[音乐]"}, {"type": "subtitle", "time": 1030.829, "timestamp": "00:17:10", "text": "你看，我爱"}, {"type": "subtitle", "time": 1033.829, "timestamp": "00:17:13", "text": "依偎着。你知道一个奇怪的事实吗？"}, {"type": "subtitle", "time": 1036.63, "timestamp": "00:17:16", "text": "关于我。我知道我很怪，但我很怪。"}, {"type": "subtitle", "time": 1038.35, "timestamp": "00:17:18", "text": "关于我的一件事"}, {"type": "subtitle", "time": 1041.309, "timestamp": "00:17:21", "text": "就是当我"}, {"type": "subtitle", "time": 1044.87, "timestamp": "00:17:24", "text": "睡觉的时候，我有时候会……呃，当我在……"}, {"type": "subtitle", "time": 1047.549, "timestamp": "00:17:27", "text": "好，嗯，开心"}, {"type": "subtitle", "time": 1051.669, "timestamp": "00:17:31", "text": "模式有点像喵喵石和行为"}, {"type": "subtitle", "time": 1052.99, "timestamp": "00:17:32", "text": "像猫一样"}, {"type": "subtitle", "time": 1054.909, "timestamp": "00:17:34", "text": "虽然"}, {"type": "subtitle", "time": 1058.19, "timestamp": "00:17:38", "text": "东西。其实是动漫"}, {"type": "subtitle", "time": 1060.99, "timestamp": "00:17:40", "text": "呃，哪个做了"}, {"type": "subtitle", "time": 1063.87, "timestamp": "00:17:43", "text": "呃，表达我的意思"}, {"type": "subtitle", "time": 1066.51, "timestamp": "00:17:46", "text": "做过。所以还有"}, {"type": "subtitle", "time": 1068.43, "timestamp": "00:17:48", "text": "礼物"}, {"type": "subtitle", "time": 1073.07, "timestamp": "00:17:53", "text": "它。我不知道我能否证明这一点。"}]
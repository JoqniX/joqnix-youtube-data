[{"type": "subtitle", "time": 9600.63, "timestamp": "02:40:00", "text": "大概20到30个片段，然后我会把它们转过来"}, {"type": "subtitle", "time": 9603.67, "timestamp": "02:40:03", "text": "制作成带有动画的短片"}, {"type": "subtitle", "time": 9605.99, "timestamp": "02:40:05", "text": "字幕什么的都有。"}, {"type": "subtitle", "time": 9608.95, "timestamp": "02:40:08", "text": "所以，数量确实非常惊人。"}, {"type": "subtitle", "time": 9611.59, "timestamp": "02:40:11", "text": "工作让我压力很大，我也一直在逼迫自己。"}, {"type": "subtitle", "time": 9614.15, "timestamp": "02:40:14", "text": "难的。"}, {"type": "subtitle", "time": 9618.07, "timestamp": "02:40:18", "text": "原来事情就是这样。是的。所以当时"}, {"type": "subtitle", "time": 9621.19, "timestamp": "02:40:21", "text": "比如发布四到五张照片"}, {"type": "subtitle", "time": 9625.349, "timestamp": "02:40:25", "text": "当时是一天。所以只有少数几个四人"}, {"type": "subtitle", "time": 9628.79, "timestamp": "02:40:28", "text": "我在另一个频道上发布了一些照片，还有一个"}, {"type": "subtitle", "time": 9632.15, "timestamp": "02:40:32", "text": "每天都会在我的主频道上发布。所以"}, {"type": "subtitle", "time": 9635.67, "timestamp": "02:40:35", "text": "五枪。数量之多令人难以置信"}, {"type": "subtitle", "time": 9638.71, "timestamp": "02:40:38", "text": "我当时在做一件糟透了的工作。回首往事，我"}, {"type": "subtitle", "time": 9640.389, "timestamp": "02:40:40", "text": "我不知道我是怎么做到的"}, {"type": "subtitle", "time": 9643.73, "timestamp": "02:40:43", "text": "诸如此类的事情都通过那段经历。"}, {"type": "subtitle", "time": 9645.59, "timestamp": "02:40:45", "text": "[音乐]"}, {"type": "subtitle", "time": 9648.03, "timestamp": "02:40:48", "text": "是的，就是这样。"}, {"type": "subtitle", "time": 9650.55, "timestamp": "02:40:50", "text": "疯狂的。是的，"}, {"type": "subtitle", "time": 9654.23, "timestamp": "02:40:54", "text": "我想念帕特和大家。我知道什么时候"}, {"type": "subtitle", "time": 9656.23, "timestamp": "02:40:56", "text": "以前看你的直播时……"}, {"type": "subtitle", "time": 9657.75, "timestamp": "02:40:57", "text": "拍。"}]
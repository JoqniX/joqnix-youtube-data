[{"type": "subtitle", "time": 7740.95, "timestamp": "02:09:00", "text": "我的想法是，如果我在直播，那我就必须……"}, {"type": "subtitle", "time": 7743.83, "timestamp": "02:09:03", "text": "轻声细语。是的，那将会"}, {"type": "subtitle", "time": 7746.629, "timestamp": "02:09:06", "text": "有点难。我没想到会是这样。"}, {"type": "subtitle", "time": 7750.91, "timestamp": "02:09:10", "text": "就像那样难。 M 是"}, {"type": "subtitle", "time": 7754.069, "timestamp": "02:09:14", "text": "非常难过，但我希望我能挺过去。"}, {"type": "subtitle", "time": 7756.629, "timestamp": "02:09:16", "text": "猜测。所以如果你要去"}, {"type": "subtitle", "time": 7758.47, "timestamp": "02:09:18", "text": "你是否饱受折磨，你会喜欢使用……"}, {"type": "subtitle", "time": 7760.47, "timestamp": "02:09:20", "text": "笔记本电脑或其他什么东西，或者你喜欢带上它"}, {"type": "subtitle", "time": 7762.55, "timestamp": "02:09:22", "text": "电脑还是别的什么设备？我不能带走电脑"}, {"type": "subtitle", "time": 7765.99, "timestamp": "02:09:25", "text": "现在。我的游戏电脑丢了。我是"}, {"type": "subtitle", "time": 7771.109, "timestamp": "02:09:31", "text": "就像在我的直播电脑上设置单台PC一样"}, {"type": "subtitle", "time": 7775.03, "timestamp": "02:09:35", "text": "游戏电脑。呃，所以你还记得我"}, {"type": "subtitle", "time": 7778.069, "timestamp": "02:09:38", "text": "不知道“让我得到”这个名字"}, {"type": "subtitle", "time": 7781.27, "timestamp": "02:09:41", "text": "游戏名称。呃，你知道的。"}, {"type": "subtitle", "time": 7783.39, "timestamp": "02:09:43", "text": "超逼真"}, {"type": "subtitle", "time": 7786.39, "timestamp": "02:09:46", "text": "军事射击游戏，呃，无人机和"}, {"type": "subtitle", "time": 7789.75, "timestamp": "02:09:49", "text": "东西。那是什么游戏？呃，是哪一个？"}, {"type": "subtitle", "time": 7791.91, "timestamp": "02:09:51", "text": "那是什么游戏？"}, {"type": "subtitle", "time": 7793.75, "timestamp": "02:09:53", "text": "就这么叫它吧。这不是《使命召唤》。它是"}, {"type": "subtitle", "time": 7796.95, "timestamp": "02:09:56", "text": "类似竞技场或团队射击类型的"}, {"type": "subtitle", "time": 7799.669, "timestamp": "02:09:59", "text": "东西。就像两支队伍一起做"}]
[{"type": "subtitle", "time": 10263.11, "timestamp": "02:51:03", "text": "你在那里的住宿体验如何？你的感受如何？"}, {"type": "subtitle", "time": 10265.269, "timestamp": "02:51:05", "text": "关于它，你喜欢什么，不喜欢什么。"}, {"type": "subtitle", "time": 10267.349, "timestamp": "02:51:07", "text": "喜欢。"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "你当然可以给个好评价"}, {"type": "subtitle", "time": 10271.03, "timestamp": "02:51:11", "text": "也能从其他人的角度看待问题。"}, {"type": "subtitle", "time": 10273.99, "timestamp": "02:51:13", "text": "是啊，肯定很有趣。迫不及待想看"}, {"type": "subtitle", "time": 10277.11, "timestamp": "02:51:17", "text": "事情就是这样。这是我第一次……"}, {"type": "subtitle", "time": 10279.429, "timestamp": "02:51:19", "text": "那种环境。不是我去"}, {"type": "subtitle", "time": 10282.309, "timestamp": "02:51:22", "text": "出国或独自一人"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "我独自一人，作为家中唯一的孩子，"}, {"type": "subtitle", "time": 10288.79, "timestamp": "02:51:28", "text": "从小被过度保护和娇惯。这"}, {"type": "subtitle", "time": 10291.03, "timestamp": "02:51:31", "text": "我想，这将是你独立发展的故事线。"}, {"type": "subtitle", "time": 10294.15, "timestamp": "02:51:34", "text": "是的。所以，我很兴奋。"}, {"type": "subtitle", "time": 10296.389, "timestamp": "02:51:36", "text": "那挺好的。那挺好的。寻找"}, {"type": "subtitle", "time": 10299.67, "timestamp": "02:51:39", "text": "期待听到那里的故事。是的。"}, {"type": "subtitle", "time": 10301.75, "timestamp": "02:51:41", "text": "是的。我期待着，我会发给你。"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "图片之类的。不，听起来……"}, {"type": "subtitle", "time": 10305.83, "timestamp": "02:51:45", "text": "好的。听起来很棒。当然。当然。"}, {"type": "subtitle", "time": 10308.15, "timestamp": "02:51:48", "text": "发给我。我总是喜欢看"}, {"type": "subtitle", "time": 10310.55, "timestamp": "02:51:50", "text": "图片。"}, {"type": "subtitle", "time": 10312.67, "timestamp": "02:51:52", "text": "我展示图片和"}, {"type": "subtitle", "time": 10315.51, "timestamp": "02:51:55", "text": "东西。以温泉闻名？热的"}, {"type": "subtitle", "time": 10317.99, "timestamp": "02:51:57", "text": "是温泉，对吧？所以，展现火热"}]
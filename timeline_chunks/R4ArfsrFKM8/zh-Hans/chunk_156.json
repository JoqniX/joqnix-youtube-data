[{"type": "subtitle", "time": 9360.59, "timestamp": "02:36:00", "text": "对所有人都是一样的"}, {"type": "subtitle", "time": 9364.23, "timestamp": "02:36:04", "text": "无论我做什么，我的鳃里都有细小的鳃丝和鳃。"}, {"type": "subtitle", "time": 9368.469, "timestamp": "02:36:08", "text": "可以在服务器上找到，然后又找到了"}, {"type": "subtitle", "time": 9371.19, "timestamp": "02:36:11", "text": "正因如此，它发展得更快了。呃"}, {"type": "subtitle", "time": 9372.349, "timestamp": "02:36:12", "text": "与此同时，"}, {"type": "subtitle", "time": 9375.51, "timestamp": "02:36:15", "text": "事情进展一切如常。我结束了"}, {"type": "subtitle", "time": 9378.59, "timestamp": "02:36:18", "text": "不知怎么的，这个人最终带领了10个人。"}, {"type": "subtitle", "time": 9382.03, "timestamp": "02:36:22", "text": "公会以某种方式存在。"}, {"type": "subtitle", "time": 9385.429, "timestamp": "02:36:25", "text": "是的，那就是我的主要公会。那"}, {"type": "subtitle", "time": 9386.95, "timestamp": "02:36:26", "text": "是我的主要公会。那就是……"}, {"type": "subtitle", "time": 9390.07, "timestamp": "02:36:30", "text": "其他一些规模较小的公会等等。和"}, {"type": "subtitle", "time": 9393.03, "timestamp": "02:36:33", "text": "挺好玩的。挺好玩的。它"}, {"type": "subtitle", "time": 9394.95, "timestamp": "02:36:34", "text": "仍然很有趣。但现在游戏有点……"}, {"type": "subtitle", "time": 9397.11, "timestamp": "02:36:37", "text": "处于衰退期。所以情况变得不那么……"}, {"type": "subtitle", "time": 9400.55, "timestamp": "02:36:40", "text": "它更轻松，东西也更少。"}, {"type": "subtitle", "time": 9403.27, "timestamp": "02:36:43", "text": "但基本上就是这样，我的"}, {"type": "subtitle", "time": 9405.63, "timestamp": "02:36:45", "text": "灵感来源于《星际公民》社区"}, {"type": "subtitle", "time": 9409.83, "timestamp": "02:36:49", "text": "一些事件促使我继续这样做。"}, {"type": "subtitle", "time": 9413.27, "timestamp": "02:36:53", "text": "并且喜欢带来这种感觉"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "社区团结的感觉"}, {"type": "subtitle", "time": 9419.67, "timestamp": "02:36:59", "text": "团结一致的感觉等等。所以"}]
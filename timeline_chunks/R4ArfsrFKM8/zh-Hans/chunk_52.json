[{"type": "subtitle", "time": 3120.47, "timestamp": "00:52:00", "text": "现在关门了。"}, {"type": "subtitle", "time": 3123.67, "timestamp": "00:52:03", "text": "真不错。就像打雪仗一样"}, {"type": "subtitle", "time": 3125.51, "timestamp": "00:52:05", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 3127.75, "timestamp": "00:52:07", "text": "是的，你应该去看看。你会喜欢的，"}, {"type": "subtitle", "time": 3129.51, "timestamp": "00:52:09", "text": "乔。你会喜欢的。我告诉你。做过"}, {"type": "subtitle", "time": 3131.67, "timestamp": "00:52:11", "text": "你会滑雪之类的运动吗？老鼠是如何"}, {"type": "subtitle", "time": 3136.069, "timestamp": "00:52:16", "text": "滑雪。是的。是的，我也滑过雪。"}, {"type": "subtitle", "time": 3138.549, "timestamp": "00:52:18", "text": "我本来打算去玩滑翔伞的"}, {"type": "subtitle", "time": 3141.75, "timestamp": "00:52:21", "text": "我也这么想，但他们说"}, {"type": "subtitle", "time": 3143.91, "timestamp": "00:52:23", "text": "那里的工人们说空气是"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "太薄了，不能像……一样携带"}, {"type": "subtitle", "time": 3149.43, "timestamp": "00:52:29", "text": "重量太重，所以很危险。所以，我们"}, {"type": "subtitle", "time": 3151.75, "timestamp": "00:52:31", "text": "我做不到。"}, {"type": "subtitle", "time": 3155.03, "timestamp": "00:52:35", "text": "我们还玩了滑管之类的项目。"}, {"type": "subtitle", "time": 3158.63, "timestamp": "00:52:38", "text": "所以就像那里有一大堆雪。"}, {"type": "subtitle", "time": 3160.87, "timestamp": "00:52:40", "text": "就像在山上一样。从那里开始"}, {"type": "subtitle", "time": 3163.27, "timestamp": "00:52:43", "text": "就像一个斜坡，然后你滑下去。"}, {"type": "subtitle", "time": 3165.67, "timestamp": "00:52:45", "text": "管子之类的东西。那也太棒了。我"}, {"type": "subtitle", "time": 3168.95, "timestamp": "00:52:48", "text": "我的屁股都贴在冰上了，当时……"}]
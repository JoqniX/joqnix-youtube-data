[{"type": "subtitle", "time": 241.429, "timestamp": "00:04:01", "text": "遗忘。星期五是什么时候来着？是的，"}, {"type": "subtitle", "time": 244.63, "timestamp": "00:04:04", "text": "昨天。等等，稍等。是吗？"}, {"type": "subtitle", "time": 246.47, "timestamp": "00:04:06", "text": "周四？对，星期四。我想我"}, {"type": "subtitle", "time": 250.11, "timestamp": "00:04:10", "text": "我忘了我的大脑。我什么时候服用的？"}, {"type": "subtitle", "time": 253.47, "timestamp": "00:04:13", "text": "疫苗？他妈的。呃，"}, {"type": "subtitle", "time": 256.87, "timestamp": "00:04:16", "text": "周四。那是在我发薪日直播之后。"}, {"type": "subtitle", "time": 259.349, "timestamp": "00:04:19", "text": "Payday 与 Sakura State 合作"}, {"type": "subtitle", "time": 263.469, "timestamp": "00:04:23", "text": "寿司。所以我觉得"}, {"type": "subtitle", "time": 266.35, "timestamp": "00:04:26", "text": "等等。"}, {"type": "subtitle", "time": 269.55, "timestamp": "00:04:29", "text": "呃，我不记得了。"}, {"type": "subtitle", "time": 273.59000000000003, "timestamp": "00:04:33", "text": "呃，星期五。是的，昨天。等等，今天"}, {"type": "subtitle", "time": 275.99, "timestamp": "00:04:35", "text": "周六？什么？等等，今天"}, {"type": "subtitle", "time": 279.07, "timestamp": "00:04:39", "text": "周六？啊，"}, {"type": "subtitle", "time": 282.39, "timestamp": "00:04:42", "text": "上帝。我总是忘记。我的大脑"}, {"type": "chat", "time": 282.582, "timestamp": "00:04:42", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/J7pcldIC"}, {"type": "subtitle", "time": 286.15, "timestamp": "00:04:46", "text": "笨蛋。还有，再次问好。"}, {"type": "subtitle", "time": 288.469, "timestamp": "00:04:48", "text": "Tizuki。是啊，你好，雷米。是的，你好"}, {"type": "subtitle", "time": 290.909, "timestamp": "00:04:50", "text": "萨特桑。是的，"}, {"type": "subtitle", "time": 294.43, "timestamp": "00:04:54", "text": "Helixan。我错过了什么？"}, {"type": "subtitle", "time": 297.95, "timestamp": "00:04:57", "text": "有人吗？以及流框流元素"}]
[{"type": "subtitle", "time": 2281.589, "timestamp": "00:38:01", "text": "其实我之前就了解过管材，比如……"}, {"type": "subtitle", "time": 2283.109, "timestamp": "00:38:03", "text": "2020"}, {"type": "subtitle", "time": 2286.87, "timestamp": "00:38:06", "text": "当我想到“当……的时候”的时候"}, {"type": "subtitle", "time": 2290.23, "timestamp": "00:38:10", "text": "我发现了一些像 YouTuber 这样的时间"}, {"type": "subtitle", "time": 2293.349, "timestamp": "00:38:13", "text": "不在印度，但像普通的 YouTuber 一样"}, {"type": "subtitle", "time": 2295.75, "timestamp": "00:38:15", "text": "其他地区的人等等。"}, {"type": "subtitle", "time": 2298.069, "timestamp": "00:38:18", "text": "是的。是的。所以我很投入。"}, {"type": "subtitle", "time": 2301.03, "timestamp": "00:38:21", "text": "甚至连我自己也想那样做，等等等等。"}, {"type": "subtitle", "time": 2303.829, "timestamp": "00:38:23", "text": "但我认为在印度不会这样。"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "可能的。所以我放弃了那个念头。"}, {"type": "subtitle", "time": 2309.589, "timestamp": "00:38:29", "text": "我的编辑生涯由此开始。所以我做了"}, {"type": "subtitle", "time": 2312.47, "timestamp": "00:38:32", "text": "自由职业，嗯，有一段时间是这样的"}, {"type": "subtitle", "time": 2316.47, "timestamp": "00:38:36", "text": "一两年后，我就"}, {"type": "subtitle", "time": 2318.95, "timestamp": "00:38:38", "text": "有一天，我突然就坐在那里，毫无预兆地坐着。"}, {"type": "subtitle", "time": 2322.23, "timestamp": "00:38:42", "text": "放在我腿上，我就想，为什么不建一个呢？"}, {"type": "subtitle", "time": 2326.15, "timestamp": "00:38:46", "text": "临时使用模型。所以，我其实"}, {"type": "subtitle", "time": 2328.95, "timestamp": "00:38:48", "text": "我的第一个模型"}, {"type": "subtitle", "time": 2332.87, "timestamp": "00:38:52", "text": "呃，我把它命名为A。它不是Jbury，而是"}, {"type": "subtitle", "time": 2338.069, "timestamp": "00:38:58", "text": "AV。好的。它有红色的头发，呃呃"}]
[{"type": "subtitle", "time": 602.59, "timestamp": "00:10:02", "text": "分钟。这会吗？"}, {"type": "subtitle", "time": 605.75, "timestamp": "00:10:05", "text": "工作？等待。我需要杰克。中国主题"}, {"type": "subtitle", "time": 609.07, "timestamp": "00:10:09", "text": "或者类似的事情。我们开始吧"}, {"type": "subtitle", "time": 611.15, "timestamp": "00:10:11", "text": "看。不是"}, {"type": "subtitle", "time": 620.91, "timestamp": "00:10:20", "text": "封面不是图例？不是"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "裂了。不，我需要一个冷静的废物。它是"}, {"type": "subtitle", "time": 626.75, "timestamp": "00:10:26", "text": "好的，"}, {"type": "subtitle", "time": 633.829, "timestamp": "00:10:33", "text": "失眠。午夜。哦，等等。午夜"}, {"type": "subtitle", "time": 636.35, "timestamp": "00:10:36", "text": "就像小火一样，"}, {"type": "subtitle", "time": 638.46, "timestamp": "00:10:38", "text": "正确的？我"}, {"type": "subtitle", "time": 639.71, "timestamp": "00:10:39", "text": "[音乐]"}, {"type": "subtitle", "time": 648.03, "timestamp": "00:10:48", "text": "较低。就好像它有一个"}, {"type": "subtitle", "time": 657.11, "timestamp": "00:10:57", "text": "法律。我的意思是，就是找些歌来播放。"}]
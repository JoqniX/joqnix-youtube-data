[{"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "那里有一些机构。如果一些"}, {"type": "subtitle", "time": 13204.95, "timestamp": "03:40:04", "text": "机构的人都非常友善和热情。"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "他们会说，是的，你可以留着它。"}, {"type": "subtitle", "time": 13210.469, "timestamp": "03:40:10", "text": "那是你的IP地址，你可以保留它之类的。"}, {"type": "subtitle", "time": 13213.91, "timestamp": "03:40:13", "text": "为此，你必须做出很多贡献"}, {"type": "subtitle", "time": 13217.91, "timestamp": "03:40:17", "text": "该机构因此获得了利润。"}, {"type": "subtitle", "time": 13220.71, "timestamp": "03:40:20", "text": "以他们乐于接受的方式"}, {"type": "subtitle", "time": 13223.91, "timestamp": "03:40:23", "text": "那个知识产权、那个设计或任何模型"}, {"type": "subtitle", "time": 13226.63, "timestamp": "03:40:26", "text": "他们已经为你投入了资金。"}, {"type": "subtitle", "time": 13229.15, "timestamp": "03:40:29", "text": "可以赠送给"}, {"type": "subtitle", "time": 13232.71, "timestamp": "03:40:32", "text": "你可以免费拿走那玩意儿，因为它是你的。"}, {"type": "subtitle", "time": 13234.71, "timestamp": "03:40:34", "text": "不过，你仍然可以选择……"}, {"type": "subtitle", "time": 13239.51, "timestamp": "03:40:39", "text": "回购对吧？是的，所以大多数人我"}, {"type": "subtitle", "time": 13242.15, "timestamp": "03:40:42", "text": "已在两份通知中看到毕业"}, {"type": "subtitle", "time": 13244.87, "timestamp": "03:40:44", "text": "他们参加了毕业典礼。"}, {"type": "subtitle", "time": 13248.469, "timestamp": "03:40:48", "text": "已经做过某种形式的模型回购了"}, {"type": "subtitle", "time": 13251.269, "timestamp": "03:40:51", "text": "类似子马拉松之类​​的活动也有。"}, {"type": "subtitle", "time": 13253.269, "timestamp": "03:40:53", "text": "允许这些人才从事以下工作的机构"}, {"type": "subtitle", "time": 13256.55, "timestamp": "03:40:56", "text": "还有那些最终的活动和项目"}, {"type": "chat", "time": 13256.992, "timestamp": "03:40:56", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "like ya if they spend 100 and you give back 500 ofcs they be like ya do whatever ya want"}, {"type": "subtitle", "time": 13258.87, "timestamp": "03:40:58", "text": "他们一直都想举办演唱会"}]
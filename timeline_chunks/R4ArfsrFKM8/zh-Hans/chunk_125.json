[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "门户网站运行不太正常。我"}, {"type": "subtitle", "time": 7503.75, "timestamp": "02:05:03", "text": "当时我就想，好吧，这有点麻烦。"}, {"type": "subtitle", "time": 7506.31, "timestamp": "02:05:06", "text": "因为我打算把所有动作都记录下来"}, {"type": "subtitle", "time": 7508.39, "timestamp": "02:05:08", "text": "主播已经完成了所有操作"}, {"type": "subtitle", "time": 7510.39, "timestamp": "02:05:10", "text": "反正都会在串流板上，因为"}, {"type": "subtitle", "time": 7513.51, "timestamp": "02:05:13", "text": "比如直接用主播机器人就行了。"}, {"type": "subtitle", "time": 7516.79, "timestamp": "02:05:16", "text": "把那东西串流起来。所以我做了这个"}, {"type": "subtitle", "time": 7519.99, "timestamp": "02:05:19", "text": "整整三页长，嗯，三个"}, {"type": "subtitle", "time": 7522.87, "timestamp": "02:05:22", "text": "不同页面上的多个控件"}, {"type": "subtitle", "time": 7525.109, "timestamp": "02:05:25", "text": "锦标赛中的各种场景或"}, {"type": "subtitle", "time": 7528.31, "timestamp": "02:05:28", "text": "就像频道切换一样，呃，不是频道"}, {"type": "subtitle", "time": 7531.55, "timestamp": "02:05:31", "text": "老板变了"}, {"type": "subtitle", "time": 7536.07, "timestamp": "02:05:36", "text": "嗯，右后屏幕即将开始"}, {"type": "subtitle", "time": 7539.109, "timestamp": "02:05:39", "text": "关于该剧的最新信息"}, {"type": "subtitle", "time": 7541.03, "timestamp": "02:05:41", "text": "球员们自己也喜欢这位球员"}, {"type": "subtitle", "time": 7543.75, "timestamp": "02:05:43", "text": "对战玩家。所以所有这些都可能是"}, {"type": "subtitle", "time": 7547.589, "timestamp": "02:05:47", "text": "通过主播台更新。哦，"}, {"type": "subtitle", "time": 7549.669, "timestamp": "02:05:49", "text": "好的。我当时还有另外两个人。"}, {"type": "subtitle", "time": 7551.83, "timestamp": "02:05:51", "text": "帮我处理那些事。就是这样。"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "就像一次全面的团队合作。是的，"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "这是其中一点。是的。"}]
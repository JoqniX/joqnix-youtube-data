[{"type": "subtitle", "time": 9480.389, "timestamp": "02:38:00", "text": "[音乐]"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "坚持，稍等。你还在分享艺术作品吗？"}, {"type": "subtitle", "time": 9485.55, "timestamp": "02:38:05", "text": "推特就像花哨"}, {"type": "subtitle", "time": 9488.63, "timestamp": "02:38:08", "text": "别人的作品？你喜欢它，"}, {"type": "subtitle", "time": 9490.79, "timestamp": "02:38:10", "text": "在 Discord 上分享吗？我至今仍记得"}, {"type": "subtitle", "time": 9499.429, "timestamp": "02:38:19", "text": "每当那时，我都会想起这件事。"}, {"type": "subtitle", "time": 9503.03, "timestamp": "02:38:23", "text": "人真的太好了。"}, {"type": "subtitle", "time": 9507.19, "timestamp": "02:38:27", "text": "我记得你发过推特，或者也许"}, {"type": "subtitle", "time": 9509.59, "timestamp": "02:38:29", "text": "宣布一些你知道的事情"}, {"type": "subtitle", "time": 9513.19, "timestamp": "02:38:33", "text": "当你玩游戏的时候，嗯……我不知道"}, {"type": "subtitle", "time": 9515.11, "timestamp": "02:38:35", "text": "各种各样的游戏"}, {"type": "subtitle", "time": 9517.27, "timestamp": "02:38:37", "text": "如果觉得无聊或者其他什么原因，你就会坚持下去。"}, {"type": "subtitle", "time": 9520.55, "timestamp": "02:38:40", "text": "拥有某种特定的利基权利"}, {"type": "subtitle", "time": 9525.429, "timestamp": "02:38:45", "text": "那时就像西方和她的代码呃"}, {"type": "subtitle", "time": 9528.71, "timestamp": "02:38:48", "text": "我记得你当时发过帖子"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "关于它就像"}, {"type": "subtitle", "time": 9535.429, "timestamp": "02:38:55", "text": "呃，为什么多样化对某些人来说行不通呢？"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "你，你或许真的会选择"}, {"type": "subtitle", "time": 9539.19, "timestamp": "02:38:59", "text": "某物"}]
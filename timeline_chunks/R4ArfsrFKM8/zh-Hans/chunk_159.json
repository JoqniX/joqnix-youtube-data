[{"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "呃，就像玩一局游戏看看效果如何。"}, {"type": "subtitle", "time": 9546.87, "timestamp": "02:39:06", "text": "一切都会过去。是吗？是吗？"}, {"type": "subtitle", "time": 9550.23, "timestamp": "02:39:10", "text": "红色的？我不知道。不，是我回来了。"}, {"type": "subtitle", "time": 9551.79, "timestamp": "02:39:11", "text": "然后我"}, {"type": "subtitle", "time": 9555.27, "timestamp": "02:39:15", "text": "拉古尔成了我的新名字，就像……"}, {"type": "subtitle", "time": 9559.51, "timestamp": "02:39:19", "text": "今年早些时候。所以我仍然落后。"}, {"type": "subtitle", "time": 9563.349, "timestamp": "02:39:23", "text": "去年。嗯，我想是的，我肯定有"}, {"type": "subtitle", "time": 9565.59, "timestamp": "02:39:25", "text": "我对此发表了评论，而且我相信"}, {"type": "subtitle", "time": 9569.03, "timestamp": "02:39:29", "text": "我呃呃进入了战地系列的细分领域。"}, {"type": "subtitle", "time": 9571.83, "timestamp": "02:39:31", "text": "当时就有一个。所以，我为什么会这样呢？"}, {"type": "subtitle", "time": 9574.309, "timestamp": "02:39:34", "text": "进入《战地1》、《战地5》"}, {"type": "subtitle", "time": 9576.95, "timestamp": "02:39:36", "text": "一切？嗯。"}, {"type": "subtitle", "time": 9579.03, "timestamp": "02:39:39", "text": "是的。"}, {"type": "subtitle", "time": 9582.95, "timestamp": "02:39:42", "text": "哦，结果如何？事情大概就是这样。"}, {"type": "subtitle", "time": 9586.23, "timestamp": "02:39:46", "text": "一切都很顺利，直到情况开始恶化。"}, {"type": "subtitle", "time": 9589.27, "timestamp": "02:39:49", "text": "我学到了一些东西，那就是我"}, {"type": "subtitle", "time": 9592.309, "timestamp": "02:39:52", "text": "因为……我对自己要求太高了。"}, {"type": "subtitle", "time": 9597.27, "timestamp": "02:39:57", "text": "这一点，嗯，每次直播我都会剪辑。"}]
[{"type": "subtitle", "time": 2642.95, "timestamp": "00:44:02", "text": "超级。这种情况持续了一段时间，因为"}, {"type": "subtitle", "time": 2646.23, "timestamp": "00:44:06", "text": "我想为流媒体做点什么。"}, {"type": "subtitle", "time": 2656.23, "timestamp": "00:44:16", "text": "我不知道。超模型很容易"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "例如用于 Hyper 应用之外的流媒体播放。"}, {"type": "subtitle", "time": 2663.109, "timestamp": "00:44:23", "text": "不，感觉就像这个超级应用有一个"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "现在可以使用虚拟摄像头了。这样你就可以连接了"}, {"type": "subtitle", "time": 2669.51, "timestamp": "00:44:29", "text": "把它导入 OBS，然后它就可以在那里了。"}, {"type": "subtitle", "time": 2673.03, "timestamp": "00:44:33", "text": "永远。哦，真好，真好，真好。但是"}, {"type": "subtitle", "time": 2675.03, "timestamp": "00:44:35", "text": "唯一的问题是你无法获得你的"}, {"type": "chat", "time": 2675.621, "timestamp": "00:44:35", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "hyper also got Hand Motion Capture"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "模型脱离超空间，这限制了"}, {"type": "subtitle", "time": 2681.349, "timestamp": "00:44:41", "text": "很多事"}, {"type": "subtitle", "time": 2683.67, "timestamp": "00:44:43", "text": "因为超高速赋予的特性是"}, {"type": "subtitle", "time": 2688.23, "timestamp": "00:44:48", "text": "非常有限。所以我不得不努力工作。"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "往那边走。还有这些表达方式。"}, {"type": "subtitle", "time": 2694.95, "timestamp": "00:44:54", "text": "没说到点子上之类的。"}, {"type": "subtitle", "time": 2698.349, "timestamp": "00:44:58", "text": "嗯。哦，看来他们有手势动作"}]
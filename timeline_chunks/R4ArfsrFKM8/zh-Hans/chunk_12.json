[{"type": "subtitle", "time": 724.71, "timestamp": "00:12:04", "text": "想知道。嗯，我会尽可能久地待在这里。"}, {"type": "subtitle", "time": 726.55, "timestamp": "00:12:06", "text": "这大概是我最后一次看直播了。"}, {"type": "subtitle", "time": 728.35, "timestamp": "00:12:08", "text": "需要注意的"}, {"type": "subtitle", "time": 731.629, "timestamp": "00:12:11", "text": "尽管。希望你"}, {"type": "subtitle", "time": 738.35, "timestamp": "00:12:18", "text": "那？戳"}, {"type": "subtitle", "time": 749.269, "timestamp": "00:12:29", "text": "跳。跳。你跳过去。你跳"}, {"type": "subtitle", "time": 752.35, "timestamp": "00:12:32", "text": "那里。跳到那儿去。去"}, {"type": "subtitle", "time": 757.99, "timestamp": "00:12:37", "text": "向上。跳。啊。失败。好的。你跳了起来。"}, {"type": "subtitle", "time": 762.069, "timestamp": "00:12:42", "text": "跳。慢的。跳。长的。短的。跳。"}, {"type": "subtitle", "time": 765.79, "timestamp": "00:12:45", "text": "失败。好的。蹿。慢的"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "跳。跳。是的。啊。我一直在做"}, {"type": "subtitle", "time": 772.509, "timestamp": "00:12:52", "text": "制作"}, {"type": "subtitle", "time": 779.35, "timestamp": "00:12:59", "text": "向下。如果我进行耐力测试呢？"}]
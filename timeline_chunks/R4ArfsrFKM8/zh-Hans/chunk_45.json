[{"type": "subtitle", "time": 2701.99, "timestamp": "00:45:01", "text": "也进行跟踪。即使对于这个型号，我"}, {"type": "subtitle", "time": 2706.55, "timestamp": "00:45:06", "text": "具有手部动作跟踪RCS。啊，是的"}, {"type": "subtitle", "time": 2709.349, "timestamp": "00:45:09", "text": "我在首播直播中确实这么做了"}, {"type": "subtitle", "time": 2712.47, "timestamp": "00:45:12", "text": "它拥有良好的面部表情，"}, {"type": "subtitle", "time": 2715.27, "timestamp": "00:45:15", "text": "它有运动追踪之类的功能。"}, {"type": "subtitle", "time": 2717.43, "timestamp": "00:45:17", "text": "等等，你是用摄像头还是iPhone？"}, {"type": "subtitle", "time": 2718.95, "timestamp": "00:45:18", "text": "你买Leap Motion是为了什么？"}, {"type": "subtitle", "time": 2721.829, "timestamp": "00:45:21", "text": "手部追踪？不，不。呃，你喜欢吗？"}, {"type": "subtitle", "time": 2725.23, "timestamp": "00:45:25", "text": "只能通过摄像头吗？啊，网络摄像头。好的。"}, {"type": "subtitle", "time": 2728.47, "timestamp": "00:45:28", "text": "好的。我认识一个朋友，他有Leap。"}, {"type": "chat", "time": 2731.981, "timestamp": "00:45:31", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "no like hyper has it built in you to use external software for vroids"}, {"type": "subtitle", "time": 2732.069, "timestamp": "00:45:32", "text": "使用手部追踪功能的人的动作。"}, {"type": "subtitle", "time": 2734.63, "timestamp": "00:45:34", "text": "我一直计划着要像某些人那样。"}, {"type": "subtitle", "time": 2738.63, "timestamp": "00:45:38", "text": "东西什么的都有，但我现在没钱了。"}, {"type": "subtitle", "time": 2741.109, "timestamp": "00:45:41", "text": "现在不行了。"}, {"type": "subtitle", "time": 2743.99, "timestamp": "00:45:43", "text": "捣毁了一个团伙。我们走吧。破产帮派"}, {"type": "subtitle", "time": 2752.79, "timestamp": "00:45:52", "text": "您是否使用外部软件进行作废处理？"}, {"type": "subtitle", "time": 2756.23, "timestamp": "00:45:56", "text": "是的，Hyper 内置了这项功能，但是……"}, {"type": "subtitle", "time": 2759.43, "timestamp": "00:45:59", "text": "使用方式也类似于内置的 va 功能。所以"}]
[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "正如你所看到的，她是该模特的首发新帖。"}, {"type": "subtitle", "time": 12784.87, "timestamp": "03:33:04", "text": "这位模特于7月12日首次亮相，对吧？"}, {"type": "subtitle", "time": 12786.349, "timestamp": "03:33:06", "text": "即将拥有一个新的"}, {"type": "subtitle", "time": 12790.07, "timestamp": "03:33:10", "text": "她加入后会担任模特，因为她是"}, {"type": "subtitle", "time": 12793.429, "timestamp": "03:33:13", "text": "公开宣布她已经"}, {"type": "subtitle", "time": 12796.309, "timestamp": "03:33:16", "text": "她加入了Gristas，所以她将会……"}, {"type": "subtitle", "time": 12799.229, "timestamp": "03:33:19", "text": "加入模式对吗？那是"}, {"type": "subtitle", "time": 12801.91, "timestamp": "03:33:21", "text": "这将是她首秀的曲目。"}, {"type": "subtitle", "time": 12803.83, "timestamp": "03:33:23", "text": "溪流。正确的？以下是主要内容。"}, {"type": "subtitle", "time": 12807.03, "timestamp": "03:33:27", "text": "为了保证透明度，她列出了以下事项。"}, {"type": "subtitle", "time": 12809.59, "timestamp": "03:33:29", "text": "呃，这就是油管博主们一直以来都会做的事。"}, {"type": "subtitle", "time": 12813.11, "timestamp": "03:33:33", "text": "自从那个ni Sanji u Kurosanji的东西"}, {"type": "subtitle", "time": 12815.349, "timestamp": "03:33:35", "text": "一切都很好。新兴机构"}, {"type": "subtitle", "time": 12819.349, "timestamp": "03:33:39", "text": "将会，将会像做这件事一样"}, {"type": "subtitle", "time": 12822.55, "timestamp": "03:33:42", "text": "品牌形象之类的东西，嗯，为了透明度。"}, {"type": "subtitle", "time": 12824.63, "timestamp": "03:33:44", "text": "这样人们就能知道，是的，我们是"}, {"type": "subtitle", "time": 12827.429, "timestamp": "03:33:47", "text": "合法之类的。这更像是一种"}, {"type": "subtitle", "time": 12829.99, "timestamp": "03:33:49", "text": "推荐给新成立机构的策略"}, {"type": "subtitle", "time": 12832.63, "timestamp": "03:33:52", "text": "以及其他创业机构，比如你"}, {"type": "subtitle", "time": 12835.99, "timestamp": "03:33:55", "text": "可以看到西方这样做是因为"}, {"type": "subtitle", "time": 12839.91, "timestamp": "03:33:59", "text": "机构内部纷争等事件引发的反弹"}]
[{"type": "subtitle", "time": 14041.83, "timestamp": "03:54:01", "text": "呃，是为了出人头地，对吧？"}, {"type": "subtitle", "time": 14044.75, "timestamp": "03:54:04", "text": "就像那样运作"}, {"type": "chat", "time": 14045.016, "timestamp": "03:54:05", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hahah"}, {"type": "subtitle", "time": 14048.63, "timestamp": "03:54:08", "text": "那是因为到头来，这并不容易。"}, {"type": "subtitle", "time": 14051.83, "timestamp": "03:54:11", "text": "无论你是否加入"}, {"type": "subtitle", "time": 14054.389, "timestamp": "03:54:14", "text": "一家已经建立起这种机制的机构"}, {"type": "subtitle", "time": 14057.83, "timestamp": "03:54:17", "text": "还有一些事情你不能说“是啊，我是……”"}, {"type": "subtitle", "time": 14059.75, "timestamp": "03:54:19", "text": "我打算加入一家代理机构。"}, {"type": "subtitle", "time": 14061.59, "timestamp": "03:54:21", "text": "我要获得更多观众"}, {"type": "subtitle", "time": 14065.03, "timestamp": "03:54:25", "text": "百万，呃，有很多快速聊天很多"}, {"type": "subtitle", "time": 14067.59, "timestamp": "03:54:27", "text": "会有人捐款等等，不，是的"}, {"type": "subtitle", "time": 14070.07, "timestamp": "03:54:30", "text": "不会那样，你会的"}, {"type": "subtitle", "time": 14072.59, "timestamp": "03:54:32", "text": "面临大量巨大的"}, {"type": "subtitle", "time": 14075.429, "timestamp": "03:54:35", "text": "压力。来自管理层的压力"}, {"type": "subtitle", "time": 14077.99, "timestamp": "03:54:37", "text": "网络压力，压力"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "来自你的同龄朋友。呃，点对点"}, {"type": "subtitle", "time": 14085.429, "timestamp": "03:54:45", "text": "是的。同辈压力之类的。更像是"}, {"type": "subtitle", "time": 14088.15, "timestamp": "03:54:48", "text": "他们这是在给你施加同辈压力。"}, {"type": "subtitle", "time": 14090.95, "timestamp": "03:54:50", "text": "更像是你会和某人发生点什么。"}, {"type": "subtitle", "time": 14094.87, "timestamp": "03:54:54", "text": "你心里想的好像我不好。我不能"}, {"type": "subtitle", "time": 14097.269, "timestamp": "03:54:57", "text": "赶上我的同龄人或者其他什么人"}]
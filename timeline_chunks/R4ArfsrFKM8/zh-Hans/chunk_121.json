[{"type": "subtitle", "time": 7262.629, "timestamp": "02:01:02", "text": "以前经常对着麦克风说话之类的。我"}, {"type": "subtitle", "time": 7264.39, "timestamp": "02:01:04", "text": "知道。"}, {"type": "subtitle", "time": 7267.109, "timestamp": "02:01:07", "text": "是的。我以前很喜欢你的作品。"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "也。真是太疯狂了。我认为你是"}, {"type": "subtitle", "time": 7274.95, "timestamp": "02:01:14", "text": "以前只有一个，呃，就像那样"}, {"type": "subtitle", "time": 7278.149, "timestamp": "02:01:18", "text": "嗯，那个叫什么来着……呃……主播"}, {"type": "subtitle", "time": 7281.27, "timestamp": "02:01:21", "text": "机器人萨米·莱奥布的东西，你还记得吗？"}, {"type": "subtitle", "time": 7284.07, "timestamp": "02:01:24", "text": "触摸传送门相关的东西以及所有这些东西"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "确实完成了，呃，是主播机器人，但是呃"}, {"type": "subtitle", "time": 7289.83, "timestamp": "02:01:29", "text": "你发的不是精简的板子吗？"}, {"type": "subtitle", "time": 7292.149, "timestamp": "02:01:32", "text": "就是那些用“哦耶耶瘦身”的人。"}, {"type": "subtitle", "time": 7295.83, "timestamp": "02:01:35", "text": "板子 Sammy 是的是的，我只做了"}, {"type": "subtitle", "time": 7298.229, "timestamp": "02:01:38", "text": "主播机器人 主播机器人和触摸"}, {"type": "subtitle", "time": 7302.229, "timestamp": "02:01:42", "text": "照片，我的天哪！哇，太疯狂了。哦"}, {"type": "subtitle", "time": 7304.55, "timestamp": "02:01:44", "text": "是啊，简直太疯狂了。"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "我做过的事。是的，还有那个"}, {"type": "subtitle", "time": 7311.35, "timestamp": "02:01:51", "text": "Figma动画以及你所做的一切"}, {"type": "subtitle", "time": 7314.39, "timestamp": "02:01:54", "text": "就像你的场景一样。你曾是"}, {"type": "subtitle", "time": 7317.91, "timestamp": "02:01:57", "text": "头脑风暴之类的，真的很有趣。"}]
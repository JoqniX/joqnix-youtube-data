[{"type": "subtitle", "time": 14281.99, "timestamp": "03:58:01", "text": "执行原理等等。你不是"}, {"type": "subtitle", "time": 14285.189, "timestamp": "03:58:05", "text": "一个引导他人并告诉他们你"}, {"type": "subtitle", "time": 14287.83, "timestamp": "03:58:07", "text": "必须做这做那，要专业。"}, {"type": "subtitle", "time": 14290.87, "timestamp": "03:58:10", "text": "等等等等，诸如此类的事情。所以"}, {"type": "subtitle", "time": 14294.469, "timestamp": "03:58:14", "text": "这也适用于我，对吗？我 我 我"}, {"type": "subtitle", "time": 14297.15, "timestamp": "03:58:17", "text": "展示很多"}, {"type": "subtitle", "time": 14300.269, "timestamp": "03:58:20", "text": "呃，很多"}, {"type": "subtitle", "time": 14303.15, "timestamp": "03:58:23", "text": "嗯，很多"}, {"type": "subtitle", "time": 14307.03, "timestamp": "03:58:27", "text": "呃，什么？怎么说来着？正直。不"}, {"type": "subtitle", "time": 14312.229, "timestamp": "03:58:32", "text": "呃呃，脆弱的脆弱的东西，哪个"}, {"type": "subtitle", "time": 14315.429, "timestamp": "03:58:35", "text": "可能是不必要的，而且太……"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "很多很多东西。所以这表明"}, {"type": "subtitle", "time": 14321.59, "timestamp": "03:58:41", "text": "我方缺乏专业精神"}, {"type": "subtitle", "time": 14324.95, "timestamp": "03:58:44", "text": "事情就是这样，对吧？即使有客人在场，"}, {"type": "subtitle", "time": 14328.269, "timestamp": "03:58:48", "text": "东西，我有点过度了"}, {"type": "subtitle", "time": 14331.11, "timestamp": "03:58:51", "text": "解释得过于夸张，而且太多了。"}, {"type": "subtitle", "time": 14333.189, "timestamp": "03:58:53", "text": "和我的东西。我不知道。我不得不"}, {"type": "subtitle", "time": 14336.469, "timestamp": "03:58:56", "text": "比如向他们展示我即将推出的模型，或者"}, {"type": "subtitle", "time": 14338.55, "timestamp": "03:58:58", "text": "给客人的东西和一些其他的东西"}]
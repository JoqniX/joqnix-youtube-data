[{"type": "subtitle", "time": 14460.07, "timestamp": "04:01:00", "text": "某个机构打开了我的一个"}, {"type": "subtitle", "time": 14463.269, "timestamp": "04:01:03", "text": "观众或者碰巧有人加入了他们"}, {"type": "subtitle", "time": 14466.389, "timestamp": "04:01:06", "text": "还有其他一些东西，他们无法控制自己的情绪。"}, {"type": "subtitle", "time": 14468.55, "timestamp": "04:01:08", "text": "他们闭口不谈自己是某个机构的人"}, {"type": "subtitle", "time": 14470.469, "timestamp": "04:01:10", "text": "或者展示商场之类的东西"}, {"type": "subtitle", "time": 14472.07, "timestamp": "04:01:12", "text": "他们的朋友或者其他什么东西"}, {"type": "subtitle", "time": 14474.63, "timestamp": "04:01:14", "text": "违反保密协议和多重合同"}, {"type": "subtitle", "time": 14478.349, "timestamp": "04:01:18", "text": "公司政策以及一切都正确"}, {"type": "subtitle", "time": 14482.469, "timestamp": "04:01:22", "text": "是啊，我不想那样，万一他们……"}, {"type": "subtitle", "time": 14485.189, "timestamp": "04:01:25", "text": "怪我，如果他们在玩游戏呢？哦，乔"}, {"type": "subtitle", "time": 14488.189, "timestamp": "04:01:28", "text": "他在直播中做了这件事"}, {"type": "subtitle", "time": 14491.189, "timestamp": "04:01:31", "text": "东西。是的。诸如此类的事情还有很多。"}, {"type": "subtitle", "time": 14493.75, "timestamp": "04:01:33", "text": "影响因素太多了。"}, {"type": "subtitle", "time": 14497.11, "timestamp": "04:01:37", "text": "也许我想太多了，但话说回来，是的。"}, {"type": "subtitle", "time": 14499.349, "timestamp": "04:01:39", "text": "当你……的时候，你必须注意如何"}, {"type": "chat", "time": 14501.104, "timestamp": "04:01:41", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Its crazy to hold back when your streaming"}, {"type": "subtitle", "time": 14502.389, "timestamp": "04:01:42", "text": "你自我介绍一下"}, {"type": "subtitle", "time": 14505.309, "timestamp": "04:01:45", "text": "这很重要。这就是我的意思"}, {"type": "subtitle", "time": 14508.309, "timestamp": "04:01:48", "text": "当然，作为一名独立人士，我明白这一点。"}, {"type": "subtitle", "time": 14510.389, "timestamp": "04:01:50", "text": "你总能随心所欲地做任何事"}, {"type": "subtitle", "time": 14511.389, "timestamp": "04:01:51", "text": "想要"}, {"type": "subtitle", "time": 14513.95, "timestamp": "04:01:53", "text": "做。"}, {"type": "subtitle", "time": 14517.59, "timestamp": "04:01:57", "text": "但别忘了，还有人存在。"}, {"type": "chat", "time": 14518.982, "timestamp": "04:01:58", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "but didn't spiderman did that alot 🤔 it's all about what's the best way to promote or get money"}]
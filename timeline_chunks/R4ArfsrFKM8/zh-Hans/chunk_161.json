[{"type": "subtitle", "time": 9660.309, "timestamp": "02:41:00", "text": "是的，帕特是个好人。你会"}, {"type": "subtitle", "time": 9663.87, "timestamp": "02:41:03", "text": "总会在那里徘徊。"}, {"type": "subtitle", "time": 9666.87, "timestamp": "02:41:06", "text": "是的。后面有好多人。"}, {"type": "subtitle", "time": 9669.349, "timestamp": "02:41:09", "text": "就像以前那样在幕后运作。"}, {"type": "subtitle", "time": 9673.91, "timestamp": "02:41:13", "text": "是的。是的。是的。你会想念他们吗？"}, {"type": "subtitle", "time": 9676.71, "timestamp": "02:41:16", "text": "你会回头看吗？你是否怀念被抓的感觉？"}, {"type": "subtitle", "time": 9687.309, "timestamp": "02:41:27", "text": "螺旋桨？是的。但是，是的，当你看"}, {"type": "subtitle", "time": 9690.309, "timestamp": "02:41:30", "text": "回来，你喜欢我直播吗？"}, {"type": "subtitle", "time": 9693.03, "timestamp": "02:41:33", "text": "Vtubing，或者你喜欢做你这样的人，"}, {"type": "subtitle", "time": 9695.11, "timestamp": "02:41:35", "text": "“是啊，我随时都可以回来。"}, {"type": "subtitle", "time": 9701.309, "timestamp": "02:41:41", "text": "那。"}, {"type": "subtitle", "time": 9705.07, "timestamp": "02:41:45", "text": "我不太确定。"}, {"type": "subtitle", "time": 9707.99, "timestamp": "02:41:47", "text": "嗯，我确实很怀念以前的数量……"}, {"type": "subtitle", "time": 9711.99, "timestamp": "02:41:51", "text": "我当时对它的热爱"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "我投入了大量时间"}, {"type": "subtitle", "time": 9715.83, "timestamp": "02:41:55", "text": "学习新事物等等。和"}, {"type": "subtitle", "time": 9717.67, "timestamp": "02:41:57", "text": "这是我值得称赞的一点。"}, {"type": "subtitle", "time": 9719.99, "timestamp": "02:41:59", "text": "比如尝试所有这些不同的工具，"}]
[{"type": "subtitle", "time": 1441.71, "timestamp": "00:24:01", "text": "这东西真的存在过吗？"}, {"type": "subtitle", "time": 1444.83, "timestamp": "00:24:04", "text": "你好。等等，你可以这样做"}, {"type": "subtitle", "time": 1448.87, "timestamp": "00:24:08", "text": "那。所以，我不用去了。等等，我"}, {"type": "subtitle", "time": 1451.87, "timestamp": "00:24:11", "text": "感觉我应该去"}, {"type": "subtitle", "time": 1461.11, "timestamp": "00:24:21", "text": "怙。下午5:30 Helixan 流。得到"}, {"type": "subtitle", "time": 1463.909, "timestamp": "00:24:23", "text": "它。明白了。谢谢你，祖基。"}, {"type": "subtitle", "time": 1466.39, "timestamp": "00:24:26", "text": "转换时间。那真是一段漫长的时光"}, {"type": "subtitle", "time": 1470.149, "timestamp": "00:24:30", "text": "跳。没关系。我们能做到。哦，"}, {"type": "subtitle", "time": 1473.39, "timestamp": "00:24:33", "text": "不。我们做不到。它是"}, {"type": "subtitle", "time": 1475.87, "timestamp": "00:24:35", "text": "美好的。完全"}, {"type": "subtitle", "time": 1478.51, "timestamp": "00:24:38", "text": "美好的。我们砰砰"}, {"type": "subtitle", "time": 1486.47, "timestamp": "00:24:46", "text": "做不到。它涵盖了大部分内容"}, {"type": "subtitle", "time": 1489.95, "timestamp": "00:24:49", "text": "全屏显示。是的，我注意到了"}, {"type": "subtitle", "time": 1494.39, "timestamp": "00:24:54", "text": "那。 H 所以"}, {"type": "subtitle", "time": 1498.71, "timestamp": "00:24:58", "text": "嗯，就像我……嗯，没有媒体。"}]
[{"type": "subtitle", "time": 4922.39, "timestamp": "01:22:02", "text": "耶！你看，就连面包也符合这个原则。"}, {"type": "subtitle", "time": 4934.95, "timestamp": "01:22:14", "text": "上帝。好多表情包。我有个呃……"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "我不理解我自己或"}, {"type": "subtitle", "time": 4940.39, "timestamp": "01:22:20", "text": "某物。我不明白。就像……"}, {"type": "subtitle", "time": 4943.99, "timestamp": "01:22:23", "text": "我是那种在人群中显得格格不入的人。"}, {"type": "subtitle", "time": 4945.91, "timestamp": "01:22:25", "text": "就像你小时候那样，或者就像……"}, {"type": "subtitle", "time": 4947.35, "timestamp": "01:22:27", "text": "你还在上幼儿园，看着汤姆和"}, {"type": "subtitle", "time": 4949.35, "timestamp": "01:22:29", "text": "杰瑞，他们都笑了，对吧？我就是这么古怪。"}, {"type": "subtitle", "time": 4951.189, "timestamp": "01:22:31", "text": "一个不笑，只是盯着看的人"}, {"type": "subtitle", "time": 4954.629, "timestamp": "01:22:34", "text": "关于汤姆的复杂事情"}, {"type": "subtitle", "time": 4956.95, "timestamp": "01:22:36", "text": "为什么？为什么大家都在笑？"}, {"type": "subtitle", "time": 4959.43, "timestamp": "01:22:39", "text": "为什么会有人群噪音？为什么是"}, {"type": "subtitle", "time": 4962.47, "timestamp": "01:22:42", "text": "那是什么声音？这是什么景色？"}, {"type": "subtitle", "time": 4965.79, "timestamp": "01:22:45", "text": "这样那样？那是"}, {"type": "subtitle", "time": 4970.47, "timestamp": "01:22:50", "text": "我。我的天啊。你擅长制作表情包吗？"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "呃，老实说我不知道​​，但我确实"}, {"type": "subtitle", "time": 4976.229, "timestamp": "01:22:56", "text": "能认出很多梗图之类的东西。所以，"}, {"type": "subtitle", "time": 4979.43, "timestamp": "01:22:59", "text": "我觉得自己很漂亮，就像我不活着一样。"}]
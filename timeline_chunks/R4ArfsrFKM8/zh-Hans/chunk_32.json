[{"type": "subtitle", "time": 1922.71, "timestamp": "00:32:02", "text": "今天是第二周了。是的。经过"}, {"type": "subtitle", "time": 1924.63, "timestamp": "00:32:04", "text": "下周六，我将完成……"}, {"type": "subtitle", "time": 1926.47, "timestamp": "00:32:06", "text": "全部"}, {"type": "subtitle", "time": 1929.43, "timestamp": "00:32:09", "text": "嗯，是的。 6月21日，我将完成"}, {"type": "subtitle", "time": 1931.99, "timestamp": "00:32:11", "text": "把所有合作项目都搞定了。"}, {"type": "subtitle", "time": 1933.83, "timestamp": "00:32:13", "text": "该死。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "是的。我想我……嗯……我不……"}, {"type": "chat", "time": 1938.205, "timestamp": "00:32:18", "author": "@zephyrus7974", "avatar": "https://yt4.ggpht.com/JfzO9yJBgCTwx5iYOuRpHQTwEbH4a2nVduwoOVSVWWNy2uJtEuLnjZgYThfjnaNLUkzG5JOf=s64-c-k-c0x00ffffff-no-rj", "message": "im getting an ad for an adblocker"}, {"type": "subtitle", "time": 1940.43, "timestamp": "00:32:20", "text": "不知道我会待多久"}, {"type": "subtitle", "time": 1944.23, "timestamp": "00:32:24", "text": "正在做。我希望在那天结束这一切。"}, {"type": "subtitle", "time": 1946.63, "timestamp": "00:32:26", "text": "不得不收拾行李离开之类的。"}, {"type": "subtitle", "time": 1948.95, "timestamp": "00:32:28", "text": "因为我现在很无聊。"}, {"type": "subtitle", "time": 1951.59, "timestamp": "00:32:31", "text": "我就像，呃，我就像，我这样做是为了"}, {"type": "subtitle", "time": 1955.509, "timestamp": "00:32:35", "text": "24小时。我心想，呃，我不想……"}, {"type": "subtitle", "time": 1958.87, "timestamp": "00:32:38", "text": "保持不动。我只想四处游荡，然后带走"}, {"type": "subtitle", "time": 1962.07, "timestamp": "00:32:42", "text": "和大家一起享受当下。"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "是的。是的。所以我就说，好啊，我去。"}, {"type": "subtitle", "time": 1969.35, "timestamp": "00:32:49", "text": "一直到我能结束这一切为止。我愿意"}, {"type": "subtitle", "time": 1971.19, "timestamp": "00:32:51", "text": "不过还是想以一个好数字结尾。"}, {"type": "subtitle", "time": 1974.63, "timestamp": "00:32:54", "text": "大概100个左右吧。今天是第89天。"}, {"type": "subtitle", "time": 1978.389, "timestamp": "00:32:58", "text": "明天就90度了。真的。是的。还有10个"}]
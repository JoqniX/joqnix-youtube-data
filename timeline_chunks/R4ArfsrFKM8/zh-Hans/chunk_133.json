[{"type": "subtitle", "time": 7984.47, "timestamp": "02:13:04", "text": "Stream PC 呃 50 5600X 和呃 Ryzen 5"}, {"type": "subtitle", "time": 7988.39, "timestamp": "02:13:08", "text": "5600X 和 1660 之类的"}, {"type": "subtitle", "time": 7992.069, "timestamp": "02:13:12", "text": "升级版的20系或30系之类的"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "GPU桌面，我当时就想……"}, {"type": "subtitle", "time": 7997.189, "timestamp": "02:13:17", "text": "然后我就想，哦，如果我要……"}, {"type": "subtitle", "time": 7999.27, "timestamp": "02:13:19", "text": "最终我还是需要一台笔记本电脑。"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "现在。我买台笔记本电脑不是更好吗？"}, {"type": "subtitle", "time": 8003.35, "timestamp": "02:13:23", "text": "对我来说，运输会很困难。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "一切顺利的话，日本那边还需要一段时间。"}, {"type": "subtitle", "time": 8009.189, "timestamp": "02:13:29", "text": "很难，因为这里也是宿舍，我必须……"}, {"type": "subtitle", "time": 8011.99, "timestamp": "02:13:31", "text": "六个月后搬出去，或者如果我想搬出去的话"}, {"type": "subtitle", "time": 8014.709, "timestamp": "02:13:34", "text": "我可以留下，也可以搬出去。"}, {"type": "subtitle", "time": 8022.069, "timestamp": "02:13:42", "text": "所以我决定从……买这台笔记本电脑"}, {"type": "subtitle", "time": 8026.229, "timestamp": "02:13:46", "text": "日本，但大家都说买它是"}, {"type": "subtitle", "time": 8028.069, "timestamp": "02:13:48", "text": "最好从日本购买，而不是"}, {"type": "subtitle", "time": 8032.149, "timestamp": "02:13:52", "text": "我来自印度，所以我就想，好吧，我试试。"}, {"type": "subtitle", "time": 8034.39, "timestamp": "02:13:54", "text": "那。你怎么认为？这样做更好吗？"}]
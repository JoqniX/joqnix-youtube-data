[{"type": "subtitle", "time": 3061.43, "timestamp": "00:51:01", "text": "然后我就被那东西扇了一巴掌。"}, {"type": "subtitle", "time": 3065.589, "timestamp": "00:51:05", "text": "冰层很厚，我的脸都冻红了。哦，它"}, {"type": "subtitle", "time": 3067.99, "timestamp": "00:51:07", "text": "感觉就像有三个朋友一样。"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "我的。我们玩是因为我们喜欢"}, {"type": "subtitle", "time": 3071.99, "timestamp": "00:51:11", "text": "第一次看到，对吧？所以他"}, {"type": "subtitle", "time": 3073.75, "timestamp": "00:51:13", "text": "从某个地方捡到了一块随机的冰块。"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "我们不知从何而来，然后就开始互相搭讪。"}, {"type": "subtitle", "time": 3078.309, "timestamp": "00:51:18", "text": "另一个，然后还有一个人，他直接就……"}, {"type": "subtitle", "time": 3082.549, "timestamp": "00:51:22", "text": "向上抛出一个球，像一个大雪球"}, {"type": "subtitle", "time": 3084.79, "timestamp": "00:51:24", "text": "然后它落在了我的脸上，我的"}, {"type": "subtitle", "time": 3086.549, "timestamp": "00:51:26", "text": "脸颊通红，但我感觉不到它的存在。"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "因为麻木，然后我想……"}, {"type": "subtitle", "time": 3092.23, "timestamp": "00:51:32", "text": "我骂他了，兄弟，你也是这样吗？"}, {"type": "subtitle", "time": 3095.109, "timestamp": "00:51:35", "text": "头脑清醒，我受伤了，你和"}, {"type": "subtitle", "time": 3097.589, "timestamp": "00:51:37", "text": "糟糕的是，我刚刚……"}, {"type": "subtitle", "time": 3101.99, "timestamp": "00:51:41", "text": "大概两周前戴上了牙套，所以……"}, {"type": "subtitle", "time": 3104.63, "timestamp": "00:51:44", "text": "我当时正感到疼痛，然后那家伙就打了我。我"}, {"type": "subtitle", "time": 3107.349, "timestamp": "00:51:47", "text": "气死了。我的天啊。他打你了？"}, {"type": "subtitle", "time": 3109.829, "timestamp": "00:51:49", "text": "什么？他甚至都没吃我？是的，他击中了"}, {"type": "subtitle", "time": 3111.829, "timestamp": "00:51:51", "text": "我拿着球。不。啊，是的。是的。"}, {"type": "subtitle", "time": 3114.79, "timestamp": "00:51:54", "text": "好的。好的。是的。所以，我刚刚就完成了"}, {"type": "subtitle", "time": 3117.19, "timestamp": "00:51:57", "text": "和他一起。我当时就想，“兄弟，得回去了。”"}]
[{"type": "subtitle", "time": 15001.51, "timestamp": "04:10:01", "text": "甚至受委托制作。是啊，就像……"}, {"type": "subtitle", "time": 15003.469, "timestamp": "04:10:03", "text": "还没完成"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "然而。所以，是的，我应该更……"}, {"type": "subtitle", "time": 15009.03, "timestamp": "04:10:09", "text": "尊重我所说的话"}, {"type": "subtitle", "time": 15011.67, "timestamp": "04:10:11", "text": "以及直播中的内容。我当时想：不"}, {"type": "subtitle", "time": 15013.429, "timestamp": "04:10:13", "text": "想太多。我正在做"}, {"type": "subtitle", "time": 15015.59, "timestamp": "04:10:15", "text": "我想要什么我就有什么，但我并不明白"}, {"type": "chat", "time": 15016.97, "timestamp": "04:10:16", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hmm hmm no worries you should"}, {"type": "subtitle", "time": 15017.63, "timestamp": "04:10:17", "text": "这"}, {"type": "subtitle", "time": 15020.71, "timestamp": "04:10:20", "text": "除非我考虑后果，否则后果不堪设想。"}, {"type": "subtitle", "time": 15024.71, "timestamp": "04:10:24", "text": "哦不，这会影响我的未来吗？"}, {"type": "subtitle", "time": 15027.269, "timestamp": "04:10:27", "text": "我与我身边的人的关系"}, {"type": "subtitle", "time": 15029.07, "timestamp": "04:10:29", "text": "想工作"}, {"type": "subtitle", "time": 15031.91, "timestamp": "04:10:31", "text": "就像再次问：什么是什么是什么是什么？"}, {"type": "subtitle", "time": 15033.91, "timestamp": "04:10:33", "text": "我有什么理由要带它来呢？"}, {"type": "subtitle", "time": 15036.83, "timestamp": "04:10:36", "text": "把它全部搞定"}, {"type": "chat", "time": 15038.385, "timestamp": "04:10:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "i"}, {"type": "subtitle", "time": 15039.79, "timestamp": "04:10:39", "text": "不，那就没有"}, {"type": "chat", "time": 15040.697, "timestamp": "04:10:40", "author": "@Surya_VT", "avatar": "h
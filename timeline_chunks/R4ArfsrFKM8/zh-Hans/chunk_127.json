[{"type": "subtitle", "time": 7620.55, "timestamp": "02:07:00", "text": "最多？你一直在做什么菜？"}, {"type": "subtitle", "time": 7622.47, "timestamp": "02:07:02", "text": "天？"}, {"type": "subtitle", "time": 7624.95, "timestamp": "02:07:04", "text": "最近在做饭。呃，我一直在做"}, {"type": "subtitle", "time": 7627.669, "timestamp": "02:07:07", "text": "这个 Joathon 是做模型的。我有"}, {"type": "subtitle", "time": 7631.03, "timestamp": "02:07:11", "text": "一款新车型正在研发中。"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "哦真的吗？这很酷。是的，我有一个"}, {"type": "subtitle", "time": 7637.75, "timestamp": "02:07:17", "text": "新车型正在研发中。所以，我就……"}, {"type": "subtitle", "time": 7640.47, "timestamp": "02:07:20", "text": "我得想办法筹集资金。"}, {"type": "subtitle", "time": 7643.109, "timestamp": "02:07:23", "text": "因为我下个月要去日本"}, {"type": "subtitle", "time": 7646.069, "timestamp": "02:07:26", "text": "语言学习。嗯，我会到的。"}, {"type": "subtitle", "time": 7648.79, "timestamp": "02:07:28", "text": "比如21个月，一年，还有n"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "几个月。哦，我还以为会很好呢。"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "呃，因为数量有点太多了。"}, {"type": "subtitle", "time": 7658.709, "timestamp": "02:07:38", "text": "现在2000美元简直就是一笔巨款。"}, {"type": "subtitle", "time": 7662.069, "timestamp": "02:07:42", "text": "那可真不少。是的。你会留下来"}, {"type": "subtitle", "time": 7664.95, "timestamp": "02:07:44", "text": "在那里待了21个月了，然后你"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "回来。真是这样吗？呃，我当时"}, {"type": "subtitle", "time": 7669.629, "timestamp": "02:07:49", "text": "喜欢"}, {"type": "subtitle", "time": 7672.79, "timestamp": "02:07:52", "text": "嗯，其实我不想回来。"}, {"type": "subtitle", "time": 7675.43, "timestamp": "02:07:55", "text": "嗯，我想去那里。我之后"}, {"type": "subtitle", "time": 7677.149, "timestamp": "02:07:57", "text": "语言课程，我只会……"}]
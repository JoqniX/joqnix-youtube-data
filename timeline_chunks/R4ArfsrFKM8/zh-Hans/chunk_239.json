[{"type": "subtitle", "time": 14342.95, "timestamp": "03:59:02", "text": "错误的。我承认了。我没有"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "认真思考，合乎逻辑。我当时就像"}, {"type": "subtitle", "time": 14347.99, "timestamp": "03:59:07", "text": "很高兴，是的，我想……"}, {"type": "chat", "time": 14349.798, "timestamp": "03:59:09", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "lol"}, {"type": "subtitle", "time": 14349.99, "timestamp": "03:59:09", "text": "把这个给我朋友看看。那种"}, {"type": "subtitle", "time": 14352.79, "timestamp": "03:59:12", "text": "东西。但说实话，"}, {"type": "subtitle", "time": 14355.83, "timestamp": "03:59:15", "text": "那是我做过的最愚蠢的事"}, {"type": "subtitle", "time": 14359.67, "timestamp": "03:59:19", "text": "做。任何人都能做到。我的天啊。绝不"}, {"type": "subtitle", "time": 14363.99, "timestamp": "03:59:23", "text": "照做。我以自己为例。我"}, {"type": "subtitle", "time": 14368.67, "timestamp": "03:59:28", "text": "现在我明白了。情况本来会有多糟糕"}, {"type": "subtitle", "time": 14372.15, "timestamp": "03:59:32", "text": "到过。我很高兴我理解了我的"}, {"type": "subtitle", "time": 14374.389, "timestamp": "03:59:34", "text": "错误。我必须确保我这样做"}, {"type": "subtitle", "time": 14376.389, "timestamp": "03:59:36", "text": "不要那样做。"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "我必须确保我不会……嗯……你"}, {"type": "subtitle", "time": 14380.51, "timestamp": "03:59:40", "text": "知道"}, {"type": "subtitle", "time": 14384.63, "timestamp": "03:59:44", "text": "嗯，我得确保我不喜欢……"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "顺其自然，继续做同样的事情。"}, {"type": "subtitle", "time": 14389.189, "timestamp": "03:59:49", "text": "事情就是这样，然后说“哦，我没事，我……”"}, {"type": "subtitle", "time": 14392.469, "timestamp": "03:59:52", "text": "我是专业的，我知道我有，我有"}, {"type": "subtitle", "time": 14394.87, "timestamp": "03:59:54", "text": "经验等等等等，我"}, {"type": "subtitle", "time": 14396.55, "timestamp": "03:59:56", "text": "教导别人时要像“是的，你必须这样做”一样。"}, {"type": "subtitle", "time": 14399.99, "timestamp": "03:59:59", "text": "这和那，而你自己呢？"}]
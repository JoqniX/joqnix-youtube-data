[{"type": "subtitle", "time": 14160.51, "timestamp": "03:56:00", "text": "有太多东西可以看了，"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "正确的？你需要更加谨慎。你"}, {"type": "subtitle", "time": 14167.349, "timestamp": "03:56:07", "text": "不能像这样：“哦，我有空，我可以做……”"}, {"type": "subtitle", "time": 14169.51, "timestamp": "03:56:09", "text": "就是那种“随心所欲”的意思，对吧？"}, {"type": "subtitle", "time": 14171.309, "timestamp": "03:56:11", "text": "不像独立游戏。你有"}, {"type": "subtitle", "time": 14173.15, "timestamp": "03:56:13", "text": "到"}, {"type": "subtitle", "time": 14179.55, "timestamp": "03:56:19", "text": "东西。你必须工作"}, {"type": "subtitle", "time": 14182.79, "timestamp": "03:56:22", "text": "难的。如果就像生活中的一切一样，你拥有"}, {"type": "subtitle", "time": 14185.269, "timestamp": "03:56:25", "text": "付出努力。"}, {"type": "subtitle", "time": 14188.389, "timestamp": "03:56:28", "text": "如果你技能不够熟练，"}, {"type": "subtitle", "time": 14191.269, "timestamp": "03:56:31", "text": "例如，阿米莉亚·沃森，她就不是"}, {"type": "subtitle", "time": 14193.75, "timestamp": "03:56:33", "text": "有足够的唱歌等方面的技能。"}, {"type": "subtitle", "time": 14196.79, "timestamp": "03:56:36", "text": "但她仍然没有放弃那件东西。"}, {"type": "subtitle", "time": 14199.59, "timestamp": "03:56:39", "text": "她的后代们在唱歌跳舞"}, {"type": "subtitle", "time": 14202.07, "timestamp": "03:56:42", "text": "在舞台上，站在舞台上之类的。"}, {"type": "subtitle", "time": 14204.79, "timestamp": "03:56:44", "text": "她也不能在那里，呃，就像"}, {"type": "subtitle", "time": 14207.269, "timestamp": "03:56:47", "text": "像偶像一样唱歌跳舞"}, {"type": "subtitle", "time": 14209.189, "timestamp": "03:56:49", "text": "是她的后代，对吧？她总是不得不"}, {"type": "chat", "time": 14212.299, "timestamp": "03:56:52", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "I mean Hololive must be like next level pressure"}, {"type": "subtitle", "time": 14212.63, "timestamp": "03:56:52", "text": "坐下。但她自己证明了这一点"}, {"type": "subtitle", "time": 14214.469, "timestamp": "03:56:54", "text": "时间。她每天都在练习。"}, {"type": "subtitle", "time": 14218.349, "timestamp": "03:56:58", "text": "她尽了全力。慢慢地"}]
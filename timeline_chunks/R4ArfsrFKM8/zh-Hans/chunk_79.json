[{"type": "subtitle", "time": 4740.63, "timestamp": "01:19:00", "text": "未来会告诉我。耶。嗨，我是"}, {"type": "subtitle", "time": 4743.27, "timestamp": "01:19:03", "text": "我打算等我粉丝达到1000左右的时候做这件事。"}, {"type": "subtitle", "time": 4745.91, "timestamp": "01:19:05", "text": "或者别的什么。我计划做一个小的"}, {"type": "subtitle", "time": 4750.63, "timestamp": "01:19:10", "text": "呃，你知道，就是那种小型卡拉OK。是的。我只是"}, {"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "想玩得开心，就让……"}, {"type": "subtitle", "time": 4756.39, "timestamp": "01:19:16", "text": "我所在社区的人们都过得很开心。所以"}, {"type": "subtitle", "time": 4759.669, "timestamp": "01:19:19", "text": "小型活动之类的。第一次"}, {"type": "subtitle", "time": 4761.91, "timestamp": "01:19:21", "text": "我会照办。我一直在想这件事。所以"}, {"type": "subtitle", "time": 4764.51, "timestamp": "01:19:24", "text": "是的，就是这样。"}, {"type": "subtitle", "time": 4768.79, "timestamp": "01:19:28", "text": "好的。是的。告诉乔，你应该"}, {"type": "subtitle", "time": 4772.27, "timestamp": "01:19:32", "text": "当着她的面说出那个梗。这"}, {"type": "subtitle", "time": 4775.83, "timestamp": "01:19:35", "text": "汁。你想那样做吗？哦，我忘了"}, {"type": "subtitle", "time": 4778.63, "timestamp": "01:19:38", "text": "这条线。哦，"}, {"type": "subtitle", "time": 4781.83, "timestamp": "01:19:41", "text": "他把它写在这里了。"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "聊天。我的天啊。你应该这么做，乔。"}, {"type": "subtitle", "time": 4788.55, "timestamp": "01:19:48", "text": "我们走吧。大家为乔克鼓掌！我们"}, {"type": "subtitle", "time": 4791.95, "timestamp": "01:19:51", "text": "需要它。我们需要大力宣传他。"}]
[{"type": "subtitle", "time": 4320.07, "timestamp": "01:12:00", "text": "K，你最喜欢的音乐是什么？哦，"}, {"type": "subtitle", "time": 4322.07, "timestamp": "01:12:02", "text": "你最喜欢的艺术家是谁？"}, {"type": "subtitle", "time": 4325.91, "timestamp": "01:12:05", "text": "我心想，兄弟，我真的不知道。它是"}, {"type": "subtitle", "time": 4328.31, "timestamp": "01:12:08", "text": "我听音乐就像听放克一样，我听"}, {"type": "subtitle", "time": 4331.31, "timestamp": "01:12:11", "text": "流行乐，我听金属乐，我听……"}, {"type": "subtitle", "time": 4336.31, "timestamp": "01:12:16", "text": "摇滚，我听那些你拉娜·德·瓦伦丁的歌"}, {"type": "subtitle", "time": 4338.63, "timestamp": "01:12:18", "text": "我也听比利·艾伊什的歌"}, {"type": "subtitle", "time": 4341.35, "timestamp": "01:12:21", "text": "周末我也听了那些歌。"}, {"type": "subtitle", "time": 4344.91, "timestamp": "01:12:24", "text": "在宝莱坞，我不听。"}, {"type": "subtitle", "time": 4347.75, "timestamp": "01:12:27", "text": "宝莱坞，但我以前经常听"}, {"type": "subtitle", "time": 4349.35, "timestamp": "01:12:29", "text": "宝莱坞"}, {"type": "subtitle", "time": 4352.43, "timestamp": "01:12:32", "text": "那些老歌，就像2018年那样，"}, {"type": "subtitle", "time": 4355.75, "timestamp": "01:12:35", "text": "2012年那些，但现在最近只是"}, {"type": "subtitle", "time": 4358.27, "timestamp": "01:12:38", "text": "妈的。"}, {"type": "subtitle", "time": 4361.99, "timestamp": "01:12:41", "text": "呃。它更粗俗，而且它只是"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "更多复制和重新像 kuka words 一样"}, {"type": "subtitle", "time": 4369.03, "timestamp": "01:12:49", "text": "毫无道理。所以我不再听了。"}, {"type": "subtitle", "time": 4371.27, "timestamp": "01:12:51", "text": "所有这些"}, {"type": "subtitle", "time": 4374.149, "timestamp": "01:12:54", "text": "独立歌曲。有哪些独立歌曲？哦，"}]
[{"type": "subtitle", "time": 2942.069, "timestamp": "00:49:02", "text": "诸如此类的消息，比如我的"}, {"type": "subtitle", "time": 2944.95, "timestamp": "00:49:04", "text": "项目或者像我即将到来的考试。"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "下周之类的。所以就像"}, {"type": "subtitle", "time": 2952.47, "timestamp": "00:49:12", "text": "日程安排得满满当当，我没有"}, {"type": "subtitle", "time": 2955.43, "timestamp": "00:49:15", "text": "我知道如何管理我的社交生活"}, {"type": "subtitle", "time": 2957.19, "timestamp": "00:49:17", "text": "在直播的同时生活或我的个人"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "生活。所以，我在这方面一直很挣扎。"}, {"type": "subtitle", "time": 2962.309, "timestamp": "00:49:22", "text": "但我心想，好吧，我开始吧。"}, {"type": "subtitle", "time": 2965.03, "timestamp": "00:49:25", "text": "现在即可在线观看。我不能就这么坐着。"}, {"type": "subtitle", "time": 2968.27, "timestamp": "00:49:28", "text": "就让我……呃"}, {"type": "subtitle", "time": 2972.71, "timestamp": "00:49:32", "text": "聊天聊天，即使我不在也能陪着你。"}, {"type": "subtitle", "time": 2975.67, "timestamp": "00:49:35", "text": "是的，我会开始直播。那是"}, {"type": "subtitle", "time": 2977.43, "timestamp": "00:49:37", "text": "好的。"}, {"type": "subtitle", "time": 2979.19, "timestamp": "00:49:39", "text": "等等，喜马偕尔邦怎么样？"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "那玩意儿？你爬过喜马偕尔邦吗？"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "还有别的什么？等等，那是一座山吗？"}, {"type": "subtitle", "time": 2985.99, "timestamp": "00:49:45", "text": "是的，确实如此。这是。这是。就像"}, {"type": "subtitle", "time": 2989.19, "timestamp": "00:49:49", "text": "雪山之类的。那是"}, {"type": "subtitle", "time": 2991.67, "timestamp": "00:49:51", "text": "这是我一生中最棒的旅行"}, {"type": "subtitle", "time": 2993.43, "timestamp": "00:49:53", "text": "诚实的。宝贝，你摸过雪。那"}, {"type": "subtitle", "time": 2997.03, "timestamp": "00:49:57", "text": "意思是“我的天哪”。这是我第一次"}, {"type": "subtitle", "time": 2999.99, "timestamp": "00:49:59", "text": "下雪了，简直太美妙了。我"}]
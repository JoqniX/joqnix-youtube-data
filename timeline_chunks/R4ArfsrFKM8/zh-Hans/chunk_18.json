[{"type": "subtitle", "time": 1087.63, "timestamp": "00:18:07", "text": "啊，然后是毯子和热"}, {"type": "subtitle", "time": 1090.789, "timestamp": "00:18:10", "text": "可可粉小块是好的。是的，他们"}, {"type": "subtitle", "time": 1098.51, "timestamp": "00:18:18", "text": "好的。"}, {"type": "subtitle", "time": 1101.47, "timestamp": "00:18:21", "text": "是的。我摔倒了"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "再次。我们跳跃失败了。我们做更长时间的。"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "跳。我们失败了。我们从远处跳下去。"}, {"type": "subtitle", "time": 1111.95, "timestamp": "00:18:31", "text": "我们成功了"}, {"type": "subtitle", "time": 1121.95, "timestamp": "00:18:41", "text": "跳"}, {"type": "subtitle", "time": 1123.47, "timestamp": "00:18:43", "text": "繁荣"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "啵。哦，是的。嗯，我以前从不知道“boop”是什么意思。"}, {"type": "subtitle", "time": 1129.31, "timestamp": "00:18:49", "text": "一个"}, {"type": "subtitle", "time": 1132.71, "timestamp": "00:18:52", "text": "事物。我以前从不知道这件事。嗯，如果你"}, {"type": "subtitle", "time": 1135.669, "timestamp": "00:18:55", "text": "想变得可爱，就戳别人。"}]
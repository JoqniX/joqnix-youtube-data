[{"type": "subtitle", "time": 8521.51, "timestamp": "02:22:01", "text": "我。嗯，你还记得我们的《泰坦陨落2》吗？"}, {"type": "subtitle", "time": 8525.11, "timestamp": "02:22:05", "text": "我们合作过吗？那真有趣。嗯，是的。"}, {"type": "subtitle", "time": 8527.83, "timestamp": "02:22:07", "text": "也挺好玩的。是的，那是"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "真好玩。还有 Apex 和樱花"}, {"type": "subtitle", "time": 8533.79, "timestamp": "02:22:13", "text": "东西。"}, {"type": "subtitle", "time": 8536.79, "timestamp": "02:22:16", "text": "是的，我们一起做了很多事情。"}, {"type": "subtitle", "time": 8539.23, "timestamp": "02:22:19", "text": "我至今还记得他们。我当时就想，"}, {"type": "subtitle", "time": 8545.79, "timestamp": "02:22:25", "text": "但"}, {"type": "subtitle", "time": 8549.51, "timestamp": "02:22:29", "text": "是的。嗯，是的。然后你就变得更忙了。"}, {"type": "subtitle", "time": 8552.15, "timestamp": "02:22:32", "text": "哦，是的。幻想如何？"}, {"type": "subtitle", "time": 8554.389, "timestamp": "02:22:34", "text": "最近都流行些什么？"}, {"type": "subtitle", "time": 8556.15, "timestamp": "02:22:36", "text": "一切都还算顺利。我一直"}, {"type": "subtitle", "time": 8558.95, "timestamp": "02:22:38", "text": "最近更放松、更悠闲了，因为"}, {"type": "subtitle", "time": 8560.389, "timestamp": "02:22:40", "text": "你知道我自己的东西，还有你"}, {"type": "subtitle", "time": 8564.389, "timestamp": "02:22:44", "text": "我知道，但目前为止一切都还算可以。"}, {"type": "subtitle", "time": 8567.389, "timestamp": "02:22:47", "text": "嗯，出版商转让还算不错。所以"}, {"type": "subtitle", "time": 8569.99, "timestamp": "02:22:49", "text": "基本上，10美分已经不再掌权了。"}, {"type": "subtitle", "time": 8573.83, "timestamp": "02:22:53", "text": "幻想之塔。嗯，是他们的，是"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "就像原版工作室一样"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "中国原出版商"}]
[{"type": "subtitle", "time": 1501.75, "timestamp": "00:25:01", "text": "我在 OBS 上不断添加资源。"}, {"type": "subtitle", "time": 1505.75, "timestamp": "00:25:05", "text": "就像一个网站，这样我就可以保存"}, {"type": "subtitle", "time": 1512.63, "timestamp": "00:25:12", "text": "来源。嗯，所以这就是为什么我不能……"}, {"type": "subtitle", "time": 1515.99, "timestamp": "00:25:15", "text": "调整尺寸之类的，但我会做的。"}, {"type": "subtitle", "time": 1523.11, "timestamp": "00:25:23", "text": "总有一天，YouTube 上会有 Leorboard 之类的东西。"}, {"type": "subtitle", "time": 1524.19, "timestamp": "00:25:24", "text": "来"}, {"type": "subtitle", "time": 1528.669, "timestamp": "00:25:28", "text": "出去。你们将能够"}, {"type": "subtitle", "time": 1531.76, "timestamp": "00:25:31", "text": "利用这些材料做很多事情"}, {"type": "subtitle", "time": 1534.35, "timestamp": "00:25:34", "text": "[音乐]"}, {"type": "subtitle", "time": 1538.61, "timestamp": "00:25:38", "text": "聊天就像……嗯，这么说吧"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "[音乐]"}, {"type": "subtitle", "time": 1542.75, "timestamp": "00:25:42", "text": "等等，我解释过吗？"}, {"type": "subtitle", "time": 1546.029, "timestamp": "00:25:46", "text": "喷子？巨魔。"}, {"type": "subtitle", "time": 1547.72, "timestamp": "00:25:47", "text": "巨魔。 巨魔。什么"}, {"type": "subtitle", "time": 1555.23, "timestamp": "00:25:55", "text": "喷子？你在说哪个喷子？"}, {"type": "subtitle", "time": 1557.63, "timestamp": "00:25:57", "text": "[音乐]"}]
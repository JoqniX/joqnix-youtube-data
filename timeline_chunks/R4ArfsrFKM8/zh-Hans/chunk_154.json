[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "然后我们就发生了所有这些争斗。"}, {"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "这个竞技场以及之后的一切"}, {"type": "subtitle", "time": 9247.03, "timestamp": "02:34:07", "text": "我当时又一次对此感到非常兴奋。我"}, {"type": "subtitle", "time": 9249.95, "timestamp": "02:34:09", "text": "当时很安静，我只是想带"}, {"type": "subtitle", "time": 9252.55, "timestamp": "02:34:12", "text": "我在《星光》中看到的经历"}, {"type": "subtitle", "time": 9254.95, "timestamp": "02:34:14", "text": "成为幻想之塔的公民，就是这样。"}, {"type": "subtitle", "time": 9256.79, "timestamp": "02:34:16", "text": "是什么让我坚持下去？"}, {"type": "subtitle", "time": 9259.07, "timestamp": "02:34:19", "text": "为《幻想之塔》带来全新活动"}, {"type": "subtitle", "time": 9262.469, "timestamp": "02:34:22", "text": "社区，当我这样做的时候，出现了一个"}, {"type": "subtitle", "time": 9264.99, "timestamp": "02:34:24", "text": "我们服务器 Hal 的特定社区"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "我最终在Nova那里得到了呃"}, {"type": "subtitle", "time": 9270.71, "timestamp": "02:34:30", "text": "最后我拿到了领导权。"}, {"type": "subtitle", "time": 9272.15, "timestamp": "02:34:32", "text": "管理好井，我最终成为了"}, {"type": "subtitle", "time": 9274.469, "timestamp": "02:34:34", "text": "因为是社区经理，所以"}, {"type": "subtitle", "time": 9276.63, "timestamp": "02:34:36", "text": "老年人为了mod和ing"}, {"type": "subtitle", "time": 9279.95, "timestamp": "02:34:39", "text": "管理员们陆续卸任，而我"}, {"type": "subtitle", "time": 9283.349, "timestamp": "02:34:43", "text": "致力于举办所有这些活动"}, {"type": "subtitle", "time": 9286.07, "timestamp": "02:34:46", "text": "管理事务，他们把领导权移交给了领导层。"}, {"type": "subtitle", "time": 9289.03, "timestamp": "02:34:49", "text": "大部头书。所以，这就是我最终成为领导者的原因。"}, {"type": "subtitle", "time": 9292.79, "timestamp": "02:34:52", "text": "那台服务器和我的arogi服务器一起"}, {"type": "subtitle", "time": 9294.389, "timestamp": "02:34:54", "text": "喜欢"}, {"type": "subtitle", "time": 9296.91, "timestamp": "02:34:56", "text": "嗯，建立秩序，运营社区"}, {"type": "subtitle", "time": 9299.27, "timestamp": "02:34:59", "text": "活动，做各种不同的事情"}]
[{"type": "subtitle", "time": 1801.83, "timestamp": "00:30:01", "text": "天哪，我当时太兴奋了。嗯。玩"}, {"type": "subtitle", "time": 1804.789, "timestamp": "00:30:04", "text": "你和一些东西。我没有，我是，我一直是"}, {"type": "subtitle", "time": 1808.31, "timestamp": "00:30:08", "text": "看到你的直播之类的。我愿意"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "偶尔会搭个便车，但我的生活一直是"}, {"type": "subtitle", "time": 1814.95, "timestamp": "00:30:14", "text": "最近东西真的太多了，但是"}, {"type": "subtitle", "time": 1816.95, "timestamp": "00:30:16", "text": "我还是设法来看了你的直播。"}, {"type": "subtitle", "time": 1819.11, "timestamp": "00:30:19", "text": "所以，是的，我终于有机会……"}, {"type": "subtitle", "time": 1827.909, "timestamp": "00:30:27", "text": "谢谢。谢谢。我不是，我不是，我不是。"}, {"type": "subtitle", "time": 1830.47, "timestamp": "00:30:30", "text": "问题。我不知道你在监视我。"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "虽然东西不多，但还是谢谢你。"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "大多数时候你都像这样"}, {"type": "subtitle", "time": 1838.63, "timestamp": "00:30:38", "text": "不活跃或像睡觉一样。所以没关系。"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "我就像在那儿潜水了一阵子。"}, {"type": "subtitle", "time": 1852.75, "timestamp": "00:30:52", "text": "今天能来到这里，我感到非常荣幸。好的。"}, {"type": "subtitle", "time": 1856.95, "timestamp": "00:30:56", "text": "是的。嗯，你当时处于休假状态，对吧？"}]
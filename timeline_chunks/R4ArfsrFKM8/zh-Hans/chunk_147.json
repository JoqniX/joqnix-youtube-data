[{"type": "subtitle", "time": 8821.91, "timestamp": "02:27:01", "text": "Discord 服务器？是的。是的。是的。"}, {"type": "subtitle", "time": 8824.469, "timestamp": "02:27:04", "text": "那方面也很活跃。是的。是的。所以，"}, {"type": "subtitle", "time": 8828.15, "timestamp": "02:27:08", "text": "我当时想，也许卡玛一直不是你。"}, {"type": "subtitle", "time": 8830.95, "timestamp": "02:27:10", "text": "知道谁在Discord上活跃。也许他一直"}, {"type": "subtitle", "time": 8833.23, "timestamp": "02:27:13", "text": "专注于生活，你"}, {"type": "subtitle", "time": 8837.469, "timestamp": "02:27:17", "text": "知道。我意识到"}, {"type": "subtitle", "time": 8840.23, "timestamp": "02:27:20", "text": "是的，我对这次通话感到失望。喜欢"}, {"type": "subtitle", "time": 8841.19, "timestamp": "02:27:21", "text": "这次通话你不能"}, {"type": "subtitle", "time": 8847.87, "timestamp": "02:27:27", "text": "那是"}, {"type": "subtitle", "time": 8852.63, "timestamp": "02:27:32", "text": "好的。所以，我还记得VR直播。"}, {"type": "subtitle", "time": 8856.07, "timestamp": "02:27:36", "text": "那是VR的一部分，是的。"}, {"type": "subtitle", "time": 8859.11, "timestamp": "02:27:39", "text": "弗吉尼亚州的直播简直太棒了"}, {"type": "subtitle", "time": 8861.27, "timestamp": "02:27:41", "text": "我因此结识了很多人。"}, {"type": "subtitle", "time": 8864.87, "timestamp": "02:27:44", "text": "就像阿里那样，透过那条溪流……"}, {"type": "subtitle", "time": 8867.349, "timestamp": "02:27:47", "text": "嗯，我也想到了其他几个人。"}, {"type": "subtitle", "time": 8869.51, "timestamp": "02:27:49", "text": "我遇到了他，我们就像在共度时光一样。"}, {"type": "subtitle", "time": 8872.79, "timestamp": "02:27:52", "text": "我们花了大概 6、7、8 个小时。"}, {"type": "subtitle", "time": 8875.83, "timestamp": "02:27:55", "text": "VR聊天漫游于世界各地"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "然后我们去了某个休息室"}]
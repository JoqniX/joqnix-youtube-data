[{"type": "subtitle", "time": 8161.35, "timestamp": "02:16:01", "text": "就像最终升级它一样，嘿"}, {"type": "subtitle", "time": 8163.109, "timestamp": "02:16:03", "text": "你不想用同样的CPU，你可以"}, {"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "未来可能会升级到不同的CPU。"}, {"type": "subtitle", "time": 8167.109, "timestamp": "02:16:07", "text": "未来可能会升级到不同的GPU。"}, {"type": "subtitle", "time": 8168.629, "timestamp": "02:16:08", "text": "或者类似的事情。它很漂亮"}, {"type": "subtitle", "time": 8170.99, "timestamp": "02:16:10", "text": "好的。"}, {"type": "subtitle", "time": 8172.75, "timestamp": "02:16:12", "text": "是的。所以"}, {"type": "subtitle", "time": 8175.83, "timestamp": "02:16:15", "text": "我在想我是否应该买一个"}, {"type": "subtitle", "time": 8180.47, "timestamp": "02:16:20", "text": "迷你电脑？迷你电脑好不好？嗯……我觉得不好。"}, {"type": "subtitle", "time": 8184.229, "timestamp": "02:16:24", "text": "当然。 Rainbow 黑客入侵了一台迷你电脑，你知道吗？"}, {"type": "subtitle", "time": 8187.43, "timestamp": "02:16:27", "text": "看起来确实迷你版不错，但你会"}, {"type": "subtitle", "time": 8189.03, "timestamp": "02:16:29", "text": "还需要一台显示器之类的东西"}, {"type": "subtitle", "time": 8192.549, "timestamp": "02:16:32", "text": "旁边还有一些东西。啊，那是去你的"}, {"type": "subtitle", "time": 8193.99, "timestamp": "02:16:33", "text": "还需要一个单独的键盘"}, {"type": "subtitle", "time": 8196.469, "timestamp": "02:16:36", "text": "笔记本电脑上的鼠标和所有鼠标都在一个……"}, {"type": "subtitle", "time": 8204.879, "timestamp": "02:16:44", "text": "确实如此"}, {"type": "subtitle", "time": 8206.75, "timestamp": "02:16:46", "text": "[音乐]"}, {"type": "subtitle", "time": 8210.309, "timestamp": "02:16:50", "text": "是啊，太多事了。"}, {"type": "subtitle", "time": 8211.95, "timestamp": "02:16:51", "text": "是的"}, {"type": "subtitle", "time": 8215.349, "timestamp": "02:16:55", "text": "这是你真正拥有的全新特质。"}, {"type": "subtitle", "time": 8217.86, "timestamp": "02:16:57", "text": "不像以前那样总是这样。"}]
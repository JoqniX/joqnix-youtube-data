[{"type": "subtitle", "time": 2040.07, "timestamp": "00:34:00", "text": "我记得这个月应该是20号、26号和28号。"}, {"type": "subtitle", "time": 2042.07, "timestamp": "00:34:02", "text": "我只能参加两场考试，因为我只有"}, {"type": "subtitle", "time": 2044.63, "timestamp": "00:34:04", "text": "直接去日本。航班将是"}, {"type": "subtitle", "time": 2048.27, "timestamp": "00:34:08", "text": "大概在30号或31号。"}, {"type": "subtitle", "time": 2052.47, "timestamp": "00:34:12", "text": "嗯，是的。所以我就想，我只会……"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "考两门试，嗯，我甚至都不知道"}, {"type": "subtitle", "time": 2057.669, "timestamp": "00:34:17", "text": "我不知道它们是什么，我甚至都不知道。"}, {"type": "subtitle", "time": 2061.03, "timestamp": "00:34:21", "text": "学习过。该死。这就是我。"}, {"type": "subtitle", "time": 2069.829, "timestamp": "00:34:29", "text": "但我做不到。我不能，我做不到。"}, {"type": "subtitle", "time": 2073.349, "timestamp": "00:34:33", "text": "不过那件事只发生在日本。我的父母"}, {"type": "subtitle", "time": 2075.829, "timestamp": "00:34:35", "text": "现在要花很多钱，我不得不……"}, {"type": "subtitle", "time": 2079.31, "timestamp": "00:34:39", "text": "实际上要多学习，并且认真学习。"}, {"type": "subtitle", "time": 2082.629, "timestamp": "00:34:42", "text": "找到一份好工作之类的。所以我就得……"}, {"type": "subtitle", "time": 2086.55, "timestamp": "00:34:46", "text": "努力工作。是的。得努力奋斗。必须"}, {"type": "chat", "time": 2088.472, "timestamp": "00:34:48", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqx"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "研磨。是的。"}, {"type": "subtitle", "time": 2094.23, "timestamp": "00:34:54", "text": "好的。好的。我记得我呃我"}, {"type": "subtitle", "time": 2098.15, "timestamp": "00:34:58", "text": "我偶然发现了你的频道。"}]
[{"type": "subtitle", "time": 6901.27, "timestamp": "01:55:01", "text": "反对者终将被迫承认这一点。"}, {"type": "subtitle", "time": 6909.589, "timestamp": "01:55:09", "text": "亚马逊。呃，谁怀疑过你？"}, {"type": "subtitle", "time": 6911.35, "timestamp": "01:55:11", "text": "为什么会有人怀疑你的能力？"}, {"type": "subtitle", "time": 6914.229, "timestamp": "01:55:14", "text": "升级扫帚？不，你会感到惊讶的。"}, {"type": "subtitle", "time": 6916.629, "timestamp": "01:55:16", "text": "人们固守成规，担心"}, {"type": "subtitle", "time": 6918.39, "timestamp": "01:55:18", "text": "对运行良好的部分进行调整会"}, {"type": "subtitle", "time": 6920.189, "timestamp": "01:55:20", "text": "以某种方式毁掉"}, {"type": "subtitle", "time": 6922.95, "timestamp": "01:55:22", "text": "它。那些人不懂得欣赏"}, {"type": "subtitle", "time": 6924.709, "timestamp": "01:55:24", "text": "品质带来的自由感"}, {"type": "subtitle", "time": 6927.189, "timestamp": "01:55:27", "text": "扫帚飞行。他们也不懂得欣赏这一切。"}, {"type": "subtitle", "time": 6929.669, "timestamp": "01:55:29", "text": "这是创作过程中涉及的一部分。"}, {"type": "subtitle", "time": 6931.75, "timestamp": "01:55:31", "text": "我在罗马有个朋友，开了一家类似的商店。"}, {"type": "subtitle", "time": 6934.79, "timestamp": "01:55:34", "text": "矿。他说那里的情况更糟。当然，"}, {"type": "subtitle", "time": 6936.87, "timestamp": "01:55:36", "text": "他们下午会午睡，从哪里来呢？"}, {"type": "subtitle", "time": 6939.31, "timestamp": "01:55:39", "text": "我听说了。如果没有我们，我们又会身处何方呢？"}, {"type": "subtitle", "time": 6941.91, "timestamp": "01:55:41", "text": "改进？我的意思是，如果埃利奥特·斯梅克"}, {"type": "subtitle", "time": 6944.07, "timestamp": "01:55:44", "text": "如果他被那些反对者的影响所左右，我们"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "永远不会有缓冲作用"}, {"type": "subtitle", "time": 6948.109, "timestamp": "01:55:48", "text": "魅力。我不听。"}, {"type": "subtitle", "time": 6950.95, "timestamp": "01:55:50", "text": "他。我的天，这也太酷了吧！它 它"}, {"type": "subtitle", "time": 6953.27, "timestamp": "01:55:53", "text": "感觉自己就像个真正的 YouTuber 一样"}, {"type": "subtitle", "time": 6955.91, "timestamp": "01:55:55", "text": "比如手机追踪设置之类的。"}, {"type": "subtitle", "time": 6959.07, "timestamp": "01:55:59", "text": "我的天啊，这种感觉"}]
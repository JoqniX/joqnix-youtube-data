[{"type": "subtitle", "time": 3002.71, "timestamp": "00:50:02", "text": "爱 如果可以，我真想再去一次。"}, {"type": "subtitle", "time": 3005.589, "timestamp": "00:50:05", "text": "那九天是如此珍贵"}, {"type": "subtitle", "time": 3008.549, "timestamp": "00:50:08", "text": "我。我的天啊。我甚至不能，我不能"}, {"type": "subtitle", "time": 3010.549, "timestamp": "00:50:10", "text": "别再谈论这件事了。即使它"}, {"type": "subtitle", "time": 3013.349, "timestamp": "00:50:13", "text": "自从我喜欢上它以来已经过去大约两个月了"}, {"type": "subtitle", "time": 3017.829, "timestamp": "00:50:17", "text": "回去，但那些视频什么的。哦"}, {"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "我的上帝。简直太神奇了。这就像……"}, {"type": "subtitle", "time": 3023.99, "timestamp": "00:50:23", "text": "奇幻世界。"}, {"type": "subtitle", "time": 3025.829, "timestamp": "00:50:25", "text": "我还没碰过诺亚，所以我……"}, {"type": "subtitle", "time": 3027.67, "timestamp": "00:50:27", "text": "迫不及待地想要触摸。我的天啊。你应该这么做。"}, {"type": "subtitle", "time": 3030.87, "timestamp": "00:50:30", "text": "你应该这么做。你会感受到另一种境界"}, {"type": "subtitle", "time": 3034.03, "timestamp": "00:50:34", "text": "和平与宁静。我的天啊。做过"}, {"type": "subtitle", "time": 3036.87, "timestamp": "00:50:36", "text": "你有阳台之类的吗？只是"}, {"type": "subtitle", "time": 3039.43, "timestamp": "00:50:39", "text": "惊人的。雪人。是的。你建造了吗？"}, {"type": "subtitle", "time": 3042.79, "timestamp": "00:50:42", "text": "那？是的，我做了。我甚至真的这么做了"}, {"type": "subtitle", "time": 3046.71, "timestamp": "00:50:46", "text": "雪天使那件事，就是你在地面上做雪天使动作，或者"}, {"type": "subtitle", "time": 3048.79, "timestamp": "00:50:48", "text": "是的，我做过。我正想问你"}, {"type": "subtitle", "time": 3051.19, "timestamp": "00:50:51", "text": "那。你讲了个笑话吗？哦，我的"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "上帝。是的，我做过。"}, {"type": "subtitle", "time": 3056.23, "timestamp": "00:50:56", "text": "你们打雪仗了吗？雪球"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "与你的“我的天哪”战斗。是的，我做了。"}]
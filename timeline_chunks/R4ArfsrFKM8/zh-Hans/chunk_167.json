[{"type": "subtitle", "time": 10020.55, "timestamp": "02:47:00", "text": "的确。的确。"}, {"type": "subtitle", "time": 10022.19, "timestamp": "02:47:02", "text": "什么是"}, {"type": "subtitle", "time": 10026.15, "timestamp": "02:47:06", "text": "这？当我想象现在，然后我闭上眼睛"}, {"type": "subtitle", "time": 10027.99, "timestamp": "02:47:07", "text": "眼睛，我感觉自己仿佛置身其中。"}, {"type": "subtitle", "time": 10031.349, "timestamp": "02:47:11", "text": "做白日梦之类的。当我……的时候"}, {"type": "subtitle", "time": 10033.19, "timestamp": "02:47:13", "text": "当时我们正在谈论……"}, {"type": "subtitle", "time": 10035.99, "timestamp": "02:47:15", "text": "频道感谢，现在我感觉一切都好。"}, {"type": "subtitle", "time": 10039.349, "timestamp": "02:47:19", "text": "就像我当时在拜访你一样。"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "某个地方或某事，或者拜访你"}, {"type": "subtitle", "time": 10044.349, "timestamp": "02:47:24", "text": "你解释这些内容的直播"}, {"type": "subtitle", "time": 10047.91, "timestamp": "02:47:27", "text": "事物。我当时就像是在想象那个画面一样"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "我当时想，等等，上帝真的就在我身边。"}, {"type": "subtitle", "time": 10056.67, "timestamp": "02:47:36", "text": "不像这里，不像我的梦里"}, {"type": "subtitle", "time": 10061.59, "timestamp": "02:47:41", "text": "世界。我的天啊。不。"}, {"type": "subtitle", "time": 10064.95, "timestamp": "02:47:44", "text": "是的。五月，今天真的很有趣。我得去"}, {"type": "subtitle", "time": 10067.16, "timestamp": "02:47:47", "text": "下次再跟你聊。"}, {"type": "subtitle", "time": 10069.03, "timestamp": "02:47:49", "text": "[音乐]"}, {"type": "subtitle", "time": 10070.63, "timestamp": "02:47:50", "text": "的确。距离我们上次见面已经很多年了。"}, {"type": "subtitle", "time": 10074.15, "timestamp": "02:47:54", "text": "上次谈话。真的。真的。是的。我应该"}, {"type": "subtitle", "time": 10076.469, "timestamp": "02:47:56", "text": "多跟你聊聊，让你保持联系。"}]
[{"type": "subtitle", "time": 12900.55, "timestamp": "03:35:00", "text": "记住，它又要来了。"}, {"type": "subtitle", "time": 12903.03, "timestamp": "03:35:03", "text": "一家机构。所以，数量会非常少。"}, {"type": "subtitle", "time": 12905.51, "timestamp": "03:35:05", "text": "这些东西，因为他们又会被给予。"}, {"type": "subtitle", "time": 12908.309, "timestamp": "03:35:08", "text": "人才经理和管理人员"}, {"type": "subtitle", "time": 12910.309, "timestamp": "03:35:10", "text": "我会到场。你还得去"}, {"type": "subtitle", "time": 12912.87, "timestamp": "03:35:12", "text": "通过管理人员"}, {"type": "subtitle", "time": 12916.389, "timestamp": "03:35:16", "text": "呃，还有其他一些东西，即使他们呃不……"}, {"type": "subtitle", "time": 12919.03, "timestamp": "03:35:19", "text": "不要影响你的创作方向。"}, {"type": "subtitle", "time": 12921.11, "timestamp": "03:35:21", "text": "你仍然需要咨询管理层。"}, {"type": "subtitle", "time": 12924.229, "timestamp": "03:35:24", "text": "你的东西呃，在里面"}, {"type": "subtitle", "time": 12927.269, "timestamp": "03:35:27", "text": "机构。是的，她也提到了这一点。"}, {"type": "subtitle", "time": 12929.67, "timestamp": "03:35:29", "text": "她获得了管理层的支持。惊人的"}, {"type": "subtitle", "time": 12932.469, "timestamp": "03:35:32", "text": "管理支持。那挺好的。"}, {"type": "subtitle", "time": 12936.389, "timestamp": "03:35:36", "text": "一个巨大的陷阱，一个危险的信号。"}, {"type": "subtitle", "time": 12939.83, "timestamp": "03:35:39", "text": "大多数创业机构"}, {"type": "subtitle", "time": 12942.15, "timestamp": "03:35:42", "text": "没有管理层。如果你是"}, {"type": "subtitle", "time": 12946.389, "timestamp": "03:35:46", "text": "从西方等地引进人才"}, {"type": "subtitle", "time": 12949.51, "timestamp": "03:35:49", "text": "比如英语人才，还有日本人。"}, {"type": "subtitle", "time": 12951.91, "timestamp": "03:35:51", "text": "天赋或者你需要的东西，你是"}, {"type": "subtitle", "time": 12955.19, "timestamp": "03:35:55", "text": "作为代理机构所有者，需要像招聘一样进行招聘"}, {"type": "subtitle", "time": 12958.87, "timestamp": "03:35:58", "text": "一位日本经理和一位英国经理。日本"}]
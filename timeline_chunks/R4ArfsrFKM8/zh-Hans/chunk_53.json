[{"type": "subtitle", "time": 3181.43, "timestamp": "00:53:01", "text": "等等，你跟我说过这些东西吗？"}, {"type": "subtitle", "time": 3184.15, "timestamp": "00:53:04", "text": "你的直播里也有吗？这次旅行。我"}, {"type": "subtitle", "time": 3186.71, "timestamp": "00:53:06", "text": "说实话，我没有，因为我没人"}, {"type": "subtitle", "time": 3191.349, "timestamp": "00:53:11", "text": "甚至问过，但不会喜欢"}, {"type": "subtitle", "time": 3193.349, "timestamp": "00:53:13", "text": "分享一下我们为什么会有这件事，因为我"}, {"type": "subtitle", "time": 3195.03, "timestamp": "00:53:15", "text": "我想我会制作一个vlog，"}, {"type": "subtitle", "time": 3199.27, "timestamp": "00:53:19", "text": "除了你所知的一切之外，其他一切都好。"}, {"type": "subtitle", "time": 3201.75, "timestamp": "00:53:21", "text": "我的手机突然响了起来，我的流量也随之暴涨。"}, {"type": "subtitle", "time": 3205.99, "timestamp": "00:53:25", "text": "旅行，所以，嗯，其实，嗯，所以呢？"}, {"type": "subtitle", "time": 3209.03, "timestamp": "00:53:29", "text": "我的手机好像……呃……"}, {"type": "subtitle", "time": 3211.75, "timestamp": "00:53:31", "text": "我拿走的时候，它的状态很差。"}, {"type": "subtitle", "time": 3214.79, "timestamp": "00:53:34", "text": "手机里的电池就在那里。"}, {"type": "subtitle", "time": 3219.03, "timestamp": "00:53:39", "text": "开始肿胀。所以，它很大，而且"}, {"type": "subtitle", "time": 3221.19, "timestamp": "00:53:41", "text": "我妈妈告诉我不要用手机。所以，"}, {"type": "subtitle", "time": 3223.589, "timestamp": "00:53:43", "text": "我当时靠朋友的手机度日。"}, {"type": "subtitle", "time": 3225.27, "timestamp": "00:53:45", "text": "所以，我没能拍到所有的照片。"}, {"type": "subtitle", "time": 3226.19, "timestamp": "00:53:46", "text": "东西。"}, {"type": "subtitle", "time": 3228.87, "timestamp": "00:53:48", "text": "但我当时在考虑制作一个vlog"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "那些。但现在，我觉得我不会了"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "能够。但如果我要发帖，我会发的。"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "你会看到的。太神奇了，乔。我"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "发誓。耶。"}]
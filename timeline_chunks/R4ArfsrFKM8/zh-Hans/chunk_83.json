[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "那种与世隔绝的人。所以，我是"}, {"type": "subtitle", "time": 4984.07, "timestamp": "01:23:04", "text": "就像更新了所有表情包一样"}, {"type": "subtitle", "time": 4987.91, "timestamp": "01:23:07", "text": "现在发生了很多事，你知道的，而我"}, {"type": "subtitle", "time": 4990.149, "timestamp": "01:23:10", "text": "能够模仿。我不知道。我没有"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "试过了。嗯，就是这样。"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "说起这件事，我还记得扎娜"}, {"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "教会了我那些意大利梗。呃，那个"}, {"type": "subtitle", "time": 5002.27, "timestamp": "01:23:22", "text": "哪些意大利梗？"}, {"type": "subtitle", "time": 5006.629, "timestamp": "01:23:26", "text": "呃……我忘了名字。棒球"}, {"type": "subtitle", "time": 5009.43, "timestamp": "01:23:29", "text": "一个有点眼疾的坏蛋。然后"}, {"type": "subtitle", "time": 5013.229, "timestamp": "01:23:33", "text": "鳄鱼与平原"}, {"type": "subtitle", "time": 5016.149, "timestamp": "01:23:36", "text": "头。呃"}, {"type": "chat", "time": 5016.206, "timestamp": "01:23:36", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "btw today is national best friend day "}, {"type": "subtitle", "time": 5018.39, "timestamp": "01:23:38", "text": "那根管子。"}, {"type": "subtitle", "time": 5022.35, "timestamp": "01:23:42", "text": "是的。是的。是的。上帝。那是芭蕾舞演员吗？"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "卡帕西纳？那个。是的。我的天啊。"}, {"type": "subtitle", "time": 5029.51, "timestamp": "01:23:49", "text": "这就是现在流传甚广的那一个"}, {"type": "chat", "time": 5033.078, "timestamp": "01:23:53", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "italian brainrot mentioned"}, {"type": "subtitle", "time": 5033.11, "timestamp": "01:23:53", "text": "尽管。嗯。那很好。"}, {"type": "subtitle", "time": 5035.189, "timestamp": "01:23:55", "text": "是的。顺便一提，今天是全国最佳日。"}, {"type": "subtitle", "time": 5037.11, "timestamp": "01:23:57", "text": "朋友节。我的天啊。那很好。它"}]
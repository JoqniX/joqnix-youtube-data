[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "找到一份全职工作，这样我就可以"}, {"type": "subtitle", "time": 7682.79, "timestamp": "02:08:02", "text": "待在那儿，或者我可以读硕士，或者"}, {"type": "subtitle", "time": 7685.43, "timestamp": "02:08:05", "text": "某物。哦，就像那样。好的。"}, {"type": "subtitle", "time": 7689.83, "timestamp": "02:08:09", "text": "听起来是个好主意。是的，我当时"}, {"type": "subtitle", "time": 7693.589, "timestamp": "02:08:13", "text": "就像我会努力赚钱一样"}, {"type": "subtitle", "time": 7696.31, "timestamp": "02:08:16", "text": "呃，从日本兼职什么的"}, {"type": "subtitle", "time": 7699.83, "timestamp": "02:08:19", "text": "但我只能做20次。"}, {"type": "subtitle", "time": 7702.629, "timestamp": "02:08:22", "text": "每周工作小时。所以我就说，“是啊，我会的。”"}, {"type": "subtitle", "time": 7704.709, "timestamp": "02:08:24", "text": "看看我能做什么，喜欢什么"}, {"type": "subtitle", "time": 7707.99, "timestamp": "02:08:27", "text": "即兴发挥什么的。”是的。"}, {"type": "subtitle", "time": 7712.109, "timestamp": "02:08:32", "text": "我唯一会遇到的问题是噪音。"}, {"type": "subtitle", "time": 7716.55, "timestamp": "02:08:36", "text": "投诉时"}, {"type": "subtitle", "time": 7720.55, "timestamp": "02:08:40", "text": "呃，因为居家隔离，我处于居家隔离状态。所以，呃"}, {"type": "subtitle", "time": 7723.75, "timestamp": "02:08:43", "text": "显然，那些参加活动的同学"}, {"type": "subtitle", "time": 7726.149, "timestamp": "02:08:46", "text": "四月份的招生情况是这样的："}, {"type": "subtitle", "time": 7729.27, "timestamp": "02:08:49", "text": "在室内无法接听电话。"}, {"type": "subtitle", "time": 7731.43, "timestamp": "02:08:51", "text": "房间，因为它可能被视为噪音"}, {"type": "subtitle", "time": 7733.589, "timestamp": "02:08:53", "text": "投诉和其他室友"}, {"type": "subtitle", "time": 7735.43, "timestamp": "02:08:55", "text": "外国人会抱怨，"}, {"type": "subtitle", "time": 7738.95, "timestamp": "02:08:58", "text": "东西。他们说这有点难。"}]
[{"type": "subtitle", "time": 300.43, "timestamp": "00:05:00", "text": "也。所以，你们怎么样？"}, {"type": "subtitle", "time": 304.469, "timestamp": "00:05:04", "text": "正在做？哦，等等。呃，我想我"}, {"type": "subtitle", "time": 306.51, "timestamp": "00:05:06", "text": "需要稍微打开一下通风机。"}, {"type": "subtitle", "time": 309.55, "timestamp": "00:05:09", "text": "快的。所以你知道，呃，关于"}, {"type": "subtitle", "time": 313.83, "timestamp": "00:05:13", "text": "周末有辆车"}, {"type": "subtitle", "time": 316.469, "timestamp": "00:05:16", "text": "经过我家就像我的房子一样"}, {"type": "subtitle", "time": 319.99, "timestamp": "00:05:19", "text": "靠近路边。所以，一辆车"}, {"type": "subtitle", "time": 322.83, "timestamp": "00:05:22", "text": "含有大量毒素的通道"}, {"type": "subtitle", "time": 325.43, "timestamp": "00:05:25", "text": "仙人掌是用来捉蚊子的。"}, {"type": "subtitle", "time": 328.87, "timestamp": "00:05:28", "text": "死亡等等。雾很大"}, {"type": "subtitle", "time": 331.51, "timestamp": "00:05:31", "text": "烟雾状的东西。"}, {"type": "subtitle", "time": 333.469, "timestamp": "00:05:33", "text": "你知道，"}, {"type": "subtitle", "time": 336.15, "timestamp": "00:05:36", "text": "是的，我应该打开……"}, {"type": "subtitle", "time": 338.87, "timestamp": "00:05:38", "text": "呼吸机之类的东西。呃，我不能"}, {"type": "subtitle", "time": 342.07, "timestamp": "00:05:42", "text": "呼吸。那是痛苦。我的窗户是"}, {"type": "subtitle", "time": 343.79, "timestamp": "00:05:43", "text": "也关门了。"}, {"type": "subtitle", "time": 353.029, "timestamp": "00:05:53", "text": "向上。你知道，总有一天当这种情况发生时"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "事情发生了，我打开了通风口……呃……"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "通风装置，呃，风扇在转"}]
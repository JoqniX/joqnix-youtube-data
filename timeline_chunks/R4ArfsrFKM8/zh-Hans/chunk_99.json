[{"type": "subtitle", "time": 5940.709, "timestamp": "01:39:00", "text": "是的。我很高兴。我很喜欢。我非常"}, {"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "快乐的。"}, {"type": "subtitle", "time": 5946.31, "timestamp": "01:39:06", "text": "我以为我有点忘了我们曾经是……"}, {"type": "subtitle", "time": 5949.35, "timestamp": "01:39:09", "text": "比如，如果你愿意的话，我们可以"}, {"type": "subtitle", "time": 5951.83, "timestamp": "01:39:11", "text": "玩过游戏之类的。我"}, {"type": "subtitle", "time": 5954.35, "timestamp": "01:39:14", "text": "我忘了提这件事。是吗？"}, {"type": "subtitle", "time": 5958.149, "timestamp": "01:39:18", "text": "完全没问题。嗯。更有趣"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "因为我们聊得很开心。我们"}, {"type": "subtitle", "time": 5964.229, "timestamp": "01:39:24", "text": "我们谈论了我们的未来、我们的过去和"}, {"type": "subtitle", "time": 5966.79, "timestamp": "01:39:26", "text": "所有这些。非常好。所以现在我明白了"}, {"type": "subtitle", "time": 5969.35, "timestamp": "01:39:29", "text": "想更了解你。不，如果我们有"}, {"type": "subtitle", "time": 5971.79, "timestamp": "01:39:31", "text": "玩游戏的时候，就只有我们俩。"}, {"type": "subtitle", "time": 5974.55, "timestamp": "01:39:34", "text": "先是喊叫，然后玩耍。我们不会"}, {"type": "subtitle", "time": 5976.55, "timestamp": "01:39:36", "text": "已经建立了某种联系或其他关系。"}, {"type": "subtitle", "time": 5978.31, "timestamp": "01:39:38", "text": "正确的。"}, {"type": "subtitle", "time": 5980.149, "timestamp": "01:39:40", "text": "更像是我们俩的聚会场所"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "朋友在风险投资公司聊天。"}, {"type": "subtitle", "time": 5983.89, "timestamp": "01:39:43", "text": "确切地。"}, {"type": "subtitle", "time": 5985.83, "timestamp": "01:39:45", "text": "[音乐]"}, {"type": "subtitle", "time": 5989.59, "timestamp": "01:39:49", "text": "所以，D和我希望喜欢我所做的一切。"}, {"type": "subtitle", "time": 5991.75, "timestamp": "01:39:51", "text": "那天我看了你的首秀直播"}, {"type": "subtitle", "time": 5994.47, "timestamp": "01:39:54", "text": "哇，原来应该这么做。我"}, {"type": "subtitle", "time": 5997.03, "timestamp": "01:39:57", "text": "我想这样准备我的出道。"}, {"type": "subtitle", "time": 5999.189, "timestamp": "01:39:59", "text": "我从未正式出道。"}]
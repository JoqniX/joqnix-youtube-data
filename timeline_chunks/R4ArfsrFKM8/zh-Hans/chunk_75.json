[{"type": "subtitle", "time": 4501.189, "timestamp": "01:15:01", "text": "太有趣了，我就是这样做出这个决定的。"}, {"type": "subtitle", "time": 4503.189, "timestamp": "01:15:03", "text": "乔克尼克的名字之类的，因为我想要"}, {"type": "chat", "time": 4505.299, "timestamp": "01:15:05", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "my whole playlist is full of them "}, {"type": "subtitle", "time": 4507.59, "timestamp": "01:15:07", "text": "就像如果我以后有机会登台演出，可以用一个艺名一样"}, {"type": "subtitle", "time": 4510.47, "timestamp": "01:15:10", "text": "太好了。太棒了。是的。"}, {"type": "subtitle", "time": 4512.95, "timestamp": "01:15:12", "text": "自从我发现了帽子之后，就一直如此。"}, {"type": "subtitle", "time": 4516.07, "timestamp": "01:15:16", "text": "一切都变得像动漫音乐一样，"}, {"type": "subtitle", "time": 4519.669, "timestamp": "01:15:19", "text": "声乐，日本音乐。我甚至我甚至"}, {"type": "subtitle", "time": 4522.63, "timestamp": "01:15:22", "text": "听听日本歌曲之类的。呃"}, {"type": "subtitle", "time": 4527.03, "timestamp": "01:15:27", "text": "我偶尔会看动漫之类的。所以"}, {"type": "subtitle", "time": 4530.95, "timestamp": "01:15:30", "text": "我大概在6岁的时候接触到了动漫。"}, {"type": "subtitle", "time": 4534.709, "timestamp": "01:15:34", "text": "我想大概是很多年前吧。所以我不知道什么时候"}, {"type": "chat", "time": 4536.696, "timestamp": "01:15:36", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "got a 6 hour playlist filled with indie songs"}, {"type": "subtitle", "time": 4537.75, "timestamp": "01:15:37", "text": "《鬼灭之刃》开播了，而我的一切"}, {"type": "subtitle", "time": 4539.91, "timestamp": "01:15:39", "text": "我当时痴迷于《鬼灭之刃》，而且我……"}, {"type": "subtitle", "time": 4544.149, "timestamp": "01:15:44", "text": "这首歌的开头部分我全都学会了。"}, {"type": "subtitle", "time": 4546.709, "timestamp": "01:15:46", "text": "我学会了那首歌，然后我又有了它。"}, {"type": "chat", "time": 4549.692, "timestamp": "01:15:49", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "Gurenge?"}, {"type": "subtitle", "time": 4549.99, "timestamp": "01:15:49", "text": "后来在东京女孩那里学会了蓝鸟的歌声"}, {"type": "subtitle", "time": 4552.229, "timestamp": "01:15:52", "text": "我学会了所有那些歌。"}, {"type": "subtitle", "time": 4555.03, "timestamp": "01:15:55", "text": "即使你叫我唱歌，我也会照做。"}, {"type": "chat", "time": 4559.097, "timestamp": "01:15:59", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "cry baby"}, {"type": "subtitle", "time": 4559.669, "timestamp": "01:15:59", "text": "我只想把歌开到最大声，但我真的太……"}]
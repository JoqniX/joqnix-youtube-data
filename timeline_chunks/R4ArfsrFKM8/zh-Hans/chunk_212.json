[{"type": "subtitle", "time": 12723.03, "timestamp": "03:32:03", "text": "呃，机构，它允许你让创作者"}, {"type": "subtitle", "time": 12726.389, "timestamp": "03:32:06", "text": "加入这个机构，它就像一个集体"}, {"type": "subtitle", "time": 12729.99, "timestamp": "03:32:09", "text": "好的，这个团队就像一个直播团队。"}, {"type": "subtitle", "time": 12732.71, "timestamp": "03:32:12", "text": "别给你他们的，他们不跑"}, {"type": "subtitle", "time": 12735.83, "timestamp": "03:32:15", "text": "不要给你一个你必须使用的IP地址"}, {"type": "subtitle", "time": 12737.91, "timestamp": "03:32:17", "text": "用那些传统的东西"}, {"type": "subtitle", "time": 12740.229, "timestamp": "03:32:20", "text": "公司相关事宜。不，这更像是一种"}, {"type": "subtitle", "time": 12743.07, "timestamp": "03:32:23", "text": "领养方式，你正在签署你的"}, {"type": "subtitle", "time": 12746.95, "timestamp": "03:32:26", "text": "IP地址与故障星星在一起"}, {"type": "subtitle", "time": 12749.03, "timestamp": "03:32:29", "text": "使用他们的服务等等，"}, {"type": "subtitle", "time": 12751.03, "timestamp": "03:32:31", "text": "管理项目以及所有的一切"}, {"type": "subtitle", "time": 12754.309, "timestamp": "03:32:34", "text": "你可以选择首次公开自己的裸体照片。"}, {"type": "subtitle", "time": 12758.55, "timestamp": "03:32:38", "text": "与该机构合作的模特"}, {"type": "subtitle", "time": 12760.71, "timestamp": "03:32:40", "text": "他们提供的支持和联系"}, {"type": "subtitle", "time": 12762.55, "timestamp": "03:32:42", "text": "内部作者以及他们的一切"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "从那里给予，通常就是这样。"}, {"type": "subtitle", "time": 12769.75, "timestamp": "03:32:49", "text": "收养机构运作。所以，如果我"}, {"type": "subtitle", "time": 12773.51, "timestamp": "03:32:53", "text": "回去你可以看到卡桑是"}, {"type": "subtitle", "time": 12775.03, "timestamp": "03:32:55", "text": "首次亮相"}, {"type": "subtitle", "time": 12778.229, "timestamp": "03:32:58", "text": "她和格拉斯一起，即将推出一款新产品。"}]
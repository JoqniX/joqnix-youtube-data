[{"type": "subtitle", "time": 1560.99, "timestamp": "00:26:00", "text": "祖基。跳。"}, {"type": "subtitle", "time": 1562.52, "timestamp": "00:26:02", "text": "跳。 跳。跳。跳。"}, {"type": "subtitle", "time": 1570.23, "timestamp": "00:26:10", "text": "我为这个角色感到难过。每当"}, {"type": "subtitle", "time": 1574.47, "timestamp": "00:26:14", "text": "他跳起来就像摔倒了一样，他像被击中一样。"}, {"type": "subtitle", "time": 1576.19, "timestamp": "00:26:16", "text": "这"}, {"type": "subtitle", "time": 1581.549, "timestamp": "00:26:21", "text": "嗯，他打人就像他打人一样"}, {"type": "subtitle", "time": 1586.51, "timestamp": "00:26:26", "text": "脸朝下摔倒在地。不要感觉"}, {"type": "subtitle", "time": 1595.669, "timestamp": "00:26:35", "text": "强的？这个角色哪里强大了？"}, {"type": "subtitle", "time": 1599.19, "timestamp": "00:26:39", "text": "决心满足"}, {"type": "subtitle", "time": 1611.59, "timestamp": "00:26:51", "text": "是，以及精神上如何，不，嗯，精神上"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "强壮且体格健壮。这就是原因"}]
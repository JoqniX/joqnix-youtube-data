[{"type": "subtitle", "time": 10500.469, "timestamp": "02:55:00", "text": "好玩，没错没错"}, {"type": "subtitle", "time": 10503.07, "timestamp": "02:55:03", "text": "一直以来"}, {"type": "subtitle", "time": 10506.469, "timestamp": "02:55:06", "text": "晚安，我也很高兴。就这样。"}, {"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "我切割的地方"}, {"type": "subtitle", "time": 10510.63, "timestamp": "02:55:10", "text": "挂断电话。好的。是的。"}, {"type": "subtitle", "time": 10513.349, "timestamp": "02:55:13", "text": "是的。是的。是的。谢谢。有"}, {"type": "subtitle", "time": 10516.23, "timestamp": "02:55:16", "text": "很棒。谢谢。晚安"}, {"type": "subtitle", "time": 10518.23, "timestamp": "02:55:18", "text": "也加入你的聊天。我没有。"}, {"type": "subtitle", "time": 10519.83, "timestamp": "02:55:19", "text": "我看了你的聊天记录，晚安。"}, {"type": "subtitle", "time": 10522.87, "timestamp": "02:55:22", "text": "他们。是的。晚安，聊天。每个人"}, {"type": "subtitle", "time": 10525.99, "timestamp": "02:55:25", "text": "道别，准备离开。"}, {"type": "subtitle", "time": 10530.389, "timestamp": "02:55:30", "text": "再见。好的。我倒计时三、二，开始！"}, {"type": "subtitle", "time": 10533.87, "timestamp": "02:55:33", "text": "一。丁丁"}, {"type": "subtitle", "time": 10536.83, "timestamp": "02:55:36", "text": "叮。你好。那"}, {"type": "subtitle", "time": 10540.87, "timestamp": "02:55:40", "text": "重新联系真的很有趣"}, {"type": "subtitle", "time": 10545.309, "timestamp": "02:55:45", "text": "和科德谈谈。我的意思是，我错过了庭审。"}, {"type": "subtitle", "time": 10549.11, "timestamp": "02:55:49", "text": "很多。我错过了很多庭审，我很庆幸……"}, {"type": "subtitle", "time": 10551.429, "timestamp": "02:55:51", "text": "今天终于有机会和Co重新联系上了，而且"}, {"type": "subtitle", "time": 10555.79, "timestamp": "02:55:55", "text": "乐趣。"}, {"type": "subtitle", "time": 10558.59, "timestamp": "02:55:58", "text": "所以，我为此感到高兴。"}]
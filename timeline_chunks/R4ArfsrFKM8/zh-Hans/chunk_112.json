[{"type": "subtitle", "time": 6736.229, "timestamp": "01:52:16", "text": "霍格梅。哦，他真高啊，兄弟。他是"}, {"type": "subtitle", "time": 6752.07, "timestamp": "01:52:32", "text": "今天我不得不推迟直播。"}, {"type": "subtitle", "time": 6755.82, "timestamp": "01:52:35", "text": "因为我睡过头了，所以到11点。"}, {"type": "subtitle", "time": 6764.79, "timestamp": "01:52:44", "text": "[音乐]"}, {"type": "subtitle", "time": 6766.629, "timestamp": "01:52:46", "text": "哦，你又带着新东西回来了……"}, {"type": "subtitle", "time": 6768.27, "timestamp": "01:52:48", "text": "报告。对某些人来说，它有点卡顿。"}, {"type": "subtitle", "time": 6771.87, "timestamp": "01:52:51", "text": "原因。你觉得"}, {"type": "subtitle", "time": 6774.79, "timestamp": "01:52:54", "text": "那？我需要降低分辨率吗？"}, {"type": "subtitle", "time": 6777.31, "timestamp": "01:52:57", "text": "东西？为什么会这样？"}]
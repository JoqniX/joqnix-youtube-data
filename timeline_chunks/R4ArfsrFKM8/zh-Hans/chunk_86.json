[{"type": "subtitle", "time": 5162.229, "timestamp": "01:26:02", "text": "是的。我们当然应该开枪射击。这是"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "乐趣。"}, {"type": "subtitle", "time": 5166.39, "timestamp": "01:26:06", "text": "我们应该那样做，既爱又恨。"}, {"type": "subtitle", "time": 5169.149, "timestamp": "01:26:09", "text": "与……的关系"}, {"type": "chat", "time": 5170.297, "timestamp": "01:26:10", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "fr 😔"}, {"type": "subtitle", "time": 5172.39, "timestamp": "01:26:12", "text": "瓦尔。我会告诉大家不要玩"}, {"type": "subtitle", "time": 5175.99, "timestamp": "01:26:15", "text": "瓦尔，但那时我会在那里玩瓦洛。"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "他们会问：“你为什么在这里？”"}, {"type": "subtitle", "time": 5180.87, "timestamp": "01:26:20", "text": "玩贾尔普尔？我回答说：“因为……”"}, {"type": "subtitle", "time": 5182.87, "timestamp": "01:26:22", "text": "我对它又爱又恨。"}, {"type": "subtitle", "time": 5185.59, "timestamp": "01:26:25", "text": "对不起。我不会向你推荐你。"}, {"type": "subtitle", "time": 5188.39, "timestamp": "01:26:28", "text": "伙计们。我不想让你们受苦。"}, {"type": "subtitle", "time": 5191.91, "timestamp": "01:26:31", "text": "我怎么做呢？所以，就让我受苦吧。"}, {"type": "chat", "time": 5194.105, "timestamp": "01:26:34", "author": "@Firefly__2671", "avatar": "https://yt4.ggpht.com/3WZYI-EaghtDDKgYu2t7zJHTwPSRX4W_D7oxSVjCm4N7mgl2eaFHhiCQLgRHmcsbmXBdMscg6w=s64-c-k-c0x00ffffff-no-rj", "message": "you should definetly try counter strike sometime"}, {"type": "subtitle", "time": 5196.79, "timestamp": "01:26:36", "text": "一个"}, {"type": "subtitle", "time": 5200.55, "timestamp": "01:26:40", "text": "苦难与沉默。嗯。没关系。"}, {"type": "subtitle", "time": 5205.11, "timestamp": "01:26:45", "text": "你玩过另一款游戏《Shinova》吗？"}, {"type": "subtitle", "time": 5208.87, "timestamp": "01:26:48", "text": "不，我想我有一天试过，我"}, {"type": "subtitle", "time": 5211.59, "timestamp": "01:26:51", "text": "想想，但那不是我喜欢的类型。"}, {"type": "subtitle", "time": 5214.39, "timestamp": "01:26:54", "text": "事物。就连漫威也是，我都这么做了。"}, {"type": "subtitle", "time": 5216.79, "timestamp": "01:26:56", "text": "大概两三次吧。我玩了，但是"}, {"type": "subtitle", "time": 5218.83, "timestamp": "01:26:58", "text": "然后我想到它"}]
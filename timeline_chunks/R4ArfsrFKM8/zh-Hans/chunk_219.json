[{"type": "subtitle", "time": 13143.83, "timestamp": "03:39:03", "text": "比如说，你今天从公司辞职了。"}, {"type": "subtitle", "time": 13145.91, "timestamp": "03:39:05", "text": "你的观众和所有人都会"}, {"type": "subtitle", "time": 13148.15, "timestamp": "03:39:08", "text": "就像这样：哦，你还没直播呢。"}, {"type": "subtitle", "time": 13150.07, "timestamp": "03:39:10", "text": "暂时停工，好的，我们会等待。"}, {"type": "subtitle", "time": 13152.79, "timestamp": "03:39:12", "text": "你，3到4个月后，他们会得到一个"}, {"type": "subtitle", "time": 13155.91, "timestamp": "03:39:15", "text": "注意，哦，我毕业了，这就是我"}, {"type": "subtitle", "time": 13157.99, "timestamp": "03:39:17", "text": "毕业公司会这样做"}, {"type": "subtitle", "time": 13160.79, "timestamp": "03:39:20", "text": "公告来了，这很糟糕，但就是这样。"}, {"type": "subtitle", "time": 13163.349, "timestamp": "03:39:23", "text": "比如，如果她要离开，她会得到两分钱。"}, {"type": "subtitle", "time": 13165.19, "timestamp": "03:39:25", "text": "不是这段时期，她可以做"}, {"type": "subtitle", "time": 13167.99, "timestamp": "03:39:27", "text": "她的毕业方向加上她能做到"}, {"type": "subtitle", "time": 13170.15, "timestamp": "03:39:30", "text": "不管我们像什么，比如说"}, {"type": "subtitle", "time": 13174.79, "timestamp": "03:39:34", "text": "假设一下，如果格拉斯"}, {"type": "subtitle", "time": 13178.87, "timestamp": "03:39:38", "text": "要投入诸如新金额之类的资金"}, {"type": "subtitle", "time": 13182.389, "timestamp": "03:39:42", "text": "Glitzas 给予了所有人的模型"}, {"type": "subtitle", "time": 13184.63, "timestamp": "03:39:44", "text": "给予卡萨的设施"}, {"type": "subtitle", "time": 13188.79, "timestamp": "03:39:48", "text": "Kayana Gisan 可以完全购买"}, {"type": "subtitle", "time": 13192.469, "timestamp": "03:39:52", "text": "一个特定的喜欢，一个喜欢，一个价格"}, {"type": "subtitle", "time": 13194.79, "timestamp": "03:39:54", "text": "如果你支付这笔费用，就会有这样的结果。"}, {"type": "subtitle", "time": 13197.349, "timestamp": "03:39:57", "text": "你可以保留它之类的"}, {"type": "subtitle", "time": 13199.11, "timestamp": "03:39:59", "text": "类似这样的事情可能就是"}]
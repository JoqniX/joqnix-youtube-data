[{"type": "subtitle", "time": 660.069, "timestamp": "00:11:00", "text": "就在哈里斯的溪流节拍中"}, {"type": "subtitle", "time": 662.03, "timestamp": "00:11:02", "text": "嗨。呃"}, {"type": "subtitle", "time": 670.43, "timestamp": "00:11:10", "text": "少量。呃，以前有个樱花等着呢"}, {"type": "subtitle", "time": 674.269, "timestamp": "00:11:14", "text": "樱花专辑。是的。"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "尼科。等等，这不是那个。这才是。"}, {"type": "subtitle", "time": 681.069, "timestamp": "00:11:21", "text": "玩。喂。播放这个。"}, {"type": "subtitle", "time": 688.19, "timestamp": "00:11:28", "text": "嗯？"}, {"type": "subtitle", "time": 697.71, "timestamp": "00:11:37", "text": "好的。是的，这很好。我们开始吧"}, {"type": "subtitle", "time": 699.47, "timestamp": "00:11:39", "text": "去。"}, {"type": "subtitle", "time": 702.67, "timestamp": "00:11:42", "text": "你好。唤醒"}, {"type": "subtitle", "time": 705.269, "timestamp": "00:11:45", "text": "向上。如果你需要我美妙的歌声"}, {"type": "subtitle", "time": 708.949, "timestamp": "00:11:48", "text": "语音方面，直接问就行了。我想谈谈。不，是"}, {"type": "subtitle", "time": 710.35, "timestamp": "00:11:50", "text": "坏的。"}, {"type": "subtitle", "time": 713.389, "timestamp": "00:11:53", "text": "BTM。我没看错吧？"}, {"type": "subtitle", "time": 715.71, "timestamp": "00:11:55", "text": "宝贝们。我想知道。"}, {"type": "subtitle", "time": 716.87, "timestamp": "00:11:56", "text": "[音乐]"}]
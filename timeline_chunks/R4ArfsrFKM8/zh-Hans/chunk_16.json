[{"type": "subtitle", "time": 961.829, "timestamp": "00:16:01", "text": "这是件好事，但我只是想帮忙而已。"}, {"type": "subtitle", "time": 963.55, "timestamp": "00:16:03", "text": "我的余额"}, {"type": "subtitle", "time": 965.87, "timestamp": "00:16:05", "text": "今天，洗"}, {"type": "subtitle", "time": 970.509, "timestamp": "00:16:10", "text": "菜肴。嗯，是的，洗碗，做"}, {"type": "subtitle", "time": 973.509, "timestamp": "00:16:13", "text": "茶，诸如此类的东西。只是帮忙而已"}, {"type": "subtitle", "time": 975.069, "timestamp": "00:16:15", "text": "和"}, {"type": "subtitle", "time": 978.67, "timestamp": "00:16:18", "text": "直到家人，你"}, {"type": "subtitle", "time": 984.749, "timestamp": "00:16:24", "text": "抓住"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "向上。可能需要删除一些歌曲"}, {"type": "subtitle", "time": 992.389, "timestamp": "00:16:32", "text": "队列。我能否选择"}, {"type": "subtitle", "time": 995.91, "timestamp": "00:16:35", "text": "在 Spotify 的 Q 列表中选择歌曲"}, {"type": "subtitle", "time": 998.189, "timestamp": "00:16:38", "text": "并删除"}, {"type": "subtitle", "time": 1000.91, "timestamp": "00:16:40", "text": "点击它"}, {"type": "subtitle", "time": 1002.749, "timestamp": "00:16:42", "text": "慢？我"}, {"type": "subtitle", "time": 1006.269, "timestamp": "00:16:46", "text": "真奇怪我竟然没下床。"}, {"type": "subtitle", "time": 1009.59, "timestamp": "00:16:49", "text": "今天。这让我想起了我以前的日子……"}, {"type": "subtitle", "time": 1013.509, "timestamp": "00:16:53", "text": "以前真是懒洋洋的，窝在床上舒服极了。"}, {"type": "subtitle", "time": 1016.15, "timestamp": "00:16:56", "text": "看YouTube，看动漫"}, {"type": "subtitle", "time": 1017.55, "timestamp": "00:16:57", "text": "观看"}]
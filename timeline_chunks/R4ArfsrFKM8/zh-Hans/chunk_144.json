[{"type": "subtitle", "time": 8643.11, "timestamp": "02:24:03", "text": "你不会被踢出公会。"}, {"type": "subtitle", "time": 8644.95, "timestamp": "02:24:04", "text": "当你……时，你会被公会踢出去。"}, {"type": "subtitle", "time": 8648.27, "timestamp": "02:24:08", "text": "捐款不足"}, {"type": "subtitle", "time": 8651.75, "timestamp": "02:24:11", "text": "点赞或类似“是”。这样做你必须这样做。"}, {"type": "subtitle", "time": 8654.79, "timestamp": "02:24:14", "text": "捐赠至少 2,000 点船员积分"}, {"type": "subtitle", "time": 8657.429, "timestamp": "02:24:17", "text": "每周一次。如果你不这样做3"}, {"type": "subtitle", "time": 8660.15, "timestamp": "02:24:20", "text": "几周后，你的公会就被解散了。"}, {"type": "subtitle", "time": 8673.309, "timestamp": "02:24:33", "text": "我的天哪，我记得我创建过一个公会。"}, {"type": "chat", "time": 8673.625, "timestamp": "02:24:33", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "there was no electricity whole day today waiting on battery to run outUCkszU2WH9gy1mb0dV-11UJg/oPgfY_DoKfSXkNAPq8-AgAo"}, {"type": "subtitle", "time": 8677.11, "timestamp": "02:24:37", "text": "而且它确实如此"}, {"type": "subtitle", "time": 8679.99, "timestamp": "02:24:39", "text": "呃，因为我没怎么活跃了。我 我得到了 我得到了"}, {"type": "subtitle", "time": 8682.15, "timestamp": "02:24:42", "text": "事情多了些，我就没怎么活跃了。"}, {"type": "subtitle", "time": 8684.79, "timestamp": "02:24:44", "text": "它真的像擦屁股一样把它踢飞了。"}, {"type": "subtitle", "time": 8690.15, "timestamp": "02:24:50", "text": "整个家族都在一起，而我却在想，为什么还要玩游戏？为什么？"}, {"type": "subtitle", "time": 8692.43, "timestamp": "02:24:52", "text": "唉，可惜我练腹肌练砸了。"}, {"type": "subtitle", "time": 8694.79, "timestamp": "02:24:54", "text": "[音乐]"}, {"type": "subtitle", "time": 8697.83, "timestamp": "02:24:57", "text": "是的，我确实想再玩一遍。"}]
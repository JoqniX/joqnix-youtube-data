[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "不是吧？我为什么会随意地带来"}, {"type": "subtitle", "time": 15063.229, "timestamp": "04:11:03", "text": "他们总是时不时地出现吗？那样太没礼貌了。"}, {"type": "subtitle", "time": 15066.469, "timestamp": "04:11:06", "text": "嗯？比如，如果他们走进我的房间怎么办？"}, {"type": "subtitle", "time": 15069.03, "timestamp": "04:11:09", "text": "直播，他们在看，他们会"}, {"type": "subtitle", "time": 15071.87, "timestamp": "04:11:11", "text": "听我随意地谈论"}, {"type": "subtitle", "time": 15075.349, "timestamp": "04:11:15", "text": "他们和那些东西。你会作何感想？"}, {"type": "subtitle", "time": 15079.269, "timestamp": "04:11:19", "text": "就像我刚才说的那样"}, {"type": "subtitle", "time": 15082.309, "timestamp": "04:11:22", "text": "另一个人走了进来"}, {"type": "subtitle", "time": 15084.75, "timestamp": "04:11:24", "text": "他们就像是："}, {"type": "subtitle", "time": 15088.87, "timestamp": "04:11:28", "text": "“哇。”就是这样，对吧？是的。我 我 我"}, {"type": "subtitle", "time": 15091.429, "timestamp": "04:11:31", "text": "开始意识到一些"}, {"type": "subtitle", "time": 15093.79, "timestamp": "04:11:33", "text": "我在内部犯的错误"}, {"type": "subtitle", "time": 15096.389, "timestamp": "04:11:36", "text": "乔森和我认为我应该改进"}, {"type": "subtitle", "time": 15097.15, "timestamp": "04:11:37", "text": "从"}, {"type": "subtitle", "time": 15099.07, "timestamp": "04:11:39", "text": "那个和"}, {"type": "subtitle", "time": 15102.63, "timestamp": "04:11:42", "text": "明白我哪里做错了。"}, {"type": "subtitle", "time": 15105.269, "timestamp": "04:11:45", "text": "这又是一次反复试验。"}, {"type": "chat", "time": 15110.759, "timestamp": "04:11:50", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "good man learn from mistakes"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "好的，不不，别担心，别担心。"}, {"type": "subtitle", "time": 15116.15, "timestamp": "04:11:56", "text": "只是我理解了一些"}, {"type": "subtitle", "time": 15118.469, "timestamp": "04:11:58", "text": "我不该做的事。库兹"}]
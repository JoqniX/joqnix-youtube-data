[{"type": "subtitle", "time": 1865.389, "timestamp": "00:31:05", "text": "生活和一切都好吗？怎么样？"}, {"type": "subtitle", "time": 1868.63, "timestamp": "00:31:08", "text": "惊人的？哦，东西收拾得差不多了，不过还是"}, {"type": "subtitle", "time": 1871.99, "timestamp": "00:31:11", "text": "做好事之类的。就像有"}, {"type": "subtitle", "time": 1874.47, "timestamp": "00:31:14", "text": "忙碌的日子，以及像……这样的日子"}, {"type": "subtitle", "time": 1877.83, "timestamp": "00:31:17", "text": "我的工作效率很高，但我确实设法……"}, {"type": "subtitle", "time": 1883.029, "timestamp": "00:31:23", "text": "比如给自己一些独处的时间，或者类似的东西"}, {"type": "subtitle", "time": 1885.35, "timestamp": "00:31:25", "text": "让自己忙起来护肤什么的"}, {"type": "subtitle", "time": 1887.75, "timestamp": "00:31:27", "text": "就是这样。所以基本上就是我拥有"}, {"type": "subtitle", "time": 1891.11, "timestamp": "00:31:31", "text": "寓工作于乐趣。是的，就是这样。"}, {"type": "subtitle", "time": 1893.51, "timestamp": "00:31:33", "text": "最近我的生活发生了变化。怎么回事？"}, {"type": "subtitle", "time": 1900.07, "timestamp": "00:31:40", "text": "你？对我来说，呃，就是努力拼搏。"}, {"type": "subtitle", "time": 1904.47, "timestamp": "00:31:44", "text": "还有这一点。太棒了，兄弟。"}, {"type": "subtitle", "time": 1906.389, "timestamp": "00:31:46", "text": "下个月，我就要离开了。"}, {"type": "subtitle", "time": 1910.149, "timestamp": "00:31:50", "text": "现在。所以，我只有一个。不，本周"}, {"type": "subtitle", "time": 1914.31, "timestamp": "00:31:54", "text": "我想，接下来就只剩一周了。我当时"}, {"type": "subtitle", "time": 1916.789, "timestamp": "00:31:56", "text": "考虑在……之前完成合作"}, {"type": "subtitle", "time": 1919.269, "timestamp": "00:31:59", "text": "下下周六。"}]
[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "天。你好。我们先从她的四肢开始。"}, {"type": "subtitle", "time": 7088.27, "timestamp": "01:58:08", "text": "你好。你好。"}, {"type": "subtitle", "time": 7090.709, "timestamp": "01:58:10", "text": "的确。只有我一个人。哦，哇。你"}, {"type": "subtitle", "time": 7092.39, "timestamp": "01:58:12", "text": "我居然还留着那张老照片。"}, {"type": "subtitle", "time": 7095.43, "timestamp": "01:58:15", "text": "你是怎么找到的？那是迪斯科舞厅"}, {"type": "subtitle", "time": 7096.75, "timestamp": "01:58:16", "text": "反应性"}, {"type": "subtitle", "time": 7100.63, "timestamp": "01:58:20", "text": "做。我的天哪，我错过了这个。"}, {"type": "subtitle", "time": 7102.47, "timestamp": "01:58:22", "text": "[笑声]"}, {"type": "subtitle", "time": 7105.91, "timestamp": "01:58:25", "text": "的确。的确。迪奥，我想你了。它是"}, {"type": "subtitle", "time": 7109.43, "timestamp": "01:58:29", "text": "已经很久了。我的天啊。是的，一直都是这样。"}, {"type": "subtitle", "time": 7111.99, "timestamp": "01:58:31", "text": "我觉得大概是这样的？ 3年"}, {"type": "subtitle", "time": 7113.99, "timestamp": "01:58:33", "text": "现在，我想是这样。几乎。我想，嗯，是的。"}, {"type": "subtitle", "time": 7115.91, "timestamp": "01:58:35", "text": "我想现在已经过去三年了。"}, {"type": "subtitle", "time": 7119.27, "timestamp": "01:58:39", "text": "是的，三年了。是的。三或"}, {"type": "subtitle", "time": 7121.75, "timestamp": "01:58:41", "text": "四年。是的。"}, {"type": "subtitle", "time": 7124.629, "timestamp": "01:58:44", "text": "我最后一次记得是你要得到"}, {"type": "subtitle", "time": 7131.91, "timestamp": "01:58:51", "text": "是的，我深度参与其中"}, {"type": "subtitle", "time": 7134.47, "timestamp": "01:58:54", "text": "《幻想之塔》现已举办锦标赛。"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "还有其他一些东西。是的。太疯狂了。这"}]
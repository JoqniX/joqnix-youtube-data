[{"type": "subtitle", "time": 9060.27, "timestamp": "02:31:00", "text": "某物。致命"}, {"type": "subtitle", "time": 9063.75, "timestamp": "02:31:03", "text": "公司。你试过吗？"}, {"type": "subtitle", "time": 9066.75, "timestamp": "02:31:06", "text": "是的，我们确实在我的小公司里玩过游戏。"}, {"type": "subtitle", "time": 9071.07, "timestamp": "02:31:11", "text": "社区。嗯，我想那就是结局。"}, {"type": "subtitle", "time": 9073.75, "timestamp": "02:31:13", "text": "2023年还是2024年？我记不太清了。"}, {"type": "subtitle", "time": 9077.03, "timestamp": "02:31:17", "text": "但我们确实玩了，而且相当不错。"}, {"type": "subtitle", "time": 9081.429, "timestamp": "02:31:21", "text": "这家有趣的小公司真的太搞笑了。"}, {"type": "subtitle", "time": 9083.59, "timestamp": "02:31:23", "text": "我们也做了一些。是的。我们"}, {"type": "subtitle", "time": 9088.79, "timestamp": "02:31:28", "text": "也玩了一会儿GTA Online。嗯，是的。"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "我想应该还有一两个吧。"}, {"type": "subtitle", "time": 9093.79, "timestamp": "02:31:33", "text": "还有更多游戏。我不记得了"}, {"type": "subtitle", "time": 9096.63, "timestamp": "02:31:36", "text": "姓名。是的，我们当然是在聊天。所以"}, {"type": "subtitle", "time": 9100.15, "timestamp": "02:31:40", "text": "那是另一个主题，呃……"}, {"type": "subtitle", "time": 9102.15, "timestamp": "02:31:42", "text": "是的，我想那是我玩过的三款游戏。"}, {"type": "subtitle", "time": 9104.95, "timestamp": "02:31:44", "text": "现在我脑子里一片空白，想不起来了。"}, {"type": "subtitle", "time": 9113.51, "timestamp": "02:31:53", "text": "就像TF奇幻社区里的社区一样"}, {"type": "subtitle", "time": 9115.83, "timestamp": "02:31:55", "text": "或者像你的社区一样"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "正在发展壮大的奇幻社区"}]
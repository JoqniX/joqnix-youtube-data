[{"type": "subtitle", "time": 5640.229, "timestamp": "01:34:00", "text": "嗯，我很乐意。"}, {"type": "subtitle", "time": 5644.709, "timestamp": "01:34:04", "text": "我在我的PS4里需要速度"}, {"type": "subtitle", "time": 5646.87, "timestamp": "01:34:06", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 5649.51, "timestamp": "01:34:09", "text": "是的。我完了。"}, {"type": "subtitle", "time": 5652.79, "timestamp": "01:34:12", "text": "啊，不错。哦，你有PS4啊。那挺好的。"}, {"type": "subtitle", "time": 5655.83, "timestamp": "01:34:15", "text": "不，我不擅长操作手柄。"}, {"type": "subtitle", "time": 5657.75, "timestamp": "01:34:17", "text": "我特别擅长使用游戏手柄。它是"}, {"type": "subtitle", "time": 5661.43, "timestamp": "01:34:21", "text": "就像我一样，我也有那些游戏。"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "《真人快打》、《铁拳》等等。哦，"}, {"type": "subtitle", "time": 5669.03, "timestamp": "01:34:29", "text": "好的。我确实有。是的，"}, {"type": "subtitle", "time": 5671.91, "timestamp": "01:34:31", "text": "这算不上硬核啊兄弟。我更"}, {"type": "subtitle", "time": 5676.229, "timestamp": "01:34:36", "text": "比起软弱的人，游戏玩家更嗜血。"}, {"type": "subtitle", "time": 5679.59, "timestamp": "01:34:39", "text": "游戏玩家。我的天啊。等等，你刚才有……"}, {"type": "subtitle", "time": 5681.75, "timestamp": "01:34:41", "text": "你是不是手柄坏了？"}, {"type": "subtitle", "time": 5683.51, "timestamp": "01:34:43", "text": "或者因为你喜欢敲击之类的"}, {"type": "subtitle", "time": 5684.83, "timestamp": "01:34:44", "text": "如此多"}, {"type": "subtitle", "time": 5687.91, "timestamp": "01:34:47", "text": "按钮会随着时间推移而变化吗？是的。你曾经有过吗？"}, {"type": "subtitle", "time": 5690.79, "timestamp": "01:34:50", "text": "你的PS4手柄突然没电了"}, {"type": "subtitle", "time": 5694.39, "timestamp": "01:34:54", "text": "或者出了什么问题，比如不工作之类的？"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "不。对。不，不，不，不，不是这样的。"}]
[{"type": "subtitle", "time": 10080.15, "timestamp": "02:48:00", "text": "触碰。是的。是的。听起来不错。是的。"}, {"type": "subtitle", "time": 10081.99, "timestamp": "02:48:01", "text": "是的。我们应该玩G。我们应该玩"}, {"type": "subtitle", "time": 10083.59, "timestamp": "02:48:03", "text": "一起玩《幻想之塔》。你应该"}, {"type": "subtitle", "time": 10085.75, "timestamp": "02:48:05", "text": "如果你愿意的话，带我四处看看，带我去所有地方。"}, {"type": "subtitle", "time": 10089.03, "timestamp": "02:48:09", "text": "免费一天。当然可以。听起来不错。"}, {"type": "subtitle", "time": 10091.269, "timestamp": "02:48:11", "text": "是的，等我拿到笔记本电脑之后……"}, {"type": "subtitle", "time": 10094.79, "timestamp": "02:48:14", "text": "所有事情在八月或七月之前都安排妥当了。"}, {"type": "subtitle", "time": 10097.99, "timestamp": "02:48:17", "text": "或者别的什么，我就……嗯，好吧，呃……"}, {"type": "subtitle", "time": 10100.71, "timestamp": "02:48:20", "text": "之后在日本，我会确保"}, {"type": "subtitle", "time": 10103.67, "timestamp": "02:48:23", "text": "我可以直播、玩游戏什么的。然后"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "好啊，我们可以安排时间一起出去玩。"}, {"type": "subtitle", "time": 10110.15, "timestamp": "02:48:30", "text": "还有其他一些东西。那肯定很有趣。等不及了。"}, {"type": "subtitle", "time": 10115.59, "timestamp": "02:48:35", "text": "是的。是的。呃，在你离开之前呃"}, {"type": "subtitle", "time": 10118.389, "timestamp": "02:48:38", "text": "您有什么信息或公告吗？"}, {"type": "subtitle", "time": 10122.309, "timestamp": "02:48:42", "text": "或者你想制作什么其他东西？"}, {"type": "subtitle", "time": 10124.15, "timestamp": "02:48:44", "text": "如果非要说“公告”，我就这么说吧。"}, {"type": "subtitle", "time": 10125.83, "timestamp": "02:48:45", "text": "祝你好运"}, {"type": "subtitle", "time": 10130.389, "timestamp": "02:48:50", "text": "日本的努力，就像你一样"}, {"type": "subtitle", "time": 10133.11, "timestamp": "02:48:53", "text": "你喜欢在那里安顿下来，"}, {"type": "subtitle", "time": 10136.389, "timestamp": "02:48:56", "text": "享受在日本的生活。是啊，我也是。我"}, {"type": "subtitle", "time": 10138.87, "timestamp": "02:48:58", "text": "也会有同样的愿望。"}]
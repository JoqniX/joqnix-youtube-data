[{"type": "subtitle", "time": 8580.309, "timestamp": "02:23:00", "text": "贫困世界呃游戏谁已经接受了"}, {"type": "subtitle", "time": 8582.95, "timestamp": "02:23:02", "text": "负责幻想之塔全球事务。"}, {"type": "subtitle", "time": 8586.07, "timestamp": "02:23:06", "text": "所以现在他们正在处理这件事，而且在处理过程中"}, {"type": "subtitle", "time": 8587.429, "timestamp": "02:23:07", "text": "在这个过程中，发生了所有的事情"}, {"type": "subtitle", "time": 8589.99, "timestamp": "02:23:09", "text": "账户转账等等。所以你"}, {"type": "subtitle", "time": 8591.99, "timestamp": "02:23:11", "text": "必须授权您的帐户才能"}, {"type": "subtitle", "time": 8596.07, "timestamp": "02:23:16", "text": "要么转账，要么作废。哦，是的。所以"}, {"type": "subtitle", "time": 8598.75, "timestamp": "02:23:18", "text": "这一切都发生了。嗯，一切都结束了。"}, {"type": "subtitle", "time": 8603.349, "timestamp": "02:23:23", "text": "四月底之后就一直到现在"}, {"type": "subtitle", "time": 8607.59, "timestamp": "02:23:27", "text": "完全受PWG控制，而且一直如此。"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "一切顺利，应该挺好的。"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "现在断言这会如何影响还为时过早。"}, {"type": "subtitle", "time": 8614.55, "timestamp": "02:23:34", "text": "过渡是指这种过渡是否良好。"}, {"type": "subtitle", "time": 8618.15, "timestamp": "02:23:38", "text": "或者说很糟糕，因为就像过去了两个3年一样。"}, {"type": "subtitle", "time": 8621.11, "timestamp": "02:23:41", "text": "至今已累计数月。"}, {"type": "subtitle", "time": 8623.349, "timestamp": "02:23:43", "text": "但我们最终会知道的。但是，"}, {"type": "subtitle", "time": 8626.23, "timestamp": "02:23:46", "text": "远古奇幻小说很不错。你仍然会得到"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "你提供的这种令人惊叹的定制服务"}, {"type": "subtitle", "time": 8629.91, "timestamp": "02:23:49", "text": "实在没别的办法了。是的。"}]
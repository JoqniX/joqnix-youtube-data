[{"type": "subtitle", "time": 8840.23, "timestamp": "02:27:20", "text": "像動漫音樂、聲樂、日本音樂。我甚至"}, {"type": "subtitle", "time": 8841.19, "timestamp": "02:27:21", "text": "還會聽日文歌曲之類的"}, {"type": "subtitle", "time": 8856.07, "timestamp": "02:27:36", "text": "嗯，我平常會看動漫之類的。大概六年前，我第一次接觸到動畫。我不知道《"}, {"type": "subtitle", "time": 8859.11, "timestamp": "02:27:39", "text": "鬼滅之刃》是什麼時候開播的，反正我當時特別迷《鬼滅之刃》，我學會了片頭曲，然後又學會了《藍鳥之歌》，還有《"}]
[{"type": "subtitle", "time": 6264.07, "timestamp": "01:44:24", "text": "我得每隔兩小時左右就會充電一次。情況就是這麼糟糕，所以我一直讓它充電。  這就是我遇到的問題。我以前會整晚充電，然後它就突然"}, {"type": "subtitle", "time": 6280.47, "timestamp": "01:44:40", "text": "啟動了"}, {"type": "subtitle", "time": 6291.43, "timestamp": "01:44:51", "text": "現在我沒有好手機了。我用的是舊款。  所以"}]
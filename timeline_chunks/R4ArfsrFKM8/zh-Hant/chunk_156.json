[{"type": "subtitle", "time": 9371.19, "timestamp": "02:36:11", "text": "哦，他把它寫在聊天記錄裡了。我的天啊。你應該這麼做，喬。  我們"}, {"type": "subtitle", "time": 9375.51, "timestamp": "02:36:15", "text": "走吧。大家為喬克鼓掌！我們需要它。我們需要給他造勢。是的"}, {"type": "subtitle", "time": 9385.429, "timestamp": "02:36:25", "text": "，他真的毀了"}, {"type": "subtitle", "time": 9390.07, "timestamp": "02:36:30", "text": "一切。我的天啊。"}, {"type": "subtitle", "time": 9403.27, "timestamp": "02:36:43", "text": "我的天啊。  等等，讓我先在椅子上站穩。好的。你好"}]
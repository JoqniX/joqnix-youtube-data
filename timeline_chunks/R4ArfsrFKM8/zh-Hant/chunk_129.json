[{"type": "subtitle", "time": 7740.95, "timestamp": "02:09:00", "text": "我一直在贏，然後有些人來了，開始對我破口大罵，我就開始討厭《Valerant》了，因為我玩不好了。這就好比"}, {"type": "subtitle", "time": 7756.629, "timestamp": "02:09:16", "text": "你生命中遇到的那個女人，她一方面說你的好話，一方面又在背後說你的壞話，就像我的父母一樣，但我"}, {"type": "subtitle", "time": 7762.55, "timestamp": "02:09:22", "text": "不能離開，因為我忠誠。"}, {"type": "subtitle", "time": 7793.75, "timestamp": "02:09:53", "text": "這就是我和"}, {"type": "subtitle", "time": 7796.95, "timestamp": "02:09:56", "text": "Valerant之間的三角戀情"}, {"type": "subtitle", "time": 7799.669, "timestamp": "02:09:59", "text": "。  我和我的另一半，我的個性讓我陷入了困境。我只希望你沒在那款"}]
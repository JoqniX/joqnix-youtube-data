[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "。  就連"}, {"type": "subtitle", "time": 7095.43, "timestamp": "01:58:15", "text": "阿斯特拉都建議我去認識一些人甚麼的，但我就是太害怕和陌生人接觸了，所以我總是阻止自己和他們互動，"}, {"type": "subtitle", "time": 7100.63, "timestamp": "01:58:20", "text": "我也不知道該和他們說"}, {"type": "subtitle", "time": 7111.99, "timestamp": "01:58:31", "text": "什麼。所以，是的，我就待在"}]
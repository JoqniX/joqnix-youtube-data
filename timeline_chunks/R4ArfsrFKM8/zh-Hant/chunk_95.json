[{"type": "subtitle", "time": 5712.55, "timestamp": "01:35:12", "text": "戴上牙套，所以當時很疼，然後那傢伙就打了我"}, {"type": "subtitle", "time": 5721.83, "timestamp": "01:35:21", "text": "。我當時氣瘋了。"}, {"type": "subtitle", "time": 5728.47, "timestamp": "01:35:28", "text": "我的天啊。他打你了？  什麼？他甚至"}, {"type": "subtitle", "time": 5734.709, "timestamp": "01:35:34", "text": "都沒吃我？是的，他用球砸到我了。不。"}, {"type": "subtitle", "time": 5748.87, "timestamp": "01:35:48", "text": "啊，是的。是的。"}, {"type": "subtitle", "time": 5751.669, "timestamp": "01:35:51", "text": "好的。好的。是的。"}]
[{"type": "subtitle", "time": 9071.07, "timestamp": "02:31:11", "text": "體內內建的系統。所以你天生就擅長跳舞。沒錯，"}, {"type": "subtitle", "time": 9077.03, "timestamp": "02:31:17", "text": "跳舞什麼的真的很"}, {"type": "subtitle", "time": 9081.429, "timestamp": "02:31:21", "text": "有趣。  [音樂] 我一直有個"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "想法，如果有一天，我們這種放克"}, {"type": "subtitle", "time": 9113.51, "timestamp": "02:31:53", "text": "在印度流行起來，"}, {"type": "subtitle", "time": 9115.83, "timestamp": "02:31:55", "text": "或者像現在這樣普及開來，那麼這麼多年過去了，"}]
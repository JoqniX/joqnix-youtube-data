[{"type": "subtitle", "time": 8247.429, "timestamp": "02:17:27", "text": "聊天室裡的各位最近怎麼樣？希望"}, {"type": "subtitle", "time": 8251.709, "timestamp": "02:17:31", "text": "你們一切都好。我的超強能量瓶又回來了。耶。歡迎回來。"}, {"type": "subtitle", "time": 8255.95, "timestamp": "02:17:35", "text": "好的。什麼"}, {"type": "subtitle", "time": 8262.389, "timestamp": "02:17:42", "text": "？這就是我說的「肌肉發達」時你腦海中浮現的畫面。不"}, {"type": "subtitle", "time": 8271.03, "timestamp": "02:17:51", "text": "，"}, {"type": "subtitle", "time": 8277.99, "timestamp": "02:17:57", "text": "我當時想的是"}]
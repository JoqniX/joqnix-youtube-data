[{"type": "subtitle", "time": 6924.709, "timestamp": "01:55:24", "text": "光的事，我現在就要去質問他。"}, {"type": "subtitle", "time": 6931.75, "timestamp": "01:55:31", "text": "我說得對嗎，閨蜜"}, {"type": "subtitle", "time": 6941.91, "timestamp": "01:55:41", "text": "？我說的對嗎？我重回正軌了，寶貝。好的。  好的。好的。"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "太棒了"}, {"type": "subtitle", "time": 6948.109, "timestamp": "01:55:48", "text": "。說到生意上的事，我記得你的"}, {"type": "subtitle", "time": 6953.27, "timestamp": "01:55:53", "text": "朋友是 Rain Peter Shan，對吧？"}]
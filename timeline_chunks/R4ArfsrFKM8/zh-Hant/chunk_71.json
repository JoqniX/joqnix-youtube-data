[{"type": "subtitle", "time": 4267.83, "timestamp": "01:11:07", "text": "我去過州級之類的機構。所以人們過去都叫我「jalpuri」。"}, {"type": "subtitle", "time": 4294.669, "timestamp": "01:11:34", "text": "美人魚一樣！"}, {"type": "subtitle", "time": 4300.229, "timestamp": "01:11:40", "text": "好的。  所以"}, {"type": "subtitle", "time": 4312.63, "timestamp": "01:11:52", "text": "我覺得它就像是"}]
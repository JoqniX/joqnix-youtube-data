[{"type": "subtitle", "time": 7035.27, "timestamp": "01:57:15", "text": "我從達茲那裡聽說了不少關於她的事。  你認識達茲嗎"}, {"type": "subtitle", "time": 7065.229, "timestamp": "01:57:45", "text": "不，其實"}, {"type": "subtitle", "time": 7069.149, "timestamp": "01:57:49", "text": "我在這個社區只認識幾個人，而且因為我跟你說過我"}, {"type": "subtitle", "time": 7075.47, "timestamp": "01:57:55", "text": "社交能力不好"}]
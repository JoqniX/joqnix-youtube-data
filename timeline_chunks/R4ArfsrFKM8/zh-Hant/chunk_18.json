[{"type": "subtitle", "time": 1090.789, "timestamp": "00:18:10", "text": "後綴"}, {"type": "subtitle", "time": 1101.47, "timestamp": "00:18:21", "text": "。為什麼不早點說？我確實私"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "訊過你，Zuki。媽的。啊，它確實賦予了版權。啊，疼痛。耽誤。耽誤。  舉起手來。耽誤。我的火焰之"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "針。我的針頭著火了。耽誤。"}]
[{"type": "subtitle", "time": 1762.63, "timestamp": "00:29:22", "text": "試試班尼佛洛伊德的那個"}, {"type": "subtitle", "time": 1772.029, "timestamp": "00:29:32", "text": "玩意兒。呃，它叫"}, {"type": "subtitle", "time": 1781.11, "timestamp": "00:29:41", "text": "什麼來著？呃，就是那個有個禿頭男，呃，在一個鍋子裡的東西。我想嘗試速通之類的。這將會是一場有趣的遊戲。我"}]
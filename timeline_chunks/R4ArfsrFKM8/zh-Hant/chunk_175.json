[{"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "我現在在直播什麼的。那你喜歡像《艾爾登法環》之類的靈魂遊戲嗎？我很想玩"}, {"type": "subtitle", "time": 10519.83, "timestamp": "02:55:19", "text": "，但我還沒玩過這類遊戲。不過我很想玩"}, {"type": "subtitle", "time": 10522.87, "timestamp": "02:55:22", "text": "。啊，不錯，不錯，不錯。就像我想玩《生化危機》之類的。"}, {"type": "subtitle", "time": 10536.83, "timestamp": "02:55:36", "text": "啊，那種恐怖遊戲。你玩過那些"}, {"type": "subtitle", "time": 10551.429, "timestamp": "02:55:51", "text": "日式恐怖遊戲嗎？我還沒玩過。你能推薦一些我可以玩的嗎？"}, {"type": "subtitle", "time": 10558.59, "timestamp": "02:55:58", "text": "比如說你"}]
[{"type": "subtitle", "time": 5703.03, "timestamp": "01:35:03", "text": "讓我用鼻子輕輕碰碰你。  啵。"}, {"type": "subtitle", "time": 5718.189, "timestamp": "01:35:18", "text": "你聽到了嗎？我在戳你"}, {"type": "subtitle", "time": 5722.04, "timestamp": "01:35:22", "text": "。真是太尷尬了。我的天啊"}, {"type": "subtitle", "time": 5724.11, "timestamp": "01:35:24", "text": "（音樂）"}, {"type": "subtitle", "time": 5727.03, "timestamp": "01:35:27", "text": "。我的天啊。我做了。我的天啊。  真"}, {"type": "subtitle", "time": 5728.59, "timestamp": "01:35:28", "text": "不敢相信我竟然做了那種事"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "啊。等等"}]
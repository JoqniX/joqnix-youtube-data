[{"type": "subtitle", "time": 4339.59, "timestamp": "01:12:19", "text": "後右和右。靠近右。最後一個玩家站立。78 ["}, {"type": "subtitle", "time": 4343.43, "timestamp": "01:12:23", "text": "音樂] 78 開始。 啊"}, {"type": "subtitle", "time": 4355.55, "timestamp": "01:12:35", "text": "，雪景真漂亮。 是的。特勤幹員。有人能發現我嗎？有人發現我了嗎？他們有"}, {"type": "subtitle", "time": 4361.43, "timestamp": "01:12:41", "text": "很多錢。我想買"}]
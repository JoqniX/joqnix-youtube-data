[{"type": "subtitle", "time": 5405.43, "timestamp": "01:30:05", "text": "直播的，對吧"}, {"type": "subtitle", "time": 5413.75, "timestamp": "01:30:13", "text": "？生日快樂，是的，她也祝我生日快樂"}, {"type": "subtitle", "time": 5432.47, "timestamp": "01:30:32", "text": "。希望你今天過得愉快。如果我"}, {"type": "subtitle", "time": 5435.27, "timestamp": "01:30:35", "text": "沒記錯的話，每個人都是勤勞的牛仔。"}, {"type": "subtitle", "time": 5457.91, "timestamp": "01:30:57", "text": "不，我的意思是莫也盡力了"}]
[{"type": "subtitle", "time": 1462.39, "timestamp": "00:24:22", "text": "你做了什麼"}, {"type": "subtitle", "time": 1467.029, "timestamp": "00:24:27", "text": "？  我們的電信商宕機了。中路下墜。"}, {"type": "subtitle", "time": 1485.99, "timestamp": "00:24:45", "text": "[音樂]"}, {"type": "subtitle", "time": 1488.63, "timestamp": "00:24:48", "text": "最後的倖存者。還剩一個敵人。  還剩30秒。  我被下藥了。一隻鷹飛出來了。敵方"}]
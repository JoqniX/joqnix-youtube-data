[{"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "啊，我沒看到韋恩。"}, {"type": "subtitle", "time": 1994.269, "timestamp": "00:33:14", "text": "你想玩嗎？讓我們玩。讓我們玩。  掃興的人沒有看到下面的"}, {"type": "subtitle", "time": 2012.75, "timestamp": "00:33:32", "text": "雨水正在傾盆而下。  不過，"}, {"type": "subtitle", "time": 2014.99, "timestamp": "00:33:34", "text": "沒關係。  你當時在玩弄瓦爾，卻沒告訴我們。"}]
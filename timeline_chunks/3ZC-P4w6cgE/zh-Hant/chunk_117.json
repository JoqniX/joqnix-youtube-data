[{"type": "subtitle", "time": 7053.189, "timestamp": "01:57:33", "text": "近期會直播玩《Among Us》。  是的。好的。是的。好了"}, {"type": "subtitle", "time": 7056.109, "timestamp": "01:57:36", "text": "，這就是全部人員了。"}, {"type": "subtitle", "time": 7070.229, "timestamp": "01:57:50", "text": "我點名批評了你們每一個人。  剛才過來的那個人是 Mad Gameran。謝謝你們的光臨，也謝謝你們。希望"}]
[{"type": "subtitle", "time": 20161.67, "timestamp": "05:36:01", "text": "我在服務期間遇到了你們所有人。始就陪伴著我，即使現在"}, {"type": "subtitle", "time": 20168.788, "timestamp": "05:36:08", "text": "不是第一天了，還有很多從第一天起就"}, {"type": "subtitle", "time": 20198.07, "timestamp": "05:36:38", "text": "支持我的觀眾和支持者仍然和我保持聯繫，"}, {"type": "subtitle", "time": 20207.51, "timestamp": "05:36:47", "text": "我真的很"}, {"type": "subtitle", "time": 20217.43, "timestamp": "05:36:57", "text": "高興能見到他們所有人，直到今天依然如此。我就像，咚咚咚咚。  H：那是我的標誌嗎？"}]
[{"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "我拿到了"}, {"type": "subtitle", "time": 3854.23, "timestamp": "01:04:14", "text": "炸彈。[音樂]媽媽。"}, {"type": "subtitle", "time": 3859.43, "timestamp": "01:04:19", "text": "好吃。下去下去。得去那兒"}, {"type": "subtitle", "time": 3866.91, "timestamp": "01:04:26", "text": "。你在哪裡"}, {"type": "subtitle", "time": 3869.71, "timestamp": "01:04:29", "text": "？低，低，低。"}, {"type": "subtitle", "time": 3872.19, "timestamp": "01:04:32", "text": "突破。低。突破。低。側移。後退一步。最後一名玩家存活。我的天啊。晚安。好的。是的。傳奇之戰。等等，背靠背。等等，什麼？什麼特工？什麼？我沒被"}]
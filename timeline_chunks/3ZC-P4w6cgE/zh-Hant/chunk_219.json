[{"type": "subtitle", "time": 13149.349, "timestamp": "03:39:09", "text": "你看到"}, {"type": "subtitle", "time": 13151.99, "timestamp": "03:39:11", "text": "白色靜電干擾時，你就像這樣躲在牆邊。完全側翻。讓開。然後我速通了"}, {"type": "subtitle", "time": 13159.349, "timestamp": "03:39:19", "text": "這個關卡。"}, {"type": "subtitle", "time": 13167.389, "timestamp": "03:39:27", "text": "[音樂] 哦，糟糕。  [音樂]"}, {"type": "subtitle", "time": 13170.07, "timestamp": "03:39:30", "text": "我想我或許可以復活。哦"}, {"type": "subtitle", "time": 13181.83, "timestamp": "03:39:41", "text": "，是的。我的天哪。你居然復活了。"}]
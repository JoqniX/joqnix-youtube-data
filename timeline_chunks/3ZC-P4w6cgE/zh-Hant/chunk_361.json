[{"type": "subtitle", "time": 21678.15, "timestamp": "06:01:18", "text": "音樂"}, {"type": "subtitle", "time": 21702.548, "timestamp": "06:01:42", "text": "牆會稍微低一些。嗨。那麼，"}, {"type": "subtitle", "time": 21707.35, "timestamp": "06:01:47", "text": "我們繼續吧？嘿，你看，你其實能看到我"}, {"type": "subtitle", "time": 21718.07, "timestamp": "06:01:58", "text": "。但我難道不應該躲起來嗎？我也會這樣。"}]
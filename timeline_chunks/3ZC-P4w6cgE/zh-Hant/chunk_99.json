[{"type": "subtitle", "time": 5959.47, "timestamp": "01:39:19", "text": "不是非Vuber嗎？它不是騎師的手，也不是運動員的"}, {"type": "subtitle", "time": 5964.43, "timestamp": "01:39:24", "text": "手。 」哦，我會說：「是的，"}, {"type": "subtitle", "time": 5967.51, "timestamp": "01:39:27", "text": "那是我的手，但我給"}, {"type": "subtitle", "time": 5972.109, "timestamp": "01:39:32", "text": "我的手取名叫 Ho Chama，所以別"}, {"type": "subtitle", "time": 5975.59, "timestamp": "01:39:35", "text": "擔心，就像我給"}, {"type": "subtitle", "time": 5979.75, "timestamp": "01:39:39", "text": "我的滑鼠、鍵盤取名叫 Chama Monama 一樣。 「媽媽的"}, {"type": "subtitle", "time": 5983.59, "timestamp": "01:39:43", "text": "照片，我的什麼？我的枕頭。萬物皆有"}]
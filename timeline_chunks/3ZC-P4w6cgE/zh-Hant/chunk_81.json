[{"type": "subtitle", "time": 4891.149, "timestamp": "01:21:31", "text": "今天光臨，也祝您聖誕快樂。也"}, {"type": "subtitle", "time": 4900.43, "timestamp": "01:21:40", "text": "歡迎你下次光臨，還有，如果"}, {"type": "subtitle", "time": 4907.51, "timestamp": "01:21:47", "text": "你下次再來，希望你能多說幾句，這樣我就可以和你互動，也希望你更了解爸爸爸爸，"}, {"type": "subtitle", "time": 4913.189, "timestamp": "01:21:53", "text": "謝謝你的光臨。也祝"}]
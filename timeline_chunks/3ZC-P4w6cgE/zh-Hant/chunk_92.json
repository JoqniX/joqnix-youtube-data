[{"type": "subtitle", "time": 5543.43, "timestamp": "01:32:23", "text": "他們什麼都不"}, {"type": "subtitle", "time": 5546.07, "timestamp": "01:32:26", "text": "想做，但又想做點什麼，即使他們整天在手機上消磨時間，或者"}, {"type": "subtitle", "time": 5547.709, "timestamp": "01:32:27", "text": "做一些也"}, {"type": "subtitle", "time": 5577.629, "timestamp": "01:32:57", "text": "[音樂]"}]
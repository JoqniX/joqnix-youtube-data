[{"type": "subtitle", "time": 12619.11, "timestamp": "03:30:19", "text": "傷害你。好的。  匆忙。你仍然擁有它。是的。我不知道"}, {"type": "subtitle", "time": 12627.429, "timestamp": "03:30:27", "text": "為什麼。  好的。好的。跳。跳。好的。我認為你可以用它來指認"}, {"type": "subtitle", "time": 12636.229, "timestamp": "03:30:36", "text": "鑰匙孔。我猜這是重複利用。  哦"}, {"type": "subtitle", "time": 12644.63, "timestamp": "03:30:44", "text": "，對，這裡"}]
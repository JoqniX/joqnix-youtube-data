[{"type": "subtitle", "time": 20405.11, "timestamp": "05:40:05", "text": "H：我想知道那是什麼。等等。那是什麼？那是個點嗎？"}, {"type": "subtitle", "time": 20409.51, "timestamp": "05:40:09", "text": "哦，那一定是鼴鼠之類的東西。哦，那是"}, {"type": "subtitle", "time": 20428.948, "timestamp": "05:40:28", "text": "什麼？那又是鼴鼠的另一種說法。鴨子玩意兒。  H. 它"}, {"type": "subtitle", "time": 20434.19, "timestamp": "05:40:34", "text": "降低了"}, {"type": "subtitle", "time": 20439.39, "timestamp": "05:40:39", "text": "渲染效果。  N."}]
[{"type": "subtitle", "time": 12555.91, "timestamp": "03:29:15", "text": "哦。妈的。你还好吗？我该怎么办？"}, {"type": "subtitle", "time": 12557.59, "timestamp": "03:29:17", "text": "隐藏。隐藏。好的。隐藏。隐藏。隐藏。它是"}, {"type": "subtitle", "time": 12559.349, "timestamp": "03:29:19", "text": "只要有一眼就能看到我，然后我就会消失。"}, {"type": "subtitle", "time": 12573.19, "timestamp": "03:29:33", "text": "好的。躲在墙边。反对"}, {"type": "subtitle", "time": 12579.83, "timestamp": "03:29:39", "text": "[音乐]"}, {"type": "subtitle", "time": 12581.91, "timestamp": "03:29:41", "text": "当你看到白色静电干扰时，你要隐藏"}, {"type": "subtitle", "time": 12583.75, "timestamp": "03:29:43", "text": "就像靠在墙上一样。喜欢"}, {"type": "subtitle", "time": 12586.91, "timestamp": "03:29:46", "text": "完全侧身。摆脱它"}, {"type": "subtitle", "time": 12590.25, "timestamp": "03:29:50", "text": "方式。然后我速通了这个关卡。"}]
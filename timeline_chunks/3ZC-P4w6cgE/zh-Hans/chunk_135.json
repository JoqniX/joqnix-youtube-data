[{"type": "subtitle", "time": 8100.87, "timestamp": "02:15:00", "text": "哇，真有意思。"}, {"type": "subtitle", "time": 8104.109, "timestamp": "02:15:04", "text": "哦，不。"}, {"type": "subtitle", "time": 8107.629, "timestamp": "02:15:07", "text": "是的。所以，我就想，我必须……"}, {"type": "subtitle", "time": 8113.47, "timestamp": "02:15:13", "text": "要么轻声细语地直播，要么ASMR直播"}, {"type": "subtitle", "time": 8117.109, "timestamp": "02:15:17", "text": "或者也许嗯"}, {"type": "subtitle", "time": 8119.75, "timestamp": "02:15:19", "text": "它叫什么？嗯。前进。去"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "前方。你可以继续。现在，我"}, {"type": "subtitle", "time": 8122.669, "timestamp": "02:15:22", "text": "好奇"}, {"type": "subtitle", "time": 8125.03, "timestamp": "02:15:25", "text": "比如，你需要待多久？"}, {"type": "subtitle", "time": 8127.109, "timestamp": "02:15:27", "text": "那个房间？"}, {"type": "subtitle", "time": 8129.589, "timestamp": "02:15:29", "text": "呃，我可以在6点以后搬出去。"}, {"type": "subtitle", "time": 8131.99, "timestamp": "02:15:31", "text": "几个月。我一开始需要支付6美元。"}, {"type": "subtitle", "time": 8134.149, "timestamp": "02:15:34", "text": "几个月。"}, {"type": "subtitle", "time": 8139.83, "timestamp": "02:15:39", "text": "哦，是的。是的。然后，嗯，6个月后"}, {"type": "subtitle", "time": 8142.39, "timestamp": "02:15:42", "text": "如果我可以的话，我可以选择留在那里或者喜欢"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "如果我找到更好的，我就可以搬出去。"}, {"type": "subtitle", "time": 8154.79, "timestamp": "02:15:54", "text": "嗯，我也在找新住处。"}, {"type": "subtitle", "time": 8157.27, "timestamp": "02:15:57", "text": "我想那应该也挺有意思的。但是也，"}, {"type": "subtitle", "time": 8159.109, "timestamp": "02:15:59", "text": "是啊，房租什么的都得算上。我必须"}]
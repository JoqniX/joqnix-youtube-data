[{"type": "subtitle", "time": 1500.07, "timestamp": "00:25:00", "text": "不，你这招不行。因为我先死了。哦，"}, {"type": "subtitle", "time": 1502.549, "timestamp": "00:25:02", "text": "蕾娜，你快要死了。你为什么要这样做？我"}, {"type": "subtitle", "time": 1505.75, "timestamp": "00:25:05", "text": "虽然我不会对着人的身体开枪。"}, {"type": "subtitle", "time": 1526.549, "timestamp": "00:25:26", "text": "需要滴一滴。谢谢。霓虹皮肤。每个人"}, {"type": "subtitle", "time": 1530.23, "timestamp": "00:25:30", "text": "需要我的皮肤。"}, {"type": "subtitle", "time": 1533.269, "timestamp": "00:25:33", "text": "好戏开始了。是的，我们拨打了911。"}, {"type": "subtitle", "time": 1535.11, "timestamp": "00:25:35", "text": "敌人"}, {"type": "subtitle", "time": 1537.11, "timestamp": "00:25:37", "text": "这里。"}]
[{"type": "subtitle", "time": 9484.03, "timestamp": "02:38:04", "text": "[音乐]"}, {"type": "subtitle", "time": 9485.5, "timestamp": "02:38:05", "text": "任何事物。"}, {"type": "subtitle", "time": 9488.11, "timestamp": "02:38:08", "text": "[音乐]"}, {"type": "subtitle", "time": 9513.59, "timestamp": "02:38:33", "text": "嗯？你找到什么了吗？不，我没有。"}, {"type": "subtitle", "time": 9517.91, "timestamp": "02:38:37", "text": "找到任意一把钥匙。嗯，一样。"}, {"type": "subtitle", "time": 9519.91, "timestamp": "02:38:39", "text": "好的。好的。我终于明白了。"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "你知道那个躲在后面的人吗？"}, {"type": "subtitle", "time": 9524.79, "timestamp": "02:38:44", "text": "你和那种会被吓到的人一样吗？"}, {"type": "subtitle", "time": 9526.87, "timestamp": "02:38:46", "text": "好的。我明白了。弄清楚"}, {"type": "subtitle", "time": 9529.429, "timestamp": "02:38:49", "text": "躲猫猫怪兽。你看看"}, {"type": "chat", "time": 9531.538, "timestamp": "02:38:51", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "yoooooo"}, {"type": "subtitle", "time": 9534.07, "timestamp": "02:38:54", "text": "在你下方。他会盯上你，他会……"}, {"type": "subtitle", "time": 9537.349, "timestamp": "02:38:57", "text": "你可以那样躲开他。"}]
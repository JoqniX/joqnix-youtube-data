[{"type": "subtitle", "time": 7382.27, "timestamp": "02:03:02", "text": "蜂蜜。是的。你好，布拉德。欢迎来到"}, {"type": "subtitle", "time": 7384.83, "timestamp": "02:03:04", "text": "溪流。"}, {"type": "subtitle", "time": 7387.31, "timestamp": "02:03:07", "text": "欢迎。"}, {"type": "subtitle", "time": 7397.39, "timestamp": "02:03:17", "text": "那。你们能听到吗？"}, {"type": "subtitle", "time": 7401.43, "timestamp": "02:03:21", "text": "我？我还活着吗？"}, {"type": "subtitle", "time": 7409.629, "timestamp": "02:03:29", "text": "居住。好了，我开始直播了。"}, {"type": "subtitle", "time": 7420.709, "timestamp": "02:03:40", "text": "鸣叫。我很抱歉。我们本应该"}, {"type": "subtitle", "time": 7421.709, "timestamp": "02:03:41", "text": "开始"}, {"type": "subtitle", "time": 7426.07, "timestamp": "02:03:46", "text": "我们原本应该从……开始"}, {"type": "subtitle", "time": 7429.35, "timestamp": "02:03:49", "text": "下午3点但我必须做一些事"}, {"type": "subtitle", "time": 7431.229, "timestamp": "02:03:51", "text": "紧急情况"}, {"type": "subtitle", "time": 7434.99, "timestamp": "02:03:54", "text": "我不得不做一些事情"}, {"type": "subtitle", "time": 7438.07, "timestamp": "02:03:58", "text": "因此不得不稍微推迟一下。然后我"}]
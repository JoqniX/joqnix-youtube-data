[{"type": "subtitle", "time": 20523.83, "timestamp": "05:42:03", "text": "还有其他东西。嗯……这可能是一个秘密"}, {"type": "subtitle", "time": 20526.11, "timestamp": "05:42:06", "text": "你我之间，"}, {"type": "subtitle", "time": 20529.59, "timestamp": "05:42:09", "text": "但有点虚弱，对……很敏感"}, {"type": "subtitle", "time": 20532.39, "timestamp": "05:42:12", "text": "下一页。我不知道为什么，但我知道"}, {"type": "subtitle", "time": 20536.69, "timestamp": "05:42:16", "text": "我知道这是不必要的脂肪，但是……"}, {"type": "subtitle", "time": 20539.15, "timestamp": "05:42:19", "text": "[音乐]"}, {"type": "subtitle", "time": 20541.628, "timestamp": "05:42:21", "text": "咚咚"}, {"type": "subtitle", "time": 20545.19, "timestamp": "05:42:25", "text": "笨蛋。所以，是的，最近，是的，这些都是"}, {"type": "subtitle", "time": 20547.15, "timestamp": "05:42:27", "text": "我所秉持的道德观"}, {"type": "subtitle", "time": 20550.47, "timestamp": "05:42:30", "text": "有。我想与众不同，而且"}, {"type": "subtitle", "time": 20552.868, "timestamp": "05:42:32", "text": "我。我主要想表达的是"}, {"type": "subtitle", "time": 20555.948, "timestamp": "05:42:35", "text": "我。这"}, {"type": "subtitle", "time": 20558.15, "timestamp": "05:42:38", "text": "特点。既然你已经告诉你的身体，"}, {"type": "subtitle", "time": 20559.67, "timestamp": "05:42:39", "text": "你只需要知道我的头发很长，而且"}, {"type": "subtitle", "time": 20562.83, "timestamp": "05:42:42", "text": "腿长9厘米。你认为我能过河吗？"}, {"type": "subtitle", "time": 20567.19, "timestamp": "05:42:47", "text": "剩下的就独自生活吧，伙计。哟，我想我"}, {"type": "subtitle", "time": 20570.23, "timestamp": "05:42:50", "text": "想说，你知道，这太难了，因为"}, {"type": "subtitle", "time": 20573.03, "timestamp": "05:42:53", "text": "我和父母住在一起。我 我"}, {"type": "subtitle", "time": 20574.51, "timestamp": "05:42:54", "text": "想穿过"}, {"type": "subtitle", "time": 20577.67, "timestamp": "05:42:57", "text": "其实是要盛装打扮什么的，但是……"}, {"type": "subtitle", "time": 20579.948, "timestamp": "05:42:59", "text": "真丢人，你"}]
[{"type": "subtitle", "time": 3219.23, "timestamp": "00:53:39", "text": "我们在哪里"}, {"type": "subtitle", "time": 3223.109, "timestamp": "00:53:43", "text": "去？唉，离开的时候我感觉好难过。"}, {"type": "subtitle", "time": 3225.71, "timestamp": "00:53:45", "text": "我当时正看着那条小溪，它就那样一直流着。"}, {"type": "subtitle", "time": 3238.47, "timestamp": "00:53:58", "text": "再次。我需要启用这个功能。我的天啊。"}, {"type": "subtitle", "time": 3239.87, "timestamp": "00:53:59", "text": "尖刺向下"}]
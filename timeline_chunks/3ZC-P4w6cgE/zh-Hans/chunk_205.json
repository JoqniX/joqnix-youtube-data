[{"type": "subtitle", "time": 12302.15, "timestamp": "03:25:02", "text": "不要认为他会伤害你。好的。"}, {"type": "subtitle", "time": 12305.99, "timestamp": "03:25:05", "text": "匆忙。你仍然拥有它。是的。我不"}, {"type": "subtitle", "time": 12308.15, "timestamp": "03:25:08", "text": "知道原因。"}, {"type": "subtitle", "time": 12311.03, "timestamp": "03:25:11", "text": "好的。好的。跳。跳。好的。我 我"}, {"type": "subtitle", "time": 12312.389, "timestamp": "03:25:12", "text": "我觉得你可以把它用在你……的时候"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "看到一个钥匙孔。我猜那是"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "重复使用。"}, {"type": "subtitle", "time": 12321.15, "timestamp": "03:25:21", "text": "哦，对了，你可以在这里使用它。"}, {"type": "subtitle", "time": 12323.91, "timestamp": "03:25:23", "text": "那里。哦，对了，要打开那扇门，"}, {"type": "subtitle", "time": 12332.79, "timestamp": "03:25:32", "text": "哦，那个紫色的东西。是的，继续"}, {"type": "subtitle", "time": 12334.389, "timestamp": "03:25:34", "text": "跑步。一直跑，然后躲起来。"}, {"type": "subtitle", "time": 12355.11, "timestamp": "03:25:55", "text": "我的天啊。使用第二个呃灯"}, {"type": "subtitle", "time": 12357.349, "timestamp": "03:25:57", "text": "因为如果你在黑暗中奔跑，我就不行。"}, {"type": "subtitle", "time": 12358.55, "timestamp": "03:25:58", "text": "我认为导航会很困难。"}]
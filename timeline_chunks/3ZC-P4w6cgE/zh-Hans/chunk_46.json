[{"type": "subtitle", "time": 2764.4, "timestamp": "00:46:04", "text": "试试右边试试右边试试右边试试右边 试试右边 试试右边 试试右边"}, {"type": "subtitle", "time": 2772.22, "timestamp": "00:46:12", "text": "儿子。我的天啊。"}, {"type": "subtitle", "time": 2773.51, "timestamp": "00:46:13", "text": "[音乐]"}, {"type": "subtitle", "time": 2774.829, "timestamp": "00:46:14", "text": "哦"}, {"type": "subtitle", "time": 2794.75, "timestamp": "00:46:34", "text": "上帝。一，一秒，"}, {"type": "subtitle", "time": 2798.47, "timestamp": "00:46:38", "text": "BB。我妈妈刚才打电话来了。请稍等一秒。"}, {"type": "subtitle", "time": 2800.95, "timestamp": "00:46:40", "text": "一秒钟。"}, {"type": "subtitle", "time": 2805.43, "timestamp": "00:46:45", "text": "他们已经死了。一秒钟。一秒钟。"}]
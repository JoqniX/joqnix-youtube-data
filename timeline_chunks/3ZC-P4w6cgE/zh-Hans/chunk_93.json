[{"type": "subtitle", "time": 5581.55, "timestamp": "01:33:01", "text": "你。祝你圣诞快乐！"}, {"type": "subtitle", "time": 5585.47, "timestamp": "01:33:05", "text": "出色地。也祝你圣诞快乐。"}, {"type": "subtitle", "time": 5589.51, "timestamp": "01:33:09", "text": "艾丽莎说不，我的意思是你知道的，就像"}, {"type": "subtitle", "time": 5591.99, "timestamp": "01:33:11", "text": "看"}, {"type": "subtitle", "time": 5595.11, "timestamp": "01:33:15", "text": "你对欣赏这件事的看法"}, {"type": "subtitle", "time": 5597.03, "timestamp": "01:33:17", "text": "说到给予勤劳的人，这真是令人感动。"}, {"type": "subtitle", "time": 5598.95, "timestamp": "01:33:18", "text": "是人，对吧？不仅仅是勤奋"}, {"type": "subtitle", "time": 5601.83, "timestamp": "01:33:21", "text": "人们会明白这一点，就像那些喜欢这样的人一样。"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "陷入拖延的恶性循环"}, {"type": "subtitle", "time": 5606.149, "timestamp": "01:33:26", "text": "就像你知道的，他不想做那样"}, {"type": "subtitle", "time": 5608.229, "timestamp": "01:33:28", "text": "什么都行，但仍然想做任何事"}, {"type": "subtitle", "time": 5609.669, "timestamp": "01:33:29", "text": "想做某事并且喜欢"}, {"type": "subtitle", "time": 5612.709, "timestamp": "01:33:32", "text": "即使他们整天都在系鞋带"}, {"type": "subtitle", "time": 5614.47, "timestamp": "01:33:34", "text": "他们玩手机或者做其他事情"}, {"type": "subtitle", "time": 5617.47, "timestamp": "01:33:37", "text": "这就算做对了。"}, {"type": "subtitle", "time": 5622.07, "timestamp": "01:33:42", "text": "所以，呃，某种程度上"}, {"type": "subtitle", "time": 5623.149, "timestamp": "01:33:43", "text": "呃"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "是的，我看到他们在工作，做他们的"}, {"type": "subtitle", "time": 5627.99, "timestamp": "01:33:47", "text": "刷子和工作"}, {"type": "subtitle", "time": 5631.55, "timestamp": "01:33:51", "text": "[音乐]"}, {"type": "subtitle", "time": 5636.27, "timestamp": "01:33:56", "text": "难的。如何戳你一下？我希望"}, {"type": "subtitle", "time": 5639.83, "timestamp": "01:33:59", "text": "啵啵？不，我输入了“我为什么要输入”"}]
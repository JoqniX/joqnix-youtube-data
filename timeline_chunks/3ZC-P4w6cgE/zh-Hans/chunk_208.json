[{"type": "subtitle", "time": 12481.59, "timestamp": "03:28:01", "text": "这个。"}, {"type": "subtitle", "time": 12485.19, "timestamp": "03:28:05", "text": "窥视。躲在墙后。是的。喜欢"}, {"type": "subtitle", "time": 12487.11, "timestamp": "03:28:07", "text": "如果你看到这个人，就躲在……后面"}, {"type": "subtitle", "time": 12488.99, "timestamp": "03:28:08", "text": "阻挡他前进的障碍"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "视力。另一个你必须拥抱"}, {"type": "subtitle", "time": 12497.11, "timestamp": "03:28:17", "text": "靠在墙上，或者像你可能那样的时候"}, {"type": "subtitle", "time": 12498.79, "timestamp": "03:28:18", "text": "忘了是哪个了。我认为一个白色"}, {"type": "subtitle", "time": 12501.03, "timestamp": "03:28:21", "text": "闪光。你知道另一个是什么样的。"}, {"type": "subtitle", "time": 12504.15, "timestamp": "03:28:24", "text": "粉红色的闪光，像静电一样？是的。"}, {"type": "subtitle", "time": 12505.83, "timestamp": "03:28:25", "text": "这个颜色像白色。那时你"}, {"type": "subtitle", "time": 12507.59, "timestamp": "03:28:27", "text": "不得不躲避那种拥抱"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "靠墙站着。它会突然出现"}, {"type": "subtitle", "time": 12511.75, "timestamp": "03:28:31", "text": "迅速地。所以，立刻拥抱她吧。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "沿着墙的一侧冲过去"}, {"type": "subtitle", "time": 12520.79, "timestamp": "03:28:40", "text": "嗯，是的，继续拿着灯。你可能"}, {"type": "subtitle", "time": 12522.71, "timestamp": "03:28:42", "text": "如果你不抓住第二个，就会迷路。"}, {"type": "subtitle", "time": 12531.71, "timestamp": "03:28:51", "text": "好的。好的。"}]
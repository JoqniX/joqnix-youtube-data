[{"type": "subtitle", "time": 20587.628, "timestamp": "05:43:07", "text": "一"}, {"type": "subtitle", "time": 20600.948, "timestamp": "05:43:20", "text": "你好。所以，呃，你知道，我喜欢……我穿"}, {"type": "subtitle", "time": 20602.75, "timestamp": "05:43:22", "text": "像圆形"}, {"type": "subtitle", "time": 20606.07, "timestamp": "05:43:26", "text": "眼镜。圆形玻璃杯。所以我想……"}, {"type": "subtitle", "time": 20610.83, "timestamp": "05:43:30", "text": "想送我圆眼镜"}, {"type": "subtitle", "time": 20615.628, "timestamp": "05:43:35", "text": "因为圆玻璃帮真的太酷了"}, {"type": "subtitle", "time": 20620.51, "timestamp": "05:43:40", "text": "也是酷小孩中的一员。是的。"}, {"type": "subtitle", "time": 20622.91, "timestamp": "05:43:42", "text": "是的。你好。所以"}, {"type": "subtitle", "time": 20626.39, "timestamp": "05:43:46", "text": "是的，我以为我特意说过。"}, {"type": "subtitle", "time": 20629.07, "timestamp": "05:43:49", "text": "Zuchi 呃 妈妈"}, {"type": "subtitle", "time": 20637.51, "timestamp": "05:43:57", "text": "你好。这就是我的空气环。"}]
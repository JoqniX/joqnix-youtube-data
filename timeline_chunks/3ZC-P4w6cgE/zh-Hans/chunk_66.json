[{"type": "subtitle", "time": 3961.029, "timestamp": "01:06:01", "text": "呃，我没想到我会上场比赛。"}, {"type": "subtitle", "time": 3964.15, "timestamp": "01:06:04", "text": "虽然通常情况下，我的最初计划是"}, {"type": "subtitle", "time": 3967.43, "timestamp": "01:06:07", "text": "如果我没有准备任何东西，那我该怎么办？"}, {"type": "subtitle", "time": 3968.51, "timestamp": "01:06:08", "text": "就这么做"}, {"type": "subtitle", "time": 3971.109, "timestamp": "01:06:11", "text": "聊天，比如聊点什么"}, {"type": "subtitle", "time": 3973.43, "timestamp": "01:06:13", "text": "大概三四个小时，而我当时"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "说话的时候我表现得还不错，然后就结束了。"}, {"type": "subtitle", "time": 3977.309, "timestamp": "01:06:17", "text": "速通"}, {"type": "subtitle", "time": 3982.71, "timestamp": "01:06:22", "text": "第三章到第五章的内容等等"}, {"type": "subtitle", "time": 3985.589, "timestamp": "01:06:25", "text": "裹好毯子，睡觉吧。就是这样"}, {"type": "subtitle", "time": 3987.87, "timestamp": "01:06:27", "text": "那是我的"}, {"type": "subtitle", "time": 3992.15, "timestamp": "01:06:32", "text": "计划。但我最后还是走了好一会儿，呃，就像"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "2小时或1小时。最后我还是玩了。"}, {"type": "subtitle", "time": 3999.87, "timestamp": "01:06:39", "text": "价值。我们本应该通过……进入"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "我在看着你。记住不要"}, {"type": "subtitle", "time": 4012.069, "timestamp": "01:06:52", "text": "戴面具戴得太多了。是的，但最近确实如此。"}, {"type": "subtitle", "time": 4014.309, "timestamp": "01:06:54", "text": "因为《Valerant》和其他游戏"}, {"type": "subtitle", "time": 4018.109, "timestamp": "01:06:58", "text": "我有点跑题了，或者"}]
[{"type": "subtitle", "time": 18486.47, "timestamp": "05:08:06", "text": "我声音是不是太大了？它也在说话"}, {"type": "subtitle", "time": 18489.55, "timestamp": "05:08:09", "text": "很多。这是漫画音效吗？"}, {"type": "subtitle", "time": 18492.55, "timestamp": "05:08:12", "text": "背景？我不知道。我不知道。"}, {"type": "subtitle", "time": 18505.788, "timestamp": "05:08:25", "text": "它。这真的意味着"}, {"type": "subtitle", "time": 18510.31, "timestamp": "05:08:30", "text": "很多。是的。嗯，让我继续……呃，什么？"}, {"type": "subtitle", "time": 18512.35, "timestamp": "05:08:32", "text": "我是在揭晓答案之前说的。"}, {"type": "subtitle", "time": 18517.55, "timestamp": "05:08:37", "text": "继续"}, {"type": "subtitle", "time": 18524.15, "timestamp": "05:08:44", "text": "你好。所以，你知道，就像一直以来那样"}, {"type": "subtitle", "time": 18526.99, "timestamp": "05:08:46", "text": "我工作太忙了。"}, {"type": "subtitle", "time": 18530.39, "timestamp": "05:08:50", "text": "尤其是直播方面的内容"}, {"type": "subtitle", "time": 18534.55, "timestamp": "05:08:54", "text": "后来我甚至都没给，呃呃，我"}, {"type": "subtitle", "time": 18537.23, "timestamp": "05:08:57", "text": "甚至都没注意到那只猫。"}]
[{"type": "subtitle", "time": 19568.15, "timestamp": "05:26:08", "text": "狮子座。所以，我想……多多交流。"}, {"type": "subtitle", "time": 19571.59, "timestamp": "05:26:11", "text": "与群星，与宇宙。就像我"}, {"type": "subtitle", "time": 19574.47, "timestamp": "05:26:14", "text": "想要出人头地。我其实想这么做"}, {"type": "subtitle", "time": 19577.708, "timestamp": "05:26:17", "text": "像……一样闪耀"}, {"type": "subtitle", "time": 19579.47, "timestamp": "05:26:19", "text": "星星。"}, {"type": "subtitle", "time": 19583.39, "timestamp": "05:26:23", "text": "嗯。想要更加闪耀。"}, {"type": "subtitle", "time": 19585.628, "timestamp": "05:26:25", "text": "更明亮的你"}, {"type": "subtitle", "time": 19588.67, "timestamp": "05:26:28", "text": "知道如何继续前进"}, {"type": "subtitle", "time": 19592.27, "timestamp": "05:26:32", "text": "旅程想要传播那些闪耀的光芒"}, {"type": "subtitle", "time": 19595.39, "timestamp": "05:26:35", "text": "光线照射"}, {"type": "subtitle", "time": 19599.27, "timestamp": "05:26:39", "text": "向你们所有人致以温暖的问候，米娜，以及所有……"}, {"type": "subtitle", "time": 19609.628, "timestamp": "05:26:49", "text": "大家都这样"}, {"type": "subtitle", "time": 19619.51, "timestamp": "05:26:59", "text": "星座。你好。所以，下一个是我的"}]
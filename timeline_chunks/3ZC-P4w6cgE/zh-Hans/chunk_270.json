[{"type": "subtitle", "time": 16200.63, "timestamp": "04:30:00", "text": "猜猜看，啊，既然你来了，那就……"}, {"type": "subtitle", "time": 16202.59, "timestamp": "04:30:02", "text": "我想要的人。"}, {"type": "subtitle", "time": 16205.67, "timestamp": "04:30:05", "text": "她叫什么名字来着？我的天啊。"}, {"type": "subtitle", "time": 16242.189, "timestamp": "04:30:42", "text": "[音乐]"}, {"type": "subtitle", "time": 16244.03, "timestamp": "04:30:44", "text": "你好。你"}, {"type": "subtitle", "time": 16259.75, "timestamp": "04:30:59", "text": "我不知道你是否还记得。我认为"}]
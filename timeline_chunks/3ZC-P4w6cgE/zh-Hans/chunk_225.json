[{"type": "subtitle", "time": 13501.349, "timestamp": "03:45:01", "text": "啊。哦，这就是那场雨，还有其他的"}, {"type": "subtitle", "time": 13502.95, "timestamp": "03:45:02", "text": "一。"}, {"type": "subtitle", "time": 13505.59, "timestamp": "03:45:05", "text": "是的。笑脸。蹲伏。呃，别这样"}, {"type": "subtitle", "time": 13508.67, "timestamp": "03:45:08", "text": "移动并蹲下。"}, {"type": "subtitle", "time": 13512.13, "timestamp": "03:45:12", "text": "哦，我看过了。是的。"}, {"type": "subtitle", "time": 13518.229, "timestamp": "03:45:18", "text": "妈的。躲在门底下。这里。"}, {"type": "subtitle", "time": 13522.79, "timestamp": "03:45:22", "text": "是的。是的。这里。这里。哦，不错。好的。"}, {"type": "subtitle", "time": 13525.91, "timestamp": "03:45:25", "text": "我的天啊。你可以用它来隐藏"}, {"type": "subtitle", "time": 13532.189, "timestamp": "03:45:32", "text": "哦，它是粉色的"}, {"type": "subtitle", "time": 13537.83, "timestamp": "03:45:37", "text": "一。啊，我滑倒了。哦，你好，艾尔莎。"}, {"type": "subtitle", "time": 13542.87, "timestamp": "03:45:42", "text": "我没去看那只红眼睛。妈的。"}, {"type": "subtitle", "time": 13548.71, "timestamp": "03:45:48", "text": "这既难又有趣。是的。"}]
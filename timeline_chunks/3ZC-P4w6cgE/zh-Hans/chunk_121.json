[{"type": "subtitle", "time": 7265.149, "timestamp": "02:01:05", "text": "哦，这是"}, {"type": "subtitle", "time": 7273.95, "timestamp": "02:01:13", "text": "乐趣。谁在乱扔垃圾？"}, {"type": "subtitle", "time": 7276.669, "timestamp": "02:01:16", "text": "哦，等等。谁要退出"}, {"type": "subtitle", "time": 7279.42, "timestamp": "02:01:19", "text": "垃圾？停止下降"}, {"type": "subtitle", "time": 7287.75, "timestamp": "02:01:27", "text": "垃圾。哦，艾莎，我的翻译可以是"}, {"type": "subtitle", "time": 7289.69, "timestamp": "02:01:29", "text": "呃，错了，记住这一点。"}, {"type": "subtitle", "time": 7298.669, "timestamp": "02:01:38", "text": "[音乐]"}, {"type": "subtitle", "time": 7301.149, "timestamp": "02:01:41", "text": "嗯。哦，这是"}, {"type": "subtitle", "time": 7304.83, "timestamp": "02:01:44", "text": "乐趣。我正在收集很多"}, {"type": "subtitle", "time": 7309.87, "timestamp": "02:01:49", "text": "垃圾。 Kina 清洁。好的。灰尘"}, {"type": "subtitle", "time": 7315.03, "timestamp": "02:01:55", "text": "停止。我有一张。好的。二号地毯。"}, {"type": "subtitle", "time": 7318.47, "timestamp": "02:01:58", "text": "普通灰尘商店。增加共同"}]
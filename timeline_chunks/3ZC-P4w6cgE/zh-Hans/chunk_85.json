[{"type": "subtitle", "time": 5101.83, "timestamp": "01:25:01", "text": "你还在BC和Auchi Kra一起吗？"}, {"type": "subtitle", "time": 5106.59, "timestamp": "01:25:06", "text": "萨利斯。所以尽情享受吧。过来吧"}, {"type": "subtitle", "time": 5114.51, "timestamp": "01:25:14", "text": "圣诞节。一定要玩得开心"}, {"type": "subtitle", "time": 5117.27, "timestamp": "01:25:17", "text": "现在。我不知道你为什么说要放进去"}, {"type": "subtitle", "time": 5120.51, "timestamp": "01:25:20", "text": "标题是“孤独”或"}, {"type": "subtitle", "time": 5124.189, "timestamp": "01:25:24", "text": "某物。笨蛋。女神。"}, {"type": "subtitle", "time": 5126.43, "timestamp": "01:25:26", "text": "不，那就是他"}, {"type": "subtitle", "time": 5129.55, "timestamp": "01:25:29", "text": "说。但"}, {"type": "subtitle", "time": 5132.629, "timestamp": "01:25:32", "text": "是的，希望你直播愉快。"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "过得很好"}, {"type": "subtitle", "time": 5136.51, "timestamp": "01:25:36", "text": "呃，圣诞节的长椅"}, {"type": "subtitle", "time": 5138.35, "timestamp": "01:25:38", "text": "座位。"}, {"type": "subtitle", "time": 5142.669, "timestamp": "01:25:42", "text": "于是，然后就来了。"}, {"type": "subtitle", "time": 5147.149, "timestamp": "01:25:47", "text": "今天过来看看。你刚醒"}, {"type": "subtitle", "time": 5151.51, "timestamp": "01:25:51", "text": "今天不久前。嗯，是的。所以希望你"}, {"type": "subtitle", "time": 5155.35, "timestamp": "01:25:55", "text": "祝你今天过得愉快！"}, {"type": "subtitle", "time": 5157.59, "timestamp": "01:25:57", "text": "圣诞前夜快乐，因为现在还是圣诞节前夜。"}]
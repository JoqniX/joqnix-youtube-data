[{"type": "subtitle", "time": 9126.63, "timestamp": "02:32:06", "text": "呃，好的。等等，在哪儿？没有"}, {"type": "subtitle", "time": 9130.349, "timestamp": "02:32:10", "text": "短跑。是的，没有"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "哦。好的。所以，尽量不要待在室内"}, {"type": "subtitle", "time": 9152.309, "timestamp": "02:32:32", "text": "黑暗待得太久了。有时候那里"}, {"type": "subtitle", "time": 9155.59, "timestamp": "02:32:35", "text": "是一个喜欢在你耳边低语的怪物"}, {"type": "subtitle", "time": 9158.389, "timestamp": "02:32:38", "text": "或者像这样说，“哦，别看……”"}, {"type": "subtitle", "time": 9160.87, "timestamp": "02:32:40", "text": "蓝色的。不要看蓝色。"}, {"type": "subtitle", "time": 9162.91, "timestamp": "02:32:42", "text": "呃，有"}, {"type": "subtitle", "time": 9166.91, "timestamp": "02:32:46", "text": "所以就"}, {"type": "subtitle", "time": 9172.03, "timestamp": "02:32:52", "text": "对，沿着墙走就能找到下一个"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "门。很不错。我获得了一项成就。"}]
[{"type": "subtitle", "time": 4501.27, "timestamp": "01:15:01", "text": "是的。是的。感谢九头蛇的光临。希望"}, {"type": "subtitle", "time": 4503.91, "timestamp": "01:15:03", "text": "你睡得很好，而且又睡得很好。"}, {"type": "subtitle", "time": 4506.47, "timestamp": "01:15:06", "text": "也祝你圣诞快乐。感谢"}, {"type": "subtitle", "time": 4508.47, "timestamp": "01:15:08", "text": "感谢你一直以来的陪伴和支持"}, {"type": "subtitle", "time": 4512.51, "timestamp": "01:15:12", "text": "我。真的错过了很多。然后V来了"}, {"type": "subtitle", "time": 4515.11, "timestamp": "01:15:15", "text": "今天。也祝贺你"}, {"type": "subtitle", "time": 4518.39, "timestamp": "01:15:18", "text": "拿回一个新麦克风。迫不及待了"}, {"type": "subtitle", "time": 4521.11, "timestamp": "01:15:21", "text": "看到你买了更多电脑配件，而且很喜欢你"}, {"type": "subtitle", "time": 4523.51, "timestamp": "01:15:23", "text": "了解如何进行PC流媒体播放"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "设置已完成，您可以安心观看视频了。"}, {"type": "subtitle", "time": 4527.83, "timestamp": "01:15:27", "text": "就像你知道的那样，尽你所能。"}, {"type": "subtitle", "time": 4535.43, "timestamp": "01:15:35", "text": "YouTuber，也感谢你的到来"}, {"type": "subtitle", "time": 4537.87, "timestamp": "01:15:37", "text": "你的"}, {"type": "subtitle", "time": 4541.91, "timestamp": "01:15:41", "text": "吸血鬼。你好，也希望你睡得好。"}, {"type": "subtitle", "time": 4543.79, "timestamp": "01:15:43", "text": "而且也很快乐"}, {"type": "subtitle", "time": 4546.229, "timestamp": "01:15:46", "text": "圣诞节。然后，这就是个小梦。"}, {"type": "subtitle", "time": 4549.91, "timestamp": "01:15:49", "text": "埃利桑。谢谢你，伊莉莎，雪"}, {"type": "subtitle", "time": 4554.229, "timestamp": "01:15:54", "text": "公主。没有雪女神般的夏天。感谢"}, {"type": "subtitle", "time": 4557.43, "timestamp": "01:15:57", "text": "你，呃，该怎么称呼它呢，来吧。"}]
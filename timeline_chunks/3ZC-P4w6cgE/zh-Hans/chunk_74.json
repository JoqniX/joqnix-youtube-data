[{"type": "subtitle", "time": 4441.87, "timestamp": "01:14:01", "text": "非常感谢"}, {"type": "subtitle", "time": 4444.95, "timestamp": "01:14:04", "text": "它。是的。我送了你一份礼物"}, {"type": "subtitle", "time": 4447.669, "timestamp": "01:14:07", "text": "头槌。总有一天，当我们拥有"}, {"type": "subtitle", "time": 4451.03, "timestamp": "01:14:11", "text": "小雪，小球，像小雪球一样。"}, {"type": "subtitle", "time": 4454.63, "timestamp": "01:14:14", "text": "球赛。等等，什么？打雪仗。"}, {"type": "subtitle", "time": 4457.59, "timestamp": "01:14:17", "text": "我会把它扔给你。我不"}, {"type": "subtitle", "time": 4460.149, "timestamp": "01:14:20", "text": "知道。我只想扔个水烟壶"}, {"type": "subtitle", "time": 4462.07, "timestamp": "01:14:22", "text": "像我这样的人，被爆头了"}, {"type": "subtitle", "time": 4464.31, "timestamp": "01:14:24", "text": "雪球。我不知道。我想看"}, {"type": "subtitle", "time": 4467.43, "timestamp": "01:14:27", "text": "礼物。哦，不过那不是表情符号。哦，"}, {"type": "subtitle", "time": 4469.63, "timestamp": "01:14:29", "text": "你知道礼物表情符号，还有像剑一样的表情符号。"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "表情符号。是的，他发了礼物表情符号。呃"}, {"type": "subtitle", "time": 4476.87, "timestamp": "01:14:36", "text": "重复3次，然后在中间加一个剑的表情符号。"}, {"type": "subtitle", "time": 4481.189, "timestamp": "01:14:41", "text": "以及更多礼物表情符号。对，就是这样。"}, {"type": "subtitle", "time": 4483.75, "timestamp": "01:14:43", "text": "然后另一个是礼物表情符号，然后"}, {"type": "subtitle", "time": 4487.43, "timestamp": "01:14:47", "text": "甜甜圈表情符号和礼物表情符号之类的。"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "所以，这算作两份礼物。"}, {"type": "subtitle", "time": 4492.07, "timestamp": "01:14:52", "text": "是信息，对吧？差不多是这样。我"}, {"type": "subtitle", "time": 4495.11, "timestamp": "01:14:55", "text": "不知道。"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "然后就是我之前提到的九头蛇游戏。"}]
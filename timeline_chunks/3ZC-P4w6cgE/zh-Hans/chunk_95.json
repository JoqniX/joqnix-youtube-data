[{"type": "subtitle", "time": 5700.27, "timestamp": "01:35:00", "text": "我要去做"}, {"type": "subtitle", "time": 5703.03, "timestamp": "01:35:03", "text": "这。让我打开我的，再关掉我的"}, {"type": "subtitle", "time": 5705.229, "timestamp": "01:35:05", "text": "噪音"}, {"type": "subtitle", "time": 5709.03, "timestamp": "01:35:09", "text": "抑制。好的。什么都能听见。"}, {"type": "subtitle", "time": 5710.99, "timestamp": "01:35:10", "text": "所以，让我用我的"}, {"type": "subtitle", "time": 5713.47, "timestamp": "01:35:13", "text": "鼻子。"}, {"type": "subtitle", "time": 5718.189, "timestamp": "01:35:18", "text": "啵。你听到了吗？我在戳戳"}, {"type": "subtitle", "time": 5722.04, "timestamp": "01:35:22", "text": "你。真是太尴尬了。哦，我的"}, {"type": "subtitle", "time": 5724.11, "timestamp": "01:35:24", "text": "[音乐]"}, {"type": "subtitle", "time": 5727.03, "timestamp": "01:35:27", "text": "上帝。我的天啊。我做了。我的天啊。"}, {"type": "subtitle", "time": 5728.59, "timestamp": "01:35:28", "text": "真不敢相信我竟然这么做了"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "啊。我的天啊。绝不那样做。我的"}, {"type": "subtitle", "time": 5741.11, "timestamp": "01:35:41", "text": "第一次真正上去"}, {"type": "subtitle", "time": 5744.95, "timestamp": "01:35:44", "text": "麦克风对着我的嘴，就像往下走一样"}, {"type": "subtitle", "time": 5746.75, "timestamp": "01:35:46", "text": "用……"}, {"type": "subtitle", "time": 5749.59, "timestamp": "01:35:49", "text": "鼻子。等等，我想知道鼻子怎么会发出呜咽声"}, {"type": "subtitle", "time": 5754.629, "timestamp": "01:35:54", "text": "会像那样。那不是一部动画吗？"}, {"type": "subtitle", "time": 5758.55, "timestamp": "01:35:58", "text": "呃，礼物，就像一个鼻子乳房"}]
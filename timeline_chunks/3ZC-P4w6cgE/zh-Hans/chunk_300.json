[{"type": "subtitle", "time": 18002.39, "timestamp": "05:00:02", "text": "这就是我目前称呼我的社区为“社区”的原因。我不"}, {"type": "subtitle", "time": 18005.43, "timestamp": "05:00:05", "text": "知道我是否应该……我的意思是，我想修复它。"}, {"type": "subtitle", "time": 18008.23, "timestamp": "05:00:08", "text": "这将作为我们公司的永久名称"}, {"type": "subtitle", "time": 18012.27, "timestamp": "05:00:12", "text": "我的社区，我的社区，我自己，你"}, {"type": "subtitle", "time": 18021.67, "timestamp": "05:00:21", "text": "是的，感谢你们从一开始就在那里。"}, {"type": "subtitle", "time": 18024.15, "timestamp": "05:00:24", "text": "虽然现在还不是第一天，但​​我"}, {"type": "subtitle", "time": 18027.19, "timestamp": "05:00:27", "text": "这意味着有很多首日观众。"}, {"type": "subtitle", "time": 18030.35, "timestamp": "05:00:30", "text": "呃，支持者们仍然"}, {"type": "subtitle", "time": 18033.15, "timestamp": "05:00:33", "text": "和我交谈"}, {"type": "subtitle", "time": 18037.03, "timestamp": "05:00:37", "text": "我很高兴见到他们所有人"}, {"type": "subtitle", "time": 18055.31, "timestamp": "05:00:55", "text": "每个人。雅虎。感谢"}, {"type": "subtitle", "time": 18058.868, "timestamp": "05:00:58", "text": "你。嘿，那我们继续吧。"}]
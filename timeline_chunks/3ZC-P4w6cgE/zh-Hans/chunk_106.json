[{"type": "subtitle", "time": 6360.47, "timestamp": "01:46:00", "text": "还是24号，对吧？是的，快乐"}, {"type": "subtitle", "time": 6367.189, "timestamp": "01:46:07", "text": "希望你度过一个美好的夜晚。"}, {"type": "subtitle", "time": 6368.99, "timestamp": "01:46:08", "text": "夜晚"}, {"type": "subtitle", "time": 6372.109, "timestamp": "01:46:12", "text": "前方。我的时间安排正确吗？"}, {"type": "subtitle", "time": 6375.109, "timestamp": "01:46:15", "text": "区？我的时区信息是否正确？我"}, {"type": "subtitle", "time": 6378.709, "timestamp": "01:46:18", "text": "不知道。是的。哦，我猜对了。"}, {"type": "subtitle", "time": 6380.51, "timestamp": "01:46:20", "text": "加上时区信息。"}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "好的。不过，谢谢你的参与。"}, {"type": "subtitle", "time": 6385.91, "timestamp": "01:46:25", "text": "所以这标志着你的第二个直播流。"}, {"type": "subtitle", "time": 6393.99, "timestamp": "01:46:33", "text": "所以，是的，我们当时就是那样，呃呃，我们"}, {"type": "subtitle", "time": 6396.79, "timestamp": "01:46:36", "text": "就像一场挑战直播。我们"}, {"type": "subtitle", "time": 6399.189, "timestamp": "01:46:39", "text": "谈到了推压和所有那些事"}, {"type": "subtitle", "time": 6402.03, "timestamp": "01:46:42", "text": "开头的一些东西。然后我玩"}, {"type": "subtitle", "time": 6405.35, "timestamp": "01:46:45", "text": "Valerentto 大概有一两个吧"}, {"type": "subtitle", "time": 6407.75, "timestamp": "01:46:47", "text": "小时。现在我们又开始聊天了。"}, {"type": "subtitle", "time": 6409.149, "timestamp": "01:46:49", "text": "再次。所以"}, {"type": "subtitle", "time": 6412.31, "timestamp": "01:46:52", "text": "是的，你错过的就是这些。但"}, {"type": "subtitle", "time": 6414.27, "timestamp": "01:46:54", "text": "不过，还是要谢谢你的到来。"}, {"type": "subtitle", "time": 6417.03, "timestamp": "01:46:57", "text": "经过。明天是个好日子。是的，"}, {"type": "subtitle", "time": 6418.75, "timestamp": "01:46:58", "text": "明天是个好日子。"}]
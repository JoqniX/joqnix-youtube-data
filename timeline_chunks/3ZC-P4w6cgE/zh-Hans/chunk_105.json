[{"type": "subtitle", "time": 6301.39, "timestamp": "01:45:01", "text": "特别的人，或者甚至是你的特别的人"}, {"type": "subtitle", "time": 6304.79, "timestamp": "01:45:04", "text": "佩托或其他任何东西，除了庆祝"}, {"type": "subtitle", "time": 6306.43, "timestamp": "01:45:06", "text": "你自己。感谢"}, {"type": "subtitle", "time": 6309.35, "timestamp": "01:45:09", "text": "感谢你尽力而为，也希望"}, {"type": "subtitle", "time": 6312.669, "timestamp": "01:45:12", "text": "你现在应该算是享受过圣诞节了吧。甚至"}, {"type": "subtitle", "time": 6317.189, "timestamp": "01:45:17", "text": "如果你的圣诞节过得不好，至少"}, {"type": "subtitle", "time": 6328.95, "timestamp": "01:45:28", "text": "游戏玩家。很遗憾，我们的工作即将结束。"}, {"type": "subtitle", "time": 6332.07, "timestamp": "01:45:32", "text": "直播狂欢。祝你圣诞快乐"}, {"type": "subtitle", "time": 6334.55, "timestamp": "01:45:34", "text": "也一样。"}, {"type": "subtitle", "time": 6336.43, "timestamp": "01:45:36", "text": "圣诞快乐"}, {"type": "subtitle", "time": 6339.31, "timestamp": "01:45:39", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 6342.03, "timestamp": "01:45:42", "text": "出色地。希望你一切都好。"}, {"type": "subtitle", "time": 6345.75, "timestamp": "01:45:45", "text": "马特。圣诞快乐。等等，我相信"}, {"type": "subtitle", "time": 6350.55, "timestamp": "01:45:50", "text": "呃，如果我没记错的话。呃，等等，那是什么？"}, {"type": "subtitle", "time": 6353.03, "timestamp": "01:45:53", "text": "你告诉我的那个《Among Us》的时区"}, {"type": "subtitle", "time": 6355.51, "timestamp": "01:45:55", "text": "溪流？我忘了。是的，应该是这样。"}, {"type": "subtitle", "time": 6357.43, "timestamp": "01:45:57", "text": "对你来说，平安夜过得怎么样？你是"}]
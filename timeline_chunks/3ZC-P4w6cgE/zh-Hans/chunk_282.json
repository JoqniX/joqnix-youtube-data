[{"type": "subtitle", "time": 16920.15, "timestamp": "04:42:00", "text": "Roku。我的男孩"}, {"type": "subtitle", "time": 16932.77, "timestamp": "04:42:12", "text": "Roku。"}, {"type": "subtitle", "time": 16934.27, "timestamp": "04:42:14", "text": "[音乐]"}, {"type": "subtitle", "time": 16942.59, "timestamp": "04:42:22", "text": "儿子。我希望你一切都好。"}, {"type": "subtitle", "time": 16963.03, "timestamp": "04:42:43", "text": "问题是，如果我正在努力"}, {"type": "subtitle", "time": 16965.75, "timestamp": "04:42:45", "text": "我不认识新朋友，也不认识老朋友。"}, {"type": "subtitle", "time": 16968.55, "timestamp": "04:42:48", "text": "想让他们觉得，哦，我只是在做这件事而已。"}, {"type": "subtitle", "time": 16973.83, "timestamp": "04:42:53", "text": "这是为了博取关注什么的，因为我……哦，"}, {"type": "subtitle", "time": 16976.788, "timestamp": "04:42:56", "text": "有些人认为我与……合作"}]
[{"type": "subtitle", "time": 6964.07, "timestamp": "01:56:04", "text": "你好你好你好。好久不见了，我"}, {"type": "subtitle", "time": 6967.03, "timestamp": "01:56:07", "text": "想想，呃，自从我开始直播以来。我是说，"}, {"type": "subtitle", "time": 6968.87, "timestamp": "01:56:08", "text": "没过多久。我想我没做到。"}, {"type": "subtitle", "time": 6971.43, "timestamp": "01:56:11", "text": "直播几天，然后就结束了。怎么样？"}, {"type": "subtitle", "time": 6973.91, "timestamp": "01:56:13", "text": "大家都在做什么？大家最近怎么样？"}, {"type": "subtitle", "time": 6977.87, "timestamp": "01:56:17", "text": "今晚？几乎就要……"}, {"type": "subtitle", "time": 6980.43, "timestamp": "01:56:20", "text": "午夜。夜幕降临。"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "是的。哦，是的。希望你们一切都好"}, {"type": "subtitle", "time": 6986.39, "timestamp": "01:56:26", "text": "出色地。你好。你好。你好。是的。你好。"}, {"type": "subtitle", "time": 6991.27, "timestamp": "01:56:31", "text": "降低。是的。你好。你好。欢迎。"}, {"type": "subtitle", "time": 6993.91, "timestamp": "01:56:33", "text": "很高兴见到你们。已经过去一段时间了"}, {"type": "subtitle", "time": 6996.03, "timestamp": "01:56:36", "text": "这让我看到了你们。"}, {"type": "subtitle", "time": 6998.669, "timestamp": "01:56:38", "text": "新的。"}, {"type": "subtitle", "time": 7001.75, "timestamp": "01:56:41", "text": "你好。但我很想念大家。我错过了"}, {"type": "subtitle", "time": 7006.109, "timestamp": "01:56:46", "text": "每个人。大家怎么样？"}, {"type": "subtitle", "time": 7009.27, "timestamp": "01:56:49", "text": "正在做？所以，是的，今天你知道我们将"}, {"type": "subtitle", "time": 7012.43, "timestamp": "01:56:52", "text": "正在玩一款游戏"}, {"type": "subtitle", "time": 7015.43, "timestamp": "01:56:55", "text": "偶像游戏。这是一种点击式的空闲状态。"}, {"type": "subtitle", "time": 7018.91, "timestamp": "01:56:58", "text": "游戏类型。是的。"}]
[{"type": "subtitle", "time": 2222.589, "timestamp": "00:37:02", "text": "麦克里。我把麦克雷读作"}, {"type": "subtitle", "time": 2247.349, "timestamp": "00:37:27", "text": "是的。是的，我们会玩几局。"}, {"type": "subtitle", "time": 2251.109, "timestamp": "00:37:31", "text": "游戏结束后，我们会聊聊汽车。"}, {"type": "subtitle", "time": 2253.43, "timestamp": "00:37:33", "text": "我们就直接聊天吧"}, {"type": "subtitle", "time": 2274.47, "timestamp": "00:37:54", "text": "代理人。他们在谈论什么？"}, {"type": "subtitle", "time": 2279.51, "timestamp": "00:37:59", "text": "理解。他们是不是在谈论某些事？"}]
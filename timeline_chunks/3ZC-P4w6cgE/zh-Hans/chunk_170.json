[{"type": "subtitle", "time": 10207.51, "timestamp": "02:50:07", "text": "23. 哦，对，我们当时在23岁。所以"}, {"type": "subtitle", "time": 10213.11, "timestamp": "02:50:13", "text": "应该是24。哦，不。哦，是的。好的。"}, {"type": "subtitle", "time": 10240.95, "timestamp": "02:50:40", "text": "哦，橱柜在那里。"}, {"type": "subtitle", "time": 10243.11, "timestamp": "02:50:43", "text": "是的。"}, {"type": "subtitle", "time": 10244.63, "timestamp": "02:50:44", "text": "哦，是那个可以多次使用的。"}, {"type": "subtitle", "time": 10251.59, "timestamp": "02:50:51", "text": "好的，我正在收另一个。"}, {"type": "subtitle", "time": 10254.07, "timestamp": "02:50:54", "text": "另一个东西。"}, {"type": "subtitle", "time": 10255.389, "timestamp": "02:50:55", "text": "哦"}, {"type": "subtitle", "time": 10258.07, "timestamp": "02:50:58", "text": "拉屎。好了，他走了。好的，他走了"}, {"type": "subtitle", "time": 10259.83, "timestamp": "02:50:59", "text": "正面和背面。好吧，他直接冲到前面去了。"}]
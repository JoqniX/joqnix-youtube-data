[{"type": "subtitle", "time": 4141.189, "timestamp": "01:09:01", "text": "小时。是的。所以，下一部《Valerant》"}, {"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "直播将于10号开始"}, {"type": "subtitle", "time": 4146.55, "timestamp": "01:09:06", "text": "瓦勒兰斯流。是的。在这个频道。"}, {"type": "subtitle", "time": 4148.51, "timestamp": "01:09:08", "text": "是的。喜欢"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "那。是的。是的。呃，撒旦和123"}, {"type": "subtitle", "time": 4155.59, "timestamp": "01:09:15", "text": "流。是的。我想做尼迪"}, {"type": "subtitle", "time": 4157.91, "timestamp": "01:09:17", "text": "主播霸主。所以我需要进入"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "也调查一下这一点。所以，这是三个。"}, {"type": "subtitle", "time": 4165.309, "timestamp": "01:09:25", "text": "那是4天。所以"}, {"type": "subtitle", "time": 4168.11, "timestamp": "01:09:28", "text": "我打算明天去香港。"}, {"type": "subtitle", "time": 4173.63, "timestamp": "01:09:33", "text": "但我需要速通它。是的。"}, {"type": "subtitle", "time": 4176.309, "timestamp": "01:09:36", "text": "还有速通。为什么？给你一切"}, {"type": "subtitle", "time": 4178.149, "timestamp": "01:09:38", "text": "因为是试用角色，所以只持续一段时间。"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "持续3天或2天。所以包括今天在内"}, {"type": "subtitle", "time": 4185.11, "timestamp": "01:09:45", "text": "我的钟在滴答作响。好的。所以"}, {"type": "subtitle", "time": 4185.87, "timestamp": "01:09:45", "text": "那就是"}, {"type": "subtitle", "time": 4189.03, "timestamp": "01:09:49", "text": "为什么呢？所以我想，是的，我应该这么做。"}, {"type": "subtitle", "time": 4191.309, "timestamp": "01:09:51", "text": "溪流。这样岂不是更好吗？所以"}, {"type": "subtitle", "time": 4193.91, "timestamp": "01:09:53", "text": "是的，过场动画真的太棒了。"}, {"type": "subtitle", "time": 4197.11, "timestamp": "01:09:57", "text": "北海道。是的。是的。这就是我当时的想法"}, {"type": "subtitle", "time": 4199.91, "timestamp": "01:09:59", "text": "在直播中进行。说到"}]
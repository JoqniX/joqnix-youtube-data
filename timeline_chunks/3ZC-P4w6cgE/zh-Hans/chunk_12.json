[{"type": "subtitle", "time": 736.23, "timestamp": "00:12:16", "text": "你想玩吗？让我们玩。我们开始吧"}, {"type": "subtitle", "time": 744.069, "timestamp": "00:12:24", "text": "扫兴的人没看到雨要下了。"}, {"type": "subtitle", "time": 744.91, "timestamp": "00:12:24", "text": "去"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "你当时在玩弄瓦尔，却没说出来。"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "我们。我才刚开始玩《Valor》"}, {"type": "subtitle", "time": 764.829, "timestamp": "00:12:44", "text": "和"}, {"type": "subtitle", "time": 767.67, "timestamp": "00:12:47", "text": "Aoku，当你还是你的时候，呃，留下来"}, {"type": "subtitle", "time": 770.67, "timestamp": "00:12:50", "text": "当时正在直播。我当时只是在做这件事。"}, {"type": "subtitle", "time": 773.75, "timestamp": "00:12:53", "text": "聊天的时候我接了电话，然后我就换了话题。"}]
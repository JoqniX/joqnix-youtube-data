[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "有什么新鲜事要分享吗？事情看起来"}, {"type": "subtitle", "time": 7989.189, "timestamp": "02:13:09", "text": "呃，我的意思是，我不知道，对我来说就是这样"}, {"type": "subtitle", "time": 7992.47, "timestamp": "02:13:12", "text": "是的，我七月份要去日本。"}, {"type": "subtitle", "time": 7996.149, "timestamp": "02:13:16", "text": "B 我会到场，我得把事情做完。"}, {"type": "subtitle", "time": 7999.27, "timestamp": "02:13:19", "text": "一些合作之类的。我不这么称呼它"}, {"type": "subtitle", "time": 8001.35, "timestamp": "02:13:21", "text": "合作。更像是一个聚会场所。不"}, {"type": "subtitle", "time": 8003.189, "timestamp": "02:13:23", "text": "就像"}, {"type": "subtitle", "time": 8005.75, "timestamp": "02:13:25", "text": "就和遇到的朋友们一起闲逛而已"}, {"type": "subtitle", "time": 8008.87, "timestamp": "02:13:28", "text": "多年来，我们一直保持联系并进行交谈。"}, {"type": "subtitle", "time": 8011.35, "timestamp": "02:13:31", "text": "告诉他们一些事情。是的，还有那件事。它"}, {"type": "subtitle", "time": 8013.43, "timestamp": "02:13:33", "text": "是的。是的。这有点像"}, {"type": "subtitle", "time": 8015.589, "timestamp": "02:13:35", "text": "有趣的。我的意思是，我在想象"}, {"type": "subtitle", "time": 8016.87, "timestamp": "02:13:36", "text": "这些将会是你的，就像你的"}, {"type": "subtitle", "time": 8019.47, "timestamp": "02:13:39", "text": "流媒体的最后日子。是吗？我不"}, {"type": "subtitle", "time": 8023.83, "timestamp": "02:13:43", "text": "知道。我不希望是这样，但是你"}, {"type": "subtitle", "time": 8025.669, "timestamp": "02:13:45", "text": "谁也说不准现在会发生什么。所以我是"}, {"type": "subtitle", "time": 8028.629, "timestamp": "02:13:48", "text": "就像用这个来保护它一样。所以我是"}, {"type": "subtitle", "time": 8032.229, "timestamp": "02:13:52", "text": "至少我现在可以感到快乐了。是的。"}, {"type": "subtitle", "time": 8035.51, "timestamp": "02:13:55", "text": "本月已上线，并且"}, {"type": "subtitle", "time": 8037.99, "timestamp": "02:13:57", "text": "嗯，是的，和我想见的人一起玩了。"}]
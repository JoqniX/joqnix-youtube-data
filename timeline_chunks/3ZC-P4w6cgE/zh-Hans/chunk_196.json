[{"type": "subtitle", "time": 11773.87, "timestamp": "03:16:13", "text": "哦，是给这扇门用的。"}, {"type": "subtitle", "time": 11776.67, "timestamp": "03:16:16", "text": "好了，我拿到头骨了。"}, {"type": "subtitle", "time": 11780.03, "timestamp": "03:16:20", "text": "钥匙。我觉得我可以买下那个头骨"}, {"type": "subtitle", "time": 11784.229, "timestamp": "03:16:24", "text": "钥匙。我记得骷髅钥匙好像是300。"}, {"type": "subtitle", "time": 11786.07, "timestamp": "03:16:26", "text": "哦，"}, {"type": "subtitle", "time": 11803.83, "timestamp": "03:16:43", "text": "男人。好的。所以，隔壁就是"}, {"type": "subtitle", "time": 11815.63, "timestamp": "03:16:55", "text": "耶稣基督。"}]
[{"type": "subtitle", "time": 12680.269, "timestamp": "03:31:20", "text": "好的。紧贴墙壁"}, {"type": "subtitle", "time": 12700.469, "timestamp": "03:31:40", "text": "拉屎。好了，我走了。尽量到达"}, {"type": "subtitle", "time": 12702.63, "timestamp": "03:31:42", "text": "结尾。"}, {"type": "subtitle", "time": 12705.99, "timestamp": "03:31:45", "text": "但你死了。是的。是的。你在"}, {"type": "subtitle", "time": 12707.03, "timestamp": "03:31:47", "text": "自己的。"}, {"type": "subtitle", "time": 12716.229, "timestamp": "03:31:56", "text": "在哪里？呃呃，在你身后。级别。"}]
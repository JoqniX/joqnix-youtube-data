[{"type": "subtitle", "time": 2641.67, "timestamp": "00:44:01", "text": "我需要获得大量的击杀数。我"}, {"type": "subtitle", "time": 2645.109, "timestamp": "00:44:05", "text": "我尽力展现自己最好的一面，但这支队伍就是这样。"}, {"type": "subtitle", "time": 2648.55, "timestamp": "00:44:08", "text": "敌方队伍一直在后撤。我当时就想，"}, {"type": "subtitle", "time": 2651.829, "timestamp": "00:44:11", "text": "为什么？还剩一个敌人。哇。我需要一个"}, {"type": "subtitle", "time": 2653.43, "timestamp": "00:44:13", "text": "暂时放下一幅画。从"}, {"type": "subtitle", "time": 2655.03, "timestamp": "00:44:15", "text": "画画的时候，我正想吃点东西。"}, {"type": "subtitle", "time": 2688.79, "timestamp": "00:44:48", "text": "我当时正在休息。是的。"}, {"type": "subtitle", "time": 2693.069, "timestamp": "00:44:53", "text": "哦，是的。所以他是第一个给我的人"}, {"type": "subtitle", "time": 2698.18, "timestamp": "00:44:58", "text": "这是家人送的圣诞礼物。"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "[掌声]"}]
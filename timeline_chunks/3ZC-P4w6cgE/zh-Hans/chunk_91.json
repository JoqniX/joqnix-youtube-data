[{"type": "subtitle", "time": 5460.99, "timestamp": "01:31:00", "text": "也祝我好运吧。感谢"}, {"type": "subtitle", "time": 5464.59, "timestamp": "01:31:04", "text": "你和Ky也都希望如此。"}, {"type": "subtitle", "time": 5466.43, "timestamp": "01:31:06", "text": "感谢之后"}, {"type": "subtitle", "time": 5469.91, "timestamp": "01:31:09", "text": "也祝你圣诞快乐！"}, {"type": "subtitle", "time": 5471.43, "timestamp": "01:31:11", "text": "出色地。"}, {"type": "subtitle", "time": 5474.95, "timestamp": "01:31:14", "text": "希望你今天过得愉快。呃，我"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "今晚意味着你需要睡觉。你做到了"}, {"type": "subtitle", "time": 5481.99, "timestamp": "01:31:21", "text": "如果我没记错的话，直播就在旁边。等等，我……"}, {"type": "subtitle", "time": 5483.629, "timestamp": "01:31:23", "text": "你直播"}, {"type": "subtitle", "time": 5486.55, "timestamp": "01:31:26", "text": "今天？我记得那个传送门直播过。"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "我忘了是谁直播的。是 Lumina 吗？"}, {"type": "subtitle", "time": 5492.31, "timestamp": "01:31:32", "text": "还是卢奇？是的，他们两个都是。"}, {"type": "subtitle", "time": 5496.629, "timestamp": "01:31:36", "text": "当然是通过流媒体播放的。是的。是的。来吧"}, {"type": "subtitle", "time": 5500.51, "timestamp": "01:31:40", "text": "明天圣诞快乐。祝你今天愉快"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "前方。你也是个勤劳的牛仔。"}, {"type": "subtitle", "time": 5506.79, "timestamp": "01:31:46", "text": "如果我说每个人都是勤劳的牛仔，那我"}, {"type": "subtitle", "time": 5508.75, "timestamp": "01:31:48", "text": "我说的没错。是的，"}, {"type": "subtitle", "time": 5511.75, "timestamp": "01:31:51", "text": "每个人。妈妈头。是的，你正在获得"}, {"type": "subtitle", "time": 5514.149, "timestamp": "01:31:54", "text": "前往。是的，我不需要做这件事。"}, {"type": "subtitle", "time": 5516.11, "timestamp": "01:31:56", "text": "飞行模组"}]
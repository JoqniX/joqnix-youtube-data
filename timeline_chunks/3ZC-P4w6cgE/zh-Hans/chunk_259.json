[{"type": "subtitle", "time": 15548.99, "timestamp": "04:19:08", "text": "这？是的。所以，事情是这样的。"}, {"type": "subtitle", "time": 15552.07, "timestamp": "04:19:12", "text": "就是我引进的这些人，我们有"}, {"type": "subtitle", "time": 15554.349, "timestamp": "04:19:14", "text": "狗之类的。如果我信任他们，"}, {"type": "subtitle", "time": 15557.269, "timestamp": "04:19:17", "text": "一切。他们认识我。我相信他们"}, {"type": "subtitle", "time": 15560.389, "timestamp": "04:19:20", "text": "是我们正在合作的第一个项目"}, {"type": "subtitle", "time": 15565.389, "timestamp": "04:19:25", "text": "时间，我希望，我希望并期盼"}, {"type": "subtitle", "time": 15570.189, "timestamp": "04:19:30", "text": "慢慢了解他们，"}, {"type": "subtitle", "time": 15583.11, "timestamp": "04:19:43", "text": "呃，我只是希望呃，人们想要"}, {"type": "subtitle", "time": 15585.59, "timestamp": "04:19:45", "text": "你知道，比如用那种难看的眼神看着我什么的。"}, {"type": "subtitle", "time": 15587.349, "timestamp": "04:19:47", "text": "就因为我跟他们合作，或者"}, {"type": "subtitle", "time": 15589.95, "timestamp": "04:19:49", "text": "其他人或事物，你"}, {"type": "subtitle", "time": 15593.189, "timestamp": "04:19:53", "text": "我知道，却辜负了我的信任。"}, {"type": "subtitle", "time": 15594.189, "timestamp": "04:19:54", "text": "给予"}, {"type": "subtitle", "time": 15596.51, "timestamp": "04:19:56", "text": "他们"}]
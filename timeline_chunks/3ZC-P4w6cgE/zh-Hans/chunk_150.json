[{"type": "subtitle", "time": 9002.15, "timestamp": "02:30:02", "text": "有时候会有，有时候会有"}, {"type": "subtitle", "time": 9004.87, "timestamp": "02:30:04", "text": "这个怪物，一个特定的怪物"}, {"type": "subtitle", "time": 9007.27, "timestamp": "02:30:07", "text": "开始沿着走廊奔跑。你"}, {"type": "subtitle", "time": 9009.99, "timestamp": "02:30:09", "text": "必须躲避那个怪物。你"}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "你会注意到灯光闪烁。"}, {"type": "subtitle", "time": 9014.389, "timestamp": "02:30:14", "text": "你可能会听到玻璃碰撞的声音。"}, {"type": "subtitle", "time": 9019.59, "timestamp": "02:30:19", "text": "打破？你得赶紧进去。哦。嗯。"}, {"type": "subtitle", "time": 9022.469, "timestamp": "02:30:22", "text": "所以，继续前进吧。我只是一直"}, {"type": "subtitle", "time": 9024.389, "timestamp": "02:30:24", "text": "开始。这款游戏就像你"}, {"type": "subtitle", "time": 9026.55, "timestamp": "02:30:26", "text": "观察和研究哪个怪物是"}, {"type": "subtitle", "time": 9028.87, "timestamp": "02:30:28", "text": "哪些以及如何应对"}, {"type": "subtitle", "time": 9033.67, "timestamp": "02:30:33", "text": "就这样一直走到第100扇门。"}, {"type": "subtitle", "time": 9035.429, "timestamp": "02:30:35", "text": "所以这有点像一场考验游戏。"}, {"type": "subtitle", "time": 9052.59, "timestamp": "02:30:52", "text": "是的。通常当灯光亮起时"}, {"type": "subtitle", "time": 9055.03, "timestamp": "02:30:55", "text": "闪烁着，他们保持警惕，就像在守望"}, {"type": "subtitle", "time": 9057.03, "timestamp": "02:30:57", "text": "观察你的周围环境"}]
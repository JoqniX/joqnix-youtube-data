[{"type": "subtitle", "time": 8460.71, "timestamp": "02:21:00", "text": "我的账户也好像丢了。然后我"}, {"type": "subtitle", "time": 8462.87, "timestamp": "02:21:02", "text": "必须扬名立万。我不得不去"}, {"type": "subtitle", "time": 8465.71, "timestamp": "02:21:05", "text": "我发给你的那一个。这是最新的一个。"}, {"type": "subtitle", "time": 8469.27, "timestamp": "02:21:09", "text": "哦好的。哦好的。"}, {"type": "subtitle", "time": 8472.55, "timestamp": "02:21:12", "text": "是的。就像你不能更改用户一样"}, {"type": "subtitle", "time": 8475.67, "timestamp": "02:21:15", "text": "即使还有其他的，也请立即命名。"}, {"type": "subtitle", "time": 8478.55, "timestamp": "02:21:18", "text": "一个已失效的账号。我记得我曾经有过一段糟糕的经历。"}, {"type": "subtitle", "time": 8481.429, "timestamp": "02:21:21", "text": "使用 Roblox 的经验和支持"}, {"type": "subtitle", "time": 8485.03, "timestamp": "02:21:25", "text": "就像我跟他们说的那样，那就是我，但我忘了。"}, {"type": "subtitle", "time": 8486.95, "timestamp": "02:21:26", "text": "他们说我们无法连接，但我们无法连接。"}, {"type": "subtitle", "time": 8490.15, "timestamp": "02:21:30", "text": "仍然要核实你的身份和所有信息。我是"}, {"type": "subtitle", "time": 8493.03, "timestamp": "02:21:33", "text": "我只是想要回我的用户名。它"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "感觉有点奇怪，好像还有其他东西似的。"}, {"type": "subtitle", "time": 8501.03, "timestamp": "02:21:41", "text": "比乔的名字更胜一筹。是啊，就像我，我的意思是，就像我"}, {"type": "subtitle", "time": 8503.51, "timestamp": "02:21:43", "text": "难道不是吗？我的意思是，我有不好的经历。"}, {"type": "subtitle", "time": 8506.15, "timestamp": "02:21:46", "text": "就像所有这些客户支持一样"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "诸如此类的事情。就像"}, {"type": "subtitle", "time": 8512.23, "timestamp": "02:21:52", "text": "真是挺麻烦的。是的。和"}, {"type": "subtitle", "time": 8515.03, "timestamp": "02:21:55", "text": "是的，我的账号名称是"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "鹰之居。呃，就像我小时候那样"}, {"type": "subtitle", "time": 8519.83, "timestamp": "02:21:59", "text": "孩子，是的，我想成为像……一样的人"}]
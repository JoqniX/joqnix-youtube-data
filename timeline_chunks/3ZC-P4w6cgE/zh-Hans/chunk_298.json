[{"type": "subtitle", "time": 17884.55, "timestamp": "04:58:04", "text": "大概六个月前，还是八个月前？"}, {"type": "subtitle", "time": 17893.31, "timestamp": "04:58:13", "text": "所以"}, {"type": "subtitle", "time": 17896.83, "timestamp": "04:58:16", "text": "嗯，我，嗯，就像我"}, {"type": "subtitle", "time": 17899.75, "timestamp": "04:58:19", "text": "一直都想成为一名 YouTuber"}, {"type": "subtitle", "time": 17904.11, "timestamp": "04:58:24", "text": "基本上所有东西都是我自己做的"}, {"type": "subtitle", "time": 17907.83, "timestamp": "04:58:27", "text": "一切。最后"}, {"type": "subtitle", "time": 17910.868, "timestamp": "04:58:30", "text": "呃，就像你知道我所有的直播一样……"}, {"type": "subtitle", "time": 17913.55, "timestamp": "04:58:33", "text": "一直都喜欢"}, {"type": "subtitle", "time": 17916.39, "timestamp": "04:58:36", "text": "痛苦的。我不知道。做我的"}, {"type": "subtitle", "time": 17919.708, "timestamp": "04:58:39", "text": "最好的。我已经尽力了。"}, {"type": "subtitle", "time": 17922.948, "timestamp": "04:58:42", "text": "比如让直播更有趣"}, {"type": "subtitle", "time": 17925.75, "timestamp": "04:58:45", "text": "尽可能地娱乐，而且"}, {"type": "subtitle", "time": 17927.708, "timestamp": "04:58:47", "text": "主要 主要"}, {"type": "subtitle", "time": 17932.15, "timestamp": "04:58:52", "text": "尽我所能。你们很多人甚至"}, {"type": "subtitle", "time": 17934.43, "timestamp": "04:58:54", "text": "训斥了我"}, {"type": "subtitle", "time": 17937.27, "timestamp": "04:58:57", "text": "很多人因为我工作太忙而狠狠地批评了我。"}]
[{"type": "subtitle", "time": 18840.51, "timestamp": "05:14:00", "text": "某物？所以，我当时确实是那样的人。"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "那段时间我确实在做一些事情"}, {"type": "subtitle", "time": 18845.15, "timestamp": "05:14:05", "text": "这"}, {"type": "subtitle", "time": 18847.708, "timestamp": "05:14:07", "text": "直播的时候我非常投入"}, {"type": "subtitle", "time": 18851.11, "timestamp": "05:14:11", "text": "沮丧的。我哪儿都联系不上。"}, {"type": "subtitle", "time": 18853.27, "timestamp": "05:14:13", "text": "所有东西。这太难了"}, {"type": "subtitle", "time": 18854.67, "timestamp": "05:14:14", "text": "让我"}, {"type": "subtitle", "time": 18856.708, "timestamp": "05:14:16", "text": "了解我所有的新东西"}, {"type": "subtitle", "time": 18858.868, "timestamp": "05:14:18", "text": "学习"}, {"type": "subtitle", "time": 18861.03, "timestamp": "05:14:21", "text": "呃，要在流上实现之类的"}, {"type": "subtitle", "time": 18863.47, "timestamp": "05:14:23", "text": "太难了。"}, {"type": "subtitle", "time": 18867.19, "timestamp": "05:14:27", "text": "但是但是 但是"}, {"type": "subtitle", "time": 18870.15, "timestamp": "05:14:30", "text": "呃，你所有的，你所有的爱"}, {"type": "subtitle", "time": 18873.23, "timestamp": "05:14:33", "text": "来自 Discord 矿工的"}, {"type": "subtitle", "time": 18875.99, "timestamp": "05:14:35", "text": "Discord 给了我一个头巾"}, {"type": "subtitle", "time": 18878.55, "timestamp": "05:14:38", "text": "彼此都喜欢看到他们所有人"}, {"type": "subtitle", "time": 18881.23, "timestamp": "05:14:41", "text": "确实如此"}, {"type": "subtitle", "time": 18883.23, "timestamp": "05:14:43", "text": "真的"}, {"type": "subtitle", "time": 18887.19, "timestamp": "05:14:47", "text": "简直融化了我的心。而那天"}, {"type": "subtitle", "time": 18892.948, "timestamp": "05:14:52", "text": "当Zuchi发出呃呃呃的声音时，她也发了。"}, {"type": "subtitle", "time": 18897.59, "timestamp": "05:14:57", "text": "设计、草图、线稿"}, {"type": "subtitle", "time": 18899.55, "timestamp": "05:14:59", "text": "线条画。嘿"}]
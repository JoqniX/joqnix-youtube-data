[{"type": "subtitle", "time": 6124.43, "timestamp": "01:42:04", "text": "塞莱斯蒂亚"}, {"type": "subtitle", "time": 6128.149, "timestamp": "01:42:08", "text": "最后的。希望你观看直播很顺利。"}, {"type": "subtitle", "time": 6133.79, "timestamp": "01:42:13", "text": "没捣碎，也呃，做了个封面或"}, {"type": "subtitle", "time": 6136.59, "timestamp": "01:42:16", "text": "某物？"}, {"type": "subtitle", "time": 6141.83, "timestamp": "01:42:21", "text": "是的，也感谢星际游戏中的所有人和我"}, {"type": "subtitle", "time": 6144.31, "timestamp": "01:42:24", "text": "我记得，我相信是的。 Zumi也是"}, {"type": "subtitle", "time": 6145.47, "timestamp": "01:42:25", "text": "流媒体。"}, {"type": "subtitle", "time": 6147.629, "timestamp": "01:42:27", "text": "所以"}, {"type": "subtitle", "time": 6151.83, "timestamp": "01:42:31", "text": "是啊，兄弟。志美梓为她做了很多事。"}, {"type": "subtitle", "time": 6154.87, "timestamp": "01:42:34", "text": "溪流。所以我就想，“哦不，我没有"}, {"type": "subtitle", "time": 6157.109, "timestamp": "01:42:37", "text": "我没有尽全力，就像……"}, {"type": "subtitle", "time": 6159.59, "timestamp": "01:42:39", "text": "圣诞直播。”所以我就说，“不，我"}, {"type": "subtitle", "time": 6163.109, "timestamp": "01:42:43", "text": "明年至少得办个派对。"}, {"type": "subtitle", "time": 6165.59, "timestamp": "01:42:45", "text": "所以明年我计划……甚至"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "虽然今年我想做一件"}, {"type": "subtitle", "time": 6170.39, "timestamp": "01:42:50", "text": "圣诞树装饰品和摆设"}, {"type": "subtitle", "time": 6171.91, "timestamp": "01:42:51", "text": "每个人"}, {"type": "subtitle", "time": 6174.55, "timestamp": "01:42:54", "text": "呃，就像在家庭里，以及在……"}, {"type": "subtitle", "time": 6176.669, "timestamp": "01:42:56", "text": "圣诞树？我做不到。"}]
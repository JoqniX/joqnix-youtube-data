[{"type": "subtitle", "time": 10715.71, "timestamp": "02:58:35", "text": "哦，看起来它也排在最前面。"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "呃，我们在图书馆。呃，我们在哪里？"}, {"type": "subtitle", "time": 10727.15, "timestamp": "02:58:47", "text": "我觉得我得这么做。"}, {"type": "subtitle", "time": 10730.51, "timestamp": "02:58:50", "text": "像解谜一样解决"}, {"type": "subtitle", "time": 10732.349, "timestamp": "02:58:52", "text": "谜。"}, {"type": "subtitle", "time": 10736.389, "timestamp": "02:58:56", "text": "呃，我们来查一下这些。但是我们"}, {"type": "subtitle", "time": 10738.55, "timestamp": "02:58:58", "text": "不应该这样，我觉得我们这些家伙"}]
[{"type": "subtitle", "time": 12360.71, "timestamp": "03:26:00", "text": "克服重重障碍。什么是"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "第二道光？嗯，就是这个。那个"}, {"type": "subtitle", "time": 12366.469, "timestamp": "03:26:06", "text": "我正在坚持。它像钟一样。"}, {"type": "subtitle", "time": 12369.67, "timestamp": "03:26:09", "text": "呃，第二项。是的。这是什么？"}, {"type": "subtitle", "time": 12372.71, "timestamp": "03:26:12", "text": "眼睛那玩意儿？不要盯着别人的眼睛看。"}, {"type": "subtitle", "time": 12374.229, "timestamp": "03:26:14", "text": "不要看这只眼睛。别看"}, {"type": "subtitle", "time": 12376.95, "timestamp": "03:26:16", "text": "水平的白色眼球。这将是"}, {"type": "subtitle", "time": 12378.95, "timestamp": "03:26:18", "text": "也涂成了蓝色。它会有一些"}, {"type": "subtitle", "time": 12381.83, "timestamp": "03:26:21", "text": "蓝色光环。"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "[音乐]"}, {"type": "subtitle", "time": 12392.91, "timestamp": "03:26:32", "text": "眼睛。"}, {"type": "subtitle", "time": 12412.99, "timestamp": "03:26:52", "text": "[音乐]"}]
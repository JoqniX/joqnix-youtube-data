[{"type": "subtitle", "time": 4802.229, "timestamp": "01:20:02", "text": "某些被称为设施文件的笨蛋"}, {"type": "subtitle", "time": 4803.39, "timestamp": "01:20:03", "text": "他改变了"}, {"type": "subtitle", "time": 4806.07, "timestamp": "01:20:06", "text": "姓名。你以为我以为我真的"}, {"type": "subtitle", "time": 4808.43, "timestamp": "01:20:08", "text": "确实，我当时想，那是一个新的想法。"}, {"type": "subtitle", "time": 4811.91, "timestamp": "01:20:11", "text": "人。巴。你为什么改变了你的"}, {"type": "subtitle", "time": 4815.07, "timestamp": "01:20:15", "text": "姓名？巴卡设施。"}, {"type": "subtitle", "time": 4818.39, "timestamp": "01:20:18", "text": "嗯？他以为我错过了你，我认错你了。"}, {"type": "subtitle", "time": 4821.51, "timestamp": "01:20:21", "text": "为了新的突破，我当时就想，“哦，你的"}, {"type": "subtitle", "time": 4831.83, "timestamp": "01:20:31", "text": "东西。”你知道，你躲不开"}, {"type": "subtitle", "time": 4839.51, "timestamp": "01:20:39", "text": "我。我将用你的新名字称呼你。"}, {"type": "subtitle", "time": 4842.91, "timestamp": "01:20:42", "text": "现在。是的。专业"}, {"type": "subtitle", "time": 4849.03, "timestamp": "01:20:49", "text": "沙姆比什。 Uh Io ASO，谢谢你"}, {"type": "subtitle", "time": 4851.91, "timestamp": "01:20:51", "text": "过来看看，也祝你圣诞快乐。现在"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "谢谢你询问是谁画的"}, {"type": "subtitle", "time": 4856.55, "timestamp": "01:20:56", "text": "模型和所有东西。但是，伙计们，就……"}]
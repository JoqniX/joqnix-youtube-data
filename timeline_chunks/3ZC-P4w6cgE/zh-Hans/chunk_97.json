[{"type": "subtitle", "time": 5821.83, "timestamp": "01:37:01", "text": "你感谢Akyabi说狗"}, {"type": "subtitle", "time": 5826.07, "timestamp": "01:37:06", "text": "那场战争让我想起了那件事，"}, {"type": "subtitle", "time": 5829.83, "timestamp": "01:37:09", "text": "哈桑说，哪条狗是战争之犬？"}, {"type": "subtitle", "time": 5832.629, "timestamp": "01:37:12", "text": "相当于战神狗，我的天啊！"}, {"type": "subtitle", "time": 5842.79, "timestamp": "01:37:22", "text": "抱歉打扰您了。"}, {"type": "subtitle", "time": 5847.27, "timestamp": "01:37:27", "text": "看着我，待在我身边之类的。"}, {"type": "subtitle", "time": 5850.229, "timestamp": "01:37:30", "text": "意义重大。不，我一直都在看"}, {"type": "subtitle", "time": 5852.629, "timestamp": "01:37:32", "text": "你如此积极参与"}, {"type": "subtitle", "time": 5855.83, "timestamp": "01:37:35", "text": "整个流。非常非常感谢！"}, {"type": "subtitle", "time": 5859.03, "timestamp": "01:37:39", "text": "因为他坚持到了最后。问候。"}, {"type": "subtitle", "time": 5861.27, "timestamp": "01:37:41", "text": "希望你现在能睡个好觉。"}, {"type": "subtitle", "time": 5864.55, "timestamp": "01:37:44", "text": "也祝你圣诞快乐。嗯？"}, {"type": "subtitle", "time": 5867.35, "timestamp": "01:37:47", "text": "我们还是一起玩瓦林吧。不。而且"}, {"type": "subtitle", "time": 5870.07, "timestamp": "01:37:50", "text": "是的，我看到了你在那条评论上的评论。"}, {"type": "subtitle", "time": 5873.27, "timestamp": "01:37:53", "text": "我直播了Valerant。它太可爱了。"}, {"type": "subtitle", "time": 5875.91, "timestamp": "01:37:55", "text": "你的声音好可爱。即使你"}, {"type": "subtitle", "time": 5878.229, "timestamp": "01:37:58", "text": "不想让它显示出来，你不小心……"}]
[{"type": "subtitle", "time": 5040.03, "timestamp": "01:24:00", "text": "座位"}, {"type": "subtitle", "time": 5041.87, "timestamp": "01:24:01", "text": "礼拜和"}, {"type": "subtitle", "time": 5044.87, "timestamp": "01:24:04", "text": "游戏也崩溃了。电脑崩溃了，对吧？你"}, {"type": "subtitle", "time": 5049.11, "timestamp": "01:24:09", "text": "他说没关系。这种事时有发生。但是，"}, {"type": "subtitle", "time": 5051.39, "timestamp": "01:24:11", "text": "希望你和他玩得开心"}, {"type": "subtitle", "time": 5053.99, "timestamp": "01:24:13", "text": "溪流。希望你们喜欢。和"}, {"type": "subtitle", "time": 5058.629, "timestamp": "01:24:18", "text": "昨天真是太开心了。希望你小便"}, {"type": "subtitle", "time": 5061.99, "timestamp": "01:24:21", "text": "和你在一起，留下来。我感到非常惊讶"}, {"type": "subtitle", "time": 5065.35, "timestamp": "01:24:25", "text": "赢下那三场毫无意义的比赛。哦，我的"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "上帝。"}, {"type": "subtitle", "time": 5077.99, "timestamp": "01:24:37", "text": "很享受。也祝你圣诞快乐。"}, {"type": "subtitle", "time": 5079.87, "timestamp": "01:24:39", "text": "是什么"}, {"type": "subtitle", "time": 5093.59, "timestamp": "01:24:53", "text": "今天。希望你过得愉快"}, {"type": "subtitle", "time": 5096.95, "timestamp": "01:24:56", "text": "溪流。希望你今天过得愉快。我懂了"}]
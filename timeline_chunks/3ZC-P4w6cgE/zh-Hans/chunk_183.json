[{"type": "subtitle", "time": 10988.469, "timestamp": "03:03:08", "text": "我看到前面有东西。"}, {"type": "subtitle", "time": 10991.59, "timestamp": "03:03:11", "text": "哦，好吧，你看。有个复兴计划"}, {"type": "subtitle", "time": 10994.95, "timestamp": "03:03:14", "text": "在你前方左侧。是的。"}, {"type": "subtitle", "time": 10999.83, "timestamp": "03:03:19", "text": "你看到了吗？是的。我没看见你。"}, {"type": "subtitle", "time": 11001.67, "timestamp": "03:03:21", "text": "哦，等等。这就是我。哦，没事了。"}, {"type": "subtitle", "time": 11004.63, "timestamp": "03:03:24", "text": "是的。我当时想，“哦，看看它。”"}, {"type": "subtitle", "time": 11012.71, "timestamp": "03:03:32", "text": "对不起。我想一旦我离开这里，"}, {"type": "subtitle", "time": 11015.19, "timestamp": "03:03:35", "text": "我认为你可以安全地救活我。不是"}, {"type": "subtitle", "time": 11017.51, "timestamp": "03:03:37", "text": "当然。"}, {"type": "subtitle", "time": 11018.87, "timestamp": "03:03:38", "text": "不，不，没关系。没关系。不"}, {"type": "subtitle", "time": 11023.59, "timestamp": "03:03:43", "text": "浪费钱。好的。"}]
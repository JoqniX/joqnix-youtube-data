[{"type": "subtitle", "time": 122.23, "timestamp": "00:02:02", "text": "我真的很喜欢这个概念"}, {"type": "subtitle", "time": 126.389, "timestamp": "00:02:06", "text": "洪凯对"}, {"type": "subtitle", "time": 129.35, "timestamp": "00:02:09", "text": "呃，正在进行的新活动在哪里"}, {"type": "subtitle", "time": 132.22899999999998, "timestamp": "00:02:12", "text": "匈牙利帝国这款游戏就像……一样崩塌了。"}, {"type": "subtitle", "time": 135.83, "timestamp": "00:02:15", "text": "腐败之类的东西会变得……你知道的……"}, {"type": "subtitle", "time": 138.43, "timestamp": "00:02:18", "text": "遇到麻烦了，就像……"}, {"type": "subtitle", "time": 140.949, "timestamp": "00:02:20", "text": "管理员女孩进来了，就像我们一样"}, {"type": "subtitle", "time": 143.67000000000002, "timestamp": "00:02:23", "text": "修复游戏之类的"}, {"type": "subtitle", "time": 145.82999999999998, "timestamp": "00:02:25", "text": "是的。所有角色都是"}, {"type": "subtitle", "time": 148.39, "timestamp": "00:02:28", "text": "就像游戏循环一样。我们修复了他们的记忆"}, {"type": "subtitle", "time": 151.11, "timestamp": "00:02:31", "text": "还有数据库之类的东西。那是"}, {"type": "subtitle", "time": 153.07, "timestamp": "00:02:33", "text": "凉爽的。凉爽的。我爱"}, {"type": "subtitle", "time": 156.15, "timestamp": "00:02:36", "text": "那。这给了我一些启发。"}, {"type": "subtitle", "time": 157.55, "timestamp": "00:02:37", "text": "为了"}, {"type": "subtitle", "time": 160.07, "timestamp": "00:02:40", "text": "我。我当时就想，“哇，这太……”"}, {"type": "subtitle", "time": 176.63, "timestamp": "00:02:56", "text": "再见。"}]
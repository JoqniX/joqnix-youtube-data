[{"type": "subtitle", "time": 7204.35, "timestamp": "02:00:04", "text": "呃，无限等于。好的。游戏。什么是"}, {"type": "subtitle", "time": 7208.83, "timestamp": "02:00:08", "text": "这？只要他们有一定数量"}, {"type": "subtitle", "time": 7210.91, "timestamp": "02:00:10", "text": "降低。"}, {"type": "subtitle", "time": 7216.43, "timestamp": "02:00:16", "text": "效果。什么是"}, {"type": "subtitle", "time": 7219.83, "timestamp": "02:00:19", "text": "这？好的。你已经收集了足够的"}, {"type": "subtitle", "time": 7222.229, "timestamp": "02:00:22", "text": "用灰尘购买升级。点击"}, {"type": "subtitle", "time": 7225.91, "timestamp": "02:00:25", "text": "底部的红色购物篮"}, {"type": "subtitle", "time": 7237.55, "timestamp": "02:00:37", "text": "哦，你只是做些清洁工作。"}, {"type": "subtitle", "time": 7240.82, "timestamp": "02:00:40", "text": "A，你只需要打扫卫生。真是这样"}, {"type": "subtitle", "time": 7243.629, "timestamp": "02:00:43", "text": "[音乐]"}, {"type": "subtitle", "time": 7252.589, "timestamp": "02:00:52", "text": "它。 A，这是"}, {"type": "subtitle", "time": 7255.669, "timestamp": "02:00:55", "text": "乐趣。就像我把鼠标悬停在……"}]
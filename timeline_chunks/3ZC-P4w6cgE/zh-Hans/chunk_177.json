[{"type": "subtitle", "time": 10645.51, "timestamp": "02:57:25", "text": "好的，我没事了。哦，不错。好的。"}, {"type": "subtitle", "time": 10648.71, "timestamp": "02:57:28", "text": "[音乐]"}, {"type": "subtitle", "time": 10653.15, "timestamp": "02:57:33", "text": "圣。是的，我们在门口"}, {"type": "subtitle", "time": 10666.389, "timestamp": "02:57:46", "text": "你不能保存你的检查点"}, {"type": "subtitle", "time": 10669.99, "timestamp": "02:57:49", "text": "或者别的什么。不。呃，不。就像我唯一的"}, {"type": "subtitle", "time": 10671.59, "timestamp": "02:57:51", "text": "想想你只需要坚持下去。"}, {"type": "subtitle", "time": 10674.71, "timestamp": "02:57:54", "text": "直到你到达100号门。"}, {"type": "subtitle", "time": 10677.59, "timestamp": "02:57:57", "text": "哦。好的。我想我们当时不得不躲起来。"}]
[{"type": "subtitle", "time": 19500.43, "timestamp": "05:25:00", "text": "那。"}, {"type": "subtitle", "time": 19503.39, "timestamp": "05:25:03", "text": "他妈的。他妈的。"}, {"type": "subtitle", "time": 19506.948, "timestamp": "05:25:06", "text": "你好。你好。呃，我正在使用窗口"}, {"type": "subtitle", "time": 19507.868, "timestamp": "05:25:07", "text": "照片"}, {"type": "subtitle", "time": 19511.708, "timestamp": "05:25:11", "text": "东西。嘿，我们放大看看。"}, {"type": "subtitle", "time": 19514.83, "timestamp": "05:25:14", "text": "现在。所以你可以看到我的"}, {"type": "subtitle", "time": 19519.948, "timestamp": "05:25:19", "text": "老鼠。你好。所以，这些是"}, {"type": "subtitle", "time": 19526.27, "timestamp": "05:25:26", "text": "像基拉一样闪耀的星座。"}, {"type": "subtitle", "time": 19528.99, "timestamp": "05:25:28", "text": "H. 还有这个"}, {"type": "subtitle", "time": 19534.83, "timestamp": "05:25:34", "text": "一个还有Zuchi，我的妈妈。猜猜看。这是一个"}, {"type": "subtitle", "time": 19537.788, "timestamp": "05:25:37", "text": "星座。是狮子座，"}, {"type": "subtitle", "time": 19540.948, "timestamp": "05:25:40", "text": "实际上。而Leo是呃，是我的呃，做什么"}, {"type": "subtitle", "time": 19541.948, "timestamp": "05:25:41", "text": "你打电话"}, {"type": "subtitle", "time": 19544.628, "timestamp": "05:25:44", "text": "它？那东西叫什么来着？我忘了。"}, {"type": "subtitle", "time": 19549.43, "timestamp": "05:25:49", "text": "呃，我的注意力缺陷多动症症状又加重了。呃，我出生在"}, {"type": "subtitle", "time": 19552.39, "timestamp": "05:25:52", "text": "八月。所以它叫什么来着？什么"}, {"type": "subtitle", "time": 19555.75, "timestamp": "05:25:55", "text": "再签一次？是的。星座之类的东西。"}, {"type": "subtitle", "time": 19558.11, "timestamp": "05:25:58", "text": "是的。是的。"}]
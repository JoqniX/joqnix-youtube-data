[{"type": "subtitle", "time": 14221.91, "timestamp": "03:57:01", "text": "好的。严格来说，在这个游戏中，你会得到"}, {"type": "subtitle", "time": 14223.75, "timestamp": "03:57:03", "text": "钥匙。有了钥匙，你或许能找到"}, {"type": "subtitle", "time": 14225.83, "timestamp": "03:57:05", "text": "钥匙在某个地方，比如钥匙孔里。我"}, {"type": "subtitle", "time": 14228.15, "timestamp": "03:57:08", "text": "你可以按你的方式加入并获取登录信息。"}, {"type": "subtitle", "time": 14231.11, "timestamp": "03:57:11", "text": "好的。好的。是的。是的。"}, {"type": "subtitle", "time": 14239.429, "timestamp": "03:57:19", "text": "你在哪里？请不要。我在"}, {"type": "subtitle", "time": 14241.51, "timestamp": "03:57:21", "text": "中心定制大厅。在哪里？"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "你？"}, {"type": "subtitle", "time": 14245.11, "timestamp": "03:57:25", "text": "哦哦，我明白了。我看见你。这里。这里。"}, {"type": "subtitle", "time": 14254.91, "timestamp": "03:57:34", "text": "我。这里需要用到所有的按键。"}, {"type": "subtitle", "time": 14260.11, "timestamp": "03:57:40", "text": "所以，"}, {"type": "subtitle", "time": 14262.429, "timestamp": "03:57:42", "text": "哦，我得到了吗？"}, {"type": "subtitle", "time": 14265.269, "timestamp": "03:57:45", "text": "好的。不，有一首歌我一直都在听。"}, {"type": "subtitle", "time": 14268.429, "timestamp": "03:57:48", "text": "我太想得到它了。"}, {"type": "subtitle", "time": 14272.55, "timestamp": "03:57:52", "text": "游戏。所以，当我像网络哭泣一样的时候，哦我的天哪"}, {"type": "subtitle", "time": 14275.91, "timestamp": "03:57:55", "text": "天哪，真是这样。就好像，就像……"}]
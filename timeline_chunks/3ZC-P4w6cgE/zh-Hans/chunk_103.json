[{"type": "subtitle", "time": 6180.39, "timestamp": "01:43:00", "text": "但是，至少明年我希望能够做到"}, {"type": "subtitle", "time": 6182.47, "timestamp": "01:43:02", "text": "明天就做。我不知道所有"}, {"type": "subtitle", "time": 6186.149, "timestamp": "01:43:06", "text": "我需要的东西。是啊，但是"}, {"type": "subtitle", "time": 6188.709, "timestamp": "01:43:08", "text": "至少明年我们会这样做。"}, {"type": "subtitle", "time": 6191.35, "timestamp": "01:43:11", "text": "一棵巨大的圣诞树，里面装满了……"}, {"type": "subtitle", "time": 6192.35, "timestamp": "01:43:12", "text": "单身的"}, {"type": "subtitle", "time": 6194.95, "timestamp": "01:43:14", "text": "一。那会有多少个呢？我不"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "知道。我不知道的比这更多，但我想要"}, {"type": "subtitle", "time": 6202.31, "timestamp": "01:43:22", "text": "把我认识的每个人都加进去。是的。"}, {"type": "subtitle", "time": 6204.95, "timestamp": "01:43:24", "text": "那些不在家族中的人"}, {"type": "subtitle", "time": 6207.47, "timestamp": "01:43:27", "text": "还有那些家庭成员"}, {"type": "subtitle", "time": 6210.35, "timestamp": "01:43:30", "text": "包括。是的。"}, {"type": "subtitle", "time": 6213.149, "timestamp": "01:43:33", "text": "是的。别理我。我只是个架子"}, {"type": "subtitle", "time": 6238.91, "timestamp": "01:43:58", "text": "我刚刚看到了"}]
[{"type": "subtitle", "time": 10262.469, "timestamp": "02:51:02", "text": "然后返回。"}, {"type": "subtitle", "time": 10265.79, "timestamp": "02:51:05", "text": "哦，又一个，我的天哪"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "哦，不。噪音。"}, {"type": "subtitle", "time": 10270.55, "timestamp": "02:51:10", "text": "等待。所以，你打算如何保持这种状态？"}, {"type": "subtitle", "time": 10274.67, "timestamp": "02:51:14", "text": "那？确切地。我正要拿到那东西。"}, {"type": "subtitle", "time": 10277.03, "timestamp": "02:51:17", "text": "就像有什么东西阻止你一样"}, {"type": "subtitle", "time": 10281.269, "timestamp": "02:51:21", "text": "藏起来之类的。嗯，有两个。"}, {"type": "subtitle", "time": 10283.75, "timestamp": "02:51:23", "text": "你们两个。不用担心。不用担心。我"}, {"type": "subtitle", "time": 10285.96, "timestamp": "02:51:25", "text": "抓到你了。"}, {"type": "subtitle", "time": 10294.309, "timestamp": "02:51:34", "text": "B.好的。哦，等等。你浪费时间"}, {"type": "subtitle", "time": 10296.87, "timestamp": "02:51:36", "text": "那里有钱。没关系。但我已经"}, {"type": "subtitle", "time": 10299.19, "timestamp": "02:51:39", "text": "有。我买东西主要就是为了"}, {"type": "subtitle", "time": 10302.71, "timestamp": "02:51:42", "text": "把房子弄到手。所以我现在就像"}, {"type": "subtitle", "time": 10304.55, "timestamp": "02:51:44", "text": "我对目前拥有的一切感到满意。我有"}, {"type": "subtitle", "time": 10319.87, "timestamp": "02:51:59", "text": "好的。它在哪儿？ 28. 是的。"}]
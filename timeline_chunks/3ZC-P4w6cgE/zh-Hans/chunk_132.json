[{"type": "subtitle", "time": 7920.709, "timestamp": "02:12:00", "text": "至少先把这件艺术品完成吧。"}, {"type": "subtitle", "time": 7924.069, "timestamp": "02:12:04", "text": "大概一两天就能速通了"}, {"type": "subtitle", "time": 7927.189, "timestamp": "02:12:07", "text": "离开。但更像是……"}, {"type": "subtitle", "time": 7930.629, "timestamp": "02:12:10", "text": "不，这是钢铁侠。所以，嗯，我是"}, {"type": "subtitle", "time": 7933.75, "timestamp": "02:12:13", "text": "等待动画上线"}, {"type": "subtitle", "time": 7935.99, "timestamp": "02:12:15", "text": "拖车。我的意思是，对于动画预告片来说"}, {"type": "subtitle", "time": 7938.55, "timestamp": "02:12:18", "text": "降低。所以，目前，我想……"}, {"type": "subtitle", "time": 7941.669, "timestamp": "02:12:21", "text": "保持《飙马野郎》的热度并点赞"}, {"type": "subtitle", "time": 7943.83, "timestamp": "02:12:23", "text": "可能会吸引一些JoJo粉丝前来。"}, {"type": "subtitle", "time": 7946.79, "timestamp": "02:12:26", "text": "也向我的社区致以问候。但是……"}, {"type": "subtitle", "time": 7949.03, "timestamp": "02:12:29", "text": "我打算做的就是，"}, {"type": "subtitle", "time": 7951.39, "timestamp": "02:12:31", "text": "好的，我每个月都会尝试画一幅画。"}, {"type": "subtitle", "time": 7954.95, "timestamp": "02:12:34", "text": "从每个角色身上取一块钢材"}, {"type": "subtitle", "time": 7957.83, "timestamp": "02:12:37", "text": "球跑，这样我就可以玩JoJo了"}, {"type": "subtitle", "time": 7959.79, "timestamp": "02:12:39", "text": "粉丝。"}, {"type": "subtitle", "time": 7963.83, "timestamp": "02:12:43", "text": "但那样做会干扰我的"}, {"type": "subtitle", "time": 7965.75, "timestamp": "02:12:45", "text": "也适合漫画。"}, {"type": "subtitle", "time": 7967.47, "timestamp": "02:12:47", "text": "是的。"}, {"type": "subtitle", "time": 7969.229, "timestamp": "02:12:49", "text": "[音乐]"}, {"type": "subtitle", "time": 7972.709, "timestamp": "02:12:52", "text": "啊，你最终会完成你的漫画的。"}, {"type": "subtitle", "time": 7976.149, "timestamp": "02:12:56", "text": "我很期待。"}, {"type": "subtitle", "time": 7978.95, "timestamp": "02:12:58", "text": "我希望如此。那你呢？"}]
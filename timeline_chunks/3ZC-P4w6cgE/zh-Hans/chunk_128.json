[{"type": "subtitle", "time": 7693.03, "timestamp": "02:08:13", "text": "伙计们。昨天很开心。我过得很愉快"}, {"type": "subtitle", "time": 7694.189, "timestamp": "02:08:14", "text": "时间"}, {"type": "subtitle", "time": 7697.149, "timestamp": "02:08:17", "text": "昨天。真的"}, {"type": "subtitle", "time": 7699.149, "timestamp": "02:08:19", "text": "乐趣。"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "我当时就在想"}, {"type": "subtitle", "time": 7705.069, "timestamp": "02:08:25", "text": "种类"}, {"type": "subtitle", "time": 7709.629, "timestamp": "02:08:29", "text": "做出一些改变。我"}, {"type": "subtitle", "time": 7712.069, "timestamp": "02:08:32", "text": "我想尽可能多地了解……"}, {"type": "subtitle", "time": 7716.149, "timestamp": "02:08:36", "text": "我曾和大多数人赛跑过"}, {"type": "subtitle", "time": 7719.31, "timestamp": "02:08:39", "text": "人民。一"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "第二。我尽量争取得到这三者中的大部分。"}, {"type": "subtitle", "time": 7724.069, "timestamp": "02:08:44", "text": "周三的人们。是的，一个"}, {"type": "subtitle", "time": 7726.669, "timestamp": "02:08:46", "text": "第二。伊曼是"}, {"type": "subtitle", "time": 7731.27, "timestamp": "02:08:51", "text": "这里。你好。呃，等等，让我……"}, {"type": "subtitle", "time": 7738.43, "timestamp": "02:08:58", "text": "溪流。好的。"}]
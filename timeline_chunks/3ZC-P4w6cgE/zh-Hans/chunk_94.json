[{"type": "subtitle", "time": 5640.59, "timestamp": "01:34:00", "text": "我的"}, {"type": "subtitle", "time": 5643.99, "timestamp": "01:34:03", "text": "鼻子？啵。我该如何发出“啵”的声音？我"}, {"type": "subtitle", "time": 5647.189, "timestamp": "01:34:07", "text": "需要一个可以戳一下的东西。那是绿色的吗？"}, {"type": "subtitle", "time": 5650.87, "timestamp": "01:34:10", "text": "屏幕啵啵声？我想把它放进去。我"}, {"type": "subtitle", "time": 5658.95, "timestamp": "01:34:18", "text": "鼻子。我们也想要胸部。是的。如果我是"}, {"type": "subtitle", "time": 5661.27, "timestamp": "01:34:21", "text": "你很擅长动画制作，对吧？我想"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "接下来做一只真正的狗拉屎"}, {"type": "subtitle", "time": 5685.27, "timestamp": "01:34:45", "text": "Bing，我不知道，最近突然出现在我面前。"}, {"type": "subtitle", "time": 5686.03, "timestamp": "01:34:46", "text": "这"}, {"type": "subtitle", "time": 5693.669, "timestamp": "01:34:53", "text": "我知道你现在想要boop，我该怎么做才能让你开心？"}, {"type": "subtitle", "time": 5696.03, "timestamp": "01:34:56", "text": "我拥有的"}, {"type": "subtitle", "time": 5699.11, "timestamp": "01:34:59", "text": "你为什么会这样？"}]
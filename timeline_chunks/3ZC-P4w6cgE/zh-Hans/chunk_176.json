[{"type": "subtitle", "time": 10567.309, "timestamp": "02:56:07", "text": "呃，上面没写。哦，该死。哦，"}, {"type": "subtitle", "time": 10568.99, "timestamp": "02:56:08", "text": "不。"}, {"type": "subtitle", "time": 10571.55, "timestamp": "02:56:11", "text": "好的。哦，真好，真好。"}, {"type": "subtitle", "time": 10602.63, "timestamp": "02:56:42", "text": "是。好的，乔克。所以对于这一点，我们……"}, {"type": "subtitle", "time": 10606.469, "timestamp": "02:56:46", "text": "必须像跑步一样。哦，不。和"}, {"type": "subtitle", "time": 10608.71, "timestamp": "02:56:48", "text": "不要回头。就这么继续"}, {"type": "subtitle", "time": 10611.11, "timestamp": "02:56:51", "text": "向前跑。"}, {"type": "subtitle", "time": 10613.99, "timestamp": "02:56:53", "text": "我的天啊。真令人毛骨悚然"}, {"type": "subtitle", "time": 10618.15, "timestamp": "02:56:58", "text": "鱼竿运行。跟随光芒。滑入"}]
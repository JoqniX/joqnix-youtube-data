[{"type": "subtitle", "time": 13931.429, "timestamp": "03:52:11", "text": "哦，视线。"}, {"type": "subtitle", "time": 13935.03, "timestamp": "03:52:15", "text": "不。我又来了？但我不能回去"}, {"type": "subtitle", "time": 13937.83, "timestamp": "03:52:17", "text": "他也是。哦，你不能走到他身后。"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "不，不，不。你不能走到他身后，因为"}, {"type": "subtitle", "time": 13941.99, "timestamp": "03:52:21", "text": "他正看着你。仅仅是"}, {"type": "subtitle", "time": 13944.349, "timestamp": "03:52:24", "text": "墙。你必须走，你必须跑。"}, {"type": "subtitle", "time": 13947.389, "timestamp": "03:52:27", "text": "向后走，然后躲起来。"}, {"type": "subtitle", "time": 13950.79, "timestamp": "03:52:30", "text": "哦，那就再去一次。"}, {"type": "subtitle", "time": 13953.03, "timestamp": "03:52:33", "text": "嗯。所以，就像你向前跑一样"}, {"type": "subtitle", "time": 13954.87, "timestamp": "03:52:34", "text": "直到他消失，然后离开"}]
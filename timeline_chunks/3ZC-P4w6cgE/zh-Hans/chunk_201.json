[{"type": "subtitle", "time": 12061.03, "timestamp": "03:21:01", "text": "优雅。更像是这样"}, {"type": "subtitle", "time": 12064.229, "timestamp": "03:21:04", "text": "更令人紧张或压力更大。"}, {"type": "subtitle", "time": 12065.75, "timestamp": "03:21:05", "text": "另一个我觉得更像是“哦，"}, {"type": "subtitle", "time": 12067.03, "timestamp": "03:21:07", "text": "就像高速奔跑一样，有点像……"}, {"type": "subtitle", "time": 12071.98, "timestamp": "03:21:11", "text": "就像滑行一样。让我打开看看。"}, {"type": "subtitle", "time": 12077.75, "timestamp": "03:21:17", "text": "[音乐]"}, {"type": "subtitle", "time": 12080.67, "timestamp": "03:21:20", "text": "好的，你可以加入我。"}, {"type": "subtitle", "time": 12094.83, "timestamp": "03:21:34", "text": "呃，好的。在哪里？"}, {"type": "subtitle", "time": 12098.79, "timestamp": "03:21:38", "text": "你？好的。好的。所以严格来说"}, {"type": "subtitle", "time": 12102.11, "timestamp": "03:21:42", "text": "这是，呃，这更像是第一次"}, {"type": "subtitle", "time": 12105.83, "timestamp": "03:21:45", "text": "像他这样的人现在看起来可能"}, {"type": "subtitle", "time": 12107.429, "timestamp": "03:21:47", "text": "控制这类事情的方式有点奇怪"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "那。所以，去这扇门，跳进去。"}, {"type": "subtitle", "time": 12115.59, "timestamp": "03:21:55", "text": "你们为什么要离婚？"}, {"type": "subtitle", "time": 12119.03, "timestamp": "03:21:59", "text": "哦，这是我的默认立场。"}]
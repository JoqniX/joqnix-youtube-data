[{"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "对每个人来说。我非常爱你们。所以"}, {"type": "subtitle", "time": 6626.51, "timestamp": "01:50:26", "text": "是的，好好享受吧"}, {"type": "subtitle", "time": 6631.43, "timestamp": "01:50:31", "text": "圣诞节也要玩得开心。别忘了"}, {"type": "subtitle", "time": 6635.149, "timestamp": "01:50:35", "text": "呃，做你平常做的那些好事，"}, {"type": "subtitle", "time": 6637.99, "timestamp": "01:50:37", "text": "尽力而为，谢谢。"}, {"type": "subtitle", "time": 6641.31, "timestamp": "01:50:41", "text": "感谢你尽力而为，也"}, {"type": "subtitle", "time": 6644.629, "timestamp": "01:50:44", "text": "也别忘了微笑，因为……"}, {"type": "subtitle", "time": 6646.59, "timestamp": "01:50:46", "text": "祝您今天一切顺利，直到结束。"}, {"type": "subtitle", "time": 6651.149, "timestamp": "01:50:51", "text": "明天。不过，还是要笑容灿烂。"}, {"type": "subtitle", "time": 6654.07, "timestamp": "01:50:54", "text": "好吧，即使这对某些人来说是个艰难的处境"}, {"type": "subtitle", "time": 6657.83, "timestamp": "01:50:57", "text": "你身处其中，但依然微笑"}, {"type": "subtitle", "time": 6659.43, "timestamp": "01:50:59", "text": "最好的。"}]
[{"type": "subtitle", "time": 20043.47, "timestamp": "05:34:03", "text": "你等了，音乐停了吗？"}, {"type": "subtitle", "time": 20048.99, "timestamp": "05:34:08", "text": "没变笨"}, {"type": "subtitle", "time": 20050.91, "timestamp": "05:34:10", "text": "哑的。等待，"}, {"type": "subtitle", "time": 20053.628, "timestamp": "05:34:13", "text": "真的吗？"}, {"type": "subtitle", "time": 20058.07, "timestamp": "05:34:18", "text": "好的。嘿。嘿。继续。你看"}, {"type": "subtitle", "time": 20060.628, "timestamp": "05:34:20", "text": "我感觉就像在做爱。我不知道"}, {"type": "subtitle", "time": 20062.99, "timestamp": "05:34:22", "text": "如果你能看到"}, {"type": "subtitle", "time": 20065.39, "timestamp": "05:34:25", "text": "它。"}, {"type": "subtitle", "time": 20069.05, "timestamp": "05:34:29", "text": "呃，我打算……"}, {"type": "subtitle", "time": 20082.03, "timestamp": "05:34:42", "text": "所以，我一直很喜欢当个酷的人。"}, {"type": "subtitle", "time": 20084.948, "timestamp": "05:34:44", "text": "孩子，是酷男孩中的一员，"}, {"type": "subtitle", "time": 20089.35, "timestamp": "05:34:49", "text": "东西。嗯，你知道，我想成为一名……"}, {"type": "subtitle", "time": 20090.99, "timestamp": "05:34:50", "text": "酷的一部分"}, {"type": "subtitle", "time": 20094.91, "timestamp": "05:34:54", "text": "孩子们。酷小孩们。"}, {"type": "subtitle", "time": 20099.708, "timestamp": "05:34:59", "text": "是的。你好。所以，更快乐了"}]
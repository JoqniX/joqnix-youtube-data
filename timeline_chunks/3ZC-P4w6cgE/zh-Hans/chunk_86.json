[{"type": "subtitle", "time": 5160.55, "timestamp": "01:26:00", "text": "下午和晚上对你来说是什么时候？所以"}, {"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "是啊，也该休息一下了。"}, {"type": "subtitle", "time": 5165.99, "timestamp": "01:26:05", "text": "然后去做你想做的艺术创作。"}, {"type": "subtitle", "time": 5167.229, "timestamp": "01:26:07", "text": "和"}, {"type": "subtitle", "time": 5169.27, "timestamp": "01:26:09", "text": "一切。等等，你不是走上来的。"}, {"type": "subtitle", "time": 5171.27, "timestamp": "01:26:11", "text": "你说你在休息"}, {"type": "subtitle", "time": 5174.189, "timestamp": "01:26:14", "text": "你当时正在工作，对吧？我的错。所以"}, {"type": "subtitle", "time": 5177.11, "timestamp": "01:26:17", "text": "是的，一旦你必须服用大量"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "首先，确保你知道如何获得奖励"}, {"type": "subtitle", "time": 5182.629, "timestamp": "01:26:22", "text": "给自己买些好东西，然后喜欢"}, {"type": "subtitle", "time": 5185.35, "timestamp": "01:26:25", "text": "你知道，就是那种用心去战斗的感觉。"}, {"type": "subtitle", "time": 5187.55, "timestamp": "01:26:27", "text": "嗯？"}, {"type": "subtitle", "time": 5191.59, "timestamp": "01:26:31", "text": "也祝你圣诞夜快乐！"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "H，也适用于那些不了解的人"}, {"type": "subtitle", "time": 5202.95, "timestamp": "01:26:42", "text": "我知道，是乌布·查玛画的。"}, {"type": "subtitle", "time": 5205.669, "timestamp": "01:26:45", "text": "这真是太棒了！让我"}, {"type": "subtitle", "time": 5213.79, "timestamp": "01:26:53", "text": "伙计们。这不是很可爱吗？这是我的"}, {"type": "subtitle", "time": 5216.95, "timestamp": "01:26:56", "text": "我收到的第一份圣诞礼物是……"}, {"type": "subtitle", "time": 5218.669, "timestamp": "01:26:58", "text": "收到"}]
[{"type": "subtitle", "time": 1458.669, "timestamp": "00:24:18", "text": "不，我死了"}, {"type": "subtitle", "time": 1462.39, "timestamp": "00:24:22", "text": "首先，这很糟糕。那很糟糕。你"}, {"type": "subtitle", "time": 1467.029, "timestamp": "00:24:27", "text": "伙计们，走吧？不。尖峰向下。一个"}, {"type": "subtitle", "time": 1469.83, "timestamp": "00:24:29", "text": "已启动。"}, {"type": "subtitle", "time": 1483.95, "timestamp": "00:24:43", "text": "很清楚。"}, {"type": "subtitle", "time": 1485.99, "timestamp": "00:24:45", "text": "[音乐]"}, {"type": "subtitle", "time": 1488.63, "timestamp": "00:24:48", "text": "不。最后剩下的玩家。"}]
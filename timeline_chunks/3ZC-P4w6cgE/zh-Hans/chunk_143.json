[{"type": "subtitle", "time": 8580.23, "timestamp": "02:23:00", "text": "嗯。是的。"}, {"type": "subtitle", "time": 8584.469, "timestamp": "02:23:04", "text": "好的。让我进去一下。"}, {"type": "subtitle", "time": 8586.23, "timestamp": "02:23:06", "text": "你接受好友请求了吗？我 我"}, {"type": "subtitle", "time": 8590.23, "timestamp": "02:23:10", "text": "找到你了。哦，是的。我做了，你做了吗？"}, {"type": "subtitle", "time": 8592.349, "timestamp": "02:23:12", "text": "接受？我已向你发送好友请求。你"}, {"type": "subtitle", "time": 8596.309, "timestamp": "02:23:16", "text": "做过？我也发给你了。等待。哦。哦，不。"}, {"type": "subtitle", "time": 8597.27, "timestamp": "02:23:17", "text": "我们是朋友。我们是朋友。所以，就是这样。"}, {"type": "subtitle", "time": 8601.469, "timestamp": "02:23:21", "text": "好的。我们已经是朋友了。哦，不错。"}, {"type": "subtitle", "time": 8604.309, "timestamp": "02:23:24", "text": "呃，好的。"}, {"type": "subtitle", "time": 8607.03, "timestamp": "02:23:27", "text": "好的。所以，现在我想你可以加入我了。"}, {"type": "subtitle", "time": 8608.79, "timestamp": "02:23:28", "text": "哦，等等。呃，你可能会看到我的用户名"}, {"type": "subtitle", "time": 8612.469, "timestamp": "02:23:32", "text": "在主页上。"}, {"type": "subtitle", "time": 8615.11, "timestamp": "02:23:35", "text": "是的。是的，我看到了。好的，让我点击"}, {"type": "subtitle", "time": 8623.03, "timestamp": "02:23:43", "text": "加入。为什么显示正在安装？等待，"}, {"type": "subtitle", "time": 8624.63, "timestamp": "02:23:44", "text": "我不是已经更新了吗？我和它一起玩过"}, {"type": "subtitle", "time": 8628.469, "timestamp": "02:23:48", "text": "最近里海地区。什么？呃，然后它"}, {"type": "subtitle", "time": 8631.83, "timestamp": "02:23:51", "text": "是的，它就会更新时间。"}, {"type": "subtitle", "time": 8634.389, "timestamp": "02:23:54", "text": "我想，大概是因为时间吧。就像，哦，有……"}, {"type": "subtitle", "time": 8636.71, "timestamp": "02:23:56", "text": "我觉得应该不会太长。"}]
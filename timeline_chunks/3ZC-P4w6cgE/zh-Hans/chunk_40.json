[{"type": "subtitle", "time": 2408.23, "timestamp": "00:40:08", "text": "等等，背靠背。等等，什么？什么"}, {"type": "subtitle", "time": 2409.55, "timestamp": "00:40:09", "text": "代理人？"}, {"type": "subtitle", "time": 2412.67, "timestamp": "00:40:12", "text": "什么？我没被打到。"}, {"type": "subtitle", "time": 2417.31, "timestamp": "00:40:17", "text": "什么？他跟哪些特工说了什么？后退"}, {"type": "subtitle", "time": 2433.91, "timestamp": "00:40:33", "text": "哦不，他们要选这个人。"}, {"type": "subtitle", "time": 2435.829, "timestamp": "00:40:35", "text": "对不起。"}, {"type": "subtitle", "time": 2459.15, "timestamp": "00:40:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 9966.71, "timestamp": "02:46:06", "text": "哦，该死。我把他忘了。"}, {"type": "subtitle", "time": 9968.71, "timestamp": "02:46:08", "text": "这是什么？药品。药品。"}, {"type": "subtitle", "time": 9970.389, "timestamp": "02:46:10", "text": "所以，请随身携带。如果你拿"}, {"type": "subtitle", "time": 9972.87, "timestamp": "02:46:12", "text": "损坏，你可以利用它。"}, {"type": "subtitle", "time": 9992.63, "timestamp": "02:46:32", "text": "哦，是哦。哦。好的。隐藏。隐藏。隐藏。"}, {"type": "subtitle", "time": 9994.95, "timestamp": "02:46:34", "text": "我要把那个柜子搬走。"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "好的。好的。好的。他可以"}, {"type": "subtitle", "time": 10007.59, "timestamp": "02:46:47", "text": "出来。好的。据我观察，"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "就像那人是灰色的。当他头发变灰时，"}, {"type": "subtitle", "time": 10011.99, "timestamp": "02:46:51", "text": "方法"}, {"type": "subtitle", "time": 10014.87, "timestamp": "02:46:54", "text": "好的。追随光芒。"}, {"type": "subtitle", "time": 10017.67, "timestamp": "02:46:57", "text": "你在哪里？哦。好的。所以，当"}]
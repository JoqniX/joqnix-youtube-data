[{"type": "subtitle", "time": 8522.23, "timestamp": "02:22:02", "text": "像 Roblox Minecraft 那样的 YouTuber"}, {"type": "subtitle", "time": 8526.23, "timestamp": "02:22:06", "text": "YouTuber，就叫 Eagle Place。但就像我"}, {"type": "subtitle", "time": 8528.389, "timestamp": "02:22:08", "text": "我的梦突然停止了"}, {"type": "subtitle", "time": 8531.59, "timestamp": "02:22:11", "text": "当我想到它的时候，我感觉很沮丧。"}, {"type": "subtitle", "time": 8534.79, "timestamp": "02:22:14", "text": "我学到了一点东西"}, {"type": "subtitle", "time": 8538.469, "timestamp": "02:22:18", "text": "就像我曾经那么热衷于此一样"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "成为 YouTuber 的时候，我就像在做……"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "许多计划等等，以及在"}, {"type": "subtitle", "time": 8546.23, "timestamp": "02:22:26", "text": "结局从未发生过。我从未"}, {"type": "subtitle", "time": 8548.63, "timestamp": "02:22:28", "text": "变得像个油管博主一样。"}, {"type": "subtitle", "time": 8551.349, "timestamp": "02:22:31", "text": "但就伊曼纽尔的案子而言，"}, {"type": "subtitle", "time": 8553.83, "timestamp": "02:22:33", "text": "就像我刚才想的那样，让我像这样"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "点击录制或开始直播"}, {"type": "subtitle", "time": 8560.309, "timestamp": "02:22:40", "text": "就像我现在这样正在直播"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "看到这些数字，感觉真好。"}, {"type": "subtitle", "time": 8565.03, "timestamp": "02:22:45", "text": "通过。事情就是这样。我认为我们"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "人们往往喜欢计划事情。"}, {"type": "subtitle", "time": 8569.91, "timestamp": "02:22:49", "text": "太多了。它可以到达那个点"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "如果我们只是这样做，它就永远不会发生，而我们只是"}, {"type": "subtitle", "time": 8574.389, "timestamp": "02:22:54", "text": "计划，一个接一个地制定计划。"}, {"type": "subtitle", "time": 8576.349, "timestamp": "02:22:56", "text": "真的。真的。"}]
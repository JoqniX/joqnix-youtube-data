[{"type": "subtitle", "time": 3301.03, "timestamp": "00:55:01", "text": "那我们去哪儿聊呢？死的。死的。"}, {"type": "subtitle", "time": 3302.67, "timestamp": "00:55:02", "text": "等待，"}, {"type": "subtitle", "time": 3305.47, "timestamp": "00:55:05", "text": "什么？他死了。"}, {"type": "subtitle", "time": 3307.95, "timestamp": "00:55:07", "text": "死的。不是"}, {"type": "subtitle", "time": 3311.109, "timestamp": "00:55:11", "text": "哎呀。但你为什么要走？为什么？"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "有人要去吗？哎呀。巴。"}, {"type": "subtitle", "time": 3318.069, "timestamp": "00:55:18", "text": "该死。我们走吧。我应该继续放吗？"}, {"type": "subtitle", "time": 3320.71, "timestamp": "00:55:20", "text": "把他们打倒？哦，因为我在这里面有个呃"}, {"type": "subtitle", "time": 3335.71, "timestamp": "00:55:35", "text": "敌人"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "[掌声]"}, {"type": "subtitle", "time": 3345.47, "timestamp": "00:55:45", "text": "小心。我有"}, {"type": "subtitle", "time": 3349.069, "timestamp": "00:55:49", "text": "长钉。差不多准备好了。"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "开始了。"}]
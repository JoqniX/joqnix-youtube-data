[{"type": "subtitle", "time": 180.25, "timestamp": "00:03:00", "text": "斑。我走了。"}, {"type": "subtitle", "time": 189.84, "timestamp": "00:03:09", "text": "侦察机被摧毁。"}, {"type": "subtitle", "time": 192.47, "timestamp": "00:03:12", "text": "[音乐]"}, {"type": "subtitle", "time": 199.50900000000001, "timestamp": "00:03:19", "text": "没能种下刺。长钉"}, {"type": "subtitle", "time": 208.47, "timestamp": "00:03:28", "text": "有人想玩，我的意思是，咱们一起玩吧。我们开始吧"}, {"type": "subtitle", "time": 224.82999999999998, "timestamp": "00:03:44", "text": "出去。"}, {"type": "subtitle", "time": 228.63, "timestamp": "00:03:48", "text": "杀。烟雾散去了。"}, {"type": "subtitle", "time": 231.50900000000001, "timestamp": "00:03:51", "text": "重新装弹。释放烟雾。最后一名玩家"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "常设。"}]
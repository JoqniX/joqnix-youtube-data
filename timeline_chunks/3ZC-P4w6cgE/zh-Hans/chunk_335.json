[{"type": "subtitle", "time": 20105.59, "timestamp": "05:35:05", "text": "事物。而且，呃，你也……"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "有一种风潮，人人都知道。"}, {"type": "subtitle", "time": 20110.99, "timestamp": "05:35:10", "text": "你有白色"}, {"type": "subtitle", "time": 20113.99, "timestamp": "05:35:13", "text": "头发。你有一根白头发。 H头发"}, {"type": "subtitle", "time": 20116.47, "timestamp": "05:35:16", "text": "这意味着你是永生的。是的，我是"}, {"type": "subtitle", "time": 20120.23, "timestamp": "05:35:20", "text": "实际上我是永生的，因为我重生了。"}, {"type": "subtitle", "time": 20122.11, "timestamp": "05:35:22", "text": "鉴于我的"}, {"type": "subtitle", "time": 20128.35, "timestamp": "05:35:28", "text": "你好。所以，我是永生的。"}, {"type": "subtitle", "time": 20138.43, "timestamp": "05:35:38", "text": "也。你想成为一个很酷的孩子吗？只是"}, {"type": "subtitle", "time": 20142.43, "timestamp": "05:35:42", "text": "是的。穿孔和一个大圆"}, {"type": "subtitle", "time": 20145.51, "timestamp": "05:35:45", "text": "戴眼镜看起来很酷。"}, {"type": "subtitle", "time": 20148.47, "timestamp": "05:35:48", "text": "比如做发型之类的，但是"}, {"type": "subtitle", "time": 20150.548, "timestamp": "05:35:50", "text": "你像这样，戴着粉笔，"}, {"type": "subtitle", "time": 20159.19, "timestamp": "05:35:59", "text": "等等，你把所有兑换码都删掉了。"}]
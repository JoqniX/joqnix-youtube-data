[{"type": "subtitle", "time": 20342.03, "timestamp": "05:39:02", "text": "看？妈妈。祖赤。前辈。"}, {"type": "subtitle", "time": 20349.83, "timestamp": "05:39:09", "text": "他居然送了我耳环。好可爱"}, {"type": "subtitle", "time": 20352.07, "timestamp": "05:39:12", "text": "我也一直一直一直想"}, {"type": "subtitle", "time": 20355.23, "timestamp": "05:39:15", "text": "你知道，我刚才说的就是这个。"}, {"type": "subtitle", "time": 20357.75, "timestamp": "05:39:17", "text": "对，我刚才说了我想成为"}, {"type": "subtitle", "time": 20362.548, "timestamp": "05:39:22", "text": "酷小孩的一部分，酷小孩的一部分，是的。"}, {"type": "subtitle", "time": 20364.99, "timestamp": "05:39:24", "text": "我太害羞了"}, {"type": "subtitle", "time": 20372.27, "timestamp": "05:39:32", "text": "是的，就是这样。"}, {"type": "subtitle", "time": 20375.11, "timestamp": "05:39:35", "text": "继续说这是我的频道，你知道的。"}, {"type": "subtitle", "time": 20377.99, "timestamp": "05:39:37", "text": "我一直对粉笔情有独钟"}, {"type": "subtitle", "time": 20381.83, "timestamp": "05:39:41", "text": "我甚至有一天也穿过，你知道吗？"}, {"type": "subtitle", "time": 20383.23, "timestamp": "05:39:43", "text": "我太"}, {"type": "subtitle", "time": 20387.548, "timestamp": "05:39:47", "text": "内向。嗯，我性格很内向，"}, {"type": "subtitle", "time": 20390.07, "timestamp": "05:39:50", "text": "我觉得出门很困难"}, {"type": "subtitle", "time": 20392.708, "timestamp": "05:39:52", "text": "东西，但我喜欢打扮。"}, {"type": "subtitle", "time": 20394.67, "timestamp": "05:39:54", "text": "和"}, {"type": "subtitle", "time": 20399.51, "timestamp": "05:39:59", "text": "东西。所以，是的，我以前有过类似这样的经历"}]
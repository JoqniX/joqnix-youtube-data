[{"type": "subtitle", "time": 9187.59, "timestamp": "02:33:07", "text": "等等，13号门在这里。是的。是的，的确如此。"}, {"type": "subtitle", "time": 9189.83, "timestamp": "02:33:09", "text": "有点奇怪。是的。保持"}, {"type": "subtitle", "time": 9193.19, "timestamp": "02:33:13", "text": "记住是哪扇门。哦，我想"}, {"type": "subtitle", "time": 9204.389, "timestamp": "02:33:24", "text": "好吧，没事了。好的。我当时想"}, {"type": "subtitle", "time": 9213.07, "timestamp": "02:33:33", "text": "好的。出色地，"}, {"type": "subtitle", "time": 9221.07, "timestamp": "02:33:41", "text": "好了，现在你可以得到了"}, {"type": "subtitle", "time": 9223.71, "timestamp": "02:33:43", "text": "出去。出去。"}, {"type": "subtitle", "time": 9227.23, "timestamp": "02:33:47", "text": "呃。哦。哦"}, {"type": "subtitle", "time": 9229.75, "timestamp": "02:33:49", "text": "拉屎。好的。我一直在看你的屏幕。"}, {"type": "subtitle", "time": 9231.27, "timestamp": "02:33:51", "text": "你正遭受攻击。就像那样"}, {"type": "subtitle", "time": 9233.349, "timestamp": "02:33:53", "text": "如果你一直待在橱柜里会发生什么？"}, {"type": "subtitle", "time": 9236.469, "timestamp": "02:33:56", "text": "时间太长了。你还好吗？哦"}]
[{"type": "subtitle", "time": 19321.55, "timestamp": "05:22:01", "text": "你好可爱"}, {"type": "subtitle", "time": 19324.27, "timestamp": "05:22:04", "text": "所以"}, {"type": "subtitle", "time": 19337.43, "timestamp": "05:22:17", "text": "嘿，咱们从头开始吧。所以，呃"}, {"type": "subtitle", "time": 19339.55, "timestamp": "05:22:19", "text": "你看到了"}, {"type": "subtitle", "time": 19344.03, "timestamp": "05:22:24", "text": "嗯，我身上的闪闪发光的东西"}, {"type": "subtitle", "time": 19352.03, "timestamp": "05:22:32", "text": "仙女棒。"}, {"type": "subtitle", "time": 19355.03, "timestamp": "05:22:35", "text": "第二个嘛，嗯……就像……"}, {"type": "subtitle", "time": 19358.708, "timestamp": "05:22:38", "text": "你看到那个紫色的东西了吗？我想知道"}, {"type": "subtitle", "time": 19361.948, "timestamp": "05:22:41", "text": "那是什么？大家有什么猜测吗？"}, {"type": "subtitle", "time": 19364.91, "timestamp": "05:22:44", "text": "聊天？你觉得呢？"}, {"type": "subtitle", "time": 19367.91, "timestamp": "05:22:47", "text": "是？呃，朝我的右边。头发"}, {"type": "subtitle", "time": 19371.19, "timestamp": "05:22:51", "text": "我右边有一段视频片段。那是"}, {"type": "subtitle", "time": 19373.15, "timestamp": "05:22:53", "text": "右边。正确的。是的。"}, {"type": "subtitle", "time": 19377.19, "timestamp": "05:22:57", "text": "正确的。你好。右边。你怎么认为"}]
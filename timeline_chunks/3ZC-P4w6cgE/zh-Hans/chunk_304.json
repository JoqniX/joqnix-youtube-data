[{"type": "subtitle", "time": 18240.51, "timestamp": "05:04:00", "text": "男生。我在逗你玩。我真的不知道"}, {"type": "subtitle", "time": 18244.27, "timestamp": "05:04:04", "text": "它。那是我的嘴唇。"}, {"type": "subtitle", "time": 18269.27, "timestamp": "05:04:29", "text": "音乐？哦，这是什么？一个圆圆的东西。"}, {"type": "subtitle", "time": 18270.59, "timestamp": "05:04:30", "text": "什么是"}, {"type": "subtitle", "time": 18272.99, "timestamp": "05:04:32", "text": "这？"}, {"type": "subtitle", "time": 18277.23, "timestamp": "05:04:37", "text": "H：我们这边有东西。什么是"}, {"type": "subtitle", "time": 18280.788, "timestamp": "05:04:40", "text": "这？这是眼睛。我戴着眼镜。哦。"}, {"type": "subtitle", "time": 18296.91, "timestamp": "05:04:56", "text": "哦，好了。那是我的脸。"}, {"type": "subtitle", "time": 18298.93, "timestamp": "05:04:58", "text": "哦。"}]
[{"type": "subtitle", "time": 19208.11, "timestamp": "05:20:08", "text": "正确的？嘿，你在那里能看到我"}, {"type": "subtitle", "time": 19211.11, "timestamp": "05:20:11", "text": "实际上。但我不该隐藏"}, {"type": "subtitle", "time": 19214.07, "timestamp": "05:20:14", "text": "我？我也会这样。哦，我去。"}, {"type": "subtitle", "time": 19220.03, "timestamp": "05:20:20", "text": "猜测。"}, {"type": "subtitle", "time": 19224.868, "timestamp": "05:20:24", "text": "你好。哦，等等。嗯……我有没有……我"}, {"type": "subtitle", "time": 19245.47, "timestamp": "05:20:45", "text": "这。你好。你好。你好。"}, {"type": "subtitle", "time": 19247.99, "timestamp": "05:20:47", "text": "你好。是的。这是调色板，作者"}, {"type": "subtitle", "time": 19248.83, "timestamp": "05:20:48", "text": "道路。"}, {"type": "subtitle", "time": 19252.99, "timestamp": "05:20:52", "text": "你好。哦，我应该保留它吗？"}, {"type": "subtitle", "time": 19255.75, "timestamp": "05:20:55", "text": "这？你好。"}, {"type": "subtitle", "time": 19258.708, "timestamp": "05:20:58", "text": "首先问问大家，你们想去哪里？"}]
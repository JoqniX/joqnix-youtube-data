[{"type": "subtitle", "time": 14341.03, "timestamp": "03:59:01", "text": "老兄，那太好玩了。谢谢你，莫。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "教我怎么玩do。"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "没问题。嗯。没问题。莫，"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "太好玩了。"}, {"type": "subtitle", "time": 14355.03, "timestamp": "03:59:15", "text": "也挺好玩的。是的。是的。"}, {"type": "subtitle", "time": 14358.309, "timestamp": "03:59:18", "text": "不过，祝你好运。"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "或许我们应该多聚聚。"}, {"type": "subtitle", "time": 14366.229, "timestamp": "03:59:26", "text": "是的。哦，当然可以。是的。是的。是的。我"}, {"type": "subtitle", "time": 14368.389, "timestamp": "03:59:28", "text": "就像未来一样，即使时区"}, {"type": "subtitle", "time": 14371.429, "timestamp": "03:59:31", "text": "这个问题我们还是待在家里吧。"}, {"type": "subtitle", "time": 14373.99, "timestamp": "03:59:33", "text": "好的。没问题。是的。是的。是的。"}, {"type": "subtitle", "time": 14377.95, "timestamp": "03:59:37", "text": "是的。好的。好的。拿"}, {"type": "subtitle", "time": 14381.189, "timestamp": "03:59:41", "text": "照顾好自己。再见。小心"}, {"type": "subtitle", "time": 14384.95, "timestamp": "03:59:44", "text": "聊聊或者再见。另外，在你之前"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "你离开前有什么要宣布的吗？"}, {"type": "subtitle", "time": 14390.55, "timestamp": "03:59:50", "text": "想做吗？糟糕。而我将会是"}, {"type": "subtitle", "time": 14392.71, "timestamp": "03:59:52", "text": "我猜大概30分钟后就能直播了。"}, {"type": "subtitle", "time": 14394.79, "timestamp": "03:59:54", "text": "呃，星期一，来点音乐。所以，可能只是"}, {"type": "subtitle", "time": 14399.429, "timestamp": "03:59:59", "text": "是的，我一直在创作音乐。嗯。等待。"}]
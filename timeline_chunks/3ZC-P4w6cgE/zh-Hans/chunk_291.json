[{"type": "subtitle", "time": 17471.51, "timestamp": "04:51:11", "text": "好的。好的，现在是七点。我"}, {"type": "subtitle", "time": 17495.43, "timestamp": "04:51:35", "text": "是的，在那件事之后，还有维克。"}, {"type": "subtitle", "time": 17498.51, "timestamp": "04:51:38", "text": "呃，如果我……他会迟到一会儿。"}, {"type": "subtitle", "time": 17501.59, "timestamp": "04:51:41", "text": "没错，因为他停电了。"}, {"type": "subtitle", "time": 17504.23, "timestamp": "04:51:44", "text": "发生了。所以我们只能暂时拥有他"}, {"type": "subtitle", "time": 17506.43, "timestamp": "04:51:46", "text": "很少"}, {"type": "subtitle", "time": 17510.23, "timestamp": "04:51:50", "text": "瞬间。嗯，因为停电就是电力。"}, {"type": "subtitle", "time": 17512.59, "timestamp": "04:51:52", "text": "切割正在发生"}, {"type": "subtitle", "time": 17513.84, "timestamp": "04:51:53", "text": "西班牙"}]
[{"type": "subtitle", "time": 5223.47, "timestamp": "01:27:03", "text": "股票。我的天啊。难道不是这样吗？"}, {"type": "subtitle", "time": 5226.669, "timestamp": "01:27:06", "text": "可爱的？这真是太"}, {"type": "subtitle", "time": 5231.11, "timestamp": "01:27:11", "text": "可爱的。不过，我希望这件事是由……完成的。"}, {"type": "subtitle", "time": 5244.87, "timestamp": "01:27:24", "text": "等等，Cocki 给我的是什么？"}, {"type": "subtitle", "time": 5247.79, "timestamp": "01:27:27", "text": "雪球那玩意儿？我认为他"}, {"type": "subtitle", "time": 5250.31, "timestamp": "01:27:30", "text": "没有。问号。我没看到它"}, {"type": "subtitle", "time": 5252.149, "timestamp": "01:27:32", "text": "DM。我不知道他是否派我来的。"}, {"type": "subtitle", "time": 5255.229, "timestamp": "01:27:35", "text": "在服务器上。呃"}, {"type": "subtitle", "time": 5259.51, "timestamp": "01:27:39", "text": "是的，我拒绝了，我的确拒绝了。"}, {"type": "subtitle", "time": 5261.59, "timestamp": "01:27:41", "text": "我不想吃饼干，因为我不想吃他"}, {"type": "subtitle", "time": 5263.55, "timestamp": "01:27:43", "text": "到"}, {"type": "subtitle", "time": 5266.95, "timestamp": "01:27:46", "text": "呃，你知道，浪费他的时间，或者就像，是的。"}, {"type": "subtitle", "time": 5269.43, "timestamp": "01:27:49", "text": "很多人都说想……"}, {"type": "subtitle", "time": 5273.189, "timestamp": "01:27:53", "text": "搞个滚雪球游戏。但我现在有"}, {"type": "subtitle", "time": 5276.27, "timestamp": "01:27:56", "text": "给我的架子放个雪球。看看这个"}, {"type": "subtitle", "time": 5279.669, "timestamp": "01:27:59", "text": "卡瓦伊。是的，是她自己做的。她"}]
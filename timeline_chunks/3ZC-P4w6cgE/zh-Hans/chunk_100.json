[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "我的天啊。我甚至还带了眼镜片。呃"}, {"type": "subtitle", "time": 6005.87, "timestamp": "01:40:05", "text": "是的，我的眼镜也有一个"}, {"type": "subtitle", "time": 6008.79, "timestamp": "01:40:08", "text": "姓名。我的天啊。"}, {"type": "subtitle", "time": 6009.79, "timestamp": "01:40:09", "text": "提醒"}, {"type": "subtitle", "time": 6032.03, "timestamp": "01:40:32", "text": "今天来这里"}, {"type": "subtitle", "time": 6036.31, "timestamp": "01:40:36", "text": "死。今天过得很开心。你今天过得愉快吗？"}, {"type": "subtitle", "time": 6038.03, "timestamp": "01:40:38", "text": "作为"}, {"type": "subtitle", "time": 6045.55, "timestamp": "01:40:45", "text": "不。快乐，快乐"}]
[{"type": "subtitle", "time": 19682.15, "timestamp": "05:28:02", "text": "呃，如果你们呃呃记得大多数"}, {"type": "subtitle", "time": 19685.59, "timestamp": "05:28:05", "text": "在我玩的所有游戏中，当我制作……"}, {"type": "subtitle", "time": 19688.31, "timestamp": "05:28:08", "text": "我尝试塑造的角色往往会增加更多"}, {"type": "subtitle", "time": 19693.35, "timestamp": "05:28:13", "text": "它既有蓝色又有紫色。嗯。"}, {"type": "subtitle", "time": 19695.948, "timestamp": "05:28:15", "text": "所以那些"}, {"type": "subtitle", "time": 19698.31, "timestamp": "05:28:18", "text": "代表这些发带，也"}, {"type": "subtitle", "time": 19704.35, "timestamp": "05:28:24", "text": "黑色也是。黑帮 黑帮 # 黑帮"}, {"type": "subtitle", "time": 19706.19, "timestamp": "05:28:26", "text": "帮派"}, {"type": "subtitle", "time": 19709.75, "timestamp": "05:28:29", "text": "所以这就是为什么这三个人有"}, {"type": "subtitle", "time": 19710.99, "timestamp": "05:28:30", "text": "答案"}, {"type": "subtitle", "time": 19712.59, "timestamp": "05:28:32", "text": "代表"}, {"type": "subtitle", "time": 19716.708, "timestamp": "05:28:36", "text": "就像那些相互连接的颜色一样"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "经常和我在一起，而且也带来了"}, {"type": "subtitle", "time": 19727.788, "timestamp": "05:28:47", "text": "[音乐]"}, {"type": "subtitle", "time": 19730.708, "timestamp": "05:28:50", "text": "meishaw 那是我的"}, {"type": "subtitle", "time": 19733.03, "timestamp": "05:28:53", "text": "H. 如果你问我最喜欢的是什么，那"}, {"type": "subtitle", "time": 19735.948, "timestamp": "05:28:55", "text": "颜色，那其实是……"}, {"type": "subtitle", "time": 19739.43, "timestamp": "05:28:59", "text": "哦。哦，我喜欢，我是说我喜欢所有的一切。"}]
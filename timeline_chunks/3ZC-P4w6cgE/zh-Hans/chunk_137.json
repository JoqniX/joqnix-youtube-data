[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "是的。是的。我当时在想……"}, {"type": "subtitle", "time": 8224.469, "timestamp": "02:17:04", "text": "在那里上传一些类似vlog的视频。如果"}, {"type": "subtitle", "time": 8228.629, "timestamp": "02:17:08", "text": "如果我能及时编辑它，或者像这样"}, {"type": "subtitle", "time": 8231.429, "timestamp": "02:17:11", "text": "即使没有经过太多修改，它也是"}, {"type": "subtitle", "time": 8235.509, "timestamp": "02:17:15", "text": "美好的。我想只要我能做到，我就可以。"}, {"type": "subtitle", "time": 8239.349, "timestamp": "02:17:19", "text": "回到每一件事上来，"}, {"type": "subtitle", "time": 8241.75, "timestamp": "02:17:21", "text": "东西没事的。"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "嗯。是的。不，那会有点……"}, {"type": "subtitle", "time": 8247.03, "timestamp": "02:17:27", "text": "有趣的。就像我能想象的那样"}, {"type": "subtitle", "time": 8248.629, "timestamp": "02:17:28", "text": "可能还会有点喜欢"}, {"type": "subtitle", "time": 8251.589, "timestamp": "02:17:31", "text": "就像在咖啡馆里录音一样"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "就简单地问候一下，比如“你今天过得怎么样？”"}, {"type": "subtitle", "time": 8256.549, "timestamp": "02:17:36", "text": "去了诸如此类的事情。"}, {"type": "subtitle", "time": 8260.23, "timestamp": "02:17:40", "text": "我的天哪，那肯定很有趣。是的。所以你"}, {"type": "subtitle", "time": 8261.83, "timestamp": "02:17:41", "text": "不必再忍受那种噪音了。"}, {"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "投诉之类的。真的。"}, {"type": "subtitle", "time": 8266.07, "timestamp": "02:17:46", "text": "真的。是的。现在它变成一台笔记本电脑了。我可以"}, {"type": "subtitle", "time": 8267.75, "timestamp": "02:17:47", "text": "去任何地方。"}, {"type": "subtitle", "time": 8270.75, "timestamp": "02:17:50", "text": "是的。哦"}, {"type": "subtitle", "time": 8275.99, "timestamp": "02:17:55", "text": "是的，还有那件事。那挺好的。但是呃"}, {"type": "subtitle", "time": 8278.15, "timestamp": "02:17:58", "text": "是啊，我在想我该怎么拿我的麦克风呢？"}]
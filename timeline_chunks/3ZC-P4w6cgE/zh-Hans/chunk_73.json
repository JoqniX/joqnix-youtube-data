[{"type": "subtitle", "time": 4381.03, "timestamp": "01:13:01", "text": "今天来的这些人。 H 所有"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "今天来过的人。啊，路过"}, {"type": "subtitle", "time": 4386.669, "timestamp": "01:13:06", "text": "今天新鲜出炉。"}, {"type": "subtitle", "time": 4390.149, "timestamp": "01:13:10", "text": "是的，谢谢你今天过来。我们有一个不错的"}, {"type": "subtitle", "time": 4392.95, "timestamp": "01:13:12", "text": "圣诞前夜好。我相信它仍然是"}, {"type": "subtitle", "time": 4396.709, "timestamp": "01:13:16", "text": "对你来说，圣诞节还是24号。我认为"}, {"type": "subtitle", "time": 4399.43, "timestamp": "01:13:19", "text": "我已经投保了。我不知道。是的，但是"}, {"type": "subtitle", "time": 4405.43, "timestamp": "01:13:25", "text": "圣诞节。是的。现在还是24日晚上"}, {"type": "subtitle", "time": 4407.63, "timestamp": "01:13:27", "text": "为你。所以，"}, {"type": "subtitle", "time": 4410.79, "timestamp": "01:13:30", "text": "是的。圣诞快乐。离开。不"}, {"type": "subtitle", "time": 4413.59, "timestamp": "01:13:33", "text": "今天我可爱的儿子过来了。面包送来了"}, {"type": "subtitle", "time": 4416.51, "timestamp": "01:13:36", "text": "把你的面包献给即将到来的人"}, {"type": "subtitle", "time": 4420.669, "timestamp": "01:13:40", "text": "也。祝你圣诞快乐！"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "出色地。谢谢光临。离开我"}, {"type": "subtitle", "time": 4427.27, "timestamp": "01:13:47", "text": "很多。然后他今天过来给了我"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "两份礼物。一个甜甜圈，还有一个是"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "虽然是以表情符号的形式呈现，但却是一把剑。"}, {"type": "subtitle", "time": 4439.11, "timestamp": "01:13:59", "text": "谢谢你送我两份礼物，迪奥。"}]
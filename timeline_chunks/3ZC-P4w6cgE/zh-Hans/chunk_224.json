[{"type": "subtitle", "time": 13460.87, "timestamp": "03:44:20", "text": "墙。哦，"}, {"type": "subtitle", "time": 13464.229, "timestamp": "03:44:24", "text": "你是如何躲过那场检查的？你得看看"}, {"type": "subtitle", "time": 13466.389, "timestamp": "03:44:26", "text": "直接对着它，然后我想应该是按E键。"}, {"type": "subtitle", "time": 13469.11, "timestamp": "03:44:29", "text": "当你靠近门口时。不，"}, {"type": "subtitle", "time": 13472.71, "timestamp": "03:44:32", "text": "火车司机。哦，是的。哦，是的。那"}, {"type": "subtitle", "time": 13475.11, "timestamp": "03:44:35", "text": "对，就是那家伙。你必须离开"}, {"type": "subtitle", "time": 13476.95, "timestamp": "03:44:36", "text": "他的视线。就像……"}, {"type": "subtitle", "time": 13480.63, "timestamp": "03:44:40", "text": "我面前是一堵墙，就像我看到它时一样。"}, {"type": "subtitle", "time": 13482.55, "timestamp": "03:44:42", "text": "他，他看到了我，就像那辆拖车一样"}, {"type": "subtitle", "time": 13485.55, "timestamp": "03:44:45", "text": "那里。我走到墙后面，那面墙……"}, {"type": "subtitle", "time": 13489.11, "timestamp": "03:44:49", "text": "干扰他，就像干扰他的视线一样"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "一旦我离开他的视线范围，"}]
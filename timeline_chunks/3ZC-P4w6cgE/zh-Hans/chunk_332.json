[{"type": "subtitle", "time": 19926.11, "timestamp": "05:32:06", "text": "期待您的光临。希望您入住愉快。"}, {"type": "subtitle", "time": 19928.19, "timestamp": "05:32:08", "text": "社区和"}, {"type": "subtitle", "time": 19930.99, "timestamp": "05:32:10", "text": "溪流。你好"}, {"type": "subtitle", "time": 19934.27, "timestamp": "05:32:14", "text": "头部。这样行得通吗？"}, {"type": "subtitle", "time": 19936.91, "timestamp": "05:32:16", "text": "还有吗？它不起作用吗？"}, {"type": "subtitle", "time": 19939.23, "timestamp": "05:32:19", "text": "还有吗？和"}, {"type": "subtitle", "time": 19946.31, "timestamp": "05:32:26", "text": "人人都有卫生巾。人人头颅。"}, {"type": "subtitle", "time": 19949.868, "timestamp": "05:32:29", "text": "糟了，不行。哦，确实如此。"}, {"type": "subtitle", "time": 19952.43, "timestamp": "05:32:32", "text": "工作。你好。"}, {"type": "subtitle", "time": 19963.31, "timestamp": "05:32:43", "text": "你好。你好吗？我正在做"}, {"type": "subtitle", "time": 19966.708, "timestamp": "05:32:46", "text": "好的。我很好。谢谢你"}, {"type": "subtitle", "time": 19969.788, "timestamp": "05:32:49", "text": "问。你好吗？怎样"}, {"type": "subtitle", "time": 19972.548, "timestamp": "05:32:52", "text": "你？哦，是的。我忘了问这个问题。"}, {"type": "subtitle", "time": 19974.788, "timestamp": "05:32:54", "text": "大家最近怎么样？天哪，我忘了"}, {"type": "subtitle", "time": 19976.788, "timestamp": "05:32:56", "text": "问这个问题。本来应该是我的"}, {"type": "subtitle", "time": 19979.99, "timestamp": "05:32:59", "text": "我首先应该问什么？你的意思是说我"}]
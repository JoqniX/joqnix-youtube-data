[{"type": "subtitle", "time": 15600.03, "timestamp": "04:20:00", "text": "比如没有跟进。"}, {"type": "subtitle", "time": 15604.429, "timestamp": "04:20:04", "text": "或者它是什么？我该怎么说呢？"}, {"type": "subtitle", "time": 15607.429, "timestamp": "04:20:07", "text": "嗯，我该怎么说呢？更像是繁衍后代"}, {"type": "subtitle", "time": 15611.03, "timestamp": "04:20:11", "text": "我的信任或者我付出的任何努力"}, {"type": "subtitle", "time": 15613.99, "timestamp": "04:20:13", "text": "把消息反馈给人们。"}, {"type": "subtitle", "time": 15616.99, "timestamp": "04:20:16", "text": "是的，确实有事发生。"}, {"type": "subtitle", "time": 15619.55, "timestamp": "04:20:19", "text": "我担心你"}, {"type": "subtitle", "time": 15622.269, "timestamp": "04:20:22", "text": "我知道很难保持联系"}, {"type": "subtitle", "time": 15624.87, "timestamp": "04:20:24", "text": "每个人，即使有人我"}, {"type": "subtitle", "time": 15627.67, "timestamp": "04:20:27", "text": "一直保持联系，现在也还在保持联系。"}, {"type": "subtitle", "time": 15631.189, "timestamp": "04:20:31", "text": "你永远不知道他们现在会不会离开。"}, {"type": "subtitle", "time": 15632.99, "timestamp": "04:20:32", "text": "那确实如此。"}, {"type": "subtitle", "time": 15637.03, "timestamp": "04:20:37", "text": "对于一个敏感的人来说，这确实会造成很大的打击。"}, {"type": "subtitle", "time": 15640.309, "timestamp": "04:20:40", "text": "我非常深"}, {"type": "subtitle", "time": 15642.91, "timestamp": "04:20:42", "text": "呃，这真的让我很受打击。"}, {"type": "subtitle", "time": 15651.149, "timestamp": "04:20:51", "text": "就像会说，“是啊，他们不再是了。”"}]
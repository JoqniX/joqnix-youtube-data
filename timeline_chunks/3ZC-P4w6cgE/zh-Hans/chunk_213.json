[{"type": "subtitle", "time": 12782.309, "timestamp": "03:33:02", "text": "等等，这是什么意思？好的，所以这个"}, {"type": "subtitle", "time": 12785.51, "timestamp": "03:33:05", "text": "比如，当开始下雨的时候，"}, {"type": "subtitle", "time": 12788.79, "timestamp": "03:33:08", "text": "云朵开始变红，或者天空"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "天空开始变红，或者你看到血"}, {"type": "subtitle", "time": 12795.51, "timestamp": "03:33:15", "text": "下雨，躲在任何障碍物下"}, {"type": "subtitle", "time": 12797.67, "timestamp": "03:33:17", "text": "就像躲在它下面一样。你应该有一个"}, {"type": "subtitle", "time": 12800.59, "timestamp": "03:33:20", "text": "屋顶压在你头上。"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "哦好的。还有另一个。我希望我"}, {"type": "subtitle", "time": 12806.309, "timestamp": "03:33:26", "text": "可以给你。哦，有一个。"}, {"type": "subtitle", "time": 12808.03, "timestamp": "03:33:28", "text": "呃"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "是的。这样行不行？"}, {"type": "subtitle", "time": 12813.75, "timestamp": "03:33:33", "text": "这就像……这就像红灯一样"}, {"type": "subtitle", "time": 12815.75, "timestamp": "03:33:35", "text": "绿灯。但是，呃，当你看到"}, {"type": "subtitle", "time": 12818.309, "timestamp": "03:33:38", "text": "笑脸，蹲下，不要动"}, {"type": "subtitle", "time": 12820.389, "timestamp": "03:33:40", "text": "直到它或许能让他睁开双眼。那是"}, {"type": "subtitle", "time": 12822.63, "timestamp": "03:33:42", "text": "只有当那笑容消失之后，"}, {"type": "subtitle", "time": 12825.19, "timestamp": "03:33:45", "text": "那时你就可以行动了。"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "哦。"}, {"type": "subtitle", "time": 12828.71, "timestamp": "03:33:48", "text": "嗯。就在你看到笑容的那一刻"}, {"type": "subtitle", "time": 12831.91, "timestamp": "03:33:51", "text": "脸朝下，蹲下别动。"}]
[{"type": "subtitle", "time": 4561.35, "timestamp": "01:16:01", "text": "经过。还有，乔，求你造点雪吧。"}, {"type": "subtitle", "time": 4564.47, "timestamp": "01:16:04", "text": "我终于可以触摸和感受雪了。"}, {"type": "subtitle", "time": 4567.59, "timestamp": "01:16:07", "text": "还会用雪砸你。"}, {"type": "subtitle", "time": 4571.39, "timestamp": "01:16:11", "text": "或者为你堆个雪人"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "今天来这里有东西。希望你"}, {"type": "subtitle", "time": 4576.11, "timestamp": "01:16:16", "text": "玩得很开心"}, {"type": "subtitle", "time": 4579.39, "timestamp": "01:16:19", "text": "现在。也祝你圣诞快乐！"}, {"type": "subtitle", "time": 4583.03, "timestamp": "01:16:23", "text": "出色地。今天桑托来了。阿迪加托"}, {"type": "subtitle", "time": 4585.669, "timestamp": "01:16:25", "text": "感谢桑托今天光临，祝他快乐"}, {"type": "subtitle", "time": 4587.43, "timestamp": "01:16:27", "text": "也祝你圣诞快乐。谢谢。"}, {"type": "subtitle", "time": 4589.83, "timestamp": "01:16:29", "text": "谢谢你告诉我所有好消息"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "那件事到底是怎么发生的？你身上发生了什么事？"}, {"type": "subtitle", "time": 4594.55, "timestamp": "01:16:34", "text": "也祝你生日快乐。虽然如此"}, {"type": "subtitle", "time": 4597.75, "timestamp": "01:16:37", "text": "虽然是24号，但迟来的等待也让我感到开心。"}, {"type": "subtitle", "time": 4601.35, "timestamp": "01:16:41", "text": "再次祝你生日快乐，感谢你"}, {"type": "subtitle", "time": 4604.31, "timestamp": "01:16:44", "text": "今天过来。希望你一切顺利"}, {"type": "subtitle", "time": 4609.07, "timestamp": "01:16:49", "text": "祝你圣诞快乐，好极了！"}, {"type": "subtitle", "time": 4610.99, "timestamp": "01:16:50", "text": "又是一个"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "欢迎大家来逛逛，找到我的"}]
[{"type": "subtitle", "time": 4923.189, "timestamp": "01:22:03", "text": "然后，呃，所以雷米就被留下了。"}, {"type": "subtitle", "time": 4928.39, "timestamp": "01:22:08", "text": "当时，我们实际上赢了那场比赛12分。"}, {"type": "subtitle", "time": 4930.11, "timestamp": "01:22:10", "text": "嗯，呃"}, {"type": "subtitle", "time": 4932.59, "timestamp": "01:22:12", "text": "1312. 不，不，"}, {"type": "subtitle", "time": 4935.03, "timestamp": "01:22:15", "text": "1212年左右。对，就是那时。"}, {"type": "subtitle", "time": 4938.95, "timestamp": "01:22:18", "text": "匹配。不，不，就像是……呃，最后一次"}, {"type": "subtitle", "time": 4941.99, "timestamp": "01:22:21", "text": "就是那个东西，对吧？呃，它叫什么？"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "是的，当你达到同样的程度时"}, {"type": "subtitle", "time": 4946.87, "timestamp": "01:22:26", "text": "事物。是的。所以，我们赢了那场比赛。"}, {"type": "subtitle", "time": 4950.03, "timestamp": "01:22:30", "text": "不知怎么的。我不知道怎么做，但是"}, {"type": "subtitle", "time": 4953.27, "timestamp": "01:22:33", "text": "是的。而且，我还因为雷米的到来而得到了她。"}, {"type": "subtitle", "time": 4955.75, "timestamp": "01:22:35", "text": "祝远方的你圣诞快乐。希望你"}, {"type": "subtitle", "time": 4956.669, "timestamp": "01:22:36", "text": "享受"}, {"type": "subtitle", "time": 4959.55, "timestamp": "01:22:39", "text": "祝您今天一切顺利，圣诞快乐！"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "再次。今天，爱德华来了。"}, {"type": "subtitle", "time": 4967.51, "timestamp": "01:22:47", "text": "感谢爱德华的光临。希望你"}, {"type": "subtitle", "time": 4970.39, "timestamp": "01:22:50", "text": "今天过得很愉快。谢谢你一直以来"}, {"type": "subtitle", "time": 4973.07, "timestamp": "01:22:53", "text": "观看并身临其境"}]
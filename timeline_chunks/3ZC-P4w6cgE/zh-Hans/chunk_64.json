[{"type": "subtitle", "time": 3841.109, "timestamp": "01:04:01", "text": "死的。好了，我快完成了。"}, {"type": "subtitle", "time": 3844.39, "timestamp": "01:04:04", "text": "游戏。所以，是的，一旦我达到这个目标，"}, {"type": "subtitle", "time": 3846.71, "timestamp": "01:04:06", "text": "我不想停下来，但是"}, {"type": "subtitle", "time": 3848.63, "timestamp": "01:04:08", "text": "我不会经常玩这个游戏。"}, {"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "我所需要的只是因为我买了"}, {"type": "subtitle", "time": 3854.23, "timestamp": "01:04:14", "text": "战斗巴士。我只会把它完成。"}, {"type": "subtitle", "time": 3855.349, "timestamp": "01:04:15", "text": "直到那时。是的。然后我"}, {"type": "subtitle", "time": 3857.19, "timestamp": "01:04:17", "text": "完毕。"}, {"type": "subtitle", "time": 3859.43, "timestamp": "01:04:19", "text": "如果我只收到这个，没关系。"}, {"type": "subtitle", "time": 3866.91, "timestamp": "01:04:26", "text": "这里。海豹。等等，什么？什么是"}, {"type": "subtitle", "time": 3869.71, "timestamp": "01:04:29", "text": "那？唇"}, {"type": "subtitle", "time": 3872.19, "timestamp": "01:04:32", "text": "海豹。眼睛"}, {"type": "subtitle", "time": 3876.27, "timestamp": "01:04:36", "text": "出去。小心。这是什么？"}, {"type": "subtitle", "time": 3878.67, "timestamp": "01:04:38", "text": "塞莱斯蒂亚"}, {"type": "subtitle", "time": 3881.309, "timestamp": "01:04:41", "text": "和"}, {"type": "subtitle", "time": 3883.789, "timestamp": "01:04:43", "text": "我觉得我很多"}, {"type": "subtitle", "time": 3892.91, "timestamp": "01:04:52", "text": "时间更长了，但我有点"}, {"type": "subtitle", "time": 3898.069, "timestamp": "01:04:58", "text": "害怕熬夜太久。我"}]
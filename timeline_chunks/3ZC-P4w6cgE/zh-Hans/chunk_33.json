[{"type": "subtitle", "time": 1980.029, "timestamp": "00:33:00", "text": "圣诞节。欢乐"}, {"type": "subtitle", "time": 1982.509, "timestamp": "00:33:02", "text": "圣诞节。停留"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "球星。哦，你只是在旁观看而已。我"}, {"type": "subtitle", "time": 1992.47, "timestamp": "00:33:12", "text": "不知道。圣诞快乐。怎样"}, {"type": "subtitle", "time": 1994.269, "timestamp": "00:33:14", "text": "你？你过得怎么样？"}, {"type": "subtitle", "time": 1997.59, "timestamp": "00:33:17", "text": "溪流？我想加入，但我转念一想……"}, {"type": "subtitle", "time": 2000.47, "timestamp": "00:33:20", "text": "呃，可以吗？我不知道。我当时"}, {"type": "subtitle", "time": 2003.83, "timestamp": "00:33:23", "text": "就那样闲聊吧。"}, {"type": "subtitle", "time": 2007.149, "timestamp": "00:33:27", "text": "那段时间。所以我想"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "好的，我会的，不过你已经完成了。"}, {"type": "subtitle", "time": 2012.75, "timestamp": "00:33:32", "text": "所以它是流媒体。"}, {"type": "subtitle", "time": 2014.99, "timestamp": "00:33:34", "text": "美好的。希望你一切顺利"}, {"type": "subtitle", "time": 2022.149, "timestamp": "00:33:42", "text": "瞧瞧我。等等，我正在抚摸它。"}]
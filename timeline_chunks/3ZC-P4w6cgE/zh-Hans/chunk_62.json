[{"type": "subtitle", "time": 3722.309, "timestamp": "01:02:02", "text": "重新装弹。"}, {"type": "subtitle", "time": 3732.95, "timestamp": "01:02:12", "text": "水？那个冲刺的人是谁？是"}, {"type": "subtitle", "time": 3741.03, "timestamp": "01:02:21", "text": "已种下穗。"}, {"type": "subtitle", "time": 3752.71, "timestamp": "01:02:32", "text": "未来。他来了。"}, {"type": "subtitle", "time": 3754.63, "timestamp": "01:02:34", "text": "手榴弹。"}, {"type": "subtitle", "time": 3761.52, "timestamp": "01:02:41", "text": "请给我一份。"}, {"type": "subtitle", "time": 3763.349, "timestamp": "01:02:43", "text": "[掌声]"}, {"type": "subtitle", "time": 3765.91, "timestamp": "01:02:45", "text": "不，别写我，我会带"}, {"type": "subtitle", "time": 3778.47, "timestamp": "01:02:58", "text": "还剩一个敌人。他正在打开他的"}]
[{"type": "subtitle", "time": 11899.91, "timestamp": "03:18:19", "text": "75. 好的。这是追逐戏。我"}, {"type": "subtitle", "time": 11902.469, "timestamp": "03:18:22", "text": "我觉得这一幕可能会让我达到100分。"}, {"type": "subtitle", "time": 11905.11, "timestamp": "03:18:25", "text": "我不知道。"}, {"type": "subtitle", "time": 11907.269, "timestamp": "03:18:27", "text": "大概80岁。"}, {"type": "subtitle", "time": 11937.71, "timestamp": "03:18:57", "text": "糟糕。我分不清哪扇门是哪扇门。"}, {"type": "subtitle", "time": 11939.95, "timestamp": "03:18:59", "text": "80. 说"}]
[{"type": "subtitle", "time": 14462.71, "timestamp": "04:01:02", "text": "IM Iman 的链接在……"}, {"type": "subtitle", "time": 14464.389, "timestamp": "04:01:04", "text": "描述以及别针"}, {"type": "subtitle", "time": 14468.51, "timestamp": "04:01:08", "text": "评论。嗯，是的，他在推特上。"}, {"type": "subtitle", "time": 14471.95, "timestamp": "04:01:11", "text": "他还有Instagram账号，以及一个YouTube账号。"}, {"type": "subtitle", "time": 14476.03, "timestamp": "04:01:16", "text": "还有 Twitch。他在 Twitch 上的直播。"}, {"type": "subtitle", "time": 14479.55, "timestamp": "04:01:19", "text": "你好。我确信今天真的"}, {"type": "subtitle", "time": 14483.269, "timestamp": "04:01:23", "text": "乐趣。那么，下一个就是……"}, {"type": "subtitle", "time": 14486.71, "timestamp": "04:01:26", "text": "今天的下一个合作对象是Vic。"}, {"type": "subtitle", "time": 14488.11, "timestamp": "04:01:28", "text": "日本动画片"}, {"type": "subtitle", "time": 14491.269, "timestamp": "04:01:31", "text": "哭泣。呃，所以，Vick Chama 将会是"}, {"type": "subtitle", "time": 14494.15, "timestamp": "04:01:34", "text": "与他一起作为第二部分"}, {"type": "subtitle", "time": 14497.03, "timestamp": "04:01:37", "text": "我直播的流。显然呃"}, {"type": "subtitle", "time": 14500.309, "timestamp": "04:01:40", "text": "对维克来说，他正在经历一种力量"}, {"type": "subtitle", "time": 14502.83, "timestamp": "04:01:42", "text": "切。"}, {"type": "subtitle", "time": 14505.67, "timestamp": "04:01:45", "text": "嗯，是的，我们会推迟这件事。"}, {"type": "subtitle", "time": 14508.95, "timestamp": "04:01:48", "text": "今天。不用担心。一切都好。这"}, {"type": "subtitle", "time": 14512.429, "timestamp": "04:01:52", "text": "经历停电"}, {"type": "subtitle", "time": 14515.03, "timestamp": "04:01:55", "text": "发生了。所以当它回来的时候，我们会"}, {"type": "subtitle", "time": 14518.67, "timestamp": "04:01:58", "text": "我们一起出去玩什么的。"}]
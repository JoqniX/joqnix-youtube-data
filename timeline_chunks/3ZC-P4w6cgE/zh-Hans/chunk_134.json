[{"type": "subtitle", "time": 8041.43, "timestamp": "02:14:01", "text": "和别人交谈等等。"}, {"type": "subtitle", "time": 8044.709, "timestamp": "02:14:04", "text": "是的。是的，那个，我的意思是，不，我可以"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "把它看作是一段漫长的间歇期吧。"}, {"type": "subtitle", "time": 8049.27, "timestamp": "02:14:09", "text": "就像不久之后的几场最后的直播一样"}, {"type": "subtitle", "time": 8053.03, "timestamp": "02:14:13", "text": "休息一段时间，然后重新开始，推出一款新游戏。"}, {"type": "subtitle", "time": 8055.589, "timestamp": "02:14:15", "text": "呃，可能是设计方面。我什么都不知道。"}, {"type": "subtitle", "time": 8057.109, "timestamp": "02:14:17", "text": "新的"}, {"type": "subtitle", "time": 8059.229, "timestamp": "02:14:19", "text": "是的。所以，"}, {"type": "subtitle", "time": 8063.109, "timestamp": "02:14:23", "text": "我会没事的，但不知道会怎么样。"}, {"type": "subtitle", "time": 8065.31, "timestamp": "02:14:25", "text": "我想我得从……那里拿回笔记本电脑"}, {"type": "subtitle", "time": 8068.95, "timestamp": "02:14:28", "text": "那里。我得先买下来才能看。"}, {"type": "subtitle", "time": 8072.069, "timestamp": "02:14:32", "text": "自从我听说这种情况以来，情况就是这样。"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "我不能，呃，有很多他们"}, {"type": "subtitle", "time": 8077.91, "timestamp": "02:14:37", "text": "就像那些继续前进的学生一样。"}, {"type": "subtitle", "time": 8080.39, "timestamp": "02:14:40", "text": "他们说四月份的招生工作他们甚至都无法完成。"}, {"type": "subtitle", "time": 8082.95, "timestamp": "02:14:42", "text": "打电话，呃，用他们的电话，比如打电话"}, {"type": "subtitle", "time": 8085.43, "timestamp": "02:14:45", "text": "因为噪音，他们的家人都离开了房间。"}, {"type": "subtitle", "time": 8087.51, "timestamp": "02:14:47", "text": "抱怨简直荒谬，诸如此类的事情"}, {"type": "subtitle", "time": 8090.99, "timestamp": "02:14:50", "text": "其他房间等等。我的天哪。哦"}, {"type": "subtitle", "time": 8095.47, "timestamp": "02:14:55", "text": "不。房间好小。哦"}, {"type": "subtitle", "time": 8097.87, "timestamp": "02:14:57", "text": "是的。所以我就想"}]
[{"type": "subtitle", "time": 13800.87, "timestamp": "03:50:00", "text": "去。"}, {"type": "subtitle", "time": 13812.63, "timestamp": "03:50:12", "text": "好的。好的。离开他的视线范围"}, {"type": "subtitle", "time": 13813.83, "timestamp": "03:50:13", "text": "视力。躲到门后。落后"}, {"type": "subtitle", "time": 13817.67, "timestamp": "03:50:17", "text": "门。妈的。拉屎。好的。所以，就像"}, {"type": "subtitle", "time": 13819.75, "timestamp": "03:50:19", "text": "好的。让我……你可以旁观。"}, {"type": "subtitle", "time": 13821.189, "timestamp": "03:50:21", "text": "我。呃，你什么时候告诉我？"}, {"type": "subtitle", "time": 13823.8, "timestamp": "03:50:23", "text": "旁观我。"}, {"type": "subtitle", "time": 13825.91, "timestamp": "03:50:25", "text": "[音乐]"}, {"type": "subtitle", "time": 13829.75, "timestamp": "03:50:29", "text": "是的。好的。好的。所以，嗯，当他"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "站在这里，跑回去躲起来"}, {"type": "subtitle", "time": 13834.95, "timestamp": "03:50:34", "text": "这里。"}, {"type": "subtitle", "time": 13837.189, "timestamp": "03:50:37", "text": "啊，就像，这就像一个障碍物。"}, {"type": "subtitle", "time": 13855.83, "timestamp": "03:50:55", "text": "[音乐]"}]
[{"type": "subtitle", "time": 5949.59, "timestamp": "01:39:09", "text": "分钟。好的。没关系。我只是"}, {"type": "subtitle", "time": 5952.47, "timestamp": "01:39:12", "text": "当时我意识到我不应该知道这件事。"}, {"type": "subtitle", "time": 5955.189, "timestamp": "01:39:15", "text": "那么，这就好比一个问题："}, {"type": "subtitle", "time": 5958.07, "timestamp": "01:39:18", "text": "心想：等等，这神秘的手是谁？"}, {"type": "subtitle", "time": 5959.47, "timestamp": "01:39:19", "text": "那不是骑师"}, {"type": "subtitle", "time": 5962.27, "timestamp": "01:39:22", "text": "不是运动员的那种人"}, {"type": "subtitle", "time": 5964.43, "timestamp": "01:39:24", "text": "手"}, {"type": "subtitle", "time": 5967.51, "timestamp": "01:39:27", "text": "哦，我心想，没错，那是我的手，但是……"}, {"type": "subtitle", "time": 5972.109, "timestamp": "01:39:32", "text": "把我的手命名为 ho chama，所以不要"}, {"type": "subtitle", "time": 5975.59, "timestamp": "01:39:35", "text": "担心，就像我给我起名字的方式一样"}, {"type": "subtitle", "time": 5979.75, "timestamp": "01:39:39", "text": "致我的鼠标 chama monama 键盘。妈妈"}, {"type": "subtitle", "time": 5983.59, "timestamp": "01:39:43", "text": "照片，我的什么？我的枕头。一切"}, {"type": "subtitle", "time": 5995.31, "timestamp": "01:39:55", "text": "上帝。哦"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "上帝。是的。你就这么想吧。"}]
[{"type": "subtitle", "time": 7802.31, "timestamp": "02:10:02", "text": "西班牙语、波兰语、法语。"}, {"type": "subtitle", "time": 7806.55, "timestamp": "02:10:06", "text": "哇。是的。太酷了！"}, {"type": "subtitle", "time": 7808.709, "timestamp": "02:10:08", "text": "是的。"}, {"type": "subtitle", "time": 7810.95, "timestamp": "02:10:10", "text": "我们很有创意。是的。是的。是的。真的，"}, {"type": "subtitle", "time": 7815.589, "timestamp": "02:10:15", "text": "没错，没错。独创性。是的。嗯。还，"}, {"type": "subtitle", "time": 7818.47, "timestamp": "02:10:18", "text": "今天过得怎么样？你好吗？如何"}, {"type": "subtitle", "time": 7820.47, "timestamp": "02:10:20", "text": "你去过吗？"}, {"type": "subtitle", "time": 7825.189, "timestamp": "02:10:25", "text": "我没事。就像我磨练漫画技艺一样"}, {"type": "subtitle", "time": 7827.669, "timestamp": "02:10:27", "text": "慢得要死。我不喜欢那样。我"}, {"type": "subtitle", "time": 7831.03, "timestamp": "02:10:31", "text": "我大概有7个吧。"}, {"type": "subtitle", "time": 7835.35, "timestamp": "02:10:35", "text": "还有几个月，这也不算太糟。7"}, {"type": "subtitle", "time": 7837.91, "timestamp": "02:10:37", "text": "月，但就像计算多少"}, {"type": "subtitle", "time": 7839.99, "timestamp": "02:10:39", "text": "我还没仔细考虑过的章节"}, {"type": "subtitle", "time": 7842.39, "timestamp": "02:10:42", "text": "前进的章节 前面的章节"}, {"type": "subtitle", "time": 7844.31, "timestamp": "02:10:44", "text": "我感觉自己好像真的不知道发生了什么。"}, {"type": "subtitle", "time": 7846.39, "timestamp": "02:10:46", "text": "将在主要部分中间发生"}, {"type": "subtitle", "time": 7848.87, "timestamp": "02:10:48", "text": "故事的一部分。所以，就像可以这样"}, {"type": "subtitle", "time": 7853.03, "timestamp": "02:10:53", "text": "虽然压力很大或者令人担忧，但我会"}, {"type": "subtitle", "time": 7855.43, "timestamp": "02:10:55", "text": "看看事情会如何发展，希望如此。"}, {"type": "subtitle", "time": 7858.709, "timestamp": "02:10:58", "text": "2025 年前完成，这是初稿。"}]
[{"type": "subtitle", "time": 4080.19, "timestamp": "01:08:00", "text": "或三个满"}, {"type": "subtitle", "time": 4084.39, "timestamp": "01:08:04", "text": "流。我在想是不是 Oka 或"}, {"type": "subtitle", "time": 4086.109, "timestamp": "01:08:06", "text": "如果是的话"}, {"type": "subtitle", "time": 4088.87, "timestamp": "01:08:08", "text": "通常情况下，你知道我就像"}, {"type": "subtitle", "time": 4090.71, "timestamp": "01:08:10", "text": "玩多种不同类型的游戏，"}, {"type": "subtitle", "time": 4094.43, "timestamp": "01:08:14", "text": "正确的？我们每天都会尝试不同的组合。"}, {"type": "subtitle", "time": 4097.189, "timestamp": "01:08:17", "text": "溪流。是的，所以我在想……"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "稍微改变一下"}, {"type": "subtitle", "time": 4103.03, "timestamp": "01:08:23", "text": "本星期。本周指的是下周"}, {"type": "subtitle", "time": 4105.669, "timestamp": "01:08:25", "text": "呃，25号。接下来，呃，这是下周。"}, {"type": "subtitle", "time": 4109.03, "timestamp": "01:08:29", "text": "是的，对我来说，星期天是新的一天的开始。"}, {"type": "subtitle", "time": 4110.669, "timestamp": "01:08:30", "text": "新的一周开始了。但"}, {"type": "subtitle", "time": 4113.91, "timestamp": "01:08:33", "text": "是的，所以，呃，我当时在想……"}, {"type": "subtitle", "time": 4116.269, "timestamp": "01:08:36", "text": "玩"}, {"type": "subtitle", "time": 4118.51, "timestamp": "01:08:38", "text": "Valerant 三个"}, {"type": "subtitle", "time": 4120.87, "timestamp": "01:08:40", "text": "流。这样是不是太过分了？我"}, {"type": "subtitle", "time": 4122.95, "timestamp": "01:08:42", "text": "不知道。不，这算作一个"}, {"type": "subtitle", "time": 4125.11, "timestamp": "01:08:45", "text": "Valerant直播。是的，"}, {"type": "subtitle", "time": 4127.269, "timestamp": "01:08:47", "text": "直播，即使它的标题是“Just”。"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "聊天和圣诞快乐，直播"}, {"type": "subtitle", "time": 4132.55, "timestamp": "01:08:52", "text": "将添加到 Valerin 播放列表中"}, {"type": "subtitle", "time": 4136.47, "timestamp": "01:08:56", "text": "第九次瓦莱林直播，因为我们玩了"}, {"type": "subtitle", "time": 4138.709, "timestamp": "01:08:58", "text": "Valerant 大概玩了 2 个小时还是 1 个小时？"}]
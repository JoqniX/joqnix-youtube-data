[{"type": "subtitle", "time": 19803.708, "timestamp": "05:30:03", "text": "就像猫的一切一样。"}, {"type": "subtitle", "time": 19808.11, "timestamp": "05:30:08", "text": "东西。所以我想知道我"}, {"type": "subtitle", "time": 19809.788, "timestamp": "05:30:09", "text": "移植。"}, {"type": "subtitle", "time": 19814.628, "timestamp": "05:30:14", "text": "不，不，不，不，不。因为你知道"}, {"type": "subtitle", "time": 19817.948, "timestamp": "05:30:17", "text": "在加入的同时，通过我的"}, {"type": "subtitle", "time": 19821.99, "timestamp": "05:30:21", "text": "旅程，我，嗯，我称之为，呃，就像什么"}, {"type": "subtitle", "time": 19824.39, "timestamp": "05:30:24", "text": "你管它叫什么？它叫什么？呃"}, {"type": "subtitle", "time": 19826.31, "timestamp": "05:30:26", "text": "有什么东西。它叫什么名字？"}, {"type": "subtitle", "time": 19829.35, "timestamp": "05:30:29", "text": "这？有些人能理解这一点"}, {"type": "subtitle", "time": 19830.868, "timestamp": "05:30:30", "text": "不同的眼睛颜色。它的名字是什么？"}, {"type": "subtitle", "time": 19834.11, "timestamp": "05:30:34", "text": "它？我真是个笨蛋。啊，来了"}, {"type": "subtitle", "time": 19837.15, "timestamp": "05:30:37", "text": "在。是啊，我忘了。"}, {"type": "subtitle", "time": 19841.83, "timestamp": "05:30:41", "text": "那。记住，我曾经是明星。哦，我"}, {"type": "subtitle", "time": 19844.67, "timestamp": "05:30:44", "text": "我不是跟你说过吗？"}, {"type": "subtitle", "time": 19847.708, "timestamp": "05:30:47", "text": "哦，被遗忘了"}, {"type": "subtitle", "time": 19851.868, "timestamp": "05:30:51", "text": "他们。你好。所以，当我"}, {"type": "subtitle", "time": 19854.19, "timestamp": "05:30:54", "text": "重生。当我还是"}]
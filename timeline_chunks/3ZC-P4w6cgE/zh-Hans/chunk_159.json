[{"type": "subtitle", "time": 9540.469, "timestamp": "02:39:00", "text": "哦。哦，等等。等待。谁说的？"}, {"type": "subtitle", "time": 9542.71, "timestamp": "02:39:02", "text": "所以，这是躲猫猫游戏，对吧？尿"}, {"type": "subtitle", "time": 9547.91, "timestamp": "02:39:07", "text": "东西。是的。嗯哼。所以，你哦，是"}, {"type": "subtitle", "time": 9550.71, "timestamp": "02:39:10", "text": "这边。哦，是的。是的，它在这里。"}, {"type": "subtitle", "time": 9554.23, "timestamp": "02:39:14", "text": "所以，你看看。将在……"}, {"type": "subtitle", "time": 9556.95, "timestamp": "02:39:16", "text": "他其实就在你脚下。你"}, {"type": "subtitle", "time": 9559.67, "timestamp": "02:39:19", "text": "看看它，你就知道该怎么安置了。"}, {"type": "subtitle", "time": 9562.71, "timestamp": "02:39:22", "text": "它躲开了"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "比如，因为我觉得当我"}, {"type": "subtitle", "time": 9566.469, "timestamp": "02:39:26", "text": "我回头望去，抬头望去，我看到"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "他比我高。所以我觉得是这样。"}, {"type": "subtitle", "time": 9574.91, "timestamp": "02:39:34", "text": "你只需要提前发现他。"}, {"type": "subtitle", "time": 9579.11, "timestamp": "02:39:39", "text": "呃，在他找到你之前。"}, {"type": "subtitle", "time": 9594.23, "timestamp": "02:39:54", "text": "哦，该死。呃，"}, {"type": "subtitle", "time": 9598.63, "timestamp": "02:39:58", "text": "拉屎。发生了什么？ 23 和 24。好的。 20"}]
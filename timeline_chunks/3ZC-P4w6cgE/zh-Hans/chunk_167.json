[{"type": "subtitle", "time": 10021.349, "timestamp": "02:47:01", "text": "天色阴沉，天空只有一次。当它是"}, {"type": "subtitle", "time": 10023.67, "timestamp": "02:47:03", "text": "亮白色和绿色。所以，多个"}, {"type": "subtitle", "time": 10026.51, "timestamp": "02:47:06", "text": "见过好几次了。"}, {"type": "subtitle", "time": 10031.67, "timestamp": "02:47:11", "text": "哦，我也遇到过一个喜欢躲猫猫的家伙。"}, {"type": "subtitle", "time": 10044.95, "timestamp": "02:47:24", "text": "是的。哦，是的。我也听说了。"}, {"type": "subtitle", "time": 10047.59, "timestamp": "02:47:27", "text": "剧集，但我认为他会在……出现"}, {"type": "subtitle", "time": 10049.59, "timestamp": "02:47:29", "text": "你被蒙在鼓里太久了。地狱"}, {"type": "subtitle", "time": 10051.91, "timestamp": "02:47:31", "text": "开始显化。"}, {"type": "subtitle", "time": 10060.15, "timestamp": "02:47:40", "text": "他妈的。我需要手电筒。"}, {"type": "subtitle", "time": 10079.469, "timestamp": "02:47:59", "text": "全部"}]
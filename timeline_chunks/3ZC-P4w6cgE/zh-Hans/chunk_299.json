[{"type": "subtitle", "time": 17940.19, "timestamp": "04:59:00", "text": "很多时候都不休息，是的。"}, {"type": "subtitle", "time": 17943.35, "timestamp": "04:59:03", "text": "是的。所有人都记得那些"}, {"type": "subtitle", "time": 17947.11, "timestamp": "04:59:07", "text": "呃，长时间的直播之类的。"}, {"type": "subtitle", "time": 17948.91, "timestamp": "04:59:08", "text": "是的。"}, {"type": "subtitle", "time": 17955.15, "timestamp": "04:59:15", "text": "你好。所以，嗯，所有的努力，呃，就像所有"}, {"type": "subtitle", "time": 17959.91, "timestamp": "04:59:19", "text": "努力工作一切"}, {"type": "subtitle", "time": 17962.948, "timestamp": "04:59:22", "text": "嗯，是啊，我知道我做不到。"}, {"type": "subtitle", "time": 17965.99, "timestamp": "04:59:25", "text": "独自一人，因为我一直都依靠自己。"}, {"type": "subtitle", "time": 17969.27, "timestamp": "04:59:29", "text": "一切都是我自己做的。"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "我想做所有与艺术相关的事情。"}, {"type": "subtitle", "time": 17973.47, "timestamp": "04:59:33", "text": "设计"}, {"type": "subtitle", "time": 17977.31, "timestamp": "04:59:37", "text": "包括所有的一切，甚至包括3D部分。"}, {"type": "subtitle", "time": 17979.67, "timestamp": "04:59:39", "text": "我计划的其他事情"}, {"type": "subtitle", "time": 17982.59, "timestamp": "04:59:42", "text": "未来，但我一个人做不到，你"}, {"type": "subtitle", "time": 17987.67, "timestamp": "04:59:47", "text": "我知道我一个人做不到这一切，而且"}, {"type": "subtitle", "time": 17990.27, "timestamp": "04:59:50", "text": "我当时非常沮丧，"}, {"type": "subtitle", "time": 17991.948, "timestamp": "04:59:51", "text": "东西"}, {"type": "subtitle", "time": 17999.75, "timestamp": "04:59:59", "text": "但我是在服役期间认识你们所有人的。那是"}]
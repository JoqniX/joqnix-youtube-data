[{"type": "subtitle", "time": 18660.27, "timestamp": "05:11:00", "text": "你好。你们大多数人都知道她是一位"}, {"type": "subtitle", "time": 18670.628, "timestamp": "05:11:10", "text": "嗯，她帮了我。"}, {"type": "subtitle", "time": 18674.15, "timestamp": "05:11:14", "text": "嗯，她帮我设计了一个方案。她画"}, {"type": "subtitle", "time": 18676.35, "timestamp": "05:11:16", "text": "这幅画是为我画的。"}, {"type": "subtitle", "time": 18680.07, "timestamp": "05:11:20", "text": "实际上。因为我当时就觉得，呃，我当时"}, {"type": "subtitle", "time": 18682.628, "timestamp": "05:11:22", "text": "我对所需的设计感到非常沮丧"}, {"type": "subtitle", "time": 18685.91, "timestamp": "05:11:25", "text": "比如我想要的所有具体内容"}, {"type": "subtitle", "time": 18688.948, "timestamp": "05:11:28", "text": "等等。我当时真是又担心又困惑。"}, {"type": "subtitle", "time": 18691.51, "timestamp": "05:11:31", "text": "怎么办，怎么办。还没真正……"}, {"type": "subtitle", "time": 18693.708, "timestamp": "05:11:33", "text": "想过这件事之类的，"}, {"type": "subtitle", "time": 18696.868, "timestamp": "05:11:36", "text": "但我给自己留了些时间。而且她"}, {"type": "subtitle", "time": 18698.35, "timestamp": "05:11:38", "text": "确实帮了我一个忙"}, {"type": "subtitle", "time": 18701.99, "timestamp": "05:11:41", "text": "很多。她确实帮了我很多。我的意思是，她"}, {"type": "subtitle", "time": 18706.07, "timestamp": "05:11:46", "text": "确实帮了我很多，比如"}, {"type": "subtitle", "time": 18708.31, "timestamp": "05:11:48", "text": "呃，比如帮我想出一个"}, {"type": "subtitle", "time": 18712.47, "timestamp": "05:11:52", "text": "我喜欢这个设计。她真是太好了"}, {"type": "subtitle", "time": 18716.628, "timestamp": "05:11:56", "text": "甜到极致。"}, {"type": "subtitle", "time": 18718.43, "timestamp": "05:11:58", "text": "帮我……"}]
[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "和动漫角色维克一起玩耍。"}, {"type": "subtitle", "time": 7504.87, "timestamp": "02:05:04", "text": "他一直是我的好朋友，我"}, {"type": "subtitle", "time": 7508.87, "timestamp": "02:05:08", "text": "想把他们两个都弄到手，伊曼"}, {"type": "subtitle", "time": 7511.03, "timestamp": "02:05:11", "text": "以及Animebec"}, {"type": "subtitle", "time": 7513.669, "timestamp": "02:05:13", "text": "嗯，上来，好好享受这段时光吧。"}, {"type": "subtitle", "time": 7516.79, "timestamp": "02:05:16", "text": "今天。是的，我们会到场的。"}, {"type": "subtitle", "time": 7520.629, "timestamp": "02:05:20", "text": "大概最多一个小时吧，因为他……"}, {"type": "subtitle", "time": 7523.03, "timestamp": "02:05:23", "text": "忙着考试和其他事情。是的，"}, {"type": "subtitle", "time": 7525.109, "timestamp": "02:05:25", "text": "还有那件事。晚上，我们可能会"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "玩《我的世界》或者《瓦特》"}, {"type": "subtitle", "time": 7531.43, "timestamp": "02:05:31", "text": "雷。因为我得做 Wender 相关的事情"}, {"type": "subtitle", "time": 7534.47, "timestamp": "02:05:34", "text": "而且我已经为此付了钱，我必须这么做。"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "实际上，我确实投入了时间。"}, {"type": "subtitle", "time": 7539.629, "timestamp": "02:05:39", "text": "所以，就是这样。"}, {"type": "subtitle", "time": 7542.03, "timestamp": "02:05:42", "text": "那。"}, {"type": "subtitle", "time": 7544.629, "timestamp": "02:05:44", "text": "是的。你好。让我再确认一下"}, {"type": "subtitle", "time": 7547.47, "timestamp": "02:05:47", "text": "我一切都很好"}, {"type": "subtitle", "time": 7549.83, "timestamp": "02:05:49", "text": "结尾。更改类别和"}, {"type": "subtitle", "time": 7551.669, "timestamp": "02:05:51", "text": "一切。"}, {"type": "subtitle", "time": 7558.03, "timestamp": "02:05:58", "text": "人类一切安好。"}]
[{"type": "subtitle", "time": 19261.91, "timestamp": "05:21:01", "text": "它？呃，从上面还是从下面"}, {"type": "subtitle", "time": 19267.35, "timestamp": "05:21:07", "text": "嗯，是的。抓住。感觉很好。如何才能"}, {"type": "subtitle", "time": 19269.47, "timestamp": "05:21:09", "text": "你最近怎么样？我一直都表现得很好。我一直"}, {"type": "subtitle", "time": 19272.868, "timestamp": "05:21:12", "text": "好的。我服用该药物已经一个月了。"}, {"type": "subtitle", "time": 19275.35, "timestamp": "05:21:15", "text": "休息。我非常期待回来。"}, {"type": "subtitle", "time": 19276.83, "timestamp": "05:21:16", "text": "我正在做我的"}, {"type": "subtitle", "time": 19279.788, "timestamp": "05:21:19", "text": "揭示。这是秘密揭晓的内容。"}, {"type": "subtitle", "time": 19287.67, "timestamp": "05:21:27", "text": "在那里，我想对大家说声谢谢。"}, {"type": "subtitle", "time": 19289.83, "timestamp": "05:21:29", "text": "你为我做的一切。我真的"}, {"type": "subtitle", "time": 19292.868, "timestamp": "05:21:32", "text": "意义重大。你们真是我的"}, {"type": "subtitle", "time": 19295.51, "timestamp": "05:21:35", "text": "第二家庭。真是太感谢你了。"}, {"type": "subtitle", "time": 19298.51, "timestamp": "05:21:38", "text": "你真棒！"}, {"type": "subtitle", "time": 19301.31, "timestamp": "05:21:41", "text": "哦。我的天啊，你"}, {"type": "subtitle", "time": 19305.35, "timestamp": "05:21:45", "text": "笨蛋。笨蛋 笨蛋 笨蛋 笨蛋。"}, {"type": "subtitle", "time": 19315.23, "timestamp": "05:21:55", "text": "到。我想说"}, {"type": "subtitle", "time": 19319.11, "timestamp": "05:21:59", "text": "其实是因为你太可爱了"}]
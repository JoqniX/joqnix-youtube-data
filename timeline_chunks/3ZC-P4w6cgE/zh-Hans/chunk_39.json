[{"type": "subtitle", "time": 2341.23, "timestamp": "00:39:01", "text": "妈妈。好吃。"}, {"type": "subtitle", "time": 2343.23, "timestamp": "00:39:03", "text": "下去"}, {"type": "subtitle", "time": 2379.91, "timestamp": "00:39:39", "text": "低，低，低。违反。低的。违反。低的。"}, {"type": "subtitle", "time": 2389.79, "timestamp": "00:39:49", "text": "收回"}, {"type": "subtitle", "time": 2393.109, "timestamp": "00:39:53", "text": "步。最后一名幸存者。我的天啊。"}, {"type": "subtitle", "time": 2399.43, "timestamp": "00:39:59", "text": "夜晚。好的。"}]
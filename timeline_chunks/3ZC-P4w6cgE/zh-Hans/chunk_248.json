[{"type": "subtitle", "time": 14884.349, "timestamp": "04:08:04", "text": "好的。等待。"}, {"type": "subtitle", "time": 14887.11, "timestamp": "04:08:07", "text": "呃，我觉得我好像错过了好多。"}, {"type": "subtitle", "time": 14889.429, "timestamp": "04:08:09", "text": "伙计们，兄弟。我感觉自己像个失落的姑娘"}, {"type": "subtitle", "time": 14890.67, "timestamp": "04:08:10", "text": "丢失的"}, {"type": "subtitle", "time": 14894.71, "timestamp": "04:08:14", "text": "人们。我想念大家。"}, {"type": "subtitle", "time": 14900.64, "timestamp": "04:08:20", "text": "Kimotas。我跟谁谈过？"}, {"type": "subtitle", "time": 14908.469, "timestamp": "04:08:28", "text": "基马赞？等等，Kimodazan 不是就像"}, {"type": "subtitle", "time": 14939.63, "timestamp": "04:08:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 18783.23, "timestamp": "05:13:03", "text": "特别的猎人"}, {"type": "subtitle", "time": 18787.59, "timestamp": "05:13:07", "text": "特别的概念艺术，天哪，我做了什么？哦，天哪！"}, {"type": "subtitle", "time": 18792.31, "timestamp": "05:13:12", "text": "拍摄了很多镜头。你好。嗨。原因何在"}, {"type": "subtitle", "time": 18795.35, "timestamp": "05:13:15", "text": "我称之为概念艺术，实际上我是"}, {"type": "subtitle", "time": 18798.23, "timestamp": "05:13:18", "text": "正式使其成为这个呃男性"}, {"type": "subtitle", "time": 18806.35, "timestamp": "05:13:26", "text": "设计。嘿，还有这个"}, {"type": "subtitle", "time": 18808.03, "timestamp": "05:13:28", "text": "是"}, {"type": "subtitle", "time": 18810.47, "timestamp": "05:13:30", "text": "实际上，这将成为未来冲击波的发展方向。"}, {"type": "subtitle", "time": 18812.27, "timestamp": "05:13:32", "text": "接下来"}, {"type": "subtitle", "time": 18816.27, "timestamp": "05:13:36", "text": "在。但我很紧张。我浑身颤抖"}, {"type": "subtitle", "time": 18820.91, "timestamp": "05:13:40", "text": "现在。你好。所以，所以，所以"}, {"type": "subtitle", "time": 18823.07, "timestamp": "05:13:43", "text": "所以你知道，"}, {"type": "subtitle", "time": 18825.91, "timestamp": "05:13:45", "text": "嗯，所以，呃，那天她，呃，"}, {"type": "subtitle", "time": 18833.868, "timestamp": "05:13:53", "text": "画草图，老兄，我其实"}, {"type": "subtitle", "time": 18838.07, "timestamp": "05:13:58", "text": "夜里哭了。是夜晚还是某种东西？"}]
[{"type": "subtitle", "time": 394.71, "timestamp": "00:06:34", "text": "驳回。"}, {"type": "subtitle", "time": 398.07, "timestamp": "00:06:38", "text": "发现敌军。一根尖刺被种下。出去"}, {"type": "subtitle", "time": 400.87, "timestamp": "00:06:40", "text": "以我的方式。斑点 A."}, {"type": "subtitle", "time": 403.27, "timestamp": "00:06:43", "text": "我的终极技能已经准备好了。发现敌军。"}, {"type": "subtitle", "time": 411.11, "timestamp": "00:06:51", "text": "找些人帮忙。"}]
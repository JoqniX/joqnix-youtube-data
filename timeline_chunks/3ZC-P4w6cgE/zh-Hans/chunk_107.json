[{"type": "subtitle", "time": 6427.99, "timestamp": "01:47:07", "text": "不。你为什么要玩？呃，你"}, {"type": "subtitle", "time": 6430.31, "timestamp": "01:47:10", "text": "是指明天还是今天？今天我完成了。"}, {"type": "subtitle", "time": 6432.99, "timestamp": "01:47:12", "text": "我今天就到这里了。我们玩"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "瓦莱兰特。是的，明天肯定是最晚的。"}, {"type": "subtitle", "time": 6438.27, "timestamp": "01:47:18", "text": "很可能"}, {"type": "subtitle", "time": 6441.87, "timestamp": "01:47:21", "text": "事实上，我选择匈牙利是因为我需要速通。"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "那是因为发生了一些事之类的。所以"}, {"type": "subtitle", "time": 6446.87, "timestamp": "01:47:26", "text": "我想，是啊，我应该这么做。"}, {"type": "subtitle", "time": 6450.229, "timestamp": "01:47:30", "text": "进行直播而不是离线操作。"}, {"type": "subtitle", "time": 6453.59, "timestamp": "01:47:33", "text": "是的，我已经很久没玩Hongkey了。"}, {"type": "subtitle", "time": 6455.75, "timestamp": "01:47:35", "text": "正在直播。所以我想，是啊，为什么不呢？"}, {"type": "subtitle", "time": 6459.55, "timestamp": "01:47:39", "text": "在直播中这样做"}, {"type": "subtitle", "time": 6463.669, "timestamp": "01:47:43", "text": "那？但是，我也会做……如果"}, {"type": "subtitle", "time": 6466.229, "timestamp": "01:47:46", "text": "有可能，我会再做两场直播。"}, {"type": "subtitle", "time": 6470.189, "timestamp": "01:47:50", "text": "某物。我要玩《Among Us》"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "我们。记住我们之间的一切。"}, {"type": "subtitle", "time": 6476.07, "timestamp": "01:47:56", "text": "希望你游戏玩得开心！"}, {"type": "subtitle", "time": 6477.709, "timestamp": "01:47:57", "text": "玩得开心。"}]
[{"type": "subtitle", "time": 18901.91, "timestamp": "05:15:01", "text": "竟然从椅子上摔了下来"}, {"type": "subtitle", "time": 18902.75, "timestamp": "05:15:02", "text": "开始"}, {"type": "subtitle", "time": 18909.59, "timestamp": "05:15:09", "text": "很多，因为我承受不了。"}, {"type": "subtitle", "time": 18919.59, "timestamp": "05:15:19", "text": "啊，然后当她真的喜欢她的时候"}, {"type": "subtitle", "time": 18921.91, "timestamp": "05:15:21", "text": "那天发给我的信息是这样的"}, {"type": "subtitle", "time": 18924.868, "timestamp": "05:15:24", "text": "她自己，或者第二天她发了。"}, {"type": "subtitle", "time": 18928.59, "timestamp": "05:15:28", "text": "我把彩色版发给了你，然后我就想："}, {"type": "subtitle", "time": 18938.19, "timestamp": "05:15:38", "text": "我的她，她，她真的她"}, {"type": "subtitle", "time": 18942.55, "timestamp": "05:15:42", "text": "其实，这该怎么说呢？"}, {"type": "subtitle", "time": 18945.51, "timestamp": "05:15:45", "text": "呃，正确地？我遇到了点麻烦。"}, {"type": "subtitle", "time": 18947.51, "timestamp": "05:15:47", "text": "找到合适的词语来表达它。"}, {"type": "subtitle", "time": 18950.43, "timestamp": "05:15:50", "text": "但我当时就像……"}, {"type": "subtitle", "time": 18957.948, "timestamp": "05:15:57", "text": "哇。"}]
[{"type": "subtitle", "time": 9902.07, "timestamp": "02:45:02", "text": "看了看……嗯……没关系。我的意思是，我"}, {"type": "subtitle", "time": 9903.429, "timestamp": "02:45:03", "text": "想想如果你盯着它看太久的话，"}, {"type": "subtitle", "time": 9915.91, "timestamp": "02:45:15", "text": "嗯哼。"}, {"type": "subtitle", "time": 9917.91, "timestamp": "02:45:17", "text": "他妈的。我忘了自己原本要说什么。"}, {"type": "subtitle", "time": 9922.07, "timestamp": "02:45:22", "text": "但是，该死。这两件物品对双方来说都是一样的。"}, {"type": "subtitle", "time": 9924.71, "timestamp": "02:45:24", "text": "正确的？呃，所以我觉得是给一个人的。"}, {"type": "subtitle", "time": 9925.99, "timestamp": "02:45:25", "text": "人。就像我有个打火机一样。你"}, {"type": "subtitle", "time": 9929.91, "timestamp": "02:45:29", "text": "你有打火机吗？没有。你收到大号了吗？"}, {"type": "subtitle", "time": 9931.91, "timestamp": "02:45:31", "text": "钱？"}, {"type": "subtitle", "time": 9934.55, "timestamp": "02:45:34", "text": "呃，钱。我觉得我没明白。"}, {"type": "subtitle", "time": 9937.469, "timestamp": "02:45:37", "text": "钱。所以，我觉得就像"}, {"type": "subtitle", "time": 9945.75, "timestamp": "02:45:45", "text": "好的，让我确认一下橱柜是否……"}]
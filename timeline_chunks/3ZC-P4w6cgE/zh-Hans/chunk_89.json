[{"type": "subtitle", "time": 5342.03, "timestamp": "01:29:02", "text": "一切。不，我不知道它是否有。"}, {"type": "subtitle", "time": 5345.43, "timestamp": "01:29:05", "text": "今天直播。最有可能知道"}, {"type": "subtitle", "time": 5348.55, "timestamp": "01:29:08", "text": "萨拉赫，她当时肯定很忙，就像……"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "努力工作等等。所以，也许"}, {"type": "subtitle", "time": 5355.709, "timestamp": "01:29:15", "text": "她或许有。我不知道。但"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "是的，谢谢你的光临。"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "很高兴您能抽出时间来一趟。"}, {"type": "subtitle", "time": 5372.79, "timestamp": "01:29:32", "text": "修补。是的，每个人都要戴上头巾。"}, {"type": "subtitle", "time": 5374.709, "timestamp": "01:29:34", "text": "出色地。别以为我只会把它给……"}, {"type": "subtitle", "time": 5376.229, "timestamp": "01:29:36", "text": "沙拉什。它适合所有人。我只是"}, {"type": "subtitle", "time": 5378.39, "timestamp": "01:29:38", "text": "意识到我忘了给头巾。哦，"}, {"type": "subtitle", "time": 5381.35, "timestamp": "01:29:41", "text": "等待。我那个头状的东西在哪儿？"}, {"type": "subtitle", "time": 5383.229, "timestamp": "01:29:43", "text": "应该把它放在这里。"}, {"type": "subtitle", "time": 5385.95, "timestamp": "01:29:45", "text": "等待。应该把它放在这里。"}, {"type": "subtitle", "time": 5389.51, "timestamp": "01:29:49", "text": "等待。等等。让我复制一下。我需要"}, {"type": "subtitle", "time": 5391.91, "timestamp": "01:29:51", "text": "有朝一日能像我一样制作动画"}, {"type": "subtitle", "time": 5395.06, "timestamp": "01:29:55", "text": "曾经有一天。在那里"}, {"type": "subtitle", "time": 5396.59, "timestamp": "01:29:56", "text": "[音乐]"}, {"type": "subtitle", "time": 5399.31, "timestamp": "01:29:59", "text": "去。这一定是"}]
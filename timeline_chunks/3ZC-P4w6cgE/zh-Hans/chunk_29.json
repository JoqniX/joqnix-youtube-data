[{"type": "subtitle", "time": 1742.669, "timestamp": "00:29:02", "text": "我们从零到胜利"}, {"type": "subtitle", "time": 1745.75, "timestamp": "00:29:05", "text": "游戏。这就是所谓的崛起"}, {"type": "subtitle", "time": 1748.19, "timestamp": "00:29:08", "text": "从零到"}, {"type": "subtitle", "time": 1751.43, "timestamp": "00:29:11", "text": "英雄之类的角色。团队合作是"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "我想，这大概就是我梦寐以求的工作吧。"}, {"type": "subtitle", "time": 1758.59, "timestamp": "00:29:18", "text": "嗯，我是MVP。哇。"}, {"type": "subtitle", "time": 1760.99, "timestamp": "00:29:20", "text": "再见。非常"}, {"type": "subtitle", "time": 1770.19, "timestamp": "00:29:30", "text": "不是。哦，我得到了放射性物质"}, {"type": "subtitle", "time": 1773.789, "timestamp": "00:29:33", "text": "积分和第四级"}, {"type": "subtitle", "time": 1795.43, "timestamp": "00:29:55", "text": "我正打算结束今天的工作。这有点像"}, {"type": "subtitle", "time": 1796.909, "timestamp": "00:29:56", "text": "晚的，"}, {"type": "subtitle", "time": 1799.669, "timestamp": "00:29:59", "text": "正确的？我可以再来一次吗？一两个"}]
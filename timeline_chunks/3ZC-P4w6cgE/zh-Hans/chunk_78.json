[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "想。还有，别忘了照顾好自己。"}, {"type": "subtitle", "time": 4682.47, "timestamp": "01:18:02", "text": "照顾好自己的身体和一切。"}, {"type": "subtitle", "time": 4683.709, "timestamp": "01:18:03", "text": "来"}, {"type": "subtitle", "time": 4688.11, "timestamp": "01:18:08", "text": "到那时，亲爱的。跟爸爸再见"}, {"type": "subtitle", "time": 4690.189, "timestamp": "01:18:10", "text": "蜂蜜。你好"}, {"type": "subtitle", "time": 4694.55, "timestamp": "01:18:14", "text": "蜂蜜。等待。嗨，宝贝。嗨，男孩，等等。所以"}, {"type": "subtitle", "time": 4696.669, "timestamp": "01:18:16", "text": "我无法说"}, {"type": "subtitle", "time": 4704.229, "timestamp": "01:18:24", "text": "感谢您的光临，祝您圣诞快乐！"}, {"type": "subtitle", "time": 4707.03, "timestamp": "01:18:27", "text": "也祝你一切顺利。谢谢光临"}, {"type": "subtitle", "time": 4710.709, "timestamp": "01:18:30", "text": "今天和我们一起闲聊了一会儿。希望"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "你真是个很有圣诞精神的人。"}, {"type": "subtitle", "time": 4716.39, "timestamp": "01:18:36", "text": "那就是你明天醒来时的样子。"}, {"type": "subtitle", "time": 4717.55, "timestamp": "01:18:37", "text": "明天。"}, {"type": "subtitle", "time": 4721.189, "timestamp": "01:18:41", "text": "是的。是的，谢谢你的光临。"}, {"type": "subtitle", "time": 4724.95, "timestamp": "01:18:44", "text": "我也祝你圣诞快乐。然后"}, {"type": "subtitle", "time": 4726.83, "timestamp": "01:18:46", "text": "路过"}, {"type": "subtitle", "time": 4729.189, "timestamp": "01:18:49", "text": "今天过来看看。这真的意味着"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "很多。希望你喜欢这个知识，也祝你快乐"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "也祝你和大家圣诞快乐！"}, {"type": "subtitle", "time": 4737.55, "timestamp": "01:18:57", "text": "真人秀工作室。欢迎并祝您快乐"}]
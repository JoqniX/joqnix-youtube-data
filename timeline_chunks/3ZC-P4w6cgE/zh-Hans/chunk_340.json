[{"type": "subtitle", "time": 20402.31, "timestamp": "05:40:02", "text": "故事似乎还在继续。我做了吗？"}, {"type": "subtitle", "time": 20405.11, "timestamp": "05:40:05", "text": "在我的直播里说出来？我不知道。"}, {"type": "subtitle", "time": 20409.51, "timestamp": "05:40:09", "text": "是的，以前有……嗯……用过"}, {"type": "subtitle", "time": 20415.628, "timestamp": "05:40:15", "text": "就像在学校的那段时间一样，我过去常常……"}, {"type": "subtitle", "time": 20419.75, "timestamp": "05:40:19", "text": "呃，因为我看起来有点像个女孩子。我"}, {"type": "subtitle", "time": 20421.51, "timestamp": "05:40:21", "text": "不知道，但是老师和"}, {"type": "subtitle", "time": 20426.07, "timestamp": "05:40:26", "text": "像梅什这样的学生迫使他成为"}, {"type": "subtitle", "time": 20428.948, "timestamp": "05:40:28", "text": "那它叫什么来着？"}, {"type": "subtitle", "time": 20431.67, "timestamp": "05:40:31", "text": "一名女性。我喜欢她们穿得恰到好处。"}, {"type": "subtitle", "time": 20434.19, "timestamp": "05:40:34", "text": "我愿意出演这个角色"}, {"type": "subtitle", "time": 20439.39, "timestamp": "05:40:39", "text": "玩。实际上，它是一个中心"}, {"type": "subtitle", "time": 20452.67, "timestamp": "05:40:52", "text": "啊。哦，"}, {"type": "subtitle", "time": 20456.868, "timestamp": "05:40:56", "text": "上帝。是的。他们相处得非常好。"}]
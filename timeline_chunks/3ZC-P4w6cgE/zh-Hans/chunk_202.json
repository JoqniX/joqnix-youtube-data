[{"type": "subtitle", "time": 12121.75, "timestamp": "03:22:01", "text": "呃，每次你赢了你都会得到类似的东西"}, {"type": "subtitle", "time": 12124.15, "timestamp": "03:22:04", "text": "一些关键点，或者我想是的。还有你"}, {"type": "subtitle", "time": 12126.07, "timestamp": "03:22:06", "text": "你解锁的钥匙，它有点像……"}, {"type": "subtitle", "time": 12129.269, "timestamp": "03:22:09", "text": "就像开箱子一样。你可以免费获得新的价格"}, {"type": "subtitle", "time": 12137.71, "timestamp": "03:22:17", "text": "所以"}, {"type": "subtitle", "time": 12141.03, "timestamp": "03:22:21", "text": "是的，第二个是这个手电筒。呃，闪光灯"}, {"type": "subtitle", "time": 12143.51, "timestamp": "03:22:23", "text": "是其中之一。我更喜欢这个。更好"}, {"type": "subtitle", "time": 12147.91, "timestamp": "03:22:27", "text": "更容易发出“哇”的惊叹声。好的。"}, {"type": "subtitle", "time": 12150.07, "timestamp": "03:22:30", "text": "所以，Shift键的作用是……你可以按住"}, {"type": "subtitle", "time": 12152.79, "timestamp": "03:22:32", "text": "转为冲刺。"}, {"type": "subtitle", "time": 12155.15, "timestamp": "03:22:35", "text": "天哪，太吵了。耶稣"}, {"type": "subtitle", "time": 12159.79, "timestamp": "03:22:39", "text": "基督。呃，音量。好的。"}, {"type": "subtitle", "time": 12162.349, "timestamp": "03:22:42", "text": "是的。解锁"}, {"type": "subtitle", "time": 12173.71, "timestamp": "03:22:53", "text": "上帝。全部"}, {"type": "subtitle", "time": 12176.309, "timestamp": "03:22:56", "text": "正确的。而对于这个，你只需要……"}, {"type": "subtitle", "time": 12178.99, "timestamp": "03:22:58", "text": "滑到下面"}]
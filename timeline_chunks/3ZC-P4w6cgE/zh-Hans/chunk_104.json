[{"type": "subtitle", "time": 6242.95, "timestamp": "01:44:02", "text": "游戏。等等，哦，对了。我忘了。如果"}, {"type": "subtitle", "time": 6245.669, "timestamp": "01:44:05", "text": "你有 BT 电视扩展程序，快跑。我"}, {"type": "subtitle", "time": 6255.14, "timestamp": "01:44:15", "text": "表情符号。我忘了我还有表情包。"}, {"type": "subtitle", "time": 6261.75, "timestamp": "01:44:21", "text": "所以，还有谁在直播？"}, {"type": "subtitle", "time": 6266.109, "timestamp": "01:44:26", "text": "呃，我相信呃，最近一个新的"}, {"type": "subtitle", "time": 6268.55, "timestamp": "01:44:28", "text": "已发现并欢迎加入社区"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "呃，这首歌被我戴上了。是的，他们"}, {"type": "subtitle", "time": 6276.629, "timestamp": "01:44:36", "text": "他们也在进行直播。"}, {"type": "subtitle", "time": 6280.39, "timestamp": "01:44:40", "text": "还有那些尽力而为的人……"}, {"type": "subtitle", "time": 6282.87, "timestamp": "01:44:42", "text": "就像那些活着的人一样"}, {"type": "subtitle", "time": 6285.79, "timestamp": "01:44:45", "text": "圣诞夜直播"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "圣诞节是为了感谢你尽力而为以及那些"}, {"type": "subtitle", "time": 6291.87, "timestamp": "01:44:51", "text": "那些正在和某人约会的人"}, {"type": "subtitle", "time": 6295.35, "timestamp": "01:44:55", "text": "特别的，或者你知道的，庆祝"}, {"type": "subtitle", "time": 6297.43, "timestamp": "01:44:57", "text": "与家人或家人一起过圣诞节"}]
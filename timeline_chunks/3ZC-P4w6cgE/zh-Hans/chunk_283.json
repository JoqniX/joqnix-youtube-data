[{"type": "subtitle", "time": 16980.39, "timestamp": "04:43:00", "text": "我关心和珍惜的人，呃，我"}, {"type": "subtitle", "time": 16982.47, "timestamp": "04:43:02", "text": "积极参与多个协作项目，例如"}, {"type": "subtitle", "time": 16986.55, "timestamp": "04:43:06", "text": "这些人以为，嗯，是的，我是"}, {"type": "subtitle", "time": 16989.19, "timestamp": "04:43:09", "text": "抢夺别人的棍棒或其他什么东西"}, {"type": "subtitle", "time": 16991.11, "timestamp": "04:43:11", "text": "他们的数量或者其他什么的，哪怕只是一点点。"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "即使它带有一个"}, {"type": "subtitle", "time": 16995.39, "timestamp": "04:43:15", "text": "更大的创造者"}, {"type": "subtitle", "time": 17002.708, "timestamp": "04:43:22", "text": "兄弟，我从来没想过，我甚至都没想过"}, {"type": "subtitle", "time": 17006.47, "timestamp": "04:43:26", "text": "除非我听到一些消息，否则事情就是这样。"}, {"type": "subtitle", "time": 17007.628, "timestamp": "04:43:27", "text": "所以我是"}, {"type": "subtitle", "time": 17008.89, "timestamp": "04:43:28", "text": "喜欢"}, {"type": "subtitle", "time": 17015.55, "timestamp": "04:43:35", "text": "哇，你想要什么？"}]
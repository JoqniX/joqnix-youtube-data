[{"type": "subtitle", "time": 18540.708, "timestamp": "05:09:00", "text": "私が望むものなら何でもデザインします"}, {"type": "subtitle", "time": 18542.31, "timestamp": "05:09:02", "text": "将来"}, {"type": "subtitle", "time": 18546.59, "timestamp": "05:09:06", "text": "えーと、YouTuberを目指している者として"}, {"type": "subtitle", "time": 18549.868, "timestamp": "05:09:09", "text": "実際、何も"}, {"type": "subtitle", "time": 18552.23, "timestamp": "05:09:12", "text": "何も起こらなかった"}, {"type": "subtitle", "time": 18553.31, "timestamp": "05:09:13", "text": "動かなかった"}, {"type": "subtitle", "time": 18557.91, "timestamp": "05:09:17", "text": "前はただ自分のやりたいことをやるだけだった"}, {"type": "subtitle", "time": 18560.91, "timestamp": "05:09:20", "text": "自分のやりたいことをやってるんだよ"}, {"type": "subtitle", "time": 18563.75, "timestamp": "05:09:23", "text": "そして私は本当に前に進まなかったのは、"}, {"type": "subtitle", "time": 18567.75, "timestamp": "05:09:27", "text": "忙しかったが、イライラしていたわけではない"}, {"type": "subtitle", "time": 18569.07, "timestamp": "05:09:29", "text": "たくさん"}, {"type": "subtitle", "time": 18573.75, "timestamp": "05:09:33", "text": "いろいろあるけど、この休憩中に私は"}, {"type": "subtitle", "time": 18576.23, "timestamp": "05:09:36", "text": "ブレイク ハヤトゥス どう発音するの？"}, {"type": "subtitle", "time": 18581.23, "timestamp": "05:09:41", "text": "それ？ええ、この1ヶ月の休暇"}, {"type": "subtitle", "time": 18585.67, "timestamp": "05:09:45", "text": "私は本当に自分のために時間を取って"}, {"type": "subtitle", "time": 18586.83, "timestamp": "05:09:46", "text": "本当に"}, {"type": "subtitle", "time": 18589.788, "timestamp": "05:09:49", "text": "理解して好きになる自分を見つける"}, {"type": "subtitle", "time": 18593.27, "timestamp": "05:09:53", "text": "愛と"}, {"type": "subtitle", "time": 18595.91, "timestamp": "05:09:55", "text": "温かさが頭を通り抜け、すべての抱擁が"}, {"type": "subtitle", "time": 18599.07, "timestamp": "05:09:59", "text": "君たちは私にすべてをくれた"}]
[{"type": "subtitle", "time": 19682.15, "timestamp": "05:28:02", "text": "えーと、もし皆さんが覚えておいてほしいのは、"}, {"type": "subtitle", "time": 19685.59, "timestamp": "05:28:05", "text": "私がプレイするすべてのゲームの中で、"}, {"type": "subtitle", "time": 19688.31, "timestamp": "05:28:08", "text": "私が作ろうとしているキャラクターは、"}, {"type": "subtitle", "time": 19693.35, "timestamp": "05:28:13", "text": "青色にも紫色にも見える。うん。"}, {"type": "subtitle", "time": 19695.948, "timestamp": "05:28:15", "text": "だからそれらは"}, {"type": "subtitle", "time": 19698.31, "timestamp": "05:28:18", "text": "これらのヘアバンドを表し、また"}, {"type": "subtitle", "time": 19704.35, "timestamp": "05:28:24", "text": "黒も。クロギャングクロギャング#グロ"}, {"type": "subtitle", "time": 19706.19, "timestamp": "05:28:26", "text": "ギャング"}, {"type": "subtitle", "time": 19709.75, "timestamp": "05:28:29", "text": "だからこの３人は"}, {"type": "subtitle", "time": 19710.99, "timestamp": "05:28:30", "text": "回答"}, {"type": "subtitle", "time": 19712.59, "timestamp": "05:28:32", "text": "代表する"}, {"type": "subtitle", "time": 19716.708, "timestamp": "05:28:36", "text": "繋がっているような色のように"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "私と一緒にいることが多く、また、"}, {"type": "subtitle", "time": 19727.788, "timestamp": "05:28:47", "text": "[音楽]"}, {"type": "subtitle", "time": 19730.708, "timestamp": "05:28:50", "text": "メイショー、それは私の"}, {"type": "subtitle", "time": 19733.03, "timestamp": "05:28:53", "text": "H. 私のお気に入りは何かと聞かれたら"}, {"type": "subtitle", "time": 19735.948, "timestamp": "05:28:55", "text": "色、それは実際には"}, {"type": "subtitle", "time": 19739.43, "timestamp": "05:28:59", "text": "ああ、なんていう感じ。ああ、私は好きです、つまり、全部好きです"}]
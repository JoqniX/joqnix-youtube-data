[{"type": "subtitle", "time": 9540.469, "timestamp": "02:39:00", "text": "おお。あ、待って。待って。誰がそんなことを言ったの？"}, {"type": "subtitle", "time": 9542.71, "timestamp": "02:39:02", "text": "つまり、いないいないばあってことですよね？小便"}, {"type": "subtitle", "time": 9547.91, "timestamp": "02:39:07", "text": "あれ。うん。うんうん。だから、ああ、それは"}, {"type": "subtitle", "time": 9550.71, "timestamp": "02:39:10", "text": "こちらです。そうそう。ええ、ここにありますよ。"}, {"type": "subtitle", "time": 9554.23, "timestamp": "02:39:14", "text": "それで、えっと、見てください。それは"}, {"type": "subtitle", "time": 9556.95, "timestamp": "02:39:16", "text": "彼は実際にはあなたの足元にいるでしょう。あなた"}, {"type": "subtitle", "time": 9559.67, "timestamp": "02:39:19", "text": "それを見て、そうやって宿泊する"}, {"type": "subtitle", "time": 9562.71, "timestamp": "02:39:22", "text": "それをかわす"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "だって、私にとっては、私が"}, {"type": "subtitle", "time": 9566.469, "timestamp": "02:39:26", "text": "振り返って上を見上げると、"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "彼は私より上の立場だった。だからそう思う、そう思う"}, {"type": "subtitle", "time": 9574.91, "timestamp": "02:39:34", "text": "ただ、彼を見つける必要がある"}, {"type": "subtitle", "time": 9579.11, "timestamp": "02:39:39", "text": "彼があなたにたどり着く前に。"}, {"type": "subtitle", "time": 9594.23, "timestamp": "02:39:54", "text": "ああ、くそ。えっと、"}, {"type": "subtitle", "time": 9598.63, "timestamp": "02:39:58", "text": "くそっ。どうしたの？ 23と24。了解。 20"}]
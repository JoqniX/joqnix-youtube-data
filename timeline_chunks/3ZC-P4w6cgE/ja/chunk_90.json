[{"type": "subtitle", "time": 5402.11, "timestamp": "01:30:02", "text": "下に。はい、どうぞ。気にしないで"}, {"type": "subtitle", "time": 5405.43, "timestamp": "01:30:05", "text": "信仰。それはTwitchからだよ、だって私は"}, {"type": "subtitle", "time": 5407.709, "timestamp": "01:30:07", "text": "頭を後ろに傾けるもの、"}, {"type": "subtitle", "time": 5410.91, "timestamp": "01:30:10", "text": "右？そうそう。もっと"}, {"type": "subtitle", "time": 5413.75, "timestamp": "01:30:13", "text": "もっと。さて、どこまで話しましたっけ？ええと、私たちは"}, {"type": "subtitle", "time": 5419.83, "timestamp": "01:30:19", "text": "明日配信予定。わからない"}, {"type": "subtitle", "time": 5422.43, "timestamp": "01:30:22", "text": "明日ストリーミング配信するね、"}, {"type": "subtitle", "time": 5426.35, "timestamp": "01:30:26", "text": "でも、いつもあなたのことをしてくれてありがとう"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "最高です、そしてメリークリスマス"}, {"type": "subtitle", "time": 5432.47, "timestamp": "01:30:32", "text": "良い。ヴィでの時間をお楽しみいただければ幸いです。"}, {"type": "subtitle", "time": 5435.27, "timestamp": "01:30:35", "text": "BC州に行ったことがないから"}, {"type": "subtitle", "time": 5436.51, "timestamp": "01:30:36", "text": "ビーチ"}, {"type": "subtitle", "time": 5439.27, "timestamp": "01:30:39", "text": "お時間をいただきありがとうございました。時間を使って、"}, {"type": "subtitle", "time": 5442.709, "timestamp": "01:30:42", "text": "みんなと遊ぶんだよ。"}, {"type": "subtitle", "time": 5443.78, "timestamp": "01:30:43", "text": "そして"}, {"type": "subtitle", "time": 5457.91, "timestamp": "01:30:57", "text": "アーシャにお祝いしてくれてありがとう、そしてそうだった"}]
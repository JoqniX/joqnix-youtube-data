[{"type": "subtitle", "time": 5040.03, "timestamp": "01:24:00", "text": "教会の座席"}, {"type": "subtitle", "time": 5041.87, "timestamp": "01:24:01", "text": "ピューピューと"}, {"type": "subtitle", "time": 5044.87, "timestamp": "01:24:04", "text": "ゲームもクラッシュします。 PCがクラッシュしたんですよね？あなた"}, {"type": "subtitle", "time": 5049.11, "timestamp": "01:24:09", "text": "大丈夫だと言った。そういうこともある。しかしそれでも、"}, {"type": "subtitle", "time": 5051.39, "timestamp": "01:24:11", "text": "楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 5053.99, "timestamp": "01:24:13", "text": "ストリーム。皆さん楽しんでいただけたでしょうか。そして"}, {"type": "subtitle", "time": 5058.629, "timestamp": "01:24:18", "text": "昨日は本当に楽しかった。君がおしっこすることを願ってるよ"}, {"type": "subtitle", "time": 5061.99, "timestamp": "01:24:21", "text": "あなたと一緒にいて、ここにいてください。私はとても驚いた"}, {"type": "subtitle", "time": 5065.35, "timestamp": "01:24:25", "text": "その３つのデッドマッチに勝つ。ああ、"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "神。"}, {"type": "subtitle", "time": 5077.99, "timestamp": "01:24:37", "text": "楽しかった。あなたにもメリークリスマス。"}, {"type": "subtitle", "time": 5079.87, "timestamp": "01:24:39", "text": "何ですか"}, {"type": "subtitle", "time": 5093.59, "timestamp": "01:24:53", "text": "今日。良い一日を過ごされたことを願っています"}, {"type": "subtitle", "time": 5096.95, "timestamp": "01:24:56", "text": "ストリーム。今日は楽しんでいただけたでしょうか。なるほど"}]
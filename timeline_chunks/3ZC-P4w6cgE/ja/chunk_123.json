[{"type": "subtitle", "time": 7382.27, "timestamp": "02:03:02", "text": "ハニー。うん。こんにちは、ブラッド。ようこそ"}, {"type": "subtitle", "time": 7384.83, "timestamp": "02:03:04", "text": "ストリーム。"}, {"type": "subtitle", "time": 7387.31, "timestamp": "02:03:07", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 7397.39, "timestamp": "02:03:17", "text": "それ。聞こえますか？"}, {"type": "subtitle", "time": 7401.43, "timestamp": "02:03:21", "text": "自分？私は生放送中ですか？"}, {"type": "subtitle", "time": 7409.629, "timestamp": "02:03:29", "text": "ライブ。はい、ライブ配信中です。"}, {"type": "subtitle", "time": 7420.709, "timestamp": "02:03:40", "text": "ツイート。ごめんなさい。私たちは"}, {"type": "subtitle", "time": 7421.709, "timestamp": "02:03:41", "text": "始める"}, {"type": "subtitle", "time": 7426.07, "timestamp": "02:03:46", "text": "実際には、"}, {"type": "subtitle", "time": 7429.35, "timestamp": "02:03:49", "text": "えーっと、午後3時でも私はやらなければならなかった"}, {"type": "subtitle", "time": 7431.229, "timestamp": "02:03:51", "text": "緊急"}, {"type": "subtitle", "time": 7434.99, "timestamp": "02:03:54", "text": "やらなきゃいけないことがあったんだけど"}, {"type": "subtitle", "time": 7438.07, "timestamp": "02:03:58", "text": "そして、少し遅れることになった。それから私は"}]
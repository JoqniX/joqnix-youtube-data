[{"type": "subtitle", "time": 13800.87, "timestamp": "03:50:00", "text": "行くよ。"}, {"type": "subtitle", "time": 13812.63, "timestamp": "03:50:12", "text": "ニース。よし。彼の進路から外れて"}, {"type": "subtitle", "time": 13813.83, "timestamp": "03:50:13", "text": "視力。ドアの後ろに隠れてください。後ろを向いて"}, {"type": "subtitle", "time": 13817.67, "timestamp": "03:50:17", "text": "ドア。ああ、くそ。くそっ。わかった。だから、"}, {"type": "subtitle", "time": 13819.75, "timestamp": "03:50:19", "text": "よし。えっと、観戦できます"}, {"type": "subtitle", "time": 13821.189, "timestamp": "03:50:21", "text": "自分。えっと、あなたが"}, {"type": "subtitle", "time": 13823.8, "timestamp": "03:50:23", "text": "私を観察している。"}, {"type": "subtitle", "time": 13825.91, "timestamp": "03:50:25", "text": "[音楽]"}, {"type": "subtitle", "time": 13829.75, "timestamp": "03:50:29", "text": "うん。わかった。わかった。それで、彼が"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "ここに立って、走って戻って隠れる"}, {"type": "subtitle", "time": 13834.95, "timestamp": "03:50:34", "text": "ここ。"}, {"type": "subtitle", "time": 13837.189, "timestamp": "03:50:37", "text": "ああ、つまりこれは障害物みたいなものですね"}, {"type": "subtitle", "time": 13855.83, "timestamp": "03:50:55", "text": "[音楽]"}]
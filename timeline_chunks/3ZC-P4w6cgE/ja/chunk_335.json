[{"type": "subtitle", "time": 20105.59, "timestamp": "05:35:05", "text": "もの。それから、えーと、あなたは、"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "誰もが知っているような流行がある"}, {"type": "subtitle", "time": 20110.99, "timestamp": "05:35:10", "text": "あなたは白を持っています"}, {"type": "subtitle", "time": 20113.99, "timestamp": "05:35:13", "text": "髪。あなたは白髪ですね。 Hの髪"}, {"type": "subtitle", "time": 20116.47, "timestamp": "05:35:16", "text": "それはあなたが不死身であることを意味します。ええ、そうです"}, {"type": "subtitle", "time": 20120.23, "timestamp": "05:35:20", "text": "実際には不死身です。なぜなら私は生まれ変わったからです。"}, {"type": "subtitle", "time": 20122.11, "timestamp": "05:35:22", "text": "私の"}, {"type": "subtitle", "time": 20128.35, "timestamp": "05:35:28", "text": "こんにちは。つまり、私は不死身だ"}, {"type": "subtitle", "time": 20138.43, "timestamp": "05:35:38", "text": "あまりにも。クールな子になりたいの？ただ"}, {"type": "subtitle", "time": 20142.43, "timestamp": "05:35:42", "text": "うん、そうだね。ピアスと大きな丸い"}, {"type": "subtitle", "time": 20145.51, "timestamp": "05:35:45", "text": "メガネをかけるとカッコよく見える。"}, {"type": "subtitle", "time": 20148.47, "timestamp": "05:35:48", "text": "えっと、髪型とかそういうのだけど、"}, {"type": "subtitle", "time": 20150.548, "timestamp": "05:35:50", "text": "あなたはこのようにしてチョークを身につけ、"}, {"type": "subtitle", "time": 20159.19, "timestamp": "05:35:59", "text": "えっと、引き換えを全部削除したの？"}]
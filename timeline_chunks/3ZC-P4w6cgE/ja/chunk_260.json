[{"type": "subtitle", "time": 15600.03, "timestamp": "04:20:00", "text": "フォローアップしないなど"}, {"type": "subtitle", "time": 15604.429, "timestamp": "04:20:04", "text": "あるいは、それは一体何なのか？どう言えばいいですか？"}, {"type": "subtitle", "time": 15607.429, "timestamp": "04:20:07", "text": "えっと、どう言えばいいかな？生殖として"}, {"type": "subtitle", "time": 15611.03, "timestamp": "04:20:11", "text": "私の信頼、あるいは私が費やした努力"}, {"type": "subtitle", "time": 15613.99, "timestamp": "04:20:13", "text": "人々に情報を伝える。"}, {"type": "subtitle", "time": 15616.99, "timestamp": "04:20:16", "text": "ええ、何か"}, {"type": "subtitle", "time": 15619.55, "timestamp": "04:20:19", "text": "君のことが心配だ"}, {"type": "subtitle", "time": 15622.269, "timestamp": "04:20:22", "text": "連絡を取り続けるのは難しいと分かっています"}, {"type": "subtitle", "time": 15624.87, "timestamp": "04:20:24", "text": "みんな、たとえ私が"}, {"type": "subtitle", "time": 15627.67, "timestamp": "04:20:27", "text": "連絡を取り続けていて、"}, {"type": "subtitle", "time": 15631.189, "timestamp": "04:20:31", "text": "触れてみれば、彼らが今すぐ去ることができるかどうかわからない"}, {"type": "subtitle", "time": 15632.99, "timestamp": "04:20:32", "text": "それは何か"}, {"type": "subtitle", "time": 15637.03, "timestamp": "04:20:37", "text": "感受性の強い人間にとっては辛いことだ"}, {"type": "subtitle", "time": 15640.309, "timestamp": "04:20:40", "text": "すごく深い"}, {"type": "subtitle", "time": 15642.91, "timestamp": "04:20:42", "text": "ああ、すごく衝撃を受けるよ"}, {"type": "subtitle", "time": 15651.149, "timestamp": "04:20:51", "text": "「ああ、もうそうじゃない」って感じ"}]
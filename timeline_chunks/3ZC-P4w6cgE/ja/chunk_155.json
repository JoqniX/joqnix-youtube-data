[{"type": "subtitle", "time": 9315.63, "timestamp": "02:35:15", "text": "兄弟。"}, {"type": "subtitle", "time": 9338.67, "timestamp": "02:35:38", "text": "右。よし、それはただ"}, {"type": "subtitle", "time": 9341.469, "timestamp": "02:35:41", "text": "1"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "ブロックする。"}, {"type": "subtitle", "time": 9348.51, "timestamp": "02:35:48", "text": "えっと、誰かがぼーっとしてるみたい。"}, {"type": "subtitle", "time": 9351.429, "timestamp": "02:35:51", "text": "うん、やってみて。わからない。忘れた。何"}, {"type": "subtitle", "time": 9353.99, "timestamp": "02:35:53", "text": "そうだったのか？ああ、癒しを受け取って。"}, {"type": "subtitle", "time": 9356.23, "timestamp": "02:35:56", "text": "だから、包帯を見つけなきゃ。わかった、"}, {"type": "subtitle", "time": 9359.429, "timestamp": "02:35:59", "text": "ありがとう。"}]
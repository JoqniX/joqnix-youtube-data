[{"type": "subtitle", "time": 6662.95, "timestamp": "01:51:02", "text": "笑ってもいいし、"}, {"type": "subtitle", "time": 6664.43, "timestamp": "01:51:04", "text": "それを"}, {"type": "subtitle", "time": 6669.55, "timestamp": "01:51:09", "text": "それ"}, {"type": "subtitle", "time": 6673.59, "timestamp": "01:51:13", "text": "みんな。というわけで、掃除に行ってきます。"}, {"type": "subtitle", "time": 6676.95, "timestamp": "01:51:16", "text": "そういう人にとっては、"}, {"type": "subtitle", "time": 6680.629, "timestamp": "01:51:20", "text": "私の時間だと午前3時14分くらいです。"}, {"type": "subtitle", "time": 6683.109, "timestamp": "01:51:23", "text": "寝ている人は今すぐ寝なさい"}, {"type": "subtitle", "time": 6685.51, "timestamp": "01:51:25", "text": "しかし、今日手に入れたので、"}, {"type": "subtitle", "time": 6688.87, "timestamp": "01:51:28", "text": "えっと、あなたにとっては朝晩でしょう"}, {"type": "subtitle", "time": 6692.229, "timestamp": "01:51:32", "text": "それは北米とESCのほとんどの人からの意見です"}, {"type": "subtitle", "time": 6695.83, "timestamp": "01:51:35", "text": "そしてPSCのタイムゾーン。そうですね、でも良いです"}, {"type": "subtitle", "time": 6699.07, "timestamp": "01:51:39", "text": "良い午後と夜をお過ごしください"}, {"type": "subtitle", "time": 6702.31, "timestamp": "01:51:42", "text": "それでは、メリークリスマスイブ。だから私たちは"}, {"type": "subtitle", "time": 6703.83, "timestamp": "01:51:43", "text": "明日配信開始。だから私はできる"}, {"type": "subtitle", "time": 6706.55, "timestamp": "01:51:46", "text": "メリークリスマスをあなたに"}]
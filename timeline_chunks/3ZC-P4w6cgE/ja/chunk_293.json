[{"type": "subtitle", "time": 17592.35, "timestamp": "04:53:12", "text": "ヤフー。ありがとうございます"}, {"type": "subtitle", "time": 17596.67, "timestamp": "04:53:16", "text": "来るよ。ヤフー。ヤフー。"}, {"type": "subtitle", "time": 17601.868, "timestamp": "04:53:21", "text": "ヤフー。ここにローがいるのが見える。"}, {"type": "subtitle", "time": 17608.03, "timestamp": "04:53:28", "text": "こんにちは。それで、"}, {"type": "subtitle", "time": 17614.91, "timestamp": "04:53:34", "text": "神経質。こんにちは。"}, {"type": "subtitle", "time": 17618.19, "timestamp": "04:53:38", "text": "ああ、神様。"}, {"type": "subtitle", "time": 17621.31, "timestamp": "04:53:41", "text": "えーっと、あの、"}, {"type": "subtitle", "time": 17630.15, "timestamp": "04:53:50", "text": "少し。正直に言うと、私はまだショーが好きです"}, {"type": "subtitle", "time": 17631.788, "timestamp": "04:53:51", "text": "あなたと。えっと、"}, {"type": "subtitle", "time": 17635.55, "timestamp": "04:53:55", "text": "なぜこんなに震えているのか分からないけど、"}, {"type": "subtitle", "time": 17638.788, "timestamp": "04:53:58", "text": "でも、私にはわからない。君の気持ち、分かるよ。私"}]
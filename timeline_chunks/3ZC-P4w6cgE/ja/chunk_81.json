[{"type": "subtitle", "time": 4860.63, "timestamp": "01:21:00", "text": "説明欄に記載されます。次のオリジナルコンテンツ"}, {"type": "subtitle", "time": 4862.189, "timestamp": "01:21:02", "text": "によって描かれた"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "星空から来たザチ。ライブ任務"}, {"type": "subtitle", "time": 4868.07, "timestamp": "01:21:08", "text": "バージョン、つまり私が現在使用しているものです。"}, {"type": "subtitle", "time": 4871.709, "timestamp": "01:21:11", "text": "これは"}, {"type": "subtitle", "time": 4876.55, "timestamp": "01:21:16", "text": "ム。そう、これがオリジナルです"}, {"type": "subtitle", "time": 4878.149, "timestamp": "01:21:18", "text": "ええ、バージョン1と言ってもいいですよ"}, {"type": "subtitle", "time": 4881.51, "timestamp": "01:21:21", "text": "公式のアートデザインのイラストまたは"}, {"type": "subtitle", "time": 4885.11, "timestamp": "01:21:25", "text": "次はジョーのデザインです。でも、将来は"}, {"type": "subtitle", "time": 4887.91, "timestamp": "01:21:27", "text": "少し変わるかもしれません。そうそう。"}, {"type": "subtitle", "time": 4891.149, "timestamp": "01:21:31", "text": "しかし今はそうなっている。これは"}, {"type": "subtitle", "time": 4894.43, "timestamp": "01:21:34", "text": "モール。こんにちは"}, {"type": "subtitle", "time": 4898.87, "timestamp": "01:21:38", "text": "お父さんのプリンがやってきた。バプリン。私"}, {"type": "subtitle", "time": 4900.43, "timestamp": "01:21:40", "text": "会いたかったよ"}, {"type": "subtitle", "time": 4905.35, "timestamp": "01:21:45", "text": "もっと夢を見たいけど、来てくれて、"}, {"type": "subtitle", "time": 4907.51, "timestamp": "01:21:47", "text": "滞在中、一緒に過ごしてくれてありがとう"}, {"type": "subtitle", "time": 4909.83, "timestamp": "01:21:49", "text": "ゲームをダウンロードして、その他すべて"}, {"type": "subtitle", "time": 4913.189, "timestamp": "01:21:53", "text": "ぞっとする。ありがとう。"}, {"type": "subtitle", "time": 4915.189, "timestamp": "01:21:55", "text": "そう、君がそこにいたとき、私が"}, {"type": "subtitle", "time": 4918.95, "timestamp": "01:21:58", "text": "ヴァレリンと対戦していた時、0 9からスタートした。"}]
[{"type": "subtitle", "time": 5460.99, "timestamp": "01:31:00", "text": "私もそう願ってください。感謝"}, {"type": "subtitle", "time": 5464.59, "timestamp": "01:31:04", "text": "あなたもカイも願っていました"}, {"type": "subtitle", "time": 5466.43, "timestamp": "01:31:06", "text": "感謝の後"}, {"type": "subtitle", "time": 5469.91, "timestamp": "01:31:09", "text": "あなたにもメリークリスマス"}, {"type": "subtitle", "time": 5471.43, "timestamp": "01:31:11", "text": "良い。"}, {"type": "subtitle", "time": 5474.95, "timestamp": "01:31:14", "text": "良い一日をお過ごしください。えっと、私は"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "夜は眠る必要があるから、夜はゆっくり休む必要がある。あなたはそうしました"}, {"type": "subtitle", "time": 5481.99, "timestamp": "01:31:21", "text": "私の理解が正しければ、ストリームは正しいはずです。待って、"}, {"type": "subtitle", "time": 5483.629, "timestamp": "01:31:23", "text": "ストリーミング"}, {"type": "subtitle", "time": 5486.55, "timestamp": "01:31:26", "text": "今日？ポータルがストリーミング配信されたのを覚えている"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "誰が配信していたのか忘れてしまった。ルミナスだったのか"}, {"type": "subtitle", "time": 5492.31, "timestamp": "01:31:32", "text": "それともルチだったかな？ええ、二人とも"}, {"type": "subtitle", "time": 5496.629, "timestamp": "01:31:36", "text": "もちろんストリーミング配信です。はい。うん。来て"}, {"type": "subtitle", "time": 5500.51, "timestamp": "01:31:40", "text": "明日はメリークリスマス。良い一日をお過ごしください"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "先に。あなたもまた、勤勉な猟師ですね。"}, {"type": "subtitle", "time": 5506.79, "timestamp": "01:31:46", "text": "誰もが勤勉な闘牛士です"}, {"type": "subtitle", "time": 5508.75, "timestamp": "01:31:48", "text": "私の言う通りです。うん、"}, {"type": "subtitle", "time": 5511.75, "timestamp": "01:31:51", "text": "みんな。ママの頭。うん、君は"}, {"type": "subtitle", "time": 5514.149, "timestamp": "01:31:54", "text": "向かった。ええ、私は"}, {"type": "subtitle", "time": 5516.11, "timestamp": "01:31:56", "text": "飛行モジュール"}]
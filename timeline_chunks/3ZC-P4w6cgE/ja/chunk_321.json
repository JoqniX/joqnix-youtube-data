[{"type": "subtitle", "time": 19261.91, "timestamp": "05:21:01", "text": "それ？上からか下からか"}, {"type": "subtitle", "time": 19267.35, "timestamp": "05:21:07", "text": "ええ、そうですね。所有。いい感じですね。どのように"}, {"type": "subtitle", "time": 19269.47, "timestamp": "05:21:09", "text": "行ってたの？私は元気でした。私は"}, {"type": "subtitle", "time": 19272.868, "timestamp": "05:21:12", "text": "良い。私が"}, {"type": "subtitle", "time": 19275.35, "timestamp": "05:21:15", "text": "壊す。戻って来られて本当に嬉しいです。"}, {"type": "subtitle", "time": 19276.83, "timestamp": "05:21:16", "text": "私は自分の"}, {"type": "subtitle", "time": 19279.788, "timestamp": "05:21:19", "text": "明らかにする。これは秘密の発表だった。"}, {"type": "subtitle", "time": 19287.67, "timestamp": "05:21:27", "text": "そこで、皆さんに感謝の気持ちを伝えたいと思いました。"}, {"type": "subtitle", "time": 19289.83, "timestamp": "05:21:29", "text": "あなたが私にしてくれたこと。本当に"}, {"type": "subtitle", "time": 19292.868, "timestamp": "05:21:32", "text": "とても意味があります。君たちは本当に私の"}, {"type": "subtitle", "time": 19295.51, "timestamp": "05:21:35", "text": "第二の家族。感謝してもしきれません。"}, {"type": "subtitle", "time": 19298.51, "timestamp": "05:21:38", "text": "あなたは本当に素晴らしい。"}, {"type": "subtitle", "time": 19301.31, "timestamp": "05:21:41", "text": "おお。ああ神様、"}, {"type": "subtitle", "time": 19305.35, "timestamp": "05:21:45", "text": "バカ。バカバカバカバカバカ。"}, {"type": "subtitle", "time": 19315.23, "timestamp": "05:21:55", "text": "に。私は言いたい"}, {"type": "subtitle", "time": 19319.11, "timestamp": "05:21:59", "text": "実際、あなたはとてもかわいいし"}]
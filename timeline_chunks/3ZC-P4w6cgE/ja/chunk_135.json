[{"type": "subtitle", "time": 8100.87, "timestamp": "02:15:00", "text": "わあ、それは興味深いですね。"}, {"type": "subtitle", "time": 8104.109, "timestamp": "02:15:04", "text": "なんてこった。"}, {"type": "subtitle", "time": 8107.629, "timestamp": "02:15:07", "text": "うん。だから、私はこう思う"}, {"type": "subtitle", "time": 8113.47, "timestamp": "02:15:13", "text": "ささやきとストリーミング、またはASMRストリーミングのいずれか"}, {"type": "subtitle", "time": 8117.109, "timestamp": "02:15:17", "text": "あるいは、えっと"}, {"type": "subtitle", "time": 8119.75, "timestamp": "02:15:19", "text": "それは何と呼ばれますか？うん。どうぞ。行く"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "先に。どうぞお進みください。今、私は"}, {"type": "subtitle", "time": 8122.669, "timestamp": "02:15:22", "text": "疑問に思う"}, {"type": "subtitle", "time": 8125.03, "timestamp": "02:15:25", "text": "どれくらい滞在しなければならないか"}, {"type": "subtitle", "time": 8127.109, "timestamp": "02:15:27", "text": "あの部屋？"}, {"type": "subtitle", "time": 8129.589, "timestamp": "02:15:29", "text": "えっと、6時以降はいつでも引っ越せるよ"}, {"type": "subtitle", "time": 8131.99, "timestamp": "02:15:31", "text": "数ヶ月。最初に6分の料金を支払わなければならない"}, {"type": "subtitle", "time": 8134.149, "timestamp": "02:15:34", "text": "数ヶ月。"}, {"type": "subtitle", "time": 8139.83, "timestamp": "02:15:39", "text": "そうそう。うん。それから、えーと、6か月後"}, {"type": "subtitle", "time": 8142.39, "timestamp": "02:15:42", "text": "もし私がそこに留まるか、"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "もっと良い物件が見つかれば、引っ越すこともできる"}, {"type": "subtitle", "time": 8154.79, "timestamp": "02:15:54", "text": "私も新しい住まいを探しているんです。"}, {"type": "subtitle", "time": 8157.27, "timestamp": "02:15:57", "text": "それもきっと楽しいでしょうね。だけでなく、"}, {"type": "subtitle", "time": 8159.109, "timestamp": "02:15:59", "text": "ええ、家賃とか全部です。私はしなければならない"}]
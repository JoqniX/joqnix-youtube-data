[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "わかった。ここにはない。"}, {"type": "subtitle", "time": 10146.23, "timestamp": "02:49:06", "text": "うん。どこはどこですか"}, {"type": "subtitle", "time": 10148.79, "timestamp": "02:49:08", "text": "はい、私たちは探しています"}, {"type": "subtitle", "time": 10165.03, "timestamp": "02:49:25", "text": "おお。私は鍵を持っています。私たちはできる、ああ、"}, {"type": "subtitle", "time": 10168.23, "timestamp": "02:49:28", "text": "それは、私たちはそれを使用できる。それが理由です"}, {"type": "subtitle", "time": 10174.15, "timestamp": "02:49:34", "text": "私はそれを保存しておきたいのです。わかった。"}, {"type": "subtitle", "time": 10196.15, "timestamp": "02:49:56", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 10197.99, "timestamp": "02:49:57", "text": "どうしたの？"}]
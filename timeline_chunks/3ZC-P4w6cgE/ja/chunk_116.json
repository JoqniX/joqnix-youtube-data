[{"type": "subtitle", "time": 6964.07, "timestamp": "01:56:04", "text": "こんにちは、こんにちは、こんにちは。久しぶりですね、"}, {"type": "subtitle", "time": 6967.03, "timestamp": "01:56:07", "text": "考えてみて、えっと、私が配信を始めてから。つまり、"}, {"type": "subtitle", "time": 6968.87, "timestamp": "01:56:08", "text": "それほど長い時間ではない。私はそうしなかったと思う"}, {"type": "subtitle", "time": 6971.43, "timestamp": "01:56:11", "text": "数日間配信するけど、まあね。調子はどうですか？"}, {"type": "subtitle", "time": 6973.91, "timestamp": "01:56:13", "text": "みんなやってる？皆さん、お元気ですか？"}, {"type": "subtitle", "time": 6977.87, "timestamp": "01:56:17", "text": "今晩？それはもうすぐ"}, {"type": "subtitle", "time": 6980.43, "timestamp": "01:56:20", "text": "夜中。夜だ。"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "うん。そうそう。皆さんが元気でいることを願っています"}, {"type": "subtitle", "time": 6986.39, "timestamp": "01:56:26", "text": "良い。こんにちは。こんにちは。こんにちは。うん。こんにちは。"}, {"type": "subtitle", "time": 6991.27, "timestamp": "01:56:31", "text": "落とす。うん。こんにちは。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 6993.91, "timestamp": "01:56:33", "text": "皆さん、はじめまして。久しぶりですね"}, {"type": "subtitle", "time": 6996.03, "timestamp": "01:56:36", "text": "私が見たものを皆さんに知らせます"}, {"type": "subtitle", "time": 6998.669, "timestamp": "01:56:38", "text": "新しい。"}, {"type": "subtitle", "time": 7001.75, "timestamp": "01:56:41", "text": "こんにちは。でも、みんなに会えなくて寂しかった。見逃した"}, {"type": "subtitle", "time": 7006.109, "timestamp": "01:56:46", "text": "みんな。皆さんお元気ですか？"}, {"type": "subtitle", "time": 7009.27, "timestamp": "01:56:49", "text": "何をしているの？そう、今日は"}, {"type": "subtitle", "time": 7012.43, "timestamp": "01:56:52", "text": "ゲームをプレイしている"}, {"type": "subtitle", "time": 7015.43, "timestamp": "01:56:55", "text": "アイドルゲーム。クリック音のようなアイドリング音"}, {"type": "subtitle", "time": 7018.91, "timestamp": "01:56:58", "text": "ある種のゲーム。ええ、そうですね。"}]
[{"type": "subtitle", "time": 8041.43, "timestamp": "02:14:01", "text": "話をしたり、その他いろいろ。"}, {"type": "subtitle", "time": 8044.709, "timestamp": "02:14:04", "text": "うん。ええ、ええ、つまり、いいえ、私はできます"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "長い休止期間のようなものだと考えてください"}, {"type": "subtitle", "time": 8049.27, "timestamp": "02:14:09", "text": "間もなく最後のストリームがいくつか配信される"}, {"type": "subtitle", "time": 8053.03, "timestamp": "02:14:13", "text": "休止期間を経て、新しい"}, {"type": "subtitle", "time": 8055.589, "timestamp": "02:14:15", "text": "えっと、デザインかな。私は何も知らない"}, {"type": "subtitle", "time": 8057.109, "timestamp": "02:14:17", "text": "新しい"}, {"type": "subtitle", "time": 8059.229, "timestamp": "02:14:19", "text": "まあ、そうですね。それで"}, {"type": "subtitle", "time": 8063.109, "timestamp": "02:14:23", "text": "私は大丈夫だけど、"}, {"type": "subtitle", "time": 8065.31, "timestamp": "02:14:25", "text": "ノートパソコンは"}, {"type": "subtitle", "time": 8068.95, "timestamp": "02:14:28", "text": "そこには。それを買ってから見なければならない"}, {"type": "subtitle", "time": 8072.069, "timestamp": "02:14:32", "text": "状況は私が聞いたところによると"}, {"type": "subtitle", "time": 8075.91, "timestamp": "02:14:35", "text": "できない、たくさんあります"}, {"type": "subtitle", "time": 8077.91, "timestamp": "02:14:37", "text": "学生たちが行ったように、"}, {"type": "subtitle", "time": 8080.39, "timestamp": "02:14:40", "text": "4月入学の彼らは、"}, {"type": "subtitle", "time": 8082.95, "timestamp": "02:14:42", "text": "電話する、電話を使う、電話する"}, {"type": "subtitle", "time": 8085.43, "timestamp": "02:14:45", "text": "騒音のため、家族は部屋から出て行った"}, {"type": "subtitle", "time": 8087.51, "timestamp": "02:14:47", "text": "苦情は狂っていて、"}, {"type": "subtitle", "time": 8090.99, "timestamp": "02:14:50", "text": "他の部屋も全て。ああ、神様。おお"}, {"type": "subtitle", "time": 8095.47, "timestamp": "02:14:55", "text": "いいえ。とても小さな部屋だ。おお"}, {"type": "subtitle", "time": 8097.87, "timestamp": "02:14:57", "text": "うん。だから私はこう思う"}]
[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "アニメのヴィックと遊んでいる。"}, {"type": "subtitle", "time": 7504.87, "timestamp": "02:05:04", "text": "彼は私の良い友人であり、"}, {"type": "subtitle", "time": 7508.87, "timestamp": "02:05:08", "text": "イマンは両方とも欲しかった"}, {"type": "subtitle", "time": 7511.03, "timestamp": "02:05:11", "text": "そしてアニメベック"}, {"type": "subtitle", "time": 7513.669, "timestamp": "02:05:13", "text": "えっと、ここでいい時間を過ごしましょう"}, {"type": "subtitle", "time": 7516.79, "timestamp": "02:05:16", "text": "今日。そうですね、私たちはそこにいます"}, {"type": "subtitle", "time": 7520.629, "timestamp": "02:05:20", "text": "えーっと、せいぜい1時間くらいかな、だって彼は"}, {"type": "subtitle", "time": 7523.03, "timestamp": "02:05:23", "text": "試験とか色々あって忙しい。そうなんです、"}, {"type": "subtitle", "time": 7525.109, "timestamp": "02:05:25", "text": "そういうこともある。夜には、"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "実際にマインクラフトをプレイするか、ワットをプレイする"}, {"type": "subtitle", "time": 7531.43, "timestamp": "02:05:31", "text": "雷。ヴェンダー関連のことをしなければならないので"}, {"type": "subtitle", "time": 7534.47, "timestamp": "02:05:34", "text": "そして私はそれに対してお金を払ったので、"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "実際に時間をかけて取り組んだ。"}, {"type": "subtitle", "time": 7539.629, "timestamp": "02:05:39", "text": "だから、"}, {"type": "subtitle", "time": 7542.03, "timestamp": "02:05:42", "text": "それ。"}, {"type": "subtitle", "time": 7544.629, "timestamp": "02:05:44", "text": "うん。こんにちは。もう一度確認させてください"}, {"type": "subtitle", "time": 7547.47, "timestamp": "02:05:47", "text": "私の"}, {"type": "subtitle", "time": 7549.83, "timestamp": "02:05:49", "text": "終わり。カテゴリを変更して"}, {"type": "subtitle", "time": 7551.669, "timestamp": "02:05:51", "text": "すべて。"}, {"type": "subtitle", "time": 7558.03, "timestamp": "02:05:58", "text": "人間は順調だ。"}]
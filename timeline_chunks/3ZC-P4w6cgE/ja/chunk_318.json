[{"type": "subtitle", "time": 19106.35, "timestamp": "05:18:26", "text": "H. オー、"}, {"type": "subtitle", "time": 19109.23, "timestamp": "05:18:29", "text": "待って。わかった。私は選べない"}, {"type": "subtitle", "time": 19112.43, "timestamp": "05:18:32", "text": "1つ。ただ"}, {"type": "subtitle", "time": 19126.07, "timestamp": "05:18:46", "text": "ママ。待って、君は彼女に壁を送ったわけじゃないよね？"}, {"type": "subtitle", "time": 19129.51, "timestamp": "05:18:49", "text": "テキストの？待って、私、やったわ。"}]
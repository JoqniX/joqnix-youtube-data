[{"type": "subtitle", "time": 11461.15, "timestamp": "03:11:01", "text": "オフ。ちらつく。"}, {"type": "subtitle", "time": 11463.75, "timestamp": "03:11:03", "text": "うんうん。あの男。ちらつきは"}, {"type": "subtitle", "time": 11466.15, "timestamp": "03:11:06", "text": "何かが起こる前兆のように。後"}, {"type": "subtitle", "time": 11468.95, "timestamp": "03:11:08", "text": "さあ、待っていてください。音は"}, {"type": "subtitle", "time": 11470.55, "timestamp": "03:11:10", "text": "確認のようなものだ。たぶん"}, {"type": "subtitle", "time": 11484.75, "timestamp": "03:11:24", "text": "わかった。そのスイッチはどこで切り替わったのか"}, {"type": "subtitle", "time": 11494.15, "timestamp": "03:11:34", "text": "右。ああ、シフトキーを押し続けることに慣れすぎてしまった"}, {"type": "subtitle", "time": 11496.55, "timestamp": "03:11:36", "text": "スプリントする。くそ。毎回全力疾走するたびに、"}, {"type": "subtitle", "time": 11509.73, "timestamp": "03:11:49", "text": "60"}, {"type": "subtitle", "time": 11512.349, "timestamp": "03:11:52", "text": "[音楽]"}]
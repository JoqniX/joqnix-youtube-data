[{"type": "subtitle", "time": 14341.03, "timestamp": "03:59:01", "text": "おい、あれは楽しかったよ。モーさん、ありがとう。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "ドの弾き方を教えてくれる。"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "問題ない。うん。問題ない。モ、"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "とても楽しかった。"}, {"type": "subtitle", "time": 14355.03, "timestamp": "03:59:15", "text": "それもかなり楽しかった。うん。うん。"}, {"type": "subtitle", "time": 14358.309, "timestamp": "03:59:18", "text": "でも、あなたの方で頑張ってくださいね。"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "多分、もっと一緒に時間を過ごすべきだろう。"}, {"type": "subtitle", "time": 14366.229, "timestamp": "03:59:26", "text": "はい。ああ、もちろんだよ。うん。うん。うん。私"}, {"type": "subtitle", "time": 14368.389, "timestamp": "03:59:28", "text": "将来、タイムゾーンが変わっても"}, {"type": "subtitle", "time": 14371.429, "timestamp": "03:59:31", "text": "それは問題なので、ただ一緒に時間を過ごすことにします。"}, {"type": "subtitle", "time": 14373.99, "timestamp": "03:59:33", "text": "よし。問題ない。うん。うん。うん。"}, {"type": "subtitle", "time": 14377.95, "timestamp": "03:59:37", "text": "まあ、そうですね。了解。よし。取る"}, {"type": "subtitle", "time": 14381.189, "timestamp": "03:59:41", "text": "気をつけて、気をつけて。バイバイ。気をつけて"}, {"type": "subtitle", "time": 14384.95, "timestamp": "03:59:44", "text": "チャットもしてください、さもなければさようなら。また、あなたが"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "退出する、何かお知らせはありますか？"}, {"type": "subtitle", "time": 14390.55, "timestamp": "03:59:50", "text": "作りたいですか？あらら。そして私は"}, {"type": "subtitle", "time": 14392.71, "timestamp": "03:59:52", "text": "ストリーミング配信は、たぶん30分後くらいだと思う。"}, {"type": "subtitle", "time": 14394.79, "timestamp": "03:59:54", "text": "えっと、月曜日は音楽の時間です。だから、おそらくただ"}, {"type": "subtitle", "time": 14399.429, "timestamp": "03:59:59", "text": "音楽を作っているよ、うん。うん。待って。"}]
[{"type": "subtitle", "time": 4620.63, "timestamp": "01:17:00", "text": "チャネル。楽しんでいただけたでしょうか。そして、メリークリスマス！"}, {"type": "subtitle", "time": 4624.47, "timestamp": "01:17:04", "text": "あなたにもクリスマスを。"}, {"type": "subtitle", "time": 4633.99, "timestamp": "01:17:13", "text": "次に、そして、もしあなたが"}, {"type": "subtitle", "time": 4637.03, "timestamp": "01:17:17", "text": "次回はぜひお越しください。"}, {"type": "subtitle", "time": 4638.95, "timestamp": "01:17:18", "text": "もっと話して、あなたと交流できるように"}, {"type": "subtitle", "time": 4647.31, "timestamp": "01:17:27", "text": "知る"}, {"type": "subtitle", "time": 4651.27, "timestamp": "01:17:31", "text": "パパ、来てくれてありがとう。楽しんでいただけたでしょうか"}, {"type": "subtitle", "time": 4654.63, "timestamp": "01:17:34", "text": "楽しい。パパ、お祝いしてくれてありがとう"}, {"type": "subtitle", "time": 4658.31, "timestamp": "01:17:38", "text": "午前0時ちょうどにメリークリスマス"}, {"type": "subtitle", "time": 4661.35, "timestamp": "01:17:41", "text": "サーバー上でもチャットでも。ありがとう。"}, {"type": "subtitle", "time": 4663.709, "timestamp": "01:17:43", "text": "メリークリスマス"}, {"type": "subtitle", "time": 4666.79, "timestamp": "01:17:46", "text": "良い。また、楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 4670.07, "timestamp": "01:17:50", "text": "あなたがクシュマス（クリスマス）のために購入したゲーム。えっと、もし"}, {"type": "subtitle", "time": 4672.31, "timestamp": "01:17:52", "text": "私たちには共通点が何もない、一緒に遊べる"}]
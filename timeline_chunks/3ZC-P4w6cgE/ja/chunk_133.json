[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "何か新しい情報があれば教えてください。状況は"}, {"type": "subtitle", "time": 7989.189, "timestamp": "02:13:09", "text": "えっと、私にはわからないんだけど、ただ"}, {"type": "subtitle", "time": 7992.47, "timestamp": "02:13:12", "text": "そう、7月に日本に行くんだ。"}, {"type": "subtitle", "time": 7996.149, "timestamp": "02:13:16", "text": "B 私はそこにいるし、終わらせなければならない"}, {"type": "subtitle", "time": 7999.27, "timestamp": "02:13:19", "text": "いくつかコラボレーションとか。私はそれをそうは呼ばない"}, {"type": "subtitle", "time": 8001.35, "timestamp": "02:13:21", "text": "コラボレーション。どちらかというと、たまり場みたいな感じですね。いいえ"}, {"type": "subtitle", "time": 8003.189, "timestamp": "02:13:23", "text": "のように"}, {"type": "subtitle", "time": 8005.75, "timestamp": "02:13:25", "text": "出会った人たちとただぶらぶらしているだけ"}, {"type": "subtitle", "time": 8008.87, "timestamp": "02:13:28", "text": "長年にわたって話し合い、"}, {"type": "subtitle", "time": 8011.35, "timestamp": "02:13:31", "text": "彼らにいろいろ話してあげて。ええ、それもありますね。それ"}, {"type": "subtitle", "time": 8013.43, "timestamp": "02:13:33", "text": "はい。うん。それはある意味"}, {"type": "subtitle", "time": 8015.589, "timestamp": "02:13:35", "text": "面白い。つまり、想像しているんだけど"}, {"type": "subtitle", "time": 8016.87, "timestamp": "02:13:36", "text": "これらはあなたのものになるでしょう"}, {"type": "subtitle", "time": 8019.47, "timestamp": "02:13:39", "text": "ストリーミング配信の最終日。そうなんですか？私はしません"}, {"type": "subtitle", "time": 8023.83, "timestamp": "02:13:43", "text": "知る。私はそうは思わないけれど、"}, {"type": "subtitle", "time": 8025.669, "timestamp": "02:13:45", "text": "これから何が起こるか、全く分からない。だから私は"}, {"type": "subtitle", "time": 8028.629, "timestamp": "02:13:48", "text": "こうやって安全に保管しておくのがいいでしょう。だから私は"}, {"type": "subtitle", "time": 8032.229, "timestamp": "02:13:52", "text": "少なくとも今は幸せでいられる。うん。"}, {"type": "subtitle", "time": 8035.51, "timestamp": "02:13:55", "text": "今月配信されたものと、"}, {"type": "subtitle", "time": 8037.99, "timestamp": "02:13:57", "text": "うん、好きな人たちと遊んだよ"}]
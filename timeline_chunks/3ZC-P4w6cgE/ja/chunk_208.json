[{"type": "subtitle", "time": 12481.59, "timestamp": "03:28:01", "text": "これです。"}, {"type": "subtitle", "time": 12485.19, "timestamp": "03:28:05", "text": "ピーク。壁の後ろに隠れる。うん。のように"}, {"type": "subtitle", "time": 12487.11, "timestamp": "03:28:07", "text": "この男を見かけたら、"}, {"type": "subtitle", "time": 12488.99, "timestamp": "03:28:08", "text": "彼の進路から外れるための障害物"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "視力。もう片方は抱きしめなければならない"}, {"type": "subtitle", "time": 12497.11, "timestamp": "03:28:17", "text": "壁にもたれかかっているとき、あるいはあなたがそう思うとき、私は"}, {"type": "subtitle", "time": 12498.79, "timestamp": "03:28:18", "text": "どれだったか忘れてしまった。私は白だと思う"}, {"type": "subtitle", "time": 12501.03, "timestamp": "03:28:21", "text": "フラッシュ。もう片方はどんな感じか知ってるよね"}, {"type": "subtitle", "time": 12504.15, "timestamp": "03:28:24", "text": "ピンク色のフラッシュのような静電気？うん。"}, {"type": "subtitle", "time": 12505.83, "timestamp": "03:28:25", "text": "これは白っぽいですね。その時は"}, {"type": "subtitle", "time": 12507.59, "timestamp": "03:28:27", "text": "抱きしめるようなものから身を隠さなければならない"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "壁にもたれて。突然現れる"}, {"type": "subtitle", "time": 12511.75, "timestamp": "03:28:31", "text": "素早く。だからすぐに抱きしめてください"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "壁の側面から流れ込み、"}, {"type": "subtitle", "time": 12520.79, "timestamp": "03:28:40", "text": "ああ、そう、ライトを持ち続けて。あなたはそうするかもしれない"}, {"type": "subtitle", "time": 12522.71, "timestamp": "03:28:42", "text": "2番目のボタンを握らないと迷子になる"}, {"type": "subtitle", "time": 12531.71, "timestamp": "03:28:51", "text": "わかった。わかった。"}]
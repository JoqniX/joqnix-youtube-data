[{"type": "subtitle", "time": 3722.309, "timestamp": "01:02:02", "text": "再装填中。"}, {"type": "subtitle", "time": 3732.95, "timestamp": "01:02:12", "text": "水？ダッシュしていた男は誰だった？は"}, {"type": "subtitle", "time": 3741.03, "timestamp": "01:02:21", "text": "スパイクが植えられました。"}, {"type": "subtitle", "time": 3752.71, "timestamp": "01:02:32", "text": "来るよ。彼が来る。"}, {"type": "subtitle", "time": 3754.63, "timestamp": "01:02:34", "text": "手榴弾。"}, {"type": "subtitle", "time": 3761.52, "timestamp": "01:02:41", "text": "1つお願いします。"}, {"type": "subtitle", "time": 3763.349, "timestamp": "01:02:43", "text": "[拍手]"}, {"type": "subtitle", "time": 3765.91, "timestamp": "01:02:45", "text": "いいえ、私のことを書かないでください。"}, {"type": "subtitle", "time": 3778.47, "timestamp": "01:02:58", "text": "敵はあと一体。彼は"}]
[{"type": "subtitle", "time": 11402.83, "timestamp": "03:10:02", "text": "ニース。くそ、保存しておくべきだった"}, {"type": "subtitle", "time": 11405.21, "timestamp": "03:10:05", "text": "それ。ねえ、お金を貯めなきゃ。"}, {"type": "subtitle", "time": 11407.87, "timestamp": "03:10:07", "text": "[音楽]"}, {"type": "subtitle", "time": 11410.429, "timestamp": "03:10:10", "text": "くそ。"}, {"type": "subtitle", "time": 11418.8, "timestamp": "03:10:18", "text": "56 57。"}, {"type": "subtitle", "time": 11421.95, "timestamp": "03:10:21", "text": "[拍手]"}, {"type": "subtitle", "time": 11425.349, "timestamp": "03:10:25", "text": "ああ、それは怪物だ。"}, {"type": "subtitle", "time": 11447.07, "timestamp": "03:10:47", "text": "さあ行こう。"}, {"type": "subtitle", "time": 11451.51, "timestamp": "03:10:51", "text": "わかった。暗い話だ。わかった。"}, {"type": "subtitle", "time": 11455.83, "timestamp": "03:10:55", "text": "ああ、そうやってやるんですね。わかった。うんうん。"}, {"type": "subtitle", "time": 11458.23, "timestamp": "03:10:58", "text": "明かりがついたらすぐ中に入る"}]
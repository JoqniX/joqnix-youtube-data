[{"type": "subtitle", "time": 12181.19, "timestamp": "03:23:01", "text": "ドア。そうそう。彼らはもっと良いものを提供するだろう"}, {"type": "subtitle", "time": 12184.03, "timestamp": "03:23:04", "text": "説明書。"}, {"type": "subtitle", "time": 12191.51, "timestamp": "03:23:11", "text": "うん。よし。さあ、これへ。あなたはしない"}, {"type": "subtitle", "time": 12193.19, "timestamp": "03:23:13", "text": "それぞれのドアを覚えておく必要がある。あなたもできる"}, {"type": "subtitle", "time": 12196.15, "timestamp": "03:23:16", "text": "ただ急いで通り抜けるだけ。ジャンプすることもできます"}, {"type": "subtitle", "time": 12215.349, "timestamp": "03:23:35", "text": "これは一体何ですか？ああ、わかりました。これは"}, {"type": "subtitle", "time": 12217.67, "timestamp": "03:23:37", "text": "えっと、結膜炎。ああ、これは大丈夫だ。分かりますか"}, {"type": "subtitle", "time": 12221.55, "timestamp": "03:23:41", "text": "あのフラッシュのこと？走る。走る。する"}, {"type": "subtitle", "time": 12224.469, "timestamp": "03:23:44", "text": "ああ、チャンスが訪れるかもしれない"}, {"type": "subtitle", "time": 12225.99, "timestamp": "03:23:45", "text": "うん。うん。この穴。この中に隠れてください"}, {"type": "subtitle", "time": 12228.79, "timestamp": "03:23:48", "text": "穴。このような穴を見つけたら"}, {"type": "subtitle", "time": 12230.63, "timestamp": "03:23:50", "text": "光の中で、あるいはここに留まって"}, {"type": "subtitle", "time": 12232.95, "timestamp": "03:23:52", "text": "その間。だから、もしあなたがこのような穴を見かけたら"}, {"type": "subtitle", "time": 12235.67, "timestamp": "03:23:55", "text": "同様のライトで、あなたをナビゲートします"}, {"type": "subtitle", "time": 12238.15, "timestamp": "03:23:58", "text": "それを避けるためにその穴に隠れる"}]
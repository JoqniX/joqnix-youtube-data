[{"type": "subtitle", "time": 1742.669, "timestamp": "00:29:02", "text": "私たちはゼロから勝利を掴みました"}, {"type": "subtitle", "time": 1745.75, "timestamp": "00:29:05", "text": "ゲーム。それは上昇気流と呼ばれるものだ"}, {"type": "subtitle", "time": 1748.19, "timestamp": "00:29:08", "text": "ゼロから"}, {"type": "subtitle", "time": 1751.43, "timestamp": "00:29:11", "text": "ヒーローとか、そんな感じのやつ。チームワークとは"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "夢の仕事だったと言えるでしょう。"}, {"type": "subtitle", "time": 1758.59, "timestamp": "00:29:18", "text": "ええ、私がMVPです。おお。"}, {"type": "subtitle", "time": 1760.99, "timestamp": "00:29:20", "text": "さようなら。とても"}, {"type": "subtitle", "time": 1770.19, "timestamp": "00:29:30", "text": "ない。ああ、ラダイトを手に入れた"}, {"type": "subtitle", "time": 1773.789, "timestamp": "00:29:33", "text": "ポイントとティア4"}, {"type": "subtitle", "time": 1795.43, "timestamp": "00:29:55", "text": "そろそろ締めくくろうと思っていた。それはある意味"}, {"type": "subtitle", "time": 1796.909, "timestamp": "00:29:56", "text": "遅い、"}, {"type": "subtitle", "time": 1799.669, "timestamp": "00:29:59", "text": "右？もう一杯飲んでもいいですか？ 1つか2つ"}]
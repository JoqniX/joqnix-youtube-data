[{"type": "subtitle", "time": 14661.07, "timestamp": "04:04:21", "text": "ジョー"}, {"type": "subtitle", "time": 14666.469, "timestamp": "04:04:26", "text": "そして、もし興味があれば教えてください"}, {"type": "subtitle", "time": 14669.03, "timestamp": "04:04:29", "text": "知る"}, {"type": "subtitle", "time": 14673.389, "timestamp": "04:04:33", "text": "タイミングですね。あなたの"}, {"type": "subtitle", "time": 14679.55, "timestamp": "04:04:39", "text": "それ"}, {"type": "subtitle", "time": 14685.87, "timestamp": "04:04:45", "text": "[音楽]"}, {"type": "subtitle", "time": 14697.349, "timestamp": "04:04:57", "text": "アカウント。わかった。私はバムを手に入れたかったのですが、"}]
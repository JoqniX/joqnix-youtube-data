[{"type": "subtitle", "time": 18660.27, "timestamp": "05:11:00", "text": "こんにちは。そして皆さんのほとんどは彼女を"}, {"type": "subtitle", "time": 18670.628, "timestamp": "05:11:10", "text": "えっと、彼女は私を助​​けてくれた"}, {"type": "subtitle", "time": 18674.15, "timestamp": "05:11:14", "text": "えっと、彼女はデザインを手伝ってくれたんです。彼女は描いた"}, {"type": "subtitle", "time": 18676.35, "timestamp": "05:11:16", "text": "これは私のために描いてくれたものです"}, {"type": "subtitle", "time": 18680.07, "timestamp": "05:11:20", "text": "実は。そして私はとても、ええと、私は"}, {"type": "subtitle", "time": 18682.628, "timestamp": "05:11:22", "text": "必要なデザインが分からなくてイライラする"}, {"type": "subtitle", "time": 18685.91, "timestamp": "05:11:25", "text": "私が具体的に何を望んでいたかなど"}, {"type": "subtitle", "time": 18688.948, "timestamp": "05:11:28", "text": "などなど。私はとても心配で混乱していました。"}, {"type": "subtitle", "time": 18691.51, "timestamp": "05:11:31", "text": "どうしよう、どうしよう。実際には"}, {"type": "subtitle", "time": 18693.708, "timestamp": "05:11:33", "text": "それについて考えたりしたんだけど、"}, {"type": "subtitle", "time": 18696.868, "timestamp": "05:11:36", "text": "でも、私は自分のための時間も取った。そして彼女も"}, {"type": "subtitle", "time": 18698.35, "timestamp": "05:11:38", "text": "私を助けてくれた"}, {"type": "subtitle", "time": 18701.99, "timestamp": "05:11:41", "text": "多く。彼女は私をとても助けてくれた。つまり、彼女は"}, {"type": "subtitle", "time": 18706.07, "timestamp": "05:11:46", "text": "私にとってとても役立ちました"}, {"type": "subtitle", "time": 18708.31, "timestamp": "05:11:48", "text": "えーと、私が"}, {"type": "subtitle", "time": 18712.47, "timestamp": "05:11:52", "text": "気に入ったデザインです。彼女はとても親切だった"}, {"type": "subtitle", "time": 18716.628, "timestamp": "05:11:56", "text": "実に甘くて十分だ。"}, {"type": "subtitle", "time": 18718.43, "timestamp": "05:11:58", "text": "私を助けて"}]
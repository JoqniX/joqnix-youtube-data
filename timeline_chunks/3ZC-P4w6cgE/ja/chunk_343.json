[{"type": "subtitle", "time": 20587.628, "timestamp": "05:43:07", "text": "1つ"}, {"type": "subtitle", "time": 20600.948, "timestamp": "05:43:20", "text": "こんにちは。えっと、私は、私が着ているものが大好きなんです"}, {"type": "subtitle", "time": 20602.75, "timestamp": "05:43:22", "text": "丸い"}, {"type": "subtitle", "time": 20606.07, "timestamp": "05:43:26", "text": "眼鏡。丸眼鏡。だから私は"}, {"type": "subtitle", "time": 20610.83, "timestamp": "05:43:30", "text": "丸いメガネを私にあげたかった"}, {"type": "subtitle", "time": 20615.628, "timestamp": "05:43:35", "text": "だって、丸いガラスのギャングってすごくクールだから"}, {"type": "subtitle", "time": 20620.51, "timestamp": "05:43:40", "text": "そして、人気者グループの一人。うん。"}, {"type": "subtitle", "time": 20622.91, "timestamp": "05:43:42", "text": "うん。こんにちは。それで"}, {"type": "subtitle", "time": 20626.39, "timestamp": "05:43:46", "text": "ええ、私は具体的に伝えたつもりでした"}, {"type": "subtitle", "time": 20629.07, "timestamp": "05:43:49", "text": "ズチ・ママ"}, {"type": "subtitle", "time": 20637.51, "timestamp": "05:43:57", "text": "こんにちは。これが私が持っているエアリングです。"}]
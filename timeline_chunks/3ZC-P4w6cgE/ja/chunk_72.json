[{"type": "subtitle", "time": 4321.75, "timestamp": "01:12:01", "text": "来週か来週。わかった。私は誓います"}, {"type": "subtitle", "time": 4324.87, "timestamp": "01:12:04", "text": "延期はしません。"}, {"type": "subtitle", "time": 4329.11, "timestamp": "01:12:09", "text": "ババ・ヤーガの歌を覚えるのが難しい。"}, {"type": "subtitle", "time": 4331.27, "timestamp": "01:12:11", "text": "それはとても難しくて、ペースが速い。でも、やってみます"}, {"type": "subtitle", "time": 4333.99, "timestamp": "01:12:13", "text": "私のベスト。こんにちは。"}, {"type": "subtitle", "time": 4336.229, "timestamp": "01:12:16", "text": "それもまた、私たちは持っています。"}, {"type": "subtitle", "time": 4339.59, "timestamp": "01:12:19", "text": "スケジュールを投稿する、前までに、または"}, {"type": "subtitle", "time": 4343.43, "timestamp": "01:12:23", "text": "YouTubeストリーム3の前または上で"}, {"type": "subtitle", "time": 4346.63, "timestamp": "01:12:26", "text": "午後というわけで、とりあえず今は寝ます。"}, {"type": "subtitle", "time": 4349.03, "timestamp": "01:12:29", "text": "スケジュールを調整してみるのもいいかもしれません。"}, {"type": "subtitle", "time": 4351.07, "timestamp": "01:12:31", "text": "そして睡眠"}, {"type": "subtitle", "time": 4355.55, "timestamp": "01:12:35", "text": "すぐ。こんにちは。皆さん楽しんでいただけたでしょうか？"}, {"type": "subtitle", "time": 4359.43, "timestamp": "01:12:39", "text": "そして、そう、今日私たちはノックしました"}, {"type": "subtitle", "time": 4361.43, "timestamp": "01:12:41", "text": "クリスマスグッズがたくさん入ったボード"}, {"type": "subtitle", "time": 4363.229, "timestamp": "01:12:43", "text": "の"}, {"type": "subtitle", "time": 4366.95, "timestamp": "01:12:46", "text": "始まり。でも、ええ、私たちは"}, {"type": "subtitle", "time": 4369.35, "timestamp": "01:12:49", "text": "明日も最適です。はい、そしてあなたは"}, {"type": "subtitle", "time": 4372.03, "timestamp": "01:12:52", "text": "君たちも"}, {"type": "subtitle", "time": 4374.87, "timestamp": "01:12:54", "text": "最高。全力を尽くしてください。そして、"}, {"type": "subtitle", "time": 4377.83, "timestamp": "01:12:57", "text": "本日伺います。それでは、すべて読み上げます"}]
[{"type": "subtitle", "time": 12680.269, "timestamp": "03:31:20", "text": "わかった。壁に寄りかかって"}, {"type": "subtitle", "time": 12700.469, "timestamp": "03:31:40", "text": "くそっ。はい、じゃあ私は行きます。に行こう"}, {"type": "subtitle", "time": 12702.63, "timestamp": "03:31:42", "text": "終わり。"}, {"type": "subtitle", "time": 12705.99, "timestamp": "03:31:45", "text": "しかし、あなたは亡くなった。うん。うん。あなたは"}, {"type": "subtitle", "time": 12707.03, "timestamp": "03:31:47", "text": "自分の。"}, {"type": "subtitle", "time": 12716.229, "timestamp": "03:31:56", "text": "どこ？ああ、あなたの後ろです。レベル。"}]
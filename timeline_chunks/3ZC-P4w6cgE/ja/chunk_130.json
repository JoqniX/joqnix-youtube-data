[{"type": "subtitle", "time": 7802.31, "timestamp": "02:10:02", "text": "スペイン人、ポーランド人、フランス人。"}, {"type": "subtitle", "time": 7806.55, "timestamp": "02:10:06", "text": "おお。うん。それはすごくクールですね。"}, {"type": "subtitle", "time": 7808.709, "timestamp": "02:10:08", "text": "うん。"}, {"type": "subtitle", "time": 7810.95, "timestamp": "02:10:10", "text": "私たちは独創的です。うん。うん。うん。真実、"}, {"type": "subtitle", "time": 7815.589, "timestamp": "02:10:15", "text": "確かに、確かに。独創。はい。うん。また、"}, {"type": "subtitle", "time": 7818.47, "timestamp": "02:10:18", "text": "今日は調子はどうですか？元気ですか？どうやって"}, {"type": "subtitle", "time": 7820.47, "timestamp": "02:10:20", "text": "行ったことがありますか？"}, {"type": "subtitle", "time": 7825.189, "timestamp": "02:10:25", "text": "私は大丈夫です。私の漫画制作は"}, {"type": "subtitle", "time": 7827.669, "timestamp": "02:10:27", "text": "めちゃくちゃ遅い。私はそれが好きではない。私"}, {"type": "subtitle", "time": 7831.03, "timestamp": "02:10:31", "text": "たぶん7個くらいあると思う"}, {"type": "subtitle", "time": 7835.35, "timestamp": "02:10:35", "text": "あと数ヶ月あるけど、悪くないね 7"}, {"type": "subtitle", "time": 7837.91, "timestamp": "02:10:37", "text": "月ですが、何ヶ月かを計算するようなものです"}, {"type": "subtitle", "time": 7839.99, "timestamp": "02:10:39", "text": "あまり考えていない章"}, {"type": "subtitle", "time": 7842.39, "timestamp": "02:10:42", "text": "今後の章"}, {"type": "subtitle", "time": 7844.31, "timestamp": "02:10:44", "text": "私自身、何が起こっているのか本当にわからない"}, {"type": "subtitle", "time": 7846.39, "timestamp": "02:10:46", "text": "メインパートの真ん中で起こること"}, {"type": "subtitle", "time": 7848.87, "timestamp": "02:10:48", "text": "物語の一部。つまり、"}, {"type": "subtitle", "time": 7853.03, "timestamp": "02:10:53", "text": "かなりストレスが溜まったり心配したりするけど、"}, {"type": "subtitle", "time": 7855.43, "timestamp": "02:10:55", "text": "物事がどうなるか見て、うまくいけば"}, {"type": "subtitle", "time": 7858.709, "timestamp": "02:10:58", "text": "2025年までに完成させる、大まかな草案。"}]
[{"type": "subtitle", "time": 10715.71, "timestamp": "02:58:35", "text": "ああ、これもトップにランクインしているようですね。"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "えっと、私たちは図書館にいます。えっと、私たちは"}, {"type": "subtitle", "time": 10727.15, "timestamp": "02:58:47", "text": "一種の、私はこうしなければならないと思う"}, {"type": "subtitle", "time": 10730.51, "timestamp": "02:58:50", "text": "パズルを解くように"}, {"type": "subtitle", "time": 10732.349, "timestamp": "02:58:52", "text": "パズル。"}, {"type": "subtitle", "time": 10736.389, "timestamp": "02:58:56", "text": "ええと、ちょっとこれらをチェックしてみましょう。しかし私たちは"}, {"type": "subtitle", "time": 10738.55, "timestamp": "02:58:58", "text": "そうあるべきではないと思う、僕たちが"}]
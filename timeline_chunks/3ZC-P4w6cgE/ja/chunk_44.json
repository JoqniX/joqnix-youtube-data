[{"type": "subtitle", "time": 2641.67, "timestamp": "00:44:01", "text": "私はたくさんのキルを獲得する必要があります。私"}, {"type": "subtitle", "time": 2645.109, "timestamp": "00:44:05", "text": "最高の姿を見せようとしても、このチームは"}, {"type": "subtitle", "time": 2648.55, "timestamp": "00:44:08", "text": "敵チームはかなり後ろ盾になっている。私はこう思う、"}, {"type": "subtitle", "time": 2651.829, "timestamp": "00:44:11", "text": "なぜ？敵はあと一体。おお。私は"}, {"type": "subtitle", "time": 2653.43, "timestamp": "00:44:13", "text": "絵画から離れて休憩する。から"}, {"type": "subtitle", "time": 2655.03, "timestamp": "00:44:15", "text": "絵を描いている間、何か食べようとしていた。"}, {"type": "subtitle", "time": 2688.79, "timestamp": "00:44:48", "text": "私は休憩を取っていました。はい。"}, {"type": "subtitle", "time": 2693.069, "timestamp": "00:44:53", "text": "そうそう。最初に私にくれたのは"}, {"type": "subtitle", "time": 2698.18, "timestamp": "00:44:58", "text": "家族からのクリスマスプレゼント。"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "[拍手]"}]
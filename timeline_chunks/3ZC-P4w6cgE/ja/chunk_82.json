[{"type": "subtitle", "time": 4923.189, "timestamp": "01:22:03", "text": "そして、レミーは"}, {"type": "subtitle", "time": 4928.39, "timestamp": "01:22:08", "text": "実際には、その試合は12点差で勝ちました。"}, {"type": "subtitle", "time": 4930.11, "timestamp": "01:22:10", "text": "うん、えっと"}, {"type": "subtitle", "time": 4932.59, "timestamp": "01:22:12", "text": "1312. いいえ、いいえ、"}, {"type": "subtitle", "time": 4935.03, "timestamp": "01:22:15", "text": "1212なんとか。ええ、その頃でした"}, {"type": "subtitle", "time": 4938.95, "timestamp": "01:22:18", "text": "マッチ。いや、いや、それはまるで最後の"}, {"type": "subtitle", "time": 4941.99, "timestamp": "01:22:21", "text": "あれのことですよね？えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "ええ、同じことに到達したら"}, {"type": "subtitle", "time": 4946.87, "timestamp": "01:22:26", "text": "もの。うん。つまり、我々はその試合に勝ったということだ。"}, {"type": "subtitle", "time": 4950.03, "timestamp": "01:22:30", "text": "どうにか。どういうわけかわかりませんが、"}, {"type": "subtitle", "time": 4953.27, "timestamp": "01:22:33", "text": "うん。それと、レミーが来てくれたお礼にもなったよ。"}, {"type": "subtitle", "time": 4955.75, "timestamp": "01:22:35", "text": "遠く離れたあなたにもメリークリスマス。願わくば"}, {"type": "subtitle", "time": 4956.669, "timestamp": "01:22:36", "text": "楽しむ"}, {"type": "subtitle", "time": 4959.55, "timestamp": "01:22:39", "text": "素敵な一日をお過ごしください。そしてメリークリスマス！"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "また。そして今日、エドワードがやって来た。"}, {"type": "subtitle", "time": 4967.51, "timestamp": "01:22:47", "text": "エドワードさん、来てくれてありがとう。願わくば"}, {"type": "subtitle", "time": 4970.39, "timestamp": "01:22:50", "text": "今日は楽しかった。いつもありがとうございます"}, {"type": "subtitle", "time": 4973.07, "timestamp": "01:22:53", "text": "見て、そこにいること"}]
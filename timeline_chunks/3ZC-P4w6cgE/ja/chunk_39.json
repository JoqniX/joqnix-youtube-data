[{"type": "subtitle", "time": 2341.23, "timestamp": "00:39:01", "text": "お母さん。おいしい。"}, {"type": "subtitle", "time": 2343.23, "timestamp": "00:39:03", "text": "下へ"}, {"type": "subtitle", "time": 2379.91, "timestamp": "00:39:39", "text": "低い、低い、低い。違反。低い。違反。低い。"}, {"type": "subtitle", "time": 2389.79, "timestamp": "00:39:49", "text": "取り戻す"}, {"type": "subtitle", "time": 2393.109, "timestamp": "00:39:53", "text": "ステップ。最後に残ったプレイヤー。何てことだ。"}, {"type": "subtitle", "time": 2399.43, "timestamp": "00:39:59", "text": "夜。わかった。"}]
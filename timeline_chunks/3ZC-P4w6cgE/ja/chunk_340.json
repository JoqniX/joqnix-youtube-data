[{"type": "subtitle", "time": 20402.31, "timestamp": "05:40:02", "text": "物語はまだ続くと思う。私はそうしましたか、私はそうしましたか"}, {"type": "subtitle", "time": 20405.11, "timestamp": "05:40:05", "text": "私の配信で言ってください？えっと、分かりません。"}, {"type": "subtitle", "time": 20409.51, "timestamp": "05:40:09", "text": "ええ、以前は、ええと、"}, {"type": "subtitle", "time": 20415.628, "timestamp": "05:40:15", "text": "学校では、"}, {"type": "subtitle", "time": 20419.75, "timestamp": "05:40:19", "text": "えっと、私はちょっと女の子っぽい見た目だから。私"}, {"type": "subtitle", "time": 20421.51, "timestamp": "05:40:21", "text": "わからないけど、先生と"}, {"type": "subtitle", "time": 20426.07, "timestamp": "05:40:26", "text": "強制的にメイシュになるような学生"}, {"type": "subtitle", "time": 20428.948, "timestamp": "05:40:28", "text": "なんて言うんだっけ？"}, {"type": "subtitle", "time": 20431.67, "timestamp": "05:40:31", "text": "女性。私は彼らがちょうどいい服装をしているのが好きです"}, {"type": "subtitle", "time": 20434.19, "timestamp": "05:40:34", "text": "役を任せてください"}, {"type": "subtitle", "time": 20439.39, "timestamp": "05:40:39", "text": "遊ぶ。実際、それは中心的な"}, {"type": "subtitle", "time": 20452.67, "timestamp": "05:40:52", "text": "ああ。おお、"}, {"type": "subtitle", "time": 20456.868, "timestamp": "05:40:56", "text": "神。ええ、そうですね。彼らは本当に良い"}]
[{"type": "subtitle", "time": 16920.15, "timestamp": "04:42:00", "text": "ロク。私の息子"}, {"type": "subtitle", "time": 16932.77, "timestamp": "04:42:12", "text": "ロク。"}, {"type": "subtitle", "time": 16934.27, "timestamp": "04:42:14", "text": "[音楽]"}, {"type": "subtitle", "time": 16942.59, "timestamp": "04:42:22", "text": "息子。あなたが元気でありますように。"}, {"type": "subtitle", "time": 16963.03, "timestamp": "04:42:43", "text": "つまり、私が今手を伸ばそうとしているなら"}, {"type": "subtitle", "time": 16965.75, "timestamp": "04:42:45", "text": "新しい人や古い人に話しかける"}, {"type": "subtitle", "time": 16968.55, "timestamp": "04:42:48", "text": "彼らに「ああ、私はただやっているだけだ」と感じてほしい"}, {"type": "subtitle", "time": 16973.83, "timestamp": "04:42:53", "text": "これは注目を集めるためとか何とかで、私はああ、"}, {"type": "subtitle", "time": 16976.788, "timestamp": "04:42:56", "text": "私がコラボレーションすると、"}]
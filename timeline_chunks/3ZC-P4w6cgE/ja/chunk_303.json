[{"type": "subtitle", "time": 18182.35, "timestamp": "05:03:02", "text": "待ってください。それは何ですか？それは"}, {"type": "subtitle", "time": 18186.67, "timestamp": "05:03:06", "text": "ドット？ああ、それはモグラに違いない"}, {"type": "subtitle", "time": 18190.07, "timestamp": "05:03:10", "text": "あれ。ああ、あれは何だ？それはまた別の"}, {"type": "subtitle", "time": 18204.31, "timestamp": "05:03:24", "text": "N. こんにちは。あの黒い物体は何ですか？何"}, {"type": "subtitle", "time": 18217.708, "timestamp": "05:03:37", "text": "すごくクールだし、君も手に入れたよ"}, {"type": "subtitle", "time": 18221.708, "timestamp": "05:03:41", "text": "待たなかった。私はそれを完全に目撃しました。"}, {"type": "subtitle", "time": 18224.91, "timestamp": "05:03:44", "text": "わかった。火事を見てください"}, {"type": "subtitle", "time": 18227.39, "timestamp": "05:03:47", "text": "絵文字。"}, {"type": "subtitle", "time": 18231.11, "timestamp": "05:03:51", "text": "こんにちは。ああ、それは3つ目のショッピングモールみたいなものだ。 H."}, {"type": "subtitle", "time": 18233.868, "timestamp": "05:03:53", "text": "ドラム缶に弾を詰める"}, {"type": "subtitle", "time": 18236.59, "timestamp": "05:03:56", "text": "ビート。これは、"}]
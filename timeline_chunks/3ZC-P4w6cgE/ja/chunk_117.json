[{"type": "subtitle", "time": 7027.109, "timestamp": "01:57:07", "text": "ええ、だからそれはむしろ、私が"}, {"type": "subtitle", "time": 7030.79, "timestamp": "01:57:10", "text": "これらのゲームに来ると、それはむしろ"}, {"type": "subtitle", "time": 7035.55, "timestamp": "01:57:15", "text": "えっと、ゾーンに入って、"}, {"type": "subtitle", "time": 7039.229, "timestamp": "01:57:19", "text": "あなたは自分の考えを吐き出すか、"}, {"type": "subtitle", "time": 7040.75, "timestamp": "01:57:20", "text": "何か。"}, {"type": "subtitle", "time": 7044.43, "timestamp": "01:57:24", "text": "こんにちは、ニハ。ニハ、いいよ"}, {"type": "subtitle", "time": 7047.31, "timestamp": "01:57:27", "text": "夕方。"}, {"type": "subtitle", "time": 7050.47, "timestamp": "01:57:30", "text": "とにかく、こんにちは。こんにちは。そう、私たちは"}, {"type": "subtitle", "time": 7053.189, "timestamp": "01:57:33", "text": "今日も信じられないほど素晴らしい生活を送っている。"}, {"type": "subtitle", "time": 7056.109, "timestamp": "01:57:36", "text": "どうやら、私が犯したそのエラーは"}, {"type": "subtitle", "time": 7060.709, "timestamp": "01:57:40", "text": "どうやら、何も持っていないようです。"}, {"type": "subtitle", "time": 7063.03, "timestamp": "01:57:43", "text": "ビリー・ビリーの誰かが"}, {"type": "subtitle", "time": 7066.589, "timestamp": "01:57:46", "text": "生放送で発生した奇妙なエラー"}, {"type": "subtitle", "time": 7070.229, "timestamp": "01:57:50", "text": "部屋。ええと、だから私は"}, {"type": "subtitle", "time": 7073.43, "timestamp": "01:57:53", "text": "信じることを継続することにした"}, {"type": "subtitle", "time": 7075.79, "timestamp": "01:57:55", "text": "複数領域向け。"}]
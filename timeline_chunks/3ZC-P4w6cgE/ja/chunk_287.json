[{"type": "subtitle", "time": 17246.948, "timestamp": "04:47:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17252.708, "timestamp": "04:47:32", "text": "くそ、誰も私の気持ちを理解できない。いいえ、"}, {"type": "subtitle", "time": 17254.19, "timestamp": "04:47:34", "text": "人々がいる"}, {"type": "subtitle", "time": 17263.75, "timestamp": "04:47:43", "text": "ええ、誰も知らないなら、"}, {"type": "subtitle", "time": 17267.03, "timestamp": "04:47:47", "text": "全員捕まえるつもりだ。"}]
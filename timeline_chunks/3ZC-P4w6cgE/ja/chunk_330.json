[{"type": "subtitle", "time": 19803.708, "timestamp": "05:30:03", "text": "猫に関するあらゆることについて"}, {"type": "subtitle", "time": 19808.11, "timestamp": "05:30:08", "text": "もの。だから私は"}, {"type": "subtitle", "time": 19809.788, "timestamp": "05:30:09", "text": "移植。"}, {"type": "subtitle", "time": 19814.628, "timestamp": "05:30:14", "text": "いや、いや、いや、いや、いや。だってほら、わかるでしょ"}, {"type": "subtitle", "time": 19817.948, "timestamp": "05:30:17", "text": "参加しながら、その間、私の"}, {"type": "subtitle", "time": 19821.99, "timestamp": "05:30:21", "text": "旅、えっと、私はそれを何と呼ぶか"}, {"type": "subtitle", "time": 19824.39, "timestamp": "05:30:24", "text": "あなたはそれを何と呼ぶのですか？それは何と呼ばれますか？えっと"}, {"type": "subtitle", "time": 19826.31, "timestamp": "05:30:26", "text": "何かある。何という名前ですか"}, {"type": "subtitle", "time": 19829.35, "timestamp": "05:30:29", "text": "これ？これを理解している特定の人々"}, {"type": "subtitle", "time": 19830.868, "timestamp": "05:30:30", "text": "目の色が違う。名前は何ですか"}, {"type": "subtitle", "time": 19834.11, "timestamp": "05:30:34", "text": "それ？私はバカだ。ああ、おいで"}, {"type": "subtitle", "time": 19837.15, "timestamp": "05:30:37", "text": "の上。ああ、忘れてた"}, {"type": "subtitle", "time": 19841.83, "timestamp": "05:30:41", "text": "それ。覚えておいてほしいのは、私はスターだったということだ。ああ、私は"}, {"type": "subtitle", "time": 19844.67, "timestamp": "05:30:44", "text": "言ったじゃないか？"}, {"type": "subtitle", "time": 19847.708, "timestamp": "05:30:47", "text": "ああ、忘れてしまった"}, {"type": "subtitle", "time": 19851.868, "timestamp": "05:30:51", "text": "彼ら。こんにちは。だから、私が"}, {"type": "subtitle", "time": 19854.19, "timestamp": "05:30:54", "text": "生まれ変わった。私が"}]
[{"type": "subtitle", "time": 18002.39, "timestamp": "05:00:02", "text": "私が今のコミュニティと呼ぶ理由。私はしません"}, {"type": "subtitle", "time": 18005.43, "timestamp": "05:00:05", "text": "えっと、直すべきかどうか知りたいです。"}, {"type": "subtitle", "time": 18008.23, "timestamp": "05:00:08", "text": "これは私たちにとって恒久的な名前です"}, {"type": "subtitle", "time": 18012.27, "timestamp": "05:00:12", "text": "コミュニティ 私のコミュニティ 私 私たち自身 あなた"}, {"type": "subtitle", "time": 18021.67, "timestamp": "05:00:21", "text": "ああ、初日からそこにいたから"}, {"type": "subtitle", "time": 18024.15, "timestamp": "05:00:24", "text": "まだ初日ではないけれど"}, {"type": "subtitle", "time": 18027.19, "timestamp": "05:00:27", "text": "つまり、初日から視聴している人がたくさんいるということだ。"}, {"type": "subtitle", "time": 18030.35, "timestamp": "05:00:30", "text": "支持者たちはまだ"}, {"type": "subtitle", "time": 18033.15, "timestamp": "05:00:33", "text": "私と話して"}, {"type": "subtitle", "time": 18037.03, "timestamp": "05:00:37", "text": "皆さんにお会いできて本当に嬉しいです"}, {"type": "subtitle", "time": 18055.31, "timestamp": "05:00:55", "text": "みんな。ヤフー。感謝"}, {"type": "subtitle", "time": 18058.868, "timestamp": "05:00:58", "text": "あなた。では、次に進みましょう"}]
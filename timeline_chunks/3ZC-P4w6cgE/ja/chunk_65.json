[{"type": "subtitle", "time": 3900.549, "timestamp": "01:05:00", "text": "つまり、いいえ、私はかつてそうでした"}, {"type": "subtitle", "time": 3904.15, "timestamp": "01:05:04", "text": "自分の自由や物事があった頃、"}, {"type": "subtitle", "time": 3906.47, "timestamp": "01:05:06", "text": "最近は寒くなってきた"}, {"type": "subtitle", "time": 3907.23, "timestamp": "01:05:07", "text": "に"}, {"type": "subtitle", "time": 3911.15, "timestamp": "01:05:11", "text": "時間が経つにつれて、"}, {"type": "subtitle", "time": 3914.87, "timestamp": "01:05:14", "text": "迷惑な。ええ、そうですね、それは"}, {"type": "subtitle", "time": 3916.27, "timestamp": "01:05:16", "text": "より良い"}, {"type": "subtitle", "time": 3921.309, "timestamp": "01:05:21", "text": "それから離れろ。はい、私のトナカイは踊っています。"}, {"type": "subtitle", "time": 3923.15, "timestamp": "01:05:23", "text": "わあ、私の"}, {"type": "subtitle", "time": 3937.47, "timestamp": "01:05:37", "text": "震え、震え。こんにちは。最後にまとめます。"}, {"type": "subtitle", "time": 3943.309, "timestamp": "01:05:43", "text": "今日を除いて"}, {"type": "subtitle", "time": 3947.39, "timestamp": "01:05:47", "text": "えっと、今日は楽しかった"}, {"type": "subtitle", "time": 3950.75, "timestamp": "01:05:50", "text": "日。今日は楽しかった"}, {"type": "subtitle", "time": 3953.43, "timestamp": "01:05:53", "text": "日。今日は本当に楽しかった。私は"}, {"type": "subtitle", "time": 3955.75, "timestamp": "01:05:55", "text": "ただおしゃべりしていただけなのに、結局"}, {"type": "subtitle", "time": 3957.43, "timestamp": "01:05:57", "text": "再生中"}]
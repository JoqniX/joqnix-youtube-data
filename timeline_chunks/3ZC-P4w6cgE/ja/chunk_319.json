[{"type": "subtitle", "time": 19163.47, "timestamp": "05:19:23", "text": "バカ。こんにちは。こんにちは。 「ようこそ」をいただきます。"}, {"type": "subtitle", "time": 19167.19, "timestamp": "05:19:27", "text": "いらっしゃいませ。ヤフー。スレイヤー。ヤフー。ヤフー。"}, {"type": "subtitle", "time": 19169.03, "timestamp": "05:19:29", "text": "お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 19170.868, "timestamp": "05:19:30", "text": "家族写真を撮って"}, {"type": "subtitle", "time": 19176.43, "timestamp": "05:19:36", "text": "そこには"}, {"type": "subtitle", "time": 19190.31, "timestamp": "05:19:50", "text": "コミ。わかった。わかった。準備できました。わかった。こんにちは。"}, {"type": "subtitle", "time": 19193.11, "timestamp": "05:19:53", "text": "こんにちは。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19195.99, "timestamp": "05:19:55", "text": "ええと、音楽があります、音楽"}, {"type": "subtitle", "time": 19199.59, "timestamp": "05:19:59", "text": "壁は少し低くなります。それで、"}]
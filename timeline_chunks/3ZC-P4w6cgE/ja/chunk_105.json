[{"type": "subtitle", "time": 6301.39, "timestamp": "01:45:01", "text": "特別な人、あるいはあなたの特別な人"}, {"type": "subtitle", "time": 6304.79, "timestamp": "01:45:04", "text": "ペットか何か、祝うこと以外"}, {"type": "subtitle", "time": 6306.43, "timestamp": "01:45:06", "text": "あなた自身。感謝"}, {"type": "subtitle", "time": 6309.35, "timestamp": "01:45:09", "text": "最善を尽くしてくれてありがとう、そして"}, {"type": "subtitle", "time": 6312.669, "timestamp": "01:45:12", "text": "あなたはクリスマスを楽しんだようですね。平"}, {"type": "subtitle", "time": 6317.189, "timestamp": "01:45:17", "text": "もしあなたのクリスマスがうまくいかなかったとしても、少なくとも"}, {"type": "subtitle", "time": 6328.95, "timestamp": "01:45:28", "text": "ゲーマー。残念ながら、私たちは"}, {"type": "subtitle", "time": 6332.07, "timestamp": "01:45:32", "text": "ストリームバッシュ。メリークリスマス"}, {"type": "subtitle", "time": 6334.55, "timestamp": "01:45:34", "text": "同じように。"}, {"type": "subtitle", "time": 6336.43, "timestamp": "01:45:36", "text": "メリークリスマス"}, {"type": "subtitle", "time": 6339.31, "timestamp": "01:45:39", "text": "お元気でいらっしゃることを願っています"}, {"type": "subtitle", "time": 6342.03, "timestamp": "01:45:42", "text": "良い。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 6345.75, "timestamp": "01:45:45", "text": "マット。メリークリスマス。待って、私は信じます"}, {"type": "subtitle", "time": 6350.55, "timestamp": "01:45:50", "text": "ええと、私の理解が正しければ。えっと、何だったの？"}, {"type": "subtitle", "time": 6353.03, "timestamp": "01:45:53", "text": "Among Usのタイムゾーンについて教えてくれたね"}, {"type": "subtitle", "time": 6355.51, "timestamp": "01:45:55", "text": "ストリーム？忘れた。でも、そうあるべきだ"}, {"type": "subtitle", "time": 6357.43, "timestamp": "01:45:57", "text": "あなたにとってはクリスマスイブですよね？あなたは"}]
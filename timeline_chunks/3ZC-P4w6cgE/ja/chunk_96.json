[{"type": "subtitle", "time": 5761.709, "timestamp": "01:36:01", "text": "あれ？そうだと思います。"}, {"type": "subtitle", "time": 5765.149, "timestamp": "01:36:05", "text": "待って、"}, {"type": "subtitle", "time": 5767.47, "timestamp": "01:36:07", "text": "おっぱい"}, {"type": "subtitle", "time": 5771.87, "timestamp": "01:36:11", "text": "そして、確かに存在する。ああ、これだ。これです。"}, {"type": "subtitle", "time": 5775.31, "timestamp": "01:36:15", "text": "待って、待って、待って、待って。これ"}, {"type": "subtitle", "time": 5777.629, "timestamp": "01:36:17", "text": "[音楽]"}, {"type": "subtitle", "time": 5779.79, "timestamp": "01:36:19", "text": "1つ。うん、これ"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "1つ。私もそこにいます。これが、"}, {"type": "subtitle", "time": 5787.189, "timestamp": "01:36:27", "text": "はい、そうしました。この男性を想像してみてください。私は彼の"}, {"type": "subtitle", "time": 5790.149, "timestamp": "01:36:30", "text": "マイクチャマまたはあなたとして名前を。私はただ"}, {"type": "subtitle", "time": 5797.95, "timestamp": "01:36:37", "text": "それ。こんな感じ"}, {"type": "subtitle", "time": 5799.87, "timestamp": "01:36:39", "text": "お前。"}, {"type": "subtitle", "time": 5804.79, "timestamp": "01:36:44", "text": "ええと、それはイエスによって言われた犬です。おお、"}, {"type": "subtitle", "time": 5806.39, "timestamp": "01:36:46", "text": "待って。あ、待って。待って、待って、待って、待って。"}, {"type": "subtitle", "time": 5809.03, "timestamp": "01:36:49", "text": "アシャンに言い忘れた、会えなくて残念だった。おお"}, {"type": "subtitle", "time": 5811.83, "timestamp": "01:36:51", "text": "我が神よ。 SOSの後、お礼を言うのを忘れていました"}, {"type": "subtitle", "time": 5816.31, "timestamp": "01:36:56", "text": "ハッシュに行かないで、忘れたよ、今すぐ行って、アラト"}, {"type": "subtitle", "time": 5819.189, "timestamp": "01:36:59", "text": "今日は来てくれてありがとう、会えなくて寂しかったよ"}]
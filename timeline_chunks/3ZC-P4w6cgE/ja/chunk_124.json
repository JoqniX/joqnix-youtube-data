[{"type": "subtitle", "time": 7453.36, "timestamp": "02:04:13", "text": "えーと1つで"}, {"type": "subtitle", "time": 7465.91, "timestamp": "02:04:25", "text": "ちょっと待って、1秒だけ。それで"}, {"type": "subtitle", "time": 7469.51, "timestamp": "02:04:29", "text": "今日は、申し訳ありませんが、私たちは"}, {"type": "subtitle", "time": 7472.149, "timestamp": "02:04:32", "text": "まだ導入段階です。ようこそ"}, {"type": "subtitle", "time": 7475.91, "timestamp": "02:04:35", "text": "ヨアトン76日目。"}, {"type": "subtitle", "time": 7478.629, "timestamp": "02:04:38", "text": "今日は月曜日だ。今日はコラボレーションがあります"}, {"type": "subtitle", "time": 7481.87, "timestamp": "02:04:41", "text": "イマンと一緒です。ええと、私たちは"}, {"type": "subtitle", "time": 7484.47, "timestamp": "02:04:44", "text": "ロブロックス。私たちはRobloxで遊ぶ予定です。"}, {"type": "subtitle", "time": 7486.149, "timestamp": "02:04:46", "text": "私たちは棚を楽しんでいます"}, {"type": "subtitle", "time": 7488.91, "timestamp": "02:04:48", "text": "すべて。私たちは"}, {"type": "subtitle", "time": 7491.47, "timestamp": "02:04:51", "text": "ロブロックス"}, {"type": "subtitle", "time": 7495.589, "timestamp": "02:04:55", "text": "そして、今日は楽しい一日を過ごしています。持っている"}, {"type": "subtitle", "time": 7498.31, "timestamp": "02:04:58", "text": "楽しんでいます。そして今夜は"}]
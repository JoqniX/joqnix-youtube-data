[{"type": "subtitle", "time": 8402.469, "timestamp": "02:20:02", "text": "作った、えーと、このアカウントは"}, {"type": "subtitle", "time": 8404.63, "timestamp": "02:20:04", "text": "本当に古い。私はこれを 1 時くらいに作りました"}, {"type": "subtitle", "time": 8407.59, "timestamp": "02:20:07", "text": "20,000"}, {"type": "subtitle", "time": 8414.79, "timestamp": "02:20:14", "text": "確か13か14だったと思う。くそっ。"}, {"type": "subtitle", "time": 8417.11, "timestamp": "02:20:17", "text": "つまり、これは、"}, {"type": "subtitle", "time": 8419.59, "timestamp": "02:20:19", "text": "ティックスと呼ばれる通貨があり、"}, {"type": "subtitle", "time": 8422.389, "timestamp": "02:20:22", "text": "それは毎日タダでお金がもらえるようなもので、"}, {"type": "subtitle", "time": 8424.87, "timestamp": "02:20:24", "text": "Robuxへの変換を制御できます。"}, {"type": "subtitle", "time": 8426.95, "timestamp": "02:20:26", "text": "Robuxは、現実のお金で支払わなければならないようなものです"}, {"type": "subtitle", "time": 8430.71, "timestamp": "02:20:30", "text": "その通貨を手に入れるためのお金。うん。今"}, {"type": "subtitle", "time": 8432.79, "timestamp": "02:20:32", "text": "ひよこシステム全体がなくなって、"}, {"type": "subtitle", "time": 8437.51, "timestamp": "02:20:37", "text": "今はただ金儲けだけが目的だ。"}, {"type": "subtitle", "time": 8439.59, "timestamp": "02:20:39", "text": "今では、実際のお金を使う必要があります"}, {"type": "subtitle", "time": 8443.03, "timestamp": "02:20:43", "text": "こういうことをするんです。ああ、"}, {"type": "subtitle", "time": 8445.59, "timestamp": "02:20:45", "text": "アカウントは作ったけど、リンクするのを忘れた"}, {"type": "subtitle", "time": 8449.03, "timestamp": "02:20:49", "text": "私のメールアドレスや電話番号など。それで、"}, {"type": "subtitle", "time": 8451.99, "timestamp": "02:20:51", "text": "私はちょっと冷静さを失ってしまった。"}, {"type": "subtitle", "time": 8457.51, "timestamp": "02:20:57", "text": "ああ、それから私はまたそれを作らなければならなかった"}]
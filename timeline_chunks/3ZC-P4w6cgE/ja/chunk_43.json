[{"type": "subtitle", "time": 2589.55, "timestamp": "00:43:09", "text": "みんな。陽気な"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "ジョーにとってクリスマスに欠ける滞在"}, {"type": "subtitle", "time": 2625.43, "timestamp": "00:43:45", "text": "船員。あなたは話すでしょう。退屈だし"}, {"type": "subtitle", "time": 2628.23, "timestamp": "00:43:48", "text": "現在フラグを立てているところです。"}, {"type": "subtitle", "time": 2631.51, "timestamp": "00:43:51", "text": "今、退屈でイライラしてる。"}, {"type": "subtitle", "time": 2635.19, "timestamp": "00:43:55", "text": "次のこと。"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "何てことだ。自分が1人しか倒していないことは分かっていた。"}]
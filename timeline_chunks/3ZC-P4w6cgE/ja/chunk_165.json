[{"type": "subtitle", "time": 9902.07, "timestamp": "02:45:02", "text": "見て、ええと、心配ないよ。つまり、私は"}, {"type": "subtitle", "time": 9903.429, "timestamp": "02:45:03", "text": "あまり長く見ていると、"}, {"type": "subtitle", "time": 9915.91, "timestamp": "02:45:15", "text": "うんうん。"}, {"type": "subtitle", "time": 9917.91, "timestamp": "02:45:17", "text": "くそ。何を言おうとしていたのか忘れてしまった。"}, {"type": "subtitle", "time": 9922.07, "timestamp": "02:45:22", "text": "でも、最悪だ。アイテムはどちらにも似ていて、"}, {"type": "subtitle", "time": 9924.71, "timestamp": "02:45:24", "text": "右？えっと、1人用だと思います"}, {"type": "subtitle", "time": 9925.99, "timestamp": "02:45:25", "text": "人。ライターを持っているようなものだ。あなたは"}, {"type": "subtitle", "time": 9929.91, "timestamp": "02:45:29", "text": "ライター持ってる？いいえ。大きなものを手に入れましたか？"}, {"type": "subtitle", "time": 9931.91, "timestamp": "02:45:31", "text": "お金？"}, {"type": "subtitle", "time": 9934.55, "timestamp": "02:45:34", "text": "ええと、お金。私は"}, {"type": "subtitle", "time": 9937.469, "timestamp": "02:45:37", "text": "お金。だから、それは"}, {"type": "subtitle", "time": 9945.75, "timestamp": "02:45:45", "text": "はい、キャビネットが"}]
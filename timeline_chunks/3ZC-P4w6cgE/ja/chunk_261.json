[{"type": "subtitle", "time": 15664.67, "timestamp": "04:21:04", "text": "でも、そうですね、私は自分の"}, {"type": "subtitle", "time": 15668.95, "timestamp": "04:21:08", "text": "人とのつながり、つまり私が会った人々のこと。私は欲しい"}, {"type": "subtitle", "time": 15672.63, "timestamp": "04:21:12", "text": "それらを保存したい、保存する"}, {"type": "subtitle", "time": 15675.59, "timestamp": "04:21:15", "text": "暇な時間がない、いい感じ"}, {"type": "subtitle", "time": 15676.91, "timestamp": "04:21:16", "text": "利用規約"}, {"type": "subtitle", "time": 15679.91, "timestamp": "04:21:19", "text": "すべて。良き、誠実な友人になりましょう。"}, {"type": "subtitle", "time": 15699.07, "timestamp": "04:21:39", "text": "では、提供しましょう。何が"}]
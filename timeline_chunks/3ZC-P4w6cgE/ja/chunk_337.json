[{"type": "subtitle", "time": 20223.83, "timestamp": "05:37:03", "text": "それ。ええ、それが歓迎の仕方です"}, {"type": "subtitle", "time": 20230.03, "timestamp": "05:37:10", "text": "持っている"}, {"type": "subtitle", "time": 20234.07, "timestamp": "05:37:14", "text": "うん。私はそれをこのように修正します"}, {"type": "subtitle", "time": 20244.47, "timestamp": "05:37:24", "text": "ああ、神様。ああ、忘れてた ああ、忘れてた"}, {"type": "subtitle", "time": 20247.628, "timestamp": "05:37:27", "text": "それら全てを無効にしてください。よお、"}, {"type": "subtitle", "time": 20250.03, "timestamp": "05:37:30", "text": "君たちは知っているだろう"}, {"type": "subtitle", "time": 20252.67, "timestamp": "05:37:32", "text": "皆さんもご存知の通り"}, {"type": "subtitle", "time": 20256.43, "timestamp": "05:37:36", "text": "すべて。君たちは何でも知っているね。おお"}, {"type": "subtitle", "time": 20259.23, "timestamp": "05:37:39", "text": "神様、私を壊してください"}, {"type": "subtitle", "time": 20261.548, "timestamp": "05:37:41", "text": "すでに。"}, {"type": "subtitle", "time": 20265.11, "timestamp": "05:37:45", "text": "こんにちは。うん。こんにちは。うん。こんにちは。それは良いです"}, {"type": "subtitle", "time": 20274.91, "timestamp": "05:37:54", "text": "お越しいただきありがとうございます。こんにちは。私"}, {"type": "subtitle", "time": 20277.47, "timestamp": "05:37:57", "text": "できません。こんにちは。"}]
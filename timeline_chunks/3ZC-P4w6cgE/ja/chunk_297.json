[{"type": "subtitle", "time": 17823.59, "timestamp": "04:57:03", "text": "何ヶ月か忘れちゃった"}, {"type": "subtitle", "time": 17826.19, "timestamp": "04:57:06", "text": "たぶんそうだったと思う"}, {"type": "subtitle", "time": 17830.23, "timestamp": "04:57:10", "text": "なんでこの人、見覚えがあるんだろう？ふむ。しないで"}, {"type": "subtitle", "time": 17833.11, "timestamp": "04:57:13", "text": "知る。というわけで、V字型のチューブを取り付け始めました。"}, {"type": "subtitle", "time": 17837.27, "timestamp": "04:57:17", "text": "えっと、ジョックニックのためのもの、実際には6つくらい"}, {"type": "subtitle", "time": 17841.35, "timestamp": "04:57:21", "text": "去年の6ヶ月くらいみたいに、6ヶ月くらいかな"}, {"type": "subtitle", "time": 17842.19, "timestamp": "04:57:22", "text": "えーと"}, {"type": "subtitle", "time": 17844.59, "timestamp": "04:57:24", "text": "9月のように"}, {"type": "subtitle", "time": 17851.628, "timestamp": "04:57:31", "text": "また、すべての腫瘍も同様です。"}, {"type": "subtitle", "time": 17856.708, "timestamp": "04:57:36", "text": "シーッ。いや、いや、いや。やめろ、絶対にやめろ"}, {"type": "subtitle", "time": 17859.948, "timestamp": "04:57:39", "text": "このバカをぶっ潰せ。ただ"}, {"type": "subtitle", "time": 17863.11, "timestamp": "04:57:43", "text": "待って。やあみんな。楽しめ。それはとても"}, {"type": "subtitle", "time": 17872.788, "timestamp": "04:57:52", "text": "こんにちは。あと、ええ、そうですね。ええと、すべての"}, {"type": "subtitle", "time": 17876.91, "timestamp": "04:57:56", "text": "長年の視聴者と新規視聴者"}, {"type": "subtitle", "time": 17878.43, "timestamp": "04:57:58", "text": "えっと"}]
[{"type": "subtitle", "time": 18240.51, "timestamp": "05:04:00", "text": "男の子。からかってるんだよ。わからない"}, {"type": "subtitle", "time": 18244.27, "timestamp": "05:04:04", "text": "それ。それは私の唇です。"}, {"type": "subtitle", "time": 18269.27, "timestamp": "05:04:29", "text": "音楽？おや、これは何でしょう？丸いもの。"}, {"type": "subtitle", "time": 18270.59, "timestamp": "05:04:30", "text": "何が"}, {"type": "subtitle", "time": 18272.99, "timestamp": "05:04:32", "text": "これ？"}, {"type": "subtitle", "time": 18277.23, "timestamp": "05:04:37", "text": "H. こちらに何かあります。何が"}, {"type": "subtitle", "time": 18280.788, "timestamp": "05:04:40", "text": "これ？それは目です。私は眼鏡をかけています。おお。"}, {"type": "subtitle", "time": 18296.91, "timestamp": "05:04:56", "text": "ああ、これでよし。それが私の顔です。"}, {"type": "subtitle", "time": 18298.93, "timestamp": "05:04:58", "text": "おお。"}]
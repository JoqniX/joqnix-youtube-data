[{"type": "subtitle", "time": 10021.349, "timestamp": "02:47:01", "text": "空は灰色だ。一度しか姿を変えない。それが"}, {"type": "subtitle", "time": 10023.67, "timestamp": "02:47:03", "text": "鮮やかな白と緑。つまり、複数"}, {"type": "subtitle", "time": 10026.51, "timestamp": "02:47:06", "text": "何回も見たよ。"}, {"type": "subtitle", "time": 10031.67, "timestamp": "02:47:11", "text": "ああ、私もいないいないばあをする男の子がいましたよ。"}, {"type": "subtitle", "time": 10044.95, "timestamp": "02:47:24", "text": "うん。そうそう。私も聞いた"}, {"type": "subtitle", "time": 10047.59, "timestamp": "02:47:27", "text": "エピソードですが、彼が登場するのは"}, {"type": "subtitle", "time": 10049.59, "timestamp": "02:47:29", "text": "あなたはあまりにも長い間、無知なままだった。地獄"}, {"type": "subtitle", "time": 10051.91, "timestamp": "02:47:31", "text": "願望実現を始めよう。"}, {"type": "subtitle", "time": 10060.15, "timestamp": "02:47:40", "text": "くそ。懐中電灯が必要だ。"}, {"type": "subtitle", "time": 10079.469, "timestamp": "02:47:59", "text": "全て"}]
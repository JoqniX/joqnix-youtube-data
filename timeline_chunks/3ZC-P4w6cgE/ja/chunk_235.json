[{"type": "subtitle", "time": 14102.79, "timestamp": "03:55:02", "text": "ドアを飛ばすことはできないと思います。"}, {"type": "subtitle", "time": 14106.79, "timestamp": "03:55:06", "text": "どのドアですか？ああ、ストレートだ。真っ直ぐ。"}, {"type": "subtitle", "time": 14115.51, "timestamp": "03:55:15", "text": "飛び越えられる時みたいな感じだよね？"}, {"type": "subtitle", "time": 14118.229, "timestamp": "03:55:18", "text": "ドアを飛び越えることができます"}, {"type": "subtitle", "time": 14120.07, "timestamp": "03:55:20", "text": "おそらく、あなたがより高いレベルにいるとき"}, {"type": "subtitle", "time": 14122.87, "timestamp": "03:55:22", "text": "そこなら簡単に飛び越えられます"}, {"type": "subtitle", "time": 14126.229, "timestamp": "03:55:26", "text": "それらの。あー、じゃあプリを見せてあげよう。わかった"}, {"type": "subtitle", "time": 14130.55, "timestamp": "03:55:30", "text": "無理です。低すぎるし、火も消えています。"}, {"type": "subtitle", "time": 14140.79, "timestamp": "03:55:40", "text": "待つ必要はありません。あなたはどのように亡くなったのですか？私はしませんでした"}, {"type": "subtitle", "time": 14144.469, "timestamp": "03:55:44", "text": "タイミングよくしゃがむ。それは笑顔の絵文字だった。"}, {"type": "subtitle", "time": 14148.15, "timestamp": "03:55:48", "text": "でも待って、あなたは生きているはずでしょう。"}, {"type": "subtitle", "time": 14151.67, "timestamp": "03:55:51", "text": "え、何これ？待って、君はどこにいるの？"}, {"type": "subtitle", "time": 14154.07, "timestamp": "03:55:54", "text": "私は死んだ。"}, {"type": "subtitle", "time": 14156.95, "timestamp": "03:55:56", "text": "何てことだ。ああ、あなたは"}]
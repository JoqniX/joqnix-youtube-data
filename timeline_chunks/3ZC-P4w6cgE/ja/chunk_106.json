[{"type": "subtitle", "time": 6360.47, "timestamp": "01:46:00", "text": "まだ24番街にいるんだよね？そう、メリー"}, {"type": "subtitle", "time": 6367.189, "timestamp": "01:46:07", "text": "良い夜をお過ごしください。"}, {"type": "subtitle", "time": 6368.99, "timestamp": "01:46:08", "text": "夜"}, {"type": "subtitle", "time": 6372.109, "timestamp": "01:46:12", "text": "先に。時刻は合っていますか？"}, {"type": "subtitle", "time": 6375.109, "timestamp": "01:46:15", "text": "ゾーン？タイムゾーンは合っていますか？私"}, {"type": "subtitle", "time": 6378.709, "timestamp": "01:46:18", "text": "わからない。まあ、そうですね。ああ、私の予想は正しかった。"}, {"type": "subtitle", "time": 6380.51, "timestamp": "01:46:20", "text": "タイムゾーンを含めて。"}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "良い。ええ、ご参加いただきありがとうございました。"}, {"type": "subtitle", "time": 6385.91, "timestamp": "01:46:25", "text": "これで、あなたの2回目の配信が完了です。"}, {"type": "subtitle", "time": 6393.99, "timestamp": "01:46:33", "text": "そう、私たちは、私たちは、私たちは、"}, {"type": "subtitle", "time": 6396.79, "timestamp": "01:46:36", "text": "まるでチャレンジ配信みたいだった。私たちは"}, {"type": "subtitle", "time": 6399.189, "timestamp": "01:46:39", "text": "プッシュマッシュとか全部話したよ"}, {"type": "subtitle", "time": 6402.03, "timestamp": "01:46:42", "text": "冒頭の事柄。それから私は演奏した"}, {"type": "subtitle", "time": 6405.35, "timestamp": "01:46:45", "text": "ヴァレレントは確か1つか2つ"}, {"type": "subtitle", "time": 6407.75, "timestamp": "01:46:47", "text": "時間。そして今、私たちはただの雑談に戻った"}, {"type": "subtitle", "time": 6409.149, "timestamp": "01:46:49", "text": "また。それで"}, {"type": "subtitle", "time": 6412.31, "timestamp": "01:46:52", "text": "ええ、あなたが見逃したのはそれだけです。しかし"}, {"type": "subtitle", "time": 6414.27, "timestamp": "01:46:54", "text": "それでも、来てくれてありがとう。"}, {"type": "subtitle", "time": 6417.03, "timestamp": "01:46:57", "text": "による。明日は良い日だ。はい、"}, {"type": "subtitle", "time": 6418.75, "timestamp": "01:46:58", "text": "明日は良い日です"}]
[{"type": "subtitle", "time": 2222.589, "timestamp": "00:37:02", "text": "マクリー。私はマクリーを次のように読みました"}, {"type": "subtitle", "time": 2247.349, "timestamp": "00:37:27", "text": "うん。そうですね、いくつかプレイします"}, {"type": "subtitle", "time": 2251.109, "timestamp": "00:37:31", "text": "ゲームを終えたら、最後に車で締めくくります。"}, {"type": "subtitle", "time": 2253.43, "timestamp": "00:37:33", "text": "では、私たちはただおしゃべりをするだけです"}, {"type": "subtitle", "time": 2274.47, "timestamp": "00:37:54", "text": "エージェント。彼らは何について話しているのですか？"}, {"type": "subtitle", "time": 2279.51, "timestamp": "00:37:59", "text": "理解する。彼らは何かについて話しているのか"}]
[{"type": "subtitle", "time": 10921.95, "timestamp": "03:02:01", "text": "うん。えーっと、１、２、３、４、"}, {"type": "subtitle", "time": 10926.389, "timestamp": "03:02:06", "text": "五。ああ、くそ。どうすればいいですか どうすればいいですか"}, {"type": "subtitle", "time": 10930.03, "timestamp": "03:02:10", "text": "どうすればここから抜け出せますか？どうやって閉じればいいですか？"}, {"type": "subtitle", "time": 10932.95, "timestamp": "03:02:12", "text": "これ？わかった。わかった。私たちはボタンを押します。"}, {"type": "subtitle", "time": 10935.99, "timestamp": "03:02:15", "text": "別のボタン。よし。えっと、"}, {"type": "subtitle", "time": 10936.99, "timestamp": "03:02:16", "text": "それを読んでください"}, {"type": "subtitle", "time": 10944.19, "timestamp": "03:02:24", "text": "コード。えっと、スクエアは1です。わかった。ダイヤモンドは"}, {"type": "subtitle", "time": 10946.99, "timestamp": "03:02:26", "text": "二。正方形のひし形"}, {"type": "subtitle", "time": 10961.03, "timestamp": "03:02:41", "text": "わかった。よし。こいつらは怖い。"}, {"type": "subtitle", "time": 10965.67, "timestamp": "03:02:45", "text": "うん。よし。チームのダイヤモンドスター。"}, {"type": "subtitle", "time": 10967.63, "timestamp": "03:02:47", "text": "大丈夫。"}]
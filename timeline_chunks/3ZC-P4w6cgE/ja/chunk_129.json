[{"type": "subtitle", "time": 7741.91, "timestamp": "02:09:01", "text": "こんにちは。だから、待って、待って、待って、待って。こんにちは"}, {"type": "subtitle", "time": 7752.55, "timestamp": "02:09:12", "text": "えーと、CC V。"}, {"type": "subtitle", "time": 7754.47, "timestamp": "02:09:14", "text": "うん。"}, {"type": "subtitle", "time": 7759.189, "timestamp": "02:09:19", "text": "CC Vとはどういう意味ですか？ CCは、えっと"}, {"type": "subtitle", "time": 7761.189, "timestamp": "02:09:21", "text": "はい。はい。スペイン語で。複数形。私は思う"}, {"type": "subtitle", "time": 7763.99, "timestamp": "02:09:23", "text": "それはフランス語で「[ __ ]」という意味です。何が"}, {"type": "subtitle", "time": 7765.229, "timestamp": "02:09:25", "text": "それ。"}, {"type": "subtitle", "time": 7766.75, "timestamp": "02:09:26", "text": "V."}, {"type": "subtitle", "time": 7775.91, "timestamp": "02:09:35", "text": "おお。ほら、友達とかそういう人たちのためにね。"}, {"type": "subtitle", "time": 7778.629, "timestamp": "02:09:38", "text": "くそ。ああ、私にはわからない。そこには"}, {"type": "subtitle", "time": 7780.709, "timestamp": "02:09:40", "text": "こういうのはよくわからない。私にとって、"}, {"type": "subtitle", "time": 7782.229, "timestamp": "02:09:42", "text": "私はとても魅了されていると思う"}, {"type": "subtitle", "time": 7784.87, "timestamp": "02:09:44", "text": "ヨーロッパのもの。だから私は「ああ、"}, {"type": "subtitle", "time": 7789.189, "timestamp": "02:09:49", "text": "くそっ。フランス語、スペイン語、ええとポーランド語のように、"}, {"type": "subtitle", "time": 7790.95, "timestamp": "02:09:50", "text": "ドイツ語。 「ああ、彼らはとても"}, {"type": "subtitle", "time": 7793.069, "timestamp": "02:09:53", "text": "「おしゃれだね」それで私は「うん、"}, {"type": "subtitle", "time": 7795.189, "timestamp": "02:09:55", "text": "たぶんそうしたいんでしょうね。皆さんが"}, {"type": "subtitle", "time": 7797.83, "timestamp": "02:09:57", "text": "あなたが日本語を使うように、私は"}]
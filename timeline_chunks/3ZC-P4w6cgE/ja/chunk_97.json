[{"type": "subtitle", "time": 5821.83, "timestamp": "01:37:01", "text": "アキャビさん、犬と言ってくれてありがとう"}, {"type": "subtitle", "time": 5826.07, "timestamp": "01:37:06", "text": "戦争は私にあの物を思い出させた"}, {"type": "subtitle", "time": 5829.83, "timestamp": "01:37:09", "text": "ハシャンは、戦争の犬は"}, {"type": "subtitle", "time": 5832.629, "timestamp": "01:37:12", "text": "犬と同等の戦いの神、ああ、なんてことだ"}, {"type": "subtitle", "time": 5842.79, "timestamp": "01:37:22", "text": "お邪魔して時間を取らせてしまい申し訳ありませんでした。"}, {"type": "subtitle", "time": 5847.27, "timestamp": "01:37:27", "text": "私を見守ってくれたり、そこにいてくれたりすること。"}, {"type": "subtitle", "time": 5850.229, "timestamp": "01:37:30", "text": "本当に感謝しています。いいえ、私は"}, {"type": "subtitle", "time": 5852.629, "timestamp": "01:37:32", "text": "あなたがとても積極的で参加していること"}, {"type": "subtitle", "time": 5855.83, "timestamp": "01:37:35", "text": "ストリーム全体。本当に本当にありがとうございます"}, {"type": "subtitle", "time": 5859.03, "timestamp": "01:37:39", "text": "最後まで残ってくれてありがとう。ご挨拶申し上げます。"}, {"type": "subtitle", "time": 5861.27, "timestamp": "01:37:41", "text": "ぐっすり眠れますように。"}, {"type": "subtitle", "time": 5864.55, "timestamp": "01:37:44", "text": "あなたにもメリークリスマス。はぁ？"}, {"type": "subtitle", "time": 5867.35, "timestamp": "01:37:47", "text": "これからも一緒にヴァリンをプレイしよう。いいえ。そして"}, {"type": "subtitle", "time": 5870.07, "timestamp": "01:37:50", "text": "はい、そのコメントを見ました"}, {"type": "subtitle", "time": 5873.27, "timestamp": "01:37:53", "text": "Valerantの配信をしました。とても可愛かった。"}, {"type": "subtitle", "time": 5875.91, "timestamp": "01:37:55", "text": "あなたの声、すごく可愛いね。たとえあなたが"}, {"type": "subtitle", "time": 5878.229, "timestamp": "01:37:58", "text": "見せたくなかったのに、うっかり"}]
[{"type": "subtitle", "time": 14700.15, "timestamp": "04:05:00", "text": "彼は、バムが彼女を利用しているかどうかはわかりません"}, {"type": "subtitle", "time": 14701.92, "timestamp": "04:05:01", "text": "アカウントはもうありませんが、"}, {"type": "subtitle", "time": 14708.59, "timestamp": "04:05:08", "text": "[音楽]"}, {"type": "subtitle", "time": 14711.269, "timestamp": "04:05:11", "text": "ええ、たくさんの人が"}, {"type": "subtitle", "time": 14713.71, "timestamp": "04:05:13", "text": "見た"}, {"type": "subtitle", "time": 14716.79, "timestamp": "04:05:16", "text": "その周り。全部手に入れたかった。しかし"}, {"type": "subtitle", "time": 14721.269, "timestamp": "04:05:21", "text": "うん、みんな夜の枠を欲しがってるよ。"}]
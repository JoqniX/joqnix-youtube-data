[{"type": "subtitle", "time": 5640.59, "timestamp": "01:34:00", "text": "私の"}, {"type": "subtitle", "time": 5643.99, "timestamp": "01:34:03", "text": "鼻？ブープ。ブープはどうやってやるの？私"}, {"type": "subtitle", "time": 5647.189, "timestamp": "01:34:07", "text": "鼻をツンと鳴らすものが必要だ。それは緑色ですか"}, {"type": "subtitle", "time": 5650.87, "timestamp": "01:34:10", "text": "画面を軽く押すやつ？それを置きたい。私"}, {"type": "subtitle", "time": 5658.95, "timestamp": "01:34:18", "text": "鼻。私たちもおっぱいが欲しい。はい。もし私が"}, {"type": "subtitle", "time": 5661.27, "timestamp": "01:34:21", "text": "アニメーションが得意ですよね？私は"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "実際に犬がうんちをする"}, {"type": "subtitle", "time": 5685.27, "timestamp": "01:34:45", "text": "Bing 知らないけど最近私のところに来た"}, {"type": "subtitle", "time": 5686.03, "timestamp": "01:34:46", "text": "これ"}, {"type": "subtitle", "time": 5693.669, "timestamp": "01:34:53", "text": "あなたがブープを望んでいるのはわかっている、どうすればあなたになれるか"}, {"type": "subtitle", "time": 5696.03, "timestamp": "01:34:56", "text": "私が持っているのは"}, {"type": "subtitle", "time": 5699.11, "timestamp": "01:34:59", "text": "アイデア なぜあなたは"}]
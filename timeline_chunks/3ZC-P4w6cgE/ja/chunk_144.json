[{"type": "subtitle", "time": 8640.55, "timestamp": "02:24:00", "text": "よくわからない。おお、"}, {"type": "subtitle", "time": 8642.55, "timestamp": "02:24:02", "text": "ああ、チェーンで繋がっているとか、そういうものがあるんですね。"}, {"type": "subtitle", "time": 8645.349, "timestamp": "02:24:05", "text": "ああ、ここにはたくさんのゲームがあるね。がある"}, {"type": "subtitle", "time": 8648.07, "timestamp": "02:24:08", "text": "とてもたくさん。例えば、"}, {"type": "subtitle", "time": 8652.309, "timestamp": "02:24:12", "text": "ゲームをするには、Roblox を使用してください。うん、"}, {"type": "subtitle", "time": 8654.309, "timestamp": "02:24:14", "text": "フォートナイトもやっていると思う"}, {"type": "subtitle", "time": 8657.83, "timestamp": "02:24:17", "text": "同じことですよね？ Robloxのように"}, {"type": "subtitle", "time": 8660.87, "timestamp": "02:24:20", "text": "ええ、フォートナイトは、"}, {"type": "subtitle", "time": 8662.71, "timestamp": "02:24:22", "text": "Robloxに変わって、1つだけ"}, {"type": "subtitle", "time": 8665.19, "timestamp": "02:24:25", "text": "腹が立つのは、こういう人たちが話すことだ"}, {"type": "subtitle", "time": 8669.349, "timestamp": "02:24:29", "text": "Robloxのようなもので、子供向けのゲームです。"}, {"type": "subtitle", "time": 8671.59, "timestamp": "02:24:31", "text": "そしてフォートナイトがこんなことをすると"}, {"type": "subtitle", "time": 8673.91, "timestamp": "02:24:33", "text": "まるで彼らはこれらすべての複数を持っているかのようだ"}, {"type": "subtitle", "time": 8676.23, "timestamp": "02:24:36", "text": "彼らが好きなゲーム、ああ、フォートナイトは"}, {"type": "subtitle", "time": 8678.79, "timestamp": "02:24:38", "text": "革命的であるということは、非常に多くの"}, {"type": "subtitle", "time": 8683.19, "timestamp": "02:24:43", "text": "ゲーム[ __ ]Robloxが全てを始めた"}, {"type": "subtitle", "time": 8689.349, "timestamp": "02:24:49", "text": "だから、"}, {"type": "subtitle", "time": 8692.15, "timestamp": "02:24:52", "text": "うん、そういうことって、"}, {"type": "subtitle", "time": 8693.83, "timestamp": "02:24:53", "text": "私にとってRobloxのような魅力的なもの"}, {"type": "subtitle", "time": 8696.07, "timestamp": "02:24:56", "text": "たぶん、私はそうは思わない、わからない"}, {"type": "subtitle", "time": 8697.51, "timestamp": "02:24:57", "text": "複数のエンジンがあるか、おそらく"}, {"type": "subtitle", "time": 8699.19, "timestamp": "02:24:59", "text": "Robloxエンジンですが、ゲームがあります"}]
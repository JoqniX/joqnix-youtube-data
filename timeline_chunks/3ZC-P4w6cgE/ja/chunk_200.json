[{"type": "subtitle", "time": 12005.55, "timestamp": "03:20:05", "text": "おお、"}, {"type": "subtitle", "time": 12008.67, "timestamp": "03:20:08", "text": "わかった。 8. 冗談でしょう？"}, {"type": "subtitle", "time": 12012.59, "timestamp": "03:20:12", "text": "自分？ 85じゃなかったと思う。しまった。くそ。"}, {"type": "subtitle", "time": 12015.99, "timestamp": "03:20:15", "text": "ああ、いやだ。"}, {"type": "subtitle", "time": 12018.99, "timestamp": "03:20:18", "text": "SPはどれくらいありますか？"}, {"type": "subtitle", "time": 12023.269, "timestamp": "03:20:23", "text": "えっと、たぶん3分の1くらいだと思う。待って"}, {"type": "subtitle", "time": 12026.79, "timestamp": "03:20:26", "text": "82ですよね？"}, {"type": "subtitle", "time": 12028.469, "timestamp": "03:20:28", "text": "おお"}, {"type": "subtitle", "time": 12030.03, "timestamp": "03:20:30", "text": "いいえ。"}, {"type": "subtitle", "time": 12033.19, "timestamp": "03:20:33", "text": "なんてこった。"}, {"type": "subtitle", "time": 12035.11, "timestamp": "03:20:35", "text": "おお、"}, {"type": "subtitle", "time": 12038.469, "timestamp": "03:20:38", "text": "大丈夫です。心配ない。うん、"}, {"type": "subtitle", "time": 12041.71, "timestamp": "03:20:41", "text": "私たちはよくやった。私たちはよくやった。"}, {"type": "subtitle", "time": 12044.79, "timestamp": "03:20:44", "text": "うん、大丈夫だよ。"}, {"type": "subtitle", "time": 12047.429, "timestamp": "03:20:47", "text": "つまり、少なくとも835コイン稼いだということだ。"}, {"type": "subtitle", "time": 12048.95, "timestamp": "03:20:48", "text": "うまくいけば。"}, {"type": "subtitle", "time": 12055.51, "timestamp": "03:20:55", "text": "もう一つの「速いペース」って何ですか？"}, {"type": "subtitle", "time": 12058.51, "timestamp": "03:20:58", "text": "ああ、わかった。えっと、それは"}]
[{"type": "subtitle", "time": 11773.87, "timestamp": "03:16:13", "text": "ああ、このドア用ですね。"}, {"type": "subtitle", "time": 11776.67, "timestamp": "03:16:16", "text": "はい、頭蓋骨はあります"}, {"type": "subtitle", "time": 11780.03, "timestamp": "03:16:20", "text": "鍵。私はあの頭蓋骨を買えると思う"}, {"type": "subtitle", "time": 11784.229, "timestamp": "03:16:24", "text": "鍵。確か、ドクロの鍵は300だったと思う。"}, {"type": "subtitle", "time": 11786.07, "timestamp": "03:16:26", "text": "おお、"}, {"type": "subtitle", "time": 11803.83, "timestamp": "03:16:43", "text": "男。わかった。だから、隣のドアは"}, {"type": "subtitle", "time": 11815.63, "timestamp": "03:16:55", "text": "イエス・キリスト。"}]
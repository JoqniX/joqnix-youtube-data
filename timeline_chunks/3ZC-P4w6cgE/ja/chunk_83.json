[{"type": "subtitle", "time": 4981.03, "timestamp": "01:23:01", "text": "多く。良い一日をお過ごしください。"}, {"type": "subtitle", "time": 4984.189, "timestamp": "01:23:04", "text": "クリスマス休暇を楽しんで、"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "明日はクリスマスだよ、だってまだイブだから"}, {"type": "subtitle", "time": 4990.01, "timestamp": "01:23:10", "text": "あなたのために。メリークリスマス"}, {"type": "subtitle", "time": 4992.03, "timestamp": "01:23:12", "text": "[音楽]"}, {"type": "subtitle", "time": 4994.03, "timestamp": "01:23:14", "text": "イブと"}, {"type": "subtitle", "time": 4998.629, "timestamp": "01:23:18", "text": "ええ、私は男の子ではありません。だから、私は"}, {"type": "subtitle", "time": 5000.27, "timestamp": "01:23:20", "text": "実際に殺す"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "あなた。どういう意味ですか？私は背が低い"}, {"type": "subtitle", "time": 5006.31, "timestamp": "01:23:26", "text": "私たちはロリッシュについて話していて、"}, {"type": "subtitle", "time": 5009.59, "timestamp": "01:23:29", "text": "ファンタジー的な内容だが、低級な無料ゲームだ"}, {"type": "subtitle", "time": 5011.79, "timestamp": "01:23:31", "text": "とは異なり"}, {"type": "subtitle", "time": 5029.87, "timestamp": "01:23:49", "text": "[音楽]"}, {"type": "subtitle", "time": 5032.51, "timestamp": "01:23:52", "text": "まるで来たかのよう"}, {"type": "subtitle", "time": 5035.669, "timestamp": "01:23:55", "text": "今日ここまで来てくれてありがとう。願わくば"}, {"type": "subtitle", "time": 5039.11, "timestamp": "01:23:59", "text": "今日はセントと楽しい時間を過ごしました。皆さんの姿を見ました。"}]
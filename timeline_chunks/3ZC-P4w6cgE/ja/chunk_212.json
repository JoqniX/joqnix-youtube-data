[{"type": "subtitle", "time": 12725.229, "timestamp": "03:32:05", "text": "ニース。こんにちは。壁に寄り添う。壁。"}, {"type": "subtitle", "time": 12727.87, "timestamp": "03:32:07", "text": "うん。時間がかかるだろう。時間がかかる"}, {"type": "subtitle", "time": 12732.55, "timestamp": "03:32:12", "text": "時間。何？わかった。いいえ。"}, {"type": "subtitle", "time": 12741.83, "timestamp": "03:32:21", "text": "何が起こっていますか？何が起こっていますか？"}, {"type": "subtitle", "time": 12743.91, "timestamp": "03:32:23", "text": "何が起こっていますか？わかった。あなたはそうしなかった"}, {"type": "subtitle", "time": 12745.51, "timestamp": "03:32:25", "text": "赤目を見て、だから"}, {"type": "subtitle", "time": 12747.75, "timestamp": "03:32:27", "text": "何かある。それはまるで"}, {"type": "subtitle", "time": 12749.87, "timestamp": "03:32:29", "text": "半分をブロックする"}, {"type": "subtitle", "time": 12755.83, "timestamp": "03:32:35", "text": "ビジョン。わかった。ああ、わかった。あなたが死んだら、えっと"}, {"type": "subtitle", "time": 12758.07, "timestamp": "03:32:38", "text": "視界がぼやけて見えなくなるかもしれない"}, {"type": "subtitle", "time": 12759.83, "timestamp": "03:32:39", "text": "視覚とか、そういう類のものです。だから、"}, {"type": "subtitle", "time": 12760.91, "timestamp": "03:32:40", "text": "心配。その"}, {"type": "subtitle", "time": 12764.11, "timestamp": "03:32:44", "text": "おそらく、あ、待って。わかった。新しい"}, {"type": "subtitle", "time": 12768.389, "timestamp": "03:32:48", "text": "プロンプト。ああ、やばい。"}, {"type": "subtitle", "time": 12771.71, "timestamp": "03:32:51", "text": "これは何の扉ですか？"}, {"type": "subtitle", "time": 12775.349, "timestamp": "03:32:55", "text": "えっと、ドア。"}]
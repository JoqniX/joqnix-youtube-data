[{"type": "subtitle", "time": 12613.75, "timestamp": "03:30:13", "text": "[音楽]"}, {"type": "subtitle", "time": 12615.91, "timestamp": "03:30:15", "text": "私はできるかもしれないと思う"}, {"type": "subtitle", "time": 12619.11, "timestamp": "03:30:19", "text": "蘇生する。そうそう。ああ、神様。実際に"}, {"type": "subtitle", "time": 12627.429, "timestamp": "03:30:27", "text": "なぜ白い炎のようなものがあるのですか？白"}, {"type": "subtitle", "time": 12629.269, "timestamp": "03:30:29", "text": "炎？そうそう。あれがそれだ"}, {"type": "subtitle", "time": 12631.349, "timestamp": "03:30:31", "text": "壁から離れたい場合、"}, {"type": "subtitle", "time": 12633.99, "timestamp": "03:30:33", "text": "それはただ、突然現れた怪物だった。"}, {"type": "subtitle", "time": 12636.229, "timestamp": "03:30:36", "text": "これは、赤が見えるかどうか"}, {"type": "subtitle", "time": 12639.19, "timestamp": "03:30:39", "text": "目、それを見なければならない、そして"}, {"type": "subtitle", "time": 12644.63, "timestamp": "03:30:44", "text": "次のドアへ移動してください。そうそう。"}, {"type": "subtitle", "time": 12647.269, "timestamp": "03:30:47", "text": "次のページを開くと、ああ、くそ。私"}, {"type": "subtitle", "time": 12650.38, "timestamp": "03:30:50", "text": "それについて調べてみました。ああ、わかってるよ。"}]
[{"type": "subtitle", "time": 5525.91, "timestamp": "01:32:05", "text": "はい。来れば来るほど、あなたが来てくれる"}, {"type": "subtitle", "time": 5538.27, "timestamp": "01:32:18", "text": "なんてこった。"}, {"type": "subtitle", "time": 5541.43, "timestamp": "01:32:21", "text": "いいえ。つまり、モーも最善を尽くしているということです。"}, {"type": "subtitle", "time": 5543.43, "timestamp": "01:32:23", "text": "けれど。彼女は"}, {"type": "subtitle", "time": 5546.07, "timestamp": "01:32:26", "text": "彼女はスラッシュ的だと言うけど、少なくとも彼女は"}, {"type": "subtitle", "time": 5547.709, "timestamp": "01:32:27", "text": "行う"}, {"type": "subtitle", "time": 5551.43, "timestamp": "01:32:31", "text": "ウィシに参加するような、あるいは"}, {"type": "subtitle", "time": 5554.11, "timestamp": "01:32:34", "text": "話すことさえも"}, {"type": "subtitle", "time": 5577.629, "timestamp": "01:32:57", "text": "[音楽]"}]
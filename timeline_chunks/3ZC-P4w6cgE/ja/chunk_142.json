[{"type": "subtitle", "time": 8522.23, "timestamp": "02:22:02", "text": "YouTuber、Roblox Minecraft のような"}, {"type": "subtitle", "time": 8526.23, "timestamp": "02:22:06", "text": "YouTuber、イーグルプレイス在住。でも、私が"}, {"type": "subtitle", "time": 8528.389, "timestamp": "02:22:08", "text": "私の夢が突然止まった"}, {"type": "subtitle", "time": 8531.59, "timestamp": "02:22:11", "text": "まるでそう思うと、心が打ち砕かれる"}, {"type": "subtitle", "time": 8534.79, "timestamp": "02:22:14", "text": "少し学んだこと"}, {"type": "subtitle", "time": 8538.469, "timestamp": "02:22:18", "text": "それについて、私がとても熱心だったときのように"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "YouTuberになることは、"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "多くの計画やそのようなものがあり、"}, {"type": "subtitle", "time": 8546.23, "timestamp": "02:22:26", "text": "結局、それは起こらなかった。私は決して"}, {"type": "subtitle", "time": 8548.63, "timestamp": "02:22:28", "text": "ユーチューバーみたいな感じになった。"}, {"type": "subtitle", "time": 8551.349, "timestamp": "02:22:31", "text": "しかし、イマヌエルのケースになると、"}, {"type": "subtitle", "time": 8553.83, "timestamp": "02:22:33", "text": "ちょうど私が思ったように、"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "録画をクリックするか、ストリームを開始して"}, {"type": "subtitle", "time": 8560.309, "timestamp": "02:22:40", "text": "そして今、私はストリーミング配信をしている。"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "そして数字が伸びていくのを見るのが好きです"}, {"type": "subtitle", "time": 8565.03, "timestamp": "02:22:45", "text": "を通して。それはこうだった。私たちは"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "人は物事を計画しようとする傾向がある"}, {"type": "subtitle", "time": 8569.91, "timestamp": "02:22:49", "text": "過度に。それは、"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "私たちがただ"}, {"type": "subtitle", "time": 8574.389, "timestamp": "02:22:54", "text": "計画を立て、次から次へと計画を立て続ける。"}, {"type": "subtitle", "time": 8576.349, "timestamp": "02:22:56", "text": "真実。真実。"}]
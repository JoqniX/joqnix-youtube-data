[{"type": "subtitle", "time": 3301.03, "timestamp": "00:55:01", "text": "さて、どこで話しましょうか？死んだ。死んだ。"}, {"type": "subtitle", "time": 3302.67, "timestamp": "00:55:02", "text": "待って、"}, {"type": "subtitle", "time": 3305.47, "timestamp": "00:55:05", "text": "何？彼は死んだ。"}, {"type": "subtitle", "time": 3307.95, "timestamp": "00:55:07", "text": "死んだ。ない"}, {"type": "subtitle", "time": 3311.109, "timestamp": "00:55:11", "text": "シーシュ。でも、なぜ行くの？なぜ"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "行く人いる？やれやれ。バ。"}, {"type": "subtitle", "time": 3318.069, "timestamp": "00:55:18", "text": "くそ。さあ行こう。入れ続けるべきでしょうか"}, {"type": "subtitle", "time": 3320.71, "timestamp": "00:55:20", "text": "彼らを倒す？ああ、だってこの中に「えー」が入ってるから"}, {"type": "subtitle", "time": 3335.71, "timestamp": "00:55:35", "text": "敵"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "[拍手]"}, {"type": "subtitle", "time": 3345.47, "timestamp": "00:55:45", "text": "気をつけて。私は"}, {"type": "subtitle", "time": 3349.069, "timestamp": "00:55:49", "text": "スパイク。もうすぐ準備完了です。"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "さぁ行こう。"}]
[{"type": "subtitle", "time": 14462.71, "timestamp": "04:01:02", "text": "IM Iman のリンクは"}, {"type": "subtitle", "time": 14464.389, "timestamp": "04:01:04", "text": "説明とピンにも"}, {"type": "subtitle", "time": 14468.51, "timestamp": "04:01:08", "text": "コメント。ええ、彼はTwitterをやっています。"}, {"type": "subtitle", "time": 14471.95, "timestamp": "04:01:11", "text": "彼はインスタグラムとYouTubeも持っています"}, {"type": "subtitle", "time": 14476.03, "timestamp": "04:01:16", "text": "まあ、Twitchもね。彼のTwitchでの配信。"}, {"type": "subtitle", "time": 14479.55, "timestamp": "04:01:19", "text": "こんにちは。今日は本当に"}, {"type": "subtitle", "time": 14483.269, "timestamp": "04:01:23", "text": "楽しい。では、次は"}, {"type": "subtitle", "time": 14486.71, "timestamp": "04:01:26", "text": "本日の次のコラボレーションはVicと"}, {"type": "subtitle", "time": 14488.11, "timestamp": "04:01:28", "text": "アニメ"}, {"type": "subtitle", "time": 14491.269, "timestamp": "04:01:31", "text": "泣く。ええと、ヴィック・チャマは"}, {"type": "subtitle", "time": 14494.15, "timestamp": "04:01:34", "text": "彼と一緒にいるのは、"}, {"type": "subtitle", "time": 14497.03, "timestamp": "04:01:37", "text": "私が配信しているストリーム。どうやら"}, {"type": "subtitle", "time": 14500.309, "timestamp": "04:01:40", "text": "ヴィックは、"}, {"type": "subtitle", "time": 14502.83, "timestamp": "04:01:42", "text": "カット。"}, {"type": "subtitle", "time": 14505.67, "timestamp": "04:01:45", "text": "ええと、そうですね、延期します"}, {"type": "subtitle", "time": 14508.95, "timestamp": "04:01:48", "text": "今日。心配ない。すべて順調です。これ"}, {"type": "subtitle", "time": 14512.429, "timestamp": "04:01:52", "text": "停電を経験する電力"}, {"type": "subtitle", "time": 14515.03, "timestamp": "04:01:55", "text": "起こった。だから、それが戻ってきたら、"}, {"type": "subtitle", "time": 14518.67, "timestamp": "04:01:58", "text": "一緒に遊んだりするんだ。"}]
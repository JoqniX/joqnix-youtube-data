[{"type": "subtitle", "time": 17471.51, "timestamp": "04:51:11", "text": "ニース。はい、7になります。私"}, {"type": "subtitle", "time": 17495.43, "timestamp": "04:51:35", "text": "ええ、あの件の後も、ヴィックのために"}, {"type": "subtitle", "time": 17498.51, "timestamp": "04:51:38", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 17501.59, "timestamp": "04:51:41", "text": "正しいのは、彼の停電です"}, {"type": "subtitle", "time": 17504.23, "timestamp": "04:51:44", "text": "起こった。だから私たちは彼を"}, {"type": "subtitle", "time": 17506.43, "timestamp": "04:51:46", "text": "少し"}, {"type": "subtitle", "time": 17510.23, "timestamp": "04:51:50", "text": "瞬間。ええと、停電は電力です"}, {"type": "subtitle", "time": 17512.59, "timestamp": "04:51:52", "text": "カットが行われている"}, {"type": "subtitle", "time": 17513.84, "timestamp": "04:51:53", "text": "スペイン"}]
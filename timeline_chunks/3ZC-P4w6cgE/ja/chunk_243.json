[{"type": "subtitle", "time": 14580.469, "timestamp": "04:03:00", "text": "あちこちに空きスロットが少しある。えっと"}, {"type": "subtitle", "time": 14581.02, "timestamp": "04:03:01", "text": "のために"}, {"type": "subtitle", "time": 14582.269, "timestamp": "04:03:02", "text": "[音楽]"}, {"type": "subtitle", "time": 14586.95, "timestamp": "04:03:06", "text": "明日、考えてみましょう。えっと、明日は"}, {"type": "subtitle", "time": 14589.71, "timestamp": "04:03:09", "text": "シヨニサと900"}, {"type": "subtitle", "time": 14592.71, "timestamp": "04:03:12", "text": "午後でも、空き枠があります。では、"}, {"type": "subtitle", "time": 14599.51, "timestamp": "04:03:19", "text": "チェック。明日は火曜日ですよね？それで、"}, {"type": "subtitle", "time": 14603.269, "timestamp": "04:03:23", "text": "火曜日、明日、私は"}, {"type": "subtitle", "time": 14607.03, "timestamp": "04:03:27", "text": "えーっと、ちょっと用事があって出かけるんだ"}, {"type": "subtitle", "time": 14610.11, "timestamp": "04:03:30", "text": "父と一緒に。"}, {"type": "subtitle", "time": 14614.07, "timestamp": "04:03:34", "text": "つまり、ある意味では、"}, {"type": "subtitle", "time": 14617.349, "timestamp": "04:03:37", "text": "どんなコラボレーションでも。実際に置けると思う"}, {"type": "subtitle", "time": 14620.11, "timestamp": "04:03:40", "text": "朝の誰か"}, {"type": "subtitle", "time": 14623.12, "timestamp": "04:03:43", "text": "でも、誰に渡せばいいのか分からないんです。"}]
[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "欲しい。そして、お体に気をつけてくださいね。"}, {"type": "subtitle", "time": 4682.47, "timestamp": "01:18:02", "text": "健康にも気を付けて、すべてに気をつけてください。"}, {"type": "subtitle", "time": 4683.709, "timestamp": "01:18:03", "text": "来る"}, {"type": "subtitle", "time": 4688.11, "timestamp": "01:18:08", "text": "その頃にはもうね、ハニー。パパ、さようなら"}, {"type": "subtitle", "time": 4690.189, "timestamp": "01:18:10", "text": "ハニー。こんにちは"}, {"type": "subtitle", "time": 4694.55, "timestamp": "01:18:14", "text": "ハニー。待って。やあ、ベイビー。やあ、待ってて。それで"}, {"type": "subtitle", "time": 4696.669, "timestamp": "01:18:16", "text": "言えません"}, {"type": "subtitle", "time": 4704.229, "timestamp": "01:18:24", "text": "来てくれてありがとう、そしてメリークリスマス！"}, {"type": "subtitle", "time": 4707.03, "timestamp": "01:18:27", "text": "あなたにも。ご来店ありがとうございました"}, {"type": "subtitle", "time": 4710.709, "timestamp": "01:18:30", "text": "そして今日は私たちと話をして過ごしました。希望"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "あなたはとても素敵なクリスマスの頭をしていますね。"}, {"type": "subtitle", "time": 4716.39, "timestamp": "01:18:36", "text": "明日目が覚めたら"}, {"type": "subtitle", "time": 4717.55, "timestamp": "01:18:37", "text": "明日。"}, {"type": "subtitle", "time": 4721.189, "timestamp": "01:18:41", "text": "うん。はい、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 4724.95, "timestamp": "01:18:44", "text": "あなたにもメリークリスマス。それから"}, {"type": "subtitle", "time": 4726.83, "timestamp": "01:18:46", "text": "通りかかった"}, {"type": "subtitle", "time": 4729.189, "timestamp": "01:18:49", "text": "本日はお越しいただきありがとうございます。それは本当に"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "多く。楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "あなたにもクリスマスを、そして"}, {"type": "subtitle", "time": 4737.55, "timestamp": "01:18:57", "text": "リアリティスタジオ。ようこそ、そして楽しいひとときを"}]
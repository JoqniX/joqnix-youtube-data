[{"type": "subtitle", "time": 12302.15, "timestamp": "03:25:02", "text": "彼があなたに危害を加えるとは思わないでください。よし。"}, {"type": "subtitle", "time": 12305.99, "timestamp": "03:25:05", "text": "急ぐ。あなたはまだそれを持っている。うん。私はしません"}, {"type": "subtitle", "time": 12308.15, "timestamp": "03:25:08", "text": "理由を知りなさい。"}, {"type": "subtitle", "time": 12311.03, "timestamp": "03:25:11", "text": "わかった。わかった。ジャンプ。ジャンプ。よし。私 私"}, {"type": "subtitle", "time": 12312.389, "timestamp": "03:25:12", "text": "あなたがそれを使えると思うとき"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "鍵穴が見える。それは"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "再利用。"}, {"type": "subtitle", "time": 12321.15, "timestamp": "03:25:21", "text": "ああ、ここで使えますよ"}, {"type": "subtitle", "time": 12323.91, "timestamp": "03:25:23", "text": "そこには。ああ、そうそう、そのドアの鍵を開けるには、"}, {"type": "subtitle", "time": 12332.79, "timestamp": "03:25:32", "text": "ああ、あの紫色のやつね。うん、続けて"}, {"type": "subtitle", "time": 12334.389, "timestamp": "03:25:34", "text": "走っている。走り続けて隠れてください"}, {"type": "subtitle", "time": 12355.11, "timestamp": "03:25:55", "text": "何てことだ。 2番目のライトを使用してください"}, {"type": "subtitle", "time": 12357.349, "timestamp": "03:25:57", "text": "だって、もし君が暗闇の中を走ったら、私は"}, {"type": "subtitle", "time": 12358.55, "timestamp": "03:25:58", "text": "ナビゲートするのは難しいと思う"}]
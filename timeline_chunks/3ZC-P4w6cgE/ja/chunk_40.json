[{"type": "subtitle", "time": 2408.23, "timestamp": "00:40:08", "text": "待って、連続で。え、何？何だって？"}, {"type": "subtitle", "time": 2409.55, "timestamp": "00:40:09", "text": "エージェント？"}, {"type": "subtitle", "time": 2412.67, "timestamp": "00:40:12", "text": "何？私は被弾しなかった。"}, {"type": "subtitle", "time": 2417.31, "timestamp": "00:40:17", "text": "何？彼はどのエージェントと言ったのですか？戻る"}, {"type": "subtitle", "time": 2433.91, "timestamp": "00:40:33", "text": "ああ、彼らはこの男を選ぶんだ。"}, {"type": "subtitle", "time": 2435.829, "timestamp": "00:40:35", "text": "ごめん。"}, {"type": "subtitle", "time": 2459.15, "timestamp": "00:40:59", "text": "[音楽]"}]
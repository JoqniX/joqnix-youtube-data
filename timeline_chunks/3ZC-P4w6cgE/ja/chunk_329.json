[{"type": "subtitle", "time": 19743.59, "timestamp": "05:29:03", "text": "色に加えて黒。あるいはこう言うこともできます"}, {"type": "subtitle", "time": 19747.548, "timestamp": "05:29:07", "text": "虹色のようなプラス"}, {"type": "subtitle", "time": 19750.788, "timestamp": "05:29:10", "text": "黒。でも私は青の方が好きで"}, {"type": "subtitle", "time": 19759.868, "timestamp": "05:29:19", "text": "もっと。私も赤みがかった色をしている。赤くない"}, {"type": "subtitle", "time": 19769.07, "timestamp": "05:29:29", "text": "ピンクがかった。"}, {"type": "subtitle", "time": 19772.07, "timestamp": "05:29:32", "text": "こんにちは。これは私の目に映ったものです。あなたはなれます"}, {"type": "subtitle", "time": 19775.91, "timestamp": "05:29:35", "text": "次はなぜジョックなのかと尋ねる。ああ、あなたの一時的な"}, {"type": "subtitle", "time": 19779.03, "timestamp": "05:29:39", "text": "モデルは、2つも持っていなかった"}, {"type": "subtitle", "time": 19780.868, "timestamp": "05:29:40", "text": "異なる色。なぜ"}, {"type": "subtitle", "time": 19783.19, "timestamp": "05:29:43", "text": "今は色が違いますか？"}, {"type": "subtitle", "time": 19786.15, "timestamp": "05:29:46", "text": "それで、えーと、ストーリーのために、"}, {"type": "subtitle", "time": 19790.75, "timestamp": "05:29:50", "text": "一時的な私は確信が持てませんでした"}, {"type": "subtitle", "time": 19795.868, "timestamp": "05:29:55", "text": "そうすることで、私はよく夜更かししました"}, {"type": "subtitle", "time": 19799.868, "timestamp": "05:29:59", "text": "一晩中ブレインストーミングして考えた"}]
[{"type": "subtitle", "time": 17761.628, "timestamp": "04:56:01", "text": "手が震えているように見える"}, {"type": "subtitle", "time": 17771.67, "timestamp": "04:56:11", "text": "ねえ、あれは何？あれは何だろう。私"}, {"type": "subtitle", "time": 17800.67, "timestamp": "04:56:40", "text": "ポケモン？おい。"}, {"type": "subtitle", "time": 17808.31, "timestamp": "04:56:48", "text": "ミナ、えっと、これをする前に、私が"}, {"type": "subtitle", "time": 17811.99, "timestamp": "04:56:51", "text": "実際、それを明らかにします。"}, {"type": "subtitle", "time": 17813.868, "timestamp": "04:56:53", "text": "えっと、言いたいのは"}, {"type": "subtitle", "time": 17817.31, "timestamp": "04:56:57", "text": "それは、えっと、始まったようなもの"}, {"type": "subtitle", "time": 17819.788, "timestamp": "04:56:59", "text": "旅の旅は実際には"}]
[{"type": "subtitle", "time": 257.15, "timestamp": "00:04:17", "text": "スチームビーコンをスパイクに取り付けると"}, {"type": "subtitle", "time": 260.189, "timestamp": "00:04:20", "text": "増やさない"}, {"type": "subtitle", "time": 263.83, "timestamp": "00:04:23", "text": "期間は長いけど、すごいね。"}, {"type": "subtitle", "time": 265.67, "timestamp": "00:04:25", "text": "さらに、ゲームに収録されている音楽トラックも素晴らしい。"}, {"type": "subtitle", "time": 274.35, "timestamp": "00:04:34", "text": "見ていません。私はまだ完全に"}, {"type": "subtitle", "time": 282.469, "timestamp": "00:04:42", "text": "煙は収まった。"}]
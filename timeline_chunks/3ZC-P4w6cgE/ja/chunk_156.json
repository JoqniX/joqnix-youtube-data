[{"type": "subtitle", "time": 9361.11, "timestamp": "02:36:01", "text": "ライター。"}, {"type": "subtitle", "time": 9363.11, "timestamp": "02:36:03", "text": "何てことだ。"}, {"type": "subtitle", "time": 9365.51, "timestamp": "02:36:05", "text": "あれは何だったんだ？何？何が"}, {"type": "subtitle", "time": 9367.91, "timestamp": "02:36:07", "text": "それ？まるでスターのようでしたか？"}, {"type": "subtitle", "time": 9370.63, "timestamp": "02:36:10", "text": "わかった。そう、私が欲しいもの、私が欲しいもの"}, {"type": "subtitle", "time": 9372.63, "timestamp": "02:36:12", "text": "それが何をするのか、どのようにするのかを思い出す"}, {"type": "subtitle", "time": 9374.55, "timestamp": "02:36:14", "text": "それに対抗する。あなたはそうするべきだと思う"}, {"type": "subtitle", "time": 9378.11, "timestamp": "02:36:18", "text": "それがあなたに腹を立てている時に、それを見てください。"}, {"type": "subtitle", "time": 9382.79, "timestamp": "02:36:22", "text": "ああ、逃げて逃げて隠れて。隠す、隠す。"}, {"type": "subtitle", "time": 9385.11, "timestamp": "02:36:25", "text": "どこ？ああ、くそ。えっと、戸棚に隠れるか"}, {"type": "subtitle", "time": 9387.91, "timestamp": "02:36:27", "text": "ベッドを使うか、隣の部屋に行く。 I へ移動"}, {"type": "subtitle", "time": 9389.27, "timestamp": "02:36:29", "text": "亡くなった。"}, {"type": "subtitle", "time": 9391.07, "timestamp": "02:36:31", "text": "ああ、しまった。おお"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "くそっ。ああ、くそ。くそっ。はい、試してみます"}, {"type": "subtitle", "time": 9398.87, "timestamp": "02:36:38", "text": "これをスピードランでクリアしよう。ああ、最悪だ。待って、"}, {"type": "subtitle", "time": 9402.389, "timestamp": "02:36:42", "text": "私には戻る道はない。いや、違うよ。私"}, {"type": "subtitle", "time": 9407.19, "timestamp": "02:36:47", "text": "考えろ、待て。あ、待って。できますか"}, {"type": "subtitle", "time": 9411.99, "timestamp": "02:36:51", "text": "おお。 30. ああ、もう無理。まあ、いいでしょう。"}, {"type": "subtitle", "time": 9415.67, "timestamp": "02:36:55", "text": "まあ、大丈夫だよ。"}, {"type": "subtitle", "time": 9419.19, "timestamp": "02:36:59", "text": "ああ、無理です。わかった。待って、あなたは"}]
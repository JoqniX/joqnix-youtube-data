[{"type": "subtitle", "time": 10503.429, "timestamp": "02:55:03", "text": "完全に黒色。でも、えっと、でも"}, {"type": "subtitle", "time": 10505.03, "timestamp": "02:55:05", "text": "反対側の場合は、"}, {"type": "subtitle", "time": 10506.67, "timestamp": "02:55:06", "text": "光り輝くように"}, {"type": "subtitle", "time": 10516.67, "timestamp": "02:55:16", "text": "おお"}, {"type": "subtitle", "time": 10519.349, "timestamp": "02:55:19", "text": "神。私たちはどのドアに行けばいいのですか？"}, {"type": "subtitle", "time": 10525.07, "timestamp": "02:55:25", "text": "ああ、言わないで。"}, {"type": "subtitle", "time": 10527.269, "timestamp": "02:55:27", "text": "おお。あ、待って。私は実際には支払っていません"}, {"type": "subtitle", "time": 10530.469, "timestamp": "02:55:30", "text": "注意。なんてこった。いいえ。いいえ。"}, {"type": "subtitle", "time": 10532.87, "timestamp": "02:55:32", "text": "ロック。つまり、必要なのは"}, {"type": "subtitle", "time": 10536.63, "timestamp": "02:55:36", "text": "鍵を見つけるために。はい。えっと、このドアには"}, {"type": "subtitle", "time": 10538.07, "timestamp": "02:55:38", "text": "錠前。それでは、"}, {"type": "subtitle", "time": 10540.79, "timestamp": "02:55:40", "text": "それには鍵がある。もしそれがなければ、私は"}, {"type": "subtitle", "time": 10556.87, "timestamp": "02:55:56", "text": "鍵を受け取った。ああ、わかった。ごめん。わかった、"}, {"type": "subtitle", "time": 10558.63, "timestamp": "02:55:58", "text": "どうでも。すべて 何ですか 何ですか"}]
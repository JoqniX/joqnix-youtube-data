[{"type": "subtitle", "time": 19384.15, "timestamp": "05:23:04", "text": "推測？ズームしましたか？見えない"}, {"type": "subtitle", "time": 19388.03, "timestamp": "05:23:08", "text": "えーと、星。ああ、君には見えないよ。ああ、何"}, {"type": "subtitle", "time": 19397.19, "timestamp": "05:23:17", "text": "その前に、その前に、えーと"}, {"type": "subtitle", "time": 19401.99, "timestamp": "05:23:21", "text": "実際に何かやってみるよ、だってズームがあるから"}, {"type": "subtitle", "time": 19404.35, "timestamp": "05:23:24", "text": "私のディスプレイ上の何か"}, {"type": "subtitle", "time": 19431.15, "timestamp": "05:23:51", "text": "[音楽]"}]
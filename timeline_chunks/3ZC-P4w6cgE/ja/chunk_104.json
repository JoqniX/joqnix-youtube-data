[{"type": "subtitle", "time": 6242.95, "timestamp": "01:44:02", "text": "ゲーム。待って、ああ、そうだ。忘れた。もし"}, {"type": "subtitle", "time": 6245.669, "timestamp": "01:44:05", "text": "BT TV拡張機能をお持ちの場合は、実行してください。私"}, {"type": "subtitle", "time": 6255.14, "timestamp": "01:44:15", "text": "感情表現。絵文字機能があることを忘れてた。"}, {"type": "subtitle", "time": 6261.75, "timestamp": "01:44:21", "text": "ええと、他に誰が配信していたんですか？"}, {"type": "subtitle", "time": 6266.109, "timestamp": "01:44:26", "text": "えっと、最近新しい"}, {"type": "subtitle", "time": 6268.55, "timestamp": "01:44:28", "text": "発見されました、コミュニティへようこそ"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "えっと、私に歌を歌ってくれた。ええ、彼らは"}, {"type": "subtitle", "time": 6276.629, "timestamp": "01:44:36", "text": "ストリーミング配信も行われていた。"}, {"type": "subtitle", "time": 6280.39, "timestamp": "01:44:40", "text": "そして最善を尽くしてくれた人たち"}, {"type": "subtitle", "time": 6282.87, "timestamp": "01:44:42", "text": "実際に生きた人たちのように"}, {"type": "subtitle", "time": 6285.79, "timestamp": "01:44:45", "text": "クリスマスイブとクリスマスのストリーミング配信"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "ベストを尽くしたクリスマスと"}, {"type": "subtitle", "time": 6291.87, "timestamp": "01:44:51", "text": "デート中の人がいる"}, {"type": "subtitle", "time": 6295.35, "timestamp": "01:44:55", "text": "特別な、あるいは祝うような"}, {"type": "subtitle", "time": 6297.43, "timestamp": "01:44:57", "text": "家族と過ごすクリスマス、または"}]
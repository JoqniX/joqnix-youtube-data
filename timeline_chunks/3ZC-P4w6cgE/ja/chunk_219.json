[{"type": "subtitle", "time": 13142.469, "timestamp": "03:39:02", "text": "右？ああ、あなたが不足しているとき"}, {"type": "subtitle", "time": 13146.79, "timestamp": "03:39:06", "text": "時間に関して、このことの上で私は思う"}, {"type": "subtitle", "time": 13149.349, "timestamp": "03:39:09", "text": "あなたがそうだったとき、それはそうでした。うん。そうだった"}, {"type": "subtitle", "time": 13151.99, "timestamp": "03:39:11", "text": "まるで真っ赤に光っているかのようだ。ええと、それは分かりません。"}, {"type": "subtitle", "time": 13153.99, "timestamp": "03:39:13", "text": "早く入らないといけないと思うよ、さもないと"}, {"type": "subtitle", "time": 13157.59, "timestamp": "03:39:17", "text": "死ぬかもしれない。ああ、それは"}, {"type": "subtitle", "time": 13159.349, "timestamp": "03:39:19", "text": "金庫を開けた瞬間、"}, {"type": "subtitle", "time": 13164.12, "timestamp": "03:39:24", "text": "開けた人にとって危険"}, {"type": "subtitle", "time": 13167.389, "timestamp": "03:39:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13170.07, "timestamp": "03:39:30", "text": "それ。実際に開けてみたことはありません。"}, {"type": "subtitle", "time": 13172.67, "timestamp": "03:39:32", "text": "ああ、壁も抱きしめて。"}, {"type": "subtitle", "time": 13176.469, "timestamp": "03:39:36", "text": "なんてこった。"}, {"type": "subtitle", "time": 13181.83, "timestamp": "03:39:41", "text": "ああ、私は死んだ。ああ、くそ。くそ。"}, {"type": "subtitle", "time": 13185.91, "timestamp": "03:39:45", "text": "ああ、なんてこった。完全な形でお会いしましょう"}, {"type": "subtitle", "time": 13189.67, "timestamp": "03:39:49", "text": "失態。え、死んだの？いいえ、していません"}, {"type": "subtitle", "time": 13192.469, "timestamp": "03:39:52", "text": "死ぬ。私は自分が"}, {"type": "subtitle", "time": 13195.03, "timestamp": "03:39:55", "text": "死ぬ。私はめちゃくちゃうろついていた。"}, {"type": "subtitle", "time": 13198.39, "timestamp": "03:39:58", "text": "それから私は見た"}]
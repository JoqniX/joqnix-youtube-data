[{"type": "subtitle", "time": 122.23, "timestamp": "00:02:02", "text": "私は本当にそのコンセプトが大好きです"}, {"type": "subtitle", "time": 126.389, "timestamp": "00:02:06", "text": "ホン・カイは"}, {"type": "subtitle", "time": 129.35, "timestamp": "00:02:09", "text": "えーと、新しいイベントが開催中で"}, {"type": "subtitle", "time": 132.22899999999998, "timestamp": "00:02:12", "text": "ハンガリー帝国のゲームは、"}, {"type": "subtitle", "time": 135.83, "timestamp": "00:02:15", "text": "腐敗したり、いろいろと、ほら、"}, {"type": "subtitle", "time": 138.43, "timestamp": "00:02:18", "text": "困っているし、"}, {"type": "subtitle", "time": 140.949, "timestamp": "00:02:20", "text": "管理人の少女が入ってきて、"}, {"type": "subtitle", "time": 143.67000000000002, "timestamp": "00:02:23", "text": "ゲームなどを修正する"}, {"type": "subtitle", "time": 145.82999999999998, "timestamp": "00:02:25", "text": "そして、そう。そしてすべてのキャラクターは"}, {"type": "subtitle", "time": 148.39, "timestamp": "00:02:28", "text": "まるでゲームループのようだ。私たちは彼らの記憶を修復する"}, {"type": "subtitle", "time": 151.11, "timestamp": "00:02:31", "text": "そしてデータベース関連のものすべて。それは"}, {"type": "subtitle", "time": 153.07, "timestamp": "00:02:33", "text": "いいね。いいね。私は愛する"}, {"type": "subtitle", "time": 156.15, "timestamp": "00:02:36", "text": "それ。それが私にいくつかのアイデアを与えてくれた"}, {"type": "subtitle", "time": 157.55, "timestamp": "00:02:37", "text": "のために"}, {"type": "subtitle", "time": 160.07, "timestamp": "00:02:40", "text": "自分自身。 「うわー、それはとても"}, {"type": "subtitle", "time": 176.63, "timestamp": "00:02:56", "text": "バイバイ。"}]
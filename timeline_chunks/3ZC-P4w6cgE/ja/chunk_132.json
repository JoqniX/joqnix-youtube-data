[{"type": "subtitle", "time": 7920.709, "timestamp": "02:12:00", "text": "このアート作品を完成させてください"}, {"type": "subtitle", "time": 7924.069, "timestamp": "02:12:04", "text": "1日か2日でスピードランするため"}, {"type": "subtitle", "time": 7927.189, "timestamp": "02:12:07", "text": "離れて。でも、それはむしろ"}, {"type": "subtitle", "time": 7930.629, "timestamp": "02:12:10", "text": "いや、それはスチールランだ。えっと、私は"}, {"type": "subtitle", "time": 7933.75, "timestamp": "02:12:13", "text": "アニメがリリースされるのを待っている"}, {"type": "subtitle", "time": 7935.99, "timestamp": "02:12:15", "text": "トレーラー。つまり、アニメの予告編は"}, {"type": "subtitle", "time": 7938.55, "timestamp": "02:12:18", "text": "落とす。ということで、当面は"}, {"type": "subtitle", "time": 7941.669, "timestamp": "02:12:21", "text": "スティール・ボール・ランの盛り上がりを維持して、いいね！"}, {"type": "subtitle", "time": 7943.83, "timestamp": "02:12:23", "text": "おそらくジョジョファンも何人か来るだろう"}, {"type": "subtitle", "time": 7946.79, "timestamp": "02:12:26", "text": "私のコミュニティにも。しかし、"}, {"type": "subtitle", "time": 7949.03, "timestamp": "02:12:29", "text": "それは、私が計画しているように、"}, {"type": "subtitle", "time": 7951.39, "timestamp": "02:12:31", "text": "よし、毎月絵を描いてみるよ"}, {"type": "subtitle", "time": 7954.95, "timestamp": "02:12:34", "text": "鋼鉄製の各文字のピース"}, {"type": "subtitle", "time": 7957.83, "timestamp": "02:12:37", "text": "ボールランでジョジョを手に入れたい"}, {"type": "subtitle", "time": 7959.79, "timestamp": "02:12:39", "text": "ファン。"}, {"type": "subtitle", "time": 7963.83, "timestamp": "02:12:43", "text": "でもそれは私の邪魔をしている"}, {"type": "subtitle", "time": 7965.75, "timestamp": "02:12:45", "text": "漫画も同様です。"}, {"type": "subtitle", "time": 7967.47, "timestamp": "02:12:47", "text": "うん。"}, {"type": "subtitle", "time": 7969.229, "timestamp": "02:12:49", "text": "[音楽]"}, {"type": "subtitle", "time": 7972.709, "timestamp": "02:12:52", "text": "ああ、君はいつか漫画を完成させるだろう。"}, {"type": "subtitle", "time": 7976.149, "timestamp": "02:12:56", "text": "楽しみにしています。"}, {"type": "subtitle", "time": 7978.95, "timestamp": "02:12:58", "text": "そう願っています。あなたはどうですか？"}]
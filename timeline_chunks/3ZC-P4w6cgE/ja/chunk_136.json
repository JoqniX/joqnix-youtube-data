[{"type": "subtitle", "time": 8162.149, "timestamp": "02:16:02", "text": "それについて調べてみてください。たくさんの"}, {"type": "subtitle", "time": 8169.83, "timestamp": "02:16:09", "text": "うん。まあ、うまくいくといいですね。"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "うん。"}, {"type": "subtitle", "time": 8175.43, "timestamp": "02:16:15", "text": "一時休止したけど、その後はうん。一度手に入れると"}, {"type": "subtitle", "time": 8177.109, "timestamp": "02:16:17", "text": "新しい家では、ついに実際に"}, {"type": "subtitle", "time": 8179.03, "timestamp": "02:16:19", "text": "ストリーミング配信に戻ります。そういう時は"}, {"type": "subtitle", "time": 8181.189, "timestamp": "02:16:21", "text": "自分だけの本当の空間。うん。真実。"}, {"type": "subtitle", "time": 8183.99, "timestamp": "02:16:23", "text": "真実。そして、アップロードを確実にしなければならない"}, {"type": "subtitle", "time": 8186.95, "timestamp": "02:16:26", "text": "何かも手に入れたので"}, {"type": "subtitle", "time": 8189.189, "timestamp": "02:16:29", "text": "YouTubeのパートナープログラムみたいなやつですよね？だから私は"}, {"type": "subtitle", "time": 8192.79, "timestamp": "02:16:32", "text": "それもなくなってほしくない。ああ、君"}, {"type": "subtitle", "time": 8195.83, "timestamp": "02:16:35", "text": "YouTubeパートナーシップを獲得しました。うん、そうだよ"}, {"type": "subtitle", "time": 8197.91, "timestamp": "02:16:37", "text": "収益化の仕組みを手に入れて"}, {"type": "subtitle", "time": 8201.669, "timestamp": "02:16:41", "text": "ついに全てが終わった。ああ、くそ。"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "私はそれがなくなることを望んでいません。もしそれが"}, {"type": "subtitle", "time": 8206.23, "timestamp": "02:16:46", "text": "それは多くの努力の末に起こった"}, {"type": "subtitle", "time": 8208.709, "timestamp": "02:16:48", "text": "そして私はそれを失いたくない、私は"}, {"type": "subtitle", "time": 8213.589, "timestamp": "02:16:53", "text": "悲しい。おお。おお。だから、くそ。えーと、つまり、私は"}, {"type": "subtitle", "time": 8215.27, "timestamp": "02:16:55", "text": "たぶん、もしあなたが、いや、もし"}, {"type": "subtitle", "time": 8216.95, "timestamp": "02:16:56", "text": "あなたが動画をアップロードし続けると、"}, {"type": "subtitle", "time": 8219.19, "timestamp": "02:16:59", "text": "楽しいですよね？"}]
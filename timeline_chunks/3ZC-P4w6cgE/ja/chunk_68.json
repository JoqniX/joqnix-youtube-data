[{"type": "subtitle", "time": 4080.19, "timestamp": "01:08:00", "text": "または3つの完全な"}, {"type": "subtitle", "time": 4084.39, "timestamp": "01:08:04", "text": "ストリーム。オカか"}, {"type": "subtitle", "time": 4086.109, "timestamp": "01:08:06", "text": "もしそれが"}, {"type": "subtitle", "time": 4088.87, "timestamp": "01:08:08", "text": "普段は私のことを"}, {"type": "subtitle", "time": 4090.71, "timestamp": "01:08:10", "text": "様々な種類のゲームをプレイする、"}, {"type": "subtitle", "time": 4094.43, "timestamp": "01:08:14", "text": "右？私たちはあらゆる"}, {"type": "subtitle", "time": 4097.189, "timestamp": "01:08:17", "text": "ストリーム。でも、そう、それで私は"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "少しだけ変えて"}, {"type": "subtitle", "time": 4103.03, "timestamp": "01:08:23", "text": "今週。今週とは来週のこと"}, {"type": "subtitle", "time": 4105.669, "timestamp": "01:08:25", "text": "えっと、25日。次は、ええと、来週のことです。"}, {"type": "subtitle", "time": 4109.03, "timestamp": "01:08:29", "text": "ええ、私にとって日曜日は"}, {"type": "subtitle", "time": 4110.669, "timestamp": "01:08:30", "text": "私にとって新しい週が始まりました。しかし"}, {"type": "subtitle", "time": 4113.91, "timestamp": "01:08:33", "text": "ええ、それで、私は考えていたのですが"}, {"type": "subtitle", "time": 4116.269, "timestamp": "01:08:36", "text": "プレイ um"}, {"type": "subtitle", "time": 4118.51, "timestamp": "01:08:38", "text": "ヴァレラント3人分"}, {"type": "subtitle", "time": 4120.87, "timestamp": "01:08:40", "text": "ストリーム。それはやりすぎでしょうか？私"}, {"type": "subtitle", "time": 4122.95, "timestamp": "01:08:42", "text": "わからない。いいえ、これは"}, {"type": "subtitle", "time": 4125.11, "timestamp": "01:08:45", "text": "ヴァレラントのストリームだけどね。ええ、"}, {"type": "subtitle", "time": 4127.269, "timestamp": "01:08:47", "text": "ストリーム、タイトルはJust"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "チャットとメリークリスマス、ストリーム"}, {"type": "subtitle", "time": 4132.55, "timestamp": "01:08:52", "text": "Valerinのプレイリストに追加されます"}, {"type": "subtitle", "time": 4136.47, "timestamp": "01:08:56", "text": "9回目のヴァレリン配信、だって私たちはプレイしたから"}, {"type": "subtitle", "time": 4138.709, "timestamp": "01:08:58", "text": "ヴァレラントは2時間か1時間くらい"}]
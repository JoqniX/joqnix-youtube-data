[{"type": "subtitle", "time": 15160.71, "timestamp": "04:12:40", "text": "ええと、木本さんに連絡を取りたいのですが、"}, {"type": "subtitle", "time": 15164.389, "timestamp": "04:12:44", "text": "でも、彼に無理強いすべきではないと思う"}, {"type": "subtitle", "time": 15166.389, "timestamp": "04:12:46", "text": "彼が行くので、私は配信しています"}, {"type": "subtitle", "time": 15169.75, "timestamp": "04:12:49", "text": "いろいろなことを通してね。私はただ"}, {"type": "subtitle", "time": 15171.15, "timestamp": "04:12:51", "text": "と話す"}, {"type": "subtitle", "time": 15174.51, "timestamp": "04:12:54", "text": "彼ら。そっちの方が気分がいい"}, {"type": "subtitle", "time": 15177.59, "timestamp": "04:12:57", "text": "彼を乗せるのではなく"}, {"type": "subtitle", "time": 15179.87, "timestamp": "04:12:59", "text": "コラボレーションまたは"}]
[{"type": "subtitle", "time": 736.23, "timestamp": "00:12:16", "text": "遊びたい？遊ぼう。さあ"}, {"type": "subtitle", "time": 744.069, "timestamp": "00:12:24", "text": "興ざめな人は雨が降るのを見ていなかった"}, {"type": "subtitle", "time": 744.91, "timestamp": "00:12:24", "text": "行く"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "今、あなたはヴァルと遊んでいて、それを言いませんでした"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "私たち。つまり、私はヴァラーをプレイし始めたばかりなんです"}, {"type": "subtitle", "time": 764.829, "timestamp": "00:12:44", "text": "そして"}, {"type": "subtitle", "time": 767.67, "timestamp": "00:12:47", "text": "アオク、君が君だった時、そして、そこに留まって"}, {"type": "subtitle", "time": 770.67, "timestamp": "00:12:50", "text": "当時ストリーミング配信されていた。私はちょうど"}, {"type": "subtitle", "time": 773.75, "timestamp": "00:12:53", "text": "チャットして、それから私は切り替えました"}]
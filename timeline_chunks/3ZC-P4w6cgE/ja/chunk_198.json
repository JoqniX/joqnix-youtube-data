[{"type": "subtitle", "time": 11899.91, "timestamp": "03:18:19", "text": "75. わかりました。これは追跡シーンです。私"}, {"type": "subtitle", "time": 11902.469, "timestamp": "03:18:22", "text": "このシーンで100点満点になるかもしれない。"}, {"type": "subtitle", "time": 11905.11, "timestamp": "03:18:25", "text": "よくわからない。"}, {"type": "subtitle", "time": 11907.269, "timestamp": "03:18:27", "text": "おそらく80歳。"}, {"type": "subtitle", "time": 11937.71, "timestamp": "03:18:57", "text": "最悪だ。どちらのドアがどれなのか、私には分かりません。"}, {"type": "subtitle", "time": 11939.95, "timestamp": "03:18:59", "text": "80. 言ってください"}]
[{"type": "subtitle", "time": 4381.03, "timestamp": "01:13:01", "text": "今日訪れた人々。 H すべて"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "今日立ち寄った人々。ああ、来た"}, {"type": "subtitle", "time": 4386.669, "timestamp": "01:13:06", "text": "本日の新鮮な商品です。"}, {"type": "subtitle", "time": 4390.149, "timestamp": "01:13:10", "text": "はい、今日は来てくれてありがとう。良い"}, {"type": "subtitle", "time": 4392.95, "timestamp": "01:13:12", "text": "良いクリスマスイブを。まだだと思います"}, {"type": "subtitle", "time": 4396.709, "timestamp": "01:13:16", "text": "あなたにとってはまだクリスマス24日ですね。私は思う"}, {"type": "subtitle", "time": 4399.43, "timestamp": "01:13:19", "text": "私は保険に加入しています。わからない。ええ、でも"}, {"type": "subtitle", "time": 4405.43, "timestamp": "01:13:25", "text": "クリスマス。はい。まだ24日の夜だ"}, {"type": "subtitle", "time": 4407.63, "timestamp": "01:13:27", "text": "あなたのために。それで、"}, {"type": "subtitle", "time": 4410.79, "timestamp": "01:13:30", "text": "うん。メリークリスマス。離れる。そしていいえ"}, {"type": "subtitle", "time": 4413.59, "timestamp": "01:13:33", "text": "素敵な息子が今日来てくれた。パンがやって来て"}, {"type": "subtitle", "time": 4416.51, "timestamp": "01:13:36", "text": "来るべき人々のためにパンを捧げましょう"}, {"type": "subtitle", "time": 4420.669, "timestamp": "01:13:40", "text": "また、によっても。メリークリスマス"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "良い。お越しいただきありがとうございます。私を置いていって"}, {"type": "subtitle", "time": 4427.27, "timestamp": "01:13:47", "text": "たくさん。そして今日彼が来て私にくれた"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "二つの贈り物。ドーナツが1つと、もう1つは"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "剣を絵文字として表現する。"}, {"type": "subtitle", "time": 4439.11, "timestamp": "01:13:59", "text": "ディオ、二つの贈り物をありがとう。"}]
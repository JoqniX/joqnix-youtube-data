[{"type": "subtitle", "time": 4740.229, "timestamp": "01:19:00", "text": "クリスマス。そして新しい部分が"}, {"type": "subtitle", "time": 4743.79, "timestamp": "01:19:03", "text": "私のチャンネルを見つけた人は"}, {"type": "subtitle", "time": 4746.75, "timestamp": "01:19:06", "text": "フィリピン。彼らの名前は"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "マヒカサ。マヒカサさん、来てくれてありがとう"}, {"type": "subtitle", "time": 4752.99, "timestamp": "01:19:12", "text": "流れに身を任せ、また自分の発見をする"}, {"type": "subtitle", "time": 4755.99, "timestamp": "01:19:15", "text": "ストリーム配信、そしてメリークリスマス"}, {"type": "subtitle", "time": 4758.47, "timestamp": "01:19:18", "text": "本日は私と交流していただき、ありがとうございました。"}, {"type": "subtitle", "time": 4761.51, "timestamp": "01:19:21", "text": "十分に楽しんでいただければ幸いです。もしあなたが持っているなら"}, {"type": "subtitle", "time": 4764.75, "timestamp": "01:19:24", "text": "時が来れば、未来のエビがやってくる。"}, {"type": "subtitle", "time": 4768.189, "timestamp": "01:19:28", "text": "わかった。ご来場ありがとうございました"}, {"type": "subtitle", "time": 4773.39, "timestamp": "01:19:33", "text": "による。こんにちは。ロンさん、ようこそ！"}, {"type": "subtitle", "time": 4774.91, "timestamp": "01:19:34", "text": "Xa。"}, {"type": "subtitle", "time": 4779.87, "timestamp": "01:19:39", "text": "それで、ミカと"}, {"type": "subtitle", "time": 4783.43, "timestamp": "01:19:43", "text": "吸血鬼。 MsonとVamp、来てくれてありがとう"}, {"type": "subtitle", "time": 4785.99, "timestamp": "01:19:45", "text": "による。皆さんに楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 4790.35, "timestamp": "01:19:50", "text": "H、そして皆さん、メリークリスマス！"}, {"type": "subtitle", "time": 4795.83, "timestamp": "01:19:55", "text": "あまりにも。ありがとう。それから私は公式のBRM5に"}, {"type": "subtitle", "time": 4798.63, "timestamp": "01:19:58", "text": "そしてRoblox。それは新しい名前です"}]
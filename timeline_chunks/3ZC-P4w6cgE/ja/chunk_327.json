[{"type": "subtitle", "time": 19623.43, "timestamp": "05:27:03", "text": "えっと、ヘアバンドですね。だって本当に"}, {"type": "subtitle", "time": 19627.51, "timestamp": "05:27:07", "text": "青色が本当に好きです。"}, {"type": "subtitle", "time": 19631.708, "timestamp": "05:27:11", "text": "濃い青のような青色。これは何の青色ですか？"}, {"type": "subtitle", "time": 19633.948, "timestamp": "05:27:13", "text": "また？"}, {"type": "subtitle", "time": 19642.03, "timestamp": "05:27:22", "text": "また。音楽は止まったのか？"}, {"type": "subtitle", "time": 19650.03, "timestamp": "05:27:30", "text": "停止。なぜやめるのですか？停止。なぜやめるのですか？"}, {"type": "subtitle", "time": 19653.788, "timestamp": "05:27:33", "text": "停止。おい。おい。これは私の"}, {"type": "subtitle", "time": 19656.91, "timestamp": "05:27:36", "text": "ヘアバンド。ヘアバンド番号"}, {"type": "subtitle", "time": 19661.788, "timestamp": "05:27:41", "text": "1つ。ああ、私は青色が好きです"}, {"type": "subtitle", "time": 19667.39, "timestamp": "05:27:47", "text": "多く。海を表す青色ですよね？青は"}, {"type": "subtitle", "time": 19670.868, "timestamp": "05:27:50", "text": "つまり、えっと、青。青色"}, {"type": "subtitle", "time": 19675.788, "timestamp": "05:27:55", "text": "より私と深く繋がったように感じました。"}, {"type": "subtitle", "time": 19678.628, "timestamp": "05:27:58", "text": "うん。そして"}]
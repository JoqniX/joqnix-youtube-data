[{"type": "subtitle", "time": 19568.15, "timestamp": "05:26:08", "text": "レオ。だから、もっと繋がりたいと思ったんです"}, {"type": "subtitle", "time": 19571.59, "timestamp": "05:26:11", "text": "星々と共に、宇宙と共に。まるで私が"}, {"type": "subtitle", "time": 19574.47, "timestamp": "05:26:14", "text": "輝きたかった。私は実際に"}, {"type": "subtitle", "time": 19577.708, "timestamp": "05:26:17", "text": "輝く"}, {"type": "subtitle", "time": 19579.47, "timestamp": "05:26:19", "text": "星。"}, {"type": "subtitle", "time": 19583.39, "timestamp": "05:26:23", "text": "うん。もっと輝きたい。"}, {"type": "subtitle", "time": 19585.628, "timestamp": "05:26:25", "text": "より明るいあなた"}, {"type": "subtitle", "time": 19588.67, "timestamp": "05:26:28", "text": "今後、"}, {"type": "subtitle", "time": 19592.27, "timestamp": "05:26:32", "text": "旅は、その輝きを広めたいと思った"}, {"type": "subtitle", "time": 19595.39, "timestamp": "05:26:35", "text": "光が輝いている"}, {"type": "subtitle", "time": 19599.27, "timestamp": "05:26:39", "text": "ミナ、皆さんに温かさを。"}, {"type": "subtitle", "time": 19609.628, "timestamp": "05:26:49", "text": "みんな"}, {"type": "subtitle", "time": 19619.51, "timestamp": "05:26:59", "text": "星座。こんにちは。では、次は私の"}]
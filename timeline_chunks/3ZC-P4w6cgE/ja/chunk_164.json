[{"type": "subtitle", "time": 9841.11, "timestamp": "02:44:01", "text": "私には、それが私の影響を及ぼしたかどうかわかりません"}, {"type": "subtitle", "time": 9844.75, "timestamp": "02:44:04", "text": "パフォーマンス。よくわからない。"}, {"type": "subtitle", "time": 9848.469, "timestamp": "02:44:08", "text": "しかし、再考することで、さらに進むことができます"}, {"type": "subtitle", "time": 9850.309, "timestamp": "02:44:10", "text": "2つ以上"}, {"type": "subtitle", "time": 9853.75, "timestamp": "02:44:13", "text": "26歳くらいまでかな。そして、"}, {"type": "subtitle", "time": 9856.469, "timestamp": "02:44:16", "text": "大学のチャットみたいに、すべて見ることができます"}, {"type": "subtitle", "time": 9858.269, "timestamp": "02:44:18", "text": "チャットとして"}, {"type": "subtitle", "time": 9881.67, "timestamp": "02:44:41", "text": "わかった。だから、別のタクシーに隠れることができる"}, {"type": "subtitle", "time": 9884.469, "timestamp": "02:44:44", "text": "部屋の戸棚ですよね？"}, {"type": "subtitle", "time": 9887.75, "timestamp": "02:44:47", "text": "あなたはできる。ある意味、そうせざるを得ない。のように、"}, {"type": "subtitle", "time": 9889.75, "timestamp": "02:44:49", "text": "私がキャビネットの中に隠れているとしたら、"}, {"type": "subtitle", "time": 9891.429, "timestamp": "02:44:51", "text": "他の人の中に隠れる。私たちは捨てることができません"}, {"type": "subtitle", "time": 9899.11, "timestamp": "02:44:59", "text": "うん。わかった。青いものを見てはいけない。私"}]
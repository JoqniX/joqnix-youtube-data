[{"type": "subtitle", "time": 12061.03, "timestamp": "03:21:01", "text": "グレース。これはもっとこんな感じです"}, {"type": "subtitle", "time": 12064.229, "timestamp": "03:21:04", "text": "はるかに神経をすり減らす、あるいはストレスの多いものになる。"}, {"type": "subtitle", "time": 12065.75, "timestamp": "03:21:05", "text": "もう一方については、ああ、"}, {"type": "subtitle", "time": 12067.03, "timestamp": "03:21:07", "text": "スピードランニングみたいな感じで、ただ"}, {"type": "subtitle", "time": 12071.98, "timestamp": "03:21:11", "text": "まるで滑るように進む。開けてみましょう。"}, {"type": "subtitle", "time": 12077.75, "timestamp": "03:21:17", "text": "[音楽]"}, {"type": "subtitle", "time": 12080.67, "timestamp": "03:21:20", "text": "よし、一緒に来てもいいよ。"}, {"type": "subtitle", "time": 12094.83, "timestamp": "03:21:34", "text": "ああ、わかった。どこに"}, {"type": "subtitle", "time": 12098.79, "timestamp": "03:21:38", "text": "あなた？よし。わかった。つまり技術的には"}, {"type": "subtitle", "time": 12102.11, "timestamp": "03:21:42", "text": "これは、これはどちらかというと初めてのことです"}, {"type": "subtitle", "time": 12105.83, "timestamp": "03:21:45", "text": "今のところ、人はこう見えるかもしれない"}, {"type": "subtitle", "time": 12107.429, "timestamp": "03:21:47", "text": "物事を制御する方法がちょっと変だ"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "それ。では、このドアに行って、このドアから飛び込んでください。"}, {"type": "subtitle", "time": 12115.59, "timestamp": "03:21:55", "text": "なぜ離婚するのか。"}, {"type": "subtitle", "time": 12119.03, "timestamp": "03:21:59", "text": "ああ、これが私のデフォルトの姿勢です"}]
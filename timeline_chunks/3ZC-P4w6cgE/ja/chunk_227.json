[{"type": "subtitle", "time": 13622.309, "timestamp": "03:47:02", "text": "二段ジャンプ、あるいは壁ジャンプのようなもの。ああ、"}, {"type": "subtitle", "time": 13664.15, "timestamp": "03:47:44", "text": "あのパズルのことですよね？それがポイントだ。"}, {"type": "subtitle", "time": 13666.469, "timestamp": "03:47:46", "text": "そこが私には理解できないところなんです。そうですか"}, {"type": "subtitle", "time": 13670.309, "timestamp": "03:47:50", "text": "青いものから先ですか？ああ、何でもできます"}, {"type": "subtitle", "time": 13672.95, "timestamp": "03:47:52", "text": "注文。とにかく、全部引っ張って"}, {"type": "subtitle", "time": 13676.469, "timestamp": "03:47:56", "text": "レバーを下げて、青いものをその場所に挿入します"}, {"type": "subtitle", "time": 13677.75, "timestamp": "03:47:57", "text": "ソケット。"}]
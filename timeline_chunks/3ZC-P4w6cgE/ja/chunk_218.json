[{"type": "subtitle", "time": 13119.03, "timestamp": "03:38:39", "text": "オレンジ色のやつは、今すぐ死ぬようなものだ。"}, {"type": "subtitle", "time": 13120.75, "timestamp": "03:38:40", "text": "右？"}, {"type": "subtitle", "time": 13128.15, "timestamp": "03:38:48", "text": "いや、違うよ。"}, {"type": "subtitle", "time": 13131.75, "timestamp": "03:38:51", "text": "えっと、これは白いやつですね。"}, {"type": "subtitle", "time": 13136.309, "timestamp": "03:38:56", "text": "オレンジ色のものは、"}, {"type": "subtitle", "time": 13138.79, "timestamp": "03:38:58", "text": "時間がほとんどなくなってしまったときのように、"}]
[{"type": "subtitle", "time": 16270.67, "timestamp": "04:31:10", "text": "知ってるよ、つまり"}, {"type": "subtitle", "time": 16275.389, "timestamp": "04:31:15", "text": "イサのこと覚えてる？"}, {"type": "subtitle", "time": 16278.469, "timestamp": "04:31:18", "text": "目。私はコラボレーションを実現できたことが一度もありません"}, {"type": "subtitle", "time": 16281.51, "timestamp": "04:31:21", "text": "彼女と話すか、きちんと彼女と話をする。いいえ、"}, {"type": "subtitle", "time": 16283.59, "timestamp": "04:31:23", "text": "彼女は本当に素敵な人だったから"}, {"type": "subtitle", "time": 16286.189, "timestamp": "04:31:26", "text": "そして、とても良い"}, {"type": "subtitle", "time": 16290.63, "timestamp": "04:31:30", "text": "友人。私にはわからない。私"}, {"type": "subtitle", "time": 16294.79, "timestamp": "04:31:34", "text": "彼女はまだこの暗号を使っているのだろうか。私"}, {"type": "subtitle", "time": 16298.91, "timestamp": "04:31:38", "text": "接続する方法がない"}, {"type": "subtitle", "time": 16307.59, "timestamp": "04:31:47", "text": "実際、私には接続する方法がありません"}, {"type": "subtitle", "time": 16309.91, "timestamp": "04:31:49", "text": "彼女と一緒に。"}]
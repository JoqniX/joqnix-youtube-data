[{"type": "subtitle", "time": 1801.87, "timestamp": "00:30:01", "text": "もっと？何をすればいいですか"}, {"type": "subtitle", "time": 1805.029, "timestamp": "00:30:05", "text": "必要？つまり、1つ選ぶなら私はカバーされている"}, {"type": "subtitle", "time": 1816.19, "timestamp": "00:30:16", "text": "行けるかどうか再確認して、"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "二重に回る。では、待ってください。じゃあ、ちょっと待ってて"}, {"type": "subtitle", "time": 1823.43, "timestamp": "00:30:23", "text": "私の計画の一つにすぐ参加してください。病気"}, {"type": "subtitle", "time": 1825.63, "timestamp": "00:30:25", "text": "戻ってきます。"}, {"type": "subtitle", "time": 1828.909, "timestamp": "00:30:28", "text": "わかった。こんにちは。切り替えて"}, {"type": "subtitle", "time": 1833.48, "timestamp": "00:30:33", "text": "これ。私、ちょっと待って。"}]
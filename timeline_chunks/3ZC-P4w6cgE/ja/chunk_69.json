[{"type": "subtitle", "time": 4141.189, "timestamp": "01:09:01", "text": "時間。ええ、そうですね。では、次のヴァレラントは"}, {"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "配信は10日から開始されます"}, {"type": "subtitle", "time": 4146.55, "timestamp": "01:09:06", "text": "価数の流れ。はい。このチャンネルで。"}, {"type": "subtitle", "time": 4148.51, "timestamp": "01:09:08", "text": "はい。のように"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "それ。うん。うん。えーと、サタンと123"}, {"type": "subtitle", "time": 4155.59, "timestamp": "01:09:15", "text": "ストリーム。はい。そして私はNeedyをやりたかった"}, {"type": "subtitle", "time": 4157.91, "timestamp": "01:09:17", "text": "ストリーマーの支配者。だから私は"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "それも調べてみてください。これで３人目だ"}, {"type": "subtitle", "time": 4165.309, "timestamp": "01:09:25", "text": "つまり4日間です。それで"}, {"type": "subtitle", "time": 4168.11, "timestamp": "01:09:28", "text": "明日香港に行こうと思っています。"}, {"type": "subtitle", "time": 4173.63, "timestamp": "01:09:33", "text": "でも、それをスピードランでクリアする必要がある。うん。"}, {"type": "subtitle", "time": 4176.309, "timestamp": "01:09:36", "text": "そしてスピードラン。なぜ？あなたにすべてを与えるのは"}, {"type": "subtitle", "time": 4178.149, "timestamp": "01:09:38", "text": "トライアルキャラクターのため、それは持続します"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "3日間または2日間。今日も含めると"}, {"type": "subtitle", "time": 4185.11, "timestamp": "01:09:45", "text": "私の時計はチクタクと時を刻んでいる。わかった。それで"}, {"type": "subtitle", "time": 4185.87, "timestamp": "01:09:45", "text": "それは"}, {"type": "subtitle", "time": 4189.03, "timestamp": "01:09:49", "text": "なぜなら、そう思ったから、そうすべきだと思った"}, {"type": "subtitle", "time": 4191.309, "timestamp": "01:09:51", "text": "ストリーム。そっちの方がずっといいですよね？それで"}, {"type": "subtitle", "time": 4193.91, "timestamp": "01:09:53", "text": "ええ、カットシーンはとても良いです"}, {"type": "subtitle", "time": 4197.11, "timestamp": "01:09:57", "text": "北海道。はい。はい。だから私はこう思った"}, {"type": "subtitle", "time": 4199.91, "timestamp": "01:09:59", "text": "それを配信で行うこと。に関して言えば"}]
[{"type": "subtitle", "time": 8580.23, "timestamp": "02:23:00", "text": "うん。うん。"}, {"type": "subtitle", "time": 8584.469, "timestamp": "02:23:04", "text": "わかった。ちょっとドアを開けて入ってみます。"}, {"type": "subtitle", "time": 8586.23, "timestamp": "02:23:06", "text": "友達リクエストを承認しましたか？私 私"}, {"type": "subtitle", "time": 8590.23, "timestamp": "02:23:10", "text": "見つけたよ。ああ、そうだね。私はそうしました あなたはそうしましたか"}, {"type": "subtitle", "time": 8592.349, "timestamp": "02:23:12", "text": "受け入れる？友達リクエストを送りました。あなた"}, {"type": "subtitle", "time": 8596.309, "timestamp": "02:23:16", "text": "した？私もあなたに送りました。待って。おお。なんてこった。"}, {"type": "subtitle", "time": 8597.27, "timestamp": "02:23:17", "text": "私たちは友達です。私たちは友達です。だから、"}, {"type": "subtitle", "time": 8601.469, "timestamp": "02:23:21", "text": "わかった。私たちはもう友達です。おお、いいね。"}, {"type": "subtitle", "time": 8604.309, "timestamp": "02:23:24", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 8607.03, "timestamp": "02:23:27", "text": "わかった。さあ、あなたも私と一緒に参加してもいいと思いますよ。"}, {"type": "subtitle", "time": 8608.79, "timestamp": "02:23:28", "text": "あ、待って。えっと、私のユーザー名を目にするかもしれません"}, {"type": "subtitle", "time": 8612.469, "timestamp": "02:23:32", "text": "メインページ、ホームページにて。"}, {"type": "subtitle", "time": 8615.11, "timestamp": "02:23:35", "text": "うん。ええ、見ましたよ。はい、クリックします"}, {"type": "subtitle", "time": 8623.03, "timestamp": "02:23:43", "text": "参加する。なぜ「インストール中」と表示されるのですか？待って、"}, {"type": "subtitle", "time": 8624.63, "timestamp": "02:23:44", "text": "アップデートしなかったっけ？私はそれをプレイしました"}, {"type": "subtitle", "time": 8628.469, "timestamp": "02:23:48", "text": "カスピ海は最近。何？えっと、それから"}, {"type": "subtitle", "time": 8631.83, "timestamp": "02:23:51", "text": "ええ、その時アップデートするだけです"}, {"type": "subtitle", "time": 8634.389, "timestamp": "02:23:54", "text": "時間の問題でしょうね。ああ、"}, {"type": "subtitle", "time": 8636.71, "timestamp": "02:23:56", "text": "きっと短いと思うよ。"}]
[{"type": "subtitle", "time": 7693.03, "timestamp": "02:08:13", "text": "みんな。昨日は楽しかった。良い一日だった"}, {"type": "subtitle", "time": 7694.189, "timestamp": "02:08:14", "text": "時間"}, {"type": "subtitle", "time": 7697.149, "timestamp": "02:08:17", "text": "昨日。本当に"}, {"type": "subtitle", "time": 7699.149, "timestamp": "02:08:19", "text": "楽しい。"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "そして私は考えていた"}, {"type": "subtitle", "time": 7705.069, "timestamp": "02:08:25", "text": "種類について"}, {"type": "subtitle", "time": 7709.629, "timestamp": "02:08:29", "text": "いくつか変更を加えること。私"}, {"type": "subtitle", "time": 7712.069, "timestamp": "02:08:32", "text": "たぶん私はほとんどの"}, {"type": "subtitle", "time": 7716.149, "timestamp": "02:08:36", "text": "私がレースに出ている人たちのほとんどは"}, {"type": "subtitle", "time": 7719.31, "timestamp": "02:08:39", "text": "人々。 1つ"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "2番。私は３つのほとんどを手に入れようとしています"}, {"type": "subtitle", "time": 7724.069, "timestamp": "02:08:44", "text": "水曜日の人々。うん、1つね"}, {"type": "subtitle", "time": 7726.669, "timestamp": "02:08:46", "text": "2番。イマンは"}, {"type": "subtitle", "time": 7731.27, "timestamp": "02:08:51", "text": "ここ。こんにちは。えっと、ちょっと待って、"}, {"type": "subtitle", "time": 7738.43, "timestamp": "02:08:58", "text": "ストリーム。わかった。"}]
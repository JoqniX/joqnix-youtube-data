[{"type": "subtitle", "time": 628.11, "timestamp": "00:10:28", "text": "[音楽]"}, {"type": "subtitle", "time": 639.35, "timestamp": "00:10:39", "text": "なぜ彼らは今日、生存スコアを持っているのでしょうか？"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "えっと、彼らは死んでないよ、だって彼らは"}, {"type": "subtitle", "time": 644.949, "timestamp": "00:10:44", "text": "より早く配信開始。最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 647.829, "timestamp": "00:10:47", "text": "彼らはストリーミング配信していたが、私は"}, {"type": "subtitle", "time": 650.71, "timestamp": "00:10:50", "text": "ロクの敵が残っています。ええ、そうすることもできた"}, {"type": "subtitle", "time": 652.55, "timestamp": "00:10:52", "text": "彼らに加わったが、私は自分の配信を始めた"}, {"type": "subtitle", "time": 655.19, "timestamp": "00:10:55", "text": "しかしあの時"}, {"type": "subtitle", "time": 658.47, "timestamp": "00:10:58", "text": "何が起こっているのか分からないけど、えっと"}]
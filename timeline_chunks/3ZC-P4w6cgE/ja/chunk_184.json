[{"type": "subtitle", "time": 11049.87, "timestamp": "03:04:09", "text": "何も見えません"}, {"type": "subtitle", "time": 11054.429, "timestamp": "03:04:14", "text": "他の。ああ、彼はもう完全にそこにいるよ。全て"}, {"type": "subtitle", "time": 11057.389, "timestamp": "03:04:17", "text": "右。だから、私は時間があるかもしれない"}, {"type": "subtitle", "time": 11064.07, "timestamp": "03:04:24", "text": "おお、いいね。"}, {"type": "subtitle", "time": 11075.03, "timestamp": "03:04:35", "text": "どこにいるの？"}, {"type": "subtitle", "time": 11087.67, "timestamp": "03:04:47", "text": "わかった。"}, {"type": "subtitle", "time": 11090.03, "timestamp": "03:04:50", "text": "ほとんど。"}, {"type": "subtitle", "time": 11097.23, "timestamp": "03:04:57", "text": "えっと"}]
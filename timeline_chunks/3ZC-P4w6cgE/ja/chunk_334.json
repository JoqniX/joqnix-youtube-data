[{"type": "subtitle", "time": 20043.47, "timestamp": "05:34:03", "text": "音楽が止まったの？"}, {"type": "subtitle", "time": 20048.99, "timestamp": "05:34:08", "text": "バカじゃなかった"}, {"type": "subtitle", "time": 20050.91, "timestamp": "05:34:10", "text": "バカ。待って、"}, {"type": "subtitle", "time": 20053.628, "timestamp": "05:34:13", "text": "そうしたの？"}, {"type": "subtitle", "time": 20058.07, "timestamp": "05:34:18", "text": "わかった。おい。おい。それでは、続きです。分かりますか"}, {"type": "subtitle", "time": 20060.628, "timestamp": "05:34:20", "text": "私は「ヤッピン」のようなものを持っている。わからない"}, {"type": "subtitle", "time": 20062.99, "timestamp": "05:34:22", "text": "見えるなら"}, {"type": "subtitle", "time": 20065.39, "timestamp": "05:34:25", "text": "それ。"}, {"type": "subtitle", "time": 20069.05, "timestamp": "05:34:29", "text": "えっと、私が何をしようとしているのか"}, {"type": "subtitle", "time": 20082.03, "timestamp": "05:34:42", "text": "つまり、私はいつもクールでいるのが好きだった"}, {"type": "subtitle", "time": 20084.948, "timestamp": "05:34:44", "text": "子供は、クールな男の子の一人であり、"}, {"type": "subtitle", "time": 20089.35, "timestamp": "05:34:49", "text": "もの。えっと、私は"}, {"type": "subtitle", "time": 20090.99, "timestamp": "05:34:50", "text": "クールなものの一部"}, {"type": "subtitle", "time": 20094.91, "timestamp": "05:34:54", "text": "子供たち。イケてる連中。"}, {"type": "subtitle", "time": 20099.708, "timestamp": "05:34:59", "text": "うん。こんにちは。だから、もっと幸せ"}]
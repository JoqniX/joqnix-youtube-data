[{"type": "subtitle", "time": 4802.229, "timestamp": "01:20:02", "text": "あるバカが施設ファイルと呼ばれる"}, {"type": "subtitle", "time": 4803.39, "timestamp": "01:20:03", "text": "彼を変えた"}, {"type": "subtitle", "time": 4806.07, "timestamp": "01:20:06", "text": "名前。あなたは私が実際に"}, {"type": "subtitle", "time": 4808.43, "timestamp": "01:20:08", "text": "本当にそう思った、それは新しい"}, {"type": "subtitle", "time": 4811.91, "timestamp": "01:20:11", "text": "人。バ。なぜ変更したのですか"}, {"type": "subtitle", "time": 4815.07, "timestamp": "01:20:15", "text": "名前？バカな施設。"}, {"type": "subtitle", "time": 4818.39, "timestamp": "01:20:18", "text": "はぁ？彼は私があなたを間違えたと思った"}, {"type": "subtitle", "time": 4821.51, "timestamp": "01:20:21", "text": "新しいプッシュのために、私は「ああ、あなたの"}, {"type": "subtitle", "time": 4831.83, "timestamp": "01:20:31", "text": "「そういうもの」って、隠れることはできないんだよ。"}, {"type": "subtitle", "time": 4839.51, "timestamp": "01:20:39", "text": "自分。私はあなたの新しい名前であなたを呼ぶことにします"}, {"type": "subtitle", "time": 4842.91, "timestamp": "01:20:42", "text": "今。ええ、そうですね。専門"}, {"type": "subtitle", "time": 4849.03, "timestamp": "01:20:49", "text": "シャンビッシュ。えーと、ASOさん、ありがとうございます。"}, {"type": "subtitle", "time": 4851.91, "timestamp": "01:20:51", "text": "立ち寄って、メリークリスマス！今"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "誰が描いたのか尋ねてくれてありがとう"}, {"type": "subtitle", "time": 4856.55, "timestamp": "01:20:56", "text": "モデルも何もかも。でもみんな、"}]
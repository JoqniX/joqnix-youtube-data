[{"type": "subtitle", "time": 4561.35, "timestamp": "01:16:01", "text": "による。あと、ジョー、雪を降らせてください。"}, {"type": "subtitle", "time": 4564.47, "timestamp": "01:16:04", "text": "やっと雪に触れて感じることができる"}, {"type": "subtitle", "time": 4567.59, "timestamp": "01:16:07", "text": "そして、雪であなたをぶつけるでしょう。"}, {"type": "subtitle", "time": 4571.39, "timestamp": "01:16:11", "text": "または、あなたのために雪だるまを作ります"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "今日は来てくれてありがとう。願わくば"}, {"type": "subtitle", "time": 4576.11, "timestamp": "01:16:16", "text": "楽しかった"}, {"type": "subtitle", "time": 4579.39, "timestamp": "01:16:19", "text": "今。そして、あなたにもメリークリスマス"}, {"type": "subtitle", "time": 4583.03, "timestamp": "01:16:23", "text": "良い。そして今日、サントがやって来た。アディガート"}, {"type": "subtitle", "time": 4585.669, "timestamp": "01:16:25", "text": "サント、今日来てくれてありがとう、そしてメリー"}, {"type": "subtitle", "time": 4587.43, "timestamp": "01:16:27", "text": "あなたにもクリスマスを。そして、ありがとう"}, {"type": "subtitle", "time": 4589.83, "timestamp": "01:16:29", "text": "良いことをすべて教えてくれてありがとう"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "あなたに何が起こったのか、そして"}, {"type": "subtitle", "time": 4594.55, "timestamp": "01:16:34", "text": "誕生日おめでとうございます。それは"}, {"type": "subtitle", "time": 4597.75, "timestamp": "01:16:37", "text": "24日だったけど、遅ればせながら嬉しい"}, {"type": "subtitle", "time": 4601.35, "timestamp": "01:16:41", "text": "改めてお誕生日おめでとうございます。"}, {"type": "subtitle", "time": 4604.31, "timestamp": "01:16:44", "text": "本日伺います。良い一日をお過ごしください"}, {"type": "subtitle", "time": 4609.07, "timestamp": "01:16:49", "text": "いいですね、そしてメリークリスマス"}, {"type": "subtitle", "time": 4610.99, "timestamp": "01:16:50", "text": "またもや"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "ストリームに来て私の"}]
[{"type": "subtitle", "time": 12421.309, "timestamp": "03:27:01", "text": "ドア。"}, {"type": "subtitle", "time": 12422.83, "timestamp": "03:27:02", "text": "ああ。"}, {"type": "subtitle", "time": 12430.1, "timestamp": "03:27:10", "text": "ああ、それは目だ。見ないで"}, {"type": "subtitle", "time": 12470.71, "timestamp": "03:27:50", "text": "ああ、くそ。え、もう着いたの？うん。わかった。"}, {"type": "subtitle", "time": 12472.87, "timestamp": "03:27:52", "text": "わかった。くそっ。くそっ。"}, {"type": "subtitle", "time": 12475.349, "timestamp": "03:27:55", "text": "わかった。待って。道に迷ったのかな？ああ、そうだったよ"}, {"type": "subtitle", "time": 12479.59, "timestamp": "03:27:59", "text": "迷子になる。何てことだ。ああ、くそ。よし。"}]
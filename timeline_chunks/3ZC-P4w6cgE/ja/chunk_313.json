[{"type": "subtitle", "time": 18783.23, "timestamp": "05:13:03", "text": "特別なハン"}, {"type": "subtitle", "time": 18787.59, "timestamp": "05:13:07", "text": "特別なコンセプトアート神よ私はああ神よ"}, {"type": "subtitle", "time": 18792.31, "timestamp": "05:13:12", "text": "たくさん撃った。こんにちは。えっと、こんにちは。理由は"}, {"type": "subtitle", "time": 18795.35, "timestamp": "05:13:15", "text": "コンセプトアートと呼んだのは、実際には"}, {"type": "subtitle", "time": 18798.23, "timestamp": "05:13:18", "text": "正式にこれを男性にする"}, {"type": "subtitle", "time": 18806.35, "timestamp": "05:13:26", "text": "デザイン。ねえ、これ"}, {"type": "subtitle", "time": 18808.03, "timestamp": "05:13:28", "text": "は"}, {"type": "subtitle", "time": 18810.47, "timestamp": "05:13:30", "text": "実際にショックの未来になる"}, {"type": "subtitle", "time": 18812.27, "timestamp": "05:13:32", "text": "次"}, {"type": "subtitle", "time": 18816.27, "timestamp": "05:13:36", "text": "の上。でも、緊張しています。震えている"}, {"type": "subtitle", "time": 18820.91, "timestamp": "05:13:40", "text": "今。こんにちは。それで、それで、それで、"}, {"type": "subtitle", "time": 18823.07, "timestamp": "05:13:43", "text": "だから、"}, {"type": "subtitle", "time": 18825.91, "timestamp": "05:13:45", "text": "えーと、それで、えーと、彼女が、えーと、"}, {"type": "subtitle", "time": 18833.868, "timestamp": "05:13:53", "text": "スケッチして、実際"}, {"type": "subtitle", "time": 18838.07, "timestamp": "05:13:58", "text": "夜中に泣いた。夜だったのか、それとも何かだったのか、それとも"}]
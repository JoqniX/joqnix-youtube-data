[{"type": "subtitle", "time": 19208.11, "timestamp": "05:20:08", "text": "右？ほら、そこに私がいるよ"}, {"type": "subtitle", "time": 19211.11, "timestamp": "05:20:11", "text": "実は。でも隠すべきでしょうか"}, {"type": "subtitle", "time": 19214.07, "timestamp": "05:20:14", "text": "自分自身？私はこうなるでしょう。ああ、私が行きます。"}, {"type": "subtitle", "time": 19220.03, "timestamp": "05:20:20", "text": "推測。"}, {"type": "subtitle", "time": 19224.868, "timestamp": "05:20:24", "text": "こんにちは。あ、待って。えっと、私は持っていましたか？私は持っていましたか？"}, {"type": "subtitle", "time": 19245.47, "timestamp": "05:20:45", "text": "これ。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19247.99, "timestamp": "05:20:47", "text": "こんにちは。うん。これはカラーパレットです。"}, {"type": "subtitle", "time": 19248.83, "timestamp": "05:20:48", "text": "道。"}, {"type": "subtitle", "time": 19252.99, "timestamp": "05:20:52", "text": "こんにちは。ああ、このままにしておけばいいかな"}, {"type": "subtitle", "time": 19255.75, "timestamp": "05:20:55", "text": "これ？こんにちは。"}, {"type": "subtitle", "time": 19258.708, "timestamp": "05:20:58", "text": "どこから始めましょうか？"}]
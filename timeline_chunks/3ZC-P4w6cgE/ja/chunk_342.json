[{"type": "subtitle", "time": 20523.83, "timestamp": "05:42:03", "text": "他にもいろいろ。えっと、秘密にできる"}, {"type": "subtitle", "time": 20526.11, "timestamp": "05:42:06", "text": "あなたと私の間では、"}, {"type": "subtitle", "time": 20529.59, "timestamp": "05:42:09", "text": "でも、ちょっと弱くて敏感で"}, {"type": "subtitle", "time": 20532.39, "timestamp": "05:42:12", "text": "裏面。理由はわからないけど、わかってる"}, {"type": "subtitle", "time": 20536.69, "timestamp": "05:42:16", "text": "無駄な脂肪だとは分かっているけど、バカ"}, {"type": "subtitle", "time": 20539.15, "timestamp": "05:42:19", "text": "[音楽]"}, {"type": "subtitle", "time": 20541.628, "timestamp": "05:42:21", "text": "ダムダム"}, {"type": "subtitle", "time": 20545.19, "timestamp": "05:42:25", "text": "バカ。そう、最近は、そう、これらは"}, {"type": "subtitle", "time": 20547.15, "timestamp": "05:42:27", "text": "私が"}, {"type": "subtitle", "time": 20550.47, "timestamp": "05:42:30", "text": "持っている。私はユニークでありたかったし、"}, {"type": "subtitle", "time": 20552.868, "timestamp": "05:42:32", "text": "自分自身。主に、私は表現したかった"}, {"type": "subtitle", "time": 20555.948, "timestamp": "05:42:35", "text": "自分自身。これ"}, {"type": "subtitle", "time": 20558.15, "timestamp": "05:42:38", "text": "キャラクター。あなたが自分の体に言ったので、"}, {"type": "subtitle", "time": 20559.67, "timestamp": "05:42:39", "text": "私の髪は長くて、"}, {"type": "subtitle", "time": 20562.83, "timestamp": "05:42:42", "text": "脚の長さは9cmです。私が渡れると思いますか"}, {"type": "subtitle", "time": 20567.19, "timestamp": "05:42:47", "text": "残りは一人で生きろよ。よぉ、俺は"}, {"type": "subtitle", "time": 20570.23, "timestamp": "05:42:50", "text": "好きになりたいんだけど、ほら、すごく難しいんだよ"}, {"type": "subtitle", "time": 20573.03, "timestamp": "05:42:53", "text": "私は両親と一緒に暮らしています。私 私"}, {"type": "subtitle", "time": 20574.51, "timestamp": "05:42:54", "text": "渡りたい"}, {"type": "subtitle", "time": 20577.67, "timestamp": "05:42:57", "text": "実際に着飾ったりするんだけど、"}, {"type": "subtitle", "time": 20579.948, "timestamp": "05:42:59", "text": "恥ずかしい、"}]
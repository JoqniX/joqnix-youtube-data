[{"type": "subtitle", "time": 10262.469, "timestamp": "02:51:02", "text": "そしてまた戻る。"}, {"type": "subtitle", "time": 10265.79, "timestamp": "02:51:05", "text": "ああ、またああ"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "なんてこった。ノイズ。"}, {"type": "subtitle", "time": 10270.55, "timestamp": "02:51:10", "text": "待って。では、どのように維持していくつもりですか？"}, {"type": "subtitle", "time": 10274.67, "timestamp": "02:51:14", "text": "それ？その通り。私はそれを手に入れようとしていた"}, {"type": "subtitle", "time": 10277.03, "timestamp": "02:51:17", "text": "何かがあなたを妨げている"}, {"type": "subtitle", "time": 10281.269, "timestamp": "02:51:21", "text": "隠れたりとかそういうこと。ええ、2つあります。"}, {"type": "subtitle", "time": 10283.75, "timestamp": "02:51:23", "text": "あなたたち二人。心配ない。心配ない。私"}, {"type": "subtitle", "time": 10285.96, "timestamp": "02:51:25", "text": "わかったよ。"}, {"type": "subtitle", "time": 10294.309, "timestamp": "02:51:34", "text": "B. わかりました。あ、待って。あなたは無駄にしている"}, {"type": "subtitle", "time": 10296.87, "timestamp": "02:51:36", "text": "そこにお金がある。大丈夫です。でも私はすでに"}, {"type": "subtitle", "time": 10299.19, "timestamp": "02:51:39", "text": "持っていた。主に買ったのは"}, {"type": "subtitle", "time": 10302.71, "timestamp": "02:51:42", "text": "家を頭に持っていく。だから今はこう思う"}, {"type": "subtitle", "time": 10304.55, "timestamp": "02:51:44", "text": "今の状況に満足しています。私は持っている"}, {"type": "subtitle", "time": 10319.87, "timestamp": "02:51:59", "text": "わかった。それはどこにあったのですか？ 28. ええ。"}]
[{"type": "subtitle", "time": 13200.95, "timestamp": "03:40:00", "text": "[音楽]"}, {"type": "subtitle", "time": 13210.99, "timestamp": "03:40:10", "text": "おお、"}, {"type": "subtitle", "time": 13221.95, "timestamp": "03:40:21", "text": "1つ。"}, {"type": "subtitle", "time": 13229.15, "timestamp": "03:40:29", "text": "走るだけでとても満足"}, {"type": "subtitle", "time": 13237.429, "timestamp": "03:40:37", "text": "彼がいつ、そして彼が"}, {"type": "subtitle", "time": 13240.15, "timestamp": "03:40:40", "text": "では、どうすればいいのでしょうか？ああ、あなたはただ隠れているだけです"}, {"type": "subtitle", "time": 13242.389, "timestamp": "03:40:42", "text": "壁の向こう側。彼から出て行けばいいのに"}, {"type": "subtitle", "time": 13244.63, "timestamp": "03:40:44", "text": "それを見たときの視線。私はしません"}, {"type": "subtitle", "time": 13246.79, "timestamp": "03:40:46", "text": "彼がどうやってあなたを殺したか、あるいは何か"}, {"type": "subtitle", "time": 13249.67, "timestamp": "03:40:49", "text": "私にとってはバグったような感じだったと思います"}, {"type": "subtitle", "time": 13258.349, "timestamp": "03:40:58", "text": "わかった。"}]
[{"type": "subtitle", "time": 13931.429, "timestamp": "03:52:11", "text": "ああ、視線のことか。"}, {"type": "subtitle", "time": 13935.03, "timestamp": "03:52:15", "text": "いいえ。また私がそうしましたか？でも私は後ろには行けない"}, {"type": "subtitle", "time": 13937.83, "timestamp": "03:52:17", "text": "彼もだ。ああ、彼の後ろには行けませんよ。"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "いや、いや、いや。あなたは彼の後ろには行けません、なぜなら"}, {"type": "subtitle", "time": 13941.99, "timestamp": "03:52:21", "text": "彼はあなたをじっと見つめています。ちょうど"}, {"type": "subtitle", "time": 13944.349, "timestamp": "03:52:24", "text": "壁。行かなければならない、走らなければならない"}, {"type": "subtitle", "time": 13947.389, "timestamp": "03:52:27", "text": "後ろ向きに動いて、それから隠れる。"}, {"type": "subtitle", "time": 13950.79, "timestamp": "03:52:30", "text": "ああ、じゃあもう一度やってみて。"}, {"type": "subtitle", "time": 13953.03, "timestamp": "03:52:33", "text": "うん。だから、前に走って走るように"}, {"type": "subtitle", "time": 13954.87, "timestamp": "03:52:34", "text": "彼が消えるまで戻って、それから行く"}]
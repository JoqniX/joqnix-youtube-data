[{"type": "subtitle", "time": 6541.51, "timestamp": "01:49:01", "text": "今週のスケジュールは"}, {"type": "subtitle", "time": 6545.109, "timestamp": "01:49:05", "text": "明日の流れ、あるいは明日そのものによって。"}, {"type": "subtitle", "time": 6547.189, "timestamp": "01:49:07", "text": "マヤ"}, {"type": "subtitle", "time": 6549.83, "timestamp": "01:49:09", "text": "ええと、YouTubeで視聴できます"}, {"type": "subtitle", "time": 6553.189, "timestamp": "01:49:13", "text": "ええと、YouTubeコミュニティ投稿と"}, {"type": "subtitle", "time": 6555.75, "timestamp": "01:49:15", "text": "えっと、これから来るものって何て言うんだっけ"}, {"type": "subtitle", "time": 6558.55, "timestamp": "01:49:18", "text": "無料チャットと今後のスケジュール配信"}, {"type": "subtitle", "time": 6559.31, "timestamp": "01:49:19", "text": "それ"}, {"type": "subtitle", "time": 6563.75, "timestamp": "01:49:23", "text": "1つ、そしてTwitterとDiscordでも金箔が施されています"}, {"type": "subtitle", "time": 6566.709, "timestamp": "01:49:26", "text": "Facebook ページには次の短いページがあります。"}, {"type": "subtitle", "time": 6569.91, "timestamp": "01:49:29", "text": "Redditにもサブレディットがあり、"}, {"type": "subtitle", "time": 6572.39, "timestamp": "01:49:32", "text": "Tumblrとビリービリー、そしてすべての"}, {"type": "subtitle", "time": 6574.55, "timestamp": "01:49:34", "text": "これらは空売りです"}, {"type": "subtitle", "time": 6577.55, "timestamp": "01:49:37", "text": "それは利用可能になります。おお"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "ええ、そしてまた、でもついに、でもそうではない"}, {"type": "subtitle", "time": 6584.709, "timestamp": "01:49:44", "text": "せめて、メリークリスマス。君たち"}, {"type": "subtitle", "time": 6586.669, "timestamp": "01:49:46", "text": "おやすみなさい"}, {"type": "subtitle", "time": 6589.83, "timestamp": "01:49:49", "text": "先に。クリスマスを楽しんで、"}, {"type": "subtitle", "time": 6591.55, "timestamp": "01:49:51", "text": "[音楽]"}, {"type": "subtitle", "time": 6593.629, "timestamp": "01:49:53", "text": "楽しい。"}, {"type": "subtitle", "time": 6595.87, "timestamp": "01:49:55", "text": "はい。"}]
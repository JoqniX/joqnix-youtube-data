[{"type": "subtitle", "time": 8340.95, "timestamp": "02:19:00", "text": "それは明らかだ。真実。真実。はい。うん。うん。"}, {"type": "subtitle", "time": 8344.709, "timestamp": "02:19:04", "text": "そういうことだ。今日は"}, {"type": "subtitle", "time": 8348.429, "timestamp": "02:19:08", "text": "Robloxで楽しんでるよね？"}, {"type": "subtitle", "time": 8351.589, "timestamp": "02:19:11", "text": "ロブロックス。うん。だから今はそうではなく、"}, {"type": "subtitle", "time": 8354.15, "timestamp": "02:19:14", "text": "どれかを見極めるために、私は"}, {"type": "subtitle", "time": 8359.629, "timestamp": "02:19:19", "text": "おそらく、すべての元祖の一人はドアーズでしょう"}, {"type": "subtitle", "time": 8362.469, "timestamp": "02:19:22", "text": "ロブロックス。おそらく多くの人が"}, {"type": "subtitle", "time": 8364.389, "timestamp": "02:19:24", "text": "このゲームをプレイしたことがある人、または次のような人"}, {"type": "subtitle", "time": 8366.95, "timestamp": "02:19:26", "text": "「ああ、ホラーが見たいなら"}, {"type": "subtitle", "time": 8368.79, "timestamp": "02:19:28", "text": "ゲーム、Robloxで最初にすることは、"}, {"type": "subtitle", "time": 8370.95, "timestamp": "02:19:30", "text": "おそらく「ああ、ドアだ」と言うでしょう。うん、行くよ"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "ドア。"}, {"type": "subtitle", "time": 8376.389, "timestamp": "02:19:36", "text": "実際、めちゃくちゃ楽しいよ。まるで"}, {"type": "subtitle", "time": 8378.309, "timestamp": "02:19:38", "text": "わかった、つまり、あなたが打ち上げて、私が"}, {"type": "subtitle", "time": 8381.429, "timestamp": "02:19:41", "text": "もっと詳しく説明できるかもしれません。うん。について"}, {"type": "subtitle", "time": 8383.589, "timestamp": "02:19:43", "text": "お互いに友達になる必要があるよね？うん、"}, {"type": "subtitle", "time": 8385.389, "timestamp": "02:19:45", "text": "私たちは互いに協力し合う必要がある。所有"}, {"type": "subtitle", "time": 8393.59, "timestamp": "02:19:53", "text": "[音楽]"}, {"type": "subtitle", "time": 8395.91, "timestamp": "02:19:55", "text": "スキンとかはもう持ってる？"}, {"type": "subtitle", "time": 8399.51, "timestamp": "02:19:59", "text": "このゲームで？ああ、そうだね。私はすでに"}]
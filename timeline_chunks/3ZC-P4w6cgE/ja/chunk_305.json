[{"type": "subtitle", "time": 18300.43, "timestamp": "05:05:00", "text": "[音楽]"}, {"type": "subtitle", "time": 18302.35, "timestamp": "05:05:02", "text": "おお。"}, {"type": "subtitle", "time": 18305.83, "timestamp": "05:05:05", "text": "H. ああ、キラキラしたものが見える。おお、"}, {"type": "subtitle", "time": 18307.07, "timestamp": "05:05:07", "text": "何が"}, {"type": "subtitle", "time": 18310.35, "timestamp": "05:05:10", "text": "それ？何が"}, {"type": "subtitle", "time": 18312.99, "timestamp": "05:05:12", "text": "それ？"}, {"type": "subtitle", "time": 18316.628, "timestamp": "05:05:16", "text": "H. ああ、それは良い"}, {"type": "subtitle", "time": 18321.03, "timestamp": "05:05:21", "text": "幸せ。私は3つ持っています。いくらですか？"}, {"type": "subtitle", "time": 18336.15, "timestamp": "05:05:36", "text": "それ。絵文字はちょっと多すぎませんか？"}, {"type": "subtitle", "time": 18343.39, "timestamp": "05:05:43", "text": "[音楽]"}, {"type": "subtitle", "time": 18351.788, "timestamp": "05:05:51", "text": "それ。そしてこれが私です"}]
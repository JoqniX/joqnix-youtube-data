[{"type": "subtitle", "time": 1980.029, "timestamp": "00:33:00", "text": "クリスマス。陽気な"}, {"type": "subtitle", "time": 1982.509, "timestamp": "00:33:02", "text": "クリスマス。滞在する"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "すごい選手。ああ、あなたはただ見ていただけだったんですね。私"}, {"type": "subtitle", "time": 1992.47, "timestamp": "00:33:12", "text": "わからない。メリークリスマス。調子はどうですか？"}, {"type": "subtitle", "time": 1994.269, "timestamp": "00:33:14", "text": "あなた？どうでしたか"}, {"type": "subtitle", "time": 1997.59, "timestamp": "00:33:17", "text": "ストリーム？参加したかったのですが、"}, {"type": "subtitle", "time": 2000.47, "timestamp": "00:33:20", "text": "えっと、大丈夫ですか？わからない。私は私は"}, {"type": "subtitle", "time": 2003.83, "timestamp": "00:33:23", "text": "えーっと、ただチャットしているだけです。"}, {"type": "subtitle", "time": 2007.149, "timestamp": "00:33:27", "text": "あの時。だから私は思った"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "うん、そうするよ。でも君は"}, {"type": "subtitle", "time": 2012.75, "timestamp": "00:33:32", "text": "ストリームなので"}, {"type": "subtitle", "time": 2014.99, "timestamp": "00:33:34", "text": "大丈夫。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 2022.149, "timestamp": "00:33:42", "text": "ああ、私を見て。待って、撫でてるからそのままいて。"}]
[{"type": "subtitle", "time": 12842.469, "timestamp": "03:34:02", "text": "おお。ああ、だから彼はやらないのか"}, {"type": "subtitle", "time": 12847.75, "timestamp": "03:34:07", "text": "何でも？え、何？私は死んだ。ああ、わかった。"}, {"type": "subtitle", "time": 12851.67, "timestamp": "03:34:11", "text": "ああ、あなたは亡くなったんですね。うん。ああ、くそ。"}, {"type": "subtitle", "time": 12853.429, "timestamp": "03:34:13", "text": "待って、彼は私に何もしていない。"}, {"type": "subtitle", "time": 12876.83, "timestamp": "03:34:36", "text": "あ、引っ越しました。ああ、くそ。"}, {"type": "subtitle", "time": 12880.389, "timestamp": "03:34:40", "text": "おお。ああ、もう一度挑戦してもいいですよ。"}, {"type": "subtitle", "time": 12881.91, "timestamp": "03:34:41", "text": "ええ、もう一度試してみてもいいですよ。これはむしろ"}, {"type": "subtitle", "time": 12883.389, "timestamp": "03:34:43", "text": "まるで"}, {"type": "subtitle", "time": 12886.309, "timestamp": "03:34:46", "text": "始まりだが、"}, {"type": "subtitle", "time": 12889.75, "timestamp": "03:34:49", "text": "うん。ああ、お金や物は必要ありません"}, {"type": "subtitle", "time": 12892.87, "timestamp": "03:34:52", "text": "これ。ふむ。ああ、お金がない。えっと、それは違います"}, {"type": "subtitle", "time": 12895.269, "timestamp": "03:34:55", "text": "お金が必要な物もあるけど、"}, {"type": "subtitle", "time": 12896.87, "timestamp": "03:34:56", "text": "おそらく鍵を持っているだろう。その鍵で、"}]
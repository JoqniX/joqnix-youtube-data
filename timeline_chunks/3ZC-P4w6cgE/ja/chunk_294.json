[{"type": "subtitle", "time": 17640.83, "timestamp": "04:54:00", "text": "みんなの気持ちがわかると思う"}, {"type": "subtitle", "time": 17651.31, "timestamp": "04:54:11", "text": "また"}, {"type": "subtitle", "time": 17653.23, "timestamp": "04:54:13", "text": "休止期間"}, {"type": "subtitle", "time": 17658.19, "timestamp": "04:54:18", "text": "来るよ。ええと、そうですね、私は"}, {"type": "subtitle", "time": 17662.948, "timestamp": "04:54:22", "text": "実は特別なサプライズなんです。うん。それは"}, {"type": "subtitle", "time": 17665.948, "timestamp": "04:54:25", "text": "なぜあなたは私を見ないのですか"}, {"type": "subtitle", "time": 17669.628, "timestamp": "04:54:29", "text": "まだ。こんにちは。"}, {"type": "subtitle", "time": 17673.15, "timestamp": "04:54:33", "text": "こんにちは。先に進む前に"}, {"type": "subtitle", "time": 17679.868, "timestamp": "04:54:39", "text": "実は。"}, {"type": "subtitle", "time": 17691.31, "timestamp": "04:54:51", "text": "こんにちは。こんにちは。それで、その前に聞きたかったのですが"}, {"type": "subtitle", "time": 17698.35, "timestamp": "04:54:58", "text": "オーディオは私の"}]
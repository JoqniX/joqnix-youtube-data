[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "うん。うん。私は考えていた"}, {"type": "subtitle", "time": 8224.469, "timestamp": "02:17:04", "text": "そこからVlogみたいなものをアップロードしてる。もし"}, {"type": "subtitle", "time": 8228.629, "timestamp": "02:17:08", "text": "もし時間内に編集できたら、"}, {"type": "subtitle", "time": 8231.429, "timestamp": "02:17:11", "text": "たとえそれほど編集されていなくても、"}, {"type": "subtitle", "time": 8235.509, "timestamp": "02:17:15", "text": "大丈夫。できる限りはできると思う"}, {"type": "subtitle", "time": 8239.349, "timestamp": "02:17:19", "text": "あらゆることをして戻ってきて"}, {"type": "subtitle", "time": 8241.75, "timestamp": "02:17:21", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "うん。うん。いいえ、それはちょっと"}, {"type": "subtitle", "time": 8247.03, "timestamp": "02:17:27", "text": "面白い。想像できるような"}, {"type": "subtitle", "time": 8248.629, "timestamp": "02:17:28", "text": "おそらく少し"}, {"type": "subtitle", "time": 8251.589, "timestamp": "02:17:31", "text": "カフェで、まるで自分の声を録音しているかのように"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "「今日はどんな一日でしたか？」と聞くだけです"}, {"type": "subtitle", "time": 8256.549, "timestamp": "02:17:36", "text": "行ったり、そういうこと。"}, {"type": "subtitle", "time": 8260.23, "timestamp": "02:17:40", "text": "ああ、それは面白そうだ。うん。だからあなたは"}, {"type": "subtitle", "time": 8261.83, "timestamp": "02:17:41", "text": "その騒音に対処する必要はない"}, {"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "苦情とか、そういう類のこと。真実。"}, {"type": "subtitle", "time": 8266.07, "timestamp": "02:17:46", "text": "真実。はい。そして今はノートパソコンです。私はできる"}, {"type": "subtitle", "time": 8267.75, "timestamp": "02:17:47", "text": "どこへでも行ける。"}, {"type": "subtitle", "time": 8270.75, "timestamp": "02:17:50", "text": "うん。おお"}, {"type": "subtitle", "time": 8275.99, "timestamp": "02:17:55", "text": "ああ、それもあるね。それは良い。でも、"}, {"type": "subtitle", "time": 8278.15, "timestamp": "02:17:58", "text": "うん、マイクをどうやって持とうかって思ったよ"}]
[{"type": "subtitle", "time": 6069.109, "timestamp": "01:41:09", "text": "配信用のアバター。あなたは"}, {"type": "subtitle", "time": 6071.55, "timestamp": "01:41:11", "text": "最高。それは良いマインクラフトだった"}, {"type": "subtitle", "time": 6075.59, "timestamp": "01:41:15", "text": "ストリーム。とても楽しかったです。"}, {"type": "subtitle", "time": 6077.75, "timestamp": "01:41:17", "text": "待って、カイラも配信してると思うんだけど。待って、"}, {"type": "subtitle", "time": 6080.229, "timestamp": "01:41:20", "text": "私の記憶が正しければ、"}, {"type": "subtitle", "time": 6083.59, "timestamp": "01:41:23", "text": "最後の3つの装飾のよう。うん、カイラも"}, {"type": "subtitle", "time": 6086.87, "timestamp": "01:41:26", "text": "小川。うん、うん、うん、うん。はい、"}, {"type": "subtitle", "time": 6089.47, "timestamp": "01:41:29", "text": "ええ、カイラ、あなたもね。"}, {"type": "subtitle", "time": 6092.07, "timestamp": "01:41:32", "text": "マインクラフトを楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 6097.31, "timestamp": "01:41:37", "text": "お祝い？"}, {"type": "subtitle", "time": 6104.51, "timestamp": "01:41:44", "text": "全て"}, {"type": "subtitle", "time": 6108.83, "timestamp": "01:41:48", "text": "ストリーミング配信されました。待って、待って。サーシャも"}, {"type": "subtitle", "time": 6111.99, "timestamp": "01:41:51", "text": "ストリーミング配信されました。待てよ、それは23日だった。ああ、それ"}, {"type": "subtitle", "time": 6114.51, "timestamp": "01:41:54", "text": "23位だった。うん、うん、うん。彼女はそれをやった"}, {"type": "subtitle", "time": 6116.87, "timestamp": "01:41:56", "text": "早い。そうそう。見たのを覚えている"}, {"type": "subtitle", "time": 6118.75, "timestamp": "01:41:58", "text": "これ。なぜ私は"}]
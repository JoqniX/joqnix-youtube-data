[{"type": "subtitle", "time": 16980.39, "timestamp": "04:43:00", "text": "私が大切に思っている人たち、"}, {"type": "subtitle", "time": 16982.47, "timestamp": "04:43:02", "text": "複数のコラボレーションに積極的に参加する"}, {"type": "subtitle", "time": 16986.55, "timestamp": "04:43:06", "text": "この人たちは、まるで私が"}, {"type": "subtitle", "time": 16989.19, "timestamp": "04:43:09", "text": "人々のクラブか何かを掴む"}, {"type": "subtitle", "time": 16991.11, "timestamp": "04:43:11", "text": "彼らの数字とか何とか、"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "それが であっても、それが であっても"}, {"type": "subtitle", "time": 16995.39, "timestamp": "04:43:15", "text": "より大きな創造者"}, {"type": "subtitle", "time": 17002.708, "timestamp": "04:43:22", "text": "兄弟、私は一度も考えたことがなかった"}, {"type": "subtitle", "time": 17006.47, "timestamp": "04:43:26", "text": "何か聞いた話がない限りは、そんな感じだった。"}, {"type": "subtitle", "time": 17007.628, "timestamp": "04:43:27", "text": "だから私は"}, {"type": "subtitle", "time": 17008.89, "timestamp": "04:43:28", "text": "のように"}, {"type": "subtitle", "time": 17015.55, "timestamp": "04:43:35", "text": "わあ、何が欲しいの？"}]
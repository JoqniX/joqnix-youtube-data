[{"type": "subtitle", "time": 4021.829, "timestamp": "01:07:01", "text": "追跡から外れるような感じ"}, {"type": "subtitle", "time": 4025.029, "timestamp": "01:07:05", "text": "完全に集中できていないような感じ。だから私はできなかった"}, {"type": "subtitle", "time": 4027.91, "timestamp": "01:07:07", "text": "このクリスマス配信に向けて準備万端にしよう"}, {"type": "subtitle", "time": 4029.63, "timestamp": "01:07:09", "text": "うん"}, {"type": "subtitle", "time": 4033.029, "timestamp": "01:07:13", "text": "痛みはありますが、ベストを尽くします"}, {"type": "subtitle", "time": 4043.19, "timestamp": "01:07:23", "text": "それで、えっと、明日はどこだったっけ？えっと"}, {"type": "subtitle", "time": 4045.91, "timestamp": "01:07:25", "text": "ああ、そうそう、明日の予定。来週"}, {"type": "subtitle", "time": 4049.99, "timestamp": "01:07:29", "text": "もう来週だよ。 12月の週"}, {"type": "subtitle", "time": 4053.829, "timestamp": "01:07:33", "text": "25日から31日まで。来週です。あ、待って。"}, {"type": "subtitle", "time": 4056.91, "timestamp": "01:07:36", "text": "あ、待って。えっと、今週は何週目ですか？"}, {"type": "subtitle", "time": 4060.029, "timestamp": "01:07:40", "text": "また？ 1 2 3 4。これは4番目です"}, {"type": "subtitle", "time": 4062.91, "timestamp": "01:07:42", "text": "12月の週。うん。"}, {"type": "subtitle", "time": 4065.91, "timestamp": "01:07:45", "text": "ということで、今週が最後の週になります"}, {"type": "subtitle", "time": 4067.309, "timestamp": "01:07:47", "text": "シャンパ。"}, {"type": "subtitle", "time": 4070.349, "timestamp": "01:07:50", "text": "では、私たちはどんなゲームをプレイすべきでしょうか？"}, {"type": "subtitle", "time": 4074.95, "timestamp": "01:07:54", "text": "週？それで、私は提案された"}, {"type": "subtitle", "time": 4079.029, "timestamp": "01:07:59", "text": "2、3試合のうち1試合に集中する"}]
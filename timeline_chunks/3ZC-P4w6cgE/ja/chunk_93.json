[{"type": "subtitle", "time": 5581.55, "timestamp": "01:33:01", "text": "あなた。そして、メリークリスマス"}, {"type": "subtitle", "time": 5585.47, "timestamp": "01:33:05", "text": "良い。あなたにもメリークリスマス。"}, {"type": "subtitle", "time": 5589.51, "timestamp": "01:33:09", "text": "アリサは、いいえ、つまり、ほら、"}, {"type": "subtitle", "time": 5591.99, "timestamp": "01:33:11", "text": "見る"}, {"type": "subtitle", "time": 5595.11, "timestamp": "01:33:15", "text": "感謝の気持ちを表すとき"}, {"type": "subtitle", "time": 5597.03, "timestamp": "01:33:17", "text": "勤勉な人に与えることに関しては"}, {"type": "subtitle", "time": 5598.95, "timestamp": "01:33:18", "text": "人々、ですよね？勤勉なだけではない"}, {"type": "subtitle", "time": 5601.83, "timestamp": "01:33:21", "text": "人々は、"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "先延ばしのループに陥り、"}, {"type": "subtitle", "time": 5606.149, "timestamp": "01:33:26", "text": "君が知っているように、やりたくないんだ"}, {"type": "subtitle", "time": 5608.229, "timestamp": "01:33:28", "text": "何でもするが、それでも何でもしたいと思う"}, {"type": "subtitle", "time": 5609.669, "timestamp": "01:33:29", "text": "何かをしたいと思っていて、"}, {"type": "subtitle", "time": 5612.709, "timestamp": "01:33:32", "text": "一日中靴紐を締めていても"}, {"type": "subtitle", "time": 5614.47, "timestamp": "01:33:34", "text": "携帯電話を使っているか、"}, {"type": "subtitle", "time": 5617.47, "timestamp": "01:33:37", "text": "それは正しいことをしたと言えるでしょう。"}, {"type": "subtitle", "time": 5622.07, "timestamp": "01:33:42", "text": "えっと、ある意味で"}, {"type": "subtitle", "time": 5623.149, "timestamp": "01:33:43", "text": "えーと"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "ええ、私は彼らが仕事をしているのを見ています"}, {"type": "subtitle", "time": 5627.99, "timestamp": "01:33:47", "text": "ブラシと作業"}, {"type": "subtitle", "time": 5631.55, "timestamp": "01:33:51", "text": "[音楽]"}, {"type": "subtitle", "time": 5636.27, "timestamp": "01:33:56", "text": "難しい。どうやって君を軽くつつけばいいの？私が望むように"}, {"type": "subtitle", "time": 5639.83, "timestamp": "01:33:59", "text": "ブープブープ？いいえ、なぜ入力したのか"}]
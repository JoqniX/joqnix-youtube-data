[{"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "すべての人にとって。皆さんのことを心から愛しています。それで"}, {"type": "subtitle", "time": 6626.51, "timestamp": "01:50:26", "text": "うん、楽しんで"}, {"type": "subtitle", "time": 6631.43, "timestamp": "01:50:31", "text": "クリスマスも楽しもう。忘れないでください"}, {"type": "subtitle", "time": 6635.149, "timestamp": "01:50:35", "text": "いつものように善行をして"}, {"type": "subtitle", "time": 6637.99, "timestamp": "01:50:37", "text": "いろいろなことをして、ベストを尽くして、感謝します"}, {"type": "subtitle", "time": 6641.31, "timestamp": "01:50:41", "text": "最善を尽くしてくれてありがとう、そして"}, {"type": "subtitle", "time": 6644.629, "timestamp": "01:50:44", "text": "また、笑顔を忘れないでください。"}, {"type": "subtitle", "time": 6646.59, "timestamp": "01:50:46", "text": "最後まで良い一日でした"}, {"type": "subtitle", "time": 6651.149, "timestamp": "01:50:51", "text": "明日。でも、最高の笑顔を見せてね。"}, {"type": "subtitle", "time": 6654.07, "timestamp": "01:50:54", "text": "わかりました、たとえそれが困難な状況であっても"}, {"type": "subtitle", "time": 6657.83, "timestamp": "01:50:57", "text": "外にいるあなた、それでも笑顔で"}, {"type": "subtitle", "time": 6659.43, "timestamp": "01:50:59", "text": "最高。"}]
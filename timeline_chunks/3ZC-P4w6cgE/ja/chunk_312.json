[{"type": "subtitle", "time": 18722.628, "timestamp": "05:12:02", "text": "デザイン。ごめん。そこで私たちは連絡を取りました"}, {"type": "subtitle", "time": 18726.788, "timestamp": "05:12:06", "text": "お互いに、えーと、最終決定する"}, {"type": "subtitle", "time": 18729.23, "timestamp": "05:12:09", "text": "最終製品について、それは"}, {"type": "subtitle", "time": 18734.99, "timestamp": "05:12:14", "text": "これ。ねえ、これは特別な特別な"}, {"type": "subtitle", "time": 18740.43, "timestamp": "05:12:20", "text": "特別な、心温まる贈り物。"}, {"type": "subtitle", "time": 18743.35, "timestamp": "05:12:23", "text": "心温まる本当に難しい"}, {"type": "subtitle", "time": 18748.39, "timestamp": "05:12:28", "text": "言葉で言うと、まるでついに"}, {"type": "subtitle", "time": 18750.43, "timestamp": "05:12:30", "text": "本当に"}, {"type": "subtitle", "time": 18764.51, "timestamp": "05:12:44", "text": "感謝している、または私は"}, {"type": "subtitle", "time": 18767.07, "timestamp": "05:12:47", "text": "[音楽]"}]
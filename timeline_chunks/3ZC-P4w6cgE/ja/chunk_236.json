[{"type": "subtitle", "time": 14164.51, "timestamp": "03:56:04", "text": "に"}, {"type": "subtitle", "time": 14167.389, "timestamp": "03:56:07", "text": "ああ、ピンク。"}, {"type": "subtitle", "time": 14169.87, "timestamp": "03:56:09", "text": "おお。"}, {"type": "subtitle", "time": 14172.07, "timestamp": "03:56:12", "text": "ああ。うん。"}, {"type": "subtitle", "time": 14174.95, "timestamp": "03:56:14", "text": "赤、じっと見つめ続けなければならないか、"}, {"type": "subtitle", "time": 14179.11, "timestamp": "03:56:19", "text": "それ自体を追跡するようなものです。"}, {"type": "subtitle", "time": 14181.389, "timestamp": "03:56:21", "text": "それに時間をかけすぎている。いいえ"}, {"type": "subtitle", "time": 14183.75, "timestamp": "03:56:23", "text": "心配事。あなたにはまだまだ時間があります。それは"}, {"type": "subtitle", "time": 14186.63, "timestamp": "03:56:26", "text": "約2分30秒。私は思う"}, {"type": "subtitle", "time": 14188.87, "timestamp": "03:56:28", "text": "おそらく1時間もかからないでしょう"}, {"type": "subtitle", "time": 14195.51, "timestamp": "03:56:35", "text": "我が神よ。"}, {"type": "subtitle", "time": 14199.469, "timestamp": "03:56:39", "text": "うん。うん。ニース。これはいいですね。おお。"}, {"type": "subtitle", "time": 14201.349, "timestamp": "03:56:41", "text": "うん。"}, {"type": "subtitle", "time": 14212.07, "timestamp": "03:56:52", "text": "ロビーに戻る。うん。わかった。待って。来る"}, {"type": "subtitle", "time": 14215.429, "timestamp": "03:56:55", "text": "ロビーへ。どこにいるの？離れる。おお、"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "待って。あ、待って。ああ、私は古い"}, {"type": "subtitle", "time": 14219.83, "timestamp": "03:56:59", "text": "もの。ああ、わかりました。問題ない。問題ない。"}]
[{"type": "subtitle", "time": 9187.59, "timestamp": "02:33:07", "text": "待って、13番のドアがここにある。うん。ええ、そうです"}, {"type": "subtitle", "time": 9189.83, "timestamp": "02:33:09", "text": "ちょっと変な感じだけどね。そう、そうですね。保つ"}, {"type": "subtitle", "time": 9193.19, "timestamp": "02:33:13", "text": "どのドアだったかを覚えておくこと。ああ、そう思う"}, {"type": "subtitle", "time": 9204.389, "timestamp": "02:33:24", "text": "わかった、気にしないで。わかった。私は思った"}, {"type": "subtitle", "time": 9213.07, "timestamp": "02:33:33", "text": "わかった。良い、"}, {"type": "subtitle", "time": 9221.07, "timestamp": "02:33:41", "text": "はい、これで入手できます"}, {"type": "subtitle", "time": 9223.71, "timestamp": "02:33:43", "text": "外。出て行け。"}, {"type": "subtitle", "time": 9227.23, "timestamp": "02:33:47", "text": "ええと。おお。おお"}, {"type": "subtitle", "time": 9229.75, "timestamp": "02:33:49", "text": "くそっ。わかった。あなたの画面を見ていました。"}, {"type": "subtitle", "time": 9231.27, "timestamp": "02:33:51", "text": "あなたは攻撃を受けています。それは"}, {"type": "subtitle", "time": 9233.349, "timestamp": "02:33:53", "text": "戸棚の中にいたらどうなる？"}, {"type": "subtitle", "time": 9236.469, "timestamp": "02:33:56", "text": "長すぎた。大丈夫ですか？おお"}]
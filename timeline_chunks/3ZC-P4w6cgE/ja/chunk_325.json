[{"type": "subtitle", "time": 19500.43, "timestamp": "05:25:00", "text": "それ。"}, {"type": "subtitle", "time": 19503.39, "timestamp": "05:25:03", "text": "くそ。くそ。"}, {"type": "subtitle", "time": 19506.948, "timestamp": "05:25:06", "text": "こんにちは。こんにちは。えっと、ウィンドウを使っています"}, {"type": "subtitle", "time": 19507.868, "timestamp": "05:25:07", "text": "写真"}, {"type": "subtitle", "time": 19511.708, "timestamp": "05:25:11", "text": "あれ。ねえ、ズームインしてみよう"}, {"type": "subtitle", "time": 19514.83, "timestamp": "05:25:14", "text": "今。だから、私の"}, {"type": "subtitle", "time": 19519.948, "timestamp": "05:25:19", "text": "ねずみ。こんにちは。つまり、これらは"}, {"type": "subtitle", "time": 19526.27, "timestamp": "05:25:26", "text": "キラのように輝く星座。"}, {"type": "subtitle", "time": 19528.99, "timestamp": "05:25:28", "text": "H. そしてこれ"}, {"type": "subtitle", "time": 19534.83, "timestamp": "05:25:34", "text": "1つ目は、私の母であるズチです。当ててみて。それは"}, {"type": "subtitle", "time": 19537.788, "timestamp": "05:25:37", "text": "星座。レオだよ。"}, {"type": "subtitle", "time": 19540.948, "timestamp": "05:25:40", "text": "実は。そしてレオは、えっと、私の、えっと、何を"}, {"type": "subtitle", "time": 19541.948, "timestamp": "05:25:41", "text": "あなたが電話する"}, {"type": "subtitle", "time": 19544.628, "timestamp": "05:25:44", "text": "それ？あれってなんて言うんだっけ？忘れた。"}, {"type": "subtitle", "time": 19549.43, "timestamp": "05:25:49", "text": "ああ、私のADHDが積み重なってきた。えっと、私は"}, {"type": "subtitle", "time": 19552.39, "timestamp": "05:25:52", "text": "8月。それで、それは何ていう名前だったっけ？何"}, {"type": "subtitle", "time": 19555.75, "timestamp": "05:25:55", "text": "もう一度署名しますか？うん。星座のことです。"}, {"type": "subtitle", "time": 19558.11, "timestamp": "05:25:58", "text": "うん。うん。"}]
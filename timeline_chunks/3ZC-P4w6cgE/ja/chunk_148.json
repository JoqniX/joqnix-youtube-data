[{"type": "subtitle", "time": 8880.11, "timestamp": "02:28:00", "text": "小さな光"}, {"type": "subtitle", "time": 8883.99, "timestamp": "02:28:03", "text": "光を集める必要がある"}, {"type": "subtitle", "time": 8887.59, "timestamp": "02:28:07", "text": "それらこそが小さな鍵となるでしょう。"}, {"type": "subtitle", "time": 8890.71, "timestamp": "02:28:10", "text": "ああ、うん。"}, {"type": "subtitle", "time": 8893.27, "timestamp": "02:28:13", "text": "そして、その場合は後ろにしゃがむ必要があります"}, {"type": "subtitle", "time": 8895.03, "timestamp": "02:28:15", "text": "そして、このドアを開けなければなりません。なんてこった。"}, {"type": "subtitle", "time": 8896.87, "timestamp": "02:28:16", "text": "いいえ。"}, {"type": "subtitle", "time": 8899.19, "timestamp": "02:28:19", "text": "ええと、ここに商品があります。服用すべきでしょうか"}, {"type": "subtitle", "time": 8902.55, "timestamp": "02:28:22", "text": "これら？ああ、どうぞ、どうぞ。選べるなら"}, {"type": "subtitle", "time": 8916.95, "timestamp": "02:28:36", "text": "ああ、わかった。つまり、これがあなたの主な目標です"}, {"type": "subtitle", "time": 8920.469, "timestamp": "02:28:40", "text": "ゲームの目的は100番目のドアに到達することです。私たちは"}, {"type": "subtitle", "time": 8922.95, "timestamp": "02:28:42", "text": "1番のドア。"}, {"type": "subtitle", "time": 8926.429, "timestamp": "02:28:46", "text": "おお。おお。おお。わかった。確認中です。全て"}, {"type": "subtitle", "time": 8939.03, "timestamp": "02:28:59", "text": "誰が？ 1秒。私は理解しようとしている"}]
[{"type": "subtitle", "time": 4201.75, "timestamp": "01:10:01", "text": "どんなゲームでも、私はそれをプレイしたくない"}, {"type": "subtitle", "time": 4204.31, "timestamp": "01:10:04", "text": "ストリーム配信で配信して"}, {"type": "subtitle", "time": 4206.669, "timestamp": "01:10:06", "text": "えーっと、全部キャッチする"}, {"type": "subtitle", "time": 4209.27, "timestamp": "01:10:09", "text": "後で見返せる瞬間や"}, {"type": "subtitle", "time": 4211.51, "timestamp": "01:10:11", "text": "一緒に体験を見るような"}, {"type": "subtitle", "time": 4214.11, "timestamp": "01:10:14", "text": "みんなにとってそれはより良いことです、"}, {"type": "subtitle", "time": 4216.95, "timestamp": "01:10:16", "text": "右？いつも記録し忘れてしまう"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "配信していない時。そう、それが"}, {"type": "subtitle", "time": 4221.59, "timestamp": "01:10:21", "text": "私はそれをプレイすべきだと思った理由"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "ストリーム。うん。よし。だから私は"}, {"type": "subtitle", "time": 4228.229, "timestamp": "01:10:28", "text": "明日そうします。香港。私が試してみます"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "えーっと、プルアップしてTwitchストリームとして"}, {"type": "subtitle", "time": 4232.11, "timestamp": "01:10:32", "text": "できれば、もし私が"}, {"type": "subtitle", "time": 4235.59, "timestamp": "01:10:35", "text": "起きている。クリスマス配信をする必要がある"}, {"type": "subtitle", "time": 4238.709, "timestamp": "01:10:38", "text": "Twitchファミリーにとっても。いいえ、それで"}, {"type": "subtitle", "time": 4241.11, "timestamp": "01:10:41", "text": "うん。うん。ということで、私たちも"}, {"type": "subtitle", "time": 4243.75, "timestamp": "01:10:43", "text": "朝か何かにそうするんだ。良い"}, {"type": "subtitle", "time": 4246.91, "timestamp": "01:10:46", "text": "また、おそらくそれは"}, {"type": "subtitle", "time": 4249.229, "timestamp": "01:10:49", "text": "チャット中。それで"}, {"type": "subtitle", "time": 4253.91, "timestamp": "01:10:53", "text": "はい、では待ち時間を予約します。おお"}, {"type": "subtitle", "time": 4256.149, "timestamp": "01:10:56", "text": "スケジュールをお待ちください。ああ、ストリームが"}]
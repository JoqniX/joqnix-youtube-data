[{"type": "subtitle", "time": 17940.19, "timestamp": "04:59:00", "text": "たくさん休憩も取らず、うん。"}, {"type": "subtitle", "time": 17943.35, "timestamp": "04:59:03", "text": "うん。そして、それらすべての記憶は"}, {"type": "subtitle", "time": 17947.11, "timestamp": "04:59:07", "text": "えーっと、長時間配信とか。"}, {"type": "subtitle", "time": 17948.91, "timestamp": "04:59:08", "text": "うん。"}, {"type": "subtitle", "time": 17955.15, "timestamp": "04:59:15", "text": "こんにちは。だから、えーと、すべての努力は、"}, {"type": "subtitle", "time": 17959.91, "timestamp": "04:59:19", "text": "大変な努力すべて"}, {"type": "subtitle", "time": 17962.948, "timestamp": "04:59:22", "text": "ああ、私にはできないって分かってるよ"}, {"type": "subtitle", "time": 17965.99, "timestamp": "04:59:25", "text": "私はいつも自分自身に頼っていたので、一人で"}, {"type": "subtitle", "time": 17969.27, "timestamp": "04:59:29", "text": "全て一人でやりました。"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "私はアートからすべてをやりたかった"}, {"type": "subtitle", "time": 17973.47, "timestamp": "04:59:33", "text": "デザイン"}, {"type": "subtitle", "time": 17977.31, "timestamp": "04:59:37", "text": "3D関連のものまで含めてすべて"}, {"type": "subtitle", "time": 17979.67, "timestamp": "04:59:39", "text": "その他私が計画していたもの"}, {"type": "subtitle", "time": 17982.59, "timestamp": "04:59:42", "text": "将来は、私一人ではできない"}, {"type": "subtitle", "time": 17987.67, "timestamp": "04:59:47", "text": "自分一人ではできないと分かっていたし、"}, {"type": "subtitle", "time": 17990.27, "timestamp": "04:59:50", "text": "私は本当にイライラしていて"}, {"type": "subtitle", "time": 17991.948, "timestamp": "04:59:51", "text": "もの"}, {"type": "subtitle", "time": 17999.75, "timestamp": "04:59:59", "text": "でも、皆さんとは任務で知り合いました。それは"}]
[{"type": "subtitle", "time": 6124.43, "timestamp": "01:42:04", "text": "セレスティア"}, {"type": "subtitle", "time": 6128.149, "timestamp": "01:42:08", "text": "最後。楽しい配信だったことを願っています。"}, {"type": "subtitle", "time": 6133.79, "timestamp": "01:42:13", "text": "マッシュもしなかったし、カバーも作ったし"}, {"type": "subtitle", "time": 6136.59, "timestamp": "01:42:16", "text": "何か？"}, {"type": "subtitle", "time": 6141.83, "timestamp": "01:42:21", "text": "ええ、スターゲームの皆さんと私も"}, {"type": "subtitle", "time": 6144.31, "timestamp": "01:42:24", "text": "覚えておいてください、私は信じています。ズミもまた"}, {"type": "subtitle", "time": 6145.47, "timestamp": "01:42:25", "text": "ストリーミング配信。"}, {"type": "subtitle", "time": 6147.629, "timestamp": "01:42:27", "text": "それで"}, {"type": "subtitle", "time": 6151.83, "timestamp": "01:42:31", "text": "ああ、そうだよ。シミズミは彼女のためにたくさんのことをしてくれた"}, {"type": "subtitle", "time": 6154.87, "timestamp": "01:42:34", "text": "ストリーム。だから私は「いや、私はそんなことはしなかった」と思った。"}, {"type": "subtitle", "time": 6157.109, "timestamp": "01:42:37", "text": "私はベストを尽くさなかった"}, {"type": "subtitle", "time": 6159.59, "timestamp": "01:42:39", "text": "クリスマス配信。」だから私は「いや、私は"}, {"type": "subtitle", "time": 6163.109, "timestamp": "01:42:43", "text": "来年は少なくとも自分のパーティーをやらなきゃ。"}, {"type": "subtitle", "time": 6165.59, "timestamp": "01:42:45", "text": "だから来年は、えーと"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "今年はやりたかったのですが"}, {"type": "subtitle", "time": 6170.39, "timestamp": "01:42:50", "text": "クリスマスツリーの飾りと"}, {"type": "subtitle", "time": 6171.91, "timestamp": "01:42:51", "text": "みんな"}, {"type": "subtitle", "time": 6174.55, "timestamp": "01:42:54", "text": "えーと、家族の中で、そして"}, {"type": "subtitle", "time": 6176.669, "timestamp": "01:42:56", "text": "クリスマスツリー？それは私には無理だ。"}]
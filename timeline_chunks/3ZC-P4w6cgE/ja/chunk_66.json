[{"type": "subtitle", "time": 3961.029, "timestamp": "01:06:01", "text": "えーと、私はプレイするとは思っていませんでしたし、"}, {"type": "subtitle", "time": 3964.15, "timestamp": "01:06:04", "text": "通常、私の最初の計画は"}, {"type": "subtitle", "time": 3967.43, "timestamp": "01:06:07", "text": "何も準備していなければ私は"}, {"type": "subtitle", "time": 3968.51, "timestamp": "01:06:08", "text": "ちょうど"}, {"type": "subtitle", "time": 3971.109, "timestamp": "01:06:11", "text": "チャットしたり、何か話したり"}, {"type": "subtitle", "time": 3973.43, "timestamp": "01:06:13", "text": "4時間か3時間くらいで、私が"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "話しながら、私はうまくプレイして、そして"}, {"type": "subtitle", "time": 3977.309, "timestamp": "01:06:17", "text": "スピードラン"}, {"type": "subtitle", "time": 3982.71, "timestamp": "01:06:22", "text": "第3章から第5章の内容とか、"}, {"type": "subtitle", "time": 3985.589, "timestamp": "01:06:25", "text": "ストリームをラップしてスリープする。それが"}, {"type": "subtitle", "time": 3987.87, "timestamp": "01:06:27", "text": "それは私の"}, {"type": "subtitle", "time": 3992.15, "timestamp": "01:06:32", "text": "プラン。でも結局、私は歩いて、"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "2時間か1時間。結局プレイしました"}, {"type": "subtitle", "time": 3999.87, "timestamp": "01:06:39", "text": "ヴァレント。私たちは"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "私はあなたを見ている。覚えておいてください"}, {"type": "subtitle", "time": 4012.069, "timestamp": "01:06:52", "text": "マスクをつけすぎだ。ええ、でも最近は"}, {"type": "subtitle", "time": 4014.309, "timestamp": "01:06:54", "text": "Valerantや他のゲームのおかげで"}, {"type": "subtitle", "time": 4018.109, "timestamp": "01:06:58", "text": "私は、えーと、軌道から外れてしまっているか、"}]
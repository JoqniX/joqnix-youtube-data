[{"type": "subtitle", "time": 6180.39, "timestamp": "01:43:00", "text": "でも来年は少なくとも"}, {"type": "subtitle", "time": 6182.47, "timestamp": "01:43:02", "text": "それは明日やる。何が何だかわからない"}, {"type": "subtitle", "time": 6186.149, "timestamp": "01:43:06", "text": "それに必要な物。でも、でも"}, {"type": "subtitle", "time": 6188.709, "timestamp": "01:43:08", "text": "それでも、少なくとも来年はそうするつもりだ。"}, {"type": "subtitle", "time": 6191.35, "timestamp": "01:43:11", "text": "大きな大きなクリスマスツリー"}, {"type": "subtitle", "time": 6192.35, "timestamp": "01:43:12", "text": "シングル"}, {"type": "subtitle", "time": 6194.95, "timestamp": "01:43:14", "text": "1つ。それはいくつになるだろうか？私はしません"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "知る。知らないことよりも、私は"}, {"type": "subtitle", "time": 6202.31, "timestamp": "01:43:22", "text": "私が知っている人全員を追加する。はい。"}, {"type": "subtitle", "time": 6204.95, "timestamp": "01:43:24", "text": "家族に属していない人、"}, {"type": "subtitle", "time": 6207.47, "timestamp": "01:43:27", "text": "また、家族の中にいる人たち"}, {"type": "subtitle", "time": 6210.35, "timestamp": "01:43:30", "text": "含まれています。うん。"}, {"type": "subtitle", "time": 6213.149, "timestamp": "01:43:33", "text": "はい。気にしないでください。私はただの棚です"}, {"type": "subtitle", "time": 6238.91, "timestamp": "01:43:58", "text": "私は今見た"}]
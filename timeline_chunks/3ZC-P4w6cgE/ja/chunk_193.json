[{"type": "subtitle", "time": 11596.23, "timestamp": "03:13:16", "text": "ああ、それはみんな同じレベルだよ"}, {"type": "subtitle", "time": 11597.99, "timestamp": "03:13:17", "text": "それ以外。"}, {"type": "subtitle", "time": 11600.71, "timestamp": "03:13:20", "text": "えーと、このすべてのもののように"}, {"type": "subtitle", "time": 11603.87, "timestamp": "03:13:23", "text": "ドア？同じドアです。うん。ああ、それは"}, {"type": "subtitle", "time": 11606.63, "timestamp": "03:13:26", "text": "手続き的に生成される。毎回のように"}, {"type": "subtitle", "time": 11610.15, "timestamp": "03:13:30", "text": "死ぬと、新しい世代のレベルの種類"}]
[{"type": "subtitle", "time": 14221.91, "timestamp": "03:57:01", "text": "わかった。技術的には、このゲームでは、"}, {"type": "subtitle", "time": 14223.75, "timestamp": "03:57:03", "text": "鍵。そして鍵があれば、"}, {"type": "subtitle", "time": 14225.83, "timestamp": "03:57:05", "text": "鍵は鍵穴のような場所にあります。私"}, {"type": "subtitle", "time": 14228.15, "timestamp": "03:57:08", "text": "あなたなりの方法で参加してログイン情報を取得できます。"}, {"type": "subtitle", "time": 14231.11, "timestamp": "03:57:11", "text": "わかった。わかった。うん。うん。"}, {"type": "subtitle", "time": 14239.429, "timestamp": "03:57:19", "text": "どこにいるの？やめてください。私は"}, {"type": "subtitle", "time": 14241.51, "timestamp": "03:57:21", "text": "中央のカスタムロビーのようなもの。どこに"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "あなた？"}, {"type": "subtitle", "time": 14245.11, "timestamp": "03:57:25", "text": "ああ、なるほど。あなたが見えてます。ここ。ここ。"}, {"type": "subtitle", "time": 14254.91, "timestamp": "03:57:34", "text": "自分。ここでは全てのキーを使用します。"}, {"type": "subtitle", "time": 14260.11, "timestamp": "03:57:40", "text": "それで、"}, {"type": "subtitle", "time": 14262.429, "timestamp": "03:57:42", "text": "ああ、私は"}, {"type": "subtitle", "time": 14265.269, "timestamp": "03:57:45", "text": "了解。いいえ、私が歌った曲があります"}, {"type": "subtitle", "time": 14268.429, "timestamp": "03:57:48", "text": "どうしてもこれが欲しい"}, {"type": "subtitle", "time": 14272.55, "timestamp": "03:57:52", "text": "ゲーム。だから、私がサイバー泣きするとき、ああ"}, {"type": "subtitle", "time": 14275.91, "timestamp": "03:57:55", "text": "ああ、そうだ。それはまるで"}]
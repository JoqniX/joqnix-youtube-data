[{"type": "subtitle", "time": 10567.309, "timestamp": "02:56:07", "text": "ええと、そうは書いてありません。ああ、くそ。おお、"}, {"type": "subtitle", "time": 10568.99, "timestamp": "02:56:08", "text": "いいえ。"}, {"type": "subtitle", "time": 10571.55, "timestamp": "02:56:11", "text": "わかった。おお、いいね、いいね、"}, {"type": "subtitle", "time": 10602.63, "timestamp": "02:56:42", "text": "は。わかったよ、ジョック。そのため、私たちは"}, {"type": "subtitle", "time": 10606.469, "timestamp": "02:56:46", "text": "とにかく走らなければならない。なんてこった。そして"}, {"type": "subtitle", "time": 10608.71, "timestamp": "02:56:48", "text": "振り返るな、振り返るな。ただそのままにしておく"}, {"type": "subtitle", "time": 10611.11, "timestamp": "02:56:51", "text": "前方に走る。"}, {"type": "subtitle", "time": 10613.99, "timestamp": "02:56:53", "text": "何てことだ。不気味だ"}, {"type": "subtitle", "time": 10618.15, "timestamp": "02:56:58", "text": "ロッドラン。光を追いかけなさい。滑り込む"}]
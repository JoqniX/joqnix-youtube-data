[{"type": "subtitle", "time": 8701.51, "timestamp": "02:25:01", "text": "非常に多くのものがあり、高いものさえあります"}, {"type": "subtitle", "time": 8704.83, "timestamp": "02:25:04", "text": "超リアルなグラフィックで、"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "魅力的ですね、見たことありますか？"}, {"type": "subtitle", "time": 8710.27, "timestamp": "02:25:10", "text": "Robloxのゲーム？の"}, {"type": "subtitle", "time": 8714.95, "timestamp": "02:25:14", "text": "ゲームは何か。はい。うん。こんな感じ"}, {"type": "subtitle", "time": 8717.11, "timestamp": "02:25:17", "text": "衝撃的で、"}, {"type": "subtitle", "time": 8720.309, "timestamp": "02:25:20", "text": "こう感じたんだ、私は"}, {"type": "subtitle", "time": 8722.309, "timestamp": "02:25:22", "text": "フォートナイトではこんなことは見たことがない"}, {"type": "subtitle", "time": 8726.469, "timestamp": "02:25:26", "text": "スタイルが違うということでしょうね。うん。好きだけど私は"}, {"type": "subtitle", "time": 8728.87, "timestamp": "02:25:28", "text": "ホラーゲームをいくつか見たと思うけど"}, {"type": "subtitle", "time": 8737.27, "timestamp": "02:25:37", "text": "私は参加したと思います。"}, {"type": "subtitle", "time": 8745.83, "timestamp": "02:25:45", "text": "あらら。えっと、あなたの名前が"}, {"type": "subtitle", "time": 8750.07, "timestamp": "02:25:50", "text": "プレイロビー。"}, {"type": "subtitle", "time": 8754.07, "timestamp": "02:25:54", "text": "ああ、なるほど、見えました。はい、見えていますよ。全て"}, {"type": "subtitle", "time": 8758.469, "timestamp": "02:25:58", "text": "右。そう、私はドクター・ハウスで、今日"}]
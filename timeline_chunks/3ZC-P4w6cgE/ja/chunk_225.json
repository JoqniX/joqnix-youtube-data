[{"type": "subtitle", "time": 13501.349, "timestamp": "03:45:01", "text": "ああ。ああ、これはあの雨と他の"}, {"type": "subtitle", "time": 13502.95, "timestamp": "03:45:02", "text": "1つ。"}, {"type": "subtitle", "time": 13505.59, "timestamp": "03:45:05", "text": "うん。笑顔の顔文字。しゃがむ。えっと、やめて"}, {"type": "subtitle", "time": 13508.67, "timestamp": "03:45:08", "text": "動いてしゃがむ。"}, {"type": "subtitle", "time": 13512.13, "timestamp": "03:45:12", "text": "ああ、見ましたよ。うん。"}, {"type": "subtitle", "time": 13518.229, "timestamp": "03:45:18", "text": "ああ、くそ。ドアの下に隠れてください。ここ。"}, {"type": "subtitle", "time": 13522.79, "timestamp": "03:45:22", "text": "うん。うん。ここ。ここ。おお、いいね。良い。"}, {"type": "subtitle", "time": 13525.91, "timestamp": "03:45:25", "text": "何てことだ。これを使って隠すこともできます"}, {"type": "subtitle", "time": 13532.189, "timestamp": "03:45:32", "text": "ああ、ピンク色だ"}, {"type": "subtitle", "time": 13537.83, "timestamp": "03:45:37", "text": "1つ。ああ、滑っていたんだ。ああ、こんにちは、エルサ。"}, {"type": "subtitle", "time": 13542.87, "timestamp": "03:45:42", "text": "私は赤目を見なかった。ああ、くそ。"}, {"type": "subtitle", "time": 13548.71, "timestamp": "03:45:48", "text": "これは難しいけれど、同時に楽しい。うん。"}]
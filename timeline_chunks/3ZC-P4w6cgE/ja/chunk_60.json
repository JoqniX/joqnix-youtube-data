[{"type": "subtitle", "time": 3603.91, "timestamp": "01:00:03", "text": "はい。オペレーター。"}, {"type": "subtitle", "time": 3605.99, "timestamp": "01:00:05", "text": "誰か私を見つけてくれませんか？"}, {"type": "subtitle", "time": 3609.27, "timestamp": "01:00:09", "text": "誰か私に気づいた？"}, {"type": "subtitle", "time": 3620.03, "timestamp": "01:00:20", "text": "レースがどうなるかはわかりません"}, {"type": "subtitle", "time": 3623.109, "timestamp": "01:00:23", "text": "購入。私は、"}, {"type": "subtitle", "time": 3658.39, "timestamp": "01:00:58", "text": "何？"}]
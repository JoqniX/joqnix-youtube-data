[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "何てことだ。眼鏡も持っています。えっと"}, {"type": "subtitle", "time": 6005.87, "timestamp": "01:40:05", "text": "ええ、私のメガネにも"}, {"type": "subtitle", "time": 6008.79, "timestamp": "01:40:08", "text": "名前。何てことだ。"}, {"type": "subtitle", "time": 6009.79, "timestamp": "01:40:09", "text": "思い出させる"}, {"type": "subtitle", "time": 6032.03, "timestamp": "01:40:32", "text": "本日はお越しいただきありがとうございます"}, {"type": "subtitle", "time": 6036.31, "timestamp": "01:40:36", "text": "死ぬ。今日は楽しかった。今日は楽しかったですか？"}, {"type": "subtitle", "time": 6038.03, "timestamp": "01:40:38", "text": "として"}, {"type": "subtitle", "time": 6045.55, "timestamp": "01:40:45", "text": "いいえ。メリー、メリー"}]
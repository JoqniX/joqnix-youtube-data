[{"type": "subtitle", "time": 19926.11, "timestamp": "05:32:06", "text": "来てくれてありがとう。ご滞在を楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 19928.19, "timestamp": "05:32:08", "text": "コミュニティと"}, {"type": "subtitle", "time": 19930.99, "timestamp": "05:32:10", "text": "ストリーム。こんにちは"}, {"type": "subtitle", "time": 19934.27, "timestamp": "05:32:14", "text": "頭。それはうまくいきますか？"}, {"type": "subtitle", "time": 19936.91, "timestamp": "05:32:16", "text": "もう？機能しませんか？"}, {"type": "subtitle", "time": 19939.23, "timestamp": "05:32:19", "text": "もう？そして"}, {"type": "subtitle", "time": 19946.31, "timestamp": "05:32:26", "text": "みんなのためのパッド。全員分のヘッド。"}, {"type": "subtitle", "time": 19949.868, "timestamp": "05:32:29", "text": "ああ、しまった、うまくいかない。ああ、そうだね"}, {"type": "subtitle", "time": 19952.43, "timestamp": "05:32:32", "text": "仕事。こんにちは。"}, {"type": "subtitle", "time": 19963.31, "timestamp": "05:32:43", "text": "こんにちは。元気かい？私は"}, {"type": "subtitle", "time": 19966.708, "timestamp": "05:32:46", "text": "良い。元気です。ありがとうございます"}, {"type": "subtitle", "time": 19969.788, "timestamp": "05:32:49", "text": "質問している。元気ですか？調子はどうですか？"}, {"type": "subtitle", "time": 19972.548, "timestamp": "05:32:52", "text": "あなた？そうそう。これを聞き忘れていました。"}, {"type": "subtitle", "time": 19974.788, "timestamp": "05:32:54", "text": "皆さん、お元気ですか？ああ、忘れてた"}, {"type": "subtitle", "time": 19976.788, "timestamp": "05:32:56", "text": "これを尋ねる。それは私のものになるはずだった"}, {"type": "subtitle", "time": 19979.99, "timestamp": "05:32:59", "text": "まず最初に尋ねるべきことは。つまり私は"}]
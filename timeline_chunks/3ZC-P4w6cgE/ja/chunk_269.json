[{"type": "subtitle", "time": 16162.349, "timestamp": "04:29:22", "text": "ライブアイドルをすべて入手"}, {"type": "subtitle", "time": 16171.389, "timestamp": "04:29:31", "text": "それ。私"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "良い。うん、アイドル対決ができるよ"}, {"type": "subtitle", "time": 16193.59, "timestamp": "04:29:53", "text": "アイドル。うん、わかるよ。こんにちは、ロバート"}]
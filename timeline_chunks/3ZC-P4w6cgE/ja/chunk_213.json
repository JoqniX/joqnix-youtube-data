[{"type": "subtitle", "time": 12782.309, "timestamp": "03:33:02", "text": "待って、これはどういう意味？よし、じゃあこれは"}, {"type": "subtitle", "time": 12785.51, "timestamp": "03:33:05", "text": "雨が降り始めると、"}, {"type": "subtitle", "time": 12788.79, "timestamp": "03:33:08", "text": "雲が赤くなり始めたり、空が"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "空が赤く染まり始めたり、血が見えたりする"}, {"type": "subtitle", "time": 12795.51, "timestamp": "03:33:15", "text": "雨が降ったら、どんな障害物の下にも隠れてください"}, {"type": "subtitle", "time": 12797.67, "timestamp": "03:33:17", "text": "まるでその下に隠れるように。あなたは"}, {"type": "subtitle", "time": 12800.59, "timestamp": "03:33:20", "text": "あなたの頭上に屋根がある。"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "ああ、わかりました。もう一つあります。願わくば"}, {"type": "subtitle", "time": 12806.309, "timestamp": "03:33:26", "text": "あなたにあげられるよ。ああ、一つある。"}, {"type": "subtitle", "time": 12808.03, "timestamp": "03:33:28", "text": "えっと"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "うん。これはどういうことですか？"}, {"type": "subtitle", "time": 12813.75, "timestamp": "03:33:33", "text": "これは、えっと、赤信号みたいなものです"}, {"type": "subtitle", "time": 12815.75, "timestamp": "03:33:35", "text": "青信号。でも、"}, {"type": "subtitle", "time": 12818.309, "timestamp": "03:33:38", "text": "笑顔のポーズでしゃがんで動かないでください"}, {"type": "subtitle", "time": 12820.389, "timestamp": "03:33:40", "text": "おそらく彼の目が覚めるまで。それは"}, {"type": "subtitle", "time": 12822.63, "timestamp": "03:33:42", "text": "その笑顔が消えたら、"}, {"type": "subtitle", "time": 12825.19, "timestamp": "03:33:45", "text": "その時こそ、動ける時です。"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "おお。"}, {"type": "subtitle", "time": 12828.71, "timestamp": "03:33:48", "text": "うん。笑顔を見た瞬間"}, {"type": "subtitle", "time": 12831.91, "timestamp": "03:33:51", "text": "顔を向けて、しゃがんで動かないでください。"}]
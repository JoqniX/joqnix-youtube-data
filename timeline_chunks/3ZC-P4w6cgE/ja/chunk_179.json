[{"type": "subtitle", "time": 10740.63, "timestamp": "02:59:00", "text": "あまり大きな音を立ててはいけない"}, {"type": "subtitle", "time": 10744.03, "timestamp": "02:59:04", "text": "音だと思う。私はしません"}, {"type": "subtitle", "time": 10746.63, "timestamp": "02:59:06", "text": "覚えて。しかし、私たちは確かに"}, {"type": "subtitle", "time": 10749.269, "timestamp": "02:59:09", "text": "あれには気をつけろ。おそらくしないだろう"}, {"type": "subtitle", "time": 10775.91, "timestamp": "02:59:35", "text": "7. ああ、私はそれが捕まると思う"}, {"type": "subtitle", "time": 10780.469, "timestamp": "02:59:40", "text": "あなたは、クローゼットの戸棚にぶつかりました。"}]
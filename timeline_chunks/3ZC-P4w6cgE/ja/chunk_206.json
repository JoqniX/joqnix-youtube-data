[{"type": "subtitle", "time": 12360.71, "timestamp": "03:26:00", "text": "障害を乗り越えるには、自分自身で努力するしかない。何が"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "2つ目の光？ええと、これです。 1つ"}, {"type": "subtitle", "time": 12366.469, "timestamp": "03:26:06", "text": "私は持ちこたえています。まるで鐘のようだ。"}, {"type": "subtitle", "time": 12369.67, "timestamp": "03:26:09", "text": "えっと、2番目の項目です。うん。これは何ですか"}, {"type": "subtitle", "time": 12372.71, "timestamp": "03:26:12", "text": "目のやつ？じっと見つめたり、目を合わせたりしないでください。"}, {"type": "subtitle", "time": 12374.229, "timestamp": "03:26:14", "text": "この目を見ないでください。見ないで"}, {"type": "subtitle", "time": 12376.95, "timestamp": "03:26:16", "text": "水平方向の白い目。そうなる"}, {"type": "subtitle", "time": 12378.95, "timestamp": "03:26:18", "text": "青色にも着色されている。いくつか"}, {"type": "subtitle", "time": 12381.83, "timestamp": "03:26:21", "text": "青いオーラ。"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "[音楽]"}, {"type": "subtitle", "time": 12392.91, "timestamp": "03:26:32", "text": "目。"}, {"type": "subtitle", "time": 12412.99, "timestamp": "03:26:52", "text": "[音楽]"}]
[{"type": "subtitle", "time": 3378.16, "timestamp": "00:56:18", "text": "何てことだ。うわぁ。"}, {"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "[拍手]"}, {"type": "subtitle", "time": 3383.67, "timestamp": "00:56:23", "text": "ああ、脇腹。ああ、大変だ。雪が降っているのか？"}, {"type": "subtitle", "time": 3386.069, "timestamp": "00:56:26", "text": "画面に？はい、それは雪が降っている"}, {"type": "subtitle", "time": 3388.19, "timestamp": "00:56:28", "text": "画面。"}, {"type": "subtitle", "time": 3393.19, "timestamp": "00:56:33", "text": "はい。もちろん、いつか雪が降ってほしいと思っています。"}, {"type": "subtitle", "time": 3395.829, "timestamp": "00:56:35", "text": "それは私の、えーと、もしあなたが"}, {"type": "subtitle", "time": 3398.789, "timestamp": "00:56:38", "text": "冬の夢、あるいは夢のような夢、あるいは"}, {"type": "subtitle", "time": 3400.95, "timestamp": "00:56:40", "text": "目標とライフスタイルは"}, {"type": "subtitle", "time": 3419.47, "timestamp": "00:56:59", "text": "神。ああ、"}]
[{"type": "subtitle", "time": 18371.67, "timestamp": "05:06:11", "text": "それ？実は、それには裏話があるんです。"}, {"type": "subtitle", "time": 18375.11, "timestamp": "05:06:15", "text": "後で説明します。私は、私は"}, {"type": "subtitle", "time": 18377.91, "timestamp": "05:06:17", "text": "私の視聴者のような人たちは、"}, {"type": "subtitle", "time": 18380.15, "timestamp": "05:06:20", "text": "ほら、私には伝統があるんだ"}, {"type": "subtitle", "time": 18383.99, "timestamp": "05:06:23", "text": "PNG 素材に関しては、PNG 素材に使用します。"}, {"type": "subtitle", "time": 18384.75, "timestamp": "05:06:24", "text": "あなた"}, {"type": "subtitle", "time": 18386.35, "timestamp": "05:06:26", "text": "知る。"}, {"type": "subtitle", "time": 18390.27, "timestamp": "05:06:30", "text": "さあ、準備はいいかい？準備はいいですか？"}, {"type": "subtitle", "time": 18394.15, "timestamp": "05:06:34", "text": "それ？ジョーはオリジナルで、"}, {"type": "subtitle", "time": 18397.628, "timestamp": "05:06:37", "text": "それって何？ビジュアライザー"}, {"type": "subtitle", "time": 18400.31, "timestamp": "05:06:40", "text": "あれ。おい、それは実は第2段階だよ。"}, {"type": "subtitle", "time": 18402.47, "timestamp": "05:06:42", "text": "あれがビジュアライザーです。しかしこれは"}, {"type": "subtitle", "time": 18405.03, "timestamp": "05:06:45", "text": "ええと、モデルの完全版です。なぜそれが"}, {"type": "subtitle", "time": 18412.31, "timestamp": "05:06:52", "text": "また。ねえ、私はすべてのことについて話すよ"}]
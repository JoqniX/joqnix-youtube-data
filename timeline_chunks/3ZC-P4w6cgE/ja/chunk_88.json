[{"type": "subtitle", "time": 5282.87, "timestamp": "01:28:02", "text": "芸術のようにする方法を学んでいた"}, {"type": "subtitle", "time": 5285.27, "timestamp": "01:28:05", "text": "物や絵を描いたり、"}, {"type": "subtitle", "time": 5287.99, "timestamp": "01:28:07", "text": "水彩画とか、全部含めて。よかった"}, {"type": "subtitle", "time": 5291.669, "timestamp": "01:28:11", "text": "うまくいった。それは、"}, {"type": "subtitle", "time": 5295.83, "timestamp": "01:28:15", "text": "勤勉な人。かわいいのを見て"}, {"type": "subtitle", "time": 5297.95, "timestamp": "01:28:17", "text": "また、"}, {"type": "subtitle", "time": 5301.11, "timestamp": "01:28:21", "text": "あれ。これもまた、"}, {"type": "subtitle", "time": 5327.07, "timestamp": "01:28:47", "text": "による。ご来店ありがとうございました"}, {"type": "subtitle", "time": 5331.31, "timestamp": "01:28:51", "text": "今日。良い一日を過ごされたことを願っています"}, {"type": "subtitle", "time": 5334.629, "timestamp": "01:28:54", "text": "クリスマスイブも。ええ、もう"}, {"type": "subtitle", "time": 5337.03, "timestamp": "01:28:57", "text": "クリスマス25日。ということで、頑張ってください。"}, {"type": "subtitle", "time": 5338.79, "timestamp": "01:28:58", "text": "クリスマスのお祝いと"}]
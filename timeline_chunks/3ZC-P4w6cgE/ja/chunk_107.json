[{"type": "subtitle", "time": 6427.99, "timestamp": "01:47:07", "text": "いいえ。なぜプレイするつもりですか？えっと、君"}, {"type": "subtitle", "time": 6430.31, "timestamp": "01:47:10", "text": "明日という意味ですか、それとも今日の意味ですか？今日はこれで終わりです。"}, {"type": "subtitle", "time": 6432.99, "timestamp": "01:47:12", "text": "今日はこれで終わりです。私たちは遊んだ"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "ヴァレラント。ええ、明日は絶対に"}, {"type": "subtitle", "time": 6438.27, "timestamp": "01:47:18", "text": "おそらく"}, {"type": "subtitle", "time": 6441.87, "timestamp": "01:47:21", "text": "フンガイ、実際はスピードランする必要があるから"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "それは何らかの出来事や事情によるものです。それで"}, {"type": "subtitle", "time": 6446.87, "timestamp": "01:47:26", "text": "そうだ、そうしようと思った"}, {"type": "subtitle", "time": 6450.229, "timestamp": "01:47:30", "text": "配信外でやらずに、配信でやろう。"}, {"type": "subtitle", "time": 6453.59, "timestamp": "01:47:33", "text": "ええ、ホンキーはプレイしてないんです"}, {"type": "subtitle", "time": 6455.75, "timestamp": "01:47:35", "text": "配信中。だから私は、うん、いいんじゃないかと思った。"}, {"type": "subtitle", "time": 6459.55, "timestamp": "01:47:39", "text": "ストリームでやってください"}, {"type": "subtitle", "time": 6463.669, "timestamp": "01:47:43", "text": "それ？でも、もし"}, {"type": "subtitle", "time": 6466.229, "timestamp": "01:47:46", "text": "可能であれば、さらに2つのストリームを行うか、"}, {"type": "subtitle", "time": 6470.189, "timestamp": "01:47:50", "text": "何か。 Amongをプレイします"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "私たち。今、私たちの間に存在するすべてのことを思い出してください。"}, {"type": "subtitle", "time": 6476.07, "timestamp": "01:47:56", "text": "良い試合になることを願っています。"}, {"type": "subtitle", "time": 6477.709, "timestamp": "01:47:57", "text": "楽しんでください。"}]
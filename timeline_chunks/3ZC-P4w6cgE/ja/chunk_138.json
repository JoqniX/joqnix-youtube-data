[{"type": "subtitle", "time": 8281.429, "timestamp": "02:18:01", "text": "私と一緒に？私はそれを保持しなければならない。"}, {"type": "subtitle", "time": 8283.669, "timestamp": "02:18:03", "text": "いいえ、良い人である必要はありません"}, {"type": "subtitle", "time": 8284.709, "timestamp": "02:18:04", "text": "だから私はいつもこう思う"}, {"type": "subtitle", "time": 8285.91, "timestamp": "02:18:05", "text": "電話を取って"}, {"type": "subtitle", "time": 8288.15, "timestamp": "02:18:08", "text": "コーヒー。私が見たもののように"}, {"type": "subtitle", "time": 8290.549, "timestamp": "02:18:10", "text": "人々はただ自分自身を録画する"}, {"type": "subtitle", "time": 8293.19, "timestamp": "02:18:13", "text": "屋外でそういうことをして、"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "背景音はまだ聞こえたが"}, {"type": "subtitle", "time": 8295.91, "timestamp": "02:18:15", "text": "すると、ああ、"}, {"type": "subtitle", "time": 8298.469, "timestamp": "02:18:18", "text": "自然なもの、おそらくそんな感じでしょう。えっと"}, {"type": "subtitle", "time": 8300.629, "timestamp": "02:18:20", "text": "ああ、この人はもういない"}, {"type": "subtitle", "time": 8302.709, "timestamp": "02:18:22", "text": "だから、私が理解できるように"}, {"type": "subtitle", "time": 8304.99, "timestamp": "02:18:24", "text": "品質。"}, {"type": "subtitle", "time": 8310.77, "timestamp": "02:18:30", "text": "ああ、わかった、わかった、それでいいよ。"}, {"type": "subtitle", "time": 8312.83, "timestamp": "02:18:32", "text": "[音楽]"}, {"type": "subtitle", "time": 8322.15, "timestamp": "02:18:42", "text": "ええ、Pコミコンの時に"}, {"type": "subtitle", "time": 8325.469, "timestamp": "02:18:45", "text": "持って行ったと思う"}, {"type": "subtitle", "time": 8329.19, "timestamp": "02:18:49", "text": "えっと、マイクみたいなやつですよね？そうだね。うん。"}, {"type": "subtitle", "time": 8331.91, "timestamp": "02:18:51", "text": "うん。うん。それ、必要かも。はい。はい。"}, {"type": "subtitle", "time": 8334.15, "timestamp": "02:18:54", "text": "うん。近くに置いといた方がいいと思う"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "遠い距離だと、実際には"}]
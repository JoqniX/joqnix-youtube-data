[{"type": "subtitle", "time": 3841.109, "timestamp": "01:04:01", "text": "死んだ。よし、もうすぐ終わるぞ"}, {"type": "subtitle", "time": 3844.39, "timestamp": "01:04:04", "text": "ゲーム。そう、ここまで到達したら、"}, {"type": "subtitle", "time": 3846.71, "timestamp": "01:04:06", "text": "私は、私は、私は止めたくないのですが、"}, {"type": "subtitle", "time": 3848.63, "timestamp": "01:04:08", "text": "このゲームはあまりプレイしないつもりです。"}, {"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "私が必要なのは、"}, {"type": "subtitle", "time": 3854.23, "timestamp": "01:04:14", "text": "戦闘バス。私はそれを終わらせるだけです"}, {"type": "subtitle", "time": 3855.349, "timestamp": "01:04:15", "text": "それまで、それまで。うん。それから私は"}, {"type": "subtitle", "time": 3857.19, "timestamp": "01:04:17", "text": "終わり。"}, {"type": "subtitle", "time": 3859.43, "timestamp": "01:04:19", "text": "これが手に入らなくても構いません。"}, {"type": "subtitle", "time": 3866.91, "timestamp": "01:04:26", "text": "ここ。ヒツジアザラシ。え、何？何が"}, {"type": "subtitle", "time": 3869.71, "timestamp": "01:04:29", "text": "それ？リップ"}, {"type": "subtitle", "time": 3872.19, "timestamp": "01:04:32", "text": "シール。目"}, {"type": "subtitle", "time": 3876.27, "timestamp": "01:04:36", "text": "外。気をつけろ。これは何ですか？"}, {"type": "subtitle", "time": 3878.67, "timestamp": "01:04:38", "text": "セレスティア"}, {"type": "subtitle", "time": 3881.309, "timestamp": "01:04:41", "text": "と"}, {"type": "subtitle", "time": 3883.789, "timestamp": "01:04:43", "text": "私は多くの"}, {"type": "subtitle", "time": 3892.91, "timestamp": "01:04:52", "text": "長くは続くけど、私はちょっと"}, {"type": "subtitle", "time": 3898.069, "timestamp": "01:04:58", "text": "あまり長く起きていてはいけないのではないかと不安です。私"}]
[{"type": "subtitle", "time": 19987.23, "timestamp": "05:33:07", "text": "神経質。これは矛盾だ。"}, {"type": "subtitle", "time": 19989.548, "timestamp": "05:33:09", "text": "何？"}, {"type": "subtitle", "time": 19994.67, "timestamp": "05:33:14", "text": "ハニーの反対語と突き刺す。"}, {"type": "subtitle", "time": 20000.03, "timestamp": "05:33:20", "text": "ああ、元気だよ。こんにちは。それは良いことだ"}, {"type": "subtitle", "time": 20029.35, "timestamp": "05:33:49", "text": "みんな。ヘッドパッド。おい。ええ、そうですね。だから私は"}, {"type": "subtitle", "time": 20031.548, "timestamp": "05:33:51", "text": "えっと、私が"}]
[{"type": "subtitle", "time": 1681.23, "timestamp": "00:28:01", "text": "ニース"}, {"type": "subtitle", "time": 1689.96, "timestamp": "00:28:09", "text": "スパイクを手に入れた。"}, {"type": "subtitle", "time": 1692.789, "timestamp": "00:28:12", "text": "[音楽]"}, {"type": "subtitle", "time": 1710.789, "timestamp": "00:28:30", "text": "火山が沈んだ。私の必殺技が完成しました。"}, {"type": "subtitle", "time": 1713.909, "timestamp": "00:28:33", "text": "群れグレネードを設置します。"}]
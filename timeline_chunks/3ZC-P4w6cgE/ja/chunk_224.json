[{"type": "subtitle", "time": 13460.87, "timestamp": "03:44:20", "text": "壁。おお、"}, {"type": "subtitle", "time": 13464.229, "timestamp": "03:44:24", "text": "どうやってそれを回避したのですか？見なければならない"}, {"type": "subtitle", "time": 13466.389, "timestamp": "03:44:26", "text": "直接それに向かって、それからEを押すと思います。"}, {"type": "subtitle", "time": 13469.11, "timestamp": "03:44:29", "text": "ドアの近くにいるとき。いいえ、"}, {"type": "subtitle", "time": 13472.71, "timestamp": "03:44:32", "text": "電車の男。そうそう。そうそう。それ"}, {"type": "subtitle", "time": 13475.11, "timestamp": "03:44:35", "text": "ああ、あの人だ。そこから抜け出さなければならない"}, {"type": "subtitle", "time": 13476.95, "timestamp": "03:44:36", "text": "彼の視線。まるで"}, {"type": "subtitle", "time": 13480.63, "timestamp": "03:44:40", "text": "目の前の壁を見て、"}, {"type": "subtitle", "time": 13482.55, "timestamp": "03:44:42", "text": "彼、彼は私を見て、あのトレーラーは"}, {"type": "subtitle", "time": 13485.55, "timestamp": "03:44:45", "text": "そこには。私は壁の裏側へ行った"}, {"type": "subtitle", "time": 13489.11, "timestamp": "03:44:49", "text": "視線のように彼を妨害する"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "そして私が彼の視界から外れると、"}]
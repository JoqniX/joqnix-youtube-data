[{"type": "subtitle", "time": 19866.27, "timestamp": "05:31:06", "text": "ゴタマ・ペトロクロム。うん、手に入れたよ"}, {"type": "subtitle", "time": 19871.23, "timestamp": "05:31:11", "text": "遺伝的な要素ですね。ああ、だって私は"}, {"type": "subtitle", "time": 19874.628, "timestamp": "05:31:14", "text": "生まれ変わった。私は、私は、ああ、私は"}, {"type": "subtitle", "time": 19877.75, "timestamp": "05:31:17", "text": "新しい新しいものと共に生まれ変わる、それを何と呼ぶ？"}, {"type": "subtitle", "time": 19880.39, "timestamp": "05:31:20", "text": "新しい新しい突然変異機能"}, {"type": "subtitle", "time": 19886.11, "timestamp": "05:31:26", "text": "もの。"}, {"type": "subtitle", "time": 19914.07, "timestamp": "05:31:54", "text": "永遠に。ヤフー。いらっしゃいませ。いらっしゃいませ。あなたは"}, {"type": "subtitle", "time": 19916.07, "timestamp": "05:31:56", "text": "このチャンネルは初めてですよね？いらっしゃいませ。"}]
[{"type": "subtitle", "time": 18840.51, "timestamp": "05:14:00", "text": "何か？だから私は実際にそうだった"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "実際に何かをしていた時間"}, {"type": "subtitle", "time": 18845.15, "timestamp": "05:14:05", "text": "の"}, {"type": "subtitle", "time": 18847.708, "timestamp": "05:14:07", "text": "ストリームで、私はとても"}, {"type": "subtitle", "time": 18851.11, "timestamp": "05:14:11", "text": "イライラする。どこにも手が届かなかった"}, {"type": "subtitle", "time": 18853.27, "timestamp": "05:14:13", "text": "全部。それはとても困難でした"}, {"type": "subtitle", "time": 18854.67, "timestamp": "05:14:14", "text": "私も"}, {"type": "subtitle", "time": 18856.708, "timestamp": "05:14:16", "text": "新しいことをすべて理解しています"}, {"type": "subtitle", "time": 18858.868, "timestamp": "05:14:18", "text": "学ぶ"}, {"type": "subtitle", "time": 18861.03, "timestamp": "05:14:21", "text": "ストリームなどに実装するために"}, {"type": "subtitle", "time": 18863.47, "timestamp": "05:14:23", "text": "とても大変だった。"}, {"type": "subtitle", "time": 18867.19, "timestamp": "05:14:27", "text": "でもでもでもでも"}, {"type": "subtitle", "time": 18870.15, "timestamp": "05:14:30", "text": "えっと、あなたの愛のすべて"}, {"type": "subtitle", "time": 18873.23, "timestamp": "05:14:33", "text": "ディスコードマイナーから"}, {"type": "subtitle", "time": 18875.99, "timestamp": "05:14:35", "text": "ディスコードが私にヘッドパッチをくれ"}, {"type": "subtitle", "time": 18878.55, "timestamp": "05:14:38", "text": "お互いに、みんなに会うのが好き"}, {"type": "subtitle", "time": 18881.23, "timestamp": "05:14:41", "text": "実際に"}, {"type": "subtitle", "time": 18883.23, "timestamp": "05:14:43", "text": "本当に"}, {"type": "subtitle", "time": 18887.19, "timestamp": "05:14:47", "text": "心がとろけそうになった。そしてその日"}, {"type": "subtitle", "time": 18892.948, "timestamp": "05:14:52", "text": "ズチが「えーっと、えーっと」と送ったとき、彼女は送った。"}, {"type": "subtitle", "time": 18897.59, "timestamp": "05:14:57", "text": "デザイン、スケッチ、線画"}, {"type": "subtitle", "time": 18899.55, "timestamp": "05:14:59", "text": "線画。おい"}]
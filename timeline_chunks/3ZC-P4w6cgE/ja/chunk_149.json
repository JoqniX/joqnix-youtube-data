[{"type": "subtitle", "time": 8940.99, "timestamp": "02:29:00", "text": "どれが"}, {"type": "subtitle", "time": 8944.309, "timestamp": "02:29:04", "text": "スプリント。待って。それは友達です。そうそう、"}, {"type": "subtitle", "time": 8946.99, "timestamp": "02:29:06", "text": "確認してみます。トグル"}, {"type": "subtitle", "time": 8948.75, "timestamp": "02:29:08", "text": "しゃがむ。"}, {"type": "subtitle", "time": 8952.389, "timestamp": "02:29:12", "text": "ああ、大変だ、操作方法がない。ああ、"}, {"type": "subtitle", "time": 8954.59, "timestamp": "02:29:14", "text": "Robloxを見せてください"}, {"type": "subtitle", "time": 8957.27, "timestamp": "02:29:17", "text": "ページ。えっと"}, {"type": "subtitle", "time": 8960.23, "timestamp": "02:29:20", "text": "ドアのコントロールがあったのを覚えているから"}, {"type": "subtitle", "time": 8963.99, "timestamp": "02:29:23", "text": "印刷物があったと思います。"}, {"type": "subtitle", "time": 8975.75, "timestamp": "02:29:35", "text": "なるほど、これにはスプリントはないみたいですね"}, {"type": "subtitle", "time": 8978.87, "timestamp": "02:29:38", "text": "ゲーム。これが私たちのデフォルトの速度だと思います"}, {"type": "subtitle", "time": 8981.389, "timestamp": "02:29:41", "text": "しゃがみジャンプを試してみて"}, {"type": "subtitle", "time": 8985.19, "timestamp": "02:29:45", "text": "ただし、ミニゲームの開始は除く。わかった。全て"}, {"type": "subtitle", "time": 8987.83, "timestamp": "02:29:47", "text": "右。つまり、待って、誰"}, {"type": "subtitle", "time": 8990.87, "timestamp": "02:29:50", "text": "ドアをノックしている？ああ、ただただ"}, {"type": "subtitle", "time": 8993.03, "timestamp": "02:29:53", "text": "頭の中で小さな音が聞こえる。それはいいです。"}, {"type": "subtitle", "time": 8996.23, "timestamp": "02:29:56", "text": "うん。よし。つまり、これは、えーと"}, {"type": "subtitle", "time": 8997.99, "timestamp": "02:29:57", "text": "あなたがこれらの場所に隠れているとき"}, {"type": "subtitle", "time": 8999.87, "timestamp": "02:29:59", "text": "食器棚。なんてこった。隠れるのは良いことだ。"}]
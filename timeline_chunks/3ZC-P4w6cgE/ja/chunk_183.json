[{"type": "subtitle", "time": 10988.469, "timestamp": "03:03:08", "text": "目の前に何かが見える。"}, {"type": "subtitle", "time": 10991.59, "timestamp": "03:03:11", "text": "ああ、まあ、見てください。復活の兆しがある"}, {"type": "subtitle", "time": 10994.95, "timestamp": "03:03:14", "text": "あなたの正面左側にあります。うん。"}, {"type": "subtitle", "time": 10999.83, "timestamp": "03:03:19", "text": "あれが見えますか？うん。あなたを見かけませんでした。"}, {"type": "subtitle", "time": 11001.67, "timestamp": "03:03:21", "text": "あ、待って。それは私です。ああ、気にしないで。"}, {"type": "subtitle", "time": 11004.63, "timestamp": "03:03:24", "text": "うん。 「ああ、見てよ」って感じでした。"}, {"type": "subtitle", "time": 11012.71, "timestamp": "03:03:32", "text": "ごめん。ここを離れたら、"}, {"type": "subtitle", "time": 11015.19, "timestamp": "03:03:35", "text": "君なら私を安全に蘇生させられると思うよ。ない"}, {"type": "subtitle", "time": 11017.51, "timestamp": "03:03:37", "text": "もちろん。"}, {"type": "subtitle", "time": 11018.87, "timestamp": "03:03:38", "text": "いえいえ、大丈夫です。大丈夫です。しないで"}, {"type": "subtitle", "time": 11023.59, "timestamp": "03:03:43", "text": "お金を無駄にする。よし。"}]
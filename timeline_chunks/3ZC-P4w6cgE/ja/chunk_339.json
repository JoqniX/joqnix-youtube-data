[{"type": "subtitle", "time": 20342.03, "timestamp": "05:39:02", "text": "見る？ママ。ズチ。先輩。"}, {"type": "subtitle", "time": 20349.83, "timestamp": "05:39:09", "text": "実際にイヤリングをくれたんです。とてもかわいい"}, {"type": "subtitle", "time": 20352.07, "timestamp": "05:39:12", "text": "また、私はいつもいつも"}, {"type": "subtitle", "time": 20355.23, "timestamp": "05:39:15", "text": "知ってるでしょ、さっき言ったとおり"}, {"type": "subtitle", "time": 20357.75, "timestamp": "05:39:17", "text": "そう、私はこうなりたいと言った"}, {"type": "subtitle", "time": 20362.548, "timestamp": "05:39:22", "text": "クールな子、クールな子の一部、そう、一部"}, {"type": "subtitle", "time": 20364.99, "timestamp": "05:39:24", "text": "私はとても恥ずかしがり屋なので"}, {"type": "subtitle", "time": 20372.27, "timestamp": "05:39:32", "text": "そうだね"}, {"type": "subtitle", "time": 20375.11, "timestamp": "05:39:35", "text": "これが私のチャであることはご存知でしょう"}, {"type": "subtitle", "time": 20377.99, "timestamp": "05:39:37", "text": "チョークに惹かれる"}, {"type": "subtitle", "time": 20381.83, "timestamp": "05:39:41", "text": "私はある日、"}, {"type": "subtitle", "time": 20383.23, "timestamp": "05:39:43", "text": "私はとても"}, {"type": "subtitle", "time": 20387.548, "timestamp": "05:39:47", "text": "内向的。えっと、私はとても内向的で"}, {"type": "subtitle", "time": 20390.07, "timestamp": "05:39:50", "text": "私にとって外出するのは難しく、"}, {"type": "subtitle", "time": 20392.708, "timestamp": "05:39:52", "text": "いろいろあるけど、私は着飾るのが好き"}, {"type": "subtitle", "time": 20394.67, "timestamp": "05:39:54", "text": "そして"}, {"type": "subtitle", "time": 20399.51, "timestamp": "05:39:59", "text": "もの。そう、昔はこんな感じだったんだ"}]
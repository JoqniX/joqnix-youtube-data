[{"type": "subtitle", "time": 7204.35, "timestamp": "02:00:04", "text": "ええと、無制限は等しい。わかった。ゲーム。何が"}, {"type": "subtitle", "time": 7208.83, "timestamp": "02:00:08", "text": "これ？量さえあれば"}, {"type": "subtitle", "time": 7210.91, "timestamp": "02:00:10", "text": "落とす。"}, {"type": "subtitle", "time": 7216.43, "timestamp": "02:00:16", "text": "影響。何が"}, {"type": "subtitle", "time": 7219.83, "timestamp": "02:00:19", "text": "これ？わかった。十分な量を集めました"}, {"type": "subtitle", "time": 7222.229, "timestamp": "02:00:22", "text": "アップグレードを購入するには、ダストが必要です。クリックしてください"}, {"type": "subtitle", "time": 7225.91, "timestamp": "02:00:25", "text": "赤いショッピングバスケットの底に"}, {"type": "subtitle", "time": 7237.55, "timestamp": "02:00:37", "text": "ああ、あなたはただ掃除をするだけなんですね。"}, {"type": "subtitle", "time": 7240.82, "timestamp": "02:00:40", "text": "A、あなたはただ物を掃除するだけです。それはとても"}, {"type": "subtitle", "time": 7243.629, "timestamp": "02:00:43", "text": "[音楽]"}, {"type": "subtitle", "time": 7252.589, "timestamp": "02:00:52", "text": "それ。 A、これは"}, {"type": "subtitle", "time": 7255.669, "timestamp": "02:00:55", "text": "楽しい。まるでマウスカーソルをホバリングしているみたい"}]
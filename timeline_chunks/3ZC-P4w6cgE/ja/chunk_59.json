[{"type": "subtitle", "time": 3546.069, "timestamp": "00:59:06", "text": "その通りです。何てことだ。それらはすべて"}, {"type": "subtitle", "time": 3574.91, "timestamp": "00:59:34", "text": "ああ、"}, {"type": "subtitle", "time": 3578.549, "timestamp": "00:59:38", "text": "主。最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 3581.349, "timestamp": "00:59:41", "text": "手榴弾。今チームエースって聞いたんだけど、"}, {"type": "subtitle", "time": 3588.91, "timestamp": "00:59:48", "text": "エース。ニース"}]
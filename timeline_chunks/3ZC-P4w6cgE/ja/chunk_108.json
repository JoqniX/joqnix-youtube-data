[{"type": "subtitle", "time": 6481.35, "timestamp": "01:48:01", "text": "わかった。次はいつやるんだろう"}, {"type": "subtitle", "time": 6483.35, "timestamp": "01:48:03", "text": "Among Usの配信。おそらく"}, {"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "来週、もしくは再来週あたり。私"}, {"type": "subtitle", "time": 6488.87, "timestamp": "01:48:08", "text": "わからない。 Among Usの配信を行います"}, {"type": "subtitle", "time": 6491.31, "timestamp": "01:48:11", "text": "近いうちに。"}, {"type": "subtitle", "time": 6493.99, "timestamp": "01:48:13", "text": "はい。よし。ええ、そうですね。つまり、"}, {"type": "subtitle", "time": 6496.07, "timestamp": "01:48:16", "text": "みんな。私は一人一人に呼びかけました"}, {"type": "subtitle", "time": 6497.35, "timestamp": "01:48:17", "text": "あなたたちのうちの一人。"}, {"type": "subtitle", "time": 6501.669, "timestamp": "01:48:21", "text": "誰が来たのか、そして今誰が来たのか"}, {"type": "subtitle", "time": 6505.31, "timestamp": "01:48:25", "text": "マッドガメランだった。ご来場ありがとうございました"}, {"type": "subtitle", "time": 6509.75, "timestamp": "01:48:29", "text": "あなたもね。良い一日をお過ごしください"}, {"type": "subtitle", "time": 6517.229, "timestamp": "01:48:37", "text": "[音楽]"}, {"type": "subtitle", "time": 6536.07, "timestamp": "01:48:56", "text": "あ、こんにちは。とにかく、手に入れました。だから、私たちは"}, {"type": "subtitle", "time": 6539.51, "timestamp": "01:48:59", "text": "ここでまた締めくくりたいと思います。えっと、次は"}]
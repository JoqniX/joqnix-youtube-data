[{"type": "subtitle", "time": 5101.83, "timestamp": "01:25:01", "text": "あなたはまだアウチ・クラと一緒にBCにいて、"}, {"type": "subtitle", "time": 5106.59, "timestamp": "01:25:06", "text": "サリス。だから楽しんでください。あなたに会いに来ます"}, {"type": "subtitle", "time": 5114.51, "timestamp": "01:25:14", "text": "クリスマス。楽しんでください"}, {"type": "subtitle", "time": 5117.27, "timestamp": "01:25:17", "text": "今。なぜ「入れる」と言ったのか分かりません"}, {"type": "subtitle", "time": 5120.51, "timestamp": "01:25:20", "text": "タイトルは孤独または"}, {"type": "subtitle", "time": 5124.189, "timestamp": "01:25:24", "text": "何か。バカ。女神。"}, {"type": "subtitle", "time": 5126.43, "timestamp": "01:25:26", "text": "いいえ、それは彼が"}, {"type": "subtitle", "time": 5129.55, "timestamp": "01:25:29", "text": "言う。しかし"}, {"type": "subtitle", "time": 5132.629, "timestamp": "01:25:32", "text": "ええ、ストリームを楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "良い良い"}, {"type": "subtitle", "time": 5136.51, "timestamp": "01:25:36", "text": "えーっと、クリスマスの教会"}, {"type": "subtitle", "time": 5138.35, "timestamp": "01:25:38", "text": "ピュー。"}, {"type": "subtitle", "time": 5142.669, "timestamp": "01:25:42", "text": "それで、それからやって来た"}, {"type": "subtitle", "time": 5147.149, "timestamp": "01:25:47", "text": "本日はお越しいただきありがとうございます。あなたは今目を覚ました"}, {"type": "subtitle", "time": 5151.51, "timestamp": "01:25:51", "text": "今日少し前に。ええ、そうですね。だから、あなたが"}, {"type": "subtitle", "time": 5155.35, "timestamp": "01:25:55", "text": "良い一日をお過ごしください。"}, {"type": "subtitle", "time": 5157.59, "timestamp": "01:25:57", "text": "メリークリスマスイブ、だってまだ"}]
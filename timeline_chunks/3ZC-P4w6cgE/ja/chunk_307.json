[{"type": "subtitle", "time": 18423.19, "timestamp": "05:07:03", "text": "全員分のヘッド。"}, {"type": "subtitle", "time": 18441.31, "timestamp": "05:07:21", "text": "Twitch？ねえ、ビジュアライザーに変身して"}, {"type": "subtitle", "time": 18444.51, "timestamp": "05:07:24", "text": "実は。ブーム。"}, {"type": "subtitle", "time": 18449.39, "timestamp": "05:07:29", "text": "よお。こんにちは。これはビジュアライザージョックです"}, {"type": "subtitle", "time": 18453.03, "timestamp": "05:07:33", "text": "次。おい。皆さんはどう思いますか？"}, {"type": "subtitle", "time": 18455.75, "timestamp": "05:07:35", "text": "実は？うん。まだあります"}, {"type": "subtitle", "time": 18458.628, "timestamp": "05:07:38", "text": "あれ。"}, {"type": "subtitle", "time": 18461.23, "timestamp": "05:07:41", "text": "私は本当に"}, {"type": "subtitle", "time": 18465.948, "timestamp": "05:07:45", "text": "ケージ。電源を入れる。こんにちは。それを回した"}, {"type": "subtitle", "time": 18468.59, "timestamp": "05:07:48", "text": "の上。ええ、そうですね。"}, {"type": "subtitle", "time": 18473.19, "timestamp": "05:07:53", "text": "えっと、私は「どうですか？」と聞きました。ミナ、"}, {"type": "subtitle", "time": 18475.15, "timestamp": "05:07:55", "text": "新しいのはどうですか？"}, {"type": "subtitle", "time": 18479.628, "timestamp": "05:07:59", "text": "キャラクター、新しいデザイン、新しい"}]
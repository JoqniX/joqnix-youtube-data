[{"type": "subtitle", "time": 4441.87, "timestamp": "01:14:01", "text": "本当に本当に感謝しています"}, {"type": "subtitle", "time": 4444.95, "timestamp": "01:14:04", "text": "それ。はい。そして私はあなたに贈り物をしました"}, {"type": "subtitle", "time": 4447.669, "timestamp": "01:14:07", "text": "頭突き。そしていつか私たちが"}, {"type": "subtitle", "time": 4451.03, "timestamp": "01:14:11", "text": "小さな雪、小さなボールのような小さな"}, {"type": "subtitle", "time": 4454.63, "timestamp": "01:14:14", "text": "ボール投げ合戦。え、何？雪合戦。"}, {"type": "subtitle", "time": 4457.59, "timestamp": "01:14:17", "text": "よし、君に投げてあげるよ。私はしません"}, {"type": "subtitle", "time": 4460.149, "timestamp": "01:14:20", "text": "知る。ただ投げて、ボンを鳴らしたいだけ"}, {"type": "subtitle", "time": 4462.07, "timestamp": "01:14:22", "text": "私のような人はヘッドショットで"}, {"type": "subtitle", "time": 4464.31, "timestamp": "01:14:24", "text": "雪だるま式に。わからない。見たい"}, {"type": "subtitle", "time": 4467.43, "timestamp": "01:14:27", "text": "贈り物。ああ、でも絵文字じゃなかったよ。おお、"}, {"type": "subtitle", "time": 4469.63, "timestamp": "01:14:29", "text": "ギフト絵文字を知ってるよね、剣みたいに"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "絵文字。うん、彼はギフトの絵文字を使ったよ。えっと"}, {"type": "subtitle", "time": 4476.87, "timestamp": "01:14:36", "text": "3回繰り返し、その間に剣の絵文字を挟む"}, {"type": "subtitle", "time": 4481.189, "timestamp": "01:14:41", "text": "さらにギフト絵文字も追加。そう、そんな感じ。"}, {"type": "subtitle", "time": 4483.75, "timestamp": "01:14:43", "text": "それからもう一つはギフト絵文字で、それから"}, {"type": "subtitle", "time": 4487.43, "timestamp": "01:14:47", "text": "ドーナツの絵文字とか、そういうギフトの絵文字。"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "つまり、2つの贈り物としてカウントされます"}, {"type": "subtitle", "time": 4492.07, "timestamp": "01:14:52", "text": "メッセージですよね？そんな感じですね。私"}, {"type": "subtitle", "time": 4495.11, "timestamp": "01:14:55", "text": "わからない。"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "それから、私が話していたハイドラのゲームです。"}]
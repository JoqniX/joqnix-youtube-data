[{"type": "subtitle", "time": 2507.51, "timestamp": "00:41:47", "text": "メリークリスマス、そしてあなたは"}, {"type": "subtitle", "time": 2509.95, "timestamp": "00:41:49", "text": "最初に私にDMを送ってくれたメリー"}, {"type": "subtitle", "time": 2512.79, "timestamp": "00:41:52", "text": "クリスマス。そう、君は私の最初の"}, {"type": "subtitle", "time": 2515.19, "timestamp": "00:41:55", "text": "今年のクリスマスに。"}, {"type": "subtitle", "time": 2517.309, "timestamp": "00:41:57", "text": "いいえ、ストリームを除いては。それで"}]
[{"type": "subtitle", "time": 12246.95, "timestamp": "03:24:06", "text": "このつながりは何ですか？ああ、それはただ"}, {"type": "subtitle", "time": 12255.469, "timestamp": "03:24:15", "text": "かわいい。全て"}, {"type": "subtitle", "time": 12258.07, "timestamp": "03:24:18", "text": "右。さて、ここからが"}, {"type": "subtitle", "time": 12260.71, "timestamp": "03:24:20", "text": "少しずつスピードを上げていく。またはあなた"}, {"type": "subtitle", "time": 12268.75, "timestamp": "03:24:28", "text": "えっと、取り除く"}, {"type": "subtitle", "time": 12272.79, "timestamp": "03:24:32", "text": "何かの。よし、これはまるで"}, {"type": "subtitle", "time": 12275.59, "timestamp": "03:24:35", "text": "君は時間を追いかける、ええと、モンスターは"}, {"type": "subtitle", "time": 12277.19, "timestamp": "03:24:37", "text": "君のことを理解しているよ。ということで、あと2分で"}, {"type": "subtitle", "time": 12280.469, "timestamp": "03:24:40", "text": "脱出せよ、このレベルを突破せよ。"}, {"type": "subtitle", "time": 12281.87, "timestamp": "03:24:41", "text": "わかった。"}, {"type": "subtitle", "time": 12285.6, "timestamp": "03:24:45", "text": "準備ができて？よし。"}, {"type": "subtitle", "time": 12293.51, "timestamp": "03:24:53", "text": "よし。押しやすさ。よし。"}, {"type": "subtitle", "time": 12299.75, "timestamp": "03:24:59", "text": "わかった。あなたもここに立つことができます。私"}]
[{"type": "subtitle", "time": 5223.47, "timestamp": "01:27:03", "text": "株式。何てことだ。これは"}, {"type": "subtitle", "time": 5226.669, "timestamp": "01:27:06", "text": "かわいい？これはとても"}, {"type": "subtitle", "time": 5231.11, "timestamp": "01:27:11", "text": "かわいい。でも、これは"}, {"type": "subtitle", "time": 5244.87, "timestamp": "01:27:24", "text": "信じて待って、コッキーは私に"}, {"type": "subtitle", "time": 5247.79, "timestamp": "01:27:27", "text": "雪玉みたいなやつ？彼は"}, {"type": "subtitle", "time": 5250.31, "timestamp": "01:27:30", "text": "そうしなかった。疑問符。見当たらない"}, {"type": "subtitle", "time": 5252.149, "timestamp": "01:27:32", "text": "DM。彼が私を派遣したかどうかはわかりません"}, {"type": "subtitle", "time": 5255.229, "timestamp": "01:27:35", "text": "サーバー内。えっと"}, {"type": "subtitle", "time": 5259.51, "timestamp": "01:27:39", "text": "でも、私はノーと言った、私はノーと言った"}, {"type": "subtitle", "time": 5261.59, "timestamp": "01:27:41", "text": "クッキーは要らない、私は彼を望んでいなかった"}, {"type": "subtitle", "time": 5263.55, "timestamp": "01:27:43", "text": "に"}, {"type": "subtitle", "time": 5266.95, "timestamp": "01:27:46", "text": "えっと、彼の時間を無駄にするとか、そうですね、"}, {"type": "subtitle", "time": 5269.43, "timestamp": "01:27:49", "text": "彼は多くの人にこう言わせた"}, {"type": "subtitle", "time": 5273.189, "timestamp": "01:27:53", "text": "雪合戦をやろう。しかし私は今"}, {"type": "subtitle", "time": 5276.27, "timestamp": "01:27:56", "text": "私の棚に飾るスノーボール。これを見て"}, {"type": "subtitle", "time": 5279.669, "timestamp": "01:27:59", "text": "カワイイ。ええ、彼女自身がやったんです。彼女"}]
[{"type": "subtitle", "time": 7265.149, "timestamp": "02:01:05", "text": "ああ、これは"}, {"type": "subtitle", "time": 7273.95, "timestamp": "02:01:13", "text": "楽しい。誰がゴミを捨てているんだ？"}, {"type": "subtitle", "time": 7276.669, "timestamp": "02:01:16", "text": "あ、待って。誰が降板するのか"}, {"type": "subtitle", "time": 7279.42, "timestamp": "02:01:19", "text": "ごみ？落下を止める"}, {"type": "subtitle", "time": 7287.75, "timestamp": "02:01:27", "text": "ごみ。ああ、エルサ、私の翻訳は"}, {"type": "subtitle", "time": 7289.69, "timestamp": "02:01:29", "text": "いや、それは間違いだ。だから覚えておいて。"}, {"type": "subtitle", "time": 7298.669, "timestamp": "02:01:38", "text": "[音楽]"}, {"type": "subtitle", "time": 7301.149, "timestamp": "02:01:41", "text": "えっと。ああ、これは"}, {"type": "subtitle", "time": 7304.83, "timestamp": "02:01:44", "text": "楽しい。私はたくさん集めています"}, {"type": "subtitle", "time": 7309.87, "timestamp": "02:01:49", "text": "ごみ。キナはきれいだ。わかった。ほこり"}, {"type": "subtitle", "time": 7315.03, "timestamp": "02:01:55", "text": "停止。私は持っています。わかった。カーペット２。"}, {"type": "subtitle", "time": 7318.47, "timestamp": "02:01:58", "text": "一般的な埃っぽい店。共通点を増やす"}]
[{"type": "subtitle", "time": 15548.99, "timestamp": "04:19:08", "text": "これ？うん。つまり、"}, {"type": "subtitle", "time": 15552.07, "timestamp": "04:19:12", "text": "私が連れてくる人たちは、"}, {"type": "subtitle", "time": 15554.349, "timestamp": "04:19:14", "text": "犬とかそういうもの。もし私が彼らを信頼し、"}, {"type": "subtitle", "time": 15557.269, "timestamp": "04:19:17", "text": "すべて。彼らは私のことを知っている。私は彼らが"}, {"type": "subtitle", "time": 15560.389, "timestamp": "04:19:20", "text": "私たちが初めてコラボレーションするものです"}, {"type": "subtitle", "time": 15565.389, "timestamp": "04:19:25", "text": "時間、そして私は願っています、私は願っています、そして願っています"}, {"type": "subtitle", "time": 15570.189, "timestamp": "04:19:30", "text": "ゆっくりと彼らのことを知り、"}, {"type": "subtitle", "time": 15583.11, "timestamp": "04:19:43", "text": "えーっと、みんなが望んでくれることを願ってるよ"}, {"type": "subtitle", "time": 15585.59, "timestamp": "04:19:45", "text": "ほら、私を睨んだりとか"}, {"type": "subtitle", "time": 15587.349, "timestamp": "04:19:47", "text": "彼らとコラボしているから、"}, {"type": "subtitle", "time": 15589.95, "timestamp": "04:19:49", "text": "何か、あるいは誰か、あなた"}, {"type": "subtitle", "time": 15593.189, "timestamp": "04:19:53", "text": "知ってる、そしてただ私の信頼を裏切るだけ"}, {"type": "subtitle", "time": 15594.189, "timestamp": "04:19:54", "text": "贈る"}, {"type": "subtitle", "time": 15596.51, "timestamp": "04:19:56", "text": "彼らに"}]
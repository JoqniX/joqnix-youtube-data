[{"type": "subtitle", "time": 8460.71, "timestamp": "02:21:00", "text": "アカウントも、ちょっと失くしてしまいました。それから私は"}, {"type": "subtitle", "time": 8462.87, "timestamp": "02:21:02", "text": "名を上げなければならなかった。私は現在"}, {"type": "subtitle", "time": 8465.71, "timestamp": "02:21:05", "text": "私があなたに送ったものです。それが最新版です。"}, {"type": "subtitle", "time": 8469.27, "timestamp": "02:21:09", "text": "ああ、わかりました。ああ、わかりました。"}, {"type": "subtitle", "time": 8472.55, "timestamp": "02:21:12", "text": "うん。ユーザーを変更できないように"}, {"type": "subtitle", "time": 8475.67, "timestamp": "02:21:15", "text": "他に名前がある場合は、"}, {"type": "subtitle", "time": 8478.55, "timestamp": "02:21:18", "text": "使われていないアカウント。悪い思い出がある"}, {"type": "subtitle", "time": 8481.429, "timestamp": "02:21:21", "text": "Robloxのサポートを体験してください"}, {"type": "subtitle", "time": 8485.03, "timestamp": "02:21:25", "text": "彼らに言ったように、それは私ですが、忘れてしまいました"}, {"type": "subtitle", "time": 8486.95, "timestamp": "02:21:26", "text": "リンクしようとしたら、できないと言われました"}, {"type": "subtitle", "time": 8490.15, "timestamp": "02:21:30", "text": "それでもあなたやその他すべてのことを確認しています。私は"}, {"type": "subtitle", "time": 8493.03, "timestamp": "02:21:33", "text": "ユーザー名を取り戻したいだけなんです。それ"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "他の何かを持っているのは奇妙に感じる"}, {"type": "subtitle", "time": 8501.03, "timestamp": "02:21:41", "text": "ジョーの名前よりも。うん、つまり、"}, {"type": "subtitle", "time": 8503.51, "timestamp": "02:21:43", "text": "つまり、私は悪い経験をしたということです"}, {"type": "subtitle", "time": 8506.15, "timestamp": "02:21:46", "text": "これらのカスタマーサポートすべてと同様に"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "そういう類のものもね。まるで"}, {"type": "subtitle", "time": 8512.23, "timestamp": "02:21:52", "text": "ちょっと面倒くさい。うん。そして"}, {"type": "subtitle", "time": 8515.03, "timestamp": "02:21:55", "text": "はい、私のアカウント名は"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "イーグルプレイス。えっと、私が"}, {"type": "subtitle", "time": 8519.83, "timestamp": "02:21:59", "text": "子供の頃、そう、私は"}]
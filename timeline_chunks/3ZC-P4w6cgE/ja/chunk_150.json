[{"type": "subtitle", "time": 9002.15, "timestamp": "02:30:02", "text": "時には、時には"}, {"type": "subtitle", "time": 9004.87, "timestamp": "02:30:04", "text": "このモンスター、特定のモンスター"}, {"type": "subtitle", "time": 9007.27, "timestamp": "02:30:07", "text": "廊下を走り始める。あなた"}, {"type": "subtitle", "time": 9009.99, "timestamp": "02:30:09", "text": "あの怪物から隠れなければならない。あなたは"}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "ライトがちらつくのが見えるでしょう"}, {"type": "subtitle", "time": 9014.389, "timestamp": "02:30:14", "text": "そして、メガネの音が聞こえるかもしれません"}, {"type": "subtitle", "time": 9019.59, "timestamp": "02:30:19", "text": "壊れてる？急いで入らなきゃ。ああ。うん。"}, {"type": "subtitle", "time": 9022.469, "timestamp": "02:30:22", "text": "だから、そのまま続けてください。私はただ続ける"}, {"type": "subtitle", "time": 9024.389, "timestamp": "02:30:24", "text": "オープン。このゲームは、あなたが"}, {"type": "subtitle", "time": 9026.55, "timestamp": "02:30:26", "text": "どのモンスターが"}, {"type": "subtitle", "time": 9028.87, "timestamp": "02:30:28", "text": "どれに対抗するか、どのように対抗するか"}, {"type": "subtitle", "time": 9033.67, "timestamp": "02:30:33", "text": "100番目のドアにたどり着くまで、ある方法でそれを続けてください。"}, {"type": "subtitle", "time": 9035.429, "timestamp": "02:30:35", "text": "つまり、一種の試練のゲームのようなものだ。"}, {"type": "subtitle", "time": 9052.59, "timestamp": "02:30:52", "text": "うん。通常、ライトが点灯すると"}, {"type": "subtitle", "time": 9055.03, "timestamp": "02:30:55", "text": "ちらつきながら警戒を怠らない"}, {"type": "subtitle", "time": 9057.03, "timestamp": "02:30:57", "text": "周囲の環境を観察し、"}]
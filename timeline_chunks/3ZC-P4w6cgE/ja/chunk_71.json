[{"type": "subtitle", "time": 4261.99, "timestamp": "01:11:01", "text": "忘れた。ええ、YouTube配信の前に"}, {"type": "subtitle", "time": 4265.189, "timestamp": "01:11:05", "text": "3時に。私のタイミングは同じです"}, {"type": "subtitle", "time": 4269.03, "timestamp": "01:11:09", "text": "来週も。午後3時ISTD。私は"}, {"type": "subtitle", "time": 4271.91, "timestamp": "01:11:11", "text": "4に変更しようと思ったのですが、3は"}, {"type": "subtitle", "time": 4275.87, "timestamp": "01:11:15", "text": "まあ、いいでしょう。うん。こんにちは。午後3時"}, {"type": "subtitle", "time": 4278.47, "timestamp": "01:11:18", "text": "私のはすべてのストリームを所有します"}, {"type": "subtitle", "time": 4281.83, "timestamp": "01:11:21", "text": "今週も。うん。だから、覚えておいてください"}, {"type": "subtitle", "time": 4284.229, "timestamp": "01:11:24", "text": "ヴァレラント川が3つ。待って、私が言った？"}, {"type": "subtitle", "time": 4286.95, "timestamp": "01:11:26", "text": "3つか2つか？"}, {"type": "subtitle", "time": 4288.709, "timestamp": "01:11:28", "text": "忘れた。うん。 3つまたは2つのバランス"}, {"type": "subtitle", "time": 4292.95, "timestamp": "01:11:32", "text": "ストリームとストリームの支配者1人"}, {"type": "subtitle", "time": 4296.99, "timestamp": "01:11:36", "text": "ダッシュ。何？ ３、４、５。五"}, {"type": "subtitle", "time": 4301.31, "timestamp": "01:11:41", "text": "日。まだ金曜日だよ。それから1つ"}, {"type": "subtitle", "time": 4304.07, "timestamp": "01:11:44", "text": "もっと。いや、いや、あと２人。右。あと2人。"}, {"type": "subtitle", "time": 4306.149, "timestamp": "01:11:46", "text": "うーん、わからない。私たちは変わるかもしれない。おお、"}, {"type": "subtitle", "time": 4308.79, "timestamp": "01:11:48", "text": "待って。歌う必要があるよ、兄弟"}, {"type": "subtitle", "time": 4310.11, "timestamp": "01:11:50", "text": "ストリーム。"}, {"type": "subtitle", "time": 4314.95, "timestamp": "01:11:54", "text": "H. ああ、いやだ。私はその曲を準備していません。"}, {"type": "subtitle", "time": 4319.11, "timestamp": "01:11:59", "text": "なんてこった。でも大丈夫。私たちはそうします"}]
[{"type": "subtitle", "time": 5700.27, "timestamp": "01:35:00", "text": "私は"}, {"type": "subtitle", "time": 5703.03, "timestamp": "01:35:03", "text": "これ。私の電源をオンにして、私の電源をオフにします"}, {"type": "subtitle", "time": 5705.229, "timestamp": "01:35:05", "text": "ノイズ"}, {"type": "subtitle", "time": 5709.03, "timestamp": "01:35:09", "text": "抑制。わかった。全てが聞こえる。"}, {"type": "subtitle", "time": 5710.99, "timestamp": "01:35:10", "text": "じゃあ、私の"}, {"type": "subtitle", "time": 5713.47, "timestamp": "01:35:13", "text": "鼻。"}, {"type": "subtitle", "time": 5718.189, "timestamp": "01:35:18", "text": "ブープ。聞こえますか？私は鼻を鳴らしています"}, {"type": "subtitle", "time": 5722.04, "timestamp": "01:35:22", "text": "あなた。あれは本当に恥ずかしかった。ああ、"}, {"type": "subtitle", "time": 5724.11, "timestamp": "01:35:24", "text": "[音楽]"}, {"type": "subtitle", "time": 5727.03, "timestamp": "01:35:27", "text": "神。何てことだ。私はそれをしました。何てことだ。"}, {"type": "subtitle", "time": 5728.59, "timestamp": "01:35:28", "text": "自分がそんなことをしたなんて信じられない"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "ああ。何てことだ。絶対にそんなことはしない。私の"}, {"type": "subtitle", "time": 5741.11, "timestamp": "01:35:41", "text": "実際に初めて"}, {"type": "subtitle", "time": 5744.95, "timestamp": "01:35:44", "text": "マイクの口が下がってきて"}, {"type": "subtitle", "time": 5746.75, "timestamp": "01:35:46", "text": "ブープして"}, {"type": "subtitle", "time": 5749.59, "timestamp": "01:35:49", "text": "鼻。待って、鼻がどうやって爆発するのか不思議だ"}, {"type": "subtitle", "time": 5754.629, "timestamp": "01:35:54", "text": "それはどんな感じだろうか。それってアニメじゃない？"}, {"type": "subtitle", "time": 5758.55, "timestamp": "01:35:58", "text": "えっと、鼻とおっぱいみたいなギフト"}]
[{"type": "subtitle", "time": 19321.55, "timestamp": "05:22:01", "text": "君はとってもかわいい"}, {"type": "subtitle", "time": 19324.27, "timestamp": "05:22:04", "text": "など"}, {"type": "subtitle", "time": 19337.43, "timestamp": "05:22:17", "text": "よし、最初から始めよう。それで、えーと"}, {"type": "subtitle", "time": 19339.55, "timestamp": "05:22:19", "text": "ご覧のとおり"}, {"type": "subtitle", "time": 19344.03, "timestamp": "05:22:24", "text": "えっと、私のキラキラ光るもの"}, {"type": "subtitle", "time": 19352.03, "timestamp": "05:22:32", "text": "花火。"}, {"type": "subtitle", "time": 19355.03, "timestamp": "05:22:35", "text": "そして2つ目は、えーっと、えーっと"}, {"type": "subtitle", "time": 19358.708, "timestamp": "05:22:38", "text": "あの紫色の物体が見えますか？私は疑問に思う"}, {"type": "subtitle", "time": 19361.948, "timestamp": "05:22:41", "text": "それは一体何なのか。推測は"}, {"type": "subtitle", "time": 19364.91, "timestamp": "05:22:44", "text": "チャット？あなたはどう思いますか"}, {"type": "subtitle", "time": 19367.91, "timestamp": "05:22:47", "text": "は？えっと、私の右の方へ。髪"}, {"type": "subtitle", "time": 19371.19, "timestamp": "05:22:51", "text": "右側にクリップがあります。それは"}, {"type": "subtitle", "time": 19373.15, "timestamp": "05:22:53", "text": "正しい。右。うん。"}, {"type": "subtitle", "time": 19377.19, "timestamp": "05:22:57", "text": "右。こんにちは。正しい。どう思いますか"}]
[{"type": "subtitle", "time": 5160.55, "timestamp": "01:26:00", "text": "あなたにとっては午後と夕方が都合の良い時間帯ですよね？それで"}, {"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "うん、でも休憩も必要だよ"}, {"type": "subtitle", "time": 5165.99, "timestamp": "01:26:05", "text": "そして、自分がやりたかったアート活動をする"}, {"type": "subtitle", "time": 5167.229, "timestamp": "01:26:07", "text": "そして"}, {"type": "subtitle", "time": 5169.27, "timestamp": "01:26:09", "text": "すべて。待って、あなたは歩いて来なかったわね。"}, {"type": "subtitle", "time": 5171.27, "timestamp": "01:26:11", "text": "あなたは休んでいると言いました"}, {"type": "subtitle", "time": 5174.189, "timestamp": "01:26:14", "text": "あなたが仕事をしている時だったんですよね？私のミスです。それで"}, {"type": "subtitle", "time": 5177.11, "timestamp": "01:26:17", "text": "ええ、一度たくさん取らなければならない"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "まず、治療を受ける方法を知っておくことが重要です。"}, {"type": "subtitle", "time": 5182.629, "timestamp": "01:26:22", "text": "良いものをいくつか持って、"}, {"type": "subtitle", "time": 5185.35, "timestamp": "01:26:25", "text": "君は、心で戦うことの本質を知っているよね。"}, {"type": "subtitle", "time": 5187.55, "timestamp": "01:26:27", "text": "はぁ？"}, {"type": "subtitle", "time": 5191.59, "timestamp": "01:26:31", "text": "ぜひお越しください。そして、メリークリスマスイブをお過ごしください。"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "H、そしてそうでない人たちのためにも"}, {"type": "subtitle", "time": 5202.95, "timestamp": "01:26:42", "text": "ウブ・チャマが描いたのは"}, {"type": "subtitle", "time": 5205.669, "timestamp": "01:26:45", "text": "この素晴らしい芸術作品。私にさせて"}, {"type": "subtitle", "time": 5213.79, "timestamp": "01:26:53", "text": "みんな。これってすごく可愛いと思いませんか？これは私の"}, {"type": "subtitle", "time": 5216.95, "timestamp": "01:26:56", "text": "私が持っている最初のクリスマスプレゼント"}, {"type": "subtitle", "time": 5218.669, "timestamp": "01:26:58", "text": "として受け取った"}]
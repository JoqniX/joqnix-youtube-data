[{"type": "subtitle", "time": 1594.35, "timestamp": "00:26:34", "text": "ニース。"}, {"type": "subtitle", "time": 1596.789, "timestamp": "00:26:36", "text": "それでは、メリークリスマス。良い一年をお過ごしください。"}, {"type": "subtitle", "time": 1600.47, "timestamp": "00:26:40", "text": "はい。あなたも。良い一年になりますように。"}, {"type": "subtitle", "time": 1608.549, "timestamp": "00:26:48", "text": "死んだ皮膚細胞。"}]
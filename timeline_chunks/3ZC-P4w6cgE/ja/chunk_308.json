[{"type": "subtitle", "time": 18486.47, "timestamp": "05:08:06", "text": "私はうるさいですか？それも話している"}, {"type": "subtitle", "time": 18489.55, "timestamp": "05:08:09", "text": "多くの。それはマンガの音ですか？"}, {"type": "subtitle", "time": 18492.55, "timestamp": "05:08:12", "text": "背景？わからない。わからない。"}, {"type": "subtitle", "time": 18505.788, "timestamp": "05:08:25", "text": "それ。それは本当に"}, {"type": "subtitle", "time": 18510.31, "timestamp": "05:08:30", "text": "多く。ええ、そうですね。えっと、続きをさせてください。えっと、何？"}, {"type": "subtitle", "time": 18512.35, "timestamp": "05:08:32", "text": "発表する前に言っていたんです。"}, {"type": "subtitle", "time": 18517.55, "timestamp": "05:08:37", "text": "続き"}, {"type": "subtitle", "time": 18519.708, "timestamp": "05:08:39", "text": "続く。えっと、"}, {"type": "subtitle", "time": 18524.15, "timestamp": "05:08:44", "text": "こんにちは。だから、いつものようにいつも"}, {"type": "subtitle", "time": 18526.99, "timestamp": "05:08:46", "text": "働きすぎている"}, {"type": "subtitle", "time": 18530.39, "timestamp": "05:08:50", "text": "特にストリーム関連のことと"}, {"type": "subtitle", "time": 18534.55, "timestamp": "05:08:54", "text": "その後、私は、私は、"}, {"type": "subtitle", "time": 18537.23, "timestamp": "05:08:57", "text": "猫にさえ注意を払わなかった"}]
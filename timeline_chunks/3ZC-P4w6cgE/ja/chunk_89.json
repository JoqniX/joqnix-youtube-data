[{"type": "subtitle", "time": 5342.03, "timestamp": "01:29:02", "text": "すべて。いいえ、私にはわかりません"}, {"type": "subtitle", "time": 5345.43, "timestamp": "01:29:05", "text": "本日配信されました。おそらく知っている"}, {"type": "subtitle", "time": 5348.55, "timestamp": "01:29:08", "text": "サラは、きっと忙しかっただろう"}, {"type": "subtitle", "time": 5352.07, "timestamp": "01:29:12", "text": "一生懸命働いています。だから、たぶん"}, {"type": "subtitle", "time": 5355.709, "timestamp": "01:29:15", "text": "そうだったかもしれない。わからない。しかし"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "はい、来てくれてありがとう。"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "立ち寄ってくれて嬉しいです。"}, {"type": "subtitle", "time": 5372.79, "timestamp": "01:29:32", "text": "パッチ。ええ、みんなにヘッドパッチを"}, {"type": "subtitle", "time": 5374.709, "timestamp": "01:29:34", "text": "良い。私がそれを与えるのは"}, {"type": "subtitle", "time": 5376.229, "timestamp": "01:29:36", "text": "シャラシュ。これは誰にとっても役立つものです。私はただ"}, {"type": "subtitle", "time": 5378.39, "timestamp": "01:29:38", "text": "ヘッドバックを忘れていたことに気づいた。おお、"}, {"type": "subtitle", "time": 5381.35, "timestamp": "01:29:41", "text": "待って。 I の頭の部分はどこですか"}, {"type": "subtitle", "time": 5383.229, "timestamp": "01:29:43", "text": "こっちに置くべきだ。"}, {"type": "subtitle", "time": 5385.95, "timestamp": "01:29:45", "text": "待って。こちらに置くべきだ。"}, {"type": "subtitle", "time": 5389.51, "timestamp": "01:29:49", "text": "待って。待ってください。これをコピーさせてください。私は必要としている"}, {"type": "subtitle", "time": 5391.91, "timestamp": "01:29:51", "text": "いつかアニメーションを作るように"}, {"type": "subtitle", "time": 5395.06, "timestamp": "01:29:55", "text": "以前は1日だけだった。そこにいる"}, {"type": "subtitle", "time": 5396.59, "timestamp": "01:29:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5399.31, "timestamp": "01:29:59", "text": "行く。これは"}]
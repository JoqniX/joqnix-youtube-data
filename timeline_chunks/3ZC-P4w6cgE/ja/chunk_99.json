[{"type": "subtitle", "time": 5949.59, "timestamp": "01:39:09", "text": "分。わかった。どうでも。私はただ"}, {"type": "subtitle", "time": 5952.47, "timestamp": "01:39:12", "text": "その時は、そんなことを知るべきではなかったと気づいた"}, {"type": "subtitle", "time": 5955.189, "timestamp": "01:39:15", "text": "すると質問は"}, {"type": "subtitle", "time": 5958.07, "timestamp": "01:39:18", "text": "えっと、この謎の手は誰？"}, {"type": "subtitle", "time": 5959.47, "timestamp": "01:39:19", "text": "それはジョッキーではない"}, {"type": "subtitle", "time": 5962.27, "timestamp": "01:39:22", "text": "運動部員ではない人"}, {"type": "subtitle", "time": 5964.43, "timestamp": "01:39:24", "text": "手"}, {"type": "subtitle", "time": 5967.51, "timestamp": "01:39:27", "text": "ああ、そう、それは私の手だけど、"}, {"type": "subtitle", "time": 5972.109, "timestamp": "01:39:32", "text": "私の手をホ・チャマと名付けて、"}, {"type": "subtitle", "time": 5975.59, "timestamp": "01:39:35", "text": "心配するな、まるで俺が自分の名前をつけるように"}, {"type": "subtitle", "time": 5979.75, "timestamp": "01:39:39", "text": "私のマウス、チャマ・モナマ・キーボードへ。ママ"}, {"type": "subtitle", "time": 5983.59, "timestamp": "01:39:43", "text": "写真？私の何？私の枕。すべて"}, {"type": "subtitle", "time": 5995.31, "timestamp": "01:39:55", "text": "神。おお"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "神。うん。そういう風に考えてみてください。"}]
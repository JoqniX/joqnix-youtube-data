[{"type": "subtitle", "time": 18901.91, "timestamp": "05:15:01", "text": "実際に椅子から落ちて"}, {"type": "subtitle", "time": 18902.75, "timestamp": "05:15:02", "text": "開始"}, {"type": "subtitle", "time": 18909.59, "timestamp": "05:15:09", "text": "私には耐えられないほどだったから、たくさん。"}, {"type": "subtitle", "time": 18919.59, "timestamp": "05:15:19", "text": "ああ、それから彼女が実際に好きなとき"}, {"type": "subtitle", "time": 18921.91, "timestamp": "05:15:21", "text": "その日、私に送ってきた"}, {"type": "subtitle", "time": 18924.868, "timestamp": "05:15:24", "text": "それ自体、あるいはそう、翌日彼女は送ってきた"}, {"type": "subtitle", "time": 18928.59, "timestamp": "05:15:28", "text": "カラー版を見て、私はこう思った"}, {"type": "subtitle", "time": 18938.19, "timestamp": "05:15:38", "text": "私の彼女は実際に彼女は"}, {"type": "subtitle", "time": 18942.55, "timestamp": "05:15:42", "text": "実際、これをどう言うか"}, {"type": "subtitle", "time": 18945.51, "timestamp": "05:15:45", "text": "えっと、ちゃんと？困ったことがあって"}, {"type": "subtitle", "time": 18947.51, "timestamp": "05:15:47", "text": "それを使うための適切な言葉を見つける。"}, {"type": "subtitle", "time": 18950.43, "timestamp": "05:15:50", "text": "でも私は心"}, {"type": "subtitle", "time": 18957.948, "timestamp": "05:15:57", "text": "おお。"}]
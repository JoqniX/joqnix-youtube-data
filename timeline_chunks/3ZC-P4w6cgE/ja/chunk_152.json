[{"type": "subtitle", "time": 9126.63, "timestamp": "02:32:06", "text": "ああ、わかった。待って、ない"}, {"type": "subtitle", "time": 9130.349, "timestamp": "02:32:10", "text": "スプリント。ええ、ありません"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "おお。よし。だから、家にいるのは避けてください。"}, {"type": "subtitle", "time": 9152.309, "timestamp": "02:32:32", "text": "暗闇が長すぎた。時々"}, {"type": "subtitle", "time": 9155.59, "timestamp": "02:32:35", "text": "あなたにささやくような怪物"}, {"type": "subtitle", "time": 9158.389, "timestamp": "02:32:38", "text": "あるいは、「ああ、見ないで"}, {"type": "subtitle", "time": 9160.87, "timestamp": "02:32:40", "text": "青。青色を見るな。"}, {"type": "subtitle", "time": 9162.91, "timestamp": "02:32:42", "text": "ええと、あります"}, {"type": "subtitle", "time": 9166.91, "timestamp": "02:32:46", "text": "だから"}, {"type": "subtitle", "time": 9172.03, "timestamp": "02:32:52", "text": "ええ、壁に沿って進むと次の"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "ドア。非常に素晴らしい。実績を解除しました。"}]
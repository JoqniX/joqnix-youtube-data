[{"type": "subtitle", "time": 9240.95, "timestamp": "02:34:00", "text": "うん。うん。うん。待って。私はそう思った"}, {"type": "subtitle", "time": 9244.07, "timestamp": "02:34:04", "text": "彼は私を殺すつもりはなかった。"}, {"type": "subtitle", "time": 9248.309, "timestamp": "02:34:08", "text": "え、誰？あの幽霊。"}, {"type": "subtitle", "time": 9251.59, "timestamp": "02:34:11", "text": "えっと、どの幽霊ですか？起こったことは"}, {"type": "subtitle", "time": 9256.11, "timestamp": "02:34:16", "text": "は私たちを悩ませる。ああ、その"}, {"type": "subtitle", "time": 9258.71, "timestamp": "02:34:18", "text": "白い目をした黒い球体、または"}, {"type": "subtitle", "time": 9261.11, "timestamp": "02:34:21", "text": "何か。あるいは、"}, {"type": "subtitle", "time": 9263.83, "timestamp": "02:34:23", "text": "廊下。ええ、"}, {"type": "subtitle", "time": 9267.03, "timestamp": "02:34:27", "text": "私たちが隠れていたまさにその時。ああ、それ"}, {"type": "subtitle", "time": 9269.19, "timestamp": "02:34:29", "text": "いいえ、それはあなたに害を与えません。 1つ"}, {"type": "subtitle", "time": 9271.349, "timestamp": "02:34:31", "text": "あなたを傷つけていたのは、内側にあったものだった"}, {"type": "subtitle", "time": 9272.429, "timestamp": "02:34:32", "text": "あなたの"}, {"type": "subtitle", "time": 9275.429, "timestamp": "02:34:35", "text": "食器棚。それは、あなたがそこにいるときに起こります。"}, {"type": "subtitle", "time": 9277.19, "timestamp": "02:34:37", "text": "暗闇の中に長くいると"}, {"type": "subtitle", "time": 9278.79, "timestamp": "02:34:38", "text": "長くこの戸棚に留まるか、"}, {"type": "subtitle", "time": 9281.19, "timestamp": "02:34:41", "text": "長く続けると、あなたに害を与え、痛みをもたらします"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "あなた。"}, {"type": "subtitle", "time": 9286.75, "timestamp": "02:34:46", "text": "この青い光は何ですか？"}, {"type": "subtitle", "time": 9290.95, "timestamp": "02:34:50", "text": "えっと、つまり、私はこう言っていると思う"}, {"type": "subtitle", "time": 9293.469, "timestamp": "02:34:53", "text": "何でもありません。ただのドアだと思うよ。"}, {"type": "subtitle", "time": 9296.91, "timestamp": "02:34:56", "text": "ほとんど逆方向に進むような感じですが、"}]
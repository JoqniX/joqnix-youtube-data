[{"type": "subtitle", "time": 1861.122, "timestamp": "00:31:01", "text": "放我出去。"}, {"type": "subtitle", "time": 1862.666, "timestamp": "00:31:02", "text": "好的。"}, {"type": "subtitle", "time": 1867.297, "timestamp": "00:31:07", "text": "但我……我什么都不知道。"}, {"type": "subtitle", "time": 1867.825, "timestamp": "00:31:07", "text": "做过。"}, {"type": "subtitle", "time": 1870.155, "timestamp": "00:31:10", "text": "哦，确认了。"}, {"type": "subtitle", "time": 1871.387, "timestamp": "00:31:11", "text": "先生，请去洗手间。"}, {"type": "subtitle", "time": 1872.605, "timestamp": "00:31:12", "text": "杰克。请，"}, {"type": "subtitle", "time": 1873.857, "timestamp": "00:31:13", "text": "不要杀人。"}, {"type": "subtitle", "time": 1875.538, "timestamp": "00:31:15", "text": "好了，关门了。"}, {"type": "subtitle", "time": 1877.244, "timestamp": "00:31:17", "text": "解锁。"}, {"type": "subtitle", "time": 1881.041, "timestamp": "00:31:21", "text": "为什么是这个洗手间？"}, {"type": "subtitle", "time": 1882.241, "timestamp": "00:31:22", "text": "打开？什么样的"}, {"type": "subtitle", "time": 1896.596, "timestamp": "00:31:36", "text": "妄想？躺。"}, {"type": "subtitle", "time": 1899.44, "timestamp": "00:31:39", "text": "陡峭地。好的。"}, {"type": "subtitle", "time": 1900.945, "timestamp": "00:31:40", "text": "好的。顺便说一下，现在"}, {"type": "subtitle", "time": 1902.202, "timestamp": "00:31:42", "text": "那边的门是开着的。"}, {"type": "subtitle", "time": 1903.262, "timestamp": "00:31:43", "text": "万一。"}, {"type": "subtitle", "time": 1904.586, "timestamp": "00:31:44", "text": "好的。"}, {"type": "subtitle", "time": 1906.293, "timestamp": "00:31:46", "text": "请勿打开这些"}, {"type": "subtitle", "time": 1913.596, "timestamp": "00:31:53", "text": "门。你去。"}, {"type": "subtitle", "time": 1918.263, "timestamp": "00:31:58", "text": "嗯哼。"}]
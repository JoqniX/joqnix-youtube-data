[{"type": "subtitle", "time": 1682.633, "timestamp": "00:28:02", "text": "我总是感到困惑。"}, {"type": "subtitle", "time": 1686.339, "timestamp": "00:28:06", "text": "是的，白色盾牌是"}, {"type": "subtitle", "time": 1687.492, "timestamp": "00:28:07", "text": "酷，但又"}, {"type": "subtitle", "time": 1688.54, "timestamp": "00:28:08", "text": "是的，我无处不在。"}, {"type": "subtitle", "time": 1689.658, "timestamp": "00:28:09", "text": "令人目眩，而且"}, {"type": "subtitle", "time": 1691.6, "timestamp": "00:28:11", "text": "邪恶的。那我收下吧。"}, {"type": "subtitle", "time": 1693.559, "timestamp": "00:28:13", "text": "战术头盔。他"}, {"type": "subtitle", "time": 1694.567, "timestamp": "00:28:14", "text": "很适合我。"}, {"type": "subtitle", "time": 1703.009, "timestamp": "00:28:23", "text": "杰克，"}, {"type": "subtitle", "time": 1705.355, "timestamp": "00:28:25", "text": "你改变了你的……哦，"}, {"type": "subtitle", "time": 1706.795, "timestamp": "00:28:26", "text": "去他妈的，杰克。"}, {"type": "subtitle", "time": 1708.683, "timestamp": "00:28:28", "text": "你刚才拿了一把AK-47。"}, {"type": "subtitle", "time": 1710.14, "timestamp": "00:28:30", "text": "你可以搬离你现在的地方，"}, {"type": "subtitle", "time": 1710.569, "timestamp": "00:28:30", "text": "杰克？"}, {"type": "subtitle", "time": 1712.8220000000001, "timestamp": "00:28:32", "text": "呃，稍等一下，游戏。"}, {"type": "subtitle", "time": 1716.634, "timestamp": "00:28:36", "text": "哦是的。谢谢。你想要？"}, {"type": "subtitle", "time": 1718.127, "timestamp": "00:28:38", "text": "走在前面还是后面？"}, {"type": "subtitle", "time": 1719.699, "timestamp": "00:28:39", "text": "好的，兄弟。选择"}, {"type": "subtitle", "time": 1722.671, "timestamp": "00:28:42", "text": "这次轮到你了。为什么"}, {"type": "subtitle", "time": 1724.082, "timestamp": "00:28:44", "text": "屏幕上有一个光标。"}, {"type": "subtitle", "time": 1724.435, "timestamp": "00:28:44", "text": "老鼠？"}, {"type": "subtitle", "time": 1730.042, "timestamp": "00:28:50", "text": "是的，那很好。但是你"}, {"type": "subtitle", "time": 1731.28, "timestamp": "00:28:51", "text": "你也会射击，所以"}, {"type": "subtitle", "time": 1732.175, "timestamp": "00:28:52", "text": "不要这样做。"}, {"type": "subtitle", "time": 1736.944, "timestamp": "00:28:56", "text": "我的天啊。再次。"}, {"type": "subtitle", "time": 1739.564, "timestamp": "00:28:59", "text": "不用担心。不是"}]
[{"type": "subtitle", "time": 4021.087, "timestamp": "01:07:01", "text": "我之所以不这么做，是因为我"}, {"type": "subtitle", "time": 4022.44, "timestamp": "01:07:02", "text": "我用的是CS，所以"}, {"type": "subtitle", "time": 4023.259, "timestamp": "01:07:03", "text": "这些人是什么人？"}, {"type": "subtitle", "time": 4023.936, "timestamp": "01:07:03", "text": "主要"}, {"type": "subtitle", "time": 4025.037, "timestamp": "01:07:05", "text": "抱歉。"}, {"type": "subtitle", "time": 4028.942, "timestamp": "01:07:08", "text": "呃，口罩，口罩。"}, {"type": "subtitle", "time": 4031.002, "timestamp": "01:07:11", "text": "我看到其中一个"}, {"type": "subtitle", "time": 4031.728, "timestamp": "01:07:11", "text": "射击者。"}, {"type": "subtitle", "time": 4033.391, "timestamp": "01:07:13", "text": "是的，我需要它。"}, {"type": "subtitle", "time": 4034.771, "timestamp": "01:07:14", "text": "机器。我需要"}, {"type": "subtitle", "time": 4036.044, "timestamp": "01:07:16", "text": "返回我们的"}, {"type": "subtitle", "time": 4036.987, "timestamp": "01:07:16", "text": "创造者。是的。"}, {"type": "subtitle", "time": 4040.938, "timestamp": "01:07:20", "text": "哦，对了，我们的“小动物们”"}, {"type": "subtitle", "time": 4042.566, "timestamp": "01:07:22", "text": "可以自由支配"}, {"type": "subtitle", "time": 4045.353, "timestamp": "01:07:25", "text": "是的。是的。那是周末。"}, {"type": "subtitle", "time": 4046.46, "timestamp": "01:07:26", "text": "免费游戏"}, {"type": "subtitle", "time": 4047.531, "timestamp": "01:07:27", "text": "因为很多人"}, {"type": "subtitle", "time": 4048.92, "timestamp": "01:07:28", "text": "他们说这很有趣，而且"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "所有这些。"}, {"type": "subtitle", "time": 4050.737, "timestamp": "01:07:30", "text": "这很有趣，"}, {"type": "subtitle", "time": 4052.994, "timestamp": "01:07:32", "text": "但问题是，我没有"}, {"type": "subtitle", "time": 4054.922, "timestamp": "01:07:34", "text": "能够玩。我"}, {"type": "subtitle", "time": 4056.435, "timestamp": "01:07:36", "text": "玩不了。"}, {"type": "subtitle", "time": 4059.157, "timestamp": "01:07:39", "text": "我不知道。我不知道。"}, {"type": "subtitle", "time": 4060.572, "timestamp": "01:07:40", "text": "我认为这是"}, {"type": "subtitle", "time": 4062.058, "timestamp": "01:07:42", "text": "这让我想起了《命运2》。"}, {"type": "subtitle", "time": 4064.416, "timestamp": "01:07:44", "text": "这样一款游戏，你需要"}, {"type": "subtitle", "time": 4065.515, "timestamp": "01:07:45", "text": "努力奋斗。"}, {"type": "subtitle", "time": 4068.077, "timestamp": "01:07:48", "text": "是的，这是萃取。 射手。"}, {"type": "subtitle", "time": 4071.293, "timestamp": "01:07:51", "text": "这里有湿巾之类的东西。"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "像这样。"}, {"type": "subtitle", "time": 4073.738, "timestamp": "01:07:53", "text": "非常非常烦人"}, {"type": "subtitle", "time": 4075.59, "timestamp": "01:07:55", "text": "游戏。我就是这样："}, {"type": "subtitle", "time": 4078.322, "timestamp": "01:07:58", "text": "感觉很快。"}, {"type": "subtitle", "time": 4079.906, "timestamp": "01:07:59", "text": "我不想回去。 。"}]
[{"type": "subtitle", "time": 2340.27, "timestamp": "00:39:00", "text": "装备，带上它"}, {"type": "subtitle", "time": 2341.505, "timestamp": "00:39:01", "text": "一个致命的和一个"}, {"type": "subtitle", "time": 2342.642, "timestamp": "00:39:02", "text": "非致命性武器和"}, {"type": "subtitle", "time": 2343.293, "timestamp": "00:39:03", "text": "我们开始吧。"}, {"type": "subtitle", "time": 2345.945, "timestamp": "00:39:05", "text": "我……我吃了两份。"}, {"type": "subtitle", "time": 2346.716, "timestamp": "00:39:06", "text": "致命。"}, {"type": "subtitle", "time": 2348.666, "timestamp": "00:39:08", "text": "嗯。"}, {"type": "subtitle", "time": 2349.752, "timestamp": "00:39:09", "text": "哦，一个致命的。"}, {"type": "subtitle", "time": 2351.092, "timestamp": "00:39:11", "text": "一种非致命性。是的。"}, {"type": "subtitle", "time": 2352.649, "timestamp": "00:39:12", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 2355.153, "timestamp": "00:39:15", "text": "好的，明白了。更短，"}, {"type": "subtitle", "time": 2356.029, "timestamp": "00:39:16", "text": "总是选择"}, {"type": "subtitle", "time": 2357.241, "timestamp": "00:39:17", "text": "非致命性武器，以及"}, {"type": "subtitle", "time": 2358.386, "timestamp": "00:39:18", "text": "然后开枪，"}, {"type": "subtitle", "time": 2359.464, "timestamp": "00:39:19", "text": "如果他们不喜欢你"}, {"type": "subtitle", "time": 2361.879, "timestamp": "00:39:21", "text": "正在聆听。好的，"}, {"type": "subtitle", "time": 2363.039, "timestamp": "00:39:23", "text": "杰克先生，你"}, {"type": "subtitle", "time": 2363.982, "timestamp": "00:39:23", "text": "你知道那是什么吗？"}, {"type": "subtitle", "time": 2364.925, "timestamp": "00:39:24", "text": "光噪声。"}, {"type": "subtitle", "time": 2367.439, "timestamp": "00:39:27", "text": "呃，我有三个。"}, {"type": "subtitle", "time": 2368.466, "timestamp": "00:39:28", "text": "光噪声。"}, {"type": "subtitle", "time": 2369.71, "timestamp": "00:39:29", "text": "轻微的噪音。"}, {"type": "subtitle", "time": 2370.989, "timestamp": "00:39:30", "text": "是的，你知道的"}, {"type": "subtitle", "time": 2373.446, "timestamp": "00:39:33", "text": "光噪声。只是"}, {"type": "subtitle", "time": 2374.562, "timestamp": "00:39:34", "text": "你打开门，"}, {"type": "subtitle", "time": 2375.714, "timestamp": "00:39:35", "text": "你扔了一枚手榴弹"}, {"type": "subtitle", "time": 2378.369, "timestamp": "00:39:38", "text": "之内。通常"}, {"type": "subtitle", "time": 2379.768, "timestamp": "00:39:39", "text": "这是我的工作。但"}, {"type": "subtitle", "time": 2381.466, "timestamp": "00:39:41", "text": "如果你打扫卫生，嗯，"}, {"type": "subtitle", "time": 2382.003, "timestamp": "00:39:42", "text": "你知道，"}, {"type": "subtitle", "time": 2384.322, "timestamp": "00:39:44", "text": "好吧，除了我以外，"}, {"type": "subtitle", "time": 2387.792, "timestamp": "00:39:47", "text": "你可以做到。"}, {"type": "subtitle", "time": 2391.079, "timestamp": "00:39:51", "text": "路障，情况与"}, {"type": "subtitle", "time": 2391.979, "timestamp": "00:39:51", "text": "人质。"}, {"type": "subtitle", "time": 2396.033, "timestamp": "00:39:56", "text": "主耶稣。"}, {"type": "subtitle", "time": 2398.742, "timestamp": "00:39:58", "text": "我很喜欢我的那台。"}]
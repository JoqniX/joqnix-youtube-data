[{"type": "subtitle", "time": 4141.929, "timestamp": "01:09:01", "text": "这里。我刚刚收到"}, {"type": "subtitle", "time": 4143.274, "timestamp": "01:09:03", "text": "胸口中弹了，伙计。"}, {"type": "subtitle", "time": 4144.67, "timestamp": "01:09:04", "text": "你加入我们多久了？"}, {"type": "subtitle", "time": 4145.408, "timestamp": "01:09:05", "text": "快到了。"}, {"type": "subtitle", "time": 4146.696, "timestamp": "01:09:06", "text": "我觉得自己很蠢。"}, {"type": "subtitle", "time": 4147.786, "timestamp": "01:09:07", "text": "医生，这是一艘攻击舰。"}, {"type": "subtitle", "time": 4148.97, "timestamp": "01:09:08", "text": "团体。怀疑"}, {"type": "subtitle", "time": 4150.01, "timestamp": "01:09:10", "text": "被拘留，准备就绪"}, {"type": "subtitle", "time": 4150.713, "timestamp": "01:09:10", "text": "撤离前。"}, {"type": "subtitle", "time": 4151.914, "timestamp": "01:09:11", "text": "公认。是"}, {"type": "subtitle", "time": 4152.645, "timestamp": "01:09:12", "text": "准备好。"}, {"type": "subtitle", "time": 4154.216, "timestamp": "01:09:14", "text": "Sierra-1呼叫"}, {"type": "subtitle", "time": 4155.496, "timestamp": "01:09:15", "text": "突击队。我"}, {"type": "subtitle", "time": 4156.745, "timestamp": "01:09:16", "text": "场上失手了。"}, {"type": "subtitle", "time": 4157.093, "timestamp": "01:09:17", "text": "想象。"}, {"type": "subtitle", "time": 4163.236, "timestamp": "01:09:23", "text": "这就是武器。警察。"}, {"type": "subtitle", "time": 4164.809, "timestamp": "01:09:24", "text": "立即落地。在"}, {"type": "subtitle", "time": 4166.287, "timestamp": "01:09:26", "text": "土地。举手。"}, {"type": "subtitle", "time": 4168.249, "timestamp": "01:09:28", "text": "我的天啊，怎么会这样"}, {"type": "subtitle", "time": 4174.553, "timestamp": "01:09:34", "text": "太多了。"}, {"type": "subtitle", "time": 4175.457, "timestamp": "01:09:35", "text": "嫌疑人。"}, {"type": "subtitle", "time": 4177.27, "timestamp": "01:09:37", "text": "我不明白。我是什么？"}, {"type": "subtitle", "time": 4177.968, "timestamp": "01:09:37", "text": "做过？"}, {"type": "subtitle", "time": 4179.391, "timestamp": "01:09:39", "text": "这是一个攻击小组。"}, {"type": "subtitle", "time": 4185.428, "timestamp": "01:09:45", "text": "这是塞拉。丢失的"}, {"type": "subtitle", "time": 4186.562, "timestamp": "01:09:46", "text": "视觉接触"}, {"type": "subtitle", "time": 4187.759, "timestamp": "01:09:47", "text": "与突击队一起。"}, {"type": "subtitle", "time": 4189.917, "timestamp": "01:09:49", "text": "现场警员"}]
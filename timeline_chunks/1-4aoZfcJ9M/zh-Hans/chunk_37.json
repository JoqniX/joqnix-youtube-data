[{"type": "subtitle", "time": 2222.981, "timestamp": "00:37:02", "text": "真是见鬼了。 就像兰博基尼里的武器一样。"}, {"type": "subtitle", "time": 2225.789, "timestamp": "00:37:05", "text": "啊哈。"}, {"type": "subtitle", "time": 2229.567, "timestamp": "00:37:09", "text": "乌兹。哦，PP。 PP。我就是这样："}, {"type": "subtitle", "time": 2230.945, "timestamp": "00:37:10", "text": "“杰克，我早就跟你说过。”"}, {"type": "subtitle", "time": 2232.435, "timestamp": "00:37:12", "text": "去……请不要"}, {"type": "subtitle", "time": 2233.813, "timestamp": "00:37:13", "text": "从兰博手中夺过武器 里面……“警察"}, {"type": "subtitle", "time": 2240.834, "timestamp": "00:37:20", "text": "里面……“警察 略带震惊：“嗯，这"}, {"type": "subtitle", "time": 2242.016, "timestamp": "00:37:22", "text": "略带震惊：“嗯，这 他是恐怖分子吗？"}, {"type": "subtitle", "time": 2243.302, "timestamp": "00:37:23", "text": "他是恐怖分子吗？ “谁是恐怖分子的同伙？”不"}, {"type": "subtitle", "time": 2246.463, "timestamp": "00:37:26", "text": "“谁是恐怖分子的同伙？”不 我知道。"}, {"type": "subtitle", "time": 2249.282, "timestamp": "00:37:29", "text": "哦，BLB。"}, {"type": "subtitle", "time": 2254.982, "timestamp": "00:37:34", "text": "等等，我们……好吧。好的。"}, {"type": "subtitle", "time": 2255.592, "timestamp": "00:37:35", "text": "问候。"}, {"type": "subtitle", "time": 2259.758, "timestamp": "00:37:39", "text": "乔，你好吗？我有"}, {"type": "subtitle", "time": 2261.716, "timestamp": "00:37:41", "text": "一切都很好。阿利索，"}, {"type": "subtitle", "time": 2266.171, "timestamp": "00:37:46", "text": "我很好。我"}, {"type": "subtitle", "time": 2267.552, "timestamp": "00:37:47", "text": "今天做了一堆"}, {"type": "subtitle", "time": 2269.954, "timestamp": "00:37:49", "text": "事件。相关事项"}, {"type": "subtitle", "time": 2272.944, "timestamp": "00:37:52", "text": "带有后端。新"}, {"type": "subtitle", "time": 2274.198, "timestamp": "00:37:54", "text": "创造了新的事物。"}, {"type": "subtitle", "time": 2278.009, "timestamp": "00:37:58", "text": "所以，我当时就想……"}, {"type": "subtitle", "time": 2279.042, "timestamp": "00:37:59", "text": "为……做某事"}]
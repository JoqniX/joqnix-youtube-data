[{"type": "subtitle", "time": 3840.451, "timestamp": "01:04:00", "text": "她回来了。"}, {"type": "subtitle", "time": 3849.557, "timestamp": "01:04:09", "text": "我看到人。"}, {"type": "subtitle", "time": 3850.556, "timestamp": "01:04:10", "text": "你身上有一个。"}, {"type": "subtitle", "time": 3853.104, "timestamp": "01:04:13", "text": "我的天啊。叮。叮。"}, {"type": "subtitle", "time": 3854.591, "timestamp": "01:04:14", "text": "我死了。"}, {"type": "subtitle", "time": 3858.098, "timestamp": "01:04:18", "text": "你为什么拿走它？"}, {"type": "subtitle", "time": 3858.668, "timestamp": "01:04:18", "text": "机枪？"}, {"type": "subtitle", "time": 3862.233, "timestamp": "01:04:22", "text": "叮。叮。收到一声提示音。"}, {"type": "subtitle", "time": 3865.314, "timestamp": "01:04:25", "text": "什么？"}, {"type": "subtitle", "time": 3867.894, "timestamp": "01:04:27", "text": "游戏卡顿。"}, {"type": "subtitle", "time": 3877.632, "timestamp": "01:04:37", "text": "哦，好吧，现在……"}, {"type": "subtitle", "time": 3879.464, "timestamp": "01:04:39", "text": "土地。举手。"}, {"type": "subtitle", "time": 3880.667, "timestamp": "01:04:40", "text": "举手。 嫌疑人已离开"}, {"type": "subtitle", "time": 3881.947, "timestamp": "01:04:41", "text": "嫌疑人已离开 洗手间。"}, {"type": "subtitle", "time": 3883.2, "timestamp": "01:04:43", "text": "洗手间。 另一边，另一边"}, {"type": "subtitle", "time": 3884.52, "timestamp": "01:04:44", "text": "另一边，另一边 等级。"}, {"type": "subtitle", "time": 3885.429, "timestamp": "01:04:45", "text": "等级。 我不在乎其他什么。"}, {"type": "subtitle", "time": 3886.731, "timestamp": "01:04:46", "text": "我不在乎其他什么。 将会发生。简单地"}, {"type": "subtitle", "time": 3887.968, "timestamp": "01:04:47", "text": "将会发生。简单地 救我出去"}, {"type": "subtitle", "time": 3889.293, "timestamp": "01:04:49", "text": "救我出去 孔。那家伙有"}, {"type": "subtitle", "time": 3894.692, "timestamp": "01:04:54", "text": "孔。那家伙有 是一只“掘土机”。"}, {"type": "subtitle", "time": 3898.658, "timestamp": "01:04:58", "text": "对，就是他。"}]
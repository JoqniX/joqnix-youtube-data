, "text": "是的。"}, {"type": "subtitle", "time": 2329.159, "timestamp": "00:38:49", "text": "我想你在这里。哦，你"}, {"type": "subtitle", "time": 2330.276, "timestamp": "00:38:50", "text": "这里。你在这里。"}, {"type": "subtitle", "time": 2331.42, "timestamp": "00:38:51", "text": "是的，我在这里。"}, {"type": "subtitle", "time": 2334.206, "timestamp": "00:38:54", "text": "你在这里。该死的。"}, {"type": "subtitle", "time": 2338.019, "timestamp": "00:38:58", "text": "是的，我在这里。"}, {"type": "subtitle", "time": 2339.067, "timestamp": "00:38:59", "text": "前往"}]
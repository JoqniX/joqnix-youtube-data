[{"type": "subtitle", "time": 1148.752, "timestamp": "00:19:08", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 1150.769, "timestamp": "00:19:10", "text": "欢迎回来。"}, {"type": "subtitle", "time": 1152.442, "timestamp": "00:19:12", "text": "简而言之，杰伊"}, {"type": "subtitle", "time": 1153.818, "timestamp": "00:19:13", "text": "上楼去。"}, {"type": "subtitle", "time": 1155.366, "timestamp": "00:19:15", "text": "这里有点危险。"}, {"type": "subtitle", "time": 1156.96, "timestamp": "00:19:16", "text": "为你。不适合我。"}, {"type": "subtitle", "time": 1158.444, "timestamp": "00:19:18", "text": "专为你准备。去"}, {"type": "subtitle", "time": 1158.882, "timestamp": "00:19:18", "text": "这里。"}, {"type": "subtitle", "time": 1161.048, "timestamp": "00:19:21", "text": "我明白了。"}, {"type": "subtitle", "time": 1168.282, "timestamp": "00:19:28", "text": "杰克。今天是万圣节。"}, {"type": "subtitle", "time": 1170.934, "timestamp": "00:19:30", "text": "哦，今天是万圣节。"}, {"type": "subtitle", "time": 1174.501, "timestamp": "00:19:34", "text": "南瓜。哦，等等。你"}, {"type": "subtitle", "time": 1175.691, "timestamp": "00:19:35", "text": "你不会瞄准吗？"}, {"type": "subtitle", "time": 1180.842, "timestamp": "00:19:40", "text": "我觉得有可能，但我并不确定。"}, {"type": "subtitle", "time": 1182.31, "timestamp": "00:19:42", "text": "我知道。前所未有"}, {"type": "subtitle", "time": 1183.209, "timestamp": "00:19:43", "text": "我没那么做。"}, {"type": "subtitle", "time": 1193.031, "timestamp": "00:19:53", "text": "这是一个爱好者团体。"}, {"type": "subtitle", "time": 1194.007, "timestamp": "00:19:54", "text": "我们在家，"}, {"type": "subtitle", "time": 1195.094, "timestamp": "00:19:55", "text": "我们继续前进。"}, {"type": "subtitle", "time": 1196.972, "timestamp": "00:19:56", "text": "是的，我在竞选。快点。"}, {"type": "subtitle", "time": 1198.243, "timestamp": "00:19:58", "text": "谨慎行事。"}]
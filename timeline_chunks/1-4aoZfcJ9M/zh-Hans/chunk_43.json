[{"type": "subtitle", "time": 2591.406, "timestamp": "00:43:11", "text": "安装充电器了吗？不是 担心，"}, {"type": "subtitle", "time": 2592.244, "timestamp": "00:43:12", "text": "担心， 正在这里打扫卫生。"}, {"type": "subtitle", "time": 2593.536, "timestamp": "00:43:13", "text": "正在这里打扫卫生。 房间。没关系。"}, {"type": "subtitle", "time": 2595.046, "timestamp": "00:43:15", "text": "房间。没关系。 它。"}, {"type": "subtitle", "time": 2604.753, "timestamp": "00:43:24", "text": "C1，C1说了什么？"}, {"type": "subtitle", "time": 2613.008, "timestamp": "00:43:33", "text": "放下武器。婊子"}, {"type": "subtitle", "time": 2613.4, "timestamp": "00:43:33", "text": "儿子。"}, {"type": "subtitle", "time": 2615.884, "timestamp": "00:43:35", "text": "是的，我抓到他了。"}, {"type": "subtitle", "time": 2616.639, "timestamp": "00:43:36", "text": "我的天啊。"}, {"type": "subtitle", "time": 2619.516, "timestamp": "00:43:39", "text": "别担心。"}, {"type": "subtitle", "time": 2624.767, "timestamp": "00:43:44", "text": "谢谢"}, {"type": "subtitle", "time": 2631.846, "timestamp": "00:43:51", "text": "我们被迫分离了。"}, {"type": "subtitle", "time": 2632.853, "timestamp": "00:43:52", "text": "是正确的"}, {"type": "subtitle", "time": 2633.793, "timestamp": "00:43:53", "text": "做出决定，因为我们"}, {"type": "subtitle", "time": 2634.901, "timestamp": "00:43:54", "text": "他们处理得很快。"}, {"type": "subtitle", "time": 2637.67, "timestamp": "00:43:57", "text": "但他拒绝了。"}]
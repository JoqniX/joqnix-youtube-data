[{"type": "subtitle", "time": 3727.396, "timestamp": "01:02:07", "text": "就像这样，哦不。"}, {"type": "subtitle", "time": 3737.838, "timestamp": "01:02:17", "text": "我必须负责这些工作。"}, {"type": "subtitle", "time": 3738.404, "timestamp": "01:02:18", "text": "男孩们。"}, {"type": "subtitle", "time": 3742.443, "timestamp": "01:02:22", "text": "做好撤离准备。"}, {"type": "subtitle", "time": 3750.74, "timestamp": "01:02:30", "text": "好的。这段录音 。"}, {"type": "subtitle", "time": 3753.69, "timestamp": "01:02:33", "text": "等等，等等。你"}, {"type": "subtitle", "time": 3754.406, "timestamp": "01:02:34", "text": "你在说话吗？"}, {"type": "subtitle", "time": 3756.668, "timestamp": "01:02:36", "text": "我不说话。"}, {"type": "subtitle", "time": 3758.679, "timestamp": "01:02:38", "text": "哦好的。好的。好的。"}, {"type": "subtitle", "time": 3759.377, "timestamp": "01:02:39", "text": "我就是这样："}, {"type": "subtitle", "time": 3760.453, "timestamp": "01:02:40", "text": "这是怎么回事？"}, {"type": "subtitle", "time": 3761.613, "timestamp": "01:02:41", "text": "我在场上失去了目标。"}, {"type": "subtitle", "time": 3761.893, "timestamp": "01:02:41", "text": "想象。"}, {"type": "subtitle", "time": 3763.527, "timestamp": "01:02:43", "text": "是的。是的。我被锁链束缚着。"}, {"type": "subtitle", "time": 3764.19, "timestamp": "01:02:44", "text": "这两个人。"}, {"type": "subtitle", "time": 3766.14, "timestamp": "01:02:46", "text": "意外身亡。"}, {"type": "subtitle", "time": 3769.65, "timestamp": "01:02:49", "text": "好的。一切都很好。不是"}, {"type": "subtitle", "time": 3770.629, "timestamp": "01:02:50", "text": "担心。但是我们"}, {"type": "subtitle", "time": 3771.281, "timestamp": "01:02:51", "text": "我们总是可以"}, {"type": "subtitle", "time": 3772.261, "timestamp": "01:02:52", "text": "重新开始回合。"}, {"type": "subtitle", "time": 3773.47, "timestamp": "01:02:53", "text": "别担心。"}, {"type": "subtitle", "time": 3774.707, "timestamp": "01:02:54", "text": "所以，你不应该"}, {"type": "subtitle", "time": 3775.49, "timestamp": "01:02:55", "text": "杀人？"}, {"type": "subtitle", "time": 3777.755, "timestamp": "01:02:57", "text": "你杀了那个人。"}, {"type": "subtitle", "time": 3779.254, "timestamp": "01:02:59", "text": "滚开，兄弟。"}]
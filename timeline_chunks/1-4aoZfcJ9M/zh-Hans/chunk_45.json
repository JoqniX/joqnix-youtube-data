[{"type": "subtitle", "time": 2701.457, "timestamp": "00:45:01", "text": "我的。他说的没错…… 简而言之。好的。"}, {"type": "subtitle", "time": 2702.988, "timestamp": "00:45:02", "text": "简而言之。好的。 杰克，过来。去"}, {"type": "subtitle", "time": 2704.585, "timestamp": "00:45:04", "text": "杰克，过来。去 我身后。"}, {"type": "subtitle", "time": 2705.311, "timestamp": "00:45:05", "text": "我身后。 我希望你走。"}, {"type": "subtitle", "time": 2706.539, "timestamp": "00:45:06", "text": "我希望你走。 在我前面。"}, {"type": "subtitle", "time": 2707.788, "timestamp": "00:45:07", "text": "在我前面。 好的。"}, {"type": "subtitle", "time": 2720.571, "timestamp": "00:45:20", "text": "好的。我要走了……我"}, {"type": "subtitle", "time": 2721.833, "timestamp": "00:45:21", "text": "我准备安装"}, {"type": "subtitle", "time": 2722.829, "timestamp": "00:45:22", "text": "在这里充电。"}, {"type": "subtitle", "time": 2724.812, "timestamp": "00:45:24", "text": "你知道为什么吗？因为在这背后"}, {"type": "subtitle", "time": 2725.891, "timestamp": "00:45:25", "text": "可能被诅咒"}, {"type": "subtitle", "time": 2726.349, "timestamp": "00:45:26", "text": "伙计们。"}, {"type": "subtitle", "time": 2728.716, "timestamp": "00:45:28", "text": "好的。我会做。"}, {"type": "subtitle", "time": 2732.227, "timestamp": "00:45:32", "text": "收费。 3、2、1. 巴赫。那里"}, {"type": "subtitle", "time": 2733.438, "timestamp": "00:45:33", "text": "现在会很吵。"}, {"type": "subtitle", "time": 2739.338, "timestamp": "00:45:39", "text": "在地面上。举手"}, {"type": "subtitle", "time": 2741.126, "timestamp": "00:45:41", "text": "在地面上。在地面上。"}, {"type": "subtitle", "time": 2743.594, "timestamp": "00:45:43", "text": "把手放在"}, {"type": "subtitle", "time": 2744.845, "timestamp": "00:45:44", "text": "在地板上。"}, {"type": "subtitle", "time": 2749.25, "timestamp": "00:45:49", "text": "是的。双方有联系。二"}, {"type": "subtitle", "time": 2749.739, "timestamp": "00:45:49", "text": "人们。"}, {"type": "subtitle", "time": 2751.725, "timestamp": "00:45:51", "text": "抓住它。抓住它"}, {"type": "subtitle", "time": 2752.831, "timestamp": "00:45:52", "text": "它是。抓住它。"}, {"type": "subtitle", "time": 2754.129, "timestamp": "00:45:54", "text": "手铐。手铐。"}, {"type": "subtitle", "time": 2756.429, "timestamp": "00:45:56", "text": "现在这一切都是徒劳。"}, {"type": "subtitle", "time": 2757.559, "timestamp": "00:45:57", "text": "浪费时间。如果"}, {"type": "subtitle", "time": 2758.692, "timestamp": "00:45:58", "text": "他们会站起来，他们"}, {"type": "subtitle", "time": 2759.385, "timestamp": "00:45:59", "text": "他们会杀了你。"}]
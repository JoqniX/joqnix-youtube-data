[{"type": "subtitle", "time": 5101.447, "timestamp": "01:25:01", "text": "我，我愿意。好的，"}, {"type": "subtitle", "time": 5103.062, "timestamp": "01:25:03", "text": "我想我死的原因是"}, {"type": "subtitle", "time": 5109.757, "timestamp": "01:25:09", "text": "为什么是你，我，我真的"}, {"type": "subtitle", "time": 5124.163, "timestamp": "01:25:24", "text": "武器。等等，什么？"}, {"type": "subtitle", "time": 5125.182, "timestamp": "01:25:25", "text": "正在发生什么？"}, {"type": "subtitle", "time": 5132.024, "timestamp": "01:25:32", "text": "这是一支敌军分遣队。"}, {"type": "subtitle", "time": 5137.324, "timestamp": "01:25:37", "text": "我感觉自己像是在原地打转。"}, {"type": "subtitle", "time": 5138.486, "timestamp": "01:25:38", "text": "现在他们周围都是。"}, {"type": "subtitle", "time": 5141.101, "timestamp": "01:25:41", "text": "我的天哪，我死了。"}, {"type": "subtitle", "time": 5144.317, "timestamp": "01:25:44", "text": "我心想：这太搞笑了"}, {"type": "subtitle", "time": 5150.469, "timestamp": "01:25:50", "text": "我这边。这是我的。"}, {"type": "subtitle", "time": 5152.703, "timestamp": "01:25:52", "text": "你对所有人撒谎。"}, {"type": "subtitle", "time": 5153.301, "timestamp": "01:25:53", "text": "一秒钟。"}, {"type": "subtitle", "time": 5157.78, "timestamp": "01:25:57", "text": "是的。我，我已经死了。"}, {"type": "subtitle", "time": 5158.727, "timestamp": "01:25:58", "text": "我，我"}]
[{"type": "subtitle", "time": 3420.384, "timestamp": "00:57:00", "text": "哦，就这么简单"}, {"type": "subtitle", "time": 3422.486, "timestamp": "00:57:02", "text": "车身套件。不，拿去吧。"}, {"type": "subtitle", "time": 3423.904, "timestamp": "00:57:03", "text": "最低限度的设备"}, {"type": "subtitle", "time": 3427.7, "timestamp": "00:57:07", "text": "老兄。只需要头盔。在 顺便说一句，拿"}, {"type": "subtitle", "time": 3428.757, "timestamp": "00:57:08", "text": "顺便说一句，拿 战术头盔，因为在"}, {"type": "subtitle", "time": 3430.131, "timestamp": "00:57:10", "text": "战术头盔，因为在 我是光噪声。"}, {"type": "subtitle", "time": 3434.288, "timestamp": "00:57:14", "text": "所以，如果你不想"}, {"type": "subtitle", "time": 3435.52, "timestamp": "00:57:15", "text": "感到震惊，"}, {"type": "subtitle", "time": 3436.286, "timestamp": "00:57:16", "text": "当我投掷的时候"}, {"type": "subtitle", "time": 3437.584, "timestamp": "00:57:17", "text": "光线和噪音，佩戴"}, {"type": "subtitle", "time": 3438.617, "timestamp": "00:57:18", "text": "战术头盔。"}, {"type": "subtitle", "time": 3440.625, "timestamp": "00:57:20", "text": "请确保你"}, {"type": "subtitle", "time": 3444.411, "timestamp": "00:57:24", "text": "如果没有盔甲，如果"}, {"type": "subtitle", "time": 3445.505, "timestamp": "00:57:25", "text": "你担心什么？"}, {"type": "subtitle", "time": 3448.169, "timestamp": "00:57:28", "text": "速度。但"}, {"type": "subtitle", "time": 3450.558, "timestamp": "00:57:30", "text": "我需要一个重的。"}, {"type": "subtitle", "time": 3452.717, "timestamp": "00:57:32", "text": "陶瓷。我有"}, {"type": "subtitle", "time": 3459.762, "timestamp": "00:57:39", "text": "但你不需要它"}, {"type": "subtitle", "time": 3460.71, "timestamp": "00:57:40", "text": "夜视设备"}, {"type": "subtitle", "time": 3461.184, "timestamp": "00:57:41", "text": "想象"}, {"type": "subtitle", "time": 3462.868, "timestamp": "00:57:42", "text": "戴着战术头盔。"}, {"type": "subtitle", "time": 3463.709, "timestamp": "00:57:43", "text": "做得好。"}, {"type": "subtitle", "time": 3465.401, "timestamp": "00:57:45", "text": "不要打开夜灯。"}, {"type": "subtitle", "time": 3466.213, "timestamp": "00:57:46", "text": "当我辞职时"}, {"type": "subtitle", "time": 3467.132, "timestamp": "00:57:47", "text": "轻微的噪音。"}, {"type": "subtitle", "time": 3472.034, "timestamp": "00:57:52", "text": "这就是我受苦的原因。"}, {"type": "subtitle", "time": 3477.613, "timestamp": "00:57:57", "text": "是的，你"}, {"type": "subtitle", "time": 3478.558, "timestamp": "00:57:58", "text": "用过的"}, {"type": "subtitle", "time": 3479.829, "timestamp": "00:57:59", "text": "夜灯，这就是你如此的原因"}]
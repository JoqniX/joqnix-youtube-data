[{"type": "subtitle", "time": 2883.522, "timestamp": "00:48:03", "text": "这……这曾经是"}, {"type": "subtitle", "time": 2884.738, "timestamp": "00:48:04", "text": "平民，以及另一名平民"}, {"type": "subtitle", "time": 2886.063, "timestamp": "00:48:06", "text": "我当时……掏出了武器。"}, {"type": "subtitle", "time": 2893.334, "timestamp": "00:48:13", "text": "所以，事情并非如此。我不知道。"}, {"type": "subtitle", "time": 2895.098, "timestamp": "00:48:15", "text": "或许是被诅咒的"}, {"type": "subtitle", "time": 2896.112, "timestamp": "00:48:16", "text": "这把枪很简单"}, {"type": "subtitle", "time": 2897.307, "timestamp": "00:48:17", "text": "中了诅咒"}, {"type": "subtitle", "time": 2898.611, "timestamp": "00:48:18", "text": "后面的房间，哦……"}, {"type": "subtitle", "time": 2900.89, "timestamp": "00:48:20", "text": "我勒个去？"}, {"type": "subtitle", "time": 2910.882, "timestamp": "00:48:30", "text": "哦，这里有人。跪下。"}, {"type": "subtitle", "time": 2912.257, "timestamp": "00:48:32", "text": "等等，它不在那里。"}, {"type": "subtitle", "time": 2912.604, "timestamp": "00:48:32", "text": "在，"}, {"type": "subtitle", "time": 2915.288, "timestamp": "00:48:35", "text": "为什么在播放音乐？"}, {"type": "subtitle", "time": 2917.922, "timestamp": "00:48:37", "text": "等待。不，"}, {"type": "subtitle", "time": 2919.653, "timestamp": "00:48:39", "text": "实际上，并非如此。不是"}, {"type": "subtitle", "time": 2921.211, "timestamp": "00:48:41", "text": "我觉得是人。 。我认为这是"}, {"type": "subtitle", "time": 2922.505, "timestamp": "00:48:42", "text": "。我认为这是 那里只有几个男生，"}, {"type": "subtitle", "time": 2923.806, "timestamp": "00:48:43", "text": "那里只有几个男生， 就像连在一起一样，我的天哪。"}, {"type": "subtitle", "time": 2932.076, "timestamp": "00:48:52", "text": "因为在任务面板中"}, {"type": "subtitle", "time": 2933.443, "timestamp": "00:48:53", "text": "我们都是平民，全部"}, {"type": "subtitle", "time": 2934.46, "timestamp": "00:48:54", "text": "嫌疑人，我们"}, {"type": "subtitle", "time": 2935.722, "timestamp": "00:48:55", "text": "我们正在整理东西等等"}, {"type": "subtitle", "time": 2936.073, "timestamp": "00:48:56", "text": "其他。"}]
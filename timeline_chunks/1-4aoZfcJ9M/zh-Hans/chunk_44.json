[{"type": "subtitle", "time": 2641.786, "timestamp": "00:44:01", "text": "给我点胡椒粉。"}, {"type": "subtitle", "time": 2643.59, "timestamp": "00:44:03", "text": "在他身上撒点胡椒粉。"}, {"type": "subtitle", "time": 2644.988, "timestamp": "00:44:04", "text": "脸。我有"}, {"type": "subtitle", "time": 2646.223, "timestamp": "00:44:06", "text": "我的胡椒粉用完了。"}, {"type": "subtitle", "time": 2646.808, "timestamp": "00:44:06", "text": "喷雾罐。"}, {"type": "subtitle", "time": 2648.92, "timestamp": "00:44:08", "text": "你应该这么做。"}, {"type": "subtitle", "time": 2650.161, "timestamp": "00:44:10", "text": "令我们震惊，"}, {"type": "subtitle", "time": 2650.488, "timestamp": "00:44:10", "text": "事物。"}, {"type": "subtitle", "time": 2652.015, "timestamp": "00:44:12", "text": "我这就开枪"}, {"type": "subtitle", "time": 2653.2, "timestamp": "00:44:13", "text": "他被彩弹枪击中了"}, {"type": "subtitle", "time": 2653.686, "timestamp": "00:44:13", "text": "枪。"}, {"type": "subtitle", "time": 2657.041, "timestamp": "00:44:17", "text": "那是最糟糕的一晚。"}, {"type": "subtitle", "time": 2662.616, "timestamp": "00:44:22", "text": "杰克，我希望你"}, {"type": "subtitle", "time": 2663.997, "timestamp": "00:44:23", "text": "之后他们就把事情掩盖了起来。 他们会如何紧张起来。"}, {"type": "subtitle", "time": 2665.587, "timestamp": "00:44:25", "text": "他们会如何紧张起来。 我希望你走。"}, {"type": "subtitle", "time": 2666.825, "timestamp": "00:44:26", "text": "我希望你走。 在我前面。"}, {"type": "subtitle", "time": 2668.414, "timestamp": "00:44:28", "text": "在我前面。 你是谁？因为这样……"}, {"type": "subtitle", "time": 2669.902, "timestamp": "00:44:29", "text": "你是谁？因为这样…… 这可能是"}, {"type": "subtitle", "time": 2670.753, "timestamp": "00:44:30", "text": "这可能是 危险地。好的，我是。"}, {"type": "subtitle", "time": 2672.325, "timestamp": "00:44:32", "text": "危险地。好的，我是。 我会去找你。我"}, {"type": "subtitle", "time": 2674.818, "timestamp": "00:44:34", "text": "我会去找你。我 我会去找你。"}, {"type": "subtitle", "time": 2675.989, "timestamp": "00:44:35", "text": "我会去找你。 该死的警察。"}, {"type": "subtitle", "time": 2679.618, "timestamp": "00:44:39", "text": "为什么彩弹射击不"}, {"type": "subtitle", "time": 2681.012, "timestamp": "00:44:41", "text": "合适的？我应该"}, {"type": "subtitle", "time": 2682.028, "timestamp": "00:44:42", "text": "开枪。"}, {"type": "subtitle", "time": 2683.09, "timestamp": "00:44:43", "text": "我不得不接受"}, {"type": "subtitle", "time": 2683.668, "timestamp": "00:44:43", "text": "霰弹枪。"}, {"type": "subtitle", "time": 2689.292, "timestamp": "00:44:49", "text": "这……我现在就身处其中。"}, {"type": "subtitle", "time": 2689.762, "timestamp": "00:44:49", "text": "地方。"}, {"type": "subtitle", "time": 2691.35, "timestamp": "00:44:51", "text": "哦，你好。在哪里"}, {"type": "subtitle", "time": 2692.598, "timestamp": "00:44:52", "text": "怀疑？你也是"}, {"type": "subtitle", "time": 2693.662, "timestamp": "00:44:53", "text": "穿上他"}, {"type": "subtitle", "time": 2694.281, "timestamp": "00:44:54", "text": "手铐？"}, {"type": "subtitle", "time": 2695.914, "timestamp": "00:44:55", "text": "是的，他在这里。"}, {"type": "subtitle", "time": 2699.41, "timestamp": "00:44:59", "text": "哦，他来了。好的。我的天啊"}]
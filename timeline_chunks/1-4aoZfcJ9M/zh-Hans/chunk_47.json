[{"type": "subtitle", "time": 2821.022, "timestamp": "00:47:01", "text": "呃，可能是把霰弹枪。"}, {"type": "subtitle", "time": 2828.312, "timestamp": "00:47:08", "text": "是的。嗯，确认。"}, {"type": "subtitle", "time": 2828.83, "timestamp": "00:47:08", "text": "现在。"}, {"type": "subtitle", "time": 2834.811, "timestamp": "00:47:14", "text": "我们一收到"}, {"type": "subtitle", "time": 2835.703, "timestamp": "00:47:15", "text": "猎枪，狩猎"}, {"type": "subtitle", "time": 2839.49, "timestamp": "00:47:19", "text": "将会结束。所以，我们"}, {"type": "subtitle", "time": 2840.755, "timestamp": "00:47:20", "text": "不用担心"}, {"type": "subtitle", "time": 2841.89, "timestamp": "00:47:21", "text": "关于伪造。"}, {"type": "subtitle", "time": 2846.371, "timestamp": "00:47:26", "text": "好的。"}, {"type": "subtitle", "time": 2855.518, "timestamp": "00:47:35", "text": "伙计，他来了。让"}, {"type": "subtitle", "time": 2856.306, "timestamp": "00:47:36", "text": "他是希腊人。"}, {"type": "subtitle", "time": 2859.105, "timestamp": "00:47:39", "text": "这该死的证据，"}, {"type": "subtitle", "time": 2860.124, "timestamp": "00:47:40", "text": "老兄。快点。"}, {"type": "subtitle", "time": 2865.657, "timestamp": "00:47:45", "text": "警方已抵达现场。我"}, {"type": "subtitle", "time": 2867.043, "timestamp": "00:47:47", "text": "提供了证据"}, {"type": "subtitle", "time": 2868.394, "timestamp": "00:47:48", "text": "那个家伙"}, {"type": "subtitle", "time": 2869.212, "timestamp": "00:47:49", "text": "暗区。"}, {"type": "subtitle", "time": 2874.152, "timestamp": "00:47:54", "text": "你拥有一件武器"}, {"type": "subtitle", "time": 2874.85, "timestamp": "00:47:54", "text": "闪光？"}, {"type": "subtitle", "time": 2876.888, "timestamp": "00:47:56", "text": "什么？"}, {"type": "subtitle", "time": 2878.039, "timestamp": "00:47:58", "text": "警方，双手在"}, {"type": "subtitle", "time": 2878.663, "timestamp": "00:47:58", "text": "空气。"}]
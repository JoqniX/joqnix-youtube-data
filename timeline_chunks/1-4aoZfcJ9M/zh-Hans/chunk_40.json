[{"type": "subtitle", "time": 2400.042, "timestamp": "00:40:00", "text": "彩弹枪。"}, {"type": "subtitle", "time": 2408.145, "timestamp": "00:40:08", "text": "没有什么。"}, {"type": "subtitle", "time": 2410.564, "timestamp": "00:40:10", "text": "我击中了它。"}, {"type": "subtitle", "time": 2416.958, "timestamp": "00:40:16", "text": "头部被击中。"}, {"type": "subtitle", "time": 2418.723, "timestamp": "00:40:18", "text": "拿着吧。拿着吧。"}, {"type": "subtitle", "time": 2419.916, "timestamp": "00:40:19", "text": "它是。拿着吧。"}, {"type": "subtitle", "time": 2421.387, "timestamp": "00:40:21", "text": "拿着吧。紧随其后"}, {"type": "subtitle", "time": 2422.233, "timestamp": "00:40:22", "text": "他。完全的"}, {"type": "subtitle", "time": 2426.742, "timestamp": "00:40:26", "text": "麻烦。有两个"}, {"type": "subtitle", "time": 2427.502, "timestamp": "00:40:27", "text": "带电。"}, {"type": "subtitle", "time": 2433.241, "timestamp": "00:40:33", "text": "哦，杰克，过来。"}, {"type": "subtitle", "time": 2437.012, "timestamp": "00:40:37", "text": "算了，兄弟。我的天啊 。不，不。手铐。"}, {"type": "subtitle", "time": 2438.771, "timestamp": "00:40:38", "text": "。不，不。手铐。 手铐。她，她"}, {"type": "subtitle", "time": 2440.223, "timestamp": "00:40:40", "text": "手铐。她，她 谎言。别这么做。"}, {"type": "subtitle", "time": 2444.311, "timestamp": "00:40:44", "text": "你还没看过呢"}, {"type": "subtitle", "time": 2445.064, "timestamp": "00:40:45", "text": "最后一个"}, {"type": "subtitle", "time": 2446.756, "timestamp": "00:40:46", "text": "主耶稣。"}, {"type": "subtitle", "time": 2448.174, "timestamp": "00:40:48", "text": "报道她的相关情况。"}, {"type": "subtitle", "time": 2449.003, "timestamp": "00:40:49", "text": "怀疑"}, {"type": "subtitle", "time": 2450.229, "timestamp": "00:40:50", "text": "已中和，准备就绪"}, {"type": "subtitle", "time": 2451.058, "timestamp": "00:40:51", "text": "撤离前。"}, {"type": "subtitle", "time": 2452.535, "timestamp": "00:40:52", "text": "你拿了猎枪吗？"}, {"type": "subtitle", "time": 2456.424, "timestamp": "00:40:56", "text": "什么？我没明白。"}, {"type": "subtitle", "time": 2457.056, "timestamp": "00:40:57", "text": "霰弹枪。"}, {"type": "subtitle", "time": 2458.719, "timestamp": "00:40:58", "text": "警察们，所有人趴下！"}]
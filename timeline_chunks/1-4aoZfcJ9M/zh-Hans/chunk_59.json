[{"type": "subtitle", "time": 3540.294, "timestamp": "00:59:00", "text": "他怎么样了？他怎么样了？"}, {"type": "subtitle", "time": 3541.446, "timestamp": "00:59:01", "text": "你一路走到这里了吗？"}, {"type": "subtitle", "time": 3546.77, "timestamp": "00:59:06", "text": "我跑到了极限"}, {"type": "subtitle", "time": 3549.855, "timestamp": "00:59:09", "text": "部队。我会给你一些东西，"}, {"type": "subtitle", "time": 3550.187, "timestamp": "00:59:10", "text": "那"}, {"type": "subtitle", "time": 3552.203, "timestamp": "00:59:12", "text": "等等，你已经举报了。"}, {"type": "subtitle", "time": 3552.651, "timestamp": "00:59:12", "text": "武器？"}, {"type": "subtitle", "time": 3555.578, "timestamp": "00:59:15", "text": "哦，把这些都做一遍。"}, {"type": "subtitle", "time": 3557.765, "timestamp": "00:59:17", "text": "我什么都没做。"}, {"type": "subtitle", "time": 3559.627, "timestamp": "00:59:19", "text": "什么？我没看到。"}, {"type": "subtitle", "time": 3560.11, "timestamp": "00:59:20", "text": "武器。"}, {"type": "subtitle", "time": 3560.749, "timestamp": "00:59:20", "text": "我输了"}, {"type": "subtitle", "time": 3562.018, "timestamp": "00:59:22", "text": "嫌疑人出现。"}, {"type": "subtitle", "time": 3563.514, "timestamp": "00:59:23", "text": "我懂了。我懂了。"}, {"type": "subtitle", "time": 3566.148, "timestamp": "00:59:26", "text": "等待，"}, {"type": "subtitle", "time": 3574.786, "timestamp": "00:59:34", "text": "这是塞拉。"}, {"type": "subtitle", "time": 3576.092, "timestamp": "00:59:36", "text": "嫌疑人已离开"}, {"type": "subtitle", "time": 3577.237, "timestamp": "00:59:37", "text": "洗手间。"}, {"type": "subtitle", "time": 3578.619, "timestamp": "00:59:38", "text": "另一边，另一边"}, {"type": "subtitle", "time": 3579.08, "timestamp": "00:59:39", "text": "等级。"}, {"type": "subtitle", "time": 3581.246, "timestamp": "00:59:41", "text": "好的，"}, {"type": "subtitle", "time": 3584.027, "timestamp": "00:59:44", "text": "我们来清理一下。"}, {"type": "subtitle", "time": 3584.593, "timestamp": "00:59:44", "text": "房间。"}, {"type": "subtitle", "time": 3590.5, "timestamp": "00:59:50", "text": "好了，实际上就是这样。"}, {"type": "subtitle", "time": 3591.012, "timestamp": "00:59:51", "text": "没有人。"}, {"type": "subtitle", "time": 3593.907, "timestamp": "00:59:53", "text": "不，别进去。"}, {"type": "subtitle", "time": 3594.842, "timestamp": "00:59:54", "text": "房间。那里"}, {"type": "subtitle", "time": 3595.644, "timestamp": "00:59:55", "text": "巨大的"}]
[{"type": "subtitle", "time": 4680.482, "timestamp": "01:18:00", "text": "發生了嗎？剛才發生了什麼事？ 發生了嗎？為什麼是我？"}, {"type": "subtitle", "time": 4681.61, "timestamp": "01:18:01", "text": "發生了嗎？為什麼是我？ 我的直播結束了嗎？"}, {"type": "subtitle", "time": 4682.999, "timestamp": "01:18:02", "text": "我的直播結束了嗎？ 未恐慌。簡單地"}, {"type": "subtitle", "time": 4684.389, "timestamp": "01:18:04", "text": "未恐慌。簡單地 直接打開 OBS 就行了。"}, {"type": "subtitle", "time": 4685.915, "timestamp": "01:18:05", "text": "直接打開 OBS 就行了。 直接打開 OBS 就行了"}, {"type": "subtitle", "time": 4687.439, "timestamp": "01:18:07", "text": "直接打開 OBS 就行了 看。一切都很好。"}, {"type": "subtitle", "time": 4693.629, "timestamp": "01:18:13", "text": "我的天啊。"}, {"type": "subtitle", "time": 4698.601, "timestamp": "01:18:18", "text": "瘋狂。停，我"}, {"type": "subtitle", "time": 4699.437, "timestamp": "01:18:19", "text": "我甚至做不到"}, {"type": "subtitle", "time": 4700.675, "timestamp": "01:18:20", "text": "看著你"}, {"type": "subtitle", "time": 4701.961, "timestamp": "01:18:21", "text": "該死的YouTube。誰"}, {"type": "subtitle", "time": 4703.069, "timestamp": "01:18:23", "text": "到底發生了什麼事？"}, {"type": "subtitle", "time": 4706.461, "timestamp": "01:18:26", "text": "在 YouTube 上。"}, {"type": "subtitle", "time": 4712.207, "timestamp": "01:18:32", "text": "哦，是的，雅克，你在YouTube上。"}, {"type": "subtitle", "time": 4712.831, "timestamp": "01:18:32", "text": "是的。"}, {"type": "subtitle", "time": 4718.831, "timestamp": "01:18:38", "text": "SWAT 4. 分開"}, {"type": "subtitle", "time": 4719.974, "timestamp": "01:18:39", "text": "能力——這是"}, {"type": "subtitle", "time": 4724.104, "timestamp": "01:18:44", "text": "疼痛。製作一款遊戲。在，"}, {"type": "subtitle", "time": 4725.243, "timestamp": "01:18:45", "text": "順便說一句，你可以…"}, {"type": "subtitle", "time": 4726.596, "timestamp": "01:18:46", "text": "你可以，你可以改變"}, {"type": "subtitle", "time": 4729.075, "timestamp": "01:18:49", "text": "設定.簡單地"}, {"type": "subtitle", "time": 4729.961, "timestamp": "01:18:49", "text": "打開 OBS，然後"}, {"type": "subtitle", "time": 4731.307
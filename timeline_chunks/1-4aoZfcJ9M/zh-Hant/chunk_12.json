[{"type": "subtitle", "time": 722.218, "timestamp": "00:12:02", "text": "這是一張複雜的地圖。給"}, {"type": "subtitle", "time": 724.229, "timestamp": "00:12:04", "text": "給我一分鐘時間。這裡，"}, {"type": "subtitle", "time": 725.643, "timestamp": "00:12:05", "text": "這樣好多了。"}, {"type": "subtitle", "time": 726.994, "timestamp": "00:12:06", "text": "我們會演奏這首曲子，但是"}, {"type": "subtitle", "time": 728.426, "timestamp": "00:12:08", "text": "再說一遍，你知道的 。我的天，肉不夠。在，"}, {"type": "subtitle", "time": 738.002, "timestamp": "00:12:18", "text": "。我的天，肉不夠。在， 一秒鐘。讓我"}, {"type": "subtitle", "time": 740.237, "timestamp": "00:12:20", "text": "一秒鐘。讓我 調整影片。"}, {"type": "subtitle", "time": 744.121, "timestamp": "00:12:24", "text": "為什麼要分開"}, {"type": "subtitle", "time": 745.628, "timestamp": "00:12:25", "text": "能力始終為 800"}, {"type": "subtitle", "time": 746.047, "timestamp": "00:12:26", "text": "600？"}, {"type": "subtitle", "time": 749.529, "timestamp": "00:12:29", "text": "哦，這是個老遊戲了。"}, {"type": "subtitle", "time": 750.105, "timestamp": "00:12:30", "text": "老兄。"}, {"type": "subtitle", "time": 754.347, "timestamp": "00:12:34", "text": "是的，確實如此。"}, {"type": "subtitle", "time": 756.876, "timestamp": "00:12:36", "text": "她快20歲了，"}, {"type": "subtitle", "time": 757.45, "timestamp": "00:12:37", "text": "朋友。"}, {"type": "subtitle", "time": 764.2090000000001, "timestamp": "00:12:44", "text": "好的，我選了一些。"}, {"type": "subtitle", "time": 765.522, "timestamp": "00:12:45", "text": "牌還不錯，所以"}, {"type": "subtitle", "time": 768.303, "timestamp": "00:12:48", "text": "那挺好的。所以。"}, {"type": "subtitle", "time": 769.743, "timestamp": "00:12:49", "text": "是的，我"}, {"type": "subtitle", "time": 771.072, "timestamp": "00:12:51", "text": "確保一切"}, {"type": "subtitle", "time": 774.658, "timestamp": "00:12:54", "text": "設備已準備就緒。"}, {"type": "subtitle", "time": 778.395, "timestamp": "00:12:58", "text": "那我創建一個大廳。你"}, {"type": "subtitle", "time": 779.333, "timestamp": "00:12:59", "text": "你在找我嗎？"}]
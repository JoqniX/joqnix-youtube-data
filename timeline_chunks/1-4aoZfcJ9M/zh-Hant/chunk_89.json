[{"type": "subtitle", "time": 5340.629, "timestamp": "01:29:00", "text": "是的。我只是"}, {"type": "subtitle", "time": 5342.669, "timestamp": "01:29:02", "text": "我去。你去睡覺。"}, {"type": "subtitle", "time": 5344.508, "timestamp": "01:29:04", "text": "你需要它。是的，我"}, {"type": "subtitle", "time": 5345.908, "timestamp": "01:29:05", "text": "非常感謝大家！"}, {"type": "subtitle", "time": 5346.866, "timestamp": "01:29:06", "text": "來了"}, {"type": "subtitle", "time": 5351.227, "timestamp": "01:29:11", "text": "謝謝你邀請我。"}, {"type": "subtitle", "time": 5354.118, "timestamp": "01:29:14", "text": "我很感激。所以 下次就是"}, {"type": "subtitle", "time": 5355.404, "timestamp": "01:29:15", "text": "下次就是 你們所有人都會到場。再見。"}, {"type": "subtitle", "time": 5358.749, "timestamp": "01:29:18", "text": "你們所有人都會到場。再見。 再見各位。在"}, {"type": "subtitle", "time": 5360.133, "timestamp": "01:29:20", "text": "再見各位。在 晚安。"}, {"type": "subtitle", "time": 5366.15, "timestamp": "01:29:26", "text": "哦，我真的會去的。"}, {"type": "subtitle", "time": 5367.358, "timestamp": "01:29:27", "text": "我背疼。"}, {"type": "subtitle", "time": 5368.955, "timestamp": "01:29:28", "text": "再見，傑克。"}, {"type": "subtitle", "time": 5371.061, "timestamp": "01:29:31", "text": "再見。謝謝你"}, {"type": "subtitle", "time": 5373.307, "timestamp": "01:29:33", "text": "今天。謝謝。"}, {"type": "subtitle", "time": 5375.195, "timestamp": "01:29:35", "text": "沒問題。"}, {"type": "subtitle", "time": 5377.577, "timestamp": "01:29:37", "text": "再見。"}, {"type": "subtitle", "time": 5386.042, "timestamp": "01:29:46", "text": "好了，各位。那是"}, {"type": "subtitle", "time": 5388.364, "timestamp": "01:29:48", "text": "維克多·穆艾。透過"}, {"type": "subtitle", "time": 5389.789, "timestamp": "01:29:49", "text": "距離上次玩遊戲已經有一段時間了。"}, {"type": "subtitle", "time": 5392.426, "timestamp": "01:29:52", "text": "大約兩年過去了。不是"}, {"type": "subtitle", "time": 5395.854, "timestamp": "01:29:55", "text": "兩年，一年。呃呃 大約八個月"}, {"type": "subtitle", "time": 5397.425, "timestamp": "01:29:57", "text": "大約八個月 。是的，差不多一年兩年了。"}, {"type": "subtitle", "time": 5399.793, "timestamp": "01:29:59", "text": "。是的，差不多一年兩年了。 我想大概是幾個月吧。我的天啊，"}]
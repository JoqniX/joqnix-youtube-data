[{"type": "subtitle", "time": 3780.952, "timestamp": "01:03:00", "text": "一切都很好。你有"}, {"type": "subtitle", "time": 3782.248, "timestamp": "01:03:02", "text": "朝他們大喊了幾聲"}, {"type": "subtitle", "time": 3783.155, "timestamp": "01:03:03", "text": "以前"}, {"type": "subtitle", "time": 3783.966, "timestamp": "01:03:03", "text": "殺人。"}, {"type": "subtitle", "time": 3786.321, "timestamp": "01:03:06", "text": "和，"}, {"type": "subtitle", "time": 3788.851, "timestamp": "01:03:08", "text": "好的。"}, {"type": "subtitle", "time": 3790.884, "timestamp": "01:03:10", "text": "好的，明白了。喬什，"}, {"type": "subtitle", "time": 3792.144, "timestamp": "01:03:12", "text": "我們已經打掃過了。"}, {"type": "subtitle", "time": 3793.02, "timestamp": "01:03:13", "text": "正殿。"}, {"type": "subtitle", "time": 3801.962, "timestamp": "01:03:21", "text": "哦，這裡有個人。"}, {"type": "subtitle", "time": 3807.192, "timestamp": "01:03:27", "text": "不殺生也能清理乾淨。"}, {"type": "subtitle", "time": 3808.468, "timestamp": "01:03:28", "text": "第二級。"}, {"type": "subtitle", "time": 3817.461, "timestamp": "01:03:37", "text": "你會留下來嗎？"}, {"type": "subtitle", "time": 3818.343, "timestamp": "01:03:38", "text": "我們分頭行動吧？"}, {"type": "subtitle", "time": 3821.809, "timestamp": "01:03:41", "text": "是的，我要繼續前進了。"}, {"type": "subtitle", "time": 3825.068, "timestamp": "01:03:45", "text": "二樓。"}, {"type": "subtitle", "time": 3836.866, "timestamp": "01:03:56", "text": "錯失了一次自由球機會"}, {"type": "subtitle", "time": 3837.241, "timestamp": "01:03:57", "text": "想像。"}]
[{"type": "subtitle", "time": 1924.649, "timestamp": "00:32:04", "text": "我不會冒這個險，因為"}, {"type": "subtitle", "time": 1925.849, "timestamp": "00:32:05", "text": "這些人能"}, {"type": "subtitle", "time": 1926.766, "timestamp": "00:32:06", "text": "是手槍。"}, {"type": "subtitle", "time": 1928.034, "timestamp": "00:32:08", "text": "戴上手銬。"}, {"type": "subtitle", "time": 1929.557, "timestamp": "00:32:09", "text": "手銬。手銬。"}, {"type": "subtitle", "time": 1930.655, "timestamp": "00:32:10", "text": "哦是的。是的。"}, {"type": "subtitle", "time": 1942.025, "timestamp": "00:32:22", "text": "舉手！為什麼"}, {"type": "subtitle", "time": 1943.317, "timestamp": "00:32:23", "text": "廚房有那麼髒嗎？"}, {"type": "subtitle", "time": 1947.884, "timestamp": "00:32:27", "text": "蟑螂之類的東西。"}, {"type": "subtitle", "time": 1949.708, "timestamp": "00:32:29", "text": "這真的是餐廳嗎？"}, {"type": "subtitle", "time": 1952.937, "timestamp": "00:32:32", "text": "等等，等等，等等。"}, {"type": "subtitle", "time": 1954.025, "timestamp": "00:32:34", "text": "有人在逃跑。"}, {"type": "subtitle", "time": 1959.695, "timestamp": "00:32:39", "text": "我不小心殺了他。 。"}, {"type": "subtitle", "time": 1967.074, "timestamp": "00:32:47", "text": "哦，不。"}, {"type": "subtitle", "time": 1970.743, "timestamp": "00:32:50", "text": "一切都很好。但"}, {"type": "subtitle", "time": 1971.693, "timestamp": "00:32:51", "text": "下次"}, {"type": "subtitle", "time": 1972.801, "timestamp": "00:32:52", "text": "選擇小一點的"}, {"type": "subtitle", "time": 1973.561, "timestamp": "00:32:53", "text": "致命，"}, {"type": "subtitle", "time": 1974.765, "timestamp": "00:32:54", "text": "例如，電擊槍或"}, {"type": "subtitle", "time": 1975.367, "timestamp": "00:32:55", "text": "差不多就是這樣。"}, {"type": "subtitle", "time": 1977.896, "timestamp": "00:32:57", "text": "但請不要殺人。"}, {"type": "subtitle", "time": 1978.637, "timestamp": "00:32:58", "text": "一字排開。"}]
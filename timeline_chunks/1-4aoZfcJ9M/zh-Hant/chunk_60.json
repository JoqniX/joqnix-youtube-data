[{"type": "subtitle", "time": 3604.505, "timestamp": "01:00:04", "text": "順便說一句，別大聲喧嘩。"}, {"type": "subtitle", "time": 3605.221, "timestamp": "01:00:05", "text": "做得好。"}, {"type": "subtitle", "time": 3613.471, "timestamp": "01:00:13", "text": "我的上帝。"}, {"type": "subtitle", "time": 3627.433, "timestamp": "01:00:27", "text": "他為什麼不呢？"}, {"type": "subtitle", "time": 3630.779, "timestamp": "01:00:30", "text": "這裡？他準備好了。"}, {"type": "subtitle", "time": 3632.967, "timestamp": "01:00:32", "text": "看看這兩個。"}, {"type": "subtitle", "time": 3634.819, "timestamp": "01:00:34", "text": "建築。"}, {"type": "subtitle", "time": 3642.955, "timestamp": "01:00:42", "text": "他很有魅力。他們"}, {"type": "subtitle", "time": 3644.28, "timestamp": "01:00:44", "text": "他的證據被帶走了。"}, {"type": "subtitle", "time": 3644.817, "timestamp": "01:00:44", "text": "等等。"}, {"type": "subtitle", "time": 3652.76, "timestamp": "01:00:52", "text": "你在哪裡？"}, {"type": "subtitle", "time": 3655.247, "timestamp": "01:00:55", "text": "我在女洗手間。"}, {"type": "subtitle", "time": 3655.871, "timestamp": "01:00:55", "text": "不。"}, {"type": "subtitle", "time": 3657.68, "timestamp": "01:00:57", "text": "哦好的。感謝上帝，"}, {"type": "subtitle", "time": 3659.121, "timestamp": "01:00:59", "text": "你還在廁所裡。全部"}, {"type": "subtitle", "time": 3659.716, "timestamp": "01:00:59", "text": "好的。"}]
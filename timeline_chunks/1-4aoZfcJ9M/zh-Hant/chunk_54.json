[{"type": "subtitle", "time": 3240.821, "timestamp": "00:54:00", "text": "讓他震驚不已"}, {"type": "subtitle", "time": 3249.68, "timestamp": "00:54:09", "text": "一切都很好。他"}, {"type": "subtitle", "time": 3251.127, "timestamp": "00:54:11", "text": "各位，別擔心。 。他正在睡覺。他睡著了。"}, {"type": "subtitle", "time": 3252.731, "timestamp": "00:54:12", "text": "。他正在睡覺。他睡著了。 夥計們。不用擔心。"}, {"type": "subtitle", "time": 3254.079, "timestamp": "00:54:14", "text": "夥計們。不用擔心。 。"}, {"type": "subtitle", "time": 3254.211, "timestamp": "00:54:14", "text": "。 我勒個去？警察。"}, {"type": "subtitle", "time": 3255.984, "timestamp": "00:54:15", "text": "我勒個去？警察。 舉手。"}, {"type": "subtitle", "time": 3260.178, "timestamp": "00:54:20", "text": "警察。舉手。"}, {"type": "subtitle", "time": 3262.279, "timestamp": "00:54:22", "text": "發生了什麼事？"}, {"type": "subtitle", "time": 3265.27, "timestamp": "00:54:25", "text": "哦，原來是我的閃光燈。"}, {"type": "subtitle", "time": 3275.881, "timestamp": "00:54:35", "text": "他正在逃跑。"}, {"type": "subtitle", "time": 3277.732, "timestamp": "00:54:37", "text": "好的，"}, {"type": "subtitle", "time": 3279.036, "timestamp": "00:54:39", "text": "我會追上他。"}, {"type": "subtitle", "time": 3280.424, "timestamp": "00:54:40", "text": "我們來清理一下。"}, {"type": "subtitle", "time": 3285.468, "timestamp": "00:54:45", "text": "區。警察。退出"}, {"type": "subtitle", "time": 3287.066, "timestamp": "00:54:47", "text": "武器。放下武器。"}, {"type": "subtitle", "time": 3291.248, "timestamp": "00:54:51", "text": "那裡。放下槍。"}, {"type": "subtitle", "time": 3292.437, "timestamp": "00:54:52", "text": "現在就做。"}, {"type": "subtitle", "time": 3295.429, "timestamp": "00:54:55", "text": "我們試試看。"}, {"type": "subtitle", "time": 3296.998, "timestamp": "00:54:56", "text": "迅速地。這裡人太多了。"}, {"type": "subtitle", "time": 3297.435, "timestamp": "00:54:57", "text": "人們。"}]
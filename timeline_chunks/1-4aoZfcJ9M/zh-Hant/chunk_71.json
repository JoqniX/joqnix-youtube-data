[{"type": "subtitle", "time": 4263.053, "timestamp": "01:11:03", "text": "就放在那裡吧。好的，用"}, {"type": "subtitle", "time": 4264.0, "timestamp": "01:11:04", "text": "這間房間"}, {"type": "subtitle", "time": 4265.216, "timestamp": "01:11:05", "text": "結束了。如此"}, {"type": "subtitle", "time": 4266.522, "timestamp": "01:11:06", "text": "房間裝修好了。"}, {"type": "subtitle", "time": 4267.761, "timestamp": "01:11:07", "text": "傑克死了。不是"}, {"type": "subtitle", "time": 4269.041, "timestamp": "01:11:09", "text": "這是最好的消息，但是"}, {"type": "subtitle", "time": 4269.883, "timestamp": "01:11:09", "text": "你知道，沒什麼"}, {"type": "subtitle", "time": 4271.343, "timestamp": "01:11:11", "text": "糟糕的。然而"}, {"type": "subtitle", "time": 4276.811, "timestamp": "01:11:16", "text": "我正在處理這件事。幾乎"}, {"type": "subtitle", "time": 4278.121, "timestamp": "01:11:18", "text": "順便說一句，已經完成了。"}, {"type": "subtitle", "time": 4283.983, "timestamp": "01:11:23", "text": "你看，問題在於…"}, {"type": "subtitle", "time": 4285.298, "timestamp": "01:11:25", "text": "我從這類遊戲中獲得了"}, {"type": "subtitle", "time": 4286.243, "timestamp": "01:11:26", "text": "頭暈"}, {"type": "subtitle", "time": 4287.355, "timestamp": "01:11:27", "text": "頭腦，因為一切都是如此。"}, {"type": "subtitle", "time": 4287.963, "timestamp": "01:11:27", "text": "慢的。"}, {"type": "subtitle", "time": 4292.621, "timestamp": "01:11:32", "text": "哦是的。懷疑"}, {"type": "subtitle", "time": 4293.787, "timestamp": "01:11:33", "text": "被拘留並準備"}, {"type": "subtitle", "time": 4294.894, "timestamp": "01:11:34", "text": "運送前。"}, {"type": "subtitle", "time": 4298.985, "timestamp": "01:11:38", "text": "你看到了嗎？"}, {"type": "subtitle", "time": 4302.368, "timestamp": "01:11:42", "text": "這些都是，類似這樣的"}, {"type": "subtitle", "time": 4303.894, "timestamp": "01:11:43", "text": "未登記人員 。老兄，這遊戲就像"}, {"type": "subtitle", "time": 4316.541, "timestamp": "01:11:56", "text": "。老兄，這遊戲就像 尋找靈感，準備好了嗎？"}, {"type": "subtitle", "time": 4318.117, "timestamp": "01:11:58", "text": "尋找靈感，準備好了嗎？ 不是。"}]
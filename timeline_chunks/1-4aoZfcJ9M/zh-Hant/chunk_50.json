[{"type": "subtitle", "time": 3001.331, "timestamp": "00:50:01", "text": "為什麼要綁住我？"}, {"type": "subtitle", "time": 3002.048, "timestamp": "00:50:02", "text": "我以為你"}, {"type": "subtitle", "time": 3002.959, "timestamp": "00:50:02", "text": "你們要來召集我們嗎？"}, {"type": "subtitle", "time": 3003.61, "timestamp": "00:50:03", "text": "節省。"}, {"type": "subtitle", "time": 3004.419, "timestamp": "00:50:04", "text": "在地板上。"}, {"type": "subtitle", "time": 3005.576, "timestamp": "00:50:05", "text": "把我留在這裡。"}, {"type": "subtitle", "time": 3007.186, "timestamp": "00:50:07", "text": "現在就舉手。"}, {"type": "subtitle", "time": 3017.699, "timestamp": "00:50:17", "text": "太酷了。我可以"}, {"type": "subtitle", "time": 3018.792, "timestamp": "00:50:18", "text": "直接射擊"}, {"type": "subtitle", "time": 3019.62, "timestamp": "00:50:19", "text": "用氣槍打他。"}, {"type": "subtitle", "time": 3026.702, "timestamp": "00:50:26", "text": "它們是什麼？它們是什麼？"}, {"type": "subtitle", "time": 3027.64, "timestamp": "00:50:27", "text": "該死的，"}, {"type": "subtitle", "time": 3030.342, "timestamp": "00:50:30", "text": "咳嗽嗎，老兄？傑克，"}, {"type": "subtitle", "time": 3031.783, "timestamp": "00:50:31", "text": "你可以做點什麼 ？不。"}, {"type": "subtitle", "time": 3036.618, "timestamp": "00:50:36", "text": "我為什麼會說出那樣的話？"}, {"type": "subtitle", "time": 3037.075, "timestamp": "00:50:37", "text": "哥們兒？"}, {"type": "subtitle", "time": 3041.759, "timestamp": "00:50:41", "text": "你用的是什麼？"}, {"type": "subtitle", "time": 3042.824, "timestamp": "00:50:42", "text": "催淚瓦斯"}, {"type": "subtitle", "time": 3043.457, "timestamp": "00:50:43", "text": "反對他們？"}, {"type": "subtitle", "time": 3049.158, "timestamp": "00:50:49", "text": "什麼？我不知道。他們"}, {"type": "subtitle", "time": 3050.779, "timestamp": "00:50:50", "text": "劇烈咳嗽，"}, {"type": "subtitle", "time": 3055.14, "timestamp": "00:50:55", "text": "我的天哪。它在外面。"}, {"type": "subtitle", "time": 3058.489, "timestamp": "00:50:58", "text": "這是第一個。"}, {"type": "subtitle", "time": 3059.671, "timestamp": "00:50:59", "text": "我們正在談論的這個人"}]
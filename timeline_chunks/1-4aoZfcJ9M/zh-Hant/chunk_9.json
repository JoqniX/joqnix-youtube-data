[{"type": "subtitle", "time": 540.706, "timestamp": "00:09:00", "text": "你在那裡。是的。"}, {"type": "subtitle", "time": 542.489, "timestamp": "00:09:02", "text": "今天你將是"}, {"type": "subtitle", "time": 543.365, "timestamp": "00:09:03", "text": "和維克一起玩"}, {"type": "subtitle", "time": 544.524, "timestamp": "00:09:04", "text": "放鬆點。"}, {"type": "subtitle", "time": 545.557, "timestamp": "00:09:05", "text": "即使對我來說"}, {"type": "subtitle", "time": 550.927, "timestamp": "00:09:10", "text": "晚的。是的。你在哪裡？"}, {"type": "subtitle", "time": 552.525, "timestamp": "00:09:12", "text": "好的。問候。這裡。"}, {"type": "subtitle", "time": 554.129, "timestamp": "00:09:14", "text": "你必須被傾聽。"}, {"type": "subtitle", "time": 557.558, "timestamp": "00:09:17", "text": "我被關押"}, {"type": "subtitle", "time": 559.332, "timestamp": "00:09:19", "text": "用瞄準鏡。一切都很好。"}, {"type": "subtitle", "time": 560.687, "timestamp": "00:09:20", "text": "別擔心我。 。"}, {"type": "subtitle", "time": 569.637, "timestamp": "00:09:29", "text": "你好。怎麼會，怎麼會，"}, {"type": "subtitle", "time": 570.882, "timestamp": "00:09:30", "text": "大家最近怎麼樣？"}, {"type": "subtitle", "time": 572.427, "timestamp": "00:09:32", "text": "希望你今天過得愉快。"}, {"type": "subtitle", "time": 577.676, "timestamp": "00:09:37", "text": "一切順利。是的，"}, {"type": "subtitle", "time": 579.194, "timestamp": "00:09:39", "text": "我知道我只是"}, {"type": "subtitle", "time": 581.913, "timestamp": "00:09:41", "text": "我精力充沛。我，"}, {"type": "subtitle", "time": 583.119, "timestamp": "00:09:43", "text": "我知道我非常"}, {"type": "subtitle", "time": 584.446, "timestamp": "00:09:44", "text": "騙子。"}, {"type": "subtitle", "time": 588.489, "timestamp": "00:09:48", "text": "嗯，我想大概就是這樣吧。"}, {"type": "subtitle", "time": 590.629, "timestamp": "00:09:50", "text": "傑克先生，"}, {"type": "subtitle", "time": 591.552, "timestamp": "00:09:51", "text": "你是否記得"}, {"type": "subtitle", "time": 592.216, "timestamp": "00:09:52", "text": "協定?"}, {"type": "subtitle", "time": 599.572, "timestamp": "00:09:59", "text": "呃，VPN已開啟。"}]
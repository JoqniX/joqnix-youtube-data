[{"type": "subtitle", "time": 3122.303, "timestamp": "00:52:02", "text": "接下來是"}, {"type": "subtitle", "time": 3123.422, "timestamp": "00:52:03", "text": "下一張牌。我們"}, {"type": "subtitle", "time": 3124.614, "timestamp": "00:52:04", "text": "到此為止。不是"}, {"type": "subtitle", "time": 3125.648, "timestamp": "00:52:05", "text": "處理好這件事。"}, {"type": "subtitle", "time": 3131.439, "timestamp": "00:52:11", "text": "基本的。我認為那是一件武器。"}, {"type": "subtitle", "time": 3132.547, "timestamp": "00:52:12", "text": "就卡住了"}, {"type": "subtitle", "time": 3133.689, "timestamp": "00:52:13", "text": "在某個角落裡，而且"}, {"type": "subtitle", "time": 3138.294, "timestamp": "00:52:18", "text": "現在我們到了。我不知道。"}, {"type": "subtitle", "time": 3140.6, "timestamp": "00:52:20", "text": "是的，很可能是一把霰彈槍。"}, {"type": "subtitle", "time": 3143.647, "timestamp": "00:52:23", "text": "是的，我想是把霰彈槍。"}, {"type": "subtitle", "time": 3144.725, "timestamp": "00:52:24", "text": "剛飛走"}, {"type": "subtitle", "time": 3146.923, "timestamp": "00:52:26", "text": "紋理。我個人可不這麼認為。"}, {"type": "subtitle", "time": 3149.59, "timestamp": "00:52:29", "text": "好的。在任何"}, {"type": "subtitle", "time": 3150.938, "timestamp": "00:52:30", "text": "好的，好的，先生。"}, {"type": "subtitle", "time": 3152.319, "timestamp": "00:52:32", "text": "傑克，這很難。它"}, {"type": "subtitle", "time": 3153.414, "timestamp": "00:52:33", "text": "面積巨大，"}, {"type": "subtitle", "time": 3154.848, "timestamp": "00:52:34", "text": "巨大的地圖，兩個"}, {"type": "subtitle", "time": 3157.072, "timestamp": "00:52:37", "text": "樓層。它會在這裡。"}, {"type": "subtitle", "time": 3157.526, "timestamp": "00:52:37", "text": "混亂。"}, {"type": "subtitle", "time": 3159.077, "timestamp": "00:52:39", "text": "停止。"}, {"type": "subtitle", "time": 3160.679, "timestamp": "00:52:40", "text": "而且根本不會這樣"}, {"type": "subtitle", "time": 3164.815, "timestamp": "00:52:44", "text": "樂趣。是的，我是"}, {"type": "subtitle", "time": 3166.274, "timestamp": "00:52:46", "text": "我就要這玩意兒。"}, {"type": "subtitle", "time": 3171.784, "timestamp": "00:52:51", "text": "致命。從那裡開始。"}, {"type": "subtitle", "time": 3175.114, "timestamp": "00:52:55", "text": "你知道嗎？我沒事。"}, {"type": "subtitle", "time": 3176.954, "timestamp": "00:52:56", "text": "我沒事。我覺得我是"}, {"type": "subtitle", "time": 3178.211, "timestamp": "00:52:58", "text": "相當有信心"}, {"type": "subtitle", "time": 3179.612, "timestamp": "00:52:59", "text": "這是你的選擇，兄弟。"}]
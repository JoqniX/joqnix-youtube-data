[{"type": "subtitle", "time": 3301.932, "timestamp": "00:55:01", "text": "不。不。"}, {"type": "subtitle", "time": 3305.749, "timestamp": "00:55:05", "text": "當心。是"}, {"type": "subtitle", "time": 3309.316, "timestamp": "00:55:09", "text": "小心。各位，我"}, {"type": "subtitle", "time": 3309.826, "timestamp": "00:55:09", "text": "我想"}, {"type": "subtitle", "time": 3312.992, "timestamp": "00:55:12", "text": "不，傑克。"}, {"type": "subtitle", "time": 3315.074, "timestamp": "00:55:15", "text": "什麼？"}, {"type": "subtitle", "time": 3317.086, "timestamp": "00:55:17", "text": "查克，別站直。"}, {"type": "subtitle", "time": 3317.953, "timestamp": "00:55:17", "text": "在我面前。"}, {"type": "subtitle", "time": 3320.24, "timestamp": "00:55:20", "text": "我的天啊。"}, {"type": "subtitle", "time": 3322.647, "timestamp": "00:55:22", "text": "沒有什麼。我會負責報道。"}, {"type": "subtitle", "time": 3325.561, "timestamp": "00:55:25", "text": "走吧，走吧"}, {"type": "subtitle", "time": 3326.07, "timestamp": "00:55:26", "text": "我們開始吧"}, {"type": "subtitle", "time": 3328.817, "timestamp": "00:55:28", "text": "重啟。好的，"}, {"type": "subtitle", "time": 3330.023, "timestamp": "00:55:30", "text": "重啟。"}, {"type": "subtitle", "time": 3331.322, "timestamp": "00:55:31", "text": "已重啟。"}, {"type": "subtitle", "time": 3338.321, "timestamp": "00:55:38", "text": "重新啟動。 F11。魔鬼"}, {"type": "subtitle", "time": 3338.952, "timestamp": "00:55:38", "text": "把它拿走。"}, {"type": "subtitle", "time": 3342.324, "timestamp": "00:55:42", "text": "不要站直。"}, {"type": "subtitle", "time": 3342.971, "timestamp": "00:55:42", "text": "在我前面"}, {"type": "subtitle", "time": 3343.812, "timestamp": "00:55:43", "text": "榴彈發射器。"}, {"type": "subtitle", "time": 3346.119, "timestamp": "00:55:46", "text": "好的。"}, {"type": "subtitle", "time": 3348.725, "timestamp": "00:55:48", "text": "不要站在前面"}, {"type": "subtitle", "time": 3350.446, "timestamp": "00:55:50", "text": "榴彈發射器。我是我"}, {"type": "subtitle", "time": 3351.823, "timestamp": "00:55:51", "text": "我一直都這麼說。"}, {"type": "subtitle", "time": 3354.504, "timestamp": "00:55:54", "text": "這是榴彈發射器嗎？什麼？"}, {"type": "subtitle", "time": 3358.308, "timestamp": "00:55:58", "text": "哦，它不會致命。它"}, {"type": "subtitle", "time": 3359.448, "timestamp": "00:55:59", "text": "這是輕微的噪音"}]
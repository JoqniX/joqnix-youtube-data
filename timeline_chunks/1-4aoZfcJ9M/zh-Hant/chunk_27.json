[{"type": "subtitle", "time": 1622.556, "timestamp": "00:27:02", "text": "這是一張學習路線圖。它"}, {"type": "subtitle", "time": 1623.95, "timestamp": "00:27:03", "text": "其實不是，但我仍然"}, {"type": "subtitle", "time": 1625.059, "timestamp": "00:27:05", "text": "我想打電話給她"}, {"type": "subtitle", "time": 1626.203, "timestamp": "00:27:06", "text": "教育意義，因為它"}, {"type": "subtitle", "time": 1627.026, "timestamp": "00:27:07", "text": "最簡單的"}, {"type": "subtitle", "time": 1635.79, "timestamp": "00:27:15", "text": "地圖，更容易"}, {"type": "subtitle", "time": 1639.137, "timestamp": "00:27:19", "text": "無處。確實存在這種類型"}, {"type": "subtitle", "time": 1641.641, "timestamp": "00:27:21", "text": "地圖。這家店就是"}, {"type": "subtitle", "time": 1643.132, "timestamp": "00:27:23", "text": "同樣，但更複雜，"}, {"type": "subtitle", "time": 1644.473, "timestamp": "00:27:24", "text": "一堆房間之類的東西"}, {"type": "subtitle", "time": 1648.025, "timestamp": "00:27:28", "text": "其他。我依然會是"}, {"type": "subtitle", "time": 1649.184, "timestamp": "00:27:29", "text": "是同一個人"}, {"type": "subtitle", "time": 1650.342, "timestamp": "00:27:30", "text": "但我想要個小一點的。"}, {"type": "subtitle", "time": 1651.467, "timestamp": "00:27:31", "text": "致命的朋友"}, {"type": "subtitle", "time": 1651.876, "timestamp": "00:27:31", "text": "武器。"}, {"type": "subtitle", "time": 1660.081, "timestamp": "00:27:40", "text": "所以我們將選擇這條路。"}, {"type": "subtitle", "time": 1661.89, "timestamp": "00:27:41", "text": "甘地。一切都很好。"}, {"type": "subtitle", "time": 1673.414, "timestamp": "00:27:53", "text": "好的，我需要它。"}, {"type": "subtitle", "time": 1674.537, "timestamp": "00:27:54", "text": "更多胡椒粉"}, {"type": "subtitle", "time": 1675.835, "timestamp": "00:27:55", "text": "噴漆罐，因為我全都"}]
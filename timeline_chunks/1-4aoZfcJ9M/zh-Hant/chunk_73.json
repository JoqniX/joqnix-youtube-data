[{"type": "subtitle", "time": 4381.055, "timestamp": "01:13:01", "text": "好的。是的。是的。"}, {"type": "subtitle", "time": 4385.591, "timestamp": "01:13:05", "text": "我們分兩局進行比賽。"}, {"type": "subtitle", "time": 4387.338, "timestamp": "01:13:07", "text": "是的，我知道。我……我不"}, {"type": "subtitle", "time": 4388.946, "timestamp": "01:13:08", "text": "我知道發生了什麼事。 。怎麼了？"}, {"type": "subtitle", "time": 4397.233, "timestamp": "01:13:17", "text": "每秒12幀。"}, {"type": "subtitle", "time": 4399.939, "timestamp": "01:13:19", "text": "所以，到底發生了什麼事？"}, {"type": "subtitle", "time": 4402.103, "timestamp": "01:13:22", "text": "您好，請問"}, {"type": "subtitle", "time": 4414.372, "timestamp": "01:13:34", "text": "請。這很奇怪。我，"}, {"type": "subtitle", "time": 4415.567, "timestamp": "01:13:35", "text": "可能不是今天"}, {"type": "subtitle", "time": 4416.993, "timestamp": "01:13:36", "text": "我會看的。哦，沒什麼。"}, {"type": "subtitle", "time": 4417.986, "timestamp": "01:13:37", "text": "糟糕的。不是"}, {"type": "subtitle", "time": 4419.713, "timestamp": "01:13:39", "text": "擔心。謝謝。"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "順道過來打個招呼 。"}, {"type": "subtitle", "time": 4424.838, "timestamp": "01:13:44", "text": "哦，你好。"}, {"type": "subtitle", "time": 4428.207, "timestamp": "01:13:48", "text": "好的，傑克。"}, {"type": "subtitle", "time": 4429.492, "timestamp": "01:13:49", "text": "是的，"}, {"type": "subtitle", "time": 4431.323, "timestamp": "01:13:51", "text": "這是醫院裡的一項任務。"}, {"type": "subtitle", "time": 4433.749, "timestamp": "01:13:53", "text": "醫院"}, {"type": "subtitle", "time": 4435.406, "timestamp": "01:13:55", "text": "我覺得你什麼都有了。"}, {"type": "subtitle", "time": 4435.894, "timestamp": "01:13:55", "text": "會解決的。"}, {"type": "subtitle", "time": 4439.538, "timestamp": "01:13:59", "text": "為什麼？我會殺人。"}, {"type": "subtitle", "time": 4439.982, "timestamp": "01:13:59", "text": "人們。"}]
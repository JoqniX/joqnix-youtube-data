[{"type": "subtitle", "time": 2942.042, "timestamp": "00:49:02", "text": "只有一條證據。"}, {"type": "subtitle", "time": 2944.197, "timestamp": "00:49:04", "text": "警察在對所有人撒謊！"}, {"type": "subtitle", "time": 2949.234, "timestamp": "00:49:09", "text": "那傢伙甚至"}, {"type": "subtitle", "time": 2950.517, "timestamp": "00:49:10", "text": "就像跑步一樣。"}, {"type": "subtitle", "time": 2951.653, "timestamp": "00:49:11", "text": "返回總部，就這些了。"}, {"type": "subtitle", "time": 2953.046, "timestamp": "00:49:13", "text": "準備好了，現在我們做什麼？"}, {"type": "subtitle", "time": 2953.303, "timestamp": "00:49:13", "text": "這裡"}, {"type": "subtitle", "time": 2958.173, "timestamp": "00:49:18", "text": "我們正在做什麼？我，我真的是"}, {"type": "subtitle", "time": 2959.432, "timestamp": "00:49:19", "text": "我不知道。我就是這樣"}, {"type": "subtitle", "time": 2960.335, "timestamp": "00:49:20", "text": "使困惑。"}, {"type": "subtitle", "time": 2964.296, "timestamp": "00:49:24", "text": "我也是。我感到困惑。"}, {"type": "subtitle", "time": 2973.119, "timestamp": "00:49:33", "text": "一秒鐘。嗯，"}, {"type": "subtitle", "time": 2978.988, "timestamp": "00:49:38", "text": "不用擔心。簡單地，"}, {"type": "subtitle", "time": 2980.01, "timestamp": "00:49:40", "text": "只是看看。"}, {"type": "subtitle", "time": 2982.104, "timestamp": "00:49:42", "text": "我還在關注。"}, {"type": "subtitle", "time": 2983.189, "timestamp": "00:49:43", "text": "只是看看。"}, {"type": "subtitle", "time": 2987.745, "timestamp": "00:49:47", "text": "我把你放下來。"}, {"type": "subtitle", "time": 2991.8, "timestamp": "00:49:51", "text": "問候。你好嗎？"}]
[{"type": "subtitle", "time": 1148.752, "timestamp": "00:19:08", "text": "好了，我回來了。"}, {"type": "subtitle", "time": 1150.769, "timestamp": "00:19:10", "text": "歡迎回來。"}, {"type": "subtitle", "time": 1152.442, "timestamp": "00:19:12", "text": "簡而言之，傑伊"}, {"type": "subtitle", "time": 1153.818, "timestamp": "00:19:13", "text": "上樓去。"}, {"type": "subtitle", "time": 1155.366, "timestamp": "00:19:15", "text": "這裡有點危險。"}, {"type": "subtitle", "time": 1156.96, "timestamp": "00:19:16", "text": "為你。不適合我。"}, {"type": "subtitle", "time": 1158.444, "timestamp": "00:19:18", "text": "專為你準備。去"}, {"type": "subtitle", "time": 1158.882, "timestamp": "00:19:18", "text": "這裡。"}, {"type": "subtitle", "time": 1161.048, "timestamp": "00:19:21", "text": "我明白了。"}, {"type": "subtitle", "time": 1168.282, "timestamp": "00:19:28", "text": "傑克。今天是萬聖節。"}, {"type": "subtitle", "time": 1170.934, "timestamp": "00:19:30", "text": "哦，今天是萬聖節。"}, {"type": "subtitle", "time": 1174.501, "timestamp": "00:19:34", "text": "南瓜。哦，等等。你"}, {"type": "subtitle", "time": 1175.691, "timestamp": "00:19:35", "text": "你不會瞄準嗎？"}, {"type": "subtitle", "time": 1180.842, "timestamp": "00:19:40", "text": "我覺得有可能，但我並不確定。"}, {"type": "subtitle", "time": 1182.31, "timestamp": "00:19:42", "text": "我知道。前所未有"}, {"type": "subtitle", "time": 1183.209, "timestamp": "00:19:43", "text": "我沒那麼做。"}, {"type": "subtitle", "time": 1193.031, "timestamp": "00:19:53", "text": "這是一個愛好者團體。"}, {"type": "subtitle", "time": 1194.007, "timestamp": "00:19:54", "text": "我們在家，"}, {"type": "subtitle", "time": 1195.094, "timestamp": "00:19:55", "text": "我們繼續前進。"}, {"type": "subtitle", "time": 1196.972, "timestamp": "00:19:56", "text": "是的，我在競選。快點。"}, {"type": "subtitle", "time": 1198.243, "timestamp": "00:19:58", "text": "謹慎行事。"}]
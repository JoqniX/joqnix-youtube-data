[{"type": "subtitle", "time": 4920.286, "timestamp": "01:22:00", "text": "999。"}, {"type": "subtitle", "time": 4924.184, "timestamp": "01:22:04", "text": "別擔心我的。"}, {"type": "subtitle", "time": 4925.244, "timestamp": "01:22:05", "text": "ping。簡單地，"}, {"type": "subtitle", "time": 4926.667, "timestamp": "01:22:06", "text": "別理他。"}, {"type": "subtitle", "time": 4930.244, "timestamp": "01:22:10", "text": "我將不攜帶武器。"}, {"type": "subtitle", "time": 4933.886, "timestamp": "01:22:13", "text": "甘地。別這樣。"}, {"type": "subtitle", "time": 4934.889, "timestamp": "01:22:14", "text": "我們將下地獄"}, {"type": "subtitle", "time": 4936.494, "timestamp": "01:22:16", "text": "紅隊。我"}, {"type": "subtitle", "time": 4937.642, "timestamp": "01:22:17", "text": "我想穿藍色。"}, {"type": "subtitle", "time": 4938.216, "timestamp": "01:22:18", "text": "團隊。"}, {"type": "subtitle", "time": 4940.536, "timestamp": "01:22:20", "text": "好的。"}, {"type": "subtitle", "time": 4942.321, "timestamp": "01:22:22", "text": "對，快點，快點"}, {"type": "subtitle", "time": 4946.198, "timestamp": "01:22:26", "text": "為藍調而演奏。啊哈。"}, {"type": "subtitle", "time": 4954.194, "timestamp": "01:22:34", "text": "快點。向前。撲打"}, {"type": "subtitle", "time": 4968.992, "timestamp": "01:22:48", "text": "隊員們都到齊了吧？"}, {"type": "subtitle", "time": 4974.636, "timestamp": "01:22:54", "text": "我的上帝。哦。"}, {"type": "subtitle", "time": 4978.152, "timestamp": "01:22:58", "text": "是的，它有點卡頓，對吧？"}]
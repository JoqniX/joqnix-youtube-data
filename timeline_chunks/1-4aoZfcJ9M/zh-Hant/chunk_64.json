[{"type": "subtitle", "time": 3840.451, "timestamp": "01:04:00", "text": "她回來了。"}, {"type": "subtitle", "time": 3849.557, "timestamp": "01:04:09", "text": "我看到人。"}, {"type": "subtitle", "time": 3850.556, "timestamp": "01:04:10", "text": "你身上有一個。"}, {"type": "subtitle", "time": 3853.104, "timestamp": "01:04:13", "text": "我的天啊。叮。叮。"}, {"type": "subtitle", "time": 3854.591, "timestamp": "01:04:14", "text": "我死了。"}, {"type": "subtitle", "time": 3858.098, "timestamp": "01:04:18", "text": "為什麼拿走它？"}, {"type": "subtitle", "time": 3858.668, "timestamp": "01:04:18", "text": "機槍？"}, {"type": "subtitle", "time": 3862.233, "timestamp": "01:04:22", "text": "叮。叮。收到一聲提示音。"}, {"type": "subtitle", "time": 3865.314, "timestamp": "01:04:25", "text": "什麼？"}, {"type": "subtitle", "time": 3867.894, "timestamp": "01:04:27", "text": "遊戲卡頓。"}, {"type": "subtitle", "time": 3877.632, "timestamp": "01:04:37", "text": "哦，好吧，現在…"}, {"type": "subtitle", "time": 3879.464, "timestamp": "01:04:39", "text": "土地。舉手。"}, {"type": "subtitle", "time": 3880.667, "timestamp": "01:04:40", "text": "舉手。 嫌疑人已離開"}, {"type": "subtitle", "time": 3881.947, "timestamp": "01:04:41", "text": "嫌疑人已離開 洗手間。"}, {"type": "subtitle", "time": 3883.2, "timestamp": "01:04:43", "text": "洗手間。 另一邊，另一邊"}, {"type": "subtitle", "time": 3884.52, "timestamp": "01:04:44", "text": "另一邊，另一邊 等級。"}, {"type": "subtitle", "time": 3885.429, "timestamp": "01:04:45", "text": "等級。 我不在乎其他什麼。"}, {"type": "subtitle", "time": 3886.731, "timestamp": "01:04:46", "text": "我不在乎其他什麼。 將會發生。簡單地"}, {"type": "subtitle", "time": 3887.968, "timestamp": "01:04:47", "text": "將會發生。簡單地 救我出去"}, {"type": "subtitle", "time": 3889.293, "timestamp": "01:04:49", "text": "救我出去 孔。那傢伙有"}, {"type": "subtitle", "time": 3894.692, "timestamp": "01:04:54", "text": "孔。那傢伙有 是一隻「掘土機」。"}, {"type": "subtitle", "time": 3898.658, "timestamp": "01:04:58", "text": "對，就是他。"}]
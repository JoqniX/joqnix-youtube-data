[{"type": "subtitle", "time": 4021.087, "timestamp": "01:07:01", "text": "我之所以不這麼做，是因為我"}, {"type": "subtitle", "time": 4022.44, "timestamp": "01:07:02", "text": "我用的是CS，所以"}, {"type": "subtitle", "time": 4023.259, "timestamp": "01:07:03", "text": "這些人是什麼人？"}, {"type": "subtitle", "time": 4023.936, "timestamp": "01:07:03", "text": "主要"}, {"type": "subtitle", "time": 4025.037, "timestamp": "01:07:05", "text": "抱歉。"}, {"type": "subtitle", "time": 4028.942, "timestamp": "01:07:08", "text": "呃，口罩，口罩。"}, {"type": "subtitle", "time": 4031.002, "timestamp": "01:07:11", "text": "我看到其中一個"}, {"type": "subtitle", "time": 4031.728, "timestamp": "01:07:11", "text": "射擊者。"}, {"type": "subtitle", "time": 4033.391, "timestamp": "01:07:13", "text": "是的，我需要它。"}, {"type": "subtitle", "time": 4034.771, "timestamp": "01:07:14", "text": "機器。我需要"}, {"type": "subtitle", "time": 4036.044, "timestamp": "01:07:16", "text": "返回我們的"}, {"type": "subtitle", "time": 4036.987, "timestamp": "01:07:16", "text": "創造者。是的。"}, {"type": "subtitle", "time": 4040.938, "timestamp": "01:07:20", "text": "哦，對了，我們的“小動物”"}, {"type": "subtitle", "time": 4042.566, "timestamp": "01:07:22", "text": "可以自由支配"}, {"type": "subtitle", "time": 4045.353, "timestamp": "01:07:25", "text": "是的。是的。那是周末。"}, {"type": "subtitle", "time": 4046.46, "timestamp": "01:07:26", "text": "免費遊戲"}, {"type": "subtitle", "time": 4047.531, "timestamp": "01:07:27", "text": "因為很多人"}, {"type": "subtitle", "time": 4048.92, "timestamp": "01:07:28", "text": "他們說這很有趣，而且"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "所有這些。"}, {"type": "subtitle", "time": 4050.737, "timestamp": "01:07:30", "text": "這很有趣，"}, {"type": "subtitle", "time": 4052.994, "timestamp": "01:07:32", "text": "但問題是，我沒有"}, {"type": "subtitle", "time": 4054.922, "timestamp": "01:07:34", "text": "能夠玩。我"}, {"type": "subtitle", "time": 4056.435, "timestamp": "01:07:36", "text": "玩不了。"}, {"type": "subtitle", "time": 4059.157, "timestamp": "01:07:39", "text": "我不知道。我不知道。"}, {"type": "subtitle", "time": 4060.572, "timestamp": "01:07:40", "text": "我認為這是"}, {"type": "subtitle", "time": 4062.058, "timestamp": "01:07:42", "text": "這讓我想起了《命運2》。"}, {"type": "subtitle", "time": 4064.416, "timestamp": "01:07:44", "text": "這樣一款遊戲，你需要"}, {"type": "subtitle", "time": 4065.515, "timestamp": "01:07:45", "text": "努力奮鬥。"}, {"type": "subtitle", "time": 4068.077, "timestamp": "01:07:48", "text": "是的，這是萃取。 射手。"}, {"type": "subtitle", "time": 4071.293, "timestamp": "01:07:51", "text": "這裡有濕紙巾之類的東西。"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "像這樣。"}, {"type": "subtitle", "time": 4073.738, "timestamp": "01:07:53", "text": "非常非常煩人"}, {"type": "subtitle", "time": 4075.59, "timestamp": "01:07:55", "text": "遊戲。我就是這樣："}, {"type": "subtitle", "time": 4078.322, "timestamp": "01:07:58", "text": "感覺很快。"}, {"type": "subtitle", "time": 4079.906, "timestamp": "01:07:59", "text": "我不想回去。 。"}]
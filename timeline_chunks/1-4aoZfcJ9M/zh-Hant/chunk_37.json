[{"type": "subtitle", "time": 2222.981, "timestamp": "00:37:02", "text": "真是見鬼了。 就像蘭博基尼里的武器一樣。"}, {"type": "subtitle", "time": 2225.789, "timestamp": "00:37:05", "text": "啊哈。"}, {"type": "subtitle", "time": 2229.567, "timestamp": "00:37:09", "text": "烏茲。哦，PP。 PP。我就是這樣："}, {"type": "subtitle", "time": 2230.945, "timestamp": "00:37:10", "text": "“傑克，我早就跟你說過。”"}, {"type": "subtitle", "time": 2232.435, "timestamp": "00:37:12", "text": "去……請不要"}, {"type": "subtitle", "time": 2233.813, "timestamp": "00:37:13", "text": "從蘭博手中奪過武器 裡面……「警察"}, {"type": "subtitle", "time": 2240.834, "timestamp": "00:37:20", "text": "裡面……「警察 略帶震驚：「嗯，這"}, {"type": "subtitle", "time": 2242.016, "timestamp": "00:37:22", "text": "略帶震驚：「嗯，這 他是恐怖分子嗎？"}, {"type": "subtitle", "time": 2243.302, "timestamp": "00:37:23", "text": "他是恐怖分子嗎？ 「誰是恐怖分子的同夥？」不"}, {"type": "subtitle", "time": 2246.463, "timestamp": "00:37:26", "text": "「誰是恐怖分子的同夥？」不 我知道。"}, {"type": "subtitle", "time": 2249.282, "timestamp": "00:37:29", "text": "哦，BLB。"}, {"type": "subtitle", "time": 2254.982, "timestamp": "00:37:34", "text": "等等，我們……好吧。好的。"}, {"type": "subtitle", "time": 2255.592, "timestamp": "00:37:35", "text": "問候。"}, {"type": "subtitle", "time": 2259.758, "timestamp": "00:37:39", "text": "喬，你好嗎？我有"}, {"type": "subtitle", "time": 2261.716, "timestamp": "00:37:41", "text": "一切都很好。阿利索，"}, {"type": "subtitle", "time": 2266.171, "timestamp": "00:37:46", "text": "我很好。我"}, {"type": "subtitle", "time": 2267.552, "timestamp": "00:37:47", "text": "今天做了一堆"}, {"type": "subtitle", "time": 2269.954, "timestamp": "00:37:49", "text": "事件。相關事項"}, {"type": "subtitle", "time": 2272.944, "timestamp": "00:37:52", "text": "帶有後端。新"}, {"type": "subtitle", "time": 2274.198, "timestamp": "00:37:54", "text": "創造了新的事物。"}, {"type": "subtitle", "time": 2278.009, "timestamp": "00:37:58", "text": "所以，我當時就想…"}, {"type": "subtitle", "time": 2279.042, "timestamp": "00:37:59", "text": "為……做某事"}]
[{"type": "subtitle", "time": 2282.734, "timestamp": "00:38:02", "text": "共享流。所以"}, {"type": "subtitle", "time": 2283.776, "timestamp": "00:38:03", "text": "參與了這項工作"}, {"type": "subtitle", "time": 2285.02, "timestamp": "00:38:05", "text": "幾天前和昨天"}, {"type": "subtitle", "time": 2285.626, "timestamp": "00:38:05", "text": "今天。"}, {"type": "subtitle", "time": 2287.225, "timestamp": "00:38:07", "text": "怎麼了？"}, {"type": "subtitle", "time": 2288.578, "timestamp": "00:38:08", "text": "我只是在聊天。"}, {"type": "subtitle", "time": 2290.389, "timestamp": "00:38:10", "text": "是的。是的。它似乎"}, {"type": "subtitle", "time": 2291.953, "timestamp": "00:38:11", "text": "我一定是被趕出去了。"}, {"type": "subtitle", "time": 2293.842, "timestamp": "00:38:13", "text": "他們把我趕出去了。"}, {"type": "subtitle", "time": 2296.321, "timestamp": "00:38:16", "text": "我還能繼續參與這場遊戲嗎？"}, {"type": "subtitle", "time": 2299.121, "timestamp": "00:38:19", "text": "你，你還在遊戲中，"}, {"type": "subtitle", "time": 2299.584, "timestamp": "00:38:19", "text": "老兄。"}, {"type": "subtitle", "time": 2301.194, "timestamp": "00:38:21", "text": "哦，好吧。然後"}, {"type": "subtitle", "time": 2302.76, "timestamp": "00:38:22", "text": "好的。我沒有被趕出去。"}, {"type": "subtitle", "time": 2305.886, "timestamp": "00:38:25", "text": "好的。你仍然在這裡，直到"}, {"type": "subtitle", "time": 2307.949, "timestamp": "00:38:27", "text": "事物。你還在這裡"}, {"type": "subtitle", "time": 2309.07, "timestamp": "00:38:29", "text": "對了，我已經準備好了。"}, {"type": "subtitle", "time": 2310.506, "timestamp": "00:38:30", "text": "好的。"}, {"type": "subtitle", "time": 2313.556, "timestamp": "00:38:33", "text": "那挺好的。"}, {"type": "subtitle", "time": 2322.13, "timestamp": "00:38:42", "text": "如果你被趕出去了，"}, {"type": "subtitle", "time": 2323.047, "timestamp": "00:38:43", "text": "我必須"}, {"type": "subtitle", "time": 2324.313, "timestamp": "00:38:44", "text": "重啟伺服器"}, {"type": "subtitle", "time": 2325.443, "timestamp": "00:38:45", "text": "或類似的事情。在，"}, {"type": "subtitle", "time": 2326.107, "timestamp": "00:38:46", "text": "是的。"}, {"type": "subtitle", "time": 2329.159, "timestamp": "00:38:49", "text": "我想你在這裡。哦，你"}, {"type": "subtitle", "time": 2330.276, "timestamp": "00:38:50", "text": "這裡。你在這裡。"}, {"type": "subtitle", "time": 2331.42, "timestamp": "00:38:51", "text": "是的，我在這裡。"}, {"type": "subtitle", "time": 2334.206, "timestamp": "00:38:54", "text": "你在這裡。該死的。"}, {"type": "subtitle", "time": 2338.019, "timestamp": "00:38:58", "text": "是的，我在這裡。"}, {"type": "subtitle", "time": 2339.067, "timestamp": "00:38:59", "text": "前往"}]
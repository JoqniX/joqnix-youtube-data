[{"type": "subtitle", "time": 4803.682, "timestamp": "01:20:03", "text": "嗯。嗯。好的。好的。"}, {"type": "subtitle", "time": 4804.801, "timestamp": "01:20:04", "text": "我加入。"}, {"type": "subtitle", "time": 4807.96, "timestamp": "01:20:07", "text": "它應該開始了。"}, {"type": "subtitle", "time": 4809.143, "timestamp": "01:20:09", "text": "呃，好吧，你，你"}, {"type": "subtitle", "time": 4809.991, "timestamp": "01:20:09", "text": "按下..."}, {"type": "subtitle", "time": 4811.815, "timestamp": "01:20:11", "text": "我點擊了「確定」…"}, {"type": "subtitle", "time": 4812.552, "timestamp": "01:20:12", "text": "伺服器?"}, {"type": "subtitle", "time": 4814.73, "timestamp": "01:20:14", "text": "似乎如此。"}, {"type": "subtitle", "time": 4815.691, "timestamp": "01:20:15", "text": "好的，"}, {"type": "subtitle", "time": 4833.137, "timestamp": "01:20:33", "text": "載入中.她 她在這裡。"}, {"type": "subtitle", "time": 4839.185, "timestamp": "01:20:39", "text": "哦好的。陡峭地。"}, {"type": "subtitle", "time": 4853.541, "timestamp": "01:20:53", "text": "加入給我"}, {"type": "subtitle", "time": 4855.826, "timestamp": "01:20:55", "text": "一秒鐘。允許"}]
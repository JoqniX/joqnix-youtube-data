[{"type": "subtitle", "time": 5280.791, "timestamp": "01:28:00", "text": "我明白了。你好。"}, {"type": "subtitle", "time": 5284.375, "timestamp": "01:28:04", "text": "你好。你好。是的。嗯，"}, {"type": "subtitle", "time": 5286.703, "timestamp": "01:28:06", "text": "是的，明天。是的，我可以。"}, {"type": "subtitle", "time": 5289.969, "timestamp": "01:28:09", "text": "會。是的。呃，之後"}, {"type": "subtitle", "time": 5291.361, "timestamp": "01:28:11", "text": "午餐。我自由了。"}, {"type": "subtitle", "time": 5296.386, "timestamp": "01:28:16", "text": "是的。班級。好的，明白了。"}, {"type": "subtitle", "time": 5297.539, "timestamp": "01:28:17", "text": "我們可以玩。"}, {"type": "subtitle", "time": 5298.638, "timestamp": "01:28:18", "text": "明天，兄弟。不是"}, {"type": "subtitle", "time": 5299.423, "timestamp": "01:28:19", "text": "擔心。"}, {"type": "subtitle", "time": 5301.94, "timestamp": "01:28:21", "text": "別擔心，哦，不"}, {"type": "subtitle", "time": 5302.666, "timestamp": "01:28:22", "text": "擔心。"}, {"type": "subtitle", "time": 5310.043, "timestamp": "01:28:30", "text": "下載。好的，我"}, {"type": "subtitle", "time": 5311.71, "timestamp": "01:28:31", "text": "我就不說了。我就說到這兒吧。"}, {"type": "subtitle", "time": 5312.201, "timestamp": "01:28:32", "text": "從下方。"}, {"type": "subtitle", "time": 5313.498, "timestamp": "01:28:33", "text": "我認為，這場活動意義非凡。"}, {"type": "subtitle", "time": 5314.632, "timestamp": "01:28:34", "text": "他們切割，他們"}, {"type": "subtitle", "time": 5315.482, "timestamp": "01:28:35", "text": "剪掉，他們"}, {"type": "subtitle", "time": 5316.679, "timestamp": "01:28:36", "text": "刪掉所有事件和一切"}, {"type": "subtitle", "time": 5317.677, "timestamp": "01:28:37", "text": "像這樣。這已不再是事實"}, {"type": "subtitle", "time": 5318.971, "timestamp": "01:28:38", "text": "難的。我們可以"}, {"type": "subtitle", "time": 5320.289, "timestamp": "01:28:40", "text": "基本上就是透過"}, {"type": "subtitle", "time": 5321.508, "timestamp": "01:28:41", "text": "那是十場比賽。"}, {"type": "subtitle", "time": 5323.212, "timestamp": "01:28:43", "text": "我們這就結束。"}, {"type": "subtitle", "time": 5324.121, "timestamp": "01:28:44", "text": "所有這些事情"}, {"type": "subtitle", "time": 5325.555, "timestamp": "01:28:45", "text": "特點。所以，而且"}, {"type": "subtitle", "time": 5326.907, "timestamp": "01:28:46", "text": "他們還刪除了"}, {"type": "subtitle", "time": 5327.529, "timestamp": "01:28:47", "text": "該政權"}, {"type": "subtitle", "time": 5332.105, "timestamp": "01:28:52", "text": "因為人們太強大了。"}, {"type": "subtitle", "time": 5333.016, "timestamp": "01:28:53", "text": "汗流浹背"}, {"type": "subtitle", "time": 5335.354, "timestamp": "01:28:55", "text": "模式。所以，不知怎麼的 ， 大概。"}]
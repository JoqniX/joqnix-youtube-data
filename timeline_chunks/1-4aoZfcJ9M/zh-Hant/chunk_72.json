[{"type": "subtitle", "time": 4322.946, "timestamp": "01:12:02", "text": "這就是靈感的來源"}, {"type": "subtitle", "time": 4323.26, "timestamp": "01:12:03", "text": "她。"}, {"type": "subtitle", "time": 4325.448, "timestamp": "01:12:05", "text": "是的，沒錯。"}, {"type": "subtitle", "time": 4326.752, "timestamp": "01:12:06", "text": "這……這遊戲"}, {"type": "subtitle", "time": 4328.966, "timestamp": "01:12:08", "text": "名為 Swatfall。它"}, {"type": "subtitle", "time": 4333.551, "timestamp": "01:12:13", "text": "原來的。她是個小"}, {"type": "subtitle", "time": 4334.895, "timestamp": "01:12:14", "text": "比那位更愚蠢"}, {"type": "subtitle", "time": 4339.554, "timestamp": "01:12:19", "text": "你玩遊戲是因為劇情和"}, {"type": "subtitle", "time": 4341.697, "timestamp": "01:12:21", "text": "所有這些。我的天哪，太可怕了。"}, {"type": "subtitle", "time": 4344.622, "timestamp": "01:12:24", "text": "例如，你不會擁有它。"}, {"type": "subtitle", "time": 4351.253, "timestamp": "01:12:31", "text": "為什麼是第四個？我"}, {"type": "subtitle", "time": 4352.449, "timestamp": "01:12:32", "text": "我是說"}, {"type": "subtitle", "time": 4354.428, "timestamp": "01:12:34", "text": "有第一、第二、第三。"}, {"type": "subtitle", "time": 4356.006, "timestamp": "01:12:36", "text": "這顯然是第四個了。"}, {"type": "subtitle", "time": 4362.534, "timestamp": "01:12:42", "text": "好的，傑克。我"}, {"type": "subtitle", "time": 4363.741, "timestamp": "01:12:43", "text": "清潔完畢"}, {"type": "subtitle", "time": 4364.735, "timestamp": "01:12:44", "text": "在家，因為一切"}, {"type": "subtitle", "time": 4367.577, "timestamp": "01:12:47", "text": "完畢。所有證據"}, {"type": "subtitle", "time": 4369.137, "timestamp": "01:12:49", "text": "集。比如，只有"}, {"type": "subtitle", "time": 4370.751, "timestamp": "01:12:50", "text": "兩項證據。就這樣。"}, {"type": "subtitle", "time": 4371.589, "timestamp": "01:12:51", "text": "好了，我們來到了這裡。"}, {"type": "subtitle", "time": 4372.292, "timestamp": "01:12:52", "text": "完成的。"}, {"type": "subtitle", "time": 4373.348, "timestamp": "01:12:53", "text": "你做了什麼？"}, {"type": "subtitle", "time": 4374.164, "timestamp": 
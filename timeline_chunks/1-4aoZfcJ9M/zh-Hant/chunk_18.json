[{"type": "subtitle", "time": 1082.67, "timestamp": "00:18:02", "text": "你有。是的。你有"}, {"type": "subtitle", "time": 1086.91, "timestamp": "00:18:06", "text": "198型。簡而言之，"}, {"type": "subtitle", "time": 1088.382, "timestamp": "00:18:08", "text": "傑克先生，請按“ 準備好了」。別擔心。"}, {"type": "subtitle", "time": 1089.868, "timestamp": "00:18:09", "text": "準備好了」。別擔心。 關於這件事。"}, {"type": "subtitle", "time": 1095.829, "timestamp": "00:18:15", "text": "我們進去吧。"}, {"type": "subtitle", "time": 1098.259, "timestamp": "00:18:18", "text": "進入遊戲。我們不能"}, {"type": "subtitle", "time": 1099.491, "timestamp": "00:18:19", "text": "錯過這一刻。"}, {"type": "subtitle", "time": 1102.698, "timestamp": "00:18:22", "text": "好了，我準備好了。"}, {"type": "subtitle", "time": 1104.288, "timestamp": "00:18:24", "text": "給我一分鐘時間。給"}, {"type": "subtitle", "time": 1105.181, "timestamp": "00:18:25", "text": "我要洗手。"}, {"type": "subtitle", "time": 1119.847, "timestamp": "00:18:39", "text": "好了，快點。我"}, {"type": "subtitle", "time": 1121.151, "timestamp": "00:18:41", "text": "我喜歡他現在的樣子。"}, {"type": "subtitle", "time": 1127.753, "timestamp": "00:18:47", "text": "該死，都是我。"}, {"type": "subtitle", "time": 1129.337, "timestamp": "00:18:49", "text": "我喜歡他現在的樣子。"}, {"type": "subtitle", "time": 1131.049, "timestamp": "00:18:51", "text": "該死，他有把AK-47。"}, {"type": "subtitle", "time": 1133.459, "timestamp": "00:18:53", "text": "在特種部隊。魔鬼"}, {"type": "subtitle", "time": 1134.635, "timestamp": "00:18:54", "text": "傑克，拿著吧。"}, {"type": "subtitle", "time": 1136.265, "timestamp": "00:18:56", "text": "至少拿點東西。"}, {"type": "subtitle", "time": 1137.756, "timestamp": "00:18:57", "text": "非致命性。我的天啊。"}]
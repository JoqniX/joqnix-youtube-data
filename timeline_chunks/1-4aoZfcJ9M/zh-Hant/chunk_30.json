[{"type": "subtitle", "time": 1801.994, "timestamp": "00:30:01", "text": "是的。不用擔心。"}, {"type": "subtitle", "time": 1803.1, "timestamp": "00:30:03", "text": "沒錯，老兄。不是"}, {"type": "subtitle", "time": 1807.22, "timestamp": "00:30:07", "text": "擔心。忘了它。"}, {"type": "subtitle", "time": 1813.258, "timestamp": "00:30:13", "text": "關於這件事。傑克先生，"}, {"type": "subtitle", "time": 1814.625, "timestamp": "00:30:14", "text": "你現在的狀態還不太一樣。"}, {"type": "subtitle", "time": 1815.993, "timestamp": "00:30:15", "text": "轉向聊天視窗。"}, {"type": "subtitle", "time": 1817.311, "timestamp": "00:30:17", "text": "你想去哪裡？"}, {"type": "subtitle", "time": 1819.04, "timestamp": "00:30:19", "text": "正面還是背面？那好吧"}, {"type": "subtitle", "time": 1819.359, "timestamp": "00:30:19", "text": "為了。"}, {"type": "subtitle", "time": 1822.684, "timestamp": "00:30:22", "text": "嗯哼。聊天，就像"}, {"type": "subtitle", "time": 1824.075, "timestamp": "00:30:24", "text": "原來是同學。"}, {"type": "subtitle", "time": 1838.042, "timestamp": "00:30:38", "text": "好的。好的。不，"}, {"type": "subtitle", "time": 1840.063, "timestamp": "00:30:40", "text": "沒有人。沒有。我"}, {"type": "subtitle", "time": 1841.5, "timestamp": "00:30:41", "text": "我沒看到任何人。他"}, {"type": "subtitle", "time": 1842.229, "timestamp": "00:30:42", "text": "或許只是"}, {"type": "subtitle", "time": 1844.506, "timestamp": "00:30:44", "text": "打開。慢的。"}, {"type": "subtitle", "time": 1846.294, "timestamp": "00:30:46", "text": "我們行動緩慢。"}, {"type": "subtitle", "time": 1852.42, "timestamp": "00:30:52", "text": "我可以破門而入"}, {"type": "subtitle", "time": 1853.52, "timestamp": "00:30:53", "text": "如果你願意的話。"}, {"type": "subtitle", "time": 1857.334, "timestamp": "00:30:57", "text": "警察，跪下！"}, {"type": "subtitle", "time": 1858.321, "timestamp": "00:30:58", "text": "舉手！"}, {"type": "subtitle", "time": 1859.826, "timestamp": "00:30:59", "text": "覆蓋。簡單地"}]
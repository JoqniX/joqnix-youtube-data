[{"type": "subtitle", "time": 3480.938, "timestamp": "00:58:00", "text": "響亮而震耳欲聾。"}, {"type": "subtitle", "time": 3485.904, "timestamp": "00:58:05", "text": "那我再拿一個。"}, {"type": "subtitle", "time": 3486.511, "timestamp": "00:58:06", "text": "手榴彈。"}, {"type": "subtitle", "time": 3492.518, "timestamp": "00:58:12", "text": "不要這樣做。我們不"}, {"type": "subtitle", "time": 3493.848, "timestamp": "00:58:13", "text": "你需要兩枚手榴彈。"}, {"type": "subtitle", "time": 3495.045, "timestamp": "00:58:15", "text": "問題在於我們"}, {"type": "subtitle", "time": 3500.237, "timestamp": "00:58:20", "text": "當地獄降臨之時，"}, {"type": "subtitle", "time": 3501.477, "timestamp": "00:58:21", "text": "我們想要你的"}, {"type": "subtitle", "time": 3502.824, "timestamp": "00:58:22", "text": "機槍掃射，把所有人都炸飛了。"}, {"type": "subtitle", "time": 3506.418, "timestamp": "00:58:26", "text": "所以"}, {"type": "subtitle", "time": 3507.578, "timestamp": "00:58:27", "text": "我有一把機關槍。"}, {"type": "subtitle", "time": 3511.168, "timestamp": "00:58:31", "text": "他有，他有"}, {"type": "subtitle", "time": 3511.786, "timestamp": "00:58:31", "text": "機槍。"}, {"type": "subtitle", "time": 3513.031, "timestamp": "00:58:33", "text": "是的。"}, {"type": "subtitle", "time": 3515.989, "timestamp": "00:58:35", "text": "啊哈。他有一支機關槍。"}, {"type": "subtitle", "time": 3517.118, "timestamp": "00:58:37", "text": "拜託，老兄。"}, {"type": "subtitle", "time": 3519.312, "timestamp": "00:58:39", "text": "好的。我是我"}, {"type": "subtitle", "time": 3524.534, "timestamp": "00:58:44", "text": "我確信"}, {"type": "subtitle", "time": 3532.852, "timestamp": "00:58:52", "text": "傑克和我在一起。"}, {"type": "subtitle", "time": 3536.007, "timestamp": "00:58:56", "text": "他在哪裡？你在哪裡？在，"}, {"type": "subtitle", "time": 3537.581, "timestamp": "00:58:57", "text": "我在這裡。"}, {"type": "subtitle", "time": 3538.855, "timestamp": "00:58:58", "text": "抓住它。"}]
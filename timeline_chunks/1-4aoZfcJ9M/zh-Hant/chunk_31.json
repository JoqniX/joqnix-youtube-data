[{"type": "subtitle", "time": 1861.122, "timestamp": "00:31:01", "text": "放我出去。"}, {"type": "subtitle", "time": 1862.666, "timestamp": "00:31:02", "text": "好的。"}, {"type": "subtitle", "time": 1867.297, "timestamp": "00:31:07", "text": "但我……我什麼都不知道。"}, {"type": "subtitle", "time": 1867.825, "timestamp": "00:31:07", "text": "做過。"}, {"type": "subtitle", "time": 1870.155, "timestamp": "00:31:10", "text": "哦，確認了。"}, {"type": "subtitle", "time": 1871.387, "timestamp": "00:31:11", "text": "先生，請去洗手間。"}, {"type": "subtitle", "time": 1872.605, "timestamp": "00:31:12", "text": "傑克。請，"}, {"type": "subtitle", "time": 1873.857, "timestamp": "00:31:13", "text": "不要殺人。"}, {"type": "subtitle", "time": 1875.538, "timestamp": "00:31:15", "text": "好了，關門了。"}, {"type": "subtitle", "time": 1877.244, "timestamp": "00:31:17", "text": "解鎖。"}, {"type": "subtitle", "time": 1881.041, "timestamp": "00:31:21", "text": "為什麼是這個洗手間？"}, {"type": "subtitle", "time": 1882.241, "timestamp": "00:31:22", "text": "打開？什麼樣的"}, {"type": "subtitle", "time": 1896.596, "timestamp": "00:31:36", "text": "妄想？躺。"}, {"type": "subtitle", "time": 1899.44, "timestamp": "00:31:39", "text": "陡峭地。好的。"}, {"type": "subtitle", "time": 1900.945, "timestamp": "00:31:40", "text": "好的。順便說一下，現在"}, {"type": "subtitle", "time": 1902.202, "timestamp": "00:31:42", "text": "那邊的門是開著的。"}, {"type": "subtitle", "time": 1903.262, "timestamp": "00:31:43", "text": "萬一。"}, {"type": "subtitle", "time": 1904.586, "timestamp": "00:31:44", "text": "好的。"}, {"type": "subtitle", "time": 1906.293, "timestamp": "00:31:46", "text": "請勿打開這些"}, {"type": "subtitle", "time": 1913.596, "timestamp": "00:31:53", "text": "門。你去。"}, {"type": "subtitle", "time": 1918.263, "timestamp": "00:31:58", "text": "嗯哼。"}]
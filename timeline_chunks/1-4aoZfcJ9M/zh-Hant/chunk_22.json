[{"type": "subtitle", "time": 1321.969, "timestamp": "00:22:01", "text": "事情，不，不，不，不。不是 這樣做。"}, {"type": "subtitle", "time": 1326.809, "timestamp": "00:22:06", "text": "放下武器。手"}, {"type": "subtitle", "time": 1328.277, "timestamp": "00:22:08", "text": "多於。躺。"}, {"type": "subtitle", "time": 1330.672, "timestamp": "00:22:10", "text": "不要開槍。跪下。"}, {"type": "subtitle", "time": 1332.19, "timestamp": "00:22:12", "text": "是的。我見過他。"}, {"type": "subtitle", "time": 1333.864, "timestamp": "00:22:13", "text": "這簡直太瘋狂了，怎麼會這樣"}, {"type": "subtitle", "time": 1337.546, "timestamp": "00:22:17", "text": "好的。土地。"}, {"type": "subtitle", "time": 1341.535, "timestamp": "00:22:21", "text": "這簡直是瘋了。"}, {"type": "subtitle", "time": 1342.404, "timestamp": "00:22:22", "text": "像罪犯這樣的"}, {"type": "subtitle", "time": 1343.406, "timestamp": "00:22:23", "text": "實際上，他們並非如此。"}, {"type": "subtitle", "time": 1344.141, "timestamp": "00:22:24", "text": "向"}, {"type": "subtitle", "time": 1345.477, "timestamp": "00:22:25", "text": "回答等等 。"}, {"type": "subtitle", "time": 1354.406, "timestamp": "00:22:34", "text": "我忘了報告。"}, {"type": "subtitle", "time": 1355.986, "timestamp": "00:22:35", "text": "那裡有個男的。那裡"}, {"type": "subtitle", "time": 1357.25, "timestamp": "00:22:37", "text": "有人逍遙法外。"}, {"type": "subtitle", "time": 1360.227, "timestamp": "00:22:40", "text": "你你穿上"}, {"type": "subtitle", "time": 1361.159, "timestamp": "00:22:41", "text": "他被戴上手銬了嗎？"}, {"type": "subtitle", "time": 1362.392, "timestamp": "00:22:42", "text": "是的。手銬"}, {"type": "subtitle", "time": 1363.535, "timestamp": "00:22:43", "text": "他。報告。"}, {"type": "subtitle", "time": 1366.79, "timestamp": "00:22:46", "text": "有人在那裡走動。"}, {"type": "subtitle", "time": 1367.985, "timestamp": "00:22:47", "text": "意志。哦，你收集了"}, {"type": "subtitle", "time": 1370.336, "timestamp": "00:22:50", "text": "更多證據？那裡"}, {"type": "subtitle", "time": 1371.517, "timestamp": "00:22:51", "text": "有人在那裡走動。"}, {"type": "subtitle", "time": 1372.983, "timestamp": "00:22:52", "text": "順便說一句，是意志力方面。是"}, {"type": "subtitle", "time": 1373.703, "timestamp": "00:22:53", "text": "小心。"}]
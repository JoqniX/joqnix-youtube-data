[{"type": "subtitle", "time": 3182.36, "timestamp": "00:53:02", "text": "就這樣。完美。"}, {"type": "subtitle", "time": 3183.783, "timestamp": "00:53:03", "text": "好了，我準備好了。"}, {"type": "subtitle", "time": 3186.071, "timestamp": "00:53:06", "text": "快點。哦好的。"}, {"type": "subtitle", "time": 3186.902, "timestamp": "00:53:06", "text": "拿點東西。"}, {"type": "subtitle", "time": 3188.292, "timestamp": "00:53:08", "text": "致命。你必須"}, {"type": "subtitle", "time": 3189.69, "timestamp": "00:53:09", "text": "攜帶致命武器。"}, {"type": "subtitle", "time": 3190.288, "timestamp": "00:53:10", "text": "我接受了。"}, {"type": "subtitle", "time": 3193.426, "timestamp": "00:53:13", "text": "你拿走了。"}, {"type": "subtitle", "time": 3195.725, "timestamp": "00:53:15", "text": "啊哈。霰彈槍和烏茲衝鋒槍。"}, {"type": "subtitle", "time": 3199.643, "timestamp": "00:53:19", "text": "酷，兄弟。等待，"}, {"type": "subtitle", "time": 3201.078, "timestamp": "00:53:21", "text": "等待。這是什麼意思？"}, {"type": "subtitle", "time": 3202.25, "timestamp": "00:53:22", "text": "霰彈槍？烏茲。"}, {"type": "subtitle", "time": 3212.472, "timestamp": "00:53:32", "text": "啊哈。啊哈。不，不，傑克。"}, {"type": "subtitle", "time": 3213.758, "timestamp": "00:53:33", "text": "我綁架了他。"}, {"type": "subtitle", "time": 3215.906, "timestamp": "00:53:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 3218.348, "timestamp": "00:53:38", "text": "好的。"}, {"type": "subtitle", "time": 3222.86, "timestamp": "00:53:42", "text": "切？"}, {"type": "subtitle", "time": 3226.292, "timestamp": "00:53:46", "text": "兄弟，我真是太震驚了。 。因為……你就是這樣的人。"}, {"type": "subtitle", "time": 3228.163, "timestamp": "00:53:48", "text": "。因為……你就是這樣的人。 手上很燙。在，"}, {"type": "subtitle", "time": 3234.776, "timestamp": "00:53:54", "text": "好的。別把它炸了。"}, {"type": "subtitle", "time": 3235.67, "timestamp": "00:53:55", "text": "門。簡單地"}, {"type": "subtitle", "time": 3237.003, "timestamp": "00:53:57", "text": "攔住豬。全部"}, {"type": "subtitle", "time": 3238.514, "timestamp": "00:53:58", "text": "好的。我就是他。"}, {"type": "subtitle", "time": 3239.281, "timestamp": "00:53:59", "text": "失明。"}]
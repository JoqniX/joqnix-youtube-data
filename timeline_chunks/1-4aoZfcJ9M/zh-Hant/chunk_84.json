[{"type": "subtitle", "time": 5041.647, "timestamp": "01:24:01", "text": "放下大砲。去做。"}, {"type": "subtitle", "time": 5042.963, "timestamp": "01:24:02", "text": "現在。在地板上。"}, {"type": "subtitle", "time": 5045.196, "timestamp": "01:24:05", "text": "舉手。躺。在"}, {"type": "subtitle", "time": 5046.81, "timestamp": "01:24:06", "text": "地面。舉手。"}, {"type": "subtitle", "time": 5053.582, "timestamp": "01:24:13", "text": "哦好的。"}, {"type": "subtitle", "time": 5057.895, "timestamp": "01:24:17", "text": "哦，我做不到。"}, {"type": "subtitle", "time": 5058.857, "timestamp": "01:24:18", "text": "逮捕。"}, {"type": "subtitle", "time": 5060.841, "timestamp": "01:24:20", "text": "我做不到。"}, {"type": "subtitle", "time": 5062.219, "timestamp": "01:24:22", "text": "逮捕。我不是"}, {"type": "subtitle", "time": 5062.75, "timestamp": "01:24:22", "text": "我知道。"}, {"type": "subtitle", "time": 5065.83, "timestamp": "01:24:25", "text": "我相信你肯定有"}, {"type": "subtitle", "time": 5075.62, "timestamp": "01:24:35", "text": "但你被捕了"}, {"type": "subtitle", "time": 5076.095, "timestamp": "01:24:36", "text": "某人。"}, {"type": "subtitle", "time": 5094.454, "timestamp": "01:24:54", "text": "警察現在就是武器。"}]
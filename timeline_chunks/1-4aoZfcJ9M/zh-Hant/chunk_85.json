[{"type": "subtitle", "time": 5101.447, "timestamp": "01:25:01", "text": "我，我願意。好的，"}, {"type": "subtitle", "time": 5103.062, "timestamp": "01:25:03", "text": "我想我死的原因是"}, {"type": "subtitle", "time": 5109.757, "timestamp": "01:25:09", "text": "為什麼是你，我，我真的"}, {"type": "subtitle", "time": 5124.163, "timestamp": "01:25:24", "text": "武器。等等，什麼？"}, {"type": "subtitle", "time": 5125.182, "timestamp": "01:25:25", "text": "正在發生什麼？"}, {"type": "subtitle", "time": 5132.024, "timestamp": "01:25:32", "text": "這是一支敵軍分遣隊。"}, {"type": "subtitle", "time": 5137.324, "timestamp": "01:25:37", "text": "我感覺自己像是在原地打轉。"}, {"type": "subtitle", "time": 5138.486, "timestamp": "01:25:38", "text": "現在他們周圍都是。"}, {"type": "subtitle", "time": 5141.101, "timestamp": "01:25:41", "text": "我的天哪，我死了。"}, {"type": "subtitle", "time": 5144.317, "timestamp": "01:25:44", "text": "我心想：這太搞笑了"}, {"type": "subtitle", "time": 5150.469, "timestamp": "01:25:50", "text": "我這邊。這是我的。"}, {"type": "subtitle", "time": 5152.703, "timestamp": "01:25:52", "text": "你對所有人撒謊。"}, {"type": "subtitle", "time": 5153.301, "timestamp": "01:25:53", "text": "一秒鐘。"}, {"type": "subtitle", "time": 5157.78, "timestamp": "01:25:57", "text": "是的。我，我已經死了。"}, {"type": "subtitle", "time": 5158.727, "timestamp": "01:25:58", "text": "我，我"}]
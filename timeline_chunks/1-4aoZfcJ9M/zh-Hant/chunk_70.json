[{"type": "subtitle", "time": 4204.185, "timestamp": "01:10:04", "text": "立即地。好的。還有什麼？"}, {"type": "subtitle", "time": 4208.285, "timestamp": "01:10:08", "text": "我該怎麼辦？我"}, {"type": "subtitle", "time": 4209.404, "timestamp": "01:10:09", "text": "需要報告"}, {"type": "subtitle", "time": 4210.848, "timestamp": "01:10:10", "text": "三個人。就這樣。"}, {"type": "subtitle", "time": 4212.031, "timestamp": "01:10:12", "text": "我需要報告。"}, {"type": "subtitle", "time": 4213.203, "timestamp": "01:10:13", "text": "大約三個人。讓"}, {"type": "subtitle", "time": 4214.506, "timestamp": "01:10:14", "text": "他是希臘人。我是某種東西"}, {"type": "subtitle", "time": 4220.322, "timestamp": "01:10:20", "text": "錯過了？哦，證據。"}, {"type": "subtitle", "time": 4222.856, "timestamp": "01:10:22", "text": "團體。"}, {"type": "subtitle", "time": 4226.307, "timestamp": "01:10:26", "text": "我還有兩個人。"}, {"type": "subtitle", "time": 4231.104, "timestamp": "01:10:31", "text": "是的，我們需要手動操作。"}, {"type": "subtitle", "time": 4232.601, "timestamp": "01:10:32", "text": "類型，人，否則就是"}, {"type": "subtitle", "time": 4233.875, "timestamp": "01:10:33", "text": "完全行不通。"}, {"type": "subtitle", "time": 4243.969, "timestamp": "01:10:43", "text": "我明白。我認為這是"}, {"type": "subtitle", "time": 4245.14, "timestamp": "01:10:45", "text": "因為它就在那裡。"}, {"type": "subtitle", "time": 4246.16, "timestamp": "01:10:46", "text": "很多人，"}, {"type": "subtitle", "time": 4247.068, "timestamp": "01:10:47", "text": "你還記得是怎麼做到的嗎？"}, {"type": "subtitle", "time": 4252.16, "timestamp": "01:10:52", "text": "處理伺服器，"}, {"type": "subtitle", "time": 4253.247, "timestamp": "01:10:53", "text": "因為那裡很簡單。"}, {"type": "subtitle", "time": 4257.172, "timestamp": "01:10:57", "text": "人太多了。我"}, {"type": "subtitle", "time": 4258.438, "timestamp": "01:10:58", "text": "偏執狂，誰會擁有它們？"}, {"type": "subtitle", "time": 4259.596, "timestamp": "01:10:59", "text": "只需係好即可"}]
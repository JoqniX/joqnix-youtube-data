[{"type": "subtitle", "time": 2462.711, "timestamp": "00:41:02", "text": "你，你去過那裡嗎？"}, {"type": "subtitle", "time": 2464.32, "timestamp": "00:41:04", "text": "好的。感謝上帝。"}, {"type": "subtitle", "time": 2466.724, "timestamp": "00:41:06", "text": "你拿了獵槍嗎？"}, {"type": "subtitle", "time": 2469.325, "timestamp": "00:41:09", "text": "不，我沒帶獵槍。"}, {"type": "subtitle", "time": 2470.015, "timestamp": "00:41:10", "text": "與你。"}, {"type": "subtitle", "time": 2471.234, "timestamp": "00:41:11", "text": "好的。"}, {"type": "subtitle", "time": 2472.483, "timestamp": "00:41:12", "text": "我有一把獵槍。"}, {"type": "subtitle", "time": 2474.018, "timestamp": "00:41:14", "text": "我有……不，沒有。在"}, {"type": "subtitle", "time": 2475.298, "timestamp": "00:41:15", "text": "我沒有獵槍。"}, {"type": "subtitle", "time": 2477.314, "timestamp": "00:41:17", "text": "沒有任何。沒有任何。不，不"}, {"type": "subtitle", "time": 2478.922, "timestamp": "00:41:18", "text": "不，不。就是我，就像，"}, {"type": "subtitle", "time": 2480.521, "timestamp": "00:41:20", "text": "我正在收集證據。你就是它"}, {"type": "subtitle", "time": 2481.898, "timestamp": "00:41:21", "text": "做過？你只是"}, {"type": "subtitle", "time": 2485.873, "timestamp": "00:41:25", "text": "像傑克"}, {"type": "subtitle", "time": 2497.303, "timestamp": "00:41:37", "text": "我，我有很多次"}, {"type": "subtitle", "time": 2498.224, "timestamp": "00:41:38", "text": "打他。"}, {"type": "subtitle", "time": 2499.656, "timestamp": "00:41:39", "text": "他為什麼沒死？"}, {"type": "subtitle", "time": 2500.944, "timestamp": "00:41:40", "text": "這就是漆彈"}, {"type": "subtitle", "time": 2502.311, "timestamp": "00:41:42", "text": "槍。你不能。"}, {"type": "subtitle", "time": 2503.349, "timestamp": "00:41:43", "text": "用它殺人。"}, {"type": "subtitle", "time": 2503.921, "timestamp": "00:41:43", "text": "躺。"}, {"type": "subtitle", "time": 2504.715, "timestamp": "00:41:44", "text": "這是必要的"}, {"type": "subtitle", "time": 2505.863, "timestamp": "00:41:45", "text": "使用要求"}, {"type": "subtitle", "time": 2507.04, "timestamp": "00:41:47", "text": "服從。你不是"}, {"type": "subtitle", "time": 2508.291, "timestamp": "00:41:48", "text": "你符合要求。我"}, {"type": "subtitle", "time": 2509.477, "timestamp": "00:41:49", "text": "我會讓你大吃一驚。"}, {"type": "subtitle", "time": 2511.799, "timestamp": "00:41:51", "text": "是的。沒有警察。"}, {"type": "subtitle", "time": 2513.386, "timestamp": "00:41:53", "text": "好的。"}, {"type": "subtitle", "time": 2515.801, "timestamp": "00:41:55", "text": "我的天哪。出色地"}, {"type": "subtitle", "time": 2516.731, "timestamp": "00:41:56", "text": "哎，真是的。"}]
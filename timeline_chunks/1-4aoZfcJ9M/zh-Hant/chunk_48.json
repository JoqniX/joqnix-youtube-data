[{"type": "subtitle", "time": 2883.522, "timestamp": "00:48:03", "text": "這……這曾經是"}, {"type": "subtitle", "time": 2884.738, "timestamp": "00:48:04", "text": "平民，以及另一名平民"}, {"type": "subtitle", "time": 2886.063, "timestamp": "00:48:06", "text": "我當時……掏出了武器。"}, {"type": "subtitle", "time": 2893.334, "timestamp": "00:48:13", "text": "所以，事情並非如此。我不知道。"}, {"type": "subtitle", "time": 2895.098, "timestamp": "00:48:15", "text": "或許是被詛咒的"}, {"type": "subtitle", "time": 2896.112, "timestamp": "00:48:16", "text": "這把槍很簡單"}, {"type": "subtitle", "time": 2897.307, "timestamp": "00:48:17", "text": "中了詛咒"}, {"type": "subtitle", "time": 2898.611, "timestamp": "00:48:18", "text": "後面的房間，喔…"}, {"type": "subtitle", "time": 2900.89, "timestamp": "00:48:20", "text": "我勒個去？"}, {"type": "subtitle", "time": 2910.882, "timestamp": "00:48:30", "text": "哦，這裡有人。跪下。"}, {"type": "subtitle", "time": 2912.257, "timestamp": "00:48:32", "text": "等等，它不在那裡。"}, {"type": "subtitle", "time": 2912.604, "timestamp": "00:48:32", "text": "在，"}, {"type": "subtitle", "time": 2915.288, "timestamp": "00:48:35", "text": "為什麼在播放音樂？"}, {"type": "subtitle", "time": 2917.922, "timestamp": "00:48:37", "text": "等待。不，"}, {"type": "subtitle", "time": 2919.653, "timestamp": "00:48:39", "text": "實際上，並非如此。不是"}, {"type": "subtitle", "time": 2921.211, "timestamp": "00:48:41", "text": "我覺得是人。 。我認為這是"}, {"type": "subtitle", "time": 2922.505, "timestamp": "00:48:42", "text": "。我認為這是 那裡只有幾個男生，"}, {"type": "subtitle", "time": 2923.806, "timestamp": "00:48:43", "text": "那裡只有幾個男生， 就像連在一起一樣，我的天哪。"}, {"type": "subtitle", "time": 2932.076, "timestamp": "00:48:52", "text": "因為在任務面板中"}, {"type": "subtitle", "time": 2933.443, "timestamp": "00:48:53", "text": "我們都是平民，全部"}, {"type": "subtitle", "time": 2934.46, "timestamp": "00:48:54", "text": "嫌疑人，我們"}, {"type": "subtitle", "time": 2935.722, "timestamp": "00:48:55", "text": "我們正在整理東西等等"}, {"type": "subtitle", "time": 2936.073, "timestamp": "00:48:56", "text": "其他。"}]
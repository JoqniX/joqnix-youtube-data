[{"type": "subtitle", "time": 4982.943, "timestamp": "01:23:02", "text": "團隊。它"}, {"type": "subtitle", "time": 4983.516, "timestamp": "01:23:03", "text": "滯後。"}, {"type": "subtitle", "time": 4988.264, "timestamp": "01:23:08", "text": "我勒個去？我死了，"}, {"type": "subtitle", "time": 4991.453, "timestamp": "01:23:11", "text": "兄弟。"}, {"type": "subtitle", "time": 4992.807, "timestamp": "01:23:12", "text": "你已經死了。"}, {"type": "subtitle", "time": 4997.304, "timestamp": "01:23:17", "text": "什麼？"}, {"type": "subtitle", "time": 5007.827, "timestamp": "01:23:27", "text": "哦好的。作為"}, {"type": "subtitle", "time": 5012.033, "timestamp": "01:23:32", "text": "那傢伙"}, {"type": "subtitle", "time": 5012.786, "timestamp": "01:23:32", "text": "霰彈槍？"}, {"type": "subtitle", "time": 5016.29, "timestamp": "01:23:36", "text": "嫌犯"}, {"type": "subtitle", "time": 5017.788, "timestamp": "01:23:37", "text": "兩名嫌疑人"}, {"type": "subtitle", "time": 5018.069, "timestamp": "01:23:38", "text": "那裡。"}, {"type": "subtitle", "time": 5021.089, "timestamp": "01:23:41", "text": "啊哈。他搬家了。 。我，我，我不能，我，我在裡面"}, {"type": "subtitle", "time": 5027.233, "timestamp": "01:23:47", "text": "。我，我，我不能，我，我在裡面 懸而未決。我身處永恆之中。"}, {"type": "subtitle", "time": 5028.885, "timestamp": "01:23:48", "text": "懸而未決。我身處永恆之中。 懸而未決。"}, {"type": "subtitle", "time": 5031.896, "timestamp": "01:23:51", "text": "我知道。這就是"}, {"type": "subtitle", "time": 5033.176, "timestamp": "01:23:53", "text": "不得不面對"}, {"type": "subtitle", "time": 5033.513, "timestamp": "01:23:53", "text": "我。"}, {"type": "subtitle", "time": 5036.084, "timestamp": "01:23:56", "text": "躺在地板上。"}, {"type": "subtitle", "time": 5037.536, "timestamp": "01:23:57", "text": "舉手。丟"}, {"type": "subtitle", "time": 5039.082, "timestamp": "01:23:59", "text": "武器。舉手。"}]
[{"type": "subtitle", "time": 4442.802, "timestamp": "01:14:02", "text": "我覺得你什麼都有了。"}, {"type": "subtitle", "time": 4445.417, "timestamp": "01:14:05", "text": "會解決的。哦，對了，沒有"}, {"type": "subtitle", "time": 4448.573, "timestamp": "01:14:08", "text": "猶豫要不要殺我"}, {"type": "subtitle", "time": 4449.576, "timestamp": "01:14:09", "text": "我不做這種事。"}, {"type": "subtitle", "time": 4450.911, "timestamp": "01:14:10", "text": "但這並不意味著你"}, {"type": "subtitle", "time": 4451.954, "timestamp": "01:14:11", "text": "不應該這樣做"}, {"type": "subtitle", "time": 4452.425, "timestamp": "01:14:12", "text": "做。"}, {"type": "subtitle", "time": 4453.427, "timestamp": "01:14:13", "text": "哦好的。"}, {"type": "subtitle", "time": 4454.406, "timestamp": "01:14:14", "text": "你不能就這麼不"}, {"type": "subtitle", "time": 4455.505, "timestamp": "01:14:15", "text": "殺害平民。"}, {"type": "subtitle", "time": 4456.381, "timestamp": "01:14:16", "text": "就這樣。"}, {"type": "subtitle", "time": 4457.757, "timestamp": "01:14:17", "text": "我的天啊。"}, {"type": "subtitle", "time": 4460.378, "timestamp": "01:14:20", "text": "哦，對了，還要特別感謝…"}, {"type": "subtitle", "time": 4461.706, "timestamp": "01:14:21", "text": "之前見過他們幾次。"}, {"type": "subtitle", "time": 4463.07, "timestamp": "01:14:23", "text": "與其開槍，不如…"}, {"type": "subtitle", "time": 4467.111, "timestamp": "01:14:27", "text": "你將被罰款。所以，"}, {"type": "subtitle", "time": 4467.724, "timestamp": "01:14:27", "text": "你知道，"}, {"type": "subtitle", "time": 4475.005, "timestamp": "01:14:35", "text": "我明白。簡單地"}, {"type": "subtitle", "time": 4476.449, "timestamp": "01:14:36", "text": "取一些M1棒。"}, {"type": "subtitle", "time": 4479.744, "timestamp": "01:14:39", "text": "真他媽糟透了。"}, {"type": "subtitle", "time": 4480.513, "timestamp": "01:14:40", "text": "狙擊手"}, {"type": "subtitle", "time": 4481.182, "timestamp": "01:14:41", "text": "步槍。"}, {"type": "subtitle", "time": 4484.14, "timestamp": "01:14:44", "text": "哦，是的，這真是個好主意。"}, {"type": "subtitle", "time": 4486.968, "timestamp": "01:14:46", "text":
[{"type": "subtitle", "time": 1380.414, "timestamp": "00:23:00", "text": "他在哪裡？還沒到那一步。"}, {"type": "subtitle", "time": 1387.696, "timestamp": "00:23:07", "text": "我們走吧。他離開了。"}, {"type": "subtitle", "time": 1389.513, "timestamp": "00:23:09", "text": "樓上？該死的。"}, {"type": "subtitle", "time": 1390.711, "timestamp": "00:23:10", "text": "給我一分鐘時間。"}, {"type": "subtitle", "time": 1392.64, "timestamp": "00:23:12", "text": "看看那裡有什麼"}, {"type": "subtitle", "time": 1393.16, "timestamp": "00:23:13", "text": "多於。"}, {"type": "subtitle", "time": 1394.388, "timestamp": "00:23:14", "text": "到此為止。"}, {"type": "subtitle", "time": 1396.493, "timestamp": "00:23:16", "text": "那裡有個女人。"}, {"type": "subtitle", "time": 1400.351, "timestamp": "00:23:20", "text": "它"}, {"type": "subtitle", "time": 1403.106, "timestamp": "00:23:23", "text": "罪犯殺人犯？"}, {"type": "subtitle", "time": 1409.499, "timestamp": "00:23:29", "text": "就像連環殺手一樣。"}, {"type": "subtitle", "time": 1412.491, "timestamp": "00:23:32", "text": "不完全是。簡單地"}, {"type": "subtitle", "time": 1413.74, "timestamp": "00:23:33", "text": "偏心。不用擔心。"}, {"type": "subtitle", "time": 1414.364, "timestamp": "00:23:34", "text": "關於他。"}, {"type": "subtitle", "time": 1415.661, "timestamp": "00:23:35", "text": "哇。"}, {"type": "subtitle", "time": 1417.524, "timestamp": "00:23:37", "text": "在，"}, {"type": "subtitle", "time": 1420.601, "timestamp": "00:23:40", "text": "在哪裡？傑克，為什麼？"}, {"type": "subtitle", "time": 1425.203, "timestamp": "00:23:45", "text": "為什麼在我面前？我"}, {"type": "subtitle", "time": 1426.649, "timestamp": "00:23:46", "text": "我正在製造燈光和噪音。"}, {"type": "subtitle", "time": 1428.088, "timestamp": "00:23:48", "text": "為什麼站在最前面？"}, {"type": "subtitle", "time": 1428.45, "timestamp": "00:23:48", "text": "我？"}, {"type": "subtitle", "time": 1438.597, "timestamp": "00:23:58", "text": "好了，有一個在逃。 。我們至少應該"}]
[{"type": "subtitle", "time": 1440.546, "timestamp": "00:24:00", "text": "。我們至少應該 環顧四周。"}, {"type": "subtitle", "time": 1451.25, "timestamp": "00:24:11", "text": "這是老闆的音樂嗎？"}, {"type": "subtitle", "time": 1454.454, "timestamp": "00:24:14", "text": "這是你的音樂。"}, {"type": "subtitle", "time": 1455.996, "timestamp": "00:24:15", "text": "電壓。沒關係。"}, {"type": "subtitle", "time": 1456.22, "timestamp": "00:24:16", "text": "它。"}, {"type": "subtitle", "time": 1474.03, "timestamp": "00:24:34", "text": "沒有什麼。快點。"}, {"type": "subtitle", "time": 1475.255, "timestamp": "00:24:35", "text": "我們把它們全部關掉。"}, {"type": "subtitle", "time": 1476.877, "timestamp": "00:24:36", "text": "哦，那邊的門關著。"}, {"type": "subtitle", "time": 1480.897, "timestamp": "00:24:40", "text": "哦，對了，我要去"}, {"type": "subtitle", "time": 1482.702, "timestamp": "00:24:42", "text": "我要走了，該死，喔不。"}, {"type": "subtitle", "time": 1485.323, "timestamp": "00:24:45", "text": "不，不"}, {"type": "subtitle", "time": 1488.472, "timestamp": "00:24:48", "text": "直接炸掉就行了。"}, {"type": "subtitle", "time": 1493.837, "timestamp": "00:24:53", "text": "有什麼區別？那裡"}, {"type": "subtitle", "time": 1495.598, "timestamp": "00:24:55", "text": "有人在逃。我不是"}, {"type": "subtitle", "time": 1499.724, "timestamp": "00:24:59", "text": "我想。舉手。"}]
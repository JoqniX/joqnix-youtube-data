[{"type": "subtitle", "time": 5640.973, "timestamp": "01:34:00", "text": "合作，以及我 我終於可以補充了"}, {"type": "subtitle", "time": 5642.262, "timestamp": "01:34:02", "text": "我終於可以補充了 合作夥伴，"}, {"type": "subtitle", "time": 5642.959, "timestamp": "01:34:02", "text": "合作夥伴， 合作者，以及這"}, {"type": "subtitle", "time": 5644.212, "timestamp": "01:34:04", "text": "合作者，以及這 將會出現在 Discord 中"}, {"type": "subtitle", "time": 5645.536, "timestamp": "01:34:05", "text": "將會出現在 Discord 中 以及其他地方。非常"}, {"type": "subtitle", "time": 5651.461, "timestamp": "01:34:11", "text": "以及其他地方。非常 很酷的科技東西"}, {"type": "subtitle", "time": 5652.776, "timestamp": "01:34:12", "text": "很酷的科技東西 事物。我花了"}, {"type": "subtitle", "time": 5655.603, "timestamp": "01:34:15", "text": "事物。我花了 雖然早該如此，但沒錯。"}, {"type": "subtitle", "time": 5660.683, "timestamp": "01:34:20", "text": "這是一件小事，我"}, {"type": "subtitle", "time": 5664.045, "timestamp": "01:34:24", "text": "做過。明天我不會"}, {"type": "subtitle", "time": 5670.175, "timestamp": "01:34:30", "text": "我知道，我只是"}, {"type": "subtitle", "time": 5671.439, "timestamp": "01:34:31", "text": "我會直播和打字"}, {"type": "subtitle", "time": 5672.571, "timestamp": "01:34:32", "text": "我會給你看看這個東西"}, {"type": "subtitle", "time": 5673.603, "timestamp": "01:34:33", "text": "運動會。"}, {"type": "subtitle", "time": 5678.663, "timestamp": "01:34:38", "text": "事實證明，"}, {"type": "subtitle", "time": 5679.797, "timestamp": "01:34:39", "text": "今天就在附近"}, {"type": "subtitle", "time": 5680.867, "timestamp": "01:34:40", "text": "節日之類的"}, {"type": "subtitle", "time": 5682.001, "timestamp": "01:34:42", "text": "差不多是這樣，但我之前並不知道。"}, {"type": "subtitle", "time": 5687.039, "timestamp": "01:34:47", "text": "在最後一刻。我"}, {"type": "subtitle", "time": 5688.414, "timestamp": "01:34:48", "text": "錯失了機會。"}, {"type": "subtitle", "time": 5690.771, "timestamp": "01:34:50", "text": "但沒關係。問候。在"}, {"type": "subtitle", "time": 5691.627, "timestamp": "01:34:51", "text": "總之"}, {"type": "subtitle", "time": 5692.78, "timestamp": "01:34:52", "text": "下一期節目將是"}, {"type": "subtitle", "time": 5694.0, "timestamp": "01:34:54", "text": "明天。我會通知。"}, {"type": "subtitle", "time": 5695.043, "timestamp": "01:34:55", "text": "你在社群媒體上"}, {"type": "subtitle", "time": 5697.135, "timestamp": "01:34:57", "text": "網路。儘管溪流"}, {"type": "subtitle", "time": 5697.967, "timestamp": "01:34:57", "text": "今天是"}, {"type": "subtitle", "time": 5699.179, "timestamp": "01:34:59", "text": "總之，謝謝你。"}]
[{"type": "subtitle", "time": 1622.556, "timestamp": "00:27:02", "text": "これは学習マップです。それ"}, {"type": "subtitle", "time": 1623.95, "timestamp": "00:27:03", "text": "いや、そうでもないけど、それでも"}, {"type": "subtitle", "time": 1625.059, "timestamp": "00:27:05", "text": "彼女に電話したい"}, {"type": "subtitle", "time": 1626.203, "timestamp": "00:27:06", "text": "教育的であるため、"}, {"type": "subtitle", "time": 1627.026, "timestamp": "00:27:07", "text": "最もシンプルな"}, {"type": "subtitle", "time": 1635.79, "timestamp": "00:27:15", "text": "地図、より簡単"}, {"type": "subtitle", "time": 1639.137, "timestamp": "00:27:19", "text": "どこにもない。そのようなタイプが存在する"}, {"type": "subtitle", "time": 1641.641, "timestamp": "00:27:21", "text": "地図。その店は"}, {"type": "subtitle", "time": 1643.132, "timestamp": "00:27:23", "text": "同じだが、より複雑で、"}, {"type": "subtitle", "time": 1644.473, "timestamp": "00:27:24", "text": "たくさんの部屋と物"}, {"type": "subtitle", "time": 1648.025, "timestamp": "00:27:28", "text": "他の。私はまだ"}, {"type": "subtitle", "time": 1649.184, "timestamp": "00:27:29", "text": "同じ男、"}, {"type": "subtitle", "time": 1650.342, "timestamp": "00:27:30", "text": "でも私はもっと小さいものが欲しい"}, {"type": "subtitle", "time": 1651.467, "timestamp": "00:27:31", "text": "友人としては致命的"}, {"type": "subtitle", "time": 1651.876, "timestamp": "00:27:31", "text": "兵器。"}, {"type": "subtitle", "time": 1660.081, "timestamp": "00:27:40", "text": "だから私たちはその道を選ぶ"}, {"type": "subtitle", "time": 1661.89, "timestamp": "00:27:41", "text": "ガンジー。すべて順調です。"}, {"type": "subtitle", "time": 1673.414, "timestamp": "00:27:53", "text": "はい、必要です。"}, {"type": "subtitle", "time": 1674.537, "timestamp": "00:27:54", "text": "もっと胡椒"}, {"type": "subtitle", "time": 1675.835, "timestamp": "00:27:55", "text": "スプレー缶、だって私は"}]
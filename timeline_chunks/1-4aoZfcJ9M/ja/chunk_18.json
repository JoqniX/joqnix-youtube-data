[{"type": "subtitle", "time": 1082.67, "timestamp": "00:18:02", "text": "あなたが持っている。はい。あなたが持っている"}, {"type": "subtitle", "time": 1086.91, "timestamp": "00:18:06", "text": "タイプ198。簡単に言うと、"}, {"type": "subtitle", "time": 1088.382, "timestamp": "00:18:08", "text": "ジャックさん、押してください 準備完了。心配しないで。"}, {"type": "subtitle", "time": 1089.868, "timestamp": "00:18:09", "text": "準備完了。心配しないで。 これについて。"}, {"type": "subtitle", "time": 1095.829, "timestamp": "00:18:15", "text": "さあ、中に入ろう。"}, {"type": "subtitle", "time": 1098.259, "timestamp": "00:18:18", "text": "ゲームに参加する。私たちはできません"}, {"type": "subtitle", "time": 1099.491, "timestamp": "00:18:19", "text": "この瞬間を失うこと。"}, {"type": "subtitle", "time": 1102.698, "timestamp": "00:18:22", "text": "はい、準備はできました。"}, {"type": "subtitle", "time": 1104.288, "timestamp": "00:18:24", "text": "少し時間をください。与える"}, {"type": "subtitle", "time": 1105.181, "timestamp": "00:18:25", "text": "手を洗います。"}, {"type": "subtitle", "time": 1119.847, "timestamp": "00:18:39", "text": "よし、行こう。自分"}, {"type": "subtitle", "time": 1121.151, "timestamp": "00:18:41", "text": "私は彼のそういうところが好きだ。"}, {"type": "subtitle", "time": 1127.753, "timestamp": "00:18:47", "text": "くそっ、俺め。"}, {"type": "subtitle", "time": 1129.337, "timestamp": "00:18:49", "text": "私は彼のそういうところが好きだ。"}, {"type": "subtitle", "time": 1131.049, "timestamp": "00:18:51", "text": "くそっ、彼はAK-47を持っている"}, {"type": "subtitle", "time": 1133.459, "timestamp": "00:18:53", "text": "特殊部隊において。悪魔"}, {"type": "subtitle", "time": 1134.635, "timestamp": "00:18:54", "text": "ジャック、それを受け取れ。"}, {"type": "subtitle", "time": 1136.265, "timestamp": "00:18:56", "text": "少なくとも何か一つは持って行ってください。"}, {"type": "subtitle", "time": 1137.756, "timestamp": "00:18:57", "text": "非致死性。何てことだ。"}]
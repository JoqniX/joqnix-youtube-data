[{"type": "subtitle", "time": 1148.752, "timestamp": "00:19:08", "text": "はい、戻ってきました。"}, {"type": "subtitle", "time": 1150.769, "timestamp": "00:19:10", "text": "おかえり。"}, {"type": "subtitle", "time": 1152.442, "timestamp": "00:19:12", "text": "要するに、ジェイは、"}, {"type": "subtitle", "time": 1153.818, "timestamp": "00:19:13", "text": "二階へ上がってください。"}, {"type": "subtitle", "time": 1155.366, "timestamp": "00:19:15", "text": "ここは少し危険だ。"}, {"type": "subtitle", "time": 1156.96, "timestamp": "00:19:16", "text": "あなたのために。私には合わない。"}, {"type": "subtitle", "time": 1158.444, "timestamp": "00:19:18", "text": "あなただけのために。行く"}, {"type": "subtitle", "time": 1158.882, "timestamp": "00:19:18", "text": "ここ。"}, {"type": "subtitle", "time": 1161.048, "timestamp": "00:19:21", "text": "私は理解しました、"}, {"type": "subtitle", "time": 1168.282, "timestamp": "00:19:28", "text": "ジャック。今日はハロウィンだ。"}, {"type": "subtitle", "time": 1170.934, "timestamp": "00:19:30", "text": "ああ、今日はハロウィンだ。"}, {"type": "subtitle", "time": 1174.501, "timestamp": "00:19:34", "text": "パンプキン。あ、待って。あなた"}, {"type": "subtitle", "time": 1175.691, "timestamp": "00:19:35", "text": "狙いを定めることすらできないのか？"}, {"type": "subtitle", "time": 1180.842, "timestamp": "00:19:40", "text": "可能だとは思うが、私は"}, {"type": "subtitle", "time": 1182.31, "timestamp": "00:19:42", "text": "知っている。これまでになかった"}, {"type": "subtitle", "time": 1183.209, "timestamp": "00:19:43", "text": "それはしなかった。"}, {"type": "subtitle", "time": 1193.031, "timestamp": "00:19:53", "text": "これは愛好家の集まりです。"}, {"type": "subtitle", "time": 1194.007, "timestamp": "00:19:54", "text": "私たちは家にいて"}, {"type": "subtitle", "time": 1195.094, "timestamp": "00:19:55", "text": "私たちは前進を続ける。"}, {"type": "subtitle", "time": 1196.972, "timestamp": "00:19:56", "text": "はい、走っています。来て。"}, {"type": "subtitle", "time": 1198.243, "timestamp": "00:19:58", "text": "注意して進めてください。"}]
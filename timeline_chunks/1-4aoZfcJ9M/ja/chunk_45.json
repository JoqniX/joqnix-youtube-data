[{"type": "subtitle", "time": 2701.457, "timestamp": "00:45:01", "text": "私の。彼は正しかった… まあ、簡単に言うと。良い。"}, {"type": "subtitle", "time": 2702.988, "timestamp": "00:45:02", "text": "まあ、簡単に言うと。良い。 こっちへ来い、ジャック。行く"}, {"type": "subtitle", "time": 2704.585, "timestamp": "00:45:04", "text": "こっちへ来い、ジャック。行く 私の後ろに。"}, {"type": "subtitle", "time": 2705.311, "timestamp": "00:45:05", "text": "私の後ろに。 君には行ってほしい。"}, {"type": "subtitle", "time": 2706.539, "timestamp": "00:45:06", "text": "君には行ってほしい。 私の前にいる。"}, {"type": "subtitle", "time": 2707.788, "timestamp": "00:45:07", "text": "私の前にいる。 良い。"}, {"type": "subtitle", "time": 2711.695, "timestamp": "00:45:11", "text": "わかりました。"}, {"type": "subtitle", "time": 2720.571, "timestamp": "00:45:20", "text": "良い。私は行くよ…"}, {"type": "subtitle", "time": 2721.833, "timestamp": "00:45:21", "text": "インストールします"}, {"type": "subtitle", "time": 2722.829, "timestamp": "00:45:22", "text": "ここで充電できます。"}, {"type": "subtitle", "time": 2724.812, "timestamp": "00:45:24", "text": "理由を知っていますか？なぜならその背後には"}, {"type": "subtitle", "time": 2725.891, "timestamp": "00:45:25", "text": "呪われているかもしれない"}, {"type": "subtitle", "time": 2726.349, "timestamp": "00:45:26", "text": "みんな。"}, {"type": "subtitle", "time": 2728.716, "timestamp": "00:45:28", "text": "良い。私がやります。"}, {"type": "subtitle", "time": 2732.227, "timestamp": "00:45:32", "text": "充電。 3、2、1。バッハ。そこには"}, {"type": "subtitle", "time": 2733.438, "timestamp": "00:45:33", "text": "これからはうるさくなるよ。"}, {"type": "subtitle", "time": 2739.338, "timestamp": "00:45:39", "text": "地上で。両手を上げて"}, {"type": "subtitle", "time": 2741.126, "timestamp": "00:45:41", "text": "地上で。地上で。"}, {"type": "subtitle", "time": 2743.594, "timestamp": "00:45:43", "text": "手を"}, {"type": "subtitle", "time": 2744.845, "timestamp": "00:45:44", "text": "床に。"}, {"type": "subtitle", "time": 2749.25, "timestamp": "00:45:49", "text": "はい。接触はあった。二"}, {"type": "subtitle", "time": 2749.739, "timestamp": "00:45:49", "text": "人々。"}, {"type": "subtitle", "time": 2751.725, "timestamp": "00:45:51", "text": "掴め。掴んで"}, {"type": "subtitle", "time": 2752.831, "timestamp": "00:45:52", "text": "その。掴め。"}, {"type": "subtitle", "time": 2754.129, "timestamp": "00:45:54", "text": "手錠。手錠。"}, {"type": "subtitle", "time": 2756.429, "timestamp": "00:45:56", "text": "それらは今や無駄になった。"}, {"type": "subtitle", "time": 2757.559, "timestamp": "00:45:57", "text": "時間を無駄にしている。もし"}, {"type": "subtitle", "time": 2758.692, "timestamp": "00:45:58", "text": "彼らは立ち上がるだろう、彼らは"}, {"type": "subtitle", "time": 2759.385, "timestamp": "00:45:59", "text": "彼らはあなたを殺すでしょう。"}]
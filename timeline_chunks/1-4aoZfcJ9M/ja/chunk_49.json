[{"type": "subtitle", "time": 2942.042, "timestamp": "00:49:02", "text": "証拠は一つしかない。"}, {"type": "subtitle", "time": 2944.197, "timestamp": "00:49:04", "text": "警察はみんなに嘘をついている！"}, {"type": "subtitle", "time": 2949.234, "timestamp": "00:49:09", "text": "あの男は"}, {"type": "subtitle", "time": 2950.517, "timestamp": "00:49:10", "text": "走っているように言った"}, {"type": "subtitle", "time": 2951.653, "timestamp": "00:49:11", "text": "本社に戻る、それだけだ"}, {"type": "subtitle", "time": 2953.046, "timestamp": "00:49:13", "text": "準備完了、さて、次は何をしようか？"}, {"type": "subtitle", "time": 2953.303, "timestamp": "00:49:13", "text": "ここ"}, {"type": "subtitle", "time": 2958.173, "timestamp": "00:49:18", "text": "私たちは何をしているのでしょうか？私は、本当に"}, {"type": "subtitle", "time": 2959.432, "timestamp": "00:49:19", "text": "わからない。私はこんな感じです"}, {"type": "subtitle", "time": 2960.335, "timestamp": "00:49:20", "text": "混乱した。"}, {"type": "subtitle", "time": 2964.296, "timestamp": "00:49:24", "text": "私も。私は混乱しています。"}, {"type": "subtitle", "time": 2973.119, "timestamp": "00:49:33", "text": "1秒。ええと、"}, {"type": "subtitle", "time": 2978.988, "timestamp": "00:49:38", "text": "心配しないで。単に、"}, {"type": "subtitle", "time": 2980.01, "timestamp": "00:49:40", "text": "ただ見ているだけです。"}, {"type": "subtitle", "time": 2982.104, "timestamp": "00:49:42", "text": "私はまだ見ています。"}, {"type": "subtitle", "time": 2983.189, "timestamp": "00:49:43", "text": "ただ見ているだけです。"}, {"type": "subtitle", "time": 2987.745, "timestamp": "00:49:47", "text": "降ろしてあげるよ。"}, {"type": "subtitle", "time": 2991.8, "timestamp": "00:49:51", "text": "ご挨拶申し上げます。お元気ですか？"}]
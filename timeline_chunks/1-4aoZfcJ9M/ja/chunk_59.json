[{"type": "subtitle", "time": 3540.294, "timestamp": "00:59:00", "text": "彼はどうですか、彼はどうですか"}, {"type": "subtitle", "time": 3541.446, "timestamp": "00:59:01", "text": "ここまで来たの？"}, {"type": "subtitle", "time": 3546.77, "timestamp": "00:59:06", "text": "私は自分の限界まで走りました"}, {"type": "subtitle", "time": 3549.855, "timestamp": "00:59:09", "text": "力。何かあげよう、"}, {"type": "subtitle", "time": 3550.187, "timestamp": "00:59:10", "text": "それ"}, {"type": "subtitle", "time": 3552.203, "timestamp": "00:59:12", "text": "待って、あなたはそれを報告したのよ。"}, {"type": "subtitle", "time": 3552.651, "timestamp": "00:59:12", "text": "兵器？"}, {"type": "subtitle", "time": 3555.578, "timestamp": "00:59:15", "text": "ああ、全部やってください。"}, {"type": "subtitle", "time": 3557.765, "timestamp": "00:59:17", "text": "私は何もしていません。"}, {"type": "subtitle", "time": 3559.627, "timestamp": "00:59:19", "text": "何？見当たりません。"}, {"type": "subtitle", "time": 3560.11, "timestamp": "00:59:20", "text": "兵器。"}, {"type": "subtitle", "time": 3560.749, "timestamp": "00:59:20", "text": "負けました"}, {"type": "subtitle", "time": 3562.018, "timestamp": "00:59:22", "text": "容疑者を発見。"}, {"type": "subtitle", "time": 3563.514, "timestamp": "00:59:23", "text": "ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 3566.148, "timestamp": "00:59:26", "text": "待って、"}, {"type": "subtitle", "time": 3574.786, "timestamp": "00:59:34", "text": "こちらはシエラです。"}, {"type": "subtitle", "time": 3576.092, "timestamp": "00:59:36", "text": "容疑者は立ち去った"}, {"type": "subtitle", "time": 3577.237, "timestamp": "00:59:37", "text": "トイレ。"}, {"type": "subtitle", "time": 3578.619, "timestamp": "00:59:38", "text": "反対側、反対側"}, {"type": "subtitle", "time": 3579.08, "timestamp": "00:59:39", "text": "レベル。"}, {"type": "subtitle", "time": 3581.246, "timestamp": "00:59:41", "text": "良い、"}, {"type": "subtitle", "time": 3584.027, "timestamp": "00:59:44", "text": "これを片付けましょう"}, {"type": "subtitle", "time": 3584.593, "timestamp": "00:59:44", "text": "部屋。"}, {"type": "subtitle", "time": 3590.5, "timestamp": "00:59:50", "text": "はい、実際には"}, {"type": "subtitle", "time": 3591.012, "timestamp": "00:59:51", "text": "誰でもない。"}, {"type": "subtitle", "time": 3593.907, "timestamp": "00:59:53", "text": "いいえ、そこには入らないでください。"}, {"type": "subtitle", "time": 3594.842, "timestamp": "00:59:54", "text": "部屋。そこには"}, {"type": "subtitle", "time": 3595.644, "timestamp": "00:59:55", "text": "巨大な"}]
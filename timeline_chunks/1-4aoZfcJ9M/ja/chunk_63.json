[{"type": "subtitle", "time": 3780.952, "timestamp": "01:03:00", "text": "すべて順調です。あなたが持っている"}, {"type": "subtitle", "time": 3782.248, "timestamp": "01:03:02", "text": "彼らに何度か怒鳴る"}, {"type": "subtitle", "time": 3783.155, "timestamp": "01:03:03", "text": "以前に"}, {"type": "subtitle", "time": 3783.966, "timestamp": "01:03:03", "text": "人を殺す。"}, {"type": "subtitle", "time": 3786.321, "timestamp": "01:03:06", "text": "そして、"}, {"type": "subtitle", "time": 3788.851, "timestamp": "01:03:08", "text": "良い。"}, {"type": "subtitle", "time": 3790.884, "timestamp": "01:03:10", "text": "了解、了解。ジョシュ、"}, {"type": "subtitle", "time": 3792.144, "timestamp": "01:03:12", "text": "私たちはすでに掃除しました"}, {"type": "subtitle", "time": 3793.02, "timestamp": "01:03:13", "text": "メインホール。"}, {"type": "subtitle", "time": 3801.962, "timestamp": "01:03:21", "text": "ああ、ここに男の人がいる。"}, {"type": "subtitle", "time": 3807.192, "timestamp": "01:03:27", "text": "殺さずに清掃する。"}, {"type": "subtitle", "time": 3808.468, "timestamp": "01:03:28", "text": "2階。"}, {"type": "subtitle", "time": 3817.461, "timestamp": "01:03:37", "text": "あなたはここに残りますか？"}, {"type": "subtitle", "time": 3818.343, "timestamp": "01:03:38", "text": "別れましょうか？"}, {"type": "subtitle", "time": 3821.809, "timestamp": "01:03:41", "text": "はい、私は前に進みます。"}, {"type": "subtitle", "time": 3825.068, "timestamp": "01:03:45", "text": "2階。"}, {"type": "subtitle", "time": 3836.866, "timestamp": "01:03:56", "text": "フィールドゴールを逃した"}, {"type": "subtitle", "time": 3837.241, "timestamp": "01:03:57", "text": "ビジョン。"}]
[{"type": "subtitle", "time": 661.649, "timestamp": "00:11:01", "text": "どのファイルを開きましたか？"}, {"type": "subtitle", "time": 664.385, "timestamp": "00:11:04", "text": "何が起こっている？"}, {"type": "subtitle", "time": 670.689, "timestamp": "00:11:10", "text": "ああ、あのバッチファイル、"}, {"type": "subtitle", "time": 677.741, "timestamp": "00:11:17", "text": "アイコン付きでSEFを起動しない"}, {"type": "subtitle", "time": 682.059, "timestamp": "00:11:22", "text": "コマンドパネル。それ"}, {"type": "subtitle", "time": 683.438, "timestamp": "00:11:23", "text": "バッチファイル自体。"}, {"type": "subtitle", "time": 687.328, "timestamp": "00:11:27", "text": "ええと、バッチファイルです。何"}, {"type": "subtitle", "time": 689.78, "timestamp": "00:11:29", "text": "つまりそういうことですか？ LaCF.exe 。"}, {"type": "subtitle", "time": 693.234, "timestamp": "00:11:33", "text": "はい。はい。始めないでください。"}, {"type": "subtitle", "time": 695.432, "timestamp": "00:11:35", "text": ".exeファイル。打ち上げ"}, {"type": "subtitle", "time": 698.052, "timestamp": "00:11:38", "text": "バッチファイル。 .exeではありません。"}, {"type": "subtitle", "time": 699.716, "timestamp": "00:11:39", "text": "A. わかりました。わかりました。私の"}, {"type": "subtitle", "time": 701.326, "timestamp": "00:11:41", "text": "エラー。ああ、私は"}, {"type": "subtitle", "time": 702.46, "timestamp": "00:11:42", "text": "その。ああ、これ"}, {"type": "subtitle", "time": 703.645, "timestamp": "00:11:43", "text": "心配しないで。ない"}, {"type": "subtitle", "time": 705.247, "timestamp": "00:11:45", "text": "心配。彼らは"}, {"type": "subtitle", "time": 706.393, "timestamp": "00:11:46", "text": "ほとんど"}, {"type": "subtitle", "time": 709.641, "timestamp": "00:11:49", "text": "同様に。すべて順調です。私"}, {"type": "subtitle", "time": 711.225, "timestamp": "00:11:51", "text": ".bat を実行してもいいですか？"}, {"type": "subtitle", "time": 713.131, "timestamp": "00:11:53", "text": "ファイル。どうぞ、こちらへ。"}, {"type": "subtitle", "time": 719.259, "timestamp": "00:11:59", "text": "ご心配なく。で、"}]
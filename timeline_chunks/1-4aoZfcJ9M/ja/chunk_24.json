[{"type": "subtitle", "time": 1440.546, "timestamp": "00:24:00", "text": "。少なくとも 辺り一帯を見回す。"}, {"type": "subtitle", "time": 1451.25, "timestamp": "00:24:11", "text": "これは社長の好きな音楽ですか？"}, {"type": "subtitle", "time": 1454.454, "timestamp": "00:24:14", "text": "これはあなたの音楽です。"}, {"type": "subtitle", "time": 1455.996, "timestamp": "00:24:15", "text": "電圧。どうでも。"}, {"type": "subtitle", "time": 1456.22, "timestamp": "00:24:16", "text": "それ。"}, {"type": "subtitle", "time": 1474.03, "timestamp": "00:24:34", "text": "何もない。さあ、行こう。"}, {"type": "subtitle", "time": 1475.255, "timestamp": "00:24:35", "text": "全部閉じましょう。"}, {"type": "subtitle", "time": 1476.877, "timestamp": "00:24:36", "text": "ああ、あそこのドアは閉まっている。"}, {"type": "subtitle", "time": 1480.897, "timestamp": "00:24:40", "text": "あ、そういえば、"}, {"type": "subtitle", "time": 1482.702, "timestamp": "00:24:42", "text": "行くよ、ああ、いやだ。"}, {"type": "subtitle", "time": 1485.323, "timestamp": "00:24:45", "text": "いいえ、いいえ"}, {"type": "subtitle", "time": 1488.472, "timestamp": "00:24:48", "text": "爆破してしまえ。"}, {"type": "subtitle", "time": 1493.837, "timestamp": "00:24:53", "text": "違いは何ですか？そこには"}, {"type": "subtitle", "time": 1495.598, "timestamp": "00:24:55", "text": "誰かが逃走中だ。私はそうではない"}, {"type": "subtitle", "time": 1499.724, "timestamp": "00:24:59", "text": "欲しい。手を挙げて。"}]
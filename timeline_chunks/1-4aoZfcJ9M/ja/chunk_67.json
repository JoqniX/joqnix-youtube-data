[{"type": "subtitle", "time": 4021.087, "timestamp": "01:07:01", "text": "私がそうしない理由は"}, {"type": "subtitle", "time": 4022.44, "timestamp": "01:07:02", "text": "私はCSを使っているので"}, {"type": "subtitle", "time": 4023.259, "timestamp": "01:07:03", "text": "こいつらは一体何者だ？"}, {"type": "subtitle", "time": 4023.936, "timestamp": "01:07:03", "text": "主に"}, {"type": "subtitle", "time": 4025.037, "timestamp": "01:07:05", "text": "申し訳ありませんでした。"}, {"type": "subtitle", "time": 4028.942, "timestamp": "01:07:08", "text": "えっと、マスク、マスク。"}, {"type": "subtitle", "time": 4031.002, "timestamp": "01:07:11", "text": "私は"}, {"type": "subtitle", "time": 4031.728, "timestamp": "01:07:11", "text": "射撃手。"}, {"type": "subtitle", "time": 4033.391, "timestamp": "01:07:13", "text": "はい、必要です。"}, {"type": "subtitle", "time": 4034.771, "timestamp": "01:07:14", "text": "機械。私は必要としている"}, {"type": "subtitle", "time": 4036.044, "timestamp": "01:07:16", "text": "戻る"}, {"type": "subtitle", "time": 4036.987, "timestamp": "01:07:16", "text": "クリエイター。はい。"}, {"type": "subtitle", "time": 4040.938, "timestamp": "01:07:20", "text": "あ、そういえば、私たちの「生き物たち」"}, {"type": "subtitle", "time": 4042.566, "timestamp": "01:07:22", "text": "無料で"}, {"type": "subtitle", "time": 4045.353, "timestamp": "01:07:25", "text": "はい。はい。週末だった。"}, {"type": "subtitle", "time": 4046.46, "timestamp": "01:07:26", "text": "無料ゲーム"}, {"type": "subtitle", "time": 4047.531, "timestamp": "01:07:27", "text": "なぜなら多くの人が"}, {"type": "subtitle", "time": 4048.92, "timestamp": "01:07:28", "text": "楽しいと彼らは言うし"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "それら全て。"}, {"type": "subtitle", "time": 4050.737, "timestamp": "01:07:30", "text": "これは楽しい、"}, {"type": "subtitle", "time": 4052.994, "timestamp": "01:07:32", "text": "でも、私は"}, {"type": "subtitle", "time": 4054.922, "timestamp": "01:07:34", "text": "プレイすることができました。私"}, {"type": "subtitle", "time": 4056.435, "timestamp": "01:07:36", "text": "プレイできませんでした。"}, {"type": "subtitle", "time": 4059.157, "timestamp": "01:07:39", "text": "わからない。わからない。"}, {"type": "subtitle", "time": 4060.572, "timestamp": "01:07:40", "text": "これは"}, {"type": "subtitle", "time": 4062.058, "timestamp": "01:07:42", "text": "Destiny 2を思い出す。"}, {"type": "subtitle", "time": 4064.416, "timestamp": "01:07:44", "text": "そんなゲームでは"}, {"type": "subtitle", "time": 4065.515, "timestamp": "01:07:45", "text": "ひたすら努力する。"}, {"type": "subtitle", "time": 4068.077, "timestamp": "01:07:48", "text": "はい、これは抽出です。 シューター。"}, {"type": "subtitle", "time": 4071.293, "timestamp": "01:07:51", "text": "ウェットティッシュとか、何でも揃っていますよ。"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "このような。"}, {"type": "subtitle", "time": 4073.738, "timestamp": "01:07:53", "text": "非常に、非常に迷惑です"}, {"type": "subtitle", "time": 4075.59, "timestamp": "01:07:55", "text": "ゲーム。そして私はこんな感じです。"}, {"type": "subtitle", "time": 4078.322, "timestamp": "01:07:58", "text": "速そうですね。"}, {"type": "subtitle", "time": 4079.906, "timestamp": "01:07:59", "text": "私は戻りたくない。 。"}]
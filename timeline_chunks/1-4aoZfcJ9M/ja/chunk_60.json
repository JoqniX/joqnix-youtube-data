[{"type": "subtitle", "time": 3604.505, "timestamp": "01:00:04", "text": "ちなみに、大声を出さないでくださいね。"}, {"type": "subtitle", "time": 3605.221, "timestamp": "01:00:05", "text": "よくやった。"}, {"type": "subtitle", "time": 3613.471, "timestamp": "01:00:13", "text": "我が神よ。"}, {"type": "subtitle", "time": 3627.433, "timestamp": "01:00:27", "text": "なぜ彼はそうしないのですか？"}, {"type": "subtitle", "time": 3630.779, "timestamp": "01:00:30", "text": "ここ？彼は準備万端だ。"}, {"type": "subtitle", "time": 3632.967, "timestamp": "01:00:32", "text": "両方見てください。"}, {"type": "subtitle", "time": 3634.819, "timestamp": "01:00:34", "text": "建物。"}, {"type": "subtitle", "time": 3642.955, "timestamp": "01:00:42", "text": "彼は魅力的だ。彼らは"}, {"type": "subtitle", "time": 3644.28, "timestamp": "01:00:44", "text": "証拠を取り上げられた"}, {"type": "subtitle", "time": 3644.817, "timestamp": "01:00:44", "text": "等々。"}, {"type": "subtitle", "time": 3652.76, "timestamp": "01:00:52", "text": "どこにいるの？"}, {"type": "subtitle", "time": 3655.247, "timestamp": "01:00:55", "text": "私は女性用トイレにいます。"}, {"type": "subtitle", "time": 3655.871, "timestamp": "01:00:55", "text": "いいえ。"}, {"type": "subtitle", "time": 3657.68, "timestamp": "01:00:57", "text": "ああ、わかりました。ああ、助かった、"}, {"type": "subtitle", "time": 3659.121, "timestamp": "01:00:59", "text": "君はまだトイレの中にいる。全て"}, {"type": "subtitle", "time": 3659.716, "timestamp": "01:00:59", "text": "わかりました。"}]
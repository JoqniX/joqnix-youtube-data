[{"type": "subtitle", "time": 2282.734, "timestamp": "00:38:02", "text": "共有ストリーム。それで"}, {"type": "subtitle", "time": 2283.776, "timestamp": "00:38:03", "text": "これに取り組む"}, {"type": "subtitle", "time": 2285.02, "timestamp": "00:38:05", "text": "数日前と昨日"}, {"type": "subtitle", "time": 2285.626, "timestamp": "00:38:05", "text": "今日。"}, {"type": "subtitle", "time": 2287.225, "timestamp": "00:38:07", "text": "何が起こっている？"}, {"type": "subtitle", "time": 2288.578, "timestamp": "00:38:08", "text": "ただ話していただけです。"}, {"type": "subtitle", "time": 2290.389, "timestamp": "00:38:10", "text": "はい。はい。そうみたいです"}, {"type": "subtitle", "time": 2291.953, "timestamp": "00:38:11", "text": "私は追い出されたに違いない。"}, {"type": "subtitle", "time": 2293.842, "timestamp": "00:38:13", "text": "彼らは私を追い出した。"}, {"type": "subtitle", "time": 2296.321, "timestamp": "00:38:16", "text": "私はまだこのゲームに参加しているのだろうか？"}, {"type": "subtitle", "time": 2299.121, "timestamp": "00:38:19", "text": "君はまだゲームに参加している、"}, {"type": "subtitle", "time": 2299.584, "timestamp": "00:38:19", "text": "お前。"}, {"type": "subtitle", "time": 2301.194, "timestamp": "00:38:21", "text": "ああ、わかりました。それから"}, {"type": "subtitle", "time": 2302.76, "timestamp": "00:38:22", "text": "わかった。私は追い出されたわけではない。"}, {"type": "subtitle", "time": 2305.886, "timestamp": "00:38:25", "text": "わかった。あなたはまだここにいます、"}, {"type": "subtitle", "time": 2307.949, "timestamp": "00:38:27", "text": "もの。あなたはまだここにいて"}, {"type": "subtitle", "time": 2309.07, "timestamp": "00:38:29", "text": "ちなみに、準備はできています。"}, {"type": "subtitle", "time": 2310.506, "timestamp": "00:38:30", "text": "わかった。"}, {"type": "subtitle", "time": 2313.556, "timestamp": "00:38:33", "text": "それは良い。"}, {"type": "subtitle", "time": 2322.13, "timestamp": "00:38:42", "text": "もしあなたが追い出されたなら、"}, {"type": "subtitle", "time": 2323.047, "timestamp": "00:38:43", "text": "私はそうしなければならないだろう"}, {"type": "subtitle", "time": 2324.313, "timestamp": "00:38:44", "text": "サーバーを再起動します"}, {"type": "subtitle", "time": 2325.443, "timestamp": "00:38:45", "text": "あるいは、そんな感じ。で、"}, {"type": "subtitle", "time": 2326.107, "timestamp": "00:38:46", "text": "はい。"}, {"type": "subtitle", "time": 2329.159, "timestamp": "00:38:49", "text": "あなたはここにいると思います。ああ、君"}, {"type": "subtitle", "time": 2330.276, "timestamp": "00:38:50", "text": "ここ。あなたはここにいる。"}, {"type": "subtitle", "time": 2331.42, "timestamp": "00:38:51", "text": "はい、ここにいます。"}, {"type": "subtitle", "time": 2334.206, "timestamp": "00:38:54", "text": "あなたはここにいる。くそ。"}, {"type": "subtitle", "time": 2338.019, "timestamp": "00:38:58", "text": "はい、ここにいます。"}, {"type": "subtitle", "time": 2339.067, "timestamp": "00:38:59", "text": "行く"}]
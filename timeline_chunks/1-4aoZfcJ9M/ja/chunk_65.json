[{"type": "subtitle", "time": 3901.471, "timestamp": "01:05:01", "text": "はい。"}, {"type": "subtitle", "time": 3903.835, "timestamp": "01:05:03", "text": "それはナンセンスだ。"}, {"type": "subtitle", "time": 3906.103, "timestamp": "01:05:06", "text": "あなたはどれくらい強いですか？"}, {"type": "subtitle", "time": 3907.268, "timestamp": "01:05:07", "text": "標的を無力化したのか？"}, {"type": "subtitle", "time": 3909.582, "timestamp": "01:05:09", "text": "誰がショットガンを持っていたのか？"}, {"type": "subtitle", "time": 3911.151, "timestamp": "01:05:11", "text": "狂気。"}, {"type": "subtitle", "time": 3913.21, "timestamp": "01:05:13", "text": "単に"}, {"type": "subtitle", "time": 3914.308, "timestamp": "01:05:14", "text": "彼を撃て、"}, {"type": "subtitle", "time": 3915.518, "timestamp": "01:05:15", "text": "お前。準備完了"}, {"type": "subtitle", "time": 3919.172, "timestamp": "01:05:19", "text": "避難。ところで、"}, {"type": "subtitle", "time": 3920.461, "timestamp": "01:05:20", "text": "容疑者は"}, {"type": "subtitle", "time": 3921.701, "timestamp": "01:05:21", "text": "殺すことはできない。"}, {"type": "subtitle", "time": 3922.581, "timestamp": "01:05:22", "text": "殺す。それだけだ。"}, {"type": "subtitle", "time": 3925.519, "timestamp": "01:05:25", "text": "警官の避難。"}, {"type": "subtitle", "time": 3936.635, "timestamp": "01:05:36", "text": "再起動しますか？"}, {"type": "subtitle", "time": 3937.599, "timestamp": "01:05:37", "text": "ジャックさん？"}, {"type": "subtitle", "time": 3939.181, "timestamp": "01:05:39", "text": "元気です。私は"}, {"type": "subtitle", "time": 3939.925, "timestamp": "01:05:39", "text": "注文。"}, {"type": "subtitle", "time": 3945.032, "timestamp": "01:05:45", "text": "続く。警察、"}, {"type": "subtitle", "time": 3945.92, "timestamp": "01:05:45", "text": "武器を捨てろ。"}, {"type": "subtitle", "time": 3949.885, "timestamp": "01:05:49", "text": "警察官は武器を捨てろ。 。武器を捨てろ。"}, {"type": "subtitle", "time": 3951.539, "timestamp": "01:05:51", "text": "。武器を捨てろ。 うわ、すごい量だ。"}, {"type": "subtitle", "time": 3953.028, "timestamp": "01:05:53", "text": "うわ、すごい量だ。 人々。"}]
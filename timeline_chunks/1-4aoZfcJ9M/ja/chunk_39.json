[{"type": "subtitle", "time": 2340.27, "timestamp": "00:39:00", "text": "装備、それを持って行ってください"}, {"type": "subtitle", "time": 2341.505, "timestamp": "00:39:01", "text": "1つは致命的で、1つは"}, {"type": "subtitle", "time": 2342.642, "timestamp": "00:39:02", "text": "非致死性兵器と"}, {"type": "subtitle", "time": 2343.293, "timestamp": "00:39:03", "text": "それでは始めましょう。"}, {"type": "subtitle", "time": 2345.945, "timestamp": "00:39:05", "text": "私…私は2杯飲みました。"}, {"type": "subtitle", "time": 2346.716, "timestamp": "00:39:06", "text": "致死。"}, {"type": "subtitle", "time": 2348.666, "timestamp": "00:39:08", "text": "ええと。"}, {"type": "subtitle", "time": 2349.752, "timestamp": "00:39:09", "text": "ああ、致命的なものが一つと"}, {"type": "subtitle", "time": 2351.092, "timestamp": "00:39:11", "text": "非致死性のもの1つ。はい。"}, {"type": "subtitle", "time": 2352.649, "timestamp": "00:39:12", "text": "はい。はい。はい。はい。"}, {"type": "subtitle", "time": 2355.153, "timestamp": "00:39:15", "text": "了解、了解。短く、"}, {"type": "subtitle", "time": 2356.029, "timestamp": "00:39:16", "text": "常に選択する"}, {"type": "subtitle", "time": 2357.241, "timestamp": "00:39:17", "text": "非致死性兵器、そして"}, {"type": "subtitle", "time": 2358.386, "timestamp": "00:39:18", "text": "そして撃つ、"}, {"type": "subtitle", "time": 2359.464, "timestamp": "00:39:19", "text": "もし彼らがあなたを好きでなければ"}, {"type": "subtitle", "time": 2361.879, "timestamp": "00:39:21", "text": "聞いている。わかった、"}, {"type": "subtitle", "time": 2363.039, "timestamp": "00:39:23", "text": "ジャックさん、"}, {"type": "subtitle", "time": 2363.982, "timestamp": "00:39:23", "text": "それが何かわかりますか？"}, {"type": "subtitle", "time": 2364.925, "timestamp": "00:39:24", "text": "光ノイズ。"}, {"type": "subtitle", "time": 2367.439, "timestamp": "00:39:27", "text": "ええと、3つあります。"}, {"type": "subtitle", "time": 2368.466, "timestamp": "00:39:28", "text": "光ノイズ。"}, {"type": "subtitle", "time": 2369.71, "timestamp": "00:39:29", "text": "軽いノイズ。"}, {"type": "subtitle", "time": 2370.989, "timestamp": "00:39:30", "text": "はい、ご存知ですね"}, {"type": "subtitle", "time": 2373.446, "timestamp": "00:39:33", "text": "光ノイズ。ただ"}, {"type": "subtitle", "time": 2374.562, "timestamp": "00:39:34", "text": "ドアを開けると、"}, {"type": "subtitle", "time": 2375.714, "timestamp": "00:39:35", "text": "手榴弾を投げる"}, {"type": "subtitle", "time": 2378.369, "timestamp": "00:39:38", "text": "内で。いつもの"}, {"type": "subtitle", "time": 2379.768, "timestamp": "00:39:39", "text": "これが私の仕事です。しかし"}, {"type": "subtitle", "time": 2381.466, "timestamp": "00:39:41", "text": "掃除をすれば、"}, {"type": "subtitle", "time": 2382.003, "timestamp": "00:39:42", "text": "あなたが知っている、"}, {"type": "subtitle", "time": 2384.322, "timestamp": "00:39:44", "text": "はい、私を除いて、"}, {"type": "subtitle", "time": 2387.792, "timestamp": "00:39:47", "text": "君ならできるよ。"}, {"type": "subtitle", "time": 2391.079, "timestamp": "00:39:51", "text": "バリケード、状況"}, {"type": "subtitle", "time": 2391.979, "timestamp": "00:39:51", "text": "人質。"}, {"type": "subtitle", "time": 2396.033, "timestamp": "00:39:56", "text": "主イエスよ。"}, {"type": "subtitle", "time": 2398.742, "timestamp": "00:39:58", "text": "私は自分のものが大好きです。"}]
[{"type": "subtitle", "time": 526.457, "timestamp": "00:08:46", "text": "こんにちは、みんな。私はここに長い間います。"}, {"type": "subtitle", "time": 529.682, "timestamp": "00:08:49", "text": "拘束しなかった。したがって、"}, {"type": "subtitle", "time": 530.361, "timestamp": "00:08:50", "text": "今日私たちは"}, {"type": "subtitle", "time": 531.471, "timestamp": "00:08:51", "text": "私たちは合同で"}, {"type": "subtitle", "time": 532.274, "timestamp": "00:08:52", "text": "Vicと一緒に配信しましょう。"}, {"type": "subtitle", "time": 535.969, "timestamp": "00:08:55", "text": "ちょっと待って。ヴィックはどこにいる？"}]
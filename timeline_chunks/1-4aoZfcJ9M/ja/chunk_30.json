[{"type": "subtitle", "time": 1801.994, "timestamp": "00:30:01", "text": "はい。心配しないで。"}, {"type": "subtitle", "time": 1803.1, "timestamp": "00:30:03", "text": "これだよ、相棒。ない"}, {"type": "subtitle", "time": 1807.22, "timestamp": "00:30:07", "text": "心配。忘れて。"}, {"type": "subtitle", "time": 1813.258, "timestamp": "00:30:13", "text": "これについて。ジャックさん、"}, {"type": "subtitle", "time": 1814.625, "timestamp": "00:30:14", "text": "あなたはまだ、「まあ、まだだ」という感じですね。"}, {"type": "subtitle", "time": 1815.993, "timestamp": "00:30:15", "text": "チャットに目を向けた。"}, {"type": "subtitle", "time": 1817.311, "timestamp": "00:30:17", "text": "どこに行きたいですか？"}, {"type": "subtitle", "time": 1819.04, "timestamp": "00:30:19", "text": "前か後ろか？では"}, {"type": "subtitle", "time": 1819.359, "timestamp": "00:30:19", "text": "のために。"}, {"type": "subtitle", "time": 1822.684, "timestamp": "00:30:22", "text": "うんうん。チャット、まるで"}, {"type": "subtitle", "time": 1824.075, "timestamp": "00:30:24", "text": "当時は学校の友達だった。"}, {"type": "subtitle", "time": 1838.042, "timestamp": "00:30:38", "text": "わかりました。わかった。いいえ、"}, {"type": "subtitle", "time": 1840.063, "timestamp": "00:30:40", "text": "誰でもない。誰でもない。私"}, {"type": "subtitle", "time": 1841.5, "timestamp": "00:30:41", "text": "誰も見当たらない。彼"}, {"type": "subtitle", "time": 1842.229, "timestamp": "00:30:42", "text": "たぶん"}, {"type": "subtitle", "time": 1844.506, "timestamp": "00:30:44", "text": "開ける。遅い。"}, {"type": "subtitle", "time": 1846.294, "timestamp": "00:30:46", "text": "私たちはゆっくりと進む。"}, {"type": "subtitle", "time": 1852.42, "timestamp": "00:30:52", "text": "私はドアを壊すことができます"}, {"type": "subtitle", "time": 1853.52, "timestamp": "00:30:53", "text": "あなた、もしあなたが望むなら。"}, {"type": "subtitle", "time": 1857.334, "timestamp": "00:30:57", "text": "警察よ、ひざまずけ！"}, {"type": "subtitle", "time": 1858.321, "timestamp": "00:30:58", "text": "両手を上げて！"}, {"type": "subtitle", "time": 1859.826, "timestamp": "00:30:59", "text": "カバー。単に"}]
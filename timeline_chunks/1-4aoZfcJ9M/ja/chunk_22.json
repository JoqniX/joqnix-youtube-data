[{"type": "subtitle", "time": 1321.969, "timestamp": "00:22:01", "text": "物事、いや、いや、いや、いや。ない これをやってください。"}, {"type": "subtitle", "time": 1326.809, "timestamp": "00:22:06", "text": "武器を捨てろ。手"}, {"type": "subtitle", "time": 1328.277, "timestamp": "00:22:08", "text": "その上。横になる。"}, {"type": "subtitle", "time": 1330.672, "timestamp": "00:22:10", "text": "撃たないで。ひざまずけ。"}, {"type": "subtitle", "time": 1332.19, "timestamp": "00:22:12", "text": "はい。私は彼を見た。"}, {"type": "subtitle", "time": 1333.864, "timestamp": "00:22:13", "text": "これは狂気だ、"}, {"type": "subtitle", "time": 1337.546, "timestamp": "00:22:17", "text": "わかった。土地。"}, {"type": "subtitle", "time": 1341.535, "timestamp": "00:22:21", "text": "これは狂気だ、"}, {"type": "subtitle", "time": 1342.404, "timestamp": "00:22:22", "text": "犯罪者のような"}, {"type": "subtitle", "time": 1343.406, "timestamp": "00:22:23", "text": "実際にはそうではない"}, {"type": "subtitle", "time": 1344.141, "timestamp": "00:22:24", "text": "銃撃"}, {"type": "subtitle", "time": 1345.477, "timestamp": "00:22:25", "text": "回答など 。"}, {"type": "subtitle", "time": 1354.406, "timestamp": "00:22:34", "text": "報告するのを忘れていました。"}, {"type": "subtitle", "time": 1355.986, "timestamp": "00:22:35", "text": "そこに男がいる。そこには"}, {"type": "subtitle", "time": 1357.25, "timestamp": "00:22:37", "text": "誰かが自由の身だ。"}, {"type": "subtitle", "time": 1360.227, "timestamp": "00:22:40", "text": "あなたは、あなたは、あなたは、"}, {"type": "subtitle", "time": 1361.159, "timestamp": "00:22:41", "text": "彼は手錠をかけられているのか？"}, {"type": "subtitle", "time": 1362.392, "timestamp": "00:22:42", "text": "はい。手錠をかけ"}, {"type": "subtitle", "time": 1363.535, "timestamp": "00:22:43", "text": "彼。報告。"}, {"type": "subtitle", "time": 1366.79, "timestamp": "00:22:46", "text": "誰かがそこを歩いている。"}, {"type": "subtitle", "time": 1367.985, "timestamp": "00:22:47", "text": "意志の。ああ、あなたは集めた"}, {"type": "subtitle", "time": 1370.336, "timestamp": "00:22:50", "text": "さらなる証拠？そこには"}, {"type": "subtitle", "time": 1371.517, "timestamp": "00:22:51", "text": "誰かがそこを歩いている。"}, {"type": "subtitle", "time": 1372.983, "timestamp": "00:22:52", "text": "ちなみに、意志のことです。なれ"}, {"type": "subtitle", "time": 1373.703, "timestamp": "00:22:53", "text": "注意深い。"}]
[{"type": "subtitle", "time": 4141.929, "timestamp": "01:09:01", "text": "ここ。ちょうど受け取りました"}, {"type": "subtitle", "time": 4143.274, "timestamp": "01:09:03", "text": "胸に銃弾が撃ち込まれたんだ。"}, {"type": "subtitle", "time": 4144.67, "timestamp": "01:09:04", "text": "弊社にはどれくらい在籍されていますか？"}, {"type": "subtitle", "time": 4145.408, "timestamp": "01:09:05", "text": "そこに向かっていた。"}, {"type": "subtitle", "time": 4146.696, "timestamp": "01:09:06", "text": "自分がバカみたいに感じる。"}, {"type": "subtitle", "time": 4147.786, "timestamp": "01:09:07", "text": "ドクター、これは強襲艦です。"}, {"type": "subtitle", "time": 4148.97, "timestamp": "01:09:08", "text": "グループ。容疑者"}, {"type": "subtitle", "time": 4150.01, "timestamp": "01:09:10", "text": "拘束され、準備完了"}, {"type": "subtitle", "time": 4150.713, "timestamp": "01:09:10", "text": "避難前。"}, {"type": "subtitle", "time": 4151.914, "timestamp": "01:09:11", "text": "承認されました。なれ"}, {"type": "subtitle", "time": 4152.645, "timestamp": "01:09:12", "text": "準備ができて。"}, {"type": "subtitle", "time": 4154.216, "timestamp": "01:09:14", "text": "シエラ1号は"}, {"type": "subtitle", "time": 4155.496, "timestamp": "01:09:15", "text": "襲撃グループ。私"}, {"type": "subtitle", "time": 4156.745, "timestamp": "01:09:16", "text": "フィールドからターゲットを外した"}, {"type": "subtitle", "time": 4157.093, "timestamp": "01:09:17", "text": "ビジョン。"}, {"type": "subtitle", "time": 4163.236, "timestamp": "01:09:23", "text": "これが武器だ。警察。"}, {"type": "subtitle", "time": 4164.809, "timestamp": "01:09:24", "text": "現地に、直ちに。の上"}, {"type": "subtitle", "time": 4166.287, "timestamp": "01:09:26", "text": "土地。手を挙げて。"}, {"type": "subtitle", "time": 4168.249, "timestamp": "01:09:28", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 4174.553, "timestamp": "01:09:34", "text": "たくさんあります"}, {"type": "subtitle", "time": 4175.457, "timestamp": "01:09:35", "text": "容疑者。"}, {"type": "subtitle", "time": 4177.27, "timestamp": "01:09:37", "text": "理解できない。私は何者？"}, {"type": "subtitle", "time": 4177.968, "timestamp": "01:09:37", "text": "した？"}, {"type": "subtitle", "time": 4179.391, "timestamp": "01:09:39", "text": "これは襲撃グループだ。"}, {"type": "subtitle", "time": 4185.428, "timestamp": "01:09:45", "text": "こちらはシエラです。失った"}, {"type": "subtitle", "time": 4186.562, "timestamp": "01:09:46", "text": "視覚的な接触"}, {"type": "subtitle", "time": 4187.759, "timestamp": "01:09:47", "text": "襲撃グループと共に。"}, {"type": "subtitle", "time": 4189.917, "timestamp": "01:09:49", "text": "現場の警察官は、"}]
[{"type": "subtitle", "time": 1980.884, "timestamp": "00:33:00", "text": "両手を上げて！"}, {"type": "subtitle", "time": 1991.839, "timestamp": "00:33:11", "text": "ああ、主イエスよ。私"}, {"type": "subtitle", "time": 1992.925, "timestamp": "00:33:12", "text": "ただ…ただ"}, {"type": "subtitle", "time": 1994.222, "timestamp": "00:33:14", "text": "息を呑むほど"}, {"type": "subtitle", "time": 1995.029, "timestamp": "00:33:15", "text": "彼らは横になっていた。"}, {"type": "subtitle", "time": 1998.905, "timestamp": "00:33:18", "text": "心配しないで、"}, {"type": "subtitle", "time": 2001.212, "timestamp": "00:33:21", "text": "通常。えっと、ジャック、"}, {"type": "subtitle", "time": 2002.107, "timestamp": "00:33:22", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 2003.744, "timestamp": "00:33:23", "text": "はい、私は上昇中です。"}, {"type": "subtitle", "time": 2004.231, "timestamp": "00:33:24", "text": "その上。"}, {"type": "subtitle", "time": 2015.381, "timestamp": "00:33:35", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 2019.994, "timestamp": "00:33:39", "text": "ここにあります。"}, {"type": "subtitle", "time": 2027.435, "timestamp": "00:33:47", "text": "おお、いいね。そうだった"}, {"type": "subtitle", "time": 2028.885, "timestamp": "00:33:48", "text": "ジャックさん、急いでください。 。よくやった。しかし"}, {"type": "subtitle", "time": 2030.295, "timestamp": "00:33:50", "text": "。よくやった。しかし 誰もいない"}, {"type": "subtitle", "time": 2031.299, "timestamp": "00:33:51", "text": "誰もいない 殺す。"}, {"type": "subtitle", "time": 2036.243, "timestamp": "00:33:56", "text": "私は銃を変えるつもりだ。"}, {"type": "subtitle", "time": 2037.115, "timestamp": "00:33:57", "text": "戦術的に。"}]
[{"type": "subtitle", "time": 722.218, "timestamp": "00:12:02", "text": "これは複雑な地図です。与える"}, {"type": "subtitle", "time": 724.229, "timestamp": "00:12:04", "text": "少し時間をください。ここ、"}, {"type": "subtitle", "time": 725.643, "timestamp": "00:12:05", "text": "そっちの方がずっといい。"}, {"type": "subtitle", "time": 726.994, "timestamp": "00:12:06", "text": "これを演奏しますが、"}, {"type": "subtitle", "time": 728.426, "timestamp": "00:12:08", "text": "またね、わかるでしょ 。ああ、肉が足りない。で、"}, {"type": "subtitle", "time": 738.002, "timestamp": "00:12:18", "text": "。ああ、肉が足りない。で、 1秒。私にさせて"}, {"type": "subtitle", "time": 740.237, "timestamp": "00:12:20", "text": "1秒。私にさせて 動画を調整してください。"}, {"type": "subtitle", "time": 744.121, "timestamp": "00:12:24", "text": "なぜ分離するのか"}, {"type": "subtitle", "time": 745.628, "timestamp": "00:12:25", "text": "能力は常に800"}, {"type": "subtitle", "time": 746.047, "timestamp": "00:12:26", "text": "600ドルで？"}, {"type": "subtitle", "time": 749.529, "timestamp": "00:12:29", "text": "ああ、古いゲームですね。"}, {"type": "subtitle", "time": 750.105, "timestamp": "00:12:30", "text": "お前。"}, {"type": "subtitle", "time": 754.347, "timestamp": "00:12:34", "text": "はい、本当にそうです。"}, {"type": "subtitle", "time": 756.876, "timestamp": "00:12:36", "text": "彼女はもうすぐ20歳になる。"}, {"type": "subtitle", "time": 757.45, "timestamp": "00:12:37", "text": "友人。"}, {"type": "subtitle", "time": 764.2090000000001, "timestamp": "00:12:44", "text": "よし、いくつか選んでみた。"}, {"type": "subtitle", "time": 765.522, "timestamp": "00:12:45", "text": "悪くないカードなので"}, {"type": "subtitle", "time": 768.303, "timestamp": "00:12:48", "text": "それは良い。したがって。"}, {"type": "subtitle", "time": 769.743, "timestamp": "00:12:49", "text": "はい、私は"}, {"type": "subtitle", "time": 771.072, "timestamp": "00:12:51", "text": "すべてを確実にした"}, {"type": "subtitle", "time": 774.658, "timestamp": "00:12:54", "text": "機材の準備は完了しました。"}, {"type": "subtitle", "time": 778.395, "timestamp": "00:12:58", "text": "それでは、ロビーを作成します。あなた"}, {"type": "subtitle", "time": 779.333, "timestamp": "00:1
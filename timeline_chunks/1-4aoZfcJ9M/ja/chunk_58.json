[{"type": "subtitle", "time": 3480.938, "timestamp": "00:58:00", "text": "強烈で耳をつんざくような音。"}, {"type": "subtitle", "time": 3485.904, "timestamp": "00:58:05", "text": "じゃあ、もう一枚ください。"}, {"type": "subtitle", "time": 3486.511, "timestamp": "00:58:06", "text": "手榴弾。"}, {"type": "subtitle", "time": 3492.518, "timestamp": "00:58:12", "text": "これはしないでください。私たちはそうしません"}, {"type": "subtitle", "time": 3493.848, "timestamp": "00:58:13", "text": "手榴弾が2つ必要です。"}, {"type": "subtitle", "time": 3495.045, "timestamp": "00:58:15", "text": "問題は、"}, {"type": "subtitle", "time": 3500.237, "timestamp": "00:58:20", "text": "地獄が始まるとき、"}, {"type": "subtitle", "time": 3501.477, "timestamp": "00:58:21", "text": "私たちはあなたのものが欲しい"}, {"type": "subtitle", "time": 3502.824, "timestamp": "00:58:22", "text": "機関銃が全員を吹き飛ばした。"}, {"type": "subtitle", "time": 3506.418, "timestamp": "00:58:26", "text": "それで"}, {"type": "subtitle", "time": 3507.578, "timestamp": "00:58:27", "text": "私は機関銃を持っています。"}, {"type": "subtitle", "time": 3511.168, "timestamp": "00:58:31", "text": "彼は、彼は"}, {"type": "subtitle", "time": 3511.786, "timestamp": "00:58:31", "text": "機関銃。"}, {"type": "subtitle", "time": 3513.031, "timestamp": "00:58:33", "text": "はい。"}, {"type": "subtitle", "time": 3515.989, "timestamp": "00:58:35", "text": "ああ。彼は機関銃を持っている。"}, {"type": "subtitle", "time": 3517.118, "timestamp": "00:58:37", "text": "おいおい、頼むよ。"}, {"type": "subtitle", "time": 3519.312, "timestamp": "00:58:39", "text": "良い。私は私です"}, {"type": "subtitle", "time": 3524.534, "timestamp": "00:58:44", "text": "私は確信している"}, {"type": "subtitle", "time": 3532.852, "timestamp": "00:58:52", "text": "ジャックは私と一緒にいます。"}, {"type": "subtitle", "time": 3536.007, "timestamp": "00:58:56", "text": "彼はどこにいますか？どこにいるの？で、"}, {"type": "subtitle", "time": 3537.581, "timestamp": "00:58:57", "text": "私はここにいます。"}, {"type": "subtitle", "time": 3538.855, "timestamp": "00:58:58", "text": "掴め。"}]
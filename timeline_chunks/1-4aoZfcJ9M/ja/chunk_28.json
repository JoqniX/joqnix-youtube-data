[{"type": "subtitle", "time": 1682.633, "timestamp": "00:28:02", "text": "私はいつも混乱してしまう。"}, {"type": "subtitle", "time": 1686.339, "timestamp": "00:28:06", "text": "はい、白い盾は"}, {"type": "subtitle", "time": 1687.492, "timestamp": "00:28:07", "text": "いいけど、また"}, {"type": "subtitle", "time": 1688.54, "timestamp": "00:28:08", "text": "ええ、私はどこにでもいます。"}, {"type": "subtitle", "time": 1689.658, "timestamp": "00:28:09", "text": "目がくらむ、そしてこれ"}, {"type": "subtitle", "time": 1691.6, "timestamp": "00:28:11", "text": "悪。じゃあ、それを受け取ります。"}, {"type": "subtitle", "time": 1693.559, "timestamp": "00:28:13", "text": "戦術ヘルメット。彼"}, {"type": "subtitle", "time": 1694.567, "timestamp": "00:28:14", "text": "私には合っている。"}, {"type": "subtitle", "time": 1703.009, "timestamp": "00:28:23", "text": "ジャック、"}, {"type": "subtitle", "time": 1705.355, "timestamp": "00:28:25", "text": "あなたはあなたの...ああ、"}, {"type": "subtitle", "time": 1706.795, "timestamp": "00:28:26", "text": "もうどうでもいいよ、ジャック。"}, {"type": "subtitle", "time": 1708.683, "timestamp": "00:28:28", "text": "君はAK-47を手に取った。"}, {"type": "subtitle", "time": 1710.14, "timestamp": "00:28:30", "text": "あなたは自分の場所から移動できます、"}, {"type": "subtitle", "time": 1710.569, "timestamp": "00:28:30", "text": "ジャック？"}, {"type": "subtitle", "time": 1712.8220000000001, "timestamp": "00:28:32", "text": "えっと、ちょっと待って、ゲーム。"}, {"type": "subtitle", "time": 1716.634, "timestamp": "00:28:36", "text": "ああ、そうだね。ありがとう。欲しいですか？"}, {"type": "subtitle", "time": 1718.127, "timestamp": "00:28:38", "text": "前に行くか、後ろに行くか？"}, {"type": "subtitle", "time": 1719.699, "timestamp": "00:28:39", "text": "わかったよ、相棒。選ぶ"}, {"type": "subtitle", "time": 1722.671, "timestamp": "00:28:42", "text": "今回は君だ。なぜ"}, {"type": "subtitle", "time": 1724.082, "timestamp": "00:28:44", "text": "画面上にカーソルが表示されています。"}, {"type": "subtitle", "time": 1724.435, "timestamp": "00:28:44", "text": "ネズミ？"}, {"type": "subtitle", "time": 1730.042, "timestamp": "00:28:50", "text": "はい、それは良いことです。でもあなたは"}, {"type": "subtitle", "time": 1731.28, "timestamp": "00:28:51", "text": "あなたも撃つから"}, {"type": "subtitle", "time": 1732.175, "timestamp": "00:28:52", "text": "これはしないでください。"}, {"type": "subtitle", "time": 1736.944, "timestamp": "00:28:56", "text": "何てことだ。また。"}, {"type": "subtitle", "time": 1739.564, "timestamp": "00:28:59", "text": "心配しないで。ない"}]
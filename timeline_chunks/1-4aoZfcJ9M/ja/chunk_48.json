[{"type": "subtitle", "time": 2883.522, "timestamp": "00:48:03", "text": "これは…これは"}, {"type": "subtitle", "time": 2884.738, "timestamp": "00:48:04", "text": "民間人、そしてもう一人"}, {"type": "subtitle", "time": 2886.063, "timestamp": "00:48:06", "text": "私は…武器を取り出した。"}, {"type": "subtitle", "time": 2893.334, "timestamp": "00:48:13", "text": "つまり、そうではないということですね。わからない。"}, {"type": "subtitle", "time": 2895.098, "timestamp": "00:48:15", "text": "あるいは呪われているのかも"}, {"type": "subtitle", "time": 2896.112, "timestamp": "00:48:16", "text": "銃はシンプルです"}, {"type": "subtitle", "time": 2897.307, "timestamp": "00:48:17", "text": "呪いにかかった"}, {"type": "subtitle", "time": 2898.611, "timestamp": "00:48:18", "text": "奥の部屋、そしてああ…"}, {"type": "subtitle", "time": 2900.89, "timestamp": "00:48:20", "text": "なんてこった？"}, {"type": "subtitle", "time": 2910.882, "timestamp": "00:48:30", "text": "ああ、ここに人がいる。ひざまずけ。"}, {"type": "subtitle", "time": 2912.257, "timestamp": "00:48:32", "text": "待て、そこにはない。"}, {"type": "subtitle", "time": 2912.604, "timestamp": "00:48:32", "text": "で、"}, {"type": "subtitle", "time": 2915.288, "timestamp": "00:48:35", "text": "なぜ音楽が流れているのですか？"}, {"type": "subtitle", "time": 2917.922, "timestamp": "00:48:37", "text": "待って。いいえ、"}, {"type": "subtitle", "time": 2919.653, "timestamp": "00:48:39", "text": "実際は、いいえ。ない"}, {"type": "subtitle", "time": 2921.211, "timestamp": "00:48:41", "text": "原因は人間だったと思う。 。これは"}, {"type": "subtitle", "time": 2922.505, "timestamp": "00:48:42", "text": "。これは 男たちがいただけだった、"}, {"type": "subtitle", "time": 2923.806, "timestamp": "00:48:43", "text": "男たちがいただけだった、 まるで繋がっているみたい、ああ、なんてことだ。"}, {"type": "subtitle", "time": 2932.076, "timestamp": "00:48:52", "text": "ミッションパネルでは"}, {"type": "subtitle", "time": 2933.443, "timestamp": "00:48:53", "text": "私たちは皆民間人であり、"}, {"type": "subtitle", "time": 2934.46, "timestamp": "00:48:54", "text": "容疑者、我々は"}, {"type": "subtitle", "time": 2935.722, "timestamp": "00:48:55", "text": "物事を整理したりしているところです"}, {"type": "subtitle", "time": 2936.073, "timestamp": "00:48:56", "text": "他の。"}]
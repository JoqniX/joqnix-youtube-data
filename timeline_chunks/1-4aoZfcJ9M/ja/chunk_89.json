[{"type": "subtitle", "time": 5340.629, "timestamp": "01:29:00", "text": "はい、そうです。私はただ"}, {"type": "subtitle", "time": 5342.669, "timestamp": "01:29:02", "text": "私が行きます。あなたは眠りにつく。"}, {"type": "subtitle", "time": 5344.508, "timestamp": "01:29:04", "text": "あなたにはそれが必要で、そう、私は"}, {"type": "subtitle", "time": 5345.908, "timestamp": "01:29:05", "text": "皆さん、本当にありがとうございました。"}, {"type": "subtitle", "time": 5346.866, "timestamp": "01:29:06", "text": "何が起こったのか"}, {"type": "subtitle", "time": 5351.227, "timestamp": "01:29:11", "text": "ご招待いただきありがとうございます。"}, {"type": "subtitle", "time": 5354.118, "timestamp": "01:29:14", "text": "私は、それをありがたく思います。など 次回は"}, {"type": "subtitle", "time": 5355.404, "timestamp": "01:29:15", "text": "次回は 皆さん全員がそこにいるでしょう。さようなら。"}, {"type": "subtitle", "time": 5358.749, "timestamp": "01:29:18", "text": "皆さん全員がそこにいるでしょう。さようなら。 皆さん、またお会いしましょう。の上"}, {"type": "subtitle", "time": 5360.133, "timestamp": "01:29:20", "text": "皆さん、またお会いしましょう。の上 おやすみ。"}, {"type": "subtitle", "time": 5366.15, "timestamp": "01:29:26", "text": "ああ、本当にそうするつもりです。"}, {"type": "subtitle", "time": 5367.358, "timestamp": "01:29:27", "text": "背中が痛いです。"}, {"type": "subtitle", "time": 5368.955, "timestamp": "01:29:28", "text": "さようなら、ジャック。"}, {"type": "subtitle", "time": 5371.061, "timestamp": "01:29:31", "text": "さようなら。ありがとうございます"}, {"type": "subtitle", "time": 5373.307, "timestamp": "01:29:33", "text": "今日。ありがとう。"}, {"type": "subtitle", "time": 5375.195, "timestamp": "01:29:35", "text": "問題ない。"}, {"type": "subtitle", "time": 5377.577, "timestamp": "01:29:37", "text": "さようなら。"}, {"type": "subtitle", "time": 5386.042, "timestamp": "01:29:46", "text": "さあ、皆さん。そうだった"}, {"type": "subtitle", "time": 5388.364, "timestamp": "01:29:48", "text": "ビクター・ムエ。合格した"}, {"type": "subtitle", "time": 5389.789, "timestamp": "01:29:49", "text": "最後にプレイしてからどれくらい経ったか。"}, {"type": "subtitle", "time": 5392.426, "timestamp": "01:29:52", "text": "約2年が経過した。ない"}, {"type": "subtitle", "time": 5395.854, "timestamp": "01:29:55", "text": "2年、1年。うーん そして約8ヶ月"}, {"type": "subtitle", "time": 5397.425, "timestamp": "01:29:57", "text": "そして約8ヶ月 。はい、ほぼ1年2ヶ月です"}, {"type": "subtitle", "time": 5399.793, "timestamp": "01:29:59", "text": "。はい、ほぼ1年2ヶ月です 数ヶ月だと思います。何てことだ、"}]
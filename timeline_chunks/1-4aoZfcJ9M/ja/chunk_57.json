[{"type": "subtitle", "time": 3420.384, "timestamp": "00:57:00", "text": "ああ、ただ単に"}, {"type": "subtitle", "time": 3422.486, "timestamp": "00:57:02", "text": "ボディキット。いいえ、どうぞお持ちください。"}, {"type": "subtitle", "time": 3423.904, "timestamp": "00:57:03", "text": "最低限の装備、"}, {"type": "subtitle", "time": 3427.7, "timestamp": "00:57:07", "text": "お前。ヘルメットだけ。で ところで、"}, {"type": "subtitle", "time": 3428.757, "timestamp": "00:57:08", "text": "ところで、 戦術ヘルメット、なぜなら"}, {"type": "subtitle", "time": 3430.131, "timestamp": "00:57:10", "text": "戦術ヘルメット、なぜなら 私は光ノイズです。"}, {"type": "subtitle", "time": 3434.288, "timestamp": "00:57:14", "text": "だから、もしあなたが"}, {"type": "subtitle", "time": 3435.52, "timestamp": "00:57:15", "text": "驚愕する、"}, {"type": "subtitle", "time": 3436.286, "timestamp": "00:57:16", "text": "私が投げている間に"}, {"type": "subtitle", "time": 3437.584, "timestamp": "00:57:17", "text": "光と騒音、摩耗"}, {"type": "subtitle", "time": 3438.617, "timestamp": "00:57:18", "text": "戦術ヘルメット。"}, {"type": "subtitle", "time": 3440.625, "timestamp": "00:57:20", "text": "必ず"}, {"type": "subtitle", "time": 3444.411, "timestamp": "00:57:24", "text": "鎧なしの場合、"}, {"type": "subtitle", "time": 3445.505, "timestamp": "00:57:25", "text": "あなたは心配していますか？"}, {"type": "subtitle", "time": 3448.169, "timestamp": "00:57:28", "text": "スピード。しかし"}, {"type": "subtitle", "time": 3450.558, "timestamp": "00:57:30", "text": "重いものが必要だ。"}, {"type": "subtitle", "time": 3452.717, "timestamp": "00:57:32", "text": "陶磁器。私は持っている"}, {"type": "subtitle", "time": 3459.762, "timestamp": "00:57:39", "text": "でも、それは必要ない"}, {"type": "subtitle", "time": 3460.71, "timestamp": "00:57:40", "text": "暗視装置"}, {"type": "subtitle", "time": 3461.184, "timestamp": "00:57:41", "text": "ビジョン"}, {"type": "subtitle", "time": 3462.868, "timestamp": "00:57:42", "text": "戦術ヘルメットを着用。"}, {"type": "subtitle", "time": 3463.709, "timestamp": "00:57:43", "text": "よくやった。"}, {"type": "subtitle", "time": 3465.401, "timestamp": "00:57:45", "text": "常夜灯をつけないでください。"}, 
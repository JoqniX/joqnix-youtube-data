[{"type": "subtitle", "time": 3966.53, "timestamp": "01:06:06", "text": "警察、逮捕。"}, {"type": "subtitle", "time": 3966.903, "timestamp": "01:06:06", "text": "手。"}, {"type": "subtitle", "time": 3968.235, "timestamp": "01:06:08", "text": "ただそこに立っているだけではいけません。"}, {"type": "subtitle", "time": 3969.295, "timestamp": "01:06:09", "text": "助けて。"}, {"type": "subtitle", "time": 3972.014, "timestamp": "01:06:12", "text": "私はジョーです。もう出発しました。"}, {"type": "subtitle", "time": 3973.747, "timestamp": "01:06:13", "text": "白人男性。いいえ、私は"}, {"type": "subtitle", "time": 3974.155, "timestamp": "01:06:14", "text": "いいえ。"}, {"type": "subtitle", "time": 3976.762, "timestamp": "01:06:16", "text": "ワイルドックス シーズン2"}, {"type": "subtitle", "time": 3978.539, "timestamp": "01:06:18", "text": "15日に発売されます。だから私は"}, {"type": "subtitle", "time": 3979.474, "timestamp": "01:06:19", "text": "私はこれを待っていました。"}, {"type": "subtitle", "time": 3985.378, "timestamp": "01:06:25", "text": "旦那さん、これ見えますか？"}, {"type": "subtitle", "time": 3987.105, "timestamp": "01:06:27", "text": "ほら、私は全部"}, {"type": "subtitle", "time": 3987.572, "timestamp": "01:06:27", "text": "分離。"}, {"type": "subtitle", "time": 3989.455, "timestamp": "01:06:29", "text": "はい、"}, {"type": "subtitle", "time": 3990.514, "timestamp": "01:06:30", "text": "スタンガン。"}, {"type": "subtitle", "time": 3993.552, "timestamp": "01:06:33", "text": "本当に衝撃的だよ。"}, {"type": "subtitle", "time": 3994.948, "timestamp": "01:06:34", "text": "来て。彼ならできる。"}, {"type": "subtitle", "time": 3995.538, "timestamp": "01:06:35", "text": "作る。"}, {"type": "subtitle", "time": 3996.404, "timestamp": "01:06:36", "text": "誰も"}, {"type": "subtitle", "time": 4002.397, "timestamp": "01:06:42", "text": "苦しむ。警察、"}, {"type": "subtitle", "time": 4003.111, "timestamp": "01:06:43", "text": "今すぐ。"}, {"type": "subtitle", "time": 4007.011, "timestamp": "01:06:47", "text": "警察よ、ひざまずけ。"}, {"type": "subtitle", "time": 4009.718, "timestamp": "01:06:49", "text": "この男は"}, {"type": "subtitle", "time": 4012.74, "timestamp": "01:06:52", "text": "CSのように。"}, {"type": "subtitle", "time": 4015.772, "timestamp": "01:06:55", "text": "はい。はい。自分"}, {"type": "subtitle", "time": 4017.066, "timestamp": "01:06:57", "text": "プレイしなければならない。で、"}, {"type": "subtitle", "time": 4018.795, "timestamp": "01:06:58", "text": "はい。あなたはそれが好きですか？"}]
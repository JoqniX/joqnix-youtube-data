[{"type": "subtitle", "time": 900.458, "timestamp": "00:15:00", "text": "うん。"}, {"type": "subtitle", "time": 904.432, "timestamp": "00:15:04", "text": "どうすればいいのかわからない。"}, {"type": "subtitle", "time": 905.393, "timestamp": "00:15:05", "text": "来て。"}, {"type": "subtitle", "time": 907.652, "timestamp": "00:15:07", "text": "がある、"}, {"type": "subtitle", "time": 909.29, "timestamp": "00:15:09", "text": "わからない。理解できない、"}, {"type": "subtitle", "time": 910.355, "timestamp": "00:15:10", "text": "何についてお尋ねですか？"}, {"type": "subtitle", "time": 911.546, "timestamp": "00:15:11", "text": "よくやった。あなたが持っている"}, {"type": "subtitle", "time": 912.851, "timestamp": "00:15:12", "text": "教えて。あなたが持っている"}, {"type": "subtitle", "time": 913.952, "timestamp": "00:15:13", "text": "文を完成させてください。"}, {"type": "subtitle", "time": 915.336, "timestamp": "00:15:15", "text": "男らしい。来て。あなた"}, {"type": "subtitle", "time": 916.18, "timestamp": "00:15:16", "text": "君なら大丈夫だよ。"}, {"type": "subtitle", "time": 920.337, "timestamp": "00:15:20", "text": "さあ、ゲームは始まった"}, {"type": "subtitle", "time": 921.378, "timestamp": "00:15:21", "text": "全画面表示"}, {"type": "subtitle", "time": 922.563, "timestamp": "00:15:22", "text": "モードですが、私は"}, {"type": "subtitle", "time": 923.962, "timestamp": "00:15:23", "text": "マウスを動かすだけ"}, {"type": "subtitle", "time": 924.931, "timestamp": "00:15:24", "text": "800×600の範囲内"}, {"type": "subtitle", "time": 930.064, "timestamp": "00:15:30", "text": "ピクセル。そして私はできない"}, {"type": "subtitle", "time": 930.845, "timestamp": "00:15:30", "text": "クリックする"}, {"type": "subtitle", "time": 931.626, "timestamp": "00:15:31", "text": "更新または"}, {"type": "subtitle", "time": 933.284, "timestamp": "00:15:33", "text": "設定。それで"}, {"type": "subtitle", "time": 934.263, "timestamp": "00:15:34", "text": "私は思う"}, {"type": "subtitle", "time": 935.502, "timestamp": "00:15:35", "text": "外出すらできない。"}, {"type": "subtitle", "time": 936.926, "timestamp": "00:15:36", "text": "ゲームから。どんな馬鹿者だ？"}, {"type": "subtitle", "time": 939.141, "timestamp": "00:15:39", "text": "Alt-F 4 を押すだけです。これは"}, {"type": "subtitle", "time": 941.359, "timestamp": "00:15:41", "text": "問題。 Altキーを押しながら終了"}, {"type": "subtitle", "time": 942.628, "timestamp": "00:15:42", "text": "ゲームをクリアするか、"}, {"type": "subtitle", "time": 943.524, "timestamp": "00:15:43", "text": "くそ"}, {"type": "subtitle", "time": 944.831, "timestamp": "00:15:44", "text": "タスクマネージャー。"}, {"type": "subtitle", "time": 946.482, "timestamp": "00:15:46", "text": "すべて順調です。"}, {"type": "subtitle", "time": 947.688, "timestamp": "00:15:47", "text": "Altキーが効きません。"}, {"type": "subtitle", "time": 952.969, "timestamp": "00:15:52", "text": "ああ、コントロールキーとエスケープキーですね。単に"}, {"type": "subtitle", "time": 954.635, "timestamp": "00:15:54", "text": "コントロールエスケープ。ああ、"}]
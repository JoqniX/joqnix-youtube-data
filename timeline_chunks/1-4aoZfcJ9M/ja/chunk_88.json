[{"type": "subtitle", "time": 5280.791, "timestamp": "01:28:00", "text": "おっしゃることは分かります。こんにちは。"}, {"type": "subtitle", "time": 5284.375, "timestamp": "01:28:04", "text": "こんにちは。こんにちは。はい。ええと、"}, {"type": "subtitle", "time": 5286.703, "timestamp": "01:28:06", "text": "はい、明日です。はい、できます。"}, {"type": "subtitle", "time": 5289.969, "timestamp": "01:28:09", "text": "そうだろう。はい。えーと、その後"}, {"type": "subtitle", "time": 5291.361, "timestamp": "01:28:11", "text": "ランチ。私は暇だ。"}, {"type": "subtitle", "time": 5296.386, "timestamp": "01:28:16", "text": "はい。クラス。了解、了解。"}, {"type": "subtitle", "time": 5297.539, "timestamp": "01:28:17", "text": "遊べるよ。"}, {"type": "subtitle", "time": 5298.638, "timestamp": "01:28:18", "text": "明日だよ、相棒。ない"}, {"type": "subtitle", "time": 5299.423, "timestamp": "01:28:19", "text": "心配。"}, {"type": "subtitle", "time": 5301.94, "timestamp": "01:28:21", "text": "心配しないで、ああ、いや"}, {"type": "subtitle", "time": 5302.666, "timestamp": "01:28:22", "text": "心配。"}, {"type": "subtitle", "time": 5310.043, "timestamp": "01:28:30", "text": "ダウンロード。はい、私は"}, {"type": "subtitle", "time": 5311.71, "timestamp": "01:28:31", "text": "そのままにしておきます。これ以上は言いません。"}, {"type": "subtitle", "time": 5312.201, "timestamp": "01:28:32", "text": "下から。"}, {"type": "subtitle", "time": 5313.498, "timestamp": "01:28:33", "text": "イベントがすべてだと思う。"}, {"type": "subtitle", "time": 5314.632, "timestamp": "01:28:34", "text": "彼らは切る、彼らは"}, {"type": "subtitle", "time": 5315.482, "timestamp": "01:28:35", "text": "カット、彼らは"}, {"type": "subtitle", "time": 5316.679, "timestamp": "01:28:36", "text": "イベントやその他すべてをカットする"}, {"type": "subtitle", "time": 5317.677, "timestamp": "01:28:37", "text": "このような。これはもはや"}, {"type": "subtitle", "time": 5318.971, "timestamp": "01:28:38", "text": "難しい。我々はできる"}, {"type": "subtitle", "time": 5320.289, "timestamp": "01:28:40", "text": "基本的に合格する"}, {"type": "subtitle", "time": 5321.508, "timestamp": "01:28:41", "text": "これで10試合だ。"}, {"type": "subtitle", "time": 5323.212, "timestamp": "01:28:43", "text": "終わらせましょう。"}, {"type": "subtitle", "time": 5324.121, "timestamp": "01:28:44", "text": "これらすべての"}, {"type": "subtitle", "time": 5325.555, "timestamp": "01:28:45", "text": "キャラクター。それで、"}, {"type": "subtitle", "time": 5326.907, "timestamp": "01:28:46", "text": "彼らはまた削除した"}, {"type": "subtitle", "time": 5327.529, "timestamp": "01:28:47", "text": "政権"}, {"type": "subtitle", "time": 5332.105, "timestamp": "01:28:52", "text": "なぜなら人々は強すぎるから"}, {"type": "subtitle", "time": 5333.016, "timestamp": "01:28:53", "text": "この汗をかいた"}, {"type": "subtitle", "time": 5335.354, "timestamp": "01:28:55", "text": "モード。だから、どういうわけか 、 おそらく。"}]
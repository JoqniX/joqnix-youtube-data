[{"type": "subtitle", "time": 4322.946, "timestamp": "01:12:02", "text": "これはインスピレーションの源です"}, {"type": "subtitle", "time": 4323.26, "timestamp": "01:12:03", "text": "彼女。"}, {"type": "subtitle", "time": 4325.448, "timestamp": "01:12:05", "text": "はい、その通りです。"}, {"type": "subtitle", "time": 4326.752, "timestamp": "01:12:06", "text": "この…このゲーム"}, {"type": "subtitle", "time": 4328.966, "timestamp": "01:12:08", "text": "スワットフォールと呼ばれています。それ"}, {"type": "subtitle", "time": 4333.551, "timestamp": "01:12:13", "text": "オリジナル。彼女は少し"}, {"type": "subtitle", "time": 4334.895, "timestamp": "01:12:14", "text": "より愚かなのは"}, {"type": "subtitle", "time": 4339.554, "timestamp": "01:12:19", "text": "ストーリーと"}, {"type": "subtitle", "time": 4341.697, "timestamp": "01:12:21", "text": "それら全て。ああ、なんてことだ、ひどい。"}, {"type": "subtitle", "time": 4344.622, "timestamp": "01:12:24", "text": "つまり、あなたはそれを手に入れることはできないでしょう。"}, {"type": "subtitle", "time": 4351.253, "timestamp": "01:12:31", "text": "なぜ4番目なのか？私"}, {"type": "subtitle", "time": 4352.449, "timestamp": "01:12:32", "text": "つまり"}, {"type": "subtitle", "time": 4354.428, "timestamp": "01:12:34", "text": "第一、第二、第三がある。"}, {"type": "subtitle", "time": 4356.006, "timestamp": "01:12:36", "text": "どうやらこれは4作目らしい。"}, {"type": "subtitle", "time": 4362.534, "timestamp": "01:12:42", "text": "わかったよ、ジャック。私"}, {"type": "subtitle", "time": 4363.741, "timestamp": "01:12:43", "text": "清掃完了"}, {"type": "subtitle", "time": 4364.735, "timestamp": "01:12:44", "text": "自宅では、すべてが"}, {"type": "subtitle", "time": 4367.577, "timestamp": "01:12:47", "text": "終わり。すべての証拠"}, {"type": "subtitle", "time": 4369.137, "timestamp": "01:12:49", "text": "収集しました。まるで、ただ"}, {"type": "subtitle", "time": 4370.751, "timestamp": "01:12:50", "text": "2つの証拠。それだけです。"}, {"type": "subtitle", "time": 4371.589, "timestamp": "01:12:51", "text": "というわけで、ここにたどり着きました。"}, {"type": "subtitle", "time": 4372.292, "timestamp": "01:12:52", "text": "終了した。"}, {"type": "subtitle", "time": 4373.348, "timestamp": "01:12:53", "text": "あなたは何をしましたか？"}, {"type": "subtitle", "time": 4374.164, "timestamp": "01:12:54", "text": "概して、"}, {"type": "subtitle", "time": 4375.206, "timestamp": "01:12:55", "text": "これに投票してください。"}, {"type": "subtitle", "time": 4375.813, "timestamp": "01:12:55", "text": "我々はできる"}, {"type": "subtitle", "time": 4376.769, "timestamp": "01:12:56", "text": "投票する"}, {"type": "subtitle", "time": 4378.04, "timestamp": "01:12:58", "text": "次のカード。私たちは"}, {"type": "subtitle", "time": 4379.364, "timestamp": "01:12:59", "text": "私たちはここで時間を過ごしたい"}, {"type": "subtitle", "time": 4379.636, "timestamp": "01:12:59", "text": "時間。"}]
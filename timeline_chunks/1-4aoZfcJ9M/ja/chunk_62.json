[{"type": "subtitle", "time": 3727.396, "timestamp": "01:02:07", "text": "ああ、こうだ。ああ、だめだ。"}, {"type": "subtitle", "time": 3737.838, "timestamp": "01:02:17", "text": "これらはカバーしなければならない。"}, {"type": "subtitle", "time": 3738.404, "timestamp": "01:02:18", "text": "男の子たち。"}, {"type": "subtitle", "time": 3742.443, "timestamp": "01:02:22", "text": "避難準備完了。"}, {"type": "subtitle", "time": 3750.74, "timestamp": "01:02:30", "text": "良い。この録音 。"}, {"type": "subtitle", "time": 3753.69, "timestamp": "01:02:33", "text": "待って、待って。あなた"}, {"type": "subtitle", "time": 3754.406, "timestamp": "01:02:34", "text": "話しているのですか？"}, {"type": "subtitle", "time": 3756.668, "timestamp": "01:02:36", "text": "私は話しません。"}, {"type": "subtitle", "time": 3758.679, "timestamp": "01:02:38", "text": "ああ、わかりました。良い。良い。"}, {"type": "subtitle", "time": 3759.377, "timestamp": "01:02:39", "text": "私はこんな感じです。"}, {"type": "subtitle", "time": 3760.453, "timestamp": "01:02:40", "text": "どうしたの？"}, {"type": "subtitle", "time": 3761.613, "timestamp": "01:02:41", "text": "私はフィールド上で標的を見失った。"}, {"type": "subtitle", "time": 3761.893, "timestamp": "01:02:41", "text": "ビジョン。"}, {"type": "subtitle", "time": 3763.527, "timestamp": "01:02:43", "text": "はい。はい。私は鎖に繋がれている。"}, {"type": "subtitle", "time": 3764.19, "timestamp": "01:02:44", "text": "この二人。"}, {"type": "subtitle", "time": 3766.14, "timestamp": "01:02:46", "text": "事故死。"}, {"type": "subtitle", "time": 3769.65, "timestamp": "01:02:49", "text": "良い。すべて順調です。ない"}, {"type": "subtitle", "time": 3770.629, "timestamp": "01:02:50", "text": "心配。しかし私たちは"}, {"type": "subtitle", "time": 3771.281, "timestamp": "01:02:51", "text": "私たちはいつでも"}, {"type": "subtitle", "time": 3772.261, "timestamp": "01:02:52", "text": "ラウンドを再開してください。"}, {"type": "subtitle", "time": 3773.47, "timestamp": "01:02:53", "text": "ご心配なく。"}, {"type": "subtitle", "time": 3774.707, "timestamp": "01:02:54", "text": "だから、そうすべきではない"}, {"type": "subtitle", "time": 3775.49, "timestamp": "01:02:55", "text": "殺すのか？"}, {"type": "subtitle", "time": 3777.755, "timestamp": "01:02:57", "text": "お前はあの男を殺したんだ。"}, {"type": "subtitle", "time": 3779.254, "timestamp": "01:02:59", "text": "おい、消え失せろ。"}]
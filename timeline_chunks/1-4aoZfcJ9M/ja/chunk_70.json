[{"type": "subtitle", "time": 4204.185, "timestamp": "01:10:04", "text": "すぐに。良い。ほかに何か"}, {"type": "subtitle", "time": 4208.285, "timestamp": "01:10:08", "text": "どうすればいいですか？自分"}, {"type": "subtitle", "time": 4209.404, "timestamp": "01:10:09", "text": "報告する必要がある"}, {"type": "subtitle", "time": 4210.848, "timestamp": "01:10:10", "text": "3人。それだけです。"}, {"type": "subtitle", "time": 4212.031, "timestamp": "01:10:12", "text": "報告しなければならない。"}, {"type": "subtitle", "time": 4213.203, "timestamp": "01:10:13", "text": "約3人。させて"}, {"type": "subtitle", "time": 4214.506, "timestamp": "01:10:14", "text": "彼はギリシャ人だ。私は何か"}, {"type": "subtitle", "time": 4220.322, "timestamp": "01:10:20", "text": "見逃しましたか？ああ、証拠だ。"}, {"type": "subtitle", "time": 4222.856, "timestamp": "01:10:22", "text": "グループ。"}, {"type": "subtitle", "time": 4226.307, "timestamp": "01:10:26", "text": "あと2人います。"}, {"type": "subtitle", "time": 4231.104, "timestamp": "01:10:31", "text": "はい、手動で行う必要があります。"}, {"type": "subtitle", "time": 4232.601, "timestamp": "01:10:32", "text": "タイプ、人々、そうでなければそれは"}, {"type": "subtitle", "time": 4233.875, "timestamp": "01:10:33", "text": "全くうまくいかないだろう。"}, {"type": "subtitle", "time": 4243.969, "timestamp": "01:10:43", "text": "わかりました。これは"}, {"type": "subtitle", "time": 4245.14, "timestamp": "01:10:45", "text": "そこにあったから"}, {"type": "subtitle", "time": 4246.16, "timestamp": "01:10:46", "text": "とても多くの人々、"}, {"type": "subtitle", "time": 4247.068, "timestamp": "01:10:47", "text": "どうやってやったか覚えていますか？"}, {"type": "subtitle", "time": 4252.16, "timestamp": "01:10:52", "text": "サーバーを処理するために、"}, {"type": "subtitle", "time": 4253.247, "timestamp": "01:10:53", "text": "そこは簡単だったから"}, {"type": "subtitle", "time": 4257.172, "timestamp": "01:10:57", "text": "人が多すぎる。私"}, {"type": "subtitle", "time": 4258.438, "timestamp": "01:10:58", "text": "偏執的だ、誰がそれらを持っているのか"}, {"type": "subtitle", "time": 4259.596, "timestamp": "01:10:59", "text": "結ぶだけで"}]
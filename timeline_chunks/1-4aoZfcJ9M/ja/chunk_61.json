[{"type": "subtitle", "time": 3660.781, "timestamp": "01:01:00", "text": "両手を上げて"}, {"type": "subtitle", "time": 3661.354, "timestamp": "01:01:01", "text": "床。"}, {"type": "subtitle", "time": 3663.516, "timestamp": "01:01:03", "text": "良い。さあ行こう、さあ行こう、"}, {"type": "subtitle", "time": 3664.01, "timestamp": "01:01:04", "text": "さあ行こう。"}, {"type": "subtitle", "time": 3668.271, "timestamp": "01:01:08", "text": "これは一部屋です。"}, {"type": "subtitle", "time": 3669.488, "timestamp": "01:01:09", "text": "2階"}, {"type": "subtitle", "time": 3670.767, "timestamp": "01:01:10", "text": "今は床に倒れている。"}, {"type": "subtitle", "time": 3672.7, "timestamp": "01:01:12", "text": "悪魔。彼らはどこにでもいる。"}, {"type": "subtitle", "time": 3673.895, "timestamp": "01:01:13", "text": "誰かが見える。"}, {"type": "subtitle", "time": 3675.863, "timestamp": "01:01:15", "text": "直接。直接。"}, {"type": "subtitle", "time": 3677.809, "timestamp": "01:01:17", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 3679.124, "timestamp": "01:01:19", "text": "いや、いや。行かないで。"}, {"type": "subtitle", "time": 3679.94, "timestamp": "01:01:19", "text": "戻ってくる。"}, {"type": "subtitle", "time": 3682.892, "timestamp": "01:01:22", "text": "何てことだ。"}, {"type": "subtitle", "time": 3685.889, "timestamp": "01:01:25", "text": "すべて順調です。全て"}, {"type": "subtitle", "time": 3686.496, "timestamp": "01:01:26", "text": "わかりました。"}, {"type": "subtitle", "time": 3687.799, "timestamp": "01:01:27", "text": "すべて順調です。"}, {"type": "subtitle", "time": 3692.028, "timestamp": "01:01:32", "text": "なんてこった？の上"}, {"type": "subtitle", "time": 3692.993, "timestamp": "01:01:32", "text": "さあ、床に降りてください。"}, {"type": "subtitle", "time": 3694.63, "timestamp": "01:01:34", "text": "警察。"}, {"type": "subtitle", "time": 3696.811, "timestamp": "01:01:36", "text": "すぐに両手を上げてください。"}, {"type": "subtitle", "time": 3698.349, "timestamp": "01:01:38", "text": "こちらはシエラです。"}, {"type": "subtitle", "time": 3700.325, "timestamp": "01:01:40", "text": "容疑者は立ち去った。"}, {"type": "subtitle", "time": 3701.314, "timestamp": "01:01:41", "text": "2階へ。"}, {"type": "subtitle", "time": 3703.686, "timestamp": "01:01:43", "text": "床に倒れている。"}, {"type": "subtitle", "time": 3713.55, "timestamp": "01:01:53", "text": "ああ、どうして私は"}, {"type": "subtitle", "time": 3717.324, "timestamp": "01:01:57", "text": "壁に撃ち込んだ。として"}]
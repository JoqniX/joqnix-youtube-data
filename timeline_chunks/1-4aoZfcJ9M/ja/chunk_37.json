[{"type": "subtitle", "time": 2222.981, "timestamp": "00:37:02", "text": "まったく、ちくしょう。 まるでランボルギーニの武器のようだ。"}, {"type": "subtitle", "time": 2225.789, "timestamp": "00:37:05", "text": "ああ。"}, {"type": "subtitle", "time": 2229.567, "timestamp": "00:37:09", "text": "ウジ。ああ、PP。 PP。私はこんな感じです。"}, {"type": "subtitle", "time": 2230.945, "timestamp": "00:37:10", "text": "「ジャック、だから言ったでしょ。」"}, {"type": "subtitle", "time": 2232.435, "timestamp": "00:37:12", "text": "行かないでください..."}, {"type": "subtitle", "time": 2233.813, "timestamp": "00:37:13", "text": "ランボから武器を奪う 内部…警察"}, {"type": "subtitle", "time": 2240.834, "timestamp": "00:37:20", "text": "内部…警察 ちょっとショックを受けて：「うーん、これは"}, {"type": "subtitle", "time": 2242.016, "timestamp": "00:37:22", "text": "ちょっとショックを受けて：「うーん、これは 彼はテロリストですか？"}, {"type": "subtitle", "time": 2243.302, "timestamp": "00:37:23", "text": "彼はテロリストですか？ 「誰がテロリスト側にいるんだ？」いいえ"}, {"type": "subtitle", "time": 2246.463, "timestamp": "00:37:26", "text": "「誰がテロリスト側にいるんだ？」いいえ 知っている。"}, {"type": "subtitle", "time": 2249.282, "timestamp": "00:37:29", "text": "ああ、BLB。"}, {"type": "subtitle", "time": 2254.982, "timestamp": "00:37:34", "text": "待って、私たち…わかった。わかった。"}, {"type": "subtitle", "time": 2255.592, "timestamp": "00:37:35", "text": "ご挨拶申し上げます。"}, {"type": "subtitle", "time": 2259.758, "timestamp": "00:37:39", "text": "ジョー、元気かい？私は持っている"}, {"type": "subtitle", "time": 2261.716, "timestamp": "00:37:41", "text": "すべて順調です。アリソ、"}, {"type": "subtitle", "time": 2266.171, "timestamp": "00:37:46", "text": "元気です。私"}, {"type": "subtitle", "time": 2267.552, "timestamp": "00:37:47", "text": "今日はたくさん作ったよ"}, {"type": "subtitle", "time": 2269.954, "timestamp": "00:37:49", "text": "事柄。関連物"}, {"type": "subtitle", "time": 2272.944, "timestamp": "00:37:52", "text": "バックエンド付き。新しく"}, {"type": "subtitle", "time": 2274.198, "timestamp": "00:37:54", "text": "何か新しいものを創造した。"}, {"type": "subtitle", "time": 2278.009, "timestamp": "00:37:58", "text": "だから私は、"}, {"type": "subtitle", "time": 2279.042, "timestamp": "00:37:59", "text": "何かをするために"}]
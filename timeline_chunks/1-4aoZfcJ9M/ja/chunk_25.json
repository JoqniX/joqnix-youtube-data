[{"type": "subtitle", "time": 1500.297, "timestamp": "00:25:00", "text": "横になる。"}, {"type": "subtitle", "time": 1501.543, "timestamp": "00:25:01", "text": "手を挙げて。"}, {"type": "subtitle", "time": 1503.261, "timestamp": "00:25:03", "text": "行け、行け、行け、行け。"}, {"type": "subtitle", "time": 1504.898, "timestamp": "00:25:04", "text": "手を挙げてください。警察 ひざまずきなさい。"}, {"type": "subtitle", "time": 1512.176, "timestamp": "00:25:12", "text": "待って、彼が出てきた。"}, {"type": "subtitle", "time": 1512.706, "timestamp": "00:25:12", "text": "通り？"}, {"type": "subtitle", "time": 1515.584, "timestamp": "00:25:15", "text": "手を挙げて。"}, {"type": "subtitle", "time": 1518.259, "timestamp": "00:25:18", "text": "わかった。はい、そうだと思います。"}, {"type": "subtitle", "time": 1521.18, "timestamp": "00:25:21", "text": "その上。ジャック、私はもう行くわ。"}, {"type": "subtitle", "time": 1522.6, "timestamp": "00:25:22", "text": "先に。あなたは私のものです。"}, {"type": "subtitle", "time": 1524.568, "timestamp": "00:25:24", "text": "隠ぺいする。存在せよ、存在せよ。"}, {"type": "subtitle", "time": 1528.67, "timestamp": "00:25:28", "text": "私のすぐ後ろに。どこ？私"}, {"type": "subtitle", "time": 1529.974, "timestamp": "00:25:29", "text": "私は再び登り始めている。"}, {"type": "subtitle", "time": 1534.003, "timestamp": "00:25:34", "text": "待って、あそこ。"}, {"type": "subtitle", "time": 1535.023, "timestamp": "00:25:35", "text": "彼はそこにいますか？"}, {"type": "subtitle", "time": 1536.151, "timestamp": "00:25:36", "text": "はい。"}, {"type": "subtitle", "time": 1543.272, "timestamp": "00:25:43", "text": "ショットガンだよ、相棒。自分"}, {"type": "subtitle", "time": 1544.394, "timestamp": "00:25:44", "text": "1つで離陸できる"}, {"type": "subtitle", "time": 1545.074, "timestamp": "00:25:45", "text": "ショット。"}, {"type": "subtitle", "time": 1549.063, "timestamp": "00:25:49", "text": "わかった、君が彼を殺したんだね。"}, {"type": "subtitle", "time": 1553.482, "timestamp": "00:25:53", "text": "絶対に外出してはいけない。の上"}, {"type": "subtitle", "time": 1554.757, "timestamp": "00:25:54", "text": "ラップ。横になる。"}, {"type": "subtitle", "time": 1557.53, "timestamp": "00:25:57", "text": "横になる。 わかった。"}]
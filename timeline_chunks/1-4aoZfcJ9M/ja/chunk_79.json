[{"type": "subtitle", "time": 4741.573, "timestamp": "01:19:01", "text": "それが私の仕事です。これと…"}, {"type": "subtitle", "time": 4742.31, "timestamp": "01:19:02", "text": "はい、どうぞお入りください。"}, {"type": "subtitle", "time": 4743.248, "timestamp": "01:19:03", "text": "設定と"}, {"type": "subtitle", "time": 4743.918, "timestamp": "01:19:03", "text": "遊ぶ"}, {"type": "subtitle", "time": 4745.258, "timestamp": "01:19:05", "text": "解決 。私は遊んでいました。"}, {"type": "subtitle", "time": 4752.297, "timestamp": "01:19:12", "text": "しかし問題は、"}, {"type": "subtitle", "time": 4753.166, "timestamp": "01:19:13", "text": "もし私が変わったらどうなるだろう"}, {"type": "subtitle", "time": 4754.377, "timestamp": "01:19:14", "text": "解決、"}, {"type": "subtitle", "time": 4754.905, "timestamp": "01:19:14", "text": "私はできません"}, {"type": "subtitle", "time": 4756.146, "timestamp": "01:19:16", "text": "マウスを使用する 、"}, {"type": "subtitle", "time": 4758.369, "timestamp": "01:19:18", "text": "前進する"}, {"type": "subtitle", "time": 4759.278, "timestamp": "01:19:19", "text": "下のアイコンをご覧ください。"}, {"type": "subtitle", "time": 4763.399, "timestamp": "01:19:23", "text": "ああ、800くらい持ってるよ…"}, {"type": "subtitle", "time": 4767.37, "timestamp": "01:19:27", "text": "まあ、いいんじゃない。"}, {"type": "subtitle", "time": 4771.144, "timestamp": "01:19:31", "text": "何、どんな馬鹿者だ？"}, {"type": "subtitle", "time": 4773.353, "timestamp": "01:19:33", "text": "わかりました。どんな地図が必要ですか？ ゼルダを作ろう。"}, {"type": "subtitle", "time": 4778.153, "timestamp": "01:19:38", "text": "もう1時半だ。"}, {"type": "subtitle", "time": 4781.393, "timestamp": "01:19:41", "text": "ああ、試合に負けてしまった。わかりました 。追加するだけ"}, {"type": "subtitle", "time": 4783.477, "timestamp": "01:19:43", "text": "。追加するだけ 医療センター"}, {"type": "subtitle", "time": 4784.413, "timestamp": "01:19:44", "text": "医療センター 聖なる、なぜならこれは"}, {"type": "subtitle", "time": 4785.45, "timestamp": "01:19:45", "text": "聖なる、なぜならこれは 病院の使命、"}, {"type": "subtitle", "time": 4786.587, "timestamp": "01:19:46", "text": "病院の使命、 先ほどプレイしたばかりのものです。"}, {"type": "subtitle", "time"
[{"type": "subtitle", "time": 1924.649, "timestamp": "00:32:04", "text": "私はリスクを冒したくないので"}, {"type": "subtitle", "time": 1925.849, "timestamp": "00:32:05", "text": "これらの人たちは"}, {"type": "subtitle", "time": 1926.766, "timestamp": "00:32:06", "text": "拳銃である。"}, {"type": "subtitle", "time": 1928.034, "timestamp": "00:32:08", "text": "手錠をかけてください。"}, {"type": "subtitle", "time": 1929.557, "timestamp": "00:32:09", "text": "手錠。手錠。"}, {"type": "subtitle", "time": 1930.655, "timestamp": "00:32:10", "text": "ああ、そうだね。はい。"}, {"type": "subtitle", "time": 1942.025, "timestamp": "00:32:22", "text": "両手を上げて！なぜ"}, {"type": "subtitle", "time": 1943.317, "timestamp": "00:32:23", "text": "キッチンってそんなに汚いの？"}, {"type": "subtitle", "time": 1947.884, "timestamp": "00:32:27", "text": "ゴキブリとかそういうやつ。"}, {"type": "subtitle", "time": 1949.708, "timestamp": "00:32:29", "text": "ここは本当にレストランですか？"}, {"type": "subtitle", "time": 1952.937, "timestamp": "00:32:32", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 1954.025, "timestamp": "00:32:34", "text": "誰かが逃げている。"}, {"type": "subtitle", "time": 1959.695, "timestamp": "00:32:39", "text": "私は誤って彼を殺してしまった。 。"}, {"type": "subtitle", "time": 1967.074, "timestamp": "00:32:47", "text": "なんてこった。"}, {"type": "subtitle", "time": 1970.743, "timestamp": "00:32:50", "text": "すべて順調です。しかし"}, {"type": "subtitle", "time": 1971.693, "timestamp": "00:32:51", "text": "次回"}, {"type": "subtitle", "time": 1972.801, "timestamp": "00:32:52", "text": "もっと小さいものを持っていく"}, {"type": "subtitle", "time": 1973.561, "timestamp": "00:32:53", "text": "致命的、"}, {"type": "subtitle", "time": 1974.765, "timestamp": "00:32:54", "text": "例えば、テーザー銃や"}, {"type": "subtitle", "time": 1975.367, "timestamp": "00:32:55", "text": "そんな感じ。"}, {"type": "subtitle", "time": 1977.896, "timestamp": "00:32:57", "text": "殺しだけはしないでください。"}, {"type": "subtitle", "time": 1978.637, "timestamp": "00:32:58", "text": "すべて一列に並んでいます。"}]
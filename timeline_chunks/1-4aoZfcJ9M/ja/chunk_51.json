[{"type": "subtitle", "time": 3060.549, "timestamp": "00:51:00", "text": "彼は"}, {"type": "subtitle", "time": 3062.873, "timestamp": "00:51:02", "text": "民間人か何か？ない"}, {"type": "subtitle", "time": 3063.352, "timestamp": "00:51:03", "text": "知っている。"}, {"type": "subtitle", "time": 3065.109, "timestamp": "00:51:05", "text": "彼には会わないけれど。私"}, {"type": "subtitle", "time": 3066.427, "timestamp": "00:51:06", "text": "とても混乱しています、"}, {"type": "subtitle", "time": 3066.804, "timestamp": "00:51:06", "text": "タイプ。"}, {"type": "subtitle", "time": 3072.496, "timestamp": "00:51:12", "text": "想像してみて、これがその女性なんだ。"}, {"type": "subtitle", "time": 3087.164, "timestamp": "00:51:27", "text": "おお。はい、いいえ"}, {"type": "subtitle", "time": 3088.019, "timestamp": "00:51:28", "text": "心配。"}, {"type": "subtitle", "time": 3092.909, "timestamp": "00:51:32", "text": "他にないですか？"}, {"type": "subtitle", "time": 3093.747, "timestamp": "00:51:33", "text": "ゲーム内のルート？"}, {"type": "subtitle", "time": 3097.815, "timestamp": "00:51:37", "text": "殺してやる。"}, {"type": "subtitle", "time": 3099.727, "timestamp": "00:51:39", "text": "これについてご協力をお願いします。"}, {"type": "subtitle", "time": 3102.893, "timestamp": "00:51:42", "text": "はい、できます。"}, {"type": "subtitle", "time": 3103.441, "timestamp": "00:51:43", "text": "単に。"}, {"type": "subtitle", "time": 3107.522, "timestamp": "00:51:47", "text": "人を殺す。"}, {"type": "subtitle", "time": 3111.045, "timestamp": "00:51:51", "text": "次のカード。停止。"}, {"type": "subtitle", "time": 3113.928, "timestamp": "00:51:53", "text": "停止。次のカード。"}, {"type": "subtitle", "time": 3116.303, "timestamp": "00:51:56", "text": "ええ、そうです。 F1。"}, {"type": "subtitle", "time": 3117.517, "timestamp": "00:51:57", "text": "F11。"}, {"type": "subtitle", "time": 3118.826, "timestamp": "00:51:58", "text": "はい。"}]
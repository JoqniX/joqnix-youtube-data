[{"type": "subtitle", "time": 4680.482, "timestamp": "01:18:00", "text": "何が起こったのか？今、何が起こったの？ 何が起こったのか？なぜ私なの？"}, {"type": "subtitle", "time": 4681.61, "timestamp": "01:18:01", "text": "何が起こったのか？なぜ私なの？ 放送はこれで終わりですか？"}, {"type": "subtitle", "time": 4682.999, "timestamp": "01:18:02", "text": "放送はこれで終わりですか？ パニックにならない。単に"}, {"type": "subtitle", "time": 4684.389, "timestamp": "01:18:04", "text": "パニックにならない。単に OBSを開いてください。"}, {"type": "subtitle", "time": 4685.915, "timestamp": "01:18:05", "text": "OBSを開いてください。 OBSに行って"}, {"type": "subtitle", "time": 4687.439, "timestamp": "01:18:07", "text": "OBSに行って 見て。すべて順調です。"}, {"type": "subtitle", "time": 4693.629, "timestamp": "01:18:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 4698.601, "timestamp": "01:18:18", "text": "狂気。止まれ、私は"}, {"type": "subtitle", "time": 4699.437, "timestamp": "01:18:19", "text": "私には無理だ"}, {"type": "subtitle", "time": 4700.675, "timestamp": "01:18:20", "text": "あなたを見る"}, {"type": "subtitle", "time": 4701.961, "timestamp": "01:18:21", "text": "くそっ、YouTubeめ。だれの"}, {"type": "subtitle", "time": 4703.069, "timestamp": "01:18:23", "text": "一体何が起こったんだ？"}, {"type": "subtitle", "time": 4706.461, "timestamp": "01:18:26", "text": "YouTubeで。"}, {"type": "subtitle", "time": 4712.207, "timestamp": "01:18:32", "text": "ああ、ジャック、君はYouTubeに出てるよね。"}, {"type": "subtitle", "time": 4712.831, "timestamp": "01:18:32", "text": "はい。"}, {"type": "subtitle", "time": 4718.831, "timestamp": "01:18:38", "text": "SWAT 4. 別々"}, {"type": "subtitle", "time": 4719.974, "timestamp": "01:18:39", "text": "能力—これは"}, {"type": "subtitle", "time": 4724.104, "timestamp": "01:18:44", "text": "痛み。ゲームを作成する。で、"}, {"type": "subtitle", "time": 4725.243, "timestamp": "01:18:45", "text": "ちなみに、"}, {"type": "subtitle", "time": 4726.596, "timestamp": "01:18:46", "text": "あなたはできる、あなたは変えることができる"}, {"type": "subtitle", "time": 4729.075, "timestamp": "01:18:49", "text": "設定。単に"}, {"type": "subtitle", "time": 4729.961, "timestamp": "01:18:49", "text": "OBS に
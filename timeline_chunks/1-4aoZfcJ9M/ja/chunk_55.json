[{"type": "subtitle", "time": 3301.932, "timestamp": "00:55:01", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 3305.749, "timestamp": "00:55:05", "text": "気をつけて。なれ"}, {"type": "subtitle", "time": 3309.316, "timestamp": "00:55:09", "text": "注意深い。みんな、私は"}, {"type": "subtitle", "time": 3309.826, "timestamp": "00:55:09", "text": "欲しい"}, {"type": "subtitle", "time": 3312.992, "timestamp": "00:55:12", "text": "いや、ジャック。"}, {"type": "subtitle", "time": 3315.074, "timestamp": "00:55:15", "text": "何？"}, {"type": "subtitle", "time": 3317.086, "timestamp": "00:55:17", "text": "チャック、まっすぐ立たないで。"}, {"type": "subtitle", "time": 3317.953, "timestamp": "00:55:17", "text": "私の目の前に。"}, {"type": "subtitle", "time": 3320.24, "timestamp": "00:55:20", "text": "何てことだ。"}, {"type": "subtitle", "time": 3322.647, "timestamp": "00:55:22", "text": "何もない。私が担当します。"}, {"type": "subtitle", "time": 3325.561, "timestamp": "00:55:25", "text": "行こう、行こう"}, {"type": "subtitle", "time": 3326.07, "timestamp": "00:55:26", "text": "さあ"}, {"type": "subtitle", "time": 3328.817, "timestamp": "00:55:28", "text": "再起動。良い、"}, {"type": "subtitle", "time": 3330.023, "timestamp": "00:55:30", "text": "再起動。"}, {"type": "subtitle", "time": 3331.322, "timestamp": "00:55:31", "text": "再起動しました。"}, {"type": "subtitle", "time": 3338.321, "timestamp": "00:55:38", "text": "再起動。 F11。悪魔"}, {"type": "subtitle", "time": 3338.952, "timestamp": "00:55:38", "text": "持って行ってください。"}, {"type": "subtitle", "time": 3342.324, "timestamp": "00:55:42", "text": "まっすぐに立たないでください。"}, {"type": "subtitle", "time": 3342.971, "timestamp": "00:55:42", "text": "私の前に"}, {"type": "subtitle", "time": 3343.812, "timestamp": "00:55:43", "text": "グレネードランチャー。"}, {"type": "subtitle", "time": 3346.119, "timestamp": "00:55:46", "text": "わかった。"}, {"type": "subtitle", "time": 3348.725, "timestamp": "00:55:48", "text": "前に立たないでください"}, {"type": "subtitle", "time": 3350.446, "timestamp": "00:55:50", "text": "グレネードランチャー。私は私です"}, {"type": "subtitle", "time": 3351.823, "timestamp": "00:55:51", "text": "何度も言っているでしょう。"}, {"type": "subtitle", "time": 3354.504, "timestamp": "00:55:54", "text": "これはグレネードランチャーですか？何？"}, {"type": "subtitle", "time": 3358.308, "timestamp": "00:55:58", "text": "ああ、それは非致死性です。それ"}, {"type": "subtitle", "time": 3359.448, "timestamp": "00:55:59", "text": "これは軽い音です"}]
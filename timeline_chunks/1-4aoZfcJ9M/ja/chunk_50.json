[{"type": "subtitle", "time": 3001.331, "timestamp": "00:50:01", "text": "なぜ私を縛っているのですか？"}, {"type": "subtitle", "time": 3002.048, "timestamp": "00:50:02", "text": "私はあなたが"}, {"type": "subtitle", "time": 3002.959, "timestamp": "00:50:02", "text": "私たちを集めるつもりですか？"}, {"type": "subtitle", "time": 3003.61, "timestamp": "00:50:03", "text": "保存。"}, {"type": "subtitle", "time": 3004.419, "timestamp": "00:50:04", "text": "床の上。"}, {"type": "subtitle", "time": 3005.576, "timestamp": "00:50:05", "text": "私をここに置いていって。"}, {"type": "subtitle", "time": 3007.186, "timestamp": "00:50:07", "text": "今すぐ両手を上げてください。"}, {"type": "subtitle", "time": 3017.699, "timestamp": "00:50:17", "text": "すごくかっこいい。私はできる"}, {"type": "subtitle", "time": 3018.792, "timestamp": "00:50:18", "text": "撃つだけ"}, {"type": "subtitle", "time": 3019.62, "timestamp": "00:50:19", "text": "彼にエアソフトガンを持たせる。"}, {"type": "subtitle", "time": 3026.702, "timestamp": "00:50:26", "text": "それらは何、それらは何、"}, {"type": "subtitle", "time": 3027.64, "timestamp": "00:50:27", "text": "くそ、"}, {"type": "subtitle", "time": 3030.342, "timestamp": "00:50:30", "text": "咳してるの？ジャック、"}, {"type": "subtitle", "time": 3031.783, "timestamp": "00:50:31", "text": "何かできることがある ？いいえ。"}, {"type": "subtitle", "time": 3036.618, "timestamp": "00:50:36", "text": "なぜ私はあんなものを吐いてしまったのだろう？"}, {"type": "subtitle", "time": 3037.075, "timestamp": "00:50:37", "text": "お前？"}, {"type": "subtitle", "time": 3041.759, "timestamp": "00:50:41", "text": "何を使いましたか？"}, {"type": "subtitle", "time": 3042.824, "timestamp": "00:50:42", "text": "催涙ガス"}, {"type": "subtitle", "time": 3043.457, "timestamp": "00:50:43", "text": "彼らに対して？"}, {"type": "subtitle", "time": 3049.158, "timestamp": "00:50:49", "text": "何？わからない。彼らは"}, {"type": "subtitle", "time": 3050.779, "timestamp": "00:50:50", "text": "激しく咳き込み、"}, {"type": "subtitle", "time": 3055.14, "timestamp": "00:50:55", "text": "そして、ああ、なんてことだ。外にある。"}, {"type": "subtitle", "time": 3058.489, "timestamp": "00:50:58", "text": "これが最初のものだった。"}, {"type": "subtitle", "time": 3059.671, "timestamp": "00:50:59", "text": "私たちが話している男"}]
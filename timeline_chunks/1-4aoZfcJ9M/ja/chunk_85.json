[{"type": "subtitle", "time": 5101.447, "timestamp": "01:25:01", "text": "私は、そうしたいです。良い、"}, {"type": "subtitle", "time": 5103.062, "timestamp": "01:25:03", "text": "私は死んだと思う"}, {"type": "subtitle", "time": 5109.757, "timestamp": "01:25:09", "text": "なぜあなた、私、私は本当に"}, {"type": "subtitle", "time": 5124.163, "timestamp": "01:25:24", "text": "武器。え、何？"}, {"type": "subtitle", "time": 5125.182, "timestamp": "01:25:25", "text": "何が起こっているのか？"}, {"type": "subtitle", "time": 5132.024, "timestamp": "01:25:32", "text": "これは敵の部隊だ。"}, {"type": "subtitle", "time": 5137.324, "timestamp": "01:25:37", "text": "私はただ堂々巡りをしているだけだ。"}, {"type": "subtitle", "time": 5138.486, "timestamp": "01:25:38", "text": "彼らの周りに今。"}, {"type": "subtitle", "time": 5141.101, "timestamp": "01:25:41", "text": "ああ、神様、私は死んでしまった。"}, {"type": "subtitle", "time": 5144.317, "timestamp": "01:25:44", "text": "私はこう思う。「これは面白い」"}, {"type": "subtitle", "time": 5150.469, "timestamp": "01:25:50", "text": "私の側。これは私のものです。"}, {"type": "subtitle", "time": 5152.703, "timestamp": "01:25:52", "text": "あなたは皆に嘘をついている。"}, {"type": "subtitle", "time": 5153.301, "timestamp": "01:25:53", "text": "1秒。"}, {"type": "subtitle", "time": 5157.78, "timestamp": "01:25:57", "text": "はい。私は、完全に死んでいます。"}, {"type": "subtitle", "time": 5158.727, "timestamp": "01:25:58", "text": "私、私"}]
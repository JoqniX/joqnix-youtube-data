[{"type": "subtitle", "time": 2162.682, "timestamp": "00:36:02", "text": "あなた。だから私はあなたに勧めます"}, {"type": "subtitle", "time": 2163.556, "timestamp": "00:36:03", "text": "主なもの1つ"}, {"type": "subtitle", "time": 2164.867, "timestamp": "00:36:04", "text": "AK-47のような致命的な"}, {"type": "subtitle", "time": 2166.069, "timestamp": "00:36:06", "text": "そんな感じで、2つ目は"}, {"type": "subtitle", "time": 2167.308, "timestamp": "00:36:07", "text": "非致死性—衝撃的"}, {"type": "subtitle", "time": 2168.401, "timestamp": "00:36:08", "text": "またはペイントボール"}, {"type": "subtitle", "time": 2172.679, "timestamp": "00:36:12", "text": "銃。受け取ってもいいですよ。"}, {"type": "subtitle", "time": 2173.963, "timestamp": "00:36:13", "text": "ペイントボール銃"}, {"type": "subtitle", "time": 2174.909, "timestamp": "00:36:14", "text": "第二の武器として。"}, {"type": "subtitle", "time": 2178.38, "timestamp": "00:36:18", "text": "メイン"}, {"type": "subtitle", "time": 2179.299, "timestamp": "00:36:19", "text": "ペイントボール、そして"}, {"type": "subtitle", "time": 2180.183, "timestamp": "00:36:20", "text": "二次— ショットガン。"}, {"type": "subtitle", "time": 2185.328, "timestamp": "00:36:25", "text": "ああ、わかりました。私たちはできる"}, {"type": "subtitle", "time": 2186.133, "timestamp": "00:36:26", "text": "そうしてください。"}, {"type": "subtitle", "time": 2187.705, "timestamp": "00:36:27", "text": "こんにちは、アリソ。"}, {"type": "subtitle", "time": 2188.923, "timestamp": "00:36:28", "text": "いらっしゃいませ、"}, {"type": "subtitle", "time": 2194.185, "timestamp": "00:36:34", "text": "おめでとう、友よ。はい、私は"}, {"type": "subtitle", "time": 2194.892, "timestamp": "00:36:34", "text": "終了した。"}, {"type": "subtitle", "time": 2197.045, "timestamp": "00:36:37", "text": "聞いてくれ、俺たち二人とも"}, {"type": "subtitle", "time": 2197.87, "timestamp": "00:36:37", "text": "私たちは一緒にいられます"}, {"type": "subtitle", "time": 2199.093, "timestamp": "00:36:39", "text": "非致死性兵器、"}, {"type": "subtitle", "time": 2200.348, "timestamp": "00:36:40", "text": "私たちには何かが必要だから"}, {"type": "subtitle", "time": 2200.943, "timestamp": "00:36:40", "text": "深刻な。"}, {"type": "subtitle", "time": 2204.038, "timestamp": "00:36:44", "text": "あなたはよくやっています。"}, {"type": "subtitle", "time": 2205.262, "timestamp": "00:36:45", "text": "致命的な、ミスター"}, {"type": "subtitle", "time": 2207.296, "timestamp": "00:36:47", "text": "ジャック。私はあなたにお勧めします"}, {"type": "subtitle", "time": 2208.222, "timestamp": "00:36:48", "text": "致命的なもの。"}, {"type": "subtitle", "time": 2212.562, "timestamp": "00:36:52", "text": "それから、えーと、"}, {"type": "subtitle", "time": 2215.748, "timestamp": "00:36:55", "text": "マシンガンとか、"}, {"type": "subtitle", "time": 2219.559, "timestamp": "00:36:59", "text": "ウージーを手に入れるよ。機関銃 。"}]
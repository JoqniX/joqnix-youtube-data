[{"type": "subtitle", "time": 1380.414, "timestamp": "00:23:00", "text": "彼はどこにいますか？まだそこには達していない"}, {"type": "subtitle", "time": 1387.696, "timestamp": "00:23:07", "text": "さあ行こう。彼は去った。"}, {"type": "subtitle", "time": 1389.513, "timestamp": "00:23:09", "text": "2階？くそ。"}, {"type": "subtitle", "time": 1390.711, "timestamp": "00:23:10", "text": "少し時間をください。"}, {"type": "subtitle", "time": 1392.64, "timestamp": "00:23:12", "text": "何があるか確認する"}, {"type": "subtitle", "time": 1393.16, "timestamp": "00:23:13", "text": "その上。"}, {"type": "subtitle", "time": 1394.388, "timestamp": "00:23:14", "text": "そこで止まれ。"}, {"type": "subtitle", "time": 1396.493, "timestamp": "00:23:16", "text": "そこに女性がいます。"}, {"type": "subtitle", "time": 1400.351, "timestamp": "00:23:20", "text": "それ"}, {"type": "subtitle", "time": 1403.106, "timestamp": "00:23:23", "text": "犯罪者、殺人犯？"}, {"type": "subtitle", "time": 1409.499, "timestamp": "00:23:29", "text": "まるで連続殺人犯のようだ。"}, {"type": "subtitle", "time": 1412.491, "timestamp": "00:23:32", "text": "そうではない。単に"}, {"type": "subtitle", "time": 1413.74, "timestamp": "00:23:33", "text": "風変わりな。心配しないで。"}, {"type": "subtitle", "time": 1414.364, "timestamp": "00:23:34", "text": "彼について。"}, {"type": "subtitle", "time": 1415.661, "timestamp": "00:23:35", "text": "おお。"}, {"type": "subtitle", "time": 1417.524, "timestamp": "00:23:37", "text": "で、"}, {"type": "subtitle", "time": 1420.601, "timestamp": "00:23:40", "text": "どこ？ジャック、なぜ？"}, {"type": "subtitle", "time": 1425.203, "timestamp": "00:23:45", "text": "なぜ私の前にいるのですか？私"}, {"type": "subtitle", "time": 1426.649, "timestamp": "00:23:46", "text": "私は光と音を投げかけている。"}, {"type": "subtitle", "time": 1428.088, "timestamp": "00:23:48", "text": "なぜあなたは一番前にいるのですか？"}, {"type": "subtitle", "time": 1428.45, "timestamp": "00:23:48", "text": "自分？"}, {"type": "subtitle", "time": 1438.597, "timestamp": "00:23:58", "text": "よし、一匹逃走中だ。 。少なくとも"}]
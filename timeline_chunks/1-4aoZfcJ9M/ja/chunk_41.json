[{"type": "subtitle", "time": 2462.711, "timestamp": "00:41:02", "text": "君はそこに行ったのか？"}, {"type": "subtitle", "time": 2464.32, "timestamp": "00:41:04", "text": "わかった。ああ、助かった。"}, {"type": "subtitle", "time": 2466.724, "timestamp": "00:41:06", "text": "ショットガンは持っていったのか？"}, {"type": "subtitle", "time": 2469.325, "timestamp": "00:41:09", "text": "いいえ、ショットガンは持っていきませんでした。"}, {"type": "subtitle", "time": 2470.015, "timestamp": "00:41:10", "text": "あなたと。"}, {"type": "subtitle", "time": 2471.234, "timestamp": "00:41:11", "text": "わかった。"}, {"type": "subtitle", "time": 2472.483, "timestamp": "00:41:12", "text": "私はショットガンを持っています。"}, {"type": "subtitle", "time": 2474.018, "timestamp": "00:41:14", "text": "私は…いや、いや。で"}, {"type": "subtitle", "time": 2475.298, "timestamp": "00:41:15", "text": "私はショットガンを持っていません。"}, {"type": "subtitle", "time": 2477.314, "timestamp": "00:41:17", "text": "なし。なし。いいえ、いいえ、"}, {"type": "subtitle", "time": 2478.922, "timestamp": "00:41:18", "text": "いや、いや。それは私です、"}, {"type": "subtitle", "time": 2480.521, "timestamp": "00:41:20", "text": "私は証拠を集めています。君がそれだ"}, {"type": "subtitle", "time": 2481.898, "timestamp": "00:41:21", "text": "した？あなたはただ"}, {"type": "subtitle", "time": 2485.873, "timestamp": "00:41:25", "text": "ジャックのように"}, {"type": "subtitle", "time": 2497.303, "timestamp": "00:41:37", "text": "私は、何度も"}, {"type": "subtitle", "time": 2498.224, "timestamp": "00:41:38", "text": "彼を殴った。"}, {"type": "subtitle", "time": 2499.656, "timestamp": "00:41:39", "text": "なぜ彼は死ななかったのか？"}, {"type": "subtitle", "time": 2500.944, "timestamp": "00:41:40", "text": "これは、これはペイントボールです"}, {"type": "subtitle", "time": 2502.311, "timestamp": "00:41:42", "text": "銃。あなたはできません。"}, {"type": "subtitle", "time": 2503.349, "timestamp": "00:41:43", "text": "これで人を殺す。"}, {"type": "subtitle", "time": 2503.921, "timestamp": "00:41:43", "text": "横になる。"}, {"type": "subtitle", "time": 2504.715, "timestamp": "00:41:44", "text": "それは必要だった"}, {"type": "subtitle", "time": 2505.863, "timestamp": "00:41:45", "text": "要件を使用する"}, {"type": "subtitle", "time": 2507.04, "timestamp": "00:41:47", "text": "従うこと。あなたは違う"}, {"type": "subtitle", "time": 2508.291, "timestamp": "00:41:48", "text": "あなたは要件を満たしています。私"}, {"type": "subtitle", "time": 2509.477, "timestamp": "00:41:49", "text": "あなたを驚かせてみせます。"}, {"type": "subtitle", "time": 2511.799, "timestamp": "00:41:51", "text": "はい。警官はいない。"}, {"type": "subtitle", "time": 2513.386, "timestamp": "00:41:53", "text": "わかった。"}, {"type": "subtitle", "time": 2515.801, "timestamp": "00:41:55", "text": "ああ、なんてこった。良い"}, {"type": "subtitle", "time": 2516.731, "timestamp": "00:41:56", "text": "ああ、そうだな。"}]
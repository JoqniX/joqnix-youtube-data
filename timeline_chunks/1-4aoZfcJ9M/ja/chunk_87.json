[{"type": "subtitle", "time": 5224.626, "timestamp": "01:27:04", "text": "はい、そう思います。"}, {"type": "subtitle", "time": 5225.484, "timestamp": "01:27:05", "text": "今日私たちは"}, {"type": "subtitle", "time": 5226.225, "timestamp": "01:27:06", "text": "終了した"}, {"type": "subtitle", "time": 5229.971, "timestamp": "01:27:09", "text": "ご挨拶申し上げます。私はそうは思わない。"}, {"type": "subtitle", "time": 5231.967, "timestamp": "01:27:11", "text": "知っている。最初の1つはあなたが持っています。"}, {"type": "subtitle", "time": 5233.627, "timestamp": "01:27:13", "text": "30番目。あなた"}, {"type": "subtitle", "time": 5234.883, "timestamp": "01:27:14", "text": "本当に欲しいですか？"}, {"type": "subtitle", "time": 5236.51, "timestamp": "01:27:16", "text": "続く？あなた"}, {"type": "subtitle", "time": 5237.816, "timestamp": "01:27:17", "text": "明日働くために、"}, {"type": "subtitle", "time": 5238.17, "timestamp": "01:27:18", "text": "もの。"}, {"type": "subtitle", "time": 5239.552, "timestamp": "01:27:19", "text": "私には必要、私には必要"}, {"type": "subtitle", "time": 5240.934, "timestamp": "01:27:20", "text": "私は6時に起きなければならない。 。"}, {"type": "subtitle", "time": 5247.036, "timestamp": "01:27:27", "text": "はい。はい。私はああ、"}, {"type": "subtitle", "time": 5247.81, "timestamp": "01:27:27", "text": "物事、あなた"}, {"type": "subtitle", "time": 5251.73, "timestamp": "01:27:31", "text": "あなたには、あなたにはつながりがあります"}, {"type": "subtitle", "time": 5256.679, "timestamp": "01:27:36", "text": "中断された。あなたはアメリカ出身ですか？"}, {"type": "subtitle", "time": 5259.003, "timestamp": "01:27:39", "text": "明日は自由時間です。私たちは"}, {"type": "subtitle", "time": 5260.005, "timestamp": "01:27:40", "text": "私たちは遊ぶことができます"}, {"type": "subtitle", "time": 5261.678, "timestamp": "01:27:41", "text": "両方。素晴らしいね、友よ。"}, {"type": "subtitle", "time": 5262.24, "timestamp": "01:27:42", "text": "こんにちは。"}, {"type": "subtitle", "time": 5264.931, "timestamp": "01:27:44", "text": "えっと、明日必要なんです。"}, {"type": "subtitle", "time": 5267.76, "timestamp": "01:27:47", "text": "はい。はい、おっしゃることは分かります。"}, {"type": "subtitle", "time": 5272.254, "timestamp": "01:27:52", "text": "こんにちは。こんにちは。やめろ、お前。"}, {"type": "subtitle", "time": 5273.104, "timestamp": "01:27:53", "text": "聞こえますか？"}, {"type": "subtitle", "time": 5273.705, "timestamp": "01:27:53", "text": "こんにちは、"}, {"type": "subtitle", "time": 5274.148, "timestamp": "01:27:54", "text": "年。"}, {"type": "subtitle", "time": 5275.986, "timestamp": "01:27:55", "text": "リック、止まれ。こんにちは。"}, {"type": "subtitle", "time": 5278.156, "timestamp": "01:27:58", "text": "はい、わかりました。"}]
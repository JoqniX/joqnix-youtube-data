[{"type": "subtitle", "time": 3840.451, "timestamp": "01:04:00", "text": "彼女が戻ってきた。"}, {"type": "subtitle", "time": 3849.557, "timestamp": "01:04:09", "text": "私は人々を見る。"}, {"type": "subtitle", "time": 3850.556, "timestamp": "01:04:10", "text": "君に1つ。"}, {"type": "subtitle", "time": 3853.104, "timestamp": "01:04:13", "text": "何てことだ。ピン。ピン。"}, {"type": "subtitle", "time": 3854.591, "timestamp": "01:04:14", "text": "私は死んだ。"}, {"type": "subtitle", "time": 3858.098, "timestamp": "01:04:18", "text": "なぜそれを受け取ったのですか？"}, {"type": "subtitle", "time": 3858.668, "timestamp": "01:04:18", "text": "機関銃？"}, {"type": "subtitle", "time": 3862.233, "timestamp": "01:04:22", "text": "ピン。ピン。ピンという音がした。"}, {"type": "subtitle", "time": 3865.314, "timestamp": "01:04:25", "text": "何？"}, {"type": "subtitle", "time": 3867.894, "timestamp": "01:04:27", "text": "ゲームの動作が重かった。"}, {"type": "subtitle", "time": 3877.632, "timestamp": "01:04:37", "text": "ああ、それでは"}, {"type": "subtitle", "time": 3879.464, "timestamp": "01:04:39", "text": "土地。手を挙げて。"}, {"type": "subtitle", "time": 3880.667, "timestamp": "01:04:40", "text": "手を挙げて。 容疑者は立ち去った"}, {"type": "subtitle", "time": 3881.947, "timestamp": "01:04:41", "text": "容疑者は立ち去った トイレ。"}, {"type": "subtitle", "time": 3883.2, "timestamp": "01:04:43", "text": "トイレ。 反対側、反対側"}, {"type": "subtitle", "time": 3884.52, "timestamp": "01:04:44", "text": "反対側、反対側 レベル。"}, {"type": "subtitle", "time": 3885.429, "timestamp": "01:04:45", "text": "レベル。 他に何があっても構わない"}, {"type": "subtitle", "time": 3886.731, "timestamp": "01:04:46", "text": "他に何があっても構わない 起こるだろう。単に"}, {"type": "subtitle", "time": 3887.968, "timestamp": "01:04:47", "text": "起こるだろう。単に ここから出してくれ"}, {"type": "subtitle", "time": 3889.293, "timestamp": "01:04:49", "text": "ここから出してくれ 穴。あの男は"}, {"type": "subtitle", "time": 3894.692, "timestamp": "01:04:54", "text": "穴。あの男は それは「ディグル」だった。"}, {"type": "subtitle", "time": 3898.658, "timestamp": "01:04:58", "text": "そう、あの人です。"}]
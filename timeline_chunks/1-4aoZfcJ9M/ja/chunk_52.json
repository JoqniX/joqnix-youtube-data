[{"type": "subtitle", "time": 3122.303, "timestamp": "00:52:02", "text": "続いて"}, {"type": "subtitle", "time": 3123.422, "timestamp": "00:52:03", "text": "次のカード。私たちは"}, {"type": "subtitle", "time": 3124.614, "timestamp": "00:52:04", "text": "ここで終了です。ない"}, {"type": "subtitle", "time": 3125.648, "timestamp": "00:52:05", "text": "これを処理してください。"}, {"type": "subtitle", "time": 3131.439, "timestamp": "00:52:11", "text": "基本。これは武器だと思う。"}, {"type": "subtitle", "time": 3132.547, "timestamp": "00:52:12", "text": "行き詰まってしまった"}, {"type": "subtitle", "time": 3133.689, "timestamp": "00:52:13", "text": "隅っこのどこかに、"}, {"type": "subtitle", "time": 3138.294, "timestamp": "00:52:18", "text": "私たちは今ここにいます。わからない。"}, {"type": "subtitle", "time": 3140.6, "timestamp": "00:52:20", "text": "ええ、おそらくショットガンでしょう。"}, {"type": "subtitle", "time": 3143.647, "timestamp": "00:52:23", "text": "はい、ショットガンだと思います"}, {"type": "subtitle", "time": 3144.725, "timestamp": "00:52:24", "text": "ちょうど飛び立ったところです"}, {"type": "subtitle", "time": 3146.923, "timestamp": "00:52:26", "text": "テクスチャ。私はそうは思わない。"}, {"type": "subtitle", "time": 3149.59, "timestamp": "00:52:29", "text": "良い。いずれにしても"}, {"type": "subtitle", "time": 3150.938, "timestamp": "00:52:30", "text": "はいはい、わかりました。"}, {"type": "subtitle", "time": 3152.319, "timestamp": "00:52:32", "text": "ジャック、これは難しい。それ"}, {"type": "subtitle", "time": 3153.414, "timestamp": "00:52:33", "text": "広大なエリア、"}, {"type": "subtitle", "time": 3154.848, "timestamp": "00:52:34", "text": "巨大な地図、2つ"}, {"type": "subtitle", "time": 3157.072, "timestamp": "00:52:37", "text": "階。それはここにあります。"}, {"type": "subtitle", "time": 3157.526, "timestamp": "00:52:37", "text": "カオス。"}, {"type": "subtitle", "time": 3159.077, "timestamp": "00:52:39", "text": "停止。"}, {"type": "subtitle", "time": 3160.679, "timestamp": "00:52:40", "text": "そしてそれは全くそうではない"}, {"type": "subtitle", "time": 3164.815, "timestamp": "00:52:44", "text": "楽しい。はい、そうです"}, {"type": "subtitle", "time": 3166.274, "timestamp": "00:52:46", "text": "よし、それを受け取ろう。"}, {"type": "subtitle", "time": 3171.784, "timestamp": "00:52:51", "text": "致命的だ。そこから。"}, {"type": "subtitle", "time": 3175.114, "timestamp": "00:52:55", "text": "あのね？私は大丈夫です。"}, {"type": "subtitle", "time": 3176.954, "timestamp": "00:52:56", "text": "私は大丈夫です。私はそう思う"}, {"type": "subtitle", "time": 3178.211, "timestamp": "00:52:58", "text": "かなり自信がある"}, {"type": "subtitle", "time": 3179.612, "timestamp": "00:52:59", "text": "君の選択だよ。"}]
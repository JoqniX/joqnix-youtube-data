[{"type": "subtitle", "time": 1861.122, "timestamp": "00:31:01", "text": "ここから出してくれ。"}, {"type": "subtitle", "time": 1862.666, "timestamp": "00:31:02", "text": "わかった。"}, {"type": "subtitle", "time": 1867.297, "timestamp": "00:31:07", "text": "でも、私は…何も知らないんです。"}, {"type": "subtitle", "time": 1867.825, "timestamp": "00:31:07", "text": "した。"}, {"type": "subtitle", "time": 1870.155, "timestamp": "00:31:10", "text": "ああ、了解。"}, {"type": "subtitle", "time": 1871.387, "timestamp": "00:31:11", "text": "トイレ、ミスター"}, {"type": "subtitle", "time": 1872.605, "timestamp": "00:31:12", "text": "ジャック。お願いします、"}, {"type": "subtitle", "time": 1873.857, "timestamp": "00:31:13", "text": "誰も殺してはいけない。"}, {"type": "subtitle", "time": 1875.538, "timestamp": "00:31:15", "text": "はい、閉店しました。"}, {"type": "subtitle", "time": 1877.244, "timestamp": "00:31:17", "text": "ロック解除中。"}, {"type": "subtitle", "time": 1881.041, "timestamp": "00:31:21", "text": "なぜこのトイレなのか？"}, {"type": "subtitle", "time": 1882.241, "timestamp": "00:31:22", "text": "開ける？どんな種類"}, {"type": "subtitle", "time": 1896.596, "timestamp": "00:31:36", "text": "妄想？横になる。"}, {"type": "subtitle", "time": 1899.44, "timestamp": "00:31:39", "text": "急勾配です。わかった。"}, {"type": "subtitle", "time": 1900.945, "timestamp": "00:31:40", "text": "わかった。ところで、"}, {"type": "subtitle", "time": 1902.202, "timestamp": "00:31:42", "text": "そこのドアは開いています。"}, {"type": "subtitle", "time": 1903.262, "timestamp": "00:31:43", "text": "念のため。"}, {"type": "subtitle", "time": 1904.586, "timestamp": "00:31:44", "text": "わかった。"}, {"type": "subtitle", "time": 1906.293, "timestamp": "00:31:46", "text": "これらを開けないでください"}, {"type": "subtitle", "time": 1913.596, "timestamp": "00:31:53", "text": "ドア。あなたが行く。"}, {"type": "subtitle", "time": 1918.263, "timestamp": "00:31:58", "text": "うんうん。"}]
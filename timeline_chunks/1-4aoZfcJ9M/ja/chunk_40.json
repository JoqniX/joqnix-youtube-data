[{"type": "subtitle", "time": 2400.042, "timestamp": "00:40:00", "text": "ペイントボールマーカー。"}, {"type": "subtitle", "time": 2408.145, "timestamp": "00:40:08", "text": "何もない。"}, {"type": "subtitle", "time": 2410.564, "timestamp": "00:40:10", "text": "当てたよ。"}, {"type": "subtitle", "time": 2416.958, "timestamp": "00:40:16", "text": "頭を殴られた。"}, {"type": "subtitle", "time": 2418.723, "timestamp": "00:40:18", "text": "それを受け取って。それを受け取って。"}, {"type": "subtitle", "time": 2419.916, "timestamp": "00:40:19", "text": "その。それを受け取って。"}, {"type": "subtitle", "time": 2421.387, "timestamp": "00:40:21", "text": "それを受け取って。すぐ後ろ"}, {"type": "subtitle", "time": 2422.233, "timestamp": "00:40:22", "text": "彼。完了"}, {"type": "subtitle", "time": 2426.742, "timestamp": "00:40:26", "text": "トラブル。 2つありました"}, {"type": "subtitle", "time": 2427.502, "timestamp": "00:40:27", "text": "起訴された。"}, {"type": "subtitle", "time": 2433.241, "timestamp": "00:40:33", "text": "ああ、ジャック、こっちへおいで。"}, {"type": "subtitle", "time": 2437.012, "timestamp": "00:40:37", "text": "もういいよ。何てことだ 。いや、いや。手錠。"}, {"type": "subtitle", "time": 2438.771, "timestamp": "00:40:38", "text": "。いや、いや。手錠。 手錠。彼女は、彼女は"}, {"type": "subtitle", "time": 2440.223, "timestamp": "00:40:40", "text": "手錠。彼女は、彼女は 嘘。やめてください。"}, {"type": "subtitle", "time": 2444.311, "timestamp": "00:40:44", "text": "あなたはまだそれを見ていない"}, {"type": "subtitle", "time": 2445.064, "timestamp": "00:40:45", "text": "最後の一つ"}, {"type": "subtitle", "time": 2446.756, "timestamp": "00:40:46", "text": "主イエスよ。"}, {"type": "subtitle", "time": 2448.174, "timestamp": "00:40:48", "text": "彼女についての報告。"}, {"type": "subtitle", "time": 2449.003, "timestamp": "00:40:49", "text": "容疑者"}, {"type": "subtitle", "time": 2450.229, "timestamp": "00:40:50", "text": "中和済み、準備完了"}, {"type": "subtitle", "time": 2451.058, "timestamp": "00:40:51", "text": "避難前。"}, {"type": "subtitle", "time": 2452.535, "timestamp": "00:40:52", "text": "ショットガンは持っていったのか？"}, {"type": "subtitle", "time": 2456.424, "timestamp": "00:40:56", "text": "何？理解できませんでした。"}, {"type": "subtitle", "time": 2457.056, "timestamp": "00:40:57", "text": "ショットガン。"}, {"type": "subtitle", "time": 2458.719, "timestamp": "00:40:58", "text": "警察の皆さん、全員伏せてください！"}]
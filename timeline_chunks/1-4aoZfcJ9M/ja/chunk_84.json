[{"type": "subtitle", "time": 5041.647, "timestamp": "01:24:01", "text": "大砲を落とせ。やってみろ。"}, {"type": "subtitle", "time": 5042.963, "timestamp": "01:24:02", "text": "今。床の上。"}, {"type": "subtitle", "time": 5045.196, "timestamp": "01:24:05", "text": "手を挙げて。横になる。の上"}, {"type": "subtitle", "time": 5046.81, "timestamp": "01:24:06", "text": "床。手を挙げて。"}, {"type": "subtitle", "time": 5053.582, "timestamp": "01:24:13", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 5057.895, "timestamp": "01:24:17", "text": "ああ、私には無理です。"}, {"type": "subtitle", "time": 5058.857, "timestamp": "01:24:18", "text": "逮捕。"}, {"type": "subtitle", "time": 5060.841, "timestamp": "01:24:20", "text": "私にはできません。"}, {"type": "subtitle", "time": 5062.219, "timestamp": "01:24:22", "text": "逮捕。私はそうではない"}, {"type": "subtitle", "time": 5062.75, "timestamp": "01:24:22", "text": "知っている。"}, {"type": "subtitle", "time": 5065.83, "timestamp": "01:24:25", "text": "きっとあなたは"}, {"type": "subtitle", "time": 5075.62, "timestamp": "01:24:35", "text": "しかしあなたは逮捕された"}, {"type": "subtitle", "time": 5076.095, "timestamp": "01:24:36", "text": "誰か。"}, {"type": "subtitle", "time": 5094.454, "timestamp": "01:24:54", "text": "警察は今や武器だ。"}]
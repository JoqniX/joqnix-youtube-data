[{"type": "subtitle", "time": 4501.913, "timestamp": "01:15:01", "text": "はい。はい。"}, {"type": "subtitle", "time": 4508.551, "timestamp": "01:15:08", "text": "我が神よ。"}, {"type": "subtitle", "time": 4510.384, "timestamp": "01:15:10", "text": "あなたは呪いをかけていたでしょう。"}, {"type": "subtitle", "time": 4511.139, "timestamp": "01:15:11", "text": "スナイパー"}, {"type": "subtitle", "time": 4512.091, "timestamp": "01:15:12", "text": "ライフル、タイプ"}, {"type": "subtitle", "time": 4516.787, "timestamp": "01:15:16", "text": "ズームインするにはどうすればいいですか？ああ、これは… もちろんそうです。それ"}, {"type": "subtitle", "time": 4522.937, "timestamp": "01:15:22", "text": "ありがとう、テリー。私たちは"}, {"type": "subtitle", "time": 4523.865, "timestamp": "01:15:23", "text": "私たちは報告しています"}, {"type": "subtitle", "time": 4524.762, "timestamp": "01:15:24", "text": "複数の"}, {"type": "subtitle", "time": 4525.566, "timestamp": "01:15:25", "text": "ブロックから"}, {"type": "subtitle", "time": 4526.555, "timestamp": "01:15:26", "text": "医療センター"}, {"type": "subtitle", "time": 4527.421, "timestamp": "01:15:27", "text": "セント・マイケルズでは"}, {"type": "subtitle", "time": 4528.535, "timestamp": "01:15:28", "text": "テロ容疑者"}, {"type": "subtitle", "time": 4533.996, "timestamp": "01:15:33", "text": "一つずつ掃除する"}, {"type": "subtitle", "time": 4535.022, "timestamp": "01:15:35", "text": "一度に一部屋ずつ。"}, {"type": "subtitle", "time": 4538.506, "timestamp": "01:15:38", "text": "簡単です、"}, {"type": "subtitle", "time": 4542.956, "timestamp": "01:15:42", "text": "私は死んだ。"}, {"type": "subtitle", "time": 4546.56, "timestamp": "01:15:46", "text": "あなたは今、死んだのですか？"}, {"type": "subtitle", "time": 4547.691, "timestamp": "01:15:47", "text": "なんてこった？"}, {"type": "subtitle", "time": 4552.952, "timestamp": "01:15:52", "text": "なぜ彼は死なないのか？"}, {"type": "subtitle", "time": 4556.206, "timestamp": "01:15:56", "text": "お前は…お前は完全に死んでいる、"}, {"type": "subtitle", "time": 4559.415, "timestamp": "01:15:59", "text": "ジャック。ストップ、私のゲーム、"}]
[{"type": "subtitle", "time": 3182.36, "timestamp": "00:53:02", "text": "以上です。完璧です。"}, {"type": "subtitle", "time": 3183.783, "timestamp": "00:53:03", "text": "はい、準備はできました。"}, {"type": "subtitle", "time": 3186.071, "timestamp": "00:53:06", "text": "来て。ああ、わかりました。"}, {"type": "subtitle", "time": 3186.902, "timestamp": "00:53:06", "text": "何か一つ取ってください。"}, {"type": "subtitle", "time": 3188.292, "timestamp": "00:53:08", "text": "致死。絶対です"}, {"type": "subtitle", "time": 3189.69, "timestamp": "00:53:09", "text": "致死性の武器を奪う。"}, {"type": "subtitle", "time": 3190.288, "timestamp": "00:53:10", "text": "承知しました。"}, {"type": "subtitle", "time": 3193.426, "timestamp": "00:53:13", "text": "あなたはそれを受け取った。"}, {"type": "subtitle", "time": 3195.725, "timestamp": "00:53:15", "text": "ああ。ショットガンとウージー。"}, {"type": "subtitle", "time": 3199.643, "timestamp": "00:53:19", "text": "いいね、相棒。待って、"}, {"type": "subtitle", "time": 3201.078, "timestamp": "00:53:21", "text": "待って。それはどういう意味ですか？"}, {"type": "subtitle", "time": 3202.25, "timestamp": "00:53:22", "text": "ショットガン？ウジ。"}, {"type": "subtitle", "time": 3212.472, "timestamp": "00:53:32", "text": "ああ。ああ。いや、いや、ジャック。"}, {"type": "subtitle", "time": 3213.758, "timestamp": "00:53:33", "text": "私は彼を誘拐した。"}, {"type": "subtitle", "time": 3215.906, "timestamp": "00:53:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 3218.348, "timestamp": "00:53:38", "text": "わかった。"}, {"type": "subtitle", "time": 3222.86, "timestamp": "00:53:42", "text": "カット？"}, {"type": "subtitle", "time": 3226.292, "timestamp": "00:53:46", "text": "ショックだよ、兄弟。 。ええ、なぜなら。君もそういう人だ。"}, {"type": "subtitle", "time": 3228.163, "timestamp": "00:53:48", "text": "。ええ、なぜなら。君もそういう人だ。 手に持った瞬間、熱さを感じた。で、"}, {"type": "subtitle", "time": 3234.776, "timestamp": "00:53:54", "text": "わかった。爆破しないでください。"}, {"type": "subtitle", "time": 3235.67, "timestamp": "00:53:55", "text": "ドア。単に"}, {"type": "subtitle", "time": 3237.003, "timestamp": "00:53:57", "text": "豚を阻止せよ。全て"}, {"type": "subtitle", "time": 3238.514, "timestamp": "00:53:58", "text": "わかりました。私が彼だ。"}, {"type": "subtitle", "time": 3239.281, "timestamp": "00:53:59", "text": "失明した。"}]
[{"type": "subtitle", "time": 540.706, "timestamp": "00:09:00", "text": "そこにいたんですね。はい。"}, {"type": "subtitle", "time": 542.489, "timestamp": "00:09:02", "text": "今日はあなたは"}, {"type": "subtitle", "time": 543.365, "timestamp": "00:09:03", "text": "ヴィックと遊ぶために"}, {"type": "subtitle", "time": 544.524, "timestamp": "00:09:04", "text": "リラックスして、"}, {"type": "subtitle", "time": 545.557, "timestamp": "00:09:05", "text": "私にとっては"}, {"type": "subtitle", "time": 550.927, "timestamp": "00:09:10", "text": "遅い。はい。どこにいるの？"}, {"type": "subtitle", "time": 552.525, "timestamp": "00:09:12", "text": "良い。ご挨拶申し上げます。ここ。"}, {"type": "subtitle", "time": 554.129, "timestamp": "00:09:14", "text": "あなたの声は必ず届くべきです。"}, {"type": "subtitle", "time": 557.558, "timestamp": "00:09:17", "text": "私は拘束されている"}, {"type": "subtitle", "time": 559.332, "timestamp": "00:09:19", "text": "スコープ付きで。すべて順調です。"}, {"type": "subtitle", "time": 560.687, "timestamp": "00:09:20", "text": "私のことは心配しないでください。 。"}, {"type": "subtitle", "time": 569.637, "timestamp": "00:09:29", "text": "こんにちは。どうやって、どうやって、"}, {"type": "subtitle", "time": 570.882, "timestamp": "00:09:30", "text": "皆さん、お元気ですか？"}, {"type": "subtitle", "time": 572.427, "timestamp": "00:09:32", "text": "あなたの一日が素晴らしいものになりますように"}, {"type": "subtitle", "time": 577.676, "timestamp": "00:09:37", "text": "順調に進んでいます。はい、"}, {"type": "subtitle", "time": 579.194, "timestamp": "00:09:39", "text": "わかってるよ、ただ"}, {"type": "subtitle", "time": 581.913, "timestamp": "00:09:41", "text": "私はエネルギーに満ち溢れています。私、"}, {"type": "subtitle", "time": 583.119, "timestamp": "00:09:43", "text": "私は自分がとても"}, {"type": "subtitle", "time": 584.446, "timestamp": "00:09:44", "text": "ハスラー。"}, {"type": "subtitle", "time": 588.489, "timestamp": "00:09:48", "text": "まあ、そんな感じかな。"}, {"type": "subtitle", "time": 590.629, "timestamp": "00:09:50", "text": "それで、ジャックさん、"}, {"type": "subtitle", "time": 591.552, "timestamp": "00:09:51", "text": "覚えていますか"}, {"type": "subtitle", "time": 592.216, "timestamp": "00:09:52", "text": "プロトコル？"}, {"type": "subtitle", "time": 599.572, "timestamp": "00:09:59", "text": "えっと、VPNはオンになっています。"}]
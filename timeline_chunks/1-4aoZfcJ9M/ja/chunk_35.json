[{"type": "subtitle", "time": 2106.547, "timestamp": "00:35:06", "text": "作る。なぜなら… あまりにも多すぎる"}, {"type": "subtitle", "time": 2107.952, "timestamp": "00:35:07", "text": "あまりにも多すぎる 兵器。選択肢は"}, {"type": "subtitle", "time": 2110.913, "timestamp": "00:35:10", "text": "兵器。選択肢は あなた。例えば、"}, {"type": "subtitle", "time": 2112.916, "timestamp": "00:35:12", "text": "あなた。例えば、 できるかな… わかったよ、ジャック。"}, {"type": "subtitle", "time": 2114.962, "timestamp": "00:35:14", "text": "できるかな… わかったよ、ジャック。 私のアドバイスは、それを受け入れることです。"}, {"type": "subtitle", "time": 2116.182, "timestamp": "00:35:16", "text": "私のアドバイスは、それを受け入れることです。 1つは致命的で、1つは"}, {"type": "subtitle", "time": 2117.545, "timestamp": "00:35:17", "text": "1つは致命的で、1つは 非致死性だよ、わかるだろ？"}, {"type": "subtitle", "time": 2119.723, "timestamp": "00:35:19", "text": "非致死性だよ、わかるだろ？ A. どちらが良いか："}, {"type": "subtitle", "time": 2121.664, "timestamp": "00:35:21", "text": "A. どちらが良いか： 騎兵隊か…ああ、"}, {"type": "subtitle", "time": 2123.144, "timestamp": "00:35:23", "text": "騎兵隊か…ああ、 はい、両方ともそうです"}, {"type": "subtitle", "time": 2124.254, "timestamp": "00:35:24", "text": "はい、両方ともそうです 同じです。"}, {"type": "subtitle", "time": 2126.31, "timestamp": "00:35:26", "text": "はい。"}, {"type": "subtitle", "time": 2129.306, "timestamp": "00:35:29", "text": "ニトロ。わかった。"}, {"type": "subtitle", "time": 2135.245, "timestamp": "00:35:35", "text": "陶器の皿。"}, {"type": "subtitle", "time": 2136.79, "timestamp": "00:35:36", "text": "私にとって。私としては、"}, {"type": "subtitle", "time": 2138.071, "timestamp": "00:35:38", "text": "シンプルなグレネードランチャー"}, {"type": "subtitle", "time": 2140.985, "timestamp": "00:35:40", "text": "だって、ほら、私が一番だから"}, {"type": "subtitle", "time": 2142.057, "timestamp": "00:35:42", "text": "掃除中"}, {"type": "subtitle", "time": 2143.437, "timestamp": "00:35:43", "text": "1秒あたりの部屋数。"}, {"type": "subtitle", "time": 2144.963, "timestamp": "00:35:44", "text": "つまり、そういうことです。"}, {"type": "subtitle", "time": 2146.892, "timestamp": "00:35:46", "text": "それは二次的なものとなるだろう"}, {"type": "subtitle", "time": 2147.97, "timestamp": "00:35:47", "text": "スタンガン。私"}, {"type": "subtitle", "time": 2148.721, "timestamp": "00:35:48", "text": "完全に"}, {"type": "subtitle", "time": 2149.848, "timestamp": "00:35:49", "text": "非殺傷兵器。"}, {"type": "subtitle", "time": 2152.311, "timestamp": "00:35:52", "text": "ただの男が"}, {"type": "subtitle", "time": 2153.723, "timestamp": "00:35:53", "text": "すべてが弱体化し、力が"}, {"type": "subtitle", "time": 2156.331, "timestamp": "00:35:56", "text": "彼らに降伏させる。しかし、どのように"}, {"type": "subtitle", "time": 2157.488, "timestamp": "00:35:57", "text": "彼はまだ始めたばかりだ"}, {"type": "subtitle", "time": 2158.711, "timestamp": "00:35:58", "text": "撃つ、撃つ、そして"}]
[{"type": "subtitle", "time": 2821.022, "timestamp": "00:47:01", "text": "ええと、おそらくショットガンでしょう。"}, {"type": "subtitle", "time": 2828.312, "timestamp": "00:47:08", "text": "はい。ええ、確認しました。"}, {"type": "subtitle", "time": 2828.83, "timestamp": "00:47:08", "text": "今。"}, {"type": "subtitle", "time": 2834.811, "timestamp": "00:47:14", "text": "受け取り次第"}, {"type": "subtitle", "time": 2835.703, "timestamp": "00:47:15", "text": "ショットガン、ゲーム"}, {"type": "subtitle", "time": 2839.49, "timestamp": "00:47:19", "text": "終わるだろう。だから私たちは"}, {"type": "subtitle", "time": 2840.755, "timestamp": "00:47:20", "text": "心配する必要はありません"}, {"type": "subtitle", "time": 2841.89, "timestamp": "00:47:21", "text": "偽造について。"}, {"type": "subtitle", "time": 2846.371, "timestamp": "00:47:26", "text": "良い。"}, {"type": "subtitle", "time": 2855.518, "timestamp": "00:47:35", "text": "おい、彼が来たぞ。させて"}, {"type": "subtitle", "time": 2856.306, "timestamp": "00:47:36", "text": "彼はギリシャ人だ。"}, {"type": "subtitle", "time": 2859.105, "timestamp": "00:47:39", "text": "この忌まわしい証拠は、"}, {"type": "subtitle", "time": 2860.124, "timestamp": "00:47:40", "text": "お前。来て。"}, {"type": "subtitle", "time": 2865.657, "timestamp": "00:47:45", "text": "現場には警察官がいます。私"}, {"type": "subtitle", "time": 2867.043, "timestamp": "00:47:47", "text": "提供された証拠"}, {"type": "subtitle", "time": 2868.394, "timestamp": "00:47:48", "text": "あの男は"}, {"type": "subtitle", "time": 2869.212, "timestamp": "00:47:49", "text": "暗黒地帯。"}, {"type": "subtitle", "time": 2874.152, "timestamp": "00:47:54", "text": "あなたは武器を持っています"}, {"type": "subtitle", "time": 2874.85, "timestamp": "00:47:54", "text": "フラッシュ？"}, {"type": "subtitle", "time": 2876.888, "timestamp": "00:47:56", "text": "何？"}, {"type": "subtitle", "time": 2878.039, "timestamp": "00:47:58", "text": "警察、両手を"}, {"type": "subtitle", "time": 2878.663, "timestamp": "00:47:58", "text": "空気。"}]
[{"type": "subtitle", "time": 5161.933, "timestamp": "01:26:01", "text": "はい。いいえ。いいえ。"}, {"type": "subtitle", "time": 5163.097, "timestamp": "01:26:03", "text": "わかった。わかりました。"}, {"type": "subtitle", "time": 5166.114, "timestamp": "01:26:06", "text": "それは起こった、それは起こった"}, {"type": "subtitle", "time": 5167.433, "timestamp": "01:26:07", "text": "耐えられないほど"}, {"type": "subtitle", "time": 5170.862, "timestamp": "01:26:10", "text": "私たち二人とも。これはより悪い"}, {"type": "subtitle", "time": 5176.324, "timestamp": "01:26:16", "text": "わかりました。私のです、わかりました。で、"}, {"type": "subtitle", "time": 5178.605, "timestamp": "01:26:18", "text": "待って。私たちは異なる出身です"}, {"type": "subtitle", "time": 5179.895, "timestamp": "01:26:19", "text": "悪魔の大陸。"}, {"type": "subtitle", "time": 5183.716, "timestamp": "01:26:23", "text": "もちろん、999個持っています。"}, {"type": "subtitle", "time": 5187.31, "timestamp": "01:26:27", "text": "しかし、私たちはまだアジアにいる。"}, {"type": "subtitle", "time": 5188.882, "timestamp": "01:26:28", "text": "これで終わりだと思う。"}, {"type": "subtitle", "time": 5193.454, "timestamp": "01:26:33", "text": "はい。事実は"}, {"type": "subtitle", "time": 5194.463, "timestamp": "01:26:34", "text": "北でさえ"}, {"type": "subtitle", "time": 5195.707, "timestamp": "01:26:35", "text": "インドはひどいことになるだろう"}, {"type": "subtitle", "time": 5196.481, "timestamp": "01:26:36", "text": "このゲームのために"}, {"type": "subtitle", "time": 5204.393, "timestamp": "01:26:44", "text": "少なくとも。悪魔。"}, {"type": "subtitle", "time": 5208.191, "timestamp": "01:26:48", "text": "えっと、問題は、"}, {"type": "subtitle", "time": 5209.671, "timestamp": "01:26:49", "text": "私には何もできない。"}, {"type": "subtitle", "time": 5211.545, "timestamp": "01:26:51", "text": "プレイ、なぜなら、ほら、ピン"}, {"type": "subtitle", "time": 5213.551, "timestamp": "01:26:53", "text": "999。はい。"}, {"type": "subtitle", "time": 5214.269, "timestamp": "01:26:54", "text": "はい、"}, {"type": "subtitle", "time": 5215.911, "timestamp": "01:26:55", "text": "私はドイツ人のように聞こえるが、"}, {"type": "subtitle", "time": 5218.209, "timestamp": "01:26:58", "text": "いいえ。実は私のものです"}, {"type": "subtitle", "time": 5219.012, "timestamp": "01:26:59", "text": "ping 99。"}]
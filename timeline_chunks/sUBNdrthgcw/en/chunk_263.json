[{"type": "subtitle", "time": 15790.389, "timestamp": "04:23:10", "text": "That's what you're seeing. The glow that"}, {"type": "subtitle", "time": 15793.349, "timestamp": "04:23:13", "text": "surrounded them. Yes, sir."}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "Astonishing. Can I see magic? Traces of"}, {"type": "subtitle", "time": 15801.91, "timestamp": "04:23:21", "text": "an ancient magic, to be precise."}, {"type": "subtitle", "time": 15805.11, "timestamp": "04:23:25", "text": "Oh my god. Miriam had always believed"}, {"type": "subtitle", "time": 15814.55, "timestamp": "04:23:34", "text": "Miriam and perhaps George died in"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "pursuit of knowledge that has been"}, {"type": "subtitle", "time": 15819.429, "timestamp": "04:23:39", "text": "dormant for centuries."}, {"type": "subtitle", "time": 15822.149, "timestamp": "04:23:42", "text": "And you, it seems,"}, {"type": "subtitle", "time": 15824.71, "timestamp": "04:23:44", "text": "are the key to understanding why we"}, {"type": "subtitle", "time": 15826.71, "timestamp": "04:23:46", "text": "will. It all looks rather different than"}, {"type": "subtitle", "time": 15828.95, "timestamp": "04:23:48", "text": "it did a moment ago."}, {"type": "subtitle", "time": 15831.349, "timestamp": "04:23:51", "text": "Someone's coming."}, {"type": "subtitle", "time": 15834.87, "timestamp": "04:23:54", "text": "Who were they? I don't know. But sir,"}]
[{"type": "subtitle", "time": 15845.75, "timestamp": "04:24:05", "text": "I was right. Uh, Ramrock."}, {"type": "subtitle", "time": 15850.229, "timestamp": "04:24:10", "text": "Seems my reputation precedes me. I was"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "beginning to think no one was ever going"}, {"type": "subtitle", "time": 15854.87, "timestamp": "04:24:14", "text": "to visit Rakoms. Who's the person? And"}, {"type": "subtitle", "time": 15857.99, "timestamp": "04:24:17", "text": "why are you here?"}, {"type": "subtitle", "time": 15861.83, "timestamp": "04:24:21", "text": "No need for that. Just give me whatever"}, {"type": "subtitle", "time": 15863.99, "timestamp": "04:24:23", "text": "it is you found here and we can let"}, {"type": "subtitle", "time": 15872.229, "timestamp": "04:24:32", "text": "Sir,"}, {"type": "subtitle", "time": 15876.229, "timestamp": "04:24:36", "text": "they have the key to the vault."}, {"type": "subtitle", "time": 15881.03, "timestamp": "04:24:41", "text": "Choose your next words wisely. I I only"}, {"type": "subtitle", "time": 15884.149, "timestamp": "04:24:44", "text": "meant that the instructions for Vault 12"}, {"type": "subtitle", "time": 15887.429, "timestamp": "04:24:47", "text": "were quite clear."}, {"type": "subtitle", "time": 15890.469, "timestamp": "04:24:50", "text": "Sir, I I must insist. I was to grant"}, {"type": "subtitle", "time": 15892.87, "timestamp": "04:24:52", "text": "access only to one with the key, and you"}, {"type": "subtitle", "time": 15896.149, "timestamp": "04:24:56", "text": "didn't have."}]
[{"type": "subtitle", "time": 15197.189, "timestamp": "04:13:17", "text": "I see something up ahead. What is it?"}, {"type": "subtitle", "time": 15208.309, "timestamp": "04:13:28", "text": "How is this?"}, {"type": "subtitle", "time": 15210.95, "timestamp": "04:13:30", "text": "Enjoy with magic."}, {"type": "subtitle", "time": 15214.229, "timestamp": "04:13:34", "text": "Lumos, what happened?"}, {"type": "subtitle", "time": 15216.389, "timestamp": "04:13:36", "text": "When I moved towards the glow, it"}, {"type": "subtitle", "time": 15218.07, "timestamp": "04:13:38", "text": "suddenly seemed as if the ground was"}, {"type": "subtitle", "time": 15221.75, "timestamp": "04:13:41", "text": "swirling about. Are you all right? Yes,"}, {"type": "subtitle", "time": 15224.07, "timestamp": "04:13:44", "text": "sir. I'm fine."}, {"type": "subtitle", "time": 15226.149, "timestamp": "04:13:46", "text": "You seem to have caused the floor to"}, {"type": "subtitle", "time": 15227.99, "timestamp": "04:13:47", "text": "change."}, {"type": "subtitle", "time": 15229.67, "timestamp": "04:13:49", "text": "statue."}, {"type": "subtitle", "time": 15232.229, "timestamp": "04:13:52", "text": "What statue?"}, {"type": "subtitle", "time": 15234.87, "timestamp": "04:13:54", "text": "I see some sort of statue, but only as a"}, {"type": "subtitle", "time": 15238.389, "timestamp": "04:13:58", "text": "reflection in the floor."}, {"type": "subtitle", "time": 15239.91, "timestamp": "04:13:59", "text": "Laurelia,"}]
[{"type": "subtitle", "time": 23417.43, "timestamp": "06:30:17", "text": "Can I help you?"}, {"type": "subtitle", "time": 23419.43, "timestamp": "06:30:19", "text": "Sebastian told me to see you about a"}, {"type": "subtitle", "time": 23421.99, "timestamp": "06:30:21", "text": "club. If Sebastian vouches for you,"}, {"type": "subtitle", "time": 23424.468, "timestamp": "06:30:24", "text": "that's all I need to know. I coordinated"}, {"type": "subtitle", "time": 23427.43, "timestamp": "06:30:27", "text": "jewels for crossed ones. A dueling club"}, {"type": "subtitle", "time": 23430.23, "timestamp": "06:30:30", "text": "of sorts, but it's invitation only. So,"}, {"type": "subtitle", "time": 23431.51, "timestamp": "06:30:31", "text": "you must have really impressed"}, {"type": "subtitle", "time": 23433.11, "timestamp": "06:30:33", "text": "Sebastian."}, {"type": "subtitle", "time": 23436.02, "timestamp": "06:30:36", "text": "Yes,"}, {"type": "subtitle", "time": 23437.43, "timestamp": "06:30:37", "text": "[Music]"}, {"type": "subtitle", "time": 23439.43, "timestamp": "06:30:39", "text": "I seem to have a knack for dueling."}, {"type": "subtitle", "time": 23441.59, "timestamp": "06:30:41", "text": "Then, you've come to the right place."}, {"type": "subtitle", "time": 23443.83, "timestamp": "06:30:43", "text": "How does cross ones work exactly? You"}, {"type": "subtitle", "time": 23445.59, "timestamp": "06:30:45", "text": "show up, I match you with other"}, {"type": "subtitle", "time": 23447.83, "timestamp": "06:30:47", "text": "jewelists, and whoever is still standing"}, {"type": "subtitle", "time": 23450.23, "timestamp": "06:30:50", "text": "in the end wins. It's our way of"}, {"type": "subtitle", "time": 23451.43, "timestamp": "06:30:51", "text": "determining the school's greatest"}, {"type": "subtitle", "time": 23454.31, "timestamp": "06:30:54", "text": "journalist once and for all. And to"}, {"type": "subtitle", "time": 23456.788, "timestamp": "06:30:56", "text": "liven things up, the winner is awarded a"}, {"type": "subtitle", "time": 23459.83, "timestamp": "06:30:59", "text": "prize. Interested?"}]
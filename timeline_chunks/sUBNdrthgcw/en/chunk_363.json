[{"type": "subtitle", "time": 21800.23, "timestamp": "06:03:20", "text": "Professor Heckit, perhaps you'd be good"}, {"type": "subtitle", "time": 21802.07, "timestamp": "06:03:22", "text": "enough to blast each other to pieces on"}, {"type": "subtitle", "time": 21804.708, "timestamp": "06:03:24", "text": "your own time. I get new students every"}, {"type": "subtitle", "time": 21807.35, "timestamp": "06:03:27", "text": "year, but I only have one Hebrdian black"}, {"type": "subtitle", "time": 21808.868, "timestamp": "06:03:28", "text": "skull."}, {"type": "subtitle", "time": 21810.868, "timestamp": "06:03:30", "text": "It was a token from the great poacher"}, {"type": "subtitle", "time": 21813.83, "timestamp": "06:03:33", "text": "raid of 1878. No doubt you've heard of"}, {"type": "subtitle", "time": 21816.47, "timestamp": "06:03:36", "text": "it. Okay. Now, you may be asking"}, {"type": "subtitle", "time": 21818.31, "timestamp": "06:03:38", "text": "yourself how an old woman like me"}, {"type": "subtitle", "time": 21820.07, "timestamp": "06:03:40", "text": "single-handedly took out the largest"}, {"type": "subtitle", "time": 21822.708, "timestamp": "06:03:42", "text": "poetry ring in Eastern Wales and lived"}, {"type": "subtitle", "time": 21825.35, "timestamp": "06:03:45", "text": "to boast about it."}, {"type": "subtitle", "time": 21828.23, "timestamp": "06:03:48", "text": "Knowledge."}, {"type": "subtitle", "time": 21835.11, "timestamp": "06:03:55", "text": "matters very little. Today, we will"}, {"type": "subtitle", "time": 21837.19, "timestamp": "06:03:57", "text": "review a spell that has saved me from"}, {"type": "subtitle", "time": 21839.27, "timestamp": "06:03:59", "text": "death at the hands of dark wizards more"}]
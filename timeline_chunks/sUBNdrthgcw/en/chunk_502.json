[{"type": "subtitle", "time": 30129.11, "timestamp": "08:22:09", "text": "Everyone get"}, {"type": "subtitle", "time": 30134.788, "timestamp": "08:22:14", "text": "I told you not to go down that path."}, {"type": "subtitle", "time": 30136.708, "timestamp": "08:22:16", "text": "Miss P from Rud and Peek said a customer"}, {"type": "subtitle", "time": 30138.708, "timestamp": "08:22:18", "text": "lost a deal around here. I know we're"}, {"type": "subtitle", "time": 30140.468, "timestamp": "08:22:20", "text": "not supposed to go down there. I just"}, {"type": "subtitle", "time": 30162.788, "timestamp": "08:22:42", "text": "Can you use your magic to make me"}, {"type": "subtitle", "time": 30164.468, "timestamp": "08:22:44", "text": "handsome?"}, {"type": "subtitle", "time": 30167.43, "timestamp": "08:22:47", "text": "But already you are beautiful."}, {"type": "subtitle", "time": 30170.388, "timestamp": "08:22:50", "text": "What do you mean? Vonia."}]
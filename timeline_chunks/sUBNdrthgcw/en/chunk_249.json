[{"type": "subtitle", "time": 14941.83, "timestamp": "04:09:01", "text": "This is sus. Have you seen Harry Potter"}, {"type": "subtitle", "time": 14955.51, "timestamp": "04:09:15", "text": "Wait, did I choose the colored eye"}, {"type": "subtitle", "time": 14957.83, "timestamp": "04:09:17", "text": "color? Let me check. Professor, the"}, {"type": "subtitle", "time": 14959.349, "timestamp": "04:09:19", "text": "armband the her guard was wearing was"}, {"type": "subtitle", "time": 14962.07, "timestamp": "04:09:22", "text": "glowing. Like the glow you saw on the"}, {"type": "subtitle", "time": 14965.349, "timestamp": "04:09:25", "text": "porky container. No, darker. I saw that"}, {"type": "subtitle", "time": 14967.269, "timestamp": "04:09:27", "text": "same glow on the dragon's collar. Yeah."}, {"type": "subtitle", "time": 14968.87, "timestamp": "04:09:28", "text": "What was that? We were just wondering"}, {"type": "subtitle", "time": 14971.429, "timestamp": "04:09:31", "text": "about that goblet back there. He watches"}, {"type": "subtitle", "time": 14974.469, "timestamp": "04:09:34", "text": "over the oldest section of the bank."}, {"type": "subtitle", "time": 14982.15, "timestamp": "04:09:42", "text": "I don't know much about hypocrisy"}, {"type": "subtitle", "time": 14983.99, "timestamp": "04:09:43", "text": "though, but it's it's really long long"}, {"type": "subtitle", "time": 14987.99, "timestamp": "04:09:47", "text": "ago since I watched it."}, {"type": "subtitle", "time": 14998.87, "timestamp": "04:09:58", "text": "[Music]"}]
[{"type": "subtitle", "time": 24902.948, "timestamp": "06:55:02", "text": "Wait though. I'm getting cold again."}, {"type": "subtitle", "time": 24932.23, "timestamp": "06:55:32", "text": "[Music]"}, {"type": "subtitle", "time": 24934.39, "timestamp": "06:55:34", "text": "I was glad Professor Weasley asked me to"}, {"type": "subtitle", "time": 24938.548, "timestamp": "06:55:38", "text": "accompany you. Really? Yes. I had"}, {"type": "subtitle", "time": 24940.548, "timestamp": "06:55:40", "text": "planned to extend an invitation to you"}, {"type": "subtitle", "time": 24942.628, "timestamp": "06:55:42", "text": "myself. I thought you might enjoy a"}, {"type": "subtitle", "time": 24945.11, "timestamp": "06:55:45", "text": "better be in the village."}, {"type": "subtitle", "time": 24947.35, "timestamp": "06:55:47", "text": "The timing of Professor Weasley's owl"}, {"type": "subtitle", "time": 24948.92, "timestamp": "06:55:48", "text": "was perfect."}]
[{"type": "subtitle", "time": 26101.35, "timestamp": "07:15:01", "text": "Do you think Poppy's already seen the"}, {"type": "subtitle", "time": 26103.11, "timestamp": "07:15:03", "text": "hippogs?"}, {"type": "subtitle", "time": 26104.868, "timestamp": "07:15:04", "text": "Absolutely."}, {"type": "subtitle", "time": 26107.99, "timestamp": "07:15:07", "text": "Likely already named them, too."}, {"type": "subtitle", "time": 26111.11, "timestamp": "07:15:11", "text": "Oh my god, they're shuttering, though."}, {"type": "subtitle", "time": 26118.07, "timestamp": "07:15:18", "text": "That's a forbidden forest on the left."}, {"type": "subtitle", "time": 26120.948, "timestamp": "07:15:20", "text": "It's off limits to students as the name"}, {"type": "subtitle", "time": 26124.548, "timestamp": "07:15:24", "text": "implies. Why is it off limits? The"}, {"type": "subtitle", "time": 26127.59, "timestamp": "07:15:27", "text": "professors claim it is too dangerous. I"}, {"type": "subtitle", "time": 26129.51, "timestamp": "07:15:29", "text": "think that calling it forbidden only"}, {"type": "subtitle", "time": 26132.628, "timestamp": "07:15:32", "text": "makes it more alluring. Ah, this horse"}, {"type": "subtitle", "time": 26136.788, "timestamp": "07:15:36", "text": "meat over the crest pass ruin."}, {"type": "subtitle", "time": 26142.548, "timestamp": "07:15:42", "text": "These are the stuff required for the"}, {"type": "subtitle", "time": 26146.23, "timestamp": "07:15:46", "text": "health a health potion I believe."}, {"type": "subtitle", "time": 26157.43, "timestamp": "07:15:57", "text": "Oh my god."}]
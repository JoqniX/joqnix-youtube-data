[{"type": "subtitle", "time": 41164.07, "timestamp": "11:26:04", "text": "發佈"}, {"type": "subtitle", "time": 41166.55, "timestamp": "11:26:06", "text": "直播時間表，然後就發生了 Billy Billy 的免費活動。所以"}, {"type": "subtitle", "time": 41168.95, "timestamp": "11:26:08", "text": "我必須專注於此。"}, {"type": "subtitle", "time": 41172.79, "timestamp": "11:26:12", "text": "花三週時間做這件事"}, {"type": "subtitle", "time": 41175.586, "timestamp": "11:26:15", "text": "。所以這事兒就發生在明天，星期六，"}, {"type": "subtitle", "time": 41178.71, "timestamp": "11:26:18", "text": "對吧？根據"}, {"type": "subtitle", "time": 41188.07, "timestamp": "11:26:28", "text": "我所製定的"}, {"type": "subtitle", "time": 41202.07, "timestamp": "11:26:42", "text": "計劃，週日將是我一週的開始。嗯，是的，星期天。是的。所以下週將是我最後一週關注"}, {"type": "subtitle", "time": 41204.71, "timestamp": "11:26:44", "text": "比利比利了"}, {"type": "subtitle", "time": 41207.67, "timestamp": "11:26:47", "text": "。所以我必須確保把它們全部完成。"}, {"type": "subtitle", "time": 41210.23, "timestamp": "11:26:50", "text": "所以從二月第四周開始，"}, {"type": "subtitle", "time": 41216.47, "timestamp": "11:26:56", "text": "我終於可以恢復正常的直播行程了"}]
[{"type": "subtitle", "time": 20822.868, "timestamp": "05:47:02", "text": "。  那裡有一尊佛像。  S 格雷戈里用"}, {"type": "subtitle", "time": 20825.27, "timestamp": "05:47:05", "text": "環形穀物傳播中世紀的 viz guri 做媽媽 sia"}, {"type": "subtitle", "time": 20827.35, "timestamp": "05:47:07", "text": "。這位因發明了製作飲料的 roanchious uncan 部分而"}, {"type": "subtitle", "time": 20830.15, "timestamp": "05:47:10", "text": "聞名的 viz。真不敢相信我們給了他們什麼。她是她"}, {"type": "subtitle", "time": 20854.31, "timestamp": "05:47:34", "text": "最好的"}, {"type": "subtitle", "time": 20857.67, "timestamp": "05:47:37", "text": "朋友。"}]
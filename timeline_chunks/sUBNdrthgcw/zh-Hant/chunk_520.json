[{"type": "subtitle", "time": 31201.51, "timestamp": "08:40:01", "text": "簡單？真的什麼都沒有。怎麼可能？這簡直是我看過最簡單的場景了。我的天啊。"}, {"type": "subtitle", "time": 31211.59, "timestamp": "08:40:11", "text": "遊戲什麼的。你只需要加入遊戲、麥克風、遊戲音樂。就這麼簡單。"}, {"type": "subtitle", "time": 31224.708, "timestamp": "08:40:24", "text": "什麼？"}, {"type": "subtitle", "time": 31227.67, "timestamp": "08:40:27", "text": "我心想，餵。你以為我一直在做什麼？幾年？我之前為了一個場景就用了80多個素材。就拿對話場景來說，我用了大概87、90個素材，好多"}, {"type": "subtitle", "time": 31244.07, "timestamp": "08:40:44", "text": "音訊、好多插件、好多動畫。"}, {"type": "subtitle", "time": 31248.948, "timestamp": "08:40:48", "text": "相較之下，"}, {"type": "subtitle", "time": 31259.75, "timestamp": "08:40:59", "text": "痛苦沒有回報，什麼回報？回報是"}]
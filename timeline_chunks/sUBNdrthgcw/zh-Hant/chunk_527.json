[{"type": "subtitle", "time": 31648.628, "timestamp": "08:47:28", "text": "我會說你該調整作息嗎，笨蛋？你覺得我會說那輛麵包車好嗎？"}, {"type": "subtitle", "time": 31666.468, "timestamp": "08:47:46", "text": "你什麼意思？有多少個忍者？哈利波特，還有帶龍的獅子木麵包車。這些都是圖表。為什麼它會突然出現，還跟新圖表混在一起？什麼？機器裡的"}, {"type": "subtitle", "time": 31674.07, "timestamp": "08:47:54", "text": "幽靈。等等。"}, {"type": "subtitle", "time": 31679.59, "timestamp": "08:47:59", "text": "呃，我想測試一下"}]
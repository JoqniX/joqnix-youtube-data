[{"type": "subtitle", "time": 6738.55, "timestamp": "01:52:18", "text": "。  我們"}, {"type": "subtitle", "time": 6743.75, "timestamp": "01:52:23", "text": "走吧。  好的。  我的天，那東西好可怕。"}, {"type": "subtitle", "time": 6754.31, "timestamp": "01:52:34", "text": "你剛才看到的那些東西，對吧"}, {"type": "subtitle", "time": 6775.83, "timestamp": "01:52:55", "text": "。  [音樂] 好了，這麼多人。我們只需要……呃……"}]
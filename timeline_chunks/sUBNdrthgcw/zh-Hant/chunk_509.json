[{"type": "subtitle", "time": 30585.83, "timestamp": "08:29:45", "text": "新賽季要來了之類的"}, {"type": "subtitle", "time": 30589.91, "timestamp": "08:29:49", "text": "。是的，我看到了那個東西。"}, {"type": "subtitle", "time": 30592.548, "timestamp": "08:29:52", "text": "我當時就想，「哇，這太酷了。」《一拳超人》三月上映。"}, {"type": "subtitle", "time": 30596.23, "timestamp": "08:29:56", "text": "哇。該死"}, {"type": "subtitle", "time": 30598.708, "timestamp": "08:29:58", "text": "。"}]
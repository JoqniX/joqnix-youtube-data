[{"type": "subtitle", "time": 36241.746, "timestamp": "10:04:01", "text": "但當這個問題擺在"}, {"type": "subtitle", "time": 36244.23, "timestamp": "10:04:04", "text": "我面前時，喔不。我當時就想，喔不，我該怎麼辦？  我該怎麼辦？我該怎麼辦？ H：所以"}, {"type": "subtitle", "time": 36267.99, "timestamp": "10:04:27", "text": "，我主要是跟他一起去的，因為"}, {"type": "subtitle", "time": 36279.426, "timestamp": "10:04:39", "text": "我是男生，你知道的。所以，但是，但是也像，嗯，但也為了Jock。我希望"}, {"type": "subtitle", "time": 36281.746, "timestamp": "10:04:41", "text": "Jock 是……"}, {"type": "subtitle", "time": 36285.99, "timestamp": "10:04:45", "text": "不，我不想……我不想讓"}, {"type": "subtitle", "time": 36290.15, "timestamp": "10:04:50", "text": "Jock 更像是……被固定在一種性別上。我不知道。更像是"}]
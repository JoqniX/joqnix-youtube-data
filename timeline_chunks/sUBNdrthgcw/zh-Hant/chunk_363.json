[{"type": "subtitle", "time": 21800.23, "timestamp": "06:03:20", "text": "衛斯理教授告訴我，你需要去霍格斯皮德"}, {"type": "subtitle", "time": 21804.708, "timestamp": "06:03:24", "text": "。你一定很渴望重新擁有自己的東西和村莊。我一直很期待。"}, {"type": "subtitle", "time": 21816.47, "timestamp": "06:03:36", "text": "好的。我們出發吧？我打算為你"}, {"type": "subtitle", "time": 21820.07, "timestamp": "06:03:40", "text": "帶來一流的"}, {"type": "subtitle", "time": 21822.708, "timestamp": "06:03:42", "text": "Hogsme體驗。  等等。我又開始覺得冷了。  鮑比（"}, {"type": "subtitle", "time": 21831.75, "timestamp": "06:03:51", "text": "音樂）：我很高興衛斯理教授邀請我來為你伴奏。真的嗎？是的。"}, {"type": "subtitle", "time": 21835.11, "timestamp": "06:03:55", "text": "我原本打算親自邀請你。我想你可能會"}, {"type": "subtitle", "time": 21839.27, "timestamp": "06:03:59", "text": "更喜歡住在村子裡"}]
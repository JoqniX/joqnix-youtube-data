[{"type": "subtitle", "time": 42124.31, "timestamp": "11:42:04", "text": "第一部分或第二部分是轉換的部分。但後來我想，是啊，"}, {"type": "subtitle", "time": 42127.266, "timestamp": "11:42:07", "text": "你知道嗎？  如果視頻長度超過"}, {"type": "subtitle", "time": 42137.67, "timestamp": "11:42:17", "text": "10 小時或檔案大小超過 8 GB，是不是最好下載整個視頻，然後分成"}, {"type": "subtitle", "time": 42142.07, "timestamp": "11:42:22", "text": "兩部分或多部分，再一部分一部分"}, {"type": "subtitle", "time": 42145.83, "timestamp": "11:42:25", "text": "上傳？所以我照做了。這樣速度更快。  這就是它效率更高的原因。所以，"}, {"type": "subtitle", "time": 42154.15, "timestamp": "11:42:34", "text": "就像《Billy Billy》裡那樣，存在著"}, {"type": "subtitle", "time": 42179.746, "timestamp": "11:42:59", "text": "一種層次感。是的，升級有兩種類型。一是帳戶層面的"}]
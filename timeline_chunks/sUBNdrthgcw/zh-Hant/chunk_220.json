[{"type": "subtitle", "time": 13225.67, "timestamp": "03:40:25", "text": "金石。那是什麼？我自己的小"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "表情。"}, {"type": "subtitle", "time": 13231.91, "timestamp": "03:40:31", "text": "我從家裡帶了這株"}, {"type": "subtitle", "time": 13239.269, "timestamp": "03:40:39", "text": "丹尼幼苗，我真希望他能感到舒適。丹尼很棒，不是嗎？擁有強大的治癒能力。醫生，指揮官在工作嗎"}, {"type": "subtitle", "time": 13253.75, "timestamp": "03:40:53", "text": "？什麼指揮官？"}, {"type": "subtitle", "time": 13256.71, "timestamp": "03:40:56", "text": "有點……嗯，我沒用即時值班"}]
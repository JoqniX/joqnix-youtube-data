[{"type": "subtitle", "time": 11832.79, "timestamp": "03:17:12", "text": "好主意。哪一座城堡是由那古老的魔法建造的，而且它本身也是那"}, {"type": "subtitle", "time": 11844.15, "timestamp": "03:17:24", "text": "古老魔法的堡壘？"}, {"type": "subtitle", "time": 11856.309, "timestamp": "03:17:36", "text": "我不知道"}, {"type": "subtitle", "time": 11859.19, "timestamp": "03:17:39", "text": "她從哪裡得到了港口鑰匙，但"}, {"type": "subtitle", "time": 11874.63, "timestamp": "03:17:54", "text": "我確信這與那次搜尋有關。"}, {"type": "subtitle", "time": 11876.15, "timestamp": "03:17:56", "text": "啊，下面就是路。這邊"}]
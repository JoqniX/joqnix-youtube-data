[{"type": "subtitle", "time": 12909.429, "timestamp": "03:35:09", "text": "很好。很高興聽到這個消息。真的，沒有緊張是有原因的。"}, {"type": "subtitle", "time": 12919.59, "timestamp": "03:35:19", "text": "大多數教授都很嚴格但公平。我的"}, {"type": "subtitle", "time": 12925.59, "timestamp": "03:35:25", "text": "意思是，我耍的那些花招可不只是丟個糞彈那麼簡單"}, {"type": "subtitle", "time": 12942.63, "timestamp": "03:35:42", "text": "。而且我還在。等等，你說大多數教授都很嚴格但公平？嗯？我的確這麼說了，不過最好還是讓你自己"}]
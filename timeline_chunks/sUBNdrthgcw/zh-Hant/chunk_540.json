[{"type": "subtitle", "time": 32400.468, "timestamp": "09:00:00", "text": "我忘了。巴卡，你在直播，你來過。"}, {"type": "subtitle", "time": 32402.308, "timestamp": "09:00:02", "text": "哦，對，他……哦，對，他們在直播。 [音樂]正在直播，然後凱來了"}, {"type": "subtitle", "time": 32410.07, "timestamp": "09:00:10", "text": "。凱，謝謝你來，這對我意義重大。希望你能和維克娜一起玩。我會告訴維克娜接受不同的"}, {"type": "subtitle", "time": 32421.43, "timestamp": "09:00:21", "text": "請求之類的。問題是，是誰打斷了你？是我嗎？"}, {"type": "subtitle", "time": 32432.388, "timestamp": "09:00:32", "text": "媽媽，因為我知道我需要照顧好她們"}, {"type": "subtitle", "time": 32434.948, "timestamp": "09:00:34", "text": "四個，對吧？媽媽、奶奶和媽媽因為他們病得很重。所以我必須在他們需要的時候都在。所以，是的。這確實很痛苦。這就是為什麼"}, {"type": "subtitle", "time": 32448.07, "timestamp": "09:00:48", "text": "我把"}, {"type": "subtitle", "time": 32449.67, "timestamp": "09:00:49", "text": "直播時間調整到早上和晚上，這樣晚上"}]
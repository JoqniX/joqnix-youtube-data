[{"type": "subtitle", "time": 16861.59, "timestamp": "04:41:01", "text": "在他转身之前。他是个谜。如图"}, {"type": "subtitle", "time": 16863.91, "timestamp": "04:41:03", "text": "教授理论，但似乎也懂一些"}, {"type": "subtitle", "time": 16865.67, "timestamp": "04:41:05", "text": "很多关于实用魔法的内容。谜。"}, {"type": "subtitle", "time": 16871.83, "timestamp": "04:41:11", "text": "他知识渊博。菲格教授"}, {"type": "subtitle", "time": 16874.15, "timestamp": "04:41:14", "text": "确实对这个了解很多。"}, {"type": "subtitle", "time": 16876.15, "timestamp": "04:41:16", "text": "不同形式的魔法。我希望如此。"}, {"type": "subtitle", "time": 16877.91, "timestamp": "04:41:17", "text": "他跟你讲的不仅仅是假发的事。"}, {"type": "subtitle", "time": 16880.23, "timestamp": "04:41:20", "text": "焊接。你有很多事要跟上，我"}, {"type": "subtitle", "time": 16885.83, "timestamp": "04:41:25", "text": "难道不是赫奇帕奇学院的人喜欢那样吗？一个"}, {"type": "subtitle", "time": 16887.75, "timestamp": "04:41:27", "text": "对女权主义的兴趣更为典型"}, {"type": "subtitle", "time": 16889.99, "timestamp": "04:41:29", "text": "与其说是拉文克劳，不如说是赫奇帕奇，不是吗？"}, {"type": "subtitle", "time": 16892.47, "timestamp": "04:41:32", "text": "通常情况下或许如此，但这在我的血液里流传开来。"}, {"type": "subtitle", "time": 16894.55, "timestamp": "04:41:34", "text": "家庭。我们有这些的完整地块。"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "家里的小家伙们。我想你"}, {"type": "subtitle", "time": 16904.23, "timestamp": "04:41:44", "text": "学生这样做是否是常见的做法？"}, {"type": "subtitle", "time": 16907.03, "timestamp": "04:41:47", "text": "他们自己种植原料吗？哦是的。在"}, {"type": "subtitle", "time": 16909.11, "timestamp": "04:41:49", "text": "事实上，我们的草药学老师，教授"}, {"type": "subtitle", "time": 16911.67, "timestamp": "04:41:51", "text": "大蒜会促进这种现象。而且我不认为"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "我们的魔药大师夏普教授"}, {"type": "subtitle", "time": 16915.67, "timestamp": "04:41:55", "text": "它很在意你从哪里采购食材，因为"}]
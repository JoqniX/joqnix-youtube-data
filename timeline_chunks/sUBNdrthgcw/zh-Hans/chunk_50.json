[{"type": "subtitle", "time": 3003.349, "timestamp": "00:50:03", "text": "请选择数字。"}, {"type": "subtitle", "time": 3013.27, "timestamp": "00:50:13", "text": "你喜欢什么颜色都行。"}, {"type": "subtitle", "time": 3015.43, "timestamp": "00:50:15", "text": "以你的性格，它要么是蓝色，要么是……"}, {"type": "subtitle", "time": 3020.309, "timestamp": "00:50:20", "text": "呃"}, {"type": "subtitle", "time": 3022.47, "timestamp": "00:50:22", "text": "了解了奇玛之后，就会像"}, {"type": "subtitle", "time": 3026.63, "timestamp": "00:50:26", "text": "蓝色，紫色。是的。等一下。"}, {"type": "subtitle", "time": 3031.75, "timestamp": "00:50:31", "text": "我在这里填了什么？啊，搞错了。"}, {"type": "subtitle", "time": 3040.23, "timestamp": "00:50:40", "text": "呃，"}, {"type": "subtitle", "time": 3050.04, "timestamp": "00:50:50", "text": "13."}, {"type": "subtitle", "time": 3052.23, "timestamp": "00:50:52", "text": "[音乐]"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "兄弟，为什么每个人都要做出选择？因为"}, {"type": "subtitle", "time": 3058.15, "timestamp": "00:50:58", "text": "他们喜欢。七。"}]
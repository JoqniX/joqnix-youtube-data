[{"type": "subtitle", "time": 7447.27, "timestamp": "02:04:07", "text": "我的意思是，我们现在就把它放上去。所以"}, {"type": "subtitle", "time": 7450.95, "timestamp": "02:04:10", "text": "没关系。我想如果它崩溃了，我们可以"}, {"type": "subtitle", "time": 7459.91, "timestamp": "02:04:19", "text": "我的天哪。就这些了。"}, {"type": "subtitle", "time": 7463.669, "timestamp": "02:04:23", "text": "拿到Brona了。哦，真好，真好，真好。"}, {"type": "subtitle", "time": 7466.07, "timestamp": "02:04:26", "text": "你还在玩《星际争霸》。哦，不。呃，"}, {"type": "subtitle", "time": 7476.2, "timestamp": "02:04:36", "text": "哦，我的头好痛。"}, {"type": "subtitle", "time": 7479.51, "timestamp": "02:04:39", "text": "[音乐]"}, {"type": "subtitle", "time": 7483.03, "timestamp": "02:04:43", "text": "你到底怎么了，这家伙？"}, {"type": "subtitle", "time": 7487.669, "timestamp": "02:04:47", "text": "我的天哪，又是NDI。我恨它。"}, {"type": "subtitle", "time": 7491.43, "timestamp": "02:04:51", "text": "我恨你。"}, {"type": "subtitle", "time": 7493.83, "timestamp": "02:04:53", "text": "等等，它为什么在吃东西？"}, {"type": "subtitle", "time": 7496.709, "timestamp": "02:04:56", "text": "134.5？"}]
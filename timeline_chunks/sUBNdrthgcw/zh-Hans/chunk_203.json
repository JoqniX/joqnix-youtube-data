[{"type": "subtitle", "time": 12184.07, "timestamp": "03:23:04", "text": "但你什么都听到了。你听到我的"}, {"type": "subtitle", "time": 12188.07, "timestamp": "03:23:08", "text": "桌子。我的天啊。这就是感觉吗？"}, {"type": "subtitle", "time": 12197.19, "timestamp": "03:23:17", "text": "是的。你好。呃，阿迪萨。是的。你好。"}, {"type": "subtitle", "time": 12200.229, "timestamp": "03:23:20", "text": "你好吗？呃，今天有点小瑕疵。"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "直播是因为我的显卡……我……"}, {"type": "subtitle", "time": 12206.15, "timestamp": "03:23:26", "text": "需要更换零件，但我需要修理它。所以，我"}, {"type": "subtitle", "time": 12207.91, "timestamp": "03:23:27", "text": "今天没能完成，因为我没有"}, {"type": "subtitle", "time": 12209.83, "timestamp": "03:23:29", "text": "准备一把螺丝刀。"}, {"type": "subtitle", "time": 12212.63, "timestamp": "03:23:32", "text": "嗯，我们明天会做这件事。"}, {"type": "subtitle", "time": 12214.71, "timestamp": "03:23:34", "text": "我会尽快解决，我会恢复正常。"}, {"type": "subtitle", "time": 12217.51, "timestamp": "03:23:37", "text": "明天开始准备。好的。所以，我希望"}, {"type": "subtitle", "time": 12220.55, "timestamp": "03:23:40", "text": "今天一切都还好。"}, {"type": "subtitle", "time": 12222.469, "timestamp": "03:23:42", "text": "是的。是的。是的。是的。呃，请让"}, {"type": "subtitle", "time": 12224.15, "timestamp": "03:23:44", "text": "如果你听到音频，请告诉我。我是"}, {"type": "subtitle", "time": 12226.469, "timestamp": "03:23:46", "text": "正在尝试修复音频问题。我的天啊，这"}, {"type": "subtitle", "time": 12229.19, "timestamp": "03:23:49", "text": "是疼痛。"}, {"type": "subtitle", "time": 12231.19, "timestamp": "03:23:51", "text": "好的。所以，"}, {"type": "subtitle", "time": 12234.07, "timestamp": "03:23:54", "text": "为什么我什么都听不到？"}, {"type": "subtitle", "time": 12238.07, "timestamp": "03:23:58", "text": "哦，我把它静音了。真是个笨蛋。"}]
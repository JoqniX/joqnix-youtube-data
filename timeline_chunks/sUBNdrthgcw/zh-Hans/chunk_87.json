[{"type": "subtitle", "time": 5224.07, "timestamp": "01:27:04", "text": "呃，Arisa 说七。好的，第七点。"}, {"type": "subtitle", "time": 5227.59, "timestamp": "01:27:07", "text": "喵呜说“捏”"}, {"type": "subtitle", "time": 5229.83, "timestamp": "01:27:09", "text": "六个人说。是的。"}, {"type": "subtitle", "time": 5237.189, "timestamp": "01:27:17", "text": "再聊一次。邀请。"}, {"type": "subtitle", "time": 5240.55, "timestamp": "01:27:20", "text": "让我一个一个地来。还有谁？呃，"}, {"type": "subtitle", "time": 5243.99, "timestamp": "01:27:23", "text": "罗科说了什么？"}, {"type": "subtitle", "time": 5247.27, "timestamp": "01:27:27", "text": "嗯，我喜欢紫色。 14. 好的，罗科想要"}, {"type": "subtitle", "time": 5250.629, "timestamp": "01:27:30", "text": "14. 呃，我们已经做过第 14 题了，对吧？那是"}, {"type": "subtitle", "time": 5253.51, "timestamp": "01:27:33", "text": "贾根斯。"}, {"type": "subtitle", "time": 5255.43, "timestamp": "01:27:35", "text": "[音乐]"}, {"type": "subtitle", "time": 5276.229, "timestamp": "01:27:56", "text": "你好。呃，"}, {"type": "subtitle", "time": 5279.189, "timestamp": "01:27:59", "text": "还有其他人吗？妈妈说了什么？"}]
[{"type": "subtitle", "time": 12421.19, "timestamp": "03:27:01", "text": "我被分到了拉文克劳学院，而且我的"}, {"type": "subtitle", "time": 12424.95, "timestamp": "03:27:04", "text": "魔杖是凤凰羽毛，呈黑色。"}, {"type": "subtitle", "time": 12427.269, "timestamp": "03:27:07", "text": "就在这里。这个，黑色的"}, {"type": "subtitle", "time": 12429.91, "timestamp": "03:27:09", "text": "音色，以及 12.5 英寸。是的，"}, {"type": "subtitle", "time": 12432.79, "timestamp": "03:27:12", "text": "我买的是这款，黑色款。"}, {"type": "subtitle", "time": 12437.11, "timestamp": "03:27:17", "text": "我所在的学院是拉文克劳学院。"}, {"type": "subtitle", "time": 12438.79, "timestamp": "03:27:18", "text": "我们不这么叫，兄弟。等等，你是……"}, {"type": "subtitle", "time": 12441.03, "timestamp": "03:27:21", "text": "真正的？不。"}, {"type": "subtitle", "time": 12446.07, "timestamp": "03:27:26", "text": "我检查了一下，看起来不太好。等待，"}, {"type": "subtitle", "time": 12448.87, "timestamp": "03:27:28", "text": "你看到颗粒感了吗？"}, {"type": "subtitle", "time": 12452.229, "timestamp": "03:27:32", "text": "哦，我用的是P P5。我忘了改"}, {"type": "subtitle", "time": 12455.429, "timestamp": "03:27:35", "text": "P6。我的错。呃，我会修好的。"}, {"type": "subtitle", "time": 12457.429, "timestamp": "03:27:37", "text": "等我恢复到平时的工作状态后，我会的。"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "我要P6。"}, {"type": "subtitle", "time": 12463.67, "timestamp": "03:27:43", "text": "呃，设置。我需要把所有东西都放进去。"}, {"type": "subtitle", "time": 12466.79, "timestamp": "03:27:46", "text": "低"}, {"type": "subtitle", "time": 12472.229, "timestamp": "03:27:52", "text": "没错。"}, {"type": "subtitle", "time": 12476.71, "timestamp": "03:27:56", "text": "窗口模式。是的。以及呃，运动"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "模糊。不，我永远不想把模糊效果吹进去。"}]
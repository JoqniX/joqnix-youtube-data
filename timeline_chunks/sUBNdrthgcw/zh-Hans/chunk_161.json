[{"type": "subtitle", "time": 9661.99, "timestamp": "02:41:01", "text": "今年"}, {"type": "subtitle", "time": 9665.349, "timestamp": "02:41:05", "text": "而不是基本款。去年我们这样做了"}, {"type": "subtitle", "time": 9667.91, "timestamp": "02:41:07", "text": "是这样，对吧？去年只是"}, {"type": "subtitle", "time": 9670.79, "timestamp": "02:41:10", "text": "显而易见的东西，我们把它放在附近了。"}, {"type": "subtitle", "time": 9672.71, "timestamp": "02:41:12", "text": "正确的。今年我们一定会成功"}, {"type": "subtitle", "time": 9674.87, "timestamp": "02:41:14", "text": "太棒了！"}, {"type": "subtitle", "time": 9679.59, "timestamp": "02:41:19", "text": "实际上，让我打开看看。"}, {"type": "subtitle", "time": 9689.99, "timestamp": "02:41:29", "text": "你好。看？看？看？看？你们看到了吗？"}, {"type": "subtitle", "time": 9692.71, "timestamp": "02:41:32", "text": "它？你们看到了吗？看？结束了"}, {"type": "subtitle", "time": 9695.51, "timestamp": "02:41:35", "text": "这里。它好可爱，对吧？好的。我需要"}, {"type": "subtitle", "time": 9698.07, "timestamp": "02:41:38", "text": "稍作调整。所以，这就是……"}, {"type": "subtitle", "time": 9701.349, "timestamp": "02:41:41", "text": "圣诞树。你可以稍微调整一下。"}, {"type": "subtitle", "time": 9704.309, "timestamp": "02:41:44", "text": "少量。或许可以把它放在床上。什么是"}, {"type": "subtitle", "time": 9708.63, "timestamp": "02:41:48", "text": "有没有更好的说法？在床上"}, {"type": "subtitle", "time": 9711.51, "timestamp": "02:41:51", "text": "还是在这边？"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "哪个更好？"}, {"type": "subtitle", "time": 9717.19, "timestamp": "02:41:57", "text": "我想把它放在地板上，但是也"}]
[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "我的心脏快要跳动了，快要死了"}, {"type": "subtitle", "time": 11887.51, "timestamp": "03:18:07", "text": "这边是因为，嗯，某种程度上，嗯"}, {"type": "subtitle", "time": 11890.79, "timestamp": "03:18:10", "text": "从某种意义上说，这就像几乎"}, {"type": "subtitle", "time": 11893.75, "timestamp": "03:18:13", "text": "我当时就想，嗯……该怎么称呼它呢？"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "这感觉就像我在旅行一样。"}, {"type": "subtitle", "time": 11899.59, "timestamp": "03:18:19", "text": "我用的是笔记本电脑，呃，我没有"}, {"type": "subtitle", "time": 11901.59, "timestamp": "03:18:21", "text": "这是我的主要配置。我是临时工"}, {"type": "subtitle", "time": 11905.429, "timestamp": "03:18:25", "text": "准备阶段。对，就是这样。"}, {"type": "subtitle", "time": 11907.51, "timestamp": "03:18:27", "text": "哦，那真是太有趣了。我的天啊，"}, {"type": "subtitle", "time": 11910.63, "timestamp": "03:18:30", "text": "这真的太有趣了。哇。我需要"}, {"type": "subtitle", "time": 11913.429, "timestamp": "03:18:33", "text": "我需要做好准备。是的，我需要"}, {"type": "subtitle", "time": 11916.389, "timestamp": "03:18:36", "text": "做好准备，所以，你知道，为了……"}, {"type": "subtitle", "time": 11919.67, "timestamp": "03:18:39", "text": "我为什么玩到很晚。所以今天我的显卡"}, {"type": "subtitle", "time": 11922.63, "timestamp": "03:18:42", "text": "风扇替换零件到了。"}, {"type": "subtitle", "time": 11926.63, "timestamp": "03:18:46", "text": "就像今天刚到的。它到达了"}, {"type": "subtitle", "time": 11930.469, "timestamp": "03:18:50", "text": "4:15，我设置了这个直播流。"}, {"type": "subtitle", "time": 11934.15, "timestamp": "03:18:54", "text": "最初是在下午 4:00。下午4:30它 g"}, {"type": "subtitle", "time": 11937.11, "timestamp": "03:18:57", "text": "大概4点15分左右到达。是的。所以"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "在溪流之前。是的，它15号到的。"}]
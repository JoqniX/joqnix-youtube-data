[{"type": "subtitle", "time": 16155.75, "timestamp": "04:29:15", "text": "哦，他来了。"}, {"type": "subtitle", "time": 16158.149, "timestamp": "04:29:18", "text": "菲尼亚斯·奈杰利斯"}, {"type": "subtitle", "time": 16161.99, "timestamp": "04:29:21", "text": "黑色的。准备"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "图。很高兴你能加入我们。排序"}, {"type": "subtitle", "time": 16175.59, "timestamp": "04:29:35", "text": "仪式结束了。有"}, {"type": "subtitle", "time": 16178.229, "timestamp": "04:29:38", "text": "并发症。并发症。"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "看来是地精的问题。哥布林。我"}, {"type": "subtitle", "time": 16183.189, "timestamp": "04:29:43", "text": "菲格，我没时间听谣言。而且我是"}, {"type": "subtitle", "time": 16185.269, "timestamp": "04:29:45", "text": "我仅存的一点耐心也迅速消磨殆尽。"}, {"type": "subtitle", "time": 16189.03, "timestamp": "04:29:49", "text": "左边。我的天啊。如果你运气好的话，我们"}, {"type": "subtitle", "time": 16191.03, "timestamp": "04:29:51", "text": "或许还能帮你解决问题"}]
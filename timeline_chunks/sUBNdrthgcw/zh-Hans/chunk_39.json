[{"type": "subtitle", "time": 2344.87, "timestamp": "00:39:04", "text": "我最不想要的就是想要它。"}, {"type": "subtitle", "time": 2348.23, "timestamp": "00:39:08", "text": "令人心碎。就是这样。"}, {"type": "subtitle", "time": 2354.63, "timestamp": "00:39:14", "text": "所以，这个虚拟形象可能是……"}, {"type": "subtitle", "time": 2357.91, "timestamp": "00:39:17", "text": "这样做。我可以做300个"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "300。"}, {"type": "subtitle", "time": 2362.55, "timestamp": "00:39:22", "text": "那会是什么样子？"}, {"type": "subtitle", "time": 2366.95, "timestamp": "00:39:26", "text": "看起来棒极了！好的。"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "我们同意。"}, {"type": "subtitle", "time": 2372.23, "timestamp": "00:39:32", "text": "我们就这么办吧。"}, {"type": "subtitle", "time": 2376.79, "timestamp": "00:39:36", "text": "我们变化很大，伙计。是的。真的吗？"}, {"type": "subtitle", "time": 2378.95, "timestamp": "00:39:38", "text": "是的，我们变了。"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "是的。"}, {"type": "subtitle", "time": 2383.43, "timestamp": "00:39:43", "text": "好的。呃，"}, {"type": "subtitle", "time": 2386.87, "timestamp": "00:39:46", "text": "改名并加上忍者字样。"}, {"type": "subtitle", "time": 2390.39, "timestamp": "00:39:50", "text": "下一个是谁？克洛诺斯"}]
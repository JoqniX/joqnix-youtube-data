[{"type": "subtitle", "time": 11223.11, "timestamp": "03:07:03", "text": "继续。我以后不会再见到他们了。"}, {"type": "subtitle", "time": 11225.349, "timestamp": "03:07:05", "text": "曾有一段时间是这样，但现在不是了。一阵子。"}, {"type": "subtitle", "time": 11227.11, "timestamp": "03:07:07", "text": "是的，"}, {"type": "subtitle", "time": 11229.59, "timestamp": "03:07:09", "text": "希望不会出现技术故障。"}, {"type": "subtitle", "time": 11231.59, "timestamp": "03:07:11", "text": "这次发生了。当我回来的时候"}, {"type": "subtitle", "time": 11234.15, "timestamp": "03:07:14", "text": "从一天起"}, {"type": "subtitle", "time": 11237.67, "timestamp": "03:07:17", "text": "就有一天，我突然感到疼痛。"}, {"type": "subtitle", "time": 11247.59, "timestamp": "03:07:27", "text": "真心希望他们能够……"}, {"type": "subtitle", "time": 11251.19, "timestamp": "03:07:31", "text": "经历一些事情后要活下来。是的，我的"}, {"type": "subtitle", "time": 11253.59, "timestamp": "03:07:33", "text": "其次，我的聊天监控器有点像……"}, {"type": "subtitle", "time": 11256.79, "timestamp": "03:07:36", "text": "线缆适配器好像不太好用。所以"}, {"type": "subtitle", "time": 11259.51, "timestamp": "03:07:39", "text": "希望这个问题也能得到解决。我确实订购了一个"}, {"type": "subtitle", "time": 11262.07, "timestamp": "03:07:42", "text": "新电缆。是的。"}, {"type": "subtitle", "time": 11264.389, "timestamp": "03:07:44", "text": "所以，我们之后会再见的。"}, {"type": "subtitle", "time": 11267.269, "timestamp": "03:07:47", "text": "考试。好的。所以，敬请期待吧！"}, {"type": "subtitle", "time": 11269.19, "timestamp": "03:07:49", "text": "更多流程和工作流程以及新的"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "新东西。"}, {"type": "subtitle", "time": 11273.99, "timestamp": "03:07:53", "text": "所以，再次祝大家圣诞快乐！"}]
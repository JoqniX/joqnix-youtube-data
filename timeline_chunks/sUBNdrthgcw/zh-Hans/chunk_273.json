[{"type": "subtitle", "time": 16381.59, "timestamp": "04:33:01", "text": "足够的。我并没有禁止任何人。"}, {"type": "subtitle", "time": 16386.551, "timestamp": "04:33:06", "text": "完全飞行。但别诱惑我。"}, {"type": "subtitle", "time": 16389.51, "timestamp": "04:33:09", "text": "你来这里是为了专注于学业。"}, {"type": "subtitle", "time": 16391.99, "timestamp": "04:33:11", "text": "期货。我相信你肯定有很多。"}, {"type": "subtitle", "time": 16396.47, "timestamp": "04:33:16", "text": "明天上课前要完成。"}, {"type": "subtitle", "time": 16399.75, "timestamp": "04:33:19", "text": "我说我相信你们都有很多事情要做"}, {"type": "subtitle", "time": 16410.551, "timestamp": "04:33:30", "text": "为什么入口处是15号？真可爱"}, {"type": "subtitle", "time": 16413.429, "timestamp": "04:33:33", "text": "很高兴见到你。我是韦斯莱教授。"}, {"type": "subtitle", "time": 16415.189, "timestamp": "04:33:35", "text": "您能否好心展示一下我们的新产品？"}, {"type": "subtitle", "time": 16417.029, "timestamp": "04:33:37", "text": "学生去他们的公共休息室吗？我将"}, {"type": "subtitle", "time": 16420.551, "timestamp": "04:33:40", "text": "先生，请您务必办妥。"}, {"type": "subtitle", "time": 16423.75, "timestamp": "04:33:43", "text": "因为我的系统非常卡顿。韦斯莱教授。"}, {"type": "subtitle", "time": 16425.75, "timestamp": "04:33:45", "text": "很高兴认识你。很高兴见到你"}, {"type": "subtitle", "time": 16428.07, "timestamp": "04:33:48", "text": "好的，教授。作为副校长"}, {"type": "subtitle", "time": 16430.15, "timestamp": "04:33:50", "text": "主人，我深感荣幸。"}, {"type": "subtitle", "time": 16433.109, "timestamp": "04:33:53", "text": "带你去你们的公共休息室。就在这里"}]
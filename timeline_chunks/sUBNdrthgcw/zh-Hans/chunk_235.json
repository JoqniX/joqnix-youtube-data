[{"type": "subtitle", "time": 14102.229, "timestamp": "03:55:02", "text": "没错，而且不介意满足我的愿望。"}, {"type": "subtitle", "time": 14103.83, "timestamp": "03:55:03", "text": "我想四处看看。"}, {"type": "subtitle", "time": 14106.95, "timestamp": "03:55:06", "text": "当然可以，先生。好的。让我们看看我们是否"}, {"type": "subtitle", "time": 14110.15, "timestamp": "03:55:10", "text": "即使路径已经模糊不清，也能找到一条路"}, {"type": "subtitle", "time": 14120.309, "timestamp": "03:55:20", "text": "通往霍格沃茨的道路。好的。"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "等等，为什么现在这么模糊？"}, {"type": "subtitle", "time": 14126.05, "timestamp": "03:55:26", "text": "什么？"}, {"type": "subtitle", "time": 14135.99, "timestamp": "03:55:35", "text": "为什么是什么"}, {"type": "subtitle", "time": 14145.03, "timestamp": "03:55:45", "text": "哦，你妻子去哪儿了？好吧，就是这样。"}, {"type": "subtitle", "time": 14148.71, "timestamp": "03:55:48", "text": "高端的我。问得好。"}, {"type": "subtitle", "time": 14150.79, "timestamp": "03:55:50", "text": "米里亚姆花了多年时间寻找"}, {"type": "subtitle", "time": 14152.79, "timestamp": "03:55:52", "text": "早已被遗忘的一种形式的证据"}]
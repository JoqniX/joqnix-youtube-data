[{"type": "subtitle", "time": 16320.55, "timestamp": "04:32:00", "text": "所以"}, {"type": "subtitle", "time": 16323.51, "timestamp": "04:32:03", "text": "我觉得没问题。你的大腿怎么样？"}, {"type": "subtitle", "time": 16325.91, "timestamp": "04:32:05", "text": "思考？"}, {"type": "subtitle", "time": 16328.63, "timestamp": "04:32:08", "text": "拉文克劳学院以智慧著称"}, {"type": "subtitle", "time": 16330.95, "timestamp": "04:32:10", "text": "创作者就是我。我喜欢这些"}, {"type": "subtitle", "time": 16334.229, "timestamp": "04:32:14", "text": "东西。所以我决定就这么办。"}, {"type": "subtitle", "time": 16337.349, "timestamp": "04:32:17", "text": "耶。我们走吧。"}, {"type": "subtitle", "time": 16340.63, "timestamp": "04:32:20", "text": "所以，谁出场就能获得 15 XP。"}, {"type": "subtitle", "time": 16342.79, "timestamp": "04:32:22", "text": "那真是一场史诗级的游戏。"}, {"type": "subtitle", "time": 16345.33, "timestamp": "04:32:25", "text": "拉文克劳。"}, {"type": "subtitle", "time": 16348.63, "timestamp": "04:32:28", "text": "[音乐]"}, {"type": "subtitle", "time": 16348.92, "timestamp": "04:32:28", "text": "[掌声]"}, {"type": "subtitle", "time": 16350.7, "timestamp": "04:32:30", "text": "[音乐]"}, {"type": "subtitle", "time": 16368.309, "timestamp": "04:32:48", "text": "哦，还有一件事。由于"}, {"type": "subtitle", "time": 16370.469, "timestamp": "04:32:50", "text": "上一场比赛在球场上不幸受伤"}, {"type": "subtitle", "time": 16372.309, "timestamp": "04:32:52", "text": "今年春季的决赛，魁地奇比赛。"}, {"type": "subtitle", "time": 16375.64, "timestamp": "04:32:55", "text": "赛季取消了。"}]
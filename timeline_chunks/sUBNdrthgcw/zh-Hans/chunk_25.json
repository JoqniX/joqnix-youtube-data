[{"type": "subtitle", "time": 1500.39, "timestamp": "00:25:00", "text": "我的天哪，我上钩了。我的天哪，我"}, {"type": "subtitle", "time": 1503.35, "timestamp": "00:25:03", "text": "我这辈子都没做过那种事。我 我"}, {"type": "subtitle", "time": 1506.39, "timestamp": "00:25:06", "text": "其实我曾想过要绕到后面去。"}, {"type": "subtitle", "time": 1508.95, "timestamp": "00:25:08", "text": "然后他拉屎了，我想，等等，"}, {"type": "subtitle", "time": 1511.35, "timestamp": "00:25:11", "text": "咱们来玩这个游戏，我来引诱或者"}, {"type": "subtitle", "time": 1519.59, "timestamp": "00:25:19", "text": "该死。"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "好的"}, {"type": "subtitle", "time": 1524.789, "timestamp": "00:25:24", "text": "好了，最后一个，我们就开始吧。"}, {"type": "subtitle", "time": 1530.149, "timestamp": "00:25:30", "text": "[音乐]"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "唉，真令人难过。我不想"}, {"type": "subtitle", "time": 1537.029, "timestamp": "00:25:37", "text": "说实话，我不想直播"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "你。真糟糕。说实话。"}, {"type": "subtitle", "time": 1543.909, "timestamp": "00:25:43", "text": "哦，为什么不玩呢？继续播放。感觉"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "太早了。只需3个小时。它要走了"}]
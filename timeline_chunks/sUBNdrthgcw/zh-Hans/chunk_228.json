[{"type": "subtitle", "time": 13680.15, "timestamp": "03:48:00", "text": "岩石。所以当我四处走动时"}, {"type": "subtitle", "time": 13682.71, "timestamp": "03:48:02", "text": "耳机，我的右边"}, {"type": "subtitle", "time": 13685.429, "timestamp": "03:48:05", "text": "耳机的一部分有点像"}, {"type": "subtitle", "time": 13688.469, "timestamp": "03:48:08", "text": "挑剔的。有可能，我不知道。呃，这个"}, {"type": "subtitle", "time": 13691.51, "timestamp": "03:48:11", "text": "东西会切断音频，所以我不得不……"}, {"type": "subtitle", "time": 13702.469, "timestamp": "03:48:22", "text": "等等，什么？他是不是突然转过身去？"}, {"type": "subtitle", "time": 13708.63, "timestamp": "03:48:28", "text": "是个怪人吗？嗯？那是什么？"}, {"type": "subtitle", "time": 13731.189, "timestamp": "03:48:51", "text": "世界。"}]
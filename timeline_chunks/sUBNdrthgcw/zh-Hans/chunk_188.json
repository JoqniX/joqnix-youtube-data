[{"type": "subtitle", "time": 11285.75, "timestamp": "03:08:05", "text": "非常感谢您光临"}, {"type": "subtitle", "time": 11288.79, "timestamp": "03:08:08", "text": "每个人。我们到时见。"}, {"type": "subtitle", "time": 11290.79, "timestamp": "03:08:10", "text": "下一个。"}, {"type": "subtitle", "time": 11293.99, "timestamp": "03:08:13", "text": "今天的照片将会发布。"}, {"type": "subtitle", "time": 11296.71, "timestamp": "03:08:16", "text": "在推特和其他平台上。好的。所以"}, {"type": "subtitle", "time": 11298.469, "timestamp": "03:08:18", "text": "如果你愿意的话，可以看看。"}, {"type": "subtitle", "time": 11300.87, "timestamp": "03:08:20", "text": "到。嗯。"}, {"type": "subtitle", "time": 11303.429, "timestamp": "03:08:23", "text": "祝你一切顺利。再见。"}, {"type": "subtitle", "time": 11305.91, "timestamp": "03:08:25", "text": "我不会参与任何形式的突袭之类的活动。呃，所以"}, {"type": "subtitle", "time": 11309.429, "timestamp": "03:08:29", "text": "您可以随意休息，如果"}, {"type": "subtitle", "time": 11311.83, "timestamp": "03:08:31", "text": "如果你想看别人的，请随意。"}, {"type": "subtitle", "time": 11314.389, "timestamp": "03:08:34", "text": "观察他们之类的。好的。祝你一切顺利"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "一。愿那些沉睡的人安息。"}, {"type": "subtitle", "time": 11320.23, "timestamp": "03:08:40", "text": "星星呃"}, {"type": "subtitle", "time": 11323.19, "timestamp": "03:08:43", "text": "今晚指引你，并祝福你。"}, {"type": "subtitle", "time": 11326.389, "timestamp": "03:08:46", "text": "祝你做个好梦，醒来后充满希望"}, {"type": "subtitle", "time": 11327.91, "timestamp": "03:08:47", "text": "你早上醒来时确实会……"}, {"type": "subtitle", "time": 11330.389, "timestamp": "03:08:50", "text": "脸上露出笑容。不，"}, {"type": "subtitle", "time": 11332.63, "timestamp": "03:08:52", "text": "对于那些正在工作的人来说，等等"}, {"type": "subtitle", "time": 11335.83, "timestamp": "03:08:55", "text": "并且尽力而为，呃，无论是什么"}, {"type": "subtitle", "time": 11338.63, "timestamp": "03:08:58", "text": "早上好、晚上好、下午好。"}]
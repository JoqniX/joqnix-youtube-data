[{"type": "subtitle", "time": 16260.149, "timestamp": "04:31:00", "text": "接下来，我们将探索霍格沃茨和……"}, {"type": "subtitle", "time": 16264.149, "timestamp": "04:31:04", "text": "城堡和庭院之外的世界。 M"}, {"type": "subtitle", "time": 16265.67, "timestamp": "04:31:05", "text": "的确"}, {"type": "subtitle", "time": 16267.99, "timestamp": "04:31:07", "text": "通过拥有……可以获得很多信息"}, {"type": "subtitle", "time": 16272.07, "timestamp": "04:31:12", "text": "冒险精神，但你的教授们"}, {"type": "subtitle", "time": 16281.03, "timestamp": "04:31:21", "text": "你确实很聪明。"}, {"type": "subtitle", "time": 16283.99, "timestamp": "04:31:23", "text": "你具备清晰反思的能力。"}, {"type": "subtitle", "time": 16287.51, "timestamp": "04:31:27", "text": "那些令他人困惑的事情。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "你已经"}, {"type": "subtitle", "time": 16291.99, "timestamp": "04:31:31", "text": "辞职是为了学习。"}, {"type": "subtitle", "time": 16295.67, "timestamp": "04:31:35", "text": "或许你更适合拉文克劳学院。"}, {"type": "subtitle", "time": 16298.55, "timestamp": "04:31:38", "text": "呃，"}, {"type": "subtitle", "time": 16302.63, "timestamp": "04:31:42", "text": "我立刻就被拉文克劳学院录取了。哦"}, {"type": "subtitle", "time": 16305.429, "timestamp": "04:31:45", "text": "我的上帝。好的，我想我们可以这样安排。"}, {"type": "subtitle", "time": 16307.349, "timestamp": "04:31:47", "text": "是这样，对吧？"}, {"type": "subtitle", "time": 16311.349, "timestamp": "04:31:51", "text": "呃，你们觉得这样可以吗？"}, {"type": "subtitle", "time": 16313.59, "timestamp": "04:31:53", "text": "拉文克劳。"}, {"type": "subtitle", "time": 16315.429, "timestamp": "04:31:55", "text": "这是我从哈利那里得到的。"}, {"type": "subtitle", "time": 16318.149, "timestamp": "04:31:58", "text": "哈利·波特粉丝俱乐部之类的东西。"}]
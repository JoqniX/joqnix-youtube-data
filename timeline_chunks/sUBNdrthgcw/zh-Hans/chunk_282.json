[{"type": "subtitle", "time": 16923.43, "timestamp": "04:42:03", "text": "很高兴见到你，萨曼莎。好的"}, {"type": "subtitle", "time": 16925.75, "timestamp": "04:42:05", "text": "祝你好运。谢谢。和"}, {"type": "subtitle", "time": 16927.51, "timestamp": "04:42:07", "text": "也祝你第一次一切顺利"}, {"type": "subtitle", "time": 16929.83, "timestamp": "04:42:09", "text": "天。"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "哦，你好。新拉文克劳学院。教授"}, {"type": "subtitle", "time": 16934.868, "timestamp": "04:42:14", "text": "韦斯莱就在外面等你。"}, {"type": "subtitle", "time": 16936.55, "timestamp": "04:42:16", "text": "他最好不要留下她。哦，只是"}, {"type": "subtitle", "time": 16939.19, "timestamp": "04:42:19", "text": "外部。好的。"}, {"type": "subtitle", "time": 16944.788, "timestamp": "04:42:24", "text": "[音乐]"}, {"type": "subtitle", "time": 16947.91, "timestamp": "04:42:27", "text": "常见的。在公共休息室外面。好的。"}, {"type": "subtitle", "time": 16949.83, "timestamp": "04:42:29", "text": "早上好。我相信你已经准备好了。"}, {"type": "subtitle", "time": 16951.75, "timestamp": "04:42:31", "text": "你在霍格沃茨的第一天。我一直"}, {"type": "subtitle", "time": 16953.67, "timestamp": "04:42:33", "text": "期待这一天很久了。"}, {"type": "subtitle", "time": 16955.83, "timestamp": "04:42:35", "text": "真不敢相信我竟然在这里。嗯，你是"}, {"type": "subtitle", "time": 16958.55, "timestamp": "04:42:38", "text": "这里。充分利用它。你只有"}, {"type": "subtitle", "time": 16961.67, "timestamp": "04:42:41", "text": "在霍格沃茨的第一天。现在，在光下"}, {"type": "subtitle", "time": 16964.708, "timestamp": "04:42:44", "text": "鉴于您独特的个人情况，我们诚邀您加入我们。"}, {"type": "subtitle", "time": 16966.788, "timestamp": "04:42:46", "text": "第五年，你需要赶上进度。"}, {"type": "subtitle", "time": 16969.75, "timestamp": "04:42:49", "text": "跟上同学的步伐，不要落后。"}, {"type": "subtitle", "time": 16971.91, "timestamp": "04:42:51", "text": "尤其是因为你将被期望……"}, {"type": "subtitle", "time": 16974.47, "timestamp": "04:42:54", "text": "在最后完成你的猫头鹰图案"}]
[{"type": "subtitle", "time": 18960.868, "timestamp": "05:16:00", "text": "轮流将它们召唤出来"}, {"type": "subtitle", "time": 18963.75, "timestamp": "05:16:03", "text": "彼此的手。只有一本书"}, {"type": "subtitle", "time": 18965.91, "timestamp": "05:16:05", "text": "戴尔小姐，这是每个合伙企业都需要的。"}, {"type": "subtitle", "time": 18969.85, "timestamp": "05:16:09", "text": "谢谢。立即就位。"}, {"type": "subtitle", "time": 18975.43, "timestamp": "05:16:15", "text": "[音乐]"}, {"type": "subtitle", "time": 18978.628, "timestamp": "05:16:18", "text": "用鼠标探索魔杖之城，并被引导至"}, {"type": "subtitle", "time": 18985.11, "timestamp": "05:16:25", "text": "[音乐]"}, {"type": "subtitle", "time": 18987.58, "timestamp": "05:16:27", "text": "小路。好的。"}, {"type": "subtitle", "time": 18991.99, "timestamp": "05:16:31", "text": "[音乐]"}, {"type": "subtitle", "time": 18995.51, "timestamp": "05:16:35", "text": "耶。我学会了这个咒语。公理。"}, {"type": "subtitle", "time": 19002.23, "timestamp": "05:16:42", "text": "那还不错。"}, {"type": "subtitle", "time": 19005.99, "timestamp": "05:16:45", "text": "你学得很快。我看到很多"}, {"type": "subtitle", "time": 19008.788, "timestamp": "05:16:48", "text": "潜在的。但请记住，潜力是"}, {"type": "subtitle", "time": 19012.23, "timestamp": "05:16:52", "text": "没有练习，什么也做不成。坚持下去。"}, {"type": "subtitle", "time": 19015.43, "timestamp": "05:16:55", "text": "你或许能和迈一较高下。"}, {"type": "subtitle", "time": 19017.03, "timestamp": "05:16:57", "text": "大家都很好。够了。"}, {"type": "subtitle", "time": 19019.19, "timestamp": "05:16:59", "text": "那。嗯，既然你们似乎都有……"}]
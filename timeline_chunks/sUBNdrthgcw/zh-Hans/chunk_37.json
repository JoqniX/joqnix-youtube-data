[{"type": "subtitle", "time": 2231.19, "timestamp": "00:37:11", "text": "好了，现在它在动了。是的。是的。好的。"}, {"type": "subtitle", "time": 2233.829, "timestamp": "00:37:13", "text": "那么，让我们开始我们的圣诞节吧……呃，三个"}, {"type": "subtitle", "time": 2237.349, "timestamp": "00:37:17", "text": "东西。那么，呃，让我开始准备吧。"}, {"type": "subtitle", "time": 2243.99, "timestamp": "00:37:23", "text": "一切准备就绪。好的。进而"}, {"type": "subtitle", "time": 2245.43, "timestamp": "00:37:25", "text": "嗯，好的，让我开始准备吧。"}, {"type": "subtitle", "time": 2252.23, "timestamp": "00:37:32", "text": "马，"}, {"type": "subtitle", "time": 2261.349, "timestamp": "00:37:41", "text": "第一人称"}, {"type": "subtitle", "time": 2263.67, "timestamp": "00:37:43", "text": "在那个玩笑般的实时聊天提醒里"}, {"type": "subtitle", "time": 2265.67, "timestamp": "00:37:45", "text": "曾是"}, {"type": "subtitle", "time": 2268.55, "timestamp": "00:37:48", "text": "想要成为忍者的"}, {"type": "subtitle", "time": 2270.95, "timestamp": "00:37:50", "text": "我认为是七。好的，七。我们走吧"}, {"type": "subtitle", "time": 2273.03, "timestamp": "00:37:53", "text": "有七个。"}]
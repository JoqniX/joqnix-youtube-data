[{"type": "subtitle", "time": 601.19, "timestamp": "00:10:01", "text": "我的错。我的错。我的错。"}, {"type": "subtitle", "time": 603.67, "timestamp": "00:10:03", "text": "混合。好的，这样好多了。"}, {"type": "subtitle", "time": 607.19, "timestamp": "00:10:07", "text": "好了。屏幕。这样好多了。"}, {"type": "subtitle", "time": 611.91, "timestamp": "00:10:11", "text": "是在广告上看到的。哦。哦，我忘了。我"}, {"type": "subtitle", "time": 613.91, "timestamp": "00:10:13", "text": "我当时情绪非常低落。好了，现在是"}, {"type": "subtitle", "time": 615.829, "timestamp": "00:10:15", "text": "更亮的伞。现在我们可以看到"}, {"type": "subtitle", "time": 618.55, "timestamp": "00:10:18", "text": "显然是装饰品，对吧？"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "哦，我应该早点这么做的。哦，"}, {"type": "subtitle", "time": 632.23, "timestamp": "00:10:32", "text": "现在我得换掉 Fortnite 和八"}, {"type": "subtitle", "time": 644.31, "timestamp": "00:10:44", "text": "主啊，请帮助我。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "好吧，既然我……这样做，我不想……"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "查一下情况。"}, {"type": "subtitle", "time": 652.87, "timestamp": "00:10:52", "text": "我觉得我的麦克风好像坏了。"}, {"type": "subtitle", "time": 654.47, "timestamp": "00:10:54", "text": "这个东西。"}, {"type": "subtitle", "time": 656.79, "timestamp": "00:10:56", "text": "是的，它显示有信号，但实际上并没有。"}, {"type": "subtitle", "time": 659.829, "timestamp": "00:10:59", "text": "在职的。是的，用新的呃声音"}]
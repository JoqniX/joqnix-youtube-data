[{"type": "subtitle", "time": 12843.03, "timestamp": "03:34:03", "text": "你好。已经90度了。等等，什么？"}, {"type": "subtitle", "time": 12846.79, "timestamp": "03:34:06", "text": "好的，流媒体播放时是 37%。"}, {"type": "subtitle", "time": 12850.07, "timestamp": "03:34:10", "text": "观察。那么，我发布时会有多少费用呢？"}, {"type": "subtitle", "time": 12853.11, "timestamp": "03:34:13", "text": "游戏？我们走吧，"}, {"type": "subtitle", "time": 12869.03, "timestamp": "03:34:29", "text": "所以，我会用手机看聊天记录。我"}, {"type": "subtitle", "time": 12871.91, "timestamp": "03:34:31", "text": "不会使用浏览器，因为浏览器可以……"}, {"type": "subtitle", "time": 12874.79, "timestamp": "03:34:34", "text": "用力向上。"}, {"type": "subtitle", "time": 12877.349, "timestamp": "03:34:37", "text": "我的天，卡顿了。我的天哪，是"}, {"type": "subtitle", "time": 12879.429, "timestamp": "03:34:39", "text": "滞后。"}, {"type": "subtitle", "time": 12882.389, "timestamp": "03:34:42", "text": "等等，你还没跟上主线剧情。"}, {"type": "subtitle", "time": 12885.51, "timestamp": "03:34:45", "text": "哦，不。"}, {"type": "subtitle", "time": 12887.91, "timestamp": "03:34:47", "text": "是的，真的，就是当你……的时候，当我……"}, {"type": "subtitle", "time": 12890.63, "timestamp": "03:34:50", "text": "启动霍格沃茨时，感觉有点卡顿。"}, {"type": "subtitle", "time": 12893.429, "timestamp": "03:34:53", "text": "我的鼠标会放在那个地方，就像这样"}, {"type": "subtitle", "time": 12895.67, "timestamp": "03:34:55", "text": "快门之类的。我不知道"}, {"type": "subtitle", "time": 12897.67, "timestamp": "03:34:57", "text": "这是什么？"}, {"type": "subtitle", "time": 12899.429, "timestamp": "03:34:59", "text": "是因为英伟达显卡吗？"}]
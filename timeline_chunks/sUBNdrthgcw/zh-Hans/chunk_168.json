[{"type": "subtitle", "time": 10082.95, "timestamp": "02:48:02", "text": "我没有呕吐的欲望。"}, {"type": "subtitle", "time": 10087.03, "timestamp": "02:48:07", "text": "我到底是怎么了？"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "我为什么病得这么厉害？我感觉很不舒服。"}, {"type": "subtitle", "time": 10093.19, "timestamp": "02:48:13", "text": "总之，我们会进行直播。"}, {"type": "subtitle", "time": 10094.87, "timestamp": "02:48:14", "text": "30日"}, {"type": "subtitle", "time": 10097.11, "timestamp": "02:48:17", "text": "嗯，或许我们会进行直播。"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "不知道为什么感觉特别难受。我的"}, {"type": "subtitle", "time": 10115.19, "timestamp": "02:48:35", "text": "是的，我很高兴我们能够做到这一点。"}, {"type": "subtitle", "time": 10117.429, "timestamp": "02:48:37", "text": "把它们放在一起。非常非常感谢！"}, {"type": "subtitle", "time": 10118.95, "timestamp": "02:48:38", "text": "每个人。"}, {"type": "subtitle", "time": 10124.07, "timestamp": "02:48:44", "text": "而且，我仍然很喜欢它。"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "此刻我的担忧是什么。我想"}, {"type": "subtitle", "time": 10130.55, "timestamp": "02:48:50", "text": "举办此次活动"}, {"type": "subtitle", "time": 10133.429, "timestamp": "02:48:53", "text": "意思是，呃，这棵圣诞树"}, {"type": "subtitle", "time": 10137.349, "timestamp": "02:48:57", "text": "装饰品是未来才会出现的东西。"}]
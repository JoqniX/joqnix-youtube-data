[{"type": "subtitle", "time": 8341.669, "timestamp": "02:19:01", "text": "伊桑"}, {"type": "subtitle", "time": 8349.91, "timestamp": "02:19:09", "text": "我没放鸡蛋，我买了"}, {"type": "subtitle", "time": 8354.23, "timestamp": "02:19:14", "text": "等一下。红色代表面包。"}, {"type": "subtitle", "time": 8356.709, "timestamp": "02:19:16", "text": "嗯？"}, {"type": "subtitle", "time": 8372.15, "timestamp": "02:19:32", "text": "嘿，不，不，不，不，不，不。我怎么能这样呢？"}, {"type": "subtitle", "time": 8399.03, "timestamp": "02:19:59", "text": "啊，它从顶部起飞了。好的，没问题。"}]
[{"type": "subtitle", "time": 15989.189, "timestamp": "04:26:29", "text": "你还好吗？好的，先生。我从未"}, {"type": "subtitle", "time": 15991.91, "timestamp": "04:26:31", "text": "见过如此强大的哥布林。"}, {"type": "subtitle", "time": 15994.87, "timestamp": "04:26:34", "text": "他似乎完全没有受到我的影响。"}, {"type": "subtitle", "time": 16001.03, "timestamp": "04:26:41", "text": "我们在哪里？"}, {"type": "subtitle", "time": 16004.229, "timestamp": "04:26:44", "text": "问题。不可能。"}, {"type": "subtitle", "time": 16006.469, "timestamp": "04:26:46", "text": "似乎那些设立沉思器的人，"}, {"type": "subtitle", "time": 16010.71, "timestamp": "04:26:50", "text": "那枚小盒坠，以及通往两者的道路"}, {"type": "subtitle", "time": 16013.429, "timestamp": "04:26:53", "text": "像你这样的人"}, {"type": "subtitle", "time": 16017.03, "timestamp": "04:26:57", "text": "最终落得如此下场。"}, {"type": "subtitle", "time": 16019.67, "timestamp": "04:26:59", "text": "来吧，我们要举行一个分拣仪式。"}]
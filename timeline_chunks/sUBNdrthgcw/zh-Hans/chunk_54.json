[{"type": "subtitle", "time": 3241.51, "timestamp": "00:54:01", "text": "当我打开它的时候。不在那里。 300乘300。"}, {"type": "subtitle", "time": 3243.67, "timestamp": "00:54:03", "text": "你看，它是隐形的。"}, {"type": "subtitle", "time": 3251.99, "timestamp": "00:54:11", "text": "这是什么？所以呢？好的，等等。患病的"}, {"type": "subtitle", "time": 3254.309, "timestamp": "00:54:14", "text": "再做一遍。"}, {"type": "subtitle", "time": 3258.549, "timestamp": "00:54:18", "text": "哦，工作。"}, {"type": "subtitle", "time": 3261.99, "timestamp": "00:54:21", "text": "别这样对我。"}, {"type": "subtitle", "time": 3264.79, "timestamp": "00:54:24", "text": "好吧，这行不通。好的，等等。"}, {"type": "subtitle", "time": 3273.43, "timestamp": "00:54:33", "text": "我恨你。"}, {"type": "subtitle", "time": 3279.349, "timestamp": "00:54:39", "text": "流中是否存在剪切蒙版"}, {"type": "subtitle", "time": 3280.95, "timestamp": "00:54:40", "text": "效果？我没有直播流。"}, {"type": "subtitle", "time": 3284.069, "timestamp": "00:54:44", "text": "效果插件，但是"}, {"type": "subtitle", "time": 3293.03, "timestamp": "00:54:53", "text": "这显而易见，这应该是我的FS。"}, {"type": "subtitle", "time": 3295.51, "timestamp": "00:54:55", "text": "链子，但我忘了放东西。那是"}, {"type": "subtitle", "time": 3297.349, "timestamp": "00:54:57", "text": "问题所在。"}, {"type": "subtitle", "time": 3299.829, "timestamp": "00:54:59", "text": "我不小心把所有东西都放进去了"}]
[{"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "我应该问问你想去哪里……"}, {"type": "subtitle", "time": 8230.87, "timestamp": "02:17:10", "text": "哦，等等"}, {"type": "subtitle", "time": 8233.349, "timestamp": "02:17:13", "text": "我应该问问哪个职位"}, {"type": "subtitle", "time": 8237.589, "timestamp": "02:17:17", "text": "你想和人们交流吗？哦不，我忘了。"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "我怎么会忘记呢？"}, {"type": "subtitle", "time": 8248.309, "timestamp": "02:17:28", "text": "等待。"}, {"type": "subtitle", "time": 8250.469, "timestamp": "02:17:30", "text": "那我呢？我必须把自己置于首位。"}, {"type": "subtitle", "time": 8252.87, "timestamp": "02:17:32", "text": "在。不，我会站在这边。所以，就是这样。"}, {"type": "subtitle", "time": 8260.07, "timestamp": "02:17:40", "text": "呃，等等，这个订单会怎么安排？"}, {"type": "subtitle", "time": 8262.95, "timestamp": "02:17:42", "text": "已选中？等等，你知道吗？我必须"}, {"type": "subtitle", "time": 8265.349, "timestamp": "02:17:45", "text": "按照顺序去做"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "参与者。现在，我们就这么做吧。"}, {"type": "subtitle", "time": 8270.87, "timestamp": "02:17:50", "text": "然后。希望这样可以。"}, {"type": "subtitle", "time": 8273.83, "timestamp": "02:17:53", "text": "这样可以吗？"}, {"type": "subtitle", "time": 8275.99, "timestamp": "02:17:55", "text": "让我们按照顺序来做。"}]
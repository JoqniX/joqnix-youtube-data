[{"type": "subtitle", "time": 3670.15, "timestamp": "01:01:10", "text": "我的天啊。我一直在等。我当时就想，啊？"}, {"type": "subtitle", "time": 3673.27, "timestamp": "01:01:13", "text": "我当时想，哦不。"}, {"type": "subtitle", "time": 3676.15, "timestamp": "01:01:16", "text": "好的。呃，圆圈。我们走吧。是吗？"}, {"type": "subtitle", "time": 3692.71, "timestamp": "01:01:32", "text": "努力工作。"}, {"type": "subtitle", "time": 3694.71, "timestamp": "01:01:34", "text": "好的。现在的问题是，这如何实现？"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "工作？什么是场景视图变换？"}, {"type": "subtitle", "time": 3702.71, "timestamp": "01:01:42", "text": "我可以放大。好的。哦。哦。什么是"}, {"type": "subtitle", "time": 3705.67, "timestamp": "01:01:45", "text": "我们得到的这个设计"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "如果我们把镜头拉远，缩小忍者的头像呢？哦，"}, {"type": "subtitle", "time": 3710.47, "timestamp": "01:01:50", "text": "凉爽的。凉爽的。"}, {"type": "subtitle", "time": 3712.549, "timestamp": "01:01:52", "text": "好的，他们把它折叠起来。我不知道。 90."}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "正确的。所以，问题是：你如何……"}, {"type": "subtitle", "time": 3718.069, "timestamp": "01:01:58", "text": "圈出来？"}]
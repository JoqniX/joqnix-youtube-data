[{"type": "subtitle", "time": 5533.35, "timestamp": "01:32:13", "text": "我觉得可能是日志没记录之类的。"}, {"type": "subtitle", "time": 5537.75, "timestamp": "01:32:17", "text": "等等，什么没记录？"}, {"type": "subtitle", "time": 5542.149, "timestamp": "01:32:22", "text": "我发誓我看到了卡赞的信息。"}, {"type": "subtitle", "time": 5545.75, "timestamp": "01:32:25", "text": "它怎么会消失呢？什么？"}, {"type": "subtitle", "time": 5548.229, "timestamp": "01:32:28", "text": "决不。"}, {"type": "subtitle", "time": 5553.11, "timestamp": "01:32:33", "text": "为什么？"}, {"type": "subtitle", "time": 5557.27, "timestamp": "01:32:37", "text": "这里真的一个人都没有。"}, {"type": "subtitle", "time": 5559.669, "timestamp": "01:32:39", "text": "好吧，我非常抱歉。我会进行随机化"}, {"type": "subtitle", "time": 5562.47, "timestamp": "01:32:42", "text": "为你。八。"}, {"type": "subtitle", "time": 5569.43, "timestamp": "01:32:49", "text": "呃，我想这是第八个。不，那是"}]
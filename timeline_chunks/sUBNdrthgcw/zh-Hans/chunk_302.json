[{"type": "subtitle", "time": 18121.51, "timestamp": "05:02:01", "text": "这张地图被施了魔法，可以帮助你找到"}, {"type": "subtitle", "time": 18123.43, "timestamp": "05:02:03", "text": "按你的方式。这将非常精彩"}, {"type": "subtitle", "time": 18126.39, "timestamp": "05:02:06", "text": "有帮助。谢谢。现在，听起来像是"}, {"type": "subtitle", "time": 18128.31, "timestamp": "05:02:08", "text": "你今天有的忙了。什么"}, {"type": "subtitle", "time": 18130.39, "timestamp": "05:02:10", "text": "课程和去Hogsmeat的旅行"}, {"type": "subtitle", "time": 18133.35, "timestamp": "05:02:13", "text": "所需物品，包括你自己的魔杖。"}, {"type": "subtitle", "time": 18135.67, "timestamp": "05:02:15", "text": "你会喜欢奥利凡德先生的。他是一个"}, {"type": "subtitle", "time": 18138.15, "timestamp": "05:02:18", "text": "技艺精湛的工匠，也是一位好朋友。"}, {"type": "subtitle", "time": 18140.07, "timestamp": "05:02:20", "text": "等我有了更多信息，我会联系你。"}, {"type": "subtitle", "time": 18143.19, "timestamp": "05:02:23", "text": "关于我们神秘吊坠的信息。"}, {"type": "subtitle", "time": 18145.91, "timestamp": "05:02:25", "text": "目前，请专注于你的课程和缴费。"}, {"type": "subtitle", "time": 18148.788, "timestamp": "05:02:28", "text": "注意力。比你的猫头鹰可能面临的问题更多"}, {"type": "subtitle", "time": 18150.55, "timestamp": "05:02:30", "text": "关于你能够掌握的魔法"}, {"type": "subtitle", "time": 18154.07, "timestamp": "05:02:34", "text": "在这四面墙之内。你好"}, {"type": "subtitle", "time": 18157.75, "timestamp": "05:02:37", "text": "那里是昌普拉斯。你好。"}, {"type": "subtitle", "time": 18163.03, "timestamp": "05:02:43", "text": "欢迎来到诚实。这里有指南针。"}, {"type": "subtitle", "time": 18167.91, "timestamp": "05:02:47", "text": "哇。那是蝴蝶罗盘。"}, {"type": "subtitle", "time": 18170.23, "timestamp": "05:02:50", "text": "我的天啊。里面有东西。我"}, {"type": "subtitle", "time": 18173.11, "timestamp": "05:02:53", "text": "记住这一点就好。你好。这是谁？我"}, {"type": "subtitle", "time": 18175.11, "timestamp": "05:02:55", "text": "我不认为我们见过面。哦，你好。我是"}, {"type": "subtitle", "time": 18176.708, "timestamp": "05:02:56", "text": "莱诺拉。"}, {"type": "subtitle", "time": 18178.39, "timestamp": "05:02:58", "text": "如果我看起来有点心不在焉，请见谅。"}]
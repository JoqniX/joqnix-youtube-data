[{"type": "subtitle", "time": 18180.47, "timestamp": "05:03:00", "text": "眼下。大家都认为我是"}, {"type": "subtitle", "time": 18183.11, "timestamp": "05:03:03", "text": "简直荒谬至极。萨曼莎认为我是"}, {"type": "subtitle", "time": 18186.628, "timestamp": "05:03:06", "text": "便壶。但正是这幅画。我从未"}, {"type": "subtitle", "time": 18189.75, "timestamp": "05:03:09", "text": "之前就注意到了。如果我了解霍格沃茨，"}, {"type": "subtitle", "time": 18192.23, "timestamp": "05:03:12", "text": "我确实这么做了，但并没有出现空白的框架。"}, {"type": "subtitle", "time": 18194.788, "timestamp": "05:03:14", "text": "无缘无故。还有一些其他的事情"}, {"type": "subtitle", "time": 18203.59, "timestamp": "05:03:23", "text": "坚持，稍等。你有什么新的见解吗？"}, {"type": "subtitle", "time": 18205.03, "timestamp": "05:03:25", "text": "关于这幅画，自从你……"}, {"type": "subtitle", "time": 18207.43, "timestamp": "05:03:27", "text": "研究它吗？我发现了铸造"}, {"type": "subtitle", "time": 18210.39, "timestamp": "05:03:30", "text": "Lumos确实有某种效果，但是"}, {"type": "subtitle", "time": 18213.43, "timestamp": "05:03:33", "text": "我不知道接下来该怎么办。"}, {"type": "subtitle", "time": 18214.868, "timestamp": "05:03:34", "text": "好的。有没有类似的画作？"}, {"type": "subtitle", "time": 18216.39, "timestamp": "05:03:36", "text": "这里？还有其他空白的画作吗？"}, {"type": "subtitle", "time": 18219.75, "timestamp": "05:03:39", "text": "学校周围都是这样的吗？是的，有一些。"}, {"type": "subtitle", "time": 18221.91, "timestamp": "05:03:41", "text": "整个地方有点像"}, {"type": "subtitle", "time": 18224.31, "timestamp": "05:03:44", "text": "说实话，这真是个谜。如果我能锻炼出来"}, {"type": "subtitle", "time": 18226.07, "timestamp": "05:03:46", "text": "这个谜题的答案，我一定会知道的。"}, {"type": "subtitle", "time": 18228.47, "timestamp": "05:03:48", "text": "与它们所有人有关。好地方"}, {"type": "subtitle", "time": 18231.75, "timestamp": "05:03:51", "text": "就像任何人一样开始。"}, {"type": "subtitle", "time": 18233.99, "timestamp": "05:03:53", "text": "如果我有时间，我可能会看看。有可能"}, {"type": "subtitle", "time": 18236.708, "timestamp": "05:03:56", "text": "很有意思。我简直要崩溃了。"}, {"type": "subtitle", "time": 18239.03, "timestamp": "05:03:59", "text": "时间足够长了。希望你一切顺利。"}]
[{"type": "subtitle", "time": 4080.23, "timestamp": "01:08:00", "text": "我也想睡觉。哦，等等，等等，"}, {"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "等待。呃，对于那些正在睡觉的人来说，严"}, {"type": "subtitle", "time": 4084.15, "timestamp": "01:08:04", "text": "你知道吗？我一定是雷诺斯。"}, {"type": "subtitle", "time": 4086.23, "timestamp": "01:08:06", "text": "呃，你不需要，你不需要"}, {"type": "subtitle", "time": 4090.069, "timestamp": "01:08:10", "text": "熬夜。哦。呃。我的天哪。别 别"}, {"type": "subtitle", "time": 4092.789, "timestamp": "01:08:12", "text": "熬夜。现在是11点30分。"}, {"type": "subtitle", "time": 4094.789, "timestamp": "01:08:14", "text": "哦。等等，等等，等等，等等，等等。它是"}, {"type": "subtitle", "time": 4098.47, "timestamp": "01:08:18", "text": "我要速通这个"}, {"type": "subtitle", "time": 4116.229, "timestamp": "01:08:36", "text": "我觉得这样可以。我不知道。做"}, {"type": "subtitle", "time": 4126.47, "timestamp": "01:08:46", "text": "[音乐]"}, {"type": "subtitle", "time": 4129.829, "timestamp": "01:08:49", "text": "好了，完成了。"}, {"type": "subtitle", "time": 4132.47, "timestamp": "01:08:52", "text": "倒下两个。"}, {"type": "subtitle", "time": 4134.709, "timestamp": "01:08:54", "text": "呃，当时有多少人？我"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "忘了。我数不清了。没关系。"}]
[{"type": "subtitle", "time": 6000.55, "timestamp": "01:40:00", "text": "我可以捐赠吗？不，我必须手动操作。"}, {"type": "subtitle", "time": 6009.109, "timestamp": "01:40:09", "text": "明显的。停止崩溃，"}, {"type": "subtitle", "time": 6016.95, "timestamp": "01:40:16", "text": "我的天，它崩溃了。"}, {"type": "subtitle", "time": 6019.109, "timestamp": "01:40:19", "text": "请告诉我，我所做的一切并没有起到作用。"}]
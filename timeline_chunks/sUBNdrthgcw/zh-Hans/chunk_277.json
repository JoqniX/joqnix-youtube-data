[{"type": "subtitle", "time": 16621.59, "timestamp": "04:37:01", "text": "那并不是我想要的反应。"}, {"type": "subtitle", "time": 16624.629, "timestamp": "04:37:04", "text": "那好吧。你希望发生什么？"}, {"type": "subtitle", "time": 16626.551, "timestamp": "04:37:06", "text": "我想我希望它能减轻……"}, {"type": "subtitle", "time": 16629.51, "timestamp": "04:37:09", "text": "情绪。拉文克劳学院的学生有时会有点神经质。"}, {"type": "subtitle", "time": 16632.39, "timestamp": "04:37:12", "text": "开学第一天。我是埃弗雷特，"}, {"type": "subtitle", "time": 16635.109, "timestamp": "04:37:15", "text": "道路。你看起来非常平静。"}, {"type": "subtitle", "time": 16637.029, "timestamp": "04:37:17", "text": "这些角色中的一些，还有你"}, {"type": "subtitle", "time": 16641.349, "timestamp": "04:37:21", "text": "经历了一段相当惊险的旅程后，我平安来到这里。"}, {"type": "subtitle", "time": 16643.99, "timestamp": "04:37:23", "text": "呃，我可以吗？"}, {"type": "subtitle", "time": 16646.23, "timestamp": "04:37:26", "text": "是的。我很高兴来到这里。准备好了"}, {"type": "subtitle", "time": 16649.51, "timestamp": "04:37:29", "text": "课程即将开始。好的。很高兴听到这个消息。"}, {"type": "subtitle", "time": 16651.91, "timestamp": "04:37:31", "text": "真的，没必要紧张。"}, {"type": "subtitle", "time": 16654.47, "timestamp": "04:37:34", "text": "大多数教授都很严格但很公平。我"}, {"type": "subtitle", "time": 16656.23, "timestamp": "04:37:36", "text": "意思是，我耍的那些花招并非全都有效。"}, {"type": "subtitle", "time": 16658.629, "timestamp": "04:37:38", "text": "就像扔个粪弹一样简单。而我是"}, {"type": "subtitle", "time": 16661.429, "timestamp": "04:37:41", "text": "我还在这里。等等，你说的是大多数"}, {"type": "subtitle", "time": 16663.91, "timestamp": "04:37:43", "text": "教授们严厉但公正吗？嗯？我"}, {"type": "subtitle", "time": 16666.07, "timestamp": "04:37:46", "text": "确实如此，但或许最好还是让你来评判。"}, {"type": "subtitle", "time": 16668.709, "timestamp": "04:37:48", "text": "为了你自己。我确实倾向于推动他们"}, {"type": "subtitle", "time": 16670.869, "timestamp": "04:37:50", "text": "限制。我应该在……之前离开。"}, {"type": "subtitle", "time": 16672.551, "timestamp": "04:37:52", "text": "有人追溯到那个粪钟的来源"}, {"type": "subtitle", "time": 16676.789, "timestamp": "04:37:56", "text": "我。很高兴认识你。你也一样，埃弗雷特。"}, {"type": "subtitle", "time": 16678.31, "timestamp": "04:37:58", "text": "埃弗雷特"}]
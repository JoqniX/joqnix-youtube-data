[{"type": "subtitle", "time": 18311.59, "timestamp": "05:05:11", "text": "莱诺拉，我解开了那个谜团。"}, {"type": "subtitle", "time": 18316.628, "timestamp": "05:05:16", "text": "绘画。你真的这么做了？如何？"}, {"type": "subtitle", "time": 18317.91, "timestamp": "05:05:17", "text": "我会顺着线索查下去。我找到了"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "画中描绘的地点和"}, {"type": "subtitle", "time": 18321.51, "timestamp": "05:05:21", "text": "然后我施放了荧光闪烁咒，引导一只飞蛾飞回来。"}, {"type": "subtitle", "time": 18323.51, "timestamp": "05:05:23", "text": "到框架。一切都非常合乎逻辑，我"}, {"type": "subtitle", "time": 18327.03, "timestamp": "05:05:27", "text": "认为。可惜我离解开谜题就差一步了。"}, {"type": "subtitle", "time": 18328.948, "timestamp": "05:05:28", "text": "它。你擅长解决问题吗？"}, {"type": "subtitle", "time": 18332.39, "timestamp": "05:05:32", "text": "谜语？纳特在这方面也很擅长。所以是"}, {"type": "subtitle", "time": 18335.03, "timestamp": "05:05:35", "text": "肉。虽然他确实倾向于哦，好吧。"}, {"type": "subtitle", "time": 18336.788, "timestamp": "05:05:36", "text": "好的。很高兴有人想明白了。"}, {"type": "subtitle", "time": 18341.67, "timestamp": "05:05:41", "text": "出去。我爱我自己。飞蛾。我本应该"}]
[{"type": "subtitle", "time": 13560.469, "timestamp": "03:46:00", "text": "一些灰尘。无需担心"}, {"type": "subtitle", "time": 13571.189, "timestamp": "03:46:11", "text": "我迫不及待地想去那里，那真是太棒了。"}, {"type": "subtitle", "time": 13573.189, "timestamp": "03:46:13", "text": "我相信我真的会去几个"}, {"type": "subtitle", "time": 13575.269, "timestamp": "03:46:15", "text": "蛛网和一些灰尘。没什么可说的"}, {"type": "subtitle", "time": 13576.63, "timestamp": "03:46:16", "text": "对此感到担忧。就这么定了。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "好的。"}, {"type": "subtitle", "time": 13582.55, "timestamp": "03:46:22", "text": "所以，我选择和巫师一起去。好的。"}, {"type": "subtitle", "time": 13585.269, "timestamp": "03:46:25", "text": "开始你的旅程。我们这些人是"}, {"type": "subtitle", "time": 13589.99, "timestamp": "03:46:29", "text": "大家都准备好了吗？我们走吧。三，二，"}, {"type": "subtitle", "time": 13591.91, "timestamp": "03:46:31", "text": "一，"}, {"type": "subtitle", "time": 13598.63, "timestamp": "03:46:38", "text": "[音乐]"}, {"type": "subtitle", "time": 13600.87, "timestamp": "03:46:40", "text": "我的天，质量太差了。我太"}, {"type": "subtitle", "time": 13603.03, "timestamp": "03:46:43", "text": "对不起。你必须忍受这一切"}, {"type": "subtitle", "time": 13605.03, "timestamp": "03:46:45", "text": "还有一个。看来我们几乎准备就绪了。"}, {"type": "subtitle", "time": 13607.03, "timestamp": "03:46:47", "text": "离开。"}, {"type": "subtitle", "time": 13608.389, "timestamp": "03:46:48", "text": "你的发音是什么？我不知道。"}, {"type": "subtitle", "time": 13609.99, "timestamp": "03:46:49", "text": "多花点时间练习咒语"}, {"type": "subtitle", "time": 13611.67, "timestamp": "03:46:51", "text": "铸件。有必要这样做吗？你已经"}, {"type": "subtitle", "time": 13613.269, "timestamp": "03:46:53", "text": "一直在练习我们之前学过的咒语。"}, {"type": "subtitle", "time": 13615.99, "timestamp": "03:46:55", "text": "我有，教授。嗯，我很确定"}, {"type": "subtitle", "time": 13618.229, "timestamp": "03:46:58", "text": "我从未见过有人接受得这么快。"}]
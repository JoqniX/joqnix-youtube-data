[{"type": "subtitle", "time": 10022.389, "timestamp": "02:47:02", "text": "快乐的。不，不高兴。祝你圣诞快乐"}, {"type": "subtitle", "time": 10024.309, "timestamp": "02:47:04", "text": "每个人。即使我知道它是"}, {"type": "subtitle", "time": 10027.03, "timestamp": "02:47:07", "text": "圣诞节还没到，但我恐怕不行了。"}, {"type": "subtitle", "time": 10030.469, "timestamp": "02:47:10", "text": "向所有人道一声圣诞祝福。嗯？所以，"}, {"type": "subtitle", "time": 10033.91, "timestamp": "02:47:13", "text": "28号见。"}, {"type": "subtitle", "time": 10036.63, "timestamp": "02:47:16", "text": "我回来后会立即开始……"}, {"type": "subtitle", "time": 10038.95, "timestamp": "02:47:18", "text": "溪流。我不在乎"}, {"type": "subtitle", "time": 10042.63, "timestamp": "02:47:22", "text": "如果我累了。醒醒。现在回来"}, {"type": "subtitle", "time": 10045.91, "timestamp": "02:47:25", "text": "这里。我开始直播"}, {"type": "subtitle", "time": 10048.389, "timestamp": "02:47:28", "text": "我们放松"}, {"type": "subtitle", "time": 10051.349, "timestamp": "02:47:31", "text": "我们尽情享受吧。慢慢来。"}, {"type": "subtitle", "time": 10053.83, "timestamp": "02:47:33", "text": "一切。是的，我接到过一些佣金。"}, {"type": "subtitle", "time": 10058.63, "timestamp": "02:47:38", "text": "在结束之前做类似“之前”的事情"}, {"type": "subtitle", "time": 10063.03, "timestamp": "02:47:43", "text": "30日必须把它完成。我会这么做。"}, {"type": "subtitle", "time": 10066.309, "timestamp": "02:47:46", "text": "缓慢地，而且"}, {"type": "subtitle", "time": 10068.87, "timestamp": "02:47:48", "text": "呃，我不会庆祝的。"}, {"type": "subtitle", "time": 10071.19, "timestamp": "02:47:51", "text": "新年快乐，对吧？"}]
[{"type": "subtitle", "time": 17762.948, "timestamp": "04:56:02", "text": "我们途中稍微绕了点路。"}, {"type": "subtitle", "time": 17766.708, "timestamp": "04:56:06", "text": "这里。最后我去探索了一些遗迹。和"}, {"type": "subtitle", "time": 17770.15, "timestamp": "04:56:10", "text": "我不该再多说了。探索遗址？"}, {"type": "subtitle", "time": 17773.27, "timestamp": "04:56:13", "text": "嗯，我猜菲格教授有他的"}, {"type": "subtitle", "time": 17775.03, "timestamp": "04:56:15", "text": "保留细节的原因"}, {"type": "subtitle", "time": 17778.47, "timestamp": "04:56:18", "text": "他目前暂时是他自己。是的。你好。呃，说话"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "魔鬼。菲格教授，你的耳朵"}, {"type": "subtitle", "time": 17785.19, "timestamp": "04:56:25", "text": "当时肯定着火了。哦是的。你"}, {"type": "subtitle", "time": 17787.11, "timestamp": "04:56:27", "text": "似乎为我们提供了新的第五年"}, {"type": "subtitle", "time": 17789.51, "timestamp": "04:56:29", "text": "具备扎实的基础知识"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "施法。"}, {"type": "subtitle", "time": 17793.03, "timestamp": "04:56:33", "text": "啊，恐怕我不能全部接受"}, {"type": "subtitle", "time": 17795.43, "timestamp": "04:56:35", "text": "教授，您做得很好。他们有一个"}, {"type": "subtitle", "time": 17799.35, "timestamp": "04:56:39", "text": "看来他拥有罕见的魔法天赋。快乐的"}, {"type": "subtitle", "time": 17803.51, "timestamp": "04:56:43", "text": "到。你好吗？你们俩都到了"}, {"type": "subtitle", "time": 17805.43, "timestamp": "04:56:45", "text": "完好的船只和马车"}, {"type": "subtitle", "time": 17807.51, "timestamp": "04:56:47", "text": "霍格沃茨。你选择了乘坐飞机"}, {"type": "subtitle", "time": 17810.47, "timestamp": "04:56:50", "text": "龙之道。我不会说是我选择的。"}, {"type": "subtitle", "time": 17813.19, "timestamp": "04:56:53", "text": "教授，这是龙之道。相当"}, {"type": "subtitle", "time": 17814.948, "timestamp": "04:56:54", "text": "不幸的是，似乎确实如此。"}, {"type": "subtitle", "time": 17819.19, "timestamp": "04:56:59", "text": "选择我们。很好。闲聊到此为止。我"}]
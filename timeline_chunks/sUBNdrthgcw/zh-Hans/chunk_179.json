[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "拖放并放置到位"}, {"type": "subtitle", "time": 10745.19, "timestamp": "02:59:05", "text": "他们可以选择任何他们想要的位置，然后点击确认"}, {"type": "subtitle", "time": 10747.67, "timestamp": "02:59:07", "text": "只有这样他们才能喜欢"}, {"type": "subtitle", "time": 10749.99, "timestamp": "02:59:09", "text": "编辑该位置或更改它"}, {"type": "subtitle", "time": 10752.309, "timestamp": "02:59:12", "text": "如果他们以后不喜欢，还有其他原因"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "人们无法呃……把它放进去之类的。"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "是的。是的。而且而且而且而且嗯，如果"}, {"type": "subtitle", "time": 10762.87, "timestamp": "02:59:22", "text": "有太多人想……"}, {"type": "subtitle", "time": 10765.269, "timestamp": "02:59:25", "text": "把他们……呃……把他们的……把自己放进去"}, {"type": "subtitle", "time": 10767.269, "timestamp": "02:59:27", "text": "一个和树一样大的装饰品"}, {"type": "subtitle", "time": 10770.15, "timestamp": "02:59:30", "text": "增加或其他什么。是的。是的。"}, {"type": "subtitle", "time": 10773.91, "timestamp": "02:59:33", "text": "是的。所以，为了腾出更多空间或"}, {"type": "subtitle", "time": 10777.19, "timestamp": "02:59:37", "text": "我不知道它是否也像那样。"}, {"type": "subtitle", "time": 10781.269, "timestamp": "02:59:41", "text": "很多。我知道这很复杂，但是"}, {"type": "subtitle", "time": 10783.91, "timestamp": "02:59:43", "text": "对，那确实是个很棒的想法。"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "至少。我的天啊。"}, {"type": "subtitle", "time": 10789.11, "timestamp": "02:59:49", "text": "然后，然后，就只有这三个了。"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "东西。不。那之后呢？嗯，我们可以做"}, {"type": "subtitle", "time": 10796.07, "timestamp": "02:59:56", "text": "有点像《堡垒之夜》那样。"}, {"type": "subtitle", "time": 10798.389, "timestamp": "02:59:58", "text": "像这样。我们可以把三个都拿下来。"}]
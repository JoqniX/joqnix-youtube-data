[{"type": "subtitle", "time": 15726.149, "timestamp": "04:22:06", "text": "哦，原来是这个人建造了这个。"}, {"type": "subtitle", "time": 15729.42, "timestamp": "04:22:09", "text": "地方。好的。"}, {"type": "subtitle", "time": 15731.51, "timestamp": "04:22:11", "text": "[音乐]"}, {"type": "subtitle", "time": 15734.07, "timestamp": "04:22:14", "text": "墙体已建好。端口密钥已正确设置。"}, {"type": "subtitle", "time": 15737.429, "timestamp": "04:22:17", "text": "隐。或许做得太好了。我想知道是否"}, {"type": "subtitle", "time": 15740.55, "timestamp": "04:22:20", "text": "我们开辟的这条路或许是不可能的。"}, {"type": "subtitle", "time": 15743.189, "timestamp": "04:22:23", "text": "敬请期待。这根本不可能"}, {"type": "subtitle", "time": 15745.189, "timestamp": "04:22:25", "text": "对于一个看不见古代痕迹的人来说"}, {"type": "subtitle", "time": 15748.229, "timestamp": "04:22:28", "text": "尽我所能地施展魔法。你能够看到什么"}, {"type": "subtitle", "time": 15750.149, "timestamp": "04:22:30", "text": "其他人做不到这一点，这还不够。"}, {"type": "subtitle", "time": 15751.75, "timestamp": "04:22:31", "text": "珀科尔，"}, {"type": "subtitle", "time": 15753.83, "timestamp": "04:22:33", "text": "我们把重任托付给踏上征程的人"}, {"type": "subtitle", "time": 15756.389, "timestamp": "04:22:36", "text": "这条道路蕴藏着强大的秘密"}, {"type": "subtitle", "time": 15758.87, "timestamp": "04:22:38", "text": "知道别人会不惜一切代价"}, {"type": "subtitle", "time": 15761.83, "timestamp": "04:22:41", "text": "获得。是的。如果我们的判断是正确的，"}, {"type": "subtitle", "time": 15764.07, "timestamp": "04:22:44", "text": "查尔斯，那个巫师或男巫"}, {"type": "subtitle", "time": 15765.67, "timestamp": "04:22:45", "text": "完成试验将证明"}, {"type": "subtitle", "time": 15768.389, "timestamp": "04:22:48", "text": "他们自己配得上这种知识，"}, {"type": "subtitle", "time": 15772.71, "timestamp": "04:22:52", "text": "以及随之而来的责任。"}]
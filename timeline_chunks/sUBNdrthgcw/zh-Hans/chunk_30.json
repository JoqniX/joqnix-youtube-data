[{"type": "subtitle", "time": 1805.669, "timestamp": "00:30:05", "text": "之后我就没再玩这个游戏了。我"}, {"type": "subtitle", "time": 1808.47, "timestamp": "00:30:08", "text": "看来是敏感体质。"}, {"type": "subtitle", "time": 1810.95, "timestamp": "00:30:10", "text": "天哪，还要多久？"}, {"type": "subtitle", "time": 1814.149, "timestamp": "00:30:14", "text": "我还要受多久的折磨"}, {"type": "subtitle", "time": 1816.07, "timestamp": "00:30:16", "text": "返回"}, {"type": "subtitle", "time": 1852.47, "timestamp": "00:30:52", "text": "我这边有17例死亡病例。你好。"}]
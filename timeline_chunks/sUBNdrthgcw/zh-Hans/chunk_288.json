[{"type": "subtitle", "time": 17280.07, "timestamp": "04:48:00", "text": "什么"}, {"type": "subtitle", "time": 17283.27, "timestamp": "04:48:03", "text": "过来，好的。"}, {"type": "subtitle", "time": 17286.07, "timestamp": "04:48:06", "text": "挑战。"}, {"type": "subtitle", "time": 17288.39, "timestamp": "04:48:08", "text": "哦，我是从那里看到的。好的。好的。"}, {"type": "subtitle", "time": 17296.55, "timestamp": "04:48:16", "text": "很聪明，不是吗？睁大眼睛"}, {"type": "subtitle", "time": 17299.67, "timestamp": "04:48:19", "text": "了解更多类似的机会"}, {"type": "subtitle", "time": 17302.708, "timestamp": "04:48:22", "text": "以及在……之外"}, {"type": "subtitle", "time": 17304.94, "timestamp": "04:48:24", "text": "H"}, {"type": "subtitle", "time": 17306.47, "timestamp": "04:48:26", "text": "[音乐]"}, {"type": "subtitle", "time": 17310.47, "timestamp": "04:48:30", "text": "茶。这是什么茶？"}, {"type": "subtitle", "time": 17312.708, "timestamp": "04:48:32", "text": "发光体。"}, {"type": "subtitle", "time": 17314.948, "timestamp": "04:48:34", "text": "哦，这些是你可以施放的咒语。哦。"}, {"type": "subtitle", "time": 17318.38, "timestamp": "04:48:38", "text": "哦，那真酷。"}, {"type": "subtitle", "time": 17320.31, "timestamp": "04:48:40", "text": "[音乐]"}, {"type": "subtitle", "time": 17324.07, "timestamp": "04:48:44", "text": "我迫不及待地想成为浪费方面的专家。"}, {"type": "subtitle", "time": 17326.868, "timestamp": "04:48:46", "text": "巫师，就像你知道的探索一样"}, {"type": "subtitle", "time": 17330.23, "timestamp": "04:48:50", "text": "打怪、做事情、升级"}, {"type": "subtitle", "time": 17333.43, "timestamp": "04:48:53", "text": "最高可以达到100级左右。那是"}]
[{"type": "subtitle", "time": 12600.63, "timestamp": "03:30:00", "text": "颜色，伙计？我真的好多了。你是"}, {"type": "subtitle", "time": 12605.429, "timestamp": "03:30:05", "text": "好的。你想让我走吗？好的，"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "然后。呃，"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "但它的质量很差。我看不见。"}, {"type": "subtitle", "time": 12614.07, "timestamp": "03:30:14", "text": "有什么办法可以更改吗？我不能。"}, {"type": "subtitle", "time": 12616.55, "timestamp": "03:30:16", "text": "正确的。"}, {"type": "subtitle", "time": 12618.71, "timestamp": "03:30:18", "text": "我不能。好的。我们不必受苦"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "就这样。没关系。所以，呃，哪个更合适？"}, {"type": "subtitle", "time": 12631.429, "timestamp": "03:30:31", "text": "哪个适合Jock？"}, {"type": "subtitle", "time": 12635.11, "timestamp": "03:30:35", "text": "我……我感到困惑。"}, {"type": "subtitle", "time": 12636.87, "timestamp": "03:30:36", "text": "我该如何再次查看？等等，我需要一个"}, {"type": "subtitle", "time": 12640.229, "timestamp": "03:30:40", "text": "参考我笔下的一个角色。等待。"}, {"type": "subtitle", "time": 12650.229, "timestamp": "03:30:50", "text": "等等，我该选哪个？我的天哪，这是"}, {"type": "subtitle", "time": 12651.83, "timestamp": "03:30:51", "text": "奇怪的。"}, {"type": "subtitle", "time": 12654.03, "timestamp": "03:30:54", "text": "这很奇怪。呃"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "[音乐]"}, {"type": "subtitle", "time": 12658.95, "timestamp": "03:30:58", "text": "我的天啊，这……我的天啊，这……"}]
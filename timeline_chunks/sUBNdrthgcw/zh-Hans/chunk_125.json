[{"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "好的。 NDI 发生了什么事？"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "你还活着。什么？"}, {"type": "subtitle", "time": 7510.31, "timestamp": "02:05:10", "text": "你怎么了？"}, {"type": "subtitle", "time": 7514.229, "timestamp": "02:05:14", "text": "哦，你好。呃，你还活着吗？"}, {"type": "subtitle", "time": 7516.47, "timestamp": "02:05:16", "text": "等等，发生了什么事？哦，我必须"}, {"type": "subtitle", "time": 7519.189, "timestamp": "02:05:19", "text": "点击。好的。启动道具。前往"}, {"type": "subtitle", "time": 7521.669, "timestamp": "02:05:21", "text": "特性。那就买吧。离开"}, {"type": "subtitle", "time": 7523.669, "timestamp": "02:05:23", "text": "特性。它会重置。刷新。"}, {"type": "subtitle", "time": 7525.83, "timestamp": "02:05:25", "text": "好的。"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "知道了。"}, {"type": "subtitle", "time": 7531.03, "timestamp": "02:05:31", "text": "问题是我没有更新到……"}, {"type": "subtitle", "time": 7534.31, "timestamp": "02:05:34", "text": "印度的最新版本是因为现在"}, {"type": "subtitle", "time": 7537.43, "timestamp": "02:05:37", "text": "呃，他们呃，算是带来了新的"}, {"type": "subtitle", "time": 7541.51, "timestamp": "02:05:41", "text": "低延迟特性"}, {"type": "subtitle", "time": 7543.35, "timestamp": "02:05:43", "text": "某某事，有点……"}, {"type": "subtitle", "time": 7545.03, "timestamp": "02:05:45", "text": "搞砸了。所以，它没有类似的东西。"}, {"type": "subtitle", "time": 7546.79, "timestamp": "02:05:46", "text": "透明度。"}, {"type": "subtitle", "time": 7550.79, "timestamp": "02:05:50", "text": "所以，这真是个大麻烦。"}, {"type": "subtitle", "time": 7552.629, "timestamp": "02:05:52", "text": "好的。呃，"}]
[{"type": "subtitle", "time": 7801.03, "timestamp": "02:10:01", "text": "就像有人在聊天中输入了“订单三”一样"}, {"type": "subtitle", "time": 7803.189, "timestamp": "02:10:03", "text": "可以做到。我以前也这样做过"}, {"type": "subtitle", "time": 7804.87, "timestamp": "02:10:04", "text": "那"}, {"type": "subtitle", "time": 7806.629, "timestamp": "02:10:06", "text": "嗯"}, {"type": "subtitle", "time": 7808.55, "timestamp": "02:10:08", "text": "是最近的闲聊之类的吧？所以"}, {"type": "subtitle", "time": 7811.03, "timestamp": "02:10:11", "text": "例如，如果你此刻你"}, {"type": "subtitle", "time": 7813.27, "timestamp": "02:10:13", "text": "是最后一种类型的闲聊，对吧？所以"}, {"type": "subtitle", "time": 7816.229, "timestamp": "02:10:16", "text": "当其他用户出现时，它会显示你的图像。"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "有人输入“呃”，他们的图片将会是"}, {"type": "subtitle", "time": 7821.109, "timestamp": "02:10:21", "text": "已显示。你还记得我头上的那个垫子吗？"}, {"type": "subtitle", "time": 7824.55, "timestamp": "02:10:24", "text": "我也遇到过同样的情况。不，但我不知道"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "我该怎么做呢？比如，我可以这样做。"}, {"type": "subtitle", "time": 7830.229, "timestamp": "02:10:30", "text": "就像感叹词之类的。"}, {"type": "subtitle", "time": 7832.629, "timestamp": "02:10:32", "text": "命令并添加这些人"}, {"type": "subtitle", "time": 7835.669, "timestamp": "02:10:35", "text": "以及它们在一组照片或其他什么照片中的样子"}, {"type": "subtitle", "time": 7838.79, "timestamp": "02:10:38", "text": "就这样弄到手。"}, {"type": "subtitle", "time": 7841.43, "timestamp": "02:10:41", "text": "嗯，这也包括这种方法。如果"}, {"type": "subtitle", "time": 7843.51, "timestamp": "02:10:43", "text": "我既能做到这一点，也能做到这一点。"}, {"type": "subtitle", "time": 7846.629, "timestamp": "02:10:46", "text": "这种方法也行得通吗？"}, {"type": "subtitle", "time": 7849.91, "timestamp": "02:10:49", "text": "人的头像和装饰品"}, {"type": "subtitle", "time": 7852.629, "timestamp": "02:10:52", "text": "他们做出了选择。所以，我可以直接复制粘贴吗？"}, {"type": "subtitle", "time": 7854.149, "timestamp": "02:10:54", "text": "装饰品"}, {"type": "subtitle", "time": 7856.31, "timestamp": "02:10:56", "text": "拖放"}, {"type": "subtitle", "time": 7858.709, "timestamp": "02:10:58", "text": "而不是把所有东西都放进去。"}]
[{"type": "subtitle", "time": 11341.269, "timestamp": "03:09:01", "text": "感谢你的辛勤工作，继续加油！"}, {"type": "subtitle", "time": 11344.71, "timestamp": "03:09:04", "text": "我们已尽力而为。嗯？愿星辰指引"}, {"type": "subtitle", "time": 11347.67, "timestamp": "03:09:07", "text": "你。"}, {"type": "subtitle", "time": 11351.349, "timestamp": "03:09:11", "text": "你好。好了，今天就到这里。"}, {"type": "subtitle", "time": 11354.389, "timestamp": "03:09:14", "text": "28号见。"}, {"type": "subtitle", "time": 11358.469, "timestamp": "03:09:18", "text": "再见。各位晚安。"}, {"type": "subtitle", "time": 11363.03, "timestamp": "03:09:23", "text": "最后。圣诞快乐，新年快乐！"}, {"type": "subtitle", "time": 11366.07, "timestamp": "03:09:26", "text": "不，不。我会在那儿过新年。"}, {"type": "subtitle", "time": 11367.99, "timestamp": "03:09:27", "text": "没关系。"}, {"type": "subtitle", "time": 11371.75, "timestamp": "03:09:31", "text": "祝大家2023年圣诞快乐。全部"}]
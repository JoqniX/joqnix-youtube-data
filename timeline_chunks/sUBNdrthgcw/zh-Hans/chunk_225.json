[{"type": "subtitle", "time": 13501.03, "timestamp": "03:45:01", "text": "角色实际上是男性"}, {"type": "subtitle", "time": 13503.99, "timestamp": "03:45:03", "text": "因为每个人都想要"}, {"type": "subtitle", "time": 13509.99, "timestamp": "03:45:09", "text": "我的意思是，嗯，是的，几个，几个，几个"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "人们想要的是男性，所以我才去了。"}, {"type": "subtitle", "time": 13514.71, "timestamp": "03:45:14", "text": "要么跟男性，要么我就跟……"}, {"type": "subtitle", "time": 13516.79, "timestamp": "03:45:16", "text": "虽然是女性。"}, {"type": "subtitle", "time": 13519.59, "timestamp": "03:45:19", "text": "等等，我应该换衣服吗？我应该改变吗？"}, {"type": "subtitle", "time": 13523.75, "timestamp": "03:45:23", "text": "是女性吗？我应该换个说法吗？我"}, {"type": "subtitle", "time": 13525.99, "timestamp": "03:45:25", "text": "不知道。"}, {"type": "subtitle", "time": 13528.87, "timestamp": "03:45:28", "text": "我应该吗？"}, {"type": "subtitle", "time": 13531.429, "timestamp": "03:45:31", "text": "视觉"}, {"type": "subtitle", "time": 13534.229, "timestamp": "03:45:34", "text": "我的意思是，我可以改变性别。我"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "我的意思是，如果我是为了安慰，但是"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "唉，这太难了。我是。那真是相当"}, {"type": "subtitle", "time": 13543.189, "timestamp": "03:45:43", "text": "某物。"}, {"type": "subtitle", "time": 13544.95, "timestamp": "03:45:44", "text": "就像一张滑稽的高音调女性照片"}, {"type": "subtitle", "time": 13546.79, "timestamp": "03:45:46", "text": "朋友。"}, {"type": "subtitle", "time": 13548.95, "timestamp": "03:45:48", "text": "我很喜欢这个。嗯？我很期待。那是"}, {"type": "subtitle", "time": 13551.269, "timestamp": "03:45:51", "text": "精彩的。我相信我真的会"}, {"type": "subtitle", "time": 13555.59, "timestamp": "03:45:55", "text": "好好享受这门课吧。这个？好的。你"}, {"type": "subtitle", "time": 13558.63, "timestamp": "03:45:58", "text": "你想要这个吗？几张蜘蛛网和"}]
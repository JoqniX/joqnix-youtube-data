[{"type": "subtitle", "time": 6131.75, "timestamp": "01:42:11", "text": "下次我这样做的时候，嗯，我会安装……"}, {"type": "subtitle", "time": 6135.03, "timestamp": "01:42:15", "text": "请使用默认设置，而不是……"}, {"type": "subtitle", "time": 6138.07, "timestamp": "01:42:18", "text": "就这样把所有事情都考虑进去吧"}, {"type": "subtitle", "time": 6140.629, "timestamp": "01:42:20", "text": "每个。好的。呃，在我们继续之前，我……"}, {"type": "subtitle", "time": 6143.43, "timestamp": "01:42:23", "text": "把这些都删掉，因为我们已经……"}, {"type": "subtitle", "time": 6147.189, "timestamp": "01:42:27", "text": "各位，我们删除这条。"}, {"type": "subtitle", "time": 6150.79, "timestamp": "01:42:30", "text": "这样有助于我们呼吸。"}, {"type": "subtitle", "time": 6153.109, "timestamp": "01:42:33", "text": "一点点。"}, {"type": "subtitle", "time": 6159.83, "timestamp": "01:42:39", "text": "呃"}, {"type": "subtitle", "time": 6162.31, "timestamp": "01:42:42", "text": "我想查看它每天消耗多少能量。"}, {"type": "subtitle", "time": 6168.55, "timestamp": "01:42:48", "text": "37"}, {"type": "subtitle", "time": 6172.229, "timestamp": "01:42:52", "text": "1.2.4 然后就崩溃了。你是"}, {"type": "subtitle", "time": 6179.109, "timestamp": "01:42:59", "text": "是的。然后它崩溃了。"}]
[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "换成二手魔杖。你将成为一股强大的力量。"}, {"type": "subtitle", "time": 13622.229, "timestamp": "03:47:02", "text": "当你获得……时，你不可小觑"}, {"type": "subtitle", "time": 13624.95, "timestamp": "03:47:04", "text": "自己的。谢谢您，维克教授。我"}, {"type": "subtitle", "time": 13633.11, "timestamp": "03:47:13", "text": "哦，埃​​拉扎尔。"}, {"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "乔治，很高兴我那略显晦涩的……"}, {"type": "subtitle", "time": 13636.79, "timestamp": "03:47:16", "text": "对我们位置的描述没有"}, {"type": "subtitle", "time": 13638.79, "timestamp": "03:47:18", "text": "阻止你找到我们。我已幻影移形"}, {"type": "subtitle", "time": 13640.389, "timestamp": "03:47:20", "text": "前往更模糊的目的地"}, {"type": "subtitle", "time": 13645.75, "timestamp": "03:47:25", "text": "比这更糟。我承认我的m"}, {"type": "subtitle", "time": 13647.03, "timestamp": "03:47:27", "text": "把一些人吓了一跳。"}, {"type": "subtitle", "time": 13650.07, "timestamp": "03:47:30", "text": "西区的剧院观众。"}, {"type": "subtitle", "time": 13651.91, "timestamp": "03:47:31", "text": "没错，你们听到的就是我"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "收到你的信息后，我必须说我最好不要"}, {"type": "subtitle", "time": 13657.99, "timestamp": "03:47:37", "text": "请在这里发言。埃拉扎尔"}, {"type": "subtitle", "time": 13660.71, "timestamp": "03:47:40", "text": "当然。我们为什么不在路上谈谈呢？"}, {"type": "subtitle", "time": 13662.87, "timestamp": "03:47:42", "text": "去霍格沃茨？我们开学了"}, {"type": "subtitle", "time": 13665.269, "timestamp": "03:47:45", "text": "盛宴和分拣仪式即将开始。"}, {"type": "subtitle", "time": 13667.189, "timestamp": "03:47:47", "text": "好主意。只要你年轻"}, {"type": "subtitle", "time": 13668.95, "timestamp": "03:47:48", "text": "这里的收费人员不介意我标记"}, {"type": "subtitle", "time": 13671.03, "timestamp": "03:47:51", "text": "沿着。"}, {"type": "subtitle", "time": 13673.03, "timestamp": "03:47:53", "text": "您先请。"}, {"type": "subtitle", "time": 13675.59, "timestamp": "03:47:55", "text": "好久没去过那座城堡了。"}, {"type": "subtitle", "time": 13677.83, "timestamp": "03:47:57", "text": "很想看看那堆旧东西"}]
[{"type": "subtitle", "time": 13806.55, "timestamp": "03:50:06", "text": "是的。你好。你见过这个吗？"}, {"type": "subtitle", "time": 13808.55, "timestamp": "03:50:08", "text": "哦，"}, {"type": "subtitle", "time": 13812.07, "timestamp": "03:50:12", "text": "我有。我忘记了新闻和威胁"}, {"type": "subtitle", "time": 13814.55, "timestamp": "03:50:14", "text": "Renrock 确实如此。"}, {"type": "subtitle", "time": 13816.07, "timestamp": "03:50:16", "text": "虽然我还没能说服我的"}, {"type": "subtitle", "time": 13818.63, "timestamp": "03:50:18", "text": "我相信，他在部里的同事们"}, {"type": "subtitle", "time": 13823.51, "timestamp": "03:50:23", "text": "构成重大威胁。而那是你的"}, {"type": "subtitle", "time": 13826.07, "timestamp": "03:50:26", "text": "妻子，埃拉扎尔"}, {"type": "subtitle", "time": 13828.229, "timestamp": "03:50:28", "text": "几个月前，有人向我透露了他的活动。"}, {"type": "subtitle", "time": 13832.15, "timestamp": "03:50:32", "text": "前。米里亚姆，你好吗？"}, {"type": "subtitle", "time": 13833.99, "timestamp": "03:50:33", "text": "她之前给我写过关于兰德罗克的事。"}, {"type": "subtitle", "time": 13836.95, "timestamp": "03:50:36", "text": "她临终前还在想，这个部门究竟在做什么。"}, {"type": "subtitle", "time": 13840.63, "timestamp": "03:50:40", "text": "知道他的所作所为。"}, {"type": "subtitle", "time": 13843.75, "timestamp": "03:50:43", "text": "我还没来得及回应，我就"}, {"type": "subtitle", "time": 13846.07, "timestamp": "03:50:46", "text": "已收到。"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "这是她发给我的最后一件东西。"}, {"type": "subtitle", "time": 13852.71, "timestamp": "03:50:52", "text": "埃拉扎尔。消息是通过她的猫头鹰传给我的，但是"}, {"type": "subtitle", "time": 13854.63, "timestamp": "03:50:54", "text": "没有通信。"}, {"type": "subtitle", "time": 13856.309, "timestamp": "03:50:56", "text": "我只能推测她不得不去"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "为了安全起见，请尽快处理掉。"}]
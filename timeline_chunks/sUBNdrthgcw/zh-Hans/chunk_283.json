[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "普通巫师等级考试。他们"}, {"type": "subtitle", "time": 16983.03, "timestamp": "04:43:03", "text": "这将决定你从事哪种类型的职业。"}, {"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "离开这里时可以带走。经过很多"}, {"type": "subtitle", "time": 16987.51, "timestamp": "04:43:07", "text": "与校长讨论"}, {"type": "subtitle", "time": 16989.35, "timestamp": "04:43:09", "text": "魔法教育系"}, {"type": "subtitle", "time": 16991.83, "timestamp": "04:43:11", "text": "部里，我们已经想出了一个办法"}, {"type": "subtitle", "time": 16994.868, "timestamp": "04:43:14", "text": "竭尽全力确保您的成功。"}, {"type": "subtitle", "time": 16997.51, "timestamp": "04:43:17", "text": "好的，"}, {"type": "subtitle", "time": 17017.91, "timestamp": "04:43:37", "text": "那是什么？这是一片巫师的领域"}, {"type": "subtitle", "time": 17020.31, "timestamp": "04:43:40", "text": "指导。它将帮助你跟踪……"}, {"type": "subtitle", "time": 17022.47, "timestamp": "04:43:42", "text": "你所学习的内容，是为了让你掌握"}, {"type": "subtitle", "time": 17026.15, "timestamp": "04:43:46", "text": "这是第五年应尽的义务。"}, {"type": "subtitle", "time": 17028.23, "timestamp": "04:43:48", "text": "明智的做法是充分利用这些优势。"}, {"type": "subtitle", "time": 17030.868, "timestamp": "04:43:50", "text": "这件物品极其珍贵。该死，我"}, {"type": "subtitle", "time": 17038.55, "timestamp": "04:43:58", "text": "谢谢教授。但是你呢？"}]
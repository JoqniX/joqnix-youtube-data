[{"type": "subtitle", "time": 11160.309, "timestamp": "03:06:00", "text": "东西，呃，可能会出租，而且会大量死亡。"}, {"type": "subtitle", "time": 11163.19, "timestamp": "03:06:03", "text": "还有其他一些东西，比如切换灵敏度。"}, {"type": "subtitle", "time": 11168.55, "timestamp": "03:06:08", "text": "很多。我们做了装饰。"}, {"type": "subtitle", "time": 11171.51, "timestamp": "03:06:11", "text": "还有我们家的圣诞树"}, {"type": "subtitle", "time": 11175.349, "timestamp": "03:06:15", "text": "圣诞树。是的，我们做到了。"}, {"type": "subtitle", "time": 11178.15, "timestamp": "03:06:18", "text": "我们玩得很开心。"}, {"type": "subtitle", "time": 11182.79, "timestamp": "03:06:22", "text": "这是怎么回事？ 28号见。"}, {"type": "subtitle", "time": 11186.79, "timestamp": "03:06:26", "text": "如果可以，我会试着尖叫"}, {"type": "subtitle", "time": 11198.309, "timestamp": "03:06:38", "text": "但就像喷洒并希望……"}, {"type": "subtitle", "time": 11200.87, "timestamp": "03:06:40", "text": "我的两台电脑都没出问题，因为"}, {"type": "subtitle", "time": 11204.15, "timestamp": "03:06:44", "text": "我要离开五天，没有8"}, {"type": "subtitle", "time": 11205.91, "timestamp": "03:06:45", "text": "天"}, {"type": "subtitle", "time": 11208.15, "timestamp": "03:06:48", "text": "明天之后。呃，已经……"}, {"type": "subtitle", "time": 11211.349, "timestamp": "03:06:51", "text": "明天。已经是22号了。哦，来自"}, {"type": "subtitle", "time": 11214.95, "timestamp": "03:06:54", "text": "从今天起。是的，从今晚开始"}, {"type": "subtitle", "time": 11217.269, "timestamp": "03:06:57", "text": "27、28日。"}, {"type": "subtitle", "time": 11219.83, "timestamp": "03:06:59", "text": "所以，是的，我不会见到PC Chan和Joy了。"}]
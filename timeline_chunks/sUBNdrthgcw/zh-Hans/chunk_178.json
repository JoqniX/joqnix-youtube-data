[{"type": "subtitle", "time": 10681.11, "timestamp": "02:58:01", "text": "这意味着人们可以上传图片。"}, {"type": "subtitle", "time": 10685.03, "timestamp": "02:58:05", "text": "或者使用他们的 Discord 或其他类似的工具"}, {"type": "subtitle", "time": 10687.99, "timestamp": "02:58:07", "text": "东西。他们可以选择任何一件装饰品。"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "他们想要的装饰品就像预设好的一样。"}, {"type": "subtitle", "time": 10692.95, "timestamp": "02:58:12", "text": "然后他们可以把那个放进去，然后它就会"}, {"type": "subtitle", "time": 10696.23, "timestamp": "02:58:16", "text": "当用户上传时自动执行"}, {"type": "subtitle", "time": 10699.03, "timestamp": "02:58:19", "text": "选择图像和装饰物"}, {"type": "subtitle", "time": 10702.95, "timestamp": "02:58:22", "text": "预览将显示头像如何"}, {"type": "subtitle", "time": 10705.349, "timestamp": "02:58:25", "text": "他们添加的图片"}, {"type": "subtitle", "time": 10707.83, "timestamp": "02:58:27", "text": "加上装饰品后的效果如何。然后"}, {"type": "subtitle", "time": 10711.19, "timestamp": "02:58:31", "text": "他们可以拖动那个预览装置，或者"}, {"type": "subtitle", "time": 10713.99, "timestamp": "02:58:33", "text": "把那个装饰品放在大……"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "圣诞树。"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "所以那棵圣诞树就会像……"}, {"type": "subtitle", "time": 10721.11, "timestamp": "02:58:41", "text": "每个位置都配有容器或其他物品"}, {"type": "subtitle", "time": 10724.07, "timestamp": "02:58:44", "text": "呃，那个地方。是的。是的。一样"}, {"type": "subtitle", "time": 10726.55, "timestamp": "02:58:46", "text": "我现在把它挂在树上，"}, {"type": "subtitle", "time": 10731.03, "timestamp": "02:58:51", "text": "正确的？我根据那块金子般的土地把它放在那里"}, {"type": "subtitle", "time": 10734.71, "timestamp": "02:58:54", "text": "是星星，对吧？就这样。将会"}, {"type": "subtitle", "time": 10738.23, "timestamp": "02:58:58", "text": "像一个斑点。是的。所以用户必须"}]
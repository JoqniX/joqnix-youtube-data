[{"type": "subtitle", "time": 15000.55, "timestamp": "04:10:00", "text": "上一次发生这种情况是什么时候？"}, {"type": "subtitle", "time": 15003.51, "timestamp": "04:10:03", "text": "访问了吗？一个哥布林被派驻到……"}, {"type": "subtitle", "time": 15007.03, "timestamp": "04:10:07", "text": "我的办公桌用了几百年了。在那"}, {"type": "subtitle", "time": 15009.75, "timestamp": "04:10:09", "text": "时间已久，无人到访。看看"}, {"type": "subtitle", "time": 15040.229, "timestamp": "04:10:40", "text": "我们为什么要在这里向某人敞开心扉？"}, {"type": "subtitle", "time": 15043.189, "timestamp": "04:10:43", "text": "又是别人的保险库？你觉得呢？"}, {"type": "subtitle", "time": 15046.229, "timestamp": "04:10:46", "text": "我们应该寻找什么？我不知道。"}, {"type": "subtitle", "time": 15048.389, "timestamp": "04:10:48", "text": "先生，我想知道您是否……"}, {"type": "subtitle", "time": 15050.55, "timestamp": "04:10:50", "text": "对于 Vault 12，表明我应该授予"}, {"type": "subtitle", "time": 15053.03, "timestamp": "04:10:53", "text": "然后，可以接触到钥匙持有者。"}]
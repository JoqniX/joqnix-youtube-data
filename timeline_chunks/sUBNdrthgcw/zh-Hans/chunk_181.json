[{"type": "subtitle", "time": 10861.349, "timestamp": "03:01:01", "text": "就像我的几个朋友那样"}, {"type": "subtitle", "time": 10863.75, "timestamp": "03:01:03", "text": "玩《企鹅俱乐部：传承》或"}, {"type": "subtitle", "time": 10866.23, "timestamp": "03:01:06", "text": "某物。我当时就想，咦，他们不是吗？"}, {"type": "subtitle", "time": 10868.309, "timestamp": "03:01:08", "text": "停止他们的服务或其他什么情况"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "被禁了吗？我之前不知道，但后来我做了一个"}, {"type": "subtitle", "time": 10874.87, "timestamp": "03:01:14", "text": "为那个旧账号开个新账号"}, {"type": "subtitle", "time": 10877.11, "timestamp": "03:01:17", "text": "我玩的时候就想，我的天哪，这"}, {"type": "subtitle", "time": 10879.19, "timestamp": "03:01:19", "text": "太好玩了。"}, {"type": "subtitle", "time": 10882.309, "timestamp": "03:01:22", "text": "所以如果一款浏览器游戏可以……呃，如果那样的话"}, {"type": "subtitle", "time": 10885.03, "timestamp": "03:01:25", "text": "如果这件事是可能的，那么这也行得通。"}, {"type": "subtitle", "time": 10887.83, "timestamp": "03:01:27", "text": "我觉得有可能，我只需要……"}, {"type": "subtitle", "time": 10891.99, "timestamp": "03:01:31", "text": "以某种方式深入研究它，并以某种方式"}, {"type": "subtitle", "time": 10899.11, "timestamp": "03:01:39", "text": "是的。那真是个好主意。自动和"}, {"type": "subtitle", "time": 10902.71, "timestamp": "03:01:42", "text": "网站托管的东西。"}, {"type": "subtitle", "time": 10905.59, "timestamp": "03:01:45", "text": "是的，我不需要那种压力。"}, {"type": "subtitle", "time": 10910.23, "timestamp": "03:01:50", "text": "我自己或者花太多时间"}, {"type": "subtitle", "time": 10913.67, "timestamp": "03:01:53", "text": "就像今天这样，我自己动手做。但那一个"}, {"type": "subtitle", "time": 10916.469, "timestamp": "03:01:56", "text": "会好起来的。所以我可以把它展示出来"}, {"type": "subtitle", "time": 10918.79, "timestamp": "03:01:58", "text": "当大家都在直播的时候"}]
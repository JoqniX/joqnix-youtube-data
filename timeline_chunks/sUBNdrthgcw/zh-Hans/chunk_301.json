[{"type": "subtitle", "time": 18061.27, "timestamp": "05:01:01", "text": "韦斯莱教授，不如我来给你演示一下吧。"}, {"type": "subtitle", "time": 18063.43, "timestamp": "05:01:03", "text": "我们巧妙地融入了魔法之中"}, {"type": "subtitle", "time": 18065.99, "timestamp": "05:01:05", "text": "野外指南地图。展开它，然后……"}, {"type": "subtitle", "time": 18069.59, "timestamp": "05:01:09", "text": "看一眼。好的。"}, {"type": "subtitle", "time": 18071.59, "timestamp": "05:01:11", "text": "任务日志。您可以跟踪可用信息"}, {"type": "subtitle", "time": 18079.91, "timestamp": "05:01:19", "text": "代表着进一步发展的主要方向"}, {"type": "subtitle", "time": 18081.59, "timestamp": "05:01:21", "text": "故事情节，解锁新功能，并获得奖励"}, {"type": "subtitle", "time": 18084.07, "timestamp": "05:01:24", "text": "XP。"}, {"type": "subtitle", "time": 18086.15, "timestamp": "05:01:26", "text": "继续。部分任务被锁定"}, {"type": "subtitle", "time": 18088.55, "timestamp": "05:01:28", "text": "施法或有等级要求。在"}, {"type": "subtitle", "time": 18090.948, "timestamp": "05:01:30", "text": "在这些情况下，你需要……"}, {"type": "subtitle", "time": 18092.628, "timestamp": "05:01:32", "text": "需要达到特定等级或拥有特定法术"}, {"type": "subtitle", "time": 18094.868, "timestamp": "05:01:34", "text": "激活任务。新技能可以是"}, {"type": "subtitle", "time": 18096.55, "timestamp": "05:01:36", "text": "通过完成教授的课程获得"}, {"type": "subtitle", "time": 18101.03, "timestamp": "05:01:41", "text": "任务或任务奖励。好的。"}, {"type": "subtitle", "time": 18104.47, "timestamp": "05:01:44", "text": "一次与……的冒险"}, {"type": "subtitle", "time": 18112.64, "timestamp": "05:01:52", "text": "我们就选魅力课吧。"}, {"type": "subtitle", "time": 18114.868, "timestamp": "05:01:54", "text": "[音乐]"}]
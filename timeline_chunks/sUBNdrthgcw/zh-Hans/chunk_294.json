[{"type": "subtitle", "time": 17640.15, "timestamp": "04:54:00", "text": "既是护身符，又是抵御黑暗的防御手段。"}, {"type": "subtitle", "time": 17642.948, "timestamp": "04:54:02", "text": "今天有艺术课。而我希望是"}, {"type": "subtitle", "time": 17645.27, "timestamp": "04:54:05", "text": "确保你尽快到达霍格莫"}, {"type": "subtitle", "time": 17647.19, "timestamp": "04:54:07", "text": "可以更换您所需的耗材"}, {"type": "subtitle", "time": 17652.708, "timestamp": "04:54:12", "text": "我在Charm号的船上。我将做什么"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "在魔咒课上学到什么？正是你想要的"}, {"type": "subtitle", "time": 17658.39, "timestamp": "04:54:18", "text": "可能预料到。咒语、符咒、厄运"}, {"type": "subtitle", "time": 17660.868, "timestamp": "04:54:20", "text": "都非常有用。我想你会"}, {"type": "subtitle", "time": 17663.91, "timestamp": "04:54:23", "text": "请欣赏浪人教授。他很聪明，而且"}, {"type": "subtitle", "time": 17666.39, "timestamp": "04:54:26", "text": "风趣幽默的巫师。以及一位才华横溢的人"}, {"type": "subtitle", "time": 17667.54, "timestamp": "04:54:27", "text": "老师。"}, {"type": "subtitle", "time": 17669.19, "timestamp": "04:54:29", "text": "[音乐]"}, {"type": "subtitle", "time": 17670.868, "timestamp": "04:54:30", "text": "您能详细说说防守方面的情况吗？"}, {"type": "subtitle", "time": 17672.868, "timestamp": "04:54:32", "text": "对抗黑魔法的课程？防御"}, {"type": "subtitle", "time": 17674.47, "timestamp": "04:54:34", "text": "对抗黑魔法，正如其名"}, {"type": "subtitle", "time": 17676.948, "timestamp": "04:54:36", "text": "这意味着，重点在于如何防御"}, {"type": "subtitle", "time": 17679.67, "timestamp": "04:54:39", "text": "对抗潜伏的邪恶"}, {"type": "subtitle", "time": 17682.868, "timestamp": "04:54:42", "text": "墙外。精通防御"}, {"type": "subtitle", "time": 17685.19, "timestamp": "04:54:45", "text": "对抗黑魔法是必要的"}, {"type": "subtitle", "time": 17689.51, "timestamp": "04:54:49", "text": "那些渴望成为幸运儿的人"}, {"type": "subtitle", "time": 17691.51, "timestamp": "04:54:51", "text": "能有这样一位才华横溢的教授真是我的幸运。"}, {"type": "subtitle", "time": 17693.35, "timestamp": "04:54:53", "text": "赫克特负责我们的学生"}, {"type": "subtitle", "time": 17695.75, "timestamp": "04:54:55", "text": "这方面的教育。"}, {"type": "subtitle", "time": 17698.23, "timestamp": "04:54:58", "text": "好的。 Hogsme是什么？你提到"}]
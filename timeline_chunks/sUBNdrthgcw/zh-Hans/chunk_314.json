[{"type": "subtitle", "time": 18841.27, "timestamp": "05:14:01", "text": "[音乐]"}, {"type": "subtitle", "time": 18843.35, "timestamp": "05:14:03", "text": "魅力等级。"}, {"type": "subtitle", "time": 18845.75, "timestamp": "05:14:05", "text": "好的，那我们去上魅力课吧。我不能"}, {"type": "subtitle", "time": 18849.27, "timestamp": "05:14:09", "text": "等我所有的姐妹们"}, {"type": "subtitle", "time": 18852.13, "timestamp": "05:14:12", "text": "开始。"}, {"type": "subtitle", "time": 18854.23, "timestamp": "05:14:14", "text": "[音乐]"}, {"type": "subtitle", "time": 18857.33, "timestamp": "05:14:17", "text": "我的天，这也太卡了吧。"}, {"type": "subtitle", "time": 18859.75, "timestamp": "05:14:19", "text": "[音乐]"}, {"type": "subtitle", "time": 18861.35, "timestamp": "05:14:21", "text": "这里"}, {"type": "subtitle", "time": 18865.27, "timestamp": "05:14:25", "text": "你身后有个空位。"}, {"type": "subtitle", "time": 18867.91, "timestamp": "05:14:27", "text": "谢谢。"}, {"type": "subtitle", "time": 18871.11, "timestamp": "05:14:31", "text": "你好呀。我是内蒂。所以你就是"}, {"type": "subtitle", "time": 18873.11, "timestamp": "05:14:33", "text": "新生。"}, {"type": "subtitle", "time": 18880.948, "timestamp": "05:14:40", "text": "我们开始吧？"}, {"type": "subtitle", "time": 18883.59, "timestamp": "05:14:43", "text": "欢迎来到魅力课程的第五年。现在这个"}, {"type": "subtitle", "time": 18886.23, "timestamp": "05:14:46", "text": "这将是你教育生涯中至关重要的一年。"}, {"type": "subtitle", "time": 18889.19, "timestamp": "05:14:49", "text": "论符咒艺术。但我"}, {"type": "subtitle", "time": 18891.91, "timestamp": "05:14:51", "text": "我们确信我们将取得进展"}, {"type": "subtitle", "time": 18894.948, "timestamp": "05:14:54", "text": "这样的热情和严谨是必要的"}, {"type": "subtitle", "time": 18897.67, "timestamp": "05:14:57", "text": "挑战。现在请大家……"}]
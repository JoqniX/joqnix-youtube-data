[{"type": "subtitle", "time": 15790.389, "timestamp": "04:23:10", "text": "这就是你看到的。那光芒"}, {"type": "subtitle", "time": 15793.349, "timestamp": "04:23:13", "text": "包围了他们。是的，先生。"}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "惊人。我能看到魔法吗？痕迹"}, {"type": "subtitle", "time": 15801.91, "timestamp": "04:23:21", "text": "准确来说，是一种古老的魔法。"}, {"type": "subtitle", "time": 15805.11, "timestamp": "04:23:25", "text": "我的天啊。米里亚姆一直都相信"}, {"type": "subtitle", "time": 15814.55, "timestamp": "04:23:34", "text": "米里亚姆和乔治或许都去世了。"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "对知识的追求"}, {"type": "subtitle", "time": 15819.429, "timestamp": "04:23:39", "text": "沉睡了几个世纪。"}, {"type": "subtitle", "time": 15822.149, "timestamp": "04:23:42", "text": "而你，似乎……"}, {"type": "subtitle", "time": 15824.71, "timestamp": "04:23:44", "text": "是理解我们为什么存在的关键"}, {"type": "subtitle", "time": 15826.71, "timestamp": "04:23:46", "text": "将要。这一切看起来截然不同。"}, {"type": "subtitle", "time": 15828.95, "timestamp": "04:23:48", "text": "刚才确实发生了。"}, {"type": "subtitle", "time": 15831.349, "timestamp": "04:23:51", "text": "有人来了。"}, {"type": "subtitle", "time": 15834.87, "timestamp": "04:23:54", "text": "他们是谁？我不知道。但是先生，"}]
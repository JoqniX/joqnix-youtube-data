[{"type": "subtitle", "time": 12483.429, "timestamp": "03:28:03", "text": "我的人生。谁发明了动态模糊？它是"}, {"type": "subtitle", "time": 12486.309, "timestamp": "03:28:06", "text": "难的。"}, {"type": "subtitle", "time": 12488.15, "timestamp": "03:28:08", "text": "嗯。好的。我们走吧。我们走吧。一切"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "没问题。一切都很好。我们走吧。我"}, {"type": "subtitle", "time": 12503.99, "timestamp": "03:28:23", "text": "嗯，"}, {"type": "subtitle", "time": 12507.429, "timestamp": "03:28:27", "text": "呃，正常亮度是这样的，但是"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "会稍微保留一点，这样大家……"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "你们都能看到。哦，等等。我忘了"}, {"type": "subtitle", "time": 12516.229, "timestamp": "03:28:36", "text": "小夜灯。我的夜灯开着。"}, {"type": "subtitle", "time": 12519.51, "timestamp": "03:28:39", "text": "等等，这会影响直播吗？等待，"}, {"type": "subtitle", "time": 12522.07, "timestamp": "03:28:42", "text": "你看到那个棕色的……呃……橙色的东西了吗？"}, {"type": "subtitle", "time": 12525.51, "timestamp": "03:28:45", "text": "还是只有我这么觉得？只有我这样吗？"}, {"type": "subtitle", "time": 12527.75, "timestamp": "03:28:47", "text": "呃，等等，你们看到这个了吗？"}, {"type": "subtitle", "time": 12531.03, "timestamp": "03:28:51", "text": "橙色的，非常亮的橙色东西"}, {"type": "subtitle", "time": 12533.16, "timestamp": "03:28:53", "text": "屏幕？不。对。"}, {"type": "subtitle", "time": 12534.55, "timestamp": "03:28:54", "text": "[音乐]"}, {"type": "subtitle", "time": 12536.229, "timestamp": "03:28:56", "text": "等等，那是不是意味着我可以和……一起玩？"}, {"type": "subtitle", "time": 12538.87, "timestamp": "03:28:58", "text": "小夜灯开着吗？哦，那对我有帮助。"}]
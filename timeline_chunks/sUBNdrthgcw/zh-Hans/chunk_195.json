[{"type": "subtitle", "time": 11704.229, "timestamp": "03:15:04", "text": "上帝。已经磨损的运动护裆。我的天啊。所以"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "呃，我的聊天框好像没显示出来。"}, {"type": "subtitle", "time": 11709.11, "timestamp": "03:15:09", "text": "是的，我的聊天框不见了。我没有"}, {"type": "subtitle", "time": 11713.51, "timestamp": "03:15:13", "text": "把我的东西拿走。我不能……"}, {"type": "subtitle", "time": 11715.11, "timestamp": "03:15:15", "text": "你在开玩笑吧？我甚至都看不懂。"}, {"type": "subtitle", "time": 11716.79, "timestamp": "03:15:16", "text": "聊天。"}, {"type": "subtitle", "time": 11719.429, "timestamp": "03:15:19", "text": "等待。你在开玩笑吧？"}, {"type": "subtitle", "time": 11728.15, "timestamp": "03:15:28", "text": "不，你不能这样对我。我的天啊。"}, {"type": "subtitle", "time": 11734.79, "timestamp": "03:15:34", "text": "你还好吗？等待。好的。你好。所以，嗯"}, {"type": "subtitle", "time": 11739.59, "timestamp": "03:15:39", "text": "在我整个生命历程中"}, {"type": "subtitle", "time": 11742.95, "timestamp": "03:15:42", "text": "呃，在流媒体职业生涯中，或者如果是这个的话"}, {"type": "subtitle", "time": 11746.469, "timestamp": "03:15:46", "text": "甚至想从事流媒体事业？我不知道，"}, {"type": "subtitle", "time": 11749.51, "timestamp": "03:15:49", "text": "男人。呃，"}, {"type": "subtitle", "time": 11753.269, "timestamp": "03:15:53", "text": "我们漏掉了好多东西，是吧？"}, {"type": "subtitle", "time": 11755.269, "timestamp": "03:15:55", "text": "哦，是的。嗯，"}, {"type": "subtitle", "time": 11757.429, "timestamp": "03:15:57", "text": "背景可以怎么处理？"}]
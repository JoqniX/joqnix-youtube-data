[{"type": "subtitle", "time": 6789.43, "timestamp": "01:53:09", "text": "我不能不用你吗？"}, {"type": "subtitle", "time": 6792.229, "timestamp": "01:53:12", "text": "我该如何杀人？"}, {"type": "subtitle", "time": 6803.99, "timestamp": "01:53:23", "text": "我该如何杀死Leo？"}, {"type": "subtitle", "time": 6815.189, "timestamp": "01:53:35", "text": "哦，等等。嗯？它没有显示这一点。"}, {"type": "subtitle", "time": 6818.31, "timestamp": "01:53:38", "text": "类似另一个显而易见的东西正在运行。"}, {"type": "subtitle", "time": 6820.95, "timestamp": "01:53:40", "text": "好的。"}, {"type": "subtitle", "time": 6826.87, "timestamp": "01:53:46", "text": "嗯，是的，总有一天我需要买下它"}, {"type": "subtitle", "time": 6830.39, "timestamp": "01:53:50", "text": "拿到这些许可证后，我终于可以……"}, {"type": "subtitle", "time": 6836.87, "timestamp": "01:53:56", "text": "它卡住了。我觉得是浏览器的问题。"}, {"type": "subtitle", "time": 6839.27, "timestamp": "01:53:59", "text": "来源以及太多的群体信息"}]
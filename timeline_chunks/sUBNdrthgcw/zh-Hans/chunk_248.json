[{"type": "subtitle", "time": 14883.03, "timestamp": "04:08:03", "text": "我们富有吗？看看它。我喜欢这样"}, {"type": "subtitle", "time": 14887.67, "timestamp": "04:08:07", "text": "它就像在座位旁旋转一样。保持静止"}, {"type": "subtitle", "time": 14890.229, "timestamp": "04:08:10", "text": "所有的魔法。这是一种安全措施"}, {"type": "subtitle", "time": 14892.309, "timestamp": "04:08:12", "text": "措施。体验了小偷的"}, {"type": "subtitle", "time": 14895.99, "timestamp": "04:08:15", "text": "之前的失败。你听说过吗？"}, {"type": "subtitle", "time": 14897.91, "timestamp": "04:08:17", "text": "这些是我们正在挖掘的较低层拱顶。"}, {"type": "subtitle", "time": 14900.389, "timestamp": "04:08:20", "text": "正在通过。我们到底要潜多深？"}, {"type": "subtitle", "time": 14902.79, "timestamp": "04:08:22", "text": "12号保险库很快投入使用。"}, {"type": "subtitle", "time": 14905.03, "timestamp": "04:08:25", "text": "Greenos 成立四年后"}, {"type": "subtitle", "time": 14907.83, "timestamp": "04:08:27", "text": "几个世纪前。他居住在最深处。"}, {"type": "subtitle", "time": 14910.469, "timestamp": "04:08:30", "text": "银行的一部分。请安顿下来。我们有"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "哇。"}, {"type": "subtitle", "time": 14928.309, "timestamp": "04:08:48", "text": "金库编号"}, {"type": "subtitle", "time": 14938.87, "timestamp": "04:08:58", "text": "正在路上。"}]
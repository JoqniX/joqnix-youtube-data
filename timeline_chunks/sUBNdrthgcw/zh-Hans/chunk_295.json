[{"type": "subtitle", "time": 17701.43, "timestamp": "04:55:01", "text": "霍格斯梅教授。霍格莫是唯一"}, {"type": "subtitle", "time": 17703.59, "timestamp": "04:55:03", "text": "英国所有的魔法村庄，并且是"}, {"type": "subtitle", "time": 17706.39, "timestamp": "04:55:06", "text": "这里聚集了各种各样的商店和酒吧。你"}, {"type": "subtitle", "time": 17708.23, "timestamp": "04:55:08", "text": "应该能找到学校的所有信息。"}, {"type": "subtitle", "time": 17711.35, "timestamp": "04:55:11", "text": "你在霍格斯梅需要的物品。你会"}, {"type": "subtitle", "time": 17713.99, "timestamp": "04:55:13", "text": "我想，你肯定也很喜欢喝黄油啤酒吧。"}, {"type": "subtitle", "time": 17717.27, "timestamp": "04:55:17", "text": "之后会和朋友们一起去。"}, {"type": "subtitle", "time": 17720.07, "timestamp": "04:55:20", "text": "好的。什么是黄油啤酒？"}, {"type": "subtitle", "time": 17722.07, "timestamp": "04:55:22", "text": "谢谢你，韦斯莱教授。很多"}, {"type": "subtitle", "time": 17724.868, "timestamp": "04:55:24", "text": "第一天就能吸收，而且你已经……"}, {"type": "subtitle", "time": 17727.91, "timestamp": "04:55:27", "text": "还有很多东西要学。佩珀里，你的教授们"}, {"type": "subtitle", "time": 17729.83, "timestamp": "04:55:29", "text": "已同意增设"}, {"type": "subtitle", "time": 17732.15, "timestamp": "04:55:32", "text": "课外作业。"}, {"type": "subtitle", "time": 17734.23, "timestamp": "04:55:34", "text": "你很快就能跟上进度。"}, {"type": "subtitle", "time": 17736.47, "timestamp": "04:55:36", "text": "从你对 Revelio 的熟练运用来看"}, {"type": "subtitle", "time": 17739.03, "timestamp": "04:55:39", "text": "之前我会说菲格教授成功了。"}, {"type": "subtitle", "time": 17741.59, "timestamp": "04:55:41", "text": "至少可以让你了解一些基本知识。他"}, {"type": "subtitle", "time": 17744.39, "timestamp": "04:55:44", "text": "教授，是的。他一直含糊其辞。"}, {"type": "subtitle", "time": 17746.868, "timestamp": "04:55:46", "text": "至于你抵达之前发生的事情，"}, {"type": "subtitle", "time": 17748.868, "timestamp": "04:55:48", "text": "具体来说，是关于之后发生的事情。"}, {"type": "subtitle", "time": 17752.07, "timestamp": "04:55:52", "text": "那场可怕的巨龙袭击。我的怀疑"}, {"type": "subtitle", "time": 17754.15, "timestamp": "04:55:54", "text": "故事远不止表面那么简单。"}, {"type": "subtitle", "time": 17756.07, "timestamp": "04:55:56", "text": "搜寻个人物品和延长"}]
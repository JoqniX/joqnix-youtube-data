[{"type": "subtitle", "time": 5284.95, "timestamp": "01:28:04", "text": "哦，这里有停顿帧，对吧？"}, {"type": "subtitle", "time": 5293.91, "timestamp": "01:28:13", "text": "呃，你没有具体说明。"}, {"type": "subtitle", "time": 5296.64, "timestamp": "01:28:16", "text": "我相信。"}, {"type": "subtitle", "time": 5298.39, "timestamp": "01:28:18", "text": "[笑声]"}, {"type": "subtitle", "time": 5300.47, "timestamp": "01:28:20", "text": "好的。你没有具体说明。好的。什么"}, {"type": "subtitle", "time": 5303.75, "timestamp": "01:28:23", "text": "有人说我怎么样？喜欢"}, {"type": "subtitle", "time": 5307.59, "timestamp": "01:28:27", "text": "米娅说了什么？呃"}, {"type": "subtitle", "time": 5317.03, "timestamp": "01:28:37", "text": "好的。尼昂。"}, {"type": "subtitle", "time": 5320.149, "timestamp": "01:28:40", "text": "这里有一个负离子吗？不。"}, {"type": "subtitle", "time": 5323.189, "timestamp": "01:28:43", "text": "我们得到了n"}, {"type": "subtitle", "time": 5326.55, "timestamp": "01:28:46", "text": "面包可以指任何内容。"}, {"type": "subtitle", "time": 5330.709, "timestamp": "01:28:50", "text": "你知道，这就是我为什么说要看聊天记录的原因。"}, {"type": "subtitle", "time": 5333.83, "timestamp": "01:28:53", "text": "很好。"}, {"type": "subtitle", "time": 5337.669, "timestamp": "01:28:57", "text": "查德洛克斯发型不错。"}]
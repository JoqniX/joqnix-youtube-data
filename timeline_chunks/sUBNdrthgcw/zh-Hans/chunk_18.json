[{"type": "subtitle", "time": 1084.549, "timestamp": "00:18:04", "text": "我知道这感觉很糟糕。我到此为止。"}, {"type": "subtitle", "time": 1087.99, "timestamp": "00:18:07", "text": "那样速度更快。"}, {"type": "subtitle", "time": 1089.99, "timestamp": "00:18:09", "text": "这太令人困惑了。我不知道什么"}, {"type": "subtitle", "time": 1091.99, "timestamp": "00:18:11", "text": "我的大脑发生了什么事。怎么了，"}, {"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "男人？"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "嗯，我把它设为九，我们把它设为……"}, {"type": "subtitle", "time": 1104.71, "timestamp": "00:18:24", "text": "去！去！去。灵敏度问题真是太严重了"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "今天，"}]
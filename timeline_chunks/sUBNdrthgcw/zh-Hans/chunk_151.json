[{"type": "subtitle", "time": 9061.83, "timestamp": "02:31:01", "text": "我也想到一个主意。是的。你好，Jade，呃"}, {"type": "subtitle", "time": 9064.309, "timestamp": "02:31:04", "text": "警察。欢迎。欢迎。"}, {"type": "subtitle", "time": 9066.71, "timestamp": "02:31:06", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 9069.429, "timestamp": "02:31:09", "text": "我的天啊。那可真是个大问题！你可能"}, {"type": "subtitle", "time": 9072.309, "timestamp": "02:31:12", "text": "谈论Q版人物"}, {"type": "subtitle", "time": 9077.67, "timestamp": "02:31:17", "text": "我的小小Q版形象。小时候的我。"}, {"type": "subtitle", "time": 9079.91, "timestamp": "02:31:19", "text": "是的。对，就是那个Q版人物。你过得怎么样？"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "好的。糟糕。是的。呃，欢迎来到"}, {"type": "subtitle", "time": 9091.59, "timestamp": "02:31:31", "text": "直播，Jade。所以，我们把所有人都加了进去"}, {"type": "subtitle", "time": 9093.99, "timestamp": "02:31:33", "text": "来到溪边的人"}, {"type": "subtitle", "time": 9096.71, "timestamp": "02:31:36", "text": "圣诞装饰品。所以我需要把你加进去。"}, {"type": "subtitle", "time": 9098.71, "timestamp": "02:31:38", "text": "也一样。"}, {"type": "subtitle", "time": 9103.349, "timestamp": "02:31:43", "text": "所以我们有了这些。所以，随便选一个吧"}, {"type": "subtitle", "time": 9106.309, "timestamp": "02:31:46", "text": "你喜欢的装饰品。所以我可以补充"}, {"type": "subtitle", "time": 9113.27, "timestamp": "02:31:53", "text": "呃，让我喝点水。"}, {"type": "chat", "time": 9113.816, "timestamp": "02:31:53", "author": "@Seeker0fsalvat1on", "avatar": "https://yt4.ggpht.com/g-8LS8zE-ucIiA8eoueYg8eT__TmdAWErhse_hHip8PYG5SEyrP_mq3pAU1FChyhx0b7oNMT3g=s64-c-k-c0x00ffffff-no-rj", "message": "morning joq"}, {"type": "subtitle", "time": 9115.75, "timestamp": "02:31:55", "text": "是啊，我感觉很不舒服。不会"}, {"type": "chat", "time": 9117.239, "timestamp": "02:31:57", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... Vicky , Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 9119.27, "timestamp": "02:31:59", "text": "说谎。我感觉非常不舒服。"}]
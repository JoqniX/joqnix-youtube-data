[{"type": "subtitle", "time": 19206.07, "timestamp": "05:20:06", "text": "不，不，集中注意力。开始了。我的天哪。"}, {"type": "subtitle", "time": 19208.94, "timestamp": "05:20:08", "text": "那是我的球。"}, {"type": "subtitle", "time": 19211.19, "timestamp": "05:20:11", "text": "[音乐]"}, {"type": "subtitle", "time": 19213.43, "timestamp": "05:20:13", "text": "等等，我可以重新开始吗？我可以重新开始吗？"}, {"type": "subtitle", "time": 19215.11, "timestamp": "05:20:15", "text": "你好。"}, {"type": "subtitle", "time": 19216.948, "timestamp": "05:20:16", "text": "我想用红色来做这件事。请。我想"}, {"type": "subtitle", "time": 19220.868, "timestamp": "05:20:20", "text": "重新启动。请。我，我，我求求你。我是"}, {"type": "subtitle", "time": 19224.59, "timestamp": "05:20:24", "text": "我可以关闭游戏吗？"}, {"type": "subtitle", "time": 19229.59, "timestamp": "05:20:29", "text": "等待。我可以把它关掉吗？我本应该"}, {"type": "subtitle", "time": 19248.07, "timestamp": "05:20:48", "text": "晚安。"}, {"type": "subtitle", "time": 19250.15, "timestamp": "05:20:50", "text": "H：好的，没问题。我不会作弊。好的，"}]
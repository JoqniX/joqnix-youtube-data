[{"type": "subtitle", "time": 13862.55, "timestamp": "03:51:02", "text": "据推测来自兰洛克。我无法打开"}, {"type": "subtitle", "time": 13865.189, "timestamp": "03:51:05", "text": "它。保护它的魔法是……"}, {"type": "subtitle", "time": 13868.15, "timestamp": "03:51:08", "text": "确实很强大。它看起来像个小妖精"}, {"type": "subtitle", "time": 13872.79, "timestamp": "03:51:12", "text": "金属。那个符号？那是什么光芒？"}, {"type": "subtitle", "time": 13875.59, "timestamp": "03:51:15", "text": "我没看到发光。"}, {"type": "subtitle", "time": 13890.469, "timestamp": "03:51:30", "text": "梅林的胡子。梅林的胡子长什么样？"}, {"type": "subtitle", "time": 13893.59, "timestamp": "03:51:33", "text": "我们做到了。"}, {"type": "subtitle", "time": 13896.15, "timestamp": "03:51:36", "text": "等等，什么？"}, {"type": "subtitle", "time": 13898.87, "timestamp": "03:51:38", "text": "他去世了。我的天哪。"}, {"type": "subtitle", "time": 13906.63, "timestamp": "03:51:46", "text": "不，不，别杀他。"}]
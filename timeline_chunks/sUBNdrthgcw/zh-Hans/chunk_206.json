[{"type": "subtitle", "time": 12360.55, "timestamp": "03:26:00", "text": "我们终于到达这里了。"}, {"type": "subtitle", "time": 12362.469, "timestamp": "03:26:02", "text": "等等，布拉德来了。是的。你好，布拉德。"}, {"type": "subtitle", "time": 12366.87, "timestamp": "03:26:06", "text": "你好吗？布拉德，你好吗？你好。和"}, {"type": "subtitle", "time": 12369.75, "timestamp": "03:26:09", "text": "米娅，你好吗？米娅，希望你"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "一切顺利。"}, {"type": "subtitle", "time": 12373.67, "timestamp": "03:26:13", "text": "然后是爱德华。是的。你好。希望"}, {"type": "subtitle", "time": 12375.99, "timestamp": "03:26:15", "text": "爱德华，你做得很好。等等，你们"}, {"type": "subtitle", "time": 12378.229, "timestamp": "03:26:18", "text": "能听到我说话吗？"}, {"type": "subtitle", "time": 12380.07, "timestamp": "03:26:20", "text": "是的。好的。一切都很好。"}, {"type": "subtitle", "time": 12382.15, "timestamp": "03:26:22", "text": "显而易见的一面。好的。所以我降低了"}, {"type": "subtitle", "time": 12385.51, "timestamp": "03:26:25", "text": "比特率只是希望，嗯，希望呃"}, {"type": "subtitle", "time": 12389.75, "timestamp": "03:26:29", "text": "不会出现卡顿。是的，"}, {"type": "subtitle", "time": 12391.19, "timestamp": "03:26:31", "text": "音频质量如何？我需要"}, {"type": "subtitle", "time": 12394.389, "timestamp": "03:26:34", "text": "查看。所以，呃，我做了，你可能也有。"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "我已阅读我的推文。我呃，我正在查看"}, {"type": "subtitle", "time": 12400.71, "timestamp": "03:26:40", "text": "游戏结束。我根本没玩过。做"}, {"type": "subtitle", "time": 12402.63, "timestamp": "03:26:42", "text": "别担心。我不是始作俑者，但我……"}, {"type": "subtitle", "time": 12405.269, "timestamp": "03:26:45", "text": "就像登录后获得我的豪华版一样"}, {"type": "subtitle", "time": 12407.51, "timestamp": "03:26:47", "text": "奖励之类的东西。我确实注册了Twitch账号。"}, {"type": "subtitle", "time": 12410.79, "timestamp": "03:26:50", "text": "也出现了下降。"}, {"type": "subtitle", "time": 12415.269, "timestamp": "03:26:55", "text": "所以，呃，我参加了粉丝俱乐部，哈里。"}, {"type": "subtitle", "time": 12418.07, "timestamp": "03:26:58", "text": "哈利·波特粉丝俱乐部账号"}]
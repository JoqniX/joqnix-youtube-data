[{"type": "subtitle", "time": 13745.429, "timestamp": "03:49:05", "text": "[音乐]"}, {"type": "subtitle", "time": 13747.189, "timestamp": "03:49:07", "text": "很高兴在你离开前拦住了你。"}, {"type": "subtitle", "time": 13749.189, "timestamp": "03:49:09", "text": "苏格兰。"}, {"type": "subtitle", "time": 13752.389, "timestamp": "03:49:12", "text": "勉强过关。"}, {"type": "subtitle", "time": 13756.389, "timestamp": "03:49:16", "text": "你的旅伴是谁？"}, {"type": "subtitle", "time": 13761.03, "timestamp": "03:49:21", "text": "一名新生。哦，新的。是的，先生。我是"}, {"type": "subtitle", "time": 13763.429, "timestamp": "03:49:23", "text": "以五年级学生的身份入学。"}, {"type": "subtitle", "time": 13766.55, "timestamp": "03:49:26", "text": "真是非同寻常。没有"}, {"type": "subtitle", "time": 13768.15, "timestamp": "03:49:28", "text": "学院里有人听说过这个人吗？"}, {"type": "subtitle", "time": 13771.189, "timestamp": "03:49:31", "text": "这么晚才被霍格沃茨录取。也不"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "我有。当然，作为另外五分之一。"}, {"type": "subtitle", "time": 13775.59, "timestamp": "03:49:35", "text": "多年来，他们一直在磨练自己的技艺。"}, {"type": "subtitle", "time": 13777.75, "timestamp": "03:49:37", "text": "四年来一直拥有魔法技能"}, {"type": "subtitle", "time": 13779.51, "timestamp": "03:49:39", "text": "校长问我能不能拿到我们的新……"}, {"type": "subtitle", "time": 13781.349, "timestamp": "03:49:41", "text": "学生在……之前稍微跟上了进度"}, {"type": "subtitle", "time": 13784.15, "timestamp": "03:49:44", "text": "学期开始。嗯，你不可能有"}, {"type": "subtitle", "time": 13787.03, "timestamp": "03:49:47", "text": "请求安排一位更好的导师。菲格教授"}, {"type": "subtitle", "time": 13789.75, "timestamp": "03:49:49", "text": "他不仅是一位杰出的老师，而且"}, {"type": "subtitle", "time": 13792.71, "timestamp": "03:49:52", "text": "同时，他也是一位极具直觉和天赋的人。"}, {"type": "subtitle", "time": 13796.71, "timestamp": "03:49:56", "text": "巫师。奥斯里先生喜欢奉承。"}, {"type": "subtitle", "time": 13798.469, "timestamp": "03:49:58", "text": "我敢说这是他……的原因之一。"}]
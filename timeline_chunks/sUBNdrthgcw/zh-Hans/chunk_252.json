[{"type": "subtitle", "time": 15126.63, "timestamp": "04:12:06", "text": "嗯，这算是个好的开始。但还有这一点。"}, {"type": "subtitle", "time": 15129.51, "timestamp": "04:12:09", "text": "又是一个符号。我想你不会看到"}, {"type": "subtitle", "time": 15132.309, "timestamp": "04:12:12", "text": "教授，我就是这么做的。那个符号有"}, {"type": "subtitle", "time": 15133.99, "timestamp": "04:12:13", "text": "和我之前看到的一样的光芒"}, {"type": "subtitle", "time": 15136.55, "timestamp": "04:12:16", "text": "端口密钥容器。如果你能看到"}, {"type": "subtitle", "time": 15139.59, "timestamp": "04:12:19", "text": "揭示前进的方向，我敢说我们"}, {"type": "subtitle", "time": 15141.75, "timestamp": "04:12:21", "text": "即将发现这个秘密"}, {"type": "subtitle", "time": 15144.55, "timestamp": "04:12:24", "text": "金库。带路。"}, {"type": "subtitle", "time": 15152.63, "timestamp": "04:12:32", "text": "发光体。"}, {"type": "subtitle", "time": 15155.83, "timestamp": "04:12:35", "text": "诺莫斯。这不是普通的保险库。我"}, {"type": "subtitle", "time": 15157.67, "timestamp": "04:12:37", "text": "估计我们得靠自己的努力才能脱身。"}, {"type": "subtitle", "time": 15159.75, "timestamp": "04:12:39", "text": "这里。你说的“靠实力说话”是什么意思？"}, {"type": "subtitle", "time": 15162.229, "timestamp": "04:12:42", "text": "出去？你认为这是某种……"}, {"type": "subtitle", "time": 15163.91, "timestamp": "04:12:43", "text": "测试？"}, {"type": "subtitle", "time": 15167.99, "timestamp": "04:12:47", "text": "我愿意。但这一切又有什么意义呢？我无法战斗。"}, {"type": "subtitle", "time": 15170.309, "timestamp": "04:12:50", "text": "我们走吧。保持距离。不会有"}, {"type": "subtitle", "time": 15173.03, "timestamp": "04:12:53", "text": "如果事情进展不顺利，就会消失。不是"}, {"type": "subtitle", "time": 15175.72, "timestamp": "04:12:55", "text": "出自格林科特。"}]
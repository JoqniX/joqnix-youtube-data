[{"type": "subtitle", "time": 19441.03, "timestamp": "05:24:01", "text": "就在我大四之前。我的母亲"}, {"type": "subtitle", "time": 19442.948, "timestamp": "05:24:02", "text": "收到一份教授占卜术的邀请。"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "这里。不知不觉中，我们已经离开了。"}, {"type": "subtitle", "time": 19448.15, "timestamp": "05:24:08", "text": "乌干达，我们当时远在世界的另一端。"}, {"type": "subtitle", "time": 19455.11, "timestamp": "05:24:15", "text": "哇。"}, {"type": "subtitle", "time": 19458.15, "timestamp": "05:24:18", "text": "它比霍格沃茨大多少？"}, {"type": "subtitle", "time": 19460.788, "timestamp": "05:24:20", "text": "瓦加杜魔法学校是最大的"}, {"type": "subtitle", "time": 19462.788, "timestamp": "05:24:22", "text": "魔法学校。"}, {"type": "subtitle", "time": 19464.788, "timestamp": "05:24:24", "text": "你是什​​么意思？不过我赢了。大"}, {"type": "subtitle", "time": 19467.11, "timestamp": "05:24:27", "text": "比霍格沃茨还不如，但它似乎从未如此。"}, {"type": "subtitle", "time": 19469.91, "timestamp": "05:24:29", "text": "对我来说，这令人畏惧或难以承受。它"}, {"type": "subtitle", "time": 19472.39, "timestamp": "05:24:32", "text": "一直都感觉像家一样。"}, {"type": "subtitle", "time": 19475.51, "timestamp": "05:24:35", "text": "那是什么？城堡的含义是什么？"}, {"type": "subtitle", "time": 19478.07, "timestamp": "05:24:38", "text": "像霍格沃茨那样？它的地址是山"}, {"type": "subtitle", "time": 19480.948, "timestamp": "05:24:40", "text": "月亮。与其说是城堡，不如说是城堡。"}, {"type": "subtitle", "time": 19483.59, "timestamp": "05:24:43", "text": "如同从……中雕刻出的美丽建筑"}]
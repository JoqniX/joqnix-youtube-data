[{"type": "subtitle", "time": 12781.99, "timestamp": "03:33:01", "text": "斯内普。不，不，不。那个斯内普。哦，"}, {"type": "subtitle", "time": 12783.75, "timestamp": "03:33:03", "text": "这个。"}, {"type": "subtitle", "time": 12786.229, "timestamp": "03:33:06", "text": "不，"}, {"type": "subtitle", "time": 12793.67, "timestamp": "03:33:13", "text": "为什么他看起来像那个人？"}, {"type": "subtitle", "time": 12808.71, "timestamp": "03:33:28", "text": "我觉得我直播了。哦耶，我正在直播。"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "好的，我想我……我想我正在直播。"}, {"type": "subtitle", "time": 12814.95, "timestamp": "03:33:34", "text": "好的。我的天啊。我们走吧。"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "我的天哪。真是太麻烦了。"}, {"type": "subtitle", "time": 12821.59, "timestamp": "03:33:41", "text": "如果你正在……就会发生这种情况"}, {"type": "subtitle", "time": 12824.79, "timestamp": "03:33:44", "text": "暂时闭嘴。"}, {"type": "subtitle", "time": 12826.63, "timestamp": "03:33:46", "text": "我的天啊。所以我还没有发布"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "游戏。好的。这就是它要去的地方"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "走下坡路。"}, {"type": "subtitle", "time": 12834.63, "timestamp": "03:33:54", "text": "激烈的游戏"}, {"type": "subtitle", "time": 12837.67, "timestamp": "03:33:57", "text": "疼痛。所以"}]
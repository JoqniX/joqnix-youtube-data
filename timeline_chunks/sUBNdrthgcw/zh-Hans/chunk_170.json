[{"type": "subtitle", "time": 10201.59, "timestamp": "02:50:01", "text": "如果它摆动起来，那就是"}, {"type": "subtitle", "time": 10207.59, "timestamp": "02:50:07", "text": "完美。嗯，就像我刚才说的，用 OBS。"}, {"type": "subtitle", "time": 10211.349, "timestamp": "02:50:11", "text": "还有其他一些东西。我们把它弄脏了，但是"}, {"type": "subtitle", "time": 10213.67, "timestamp": "02:50:13", "text": "现在我们能够做到了。但我当时"}, {"type": "subtitle", "time": 10217.67, "timestamp": "02:50:17", "text": "现在开始考虑未来的事情。你"}, {"type": "subtitle", "time": 10220.71, "timestamp": "02:50:20", "text": "目前我们只有21个人。"}, {"type": "subtitle", "time": 10223.349, "timestamp": "02:50:23", "text": "这棵树。但我不知道有多少"}, {"type": "subtitle", "time": 10226.15, "timestamp": "02:50:26", "text": "人们会在那里待上一年。"}, {"type": "subtitle", "time": 10228.79, "timestamp": "02:50:28", "text": "圣诞节。想象一下，如果它不止于此的话"}, {"type": "subtitle", "time": 10232.95, "timestamp": "02:50:32", "text": "21. 我该如何摆放它们？有这么多"}, {"type": "subtitle", "time": 10235.91, "timestamp": "02:50:35", "text": "诸如此类的问题还有很多。所以"}, {"type": "subtitle", "time": 10238.87, "timestamp": "02:50:38", "text": "我当时想的是，呃，而不是"}, {"type": "subtitle", "time": 10242.15, "timestamp": "02:50:42", "text": "在 OBS 中手动执行此操作"}, {"type": "subtitle", "time": 10245.429, "timestamp": "02:50:45", "text": "就像我们今年和去年所做的那样"}, {"type": "subtitle", "time": 10249.67, "timestamp": "02:50:49", "text": "呃，从明年开始，呃，是的，2024年"}, {"type": "subtitle", "time": 10252.07, "timestamp": "02:50:52", "text": "我想到圣诞节的时候我应该就能收到了"}, {"type": "subtitle", "time": 10254.309, "timestamp": "02:50:54", "text": "网站相关的一切都是真的。"}, {"type": "subtitle", "time": 10255.83, "timestamp": "02:50:55", "text": "完成的。"}, {"type": "subtitle", "time": 10258.79, "timestamp": "02:50:58", "text": "我希望我不得不这么做。"}]
[{"type": "subtitle", "time": 4627.91, "timestamp": "01:17:07", "text": "我懂马来语，而且"}, {"type": "subtitle", "time": 4630.63, "timestamp": "01:17:10", "text": "略懂泰米尔语。不太了解。"}, {"type": "subtitle", "time": 4632.31, "timestamp": "01:17:12", "text": "尽管。"}, {"type": "subtitle", "time": 4636.63, "timestamp": "01:17:16", "text": "或者说不太擅长，但我两方面都不行。"}, {"type": "subtitle", "time": 4643.11, "timestamp": "01:17:23", "text": "希望你一切都好。我没有"}, {"type": "subtitle", "time": 4645.11, "timestamp": "01:17:25", "text": "做得太大了。"}, {"type": "subtitle", "time": 4649.03, "timestamp": "01:17:29", "text": "另外，还要检查一下儿子。呃，任选其一"}, {"type": "subtitle", "time": 4651.59, "timestamp": "01:17:31", "text": "装饰品。你想要哪个号码？是"}, {"type": "subtitle", "time": 4653.43, "timestamp": "01:17:33", "text": "把所有路过的人都……"}, {"type": "subtitle", "time": 4656.31, "timestamp": "01:17:36", "text": "流向圣诞树。是的，"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "选择任何一个，嗯，是的，选择任何一个"}, {"type": "subtitle", "time": 4662.79, "timestamp": "01:17:42", "text": "嗯"}, {"type": "subtitle", "time": 4665.27, "timestamp": "01:17:45", "text": "你想要的颜色。"}, {"type": "subtitle", "time": 4669.669, "timestamp": "01:17:49", "text": "所以，我们会把你加到圣诞树上。"}, {"type": "subtitle", "time": 4673.11, "timestamp": "01:17:53", "text": "就是这个。我们会把所有人都加到这里。"}]
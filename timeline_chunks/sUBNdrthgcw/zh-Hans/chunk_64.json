[{"type": "subtitle", "time": 3841.27, "timestamp": "01:04:01", "text": "我可以稍微修剪一下。哦，我的"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "我觉得七个挺好的。"}, {"type": "subtitle", "time": 3852.47, "timestamp": "01:04:12", "text": "是的。是的。"}, {"type": "subtitle", "time": 3856.549, "timestamp": "01:04:16", "text": "我的天哪，这真是太棒了！"}, {"type": "subtitle", "time": 3858.63, "timestamp": "01:04:18", "text": "是的。是的。好的。忍者的事情已经完成了，我"}, {"type": "subtitle", "time": 3863.109, "timestamp": "01:04:23", "text": "猜测。呃，那是忍者。"}, {"type": "subtitle", "time": 3866.47, "timestamp": "01:04:26", "text": "呃，下一个是谁？好的。下一个是谁？呃，还有"}, {"type": "subtitle", "time": 3869.349, "timestamp": "01:04:29", "text": "然后看看。"}, {"type": "subtitle", "time": 3872.39, "timestamp": "01:04:32", "text": "哦，愿"}, {"type": "subtitle", "time": 3874.23, "timestamp": "01:04:34", "text": "这位神明的不和谐音消失了。好了，就是这样。"}, {"type": "subtitle", "time": 3876.23, "timestamp": "01:04:36", "text": "你是。"}, {"type": "subtitle", "time": 3878.789, "timestamp": "01:04:38", "text": "呃，等等，等等，我们没做魔鬼的事"}, {"type": "subtitle", "time": 3887.029, "timestamp": "01:04:47", "text": "300乘300。"}, {"type": "subtitle", "time": 3890.309, "timestamp": "01:04:50", "text": "现在，我们可以右键单击，复制。"}, {"type": "subtitle", "time": 3893.109, "timestamp": "01:04:53", "text": "筛选后粘贴到这里。"}, {"type": "subtitle", "time": 3896.39, "timestamp": "01:04:56", "text": "你看，他变得圆滚滚的，八字形的，对吧？"}, {"type": "subtitle", "time": 3899.829, "timestamp": "01:04:59", "text": "八号将是红色"}]
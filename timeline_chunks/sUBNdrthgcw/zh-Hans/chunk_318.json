[{"type": "subtitle", "time": 19081.03, "timestamp": "05:18:01", "text": "我的天哪，他"}, {"type": "subtitle", "time": 19087.27, "timestamp": "05:18:07", "text": "一个弹出式障碍物。所以，我们为什么不呢？"}, {"type": "subtitle", "time": 19097.11, "timestamp": "05:18:17", "text": "[音乐]"}, {"type": "subtitle", "time": 19099.19, "timestamp": "05:18:19", "text": "什么在切菜？"}, {"type": "subtitle", "time": 19105.11, "timestamp": "05:18:25", "text": "一件饰品。将目标拉近。"}, {"type": "subtitle", "time": 19108.47, "timestamp": "05:18:28", "text": "投掷。点击分配键进行施法"}, {"type": "subtitle", "time": 19110.07, "timestamp": "05:18:30", "text": "并将目标拉近。点击键"}, {"type": "subtitle", "time": 19113.35, "timestamp": "05:18:33", "text": "再次把弹珠扔出去。你"}, {"type": "subtitle", "time": 19116.47, "timestamp": "05:18:36", "text": "正在召唤他们。"}, {"type": "subtitle", "time": 19131.67, "timestamp": "05:18:51", "text": "你敢摔倒试试！我的天啊。"}, {"type": "subtitle", "time": 19134.39, "timestamp": "05:18:54", "text": "非常好。指向雷文罗。"}, {"type": "subtitle", "time": 19135.99, "timestamp": "05:18:55", "text": "但这里肯定没有体育运动"}, {"type": "subtitle", "time": 19137.43, "timestamp": "05:18:57", "text": "没有一些朋友一起玩"}]
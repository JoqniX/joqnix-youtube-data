[{"type": "subtitle", "time": 19321.83, "timestamp": "05:22:01", "text": "不，不，不，不，不。"}, {"type": "subtitle", "time": 19326.39, "timestamp": "05:22:06", "text": "我的天啊。圣哉圣哉。"}, {"type": "subtitle", "time": 19331.19, "timestamp": "05:22:11", "text": "我的天哪。哦不，你不会的。我 我 我"}, {"type": "subtitle", "time": 19333.83, "timestamp": "05:22:13", "text": "我向上帝发誓，千万别反抗"}, {"type": "subtitle", "time": 19336.82, "timestamp": "05:22:16", "text": "矿。我的天哪"}, {"type": "subtitle", "time": 19338.39, "timestamp": "05:22:18", "text": "[音乐]"}, {"type": "subtitle", "time": 19348.23, "timestamp": "05:22:28", "text": "是的。把她拉下来。做得好。"}, {"type": "subtitle", "time": 19370.07, "timestamp": "05:22:50", "text": "我确实告诉过你们我会赢。一个"}, {"type": "subtitle", "time": 19373.83, "timestamp": "05:22:53", "text": "满分。卓越。"}]
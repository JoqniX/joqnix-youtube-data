[{"type": "subtitle", "time": 19021.11, "timestamp": "05:17:01", "text": "基本功扎实，而且非常出色。"}, {"type": "subtitle", "time": 19023.59, "timestamp": "05:17:03", "text": "天气真好，我在想我们或许"}, {"type": "subtitle", "time": 19025.91, "timestamp": "05:17:05", "text": "我们来一次短途旅行吧"}, {"type": "subtitle", "time": 19029.67, "timestamp": "05:17:09", "text": "出去透透气。好的，"}, {"type": "subtitle", "time": 19032.55, "timestamp": "05:17:12", "text": "我之后。我们要去野外考察吗？"}, {"type": "subtitle", "time": 19037.03, "timestamp": "05:17:17", "text": "某物？出城。"}, {"type": "subtitle", "time": 19039.75, "timestamp": "05:17:19", "text": "哦，"}, {"type": "subtitle", "time": 19042.23, "timestamp": "05:17:22", "text": "太多个我了。哦，等等。我想知道。哦，"}, {"type": "subtitle", "time": 19044.55, "timestamp": "05:17:24", "text": "等待。许多咒语都是咒语。许多任务"}, {"type": "subtitle", "time": 19056.628, "timestamp": "05:17:36", "text": "哦，它在外面。"}, {"type": "subtitle", "time": 19059.03, "timestamp": "05:17:39", "text": "我一直觉得乐趣是相辅相成的。"}, {"type": "subtitle", "time": 19061.03, "timestamp": "05:17:41", "text": "手艺精湛，我相信"}, {"type": "subtitle", "time": 19062.55, "timestamp": "05:17:42", "text": "我们当中的魁地奇球员会"}, {"type": "subtitle", "time": 19065.19, "timestamp": "05:17:45", "text": "同意。"}, {"type": "subtitle", "time": 19069.03, "timestamp": "05:17:49", "text": "所以，还有什么比运动更好的呢？"}, {"type": "subtitle", "time": 19072.31, "timestamp": "05:17:52", "text": "是我眼花了吗，还是他的眼睛？"}]
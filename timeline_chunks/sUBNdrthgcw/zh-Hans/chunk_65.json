[{"type": "subtitle", "time": 3901.589, "timestamp": "01:05:01", "text": "第八名。出来。出来"}, {"type": "subtitle", "time": 3904.87, "timestamp": "01:05:04", "text": "无论你在哪里。"}, {"type": "subtitle", "time": 3907.99, "timestamp": "01:05:07", "text": "好了。我们也需要同样的条件。"}, {"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "位置高度。正确的。所以我们能做什么？"}, {"type": "subtitle", "time": 3911.67, "timestamp": "01:05:11", "text": "做是"}, {"type": "subtitle", "time": 3914.309, "timestamp": "01:05:14", "text": "变换格式，复制、变换并粘贴。"}, {"type": "subtitle", "time": 3919.109, "timestamp": "01:05:19", "text": "控制换挡 V。是一样的。"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "问题是，我是否增加了"}, {"type": "subtitle", "time": 3941.43, "timestamp": "01:05:41", "text": "我想我做到了。是的，我算是这么做了。嗯。"}, {"type": "subtitle", "time": 3947.51, "timestamp": "01:05:47", "text": "晚安，祝你睡个好觉。你好。你好。你好。呃，"}, {"type": "subtitle", "time": 3949.829, "timestamp": "01:05:49", "text": "睡觉。睡觉。没关系。"}, {"type": "subtitle", "time": 3953.109, "timestamp": "01:05:53", "text": "呃，你总能看到我发的帖子。"}, {"type": "subtitle", "time": 3956.95, "timestamp": "01:05:56", "text": "成品。不用担心。"}]
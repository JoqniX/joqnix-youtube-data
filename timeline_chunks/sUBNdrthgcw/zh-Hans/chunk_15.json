[{"type": "subtitle", "time": 901.99, "timestamp": "00:15:01", "text": "还有那件事，以及那个鬼魂。就是这样。后"}, {"type": "subtitle", "time": 903.99, "timestamp": "00:15:03", "text": "好了，我不再玩《Valerant》了。不去"}, {"type": "subtitle", "time": 906.47, "timestamp": "00:15:06", "text": "买任何东西。"}, {"type": "subtitle", "time": 909.829, "timestamp": "00:15:09", "text": "但现在我用那个的时候……"}, {"type": "subtitle", "time": 913.43, "timestamp": "00:15:13", "text": "现在我感觉自己有点像个破坏者"}, {"type": "subtitle", "time": 916.389, "timestamp": "00:15:16", "text": "厌倦了或者其他什么原因"}, {"type": "subtitle", "time": 919.03, "timestamp": "00:15:19", "text": "就像我现在这样做的时候，我不知道我"}, {"type": "subtitle", "time": 922.55, "timestamp": "00:15:22", "text": "厌倦了。有人想要吗？好的"}, {"type": "subtitle", "time": 924.629, "timestamp": "00:15:24", "text": "他们把人皮留给了我。谢谢"}, {"type": "subtitle", "time": 931.35, "timestamp": "00:15:31", "text": "并不厌倦。我比较喜欢……"}, {"type": "subtitle", "time": 934.15, "timestamp": "00:15:34", "text": "基本款班特尔。我不知道为什么。什么"}, {"type": "subtitle", "time": 938.15, "timestamp": "00:15:38", "text": "我在欧服玩游戏的时候也遇到过这种情况。"}]
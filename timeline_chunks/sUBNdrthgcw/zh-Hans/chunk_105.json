[{"type": "subtitle", "time": 6325.35, "timestamp": "01:45:25", "text": "就我而言，因为她的情况有点……"}, {"type": "subtitle", "time": 6327.75, "timestamp": "01:45:27", "text": "圆润的。我们稍作调整。"}, {"type": "subtitle", "time": 6329.669, "timestamp": "01:45:29", "text": "一点。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "我们这样调整一下。是的。"}, {"type": "subtitle", "time": 6336.15, "timestamp": "01:45:36", "text": "好的。好的。"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "还有这个人，就是这个人。"}]
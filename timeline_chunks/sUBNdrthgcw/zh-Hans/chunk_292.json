[{"type": "subtitle", "time": 17523.03, "timestamp": "04:52:03", "text": "这是什么？啊，真是好时机。完美的"}, {"type": "subtitle", "time": 17525.11, "timestamp": "04:52:05", "text": "有机会向您展示如何使用蓝色"}, {"type": "subtitle", "time": 17528.07, "timestamp": "04:52:08", "text": "利用火焰更快地移动。你的"}, {"type": "subtitle", "time": 17529.83, "timestamp": "04:52:09", "text": "野外指南包含一张地图"}, {"type": "subtitle", "time": 17532.628, "timestamp": "04:52:12", "text": "城堡。打开它，找到中心位置。"}, {"type": "subtitle", "time": 17535.03, "timestamp": "04:52:15", "text": "大厅。"}, {"type": "subtitle", "time": 17542.788, "timestamp": "04:52:22", "text": "霍格沃茨分为两个主要区域。"}, {"type": "subtitle", "time": 17544.23, "timestamp": "04:52:24", "text": "事情的左侧是……"}, {"type": "subtitle", "time": 17546.07, "timestamp": "04:52:26", "text": "学生和教授们住在一起。它"}, {"type": "subtitle", "time": 17548.15, "timestamp": "04:52:28", "text": "包括房屋"}, {"type": "subtitle", "time": 17551.11, "timestamp": "04:52:31", "text": "公共休息室和大厅。好的。"}, {"type": "subtitle", "time": 17553.51, "timestamp": "04:52:33", "text": "所以，宏伟的楼梯将继续向前延伸。"}, {"type": "subtitle", "time": 17555.27, "timestamp": "04:52:35", "text": "这个。"}, {"type": "subtitle", "time": 17556.788, "timestamp": "04:52:36", "text": "在那里你可以看到流动的火焰。"}, {"type": "subtitle", "time": 17559.35, "timestamp": "04:52:39", "text": "该地区有售。绿流"}, {"type": "subtitle", "time": 17560.708, "timestamp": "04:52:40", "text": "飞机代表你发现"}, {"type": "subtitle", "time": 17562.31, "timestamp": "04:52:42", "text": "包括您自己的房屋和公共区域"}, {"type": "subtitle", "time": 17564.47, "timestamp": "04:52:44", "text": "房间。"}, {"type": "subtitle", "time": 17566.55, "timestamp": "04:52:46", "text": "揭示，呃，揭示位置"}, {"type": "subtitle", "time": 17574.868, "timestamp": "04:52:54", "text": "接下来要去图书馆继续。"}, {"type": "subtitle", "time": 17578.628, "timestamp": "04:52:58", "text": "让我们为你开启火焰的中心。"}]
[{"type": "subtitle", "time": 16100.38, "timestamp": "04:28:20", "text": "哇。"}, {"type": "subtitle", "time": 16103.03, "timestamp": "04:28:23", "text": "[音乐]"}, {"type": "subtitle", "time": 16104.63, "timestamp": "04:28:24", "text": "向下。"}, {"type": "subtitle", "time": 16106.55, "timestamp": "04:28:26", "text": "好的。我们没有错过排序。"}, {"type": "subtitle", "time": 16109.03, "timestamp": "04:28:29", "text": "仪式。"}, {"type": "subtitle", "time": 16113.349, "timestamp": "04:28:33", "text": "我不是专家，但这似乎更……"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "合适的。"}, {"type": "subtitle", "time": 16117.75, "timestamp": "04:28:37", "text": "现在，我需要尽快研究一下这个小盒坠。"}, {"type": "subtitle", "time": 16119.59, "timestamp": "04:28:39", "text": "我能做到，但首先我必须联系……"}, {"type": "subtitle", "time": 16121.59, "timestamp": "04:28:41", "text": "部。他们需要知道什么"}, {"type": "subtitle", "time": 16123.03, "timestamp": "04:28:43", "text": "乔治遭遇了这样的事，应该引以为戒。"}, {"type": "subtitle", "time": 16125.83, "timestamp": "04:28:45", "text": "兰德罗克。目前，我请求您"}, {"type": "subtitle", "time": 16127.75, "timestamp": "04:28:47", "text": "把今晚发生的一切都记下来"}, {"type": "subtitle", "time": 16130.79, "timestamp": "04:28:50", "text": "你我之间。当然可以，先生。"}, {"type": "subtitle", "time": 16132.95, "timestamp": "04:28:52", "text": "谢谢。"}]
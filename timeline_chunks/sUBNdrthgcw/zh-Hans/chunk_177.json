[{"type": "subtitle", "time": 10620.55, "timestamp": "02:57:00", "text": "决定如何装饰"}, {"type": "subtitle", "time": 10622.469, "timestamp": "02:57:02", "text": "为了"}, {"type": "subtitle", "time": 10627.19, "timestamp": "02:57:07", "text": "会是什么样的大圣诞树呢？我的天啊。"}, {"type": "subtitle", "time": 10630.23, "timestamp": "02:57:10", "text": "我希望你像这样记下来。"}, {"type": "subtitle", "time": 10632.71, "timestamp": "02:57:12", "text": "想法。不，不，别记下来。但"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "你觉得这有可能吗？"}, {"type": "subtitle", "time": 10640.95, "timestamp": "02:57:20", "text": "在网站上制作？但我认为"}, {"type": "subtitle", "time": 10649.11, "timestamp": "02:57:29", "text": "呃，它需要很多……"}, {"type": "subtitle", "time": 10652.07, "timestamp": "02:57:32", "text": "编码和服务器和"}, {"type": "subtitle", "time": 10655.99, "timestamp": "02:57:35", "text": "好多呃……东西。我不认为你呃"}, {"type": "subtitle", "time": 10659.19, "timestamp": "02:57:39", "text": "这里没有白色。所以，你"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "看到我身后的圣诞树了吗？"}, {"type": "subtitle", "time": 10665.429, "timestamp": "02:57:45", "text": "所以我当时考虑的是明年，而不是……"}, {"type": "subtitle", "time": 10667.99, "timestamp": "02:57:47", "text": "手动从 OBS 中操作并放入"}, {"type": "subtitle", "time": 10671.03, "timestamp": "02:57:51", "text": "头像，还有手动操作。"}, {"type": "subtitle", "time": 10674.07, "timestamp": "02:57:54", "text": "我当时想的是手动操作。"}, {"type": "subtitle", "time": 10677.67, "timestamp": "02:57:57", "text": "网站上的一个可交互的小玩意儿。"}]
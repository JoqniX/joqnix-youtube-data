[{"type": "subtitle", "time": 15197.189, "timestamp": "04:13:17", "text": "我看到前面有什么东西。那是什么？"}, {"type": "subtitle", "time": 15208.309, "timestamp": "04:13:28", "text": "这样行不行？"}, {"type": "subtitle", "time": 15210.95, "timestamp": "04:13:30", "text": "享受魔法带来的乐趣。"}, {"type": "subtitle", "time": 15214.229, "timestamp": "04:13:34", "text": "Lumos，发生什么事了？"}, {"type": "subtitle", "time": 15216.389, "timestamp": "04:13:36", "text": "当我朝着那道光走去时，它"}, {"type": "subtitle", "time": 15218.07, "timestamp": "04:13:38", "text": "突然间，地面似乎……"}, {"type": "subtitle", "time": 15221.75, "timestamp": "04:13:41", "text": "旋转着。你还好吗？是的，"}, {"type": "subtitle", "time": 15224.07, "timestamp": "04:13:44", "text": "先生。我很好。"}, {"type": "subtitle", "time": 15226.149, "timestamp": "04:13:46", "text": "你似乎把地板弄坏了"}, {"type": "subtitle", "time": 15227.99, "timestamp": "04:13:47", "text": "改变。"}, {"type": "subtitle", "time": 15229.67, "timestamp": "04:13:49", "text": "雕像。"}, {"type": "subtitle", "time": 15232.229, "timestamp": "04:13:52", "text": "什么雕像？"}, {"type": "subtitle", "time": 15234.87, "timestamp": "04:13:54", "text": "我看到某种雕像，但只是作为一种……"}, {"type": "subtitle", "time": 15238.389, "timestamp": "04:13:58", "text": "地板上的倒影。"}, {"type": "subtitle", "time": 15239.91, "timestamp": "04:13:59", "text": "劳蕾莉亚，"}]
[{"type": "subtitle", "time": 18901.51, "timestamp": "05:15:01", "text": "请翻开课本至第517页。"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "在我们开始之前，请问这里有人能告诉我……"}, {"type": "subtitle", "time": 18907.11, "timestamp": "05:15:07", "text": "咒语之间的区别"}, {"type": "subtitle", "time": 18911.59, "timestamp": "05:15:11", "text": "变色和成长护符？"}, {"type": "subtitle", "time": 18923.43, "timestamp": "05:15:23", "text": "恐怕现在学习已经太晚了。"}, {"type": "subtitle", "time": 18925.83, "timestamp": "05:15:25", "text": "几个月的布道对我造成了很大的影响"}, {"type": "subtitle", "time": 18928.628, "timestamp": "05:15:28", "text": "你们所有人。看起来，你们都"}, {"type": "subtitle", "time": 18931.03, "timestamp": "05:15:31", "text": "你假期都在练习遗忘咒"}, {"type": "subtitle", "time": 18933.91, "timestamp": "05:15:33", "text": "彼此之间。"}, {"type": "subtitle", "time": 18936.788, "timestamp": "05:15:36", "text": "感谢主。你还记得吗？"}, {"type": "subtitle", "time": 18946.788, "timestamp": "05:15:46", "text": "看来我们确实急需帮助。"}, {"type": "subtitle", "time": 18949.75, "timestamp": "05:15:49", "text": "审查。大家两人一组，"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "分别站在对立的两侧"}, {"type": "subtitle", "time": 18953.19, "timestamp": "05:15:53", "text": "课堂。"}, {"type": "subtitle", "time": 18955.59, "timestamp": "05:15:55", "text": "现在，让我们来利用这些教科书吧。"}, {"type": "subtitle", "time": 18957.59, "timestamp": "05:15:57", "text": "你如此相信的钝器"}]
[{"type": "subtitle", "time": 9962.309, "timestamp": "02:46:02", "text": "我的天啊。"}, {"type": "subtitle", "time": 9976.71, "timestamp": "02:46:16", "text": "我拿了三个呃……东西。如果你想"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "截屏，随意截屏"}, {"type": "subtitle", "time": 9981.67, "timestamp": "02:46:21", "text": "截图。好的。"}, {"type": "subtitle", "time": 9985.67, "timestamp": "02:46:25", "text": "我希望它看起来不错，一切都好。"}, {"type": "subtitle", "time": 9989.51, "timestamp": "02:46:29", "text": "在这个房间里。我觉得没有这种感觉。"}, {"type": "subtitle", "time": 9994.389, "timestamp": "02:46:34", "text": "呃，"}, {"type": "subtitle", "time": 10000.71, "timestamp": "02:46:40", "text": "我希望它不会让人感觉不对劲，不过，是的。"}, {"type": "subtitle", "time": 10009.91, "timestamp": "02:46:49", "text": "感觉不对劲吗？不。对。我觉得是这样。"}, {"type": "subtitle", "time": 10014.309, "timestamp": "02:46:54", "text": "它正好能放进那个房间。"}, {"type": "subtitle", "time": 10019.11, "timestamp": "02:46:59", "text": "你好。所以，再次高兴"}]
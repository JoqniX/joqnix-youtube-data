[{"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "现在它告诉我了。现在，我想我"}, {"type": "subtitle", "time": 2172.71, "timestamp": "00:36:12", "text": "应该多直播几场《Valerant》"}, {"type": "subtitle", "time": 2177.19, "timestamp": "00:36:17", "text": "回去后我需要时间适应一切。"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "自从我换工作的那天起"}, {"type": "subtitle", "time": 2185.51, "timestamp": "00:36:25", "text": "自从我换了它之后，"}, {"type": "subtitle", "time": 2188.63, "timestamp": "00:36:28", "text": "这很痛苦。"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "但你知道吗？没关系。"}, {"type": "subtitle", "time": 2196.63, "timestamp": "00:36:36", "text": "说到好的。嗯，呃，"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "等待。为什么又卡住了？"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "我需要找到更好的方法来做这件事。"}]
[{"type": "subtitle", "time": 17220.708, "timestamp": "04:47:00", "text": "[音乐]"}, {"type": "subtitle", "time": 17222.868, "timestamp": "04:47:02", "text": "这是我从Twitch上得到的玻璃杯吗？"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "滴？让我再确认一下。"}, {"type": "subtitle", "time": 17229.67, "timestamp": "04:47:09", "text": "我觉得我长得挺好看的"}, {"type": "subtitle", "time": 17232.15, "timestamp": "04:47:12", "text": "眼镜"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "他后来加入了迪奥。他后来才加入。"}, {"type": "subtitle", "time": 17244.708, "timestamp": "04:47:24", "text": "晚的"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "我不知道发生了什么事"}, {"type": "subtitle", "time": 17251.35, "timestamp": "04:47:31", "text": "这个地方。龙眼眼镜和"}, {"type": "subtitle", "time": 17253.19, "timestamp": "04:47:33", "text": "哈蒂娜"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "淡紫色照明围巾"}, {"type": "subtitle", "time": 17259.03, "timestamp": "04:47:39", "text": "强调线和符号。那是抽搐"}, {"type": "subtitle", "time": 17263.35, "timestamp": "04:47:43", "text": "我收到的滴剂。"}, {"type": "subtitle", "time": 17265.99, "timestamp": "04:47:45", "text": "我到处都找不到它们。"}, {"type": "subtitle", "time": 17268.23, "timestamp": "04:47:48", "text": "这太可疑了。"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "我不知道。反正，"}]
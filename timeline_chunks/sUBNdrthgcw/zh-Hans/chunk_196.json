[{"type": "subtitle", "time": 11760.309, "timestamp": "03:16:00", "text": "实际上，让我看看我有没有"}, {"type": "subtitle", "time": 11763.349, "timestamp": "03:16:03", "text": "这边有东西。主要问题是"}, {"type": "subtitle", "time": 11767.91, "timestamp": "03:16:07", "text": "这就是为什么人们会这么说"}, {"type": "subtitle", "time": 11771.349, "timestamp": "03:16:11", "text": "总是"}, {"type": "subtitle", "time": 11773.349, "timestamp": "03:16:13", "text": "确保"}, {"type": "subtitle", "time": 11776.15, "timestamp": "03:16:16", "text": "嗯"}, {"type": "subtitle", "time": 11778.55, "timestamp": "03:16:18", "text": "务必记得使用 Google 云端硬盘。"}, {"type": "subtitle", "time": 11781.99, "timestamp": "03:16:21", "text": "你最终不会变成那样的一切"}, {"type": "subtitle", "time": 11785.59, "timestamp": "03:16:25", "text": "别落得跟我一样的下场。"}, {"type": "subtitle", "time": 11788.469, "timestamp": "03:16:28", "text": "这让我想起了最古老的……"}, {"type": "subtitle", "time": 11792.79, "timestamp": "03:16:32", "text": "老运动员时代。我的天啊。"}, {"type": "subtitle", "time": 11797.83, "timestamp": "03:16:37", "text": "大家最近怎么样？"}, {"type": "subtitle", "time": 11800.469, "timestamp": "03:16:40", "text": "希望你们一切都好。你知道"}, {"type": "subtitle", "time": 11802.79, "timestamp": "03:16:42", "text": "什么？呃，为了提供背景信息，我"}, {"type": "subtitle", "time": 11805.269, "timestamp": "03:16:45", "text": "我觉得我可以留着它。"}, {"type": "subtitle", "time": 11808.229, "timestamp": "03:16:48", "text": "这是个挺老的版本了。老歌，但"}, {"type": "subtitle", "time": 11810.309, "timestamp": "03:16:50", "text": "好东西。"}, {"type": "subtitle", "time": 11814.87, "timestamp": "03:16:54", "text": "嗯，我想我们可以保留这个。"}, {"type": "subtitle", "time": 11819.11, "timestamp": "03:16:59", "text": "是的。是的。我以前的作品。"}]
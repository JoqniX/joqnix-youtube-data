[{"type": "subtitle", "time": 14407.99, "timestamp": "04:00:07", "text": "[音乐]"}, {"type": "subtitle", "time": 14410.15, "timestamp": "04:00:10", "text": "为什么会有人把这个功能内置进去？我"}, {"type": "subtitle", "time": 14413.11, "timestamp": "04:00:13", "text": "怀疑他们很重视隐私。"}, {"type": "subtitle", "time": 14416.63, "timestamp": "04:00:16", "text": "这里的人穷是有原因的。我们来……"}, {"type": "subtitle", "time": 14419.429, "timestamp": "04:00:19", "text": "环顾四周，看看有没有什么可疑的东西"}, {"type": "subtitle", "time": 14428.15, "timestamp": "04:00:28", "text": "我真的把所有东西都打破了"}, {"type": "subtitle", "time": 14430.15, "timestamp": "04:00:30", "text": "主要内容会显示你和某个地方。"}, {"type": "subtitle", "time": 14432.389, "timestamp": "04:00:32", "text": "呃，中间那个紫色的箭头。这"}, {"type": "subtitle", "time": 14433.83, "timestamp": "04:00:33", "text": "这是你当前的目标。出版社和"}, {"type": "subtitle", "time": 14438.01, "timestamp": "04:00:38", "text": "按住 V 键。切换任务目标。好的。"}, {"type": "subtitle", "time": 14446.71, "timestamp": "04:00:46", "text": "调查。在我们展开调查之前，"}, {"type": "subtitle", "time": 14459.29, "timestamp": "04:00:59", "text": "你跑步的方式是什么？"}]
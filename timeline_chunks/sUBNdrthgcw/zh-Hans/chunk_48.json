[{"type": "subtitle", "time": 2891.829, "timestamp": "00:48:11", "text": "好了，我们都找到人了。嗨，我们来……"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "一切都按照每个人的说法"}, {"type": "subtitle", "time": 2895.43, "timestamp": "00:48:15", "text": "东西。"}, {"type": "subtitle", "time": 2897.109, "timestamp": "00:48:17", "text": "如果我切换它，它就会切换"}, {"type": "subtitle", "time": 2900.47, "timestamp": "00:48:20", "text": "现在这玩意儿。好的，首先，呃，谁"}, {"type": "subtitle", "time": 2909.75, "timestamp": "00:48:29", "text": "那个地方。我的笑话呢？好的。"}, {"type": "subtitle", "time": 2912.95, "timestamp": "00:48:32", "text": "好的。首先是忍者。你想要"}, {"type": "subtitle", "time": 2916.15, "timestamp": "00:48:36", "text": "七个，对吧？七号是银色的。"}, {"type": "subtitle", "time": 2918.549, "timestamp": "00:48:38", "text": "好的。"}, {"type": "subtitle", "time": 2921.829, "timestamp": "00:48:41", "text": "忍者。忍者在哪里？呃"}, {"type": "subtitle", "time": 2930.71, "timestamp": "00:48:50", "text": "我的天，这有点疼。等等，我"}]
[{"type": "subtitle", "time": 15420.21, "timestamp": "04:17:00", "text": "哦，不。这是一个箱子。"}, {"type": "subtitle", "time": 15429.75, "timestamp": "04:17:09", "text": "是利维坦。"}, {"type": "subtitle", "time": 15442.71, "timestamp": "04:17:22", "text": "我需要将这些雕像与它们的方位对齐。"}, {"type": "subtitle", "time": 15444.55, "timestamp": "04:17:24", "text": "反思。"}, {"type": "subtitle", "time": 15447.51, "timestamp": "04:17:27", "text": "好的。看来我别无选择。我要去"}, {"type": "subtitle", "time": 15450.309, "timestamp": "04:17:30", "text": "我得杀出一条血路才能离开这里。"}, {"type": "subtitle", "time": 15470.95, "timestamp": "04:17:50", "text": "所有Q技能在职业选手（呃，职业选手）期间都用于眩晕"}, {"type": "subtitle", "time": 15473.189, "timestamp": "04:17:53", "text": "敌人有五个愚蠢的五"}, {"type": "subtitle", "time": 15475.99, "timestamp": "04:17:55", "text": "反击。被击晕的敌人可以承受"}, {"type": "subtitle", "time": 15479.11, "timestamp": "04:17:59", "text": "额外损失以金色数字表示。"}]
[{"type": "subtitle", "time": 4921.11, "timestamp": "01:22:01", "text": "兄弟。它彻底崩溃了。什么？"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "什么？哦，让我关闭瓦莱林。为什么我会"}, {"type": "subtitle", "time": 4933.27, "timestamp": "01:22:13", "text": "哦，谢天谢地，它被保存下来了。哦，谢谢。"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "我真的哭了。没关系，"}, {"type": "subtitle", "time": 4957.35, "timestamp": "01:22:37", "text": "哦，不。我们目前面临一个情况。"}, {"type": "subtitle", "time": 4960.87, "timestamp": "01:22:40", "text": "哦，不。不，不，不，不，不。"}, {"type": "subtitle", "time": 4963.51, "timestamp": "01:22:43", "text": "等等，我觉得更好的办法是……"}, {"type": "subtitle", "time": 4969.189, "timestamp": "01:22:49", "text": "为此，我想我可以放大它。"}, {"type": "subtitle", "time": 4975.75, "timestamp": "01:22:55", "text": "120个就足够了。是的。是的。是的。"}, {"type": "subtitle", "time": 4977.43, "timestamp": "01:22:57", "text": "这样就解决了。是的。是的。是的。好的。"}]
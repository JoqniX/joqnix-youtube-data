[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "是的，如果我认为那样会好得多。"}, {"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "关于它。颜色。我喜欢"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "一种人们可以从中选择的方式"}, {"type": "subtitle", "time": 9249.27, "timestamp": "02:34:09", "text": "预设"}, {"type": "subtitle", "time": 9251.67, "timestamp": "02:34:11", "text": "他们添加图片并选择"}, {"type": "subtitle", "time": 9254.469, "timestamp": "02:34:14", "text": "他们可以选择你想拖动到哪里。"}, {"type": "subtitle", "time": 9257.51, "timestamp": "02:34:17", "text": "然后把自己扔到克里斯的圣诞节上。"}, {"type": "subtitle", "time": 9262.07, "timestamp": "02:34:22", "text": "树而不是我问"}, {"type": "subtitle", "time": 9265.59, "timestamp": "02:34:25", "text": "你想去哪里之类的。所以"}, {"type": "subtitle", "time": 9267.75, "timestamp": "02:34:27", "text": "想法是这样的。将有"}, {"type": "subtitle", "time": 9270.469, "timestamp": "02:34:30", "text": "就像一棵巨大的圣诞树。将有"}, {"type": "subtitle", "time": 9272.469, "timestamp": "02:34:32", "text": "就像串谋箱或类似的东西"}, {"type": "subtitle", "time": 9275.349, "timestamp": "02:34:35", "text": "一个类似盒子的空间，你可以在里面拖动和"}, {"type": "subtitle", "time": 9278.23, "timestamp": "02:34:38", "text": "像物体或什么东西一样掉下来"}, {"type": "subtitle", "time": 9281.99, "timestamp": "02:34:41", "text": "你自己。如果用户拖放并"}, {"type": "subtitle", "time": 9284.87, "timestamp": "02:34:44", "text": "点击确认位置是"}, {"type": "subtitle", "time": 9288.07, "timestamp": "02:34:48", "text": "与他们锁在一起，与他们捆绑在一起，"}, {"type": "subtitle", "time": 9293.349, "timestamp": "02:34:53", "text": "正确的？然后其他人就不能让你放"}, {"type": "subtitle", "time": 9296.07, "timestamp": "02:34:56", "text": "你们自己就那样保持那个姿势。"}, {"type": "subtitle", "time": 9299.83, "timestamp": "02:34:59", "text": "我的天哪，这真是个绝妙的主意。"}]
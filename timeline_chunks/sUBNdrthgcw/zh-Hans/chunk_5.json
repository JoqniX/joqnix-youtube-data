[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "哦，他有把禅宗枪。"}, {"type": "subtitle", "time": 312.87, "timestamp": "00:05:12", "text": "我得到了它。美好的。"}, {"type": "subtitle", "time": 315.67, "timestamp": "00:05:15", "text": "对不起。 11,000。我打算等等。"}, {"type": "subtitle", "time": 319.029, "timestamp": "00:05:19", "text": "那我应该做400个吗？"}, {"type": "subtitle", "time": 324.55, "timestamp": "00:05:24", "text": "我可以做400个。我的天哪。这是什么？"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "决不。决不。等待。呃，谁说的？"}, {"type": "subtitle", "time": 330.39, "timestamp": "00:05:30", "text": "玩谁？谁玩？这里谁参与了？"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "又是400？"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "呃，"}, {"type": "subtitle", "time": 338.23, "timestamp": "00:05:38", "text": "50027。"}, {"type": "subtitle", "time": 342.23, "timestamp": "00:05:42", "text": "不。好吧，行。太空人队。"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "圣主啊。 WHO？你最近怎么样？哦"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "我的上帝。"}, {"type": "subtitle", "time": 353.029, "timestamp": "00:05:53", "text": "这是什么？我动不了。我必须"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "我移动鼠标的次数太多了。搞什么鬼？"}]
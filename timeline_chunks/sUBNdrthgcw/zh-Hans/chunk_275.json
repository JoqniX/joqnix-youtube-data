[{"type": "subtitle", "time": 16502.23, "timestamp": "04:35:02", "text": "祝您在霍格沃茨的第一晚过得愉快。"}, {"type": "subtitle", "time": 16504.07, "timestamp": "04:35:04", "text": "睡得好。"}, {"type": "subtitle", "time": 16505.67, "timestamp": "04:35:05", "text": "夜晚"}, {"type": "subtitle", "time": 16508.07, "timestamp": "04:35:08", "text": "你们两个还没睡。祝你一切顺利"}, {"type": "subtitle", "time": 16510.839, "timestamp": "04:35:10", "text": "夜晚。"}, {"type": "subtitle", "time": 16522.47, "timestamp": "04:35:22", "text": "我刚刚意识到我忘了发推文了"}, {"type": "subtitle", "time": 16525.59, "timestamp": "04:35:25", "text": "溪流。好像大家都走了。"}, {"type": "subtitle", "time": 16528.39, "timestamp": "04:35:28", "text": "最好去公共休息室。"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "我不知道。不。我的意思是，我的确发了推文，"}, {"type": "subtitle", "time": 16537.91, "timestamp": "04:35:37", "text": "[音乐]"}, {"type": "subtitle", "time": 16544.709, "timestamp": "04:35:44", "text": "好多东西。"}, {"type": "subtitle", "time": 16546.949, "timestamp": "04:35:46", "text": "我已经弄坏了什么东西。我的天啊。"}, {"type": "subtitle", "time": 16549.75, "timestamp": "04:35:49", "text": "我弄坏了什么？我打破了"}, {"type": "subtitle", "time": 16555.429, "timestamp": "04:35:55", "text": "哦不，它救了它。我打破了"}, {"type": "subtitle", "time": 16559.75, "timestamp": "04:35:59", "text": "你愿意接受我们现在的样子吗？"}]
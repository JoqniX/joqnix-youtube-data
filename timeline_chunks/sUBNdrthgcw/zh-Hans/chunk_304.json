[{"type": "subtitle", "time": 18241.43, "timestamp": "05:04:01", "text": "比我运气好多了。"}, {"type": "subtitle", "time": 18243.43, "timestamp": "05:04:03", "text": "你好。所以，我相信她指的是……"}, {"type": "subtitle", "time": 18244.868, "timestamp": "05:04:04", "text": "这幅画，对吧？偶然发现"}, {"type": "subtitle", "time": 18246.55, "timestamp": "05:04:06", "text": "一些有启发性的东西，可以解决问题"}, {"type": "subtitle", "time": 18248.47, "timestamp": "05:04:08", "text": "神秘。所以，这就是她正在画的画。"}, {"type": "subtitle", "time": 18251.11, "timestamp": "05:04:11", "text": "一直在谈论这件事。"}, {"type": "subtitle", "time": 18253.91, "timestamp": "05:04:13", "text": "那个地方肯定是个线索。我应该看看"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "四处转转，​​看看它是否在附近。"}, {"type": "subtitle", "time": 18259.51, "timestamp": "05:04:19", "text": "好的。它就在附近"}, {"type": "subtitle", "time": 18268.708, "timestamp": "05:04:28", "text": "[音乐]"}, {"type": "subtitle", "time": 18270.47, "timestamp": "05:04:30", "text": "这看起来像是从……的位置"}, {"type": "subtitle", "time": 18272.31, "timestamp": "05:04:32", "text": "绘画。让我们带你回到你的"}, {"type": "subtitle", "time": 18276.31, "timestamp": "05:04:36", "text": "框架，小飞蛾。哦。"}, {"type": "subtitle", "time": 18287.83, "timestamp": "05:04:47", "text": "我知道这其中必有联系。我应该"}, {"type": "subtitle", "time": 18289.67, "timestamp": "05:04:49", "text": "告诉大家我已经解开了那个谜题。"}, {"type": "subtitle", "time": 18291.19, "timestamp": "05:04:51", "text": "空相框。"}, {"type": "subtitle", "time": 18292.788, "timestamp": "05:04:52", "text": "哇。"}]
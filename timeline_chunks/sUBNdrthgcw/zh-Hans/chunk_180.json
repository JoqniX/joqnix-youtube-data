[{"type": "subtitle", "time": 10800.55, "timestamp": "03:00:00", "text": "这里。不。"}, {"type": "subtitle", "time": 10803.349, "timestamp": "03:00:03", "text": "嗯，是的，他们三个都会到。所以"}, {"type": "subtitle", "time": 10805.51, "timestamp": "03:00:05", "text": "意思是：我的天哪，我把它弄得更复杂了"}, {"type": "subtitle", "time": 10808.23, "timestamp": "03:00:08", "text": "复杂的。但是，嗯，就像说呃，呃"}, {"type": "subtitle", "time": 10811.269, "timestamp": "03:00:11", "text": "它就像一棵树的装饰菜单，就像"}, {"type": "subtitle", "time": 10813.91, "timestamp": "03:00:13", "text": "窗户之类的东西。我们呃，人们确实会这样做。"}, {"type": "subtitle", "time": 10815.91, "timestamp": "03:00:15", "text": "诸如此类的事情，但是当你当他们"}, {"type": "subtitle", "time": 10818.95, "timestamp": "03:00:18", "text": "去大厅或者其他什么地方"}, {"type": "subtitle", "time": 10823.03, "timestamp": "03:00:23", "text": "这样一来，他们就会看到目前的情况。"}, {"type": "subtitle", "time": 10826.15, "timestamp": "03:00:26", "text": "像这样做了一棵圣诞树"}, {"type": "subtitle", "time": 10829.03, "timestamp": "03:00:29", "text": "3D视图之类的，或者像你那样"}, {"type": "subtitle", "time": 10831.19, "timestamp": "03:00:31", "text": "角落里的人都知道，然后他们就……"}, {"type": "subtitle", "time": 10833.59, "timestamp": "03:00:33", "text": "可以悬停并与之交互"}, {"type": "subtitle", "time": 10837.99, "timestamp": "03:00:37", "text": "我自己扮演的角色以及一些想听听的东西"}, {"type": "subtitle", "time": 10840.23, "timestamp": "03:00:40", "text": "我就是他们谈论的对象，或者"}, {"type": "subtitle", "time": 10842.309, "timestamp": "03:00:42", "text": "太可爱了。我不知道"}, {"type": "subtitle", "time": 10845.03, "timestamp": "03:00:45", "text": "这难道是个好主意吗？"}, {"type": "subtitle", "time": 10852.95, "timestamp": "03:00:52", "text": "呃，但是我又说，是的，就像我，我，我那种"}, {"type": "subtitle", "time": 10855.59, "timestamp": "03:00:55", "text": "这个想法来自企鹅俱乐部，而且"}, {"type": "subtitle", "time": 10858.63, "timestamp": "03:00:58", "text": "这是因为最近我开始……我只是……"}]
[{"type": "subtitle", "time": 4744.87, "timestamp": "01:19:04", "text": "好的。将其居中放置。好的。"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "我们罩着你。好的。"}, {"type": "subtitle", "time": 4755.43, "timestamp": "01:19:15", "text": "我觉得没问题。我这就去"}, {"type": "subtitle", "time": 4757.75, "timestamp": "01:19:17", "text": "呃"}, {"type": "subtitle", "time": 4761.03, "timestamp": "01:19:21", "text": "是的，我们需要空间。没关系。我猜"}, {"type": "subtitle", "time": 4765.189, "timestamp": "01:19:25", "text": "我可以把一些放在这里。没关系。"}, {"type": "subtitle", "time": 4767.03, "timestamp": "01:19:27", "text": "Jo，我喜欢你的寄件人帽子。我会偷"}, {"type": "subtitle", "time": 4769.43, "timestamp": "01:19:29", "text": "它。这是推特上的免费资源。只是"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "查一下。呃，它被制成了这个资产。"}, {"type": "subtitle", "time": 4775.59, "timestamp": "01:19:35", "text": "是由 Elaza Sun 专门制作的。"}, {"type": "subtitle", "time": 4777.91, "timestamp": "01:19:37", "text": "Elisa是一位印度YouTube博主。她确实"}, {"type": "subtitle", "time": 4781.669, "timestamp": "01:19:41", "text": "就像艺术一样，呃，操纵，呃，她操纵了自己的"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "模型之类的东西。好久不见了。我"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "错过。"}, {"type": "subtitle", "time": 4789.27, "timestamp": "01:19:49", "text": "好久不见了。"}, {"type": "subtitle", "time": 4791.99, "timestamp": "01:19:51", "text": "没错，就是她干的。我"}, {"type": "subtitle", "time": 4794.55, "timestamp": "01:19:54", "text": "应该在我的推特上。让我找找"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "它。"}, {"type": "subtitle", "time": 4799.27, "timestamp": "01:19:59", "text": "我记得我把它收藏了或者点赞了。"}]
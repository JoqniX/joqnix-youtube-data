[{"type": "subtitle", "time": 3120.069, "timestamp": "00:52:00", "text": "我得把它们重新分组。"}, {"type": "subtitle", "time": 3124.549, "timestamp": "00:52:04", "text": "我们采用的是较低层的方法，是吗？好的，"}, {"type": "subtitle", "time": 3127.19, "timestamp": "00:52:07", "text": "现在轮到主角登场了。所以，我们全部都得到了"}, {"type": "subtitle", "time": 3128.71, "timestamp": "00:52:08", "text": "这些东西，对吧？我们不需要这些。"}, {"type": "subtitle", "time": 3130.39, "timestamp": "00:52:10", "text": "如果你能保持住那个状态或者"}, {"type": "subtitle", "time": 3132.47, "timestamp": "00:52:12", "text": "还好，没事的。"}, {"type": "subtitle", "time": 3134.95, "timestamp": "00:52:14", "text": "哦，等等。我可以用到这些。或者应该"}, {"type": "subtitle", "time": 3137.829, "timestamp": "00:52:17", "text": "我？我不知道。任何。"}, {"type": "subtitle", "time": 3141.19, "timestamp": "00:52:21", "text": "呃，我亲爱的妹妹。第一个是忍者"}, {"type": "subtitle", "time": 3144.069, "timestamp": "00:52:24", "text": "如果你的号码是七，如果我是"}, {"type": "subtitle", "time": 3146.39, "timestamp": "00:52:26", "text": "正确的。"}, {"type": "subtitle", "time": 3163.75, "timestamp": "00:52:43", "text": "我们需要投入"}, {"type": "subtitle", "time": 3167.589, "timestamp": "00:52:47", "text": "把它变成这个。我们该如何做到这一点？"}, {"type": "subtitle", "time": 3170.87, "timestamp": "00:52:50", "text": "我在头脑风暴中做了什么？"}, {"type": "subtitle", "time": 3174.79, "timestamp": "00:52:54", "text": "那玩意儿？你认为喜欢更好"}, {"type": "subtitle", "time": 3176.39, "timestamp": "00:52:56", "text": "不，我们有两种方法可以做到。"}]
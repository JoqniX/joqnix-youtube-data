[{"type": "subtitle", "time": 14167.189, "timestamp": "03:56:07", "text": "古老的魔法。是的，强大的魔法"}, {"type": "subtitle", "time": 14170.55, "timestamp": "03:56:10", "text": "由极少数人拥有，似乎有"}, {"type": "subtitle", "time": 14177.91, "timestamp": "03:56:17", "text": "我们有个好主意。什么城堡？"}, {"type": "subtitle", "time": 14180.95, "timestamp": "03:56:20", "text": "由……建造，并且它本身就是一个堡垒"}, {"type": "subtitle", "time": 14184.389, "timestamp": "03:56:24", "text": "那种古老的魔法？我不知道在哪里"}, {"type": "subtitle", "time": 14186.309, "timestamp": "03:56:26", "text": "她接管了港口"}, {"type": "subtitle", "time": 14189.99, "timestamp": "03:56:29", "text": "关键在于，但我确信这与……有关"}, {"type": "subtitle", "time": 14192.95, "timestamp": "03:56:32", "text": "那次搜索。啊，那就是下山的路。"}, {"type": "subtitle", "time": 14195.62, "timestamp": "03:56:35", "text": "以下。这边走。"}, {"type": "subtitle", "time": 14198.309, "timestamp": "03:56:38", "text": "[音乐]"}, {"type": "subtitle", "time": 14200.87, "timestamp": "03:56:40", "text": "先生，您妻子为什么要寻找……"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "失落魔法的证据？"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "米里亚姆想弄明白为什么会这样"}, {"type": "subtitle", "time": 14207.269, "timestamp": "03:56:47", "text": "强大的魔法消失了"}, {"type": "subtitle", "time": 14210.15, "timestamp": "03:56:50", "text": "魔法世界。本来可以不这么做的"}, {"type": "subtitle", "time": 14212.389, "timestamp": "03:56:52", "text": "姓。但魔法也并无不同。它"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "现在它告诉我了。"}, {"type": "subtitle", "time": 14217.11, "timestamp": "03:56:57", "text": "真正重要的是那个人"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "挥舞着它。我希望我能改变这种状况。"}]
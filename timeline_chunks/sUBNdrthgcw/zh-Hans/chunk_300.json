[{"type": "subtitle", "time": 18000.23, "timestamp": "05:00:00", "text": "数小时直播。"}, {"type": "subtitle", "time": 18001.99, "timestamp": "05:00:01", "text": "我刚才是不是听到你在谈论……"}, {"type": "subtitle", "time": 18004.47, "timestamp": "05:00:04", "text": "探索老鼠？希望我没说得太多了"}, {"type": "subtitle", "time": 18006.39, "timestamp": "05:00:06", "text": "很多。你让我措手不及。我没有"}, {"type": "subtitle", "time": 18008.07, "timestamp": "05:00:08", "text": "把我们旅行的其他事情都告诉她吧。"}, {"type": "subtitle", "time": 18010.948, "timestamp": "05:00:10", "text": "这里。我会说我睡着了。你好。好的"}, {"type": "subtitle", "time": 18013.67, "timestamp": "05:00:13", "text": "夜晚。"}, {"type": "subtitle", "time": 18015.43, "timestamp": "05:00:15", "text": "是的。嗯，韦斯莱教授是一位"}, {"type": "subtitle", "time": 18018.15, "timestamp": "05:00:18", "text": "聪明睿智的女巫。没错。"}, {"type": "subtitle", "time": 18020.708, "timestamp": "05:00:20", "text": "暂时先保密。"}, {"type": "subtitle", "time": 18022.55, "timestamp": "05:00:22", "text": "我们不知道我们走过的这条路通向何方。"}, {"type": "subtitle", "time": 18025.75, "timestamp": "05:00:25", "text": "已着手开展的工作将引领方向。这可能需要"}, {"type": "subtitle", "time": 18028.868, "timestamp": "05:00:28", "text": "时间安排上可以更灵活一些。"}, {"type": "subtitle", "time": 18031.43, "timestamp": "05:00:31", "text": "比她会赞同的要好。她或许"}, {"type": "subtitle", "time": 18033.35, "timestamp": "05:00:33", "text": "感到有义务与……分享细节"}, {"type": "subtitle", "time": 18035.99, "timestamp": "05:00:35", "text": "最好还是离开校长办公室"}, {"type": "subtitle", "time": 18039.35, "timestamp": "05:00:39", "text": "我们之间。明白了，教授。好的。"}, {"type": "subtitle", "time": 18042.47, "timestamp": "05:00:42", "text": "即便你能力很强，我相信"}, {"type": "subtitle", "time": 18045.11, "timestamp": "05:00:45", "text": "你所拥有的能力使你有义务"}, {"type": "subtitle", "time": 18048.15, "timestamp": "05:00:48", "text": "接受过良好的训练。幸运的是，你拥有"}, {"type": "subtitle", "time": 18050.07, "timestamp": "05:00:50", "text": "拥有一支技术精湛的团队的好处"}, {"type": "subtitle", "time": 18052.708, "timestamp": "05:00:52", "text": "巫师和女巫会指引你。但"}, {"type": "subtitle", "time": 18055.83, "timestamp": "05:00:55", "text": "说到向导，这样我就可以……"}, {"type": "subtitle", "time": 18058.55, "timestamp": "05:00:58", "text": "避免再次受到不那么委婉的责备"}]
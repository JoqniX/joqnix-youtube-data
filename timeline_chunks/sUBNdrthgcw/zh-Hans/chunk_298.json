[{"type": "subtitle", "time": 17881.51, "timestamp": "04:58:01", "text": "三个 300 个值得相信的 YouTube 视频"}, {"type": "subtitle", "time": 17884.23, "timestamp": "04:58:04", "text": "流。我的天哪，太疼了。”但是"}, {"type": "subtitle", "time": 17885.91, "timestamp": "04:58:05", "text": "是的，"}, {"type": "subtitle", "time": 17889.35, "timestamp": "04:58:09", "text": "很可能在……结束之前"}, {"type": "subtitle", "time": 17891.59, "timestamp": "04:58:11", "text": "周一我将解锁三级，所以我"}, {"type": "subtitle", "time": 17896.47, "timestamp": "04:58:16", "text": "可上传最大 32GB 的视频。所以我不"}, {"type": "subtitle", "time": 17899.03, "timestamp": "04:58:19", "text": "需要把它切成几部分。所以"}, {"type": "subtitle", "time": 17901.35, "timestamp": "04:58:21", "text": "如果我继续直播，这些直播流就对了。"}, {"type": "subtitle", "time": 17903.59, "timestamp": "04:58:23", "text": "超过10个小时，我得把它分成几段"}, {"type": "subtitle", "time": 17905.27, "timestamp": "04:58:25", "text": "部分。"}, {"type": "subtitle", "time": 17910.31, "timestamp": "04:58:30", "text": "300。是的。 300。是的。当然。所以我正在尝试"}, {"type": "subtitle", "time": 17914.868, "timestamp": "04:58:34", "text": "逐一添加到播放列表中。"}, {"type": "subtitle", "time": 17917.91, "timestamp": "04:58:37", "text": "但那是一种痛苦。所以我从我的第一个开始"}, {"type": "subtitle", "time": 17920.788, "timestamp": "04:58:40", "text": "在 YouTube 上直播到“不，我呃我”"}, {"type": "subtitle", "time": 17924.15, "timestamp": "04:58:44", "text": "实际上是从最新的到旧的。"}, {"type": "subtitle", "time": 17926.47, "timestamp": "04:58:46", "text": "呃，下载的时候。"}, {"type": "subtitle", "time": 17929.11, "timestamp": "04:58:49", "text": "那是一种疼痛。我花了两个星期。我"}, {"type": "subtitle", "time": 17930.948, "timestamp": "04:58:50", "text": "昨天把YouTube相关的工作都做完了。所以"}, {"type": "subtitle", "time": 17936.07, "timestamp": "04:58:56", "text": "那就像我上周日开始做的那样。"}, {"type": "subtitle", "time": 17939.59, "timestamp": "04:58:59", "text": "上周日是星期几？嗯，不，我开始了"}]
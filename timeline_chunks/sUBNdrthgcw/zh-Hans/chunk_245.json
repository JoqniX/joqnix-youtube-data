[{"type": "subtitle", "time": 14702.309, "timestamp": "04:05:02", "text": "来这里看看那块魔法石吧？"}, {"type": "subtitle", "time": 14703.91, "timestamp": "04:05:03", "text": "那简直是最难的。为什么会有"}, {"type": "subtitle", "time": 14708.15, "timestamp": "04:05:08", "text": "后面的房间？哪个房间？我没看到"}, {"type": "subtitle", "time": 14710.87, "timestamp": "04:05:10", "text": "任何事物。那光芒又出现了。喜欢"}, {"type": "subtitle", "time": 14712.309, "timestamp": "04:05:12", "text": "门廊上的光芒。我正在获得"}, {"type": "subtitle", "time": 14714.87, "timestamp": "04:05:14", "text": "被打断了。我确定现在已经很晚了。"}, {"type": "subtitle", "time": 14729.59, "timestamp": "04:05:29", "text": "戈德里克的心。"}]
[{"type": "subtitle", "time": 2643.43, "timestamp": "00:44:03", "text": "伊桑·希布利 我觉得这个人是新来的"}, {"type": "subtitle", "time": 2645.91, "timestamp": "00:44:05", "text": "我想这里"}, {"type": "subtitle", "time": 2648.069, "timestamp": "00:44:08", "text": "是的，这个人是新来的，我以前没见过。"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "他们之前是他们吗？"}, {"type": "subtitle", "time": 2652.79, "timestamp": "00:44:12", "text": "等等，让我再确认一下。它们是新的吗？"}, {"type": "subtitle", "time": 2654.95, "timestamp": "00:44:14", "text": "我认为他们是。"}, {"type": "subtitle", "time": 2662.95, "timestamp": "00:44:22", "text": "是的，确实如此。它们是新的。哦，是的。它"}, {"type": "subtitle", "time": 2665.589, "timestamp": "00:44:25", "text": "这是他们第一次。是的。"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "好的。好的。"}, {"type": "subtitle", "time": 2684.47, "timestamp": "00:44:44", "text": "还有什么？喵。哦，是的。喵。"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "想知道什么？呃，我记得我看到过"}, {"type": "subtitle", "time": 2693.67, "timestamp": "00:44:53", "text": "看看我的Nanx标志。你可能成功了"}, {"type": "subtitle", "time": 2696.47, "timestamp": "00:44:56", "text": "回到2016年。出发吧。该死。"}, {"type": "subtitle", "time": 2699.44, "timestamp": "00:44:59", "text": "该死。 我还设计了自己的标志。"}]
[{"type": "subtitle", "time": 19140.23, "timestamp": "05:19:00", "text": "竞赛。阿奈小姐，您愿意吗？"}, {"type": "subtitle", "time": 19142.39, "timestamp": "05:19:02", "text": "给我们的新学生一点……"}, {"type": "subtitle", "time": 19150.15, "timestamp": "05:19:10", "text": "我的天哪。蓝调依旧如故。和"}, {"type": "subtitle", "time": 19153.99, "timestamp": "05:19:13", "text": "Missai，你玩红色。清除。我的天哪。"}, {"type": "subtitle", "time": 19155.59, "timestamp": "05:19:15", "text": "是的，先生。实际上用来召唤球"}, {"type": "subtitle", "time": 19159.03, "timestamp": "05:19:19", "text": "离你最近的边缘"}, {"type": "subtitle", "time": 19161.75, "timestamp": "05:19:21", "text": "无需费尽心思就能得分"}, {"type": "subtitle", "time": 19164.788, "timestamp": "05:19:24", "text": "积分。哦，"}, {"type": "subtitle", "time": 19168.868, "timestamp": "05:19:28", "text": "这肯定很艰难。但是，我也喜欢"}, {"type": "subtitle", "time": 19170.47, "timestamp": "05:19:30", "text": "竞争力"}, {"type": "subtitle", "time": 19180.948, "timestamp": "05:19:40", "text": "啊，等等。我错了。没关系。"}, {"type": "subtitle", "time": 19183.75, "timestamp": "05:19:43", "text": "没关系。我会打败她。不用担心。"}, {"type": "subtitle", "time": 19185.35, "timestamp": "05:19:45", "text": "别担心，我会打败她的。不用担心，"}, {"type": "subtitle", "time": 19187.99, "timestamp": "05:19:47", "text": "我会打败她。"}, {"type": "subtitle", "time": 19190.868, "timestamp": "05:19:50", "text": "哦，你不会真的这么做了吧。"}, {"type": "subtitle", "time": 19193.27, "timestamp": "05:19:53", "text": "就是这样做的。你不仅如此"}]
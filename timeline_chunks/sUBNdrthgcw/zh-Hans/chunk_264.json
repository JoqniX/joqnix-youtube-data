[{"type": "subtitle", "time": 15845.75, "timestamp": "04:24:05", "text": "我猜对了。呃，Ramrock。"}, {"type": "subtitle", "time": 15850.229, "timestamp": "04:24:10", "text": "看来我的名声已经传开了。我当时"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "开始觉得可能根本没人会去。"}, {"type": "subtitle", "time": 15854.87, "timestamp": "04:24:14", "text": "去拉科姆斯参观。这个人是谁？和"}, {"type": "subtitle", "time": 15857.99, "timestamp": "04:24:17", "text": "你为什么在这里？"}, {"type": "subtitle", "time": 15861.83, "timestamp": "04:24:21", "text": "没必要那样。给我任何东西"}, {"type": "subtitle", "time": 15863.99, "timestamp": "04:24:23", "text": "你在这里找到了我们，我们可以让你"}, {"type": "subtitle", "time": 15872.229, "timestamp": "04:24:32", "text": "先生，"}, {"type": "subtitle", "time": 15876.229, "timestamp": "04:24:36", "text": "他们有金库的钥匙。"}, {"type": "subtitle", "time": 15881.03, "timestamp": "04:24:41", "text": "慎重选择你接下来要说的话。我只"}, {"type": "subtitle", "time": 15884.149, "timestamp": "04:24:44", "text": "这意味着12号避难所的说明"}, {"type": "subtitle", "time": 15887.429, "timestamp": "04:24:47", "text": "非常清楚。"}, {"type": "subtitle", "time": 15890.469, "timestamp": "04:24:50", "text": "先生，我必须坚持。我本应授予"}, {"type": "subtitle", "time": 15892.87, "timestamp": "04:24:52", "text": "只有持有钥匙的人才能进入，而你"}, {"type": "subtitle", "time": 15896.149, "timestamp": "04:24:56", "text": "没有。"}]
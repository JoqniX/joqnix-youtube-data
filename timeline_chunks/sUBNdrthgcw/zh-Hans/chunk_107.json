[{"type": "subtitle", "time": 6420.39, "timestamp": "01:47:00", "text": "是的，我们可以玩轮盘赌。"}, {"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "不像随便什么东西。"}, {"type": "subtitle", "time": 6426.87, "timestamp": "01:47:06", "text": "所以"}, {"type": "subtitle", "time": 6434.55, "timestamp": "01:47:14", "text": "好的。我打算碰碰运气。"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "有没有什么快捷方法可以像这样放置"}, {"type": "subtitle", "time": 6443.189, "timestamp": "01:47:23", "text": "最上面那玩意儿？"}, {"type": "subtitle", "time": 6452.95, "timestamp": "01:47:32", "text": "[音乐]"}, {"type": "subtitle", "time": 6455.75, "timestamp": "01:47:35", "text": "好的。"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "我想给维克托送粉色和紫色"}, {"type": "subtitle", "time": 6469.109, "timestamp": "01:47:49", "text": "一。"}, {"type": "subtitle", "time": 6471.59, "timestamp": "01:47:51", "text": "呃，"}, {"type": "subtitle", "time": 6473.99, "timestamp": "01:47:53", "text": "我不知道。"}, {"type": "subtitle", "time": 6479.91, "timestamp": "01:47:59", "text": "因为我现在没办法弄清楚。"}]
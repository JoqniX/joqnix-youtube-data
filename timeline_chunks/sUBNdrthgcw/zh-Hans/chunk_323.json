[{"type": "subtitle", "time": 19381.27, "timestamp": "05:23:01", "text": "就竞争力而言"}, {"type": "subtitle", "time": 19383.99, "timestamp": "05:23:03", "text": "我不在乎，我两个都不太擅长"}, {"type": "subtitle", "time": 19386.868, "timestamp": "05:23:06", "text": "我不喜欢你，就像我不喜欢那些人一样。"}, {"type": "subtitle", "time": 19413.59, "timestamp": "05:23:33", "text": "精彩的比赛！我必须承认，我"}, {"type": "subtitle", "time": 19416.31, "timestamp": "05:23:36", "text": "我想我低估你了。"}, {"type": "subtitle", "time": 19418.868, "timestamp": "05:23:38", "text": "需要几周时间才能熟练使用AIO。"}, {"type": "subtitle", "time": 19421.27, "timestamp": "05:23:41", "text": "我花了几个星期才做对一件事。"}, {"type": "subtitle", "time": 19424.15, "timestamp": "05:23:44", "text": "我转学过来的时候。情况会好转的。"}, {"type": "subtitle", "time": 19428.868, "timestamp": "05:23:48", "text": "很高兴你能理解。那很好"}, {"type": "subtitle", "time": 19431.75, "timestamp": "05:23:51", "text": "听到。一下子要接受这么多信息，有点难。"}, {"type": "subtitle", "time": 19434.15, "timestamp": "05:23:54", "text": "说得委婉些，"}, {"type": "subtitle", "time": 19436.07, "timestamp": "05:23:56", "text": "我记得我第一次……时的感受。"}, {"type": "subtitle", "time": 19438.628, "timestamp": "05:23:58", "text": "到达的。我从瓦加杜调到这里。"}]
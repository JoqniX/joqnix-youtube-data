[{"type": "subtitle", "time": 9121.51, "timestamp": "02:32:01", "text": "呃"}, {"type": "subtitle", "time": 9124.07, "timestamp": "02:32:04", "text": "我得尽快结束这项工作。好的，我补充一下"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "是的，我认为那个网站的想法会是"}, {"type": "subtitle", "time": 9145.03, "timestamp": "02:32:25", "text": "好多了。我猜"}, {"type": "subtitle", "time": 9147.99, "timestamp": "02:32:27", "text": "我就是这种感觉，因为我们没有"}, {"type": "subtitle", "time": 9150.07, "timestamp": "02:32:30", "text": "现在必须做这件事。想想看"}, {"type": "subtitle", "time": 9153.03, "timestamp": "02:32:33", "text": "目前，在我目前的"}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "呃，我觉得没问题，我可以"}, {"type": "subtitle", "time": 9159.51, "timestamp": "02:32:39", "text": "手动添加大约 20 到 30 人"}, {"type": "subtitle", "time": 9161.91, "timestamp": "02:32:41", "text": "没关系"}, {"type": "subtitle", "time": 9165.27, "timestamp": "02:32:45", "text": "但从长远角度考虑这个问题。"}, {"type": "subtitle", "time": 9168.07, "timestamp": "02:32:48", "text": "就像你永远不知道下一个圣诞节会发生什么一样"}, {"type": "subtitle", "time": 9171.51, "timestamp": "02:32:51", "text": "会有多少？会有多少个？"}, {"type": "subtitle", "time": 9177.19, "timestamp": "02:32:57", "text": "星座也会在那里，所以，嗯。"}, {"type": "subtitle", "time": 9179.99, "timestamp": "02:32:59", "text": "不想把事情搞得太难，太苛刻了。"}]
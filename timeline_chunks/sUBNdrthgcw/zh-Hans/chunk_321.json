[{"type": "subtitle", "time": 19264.26, "timestamp": "05:21:04", "text": "水平"}, {"type": "subtitle", "time": 19272.15, "timestamp": "05:21:12", "text": "让我们让这件事更有趣一些，"}, {"type": "subtitle", "time": 19274.948, "timestamp": "05:21:14", "text": "我们可以？"}, {"type": "subtitle", "time": 19277.99, "timestamp": "05:21:17", "text": "哦，还有更多。那样我就能赢了。"}, {"type": "subtitle", "time": 19280.31, "timestamp": "05:21:20", "text": "狗狗弄丢了号码牌。不用担心。我会看"}, {"type": "subtitle", "time": 19283.11, "timestamp": "05:21:23", "text": "我赢了。我认为我们早已过了那个阶段。"}, {"type": "subtitle", "time": 19286.55, "timestamp": "05:21:26", "text": "这一点很有意思。"}, {"type": "subtitle", "time": 19290.55, "timestamp": "05:21:30", "text": "我会说。闲话少说。现在集中注意力。你"}, {"type": "subtitle", "time": 19292.23, "timestamp": "05:21:32", "text": "需要它。"}, {"type": "subtitle", "time": 19312.47, "timestamp": "05:21:52", "text": "三、二，我需要找到合适的"}]
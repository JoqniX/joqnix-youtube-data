[{"type": "subtitle", "time": 14280.15, "timestamp": "03:58:00", "text": "你的奇迹会随着任何角色的加入而增强。"}, {"type": "subtitle", "time": 14282.79, "timestamp": "03:58:02", "text": "谢谢您，先生。"}, {"type": "subtitle", "time": 14285.349, "timestamp": "03:58:05", "text": "打破它能给我钱吗？"}, {"type": "subtitle", "time": 14303.24, "timestamp": "03:58:23", "text": "啊，上面。"}, {"type": "subtitle", "time": 14304.55, "timestamp": "03:58:24", "text": "[音乐]"}, {"type": "subtitle", "time": 14306.43, "timestamp": "03:58:26", "text": "你如何"}, {"type": "subtitle", "time": 14308.55, "timestamp": "03:58:28", "text": "[掌声]"}, {"type": "subtitle", "time": 14318.95, "timestamp": "03:58:38", "text": "[音乐]"}, {"type": "subtitle", "time": 14321.349, "timestamp": "03:58:41", "text": "谢天谢地，我像搜原神一样搜到了它。哦"}, {"type": "subtitle", "time": 14325.51, "timestamp": "03:58:45", "text": "我的天啊，我找到一个箱子了。"}, {"type": "subtitle", "time": 14327.349, "timestamp": "03:58:47", "text": "我当时就想，“是啊，肯定有。”"}, {"type": "subtitle", "time": 14330.55, "timestamp": "03:58:50", "text": "那边有东西。"}]
[{"type": "subtitle", "time": 4263.83, "timestamp": "01:11:03", "text": "それを「オーマイゴッド」にすることができる。"}, {"type": "subtitle", "time": 4271.35, "timestamp": "01:11:11", "text": "私は文字通りこのように作ることができます。ああ、"}, {"type": "subtitle", "time": 4273.669, "timestamp": "01:11:13", "text": "神。もし私がそうしたければ。何てことだ。待って。"}, {"type": "subtitle", "time": 4292.39, "timestamp": "01:11:32", "text": "いいえ。範囲。"}, {"type": "subtitle", "time": 4295.27, "timestamp": "01:11:35", "text": "私はできません。"}, {"type": "subtitle", "time": 4299.35, "timestamp": "01:11:39", "text": "何てことだ。私ならできます。何てことだ。おお"}, {"type": "subtitle", "time": 4303.03, "timestamp": "01:11:43", "text": "我が神よ。ニース。何てことだ。"}, {"type": "subtitle", "time": 4307.11, "timestamp": "01:11:47", "text": "マスクで隠蔽できます。私は知らない、それは"}, {"type": "subtitle", "time": 4314.47, "timestamp": "01:11:54", "text": "今はどんな形ですか？わかった。待って。ええと、私たちは探しています"}, {"type": "subtitle", "time": 4316.55, "timestamp": "01:11:56", "text": "日食のために。"}, {"type": "subtitle", "time": 4319.669, "timestamp": "01:11:59", "text": "えーと、"}]
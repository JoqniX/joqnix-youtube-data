[{"type": "subtitle", "time": 15000.55, "timestamp": "04:10:00", "text": "これが最後に起こったのはいつですか"}, {"type": "subtitle", "time": 15003.51, "timestamp": "04:10:03", "text": "アクセスされましたか？ゴブリンが配置されました"}, {"type": "subtitle", "time": 15007.03, "timestamp": "04:10:07", "text": "私の机は何百年もの間、私の机として使われてきました。その点において"}, {"type": "subtitle", "time": 15009.75, "timestamp": "04:10:09", "text": "それ以来、誰も訪れていない。見てください"}, {"type": "subtitle", "time": 15040.229, "timestamp": "04:10:40", "text": "なぜ私たちは誰かの心を開くためにここにいるのか"}, {"type": "subtitle", "time": 15043.189, "timestamp": "04:10:43", "text": "また他人の金庫か？どう思いますか？"}, {"type": "subtitle", "time": 15046.229, "timestamp": "04:10:46", "text": "私たちが探すべきものは何でしょうか？よくわからない。"}, {"type": "subtitle", "time": 15048.389, "timestamp": "04:10:48", "text": "先生、指示書が"}, {"type": "subtitle", "time": 15050.55, "timestamp": "04:10:50", "text": "Vault 12については、私が許可するべきであることを示しています"}, {"type": "subtitle", "time": 15053.03, "timestamp": "04:10:53", "text": "鍵の所有者にアクセスし、"}]
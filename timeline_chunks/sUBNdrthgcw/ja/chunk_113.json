[{"type": "subtitle", "time": 6789.43, "timestamp": "01:53:09", "text": "あなたを利用できないのですか？"}, {"type": "subtitle", "time": 6792.229, "timestamp": "01:53:12", "text": "どうやって殺せばいいですか？"}, {"type": "subtitle", "time": 6803.99, "timestamp": "01:53:23", "text": "レオを殺すにはどうすればいいですか？"}, {"type": "subtitle", "time": 6815.189, "timestamp": "01:53:35", "text": "あ、待って。はぁ？それは示さなかった"}, {"type": "subtitle", "time": 6818.31, "timestamp": "01:53:38", "text": "別の明白なことのように、何かが走っている。"}, {"type": "subtitle", "time": 6820.95, "timestamp": "01:53:40", "text": "ニース。"}, {"type": "subtitle", "time": 6823.91, "timestamp": "01:53:43", "text": "わかった。"}, {"type": "subtitle", "time": 6826.87, "timestamp": "01:53:46", "text": "ああ、でもいつか買わなきゃいけない"}, {"type": "subtitle", "time": 6830.39, "timestamp": "01:53:50", "text": "これらのライセンスを取得すれば、ついに"}, {"type": "subtitle", "time": 6836.87, "timestamp": "01:53:56", "text": "動かなくなってしまった。ブラウザの問題だと思います"}, {"type": "subtitle", "time": 6839.27, "timestamp": "01:53:59", "text": "ソースと、グループも多すぎる"}]
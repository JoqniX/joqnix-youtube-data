[{"type": "subtitle", "time": 2643.43, "timestamp": "00:44:03", "text": "イーサン・シブリー この人は新しい人だと思う"}, {"type": "subtitle", "time": 2645.91, "timestamp": "00:44:05", "text": "ここかな"}, {"type": "subtitle", "time": 2648.069, "timestamp": "00:44:08", "text": "うん、この人は初めて見た人だった"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "彼ら以前の彼らは"}, {"type": "subtitle", "time": 2652.79, "timestamp": "00:44:12", "text": "ちょっと待って、もう一度確認させてください。それらは新しいものですか？"}, {"type": "subtitle", "time": 2654.95, "timestamp": "00:44:14", "text": "そうだと思います。"}, {"type": "subtitle", "time": 2662.95, "timestamp": "00:44:22", "text": "ええ、そうです。それらは新しいものです。そうそう。それ"}, {"type": "subtitle", "time": 2665.589, "timestamp": "00:44:25", "text": "彼らにとって初めてのことだ。うん。"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "ニース。ニース。"}, {"type": "subtitle", "time": 2684.47, "timestamp": "00:44:44", "text": "ほかに何か？ニャー。そうそう。ニャー。"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "何を疑問に思ったのですか？ええと、私は見たのを覚えています"}, {"type": "subtitle", "time": 2693.67, "timestamp": "00:44:53", "text": "私のNanxのロゴを見てください。あなたはそれを成し遂げたかもしれない"}, {"type": "subtitle", "time": 2696.47, "timestamp": "00:44:56", "text": "2016年の私。さあ、行こう。くそ。"}, {"type": "subtitle", "time": 2699.44, "timestamp": "00:44:59", "text": "くそ。 私も自分のロゴを作りました"}]
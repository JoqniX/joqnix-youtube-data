[{"type": "subtitle", "time": 12184.07, "timestamp": "03:23:04", "text": "でも、あなたはすべてを聞いている。私の声が聞こえる"}, {"type": "subtitle", "time": 12188.07, "timestamp": "03:23:08", "text": "机。何てことだ。これがその感覚なのか"}, {"type": "subtitle", "time": 12197.19, "timestamp": "03:23:17", "text": "ええ、そうですね。こんにちは。ああ、アディサ。うん。こんにちは。"}, {"type": "subtitle", "time": 12200.229, "timestamp": "03:23:20", "text": "お元気ですか？ええと、今日は擦り傷です"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "ストリームは、私のGPUが、私は"}, {"type": "subtitle", "time": 12206.15, "timestamp": "03:23:26", "text": "修理部品は必要だけど、直さないといけないんだ。だから私は"}, {"type": "subtitle", "time": 12207.91, "timestamp": "03:23:27", "text": "今日はできなかったので、"}, {"type": "subtitle", "time": 12209.83, "timestamp": "03:23:29", "text": "ドライバーを持ってください。"}, {"type": "subtitle", "time": 12212.63, "timestamp": "03:23:32", "text": "ええと、明日やります。"}, {"type": "subtitle", "time": 12214.71, "timestamp": "03:23:34", "text": "直します、いつもに戻ります"}, {"type": "subtitle", "time": 12217.51, "timestamp": "03:23:37", "text": "明日セットアップします。わかった。それで、私は"}, {"type": "subtitle", "time": 12220.55, "timestamp": "03:23:40", "text": "今日はこれで全て大丈夫です。"}, {"type": "subtitle", "time": 12222.469, "timestamp": "03:23:42", "text": "うん。うん。うん。うん。それは、"}, {"type": "subtitle", "time": 12224.15, "timestamp": "03:23:44", "text": "音声が聞こえたら教えてください。私は"}, {"type": "subtitle", "time": 12226.469, "timestamp": "03:23:46", "text": "音声の問題を修正しようとしています。ああ、これは"}, {"type": "subtitle", "time": 12229.19, "timestamp": "03:23:49", "text": "痛みです。"}, {"type": "subtitle", "time": 12231.19, "timestamp": "03:23:51", "text": "わかった。それで、"}, {"type": "subtitle", "time": 12234.07, "timestamp": "03:23:54", "text": "なぜ何も聞こえないのだろう？"}, {"type": "subtitle", "time": 12238.07, "timestamp": "03:23:58", "text": "ああ、ミュートにしてたよ。なんてバカなやつだ。"}]
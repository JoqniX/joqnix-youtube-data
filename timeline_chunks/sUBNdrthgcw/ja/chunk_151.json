[{"type": "subtitle", "time": 9061.83, "timestamp": "02:31:01", "text": "私もアイデアが浮かんだ。うん。こんにちは、ジェイド"}, {"type": "subtitle", "time": 9064.309, "timestamp": "02:31:04", "text": "警官。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 9066.71, "timestamp": "02:31:06", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 9069.429, "timestamp": "02:31:09", "text": "何てことだ。それは大きな何ですか？あなたはそうするかもしれない"}, {"type": "subtitle", "time": 9072.309, "timestamp": "02:31:12", "text": "ちびキャラについて話している"}, {"type": "subtitle", "time": 9077.67, "timestamp": "02:31:17", "text": "私のちびキャラバージョン。小さな私。"}, {"type": "subtitle", "time": 9079.91, "timestamp": "02:31:19", "text": "うん。そう、ちびキャラのやつ。どうでしたか？"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "わかった。あらら。はい。ええと、ようこそ"}, {"type": "subtitle", "time": 9091.59, "timestamp": "02:31:31", "text": "ストリーム、ジェイド。そこで、私たちは"}, {"type": "subtitle", "time": 9093.99, "timestamp": "02:31:33", "text": "流れにやって来る"}, {"type": "subtitle", "time": 9096.71, "timestamp": "02:31:36", "text": "クリスマスオーナメント。だからあなたを追加する必要がある"}, {"type": "subtitle", "time": 9098.71, "timestamp": "02:31:38", "text": "同じように。"}, {"type": "subtitle", "time": 9103.349, "timestamp": "02:31:43", "text": "ということで、これらがあります。どちらかを選んでください"}, {"type": "subtitle", "time": 9106.309, "timestamp": "02:31:46", "text": "あなたが欲しい装飾品。だから私は追加できます"}, {"type": "subtitle", "time": 9113.27, "timestamp": "02:31:53", "text": "えっと、ちょっと水を飲ませてください。"}, {"type": "chat", "time": 9113.816, "timestamp": "02:31:53", "author": "@Seeker0fsalvat1on", "avatar": "https://yt4.ggpht.com/g-8LS8zE-ucIiA8eoueYg8eT__TmdAWErhse_hHip8PYG5SEyrP_mq3pAU1FChyhx0b7oNMT3g=s64-c-k-c0x00ffffff-no-rj", "message": "morning joq"}, {"type": "subtitle", "time": 9115.75, "timestamp": "02:31:55", "text": "でも、本当に気分が悪いんです。しないつもりだ"}, {"type": "chat", "time": 9117.239, "timestamp": "02:31:57", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... Vicky , Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 9119.27, "timestamp": "02:31:59", "text": "嘘。本当に気分が悪いです。"}]
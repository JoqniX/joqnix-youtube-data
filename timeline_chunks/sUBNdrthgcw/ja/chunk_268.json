[{"type": "subtitle", "time": 16100.38, "timestamp": "04:28:20", "text": "おお。"}, {"type": "subtitle", "time": 16103.03, "timestamp": "04:28:23", "text": "[音楽]"}, {"type": "subtitle", "time": 16104.63, "timestamp": "04:28:24", "text": "下。"}, {"type": "subtitle", "time": 16106.55, "timestamp": "04:28:26", "text": "良い。仕分け作業は見逃していません"}, {"type": "subtitle", "time": 16109.03, "timestamp": "04:28:29", "text": "式。"}, {"type": "subtitle", "time": 16113.349, "timestamp": "04:28:33", "text": "私は専門家ではありませんが、それは"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "適切な。"}, {"type": "subtitle", "time": 16117.75, "timestamp": "04:28:37", "text": "さて、このロケットをすぐに研究する必要がある"}, {"type": "subtitle", "time": 16119.59, "timestamp": "04:28:39", "text": "できる限りですが、まず連絡しなければなりません"}, {"type": "subtitle", "time": 16121.59, "timestamp": "04:28:41", "text": "省。彼らは何を知る必要があるのか"}, {"type": "subtitle", "time": 16123.03, "timestamp": "04:28:43", "text": "ジョージに起こったこと、そして警告されたこと"}, {"type": "subtitle", "time": 16125.83, "timestamp": "04:28:45", "text": "ランドロック。今のところ、あなたにお願いしたいのは"}, {"type": "subtitle", "time": 16127.75, "timestamp": "04:28:47", "text": "今晩起こったことすべてを"}, {"type": "subtitle", "time": 16130.79, "timestamp": "04:28:50", "text": "あなたと私だけの秘密。もちろんです、閣下。"}, {"type": "subtitle", "time": 16132.95, "timestamp": "04:28:52", "text": "ありがとう。"}]
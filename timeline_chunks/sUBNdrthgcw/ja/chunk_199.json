[{"type": "subtitle", "time": 11943.03, "timestamp": "03:19:03", "text": "分。でも私が遅れた理由は"}, {"type": "subtitle", "time": 11945.91, "timestamp": "03:19:05", "text": "なぜなら、それは主に私が"}, {"type": "subtitle", "time": 11949.03, "timestamp": "03:19:09", "text": "そう思ってたんだ、そうだね、わかる？私は"}, {"type": "subtitle", "time": 11952.07, "timestamp": "03:19:12", "text": "すでにホグワーツを配信中。それで、"}, {"type": "subtitle", "time": 11957.19, "timestamp": "03:19:17", "text": "GPUを修理するみたいにやってみたらどう？"}, {"type": "subtitle", "time": 11959.349, "timestamp": "03:19:19", "text": "そして、昔みたいに普通にやる"}, {"type": "subtitle", "time": 11961.03, "timestamp": "03:19:21", "text": "する。私はこれに参加する必要はない"}, {"type": "subtitle", "time": 11964.87, "timestamp": "03:19:24", "text": "一時的な設置で、多少粗雑なのは仕方ないですよね？"}, {"type": "subtitle", "time": 11966.389, "timestamp": "03:19:26", "text": "うん。"}, {"type": "subtitle", "time": 11968.55, "timestamp": "03:19:28", "text": "でもありがたいことに明日には手に入れるよ"}, {"type": "subtitle", "time": 11971.59, "timestamp": "03:19:31", "text": "完全に直りました。だから、私はそれを直すことができませんでした。私"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "えっと、私は持っていなかったので、一つはこれでした"}, {"type": "subtitle", "time": 11979.11, "timestamp": "03:19:39", "text": "3年前、1年前か2年前に戻ってきた"}, {"type": "subtitle", "time": 11980.95, "timestamp": "03:19:40", "text": "1年前、私が片付けようとしていたとき"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "ファンを外そうとした。それで、"}, {"type": "subtitle", "time": 11986.15, "timestamp": "03:19:46", "text": "どうやら私は大きなドライバーを使ったようです。"}, {"type": "subtitle", "time": 11989.99, "timestamp": "03:19:49", "text": "フィリップスは、それはプラスであり、"}, {"type": "subtitle", "time": 11992.469, "timestamp": "03:19:52", "text": "プラス記号か星のようなものだけど、"}, {"type": "subtitle", "time": 11995.03, "timestamp": "03:19:55", "text": "大きめのドライバーのようなもの"}, {"type": "subtitle", "time": 11998.71, "timestamp": "03:19:58", "text": "ちょっとネジをいじってしまったけど"}]
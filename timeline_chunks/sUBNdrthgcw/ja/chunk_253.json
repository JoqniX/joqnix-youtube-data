[{"type": "subtitle", "time": 15197.189, "timestamp": "04:13:17", "text": "前方に何かが見える。それは何ですか？"}, {"type": "subtitle", "time": 15208.309, "timestamp": "04:13:28", "text": "これはどういうことですか？"}, {"type": "subtitle", "time": 15210.95, "timestamp": "04:13:30", "text": "魔法の世界を楽しもう。"}, {"type": "subtitle", "time": 15214.229, "timestamp": "04:13:34", "text": "ルモス、何があったの？"}, {"type": "subtitle", "time": 15216.389, "timestamp": "04:13:36", "text": "私がその光に向かって移動したとき、"}, {"type": "subtitle", "time": 15218.07, "timestamp": "04:13:38", "text": "突然地面が"}, {"type": "subtitle", "time": 15221.75, "timestamp": "04:13:41", "text": "渦巻いている。大丈夫ですか？はい、"}, {"type": "subtitle", "time": 15224.07, "timestamp": "04:13:44", "text": "お客様。元気です。"}, {"type": "subtitle", "time": 15226.149, "timestamp": "04:13:46", "text": "床が"}, {"type": "subtitle", "time": 15227.99, "timestamp": "04:13:47", "text": "変化。"}, {"type": "subtitle", "time": 15229.67, "timestamp": "04:13:49", "text": "像。"}, {"type": "subtitle", "time": 15232.229, "timestamp": "04:13:52", "text": "どの像のことですか？"}, {"type": "subtitle", "time": 15234.87, "timestamp": "04:13:54", "text": "何らかの像が見えますが、"}, {"type": "subtitle", "time": 15238.389, "timestamp": "04:13:58", "text": "床に映る反射。"}, {"type": "subtitle", "time": 15239.91, "timestamp": "04:13:59", "text": "ローレリア、"}]
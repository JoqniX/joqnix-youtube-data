[{"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "午後の眠りの感覚を描いた絵。"}, {"type": "subtitle", "time": 8417.349, "timestamp": "02:20:17", "text": "眠っている。"}, {"type": "subtitle", "time": 8419.91, "timestamp": "02:20:19", "text": "大丈夫。"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "頭が飛び出しそうな気がする。それ"}, {"type": "subtitle", "time": 8426.95, "timestamp": "02:20:26", "text": "まるで体が飛び出しそうな感じ。"}, {"type": "subtitle", "time": 8449.35, "timestamp": "02:20:49", "text": "この後も休養を取るべきだ。"}, {"type": "subtitle", "time": 8459.51, "timestamp": "02:20:59", "text": "ええと、でも具体的には指定しませんでした。それはすべてただ"}]
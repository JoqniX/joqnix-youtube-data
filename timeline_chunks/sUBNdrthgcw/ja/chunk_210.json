[{"type": "subtitle", "time": 12600.63, "timestamp": "03:30:00", "text": "色だよ、男？本当は良くなったよ。あなたは"}, {"type": "subtitle", "time": 12605.429, "timestamp": "03:30:05", "text": "了解です。俺に出て行けってことか？わかった、"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "それから。えっと、"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "しかし、品質は低い。見えない。"}, {"type": "subtitle", "time": 12614.07, "timestamp": "03:30:14", "text": "それを変更する方法はありますか？私はできません。"}, {"type": "subtitle", "time": 12616.55, "timestamp": "03:30:16", "text": "右。"}, {"type": "subtitle", "time": 12618.71, "timestamp": "03:30:18", "text": "私はできません。わかった。私たちは苦しむ必要はない"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "これで。大丈夫です。それで、えーと、どれが合うかな"}, {"type": "subtitle", "time": 12631.429, "timestamp": "03:30:31", "text": "ジョックに合うのはどれ？"}, {"type": "subtitle", "time": 12635.11, "timestamp": "03:30:35", "text": "混乱しています。"}, {"type": "subtitle", "time": 12636.87, "timestamp": "03:30:36", "text": "もう一度、自分の見た目をどう表現すればいいですか？待って、私は"}, {"type": "subtitle", "time": 12640.229, "timestamp": "03:30:40", "text": "私のキャラクターの参考資料。待って。"}, {"type": "subtitle", "time": 12650.229, "timestamp": "03:30:50", "text": "待って、どれが私なの？ ああ、これは"}, {"type": "subtitle", "time": 12651.83, "timestamp": "03:30:51", "text": "奇数。"}, {"type": "subtitle", "time": 12654.03, "timestamp": "03:30:54", "text": "これは奇妙だ。えっと"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "[音楽]"}, {"type": "subtitle", "time": 12658.95, "timestamp": "03:30:58", "text": "ああ、これは、ああ、これは"}]
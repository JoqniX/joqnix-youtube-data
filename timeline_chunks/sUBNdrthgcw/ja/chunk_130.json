[{"type": "subtitle", "time": 7801.03, "timestamp": "02:10:01", "text": "誰かがチャットオーダー3に入力したように"}, {"type": "subtitle", "time": 7803.189, "timestamp": "02:10:03", "text": "それは可能です。私は以前はそれを"}, {"type": "subtitle", "time": 7804.87, "timestamp": "02:10:04", "text": "それ"}, {"type": "subtitle", "time": 7806.629, "timestamp": "02:10:06", "text": "えっと"}, {"type": "subtitle", "time": 7808.55, "timestamp": "02:10:08", "text": "最近の噂話とか、そういうことですよね？それで"}, {"type": "subtitle", "time": 7811.03, "timestamp": "02:10:11", "text": "例えば、もしあなたが今あなたが"}, {"type": "subtitle", "time": 7813.27, "timestamp": "02:10:13", "text": "あれが最後のタイプの雑談だったんですよね？それで"}, {"type": "subtitle", "time": 7816.229, "timestamp": "02:10:16", "text": "他の人があなたの画像を見たときに、あなたの画像が表示されます"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "誰かが入力すると、その画像は"}, {"type": "subtitle", "time": 7821.109, "timestamp": "02:10:21", "text": "表示されています。ヘッドパッドのこと覚えてる？"}, {"type": "subtitle", "time": 7824.55, "timestamp": "02:10:24", "text": "私も同じ経験をしました。いいえ、でもわかりません"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "どうすれば好きになれるか、私ができる一つの方法"}, {"type": "subtitle", "time": 7830.229, "timestamp": "02:10:30", "text": "感嘆符か何かのようなもの"}, {"type": "subtitle", "time": 7832.629, "timestamp": "02:10:32", "text": "何らかのコマンドを実行して、これらの人々を追加する"}, {"type": "subtitle", "time": 7835.669, "timestamp": "02:10:35", "text": "そして、それらの画像がグループや何かに写っている"}, {"type": "subtitle", "time": 7838.79, "timestamp": "02:10:38", "text": "そして、そうやって手に入れるのです。"}, {"type": "subtitle", "time": 7841.43, "timestamp": "02:10:41", "text": "ええ、それにはこの方法も含まれます。もし"}, {"type": "subtitle", "time": 7843.51, "timestamp": "02:10:43", "text": "私はそれができるし、これもできる"}, {"type": "subtitle", "time": 7846.629, "timestamp": "02:10:46", "text": "この方法も機能しますか"}, {"type": "subtitle", "time": 7849.91, "timestamp": "02:10:49", "text": "人のアバターや装飾品のようなもの"}, {"type": "subtitle", "time": 7852.629, "timestamp": "02:10:52", "text": "彼らは選んだ。だからコピー＆ペーストすればいいんです"}, {"type": "subtitle", "time": 7854.149, "timestamp": "02:10:54", "text": "オーナメント"}, {"type": "subtitle", "time": 7856.31, "timestamp": "02:10:56", "text": "ドラッグアンドドロップ"}, {"type": "subtitle", "time": 7858.709, "timestamp": "02:10:58", "text": "全てを投入するのではなく"}]
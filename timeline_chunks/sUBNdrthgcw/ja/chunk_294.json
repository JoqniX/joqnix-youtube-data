[{"type": "subtitle", "time": 17640.15, "timestamp": "04:54:00", "text": "闇に対するお守りと防御の両方"}, {"type": "subtitle", "time": 17642.948, "timestamp": "04:54:02", "text": "今日は美術の授業です。そして私は"}, {"type": "subtitle", "time": 17645.27, "timestamp": "04:54:05", "text": "確かに、ホグミーに着いたらすぐに"}, {"type": "subtitle", "time": 17647.19, "timestamp": "04:54:07", "text": "消耗品を交換することが可能です"}, {"type": "subtitle", "time": 17652.708, "timestamp": "04:54:12", "text": "チャーム号のクラスに乗船した私。私は何をするだろうか"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "呪文学の授業で学ぶ？まさにあなたが"}, {"type": "subtitle", "time": 17658.39, "timestamp": "04:54:18", "text": "予想するかもしれない。呪文、お守り、呪い、"}, {"type": "subtitle", "time": 17660.868, "timestamp": "04:54:20", "text": "どれも非常に役に立つ。きっとそう思うよ"}, {"type": "subtitle", "time": 17663.91, "timestamp": "04:54:23", "text": "ロニン教授をお楽しみください。彼は賢くて"}, {"type": "subtitle", "time": 17666.39, "timestamp": "04:54:26", "text": "人を楽しませる魔法使い。そして才能ある"}, {"type": "subtitle", "time": 17667.54, "timestamp": "04:54:27", "text": "教師。"}, {"type": "subtitle", "time": 17669.19, "timestamp": "04:54:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17670.868, "timestamp": "04:54:30", "text": "防御についてもっと詳しく教えていただけますか？"}, {"type": "subtitle", "time": 17672.868, "timestamp": "04:54:32", "text": "闇の魔術に反対する授業？防衛"}, {"type": "subtitle", "time": 17674.47, "timestamp": "04:54:34", "text": "闇の魔術に反対する、その名が示すように"}, {"type": "subtitle", "time": 17676.948, "timestamp": "04:54:36", "text": "防御方法に焦点を当てる"}, {"type": "subtitle", "time": 17679.67, "timestamp": "04:54:39", "text": "潜む悪と戦う"}, {"type": "subtitle", "time": 17682.868, "timestamp": "04:54:42", "text": "この壁の向こう側。防御の達人"}, {"type": "subtitle", "time": 17685.19, "timestamp": "04:54:45", "text": "闇の魔術に対抗するには"}, {"type": "subtitle", "time": 17689.51, "timestamp": "04:54:49", "text": "幸運にも"}, {"type": "subtitle", "time": 17691.51, "timestamp": "04:54:51", "text": "才能あふれる教授に恵まれて幸運です"}, {"type": "subtitle", "time": 17693.35, "timestamp": "04:54:53", "text": "ヘッカートが学生たちの担当"}, {"type": "subtitle", "time": 17695.75, "timestamp": "04:54:55", "text": "その点における教育。"}, {"type": "subtitle", "time": 17698.23, "timestamp": "04:54:58", "text": "わかった。ホグスミーって何？あなたは"}]
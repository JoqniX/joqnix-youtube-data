[{"type": "subtitle", "time": 7447.27, "timestamp": "02:04:07", "text": "つまり、今それを置こうとしているんです。それで"}, {"type": "subtitle", "time": 7450.95, "timestamp": "02:04:10", "text": "大丈夫です。クラッシュしたら、"}, {"type": "subtitle", "time": 7459.91, "timestamp": "02:04:19", "text": "ああ、神様。以上です。"}, {"type": "subtitle", "time": 7463.669, "timestamp": "02:04:23", "text": "ブロナを手に入れた。おお、いいね、いいね、いいね。"}, {"type": "subtitle", "time": 7466.07, "timestamp": "02:04:26", "text": "あなたはまだスターをプレイしていますね。なんてこった。えっと、"}, {"type": "subtitle", "time": 7476.2, "timestamp": "02:04:36", "text": "ああ、頭がすごく痛い。"}, {"type": "subtitle", "time": 7479.51, "timestamp": "02:04:39", "text": "[音楽]"}, {"type": "subtitle", "time": 7483.03, "timestamp": "02:04:43", "text": "君に一体何があったんだ？"}, {"type": "subtitle", "time": 7487.669, "timestamp": "02:04:47", "text": "ああ、またNDIか。私はそれが嫌いです。"}, {"type": "subtitle", "time": 7491.43, "timestamp": "02:04:51", "text": "あなたが嫌い​​です。"}, {"type": "subtitle", "time": 7493.83, "timestamp": "02:04:53", "text": "待って、なぜ食べているの？"}, {"type": "subtitle", "time": 7496.709, "timestamp": "02:04:56", "text": "134.5?"}]
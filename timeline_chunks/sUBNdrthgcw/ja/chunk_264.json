[{"type": "subtitle", "time": 15845.75, "timestamp": "04:24:05", "text": "私の言った通りだった。ええと、ラムロック。"}, {"type": "subtitle", "time": 15850.229, "timestamp": "04:24:10", "text": "どうやら私の評判は既に広まっているようだ。私は"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "誰も行かないんじゃないかと思い始めている"}, {"type": "subtitle", "time": 15854.87, "timestamp": "04:24:14", "text": "ラコムスを訪れる。その人物は誰ですか？そして"}, {"type": "subtitle", "time": 15857.99, "timestamp": "04:24:17", "text": "あなたはなぜここにいるのですか？"}, {"type": "subtitle", "time": 15861.83, "timestamp": "04:24:21", "text": "そんな必要はありません。何でもいいからくれ"}, {"type": "subtitle", "time": 15863.99, "timestamp": "04:24:23", "text": "ここはあなたです、そして私たちは"}, {"type": "subtitle", "time": 15872.229, "timestamp": "04:24:32", "text": "お客様、"}, {"type": "subtitle", "time": 15876.229, "timestamp": "04:24:36", "text": "彼らは金庫の鍵を持っている。"}, {"type": "subtitle", "time": 15881.03, "timestamp": "04:24:41", "text": "次に使う言葉は慎重に選びましょう。私はただ"}, {"type": "subtitle", "time": 15884.149, "timestamp": "04:24:44", "text": "それは、Vault 12の指示書が"}, {"type": "subtitle", "time": 15887.429, "timestamp": "04:24:47", "text": "非常に明確だった。"}, {"type": "subtitle", "time": 15890.469, "timestamp": "04:24:50", "text": "閣下、私はどうしても譲れません。私は許可することになっていた"}, {"type": "subtitle", "time": 15892.87, "timestamp": "04:24:52", "text": "キーを持っている人だけがアクセスでき、"}, {"type": "subtitle", "time": 15896.149, "timestamp": "04:24:56", "text": "持っていなかった。"}]
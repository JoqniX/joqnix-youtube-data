[{"type": "subtitle", "time": 7923.75, "timestamp": "02:12:03", "text": "ユーザーは画像を選択できる"}, {"type": "subtitle", "time": 7926.709, "timestamp": "02:12:06", "text": "彼ら自身のYouTubeやTwitch、あるいは"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "カスタム画像をアップロードするなど"}, {"type": "subtitle", "time": 7933.27, "timestamp": "02:12:13", "text": "何かの上に置けば、えっと"}, {"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "それにアクセスして、画像を取得しました"}, {"type": "subtitle", "time": 7941.109, "timestamp": "02:12:21", "text": "彼らはそれを望んでいて私はそれを"}, {"type": "subtitle", "time": 7944.069, "timestamp": "02:12:24", "text": "えーっと、何か何か"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "それは私が考えたアイデアの一つでした。"}, {"type": "subtitle", "time": 7951.83, "timestamp": "02:12:31", "text": "うん。しかし、そのアイデアがうまくいくかどうかは"}, {"type": "subtitle", "time": 7954.39, "timestamp": "02:12:34", "text": "えーっと、あの、私が"}, {"type": "subtitle", "time": 7956.709, "timestamp": "02:12:36", "text": "コミュニティウェブサイトについて話しました"}, {"type": "subtitle", "time": 7960.79, "timestamp": "02:12:40", "text": "つまり、それは基本的にあなたが見せることを可能にする"}, {"type": "subtitle", "time": 7963.35, "timestamp": "02:12:43", "text": "接続する"}, {"type": "subtitle", "time": 7965.43, "timestamp": "02:12:45", "text": "YouTubeアカウントとTwitchアカウント"}, {"type": "subtitle", "time": 7968.39, "timestamp": "02:12:48", "text": "そうすればアバターにアクセスでき、"}, {"type": "subtitle", "time": 7971.43, "timestamp": "02:12:51", "text": "今はそれが必要だと読める"}, {"type": "subtitle", "time": 7973.91, "timestamp": "02:12:53", "text": "会員資格のSCチェックなど"}, {"type": "subtitle", "time": 7978.39, "timestamp": "02:12:58", "text": "ユーザーがアクティブなユーザーである場合"}]
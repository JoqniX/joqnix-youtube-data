[{"type": "subtitle", "time": 17523.03, "timestamp": "04:52:03", "text": "これは何ですか？ああ、いいタイミングだ。完璧"}, {"type": "subtitle", "time": 17525.11, "timestamp": "04:52:05", "text": "青の使い方をお見せする機会"}, {"type": "subtitle", "time": 17528.07, "timestamp": "04:52:08", "text": "炎を使ってもう少し速く移動する。あなたの"}, {"type": "subtitle", "time": 17529.83, "timestamp": "04:52:09", "text": "フィールドガイドには、"}, {"type": "subtitle", "time": 17532.628, "timestamp": "04:52:12", "text": "城。開けて中央を見つける"}, {"type": "subtitle", "time": 17535.03, "timestamp": "04:52:15", "text": "ホール。"}, {"type": "subtitle", "time": 17542.788, "timestamp": "04:52:22", "text": "ホグワーツは大きく2つのエリアに分かれている。"}, {"type": "subtitle", "time": 17544.23, "timestamp": "04:52:24", "text": "問題の左側は"}, {"type": "subtitle", "time": 17546.07, "timestamp": "04:52:26", "text": "学生と教授が住んでいる。それ"}, {"type": "subtitle", "time": 17548.15, "timestamp": "04:52:28", "text": "家を含む"}, {"type": "subtitle", "time": 17551.11, "timestamp": "04:52:31", "text": "談話室と大広間。わかった。"}, {"type": "subtitle", "time": 17553.51, "timestamp": "04:52:33", "text": "さあ、壮大な階段を上って先へ進みましょう"}, {"type": "subtitle", "time": 17555.27, "timestamp": "04:52:35", "text": "これです。"}, {"type": "subtitle", "time": 17556.788, "timestamp": "04:52:36", "text": "そこは炎の流れが見える場所です"}, {"type": "subtitle", "time": 17559.35, "timestamp": "04:52:39", "text": "その地域で利用可能です。グリーンフロー"}, {"type": "subtitle", "time": 17560.708, "timestamp": "04:52:40", "text": "飛行機はあなたが発見したことを表しています"}, {"type": "subtitle", "time": 17562.31, "timestamp": "04:52:42", "text": "自分の家と共有スペースを含む"}, {"type": "subtitle", "time": 17564.47, "timestamp": "04:52:44", "text": "部屋。"}, {"type": "subtitle", "time": 17566.55, "timestamp": "04:52:46", "text": "場所を明らかにする"}, {"type": "subtitle", "time": 17574.868, "timestamp": "04:52:54", "text": "次は図書館へ。"}, {"type": "subtitle", "time": 17578.628, "timestamp": "04:52:58", "text": "炎の中心を解き放ちましょう"}]
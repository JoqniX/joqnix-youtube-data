[{"type": "subtitle", "time": 4921.11, "timestamp": "01:22:01", "text": "兄弟。文字通り墜落した。何"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "えっ？ああ、ヴァレリンを閉じさせてください。なぜ私は"}, {"type": "subtitle", "time": 4933.27, "timestamp": "01:22:13", "text": "ああ、神様、助かりました。ああ、ありがとうございます。"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "私は本当に泣きました。それはいいです、"}, {"type": "subtitle", "time": 4957.35, "timestamp": "01:22:37", "text": "なんてこった。我々は今、ある状況に直面している。"}, {"type": "subtitle", "time": 4960.87, "timestamp": "01:22:40", "text": "なんてこった。いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 4963.51, "timestamp": "01:22:43", "text": "待って、私は、もっと良いのは"}, {"type": "subtitle", "time": 4969.189, "timestamp": "01:22:49", "text": "これならズームインできると思う"}, {"type": "subtitle", "time": 4975.75, "timestamp": "01:22:55", "text": "120で十分でしょう。うん。うん。うん。"}, {"type": "subtitle", "time": 4977.43, "timestamp": "01:22:57", "text": "これで直りました。うん。うん。うん。良い。"}]
[{"type": "subtitle", "time": 18241.43, "timestamp": "05:04:01", "text": "私よりも運がいい。"}, {"type": "subtitle", "time": 18243.43, "timestamp": "05:04:03", "text": "こんにちは。だから、彼女はこう言っていると思う"}, {"type": "subtitle", "time": 18244.868, "timestamp": "05:04:04", "text": "この絵のことですよね？偶然に"}, {"type": "subtitle", "time": 18246.55, "timestamp": "05:04:06", "text": "何か啓発的な解決策"}, {"type": "subtitle", "time": 18248.47, "timestamp": "05:04:08", "text": "ミステリー。これが彼女の絵です"}, {"type": "subtitle", "time": 18251.11, "timestamp": "05:04:11", "text": "話していたこと。"}, {"type": "subtitle", "time": 18253.91, "timestamp": "05:04:13", "text": "あの場所は手がかりに違いない。見るべき"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "近くにあるかもしれないので、周囲を見渡してください。"}, {"type": "subtitle", "time": 18259.51, "timestamp": "05:04:19", "text": "わかった。それは、"}, {"type": "subtitle", "time": 18268.708, "timestamp": "05:04:28", "text": "[音楽]"}, {"type": "subtitle", "time": 18270.47, "timestamp": "05:04:30", "text": "これは、"}, {"type": "subtitle", "time": 18272.31, "timestamp": "05:04:32", "text": "絵画。あなたを元の場所に戻しましょう"}, {"type": "subtitle", "time": 18276.31, "timestamp": "05:04:36", "text": "枠、小さな蛾。おお。"}, {"type": "subtitle", "time": 18287.83, "timestamp": "05:04:47", "text": "何か繋がりがあるのは分かっていた。そうするべきです。"}, {"type": "subtitle", "time": 18289.67, "timestamp": "05:04:49", "text": "私はそのパズルを解いたと伝えてください"}, {"type": "subtitle", "time": 18291.19, "timestamp": "05:04:51", "text": "空のフレーム。"}, {"type": "subtitle", "time": 18292.788, "timestamp": "05:04:52", "text": "おお。"}]
[{"type": "subtitle", "time": 19441.03, "timestamp": "05:24:01", "text": "4年生になる直前。私の母"}, {"type": "subtitle", "time": 19442.948, "timestamp": "05:24:02", "text": "占いを教えるオファーを受けた"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "ここ。気づけば私たちは出発していた"}, {"type": "subtitle", "time": 19448.15, "timestamp": "05:24:08", "text": "ウガンダから地球の反対側まで"}, {"type": "subtitle", "time": 19455.11, "timestamp": "05:24:15", "text": "おお。"}, {"type": "subtitle", "time": 19458.15, "timestamp": "05:24:18", "text": "ホグワーツよりずっと大きかったのはなぜですか？"}, {"type": "subtitle", "time": 19460.788, "timestamp": "05:24:20", "text": "ワガドゥ魔法学校は最大規模です"}, {"type": "subtitle", "time": 19462.788, "timestamp": "05:24:22", "text": "魔法学校。"}, {"type": "subtitle", "time": 19464.788, "timestamp": "05:24:24", "text": "どういう意味ですか？でも、私が勝ったんです。大きい"}, {"type": "subtitle", "time": 19467.11, "timestamp": "05:24:27", "text": "ホグワーツよりも、"}, {"type": "subtitle", "time": 19469.91, "timestamp": "05:24:29", "text": "私にとっては威圧的、あるいは圧倒されるようなものだ。それ"}, {"type": "subtitle", "time": 19472.39, "timestamp": "05:24:32", "text": "いつも我が家のように感じられた。"}, {"type": "subtitle", "time": 19475.51, "timestamp": "05:24:35", "text": "えっと、あれは何ですか？城とはどういう意味ですか"}, {"type": "subtitle", "time": 19478.07, "timestamp": "05:24:38", "text": "ホグワーツみたい？その住所は山々です"}, {"type": "subtitle", "time": 19480.948, "timestamp": "05:24:40", "text": "月の。それは城というよりは"}, {"type": "subtitle", "time": 19483.59, "timestamp": "05:24:43", "text": "美しい建造物として"}]
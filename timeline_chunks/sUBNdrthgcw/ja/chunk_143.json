[{"type": "subtitle", "time": 8583.83, "timestamp": "02:23:03", "text": "私は本になってもいいですか？"}, {"type": "subtitle", "time": 8587.19, "timestamp": "02:23:07", "text": "よし、ヴィックは14を欲しがっていた。14って何？私は"}, {"type": "subtitle", "time": 8595.349, "timestamp": "02:23:15", "text": "はい、そうしました。わかった。ニース。ニース。ニース。"}, {"type": "subtitle", "time": 8596.87, "timestamp": "02:23:16", "text": "良い。良い。すべて順調です。すべて順調です。全て"}, {"type": "subtitle", "time": 8599.27, "timestamp": "02:23:19", "text": "良い。"}, {"type": "subtitle", "time": 8602.15, "timestamp": "02:23:22", "text": "ビング・ドッグ"}, {"type": "subtitle", "time": 8604.71, "timestamp": "02:23:24", "text": "えーと"}, {"type": "subtitle", "time": 8607.75, "timestamp": "02:23:27", "text": "グループと"}, {"type": "subtitle", "time": 8617.19, "timestamp": "02:23:37", "text": "はい、全員揃いました。"}, {"type": "subtitle", "time": 8618.95, "timestamp": "02:23:38", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8621.59, "timestamp": "02:23:41", "text": "わかった、ちょっと顔を洗って、"}, {"type": "subtitle", "time": 8624.469, "timestamp": "02:23:44", "text": "また戻ってきます。わかった。えっと、ちょっとだけ"}, {"type": "subtitle", "time": 8632.469, "timestamp": "02:23:52", "text": "ええと、もしかしたらできるかもしれません。ああ、そうですね。私が来るまで"}, {"type": "subtitle", "time": 8635.03, "timestamp": "02:23:55", "text": "戻って、私は虚無のように置きます。見てて"}, {"type": "subtitle", "time": 8636.71, "timestamp": "02:23:56", "text": "水。わかった、すぐ戻るよ"}]
[{"type": "subtitle", "time": 19206.07, "timestamp": "05:20:06", "text": "いや、いや。集中しろ。さぁ行こう。ああ、なんてことだ。"}, {"type": "subtitle", "time": 19208.94, "timestamp": "05:20:08", "text": "それは私のボールです。"}, {"type": "subtitle", "time": 19211.19, "timestamp": "05:20:11", "text": "[音楽]"}, {"type": "subtitle", "time": 19213.43, "timestamp": "05:20:13", "text": "待って、再起動してもいいですか？再起動してもいいですか？"}, {"type": "subtitle", "time": 19215.11, "timestamp": "05:20:15", "text": "こんにちは。"}, {"type": "subtitle", "time": 19216.948, "timestamp": "05:20:16", "text": "私はこれを赤くしたい。お願いします。欲しい"}, {"type": "subtitle", "time": 19220.868, "timestamp": "05:20:20", "text": "再起動する。お願いします。お願いです。私は"}, {"type": "subtitle", "time": 19224.59, "timestamp": "05:20:24", "text": "ゲームを終了してもいいですか？"}, {"type": "subtitle", "time": 19229.59, "timestamp": "05:20:29", "text": "待って。閉じてもいいですか？私はそうすべきだった"}, {"type": "subtitle", "time": 19248.07, "timestamp": "05:20:48", "text": "おやすみ。"}, {"type": "subtitle", "time": 19250.15, "timestamp": "05:20:50", "text": "H. わかった、いいよ。私は不正行為はしません。わかった、"}]
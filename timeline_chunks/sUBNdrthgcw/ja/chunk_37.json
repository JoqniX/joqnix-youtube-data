[{"type": "subtitle", "time": 2231.19, "timestamp": "00:37:11", "text": "よし、動き出したぞ。うん。うん。わかった。"}, {"type": "subtitle", "time": 2233.829, "timestamp": "00:37:13", "text": "それでは、クリスマスの3つのイベントを始めましょう。"}, {"type": "subtitle", "time": 2237.349, "timestamp": "00:37:17", "text": "もの。では、準備を始めよう"}, {"type": "subtitle", "time": 2243.99, "timestamp": "00:37:23", "text": "全て準備を整えている。わかった。その後"}, {"type": "subtitle", "time": 2245.43, "timestamp": "00:37:25", "text": "ああ、準備を始めよう"}, {"type": "subtitle", "time": 2252.23, "timestamp": "00:37:32", "text": "ママ、"}, {"type": "subtitle", "time": 2261.349, "timestamp": "00:37:41", "text": "一人称"}, {"type": "subtitle", "time": 2263.67, "timestamp": "00:37:43", "text": "ジョークのライブチャットリマインダー機能で"}, {"type": "subtitle", "time": 2265.67, "timestamp": "00:37:45", "text": "だった"}, {"type": "subtitle", "time": 2268.55, "timestamp": "00:37:48", "text": "忍者が望んでいた"}, {"type": "subtitle", "time": 2270.95, "timestamp": "00:37:50", "text": "7だと思います。はい、7番目です。さあ行こう"}, {"type": "subtitle", "time": 2273.03, "timestamp": "00:37:53", "text": "7つで。"}]
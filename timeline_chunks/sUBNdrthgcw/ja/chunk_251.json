[{"type": "subtitle", "time": 15062.389, "timestamp": "04:11:02", "text": "幸運を祈ります。教授、"}, {"type": "subtitle", "time": 15065.349, "timestamp": "04:11:05", "text": "それは確かに予想外だった。"}, {"type": "subtitle", "time": 15067.99, "timestamp": "04:11:07", "text": "何てことだ。ちょっと考えさせてください。"}, {"type": "subtitle", "time": 15071.83, "timestamp": "04:11:11", "text": "ここには何かあるはずだ。"}, {"type": "subtitle", "time": 15076.07, "timestamp": "04:11:16", "text": "レベリアかもしれない。レベリア？はい。 A"}, {"type": "subtitle", "time": 15078.63, "timestamp": "04:11:18", "text": "魅力を露わにする。絶好の機会"}, {"type": "subtitle", "time": 15081.269, "timestamp": "04:11:21", "text": "現在。何が欠けているのか見てみましょう。"}, {"type": "subtitle", "time": 15084.55, "timestamp": "04:11:24", "text": "しましょうか？杖を構えて、集中せよ。"}, {"type": "subtitle", "time": 15088.389, "timestamp": "04:11:28", "text": "待って。これで杖を安定させましょう。ガイド"}, {"type": "subtitle", "time": 15090.309, "timestamp": "04:11:30", "text": "シンボルパスに沿って学習します"}, {"type": "subtitle", "time": 15102.389, "timestamp": "04:11:42", "text": "私はほとんど"}, {"type": "subtitle", "time": 15108.309, "timestamp": "04:11:48", "text": "現在地"}, {"type": "subtitle", "time": 15111.269, "timestamp": "04:11:51", "text": "そこには。私は何かを見た。少し動いてみてください"}]
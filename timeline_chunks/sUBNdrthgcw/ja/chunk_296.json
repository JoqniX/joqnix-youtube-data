[{"type": "subtitle", "time": 17762.948, "timestamp": "04:56:02", "text": "途中で少し遠回りしました"}, {"type": "subtitle", "time": 17766.708, "timestamp": "04:56:06", "text": "ここ。結局、遺跡を探検することになった。そして"}, {"type": "subtitle", "time": 17770.15, "timestamp": "04:56:10", "text": "これ以上は言わない方がいいだろう。遺跡を探検する？"}, {"type": "subtitle", "time": 17773.27, "timestamp": "04:56:13", "text": "まあ、フィグ教授は"}, {"type": "subtitle", "time": 17775.03, "timestamp": "04:56:15", "text": "詳細を伏せておく理由"}, {"type": "subtitle", "time": 17778.47, "timestamp": "04:56:18", "text": "今のところは彼自身でいる。うん。こんにちは。えっと、話して"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "悪魔の。フィグ教授、あなたの耳"}, {"type": "subtitle", "time": 17785.19, "timestamp": "04:56:25", "text": "燃えていたに違いない。ああ、そうだね。あなた"}, {"type": "subtitle", "time": 17787.11, "timestamp": "04:56:27", "text": "新しい5年目が私たちに提供されたようです"}, {"type": "subtitle", "time": 17789.51, "timestamp": "04:56:29", "text": "基礎をしっかりと身につけて"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "呪文詠唱。"}, {"type": "subtitle", "time": 17793.03, "timestamp": "04:56:33", "text": "ああ、残念ながら全部は受け取れません"}, {"type": "subtitle", "time": 17795.43, "timestamp": "04:56:35", "text": "教授、その点は評価に値します。彼らは"}, {"type": "subtitle", "time": 17799.35, "timestamp": "04:56:39", "text": "どうやら、魔法に対する稀有な才能を持っているようだ。ハッピー"}, {"type": "subtitle", "time": 17803.51, "timestamp": "04:56:43", "text": "に。ところで、あなたは元気ですか？お二人とも到着しました"}, {"type": "subtitle", "time": 17805.43, "timestamp": "04:56:45", "text": "完全に良好なボートと馬車"}, {"type": "subtitle", "time": 17807.51, "timestamp": "04:56:47", "text": "ホグワーツ。そしてあなたは飛行機に乗ることを選びました"}, {"type": "subtitle", "time": 17810.47, "timestamp": "04:56:50", "text": "ドラゴンの道。私は選んだとは言えません"}, {"type": "subtitle", "time": 17813.19, "timestamp": "04:56:53", "text": "ドラゴンの道ですね、教授。それよりも"}, {"type": "subtitle", "time": 17814.948, "timestamp": "04:56:54", "text": "残念ながら、"}, {"type": "subtitle", "time": 17819.19, "timestamp": "04:56:59", "text": "私たちを選んでくれた。非常によく。おしゃべりはもう十分だ。私"}]
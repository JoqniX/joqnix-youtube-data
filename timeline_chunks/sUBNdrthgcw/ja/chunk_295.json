[{"type": "subtitle", "time": 17701.43, "timestamp": "04:55:01", "text": "ホグスミー教授。ホグズミーは唯一の"}, {"type": "subtitle", "time": 17703.59, "timestamp": "04:55:03", "text": "イギリスにある魔法使いの村はすべて"}, {"type": "subtitle", "time": 17706.39, "timestamp": "04:55:06", "text": "数多くの商店やパブが軒を連ねる場所。あなた"}, {"type": "subtitle", "time": 17708.23, "timestamp": "04:55:08", "text": "学校のすべてを見つけることができるはずです"}, {"type": "subtitle", "time": 17711.35, "timestamp": "04:55:11", "text": "ホグズミーで必要な物資。あなたはするであろう"}, {"type": "subtitle", "time": 17713.99, "timestamp": "04:55:13", "text": "また、バタービールもたくさん楽しんでいると思います。"}, {"type": "subtitle", "time": 17717.27, "timestamp": "04:55:17", "text": "いずれ友人たちとそこへ行くことになるだろう。"}, {"type": "subtitle", "time": 17720.07, "timestamp": "04:55:20", "text": "わかった。バタービールとは何ですか？"}, {"type": "subtitle", "time": 17722.07, "timestamp": "04:55:22", "text": "ウィーズリー教授、ありがとうございます。たくさん"}, {"type": "subtitle", "time": 17724.868, "timestamp": "04:55:24", "text": "初日に吸収して、"}, {"type": "subtitle", "time": 17727.91, "timestamp": "04:55:27", "text": "学ぶべきことはたくさんある。ペッパーリー、あなたの教授たち"}, {"type": "subtitle", "time": 17729.83, "timestamp": "04:55:29", "text": "追加を作成することに同意した"}, {"type": "subtitle", "time": 17732.15, "timestamp": "04:55:32", "text": "授業外での課題です。"}, {"type": "subtitle", "time": 17734.23, "timestamp": "04:55:34", "text": "すぐに慣れるでしょう。"}, {"type": "subtitle", "time": 17736.47, "timestamp": "04:55:36", "text": "Revelioを巧みに使いこなしているのを見ると、"}, {"type": "subtitle", "time": 17739.03, "timestamp": "04:55:39", "text": "以前は、フィグ教授は成功したと言えるでしょう"}, {"type": "subtitle", "time": 17741.59, "timestamp": "04:55:41", "text": "少なくとも基本をお見せします。彼"}, {"type": "subtitle", "time": 17744.39, "timestamp": "04:55:44", "text": "はい、教授。彼はひどく曖昧な態度をとっている。"}, {"type": "subtitle", "time": 17746.868, "timestamp": "04:55:46", "text": "あなたの到着に先立つ出来事に関して、"}, {"type": "subtitle", "time": 17748.868, "timestamp": "04:55:48", "text": "具体的にはその後何が起こったかについて"}, {"type": "subtitle", "time": 17752.07, "timestamp": "04:55:52", "text": "あの恐ろしいドラゴンの襲撃。私の疑念"}, {"type": "subtitle", "time": 17754.15, "timestamp": "04:55:54", "text": "それは、物語にはそれ以上のものがあるということだ。"}, {"type": "subtitle", "time": 17756.07, "timestamp": "04:55:56", "text": "持ち物の捜索と拡張"}]
[{"type": "subtitle", "time": 10980.87, "timestamp": "03:03:00", "text": "来てくれてありがとう。よく勉強して"}, {"type": "subtitle", "time": 10983.269, "timestamp": "03:03:03", "text": "忍者とハッシュ、そしてみんな"}, {"type": "subtitle", "time": 10985.59, "timestamp": "03:03:05", "text": "私を含め、試験を受ける他の人たち"}, {"type": "subtitle", "time": 10987.32, "timestamp": "03:03:07", "text": "幸運を祈ります"}, {"type": "subtitle", "time": 10989.59, "timestamp": "03:03:09", "text": "[音楽]"}, {"type": "subtitle", "time": 10992.71, "timestamp": "03:03:12", "text": "スカイト、本当に本当にありがとう"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "来ています"}, {"type": "subtitle", "time": 11000.63, "timestamp": "03:03:20", "text": "イーサン、来てくれてありがとう。"}, {"type": "subtitle", "time": 11003.03, "timestamp": "03:03:23", "text": "今日を楽しんでください。そしてイーサン、ようこそ"}, {"type": "subtitle", "time": 11006.309, "timestamp": "03:03:26", "text": "最後に、楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 11008.95, "timestamp": "03:03:28", "text": "ここにいてください、来てくれてありがとう"}, {"type": "subtitle", "time": 11010.87, "timestamp": "03:03:30", "text": "立ち寄る"}, {"type": "subtitle", "time": 11013.429, "timestamp": "03:03:33", "text": "今後の配信にもぜひお越しください。"}, {"type": "subtitle", "time": 11015.94, "timestamp": "03:03:35", "text": "良い一日をお過ごしください。"}, {"type": "subtitle", "time": 11018.469, "timestamp": "03:03:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11021.11, "timestamp": "03:03:41", "text": "ああ、そうだ、そうだ、私、あなたはそうは思わない"}, {"type": "subtitle", "time": 11024.389, "timestamp": "03:03:44", "text": "入手したデバイスのいずれかを活用する"}, {"type": "subtitle", "time": 11029.59, "timestamp": "03:03:49", "text": "えっと、いくつか作ってます"}, {"type": "subtitle", "time": 11031.59, "timestamp": "03:03:51", "text": "ただ早く寝る必要があるし"}, {"type": "subtitle", "time": 11034.309, "timestamp": "03:03:54", "text": "寝る必要があるだけ"}, {"type": "subtitle", "time": 11037.75, "timestamp": "03:03:57", "text": "すべて、そうですね、主に1月以降は"}, {"type": "subtitle", "time": 11039.99, "timestamp": "03:03:59", "text": "休憩を取って集中します"}]
[{"type": "subtitle", "time": 9540.15, "timestamp": "02:39:00", "text": "私はただ、もしあるとしたら"}, {"type": "subtitle", "time": 9543.349, "timestamp": "02:39:03", "text": "他に来る人がいたら、それは"}, {"type": "subtitle", "time": 9546.95, "timestamp": "02:39:06", "text": "よりフィットするようになります。私はそれを次のように置きます"}, {"type": "subtitle", "time": 9549.67, "timestamp": "02:39:09", "text": "星の数に応じて、ということですよね？それで、"}, {"type": "subtitle", "time": 9552.389, "timestamp": "02:39:12", "text": "うん、これが今一番だと思う"}, {"type": "subtitle", "time": 9554.71, "timestamp": "02:39:14", "text": "大丈夫。"}, {"type": "subtitle", "time": 9563.67, "timestamp": "02:39:23", "text": "私は推測する。しかし、そのウェブサイトのアイデアは"}, {"type": "subtitle", "time": 9565.75, "timestamp": "02:39:25", "text": "はるかに良い。ダディッシュは必要ない"}, {"type": "subtitle", "time": 9568.79, "timestamp": "02:39:28", "text": "OBSも含め、すべて揃っています。私たちはただ見ているだけでいい"}, {"type": "subtitle", "time": 9572.469, "timestamp": "02:39:32", "text": "他の人たちは自分自身を加え、喜ばせている"}, {"type": "subtitle", "time": 9577.349, "timestamp": "02:39:37", "text": "彼ら自身とウェブサイト自体から"}, {"type": "subtitle", "time": 9579.75, "timestamp": "02:39:39", "text": "そしてそれは人々に限定されるものではない"}, {"type": "subtitle", "time": 9581.59, "timestamp": "02:39:41", "text": "流れにやってくる人たち。いいえ、それは"}, {"type": "subtitle", "time": 9585.19, "timestamp": "02:39:45", "text": "限定されるのは、"}, {"type": "subtitle", "time": 9586.79, "timestamp": "02:39:46", "text": "みんな。"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "見逃しても追加できます"}, {"type": "subtitle", "time": 9592.469, "timestamp": "02:39:52", "text": "あなた自身を装飾品として、コンサートとして"}, {"type": "subtitle", "time": 9594.23, "timestamp": "02:39:54", "text": "皿か何か。ああ、これは"}, {"type": "subtitle", "time": 9597.59, "timestamp": "02:39:57", "text": "私が先ほど述べたようなアイデアです。だから私たちは"}]
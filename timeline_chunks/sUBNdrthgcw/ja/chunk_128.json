[{"type": "subtitle", "time": 7693.589, "timestamp": "02:08:13", "text": "うん、次回は自分で作ってみたいね。これ"}, {"type": "subtitle", "time": 7697.109, "timestamp": "02:08:17", "text": "このプロセスは長すぎる。次回は"}, {"type": "subtitle", "time": 7699.83, "timestamp": "02:08:19", "text": "この全体を何らかの方法で自動化したい"}, {"type": "subtitle", "time": 7703.51, "timestamp": "02:08:23", "text": "設定。次。うん。私のアイデアの一つ"}, {"type": "subtitle", "time": 7707.189, "timestamp": "02:08:27", "text": "先ほど申し上げたように、今日の配信は"}, {"type": "subtitle", "time": 7710.709, "timestamp": "02:08:30", "text": "ええと、ユーザーと"}, {"type": "subtitle", "time": 7713.03, "timestamp": "02:08:33", "text": "チャットは"}, {"type": "subtitle", "time": 7717.109, "timestamp": "02:08:37", "text": "彼らが欲しい飾りを選んでください。それで"}, {"type": "subtitle", "time": 7720.39, "timestamp": "02:08:40", "text": "現時点では、"}, {"type": "subtitle", "time": 7722.229, "timestamp": "02:08:42", "text": "将来は、"}, {"type": "subtitle", "time": 7724.95, "timestamp": "02:08:44", "text": "特注品とか"}, {"type": "subtitle", "time": 7731.109, "timestamp": "02:08:51", "text": "私たちはスターレールをプレイしていたのでしょうか？私"}, {"type": "subtitle", "time": 7734.069, "timestamp": "02:08:54", "text": "まだ"}]
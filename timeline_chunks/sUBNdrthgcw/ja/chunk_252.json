[{"type": "subtitle", "time": 15126.63, "timestamp": "04:12:06", "text": "まあ、まずは第一歩ですね。しかし、"}, {"type": "subtitle", "time": 15129.51, "timestamp": "04:12:09", "text": "再び記号。まさか"}, {"type": "subtitle", "time": 15132.309, "timestamp": "04:12:12", "text": "はい、教授。そのシンボルは"}, {"type": "subtitle", "time": 15133.99, "timestamp": "04:12:13", "text": "私が見たのと同じ輝き"}, {"type": "subtitle", "time": 15136.55, "timestamp": "04:12:16", "text": "ポートキーコンテナ。目に見えるもの"}, {"type": "subtitle", "time": 15139.59, "timestamp": "04:12:19", "text": "前進の道筋を明らかにし、あえて言えば"}, {"type": "subtitle", "time": 15141.75, "timestamp": "04:12:21", "text": "この秘密をこれから発見します"}, {"type": "subtitle", "time": 15144.55, "timestamp": "04:12:24", "text": "金庫。先頭に立って進め。"}, {"type": "subtitle", "time": 15152.63, "timestamp": "04:12:32", "text": "ルモス。"}, {"type": "subtitle", "time": 15155.83, "timestamp": "04:12:35", "text": "ノルモス。これは普通の金庫ではない。私"}, {"type": "subtitle", "time": 15157.67, "timestamp": "04:12:37", "text": "我々は自力で脱出する必要があるだろう"}, {"type": "subtitle", "time": 15159.75, "timestamp": "04:12:39", "text": "ここから。 「自力で稼ぐ」とはどういう意味ですか？"}, {"type": "subtitle", "time": 15162.229, "timestamp": "04:12:42", "text": "外？これは何らかの"}, {"type": "subtitle", "time": 15163.91, "timestamp": "04:12:43", "text": "テスト？"}, {"type": "subtitle", "time": 15167.99, "timestamp": "04:12:47", "text": "私はします。しかし、一体何のために？私は戦えない。"}, {"type": "subtitle", "time": 15170.309, "timestamp": "04:12:50", "text": "さあ行こう。そばにいて。ありません"}, {"type": "subtitle", "time": 15173.03, "timestamp": "04:12:53", "text": "事態が悪化すれば姿を消す。ない"}, {"type": "subtitle", "time": 15175.72, "timestamp": "04:12:55", "text": "グリンコッツから。"}]
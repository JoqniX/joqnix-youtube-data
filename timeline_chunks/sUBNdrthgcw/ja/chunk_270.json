[{"type": "subtitle", "time": 16213.189, "timestamp": "04:30:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16215.99, "timestamp": "04:30:15", "text": "ウィーズリー教授、あと一人"}, {"type": "subtitle", "time": 16219.11, "timestamp": "04:30:19", "text": "整理済み。簡単に。待って、"}, {"type": "subtitle", "time": 16222.229, "timestamp": "04:30:22", "text": "いらっしゃいませ。ちょうどいいタイミングですね。持つ"}, {"type": "subtitle", "time": 16237.59, "timestamp": "04:30:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16241.59, "timestamp": "04:30:41", "text": "ああ、そうですね。他の人たちより少し年上で、"}, {"type": "subtitle", "time": 16243.83, "timestamp": "04:30:43", "text": "あなたもそうでしょう？"}, {"type": "subtitle", "time": 16246.63, "timestamp": "04:30:46", "text": "あなたは好みを持ってここに来ます"}, {"type": "subtitle", "time": 16249.269, "timestamp": "04:30:49", "text": "先入観、"}, {"type": "subtitle", "time": 16251.03, "timestamp": "04:30:51", "text": "ある"}, {"type": "subtitle", "time": 16252.73, "timestamp": "04:30:52", "text": "期待。"}, {"type": "subtitle", "time": 16255.91, "timestamp": "04:30:55", "text": "[音楽]"}, {"type": "subtitle", "time": 16257.83, "timestamp": "04:30:57", "text": "探検するのが待ちきれない。探しています"}]
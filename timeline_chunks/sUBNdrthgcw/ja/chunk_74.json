[{"type": "subtitle", "time": 4441.189, "timestamp": "01:14:01", "text": "神。"}, {"type": "subtitle", "time": 4443.27, "timestamp": "01:14:03", "text": "すごくかっこいい。あと少しだったのに。すごくかっこいい。私は"}, {"type": "subtitle", "time": 4456.709, "timestamp": "01:14:16", "text": "とても強力だ。わかった。とにかく、えっと、やめてください"}, {"type": "subtitle", "time": 4471.51, "timestamp": "01:14:31", "text": "よし、このサイズは完璧だ"}, {"type": "subtitle", "time": 4475.43, "timestamp": "01:14:35", "text": "推測。だからし。"}, {"type": "subtitle", "time": 4480.149, "timestamp": "01:14:40", "text": "コシとデビル、どこにいるの？"}, {"type": "subtitle", "time": 4483.27, "timestamp": "01:14:43", "text": "さあ見て、"}, {"type": "subtitle", "time": 4492.63, "timestamp": "01:14:52", "text": "全部ここに入れてください。完璧。"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "鍵をかけてください。わかった。良い。良い。良い。良い。"}, {"type": "subtitle", "time": 4496.95, "timestamp": "01:14:56", "text": "良い。こんにちは。えっと"}]
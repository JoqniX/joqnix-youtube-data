[{"type": "subtitle", "time": 6965.589, "timestamp": "01:56:05", "text": "うん。うん。私たちが何をしたか覚えているでしょう"}, {"type": "subtitle", "time": 6967.589, "timestamp": "01:56:07", "text": "去年？"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "うん。同じことだ。私たちは全員を"}, {"type": "subtitle", "time": 6976.149, "timestamp": "01:56:16", "text": "クリスマスツリー。"}, {"type": "subtitle", "time": 6979.03, "timestamp": "01:56:19", "text": "自分。それは同じことです。しかし今回は"}, {"type": "subtitle", "time": 6982.47, "timestamp": "01:56:22", "text": "ご覧のとおり、四角形の代わりに"}, {"type": "subtitle", "time": 6986.149, "timestamp": "01:56:26", "text": "画像を見ると、円形です。"}, {"type": "subtitle", "time": 6989.35, "timestamp": "01:56:29", "text": "ええ、新しい新しい方法を思いつきました"}, {"type": "subtitle", "time": 6993.27, "timestamp": "01:56:33", "text": "来年のような将来のために。いいえ、"}, {"type": "subtitle", "time": 6996.47, "timestamp": "01:56:36", "text": "これをどうやるか、いくつか良いアイデアが浮かんだ"}, {"type": "subtitle", "time": 7000.229, "timestamp": "01:56:40", "text": "えーと、装飾品とか。"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "それと、一体何が起こっているの？"}, {"type": "subtitle", "time": 7005.35, "timestamp": "01:56:45", "text": "この男は身動きが取れない。わかった。ねえ、知ってる？"}, {"type": "subtitle", "time": 7010.47, "timestamp": "01:56:50", "text": "何？私は自分がやり終えたと知っているとしましょう。"}]
[{"type": "subtitle", "time": 19021.11, "timestamp": "05:17:01", "text": "基本をしっかり押さえていて、非常に"}, {"type": "subtitle", "time": 19023.59, "timestamp": "05:17:03", "text": "素敵な日ですね、"}, {"type": "subtitle", "time": 19025.91, "timestamp": "05:17:05", "text": "ちょっとした小旅行に出かけよう"}, {"type": "subtitle", "time": 19029.67, "timestamp": "05:17:09", "text": "外に出て新鮮な空気を吸おう。わかった、"}, {"type": "subtitle", "time": 19032.55, "timestamp": "05:17:12", "text": "私の後に続いてください。野外授業に行くのか、それとも"}, {"type": "subtitle", "time": 19037.03, "timestamp": "05:17:17", "text": "何か？街から出る。"}, {"type": "subtitle", "time": 19039.75, "timestamp": "05:17:19", "text": "おお、"}, {"type": "subtitle", "time": 19042.23, "timestamp": "05:17:22", "text": "私自身がたくさんいる。あ、待って。私は疑問に思う。おお、"}, {"type": "subtitle", "time": 19044.55, "timestamp": "05:17:24", "text": "待って。多くの呪文は呪文である。多くのクエスト"}, {"type": "subtitle", "time": 19056.628, "timestamp": "05:17:36", "text": "ああ、外にあるんですね。"}, {"type": "subtitle", "time": 19059.03, "timestamp": "05:17:39", "text": "私はいつも、楽しさは"}, {"type": "subtitle", "time": 19061.03, "timestamp": "05:17:41", "text": "熟練した手さばきで、"}, {"type": "subtitle", "time": 19062.55, "timestamp": "05:17:42", "text": "私たちの中にいるクィディッチ選手は"}, {"type": "subtitle", "time": 19065.19, "timestamp": "05:17:45", "text": "同意する。"}, {"type": "subtitle", "time": 19069.03, "timestamp": "05:17:49", "text": "だから、スポーツをするのが一番いい方法だ"}, {"type": "subtitle", "time": 19072.31, "timestamp": "05:17:52", "text": "私か彼の目が"}]
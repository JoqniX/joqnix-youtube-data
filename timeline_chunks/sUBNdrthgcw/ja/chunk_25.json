[{"type": "subtitle", "time": 1500.39, "timestamp": "00:25:00", "text": "ああ、なんてことだ、彼を挑発してしまった。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 1503.35, "timestamp": "00:25:03", "text": "人生で一度もそんなことをしたことがない。私 私"}, {"type": "subtitle", "time": 1506.39, "timestamp": "00:25:06", "text": "実際に後ろに回ろうと思った"}, {"type": "subtitle", "time": 1508.95, "timestamp": "00:25:08", "text": "そして彼にうんちをさせて、私は待てと思った。"}, {"type": "subtitle", "time": 1511.35, "timestamp": "00:25:11", "text": "餌を撒いたり、"}, {"type": "subtitle", "time": 1519.59, "timestamp": "00:25:19", "text": "くそ。"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "ニース"}, {"type": "subtitle", "time": 1524.789, "timestamp": "00:25:24", "text": "よし、最後にもう1つ、そして"}, {"type": "subtitle", "time": 1530.149, "timestamp": "00:25:30", "text": "[音楽]"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "ああ、悲しいね。私はほしくない"}, {"type": "subtitle", "time": 1537.029, "timestamp": "00:25:37", "text": "正直に言うと、ストリームはしたくない"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "あなた。最悪だよ。実を言うと。"}, {"type": "subtitle", "time": 1543.909, "timestamp": "00:25:43", "text": "ああ、遊んでみたらどう？プレイを続けてください。感じる"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "時期尚早だ。たった3時間です。行くよ"}]
[{"type": "subtitle", "time": 4163.59, "timestamp": "01:09:23", "text": "[音楽]"}, {"type": "subtitle", "time": 4167.349, "timestamp": "01:09:27", "text": "1つを見てください"}, {"type": "subtitle", "time": 4170.75, "timestamp": "01:09:30", "text": "最高のもの。"}, {"type": "subtitle", "time": 4173.829, "timestamp": "01:09:33", "text": "[音楽]"}, {"type": "subtitle", "time": 4176.95, "timestamp": "01:09:36", "text": "何だって？ああ、こんにちは。"}, {"type": "subtitle", "time": 4179.189, "timestamp": "01:09:39", "text": "あのね？それは怖いことだ。"}, {"type": "subtitle", "time": 4180.709, "timestamp": "01:09:40", "text": "あのね？あのね？私は私は"}, {"type": "subtitle", "time": 4183.59, "timestamp": "01:09:43", "text": "こうやってやってください。それは恐ろしい。私はとても"}, {"type": "subtitle", "time": 4186.39, "timestamp": "01:09:46", "text": "ごめん。"}, {"type": "subtitle", "time": 4187.99, "timestamp": "01:09:47", "text": "こうする方が良いでしょう。そしてそれは"}, {"type": "subtitle", "time": 4190.229, "timestamp": "01:09:50", "text": "とても怖い。もし全てを失ったらどうなるだろう？"}, {"type": "subtitle", "time": 4192.309, "timestamp": "01:09:52", "text": "泣いちゃう。文字通り、私は泣きます"}, {"type": "subtitle", "time": 4193.91, "timestamp": "01:09:53", "text": "赤ちゃん。"}, {"type": "subtitle", "time": 4195.59, "timestamp": "01:09:55", "text": "そして"}, {"type": "subtitle", "time": 4197.59, "timestamp": "01:09:57", "text": "そうしてください。"}]
[{"type": "subtitle", "time": 18448.31, "timestamp": "05:07:28", "text": "誓って、あなたが思っているようなことじゃないよ、私の"}, {"type": "subtitle", "time": 18450.708, "timestamp": "05:07:30", "text": "ケルビム。あなたの目はあなたを欺いていた。"}, {"type": "subtitle", "time": 18457.59, "timestamp": "05:07:37", "text": "[音楽]"}, {"type": "subtitle", "time": 18466.868, "timestamp": "05:07:46", "text": "もう一つ見つけた。"}]
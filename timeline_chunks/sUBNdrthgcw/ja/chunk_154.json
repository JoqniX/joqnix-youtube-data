[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "うん、そう考えるとずっといいよ"}, {"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "それについて。色。私は好きです"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "人々が選択できる方法"}, {"type": "subtitle", "time": 9249.27, "timestamp": "02:34:09", "text": "プリセット"}, {"type": "subtitle", "time": 9251.67, "timestamp": "02:34:11", "text": "そして彼らは画像を追加し、"}, {"type": "subtitle", "time": 9254.469, "timestamp": "02:34:14", "text": "ドラッグしたい場所を選択できます"}, {"type": "subtitle", "time": 9257.51, "timestamp": "02:34:17", "text": "そしてクリのクリスマスに身を委ねる"}, {"type": "subtitle", "time": 9262.07, "timestamp": "02:34:22", "text": "私が尋ねるよりも木"}, {"type": "subtitle", "time": 9265.59, "timestamp": "02:34:25", "text": "あなたはどこにいたいですか？とか、そういうことです。それで"}, {"type": "subtitle", "time": 9267.75, "timestamp": "02:34:27", "text": "その考え方はこうだ。あるだろう"}, {"type": "subtitle", "time": 9270.469, "timestamp": "02:34:30", "text": "まるで大きなクリスマスツリーのようだ。あるだろう"}, {"type": "subtitle", "time": 9272.469, "timestamp": "02:34:32", "text": "共謀ボックスのようなもの、あるいは"}, {"type": "subtitle", "time": 9275.349, "timestamp": "02:34:35", "text": "ドラッグして移動できるスペースのようなボックス"}, {"type": "subtitle", "time": 9278.23, "timestamp": "02:34:38", "text": "物体か何かのように落とす"}, {"type": "subtitle", "time": 9281.99, "timestamp": "02:34:41", "text": "あなた自身。ユーザーがドラッグアンドドロップして"}, {"type": "subtitle", "time": 9284.87, "timestamp": "02:34:44", "text": "位置を確認するためにクリックします"}, {"type": "subtitle", "time": 9288.07, "timestamp": "02:34:48", "text": "それらに閉じ込められ、それらに縛り付けられ、"}, {"type": "subtitle", "time": 9293.349, "timestamp": "02:34:53", "text": "右？そして、他の人は"}, {"type": "subtitle", "time": 9296.07, "timestamp": "02:34:56", "text": "あなた自身がそのようにその位置にいる。"}, {"type": "subtitle", "time": 9299.83, "timestamp": "02:34:59", "text": "ああ、それは本当に素晴らしいアイデアだ。"}]
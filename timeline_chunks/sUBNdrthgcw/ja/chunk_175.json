[{"type": "subtitle", "time": 10501.269, "timestamp": "02:55:01", "text": "ええ、数日間は。うん。ええ、同じです"}, {"type": "subtitle", "time": 10504.469, "timestamp": "02:55:04", "text": "3人いると"}, {"type": "subtitle", "time": 10507.91, "timestamp": "02:55:07", "text": "自分専用のBFオーナメントを追加する"}, {"type": "subtitle", "time": 10511.59, "timestamp": "02:55:11", "text": "装飾された。だから、今はウェブサイトなので"}, {"type": "subtitle", "time": 10516.07, "timestamp": "02:55:16", "text": "さらに何か追加できます。"}, {"type": "subtitle", "time": 10518.79, "timestamp": "02:55:18", "text": "ジョッキーのように、あるいは私のすべてのように"}, {"type": "subtitle", "time": 10521.19, "timestamp": "02:55:21", "text": "エクシアのキャラクター"}, {"type": "subtitle", "time": 10524.63, "timestamp": "02:55:24", "text": "こんな感じの小屋で"}, {"type": "subtitle", "time": 10527.67, "timestamp": "02:55:27", "text": "カーソルを合わせるとかできます"}, {"type": "subtitle", "time": 10531.349, "timestamp": "02:55:31", "text": "何か。いや。ああ、なんてことだ。わからない"}, {"type": "subtitle", "time": 10533.83, "timestamp": "02:55:33", "text": "ウェブサイトでそれができるなら、"}, {"type": "subtitle", "time": 10536.23, "timestamp": "02:55:36", "text": "きっといい感じになるよ。すごくクール。まるで"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "ゲームの中でそれを行うんだ。クリックして操作する"}, {"type": "subtitle", "time": 10542.95, "timestamp": "02:55:42", "text": "あれこれあって、ホバリングとか色々。"}, {"type": "subtitle", "time": 10544.55, "timestamp": "02:55:44", "text": "ああ、それはウェブサイトでできますよ。"}, {"type": "subtitle", "time": 10548.07, "timestamp": "02:55:48", "text": "クリックして、カーソルを合わせて、その他いろいろ。ええ、そうは思いません"}, {"type": "subtitle", "time": 10551.11, "timestamp": "02:55:51", "text": "ドラッグ＆ドロップについて知っておく。額装業者が持っています。"}, {"type": "subtitle", "time": 10554.309, "timestamp": "02:55:54", "text": "でも、それは場合によりますね。でも、うんうん、"}, {"type": "subtitle", "time": 10556.79, "timestamp": "02:55:56", "text": "言いたいことは分かりますよね？"}]
[{"type": "subtitle", "time": 12781.99, "timestamp": "03:33:01", "text": "スネイプ。いや、いや、いや。あのスネイプってやつ。おお、"}, {"type": "subtitle", "time": 12783.75, "timestamp": "03:33:03", "text": "これです。"}, {"type": "subtitle", "time": 12786.229, "timestamp": "03:33:06", "text": "いいえ、"}, {"type": "subtitle", "time": 12793.67, "timestamp": "03:33:13", "text": "なぜこれがあの男に似ているのか"}, {"type": "subtitle", "time": 12808.71, "timestamp": "03:33:28", "text": "生放送中だと思う。ああ、ライブ配信中だよ。"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "はい、私はライブ配信していると思います。"}, {"type": "subtitle", "time": 12814.95, "timestamp": "03:33:34", "text": "わかった。何てことだ。さあ行こう。"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "ああ、大変だ。これは本当に面倒だ。"}, {"type": "subtitle", "time": 12821.59, "timestamp": "03:33:41", "text": "あなたが"}, {"type": "subtitle", "time": 12824.79, "timestamp": "03:33:44", "text": "一時的に黙れ。"}, {"type": "subtitle", "time": 12826.63, "timestamp": "03:33:46", "text": "何てことだ。だから私はまだ"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "ゲーム。わかった。ここから先は"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "下り坂を進む。"}, {"type": "subtitle", "time": 12834.63, "timestamp": "03:33:54", "text": "激しい試合"}, {"type": "subtitle", "time": 12837.67, "timestamp": "03:33:57", "text": "痛み。それで"}]
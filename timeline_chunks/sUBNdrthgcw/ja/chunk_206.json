[{"type": "subtitle", "time": 12360.55, "timestamp": "03:26:00", "text": "ついにここまで来ました。"}, {"type": "subtitle", "time": 12362.469, "timestamp": "03:26:02", "text": "待って、ブラッドがここにいる。うん。こんにちは、ブラッド。"}, {"type": "subtitle", "time": 12366.87, "timestamp": "03:26:06", "text": "元気ですか？ブラッド、元気かい？こんにちは。そして"}, {"type": "subtitle", "time": 12369.75, "timestamp": "03:26:09", "text": "ミア、元気？ミア、あなたが"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "順調です。"}, {"type": "subtitle", "time": 12373.67, "timestamp": "03:26:13", "text": "それからエドワード。うん。こんにちは。希望"}, {"type": "subtitle", "time": 12375.99, "timestamp": "03:26:15", "text": "エドワード、よくやっているね。待って、君たち"}, {"type": "subtitle", "time": 12378.229, "timestamp": "03:26:18", "text": "私の声が聞こえますよね？"}, {"type": "subtitle", "time": 12380.07, "timestamp": "03:26:20", "text": "うん。わかった。すべて順調です"}, {"type": "subtitle", "time": 12382.15, "timestamp": "03:26:22", "text": "明白な側面。わかった。そこで私は"}, {"type": "subtitle", "time": 12385.51, "timestamp": "03:26:25", "text": "ビットレートは、ただそれを期待しているだけです。"}, {"type": "subtitle", "time": 12389.75, "timestamp": "03:26:29", "text": "ラグは発生しません。うん、"}, {"type": "subtitle", "time": 12391.19, "timestamp": "03:26:31", "text": "音質はどうですか？する必要がある"}, {"type": "subtitle", "time": 12394.389, "timestamp": "03:26:34", "text": "チェック。それで、えっと、私は、あなたは持っているかもしれません"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "私のツイートを見ましたか？えっと、私はチェックしていました"}, {"type": "subtitle", "time": 12400.71, "timestamp": "03:26:40", "text": "ゲーム終了。私はそれを全くプレイしませんでした。する"}, {"type": "subtitle", "time": 12402.63, "timestamp": "03:26:42", "text": "心配しないでください。私が始めたわけではないが、"}, {"type": "subtitle", "time": 12405.269, "timestamp": "03:26:45", "text": "ログインしてデラックス版を手に入れるような感じ"}, {"type": "subtitle", "time": 12407.51, "timestamp": "03:26:47", "text": "報酬とか色々。 Twitchを手に入れました"}, {"type": "subtitle", "time": 12410.79, "timestamp": "03:26:50", "text": "ドロップも同様です。"}, {"type": "subtitle", "time": 12415.269, "timestamp": "03:26:55", "text": "それで、えっと、ファンクラブの件をしたんだけど、ハリー"}, {"type": "subtitle", "time": 12418.07, "timestamp": "03:26:58", "text": "ポッターファンクラブアカウント、"}]
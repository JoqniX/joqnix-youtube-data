[{"type": "subtitle", "time": 12662.55, "timestamp": "03:31:02", "text": "奇数。私はどんなヘアスタイルにすればいいの？"}, {"type": "subtitle", "time": 12664.63, "timestamp": "03:31:04", "text": "持っている？あ、待って。もしこれが女の子なら、"}, {"type": "subtitle", "time": 12667.3, "timestamp": "03:31:07", "text": "右？ああ、これは女の子だ。わかった。"}, {"type": "subtitle", "time": 12668.55, "timestamp": "03:31:08", "text": "[音楽]"}, {"type": "subtitle", "time": 12670.63, "timestamp": "03:31:10", "text": "なんてこった。私は、"}, {"type": "subtitle", "time": 12672.87, "timestamp": "03:31:12", "text": "これ。"}, {"type": "subtitle", "time": 12675.99, "timestamp": "03:31:15", "text": "ああ、これかもしれない。カナと"}, {"type": "subtitle", "time": 12678.229, "timestamp": "03:31:18", "text": "他の人たちも、皆これを選んだ。私は"}, {"type": "subtitle", "time": 12681.269, "timestamp": "03:31:21", "text": "受賞歴のあるストリームをいくつか視聴しています"}, {"type": "subtitle", "time": 12683.51, "timestamp": "03:31:23", "text": "それもそうだ。"}, {"type": "subtitle", "time": 12693.91, "timestamp": "03:31:33", "text": "モーションブラーは特にセクシーです"}, {"type": "subtitle", "time": 12699.269, "timestamp": "03:31:39", "text": "フォーラム。はい、モーションブラーに関しては最高です。"}, {"type": "subtitle", "time": 12713.429, "timestamp": "03:31:53", "text": "わかった。髪だけはやります。"}]
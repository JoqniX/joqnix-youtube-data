[{"type": "subtitle", "time": 9661.99, "timestamp": "02:41:01", "text": "今年"}, {"type": "subtitle", "time": 9665.349, "timestamp": "02:41:05", "text": "基本的なものよりも。昨年私たちは"}, {"type": "subtitle", "time": 9667.91, "timestamp": "02:41:07", "text": "これですよね？昨年はちょうど"}, {"type": "subtitle", "time": 9670.79, "timestamp": "02:41:10", "text": "当たり前のことだから、近くに置いた。"}, {"type": "subtitle", "time": 9672.71, "timestamp": "02:41:12", "text": "右。今年は必ず成功させる"}, {"type": "subtitle", "time": 9674.87, "timestamp": "02:41:14", "text": "おしゃれ、おしゃれ。"}, {"type": "subtitle", "time": 9679.59, "timestamp": "02:41:19", "text": "では、私が開けてみましょう。"}, {"type": "subtitle", "time": 9689.99, "timestamp": "02:41:29", "text": "こんにちは。見る？見る？見る？見る？皆さん、お分かりですか？"}, {"type": "subtitle", "time": 9692.71, "timestamp": "02:41:32", "text": "それ？皆さん、見えますか？見る？終わりました"}, {"type": "subtitle", "time": 9695.51, "timestamp": "02:41:35", "text": "ここ。すごく可愛いですよね？わかった。私は必要とする"}, {"type": "subtitle", "time": 9698.07, "timestamp": "02:41:38", "text": "少し調整する必要がある。つまり、これは"}, {"type": "subtitle", "time": 9701.349, "timestamp": "02:41:41", "text": "クリスマスツリー。少し調整できます"}, {"type": "subtitle", "time": 9704.309, "timestamp": "02:41:44", "text": "少し。ベッドの上に置いてみてはどうでしょう。何が"}, {"type": "subtitle", "time": 9708.63, "timestamp": "02:41:48", "text": "これをより良く表現する方法は？ベッドの上で"}, {"type": "subtitle", "time": 9711.51, "timestamp": "02:41:51", "text": "それともこちら側？"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "どちらが良いですか？"}, {"type": "subtitle", "time": 9717.19, "timestamp": "02:41:57", "text": "床に置きたいのですが、"}]
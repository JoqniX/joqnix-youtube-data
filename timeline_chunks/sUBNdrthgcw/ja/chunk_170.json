[{"type": "subtitle", "time": 10201.59, "timestamp": "02:50:01", "text": "もしそれが揺れていたら、"}, {"type": "subtitle", "time": 10207.59, "timestamp": "02:50:07", "text": "完璧ですね。ええ、私が言ったようにOBSで"}, {"type": "subtitle", "time": 10211.349, "timestamp": "02:50:11", "text": "などなど。ちょっと傷つけちゃったけど、"}, {"type": "subtitle", "time": 10213.67, "timestamp": "02:50:13", "text": "今ではそれができるようになった。でも私は"}, {"type": "subtitle", "time": 10217.67, "timestamp": "02:50:17", "text": "今から将来のことを考えている。あなた"}, {"type": "subtitle", "time": 10220.71, "timestamp": "02:50:20", "text": "現時点では21人が"}, {"type": "subtitle", "time": 10223.349, "timestamp": "02:50:23", "text": "その木。でも何人いるかはわからない"}, {"type": "subtitle", "time": 10226.15, "timestamp": "02:50:26", "text": "人々は今後1年間そこにいるだろう"}, {"type": "subtitle", "time": 10228.79, "timestamp": "02:50:28", "text": "クリスマス。もしそれが"}, {"type": "subtitle", "time": 10232.95, "timestamp": "02:50:32", "text": "21. それらをどのように配置すればよいですか？とても"}, {"type": "subtitle", "time": 10235.91, "timestamp": "02:50:35", "text": "そのような問題は数多く存在する。それで"}, {"type": "subtitle", "time": 10238.87, "timestamp": "02:50:38", "text": "私が考えていたのは、"}, {"type": "subtitle", "time": 10242.15, "timestamp": "02:50:42", "text": "OBSでこれを手動で行う"}, {"type": "subtitle", "time": 10245.429, "timestamp": "02:50:45", "text": "今年と昨年と同じように"}, {"type": "subtitle", "time": 10249.67, "timestamp": "02:50:49", "text": "来年以降、ええ、2024年ですね。"}, {"type": "subtitle", "time": 10252.07, "timestamp": "02:50:52", "text": "クリスマスまでに私は"}, {"type": "subtitle", "time": 10254.309, "timestamp": "02:50:54", "text": "ウェブサイト関連のすべて"}, {"type": "subtitle", "time": 10255.83, "timestamp": "02:50:55", "text": "終了した。"}, {"type": "subtitle", "time": 10258.79, "timestamp": "02:50:58", "text": "そうしなければならないといいのですが。"}]
[{"type": "subtitle", "time": 17220.708, "timestamp": "04:47:00", "text": "[音楽]"}, {"type": "subtitle", "time": 17222.868, "timestamp": "04:47:02", "text": "これはTwitchからもらったガラスですか？"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "滴？念のため、もう一度確認させてください。"}, {"type": "subtitle", "time": 17229.67, "timestamp": "04:47:09", "text": "私は良い見た目を手に入れたと思います"}, {"type": "subtitle", "time": 17232.15, "timestamp": "04:47:12", "text": "眼鏡"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "彼はディオの後期に加わった。彼は遅れて参加した"}, {"type": "subtitle", "time": 17244.708, "timestamp": "04:47:24", "text": "遅い"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "そして私は何が起こっているのか知りません"}, {"type": "subtitle", "time": 17251.35, "timestamp": "04:47:31", "text": "この場所。ドラゴンの目のような眼鏡と"}, {"type": "subtitle", "time": 17253.19, "timestamp": "04:47:33", "text": "ハティーン"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "照明スカーフ ライラック"}, {"type": "subtitle", "time": 17259.03, "timestamp": "04:47:39", "text": "エンパスとシンボル。それらは痙攣です"}, {"type": "subtitle", "time": 17263.35, "timestamp": "04:47:43", "text": "私が受け取ったドロップ。"}, {"type": "subtitle", "time": 17265.99, "timestamp": "04:47:45", "text": "どこにも見当たらない。"}, {"type": "subtitle", "time": 17268.23, "timestamp": "04:47:48", "text": "これは怪しすぎる。"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "わからない。ともかく、"}]
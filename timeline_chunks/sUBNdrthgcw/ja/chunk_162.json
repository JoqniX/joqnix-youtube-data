[{"type": "subtitle", "time": 9722.79, "timestamp": "02:42:02", "text": "ベッドの上で見るといい感じだ。わからない。"}, {"type": "subtitle", "time": 9725.12, "timestamp": "02:42:05", "text": "えっと"}, {"type": "subtitle", "time": 9731.75, "timestamp": "02:42:11", "text": "また、いくつか変更を加える必要があります"}, {"type": "subtitle", "time": 9734.15, "timestamp": "02:42:14", "text": "これ。リムライトを追加できます。いいえ、"}, {"type": "subtitle", "time": 9740.95, "timestamp": "02:42:20", "text": "私たちはそうでしょうか？いや、いや、いや。これは本当に必要なのか？私"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "わからない。リム。うん、リムライトだね。私たちは"}, {"type": "subtitle", "time": 9747.03, "timestamp": "02:42:27", "text": "リムライトが必要です。はい、私たちは"}, {"type": "subtitle", "time": 9748.71, "timestamp": "02:42:28", "text": "点灯"}, {"type": "subtitle", "time": 9752.309, "timestamp": "02:42:32", "text": "これに適合する"}, {"type": "subtitle", "time": 9755.67, "timestamp": "02:42:35", "text": "私たちが今いる場所ならどこでも。えっと"}, {"type": "subtitle", "time": 9759.03, "timestamp": "02:42:39", "text": "花火を持って行こう。それを"}, {"type": "subtitle", "time": 9769.19, "timestamp": "02:42:49", "text": "それは良いですね。両方作れる"}, {"type": "subtitle", "time": 9776.71, "timestamp": "02:42:56", "text": "強度。ええと、これくらいにできます"}, {"type": "subtitle", "time": 9779.59, "timestamp": "02:42:59", "text": "若干。"}]
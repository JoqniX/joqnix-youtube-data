[{"type": "subtitle", "time": 18960.868, "timestamp": "05:16:00", "text": "は、交代で彼らを呼び出します"}, {"type": "subtitle", "time": 18963.75, "timestamp": "05:16:03", "text": "互いの手を握り合う。たった1冊の本だけが"}, {"type": "subtitle", "time": 18965.91, "timestamp": "05:16:05", "text": "パートナーシップごとに必要になります、デールさん。"}, {"type": "subtitle", "time": 18969.85, "timestamp": "05:16:09", "text": "ありがとう。今すぐ配置につけ。"}, {"type": "subtitle", "time": 18975.43, "timestamp": "05:16:15", "text": "[音楽]"}, {"type": "subtitle", "time": 18978.628, "timestamp": "05:16:18", "text": "マウスで杖の街を探索し、ガイドに従って"}, {"type": "subtitle", "time": 18985.11, "timestamp": "05:16:25", "text": "[音楽]"}, {"type": "subtitle", "time": 18987.58, "timestamp": "05:16:27", "text": "パス。わかった。"}, {"type": "subtitle", "time": 18991.99, "timestamp": "05:16:31", "text": "[音楽]"}, {"type": "subtitle", "time": 18995.51, "timestamp": "05:16:35", "text": "わーい。私はその呪文を覚えた。アクシオ。"}, {"type": "subtitle", "time": 19002.23, "timestamp": "05:16:42", "text": "それは悪くない。"}, {"type": "subtitle", "time": 19005.99, "timestamp": "05:16:45", "text": "あなたは物覚えが早いですね。私はたくさんの"}, {"type": "subtitle", "time": 19008.788, "timestamp": "05:16:48", "text": "潜在的。しかし、可能性は"}, {"type": "subtitle", "time": 19012.23, "timestamp": "05:16:52", "text": "練習なしには何も成し遂げられない。諦めずに続けてください。"}, {"type": "subtitle", "time": 19015.43, "timestamp": "05:16:55", "text": "あなたはここでマイに匹敵するかもしれない。"}, {"type": "subtitle", "time": 19017.03, "timestamp": "05:16:57", "text": "皆さん、とても良かったです。これで十分だ"}, {"type": "subtitle", "time": 19019.19, "timestamp": "05:16:59", "text": "それ。さて、皆さんは"}]
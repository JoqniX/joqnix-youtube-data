[{"type": "subtitle", "time": 16443.349, "timestamp": "04:34:03", "text": "学生が"}, {"type": "subtitle", "time": 16445.59, "timestamp": "04:34:05", "text": "5年次から開始する。少し"}, {"type": "subtitle", "time": 16448.07, "timestamp": "04:34:08", "text": "挑戦ではあるけれど、きっとあなたならできるはず"}, {"type": "subtitle", "time": 16450.869, "timestamp": "04:34:10", "text": "のために。はい、教授。これは"}, {"type": "subtitle", "time": 16453.67, "timestamp": "04:34:13", "text": "レイブンクロー寮の談話室への入り口。"}, {"type": "subtitle", "time": 16456.07, "timestamp": "04:34:16", "text": "入場するには謎解きをしなければなりません。私"}, {"type": "subtitle", "time": 16458.23, "timestamp": "04:34:18", "text": "残念ながら、あまり役に立たないでしょう。これ"}, {"type": "subtitle", "time": 16466.39, "timestamp": "04:34:26", "text": "右。"}, {"type": "subtitle", "time": 16470.47, "timestamp": "04:34:30", "text": "幽霊と人間、どちらが長生きしたか"}, {"type": "subtitle", "time": 16472.789, "timestamp": "04:34:32", "text": "ポルターガイスト？"}, {"type": "subtitle", "time": 16477.029, "timestamp": "04:34:37", "text": "幽霊か、それともポルターガイスト現象か？ H"}, {"type": "subtitle", "time": 16479.189, "timestamp": "04:34:39", "text": "非存在"}, {"type": "subtitle", "time": 16482.551, "timestamp": "04:34:42", "text": "決してあり得なかった。"}, {"type": "subtitle", "time": 16484.869, "timestamp": "04:34:44", "text": "おお"}, {"type": "subtitle", "time": 16489.99, "timestamp": "04:34:49", "text": "彼は本当に素晴らしい仕事をした。彼はもう決めた。中へ進んでください"}, {"type": "subtitle", "time": 16492.23, "timestamp": "04:34:52", "text": "そして、睡眠をとりましょう。今日は大事な日ですね"}, {"type": "subtitle", "time": 16493.99, "timestamp": "04:34:53", "text": "明日、あなたの前に。私は戻ってきます"}, {"type": "subtitle", "time": 16495.75, "timestamp": "04:34:55", "text": "朝にあなたを迎えに行きます"}, {"type": "subtitle", "time": 16497.83, "timestamp": "04:34:57", "text": "ファーストクラス。教授、ありがとうございます。"}, {"type": "subtitle", "time": 16499.83, "timestamp": "04:34:59", "text": "ウィーズリー。どういたしまして。あなたに"}]
[{"type": "subtitle", "time": 14941.83, "timestamp": "04:09:01", "text": "これは怪しい。ハリー・ポッターを見たことがありますか？"}, {"type": "subtitle", "time": 14955.51, "timestamp": "04:09:15", "text": "待って、私は色のついた目を選んだの？"}, {"type": "subtitle", "time": 14957.83, "timestamp": "04:09:17", "text": "色？確認してみます。教授、"}, {"type": "subtitle", "time": 14959.349, "timestamp": "04:09:19", "text": "彼女の護衛が身につけていた腕章は"}, {"type": "subtitle", "time": 14962.07, "timestamp": "04:09:22", "text": "輝いている。君が見たあの輝きのように"}, {"type": "subtitle", "time": 14965.349, "timestamp": "04:09:25", "text": "豚肉容器。いや、もっと暗い。私はそれを見た"}, {"type": "subtitle", "time": 14967.269, "timestamp": "04:09:27", "text": "ドラゴンの首輪にも同じような光が差している。うん。"}, {"type": "subtitle", "time": 14968.87, "timestamp": "04:09:28", "text": "何だって？私たちはただ気になっていただけです"}, {"type": "subtitle", "time": 14971.429, "timestamp": "04:09:31", "text": "後ろにあるあの聖杯のことなんだけど。彼は見ている"}, {"type": "subtitle", "time": 14974.469, "timestamp": "04:09:34", "text": "銀行の最も古い区画の上。"}, {"type": "subtitle", "time": 14982.15, "timestamp": "04:09:42", "text": "偽善についてはあまり詳しくない"}, {"type": "subtitle", "time": 14983.99, "timestamp": "04:09:43", "text": "でも、それは本当に長い"}, {"type": "subtitle", "time": 14987.99, "timestamp": "04:09:47", "text": "私がそれを見たのは、もうずいぶん前のことです。"}, {"type": "subtitle", "time": 14998.87, "timestamp": "04:09:58", "text": "[音楽]"}]
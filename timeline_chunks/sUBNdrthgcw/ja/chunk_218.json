[{"type": "subtitle", "time": 13083.19, "timestamp": "03:38:03", "text": "私は必要ありません"}, {"type": "subtitle", "time": 13095.429, "timestamp": "03:38:15", "text": "他に何をすればいいですか？ わかりました、必要ありません"}, {"type": "subtitle", "time": 13101.99, "timestamp": "03:38:21", "text": "よし、これで十分だと思う。 H."}, {"type": "subtitle", "time": 13105.03, "timestamp": "03:38:25", "text": "ええ、まあ、そんな感じです。私はそれを知っている。うん。"}, {"type": "subtitle", "time": 13108.87, "timestamp": "03:38:28", "text": "はい、戻ってきました。またここに戻ってきました。空間"}, {"type": "subtitle", "time": 13118.309, "timestamp": "03:38:38", "text": "わかった。続けるにはFを押してください。"}, {"type": "subtitle", "time": 13120.55, "timestamp": "03:38:40", "text": "F."}, {"type": "subtitle", "time": 13123.67, "timestamp": "03:38:43", "text": "荷物を取りに行くので、ちょっと待っていてください。"}, {"type": "subtitle", "time": 13125.99, "timestamp": "03:38:45", "text": "続く。"}, {"type": "subtitle", "time": 13129.429, "timestamp": "03:38:49", "text": "設定。今回は設定で。"}, {"type": "subtitle", "time": 13136.309, "timestamp": "03:38:56", "text": "[音楽]"}, {"type": "subtitle", "time": 13139.349, "timestamp": "03:38:59", "text": "これも低めに設定しておきます。"}]
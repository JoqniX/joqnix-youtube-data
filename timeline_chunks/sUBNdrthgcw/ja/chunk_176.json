[{"type": "subtitle", "time": 10563.59, "timestamp": "02:56:03", "text": "それはいい方法だと思う。私にもできそうだ。"}, {"type": "subtitle", "time": 10565.349, "timestamp": "02:56:05", "text": "うん。うん。うん。それは"}, {"type": "subtitle", "time": 10568.07, "timestamp": "02:56:08", "text": "来年のアイデア。"}, {"type": "subtitle", "time": 10573.349, "timestamp": "02:56:13", "text": "私たちはブレインストーミングをして、"}, {"type": "subtitle", "time": 10576.23, "timestamp": "02:56:16", "text": "最善を尽くします"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "たとえそれができなくても"}, {"type": "subtitle", "time": 10581.19, "timestamp": "02:56:21", "text": "今私が言及した高級品"}, {"type": "subtitle", "time": 10583.91, "timestamp": "02:56:23", "text": "大丈夫、いつも通りにやろう"}, {"type": "subtitle", "time": 10588.309, "timestamp": "02:56:28", "text": "以前は強迫観念にとらわれ、それを手動で行っていました。"}, {"type": "subtitle", "time": 10590.389, "timestamp": "02:56:30", "text": "うん。"}, {"type": "subtitle", "time": 10593.99, "timestamp": "02:56:33", "text": "そう、それは私のアイデアだったんです。"}, {"type": "subtitle", "time": 10597.11, "timestamp": "02:56:37", "text": "ええ、そう願っています"}, {"type": "subtitle", "time": 10604.87, "timestamp": "02:56:44", "text": "もっとアイデアが浮かんできた。もしそれが"}, {"type": "subtitle", "time": 10607.51, "timestamp": "02:56:47", "text": "このケツの穴の場所みたいに、そう、"}, {"type": "subtitle", "time": 10610.87, "timestamp": "02:56:50", "text": "ピクセルをドロップできる場所"}, {"type": "subtitle", "time": 10616.469, "timestamp": "02:56:56", "text": "えーと、その他いろいろ。みんなに"}]
[{"type": "subtitle", "time": 4680.55, "timestamp": "01:18:00", "text": "14. よし、君はそれらを手に入れた。あなたは勝ちました"}, {"type": "subtitle", "time": 4684.709, "timestamp": "01:18:04", "text": "紫。わかりました。こんにちは。"}, {"type": "subtitle", "time": 4688.07, "timestamp": "01:18:08", "text": "14. え？"}, {"type": "subtitle", "time": 4690.709, "timestamp": "01:18:10", "text": "私はこれを自分のものにするためにあなたのアバターを手に入れます"}, {"type": "subtitle", "time": 4693.11, "timestamp": "01:18:13", "text": "もの。"}, {"type": "subtitle", "time": 4694.709, "timestamp": "01:18:14", "text": "14."}, {"type": "subtitle", "time": 4704.31, "timestamp": "01:18:24", "text": "えっと、待って。どのサイズを入力すればいいですか？えっと、"}, {"type": "subtitle", "time": 4722.47, "timestamp": "01:18:42", "text": "これをコピーしてください。"}, {"type": "subtitle", "time": 4725.59, "timestamp": "01:18:45", "text": "これがある。あなたは14個欲しかったんですよね？"}, {"type": "subtitle", "time": 4728.95, "timestamp": "01:18:48", "text": "了解。"}]
[{"type": "subtitle", "time": 18841.27, "timestamp": "05:14:01", "text": "[音楽]"}, {"type": "subtitle", "time": 18843.35, "timestamp": "05:14:03", "text": "魅力向上講座。"}, {"type": "subtitle", "time": 18845.75, "timestamp": "05:14:05", "text": "よし、じゃあ魅力講座に行こう。私はできません"}, {"type": "subtitle", "time": 18849.27, "timestamp": "05:14:09", "text": "私の姉妹全員が"}, {"type": "subtitle", "time": 18852.13, "timestamp": "05:14:12", "text": "始める。"}, {"type": "subtitle", "time": 18854.23, "timestamp": "05:14:14", "text": "[音楽]"}, {"type": "subtitle", "time": 18857.33, "timestamp": "05:14:17", "text": "ああ、なんてことだ、すごく動作が重い。"}, {"type": "subtitle", "time": 18859.75, "timestamp": "05:14:19", "text": "[音楽]"}, {"type": "subtitle", "time": 18861.35, "timestamp": "05:14:21", "text": "ここ"}, {"type": "subtitle", "time": 18865.27, "timestamp": "05:14:25", "text": "あなたの後ろに空席があります。"}, {"type": "subtitle", "time": 18867.91, "timestamp": "05:14:27", "text": "ありがとう。"}, {"type": "subtitle", "time": 18871.11, "timestamp": "05:14:31", "text": "こんにちは。私はネッティです。つまりあなたは"}, {"type": "subtitle", "time": 18873.11, "timestamp": "05:14:33", "text": "新入生。"}, {"type": "subtitle", "time": 18880.948, "timestamp": "05:14:40", "text": "では始めましょうか？"}, {"type": "subtitle", "time": 18883.59, "timestamp": "05:14:43", "text": "チャームの5年目へようこそ。今これ"}, {"type": "subtitle", "time": 18886.23, "timestamp": "05:14:46", "text": "教育において重要な年となるでしょう"}, {"type": "subtitle", "time": 18889.19, "timestamp": "05:14:49", "text": "魅惑術の技術について。でも私は"}, {"type": "subtitle", "time": 18891.91, "timestamp": "05:14:51", "text": "我々は"}, {"type": "subtitle", "time": 18894.948, "timestamp": "05:14:54", "text": "このような情熱と厳格さは"}, {"type": "subtitle", "time": 18897.67, "timestamp": "05:14:57", "text": "チャレンジ。皆さん、今すぐお願いします"}]
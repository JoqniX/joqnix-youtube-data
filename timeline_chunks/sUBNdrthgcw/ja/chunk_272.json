[{"type": "subtitle", "time": 16320.55, "timestamp": "04:32:00", "text": "それで"}, {"type": "subtitle", "time": 16323.51, "timestamp": "04:32:03", "text": "問題ないと思います。あなたの太ももは"}, {"type": "subtitle", "time": 16325.91, "timestamp": "04:32:05", "text": "考える？"}, {"type": "subtitle", "time": 16328.63, "timestamp": "04:32:08", "text": "レイブンクロー寮は知性で知られている。"}, {"type": "subtitle", "time": 16330.95, "timestamp": "04:32:10", "text": "それが私のクリエイターです。私はこれらが大好きです"}, {"type": "subtitle", "time": 16334.229, "timestamp": "04:32:14", "text": "もの。ということで、それでいきましょう。"}, {"type": "subtitle", "time": 16337.349, "timestamp": "04:32:17", "text": "わーい。さあ行こう。"}, {"type": "subtitle", "time": 16340.63, "timestamp": "04:32:20", "text": "登場する人は15XPを獲得します。"}, {"type": "subtitle", "time": 16342.79, "timestamp": "04:32:22", "text": "それは壮大なゲームだ。"}, {"type": "subtitle", "time": 16345.33, "timestamp": "04:32:25", "text": "レイブンクロー。"}, {"type": "subtitle", "time": 16348.63, "timestamp": "04:32:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16348.92, "timestamp": "04:32:28", "text": "[拍手]"}, {"type": "subtitle", "time": 16350.7, "timestamp": "04:32:30", "text": "[音楽]"}, {"type": "subtitle", "time": 16368.309, "timestamp": "04:32:48", "text": "ああ、それともう一つ。のため"}, {"type": "subtitle", "time": 16370.469, "timestamp": "04:32:50", "text": "前回の試合でピッチ上で不運な怪我"}, {"type": "subtitle", "time": 16372.309, "timestamp": "04:32:52", "text": "春の最終戦、今年のクィディッチ"}, {"type": "subtitle", "time": 16375.64, "timestamp": "04:32:55", "text": "シーズンは中止となりました。"}]
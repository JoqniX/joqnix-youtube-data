[{"type": "subtitle", "time": 5462.47, "timestamp": "01:31:02", "text": "[音楽]"}, {"type": "subtitle", "time": 5472.39, "timestamp": "01:31:12", "text": "はぁ？"}, {"type": "subtitle", "time": 5482.229, "timestamp": "01:31:22", "text": "何？一体どういうことだ？何？"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "どこにもない。"}, {"type": "subtitle", "time": 5487.03, "timestamp": "01:31:27", "text": "あれはTwitchからだったと思うけど"}, {"type": "subtitle", "time": 5490.149, "timestamp": "01:31:30", "text": "例えばどこ"}, {"type": "subtitle", "time": 5493.91, "timestamp": "01:31:33", "text": "どこで"}, {"type": "subtitle", "time": 5496.55, "timestamp": "01:31:36", "text": "ロックされませんでした。"}, {"type": "subtitle", "time": 5500.709, "timestamp": "01:31:40", "text": "よし、行く時間だ"}, {"type": "subtitle", "time": 5513.669, "timestamp": "01:31:53", "text": "特定。そうします。えっと"}, {"type": "subtitle", "time": 5517.27, "timestamp": "01:31:57", "text": "ほかに何か？私は"}]
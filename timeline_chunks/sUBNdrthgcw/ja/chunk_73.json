[{"type": "subtitle", "time": 4388.149, "timestamp": "01:13:08", "text": "そうそう。ほら、君はできるよ"}, {"type": "subtitle", "time": 4391.27, "timestamp": "01:13:11", "text": "文字通り、すごくクール"}, {"type": "subtitle", "time": 4393.669, "timestamp": "01:13:13", "text": "これでアニメーションとか色々作れるよ。まるで"}, {"type": "subtitle", "time": 4397.11, "timestamp": "01:13:17", "text": "これ、分かりますよね？できるように"}, {"type": "subtitle", "time": 4400.149, "timestamp": "01:13:20", "text": "文字通り、次のような効果を実行します"}, {"type": "subtitle", "time": 4403.91, "timestamp": "01:13:23", "text": "このマスキング効果。これが見えますか？"}, {"type": "subtitle", "time": 4406.07, "timestamp": "01:13:26", "text": "それはすごくクールだね。自動で"}, {"type": "subtitle", "time": 4409.83, "timestamp": "01:13:29", "text": "それを明白な方法でアニメーション化する。"}, {"type": "subtitle", "time": 4411.03, "timestamp": "01:13:31", "text": "それはすごくクールだね。何てことだ。私は"}, {"type": "subtitle", "time": 4412.95, "timestamp": "01:13:32", "text": "新しいものを発見する。私は「ああ」って感じ"}, {"type": "subtitle", "time": 4415.669, "timestamp": "01:13:35", "text": "我が神よ。ポグ"}, {"type": "subtitle", "time": 4419.99, "timestamp": "01:13:39", "text": "多角形の数 ああ、"}, {"type": "subtitle", "time": 4429.43, "timestamp": "01:13:49", "text": "[音楽]"}, {"type": "subtitle", "time": 4434.149, "timestamp": "01:13:54", "text": "私は人々をスターにすることができる。"}, {"type": "subtitle", "time": 4436.149, "timestamp": "01:13:56", "text": "何てことだ。"}, {"type": "subtitle", "time": 4439.11, "timestamp": "01:13:59", "text": "四芒星としても。ああ、"}]
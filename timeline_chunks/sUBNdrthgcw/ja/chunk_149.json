[{"type": "subtitle", "time": 8947.19, "timestamp": "02:29:07", "text": "待って。彼らは私にこうするように言っている"}, {"type": "subtitle", "time": 8953.349, "timestamp": "02:29:13", "text": "これは何ですか？"}, {"type": "subtitle", "time": 8956.79, "timestamp": "02:29:16", "text": "一般的な防具。"}, {"type": "subtitle", "time": 8959.67, "timestamp": "02:29:19", "text": "H 私は時間を無駄にしたくない 私は知らない"}, {"type": "subtitle", "time": 8962.309, "timestamp": "02:29:22", "text": "私はそれをしません。うん"}, {"type": "subtitle", "time": 8975.59, "timestamp": "02:29:35", "text": "待って、私がどれくらい前から"}, {"type": "subtitle", "time": 8978.309, "timestamp": "02:29:38", "text": "ストリーミング配信してた？はい、1時間30分です"}, {"type": "subtitle", "time": 8980.15, "timestamp": "02:29:40", "text": "分ですよね？"}, {"type": "subtitle", "time": 8986.77, "timestamp": "02:29:46", "text": "郵便配達。"}]
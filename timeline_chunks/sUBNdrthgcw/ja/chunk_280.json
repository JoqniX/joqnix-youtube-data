[{"type": "subtitle", "time": 16801.67, "timestamp": "04:40:01", "text": "ちょうどいい場所だ。ああ、これは何でしょう？行くよ"}, {"type": "subtitle", "time": 16811.59, "timestamp": "04:40:11", "text": "この素敵な女性はどなたですか？私は彼にこうあってほしい"}, {"type": "subtitle", "time": 16814.23, "timestamp": "04:40:14", "text": "最高の場所に。彼が行く場所"}, {"type": "subtitle", "time": 16817.99, "timestamp": "04:40:17", "text": "満足しています。しかし、どうしても見つからない。"}, {"type": "subtitle", "time": 16821.43, "timestamp": "04:40:21", "text": "巨大な黄金の岩塊。私は彼に"}, {"type": "subtitle", "time": 16823.43, "timestamp": "04:40:23", "text": "ここで成功しよう。金色の宝石が3つ。"}, {"type": "subtitle", "time": 16826.07, "timestamp": "04:40:26", "text": "ゴールドストン。それは何ですか？私の小さな"}, {"type": "subtitle", "time": 16828.708, "timestamp": "04:40:28", "text": "表現。私はこのダニーの苗木を買いました"}, {"type": "subtitle", "time": 16830.55, "timestamp": "04:40:30", "text": "家から離れて、彼に感じてほしい"}, {"type": "subtitle", "time": 16833.75, "timestamp": "04:40:33", "text": "居心地の良い。ディナニーってすごいよね？それで"}, {"type": "subtitle", "time": 16835.67, "timestamp": "04:40:35", "text": "非常に強い治癒力がある。ドクは司令官だ"}, {"type": "subtitle", "time": 16837.51, "timestamp": "04:40:37", "text": "働く？どの司令官？少し"}, {"type": "subtitle", "time": 16839.59, "timestamp": "04:40:39", "text": "ええ、私はライブデューティーを使用していません。"}, {"type": "subtitle", "time": 16842.55, "timestamp": "04:40:42", "text": "今のところ、私はただのPNGファイルです。つまり、なし"}, {"type": "subtitle", "time": 16845.43, "timestamp": "04:40:45", "text": "それらの自動化ツールはどれも機能しないだろう。は"}, {"type": "subtitle", "time": 16849.19, "timestamp": "04:40:49", "text": "ヴェンヴァルドのポーションに使われますか？そうです。見た目"}, {"type": "subtitle", "time": 16851.43, "timestamp": "04:40:51", "text": "誰かが勉強してきたみたい"}, {"type": "subtitle", "time": 16854.15, "timestamp": "04:40:54", "text": "薬作り。実際、フィグ教授は"}, {"type": "subtitle", "time": 16856.47, "timestamp": "04:40:56", "text": "ウィガンワールドのポーションについて教えてくれた。の"}, {"type": "subtitle", "time": 16858.55, "timestamp": "04:40:58", "text": "コース。君は一緒に勉強していたと聞いたよ"}]
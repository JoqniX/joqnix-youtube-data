[{"type": "subtitle", "time": 12060.469, "timestamp": "03:21:00", "text": "デスクトップ画面を見せる必要はないので"}, {"type": "subtitle", "time": 12064.389, "timestamp": "03:21:04", "text": "便利だから、これを見せることができる。"}, {"type": "subtitle", "time": 12068.469, "timestamp": "03:21:08", "text": "音声に問題がないか教えてください。ドゥドゥ"}, {"type": "subtitle", "time": 12071.269, "timestamp": "03:21:11", "text": "音声が聞こえるかどうか教えてください。"}, {"type": "subtitle", "time": 12073.67, "timestamp": "03:21:13", "text": "何でも。ええ、ぜひ教えてください。全て"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "右。"}, {"type": "subtitle", "time": 12080.15, "timestamp": "03:21:20", "text": "こうなるとすごく傷だらけになるよ。えーと"}, {"type": "subtitle", "time": 12083.75, "timestamp": "03:21:23", "text": "これをどこに置けばいいのかわからない"}, {"type": "subtitle", "time": 12087.91, "timestamp": "03:21:27", "text": "OBS関連のことです。えっと、それで私は自分の"}, {"type": "subtitle", "time": 12091.75, "timestamp": "03:21:31", "text": "配信中にOBSを使用しています。それでは、"}, {"type": "subtitle", "time": 12095.51, "timestamp": "03:21:35", "text": "ちょっと待って、マルチタスクを素早くやってきます。ウルトラ"}, {"type": "subtitle", "time": 12098.87, "timestamp": "03:21:38", "text": "スピードが速い。 1秒。"}, {"type": "subtitle", "time": 12101.75, "timestamp": "03:21:41", "text": "私もチャットの内容を読んでみたかった。男、"}, {"type": "subtitle", "time": 12103.99, "timestamp": "03:21:43", "text": "これは本当に残念な瞬間だ。まるで"}, {"type": "subtitle", "time": 12108.55, "timestamp": "03:21:48", "text": "私はモニターを1台使用しています。何てことだ。何？"}, {"type": "subtitle", "time": 12110.71, "timestamp": "03:21:50", "text": "H"}, {"type": "subtitle", "time": 12114.71, "timestamp": "03:21:54", "text": "画面。これを見てください。二。あなたには"}, {"type": "subtitle", "time": 12116.95, "timestamp": "03:21:56", "text": "垂直であること。"}]
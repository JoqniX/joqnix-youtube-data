[{"type": "subtitle", "time": 3241.51, "timestamp": "00:54:01", "text": "開けた時。そこにはない。 300×300。"}, {"type": "subtitle", "time": 3243.67, "timestamp": "00:54:03", "text": "ほら、見えないでしょ。"}, {"type": "subtitle", "time": 3251.99, "timestamp": "00:54:11", "text": "これは何ですか？だから何？ちょっと待って。病気"}, {"type": "subtitle", "time": 3254.309, "timestamp": "00:54:14", "text": "これをもう一度やってください。"}, {"type": "subtitle", "time": 3258.549, "timestamp": "00:54:18", "text": "仕事だ。"}, {"type": "subtitle", "time": 3261.99, "timestamp": "00:54:21", "text": "そんなことしないで。"}, {"type": "subtitle", "time": 3264.79, "timestamp": "00:54:24", "text": "ああ、それはうまくいかないな。ちょっと待って。"}, {"type": "subtitle", "time": 3273.43, "timestamp": "00:54:33", "text": "あなたが嫌い​​です。"}, {"type": "subtitle", "time": 3279.349, "timestamp": "00:54:39", "text": "ストリームにクリッピングマスクはありますか？"}, {"type": "subtitle", "time": 3280.95, "timestamp": "00:54:40", "text": "影響は？ストリームがありません"}, {"type": "subtitle", "time": 3284.069, "timestamp": "00:54:44", "text": "エフェクトプラグインですが、"}, {"type": "subtitle", "time": 3293.03, "timestamp": "00:54:53", "text": "これは明らかに私のFSであるはずです"}, {"type": "subtitle", "time": 3295.51, "timestamp": "00:54:55", "text": "チェーンは作ったけど、物を入れるのを忘れた。それは"}, {"type": "subtitle", "time": 3297.349, "timestamp": "00:54:57", "text": "問題点。"}, {"type": "subtitle", "time": 3299.829, "timestamp": "00:54:59", "text": "そして私はうっかり全部つけてしまった"}]
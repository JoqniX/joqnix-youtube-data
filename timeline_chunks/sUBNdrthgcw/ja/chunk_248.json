[{"type": "subtitle", "time": 14883.03, "timestamp": "04:08:03", "text": "私たちは金持ちですか？見てごらん。好きなのは"}, {"type": "subtitle", "time": 14887.67, "timestamp": "04:08:07", "text": "座席の周りを回転するような感じだ。じっとしていてください"}, {"type": "subtitle", "time": 14890.229, "timestamp": "04:08:10", "text": "すべての魔法。それはセキュリティです"}, {"type": "subtitle", "time": 14892.309, "timestamp": "04:08:12", "text": "測定。泥棒の"}, {"type": "subtitle", "time": 14895.99, "timestamp": "04:08:15", "text": "以前の没落。聞いたことありますか？"}, {"type": "subtitle", "time": 14897.91, "timestamp": "04:08:17", "text": "これらは私たちが"}, {"type": "subtitle", "time": 14900.389, "timestamp": "04:08:20", "text": "通過します。どれくらい深く潜るつもりですか？"}, {"type": "subtitle", "time": 14902.79, "timestamp": "04:08:22", "text": "金庫室12号室は間もなく稼働を開始した。"}, {"type": "subtitle", "time": 14905.03, "timestamp": "04:08:25", "text": "グリーノスが設立されてから4年以上が経ちました"}, {"type": "subtitle", "time": 14907.83, "timestamp": "04:08:27", "text": "何世紀も前のこと。彼は最も深いところに住んでいる"}, {"type": "subtitle", "time": 14910.469, "timestamp": "04:08:30", "text": "銀行の一部。落ち着いてください。"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "おお。"}, {"type": "subtitle", "time": 14928.309, "timestamp": "04:08:48", "text": "金庫番号"}, {"type": "subtitle", "time": 14938.87, "timestamp": "04:08:58", "text": "どうぞお進みください。"}]
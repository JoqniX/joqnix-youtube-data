[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "中古の杖へ。あなたは力になるでしょう"}, {"type": "subtitle", "time": 13622.229, "timestamp": "03:47:02", "text": "手に入れたら侮れない存在になる"}, {"type": "subtitle", "time": 13624.95, "timestamp": "03:47:04", "text": "自分の。ヴィック教授、ありがとうございます。私"}, {"type": "subtitle", "time": 13633.11, "timestamp": "03:47:13", "text": "ああ、エラザール。"}, {"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "ジョージ、私のかなり謎めいた"}, {"type": "subtitle", "time": 13636.79, "timestamp": "03:47:16", "text": "私たちの場所の説明は"}, {"type": "subtitle", "time": 13638.79, "timestamp": "03:47:18", "text": "あなたが私たちを見つけるのを阻止する。私は姿を消した"}, {"type": "subtitle", "time": 13640.389, "timestamp": "03:47:20", "text": "より漠然とした目的地へ"}, {"type": "subtitle", "time": 13645.75, "timestamp": "03:47:25", "text": "これよりも。私は自分の"}, {"type": "subtitle", "time": 13647.03, "timestamp": "03:47:27", "text": "何人かをかなり怖がらせた"}, {"type": "subtitle", "time": 13650.07, "timestamp": "03:47:30", "text": "ウエストエンドの劇場に足を運ぶ人々。"}, {"type": "subtitle", "time": 13651.91, "timestamp": "03:47:31", "text": "君たちは私が"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "受け取りました。言わない方がいいと思います。"}, {"type": "subtitle", "time": 13657.99, "timestamp": "03:47:37", "text": "ここで話してください。エラザール、"}, {"type": "subtitle", "time": 13660.71, "timestamp": "03:47:40", "text": "もちろん。道中で話しましょうか"}, {"type": "subtitle", "time": 13662.87, "timestamp": "03:47:42", "text": "ホグワーツへ？新学期が始まります"}, {"type": "subtitle", "time": 13665.269, "timestamp": "03:47:45", "text": "宴会と選別式に出席するためには、そこへ行く必要がある。"}, {"type": "subtitle", "time": 13667.189, "timestamp": "03:47:47", "text": "素晴らしいアイデアですね。若い限り"}, {"type": "subtitle", "time": 13668.95, "timestamp": "03:47:48", "text": "ここでのチャージは私がタグ付けすることを気にしない"}, {"type": "subtitle", "time": 13671.03, "timestamp": "03:47:51", "text": "平行。"}, {"type": "subtitle", "time": 13673.03, "timestamp": "03:47:53", "text": "お先にどうぞ。"}, {"type": "subtitle", "time": 13675.59, "timestamp": "03:47:55", "text": "お城に行ったのはずいぶん前のことだ。"}, {"type": "subtitle", "time": 13677.83, "timestamp": "03:47:57", "text": "古い山を見るのは良いだろう"}]
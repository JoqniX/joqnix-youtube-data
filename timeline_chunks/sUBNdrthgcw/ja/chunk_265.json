[{"type": "subtitle", "time": 15900.55, "timestamp": "04:25:00", "text": "なんてこった。彼らを殺した。私は我慢ができない"}, {"type": "subtitle", "time": 15905.189, "timestamp": "04:25:05", "text": "裏切り者のために。君は彼らを殺したんだ。なぜ？今、"}, {"type": "subtitle", "time": 15908.309, "timestamp": "04:25:08", "text": "私たちはどこまで話しましたっけ？あなたにあげません"}, {"type": "subtitle", "time": 15913.189, "timestamp": "04:25:13", "text": "何でも。 H. そうですね、もしかしたらあなたの若い"}, {"type": "subtitle", "time": 15929.58, "timestamp": "04:25:29", "text": "何てことだ。いいえ。"}]
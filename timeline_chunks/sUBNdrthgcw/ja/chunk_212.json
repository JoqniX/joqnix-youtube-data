[{"type": "subtitle", "time": 12720.87, "timestamp": "03:32:00", "text": "髪だけなら私がやります。わかった。"}, {"type": "subtitle", "time": 12724.63, "timestamp": "03:32:04", "text": "きっとeコマース関連のジョーですよね？電子商取引"}, {"type": "subtitle", "time": 12726.17, "timestamp": "03:32:06", "text": "顎。"}, {"type": "subtitle", "time": 12728.389, "timestamp": "03:32:08", "text": "[音楽]"}, {"type": "subtitle", "time": 12743.59, "timestamp": "03:32:23", "text": "これはうまくいくでしょうか？わからない。いいえ。"}, {"type": "subtitle", "time": 12746.95, "timestamp": "03:32:26", "text": "この作品？これはうまくいくと思う。うん。"}, {"type": "subtitle", "time": 12751.03, "timestamp": "03:32:31", "text": "髪の色"}, {"type": "subtitle", "time": 12753.83, "timestamp": "03:32:33", "text": "しなければならない"}, {"type": "subtitle", "time": 12755.99, "timestamp": "03:32:35", "text": "白色はありません。あ、待って。彼らは持っている"}, {"type": "subtitle", "time": 12757.59, "timestamp": "03:32:37", "text": "青みがかった。"}, {"type": "subtitle", "time": 12760.71, "timestamp": "03:32:40", "text": "これはうまくいくでしょうか？犬の腸が切れている。おお、"}, {"type": "subtitle", "time": 12764.11, "timestamp": "03:32:44", "text": "わかった。私は腸を切開したんですよね？"}, {"type": "subtitle", "time": 12776.229, "timestamp": "03:32:56", "text": "ああ、これだ。"}, {"type": "subtitle", "time": 12778.63, "timestamp": "03:32:58", "text": "いいえ、私はそういう見た目です。ええと、教授"}]
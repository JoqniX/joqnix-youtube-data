[{"type": "subtitle", "time": 16260.149, "timestamp": "04:31:00", "text": "ホグワーツと"}, {"type": "subtitle", "time": 16264.149, "timestamp": "04:31:04", "text": "城と敷地の外の世界。 M"}, {"type": "subtitle", "time": 16265.67, "timestamp": "04:31:05", "text": "確かに"}, {"type": "subtitle", "time": 16267.99, "timestamp": "04:31:07", "text": "持つことで多くのことを学ぶことができる"}, {"type": "subtitle", "time": 16272.07, "timestamp": "04:31:12", "text": "冒険心はあるが、教授たちは"}, {"type": "subtitle", "time": 16281.03, "timestamp": "04:31:21", "text": "あなたは本当に賢いですね。"}, {"type": "subtitle", "time": 16283.99, "timestamp": "04:31:23", "text": "あなたは明確に物事を振り返る能力を持っています"}, {"type": "subtitle", "time": 16287.51, "timestamp": "04:31:27", "text": "他人が困惑するようなことについて。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "そしてあなたはすでに"}, {"type": "subtitle", "time": 16291.99, "timestamp": "04:31:31", "text": "学ぶために辞めた。"}, {"type": "subtitle", "time": 16295.67, "timestamp": "04:31:35", "text": "あなたはレイブンクローにふさわしいかもしれませんね。"}, {"type": "subtitle", "time": 16298.55, "timestamp": "04:31:38", "text": "えっと、"}, {"type": "subtitle", "time": 16302.63, "timestamp": "04:31:42", "text": "私はすぐにレイブンクローに入寮できました。おお"}, {"type": "subtitle", "time": 16305.429, "timestamp": "04:31:45", "text": "我が神よ。よし、それでいいと思う"}, {"type": "subtitle", "time": 16307.349, "timestamp": "04:31:47", "text": "これですよね？"}, {"type": "subtitle", "time": 16311.349, "timestamp": "04:31:51", "text": "えっと、皆さんはこれで大丈夫だと思いますか？"}, {"type": "subtitle", "time": 16313.59, "timestamp": "04:31:53", "text": "レイブンクロー。"}, {"type": "subtitle", "time": 16315.429, "timestamp": "04:31:55", "text": "これはハリーからもらったものです"}, {"type": "subtitle", "time": 16318.149, "timestamp": "04:31:58", "text": "ハリー・ポッターのファンクラブみたいなもの。"}]
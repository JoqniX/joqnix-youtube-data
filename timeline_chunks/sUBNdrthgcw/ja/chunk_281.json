[{"type": "subtitle", "time": 16861.59, "timestamp": "04:41:01", "text": "彼が順番を待つ前に。彼は謎めいた人物だ。イチジク"}, {"type": "subtitle", "time": 16863.91, "timestamp": "04:41:03", "text": "理論について教えているが、"}, {"type": "subtitle", "time": 16865.67, "timestamp": "04:41:05", "text": "実践的な魔法についてたくさん。エニグマ。"}, {"type": "subtitle", "time": 16871.83, "timestamp": "04:41:11", "text": "彼は非常に博識だ。フィグ教授"}, {"type": "subtitle", "time": 16874.15, "timestamp": "04:41:14", "text": "うーんについてよく知っている"}, {"type": "subtitle", "time": 16876.15, "timestamp": "04:41:16", "text": "さまざまな形態の魔法。そうですね、そう願っています"}, {"type": "subtitle", "time": 16877.91, "timestamp": "04:41:17", "text": "彼はウィッグと"}, {"type": "subtitle", "time": 16880.23, "timestamp": "04:41:20", "text": "溶接。君は追いつかなきゃいけないことがたくさんあるよ、私は"}, {"type": "subtitle", "time": 16885.83, "timestamp": "04:41:25", "text": "あれが好きなのはハッフルパフじゃないの？ 1"}, {"type": "subtitle", "time": 16887.75, "timestamp": "04:41:27", "text": "英雄学への親和性は、"}, {"type": "subtitle", "time": 16889.99, "timestamp": "04:41:29", "text": "レイブンクローというよりはハッフルパフっぽいよね？"}, {"type": "subtitle", "time": 16892.47, "timestamp": "04:41:32", "text": "普通ならそうかもしれないが、私の"}, {"type": "subtitle", "time": 16894.55, "timestamp": "04:41:34", "text": "家族。私たちはこれらを全部持っています"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "故郷にいる小さな仲間たち。たぶんあなたは"}, {"type": "subtitle", "time": 16904.23, "timestamp": "04:41:44", "text": "学生が"}, {"type": "subtitle", "time": 16907.03, "timestamp": "04:41:47", "text": "自分たちで食材を栽培する？ああ、そうだね。で"}, {"type": "subtitle", "time": 16909.11, "timestamp": "04:41:49", "text": "実際、私たちの薬草学の先生、教授"}, {"type": "subtitle", "time": 16911.67, "timestamp": "04:41:51", "text": "ニンニクはそれを促進する。そして私はそうは思わない"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "シャープ教授、私たちの魔法薬の達人、"}, {"type": "subtitle", "time": 16915.67, "timestamp": "04:41:55", "text": "材料の入手先を気にする、"}]
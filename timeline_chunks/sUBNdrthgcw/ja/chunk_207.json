[{"type": "subtitle", "time": 12421.19, "timestamp": "03:27:01", "text": "そして私はレイブンクロー寮に入り、"}, {"type": "subtitle", "time": 12424.95, "timestamp": "03:27:04", "text": "杖はフェニックスの羽根で、黒色で、"}, {"type": "subtitle", "time": 12427.269, "timestamp": "03:27:07", "text": "それはこちら側です。これは、黒色です"}, {"type": "subtitle", "time": 12429.91, "timestamp": "03:27:09", "text": "トーン、そして12.5インチ。うん、"}, {"type": "subtitle", "time": 12432.79, "timestamp": "03:27:12", "text": "私が手に入れたのは、黒色のものです。"}, {"type": "subtitle", "time": 12437.11, "timestamp": "03:27:17", "text": "そして、私が所属している寮はレイブンクローです。"}, {"type": "subtitle", "time": 12438.79, "timestamp": "03:27:18", "text": "これを兄弟とは呼ばない。待って、あなたは"}, {"type": "subtitle", "time": 12441.03, "timestamp": "03:27:21", "text": "実際に？いいえ。"}, {"type": "subtitle", "time": 12446.07, "timestamp": "03:27:26", "text": "確認してみたら、見た目が悪かった。待って、"}, {"type": "subtitle", "time": 12448.87, "timestamp": "03:27:28", "text": "ざらざらした感じがわかる？"}, {"type": "subtitle", "time": 12452.229, "timestamp": "03:27:32", "text": "ああ、私はP P5を使っています。交換するのを忘れた"}, {"type": "subtitle", "time": 12455.429, "timestamp": "03:27:35", "text": "P6。私のミスです。ああ、私が直します。"}, {"type": "subtitle", "time": 12457.429, "timestamp": "03:27:37", "text": "いつもの環境に戻ったら、"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "P6をお願いします。"}, {"type": "subtitle", "time": 12463.67, "timestamp": "03:27:43", "text": "えっと、設定。すべてを置く必要がある"}, {"type": "subtitle", "time": 12466.79, "timestamp": "03:27:46", "text": "低"}, {"type": "subtitle", "time": 12472.229, "timestamp": "03:27:52", "text": "これは正しいです。"}, {"type": "subtitle", "time": 12476.71, "timestamp": "03:27:56", "text": "ウィンドウモード。うん。そして動き"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "ぼやけている。いいえ、ぼやけた映像は絶対に撮りたくありません。"}]
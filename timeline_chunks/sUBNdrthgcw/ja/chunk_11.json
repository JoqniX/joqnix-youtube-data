[{"type": "subtitle", "time": 663.11, "timestamp": "00:11:03", "text": "メーターアップデートというものがある"}, {"type": "subtitle", "time": 665.269, "timestamp": "00:11:05", "text": "YO拡張機能。すべては"}, {"type": "subtitle", "time": 667.75, "timestamp": "00:11:07", "text": "統合可能な仮想ケーブルのようなもの"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "もの。だからもう使う必要はない"}, {"type": "subtitle", "time": 675.43, "timestamp": "00:11:15", "text": "これら6本のケーブル。私は直接"}, {"type": "subtitle", "time": 681.269, "timestamp": "00:11:21", "text": "1 2 3 4 5 と"}, {"type": "subtitle", "time": 686.47, "timestamp": "00:11:26", "text": "追加で1、2、3、4、5。合計10個。"}, {"type": "subtitle", "time": 690.069, "timestamp": "00:11:30", "text": "5つの入力と5つの出力を使用できます"}, {"type": "subtitle", "time": 692.15, "timestamp": "00:11:32", "text": "1つ。"}, {"type": "subtitle", "time": 705.11, "timestamp": "00:11:45", "text": "でも、今のところは"}, {"type": "subtitle", "time": 707.829, "timestamp": "00:11:47", "text": "ご覧のとおり、私のマイクはここにあります"}, {"type": "subtitle", "time": 711.269, "timestamp": "00:11:51", "text": "B2と書いてあるし、ここにもある、ここにもある"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "信号とかも表示してるよ"}, {"type": "subtitle", "time": 719.43, "timestamp": "00:11:59", "text": "しかし実際には、送信されていません。"}]
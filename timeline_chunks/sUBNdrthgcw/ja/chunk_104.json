[{"type": "subtitle", "time": 6240.55, "timestamp": "01:44:00", "text": "うん。えっと、私が作っているから"}, {"type": "subtitle", "time": 6243.669, "timestamp": "01:44:03", "text": "円形なので、何が"}, {"type": "subtitle", "time": 6246.229, "timestamp": "01:44:06", "text": "装飾品の色は、"}, {"type": "subtitle", "time": 6247.83, "timestamp": "01:44:07", "text": "方法"}, {"type": "subtitle", "time": 6249.91, "timestamp": "01:44:09", "text": "また、明らかなクラッシュの理由は"}, {"type": "subtitle", "time": 6252.07, "timestamp": "01:44:12", "text": "ブラウザソースまたは"}, {"type": "subtitle", "time": 6254.95, "timestamp": "01:44:14", "text": "複数のグループがあるため"}, {"type": "subtitle", "time": 6257.35, "timestamp": "01:44:17", "text": "これは私がやるべきだったことだった"}, {"type": "subtitle", "time": 6259.27, "timestamp": "01:44:19", "text": "グループが多すぎるとクラッシュします"}, {"type": "subtitle", "time": 6263.27, "timestamp": "01:44:23", "text": "あなたのデータが破損しました"}, {"type": "subtitle", "time": 6266.79, "timestamp": "01:44:26", "text": "えっと、アレクサ、あなたに"}, {"type": "subtitle", "time": 6270.47, "timestamp": "01:44:30", "text": "13 は「はい」と言いました。"}, {"type": "subtitle", "time": 6274.07, "timestamp": "01:44:34", "text": "13. 何？何？ああ、赤い斑点だ。"}, {"type": "subtitle", "time": 6290.149, "timestamp": "01:44:50", "text": "うん。あなたは気づかないでしょう"}]
[{"type": "subtitle", "time": 18180.47, "timestamp": "05:03:00", "text": "現時点で。みんなは私が"}, {"type": "subtitle", "time": 18183.11, "timestamp": "05:03:03", "text": "まったく正気の沙汰ではない。サマンサは私が"}, {"type": "subtitle", "time": 18186.628, "timestamp": "05:03:06", "text": "トイレ。しかし、それはこの絵なのです。私は決して"}, {"type": "subtitle", "time": 18189.75, "timestamp": "05:03:09", "text": "以前から気づいていました。もし私がホグワーツを知っているなら、"}, {"type": "subtitle", "time": 18192.23, "timestamp": "05:03:12", "text": "そして、私はそうします、空のフレームは表示されません"}, {"type": "subtitle", "time": 18194.788, "timestamp": "05:03:14", "text": "何の理由もなく。他にも何かある"}, {"type": "subtitle", "time": 18203.59, "timestamp": "05:03:23", "text": "持続する。何か新たな発見はありましたか？"}, {"type": "subtitle", "time": 18205.03, "timestamp": "05:03:25", "text": "あなたが絵について"}, {"type": "subtitle", "time": 18207.43, "timestamp": "05:03:27", "text": "それについて勉強しているのですか？私はキャスティングを発見しました"}, {"type": "subtitle", "time": 18210.39, "timestamp": "05:03:30", "text": "ルモスには何らかの効果があるが、"}, {"type": "subtitle", "time": 18213.43, "timestamp": "05:03:33", "text": "次に何をすべきか分かりません。"}, {"type": "subtitle", "time": 18214.868, "timestamp": "05:03:34", "text": "わかった。このような絵画はありますか？"}, {"type": "subtitle", "time": 18216.39, "timestamp": "05:03:36", "text": "ここ？他にも空の絵画はありますか？"}, {"type": "subtitle", "time": 18219.75, "timestamp": "05:03:39", "text": "学校周辺はこんな感じですか？はい、いくつかあります。"}, {"type": "subtitle", "time": 18221.91, "timestamp": "05:03:41", "text": "この場所全体は、"}, {"type": "subtitle", "time": 18224.31, "timestamp": "05:03:44", "text": "正直言って、謎かけですね。もし私が運動できるなら"}, {"type": "subtitle", "time": 18226.07, "timestamp": "05:03:46", "text": "この謎を解けば、"}, {"type": "subtitle", "time": 18228.47, "timestamp": "05:03:48", "text": "それら全てに関係する。良い場所"}, {"type": "subtitle", "time": 18231.75, "timestamp": "05:03:51", "text": "まず最初に。"}, {"type": "subtitle", "time": 18233.99, "timestamp": "05:03:53", "text": "時間があれば、見てみるかもしれません。あり得る"}, {"type": "subtitle", "time": 18236.708, "timestamp": "05:03:56", "text": "興味深い。私は頭を悩ませてきた"}, {"type": "subtitle", "time": 18239.03, "timestamp": "05:03:59", "text": "十分な時間。より良い日々が訪れることを願っています"}]
[{"type": "subtitle", "time": 11341.269, "timestamp": "03:09:01", "text": "努力に感謝します。"}, {"type": "subtitle", "time": 11344.71, "timestamp": "03:09:04", "text": "私たちは最善を尽くしています。はぁ？星々が導いてくれますように"}, {"type": "subtitle", "time": 11347.67, "timestamp": "03:09:07", "text": "あなた。"}, {"type": "subtitle", "time": 11351.349, "timestamp": "03:09:11", "text": "こんにちは。というわけで、今日はここまでです。"}, {"type": "subtitle", "time": 11354.389, "timestamp": "03:09:14", "text": "28日に会いましょう。"}, {"type": "subtitle", "time": 11358.469, "timestamp": "03:09:18", "text": "バイバイ。皆さん、おやすみなさい。"}, {"type": "subtitle", "time": 11363.03, "timestamp": "03:09:23", "text": "ついに。メリークリスマス、そしてハッピーノー、"}, {"type": "subtitle", "time": 11366.07, "timestamp": "03:09:26", "text": "いや、いや。私は新年をそこで過ごします。"}, {"type": "subtitle", "time": 11367.99, "timestamp": "03:09:27", "text": "大丈夫。"}, {"type": "subtitle", "time": 11371.75, "timestamp": "03:09:31", "text": "皆さま、2023年のクリスマスおめでとうございます。全て"}]
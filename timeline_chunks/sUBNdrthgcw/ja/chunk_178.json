[{"type": "subtitle", "time": 10681.11, "timestamp": "02:58:01", "text": "つまり、人々は画像をアップロードできるということだ"}, {"type": "subtitle", "time": 10685.03, "timestamp": "02:58:05", "text": "または、彼らのDiscordを使用するか、または、それらすべて"}, {"type": "subtitle", "time": 10687.99, "timestamp": "02:58:07", "text": "もの。彼らは好きな装飾品を選ぶことができます"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "彼らが欲しい装飾品をプリセットのように。"}, {"type": "subtitle", "time": 10692.95, "timestamp": "02:58:12", "text": "そうすれば、"}, {"type": "subtitle", "time": 10696.23, "timestamp": "02:58:16", "text": "ユーザーがアップロードした場合、自動的に"}, {"type": "subtitle", "time": 10699.03, "timestamp": "02:58:19", "text": "画像を選択し、装飾品を選択します。"}, {"type": "subtitle", "time": 10702.95, "timestamp": "02:58:22", "text": "プレビューではアバターがどのように表示されるかがわかります"}, {"type": "subtitle", "time": 10705.349, "timestamp": "02:58:25", "text": "彼らが追加した写真"}, {"type": "subtitle", "time": 10707.83, "timestamp": "02:58:27", "text": "装飾品を付けた時の見た目。それから"}, {"type": "subtitle", "time": 10711.19, "timestamp": "02:58:31", "text": "彼らはそのプレビューをドラッグしたり"}, {"type": "subtitle", "time": 10713.99, "timestamp": "02:58:33", "text": "その装飾品を大きな場所に置いてください"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "クリスマスツリー。"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "だからそのクリスマスツリーには"}, {"type": "subtitle", "time": 10721.11, "timestamp": "02:58:41", "text": "各場所に容器か何かを置く"}, {"type": "subtitle", "time": 10724.07, "timestamp": "02:58:44", "text": "えっと、スポットみたいなやつ。うん。うん。まるで"}, {"type": "subtitle", "time": 10726.55, "timestamp": "02:58:46", "text": "今、木に飾った方法"}, {"type": "subtitle", "time": 10731.03, "timestamp": "02:58:51", "text": "右？私はその黄金に基づいてそれを置いた"}, {"type": "subtitle", "time": 10734.71, "timestamp": "02:58:54", "text": "星ですよね？まさにその通り。そこには"}, {"type": "subtitle", "time": 10738.23, "timestamp": "02:58:58", "text": "まるで点のように。うん。そのため、ユーザーは"}]
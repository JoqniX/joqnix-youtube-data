[{"type": "subtitle", "time": 12902.229, "timestamp": "03:35:02", "text": "アップデート？"}, {"type": "subtitle", "time": 12905.19, "timestamp": "03:35:05", "text": "なぜ？わからない。"}, {"type": "subtitle", "time": 12909.429, "timestamp": "03:35:09", "text": "動けません。動く。いいえ。"}, {"type": "subtitle", "time": 12911.03, "timestamp": "03:35:11", "text": "わかった。"}, {"type": "subtitle", "time": 12913.59, "timestamp": "03:35:13", "text": "でも、もう少し待ってください。声が聞こえるといいな"}, {"type": "subtitle", "time": 12919.59, "timestamp": "03:35:19", "text": "少しでも。今のところ、そのようなことはありません。"}, {"type": "subtitle", "time": 12923.51, "timestamp": "03:35:23", "text": "わかった。今のところクラッシュはしていない。"}, {"type": "subtitle", "time": 12925.59, "timestamp": "03:35:25", "text": "我々は信じている。"}, {"type": "subtitle", "time": 12927.75, "timestamp": "03:35:27", "text": "私がしたいのは、せめてこれだけはすることだ"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "最初の物語。"}, {"type": "subtitle", "time": 12933.75, "timestamp": "03:35:33", "text": "それだけで十分です。私は幸せです。"}, {"type": "subtitle", "time": 12942.63, "timestamp": "03:35:42", "text": "シーンを切り替える。ああ、エンコーダーが過負荷状態です。おお"}, {"type": "subtitle", "time": 12945.19, "timestamp": "03:35:45", "text": "いいえ。"}, {"type": "subtitle", "time": 12952.309, "timestamp": "03:35:52", "text": "おお。"}]
[{"type": "subtitle", "time": 11704.229, "timestamp": "03:15:04", "text": "神。すでにスクラッチ・スポーツマン。何てことだ。それで"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "えっと、どうやら私のチャットボックスが表示されていないようです。"}, {"type": "subtitle", "time": 11709.11, "timestamp": "03:15:09", "text": "はい、チャットボックスが表示されません。私はそうは思わない"}, {"type": "subtitle", "time": 11713.51, "timestamp": "03:15:13", "text": "私の荷物を持ってるよ。できないんです"}, {"type": "subtitle", "time": 11715.11, "timestamp": "03:15:15", "text": "私をからかってるの？私は字も読めない"}, {"type": "subtitle", "time": 11716.79, "timestamp": "03:15:16", "text": "チャット。"}, {"type": "subtitle", "time": 11719.429, "timestamp": "03:15:19", "text": "待って。私をからかってるの？"}, {"type": "subtitle", "time": 11728.15, "timestamp": "03:15:28", "text": "いや、そんなことは私にしないで。何てことだ。"}, {"type": "subtitle", "time": 11734.79, "timestamp": "03:15:34", "text": "大丈夫ですか？待って。わかった。こんにちは。えっと、"}, {"type": "subtitle", "time": 11739.59, "timestamp": "03:15:39", "text": "私の人生の全存在において"}, {"type": "subtitle", "time": 11742.95, "timestamp": "03:15:42", "text": "ストリーミングのキャリアで、あるいはこれが"}, {"type": "subtitle", "time": 11746.469, "timestamp": "03:15:46", "text": "ストリーミング配信のキャリアも？わかりません、"}, {"type": "subtitle", "time": 11749.51, "timestamp": "03:15:49", "text": "男。えっと、"}, {"type": "subtitle", "time": 11753.269, "timestamp": "03:15:53", "text": "いろいろ見落としているものがあるよね？"}, {"type": "subtitle", "time": 11755.269, "timestamp": "03:15:55", "text": "そうそう。えっと、"}, {"type": "subtitle", "time": 11757.429, "timestamp": "03:15:57", "text": "背景にはどんな工夫をすればいいでしょうか？"}]
[{"type": "subtitle", "time": 7861.83, "timestamp": "02:11:01", "text": "こんな感じで。ああ、別の言い方をすれば"}, {"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "同じように考えていた"}, {"type": "subtitle", "time": 7868.229, "timestamp": "02:11:08", "text": "実際に"}, {"type": "subtitle", "time": 7871.109, "timestamp": "02:11:11", "text": "ウェブサイト上でカスタマイズ可能。覚えてるよ"}, {"type": "subtitle", "time": 7874.39, "timestamp": "02:11:14", "text": "ウェブサイトって何？"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "ウェブサイトから再度呼び出しがありましたか？"}, {"type": "subtitle", "time": 7880.709, "timestamp": "02:11:20", "text": "待って。えっと、ウェブサイトは"}, {"type": "subtitle", "time": 7886.47, "timestamp": "02:11:26", "text": "待って、悪いところはなかった"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "え、何？待って、あれは何て言うの？"}, {"type": "subtitle", "time": 7890.629, "timestamp": "02:11:30", "text": "Webサイト？えっと"}, {"type": "subtitle", "time": 7899.35, "timestamp": "02:11:39", "text": "あれはどれでどれだったっけ？"}, {"type": "subtitle", "time": 7904.95, "timestamp": "02:11:44", "text": "うん。ああ、これだ。それで私は考えていた"}, {"type": "subtitle", "time": 7906.709, "timestamp": "02:11:46", "text": "こんな感じ。"}, {"type": "subtitle", "time": 7910.39, "timestamp": "02:11:50", "text": "誰かを作ろうと思ったまさにその場所で"}, {"type": "subtitle", "time": 7911.83, "timestamp": "02:11:51", "text": "可能かどうかわかりません"}, {"type": "subtitle", "time": 7914.149, "timestamp": "02:11:54", "text": "フレームワークやウェブスタジオのようなものだが"}, {"type": "subtitle", "time": 7915.83, "timestamp": "02:11:55", "text": "こんな感じになります。"}, {"type": "subtitle", "time": 7918.629, "timestamp": "02:11:58", "text": "装飾品はすべてここにあり、"}]
[{"type": "subtitle", "time": 12966.229, "timestamp": "03:36:06", "text": "私"}, {"type": "subtitle", "time": 12969.03, "timestamp": "03:36:09", "text": "であるはず"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "ああ、大変だ。ちょっと待って。"}, {"type": "subtitle", "time": 12974.71, "timestamp": "03:36:14", "text": "お願いします"}, {"type": "subtitle", "time": 12977.429, "timestamp": "03:36:17", "text": "私に主導権を握らせてください。"}, {"type": "subtitle", "time": 12980.87, "timestamp": "03:36:20", "text": "私が必要なのは、"}, {"type": "subtitle", "time": 13000.229, "timestamp": "03:36:40", "text": "なんてこった。なんてこった。なんてこった。いいえ。私は生放送中ですか？"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "私はすでに私はすでに私はすでに"}, {"type": "subtitle", "time": 13007.99, "timestamp": "03:36:47", "text": "今、30分も無駄にしている。何てことだ。"}, {"type": "subtitle", "time": 13011.83, "timestamp": "03:36:51", "text": "私はそのゲームをプレイしたい。私が欲しいのは"}, {"type": "subtitle", "time": 13013.75, "timestamp": "03:36:53", "text": "悪い。"}]
[{"type": "subtitle", "time": 11160.309, "timestamp": "03:06:00", "text": "物、えっと、それはレンタルかもしれないし、たくさん死んでるかもしれない"}, {"type": "subtitle", "time": 11163.19, "timestamp": "03:06:03", "text": "感度の切り替えなど"}, {"type": "subtitle", "time": 11168.55, "timestamp": "03:06:08", "text": "たくさん。装飾を施しました"}, {"type": "subtitle", "time": 11171.51, "timestamp": "03:06:11", "text": "そして、家族のためのクリスマスツリー"}, {"type": "subtitle", "time": 11175.349, "timestamp": "03:06:15", "text": "クリスマスツリー。ええ、そうなんです。"}, {"type": "subtitle", "time": 11178.15, "timestamp": "03:06:18", "text": "とても楽しかったです。"}, {"type": "subtitle", "time": 11182.79, "timestamp": "03:06:22", "text": "どうしたの？それでは、28日にお会いしましょう。"}, {"type": "subtitle", "time": 11186.79, "timestamp": "03:06:26", "text": "もしできるなら、私は叫んでみるだろう"}, {"type": "subtitle", "time": 11198.309, "timestamp": "03:06:38", "text": "でも、スプレーして、ああ"}, {"type": "subtitle", "time": 11200.87, "timestamp": "03:06:40", "text": "私のPC両方に何も起こらないのは"}, {"type": "subtitle", "time": 11204.15, "timestamp": "03:06:44", "text": "私は5日間旅行に出かけますが、8日間は行きません"}, {"type": "subtitle", "time": 11205.91, "timestamp": "03:06:45", "text": "日"}, {"type": "subtitle", "time": 11208.15, "timestamp": "03:06:48", "text": "明日以降。ああ、もう"}, {"type": "subtitle", "time": 11211.349, "timestamp": "03:06:51", "text": "明日。もう22日ですね。ああ、"}, {"type": "subtitle", "time": 11214.95, "timestamp": "03:06:54", "text": "本日より。ええ、今夜から"}, {"type": "subtitle", "time": 11217.269, "timestamp": "03:06:57", "text": "27日、28日。"}, {"type": "subtitle", "time": 11219.83, "timestamp": "03:06:59", "text": "そう、PCちゃんやジョイには会えないよ。"}]
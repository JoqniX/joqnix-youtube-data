[{"type": "subtitle", "time": 17280.07, "timestamp": "04:48:00", "text": "何"}, {"type": "subtitle", "time": 17283.27, "timestamp": "04:48:03", "text": "了解です。"}, {"type": "subtitle", "time": 17286.07, "timestamp": "04:48:06", "text": "課題。"}, {"type": "subtitle", "time": 17288.39, "timestamp": "04:48:08", "text": "ああ、これはそこから入手したんだ。わかった。わかった。"}, {"type": "subtitle", "time": 17296.55, "timestamp": "04:48:16", "text": "賢いでしょう？目を離さないで"}, {"type": "subtitle", "time": 17299.67, "timestamp": "04:48:19", "text": "内部でそのような機会をさらに増やす"}, {"type": "subtitle", "time": 17302.708, "timestamp": "04:48:22", "text": "そして外では"}, {"type": "subtitle", "time": 17304.94, "timestamp": "04:48:24", "text": "H"}, {"type": "subtitle", "time": 17306.47, "timestamp": "04:48:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17310.47, "timestamp": "04:48:30", "text": "お茶。このお茶は何ですか？"}, {"type": "subtitle", "time": 17312.708, "timestamp": "04:48:32", "text": "ルモス。"}, {"type": "subtitle", "time": 17314.948, "timestamp": "04:48:34", "text": "ああ、これらはあなたが使える呪文です。おお。"}, {"type": "subtitle", "time": 17318.38, "timestamp": "04:48:38", "text": "おお、それはいいですね。"}, {"type": "subtitle", "time": 17320.31, "timestamp": "04:48:40", "text": "[音楽]"}, {"type": "subtitle", "time": 17324.07, "timestamp": "04:48:44", "text": "無駄に専門家になるのが待ちきれない"}, {"type": "subtitle", "time": 17326.868, "timestamp": "04:48:46", "text": "魔法使いと、ご存知のように探検して"}, {"type": "subtitle", "time": 17330.23, "timestamp": "04:48:50", "text": "モンスターと戦ったり、いろいろなものやレベルを楽しんだりする"}, {"type": "subtitle", "time": 17333.43, "timestamp": "04:48:53", "text": "最大100くらいまで上げてください。それは"}]
[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "通常の魔法使いレベル試験。彼らは"}, {"type": "subtitle", "time": 16983.03, "timestamp": "04:43:03", "text": "どのようなキャリアを歩むかを決める"}, {"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "ここを去るときに手に入れることができます。たくさん"}, {"type": "subtitle", "time": 16987.51, "timestamp": "04:43:07", "text": "校長先生との話し合いと"}, {"type": "subtitle", "time": 16989.35, "timestamp": "04:43:09", "text": "魔法教育学部"}, {"type": "subtitle", "time": 16991.83, "timestamp": "04:43:11", "text": "省庁は、何かを考案しました"}, {"type": "subtitle", "time": 16994.868, "timestamp": "04:43:14", "text": "あなたの成功を確実にするために、並外れた努力をします。"}, {"type": "subtitle", "time": 16997.51, "timestamp": "04:43:17", "text": "わかった、"}, {"type": "subtitle", "time": 17017.91, "timestamp": "04:43:37", "text": "それは何ですか？ここは魔法使いの領域だ"}, {"type": "subtitle", "time": 17020.31, "timestamp": "04:43:40", "text": "ガイド。これは、"}, {"type": "subtitle", "time": 17022.47, "timestamp": "04:43:42", "text": "あなたが学んでいることをマスターするために"}, {"type": "subtitle", "time": 17026.15, "timestamp": "04:43:46", "text": "5年生に期待されることはすべてこなす。"}, {"type": "subtitle", "time": 17028.23, "timestamp": "04:43:48", "text": "最大限に活用するのが賢明でしょう"}, {"type": "subtitle", "time": 17030.868, "timestamp": "04:43:50", "text": "この非常に貴重なもの。くそ、俺は"}, {"type": "subtitle", "time": 17038.55, "timestamp": "04:43:58", "text": "教授、ありがとうございます。でも、"}]
[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "ドラッグして、好きな場所に置いてください"}, {"type": "subtitle", "time": 10745.19, "timestamp": "02:59:05", "text": "好きな場所を選んでクリックし、確認する"}, {"type": "subtitle", "time": 10747.67, "timestamp": "02:59:07", "text": "そして彼らは、"}, {"type": "subtitle", "time": 10749.99, "timestamp": "02:59:09", "text": "その位置を編集するか、変更する"}, {"type": "subtitle", "time": 10752.309, "timestamp": "02:59:12", "text": "後で気に入らなければ、その他"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "人々はそれを置いたりできない。"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "うん。うん。そして、そして、そして、もし"}, {"type": "subtitle", "time": 10762.87, "timestamp": "02:59:22", "text": "たくさんの人が、"}, {"type": "subtitle", "time": 10765.269, "timestamp": "02:59:25", "text": "彼らを、彼らを、彼らを、彼らを、彼らを"}, {"type": "subtitle", "time": 10767.269, "timestamp": "02:59:27", "text": "木の大きさのオーナメント"}, {"type": "subtitle", "time": 10770.15, "timestamp": "02:59:30", "text": "増加するとか、そういうこと。うん。うん。"}, {"type": "subtitle", "time": 10773.91, "timestamp": "02:59:33", "text": "うん。だから、もっとスペースを空けるために、"}, {"type": "subtitle", "time": 10777.19, "timestamp": "02:59:37", "text": "知らない何か、それはまるで"}, {"type": "subtitle", "time": 10781.269, "timestamp": "02:59:41", "text": "多くの。わからない、複雑なのはわかっているけど"}, {"type": "subtitle", "time": 10783.91, "timestamp": "02:59:43", "text": "うん、それはいいアイデアだね"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "少しでも。何てことだ。"}, {"type": "subtitle", "time": 10789.11, "timestamp": "02:59:49", "text": "すると、それはたった3つだけです"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "もの。いいえ。では、その後はどうなるのですか？ええと、私たちはできます"}, {"type": "subtitle", "time": 10796.07, "timestamp": "02:59:56", "text": "フォートナイトがやったような"}, {"type": "subtitle", "time": 10798.389, "timestamp": "02:59:58", "text": "このような。 3つ以上手に入れることができます"}]
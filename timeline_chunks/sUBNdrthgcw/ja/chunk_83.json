[{"type": "subtitle", "time": 4982.07, "timestamp": "01:23:02", "text": "良い。アシャマは、あなたが何をしたのか不思議に思った。"}, {"type": "subtitle", "time": 4985.83, "timestamp": "01:23:05", "text": "もう一度欲しいですか？えっと、あなたは言った"}, {"type": "subtitle", "time": 4988.31, "timestamp": "01:23:08", "text": "チッピーチャパ。いいえ"}, {"type": "subtitle", "time": 4991.03, "timestamp": "01:23:11", "text": "青い縞模様。"}, {"type": "subtitle", "time": 4994.629, "timestamp": "01:23:14", "text": "青いストライプはどれだったっけ？"}, {"type": "subtitle", "time": 5017.669, "timestamp": "01:23:37", "text": "よし、これで終わりだ。"}, {"type": "subtitle", "time": 5019.669, "timestamp": "01:23:39", "text": "えっと、次は誰ですか？"}, {"type": "subtitle", "time": 5022.31, "timestamp": "01:23:42", "text": "今すぐハイライト表示。ええと、そうします"}, {"type": "subtitle", "time": 5024.79, "timestamp": "01:23:44", "text": "最後"}, {"type": "subtitle", "time": 5034.07, "timestamp": "01:23:54", "text": "アストロ・チャマ。"}, {"type": "subtitle", "time": 5037.11, "timestamp": "01:23:57", "text": "私は14が欲しいです。"}]
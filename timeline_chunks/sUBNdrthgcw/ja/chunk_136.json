[{"type": "subtitle", "time": 8160.95, "timestamp": "02:16:00", "text": "さて、これはランダムですが、"}, {"type": "subtitle", "time": 8163.35, "timestamp": "02:16:03", "text": "大丈夫です。全員を"}, {"type": "subtitle", "time": 8173.83, "timestamp": "02:16:13", "text": "えっと、20歳だから、そうしようかな。"}, {"type": "subtitle", "time": 8180.709, "timestamp": "02:16:20", "text": "スペースか何かを入れます。"}, {"type": "subtitle", "time": 8212.469, "timestamp": "02:16:52", "text": "これはいいえだと思います。私はこれが必要だと思います。"}, {"type": "subtitle", "time": 8215.509, "timestamp": "02:16:55", "text": "その部分が混雑しているように感じる。"}, {"type": "subtitle", "time": 8217.99, "timestamp": "02:16:57", "text": "待って。だから私はここでできると思う"}, {"type": "subtitle", "time": 8219.83, "timestamp": "02:16:59", "text": "もっと入れる"}]
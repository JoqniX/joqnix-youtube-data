[{"type": "subtitle", "time": 8663.429, "timestamp": "02:24:23", "text": "どれも可愛いですね。待って、これは何だ？"}, {"type": "subtitle", "time": 8668.07, "timestamp": "02:24:28", "text": "イベント？私は確かにこれをクリックしました。はい。"}, {"type": "subtitle", "time": 8671.19, "timestamp": "02:24:31", "text": "スキルレベルアップしてスキルを上げましょう。各クラスには"}, {"type": "subtitle", "time": 8674.71, "timestamp": "02:24:34", "text": "3つの基本スキルを身につけてスタートする。"}, {"type": "subtitle", "time": 8676.63, "timestamp": "02:24:36", "text": "猫のレベルを上げると、"}, {"type": "subtitle", "time": 8678.63, "timestamp": "02:24:38", "text": "あなたの基礎スキルの最大レベル。レベルアップ"}, {"type": "subtitle", "time": 8682.95, "timestamp": "02:24:42", "text": "あなたのスキルを活かして、ヒーローをより強くしましょう。"}, {"type": "subtitle", "time": 8684.71, "timestamp": "02:24:44", "text": "サーバーからの応答がありません。インストールできません"}, {"type": "subtitle", "time": 8688.79, "timestamp": "02:24:48", "text": "8%で止まっています。なんてこった。ええ、そうですね。えっと、破片"}, {"type": "subtitle", "time": 8693.19, "timestamp": "02:24:53", "text": "男の息子。ああ、あなたがする必要があるのは"}, {"type": "subtitle", "time": 8695.429, "timestamp": "02:24:55", "text": "ゲームを携帯電話にインストールする"}, {"type": "subtitle", "time": 8698.23, "timestamp": "02:24:58", "text": "初め。ゲーム全体をダウンロードしてください。えっと、私は"}]
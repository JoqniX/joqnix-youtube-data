[{"type": "subtitle", "time": 7027.43, "timestamp": "01:57:07", "text": "何てことだ。"}, {"type": "subtitle", "time": 7029.51, "timestamp": "01:57:09", "text": "どこでもズームできます。それでも"}, {"type": "subtitle", "time": 7032.629, "timestamp": "01:57:12", "text": "受信機を動作させる。一体どういうことだ？それ"}, {"type": "subtitle", "time": 7036.95, "timestamp": "01:57:16", "text": "すごくかっこいい。たぶん、えっと"}, {"type": "subtitle", "time": 7041.189, "timestamp": "01:57:21", "text": "うん。だからアイデアの一つは、"}, {"type": "subtitle", "time": 7043.27, "timestamp": "01:57:23", "text": "どちらか、まだ作業中だから"}, {"type": "subtitle", "time": 7046.629, "timestamp": "01:57:26", "text": "未来のためのウェブサイトだが、"}, {"type": "subtitle", "time": 7049.27, "timestamp": "01:57:29", "text": "チャットでアクティブになっている人は誰でも"}, {"type": "subtitle", "time": 7052.709, "timestamp": "01:57:32", "text": "チャットに来たので、ある意味では"}, {"type": "subtitle", "time": 7054.95, "timestamp": "01:57:34", "text": "ストリーム参加者"}, {"type": "subtitle", "time": 7056.629, "timestamp": "01:57:36", "text": "うん"}, {"type": "subtitle", "time": 7058.55, "timestamp": "01:57:38", "text": "それで、えーと、入力するだけでいいんです"}, {"type": "subtitle", "time": 7061.51, "timestamp": "01:57:41", "text": "何か、そう、そうやって"}, {"type": "subtitle", "time": 7063.189, "timestamp": "01:57:43", "text": "知る"}, {"type": "subtitle", "time": 7076.229, "timestamp": "01:57:56", "text": "男。"}, {"type": "subtitle", "time": 7079.669, "timestamp": "01:57:59", "text": "うん、次回は自分の考え通りにやってみるよ"}]
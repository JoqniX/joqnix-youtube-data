[{"type": "subtitle", "time": 16155.75, "timestamp": "04:29:15", "text": "ああ、彼が来る。"}, {"type": "subtitle", "time": 16158.149, "timestamp": "04:29:18", "text": "フィニアス・ニゲリス"}, {"type": "subtitle", "time": 16161.99, "timestamp": "04:29:21", "text": "黒。準備する"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "図。ご参加いただきありがとうございます。分類"}, {"type": "subtitle", "time": 16175.59, "timestamp": "04:29:35", "text": "式典は終了しました。あった"}, {"type": "subtitle", "time": 16178.229, "timestamp": "04:29:38", "text": "合併症。合併症。"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "ゴブリンの問題のようです。ゴブリン。私"}, {"type": "subtitle", "time": 16183.189, "timestamp": "04:29:43", "text": "噂話に構っている暇はないよ、フィグ。そして私は"}, {"type": "subtitle", "time": 16185.269, "timestamp": "04:29:45", "text": "残っていた忍耐力が急速に失われていく"}, {"type": "subtitle", "time": 16189.03, "timestamp": "04:29:49", "text": "左。何てことだ。運が良ければ、"}, {"type": "subtitle", "time": 16191.03, "timestamp": "04:29:51", "text": "まだ解決できるかもしれません"}]
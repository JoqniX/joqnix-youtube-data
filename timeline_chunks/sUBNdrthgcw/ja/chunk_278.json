[{"type": "subtitle", "time": 16682.551, "timestamp": "04:38:02", "text": "イントロ、アメスについて自己紹介してください。"}, {"type": "subtitle", "time": 16686.23, "timestamp": "04:38:06", "text": "ここは本当に素敵な場所だ。何が"}, {"type": "subtitle", "time": 16687.91, "timestamp": "04:38:07", "text": "電話がかかってきたの？この幽霊の女性は一体誰？"}, {"type": "subtitle", "time": 16698.869, "timestamp": "04:38:18", "text": "[音楽]"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "最後になると思う。よし、この深い"}, {"type": "subtitle", "time": 16708.629, "timestamp": "04:38:28", "text": "ここで息を吸ってください。"}, {"type": "subtitle", "time": 16712.949, "timestamp": "04:38:32", "text": "なぜ？こんにちは。ああ、あれはインディアンだ"}, {"type": "subtitle", "time": 16716.39, "timestamp": "04:38:36", "text": "GPUの不具合を修正しました。いいえ、修正されていません。"}, {"type": "subtitle", "time": 16719.029, "timestamp": "04:38:39", "text": "こんにちは、ズキ。元気ですか？私は私は"}, {"type": "subtitle", "time": 16721.349, "timestamp": "04:38:41", "text": "同じPCでストリーミングとゲームをするので、"}, {"type": "subtitle", "time": 16724.949, "timestamp": "04:38:44", "text": "動作がもたついてて、ちょっとイライラする。そこで、"}, {"type": "subtitle", "time": 16726.789, "timestamp": "04:38:46", "text": "一時的"}, {"type": "subtitle", "time": 16728.39, "timestamp": "04:38:48", "text": "今まで会ったことがないけど、このストリーム"}, {"type": "subtitle", "time": 16730.23, "timestamp": "04:38:50", "text": "3回クラッシュした。言えない"}, {"type": "subtitle", "time": 16732.47, "timestamp": "04:38:52", "text": "率直に言って、お勧めします。だから、私は"}, {"type": "subtitle", "time": 16734.551, "timestamp": "04:38:54", "text": "お会いしましょう。うまくいっています。あなたは"}, {"type": "subtitle", "time": 16737.83, "timestamp": "04:38:57", "text": "天文学のように。ああ、そうだね。たくさんのこと"}, {"type": "subtitle", "time": 16739.99, "timestamp": "04:38:59", "text": "星々から学んだ。はい。あなたは"}]
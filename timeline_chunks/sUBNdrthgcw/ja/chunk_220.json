[{"type": "subtitle", "time": 13203.67, "timestamp": "03:40:03", "text": "ジョックパンツみたいにフィットする？"}, {"type": "subtitle", "time": 13207.19, "timestamp": "03:40:07", "text": "基本的なものを選びます。"}, {"type": "subtitle", "time": 13215.51, "timestamp": "03:40:15", "text": "私はこれにします。"}, {"type": "subtitle", "time": 13225.67, "timestamp": "03:40:25", "text": "うん。白。それは私です。わかった。それで、えーと、今"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "次にヘアスタイルです。"}, {"type": "subtitle", "time": 13231.91, "timestamp": "03:40:31", "text": "これでいいでしょうか？のように見えるか"}, {"type": "subtitle", "time": 13239.269, "timestamp": "03:40:39", "text": "これはまるでハリー・ポッターのようだ。いや、いや。これ"}, {"type": "subtitle", "time": 13253.75, "timestamp": "03:40:53", "text": "皆さんはどちらが欲しいですか？"}, {"type": "subtitle", "time": 13256.71, "timestamp": "03:40:56", "text": "こんな感じで進めたい。"}]
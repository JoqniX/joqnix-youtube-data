[{"type": "subtitle", "time": 3003.349, "timestamp": "00:50:03", "text": "番号を選択してください。"}, {"type": "subtitle", "time": 3013.27, "timestamp": "00:50:13", "text": "お好きな色をお選びください。"}, {"type": "subtitle", "time": 3015.43, "timestamp": "00:50:15", "text": "君のことだから、青か"}, {"type": "subtitle", "time": 3020.309, "timestamp": "00:50:20", "text": "えっと"}, {"type": "subtitle", "time": 3022.47, "timestamp": "00:50:22", "text": "チマを知っているなら、それは"}, {"type": "subtitle", "time": 3026.63, "timestamp": "00:50:26", "text": "青、紫。うん。ちょっと待って。"}, {"type": "subtitle", "time": 3031.75, "timestamp": "00:50:31", "text": "ここに何を置いたっけ？ああ、間違いだった。"}, {"type": "subtitle", "time": 3040.23, "timestamp": "00:50:40", "text": "えっと、"}, {"type": "subtitle", "time": 3050.04, "timestamp": "00:50:50", "text": "13."}, {"type": "subtitle", "time": 3052.23, "timestamp": "00:50:52", "text": "[音楽]"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "みんななんで選ぶんだよ、兄弟？なぜなら"}, {"type": "subtitle", "time": 3058.15, "timestamp": "00:50:58", "text": "彼らはそれを気に入っている。セブン。"}]
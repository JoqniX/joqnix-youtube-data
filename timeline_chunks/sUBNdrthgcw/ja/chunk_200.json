[{"type": "subtitle", "time": 12002.87, "timestamp": "03:20:02", "text": "ネジ式ではないと思います。そう願っています。"}, {"type": "subtitle", "time": 12006.15, "timestamp": "03:20:06", "text": "でも、ええ、それで、本当に必要だったんです"}, {"type": "subtitle", "time": 12009.91, "timestamp": "03:20:09", "text": "携帯電話のような小さなドライバー"}, {"type": "subtitle", "time": 12012.469, "timestamp": "03:20:12", "text": "そういう類のもの。とても小さい"}, {"type": "subtitle", "time": 12015.429, "timestamp": "03:20:15", "text": "ドライバーでねじを締める。いいえ、ネジ"}, {"type": "subtitle", "time": 12018.71, "timestamp": "03:20:18", "text": "グラフィックカード（GPU）のネジを外します"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "ファンみたいなもの。そう、私はとても悩んでいました"}, {"type": "subtitle", "time": 12025.67, "timestamp": "03:20:25", "text": "それで私は外に出た、"}, {"type": "subtitle", "time": 12028.389, "timestamp": "03:20:28", "text": "あらゆる場所を探したが、すでに"}, {"type": "subtitle", "time": 12033.99, "timestamp": "03:20:33", "text": "午後5時5分6秒ここ。えっと"}, {"type": "subtitle", "time": 12038.389, "timestamp": "03:20:38", "text": "悲しいことだが、痛みはある。"}, {"type": "subtitle", "time": 12041.429, "timestamp": "03:20:41", "text": "悲しいことですが"}, {"type": "subtitle", "time": 12043.51, "timestamp": "03:20:43", "text": "ええ、どこにも手に入りませんでした"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "それと私が言ったすべての店の皆が"}, {"type": "subtitle", "time": 12050.389, "timestamp": "03:20:50", "text": "明日の朝に来たら、私はこう言うだろう"}, {"type": "subtitle", "time": 12053.59, "timestamp": "03:20:53", "text": "でも、それでも、私たちはこれについて聞いています"}, {"type": "subtitle", "time": 12055.99, "timestamp": "03:20:55", "text": "それでは早速始めましょう"}, {"type": "subtitle", "time": 12058.55, "timestamp": "03:20:58", "text": "史上初のストリーミング配信"}]
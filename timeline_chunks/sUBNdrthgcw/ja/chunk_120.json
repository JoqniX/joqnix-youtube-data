[{"type": "subtitle", "time": 7200.149, "timestamp": "02:00:00", "text": "ああ、私は"}, {"type": "subtitle", "time": 7205.03, "timestamp": "02:00:05", "text": "Zoomレシーバーを使用する必要がある"}, {"type": "subtitle", "time": 7209.669, "timestamp": "02:00:09", "text": "あれを送ってくれ。よし、うまくいった。"}, {"type": "subtitle", "time": 7212.149, "timestamp": "02:00:12", "text": "なるほど、じゃあショーンの件は全部そういうことか。さあ"}, {"type": "subtitle", "time": 7214.629, "timestamp": "02:00:14", "text": "やってみて。"}, {"type": "subtitle", "time": 7218.07, "timestamp": "02:00:18", "text": "つまり、グループ関連のことか"}, {"type": "subtitle", "time": 7221.91, "timestamp": "02:00:21", "text": "これは何が原因で起こっているのか、それとも何か別の原因なのか"}, {"type": "subtitle", "time": 7224.87, "timestamp": "02:00:24", "text": "ともかくとも。分かりません。"}, {"type": "subtitle", "time": 7228.229, "timestamp": "02:00:28", "text": "一周しました。わかった。えっと、どれが"}, {"type": "subtitle", "time": 7230.55, "timestamp": "02:00:30", "text": "欲しいの？装飾品からも"}, {"type": "subtitle", "time": 7234.149, "timestamp": "02:00:34", "text": "アラビも私に知らせてください。わかった。"}, {"type": "subtitle", "time": 7236.95, "timestamp": "02:00:36", "text": "あなたのプロフィールを取得させてください。Twitch"}, {"type": "subtitle", "time": 7238.55, "timestamp": "02:00:38", "text": "プロフィール。"}, {"type": "subtitle", "time": 7240.47, "timestamp": "02:00:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 7243.99, "timestamp": "02:00:43", "text": "猫です。"}, {"type": "subtitle", "time": 7251.109, "timestamp": "02:00:51", "text": "ああ、待って、忘れてた。なぜ私はそれを置いたのか"}, {"type": "subtitle", "time": 7254.47, "timestamp": "02:00:54", "text": "こちらですか？なんてこった。それは"}, {"type": "subtitle", "time": 7257.12, "timestamp": "02:00:57", "text": "こちらです。"}]
[{"type": "subtitle", "time": 2344.87, "timestamp": "00:39:04", "text": "私が最も望まないことは、それを望むことです"}, {"type": "subtitle", "time": 2348.23, "timestamp": "00:39:08", "text": "打ちのめされる。そこが問題なんです。"}, {"type": "subtitle", "time": 2354.63, "timestamp": "00:39:14", "text": "つまり、このゴーアバターは、"}, {"type": "subtitle", "time": 2357.91, "timestamp": "00:39:17", "text": "これをやっている。 300回できる"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "300倍。"}, {"type": "subtitle", "time": 2362.55, "timestamp": "00:39:22", "text": "それはどんな感じになるだろうか？"}, {"type": "subtitle", "time": 2366.95, "timestamp": "00:39:26", "text": "それは実に素晴らしいですね。ニース。"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "それでいいでしょう。"}, {"type": "subtitle", "time": 2372.23, "timestamp": "00:39:32", "text": "それでいきましょう。"}, {"type": "subtitle", "time": 2376.79, "timestamp": "00:39:36", "text": "俺たち、すごく変わったよ。うん。私たちはそうだったのでしょうか？"}, {"type": "subtitle", "time": 2378.95, "timestamp": "00:39:38", "text": "ええ、私たちは変わりました。"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "うん。"}, {"type": "subtitle", "time": 2383.43, "timestamp": "00:39:43", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 2386.87, "timestamp": "00:39:46", "text": "名前を変えて「忍者」と入れてください。"}, {"type": "subtitle", "time": 2390.39, "timestamp": "00:39:50", "text": "次は誰だ？クロノス"}]
[{"type": "subtitle", "time": 9182.79, "timestamp": "02:33:02", "text": "難しい"}, {"type": "subtitle", "time": 9187.11, "timestamp": "02:33:07", "text": "将来のスポーツマンには難しすぎるよ"}, {"type": "subtitle", "time": 9189.83, "timestamp": "02:33:09", "text": "これらのことを行うとき。"}, {"type": "subtitle", "time": 9191.59, "timestamp": "02:33:11", "text": "[音楽]"}, {"type": "subtitle", "time": 9194.15, "timestamp": "02:33:14", "text": "そうですね、もし特定の"}, {"type": "subtitle", "time": 9196.389, "timestamp": "02:33:16", "text": "ご希望の装飾品があればお知らせください。"}, {"type": "subtitle", "time": 9198.71, "timestamp": "02:33:18", "text": "ここから、さもなければ私はただ選ぶだけです"}, {"type": "subtitle", "time": 9202.95, "timestamp": "02:33:22", "text": "ランダムに選ばれるよ、えっと、私が選ぶよ"}, {"type": "subtitle", "time": 9207.19, "timestamp": "02:33:27", "text": "ランダムに選ばれたものみたいに。ランダム化します"}]
[{"type": "subtitle", "time": 19081.03, "timestamp": "05:18:01", "text": "ああ、なんてことだ、彼は"}, {"type": "subtitle", "time": 19083.75, "timestamp": "05:18:03", "text": "ああ、彼は"}, {"type": "subtitle", "time": 19087.27, "timestamp": "05:18:07", "text": "ポップな障害物みたいなもの。では、"}, {"type": "subtitle", "time": 19097.11, "timestamp": "05:18:17", "text": "[音楽]"}, {"type": "subtitle", "time": 19099.19, "timestamp": "05:18:19", "text": "チョップリングって何？"}, {"type": "subtitle", "time": 19105.11, "timestamp": "05:18:25", "text": "魅力的だ。ターゲットを近づける"}, {"type": "subtitle", "time": 19108.47, "timestamp": "05:18:28", "text": "キャスト。キャストするには、割り当てキーをタップしてください。"}, {"type": "subtitle", "time": 19110.07, "timestamp": "05:18:30", "text": "そして、ターゲットをより近くに引き寄せる。キーをタップ"}, {"type": "subtitle", "time": 19113.35, "timestamp": "05:18:33", "text": "またしてもビー玉を投げ捨てることになった。あなた"}, {"type": "subtitle", "time": 19116.47, "timestamp": "05:18:36", "text": "彼らを召喚している。"}, {"type": "subtitle", "time": 19131.67, "timestamp": "05:18:51", "text": "絶対に転ぶなよ。何てことだ。"}, {"type": "subtitle", "time": 19134.39, "timestamp": "05:18:54", "text": "とても良い。レイヴンロにポイント。"}, {"type": "subtitle", "time": 19135.99, "timestamp": "05:18:55", "text": "しかし、スポーツは確かにありません"}, {"type": "subtitle", "time": 19137.43, "timestamp": "05:18:57", "text": "友達なしでプレイする"}]
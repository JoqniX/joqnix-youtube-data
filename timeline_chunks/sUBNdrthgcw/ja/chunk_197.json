[{"type": "subtitle", "time": 11821.59, "timestamp": "03:17:01", "text": "えっと、"}, {"type": "subtitle", "time": 11823.67, "timestamp": "03:17:03", "text": "これを少し集めてみたい。私"}, {"type": "subtitle", "time": 11832.79, "timestamp": "03:17:12", "text": "よし、これで大丈夫だろう。よし。"}, {"type": "subtitle", "time": 11835.75, "timestamp": "03:17:15", "text": "とにかく、今日はそうでない人たちのために"}, {"type": "subtitle", "time": 11840.55, "timestamp": "03:17:20", "text": "さて、これからホグウォッチをプレイします。"}, {"type": "subtitle", "time": 11841.91, "timestamp": "03:17:21", "text": "うん。ええ、私たちはプレイします"}, {"type": "subtitle", "time": 11844.15, "timestamp": "03:17:24", "text": "ホグワーツ。"}, {"type": "subtitle", "time": 11847.67, "timestamp": "03:17:27", "text": "えっと"}, {"type": "subtitle", "time": 11849.99, "timestamp": "03:17:29", "text": "今日の配信は思慮深いスクラッチです"}, {"type": "subtitle", "time": 11853.03, "timestamp": "03:17:33", "text": "まず最初に"}, {"type": "subtitle", "time": 11856.309, "timestamp": "03:17:36", "text": "ぜひ教えてください"}, {"type": "subtitle", "time": 11859.19, "timestamp": "03:17:39", "text": "音声が聞こえた場合、または聞こえない場合は"}, {"type": "subtitle", "time": 11862.87, "timestamp": "03:17:42", "text": "音声、どんな音でも聞こえる"}, {"type": "subtitle", "time": 11867.349, "timestamp": "03:17:47", "text": "必ず教えてくださいね、こんにちは"}, {"type": "subtitle", "time": 11874.63, "timestamp": "03:17:54", "text": "私は音声が聞こえたと思います。"}, {"type": "subtitle", "time": 11876.15, "timestamp": "03:17:56", "text": "えっと"}]
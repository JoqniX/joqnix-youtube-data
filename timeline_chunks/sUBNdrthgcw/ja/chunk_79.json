[{"type": "subtitle", "time": 4744.87, "timestamp": "01:19:04", "text": "よし。それに応じて中央揃えにする。良い。"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "大丈夫だよ。ニース。"}, {"type": "subtitle", "time": 4755.43, "timestamp": "01:19:15", "text": "問題ないと思います。私はただ"}, {"type": "subtitle", "time": 4757.75, "timestamp": "01:19:17", "text": "えーと"}, {"type": "subtitle", "time": 4761.03, "timestamp": "01:19:21", "text": "ええ、スペースが必要です。大丈夫です。私は推測する"}, {"type": "subtitle", "time": 4765.189, "timestamp": "01:19:25", "text": "こちらにもいくつか置いておけますよ。大丈夫。"}, {"type": "subtitle", "time": 4767.03, "timestamp": "01:19:27", "text": "ジョー、君の送信者用の帽子、素敵だね。盗む"}, {"type": "subtitle", "time": 4769.43, "timestamp": "01:19:29", "text": "それ。これはTwitter上で無料で利用できる素材です。ただ"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "調べてみてください。ええと、この資産が作られました"}, {"type": "subtitle", "time": 4775.59, "timestamp": "01:19:35", "text": "これはElaza Sunによって特別に作られました。"}, {"type": "subtitle", "time": 4777.91, "timestamp": "01:19:37", "text": "エリサはインド人のユーチューバーです。彼女はそうする"}, {"type": "subtitle", "time": 4781.669, "timestamp": "01:19:41", "text": "芸術のように、彼女は自分で仕掛けた"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "モデルとかそういうもの。久しぶりですね。私"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "逃す。"}, {"type": "subtitle", "time": 4789.27, "timestamp": "01:19:49", "text": "久しぶりですね。"}, {"type": "subtitle", "time": 4791.99, "timestamp": "01:19:51", "text": "ええ、彼女がやったんです。私"}, {"type": "subtitle", "time": 4794.55, "timestamp": "01:19:54", "text": "私のTwitterに載っていると思います。見つけてみます"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "それ。"}, {"type": "subtitle", "time": 4799.27, "timestamp": "01:19:59", "text": "ブックマークしたか、いいねしたと思います。"}]
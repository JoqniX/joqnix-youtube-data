[{"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "いいえ。どうしてそれを見逃したんだろう？"}, {"type": "subtitle", "time": 1303.51, "timestamp": "00:21:43", "text": "この試合の後、最後にもう一度やろう"}, {"type": "subtitle", "time": 1305.83, "timestamp": "00:21:45", "text": "その試合を終えたら、今日は終わりだ。私たちは作ります"}, {"type": "subtitle", "time": 1308.47, "timestamp": "00:21:48", "text": "クリスマスツリー。"}, {"type": "subtitle", "time": 1312.71, "timestamp": "00:21:52", "text": "写真を撮って、それで終わり。わかった。比較。"}]
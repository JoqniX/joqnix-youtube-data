[{"type": "subtitle", "time": 11760.309, "timestamp": "03:16:00", "text": "実際、私が持っているかどうか確認させてください"}, {"type": "subtitle", "time": 11763.349, "timestamp": "03:16:03", "text": "こっちに何かある。主な問題は"}, {"type": "subtitle", "time": 11767.91, "timestamp": "03:16:07", "text": "これが人々がこう言う理由です"}, {"type": "subtitle", "time": 11771.349, "timestamp": "03:16:11", "text": "いつもいつも"}, {"type": "subtitle", "time": 11773.349, "timestamp": "03:16:13", "text": "確認する"}, {"type": "subtitle", "time": 11776.15, "timestamp": "03:16:16", "text": "えっと"}, {"type": "subtitle", "time": 11778.55, "timestamp": "03:16:18", "text": "常にGoogleドライブを確認してください"}, {"type": "subtitle", "time": 11781.99, "timestamp": "03:16:21", "text": "あなたが最終的にこうならないことすべて"}, {"type": "subtitle", "time": 11785.59, "timestamp": "03:16:25", "text": "私みたいにならないで。"}, {"type": "subtitle", "time": 11788.469, "timestamp": "03:16:28", "text": "これは、"}, {"type": "subtitle", "time": 11792.79, "timestamp": "03:16:32", "text": "昔はスポーツマンだった。何てことだ。"}, {"type": "subtitle", "time": 11797.83, "timestamp": "03:16:37", "text": "ええ、皆さんお元気ですか？"}, {"type": "subtitle", "time": 11800.469, "timestamp": "03:16:40", "text": "皆さんお元気でお過ごしでしょうか。あなたが知っている"}, {"type": "subtitle", "time": 11802.79, "timestamp": "03:16:42", "text": "何？背景説明のために、"}, {"type": "subtitle", "time": 11805.269, "timestamp": "03:16:45", "text": "これは取っておいてもいいかな。"}, {"type": "subtitle", "time": 11808.229, "timestamp": "03:16:48", "text": "これはかなり古いものです。古いですが、"}, {"type": "subtitle", "time": 11810.309, "timestamp": "03:16:50", "text": "いいもの。"}, {"type": "subtitle", "time": 11814.87, "timestamp": "03:16:54", "text": "うん、これは取っておいてもいいと思うよ。"}, {"type": "subtitle", "time": 11819.11, "timestamp": "03:16:59", "text": "うん。うん。私の昔の作品。"}]
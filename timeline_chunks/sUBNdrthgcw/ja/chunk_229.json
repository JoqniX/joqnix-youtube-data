[{"type": "subtitle", "time": 13745.429, "timestamp": "03:49:05", "text": "[音楽]"}, {"type": "subtitle", "time": 13747.189, "timestamp": "03:49:07", "text": "出発前に会えてよかった"}, {"type": "subtitle", "time": 13749.189, "timestamp": "03:49:09", "text": "スコットランド。"}, {"type": "subtitle", "time": 13752.389, "timestamp": "03:49:12", "text": "かろうじて、という感じだった。"}, {"type": "subtitle", "time": 13756.389, "timestamp": "03:49:16", "text": "あなたの旅の同行者は誰ですか？"}, {"type": "subtitle", "time": 13761.03, "timestamp": "03:49:21", "text": "新入生。おお、新しい。はい、承知いたしました。私は"}, {"type": "subtitle", "time": 13763.429, "timestamp": "03:49:23", "text": "5年生として学校に入学する。"}, {"type": "subtitle", "time": 13766.55, "timestamp": "03:49:26", "text": "それは実に驚くべきことだ。どれも"}, {"type": "subtitle", "time": 13768.15, "timestamp": "03:49:28", "text": "教員はこれまで誰かについて聞いたことがある"}, {"type": "subtitle", "time": 13771.189, "timestamp": "03:49:31", "text": "ホグワーツにこんなに遅く入学できたなんて。または"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "私は持っています。もちろん、他の5人と同じように"}, {"type": "subtitle", "time": 13775.59, "timestamp": "03:49:35", "text": "何年もかけて磨き上げてきた"}, {"type": "subtitle", "time": 13777.75, "timestamp": "03:49:37", "text": "4年間魔法のスキルを身につけてきた"}, {"type": "subtitle", "time": 13779.51, "timestamp": "03:49:39", "text": "校長先生は、新しい"}, {"type": "subtitle", "time": 13781.349, "timestamp": "03:49:41", "text": "学生は、"}, {"type": "subtitle", "time": 13784.15, "timestamp": "03:49:44", "text": "学期が始まる。まあ、"}, {"type": "subtitle", "time": 13787.03, "timestamp": "03:49:47", "text": "より良い指導者を求めた。フィグ教授"}, {"type": "subtitle", "time": 13789.75, "timestamp": "03:49:49", "text": "彼は優れた教師であるだけでなく、"}, {"type": "subtitle", "time": 13792.71, "timestamp": "03:49:52", "text": "また、非常に直感的で才能のある"}, {"type": "subtitle", "time": 13796.71, "timestamp": "03:49:56", "text": "魔法使い。オスリ氏は、お世辞に弱い。"}, {"type": "subtitle", "time": 13798.469, "timestamp": "03:49:58", "text": "彼が"}]
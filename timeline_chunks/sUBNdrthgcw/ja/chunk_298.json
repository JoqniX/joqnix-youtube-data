[{"type": "subtitle", "time": 17881.51, "timestamp": "04:58:01", "text": "YouTubeで信じるべき300本の動画3本"}, {"type": "subtitle", "time": 17884.23, "timestamp": "04:58:04", "text": "ストリーム。 「ああ、痛かった。」でも"}, {"type": "subtitle", "time": 17885.91, "timestamp": "04:58:05", "text": "うん、"}, {"type": "subtitle", "time": 17889.35, "timestamp": "04:58:09", "text": "おそらく、終わりまでに、"}, {"type": "subtitle", "time": 17891.59, "timestamp": "04:58:11", "text": "月曜日にレベル3を解除するので、"}, {"type": "subtitle", "time": 17896.47, "timestamp": "04:58:16", "text": "最大32GBの動画をアップロードできます。だから私は"}, {"type": "subtitle", "time": 17899.03, "timestamp": "04:58:19", "text": "それを切り分けて、いくつかの部分に分ける必要があります。それで"}, {"type": "subtitle", "time": 17901.35, "timestamp": "04:58:21", "text": "これらのストリームは、私がもっとストリーム配信すれば正しいです"}, {"type": "subtitle", "time": 17903.59, "timestamp": "04:58:23", "text": "10時間以上かかるので、それを分割する必要があります"}, {"type": "subtitle", "time": 17905.27, "timestamp": "04:58:25", "text": "部品。"}, {"type": "subtitle", "time": 17910.31, "timestamp": "04:58:30", "text": "300。うん。 300。うん。もちろん。だから私は試している"}, {"type": "subtitle", "time": 17914.868, "timestamp": "04:58:34", "text": "一つずつプレイリストに追加していく。"}, {"type": "subtitle", "time": 17917.91, "timestamp": "04:58:37", "text": "しかし、それは痛みだ。それで私は最初の"}, {"type": "subtitle", "time": 17920.788, "timestamp": "04:58:40", "text": "YouTube でストリーミング配信する いいえ、私は"}, {"type": "subtitle", "time": 17924.15, "timestamp": "04:58:44", "text": "実際には最新のものから古いものへと変わった"}, {"type": "subtitle", "time": 17926.47, "timestamp": "04:58:46", "text": "ダウンロードした時。"}, {"type": "subtitle", "time": 17929.11, "timestamp": "04:58:49", "text": "それは痛みだった。 2週間かかりました。私"}, {"type": "subtitle", "time": 17930.948, "timestamp": "04:58:50", "text": "YouTube関連の作業は昨日完了しました。それで"}, {"type": "subtitle", "time": 17936.07, "timestamp": "04:58:56", "text": "それは私が先週の日曜日に始めたことと同じです。"}, {"type": "subtitle", "time": 17939.59, "timestamp": "04:58:59", "text": "先週の日曜日は何日でしたか？いや、私は始めた"}]
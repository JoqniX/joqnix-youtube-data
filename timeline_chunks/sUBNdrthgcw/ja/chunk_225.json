[{"type": "subtitle", "time": 13501.03, "timestamp": "03:45:01", "text": "キャラクターは実際には男性です"}, {"type": "subtitle", "time": 13503.99, "timestamp": "03:45:03", "text": "みんなが望んでいたから"}, {"type": "subtitle", "time": 13509.99, "timestamp": "03:45:09", "text": "つまり、ええと、いくつか、いくつか、いくつか"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "人々は男性を求めていた、だから私は行った"}, {"type": "subtitle", "time": 13514.71, "timestamp": "03:45:14", "text": "男性と一緒に行くか、そうでなければ私は"}, {"type": "subtitle", "time": 13516.79, "timestamp": "03:45:16", "text": "女性です。"}, {"type": "subtitle", "time": 13519.59, "timestamp": "03:45:19", "text": "待って、着替えた方がいいかな？変更すべきでしょうか？"}, {"type": "subtitle", "time": 13523.75, "timestamp": "03:45:23", "text": "女性に？変えた方がいいでしょうか？私"}, {"type": "subtitle", "time": 13525.99, "timestamp": "03:45:25", "text": "わからない。"}, {"type": "subtitle", "time": 13528.87, "timestamp": "03:45:28", "text": "私はすべきでしょうか"}, {"type": "subtitle", "time": 13531.429, "timestamp": "03:45:31", "text": "視覚"}, {"type": "subtitle", "time": 13534.229, "timestamp": "03:45:34", "text": "つまり、私は性別を変えることができるんです。私"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "つまり、慰めのためなら、"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "ああ、これは難しい。私は。それはかなり"}, {"type": "subtitle", "time": 13543.189, "timestamp": "03:45:43", "text": "何か。"}, {"type": "subtitle", "time": 13544.95, "timestamp": "03:45:44", "text": "まるで、おかしな高音の女性の写真のよう"}, {"type": "subtitle", "time": 13546.79, "timestamp": "03:45:46", "text": "友人。"}, {"type": "subtitle", "time": 13548.95, "timestamp": "03:45:48", "text": "だから、私はこれが好きなんです。はぁ？楽しみにしています。そうだった"}, {"type": "subtitle", "time": 13551.269, "timestamp": "03:45:51", "text": "素晴らしい。私は本当に"}, {"type": "subtitle", "time": 13555.59, "timestamp": "03:45:55", "text": "この授業を楽しんでください。これです？わかった。あなた"}, {"type": "subtitle", "time": 13558.63, "timestamp": "03:45:58", "text": "これが欲しいの？クモの巣が少しと"}]
[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "ああ、彼は禅の銃を持っている。"}, {"type": "subtitle", "time": 312.87, "timestamp": "00:05:12", "text": "わかった。大丈夫。"}, {"type": "subtitle", "time": 315.67, "timestamp": "00:05:15", "text": "ごめんなさい。 11,000。私は待ちます。"}, {"type": "subtitle", "time": 319.029, "timestamp": "00:05:19", "text": "では、400回やるべきでしょうか？"}, {"type": "subtitle", "time": 324.55, "timestamp": "00:05:24", "text": "400回できるよ。ああ、なんてことだ。これは何ですか？"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "とんでもない。とんでもない。待って。えっと、誰が誰と言ったの？"}, {"type": "subtitle", "time": 330.39, "timestamp": "00:05:30", "text": "誰がプレイするの？ここでプレイした人は"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "また400か？"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "えっと、"}, {"type": "subtitle", "time": 338.23, "timestamp": "00:05:38", "text": "50027。"}, {"type": "subtitle", "time": 342.23, "timestamp": "00:05:42", "text": "いいえ。わかりました、わかりました。アストロズ。"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "聖なる主よ。誰が？一体どうしてるの？おお"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "我が神よ。"}, {"type": "subtitle", "time": 353.029, "timestamp": "00:05:53", "text": "これは何ですか？動けません。私はしなければならない"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "マウスをすごく動かした。一体どういうことだ？"}]
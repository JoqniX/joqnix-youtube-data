[{"type": "subtitle", "time": 14465.51, "timestamp": "04:01:05", "text": "[音楽]"}, {"type": "subtitle", "time": 14467.83, "timestamp": "04:01:07", "text": "教授、これは"}, {"type": "subtitle", "time": 14480.389, "timestamp": "04:01:20", "text": "ここには宝箱があるはずだ"}, {"type": "subtitle", "time": 14487.349, "timestamp": "04:01:27", "text": "来る。少しの間、席を外さなければなりませんでした。その"}, {"type": "subtitle", "time": 14489.99, "timestamp": "04:01:29", "text": "わかった。あの魔法の結晶石"}, {"type": "subtitle", "time": 14492.15, "timestamp": "04:01:32", "text": "また。 1秒。私は、えーと"}, {"type": "subtitle", "time": 14497.83, "timestamp": "04:01:37", "text": "家族に邪魔された。だから、私は"}, {"type": "subtitle", "time": 14500.469, "timestamp": "04:01:40", "text": "ほんの1秒だけ。"}, {"type": "subtitle", "time": 14504.469, "timestamp": "04:01:44", "text": "ほんの一瞬だけ。私は"}, {"type": "subtitle", "time": 14506.469, "timestamp": "04:01:46", "text": "もう少ししたら戻ります。私は"}, {"type": "subtitle", "time": 14510.18, "timestamp": "04:01:50", "text": "マイク。 1秒。バッグをすぐにお楽しみください。"}]
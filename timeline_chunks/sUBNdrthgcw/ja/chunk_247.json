[{"type": "subtitle", "time": 14829.83, "timestamp": "04:07:09", "text": "お先にどうぞ。"}, {"type": "subtitle", "time": 14839.269, "timestamp": "04:07:19", "text": "カートの中に手を入れたままにしてください"}, {"type": "subtitle", "time": 14841.75, "timestamp": "04:07:21", "text": "それらを失いたくない。"}, {"type": "subtitle", "time": 14844.15, "timestamp": "04:07:24", "text": "ああ、それは本当に怖いですね。おお"}, {"type": "subtitle", "time": 14847.03, "timestamp": "04:07:27", "text": "閣下。"}, {"type": "subtitle", "time": 14854.229, "timestamp": "04:07:34", "text": "カモメはいない。何票"}, {"type": "subtitle", "time": 14856.87, "timestamp": "04:07:36", "text": "緑色の枠の中に？数百。で"}, {"type": "subtitle", "time": 14859.11, "timestamp": "04:07:39", "text": "実際、私たちは"}, {"type": "subtitle", "time": 14861.91, "timestamp": "04:07:41", "text": "まさに今、金庫12番を開けているところです。ただ"}, {"type": "subtitle", "time": 14863.99, "timestamp": "04:07:43", "text": "メインロビーの下にある金庫室は"}, {"type": "subtitle", "time": 14866.229, "timestamp": "04:07:46", "text": "今ご覧になっているのは最新のものです。プライベート"}, {"type": "subtitle", "time": 14868.15, "timestamp": "04:07:48", "text": "銀行の入り口は共通で"}, {"type": "subtitle", "time": 14869.67, "timestamp": "04:07:49", "text": "持ってくる？"}, {"type": "subtitle", "time": 14872.63, "timestamp": "04:07:52", "text": "それらは最も一般的です。 1つだけ"}, {"type": "subtitle", "time": 14875.349, "timestamp": "04:07:55", "text": "素晴らしい。ジェットコースターが"}]
[{"type": "subtitle", "time": 10082.95, "timestamp": "02:48:02", "text": "吐き気はしない。"}, {"type": "subtitle", "time": 10087.03, "timestamp": "02:48:07", "text": "一体自分に何が起こっているんだ？"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "なぜこんなに具合が悪いのだろう？すごく気分が悪いです。"}, {"type": "subtitle", "time": 10093.19, "timestamp": "02:48:13", "text": "とにかく、えーと、ストリーム配信を行います。"}, {"type": "subtitle", "time": 10094.87, "timestamp": "02:48:14", "text": "30日"}, {"type": "subtitle", "time": 10097.11, "timestamp": "02:48:17", "text": "そして、もしかしたらストリーム配信をするかもしれません"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "なぜかすごく気分が悪い。私の"}, {"type": "subtitle", "time": 10115.19, "timestamp": "02:48:35", "text": "でも、それができてよかったです"}, {"type": "subtitle", "time": 10117.429, "timestamp": "02:48:37", "text": "これを一緒に。本当に本当にありがとうございます"}, {"type": "subtitle", "time": 10118.95, "timestamp": "02:48:38", "text": "みんな。"}, {"type": "subtitle", "time": 10124.07, "timestamp": "02:48:44", "text": "そしてまた、私は今でも好きです"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "私が心配している瞬間。欲しい"}, {"type": "subtitle", "time": 10130.55, "timestamp": "02:48:50", "text": "このイベントを行うには"}, {"type": "subtitle", "time": 10133.429, "timestamp": "02:48:53", "text": "つまり、このクリスマスツリーは"}, {"type": "subtitle", "time": 10137.349, "timestamp": "02:48:57", "text": "装飾は未来のためのもの。"}]
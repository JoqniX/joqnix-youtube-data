[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "ああ、それは何をするものですか？"}, {"type": "subtitle", "time": 8883.349, "timestamp": "02:28:03", "text": "革製のキャップ。"}, {"type": "subtitle", "time": 8887.19, "timestamp": "02:28:07", "text": "パワーアップ。研磨。"}, {"type": "subtitle", "time": 8890.15, "timestamp": "02:28:10", "text": "おお。物がたくさんありすぎる。"}, {"type": "subtitle", "time": 8899.429, "timestamp": "02:28:19", "text": "待って。レベルアップすべきでしょうか"}, {"type": "subtitle", "time": 8903.03, "timestamp": "02:28:23", "text": "基本的な弓？やるべきだろうか？私はそうは思わない"}, {"type": "subtitle", "time": 8906.95, "timestamp": "02:28:26", "text": "そうするべきです。これは基本的なレベル1の赤です"}, {"type": "subtitle", "time": 8909.03, "timestamp": "02:28:29", "text": "お辞儀、ですよね？私は上手くなると思う"}, {"type": "subtitle", "time": 8912.15, "timestamp": "02:28:32", "text": "弓。だから、私はそうすべきかどうかわからない"}, {"type": "subtitle", "time": 8913.83, "timestamp": "02:28:33", "text": "それ。"}, {"type": "subtitle", "time": 8917.11, "timestamp": "02:28:37", "text": "レコードコードex。"}, {"type": "subtitle", "time": 8918.95, "timestamp": "02:28:38", "text": "あなたはこれらすべてからお金を集めます"}, {"type": "subtitle", "time": 8930.23, "timestamp": "02:28:50", "text": "[音楽]"}, {"type": "subtitle", "time": 8933.349, "timestamp": "02:28:53", "text": "実績パワーアップ。"}, {"type": "subtitle", "time": 8938.23, "timestamp": "02:28:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4627.91, "timestamp": "01:17:07", "text": "私はマレー語も知っていますし、"}, {"type": "subtitle", "time": 4630.63, "timestamp": "01:17:10", "text": "タミル語を少しだけ。あまりよく知らない"}, {"type": "subtitle", "time": 4632.31, "timestamp": "01:17:12", "text": "けれど。"}, {"type": "subtitle", "time": 4636.63, "timestamp": "01:17:16", "text": "あるいはそれほどでもないかもしれないが、私はどちらも苦手だ。"}, {"type": "subtitle", "time": 4643.11, "timestamp": "01:17:23", "text": "お元気でお過ごしでしょうか。私はしませんでした"}, {"type": "subtitle", "time": 4645.11, "timestamp": "01:17:25", "text": "やり過ぎだ。"}, {"type": "subtitle", "time": 4649.03, "timestamp": "01:17:29", "text": "あと、息子も確認してください。えーと、どれでも選んでください"}, {"type": "subtitle", "time": 4651.59, "timestamp": "01:17:31", "text": "装飾品。どの番号をご希望ですか？だった"}, {"type": "subtitle", "time": 4653.43, "timestamp": "01:17:33", "text": "通りかかったすべての人を"}, {"type": "subtitle", "time": 4656.31, "timestamp": "01:17:36", "text": "クリスマスツリーへ流れ込む。うん、"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "どれでも選んでください。はい、どれでも選んでください。"}, {"type": "subtitle", "time": 4662.79, "timestamp": "01:17:42", "text": "ウムの"}, {"type": "subtitle", "time": 4665.27, "timestamp": "01:17:45", "text": "ご希望の色。"}, {"type": "subtitle", "time": 4669.669, "timestamp": "01:17:49", "text": "それでは、あなたをクリスマスツリーに加えます。"}, {"type": "subtitle", "time": 4673.11, "timestamp": "01:17:53", "text": "つまり、これです。ここに全員を追加します"}]
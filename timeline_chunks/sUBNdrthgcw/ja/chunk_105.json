[{"type": "subtitle", "time": 6325.35, "timestamp": "01:45:25", "text": "私の場合、彼女のことはちょっと"}, {"type": "subtitle", "time": 6327.75, "timestamp": "01:45:27", "text": "丸みを帯びた感じ。調整するだけです"}, {"type": "subtitle", "time": 6329.669, "timestamp": "01:45:29", "text": "若干。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "私たちはこれをこのように調整します。うん。"}, {"type": "subtitle", "time": 6336.15, "timestamp": "01:45:36", "text": "良い。良い。"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "そしてこの男も、ここにいるこの人"}]
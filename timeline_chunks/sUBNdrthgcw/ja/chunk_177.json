[{"type": "subtitle", "time": 10620.55, "timestamp": "02:57:00", "text": "装飾について何を決めるか"}, {"type": "subtitle", "time": 10622.469, "timestamp": "02:57:02", "text": "のために"}, {"type": "subtitle", "time": 10627.19, "timestamp": "02:57:07", "text": "大きなクリスマスツリーは？何てことだ。"}, {"type": "subtitle", "time": 10630.23, "timestamp": "02:57:10", "text": "こういうことをメモしておいてほしい"}, {"type": "subtitle", "time": 10632.71, "timestamp": "02:57:12", "text": "アイデア。いやいや、メモしないでください。しかし"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "それは可能だと思いますか？"}, {"type": "subtitle", "time": 10640.95, "timestamp": "02:57:20", "text": "ウェブサイトに掲載するには？でも私はそう思う"}, {"type": "subtitle", "time": 10649.11, "timestamp": "02:57:29", "text": "えーと、それはたくさんの"}, {"type": "subtitle", "time": 10652.07, "timestamp": "02:57:32", "text": "コーディングとサーバーと"}, {"type": "subtitle", "time": 10655.99, "timestamp": "02:57:35", "text": "たくさんのもの。君はそうは思わないよ"}, {"type": "subtitle", "time": 10659.19, "timestamp": "02:57:39", "text": "あなたがここでしなかった白を作ります。だから、あなたも"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "私の後ろにあるクリスマスツリーが見えますか？"}, {"type": "subtitle", "time": 10665.429, "timestamp": "02:57:45", "text": "だから来年は"}, {"type": "subtitle", "time": 10667.99, "timestamp": "02:57:47", "text": "OBSから手動で操作して"}, {"type": "subtitle", "time": 10671.03, "timestamp": "02:57:51", "text": "アバターと、手動でそれを行うこと"}, {"type": "subtitle", "time": 10674.07, "timestamp": "02:57:54", "text": "手動で、次のように考えていました"}, {"type": "subtitle", "time": 10677.67, "timestamp": "02:57:57", "text": "ウェブサイト上の、インタラクティブな要素。"}]
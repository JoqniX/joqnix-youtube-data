[{"type": "subtitle", "time": 15989.189, "timestamp": "04:26:29", "text": "大丈夫ですか？承知いたしました。私は一度も"}, {"type": "subtitle", "time": 15991.91, "timestamp": "04:26:31", "text": "あんなに強力なゴブリンを見たのは初めてだ。"}, {"type": "subtitle", "time": 15994.87, "timestamp": "04:26:34", "text": "彼は私の"}, {"type": "subtitle", "time": 16001.03, "timestamp": "04:26:41", "text": "ここはどこ？"}, {"type": "subtitle", "time": 16004.229, "timestamp": "04:26:44", "text": "問題はそこだ。そんなはずはない。"}, {"type": "subtitle", "time": 16006.469, "timestamp": "04:26:46", "text": "物思いにふける人々を設立した人々は、"}, {"type": "subtitle", "time": 16010.71, "timestamp": "04:26:50", "text": "ロケットと、両方が望む道"}, {"type": "subtitle", "time": 16013.429, "timestamp": "04:26:53", "text": "あなたの能力を持つ人"}, {"type": "subtitle", "time": 16017.03, "timestamp": "04:26:57", "text": "結局ここにたどり着いた。"}, {"type": "subtitle", "time": 16019.67, "timestamp": "04:26:59", "text": "さあ、仕分け式があります"}]
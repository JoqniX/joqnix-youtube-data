[{"type": "subtitle", "time": 15420.21, "timestamp": "04:17:00", "text": "なんてこった。それは宝箱です。"}, {"type": "subtitle", "time": 15429.75, "timestamp": "04:17:09", "text": "リヴァイです。"}, {"type": "subtitle", "time": 15442.71, "timestamp": "04:17:22", "text": "これらの像を彼らの"}, {"type": "subtitle", "time": 15444.55, "timestamp": "04:17:24", "text": "考察。"}, {"type": "subtitle", "time": 15447.51, "timestamp": "04:17:27", "text": "わかった。私には選択肢がないようだ。私は行きます"}, {"type": "subtitle", "time": 15450.309, "timestamp": "04:17:30", "text": "ここから脱出するために戦わなければならない。"}, {"type": "subtitle", "time": 15470.95, "timestamp": "04:17:50", "text": "プロ中のすべてのQはスタンさせる。"}, {"type": "subtitle", "time": 15473.189, "timestamp": "04:17:53", "text": "愚かな5人の敵"}, {"type": "subtitle", "time": 15475.99, "timestamp": "04:17:55", "text": "反撃。気絶した敵は"}, {"type": "subtitle", "time": 15479.11, "timestamp": "04:17:59", "text": "追加ダメージは金色の数字で示されています。"}]
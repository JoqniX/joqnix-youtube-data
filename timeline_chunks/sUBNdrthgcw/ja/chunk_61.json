[{"type": "subtitle", "time": 3670.15, "timestamp": "01:01:10", "text": "何てことだ。私は待っていた。私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 3673.27, "timestamp": "01:01:13", "text": "私は「ああ、まずい」と思いました。"}, {"type": "subtitle", "time": 3676.15, "timestamp": "01:01:16", "text": "わかった。えっと、丸。さあ行こう。そうですか"}, {"type": "subtitle", "time": 3692.71, "timestamp": "01:01:32", "text": "仕事で。"}, {"type": "subtitle", "time": 3694.71, "timestamp": "01:01:34", "text": "わかった。さて、問題はこれがどのように"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "仕事？シーンビュー変換とは何ですか？"}, {"type": "subtitle", "time": 3702.71, "timestamp": "01:01:42", "text": "ズームインできます。わかりました。おお。おお。何が"}, {"type": "subtitle", "time": 3705.67, "timestamp": "01:01:45", "text": "このデザインは"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "忍者のアバターからズームアウトしたらどうなる？おお、"}, {"type": "subtitle", "time": 3710.47, "timestamp": "01:01:50", "text": "いいね。いいね。"}, {"type": "subtitle", "time": 3712.549, "timestamp": "01:01:52", "text": "よし、彼らはそれを折りたたむ。わからない。 90."}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "右。そこで、問題は、"}, {"type": "subtitle", "time": 3718.069, "timestamp": "01:01:58", "text": "丸で囲みますか？"}]
[{"type": "subtitle", "time": 10800.55, "timestamp": "03:00:00", "text": "ここ。いいえ。"}, {"type": "subtitle", "time": 10803.349, "timestamp": "03:00:03", "text": "ええ、３人ともここに来ますよ。それで"}, {"type": "subtitle", "time": 10805.51, "timestamp": "03:00:05", "text": "意味 ああ、神様、私はそれをさらに"}, {"type": "subtitle", "time": 10808.23, "timestamp": "03:00:08", "text": "複雑な。でも、そうですね、えーと、えーと"}, {"type": "subtitle", "time": 10811.269, "timestamp": "03:00:11", "text": "それはまるで木の装飾メニューのようです"}, {"type": "subtitle", "time": 10813.91, "timestamp": "03:00:13", "text": "窓か何か。私たち、人々は"}, {"type": "subtitle", "time": 10815.91, "timestamp": "03:00:15", "text": "そういうことだけど、"}, {"type": "subtitle", "time": 10818.95, "timestamp": "03:00:18", "text": "メインロビーかどこかへ"}, {"type": "subtitle", "time": 10823.03, "timestamp": "03:00:23", "text": "このようにすれば、現在"}, {"type": "subtitle", "time": 10826.15, "timestamp": "03:00:26", "text": "このようなクリスマスツリーを作りました"}, {"type": "subtitle", "time": 10829.03, "timestamp": "03:00:29", "text": "3Dビューとか、あるいは、えっと、あなたみたいに"}, {"type": "subtitle", "time": 10831.19, "timestamp": "03:00:31", "text": "隅っこで知ってるよ、それから彼らは"}, {"type": "subtitle", "time": 10833.59, "timestamp": "03:00:33", "text": "上にホバリングして操作できます"}, {"type": "subtitle", "time": 10837.99, "timestamp": "03:00:37", "text": "私自身のキャラクターや、何を聞くか"}, {"type": "subtitle", "time": 10840.23, "timestamp": "03:00:40", "text": "私は彼らが話しているものですか、"}, {"type": "subtitle", "time": 10842.309, "timestamp": "03:00:42", "text": "とてもかわいいもの。わからない"}, {"type": "subtitle", "time": 10845.03, "timestamp": "03:00:45", "text": "それは良い考えだ。"}, {"type": "subtitle", "time": 10852.95, "timestamp": "03:00:52", "text": "えーと、でもまた、私は、私は、私は、"}, {"type": "subtitle", "time": 10855.59, "timestamp": "03:00:55", "text": "クラブペンギンからアイデアを得た。"}, {"type": "subtitle", "time": 10858.63, "timestamp": "03:00:58", "text": "これは最近始めたばかりなので、"}]
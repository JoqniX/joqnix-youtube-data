[{"type": "subtitle", "time": 12542.07, "timestamp": "03:29:02", "text": "目。何てことだ。ああ、ありがとうございます。ああ、"}, {"type": "subtitle", "time": 12544.309, "timestamp": "03:29:04", "text": "神。知りませんでした。ゲームキャッチャー"}, {"type": "subtitle", "time": 12547.03, "timestamp": "03:29:07", "text": "それは示していない。わかった。"}, {"type": "subtitle", "time": 12551.59, "timestamp": "03:29:11", "text": "こんにちは。ああ、これは地域性ですね。わかった。えーと"}, {"type": "subtitle", "time": 12554.63, "timestamp": "03:29:14", "text": "これは私が本当に苦手なことの一つです"}, {"type": "subtitle", "time": 12558.309, "timestamp": "03:29:18", "text": "性別選択、性別選択。"}, {"type": "subtitle", "time": 12561.83, "timestamp": "03:29:21", "text": "えっと、ジョックってノンバイナリーみたいな感じだよね"}, {"type": "subtitle", "time": 12563.75, "timestamp": "03:29:23", "text": "あれの。私は星座です。私はしません"}, {"type": "subtitle", "time": 12566.63, "timestamp": "03:29:26", "text": "特定のものを持っているが、私はいつも"}, {"type": "subtitle", "time": 12570.469, "timestamp": "03:29:30", "text": "普段はhe、himで呼ばれるけど、それでも私は大好き"}, {"type": "subtitle", "time": 12572.87, "timestamp": "03:29:32", "text": "ビデオで女性キャラクターを取り上げ"}, {"type": "subtitle", "time": 12577.19, "timestamp": "03:29:37", "text": "ゲームだけど、私は混乱している。えっと"}, {"type": "subtitle", "time": 12580.71, "timestamp": "03:29:40", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 12590.87, "timestamp": "03:29:50", "text": "でも、えっと、メガネ。"}, {"type": "subtitle", "time": 12594.07, "timestamp": "03:29:54", "text": "あそこに散らばっているのは私のメガネです。"}, {"type": "subtitle", "time": 12598.15, "timestamp": "03:29:58", "text": "それを自分のものに合わせようとすべきでしょうか"}]
[{"type": "subtitle", "time": 3780.309, "timestamp": "01:03:00", "text": "こんな感じです。置くしかない"}, {"type": "subtitle", "time": 3783.99, "timestamp": "01:03:03", "text": "ここみたいに。こちらです。それでおしまい。"}, {"type": "subtitle", "time": 3787.27, "timestamp": "01:03:07", "text": "何てことだ。"}, {"type": "subtitle", "time": 3797.19, "timestamp": "01:03:17", "text": "他に私にできることはありますか？ズームインできます"}, {"type": "subtitle", "time": 3803.029, "timestamp": "01:03:23", "text": "ああ、高さに合わせて調整します。"}, {"type": "subtitle", "time": 3807.19, "timestamp": "01:03:27", "text": "そしてその方法。ああ、なんてことだ、これはスポッグだ。私"}, {"type": "subtitle", "time": 3815.589, "timestamp": "01:03:35", "text": "待って、見えてる？ 見えてないよ"}, {"type": "subtitle", "time": 3822.63, "timestamp": "01:03:42", "text": "あ、待って。それならズームしすぎですね。それは"}, {"type": "subtitle", "time": 3824.87, "timestamp": "01:03:44", "text": "なぜあなたはそれを見なかったのか。何てことだ。見る"}, {"type": "subtitle", "time": 3830.15, "timestamp": "01:03:50", "text": "この力の強さはどれほどのものか。"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "何てことだ。くそ、"}]
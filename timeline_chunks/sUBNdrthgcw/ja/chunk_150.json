[{"type": "subtitle", "time": 9005.27, "timestamp": "02:30:05", "text": "ああ、ただいま。えっと、切り替え。"}, {"type": "subtitle", "time": 9007.03, "timestamp": "02:30:07", "text": "こんにちは。"}, {"type": "subtitle", "time": 9012.71, "timestamp": "02:30:12", "text": "顔を洗って塗っている間に"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "額に薬を塗ったから"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "頭痛、"}, {"type": "subtitle", "time": 9020.309, "timestamp": "02:30:20", "text": "えっと、いいアイデアを思いついたんだけど、"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "OBS を苦痛に感じるのではなく、"}, {"type": "subtitle", "time": 9027.91, "timestamp": "02:30:27", "text": "そして、これらすべてがこうだったら、"}, {"type": "subtitle", "time": 9030.79, "timestamp": "02:30:30", "text": "もしも"}, {"type": "subtitle", "time": 9034.15, "timestamp": "02:30:34", "text": "えーと、もし私たちが、"}, {"type": "subtitle", "time": 9037.99, "timestamp": "02:30:37", "text": "ウェブサイトにあるもの"}, {"type": "subtitle", "time": 9040.389, "timestamp": "02:30:40", "text": "ストリームに来る人はログインできます"}, {"type": "subtitle", "time": 9044.15, "timestamp": "02:30:44", "text": "そして、3つまたは"}, {"type": "subtitle", "time": 9047.19, "timestamp": "02:30:47", "text": "ウェブサイト自体からの情報。意思"}, {"type": "subtitle", "time": 9049.27, "timestamp": "02:30:49", "text": "それは良いことでしょうか？"}, {"type": "subtitle", "time": 9051.19, "timestamp": "02:30:51", "text": "だからこれを手動で入れる必要はありません"}, {"type": "subtitle", "time": 9054.63, "timestamp": "02:30:54", "text": "仕事。いいえ、それは自動的に"}, {"type": "subtitle", "time": 9056.71, "timestamp": "02:30:56", "text": "アレンジされたもの、または何か"}, {"type": "subtitle", "time": 9058.79, "timestamp": "02:30:58", "text": "いい考えだと思う。わからない。私はただ"}]
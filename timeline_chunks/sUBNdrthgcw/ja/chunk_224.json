[{"type": "subtitle", "time": 13440.87, "timestamp": "03:44:00", "text": "待って。声がある。クモの巣が少しと"}, {"type": "subtitle", "time": 13445.51, "timestamp": "03:44:05", "text": "埃が少し。ホグズミーに行くのが待ち遠しい。"}, {"type": "subtitle", "time": 13447.429, "timestamp": "03:44:07", "text": "私は確かに学生ですが、"}, {"type": "subtitle", "time": 13449.349, "timestamp": "03:44:09", "text": "できる"}, {"type": "subtitle", "time": 13451.67, "timestamp": "03:44:11", "text": "クモの巣と埃が少し。それは私が"}, {"type": "subtitle", "time": 13454.229, "timestamp": "03:44:14", "text": "ホッグに会いたくてたまらない。私は確かに"}, {"type": "subtitle", "time": 13455.75, "timestamp": "03:44:15", "text": "学生ですが、私は十分にできると思います"}, {"type": "subtitle", "time": 13458.07, "timestamp": "03:44:18", "text": "それは実に素晴らしいことだった。"}, {"type": "subtitle", "time": 13460.389, "timestamp": "03:44:20", "text": "ホッグスミートに行くのが待ち遠しい。いくつか"}, {"type": "subtitle", "time": 13463.189, "timestamp": "03:44:23", "text": "クモの巣と埃が少し。素晴らしかった。"}, {"type": "subtitle", "time": 13464.95, "timestamp": "03:44:24", "text": "私はこれを本当に楽しめると思う"}, {"type": "subtitle", "time": 13468.63, "timestamp": "03:44:28", "text": "クラス。女性っぽい「えー」という声を出した方がいいかな？"}, {"type": "subtitle", "time": 13471.349, "timestamp": "03:44:31", "text": "それから？"}, {"type": "subtitle", "time": 13473.75, "timestamp": "03:44:33", "text": "ゲームのバランスを取ってくれよ、相棒。ああ、ファーストネーム"}, {"type": "subtitle", "time": 13475.269, "timestamp": "03:44:35", "text": "ジェックス。"}, {"type": "subtitle", "time": 13483.349, "timestamp": "03:44:43", "text": "アドリは魔女？それとも魔法使い？待って、私は何者なの？"}, {"type": "subtitle", "time": 13487.99, "timestamp": "03:44:47", "text": "魔法使いか魔女か？わからない。"}, {"type": "subtitle", "time": 13491.03, "timestamp": "03:44:51", "text": "待って、魔女は女性で魔法使いは"}, {"type": "subtitle", "time": 13497.349, "timestamp": "03:44:57", "text": "待って、あの猫はオスなの？うん、これ"}]
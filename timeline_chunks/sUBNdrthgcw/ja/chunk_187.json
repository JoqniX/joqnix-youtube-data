[{"type": "subtitle", "time": 11223.11, "timestamp": "03:07:03", "text": "そして、オン。もう彼らに会うことはないだろう。"}, {"type": "subtitle", "time": 11225.349, "timestamp": "03:07:05", "text": "しばらくの間はそうだったが、今はもう違う。しばらくの間。"}, {"type": "subtitle", "time": 11227.11, "timestamp": "03:07:07", "text": "うん、"}, {"type": "subtitle", "time": 11229.59, "timestamp": "03:07:09", "text": "技術的な問題がないことを願っています"}, {"type": "subtitle", "time": 11231.59, "timestamp": "03:07:11", "text": "今回はこうなった。私が戻ってきたとき"}, {"type": "subtitle", "time": 11234.15, "timestamp": "03:07:14", "text": "ある日から、"}, {"type": "subtitle", "time": 11237.67, "timestamp": "03:07:17", "text": "文字通り、ある日突然、痛みが襲ってきた。"}, {"type": "subtitle", "time": 11247.59, "timestamp": "03:07:27", "text": "本当に彼らができることを願っています"}, {"type": "subtitle", "time": 11251.19, "timestamp": "03:07:31", "text": "生き残るために何かが起こる。うん、私の"}, {"type": "subtitle", "time": 11253.59, "timestamp": "03:07:33", "text": "2番目に私のチャットモニターは、"}, {"type": "subtitle", "time": 11256.79, "timestamp": "03:07:36", "text": "ケーブルアダプターがうまく動作しないようです。それで"}, {"type": "subtitle", "time": 11259.51, "timestamp": "03:07:39", "text": "それも修正されることを願っています。私は注文しました"}, {"type": "subtitle", "time": 11262.07, "timestamp": "03:07:42", "text": "新しいケーブル。ええ、そうですね。"}, {"type": "subtitle", "time": 11264.389, "timestamp": "03:07:44", "text": "じゃあ、また後で会おうね"}, {"type": "subtitle", "time": 11267.269, "timestamp": "03:07:47", "text": "試験。わかった。そうですね、楽しみにしていてください"}, {"type": "subtitle", "time": 11269.19, "timestamp": "03:07:49", "text": "より多くのストリームと作業ストリームと新しい"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "新商品。"}, {"type": "subtitle", "time": 11273.99, "timestamp": "03:07:53", "text": "というわけで、改めてメリークリスマス！"}]
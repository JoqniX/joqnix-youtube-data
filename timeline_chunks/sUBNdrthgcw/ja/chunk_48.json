[{"type": "subtitle", "time": 2891.829, "timestamp": "00:48:11", "text": "はい、全員揃いました。こんにちは、えっと、"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "すべては皆の意見に従って"}, {"type": "subtitle", "time": 2895.43, "timestamp": "00:48:15", "text": "あれ。"}, {"type": "subtitle", "time": 2897.109, "timestamp": "00:48:17", "text": "切り替えると、"}, {"type": "subtitle", "time": 2900.47, "timestamp": "00:48:20", "text": "今はこれです。さて、まずは、えっと、誰"}, {"type": "subtitle", "time": 2909.75, "timestamp": "00:48:29", "text": "あの場所。私のジョークはどこにあるの？わかった。"}, {"type": "subtitle", "time": 2912.95, "timestamp": "00:48:32", "text": "わかった。えーと、最初に出てきたのは忍者でした。あなたは望んでいた"}, {"type": "subtitle", "time": 2916.15, "timestamp": "00:48:36", "text": "7ですよね？銀色のものと同じ7つ。"}, {"type": "subtitle", "time": 2918.549, "timestamp": "00:48:38", "text": "わかった。"}, {"type": "subtitle", "time": 2921.829, "timestamp": "00:48:41", "text": "忍者。忍者はどこにいる？そして、えーと"}, {"type": "subtitle", "time": 2930.71, "timestamp": "00:48:50", "text": "ああ、これはちょっと痛い。でも待って、私は"}]
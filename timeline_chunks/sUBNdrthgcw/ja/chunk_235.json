[{"type": "subtitle", "time": 14102.229, "timestamp": "03:55:02", "text": "そう、そして私のわがままに付き合ってくれるのも構わない。"}, {"type": "subtitle", "time": 14103.83, "timestamp": "03:55:03", "text": "少し見て回りたいのですが。"}, {"type": "subtitle", "time": 14106.95, "timestamp": "03:55:06", "text": "もちろんです、閣下。良い。見てみましょう"}, {"type": "subtitle", "time": 14110.15, "timestamp": "03:55:10", "text": "どんなに薄れていても、道を見つけることができる"}, {"type": "subtitle", "time": 14120.309, "timestamp": "03:55:20", "text": "ホグワーツへの道。わかった。"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "待って、どうしてこんなにぼやけてるの？"}, {"type": "subtitle", "time": 14126.05, "timestamp": "03:55:26", "text": "何？"}, {"type": "subtitle", "time": 14135.99, "timestamp": "03:55:35", "text": "なぜそれが"}, {"type": "subtitle", "time": 14145.03, "timestamp": "03:55:45", "text": "ああ、奥さんはどこへ行かれたのですか？はい、そうでした"}, {"type": "subtitle", "time": 14148.71, "timestamp": "03:55:48", "text": "洗練された私。良い質問ですね。"}, {"type": "subtitle", "time": 14150.79, "timestamp": "03:55:50", "text": "ミリアムは何年もかけて"}, {"type": "subtitle", "time": 14152.79, "timestamp": "03:55:52", "text": "長い間忘れ去られていた形態の証拠"}]
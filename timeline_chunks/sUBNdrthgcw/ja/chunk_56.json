[{"type": "subtitle", "time": 3362.15, "timestamp": "00:56:02", "text": "うん。忘れた"}, {"type": "subtitle", "time": 3364.63, "timestamp": "00:56:04", "text": "私がリツイートしたんです。私はリツイートしましたか？私はしません"}, {"type": "subtitle", "time": 3367.43, "timestamp": "00:56:07", "text": "知る。そうそう。それからこれをインストールしました。"}, {"type": "subtitle", "time": 3371.109, "timestamp": "00:56:11", "text": "わかった。すっかり忘れていました。あなたはできる"}, {"type": "subtitle", "time": 3373.27, "timestamp": "00:56:13", "text": "実際にそうしてください。 Streamは必要ありません"}, {"type": "subtitle", "time": 3376.069, "timestamp": "00:56:16", "text": "もうFXは必要ない。"}, {"type": "subtitle", "time": 3378.95, "timestamp": "00:56:18", "text": "待って、Zをダウンロードしたっけ？何"}, {"type": "subtitle", "time": 3381.349, "timestamp": "00:56:21", "text": "えっ？"}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "これをダウンロードしたかったんです。"}, {"type": "subtitle", "time": 3386.789, "timestamp": "00:56:26", "text": "うん。ええと、このプラグインを使うと"}, {"type": "subtitle", "time": 3389.109, "timestamp": "00:56:29", "text": "形状マスク、ソースマスク、画像"}, {"type": "subtitle", "time": 3392.47, "timestamp": "00:56:32", "text": "マーク、グラデーションマスクなど。これは"}, {"type": "subtitle", "time": 3394.95, "timestamp": "00:56:34", "text": "私はこれをやろうとしています。"}, {"type": "subtitle", "time": 3398.15, "timestamp": "00:56:38", "text": "この瞬間。形状マスク。"}, {"type": "subtitle", "time": 3400.309, "timestamp": "00:56:40", "text": "私たちには輪が必要だ。うん、これは役に立つよ"}, {"type": "subtitle", "time": 3404.23, "timestamp": "00:56:44", "text": "今。ほら、すべて順調でしょう。"}, {"type": "subtitle", "time": 3409.589, "timestamp": "00:56:49", "text": "素晴らしいものを作ってくれてありがとう。"}, {"type": "subtitle", "time": 3413.75, "timestamp": "00:56:53", "text": "ええと、有限です。有限は多くの良いものを作る"}, {"type": "subtitle", "time": 3416.23, "timestamp": "00:56:56", "text": "もの。文字通り３つ全部"}, {"type": "subtitle", "time": 3418.789, "timestamp": "00:56:58", "text": "資源は必須です。私は"}]
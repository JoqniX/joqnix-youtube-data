[{"type": "subtitle", "time": 17161.19, "timestamp": "04:46:01", "text": "続く。わかった。"}, {"type": "subtitle", "time": 17163.83, "timestamp": "04:46:03", "text": "最初のガイドを集める"}, {"type": "subtitle", "time": 17166.788, "timestamp": "04:46:06", "text": "ページが新しいチャレンジカテゴリをアンロックしました。"}, {"type": "subtitle", "time": 17169.35, "timestamp": "04:46:09", "text": "新しいチャレンジカテゴリーのチャレンジ"}, {"type": "subtitle", "time": 17170.868, "timestamp": "04:46:10", "text": "冒険を通してアンロックされます"}, {"type": "subtitle", "time": 17172.55, "timestamp": "04:46:12", "text": "ここに表示されます。フィールドガイドを設定する"}, {"type": "subtitle", "time": 17180.07, "timestamp": "04:46:20", "text": "各チャレンジには特別な報酬があります"}, {"type": "subtitle", "time": 17182.55, "timestamp": "04:46:22", "text": "各ティアを完了すると、"}, {"type": "subtitle", "time": 17187.91, "timestamp": "04:46:27", "text": "外観から重要なアップグレードまで。わかった。"}, {"type": "subtitle", "time": 17189.19, "timestamp": "04:46:29", "text": "報酬は以下から請求する必要があります"}, {"type": "subtitle", "time": 17192.39, "timestamp": "04:46:32", "text": "チャレンジメニュー。戻ってきて"}, {"type": "subtitle", "time": 17193.83, "timestamp": "04:46:33", "text": "報酬を集めるには、"}, {"type": "subtitle", "time": 17195.67, "timestamp": "04:46:35", "text": "収集しました。"}, {"type": "subtitle", "time": 17201.75, "timestamp": "04:46:41", "text": "[音楽]"}, {"type": "subtitle", "time": 17204.47, "timestamp": "04:46:44", "text": "マウスカーソルを重ねると、このアニメーションが表示されます。"}, {"type": "subtitle", "time": 17208.31, "timestamp": "04:46:48", "text": "わかった。コスメのロックを解除させてください。待って、"}, {"type": "subtitle", "time": 17212.47, "timestamp": "04:46:52", "text": "私の化粧品はどこ？ああ、私は"}, {"type": "subtitle", "time": 17214.628, "timestamp": "04:46:54", "text": "レベルアップして最初のストーリーをクリアしよう。おお、"}, {"type": "subtitle", "time": 17217.47, "timestamp": "04:46:57", "text": "待って、待って、気にしないで。待って。"}]
[{"type": "subtitle", "time": 14357.55, "timestamp": "03:59:17", "text": "それらを修理してください。それらを修理してください。"}, {"type": "subtitle", "time": 14368.63, "timestamp": "03:59:28", "text": "くそ。"}, {"type": "subtitle", "time": 14370.389, "timestamp": "03:59:30", "text": "見てください、まるで元に戻るように"}, {"type": "subtitle", "time": 14373.269, "timestamp": "03:59:33", "text": "何もない。おお。"}, {"type": "subtitle", "time": 14378.71, "timestamp": "03:59:38", "text": "もうすぐだ。"}, {"type": "subtitle", "time": 14381.83, "timestamp": "03:59:41", "text": "これは"}, {"type": "subtitle", "time": 14391.269, "timestamp": "03:59:51", "text": "[音楽]"}, {"type": "subtitle", "time": 14393.2, "timestamp": "03:59:53", "text": "何かあるはずだ。"}]
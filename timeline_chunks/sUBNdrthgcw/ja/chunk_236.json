[{"type": "subtitle", "time": 14167.189, "timestamp": "03:56:07", "text": "古代の魔法。はい、強力な魔法"}, {"type": "subtitle", "time": 14170.55, "timestamp": "03:56:10", "text": "ごく少数の人によって振るわれている"}, {"type": "subtitle", "time": 14177.91, "timestamp": "03:56:17", "text": "私たちは良いアイデアを持っていた。どの城が"}, {"type": "subtitle", "time": 14180.95, "timestamp": "03:56:20", "text": "によって建設され、それ自体が"}, {"type": "subtitle", "time": 14184.389, "timestamp": "03:56:24", "text": "あの古代の魔法？どこだかわからない"}, {"type": "subtitle", "time": 14186.309, "timestamp": "03:56:26", "text": "彼女は港を手に入れた"}, {"type": "subtitle", "time": 14189.99, "timestamp": "03:56:29", "text": "鍵だが、それは間違いなく"}, {"type": "subtitle", "time": 14192.95, "timestamp": "03:56:32", "text": "その検索。ああ、下り道がある"}, {"type": "subtitle", "time": 14195.62, "timestamp": "03:56:35", "text": "下に。こちらです。"}, {"type": "subtitle", "time": 14198.309, "timestamp": "03:56:38", "text": "[音楽]"}, {"type": "subtitle", "time": 14200.87, "timestamp": "03:56:40", "text": "しかし、奥様はなぜ"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "失われた魔法の証拠？"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "ミリアムはなぜそのようなことが起こるのか理解したかった"}, {"type": "subtitle", "time": 14207.269, "timestamp": "03:56:47", "text": "強力な魔法が消えた"}, {"type": "subtitle", "time": 14210.15, "timestamp": "03:56:50", "text": "魔法界。しなかった方がよかった"}, {"type": "subtitle", "time": 14212.389, "timestamp": "03:56:52", "text": "苗字。しかし、魔法も例外ではない。それ"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "今、私に見せてくれる。"}, {"type": "subtitle", "time": 14217.11, "timestamp": "03:56:57", "text": "本当に重要なのは、"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "それを操る。状況を変えられるといいなと思っています。"}]
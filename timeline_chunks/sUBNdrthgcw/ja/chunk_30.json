[{"type": "subtitle", "time": 1805.669, "timestamp": "00:30:05", "text": "それ以来、私はこのゲームから離れてしまった。私"}, {"type": "subtitle", "time": 1808.47, "timestamp": "00:30:08", "text": "おそらく、それは感受性の問題だろう。"}, {"type": "subtitle", "time": 1810.95, "timestamp": "00:30:10", "text": "ああ、どれくらいかかるんだろう"}, {"type": "subtitle", "time": 1814.149, "timestamp": "00:30:14", "text": "私はどれくらい苦しまなければならないのだろうか"}, {"type": "subtitle", "time": 1816.07, "timestamp": "00:30:16", "text": "戻るために"}, {"type": "subtitle", "time": 1852.47, "timestamp": "00:30:52", "text": "死亡者は17人です。こんにちは。"}]
[{"type": "subtitle", "time": 6131.75, "timestamp": "01:42:11", "text": "次回はこれをやります、えっと、インストールします"}, {"type": "subtitle", "time": 6135.03, "timestamp": "01:42:15", "text": "ソースのデフォルト設定を行い、"}, {"type": "subtitle", "time": 6138.07, "timestamp": "01:42:18", "text": "これらすべてをこのように受け止める"}, {"type": "subtitle", "time": 6140.629, "timestamp": "01:42:20", "text": "それぞれ。わかった。ええと、続ける前に、"}, {"type": "subtitle", "time": 6143.43, "timestamp": "01:42:23", "text": "すべて削除します。"}, {"type": "subtitle", "time": 6147.189, "timestamp": "01:42:27", "text": "皆さん、これを削除しましょう。"}, {"type": "subtitle", "time": 6150.79, "timestamp": "01:42:30", "text": "そうすることで呼吸が楽になります"}, {"type": "subtitle", "time": 6153.109, "timestamp": "01:42:33", "text": "若干。"}, {"type": "subtitle", "time": 6159.83, "timestamp": "01:42:39", "text": "えーと"}, {"type": "subtitle", "time": 6162.31, "timestamp": "01:42:42", "text": "1日にどれくらい食べるか確認したい"}, {"type": "subtitle", "time": 6168.55, "timestamp": "01:42:48", "text": "37"}, {"type": "subtitle", "time": 6172.229, "timestamp": "01:42:52", "text": "1.2.4でクラッシュします。あなたは"}, {"type": "subtitle", "time": 6179.109, "timestamp": "01:42:59", "text": "うん。そしてクラッシュする。"}]
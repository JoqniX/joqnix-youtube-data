[{"type": "subtitle", "time": 15242.389, "timestamp": "04:14:02", "text": "これがあなたが目にしたものだと推測します"}, {"type": "subtitle", "time": 15246.07, "timestamp": "04:14:06", "text": "床に。そうです。反射の"}, {"type": "subtitle", "time": 15248.309, "timestamp": "04:14:08", "text": "まだそこにあるが、像の位置は"}, {"type": "subtitle", "time": 15252.229, "timestamp": "04:14:12", "text": "一致しません。待って、あなたが動いたとき、"}, {"type": "subtitle", "time": 15253.83, "timestamp": "04:14:13", "text": "反射は"}, {"type": "subtitle", "time": 15257.11, "timestamp": "04:14:17", "text": "光。おお。 H. おそらくあなたは"}, {"type": "subtitle", "time": 15278.79, "timestamp": "04:14:38", "text": "お元気でお過ごしでしょうか。 1つ入手しました"}, {"type": "subtitle", "time": 15280.71, "timestamp": "04:14:40", "text": "稲妻のお守り。 Lumosは、"}, {"type": "subtitle", "time": 15283.59, "timestamp": "04:14:43", "text": "あなたの"}, {"type": "subtitle", "time": 15286.87, "timestamp": "04:14:46", "text": "呪文セット。ルモスは闇を生み出す。待って、"}, {"type": "subtitle", "time": 15288.87, "timestamp": "04:14:48", "text": "Lumosは先端に光を作り出します"}, {"type": "subtitle", "time": 15290.229, "timestamp": "04:14:50", "text": "杖を使って、"}, {"type": "subtitle", "time": 15291.99, "timestamp": "04:14:51", "text": "暗い。わかった、"}, {"type": "subtitle", "time": 15295.349, "timestamp": "04:14:55", "text": "ルモス。よくやった。さて、反射は"}, {"type": "subtitle", "time": 15298.309, "timestamp": "04:14:58", "text": "私の方を向いた。それは"}]
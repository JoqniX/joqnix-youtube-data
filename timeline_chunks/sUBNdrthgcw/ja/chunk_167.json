[{"type": "subtitle", "time": 10022.389, "timestamp": "02:47:02", "text": "陽気な。いいえ、満足していません。メリークリスマス"}, {"type": "subtitle", "time": 10024.309, "timestamp": "02:47:04", "text": "みんな。たとえそれが"}, {"type": "subtitle", "time": 10027.03, "timestamp": "02:47:07", "text": "まだクリスマスではないけれど、私は"}, {"type": "subtitle", "time": 10030.469, "timestamp": "02:47:10", "text": "皆にクリスマスの挨拶をするために。はぁ？それで、"}, {"type": "subtitle", "time": 10033.91, "timestamp": "02:47:13", "text": "28日に会おう。"}, {"type": "subtitle", "time": 10036.63, "timestamp": "02:47:16", "text": "戻ってきたらすぐに"}, {"type": "subtitle", "time": 10038.95, "timestamp": "02:47:18", "text": "ストリーム。私は気にしない"}, {"type": "subtitle", "time": 10042.63, "timestamp": "02:47:22", "text": "もし私が疲れていたら。起きろ。さあ、戻ってきて"}, {"type": "subtitle", "time": 10045.91, "timestamp": "02:47:25", "text": "ここ。ストリームを開始します"}, {"type": "subtitle", "time": 10048.389, "timestamp": "02:47:28", "text": "そして私たちはリラックスする"}, {"type": "subtitle", "time": 10051.349, "timestamp": "02:47:31", "text": "そして、私たちは楽しむ。ゆっくりして"}, {"type": "subtitle", "time": 10053.83, "timestamp": "02:47:33", "text": "すべて。ええ、コミッションをもらいました"}, {"type": "subtitle", "time": 10058.63, "timestamp": "02:47:38", "text": "終わりの前に行うように"}, {"type": "subtitle", "time": 10063.03, "timestamp": "02:47:43", "text": "30日。終わらせなければならない。そうします"}, {"type": "subtitle", "time": 10066.309, "timestamp": "02:47:46", "text": "ゆっくりと、そして"}, {"type": "subtitle", "time": 10068.87, "timestamp": "02:47:48", "text": "えっと、私は祝わないよ"}, {"type": "subtitle", "time": 10071.19, "timestamp": "02:47:51", "text": "新年ですよね？"}]
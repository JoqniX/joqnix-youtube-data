[{"type": "subtitle", "time": 3302.15, "timestamp": "00:55:02", "text": "私のえっと"}, {"type": "subtitle", "time": 3304.39, "timestamp": "00:55:04", "text": "ああ、そうだね。えっと、これは"}, {"type": "subtitle", "time": 3306.549, "timestamp": "00:55:06", "text": "良い？これを設置して"}, {"type": "subtitle", "time": 3309.829, "timestamp": "00:55:09", "text": "こんな風に混ぜるの？"}, {"type": "subtitle", "time": 3316.549, "timestamp": "00:55:16", "text": "他にできることは"}, {"type": "subtitle", "time": 3319.91, "timestamp": "00:55:19", "text": "デビルソンは、クリップマスクのようなものだと尋ねた。"}, {"type": "subtitle", "time": 3324.79, "timestamp": "00:55:24", "text": "私は次のようにすることができます"}, {"type": "subtitle", "time": 3327.829, "timestamp": "00:55:27", "text": "えっと、どこにあるんですか？かつてそこにあった場所"}, {"type": "subtitle", "time": 3331.109, "timestamp": "00:55:31", "text": "ここに私の画像ブレンドを配置した"}, {"type": "subtitle", "time": 3334.549, "timestamp": "00:55:34", "text": "丸いもの"}, {"type": "subtitle", "time": 3336.47, "timestamp": "00:55:36", "text": "あれ。"}, {"type": "subtitle", "time": 3338.71, "timestamp": "00:55:38", "text": "あれの名前は何でしたっけ？私"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "忘れた。"}, {"type": "subtitle", "time": 3344.549, "timestamp": "00:55:44", "text": "あれの名前は何でしたっけ？"}, {"type": "subtitle", "time": 3348.95, "timestamp": "00:55:48", "text": "えっと、何か"}, {"type": "subtitle", "time": 3351.51, "timestamp": "00:55:51", "text": "その周り"}, {"type": "subtitle", "time": 3353.67, "timestamp": "00:55:53", "text": "ああ、これだ。そうそう、"}, {"type": "subtitle", "time": 3355.349, "timestamp": "00:55:55", "text": "うん。ああ、忘れてた。うん、うん、うん。"}, {"type": "subtitle", "time": 3357.67, "timestamp": "00:55:57", "text": "これです。そうそう。うん。うん。うん。"}, {"type": "subtitle", "time": 3359.43, "timestamp": "00:55:59", "text": "彼はそれを最近再リリースした。そうそう。"}]
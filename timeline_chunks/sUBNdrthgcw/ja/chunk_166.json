[{"type": "subtitle", "time": 9962.309, "timestamp": "02:46:02", "text": "何てことだ。"}, {"type": "subtitle", "time": 9976.71, "timestamp": "02:46:16", "text": "私は３つ、えーっと、あれを取った。あなたがしたい場合は"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "スクリーンショットを撮ってください、ご自由にどうぞ"}, {"type": "subtitle", "time": 9981.67, "timestamp": "02:46:21", "text": "スクリーンショット。わかった。"}, {"type": "subtitle", "time": 9985.67, "timestamp": "02:46:25", "text": "見た目も良くて、すべてがうまくいっているといいのですが"}, {"type": "subtitle", "time": 9989.51, "timestamp": "02:46:29", "text": "この部屋で。感じないと思う"}, {"type": "subtitle", "time": 9994.389, "timestamp": "02:46:34", "text": "えっと、"}, {"type": "subtitle", "time": 10000.71, "timestamp": "02:46:40", "text": "違和感がないといいんだけど、まあね。"}, {"type": "subtitle", "time": 10009.91, "timestamp": "02:46:49", "text": "違和感がありますか？いいえ。そうです。思うに"}, {"type": "subtitle", "time": 10014.309, "timestamp": "02:46:54", "text": "その部屋に収まる。"}, {"type": "subtitle", "time": 10019.11, "timestamp": "02:46:59", "text": "こんにちは。ということで、またしても幸せ"}]
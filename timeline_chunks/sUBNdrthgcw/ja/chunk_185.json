[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "ジェイド・コップさん、ありがとうございます。ご来場ありがとうございます"}, {"type": "subtitle", "time": 11102.469, "timestamp": "03:05:02", "text": "による。"}, {"type": "subtitle", "time": 11105.19, "timestamp": "03:05:05", "text": "今日は楽しんでいただけたでしょうか。本当にありがとうございます"}, {"type": "subtitle", "time": 11125.83, "timestamp": "03:05:25", "text": "うん、"}, {"type": "subtitle", "time": 11127.91, "timestamp": "03:05:27", "text": "来てくれた人は全員です。ありがとう"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "皆さん、また来てくれてありがとう"}, {"type": "subtitle", "time": 11133.11, "timestamp": "03:05:33", "text": "による。早めのクリスマスを楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 11136.389, "timestamp": "03:05:36", "text": "お祝い配信。私たちは今日"}, {"type": "subtitle", "time": 11138.15, "timestamp": "03:05:38", "text": "私たちが何をしているかについて話し、"}, {"type": "subtitle", "time": 11139.83, "timestamp": "03:05:39", "text": "最初はすべて"}, {"type": "subtitle", "time": 11142.71, "timestamp": "03:05:42", "text": "注文や選択など。それから私たちは"}, {"type": "subtitle", "time": 11144.95, "timestamp": "03:05:44", "text": "ゲームとか色々やったよ"}, {"type": "subtitle", "time": 11153.349, "timestamp": "03:05:53", "text": "ああ、あくびが出てきた。そして"}, {"type": "subtitle", "time": 11156.87, "timestamp": "03:05:56", "text": "配信の終わり、えーとゲームの後、"}]
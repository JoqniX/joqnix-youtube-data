[{"type": "subtitle", "time": 13806.55, "timestamp": "03:50:06", "text": "うん。こんにちは。これ、見たことありますか？"}, {"type": "subtitle", "time": 13808.55, "timestamp": "03:50:08", "text": "おお、"}, {"type": "subtitle", "time": 13812.07, "timestamp": "03:50:12", "text": "私は持っている。私はニュースと脅迫を忘れた"}, {"type": "subtitle", "time": 13814.55, "timestamp": "03:50:14", "text": "レンロックはまさに​​その通りだ。"}, {"type": "subtitle", "time": 13816.07, "timestamp": "03:50:16", "text": "まだ説得できていないが"}, {"type": "subtitle", "time": 13818.63, "timestamp": "03:50:18", "text": "省庁の同僚たち、私は彼が"}, {"type": "subtitle", "time": 13823.51, "timestamp": "03:50:23", "text": "重大な脅威である。そしてそれはあなたの"}, {"type": "subtitle", "time": 13826.07, "timestamp": "03:50:26", "text": "妻、エラザール、"}, {"type": "subtitle", "time": 13828.229, "timestamp": "03:50:28", "text": "数ヶ月前に彼の活動について私に知らせてくれた人"}, {"type": "subtitle", "time": 13832.15, "timestamp": "03:50:32", "text": "前。ミリアム、どうやって"}, {"type": "subtitle", "time": 13833.99, "timestamp": "03:50:33", "text": "彼女は以前、ランドロックについて私に手紙を書いてくれた。"}, {"type": "subtitle", "time": 13836.95, "timestamp": "03:50:36", "text": "彼女は亡くなり、省庁がどうなっているのか疑問に思った。"}, {"type": "subtitle", "time": 13840.63, "timestamp": "03:50:40", "text": "彼の活動について知っていた。"}, {"type": "subtitle", "time": 13843.75, "timestamp": "03:50:43", "text": "私が答える前に、"}, {"type": "subtitle", "time": 13846.07, "timestamp": "03:50:46", "text": "これを受け取りました。"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "それは彼女が私に送ってきた最後のものだった。"}, {"type": "subtitle", "time": 13852.71, "timestamp": "03:50:52", "text": "エラザール。それは彼女のフクロウを通して私に届いたのですが、"}, {"type": "subtitle", "time": 13854.63, "timestamp": "03:50:54", "text": "連絡は一切なかった。"}, {"type": "subtitle", "time": 13856.309, "timestamp": "03:50:56", "text": "彼女は"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "安全のために、すぐに処分してください。"}]
[{"type": "subtitle", "time": 14702.309, "timestamp": "04:05:02", "text": "ここにあるあの魔法の石に来たのですか？"}, {"type": "subtitle", "time": 14703.91, "timestamp": "04:05:03", "text": "それは一番難しいことだよ。なぜ"}, {"type": "subtitle", "time": 14708.15, "timestamp": "04:05:08", "text": "その奥に部屋はありますか？どの部屋ですか？見えない"}, {"type": "subtitle", "time": 14710.87, "timestamp": "04:05:10", "text": "何でも。またあの輝きが戻ってきた。のように"}, {"type": "subtitle", "time": 14712.309, "timestamp": "04:05:12", "text": "ポーチに灯る光。私は手に入れている"}, {"type": "subtitle", "time": 14714.87, "timestamp": "04:05:14", "text": "中断された。きっともう遅い時間でしょう"}, {"type": "subtitle", "time": 14729.59, "timestamp": "04:05:29", "text": "ゴドリックの心臓。"}]
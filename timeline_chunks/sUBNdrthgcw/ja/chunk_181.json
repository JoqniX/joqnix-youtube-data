[{"type": "subtitle", "time": 10861.349, "timestamp": "03:01:01", "text": "私の友達数人が"}, {"type": "subtitle", "time": 10863.75, "timestamp": "03:01:03", "text": "クラブペンギンのレガシーをプレイするか"}, {"type": "subtitle", "time": 10866.23, "timestamp": "03:01:06", "text": "何か。私は「え、彼らはそうしなかったの？」と思いました"}, {"type": "subtitle", "time": 10868.309, "timestamp": "03:01:08", "text": "サービスを停止するか、"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "禁止された？私は知らなかったが、その後私は"}, {"type": "subtitle", "time": 10874.87, "timestamp": "03:01:14", "text": "レガシー関連の新しいアカウント"}, {"type": "subtitle", "time": 10877.11, "timestamp": "03:01:17", "text": "そして私はプレイした、ああ、これは"}, {"type": "subtitle", "time": 10879.19, "timestamp": "03:01:19", "text": "とても楽しいです。"}, {"type": "subtitle", "time": 10882.309, "timestamp": "03:01:22", "text": "だから、ブラウザゲームが、もし"}, {"type": "subtitle", "time": 10885.03, "timestamp": "03:01:25", "text": "物事が可能ならこれも"}, {"type": "subtitle", "time": 10887.83, "timestamp": "03:01:27", "text": "可能だと思うので、私はただ"}, {"type": "subtitle", "time": 10891.99, "timestamp": "03:01:31", "text": "どうにかして深く調べて、どうにかして"}, {"type": "subtitle", "time": 10899.11, "timestamp": "03:01:39", "text": "うん。それは良い質問ですね。自動で"}, {"type": "subtitle", "time": 10902.71, "timestamp": "03:01:42", "text": "ウェブサイトでホストされているもの。"}, {"type": "subtitle", "time": 10905.59, "timestamp": "03:01:45", "text": "うん、ストレスなんて抱えたくない"}, {"type": "subtitle", "time": 10910.23, "timestamp": "03:01:50", "text": "私自身、あるいは、時間がかかりすぎる"}, {"type": "subtitle", "time": 10913.67, "timestamp": "03:01:53", "text": "今日みたいに自分でやってみる。でも、あれは"}, {"type": "subtitle", "time": 10916.469, "timestamp": "03:01:56", "text": "良くなるだろう。だから、それを見せるだけでいい"}, {"type": "subtitle", "time": 10918.79, "timestamp": "03:01:58", "text": "みんなが持っているストリーム"}]
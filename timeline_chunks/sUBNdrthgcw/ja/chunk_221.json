[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "それが合うかどうかはわかりません。"}, {"type": "subtitle", "time": 13263.03, "timestamp": "03:41:03", "text": "なぜバンガロールに似ているのか"}, {"type": "subtitle", "time": 13264.04, "timestamp": "03:41:04", "text": "頂点？"}, {"type": "subtitle", "time": 13269.91, "timestamp": "03:41:09", "text": "[音楽]"}, {"type": "subtitle", "time": 13285.429, "timestamp": "03:41:25", "text": "ああ"}, {"type": "subtitle", "time": 13297.349, "timestamp": "03:41:37", "text": "私は、できると思うものを選んでいます"}, {"type": "subtitle", "time": 13300.63, "timestamp": "03:41:40", "text": "こちらでどうぞ。"}, {"type": "subtitle", "time": 13303.91, "timestamp": "03:41:43", "text": "これでいいと思うし"}, {"type": "subtitle", "time": 13306.469, "timestamp": "03:41:46", "text": "または"}, {"type": "subtitle", "time": 13309.58, "timestamp": "03:41:49", "text": "これかこれ。"}, {"type": "subtitle", "time": 13310.79, "timestamp": "03:41:50", "text": "[音楽]"}, {"type": "subtitle", "time": 13313.75, "timestamp": "03:41:53", "text": "ああ、女性らしいヘアスタイルにしましょうか。"}, {"type": "subtitle", "time": 13315.51, "timestamp": "03:41:55", "text": "それは"}, {"type": "subtitle", "time": 13317.269, "timestamp": "03:41:57", "text": "まさに私が望んでいたもの。これは一体何だったのか？"}, {"type": "subtitle", "time": 13319.75, "timestamp": "03:41:59", "text": "でも、見た目が良いかどうかは分かりません。私"}]
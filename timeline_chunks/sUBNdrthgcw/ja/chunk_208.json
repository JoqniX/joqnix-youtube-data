[{"type": "subtitle", "time": 12483.429, "timestamp": "03:28:03", "text": "私の人生。モーションブラーを発明したのは誰ですか？その"}, {"type": "subtitle", "time": 12486.309, "timestamp": "03:28:06", "text": "難しい。"}, {"type": "subtitle", "time": 12488.15, "timestamp": "03:28:08", "text": "えっと。わかった。さあ行こう。さあ行こう。すべて"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "大丈夫です。すべて順調です。さあ行こう。私"}, {"type": "subtitle", "time": 12503.99, "timestamp": "03:28:23", "text": "えっと、"}, {"type": "subtitle", "time": 12507.429, "timestamp": "03:28:27", "text": "えーと、通常の明るさはこれですが、"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "少しの間残しておきますので、皆さん"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "君たちも見えるよ。あ、待って。忘れた"}, {"type": "subtitle", "time": 12516.229, "timestamp": "03:28:36", "text": "常夜灯。常夜灯をつけています。"}, {"type": "subtitle", "time": 12519.51, "timestamp": "03:28:39", "text": "待って、それは配信に影響するの？待って、"}, {"type": "subtitle", "time": 12522.07, "timestamp": "03:28:42", "text": "茶色っぽいオレンジ色の何かが見える？"}, {"type": "subtitle", "time": 12525.51, "timestamp": "03:28:45", "text": "それとも私だけでしょうか？私だけでしょうか"}, {"type": "subtitle", "time": 12527.75, "timestamp": "03:28:47", "text": "えっと、待って、みんなこれ見てる？"}, {"type": "subtitle", "time": 12531.03, "timestamp": "03:28:51", "text": "オレンジ色、本当に鮮やかなオレンジ色のもの"}, {"type": "subtitle", "time": 12533.16, "timestamp": "03:28:53", "text": "画面？いいえ。そうです。"}, {"type": "subtitle", "time": 12534.55, "timestamp": "03:28:54", "text": "[音楽]"}, {"type": "subtitle", "time": 12536.229, "timestamp": "03:28:56", "text": "待って、それは私が遊べるってこと？"}, {"type": "subtitle", "time": 12538.87, "timestamp": "03:28:58", "text": "常夜灯をつけますか？ああ、それは私の役に立つだろう"}]
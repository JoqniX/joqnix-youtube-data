[{"type": "subtitle", "time": 16502.23, "timestamp": "04:35:02", "text": "ホグワーツでの最初の夜を楽しんでください。"}, {"type": "subtitle", "time": 16504.07, "timestamp": "04:35:04", "text": "よく眠る。"}, {"type": "subtitle", "time": 16505.67, "timestamp": "04:35:05", "text": "夜"}, {"type": "subtitle", "time": 16508.07, "timestamp": "04:35:08", "text": "あなたたち二人は寝ていない。良い一日を"}, {"type": "subtitle", "time": 16510.839, "timestamp": "04:35:10", "text": "夜。"}, {"type": "subtitle", "time": 16522.47, "timestamp": "04:35:22", "text": "ツイートするのを忘れていたことに今気づいた"}, {"type": "subtitle", "time": 16525.59, "timestamp": "04:35:25", "text": "小川。みんないなくなってしまったみたいだ。"}, {"type": "subtitle", "time": 16528.39, "timestamp": "04:35:28", "text": "談話室に行った方がいいでしょう。"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "わかりません。いいえ。つまり、私はツイートしました、"}, {"type": "subtitle", "time": 16537.91, "timestamp": "04:35:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16544.709, "timestamp": "04:35:44", "text": "たくさんの物。"}, {"type": "subtitle", "time": 16546.949, "timestamp": "04:35:46", "text": "もう何かを壊してしまった。何てことだ。"}, {"type": "subtitle", "time": 16549.75, "timestamp": "04:35:49", "text": "私は何を壊したの？私は壊した"}, {"type": "subtitle", "time": 16555.429, "timestamp": "04:35:55", "text": "ああ、それはそれを救った。私は壊した"}, {"type": "subtitle", "time": 16559.75, "timestamp": "04:35:59", "text": "あなたは今の私たちを受け入れてくれますか？"}]
[{"type": "subtitle", "time": 17821.51, "timestamp": "04:57:01", "text": "私自身も授業に行かなければならない。なぜ"}, {"type": "subtitle", "time": 17825.83, "timestamp": "04:57:05", "text": "私のGPUが上がったので"}, {"type": "subtitle", "time": 17828.31, "timestamp": "04:57:08", "text": "ファンは「ありがとう」と受け取った。両方のファンが"}, {"type": "subtitle", "time": 17832.31, "timestamp": "04:57:12", "text": "仕事を終えて、今日の幸運を祈っています。私"}, {"type": "subtitle", "time": 17834.47, "timestamp": "04:57:14", "text": "交換部品を受け取りました。"}, {"type": "subtitle", "time": 17836.55, "timestamp": "04:57:16", "text": "保証期間は過ぎています。非常に貴重なものとなるでしょう。"}, {"type": "subtitle", "time": 17838.868, "timestamp": "04:57:18", "text": "だから私はドライバーを持っていなかった"}, {"type": "subtitle", "time": 17841.91, "timestamp": "04:57:21", "text": "私にとって、それを開けて保管することは非常に貴重です"}, {"type": "subtitle", "time": 17845.75, "timestamp": "04:57:25", "text": "私のGPUを何と呼ぶのかはわかりませんが、"}, {"type": "subtitle", "time": 17847.91, "timestamp": "04:57:27", "text": "ファンを取り外した後の教室"}, {"type": "subtitle", "time": 17850.868, "timestamp": "04:57:30", "text": "ファンとその他諸々を手に入れるために"}, {"type": "subtitle", "time": 17856.23, "timestamp": "04:57:36", "text": "そういう人たちにはホグスミーを。私は待たなければならない"}, {"type": "subtitle", "time": 17860.948, "timestamp": "04:57:40", "text": "明日、開店する予定です。ええ、そうですね。それで、"}, {"type": "subtitle", "time": 17862.948, "timestamp": "04:57:42", "text": "だから私は配信していないんです"}, {"type": "subtitle", "time": 17866.55, "timestamp": "04:57:46", "text": "多くの。 1つ目はGPUの状況、2つ目は"}, {"type": "subtitle", "time": 17869.67, "timestamp": "04:57:49", "text": "ビリービリーのアップロードラッシュみたいな​​やつ、"}, {"type": "subtitle", "time": 17871.75, "timestamp": "04:57:51", "text": "でも私は「ああ、そうだね」って感じ。"}, {"type": "subtitle", "time": 17873.83, "timestamp": "04:57:53", "text": "YouTube ストリームで完了しました。"}, {"type": "subtitle", "time": 17877.51, "timestamp": "04:57:57", "text": "皆さん、こんにちは。私はアップロードしました"}]
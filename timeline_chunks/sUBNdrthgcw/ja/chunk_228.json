[{"type": "subtitle", "time": 13680.15, "timestamp": "03:48:00", "text": "岩。だから私が動き回ると"}, {"type": "subtitle", "time": 13682.71, "timestamp": "03:48:02", "text": "ヘッドホン、私の右側"}, {"type": "subtitle", "time": 13685.429, "timestamp": "03:48:05", "text": "ヘッドホンの一部は、"}, {"type": "subtitle", "time": 13688.469, "timestamp": "03:48:08", "text": "気難しい。分からないけど、そうかもしれない。えっと、これ"}, {"type": "subtitle", "time": 13691.51, "timestamp": "03:48:11", "text": "音声が途切れるので、"}, {"type": "subtitle", "time": 13702.469, "timestamp": "03:48:22", "text": "え、何？彼はただくるっと回って"}, {"type": "subtitle", "time": 13708.63, "timestamp": "03:48:28", "text": "見知らぬ人になる？はぁ？何だって？"}, {"type": "subtitle", "time": 13731.189, "timestamp": "03:48:51", "text": "世界。"}]
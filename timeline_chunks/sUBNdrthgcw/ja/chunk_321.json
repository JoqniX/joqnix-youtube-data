[{"type": "subtitle", "time": 19264.26, "timestamp": "05:21:04", "text": "ホーリー"}, {"type": "subtitle", "time": 19272.15, "timestamp": "05:21:12", "text": "これをもう少し面白くしてみましょう。"}, {"type": "subtitle", "time": 19274.948, "timestamp": "05:21:14", "text": "しましょうか？"}, {"type": "subtitle", "time": 19277.99, "timestamp": "05:21:17", "text": "ああ、まだ続きがある。そうすれば勝てる。"}, {"type": "subtitle", "time": 19280.31, "timestamp": "05:21:20", "text": "迷子犬の連絡先。心配しないで。見ます"}, {"type": "subtitle", "time": 19283.11, "timestamp": "05:21:23", "text": "私の勝ちだ。私たちはもうとっくに過ぎていると思います"}, {"type": "subtitle", "time": 19286.55, "timestamp": "05:21:26", "text": "現時点では興味深い。"}, {"type": "subtitle", "time": 19290.55, "timestamp": "05:21:30", "text": "そうですね。おしゃべりはもう十分だ。今は集中する。あなた"}, {"type": "subtitle", "time": 19292.23, "timestamp": "05:21:32", "text": "必要になるだろう。"}, {"type": "subtitle", "time": 19312.47, "timestamp": "05:21:52", "text": "３、２、正しいものを見つけなければならない"}]
[{"type": "subtitle", "time": 7260.149, "timestamp": "02:01:00", "text": "[音楽]"}, {"type": "subtitle", "time": 7262.87, "timestamp": "02:01:02", "text": "わかった。ええと、教えてください。えっと、7番目。"}, {"type": "subtitle", "time": 7264.629, "timestamp": "02:01:04", "text": "わかった。"}, {"type": "subtitle", "time": 7291.75, "timestamp": "02:01:31", "text": "ソースのデフォルトプラグインを設定する必要があります。"}, {"type": "subtitle", "time": 7294.47, "timestamp": "02:01:34", "text": "私はこれをインストールしていません"}, {"type": "subtitle", "time": 7305.669, "timestamp": "02:01:45", "text": "ええ、半分くらいは"}, {"type": "subtitle", "time": 7307.99, "timestamp": "02:01:47", "text": "1つ。わかりました、混乱しているなら、"}, {"type": "subtitle", "time": 7310.39, "timestamp": "02:01:50", "text": "わかった。ええと、ランダム化ツールのようなものを使うことができます"}, {"type": "subtitle", "time": 7313.99, "timestamp": "02:01:53", "text": "何か、そして1から14までで"}, {"type": "subtitle", "time": 7316.95, "timestamp": "02:01:56", "text": "何にでも選んでください。はい、1つと言いましたね。"}]
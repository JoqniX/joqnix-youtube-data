[{"type": "subtitle", "time": 722.87, "timestamp": "00:12:02", "text": "録音機器のマイクを見てください。"}, {"type": "subtitle", "time": 726.069, "timestamp": "00:12:06", "text": "理由はわからないが"}, {"type": "subtitle", "time": 729.91, "timestamp": "00:12:09", "text": "それ以外に音声があるのは彼です"}, {"type": "subtitle", "time": 732.629, "timestamp": "00:12:12", "text": "何かの魔法が行われているに違いない"}, {"type": "subtitle", "time": 740.31, "timestamp": "00:12:20", "text": "ゲームに参加してプレイすることから"}, {"type": "subtitle", "time": 747.99, "timestamp": "00:12:27", "text": "休む。え、君は遊んでたの？おお、"}, {"type": "subtitle", "time": 751.269, "timestamp": "00:12:31", "text": "うん。あなたは遊んでいなかった。いいえ、私は"}, {"type": "subtitle", "time": 754.87, "timestamp": "00:12:34", "text": "期末試験を受けようとしたのですが、クラッシュしてしまいました。しかし"}, {"type": "subtitle", "time": 756.629, "timestamp": "00:12:36", "text": "大丈夫、"}]
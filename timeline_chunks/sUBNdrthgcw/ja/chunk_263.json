[{"type": "subtitle", "time": 15790.389, "timestamp": "04:23:10", "text": "それがあなたが見ているものです。その輝き"}, {"type": "subtitle", "time": 15793.349, "timestamp": "04:23:13", "text": "彼らを取り囲んだ。はい、承知いたしました。"}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "驚くべきことだ。魔法を見ることはできますか？痕跡"}, {"type": "subtitle", "time": 15801.91, "timestamp": "04:23:21", "text": "正確に言うと、古代の魔法だ。"}, {"type": "subtitle", "time": 15805.11, "timestamp": "04:23:25", "text": "何てことだ。ミリアムはいつも信じていた"}, {"type": "subtitle", "time": 15814.55, "timestamp": "04:23:34", "text": "ミリアムと恐らくジョージは"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "知識の追求"}, {"type": "subtitle", "time": 15819.429, "timestamp": "04:23:39", "text": "何世紀にもわたって休眠状態にあった。"}, {"type": "subtitle", "time": 15822.149, "timestamp": "04:23:42", "text": "そしてあなたは、"}, {"type": "subtitle", "time": 15824.71, "timestamp": "04:23:44", "text": "私たちが"}, {"type": "subtitle", "time": 15826.71, "timestamp": "04:23:46", "text": "意思。すべてがかなり違って見える"}, {"type": "subtitle", "time": 15828.95, "timestamp": "04:23:48", "text": "ついさっきまではそうだった。"}, {"type": "subtitle", "time": 15831.349, "timestamp": "04:23:51", "text": "誰かが来る。"}, {"type": "subtitle", "time": 15834.87, "timestamp": "04:23:54", "text": "彼らは一体誰だったのか？わからない。しかし、閣下、"}]
[{"type": "subtitle", "time": 18061.27, "timestamp": "05:01:01", "text": "ウィーズリー教授、お見せしましょうか"}, {"type": "subtitle", "time": 18063.43, "timestamp": "05:01:03", "text": "私たちが組み込んだ巧妙な魔法"}, {"type": "subtitle", "time": 18065.99, "timestamp": "05:01:05", "text": "野外ガイドの地図。広げて"}, {"type": "subtitle", "time": 18069.59, "timestamp": "05:01:09", "text": "一瞥。わかった。"}, {"type": "subtitle", "time": 18071.59, "timestamp": "05:01:11", "text": "クエストログ。追跡可能な"}, {"type": "subtitle", "time": 18079.91, "timestamp": "05:01:19", "text": "主な進行状況を表しています"}, {"type": "subtitle", "time": 18081.59, "timestamp": "05:01:21", "text": "ストーリー、新機能のロック解除、そして"}, {"type": "subtitle", "time": 18084.07, "timestamp": "05:01:24", "text": "XP。"}, {"type": "subtitle", "time": 18086.15, "timestamp": "05:01:26", "text": "続く。一部のクエストはロックされています"}, {"type": "subtitle", "time": 18088.55, "timestamp": "05:01:28", "text": "呪文を使うか、レベル制限がある。で"}, {"type": "subtitle", "time": 18090.948, "timestamp": "05:01:30", "text": "これらのケースでは、"}, {"type": "subtitle", "time": 18092.628, "timestamp": "05:01:32", "text": "必要なレベルまたは必要な呪文を持っている"}, {"type": "subtitle", "time": 18094.868, "timestamp": "05:01:34", "text": "クエストをアクティブ化します。新しいスキルは"}, {"type": "subtitle", "time": 18096.55, "timestamp": "05:01:36", "text": "教授の課題を完了することで取得"}, {"type": "subtitle", "time": 18101.03, "timestamp": "05:01:41", "text": "任務またはクエスト報酬。わかった。"}, {"type": "subtitle", "time": 18104.47, "timestamp": "05:01:44", "text": "クエスト"}, {"type": "subtitle", "time": 18112.64, "timestamp": "05:01:52", "text": "魅力アップ講座にしましょう。"}, {"type": "subtitle", "time": 18114.868, "timestamp": "05:01:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13560.469, "timestamp": "03:46:00", "text": "埃が少し。心配する必要はありません"}, {"type": "subtitle", "time": 13571.189, "timestamp": "03:46:11", "text": "私は早く行きたいと思っています。素晴らしかったです。"}, {"type": "subtitle", "time": 13573.189, "timestamp": "03:46:13", "text": "私は本当にいくつか行くつもりです"}, {"type": "subtitle", "time": 13575.269, "timestamp": "03:46:15", "text": "クモの巣と埃が少し。何もない"}, {"type": "subtitle", "time": 13576.63, "timestamp": "03:46:16", "text": "懸念している。これでいきましょう。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "わかった。"}, {"type": "subtitle", "time": 13582.55, "timestamp": "03:46:22", "text": "じゃあ、魔法使いの方にしよう。わかった。"}, {"type": "subtitle", "time": 13585.269, "timestamp": "03:46:25", "text": "さあ、旅を始めましょう。俺たちはみんな"}, {"type": "subtitle", "time": 13589.99, "timestamp": "03:46:29", "text": "みんな準備はいいかな？さあ行こう。 ３、２、"}, {"type": "subtitle", "time": 13591.91, "timestamp": "03:46:31", "text": "1つ、"}, {"type": "subtitle", "time": 13598.63, "timestamp": "03:46:38", "text": "[音楽]"}, {"type": "subtitle", "time": 13600.87, "timestamp": "03:46:40", "text": "ああ、なんてことだ、低品質だ。私はとても"}, {"type": "subtitle", "time": 13603.03, "timestamp": "03:46:43", "text": "ごめん。あなたはこれに耐えなければならない"}, {"type": "subtitle", "time": 13605.03, "timestamp": "03:46:45", "text": "あと1つ。準備はほぼ整ったようです"}, {"type": "subtitle", "time": 13607.03, "timestamp": "03:46:47", "text": "出発する。"}, {"type": "subtitle", "time": 13608.389, "timestamp": "03:46:48", "text": "どう発音しますか？わからない。"}, {"type": "subtitle", "time": 13609.99, "timestamp": "03:46:49", "text": "呪文に費やす時間をもう少し増やそう"}, {"type": "subtitle", "time": 13611.67, "timestamp": "03:46:51", "text": "鋳造。それは本当に必要なことなのか？あなたは"}, {"type": "subtitle", "time": 13613.269, "timestamp": "03:46:53", "text": "これまで練習してきた呪文を実践してきました。"}, {"type": "subtitle", "time": 13615.99, "timestamp": "03:46:55", "text": "はい、教授。ええ、私は確信しています"}, {"type": "subtitle", "time": 13618.229, "timestamp": "03:46:58", "text": "こんなに早く受け取る人を見たことがない"}]
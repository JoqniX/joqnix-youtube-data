[{"type": "subtitle", "time": 11285.75, "timestamp": "03:08:05", "text": "来てくれて本当にありがとう"}, {"type": "subtitle", "time": 11288.79, "timestamp": "03:08:08", "text": "みんな。皆さんとお会いしましょう"}, {"type": "subtitle", "time": 11290.79, "timestamp": "03:08:10", "text": "次のやつ。"}, {"type": "subtitle", "time": 11293.99, "timestamp": "03:08:13", "text": "そして、今日の写真は投稿されます"}, {"type": "subtitle", "time": 11296.71, "timestamp": "03:08:16", "text": "Twitterやその他のプラットフォームで。わかった。それで"}, {"type": "subtitle", "time": 11298.469, "timestamp": "03:08:18", "text": "ご希望であればご覧ください"}, {"type": "subtitle", "time": 11300.87, "timestamp": "03:08:20", "text": "に。うん。"}, {"type": "subtitle", "time": 11303.429, "timestamp": "03:08:23", "text": "良い一日を。バイバイ。"}, {"type": "subtitle", "time": 11305.91, "timestamp": "03:08:25", "text": "襲撃とかそういうことはしませんよ。えっと、"}, {"type": "subtitle", "time": 11309.429, "timestamp": "03:08:29", "text": "ゆっくり休んでください。"}, {"type": "subtitle", "time": 11311.83, "timestamp": "03:08:31", "text": "他の人を見たいなら、"}, {"type": "subtitle", "time": 11314.389, "timestamp": "03:08:34", "text": "彼らを観察したり、いろいろと。わかった。良い一日を"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "1つ。眠っている人たちのために、"}, {"type": "subtitle", "time": 11320.23, "timestamp": "03:08:40", "text": "星"}, {"type": "subtitle", "time": 11323.19, "timestamp": "03:08:43", "text": "今夜あなたを導き、祝福します"}, {"type": "subtitle", "time": 11326.389, "timestamp": "03:08:46", "text": "良い温かい夢を見て、目覚めて希望を抱く"}, {"type": "subtitle", "time": 11327.91, "timestamp": "03:08:47", "text": "朝起きると"}, {"type": "subtitle", "time": 11330.389, "timestamp": "03:08:50", "text": "あなたの顔に笑顔が浮かんでいる。いいえ、"}, {"type": "subtitle", "time": 11332.63, "timestamp": "03:08:52", "text": "そして、あなたが働いている人たちのために"}, {"type": "subtitle", "time": 11335.83, "timestamp": "03:08:55", "text": "そして最善を尽くす"}, {"type": "subtitle", "time": 11338.63, "timestamp": "03:08:58", "text": "あなたにとって、朝、夕方、午後。"}]
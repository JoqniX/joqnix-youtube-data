[{"type": "subtitle", "time": 12843.03, "timestamp": "03:34:03", "text": "こんにちは。もう90度だ。え、何だって？"}, {"type": "subtitle", "time": 12846.79, "timestamp": "03:34:06", "text": "はい、ストリーミング中は37％です"}, {"type": "subtitle", "time": 12850.07, "timestamp": "03:34:10", "text": "注記では、発売時にはいくらになるのでしょうか？"}, {"type": "subtitle", "time": 12853.11, "timestamp": "03:34:13", "text": "ゲーム？さあ行こう、"}, {"type": "subtitle", "time": 12869.03, "timestamp": "03:34:29", "text": "では、スマホでチャットを読んでみます。私"}, {"type": "subtitle", "time": 12871.91, "timestamp": "03:34:31", "text": "ブラウザは使用しません。なぜならブラウザは"}, {"type": "subtitle", "time": 12874.79, "timestamp": "03:34:34", "text": "強く持ち上げる。"}, {"type": "subtitle", "time": 12877.349, "timestamp": "03:34:37", "text": "ああ、なんてことだ、動作が遅い。ああ、それは"}, {"type": "subtitle", "time": 12879.429, "timestamp": "03:34:39", "text": "遅れている。"}, {"type": "subtitle", "time": 12882.389, "timestamp": "03:34:42", "text": "待って、メインストーリーに追いついてないよ"}, {"type": "subtitle", "time": 12885.51, "timestamp": "03:34:45", "text": "ああ、まずい。"}, {"type": "subtitle", "time": 12887.91, "timestamp": "03:34:47", "text": "ええ、文字通り、あなたが私が"}, {"type": "subtitle", "time": 12890.63, "timestamp": "03:34:50", "text": "ホグワーツを起動すると、ラグが発生します。"}, {"type": "subtitle", "time": 12893.429, "timestamp": "03:34:53", "text": "マウスがこんな風になるもの"}, {"type": "subtitle", "time": 12895.67, "timestamp": "03:34:55", "text": "シャッターが切れるような感じ。わかりません"}, {"type": "subtitle", "time": 12897.67, "timestamp": "03:34:57", "text": "これは一体何なのか。"}, {"type": "subtitle", "time": 12899.429, "timestamp": "03:34:59", "text": "Nvidiaのドライブが原因ですか？"}]
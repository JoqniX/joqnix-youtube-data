[{"type": "subtitle", "time": 2760.95, "timestamp": "00:46:00", "text": "通常。えっと、覚えておいてください、あなたは"}, {"type": "subtitle", "time": 2766.71, "timestamp": "00:46:06", "text": "待って、待って、残りの"}, {"type": "subtitle", "time": 2768.55, "timestamp": "00:46:08", "text": "人々？ちょっと待って。私は何をしたの？何"}, {"type": "subtitle", "time": 2771.67, "timestamp": "00:46:11", "text": "私がやったの？"}, {"type": "subtitle", "time": 2775.67, "timestamp": "00:46:15", "text": "何てことだ。私は何をしたの？"}, {"type": "subtitle", "time": 2801.51, "timestamp": "00:46:41", "text": "他に誰がいる？アストロとシイナ。えっと、それは"}, {"type": "subtitle", "time": 2808.23, "timestamp": "00:46:48", "text": "そして"}]
[{"type": "subtitle", "time": 18121.51, "timestamp": "05:02:01", "text": "地図はあなたが見つけるのを助けるために魔法がかけられています"}, {"type": "subtitle", "time": 18123.43, "timestamp": "05:02:03", "text": "あなたのやり方で。これは信じられないほど"}, {"type": "subtitle", "time": 18126.39, "timestamp": "05:02:06", "text": "役立つ。ありがとう。今は、"}, {"type": "subtitle", "time": 18128.31, "timestamp": "05:02:08", "text": "今日はかなり忙しい一日になりそうだね。何が"}, {"type": "subtitle", "time": 18130.39, "timestamp": "05:02:10", "text": "授業とホッグスミートへの旅行"}, {"type": "subtitle", "time": 18133.35, "timestamp": "05:02:13", "text": "杖を含む必要な備品一式。"}, {"type": "subtitle", "time": 18135.67, "timestamp": "05:02:15", "text": "オリバンダー氏とのやり取りはきっと気に入るでしょう。彼は"}, {"type": "subtitle", "time": 18138.15, "timestamp": "05:02:18", "text": "卓越した職人であり、良き友人でもある。"}, {"type": "subtitle", "time": 18140.07, "timestamp": "05:02:20", "text": "もっと情報があれば連絡します"}, {"type": "subtitle", "time": 18143.19, "timestamp": "05:02:23", "text": "私たちの謎のロケットに関する情報。"}, {"type": "subtitle", "time": 18145.91, "timestamp": "05:02:25", "text": "今は授業に集中して、"}, {"type": "subtitle", "time": 18148.788, "timestamp": "05:02:28", "text": "注意。フクロウが蝶番になるよりも"}, {"type": "subtitle", "time": 18150.55, "timestamp": "05:02:30", "text": "あなたが習得できる魔法について"}, {"type": "subtitle", "time": 18154.07, "timestamp": "05:02:34", "text": "この壁の中で。こんにちは"}, {"type": "subtitle", "time": 18157.75, "timestamp": "05:02:37", "text": "そこにチャンプラスがいる。こんにちは。"}, {"type": "subtitle", "time": 18163.03, "timestamp": "05:02:43", "text": "Honestlyへようこそ。羅針盤がある。"}, {"type": "subtitle", "time": 18167.91, "timestamp": "05:02:47", "text": "おお。それは蝶の形をしたコンパスです。"}, {"type": "subtitle", "time": 18170.23, "timestamp": "05:02:50", "text": "何てことだ。何か入っている。私"}, {"type": "subtitle", "time": 18173.11, "timestamp": "05:02:53", "text": "ただ、それを知っておいてほしい。こんにちは。これは誰ですか？私"}, {"type": "subtitle", "time": 18175.11, "timestamp": "05:02:55", "text": "私たちは会ったことがないと思います。ああ、こんにちは。私は"}, {"type": "subtitle", "time": 18176.708, "timestamp": "05:02:56", "text": "レノラ。"}, {"type": "subtitle", "time": 18178.39, "timestamp": "05:02:58", "text": "少し上の空に見えたらごめんなさい。"}]
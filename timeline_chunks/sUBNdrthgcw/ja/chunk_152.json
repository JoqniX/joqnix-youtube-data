[{"type": "subtitle", "time": 9121.51, "timestamp": "02:32:01", "text": "えっと"}, {"type": "subtitle", "time": 9124.07, "timestamp": "02:32:04", "text": "そろそろまとめが必要だ。よし、追加しよう"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "うん、そのウェブサイトのアイデアは"}, {"type": "subtitle", "time": 9145.03, "timestamp": "02:32:25", "text": "はるかに良い。私は推測する"}, {"type": "subtitle", "time": 9147.99, "timestamp": "02:32:27", "text": "私はそう感じます、なぜなら私たちは"}, {"type": "subtitle", "time": 9150.07, "timestamp": "02:32:30", "text": "これを今すぐやらなければならない。考えてみてください"}, {"type": "subtitle", "time": 9153.03, "timestamp": "02:32:33", "text": "今のところ私の現在の"}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "ええと、私は大丈夫だと思います。"}, {"type": "subtitle", "time": 9159.51, "timestamp": "02:32:39", "text": "手動で20人から30人くらい追加する"}, {"type": "subtitle", "time": 9161.91, "timestamp": "02:32:41", "text": "大丈夫です"}, {"type": "subtitle", "time": 9165.27, "timestamp": "02:32:45", "text": "しかし、将来を見据えて考えると"}, {"type": "subtitle", "time": 9168.07, "timestamp": "02:32:48", "text": "次のクリスマスがどうなるか、誰にもわからない"}, {"type": "subtitle", "time": 9171.51, "timestamp": "02:32:51", "text": "どれくらいありますか、いくつありますか"}, {"type": "subtitle", "time": 9177.19, "timestamp": "02:32:57", "text": "コンステラもいるから、うん"}, {"type": "subtitle", "time": 9179.99, "timestamp": "02:32:59", "text": "あまり難しくしたくない、厳しくしたくない"}]
[{"type": "subtitle", "time": 5284.95, "timestamp": "01:28:04", "text": "あぁ、一時停止フレームがありますよね？"}, {"type": "subtitle", "time": 5293.91, "timestamp": "01:28:13", "text": "えっと、指定していませんでした"}, {"type": "subtitle", "time": 5296.64, "timestamp": "01:28:16", "text": "私は信じている。"}, {"type": "subtitle", "time": 5298.39, "timestamp": "01:28:18", "text": "[笑い]"}, {"type": "subtitle", "time": 5300.47, "timestamp": "01:28:20", "text": "わかった。具体的に指定されていません。わかった。何"}, {"type": "subtitle", "time": 5303.75, "timestamp": "01:28:23", "text": "私について何て言った？のように"}, {"type": "subtitle", "time": 5307.59, "timestamp": "01:28:27", "text": "ミアは何て言ったの？えっと"}, {"type": "subtitle", "time": 5317.03, "timestamp": "01:28:37", "text": "N. わかりました。ニオン。"}, {"type": "subtitle", "time": 5320.149, "timestamp": "01:28:40", "text": "ここにnionはありますか？いいえ。"}, {"type": "subtitle", "time": 5323.189, "timestamp": "01:28:43", "text": "私たちはnを手に入れました"}, {"type": "subtitle", "time": 5326.55, "timestamp": "01:28:46", "text": "パンについては、特に指定はありません。"}, {"type": "subtitle", "time": 5330.709, "timestamp": "01:28:50", "text": "ほら、だからチャットログって言ったんだよ"}, {"type": "subtitle", "time": 5333.83, "timestamp": "01:28:53", "text": "良いですね。"}, {"type": "subtitle", "time": 5337.669, "timestamp": "01:28:57", "text": "チャドロックスは良い。"}]
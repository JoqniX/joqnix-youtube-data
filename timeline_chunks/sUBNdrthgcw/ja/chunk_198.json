[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "私の心臓はドキドキ死にそう"}, {"type": "subtitle", "time": 11887.51, "timestamp": "03:18:07", "text": "こっちは、ある意味で"}, {"type": "subtitle", "time": 11890.79, "timestamp": "03:18:10", "text": "ある意味これは、これはほとんど"}, {"type": "subtitle", "time": 11893.75, "timestamp": "03:18:13", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "まるで旅行をしているような気分だ。"}, {"type": "subtitle", "time": 11899.59, "timestamp": "03:18:19", "text": "私はノートパソコンを使っていますが、"}, {"type": "subtitle", "time": 11901.59, "timestamp": "03:18:21", "text": "これが私のメインのセットアップです。私は一時的に"}, {"type": "subtitle", "time": 11905.429, "timestamp": "03:18:25", "text": "準備段階。そう、そんな感じ。"}, {"type": "subtitle", "time": 11907.51, "timestamp": "03:18:27", "text": "ああ、それはすごく楽しいですね。何てことだ、"}, {"type": "subtitle", "time": 11910.63, "timestamp": "03:18:30", "text": "でも、これはすごく楽しい。おお。する必要がある"}, {"type": "subtitle", "time": 11913.429, "timestamp": "03:18:33", "text": "準備が必要です。うん、必要だ"}, {"type": "subtitle", "time": 11916.389, "timestamp": "03:18:36", "text": "準備して、えーと、えーと"}, {"type": "subtitle", "time": 11919.67, "timestamp": "03:18:39", "text": "私が遅くまでプレーしていた理由。今日は私のGPU"}, {"type": "subtitle", "time": 11922.63, "timestamp": "03:18:42", "text": "ファン交換部品が届きました"}, {"type": "subtitle", "time": 11926.63, "timestamp": "03:18:46", "text": "えっと、今日到着しました。それは到着しました"}, {"type": "subtitle", "time": 11930.469, "timestamp": "03:18:50", "text": "4:15、私はこのストリームを設定しました。"}, {"type": "subtitle", "time": 11934.15, "timestamp": "03:18:54", "text": "最初は午後4時午後4時30分それは"}, {"type": "subtitle", "time": 11937.11, "timestamp": "03:18:57", "text": "4時15分頃に到着した。うん。それで"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "ストリームの前に。ええ、15日に届きました"}]
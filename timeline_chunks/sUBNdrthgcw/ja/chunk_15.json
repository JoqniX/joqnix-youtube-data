[{"type": "subtitle", "time": 901.99, "timestamp": "00:15:01", "text": "それと、幽霊もね。それでおしまい。後"}, {"type": "subtitle", "time": 903.99, "timestamp": "00:15:03", "text": "もうヴァレラントとは縁を切った。行かない"}, {"type": "subtitle", "time": 906.47, "timestamp": "00:15:06", "text": "何かを買うこと自体ができない。"}, {"type": "subtitle", "time": 909.829, "timestamp": "00:15:09", "text": "でも最近は、それを使うときは"}, {"type": "subtitle", "time": 913.43, "timestamp": "00:15:13", "text": "ヴァンダルスキンは今、私は"}, {"type": "subtitle", "time": 916.389, "timestamp": "00:15:16", "text": "飽きたとか何か"}, {"type": "subtitle", "time": 919.03, "timestamp": "00:15:19", "text": "今これをやってる時、わからない"}, {"type": "subtitle", "time": 922.55, "timestamp": "00:15:22", "text": "飽きてしまった。欲しい人いますか？わかった"}, {"type": "subtitle", "time": 924.629, "timestamp": "00:15:24", "text": "彼らは私にその皮を残してくれた。ありがとう"}, {"type": "subtitle", "time": 931.35, "timestamp": "00:15:31", "text": "飽きない。私はどちらかというと"}, {"type": "subtitle", "time": 934.15, "timestamp": "00:15:34", "text": "基本的なバンテル。理由がわからない。何"}, {"type": "subtitle", "time": 938.15, "timestamp": "00:15:38", "text": "EUサーバーでプレイしていた時に私にも起こったことです"}]
[{"type": "subtitle", "time": 2583.67, "timestamp": "00:43:03", "text": "さあ、全員の名前を挙げなくてはならない。"}, {"type": "subtitle", "time": 2603.91, "timestamp": "00:43:23", "text": "それでは参加者をあちらへお連れします"}, {"type": "subtitle", "time": 2618.63, "timestamp": "00:43:38", "text": "そして３つ目、そしてカンは指定しなかった"}, {"type": "subtitle", "time": 2621.75, "timestamp": "00:43:41", "text": "そこで彼にルーレットを渡した。マナチャもまた"}]
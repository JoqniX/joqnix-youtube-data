[{"type": "subtitle", "time": 18311.59, "timestamp": "05:05:11", "text": "レノラ、私はその謎を解き明かした"}, {"type": "subtitle", "time": 18316.628, "timestamp": "05:05:16", "text": "絵画。そうなんですか？どうやって？"}, {"type": "subtitle", "time": 18317.91, "timestamp": "05:05:17", "text": "手がかりを追ってみよう。私は見つけた"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "絵画に描かれている場所と"}, {"type": "subtitle", "time": 18321.51, "timestamp": "05:05:21", "text": "それから私はルモスを唱えて蛾を誘導した"}, {"type": "subtitle", "time": 18323.51, "timestamp": "05:05:23", "text": "フレームに。すべて非常に論理的です、私は"}, {"type": "subtitle", "time": 18327.03, "timestamp": "05:05:27", "text": "仮定する。解決にあと一歩だったのに残念だ"}, {"type": "subtitle", "time": 18328.948, "timestamp": "05:05:28", "text": "それ。問題を解決する才能がありますか？"}, {"type": "subtitle", "time": 18332.39, "timestamp": "05:05:32", "text": "なぞなぞ？ナットもそれが得意なんだ。そうです"}, {"type": "subtitle", "time": 18335.03, "timestamp": "05:05:35", "text": "肉。彼は、ああ、わかった。"}, {"type": "subtitle", "time": 18336.788, "timestamp": "05:05:36", "text": "わかった。まあ、誰かがそれに気づいてくれてよかった。"}, {"type": "subtitle", "time": 18341.67, "timestamp": "05:05:41", "text": "外。私は私を愛してます。蛾。私はそうすべきだった"}]
[{"type": "subtitle", "time": 14041.269, "timestamp": "03:54:01", "text": "ええ、それは私にとって役に立つと思ったのですが"}, {"type": "subtitle", "time": 14043.11, "timestamp": "03:54:03", "text": "フォートナイトでできるのと同じように"}, {"type": "subtitle", "time": 14045.189, "timestamp": "03:54:05", "text": "オーディオビジュアライザーをオンにすると、"}, {"type": "subtitle", "time": 14047.269, "timestamp": "03:54:07", "text": "物がどこにあるかを知るのに役立ちます"}, {"type": "subtitle", "time": 14051.15, "timestamp": "03:54:11", "text": "あるいは何でもいいけど、これは痛みを超えている"}, {"type": "subtitle", "time": 14055.429, "timestamp": "03:54:15", "text": "[音楽]"}, {"type": "subtitle", "time": 14060.28, "timestamp": "03:54:20", "text": "私には少しぼやけて見える。"}, {"type": "subtitle", "time": 14062.71, "timestamp": "03:54:22", "text": "[音楽]"}, {"type": "subtitle", "time": 14065.83, "timestamp": "03:54:25", "text": "おお。待って。"}, {"type": "subtitle", "time": 14068.309, "timestamp": "03:54:28", "text": "おお。"}, {"type": "subtitle", "time": 14070.87, "timestamp": "03:54:30", "text": "そのポートキーは私たちをどこまで連れて行ってくれたのだろうか？"}, {"type": "subtitle", "time": 14072.63, "timestamp": "03:54:32", "text": "ロンドンから馬車よりも遠い"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "旅行した。"}, {"type": "subtitle", "time": 14075.91, "timestamp": "03:54:35", "text": "私たちはスコットランドのどこかにいます"}, {"type": "subtitle", "time": 14078.87, "timestamp": "03:54:38", "text": "高地。閣下、あの遺跡は。あなたは"}, {"type": "subtitle", "time": 14080.55, "timestamp": "03:54:40", "text": "ポートキーは私たちを導くためのものだったと思う"}, {"type": "subtitle", "time": 14083.83, "timestamp": "03:54:43", "text": "そこには？私はします。今日は"}, {"type": "subtitle", "time": 14087.03, "timestamp": "03:54:47", "text": "私たち二人とも予想していなかった。しかしミリアムは"}, {"type": "subtitle", "time": 14090.15, "timestamp": "03:54:50", "text": "あのポートキーがジョージにとって重要なのには理由がある。"}, {"type": "subtitle", "time": 14093.59, "timestamp": "03:54:53", "text": "そして私は、彼女とジョージが"}, {"type": "subtitle", "time": 14096.07, "timestamp": "03:54:56", "text": "それが何を意味するにせよ、それを追求して死んだ"}, {"type": "subtitle", "time": 14099.189, "timestamp": "03:54:59", "text": "につながる。あなたが全員"}]
[{"type": "subtitle", "time": 842.389, "timestamp": "00:14:02", "text": "簡単な方法があるのに、わざわざ難しい方法を選ぶなんて。"}, {"type": "subtitle", "time": 853.91, "timestamp": "00:14:13", "text": "シンガーは低速走行に適している。うん。何"}, {"type": "subtitle", "time": 857.269, "timestamp": "00:14:17", "text": "もう片方は？スティンガーって何？"}, {"type": "subtitle", "time": 872.87, "timestamp": "00:14:32", "text": "もう一度、その事前制御方法を説明します。"}, {"type": "subtitle", "time": 874.87, "timestamp": "00:14:34", "text": "うん、彼がどう使うか緊張するよ"}, {"type": "subtitle", "time": 877.269, "timestamp": "00:14:37", "text": "破壊行為。"}, {"type": "subtitle", "time": 880.15, "timestamp": "00:14:40", "text": "私は本当にスティンガーを買いたいのですが"}, {"type": "subtitle", "time": 884.87, "timestamp": "00:14:44", "text": "RGXスキンのような"}, {"type": "subtitle", "time": 889.03, "timestamp": "00:14:49", "text": "破壊行為者の感覚を味わうために。"}]
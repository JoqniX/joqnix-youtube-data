[{"type": "subtitle", "time": 17580.788, "timestamp": "04:53:00", "text": "走る"}, {"type": "subtitle", "time": 17585.59, "timestamp": "04:53:05", "text": "そして中央ホールへの移動手段を手配します。"}, {"type": "subtitle", "time": 17587.43, "timestamp": "04:53:07", "text": "おお、"}, {"type": "subtitle", "time": 17604.55, "timestamp": "04:53:24", "text": "そして、私たちはここにいる。かなりの時間短縮になる。"}, {"type": "subtitle", "time": 17606.868, "timestamp": "04:53:26", "text": "この階段はセントラルに直結しています"}, {"type": "subtitle", "time": 17613.43, "timestamp": "04:53:33", "text": "通り過ぎればほぼどこへでも行ける"}, {"type": "subtitle", "time": 17623.03, "timestamp": "04:53:43", "text": "[音楽]"}, {"type": "subtitle", "time": 17624.628, "timestamp": "04:53:44", "text": "復讐。いつも何かが起こっている"}, {"type": "subtitle", "time": 17627.43, "timestamp": "04:53:47", "text": "ここ。それは巣の心臓部だ。私たちの"}, {"type": "subtitle", "time": 17635.03, "timestamp": "04:53:55", "text": "これは一体何だ？以上です"}, {"type": "subtitle", "time": 17637.67, "timestamp": "04:53:57", "text": "今のところ。出席が求められます"}]
[{"type": "subtitle", "time": 15726.149, "timestamp": "04:22:06", "text": "ああ、この建物を建てたのはこの人だ"}, {"type": "subtitle", "time": 15729.42, "timestamp": "04:22:09", "text": "場所。わかった。"}, {"type": "subtitle", "time": 15731.51, "timestamp": "04:22:11", "text": "[音楽]"}, {"type": "subtitle", "time": 15734.07, "timestamp": "04:22:14", "text": "壁は設置済みです。ポートキーは"}, {"type": "subtitle", "time": 15737.429, "timestamp": "04:22:17", "text": "隠れた。もしかしたら、良すぎたのかもしれない。疑問に思う"}, {"type": "subtitle", "time": 15740.55, "timestamp": "04:22:20", "text": "私たちが作った道は不可能かもしれない"}, {"type": "subtitle", "time": 15743.189, "timestamp": "04:22:23", "text": "後ほど。それは不可能なことだろう"}, {"type": "subtitle", "time": 15745.189, "timestamp": "04:22:25", "text": "古代の痕跡が見えない人にとって"}, {"type": "subtitle", "time": 15748.229, "timestamp": "04:22:28", "text": "できる限り魔法を使います。何が見えるか"}, {"type": "subtitle", "time": 15750.149, "timestamp": "04:22:30", "text": "他の人ができないというだけでは不十分だ。"}, {"type": "subtitle", "time": 15751.75, "timestamp": "04:22:31", "text": "パーコル、"}, {"type": "subtitle", "time": 15753.83, "timestamp": "04:22:33", "text": "私たちは、"}, {"type": "subtitle", "time": 15756.389, "timestamp": "04:22:36", "text": "強力な秘密が詰まったこの道"}, {"type": "subtitle", "time": 15758.87, "timestamp": "04:22:38", "text": "知識は他人が何でもするだろう"}, {"type": "subtitle", "time": 15761.83, "timestamp": "04:22:41", "text": "得る。はい。そして、もし我々の主張が正しければ、"}, {"type": "subtitle", "time": 15764.07, "timestamp": "04:22:44", "text": "チャールズ、魔女か魔法使い"}, {"type": "subtitle", "time": 15765.67, "timestamp": "04:22:45", "text": "試験を完了すると証明される"}, {"type": "subtitle", "time": 15768.389, "timestamp": "04:22:48", "text": "彼ら自身はその知識にふさわしく、"}, {"type": "subtitle", "time": 15772.71, "timestamp": "04:22:52", "text": "それに伴う責任。"}]
[{"type": "subtitle", "time": 12126.55, "timestamp": "03:22:06", "text": "肖像画。わかった。はい、どうぞ。保つ"}, {"type": "subtitle", "time": 12129.67, "timestamp": "03:22:09", "text": "変更。だから私がすることは"}, {"type": "subtitle", "time": 12131.51, "timestamp": "03:22:11", "text": "保つ"}, {"type": "subtitle", "time": 12150.55, "timestamp": "03:22:30", "text": "少しお待ちください。"}, {"type": "subtitle", "time": 12154.87, "timestamp": "03:22:34", "text": "えっと。なんてこった。どうすればいいですか？"}, {"type": "subtitle", "time": 12157.429, "timestamp": "03:22:37", "text": "H. これについてどうすればいいでしょうか？待って、"}, {"type": "subtitle", "time": 12160.15, "timestamp": "03:22:40", "text": "私の声は聞こえますよね？私はオーディオオーディオです、"}, {"type": "subtitle", "time": 12162.15, "timestamp": "03:22:42", "text": "右？"}, {"type": "subtitle", "time": 12171.83, "timestamp": "03:22:51", "text": "自分の流れを聞かせてください。"}, {"type": "subtitle", "time": 12173.59, "timestamp": "03:22:53", "text": "あ、待って。文字通りすべての"}, {"type": "subtitle", "time": 12175.59, "timestamp": "03:22:55", "text": "私が言っているのはただ一つ。私も"}]
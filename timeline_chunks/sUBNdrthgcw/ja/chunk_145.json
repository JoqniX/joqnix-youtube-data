[{"type": "subtitle", "time": 8701.349, "timestamp": "02:25:01", "text": "Playストアでは1GBちょっとだと思う"}, {"type": "subtitle", "time": 8703.11, "timestamp": "02:25:03", "text": "そして2つくらいダウンロードする必要がある"}, {"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "何か"}, {"type": "subtitle", "time": 8707.91, "timestamp": "02:25:07", "text": "モバイルでフルゲームを入手するには"}, {"type": "subtitle", "time": 8710.309, "timestamp": "02:25:10", "text": "推測。そう、アカウントを作って、"}, {"type": "subtitle", "time": 8712.15, "timestamp": "02:25:12", "text": "ゲームにログインしてキャラクターを作成する"}, {"type": "subtitle", "time": 8715.83, "timestamp": "02:25:15", "text": "ゲームで、PCでプレイしたい場合は、"}, {"type": "subtitle", "time": 8718.71, "timestamp": "02:25:18", "text": "ダウンロードする必要があります。"}, {"type": "subtitle", "time": 8722.71, "timestamp": "02:25:22", "text": "4GBくらいで、リンクを貼ってください"}, {"type": "subtitle", "time": 8724.469, "timestamp": "02:25:24", "text": "アカウント。アカウントにログインしてください。"}, {"type": "subtitle", "time": 8726.71, "timestamp": "02:25:26", "text": "それが私のやらざるを得なかったことだった。多すぎる"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "プロセス 誰かのような"}, {"type": "subtitle", "time": 8733.75, "timestamp": "02:25:33", "text": "ログインしてただプレイしたいだけ"}, {"type": "subtitle", "time": 8736.389, "timestamp": "02:25:36", "text": "しかし痛み"}, {"type": "subtitle", "time": 8738.309, "timestamp": "02:25:38", "text": "PC版をインストールしようとしています。おお、"}, {"type": "subtitle", "time": 8741.19, "timestamp": "02:25:41", "text": "待って。もしそうなら、ですよね？だから私は"}, {"type": "subtitle", "time": 8744.63, "timestamp": "02:25:44", "text": "あなたには、"}, {"type": "subtitle", "time": 8748.07, "timestamp": "02:25:48", "text": "エミュレーターを使用してダウンロードします"}, {"type": "subtitle", "time": 8750.309, "timestamp": "02:25:50", "text": "ゲームの電話版では、"}, {"type": "subtitle", "time": 8753.83, "timestamp": "02:25:53", "text": "エミュレーター経由でアカウントを作成"}, {"type": "subtitle", "time": 8756.55, "timestamp": "02:25:56", "text": "PC版に戻る"}]
[{"type": "subtitle", "time": 13862.55, "timestamp": "03:51:02", "text": "おそらくランロック出身だろう。開けられません"}, {"type": "subtitle", "time": 13865.189, "timestamp": "03:51:05", "text": "それ。この魔法が何であれ、"}, {"type": "subtitle", "time": 13868.15, "timestamp": "03:51:08", "text": "確かに強力だ。ゴブリンのように見える"}, {"type": "subtitle", "time": 13872.79, "timestamp": "03:51:12", "text": "金属。あのシンボル、あの光は何？"}, {"type": "subtitle", "time": 13875.59, "timestamp": "03:51:15", "text": "光は見えません。"}, {"type": "subtitle", "time": 13890.469, "timestamp": "03:51:30", "text": "マーリンの髭。マーリンの髭はどのようにして生えたのですか？"}, {"type": "subtitle", "time": 13893.59, "timestamp": "03:51:33", "text": "私たちはそうしました。"}, {"type": "subtitle", "time": 13896.15, "timestamp": "03:51:36", "text": "え、何？"}, {"type": "subtitle", "time": 13898.87, "timestamp": "03:51:38", "text": "彼は亡くなった。ああ、なんてことだ。"}, {"type": "subtitle", "time": 13906.63, "timestamp": "03:51:46", "text": "だめだ。だめだ。彼を殺さないで。"}]
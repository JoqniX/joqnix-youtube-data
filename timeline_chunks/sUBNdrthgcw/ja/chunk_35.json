[{"type": "subtitle", "time": 2113.34, "timestamp": "00:35:13", "text": "ああ、私たちは死にかけている。"}, {"type": "subtitle", "time": 2125.99, "timestamp": "00:35:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2134.069, "timestamp": "00:35:34", "text": "最後のキル。"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "それは本当にひどい出来事だった。"}, {"type": "subtitle", "time": 2141.349, "timestamp": "00:35:41", "text": "でも大丈夫。終わりました"}, {"type": "subtitle", "time": 2143.43, "timestamp": "00:35:43", "text": "自分。"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "でも大丈夫だよ。ついに終わった"}, {"type": "subtitle", "time": 2147.43, "timestamp": "00:35:47", "text": "けれど。"}, {"type": "subtitle", "time": 2150.63, "timestamp": "00:35:50", "text": "俺たちは最善を尽くしたよ。"}, {"type": "subtitle", "time": 2158.55, "timestamp": "00:35:58", "text": "何てことだ。"}]
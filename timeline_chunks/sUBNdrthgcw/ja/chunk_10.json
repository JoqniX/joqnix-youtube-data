[{"type": "subtitle", "time": 601.19, "timestamp": "00:10:01", "text": "私のミスです。私のミスです。私のミスです。"}, {"type": "subtitle", "time": 603.67, "timestamp": "00:10:03", "text": "ブレンド。よし、こっちの方がいい。"}, {"type": "subtitle", "time": 607.19, "timestamp": "00:10:07", "text": "よし、これでいい。画面。それでいい。"}, {"type": "subtitle", "time": 611.91, "timestamp": "00:10:11", "text": "それは広告に掲載されていた。だから、ああ。ああ、忘れてた。私"}, {"type": "subtitle", "time": 613.91, "timestamp": "00:10:13", "text": "私はひどく落ち込んでいた。よし、これで"}, {"type": "subtitle", "time": 615.829, "timestamp": "00:10:15", "text": "もっと明るい傘。これで、"}, {"type": "subtitle", "time": 618.55, "timestamp": "00:10:18", "text": "明らかに装飾品ですよね？"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "ああ、もっと早くそうしておくべきだった。おお、"}, {"type": "subtitle", "time": 632.23, "timestamp": "00:10:32", "text": "今度はフォートナイトと8を変えなければならない"}, {"type": "subtitle", "time": 644.31, "timestamp": "00:10:44", "text": "主よ、私をお助けください。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "わかりました、私はこれをしたくないので"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "何かを確認する。"}, {"type": "subtitle", "time": 652.87, "timestamp": "00:10:52", "text": "マイクが動作していないようです。"}, {"type": "subtitle", "time": 654.47, "timestamp": "00:10:54", "text": "これ。"}, {"type": "subtitle", "time": 656.79, "timestamp": "00:10:56", "text": "ええ、信号は表示されますが、"}, {"type": "subtitle", "time": 659.829, "timestamp": "00:10:59", "text": "働く。そう、新しい声で"}]
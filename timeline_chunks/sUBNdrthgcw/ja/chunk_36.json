[{"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "今、それが教えてくれた。そして今、私は思う"}, {"type": "subtitle", "time": 2172.71, "timestamp": "00:36:12", "text": "Valerantの配信をたくさん行うべき"}, {"type": "subtitle", "time": 2177.19, "timestamp": "00:36:17", "text": "すべてに慣れるために、自分の時間を取り戻す。"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "私が切り替えた日から"}, {"type": "subtitle", "time": 2185.51, "timestamp": "00:36:25", "text": "切り替えた日から、"}, {"type": "subtitle", "time": 2188.63, "timestamp": "00:36:28", "text": "苦痛だった。"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "でもね、知ってる？大丈夫です。"}, {"type": "subtitle", "time": 2196.63, "timestamp": "00:36:36", "text": "オーケーといえば。えーと、あの、"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "待って。なぜまた動かなくなったのか？"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "もっと良い方法を見つけなければならない。"}]
[{"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "どこに行きたいか聞くべきだった"}, {"type": "subtitle", "time": 8230.87, "timestamp": "02:17:10", "text": "あ、待って"}, {"type": "subtitle", "time": 8233.349, "timestamp": "02:17:13", "text": "どのポジションが"}, {"type": "subtitle", "time": 8237.589, "timestamp": "02:17:17", "text": "あなたは人々を望んでいますか？ああ、忘れてた。"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "どうして忘れてしまったんだろう？"}, {"type": "subtitle", "time": 8248.309, "timestamp": "02:17:28", "text": "待って。"}, {"type": "subtitle", "time": 8250.469, "timestamp": "02:17:30", "text": "では、私はどうでしょうか？私は自分自身を"}, {"type": "subtitle", "time": 8252.87, "timestamp": "02:17:32", "text": "の上。いいえ、私はこちら側にいます。だから、"}, {"type": "subtitle", "time": 8260.07, "timestamp": "02:17:40", "text": "えっと、待って、この注文はどうなるの？"}, {"type": "subtitle", "time": 8262.95, "timestamp": "02:17:42", "text": "選択しましたか？待って、あのね？私はしなければならない"}, {"type": "subtitle", "time": 8265.349, "timestamp": "02:17:45", "text": "順番通りに実行してください"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "参加者。では、そのようにやってみよう"}, {"type": "subtitle", "time": 8270.87, "timestamp": "02:17:50", "text": "それから。それでよろしいでしょうか。"}, {"type": "subtitle", "time": 8273.83, "timestamp": "02:17:53", "text": "それでよろしいでしょうか？"}, {"type": "subtitle", "time": 8275.99, "timestamp": "02:17:55", "text": "順番通りにやっていきましょう"}]
[{"type": "subtitle", "time": 16923.43, "timestamp": "04:42:03", "text": "サマンサさん、お会いできて嬉しかったです。良い"}, {"type": "subtitle", "time": 16925.75, "timestamp": "04:42:05", "text": "あなたの運命に幸運を。ありがとう。そして"}, {"type": "subtitle", "time": 16927.51, "timestamp": "04:42:07", "text": "あなたにも幸運を祈ります。"}, {"type": "subtitle", "time": 16929.83, "timestamp": "04:42:09", "text": "日。"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "あ、こんにちは。新しいレイブンクロー生。教授"}, {"type": "subtitle", "time": 16934.868, "timestamp": "04:42:14", "text": "ウィーズリーがすぐ外であなたを探しています。"}, {"type": "subtitle", "time": 16936.55, "timestamp": "04:42:16", "text": "彼は彼女を手放した方が良いだろう。ああ、ただ"}, {"type": "subtitle", "time": 16939.19, "timestamp": "04:42:19", "text": "外。わかった。"}, {"type": "subtitle", "time": 16944.788, "timestamp": "04:42:24", "text": "[音楽]"}, {"type": "subtitle", "time": 16947.91, "timestamp": "04:42:27", "text": "一般。談話室の外。わかった。"}, {"type": "subtitle", "time": 16949.83, "timestamp": "04:42:29", "text": "おはよう。準備はできていると思います"}, {"type": "subtitle", "time": 16951.75, "timestamp": "04:42:31", "text": "ホグワーツでの初日。私は"}, {"type": "subtitle", "time": 16953.67, "timestamp": "04:42:33", "text": "この日をずっと夢見てきた。"}, {"type": "subtitle", "time": 16955.83, "timestamp": "04:42:35", "text": "自分がここにいるなんて信じられない。ええ、あなたは"}, {"type": "subtitle", "time": 16958.55, "timestamp": "04:42:38", "text": "ここ。最大限に活用しよう。あなたには"}, {"type": "subtitle", "time": 16961.67, "timestamp": "04:42:41", "text": "ホグワーツでの初日。今、光の中で"}, {"type": "subtitle", "time": 16964.708, "timestamp": "04:42:44", "text": "独自の状況で当社に入社"}, {"type": "subtitle", "time": 16966.788, "timestamp": "04:42:46", "text": "5年目には、追いつく必要がある"}, {"type": "subtitle", "time": 16969.75, "timestamp": "04:42:49", "text": "クラスメートに遅れをとらないように、"}, {"type": "subtitle", "time": 16971.91, "timestamp": "04:42:51", "text": "特に、"}, {"type": "subtitle", "time": 16974.47, "timestamp": "04:42:54", "text": "最後にフクロウを完成させてください"}]
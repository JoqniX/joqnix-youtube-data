[{"type": "subtitle", "time": 18901.51, "timestamp": "05:15:01", "text": "教科書の517ページを開いてください。"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "始める前に、ここにいる誰か教えてくれますか"}, {"type": "subtitle", "time": 18907.11, "timestamp": "05:15:07", "text": "呪文の違い"}, {"type": "subtitle", "time": 18911.59, "timestamp": "05:15:11", "text": "色の変化や成長のお守りについてですか？"}, {"type": "subtitle", "time": 18923.43, "timestamp": "05:15:23", "text": "残念ながら、今から勉強するには遅すぎると思います。"}, {"type": "subtitle", "time": 18925.83, "timestamp": "05:15:25", "text": "私の説教は数ヶ月間、"}, {"type": "subtitle", "time": 18928.628, "timestamp": "05:15:28", "text": "皆さん。見たところ、皆さん"}, {"type": "subtitle", "time": 18931.03, "timestamp": "05:15:31", "text": "休暇中は忘却の練習をしていた"}, {"type": "subtitle", "time": 18933.91, "timestamp": "05:15:33", "text": "互いに。"}, {"type": "subtitle", "time": 18936.788, "timestamp": "05:15:36", "text": "主よ、感謝いたします。覚えてる？"}, {"type": "subtitle", "time": 18946.788, "timestamp": "05:15:46", "text": "どうやら私たちは切実に必要としているようです"}, {"type": "subtitle", "time": 18949.75, "timestamp": "05:15:49", "text": "レビューの。みんなペアになって"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "反対側に陣取る"}, {"type": "subtitle", "time": 18953.19, "timestamp": "05:15:53", "text": "教室。"}, {"type": "subtitle", "time": 18955.59, "timestamp": "05:15:55", "text": "それでは、これらの教科書を"}, {"type": "subtitle", "time": 18957.59, "timestamp": "05:15:57", "text": "鈍器は、"}]
[{"type": "subtitle", "time": 14222.71, "timestamp": "03:57:02", "text": "わからない。なんてこった。これは何ですか？は"}, {"type": "subtitle", "time": 14226.79, "timestamp": "03:57:06", "text": "あの氷？ここは十分に寒くない。それ"}, {"type": "subtitle", "time": 14229.75, "timestamp": "03:57:09", "text": "まるで魔法のようだ。"}, {"type": "subtitle", "time": 14232.79, "timestamp": "03:57:12", "text": "誰かがこの道を塞ごうとしたのだ。さあ"}, {"type": "subtitle", "time": 14234.71, "timestamp": "03:57:14", "text": "あなたが"}, {"type": "subtitle", "time": 14236.229, "timestamp": "03:57:16", "text": "練習中。"}, {"type": "subtitle", "time": 14239.429, "timestamp": "03:57:19", "text": "中心に焦点を当てる。"}, {"type": "subtitle", "time": 14243.15, "timestamp": "03:57:23", "text": "タップしてブラスターの基本キャストをしてください。"}, {"type": "subtitle", "time": 14254.87, "timestamp": "03:57:34", "text": "カメラを使用してアクティブな"}, {"type": "subtitle", "time": 14267.349, "timestamp": "03:57:47", "text": "これは楽しい。"}, {"type": "subtitle", "time": 14274.95, "timestamp": "03:57:54", "text": "おお。思っていたより少し大変だった"}, {"type": "subtitle", "time": 14276.87, "timestamp": "03:57:56", "text": "期待される。"}]
[{"type": "subtitle", "time": 18000.23, "timestamp": "05:00:00", "text": "何時間も配信。"}, {"type": "subtitle", "time": 18001.99, "timestamp": "05:00:01", "text": "私があなたの話を聞いたのですが"}, {"type": "subtitle", "time": 18004.47, "timestamp": "05:00:04", "text": "ネズミを探検する？言い過ぎてないことを願います"}, {"type": "subtitle", "time": 18006.39, "timestamp": "05:00:06", "text": "多くの。不意を突かれたよ。私はしませんでした"}, {"type": "subtitle", "time": 18008.07, "timestamp": "05:00:08", "text": "私たちの旅行について他に何か彼女に話してください"}, {"type": "subtitle", "time": 18010.948, "timestamp": "05:00:10", "text": "ここ。私は眠ってしまったと答えます。こんにちは。良い"}, {"type": "subtitle", "time": 18013.67, "timestamp": "05:00:13", "text": "夜。"}, {"type": "subtitle", "time": 18015.43, "timestamp": "05:00:15", "text": "はい。さて、ウィーズリー教授は"}, {"type": "subtitle", "time": 18018.15, "timestamp": "05:00:18", "text": "聡明で洞察力に優れた魔女。それは正しかった"}, {"type": "subtitle", "time": 18020.708, "timestamp": "05:00:20", "text": "彼女は今のところ、詳細を明かさないつもりだ。"}, {"type": "subtitle", "time": 18022.55, "timestamp": "05:00:22", "text": "この道がどこへ向かうのかはわかりません"}, {"type": "subtitle", "time": 18025.75, "timestamp": "05:00:25", "text": "着手した事業は、先導するだろう。必要になるかもしれない"}, {"type": "subtitle", "time": 18028.868, "timestamp": "05:00:28", "text": "時間にもう少し柔軟性を持たせる"}, {"type": "subtitle", "time": 18031.43, "timestamp": "05:00:31", "text": "彼女が賛成するよりも。そして彼女は"}, {"type": "subtitle", "time": 18033.35, "timestamp": "05:00:33", "text": "詳細を共有する義務を感じる"}, {"type": "subtitle", "time": 18035.99, "timestamp": "05:00:35", "text": "校長先生、それはそのままにしておく方が良いでしょう"}, {"type": "subtitle", "time": 18039.35, "timestamp": "05:00:39", "text": "私たち二人の間だけの話です。承知いたしました、教授。良い。"}, {"type": "subtitle", "time": 18042.47, "timestamp": "05:00:42", "text": "さて、あなたはとても有能ですが、"}, {"type": "subtitle", "time": 18045.11, "timestamp": "05:00:45", "text": "あなたが持つ能力はあなたに義務を課します"}, {"type": "subtitle", "time": 18048.15, "timestamp": "05:00:48", "text": "十分に訓練されている。幸いなことに、"}, {"type": "subtitle", "time": 18050.07, "timestamp": "05:00:50", "text": "非常に優秀なチームの恩恵"}, {"type": "subtitle", "time": 18052.708, "timestamp": "05:00:52", "text": "あなたを導く魔女や魔法使いたち。しかし"}, {"type": "subtitle", "time": 18055.83, "timestamp": "05:00:55", "text": "ガイドの話をしていると、"}, {"type": "subtitle", "time": 18058.55, "timestamp": "05:00:58", "text": "からまたしても露骨な非難を避ける"}]
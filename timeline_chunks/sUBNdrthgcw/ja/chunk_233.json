[{"type": "subtitle", "time": 13983.189, "timestamp": "03:53:03", "text": "彼の音声をオフにする？彼が"}, {"type": "subtitle", "time": 13985.51, "timestamp": "03:53:05", "text": "一体何があの忌々しいものの中に入ったんだ？"}, {"type": "subtitle", "time": 13988.87, "timestamp": "03:53:08", "text": "空中で馬車を攻撃する。"}, {"type": "subtitle", "time": 13993.75, "timestamp": "03:53:13", "text": "普通のドラゴンなら絶対にそんなことはしない。教授。"}, {"type": "subtitle", "time": 13995.349, "timestamp": "03:53:15", "text": "お客様、"}, {"type": "subtitle", "time": 13998.95, "timestamp": "03:53:18", "text": "ここはどこ？よくわからない。見てください、しかし"}, {"type": "subtitle", "time": 14000.71, "timestamp": "03:53:20", "text": "発見された鍵は明らかにポートだった"}, {"type": "subtitle", "time": 14003.91, "timestamp": "03:53:23", "text": "鍵。ポートキー？魔法がかけられたアイテム"}, {"type": "subtitle", "time": 14005.59, "timestamp": "03:53:25", "text": "それに触れた者を特定の場所へ連れて行く"}, {"type": "subtitle", "time": 14009.349, "timestamp": "03:53:29", "text": "場所。はぁ？"}, {"type": "subtitle", "time": 14010.71, "timestamp": "03:53:30", "text": "待って、この音声をオフにするべきだ"}, {"type": "subtitle", "time": 14012.63, "timestamp": "03:53:32", "text": "視覚化する。気分が良くなりました、先生。もし"}, {"type": "subtitle", "time": 14015.59, "timestamp": "03:53:35", "text": "少し辺りを見て回りたいのですね。"}, {"type": "subtitle", "time": 14020.15, "timestamp": "03:53:40", "text": "そうしたいけど、近くにいてほしい。これはこれです"}, {"type": "subtitle", "time": 14024.229, "timestamp": "03:53:44", "text": "これは歴史的なものです。しかし、なぜ？なぜ彼らは"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "[音楽]"}, {"type": "subtitle", "time": 14039.189, "timestamp": "03:53:59", "text": "アイコンキー。"}]
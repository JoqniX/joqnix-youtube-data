[{"type": "subtitle", "time": 3543.99, "timestamp": "00:59:03", "text": "痛み。だから私はbeamを使おうと考えている"}, {"type": "subtitle", "time": 3548.069, "timestamp": "00:59:08", "text": "だって、私の持ち物は全部めちゃくちゃなんだもん。"}, {"type": "subtitle", "time": 3549.829, "timestamp": "00:59:09", "text": "あ、待って。"}, {"type": "subtitle", "time": 3552.15, "timestamp": "00:59:12", "text": "なんてこった。こういうことです。どうすればいいですか？"}, {"type": "subtitle", "time": 3553.829, "timestamp": "00:59:13", "text": "また？"}, {"type": "subtitle", "time": 3555.91, "timestamp": "00:59:15", "text": "何てことだ。"}, {"type": "subtitle", "time": 3564.789, "timestamp": "00:59:24", "text": "待って。私はテレポート能力を持っていません。何"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "えっ？"}, {"type": "subtitle", "time": 3569.43, "timestamp": "00:59:29", "text": "テレポートをインストールしたことがないのですが、必要でしょうか？"}, {"type": "subtitle", "time": 3571.829, "timestamp": "00:59:31", "text": "何？"}, {"type": "subtitle", "time": 3575.27, "timestamp": "00:59:35", "text": "なんてこった。えっと、私は開けるべきだと思う"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "これ"}, {"type": "subtitle", "time": 3585.19, "timestamp": "00:59:45", "text": "ああ、わかりました。だからそれを"}, {"type": "subtitle", "time": 3587.67, "timestamp": "00:59:47", "text": "データは必要ありません。あなたはそれを置いた"}, {"type": "subtitle", "time": 3589.67, "timestamp": "00:59:49", "text": "64番。"}, {"type": "subtitle", "time": 3593.03, "timestamp": "00:59:53", "text": "「ああ、もう持っていたよ」と言ってみましょう。バカ、"}, {"type": "subtitle", "time": 3595.829, "timestamp": "00:59:55", "text": "あなたはきちんと確認していませんでした。こんにちは、私たちは"}, {"type": "subtitle", "time": 3598.23, "timestamp": "00:59:58", "text": "そこまで更新しました。"}]
[{"type": "subtitle", "time": 4080.23, "timestamp": "01:08:00", "text": "私も眠りたい。あ、待って、待って、"}, {"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "待って。えっと、寝てる人のために、ヤン"}, {"type": "subtitle", "time": 4084.15, "timestamp": "01:08:04", "text": "それでね、わかる？私はレノスに違いない。"}, {"type": "subtitle", "time": 4086.23, "timestamp": "01:08:06", "text": "えっと、あなたは、あなたは"}, {"type": "subtitle", "time": 4090.069, "timestamp": "01:08:10", "text": "起きていろ。おお。えっと。ああ、神様。やめて、やめて"}, {"type": "subtitle", "time": 4092.789, "timestamp": "01:08:12", "text": "起きていろ。時刻は11時30分です。"}, {"type": "subtitle", "time": 4094.789, "timestamp": "01:08:14", "text": "おお。待って、待って、待って、待って、待って。その"}, {"type": "subtitle", "time": 4098.47, "timestamp": "01:08:18", "text": "これをスピードランするつもりだ"}, {"type": "subtitle", "time": 4116.229, "timestamp": "01:08:36", "text": "これでいいと思います。わからない。する"}, {"type": "subtitle", "time": 4126.47, "timestamp": "01:08:46", "text": "[音楽]"}, {"type": "subtitle", "time": 4129.829, "timestamp": "01:08:49", "text": "はい、これで終わりです。"}, {"type": "subtitle", "time": 4132.47, "timestamp": "01:08:52", "text": "2人ダウン。"}, {"type": "subtitle", "time": 4134.709, "timestamp": "01:08:54", "text": "えっと、何人くらいいたんですか？私"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "忘れた。数えきれなくなった。大丈夫。"}]
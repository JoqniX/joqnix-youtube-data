[{"type": "subtitle", "time": 19321.83, "timestamp": "05:22:01", "text": "いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 19326.39, "timestamp": "05:22:06", "text": "何てことだ。なんてこった。"}, {"type": "subtitle", "time": 19331.19, "timestamp": "05:22:11", "text": "ああ、なんてことだ。いや、そんなことはないよ。私 私 私"}, {"type": "subtitle", "time": 19333.83, "timestamp": "05:22:13", "text": "神に誓って、それを引っ張らないで"}, {"type": "subtitle", "time": 19336.82, "timestamp": "05:22:16", "text": "私の。ああ、なんてことだ"}, {"type": "subtitle", "time": 19338.39, "timestamp": "05:22:18", "text": "[音楽]"}, {"type": "subtitle", "time": 19348.23, "timestamp": "05:22:28", "text": "はい。彼女を引き倒せ。よくやった。"}, {"type": "subtitle", "time": 19370.07, "timestamp": "05:22:50", "text": "私は勝つって言ったでしょ。 A"}, {"type": "subtitle", "time": 19373.83, "timestamp": "05:22:53", "text": "満点。顕著。"}]
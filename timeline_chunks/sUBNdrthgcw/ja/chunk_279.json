[{"type": "subtitle", "time": 16742.709, "timestamp": "04:39:02", "text": "星座や夜空に話しかける"}, {"type": "subtitle", "time": 16744.551, "timestamp": "04:39:04", "text": "塔の上？私は星から来た。"}, {"type": "subtitle", "time": 16746.629, "timestamp": "04:39:06", "text": "あなたはどう思いますか？"}, {"type": "subtitle", "time": 16750.47, "timestamp": "04:39:10", "text": "信じられないほど興味があります"}, {"type": "subtitle", "time": 16760.23, "timestamp": "04:39:20", "text": "魅力的な。はい。天文学が"}, {"type": "subtitle", "time": 16762.709, "timestamp": "04:39:22", "text": "私のスケジュール。面白そうですね。それ"}, {"type": "subtitle", "time": 16764.709, "timestamp": "04:39:24", "text": "は。あなたに良い知らせがあります。あなたは"}, {"type": "subtitle", "time": 16767.109, "timestamp": "04:39:27", "text": "間違いなく天文学を専攻します。それは"}, {"type": "subtitle", "time": 16769.59, "timestamp": "04:39:29", "text": "5年生全員に必須。あなたはするであろう"}, {"type": "subtitle", "time": 16772.31, "timestamp": "04:39:32", "text": "その塔に魅了されるだろう。さらに、"}, {"type": "subtitle", "time": 16774.629, "timestamp": "04:39:34", "text": "高品質の望遠鏡は、"}, {"type": "subtitle", "time": 16777.35, "timestamp": "04:39:37", "text": "夢にも思わなかったようなこと。まあ、見てみようかな"}, {"type": "subtitle", "time": 16780.23, "timestamp": "04:39:40", "text": "その時は授業中に。はい。ああ、そして話す"}, {"type": "subtitle", "time": 16782.31, "timestamp": "04:39:42", "text": "授業で、まずは最初のものを手に入れよう"}, {"type": "subtitle", "time": 16783.99, "timestamp": "04:39:43", "text": "年。新鮮な香りは格別だ"}, {"type": "subtitle", "time": 16787.51, "timestamp": "04:39:47", "text": "羊皮紙はありますか？また会おう。"}, {"type": "subtitle", "time": 16790.31, "timestamp": "04:39:50", "text": "こんにちは、またお会いしましょう。"}, {"type": "subtitle", "time": 16793.83, "timestamp": "04:39:53", "text": "サムに自己紹介をしてください。アマンダって誰？"}, {"type": "subtitle", "time": 16796.39, "timestamp": "04:39:56", "text": "大好きです。ああ、これは本当にすごい。"}, {"type": "subtitle", "time": 16798.47, "timestamp": "04:39:58", "text": "ほら、誰にでも所属するグループがあるんだよ。これは"}]
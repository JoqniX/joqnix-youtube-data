[{"type": "subtitle", "time": 9844.15, "timestamp": "02:44:04", "text": "ええ、それを隠して置くことができます"}, {"type": "subtitle", "time": 9848.07, "timestamp": "02:44:08", "text": "プレゼントとか色々。あらら。あるいは私はただ"}, {"type": "subtitle", "time": 9852.23, "timestamp": "02:44:12", "text": "もっと大きくして、ここに置いてください。"}, {"type": "subtitle", "time": 9854.55, "timestamp": "02:44:14", "text": "こっちの方がずっといいんじゃない？皆さんは見ることができます"}, {"type": "subtitle", "time": 9887.11, "timestamp": "02:44:47", "text": "こう言い換えることができます。"}, {"type": "subtitle", "time": 9889.51, "timestamp": "02:44:49", "text": "よし、こうやろう。わかった。こんにちは。えっと"}, {"type": "subtitle", "time": 9893.59, "timestamp": "02:44:53", "text": "えっと、OBSに送って、これで終わりにします。"}, {"type": "subtitle", "time": 9895.99, "timestamp": "02:44:55", "text": "写真を撮って降りて、"}]
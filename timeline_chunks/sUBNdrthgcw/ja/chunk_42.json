[{"type": "subtitle", "time": 2528.63, "timestamp": "00:42:08", "text": "待てよ、なんでこんな馬鹿げた行動をとっているんだ？えっと"}, {"type": "subtitle", "time": 2531.99, "timestamp": "00:42:11", "text": "デフォルトにして、なぜ"}, {"type": "subtitle", "time": 2534.63, "timestamp": "00:42:14", "text": "私はこの方法を使っています"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "ちょうど"}, {"type": "subtitle", "time": 2539.589, "timestamp": "00:42:19", "text": "この物の重さを知らせる"}, {"type": "subtitle", "time": 2548.069, "timestamp": "00:42:28", "text": "なぜ300×300のタイプが必要なのですか？"}, {"type": "subtitle", "time": 2550.39, "timestamp": "00:42:30", "text": "プラグを持っている"}, {"type": "subtitle", "time": 2553.349, "timestamp": "00:42:33", "text": "ああ、気にしないで、手動でやらなきゃ。"}, {"type": "subtitle", "time": 2560.71, "timestamp": "00:42:40", "text": "次は誰だ？"}, {"type": "subtitle", "time": 2579.67, "timestamp": "00:42:59", "text": "はい、結構です。"}]
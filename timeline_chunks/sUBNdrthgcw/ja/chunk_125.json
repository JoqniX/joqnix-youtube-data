[{"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "わかった。 NDIはどうなったのですか？"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "君は生きている。何？"}, {"type": "subtitle", "time": 7510.31, "timestamp": "02:05:10", "text": "どうしたの？"}, {"type": "subtitle", "time": 7514.229, "timestamp": "02:05:14", "text": "ああ、こんにちは。えっと、生きてますか？"}, {"type": "subtitle", "time": 7516.47, "timestamp": "02:05:16", "text": "待って、何が起こったの？ああ、私は"}, {"type": "subtitle", "time": 7519.189, "timestamp": "02:05:19", "text": "クリック。わかった。小道具を起動します。行く"}, {"type": "subtitle", "time": 7521.669, "timestamp": "02:05:21", "text": "特性。それなら、ただ手に入れればいい。出て行く"}, {"type": "subtitle", "time": 7523.669, "timestamp": "02:05:23", "text": "特性。リセットされます。更新。"}, {"type": "subtitle", "time": 7525.83, "timestamp": "02:05:25", "text": "ニース。"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "それは良い情報ですね。"}, {"type": "subtitle", "time": 7531.03, "timestamp": "02:05:31", "text": "問題は、私がアップデートしていないということです。"}, {"type": "subtitle", "time": 7534.31, "timestamp": "02:05:34", "text": "インドの最新バージョンは、"}, {"type": "subtitle", "time": 7537.43, "timestamp": "02:05:37", "text": "えーと、彼らは新しいものを持ち込んだ"}, {"type": "subtitle", "time": 7541.51, "timestamp": "02:05:41", "text": "低遅延のための機能"}, {"type": "subtitle", "time": 7543.35, "timestamp": "02:05:43", "text": "何か何か、そしてそれは"}, {"type": "subtitle", "time": 7545.03, "timestamp": "02:05:45", "text": "めちゃくちゃだ。だから、"}, {"type": "subtitle", "time": 7546.79, "timestamp": "02:05:46", "text": "透明性。"}, {"type": "subtitle", "time": 7550.79, "timestamp": "02:05:50", "text": "それは大変厄介な問題だ。"}, {"type": "subtitle", "time": 7552.629, "timestamp": "02:05:52", "text": "わかった。えっと、"}]
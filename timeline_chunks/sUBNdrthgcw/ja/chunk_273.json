[{"type": "subtitle", "time": 16381.59, "timestamp": "04:33:01", "text": "十分。私が禁止したわけではない"}, {"type": "subtitle", "time": 16386.551, "timestamp": "04:33:06", "text": "全員一緒に飛ぶ。でも、私を誘惑しないで。"}, {"type": "subtitle", "time": 16389.51, "timestamp": "04:33:09", "text": "あなたは学業に集中するためにここにいます"}, {"type": "subtitle", "time": 16391.99, "timestamp": "04:33:11", "text": "先物。きっとたくさん手に入るでしょう"}, {"type": "subtitle", "time": 16396.47, "timestamp": "04:33:16", "text": "明日授業が始まる前にやらなければならないこと。"}, {"type": "subtitle", "time": 16399.75, "timestamp": "04:33:19", "text": "私は、皆さんはきっとたくさんの"}, {"type": "subtitle", "time": 16410.551, "timestamp": "04:33:30", "text": "なぜ入り口が15 15なのか？素敵ですね"}, {"type": "subtitle", "time": 16413.429, "timestamp": "04:33:33", "text": "あなたにお会いできて嬉しいです。私はウィーズリー教授です。"}, {"type": "subtitle", "time": 16415.189, "timestamp": "04:33:35", "text": "新しい"}, {"type": "subtitle", "time": 16417.029, "timestamp": "04:33:37", "text": "学生たちは談話室へ？私がしなければならない"}, {"type": "subtitle", "time": 16420.551, "timestamp": "04:33:40", "text": "どうぞご対応ください。"}, {"type": "subtitle", "time": 16423.75, "timestamp": "04:33:43", "text": "動作が非常に重かったため。ウィーズリー教授。"}, {"type": "subtitle", "time": 16425.75, "timestamp": "04:33:45", "text": "お会いできてうれしいです。お会いできて嬉しいです"}, {"type": "subtitle", "time": 16428.07, "timestamp": "04:33:48", "text": "ええ、教授。副責任者として"}, {"type": "subtitle", "time": 16430.15, "timestamp": "04:33:50", "text": "奥様、これは私にとって大変光栄なことです"}, {"type": "subtitle", "time": 16433.109, "timestamp": "04:33:53", "text": "共用スペースへご案内します。まさにこれ"}]
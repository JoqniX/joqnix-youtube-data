[{"type": "subtitle", "time": 12240.229, "timestamp": "03:24:00", "text": "はい、どうぞ。聞こえますか、"}, {"type": "subtitle", "time": 12242.309, "timestamp": "03:24:02", "text": "右？こんにちは。うん。こんにちは、ヤシュさん。"}, {"type": "subtitle", "time": 12244.79, "timestamp": "03:24:04", "text": "お元気ですか？試験はどうでしたか？"}, {"type": "subtitle", "time": 12246.63, "timestamp": "03:24:06", "text": "試験頑張ってね、そして"}, {"type": "subtitle", "time": 12250.469, "timestamp": "03:24:10", "text": "勉強。ええと、Renderuです。うん。こんにちは。"}, {"type": "subtitle", "time": 12253.59, "timestamp": "03:24:13", "text": "お元気ですか？うん。"}, {"type": "subtitle", "time": 12256.309, "timestamp": "03:24:16", "text": "それで、えっと、皆さん、私に"}, {"type": "subtitle", "time": 12260.229, "timestamp": "03:24:20", "text": "音声の状態について確認させてください。"}, {"type": "subtitle", "time": 12262.71, "timestamp": "03:24:22", "text": "音声が大きすぎますか、それとも小さすぎますか？えっと"}, {"type": "subtitle", "time": 12264.87, "timestamp": "03:24:24", "text": "教えてください"}, {"type": "subtitle", "time": 12273.19, "timestamp": "03:24:33", "text": "良い。さようなら。こんにちは、ゲア。幸運を。良い"}, {"type": "subtitle", "time": 12274.79, "timestamp": "03:24:34", "text": "運。"}, {"type": "subtitle", "time": 12281.83, "timestamp": "03:24:41", "text": "こんにちは。とにかく、えーと、"}, {"type": "subtitle", "time": 12284.07, "timestamp": "03:24:44", "text": "ストリーム。少しうるさい。まあ、ちょっと"}, {"type": "subtitle", "time": 12287.53, "timestamp": "03:24:47", "text": "うるさい。わかりました。ガッチャ。"}, {"type": "subtitle", "time": 12289.83, "timestamp": "03:24:49", "text": "[音楽]"}, {"type": "subtitle", "time": 12292.309, "timestamp": "03:24:52", "text": "ああ、フィルターは追加していません。それが理由です"}, {"type": "subtitle", "time": 12294.63, "timestamp": "03:24:54", "text": "だからうるさいんです。私は普段"}, {"type": "subtitle", "time": 12299.67, "timestamp": "03:24:59", "text": "音声はマイナス203デシベル"}]
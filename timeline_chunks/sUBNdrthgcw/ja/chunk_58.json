[{"type": "subtitle", "time": 3482.23, "timestamp": "00:58:02", "text": "保存されません。つまり、ある種の痛みだ。"}, {"type": "subtitle", "time": 3486.39, "timestamp": "00:58:06", "text": "それでは、最初のものをインストールしてみましょう。どこ"}, {"type": "subtitle", "time": 3490.23, "timestamp": "00:58:10", "text": "最初のものはどれですか？先進的なマスク。コピー。"}, {"type": "subtitle", "time": 3496.15, "timestamp": "00:58:16", "text": "2つ目。"}, {"type": "subtitle", "time": 3500.069, "timestamp": "00:58:20", "text": "えっと、2つ目です。次は誰だ？"}, {"type": "subtitle", "time": 3503.349, "timestamp": "00:58:23", "text": "下流の起亜自動車にアップデートがありました。えっと、"}, {"type": "subtitle", "time": 3506.71, "timestamp": "00:58:26", "text": "交換してください。"}, {"type": "subtitle", "time": 3509.67, "timestamp": "00:58:29", "text": "次はこれ。次は誰だ？オーディオモニターが"}, {"type": "subtitle", "time": 3512.15, "timestamp": "00:58:32", "text": "最新情報。うん、"}, {"type": "subtitle", "time": 3523.109, "timestamp": "00:58:43", "text": "ストリームアップ。これはプラグインです"}, {"type": "subtitle", "time": 3533.109, "timestamp": "00:58:53", "text": "OBSビームは送信できるものです"}, {"type": "subtitle", "time": 3535.349, "timestamp": "00:58:55", "text": "OBS のものをインターネットに公開するのと同じように"}, {"type": "subtitle", "time": 3539.67, "timestamp": "00:58:59", "text": "NDIとテレポート。えっと、NDI のやつは"}]
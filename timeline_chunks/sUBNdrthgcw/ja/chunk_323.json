[{"type": "subtitle", "time": 19381.27, "timestamp": "05:23:01", "text": "競争力に関しては"}, {"type": "subtitle", "time": 19383.99, "timestamp": "05:23:03", "text": "私は気にしない、私はどちらもとても良い"}, {"type": "subtitle", "time": 19386.868, "timestamp": "05:23:06", "text": "あなた、私は好きじゃない、私は好きじゃない"}, {"type": "subtitle", "time": 19413.59, "timestamp": "05:23:33", "text": "いい試合だったね。認めざるを得ないが、"}, {"type": "subtitle", "time": 19416.31, "timestamp": "05:23:36", "text": "君を過小評価していたと思う。"}, {"type": "subtitle", "time": 19418.868, "timestamp": "05:23:38", "text": "AIOを使いこなせるようになるまでには数週間かかる。"}, {"type": "subtitle", "time": 19421.27, "timestamp": "05:23:41", "text": "何かを正しく理解するのに何週間もかかった"}, {"type": "subtitle", "time": 19424.15, "timestamp": "05:23:44", "text": "私がここに転勤してきたとき。だんだん楽になるよ。"}, {"type": "subtitle", "time": 19428.868, "timestamp": "05:23:48", "text": "ご理解いただけて嬉しいです。それは良いことだ"}, {"type": "subtitle", "time": 19431.75, "timestamp": "05:23:51", "text": "聞く。一度にすべてを理解するのは大変だ。"}, {"type": "subtitle", "time": 19434.15, "timestamp": "05:23:54", "text": "控えめに言っても、"}, {"type": "subtitle", "time": 19436.07, "timestamp": "05:23:56", "text": "初めて"}, {"type": "subtitle", "time": 19438.628, "timestamp": "05:23:58", "text": "到着した。私はワガドゥーからここに転勤してきました"}]
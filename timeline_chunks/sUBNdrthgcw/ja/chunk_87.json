[{"type": "subtitle", "time": 5224.07, "timestamp": "01:27:04", "text": "アリサは7と言った。よし、7つ目だ。"}, {"type": "subtitle", "time": 5227.59, "timestamp": "01:27:07", "text": "うーん、ニャーって言ったよ、[ __ ]"}, {"type": "subtitle", "time": 5229.83, "timestamp": "01:27:09", "text": "6人が言った。うん。"}, {"type": "subtitle", "time": 5237.189, "timestamp": "01:27:17", "text": "もう一度チャットしましょう。招待する。"}, {"type": "subtitle", "time": 5240.55, "timestamp": "01:27:20", "text": "一つずつ説明していきます。残っているのは誰？えっと、"}, {"type": "subtitle", "time": 5243.99, "timestamp": "01:27:23", "text": "ロッコは何て言ったの？"}, {"type": "subtitle", "time": 5247.27, "timestamp": "01:27:27", "text": "えっと、私は紫が好きです。 14. オーケー、ロコは"}, {"type": "subtitle", "time": 5250.629, "timestamp": "01:27:30", "text": "14. えーと、14はもうやったよね？それは"}, {"type": "subtitle", "time": 5253.51, "timestamp": "01:27:33", "text": "ジャガンズ。"}, {"type": "subtitle", "time": 5255.43, "timestamp": "01:27:35", "text": "[音楽]"}, {"type": "subtitle", "time": 5276.229, "timestamp": "01:27:56", "text": "こんにちは。えっと、"}, {"type": "subtitle", "time": 5279.189, "timestamp": "01:27:59", "text": "他に誰かいますか？ママは何て言ったの？"}]
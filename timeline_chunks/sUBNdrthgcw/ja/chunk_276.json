[{"type": "subtitle", "time": 16569.189, "timestamp": "04:36:09", "text": "こんにちは、お母さん。今、私が"}, {"type": "subtitle", "time": 16572.109, "timestamp": "04:36:12", "text": "集中？はい、そうしました。"}, {"type": "subtitle", "time": 16582.629, "timestamp": "04:36:22", "text": "だから、これは正しい方法ではない。"}, {"type": "subtitle", "time": 16585.269, "timestamp": "04:36:25", "text": "他人の家に押し入ってもいいですか？"}, {"type": "subtitle", "time": 16587.029, "timestamp": "04:36:27", "text": "部屋？"}, {"type": "subtitle", "time": 16595.91, "timestamp": "04:36:35", "text": "[音楽]"}, {"type": "subtitle", "time": 16600.551, "timestamp": "04:36:40", "text": "これは面白そうだ。掃除。"}, {"type": "subtitle", "time": 16602.15, "timestamp": "04:36:42", "text": "紹介文は"}, {"type": "subtitle", "time": 16605.59, "timestamp": "04:36:45", "text": "注文。ああ、この方はどなたですか？"}, {"type": "subtitle", "time": 16615.91, "timestamp": "04:36:55", "text": "これは何ですか？誰かがチンポ爆弾を投げた。"}, {"type": "subtitle", "time": 16618.31, "timestamp": "04:36:58", "text": "ここから出よう。"}]
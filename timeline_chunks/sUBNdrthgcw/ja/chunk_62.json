[{"type": "subtitle", "time": 3720.95, "timestamp": "01:02:00", "text": "どうやって"}, {"type": "subtitle", "time": 3731.27, "timestamp": "01:02:11", "text": "おお。おお。おお。手動で行うか、"}, {"type": "subtitle", "time": 3737.91, "timestamp": "01:02:17", "text": "おお。おお。わかった。わかった。わかった。わかった。これは"}, {"type": "subtitle", "time": 3744.77, "timestamp": "01:02:24", "text": "N."}, {"type": "subtitle", "time": 3746.309, "timestamp": "01:02:26", "text": "[音楽]"}, {"type": "subtitle", "time": 3750.069, "timestamp": "01:02:30", "text": "少しズームアウトします。"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "それは賢明だ。何てことだ。それは賢明だ。"}, {"type": "subtitle", "time": 3757.03, "timestamp": "01:02:37", "text": "そして、設置場所も自由に選べます。おお"}, {"type": "subtitle", "time": 3760.39, "timestamp": "01:02:40", "text": "なんてことだ、それは"}, {"type": "subtitle", "time": 3769.91, "timestamp": "01:02:49", "text": "ああ、いや、いや、いや、いや。これはすごくクールだ。これ"}, {"type": "subtitle", "time": 3772.549, "timestamp": "01:02:52", "text": "かっこいいですね。これはすごい。"}, {"type": "subtitle", "time": 3775.349, "timestamp": "01:02:55", "text": "思い通りに調整できない"}, {"type": "subtitle", "time": 3777.03, "timestamp": "01:02:57", "text": "なれ。"}]
[{"type": "subtitle", "time": 19140.23, "timestamp": "05:19:00", "text": "競争。アナイさん、気にかけてくれますか？"}, {"type": "subtitle", "time": 19142.39, "timestamp": "05:19:02", "text": "新入生に少し"}, {"type": "subtitle", "time": 19150.15, "timestamp": "05:19:10", "text": "ああ、大変だ。以前と変わらず、憂鬱な気分だ。そして"}, {"type": "subtitle", "time": 19153.99, "timestamp": "05:19:13", "text": "ミサイ、君は赤をプレイしている。クリア。ああ、大変だ。"}, {"type": "subtitle", "time": 19155.59, "timestamp": "05:19:15", "text": "はい、承知いたしました。実際にボールを召喚するために使用します"}, {"type": "subtitle", "time": 19159.03, "timestamp": "05:19:19", "text": "端にできるだけ近い"}, {"type": "subtitle", "time": 19161.75, "timestamp": "05:19:21", "text": "得点するためにそこまでしなくても"}, {"type": "subtitle", "time": 19164.788, "timestamp": "05:19:24", "text": "ポイント。おお、"}, {"type": "subtitle", "time": 19168.868, "timestamp": "05:19:28", "text": "これは大変だったに違いない。でも、私は"}, {"type": "subtitle", "time": 19170.47, "timestamp": "05:19:30", "text": "競争力"}, {"type": "subtitle", "time": 19180.948, "timestamp": "05:19:40", "text": "あ、待って。できたはずなのに。ごめんなさい。大丈夫です。"}, {"type": "subtitle", "time": 19183.75, "timestamp": "05:19:43", "text": "大丈夫です。私は彼女に勝つ。心配しないで。"}, {"type": "subtitle", "time": 19185.35, "timestamp": "05:19:45", "text": "心配しないで、私が彼女に勝つわ。心配しないで、"}, {"type": "subtitle", "time": 19187.99, "timestamp": "05:19:47", "text": "私は彼女に勝つ。"}, {"type": "subtitle", "time": 19190.868, "timestamp": "05:19:50", "text": "えっ、まさかそんなことするなんて。"}, {"type": "subtitle", "time": 19193.27, "timestamp": "05:19:53", "text": "そういうやり方なんだ。あなたはただ"}]
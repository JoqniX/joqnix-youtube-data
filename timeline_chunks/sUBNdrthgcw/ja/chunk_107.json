[{"type": "subtitle", "time": 6420.39, "timestamp": "01:47:00", "text": "うん、ルーレットしよう。"}, {"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "いいえ、ランダムなものではありません。"}, {"type": "subtitle", "time": 6426.87, "timestamp": "01:47:06", "text": "それで"}, {"type": "subtitle", "time": 6434.55, "timestamp": "01:47:14", "text": "わかった。私は運に任せるつもりだ。"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "ショートカットはありますか？"}, {"type": "subtitle", "time": 6443.189, "timestamp": "01:47:23", "text": "一番上の方？"}, {"type": "subtitle", "time": 6452.95, "timestamp": "01:47:32", "text": "[音楽]"}, {"type": "subtitle", "time": 6455.75, "timestamp": "01:47:35", "text": "わかった。"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "ビクターにピンク色の紫色をあげたい"}, {"type": "subtitle", "time": 6469.109, "timestamp": "01:47:49", "text": "1つ。"}, {"type": "subtitle", "time": 6471.59, "timestamp": "01:47:51", "text": "えっと、"}, {"type": "subtitle", "time": 6473.99, "timestamp": "01:47:53", "text": "わからない。"}, {"type": "subtitle", "time": 6479.91, "timestamp": "01:47:59", "text": "だって今はできないから。"}]
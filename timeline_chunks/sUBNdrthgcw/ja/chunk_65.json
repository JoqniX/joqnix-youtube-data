[{"type": "subtitle", "time": 3901.589, "timestamp": "01:05:01", "text": "8番目。出てくる。出てくる"}, {"type": "subtitle", "time": 3904.87, "timestamp": "01:05:04", "text": "あなたがどこにいようとも。"}, {"type": "subtitle", "time": 3907.99, "timestamp": "01:05:07", "text": "はい、どうぞ。そして私たちも同じことを必要としています"}, {"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "位置の高さ。右。では、私たちができることは"}, {"type": "subtitle", "time": 3911.67, "timestamp": "01:05:11", "text": "するべきことは"}, {"type": "subtitle", "time": 3914.309, "timestamp": "01:05:14", "text": "変形して、コピーして、貼り付けます。"}, {"type": "subtitle", "time": 3919.109, "timestamp": "01:05:19", "text": "コントロール＋シフト＋V。同じことです。"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "そして問題は、私が"}, {"type": "subtitle", "time": 3941.43, "timestamp": "01:05:41", "text": "そうだったと思います。ええ、まあ、そうでしたね。はぁ。"}, {"type": "subtitle", "time": 3947.51, "timestamp": "01:05:47", "text": "おやすみなさい。こんにちは。こんにちは。こんにちは。えっと、"}, {"type": "subtitle", "time": 3949.829, "timestamp": "01:05:49", "text": "寝る。寝る。大丈夫。"}, {"type": "subtitle", "time": 3953.109, "timestamp": "01:05:53", "text": "えーと、いつでも見ることができますよ、私が投稿します"}, {"type": "subtitle", "time": 3956.95, "timestamp": "01:05:56", "text": "完成品。心配ない。"}]
[{"type": "subtitle", "time": 10322.63, "timestamp": "02:52:02", "text": "そのポジション。"}, {"type": "subtitle", "time": 10325.03, "timestamp": "02:52:05", "text": "うん。うん。うん。そして他の人々は"}, {"type": "subtitle", "time": 10327.51, "timestamp": "02:52:07", "text": "ログインしてウェブサイトにアクセスして"}, {"type": "subtitle", "time": 10329.51, "timestamp": "02:52:09", "text": "彼らの写真を入れるように、"}, {"type": "subtitle", "time": 10332.469, "timestamp": "02:52:12", "text": "飾りを付けて、木にドラッグ＆ドロップしてください。"}, {"type": "subtitle", "time": 10335.11, "timestamp": "02:52:15", "text": "そうすればもっと良くなるだろう。ああ、それは"}, {"type": "subtitle", "time": 10338.23, "timestamp": "02:52:18", "text": "より良い、そしてそれに応じて"}, {"type": "subtitle", "time": 10341.03, "timestamp": "02:52:21", "text": "今、私は次のようなコマンドを考えています"}, {"type": "subtitle", "time": 10345.349, "timestamp": "02:52:25", "text": "人数に応じて"}, {"type": "subtitle", "time": 10349.83, "timestamp": "02:52:29", "text": "木の大きさは大きくなるだろう。何てことだ、"}, {"type": "subtitle", "time": 10352.63, "timestamp": "02:52:32", "text": "それはとても素晴らしいでしょう。"}, {"type": "subtitle", "time": 10354.95, "timestamp": "02:52:34", "text": "最初は、"}, {"type": "subtitle", "time": 10359.429, "timestamp": "02:52:39", "text": "10匹まで収容できる小さな木"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "人々、10 えーと装飾品とか"}, {"type": "subtitle", "time": 10366.79, "timestamp": "02:52:46", "text": "そして、そして、そして"}, {"type": "subtitle", "time": 10368.87, "timestamp": "02:52:48", "text": "えっと、この飾り物は"}, {"type": "subtitle", "time": 10370.95, "timestamp": "02:52:50", "text": "要素か何かのようなもの"}, {"type": "subtitle", "time": 10373.429, "timestamp": "02:52:53", "text": "コーディングをする人たちは、要素と言うだろう"}, {"type": "subtitle", "time": 10376.07, "timestamp": "02:52:56", "text": "または何らかの物体または容器またはそれら"}, {"type": "subtitle", "time": 10378.79, "timestamp": "02:52:58", "text": "そういうことですよね？つまり、次のように入力できます"}]
[{"type": "subtitle", "time": 16021.67, "timestamp": "04:27:01", "text": "に。ああ、お金をありがとう。おお、"}, {"type": "subtitle", "time": 16024.469, "timestamp": "04:27:04", "text": "待って。あ、待って。つまり、我々の考えは正しいということだ。"}, {"type": "subtitle", "time": 16026.87, "timestamp": "04:27:06", "text": "ホグワーツの池のほとりで。待って、"}, {"type": "subtitle", "time": 16037.06, "timestamp": "04:27:17", "text": "なるほど、これは興味深い。"}, {"type": "subtitle", "time": 16039.51, "timestamp": "04:27:19", "text": "[音楽]"}, {"type": "subtitle", "time": 16041.51, "timestamp": "04:27:21", "text": "ああ、ハリー・ポッターのフクロウか"}, {"type": "subtitle", "time": 16043.32, "timestamp": "04:27:23", "text": "何か。"}, {"type": "subtitle", "time": 16055.5, "timestamp": "04:27:35", "text": "これはクールだ"}, {"type": "subtitle", "time": 16058.87, "timestamp": "04:27:38", "text": "[音楽]"}, {"type": "subtitle", "time": 16060.13, "timestamp": "04:27:40", "text": "遺産。"}, {"type": "subtitle", "time": 16062.229, "timestamp": "04:27:42", "text": "[音楽]"}, {"type": "subtitle", "time": 16064.55, "timestamp": "04:27:44", "text": "さあ行こう。"}]
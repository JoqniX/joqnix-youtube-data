[{"type": "subtitle", "time": 1681.11, "timestamp": "00:28:01", "text": "ええ、これを調整する必要がある"}, {"type": "subtitle", "time": 1693.029, "timestamp": "00:28:13", "text": "たぶんこんな感じ"}, {"type": "subtitle", "time": 1696.149, "timestamp": "00:28:16", "text": "ああ、これは本当に混乱する。"}, {"type": "subtitle", "time": 1705.269, "timestamp": "00:28:25", "text": "自分のプレイスタイルに合わせて調整してみます。私"}, {"type": "subtitle", "time": 1707.75, "timestamp": "00:28:27", "text": "切り替えません。"}, {"type": "subtitle", "time": 1712.549, "timestamp": "00:28:32", "text": "あのね？ミームには169点。"}, {"type": "subtitle", "time": 1731.75, "timestamp": "00:28:51", "text": "2キル。ジョック、何してるんだ？"}]
[{"type": "subtitle", "time": 19081.03, "timestamp": "05:18:01", "text": "Oh my god, he"}, {"type": "subtitle", "time": 19087.27, "timestamp": "05:18:07", "text": "a pop obstacle thingy. So, why don't we"}, {"type": "subtitle", "time": 19097.11, "timestamp": "05:18:17", "text": "[Music]"}, {"type": "subtitle", "time": 19099.19, "timestamp": "05:18:19", "text": "What's chopling?"}, {"type": "subtitle", "time": 19105.11, "timestamp": "05:18:25", "text": "A charm. Pull the target closer to the"}, {"type": "subtitle", "time": 19108.47, "timestamp": "05:18:28", "text": "cast. Tap the assign key to cast"}, {"type": "subtitle", "time": 19110.07, "timestamp": "05:18:30", "text": "and pull the target closer. Tap key"}, {"type": "subtitle", "time": 19113.35, "timestamp": "05:18:33", "text": "again to throwing the marbles out. You"}, {"type": "subtitle", "time": 19116.47, "timestamp": "05:18:36", "text": "are summoning them."}, {"type": "subtitle", "time": 19131.67, "timestamp": "05:18:51", "text": "Don't you dare fall down. Oh my god."}, {"type": "subtitle", "time": 19134.39, "timestamp": "05:18:54", "text": "Very good. Points to Ravenro."}, {"type": "subtitle", "time": 19135.99, "timestamp": "05:18:55", "text": "But there's certainly no sport in"}, {"type": "subtitle", "time": 19137.43, "timestamp": "05:18:57", "text": "playing without some friendly"}]
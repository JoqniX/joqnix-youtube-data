[{"type": "subtitle", "time": 15126.63, "timestamp": "04:12:06", "text": "Well, that's a start. But there's that"}, {"type": "subtitle", "time": 15129.51, "timestamp": "04:12:09", "text": "symbol again. I don't suppose you see a"}, {"type": "subtitle", "time": 15132.309, "timestamp": "04:12:12", "text": "way to I do, professor. That symbol has"}, {"type": "subtitle", "time": 15133.99, "timestamp": "04:12:13", "text": "the same glow as the one I saw on the"}, {"type": "subtitle", "time": 15136.55, "timestamp": "04:12:16", "text": "port key container. If what you can see"}, {"type": "subtitle", "time": 15139.59, "timestamp": "04:12:19", "text": "reveals the way forward, I dare say we"}, {"type": "subtitle", "time": 15141.75, "timestamp": "04:12:21", "text": "are about to discover the secret of this"}, {"type": "subtitle", "time": 15144.55, "timestamp": "04:12:24", "text": "vault. Lead the way."}, {"type": "subtitle", "time": 15152.63, "timestamp": "04:12:32", "text": "Lumos."}, {"type": "subtitle", "time": 15155.83, "timestamp": "04:12:35", "text": "Normos. This is no ordinary vault. I"}, {"type": "subtitle", "time": 15157.67, "timestamp": "04:12:37", "text": "suspect we will need to earn our way out"}, {"type": "subtitle", "time": 15159.75, "timestamp": "04:12:39", "text": "of here. What do you mean earn our way"}, {"type": "subtitle", "time": 15162.229, "timestamp": "04:12:42", "text": "out? Do you think this is some sort of"}, {"type": "subtitle", "time": 15163.91, "timestamp": "04:12:43", "text": "test?"}, {"type": "subtitle", "time": 15167.99, "timestamp": "04:12:47", "text": "I do. But to what end? I can't fight."}, {"type": "subtitle", "time": 15170.309, "timestamp": "04:12:50", "text": "Let's go. Stay close. There will be no"}, {"type": "subtitle", "time": 15173.03, "timestamp": "04:12:53", "text": "disapparating if things go poorly. Not"}, {"type": "subtitle", "time": 15175.72, "timestamp": "04:12:55", "text": "out of Grinkots."}]
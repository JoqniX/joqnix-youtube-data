[{"type": "subtitle", "time": 26462.31, "timestamp": "07:21:02", "text": "There's some kind of mythical kawaii"}, {"type": "subtitle", "time": 26465.67, "timestamp": "07:21:05", "text": "creature over there. I want to go meet,"}, {"type": "subtitle", "time": 26467.28, "timestamp": "07:21:07", "text": "but I can't."}, {"type": "subtitle", "time": 26474.628, "timestamp": "07:21:14", "text": "[Music]"}, {"type": "subtitle", "time": 26476.948, "timestamp": "07:21:16", "text": "Nearly there. There is much to see"}, {"type": "subtitle", "time": 26478.548, "timestamp": "07:21:18", "text": "outside of the castle walls, not just"}, {"type": "subtitle", "time": 26481.11, "timestamp": "07:21:21", "text": "hugs meat. I am happy to explore"}, {"type": "subtitle", "time": 26483.59, "timestamp": "07:21:23", "text": "whenever you'd like. Rumors being what"}, {"type": "subtitle", "time": 26485.67, "timestamp": "07:21:25", "text": "they are about goblins and such, it"}, {"type": "subtitle", "time": 26487.99, "timestamp": "07:21:27", "text": "might be nice to have a friend with you."}, {"type": "subtitle", "time": 26491.35, "timestamp": "07:21:31", "text": "I'll keep that in mind, Nati. Thank you."}, {"type": "subtitle", "time": 26501.11, "timestamp": "07:21:41", "text": "This is Hookme. Oh, Brazilian. And here"}, {"type": "subtitle", "time": 26503.91, "timestamp": "07:21:43", "text": "we are. It is hard to know where to"}, {"type": "subtitle", "time": 26507.11, "timestamp": "07:21:47", "text": "start. The Three Broomsticks is the"}, {"type": "subtitle", "time": 26509.67, "timestamp": "07:21:49", "text": "place for butter beer. And you can get"}, {"type": "subtitle", "time": 26513.27, "timestamp": "07:21:53", "text": "any sweet you can imagine at Honey."}, {"type": "subtitle", "time": 26516.07, "timestamp": "07:21:56", "text": "I could not choose a favorite shop here."}, {"type": "subtitle", "time": 26518.708, "timestamp": "07:21:58", "text": "It changes with every visit."}]
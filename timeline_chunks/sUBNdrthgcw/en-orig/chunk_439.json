[{"type": "subtitle", "time": 26358.468, "timestamp": "07:19:18", "text": "are settling in. I remember the weeks"}, {"type": "subtitle", "time": 26360.468, "timestamp": "07:19:20", "text": "that followed my arrival feeling quite"}, {"type": "subtitle", "time": 26362.07, "timestamp": "07:19:22", "text": "strange."}, {"type": "subtitle", "time": 26366.31, "timestamp": "07:19:26", "text": "Everything was so they are unfamiliar."}, {"type": "subtitle", "time": 26368.23, "timestamp": "07:19:28", "text": "I'm getting used to things. What about"}, {"type": "subtitle", "time": 26370.868, "timestamp": "07:19:30", "text": "you? Do you finally feel settled? I"}, {"type": "subtitle", "time": 26373.19, "timestamp": "07:19:33", "text": "still miss my homeland, but it is"}, {"type": "subtitle", "time": 26375.59, "timestamp": "07:19:35", "text": "beautiful here, too. And getting out of"}, {"type": "subtitle", "time": 26377.43, "timestamp": "07:19:37", "text": "the castle and exploring helps me to"}, {"type": "subtitle", "time": 26379.99, "timestamp": "07:19:39", "text": "adjust quite a bit. Hogwarts has become"}, {"type": "subtitle", "time": 26382.07, "timestamp": "07:19:42", "text": "something of a home now, I would say."}, {"type": "subtitle", "time": 26385.83, "timestamp": "07:19:45", "text": "Hopefully, it will for you, too."}, {"type": "subtitle", "time": 26388.708, "timestamp": "07:19:48", "text": "Can I"}, {"type": "subtitle", "time": 26390.948, "timestamp": "07:19:50", "text": "attack him? No."}, {"type": "subtitle", "time": 26393.19, "timestamp": "07:19:53", "text": "SG."}, {"type": "subtitle", "time": 26395.59, "timestamp": "07:19:55", "text": "Oh, you can."}]
[{"type": "subtitle", "time": 14041.269, "timestamp": "03:54:01", "text": "Yeah, I thought that will help me with"}, {"type": "subtitle", "time": 14043.11, "timestamp": "03:54:03", "text": "like you know how in Fortnite you can"}, {"type": "subtitle", "time": 14045.189, "timestamp": "03:54:05", "text": "turn on audio visualizer and that will"}, {"type": "subtitle", "time": 14047.269, "timestamp": "03:54:07", "text": "help you when knowing where things are"}, {"type": "subtitle", "time": 14051.15, "timestamp": "03:54:11", "text": "or anything but this is beyond pain"}, {"type": "subtitle", "time": 14055.429, "timestamp": "03:54:15", "text": "[Music]"}, {"type": "subtitle", "time": 14060.28, "timestamp": "03:54:20", "text": "to me looks kind of blurry."}, {"type": "subtitle", "time": 14062.71, "timestamp": "03:54:22", "text": "[Music]"}, {"type": "subtitle", "time": 14065.83, "timestamp": "03:54:25", "text": "Wow. Wait."}, {"type": "subtitle", "time": 14068.309, "timestamp": "03:54:28", "text": "Wow."}, {"type": "subtitle", "time": 14070.87, "timestamp": "03:54:30", "text": "How far did that port key take us?"}, {"type": "subtitle", "time": 14072.63, "timestamp": "03:54:32", "text": "Farther from London than the carriage"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "traveled."}, {"type": "subtitle", "time": 14075.91, "timestamp": "03:54:35", "text": "We're somewhere in the Scottish"}, {"type": "subtitle", "time": 14078.87, "timestamp": "03:54:38", "text": "Highlands. Sir, those ruins. Do you"}, {"type": "subtitle", "time": 14080.55, "timestamp": "03:54:40", "text": "think the port key was meant to lead us"}, {"type": "subtitle", "time": 14083.83, "timestamp": "03:54:43", "text": "there? I do. This has not been the day"}, {"type": "subtitle", "time": 14087.03, "timestamp": "03:54:47", "text": "either of us expected. But Miriam sent"}, {"type": "subtitle", "time": 14090.15, "timestamp": "03:54:50", "text": "that port key to George for a reason."}, {"type": "subtitle", "time": 14093.59, "timestamp": "03:54:53", "text": "And I believe that she and now George"}, {"type": "subtitle", "time": 14096.07, "timestamp": "03:54:56", "text": "died in pursuit of whatever it was meant"}, {"type": "subtitle", "time": 14099.189, "timestamp": "03:54:59", "text": "to lead to. If you're sure you're all"}]
[{"type": "subtitle", "time": 20820.548, "timestamp": "05:47:00", "text": "connecting the meters to comets."}, {"type": "subtitle", "time": 20822.868, "timestamp": "05:47:02", "text": "Brilliant really. One can only imagine"}, {"type": "subtitle", "time": 20825.27, "timestamp": "05:47:05", "text": "what they might do with an enchanted"}, {"type": "subtitle", "time": 20827.35, "timestamp": "05:47:07", "text": "telescope."}, {"type": "subtitle", "time": 20830.15, "timestamp": "05:47:10", "text": "Frustratingly in my correspondence I did"}, {"type": "subtitle", "time": 20832.708, "timestamp": "05:47:12", "text": "feel that I had to continue using the"}, {"type": "subtitle", "time": 20835.27, "timestamp": "05:47:15", "text": "persuadom from my days as a gentleman"}, {"type": "subtitle", "time": 20839.27, "timestamp": "05:47:19", "text": "scholar whilst I find it rather exciting"}, {"type": "subtitle", "time": 20843.99, "timestamp": "05:47:23", "text": "to have a secret identity recent in irks"}, {"type": "subtitle", "time": 20845.83, "timestamp": "05:47:25", "text": "me"}, {"type": "subtitle", "time": 20847.91, "timestamp": "05:47:27", "text": "I'm so looking forward to our trip later"}, {"type": "subtitle", "time": 20851.43, "timestamp": "05:47:31", "text": "this year to Jantaa Manta what adventure"}, {"type": "subtitle", "time": 20854.31, "timestamp": "05:47:34", "text": "shall we shall have I miss you dear"}, {"type": "subtitle", "time": 20857.67, "timestamp": "05:47:37", "text": "sister and do and do hope You are well"}, {"type": "subtitle", "time": 20861.51, "timestamp": "05:47:41", "text": "with love. Satita,"}]
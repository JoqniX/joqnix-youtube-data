[{"type": "subtitle", "time": 14167.189, "timestamp": "03:56:07", "text": "Ancient magic. Yes, a powerful magic"}, {"type": "subtitle", "time": 14170.55, "timestamp": "03:56:10", "text": "wielded by a rare few that seems to have"}, {"type": "subtitle", "time": 14177.91, "timestamp": "03:56:17", "text": "We had a good idea. What castle was"}, {"type": "subtitle", "time": 14180.95, "timestamp": "03:56:20", "text": "built by and is itself a stronghold of"}, {"type": "subtitle", "time": 14184.389, "timestamp": "03:56:24", "text": "that ancient magic? I don't know where"}, {"type": "subtitle", "time": 14186.309, "timestamp": "03:56:26", "text": "she came into possession of the port"}, {"type": "subtitle", "time": 14189.99, "timestamp": "03:56:29", "text": "key, but I am certain it was to do with"}, {"type": "subtitle", "time": 14192.95, "timestamp": "03:56:32", "text": "that search. Ah, there's the path down"}, {"type": "subtitle", "time": 14195.62, "timestamp": "03:56:35", "text": "below. This way."}, {"type": "subtitle", "time": 14198.309, "timestamp": "03:56:38", "text": "[Music]"}, {"type": "subtitle", "time": 14200.87, "timestamp": "03:56:40", "text": "But sir, why was your wife searching for"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "evidence of lost magic?"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "Miriam wanted to understand why such"}, {"type": "subtitle", "time": 14207.269, "timestamp": "03:56:47", "text": "powerful magic disappeared from the"}, {"type": "subtitle", "time": 14210.15, "timestamp": "03:56:50", "text": "wizarding world. Could have just not"}, {"type": "subtitle", "time": 14212.389, "timestamp": "03:56:52", "text": "last name. But magic is no different. It"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "now shows me."}, {"type": "subtitle", "time": 14217.11, "timestamp": "03:56:57", "text": "What really matters is the one who"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "wields it. I hope I can change that up."}]
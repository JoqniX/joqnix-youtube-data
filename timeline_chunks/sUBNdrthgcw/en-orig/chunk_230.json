[{"type": "subtitle", "time": 13806.55, "timestamp": "03:50:06", "text": "Yeah. Hello. Have you seen this?"}, {"type": "subtitle", "time": 13808.55, "timestamp": "03:50:08", "text": "Oh,"}, {"type": "subtitle", "time": 13812.07, "timestamp": "03:50:12", "text": "I have. I forgot the news and threat"}, {"type": "subtitle", "time": 13814.55, "timestamp": "03:50:14", "text": "Renrock really is."}, {"type": "subtitle", "time": 13816.07, "timestamp": "03:50:16", "text": "Although I've yet to convince my"}, {"type": "subtitle", "time": 13818.63, "timestamp": "03:50:18", "text": "colleagues at the ministry, I believe he"}, {"type": "subtitle", "time": 13823.51, "timestamp": "03:50:23", "text": "is a significant threat. And it was your"}, {"type": "subtitle", "time": 13826.07, "timestamp": "03:50:26", "text": "wife, Elazar,"}, {"type": "subtitle", "time": 13828.229, "timestamp": "03:50:28", "text": "who alerted me to his activities months"}, {"type": "subtitle", "time": 13832.15, "timestamp": "03:50:32", "text": "ago. Miriam, how"}, {"type": "subtitle", "time": 13833.99, "timestamp": "03:50:33", "text": "she wrote to me about Randrock before"}, {"type": "subtitle", "time": 13836.95, "timestamp": "03:50:36", "text": "she died, wondering what the ministry"}, {"type": "subtitle", "time": 13840.63, "timestamp": "03:50:40", "text": "knew about his activities."}, {"type": "subtitle", "time": 13843.75, "timestamp": "03:50:43", "text": "Before I could respond, I"}, {"type": "subtitle", "time": 13846.07, "timestamp": "03:50:46", "text": "received this."}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "It was the last thing she sent to me,"}, {"type": "subtitle", "time": 13852.71, "timestamp": "03:50:52", "text": "Elazar. It came to me via her owl, but"}, {"type": "subtitle", "time": 13854.63, "timestamp": "03:50:54", "text": "with no correspondence."}, {"type": "subtitle", "time": 13856.309, "timestamp": "03:50:56", "text": "I can only assume that she had to get"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "rid of it quickly to keep it safe."}]
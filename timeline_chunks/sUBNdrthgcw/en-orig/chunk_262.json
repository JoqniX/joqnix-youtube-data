[{"type": "subtitle", "time": 15726.149, "timestamp": "04:22:06", "text": "Oh, this is the person who built this"}, {"type": "subtitle", "time": 15729.42, "timestamp": "04:22:09", "text": "place. Okay."}, {"type": "subtitle", "time": 15731.51, "timestamp": "04:22:11", "text": "[Music]"}, {"type": "subtitle", "time": 15734.07, "timestamp": "04:22:14", "text": "Wall is in place. The port key is well"}, {"type": "subtitle", "time": 15737.429, "timestamp": "04:22:17", "text": "hidden. Perhaps too well. I wonder if"}, {"type": "subtitle", "time": 15740.55, "timestamp": "04:22:20", "text": "the path we've created may be impossible"}, {"type": "subtitle", "time": 15743.189, "timestamp": "04:22:23", "text": "to follow. It will only be impossible"}, {"type": "subtitle", "time": 15745.189, "timestamp": "04:22:25", "text": "for one who cannot see traces of ancient"}, {"type": "subtitle", "time": 15748.229, "timestamp": "04:22:28", "text": "magic as I can. Your ability to see what"}, {"type": "subtitle", "time": 15750.149, "timestamp": "04:22:30", "text": "others cannot will not be enough."}, {"type": "subtitle", "time": 15751.75, "timestamp": "04:22:31", "text": "Percol,"}, {"type": "subtitle", "time": 15753.83, "timestamp": "04:22:33", "text": "we are entrusting the one who embarks on"}, {"type": "subtitle", "time": 15756.389, "timestamp": "04:22:36", "text": "this path with powerful secrets with"}, {"type": "subtitle", "time": 15758.87, "timestamp": "04:22:38", "text": "knowledge others will do anything to"}, {"type": "subtitle", "time": 15761.83, "timestamp": "04:22:41", "text": "obtain. Yes. And if we are correct,"}, {"type": "subtitle", "time": 15764.07, "timestamp": "04:22:44", "text": "Charles, the witch or wizard who"}, {"type": "subtitle", "time": 15765.67, "timestamp": "04:22:45", "text": "completes the trials will have proven"}, {"type": "subtitle", "time": 15768.389, "timestamp": "04:22:48", "text": "themselves worthy of that knowledge and"}, {"type": "subtitle", "time": 15772.71, "timestamp": "04:22:52", "text": "the responsibility that accompanies it."}]
[{"type": "subtitle", "time": 10080.389, "timestamp": "02:48:00", "text": "ここに貼り付けて、"}, {"type": "subtitle", "time": 10085.269, "timestamp": "02:48:05", "text": "セットリストとか全部載せるね。 でも、"}, {"type": "subtitle", "time": 10095.91, "timestamp": "02:48:15", "text": "アーティスト名や曲名などの情報を与えることができるというアイデアがあります。"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "セットリストを作成しているので、"}, {"type": "subtitle", "time": 10108.55, "timestamp": "02:48:28", "text": "例えば曲名などを考えなければなりません。"}, {"type": "subtitle", "time": 10112.15, "timestamp": "02:48:32", "text": "カバー曲の場合は、"}, {"type": "subtitle", "time": 10114.23, "timestamp": "02:48:34", "text": "デザインの可能性が無限に広がります。 よく考えてみて"}, {"type": "subtitle", "time": 10118.87, "timestamp": "02:48:38", "text": "。 もし私が"}, {"type": "subtitle", "time": 10122.55, "timestamp": "02:48:42", "text": "これを創作の流れのようにしたらどうなるだろうか。"}, {"type": "subtitle", "time": 10125.51, "timestamp": "02:48:45", "text": "疲れていなければ、"}, {"type": "subtitle", "time": 10127.83, "timestamp": "02:48:47", "text": "YouTubeで別の配信をして、"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "これをやってみようか、あるいは、"}, {"type": "subtitle", "time": 10132.389, "timestamp": "02:48:52", "text": "うん、ある意味では"}, {"type": "subtitle", "time": 10136.23, "timestamp": "02:48:56", "text": "ここでやってみようか。 大丈夫だよ、だって"}]
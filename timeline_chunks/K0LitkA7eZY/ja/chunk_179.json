[{"type": "subtitle", "time": 10742.23, "timestamp": "02:59:02", "text": "あぁ、ちょっと待って、あぁ、ちょっと待って、ごめんなさい"}, {"type": "subtitle", "time": 10744.23, "timestamp": "02:59:04", "text": "。   わかりました。では、"}, {"type": "subtitle", "time": 10749.91, "timestamp": "02:59:09", "text": "このカードからのpingは何でしたか？ ああ、"}, {"type": "subtitle", "time": 10764.63, "timestamp": "02:59:24", "text": "公式発表まであと少しです。"}, {"type": "subtitle", "time": 10766.23, "timestamp": "02:59:26", "text": "おお、"}, {"type": "subtitle", "time": 10770.469, "timestamp": "02:59:30", "text": "クールなものがまもなくグローバルに登場します。 さあ行こう。"}, {"type": "subtitle", "time": 10774.87, "timestamp": "02:59:34", "text": "とても素敵です。 わかった。"}, {"type": "subtitle", "time": 10778.79, "timestamp": "02:59:38", "text": "えっと、コハナ・ラムさんですよね？ コハナ。"}, {"type": "subtitle", "time": 10782.07, "timestamp": "02:59:42", "text": "コハナ・ショーン。 彼女の音楽が本当に大好きだし、"}, {"type": "subtitle", "time": 10784.79, "timestamp": "02:59:44", "text": "ハカウォッチは"}, {"type": "subtitle", "time": 10798.15, "timestamp": "02:59:58", "text": "編集。 通常のテキストを削除します。   わかった"}]
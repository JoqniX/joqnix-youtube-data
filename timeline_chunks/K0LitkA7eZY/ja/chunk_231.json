[{"type": "subtitle", "time": 13868.07, "timestamp": "03:51:08", "text": "。"}, {"type": "subtitle", "time": 13871.03, "timestamp": "03:51:11", "text": "わかりません。待って、ここに入るべきでしょうか"}, {"type": "subtitle", "time": 13872.79, "timestamp": "03:51:12", "text": "？オーケー、待って。コピーします"}, {"type": "subtitle", "time": 13875.59, "timestamp": "03:51:15", "text": "貼り付けます。わからない。俺が"}, {"type": "subtitle", "time": 13877.67, "timestamp": "03:51:17", "text": "コーディングを知ってると思ってんのか？ ああ、コーディングは知らないよ"}, {"type": "subtitle", "time": 13880.469, "timestamp": "03:51:20", "text": "。たぶん。わかった。わから"}, {"type": "subtitle", "time": 13883.189, "timestamp": "03:51:23", "text": "ない。えっと、Karatの"}, {"type": "subtitle", "time": 13885.75, "timestamp": "03:51:25", "text": "名前がここに来るよ。下。下"}, {"type": "subtitle", "time": 13889.83, "timestamp": "03:51:29", "text": "。下、"}, {"type": "subtitle", "time": 13894.8, "timestamp": "03:51:34", "text": "下、 曲名はこうなるはず。"}, {"type": "subtitle", "time": 13903.11, "timestamp": "03:51:43", "text": "これを一発で当てられたらどうなるか想像してみて。俺は史上"}, {"type": "subtitle", "time": 13919.349, "timestamp": "03:51:59", "text": "曲名。わかった。曲名。"}]
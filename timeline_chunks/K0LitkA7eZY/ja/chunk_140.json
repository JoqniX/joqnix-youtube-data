[{"type": "subtitle", "time": 8412.389, "timestamp": "02:20:12", "text": "さて、2つ目の"}, {"type": "subtitle", "time": 8415.349, "timestamp": "02:20:15", "text": "部分です。"}, {"type": "subtitle", "time": 8416.79, "timestamp": "02:20:16", "text": "待って、待って、待って、待って、待って、待って。 我慢する"}, {"type": "subtitle", "time": 8419.11, "timestamp": "02:20:19", "text": "。 これをあと10"}, {"type": "subtitle", "time": 8422.389, "timestamp": "02:20:22", "text": "回もやらなきゃいけないんじゃないの？ 私はしなければならない。 ああ、"}, {"type": "subtitle", "time": 8425.75, "timestamp": "02:20:25", "text": "これは練習し続けなきゃいけないな。 もし私がいつかそれを"}, {"type": "subtitle", "time": 8429.99, "timestamp": "02:20:29", "text": "正しくできるようになる日を望むなら、"}, {"type": "subtitle", "time": 8437.11, "timestamp": "02:20:37", "text": "おやおや。 またやります。"}]
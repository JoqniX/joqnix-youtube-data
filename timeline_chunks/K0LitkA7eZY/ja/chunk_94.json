[{"type": "subtitle", "time": 5640.87, "timestamp": "01:34:00", "text": "メインアカウントは、皆さんもご存知の"}, {"type": "subtitle", "time": 5643.51, "timestamp": "01:34:03", "text": "私の名前のアカウントです。"}, {"type": "subtitle", "time": 5646.229, "timestamp": "01:34:06", "text": "あ、こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 5648.149, "timestamp": "01:34:08", "text": "ええと、それは見ていませんでした"}, {"type": "subtitle", "time": 5652.07, "timestamp": "01:34:12", "text": "。 何てことだ。   まあ、大丈夫だよ"}, {"type": "subtitle", "time": 5654.47, "timestamp": "01:34:14", "text": "。"}, {"type": "subtitle", "time": 5656.07, "timestamp": "01:34:16", "text": "君が参加しない方がいいと思うよ。だって、もう"}, {"type": "subtitle", "time": 5658.149, "timestamp": "01:34:18", "text": "コラボ企画があるし、君は"}, {"type": "subtitle", "time": 5660.229, "timestamp": "01:34:20", "text": "今回の練習をしなくちゃいけないからね。"}, {"type": "subtitle", "time": 5661.59, "timestamp": "01:34:21", "text": "練習する。 うん。"}, {"type": "subtitle", "time": 5664.149, "timestamp": "01:34:24", "text": "コラボレーションが多すぎる。"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "うん。 あなたが送ってくれた表紙は既に見ました"}, {"type": "subtitle", "time": 5668.709, "timestamp": "01:34:28", "text": "。"}, {"type": "subtitle", "time": 5672.31, "timestamp": "01:34:32", "text": "ああ、あれね。 うん。 うん。 カザビ。 ああ。"}, {"type": "subtitle", "time": 5674.629, "timestamp": "01:34:34", "text": "だって、このカバーがきっかけで、"}, {"type": "subtitle", "time": 5677.35, "timestamp": "01:34:37", "text": "「あ、ねえ、この"}, {"type": "subtitle", "time": 5679.91, "timestamp": "01:34:39", "text": "歌を教えてあげようか？」って思ったんだもん。 そして「うん」って感じだった。 でも残念ながら、"}, {"type": "subtitle", "time": 5694.95, "timestamp": "01:34:54", "text": "私たちは今、それをゆっくりと進めているのです"}, {"type": "subtitle", "time": 5697.03, "timestamp": "01:34:57", "text": "。"}, {"type": "subtitle", "time": 5699.27, "timestamp": "01:34:59", "text": "うん。"}]
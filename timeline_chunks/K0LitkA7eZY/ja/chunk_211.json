[{"type": "subtitle", "time": 12660.0, "timestamp": "03:31:00", "text": "セットなしの 状態にします。タイトルテキストは、"}, {"type": "subtitle", "time": 12671.67, "timestamp": "03:31:11", "text": "理想的には曲名になります"}, {"type": "subtitle", "time": 12674.79, "timestamp": "03:31:14", "text": "。おそらくこんな感じです。"}, {"type": "subtitle", "time": 12677.99, "timestamp": "03:31:17", "text": "ええ、これだけが必要です。そして、これが"}, {"type": "subtitle", "time": 12680.07, "timestamp": "03:31:20", "text": "ストリームトピックの状態になりますよね？ ストリーム"}, {"type": "subtitle", "time": 12683.19, "timestamp": "03:31:23", "text": "歌う状態、ストリームセットリスト、セットリストステータスの"}, {"type": "subtitle", "time": 12694.389, "timestamp": "03:31:34", "text": "タイトル、ストリームセットリストの"}, {"type": "subtitle", "time": 12697.59, "timestamp": "03:31:37", "text": "タイトルタイトルかもしれません。タイトル、わかりました"}, {"type": "subtitle", "time": 12715.11, "timestamp": "03:31:55", "text": "ああ、神様。えーと、なぜ"}, {"type": "subtitle", "time": 12718.15, "timestamp": "03:31:58", "text": "同じものを2つのレイヤーにしたように見えるのですか？"}]
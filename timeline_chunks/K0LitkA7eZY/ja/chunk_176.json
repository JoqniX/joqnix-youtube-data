[{"type": "subtitle", "time": 10566.71, "timestamp": "02:56:06", "text": "参考ガイドラインガイドトラックを参照したり使用したりしていることを、私を見ている人たちに通知する方法が欲しかったのです"}, {"type": "subtitle", "time": 10571.349, "timestamp": "02:56:11", "text": "。"}, {"type": "subtitle", "time": 10573.19, "timestamp": "02:56:13", "text": "うん。 うん。 うん。 だから、"}, {"type": "subtitle", "time": 10580.71, "timestamp": "02:56:20", "text": "普通に何かを追加するような感じでやってみたらどうかなと思ったんです。 待って、"}, {"type": "subtitle", "time": 10592.15, "timestamp": "02:56:32", "text": "ああ、if文とelse"}, {"type": "subtitle", "time": 10596.309, "timestamp": "02:56:36", "text": "文をこんなにたくさん書かなきゃいけないなんて。 いいえ。ああ。いや、待って。 私はそうする必要はありません"}, {"type": "subtitle", "time": 10598.95, "timestamp": "02:56:38", "text": "。 いや、いや、犬。 もしそうでないなら、"}, {"type": "subtitle", "time": 10601.03, "timestamp": "02:56:41", "text": "あのね？ ちょっと"}, {"type": "subtitle", "time": 10603.51, "timestamp": "02:56:43", "text": "入力してみましょう。"}, {"type": "subtitle", "time": 10606.71, "timestamp": "02:56:46", "text": "不器用な男"}, {"type": "subtitle", "time": 10609.269, "timestamp": "02:56:49", "text": "で芸術家でもある人が、"}, {"type": "subtitle", "time": 10612.55, "timestamp": "02:56:52", "text": "この男を真似するだろう。 どうすれば"}, {"type": "subtitle", "time": 10619.429, "timestamp": "02:56:59", "text": "待って、プロパティを複製するにはどうすればいいの"}]
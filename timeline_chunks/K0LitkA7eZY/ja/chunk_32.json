[{"type": "subtitle", "time": 1922.07, "timestamp": "00:32:02", "text": "ああ、あれですね。 それが組み合わせです。 ああ"}, {"type": "subtitle", "time": 1925.35, "timestamp": "00:32:05", "text": "、わかりました。 ここでは全てボーカルで演奏しました。   わかった"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 1934.789, "timestamp": "00:32:14", "text": "星、そこに3つの星がある。"}, {"type": "subtitle", "time": 1937.99, "timestamp": "00:32:17", "text": "ああ、星３つ。 こんにちは。"}, {"type": "subtitle", "time": 1943.509, "timestamp": "00:32:23", "text": "だって、私は大丈夫だから。 つまり、ダイヤモンドですね。   わかった"}, {"type": "subtitle", "time": 1951.35, "timestamp": "00:32:31", "text": "。"}]
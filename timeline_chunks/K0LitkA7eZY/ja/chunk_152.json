[{"type": "subtitle", "time": 9151.11, "timestamp": "02:32:31", "text": "私は間違いを犯しました。"}, {"type": "subtitle", "time": 9158.23, "timestamp": "02:32:38", "text": "あなたは美しい"}, {"type": "subtitle", "time": 9160.469, "timestamp": "02:32:40", "text": "声を持っています。"}, {"type": "subtitle", "time": 9162.95, "timestamp": "02:32:42", "text": "私は歌います、私は歌が下手です。"}, {"type": "subtitle", "time": 9165.19, "timestamp": "02:32:45", "text": "歌うのは初めてです。"}, {"type": "subtitle", "time": 9167.429, "timestamp": "02:32:47", "text": "歌にハマっています。 だから、私はまだあの"}, {"type": "subtitle", "time": 9170.79, "timestamp": "02:32:50", "text": "美しい歌声、歌声を持っていないんです。"}, {"type": "subtitle", "time": 9174.07, "timestamp": "02:32:54", "text": "でも、練習を重ねて、何度も何度も練習して、いつか"}]
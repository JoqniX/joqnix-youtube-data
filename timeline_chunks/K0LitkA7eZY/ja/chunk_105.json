[{"type": "subtitle", "time": 6310.709, "timestamp": "01:45:10", "text": "ああ、素晴らしかった。 待って、それは"}, {"type": "subtitle", "time": 6314.87, "timestamp": "01:45:14", "text": "リム肉食プランだった。"}, {"type": "subtitle", "time": 6316.709, "timestamp": "01:45:16", "text": "さて、次はちょっと大げさな"}, {"type": "subtitle", "time": 6319.59, "timestamp": "01:45:19", "text": "話になりますよ。 わかった。   えっと、"}, {"type": "subtitle", "time": 6324.07, "timestamp": "01:45:24", "text": "Meltを使っているので、"}, {"type": "subtitle", "time": 6326.87, "timestamp": "01:45:26", "text": "もうOBSは使っていません。  HTML を使っている場合、"}, {"type": "subtitle", "time": 6330.709, "timestamp": "01:45:30", "text": "これをポップアップして"}, {"type": "subtitle", "time": 6333.51, "timestamp": "01:45:33", "text": "曲に何かを追加するのは非常に難しいことです"}, {"type": "subtitle", "time": 6338.149, "timestamp": "01:45:38", "text": "。 それは本当に面倒くさい。"}, {"type": "subtitle", "time": 6348.149, "timestamp": "01:45:48", "text": "HTMLオーバーレイでやったように、何らかの方法でこれを自動化する必要があるような気がします。"}, {"type": "subtitle", "time": 6352.229, "timestamp": "01:45:52", "text": "後でそれを自動化する必要があると思うよ"}, {"type": "subtitle", "time": 6354.55, "timestamp": "01:45:54", "text": "。"}, {"type": "subtitle", "time": 6357.669, "timestamp": "01:45:57", "text": "ああ、痛い。 知っている。   わかった"}]
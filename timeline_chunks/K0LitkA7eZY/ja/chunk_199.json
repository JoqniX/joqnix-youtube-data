[{"type": "subtitle", "time": 11949.91, "timestamp": "03:19:09", "text": "何？ 誰が不明な情報を受け取ったのか？ 不明な"}, {"type": "subtitle", "time": 11952.15, "timestamp": "03:19:12", "text": "タナニ。 何？  「不明」とはどういう意味ですか"}, {"type": "subtitle", "time": 11967.59, "timestamp": "03:19:27", "text": "曲名は未定義です。 芸術は定義不可能である。"}, {"type": "subtitle", "time": 11970.469, "timestamp": "03:19:30", "text": "星は未定義です。 何？ 一体"}, {"type": "subtitle", "time": 11981.19, "timestamp": "03:19:41", "text": "プレーンテキスト。 これくらいはちゃんとできないの？"}]
[{"type": "subtitle", "time": 4385.75, "timestamp": "01:13:05", "text": "つまり、右クリックを押したまま"}, {"type": "subtitle", "time": 4389.35, "timestamp": "01:13:09", "text": "マウスを下にスクロールすると、"}, {"type": "subtitle", "time": 4393.35, "timestamp": "01:13:13", "text": "ブラウズタブが閉じます。 はい、このようにできます。"}, {"type": "subtitle", "time": 4397.189, "timestamp": "01:13:17", "text": "メモを追加したり、いろいろやってみてください。"}, {"type": "subtitle", "time": 4398.55, "timestamp": "01:13:18", "text": "うん、これはいいね。"}, {"type": "subtitle", "time": 4400.47, "timestamp": "01:13:20", "text": "最初はApple"}, {"type": "subtitle", "time": 4403.03, "timestamp": "01:13:23", "text": "Notesを使ってみようとしたのですが、過熱してしまいます。 それが"}, {"type": "subtitle", "time": 4408.31, "timestamp": "01:13:28", "text": "Appleのメモアプリの問題点だ。 ああ、何とか回避策を見つけようとして、いくつかの"}, {"type": "subtitle", "time": 4415.11, "timestamp": "01:13:35", "text": "アプリを探してみたんだけど、うん、すごくいいアプリを見つけたんだ"}, {"type": "subtitle", "time": 4417.51, "timestamp": "01:13:37", "text": "。"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "Apple Notesに似ていますが、"}, {"type": "subtitle", "time": 4422.39, "timestamp": "01:13:42", "text": "PDFを挿入できる点が異なります。"}, {"type": "subtitle", "time": 4424.79, "timestamp": "01:13:44", "text": "あ、PDFとして保存するオプションがあるんですね。"}, {"type": "subtitle", "time": 4427.03, "timestamp": "01:13:47", "text": "それはPDFをエクスポートすることです"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "。   ちょっと"}, {"type": "subtitle", "time": 4430.79, "timestamp": "01:13:50", "text": "待って、実際にPDFをインポートしてみます"}, {"type": "subtitle", "time": 4432.709, "timestamp": "01:13:52", "text": "。"}, {"type": "subtitle", "time": 4433.59, "timestamp": "01:13:53", "text": "ええと、"}, {"type": "subtitle", "time": 4435.99, "timestamp": "01:13:55", "text": "もしそれができるなら、おそらく"}, {"type": "subtitle", "time": 4438.229, "timestamp": "01:13:58", "text": "あなたにとって非常に役立つでしょう。"}, {"type": "subtitle", "time": 4438.79, "timestamp": "01:13:58", "text": "ええ、"}]
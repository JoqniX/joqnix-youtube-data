[{"type": "subtitle", "time": 13801.189, "timestamp": "03:50:01", "text": "名は"}, {"type": "subtitle", "time": 13805.349, "timestamp": "03:50:05", "text": "データドットアーティストドット、つまりアンダースコア"}, {"type": "subtitle", "time": 13807.99, "timestamp": "03:50:07", "text": "名と同じです。Notionでやったのはこれです。"}, {"type": "subtitle", "time": 13817.429, "timestamp": "03:50:17", "text": "ええと、"}, {"type": "subtitle", "time": 13819.59, "timestamp": "03:50:19", "text": "カバー"}, {"type": "subtitle", "time": 13821.189, "timestamp": "03:50:21", "text": "アーティスト"}, {"type": "subtitle", "time": 13823.03, "timestamp": "03:50:23", "text": "名になります。ええ"}, {"type": "subtitle", "time": 13826.309, "timestamp": "03:50:26", "text": "。ええ。では、クリーンアクティビティ。オーケー。Jo"}, {"type": "subtitle", "time": 13828.63, "timestamp": "03:50:28", "text": "オーバーレイ。オーケー。これはセットリスト"}, {"type": "subtitle", "time": 13831.51, "timestamp": "03:50:31", "text": "オーバーレイになりますよね？セットリストを作成しているので"}, {"type": "subtitle", "time": 13834.87, "timestamp": "03:50:34", "text": "。セットリストオーバーレイスタイルはなしです。Jo"}, {"type": "subtitle", "time": 13836.63, "timestamp": "03:50:36", "text": "。"}, {"type": "subtitle", "time": 13838.95, "timestamp": "03:50:38", "text": "ええ。セットリストオーバーレイはブロックと同じです"}, {"type": "subtitle", "time": 13843.11, "timestamp": "03:50:43", "text": "。セットリストオーバーレイダッシュ"}]
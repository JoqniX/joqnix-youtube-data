[{"type": "subtitle", "time": 4871.75, "timestamp": "01:21:11", "text": "少し疲れてきているようですね。"}, {"type": "subtitle", "time": 4874.63, "timestamp": "01:21:14", "text": "水を飲んでください。 こんにちは。"}, {"type": "subtitle", "time": 4880.07, "timestamp": "01:21:20", "text": "そして、そのパーツは、ええと、"}, {"type": "subtitle", "time": 4883.03, "timestamp": "01:21:23", "text": "3行目、まさに3番目のものです。 ああ。"}, {"type": "subtitle", "time": 4884.63, "timestamp": "01:21:24", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 4889.91, "timestamp": "01:21:29", "text": "ゲイの部分は、基本的にと発音します。"}, {"type": "subtitle", "time": 4897.91, "timestamp": "01:21:37", "text": "。 そう発音したんです。 そして、"}, {"type": "subtitle", "time": 4901.27, "timestamp": "01:21:41", "text": "最後の3行目は、"}, {"type": "subtitle", "time": 4913.11, "timestamp": "01:21:53", "text": "That's all と発音します。"}, {"type": "subtitle", "time": 4915.83, "timestamp": "01:21:55", "text": "ああ、大変だ。 また。"}]
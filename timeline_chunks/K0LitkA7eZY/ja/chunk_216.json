[{"type": "subtitle", "time": 12962.95, "timestamp": "03:36:02", "text": "カバーアーティスト名になりますよね？"}, {"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "カバーアーティストを忘れないように。"}, {"type": "subtitle", "time": 12967.59, "timestamp": "03:36:07", "text": "まだ作成していないのはわかっていますが、"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "そうです。ストリームの"}, {"type": "subtitle", "time": 12974.07, "timestamp": "03:36:14", "text": "カバーアーティスト名。"}, {"type": "subtitle", "time": 12979.91, "timestamp": "03:36:19", "text": "これは必要ありません。コンスティックタイトル"}, {"type": "subtitle", "time": 12982.87, "timestamp": "03:36:22", "text": "ドキュメント要素ID。ああ、これがIDですよね"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "？わかりました。わかりました、わかりました。"}, {"type": "subtitle", "time": 12998.389, "timestamp": "03:36:38", "text": "ストリームの曲のタイトル、ですよね？曲の"}, {"type": "subtitle", "time": 13001.99, "timestamp": "03:36:41", "text": "タイトルは要素で取得できます。"}, {"type": "subtitle", "time": 13004.79, "timestamp": "03:36:44", "text": "私が配置した要素は曲のタイトルでした。これを"}, {"type": "subtitle", "time": 13011.11, "timestamp": "03:36:51", "text": "ああ、コードから抜け出しました。"}]
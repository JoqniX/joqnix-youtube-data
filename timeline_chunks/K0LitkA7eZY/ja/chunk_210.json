[{"type": "subtitle", "time": 12604.309, "timestamp": "03:30:04", "text": "でも、"}, {"type": "subtitle", "time": 12607.59, "timestamp": "03:30:07", "text": "テキストレイヤーが1つあります。私のアイデアは、"}, {"type": "subtitle", "time": 12611.11, "timestamp": "03:30:11", "text": "これを削除しましょう。私のアイデアは、例えば、えっと、神崎よりの"}, {"type": "subtitle", "time": 12617.67, "timestamp": "03:30:17", "text": "曲を取得しようとしているとします。私のアイデアは、"}, {"type": "subtitle", "time": 12620.469, "timestamp": "03:30:20", "text": "上にバンド名を載せることです。わかりました"}, {"type": "subtitle", "time": 12624.309, "timestamp": "03:30:24", "text": "、このように。これを上に載せます。"}, {"type": "subtitle", "time": 12627.51, "timestamp": "03:30:27", "text": "曲名が上に表示されます。"}, {"type": "subtitle", "time": 12630.229, "timestamp": "03:30:30", "text": "えっと、それから、えっと、"}, {"type": "subtitle", "time": 12637.349, "timestamp": "03:30:37", "text": "購入のようなものを載せることができます。"}, {"type": "subtitle", "time": 12642.71, "timestamp": "03:30:42", "text": "いや、いや、いや。これを、えっと、このようにしましょう。"}, {"type": "subtitle", "time": 12647.429, "timestamp": "03:30:47", "text": "曲名。"}, {"type": "subtitle", "time": 12651.11, "timestamp": "03:30:51", "text": "えーと、これはストリームトピックの"}, {"type": "subtitle", "time": 12655.83, "timestamp": "03:30:55", "text": "状態を削除して、歌う、"}, {"type": "subtitle", "time": 12658.239, "timestamp": "03:30:58", "text": "歌う、 セットなしの"}]
[{"type": "subtitle", "time": 4441.75, "timestamp": "01:14:01", "text": "あなたは教えていませんね。"}, {"type": "subtitle", "time": 4444.87, "timestamp": "01:14:04", "text": "あなたがそれをやってくれたら本当に嬉しいです"}, {"type": "subtitle", "time": 4452.47, "timestamp": "01:14:12", "text": "特にウェブの場合は、ウェブが"}, {"type": "subtitle", "time": 4455.35, "timestamp": "01:14:15", "text": "クラッシュすると"}, {"type": "subtitle", "time": 4457.99, "timestamp": "01:14:17", "text": "すべてのデータが失われます。"}, {"type": "subtitle", "time": 4459.43, "timestamp": "01:14:19", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 4462.95, "timestamp": "01:14:22", "text": "うん。"}, {"type": "subtitle", "time": 4465.03, "timestamp": "01:14:25", "text": "真面目な話、聞いてください。 うん。"}, {"type": "subtitle", "time": 4467.669, "timestamp": "01:14:27", "text": "基本的には、PDFファイルをそこにドラッグ＆ドロップするだけです"}, {"type": "subtitle", "time": 4468.149, "timestamp": "01:14:28", "text": "。"}, {"type": "subtitle", "time": 4469.75, "timestamp": "01:14:29", "text": "ああ、確かに効果がありますよ。"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "うん。"}, {"type": "subtitle", "time": 4474.229, "timestamp": "01:14:34", "text": "ああ、うまくいった。 何てことだ。"}, {"type": "subtitle", "time": 4477.03, "timestamp": "01:14:37", "text": "ああ、そうだね。 まるでスライドショーのようだ。"}, {"type": "subtitle", "time": 4478.47, "timestamp": "01:14:38", "text": "うん。"}, {"type": "subtitle", "time": 4481.75, "timestamp": "01:14:41", "text": "えっと、これは何ですか？ 忘れた。 漢字の本。"}, {"type": "subtitle", "time": 4484.95, "timestamp": "01:14:44", "text": "ああ、漢字の本ですね。 忘れた。"}, {"type": "subtitle", "time": 4488.31, "timestamp": "01:14:48", "text": "このPDFをお送りします。"}, {"type": "subtitle", "time": 4490.63, "timestamp": "01:14:50", "text": "面白い。 私はあまり読書をしないんです"}, {"type": "subtitle", "time": 4491.83, "timestamp": "01:14:51", "text": "。"}, {"type": "subtitle", "time": 4494.31, "timestamp": "01:14:54", "text": "そうそう。"}, {"type": "subtitle", "time": 4496.31, "timestamp": "01:14:56", "text": "漢字の書き方を教えてくれます。"}, {"type": "subtitle", "time": 4497.669, "timestamp": "01:14:57", "text": "うん。 うん。"}]
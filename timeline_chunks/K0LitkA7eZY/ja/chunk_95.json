[{"type": "subtitle", "time": 5700.229, "timestamp": "01:35:00", "text": "ありがとう。"}, {"type": "subtitle", "time": 5704.39, "timestamp": "01:35:04", "text": "？"}, {"type": "subtitle", "time": 5713.11, "timestamp": "01:35:13", "text": "、必ず練習を続けてくださいね。   はい"}, {"type": "subtitle", "time": 5716.87, "timestamp": "01:35:16", "text": "、必ずそうします。"}, {"type": "subtitle", "time": 5721.11, "timestamp": "01:35:21", "text": "今日は一緒に来てくださって本当にありがとうございました。   はい"}, {"type": "subtitle", "time": 5728.55, "timestamp": "01:35:28", "text": "本当に楽しかったです。 第"}, {"type": "subtitle", "time": 5730.39, "timestamp": "01:35:30", "text": "二声部を教えてくださってありがとうございます。"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "2番目の声の発音に苦労していたのですが、おかげで"}, {"type": "subtitle", "time": 5744.39, "timestamp": "01:35:44", "text": "ええ、どういたしまして。   それでは"}, {"type": "subtitle", "time": 5747.91, "timestamp": "01:35:47", "text": "、"}, {"type": "subtitle", "time": 5750.39, "timestamp": "01:35:50", "text": "ご覧いただいている皆様、さようなら。 それでは、これで失礼します。"}, {"type": "subtitle", "time": 5751.99, "timestamp": "01:35:51", "text": "ええ、先生、"}, {"type": "subtitle", "time": 5753.91, "timestamp": "01:35:53", "text": "配信は続ける予定ですか？"}, {"type": "subtitle", "time": 5755.91, "timestamp": "01:35:55", "text": "うん。 幸運を祈ります。"}]
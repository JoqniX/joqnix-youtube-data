[{"type": "subtitle", "time": 5461.27, "timestamp": "01:31:01", "text": "寝て、目が覚めたんです。"}, {"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "夕食を抜いたと思う。 いいえ、"}, {"type": "subtitle", "time": 5468.629, "timestamp": "01:31:08", "text": "夕食は食べました。 それから、"}, {"type": "subtitle", "time": 5470.47, "timestamp": "01:31:10", "text": "配信を終えて"}, {"type": "subtitle", "time": 5473.189, "timestamp": "01:31:13", "text": "Twitch Cakeのボードを維持した後、8時頃に寝ました。 それで、"}, {"type": "subtitle", "time": 5476.629, "timestamp": "01:31:16", "text": "午前3時頃に目が覚めたんです。それから、「しまった、"}, {"type": "subtitle", "time": 5485.91, "timestamp": "01:31:25", "text": "12時か10時頃に参加するはずだった会議に遅刻した」って気づいて、"}, {"type": "subtitle", "time": 5488.87, "timestamp": "01:31:28", "text": "謝って起きました。 それから"}, {"type": "subtitle", "time": 5491.669, "timestamp": "01:31:31", "text": "音楽を聴いた。そう、聴いていたのは"}, {"type": "subtitle", "time": 5494.709, "timestamp": "01:31:34", "text": "美しい6月の音楽だった。そしてまた眠ってしまった。   午前"}, {"type": "subtitle", "time": 5497.83, "timestamp": "01:31:37", "text": "6時に起きて、7時に配信を開始し、その後もここにいます"}, {"type": "subtitle", "time": 5500.629, "timestamp": "01:31:40", "text": "。 ええ、しっかり休ん"}, {"type": "subtitle", "time": 5502.709, "timestamp": "01:31:42", "text": "でここに来ました。   だから"}, {"type": "subtitle", "time": 5505.83, "timestamp": "01:31:45", "text": "今日はたくさんやったよ。"}, {"type": "subtitle", "time": 5508.95, "timestamp": "01:31:48", "text": "昨日、寝た後、"}, {"type": "subtitle", "time": 5512.39, "timestamp": "01:31:52", "text": "うーん、ちょっと"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "眠い感じがして、そのまま寝て、起きたら、"}]
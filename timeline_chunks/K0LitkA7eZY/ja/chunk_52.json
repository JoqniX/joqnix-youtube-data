[{"type": "subtitle", "time": 3122.309, "timestamp": "00:52:02", "text": "待って、何が起こったの？ 待って、切断したの"}, {"type": "subtitle", "time": 3130.309, "timestamp": "00:52:10", "text": "待って。"}, {"type": "subtitle", "time": 3136.63, "timestamp": "00:52:16", "text": "インターネットは消滅する。 うん。 なんてこった。 いいえ。その"}, {"type": "subtitle", "time": 3139.67, "timestamp": "00:52:19", "text": "側面はあなたの中には失われています。 待って。 彼女は"}, {"type": "subtitle", "time": 3148.71, "timestamp": "00:52:28", "text": "えっと、"}, {"type": "subtitle", "time": 3151.75, "timestamp": "00:52:31", "text": "彼女を呼んできます。 彼女は配信した。  H. おかえりなさい"}, {"type": "subtitle", "time": 3153.109, "timestamp": "00:52:33", "text": "。"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "ええ、戻ってきました。 どういうわけか、私の首が切断された"}, {"type": "subtitle", "time": 3157.67, "timestamp": "00:52:37", "text": "。"}, {"type": "subtitle", "time": 3160.309, "timestamp": "00:52:40", "text": "うん、"}, {"type": "subtitle", "time": 3161.91, "timestamp": "00:52:41", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 3164.63, "timestamp": "00:52:44", "text": "そう、それはそう"}, {"type": "subtitle", "time": 3168.15, "timestamp": "00:52:48", "text": "、ベトナムみたいだ"}, {"type": "subtitle", "time": 3170.47, "timestamp": "00:52:50", "text": "。"}, {"type": "subtitle", "time": 3173.19, "timestamp": "00:52:53", "text": "心配ない。"}, {"type": "subtitle", "time": 3175.349, "timestamp": "00:52:55", "text": "うん。"}, {"type": "subtitle", "time": 3178.15, "timestamp": "00:52:58", "text": "配信は再開しましたか？   そう思います。"}]
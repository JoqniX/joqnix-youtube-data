[{"type": "subtitle", "time": 4024.23, "timestamp": "01:07:04", "text": "よし、"}, {"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "配信を終える前に、あと5回くらい歌わないといけないだろう。   わかった"}, {"type": "subtitle", "time": 4028.15, "timestamp": "01:07:08", "text": "。"}, {"type": "subtitle", "time": 4029.27, "timestamp": "01:07:09", "text": "こんにちは。 あと5回。"}, {"type": "subtitle", "time": 4031.27, "timestamp": "01:07:11", "text": "間違いが多かった。"}, {"type": "subtitle", "time": 4035.029, "timestamp": "01:07:15", "text": "最初はキテンだった。 基本的には"}, {"type": "subtitle", "time": 4038.789, "timestamp": "01:07:18", "text": "またタイタンの話だ。"}, {"type": "subtitle", "time": 4041.029, "timestamp": "01:07:21", "text": "あれ、タイタンって言ったっけ？"}, {"type": "subtitle", "time": 4041.99, "timestamp": "01:07:21", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "。 キテヌバ。   わかった"}, {"type": "subtitle", "time": 4049.029, "timestamp": "01:07:29", "text": "。 それから、私が知らない白幻"}, {"type": "subtitle", "time": 4052.069, "timestamp": "01:07:32", "text": "。 私は本能的にサカドモードを好みます"}, {"type": "subtitle", "time": 4054.069, "timestamp": "01:07:34", "text": "。 ああ、"}, {"type": "subtitle", "time": 4056.309, "timestamp": "01:07:36", "text": "大丈夫だよ。 私は良くなるでしょう。"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "基本的に発音を学ぶことができます。"}]
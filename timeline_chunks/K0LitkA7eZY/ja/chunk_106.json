[{"type": "subtitle", "time": 6361.91, "timestamp": "01:46:01", "text": "。 リムは大げさな話だ。 わかった。"}, {"type": "subtitle", "time": 6364.47, "timestamp": "01:46:04", "text": "水を飲ませてください。 熱湯を少し入れて、"}, {"type": "subtitle", "time": 6370.55, "timestamp": "01:46:10", "text": "普通の水と混ぜます。"}, {"type": "subtitle", "time": 6380.719, "timestamp": "01:46:20", "text": "。 ３、２、"}, {"type": "subtitle", "time": 6383.28, "timestamp": "01:46:23", "text": "３、２、 待って、踊らなきゃ。"}, {"type": "subtitle", "time": 6399.35, "timestamp": "01:46:39", "text": "よし、全部吐き出した。 待って、まだ続きがある"}, {"type": "subtitle", "time": 6414.31, "timestamp": "01:46:54", "text": "バーピーを口から出すと、"}, {"type": "subtitle", "time": 6416.55, "timestamp": "01:46:56", "text": "すごく痛い。"}]
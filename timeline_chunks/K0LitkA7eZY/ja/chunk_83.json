[{"type": "subtitle", "time": 5010.149, "timestamp": "01:23:30", "text": "ええ、それはほぼ完璧です"}, {"type": "subtitle", "time": 5025.35, "timestamp": "01:23:45", "text": "なぜ私は、何も見本を見ずにゆっくり歌うときは正しく歌えていると思うのに、それに従って歌うと"}, {"type": "subtitle", "time": 5031.91, "timestamp": "01:23:51", "text": "間違えてしまうのだろうか。"}, {"type": "subtitle", "time": 5034.629, "timestamp": "01:23:54", "text": "やっぱり、もっと練習を続けないといけないと思う。"}, {"type": "subtitle", "time": 5039.43, "timestamp": "01:23:59", "text": "うん。 うん。 私は「ええ、そうですね」という感じです。"}]
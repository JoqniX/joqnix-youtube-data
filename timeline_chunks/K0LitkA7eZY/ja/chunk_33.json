[{"type": "subtitle", "time": 2006.31, "timestamp": "00:33:26", "text": "ああ、この男も"}, {"type": "subtitle", "time": 2015.909, "timestamp": "00:33:35", "text": "この部分で狂ったように騒ぎ立てる。 いいえ、この紫色の線、"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "3つの部分で、私は時々ちょっと"}, {"type": "subtitle", "time": 2021.59, "timestamp": "00:33:41", "text": "戸惑ってしまうんです。"}, {"type": "subtitle", "time": 2024.389, "timestamp": "00:33:44", "text": "そして、凧ペンの部分は基本的に、"}, {"type": "subtitle", "time": 2029.509, "timestamp": "00:33:49", "text": "再びメモでその隙間を埋めようとしたのです。"}, {"type": "subtitle", "time": 2033.509, "timestamp": "00:33:53", "text": "いやいや、彼女はそういう風に歌うんだよ。"}, {"type": "subtitle", "time": 2035.75, "timestamp": "00:33:55", "text": "待ち時間は"}]
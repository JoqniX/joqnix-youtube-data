[{"type": "subtitle", "time": 11642.55, "timestamp": "03:14:02", "text": "。 では、セミオートに戻ってください。 ええと、"}, {"type": "subtitle", "time": 11645.67, "timestamp": "03:14:05", "text": "ペイロードに関しては異議を唱えざるを得ません。 私は"}, {"type": "subtitle", "time": 11650.15, "timestamp": "03:14:10", "text": "この男が必要で、"}, {"type": "subtitle", "time": 11654.55, "timestamp": "03:14:14", "text": "ペイロードタイプをストリームジョックジョック"}, {"type": "subtitle", "time": 11658.95, "timestamp": "03:14:18", "text": "アクティビティ歌歌歌歌セットリスト"}, {"type": "subtitle", "time": 11661.83, "timestamp": "03:14:21", "text": "更新として設定する必要があります。"}, {"type": "subtitle", "time": 11664.389, "timestamp": "03:14:24", "text": "サミーとこの男もそうなるだろう。 私たちは"}, {"type": "subtitle", "time": 11667.59, "timestamp": "03:14:27", "text": "これを変えなければならない。"}, {"type": "subtitle", "time": 11670.79, "timestamp": "03:14:30", "text": "えっと"}, {"type": "subtitle", "time": 11673.83, "timestamp": "03:14:33", "text": "、曲名ですよね？ 曲名は、この"}, {"type": "subtitle", "time": 11679.269, "timestamp": "03:14:39", "text": "名前のプレーンテキストになります。"}, {"type": "subtitle", "time": 11684.469, "timestamp": "03:14:44", "text": "それを削除してここに配置します。"}, {"type": "subtitle", "time": 11688.15, "timestamp": "03:14:48", "text": "この名前のカバーカラーはここに表示され、そこに"}, {"type": "subtitle", "time": 11691.19, "timestamp": "03:14:51", "text": "配置されます。"}, {"type": "subtitle", "time": 11697.67, "timestamp": "03:14:57", "text": "ええ、大丈夫です。 ステータス"}]
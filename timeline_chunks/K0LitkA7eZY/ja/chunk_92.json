[{"type": "subtitle", "time": 5521.35, "timestamp": "01:32:01", "text": "カルマのセリフの歌詞をいくつか作ったりはしなかった"}, {"type": "subtitle", "time": 5524.229, "timestamp": "01:32:04", "text": "。"}, {"type": "subtitle", "time": 5527.03, "timestamp": "01:32:07", "text": "基本的には以上です。"}, {"type": "subtitle", "time": 5528.55, "timestamp": "01:32:08", "text": "こんにちは。"}, {"type": "subtitle", "time": 5531.27, "timestamp": "01:32:11", "text": "ええ、私はあなたの"}, {"type": "subtitle", "time": 5534.55, "timestamp": "01:32:14", "text": "アイドルクラブのいわば大使みたいなものです。 あなたにも"}, {"type": "subtitle", "time": 5536.709, "timestamp": "01:32:16", "text": "参加してもらおうと思っていたのですが、"}, {"type": "subtitle", "time": 5539.189, "timestamp": "01:32:19", "text": "6月にコラボレーションしていたことを思い出しました。もしあなたが"}, {"type": "subtitle", "time": 5541.27, "timestamp": "01:32:21", "text": "参加しないなら、あなたは… それは"}, {"type": "subtitle", "time": 5544.39, "timestamp": "01:32:24", "text": "大変な作業になるでしょう。"}, {"type": "subtitle", "time": 5544.709, "timestamp": "01:32:24", "text": "うん。"}, {"type": "subtitle", "time": 5546.47, "timestamp": "01:32:26", "text": "どれ？"}, {"type": "subtitle", "time": 5548.39, "timestamp": "01:32:28", "text": "あなたのアイドル。 基本的には、"}, {"type": "subtitle", "time": 5550.95, "timestamp": "01:32:30", "text": "コーラス部分のみです。"}, {"type": "subtitle", "time": 5560.55, "timestamp": "01:32:40", "text": "基本的には、ラテン語の部分と、私への祈り、そして観客の反応などの背景音があるだけです。"}, {"type": "subtitle", "time": 5563.03, "timestamp": "01:32:43", "text": "はい、以上です。 それで私は「"}, {"type": "subtitle", "time": 5566.47, "timestamp": "01:32:46", "text": "うん、これは本当に美しい6月の"}, {"type": "subtitle", "time": 5569.59, "timestamp": "01:32:49", "text": "コラボレーションだね」って思ったんです。 だから、チャットをスクロールすればわかるように、私はただ一言も言いませんでした"}, {"type": "subtitle", "time": 5573.83, "timestamp": "01:32:53", "text": "。"}, {"type": "subtitle", "time": 5575.43, "timestamp": "01:32:55", "text": "え、そうだったの？"}, {"type": "subtitle", "time": 5577.11, "timestamp": "01:32:57", "text": "ええ、メッセージを送りましたよ。 あなたは"}, {"type": "subtitle", "time": 5578.709, "timestamp": "01:32:58", "text": "それを全く読まないだけなんです。"}]
[{"type": "subtitle", "time": 5760.31, "timestamp": "01:36:00", "text": "こんにちは。 ああ、それはきっと。ありがとう。"}, {"type": "subtitle", "time": 5762.87, "timestamp": "01:36:02", "text": "素敵な夜をお過ごしください。 良い"}, {"type": "subtitle", "time": 5770.07, "timestamp": "01:36:10", "text": "うん、挨拶したら配信を止めるよ"}, {"type": "subtitle", "time": 5773.27, "timestamp": "01:36:13", "text": "。 私は"}, {"type": "subtitle", "time": 5776.709, "timestamp": "01:36:16", "text": "電話を切るつもりです。 いいえ、お気をつけて。 気をつけて"}, {"type": "subtitle", "time": 5778.95, "timestamp": "01:36:18", "text": "。"}, {"type": "subtitle", "time": 5786.39, "timestamp": "01:36:26", "text": "こんにちは。 あれは、あの"}, {"type": "subtitle", "time": 5788.95, "timestamp": "01:36:28", "text": "歌だった。"}, {"type": "subtitle", "time": 5792.149, "timestamp": "01:36:32", "text": "もし今日彼女との時間を楽しんだなら、"}, {"type": "subtitle", "time": 5794.79, "timestamp": "01:36:34", "text": "ぜひYouTubeで彼女をフォローしてください。 彼女は"}, {"type": "subtitle", "time": 5797.51, "timestamp": "01:36:37", "text": "YouTubeで配信をしている。 彼女のリンクは"}, {"type": "subtitle", "time": 5799.03, "timestamp": "01:36:39", "text": "説明欄にあります。"}, {"type": "subtitle", "time": 5800.55, "timestamp": "01:36:40", "text": "YouTubeで視聴している方、"}, {"type": "subtitle", "time": 5803.189, "timestamp": "01:36:43", "text": "KickやTwitchで視聴している方は、"}, {"type": "subtitle", "time": 5807.109, "timestamp": "01:36:47", "text": "固定コメントに記載されています。 もう一度、確認してみてください。"}, {"type": "subtitle", "time": 5809.189, "timestamp": "01:36:49", "text": "こんにちは。"}, {"type": "subtitle", "time": 5811.83, "timestamp": "01:36:51", "text": "そして、あの襲撃事件に返信できなくて申し訳ありませんでした"}, {"type": "subtitle", "time": 5817.59, "timestamp": "01:36:57", "text": "。 襲撃してくれてありがとう。 ディガト。"}]
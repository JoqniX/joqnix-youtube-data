[{"type": "subtitle", "time": 5042.31, "timestamp": "01:24:02", "text": "ええ、明日"}, {"type": "subtitle", "time": 5045.35, "timestamp": "01:24:05", "text": "基本的に午後3時にこの録音を手伝う予定です。"}, {"type": "subtitle", "time": 5052.39, "timestamp": "01:24:12", "text": "そして、他のコーラス歌手たちとの「マイアイドル」の練習は午後"}, {"type": "subtitle", "time": 5054.95, "timestamp": "01:24:14", "text": "8時からです。"}, {"type": "subtitle", "time": 5057.99, "timestamp": "01:24:17", "text": "だから、"}, {"type": "subtitle", "time": 5064.39, "timestamp": "01:24:24", "text": "こんにちは。 あ、待って。 明日は土曜日です。 いいえ、"}, {"type": "subtitle", "time": 5067.11, "timestamp": "01:24:27", "text": "コラボレーションの可能性があります。 ええ、明日の"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "土曜日です。 コラボは明日の午前10時、いや、たぶん6時半かな"}, {"type": "subtitle", "time": 5074.629, "timestamp": "01:24:34", "text": "。 だから、ええ、"}, {"type": "subtitle", "time": 5077.11, "timestamp": "01:24:37", "text": "待たなければならないでしょうね。  3時か"}, {"type": "subtitle", "time": 5079.669, "timestamp": "01:24:39", "text": "4時頃は空いていますか？"}, {"type": "subtitle", "time": 5082.95, "timestamp": "01:24:42", "text": "ええ、彼らはあなたと同じように、おそらく4時半くらい待たなければならなかったでしょう"}, {"type": "subtitle", "time": 5085.99, "timestamp": "01:24:45", "text": "。"}, {"type": "subtitle", "time": 5087.83, "timestamp": "01:24:47", "text": "うん。 ええ、もちろんです。 もちろん。 心配ない。"}, {"type": "subtitle", "time": 5089.27, "timestamp": "01:24:49", "text": "うん、"}, {"type": "subtitle", "time": 5091.51, "timestamp": "01:24:51", "text": "外に出なきゃいけないかもしれないけど、うん、"}, {"type": "subtitle", "time": 5093.99, "timestamp": "01:24:53", "text": "時間通りに着けるように努力するよ。 うん。 こんにちは。"}, {"type": "subtitle", "time": 5095.669, "timestamp": "01:24:55", "text": "時間内に間に合わなくても大丈夫です。   特に"}]
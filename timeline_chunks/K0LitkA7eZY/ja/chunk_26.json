[{"type": "subtitle", "time": 1560.549, "timestamp": "00:26:00", "text": "正しくありません。 その部分は、確かに部分ではあるのですが、"}, {"type": "subtitle", "time": 1563.75, "timestamp": "00:26:03", "text": "すごく速く進んで、"}, {"type": "subtitle", "time": 1565.83, "timestamp": "00:26:05", "text": "いきなり「いいえ」に飛んでしまうんです。だから"}, {"type": "subtitle", "time": 1568.71, "timestamp": "00:26:08", "text": "間違えたんだと思います。 あなたは歌っていましたね。"}, {"type": "subtitle", "time": 1570.39, "timestamp": "00:26:10", "text": "あ、"}, {"type": "subtitle", "time": 1571.669, "timestamp": "00:26:11", "text": "こんにちは。"}, {"type": "subtitle", "time": 1573.269, "timestamp": "00:26:13", "text": "ようこそ、"}, {"type": "subtitle", "time": 1576.07, "timestamp": "00:26:16", "text": "フランキー。 いらっしゃいませ。 いらっしゃいませ。 配信中にできますか"}, {"type": "subtitle", "time": 1579.51, "timestamp": "00:26:19", "text": "？ いいえ、私たちは学んでいる最中です。   他に"}, {"type": "subtitle", "time": 1582.549, "timestamp": "00:26:22", "text": "誰もいない。"}, {"type": "subtitle", "time": 1582.87, "timestamp": "00:26:22", "text": "こんにちは。"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "よし、次の行を歌おう。   わかった"}]
[{"type": "subtitle", "time": 13204.15, "timestamp": "03:40:04", "text": "そしてこれをセトルスト有効にします。"}, {"type": "subtitle", "time": 13206.15, "timestamp": "03:40:06", "text": "絵文字って何？"}, {"type": "subtitle", "time": 13215.03, "timestamp": "03:40:15", "text": "ストリーム"}, {"type": "subtitle", "time": 13219.03, "timestamp": "03:40:19", "text": "曲名トピック絵文字絵文字絵文字は正しく使っていません。"}, {"type": "subtitle", "time": 13231.03, "timestamp": "03:40:31", "text": "セットが有効な場合は、ストリーム作者名を行います。トピックオーバーレイえっと、トピック"}, {"type": "subtitle", "time": 13235.19, "timestamp": "03:40:35", "text": "オーバーレイはセットリストオーバーレイ、"}, {"type": "subtitle", "time": 13238.71, "timestamp": "03:40:38", "text": "セットリストオーバーレイスタイルなし、"}, {"type": "subtitle", "time": 13242.309, "timestamp": "03:40:42", "text": "定義はわかりました。最後です。えっと、トピックタイトル"}, {"type": "subtitle", "time": 13245.83, "timestamp": "03:40:45", "text": "ドットテキストコンテンツ。わかりました。"}, {"type": "subtitle", "time": 13249.19, "timestamp": "03:40:49", "text": "トピックタイトル。ああ、わかりました。わかりました。曲名。"}, {"type": "subtitle", "time": 13251.269, "timestamp": "03:40:51", "text": "あの人。わかりました。わかりました。わかりました。"}, {"type": "subtitle", "time": 13255.59, "timestamp": "03:40:55", "text": "覚えてます。曲名。トピック"}]
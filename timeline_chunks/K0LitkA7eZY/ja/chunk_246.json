[{"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "ええと、ナガラのタイプで。"}, {"type": "subtitle", "time": 14772.71, "timestamp": "04:06:12", "text": "オーケー、もし働かなかったら、"}, {"type": "subtitle", "time": 14778.71, "timestamp": "04:06:18", "text": "今何をしているか知ってるか？"}, {"type": "subtitle", "time": 14791.75, "timestamp": "04:06:31", "text": "午前4時から午後12時まで、ライブストリーム"}, {"type": "subtitle", "time": 14798.79, "timestamp": "04:06:38", "text": "トピック、現在のストリーム"}, {"type": "subtitle", "time": 14800.95, "timestamp": "04:06:40", "text": "状態、下部のアクティビティ状態、"}, {"type": "subtitle", "time": 14804.389, "timestamp": "04:06:44", "text": "青色の3つすべてをやるのに、12時間以上、いや6時間か7時間か何かかかったんだ。なんてこった、"}, {"type": "subtitle", "time": 14808.71, "timestamp": "04:06:48", "text": "大変だったよ。正直、"}, {"type": "subtitle", "time": 14811.83, "timestamp": "04:06:51", "text": "チャドGPTがコードを間違えた回数は、"}, {"type": "subtitle", "time": 14815.189, "timestamp": "04:06:55", "text": "頭がパンパンだった"}, {"type": "subtitle", "time": 14817.349, "timestamp": "04:06:57", "text": "。  「ああ、もう"}]
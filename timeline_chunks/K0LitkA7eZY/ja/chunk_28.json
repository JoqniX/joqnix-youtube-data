[{"type": "subtitle", "time": 1689.83, "timestamp": "00:28:09", "text": "私のボーカルが入った音声を聴いて、一緒に歌ってみてください。   あまり"}, {"type": "subtitle", "time": 1692.549, "timestamp": "00:28:12", "text": "速すぎないといいのですが。 私は間違いなく、"}, {"type": "subtitle", "time": 1697.75, "timestamp": "00:28:17", "text": "あなたがもっと小さい顔の"}, {"type": "subtitle", "time": 1710.149, "timestamp": "00:28:30", "text": "悪くはないだろう。   そうそう"}, {"type": "subtitle", "time": 1712.23, "timestamp": "00:28:32", "text": "。 最初から。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "最初から。 わかった。 最初から歌い直して、"}, {"type": "subtitle", "time": 1719.269, "timestamp": "00:28:39", "text": "あなたのガイドボーカルに合わせて歌った方がいいでしょうか？ わかった。 よし"}]
[{"type": "subtitle", "time": 7325.27, "timestamp": "02:02:05", "text": "ゆっくりしたバージョンで歌わないといけないんだよ"}, {"type": "subtitle", "time": 7330.149, "timestamp": "02:02:10", "text": "ね？ 私には速すぎる。  S"}, {"type": "subtitle", "time": 7332.229, "timestamp": "02:02:12", "text": "と私はページを縮小しないといけない。なぜなら、それは"}, {"type": "subtitle", "time": 7336.47, "timestamp": "02:02:16", "text": "大きな段落のページだからだ。なぜなら、それはカキカキスタンだからだ"}, {"type": "subtitle", "time": 7338.229, "timestamp": "02:02:18", "text": "。"}, {"type": "subtitle", "time": 7339.27, "timestamp": "02:02:19", "text": "もちろん、"}, {"type": "subtitle", "time": 7343.589, "timestamp": "02:02:23", "text": "教育的な側面もあるだろうが、そう、文字通りの意味でもある。"}, {"type": "subtitle", "time": 7361.35, "timestamp": "02:02:41", "text": "ええと、調整が必要だと思います。 ええ、"}, {"type": "subtitle", "time": 7363.83, "timestamp": "02:02:43", "text": "大丈夫です。 大丈夫です。 やりましょう。 たとえ"}, {"type": "subtitle", "time": 7365.75, "timestamp": "02:02:45", "text": "私が間違いを犯しても、それは構わない。 よし"}]
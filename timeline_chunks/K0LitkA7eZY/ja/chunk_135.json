[{"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "息子がどうやって私に歌を教えてくれたのかを学ばなければならない。"}, {"type": "subtitle", "time": 8107.03, "timestamp": "02:15:07", "text": "美しいドローンでしたよね？ 私も"}, {"type": "subtitle", "time": 8110.069, "timestamp": "02:15:10", "text": "同じ原則に従わなければならない。"}, {"type": "subtitle", "time": 8112.069, "timestamp": "02:15:12", "text": "この4行を"}, {"type": "subtitle", "time": 8115.91, "timestamp": "02:15:15", "text": "完璧に覚えるまで、あるいは少なくとも完璧に近いレベルになるまで、何度も何度も繰り返し練習しなければならない"}, {"type": "subtitle", "time": 8119.669, "timestamp": "02:15:19", "text": "。 右。 そうすれば、ちゃんと"}, {"type": "subtitle", "time": 8124.55, "timestamp": "02:15:24", "text": "正しくできるんです。 右。"}, {"type": "subtitle", "time": 8128.149, "timestamp": "02:15:28", "text": "5回、10回。 右。 こんにちは。   またやりますよ"}, {"type": "subtitle", "time": 8131.35, "timestamp": "02:15:31", "text": "。"}, {"type": "subtitle", "time": 8158.55, "timestamp": "02:15:58", "text": "停止。"}]
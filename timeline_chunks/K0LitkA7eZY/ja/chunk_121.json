[{"type": "subtitle", "time": 7291.75, "timestamp": "02:01:31", "text": "その曲が見つかりません。 何も表示されません。新しい順に表示されます。"}, {"type": "subtitle", "time": 7295.189, "timestamp": "02:01:35", "text": "それで、あなたはどこへ行ってしまったのですか？ 何てことだ"}, {"type": "subtitle", "time": 7297.27, "timestamp": "02:01:37", "text": "。"}, {"type": "subtitle", "time": 7304.39, "timestamp": "02:01:44", "text": "新曲を持っていたよ、兄弟。 何てことだ"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "。"}, {"type": "subtitle", "time": 7315.189, "timestamp": "02:01:55", "text": "よし、やってみよう。 配信で配信しても問題ないと思います"}, {"type": "subtitle", "time": 7318.149, "timestamp": "02:01:58", "text": "。"}]
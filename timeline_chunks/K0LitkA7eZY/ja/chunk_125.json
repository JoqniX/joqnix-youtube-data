[{"type": "subtitle", "time": 7500.47, "timestamp": "02:05:00", "text": "私はそれを診療に取り入れませんでした。"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "咳止めカバーを確認させてください。"}, {"type": "subtitle", "time": 7510.47, "timestamp": "02:05:10", "text": "彼女はもしかしたら、もっと良い状態で過ごしているのかもしれない。   より良いというより、もっと"}, {"type": "subtitle", "time": 7514.87, "timestamp": "02:05:14", "text": "。"}, {"type": "subtitle", "time": 7517.99, "timestamp": "02:05:17", "text": "これを試してみましょう。 えっと、さっき"}, {"type": "subtitle", "time": 7520.55, "timestamp": "02:05:20", "text": "これを見たんです。 どこへ行っていたの"}, {"type": "subtitle", "time": 7531.109, "timestamp": "02:05:31", "text": "はい、わかりました。 すべてを包み込む夏。   わかった"}, {"type": "subtitle", "time": 7540.39, "timestamp": "02:05:40", "text": "これは違う。 ああ、彼女はそれをたるませなかった。   必ず"}, {"type": "subtitle", "time": 7542.95, "timestamp": "02:05:42", "text": "一つはあるはずだ。"}, {"type": "subtitle", "time": 7559.27, "timestamp": "02:05:59", "text": "いや、それは別のバージョンだと思う。"}]
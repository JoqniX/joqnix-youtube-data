[{"type": "subtitle", "time": 4770.79, "timestamp": "01:19:30", "text": "私は2回目で間違いを犯したと言いました。"}, {"type": "subtitle", "time": 4775.51, "timestamp": "01:19:35", "text": "彼はただ立ち止まって、"}, {"type": "subtitle", "time": 4778.31, "timestamp": "01:19:38", "text": "それで。"}, {"type": "subtitle", "time": 4781.03, "timestamp": "01:19:41", "text": "よし、もう一度。"}, {"type": "subtitle", "time": 4784.55, "timestamp": "01:19:44", "text": "彼は基本的にギムが好きだったに違いない。"}, {"type": "subtitle", "time": 4785.11, "timestamp": "01:19:45", "text": "うん。"}, {"type": "subtitle", "time": 4787.11, "timestamp": "01:19:47", "text": "ガンがまた来た。"}, {"type": "subtitle", "time": 4790.07, "timestamp": "01:19:50", "text": "ええ、そう発音すると思いますよ。"}, {"type": "subtitle", "time": 4792.709, "timestamp": "01:19:52", "text": "少なくとも私は覚えていないと思う。"}, {"type": "subtitle", "time": 4792.87, "timestamp": "01:19:52", "text": "私が"}, {"type": "subtitle", "time": 4794.39, "timestamp": "01:19:54", "text": "間違っているかもしれない。"}, {"type": "subtitle", "time": 4797.75, "timestamp": "01:19:57", "text": "うん。 あと2回。   よし"}]
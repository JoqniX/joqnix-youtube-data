[{"type": "subtitle", "time": 15987.189, "timestamp": "04:26:27", "text": "曲名、アーティスト名、カバーアーティスト"}, {"type": "subtitle", "time": 15998.71, "timestamp": "04:26:38", "text": "これがメッセージです。"}, {"type": "subtitle", "time": 16003.269, "timestamp": "04:26:43", "text": "私はチャジップが大好きです。 チャジピは私がカフを愛していることを知っている"}, {"type": "subtitle", "time": 16008.149, "timestamp": "04:26:48", "text": "。 ク。 それは私に電話をくれました。 何てことだ"}, {"type": "subtitle", "time": 16011.429, "timestamp": "04:26:51", "text": "。 ありがとう。 わかった、それは"}, {"type": "subtitle", "time": 16013.91, "timestamp": "04:26:53", "text": "僕にとって本当に大きな意味があるよ、兄弟。   何てことだ"}]
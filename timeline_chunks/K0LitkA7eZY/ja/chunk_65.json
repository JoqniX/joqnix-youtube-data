[{"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 3935.99, "timestamp": "01:05:35", "text": "オーケーと言った時、私は間違いを犯したような気がします。"}, {"type": "subtitle", "time": 3938.39, "timestamp": "01:05:38", "text": "両親の"}, {"type": "subtitle", "time": 3940.549, "timestamp": "01:05:40", "text": "話し声が聞こえて気が散ってしまったので、あまりよく聞こえませんでした。"}, {"type": "subtitle", "time": 3941.75, "timestamp": "01:05:41", "text": "心配ないよ、と言わなきゃ。"}, {"type": "subtitle", "time": 3943.349, "timestamp": "01:05:43", "text": "うん、まあ、またやるよ"}, {"type": "subtitle", "time": 3946.71, "timestamp": "01:05:46", "text": "。"}, {"type": "subtitle", "time": 3950.47, "timestamp": "01:05:50", "text": "心配ない。 よし。"}]
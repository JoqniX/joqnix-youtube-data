[{"type": "subtitle", "time": 5294.229, "timestamp": "01:28:14", "text": "ああ、神様。"}, {"type": "subtitle", "time": 5296.47, "timestamp": "01:28:16", "text": "とても良いです。 あなたは"}, {"type": "subtitle", "time": 5298.229, "timestamp": "01:28:18", "text": "歌の中で本当に上手に歌っていますね。"}, {"type": "subtitle", "time": 5300.629, "timestamp": "01:28:20", "text": "うん、すごくかわいいね。   私はそれを、何ていうか、よくわからないような感じでやったんです"}, {"type": "subtitle", "time": 5302.79, "timestamp": "01:28:22", "text": "。"}, {"type": "subtitle", "time": 5305.75, "timestamp": "01:28:25", "text": "うん。 ほぼ正解です。 つまり、"}, {"type": "subtitle", "time": 5311.75, "timestamp": "01:28:31", "text": "歌詞を忘れてしまった部分もあるけど、そういうことだよね。 うん。"}, {"type": "subtitle", "time": 5313.84, "timestamp": "01:28:33", "text": "うん。 うん、この部分は言い方を忘れちゃった"}, {"type": "subtitle", "time": 5316.88, "timestamp": "01:28:36", "text": "うん、この部分は言い方を忘れちゃった けど、うん、"}, {"type": "subtitle", "time": 5327.11, "timestamp": "01:28:47", "text": "ジェンセンがまたあのショーを見せてくれる。"}, {"type": "subtitle", "time": 5330.47, "timestamp": "01:28:50", "text": "正しく発音する必要があると思う"}, {"type": "subtitle", "time": 5332.629, "timestamp": "01:28:52", "text": "けど、残りの"}, {"type": "subtitle", "time": 5336.629, "timestamp": "01:28:56", "text": "部分は大丈夫だと思う。もっと練習が必要だと思う。"}, {"type": "subtitle", "time": 5339.27, "timestamp": "01:28:59", "text": "私はその曲を録音しようと試みます。"}]
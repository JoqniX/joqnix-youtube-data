[{"type": "subtitle", "time": 4200.87, "timestamp": "01:10:00", "text": "ちょっと日本語を勉強していただけで忙しかったんです。"}, {"type": "subtitle", "time": 4204.149, "timestamp": "01:10:04", "text": "あ、ちょっと待って、学習にはどの本を使ってるの"}, {"type": "subtitle", "time": 4204.55, "timestamp": "01:10:04", "text": "？"}, {"type": "subtitle", "time": 4207.91, "timestamp": "01:10:07", "text": "ああ、そうですね、"}, {"type": "subtitle", "time": 4211.27, "timestamp": "01:10:11", "text": "基本的にはオンラインで見つけられる無料のリソースを利用しています。"}, {"type": "subtitle", "time": 4213.59, "timestamp": "01:10:13", "text": "ああ。"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "そうそう。  iPad"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "ペンを手に入れたおかげで、"}, {"type": "subtitle", "time": 4220.95, "timestamp": "01:10:20", "text": "車のイラスト制作がかなり進歩しました。   だから"}, {"type": "subtitle", "time": 4224.63, "timestamp": "01:10:24", "text": "サムネイルが表示されるのです。"}, {"type": "subtitle", "time": 4225.669, "timestamp": "01:10:25", "text": "うん。"}, {"type": "subtitle", "time": 4234.79, "timestamp": "01:10:34", "text": "好きなので、かなり早く進歩しました。 本当に"}, {"type": "subtitle", "time": 4237.83, "timestamp": "01:10:37", "text": "速く、近く、"}, {"type": "subtitle", "time": 4241.11, "timestamp": "01:10:41", "text": "PSF でやったのがすごく好きだった。それから、"}, {"type": "subtitle", "time": 4244.149, "timestamp": "01:10:44", "text": "漢字を書いてみたのも好きだった。kanji.sh というウェブサイトがあって、そこから"}, {"type": "subtitle", "time": 4250.39, "timestamp": "01:10:50", "text": "ワークシートをダウンロードして、漢字を書くことができるんだ。"}, {"type": "subtitle", "time": 4255.669, "timestamp": "01:10:55", "text": "スポンサー付きじゃないけど、"}, {"type": "subtitle", "time": 4258.149, "timestamp": "01:10:58", "text": "そこからワークシートをダウンロードして、"}]
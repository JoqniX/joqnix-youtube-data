[{"type": "subtitle", "time": 1261.59, "timestamp": "00:21:01", "text": "部分、その部分です。   まさにうってつけの"}, {"type": "subtitle", "time": 1263.11, "timestamp": "00:21:03", "text": "役柄だ。 わかった。"}, {"type": "subtitle", "time": 1266.789, "timestamp": "00:21:06", "text": "うん。 下線を引いてください。"}, {"type": "subtitle", "time": 1269.27, "timestamp": "00:21:09", "text": "ああ、下線を引いてください。 わかった。 待って。 わかった。"}, {"type": "subtitle", "time": 1272.47, "timestamp": "00:21:12", "text": "長くなりそうだ。 わかった。   それでは、"}, {"type": "subtitle", "time": 1275.83, "timestamp": "00:21:15", "text": "次の部分から始めましょう。"}, {"type": "subtitle", "time": 1294.39, "timestamp": "00:21:34", "text": "ああ、そうする必要はありませんでした。"}, {"type": "subtitle", "time": 1314.549, "timestamp": "00:21:54", "text": "それは音のようなものだ。 そうではないけど、いや、違う"}, {"type": "subtitle", "time": 1316.95, "timestamp": "00:21:56", "text": "。"}]
[{"type": "subtitle", "time": 5100.629, "timestamp": "01:25:00", "text": "問題がなければ、別の日にすればいいでしょう。 うん。"}, {"type": "subtitle", "time": 5106.47, "timestamp": "01:25:06", "text": "曲の完成に一歩近づきました。"}, {"type": "subtitle", "time": 5109.99, "timestamp": "01:25:09", "text": "うん。 残りはあと数行だけです。"}, {"type": "subtitle", "time": 5121.27, "timestamp": "01:25:21", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 5123.43, "timestamp": "01:25:23", "text": "両方の部分を練習してください。"}, {"type": "subtitle", "time": 5126.31, "timestamp": "01:25:26", "text": "はい。 うん。 うん。"}, {"type": "subtitle", "time": 5128.629, "timestamp": "01:25:28", "text": "うん。 さよなら。   わかった"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "。 他に何か"}, {"type": "subtitle", "time": 5133.669, "timestamp": "01:25:33", "text": "質問はありますか？   特に何もない"}, {"type": "subtitle", "time": 5136.07, "timestamp": "01:25:36", "text": "。 あなたは私にあの"}, {"type": "subtitle", "time": 5138.07, "timestamp": "01:25:38", "text": "リムソングを歌ってほしかったんですよね。"}, {"type": "subtitle", "time": 5140.229, "timestamp": "01:25:40", "text": "うん。 リムソング。 うん。 うん。 はい。   わかった"}, {"type": "subtitle", "time": 5142.31, "timestamp": "01:25:42", "text": "。 待って。 私にやらせてください。  1"}, {"type": "subtitle", "time": 5144.39, "timestamp": "01:25:44", "text": "秒だけ。"}, {"type": "subtitle", "time": 5154.149, "timestamp": "01:25:54", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 5155.189, "timestamp": "01:25:55", "text": "できれば。"}, {"type": "subtitle", "time": 5157.35, "timestamp": "01:25:57", "text": "こんにちは。 こんにちは。 うん。 うん。 覚えているような気がする"}, {"type": "subtitle", "time": 5157.91, "timestamp": "01:25:57", "text": "。   あれじゃ"}]
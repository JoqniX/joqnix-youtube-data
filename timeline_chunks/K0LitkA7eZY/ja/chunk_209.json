[{"type": "subtitle", "time": 12542.87, "timestamp": "03:29:02", "text": "その他。いいえ。ストリーム"}, {"type": "subtitle", "time": 12546.469, "timestamp": "03:29:06", "text": "ウィジェット。次のアクティビティオーバーレイ。それで、"}, {"type": "subtitle", "time": 12548.95, "timestamp": "03:29:08", "text": "私のアイデアは、"}, {"type": "subtitle", "time": 12550.71, "timestamp": "03:29:10", "text": "ああ、"}, {"type": "subtitle", "time": 12553.91, "timestamp": "03:29:13", "text": "これに取り組まなければなりません。 ああ、神様。わかりました。"}, {"type": "subtitle", "time": 12557.349, "timestamp": "03:29:17", "text": "ストリームトピックステータスですよね？"}, {"type": "subtitle", "time": 12565.269, "timestamp": "03:29:25", "text": "はい。こんな感じです。そして"}, {"type": "subtitle", "time": 12567.59, "timestamp": "03:29:27", "text": "コードはそのままにしておきます。えっと、コードに取り掛かるべきでしょうか"}, {"type": "subtitle", "time": 12569.91, "timestamp": "03:29:29", "text": "？わかりません。"}, {"type": "subtitle", "time": 12573.91, "timestamp": "03:29:33", "text": "今はコードを非表示にしておきます。実際のものに取り掛かります。"}, {"type": "subtitle", "time": 12586.229, "timestamp": "03:29:46", "text": "セット、歌のセット、セットリストステータスの"}, {"type": "subtitle", "time": 12589.03, "timestamp": "03:29:49", "text": "オーバーレイテキストレイヤーになります。あ、待って、待って、"}, {"type": "subtitle", "time": 12590.71, "timestamp": "03:29:50", "text": "待って。これに取り掛からないといけないんですよね"}, {"type": "subtitle", "time": 12594.07, "timestamp": "03:29:54", "text": "？わかりました。待って。えっと、"}]
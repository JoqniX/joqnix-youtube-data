[{"type": "subtitle", "time": 530.07, "timestamp": "00:08:50", "text": "完璧だ。 完璧だった。 私の声は"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "間違いなく「うん」です。   わかった"}, {"type": "subtitle", "time": 537.11, "timestamp": "00:08:57", "text": "。 それは、ええと、ガイダンス"}, {"type": "subtitle", "time": 539.03, "timestamp": "00:08:59", "text": "トラックなしでの話です。 私はただインストゥルメンタルを演奏して、タイミングを合わせようとしただけです"}]
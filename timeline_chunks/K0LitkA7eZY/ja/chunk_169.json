[{"type": "subtitle", "time": 10140.389, "timestamp": "02:49:00", "text": "生放送はたった2時間48分だけだから"}, {"type": "subtitle", "time": 10144.55, "timestamp": "02:49:04", "text": "ね？ たった2時間。 短すぎる。"}, {"type": "subtitle", "time": 10147.75, "timestamp": "02:49:07", "text": "私は24時間ストリーミング配信に慣れています。"}, {"type": "subtitle", "time": 10154.469, "timestamp": "02:49:14", "text": "でも、あなたはどう思いますか？ いいと思いませんか"}, {"type": "subtitle", "time": 10155.99, "timestamp": "02:49:15", "text": "？   えっと、何か作ってみようかな"}, {"type": "subtitle", "time": 10164.469, "timestamp": "02:49:24", "text": "。 わかった。 えっと、"}, {"type": "subtitle", "time": 10167.83, "timestamp": "02:49:27", "text": "犬がまるで"}, {"type": "subtitle", "time": 10170.469, "timestamp": "02:49:30", "text": "世界が終わるかのように吠えてるよ。"}, {"type": "subtitle", "time": 10173.51, "timestamp": "02:49:33", "text": "私はあの犬が理解できない。   わかった"}]
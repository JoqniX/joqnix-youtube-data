[{"type": "subtitle", "time": 3242.23, "timestamp": "00:54:02", "text": "Karto に教えているときにノイズ コンプレッサーを使っていたんですが、もちろん"}, {"type": "subtitle", "time": 3245.91, "timestamp": "00:54:05", "text": "背景にノイズがたくさんあったので、使わざるを得なかったんです。それで、"}, {"type": "subtitle", "time": 3248.309, "timestamp": "00:54:08", "text": "10 分後には途切れてしまいました"}, {"type": "subtitle", "time": 3250.069, "timestamp": "00:54:10", "text": "。"}, {"type": "subtitle", "time": 3251.67, "timestamp": "00:54:11", "text": "だから、ライブ配信はたった"}, {"type": "subtitle", "time": 3269.19, "timestamp": "00:54:29", "text": "。   わかった"}]
[{"type": "subtitle", "time": 6123.03, "timestamp": "01:42:03", "text": "トラックは存在しないということです。 著作権侵害の警告を受けるだろう。 えっと、"}, {"type": "subtitle", "time": 6125.27, "timestamp": "01:42:05", "text": "音楽ありとなしでやるべきかな？ わからない"}, {"type": "subtitle", "time": 6128.47, "timestamp": "01:42:08", "text": "。 ああ、"}, {"type": "subtitle", "time": 6137.59, "timestamp": "01:42:17", "text": "、最初の曲は、"}, {"type": "subtitle", "time": 6140.629, "timestamp": "01:42:20", "text": "さっき歌っていた曲です。"}, {"type": "subtitle", "time": 6144.629, "timestamp": "01:42:24", "text": "リム・ハクはリムによって計画された肉食動物です"}, {"type": "subtitle", "time": 6146.709, "timestamp": "01:42:26", "text": "。   1つ目"}, {"type": "subtitle", "time": 6149.51, "timestamp": "01:42:29", "text": "。 そうしましょう。"}]
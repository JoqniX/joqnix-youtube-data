[{"type": "subtitle", "time": 11853.19, "timestamp": "03:17:33", "text": "これです。 これです。 そして、そこに置いてください"}, {"type": "subtitle", "time": 11857.03, "timestamp": "03:17:37", "text": "。 そしてペイロード。 ペイロードは"}, {"type": "subtitle", "time": 11859.67, "timestamp": "03:17:39", "text": "これらになります。 つまり、曲名、"}, {"type": "subtitle", "time": 11862.55, "timestamp": "03:17:42", "text": "アーティスト名、ペイロード、アーティスト、カバー、"}, {"type": "subtitle", "time": 11866.229, "timestamp": "03:17:46", "text": "サービス、すべて入手できたということです。 じゃあ、この人の真似をすれば"}]
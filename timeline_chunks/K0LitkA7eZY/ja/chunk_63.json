[{"type": "subtitle", "time": 3781.91, "timestamp": "01:03:01", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "そして次は、基本的には、私が"}, {"type": "subtitle", "time": 3793.27, "timestamp": "01:03:13", "text": "完璧だった。"}, {"type": "subtitle", "time": 3812.71, "timestamp": "01:03:32", "text": "知ってるでしょ、私はフォローしてるの。この"}, {"type": "subtitle", "time": 3819.91, "timestamp": "01:03:39", "text": "私はただ、とても優しいだけなんです。 そう思います。 そうですね"}, {"type": "subtitle", "time": 3823.589, "timestamp": "01:03:43", "text": "。 うん。 あなたは"}, {"type": "subtitle", "time": 3826.39, "timestamp": "01:03:46", "text": "彼女の美しい曲を送ってくれたんですよね？"}, {"type": "subtitle", "time": 3828.15, "timestamp": "01:03:48", "text": "うん。 うん。 うん。 うん。 私は"}, {"type": "subtitle", "time": 3831.27, "timestamp": "01:03:51", "text": "彼女の後をつけてみました。 それでよかった。   そうそう"}, {"type": "subtitle", "time": 3834.15, "timestamp": "01:03:54", "text": "。 彼女のチャンネルを購読していたのですが、しばらくすると"}, {"type": "subtitle", "time": 3836.309, "timestamp": "01:03:56", "text": "名前をすっかり忘れてしまいました"}, {"type": "subtitle", "time": 3838.789, "timestamp": "01:03:58", "text": "。"}]
[{"type": "subtitle", "time": 13344.55, "timestamp": "03:42:24", "text": "これをやらなきゃ。カバー名。カバー"}, {"type": "subtitle", "time": 13356.87, "timestamp": "03:42:36", "text": "失敗するのを見てください。よし。ひどく失敗するのを見てください"}, {"type": "subtitle", "time": 13359.19, "timestamp": "03:42:39", "text": "。"}, {"type": "subtitle", "time": 13360.79, "timestamp": "03:42:40", "text": "えーっと、"}, {"type": "subtitle", "time": 13364.55, "timestamp": "03:42:44", "text": "この人もコピーしないといけない。次に、"}, {"type": "subtitle", "time": 13372.55, "timestamp": "03:42:52", "text": "えーっと、"}, {"type": "subtitle", "time": 13375.83, "timestamp": "03:42:55", "text": "オーバーレイの人は"}]
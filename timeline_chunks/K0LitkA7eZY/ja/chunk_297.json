[{"type": "subtitle", "time": 17847.59, "timestamp": "04:57:27", "text": "カキの歌にはたくさんの感情を込める必要があるんだろうね。 カキイカキの歌は"}, {"type": "subtitle", "time": 17849.67, "timestamp": "04:57:29", "text": "感情がたっぷり込められている。 まるで"}, {"type": "subtitle", "time": 17852.708, "timestamp": "04:57:32", "text": "感情のジェットコースターのような日記、独白、歌、"}, {"type": "subtitle", "time": 17857.67, "timestamp": "04:57:37", "text": "歌詞といった感じでしょうか。   まずは、"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "正しく歌う方法を学ぶことから始めます。  2番と3番の歌詞が今のところ"}]
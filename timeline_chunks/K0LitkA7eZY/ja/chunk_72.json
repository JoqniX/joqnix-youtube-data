[{"type": "subtitle", "time": 4322.229, "timestamp": "01:12:02", "text": "その中にPDFファイルなどを表示できるようなタブが欲しかったんです。そういうことを考えていました。"}, {"type": "subtitle", "time": 4327.669, "timestamp": "01:12:07", "text": "ああ、"}, {"type": "subtitle", "time": 4329.03, "timestamp": "01:12:09", "text": "これは一体何だ？"}, {"type": "subtitle", "time": 4330.709, "timestamp": "01:12:10", "text": "それは鏡と呼ばれています。 これは、私の"}, {"type": "subtitle", "time": 4333.03, "timestamp": "01:12:13", "text": "先生、つまり日本語の先生がよく"}, {"type": "subtitle", "time": 4336.31, "timestamp": "01:12:16", "text": "私に教えてくれたことです。"}, {"type": "subtitle", "time": 4339.35, "timestamp": "01:12:19", "text": "ああ、なんてことだ。   それは"}, {"type": "subtitle", "time": 4343.27, "timestamp": "01:12:23", "text": "何かだった。"}, {"type": "subtitle", "time": 4345.669, "timestamp": "01:12:25", "text": "うん。 だから、それを追加して、えっと、ちょっと"}, {"type": "subtitle", "time": 4350.07, "timestamp": "01:12:30", "text": "待ってください。 読み込みが終わるまで待ちましょう。"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "ああ、そうですか"}, {"type": "subtitle", "time": 4353.669, "timestamp": "01:12:33", "text": "、新しいボードですね。 はい、"}, {"type": "subtitle", "time": 4356.63, "timestamp": "01:12:36", "text": "テキストを追加したり、絵を描いたりできます。 絵を描い"}, {"type": "subtitle", "time": 4358.709, "timestamp": "01:12:38", "text": "たり、文字を追加したりできます。 ええ、"}, {"type": "subtitle", "time": 4361.99, "timestamp": "01:12:41", "text": "20ページくらいのPDFファイルを追加して、"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "そこに書き込みができるようにしたいんです。 要するに、それが私の"}, {"type": "subtitle", "time": 4366.55, "timestamp": "01:12:46", "text": "望みです。   そうそう"}, {"type": "subtitle", "time": 4368.79, "timestamp": "01:12:48", "text": "。 文書を作成したり、"}, {"type": "subtitle", "time": 4369.75, "timestamp": "01:12:49", "text": "いろいろなことができます。"}, {"type": "subtitle", "time": 4371.669, "timestamp": "01:12:51", "text": "どうやら"}, {"type": "subtitle", "time": 4374.39, "timestamp": "01:12:54", "text": "私は犬を飼っているらしい。 つまり、それは広大な"}, {"type": "subtitle", "time": 4376.87, "timestamp": "01:12:56", "text": "地域のようなものだ。 あ、待って。 え、今なんて言ったの？ああ、"}]
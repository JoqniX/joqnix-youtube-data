[{"type": "subtitle", "time": 5345.35, "timestamp": "01:29:05", "text": "録音を試みる機会があってもいいと思う。"}, {"type": "subtitle", "time": 5348.229, "timestamp": "01:29:08", "text": "こんにちは。 私が試してみます。 自分の歌声には恥ずかしさを感じる"}, {"type": "subtitle", "time": 5353.75, "timestamp": "01:29:13", "text": "タイミングが合えば、"}, {"type": "subtitle", "time": 5359.669, "timestamp": "01:29:19", "text": "あなたのためにいくつか作りますよ。 それがあなたへの私の約束です。"}, {"type": "subtitle", "time": 5361.43, "timestamp": "01:29:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 5361.91, "timestamp": "01:29:21", "text": "ありがとう。"}, {"type": "subtitle", "time": 5367.75, "timestamp": "01:29:27", "text": "うん。 ええ、そうですね。 計画してから、"}, {"type": "subtitle", "time": 5370.07, "timestamp": "01:29:30", "text": "すみません、この３曲は"}, {"type": "subtitle", "time": 5376.55, "timestamp": "01:29:36", "text": "練習する必要があるのです"}, {"type": "subtitle", "time": 5378.79, "timestamp": "01:29:38", "text": "が、Carousを聴いてからずいぶん経ちました。"}, {"type": "subtitle", "time": 5384.629, "timestamp": "01:29:44", "text": "とても良い曲で、とても気に入りました。"}, {"type": "subtitle", "time": 5390.149, "timestamp": "01:29:50", "text": "あなたが歌っていたのを覚えているので、歌ってもらうように頼むべきだと思いました。"}, {"type": "subtitle", "time": 5395.59, "timestamp": "01:29:55", "text": "ああ、そのストリームを覚えています。 あなたが"}, {"type": "subtitle", "time": 5397.59, "timestamp": "01:29:57", "text": "インスタグラムに来てくれましたよね、確かあの"}, {"type": "subtitle", "time": 5399.35, "timestamp": "01:29:59", "text": "日だったと思います。"}]
[{"type": "subtitle", "time": 14305.03, "timestamp": "03:58:25", "text": "ああ、本当にラグがひどい。"}, {"type": "subtitle", "time": 14313.429, "timestamp": "03:58:33", "text": "貼り付けて、"}, {"type": "subtitle", "time": 14320.389, "timestamp": "03:58:40", "text": "さあ、ゲットしてください。私の場合はうまくいっています。"}, {"type": "subtitle", "time": 14336.55, "timestamp": "03:58:56", "text": "コンソールログにテキストタイトルが定義されていませんが、スケジュールにこれらのいずれかが欠けている場合は、曲のタイトルが"}, {"type": "subtitle", "time": 14338.71, "timestamp": "03:58:58", "text": "宣言されていません"}]
[{"type": "subtitle", "time": 10802.15, "timestamp": "03:00:02", "text": "。 不器用な男。 カキ。 えっと、これ。   わかった"}, {"type": "subtitle", "time": 10804.63, "timestamp": "03:00:04", "text": "。 曲名、作者名、"}, {"type": "subtitle", "time": 10807.75, "timestamp": "03:00:07", "text": "カバーアーティスト名。 基本的に、"}, {"type": "subtitle", "time": 10810.79, "timestamp": "03:00:10", "text": "必要なものは全て揃った。   ええと"}, {"type": "subtitle", "time": 10822.95, "timestamp": "03:00:22", "text": "、基本的には必要なものは全て揃いました。"}, {"type": "subtitle", "time": 10829.83, "timestamp": "03:00:29", "text": "でも待って、次はダークなセットリストになるのかという疑問が出てくる。"}, {"type": "subtitle", "time": 10858.63, "timestamp": "03:00:58", "text": "大変だ"}]
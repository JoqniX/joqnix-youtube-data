[{"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "ああ、そうそう、"}, {"type": "subtitle", "time": 7151.589, "timestamp": "01:59:11", "text": "最近練習してた難しい曲だよ。 右。 待って。"}, {"type": "subtitle", "time": 7163.189, "timestamp": "01:59:23", "text": "えっと、"}, {"type": "subtitle", "time": 7177.589, "timestamp": "01:59:37", "text": "ぜひお越しください。 それは彼女が最近"}, {"type": "subtitle", "time": 7180.149, "timestamp": "01:59:40", "text": "カバーしたハラン誌の記事だった。"}]
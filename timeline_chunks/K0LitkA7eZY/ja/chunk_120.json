[{"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "？それはどこにありますか？ ここにあるのを覚えている。 どこにいるの"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "ああ、"}, {"type": "subtitle", "time": 7224.31, "timestamp": "02:00:24", "text": "あなたがここにいるのは知っていますよ。 どこへ行っていたの"}, {"type": "subtitle", "time": 7228.07, "timestamp": "02:00:28", "text": "？ 図書館の"}, {"type": "subtitle", "time": 7231.43, "timestamp": "02:00:31", "text": "歌。 イギリス人はたぶん"}, {"type": "subtitle", "time": 7234.229, "timestamp": "02:00:34", "text": "5番目か6番目でしょう、"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "待って、それはどこにあるの？ 見つかりません。"}, {"type": "subtitle", "time": 7257.99, "timestamp": "02:00:57", "text": "待って、君はどこにいるの？"}]
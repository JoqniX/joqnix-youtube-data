[{"type": "subtitle", "time": 10381.429, "timestamp": "02:53:01", "text": "、それを削除します。 だから、"}, {"type": "subtitle", "time": 10383.349, "timestamp": "02:53:03", "text": "私が歌を歌うときは、"}, {"type": "subtitle", "time": 10385.269, "timestamp": "02:53:05", "text": "Mel Studio を使っているので、"}, {"type": "subtitle", "time": 10387.51, "timestamp": "02:53:07", "text": "もう OBS は使わないことにしたんです。 えっと、このリストを"}, {"type": "subtitle", "time": 10398.55, "timestamp": "02:53:18", "text": "ポップアップできないので、"}, {"type": "subtitle", "time": 10401.429, "timestamp": "02:53:21", "text": "これを使用できないし、"}, {"type": "subtitle", "time": 10404.71, "timestamp": "02:53:24", "text": "これを使用して更新することもできないので、代わりに"}, {"type": "subtitle", "time": 10407.349, "timestamp": "02:53:27", "text": "独自の HTML オーバーレイを使用することにします"}, {"type": "subtitle", "time": 10410.71, "timestamp": "02:53:30", "text": "。 うん。 だから、ここにデータベースみたいなものを作って、そこに"}, {"type": "subtitle", "time": 10413.91, "timestamp": "02:53:33", "text": "すべての"}, {"type": "subtitle", "time": 10416.469, "timestamp": "02:53:36", "text": "曲とかを載せようと思う。そうすれば、"}, {"type": "subtitle", "time": 10418.55, "timestamp": "02:53:38", "text": "表示方法も自分でコントロールできるからね。"}, {"type": "subtitle", "time": 10425.75, "timestamp": "02:53:45", "text": "配信トピックの下に載せようかと考えています。 つまり、"}, {"type": "subtitle", "time": 10428.63, "timestamp": "02:53:48", "text": "この辺りとか。 わからないけど、もしかしたら"}, {"type": "subtitle", "time": 10431.19, "timestamp": "02:53:51", "text": "良いものになるかもしれないし、"}, {"type": "subtitle", "time": 10436.63, "timestamp": "02:53:56", "text": "デモになるかもしれない。 ええ、試してみましょう。 だから私の考えは、"}, {"type": "subtitle", "time": 10439.67, "timestamp": "02:53:59", "text": "曲名を一番上に、"}]
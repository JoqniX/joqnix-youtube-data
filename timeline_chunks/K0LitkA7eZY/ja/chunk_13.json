[{"type": "subtitle", "time": 790.389, "timestamp": "00:13:10", "text": "彼らの髪を邪魔しないように"}, {"type": "subtitle", "time": 813.829, "timestamp": "00:13:33", "text": "うん。"}, {"type": "subtitle", "time": 818.55, "timestamp": "00:13:38", "text": "耳元で何か言っていたのですか？"}, {"type": "subtitle", "time": 820.389, "timestamp": "00:13:40", "text": "ええ、そうですね。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 822.87, "timestamp": "00:13:42", "text": "襲撃があったので、しばらくの間、音声をミュートにしました。"}, {"type": "subtitle", "time": 824.629, "timestamp": "00:13:44", "text": "あなたが"}, {"type": "subtitle", "time": 830.55, "timestamp": "00:13:50", "text": "大丈夫です。 大丈夫。 わかりました、では一行ずつ説明していきます"}, {"type": "subtitle", "time": 832.47, "timestamp": "00:13:52", "text": "。"}]
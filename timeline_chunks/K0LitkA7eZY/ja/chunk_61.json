[{"type": "subtitle", "time": 3666.069, "timestamp": "01:01:06", "text": "それでいい。 以前にもやったことがあるけど、何も起こらなかった"}, {"type": "subtitle", "time": 3667.99, "timestamp": "01:01:07", "text": "。 だから、おそらく"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "大丈夫だと思います。"}, {"type": "subtitle", "time": 3673.349, "timestamp": "01:01:13", "text": "それは相手次第だ。 でも、著作"}, {"type": "subtitle", "time": 3678.23, "timestamp": "01:01:18", "text": "権侵害の申し立てがある曲をライブストリーミングすることはお勧めしません"}, {"type": "subtitle", "time": 3680.23, "timestamp": "01:01:20", "text": "。   そうだな"}, {"type": "subtitle", "time": 3682.309, "timestamp": "01:01:22", "text": "、リスクを冒すべきではないな。 わかった。"}, {"type": "subtitle", "time": 3685.109, "timestamp": "01:01:25", "text": "ごめんね、みんな、それを聞きたいの？ こんにちは。"}, {"type": "subtitle", "time": 3693.91, "timestamp": "01:01:33", "text": "良い。 待って、まだだ。 三つ。"}]
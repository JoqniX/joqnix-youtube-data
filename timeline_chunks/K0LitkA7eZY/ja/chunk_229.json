[{"type": "subtitle", "time": 13743.189, "timestamp": "03:49:03", "text": "こんにちは セレスティア。ようこそ。ようこそ。ようこそ。こんにちは。"}, {"type": "subtitle", "time": 13749.91, "timestamp": "03:49:09", "text": "セレスティアは元気ですか？"}, {"type": "subtitle", "time": 13766.229, "timestamp": "03:49:26", "text": "えっと、タイトルテキストは何になりますか？"}, {"type": "subtitle", "time": 13787.91, "timestamp": "03:49:47", "text": "ドット、オーケー曲名、ええと、名前、"}, {"type": "subtitle", "time": 13792.63, "timestamp": "03:49:52", "text": "これが曲名になります。そして、"}, {"type": "subtitle", "time": 13797.51, "timestamp": "03:49:57", "text": "これはアーティスト名になります。アーティスト"}]
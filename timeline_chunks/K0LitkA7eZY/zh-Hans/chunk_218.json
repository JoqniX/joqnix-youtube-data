[{"type": "subtitle", "time": 13093.83, "timestamp": "03:38:13", "text": "添加这个标题，哦，还有"}, {"type": "subtitle", "time": 13098.309, "timestamp": "03:38:18", "text": "叠加层。我忘了叠加层。哦。哦。呃"}, {"type": "subtitle", "time": 13114.07, "timestamp": "03:38:34", "text": "，记住这个副本。"}, {"type": "subtitle", "time": 13116.07, "timestamp": "03:38:36", "text": "流。"}, {"type": "subtitle", "time": 13118.55, "timestamp": "03:38:38", "text": "流演唱。"}, {"type": "subtitle", "time": 13123.429, "timestamp": "03:38:43", "text": "等等。流歌单叠加层。"}, {"type": "subtitle", "time": 13125.349, "timestamp": "03:38:45", "text": "好的。不需要一直都写演唱"}, {"type": "subtitle", "time": 13130.71, "timestamp": "03:38:50", "text": "。所以，哦，天哪，这来了，哦，天哪，我"}, {"type": "subtitle", "time": 13133.75, "timestamp": "03:38:53", "text": "讨厌这个。"}, {"type": "subtitle", "time": 13137.51, "timestamp": "03:38:57", "text": "嗯嗯嗯，呃，哦，"}]
[{"type": "subtitle", "time": 6674.07, "timestamp": "01:51:14", "text": "你没听到。 我忘了静音。"}, {"type": "subtitle", "time": 6676.39, "timestamp": "01:51:16", "text": "我不想让我的Bish发出声音。 真"}, {"type": "subtitle", "time": 6679.35, "timestamp": "01:51:19", "text": "尴尬。"}, {"type": "subtitle", "time": 6681.43, "timestamp": "01:51:21", "text": "嗨，"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "下一个就是这个。 嗯，我按照"}, {"type": "subtitle", "time": 6688.149, "timestamp": "01:51:28", "text": "我在 Ableton Live 里的顺序来操作。"}, {"type": "subtitle", "time": 6690.47, "timestamp": "01:51:30", "text": "我刚换用Reaper了，兄弟。 因为我"}, {"type": "subtitle", "time": 6693.669, "timestamp": "01:51:33", "text": "没有，所以我"}, {"type": "subtitle", "time": 6696.629, "timestamp": "01:51:36", "text": "这个月付不起牌照费。 我正在考取"}, {"type": "subtitle", "time": 6699.51, "timestamp": "01:51:39", "text": "教育许可证，因为我之前"}, {"type": "subtitle", "time": 6702.87, "timestamp": "01:51:42", "text": "跟老师认真学习过 Ableton Live，"}, {"type": "subtitle", "time": 6706.47, "timestamp": "01:51:46", "text": "但是负担不起。 他们采用的是"}, {"type": "subtitle", "time": 6709.43, "timestamp": "01:51:49", "text": "付费租赁制度。 所以我每月要支付"}, {"type": "subtitle", "time": 6711.109, "timestamp": "01:51:51", "text": "31.7 美元"}, {"type": "subtitle", "time": 6715.589, "timestamp": "01:51:55", "text": "。 那相当于印度的2800卢比。   是的"}]
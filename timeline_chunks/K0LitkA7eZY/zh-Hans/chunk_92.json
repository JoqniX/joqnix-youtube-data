[{"type": "subtitle", "time": 5521.35, "timestamp": "01:32:01", "text": "业力对话写了一些歌词"}, {"type": "subtitle", "time": 5524.229, "timestamp": "01:32:04", "text": "。"}, {"type": "subtitle", "time": 5527.03, "timestamp": "01:32:07", "text": "基本上就这些了。"}, {"type": "subtitle", "time": 5528.55, "timestamp": "01:32:08", "text": "你好。"}, {"type": "subtitle", "time": 5531.27, "timestamp": "01:32:11", "text": "是的，我算是你们"}, {"type": "subtitle", "time": 5534.55, "timestamp": "01:32:14", "text": "偶像俱乐部的形象大使。 我本来想邀请你"}, {"type": "subtitle", "time": 5536.709, "timestamp": "01:32:16", "text": "也加入，但我记起我们"}, {"type": "subtitle", "time": 5539.189, "timestamp": "01:32:19", "text": "六月份要合作，如果"}, {"type": "subtitle", "time": 5541.27, "timestamp": "01:32:21", "text": "你不加入，那就……嗯。 你会觉得，"}, {"type": "subtitle", "time": 5544.39, "timestamp": "01:32:24", "text": "这会是一项艰巨的任务。   是的"}, {"type": "subtitle", "time": 5544.709, "timestamp": "01:32:24", "text": "。"}, {"type": "subtitle", "time": 5546.47, "timestamp": "01:32:26", "text": "哪一个？"}, {"type": "subtitle", "time": 5548.39, "timestamp": "01:32:28", "text": "你的偶像。 基本上，只有"}, {"type": "subtitle", "time": 5550.95, "timestamp": "01:32:30", "text": "副歌部分。 只有"}, {"type": "subtitle", "time": 5553.91, "timestamp": "01:32:33", "text": "拉丁语部分，"}, {"type": "subtitle", "time": 5555.91, "timestamp": "01:32:35", "text": "为我祈祷，还有一些"}, {"type": "subtitle", "time": 5558.39, "timestamp": "01:32:38", "text": "你必须模仿"}, {"type": "subtitle", "time": 5560.55, "timestamp": "01:32:40", "text": "观众背景噪音的部分。"}, {"type": "subtitle", "time": 5563.03, "timestamp": "01:32:43", "text": "嗯，就这些。 然后我就想，你明白了，是的"}, {"type": "subtitle", "time": 5566.47, "timestamp": "01:32:46", "text": "，这只是六月一次美好的"}, {"type": "subtitle", "time": 5569.59, "timestamp": "01:32:49", "text": "合作。 所以，我只是没有像"}, {"type": "subtitle", "time": 5572.31, "timestamp": "01:32:52", "text": "你浏览"}, {"type": "subtitle", "time": 5573.83, "timestamp": "01:32:53", "text": "聊天记录时那样说一句话。"}, {"type": "subtitle", "time": 5575.43, "timestamp": "01:32:55", "text": "哦，你真的这么做了？"}, {"type": "subtitle", "time": 5577.11, "timestamp": "01:32:57", "text": "是的，我发了条消息。 你只是从来"}, {"type": "subtitle", "time": 5578.709, "timestamp": "01:32:58", "text": "没读过而已。"}]
[{"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "它在哪儿？ 我记得它在这里。"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "呃，"}, {"type": "subtitle", "time": 7224.31, "timestamp": "02:00:24", "text": "我知道你在这里。 你"}, {"type": "subtitle", "time": 7228.07, "timestamp": "02:00:28", "text": "去了哪里？ 图书馆"}, {"type": "subtitle", "time": 7231.43, "timestamp": "02:00:31", "text": "歌曲。 英国人"}, {"type": "subtitle", "time": 7234.229, "timestamp": "02:00:34", "text": "应该是第五或第六个吧，"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "等等，它在哪儿？ 我找不到。"}, {"type": "subtitle", "time": 7257.99, "timestamp": "02:00:57", "text": "等等，你在哪里？"}]
[{"type": "subtitle", "time": 8280.15, "timestamp": "02:18:00", "text": "长大成人一样。 真是太"}, {"type": "subtitle", "time": 8282.79, "timestamp": "02:18:02", "text": "刺激了。 真的很"}, {"type": "subtitle", "time": 8286.15, "timestamp": "02:18:06", "text": "有趣。 令人兴奋。 是的。 惊人的。 是的。"}, {"type": "subtitle", "time": 8313.589, "timestamp": "02:18:33", "text": "哦，最后一行我居然写对了"}, {"type": "subtitle", "time": 8316.389, "timestamp": "02:18:36", "text": "。 第三行。 呃，第四行我"}, {"type": "subtitle", "time": 8317.99, "timestamp": "02:18:37", "text": "写错了。 第五行我做"}, {"type": "subtitle", "time": 8333.91, "timestamp": "02:18:53", "text": "即使我听不懂他们在"}, {"type": "subtitle", "time": 8336.549, "timestamp": "02:18:56", "text": "说什么，我也会尽力把它说"}]
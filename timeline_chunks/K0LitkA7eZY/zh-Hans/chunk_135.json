[{"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "学习一下那个儿子是怎么教我唱歌的。"}, {"type": "subtitle", "time": 8107.03, "timestamp": "02:15:07", "text": "那架无人机很漂亮，对吧？ 我也"}, {"type": "subtitle", "time": 8110.069, "timestamp": "02:15:10", "text": "必须遵循同样的原则。 我必须一遍又一遍地"}, {"type": "subtitle", "time": 8112.069, "timestamp": "02:15:12", "text": "练习这四行字，"}, {"type": "subtitle", "time": 8115.91, "timestamp": "02:15:15", "text": "直到我完全掌握，或者至少"}, {"type": "subtitle", "time": 8119.669, "timestamp": "02:15:19", "text": "接近完美。 正确的。 这样"}, {"type": "subtitle", "time": 8122.069, "timestamp": "02:15:22", "text": "我才能真正把它做好"}, {"type": "subtitle", "time": 8124.55, "timestamp": "02:15:24", "text": "。 正确的。"}, {"type": "subtitle", "time": 8128.149, "timestamp": "02:15:28", "text": "五次，十次。 正确的。 你好。"}, {"type": "subtitle", "time": 8131.35, "timestamp": "02:15:31", "text": "我们会再做一次。"}, {"type": "subtitle", "time": 8158.55, "timestamp": "02:15:58", "text": "停止。"}]
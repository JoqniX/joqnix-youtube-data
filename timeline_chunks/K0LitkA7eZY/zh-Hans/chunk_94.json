[{"type": "subtitle", "time": 5640.87, "timestamp": "01:34:00", "text": "主账号就是你认识的"}, {"type": "subtitle", "time": 5643.51, "timestamp": "01:34:03", "text": "那个账号，我的名字。"}, {"type": "subtitle", "time": 5646.229, "timestamp": "01:34:06", "text": "哦，你好。 你好。"}, {"type": "subtitle", "time": 5648.149, "timestamp": "01:34:08", "text": "呃，"}, {"type": "subtitle", "time": 5652.07, "timestamp": "01:34:12", "text": "我没看到。 我的天啊。   还好"}, {"type": "subtitle", "time": 5654.47, "timestamp": "01:34:14", "text": "。 我觉得"}, {"type": "subtitle", "time": 5656.07, "timestamp": "01:34:16", "text": "你最好别参加，因为我们"}, {"type": "subtitle", "time": 5658.149, "timestamp": "01:34:18", "text": "已经有合作项目了，而且你"}, {"type": "subtitle", "time": 5660.229, "timestamp": "01:34:20", "text": "还得为这个项目练习。"}, {"type": "subtitle", "time": 5661.59, "timestamp": "01:34:21", "text": "实践。 是的。"}, {"type": "subtitle", "time": 5664.149, "timestamp": "01:34:24", "text": "合作项目太多了。   是的"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "。 我已经看过"}, {"type": "subtitle", "time": 5668.709, "timestamp": "01:34:28", "text": "你发给我的封面了。"}, {"type": "subtitle", "time": 5672.31, "timestamp": "01:34:32", "text": "哦，是那个啊。 是的。 是的。 卡扎比。 啊。"}, {"type": "subtitle", "time": 5674.629, "timestamp": "01:34:34", "text": "因为正是这首翻唱让我"}, {"type": "subtitle", "time": 5677.35, "timestamp": "01:34:37", "text": "想到：“啊，嘿，你想让我教你"}, {"type": "subtitle", "time": 5679.91, "timestamp": "01:34:39", "text": "这首歌吗？” 然后他就说：“是啊。” 但是我们"}, {"type": "subtitle", "time": 5682.95, "timestamp": "01:34:42", "text": "始终没有完全"}, {"type": "subtitle", "time": 5685.35, "timestamp": "01:34:45", "text": "完成这首歌，因为很遗憾我们从来没有"}, {"type": "subtitle", "time": 5694.95, "timestamp": "01:34:54", "text": "所以，过去如此，现在我们也正"}, {"type": "subtitle", "time": 5697.03, "timestamp": "01:34:57", "text": "慢慢地做着。   是的"}, {"type": "subtitle", "time": 5699.27, "timestamp": "01:34:59", "text": "。"}]
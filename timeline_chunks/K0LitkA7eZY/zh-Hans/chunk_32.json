[{"type": "subtitle", "time": 1922.07, "timestamp": "00:32:02", "text": "哦，是那个。 这就是混合比例。"}, {"type": "subtitle", "time": 1925.35, "timestamp": "00:32:05", "text": "哦，好的。 我这里全部都是人声。"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "呃，好的。 我应该吗？"}, {"type": "subtitle", "time": 1934.789, "timestamp": "00:32:14", "text": "星星，那里的三颗星星。"}, {"type": "subtitle", "time": 1937.99, "timestamp": "00:32:17", "text": "哦，三星。 你好。"}, {"type": "subtitle", "time": 1943.509, "timestamp": "00:32:23", "text": "因为我没事。 所以，钻石。"}, {"type": "subtitle", "time": 1951.35, "timestamp": "00:32:31", "text": "好的。"}]
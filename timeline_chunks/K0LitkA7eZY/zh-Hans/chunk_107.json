[{"type": "subtitle", "time": 6429.189, "timestamp": "01:47:09", "text": "我"}, {"type": "subtitle", "time": 6444.31, "timestamp": "01:47:24", "text": "等一下。 我要唱这首歌。 我还有等。"}, {"type": "subtitle", "time": 6446.39, "timestamp": "01:47:26", "text": "也就是说，我得用一种慵懒的语气来唱。"}, {"type": "subtitle", "time": 6448.629, "timestamp": "01:47:28", "text": "等等，让我来做。 我正在努力跟上"}, {"type": "subtitle", "time": 6450.31, "timestamp": "01:47:30", "text": "歌手的节奏。 我把它"}, {"type": "subtitle", "time": 6452.39, "timestamp": "01:47:32", "text": "调高了。"}]
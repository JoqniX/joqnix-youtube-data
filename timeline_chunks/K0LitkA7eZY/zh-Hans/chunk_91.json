[{"type": "subtitle", "time": 5461.27, "timestamp": "01:31:01", "text": "睡了一觉，然后就醒了。"}, {"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "我想我晚饭没吃。 不，我吃过"}, {"type": "subtitle", "time": 5468.629, "timestamp": "01:31:08", "text": "晚饭了。 然后，直播结束后，我大概八点左右就睡了，"}, {"type": "subtitle", "time": 5473.189, "timestamp": "01:31:13", "text": "Twitch 直播间里也一直放着蛋糕。 我"}, {"type": "subtitle", "time": 5476.629, "timestamp": "01:31:16", "text": "凌晨三点左右醒了。然后我"}, {"type": "subtitle", "time": 5479.27, "timestamp": "01:31:19", "text": "意识到，糟了，我错过了"}, {"type": "subtitle", "time": 5481.99, "timestamp": "01:31:21", "text": "应该"}, {"type": "subtitle", "time": 5485.91, "timestamp": "01:31:25", "text": "在12点或者10​​点参加的会议。然后我说了声"}, {"type": "subtitle", "time": 5488.87, "timestamp": "01:31:28", "text": "对不起，然后我就醒了。 然后我听了"}, {"type": "subtitle", "time": 5491.669, "timestamp": "01:31:31", "text": "音乐，当时"}, {"type": "subtitle", "time": 5494.709, "timestamp": "01:31:34", "text": "正值六月，天气晴朗，然后我又睡着了。"}, {"type": "subtitle", "time": 5497.83, "timestamp": "01:31:37", "text": "早上6点起床，7点开始直播，然后就一直在这里了"}, {"type": "subtitle", "time": 5500.629, "timestamp": "01:31:40", "text": "。 是的，我休息好了，现在就在"}, {"type": "subtitle", "time": 5502.709, "timestamp": "01:31:42", "text": "这里。"}, {"type": "subtitle", "time": 5505.83, "timestamp": "01:31:45", "text": "所以今天我做了很多事。"}, {"type": "subtitle", "time": 5508.95, "timestamp": "01:31:48", "text": "昨天我睡着了，之后我"}, {"type": "subtitle", "time": 5512.39, "timestamp": "01:31:52", "text": "感觉"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "有点困，然后就睡着了，"}, {"type": "subtitle", "time": 5518.07, "timestamp": "01:31:58", "text": "醒来后我没有……嗯……我为"}]
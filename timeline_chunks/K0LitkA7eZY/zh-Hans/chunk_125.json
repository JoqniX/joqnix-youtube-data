[{"type": "subtitle", "time": 7500.47, "timestamp": "02:05:00", "text": "我没有把它加入到练习中。"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "让我检查一下咳嗽罩。"}, {"type": "subtitle", "time": 7510.47, "timestamp": "02:05:10", "text": "或许她现在情况好转了。"}, {"type": "subtitle", "time": 7514.87, "timestamp": "02:05:14", "text": "呃，不是更好，而是更…… 我来试试"}, {"type": "subtitle", "time": 7517.99, "timestamp": "02:05:17", "text": "。 嗯，"}, {"type": "subtitle", "time": 7520.55, "timestamp": "02:05:20", "text": "我之前刚看到过这个。"}, {"type": "subtitle", "time": 7531.109, "timestamp": "02:05:31", "text": "好的，明白了。 一个充满饱和感的夏天。"}, {"type": "subtitle", "time": 7540.39, "timestamp": "02:05:40", "text": "不是这个。 我的天哪，她居然没把衣服弄松。"}, {"type": "subtitle", "time": 7542.95, "timestamp": "02:05:42", "text": "肯定有一个。"}, {"type": "subtitle", "time": 7559.27, "timestamp": "02:05:59", "text": "不，我想这是另一个版本。"}]
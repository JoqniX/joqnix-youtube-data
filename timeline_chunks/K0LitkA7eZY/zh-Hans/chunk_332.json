[{"type": "subtitle", "time": 19920.948, "timestamp": "05:32:00", "text": "感谢所有在 YouTube 和 Twitch 上观看的朋友们。 这对我意义"}, {"type": "subtitle", "time": 19926.708, "timestamp": "05:32:06", "text": "我的 YouTube 直播就到此结束了"}, {"type": "subtitle", "time": 19928.15, "timestamp": "05:32:08", "text": "。 对于在"}, {"type": "subtitle", "time": 19931.27, "timestamp": "05:32:11", "text": "Twitch 和 Kick 上观看直播的用户来说，直播将"}, {"type": "subtitle", "time": 19933.59, "timestamp": "05:32:13", "text": "永远持续下去。 我的意思是，直到明天我回来为止"}, {"type": "subtitle", "time": 19936.788, "timestamp": "05:32:16", "text": "。 好的。 呃，除非发生"}, {"type": "subtitle", "time": 19938.628, "timestamp": "05:32:18", "text": "停电之类的情况。 不过，尽情"}, {"type": "subtitle", "time": 19941.75, "timestamp": "05:32:21", "text": "享受来自各个直播平台的VS"}, {"type": "subtitle", "time": 19945.51, "timestamp": "05:32:25", "text": "对决吧。 感谢观看。"}, {"type": "subtitle", "time": 19949.35, "timestamp": "05:32:29", "text": "谢谢。 希望你喜欢这场"}, {"type": "subtitle", "time": 19952.628, "timestamp": "05:32:32", "text": "唱歌直播，然后我们就像"}, {"type": "subtitle", "time": 19955.75, "timestamp": "05:32:35", "text": "萨米那样，用唱歌叠加"}, {"type": "subtitle", "time": 19958.15, "timestamp": "05:32:38", "text": "效果来互动，对吧？ 是的，我有点"}, {"type": "subtitle", "time": 19961.91, "timestamp": "05:32:41", "text": "跑题了，不过还是想说。 希望你喜欢。"}, {"type": "subtitle", "time": 19965.27, "timestamp": "05:32:45", "text": "这对我意义重大。 我玩得很开心"}, {"type": "subtitle", "time": 19967.67, "timestamp": "05:32:47", "text": "。"}, {"type": "subtitle", "time": 19969.67, "timestamp": "05:32:49", "text": "希望你也玩得"}, {"type": "subtitle", "time": 19973.27, "timestamp": "05:32:53", "text": "开心。 嗨，这是什么"}, {"type": "subtitle", "time": 19977.03, "timestamp": "05:32:57", "text": "笑话？ 再见。"}]
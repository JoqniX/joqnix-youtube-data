[{"type": "subtitle", "time": 16449.59, "timestamp": "04:34:09", "text": "所以，你的意思是说，"}, {"type": "subtitle", "time": 16451.429, "timestamp": "04:34:11", "text": "因为我同时发送了所有内容，所以才导致它不起作用？"}, {"type": "subtitle", "time": 16457.189, "timestamp": "04:34:17", "text": "问号在前，那"}, {"type": "subtitle", "time": 16460.629, "timestamp": "04:34:20", "text": "我把它延迟一"}, {"type": "subtitle", "time": 16462.15, "timestamp": "04:34:22", "text": "毫秒，"}, {"type": "subtitle", "time": 16482.949, "timestamp": "04:34:42", "text": "一旦敏感就被检测到。"}]
[{"type": "subtitle", "time": 1403.99, "timestamp": "00:23:23", "text": "呃，别试图强调“他"}, {"type": "subtitle", "time": 1412.23, "timestamp": "00:23:32", "text": "强调“他”这个词一样，他必须把音调"}, {"type": "subtitle", "time": 1420.07, "timestamp": "00:23:40", "text": "我不喜欢这样，我不知道你能不能"}, {"type": "subtitle", "time": 1422.549, "timestamp": "00:23:42", "text": "听出来，但是你出于"}, {"type": "subtitle", "time": 1425.75, "timestamp": "00:23:45", "text": "某种原因对“他”这个词给予了很大的强调。"}, {"type": "subtitle", "time": 1429.83, "timestamp": "00:23:49", "text": "啊，是的。 我为什么会这样做？"}, {"type": "subtitle", "time": 1432.71, "timestamp": "00:23:52", "text": "我不知道。"}, {"type": "subtitle", "time": 1435.99, "timestamp": "00:23:55", "text": "我觉得尽量把它做得比较软就行了"}, {"type": "subtitle", "time": 1438.63, "timestamp": "00:23:58", "text": "。 而且不要在"}]
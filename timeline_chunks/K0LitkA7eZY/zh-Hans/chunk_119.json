[{"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "哦，对，就是我最近在学的那首很难的歌"}, {"type": "subtitle", "time": 7151.589, "timestamp": "01:59:11", "text": "。 正确的。 等待。"}, {"type": "subtitle", "time": 7163.189, "timestamp": "01:59:23", "text": "呃，"}, {"type": "subtitle", "time": 7177.589, "timestamp": "01:59:37", "text": "请务必到场。 那是她最近"}, {"type": "subtitle", "time": 7180.149, "timestamp": "01:59:40", "text": "翻唱的哈兰的歌曲。"}]
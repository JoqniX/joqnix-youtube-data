[{"type": "subtitle", "time": 6361.91, "timestamp": "01:46:01", "text": "好的。 边缘高耸的故事。 好的。"}, {"type": "subtitle", "time": 6364.47, "timestamp": "01:46:04", "text": "让我喝点水。 我要放"}, {"type": "subtitle", "time": 6367.03, "timestamp": "01:46:07", "text": "一些滚烫的开水，然后"}, {"type": "subtitle", "time": 6370.55, "timestamp": "01:46:10", "text": "和常温水混合。"}, {"type": "subtitle", "time": 6380.709, "timestamp": "01:46:20", "text": "嗨”。"}, {"type": "subtitle", "time": 6383.27, "timestamp": "01:46:23", "text": "三、二，"}, {"type": "subtitle", "time": 6399.35, "timestamp": "01:46:39", "text": "好了，我全都说出来了。 等等，还有"}, {"type": "subtitle", "time": 6414.31, "timestamp": "01:46:54", "text": "当波比跳是从嘴里发出的时候，真是"}, {"type": "subtitle", "time": 6416.55, "timestamp": "01:46:56", "text": "太痛苦了。"}]
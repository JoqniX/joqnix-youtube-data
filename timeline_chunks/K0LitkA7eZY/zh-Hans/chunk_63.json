[{"type": "subtitle", "time": 3781.91, "timestamp": "01:03:01", "text": "好的。 你好。"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "下一个基本上就是把它"}, {"type": "subtitle", "time": 3787.589, "timestamp": "01:03:07", "text": "读作那样，"}, {"type": "subtitle", "time": 3793.27, "timestamp": "01:03:13", "text": "完美。"}, {"type": "subtitle", "time": 3812.71, "timestamp": "01:03:32", "text": "你知道我关注他吗？你认识这位"}, {"type": "subtitle", "time": 3819.91, "timestamp": "01:03:39", "text": "我真是太善良了。 我也这么认为。 我想"}, {"type": "subtitle", "time": 3823.589, "timestamp": "01:03:43", "text": "你是。 是的。 你给我发了"}, {"type": "subtitle", "time": 3826.39, "timestamp": "01:03:46", "text": "她一首很美的歌，对吧？   是的"}, {"type": "subtitle", "time": 3828.15, "timestamp": "01:03:48", "text": "。 是的。 是的。 是的。 我试着"}, {"type": "subtitle", "time": 3831.27, "timestamp": "01:03:51", "text": "跟着她。 没问题。"}, {"type": "subtitle", "time": 3834.15, "timestamp": "01:03:54", "text": "哦，是的。 我之前订阅过她，但过了"}, {"type": "subtitle", "time": 3836.309, "timestamp": "01:03:56", "text": "一段时间后，我有点忘了她的名字"}, {"type": "subtitle", "time": 3838.789, "timestamp": "01:03:58", "text": "。"}]
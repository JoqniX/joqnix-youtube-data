[{"type": "subtitle", "time": 549.509, "timestamp": "00:09:09", "text": "為了"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "眼睛。  我做得對嗎？  幾乎。好的。你需要投入更多情感，我就是這個意思。是的。  好的。  我覺得你"}, {"type": "subtitle", "time": 555.269, "timestamp": "00:09:15", "text": "有點緊張了。這是"}, {"type": "subtitle", "time": 566.07, "timestamp": "00:09:26", "text": "一件事。  那裡有。  是的。我只演奏"}, {"type": "subtitle", "time": 569.269, "timestamp": "00:09:29", "text": "伴奏部分。  我一直在跟著你的音訊播放。"}, {"type": "subtitle", "time": 572.389, "timestamp": "00:09:32", "text": "你好。三、二"}]
[{"type": "subtitle", "time": 6061.03, "timestamp": "01:41:01", "text": "？  沒什麼。你"}, {"type": "subtitle", "time": 6074.629, "timestamp": "01:41:14", "text": "想讓我唱那首《Rim之歌》"}, {"type": "subtitle", "time": 6077.59, "timestamp": "01:41:17", "text": "。  是的。邊緣之歌。是的。是的。是的。  好的。等待。讓我來做。一秒鐘。  嗯。好的。  沒有得到"}, {"type": "subtitle", "time": 6081.669, "timestamp": "01:41:21", "text": "許可。你好。  如果可以的話。  你好。你好。是的。是的。我想"}, {"type": "subtitle", "time": 6096.709, "timestamp": "01:41:36", "text": "我記得。"}, {"type": "subtitle", "time": 6110.229, "timestamp": "01:41:50", "text": "不是那個。它在最上面。  開始了。哦，是的。"}]
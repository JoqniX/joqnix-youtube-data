[{"type": "subtitle", "time": 10741.229, "timestamp": "02:59:01", "text": "可以把它扔掉。好吧，教練霰彈槍、手槍，"}, {"type": "subtitle", "time": 10761.07, "timestamp": "02:59:21", "text": "我"}, {"type": "subtitle", "time": 10779.59, "timestamp": "02:59:39", "text": "[音樂]"}, {"type": "subtitle", "time": 10783.67, "timestamp": "02:59:43", "text": "我不能把它放在這裡，為什麼？我需要[音樂] 聖兄弟，兄弟，為什麼"}, {"type": "subtitle", "time": 10793.87, "timestamp": "02:59:53", "text": "我能把它放進去？"}]
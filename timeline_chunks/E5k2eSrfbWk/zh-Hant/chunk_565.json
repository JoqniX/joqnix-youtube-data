[{"type": "subtitle", "time": 33915.23, "timestamp": "09:25:15", "text": "想說的嗎？你剛剛說我哥哥，是啊，他有一台1500萬的筆記型電腦，大概40匹馬力，等等等等，還有獎勵，"}, {"type": "subtitle", "time": 33918.79, "timestamp": "09:25:18", "text": "走吧。他玩遊戲開高畫質，比我的好多了，我的筆電是70匹馬力的遊戲本，"}, {"type": "subtitle", "time": 33940.266, "timestamp": "09:25:40", "text": "他的更好。哦，那你用的是什麼顯示卡？我用的是英特爾"}, {"type": "subtitle", "time": 33942.71, "timestamp": "09:25:42", "text": "酷睿i7，N9H系列，"}]
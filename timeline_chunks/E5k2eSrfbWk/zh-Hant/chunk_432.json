[{"type": "subtitle", "time": 25932.468, "timestamp": "07:12:12", "text": "以前用舊床單之類的東西做的，我媽媽以前會做，"}, {"type": "subtitle", "time": 25934.99, "timestamp": "07:12:14", "text": "我猜是枕頭套之類的，真的很好。所以我們這裡有"}, {"type": "subtitle", "time": 25949.91, "timestamp": "07:12:29", "text": "很多枕頭套。好了，現在我只需要把它們從地上拿走就行了。"}]
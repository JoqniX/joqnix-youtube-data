[{"type": "subtitle", "time": 940.35, "timestamp": "00:15:40", "text": "跑，莎拉，別死！我求"}, {"type": "subtitle", "time": 943.509, "timestamp": "00:15:43", "text": "你了，我求"}, {"type": "subtitle", "time": 955.389, "timestamp": "00:15:55", "text": "我愛她，她還在"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "戰鬥，哦，我的天，"}]
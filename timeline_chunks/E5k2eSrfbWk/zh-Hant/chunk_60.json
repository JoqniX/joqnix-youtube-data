[{"type": "subtitle", "time": 3618.27, "timestamp": "01:00:18", "text": "像…我是甲蟲…甲蟲…哦我的天哪，我的"}, {"type": "subtitle", "time": 3620.75, "timestamp": "01:00:20", "text": "夢想…也許你能找到它，給我們指路去"}, {"type": "subtitle", "time": 3624.27, "timestamp": "01:00:24", "text": "最近的餐廳。"}, {"type": "subtitle", "time": 3628.349, "timestamp": "01:00:28", "text": "[音樂]"}, {"type": "subtitle", "time": 3629.589, "timestamp": "01:00:29", "text": "哦我的天哪，"}, {"type": "subtitle", "time": 3644.23, "timestamp": "01:00:44", "text": "終於找到甲蟲了！喔我的天哪，我"}, {"type": "subtitle", "time": 3648.95, "timestamp": "01:00:48", "text": "終於找到了！走吧"}, {"type": "subtitle", "time": 3652.67, "timestamp": "01:00:52", "text": "兄弟，我要回家了，我要回家了，"}]
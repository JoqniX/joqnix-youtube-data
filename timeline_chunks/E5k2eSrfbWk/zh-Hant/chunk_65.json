[{"type": "subtitle", "time": 3908.39, "timestamp": "01:05:08", "text": "他談談。謝謝您的回覆。我的朋友們，"}, {"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "我們一直在嘗試聯絡你，"}, {"type": "subtitle", "time": 3911.71, "timestamp": "01:05:11", "text": "因為情況不明朗。"}, {"type": "subtitle", "time": 3914.029, "timestamp": "01:05:14", "text": "[音樂]呃，"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "不，謝謝，聽起來你好像"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "不"}, {"type": "subtitle", "time": 3921.15, "timestamp": "01:05:21", "text": "感興趣。我可以不出貨嗎？我可以不"}, {"type": "subtitle", "time": 3922.99, "timestamp": "01:05:22", "text": "偷船嗎？我想試試，我想試試，我們試試去偷"}, {"type": "subtitle", "time": 3929.67, "timestamp": "01:05:29", "text": "他的船，然後偷"}, {"type": "subtitle", "time": 3946.67, "timestamp": "01:05:46", "text": "船。過來，等等，怎麼"}]
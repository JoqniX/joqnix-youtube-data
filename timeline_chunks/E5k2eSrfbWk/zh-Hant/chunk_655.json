[{"type": "subtitle", "time": 39308.55, "timestamp": "10:55:08", "text": "你想在……之前和他們戰鬥嗎？"}, {"type": "subtitle", "time": 39314.106, "timestamp": "10:55:14", "text": "哦，為什麼？該死！沒關係，沒關係。是的，"}, {"type": "subtitle", "time": 39321.906, "timestamp": "10:55:21", "text": "我不喜歡這把武器，所以我要換一把。你可以用這把。不，我去。"}, {"type": "subtitle", "time": 39325.31, "timestamp": "10:55:25", "text": "哦，這把槍"}, {"type": "subtitle", "time": 39329.55, "timestamp": "10:55:29", "text": "更好。"}, {"type": "subtitle", "time": 39331.906, "timestamp": "10:55:31", "text": "你有治療嗎？你的治療夠嗎？你能活下來嗎？是的。好的，我"}, {"type": "subtitle", "time": 39338.39, "timestamp": "10:55:38", "text": "想他們是機器人，他們可能是。他們的移動方式很像機器人。是的，你能搬運一些迷你武器嗎？"}, {"type": "subtitle", "time": 39345.15, "timestamp": "10:55:45", "text": "你有"}, {"type": "subtitle", "time": 39349.23, "timestamp": "10:55:49", "text": "迷你武器嗎？是的，我"}, {"type": "subtitle", "time": 39354.55, "timestamp": "10:55:54", "text": "有六罐裝。哦，不錯。哦，如果你想……嗯，我想……如果你想要突擊步槍，"}]
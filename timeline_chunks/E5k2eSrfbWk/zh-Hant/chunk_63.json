[{"type": "subtitle", "time": 3781.349, "timestamp": "01:03:01", "text": "提交索賠之前，索賠人必須提交"}, {"type": "subtitle", "time": 3783.91, "timestamp": "01:03:03", "text": "以下資料（請注意，目前可能存在詐騙者）："}, {"type": "subtitle", "time": 3786.309, "timestamp": "01:03:06", "text": "完整的聯絡資訊；製作"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "相關船舶的模型，以及我們認可的機械師"}, {"type": "subtitle", "time": 3790.75, "timestamp": "01:03:10", "text": "對船舶進行的任何改裝；"}, {"type": "subtitle", "time": 3795.99, "timestamp": "01:03:15", "text": "此外，我們還需要授權"}, {"type": "subtitle", "time": 3798.87, "timestamp": "01:03:18", "text": "維修經銷商的聯絡資訊；"}, {"type": "subtitle", "time": 3800.589, "timestamp": "01:03:20", "text": "您的零件問題的描述；"}, {"type": "subtitle", "time": 3803.19, "timestamp": "01:03:23", "text": "您尋求的解決方案（"}, {"type": "subtitle", "time": 3806.109, "timestamp": "01:03:26", "text": "現金賠償或全額更換）；以及已"}, {"type": "subtitle", "time": 3808.67, "timestamp": "01:03:28", "text": "簽署的資訊"}, {"type": "subtitle", "time": 3811.349, "timestamp": "01:03:31", "text": "豁免書。索賠人還需要"}, {"type": "subtitle", "time": 3813.309, "timestamp": "01:03:33", "text": "提交相關零件使用期間的船舶日誌；"}, {"type": "subtitle", "time": 3817.549, "timestamp": "01:03:37", "text": "三位"}, {"type": "subtitle", "time": 3819.75, "timestamp": "01:03:39", "text": "前任船東的聯絡資訊；以及我們的客戶"}, {"type": "subtitle", "time": 3822.43, "timestamp": "01:03:42", "text": "滿意度保證豁免書。我可以"}, {"type": "subtitle", "time": 3824.52, "timestamp": "01:03:44", "text": "繼續嗎？"}, {"type": "subtitle", "time": 3826.19, "timestamp": "01:03:46", "text": "[音樂]"}, {"type": "subtitle", "time": 3828.63, "timestamp": "01:03:48", "text": "我們聽起來您很想了解"}, {"type": "subtitle", "time": 3831.069, "timestamp": "01:03:51", "text": "更多。我們提供多種等級的"}, {"type": "subtitle", "time": 3833.47, "timestamp": "01:03:53", "text": "保固服務，請仔細聆聽，因為條款"}, {"type": "subtitle", "time": 3836.069, "timestamp": "01:03:56", "text": "和條件可能會有所更改。我們的動力"}, {"type": "subtitle", "time": 3838.19, "timestamp": "01:03:58", "text": "裝置加強版計畫涵蓋與"}]
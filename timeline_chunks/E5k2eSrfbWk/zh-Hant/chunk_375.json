[{"type": "subtitle", "time": 22509.03, "timestamp": "06:15:09", "text": "現在，我要去日本的時候，我會想念它們。"}, {"type": "subtitle", "time": 22519.39, "timestamp": "06:15:19", "text": "我得把這個……對，"}, {"type": "subtitle", "time": 22523.43, "timestamp": "06:15:23", "text": "我要去日本，我還要……我得再擦擦。給我多點水！哦，你個笨蛋，你灑了！你灑了！哦，天哪！"}, {"type": "subtitle", "time": 22532.75, "timestamp": "06:15:32", "text": "我本來想用人工呼吸，就是把水含在嘴裡，然後灑到桌上什麼的，因為"}, {"type": "subtitle", "time": 22545.948, "timestamp": "06:15:45", "text": "我不想用"}, {"type": "subtitle", "time": 22547.788, "timestamp": "06:15:47", "text": "噴水器。太糟糕了。你知道嗎，"}]
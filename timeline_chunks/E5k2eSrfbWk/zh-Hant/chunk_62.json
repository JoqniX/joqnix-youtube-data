[{"type": "subtitle", "time": 3737.63, "timestamp": "01:02:17", "text": "水星上。我可以佔用你一點時間嗎？"}, {"type": "subtitle", "time": 3740.069, "timestamp": "01:02:20", "text": "謝謝你的回覆。您好，我們一直在"}, {"type": "subtitle", "time": 3742.029, "timestamp": "01:02:22", "text": "嘗試聯絡您，以了解您"}, {"type": "subtitle", "time": 3744.67, "timestamp": "01:02:24", "text": "船舶的延保事宜。"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "由於政治"}, {"type": "subtitle", "time": 3752.269, "timestamp": "01:02:32", "text": "局勢和既定制度的不確定性，您的保固期已過期或即將過期。我們"}, {"type": "subtitle", "time": 3754.43, "timestamp": "01:02:34", "text": "認為現在是續保"}, {"type": "subtitle", "time": 3757.23, "timestamp": "01:02:37", "text": "或"}, {"type": "subtitle", "time": 3765.63, "timestamp": "01:02:45", "text": "保固）的最佳時機。聽起來您有"}, {"type": "subtitle", "time": 3768.43, "timestamp": "01:02:48", "text": "興趣了解更多。首先，我需要"}, {"type": "subtitle", "time": 3770.63, "timestamp": "01:02:50", "text": "告知您保固索賠"}, {"type": "subtitle", "time": 3772.269, "timestamp": "01:02:52", "text": "流程。該流程由聯合"}, {"type": "subtitle", "time": 3773.95, "timestamp": "01:02:53", "text": "殖民地仲裁"}, {"type": "subtitle", "time": 3776.75, "timestamp": "01:02:56", "text": "委員會制定，該委員會不具有決策權，也無法"}, {"type": "subtitle", "time": 3779.63, "timestamp": "01:02:59", "text": "改變爭議結果。在"}]
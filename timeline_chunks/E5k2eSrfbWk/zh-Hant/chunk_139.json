[{"type": "subtitle", "time": 8348.91, "timestamp": "02:19:08", "text": "怎麼"}, {"type": "subtitle", "time": 8351.99, "timestamp": "02:19:11", "text": "抽筋了？嗯，可能這樣就"}, {"type": "subtitle", "time": 8363.709, "timestamp": "02:19:23", "text": "溶解了。終於有三個人了，1、2、3、4、5，五個人。在我們回去之前，我想確認一下，想最後再裝一次彈。不是"}, {"type": "subtitle", "time": 8382.23, "timestamp": "02:19:42", "text": "我不想，呃，再說一遍，我不想用我的"}, {"type": "subtitle", "time": 8390.19, "timestamp": "02:19:50", "text": "這是最強的初始武器，遊戲裡給你的武器。我是最厲害的之一，我獲得了一個技能點數。蘋果，直接瞄準目標。"}]
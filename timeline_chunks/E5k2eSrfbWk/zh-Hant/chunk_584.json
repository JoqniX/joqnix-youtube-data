[{"type": "subtitle", "time": 35042.19, "timestamp": "09:44:02", "text": "騙子，那是什麼好的，你拿到了罰款，我可能會得到更多，"}, {"type": "subtitle", "time": 35082.87, "timestamp": "09:44:42", "text": "建造的，對吧？所以你"}, {"type": "subtitle", "time": 35096.79, "timestamp": "09:44:56", "text": "身後，復活皮利，皮利，真的嗎？打了他一下，哦，現在有很多，"}, {"type": "subtitle", "time": 35098.79, "timestamp": "09:44:58", "text": "我們被夾在中間了，是的，香蕉人，不錯，搞什麼鬼？好的，從這裡，另一個傢伙，嗯，他有激光，哦，那"}]
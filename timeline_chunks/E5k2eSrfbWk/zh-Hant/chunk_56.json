[{"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "好餓啊，另一邊有個洞穴，"}, {"type": "subtitle", "time": 3383.95, "timestamp": "00:56:23", "text": "想像一下，它就在"}, {"type": "subtitle", "time": 3393.549, "timestamp": "00:56:33", "text": "哦，它們在互相打架。"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "我看到"}, {"type": "subtitle", "time": 3407.27, "timestamp": "00:56:47", "text": "莎拉，你在幹嘛？你怎麼了？"}]
[{"type": "subtitle", "time": 38704.39, "timestamp": "10:45:04", "text": "他們要搞棒球了，他們要搞棒球了，嗯，哦，對，因為我們有棒球棒，挺"}, {"type": "subtitle", "time": 38725.63, "timestamp": "10:45:25", "text": "酷的，啊，好吧好吧好吧，對對對，"}, {"type": "subtitle", "time": 38742.19, "timestamp": "10:45:42", "text": "你覺得怎麼樣？絕對零度，絕對零度，也有絕對零度，誰是絕對零度？"}, {"type": "subtitle", "time": 38758.906, "timestamp": "10:45:58", "text": "我不知道，誰是絕對零度？遊戲《真人"}]
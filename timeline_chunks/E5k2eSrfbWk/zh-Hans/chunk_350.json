[{"type": "subtitle", "time": 21000.19, "timestamp": "05:50:00", "text": "州政府正在使用它"}, {"type": "subtitle", "time": 21004.35, "timestamp": "05:50:04", "text": "直播，而且我还是SMP用户，所以我当时就想，哇"}, {"type": "subtitle", "time": 21007.11, "timestamp": "05:50:07", "text": "太棒了，你居然有个小地图！"}, {"type": "subtitle", "time": 21009.67, "timestamp": "05:50:09", "text": "可以知道牛和猪在哪里，以及"}, {"type": "subtitle", "time": 21012.868, "timestamp": "05:50:12", "text": "你周围的羊群像一群群的绵羊。"}, {"type": "subtitle", "time": 21015.67, "timestamp": "05:50:15", "text": "你无需担心的事"}, {"type": "subtitle", "time": 21017.708, "timestamp": "05:50:17", "text": "就像你知道的，那些幸存下来的东西"}, {"type": "subtitle", "time": 21020.548, "timestamp": "05:50:20", "text": "我知道这会毁了"}, {"type": "subtitle", "time": 21024.59, "timestamp": "05:50:24", "text": "生存环境意识之类的"}, {"type": "subtitle", "time": 21028.31, "timestamp": "05:50:28", "text": "就像……就像我玩的那个游戏里一样……"}, {"type": "subtitle", "time": 21032.91, "timestamp": "05:50:32", "text": "不久前，呃，边境等待"}, {"type": "subtitle", "time": 21036.23, "timestamp": "05:50:36", "text": "嗯，又是 Frontier 循环 Frontier"}, {"type": "subtitle", "time": 21037.19, "timestamp": "05:50:37", "text": "是的"}, {"type": "subtitle", "time": 21039.51, "timestamp": "05:50:39", "text": "Cycle Frontier，没错，就是那款游戏。"}, {"type": "subtitle", "time": 21042.948, "timestamp": "05:50:42", "text": "玩过，我的天哪，我死了好多次。"}, {"type": "subtitle", "time": 21045.468, "timestamp": "05:50:45", "text": "就像，天哪，简直就像整个……"}, {"type": "subtitle", "time": 21049.468, "timestamp": "05:50:49", "text": "生存意识那玩意儿，嗯。"}, {"type": "subtitle", "time": 21052.948, "timestamp": "05:50:52", "text": "你好，你好吗？哦，你刚来。"}, {"type": "subtitle", "time": 21054.23, "timestamp": "05:50:54", "text": "我是"}]
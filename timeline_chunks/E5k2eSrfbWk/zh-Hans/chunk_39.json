[{"type": "subtitle", "time": 2348.99, "timestamp": "00:39:08", "text": "快啊，就像氧气这玩意儿一样"}, {"type": "subtitle", "time": 2384.19, "timestamp": "00:39:44", "text": "不，为什么会这样？"}, {"type": "subtitle", "time": 2387.349, "timestamp": "00:39:47", "text": "我离完成这件事就差这么一点了。"}, {"type": "subtitle", "time": 2389.39, "timestamp": "00:39:49", "text": "一旦我愿意，就挤压，而且永远不会碰它"}]
[{"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "他们开枪打了我"}, {"type": "subtitle", "time": 6674.149, "timestamp": "01:51:14", "text": "僚机，最后幸存的玩家，新的角色"}, {"type": "subtitle", "time": 6687.03, "timestamp": "01:51:27", "text": "[音乐]"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "是我吗？哦，我救不了，我救不了。"}, {"type": "subtitle", "time": 6705.7, "timestamp": "01:51:45", "text": "直接去那里"}, {"type": "subtitle", "time": 6718.87, "timestamp": "01:51:58", "text": "需要一些"}]
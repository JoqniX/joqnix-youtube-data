[{"type": "subtitle", "time": 7872.91, "timestamp": "02:11:12", "text": "抱歉，我被叫住了，所以我不得不……"}, {"type": "subtitle", "time": 7902.669, "timestamp": "02:11:42", "text": "那是一种类似白色的东西。"}, {"type": "subtitle", "time": 7905.069, "timestamp": "02:11:45", "text": "麦克风上好像沾了灰尘之类的东西，所以我"}, {"type": "subtitle", "time": 7906.149, "timestamp": "02:11:46", "text": "只是"}, {"type": "subtitle", "time": 7911.3, "timestamp": "02:11:51", "text": "嗨，呃，来吧"}]
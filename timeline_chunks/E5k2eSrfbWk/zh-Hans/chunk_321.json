[{"type": "subtitle", "time": 19261.6, "timestamp": "05:21:01", "text": "它变黄了 黄色 黄色 黄色"}, {"type": "subtitle", "time": 19264.05, "timestamp": "05:21:04", "text": "黄色 黄色 黄色 [音乐]"}, {"type": "subtitle", "time": 19265.958, "timestamp": "05:21:05", "text": "[音乐] 嗯……等等，我重复第二遍，好的。"}, {"type": "subtitle", "time": 19269.08, "timestamp": "05:21:09", "text": "嗯……等等，我重复第二遍，好的。 黄色 黄色 嗯 所以"}, {"type": "subtitle", "time": 19272.16, "timestamp": "05:21:12", "text": "黄色 黄色 嗯 所以 绿色 绿色 绿色 绿色 所有"}, {"type": "subtitle", "time": 19281.59, "timestamp": "05:21:21", "text": "现在它变成黄色了"}, {"type": "subtitle", "time": 19285.67, "timestamp": "05:21:25", "text": "黄色，所以绿色，绿色"}, {"type": "subtitle", "time": 19289.548, "timestamp": "05:21:29", "text": "格林完成了炸弹的放置，炸弹已经放置完毕。"}, {"type": "subtitle", "time": 19291.83, "timestamp": "05:21:31", "text": "已扩散"}, {"type": "subtitle", "time": 19294.75, "timestamp": "05:21:34", "text": "不错，用了1分09秒。"}, {"type": "subtitle", "time": 19298.75, "timestamp": "05:21:38", "text": "时钟哦"}, {"type": "subtitle", "time": 19301.708, "timestamp": "05:21:41", "text": "我们有很多"}, {"type": "subtitle", "time": 19306.51, "timestamp": "05:21:46", "text": "我希望迷宫带来的痛苦能就此结束。"}, {"type": "subtitle", "time": 19312.32, "timestamp": "05:21:52", "text": "嗯，我有《入侵者》，别忘了……"}, {"type": "subtitle", "time": 19319.23, "timestamp": "05:21:59", "text": "[音乐]"}]
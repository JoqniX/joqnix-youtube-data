[{"type": "subtitle", "time": 6790.87, "timestamp": "01:53:10", "text": "自从我开始胡闹以来，一切都变得很奇怪"}, {"type": "subtitle", "time": 6792.83, "timestamp": "01:53:12", "text": "在"}, {"type": "subtitle", "time": 6805.55, "timestamp": "01:53:25", "text": "旅行，直面恐惧，哦，天哪，我又回来了"}, {"type": "subtitle", "time": 6807.39, "timestamp": "01:53:27", "text": "怎么了"}, {"type": "subtitle", "time": 6811.27, "timestamp": "01:53:31", "text": "呃，等等，这难道不是很久以前的事了吗？"}, {"type": "subtitle", "time": 6815.39, "timestamp": "01:53:35", "text": "瓦勒哦，真好真好，我回来了"}, {"type": "subtitle", "time": 6818.51, "timestamp": "01:53:38", "text": "这里我不得不，我当时正在"}, {"type": "subtitle", "time": 6834.149, "timestamp": "01:53:54", "text": "我的天哪"}, {"type": "subtitle", "time": 6835.79, "timestamp": "01:53:55", "text": "等等，我们这是在哪儿来着？对，我们回来了。"}]
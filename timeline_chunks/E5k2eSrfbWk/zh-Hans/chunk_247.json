[{"type": "subtitle", "time": 14824.63, "timestamp": "04:07:04", "text": "当只有一个的时候，就有点难了。"}, {"type": "subtitle", "time": 14828.229, "timestamp": "04:07:08", "text": "名字哦我"}, {"type": "subtitle", "time": 14831.07, "timestamp": "04:07:11", "text": "等等，你不担心什么？"}, {"type": "subtitle", "time": 14834.03, "timestamp": "04:07:14", "text": "它 Roo 我刚刚变成了黑色"}, {"type": "subtitle", "time": 14837.429, "timestamp": "04:07:17", "text": "当我不说话的时候，它就只是"}, {"type": "subtitle", "time": 14839.91, "timestamp": "04:07:19", "text": "哦，是的，呃，变暗了，大概吧。"}, {"type": "subtitle", "time": 14842.349, "timestamp": "04:07:22", "text": "还没看过我的反应堆图片，现在看过了。"}, {"type": "subtitle", "time": 14844.51, "timestamp": "04:07:24", "text": "在与《Among Us》合作之后进行了更改。"}, {"type": "subtitle", "time": 14853.63, "timestamp": "04:07:33", "text": "哦，太好了，你就像病娇一样。"}, {"type": "subtitle", "time": 14855.87, "timestamp": "04:07:35", "text": "但是看不到眼睛，却能看到你"}, {"type": "subtitle", "time": 14872.389, "timestamp": "04:07:52", "text": "等等，你有通行证，等等，什么？"}, {"type": "subtitle", "time": 14877.79, "timestamp": "04:07:57", "text": "传球给罗科，什么传球，什么传球，还有"}]
[{"type": "subtitle", "time": 20340.708, "timestamp": "05:39:00", "text": "在结束之前，我想说……"}, {"type": "subtitle", "time": 20344.788, "timestamp": "05:39:04", "text": "每一个来到我身边的人，我都得到了"}, {"type": "subtitle", "time": 20349.548, "timestamp": "05:39:09", "text": "所以我像往常一样参加了直播。"}, {"type": "subtitle", "time": 20351.11, "timestamp": "05:39:11", "text": "祖昆"}, {"type": "subtitle", "time": 20357.39, "timestamp": "05:39:17", "text": "也为了来，然后 nakam 和 um"}, {"type": "subtitle", "time": 20361.51, "timestamp": "05:39:21", "text": "蓝色和蜂蜜，谢谢你们的到来"}, {"type": "subtitle", "time": 20366.35, "timestamp": "05:39:26", "text": "DJ 的到来和在 CH Arata 的停留"}, {"type": "subtitle", "time": 20369.948, "timestamp": "05:39:29", "text": "与我合作并参与其中"}, {"type": "subtitle", "time": 20371.23, "timestamp": "05:39:31", "text": "并阅读"}, {"type": "subtitle", "time": 20377.51, "timestamp": "05:39:37", "text": "R 代表到来，Roy 代表到来，并且在"}, {"type": "subtitle", "time": 20381.43, "timestamp": "05:39:41", "text": "因为和儿子一起来而获得了奖励"}, {"type": "subtitle", "time": 20385.39, "timestamp": "05:39:45", "text": "嗯，儿子，我收到了他的来信。"}, {"type": "subtitle", "time": 20388.948, "timestamp": "05:39:48", "text": "有Netflix吗？"}, {"type": "subtitle", "time": 20390.948, "timestamp": "05:39:50", "text": "好的"}, {"type": "subtitle", "time": 20393.67, "timestamp": "05:39:53", "text": "我有没有提到所有那些人？"}, {"type": "subtitle", "time": 20394.67, "timestamp": "05:39:54", "text": "来了"}, {"type": "subtitle", "time": 20399.19, "timestamp": "05:39:59", "text": "今天，我想我做到了，所以所有人都……"}]
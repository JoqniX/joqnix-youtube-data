[{"type": "subtitle", "time": 8340.75, "timestamp": "02:19:00", "text": "我们确实彻底压制了圣路易斯"}, {"type": "subtitle", "time": 8343.429, "timestamp": "02:19:03", "text": "我想我们也可以再次保留这一点。"}, {"type": "subtitle", "time": 8345.389, "timestamp": "02:19:05", "text": "负载"}, {"type": "subtitle", "time": 8348.91, "timestamp": "02:19:08", "text": "呃，又来了，该怎么称呼它呢？"}, {"type": "subtitle", "time": 8351.99, "timestamp": "02:19:11", "text": "重量很重要，"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "离开洛，我们可以，我们可以喜欢"}, {"type": "subtitle", "time": 8363.709, "timestamp": "02:19:23", "text": "直接掉落"}, {"type": "subtitle", "time": 8367.589, "timestamp": "02:19:27", "text": "我相信他是《Valerant》里的守护者。"}, {"type": "subtitle", "time": 8373.629, "timestamp": "02:19:33", "text": "那"}, {"type": "subtitle", "time": 8382.23, "timestamp": "02:19:42", "text": "我觉得我扔掉比较好。"}, {"type": "subtitle", "time": 8390.19, "timestamp": "02:19:50", "text": "实际上，但这些并不能说明什么。"}, {"type": "subtitle", "time": 8391.51, "timestamp": "02:19:51", "text": "很多"}]
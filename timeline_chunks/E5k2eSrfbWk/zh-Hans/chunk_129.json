[{"type": "subtitle", "time": 7745.03, "timestamp": "02:09:05", "text": "现在我又回到这里了，所以，我们应该……"}, {"type": "subtitle", "time": 7753.549, "timestamp": "02:09:13", "text": "大概……"}, {"type": "subtitle", "time": 7759.43, "timestamp": "02:09:19", "text": "多汁的饭菜回来了，好吧，我试着弄到"}, {"type": "subtitle", "time": 7761.99, "timestamp": "02:09:21", "text": "你可以使用麦克风"}, {"type": "subtitle", "time": 7765.79, "timestamp": "02:09:25", "text": "我认为你可以用显微镜观察。"}, {"type": "subtitle", "time": 7770.109, "timestamp": "02:09:30", "text": "所以我相信是这样，但是它被锁住了。"}, {"type": "subtitle", "time": 7771.229, "timestamp": "02:09:31", "text": "不是"}, {"type": "subtitle", "time": 7780.109, "timestamp": "02:09:40", "text": "那个会议室还没去过。"}, {"type": "subtitle", "time": 7783.87, "timestamp": "02:09:43", "text": "这个地方还没建好，但我确实杀过人。"}, {"type": "subtitle", "time": 7786.109, "timestamp": "02:09:46", "text": "虽然我确信他们有我们这样的人"}]
[{"type": "subtitle", "time": 3737.63, "timestamp": "01:02:17", "text": "Mercury，我可以占用你一点时间吗？"}, {"type": "subtitle", "time": 3740.069, "timestamp": "01:02:20", "text": "感谢您回复我的邮件。"}, {"type": "subtitle", "time": 3742.029, "timestamp": "01:02:22", "text": "我一直试图联系你，关于你的"}, {"type": "subtitle", "time": 3744.67, "timestamp": "01:02:24", "text": "船舶延长保修期 您的保修"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "保险已过期或即将过期"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "由于政治局势的不确定性"}, {"type": "subtitle", "time": 3752.269, "timestamp": "01:02:32", "text": "形势和既定体系"}, {"type": "subtitle", "time": 3754.43, "timestamp": "01:02:34", "text": "我认为现在是续订的绝佳时机。"}, {"type": "subtitle", "time": 3757.23, "timestamp": "01:02:37", "text": "船舶保修保护计划或"}, {"type": "subtitle", "time": 3765.63, "timestamp": "01:02:45", "text": "听起来你好像在做保险"}, {"type": "subtitle", "time": 3768.43, "timestamp": "01:02:48", "text": "首先，我很想了解更多，我需要"}, {"type": "subtitle", "time": 3770.63, "timestamp": "01:02:50", "text": "告知您有关保修索赔的信息"}, {"type": "subtitle", "time": 3772.269, "timestamp": "01:02:52", "text": "流程由美国制定。"}, {"type": "subtitle", "time": 3773.95, "timestamp": "01:02:53", "text": "殖民地仲裁"}, {"type": "subtitle", "time": 3776.75, "timestamp": "01:02:56", "text": "董事会并非决策机构，也不能做出决策。"}, {"type": "subtitle", "time": 3779.63, "timestamp": "01:02:59", "text": "在争议发生前改变结果"}]
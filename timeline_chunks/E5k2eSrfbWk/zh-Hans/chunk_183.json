[{"type": "subtitle", "time": 10980.63, "timestamp": "03:03:00", "text": "实际上我们需要这个，我们不需要这个"}, {"type": "subtitle", "time": 10984.15, "timestamp": "03:03:04", "text": "伙计，呃，撕裂刀子，我会的，我甚至会接受"}, {"type": "subtitle", "time": 10988.429, "timestamp": "03:03:08", "text": "我不知道，但这取决于斧头或"}, {"type": "subtitle", "time": 10989.269, "timestamp": "03:03:09", "text": "撕裂"}, {"type": "subtitle", "time": 10992.87, "timestamp": "03:03:12", "text": "我认为斧头更好，所以我觉得我们"}, {"type": "subtitle", "time": 10995.51, "timestamp": "03:03:15", "text": "把这个人放进去"}, {"type": "subtitle", "time": 10998.429, "timestamp": "03:03:18", "text": "这里呃"}, {"type": "subtitle", "time": 11000.83, "timestamp": "03:03:20", "text": "所以，让我们"}, {"type": "subtitle", "time": 11004.11, "timestamp": "03:03:24", "text": "呃，我不想携带更多枪支。"}, {"type": "subtitle", "time": 11006.55, "timestamp": "03:03:26", "text": "但这也是你需要考虑的一点。"}, {"type": "subtitle", "time": 11008.59, "timestamp": "03:03:28", "text": "知道了"}, {"type": "subtitle", "time": 11010.67, "timestamp": "03:03:30", "text": "步枪"}, {"type": "subtitle", "time": 11027.87, "timestamp": "03:03:47", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6360.229, "timestamp": "01:46:00", "text": "现在账户已开通，日程安排已公布。"}, {"type": "subtitle", "time": 6362.43, "timestamp": "01:46:02", "text": "日程安排是"}, {"type": "subtitle", "time": 6367.109, "timestamp": "01:46:07", "text": "在这里您可以收到所有消息"}, {"type": "subtitle", "time": 6369.99, "timestamp": "01:46:09", "text": "她是个大块头，而且作息时间很乱。"}, {"type": "subtitle", "time": 6392.109, "timestamp": "01:46:32", "text": "秋天"}, {"type": "subtitle", "time": 6398.109, "timestamp": "01:46:38", "text": "你想让我退后，伙计。"}, {"type": "subtitle", "time": 6409.27, "timestamp": "01:46:49", "text": "[音乐]"}]
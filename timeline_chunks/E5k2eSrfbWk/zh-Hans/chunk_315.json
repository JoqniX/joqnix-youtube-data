[{"type": "subtitle", "time": 18902.91, "timestamp": "05:15:02", "text": "等等，我等了两次，嗯，等等。"}, {"type": "subtitle", "time": 18905.23, "timestamp": "05:15:05", "text": "对，我不记得了。"}, {"type": "subtitle", "time": 18907.43, "timestamp": "05:15:07", "text": "其实我没有"}, {"type": "subtitle", "time": 18911.03, "timestamp": "05:15:11", "text": "记得吗？哦，天哪，你好，妮娅米，我是"}, {"type": "subtitle", "time": 18920.43, "timestamp": "05:15:20", "text": "你好，我附议"}, {"type": "subtitle", "time": 18923.59, "timestamp": "05:15:23", "text": "D 他在脸上说别担心"}, {"type": "subtitle", "time": 18927.59, "timestamp": "05:15:27", "text": "蓝猫，别担心。"}, {"type": "subtitle", "time": 18931.11, "timestamp": "05:15:31", "text": "我的脸只有在需要的时候才会出现。"}, {"type": "subtitle", "time": 18945.628, "timestamp": "05:15:45", "text": "所以，轮到你了。"}, {"type": "subtitle", "time": 18948.91, "timestamp": "05:15:48", "text": "好的，呃，我要去扩香器一号了。"}]
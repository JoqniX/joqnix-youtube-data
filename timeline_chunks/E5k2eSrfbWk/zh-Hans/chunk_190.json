[{"type": "subtitle", "time": 11404.91, "timestamp": "03:10:04", "text": "我把它用完了"}, {"type": "subtitle", "time": 11439.11, "timestamp": "03:10:39", "text": "等等等等等等，我忘了我我"}, {"type": "subtitle", "time": 11442.71, "timestamp": "03:10:42", "text": "把一些东西倒在了所有地方"}, {"type": "subtitle", "time": 11445.95, "timestamp": "03:10:45", "text": "对，我忘了给她带些东西。"}, {"type": "subtitle", "time": 11448.95, "timestamp": "03:10:48", "text": "正确加载它们"}, {"type": "subtitle", "time": 11451.87, "timestamp": "03:10:51", "text": "我把一些东西倒在了摩根身上，"}, {"type": "subtitle", "time": 11454.469, "timestamp": "03:10:54", "text": "就像那个机器人一样，对吧？让我卖掉它"}, {"type": "subtitle", "time": 11456.95, "timestamp": "03:10:56", "text": "那些东西，还有这个地方，就只是"}]
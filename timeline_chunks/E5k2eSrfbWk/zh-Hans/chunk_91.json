[{"type": "subtitle", "time": 5461.43, "timestamp": "01:31:01", "text": "我想，如果能做到这一点，我就去吧。"}, {"type": "subtitle", "time": 5463.79, "timestamp": "01:31:03", "text": "现在它关门了。"}, {"type": "subtitle", "time": 5465.87, "timestamp": "01:31:05", "text": "我告诉他们这是某某。"}, {"type": "subtitle", "time": 5468.99, "timestamp": "01:31:08", "text": "这个问题你采取了什么措施吗？"}, {"type": "subtitle", "time": 5479.39, "timestamp": "01:31:19", "text": "所有船只 我要去的地方"}, {"type": "subtitle", "time": 5482.07, "timestamp": "01:31:22", "text": "新星银河故事 Orting 来自平滑"}, {"type": "subtitle", "time": 5483.669, "timestamp": "01:31:23", "text": "是啊是啊，我知道整个地方都是"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "委员会"}, {"type": "subtitle", "time": 5486.669, "timestamp": "01:31:26", "text": "我需要一些零件用于紧急维修。"}, {"type": "subtitle", "time": 5489.43, "timestamp": "01:31:29", "text": "希望能够进入银河系，那不是……"}, {"type": "subtitle", "time": 5492.31, "timestamp": "01:31:32", "text": "美好的地球以及它周围的一切都是"}, {"type": "subtitle", "time": 5495.35, "timestamp": "01:31:35", "text": "被遗弃的地方是银河系和旧的地方"}]
[{"type": "subtitle", "time": 21426.39, "timestamp": "05:57:06", "text": "耶，这是个好消息"}, {"type": "subtitle", "time": 21427.91, "timestamp": "05:57:07", "text": "这是上层"}, {"type": "subtitle", "time": 21430.628, "timestamp": "05:57:10", "text": "罕见的，我不知道里面装的是什么。"}, {"type": "subtitle", "time": 21433.07, "timestamp": "05:57:13", "text": "我认为这是一个"}, {"type": "subtitle", "time": 21436.07, "timestamp": "05:57:16", "text": "饼干，这就是"}, {"type": "subtitle", "time": 21438.03, "timestamp": "05:57:18", "text": "的"}, {"type": "subtitle", "time": 21441.23, "timestamp": "05:57:21", "text": "铅笔，你知道，呃，我得买的那支笔。"}, {"type": "subtitle", "time": 21444.99, "timestamp": "05:57:24", "text": "就像布料一样，CLE 有六种类型的铅笔 HB"}, {"type": "subtitle", "time": 21448.868, "timestamp": "05:57:28", "text": "2B 4B 6B 8B"}, {"type": "subtitle", "time": 21453.51, "timestamp": "05:57:33", "text": "10B 是的，为了我的日语考试"}, {"type": "subtitle", "time": 21457.91, "timestamp": "05:57:37", "text": "要求您拥有 P 的 2B。"}, {"type": "subtitle", "time": 21459.67, "timestamp": "05:57:39", "text": "是的，你得用铅笔写字，不是吗？"}, {"type": "subtitle", "time": 21461.59, "timestamp": "05:57:41", "text": "笔"}, {"type": "subtitle", "time": 21470.628, "timestamp": "05:57:50", "text": "改变了数量"}, {"type": "subtitle", "time": 21479.39, "timestamp": "05:57:59", "text": "我买的彩色铅笔真是太疯狂了！"}]
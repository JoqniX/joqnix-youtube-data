[{"type": "subtitle", "time": 10205.19, "timestamp": "02:50:05", "text": "[音乐]"}, {"type": "subtitle", "time": 10208.469, "timestamp": "02:50:08", "text": "消音器，所以现在的问题是它不是"}, {"type": "subtitle", "time": 10211.91, "timestamp": "02:50:11", "text": "就像我会拿着这些枪一样"}, {"type": "subtitle", "time": 10214.75, "timestamp": "02:50:14", "text": "我知道这就是我的感受。"}, {"type": "subtitle", "time": 10217.79, "timestamp": "02:50:17", "text": "也许我错了，但我感觉我"}, {"type": "subtitle", "time": 10234.269, "timestamp": "02:50:34", "text": "那我就留一些吧"}, {"type": "subtitle", "time": 10237.59, "timestamp": "02:50:37", "text": "我们只需要四五种类型的枪。"}, {"type": "subtitle", "time": 10240.03, "timestamp": "02:50:40", "text": "对，就是这样，我们不需要额外的。"}]
[{"type": "subtitle", "time": 20883.59, "timestamp": "05:48:03", "text": "是的，是的，所以太阳面包怎么样了？"}, {"type": "subtitle", "time": 20887.43, "timestamp": "05:48:07", "text": "今天，呃，我要做几个问题，去问问。"}, {"type": "subtitle", "time": 20891.07, "timestamp": "05:48:11", "text": "现在这个笑话效果怎么样？我会回复。"}, {"type": "subtitle", "time": 20893.548, "timestamp": "05:48:13", "text": "巴卡骑师做得很好，我醒来时"}, {"type": "subtitle", "time": 20898.39, "timestamp": "05:48:18", "text": "比如凌晨 2 点，下午 2 点。不是上午 2 点，而是下午 2 点。"}, {"type": "subtitle", "time": 20900.39, "timestamp": "05:48:20", "text": "所以昨天直播结束后，我……"}, {"type": "subtitle", "time": 20903.19, "timestamp": "05:48:23", "text": "休息了一会儿，然后我就进入了"}, {"type": "subtitle", "time": 20906.59, "timestamp": "05:48:26", "text": "我在zuki的服务器上玩Minecraft"}, {"type": "subtitle", "time": 20910.51, "timestamp": "05:48:30", "text": "Zak's Apartments Minecraft 服务器"}, {"type": "subtitle", "time": 20912.43, "timestamp": "05:48:32", "text": "是的，我之前在Zak Minecraft服务器上。"}, {"type": "subtitle", "time": 20914.51, "timestamp": "05:48:34", "text": "所以如果你在看Zuki的表演的话"}, {"type": "subtitle", "time": 20916.43, "timestamp": "05:48:36", "text": "昨天直播的时候你应该已经注意到了。"}, {"type": "subtitle", "time": 20917.99, "timestamp": "05:48:37", "text": "我当时"}, {"type": "subtitle", "time": 20921.15, "timestamp": "05:48:41", "text": "在那里，我们一起开始了冒险之旅。"}, {"type": "subtitle", "time": 20925.628, "timestamp": "05:48:45", "text": "你猜怎么着，我们都死了，呃，显然"}, {"type": "subtitle", "time": 20929.07, "timestamp": "05:48:49", "text": "她离开直播间后，直播就结束了。"}, {"type": "subtitle", "time": 20934.19, "timestamp": "05:48:54", "text": "游戏中我拥有她的物品"}, {"type": "subtitle", "time": 20938.628, "timestamp": "05:48:58", "text": "但是，我必须帮他们进行突袭。"}]
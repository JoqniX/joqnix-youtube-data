[{"type": "subtitle", "time": 3781.349, "timestamp": "01:03:01", "text": "提出索赔的申请人必须提交"}, {"type": "subtitle", "time": 3783.91, "timestamp": "01:03:03", "text": "接下来可能会有骗子。"}, {"type": "subtitle", "time": 3786.309, "timestamp": "01:03:06", "text": "完整的联系信息使"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "该船的模型以及"}, {"type": "subtitle", "time": 3790.75, "timestamp": "01:03:10", "text": "对船舶进行的任何改装"}, {"type": "subtitle", "time": 3793.269, "timestamp": "01:03:13", "text": "我们认可的技工之一"}, {"type": "subtitle", "time": 3795.99, "timestamp": "01:03:15", "text": "此外，我们还需要授权"}, {"type": "subtitle", "time": 3798.87, "timestamp": "01:03:18", "text": "服务经销商联系信息"}, {"type": "subtitle", "time": 3800.589, "timestamp": "01:03:20", "text": "请描述您遇到的问题。"}, {"type": "subtitle", "time": 3803.19, "timestamp": "01:03:23", "text": "组件是您寻求的分辨率"}, {"type": "subtitle", "time": 3806.109, "timestamp": "01:03:26", "text": "以金钱或全额更换的方式，以及"}, {"type": "subtitle", "time": 3808.67, "timestamp": "01:03:28", "text": "已签署的信息发布副本"}, {"type": "subtitle", "time": 3811.349, "timestamp": "01:03:31", "text": "豁免申请者还需要"}, {"type": "subtitle", "time": 3813.309, "timestamp": "01:03:33", "text": "提交船舶日志，涵盖整个航行期间"}, {"type": "subtitle", "time": 3815.71, "timestamp": "01:03:35", "text": "使用了所讨论的部分或部件。"}, {"type": "subtitle", "time": 3817.549, "timestamp": "01:03:37", "text": "三人的联系方式"}, {"type": "subtitle", "time": 3819.75, "timestamp": "01:03:39", "text": "前任业主和我们的客户"}, {"type": "subtitle", "time": 3822.43, "timestamp": "01:03:42", "text": "我可以放弃满意保证吗？"}, {"type": "subtitle", "time": 3824.52, "timestamp": "01:03:44", "text": "继续"}, {"type": "subtitle", "time": 3826.19, "timestamp": "01:03:46", "text": "[音乐]"}, {"type": "subtitle", "time": 3828.63, "timestamp": "01:03:48", "text": "听起来你对……感兴趣"}, {"type": "subtitle", "time": 3831.069, "timestamp": "01:03:51", "text": "了解更多信息后，我们发现有多个层级"}, {"type": "subtitle", "time": 3833.47, "timestamp": "01:03:53", "text": "请仔细聆听保修条款"}, {"type": "subtitle", "time": 3836.069, "timestamp": "01:03:56", "text": "情况可能已经发生了变化"}, {"type": "subtitle", "time": 3838.19, "timestamp": "01:03:58", "text": "电厂附加计划提供保障"}]
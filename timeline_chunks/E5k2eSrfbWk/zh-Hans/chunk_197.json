[{"type": "subtitle", "time": 11825.6, "timestamp": "03:17:05", "text": "哦"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "[音乐]"}, {"type": "subtitle", "time": 11840.15, "timestamp": "03:17:20", "text": "等等，你看，终于有艘船了。"}, {"type": "subtitle", "time": 11842.349, "timestamp": "03:17:22", "text": "只是漫无目的地游荡，没有时间考虑。"}, {"type": "subtitle", "time": 11852.07, "timestamp": "03:17:32", "text": "先锋号，出问题了，飞船……"}, {"type": "subtitle", "time": 11860.87, "timestamp": "03:17:40", "text": "准备好躲避炮火，以免平民被船只击中"}, {"type": "subtitle", "time": 11863.99, "timestamp": "03:17:43", "text": "如果你停止向我们开枪，我们就会"}, {"type": "subtitle", "time": 11867.75, "timestamp": "03:17:47", "text": "非常乐意回复"}, {"type": "subtitle", "time": 11870.229, "timestamp": "03:17:50", "text": "其中一些涂上了白色内衬，但它们"}, {"type": "subtitle", "time": 11872.67, "timestamp": "03:17:52", "text": "被困在家真的需要……"}, {"type": "subtitle", "time": 11875.03, "timestamp": "03:17:55", "text": "协助将那艘船从星际中炸飞"}, {"type": "subtitle", "time": 11877.03, "timestamp": "03:17:57", "text": "他死了，我们的神器也丢了。"}]
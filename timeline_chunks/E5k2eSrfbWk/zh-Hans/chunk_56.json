[{"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "饿了，另一个山洞里"}, {"type": "subtitle", "time": 3383.95, "timestamp": "00:56:23", "text": "想象一下，一切都将结束。"}, {"type": "subtitle", "time": 3393.549, "timestamp": "00:56:33", "text": "哦，他们正在互相打架。"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "我看到了另一个"}, {"type": "subtitle", "time": 3407.27, "timestamp": "00:56:47", "text": "莎拉，你到底在干什么？你到底哪里出了问题？"}]
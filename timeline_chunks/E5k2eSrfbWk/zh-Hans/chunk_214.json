[{"type": "subtitle", "time": 12840.71, "timestamp": "03:34:00", "text": "那句话不好，我们应该克服它。"}, {"type": "chat", "time": 12844.635, "timestamp": "03:34:04", "author": "@christopherabrahams8923", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lXNBnVor2T5FVc9Go-w378cXn6JmX-YLkW1G6mVZyFzwgLjg01XTaBOrjvCuKmfuRq9g=s64-c-k-c0x00ffffff-no-rj", "message": "hey joq"}, {"type": "subtitle", "time": 12850.71, "timestamp": "03:34:10", "text": "好的，谁"}, {"type": "subtitle", "time": 12852.99, "timestamp": "03:34:12", "text": "山姆，你第一次出现的时候他不在。"}, {"type": "subtitle", "time": 12856.11, "timestamp": "03:34:16", "text": "他现在应该已经回来了，我会让他回来的。"}, {"type": "subtitle", "time": 12859.469, "timestamp": "03:34:19", "text": "如果我偷东西，就让他负责介绍。"}, {"type": "subtitle", "time": 12863.269, "timestamp": "03:34:23", "text": "领主接到了很多任务"}, {"type": "subtitle", "time": 12866.309, "timestamp": "03:34:26", "text": "呃，你能告诉我一些关于他的事吗？"}, {"type": "subtitle", "time": 12869.55, "timestamp": "03:34:29", "text": "思绪总是飘向远方，但却无处可寻。"}, {"type": "subtitle", "time": 12871.469, "timestamp": "03:34:31", "text": "他认为自己天生就擅长站在正确的一边"}, {"type": "subtitle", "time": 12874.11, "timestamp": "03:34:34", "text": "在错误的时间出现在错误的地方，真是太糟糕了。"}, {"type": "subtitle", "time": 12875.51, "timestamp": "03:34:35", "text": "无法预见这些文物会到来。"}, {"type": "subtitle", "time": 12877.59, "timestamp": "03:34:37", "text": "当他们在一起时，他会非常兴奋"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "当他到达目的地时，他看起来很兴奋"}, {"type": "subtitle", "time": 12880.67, "timestamp": "03:34:40", "text": "你看，他根本不会意识到自己是"}, {"type": "subtitle", "time": 12881.95, "timestamp": "03:34:41", "text": "错过"}, {"type": "subtitle", "time": 12884.99, "timestamp": "03:34:44", "text": "任何事，什么是“我”？谁是明星？"}, {"type": "subtitle", "time": 12886.95, "timestamp": "03:34:46", "text": "空间站位于我们上方的轨道上，我们就在那里。"}, {"type": "subtitle", "time": 12889.51, "timestamp": "03:34:49", "text": "完成我们所有的深空扫描，没问题。"}, {"type": "subtitle", "time": 12892.03, "timestamp": "03:34:52", "text": "弗拉基米尔把电台管理得非常出色。"}]
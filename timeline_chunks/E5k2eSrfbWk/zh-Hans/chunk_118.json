[{"type": "subtitle", "time": 7081.47, "timestamp": "01:58:01", "text": "不好，不过也许下次有机会吧。"}, {"type": "subtitle", "time": 7083.95, "timestamp": "01:58:03", "text": "把我的杂物都拿走吧，非常感谢。"}, {"type": "subtitle", "time": 7103.39, "timestamp": "01:58:23", "text": "天哪，他们为什么吃那么多饭？"}, {"type": "subtitle", "time": 7106.47, "timestamp": "01:58:26", "text": "外星人管那叫炒蛋。"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "外星人争夺战或"}, {"type": "subtitle", "time": 7111.35, "timestamp": "01:58:31", "text": "哦，有……有……被咬了"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "有人吃了那个三明治。"}, {"type": "subtitle", "time": 7128.51, "timestamp": "01:58:48", "text": "方式"}]
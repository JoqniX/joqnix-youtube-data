[{"type": "subtitle", "time": 13323.83, "timestamp": "03:42:03", "text": "来到星空，我可能会去朗"}, {"type": "subtitle", "time": 13326.91, "timestamp": "03:42:06", "text": "直播，但很可能记得"}, {"type": "subtitle", "time": 13329.79, "timestamp": "03:42:09", "text": "我的大部分直播时长都是2小时或更长。"}, {"type": "subtitle", "time": 13333.189, "timestamp": "03:42:13", "text": "三个小时，最多四个小时，好的。"}, {"type": "subtitle", "time": 13335.55, "timestamp": "03:42:15", "text": "是的，除了少数几个直播流，比如……"}, {"type": "subtitle", "time": 13336.75, "timestamp": "03:42:16", "text": "歌唱"}, {"type": "subtitle", "time": 13339.83, "timestamp": "03:42:19", "text": "流媒体播放《星空》所有这些"}, {"type": "subtitle", "time": 13343.429, "timestamp": "03:42:23", "text": "嗨，是的，所以明天我们要去……"}, {"type": "subtitle", "time": 13346.229, "timestamp": "03:42:26", "text": "做决斗，我们会是"}, {"type": "subtitle", "time": 13349.389, "timestamp": "03:42:29", "text": "学习日语，好的，我会看看"}, {"type": "subtitle", "time": 13353.389, "timestamp": "03:42:33", "text": "展望明天的内容，我们……"}, {"type": "subtitle", "time": 13355.349, "timestamp": "03:42:35", "text": "我们会回顾一些东西，"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "最后完成"}, {"type": "subtitle", "time": 13360.429, "timestamp": "03:42:40", "text": "好的，所以所有来过的人"}, {"type": "subtitle", "time": 13378.07, "timestamp": "03:42:58", "text": "欢迎回来！"}]
[{"type": "subtitle", "time": 18061.708, "timestamp": "05:01:01", "text": "新事物，你在天堂快乐吗？"}, {"type": "subtitle", "time": 18064.628, "timestamp": "05:01:04", "text": "等等，什么？我不是"}, {"type": "subtitle", "time": 18071.51, "timestamp": "05:01:11", "text": "炸弹死了，嗨，这里很黑。"}, {"type": "subtitle", "time": 18075.788, "timestamp": "05:01:15", "text": "什么也看不见，传说中的炸弹啊"}, {"type": "subtitle", "time": 18080.23, "timestamp": "05:01:20", "text": "哦不，我可以，这里有个键盘"}, {"type": "subtitle", "time": 18082.708, "timestamp": "05:01:22", "text": "然后还有符号"}, {"type": "subtitle", "time": 18087.19, "timestamp": "05:01:27", "text": "电线，然后还有，哦不，迷宫，哦"}, {"type": "subtitle", "time": 18097.07, "timestamp": "05:01:37", "text": "迷宫，呃，我们先做简单的吧。"}, {"type": "subtitle", "time": 18100.19, "timestamp": "05:01:40", "text": "是的，嘘"}, {"type": "subtitle", "time": 18104.31, "timestamp": "05:01:44", "text": "所以，呃，这里有个笑脸"}, {"type": "subtitle", "time": 18107.67, "timestamp": "05:01:47", "text": "舌头伸出来"}, {"type": "subtitle", "time": 18111.15, "timestamp": "05:01:51", "text": "好的，那这里有个带t的b。"}, {"type": "subtitle", "time": 18112.628, "timestamp": "05:01:52", "text": "它走了"}, {"type": "subtitle", "time": 18115.67, "timestamp": "05:01:55", "text": "然后是一个普通的C，中间带点。"}, {"type": "subtitle", "time": 18117.67, "timestamp": "05:01:57", "text": "中间嗯嗯，明白了"}]
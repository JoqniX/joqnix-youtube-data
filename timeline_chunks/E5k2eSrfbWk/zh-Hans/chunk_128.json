[{"type": "subtitle", "time": 7710.109, "timestamp": "02:08:30", "text": "这难道不是你第一次来吗？"}, {"type": "subtitle", "time": 7714.189, "timestamp": "02:08:34", "text": "欢迎来到我的频道"}, {"type": "subtitle", "time": 7716.91, "timestamp": "02:08:36", "text": "奥斯汀，等等，这个怎么发音？"}, {"type": "subtitle", "time": 7720.109, "timestamp": "02:08:40", "text": "名字是范达·森，谢谢，这是这个"}, {"type": "subtitle", "time": 7723.189, "timestamp": "02:08:43", "text": "你第一次来"}, {"type": "subtitle", "time": 7725.51, "timestamp": "02:08:45", "text": "如果是第一次，请稍等片刻。"}, {"type": "subtitle", "time": 7728.35, "timestamp": "02:08:48", "text": "你听得出我的声音很疲惫吗？"}, {"type": "subtitle", "time": 7731.669, "timestamp": "02:08:51", "text": "某个问号，或者那是……"}]
[{"type": "subtitle", "time": 8222.87, "timestamp": "02:17:02", "text": "标志性人物，在你问之前，不，我不是。"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "乐队其实从来没真正离开过。"}, {"type": "subtitle", "time": 8228.87, "timestamp": "02:17:08", "text": "很好，我们交换吧，我会很高兴的。"}, {"type": "subtitle", "time": 8232.03, "timestamp": "02:17:12", "text": "她要带的东西真多啊！"}, {"type": "subtitle", "time": 8235.07, "timestamp": "02:17:15", "text": "我感觉很糟糕，但同时这也是"}, {"type": "subtitle", "time": 8238.07, "timestamp": "02:17:18", "text": "需要你"}, {"type": "subtitle", "time": 8248.27, "timestamp": "02:17:28", "text": "莎拉再也抱不动了，哦，我的天哪"}, {"type": "subtitle", "time": 8250.549, "timestamp": "02:17:30", "text": "上帝"}, {"type": "subtitle", "time": 8255.19, "timestamp": "02:17:35", "text": "好吧，我完蛋了，我彻底完蛋了，好吧。"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "等等，我这就去做。"}, {"type": "subtitle", "time": 8260.91, "timestamp": "02:17:40", "text": "把枪给我，我就……"}, {"type": "subtitle", "time": 8262.75, "timestamp": "02:17:42", "text": "我走了，我把它扔掉就行了。"}, {"type": "subtitle", "time": 8273.03, "timestamp": "02:17:53", "text": "结束吧，你那边没问题，我就……"}]
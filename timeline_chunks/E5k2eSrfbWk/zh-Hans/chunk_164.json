[{"type": "subtitle", "time": 9851.07, "timestamp": "02:44:11", "text": "电梯哦"}, {"type": "subtitle", "time": 9853.55, "timestamp": "02:44:13", "text": "孩子，如果你想买点什么，我"}, {"type": "subtitle", "time": 9857.389, "timestamp": "02:44:17", "text": "当然，阿莫利可以帮到你，你也可以，我"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "恐怕这些自助服务亭会涵盖所有基本内容。"}, {"type": "subtitle", "time": 9861.26, "timestamp": "02:44:21", "text": "您可能有的问题"}, {"type": "subtitle", "time": 9873.23, "timestamp": "02:44:33", "text": "本身，嘿，没什么好玩的。"}, {"type": "subtitle", "time": 9878.11, "timestamp": "02:44:38", "text": "助推包的善意，我现在在这里是为了"}, {"type": "subtitle", "time": 9880.07, "timestamp": "02:44:40", "text": "在我的家族中"}, {"type": "subtitle", "time": 9883.07, "timestamp": "02:44:43", "text": "除了做其他工作之外，我还做了一些零工。"}, {"type": "subtitle", "time": 9884.95, "timestamp": "02:44:44", "text": "工作"}, {"type": "subtitle", "time": 9888.23, "timestamp": "02:44:48", "text": "好吧，我的确是，这正是我……的原因"}, {"type": "subtitle", "time": 9896.67, "timestamp": "02:44:56", "text": "就像你肯定会喜欢的那种优秀品质一样。"}, {"type": "subtitle", "time": 9899.15, "timestamp": "02:44:59", "text": "AR 返回“哦，我没有做侧面”"}]
[{"type": "subtitle", "time": 12780.71, "timestamp": "03:33:00", "text": "一起"}, {"type": "subtitle", "time": 12783.309, "timestamp": "03:33:03", "text": "顺便问一下，您想怎么做？"}, {"type": "subtitle", "time": 12785.79, "timestamp": "03:33:05", "text": "继续一起旅行，我不会坐下。"}, {"type": "subtitle", "time": 12787.429, "timestamp": "03:33:07", "text": "她想坐在我的办公桌后面……"}, {"type": "subtitle", "time": 12789.309, "timestamp": "03:33:09", "text": "旅行这些文物开启了新的篇章。"}, {"type": "subtitle", "time": 12792.79, "timestamp": "03:33:12", "text": "至于漫展，我肯定会去参加。"}, {"type": "subtitle", "time": 12796.91, "timestamp": "03:33:16", "text": "我也希望你们能参与进来，你们有"}, {"type": "subtitle", "time": 12799.349, "timestamp": "03:33:19", "text": "结果我需要像你这样的人来监督"}, {"type": "subtitle", "time": 12800.189, "timestamp": "03:33:20", "text": "我的"}, {"type": "subtitle", "time": 12804.189, "timestamp": "03:33:24", "text": "回去，我们回去吧，嗯，回来，是的，全部"}, {"type": "subtitle", "time": 12806.309, "timestamp": "03:33:26", "text": "好的，我们还有一些线索。"}, {"type": "subtitle", "time": 12809.189, "timestamp": "03:33:29", "text": "首先应该谈谈……"}, {"type": "subtitle", "time": 12811.269, "timestamp": "03:33:31", "text": "Samco一直在进行的探险"}, {"type": "subtitle", "time": 12813.429, "timestamp": "03:33:33", "text": "它一起属于自由星集体"}, {"type": "subtitle", "time": 12816.389, "timestamp": "03:33:36", "text": "他对太空了如指掌，一清二楚。"}, {"type": "subtitle", "time": 12819.189, "timestamp": "03:33:39", "text": "还有我们的明星"}, {"type": "subtitle", "time": 12822.59, "timestamp": "03:33:42", "text": "弗拉基米尔车站大约在某个时间点，他一直在那里"}, {"type": "subtitle", "time": 12824.71, "timestamp": "03:33:44", "text": "努力工作中，哦，那就是那个制作……的人"}, {"type": "subtitle", "time": 12826.429, "timestamp": "03:33:46", "text": "呃，你为了"}, {"type": "subtitle", "time": 12828.87, "timestamp": "03:33:48", "text": "那会让你赚很多钱"}, {"type": "subtitle", "time": 12831.189, "timestamp": "03:33:51", "text": "巴雷特的任何物品，以及来自快递员的任何东西"}, {"type": "subtitle", "time": 12833.03, "timestamp": "03:33:53", "text": "Aros 萃取机过来通知我们"}, {"type": "subtitle", "time": 12834.71, "timestamp": "03:33:54", "text": "他们正在收拾残局，准备结束行动。"}, {"type": "subtitle", "time": 12837.55, "timestamp": "03:33:57", "text": "维克塔，仅此而已，没有其他了。"}]
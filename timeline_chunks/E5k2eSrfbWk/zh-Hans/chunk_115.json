[{"type": "subtitle", "time": 6901.229, "timestamp": "01:55:01", "text": "布拉德做饭，你什么都没做"}, {"type": "subtitle", "time": 6912.189, "timestamp": "01:55:12", "text": "我回来时手里拿着一个空瓶子和一个金属蛋。"}, {"type": "subtitle", "time": 6930.149, "timestamp": "01:55:30", "text": "好了，钩子钩住了"}, {"type": "subtitle", "time": 6939.79, "timestamp": "01:55:39", "text": "我需要一种能保持形状的三明治"}, {"type": "subtitle", "time": 6943.87, "timestamp": "01:55:43", "text": "给我健康加强版 602，5 美元"}, {"type": "subtitle", "time": 6947.47, "timestamp": "01:55:47", "text": "三分钟 健康三 健康编号"}, {"type": "subtitle", "time": 6956.95, "timestamp": "01:55:56", "text": "我没有水，我也没有火腿。"}]
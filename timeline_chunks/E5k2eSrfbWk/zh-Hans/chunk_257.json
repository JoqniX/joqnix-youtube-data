[{"type": "subtitle", "time": 15423.87, "timestamp": "04:17:03", "text": "拿到了符号、电线和大型BT设备"}, {"type": "subtitle", "time": 15426.03, "timestamp": "04:17:06", "text": "大按钮，你觉得哪个好？"}, {"type": "subtitle", "time": 15428.51, "timestamp": "04:17:08", "text": "首先，呃，符号，电线"}, {"type": "subtitle", "time": 15430.389, "timestamp": "04:17:10", "text": "大按钮，然后呢？"}, {"type": "subtitle", "time": 15433.149, "timestamp": "04:17:13", "text": "否则就只有三个符号和"}, {"type": "subtitle", "time": 15435.389, "timestamp": "04:17:15", "text": "按钮里的电线，让我们来做这件难事。"}, {"type": "subtitle", "time": 15437.349, "timestamp": "04:17:17", "text": "首先，我们来做……"}, {"type": "subtitle", "time": 15443.83, "timestamp": "04:17:23", "text": "符号 符号 是的，好的，所以我们有"}, {"type": "subtitle", "time": 15446.91, "timestamp": "04:17:26", "text": "五角星就像……"}, {"type": "subtitle", "time": 15448.309, "timestamp": "04:17:28", "text": "来自炸弹"}, {"type": "subtitle", "time": 15451.469, "timestamp": "04:17:31", "text": "早些时候，哦，是的，明星，电影明星"}, {"type": "subtitle", "time": 15458.59, "timestamp": "04:17:38", "text": "好的，那还有那个高级版3，是的。"}, {"type": "subtitle", "time": 15461.63, "timestamp": "04:17:41", "text": "还有笑脸"}, {"type": "subtitle", "time": 15464.99, "timestamp": "04:17:44", "text": "是的，然后还有一些其他的事情。"}, {"type": "subtitle", "time": 15469.07, "timestamp": "04:17:49", "text": "那看起来像个三叉戟。"}, {"type": "subtitle", "time": 15472.71, "timestamp": "04:17:52", "text": "三叉戟 哦，呃，三叉戟 哦，我明白了，是"}, {"type": "subtitle", "time": 15476.309, "timestamp": "04:17:56", "text": "就像哦耶，像三叉戟一样的蜡烛"}, {"type": "subtitle", "time": 15479.229, "timestamp": "04:17:59", "text": "对，他们都应该在里面。"}]
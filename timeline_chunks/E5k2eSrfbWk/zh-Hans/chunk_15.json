[{"type": "subtitle", "time": 936.15, "timestamp": "00:15:36", "text": "只是"}, {"type": "subtitle", "time": 940.35, "timestamp": "00:15:40", "text": "莎拉快跑，别死！我求求你！"}, {"type": "subtitle", "time": 943.509, "timestamp": "00:15:43", "text": "我恳求你"}, {"type": "subtitle", "time": 955.389, "timestamp": "00:15:55", "text": "我爱她，她依然如此。"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "战斗啊我的天"}]
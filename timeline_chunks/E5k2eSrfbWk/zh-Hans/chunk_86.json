[{"type": "subtitle", "time": 5161.75, "timestamp": "01:26:01", "text": "我不太确定，但我相信"}, {"type": "subtitle", "time": 5165.47, "timestamp": "01:26:05", "text": "我的意思是，那就是"}, {"type": "subtitle", "time": 5167.03, "timestamp": "01:26:07", "text": "[音乐]"}, {"type": "subtitle", "time": 5170.31, "timestamp": "01:26:10", "text": "嗯……我们还是先做主线任务吧。"}, {"type": "subtitle", "time": 5172.42, "timestamp": "01:26:12", "text": "整个社区"}, {"type": "subtitle", "time": 5189.83, "timestamp": "01:26:29", "text": "是的"}, {"type": "subtitle", "time": 5200.99, "timestamp": "01:26:40", "text": "那么，你好，我们这里有什么？"}, {"type": "subtitle", "time": 5204.629, "timestamp": "01:26:44", "text": "一群船，席恩·狂热者，你曾经有过"}, {"type": "subtitle", "time": 5205.95, "timestamp": "01:26:45", "text": "遭遇"}, {"type": "subtitle", "time": 5209.149, "timestamp": "01:26:49", "text": "一个完全致力于他们称之为"}, {"type": "subtitle", "time": 5212.59, "timestamp": "01:26:52", "text": "吞噬一切的巨蛇"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "不信者们，我让你们猜猜是什么"}]
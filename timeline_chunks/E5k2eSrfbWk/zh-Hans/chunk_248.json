[{"type": "subtitle", "time": 14880.95, "timestamp": "04:08:00", "text": "欢迎来到直播间，Ren，你好吗？"}, {"type": "subtitle", "time": 14890.269, "timestamp": "04:08:10", "text": "我知道已经有人带着"}, {"type": "subtitle", "time": 14894.229, "timestamp": "04:08:14", "text": "一把我不敢带的刀"}, {"type": "subtitle", "time": 14897.75, "timestamp": "04:08:17", "text": "刀，它太……"}, {"type": "subtitle", "time": 14900.109, "timestamp": "04:08:20", "text": "疼痛，等等，为什么？"}, {"type": "subtitle", "time": 14905.109, "timestamp": "04:08:25", "text": "疼痛，为什么会痛？又像……嗯……如果"}, {"type": "subtitle", "time": 14909.75, "timestamp": "04:08:29", "text": "我不小心点赞了……嗯，怎么说呢？"}, {"type": "subtitle", "time": 14913.109, "timestamp": "04:08:33", "text": "嗯……比如，如果我不小心……我的"}, {"type": "subtitle", "time": 14915.349, "timestamp": "04:08:35", "text": "手滑了，我伤到了自己。"}, {"type": "subtitle", "time": 14917.309, "timestamp": "04:08:37", "text": "因为我是"}, {"type": "subtitle", "time": 14919.79, "timestamp": "04:08:39", "text": "笨手笨脚的人，谁知道呢，你永远不会知道。"}, {"type": "subtitle", "time": 14921.269, "timestamp": "04:08:41", "text": "绝不"}, {"type": "subtitle", "time": 14926.149, "timestamp": "04:08:46", "text": "我知道大家都明白了，等等，Z在聊天里说什么什么"}, {"type": "subtitle", "time": 14928.87, "timestamp": "04:08:48", "text": "时机哦"}, {"type": "subtitle", "time": 14932.95, "timestamp": "04:08:52", "text": "上帝啊，推特需要什么？哦，你是说……"}]
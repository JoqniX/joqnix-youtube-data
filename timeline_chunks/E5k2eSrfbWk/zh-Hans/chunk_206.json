[{"type": "subtitle", "time": 12366.07, "timestamp": "03:26:06", "text": "你遇到的每个人看起来都像我们所有人一样"}, {"type": "subtitle", "time": 12367.83, "timestamp": "03:26:07", "text": "每天都能毫发无损地从任何地方走出来"}, {"type": "subtitle", "time": 12369.83, "timestamp": "03:26:09", "text": "你离开的那一天"}, {"type": "subtitle", "time": 12372.15, "timestamp": "03:26:12", "text": "直接从探索者星座出发，我们"}, {"type": "subtitle", "time": 12375.189, "timestamp": "03:26:15", "text": "需要聊聊，你们这些人还存在吗？"}, {"type": "subtitle", "time": 12376.83, "timestamp": "03:26:16", "text": "我只听过一些故事。"}, {"type": "subtitle", "time": 12379.51, "timestamp": "03:26:19", "text": "我们也听说过一些关于……的故事"}, {"type": "subtitle", "time": 12383.03, "timestamp": "03:26:23", "text": "是的，你在巡逻时发现了一个奇怪的物体。"}, {"type": "subtitle", "time": 12385.95, "timestamp": "03:26:25", "text": "所以你知道我试过的那东西是什么吗？"}, {"type": "subtitle", "time": 12387.59, "timestamp": "03:26:27", "text": "在西多尼亚和霍克那里，还有那个家伙"}, {"type": "subtitle", "time": 12389.59, "timestamp": "03:26:29", "text": "以为我在假装"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "钛金属和它不太相容"}, {"type": "subtitle", "time": 12393.91, "timestamp": "03:26:33", "text": "对某些人来说，扫描仪毫无价值。"}, {"type": "subtitle", "time": 12395.87, "timestamp": "03:26:35", "text": "试图倒卖稀有矿物"}, {"type": "subtitle", "time": 12398.269, "timestamp": "03:26:38", "text": "所以你的意思是，我不应该这么快"}, {"type": "subtitle", "time": 12401.03, "timestamp": "03:26:41", "text": "把它当帽子用"}, {"type": "subtitle", "time": 12404.309, "timestamp": "03:26:44", "text": "装饰品，呃，嘿，我愿意交换一些奇怪的东西。"}, {"type": "subtitle", "time": 12406.83, "timestamp": "03:26:46", "text": "太空岩石随时待命，准备救援"}, {"type": "subtitle", "time": 12408.389, "timestamp": "03:26:48", "text": "希望你能弄明白那件事。"}]
[{"type": "subtitle", "time": 8176.35, "timestamp": "02:16:16", "text": "对，我又想说我的"}, {"type": "subtitle", "time": 8178.709, "timestamp": "02:16:18", "text": "垃圾给你"}, {"type": "subtitle", "time": 8181.629, "timestamp": "02:16:21", "text": "我又一次又一次地收到金的来信"}, {"type": "subtitle", "time": 8185.39, "timestamp": "02:16:25", "text": "我来告诉你，我们在哪里等着。"}, {"type": "subtitle", "time": 8192.19, "timestamp": "02:16:32", "text": "哦，你在这儿啊。"}, {"type": "subtitle", "time": 8194.629, "timestamp": "02:16:34", "text": "是什么"}, {"type": "subtitle", "time": 8205.27, "timestamp": "02:16:45", "text": "说完这些，在我毕业之前。"}, {"type": "subtitle", "time": 8210.549, "timestamp": "02:16:50", "text": "从学校起我就一直在乐队里，现在我"}, {"type": "subtitle", "time": 8214.589, "timestamp": "02:16:54", "text": "我说的不是学校乐队，我说的是摇滚乐。"}, {"type": "subtitle", "time": 8219.87, "timestamp": "02:16:59", "text": "我们乐队自称讽刺彗星"}]
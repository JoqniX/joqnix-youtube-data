[{"type": "subtitle", "time": 5723.03, "timestamp": "01:35:23", "text": "银河系哦这家伙哦新星银河系"}, {"type": "subtitle", "time": 5724.39, "timestamp": "01:35:24", "text": "星形院子"}, {"type": "subtitle", "time": 5727.229, "timestamp": "01:35:27", "text": "仍在绕地球运行"}, {"type": "subtitle", "time": 5729.07, "timestamp": "01:35:29", "text": "月亮，这是第一个"}, {"type": "subtitle", "time": 5730.51, "timestamp": "01:35:30", "text": "星际穿越"}, {"type": "subtitle", "time": 5734.149, "timestamp": "01:35:34", "text": "即使如此，船员们仍然在使用他们的模块。"}, {"type": "subtitle", "time": 5735.669, "timestamp": "01:35:35", "text": "尽管他们星光熠熠的院子还没有……"}, {"type": "subtitle", "time": 5740.87, "timestamp": "01:35:40", "text": "永远"}, {"type": "subtitle", "time": 5743.47, "timestamp": "01:35:43", "text": "呃，我想知道我们为什么会这样。"}, {"type": "subtitle", "time": 5745.709, "timestamp": "01:35:45", "text": "算了吧，那都已经是过去的事了。"}, {"type": "subtitle", "time": 5748.95, "timestamp": "01:35:48", "text": "迷失的开始在这个空间里喷洒哦"}, {"type": "subtitle", "time": 5751.149, "timestamp": "01:35:51", "text": "这就是为什么地球看起来像……"}, {"type": "subtitle", "time": 5757.229, "timestamp": "01:35:57", "text": "去了不同的地方"}, {"type": "subtitle", "time": 5759.91, "timestamp": "01:35:59", "text": "你们这些家伙是由不同的政府创办的。"}]
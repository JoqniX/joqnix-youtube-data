[{"type": "subtitle", "time": 7441.109, "timestamp": "02:04:01", "text": "听起来很累？我可不觉得。"}, {"type": "subtitle", "time": 7444.95, "timestamp": "02:04:04", "text": "我知道等等，我听起来怎么样？"}, {"type": "subtitle", "time": 7448.47, "timestamp": "02:04:08", "text": "我累了"}, {"type": "subtitle", "time": 7455.549, "timestamp": "02:04:15", "text": "哦等等，其实如果你睡觉你就会得到"}, {"type": "subtitle", "time": 7459.189, "timestamp": "02:04:19", "text": "你的健康状况实际上非常好"}, {"type": "subtitle", "time": 7461.709, "timestamp": "02:04:21", "text": "真有意思，嗯，这其实……"}, {"type": "subtitle", "time": 7464.87, "timestamp": "02:04:24", "text": "凉爽的地方，你睡觉的时候喜欢……"}, {"type": "subtitle", "time": 7467.87, "timestamp": "02:04:27", "text": "现在你就能恢复健康了"}, {"type": "subtitle", "time": 7470.83, "timestamp": "02:04:30", "text": "区域返回实际上是"}, {"type": "subtitle", "time": 7478.669, "timestamp": "02:04:38", "text": "好的，好的，呃，萨，你能帮我拿一下吗？"}, {"type": "subtitle", "time": 7480.589, "timestamp": "02:04:40", "text": "垃圾又来了，可以随便扔点东西进去。"}, {"type": "subtitle", "time": 7484.109, "timestamp": "02:04:44", "text": "我的包，是的，你已经满了。"}, {"type": "subtitle", "time": 7486.109, "timestamp": "02:04:46", "text": "没完全够，我会给你很多"}, {"type": "subtitle", "time": 7495.709, "timestamp": "02:04:55", "text": "我想我会给她"}, {"type": "subtitle", "time": 7499.31, "timestamp": "02:04:59", "text": "等等，这两个是同一个吗？"}]
[{"type": "subtitle", "time": 5342.149, "timestamp": "01:29:02", "text": "如果我们能靠近那些航母就好了"}, {"type": "subtitle", "time": 5344.27, "timestamp": "01:29:04", "text": "距离足够近，我们可以下载它的"}, {"type": "subtitle", "time": 5346.189, "timestamp": "01:29:06", "text": "记录日志并找出我们的先锋队在哪里"}, {"type": "subtitle", "time": 5358.629, "timestamp": "01:29:18", "text": "H 精确"}, {"type": "subtitle", "time": 5362.189, "timestamp": "01:29:22", "text": "为避免这种情况，请尽量减少船舶动力。"}, {"type": "subtitle", "time": 5365.669, "timestamp": "01:29:25", "text": "像武器系统这样的装置对我们来说是最大限度的"}, {"type": "subtitle", "time": 5368.95, "timestamp": "01:29:28", "text": "比接受一个或两个B的功率还要多"}, {"type": "subtitle", "time": 5372.629, "timestamp": "01:29:32", "text": "就我所能理解的英语而言"}, {"type": "subtitle", "time": 5374.59, "timestamp": "01:29:34", "text": "你可以激活它"}, {"type": "subtitle", "time": 5379.229, "timestamp": "01:29:39", "text": "好的，大多数中心都是"}, {"type": "subtitle", "time": 5388.83, "timestamp": "01:29:48", "text": "星期一，他们"}, {"type": "subtitle", "time": 5392.629, "timestamp": "01:29:52", "text": "哦，伟大的巨蛇，请保佑它。"}, {"type": "subtitle", "time": 5395.229, "timestamp": "01:29:55", "text": "藉此相交，我们便可在迦南中行走"}, {"type": "subtitle", "time": 5396.59, "timestamp": "01:29:56", "text": "维隆的"}, {"type": "subtitle", "time": 5399.629, "timestamp": "01:29:59", "text": "他从灵魂深处跳出的脚步声"}]
[{"type": "subtitle", "time": 18481.788, "timestamp": "05:08:01", "text": "将是顶行，顶部的东西，顶部"}, {"type": "subtitle", "time": 18485.83, "timestamp": "05:08:05", "text": "顶部的东西，对，顶部什么顶部，你怎么……"}, {"type": "subtitle", "time": 18490.99, "timestamp": "05:08:10", "text": "这么说吧，呃，顶部，呃，你看到那些点了。"}, {"type": "subtitle", "time": 18493.91, "timestamp": "05:08:13", "text": "顶部这些被称为柱子或"}, {"type": "subtitle", "time": 18497.31, "timestamp": "05:08:17", "text": "就像一排围棋"}, {"type": "subtitle", "time": 18501.43, "timestamp": "05:08:21", "text": "所谓的垂直方向是指你从"}, {"type": "subtitle", "time": 18504.43, "timestamp": "05:08:24", "text": "从上到下水平方向就是你走的时候"}, {"type": "subtitle", "time": 18507.628, "timestamp": "05:08:27", "text": "从左到右 从左到右 好的 好的"}, {"type": "subtitle", "time": 18510.43, "timestamp": "05:08:30", "text": "好的，下次再说专栏，嗯。"}, {"type": "subtitle", "time": 18512.948, "timestamp": "05:08:32", "text": "列是垂直的，行是垂直的。"}, {"type": "subtitle", "time": 18515.788, "timestamp": "05:08:35", "text": "水平水平好的，明白了，明白了"}, {"type": "subtitle", "time": 18519.67, "timestamp": "05:08:39", "text": "我记得这件事"}, {"type": "subtitle", "time": 18521.75, "timestamp": "05:08:41", "text": "听起来他会表现得很好，他会的。"}, {"type": "subtitle", "time": 18527.708, "timestamp": "05:08:47", "text": "[音乐]"}, {"type": "subtitle", "time": 18531.15, "timestamp": "05:08:51", "text": "我没有广告"}, {"type": "subtitle", "time": 18533.91, "timestamp": "05:08:53", "text": "考虑到我当时的观看方式，我的想法是……"}, {"type": "subtitle", "time": 18536.59, "timestamp": "05:08:56", "text": "顺便说一句，有三条溪流哦"}]
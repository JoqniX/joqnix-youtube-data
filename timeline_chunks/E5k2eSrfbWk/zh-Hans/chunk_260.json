[{"type": "subtitle", "time": 15602.95, "timestamp": "04:20:02", "text": "当倒计时结束时有四个人"}, {"type": "subtitle", "time": 15608.229, "timestamp": "04:20:08", "text": "在任何位置，是的，四，哦哦哦哦"}, {"type": "subtitle", "time": 15618.71, "timestamp": "04:20:18", "text": "你们清理干净了吗？你们清理干净了吗？是的，我们"}, {"type": "subtitle", "time": 15623.99, "timestamp": "04:20:23", "text": "感觉真好，感觉真好"}, {"type": "subtitle", "time": 15627.07, "timestamp": "04:20:27", "text": "记得我们在那里的时候，他们试图玩耍"}, {"type": "subtitle", "time": 15631.389, "timestamp": "04:20:31", "text": "这个游戏我卡住了"}, {"type": "subtitle", "time": 15634.429, "timestamp": "04:20:34", "text": "真糟糕，你卡在符号部分了。"}, {"type": "subtitle", "time": 15642.269, "timestamp": "04:20:42", "text": "是的，这个符号很难解释。"}, {"type": "subtitle", "time": 15647.02, "timestamp": "04:20:47", "text": "是的，有时候是这样。"}, {"type": "subtitle", "time": 15648.75, "timestamp": "04:20:48", "text": "[音乐]"}, {"type": "subtitle", "time": 15651.79, "timestamp": "04:20:51", "text": "就是这样，它又回来了。"}, {"type": "subtitle", "time": 15656.55, "timestamp": "04:20:56", "text": "所以你想成为扩散者吗？"}, {"type": "subtitle", "time": 15658.109, "timestamp": "04:20:58", "text": "手册"}]
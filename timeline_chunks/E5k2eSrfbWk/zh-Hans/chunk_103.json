[{"type": "subtitle", "time": 6182.39, "timestamp": "01:43:02", "text": "跑过来，好好享受吧"}, {"type": "subtitle", "time": 6185.27, "timestamp": "01:43:05", "text": "V 我会是"}, {"type": "subtitle", "time": 6192.669, "timestamp": "01:43:12", "text": "它到底能不能加载？我没有。"}, {"type": "subtitle", "time": 6195.31, "timestamp": "01:43:15", "text": "我知道它应该正在加载，但不知道为什么。"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "不是说要花很长时间"}, {"type": "subtitle", "time": 6202.109, "timestamp": "01:43:22", "text": "你知道吗，我们再来一次"}, {"type": "subtitle", "time": 6205.35, "timestamp": "01:43:25", "text": "瞧，这就是一个英勇守卫。"}, {"type": "subtitle", "time": 6207.83, "timestamp": "01:43:27", "text": "我很享受这段时光，我会回来的，好吗？"}, {"type": "subtitle", "time": 6210.83, "timestamp": "01:43:30", "text": "我觉得这样更好，我会回来的，嗯。"}, {"type": "subtitle", "time": 6214.99, "timestamp": "01:43:34", "text": "那应该更快，15分钟就够了。"}, {"type": "subtitle", "time": 6222.79, "timestamp": "01:43:42", "text": "之后我给最后一个评价了“还可以”。"}, {"type": "subtitle", "time": 6228.03, "timestamp": "01:43:48", "text": "我今天就到此为止了。"}, {"type": "subtitle", "time": 6231.47, "timestamp": "01:43:51", "text": "是的，最后一个，还有ra"}]
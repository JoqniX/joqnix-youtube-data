[{"type": "subtitle", "time": 19081.07, "timestamp": "05:18:01", "text": "并非所有人都关注炸弹拆除"}, {"type": "subtitle", "time": 19095.39, "timestamp": "05:18:15", "text": "好了，炸弹在这里，嗨，我们已经"}, {"type": "subtitle", "time": 19099.23, "timestamp": "05:18:19", "text": "我们有电线，我们有键盘"}, {"type": "subtitle", "time": 19100.97, "timestamp": "05:18:20", "text": "我们有鲑鱼"}, {"type": "subtitle", "time": 19102.83, "timestamp": "05:18:22", "text": "[音乐]"}, {"type": "subtitle", "time": 19105.868, "timestamp": "05:18:25", "text": "他说，呃，没有符号，哦哦，是的，键盘"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "符号"}, {"type": "subtitle", "time": 19109.948, "timestamp": "05:18:29", "text": "好的，呃，你想做哪一个？"}, {"type": "subtitle", "time": 19112.35, "timestamp": "05:18:32", "text": "我打破了"}, {"type": "subtitle", "time": 19115.47, "timestamp": "05:18:35", "text": "按照惯例，我们先做电线，然后……嗯。"}, {"type": "subtitle", "time": 19119.548, "timestamp": "05:18:39", "text": "咱们开始接线吧，一共六根线。"}, {"type": "subtitle", "time": 19124.03, "timestamp": "05:18:44", "text": "六根电线，没问题，有黄色的吗？"}, {"type": "subtitle", "time": 19128.548, "timestamp": "05:18:48", "text": "电线，呃，有两根白线，然后是两根"}, {"type": "subtitle", "time": 19133.31, "timestamp": "05:18:53", "text": "蓝色电线，然后是另外两根白色电线。"}, {"type": "subtitle", "time": 19134.59, "timestamp": "05:18:54", "text": "[音乐]"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "电线，嗯，所以没有黄色，没有"}]
[{"type": "subtitle", "time": 15366.189, "timestamp": "04:16:06", "text": "酒吧里有人说我不知道​​，伙计。"}, {"type": "subtitle", "time": 15368.149, "timestamp": "04:16:08", "text": "首先是在直播或其他什么地方，是的。"}, {"type": "subtitle", "time": 15369.55, "timestamp": "04:16:09", "text": "第一次"}, {"type": "subtitle", "time": 15378.109, "timestamp": "04:16:18", "text": "准备好了就告诉我，好的，我准备好了。"}, {"type": "subtitle", "time": 15381.95, "timestamp": "04:16:21", "text": "差不多完成了，你可以在这里阅读。"}, {"type": "subtitle", "time": 15384.79, "timestamp": "04:16:24", "text": "是的，你看不懂。"}, {"type": "subtitle", "time": 15387.95, "timestamp": "04:16:27", "text": "这是扩散手册，我的天啊"}, {"type": "subtitle", "time": 15391.03, "timestamp": "04:16:31", "text": "我在这方面很差劲，所以，是的，我已经准备好了。"}, {"type": "subtitle", "time": 15398.55, "timestamp": "04:16:38", "text": "好吧，你准备好了吗？是的，嗯，我"}, {"type": "subtitle", "time": 15401.07, "timestamp": "04:16:41", "text": "从第一部分开始"}, {"type": "subtitle", "time": 15404.51, "timestamp": "04:16:44", "text": "炸弹！我的天哪！"}, {"type": "subtitle", "time": 15406.389, "timestamp": "04:16:46", "text": "此屏幕仅供您本人查看"}, {"type": "subtitle", "time": 15407.71, "timestamp": "04:16:47", "text": "不允许查看炸弹。"}, {"type": "subtitle", "time": 15413.79, "timestamp": "04:16:53", "text": "我的身体在你手中，我的身体"}, {"type": "subtitle", "time": 15415.349, "timestamp": "04:16:55", "text": "就在你的"}, {"type": "subtitle", "time": 15419.229, "timestamp": "04:16:59", "text": "大家准备好了，炸弹在这里，我已经"}]
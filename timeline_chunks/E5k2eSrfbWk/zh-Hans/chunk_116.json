[{"type": "subtitle", "time": 6965.589, "timestamp": "01:56:05", "text": "奶酪红葡萄酒，还有一大堆"}, {"type": "subtitle", "time": 6967.75, "timestamp": "01:56:07", "text": "做好准备和……之间的区别"}, {"type": "subtitle", "time": 6970.35, "timestamp": "01:56:10", "text": "携带过多物品？啊，别担心。"}, {"type": "subtitle", "time": 6972.43, "timestamp": "01:56:12", "text": "我要把所有事情都告诉你"}, {"type": "subtitle", "time": 6974.51, "timestamp": "01:56:14", "text": "是的，我有东西要给我。"}, {"type": "subtitle", "time": 6976.39, "timestamp": "01:56:16", "text": "把你所有的东西都扔掉"}, {"type": "subtitle", "time": 6980.51, "timestamp": "01:56:20", "text": "是啊，所有这些"}, {"type": "subtitle", "time": 6990.55, "timestamp": "01:56:30", "text": "等等，我为什么要服用它？我"}, {"type": "subtitle", "time": 6993.669, "timestamp": "01:56:33", "text": "把它带到我的"}, {"type": "subtitle", "time": 6997.55, "timestamp": "01:56:37", "text": "等等，我的天哪，我太蠢了，我把所有的……都拿走了"}, {"type": "subtitle", "time": 7001.99, "timestamp": "01:56:41", "text": "他们 XD 哦我的天啊呃，我不是故意的"}, {"type": "subtitle", "time": 7004.03, "timestamp": "01:56:44", "text": "做我原本打算给你的事"}, {"type": "subtitle", "time": 7013.43, "timestamp": "01:56:53", "text": "做了很多美容手术啊"}, {"type": "subtitle", "time": 7016.189, "timestamp": "01:56:56", "text": "呃，不，它有点小"}]
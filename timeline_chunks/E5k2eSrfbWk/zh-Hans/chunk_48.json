[{"type": "subtitle", "time": 2883.99, "timestamp": "00:48:03", "text": "我想回到"}, {"type": "subtitle", "time": 2898.03, "timestamp": "00:48:18", "text": "好了，船长，我们这是在哪儿？"}, {"type": "subtitle", "time": 2898.76, "timestamp": "00:48:18", "text": "标题"}, {"type": "subtitle", "time": 2900.549, "timestamp": "00:48:20", "text": "[音乐]"}, {"type": "subtitle", "time": 2903.589, "timestamp": "00:48:23", "text": "接下来，不，其实不是，我们不会……"}, {"type": "subtitle", "time": 2911.71, "timestamp": "00:48:31", "text": "哦，我得等到拿到小号的才走。"}, {"type": "subtitle", "time": 2914.27, "timestamp": "00:48:34", "text": "小生物和结束"}, {"type": "subtitle", "time": 2925.47, "timestamp": "00:48:45", "text": "很好，我就是这样"}, {"type": "subtitle", "time": 2928.349, "timestamp": "00:48:48", "text": "快了，啊，明白了，明白了，明白了，我看到一个"}, {"type": "subtitle", "time": 2931.47, "timestamp": "00:48:51", "text": "我终于看到一个了"}, {"type": "subtitle", "time": 2933.99, "timestamp": "00:48:53", "text": "奥内卡"}, {"type": "subtitle", "time": 2936.99, "timestamp": "00:48:56", "text": "这甜菜"}, {"type": "subtitle", "time": 2938.87, "timestamp": "00:48:58", "text": "就是那个"}]
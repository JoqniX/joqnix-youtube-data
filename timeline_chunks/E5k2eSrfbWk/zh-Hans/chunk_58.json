[{"type": "subtitle", "time": 3492.93, "timestamp": "00:58:12", "text": "探索中毒了"}, {"type": "subtitle", "time": 3506.19, "timestamp": "00:58:26", "text": "现在，寻找甲虫并不是我的爱好。"}, {"type": "subtitle", "time": 3512.51, "timestamp": "00:58:32", "text": "如果你掌握了这项技能，你就会明白。"}, {"type": "subtitle", "time": 3515.589, "timestamp": "00:58:35", "text": "可以找到它"}, {"type": "subtitle", "time": 3517.71, "timestamp": "00:58:37", "text": "但"}, {"type": "subtitle", "time": 3520.309, "timestamp": "00:58:40", "text": "就我个人而言"}, {"type": "subtitle", "time": 3523.51, "timestamp": "00:58:43", "text": "我不知道怎么才能获得经验值，我"}, {"type": "subtitle", "time": 3530.829, "timestamp": "00:58:50", "text": "主啊，我在那里的一切都将存在。"}, {"type": "subtitle", "time": 3534.39, "timestamp": "00:58:54", "text": "这边如果有甲虫，我就会……"}]
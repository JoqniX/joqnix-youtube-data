[{"type": "subtitle", "time": 1381.75, "timestamp": "00:23:01", "text": "服务器扫描了这些手机和其他东西，我收到了"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "如果我去佛罗里达，我可以回家。"}, {"type": "subtitle", "time": 1389.83, "timestamp": "00:23:09", "text": "最后，如果我能阻止这一切，就好好做这件事吧。"}, {"type": "subtitle", "time": 1393.51, "timestamp": "00:23:13", "text": "这位女士不要干涉和"}, {"type": "subtitle", "time": 1396.39, "timestamp": "00:23:16", "text": "拍摄我将"}, {"type": "subtitle", "time": 1418.83, "timestamp": "00:23:38", "text": "明白了，不，我是"}, {"type": "subtitle", "time": 1420.71, "timestamp": "00:23:40", "text": "我当时离得很近。"}, {"type": "subtitle", "time": 1423.149, "timestamp": "00:23:43", "text": "很近，我很近，我很近，我很近"}]
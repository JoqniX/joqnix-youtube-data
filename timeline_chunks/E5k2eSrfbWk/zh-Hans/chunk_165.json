[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "任务哦，天哪，当然他们我已经……"}, {"type": "subtitle", "time": 9904.429, "timestamp": "02:45:04", "text": "在那里听到了，但是"}, {"type": "subtitle", "time": 9907.71, "timestamp": "02:45:07", "text": "哦，天哪，我为什么要创造我们？我为什么要……"}, {"type": "subtitle", "time": 9917.07, "timestamp": "02:45:17", "text": "[音乐]"}, {"type": "subtitle", "time": 9928.429, "timestamp": "02:45:28", "text": "嗯，不太习惯有人走过来跟我说话。"}, {"type": "subtitle", "time": 9932.75, "timestamp": "02:45:32", "text": "呃，我想你可以说我一直"}, {"type": "subtitle", "time": 9934.95, "timestamp": "02:45:34", "text": "一旦你拥有了它，你就一直拥有了它。"}, {"type": "subtitle", "time": 9936.71, "timestamp": "02:45:36", "text": "到处都是"}, {"type": "subtitle", "time": 9941.469, "timestamp": "02:45:41", "text": "哎哟，两分钟后对话很顺利"}, {"type": "subtitle", "time": 9943.75, "timestamp": "02:45:43", "text": "外部"}, {"type": "subtitle", "time": 9947.95, "timestamp": "02:45:47", "text": "她的军队实际上也从太……开火了"}, {"type": "subtitle", "time": 9950.389, "timestamp": "02:45:50", "text": "许多生命值得计数"}, {"type": "subtitle", "time": 9953.15, "timestamp": "02:45:53", "text": "但我的确经历过所有这些，是的。"}, {"type": "subtitle", "time": 9955.99, "timestamp": "02:45:55", "text": "好的，我在法国待了很长时间。"}, {"type": "subtitle", "time": 9957.269, "timestamp": "02:45:57", "text": "你认为是诸如此类的事情"}, {"type": "subtitle", "time": 9959.469, "timestamp": "02:45:59", "text": "导致文明和派系分裂的因素"}]
[{"type": "subtitle", "time": 16923.708, "timestamp": "04:42:03", "text": "你今晚死了，我也死过一次，是的。"}, {"type": "subtitle", "time": 16926.43, "timestamp": "04:42:06", "text": "一次，那你呢？我没有。"}, {"type": "subtitle", "time": 16929.31, "timestamp": "04:42:09", "text": "还记得你死了多少次吗？是的，我们"}, {"type": "subtitle", "time": 16933.708, "timestamp": "04:42:13", "text": "我们死后用了三个"}, {"type": "subtitle", "time": 16936.99, "timestamp": "04:42:16", "text": "是的，三次，我就是那个人"}, {"type": "subtitle", "time": 16947.51, "timestamp": "04:42:27", "text": "嗯，等一下，呃，通常情况下"}, {"type": "subtitle", "time": 16950.75, "timestamp": "04:42:30", "text": "通常情况下，手册阅读器会处于……"}, {"type": "subtitle", "time": 16953.788, "timestamp": "04:42:33", "text": "办公室之类的，还有炸弹呃"}, {"type": "subtitle", "time": 16956.55, "timestamp": "04:42:36", "text": "扩散器会像在……一样。"}, {"type": "subtitle", "time": 16959.51, "timestamp": "04:42:39", "text": "这种情况，也就是你所说的"}, {"type": "subtitle", "time": 16962.708, "timestamp": "04:42:42", "text": "是的，就是那个地方，但是，但是，但是我们是"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "虽然我们是在网上聊天，但我们确实是在网上聊天。"}, {"type": "subtitle", "time": 16967.948, "timestamp": "04:42:47", "text": "但这意味着我们离……非常遥远"}, {"type": "subtitle", "time": 16969.788, "timestamp": "04:42:49", "text": "彼此"}]
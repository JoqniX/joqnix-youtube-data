[{"type": "subtitle", "time": 19980.788, "timestamp": "05:33:00", "text": "接下来，嗨，在结束之前，我想说……"}, {"type": "subtitle", "time": 19984.67, "timestamp": "05:33:04", "text": "提醒你们几个……"}, {"type": "subtitle", "time": 19988.868, "timestamp": "05:33:08", "text": "所以，呃，这周我们有……"}, {"type": "subtitle", "time": 19991.99, "timestamp": "05:33:11", "text": "我的 Discord 服务器"}, {"type": "subtitle", "time": 19996.19, "timestamp": "05:33:16", "text": "周年纪念日他真的真的真的真的真的呃"}, {"type": "subtitle", "time": 19998.788, "timestamp": "05:33:18", "text": "将会"}, {"type": "subtitle", "time": 20002.628, "timestamp": "05:33:22", "text": "星期天我会在"}, {"type": "subtitle", "time": 20008.948, "timestamp": "05:33:28", "text": "星期天"}, {"type": "subtitle", "time": 20012.23, "timestamp": "05:33:32", "text": "我还没计划好要玩什么游戏。"}, {"type": "subtitle", "time": 20015.99, "timestamp": "05:33:35", "text": "事情正在发生，但你们会"}, {"type": "subtitle", "time": 20019.23, "timestamp": "05:33:39", "text": "呃，接通服务器，我这就开枪。"}, {"type": "subtitle", "time": 20022.07, "timestamp": "05:33:42", "text": "在推特上发布公告"}, {"type": "subtitle", "time": 20026.39, "timestamp": "05:33:46", "text": "嗯，对，我也会开通推特账号。"}, {"type": "subtitle", "time": 20029.59, "timestamp": "05:33:49", "text": "还有Discord的公告，所以我计划"}, {"type": "subtitle", "time": 20034.43, "timestamp": "05:33:54", "text": "举办社区游戏之夜？我不能"}, {"type": "subtitle", "time": 20036.788, "timestamp": "05:33:56", "text": "帮助成为派对"}]
[{"type": "subtitle", "time": 6569.83, "timestamp": "01:49:29", "text": "得到"}, {"type": "subtitle", "time": 6586.83, "timestamp": "01:49:46", "text": "向下"}, {"type": "subtitle", "time": 6590.669, "timestamp": "01:49:50", "text": "他很聪明，知道自己在做什么，只有一个敌人"}, {"type": "subtitle", "time": 6592.31, "timestamp": "01:49:52", "text": "剩下的我还能撑三次崩溃。"}]
[{"type": "subtitle", "time": 18720.868, "timestamp": "05:12:00", "text": "右下角的按钮说"}, {"type": "subtitle", "time": 18724.67, "timestamp": "05:12:04", "text": "等等，再等等，好的，没问题。"}, {"type": "subtitle", "time": 18728.91, "timestamp": "05:12:08", "text": "序列再一遍，是的，你是"}, {"type": "subtitle", "time": 18731.11, "timestamp": "05:12:11", "text": "e"}, {"type": "subtitle", "time": 18734.788, "timestamp": "05:12:14", "text": "呃，你为什么……好吧，我明白了，哦，等等"}, {"type": "subtitle", "time": 18738.39, "timestamp": "05:12:18", "text": "搞错了，该死，算了。"}, {"type": "subtitle", "time": 18742.15, "timestamp": "05:12:22", "text": "呃，他们是，我们只有一次机会，真糟糕，呃"}, {"type": "subtitle", "time": 18748.07, "timestamp": "05:12:28", "text": "他们在这里等着他们"}, {"type": "subtitle", "time": 18751.868, "timestamp": "05:12:31", "text": "他们还好吗？那是什么？"}, {"type": "subtitle", "time": 18754.628, "timestamp": "05:12:34", "text": "左侧中间的按钮显示“中间”"}, {"type": "subtitle", "time": 18756.15, "timestamp": "05:12:36", "text": "左边"}, {"type": "subtitle", "time": 18759.708, "timestamp": "05:12:39", "text": "好的好的"}, {"type": "subtitle", "time": 18761.43, "timestamp": "05:12:41", "text": "一个"}, {"type": "subtitle", "time": 18764.948, "timestamp": "05:12:44", "text": "好的，这就是……"}, {"type": "subtitle", "time": 18768.47, "timestamp": "05:12:48", "text": "序列中间"}, {"type": "subtitle", "time": 18775.47, "timestamp": "05:12:55", "text": "不不不，那不是那个 f f i r s"}, {"type": "subtitle", "time": 18779.11, "timestamp": "05:12:59", "text": "是的，我看到了，是的，最后"}]
[{"type": "subtitle", "time": 16380.99, "timestamp": "04:33:00", "text": "通红一片，里面没有猫头鹰。"}, {"type": "subtitle", "time": 16383.75, "timestamp": "04:33:03", "text": "序列号正常"}, {"type": "subtitle", "time": 16386.869, "timestamp": "04:33:06", "text": "嗯，我还有一个"}, {"type": "subtitle", "time": 16390.189, "timestamp": "04:33:10", "text": "罢工等待任务完成"}, {"type": "subtitle", "time": 16394.47, "timestamp": "04:33:14", "text": "哦，呃，所以要按的按钮，呃哦，你拿到了"}, {"type": "subtitle", "time": 16396.949, "timestamp": "04:33:16", "text": "一次击球，好的，那么是什么颜色？"}, {"type": "subtitle", "time": 16401.91, "timestamp": "04:33:21", "text": "红色指示灯闪烁，所以我们得点击"}, {"type": "subtitle", "time": 16403.39, "timestamp": "04:33:23", "text": "在"}, {"type": "subtitle", "time": 16405.269, "timestamp": "04:33:25", "text": "黄色 5"}, {"type": "subtitle", "time": 16409.39, "timestamp": "04:33:29", "text": "秒黄错了，等等，什么？"}, {"type": "subtitle", "time": 16413.15, "timestamp": "04:33:33", "text": "是的，黄色错了，哦不"}, {"type": "subtitle", "time": 16415.15, "timestamp": "04:33:35", "text": "哦，我是"}, {"type": "subtitle", "time": 16416.949, "timestamp": "04:33:36", "text": "我们死了"}, {"type": "subtitle", "time": 16425.83, "timestamp": "04:33:45", "text": "我信任你，但炸弹不信任我。"}, {"type": "subtitle", "time": 16432.51, "timestamp": "04:33:52", "text": "不，哦等等，你说没有波浪"}, {"type": "subtitle", "time": 16435.189, "timestamp": "04:33:55", "text": "对哦，我是"}, {"type": "subtitle", "time": 16439.67, "timestamp": "04:33:59", "text": "我确实说过没有W，真是蠢。"}]
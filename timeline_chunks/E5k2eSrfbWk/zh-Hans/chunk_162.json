[{"type": "subtitle", "time": 9724.71, "timestamp": "02:42:04", "text": "不，我第一次就听到了，没有。"}, {"type": "subtitle", "time": 9735.75, "timestamp": "02:42:15", "text": "损失哦不，我还能再跟你谈谈吗？"}, {"type": "subtitle", "time": 9737.349, "timestamp": "02:42:17", "text": "你们在招人吗？我真的很需要这个职位。"}, {"type": "subtitle", "time": 9740.269, "timestamp": "02:42:20", "text": "工作"}, {"type": "subtitle", "time": 9743.349, "timestamp": "02:42:23", "text": "我对此仅此而已。"}, {"type": "subtitle", "time": 9747.67, "timestamp": "02:42:27", "text": "非常感谢，你在哪里？"}, {"type": "subtitle", "time": 9749.269, "timestamp": "02:42:29", "text": "发送"}, {"type": "subtitle", "time": 9752.87, "timestamp": "02:42:32", "text": "改变自愿"}, {"type": "subtitle", "time": 9761.63, "timestamp": "02:42:41", "text": "嗯，五月签署了登陆协议"}, {"type": "subtitle", "time": 9764.63, "timestamp": "02:42:44", "text": "船会在那里"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "很快好了，我大概知道该雇人了。"}, {"type": "subtitle", "time": 9777.99, "timestamp": "02:42:57", "text": "很高兴再次见到你，我可以帮你吗？"}]
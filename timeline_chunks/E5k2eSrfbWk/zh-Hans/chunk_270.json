[{"type": "subtitle", "time": 16200.91, "timestamp": "04:30:00", "text": "我明白了，我明白了，是的，然后还有"}, {"type": "subtitle", "time": 16203.109, "timestamp": "04:30:03", "text": "就像发出“哦”的声音，然后像有根棍子伸出来一样"}, {"type": "subtitle", "time": 16206.79, "timestamp": "04:30:06", "text": "从下面像个L形弹珠一样弹出来，好了。"}, {"type": "subtitle", "time": 16210.95, "timestamp": "04:30:10", "text": "它，然后就像一个，那就是"}, {"type": "subtitle", "time": 16214.67, "timestamp": "04:30:14", "text": "水平翻转 哦，呃，心跳"}, {"type": "subtitle", "time": 16220.349, "timestamp": "04:30:20", "text": "好了，所以，呃，按下"}, {"type": "subtitle", "time": 16221.87, "timestamp": "04:30:21", "text": "棒糖"}, {"type": "subtitle", "time": 16225.67, "timestamp": "04:30:25", "text": "[音乐]"}, {"type": "subtitle", "time": 16228.95, "timestamp": "04:30:28", "text": "是的，那就是《奔跑的人》。"}, {"type": "subtitle", "time": 16232.87, "timestamp": "04:30:32", "text": "那个跑步带的东西，好了，按一下它"}, {"type": "subtitle", "time": 16235.63, "timestamp": "04:30:35", "text": "以及那颠倒的心跳"}, {"type": "subtitle", "time": 16240.429, "timestamp": "04:30:40", "text": "东西在什么里面，不不不，呃"}, {"type": "subtitle", "time": 16243.349, "timestamp": "04:30:43", "text": "三角形，脚，呃，心跳"}, {"type": "subtitle", "time": 16245.63, "timestamp": "04:30:45", "text": "就是你说的那个东西，哦，心跳"}, {"type": "subtitle", "time": 16249.07, "timestamp": "04:30:49", "text": "好的，然后三角形就完成了。"}, {"type": "subtitle", "time": 16254.03, "timestamp": "04:30:54", "text": "好，我们来做吧，嗯，对吧？是哪一个？"}, {"type": "subtitle", "time": 16256.109, "timestamp": "04:30:56", "text": "我又来了，我只有西蒙说"}, {"type": "subtitle", "time": 16259.109, "timestamp": "04:30:59", "text": "在按钮上，我们来做这个按钮"}]
[{"type": "subtitle", "time": 20220.75, "timestamp": "05:37:00", "text": "那么，让我再跟你说说我的日程安排吧。"}, {"type": "subtitle", "time": 20223.39, "timestamp": "05:37:03", "text": "我现在正在直播，所以明天会直播。"}, {"type": "subtitle", "time": 20224.548, "timestamp": "05:37:04", "text": "是"}, {"type": "subtitle", "time": 20228.31, "timestamp": "05:37:08", "text": "等等，不是 YouTube，呃，是 Twitch"}, {"type": "subtitle", "time": 20231.27, "timestamp": "05:37:11", "text": "印度标准时间下午 4 点的直播就在……"}, {"type": "subtitle", "time": 20235.628, "timestamp": "05:37:15", "text": "晚上是我所在时间，所以我们将进行一项艺术创作。"}, {"type": "subtitle", "time": 20238.39, "timestamp": "05:37:18", "text": "直播"}, {"type": "subtitle", "time": 20242.23, "timestamp": "05:37:22", "text": "Twitch，还有你们可以"}, {"type": "subtitle", "time": 20246.708, "timestamp": "05:37:26", "text": "预计周六将与 Victor 合作"}, {"type": "subtitle", "time": 20250.27, "timestamp": "05:37:30", "text": "今天在聊天室里的儿子，我们会……"}, {"type": "subtitle", "time": 20253.83, "timestamp": "05:37:33", "text": "玩 Gen Impact，但只是在下午 5:00。"}, {"type": "subtitle", "time": 20257.11, "timestamp": "05:37:37", "text": "那大概比我的 Twitch 直播时间晚一个小时。"}, {"type": "subtitle", "time": 20260.11, "timestamp": "05:37:40", "text": "大约是印度标准时间下午 5 点。"}, {"type": "subtitle", "time": 20263.628, "timestamp": "05:37:43", "text": "如果您对时间有任何疑问，请联系我们。"}, {"type": "subtitle", "time": 20265.47, "timestamp": "05:37:45", "text": "如果你想查看日程安排，"}, {"type": "subtitle", "time": 20268.868, "timestamp": "05:37:48", "text": "请务必查看日程安排。"}, {"type": "subtitle", "time": 20272.23, "timestamp": "05:37:52", "text": "嗯，我还没把它当作我的……"}, {"type": "subtitle", "time": 20276.27, "timestamp": "05:37:56", "text": "Twitter 的“置顶推文”功能，让推文可以固定在 Twitter 上。"}, {"type": "subtitle", "time": 20279.07, "timestamp": "05:37:59", "text": "如果你愿意的话，你可以加入呃"}]
[{"type": "subtitle", "time": 22505.67, "timestamp": "06:15:05", "text": "我需要什么？呃，我问问电工什么时候"}, {"type": "subtitle", "time": 22509.03, "timestamp": "06:15:09", "text": "他现在过来帮我解决这个问题"}, {"type": "subtitle", "time": 22512.43, "timestamp": "06:15:12", "text": "我使用的扩展程序有三个自定义的"}, {"type": "subtitle", "time": 22515.15, "timestamp": "06:15:15", "text": "扩展盒或电源搜索"}, {"type": "subtitle", "time": 22519.39, "timestamp": "06:15:19", "text": "可以说，哦我的天哪，我没买，我喜欢"}, {"type": "subtitle", "time": 22523.43, "timestamp": "06:15:23", "text": "他们我买了一块板子，"}, {"type": "subtitle", "time": 22525.548, "timestamp": "06:15:25", "text": "然后单独购买了开关。"}, {"type": "subtitle", "time": 22528.75, "timestamp": "06:15:28", "text": "所有东西都需要一根又长又粗的电缆"}, {"type": "subtitle", "time": 22532.75, "timestamp": "06:15:32", "text": "一切都好，所以我可以把它放上去，呃，表哥"}, {"type": "subtitle", "time": 22535.59, "timestamp": "06:15:35", "text": "想当年，当个人电脑还是B的时候"}, {"type": "subtitle", "time": 22538.75, "timestamp": "06:15:38", "text": "呃，在我的，在我的"}, {"type": "subtitle", "time": 22540.91, "timestamp": "06:15:40", "text": "房子呃那个"}, {"type": "subtitle", "time": 22544.19, "timestamp": "06:15:44", "text": "当时的姿势真是太奇怪了。"}, {"type": "subtitle", "time": 22545.948, "timestamp": "06:15:45", "text": "我需要的一点是……"}, {"type": "subtitle", "time": 22547.788, "timestamp": "06:15:47", "text": "延长线和"}, {"type": "subtitle", "time": 22552.11, "timestamp": "06:15:52", "text": "一切都好，而且我还有两台电脑。"}, {"type": "subtitle", "time": 22555.67, "timestamp": "06:15:55", "text": "现在我至少需要"}]
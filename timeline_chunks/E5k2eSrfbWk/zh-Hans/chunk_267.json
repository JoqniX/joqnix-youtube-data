[{"type": "subtitle", "time": 16022.63, "timestamp": "04:27:02", "text": "或者我们扩散了它"}, {"type": "subtitle", "time": 16025.83, "timestamp": "04:27:05", "text": "我们确实这么做了"}, {"type": "subtitle", "time": 16033.71, "timestamp": "04:27:13", "text": "好的，哦，天哪，炸弹正在引爆。"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "他们需要抓紧时间，否则……"}, {"type": "subtitle", "time": 16038.95, "timestamp": "04:27:18", "text": "随着时间的流逝，他们已经死了。"}, {"type": "subtitle", "time": 16041.67, "timestamp": "04:27:21", "text": "恐惧和惊骇，我看着他们挣扎"}, {"type": "subtitle", "time": 16053.83, "timestamp": "04:27:33", "text": "面包，轮到你了"}, {"type": "subtitle", "time": 16055.51, "timestamp": "04:27:35", "text": "正确的"}, {"type": "subtitle", "time": 16059.149, "timestamp": "04:27:39", "text": "是的，好的，罗科，保重，你好"}]
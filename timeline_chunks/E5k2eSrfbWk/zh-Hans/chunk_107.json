[{"type": "subtitle", "time": 6423.35, "timestamp": "01:47:03", "text": "再见"}, {"type": "subtitle", "time": 6435.83, "timestamp": "01:47:15", "text": "西边最后一个站着的玩家，该死，那是我"}, {"type": "subtitle", "time": 6439.31, "timestamp": "01:47:19", "text": "这是我第一次看到它，这是最新的版本。"}, {"type": "subtitle", "time": 6448.07, "timestamp": "01:47:28", "text": "头晕目眩，在某人的上方"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "他在那里是一个真正的自由人"}, {"type": "subtitle", "time": 6459.99, "timestamp": "01:47:39", "text": "你"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "那个楼主"}]
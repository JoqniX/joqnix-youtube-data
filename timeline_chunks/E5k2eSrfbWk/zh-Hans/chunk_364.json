[{"type": "subtitle", "time": 21847.43, "timestamp": "06:04:07", "text": "pH"}, {"type": "subtitle", "time": 21850.39, "timestamp": "06:04:10", "text": "让你站在这里"}, {"type": "subtitle", "time": 21854.15, "timestamp": "06:04:14", "text": "好了，伙计，现在它只是一根电线而已。"}, {"type": "subtitle", "time": 21856.99, "timestamp": "06:04:16", "text": "首先，他手里还拿着纸巾。"}, {"type": "subtitle", "time": 21864.11, "timestamp": "06:04:24", "text": "意思是，不，呃，K 现在"}, {"type": "subtitle", "time": 21868.91, "timestamp": "06:04:28", "text": "呃，我爸带我来的时候已经很晚了，"}, {"type": "subtitle", "time": 21872.708, "timestamp": "06:04:32", "text": "就像油腻的东西，现在到处都是"}, {"type": "subtitle", "time": 21875.788, "timestamp": "06:04:35", "text": "他们每次都会带食物过来"}, {"type": "subtitle", "time": 21879.39, "timestamp": "06:04:39", "text": "他们不给我勺子或叉子，"}, {"type": "subtitle", "time": 21881.788, "timestamp": "06:04:41", "text": "我就像你知道我不能用我的裸露的"}, {"type": "subtitle", "time": 21885.548, "timestamp": "06:04:45", "text": "我不，我不键盘"}, {"type": "subtitle", "time": 21887.67, "timestamp": "06:04:47", "text": "变得油腻腻的，所有东西我都用不了了。"}, {"type": "subtitle", "time": 21890.75, "timestamp": "06:04:50", "text": "我赤手空拳，所以我不得不这么做。问题是"}, {"type": "subtitle", "time": 21895.19, "timestamp": "06:04:55", "text": "目前目前呃两者呃"}, {"type": "chat", "time": 21896.051, "timestamp": "06:04:56", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "what......."}, {"type": "subtitle", "time": 21896.628, "timestamp": "06:04:56", "text": "前部和后部"}, {"type": "chat", "time": 21899.712, "timestamp": "06:04:59", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "Huh?"}]
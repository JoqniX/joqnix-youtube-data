[{"type": "subtitle", "time": 8700.63, "timestamp": "02:25:00", "text": "如果您有任何疑问，请随时提出。"}, {"type": "subtitle", "time": 8704.349, "timestamp": "02:25:04", "text": "Bo，它在哪儿？它甚至都不在她那儿。"}, {"type": "subtitle", "time": 8708.83, "timestamp": "02:25:08", "text": "咦？那东西去哪儿了？"}, {"type": "subtitle", "time": 8713.75, "timestamp": "02:25:13", "text": "咦？我的黄金传奇级金币丢了！"}, {"type": "subtitle", "time": 8715.91, "timestamp": "02:25:15", "text": "东西是"}, {"type": "subtitle", "time": 8717.09, "timestamp": "02:25:17", "text": "已消失"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "[音乐]"}, {"type": "subtitle", "time": 8744.67, "timestamp": "02:25:44", "text": "如何"}]
[{"type": "subtitle", "time": 13081.269, "timestamp": "03:38:01", "text": "被拖进了我们这个功能失调的小世界"}, {"type": "subtitle", "time": 13085.71, "timestamp": "03:38:05", "text": "家人，你一定是某些人，哇哦，我"}, {"type": "subtitle", "time": 13087.229, "timestamp": "03:38:07", "text": "了解阿奇拉的一些阴暗面"}, {"type": "subtitle", "time": 13088.67, "timestamp": "03:38:08", "text": "月亮，但如果你寻找的是深邃的月亮。"}, {"type": "subtitle", "time": 13089.79, "timestamp": "03:38:09", "text": "历史"}, {"type": "subtitle", "time": 13092.349, "timestamp": "03:38:12", "text": "课程结束了，我要睡着了"}, {"type": "subtitle", "time": 13096.429, "timestamp": "03:38:16", "text": "在你这么做之前，请相信我，不要鼓励我"}, {"type": "subtitle", "time": 13101.11, "timestamp": "03:38:21", "text": "顺便说一句，Coro，你好，Coro，很高兴"}, {"type": "subtitle", "time": 13103.389, "timestamp": "03:38:23", "text": "很高兴认识你，任何勇敢的人都欢迎。"}, {"type": "subtitle", "time": 13106.189, "timestamp": "03:38:26", "text": "足以飞越边疆，无需其他任何事"}, {"type": "subtitle", "time": 13108.07, "timestamp": "03:38:28", "text": "关于航天器的两个方面"}, {"type": "subtitle", "time": 13111.469, "timestamp": "03:38:31", "text": "嘿，别吓到我们的新朋友。"}, {"type": "subtitle", "time": 13116.51, "timestamp": "03:38:36", "text": "“边境号”是一艘好船，说实话，现在我们开始吧。"}, {"type": "subtitle", "time": 13118.87, "timestamp": "03:38:38", "text": "莎拉，咱们谈谈生意吧。"}, {"type": "subtitle", "time": 13120.99, "timestamp": "03:38:40", "text": "关于"}, {"type": "subtitle", "time": 13124.469, "timestamp": "03:38:44", "text": "探险队？嗯，果然是那里。"}, {"type": "subtitle", "time": 13125.95, "timestamp": "03:38:45", "text": "我们正前往"}, {"type": "subtitle", "time": 13127.67, "timestamp": "03:38:47", "text": "我们三人正前往阿基拉"}, {"type": "subtitle", "time": 13129.15, "timestamp": "03:38:49", "text": "三颗恒星系中第一个被定居的行星"}, {"type": "subtitle", "time": 13131.91, "timestamp": "03:38:51", "text": "集体，而且并非巧合的是"}, {"type": "subtitle", "time": 13134.71, "timestamp": "03:38:54", "text": "他们的首都艾拉城，我们将"}, {"type": "subtitle", "time": 13136.95, "timestamp": "03:38:56", "text": "在城市太空港着陆，但是"}]
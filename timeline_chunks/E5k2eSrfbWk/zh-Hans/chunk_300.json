[{"type": "subtitle", "time": 18001.27, "timestamp": "05:00:01", "text": "等等，呃，我们到底放了多少颗炸弹？"}, {"type": "subtitle", "time": 18005.47, "timestamp": "05:00:05", "text": "又扩散了，嗯，我忘了我通讯中断了，哦"}, {"type": "subtitle", "time": 18008.99, "timestamp": "05:00:08", "text": "天哪，我们不需要知道，是的，我们爆发了"}, {"type": "subtitle", "time": 18011.11, "timestamp": "05:00:11", "text": "呃，三个"}, {"type": "subtitle", "time": 18015.11, "timestamp": "05:00:15", "text": "两次，我，你，我，两次"}, {"type": "subtitle", "time": 18016.11, "timestamp": "05:00:16", "text": "是的，两个"}, {"type": "subtitle", "time": 18023.788, "timestamp": "05:00:23", "text": "[音乐]"}, {"type": "subtitle", "time": 18032.83, "timestamp": "05:00:32", "text": "想着别让我死，哦，我"}, {"type": "subtitle", "time": 18040.708, "timestamp": "05:00:40", "text": "哦，如果说有什么变化的话，那就是我比死得更厉害了。"}, {"type": "subtitle", "time": 18059.15, "timestamp": "05:00:59", "text": "妈妈，好吧，一些旧东西"}]
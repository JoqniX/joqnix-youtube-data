[{"type": "subtitle", "time": 16620.67, "timestamp": "04:37:00", "text": "然后是棒棒糖"}, {"type": "subtitle", "time": 16623.949, "timestamp": "04:37:03", "text": "心跳，心跳，再一次"}, {"type": "subtitle", "time": 16625.59, "timestamp": "04:37:05", "text": "棒糖"}, {"type": "subtitle", "time": 16628.709, "timestamp": "04:37:08", "text": "是的，呃，奔跑的人在奔跑"}, {"type": "subtitle", "time": 16632.75, "timestamp": "04:37:12", "text": "男人的心跳，还有这个"}, {"type": "subtitle", "time": 16635.75, "timestamp": "04:37:15", "text": "好了，很好，完成了，我们继续吧。"}, {"type": "subtitle", "time": 16639.709, "timestamp": "04:37:19", "text": "电线实际上就是电线，没问题。"}, {"type": "subtitle", "time": 16643.789, "timestamp": "04:37:23", "text": "是的，我看到一二三四六六"}, {"type": "subtitle", "time": 16646.83, "timestamp": "04:37:26", "text": "电线中，最后有一根黑色的。"}, {"type": "subtitle", "time": 16650.83, "timestamp": "04:37:30", "text": "最后一根是黑线，然后是两根。"}, {"type": "subtitle", "time": 16653.83, "timestamp": "04:37:33", "text": "三个，嗯，那里有一根蓝色的电线，其余的"}, {"type": "subtitle", "time": 16656.429, "timestamp": "04:37:36", "text": "它们都是等等等等"}, {"type": "subtitle", "time": 16658.109, "timestamp": "04:37:38", "text": "等等，让我先跟你说说。"}, {"type": "subtitle", "time": 16661.709, "timestamp": "04:37:41", "text": "条件是是否有任何黄色"}, {"type": "subtitle", "time": 16665.869, "timestamp": "04:37:45", "text": "电线，没有黄色电线，还有什么？"}, {"type": "subtitle", "time": 16668.709, "timestamp": "04:37:48", "text": "序列号的最后一位数字"}, {"type": "subtitle", "time": 16672.83, "timestamp": "04:37:52", "text": "数字嗯，有两个序列号"}, {"type": "subtitle", "time": 16675.109, "timestamp": "04:37:55", "text": "数字，等等，等等，我明白了，明白了。"}, {"type": "subtitle", "time": 16676.269, "timestamp": "04:37:56", "text": "去年是"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "六六哦，没关系，否则如果"}]
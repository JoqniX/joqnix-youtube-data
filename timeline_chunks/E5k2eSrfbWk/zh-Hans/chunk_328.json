[{"type": "subtitle", "time": 19681.03, "timestamp": "05:28:01", "text": "是的，我最近买了三个新的"}, {"type": "subtitle", "time": 19685.23, "timestamp": "05:28:05", "text": "游戏……呃，我忘了是哪些游戏了。"}, {"type": "subtitle", "time": 19688.27, "timestamp": "05:28:08", "text": "所以我想说的是，呃，感觉，呃，Steam"}, {"type": "subtitle", "time": 19691.868, "timestamp": "05:28:11", "text": "抽奖活动，所以我选了三个。"}, {"type": "subtitle", "time": 19697.39, "timestamp": "05:28:17", "text": "我选择的游戏，比如……让我……"}, {"type": "subtitle", "time": 19701.83, "timestamp": "05:28:21", "text": "检查一下，嗯，我该怎么检查这个？哦"}, {"type": "subtitle", "time": 19705.91, "timestamp": "05:28:25", "text": "上帝啊，所以我选择了《空夜：人类陨落》"}, {"type": "subtitle", "time": 19709.27, "timestamp": "05:28:29", "text": "平地和跳跃"}, {"type": "subtitle", "time": 19713.31, "timestamp": "05:28:33", "text": "国王，是的，我想折磨自己。"}, {"type": "subtitle", "time": 19721.23, "timestamp": "05:28:41", "text": "好的"}, {"type": "subtitle", "time": 19724.628, "timestamp": "05:28:44", "text": "哦等等，你有人类坠落飞行器吗？"}, {"type": "subtitle", "time": 19726.15, "timestamp": "05:28:46", "text": "我们可以这样做"}, {"type": "subtitle", "time": 19729.548, "timestamp": "05:28:49", "text": "呃，我不会让他彻底失败。"}, {"type": "subtitle", "time": 19734.75, "timestamp": "05:28:54", "text": "很遗憾，我没有，你也没有。"}, {"type": "subtitle", "time": 19736.59, "timestamp": "05:28:56", "text": "[音乐]"}, {"type": "subtitle", "time": 19738.99, "timestamp": "05:28:58", "text": "很遗憾，我们以后再想办法吧。"}]
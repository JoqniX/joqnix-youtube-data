[{"type": "subtitle", "time": 5761.51, "timestamp": "01:36:01", "text": "弃"}, {"type": "subtitle", "time": 5765.109, "timestamp": "01:36:05", "text": "地球现在或多或少只是一颗尘埃球。"}, {"type": "subtitle", "time": 5767.709, "timestamp": "01:36:07", "text": "是的，这是一个灰尘，巴利找到了一些"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "我们留下的世界的残余"}, {"type": "subtitle", "time": 5772.87, "timestamp": "01:36:12", "text": "想象一个点，一个点"}, {"type": "subtitle", "time": 5775.229, "timestamp": "01:36:15", "text": "未来充满挑战，我们必须……"}, {"type": "subtitle", "time": 5778.79, "timestamp": "01:36:18", "text": "我们不得不放弃地球去往何方"}, {"type": "subtitle", "time": 5781.95, "timestamp": "01:36:21", "text": "进入火星或某个卫星或其他什么地方"}, {"type": "subtitle", "time": 5784.51, "timestamp": "01:36:24", "text": "其他地方"}, {"type": "subtitle", "time": 5787.75, "timestamp": "01:36:27", "text": "时刻准备武器，以防万一。"}, {"type": "subtitle", "time": 5790.709, "timestamp": "01:36:30", "text": "谁呃，来吧，医生，允许你打扰？"}, {"type": "subtitle", "time": 5792.75, "timestamp": "01:36:32", "text": "你需要心中有一艘船才能飞翔"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "关闭以便进行砰砰声"}]
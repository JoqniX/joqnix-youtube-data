[{"type": "subtitle", "time": 3908.39, "timestamp": "01:05:08", "text": "感谢他回复我的邮件"}, {"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "我们一直试图联系您，关于"}, {"type": "subtitle", "time": 3911.71, "timestamp": "01:05:11", "text": "由于不确定性"}, {"type": "subtitle", "time": 3914.029, "timestamp": "01:05:14", "text": "[音乐]"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "呃，不用了，谢谢。听起来你好像……"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "不是"}, {"type": "subtitle", "time": 3921.15, "timestamp": "01:05:21", "text": "感兴趣，我可以不发货吗？"}, {"type": "subtitle", "time": 3922.99, "timestamp": "01:05:22", "text": "盗版 我 我想尝试 我想"}, {"type": "subtitle", "time": 3929.67, "timestamp": "01:05:29", "text": "我们来试试他，我们来试试他"}, {"type": "subtitle", "time": 3946.67, "timestamp": "01:05:46", "text": "船来了"}]
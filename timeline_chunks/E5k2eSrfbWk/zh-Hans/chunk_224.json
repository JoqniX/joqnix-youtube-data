[{"type": "subtitle", "time": 13441.59, "timestamp": "03:44:01", "text": "非常感谢您抽出时间来访"}, {"type": "subtitle", "time": 13442.83, "timestamp": "03:44:02", "text": "希望你喜欢"}, {"type": "subtitle", "time": 13446.189, "timestamp": "03:44:06", "text": "今天，Al，谢谢你的到来，希望。"}, {"type": "subtitle", "time": 13447.429, "timestamp": "03:44:07", "text": "你喜欢"}, {"type": "subtitle", "time": 13450.87, "timestamp": "03:44:10", "text": "今天结束直播"}, {"type": "subtitle", "time": 13453.87, "timestamp": "03:44:13", "text": "是的"}, {"type": "subtitle", "time": 13457.67, "timestamp": "03:44:17", "text": "但是，我很高兴我没打开它。"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "在"}, {"type": "subtitle", "time": 13462.349, "timestamp": "03:44:22", "text": "直播结束，是的，我要结束了"}, {"type": "subtitle", "time": 13467.229, "timestamp": "03:44:27", "text": "直播是因为《星空》正在让我的电脑崩溃"}, {"type": "subtitle", "time": 13470.79, "timestamp": "03:44:30", "text": "天气太热了，我也感觉一样。"}, {"type": "subtitle", "time": 13473.99, "timestamp": "03:44:33", "text": "那种窒息般的时刻，无法……"}, {"type": "subtitle", "time": 13476.75, "timestamp": "03:44:36", "text": "要呼吸，因为太热了"}, {"type": "subtitle", "time": 13479.95, "timestamp": "03:44:39", "text": "滚烫的头发拂过我的脸庞"}, {"type": "subtitle", "time": 13483.469, "timestamp": "03:44:43", "text": "我觉得它来自 Joy 电脑柜"}, {"type": "subtitle", "time": 13485.87, "timestamp": "03:44:45", "text": "就像我把脚放在下面一样"}, {"type": "subtitle", "time": 13489.429, "timestamp": "03:44:49", "text": "桌子现在好热啊"}, {"type": "subtitle", "time": 13493.55, "timestamp": "03:44:53", "text": "Ultra，要不我把你从我的频道里封禁吧"}, {"type": "subtitle", "time": 13496.95, "timestamp": "03:44:56", "text": "我当时正准备去买吃的"}]
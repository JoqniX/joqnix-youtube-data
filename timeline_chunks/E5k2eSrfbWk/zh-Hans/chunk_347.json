[{"type": "subtitle", "time": 20822.99, "timestamp": "05:47:02", "text": "实际上，嗯，因为，呃，以前在……"}, {"type": "subtitle", "time": 20825.708, "timestamp": "05:47:05", "text": "我在Twitch上直播过"}, {"type": "subtitle", "time": 20829.83, "timestamp": "05:47:09", "text": "Zuki 嗯嗯，我们俩一起玩过"}, {"type": "subtitle", "time": 20835.548, "timestamp": "05:47:15", "text": "不，她让我开始，呃，开始你"}, {"type": "subtitle", "time": 20839.27, "timestamp": "05:47:19", "text": "其实，你好，你好吗？"}, {"type": "subtitle", "time": 20841.548, "timestamp": "05:47:21", "text": "你好吗？希望你一切都好。"}, {"type": "subtitle", "time": 20844.51, "timestamp": "05:47:24", "text": "等等等等等等等等，等等，我想"}, {"type": "subtitle", "time": 20848.35, "timestamp": "05:47:28", "text": "我开始犯错，呃，错误，呃。"}, {"type": "subtitle", "time": 20850.708, "timestamp": "05:47:30", "text": "呃，又要开始手术了，哦天哪，我一直……"}, {"type": "subtitle", "time": 20854.03, "timestamp": "05:47:34", "text": "我忘了自己应该说话。"}, {"type": "subtitle", "time": 20856.23, "timestamp": "05:47:36", "text": "欢迎大家聊天和点赞"}, {"type": "subtitle", "time": 20858.51, "timestamp": "05:47:38", "text": "比如做些事情，聊聊我的一天"}, {"type": "subtitle", "time": 20862.31, "timestamp": "05:47:42", "text": "一切都持续30分钟或1小时，然后开始"}, {"type": "subtitle", "time": 20865.15, "timestamp": "05:47:45", "text": "进入内容或游戏，对吗？"}, {"type": "subtitle", "time": 20866.11, "timestamp": "05:47:46", "text": "保持"}, {"type": "subtitle", "time": 20870.15, "timestamp": "05:47:50", "text": "忘了，所以，嗯，我就……我就……"}, {"type": "subtitle", "time": 20874.19, "timestamp": "05:47:54", "text": "有点晚了，因为我忘了发帖。"}, {"type": "subtitle", "time": 20879.23, "timestamp": "05:47:59", "text": "直播间，还有，嗯，是的"}]
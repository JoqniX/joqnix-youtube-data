[{"type": "subtitle", "time": 7441.109, "timestamp": "02:04:01", "text": "疲れたような声は出ない"}, {"type": "subtitle", "time": 7444.95, "timestamp": "02:04:04", "text": "わかった、待って、私の声は聞こえますか？"}, {"type": "subtitle", "time": 7448.47, "timestamp": "02:04:08", "text": "疲れた"}, {"type": "subtitle", "time": 7455.549, "timestamp": "02:04:15", "text": "ああ、待って、実際、寝ると"}, {"type": "subtitle", "time": 7459.189, "timestamp": "02:04:19", "text": "あなたは健康を取り戻した、それは実際には"}, {"type": "subtitle", "time": 7461.709, "timestamp": "02:04:21", "text": "面白いですね、それは実際には"}, {"type": "subtitle", "time": 7464.87, "timestamp": "02:04:24", "text": "寝るときは涼しい場所がいい"}, {"type": "subtitle", "time": 7467.87, "timestamp": "02:04:27", "text": "これで健康を手に入れることができます"}, {"type": "subtitle", "time": 7470.83, "timestamp": "02:04:30", "text": "地域は実際には"}, {"type": "subtitle", "time": 7478.669, "timestamp": "02:04:38", "text": "えっと、いいよ、えっと、私の"}, {"type": "subtitle", "time": 7480.589, "timestamp": "02:04:40", "text": "ジャンク品をまた無料で投棄できます"}, {"type": "subtitle", "time": 7484.109, "timestamp": "02:04:44", "text": "私のバッグ、うん、もういっぱいだけど"}, {"type": "subtitle", "time": 7486.109, "timestamp": "02:04:46", "text": "満腹じゃないよ、たくさんあげるよ"}, {"type": "subtitle", "time": 7495.709, "timestamp": "02:04:55", "text": "彼女にあげようと思う"}, {"type": "subtitle", "time": 7499.31, "timestamp": "02:04:59", "text": "えっと、この2つは同じですか？"}]
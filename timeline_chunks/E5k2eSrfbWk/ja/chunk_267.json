[{"type": "subtitle", "time": 16022.63, "timestamp": "04:27:02", "text": "あるいは、私たちはそれを拡散した、拡散した"}, {"type": "subtitle", "time": 16025.83, "timestamp": "04:27:05", "text": "私たちはそれをしました 私たちはそれをしました"}, {"type": "subtitle", "time": 16033.71, "timestamp": "04:27:13", "text": "いいね、オーケー、爆弾が明るくなる"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "そして赤は急がなければならない、さもないと"}, {"type": "subtitle", "time": 16038.95, "timestamp": "04:27:18", "text": "時間が経つにつれて彼らは死んでいく"}, {"type": "subtitle", "time": 16041.67, "timestamp": "04:27:21", "text": "恐怖と不安、私は彼らが苦しむのを見ている"}, {"type": "subtitle", "time": 16053.83, "timestamp": "04:27:33", "text": "パン、君の番だよ"}, {"type": "subtitle", "time": 16055.51, "timestamp": "04:27:35", "text": "右"}, {"type": "subtitle", "time": 16059.149, "timestamp": "04:27:39", "text": "はい、大丈夫です、ロコ、気をつけて、こんにちは"}]
[{"type": "subtitle", "time": 16322.03, "timestamp": "04:32:02", "text": "いや、タイマーSPアップああいやああいやえ、じゃあ"}, {"type": "subtitle", "time": 16326.03, "timestamp": "04:32:06", "text": "S は正しいか、そうすべきだと言っています"}, {"type": "subtitle", "time": 16330.07, "timestamp": "04:32:10", "text": "ダイヤモンドは「ああ、わからない、やってみよう」と言った"}, {"type": "subtitle", "time": 16332.63, "timestamp": "04:32:12", "text": "DIはスキップと言いますが、まだあります"}, {"type": "subtitle", "time": 16336.63, "timestamp": "04:32:16", "text": "左のボタン 私は死んでいます 待って"}, {"type": "subtitle", "time": 16339.63, "timestamp": "04:32:19", "text": "いいえ、私はまだやらなければならない"}, {"type": "subtitle", "time": 16340.99, "timestamp": "04:32:20", "text": "ボタン、間違ったものを渡されました"}, {"type": "subtitle", "time": 16345.429, "timestamp": "04:32:25", "text": "ストライキが起きた、いやいやいやいや、待って"}, {"type": "subtitle", "time": 16349.51, "timestamp": "04:32:29", "text": "えっと、本当に、ボタンを押し続けてください。"}, {"type": "subtitle", "time": 16350.83, "timestamp": "04:32:30", "text": "保持しようとする"}, {"type": "subtitle", "time": 16354.109, "timestamp": "04:32:34", "text": "ボタンを押し続ける"}, {"type": "subtitle", "time": 16358.99, "timestamp": "04:32:38", "text": "はい、ええと、白い白い帯を持って"}, {"type": "subtitle", "time": 16362.429, "timestamp": "04:32:42", "text": "白いストライプCには、"}, {"type": "subtitle", "time": 16365.95, "timestamp": "04:32:45", "text": "どの位置でも1つの数字が1つあります"}, {"type": "subtitle", "time": 16370.51, "timestamp": "04:32:50", "text": "どのポジションでも1つずつはいすべて"}, {"type": "subtitle", "time": 16376.429, "timestamp": "04:32:56", "text": "よし、終わった。サイモンはイエスリーと言う。そうだ、そうだ。"}]
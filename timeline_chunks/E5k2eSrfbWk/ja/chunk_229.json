[{"type": "subtitle", "time": 13741.469, "timestamp": "03:49:01", "text": "8時間かかるストーリーを"}, {"type": "subtitle", "time": 13744.59, "timestamp": "03:49:04", "text": "サイドクエストは後で、うん、そうなるだろう"}, {"type": "subtitle", "time": 13746.189, "timestamp": "03:49:06", "text": "また"}, {"type": "subtitle", "time": 13750.469, "timestamp": "03:49:10", "text": "神様、人々はすでに"}, {"type": "subtitle", "time": 13753.229, "timestamp": "03:49:13", "text": "スターフィールドを終えた"}, {"type": "subtitle", "time": 13755.71, "timestamp": "03:49:15", "text": "うわ、やべえ"}, {"type": "subtitle", "time": 13757.389, "timestamp": "03:49:17", "text": "それは"}, {"type": "subtitle", "time": 13759.67, "timestamp": "03:49:19", "text": "いいね"}, {"type": "subtitle", "time": 13763.269, "timestamp": "03:49:23", "text": "わあ、いいですね。とにかく、こんにちは。私は続けていきます。"}, {"type": "subtitle", "time": 13765.87, "timestamp": "03:49:25", "text": "私が話し続けるなら、さあ、こんにちは、"}, {"type": "subtitle", "time": 13768.87, "timestamp": "03:49:28", "text": "これで終わりにします。皆さんありがとうございました。"}, {"type": "subtitle", "time": 13780.67, "timestamp": "03:49:40", "text": "今日は本当にありがとうございました。"}, {"type": "subtitle", "time": 13783.83, "timestamp": "03:49:43", "text": "Twitch、えっと、配信できるか見てみましょう"}, {"type": "subtitle", "time": 13786.95, "timestamp": "03:49:46", "text": "無理はしたくないけど"}, {"type": "subtitle", "time": 13789.79, "timestamp": "03:49:49", "text": "金曜日は休みかもしれないけど"}, {"type": "subtitle", "time": 13793.55, "timestamp": "03:49:53", "text": "わからない、こんにちは、どうなるか見てみましょう"}, {"type": "subtitle", "time": 13796.55, "timestamp": "03:49:56", "text": "おそらく私はウェブサイトを作らないでしょう"}, {"type": "subtitle", "time": 13799.59, "timestamp": "03:49:59", "text": "しばらくは色々あるけど、まあ、様子を見てみよう"}]
[{"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "お腹が空いた、もう一方の洞窟には"}, {"type": "subtitle", "time": 3383.95, "timestamp": "00:56:23", "text": "想像してみて、それは終わるだろう"}, {"type": "subtitle", "time": 3393.549, "timestamp": "00:56:33", "text": "ああ、彼らは互いに戦っている"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "他の私は"}, {"type": "subtitle", "time": 3407.27, "timestamp": "00:56:47", "text": "もっとサラ、何をしているの？何が問題なの？"}]
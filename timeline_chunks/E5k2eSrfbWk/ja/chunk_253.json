[{"type": "subtitle", "time": 15181.309, "timestamp": "04:13:01", "text": "終わったよ、ああ、終わったと思う"}, {"type": "subtitle", "time": 15185.269, "timestamp": "04:13:05", "text": "すると、大きな男の子が大きなボタンを押す"}, {"type": "subtitle", "time": 15187.51, "timestamp": "04:13:07", "text": "どうすればいいですか？黄色です。"}, {"type": "subtitle", "time": 15189.149, "timestamp": "04:13:09", "text": "プレス"}, {"type": "subtitle", "time": 15192.99, "timestamp": "04:13:12", "text": "ボタンは黄色で、「押す」と書いてあります"}, {"type": "subtitle", "time": 15193.79, "timestamp": "04:13:13", "text": "うん"}, {"type": "subtitle", "time": 15196.79, "timestamp": "04:13:16", "text": "はい、わかりました。ボタンが青色の場合はいいえ"}, {"type": "subtitle", "time": 15199.07, "timestamp": "04:13:19", "text": "複数の待機がある場合、どのように"}, {"type": "subtitle", "time": 15201.83, "timestamp": "04:13:21", "text": "爆弾にはたくさんの電池が積まれている"}, {"type": "subtitle", "time": 15206.349, "timestamp": "04:13:26", "text": "２３、うん３３、わかったけど"}, {"type": "subtitle", "time": 15210.189, "timestamp": "04:13:30", "text": "バッテリーが1つあると書いてある"}, {"type": "subtitle", "time": 15214.03, "timestamp": "04:13:34", "text": "バッテリー1個、つまりこれは"}, {"type": "subtitle", "time": 15217.429, "timestamp": "04:13:37", "text": "cial のすぐ横の方へ"}, {"type": "subtitle", "time": 15221.79, "timestamp": "04:13:41", "text": "番号はうんうん、バッテリー1個、うん1個"}, {"type": "subtitle", "time": 15224.75, "timestamp": "04:13:44", "text": "バッテリーは1つありますか？"}, {"type": "subtitle", "time": 15227.429, "timestamp": "04:13:47", "text": "ボタンが白なら、いいえ、"}, {"type": "subtitle", "time": 15229.189, "timestamp": "04:13:49", "text": "バッテリーが2個以上ありますか？いいえ、"}, {"type": "subtitle", "time": 15233.07, "timestamp": "04:13:53", "text": "ボタンは黄色です。ボタンを押し続けてください。"}, {"type": "subtitle", "time": 15236.75, "timestamp": "04:13:56", "text": "表示されるストリップの色は大丈夫です"}, {"type": "subtitle", "time": 15238.63, "timestamp": "04:13:58", "text": "保持しているそれは"}]
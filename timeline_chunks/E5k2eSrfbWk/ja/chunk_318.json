[{"type": "subtitle", "time": 19081.07, "timestamp": "05:18:01", "text": "爆弾の拡散を見るためだけではない"}, {"type": "subtitle", "time": 19095.39, "timestamp": "05:18:15", "text": "よし、爆弾はここにある、こんにちは、私たちは"}, {"type": "subtitle", "time": 19099.23, "timestamp": "05:18:19", "text": "ええと、配線があります、キーパッドがあります"}, {"type": "subtitle", "time": 19100.97, "timestamp": "05:18:20", "text": "サーモンがあります"}, {"type": "subtitle", "time": 19102.83, "timestamp": "05:18:22", "text": "[音楽]"}, {"type": "subtitle", "time": 19105.868, "timestamp": "05:18:25", "text": "記号なし、ああ、そう、キーパッド"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "シンボル"}, {"type": "subtitle", "time": 19109.948, "timestamp": "05:18:29", "text": "えっと、どっちをやりたいですか？"}, {"type": "subtitle", "time": 19112.35, "timestamp": "05:18:32", "text": "私は壊した"}, {"type": "subtitle", "time": 19115.47, "timestamp": "05:18:35", "text": "伝統に従って、まずは配線をしましょう。"}, {"type": "subtitle", "time": 19119.548, "timestamp": "05:18:39", "text": "配線をしましょう。6本あります。"}, {"type": "subtitle", "time": 19124.03, "timestamp": "05:18:44", "text": "ワイヤー6本、大丈夫、黄色はありますか？"}, {"type": "subtitle", "time": 19128.548, "timestamp": "05:18:48", "text": "ワイヤー、えっと、白いワイヤーが2本あって、それから2本"}, {"type": "subtitle", "time": 19133.31, "timestamp": "05:18:53", "text": "青い線と、さらに2本の白い線"}, {"type": "subtitle", "time": 19134.59, "timestamp": "05:18:54", "text": "[音楽]"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "ワイヤーは、黄色はありません。"}]
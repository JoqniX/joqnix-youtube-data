[{"type": "subtitle", "time": 9851.07, "timestamp": "02:44:11", "text": "エレベーター"}, {"type": "subtitle", "time": 9853.55, "timestamp": "02:44:13", "text": "少年よ、もし何か買いたいなら"}, {"type": "subtitle", "time": 9857.389, "timestamp": "02:44:17", "text": "確かにアモリはあなたを助けることができます、私は"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "キオスクが基本的なものをカバーしてくれることを恐れています"}, {"type": "subtitle", "time": 9861.26, "timestamp": "02:44:21", "text": "質問があれば"}, {"type": "subtitle", "time": 9873.23, "timestamp": "02:44:33", "text": "それ自体は、おかしなことは何もない"}, {"type": "subtitle", "time": 9878.11, "timestamp": "02:44:38", "text": "ブーストパックのような感覚で、私は今ここにいます"}, {"type": "subtitle", "time": 9880.07, "timestamp": "02:44:40", "text": "私のラインでは"}, {"type": "subtitle", "time": 9883.07, "timestamp": "02:44:43", "text": "仕事以外の仕事は、いくつか変わったことをしました"}, {"type": "subtitle", "time": 9884.95, "timestamp": "02:44:44", "text": "仕事 um"}, {"type": "subtitle", "time": 9888.23, "timestamp": "02:44:48", "text": "はい、そうです。実はそれが私が"}, {"type": "subtitle", "time": 9896.67, "timestamp": "02:44:56", "text": "素晴らしいですね、あなたは"}, {"type": "subtitle", "time": 9899.15, "timestamp": "02:44:59", "text": "AR リターン ああ、サイドを作らなかった"}]
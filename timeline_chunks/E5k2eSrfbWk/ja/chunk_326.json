[{"type": "subtitle", "time": 19560.39, "timestamp": "05:26:00", "text": "私と一緒に参加してくれてありがとう"}, {"type": "subtitle", "time": 19563.948, "timestamp": "05:26:03", "text": "今日は本当に本当に"}, {"type": "subtitle", "time": 19567.07, "timestamp": "05:26:07", "text": "楽しかったですか？"}, {"type": "subtitle", "time": 19571.15, "timestamp": "05:26:11", "text": "はい、4回爆発しました、すみません"}, {"type": "subtitle", "time": 19574.868, "timestamp": "05:26:14", "text": "ああ、つまりあなたは私を爆破するのが好きなのね"}, {"type": "subtitle", "time": 19584.35, "timestamp": "05:26:24", "text": "ええ、私はBLです、いいえ、いいえ、いいえ、いいえ、ええと"}, {"type": "subtitle", "time": 19588.03, "timestamp": "05:26:28", "text": "わからない、いや、楽しめなかった"}, {"type": "subtitle", "time": 19590.15, "timestamp": "05:26:30", "text": "爆破するけど、楽しい時間を過ごしています"}, {"type": "subtitle", "time": 19592.47, "timestamp": "05:26:32", "text": "いつ"}, {"type": "subtitle", "time": 19596.47, "timestamp": "05:26:36", "text": "拡散した ああ、私も"}, {"type": "subtitle", "time": 19599.4, "timestamp": "05:26:39", "text": "私も それで"}, {"type": "subtitle", "time": 19600.76, "timestamp": "05:26:40", "text": "それで えっと、私はここに長くいることはできません"}, {"type": "subtitle", "time": 19603.36, "timestamp": "05:26:43", "text": "えっと、私はここに長くいることはできません 長くなれば"}, {"type": "subtitle", "time": 19605.44, "timestamp": "05:26:45", "text": "長くなれば いいよ、楽しんで。"}, {"type": "subtitle", "time": 19607.958, "timestamp": "05:26:47", "text": "いいよ、楽しんで。 うん"}, {"type": "subtitle", "time": 19617.548, "timestamp": "05:26:57", "text": "うん、ジャックのチャンネルを登録して、うん、登録して"}, {"type": "subtitle", "time": 19619.948, "timestamp": "05:26:59", "text": "購読して"}]
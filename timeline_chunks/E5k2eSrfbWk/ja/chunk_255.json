[{"type": "subtitle", "time": 15300.71, "timestamp": "04:15:00", "text": "振り向く"}, {"type": "subtitle", "time": 15304.03, "timestamp": "04:15:04", "text": "えっと、あなたの番ですね。ええ、わかってます。"}, {"type": "subtitle", "time": 15308.429, "timestamp": "04:15:08", "text": "下手くそだろうけど、まあやってみよう"}, {"type": "subtitle", "time": 15311.87, "timestamp": "04:15:11", "text": "はい、ええと、背景を説明すると、これは"}, {"type": "subtitle", "time": 15314.83, "timestamp": "04:15:14", "text": "実は、これは初めてプレイするものです"}, {"type": "subtitle", "time": 15318.349, "timestamp": "04:15:18", "text": "ゲーム、いや、厳密には違うけど、まあ"}, {"type": "subtitle", "time": 15322.349, "timestamp": "04:15:22", "text": "いや、でも実際はそうなんです"}, {"type": "subtitle", "time": 15326.109, "timestamp": "04:15:26", "text": "はい、わかりました。教えてください。"}, {"type": "subtitle", "time": 15328.91, "timestamp": "04:15:28", "text": "マニュアルを用意してください"}, {"type": "subtitle", "time": 15331.87, "timestamp": "04:15:31", "text": "はい、待ってください、マニュアルを表示すべきでしょうか"}, {"type": "subtitle", "time": 15334.59, "timestamp": "04:15:34", "text": "ストリームとか何か、それともただ"}, {"type": "subtitle", "time": 15336.99, "timestamp": "04:15:36", "text": "つまり、それはあなた次第です。私は見せています"}, {"type": "subtitle", "time": 15339.229, "timestamp": "04:15:39", "text": "私のにも付いてるけど、ああ、見せてるんだね"}, {"type": "subtitle", "time": 15342.55, "timestamp": "04:15:42", "text": "私のは、ちょっと手早くやらせてください"}, {"type": "subtitle", "time": 15348.469, "timestamp": "04:15:48", "text": "聞こえる、ああ、気付いたよ、中、中、中"}, {"type": "subtitle", "time": 15359.349, "timestamp": "04:15:59", "text": "待って、あなたは詩を書きました"}]
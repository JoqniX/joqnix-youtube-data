[{"type": "subtitle", "time": 10980.63, "timestamp": "03:03:00", "text": "実際、これが必要だ、これは必要ない"}, {"type": "subtitle", "time": 10984.15, "timestamp": "03:03:04", "text": "男、あぁ、シャンク、俺は、俺は、受け取るだろうか"}, {"type": "subtitle", "time": 10988.429, "timestamp": "03:03:08", "text": "これは私にはわからないが、それは斧か"}, {"type": "subtitle", "time": 10989.269, "timestamp": "03:03:09", "text": "RIP"}, {"type": "subtitle", "time": 10992.87, "timestamp": "03:03:12", "text": "シャンク、斧の方が良いと思うので、"}, {"type": "subtitle", "time": 10995.51, "timestamp": "03:03:15", "text": "この男を"}, {"type": "subtitle", "time": 10998.429, "timestamp": "03:03:18", "text": "えっと"}, {"type": "subtitle", "time": 11000.83, "timestamp": "03:03:20", "text": "だから"}, {"type": "subtitle", "time": 11004.11, "timestamp": "03:03:24", "text": "えっと、これ以上銃を持ち歩きたくないんです"}, {"type": "subtitle", "time": 11006.55, "timestamp": "03:03:26", "text": "とはいえ、それはまた"}, {"type": "subtitle", "time": 11008.59, "timestamp": "03:03:28", "text": "わかってるよ、大丈夫"}, {"type": "subtitle", "time": 11010.67, "timestamp": "03:03:30", "text": "ライフル"}, {"type": "subtitle", "time": 11027.87, "timestamp": "03:03:47", "text": "[音楽]"}]
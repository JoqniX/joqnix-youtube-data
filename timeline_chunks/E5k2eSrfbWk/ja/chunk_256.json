[{"type": "subtitle", "time": 15366.189, "timestamp": "04:16:06", "text": "本当にバーは言った、私は知らないよ"}, {"type": "subtitle", "time": 15368.149, "timestamp": "04:16:08", "text": "まず、配信か何かで、うん。"}, {"type": "subtitle", "time": 15369.55, "timestamp": "04:16:09", "text": "初めて"}, {"type": "subtitle", "time": 15378.109, "timestamp": "04:16:18", "text": "準備ができたら教えてね、うん、準備ができたら"}, {"type": "subtitle", "time": 15381.95, "timestamp": "04:16:21", "text": "ほぼ準備完了 CH これは、"}, {"type": "subtitle", "time": 15384.79, "timestamp": "04:16:24", "text": "横に、あなたは読めない"}, {"type": "subtitle", "time": 15387.95, "timestamp": "04:16:27", "text": "これは拡散マニュアルです、ああ神様"}, {"type": "subtitle", "time": 15391.03, "timestamp": "04:16:31", "text": "私はこれが苦手なので、はい、準備はできています"}, {"type": "subtitle", "time": 15398.55, "timestamp": "04:16:38", "text": "よし、準備はいいか？うん、私は"}, {"type": "subtitle", "time": 15401.07, "timestamp": "04:16:41", "text": "最初の"}, {"type": "subtitle", "time": 15404.51, "timestamp": "04:16:44", "text": "爆弾だ、ああ神様"}, {"type": "subtitle", "time": 15406.389, "timestamp": "04:16:46", "text": "この画面はあなただけのものです"}, {"type": "subtitle", "time": 15407.71, "timestamp": "04:16:47", "text": "爆弾を見ることは許されない"}, {"type": "subtitle", "time": 15413.79, "timestamp": "04:16:53", "text": "私の体はあなたの手の中にあります 私の体は"}, {"type": "subtitle", "time": 15415.349, "timestamp": "04:16:55", "text": "あなたの"}, {"type": "subtitle", "time": 15419.229, "timestamp": "04:16:59", "text": "両手は大丈夫、爆弾はここにある"}]
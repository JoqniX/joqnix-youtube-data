[{"type": "subtitle", "time": 19261.59, "timestamp": "05:21:01", "text": "黄色になる"}, {"type": "subtitle", "time": 19264.04, "timestamp": "05:21:04", "text": "黄色 黄色 黄色"}, {"type": "subtitle", "time": 19265.948, "timestamp": "05:21:05", "text": "[音楽]"}, {"type": "subtitle", "time": 19269.07, "timestamp": "05:21:09", "text": "えっと、ちょっと待ってください。もう一度繰り返します。"}, {"type": "subtitle", "time": 19272.15, "timestamp": "05:21:12", "text": "黄色、黄色、えっと"}, {"type": "subtitle", "time": 19281.59, "timestamp": "05:21:21", "text": "今は黄色に黄色に変わります"}, {"type": "subtitle", "time": 19285.67, "timestamp": "05:21:25", "text": "黄色だから緑緑"}, {"type": "subtitle", "time": 19289.548, "timestamp": "05:21:29", "text": "グリーンは爆弾を終えた、爆弾は終わった、爆弾は"}, {"type": "subtitle", "time": 19291.83, "timestamp": "05:21:31", "text": "拡散した"}, {"type": "subtitle", "time": 19294.75, "timestamp": "05:21:34", "text": "1分9秒でナイス"}, {"type": "subtitle", "time": 19298.75, "timestamp": "05:21:38", "text": "時計が"}, {"type": "subtitle", "time": 19301.708, "timestamp": "05:21:41", "text": "CU 私たちはたくさんの"}, {"type": "subtitle", "time": 19306.51, "timestamp": "05:21:46", "text": "迷路が苦痛であることを願う時間"}, {"type": "subtitle", "time": 19312.32, "timestamp": "05:21:52", "text": "えっと、インベーダーズを持ってるよ、忘れないで"}, {"type": "subtitle", "time": 19319.23, "timestamp": "05:21:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 12780.71, "timestamp": "03:33:00", "text": "一緒に"}, {"type": "subtitle", "time": 12783.309, "timestamp": "03:33:03", "text": "ところで、あなたはどうしたいですか？"}, {"type": "subtitle", "time": 12785.79, "timestamp": "03:33:05", "text": "一緒に旅を続けよう 私は座っていません"}, {"type": "subtitle", "time": 12787.429, "timestamp": "03:33:07", "text": "私の机の後ろで、彼女はこれを望んでいる"}, {"type": "subtitle", "time": 12789.309, "timestamp": "03:33:09", "text": "これらの遺物を旅することは新たな章となる"}, {"type": "subtitle", "time": 12792.79, "timestamp": "03:33:12", "text": "コンベンションには参加するつもりです"}, {"type": "subtitle", "time": 12796.91, "timestamp": "03:33:16", "text": "そして君にもそこにいてほしいんだ"}, {"type": "subtitle", "time": 12799.349, "timestamp": "03:33:19", "text": "結果を出すには、あなたのような人が見守ってくれる必要があります"}, {"type": "subtitle", "time": 12800.189, "timestamp": "03:33:20", "text": "私の"}, {"type": "subtitle", "time": 12804.189, "timestamp": "03:33:24", "text": "戻って、えーと、鍋を取り戻しましょう。"}, {"type": "subtitle", "time": 12806.309, "timestamp": "03:33:26", "text": "はい、さらにいくつか手がかりがあります"}, {"type": "subtitle", "time": 12809.189, "timestamp": "03:33:29", "text": "まず最初に話すべきことは"}, {"type": "subtitle", "time": 12811.269, "timestamp": "03:33:31", "text": "サムコが実施している遠征"}, {"type": "subtitle", "time": 12813.429, "timestamp": "03:33:33", "text": "一緒にフリースターコレクティブ"}, {"type": "subtitle", "time": 12816.389, "timestamp": "03:33:36", "text": "彼は宇宙のことを隅から隅まで知り尽くしている"}, {"type": "subtitle", "time": 12819.189, "timestamp": "03:33:39", "text": "そこには私たちのスターもいます"}, {"type": "subtitle", "time": 12822.59, "timestamp": "03:33:42", "text": "駅はウラジーミルが"}, {"type": "subtitle", "time": 12824.71, "timestamp": "03:33:44", "text": "一生懸命働いている、ああ、あれは"}, {"type": "subtitle", "time": 12826.429, "timestamp": "03:33:46", "text": "えっと、あなたへ"}, {"type": "subtitle", "time": 12828.87, "timestamp": "03:33:48", "text": "そこにはたくさんのお金が手に入る"}, {"type": "subtitle", "time": 12831.189, "timestamp": "03:33:51", "text": "バレットからのものは何もないが、宅配便は"}, {"type": "subtitle", "time": 12833.03, "timestamp": "03:33:53", "text": "アロス抽出業者が私たちに知らせに来ました"}, {"type": "subtitle", "time": 12834.71, "timestamp": "03:33:54", "text": "彼らは作戦を片付けている"}, {"type": "subtitle", "time": 12837.55, "timestamp": "03:33:57", "text": "ベクタだがそれだけだ、他にはない"}]
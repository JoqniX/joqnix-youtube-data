[{"type": "subtitle", "time": 1200.11, "timestamp": "00:20:00", "text": "マン・デ・ブレ、俺はただ見守るだけさ、ああ、死ぬんだ"}, {"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "ああ、私は"}, {"type": "subtitle", "time": 1204.87, "timestamp": "00:20:04", "text": "何何"}, {"type": "subtitle", "time": 1209.43, "timestamp": "00:20:09", "text": "えー、悲しいですね、私のせいですか、私は"}, {"type": "subtitle", "time": 1212.27, "timestamp": "00:20:12", "text": "寒かった"}, {"type": "subtitle", "time": 1214.95, "timestamp": "00:20:14", "text": "目に見えない言い訳"}, {"type": "subtitle", "time": 1224.669, "timestamp": "00:20:24", "text": "こんにちは、彼女のせいです、なぜ私は"}, {"type": "subtitle", "time": 1257.59, "timestamp": "00:20:57", "text": "わかった、私たちは"}]
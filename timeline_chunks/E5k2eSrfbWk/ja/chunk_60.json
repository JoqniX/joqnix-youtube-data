[{"type": "subtitle", "time": 3618.27, "timestamp": "01:00:18", "text": "ニベカブトムシカブトムシみたい、ああ神様私の"}, {"type": "subtitle", "time": 3620.75, "timestamp": "01:00:20", "text": "夢を見れば、それが私たちに何かを伝えてくれるかもしれません"}, {"type": "subtitle", "time": 3624.27, "timestamp": "01:00:24", "text": "最寄りのレストランへ"}, {"type": "subtitle", "time": 3628.349, "timestamp": "01:00:28", "text": "[音楽]"}, {"type": "subtitle", "time": 3629.589, "timestamp": "01:00:29", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 3644.23, "timestamp": "01:00:44", "text": "カブトムシがやっと終わった、ああ神様"}, {"type": "subtitle", "time": 3648.95, "timestamp": "01:00:48", "text": "やっと行った"}, {"type": "subtitle", "time": 3652.67, "timestamp": "01:00:52", "text": "兄弟、俺は家に帰るよ"}]
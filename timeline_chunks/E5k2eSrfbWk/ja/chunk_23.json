[{"type": "subtitle", "time": 1381.75, "timestamp": "00:23:01", "text": "サーバーがこれらの電話などをスキャンして、私は手に入れました"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "華やかなものなら、家に帰れるよ"}, {"type": "subtitle", "time": 1389.83, "timestamp": "00:23:09", "text": "最後にこれを正しく行う、これを止められるなら"}, {"type": "subtitle", "time": 1393.51, "timestamp": "00:23:13", "text": "女性が干渉するのを防ぎ、"}, {"type": "subtitle", "time": 1396.39, "timestamp": "00:23:16", "text": "撮影します"}, {"type": "subtitle", "time": 1418.83, "timestamp": "00:23:38", "text": "わかった、いや、私は"}, {"type": "subtitle", "time": 1420.71, "timestamp": "00:23:40", "text": "近かった"}]
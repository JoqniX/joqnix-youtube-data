[{"type": "subtitle", "time": 17461.31, "timestamp": "04:51:01", "text": "三角形 私は三角形です、わかりました"}, {"type": "subtitle", "time": 17466.07, "timestamp": "04:51:06", "text": "そう、君は、えっと、手を伸ばすべきだ"}, {"type": "subtitle", "time": 17467.59, "timestamp": "04:51:07", "text": "の"}, {"type": "subtitle", "time": 17470.59, "timestamp": "04:51:10", "text": "2番目の丸いもの、または白いI"}, {"type": "subtitle", "time": 17473.23, "timestamp": "04:51:13", "text": "白いものが見えない"}, {"type": "subtitle", "time": 17476.628, "timestamp": "04:51:16", "text": "マニュアル、どうやってイナグするのか"}, {"type": "subtitle", "time": 17479.51, "timestamp": "04:51:19", "text": "実際、それは意図されたものではないと確信しています"}, {"type": "subtitle", "time": 17481.07, "timestamp": "04:51:21", "text": "見られるように、あなたに伝えなければならない"}, {"type": "subtitle", "time": 17483.31, "timestamp": "04:51:23", "text": "三角形と白い物体がある場所"}, {"type": "subtitle", "time": 17487.99, "timestamp": "04:51:27", "text": "ああ、そういうことか、わかったわかった"}, {"type": "subtitle", "time": 17491.628, "timestamp": "04:51:31", "text": "うん、ああ、こんな感じでいいよ、続けるよ"}, {"type": "subtitle", "time": 17509.708, "timestamp": "04:51:49", "text": "こんにちは、ようこそ、ようこそ、ああ、お願いだからやめてください"}, {"type": "subtitle", "time": 17511.99, "timestamp": "04:51:51", "text": "モールス信号を思い出させる、それは痛みだ"}]
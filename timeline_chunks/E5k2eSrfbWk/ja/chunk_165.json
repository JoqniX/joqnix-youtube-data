[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "クエスト、ああ神様、もちろん彼らは"}, {"type": "subtitle", "time": 9904.429, "timestamp": "02:45:04", "text": "そこで聞いたが、"}, {"type": "subtitle", "time": 9907.71, "timestamp": "02:45:07", "text": "ああ、なぜ私は私たちを作ったのか、なぜ私は"}, {"type": "subtitle", "time": 9917.07, "timestamp": "02:45:17", "text": "[音楽]"}, {"type": "subtitle", "time": 9928.429, "timestamp": "02:45:28", "text": "えー、人が話しかけてくるのに慣れてない"}, {"type": "subtitle", "time": 9932.75, "timestamp": "02:45:32", "text": "えっと、私はいつも"}, {"type": "subtitle", "time": 9934.95, "timestamp": "02:45:34", "text": "一度行ったら、いつも持っていた"}, {"type": "subtitle", "time": 9936.71, "timestamp": "02:45:36", "text": "全体的に"}, {"type": "subtitle", "time": 9941.469, "timestamp": "02:45:41", "text": "痛い、この会話が始まって2分"}, {"type": "subtitle", "time": 9943.75, "timestamp": "02:45:43", "text": "外"}, {"type": "subtitle", "time": 9947.95, "timestamp": "02:45:47", "text": "彼女の軍隊は実際にあまりにも"}, {"type": "subtitle", "time": 9950.389, "timestamp": "02:45:50", "text": "数えきれないほどの命"}, {"type": "subtitle", "time": 9953.15, "timestamp": "02:45:53", "text": "でも、私はそれら全てを経験してきたわ。"}, {"type": "subtitle", "time": 9955.99, "timestamp": "02:45:55", "text": "よし、私はFRで多くの時間を過ごした"}, {"type": "subtitle", "time": 9957.269, "timestamp": "02:45:57", "text": "次のようなものだと思いますか"}, {"type": "subtitle", "time": 9959.469, "timestamp": "02:45:59", "text": "文明と派閥が引き起こす"}]
[{"type": "subtitle", "time": 12902.95, "timestamp": "03:35:02", "text": "行く時間だ、行く時間ではない"}, {"type": "subtitle", "time": 12906.87, "timestamp": "03:35:06", "text": "しかし、今回は私が何をするか"}, {"type": "subtitle", "time": 12910.51, "timestamp": "03:35:10", "text": "酸素が欲しい"}, {"type": "subtitle", "time": 12914.15, "timestamp": "03:35:14", "text": "実際にやろうとしていること"}, {"type": "subtitle", "time": 12919.389, "timestamp": "03:35:19", "text": "全部入れて、その物を置く"}, {"type": "subtitle", "time": 12922.87, "timestamp": "03:35:22", "text": "これを50回繰り返します。完全にマックスにします。"}, {"type": "subtitle", "time": 12924.79, "timestamp": "03:35:24", "text": "それ"}, {"type": "subtitle", "time": 12927.269, "timestamp": "03:35:27", "text": "完全に最大限まで"}, {"type": "subtitle", "time": 12931.07, "timestamp": "03:35:31", "text": "酸素フィットネス関連のものがあれば、自由になれる"}, {"type": "subtitle", "time": 12933.79, "timestamp": "03:35:33", "text": "すべてから"}, {"type": "subtitle", "time": 12937.349, "timestamp": "03:35:37", "text": "拳銃の認定について、私たちはそれを行っています"}, {"type": "subtitle", "time": 12940.349, "timestamp": "03:35:40", "text": "今はとにかく必要なだけです"}, {"type": "subtitle", "time": 12944.63, "timestamp": "03:35:44", "text": "神よ、これにはとても多くのことが必要です"}, {"type": "subtitle", "time": 12957.189, "timestamp": "03:35:57", "text": "早く伝えたいので、"}]
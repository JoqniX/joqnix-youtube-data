[{"type": "subtitle", "time": 10390.87, "timestamp": "02:53:10", "text": "RPG CUは麻薬か何か必要なもの"}, {"type": "subtitle", "time": 10393.71, "timestamp": "02:53:13", "text": "発見して、SCEについて知ってる"}, {"type": "subtitle", "time": 10395.95, "timestamp": "02:53:15", "text": "そして、何かについて調べる必要がある"}, {"type": "subtitle", "time": 10399.79, "timestamp": "02:53:19", "text": "鉱物とかそういうもの、特にこれ"}, {"type": "subtitle", "time": 10402.269, "timestamp": "02:53:22", "text": "他の残りのピースを見つける必要がある"}, {"type": "subtitle", "time": 10404.75, "timestamp": "02:53:24", "text": "これにより、これを完全に構築できます"}, {"type": "subtitle", "time": 10407.79, "timestamp": "02:53:27", "text": "人工物みたいなもの、そこに人がいる"}, {"type": "subtitle", "time": 10409.59, "timestamp": "02:53:29", "text": "あなたに反対する人たちは"}, {"type": "subtitle", "time": 10411.11, "timestamp": "02:53:31", "text": "協力的である"}, {"type": "subtitle", "time": 10418.83, "timestamp": "02:53:38", "text": "もの"}, {"type": "subtitle", "time": 10430.51, "timestamp": "02:53:50", "text": "[音楽]"}, {"type": "subtitle", "time": 10432.469, "timestamp": "02:53:52", "text": "よし、武器ロックを少し置くよ"}]
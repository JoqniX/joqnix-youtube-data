[{"type": "subtitle", "time": 14943.99, "timestamp": "04:09:03", "text": "あなた、ああ私のチャットああ"}, {"type": "subtitle", "time": 14946.63, "timestamp": "04:09:06", "text": "こんにちは"}, {"type": "subtitle", "time": 14951.59, "timestamp": "04:09:11", "text": "やあ、ジャック、じゃあ始めよう"}, {"type": "subtitle", "time": 14952.99, "timestamp": "04:09:12", "text": "私たちはこれについて話してきました"}, {"type": "subtitle", "time": 14955.91, "timestamp": "04:09:15", "text": "私たちはただ話をしているだけです"}, {"type": "subtitle", "time": 14960.67, "timestamp": "04:09:20", "text": "うん、そう、あなたは"}, {"type": "subtitle", "time": 14966.91, "timestamp": "04:09:26", "text": "専門家"}, {"type": "subtitle", "time": 14972.429, "timestamp": "04:09:32", "text": "えっと、私は拡散役になると思います。"}, {"type": "subtitle", "time": 14975.71, "timestamp": "04:09:35", "text": "はい、あなたは"}, {"type": "subtitle", "time": 14978.189, "timestamp": "04:09:38", "text": "ディフューザー"}, {"type": "subtitle", "time": 14981.83, "timestamp": "04:09:41", "text": "うん、わかった。準備ができたら教えてね。"}, {"type": "subtitle", "time": 14988.67, "timestamp": "04:09:48", "text": "えっと、最初の爆弾をやるべきですね。"}, {"type": "subtitle", "time": 14991.349, "timestamp": "04:09:51", "text": "うん、最初の爆弾はまだ手に入れていない"}, {"type": "subtitle", "time": 14993.429, "timestamp": "04:09:53", "text": "最初のパス"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "ボム・ウィー"}]
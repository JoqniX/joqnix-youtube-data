[{"type": "subtitle", "time": 6850.27, "timestamp": "01:54:10", "text": "再びIOなし"}, {"type": "subtitle", "time": 6853.189, "timestamp": "01:54:13", "text": "おお"}, {"type": "subtitle", "time": 6855.79, "timestamp": "01:54:15", "text": "待って待って待って待って"}, {"type": "subtitle", "time": 6859.79, "timestamp": "01:54:19", "text": "待って、どうやって彼を殺すか、彼を殺して、行く"}, {"type": "subtitle", "time": 6863.629, "timestamp": "01:54:23", "text": "これを手に入れたよ、ゴーゴーゴーゴーゴーH、私は"}, {"type": "subtitle", "time": 6868.27, "timestamp": "01:54:28", "text": "ダメージ、ああ、よかった、彼を殺したんだね、ありがとう"}, {"type": "subtitle", "time": 6871.99, "timestamp": "01:54:31", "text": "ああ、無料の食べ物、ああ神様、無料"}, {"type": "subtitle", "time": 6881.79, "timestamp": "01:54:41", "text": "玉ねぎ右に動いて、動いて、ああ神様"}, {"type": "subtitle", "time": 6885.629, "timestamp": "01:54:45", "text": "動かして開けさせてくれ、ああ神様これ"}, {"type": "subtitle", "time": 6888.51, "timestamp": "01:54:48", "text": "レディ"}, {"type": "subtitle", "time": 6892.83, "timestamp": "01:54:52", "text": "玉ねぎ、こんにちは、ええ、ええ、私は料理できます"}, {"type": "subtitle", "time": 6896.35, "timestamp": "01:54:56", "text": "このゲームには何もないよ、あそこに"}]
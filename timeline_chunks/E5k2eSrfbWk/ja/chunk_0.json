[{"type": "subtitle", "time": 24.189, "timestamp": "00:00:24", "text": "こんにちは"}, {"type": "subtitle", "time": 28.79, "timestamp": "00:00:28", "text": "新しいストリームの日へようこそ"}, {"type": "subtitle", "time": 34.91, "timestamp": "00:00:34", "text": "ジャトンの10パート1、別名q1cor1"}, {"type": "subtitle", "time": 40.15, "timestamp": "00:00:40", "text": "ストリーム なので、私たちは遅くに叩きました"}, {"type": "subtitle", "time": 43.069, "timestamp": "00:00:43", "text": "昨日は3時半まで起きていました"}, {"type": "subtitle", "time": 48.029, "timestamp": "00:00:48", "text": "ジョーの勤務時間は午前3時まで1/4時間。"}, {"type": "subtitle", "time": 50.229, "timestamp": "00:00:50", "text": "だから私の体は"}, {"type": "subtitle", "time": 52.069, "timestamp": "00:00:52", "text": "痛む"}, {"type": "subtitle", "time": 55.11, "timestamp": "00:00:55", "text": "頭痛がする。眠い気がする。"}, {"type": "subtitle", "time": 57.709, "timestamp": "00:00:57", "text": "あらゆるものがたくさん"}]
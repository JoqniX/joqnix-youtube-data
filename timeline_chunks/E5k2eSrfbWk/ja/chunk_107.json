[{"type": "subtitle", "time": 6423.35, "timestamp": "01:47:03", "text": "バイバイ"}, {"type": "subtitle", "time": 6435.83, "timestamp": "01:47:15", "text": "西側の最後のプレイヤーが残った。くそ、それは私の"}, {"type": "subtitle", "time": 6439.31, "timestamp": "01:47:19", "text": "初めて見ました。これが最新版です。"}, {"type": "subtitle", "time": 6448.07, "timestamp": "01:47:28", "text": "誰かの頭がめまいする"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "彼は実際に自由な男で、"}, {"type": "subtitle", "time": 6459.99, "timestamp": "01:47:39", "text": "あなた"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "OP 1 が"}]
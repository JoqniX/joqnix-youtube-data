[{"type": "subtitle", "time": 5224.79, "timestamp": "01:27:04", "text": "いいえ、彼らが現れて攻撃するなんて知りません"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "人々はランダムにヴェロンの家にいるように見える"}, {"type": "subtitle", "time": 5229.629, "timestamp": "01:27:09", "text": "技術的には外交関係がある"}, {"type": "subtitle", "time": 5231.709, "timestamp": "01:27:11", "text": "他の派閥だが、熱狂者たちは"}, {"type": "subtitle", "time": 5233.35, "timestamp": "01:27:13", "text": "彼らのコントロール外にはあまり"}, {"type": "subtitle", "time": 5238.51, "timestamp": "01:27:18", "text": "いいえ、地元の店に行くような"}, {"type": "subtitle", "time": 5242.51, "timestamp": "01:27:22", "text": "MSIサポートサービスでハットを購入"}, {"type": "subtitle", "time": 5244.629, "timestamp": "01:27:24", "text": "MSIサービスメッセンジャーズを見てください"}, {"type": "subtitle", "time": 5246.83, "timestamp": "01:27:26", "text": "Googleで「近く」とか「何か」と検索して、"}, {"type": "subtitle", "time": 5249.27, "timestamp": "01:27:29", "text": "あなたの近くにある場所を見つけてください"}, {"type": "subtitle", "time": 5253.87, "timestamp": "01:27:33", "text": "MSI をサポートしており、実際には"}, {"type": "subtitle", "time": 5256.709, "timestamp": "01:27:36", "text": "製品をMSAに渡して、えーっと、"}, {"type": "subtitle", "time": 5258.27, "timestamp": "01:27:38", "text": "コミュニケーション"}, {"type": "subtitle", "time": 5261.109, "timestamp": "01:27:41", "text": "代わりに、私はマウスでそれをしました"}, {"type": "subtitle", "time": 5263.07, "timestamp": "01:27:43", "text": "見た"}, {"type": "subtitle", "time": 5267.669, "timestamp": "01:27:47", "text": "私の近くのサービスセンターは"}, {"type": "subtitle", "time": 5271.07, "timestamp": "01:27:51", "text": "Logictech製品も取り扱っており、"}, {"type": "subtitle", "time": 5273.75, "timestamp": "01:27:53", "text": "彼らには私が話した物をすべて渡しました"}, {"type": "subtitle", "time": 5275.95, "timestamp": "01:27:55", "text": "私は彼らに物を渡したが、彼らは"}]
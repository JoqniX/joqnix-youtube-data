[{"type": "subtitle", "time": 16142.55, "timestamp": "04:29:02", "text": "シンボルを手に入れた 大きな"}, {"type": "subtitle", "time": 16146.03, "timestamp": "04:29:06", "text": "ボタン、どれをしたいですか？"}, {"type": "subtitle", "time": 16149.469, "timestamp": "04:29:09", "text": "まず、どちらをやりたいですか？"}, {"type": "subtitle", "time": 16152.87, "timestamp": "04:29:12", "text": "まず、"}, {"type": "subtitle", "time": 16155.429, "timestamp": "04:29:15", "text": "まず記号か何か、そう、記号です"}, {"type": "subtitle", "time": 16160.349, "timestamp": "04:29:20", "text": "うん、シンボルは大丈夫、えっと、私は"}, {"type": "subtitle", "time": 16161.71, "timestamp": "04:29:21", "text": "ラムダ"}, {"type": "subtitle", "time": 16164.149, "timestamp": "04:29:24", "text": "シンボル待って何"}, {"type": "subtitle", "time": 16167.07, "timestamp": "04:29:27", "text": "ハーフライフのシンボル、ああハーフライフ"}, {"type": "subtitle", "time": 16169.75, "timestamp": "04:29:29", "text": "はい、あの装置が動いています"}, {"type": "subtitle", "time": 16173.109, "timestamp": "04:29:33", "text": "走る男"}, {"type": "subtitle", "time": 16176.229, "timestamp": "04:29:36", "text": "はい、それなら、次のようなシンボルがあります"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "逆さま"}, {"type": "subtitle", "time": 16180.91, "timestamp": "04:29:40", "text": "三角形ダウン三角形あああなたの"}, {"type": "subtitle", "time": 16188.03, "timestamp": "04:29:48", "text": "そうですね、ええと、それは逆さまみたいな感じですね"}, {"type": "subtitle", "time": 16190.469, "timestamp": "04:29:50", "text": "3本の腕を持つ下向き三角形"}, {"type": "subtitle", "time": 16194.67, "timestamp": "04:29:54", "text": "下から出てくる、ああ、下向き"}, {"type": "subtitle", "time": 16197.189, "timestamp": "04:29:57", "text": "逆三角形 ああ、手に入れた、手に入れた、手に入れた"}]
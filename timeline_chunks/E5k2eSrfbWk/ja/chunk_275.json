[{"type": "subtitle", "time": 16514.429, "timestamp": "04:35:14", "text": "よし、始めよう。うん、見たよ。"}, {"type": "subtitle", "time": 16519.51, "timestamp": "04:35:19", "text": "モジュールI"}, {"type": "subtitle", "time": 16521.91, "timestamp": "04:35:21", "text": "2つ見る"}, {"type": "subtitle", "time": 16524.349, "timestamp": "04:35:24", "text": "シンボル"}, {"type": "subtitle", "time": 16527.429, "timestamp": "04:35:27", "text": "モジュール、えっと、他に何かありますか、ああ、オンになっています"}, {"type": "subtitle", "time": 16529.551, "timestamp": "04:35:29", "text": "背面は"}, {"type": "subtitle", "time": 16532.269, "timestamp": "04:35:32", "text": "前面にはボタンが2つと"}, {"type": "subtitle", "time": 16536.189, "timestamp": "04:35:36", "text": "ワイヤー、すごい、それで何をしたいのか、何をしたいのか"}, {"type": "subtitle", "time": 16539.349, "timestamp": "04:35:39", "text": "まず、えーと、難しい方から始めましょうか、"}, {"type": "subtitle", "time": 16541.789, "timestamp": "04:35:41", "text": "何か、そうだ、記号をやってみよう"}, {"type": "subtitle", "time": 16544.07, "timestamp": "04:35:44", "text": "シンボルは大丈夫"}, {"type": "subtitle", "time": 16547.23, "timestamp": "04:35:47", "text": "最初のシンボルモジュールの最初のシンボル"}, {"type": "subtitle", "time": 16550.869, "timestamp": "04:35:50", "text": "モジュール、あのクモみたいなやつ、あなたが"}, {"type": "subtitle", "time": 16553.789, "timestamp": "04:35:53", "text": "前回の試合で、三角形と"}, {"type": "subtitle", "time": 16555.429, "timestamp": "04:35:55", "text": "第3レグ"}, {"type": "subtitle", "time": 16559.109, "timestamp": "04:35:59", "text": "脚は大丈夫、それから走る"}]
[{"type": "subtitle", "time": 10924.88, "timestamp": "03:02:04", "text": "なぜ私には必要なのか"}, {"type": "subtitle", "time": 10927.389, "timestamp": "03:02:07", "text": "[音楽]"}, {"type": "subtitle", "time": 10930.269, "timestamp": "03:02:10", "text": "聖"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "おい、なんで？"}, {"type": "subtitle", "time": 10942.269, "timestamp": "03:02:22", "text": "私はそれを置くことができました。待ってください。"}, {"type": "subtitle", "time": 10953.309, "timestamp": "03:02:33", "text": "今ここで決めた"}, {"type": "subtitle", "time": 10954.75, "timestamp": "03:02:34", "text": "右"}, {"type": "subtitle", "time": 10956.87, "timestamp": "03:02:36", "text": "今"}, {"type": "subtitle", "time": 10961.229, "timestamp": "03:02:41", "text": "兄弟、おおおお収納ボックス、おおおおそう"}, {"type": "subtitle", "time": 10964.07, "timestamp": "03:02:44", "text": "うんうんうん、やっと"}, {"type": "subtitle", "time": 10968.79, "timestamp": "03:02:48", "text": "これを、あの、あの"}, {"type": "subtitle", "time": 10970.99, "timestamp": "03:02:50", "text": "グルンドレを置く必要"}, {"type": "subtitle", "time": 10973.63, "timestamp": "03:02:53", "text": "グランドル、待って待って待って"}, {"type": "subtitle", "time": 10977.83, "timestamp": "03:02:57", "text": "近接武器が必要です。"}]
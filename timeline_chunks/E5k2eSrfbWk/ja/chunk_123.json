[{"type": "subtitle", "time": 7429.51, "timestamp": "02:03:49", "text": "はい、はい、こんにちは、オースティン・フェルナンデスさん"}, {"type": "subtitle", "time": 7431.79, "timestamp": "02:03:51", "text": "こんにちは、ようこそ、ようこそ、お元気ですか？"}, {"type": "subtitle", "time": 7434.83, "timestamp": "02:03:54", "text": "ちょっと疲れているように聞こえるけど、私は今"}, {"type": "subtitle", "time": 7438.229, "timestamp": "02:03:58", "text": "それを食べることが、私が"}]
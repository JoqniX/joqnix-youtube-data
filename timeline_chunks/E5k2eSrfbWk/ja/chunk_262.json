[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "左待って、左下は誰？左下"}, {"type": "subtitle", "time": 15721.229, "timestamp": "04:22:01", "text": "は"}, {"type": "subtitle", "time": 15723.71, "timestamp": "04:22:03", "text": "ボトム 待って ボトム 左下とはどういう意味ですか?"}, {"type": "subtitle", "time": 15724.91, "timestamp": "04:22:04", "text": "また私は"}, {"type": "subtitle", "time": 15739.03, "timestamp": "04:22:19", "text": "ほぼ右"}, {"type": "subtitle", "time": 15741.55, "timestamp": "04:22:21", "text": "はい"}, {"type": "subtitle", "time": 15749.309, "timestamp": "04:22:29", "text": "そうなんだけど、怖いんだ。そうじゃないといいんだけど。"}, {"type": "subtitle", "time": 15753.75, "timestamp": "04:22:33", "text": "難しい、いや、難しそうに見える、難しそうに見える"}, {"type": "subtitle", "time": 15759.389, "timestamp": "04:22:39", "text": "いや、えっと、3つのモジュールみたいなものなので3つ"}, {"type": "subtitle", "time": 15762.03, "timestamp": "04:22:42", "text": "待って、３つって何？３つってモジュールのこと？"}, {"type": "subtitle", "time": 15763.87, "timestamp": "04:22:43", "text": "もしくはそのセクションのこと"}, {"type": "subtitle", "time": 15772.349, "timestamp": "04:22:52", "text": "理由は、Bが上がっている、そう、上がっている、5"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "1分間の爆弾とワイヤーがある"}, {"type": "subtitle", "time": 15778.03, "timestamp": "04:22:58", "text": "記号があって、それから色みたいなものがある"}]
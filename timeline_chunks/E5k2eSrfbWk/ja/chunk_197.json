[{"type": "subtitle", "time": 11825.6, "timestamp": "03:17:05", "text": "おお"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "[音楽]"}, {"type": "subtitle", "time": 11840.15, "timestamp": "03:17:20", "text": "待って、ついに船が見える"}, {"type": "subtitle", "time": 11842.349, "timestamp": "03:17:22", "text": "ただ漂っているだけで、時間がない"}, {"type": "subtitle", "time": 11852.07, "timestamp": "03:17:32", "text": "ヴァンガード、何かがおかしい。船が"}, {"type": "subtitle", "time": 11860.87, "timestamp": "03:17:40", "text": "民間人への攻撃を回避する準備をして船が来る"}, {"type": "subtitle", "time": 11863.99, "timestamp": "03:17:43", "text": "もしあなたが私たちへの射撃をやめれば、私たちは"}, {"type": "subtitle", "time": 11867.75, "timestamp": "03:17:47", "text": "喜んでお答えします"}, {"type": "subtitle", "time": 11870.229, "timestamp": "03:17:50", "text": "いくつか白い線が引かれていたが、"}, {"type": "subtitle", "time": 11872.67, "timestamp": "03:17:52", "text": "ロックダウンされて本当に必要なのは"}, {"type": "subtitle", "time": 11875.03, "timestamp": "03:17:55", "text": "星々からその船を脱出させる手助けをする"}, {"type": "subtitle", "time": 11877.03, "timestamp": "03:17:57", "text": "彼は死んで、私たちの遺物はなくなってしまった。"}]
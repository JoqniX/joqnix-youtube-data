[{"type": "subtitle", "time": 17161.11, "timestamp": "04:46:01", "text": "c"}, {"type": "subtitle", "time": 17168.708, "timestamp": "04:46:08", "text": "3つあって、それから開始キーパッドは"}, {"type": "subtitle", "time": 17171.03, "timestamp": "04:46:11", "text": "完了しました、こんにちは"}, {"type": "subtitle", "time": 17175.83, "timestamp": "04:46:15", "text": "次は大きなボタンです"}, {"type": "subtitle", "time": 17180.27, "timestamp": "04:46:20", "text": "ボタンをクリックするとページが開きます。はい、はい"}, {"type": "subtitle", "time": 17185.628, "timestamp": "04:46:25", "text": "はいはい、それでボタンは赤で、こう書いてあります"}, {"type": "subtitle", "time": 17189.43, "timestamp": "04:46:29", "text": "長押ししてすぐに"}, {"type": "subtitle", "time": 17192.35, "timestamp": "04:46:32", "text": "ボタンを放す"}, {"type": "subtitle", "time": 17196.628, "timestamp": "04:46:36", "text": "赤と言い、そう、だからプレント"}, {"type": "subtitle", "time": 17200.07, "timestamp": "04:46:40", "text": "すぐにボタンを離すとPR"}, {"type": "subtitle", "time": 17203.75, "timestamp": "04:46:43", "text": "今は良い緑色の光を放つ"}, {"type": "subtitle", "time": 17207.47, "timestamp": "04:46:47", "text": "迷路、そう、最後"}, {"type": "subtitle", "time": 17210.948, "timestamp": "04:46:50", "text": "モジュールは、迷路を見つける"}, {"type": "subtitle", "time": 17213.43, "timestamp": "04:46:53", "text": "一致する円形のマーキング、ああ、わかりました、どこ"}, {"type": "subtitle", "time": 17215.39, "timestamp": "04:46:55", "text": "円形"}]
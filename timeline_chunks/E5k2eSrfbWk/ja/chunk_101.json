[{"type": "subtitle", "time": 6062.83, "timestamp": "01:41:02", "text": "私は何をしたの？"}, {"type": "subtitle", "time": 6066.47, "timestamp": "01:41:06", "text": "えっと、私は何をしたの？私は何をしたの？"}, {"type": "subtitle", "time": 6067.75, "timestamp": "01:41:07", "text": "私はあなたに何を与えましたか？私はあなたに何を与えましたか？"}, {"type": "subtitle", "time": 6068.99, "timestamp": "01:41:08", "text": "私は与えましたか"}, {"type": "subtitle", "time": 6071.03, "timestamp": "01:41:11", "text": "あなた"}, {"type": "subtitle", "time": 6074.27, "timestamp": "01:41:14", "text": "弾道はいいよ、君はできるよ"}, {"type": "subtitle", "time": 6077.07, "timestamp": "01:41:17", "text": "えっと"}, {"type": "subtitle", "time": 6086.99, "timestamp": "01:41:26", "text": "何か良いものがあれば、それを手に入れてお金を稼ぎたい"}, {"type": "subtitle", "time": 6088.229, "timestamp": "01:41:28", "text": "外"}, {"type": "subtitle", "time": 6099.109, "timestamp": "01:41:39", "text": "カップには何もない"}, {"type": "subtitle", "time": 6102.629, "timestamp": "01:41:42", "text": "ああ、サンドイッチ、誰かがそれを食べた"}, {"type": "subtitle", "time": 6106.229, "timestamp": "01:41:46", "text": "サンドイッチ、無料で食べられるから大丈夫"}, {"type": "subtitle", "time": 6108.35, "timestamp": "01:41:48", "text": "食べ物、ああ、ここはカフェテリアです"}, {"type": "subtitle", "time": 6111.87, "timestamp": "01:41:51", "text": "これらの食べ物を全部積み重ねるべきだ"}, {"type": "subtitle", "time": 6114.75, "timestamp": "01:41:54", "text": "アイテム ああ"}]
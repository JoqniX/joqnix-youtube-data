[{"type": "subtitle", "time": 12366.07, "timestamp": "03:26:06", "text": "会うとみんながみんな同じように見える"}, {"type": "subtitle", "time": 12367.83, "timestamp": "03:26:07", "text": "毎日、どこからでも歩いて行ける"}, {"type": "subtitle", "time": 12369.83, "timestamp": "03:26:09", "text": "あなたが立ち去る日"}, {"type": "subtitle", "time": 12372.15, "timestamp": "03:26:12", "text": "エクスプローラー星団から"}, {"type": "subtitle", "time": 12375.189, "timestamp": "03:26:15", "text": "話があるんだけど、君たちまだ生きてるの？"}, {"type": "subtitle", "time": 12376.83, "timestamp": "03:26:16", "text": "私は話を聞いたことがあるだけです"}, {"type": "subtitle", "time": 12379.51, "timestamp": "03:26:19", "text": "私たちも、"}, {"type": "subtitle", "time": 12383.03, "timestamp": "03:26:23", "text": "パトロール中に見つけた奇妙な物体"}, {"type": "subtitle", "time": 12385.95, "timestamp": "03:26:25", "text": "だから、私が試したあの物って何だか分かるでしょ？"}, {"type": "subtitle", "time": 12387.59, "timestamp": "03:26:27", "text": "シドニアでそれを売り歩く男と"}, {"type": "subtitle", "time": 12389.59, "timestamp": "03:26:29", "text": "偽物を売っていると思った"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "チタンとは相性が良くない"}, {"type": "subtitle", "time": 12393.91, "timestamp": "03:26:33", "text": "スキャナーは誰かにとって無価値だろう"}, {"type": "subtitle", "time": 12395.87, "timestamp": "03:26:35", "text": "レアミネラルを転売しようとしている"}, {"type": "subtitle", "time": 12398.269, "timestamp": "03:26:38", "text": "つまり、私はそうすべきではないということですか？"}, {"type": "subtitle", "time": 12401.03, "timestamp": "03:26:41", "text": "フードとして使用する"}, {"type": "subtitle", "time": 12404.309, "timestamp": "03:26:44", "text": "装飾品、えっと、ちょっと変わったものと交換しよう"}, {"type": "subtitle", "time": 12406.83, "timestamp": "03:26:46", "text": "いつでも救助に駆けつけるスペースロック"}, {"type": "subtitle", "time": 12408.389, "timestamp": "03:26:48", "text": "あなたがその問題を解決できることを願っています"}]
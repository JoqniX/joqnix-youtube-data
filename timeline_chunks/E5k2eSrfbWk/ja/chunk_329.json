[{"type": "subtitle", "time": 19741.43, "timestamp": "05:29:01", "text": "きっと解決できるよ"}, {"type": "subtitle", "time": 19743.07, "timestamp": "05:29:03", "text": "はい"}, {"type": "subtitle", "time": 19746.708, "timestamp": "05:29:06", "text": "うん、でもうん、すごく楽しいよ。"}, {"type": "subtitle", "time": 19750.27, "timestamp": "05:29:10", "text": "楽しい冒険爆弾爆弾えー分隊"}, {"type": "subtitle", "time": 19752.19, "timestamp": "05:29:12", "text": "冒険を一緒に"}, {"type": "subtitle", "time": 19756.11, "timestamp": "05:29:16", "text": "彼は私を爆破して楽しんでいる はい いいえ"}, {"type": "subtitle", "time": 19765.11, "timestamp": "05:29:25", "text": "[音楽]"}, {"type": "subtitle", "time": 19767.35, "timestamp": "05:29:27", "text": "いいえ"}, {"type": "subtitle", "time": 19771.27, "timestamp": "05:29:31", "text": "ええ、チャンネル登録をお忘れなく"}, {"type": "subtitle", "time": 19775.03, "timestamp": "05:29:35", "text": "私たち二人とも一秒で"}, {"type": "subtitle", "time": 19778.948, "timestamp": "05:29:38", "text": "うん、君がそうしたいならね"}, {"type": "subtitle", "time": 19781.15, "timestamp": "05:29:41", "text": "それで"}, {"type": "subtitle", "time": 19785.19, "timestamp": "05:29:45", "text": "うん、じゃあCHのままでいいよ、終わりにしよう"}, {"type": "subtitle", "time": 19787.628, "timestamp": "05:29:47", "text": "私は終わります、私はOB VCも続けるつもりです"}, {"type": "subtitle", "time": 19799.39, "timestamp": "05:29:59", "text": "そうだと思う"}]
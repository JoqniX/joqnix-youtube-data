[{"type": "subtitle", "time": 60.349, "timestamp": "00:01:00", "text": "いろいろあって、まずは休憩が必要だ"}, {"type": "subtitle", "time": 61.349, "timestamp": "00:01:01", "text": "そしてそれは"}, {"type": "subtitle", "time": 62.99, "timestamp": "00:01:02", "text": "9"}, {"type": "subtitle", "time": 68.83, "timestamp": "00:01:08", "text": "午前中だから、いろいろあるよね、たくさん"}, {"type": "subtitle", "time": 70.83, "timestamp": "00:01:10", "text": "もの"}, {"type": "subtitle", "time": 74.35, "timestamp": "00:01:14", "text": "とにかく、私たちは警備するでしょう、私は行くでしょう"}, {"type": "subtitle", "time": 77.95, "timestamp": "00:01:17", "text": "ワード、今日私たちがすることは、"}, {"type": "subtitle", "time": 80.429, "timestamp": "00:01:20", "text": "警告をします、私たちは"}, {"type": "subtitle", "time": 83.149, "timestamp": "00:01:23", "text": "音楽とかゲームとか"}, {"type": "subtitle", "time": 86.59, "timestamp": "00:01:26", "text": "他のことをするよ、時間ベースでやるよ"}, {"type": "subtitle", "time": 89.55, "timestamp": "00:01:29", "text": "自動化関連のものも心配いりません"}, {"type": "subtitle", "time": 91.35, "timestamp": "00:01:31", "text": "これから見ていくと、これらが３つの目標です"}, {"type": "subtitle", "time": 94.99000000000001, "timestamp": "00:01:34", "text": "今日はそれをやります"}, {"type": "subtitle", "time": 98.41, "timestamp": "00:01:38", "text": "よし、みんな、僕と一緒にそこにいてくれ"}, {"type": "subtitle", "time": 105.35, "timestamp": "00:01:45", "text": "ここに、ああ、"}, {"type": "subtitle", "time": 108.03, "timestamp": "00:01:48", "text": "リンクを取得して確認させてください"}]
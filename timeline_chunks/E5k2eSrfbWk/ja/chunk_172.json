[{"type": "subtitle", "time": 10321.03, "timestamp": "02:52:01", "text": "いいえ、私はTwitchを休止しています"}, {"type": "subtitle", "time": 10323.67, "timestamp": "02:52:03", "text": "実際に私がいるすべての場所でストリーミングしています"}, {"type": "subtitle", "time": 10327.83, "timestamp": "02:52:07", "text": "退屈で仕方がない"}, {"type": "subtitle", "time": 10330.229, "timestamp": "02:52:10", "text": "最近Twitchで配信したいのですが"}, {"type": "subtitle", "time": 10332.83, "timestamp": "02:52:12", "text": "本当にそう思います"}, {"type": "subtitle", "time": 10341.11, "timestamp": "02:52:21", "text": "私は自分を追い込みすぎて"}, {"type": "subtitle", "time": 10344.469, "timestamp": "02:52:24", "text": "最後の３つと同じように"}, {"type": "subtitle", "time": 10347.469, "timestamp": "02:52:27", "text": "数週間経つと状況は悪化している"}, {"type": "subtitle", "time": 10348.19, "timestamp": "02:52:28", "text": "私の"}, {"type": "subtitle", "time": 10356.55, "timestamp": "02:52:36", "text": "ええ、説明していただけますか？"}, {"type": "subtitle", "time": 10366.83, "timestamp": "02:52:46", "text": "ビー、これは宇宙ゲームだから、君も"}, {"type": "subtitle", "time": 10369.67, "timestamp": "02:52:49", "text": "惑星を探検すると、約800個あります"}, {"type": "subtitle", "time": 10371.309, "timestamp": "02:52:51", "text": "違う"}, {"type": "subtitle", "time": 10374.99, "timestamp": "02:52:54", "text": "800を超える惑星または"}, {"type": "subtitle", "time": 10377.309, "timestamp": "02:52:57", "text": "惑星を探検する"}]
[{"type": "subtitle", "time": 17762.67, "timestamp": "04:56:02", "text": "これは、黄色いBの1つ、ボンの2つです"}, {"type": "subtitle", "time": 17764.788, "timestamp": "04:56:04", "text": "青、そしてBが1つ"}, {"type": "subtitle", "time": 17769.788, "timestamp": "04:56:09", "text": "緑緑よし、赤黄色黄色よ"}, {"type": "subtitle", "time": 17771.11, "timestamp": "04:56:11", "text": "緑"}, {"type": "subtitle", "time": 17775.35, "timestamp": "04:56:15", "text": "赤 黄 黄 緑 完了しました"}, {"type": "subtitle", "time": 17779.27, "timestamp": "04:56:19", "text": "最後のモジュールの文言は"}, {"type": "subtitle", "time": 17782.11, "timestamp": "04:56:22", "text": "1分15秒あります。"}, {"type": "subtitle", "time": 17784.868, "timestamp": "04:56:24", "text": "トップレベル、トップワードは何？トップ"}, {"type": "subtitle", "time": 17786.23, "timestamp": "04:56:26", "text": "言葉"}, {"type": "subtitle", "time": 17792.39, "timestamp": "04:56:32", "text": "u u のスペルではなく、u の文字だけです"}, {"type": "subtitle", "time": 17796.83, "timestamp": "04:56:36", "text": "文字だけ、そう、それから"}, {"type": "subtitle", "time": 17798.39, "timestamp": "04:56:38", "text": "2つ目は"}, {"type": "subtitle", "time": 17801.27, "timestamp": "04:56:41", "text": "まるで私たちが手に入れたように"}, {"type": "subtitle", "time": 17807.83, "timestamp": "04:56:47", "text": "君はなぜ君は君を抱きしめているのか、そうだ"}, {"type": "subtitle", "time": 17809.83, "timestamp": "04:56:49", "text": "待って待って待ってトップラベルは何？"}, {"type": "subtitle", "time": 17812.19, "timestamp": "04:56:52", "text": "また、一番上のものと同じようにH"}, {"type": "subtitle", "time": 17815.75, "timestamp": "04:56:55", "text": "トップはラベルです。"}, {"type": "subtitle", "time": 17817.788, "timestamp": "04:56:57", "text": "ボタンラベル u"}]
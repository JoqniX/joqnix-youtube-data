[{"type": "subtitle", "time": 18061.708, "timestamp": "05:01:01", "text": "何か新しいこと、あなたは天国で幸せですか？"}, {"type": "subtitle", "time": 18064.628, "timestamp": "05:01:04", "text": "え、何？私は違う"}, {"type": "subtitle", "time": 18071.51, "timestamp": "05:01:11", "text": "爆弾が死んだ。こんにちは、暗いです。"}, {"type": "subtitle", "time": 18075.788, "timestamp": "05:01:15", "text": "伝説のボムアは何も見えない"}, {"type": "subtitle", "time": 18080.23, "timestamp": "05:01:20", "text": "ああ、キーパッドがあるからできるよ"}, {"type": "subtitle", "time": 18082.708, "timestamp": "05:01:22", "text": "シンボルがあると、"}, {"type": "subtitle", "time": 18087.19, "timestamp": "05:01:27", "text": "ワイヤーがあって、それから迷路がある"}, {"type": "subtitle", "time": 18097.07, "timestamp": "05:01:37", "text": "迷路、えっと、簡単なものからやってみよう。キーパッド"}, {"type": "subtitle", "time": 18100.19, "timestamp": "05:01:40", "text": "うん、そうだね"}, {"type": "subtitle", "time": 18104.31, "timestamp": "05:01:44", "text": "えーと、そこにスマイリーフェイスがあって"}, {"type": "subtitle", "time": 18107.67, "timestamp": "05:01:47", "text": "舌を突き出す"}, {"type": "subtitle", "time": 18111.15, "timestamp": "05:01:51", "text": "じゃあ、b に t のようなものが入っています"}, {"type": "subtitle", "time": 18112.628, "timestamp": "05:01:52", "text": "行く"}, {"type": "subtitle", "time": 18115.67, "timestamp": "05:01:55", "text": "その前に、点のある通常の C があります。"}, {"type": "subtitle", "time": 18117.67, "timestamp": "05:01:57", "text": "真ん中のうーん"}]
[{"type": "subtitle", "time": 5461.43, "timestamp": "01:31:01", "text": "それができるなら、私はただ行くだけ"}, {"type": "subtitle", "time": 5463.79, "timestamp": "01:31:03", "text": "今は閉まっているsh"}, {"type": "subtitle", "time": 5465.87, "timestamp": "01:31:05", "text": "私は彼らに、これは誰それだと伝えます"}, {"type": "subtitle", "time": 5468.99, "timestamp": "01:31:08", "text": "その問題について何か対策を講じましたか？"}, {"type": "subtitle", "time": 5479.39, "timestamp": "01:31:19", "text": "何か すべての船 私は向かっています"}, {"type": "subtitle", "time": 5482.07, "timestamp": "01:31:22", "text": "ノヴァ・ギャラクティックの物語 スムーズからオルティング"}, {"type": "subtitle", "time": 5483.669, "timestamp": "01:31:23", "text": "うんうん、この場所全体が"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "手数料"}, {"type": "subtitle", "time": 5486.669, "timestamp": "01:31:26", "text": "緊急修理用の部品が必要です"}, {"type": "subtitle", "time": 5489.43, "timestamp": "01:31:29", "text": "銀河系に行くといいな、それは"}, {"type": "subtitle", "time": 5492.31, "timestamp": "01:31:32", "text": "地球とその周りのすべては"}, {"type": "subtitle", "time": 5495.35, "timestamp": "01:31:35", "text": "放棄された銀河と古い"}]
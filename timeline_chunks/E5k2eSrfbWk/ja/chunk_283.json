[{"type": "subtitle", "time": 16980.03, "timestamp": "04:43:00", "text": "今回は爆破しないようにするから"}, {"type": "subtitle", "time": 16989.15, "timestamp": "04:43:09", "text": "はい、次は私が話します。はい、こんにちは。ああ、待って、いいえ"}, {"type": "subtitle", "time": 16992.91, "timestamp": "04:43:12", "text": "ああ、こんにちは、ご覧になりましたか？"}, {"type": "subtitle", "time": 17004.39, "timestamp": "04:43:24", "text": "いいえ、私のブラはイエス・セント・インと言っている"}, {"type": "subtitle", "time": 17007.99, "timestamp": "04:43:27", "text": "[音楽]"}, {"type": "subtitle", "time": 17014.11, "timestamp": "04:43:34", "text": "じゃあ、起きたら教えてね。"}]
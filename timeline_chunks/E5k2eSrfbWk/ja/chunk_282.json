[{"type": "subtitle", "time": 16923.708, "timestamp": "04:42:03", "text": "君は今夜死んだ、私は一度死んだことがある"}, {"type": "subtitle", "time": 16926.43, "timestamp": "04:42:06", "text": "一度、そしてあなたはどうですか？私は"}, {"type": "subtitle", "time": 16929.31, "timestamp": "04:42:09", "text": "君が何回死んだか覚えてる？そうだよ"}, {"type": "subtitle", "time": 16933.708, "timestamp": "04:42:13", "text": "一度死んだら、3つ使った"}, {"type": "subtitle", "time": 16936.99, "timestamp": "04:42:16", "text": "3回、そう、私が"}, {"type": "subtitle", "time": 16947.51, "timestamp": "04:42:27", "text": "ええ、ちょっと待ってください、通常は"}, {"type": "subtitle", "time": 16950.75, "timestamp": "04:42:30", "text": "通常、マニュアルを読むと"}, {"type": "subtitle", "time": 16953.788, "timestamp": "04:42:33", "text": "オフィスか何かと爆弾"}, {"type": "subtitle", "time": 16956.55, "timestamp": "04:42:36", "text": "ディフューザーは、"}, {"type": "subtitle", "time": 16959.51, "timestamp": "04:42:39", "text": "それはあなたが言うところの"}, {"type": "subtitle", "time": 16962.708, "timestamp": "04:42:42", "text": "そう、あの場所だけど、でも、でも私たちは"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "オンラインで話しているが、私たちはオンラインで話している"}, {"type": "subtitle", "time": 16967.948, "timestamp": "04:42:47", "text": "しかしそれは、私たちが"}, {"type": "subtitle", "time": 16969.788, "timestamp": "04:42:49", "text": "お互い"}]
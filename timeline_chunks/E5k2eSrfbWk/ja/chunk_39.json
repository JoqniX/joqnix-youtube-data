[{"type": "subtitle", "time": 2348.99, "timestamp": "00:39:08", "text": "速い、ああ、この酸素みたいなものは"}, {"type": "subtitle", "time": 2384.19, "timestamp": "00:39:44", "text": "いいえ、なぜそうなるのですか"}, {"type": "subtitle", "time": 2387.349, "timestamp": "00:39:47", "text": "私はこれを終えるのにあと少しです"}, {"type": "subtitle", "time": 2389.39, "timestamp": "00:39:49", "text": "一度押しつぶして、決して触れない"}]
[{"type": "subtitle", "time": 3661.47, "timestamp": "01:01:01", "text": "えっと、どうやって家に帰るんですか？こんにちは"}, {"type": "subtitle", "time": 3663.47, "timestamp": "01:01:03", "text": "彼らは怖がっている"}, {"type": "subtitle", "time": 3671.029, "timestamp": "01:01:11", "text": "バイバイ"}, {"type": "subtitle", "time": 3675.029, "timestamp": "01:01:15", "text": "えっと、私を連れ出すつもりはない"}, {"type": "subtitle", "time": 3677.67, "timestamp": "01:01:17", "text": "また私を連れ出したくない"}, {"type": "subtitle", "time": 3698.15, "timestamp": "01:01:38", "text": "ラン"}]
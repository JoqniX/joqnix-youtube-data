[{"type": "subtitle", "time": 7081.47, "timestamp": "01:58:01", "text": "悪いけど、うん、たぶんまた今度試すよ"}, {"type": "subtitle", "time": 7083.95, "timestamp": "01:58:03", "text": "私の不用品を全部引き取ってください、本当にありがとうございます。"}, {"type": "subtitle", "time": 7103.39, "timestamp": "01:58:23", "text": "神様、なぜ彼らはこんなにたくさんの食事をするのですか"}, {"type": "subtitle", "time": 7106.47, "timestamp": "01:58:26", "text": "宇宙人はそれをスクランブルエッグと呼ぶ"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "エイリアンスクランブルまたは"}, {"type": "subtitle", "time": 7111.35, "timestamp": "01:58:31", "text": "何かが噛まれている"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "サンドイッチ 誰かがそのサンドイッチを食べました"}, {"type": "subtitle", "time": 7128.51, "timestamp": "01:58:48", "text": "方法"}]
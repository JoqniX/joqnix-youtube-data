[{"type": "subtitle", "time": 5723.03, "timestamp": "01:35:23", "text": "ギャラクティック、ああこの男、ああノヴァギャラクティック"}, {"type": "subtitle", "time": 5724.39, "timestamp": "01:35:24", "text": "星空の庭"}, {"type": "subtitle", "time": 5727.229, "timestamp": "01:35:27", "text": "地球の周回軌道をまだ周回している"}, {"type": "subtitle", "time": 5729.07, "timestamp": "01:35:29", "text": "月、ここは最初の"}, {"type": "subtitle", "time": 5730.51, "timestamp": "01:35:30", "text": "インターステラー"}, {"type": "subtitle", "time": 5734.149, "timestamp": "01:35:34", "text": "船乗りたちは今でもモジュールを使っている"}, {"type": "subtitle", "time": 5735.669, "timestamp": "01:35:35", "text": "彼らの星空の庭は"}, {"type": "subtitle", "time": 5740.87, "timestamp": "01:35:40", "text": "永遠に"}, {"type": "subtitle", "time": 5743.47, "timestamp": "01:35:43", "text": "えっと、なぜ私たちは"}, {"type": "subtitle", "time": 5745.709, "timestamp": "01:35:45", "text": "もう過去の話だから放っておこう"}, {"type": "subtitle", "time": 5748.95, "timestamp": "01:35:48", "text": "このスペースでスタートが失われた"}, {"type": "subtitle", "time": 5751.149, "timestamp": "01:35:51", "text": "だから地球は"}, {"type": "subtitle", "time": 5757.229, "timestamp": "01:35:57", "text": "別の場所へ行った"}, {"type": "subtitle", "time": 5759.91, "timestamp": "01:35:59", "text": "別の政府があなたたちを始めました"}]
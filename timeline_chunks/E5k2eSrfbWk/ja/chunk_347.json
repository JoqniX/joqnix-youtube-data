[{"type": "subtitle", "time": 20822.99, "timestamp": "05:47:02", "text": "実際、昔は"}, {"type": "subtitle", "time": 20825.708, "timestamp": "05:47:05", "text": "Twitchで配信をしていた"}, {"type": "subtitle", "time": 20829.83, "timestamp": "05:47:09", "text": "ズキ、あぁ、私たちは二人で一緒に遊んだ"}, {"type": "subtitle", "time": 20835.548, "timestamp": "05:47:15", "text": "始めない、彼女が私に始めさせた、えっと、あなたを始めさせた"}, {"type": "subtitle", "time": 20839.27, "timestamp": "05:47:19", "text": "ええ、こんにちは、ノルン、お元気ですか？"}, {"type": "subtitle", "time": 20841.548, "timestamp": "05:47:21", "text": "お元気ですか？お元気でいらっしゃることを願っています。"}, {"type": "subtitle", "time": 20844.51, "timestamp": "05:47:24", "text": "待って待って待って待って待って、ちょっと待って、"}, {"type": "subtitle", "time": 20848.35, "timestamp": "05:47:28", "text": "間違った、間違った、間違ったスタートを切っています"}, {"type": "subtitle", "time": 20850.708, "timestamp": "05:47:30", "text": "えっと、また手順ですね、ああ神様、私は"}, {"type": "subtitle", "time": 20854.03, "timestamp": "05:47:34", "text": "話すことになっていたことを忘れて"}, {"type": "subtitle", "time": 20856.23, "timestamp": "05:47:36", "text": "チャットやいいねを歓迎します。"}, {"type": "subtitle", "time": 20858.51, "timestamp": "05:47:38", "text": "何かをしたり、その日の出来事を話したりするのが好きです。"}, {"type": "subtitle", "time": 20862.31, "timestamp": "05:47:42", "text": "すべて30分か1時間かけて、それから"}, {"type": "subtitle", "time": 20865.15, "timestamp": "05:47:45", "text": "コンテンツやゲームに直行する"}, {"type": "subtitle", "time": 20866.11, "timestamp": "05:47:46", "text": "保つ"}, {"type": "subtitle", "time": 20870.15, "timestamp": "05:47:50", "text": "忘れてたから、うん、えっと、私は"}, {"type": "subtitle", "time": 20874.19, "timestamp": "05:47:54", "text": "投稿するのを忘れていたので少し遅れてしまいました"}, {"type": "subtitle", "time": 20879.23, "timestamp": "05:47:59", "text": "ストリームルーム、そして、ええ"}]
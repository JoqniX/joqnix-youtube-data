[{"type": "subtitle", "time": 2883.99, "timestamp": "00:48:03", "text": "私は戻りたい"}, {"type": "subtitle", "time": 2898.03, "timestamp": "00:48:18", "text": "よし、キャプテン、ここはどこだ？"}, {"type": "subtitle", "time": 2898.76, "timestamp": "00:48:18", "text": "ヘッド"}, {"type": "subtitle", "time": 2900.549, "timestamp": "00:48:20", "text": "[音楽]"}, {"type": "subtitle", "time": 2903.589, "timestamp": "00:48:23", "text": "次は、いや、実際にはそうではない、私たちは"}, {"type": "subtitle", "time": 2911.71, "timestamp": "00:48:31", "text": "ああ、小さいのを手に入れるまでは行かないよ"}, {"type": "subtitle", "time": 2914.27, "timestamp": "00:48:34", "text": "小さな生き物と終わり"}, {"type": "subtitle", "time": 2925.47, "timestamp": "00:48:45", "text": "よかった、私はこれだから"}, {"type": "subtitle", "time": 2928.349, "timestamp": "00:48:48", "text": "近い、わかった、わかった、わかった、1つ見える"}, {"type": "subtitle", "time": 2931.47, "timestamp": "00:48:51", "text": "ついに一つ見えた"}, {"type": "subtitle", "time": 2933.99, "timestamp": "00:48:53", "text": "お姉さん"}, {"type": "subtitle", "time": 2936.99, "timestamp": "00:48:56", "text": "このビート"}, {"type": "subtitle", "time": 2938.87, "timestamp": "00:48:58", "text": "は"}]
[{"type": "subtitle", "time": 840.99, "timestamp": "00:14:00", "text": "私は"}, {"type": "subtitle", "time": 846.47, "timestamp": "00:14:06", "text": "それはあなたの肌をレベルアップさせます。"}, {"type": "subtitle", "time": 848.829, "timestamp": "00:14:08", "text": "ゲームがたくさんある"}, {"type": "subtitle", "time": 851.269, "timestamp": "00:14:11", "text": "わかった、必要なことは理解した"}, {"type": "subtitle", "time": 856.47, "timestamp": "00:14:16", "text": "ここでやると、エイリアンエイリアンがいる"}, {"type": "subtitle", "time": 860.23, "timestamp": "00:14:20", "text": "えーと、私が必要とするもの"}, {"type": "subtitle", "time": 866.03, "timestamp": "00:14:26", "text": "スキャンすると、何かが"}, {"type": "subtitle", "time": 890.269, "timestamp": "00:14:50", "text": "それで"}, {"type": "subtitle", "time": 895.269, "timestamp": "00:14:55", "text": "えー、何をしたの？ああ神様、何をしたの？"}, {"type": "subtitle", "time": 899.67, "timestamp": "00:14:59", "text": "スパムする スパムする 隠すことができる"}]
[{"type": "subtitle", "time": 19323.548, "timestamp": "05:22:03", "text": "ミュート歓迎、うん"}, {"type": "subtitle", "time": 19328.628, "timestamp": "05:22:08", "text": "こんにちは、こんにちは、こんにちは、元気ですか、H息子さん"}, {"type": "subtitle", "time": 19329.788, "timestamp": "05:22:09", "text": "ようこそ"}, {"type": "subtitle", "time": 19343.19, "timestamp": "05:22:23", "text": "戻って、なぜあなたは"}, {"type": "subtitle", "time": 19346.11, "timestamp": "05:22:26", "text": "歩いていると、みんなにオーラルセックスをしてあげるよ PS みたいに"}, {"type": "subtitle", "time": 19348.47, "timestamp": "05:22:28", "text": "これ"}, {"type": "subtitle", "time": 19352.35, "timestamp": "05:22:32", "text": "それでは、お母さんの頭にPSをそれぞれ"}, {"type": "subtitle", "time": 19355.11, "timestamp": "05:22:35", "text": "そしてチャットに参加してくれた皆さんも"}, {"type": "subtitle", "time": 19357.75, "timestamp": "05:22:37", "text": "そしてチャンスCはみんなに残る"}, {"type": "subtitle", "time": 19361.35, "timestamp": "05:22:41", "text": "全員がヘッドPを獲得し、誰も獲得しません。"}, {"type": "subtitle", "time": 19363.708, "timestamp": "05:22:43", "text": "みんなが来るたびに"}, {"type": "subtitle", "time": 19376.75, "timestamp": "05:22:56", "text": "こんにちは、それではセントを待っている間に"}]
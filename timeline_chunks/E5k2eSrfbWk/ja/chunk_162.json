[{"type": "subtitle", "time": 9724.71, "timestamp": "02:42:04", "text": "いいえ、最初に聞いたのですが、"}, {"type": "subtitle", "time": 9735.75, "timestamp": "02:42:15", "text": "損失、ああ、もしもう一度話せるなら"}, {"type": "subtitle", "time": 9737.349, "timestamp": "02:42:17", "text": "採用しているんですね、本当に助かります"}, {"type": "subtitle", "time": 9740.269, "timestamp": "02:42:20", "text": "仕事"}, {"type": "subtitle", "time": 9743.349, "timestamp": "02:42:23", "text": "私はそれ以上興味はありません"}, {"type": "subtitle", "time": 9747.67, "timestamp": "02:42:27", "text": "素晴らしい、ありがとう、あなたはどこにいますか"}, {"type": "subtitle", "time": 9749.269, "timestamp": "02:42:29", "text": "送信中"}, {"type": "subtitle", "time": 9752.87, "timestamp": "02:42:32", "text": "volun を変更する"}, {"type": "subtitle", "time": 9761.63, "timestamp": "02:42:41", "text": "5月、着陸した"}, {"type": "subtitle", "time": 9764.63, "timestamp": "02:42:44", "text": "船がそこに到着する"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "もうすぐ、わかった、クルーを雇う"}, {"type": "subtitle", "time": 9777.99, "timestamp": "02:42:57", "text": "また会えて嬉しいよ、君を呼んでくれないか"}]
[{"type": "subtitle", "time": 6182.39, "timestamp": "01:43:02", "text": "走って行って楽しんでください"}, {"type": "subtitle", "time": 6185.27, "timestamp": "01:43:05", "text": "V 私は"}, {"type": "subtitle", "time": 6192.669, "timestamp": "01:43:12", "text": "でも、そもそもロードされるの？"}, {"type": "subtitle", "time": 6195.31, "timestamp": "01:43:15", "text": "読み込まれているはずなのに、なぜなのかわからない"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "時間がかかりすぎている"}, {"type": "subtitle", "time": 6202.109, "timestamp": "01:43:22", "text": "ロード、もう1つ撮ろう"}, {"type": "subtitle", "time": 6205.35, "timestamp": "01:43:25", "text": "ほら、これがヴァレラント・ワードだよ"}, {"type": "subtitle", "time": 6207.83, "timestamp": "01:43:27", "text": "私はこれを楽しみます、戻ってきます、わかりました。"}, {"type": "subtitle", "time": 6210.83, "timestamp": "01:43:30", "text": "戻ってきますよ、その方がいいと思います。"}, {"type": "subtitle", "time": 6214.99, "timestamp": "01:43:34", "text": "15分なら、そっちの方が速いと思う。"}, {"type": "subtitle", "time": 6222.79, "timestamp": "01:43:42", "text": "最後に評価した1つは大丈夫でした。"}, {"type": "subtitle", "time": 6228.03, "timestamp": "01:43:48", "text": "包む 私は一日を包む"}, {"type": "subtitle", "time": 6231.47, "timestamp": "01:43:51", "text": "ああ、最後にもう1つ。"}]
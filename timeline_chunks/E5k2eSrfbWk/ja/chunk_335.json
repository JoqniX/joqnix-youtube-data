[{"type": "subtitle", "time": 20101.23, "timestamp": "05:35:01", "text": "およびお知らせ"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "これから数日後に起こること"}, {"type": "subtitle", "time": 20109.05, "timestamp": "05:35:09", "text": "日曜日、こんにちは。そして、ストリーム視聴もお願いします。"}, {"type": "subtitle", "time": 20114.47, "timestamp": "05:35:14", "text": "一緒に見守る"}, {"type": "subtitle", "time": 20118.07, "timestamp": "05:35:18", "text": "それで、これをやろうと思ってるんだけど"}, {"type": "subtitle", "time": 20119.868, "timestamp": "05:35:19", "text": "イベント"}, {"type": "subtitle", "time": 20123.07, "timestamp": "05:35:23", "text": "えっと、なんて言うんだっけ、２つみたいな"}, {"type": "subtitle", "time": 20125.99, "timestamp": "05:35:25", "text": "たった2、3時間だけなら、私はそれを望んでいません"}, {"type": "subtitle", "time": 20129.11, "timestamp": "05:35:29", "text": "あまりにも多すぎるので、"}, {"type": "subtitle", "time": 20132.83, "timestamp": "05:35:32", "text": "いくつかゲームをプレイしています。もし誰か"}, {"type": "subtitle", "time": 20135.99, "timestamp": "05:35:35", "text": "そこに居続けると、えっと、わかるでしょ"}, {"type": "subtitle", "time": 20139.11, "timestamp": "05:35:39", "text": "えっと、一緒に観たりします"}, {"type": "subtitle", "time": 20142.15, "timestamp": "05:35:42", "text": "映画、ああ、そうか、なぜダメなのかと思ったんだ"}, {"type": "subtitle", "time": 20145.788, "timestamp": "05:35:45", "text": "鬼滅の刃の映画のようにストリーミングします"}, {"type": "subtitle", "time": 20148.91, "timestamp": "05:35:48", "text": "ちゃんと見てないから、なんで"}, {"type": "subtitle", "time": 20151.03, "timestamp": "05:35:51", "text": "鬼滅の刃の映画は見ない"}, {"type": "subtitle", "time": 20155.07, "timestamp": "05:35:55", "text": "それらすべてを始める前に"}, {"type": "subtitle", "time": 20158.39, "timestamp": "05:35:58", "text": "イベント あなたたちみんなが 私たちみんな"}]
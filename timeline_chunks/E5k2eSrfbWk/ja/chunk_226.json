[{"type": "subtitle", "time": 13561.11, "timestamp": "03:46:01", "text": "いいえ、それは私のああ"}, {"type": "subtitle", "time": 13564.67, "timestamp": "03:46:04", "text": "神よ、主よ"}, {"type": "subtitle", "time": 13567.63, "timestamp": "03:46:07", "text": "私、うん"}, {"type": "subtitle", "time": 13571.67, "timestamp": "03:46:11", "text": "Bまでに寝る時間だよ"}, {"type": "subtitle", "time": 13574.309, "timestamp": "03:46:14", "text": "ええ、通常は"}, {"type": "subtitle", "time": 13582.95, "timestamp": "03:46:22", "text": "そうですね、それで私はどこにいたのですか、それから"}, {"type": "subtitle", "time": 13590.67, "timestamp": "03:46:30", "text": "やった、そしてこれは私が脅迫と呼ぶものだ"}, {"type": "subtitle", "time": 13592.51, "timestamp": "03:46:32", "text": "休んで"}, {"type": "subtitle", "time": 13613.309, "timestamp": "03:46:53", "text": "Twitchでの配信が恋しかったよ"}, {"type": "subtitle", "time": 13615.55, "timestamp": "03:46:55", "text": "Twitchで配信するために、また私は"}, {"type": "subtitle", "time": 13618.67, "timestamp": "03:46:58", "text": "私も物触ってるよ、神様、私は触ってないよ"}]
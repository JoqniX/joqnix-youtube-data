[{"type": "subtitle", "time": 17101.55, "timestamp": "04:45:01", "text": "ラベル付けされるべき新しいモジュール"}, {"type": "subtitle", "time": 17104.59, "timestamp": "04:45:04", "text": "マニュアルに迷路みたいなのが書いてある"}, {"type": "subtitle", "time": 17109.67, "timestamp": "04:45:09", "text": "迷路、迷路、迷路、あぁ、わかった、わかった"}, {"type": "subtitle", "time": 17112.91, "timestamp": "04:45:12", "text": "迷路よし、まずは記号から始めよう"}, {"type": "subtitle", "time": 17115.75, "timestamp": "04:45:15", "text": "伝統に従って通常通り"}, {"type": "subtitle", "time": 17119.43, "timestamp": "04:45:19", "text": "はい、ずっとシンボルを使ってきました"}, {"type": "subtitle", "time": 17123.91, "timestamp": "04:45:23", "text": "まず、大文字のCと"}, {"type": "subtitle", "time": 17126.31, "timestamp": "04:45:26", "text": "真ん中のドットは普通のSEではない"}, {"type": "subtitle", "time": 17130.39, "timestamp": "04:45:30", "text": "ひっくり返したよ、わかった、普通のCだよ"}, {"type": "subtitle", "time": 17135.35, "timestamp": "04:45:35", "text": "M、それから、先ほどのおしゃれな3があります"}, {"type": "subtitle", "time": 17141.07, "timestamp": "04:45:41", "text": "はい、それからトライデントと、はい、それから"}, {"type": "subtitle", "time": 17143.59, "timestamp": "04:45:43", "text": "5つのポイントがある"}, {"type": "subtitle", "time": 17149.55, "timestamp": "04:45:49", "text": "右に星を付けるには、まずトライデントをクリックしてください"}, {"type": "subtitle", "time": 17154.51, "timestamp": "04:45:54", "text": "トレント、えっと、待って、待って、ない"}, {"type": "subtitle", "time": 17158.19, "timestamp": "04:45:58", "text": "スマイリー右、SMオーケークリック"}, {"type": "subtitle", "time": 17159.35, "timestamp": "04:45:59", "text": "で"}]
[{"type": "subtitle", "time": 21426.39, "timestamp": "05:57:06", "text": "やったー、これはアップだ"}, {"type": "subtitle", "time": 21427.91, "timestamp": "05:57:07", "text": "これは上です"}, {"type": "subtitle", "time": 21430.628, "timestamp": "05:57:10", "text": "珍しい。中身が何なのかわからない。"}, {"type": "subtitle", "time": 21433.07, "timestamp": "05:57:13", "text": "それは"}, {"type": "subtitle", "time": 21436.07, "timestamp": "05:57:16", "text": "ビスケット、そしてこれは"}, {"type": "subtitle", "time": 21438.03, "timestamp": "05:57:18", "text": "その"}, {"type": "subtitle", "time": 21441.23, "timestamp": "05:57:21", "text": "鉛筆、つまりペンを買わなければならなかったんです"}, {"type": "subtitle", "time": 21444.99, "timestamp": "05:57:24", "text": "布のようなCLE 6種類の鉛筆HB"}, {"type": "subtitle", "time": 21448.868, "timestamp": "05:57:28", "text": "2B 4B 6B 8B"}, {"type": "subtitle", "time": 21453.51, "timestamp": "05:57:33", "text": "10B ええ、日本語の試験のために"}, {"type": "subtitle", "time": 21457.91, "timestamp": "05:57:37", "text": "Pによる2Bが必要です"}, {"type": "subtitle", "time": 21459.67, "timestamp": "05:57:39", "text": "鉛筆で書かないといけないよ"}, {"type": "subtitle", "time": 21461.59, "timestamp": "05:57:41", "text": "ペン"}, {"type": "subtitle", "time": 21470.628, "timestamp": "05:57:50", "text": "量を変更しました"}, {"type": "subtitle", "time": 21479.39, "timestamp": "05:57:59", "text": "信じられない、私が買った色鉛筆は"}]
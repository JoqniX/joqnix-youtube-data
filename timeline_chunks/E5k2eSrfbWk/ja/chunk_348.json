[{"type": "subtitle", "time": 20883.59, "timestamp": "05:48:03", "text": "私、そうそう、パンはどう？太陽は元気？"}, {"type": "subtitle", "time": 20887.43, "timestamp": "05:48:07", "text": "今日は、私がいくつか質問しようと思っています"}, {"type": "subtitle", "time": 20891.07, "timestamp": "05:48:11", "text": "ジョークの反応はどうですか？返信します"}, {"type": "subtitle", "time": 20893.548, "timestamp": "05:48:13", "text": "バカジョッキーは元気です。私は起きました"}, {"type": "subtitle", "time": 20898.39, "timestamp": "05:48:18", "text": "午前2時、午後2時など午前2時ではありません。"}, {"type": "subtitle", "time": 20900.39, "timestamp": "05:48:20", "text": "昨日の配信の後、私は"}, {"type": "subtitle", "time": 20903.19, "timestamp": "05:48:23", "text": "少し休憩してから"}, {"type": "subtitle", "time": 20906.59, "timestamp": "05:48:26", "text": "Minecraftをzukiさんのサーバーでプレイしていました"}, {"type": "subtitle", "time": 20910.51, "timestamp": "05:48:30", "text": "ザックのアパートメンツのMinecraftサーバー"}, {"type": "subtitle", "time": 20912.43, "timestamp": "05:48:32", "text": "ええ、私がいたザックのマインクラフトサーバーは"}, {"type": "subtitle", "time": 20914.51, "timestamp": "05:48:34", "text": "プレイしているので、もしあなたがズキの"}, {"type": "subtitle", "time": 20916.43, "timestamp": "05:48:36", "text": "昨日の配信で気づいた方もいるでしょう"}, {"type": "subtitle", "time": 20917.99, "timestamp": "05:48:37", "text": "私は"}, {"type": "subtitle", "time": 20921.15, "timestamp": "05:48:41", "text": "そこで私たちは一緒に冒険に出かけた。"}, {"type": "subtitle", "time": 20925.628, "timestamp": "05:48:45", "text": "そして、なんと私たちは死んでしまったようです"}, {"type": "subtitle", "time": 20929.07, "timestamp": "05:48:49", "text": "彼女がストリームを終了した後"}, {"type": "subtitle", "time": 20934.19, "timestamp": "05:48:54", "text": "ゲームで彼女のアイテムを持っていた"}, {"type": "subtitle", "time": 20938.628, "timestamp": "05:48:58", "text": "でも、襲撃を手伝わなければならなかった"}]
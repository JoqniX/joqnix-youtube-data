[{"type": "subtitle", "time": 3908.39, "timestamp": "01:05:08", "text": "彼に私の呼びかけに答えてくれてありがとう"}, {"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "私たちはあなたに連絡を取ろうとしています"}, {"type": "subtitle", "time": 3911.71, "timestamp": "01:05:11", "text": "不確実性のため"}, {"type": "subtitle", "time": 3914.029, "timestamp": "01:05:14", "text": "[音楽]"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "いや、結構です。"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "ない"}, {"type": "subtitle", "time": 3921.15, "timestamp": "01:05:21", "text": "興味があります。発送できませんか？"}, {"type": "subtitle", "time": 3922.99, "timestamp": "01:05:22", "text": "窃盗行為 私は試してみたい 私は"}, {"type": "subtitle", "time": 3929.67, "timestamp": "01:05:29", "text": "彼をやってみよう 彼の"}, {"type": "subtitle", "time": 3946.67, "timestamp": "01:05:46", "text": "船が来る"}]
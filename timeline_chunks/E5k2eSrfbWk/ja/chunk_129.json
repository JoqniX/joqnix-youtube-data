[{"type": "subtitle", "time": 7745.03, "timestamp": "02:09:05", "text": "今私はここに戻ってきたので、ええと、私たちは"}, {"type": "subtitle", "time": 7753.549, "timestamp": "02:09:13", "text": "えーと"}, {"type": "subtitle", "time": 7759.43, "timestamp": "02:09:19", "text": "ジューシーな食事が戻ってきます。よし、試してみます。"}, {"type": "subtitle", "time": 7761.99, "timestamp": "02:09:21", "text": "マイクを使用できますか"}, {"type": "subtitle", "time": 7765.79, "timestamp": "02:09:25", "text": "顕微鏡で、"}, {"type": "subtitle", "time": 7770.109, "timestamp": "02:09:30", "text": "Hなので、私はこう信じていますが、ロックされています"}, {"type": "subtitle", "time": 7771.229, "timestamp": "02:09:31", "text": "ない"}, {"type": "subtitle", "time": 7780.109, "timestamp": "02:09:40", "text": "会議室はまだ探索していません"}, {"type": "subtitle", "time": 7783.87, "timestamp": "02:09:43", "text": "この場所はまだですが、私は人を殺しました"}, {"type": "subtitle", "time": 7786.109, "timestamp": "02:09:46", "text": "きっと彼らは何かを持っていたはずだ"}]
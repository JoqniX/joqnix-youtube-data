[{"type": "subtitle", "time": 3737.63, "timestamp": "01:02:17", "text": "水星さん、少しお時間をいただけますか？"}, {"type": "subtitle", "time": 3740.069, "timestamp": "01:02:20", "text": "私の呼びかけに答えてくれてありがとう"}, {"type": "subtitle", "time": 3742.029, "timestamp": "01:02:22", "text": "あなたの"}, {"type": "subtitle", "time": 3744.67, "timestamp": "01:02:24", "text": "船舶の延長保証 お客様の保証"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "補償期間が終了しました。まもなく終了する予定です。"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "政治情勢の不確実性のため"}, {"type": "subtitle", "time": 3752.269, "timestamp": "01:02:32", "text": "状況と確立されたシステム"}, {"type": "subtitle", "time": 3754.43, "timestamp": "01:02:34", "text": "今が更新する絶好の機会だと思います"}, {"type": "subtitle", "time": 3757.23, "timestamp": "01:02:37", "text": "船舶保証保護プランまたは"}, {"type": "subtitle", "time": 3765.63, "timestamp": "01:02:45", "text": "報道内容からすると、あなたは"}, {"type": "subtitle", "time": 3768.43, "timestamp": "01:02:48", "text": "もっと詳しく聞きたいのですが、まず"}, {"type": "subtitle", "time": 3770.63, "timestamp": "01:02:50", "text": "保証請求についてお知らせします"}, {"type": "subtitle", "time": 3772.269, "timestamp": "01:02:52", "text": "このプロセスは米国によって定められています"}, {"type": "subtitle", "time": 3773.95, "timestamp": "01:02:53", "text": "植民地仲裁"}, {"type": "subtitle", "time": 3776.75, "timestamp": "01:02:56", "text": "取締役会は意思決定者ではなく、"}, {"type": "subtitle", "time": 3779.63, "timestamp": "01:02:59", "text": "紛争の結果を変える前に"}]
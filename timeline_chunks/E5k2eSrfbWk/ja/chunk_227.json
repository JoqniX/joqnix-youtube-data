[{"type": "subtitle", "time": 13621.95, "timestamp": "03:47:01", "text": "私はまだそんなに勉強を始めていない"}, {"type": "subtitle", "time": 13624.59, "timestamp": "03:47:04", "text": "優先事項ですが、健康も"}, {"type": "subtitle", "time": 13628.429, "timestamp": "03:47:08", "text": "そうそうそうそうそうそうそうだから私は"}, {"type": "subtitle", "time": 13631.95, "timestamp": "03:47:11", "text": "ここで締めくくります。"}, {"type": "subtitle", "time": 13633.71, "timestamp": "03:47:13", "text": "今週の配信はすべて"}, {"type": "subtitle", "time": 13636.469, "timestamp": "03:47:16", "text": "スケジュールされた、えーと、私はそれらを見つける"}, {"type": "subtitle", "time": 13639.229, "timestamp": "03:47:19", "text": "ソーシャルはコミュニティフィードにあります"}, {"type": "subtitle", "time": 13643.309, "timestamp": "03:47:23", "text": "まあ、それを使えばいいんだけど"}, {"type": "subtitle", "time": 13656.51, "timestamp": "03:47:36", "text": "なぜあなたは「ああ」と言うのですか"}, {"type": "subtitle", "time": 13662.11, "timestamp": "03:47:42", "text": "神様、時々、これらの言葉はとても難しい"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "頭から離れるほど"}, {"type": "subtitle", "time": 13671.429, "timestamp": "03:47:51", "text": "ああ、とにかく、今日はこれで終わりです"}, {"type": "subtitle", "time": 13673.87, "timestamp": "03:47:53", "text": "次のフィールドで会いましょう。"}, {"type": "subtitle", "time": 13676.07, "timestamp": "03:47:56", "text": "今すぐストリーミング配信すれば、おそらく次は"}, {"type": "subtitle", "time": 13677.75, "timestamp": "03:47:57", "text": "週または"}]
[{"type": "subtitle", "time": 10803.63, "timestamp": "03:00:03", "text": "大丈夫だけど、今のところどうすればいいかわからない"}, {"type": "subtitle", "time": 10807.55, "timestamp": "03:00:07", "text": "私の良い銃をここに置くと"}, {"type": "subtitle", "time": 10810.07, "timestamp": "03:00:10", "text": "アップグレードなどを入れたいのですが"}, {"type": "subtitle", "time": 10812.51, "timestamp": "03:00:12", "text": "そのうちの1つがこれです"}, {"type": "subtitle", "time": 10816.19, "timestamp": "03:00:16", "text": "おい、それはここに保管できないぞ"}, {"type": "subtitle", "time": 10829.389, "timestamp": "03:00:29", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 10830.19, "timestamp": "03:00:30", "text": "それ"}, {"type": "subtitle", "time": 10834.15, "timestamp": "03:00:34", "text": "ヒューミー、あれは何だったの？"}, {"type": "subtitle", "time": 10839.429, "timestamp": "03:00:39", "text": "えっと、ピストルエネルギーガンレーザーについて"}, {"type": "subtitle", "time": 10842.83, "timestamp": "03:00:42", "text": "銃 レーザーライフル レーザーピストル オーケー レア"}, {"type": "subtitle", "time": 10854.11, "timestamp": "03:00:54", "text": "それは必要ないから、削除してもいいよ。"}]
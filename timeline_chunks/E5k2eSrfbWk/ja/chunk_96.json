[{"type": "subtitle", "time": 5761.51, "timestamp": "01:36:01", "text": "放棄された"}, {"type": "subtitle", "time": 5765.109, "timestamp": "01:36:05", "text": "地球は今やほとんど塵の塊だ"}, {"type": "subtitle", "time": 5767.709, "timestamp": "01:36:07", "text": "ええ、それはダストバリーです。いくつか見つけます"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "私たちが後にした世界の残骸"}, {"type": "subtitle", "time": 5772.87, "timestamp": "01:36:12", "text": "点を想像してください"}, {"type": "subtitle", "time": 5775.229, "timestamp": "01:36:15", "text": "将来は困難になるだろう 将来私たちは"}, {"type": "subtitle", "time": 5778.79, "timestamp": "01:36:18", "text": "私たちが地球を捨てて行かなければならない場所"}, {"type": "subtitle", "time": 5781.95, "timestamp": "01:36:21", "text": "火星か月か何かに"}, {"type": "subtitle", "time": 5784.51, "timestamp": "01:36:24", "text": "他の場所"}, {"type": "subtitle", "time": 5787.75, "timestamp": "01:36:27", "text": "武器を準備しておけ、何が起こるかわからないから"}, {"type": "subtitle", "time": 5790.709, "timestamp": "01:36:30", "text": "誰が医者に来て、あなたに迷惑をかけることを許すのですか"}, {"type": "subtitle", "time": 5792.75, "timestamp": "01:36:32", "text": "飛ぶためには、心の中に船が必要だ"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "閉じて、ボンブする"}]
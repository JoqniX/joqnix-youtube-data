[{"type": "subtitle", "time": 20042.43, "timestamp": "05:34:02", "text": "うんちだからM、えっと、わかってるよ、えっと、遊ぼうよ"}, {"type": "subtitle", "time": 20045.35, "timestamp": "05:34:05", "text": "一緒に遊ぼう"}, {"type": "subtitle", "time": 20048.67, "timestamp": "05:34:08", "text": "煮すぎたので、煮すぎた人は"}, {"type": "subtitle", "time": 20051.27, "timestamp": "05:34:11", "text": "Discordサーバーに参加できることはご存知ですか？"}, {"type": "subtitle", "time": 20055.19, "timestamp": "05:34:15", "text": "もしあなたが望むなら、そして私たちは"}, {"type": "subtitle", "time": 20056.99, "timestamp": "05:34:16", "text": "特別VC"}, {"type": "subtitle", "time": 20061.548, "timestamp": "05:34:21", "text": "開ける、うん、うん、えっと、何、何"}, {"type": "subtitle", "time": 20063.47, "timestamp": "05:34:23", "text": "オーバークックドをプレイすると言って"}, {"type": "subtitle", "time": 20067.03, "timestamp": "05:34:27", "text": "私もストリーミング配信します。待って"}, {"type": "subtitle", "time": 20069.23, "timestamp": "05:34:29", "text": "みんなは私がそれをストリーミングすることを望んでいるの？"}, {"type": "subtitle", "time": 20073.11, "timestamp": "05:34:33", "text": "Discord イベント、それとも皆さんはどちらがお好みですか?"}, {"type": "subtitle", "time": 20076.67, "timestamp": "05:34:36", "text": "えっと、ただ聞いて、ただ"}, {"type": "subtitle", "time": 20079.708, "timestamp": "05:34:39", "text": "オフラインになる ハングアウトの必要性"}, {"type": "subtitle", "time": 20082.15, "timestamp": "05:34:42", "text": "インターネット上にいると、私はいくつかのことを知っています"}, {"type": "subtitle", "time": 20083.43, "timestamp": "05:34:43", "text": "人々は"}, {"type": "subtitle", "time": 20086.47, "timestamp": "05:34:46", "text": "Stuでオンラインになるのは不快なので"}, {"type": "subtitle", "time": 20089.31, "timestamp": "05:34:49", "text": "配信しないつもりだった"}, {"type": "subtitle", "time": 20091.39, "timestamp": "05:34:51", "text": "私はそうは思わない"}, {"type": "subtitle", "time": 20093.788, "timestamp": "05:34:53", "text": "またね、みんな！"}, {"type": "subtitle", "time": 20097.23, "timestamp": "05:34:57", "text": "選択肢があり、また、"}, {"type": "subtitle", "time": 20098.39, "timestamp": "05:34:58", "text": "投票"}]
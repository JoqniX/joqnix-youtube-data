[{"type": "subtitle", "time": 19623.548, "timestamp": "05:27:03", "text": "チャットでは、リンクを見つけることができます。"}, {"type": "subtitle", "time": 19626.47, "timestamp": "05:27:06", "text": "説明"}, {"type": "subtitle", "time": 19628.948, "timestamp": "05:27:08", "text": "従うな"}, {"type": "subtitle", "time": 19632.628, "timestamp": "05:27:12", "text": "いや、いやいや"}, {"type": "subtitle", "time": 19636.39, "timestamp": "05:27:16", "text": "君、そうだよ、もし君が私たち二人とも好きなら"}, {"type": "subtitle", "time": 19639.59, "timestamp": "05:27:19", "text": "私たち両方にすぐに登録して"}, {"type": "subtitle", "time": 19640.99, "timestamp": "05:27:20", "text": "のように"}, {"type": "subtitle", "time": 19649.31, "timestamp": "05:27:29", "text": "声が裏返る"}, {"type": "subtitle", "time": 19661.628, "timestamp": "05:27:41", "text": "ええ、私はコラボレーションをとても楽しんだ"}, {"type": "subtitle", "time": 19665.83, "timestamp": "05:27:45", "text": "あなたはCHのままでいてください。コラボレーションできたらいいのに。"}, {"type": "subtitle", "time": 19669.23, "timestamp": "05:27:49", "text": "また将来、もちろん、いいよ"}, {"type": "subtitle", "time": 19672.67, "timestamp": "05:27:52", "text": "いいじゃないですか、はい、コラボレーションしたいものは何ですか？"}, {"type": "subtitle", "time": 19676.47, "timestamp": "05:27:56", "text": "1つですが、どんなゲームでも"}]
[{"type": "subtitle", "time": 18303.03, "timestamp": "05:05:03", "text": "そうそう、5回そうだけど、私はできる"}, {"type": "subtitle", "time": 18305.43, "timestamp": "05:05:05", "text": "たった4回しか右に行かないのに"}, {"type": "subtitle", "time": 18308.628, "timestamp": "05:05:08", "text": "4回待って1回待ってあなたは"}, {"type": "subtitle", "time": 18312.11, "timestamp": "05:05:12", "text": "えーと、A1 の 2 ああ、待って、ああ、そうそう、4 です"}, {"type": "subtitle", "time": 18315.51, "timestamp": "05:05:15", "text": "ああ、気にしないで、私はバカだから、4回行く"}, {"type": "subtitle", "time": 18317.31, "timestamp": "05:05:17", "text": "絶好のタイミング"}, {"type": "subtitle", "time": 18322.67, "timestamp": "05:05:22", "text": "はい、4回です。はい、わかりました。では、"}, {"type": "subtitle", "time": 18327.03, "timestamp": "05:05:27", "text": "上へは行けません、最上段まで待ってください"}, {"type": "subtitle", "time": 18331.39, "timestamp": "05:05:31", "text": "四角いやつはどこにあるの？"}, {"type": "subtitle", "time": 18335.07, "timestamp": "05:05:35", "text": "白い白いものは"}, {"type": "subtitle", "time": 18339.788, "timestamp": "05:05:39", "text": "F1 F1 um"}, {"type": "subtitle", "time": 18342.11, "timestamp": "05:05:42", "text": "H 上には行けません"}, {"type": "subtitle", "time": 18346.23, "timestamp": "05:05:46", "text": "ああ、じゃあ元の場所に戻って"}, {"type": "subtitle", "time": 18349.83, "timestamp": "05:05:49", "text": "それは4回左に戻ってくる"}, {"type": "subtitle", "time": 18352.11, "timestamp": "05:05:52", "text": "元の場所に戻る 私は一度も動いたことがない ただ"}, {"type": "subtitle", "time": 18355.31, "timestamp": "05:05:55", "text": "うん、私は20秒間一度も動いていない"}, {"type": "subtitle", "time": 18357.75, "timestamp": "05:05:57", "text": "ああ、いや、だから行く"}]
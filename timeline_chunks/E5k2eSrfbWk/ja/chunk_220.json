[{"type": "subtitle", "time": 13203.15, "timestamp": "03:40:03", "text": "クエストとか色々と4つ"}, {"type": "subtitle", "time": 13206.11, "timestamp": "03:40:06", "text": "C"}, {"type": "subtitle", "time": 13209.91, "timestamp": "03:40:09", "text": "わあ、あなたはゆっくりと良くなっていますね"}, {"type": "subtitle", "time": 13212.349, "timestamp": "03:40:12", "text": "ゆっくり推測する"}, {"type": "subtitle", "time": 13215.309, "timestamp": "03:40:15", "text": "ゆっくりと、そして私たちの背景は"}, {"type": "subtitle", "time": 13227.71, "timestamp": "03:40:27", "text": "ええ、犯罪は1件だけです。密輸品1件だけです。"}, {"type": "subtitle", "time": 13231.03, "timestamp": "03:40:31", "text": "3点の盗難品が逮捕された"}, {"type": "subtitle", "time": 13239.91, "timestamp": "03:40:39", "text": "うん、健康レベルは今9だからほとんど"}, {"type": "subtitle", "time": 13243.07, "timestamp": "03:40:43", "text": "将来の流れでは"}, {"type": "subtitle", "time": 13245.75, "timestamp": "03:40:45", "text": "スターフィールドでは、以下のようにアップグレードします"}, {"type": "subtitle", "time": 13248.63, "timestamp": "03:40:48", "text": "私たち自身を拡大し、私はほとんどすべてを手に入れます"}, {"type": "subtitle", "time": 13250.71, "timestamp": "03:40:50", "text": "スキルポイントとか色々試してみます"}, {"type": "subtitle", "time": 13253.07, "timestamp": "03:40:53", "text": "可能であればHストリームを再生して、"}, {"type": "subtitle", "time": 13256.03, "timestamp": "03:40:56", "text": "サイドクエストなどのタスクをいくつかこなす"}, {"type": "subtitle", "time": 13259.03, "timestamp": "03:40:59", "text": "サイドクエストがたくさんあるようなものですよね"}]
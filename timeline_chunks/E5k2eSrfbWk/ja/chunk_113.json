[{"type": "subtitle", "time": 6790.87, "timestamp": "01:53:10", "text": "変なことに、私が遊び始めてからずっと"}, {"type": "subtitle", "time": 6792.83, "timestamp": "01:53:12", "text": "で"}, {"type": "subtitle", "time": 6805.55, "timestamp": "01:53:25", "text": "旅に出て恐怖に立ち向かえ、ああ、戻ってきたぞ"}, {"type": "subtitle", "time": 6807.39, "timestamp": "01:53:27", "text": "何が起こっている"}, {"type": "subtitle", "time": 6811.27, "timestamp": "01:53:31", "text": "えっと、これってかなり昔の話じゃなかったっけ？"}, {"type": "subtitle", "time": 6815.39, "timestamp": "01:53:35", "text": "ヴァラー、ああ、いい、いい、いい、私は戻ってきた"}, {"type": "subtitle", "time": 6818.51, "timestamp": "01:53:38", "text": "ここで私は持っていた"}, {"type": "subtitle", "time": 6834.149, "timestamp": "01:53:54", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 6835.79, "timestamp": "01:53:55", "text": "えっと、ここはどこだっけ？ああ、戻ってきたよ"}]
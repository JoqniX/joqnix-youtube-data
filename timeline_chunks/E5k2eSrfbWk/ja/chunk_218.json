[{"type": "subtitle", "time": 13081.269, "timestamp": "03:38:01", "text": "機能不全の小さな"}, {"type": "subtitle", "time": 13085.71, "timestamp": "03:38:05", "text": "家族よ、あなたはきっとCoだわ、うわぁ"}, {"type": "subtitle", "time": 13087.229, "timestamp": "03:38:07", "text": "アキラの暗い側面をいくつか知っておく"}, {"type": "subtitle", "time": 13088.67, "timestamp": "03:38:08", "text": "月ですが、もしあなたが深いところを探しているなら"}, {"type": "subtitle", "time": 13089.79, "timestamp": "03:38:09", "text": "歴史"}, {"type": "subtitle", "time": 13092.349, "timestamp": "03:38:12", "text": "レッスン、さて、私は眠りに落ちそうです"}, {"type": "subtitle", "time": 13096.429, "timestamp": "03:38:16", "text": "そうする前に、私を信じて、奨励しないでください"}, {"type": "subtitle", "time": 13101.11, "timestamp": "03:38:21", "text": "ところで、コロさん、こんにちは、コロさん、嬉しいです"}, {"type": "subtitle", "time": 13103.389, "timestamp": "03:38:23", "text": "お会いできて嬉しいです。勇敢な方ならどなたでもお会いできます。"}, {"type": "subtitle", "time": 13106.189, "timestamp": "03:38:26", "text": "フロンティアを飛ぶのに十分で何もない、"}, {"type": "subtitle", "time": 13108.07, "timestamp": "03:38:28", "text": "宇宙船に関する2つの話題"}, {"type": "subtitle", "time": 13111.469, "timestamp": "03:38:31", "text": "ドイ、新しい友達を怖がらせないで"}, {"type": "subtitle", "time": 13116.51, "timestamp": "03:38:36", "text": "フロンティアは素晴らしい船です、正直に言って、"}, {"type": "subtitle", "time": 13118.87, "timestamp": "03:38:38", "text": "仕事の話はいいよ、サラ、"}, {"type": "subtitle", "time": 13120.99, "timestamp": "03:38:40", "text": "について"}, {"type": "subtitle", "time": 13124.469, "timestamp": "03:38:44", "text": "探検隊、確かにそこは"}, {"type": "subtitle", "time": 13125.95, "timestamp": "03:38:45", "text": "私たちは向かっています"}, {"type": "subtitle", "time": 13127.67, "timestamp": "03:38:47", "text": "私たち３人はアキラに向かっています"}, {"type": "subtitle", "time": 13129.15, "timestamp": "03:38:49", "text": "3つの恒星系で最初に定住した惑星"}, {"type": "subtitle", "time": 13131.91, "timestamp": "03:38:51", "text": "集団的であり、偶然ではないが"}, {"type": "subtitle", "time": 13134.71, "timestamp": "03:38:54", "text": "彼らの首都アイラ市の本拠地"}, {"type": "subtitle", "time": 13136.95, "timestamp": "03:38:56", "text": "都市の宇宙港に着陸するが、"}]
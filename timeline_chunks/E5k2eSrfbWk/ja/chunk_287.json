[{"type": "subtitle", "time": 17220.27, "timestamp": "04:47:00", "text": "マーキングなので、最初の円のマーキングは"}, {"type": "subtitle", "time": 17223.11, "timestamp": "04:47:03", "text": "4番目のように"}, {"type": "subtitle", "time": 17226.23, "timestamp": "04:47:06", "text": "列、そして最後"}, {"type": "subtitle", "time": 17239.59, "timestamp": "04:47:19", "text": "えっと、最後はえっと"}, {"type": "subtitle", "time": 17242.97, "timestamp": "04:47:22", "text": "待って、底、そう、底"}, {"type": "subtitle", "time": 17250.788, "timestamp": "04:47:30", "text": "えっと、ああ、神様、混乱しています"}, {"type": "subtitle", "time": 17254.708, "timestamp": "04:47:34", "text": "ああ、2番目"}, {"type": "subtitle", "time": 17256.83, "timestamp": "04:47:36", "text": "サークルは心配する必要はありません"}, {"type": "subtitle", "time": 17258.27, "timestamp": "04:47:38", "text": "2番目のサークルは、知っておくだけでよい"}, {"type": "subtitle", "time": 17260.11, "timestamp": "04:47:40", "text": "最初のことについては、だって、"}, {"type": "subtitle", "time": 17262.948, "timestamp": "04:47:42", "text": "重なり合うデザインなので、もしあなたが知っているなら"}, {"type": "subtitle", "time": 17265.788, "timestamp": "04:47:45", "text": "まずサークル、それで十分です"}, {"type": "subtitle", "time": 17268.11, "timestamp": "04:47:48", "text": "えっと、迷路にはどれくらい時間がありますか？"}, {"type": "subtitle", "time": 17272.75, "timestamp": "04:47:52", "text": "迷路を見てください、わかりました、ええと、私は"}, {"type": "subtitle", "time": 17275.75, "timestamp": "04:47:55", "text": "迷路を見て、白い光はどこにある？"}, {"type": "subtitle", "time": 17279.91, "timestamp": "04:47:59", "text": "赤信号は最後のところにあります"}]
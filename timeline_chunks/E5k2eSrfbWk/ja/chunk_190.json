[{"type": "subtitle", "time": 11404.91, "timestamp": "03:10:04", "text": "使い切った"}, {"type": "subtitle", "time": 11439.11, "timestamp": "03:10:39", "text": "待って待って待って待って待って忘れた"}, {"type": "subtitle", "time": 11442.71, "timestamp": "03:10:42", "text": "すべてにいくつかのものを投下した"}, {"type": "subtitle", "time": 11445.95, "timestamp": "03:10:45", "text": "そういえば、彼女について色々調べてたのを忘れてた。"}, {"type": "subtitle", "time": 11448.95, "timestamp": "03:10:48", "text": "右にロードする"}, {"type": "subtitle", "time": 11451.87, "timestamp": "03:10:51", "text": "モーガン、私は彼女にいくつかのものをぶちまけて"}, {"type": "subtitle", "time": 11454.469, "timestamp": "03:10:54", "text": "ロボットの男みたいに、売らせてくれよ"}, {"type": "subtitle", "time": 11456.95, "timestamp": "03:10:56", "text": "そういうものもこの場所はただ"}]
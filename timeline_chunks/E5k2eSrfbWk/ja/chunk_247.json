[{"type": "subtitle", "time": 14824.63, "timestamp": "04:07:04", "text": "1つだけだと少し難しい"}, {"type": "subtitle", "time": 14828.229, "timestamp": "04:07:08", "text": "名前 ああ、私"}, {"type": "subtitle", "time": 14831.07, "timestamp": "04:07:11", "text": "えっと、何を心配しないの？"}, {"type": "subtitle", "time": 14834.03, "timestamp": "04:07:14", "text": "ルー、私はただ黒くなりました"}, {"type": "subtitle", "time": 14837.429, "timestamp": "04:07:17", "text": "私が話していないときは、ただ"}, {"type": "subtitle", "time": 14839.91, "timestamp": "04:07:19", "text": "起こるよ、ああ、暗くなるかもしれない"}, {"type": "subtitle", "time": 14842.349, "timestamp": "04:07:22", "text": "私の原子炉の画像は見ていないが、私は"}, {"type": "subtitle", "time": 14844.51, "timestamp": "04:07:24", "text": "Among Usとのコラボレーション後に変更しました"}, {"type": "subtitle", "time": 14853.63, "timestamp": "04:07:33", "text": "ああ、それはとてもいい。ヤンドレみたいだね。"}, {"type": "subtitle", "time": 14855.87, "timestamp": "04:07:35", "text": "でも目は見えないけどあなたの目は見える"}, {"type": "subtitle", "time": 14872.389, "timestamp": "04:07:52", "text": "待って、パスを持ってるよ、待って、何？"}, {"type": "subtitle", "time": 14877.79, "timestamp": "04:07:57", "text": "パス ロコ 何 パス 何 何 パス また"}]
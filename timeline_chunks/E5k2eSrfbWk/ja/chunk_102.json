[{"type": "subtitle", "time": 6125.47, "timestamp": "01:42:05", "text": "えっと、ここで一時停止させてください。"}, {"type": "subtitle", "time": 6128.03, "timestamp": "01:42:08", "text": "休憩を取って、ワード、私はすべてを楽しんでいます"}, {"type": "subtitle", "time": 6132.709, "timestamp": "01:42:12", "text": "大丈夫、私のロンを見て"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "無効 なぜそうではないのか"}, {"type": "subtitle", "time": 6155.83, "timestamp": "01:42:35", "text": "いや、間違いを犯した。待って待って待って待って"}, {"type": "subtitle", "time": 6156.84, "timestamp": "01:42:36", "text": "待って待って 待って、どこかで間違えたよ、ああ神様"}, {"type": "subtitle", "time": 6159.639, "timestamp": "01:42:39", "text": "待って、どこかで間違えたよ、ああ神様 ちょっと待って、これを直させてください"}, {"type": "subtitle", "time": 6166.87, "timestamp": "01:42:46", "text": "えっと、私は何をしたの？"}, {"type": "subtitle", "time": 6179.83, "timestamp": "01:42:59", "text": "よし、これは"}]
[{"type": "subtitle", "time": 8176.35, "timestamp": "02:16:16", "text": "そう、それはまた私が与えたいものです"}, {"type": "subtitle", "time": 8178.709, "timestamp": "02:16:18", "text": "あなたにとってはジャンク品"}, {"type": "subtitle", "time": 8181.629, "timestamp": "02:16:21", "text": "またキムが何度もやってくる"}, {"type": "subtitle", "time": 8185.39, "timestamp": "02:16:25", "text": "どこで待っているかをお見せします"}, {"type": "subtitle", "time": 8192.19, "timestamp": "02:16:32", "text": "ああ、そこにいる"}, {"type": "subtitle", "time": 8194.629, "timestamp": "02:16:34", "text": "は"}, {"type": "subtitle", "time": 8205.27, "timestamp": "02:16:45", "text": "卒業前にそう言っておきます"}, {"type": "subtitle", "time": 8210.549, "timestamp": "02:16:50", "text": "学校からバンドをやっていて、"}, {"type": "subtitle", "time": 8214.589, "timestamp": "02:16:54", "text": "学校のバンドのことじゃないよ、ロックのことだよ"}, {"type": "subtitle", "time": 8219.87, "timestamp": "02:16:59", "text": "皮肉な彗星と名乗ったバンド"}]
[{"type": "subtitle", "time": 15060.03, "timestamp": "04:11:00", "text": "一番シンプルなのは星です。最初の星"}, {"type": "subtitle", "time": 15063.189, "timestamp": "04:11:03", "text": "まるで空っぽのようだ"}, {"type": "subtitle", "time": 15066.99, "timestamp": "04:11:06", "text": "中は星で埋め尽くされている"}, {"type": "subtitle", "time": 15070.59, "timestamp": "04:11:10", "text": "星よ、わかった、わかった、2番目"}, {"type": "subtitle", "time": 15073.83, "timestamp": "04:11:13", "text": "1つは3のように見えますが、"}, {"type": "subtitle", "time": 15075.95, "timestamp": "04:11:15", "text": "見た目が素敵な木ですね、ええ、見た目が素敵な"}, {"type": "subtitle", "time": 15078.83, "timestamp": "04:11:18", "text": "アナの木"}, {"type": "subtitle", "time": 15080.99, "timestamp": "04:11:20", "text": "うん、それ"}, {"type": "subtitle", "time": 15085.51, "timestamp": "04:11:25", "text": "3つ目は、T字型に見えます。"}, {"type": "subtitle", "time": 15088.269, "timestamp": "04:11:28", "text": "しかしビッシュがいる"}, {"type": "subtitle", "time": 15093.469, "timestamp": "04:11:33", "text": "ボディ ビッシュ ボディ TB わかった、見えるよ TB"}, {"type": "subtitle", "time": 15095.63, "timestamp": "04:11:35", "text": "うん、TB、最後のは"}, {"type": "subtitle", "time": 15098.79, "timestamp": "04:11:38", "text": "舌を出した笑顔"}, {"type": "subtitle", "time": 15101.389, "timestamp": "04:11:41", "text": "U、うん、スマイリー、わかった、全部わかったよ"}, {"type": "subtitle", "time": 15103.55, "timestamp": "04:11:43", "text": "彼ら全員が笑顔を浮かべているのが見える"}, {"type": "subtitle", "time": 15105.79, "timestamp": "04:11:45", "text": "顔面から"}, {"type": "subtitle", "time": 15109.99, "timestamp": "04:11:49", "text": "じゃあBTの件ね"}, {"type": "subtitle", "time": 15113.55, "timestamp": "04:11:53", "text": "そう、それから高級品"}, {"type": "subtitle", "time": 15117.269, "timestamp": "04:11:57", "text": "３つ目、そして星"}]
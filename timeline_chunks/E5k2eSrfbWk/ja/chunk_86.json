[{"type": "subtitle", "time": 5161.75, "timestamp": "01:26:01", "text": "確信はないけど、"}, {"type": "subtitle", "time": 5165.47, "timestamp": "01:26:05", "text": "つまり、それは"}, {"type": "subtitle", "time": 5167.03, "timestamp": "01:26:07", "text": "[音楽]"}, {"type": "subtitle", "time": 5170.31, "timestamp": "01:26:10", "text": "えっと、メインクエストをやってみようかな"}, {"type": "subtitle", "time": 5172.42, "timestamp": "01:26:12", "text": "近所の人たち全員"}, {"type": "subtitle", "time": 5189.83, "timestamp": "01:26:29", "text": "はい"}, {"type": "subtitle", "time": 5200.99, "timestamp": "01:26:40", "text": "それでは、ここには何があるか見てください"}, {"type": "subtitle", "time": 5204.629, "timestamp": "01:26:44", "text": "船団のテオン・ジーロット、今まで"}, {"type": "subtitle", "time": 5205.95, "timestamp": "01:26:45", "text": "遭遇する"}, {"type": "subtitle", "time": 5209.149, "timestamp": "01:26:49", "text": "彼らが呼ぶものに完全に専念している"}, {"type": "subtitle", "time": 5212.59, "timestamp": "01:26:52", "text": "大蛇、食らう者"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "信じない人たち、何が"}]
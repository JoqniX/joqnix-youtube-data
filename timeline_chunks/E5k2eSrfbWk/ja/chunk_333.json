[{"type": "subtitle", "time": 19980.788, "timestamp": "05:33:00", "text": "次に、最後に、"}, {"type": "subtitle", "time": 19984.67, "timestamp": "05:33:04", "text": "皆さんに思い出していただきたいのですが、いくつか"}, {"type": "subtitle", "time": 19988.868, "timestamp": "05:33:08", "text": "ということで、今週は"}, {"type": "subtitle", "time": 19991.99, "timestamp": "05:33:11", "text": "私のDiscordサーバー"}, {"type": "subtitle", "time": 19996.19, "timestamp": "05:33:16", "text": "記念日彼はとてもとてもとてもとてもとてもとてもうーんそれは"}, {"type": "subtitle", "time": 19998.788, "timestamp": "05:33:18", "text": "開催日"}, {"type": "subtitle", "time": 20002.628, "timestamp": "05:33:22", "text": "日曜日は"}, {"type": "subtitle", "time": 20008.948, "timestamp": "05:33:28", "text": "日曜日"}, {"type": "subtitle", "time": 20012.23, "timestamp": "05:33:32", "text": "何をプレイするかはまだ計画していません"}, {"type": "subtitle", "time": 20015.99, "timestamp": "05:33:35", "text": "起こっている出来事ですが、皆さんは"}, {"type": "subtitle", "time": 20019.23, "timestamp": "05:33:39", "text": "えーと、サーバーを手に入れて、撃ち出すよ"}, {"type": "subtitle", "time": 20022.07, "timestamp": "05:33:42", "text": "Twitterでの発表と"}, {"type": "subtitle", "time": 20026.39, "timestamp": "05:33:46", "text": "あと、ええ、Twitterもやります"}, {"type": "subtitle", "time": 20029.59, "timestamp": "05:33:49", "text": "そしてDiscordの発表なので、私は計画します"}, {"type": "subtitle", "time": 20034.43, "timestamp": "05:33:54", "text": "コミュニティゲームナイトをするには、できません。"}, {"type": "subtitle", "time": 20036.788, "timestamp": "05:33:56", "text": "パーティーの手助け"}]
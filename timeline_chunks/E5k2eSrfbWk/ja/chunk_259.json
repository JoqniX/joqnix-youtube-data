[{"type": "subtitle", "time": 15543.79, "timestamp": "04:19:03", "text": "オーケー、赤が2つ、もし叫ぶ人がいなければ"}, {"type": "subtitle", "time": 15548.149, "timestamp": "04:19:08", "text": "そしてL、またはシリアル番号は何ですか"}, {"type": "subtitle", "time": 15552.469, "timestamp": "04:19:12", "text": "最後の発掘は確かに奇妙だ"}, {"type": "subtitle", "time": 15555.83, "timestamp": "04:19:15", "text": "よし、黄色い配線はない"}, {"type": "subtitle", "time": 15559.469, "timestamp": "04:19:19", "text": "黄色い線がないので、3番目を切断します"}, {"type": "subtitle", "time": 15563.109, "timestamp": "04:19:23", "text": "ワイヤー3本目、はい、わかりました、完了、緑"}, {"type": "subtitle", "time": 15567.349, "timestamp": "04:19:27", "text": "ライト、ああ、いいね、最後のボタン、まだ"}, {"type": "subtitle", "time": 15569.87, "timestamp": "04:19:29", "text": "2分半半あります"}, {"type": "subtitle", "time": 15574.75, "timestamp": "04:19:34", "text": "ああ、いいですね。えっと、テキストには何て書いてありますか？"}, {"type": "subtitle", "time": 15577.79, "timestamp": "04:19:37", "text": "そしてボタンのやつは大きい"}, {"type": "subtitle", "time": 15583.51, "timestamp": "04:19:43", "text": "少年よ、それは中止Bと書かれた青いボタンだ"}, {"type": "subtitle", "time": 15587.83, "timestamp": "04:19:47", "text": "はい、ボタンは青色です。"}, {"type": "subtitle", "time": 15591.269, "timestamp": "04:19:51", "text": "B ボタンを押し続けるか、ああ、"}, {"type": "subtitle", "time": 15596.51, "timestamp": "04:19:56", "text": "ボタン、はい、ボタンを押し続けます、はい、ボタンを押し続けます"}, {"type": "subtitle", "time": 15599.99, "timestamp": "04:19:59", "text": "青色の青いリリースを手に持って"}]
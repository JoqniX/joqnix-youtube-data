[{"type": "subtitle", "time": 16620.67, "timestamp": "04:37:00", "text": "ロリポップ、それから"}, {"type": "subtitle", "time": 16623.949, "timestamp": "04:37:03", "text": "心臓の鼓動、心臓の鼓動、もう一度"}, {"type": "subtitle", "time": 16625.59, "timestamp": "04:37:05", "text": "ロリポップ"}, {"type": "subtitle", "time": 16628.709, "timestamp": "04:37:08", "text": "はい、走っている男が走っています"}, {"type": "subtitle", "time": 16632.75, "timestamp": "04:37:12", "text": "男の心臓の鼓動、そしてこれ"}, {"type": "subtitle", "time": 16635.75, "timestamp": "04:37:15", "text": "よし、これで終わりだ。次に進もう。"}, {"type": "subtitle", "time": 16639.709, "timestamp": "04:37:19", "text": "実際に配線は大丈夫"}, {"type": "subtitle", "time": 16643.789, "timestamp": "04:37:23", "text": "うん、1、2、3、4、6、6が見える"}, {"type": "subtitle", "time": 16646.83, "timestamp": "04:37:26", "text": "ワイヤーの一番最後に黒いワイヤーがあります"}, {"type": "subtitle", "time": 16650.83, "timestamp": "04:37:30", "text": "最後に黒いワイヤーが1本、それから2本"}, {"type": "subtitle", "time": 16653.83, "timestamp": "04:37:33", "text": "3つ、青いワイヤーが1本と残りは"}, {"type": "subtitle", "time": 16656.429, "timestamp": "04:37:36", "text": "それらはすべて、待って待って待って"}, {"type": "subtitle", "time": 16658.109, "timestamp": "04:37:38", "text": "ちょっと待って、ちょっと言わせてください"}, {"type": "subtitle", "time": 16661.709, "timestamp": "04:37:41", "text": "条件は黄色ですか"}, {"type": "subtitle", "time": 16665.869, "timestamp": "04:37:45", "text": "ワイヤー、いや、黄色いワイヤー、そしてそれは"}, {"type": "subtitle", "time": 16668.709, "timestamp": "04:37:48", "text": "シリアル番号の最後の桁"}, {"type": "subtitle", "time": 16672.83, "timestamp": "04:37:52", "text": "数字 ええと、シリアル番号が2つあります"}, {"type": "subtitle", "time": 16675.109, "timestamp": "04:37:55", "text": "数字待って待って待って手に入れた手に入れた"}, {"type": "subtitle", "time": 16676.269, "timestamp": "04:37:56", "text": "昨年は"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "66 ああ、気にしないで、そうでなければ"}]
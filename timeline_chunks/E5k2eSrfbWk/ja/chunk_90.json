[{"type": "subtitle", "time": 5402.95, "timestamp": "01:30:02", "text": "システムを彼方へと運び、触れた"}, {"type": "subtitle", "time": 5403.99, "timestamp": "01:30:03", "text": "あなたの"}, {"type": "subtitle", "time": 5406.39, "timestamp": "01:30:06", "text": "彼が真実を知ったことは、素晴らしいことだった"}, {"type": "subtitle", "time": 5410.35, "timestamp": "01:30:10", "text": "来るべき永遠を覆い隠す"}, {"type": "subtitle", "time": 5413.47, "timestamp": "01:30:13", "text": "報酬を受け取ることを受け入れてください"}, {"type": "subtitle", "time": 5416.39, "timestamp": "01:30:16", "text": "約束して呪われた者を"}, {"type": "subtitle", "time": 5452.43, "timestamp": "01:30:52", "text": "少年、私はただそこにいて、私はただ探している"}, {"type": "subtitle", "time": 5455.43, "timestamp": "01:30:55", "text": "私の近くのM"}, {"type": "subtitle", "time": 5458.07, "timestamp": "01:30:58", "text": "何か何か"}]
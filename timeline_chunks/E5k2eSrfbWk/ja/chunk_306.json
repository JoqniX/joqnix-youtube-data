[{"type": "subtitle", "time": 18362.59, "timestamp": "05:06:02", "text": "左 左 1 はい 1 1 左 できません"}, {"type": "subtitle", "time": 18368.31, "timestamp": "05:06:08", "text": "左に行け、左には行けない、あぁ、待って"}, {"type": "subtitle", "time": 18372.31, "timestamp": "05:06:12", "text": "下に行くこともできます"}, {"type": "subtitle", "time": 18375.31, "timestamp": "05:06:15", "text": "上へ、いや、行けない"}, {"type": "subtitle", "time": 18378.51, "timestamp": "05:06:18", "text": "下へ、上へは行けないよ、待って、何？"}, {"type": "subtitle", "time": 18380.31, "timestamp": "05:06:20", "text": "これ"}, {"type": "subtitle", "time": 18383.35, "timestamp": "05:06:23", "text": "あ、待って、動いた？待って、吹いた？"}, {"type": "subtitle", "time": 18388.11, "timestamp": "05:06:28", "text": "うん、爆発するよ、ああ、ママ、読んで"}, {"type": "subtitle", "time": 18390.39, "timestamp": "05:06:30", "text": "まず、マニュアルを読んで、何が起こっているのか"}, {"type": "subtitle", "time": 18392.788, "timestamp": "05:06:32", "text": "ああ、ああ、なんで私たちは失敗しているんだろう"}, {"type": "subtitle", "time": 18404.51, "timestamp": "05:06:44", "text": "ああ、私のSerはトレーニングしている、ああ、それは"}, {"type": "subtitle", "time": 18407.788, "timestamp": "05:06:47", "text": "よかった、それでその問題は解決したのかもしれない。"}, {"type": "subtitle", "time": 18416.31, "timestamp": "05:06:56", "text": "マインクラフトはMaesの主題です"}, {"type": "subtitle", "time": 18418.07, "timestamp": "05:06:58", "text": "一致する円形のマーキングのある迷路"}]
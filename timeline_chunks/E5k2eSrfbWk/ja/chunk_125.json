[{"type": "subtitle", "time": 7502.83, "timestamp": "02:05:02", "text": "ポケットウェア"}, {"type": "subtitle", "time": 7505.83, "timestamp": "02:05:05", "text": "また待って、これは私だけでしょうか、それともこれは"}, {"type": "subtitle", "time": 7513.39, "timestamp": "02:05:13", "text": "私もそのジャケット好きです。"}, {"type": "subtitle", "time": 7515.75, "timestamp": "02:05:15", "text": "いいよ、全部持って行って"}, {"type": "subtitle", "time": 7519.51, "timestamp": "02:05:19", "text": "君が連れて行くのが見えるよ"}, {"type": "subtitle", "time": 7523.95, "timestamp": "02:05:23", "text": "それと、私は"}, {"type": "subtitle", "time": 7528.47, "timestamp": "02:05:28", "text": "ヘルメットは資源の重量が少なく、酸素が少ない"}, {"type": "subtitle", "time": 7531.589, "timestamp": "02:05:31", "text": "消費量これより軽いこれ"}, {"type": "subtitle", "time": 7533.51, "timestamp": "02:05:33", "text": "かなり重い"}, {"type": "subtitle", "time": 7535.669, "timestamp": "02:05:35", "text": "わかった"}, {"type": "subtitle", "time": 7538.91, "timestamp": "02:05:38", "text": "えーと、おかえりなさい。"}, {"type": "subtitle", "time": 7548.47, "timestamp": "02:05:48", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 7557.27, "timestamp": "02:05:57", "text": "toml は必要ですか？"}]
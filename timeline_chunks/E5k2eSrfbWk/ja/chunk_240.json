[{"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "でも、言い忘れてたけど、"}, {"type": "subtitle", "time": 14409.79, "timestamp": "04:00:09", "text": "埋め込みを再度手動で行う必要があります"}, {"type": "subtitle", "time": 14412.349, "timestamp": "04:00:12", "text": "毎回電源を入れることができないので"}, {"type": "subtitle", "time": 14415.349, "timestamp": "04:00:15", "text": "設定を見つけてオンのままにしておく"}, {"type": "subtitle", "time": 14419.07, "timestamp": "04:00:19", "text": "デフォルトでは、再利用する必要があると思います"}, {"type": "subtitle", "time": 14421.469, "timestamp": "04:00:21", "text": "設定は同じです。"}, {"type": "subtitle", "time": 14423.71, "timestamp": "04:00:23", "text": "あなたのストリーム、それが私が"}, {"type": "subtitle", "time": 14426.38, "timestamp": "04:00:26", "text": "すべて使用"}, {"type": "subtitle", "time": 14428.55, "timestamp": "04:00:28", "text": "[音楽]"}, {"type": "subtitle", "time": 14430.63, "timestamp": "04:00:30", "text": "時々、新しいものを作るときに"}, {"type": "subtitle", "time": 14433.469, "timestamp": "04:00:33", "text": "ストリームにはそのオプションがありません"}, {"type": "subtitle", "time": 14435.87, "timestamp": "04:00:35", "text": "有効になっているか何か、私は"}, {"type": "subtitle", "time": 14438.51, "timestamp": "04:00:38", "text": "つまり、もうずいぶん経つと思うんだけど"}, {"type": "subtitle", "time": 14440.429, "timestamp": "04:00:40", "text": "私が話し続けている間"}, {"type": "subtitle", "time": 14442.26, "timestamp": "04:00:42", "text": "ストリームなので"}, {"type": "subtitle", "time": 14449.83, "timestamp": "04:00:49", "text": "待って、まだやってないよ、話し続けてくれ X"}, {"type": "subtitle", "time": 14452.429, "timestamp": "04:00:52", "text": "ストリーム、ちょっと待ってください"}, {"type": "subtitle", "time": 14459.59, "timestamp": "04:00:59", "text": "これがLeft for Deadの"}]
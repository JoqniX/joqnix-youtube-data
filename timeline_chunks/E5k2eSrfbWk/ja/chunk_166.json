[{"type": "subtitle", "time": 9966.269, "timestamp": "02:46:06", "text": "もちろんそれが"}, {"type": "subtitle", "time": 9968.99, "timestamp": "02:46:08", "text": "現実はあまりにも悲劇的だ"}, {"type": "subtitle", "time": 9972.15, "timestamp": "02:46:12", "text": "悲劇的ちょっと待って、私は"}, {"type": "subtitle", "time": 9974.07, "timestamp": "02:46:14", "text": "本当の会話をすることの危険性"}, {"type": "subtitle", "time": 9976.59, "timestamp": "02:46:16", "text": "誰かと一緒に"}]
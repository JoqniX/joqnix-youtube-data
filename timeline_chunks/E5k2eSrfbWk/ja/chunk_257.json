[{"type": "subtitle", "time": 15423.87, "timestamp": "04:17:03", "text": "シンボル、ワイヤー、大きなBTを手に入れた"}, {"type": "subtitle", "time": 15426.03, "timestamp": "04:17:06", "text": "大きなボタン、どれがお好みですか？"}, {"type": "subtitle", "time": 15428.51, "timestamp": "04:17:08", "text": "まず、記号、ワイヤー、"}, {"type": "subtitle", "time": 15430.389, "timestamp": "04:17:10", "text": "大きなボタン、それから何？"}, {"type": "subtitle", "time": 15433.149, "timestamp": "04:17:13", "text": "それ以外はシンボルと"}, {"type": "subtitle", "time": 15435.389, "timestamp": "04:17:15", "text": "ボタンの配線を解いて、難しいことをやろう"}, {"type": "subtitle", "time": 15437.349, "timestamp": "04:17:17", "text": "1つは"}, {"type": "subtitle", "time": 15443.83, "timestamp": "04:17:23", "text": "シンボル シンボル はい、わかりました。"}, {"type": "subtitle", "time": 15446.91, "timestamp": "04:17:26", "text": "五芒星は"}, {"type": "subtitle", "time": 15448.309, "timestamp": "04:17:28", "text": "爆弾から"}, {"type": "subtitle", "time": 15451.469, "timestamp": "04:17:31", "text": "以前、ああ、スター、フィルスター"}, {"type": "subtitle", "time": 15458.59, "timestamp": "04:17:38", "text": "はい、それなら高級な3つもですね。"}, {"type": "subtitle", "time": 15461.63, "timestamp": "04:17:41", "text": "そしてスマイリーフェイス"}, {"type": "subtitle", "time": 15464.99, "timestamp": "04:17:44", "text": "はい、それから、えーと何か"}, {"type": "subtitle", "time": 15469.07, "timestamp": "04:17:49", "text": "それは三叉槍のように見える 3つの三叉槍"}, {"type": "subtitle", "time": 15472.71, "timestamp": "04:17:52", "text": "トライデント、あぁ、トライデント、ああ、わかった、それは"}, {"type": "subtitle", "time": 15476.309, "timestamp": "04:17:56", "text": "まるでトライデントのようなロウソク"}, {"type": "subtitle", "time": 15479.229, "timestamp": "04:17:59", "text": "そう、彼らは全員"}]
[{"type": "subtitle", "time": 10205.19, "timestamp": "02:50:05", "text": "[音楽]"}, {"type": "subtitle", "time": 10208.469, "timestamp": "02:50:08", "text": "サプレッサーなので、今はそうではない"}, {"type": "subtitle", "time": 10211.91, "timestamp": "02:50:11", "text": "まるで私がこれらの銃を握っているかのように"}, {"type": "subtitle", "time": 10214.75, "timestamp": "02:50:14", "text": "それが私の気持ちだと分かっています"}, {"type": "subtitle", "time": 10217.79, "timestamp": "02:50:17", "text": "もしかしたら私が間違っているのかもしれないけど、私は"}, {"type": "subtitle", "time": 10234.269, "timestamp": "02:50:34", "text": "じゃあ、いくつか取っておこう"}, {"type": "subtitle", "time": 10237.59, "timestamp": "02:50:37", "text": "銃は4、5種類あれば十分だ"}, {"type": "subtitle", "time": 10240.03, "timestamp": "02:50:40", "text": "そう、それだけ。余計なものは必要ない。"}]
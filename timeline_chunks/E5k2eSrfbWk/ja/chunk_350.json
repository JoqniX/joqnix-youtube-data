[{"type": "subtitle", "time": 21000.19, "timestamp": "05:50:00", "text": "州から州はそれを彼の"}, {"type": "subtitle", "time": 21004.35, "timestamp": "05:50:04", "text": "配信してSMPしたので、うわぁ"}, {"type": "subtitle", "time": 21007.11, "timestamp": "05:50:07", "text": "ミニマップがあるなんてすごいですね"}, {"type": "subtitle", "time": 21009.67, "timestamp": "05:50:09", "text": "牛や豚がどこにいるかを知ることができ、"}, {"type": "subtitle", "time": 21012.868, "timestamp": "05:50:12", "text": "羊はあなたの周りを群れをなして"}, {"type": "subtitle", "time": 21015.67, "timestamp": "05:50:15", "text": "心配する必要のないもの"}, {"type": "subtitle", "time": 21017.708, "timestamp": "05:50:17", "text": "生き残ったものって知ってるでしょ"}, {"type": "subtitle", "time": 21020.548, "timestamp": "05:50:20", "text": "知ってるよ、"}, {"type": "subtitle", "time": 21024.59, "timestamp": "05:50:24", "text": "生存環境意識に関するもの"}, {"type": "subtitle", "time": 21028.31, "timestamp": "05:50:28", "text": "私がプレイしたゲームのように"}, {"type": "subtitle", "time": 21032.91, "timestamp": "05:50:32", "text": "つい最近、フロンティアは待って"}, {"type": "subtitle", "time": 21036.23, "timestamp": "05:50:36", "text": "えっと、フロンティアって何？またサイクルフロンティア？"}, {"type": "subtitle", "time": 21037.19, "timestamp": "05:50:37", "text": "はい"}, {"type": "subtitle", "time": 21039.51, "timestamp": "05:50:39", "text": "サイクルフロンティア、そう、それが私がプレイしているゲームです"}, {"type": "subtitle", "time": 21042.948, "timestamp": "05:50:42", "text": "プレイしたんだけど、ああ、もう、何度も死んでしまったよ"}, {"type": "subtitle", "time": 21045.468, "timestamp": "05:50:45", "text": "そしてそれはまるで"}, {"type": "subtitle", "time": 21049.468, "timestamp": "05:50:49", "text": "生存意識に関するやつですね。"}, {"type": "subtitle", "time": 21052.948, "timestamp": "05:50:52", "text": "こんにちは、お元気ですか？ああ、今来たんですね"}, {"type": "subtitle", "time": 21054.23, "timestamp": "05:50:54", "text": "私は"}]
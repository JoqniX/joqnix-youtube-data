[{"type": "subtitle", "time": 18001.27, "timestamp": "05:00:01", "text": "えっと、爆弾は何個使ったんだっけ？"}, {"type": "subtitle", "time": 18005.47, "timestamp": "05:00:05", "text": "もう一度拡散します。ああ、通信を失ったことを忘れていました。"}, {"type": "subtitle", "time": 18008.99, "timestamp": "05:00:08", "text": "神様、知る必要はないよ、そうさ、俺たちは大成功したんだ"}, {"type": "subtitle", "time": 18011.11, "timestamp": "05:00:11", "text": "えっと、３つ"}, {"type": "subtitle", "time": 18015.11, "timestamp": "05:00:15", "text": "2回 私 あなた 私 2回"}, {"type": "subtitle", "time": 18016.11, "timestamp": "05:00:16", "text": "うん、2つ"}, {"type": "subtitle", "time": 18023.788, "timestamp": "05:00:23", "text": "[音楽]"}, {"type": "subtitle", "time": 18032.83, "timestamp": "05:00:32", "text": "私を死なせないで、私は"}, {"type": "subtitle", "time": 18040.708, "timestamp": "05:00:40", "text": "むしろ私は死んでいる"}, {"type": "subtitle", "time": 18059.15, "timestamp": "05:00:59", "text": "ママ、大丈夫だよ。何か古いもの"}]
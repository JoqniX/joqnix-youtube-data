[{"type": "subtitle", "time": 20220.75, "timestamp": "05:37:00", "text": "では、もう一度私のスケジュールをお伝えします。"}, {"type": "subtitle", "time": 20223.39, "timestamp": "05:37:03", "text": "今の私だから明日明日ストリームは"}, {"type": "subtitle", "time": 20224.548, "timestamp": "05:37:04", "text": "なれ"}, {"type": "subtitle", "time": 20228.31, "timestamp": "05:37:08", "text": "YouTube じゃなくて YouTube じゃなくて Twitch だよ"}, {"type": "subtitle", "time": 20231.27, "timestamp": "05:37:11", "text": "午後4時（インド標準時）のストリームは"}, {"type": "subtitle", "time": 20235.628, "timestamp": "05:37:15", "text": "夕方は私の時間なので、アートをします"}, {"type": "subtitle", "time": 20238.39, "timestamp": "05:37:18", "text": "ストリーム配信"}, {"type": "subtitle", "time": 20242.23, "timestamp": "05:37:22", "text": "Twitch と、そう、そして君たちは"}, {"type": "subtitle", "time": 20246.708, "timestamp": "05:37:26", "text": "土曜日にビクターとのコラボレーションを予定しています"}, {"type": "subtitle", "time": 20250.27, "timestamp": "05:37:30", "text": "今日チャットに参加していた息子は"}, {"type": "subtitle", "time": 20253.83, "timestamp": "05:37:33", "text": "Gen Impactをプレイしていますが、午後5時ちょうどです。"}, {"type": "subtitle", "time": 20257.11, "timestamp": "05:37:37", "text": "それは私のTwitch配信時間の約1時間後です"}, {"type": "subtitle", "time": 20260.11, "timestamp": "05:37:40", "text": "つまり、インド標準時午後5時頃"}, {"type": "subtitle", "time": 20263.628, "timestamp": "05:37:43", "text": "時間 M お母さん、もし何か疑問があれば"}, {"type": "subtitle", "time": 20265.47, "timestamp": "05:37:45", "text": "スケジュールを確認したい場合は"}, {"type": "subtitle", "time": 20268.868, "timestamp": "05:37:48", "text": "スケジュールを確認してください"}, {"type": "subtitle", "time": 20272.23, "timestamp": "05:37:52", "text": "えっと、私はまだそれを経験していません。"}, {"type": "subtitle", "time": 20276.27, "timestamp": "05:37:56", "text": "Twitter は、ツイートを Twitter にピン留めします。"}, {"type": "subtitle", "time": 20279.07, "timestamp": "05:37:59", "text": "もしよろしければ、参加できますよ。"}]
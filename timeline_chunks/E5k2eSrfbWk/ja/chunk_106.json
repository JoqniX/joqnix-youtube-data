[{"type": "subtitle", "time": 6360.229, "timestamp": "01:46:00", "text": "アカウントのスケジュールが公開されました"}, {"type": "subtitle", "time": 6362.43, "timestamp": "01:46:02", "text": "スケジュールは"}, {"type": "subtitle", "time": 6367.109, "timestamp": "01:46:07", "text": "ここでは一般的にあらゆるメッセージを受け取ることができます"}, {"type": "subtitle", "time": 6369.99, "timestamp": "01:46:09", "text": "彼女は睡眠時間のない大金持ちだ"}, {"type": "subtitle", "time": 6392.109, "timestamp": "01:46:32", "text": "何の秋"}, {"type": "subtitle", "time": 6398.109, "timestamp": "01:46:38", "text": "戻って、私に後退してほしいの？男が"}, {"type": "subtitle", "time": 6409.27, "timestamp": "01:46:49", "text": "[音楽]"}]
[{"type": "subtitle", "time": 5342.149, "timestamp": "01:29:02", "text": "それらの船に近づけば"}, {"type": "subtitle", "time": 5344.27, "timestamp": "01:29:04", "text": "十分に近ければダウンロードできる"}, {"type": "subtitle", "time": 5346.189, "timestamp": "01:29:06", "text": "ログを記録し、Vanguardがどこにいるかを調べます"}, {"type": "subtitle", "time": 5358.629, "timestamp": "01:29:18", "text": "まさにその通り"}, {"type": "subtitle", "time": 5362.189, "timestamp": "01:29:22", "text": "最小限の船舶電力で回避する"}, {"type": "subtitle", "time": 5365.669, "timestamp": "01:29:25", "text": "武器のようなシステムは最大限に私たち"}, {"type": "subtitle", "time": 5368.95, "timestamp": "01:29:28", "text": "パワーは、1つまたは2つのBも受け入れます"}, {"type": "subtitle", "time": 5372.629, "timestamp": "01:29:32", "text": "できる限り英語で"}, {"type": "subtitle", "time": 5374.59, "timestamp": "01:29:34", "text": "有効化できます"}, {"type": "subtitle", "time": 5379.229, "timestamp": "01:29:39", "text": "ほとんどのセンターは"}, {"type": "subtitle", "time": 5388.83, "timestamp": "01:29:48", "text": "月曜日に月曜日に彼らは"}, {"type": "subtitle", "time": 5392.629, "timestamp": "01:29:52", "text": "閉じた、おお大蛇よ、これを祝福したまえ"}, {"type": "subtitle", "time": 5395.229, "timestamp": "01:29:55", "text": "私たちがジャナンで歩むことができるように交わり"}, {"type": "subtitle", "time": 5396.59, "timestamp": "01:29:56", "text": "ベロンの"}, {"type": "subtitle", "time": 5399.629, "timestamp": "01:29:59", "text": "魂から飛び出した足音"}]
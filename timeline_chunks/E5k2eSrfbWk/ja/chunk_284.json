[{"type": "subtitle", "time": 17040.788, "timestamp": "04:44:00", "text": "DD それについて言えば、私は聞きたい"}, {"type": "subtitle", "time": 17045.35, "timestamp": "04:44:05", "text": "ddsのロリーの声、うん、賛成"}, {"type": "subtitle", "time": 17050.39, "timestamp": "04:44:10", "text": "D はいつか私たちに見せてくれる"}, {"type": "subtitle", "time": 17058.47, "timestamp": "04:44:18", "text": "[音楽]"}, {"type": "subtitle", "time": 17060.43, "timestamp": "04:44:20", "text": "あなたがどこにいるか教えてください"}, {"type": "subtitle", "time": 17062.35, "timestamp": "04:44:22", "text": "準備はいいですか？はい、準備はいいですか？"}, {"type": "subtitle", "time": 17066.868, "timestamp": "04:44:26", "text": "マニュアル はい、わかりました、始めます"}, {"type": "subtitle", "time": 17071.15, "timestamp": "04:44:31", "text": "すべて金色のもの、新しいもの、2番目"}, {"type": "subtitle", "time": 17074.948, "timestamp": "04:44:34", "text": "試してみて、たくさんのものがある"}, {"type": "subtitle", "time": 17077.708, "timestamp": "04:44:37", "text": "爆破されたので2位です"}, {"type": "subtitle", "time": 17087.47, "timestamp": "04:44:47", "text": "ああ、まずい"}, {"type": "subtitle", "time": 17091.11, "timestamp": "04:44:51", "text": "いや、何があったの？何が起こったの？"}, {"type": "subtitle", "time": 17094.51, "timestamp": "04:44:54", "text": "3つのモデル、シンボルがあります。"}, {"type": "subtitle", "time": 17098.31, "timestamp": "04:44:58", "text": "ビッグバンビッグがあって、それから"}]
[{"type": "subtitle", "time": 15002.11, "timestamp": "04:10:02", "text": "ない"}, {"type": "subtitle", "time": 15003.95, "timestamp": "04:10:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15007.75, "timestamp": "04:10:07", "text": "えっと、待って、あなたに送らなくていいの？"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "コードとか色々、あ、待って、始まったよ"}, {"type": "subtitle", "time": 15012.67, "timestamp": "04:10:12", "text": "待って、あなたは必要ないのがわかりますか"}, {"type": "subtitle", "time": 15017.03, "timestamp": "04:10:17", "text": "今回は、ああ、爆弾ですね"}, {"type": "subtitle", "time": 15019.95, "timestamp": "04:10:19", "text": "うまくスタートしました。"}, {"type": "subtitle", "time": 15025.309, "timestamp": "04:10:25", "text": "ああ、シンボルが見える"}, {"type": "subtitle", "time": 15030.95, "timestamp": "04:10:30", "text": "大きなボタンを押すと、"}, {"type": "subtitle", "time": 15034.95, "timestamp": "04:10:34", "text": "えっと、どちらを先にやりたいですか？"}, {"type": "subtitle", "time": 15040.07, "timestamp": "04:10:40", "text": "えっと、記号をやってみましょう。はい、記号です。"}, {"type": "subtitle", "time": 15042.95, "timestamp": "04:10:42", "text": "はい、キーパッドの話ですが"}, {"type": "subtitle", "time": 15045.429, "timestamp": "04:10:45", "text": "記号を教えてください。大丈夫です。"}, {"type": "subtitle", "time": 15047.99, "timestamp": "04:10:47", "text": "左上から始めると星が待っています"}, {"type": "subtitle", "time": 15050.79, "timestamp": "04:10:50", "text": "待って待って、まずは見た目が"}, {"type": "subtitle", "time": 15055.269, "timestamp": "04:10:55", "text": "E は最も簡単に説明できます。"}]
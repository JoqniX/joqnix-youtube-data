[{"type": "subtitle", "time": 20521.75, "timestamp": "05:42:01", "text": "ストリームApexストリーム実際にプレイしました"}, {"type": "subtitle", "time": 20524.19, "timestamp": "05:42:04", "text": "桜と一緒に"}, {"type": "subtitle", "time": 20528.11, "timestamp": "05:42:08", "text": "アンダーが呼んだので、そのストリーム"}, {"type": "subtitle", "time": 20529.468, "timestamp": "05:42:09", "text": "理事会は"}, {"type": "subtitle", "time": 20532.15, "timestamp": "05:42:12", "text": "今夜アップロードしました。準備ができました。"}, {"type": "subtitle", "time": 20535.27, "timestamp": "05:42:15", "text": "アップロードする必要がある、ただ"}, {"type": "subtitle", "time": 20538.07, "timestamp": "05:42:18", "text": "アップロードするだけ"}, {"type": "subtitle", "time": 20547.468, "timestamp": "05:42:27", "text": "来てくれて、ここに来てくれて本当に"}, {"type": "subtitle", "time": 20549.83, "timestamp": "05:42:29", "text": "本当に本当に本当に本当にいつも通り"}, {"type": "subtitle", "time": 20553.468, "timestamp": "05:42:33", "text": "とても大切なので、お互いに頭を軽く叩き合って温めます"}, {"type": "subtitle", "time": 20555.39, "timestamp": "05:42:35", "text": "そして、"}, {"type": "subtitle", "time": 20559.43, "timestamp": "05:42:39", "text": "あなた、そして私のストリームと私を見ている人"}, {"type": "subtitle", "time": 20562.35, "timestamp": "05:42:42", "text": "また、スト・チャンのストリームを視聴しているスト"}, {"type": "subtitle", "time": 20571.91, "timestamp": "05:42:51", "text": "ウソン、だから私はあなたに最高の幸運を祈っています。"}, {"type": "subtitle", "time": 20574.03, "timestamp": "05:42:54", "text": "良い一日をお過ごしください。"}, {"type": "subtitle", "time": 20577.468, "timestamp": "05:42:57", "text": "幸せでいよう、ポジティブでいよう、いつもそうでいよう"}]
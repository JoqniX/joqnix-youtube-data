[{"type": "subtitle", "time": 7631.669, "timestamp": "02:07:11", "text": "わかった"}, {"type": "subtitle", "time": 7635.95, "timestamp": "02:07:15", "text": "えーと、銃ですね、わかりました、次はGです"}, {"type": "subtitle", "time": 7641.87, "timestamp": "02:07:21", "text": "ゆっくり行くよ、ギバー、4時くらいかな"}, {"type": "subtitle", "time": 7651.27, "timestamp": "02:07:31", "text": "ええ、必要でしょうか"}, {"type": "subtitle", "time": 7655.549, "timestamp": "02:07:35", "text": "ところで、これは良い銃だと聞きました。"}, {"type": "subtitle", "time": 7658.39, "timestamp": "02:07:38", "text": "ハッピーマンデー、そう、ハッピーマンデー"}, {"type": "subtitle", "time": 7666.069, "timestamp": "02:07:46", "text": "まあ、パップ"}, {"type": "subtitle", "time": 7667.629, "timestamp": "02:07:47", "text": "遊ぶ"}, {"type": "subtitle", "time": 7670.99, "timestamp": "02:07:50", "text": "また、水を飲もうと思っています"}, {"type": "subtitle", "time": 7673.79, "timestamp": "02:07:53", "text": "喉の調子が良くない"}, {"type": "subtitle", "time": 7677.589, "timestamp": "02:07:57", "text": "今日私が"}]
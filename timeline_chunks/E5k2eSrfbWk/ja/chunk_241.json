[{"type": "subtitle", "time": 14461.99, "timestamp": "04:01:01", "text": "コラボ配信、うん、パット、まさにそれだよ"}, {"type": "subtitle", "time": 14466.07, "timestamp": "04:01:06", "text": "ストリームで話しているのはコードがモッドだ"}, {"type": "subtitle", "time": 14468.189, "timestamp": "04:01:08", "text": "面目を失う"}, {"type": "subtitle", "time": 14470.59, "timestamp": "04:01:10", "text": "はい、ストリームへようこそ、カイドウさん、お元気ですか？"}, {"type": "subtitle", "time": 14473.389, "timestamp": "04:01:13", "text": "えーと、もし見てみたら"}, {"type": "subtitle", "time": 14476.83, "timestamp": "04:01:16", "text": "説明にはマルチアットリンクがあります"}, {"type": "subtitle", "time": 14479.55, "timestamp": "04:01:19", "text": "待って、本当はこれを送るべきだった"}, {"type": "subtitle", "time": 14483.51, "timestamp": "04:01:23", "text": "待って待ってマルチ何今はい"}, {"type": "subtitle", "time": 14486.51, "timestamp": "04:01:26", "text": "ついさっき本当に"}, {"type": "subtitle", "time": 14488.87, "timestamp": "04:01:28", "text": "それ"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "ああ、いいじゃないか"}, {"type": "subtitle", "time": 14494.75, "timestamp": "04:01:34", "text": "人々、うん、両方"}, {"type": "subtitle", "time": 14497.59, "timestamp": "04:01:37", "text": "POVs、知ってるでしょ、私はただのGピン"}, {"type": "subtitle", "time": 14504.389, "timestamp": "04:01:44", "text": "実際にそうなんです"}, {"type": "subtitle", "time": 14507.429, "timestamp": "04:01:47", "text": "えっと、できる"}, {"type": "subtitle", "time": 14517.67, "timestamp": "04:01:57", "text": "コラボか、それを見る前に退出してしまった。"}]
[{"type": "subtitle", "time": 20401.788, "timestamp": "05:40:01", "text": "今日来たのは誰？"}, {"type": "subtitle", "time": 20406.19, "timestamp": "05:40:06", "text": "ホン、そして、あの人たちのために"}, {"type": "subtitle", "time": 20408.75, "timestamp": "05:40:08", "text": "ストリームを見て、そしてスーパー"}, {"type": "subtitle", "time": 20411.628, "timestamp": "05:40:11", "text": "恥ずかしがり屋で話すのが恥ずかしい"}, {"type": "subtitle", "time": 20415.11, "timestamp": "05:40:15", "text": "私を見て、また"}, {"type": "subtitle", "time": 20417.708, "timestamp": "05:40:17", "text": "視聴する人のために"}, {"type": "subtitle", "time": 20420.548, "timestamp": "05:40:20", "text": "それをアーカイブした後、えっと"}, {"type": "subtitle", "time": 20424.59, "timestamp": "05:40:24", "text": "アップロードしました。ええ、視聴のために。"}, {"type": "subtitle", "time": 20426.83, "timestamp": "05:40:26", "text": "このストリームは本当に大きな意味があり、"}, {"type": "subtitle", "time": 20430.23, "timestamp": "05:40:30", "text": "また、MAA MAA 私は黙ります、ええと、私は"}, {"type": "subtitle", "time": 20431.59, "timestamp": "05:40:31", "text": "作る"}, {"type": "subtitle", "time": 20436.31, "timestamp": "05:40:36", "text": "えっと、AR このストリームは非公開です"}, {"type": "subtitle", "time": 20439.75, "timestamp": "05:40:39", "text": "少し非公開なので、"}, {"type": "subtitle", "time": 20441.628, "timestamp": "05:40:41", "text": "一部を編集して削除"}, {"type": "subtitle", "time": 20444.708, "timestamp": "05:40:44", "text": "ええ、いくつか編集して作ったものを削除しました"}, {"type": "subtitle", "time": 20447.23, "timestamp": "05:40:47", "text": "何か出すよ、ハイハイ"}, {"type": "subtitle", "time": 20451.23, "timestamp": "05:40:51", "text": "えっと、もしかしたら本当にできるかもしれない"}, {"type": "subtitle", "time": 20453.868, "timestamp": "05:40:53", "text": "プライベートで、それからえーと"}, {"type": "subtitle", "time": 20457.708, "timestamp": "05:40:57", "text": "公開ツイッターで何か更新するけど"}]
[{"type": "subtitle", "time": 17340.99, "timestamp": "04:49:00", "text": "いいえ"}, {"type": "subtitle", "time": 17344.43, "timestamp": "04:49:04", "text": "えっと、２、３、４、４列４"}, {"type": "subtitle", "time": 17346.7, "timestamp": "04:49:06", "text": "コラム、ああ、わかった、わかった"}, {"type": "subtitle", "time": 17348.51, "timestamp": "04:49:08", "text": "[音楽]"}, {"type": "subtitle", "time": 17351.23, "timestamp": "04:49:11", "text": "それは"}, {"type": "subtitle", "time": 17354.27, "timestamp": "04:49:14", "text": "私にはCのことが示されていない"}, {"type": "subtitle", "time": 17357.83, "timestamp": "04:49:17", "text": "このマニュアルには"}, {"type": "subtitle", "time": 17360.788, "timestamp": "04:49:20", "text": "角ですが、"}, {"type": "subtitle", "time": 17364.47, "timestamp": "04:49:24", "text": "3番目、待って、1、2、3、4番目のもの、ああ"}, {"type": "subtitle", "time": 17367.27, "timestamp": "04:49:27", "text": "ああ、これは辛い"}, {"type": "subtitle", "time": 17370.51, "timestamp": "04:49:30", "text": "あぁ、えっと、2つ目のサークルはどこだっけ？"}, {"type": "subtitle", "time": 17372.628, "timestamp": "04:49:32", "text": "待って、できないよ、ああ、フリー"}, {"type": "subtitle", "time": 17376.75, "timestamp": "04:49:36", "text": "えーっと、10秒。"}, {"type": "subtitle", "time": 17379.27, "timestamp": "04:49:39", "text": "いいえ、ただ移動してください"}, {"type": "subtitle", "time": 17381.788, "timestamp": "04:49:41", "text": "そうそう"}, {"type": "subtitle", "time": 17387.43, "timestamp": "04:49:47", "text": "はい、そうです。どうすればいいですか？えっと、できません。"}, {"type": "subtitle", "time": 17390.03, "timestamp": "04:49:50", "text": "右に動いて、私は死んでるよ"}, {"type": "subtitle", "time": 17396.67, "timestamp": "04:49:56", "text": "死んでない、またBLアップするよ、これは"}, {"type": "subtitle", "time": 17399.03, "timestamp": "04:49:59", "text": "2回目だけど、公平だよ、だって君は"}]
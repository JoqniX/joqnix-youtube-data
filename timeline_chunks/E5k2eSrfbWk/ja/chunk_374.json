[{"type": "subtitle", "time": 22440.19, "timestamp": "06:14:00", "text": "音楽"}, {"type": "subtitle", "time": 22444.39, "timestamp": "06:14:04", "text": "Jox のような未来、または私の他のものを使用する"}, {"type": "subtitle", "time": 22448.67, "timestamp": "06:14:08", "text": "別名ミュージカル 別名私は購入します"}, {"type": "subtitle", "time": 22452.15, "timestamp": "06:14:12", "text": "たくさんの物とイエスとすべて"}, {"type": "subtitle", "time": 22454.23, "timestamp": "06:14:14", "text": "それは私の"}, {"type": "subtitle", "time": 22457.788, "timestamp": "06:14:17", "text": "夢を微調整したい"}, {"type": "subtitle", "time": 22460.39, "timestamp": "06:14:20", "text": "私は死んだネズミのようになりたい"}, {"type": "subtitle", "time": 22463.67, "timestamp": "06:14:23", "text": "それらを少し調整して、"}, {"type": "subtitle", "time": 22472.23, "timestamp": "06:14:32", "text": "電子機器は、"}, {"type": "subtitle", "time": 22483.15, "timestamp": "06:14:43", "text": "はい、携帯電話はここに必要です"}, {"type": "subtitle", "time": 22484.948, "timestamp": "06:14:44", "text": "キーボードを掃除します。ええ、必要"}, {"type": "subtitle", "time": 22487.468, "timestamp": "06:14:47", "text": "キーボードを掃除して、手話で話しましょう"}, {"type": "subtitle", "time": 22490.11, "timestamp": "06:14:50", "text": "キーボードのクリーニングのためにストリームします。"}, {"type": "subtitle", "time": 22491.788, "timestamp": "06:14:51", "text": "モード"}, {"type": "subtitle", "time": 22495.11, "timestamp": "06:14:55", "text": "うん、そうしよう、今日そうしよう、なぜ"}]
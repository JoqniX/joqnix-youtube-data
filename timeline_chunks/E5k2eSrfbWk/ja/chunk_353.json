[{"type": "subtitle", "time": 21182.83, "timestamp": "05:53:02", "text": "えっと、3つ目は長い方で、使用できます"}, {"type": "subtitle", "time": 21186.75, "timestamp": "05:53:06", "text": "クモの巣を取り除く"}, {"type": "subtitle", "time": 21189.868, "timestamp": "05:53:09", "text": "屋根とか長いものみたいな"}, {"type": "subtitle", "time": 21192.548, "timestamp": "05:53:12", "text": "何かだけど傘は"}, {"type": "subtitle", "time": 21194.59, "timestamp": "05:53:14", "text": "小さいもの、中くらいのもの、そして長いもの"}, {"type": "subtitle", "time": 21196.39, "timestamp": "05:53:16", "text": "ここにはない"}, {"type": "subtitle", "time": 21200.19, "timestamp": "05:53:20", "text": "兄弟、昨日私は「いや」と言ったんだ"}, {"type": "chat", "time": 21201.76, "timestamp": "05:53:21", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "just call it web remover"}, {"type": "subtitle", "time": 21202.19, "timestamp": "05:53:22", "text": "午前3時の配信中に私はこう思う"}, {"type": "subtitle", "time": 21204.99, "timestamp": "05:53:24", "text": "起きていたら、自分の持ち物を掃除しよう"}, {"type": "chat", "time": 21206.904, "timestamp": "05:53:26", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "long broom? made with plastic broom like brush??"}, {"type": "subtitle", "time": 21207.15, "timestamp": "05:53:27", "text": "だから少なくとも手持ちカメラ配信はできる"}, {"type": "subtitle", "time": 21213.19, "timestamp": "05:53:33", "text": "除去完了"}, {"type": "subtitle", "time": 21216.11, "timestamp": "05:53:36", "text": "プラスチック製のほうき、軽いブラシ、そう、それ"}, {"type": "chat", "time": 21228.513, "timestamp": "05:53:48", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "it's a long broom"}, {"type": "subtitle", "time": 21229.11, "timestamp": "05:53:49", "text": "ちょっと待って、ただ"}, {"type": "chat", "time": 21231.087, "timestamp": "05:53:51", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "the extendable one?"}]
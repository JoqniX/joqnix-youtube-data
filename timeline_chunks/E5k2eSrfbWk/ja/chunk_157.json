[{"type": "subtitle", "time": 9426.79, "timestamp": "02:37:06", "text": "神様、じゃあロッジに行きましょう"}, {"type": "subtitle", "time": 9429.15, "timestamp": "02:37:09", "text": "いやいやいやいや"}, {"type": "subtitle", "time": 9431.79, "timestamp": "02:37:11", "text": "待って、私はここにいる"}, {"type": "subtitle", "time": 9434.4, "timestamp": "02:37:14", "text": "宝石時計私の最初の計画"}, {"type": "subtitle", "time": 9441.75, "timestamp": "02:37:21", "text": "じゃあ、アトランタに行きましょう"}, {"type": "subtitle", "time": 9454.67, "timestamp": "02:37:34", "text": "貿易当局が販売する"}, {"type": "subtitle", "time": 9457.469, "timestamp": "02:37:37", "text": "たぶん私はそうするかもしれないし、たぶん私はただ"}, {"type": "subtitle", "time": 9459.309, "timestamp": "02:37:39", "text": "同じ場所へ行く"}, {"type": "subtitle", "time": 9467.469, "timestamp": "02:37:47", "text": "すごい街だと思うよ"}]
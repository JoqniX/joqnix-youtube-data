[{"type": "subtitle", "time": 14222.309, "timestamp": "03:57:02", "text": "えっと、ちょっと待ってください、えっと、確認します"}, {"type": "subtitle", "time": 14228.51, "timestamp": "03:57:08", "text": "こんにちは、MAA、これを見ることができます。"}, {"type": "subtitle", "time": 14231.55, "timestamp": "03:57:11", "text": "マルチとしてストリーミング"}, {"type": "subtitle", "time": 14234.83, "timestamp": "03:57:14", "text": "ストリーム うーうー"}, {"type": "subtitle", "time": 14237.189, "timestamp": "03:57:17", "text": "リンクにアクセスすれば可能です"}, {"type": "subtitle", "time": 14239.99, "timestamp": "03:57:19", "text": "説明 そういう風に見てください"}, {"type": "subtitle", "time": 14243.149, "timestamp": "03:57:23", "text": "状態を有効にするように指示するのを忘れていました"}, {"type": "subtitle", "time": 14245.75, "timestamp": "03:57:25", "text": "彼の修士号なので、彼にはこう伝えます"}, {"type": "subtitle", "time": 14248.95, "timestamp": "03:57:28", "text": "ジャック、準備ができたら教えてね"}, {"type": "subtitle", "time": 14257.309, "timestamp": "03:57:37", "text": "secはC滞在になります。皆さんお元気ですか？"}, {"type": "subtitle", "time": 14261.429, "timestamp": "03:57:41", "text": "はい、こんにちは。マニュアルが必要です。"}, {"type": "subtitle", "time": 14265.51, "timestamp": "03:57:45", "text": "私自身もそうなので、キープをプレイします"}, {"type": "subtitle", "time": 14268.189, "timestamp": "03:57:48", "text": "話をしていて、今日は誰も爆発しない"}, {"type": "subtitle", "time": 14269.429, "timestamp": "03:57:49", "text": "滞在"}, {"type": "subtitle", "time": 14274.67, "timestamp": "03:57:54", "text": "CH みんな元気？私は元気だよ。"}]
[{"type": "subtitle", "time": 15840.55, "timestamp": "04:24:00", "text": "ああ、そうだ、そうだ、分かったからAを押して"}, {"type": "subtitle", "time": 15846.109, "timestamp": "04:24:06", "text": "E が最初で、緑、それからトライデント"}, {"type": "subtitle", "time": 15849.07, "timestamp": "04:24:09", "text": "トライデント、そして"}, {"type": "subtitle", "time": 15852.87, "timestamp": "04:24:12", "text": "はい"}, {"type": "subtitle", "time": 15855.51, "timestamp": "04:24:15", "text": "そして私のゴー、うん、ああ神様、こんにちは、うん"}, {"type": "subtitle", "time": 15859.07, "timestamp": "04:24:19", "text": "やった、次は、えーと、"}, {"type": "subtitle", "time": 15863.03, "timestamp": "04:24:23", "text": "ワイヤー、ワイヤー、何本？"}, {"type": "subtitle", "time": 15867.189, "timestamp": "04:24:27", "text": "青と赤の3本のワイヤーがあります。"}, {"type": "subtitle", "time": 15872.59, "timestamp": "04:24:32", "text": "うん、青と赤の３つだけだよね"}, {"type": "subtitle", "time": 15875.59, "timestamp": "04:24:35", "text": "白、青、赤の配線（赤がない場合は）"}, {"type": "subtitle", "time": 15877.87, "timestamp": "04:24:37", "text": "最後のワイヤーが待っていれば、ワイヤーは"}, {"type": "subtitle", "time": 15882.99, "timestamp": "04:24:42", "text": "最後のワイヤーは白で、赤はありません"}, {"type": "subtitle", "time": 15885.87, "timestamp": "04:24:45", "text": "最後の1つ、最後の1つ、えっと、最後の1つは"}, {"type": "subtitle", "time": 15888.389, "timestamp": "04:24:48", "text": "赤は大丈夫、そうでなければもっと"}, {"type": "subtitle", "time": 15892.07, "timestamp": "04:24:52", "text": "青よりも、そうでなければ最後のカットはしない"}, {"type": "subtitle", "time": 15897.07, "timestamp": "04:24:57", "text": "最後のワイヤー、よし、緑、よし、最後"}]
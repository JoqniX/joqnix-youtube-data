[{"type": "subtitle", "time": 8700.63, "timestamp": "02:25:00", "text": "何かあれば"}, {"type": "subtitle", "time": 8704.349, "timestamp": "02:25:04", "text": "ボー、それはどこにあるの？彼女のところにもないわ。"}, {"type": "subtitle", "time": 8708.83, "timestamp": "02:25:08", "text": "えっ、あれはどこに行ったの？"}, {"type": "subtitle", "time": 8713.75, "timestamp": "02:25:13", "text": "えっ、何？私のゴールデンとレジェンダリーを失ったの？"}, {"type": "subtitle", "time": 8715.91, "timestamp": "02:25:15", "text": "物は"}, {"type": "subtitle", "time": 8717.09, "timestamp": "02:25:17", "text": "消えた"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "[音楽]"}, {"type": "subtitle", "time": 8744.67, "timestamp": "02:25:44", "text": "どうやって"}]
[{"type": "subtitle", "time": 21480.99, "timestamp": "05:58:00", "text": "コラボレーション"}, {"type": "subtitle", "time": 21483.91, "timestamp": "05:58:03", "text": "折り紙のズキと"}, {"type": "subtitle", "time": 21487.39, "timestamp": "05:58:07", "text": "折り紙 まだ開けていません"}, {"type": "subtitle", "time": 21490.03, "timestamp": "05:58:10", "text": "これは素敵です"}, {"type": "subtitle", "time": 21492.91, "timestamp": "05:58:12", "text": "いいですね、ペンとか必要なものをスケッチしましょう"}, {"type": "subtitle", "time": 21501.43, "timestamp": "05:58:21", "text": "実際、ああ、私のコピー"}, {"type": "subtitle", "time": 21506.548, "timestamp": "05:58:26", "text": "すべて、いや、これは"}, {"type": "subtitle", "time": 21509.43, "timestamp": "05:58:29", "text": "連絡先のコピーは実際には"}, {"type": "subtitle", "time": 21514.468, "timestamp": "05:58:34", "text": "やることリストのやつ、毎日の"}, {"type": "subtitle", "time": 21523.788, "timestamp": "05:58:43", "text": "ああ、私の日記、私のジャーナル、あれ"}, {"type": "subtitle", "time": 21535.19, "timestamp": "05:58:55", "text": "このターンオン"}, {"type": "subtitle", "time": 21537.51, "timestamp": "05:58:57", "text": "エアコンはどれくらい"}]
[{"type": "subtitle", "time": 15602.95, "timestamp": "04:20:02", "text": "カウントダウンが4つのタイムを持っているとき"}, {"type": "subtitle", "time": 15608.229, "timestamp": "04:20:08", "text": "どんな位置でも、うん、4つ、おおおおおお"}, {"type": "subtitle", "time": 15618.71, "timestamp": "04:20:18", "text": "クリアしましたか？クリアしましたか？はい、"}, {"type": "subtitle", "time": 15623.99, "timestamp": "04:20:23", "text": "時間を過ごした、気持ちいい、気持ちいい"}, {"type": "subtitle", "time": 15627.07, "timestamp": "04:20:27", "text": "私たちがそこにいたとき、彼らは遊ぼうとしたのを覚えている"}, {"type": "subtitle", "time": 15631.389, "timestamp": "04:20:31", "text": "このゲーム、私は行き詰まってしまったので"}, {"type": "subtitle", "time": 15634.429, "timestamp": "04:20:34", "text": "記号の部分で詰まってしまったのは残念ですね。"}, {"type": "subtitle", "time": 15642.269, "timestamp": "04:20:42", "text": "はい、シンボルを説明するのは難しいです"}, {"type": "subtitle", "time": 15647.02, "timestamp": "04:20:47", "text": "うん、時々"}, {"type": "subtitle", "time": 15648.75, "timestamp": "04:20:48", "text": "[音楽]"}, {"type": "subtitle", "time": 15651.79, "timestamp": "04:20:51", "text": "だから戻ってきた"}, {"type": "subtitle", "time": 15656.55, "timestamp": "04:20:56", "text": "だから、拡散器になりたいですか、それとも"}, {"type": "subtitle", "time": 15658.109, "timestamp": "04:20:58", "text": "マニュアル"}]
[{"type": "subtitle", "time": 22505.67, "timestamp": "06:15:05", "text": "私が必要としているのは、電気技師にいつ尋ねるかです"}, {"type": "subtitle", "time": 22509.03, "timestamp": "06:15:09", "text": "彼は今、私を助けてくれるように直しに来ました"}, {"type": "subtitle", "time": 22512.43, "timestamp": "06:15:12", "text": "拡張機能にはカスタムが3つあります"}, {"type": "subtitle", "time": 22515.15, "timestamp": "06:15:15", "text": "延長ボックスや電源検索"}, {"type": "subtitle", "time": 22519.39, "timestamp": "06:15:19", "text": "「ああ、私はそれを買わなかった」と言える。"}, {"type": "subtitle", "time": 22523.43, "timestamp": "06:15:23", "text": "彼らは私が買ったボー​​ドのようなものを"}, {"type": "subtitle", "time": 22525.548, "timestamp": "06:15:25", "text": "それからスイッチを別々に購入して"}, {"type": "subtitle", "time": 22528.75, "timestamp": "06:15:28", "text": "すべてに大きくて長いCoコードが必要でした"}, {"type": "subtitle", "time": 22532.75, "timestamp": "06:15:32", "text": "そして、それを置けるようにすべて"}, {"type": "subtitle", "time": 22535.59, "timestamp": "06:15:35", "text": "PCがBだった時代"}, {"type": "subtitle", "time": 22538.75, "timestamp": "06:15:38", "text": "えっと、私の私の"}, {"type": "subtitle", "time": 22540.91, "timestamp": "06:15:40", "text": "家、あの"}, {"type": "subtitle", "time": 22544.19, "timestamp": "06:15:44", "text": "位置がとても奇妙だった"}, {"type": "subtitle", "time": 22545.948, "timestamp": "06:15:45", "text": "私が必要としていたポイントは、"}, {"type": "subtitle", "time": 22547.788, "timestamp": "06:15:47", "text": "延長ケーブルと"}, {"type": "subtitle", "time": 22552.11, "timestamp": "06:15:52", "text": "すべてに加えて、私は2つのPCを持っています"}, {"type": "subtitle", "time": 22555.67, "timestamp": "06:15:55", "text": "今は少なくとも"}]
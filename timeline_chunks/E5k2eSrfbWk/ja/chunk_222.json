[{"type": "subtitle", "time": 13323.83, "timestamp": "03:42:03", "text": "スターフィールドに来たらロングに行くかもしれない"}, {"type": "subtitle", "time": 13326.91, "timestamp": "03:42:06", "text": "ストリームだが、おそらく覚えているだろう"}, {"type": "subtitle", "time": 13329.79, "timestamp": "03:42:09", "text": "私の配信のほとんどは2時間か"}, {"type": "subtitle", "time": 13333.189, "timestamp": "03:42:13", "text": "最大3時間、4時間まで、よし。"}, {"type": "subtitle", "time": 13335.55, "timestamp": "03:42:15", "text": "ええ、いくつかのストリームを除いて"}, {"type": "subtitle", "time": 13336.75, "timestamp": "03:42:16", "text": "歌"}, {"type": "subtitle", "time": 13339.83, "timestamp": "03:42:19", "text": "スターフィールドをストリーミング配信する"}, {"type": "subtitle", "time": 13343.429, "timestamp": "03:42:23", "text": "こんにちは、ええ、それで明日私たちは"}, {"type": "subtitle", "time": 13346.229, "timestamp": "03:42:26", "text": "デュエリングをやっている私たちは"}, {"type": "subtitle", "time": 13349.389, "timestamp": "03:42:29", "text": "日本語を勉強するよ、わかった、見てみるよ"}, {"type": "subtitle", "time": 13353.389, "timestamp": "03:42:33", "text": "明日のことについてですが、"}, {"type": "subtitle", "time": 13355.349, "timestamp": "03:42:35", "text": "いくつか確認して、"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "仕上げる"}, {"type": "subtitle", "time": 13360.429, "timestamp": "03:42:40", "text": "うん、じゃあ、来てくれたみんな"}, {"type": "subtitle", "time": 13378.07, "timestamp": "03:42:58", "text": "ようこそ、おかえりなさい"}]
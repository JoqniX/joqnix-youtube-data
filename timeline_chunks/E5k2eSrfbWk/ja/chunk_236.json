[{"type": "subtitle", "time": 14169.87, "timestamp": "03:56:09", "text": "こんにちは、私たちはディンを持っていません"}, {"type": "subtitle", "time": 14171.95, "timestamp": "03:56:11", "text": "肌はそうだ"}, {"type": "subtitle", "time": 14175.309, "timestamp": "03:56:15", "text": "こんにちは、わ"}, {"type": "subtitle", "time": 14182.469, "timestamp": "03:56:22", "text": "こんにちは、ええ、私はあなたが何を考えているのかと思いました"}, {"type": "subtitle", "time": 14184.189, "timestamp": "03:56:24", "text": "実際に私に話しかけていたのですが、私はただ"}, {"type": "subtitle", "time": 14186.59, "timestamp": "03:56:26", "text": "君の配信を見てたなんて気づかなかったよ"}, {"type": "subtitle", "time": 14194.63, "timestamp": "03:56:34", "text": "時間、うん、完全に"}, {"type": "subtitle", "time": 14212.229, "timestamp": "03:56:52", "text": "ソイナ、みんな元気？"}, {"type": "subtitle", "time": 14215.55, "timestamp": "03:56:55", "text": "みんなやってるよ、君たちが参加できることを願ってるよ"}, {"type": "subtitle", "time": 14216.95, "timestamp": "03:56:56", "text": "物"}]
[{"type": "subtitle", "time": 18481.788, "timestamp": "05:08:01", "text": "一番上の行は一番上のものになります"}, {"type": "subtitle", "time": 18485.83, "timestamp": "05:08:05", "text": "上のもの、そう、上のもの、上のもの、どうやって"}, {"type": "subtitle", "time": 18490.99, "timestamp": "05:08:10", "text": "えっと、上の方に点が見えますね"}, {"type": "subtitle", "time": 18493.91, "timestamp": "05:08:13", "text": "上部には、柱と呼ばれるものがあります。"}, {"type": "subtitle", "time": 18497.31, "timestamp": "05:08:17", "text": "ゴーの列のように"}, {"type": "subtitle", "time": 18501.43, "timestamp": "05:08:21", "text": "垂直とは、"}, {"type": "subtitle", "time": 18504.43, "timestamp": "05:08:24", "text": "上下水平方向に進むとき"}, {"type": "subtitle", "time": 18507.628, "timestamp": "05:08:27", "text": "左から右へ 左から右へ はい、はい"}, {"type": "subtitle", "time": 18510.43, "timestamp": "05:08:30", "text": "じゃあ次回はコラムですね。"}, {"type": "subtitle", "time": 18512.948, "timestamp": "05:08:32", "text": "列は垂直で、行は"}, {"type": "subtitle", "time": 18515.788, "timestamp": "05:08:35", "text": "水平水平よし、わかった、わかった"}, {"type": "subtitle", "time": 18519.67, "timestamp": "05:08:39", "text": "そして私はそれを覚えている"}, {"type": "subtitle", "time": 18521.75, "timestamp": "05:08:41", "text": "St、彼は良さそうだ。"}, {"type": "subtitle", "time": 18527.708, "timestamp": "05:08:47", "text": "[音楽]"}, {"type": "subtitle", "time": 18531.15, "timestamp": "05:08:51", "text": "広告はありません"}, {"type": "subtitle", "time": 18533.91, "timestamp": "05:08:53", "text": "観ていたことを考えると、アイデア"}, {"type": "subtitle", "time": 18536.59, "timestamp": "05:08:56", "text": "ちなみに３つの流れ"}]
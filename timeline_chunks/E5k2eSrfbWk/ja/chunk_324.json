[{"type": "subtitle", "time": 19440.07, "timestamp": "05:24:00", "text": "ボタン、そしてボタンに応じて"}, {"type": "subtitle", "time": 19444.868, "timestamp": "05:24:04", "text": "こんな風に送ったって言うべきだ Bo のやつ"}, {"type": "subtitle", "time": 19448.708, "timestamp": "05:24:08", "text": "ああ、そういうやり方なんですね。わかりました。"}, {"type": "subtitle", "time": 19451.91, "timestamp": "05:24:11", "text": "サイモン・セッズのやり方を理解した"}, {"type": "subtitle", "time": 19456.948, "timestamp": "05:24:16", "text": "ああ、私が理解できないこと"}, {"type": "subtitle", "time": 19458.83, "timestamp": "05:24:18", "text": "それは"}, {"type": "subtitle", "time": 19467.99, "timestamp": "05:24:27", "text": "ああ、それで前回は、ええ、待って、"}, {"type": "subtitle", "time": 19470.35, "timestamp": "05:24:30", "text": "CHは私にこう言った"}, {"type": "subtitle", "time": 19473.11, "timestamp": "05:24:33", "text": "えっと、それは何だったっけ？"}, {"type": "subtitle", "time": 19483.47, "timestamp": "05:24:43", "text": "そうそう、私は本当にバカだと思った"}, {"type": "subtitle", "time": 19487.59, "timestamp": "05:24:47", "text": "列は水平方向の行のようで、"}, {"type": "subtitle", "time": 19489.23, "timestamp": "05:24:49", "text": "垂直に、私は"}, {"type": "subtitle", "time": 19491.23, "timestamp": "05:24:51", "text": "[音楽]"}, {"type": "subtitle", "time": 19494.35, "timestamp": "05:24:54", "text": "完了しました。ええ、今回はこれを手に入れます"}, {"type": "subtitle", "time": 19497.19, "timestamp": "05:24:57", "text": "うん、今度こそこれを手に入れるよ"}]
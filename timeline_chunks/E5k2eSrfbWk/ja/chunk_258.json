[{"type": "subtitle", "time": 15483.71, "timestamp": "04:18:03", "text": "同じ行、うんうん、Mだから待って、えっと"}, {"type": "subtitle", "time": 15487.03, "timestamp": "04:18:07", "text": "上から右下へ"}, {"type": "subtitle", "time": 15490.91, "timestamp": "04:18:10", "text": "はい、一番下までクリックしてください"}, {"type": "subtitle", "time": 15493.71, "timestamp": "04:18:13", "text": "トライエント トライエント"}, {"type": "subtitle", "time": 15496.269, "timestamp": "04:18:16", "text": "すべてはそれから"}, {"type": "subtitle", "time": 15499.75, "timestamp": "04:18:19", "text": "笑顔の顔文字"}, {"type": "subtitle", "time": 15503.309, "timestamp": "04:18:23", "text": "３３、そして星は終わった、うん、いいよ"}, {"type": "subtitle", "time": 15507.429, "timestamp": "04:18:27", "text": "ああ神様、今私たちはワイヤーを持っていて"}, {"type": "subtitle", "time": 15510.95, "timestamp": "04:18:30", "text": "左の大きなボタン、えっと、配線をしましょう"}, {"type": "subtitle", "time": 15513.91, "timestamp": "04:18:33", "text": "はい、配線はいくつありますか"}, {"type": "subtitle", "time": 15516.67, "timestamp": "04:18:36", "text": "6本のワイヤーがあるんだけど、教えてほしい？"}, {"type": "subtitle", "time": 15518.71, "timestamp": "04:18:38", "text": "色"}, {"type": "subtitle", "time": 15523.469, "timestamp": "04:18:43", "text": "はい、それで6本のワイヤーがあります。"}, {"type": "subtitle", "time": 15530.109, "timestamp": "04:18:50", "text": "配線は白、青、赤、赤、白です"}, {"type": "subtitle", "time": 15534.389, "timestamp": "04:18:54", "text": "黒、オーケー、あ、ない、えっと"}, {"type": "subtitle", "time": 15539.389, "timestamp": "04:18:59", "text": "いや、えっと、ああ神様、赤人がいる"}]
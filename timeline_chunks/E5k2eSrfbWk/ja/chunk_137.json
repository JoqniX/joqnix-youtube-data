[{"type": "subtitle", "time": 8222.87, "timestamp": "02:17:02", "text": "象徴的。そして、聞かれる前に言っておきますが、私はそうではありませんでした。"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "バンドは実際には行かなかった"}, {"type": "subtitle", "time": 8228.87, "timestamp": "02:17:08", "text": "結構です、交換しましょう。喜んで。"}, {"type": "subtitle", "time": 8232.03, "timestamp": "02:17:12", "text": "持ち運ぶために彼女はたくさんのアイテムを手に入れています"}, {"type": "subtitle", "time": 8235.07, "timestamp": "02:17:15", "text": "私は気分が悪いけど、"}, {"type": "subtitle", "time": 8238.07, "timestamp": "02:17:18", "text": "あなたが必要でした"}, {"type": "subtitle", "time": 8248.27, "timestamp": "02:17:28", "text": "サラはもう運べないわ、ああ"}, {"type": "subtitle", "time": 8250.549, "timestamp": "02:17:30", "text": "神"}, {"type": "subtitle", "time": 8255.19, "timestamp": "02:17:35", "text": "いいね、もうダメだ、もうダメだ、いいよ"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "待って、これをやるよ"}, {"type": "subtitle", "time": 8260.91, "timestamp": "02:17:40", "text": "銃をくれ、そうすれば"}, {"type": "subtitle", "time": 8262.75, "timestamp": "02:17:42", "text": "放っておくよ、捨てるよ"}, {"type": "subtitle", "time": 8273.03, "timestamp": "02:17:53", "text": "君の側から見て彼は大丈夫だろう、私はただ"}]
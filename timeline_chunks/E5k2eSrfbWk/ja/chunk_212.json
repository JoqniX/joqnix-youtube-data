[{"type": "subtitle", "time": 12722.15, "timestamp": "03:32:02", "text": "よし、そうしよう"}, {"type": "subtitle", "time": 12725.269, "timestamp": "03:32:05", "text": "4時間経ったので、もう行こう"}, {"type": "subtitle", "time": 12727.75, "timestamp": "03:32:07", "text": "ミッション、ここで締めくくりたいと思います"}, {"type": "subtitle", "time": 12731.389, "timestamp": "03:32:11", "text": "無理はしたくない"}, {"type": "subtitle", "time": 12733.389, "timestamp": "03:32:13", "text": "大丈夫だといいんだけど、これを終わらせよう"}, {"type": "subtitle", "time": 12734.469, "timestamp": "03:32:14", "text": "クエスト"}, {"type": "subtitle", "time": 12737.269, "timestamp": "03:32:17", "text": "はい、sh はもうアクティブではありません"}, {"type": "subtitle", "time": 12740.269, "timestamp": "03:32:20", "text": "仲間よ、ついにそれをやろう"}, {"type": "subtitle", "time": 12744.349, "timestamp": "03:32:24", "text": "先に栄誉を与えてください、それはエネルギーに合っています"}, {"type": "subtitle", "time": 12747.51, "timestamp": "03:32:27", "text": "少し急上昇したが、今は安定している。"}, {"type": "subtitle", "time": 12750.15, "timestamp": "03:32:30", "text": "何か新しいものが現れましたか？いいえ、"}, {"type": "subtitle", "time": 12752.269, "timestamp": "03:32:32", "text": "以前と同じように、大規模な"}, {"type": "subtitle", "time": 12755.07, "timestamp": "03:32:35", "text": "アーティファクトが追加されると出力されます"}, {"type": "subtitle", "time": 12758.07, "timestamp": "03:32:38", "text": "まるで待っているかのように調和する"}, {"type": "subtitle", "time": 12760.51, "timestamp": "03:32:40", "text": "それは憶測に過ぎないが、私は思う"}, {"type": "subtitle", "time": 12762.79, "timestamp": "03:32:42", "text": "おっしゃる通り、私たちは"}, {"type": "subtitle", "time": 12766.83, "timestamp": "03:32:46", "text": "ここにもっとあります。あなたはこれを獲得しました"}, {"type": "subtitle", "time": 12769.429, "timestamp": "03:32:49", "text": "ようこそ、フルメンバーへ。さあ、始めましょう。"}, {"type": "subtitle", "time": 12771.83, "timestamp": "03:32:51", "text": "正会員として"}, {"type": "subtitle", "time": 12776.59, "timestamp": "03:32:56", "text": "タイムスペースヘルメットコンソールスペースああ、そうしよう"}, {"type": "subtitle", "time": 12778.99, "timestamp": "03:32:58", "text": "さあ、私たちは素晴らしいことを成し遂げるだろう"}]
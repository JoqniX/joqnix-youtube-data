[{"type": "subtitle", "time": 17700.03, "timestamp": "04:55:00", "text": "こんにちは、えっと、黄色いBが1つ、黄色いBが1つ"}, {"type": "subtitle", "time": 17704.47, "timestamp": "04:55:04", "text": "青は黄色に変わります、青に変わります、はい、あなたは"}, {"type": "subtitle", "time": 17706.47, "timestamp": "04:55:06", "text": "赤くする"}, {"type": "subtitle", "time": 17710.868, "timestamp": "04:55:10", "text": "黄色、赤、黄色、待って、強くしよう"}, {"type": "subtitle", "time": 17711.708, "timestamp": "04:55:11", "text": "おお"}, {"type": "subtitle", "time": 17715.948, "timestamp": "04:55:15", "text": "待って、いやいやいや、2つのビープ音は黄色です"}, {"type": "subtitle", "time": 17723.23, "timestamp": "04:55:23", "text": "青、待って、黄色で2回ビープ音が鳴ったら"}, {"type": "subtitle", "time": 17727.07, "timestamp": "04:55:27", "text": "黄色でビープ音が1回鳴る、えっと待って"}, {"type": "subtitle", "time": 17730.548, "timestamp": "04:55:30", "text": "青、そう、だから2回叫んで"}, {"type": "subtitle", "time": 17731.73, "timestamp": "04:55:31", "text": "そして一度"}, {"type": "subtitle", "time": 17733.948, "timestamp": "04:55:33", "text": "[音楽]"}, {"type": "subtitle", "time": 17736.47, "timestamp": "04:55:36", "text": "青"}, {"type": "subtitle", "time": 17739.31, "timestamp": "04:55:39", "text": "えっと、赤、あ、待って待って、変わったよ"}, {"type": "subtitle", "time": 17741.67, "timestamp": "04:55:41", "text": "黄色で1回ビープ音が鳴り、2回ビープ音が鳴りました。"}, {"type": "subtitle", "time": 17743.91, "timestamp": "04:55:43", "text": "ビープ音が鳴る"}, {"type": "subtitle", "time": 17749.35, "timestamp": "04:55:49", "text": "ブルー、ああ、CH di、ああ、神様、D、とても大丈夫"}, {"type": "subtitle", "time": 17752.948, "timestamp": "04:55:52", "text": "えっと、赤を1回、それから黄色を2回"}, {"type": "subtitle", "time": 17755.51, "timestamp": "04:55:55", "text": "赤黄色"}, {"type": "subtitle", "time": 17757.21, "timestamp": "04:55:57", "text": "黄色いウェイト"}, {"type": "subtitle", "time": 17758.43, "timestamp": "04:55:58", "text": "[音楽]"}]
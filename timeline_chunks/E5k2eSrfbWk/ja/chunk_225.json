[{"type": "subtitle", "time": 13504.83, "timestamp": "03:45:04", "text": "見ている、つまり私はもっと行きたい"}, {"type": "subtitle", "time": 13505.79, "timestamp": "03:45:05", "text": "あなた"}, {"type": "subtitle", "time": 13509.11, "timestamp": "03:45:09", "text": "わかってるけど、まとめなきゃいけないんだ。"}, {"type": "subtitle", "time": 13511.269, "timestamp": "03:45:11", "text": "病気になる"}, {"type": "subtitle", "time": 13513.79, "timestamp": "03:45:13", "text": "昨日も同じだった"}, {"type": "subtitle", "time": 13515.67, "timestamp": "03:45:15", "text": "熱棒を使用していると思います"}, {"type": "subtitle", "time": 13517.91, "timestamp": "03:45:17", "text": "GPUか何か"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "神様、これで私は終わりを迎えます"}, {"type": "subtitle", "time": 13523.95, "timestamp": "03:45:23", "text": "ゲームは形なので、私はしたくない"}, {"type": "subtitle", "time": 13527.229, "timestamp": "03:45:27", "text": "シャッフルは、私が辞めたときのように"}, {"type": "subtitle", "time": 13531.63, "timestamp": "03:45:31", "text": "ゲームは文字通り「落ち着いて、クール」って感じ"}, {"type": "subtitle", "time": 13533.71, "timestamp": "03:45:33", "text": "今は"}, {"type": "subtitle", "time": 13536.59, "timestamp": "03:45:36", "text": "それは53のようなものです"}, {"type": "subtitle", "time": 13539.309, "timestamp": "03:45:39", "text": "摂氏"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "ああ、でも私がストリーミングしていたときは、いや、それは"}, {"type": "subtitle", "time": 13547.95, "timestamp": "03:45:47", "text": "9℃か80℃か70℃くらいだった"}]
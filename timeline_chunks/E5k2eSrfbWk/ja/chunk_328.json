[{"type": "subtitle", "time": 19681.03, "timestamp": "05:28:01", "text": "ええ、最近3つ買いました"}, {"type": "subtitle", "time": 19685.23, "timestamp": "05:28:05", "text": "ゲーム…どれだったか忘れちゃった"}, {"type": "subtitle", "time": 19688.27, "timestamp": "05:28:08", "text": "だから、Steamのような感覚が欲しいんです"}, {"type": "subtitle", "time": 19691.868, "timestamp": "05:28:11", "text": "プレゼント企画だったので3つ選びました"}, {"type": "subtitle", "time": 19697.39, "timestamp": "05:28:17", "text": "私が選んだゲームは、えっと、"}, {"type": "subtitle", "time": 19701.83, "timestamp": "05:28:21", "text": "チェックする、えっと、これをどうやってチェックするの？"}, {"type": "subtitle", "time": 19705.91, "timestamp": "05:28:25", "text": "神よ、私はホロウナイトヒューマンフォールを選びました"}, {"type": "subtitle", "time": 19709.27, "timestamp": "05:28:29", "text": "平らでジャンプ"}, {"type": "subtitle", "time": 19713.31, "timestamp": "05:28:33", "text": "キング、そう、自分を苦しめたかったんだ"}, {"type": "subtitle", "time": 19721.23, "timestamp": "05:28:41", "text": "ニース"}, {"type": "subtitle", "time": 19724.628, "timestamp": "05:28:44", "text": "ああ、待って、人間の落下飛行はありますか？"}, {"type": "subtitle", "time": 19726.15, "timestamp": "05:28:46", "text": "私たちはできる"}, {"type": "subtitle", "time": 19729.548, "timestamp": "05:28:49", "text": "えっと、彼を失敗させないように"}, {"type": "subtitle", "time": 19734.75, "timestamp": "05:28:54", "text": "残念ながら、あなたはそうしません、私はそうしません"}, {"type": "subtitle", "time": 19736.59, "timestamp": "05:28:56", "text": "[音楽]"}, {"type": "subtitle", "time": 19738.99, "timestamp": "05:28:58", "text": "悲しいけど、後で解決するよ。"}]
[{"type": "subtitle", "time": 7211.76, "timestamp": "02:00:11", "text": "立ち上がれ、立ち上がれ、立ち上がれ"}, {"type": "subtitle", "time": 7213.589, "timestamp": "02:00:13", "text": "[音楽]"}, {"type": "subtitle", "time": 7216.79, "timestamp": "02:00:16", "text": "うん、土"}, {"type": "subtitle", "time": 7222.75, "timestamp": "02:00:22", "text": "ボール、どうやってそれを手に入れたのか"}, {"type": "subtitle", "time": 7231.189, "timestamp": "02:00:31", "text": "あなたは今日そこにいるでしょう、明日ではなく今日です"}, {"type": "subtitle", "time": 7232.51, "timestamp": "02:00:32", "text": "今日"}]
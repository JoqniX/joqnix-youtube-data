[{"type": "subtitle", "time": 13441.59, "timestamp": "03:44:01", "text": "来てくれて本当にありがとう"}, {"type": "subtitle", "time": 13442.83, "timestamp": "03:44:02", "text": "楽しんでいただけたでしょうか"}, {"type": "subtitle", "time": 13446.189, "timestamp": "03:44:06", "text": "今日はアル、来てくれてありがとう、ホープ"}, {"type": "subtitle", "time": 13447.429, "timestamp": "03:44:07", "text": "楽しんでいただけました"}, {"type": "subtitle", "time": 13450.87, "timestamp": "03:44:10", "text": "本日終了の配信"}, {"type": "subtitle", "time": 13453.87, "timestamp": "03:44:13", "text": "はい"}, {"type": "subtitle", "time": 13457.67, "timestamp": "03:44:17", "text": "でも、開けなくてよかった"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "で"}, {"type": "subtitle", "time": 13462.349, "timestamp": "03:44:22", "text": "配信終了 配信終了 はい、終了します"}, {"type": "subtitle", "time": 13467.229, "timestamp": "03:44:27", "text": "ストリーム配信だって、Starfieldが私のPCを"}, {"type": "subtitle", "time": 13470.79, "timestamp": "03:44:30", "text": "すごく暑くなって、私も同じ気持ちです"}, {"type": "subtitle", "time": 13473.99, "timestamp": "03:44:33", "text": "窒息の瞬間、"}, {"type": "subtitle", "time": 13476.75, "timestamp": "03:44:36", "text": "暑いから呼吸する"}, {"type": "subtitle", "time": 13479.95, "timestamp": "03:44:39", "text": "本当に温かい熱い髪が顔に"}, {"type": "subtitle", "time": 13483.469, "timestamp": "03:44:43", "text": "これはJoy PCキャビネットのものだと思います。"}, {"type": "subtitle", "time": 13485.87, "timestamp": "03:44:45", "text": "足を下に置いたままにすると"}, {"type": "subtitle", "time": 13489.429, "timestamp": "03:44:49", "text": "テーブルが今とても熱い"}, {"type": "subtitle", "time": 13493.55, "timestamp": "03:44:53", "text": "ウルトラ、私のサイトからあなたを追放したらどうですか？"}, {"type": "subtitle", "time": 13496.95, "timestamp": "03:44:56", "text": "ストリーム配信で食べ物を取りに行って食べようとしていた"}]
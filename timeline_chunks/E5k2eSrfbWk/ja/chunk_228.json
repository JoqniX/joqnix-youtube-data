[{"type": "subtitle", "time": 13680.79, "timestamp": "03:48:00", "text": "たぶんそう、いつかそうするよ"}, {"type": "subtitle", "time": 13684.11, "timestamp": "03:48:04", "text": "終わらせたいけど、支払いたくない"}, {"type": "subtitle", "time": 13689.389, "timestamp": "03:48:09", "text": "来月のゲームPなので、私は"}, {"type": "subtitle", "time": 13692.79, "timestamp": "03:48:12", "text": "スピードランでこのゲームをクリアする"}, {"type": "subtitle", "time": 13696.07, "timestamp": "03:48:16", "text": "ASAP できるだけ多くの"}, {"type": "subtitle", "time": 13699.349, "timestamp": "03:48:19", "text": "他にもやり遂げたい夢があるから、うん。"}, {"type": "subtitle", "time": 13702.469, "timestamp": "03:48:22", "text": "とにかく、今は140GBなので、もちろん"}, {"type": "subtitle", "time": 13704.349, "timestamp": "03:48:24", "text": "これは優先リストに追加して完了させる"}, {"type": "subtitle", "time": 13707.55, "timestamp": "03:48:27", "text": "それでは、これを終わらせるためにBをやります。"}, {"type": "subtitle", "time": 13710.389, "timestamp": "03:48:30", "text": "これまで私たちは、もっと探検的なことをしました"}, {"type": "subtitle", "time": 13712.429, "timestamp": "03:48:32", "text": "それは私がしてはいけないことだった"}, {"type": "subtitle", "time": 13714.83, "timestamp": "03:48:34", "text": "時間を無駄にしてしまったが、次回は"}, {"type": "subtitle", "time": 13719.149, "timestamp": "03:48:39", "text": "試してみて、メインだけに行くようにしてみて"}, {"type": "subtitle", "time": 13722.03, "timestamp": "03:48:42", "text": "クエストとメインの内部クエストは、"}, {"type": "subtitle", "time": 13724.269, "timestamp": "03:48:44", "text": "87かそれ以上かかるだろうと分かった"}, {"type": "subtitle", "time": 13725.229, "timestamp": "03:48:45", "text": "よりも"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "セントになるにはあと何時間待てばいいですか？"}, {"type": "subtitle", "time": 13732.389, "timestamp": "03:48:52", "text": "fied ええ、メインストーリーとサイドクエスト"}, {"type": "subtitle", "time": 13734.99, "timestamp": "03:48:54", "text": "47時間かかるので、そうしましょう"}, {"type": "subtitle", "time": 13738.269, "timestamp": "03:48:58", "text": "そうすれば少なくともメインクエストは完了する"}]
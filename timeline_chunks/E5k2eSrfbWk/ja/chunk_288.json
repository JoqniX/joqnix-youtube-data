[{"type": "subtitle", "time": 17281.59, "timestamp": "04:48:01", "text": "コラムトップ"}, {"type": "subtitle", "time": 17285.99, "timestamp": "04:48:05", "text": "列の一番上の列は生命を拡散します"}, {"type": "subtitle", "time": 17288.67, "timestamp": "04:48:08", "text": "赤い…あれ、赤い三角形はどこ？"}, {"type": "subtitle", "time": 17292.31, "timestamp": "04:48:12", "text": "再び赤い三角形"}, {"type": "subtitle", "time": 17298.788, "timestamp": "04:48:18", "text": "3行目は2列目、いや、3列目だ"}, {"type": "subtitle", "time": 17299.948, "timestamp": "04:48:19", "text": "2番"}, {"type": "subtitle", "time": 17304.35, "timestamp": "04:48:24", "text": "行 こんにちは、これはとても"}, {"type": "subtitle", "time": 17307.51, "timestamp": "04:48:27", "text": "難しいですね"}, {"type": "subtitle", "time": 17309.15, "timestamp": "04:48:29", "text": "それで"}, {"type": "subtitle", "time": 17313.99, "timestamp": "04:48:33", "text": "えーと、列はこんな感じです"}, {"type": "subtitle", "time": 17317.03, "timestamp": "04:48:37", "text": "左側に向かって列の右側へ"}, {"type": "subtitle", "time": 17320.11, "timestamp": "04:48:40", "text": "上から下へ、上から下へ、わかりました。"}, {"type": "subtitle", "time": 17320.85, "timestamp": "04:48:40", "text": "4人のコリント人"}, {"type": "subtitle", "time": 17322.35, "timestamp": "04:48:42", "text": "[音楽]"}, {"type": "subtitle", "time": 17325.99, "timestamp": "04:48:45", "text": "4列目は何だろう？"}, {"type": "subtitle", "time": 17326.83, "timestamp": "04:48:46", "text": "あなた"}, {"type": "subtitle", "time": 17329.948, "timestamp": "04:48:49", "text": "複数のものが存在すると言った"}, {"type": "subtitle", "time": 17332.99, "timestamp": "04:48:52", "text": "迷路にあるもの、あー、円"}, {"type": "subtitle", "time": 17336.67, "timestamp": "04:48:56", "text": "丸で囲む、そう、4列目、最後の行"}, {"type": "subtitle", "time": 17339.43, "timestamp": "04:48:59", "text": "残り1分、たった1分だけ。"}]
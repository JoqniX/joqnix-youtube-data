[{"type": "subtitle", "time": 19501.19, "timestamp": "05:25:01", "text": "はい、確かに、私はこれを理解しています"}, {"type": "subtitle", "time": 19503.47, "timestamp": "05:25:03", "text": "[音楽]"}, {"type": "subtitle", "time": 19506.27, "timestamp": "05:25:06", "text": "他に何があるかな"}, {"type": "subtitle", "time": 19509.27, "timestamp": "05:25:09", "text": "このモジュールの主題は"}, {"type": "subtitle", "time": 19512.19, "timestamp": "05:25:12", "text": "パスカードか神様、私はこれが"}, {"type": "subtitle", "time": 19516.07, "timestamp": "05:25:16", "text": "物事は来ない、つまりパスワードは"}, {"type": "subtitle", "time": 19520.03, "timestamp": "05:25:20", "text": "車、特に、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 19520.99, "timestamp": "05:25:20", "text": "えーと"}, {"type": "subtitle", "time": 19523.51, "timestamp": "05:25:23", "text": "待って、これは何？"}, {"type": "subtitle", "time": 19526.788, "timestamp": "05:25:26", "text": "困窮したモジュール"}, {"type": "subtitle", "time": 19529.868, "timestamp": "05:25:29", "text": "地獄の必要モジュールは武装解除できない"}, {"type": "subtitle", "time": 19532.27, "timestamp": "05:25:32", "text": "しかし再発性"}, {"type": "subtitle", "time": 19535.91, "timestamp": "05:25:35", "text": "ハザード、H、よし、戻ってきたよ"}, {"type": "subtitle", "time": 19536.91, "timestamp": "05:25:36", "text": "いらっしゃいませ"}, {"type": "subtitle", "time": 19542.99, "timestamp": "05:25:42", "text": "戻って、DX H 申し訳ありませんが、私は"}, {"type": "subtitle", "time": 19545.83, "timestamp": "05:25:45", "text": "もうこれ以上は見ないでおこうと思う"}, {"type": "subtitle", "time": 19553.03, "timestamp": "05:25:53", "text": "よし、それで"}, {"type": "subtitle", "time": 19556.23, "timestamp": "05:25:56", "text": "ああ、ありがとう"}]
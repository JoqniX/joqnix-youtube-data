[{"type": "subtitle", "time": 18604.67, "timestamp": "05:10:04", "text": "目、ああ、私たちがやったのと同じこと"}, {"type": "subtitle", "time": 18608.75, "timestamp": "05:10:08", "text": "えっと、なんて言うんだっけ、そういうやつ"}, {"type": "subtitle", "time": 18611.75, "timestamp": "05:10:11", "text": "どちらを先にやりたいですか？"}, {"type": "subtitle", "time": 18613.788, "timestamp": "05:10:13", "text": "でもどのモジュールが"}, {"type": "subtitle", "time": 18617.19, "timestamp": "05:10:17", "text": "そこに、あなたは言わなければならない、ああ、行く、行く"}, {"type": "subtitle", "time": 18620.788, "timestamp": "05:10:20", "text": "前方には大きなボタンがあります"}, {"type": "subtitle", "time": 18623.59, "timestamp": "05:10:23", "text": "それからサイモン・セッズとテキスト"}, {"type": "subtitle", "time": 18626.99, "timestamp": "05:10:26", "text": "テキストをどうするか知ってるよね"}, {"type": "subtitle", "time": 18629.788, "timestamp": "05:10:29", "text": "テキストのあれこれ"}, {"type": "subtitle", "time": 18633.39, "timestamp": "05:10:33", "text": "ああ、その件について誰について"}, {"type": "subtitle", "time": 18636.27, "timestamp": "05:10:36", "text": "まずラベルには何と書いてありますか？ラベルには"}, {"type": "subtitle", "time": 18639.91, "timestamp": "05:10:39", "text": "はいはいはい、y"}, {"type": "subtitle", "time": 18644.83, "timestamp": "05:10:44", "text": "わかった、A Y わかった、それで何"}, {"type": "subtitle", "time": 18648.99, "timestamp": "05:10:48", "text": "「何」という言葉は右上にあります"}, {"type": "subtitle", "time": 18651.47, "timestamp": "05:10:51", "text": "ボタンは右と言います"}, {"type": "subtitle", "time": 18657.59, "timestamp": "05:10:57", "text": "待って、わかった、これから読んであげる"}]
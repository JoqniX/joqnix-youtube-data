[{"type": "subtitle", "time": 18243.19, "timestamp": "05:04:03", "text": "E3 a b c d e あ、待って A B C D E わかった fif"}, {"type": "subtitle", "time": 18247.07, "timestamp": "05:04:07", "text": "えーと、最後の最後、オーケー、V、えーと、列、何"}, {"type": "subtitle", "time": 18249.948, "timestamp": "05:04:09", "text": "行番号"}, {"type": "subtitle", "time": 18253.708, "timestamp": "05:04:13", "text": "313 えーと33h わかった"}, {"type": "subtitle", "time": 18257.23, "timestamp": "05:04:17", "text": "わかった、わかった、それで、えーと、何？"}, {"type": "subtitle", "time": 18260.43, "timestamp": "05:04:20", "text": "それを三角形と白と呼ぶ"}, {"type": "subtitle", "time": 18263.27, "timestamp": "05:04:23", "text": "三角形に点を打つと"}, {"type": "subtitle", "time": 18265.628, "timestamp": "05:04:25", "text": "えーと"}, {"type": "subtitle", "time": 18270.39, "timestamp": "05:04:30", "text": "A2 A2 わかった、白はどこ？"}, {"type": "subtitle", "time": 18274.75, "timestamp": "05:04:34", "text": "白い点は"}, {"type": "subtitle", "time": 18279.51, "timestamp": "05:04:39", "text": "F1 F1 オーケー、じゃあ待って、えっと、今からあげなきゃ"}, {"type": "subtitle", "time": 18283.23, "timestamp": "05:04:43", "text": "それはあなたを2番目のサークルまたは"}, {"type": "subtitle", "time": 18287.43, "timestamp": "05:04:47", "text": "白い点から白い点へ、よし、行くぞ"}, {"type": "subtitle", "time": 18291.47, "timestamp": "05:04:51", "text": "左へ、左へ、１、２、３、４、５"}, {"type": "subtitle", "time": 18294.83, "timestamp": "05:04:54", "text": "最後から2番目までの回数"}, {"type": "subtitle", "time": 18298.948, "timestamp": "05:04:58", "text": "1回待って5回。ああ、そうそう。"}]
[{"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "彼らは私の"}, {"type": "subtitle", "time": 6674.149, "timestamp": "01:51:14", "text": "ウィングマン、最後のプレイヤー、新しいロール"}, {"type": "subtitle", "time": 6687.03, "timestamp": "01:51:27", "text": "[音楽]"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "私なの？ああ、救えなかった、できなかった"}, {"type": "subtitle", "time": 6705.7, "timestamp": "01:51:45", "text": "そこへまっすぐ行ってください"}, {"type": "subtitle", "time": 6718.87, "timestamp": "01:51:58", "text": "いくつか必要"}]
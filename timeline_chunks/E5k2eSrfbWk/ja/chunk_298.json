[{"type": "subtitle", "time": 17883.35, "timestamp": "04:58:03", "text": "大丈夫、大丈夫、"}, {"type": "subtitle", "time": 17892.07, "timestamp": "04:58:12", "text": "グッチ、私はお尻を"}, {"type": "subtitle", "time": 17894.91, "timestamp": "04:58:14", "text": "まあ、少なくとも私たちはお互いに吹っ飛ばした"}, {"type": "subtitle", "time": 17900.708, "timestamp": "04:58:20", "text": "少なくとも、それでもあなたは私を2回爆破し、"}, {"type": "subtitle", "time": 17906.67, "timestamp": "04:58:26", "text": "一度、あなたは私にオーラルセックスをしたような気がします"}, {"type": "subtitle", "time": 17909.948, "timestamp": "04:58:29", "text": "もう一度、そして今、私は感じる"}, {"type": "subtitle", "time": 17911.548, "timestamp": "04:58:31", "text": "次は"}, {"type": "subtitle", "time": 17914.47, "timestamp": "04:58:34", "text": "特に"}, {"type": "subtitle", "time": 17917.59, "timestamp": "04:58:37", "text": "メジャー、冗談だよ、私は違う"}, {"type": "subtitle", "time": 17921.15, "timestamp": "04:58:41", "text": "あなたは専門家になるつもりです"}, {"type": "subtitle", "time": 17925.548, "timestamp": "04:58:45", "text": "もう一度、ええと、マニュアル"}, {"type": "subtitle", "time": 17926.83, "timestamp": "04:58:46", "text": "読む"}, {"type": "subtitle", "time": 17934.948, "timestamp": "04:58:54", "text": "はい、ちょっと待ってください、追いつきます"}, {"type": "subtitle", "time": 17939.948, "timestamp": "04:58:59", "text": "チャット私もそうします、はい、こんにちはR"}]
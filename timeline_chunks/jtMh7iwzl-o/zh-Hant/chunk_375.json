[{"type": "subtitle", "time": 22511.59, "timestamp": "06:15:11", "text": "是這台嗎？  等等，他改了嗎？  等等，這是我要找的那個嗎？等等，不是，等等等等等等，哪個"}, {"type": "subtitle", "time": 22512.64, "timestamp": "06:15:12", "text": "是"}, {"type": "subtitle", "time": 22514.27, "timestamp": "06:15:14", "text": "伺服器？"}, {"type": "subtitle", "time": 22521.35, "timestamp": "06:15:21", "text": "嗯？他把它藏起來了嗎？"}, {"type": "subtitle", "time": 22545.99, "timestamp": "06:15:45", "text": "意味著你可以從手機串流到伺服器，"}, {"type": "subtitle", "time": 22549.99, "timestamp": "06:15:49", "text": "然後把伺服器的 URL（也就是你手機串流的伺服器的 URL）作為媒體來源加入 OBS 中。"}, {"type": "subtitle", "time": 22556.47, "timestamp": "06:15:56", "text": "嗯，你可以直接用 OBS"}, {"type": "subtitle", "time": 22559.868, "timestamp": "06:15:59", "text": "串流到這個平台，然後用手機把 URL 送到 OBS，就像這樣。"}]
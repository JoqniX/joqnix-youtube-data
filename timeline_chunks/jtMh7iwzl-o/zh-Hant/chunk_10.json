[{"type": "subtitle", "time": 605.67, "timestamp": "00:10:05", "text": "笨蛋。好的。所以我們做了一個類似"}, {"type": "subtitle", "time": 609.67, "timestamp": "00:10:09", "text": "活動狀態的東西。嗯，比如，"}, {"type": "subtitle", "time": 612.07, "timestamp": "00:10:12", "text": "如果我在休息，它會通知你"}, {"type": "subtitle", "time": 614.63, "timestamp": "00:10:14", "text": "我在休息。它被"}, {"type": "subtitle", "time": 618.31, "timestamp": "00:10:18", "text": "稱為 Sakurasam in respon。是的，我本來應該在"}, {"type": "subtitle", "time": 620.069, "timestamp": "00:10:20", "text": "晚上"}, {"type": "subtitle", "time": 624.069, "timestamp": "00:10:24", "text": "6點開始第二次直播，但我"}, {"type": "subtitle", "time": 627.19, "timestamp": "00:10:27", "text": "昨天睡過頭了。早上6點我起不來，一直撐到凌晨"}, {"type": "subtitle", "time": 628.67, "timestamp": "00:10:28", "text": "5點，"}, {"type": "subtitle", "time": 637.59, "timestamp": "00:10:37", "text": "然後就睡著了。  我當時"}, {"type": "subtitle", "time": 640.35, "timestamp": "00:10:40", "text": "就想，"}, {"type": "subtitle", "time": 643.87, "timestamp": "00:10:43", "text": "我12點半醒了。所以，我"}, {"type": "subtitle", "time": 654.67, "timestamp": "00:10:54", "text": "瘋狂了。好的。我希望使用最新功能創建一個自訂的"}, {"type": "subtitle", "time": 659.829, "timestamp": "00:10:59", "text": "RPC，也就是說，"}]
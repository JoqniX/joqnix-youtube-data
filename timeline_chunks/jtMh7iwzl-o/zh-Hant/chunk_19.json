[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "或者我還挺喜歡那樣的。後來他們把"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "那個東西移除了，Discord API 移除了"}, {"type": "subtitle", "time": 1145.47, "timestamp": "00:19:05", "text": "語音"}, {"type": "subtitle", "time": 1149.43, "timestamp": "00:19:09", "text": "功能，所以我不能再用了，"}, {"type": "subtitle", "time": 1152.47, "timestamp": "00:19:12", "text": "因為我想用它來宣傳別人。不，而且"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "當時很多人都在看這個，所以我"}, {"type": "subtitle", "time": 1156.95, "timestamp": "00:19:16", "text": "就想，我也得把它放到網站上"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "。不，如果有人使用網站"}, {"type": "subtitle", "time": 1163.63, "timestamp": "00:19:23", "text": "連結觀看直播或"}, {"type": "subtitle", "time": 1178.63, "timestamp": "00:19:38", "text": "但這些都只能被"}, {"type": "subtitle", "time": 1180.95, "timestamp": "00:19:40", "text": "視為後端。我不做前端開發"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "。我認為螢幕"}, {"type": "subtitle", "time": 1186.31, "timestamp": "00:19:46", "text": "上顯示的那個活動介面"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "可以看作是前端。"}, {"type": "subtitle", "time": 1193.71, "timestamp": "00:19:53", "text": "所以這很好。其中有一個是好的。  是"}, {"type": "subtitle", "time": 1196.75, "timestamp": "00:19:56", "text": "的。自從我相信"}]
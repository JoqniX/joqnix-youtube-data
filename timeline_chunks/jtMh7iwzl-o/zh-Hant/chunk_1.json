[{"type": "subtitle", "time": 63.59, "timestamp": "00:01:03", "text": "所以，呃，我們將進行 Jokathon 第"}, {"type": "subtitle", "time": 67.03, "timestamp": "00:01:07", "text": "50 天的夜間直播。我知道我們原本"}, {"type": "subtitle", "time": 71.75, "timestamp": "00:01:11", "text": "應該在下午 6 點開始，但我因為…因為我臨時更改了時間，"}, {"type": "subtitle", "time": 82.87, "timestamp": "00:01:22", "text": "而且睡了一整天，所以改了時間。  沒關係。"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "月底了。"}, {"type": "subtitle", "time": 93.63, "timestamp": "00:01:33", "text": "嗯，我們還是把手頭的事情做完吧"}, {"type": "subtitle", "time": 96.87, "timestamp": "00:01:36", "text": "。好的。好的。我們會把手頭上的"}, {"type": "subtitle", "time": 100.27000000000001, "timestamp": "00:01:40", "text": "事情做完，然後"}, {"type": "subtitle", "time": 109.27000000000001, "timestamp": "00:01:49", "text": "可以的話就早點睡覺。如果可以的話，我們會早點睡。  是的，我們"}, {"type": "subtitle", "time": 114.83, "timestamp": "00:01:54", "text": "會"}, {"type": "subtitle", "time": 117.83, "timestamp": "00:01:57", "text": "盡力而為。目前，Billy Billy 的日誌正在"}]
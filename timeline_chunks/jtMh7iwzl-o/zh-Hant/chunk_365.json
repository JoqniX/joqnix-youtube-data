[{"type": "subtitle", "time": 21905.03, "timestamp": "06:05:05", "text": "。所以每個時區都是 JST，對吧？它們都有某種特定的延遲。我離開了嗎？或者我沒有設定等待時間"}, {"type": "subtitle", "time": 21925.35, "timestamp": "06:05:25", "text": "折騰了好久才找到並看到我們，感覺就像它每秒都在崩潰一樣，簡直是在破壞它。"}, {"type": "subtitle", "time": 21927.11, "timestamp": "06:05:27", "text": "這是"}, {"type": "subtitle", "time": 21930.07, "timestamp": "06:05:30", "text": "最重要的事。看看這樣"}, {"type": "subtitle", "time": 21934.03, "timestamp": "06:05:34", "text": "行不行。  哦，美國大拇指二。哦。哦，我們有兩個。  哦，我們拿到縮圖了。哦"}]
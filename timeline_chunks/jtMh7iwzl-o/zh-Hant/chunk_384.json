[{"type": "subtitle", "time": 23051.11, "timestamp": "06:24:11", "text": "或透過手機展示風景一樣。"}, {"type": "subtitle", "time": 23077.67, "timestamp": "06:24:37", "text": "同時，直播甚至還沒開始，或者直播已經"}, {"type": "subtitle", "time": 23080.75, "timestamp": "06:24:40", "text": "中斷了，就像兄弟一樣，好像壞了，或者呃，無法繼續進行之類的"}, {"type": "subtitle", "time": 23085.39, "timestamp": "06:24:45", "text": "。我的天啊。這事也發生在我身上過一次，那天我哭了。我當時就像個話癆。"}]
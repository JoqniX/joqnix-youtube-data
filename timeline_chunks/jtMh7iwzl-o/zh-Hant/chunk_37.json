[{"type": "subtitle", "time": 2222.63, "timestamp": "00:37:02", "text": "離開印度了。那我為什麼要訂購"}, {"type": "subtitle", "time": 2227.47, "timestamp": "00:37:07", "text": "這些"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "我記得。哦，我想起來了。哦，我想起來了。我刪除了"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "那個死亡資料夾，"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "因為我覺得我什麼都不需要了"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "。像個傻瓜一樣。我說了那些話，我受夠了，"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "受苦。"}, {"type": "subtitle", "time": 2275.15, "timestamp": "00:37:55", "text": "所有東西。好的，我們來創建一個新的"}]
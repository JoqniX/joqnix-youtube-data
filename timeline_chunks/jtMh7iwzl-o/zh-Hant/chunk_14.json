[{"type": "subtitle", "time": 841.509, "timestamp": "00:14:01", "text": "。"}, {"type": "chat", "time": 843.271, "timestamp": "00:14:03", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Daamn"}, {"type": "subtitle", "time": 848.629, "timestamp": "00:14:08", "text": "我想實現自動化。"}, {"type": "chat", "time": 848.792, "timestamp": "00:14:08", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "That is actually cool"}, {"type": "subtitle", "time": 850.59, "timestamp": "00:14:10", "text": "所以，我"}, {"type": "subtitle", "time": 853.11, "timestamp": "00:14:13", "text": "不需要“不”，"}, {"type": "subtitle", "time": 857.59, "timestamp": "00:14:17", "text": "我想把"}, {"type": "subtitle", "time": 859.47, "timestamp": "00:14:19", "text": "它應用到 Discord 上。我在 Discord 上以客戶 PC 的身份顯示，我正在同時向多個平台直播等等。另外，如果我"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "在直播過程中休息等等，它也會顯示我的狀態。這也表明我不知道我為什麼需要它。我當時就想，這還挺酷的。我為什麼不那樣做呢？所以"}, {"type": "subtitle", "time": 890.43, "timestamp": "00:14:50", "text": "我決定這麼做。其實沒必要。我很久以前就想這麼做了。我以前為Billy Billy之類的東西做過，但我弄丟了。我不知道。我找不到。  根本找不到。它在哪裡？我以前也這樣做過。我的東西很有地方特色。不，"}, {"type": "subtitle", "time": 894.629, "timestamp": "00:14:54", "text": "不是這個。"}]
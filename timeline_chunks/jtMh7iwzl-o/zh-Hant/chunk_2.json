[{"type": "subtitle", "time": 121.35, "timestamp": "00:02:01", "text": "被記錄。效果不錯，但是日誌會被"}, {"type": "subtitle", "time": 123.35, "timestamp": "00:02:03", "text": "記錄下來。很高興看到"}, {"type": "subtitle", "time": 130.589, "timestamp": "00:02:10", "text": "。我這就去做其他"}, {"type": "subtitle", "time": 139.79, "timestamp": "00:02:19", "text": "需要做的事情。我先把其他該做的事情做完，"}, {"type": "subtitle", "time": 143.589, "timestamp": "00:02:23", "text": "然後就"}, {"type": "subtitle", "time": 148.309, "timestamp": "00:02:28", "text": "準備睡覺。好的。"}, {"type": "subtitle", "time": 151.55, "timestamp": "00:02:31", "text": "首先，既然我在這裡，我"}, {"type": "subtitle", "time": 155.309, "timestamp": "00:02:35", "text": "想我需要…我想我"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "需要檢查一下"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "我需要上傳的所有VS（視覺模擬）到底是什麼。呃，"}, {"type": "subtitle", "time": 165.03, "timestamp": "00:02:45", "text": "今天是第50天。所以我想我需要"}, {"type": "subtitle", "time": 166.99, "timestamp": "00:02:46", "text": "上傳"}, {"type": "subtitle", "time": 169.55, "timestamp": "00:02:49", "text": "昨晚和今天"}, {"type": "subtitle", "time": 172.309, "timestamp": "00:02:52", "text": "早上的內容，不，今天早上的內容剛剛結束。"}, {"type": "subtitle", "time": 175.67000000000002, "timestamp": "00:02:55", "text": "如果我沒記錯的話，昨天我確實上傳了"}, {"type": "subtitle", "time": 178.22899999999998, "timestamp": "00:02:58", "text": "。"}]
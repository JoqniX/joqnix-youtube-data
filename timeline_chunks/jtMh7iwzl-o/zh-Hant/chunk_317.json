[{"type": "subtitle", "time": 19026.708, "timestamp": "05:17:06", "text": "遊戲，哦，對了，我忘了，"}, {"type": "subtitle", "time": 19030.55, "timestamp": "05:17:10", "text": "Sammy 是用那個遊戲製作軟體之類的東西製作的。我的天啊，什麼東西從"}, {"type": "subtitle", "time": 19042.47, "timestamp": "05:17:22", "text": "上面掉下來了？它竟然掉到我的鍵盤上了！什麼鬼？哦。哦。哦。"}, {"type": "subtitle", "time": 19048.628, "timestamp": "05:17:28", "text": "哦。等待。"}, {"type": "subtitle", "time": 19052.47, "timestamp": "05:17:32", "text": "兄弟，成功了嗎"}, {"type": "subtitle", "time": 19055.43, "timestamp": "05:17:35", "text": "？上面"}, {"type": "subtitle", "time": 19057.708, "timestamp": "05:17:37", "text": "有個該死的清單，這到底是怎麼回事？  我桌上有個"}, {"type": "subtitle", "time": 19064.23, "timestamp": "05:17:44", "text": "該死的東西。我的天啊。兄弟。兄弟，快出去。出去。出去。兄弟，不行。  為什麼不能用我的鋼琴鍵盤？  不。"}, {"type": "subtitle", "time": 19068.15, "timestamp": "05:17:48", "text": "啊，等等，等等，"}, {"type": "subtitle", "time": 19070.39, "timestamp": "05:17:50", "text": "等等。我該"}, {"type": "subtitle", "time": 19073.15, "timestamp": "05:17:53", "text": "如何殺死它？等等，我該怎麼殺死"}, {"type": "subtitle", "time": 19076.55, "timestamp": "05:17:56", "text": "它？它看起來很無辜"}, {"type": "subtitle", "time": 19077.868, "timestamp": "05:17:57", "text": "。  啊，兄弟，那裡有隻蜥蜴。哦，我"}]
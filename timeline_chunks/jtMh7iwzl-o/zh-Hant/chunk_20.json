[{"type": "subtitle", "time": 1200.95, "timestamp": "00:20:00", "text": "我可以"}, {"type": "subtitle", "time": 1203.95, "timestamp": "00:20:03", "text": "從信徒那裡得到這一切以來，要做的事情太多了"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "。無論誰加入，無論誰經過？"}, {"type": "subtitle", "time": 1215.87, "timestamp": "00:20:15", "text": "評論了哪些內容？那使得這項工作量非常大"}, {"type": "subtitle", "time": 1219.35, "timestamp": "00:20:19", "text": "。這使得音樂中有很多黑暗的元素可以展現。"}, {"type": "subtitle", "time": 1246.029, "timestamp": "00:20:46", "text": "[音樂]"}, {"type": "subtitle", "time": 1250.31, "timestamp": "00:20:50", "text": "垂直領域。我在[音樂] Sammy 上丟了很多牌。我沒弄丟它們。"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "我本來可以"}]
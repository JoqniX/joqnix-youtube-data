[{"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "还有其他人，我想……"}, {"type": "subtitle", "time": 6670.79, "timestamp": "01:51:10", "text": "很多在孟加拉国。你已经拥有很多了。你"}, {"type": "subtitle", "time": 6673.51, "timestamp": "01:51:13", "text": "因为做了调整，所以加了一点。"}, {"type": "subtitle", "time": 6677.35, "timestamp": "01:51:17", "text": "我想是因为我不得不强迫自己这么做。"}, {"type": "subtitle", "time": 6679.75, "timestamp": "01:51:19", "text": "我自己阅读文档之类的东西"}, {"type": "subtitle", "time": 6683.189, "timestamp": "01:51:23", "text": "现在来说说API的工作原理，以及WebSocket是如何运作的。"}, {"type": "subtitle", "time": 6686.229, "timestamp": "01:51:26", "text": "作品、明显文件、"}, {"type": "subtitle", "time": 6702.589, "timestamp": "01:51:42", "text": "这是什么意思？"}, {"type": "subtitle", "time": 6705.39, "timestamp": "01:51:45", "text": "周末？我不知道，"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "男人。我还是感觉很困惑。"}, {"type": "subtitle", "time": 6711.83, "timestamp": "01:51:51", "text": "我是否应该继续使用英语"}, {"type": "subtitle", "time": 6714.629, "timestamp": "01:51:54", "text": "文学方面的东西，或者我应该不知道"}, {"type": "subtitle", "time": 6716.95, "timestamp": "01:51:56", "text": "该怎么办？我好困惑。我不"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "我知道自己擅长什么。我不知道什么"}]
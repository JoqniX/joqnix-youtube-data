[{"type": "subtitle", "time": 605.67, "timestamp": "00:10:05", "text": "笨蛋。好的。所以我们做了，我做了一个类似的东西"}, {"type": "subtitle", "time": 609.67, "timestamp": "00:10:09", "text": "活动状态之类的东西。嗯，活动如"}, {"type": "subtitle", "time": 612.07, "timestamp": "00:10:12", "text": "如果我休息一下，它会允许你休息。"}, {"type": "subtitle", "time": 614.63, "timestamp": "00:10:14", "text": "请大家知道，我正在休息一段时间。它是"}, {"type": "subtitle", "time": 618.31, "timestamp": "00:10:18", "text": "回应中称为 Sakurasam。是的，我当时"}, {"type": "subtitle", "time": 620.069, "timestamp": "00:10:20", "text": "应该开始这场夜间直播了，"}, {"type": "subtitle", "time": 624.069, "timestamp": "00:10:24", "text": "第二场直播在下午6点，但是啊，我"}, {"type": "subtitle", "time": 627.19, "timestamp": "00:10:27", "text": "昨天睡过头了。 6 号醒不过来"}, {"type": "subtitle", "time": 628.67, "timestamp": "00:10:28", "text": "早上6点"}, {"type": "subtitle", "time": 632.79, "timestamp": "00:10:32", "text": "我一直待到六点。"}, {"type": "subtitle", "time": 637.59, "timestamp": "00:10:37", "text": "一直到凌晨5点，然后我就睡着了。"}, {"type": "subtitle", "time": 640.35, "timestamp": "00:10:40", "text": "我当时就想，我醒来的时候"}, {"type": "subtitle", "time": 643.87, "timestamp": "00:10:43", "text": "12:30所以，我搞砸了时间安排。"}, {"type": "subtitle", "time": 654.67, "timestamp": "00:10:54", "text": "疯狂的。好的。我希望制作一个定制的"}, {"type": "subtitle", "time": 659.829, "timestamp": "00:10:59", "text": "此 RPC 具有最新功能"}]
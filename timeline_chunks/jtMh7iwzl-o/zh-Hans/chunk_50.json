[{"type": "subtitle", "time": 3002.51, "timestamp": "00:50:02", "text": "我觉得时间过得太快了。"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "知道。乔克，我想做什么？告诉"}, {"type": "subtitle", "time": 3017.75, "timestamp": "00:50:17", "text": "我就是那样。你想要什么？我的天啊。"}, {"type": "subtitle", "time": 3018.99, "timestamp": "00:50:18", "text": "你是什​​么"}, {"type": "subtitle", "time": 3025.589, "timestamp": "00:50:25", "text": "[音乐]"}, {"type": "subtitle", "time": 3028.15, "timestamp": "00:50:28", "text": "我的意思是，如果我能寄出去，我会非常高兴的。"}, {"type": "subtitle", "time": 3030.63, "timestamp": "00:50:30", "text": "去网站而不是这个神那里"}, {"type": "subtitle", "time": 3031.39, "timestamp": "00:50:31", "text": "这"}, {"type": "subtitle", "time": 3033.829, "timestamp": "00:50:33", "text": "观点。我心想，谁来检查啊？"}, {"type": "subtitle", "time": 3035.63, "timestamp": "00:50:35", "text": "这"}, {"type": "subtitle", "time": 3038.75, "timestamp": "00:50:38", "text": "卡片？网站是"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "这样好些了吗？网站更好。谁的"}, {"type": "subtitle", "time": 3052.71, "timestamp": "00:50:52", "text": "分数？更新后的正文。所以，理应如此。"}, {"type": "subtitle", "time": 3054.95, "timestamp": "00:50:54", "text": "现在就把它挂上。"}, {"type": "subtitle", "time": 3056.43, "timestamp": "00:50:56", "text": "它应该"}, {"type": "subtitle", "time": 3059.87, "timestamp": "00:50:59", "text": "钩子，但它不是"}]
[{"type": "subtitle", "time": 22323.548, "timestamp": "06:12:03", "text": "等着发工资，呃，月薪"}, {"type": "subtitle", "time": 22327.67, "timestamp": "06:12:07", "text": "我的GitHub也出了问题，所以就先这样吧。我"}, {"type": "subtitle", "time": 22329.868, "timestamp": "06:12:09", "text": "我不认为我之前拍过它"}, {"type": "subtitle", "time": 22333.51, "timestamp": "06:12:13", "text": "尽管。我的GitHub快要崩溃了。你的"}, {"type": "subtitle", "time": 22336.31, "timestamp": "06:12:16", "text": "当前使用费账单是 GitHub 是"}, {"type": "subtitle", "time": 22341.35, "timestamp": "06:12:21", "text": "请您务必按时付款等等。"}, {"type": "subtitle", "time": 22343.59, "timestamp": "06:12:23", "text": "所以这是我散步时常去的地方，"}, {"type": "subtitle", "time": 22346.35, "timestamp": "06:12:26", "text": "现实生活中的步行音频"}, {"type": "subtitle", "time": 22347.948, "timestamp": "06:12:27", "text": "流。"}, {"type": "subtitle", "time": 22351.83, "timestamp": "06:12:31", "text": "我用这个叫“呃，让我”的东西"}, {"type": "subtitle", "time": 22358.27, "timestamp": "06:12:38", "text": "等等，这个"}, {"type": "subtitle", "time": 22360.91, "timestamp": "06:12:40", "text": "嗯，雨伞"}, {"type": "subtitle", "time": 22363.868, "timestamp": "06:12:43", "text": "盒子。是这台吗？"}, {"type": "subtitle", "time": 22374.35, "timestamp": "06:12:54", "text": "等等，这是我要找的那个吗？"}, {"type": "subtitle", "time": 22377.03, "timestamp": "06:12:57", "text": "等等，别等等等等等等等等"}, {"type": "subtitle", "time": 22379.628, "timestamp": "06:12:59", "text": "这是序列"}]
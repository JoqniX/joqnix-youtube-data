[{"type": "subtitle", "time": 18305.75, "timestamp": "05:05:05", "text": "敏感度。哦，我觉得是眼神"}, {"type": "subtitle", "time": 18319.91, "timestamp": "05:05:19", "text": "等等，等等。不，等等。跟踪的紧密程度"}, {"type": "subtitle", "time": 18322.07, "timestamp": "05:05:22", "text": "需要在锁定之前获得"}, {"type": "subtitle", "time": 18324.788, "timestamp": "05:05:24", "text": "定位并停止跟踪？啊，等等。"}, {"type": "subtitle", "time": 18326.788, "timestamp": "05:05:26", "text": "没关系。应该是四。绝不"}, {"type": "subtitle", "time": 18329.67, "timestamp": "05:05:29", "text": "头脑。但我究竟在寻找什么呢？喜欢"}, {"type": "subtitle", "time": 18338.39, "timestamp": "05:05:38", "text": "呃，我该怎么做才能让它在我想要的时候……"}, {"type": "subtitle", "time": 18340.788, "timestamp": "05:05:40", "text": "我就是这样，你仍然可以看到"}, {"type": "subtitle", "time": 18344.75, "timestamp": "05:05:44", "text": "来自其他的内容"}, {"type": "subtitle", "time": 18347.708, "timestamp": "05:05:47", "text": "边。"}, {"type": "subtitle", "time": 18357.39, "timestamp": "05:05:57", "text": "意思是？"}, {"type": "subtitle", "time": 18359.47, "timestamp": "05:05:59", "text": "等待。"}]
[{"type": "subtitle", "time": 23101.47, "timestamp": "06:25:01", "text": "他知道"}, {"type": "subtitle", "time": 23111.35, "timestamp": "06:25:11", "text": "好的。或许应该检查一下你以前用的词。我仍然"}, {"type": "subtitle", "time": 23122.27, "timestamp": "06:25:22", "text": "呃，我想"}, {"type": "subtitle", "time": 23124.788, "timestamp": "06:25:24", "text": "等等，不，不，不，不。我不需要"}, {"type": "subtitle", "time": 23133.75, "timestamp": "06:25:33", "text": "难道我不明白吗？我不明白，我不明白我是什么"}, {"type": "subtitle", "time": 23135.91, "timestamp": "06:25:35", "text": "正在尝试。我的意思是，我明白我的意思。"}, {"type": "subtitle", "time": 23138.868, "timestamp": "06:25:38", "text": "正在尝试。举个例子，看看我是否"}, {"type": "subtitle", "time": 23141.43, "timestamp": "06:25:41", "text": "扫描一下我即将推出的频道"}, {"type": "subtitle", "time": 23144.07, "timestamp": "06:25:44", "text": "它会给我两个任何东西"}, {"type": "subtitle", "time": 23146.47, "timestamp": "06:25:46", "text": "我即将进行的直播数量将"}, {"type": "subtitle", "time": 23149.91, "timestamp": "06:25:49", "text": "请把那个数字写对，但我想要这样"}, {"type": "subtitle", "time": 23152.948, "timestamp": "06:25:52", "text": "你知道如果是两个，那就给"}]
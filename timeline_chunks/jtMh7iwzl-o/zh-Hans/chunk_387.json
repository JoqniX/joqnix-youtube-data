[{"type": "subtitle", "time": 23222.07, "timestamp": "06:27:02", "text": "YouTube。就像我的日程安排表一样。"}, {"type": "subtitle", "time": 23225.11, "timestamp": "06:27:05", "text": "每当我安排直播的时候"}, {"type": "subtitle", "time": 23227.83, "timestamp": "06:27:07", "text": "YouTube，它会显示为即将推出的内容。"}, {"type": "subtitle", "time": 23229.468, "timestamp": "06:27:09", "text": "溪流"}, {"type": "subtitle", "time": 23232.15, "timestamp": "06:27:12", "text": "东西。由于我不懂编程，所以我"}, {"type": "subtitle", "time": 23235.75, "timestamp": "06:27:15", "text": "用代码实现不了。所以，我要……"}, {"type": "subtitle", "time": 23239.868, "timestamp": "06:27:19", "text": "使用方便好用的 Sammy Chan 来做"}, {"type": "subtitle", "time": 23243.19, "timestamp": "06:27:23", "text": "它。好了，这件事办完了。但这很友善"}, {"type": "subtitle", "time": 23245.83, "timestamp": "06:27:25", "text": "就像手册一样。我必须打字"}, {"type": "subtitle", "time": 23247.59, "timestamp": "06:27:27", "text": "一切。"}, {"type": "subtitle", "time": 23250.03, "timestamp": "06:27:30", "text": "提供流媒体"}, {"type": "subtitle", "time": 23253.27, "timestamp": "06:27:33", "text": "标题时间，所有那些东西都太多了"}, {"type": "subtitle", "time": 23256.628, "timestamp": "06:27:36", "text": "所以你是在做自动化，这样我就可以……"}, {"type": "subtitle", "time": 23259.708, "timestamp": "06:27:39", "text": "坐下来放松一下"}, {"type": "subtitle", "time": 23262.99, "timestamp": "06:27:42", "text": "太复杂了，是啊，确实很复杂。"}, {"type": "subtitle", "time": 23266.948, "timestamp": "06:27:46", "text": "你好吗？我一直在看你。"}, {"type": "subtitle", "time": 23269.548, "timestamp": "06:27:49", "text": "Instagram上的东西真是太……"}, {"type": "subtitle", "time": 23272.67, "timestamp": "06:27:52", "text": "很好，你一直在唱歌制作"}]
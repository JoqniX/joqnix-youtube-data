[{"type": "subtitle", "time": 24062.35, "timestamp": "06:41:02", "text": "头脑风暴"}, {"type": "subtitle", "time": 24064.67, "timestamp": "06:41:04", "text": "流而不是"}, {"type": "subtitle", "time": 24081.35, "timestamp": "06:41:21", "text": "哦，天哪，你可别告诉我我"}, {"type": "subtitle", "time": 24095.15, "timestamp": "06:41:35", "text": "向下。等一下。等待。"}, {"type": "subtitle", "time": 24102.788, "timestamp": "06:41:42", "text": "等等，它不在这里。"}, {"type": "subtitle", "time": 24105.51, "timestamp": "06:41:45", "text": "兄弟，这不是“我的天哪”。你在开玩笑吧"}, {"type": "subtitle", "time": 24115.59, "timestamp": "06:41:55", "text": "这里。它去哪儿了？它去哪儿了？"}, {"type": "subtitle", "time": 24117.35, "timestamp": "06:41:57", "text": "它去哪儿了？它去哪儿了？在哪里"}, {"type": "subtitle", "time": 24119.948, "timestamp": "06:41:59", "text": "走了吗？它在哪里？"}]
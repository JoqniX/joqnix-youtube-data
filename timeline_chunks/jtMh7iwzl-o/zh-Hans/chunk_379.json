[{"type": "subtitle", "time": 22741.67, "timestamp": "06:19:01", "text": "我像 Sammy 那样安排了一些东西"}, {"type": "subtitle", "time": 22743.51, "timestamp": "06:19:03", "text": "崩溃了或者出了什么问题。我将无法"}, {"type": "subtitle", "time": 22747.708, "timestamp": "06:19:07", "text": "现在就知道了。我是在外面，对吧？我会"}, {"type": "subtitle", "time": 22750.31, "timestamp": "06:19:10", "text": "在外部，我需要进行端口转发。"}, {"type": "subtitle", "time": 22752.708, "timestamp": "06:19:12", "text": "所有这些恶作剧都是为了"}, {"type": "subtitle", "time": 22756.39, "timestamp": "06:19:16", "text": "不知何故连接到我的桌面，然后你"}, {"type": "subtitle", "time": 22759.75, "timestamp": "06:19:19", "text": "了解远程桌面并能解决问题。泵"}, {"type": "subtitle", "time": 22762.83, "timestamp": "06:19:22", "text": "我在外面的时候打电话。那是"}, {"type": "subtitle", "time": 22768.23, "timestamp": "06:19:28", "text": "大的。所以，这就是为什么我不……"}, {"type": "subtitle", "time": 22771.51, "timestamp": "06:19:31", "text": "不要再延长我的户外直播时间了"}, {"type": "subtitle", "time": 22774.548, "timestamp": "06:19:34", "text": "比1小时还长，以防你永远不知道会发生什么"}, {"type": "subtitle", "time": 22777.35, "timestamp": "06:19:37", "text": "这种情况可能会发生。现在我就像在说话一样"}, {"type": "subtitle", "time": 22780.47, "timestamp": "06:19:40", "text": "欣赏和展示风景或从"}, {"type": "subtitle", "time": 22783.35, "timestamp": "06:19:43", "text": "电话。与此同时，这条溪流甚至都还没干透。"}, {"type": "subtitle", "time": 22786.39, "timestamp": "06:19:46", "text": "直播或类似流媒体已经有人拿走了"}, {"type": "subtitle", "time": 22790.47, "timestamp": "06:19:50", "text": "就像兄弟一样，坏了或者像呃，不是"}, {"type": "subtitle", "time": 22793.67, "timestamp": "06:19:53", "text": "超越之类的。我的天啊。和"}, {"type": "subtitle", "time": 22796.788, "timestamp": "06:19:56", "text": "这事我曾经遇到过一次，那天……"}]
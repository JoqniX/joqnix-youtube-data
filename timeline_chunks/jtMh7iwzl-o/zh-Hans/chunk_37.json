[{"type": "subtitle", "time": 2222.63, "timestamp": "00:37:02", "text": "离开印度。那我为什么要订购呢？"}, {"type": "subtitle", "time": 2224.19, "timestamp": "00:37:04", "text": "和"}, {"type": "subtitle", "time": 2227.47, "timestamp": "00:37:07", "text": "这些"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "我记得。哦，我想起来了。哦，我"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "记住。我删除了那个死亡文件夹"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "因为我当时想，我不需要"}, {"type": "subtitle", "time": 2260.829, "timestamp": "00:37:40", "text": "任何事物"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "不再是了。像个傻瓜一样。我说过"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "痛苦。"}, {"type": "subtitle", "time": 2275.15, "timestamp": "00:37:55", "text": "所有东西。好的，我们来创建一个新的"}]
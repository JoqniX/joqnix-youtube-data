[{"type": "subtitle", "time": 662.91, "timestamp": "00:11:02", "text": "呃，那会是哪一种呢？"}, {"type": "subtitle", "time": 664.43, "timestamp": "00:11:04", "text": "跑步"}, {"type": "subtitle", "time": 670.75, "timestamp": "00:11:10", "text": "本地。嗯，我希望做类似……"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "活动系统"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "我记得的地方，我不记得我做了什么"}, {"type": "subtitle", "time": 683.55, "timestamp": "00:11:23", "text": "过去与"}, {"type": "subtitle", "time": 686.91, "timestamp": "00:11:26", "text": "活动"}, {"type": "subtitle", "time": 689.75, "timestamp": "00:11:29", "text": "各州。我只是进来打个招呼。你好。"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "小心。谢谢光临。"}, {"type": "subtitle", "time": 704.55, "timestamp": "00:11:44", "text": "我不记得了。我不记得我"}]
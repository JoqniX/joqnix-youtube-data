[{"type": "subtitle", "time": 22382.35, "timestamp": "06:13:02", "text": "咦，他到底藏了什么？"}, {"type": "subtitle", "time": 22385.19, "timestamp": "06:13:05", "text": "哦，对啊，我得赞助一下"}, {"type": "subtitle", "time": 22387.91, "timestamp": "06:13:07", "text": "我忘了我得赞助那个人。"}, {"type": "subtitle", "time": 22389.91, "timestamp": "06:13:09", "text": "这样我就只能访问贝拉盒子了。"}, {"type": "subtitle", "time": 22391.948, "timestamp": "06:13:11", "text": "好的，云一，是的，是的"}, {"type": "subtitle", "time": 22395.91, "timestamp": "06:13:15", "text": "是啊，我忘了这事儿了，所以现在更……"}, {"type": "subtitle", "time": 22398.23, "timestamp": "06:13:18", "text": "就像中继服务器一样，这意味着你"}, {"type": "subtitle", "time": 22401.83, "timestamp": "06:13:21", "text": "从你的手机向服务器传输数据"}, {"type": "subtitle", "time": 22406.868, "timestamp": "06:13:26", "text": "你把服务器地址和URL放进去。"}, {"type": "subtitle", "time": 22408.548, "timestamp": "06:13:28", "text": "服务器"}, {"type": "subtitle", "time": 22410.788, "timestamp": "06:13:30", "text": "嗯，你正在从你的流媒体平台观看"}, {"type": "subtitle", "time": 22420.39, "timestamp": "06:13:40", "text": "OBS OBS，嗯，是的，你可以直接使用"}, {"type": "subtitle", "time": 22423.83, "timestamp": "06:13:43", "text": "你的 OBS 要串流到"}, {"type": "subtitle", "time": 22426.948, "timestamp": "06:13:46", "text": "呃，将流媒体传输到平台，然后你使用"}, {"type": "subtitle", "time": 22429.03, "timestamp": "06:13:49", "text": "用你的手机把那东西发送到你的"}, {"type": "subtitle", "time": 22432.31, "timestamp": "06:13:52", "text": "OBS就是这样。哦，等等。 Ghosty，你可以"}, {"type": "subtitle", "time": 22434.948, "timestamp": "06:13:54", "text": "你想这么做就这么做吧。我忘了。是的，"}, {"type": "subtitle", "time": 22437.51, "timestamp": "06:13:57", "text": "你可以这样做。你用的是类似“什么”这样的词"}, {"type": "subtitle", "time": 22439.43, "timestamp": "06:13:59", "text": "你用什么应用来看手机直播？"}]
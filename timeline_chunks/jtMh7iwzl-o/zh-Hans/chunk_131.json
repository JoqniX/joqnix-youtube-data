[{"type": "subtitle", "time": 7880.43, "timestamp": "02:11:20", "text": "说实话，我不知道自己想要什么，但是"}, {"type": "subtitle", "time": 7883.35, "timestamp": "02:11:23", "text": "我多次说过我想要什么"}, {"type": "subtitle", "time": 7892.149, "timestamp": "02:11:32", "text": "正确的？这泵泵声是从哪里传来的？"}, {"type": "subtitle", "time": 7907.31, "timestamp": "02:11:47", "text": "[音乐]"}, {"type": "subtitle", "time": 7915.149, "timestamp": "02:11:55", "text": "能？大家好，猫咪们。欢迎来到"}, {"type": "subtitle", "time": 7917.709, "timestamp": "02:11:57", "text": "溪流。感谢您的关注。"}]
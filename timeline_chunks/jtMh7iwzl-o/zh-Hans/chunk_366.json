[{"type": "subtitle", "time": 21965.788, "timestamp": "06:06:05", "text": "命令？会有任何变化吗？"}, {"type": "subtitle", "time": 21969.27, "timestamp": "06:06:09", "text": "不过，如果接下来的直播作为另一场直播的话……"}, {"type": "subtitle", "time": 21971.31, "timestamp": "06:06:11", "text": "比"}, {"type": "subtitle", "time": 21974.47, "timestamp": "06:06:14", "text": "一？我想我得再做一次。"}, {"type": "subtitle", "time": 21977.43, "timestamp": "06:06:17", "text": "等等，等等，等等，等等，等等。等待，"}, {"type": "subtitle", "time": 21979.59, "timestamp": "06:06:19", "text": "等等，等等，等等。我得到了它。我得到了它。我"}, {"type": "subtitle", "time": 21982.43, "timestamp": "06:06:22", "text": "请把案件陈述书放在这里。"}, {"type": "subtitle", "time": 21986.07, "timestamp": "06:06:26", "text": "它。我的天哪，我太聪明了。我的天啊，"}, {"type": "subtitle", "time": 21987.548, "timestamp": "06:06:27", "text": "我太"}, {"type": "subtitle", "time": 21989.23, "timestamp": "06:06:29", "text": "聪明的。"}, {"type": "subtitle", "time": 21991.59, "timestamp": "06:06:31", "text": "是的，等等，等等，等等，等等。不，不，不"}, {"type": "subtitle", "time": 21995.708, "timestamp": "06:06:35", "text": "不，不，不。等等，等等。"}, {"type": "subtitle", "time": 21999.11, "timestamp": "06:06:39", "text": "嗯，但我们仍然在做我们正在做的事情"}, {"type": "subtitle", "time": 22002.23, "timestamp": "06:06:42", "text": "将这个变量与这个人进行比较。不"}, {"type": "subtitle", "time": 22011.35, "timestamp": "06:06:51", "text": "等等，我们需要数字。我们需要人数。"}, {"type": "subtitle", "time": 22014.708, "timestamp": "06:06:54", "text": "我们都有类似视频身份证的东西"}, {"type": "subtitle", "time": 22018.31, "timestamp": "06:06:58", "text": "变量就像字符串值一样，对吗？"}]
[{"type": "subtitle", "time": 23291.19, "timestamp": "06:28:11", "text": "脑。哦，我又在做什么呢？我忘了。"}, {"type": "subtitle", "time": 23293.468, "timestamp": "06:28:13", "text": "注意力缺陷多动症的典型表现。"}, {"type": "subtitle", "time": 23296.27, "timestamp": "06:28:16", "text": "呃，等等，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 23300.43, "timestamp": "06:28:20", "text": "正在做？我刚才说了什么来着？几分钟前"}, {"type": "subtitle", "time": 23302.868, "timestamp": "06:28:22", "text": "前？我忘了。等等，我想我明白了"}, {"type": "subtitle", "time": 23306.788, "timestamp": "06:28:26", "text": "它。哦，是的。是的。如果等于且"}, {"type": "subtitle", "time": 23310.11, "timestamp": "06:28:30", "text": "大于 1 的"}, {"type": "subtitle", "time": 23321.15, "timestamp": "06:28:41", "text": "然后或等于"}, {"type": "subtitle", "time": 23323.67, "timestamp": "06:28:43", "text": "二。不，"}, {"type": "subtitle", "time": 23326.11, "timestamp": "06:28:46", "text": "[音乐]"}]
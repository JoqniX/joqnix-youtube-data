[{"type": "subtitle", "time": 21001.11, "timestamp": "05:50:01", "text": "正确的。正确的。好的。现在这个变量"}, {"type": "subtitle", "time": 21003.43, "timestamp": "05:50:03", "text": "我们得给它起个名字，对吧？这"}, {"type": "subtitle", "time": 21006.59, "timestamp": "05:50:06", "text": "这将很重要。"}, {"type": "subtitle", "time": 21011.03, "timestamp": "05:50:11", "text": "那么我们就长话短说吧。即将到来的 U"}, {"type": "subtitle", "time": 21022.27, "timestamp": "05:50:22", "text": "[音乐]"}, {"type": "subtitle", "time": 21025.628, "timestamp": "05:50:25", "text": "拇指向上。是的。美国海军"}, {"type": "subtitle", "time": 21027.31, "timestamp": "05:50:27", "text": "拇指。"}, {"type": "subtitle", "time": 21030.27, "timestamp": "05:50:30", "text": "缩略图。"}, {"type": "subtitle", "time": 21038.708, "timestamp": "05:50:38", "text": "缩略图为视频一。好的。"}, {"type": "subtitle", "time": 21045.19, "timestamp": "05:50:45", "text": "猜测。好，就这么办吧。我"}, {"type": "subtitle", "time": 21046.91, "timestamp": "05:50:46", "text": "我想那会的"}, {"type": "subtitle", "time": 21051.628, "timestamp": "05:50:51", "text": "工作。拇指一。二号拇指。拇指"}, {"type": "subtitle", "time": 21055.23, "timestamp": "05:50:55", "text": "三。嗯。"}, {"type": "subtitle", "time": 21059.07, "timestamp": "05:50:59", "text": "是的。拇指四。第四"}]
[{"type": "subtitle", "time": 19022.788, "timestamp": "05:17:02", "text": "再次？不。嗯……游戏制作人。一场游戏"}, {"type": "subtitle", "time": 19024.19, "timestamp": "05:17:04", "text": "制造商，"}, {"type": "subtitle", "time": 19026.708, "timestamp": "05:17:06", "text": "正确的？游戏 哦，是的。是的。它是在……制造的"}, {"type": "subtitle", "time": 19030.55, "timestamp": "05:17:10", "text": "游戏制作。 Sammy是用游戏制作软件制作的。"}, {"type": "subtitle", "time": 19033.99, "timestamp": "05:17:13", "text": "但像主播机器人这样的应用程序"}, {"type": "subtitle", "time": 19037.19, "timestamp": "05:17:17", "text": "这是 Sammy 的另一种替代选择。"}, {"type": "subtitle", "time": 19039.19, "timestamp": "05:17:19", "text": "诸如主播机器人之类的应用程序是"}, {"type": "subtitle", "time": 19042.47, "timestamp": "05:17:22", "text": "像是硬编码一样直接写进去的。是的。"}, {"type": "subtitle", "time": 19045.39, "timestamp": "05:17:25", "text": "他们不使用游戏引擎之类的东西。"}, {"type": "subtitle", "time": 19048.628, "timestamp": "05:17:28", "text": "是的。如果你的问题是这个的话。但是"}, {"type": "subtitle", "time": 19052.47, "timestamp": "05:17:32", "text": "现在的问题是像Sammy这样的应用程序，"}, {"type": "subtitle", "time": 19055.43, "timestamp": "05:17:35", "text": "正确的？问题是，如果它是制造于"}, {"type": "subtitle", "time": 19057.708, "timestamp": "05:17:37", "text": "游戏引擎，它有它的"}, {"type": "subtitle", "time": 19061.27, "timestamp": "05:17:41", "text": "局限性。这就是问题所在。它有"}, {"type": "subtitle", "time": 19064.23, "timestamp": "05:17:44", "text": "非常痛苦的限制。我忘了"}, {"type": "subtitle", "time": 19068.15, "timestamp": "05:17:48", "text": "是哪一个？是的，它确实有。"}, {"type": "subtitle", "time": 19070.39, "timestamp": "05:17:50", "text": "它自身的局限性，对吧？就像我"}, {"type": "subtitle", "time": 19073.15, "timestamp": "05:17:53", "text": "忘了，呃，怎么样了"}, {"type": "subtitle", "time": 19076.55, "timestamp": "05:17:56", "text": "它？这不是我最先想到的。"}, {"type": "subtitle", "time": 19077.868, "timestamp": "05:17:57", "text": "头。"}]
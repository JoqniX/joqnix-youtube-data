[{"type": "subtitle", "time": 20102.11, "timestamp": "05:35:02", "text": "这样做是为了……"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "叽叽喳喳。这也是其中之一"}, {"type": "subtitle", "time": 20106.548, "timestamp": "05:35:06", "text": "我想做的事情。但再说一遍，这是"}, {"type": "subtitle", "time": 20109.708, "timestamp": "05:35:09", "text": "其实没必要。只是"}, {"type": "subtitle", "time": 20113.67, "timestamp": "05:35:13", "text": "我想要的那些多余的小东西"}, {"type": "subtitle", "time": 20117.23, "timestamp": "05:35:17", "text": "尝试去做并学习。所以"}, {"type": "subtitle", "time": 20120.15, "timestamp": "05:35:20", "text": "是的，任何回归我们都需要做"}, {"type": "subtitle", "time": 20122.59, "timestamp": "05:35:22", "text": "不过这件事有点蹊跷。"}, {"type": "subtitle", "time": 20126.03, "timestamp": "05:35:26", "text": "呃，怎么办？该怎么办？什么"}, {"type": "subtitle", "time": 20130.15, "timestamp": "05:35:30", "text": "做？嗯，好的。让我们放置缩略图"}, {"type": "subtitle", "time": 20133.51, "timestamp": "05:35:33", "text": "东西打开了。我们把它禁用掉。好的。"}, {"type": "subtitle", "time": 20135.35, "timestamp": "05:35:35", "text": "你会失望的。哦，是的。哦，等等。这是"}, {"type": "subtitle", "time": 20138.868, "timestamp": "05:35:38", "text": "就是那个。好的。好的。好的。好的。所以，我"}, {"type": "subtitle", "time": 20146.19, "timestamp": "05:35:46", "text": "这。"}, {"type": "subtitle", "time": 20149.67, "timestamp": "05:35:49", "text": "正确的。哦，不是你。是啊。是的。"}, {"type": "subtitle", "time": 20151.67, "timestamp": "05:35:51", "text": "是的。我必须像字符串一样处理它"}, {"type": "subtitle", "time": 20156.11, "timestamp": "05:35:56", "text": "多变的。字符串变量会很麻烦"}, {"type": "subtitle", "time": 20159.23, "timestamp": "05:35:59", "text": "尽管。等待，"}]
[{"type": "subtitle", "time": 27.589, "timestamp": "00:00:27", "text": "好的。一个温暖美好的夜晚，非常棒"}, {"type": "subtitle", "time": 31.589, "timestamp": "00:00:31", "text": "晚安各位。你好。欢迎来到"}, {"type": "subtitle", "time": 33.229, "timestamp": "00:00:33", "text": "乔森日"}, {"type": "subtitle", "time": 40.79, "timestamp": "00:00:40", "text": "我刚才烫伤了舌头。哦，天哪，我"}, {"type": "subtitle", "time": 42.43, "timestamp": "00:00:42", "text": "喝热饮"}, {"type": "subtitle", "time": 50.27, "timestamp": "00:00:50", "text": "舌头。该死。"}, {"type": "subtitle", "time": 52.35, "timestamp": "00:00:52", "text": "好的。"}, {"type": "subtitle", "time": 59.99, "timestamp": "00:00:59", "text": "再次？欢迎迪奥。"}]
[{"type": "subtitle", "time": 1200.95, "timestamp": "00:20:00", "text": "既然现在我相信可以做到，那就去做吧。"}, {"type": "subtitle", "time": 1203.95, "timestamp": "00:20:03", "text": "所有这些来自信徒的事"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "现在。无论谁加入，无论谁路过？"}, {"type": "subtitle", "time": 1210.59, "timestamp": "00:20:10", "text": "是什么"}, {"type": "subtitle", "time": 1215.87, "timestamp": "00:20:15", "text": "评论了吗？这使得工作量变得非常大"}, {"type": "subtitle", "time": 1219.35, "timestamp": "00:20:19", "text": "做。这就导致了很多黑暗面。"}, {"type": "subtitle", "time": 1246.029, "timestamp": "00:20:46", "text": "[音乐]"}, {"type": "subtitle", "time": 1250.31, "timestamp": "00:20:50", "text": "垂直的。我丢了很多牌组"}, {"type": "subtitle", "time": 1251.52, "timestamp": "00:20:51", "text": "在"}, {"type": "subtitle", "time": 1254.11, "timestamp": "00:20:54", "text": "[音乐]"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "萨米。我没弄丢它们。我本可以"}]
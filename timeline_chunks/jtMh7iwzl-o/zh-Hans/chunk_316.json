[{"type": "subtitle", "time": 18963.15, "timestamp": "05:16:03", "text": "我桌子上有个该死的东西。哦，我的"}, {"type": "subtitle", "time": 18966.91, "timestamp": "05:16:06", "text": "上帝。兄弟。兄弟，快出去。出去。得到"}, {"type": "subtitle", "time": 18969.23, "timestamp": "05:16:09", "text": "出去。兄弟，不行。"}, {"type": "subtitle", "time": 18972.788, "timestamp": "05:16:12", "text": "为什么不要进入我的键盘？"}, {"type": "subtitle", "time": 18974.67, "timestamp": "05:16:14", "text": "钢琴？"}, {"type": "subtitle", "time": 18977.11, "timestamp": "05:16:17", "text": "不。啊，等等，等等，等等。我该怎么做？"}, {"type": "subtitle", "time": 18978.788, "timestamp": "05:16:18", "text": "我该如何杀死它？等等，我该怎么做？"}, {"type": "subtitle", "time": 18981.23, "timestamp": "05:16:21", "text": "杀了它？它看起来很无辜。"}, {"type": "subtitle", "time": 18984.19, "timestamp": "05:16:24", "text": "啊，兄弟，那儿有个"}, {"type": "subtitle", "time": 18987.51, "timestamp": "05:16:27", "text": "蜥蜴。哦，我没有，我没有进入"}, {"type": "subtitle", "time": 18990.9, "timestamp": "05:16:30", "text": "就在我的绘图板里面。"}, {"type": "subtitle", "time": 18992.67, "timestamp": "05:16:32", "text": "[音乐]"}, {"type": "subtitle", "time": 18996.55, "timestamp": "05:16:36", "text": "哦，这到底是怎么回事？它到底在哪儿？"}, {"type": "subtitle", "time": 19002.39, "timestamp": "05:16:42", "text": "好的。总之，我们被其他事情分散了注意力。"}, {"type": "subtitle", "time": 19005.23, "timestamp": "05:16:45", "text": "这个小呃"}, {"type": "subtitle", "time": 19009.59, "timestamp": "05:16:49", "text": "蜥蜴。我的天啊。总之，嗯，欢迎。"}, {"type": "subtitle", "time": 19011.51, "timestamp": "05:16:51", "text": "面包。欢迎来到直播间。是的。"}, {"type": "subtitle", "time": 19015.35, "timestamp": "05:16:55", "text": "呃呃，萨米是在……嗯，那是什么来着？"}, {"type": "subtitle", "time": 19018.11, "timestamp": "05:16:58", "text": "叫什么？游戏引擎。它叫什么？"}]
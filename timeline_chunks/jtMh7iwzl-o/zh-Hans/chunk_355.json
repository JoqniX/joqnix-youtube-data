[{"type": "subtitle", "time": 21302.67, "timestamp": "05:55:02", "text": "所以，是5000毫秒。"}, {"type": "subtitle", "time": 21311.88, "timestamp": "05:55:11", "text": "从？什么是"}, {"type": "subtitle", "time": 21314.91, "timestamp": "05:55:14", "text": "[音乐]"}, {"type": "subtitle", "time": 21318.31, "timestamp": "05:55:18", "text": "这？别告诉我这是来自哪里"}, {"type": "subtitle", "time": 21321.43, "timestamp": "05:55:21", "text": "我的天哪。别告诉我那是我"}, {"type": "subtitle", "time": 21326.99, "timestamp": "05:55:26", "text": "并非我想的那样。"}, {"type": "subtitle", "time": 21329.59, "timestamp": "05:55:29", "text": "正确的。这是第一条流。"}, {"type": "subtitle", "time": 21331.07, "timestamp": "05:55:31", "text": "[音乐]"}, {"type": "subtitle", "time": 21333.91, "timestamp": "05:55:33", "text": "好的。所以，这里有两样东西。一个是"}, {"type": "subtitle", "time": 21335.67, "timestamp": "05:55:35", "text": "我的晨间直播，其次是"}, {"type": "subtitle", "time": 21338.868, "timestamp": "05:55:38", "text": "安排直播。是的。日程安排和"}, {"type": "subtitle", "time": 21340.35, "timestamp": "05:55:40", "text": "晨潺潺。"}, {"type": "subtitle", "time": 21343.83, "timestamp": "05:55:43", "text": "好的。那么，我到底哪里做错了呢？"}, {"type": "subtitle", "time": 21347.788, "timestamp": "05:55:47", "text": "像这样胡闹？我去了哪里？"}, {"type": "subtitle", "time": 21351.19, "timestamp": "05:55:51", "text": "错误的？缩略图一。我们确实取了个名字"}, {"type": "subtitle", "time": 21353.51, "timestamp": "05:55:53", "text": "确实如此，对吧？"}, {"type": "subtitle", "time": 21356.99, "timestamp": "05:55:56", "text": "是的，我们确实放弃了名字。"}, {"type": "subtitle", "time": 21359.07, "timestamp": "05:55:59", "text": "然后。什么是"}]
[{"type": "subtitle", "time": 22622.548, "timestamp": "06:17:02", "text": "例如，如果我使用云服务的话"}, {"type": "subtitle", "time": 22625.51, "timestamp": "06:17:05", "text": "现在我需要把我的东西放在 OBS 里，比如"}, {"type": "subtitle", "time": 22628.11, "timestamp": "06:17:08", "text": "直播萨米的东西"}, {"type": "subtitle", "time": 22630.948, "timestamp": "06:17:10", "text": "Streamboard 所有这些应用程序"}, {"type": "subtitle", "time": 22633.27, "timestamp": "06:17:13", "text": "现在哪个连接到连接到"}, {"type": "subtitle", "time": 22636.47, "timestamp": "06:17:16", "text": "OBS 对吧，它会做这些事"}, {"type": "subtitle", "time": 22639.19, "timestamp": "06:17:19", "text": "自动正确 我需要这些"}, {"type": "subtitle", "time": 22640.788, "timestamp": "06:17:20", "text": "对，我忘了还有个……"}, {"type": "subtitle", "time": 22644.43, "timestamp": "06:17:24", "text": "网站上好像价值1000美元或"}, {"type": "subtitle", "time": 22646.11, "timestamp": "06:17:26", "text": "某物"}, {"type": "subtitle", "time": 22649.43, "timestamp": "06:17:29", "text": "一个月，或者我不。"}, {"type": "subtitle", "time": 22652.35, "timestamp": "06:17:32", "text": "我忘了。是90美元吗？"}, {"type": "subtitle", "time": 22655.27, "timestamp": "06:17:35", "text": "100美元？是啊，有点贵。"}, {"type": "subtitle", "time": 22658.39, "timestamp": "06:17:38", "text": "但它就像是高级套装里的一样。喜欢"}, {"type": "subtitle", "time": 22661.27, "timestamp": "06:17:41", "text": "套件一就像是基本的东西"}, {"type": "subtitle", "time": 22664.31, "timestamp": "06:17:44", "text": "就像在云端运行的 OBS 一样。你远程"}, {"type": "subtitle", "time": 22666.47, "timestamp": "06:17:46", "text": "桌面已连接，设置场景和"}, {"type": "subtitle", "time": 22669.83, "timestamp": "06:17:49", "text": "一切都是他们为你安排的，或者他们会为你布置场景。"}, {"type": "subtitle", "time": 22672.39, "timestamp": "06:17:52", "text": "然后你通过 OBS 或"}, {"type": "subtitle", "time": 22674.548, "timestamp": "06:17:54", "text": "分享流媒体密钥并进行设置。"}, {"type": "subtitle", "time": 22677.75, "timestamp": "06:17:57", "text": "并保持这种运行状态。"}]
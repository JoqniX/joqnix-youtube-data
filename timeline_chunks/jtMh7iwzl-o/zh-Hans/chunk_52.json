[{"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "男人。我应该开发一款手机应用吗？"}, {"type": "subtitle", "time": 3140.23, "timestamp": "00:52:20", "text": "某物？我不知道。我该如何做？"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "设备？我怎样才能拥有终极"}, {"type": "subtitle", "time": 3165.71, "timestamp": "00:52:45", "text": "每款游戏都有"}, {"type": "subtitle", "time": 3168.51, "timestamp": "00:52:48", "text": "我想要这个"}, {"type": "subtitle", "time": 3172.549, "timestamp": "00:52:52", "text": "模式。运动健将的短吻。我想说我的链接和"}, {"type": "subtitle", "time": 3175.27, "timestamp": "00:52:55", "text": "个人资料之类的。朋友们会玩"}]
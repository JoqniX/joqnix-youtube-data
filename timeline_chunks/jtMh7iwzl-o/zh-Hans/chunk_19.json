[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "或者我挺喜欢那样的，我觉得他们"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "移除了那个东西，Discord API 已移除"}, {"type": "subtitle", "time": 1145.47, "timestamp": "00:19:05", "text": "那个声音"}, {"type": "subtitle", "time": 1149.43, "timestamp": "00:19:09", "text": "那玩意儿，所以我再也用不了了。"}, {"type": "subtitle", "time": 1152.47, "timestamp": "00:19:12", "text": "因为我想帮帮别人。不，而且"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "我当时同时在看这个节目。"}, {"type": "subtitle", "time": 1156.95, "timestamp": "00:19:16", "text": "就像我必须把它放到网站上一样"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "也。不，如果有人正在使用该网站的话。"}, {"type": "subtitle", "time": 1163.63, "timestamp": "00:19:23", "text": "观看直播的链接或"}, {"type": "subtitle", "time": 1178.63, "timestamp": "00:19:38", "text": "我知道，但这些都只能是"}, {"type": "subtitle", "time": 1180.95, "timestamp": "00:19:40", "text": "被视为后端。我不是"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "做前端开发。我认为"}, {"type": "subtitle", "time": 1186.31, "timestamp": "00:19:46", "text": "活动装置，显示在"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "可以看作是前端的屏幕。"}, {"type": "subtitle", "time": 1193.71, "timestamp": "00:19:53", "text": "所以这很好。其中有一个是好的。"}, {"type": "subtitle", "time": 1196.75, "timestamp": "00:19:56", "text": "是的。有很多东西……"}]
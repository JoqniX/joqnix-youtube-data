[{"type": "subtitle", "time": 21600.91, "timestamp": "06:00:00", "text": "哦，它"}, {"type": "subtitle", "time": 21604.708, "timestamp": "06:00:04", "text": "作品。好的，目前为止一切顺利。二"}, {"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "流。好了，现在到了重头戏。"}, {"type": "subtitle", "time": 21610.83, "timestamp": "06:00:10", "text": "部分。啊，"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "男生。这"}, {"type": "subtitle", "time": 21615.548, "timestamp": "06:00:15", "text": "男。我的天哪。哦"}, {"type": "subtitle", "time": 21622.948, "timestamp": "06:00:22", "text": "你？呃，我们可以把那些关掉。但"}, {"type": "subtitle", "time": 21625.75, "timestamp": "06:00:25", "text": "对，就是这家伙。嗯？让我们改变这一点"}, {"type": "subtitle", "time": 21628.868, "timestamp": "06:00:28", "text": "达到7000的时间。没关系。喜欢"}, {"type": "subtitle", "time": 21632.15, "timestamp": "06:00:32", "text": "再说一遍，7000毫秒就像……"}, {"type": "subtitle", "time": 21635.51, "timestamp": "06:00:35", "text": "几秒钟，对吧？再说一遍，我们不需要"}, {"type": "subtitle", "time": 21637.91, "timestamp": "06:00:37", "text": "它每2分钟工作一次，或者"}, {"type": "subtitle", "time": 21641.15, "timestamp": "06:00:41", "text": "某物。我们可以做到最多15个"}, {"type": "subtitle", "time": 21643.07, "timestamp": "06:00:43", "text": "分钟。"}, {"type": "subtitle", "time": 21648.15, "timestamp": "06:00:48", "text": "呃，女士。是的。是的。所以，7000毫秒"}, {"type": "subtitle", "time": 21649.628, "timestamp": "06:00:49", "text": "等于"}, {"type": "subtitle", "time": 21653.67, "timestamp": "06:00:53", "text": "0 呃，实际上只有7秒钟。"}, {"type": "subtitle", "time": 21655.67, "timestamp": "06:00:55", "text": "我们甚至可以把它缩短到一分钟。没关系。"}, {"type": "subtitle", "time": 21658.43, "timestamp": "06:00:58", "text": "但我们会调整延误时间。"}]
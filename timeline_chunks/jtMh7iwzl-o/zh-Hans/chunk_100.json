[{"type": "subtitle", "time": 6000.87, "timestamp": "01:40:00", "text": "老天，我得冷静下来，兄弟。我必须"}, {"type": "subtitle", "time": 6004.189, "timestamp": "01:40:04", "text": "稳定的。为什么我会这样"}, {"type": "chat", "time": 6006.597, "timestamp": "01:40:06", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ig she wanted to do literature\\"}, {"type": "subtitle", "time": 6008.27, "timestamp": "01:40:08", "text": "这？我刚拿了它"}, {"type": "subtitle", "time": 6011.59, "timestamp": "01:40:11", "text": "因为我以为我可以变成像……"}, {"type": "subtitle", "time": 6013.83, "timestamp": "01:40:13", "text": "我是作家，但我没能成为作家。"}, {"type": "subtitle", "time": 6023.03, "timestamp": "01:40:23", "text": "我失去了动力，这让我很沮丧。"}, {"type": "subtitle", "time": 6025.149, "timestamp": "01:40:25", "text": "我猜我不知道"}, {"type": "chat", "time": 6027.995, "timestamp": "01:40:27", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that was yr reason?"}, {"type": "chat", "time": 6029.015, "timestamp": "01:40:29", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "X"}, {"type": "subtitle", "time": 6029.07, "timestamp": "01:40:29", "text": "为什么我满脑子都是管道"}, {"type": "subtitle", "time": 6032.87, "timestamp": "01:40:32", "text": "音乐，还有我享受生活的方式"}, {"type": "chat", "time": 6033.346, "timestamp": "01:40:33", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "X"}, {"type": "subtitle", "time": 6036.149, "timestamp": "01:40:36", "text": "我肯定能找到工作。"}, {"type": "subtitle", "time": 6041.709, "timestamp": "01:40:41", "text": "呃，一旦我进去"}, {"type": "subtitle", "time": 6044.709, "timestamp": "01:40:44", "text": "因为我别无选择，只能去日本，我没有其他人可以依靠。"}, {"type": "subtitle", "time": 6047.75, "timestamp": "01:40:47", "text": "支持我。我必须学会生活"}]
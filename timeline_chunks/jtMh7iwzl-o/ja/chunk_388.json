[{"type": "subtitle", "time": 23291.19, "timestamp": "06:28:11", "text": "脳。ああ、私、何してたっけ？忘れた。"}, {"type": "subtitle", "time": 23293.468, "timestamp": "06:28:13", "text": "ADHDの典型的な例。"}, {"type": "subtitle", "time": 23296.27, "timestamp": "06:28:16", "text": "えっと、待って、私は何だったっけ"}, {"type": "subtitle", "time": 23300.43, "timestamp": "06:28:20", "text": "何をしているの？数分前に私が言ったことは何だったっけ？"}, {"type": "subtitle", "time": 23302.868, "timestamp": "06:28:22", "text": "前に？忘れた。待って、私は"}, {"type": "subtitle", "time": 23306.788, "timestamp": "06:28:26", "text": "それ。そうそう。うん。と等しい場合、"}, {"type": "subtitle", "time": 23310.11, "timestamp": "06:28:30", "text": "1より大きい値は"}, {"type": "subtitle", "time": 23321.15, "timestamp": "06:28:41", "text": "または同等"}, {"type": "subtitle", "time": 23323.67, "timestamp": "06:28:43", "text": "二。いいえ、"}, {"type": "subtitle", "time": 23326.11, "timestamp": "06:28:46", "text": "[音楽]"}]
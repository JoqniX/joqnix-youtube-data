[{"type": "subtitle", "time": 21362.83, "timestamp": "05:56:02", "text": "[音楽]"}, {"type": "subtitle", "time": 21365.99, "timestamp": "05:56:05", "text": "間違っている？遅延が原因かもしれない。置こう"}, {"type": "subtitle", "time": 21367.16, "timestamp": "05:56:07", "text": "のように"}, {"type": "subtitle", "time": 21370.19, "timestamp": "05:56:10", "text": "[音楽]"}, {"type": "subtitle", "time": 21381.27, "timestamp": "05:56:21", "text": "仕事。わかりません。私たちはただ引き起こしているだけです"}, {"type": "subtitle", "time": 21384.47, "timestamp": "05:56:24", "text": "これ。全体を無効にしてみましょう"}, {"type": "subtitle", "time": 21388.39, "timestamp": "05:56:28", "text": "スイッチケースみたいなもの。見てみましょう。ああ、もし"}, {"type": "subtitle", "time": 21390.23, "timestamp": "05:56:30", "text": "不思議に思っているでしょうが、削除のようなものがあります"}, {"type": "subtitle", "time": 21392.548, "timestamp": "05:56:32", "text": "コマンドの先頭にある変数。だから、"}, {"type": "subtitle", "time": 21394.868, "timestamp": "05:56:34", "text": "消去。わかった。それは別物だ。待って、"}, {"type": "subtitle", "time": 21397.03, "timestamp": "05:56:37", "text": "それは全く別のものだ。犯人は誰だ？"}, {"type": "subtitle", "time": 21400.19, "timestamp": "05:56:40", "text": "この事態を引き起こした犯人は誰だ？誰が"}, {"type": "subtitle", "time": 21414.11, "timestamp": "05:56:54", "text": "近日公開予定。"}, {"type": "subtitle", "time": 21417.948, "timestamp": "05:56:57", "text": "ちょっと待って。それは、あなたは"}]
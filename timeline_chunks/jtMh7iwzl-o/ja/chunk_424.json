[{"type": "subtitle", "time": 25459.67, "timestamp": "07:04:19", "text": "オフ。私が黙り込んだ瞬間、"}, {"type": "subtitle", "time": 25462.15, "timestamp": "07:04:22", "text": "その時間になると私は寝てしまう。または"}, {"type": "subtitle", "time": 25464.11, "timestamp": "07:04:24", "text": "多分私は"}, {"type": "subtitle", "time": 25466.708, "timestamp": "07:04:26", "text": "集中した。しかし、これは私にとって問題です"}, {"type": "subtitle", "time": 25469.15, "timestamp": "07:04:29", "text": "修正する必要がある。よく考えてみて。"}, {"type": "subtitle", "time": 25472.11, "timestamp": "07:04:32", "text": "寝る話をする"}, {"type": "subtitle", "time": 25474.868, "timestamp": "07:04:34", "text": "ここ。長時間の長時間の作業のようにできる"}, {"type": "subtitle", "time": 25477.43, "timestamp": "07:04:37", "text": "これを完成させるために配信します"}]
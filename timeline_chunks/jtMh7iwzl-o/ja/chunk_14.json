[{"type": "subtitle", "time": 841.509, "timestamp": "00:14:01", "text": "メッセージ。さらに彼のマイクは"}, {"type": "chat", "time": 843.271, "timestamp": "00:14:03", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Daamn"}, {"type": "subtitle", "time": 844.59, "timestamp": "00:14:04", "text": "ミュート。ほら、アイコンも見えるでしょ。"}, {"type": "subtitle", "time": 848.629, "timestamp": "00:14:08", "text": "右？そう願っています。そう、そんな感じ。"}, {"type": "chat", "time": 848.792, "timestamp": "00:14:08", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "That is actually cool"}, {"type": "subtitle", "time": 850.59, "timestamp": "00:14:10", "text": "そして、私たちはそれを作った"}, {"type": "subtitle", "time": 853.11, "timestamp": "00:14:13", "text": "今日。ええと、睡眠用のものがあります。"}, {"type": "subtitle", "time": 854.79, "timestamp": "00:14:14", "text": "昼寝、トイレ休憩、個人的な用事、"}, {"type": "subtitle", "time": 857.59, "timestamp": "00:14:17", "text": "音楽、勉強、私の休憩時間。私は作りたい"}, {"type": "subtitle", "time": 859.47, "timestamp": "00:14:19", "text": "これ"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "自動化されています。だから、いいえ、私は"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "これを作るために、私はそれをDiscordに適用します"}, {"type": "subtitle", "time": 868.43, "timestamp": "00:14:28", "text": "良い。 Discordで顧客PCとして"}, {"type": "subtitle", "time": 871.79, "timestamp": "00:14:31", "text": "私が"}, {"type": "subtitle", "time": 874.15, "timestamp": "00:14:34", "text": "複数のマルチリーミングをストリーミング"}, {"type": "subtitle", "time": 878.949, "timestamp": "00:14:38", "text": "プラットフォームなど。それに、もし私が"}, {"type": "subtitle", "time": 881.11, "timestamp": "00:14:41", "text": "休憩中などにストリーミング配信しています。"}, {"type": "subtitle", "time": 884.23, "timestamp": "00:14:44", "text": "また、なぜ必要なのか分からないことも示しています"}, {"type": "subtitle", "time": 886.629, "timestamp": "00:14:46", "text": "それ。 「それってちょっとクールだね」って思った。なぜ"}, {"type": "subtitle", "time": 890.43, "timestamp": "00:14:50", "text": "私はそうしていないのか？そこで私は"}, {"type": "subtitle", "time": 894.629, "timestamp": "00:14:54", "text": "それ。実際は必要ありません。私は"}, {"type": "subtitle", "time": 897.829, "timestamp": "00:14:57", "text": "ずっと前からそうしようと考えていた。私は"}]
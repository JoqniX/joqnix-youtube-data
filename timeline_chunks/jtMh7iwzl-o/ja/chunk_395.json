[{"type": "subtitle", "time": 23700.708, "timestamp": "06:35:00", "text": "現在、2つのストリームが存在します。 2、2"}, {"type": "subtitle", "time": 23702.548, "timestamp": "06:35:02", "text": "ストリーム。私は3つのストリームを送信しました。待って、"}, {"type": "subtitle", "time": 23704.548, "timestamp": "06:35:04", "text": "待って、待って、待って、待って。データは何ですか"}, {"type": "subtitle", "time": 23708.548, "timestamp": "06:35:08", "text": "これの次は？ああ、ゼロと表示されている。おお、"}, {"type": "subtitle", "time": 23714.23, "timestamp": "06:35:14", "text": "おお。待って。私はそれを使って"}, {"type": "subtitle", "time": 23717.27, "timestamp": "06:35:17", "text": "アドバンテージ。ちょっと待って。ちょっと待って。"}, {"type": "subtitle", "time": 23719.31, "timestamp": "06:35:19", "text": "例外"}, {"type": "subtitle", "time": 23722.788, "timestamp": "06:35:22", "text": "あ、待って。それは確かに賢明な考えだ。ああ、"}, {"type": "subtitle", "time": 23724.468, "timestamp": "06:35:24", "text": "神。私はただ改造するだけです。待って、待って、待って、待って、"}, {"type": "subtitle", "time": 23725.878, "timestamp": "06:35:25", "text": "待って、待って、 待って、待って。あ、あ、待って、待って。でもでも"}, {"type": "subtitle", "time": 23731.04, "timestamp": "06:35:31", "text": "待って、待って。あ、あ、待って、待って。でもでも 待って。これには問題があります。"}, {"type": "subtitle", "time": 23741.468, "timestamp": "06:35:41", "text": "[音楽]"}, {"type": "subtitle", "time": 23744.91, "timestamp": "06:35:44", "text": "待って、でも、でもあなたは"}, {"type": "subtitle", "time": 23748.91, "timestamp": "06:35:48", "text": "問題があることはわかっています"}, {"type": "subtitle", "time": 23751.548, "timestamp": "06:35:51", "text": "これ。"}, {"type": "subtitle", "time": 23754.868, "timestamp": "06:35:54", "text": "やけど。でも本当に2つのデータが必要なの？"}, {"type": "subtitle", "time": 23757.67, "timestamp": "06:35:57", "text": "または、必要ないときにストリームを増やす"}]
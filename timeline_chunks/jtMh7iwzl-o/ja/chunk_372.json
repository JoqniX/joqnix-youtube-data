[{"type": "subtitle", "time": 22323.548, "timestamp": "06:12:03", "text": "給料、つまり月給を待っています"}, {"type": "subtitle", "time": 22327.67, "timestamp": "06:12:07", "text": "私のGitHubも泣いているので、これについて。私"}, {"type": "subtitle", "time": 22329.868, "timestamp": "06:12:09", "text": "以前に撮影したとは思わない"}, {"type": "subtitle", "time": 22333.51, "timestamp": "06:12:13", "text": "けれど。私のGitHubが泣いている。あなたの"}, {"type": "subtitle", "time": 22336.31, "timestamp": "06:12:16", "text": "現在の利用料金はGitHubです"}, {"type": "subtitle", "time": 22341.35, "timestamp": "06:12:21", "text": "いつもお支払いなどお願いします。"}, {"type": "subtitle", "time": 22343.59, "timestamp": "06:12:23", "text": "これは私の散歩道のためのものです。"}, {"type": "subtitle", "time": 22346.35, "timestamp": "06:12:26", "text": "IRLウォーキングオーディオ"}, {"type": "subtitle", "time": 22347.948, "timestamp": "06:12:27", "text": "ストリーム。"}, {"type": "subtitle", "time": 22351.83, "timestamp": "06:12:31", "text": "私はこれを使っています、えーと"}, {"type": "subtitle", "time": 22358.27, "timestamp": "06:12:38", "text": "待って、これ"}, {"type": "subtitle", "time": 22360.91, "timestamp": "06:12:40", "text": "傘"}, {"type": "subtitle", "time": 22363.868, "timestamp": "06:12:43", "text": "箱。これが探していたものだろうか？"}, {"type": "subtitle", "time": 22374.35, "timestamp": "06:12:54", "text": "待って、これは私が探しているもの？"}, {"type": "subtitle", "time": 22377.03, "timestamp": "06:12:57", "text": "待って、待って待って待って待って待って待って"}, {"type": "subtitle", "time": 22379.628, "timestamp": "06:12:59", "text": "これはシリアルです"}]
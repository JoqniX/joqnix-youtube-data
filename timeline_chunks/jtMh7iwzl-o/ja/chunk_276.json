[{"type": "subtitle", "time": 16572.07, "timestamp": "04:36:12", "text": "二。ああ、非公開なんですね。ああ神様、あなたは"}, {"type": "subtitle", "time": 16581.07, "timestamp": "04:36:21", "text": "どこでどこで"}, {"type": "subtitle", "time": 16603.109, "timestamp": "04:36:43", "text": "3つの公共。わかった。私たちは3つ作りました"}, {"type": "subtitle", "time": 16605.83, "timestamp": "04:36:45", "text": "ストリーム。はい、心配しないでください。削除します"}, {"type": "subtitle", "time": 16608.189, "timestamp": "04:36:48", "text": "ストリームの最後にあります。"}, {"type": "subtitle", "time": 16612.75, "timestamp": "04:36:52", "text": "ご覧のとおり、現在3つのストリームを作成しました。保存"}, {"type": "subtitle", "time": 16617.429, "timestamp": "04:36:57", "text": "それを削除して、この実行を終了します。お願いします"}]
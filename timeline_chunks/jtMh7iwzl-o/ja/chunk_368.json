[{"type": "subtitle", "time": 22102.47, "timestamp": "06:08:22", "text": "えっと、どうすればいいんですか？"}, {"type": "subtitle", "time": 22103.948, "timestamp": "06:08:23", "text": "考える"}, {"type": "subtitle", "time": 22107.67, "timestamp": "06:08:27", "text": "設定みたいなものだと思う、えっと、待って、思う"}, {"type": "subtitle", "time": 22109.59, "timestamp": "06:08:29", "text": "待って、ドキュメントには"}, {"type": "subtitle", "time": 22111.788, "timestamp": "06:08:31", "text": "私への回答"}, {"type": "subtitle", "time": 22116.15, "timestamp": "06:08:36", "text": "そう、配列みたいなものだよね。それで何？"}, {"type": "subtitle", "time": 22119.35, "timestamp": "06:08:39", "text": "配列のようなインデックスがゼロの場合、b"}, {"type": "subtitle", "time": 22122.75, "timestamp": "06:08:42", "text": "c d わかりました"}, {"type": "subtitle", "time": 22125.948, "timestamp": "06:08:45", "text": "例えば"}, {"type": "subtitle", "time": 22129.11, "timestamp": "06:08:49", "text": "そして彼らは「ああ、待って、待って、私はできる」と思う"}, {"type": "subtitle", "time": 22131.35, "timestamp": "06:08:51", "text": "こうすれば、ああ神様、わかったわ、神様"}, {"type": "subtitle", "time": 22134.59, "timestamp": "06:08:54", "text": "私は神を手に入れた、手に入れた、手に入れた。"}, {"type": "subtitle", "time": 22137.948, "timestamp": "06:08:57", "text": "うんうん。どこに"}]
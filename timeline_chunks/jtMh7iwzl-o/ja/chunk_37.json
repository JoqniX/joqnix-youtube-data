[{"type": "subtitle", "time": 2222.63, "timestamp": "00:37:02", "text": "インドを離れる。では、なぜ私が注文する必要があるのでしょうか？"}, {"type": "subtitle", "time": 2224.19, "timestamp": "00:37:04", "text": "と"}, {"type": "subtitle", "time": 2227.47, "timestamp": "00:37:07", "text": "これら"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "私は覚えています。ああ、思い出したよ。ああ、私は"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "覚えて。私はその死亡フォルダを削除しました"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "だって私は「必要ない」って思ったから"}, {"type": "subtitle", "time": 2260.829, "timestamp": "00:37:40", "text": "何でも"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "もう。まるでバカみたいだ。私はそう言った"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "苦しみ。"}, {"type": "subtitle", "time": 2275.15, "timestamp": "00:37:55", "text": "全部。よし、新しいものを作ろう"}]
[{"type": "subtitle", "time": 25500.43, "timestamp": "07:05:00", "text": "[音楽]"}, {"type": "subtitle", "time": 25503.99, "timestamp": "07:05:03", "text": "オフ。寝ています。何？わかった。あなた"}, {"type": "subtitle", "time": 25510.548, "timestamp": "07:05:10", "text": "えっと、ちょっと休憩しようかなと思ってたんだけど"}, {"type": "subtitle", "time": 25512.708, "timestamp": "07:05:12", "text": "今すぐ。顔を洗って"}, {"type": "subtitle", "time": 25518.15, "timestamp": "07:05:18", "text": "戻る。はい。よし、休憩時間だ。私たちは"}, {"type": "subtitle", "time": 25520.468, "timestamp": "07:05:20", "text": "休憩を取る。さあ、木材を楽しんでください。"}, {"type": "subtitle", "time": 25533.03, "timestamp": "07:05:33", "text": "私が話しています。わかった。私は水が好きです。"}, {"type": "subtitle", "time": 25543.868, "timestamp": "07:05:43", "text": "[音楽]"}, {"type": "subtitle", "time": 25550.8, "timestamp": "07:05:50", "text": "終了。ちょっと待って。"}, {"type": "subtitle", "time": 25558.83, "timestamp": "07:05:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 22622.548, "timestamp": "06:17:02", "text": "例えば、私がクラウドを利用する場合"}, {"type": "subtitle", "time": 22625.51, "timestamp": "06:17:05", "text": "OBS、今度は私のものが必要です。"}, {"type": "subtitle", "time": 22628.11, "timestamp": "06:17:08", "text": "ストリームなのでサミーの物"}, {"type": "subtitle", "time": 22630.948, "timestamp": "06:17:10", "text": "ストリームボードは、これらのアプリケーションをすべて"}, {"type": "subtitle", "time": 22633.27, "timestamp": "06:17:13", "text": "これで、接続先は"}, {"type": "subtitle", "time": 22636.47, "timestamp": "06:17:16", "text": "OBSは正しいです、そしてこれはこれらのことを行います"}, {"type": "subtitle", "time": 22639.19, "timestamp": "06:17:19", "text": "自動的に正しいです。これらが必要です"}, {"type": "subtitle", "time": 22640.788, "timestamp": "06:17:20", "text": "そう、だから忘れてたんだけど、"}, {"type": "subtitle", "time": 22644.43, "timestamp": "06:17:24", "text": "ウェブサイトでは、1,000ドルか"}, {"type": "subtitle", "time": 22646.11, "timestamp": "06:17:26", "text": "何か"}, {"type": "subtitle", "time": 22649.43, "timestamp": "06:17:29", "text": "1か月間、または私は"}, {"type": "subtitle", "time": 22652.35, "timestamp": "06:17:32", "text": "忘れていました。 90ドルだったか、それとも"}, {"type": "subtitle", "time": 22655.27, "timestamp": "06:17:35", "text": "100ドル？うん、ちょっと高かったね。"}, {"type": "subtitle", "time": 22658.39, "timestamp": "06:17:38", "text": "しかし、それはまるで高級キットのように付属している。のように"}, {"type": "subtitle", "time": 22661.27, "timestamp": "06:17:41", "text": "キット1は基本的なものと全く同じです"}, {"type": "subtitle", "time": 22664.31, "timestamp": "06:17:44", "text": "まるでクラウド上のOBSみたいだ。リモート"}, {"type": "subtitle", "time": 22666.47, "timestamp": "06:17:46", "text": "デスクトップが接続され、シーンが設定され、"}, {"type": "subtitle", "time": 22669.83, "timestamp": "06:17:49", "text": "すべて、あるいは彼らはあなたのためにシーンを用意します"}, {"type": "subtitle", "time": 22672.39, "timestamp": "06:17:52", "text": "OBSからログインするか、"}, {"type": "subtitle", "time": 22674.548, "timestamp": "06:17:54", "text": "ストリームキーを共有して設定します"}, {"type": "subtitle", "time": 22677.75, "timestamp": "06:17:57", "text": "そして、そのように稼働させ続ける。"}]
[{"type": "subtitle", "time": 25267.39, "timestamp": "07:01:07", "text": "質問ですが、私は知りません"}, {"type": "subtitle", "time": 25269.868, "timestamp": "07:01:09", "text": "答え。開ける"}, {"type": "subtitle", "time": 25275.67, "timestamp": "07:01:15", "text": "それ。削除してください。貼り付けてください。わかった。私は走る。"}, {"type": "subtitle", "time": 25282.548, "timestamp": "07:01:22", "text": "仕事。私は正しい位置にいますか？"}, {"type": "subtitle", "time": 25294.15, "timestamp": "07:01:34", "text": "わかった。えっと、私の考えは、私の考えは、えっと"}, {"type": "subtitle", "time": 25306.11, "timestamp": "07:01:46", "text": "[音楽]"}, {"type": "subtitle", "time": 25309.67, "timestamp": "07:01:49", "text": "合計結果。右？私たちは試すことができます"}, {"type": "subtitle", "time": 25311.23, "timestamp": "07:01:51", "text": "ただやるだけ"}, {"type": "subtitle", "time": 25315.83, "timestamp": "07:01:55", "text": "それ。わかった。今後の配信予定"}]
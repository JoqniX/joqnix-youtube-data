[{"type": "subtitle", "time": 7333.43, "timestamp": "02:02:13", "text": "Discordでの返信を際立たせるにはどうすればよいですか？"}, {"type": "subtitle", "time": 7341.229, "timestamp": "02:02:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7343.229, "timestamp": "02:02:23", "text": "質問。良い"}, {"type": "subtitle", "time": 7345.91, "timestamp": "02:02:25", "text": "質問。私が好きなのは"}, {"type": "subtitle", "time": 7347.91, "timestamp": "02:02:27", "text": "エクササイズは、私がいくつ作れるかということです"}, {"type": "subtitle", "time": 7350.229, "timestamp": "02:02:30", "text": "プロンプトを表示して、どれでも選択してください。"}, {"type": "subtitle", "time": 7353.109, "timestamp": "02:02:33", "text": "もの。おすすめの選択肢が気に入りました"}, {"type": "subtitle", "time": 7369.589, "timestamp": "02:02:49", "text": "今。高度なストリーミング指標。私はしません"}]
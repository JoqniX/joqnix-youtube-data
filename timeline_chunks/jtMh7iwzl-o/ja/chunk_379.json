[{"type": "subtitle", "time": 22741.67, "timestamp": "06:19:01", "text": "私がサミーとかそういうのをセットアップしたもの"}, {"type": "subtitle", "time": 22743.51, "timestamp": "06:19:03", "text": "クラッシュしたか何かだ。私はできないだろう"}, {"type": "subtitle", "time": 22747.708, "timestamp": "06:19:07", "text": "今すぐ知ろう。私は外にいるんですよね？私は"}, {"type": "subtitle", "time": 22750.31, "timestamp": "06:19:10", "text": "外にいると、ポートフォワーディングが必要で、"}, {"type": "subtitle", "time": 22752.708, "timestamp": "06:19:12", "text": "みんながそうする、あの悪ふざけを全部"}, {"type": "subtitle", "time": 22756.39, "timestamp": "06:19:16", "text": "何らかの方法で私のデスクトップに接続して、"}, {"type": "subtitle", "time": 22759.75, "timestamp": "06:19:19", "text": "リモートデスクトップの仕組みを理解し、問題を解決してください。ポンプ"}, {"type": "subtitle", "time": 22762.83, "timestamp": "06:19:22", "text": "外出中は電話する。それは"}, {"type": "subtitle", "time": 22768.23, "timestamp": "06:19:28", "text": "大きい。ええ、だから私は"}, {"type": "subtitle", "time": 22771.51, "timestamp": "06:19:31", "text": "私の屋外ストリームをこれ以上長引かせないで"}, {"type": "subtitle", "time": 22774.548, "timestamp": "06:19:34", "text": "1時間以上かかるかもしれないので、何が起こるかわからないので"}, {"type": "subtitle", "time": 22777.35, "timestamp": "06:19:37", "text": "起こり得る。今は話しているような感じで"}, {"type": "subtitle", "time": 22780.47, "timestamp": "06:19:40", "text": "景色を楽しんだり見せたり、"}, {"type": "subtitle", "time": 22783.35, "timestamp": "06:19:43", "text": "電話。一方、ストリームは"}, {"type": "subtitle", "time": 22786.39, "timestamp": "06:19:46", "text": "ライブ配信か、すでに配信されている"}, {"type": "subtitle", "time": 22790.47, "timestamp": "06:19:50", "text": "兄弟、壊れたとか、そうじゃないとか"}, {"type": "subtitle", "time": 22793.67, "timestamp": "06:19:53", "text": "超越とかそういう類のこと。何てことだ。そして"}, {"type": "subtitle", "time": 22796.788, "timestamp": "06:19:56", "text": "私にも一度そういうことがあって、その日ああ"}]
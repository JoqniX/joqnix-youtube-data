[{"type": "subtitle", "time": 22986.39, "timestamp": "06:23:06", "text": "いらっしゃいませ。あなたがここにいるのは分かっています。どこに"}, {"type": "subtitle", "time": 22996.59, "timestamp": "06:23:16", "text": "それは何ですか"}, {"type": "subtitle", "time": 22999.868, "timestamp": "06:23:19", "text": "いじめ？わかった。"}, {"type": "subtitle", "time": 23015.43, "timestamp": "06:23:35", "text": "1つ。ちょっと待って。どうすればわかるのか"}, {"type": "subtitle", "time": 23032.1, "timestamp": "06:23:52", "text": "おお、"}, {"type": "subtitle", "time": 23033.708, "timestamp": "06:23:53", "text": "[音楽]"}]
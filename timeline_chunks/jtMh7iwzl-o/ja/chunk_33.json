[{"type": "subtitle", "time": 1982.75, "timestamp": "00:33:02", "text": "えっと、ウェブ"}, {"type": "subtitle", "time": 1994.95, "timestamp": "00:33:14", "text": "作品。ウェブフックの仕組みをすっかり忘れてしまった"}, {"type": "subtitle", "time": 1996.31, "timestamp": "00:33:16", "text": "作品。"}, {"type": "subtitle", "time": 1998.31, "timestamp": "00:33:18", "text": "私たちはウェブソケットを実行しています"}, {"type": "subtitle", "time": 2004.47, "timestamp": "00:33:24", "text": "しかし、どのリスニング行為が実際に耳を傾けているのか"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "でも私はずっと前にこれをやったんだけど、"}, {"type": "subtitle", "time": 2015.95, "timestamp": "00:33:35", "text": "何をしたか覚えていない"}, {"type": "subtitle", "time": 2019.23, "timestamp": "00:33:39", "text": "私はそうしました"}, {"type": "subtitle", "time": 2029.07, "timestamp": "00:33:49", "text": "物忘れがひどくて、たくさんの物をなくしてしまいました。"}, {"type": "subtitle", "time": 2031.549, "timestamp": "00:33:51", "text": "兄弟。 VUA"}]
[{"type": "subtitle", "time": 1200.95, "timestamp": "00:20:00", "text": "今はできると信じているので"}, {"type": "subtitle", "time": 1203.95, "timestamp": "00:20:03", "text": "信者からのこのすべて"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "今。誰が誰に加わったのか、誰が通りかかったのか？"}, {"type": "subtitle", "time": 1210.59, "timestamp": "00:20:10", "text": "何が"}, {"type": "subtitle", "time": 1215.87, "timestamp": "00:20:15", "text": "コメントしましたか？そのため、"}, {"type": "subtitle", "time": 1219.35, "timestamp": "00:20:19", "text": "する。それによって、非常に多くの暗闇が"}, {"type": "subtitle", "time": 1246.029, "timestamp": "00:20:46", "text": "[音楽]"}, {"type": "subtitle", "time": 1250.31, "timestamp": "00:20:50", "text": "垂直。私はデッキをたくさん失いました"}, {"type": "subtitle", "time": 1251.52, "timestamp": "00:20:51", "text": "オン"}, {"type": "subtitle", "time": 1254.11, "timestamp": "00:20:54", "text": "[音楽]"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "サミー。私はそれらを失くしていません。私はできた"}]
[{"type": "subtitle", "time": 23222.07, "timestamp": "06:27:02", "text": "YouTube。それは私のスケジュール帳みたいなものです。"}, {"type": "subtitle", "time": 23225.11, "timestamp": "06:27:05", "text": "ストリームをスケジュールするたびに"}, {"type": "subtitle", "time": 23227.83, "timestamp": "06:27:07", "text": "YouTubeでは、近日公開予定の動画のように表示されます。"}, {"type": "subtitle", "time": 23229.468, "timestamp": "06:27:09", "text": "ストリーム"}, {"type": "subtitle", "time": 23232.15, "timestamp": "06:27:12", "text": "あれ。私はコーディングを知らないので、"}, {"type": "subtitle", "time": 23235.75, "timestamp": "06:27:15", "text": "コードでは実現できません。だから、私は"}, {"type": "subtitle", "time": 23239.868, "timestamp": "06:27:19", "text": "便利なサミー・チャンを使って"}, {"type": "subtitle", "time": 23243.19, "timestamp": "06:27:23", "text": "それ。はい、これで終わりです。でもこれは親切です"}, {"type": "subtitle", "time": 23245.83, "timestamp": "06:27:25", "text": "マニュアルのようなもの。私は入力しなければならない"}, {"type": "subtitle", "time": 23247.59, "timestamp": "06:27:27", "text": "すべて。"}, {"type": "subtitle", "time": 23250.03, "timestamp": "06:27:30", "text": "ストリームを提供する"}, {"type": "subtitle", "time": 23253.27, "timestamp": "06:27:33", "text": "タイトルタイム、それらすべて、多すぎる"}, {"type": "subtitle", "time": 23256.628, "timestamp": "06:27:36", "text": "つまり自動化されているので、私はただ"}, {"type": "subtitle", "time": 23259.708, "timestamp": "06:27:39", "text": "ゆったりとくつろいで"}, {"type": "subtitle", "time": 23262.99, "timestamp": "06:27:42", "text": "複雑すぎる、そう、複雑だ"}, {"type": "subtitle", "time": 23266.948, "timestamp": "06:27:46", "text": "調子はどう？あなたの"}, {"type": "subtitle", "time": 23269.548, "timestamp": "06:27:49", "text": "インスタグラムの投稿は、"}, {"type": "subtitle", "time": 23272.67, "timestamp": "06:27:52", "text": "歌をたくさん歌っててよかった"}]
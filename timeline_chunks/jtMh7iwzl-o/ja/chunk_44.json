[{"type": "subtitle", "time": 2644.43, "timestamp": "00:44:04", "text": "ここ。オンにするにはどうすればいいですか"}, {"type": "subtitle", "time": 2649.27, "timestamp": "00:44:09", "text": "私のDiscordの両方ですか？"}, {"type": "subtitle", "time": 2671.03, "timestamp": "00:44:31", "text": "アカウントとこのデータを送信したい"}, {"type": "subtitle", "time": 2674.51, "timestamp": "00:44:34", "text": "待って、もしできるなら、たくさんのアイデアが浮かぶ"}, {"type": "subtitle", "time": 2677.23, "timestamp": "00:44:37", "text": "おい、誰か止めてくれ"}, {"type": "subtitle", "time": 2694.43, "timestamp": "00:44:54", "text": "[音楽]"}]
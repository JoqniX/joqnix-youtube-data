[{"type": "subtitle", "time": 18247.27, "timestamp": "05:04:07", "text": "境界線って何ですか？私にさせて"}, {"type": "subtitle", "time": 18255.91, "timestamp": "05:04:15", "text": "それ。それは、次の境界線は何ですか"}, {"type": "subtitle", "time": 18256.91, "timestamp": "05:04:16", "text": "これ"}, {"type": "subtitle", "time": 18259.19, "timestamp": "05:04:19", "text": "方法？ 1秒。"}, {"type": "subtitle", "time": 18274.07, "timestamp": "05:04:34", "text": "ええと、ソースの端からの距離"}, {"type": "subtitle", "time": 18276.43, "timestamp": "05:04:36", "text": "これによりマウスが再び有効になります"}, {"type": "subtitle", "time": 18286.43, "timestamp": "05:04:46", "text": "で？"}, {"type": "subtitle", "time": 18289.39, "timestamp": "05:04:49", "text": "[音楽]"}]
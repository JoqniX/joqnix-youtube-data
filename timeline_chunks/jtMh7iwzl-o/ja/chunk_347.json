[{"type": "subtitle", "time": 20822.788, "timestamp": "05:47:02", "text": "えーっと、スケジュールとか、もし見つかれば。"}, {"type": "subtitle", "time": 20826.548, "timestamp": "05:47:06", "text": "ええと、これです。もし私が古いWaitを使っていたら、"}, {"type": "subtitle", "time": 20829.27, "timestamp": "05:47:09", "text": "どこですか？わかった。もし私が古いものを使っていたら"}, {"type": "subtitle", "time": 20832.788, "timestamp": "05:47:12", "text": "スケジュールのようなもの、ここに、毎日"}, {"type": "subtitle", "time": 20835.67, "timestamp": "05:47:15", "text": "独立したストリームスケジュールストリームは"}, {"type": "subtitle", "time": 20838.47, "timestamp": "05:47:18", "text": "サムネイル画像ですよね？うん。この種類の"}, {"type": "subtitle", "time": 20842.23, "timestamp": "05:47:22", "text": "このタイプの作品のこのフォーマット"}, {"type": "subtitle", "time": 20844.47, "timestamp": "05:47:24", "text": "なぜなら、すべての個々の流れは"}, {"type": "subtitle", "time": 20847.67, "timestamp": "05:47:27", "text": "サムネイルは右ですが、現在の"}, {"type": "subtitle", "time": 20852.15, "timestamp": "05:47:32", "text": "セットアップは、必要なのは"}, {"type": "subtitle", "time": 20856.15, "timestamp": "05:47:36", "text": "最新のものみたいだけど、それでも"}, {"type": "subtitle", "time": 20858.948, "timestamp": "05:47:38", "text": "それでも私はただそれを見てみたいだけです"}, {"type": "subtitle", "time": 20861.07, "timestamp": "05:47:41", "text": "それが正しいか、"}, {"type": "subtitle", "time": 20863.67, "timestamp": "05:47:43", "text": "いや、でも、電源を切るよ。"}, {"type": "subtitle", "time": 20865.11, "timestamp": "05:47:45", "text": "こんな感じ"}, {"type": "subtitle", "time": 20867.11, "timestamp": "05:47:47", "text": "えーと、いつこれを使うことになるか分からないよね"}, {"type": "subtitle", "time": 20870.59, "timestamp": "05:47:50", "text": "そうですね、それを相互参照すれば"}, {"type": "subtitle", "time": 20873.628, "timestamp": "05:47:53", "text": "だから私はこう思う"}]
[{"type": "subtitle", "time": 19270.39, "timestamp": "05:21:10", "text": "また？でも、そう、だから普段は私が行くときは"}, {"type": "subtitle", "time": 19273.91, "timestamp": "05:21:13", "text": "ライブ配信中、YouTube を更新します。"}, {"type": "subtitle", "time": 19277.27, "timestamp": "05:21:17", "text": "「Twitchでライブ配信中」というTwitterバナー"}, {"type": "subtitle", "time": 19280.07, "timestamp": "05:21:20", "text": "そしてYouTube。そうすれば私の"}, {"type": "subtitle", "time": 19282.628, "timestamp": "05:21:22", "text": "Discordサーバー名。こんな感じになるでしょう"}, {"type": "subtitle", "time": 19285.75, "timestamp": "05:21:25", "text": "私が"}, {"type": "subtitle", "time": 19288.31, "timestamp": "05:21:28", "text": "2つのプラットフォームでライブ配信。それは"}, {"type": "subtitle", "time": 19292.708, "timestamp": "05:21:32", "text": "私のライブVCのような一部のチャンネルのアイコン"}, {"type": "subtitle", "time": 19295.35, "timestamp": "05:21:35", "text": "チャネルと通知チャネル"}, {"type": "subtitle", "time": 19298.15, "timestamp": "05:21:38", "text": "これはこれであり、またこれも送信します"}, {"type": "subtitle", "time": 19302.19, "timestamp": "05:21:42", "text": "このメッセージも同様です。"}, {"type": "subtitle", "time": 19304.55, "timestamp": "05:21:44", "text": "すべて。だから全てがもっと"}, {"type": "subtitle", "time": 19305.628, "timestamp": "05:21:45", "text": "のように"}, {"type": "subtitle", "time": 19309.708, "timestamp": "05:21:49", "text": "縫い目内部で自動化。"}, {"type": "subtitle", "time": 19313.03, "timestamp": "05:21:53", "text": "ええ、自動化したので、"}, {"type": "subtitle", "time": 19316.75, "timestamp": "05:21:56", "text": "私の用途には都合が良い。それで"}, {"type": "subtitle", "time": 19319.19, "timestamp": "05:21:59", "text": "ええ、もしこれが何なのか疑問に思っているなら"}]
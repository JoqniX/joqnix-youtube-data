[{"type": "subtitle", "time": 25381.27, "timestamp": "07:03:01", "text": "なぜ？あまりにも"}, {"type": "subtitle", "time": 25383.51, "timestamp": "07:03:03", "text": "排泄時に痛みは大きいですか？だって既に"}, {"type": "subtitle", "time": 25430.35, "timestamp": "07:03:50", "text": "眠い。何"}, {"type": "subtitle", "time": 25435.61, "timestamp": "07:03:55", "text": "えっ？眠るのをやめろ。おお。"}]
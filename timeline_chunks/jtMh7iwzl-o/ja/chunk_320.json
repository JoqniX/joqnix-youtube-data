[{"type": "subtitle", "time": 19206.75, "timestamp": "05:20:06", "text": "分。待って。かかっていますか"}, {"type": "subtitle", "time": 19209.948, "timestamp": "05:20:09", "text": "時間？待って。アップデートされるはずです。"}, {"type": "subtitle", "time": 19212.708, "timestamp": "05:20:12", "text": "待って。あ、待って。待って。待って。待って。待って。"}, {"type": "subtitle", "time": 19214.948, "timestamp": "05:20:14", "text": "待って。待って。サーバーが先にアップデートされましたか？"}, {"type": "subtitle", "time": 19235.39, "timestamp": "05:20:35", "text": "わかった。わかった。わかった。うまくいった。それ"}, {"type": "subtitle", "time": 19241.59, "timestamp": "05:20:41", "text": "はぁ？しかしバナーはシルに変更されました"}, {"type": "subtitle", "time": 19244.31, "timestamp": "05:20:44", "text": "キャスティングですが、私の"}, {"type": "subtitle", "time": 19246.03, "timestamp": "05:20:46", "text": "終わり。"}, {"type": "subtitle", "time": 19248.708, "timestamp": "05:20:48", "text": "何？この神も変わらなかった。何"}, {"type": "subtitle", "time": 19254.39, "timestamp": "05:20:54", "text": "ハプニング？とにかく、いくつか問題点があります。それは"}, {"type": "subtitle", "time": 19259.35, "timestamp": "05:20:59", "text": "直してあげるよ でも、ちょっと"}]
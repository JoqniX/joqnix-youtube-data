[{"type": "subtitle", "time": 121.35, "timestamp": "00:02:01", "text": "ログインしています。良いのですが、ログは"}, {"type": "subtitle", "time": 123.35, "timestamp": "00:02:03", "text": "ログインしています。それは良いことだ"}, {"type": "subtitle", "time": 130.589, "timestamp": "00:02:10", "text": "ログに記録しました。私はもう一方をやります"}, {"type": "subtitle", "time": 139.79, "timestamp": "00:02:19", "text": "必要だ。他のことをやります"}, {"type": "subtitle", "time": 143.589, "timestamp": "00:02:23", "text": "やらなきゃいけないことがあったら、私はただ"}, {"type": "subtitle", "time": 148.309, "timestamp": "00:02:28", "text": "寝る準備をしてください。わかった。"}, {"type": "subtitle", "time": 151.55, "timestamp": "00:02:31", "text": "まず、私がここにいるということは、"}, {"type": "subtitle", "time": 155.309, "timestamp": "00:02:35", "text": "必要だと思う"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "えっと、全部確認する必要があると思う"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "VSをアップロードする必要があるのは、信憑性があるからです。えっと"}, {"type": "subtitle", "time": 165.03, "timestamp": "00:02:45", "text": "今日は50日目です。だから私は"}, {"type": "subtitle", "time": 166.99, "timestamp": "00:02:46", "text": "アップロード"}, {"type": "subtitle", "time": 169.55, "timestamp": "00:02:49", "text": "昨晩と今日"}, {"type": "subtitle", "time": 172.309, "timestamp": "00:02:52", "text": "朝はもう終わった。"}, {"type": "subtitle", "time": 173.22899999999998, "timestamp": "00:02:53", "text": "それで"}, {"type": "subtitle", "time": 175.67000000000002, "timestamp": "00:02:55", "text": "昨日アップロードしました、もし私が"}, {"type": "subtitle", "time": 178.22899999999998, "timestamp": "00:02:58", "text": "正しい。"}]
[{"type": "subtitle", "time": 20042.868, "timestamp": "05:34:02", "text": "あなたが私を見るときはいつでも、あなたが"}, {"type": "subtitle", "time": 20046.07, "timestamp": "05:34:06", "text": "私のチャンネルに行くと、"}, {"type": "subtitle", "time": 20049.59, "timestamp": "05:34:09", "text": "ロゴとか、デフォルトのえーと"}, {"type": "subtitle", "time": 20052.948, "timestamp": "05:34:12", "text": "YouTubeのバナーは、私がライブ配信しているときに表示されます。"}, {"type": "subtitle", "time": 20054.948, "timestamp": "05:34:14", "text": "正しく生きたい 私は与えたい"}, {"type": "subtitle", "time": 20057.59, "timestamp": "05:34:17", "text": "パーソナライズされたカスタム体験"}, {"type": "subtitle", "time": 20060.708, "timestamp": "05:34:20", "text": "私が"}, {"type": "subtitle", "time": 20063.91, "timestamp": "05:34:23", "text": "ライブみたいな感じなので、"}, {"type": "subtitle", "time": 20067.11, "timestamp": "05:34:27", "text": "秘密のメッセージか何か知っている"}, {"type": "subtitle", "time": 20070.31, "timestamp": "05:34:30", "text": "ああ、ジョーはYouTubeでライブ配信中か"}, {"type": "subtitle", "time": 20072.11, "timestamp": "05:34:32", "text": "何か、あるいは何かのようなもの"}, {"type": "subtitle", "time": 20075.19, "timestamp": "05:34:35", "text": "それ。そして私が配信を終了するとき、"}, {"type": "subtitle", "time": 20078.15, "timestamp": "05:34:38", "text": "ストリームがオフラインのとき、そうですよね。"}, {"type": "subtitle", "time": 20080.788, "timestamp": "05:34:40", "text": "そしてそれは通常の状態に戻ります"}, {"type": "subtitle", "time": 20083.27, "timestamp": "05:34:43", "text": "あれ。だから、もっとクールになるよ、"}, {"type": "subtitle", "time": 20085.59, "timestamp": "05:34:45", "text": "あなたは思う？そう思いませんか？そういう"}, {"type": "subtitle", "time": 20088.75, "timestamp": "05:34:48", "text": "よりクールでクリエイティブ、"}, {"type": "subtitle", "time": 20091.83, "timestamp": "05:34:51", "text": "右？だから私は、"}, {"type": "subtitle", "time": 20093.43, "timestamp": "05:34:53", "text": "どうすればそれができるか考え出す。それは"}, {"type": "subtitle", "time": 20096.47, "timestamp": "05:34:56", "text": "私がやりたいことの一つは"}, {"type": "subtitle", "time": 20099.51, "timestamp": "05:34:59", "text": "すでにやっているので"}]
[{"type": "subtitle", "time": 19440.35, "timestamp": "05:24:00", "text": "具体的な"}, {"type": "subtitle", "time": 19442.868, "timestamp": "05:24:02", "text": "ウム特定"}, {"type": "subtitle", "time": 19444.75, "timestamp": "05:24:04", "text": "えーと"}, {"type": "subtitle", "time": 19448.628, "timestamp": "05:24:08", "text": "URL。そう、1280×720の解像度が得られるんだ。"}, {"type": "subtitle", "time": 19450.948, "timestamp": "05:24:10", "text": "デフォルトの最大ライフ値。できますか？"}, {"type": "subtitle", "time": 19452.788, "timestamp": "05:24:12", "text": "これ、見えますか？"}, {"type": "subtitle", "time": 19455.55, "timestamp": "05:24:15", "text": "うん。うん。こちらについてはURLをご覧ください"}, {"type": "subtitle", "time": 19457.15, "timestamp": "05:24:17", "text": "構造。"}, {"type": "subtitle", "time": 19462.07, "timestamp": "05:24:22", "text": "それでは、ビデオIDはこちらです"}, {"type": "subtitle", "time": 19463.788, "timestamp": "05:24:23", "text": "私たちがどんな流れに乗ろうとも"}, {"type": "subtitle", "time": 19466.628, "timestamp": "05:24:26", "text": "スケジュール設定。これは動的な値になります"}, {"type": "subtitle", "time": 19469.91, "timestamp": "05:24:29", "text": "これは時間とともに更新されます。もしあなたが"}, {"type": "subtitle", "time": 19472.23, "timestamp": "05:24:32", "text": "入れないでください、デフォルトのようなものになります"}, {"type": "subtitle", "time": 19475.43, "timestamp": "05:24:35", "text": "YouTubeによるサムネイル画像はありません。あなたはしない"}, {"type": "subtitle", "time": 19479.43, "timestamp": "05:24:39", "text": "こういう風に置きます。私たちのユースケースでは、"}, {"type": "subtitle", "time": 19482.868, "timestamp": "05:24:42", "text": "指定されたものを読みます"}, {"type": "subtitle", "time": 19485.83, "timestamp": "05:24:45", "text": "えっと、何かみたいなやつですよね？私はそう思います"}, {"type": "subtitle", "time": 19488.51, "timestamp": "05:24:48", "text": "どこかにそれを。私はどこを指差したのか"}, {"type": "subtitle", "time": 19492.628, "timestamp": "05:24:52", "text": "あなた？誓って言うけど、私は自分が"}, {"type": "subtitle", "time": 19494.59, "timestamp": "05:24:54", "text": "これ"}]
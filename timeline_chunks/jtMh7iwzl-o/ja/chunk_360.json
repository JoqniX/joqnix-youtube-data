[{"type": "subtitle", "time": 21600.91, "timestamp": "06:00:00", "text": "ああ、それは"}, {"type": "subtitle", "time": 21604.708, "timestamp": "06:00:04", "text": "作品。よし、今のところは順調だ。二"}, {"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "ストリーム。さて、いよいよ本番です"}, {"type": "subtitle", "time": 21610.83, "timestamp": "06:00:10", "text": "一部。ああ、"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "男の子。これ"}, {"type": "subtitle", "time": 21615.548, "timestamp": "06:00:15", "text": "男。ああ、大変だ。おお"}, {"type": "subtitle", "time": 21622.948, "timestamp": "06:00:22", "text": "あなた？ええと、それらはオフにできます。しかし"}, {"type": "subtitle", "time": 21625.75, "timestamp": "06:00:25", "text": "そう、この人だよ。はぁ？これを変えよう"}, {"type": "subtitle", "time": 21628.868, "timestamp": "06:00:28", "text": "7000に到達するまでの時間。でも大丈夫だよ。のように"}, {"type": "subtitle", "time": 21632.15, "timestamp": "06:00:32", "text": "また、7,000ミリ秒は"}, {"type": "subtitle", "time": 21635.51, "timestamp": "06:00:35", "text": "数秒ですよね？繰り返しますが、私たちは"}, {"type": "subtitle", "time": 21637.91, "timestamp": "06:00:37", "text": "これは2分ごとに動作するようにします。"}, {"type": "subtitle", "time": 21641.15, "timestamp": "06:00:41", "text": "何か。最大15まで増やすことができます"}, {"type": "subtitle", "time": 21643.07, "timestamp": "06:00:43", "text": "分。"}, {"type": "subtitle", "time": 21648.15, "timestamp": "06:00:48", "text": "ええと、MS。うん。うん。つまり、7,000ミリ秒"}, {"type": "subtitle", "time": 21649.628, "timestamp": "06:00:49", "text": "に等しい"}, {"type": "subtitle", "time": 21653.67, "timestamp": "06:00:53", "text": "0 ええと、文字通り7秒です。"}, {"type": "subtitle", "time": 21655.67, "timestamp": "06:00:55", "text": "1分でもできますよ。大丈夫です。"}, {"type": "subtitle", "time": 21658.43, "timestamp": "06:00:58", "text": "しかし、遅延は調整します"}]
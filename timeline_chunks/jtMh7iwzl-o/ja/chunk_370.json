[{"type": "subtitle", "time": 22202.39, "timestamp": "06:10:02", "text": "寝るか寝ないか。その時、そう感じた。"}, {"type": "subtitle", "time": 22210.47, "timestamp": "06:10:10", "text": "ストリーム。お元気でお過ごしでしょうか。あなたは"}, {"type": "subtitle", "time": 22217.27, "timestamp": "06:10:17", "text": "ランチ？私は大丈夫です。あなたはどうですか？私も"}, {"type": "subtitle", "time": 22225.23, "timestamp": "06:10:25", "text": "私たちはダイナミックなスケジュールで作業しています"}, {"type": "subtitle", "time": 22227.15, "timestamp": "06:10:27", "text": "あれ。これ"}, {"type": "subtitle", "time": 22229.75, "timestamp": "06:10:29", "text": "1つ。だから、もうずっと前に終わらせたんだ"}, {"type": "subtitle", "time": 22232.39, "timestamp": "06:10:32", "text": "戻るが、これはマニュアル版だ。私"}, {"type": "subtitle", "time": 22235.35, "timestamp": "06:10:35", "text": "すべてのストリームを手動で入力する必要があります"}, {"type": "subtitle", "time": 22238.868, "timestamp": "06:10:38", "text": "そして時間、リンクを手動で入力し、"}, {"type": "subtitle", "time": 22241.51, "timestamp": "06:10:41", "text": "サムネイル、すべて。だから私は現在"}, {"type": "subtitle", "time": 22244.19, "timestamp": "06:10:44", "text": "道を作ることで"}, {"type": "subtitle", "time": 22246.948, "timestamp": "06:10:46", "text": "YouTubeからデータを自動的に取得する"}, {"type": "subtitle", "time": 22250.868, "timestamp": "06:10:50", "text": "APIとTwitch API、そして、えっと"}, {"type": "subtitle", "time": 22252.67, "timestamp": "06:10:52", "text": "更新して"}]
[{"type": "subtitle", "time": 22929.628, "timestamp": "06:22:09", "text": "YouTubeの動画IDのように"}, {"type": "subtitle", "time": 22945.23, "timestamp": "06:22:25", "text": "YouTube。この物には"}, {"type": "subtitle", "time": 22948.07, "timestamp": "06:22:28", "text": "数字。何か忘れていることがあるだろうか？そこには"}, {"type": "subtitle", "time": 22951.43, "timestamp": "06:22:31", "text": "それを実行するために使えるコマンドを教えてください。のように"}, {"type": "subtitle", "time": 22958.65, "timestamp": "06:22:38", "text": "兄弟。"}, {"type": "subtitle", "time": 22960.59, "timestamp": "06:22:40", "text": "[音楽]"}, {"type": "subtitle", "time": 22964.31, "timestamp": "06:22:44", "text": "もの。それはこの辺りのどこかにある。私はそれを知っている。私"}, {"type": "subtitle", "time": 22971.39, "timestamp": "06:22:51", "text": "どこかで。君が"}, {"type": "subtitle", "time": 22973.948, "timestamp": "06:22:53", "text": "ここ。代わりの"}, {"type": "subtitle", "time": 22977.09, "timestamp": "06:22:57", "text": "変数。こんにちは、クロノスさん。"}]
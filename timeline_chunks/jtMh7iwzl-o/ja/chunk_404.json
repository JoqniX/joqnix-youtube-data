[{"type": "subtitle", "time": 24255.788, "timestamp": "06:44:15", "text": "この方法はうまくいくかもしれない。"}, {"type": "subtitle", "time": 24258.59, "timestamp": "06:44:18", "text": "ミナ。感じることができる"}, {"type": "subtitle", "time": 24262.51, "timestamp": "06:44:22", "text": "それ。感じるよ。これは"}, {"type": "subtitle", "time": 24270.23, "timestamp": "06:44:30", "text": "こんにちは、これでうまくいくはずです。電源を切って"}, {"type": "subtitle", "time": 24277.11, "timestamp": "06:44:37", "text": "それ以外。数に応じて"}, {"type": "subtitle", "time": 24280.628, "timestamp": "06:44:40", "text": "スケジュールされたストリームは、すべて送信します"}, {"type": "subtitle", "time": 24282.868, "timestamp": "06:44:42", "text": "ストリームは、その数に基づいて流れます。のために"}, {"type": "subtitle", "time": 24285.59, "timestamp": "06:44:45", "text": "例えば、スケジュールが5つある場合"}, {"type": "subtitle", "time": 24289.868, "timestamp": "06:44:49", "text": "ストリーム、1 2 3 4 5 のビデオを送信します"}, {"type": "subtitle", "time": 24292.03, "timestamp": "06:44:52", "text": "データ経由"}, {"type": "subtitle", "time": 24295.75, "timestamp": "06:44:55", "text": "API。はい。"}]
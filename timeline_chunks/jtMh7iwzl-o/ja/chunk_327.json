[{"type": "subtitle", "time": 19620.628, "timestamp": "05:27:00", "text": "Discordを埋め込む？私たちはそれを"}, {"type": "subtitle", "time": 19624.23, "timestamp": "05:27:04", "text": "疑い。例を挙げて説明しましょう。"}, {"type": "subtitle", "time": 19628.19, "timestamp": "05:27:08", "text": "スコアに送ることができます"}, {"type": "subtitle", "time": 19632.99, "timestamp": "05:27:12", "text": "フック。編集できます。送信"}, {"type": "subtitle", "time": 19636.47, "timestamp": "05:27:16", "text": "それ。こちらで編集します。まさに"}, {"type": "subtitle", "time": 19638.91, "timestamp": "05:27:18", "text": "画像。"}, {"type": "subtitle", "time": 19642.948, "timestamp": "05:27:22", "text": "これを取り除いて、これを取り付けます。あ、待って。"}, {"type": "subtitle", "time": 19644.43, "timestamp": "05:27:24", "text": "間違った方です。"}, {"type": "subtitle", "time": 19648.628, "timestamp": "05:27:28", "text": "えっと、これをコピーしてここに置きます。"}, {"type": "subtitle", "time": 19651.39, "timestamp": "05:27:31", "text": "これは小さく見えますよね？わかった。"}, {"type": "subtitle", "time": 19655.628, "timestamp": "05:27:35", "text": "待って。生中継で見よう。"}, {"type": "subtitle", "time": 19660.23, "timestamp": "05:27:40", "text": "ライブ。見てみましょう。えっと、待って。"}, {"type": "subtitle", "time": 19662.708, "timestamp": "05:27:42", "text": "見えますか？いいえ。私はその方が良いと思います。"}, {"type": "subtitle", "time": 19664.35, "timestamp": "05:27:44", "text": "言い換えると"}, {"type": "subtitle", "time": 19669.59, "timestamp": "05:27:49", "text": "これ。代替案。わかった。"}, {"type": "subtitle", "time": 19671.51, "timestamp": "05:27:51", "text": "これ、分かりますよね？わかった。それで、"}, {"type": "subtitle", "time": 19674.91, "timestamp": "05:27:54", "text": "３、２、"}, {"type": "subtitle", "time": 19678.43, "timestamp": "05:27:58", "text": "待って。 ３、２、"}]
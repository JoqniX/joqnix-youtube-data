[{"type": "subtitle", "time": 27.589, "timestamp": "00:00:27", "text": "わかった。暖かくて素敵な夜と素晴らしい"}, {"type": "subtitle", "time": 31.589, "timestamp": "00:00:31", "text": "皆さん、おやすみなさい。こんにちは。ようこそ"}, {"type": "subtitle", "time": 33.229, "timestamp": "00:00:33", "text": "ヨアトンの日"}, {"type": "subtitle", "time": 40.79, "timestamp": "00:00:40", "text": "それで、舌をやけどしちゃった。ああ神様、私は"}, {"type": "subtitle", "time": 42.43, "timestamp": "00:00:42", "text": "熱い飲み物"}, {"type": "subtitle", "time": 50.27, "timestamp": "00:00:50", "text": "舌。くそ。"}, {"type": "subtitle", "time": 52.35, "timestamp": "00:00:52", "text": "わかった。"}, {"type": "subtitle", "time": 59.99, "timestamp": "00:00:59", "text": "また？ようこそ、ディオ。"}]
[{"type": "subtitle", "time": 21901.83, "timestamp": "06:05:01", "text": "それは、数字の数を見るからです"}, {"type": "subtitle", "time": 21905.03, "timestamp": "06:05:05", "text": "右。もしそれが"}, {"type": "subtitle", "time": 21906.19, "timestamp": "06:05:06", "text": "より多い"}, {"type": "subtitle", "time": 21909.23, "timestamp": "06:05:09", "text": "1つ、私は"}, {"type": "subtitle", "time": 21910.99, "timestamp": "06:05:10", "text": "に"}, {"type": "subtitle", "time": 21919.548, "timestamp": "06:05:19", "text": "えっと、それは"}, {"type": "subtitle", "time": 21922.868, "timestamp": "06:05:22", "text": "例えば、2つあるなら、1つ目が欲しい。"}, {"type": "subtitle", "time": 21925.35, "timestamp": "06:05:25", "text": "動画番号1ストリームサムネイルと"}, {"type": "subtitle", "time": 21927.11, "timestamp": "06:05:27", "text": "動画2のサムネイル。それが"}, {"type": "subtitle", "time": 21930.07, "timestamp": "06:05:30", "text": "私は主に質問しているところです。"}, {"type": "subtitle", "time": 21931.07, "timestamp": "06:05:31", "text": "しかし"}, {"type": "subtitle", "time": 21934.03, "timestamp": "06:05:34", "text": "えっと、どうすればいいですか"}]
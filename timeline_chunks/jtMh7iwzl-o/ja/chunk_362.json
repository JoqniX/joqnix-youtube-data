[{"type": "subtitle", "time": 21720.51, "timestamp": "06:02:00", "text": "私が見つけられるなら、私は正しい"}, {"type": "subtitle", "time": 21726.19, "timestamp": "06:02:06", "text": "これはタイムゾーン子午線です"}, {"type": "subtitle", "time": 21729.27, "timestamp": "06:02:09", "text": "どれだったかな？タイムゾーンは？わかったわかった"}, {"type": "subtitle", "time": 21731.99, "timestamp": "06:02:11", "text": "たぶんこれだと思うので、各タイムゾーン"}, {"type": "subtitle", "time": 21736.868, "timestamp": "06:02:16", "text": "右はJSTで、それらはすべて"}, {"type": "subtitle", "time": 21740.59, "timestamp": "06:02:20", "text": "何らかの特定の遅延"}, {"type": "subtitle", "time": 21743.51, "timestamp": "06:02:23", "text": "退出すべきでしょうか、それとも待ち時間を設定していなかったのでしょうか？私"}, {"type": "subtitle", "time": 21752.39, "timestamp": "06:02:32", "text": "作品。うん。まるで私が"}, {"type": "subtitle", "time": 21756.548, "timestamp": "06:02:36", "text": "行ったり来たりして私たちを見つけて見ています"}, {"type": "subtitle", "time": 21758.67, "timestamp": "06:02:38", "text": "文字通り堕落させる"}, {"type": "subtitle", "time": 21761.75, "timestamp": "06:02:41", "text": "まるで毎秒クラッシュしているかのようだった。"}, {"type": "subtitle", "time": 21763.868, "timestamp": "06:02:43", "text": "それが主な"}, {"type": "subtitle", "time": 21773.51, "timestamp": "06:02:53", "text": "ああ、アメリカの親指は２番目だ。おお。ああ、2つ手に入れたよ。"}, {"type": "subtitle", "time": 21776.39, "timestamp": "06:02:56", "text": "ああ、サムネイル画像を入手しました。さあ、行こう。"}, {"type": "subtitle", "time": 21778.628, "timestamp": "06:02:58", "text": "さあ行こう。さあ行こう。さあ行こう。私たちは"}]
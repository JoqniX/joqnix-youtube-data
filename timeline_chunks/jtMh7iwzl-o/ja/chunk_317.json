[{"type": "subtitle", "time": 19022.788, "timestamp": "05:17:02", "text": "また？いいえ。えっと、ゲームメーカーです。ゲーム"}, {"type": "subtitle", "time": 19024.19, "timestamp": "05:17:04", "text": "メーカー、"}, {"type": "subtitle", "time": 19026.708, "timestamp": "05:17:06", "text": "右？ゲーム　ああ、そうだね。うん。それは"}, {"type": "subtitle", "time": 19030.55, "timestamp": "05:17:10", "text": "ゲームメーカー。サミーはゲームメーカーで作られました。"}, {"type": "subtitle", "time": 19033.99, "timestamp": "05:17:13", "text": "しかし、ストリーマーボットなどのアプリケーションは"}, {"type": "subtitle", "time": 19037.19, "timestamp": "05:17:17", "text": "これはサミーに代わるもう一つの選択肢です。"}, {"type": "subtitle", "time": 19039.19, "timestamp": "05:17:19", "text": "ストリーマーボットなどのアプリケーションは"}, {"type": "subtitle", "time": 19042.47, "timestamp": "05:17:22", "text": "まるでハードコーディングされているかのように、コードに組み込まれている。うん。"}, {"type": "subtitle", "time": 19045.39, "timestamp": "05:17:25", "text": "彼らはゲームエンジン関連の技術は使っていない。"}, {"type": "subtitle", "time": 19048.628, "timestamp": "05:17:28", "text": "うん。それがあなたの質問であれば。しかし、"}, {"type": "subtitle", "time": 19052.47, "timestamp": "05:17:32", "text": "問題は、Sammy などのアプリケーションです。"}, {"type": "subtitle", "time": 19055.43, "timestamp": "05:17:35", "text": "右？問題は、それが"}, {"type": "subtitle", "time": 19057.708, "timestamp": "05:17:37", "text": "ゲームエンジンには、"}, {"type": "subtitle", "time": 19061.27, "timestamp": "05:17:41", "text": "制限事項。それが問題なのです。それを持っている"}, {"type": "subtitle", "time": 19064.23, "timestamp": "05:17:44", "text": "本当に辛い制約だ。忘れた"}, {"type": "subtitle", "time": 19068.15, "timestamp": "05:17:48", "text": "どれだったんだっけ？でも、そうですね"}, {"type": "subtitle", "time": 19070.39, "timestamp": "05:17:50", "text": "それにも限界がある、ということですよね？まるで私が"}, {"type": "subtitle", "time": 19073.15, "timestamp": "05:17:53", "text": "忘れちゃった、えっと、どうだったか"}, {"type": "subtitle", "time": 19076.55, "timestamp": "05:17:56", "text": "それ？これは私の頭から出てくるものではありません"}, {"type": "subtitle", "time": 19077.868, "timestamp": "05:17:57", "text": "頭。"}]
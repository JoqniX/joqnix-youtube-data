[{"type": "subtitle", "time": 18662.23, "timestamp": "05:11:02", "text": "右？では、どのようにすれば"}, {"type": "subtitle", "time": 18666.708, "timestamp": "05:11:06", "text": "どうすればそれができるかは、私が作るか"}, {"type": "subtitle", "time": 18670.11, "timestamp": "05:11:10", "text": "この全体をYouTubeに埋め込む"}, {"type": "subtitle", "time": 18671.628, "timestamp": "05:11:11", "text": "あれ"}, {"type": "subtitle", "time": 18675.31, "timestamp": "05:11:15", "text": "あるいは、私ができることは、別のものを作ることです"}, {"type": "subtitle", "time": 18679.19, "timestamp": "05:11:19", "text": "これと同じものを埋め込む"}, {"type": "subtitle", "time": 18681.55, "timestamp": "05:11:21", "text": "のみにそれを置く"}, {"type": "subtitle", "time": 18684.23, "timestamp": "05:11:24", "text": "twitchではなくtwitchのようなtwitchと"}, {"type": "subtitle", "time": 18685.99, "timestamp": "05:11:25", "text": "私が今後利用する他のプラットフォーム"}, {"type": "subtitle", "time": 18688.39, "timestamp": "05:11:28", "text": "ストリーミング配信で、私はこう感じます"}, {"type": "subtitle", "time": 18691.43, "timestamp": "05:11:31", "text": "より良い方法は、"}, {"type": "subtitle", "time": 18694.39, "timestamp": "05:11:34", "text": "すべてを1つの埋め込みにまとめる"}, {"type": "subtitle", "time": 18696.39, "timestamp": "05:11:36", "text": "多すぎるし、わからない"}, {"type": "subtitle", "time": 18700.868, "timestamp": "05:11:40", "text": "それを行うためのコーディング外部外部ええと"}, {"type": "subtitle", "time": 18704.07, "timestamp": "05:11:44", "text": "ホロファンみたいなカスタムアイテム"}, {"type": "subtitle", "time": 18707.19, "timestamp": "05:11:47", "text": "サーバーはそうしましたが、ここでは私たちは見ているようです"}, {"type": "subtitle", "time": 18710.708, "timestamp": "05:11:50", "text": "どれくらいかという質問がたくさんありました"}, {"type": "subtitle", "time": 18713.91, "timestamp": "05:11:53", "text": "今のところ67個の補填物を見ている"}, {"type": "subtitle", "time": 18717.59, "timestamp": "05:11:57", "text": "埋め込み機能のこと、いや、埋め込みの方法ではない。"}, {"type": "subtitle", "time": 18719.708, "timestamp": "05:11:59", "text": "埋め込みについて話しているのであれば、"}]
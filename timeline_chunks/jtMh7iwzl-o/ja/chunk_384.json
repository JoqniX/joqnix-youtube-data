[{"type": "subtitle", "time": 23051.11, "timestamp": "06:24:11", "text": "そして、私たちと共に私たちを殺してください。君が"}, {"type": "subtitle", "time": 23053.15, "timestamp": "06:24:13", "text": "ここ。どこ？どこにいるの？どこ"}, {"type": "subtitle", "time": 23077.67, "timestamp": "06:24:37", "text": "こんな時は、私は"}, {"type": "subtitle", "time": 23080.75, "timestamp": "06:24:40", "text": "ウォルダンはロックオンする"}, {"type": "subtitle", "time": 23085.39, "timestamp": "06:24:45", "text": "ストリーム。私たちは疑問を抱くつもりです"}, {"type": "subtitle", "time": 23092.15, "timestamp": "06:24:52", "text": "なぜなら、ウォルダンは、えっと、彼は、"}, {"type": "subtitle", "time": 23095.67, "timestamp": "06:24:55", "text": "サミー。彼はSammy Discordのメンバーです。それで"}, {"type": "subtitle", "time": 23099.27, "timestamp": "06:24:59", "text": "彼は毎日積極的にこれらの活動に取り組んでいる。"}]
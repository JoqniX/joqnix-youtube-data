[{"type": "subtitle", "time": 21660.788, "timestamp": "06:01:00", "text": "後で。今のところ、私たちはただ"}, {"type": "subtitle", "time": 21663.59, "timestamp": "06:01:03", "text": "ええ、それが機能しているかどうか。わかった。"}, {"type": "subtitle", "time": 21667.35, "timestamp": "06:01:07", "text": "7,000。右。 7にしましょう。"}, {"type": "subtitle", "time": 21669.39, "timestamp": "06:01:09", "text": "そうすれば、"}, {"type": "subtitle", "time": 21673.15, "timestamp": "06:01:13", "text": "8,000。これは"}, {"type": "subtitle", "time": 21699.07, "timestamp": "06:01:39", "text": "15 16 および"}, {"type": "subtitle", "time": 21701.67, "timestamp": "06:01:41", "text": "17. なぜこれが"}, {"type": "subtitle", "time": 21704.67, "timestamp": "06:01:44", "text": "必要だったんです、ええと、教えますね。"}, {"type": "subtitle", "time": 21708.548, "timestamp": "06:01:48", "text": "それではこのボタンについては、私自身の"}, {"type": "subtitle", "time": 21710.948, "timestamp": "06:01:50", "text": "サーバ。"}, {"type": "subtitle", "time": 21714.39, "timestamp": "06:01:54", "text": "そのため、このようなボタンはサーバーで一度だけ表示されます。"}, {"type": "subtitle", "time": 21717.99, "timestamp": "06:01:57", "text": "そのためには、同じことをしなければなりませんでした"}]
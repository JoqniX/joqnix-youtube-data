[{"type": "subtitle", "time": 6000.87, "timestamp": "01:40:00", "text": "ああ、落ち着かなきゃ。私はしなければならない"}, {"type": "subtitle", "time": 6004.189, "timestamp": "01:40:04", "text": "安定した。なぜ私は"}, {"type": "chat", "time": 6006.597, "timestamp": "01:40:06", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ig she wanted to do literature\\"}, {"type": "subtitle", "time": 6008.27, "timestamp": "01:40:08", "text": "これ？私はそれを取った"}, {"type": "subtitle", "time": 6011.59, "timestamp": "01:40:11", "text": "だって私は"}, {"type": "subtitle", "time": 6013.83, "timestamp": "01:40:13", "text": "作家になりたかったけれど、作家にはなれなかった。"}, {"type": "subtitle", "time": 6023.03, "timestamp": "01:40:23", "text": "私はモチベーションを失いました"}, {"type": "subtitle", "time": 6025.149, "timestamp": "01:40:25", "text": "わからないと思う"}, {"type": "chat", "time": 6027.995, "timestamp": "01:40:27", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that was yr reason?"}, {"type": "chat", "time": 6029.015, "timestamp": "01:40:29", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "X"}, {"type": "subtitle", "time": 6029.07, "timestamp": "01:40:29", "text": "なぜ私がチューブのことしか考えられないのか"}, {"type": "subtitle", "time": 6032.87, "timestamp": "01:40:32", "text": "音楽を聴きながら、人生をどうにか楽しんでいます。"}, {"type": "chat", "time": 6033.346, "timestamp": "01:40:33", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "X"}, {"type": "subtitle", "time": 6036.149, "timestamp": "01:40:36", "text": "どうにかして仕事が見つかると思う"}, {"type": "subtitle", "time": 6041.709, "timestamp": "01:40:41", "text": "えっと、入ったら"}, {"type": "subtitle", "time": 6044.709, "timestamp": "01:40:44", "text": "日本では、私には誰もいないので"}, {"type": "subtitle", "time": 6047.75, "timestamp": "01:40:47", "text": "私を支持してください。私は生きる術を学ばなければならない"}]
[{"type": "subtitle", "time": 19501.59, "timestamp": "05:25:01", "text": "それ？また、なぜこれが"}, {"type": "subtitle", "time": 19504.19, "timestamp": "05:25:04", "text": "この倍増で？待って、何？"}, {"type": "subtitle", "time": 19517.51, "timestamp": "05:25:17", "text": "マーク？なぜそれらは二重になっているのですか？私にさせて"}, {"type": "subtitle", "time": 19523.35, "timestamp": "05:25:23", "text": "これ。なぜ2倍になっているのですか？それは"}, {"type": "subtitle", "time": 19525.28, "timestamp": "05:25:25", "text": "意図的？忘れたかな？"}, {"type": "subtitle", "time": 19527.868, "timestamp": "05:25:27", "text": "[音楽]"}, {"type": "subtitle", "time": 19529.91, "timestamp": "05:25:29", "text": "何か？いいえ。これは"}, {"type": "subtitle", "time": 19531.788, "timestamp": "05:25:31", "text": "意図的。私は待つ。"}, {"type": "subtitle", "time": 19536.43, "timestamp": "05:25:36", "text": "いいえ、わかりません。消去。"}, {"type": "subtitle", "time": 19539.83, "timestamp": "05:25:39", "text": "わかった。えっと、ビデオのタイトルがあります、"}, {"type": "subtitle", "time": 19544.27, "timestamp": "05:25:44", "text": "動画IDがあれば、サムネイルを取得できます。今、私たちは"}, {"type": "subtitle", "time": 19547.23, "timestamp": "05:25:47", "text": "えっと、どこに置いたっけ"}, {"type": "subtitle", "time": 19550.91, "timestamp": "05:25:50", "text": "あなた？削除したと思います。"}, {"type": "subtitle", "time": 19554.23, "timestamp": "05:25:54", "text": "はぁ？削除しました。ああ、そうだね、"}, {"type": "subtitle", "time": 19558.708, "timestamp": "05:25:58", "text": "それでは、それに取り組んでください。つまり、サムネイルですよね？"}]
[{"type": "subtitle", "time": 23171.07, "timestamp": "06:26:11", "text": "[音楽]"}, {"type": "subtitle", "time": 23180.59, "timestamp": "06:26:20", "text": "おお。私には2つのやり方があります"}, {"type": "subtitle", "time": 23183.27, "timestamp": "06:26:23", "text": "ええ、私には2つの方法があります"}, {"type": "subtitle", "time": 23187.11, "timestamp": "06:26:27", "text": "Fコマンド。 1つは、等号を使うことができます"}, {"type": "subtitle", "time": 23188.43, "timestamp": "06:26:28", "text": "そしてさらに"}, {"type": "subtitle", "time": 23192.11, "timestamp": "06:26:32", "text": "よりも。同等以上"}, {"type": "subtitle", "time": 23196.19, "timestamp": "06:26:36", "text": "シンボル。ああ、なんてことだ、リナだ。こんにちは。"}, {"type": "subtitle", "time": 23199.91, "timestamp": "06:26:39", "text": "こんにちは。こんにちは、ルミさん。ルミ。"}, {"type": "subtitle", "time": 23201.83, "timestamp": "06:26:41", "text": "ルメニア。それがあなたのニックネームですよね？私"}, {"type": "subtitle", "time": 23207.15, "timestamp": "06:26:47", "text": "忘れた。うん。ルミニア。ヒマ。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 23210.99, "timestamp": "06:26:50", "text": "うん。こんにちは。ルミナル。こんにちは。"}, {"type": "subtitle", "time": 23214.59, "timestamp": "06:26:54", "text": "こんにちは。私たちはただ"}, {"type": "subtitle", "time": 23218.75, "timestamp": "06:26:58", "text": "えーっと、頭のいいもの"}]
[{"type": "subtitle", "time": 662.91, "timestamp": "00:11:02", "text": "えっと、それは"}, {"type": "subtitle", "time": 664.43, "timestamp": "00:11:04", "text": "ランニング"}, {"type": "subtitle", "time": 670.75, "timestamp": "00:11:10", "text": "地元で。えっと、私は"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "活動システム"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "どこで覚えているか覚えていない"}, {"type": "subtitle", "time": 683.55, "timestamp": "00:11:23", "text": "以前は～していた"}, {"type": "subtitle", "time": 686.91, "timestamp": "00:11:26", "text": "活動"}, {"type": "subtitle", "time": 689.75, "timestamp": "00:11:29", "text": "州。ちょっと挨拶しに来ました。こんにちは。"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "気をつけて。お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 704.55, "timestamp": "00:11:44", "text": "覚えていない。私は自分が何をしたか覚えていない"}]
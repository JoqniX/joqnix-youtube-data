[{"type": "subtitle", "time": 3002.51, "timestamp": "00:50:02", "text": "時間が短すぎるように感じます"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "知る。ジョック、俺は何をしたいんだ？教えて"}, {"type": "subtitle", "time": 3017.75, "timestamp": "00:50:17", "text": "それは私にも当てはまる。なんでしょう？何てことだ。"}, {"type": "subtitle", "time": 3018.99, "timestamp": "00:50:18", "text": "あなたは何を"}, {"type": "subtitle", "time": 3025.589, "timestamp": "00:50:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3028.15, "timestamp": "00:50:28", "text": "つまり、送ることができたら嬉しいのですが"}, {"type": "subtitle", "time": 3030.63, "timestamp": "00:50:30", "text": "この神の代わりにウェブサイトへ"}, {"type": "subtitle", "time": 3031.39, "timestamp": "00:50:31", "text": "これ"}, {"type": "subtitle", "time": 3033.829, "timestamp": "00:50:33", "text": "ポイント。誰がチェックするんだろう"}, {"type": "subtitle", "time": 3035.63, "timestamp": "00:50:35", "text": "これ"}, {"type": "subtitle", "time": 3038.75, "timestamp": "00:50:38", "text": "カード？ウェブサイトは"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "良くなったでしょ？ウェブサイトの方が良い。誰"}, {"type": "subtitle", "time": 3052.71, "timestamp": "00:50:52", "text": "スコア？本文を更新しました。だから、当然のことながら"}, {"type": "subtitle", "time": 3054.95, "timestamp": "00:50:54", "text": "今すぐ接続してください。"}, {"type": "subtitle", "time": 3056.43, "timestamp": "00:50:56", "text": "それはすべきです"}, {"type": "subtitle", "time": 3059.87, "timestamp": "00:50:59", "text": "フックですが、そうではありません"}]
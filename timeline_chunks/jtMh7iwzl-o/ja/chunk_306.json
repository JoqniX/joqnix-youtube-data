[{"type": "subtitle", "time": 18366.67, "timestamp": "05:06:06", "text": "は。手に入れた"}, {"type": "subtitle", "time": 18393.27, "timestamp": "05:06:33", "text": "今のところ11人です。はい、11個です。"}, {"type": "subtitle", "time": 18395.31, "timestamp": "05:06:35", "text": "それが動画のタイトルです"}, {"type": "subtitle", "time": 18398.19, "timestamp": "05:06:38", "text": "そしてビデオ"}, {"type": "subtitle", "time": 18402.11, "timestamp": "05:06:42", "text": "ID。私たちが"}, {"type": "subtitle", "time": 18406.15, "timestamp": "05:06:46", "text": "必要だ。大丈夫。さて、ここで質問です"}, {"type": "subtitle", "time": 18410.91, "timestamp": "05:06:50", "text": "尋ねた。運動選手は聞く。あなた"}, {"type": "subtitle", "time": 18412.75, "timestamp": "05:06:52", "text": "これを持って"}, {"type": "subtitle", "time": 18416.31, "timestamp": "05:06:56", "text": "男。あなたはこれを持っています"}, {"type": "subtitle", "time": 18419.35, "timestamp": "05:06:59", "text": "あなたはそれをずっと前に作ったのですね。マニュアル"}]
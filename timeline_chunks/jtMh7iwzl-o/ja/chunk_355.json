[{"type": "subtitle", "time": 21302.67, "timestamp": "05:55:02", "text": "つまり、5,000ミリ秒です。"}, {"type": "subtitle", "time": 21311.88, "timestamp": "05:55:11", "text": "から？何が"}, {"type": "subtitle", "time": 21314.91, "timestamp": "05:55:14", "text": "[音楽]"}, {"type": "subtitle", "time": 21318.31, "timestamp": "05:55:18", "text": "これ？これは"}, {"type": "subtitle", "time": 21321.43, "timestamp": "05:55:21", "text": "ああ、なんてことだ。私が"}, {"type": "subtitle", "time": 21326.99, "timestamp": "05:55:26", "text": "それは私が思っているようなものではない。"}, {"type": "subtitle", "time": 21329.59, "timestamp": "05:55:29", "text": "右。これは最初のストリームです。"}, {"type": "subtitle", "time": 21331.07, "timestamp": "05:55:31", "text": "[音楽]"}, {"type": "subtitle", "time": 21333.91, "timestamp": "05:55:33", "text": "わかった。つまり、項目は2つあります。 1つは"}, {"type": "subtitle", "time": 21335.67, "timestamp": "05:55:35", "text": "私の朝の配信と2番目は"}, {"type": "subtitle", "time": 21338.868, "timestamp": "05:55:38", "text": "配信スケジュール。はい。スケジュールと"}, {"type": "subtitle", "time": 21340.35, "timestamp": "05:55:40", "text": "朝の小川。"}, {"type": "subtitle", "time": 21343.83, "timestamp": "05:55:43", "text": "わかった。では、私はどこで間違えたのでしょうか？"}, {"type": "subtitle", "time": 21347.788, "timestamp": "05:55:47", "text": "こんな風に振る舞うなんて？私はどこに行ったの？"}, {"type": "subtitle", "time": 21351.19, "timestamp": "05:55:51", "text": "間違っている？サムネイル画像その1。私たちは名前をつけた"}, {"type": "subtitle", "time": 21353.51, "timestamp": "05:55:53", "text": "でも、そうですよね？"}, {"type": "subtitle", "time": 21356.99, "timestamp": "05:55:56", "text": "ええ、名前は諦めました"}, {"type": "subtitle", "time": 21359.07, "timestamp": "05:55:59", "text": "それから。何が"}]
[{"type": "subtitle", "time": 10863.51, "timestamp": "03:01:03", "text": "もの。プロユーザーは埋め込むことができます"}, {"type": "subtitle", "time": 10866.83, "timestamp": "03:01:06", "text": "貼り付けずにコンテンツを表示する。何"}, {"type": "subtitle", "time": 10869.63, "timestamp": "03:01:09", "text": "えっ？何"}, {"type": "subtitle", "time": 10871.469, "timestamp": "03:01:11", "text": "えっ？"}, {"type": "subtitle", "time": 10880.349, "timestamp": "03:01:20", "text": "なんだって？プロにお金を払わなければならない"}, {"type": "subtitle", "time": 10889.36, "timestamp": "03:01:29", "text": "プロ。ああ、"}, {"type": "subtitle", "time": 10891.95, "timestamp": "03:01:31", "text": "[音楽]"}, {"type": "subtitle", "time": 10905.309, "timestamp": "03:01:45", "text": "他に何かください。来る"}, {"type": "subtitle", "time": 10908.75, "timestamp": "03:01:48", "text": "の上。ところで、お元気ですか？ハダシュ。良い"}]
[{"type": "subtitle", "time": 22441.628, "timestamp": "06:14:01", "text": "Bella Box は、"}, {"type": "subtitle", "time": 22445.27, "timestamp": "06:14:05", "text": "願い。そうそう。忘れた。あなたはできる"}, {"type": "subtitle", "time": 22448.628, "timestamp": "06:14:08", "text": "実際に今すぐそうしてください。なぜなら、それは"}, {"type": "subtitle", "time": 22450.99, "timestamp": "06:14:10", "text": "視聴者のビデオを送信します、"}, {"type": "subtitle", "time": 22454.59, "timestamp": "06:14:14", "text": "右？ああ、君なら本当にできるよ。しかし"}, {"type": "subtitle", "time": 22457.35, "timestamp": "06:14:17", "text": "どちらにしても、"}, {"type": "subtitle", "time": 22465.35, "timestamp": "06:14:25", "text": "もの。つまり、この設定はIRLで使用されているということです"}, {"type": "subtitle", "time": 22468.31, "timestamp": "06:14:28", "text": "実際に旅行しているストリーマー"}, {"type": "subtitle", "time": 22471.11, "timestamp": "06:14:31", "text": "ストリーマーは、"}, {"type": "subtitle", "time": 22473.67, "timestamp": "06:14:33", "text": "大きなバックパックと、その他諸々。これは"}, {"type": "subtitle", "time": 22476.47, "timestamp": "06:14:36", "text": "もっと安価な方法という意味で。あなたはしない"}, {"type": "subtitle", "time": 22478.39, "timestamp": "06:14:38", "text": "買う必要がないのに"}, {"type": "subtitle", "time": 22483.47, "timestamp": "06:14:43", "text": "高価な実物バックパックキット。その代わり"}, {"type": "subtitle", "time": 22485.07, "timestamp": "06:14:45", "text": "えっと"}, {"type": "subtitle", "time": 22488.47, "timestamp": "06:14:48", "text": "あなたもサーバーを持つことができます"}, {"type": "subtitle", "time": 22491.35, "timestamp": "06:14:51", "text": "バックパックに入れるか、クラウドバックを使用します"}, {"type": "subtitle", "time": 22493.67, "timestamp": "06:14:53", "text": "クラウドサーバーのようなものからストリーミングするだけです"}, {"type": "subtitle", "time": 22495.43, "timestamp": "06:14:55", "text": "携帯電話でクラウドに送信"}, {"type": "subtitle", "time": 22498.548, "timestamp": "06:14:58", "text": "クラウドはそれを自宅のOBSに送信するか、"}]
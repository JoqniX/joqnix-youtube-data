[{"type": "subtitle", "time": 16501.91, "timestamp": "04:35:01", "text": "もちろん、戦争を利用することもできます"}, {"type": "subtitle", "time": 16504.109, "timestamp": "04:35:04", "text": "チャネル。"}, {"type": "subtitle", "time": 16506.39, "timestamp": "04:35:06", "text": "うん。そうそう。うん、うん、うん、うん。"}, {"type": "subtitle", "time": 16508.83, "timestamp": "04:35:08", "text": "これをコピーしてください"}, {"type": "subtitle", "time": 16512.15, "timestamp": "04:35:12", "text": "もの。神に誓って、もしこれがこれなら"}, {"type": "subtitle", "time": 16515.91, "timestamp": "04:35:15", "text": "うまくいかなかったら、泣いちゃうよ。"}, {"type": "subtitle", "time": 16531.551, "timestamp": "04:35:31", "text": "[音楽]"}, {"type": "subtitle", "time": 16535.551, "timestamp": "04:35:35", "text": "泣く。私は実際に"}, {"type": "subtitle", "time": 16538.269, "timestamp": "04:35:38", "text": "泣く。"}, {"type": "subtitle", "time": 16541.07, "timestamp": "04:35:41", "text": "いや、"}, {"type": "subtitle", "time": 16550.23, "timestamp": "04:35:50", "text": "シャナ、別の時間にしても大丈夫ですよ。"}, {"type": "subtitle", "time": 16553.429, "timestamp": "04:35:53", "text": "大丈夫。よし、我々の目標は"}, {"type": "subtitle", "time": 16557.029, "timestamp": "04:35:57", "text": "3つのデータ。はい、3つのストリームデータです。"}]
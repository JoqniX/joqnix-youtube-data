[{"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "男。モバイルアプリを作るべきか、それとも"}, {"type": "subtitle", "time": 3140.23, "timestamp": "00:52:20", "text": "何か？わからない。どうすれば"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "デバイス？究極のものを手に入れるにはどうすればいいですか"}, {"type": "subtitle", "time": 3165.71, "timestamp": "00:52:45", "text": "すべてのゲームには"}, {"type": "subtitle", "time": 3168.51, "timestamp": "00:52:48", "text": "私はこれが欲しい"}, {"type": "subtitle", "time": 3172.549, "timestamp": "00:52:52", "text": "モード。ジョック・ニックス。私のリンクと"}, {"type": "subtitle", "time": 3175.27, "timestamp": "00:52:55", "text": "プロフィールとかそういうもの。友達が遊ぶ"}]
[{"type": "subtitle", "time": 18305.75, "timestamp": "05:05:05", "text": "感度。ああ、見た目が"}, {"type": "subtitle", "time": 18319.91, "timestamp": "05:05:19", "text": "待って、待って。いや、待って。追跡がどれほど密かか"}, {"type": "subtitle", "time": 18322.07, "timestamp": "05:05:22", "text": "ロックされる前に取得する必要があります"}, {"type": "subtitle", "time": 18324.788, "timestamp": "05:05:24", "text": "位置情報と追跡停止？あ、待って。"}, {"type": "subtitle", "time": 18326.788, "timestamp": "05:05:26", "text": "どうでも。これは4つであるべきだ。一度もない"}, {"type": "subtitle", "time": 18329.67, "timestamp": "05:05:29", "text": "心。では、私が探しているものは何だろうか？のように"}, {"type": "subtitle", "time": 18338.39, "timestamp": "05:05:38", "text": "えっと、私がしたいときにどうすればいいですか"}, {"type": "subtitle", "time": 18340.788, "timestamp": "05:05:40", "text": "私はこんな感じです、まだ見えます"}, {"type": "subtitle", "time": 18344.75, "timestamp": "05:05:44", "text": "他のコンテンツ"}, {"type": "subtitle", "time": 18347.708, "timestamp": "05:05:47", "text": "側。"}, {"type": "subtitle", "time": 18357.39, "timestamp": "05:05:57", "text": "平均？"}, {"type": "subtitle", "time": 18359.47, "timestamp": "05:05:59", "text": "待って。"}]
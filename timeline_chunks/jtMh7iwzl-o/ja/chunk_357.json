[{"type": "subtitle", "time": 21421.31, "timestamp": "05:57:01", "text": "男？いいえ。"}, {"type": "subtitle", "time": 21441.35, "timestamp": "05:57:21", "text": "そうです、この男は、一時停止ですか"}, {"type": "subtitle", "time": 21444.51, "timestamp": "05:57:24", "text": "あれ？まさかボスじゃないよね？"}, {"type": "subtitle", "time": 21447.23, "timestamp": "05:57:27", "text": "あれ。ちょっと待ってください"}, {"type": "subtitle", "time": 21449.39, "timestamp": "05:57:29", "text": "誰が"}, {"type": "subtitle", "time": 21452.27, "timestamp": "05:57:32", "text": "犯人。"}, {"type": "subtitle", "time": 21455.67, "timestamp": "05:57:35", "text": "ああ、これは一体どこから来たんだ？待って、"}, {"type": "subtitle", "time": 21458.27, "timestamp": "05:57:38", "text": "これらを無効にする。無効にする"}, {"type": "subtitle", "time": 21462.07, "timestamp": "05:57:42", "text": "これ。ディサ。これは何ですか？削除させてください"}, {"type": "subtitle", "time": 21463.548, "timestamp": "05:57:43", "text": "これ。しないで"}, {"type": "subtitle", "time": 21469.548, "timestamp": "05:57:49", "text": "ケア。拡大の犯人は誰ですか"}, {"type": "subtitle", "time": 21479.27, "timestamp": "05:57:59", "text": "これ。あのね？いや、待って。その代わり"}]
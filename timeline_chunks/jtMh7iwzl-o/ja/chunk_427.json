[{"type": "subtitle", "time": 25621.628, "timestamp": "07:07:01", "text": "そしてそれは"}, {"type": "subtitle", "time": 25625.468, "timestamp": "07:07:05", "text": "コントロール。ズームするにはどうすればいいですか？"}, {"type": "subtitle", "time": 25628.91, "timestamp": "07:07:08", "text": "で？待って、どうやってズームインするの？"}, {"type": "subtitle", "time": 25633.59, "timestamp": "07:07:13", "text": "わかった。わかった。えっと、赤いのは"}, {"type": "subtitle", "time": 25636.75, "timestamp": "07:07:16", "text": "YouTube、赤"}, {"type": "subtitle", "time": 25640.39, "timestamp": "07:07:20", "text": "星、そして紫色のもの、すみれ色"}, {"type": "subtitle", "time": 25649.31, "timestamp": "07:07:29", "text": "トゥイッチ。これはフェードアウトしています、"}, {"type": "subtitle", "time": 25652.9, "timestamp": "07:07:32", "text": "しかし、もしあなたが"}, {"type": "subtitle", "time": 25661.67, "timestamp": "07:07:41", "text": "[音楽]"}, {"type": "subtitle", "time": 25666.27, "timestamp": "07:07:46", "text": "何でも。ええ、この白っぽい"}, {"type": "subtitle", "time": 25670.03, "timestamp": "07:07:50", "text": "星。白っぽい"}, {"type": "subtitle", "time": 25673.35, "timestamp": "07:07:53", "text": "星、つまり"}, {"type": "subtitle", "time": 25675.67, "timestamp": "07:07:55", "text": "ええ、それは何日も続くでしょう。私は受け取っています"}, {"type": "subtitle", "time": 25679.59, "timestamp": "07:07:59", "text": "休憩。だから私はジョックニックを着ているんです"}]
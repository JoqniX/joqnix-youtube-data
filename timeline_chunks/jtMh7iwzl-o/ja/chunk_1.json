[{"type": "subtitle", "time": 63.59, "timestamp": "00:01:03", "text": "ということで、ジョークマラソンを開催します。"}, {"type": "subtitle", "time": 67.03, "timestamp": "00:01:07", "text": "50日目の夜の配信。私たちは"}, {"type": "subtitle", "time": 71.75, "timestamp": "00:01:11", "text": "午後6時に始まるはずだったのですが、"}, {"type": "subtitle", "time": 75.03, "timestamp": "00:01:15", "text": "私の都合で時間を変更しました"}, {"type": "subtitle", "time": 77.99, "timestamp": "00:01:17", "text": "えっと、私が時間を変えたせいで"}, {"type": "subtitle", "time": 79.31, "timestamp": "00:01:19", "text": "間"}, {"type": "subtitle", "time": 82.87, "timestamp": "00:01:22", "text": "予期せず、一日中寝ていた。"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "大丈夫です。月末だ。"}, {"type": "subtitle", "time": 93.63, "timestamp": "00:01:33", "text": "えーと、やっていたことを終わらせましょう"}, {"type": "subtitle", "time": 96.87, "timestamp": "00:01:36", "text": "実行中。わかった。よし。仕上げます"}, {"type": "subtitle", "time": 100.27000000000001, "timestamp": "00:01:40", "text": "私たちがやっていたこと、そして"}, {"type": "subtitle", "time": 109.27000000000001, "timestamp": "00:01:49", "text": "可能。可能であれば、早めに寝ます。"}, {"type": "subtitle", "time": 114.83, "timestamp": "00:01:54", "text": "うん、私たちは"}, {"type": "subtitle", "time": 117.83, "timestamp": "00:01:57", "text": "最高。これまでのところ、ビリービリーのログは"}]
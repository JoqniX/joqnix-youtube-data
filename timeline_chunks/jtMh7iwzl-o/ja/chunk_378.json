[{"type": "subtitle", "time": 22680.23, "timestamp": "06:18:00", "text": "えーと、キット2番みたいなプランは"}, {"type": "subtitle", "time": 22682.15, "timestamp": "06:18:02", "text": "インストールするか、"}, {"type": "subtitle", "time": 22685.59, "timestamp": "06:18:05", "text": "インストールにはSammyストリーマーが付属しています"}, {"type": "subtitle", "time": 22687.948, "timestamp": "06:18:07", "text": "ボードを混ぜ合わせる"}, {"type": "subtitle", "time": 22690.868, "timestamp": "06:18:10", "text": "そのキットには2つ目のキットが付属しています"}, {"type": "subtitle", "time": 22693.39, "timestamp": "06:18:13", "text": "3番目は、それらすべてのようなものです"}, {"type": "subtitle", "time": 22696.27, "timestamp": "06:18:16", "text": "プラス何か他のもの、あるいは私が知らない何か"}, {"type": "subtitle", "time": 22699.03, "timestamp": "06:18:19", "text": "知ってるけど、それをしたいんだけど、"}, {"type": "subtitle", "time": 22706.15, "timestamp": "06:18:26", "text": "ええ、でも、今の私の問題は"}, {"type": "subtitle", "time": 22710.07, "timestamp": "06:18:30", "text": "セットアップは、Bella Box が良いかどうかではありません。私は"}, {"type": "subtitle", "time": 22713.07, "timestamp": "06:18:33", "text": "自分がその費用を払っていることを嬉しく思います。 10ドル"}, {"type": "subtitle", "time": 22716.15, "timestamp": "06:18:36", "text": "今月もすべて順調です。知っている。しかし"}, {"type": "subtitle", "time": 22719.23, "timestamp": "06:18:39", "text": "問題は、もし私の"}, {"type": "subtitle", "time": 22723.27, "timestamp": "06:18:43", "text": "PCがクラッシュしたり、停電が発生したりした場合、"}, {"type": "subtitle", "time": 22724.19, "timestamp": "06:18:44", "text": "一度もない"}, {"type": "subtitle", "time": 22727.628, "timestamp": "06:18:47", "text": "知る。私には永遠に分からないだろう。"}, {"type": "subtitle", "time": 22731.75, "timestamp": "06:18:51", "text": "まるでそうしなければならないかのように、私は知っているかもしれないと思う。私"}, {"type": "subtitle", "time": 22734.548, "timestamp": "06:18:54", "text": "わからない。通知してくれるかもしれません。私はしません"}, {"type": "subtitle", "time": 22738.83, "timestamp": "06:18:58", "text": "知る。でも、私の"}]
[{"type": "subtitle", "time": 23464.07, "timestamp": "06:31:04", "text": "ああ、0より小さい。待って、待って、"}, {"type": "subtitle", "time": 23465.948, "timestamp": "06:31:05", "text": "待って、待って、待って、待って。何"}, {"type": "subtitle", "time": 23471.948, "timestamp": "06:31:11", "text": "もしもし、もし待って、私の脳が今カチッと音を立てた。"}, {"type": "subtitle", "time": 23476.548, "timestamp": "06:31:16", "text": "ああ、もし私たちが次のようにしたらどうなるだろうか"}, {"type": "subtitle", "time": 23478.99, "timestamp": "06:31:18", "text": "のような"}, {"type": "subtitle", "time": 23483.19, "timestamp": "06:31:23", "text": "スケジュールストリームが2つある場合はどうなりますか？"}, {"type": "subtitle", "time": 23485.43, "timestamp": "06:31:25", "text": "いや、いや。例えば、その２つがそうだったら。二"}, {"type": "subtitle", "time": 23487.75, "timestamp": "06:31:27", "text": "スケジュールされたストリームでは、何が起こるか"}, {"type": "subtitle", "time": 23493.948, "timestamp": "06:31:33", "text": "待って。"}, {"type": "subtitle", "time": 23496.468, "timestamp": "06:31:36", "text": "えっと、待って、何の話をしてたんだっけ？"}, {"type": "subtitle", "time": 23500.788, "timestamp": "06:31:40", "text": "疑問符？ああ、わかりました。ああ、神様。えっと、"}, {"type": "subtitle", "time": 23502.708, "timestamp": "06:31:42", "text": "わかった。これが私の考えです。わかった、"}, {"type": "subtitle", "time": 23505.23, "timestamp": "06:31:45", "text": "これくらい。これまで"}, {"type": "subtitle", "time": 23508.23, "timestamp": "06:31:48", "text": "多くの。あなたは夢を覚えていますか？時々"}, {"type": "subtitle", "time": 23511.27, "timestamp": "06:31:51", "text": "私は夢の内容を鮮明に覚えている。"}, {"type": "subtitle", "time": 23513.99, "timestamp": "06:31:53", "text": "しかし、それは暗い夢ばかりだった。"}]
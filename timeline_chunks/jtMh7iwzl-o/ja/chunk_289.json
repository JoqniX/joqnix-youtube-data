[{"type": "subtitle", "time": 17342.27, "timestamp": "04:49:02", "text": "まるで私が終えた流れのように"}, {"type": "subtitle", "time": 17344.948, "timestamp": "04:49:04", "text": "ストリーミング配信。例えば、こうすれば、"}, {"type": "subtitle", "time": 17347.47, "timestamp": "04:49:07", "text": "次のように表示されます"}, {"type": "subtitle", "time": 17349.788, "timestamp": "04:49:09", "text": "２２。何が"}, {"type": "subtitle", "time": 17353.868, "timestamp": "04:49:13", "text": "これ？これは私が終了した配信ではないか"}, {"type": "subtitle", "time": 17358.948, "timestamp": "04:49:18", "text": "今日？なぜ？なぜこれを見せるのですか？なぜ？"}, {"type": "subtitle", "time": 17362.99, "timestamp": "04:49:22", "text": "待って、これって私がやった配信じゃない？"}, {"type": "subtitle", "time": 17366.3, "timestamp": "04:49:26", "text": "今日？ええ、これは今朝のことです"}, {"type": "subtitle", "time": 17368.11, "timestamp": "04:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17370.35, "timestamp": "04:49:30", "text": "4時間配信"}, {"type": "subtitle", "time": 17381.59, "timestamp": "04:49:41", "text": "はぁ？おお。ああ、私は思う、私は思う、私は思う"}, {"type": "subtitle", "time": 17383.67, "timestamp": "04:49:43", "text": "なんとなくわかる。それは、"}, {"type": "subtitle", "time": 17386.55, "timestamp": "04:49:46", "text": "ストリームをスケジュールすると、"}, {"type": "subtitle", "time": 17392.31, "timestamp": "04:49:52", "text": "即座に。ストリームをスケジュールすると、"}, {"type": "subtitle", "time": 17394.31, "timestamp": "04:49:54", "text": "すぐに理解できるとは限らない。あなたが持っている"}, {"type": "subtitle", "time": 17395.47, "timestamp": "04:49:55", "text": "に"}]
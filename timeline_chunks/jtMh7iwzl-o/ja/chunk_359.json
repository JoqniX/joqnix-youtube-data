[{"type": "subtitle", "time": 21542.548, "timestamp": "05:59:02", "text": "IDタイトルは保存されています。犯人は"}, {"type": "subtitle", "time": 21555.19, "timestamp": "05:59:15", "text": "知る。最新の動画データをストリーミング配信します。さあ"}, {"type": "subtitle", "time": 21556.51, "timestamp": "05:59:16", "text": "言い換えると"}, {"type": "subtitle", "time": 21559.788, "timestamp": "05:59:19", "text": "それ。これをここに置いてください。"}, {"type": "subtitle", "time": 21564.07, "timestamp": "05:59:24", "text": "それをあそこに置いてください。そしてそれを"}, {"type": "subtitle", "time": 21574.548, "timestamp": "05:59:34", "text": "ええ、これはデータにも影響します。それで"}, {"type": "subtitle", "time": 21577.07, "timestamp": "05:59:37", "text": "ストリームビデオデータはこちら"}, {"type": "subtitle", "time": 21579.52, "timestamp": "05:59:39", "text": "男。そして私はこれを変える"}, {"type": "subtitle", "time": 21580.67, "timestamp": "05:59:40", "text": "[音楽]"}, {"type": "subtitle", "time": 21585.83, "timestamp": "05:59:45", "text": "最新のビデオデータをストリーミング"}, {"type": "subtitle", "time": 21590.11, "timestamp": "05:59:50", "text": "えっと、ID。わかった。すべて順調に見えるので"}, {"type": "subtitle", "time": 21592.35, "timestamp": "05:59:52", "text": "遠い。保存して"}]
[{"type": "subtitle", "time": 7880.43, "timestamp": "02:11:20", "text": "正直、自分が何を望んでいるのか分からないけど、"}, {"type": "subtitle", "time": 7883.35, "timestamp": "02:11:23", "text": "私は自分が何を望んでいるかを何度も言った"}, {"type": "subtitle", "time": 7892.149, "timestamp": "02:11:32", "text": "右？この「プムプム」という音はどこから聞こえますか？"}, {"type": "subtitle", "time": 7907.31, "timestamp": "02:11:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7915.149, "timestamp": "02:11:55", "text": "できる？こんにちは、猫ちゃんたち。ようこそ"}, {"type": "subtitle", "time": 7917.709, "timestamp": "02:11:57", "text": "ストリーム。フォローアップありがとうございます"}]
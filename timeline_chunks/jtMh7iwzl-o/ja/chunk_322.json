[{"type": "subtitle", "time": 19321.99, "timestamp": "05:22:01", "text": "つまり、これが私が使っているソフトウェアです。"}, {"type": "subtitle", "time": 19324.788, "timestamp": "05:22:04", "text": "Sammy、OBS関連の作業ができるようになる"}, {"type": "subtitle", "time": 19328.15, "timestamp": "05:22:08", "text": "それと、YouTubeやTwitch関連のもの全部。それで"}, {"type": "subtitle", "time": 19331.23, "timestamp": "05:22:11", "text": "とにかく、私たちが何者であるかに戻ると"}, {"type": "subtitle", "time": 19334.35, "timestamp": "05:22:14", "text": "実行中。えーと、ストリームへようこそ"}, {"type": "subtitle", "time": 19336.788, "timestamp": "05:22:16", "text": "電話。お元気でお過ごしでしょうか。こんにちは。"}, {"type": "subtitle", "time": 19344.91, "timestamp": "05:22:24", "text": "なぜ私は"}, {"type": "subtitle", "time": 19348.83, "timestamp": "05:22:28", "text": "えっと、私は喋りまくって、あなたも"}, {"type": "subtitle", "time": 19352.07, "timestamp": "05:22:32", "text": "知っている、私は、私は、"}, {"type": "subtitle", "time": 19353.99, "timestamp": "05:22:33", "text": "説明する"}, {"type": "subtitle", "time": 19356.91, "timestamp": "05:22:36", "text": "理解できる"}, {"type": "subtitle", "time": 19366.55, "timestamp": "05:22:46", "text": "痛み。こんにちは。元気ですか？"}, {"type": "subtitle", "time": 19368.628, "timestamp": "05:22:48", "text": "理由はわからないけど、あなたの話を聞いていると"}, {"type": "subtitle", "time": 19372.35, "timestamp": "05:22:52", "text": "会話は不思議と心を落ち着かせる。私たちは本当に"}]
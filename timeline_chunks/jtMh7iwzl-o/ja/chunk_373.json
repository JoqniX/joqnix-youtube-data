[{"type": "subtitle", "time": 22382.35, "timestamp": "06:13:02", "text": "えっ、彼は何を隠したの？"}, {"type": "subtitle", "time": 22385.19, "timestamp": "06:13:05", "text": "ああ、そうそう、スポンサーにならなきゃいけなかった"}, {"type": "subtitle", "time": 22387.91, "timestamp": "06:13:07", "text": "ユーザー：スポンサーになるのを忘れてた"}, {"type": "subtitle", "time": 22389.91, "timestamp": "06:13:09", "text": "そうすれば、ベラボックスにしかアクセスできません"}, {"type": "subtitle", "time": 22391.948, "timestamp": "06:13:11", "text": "プレミアオーケークラウドワンうんうん"}, {"type": "subtitle", "time": 22395.91, "timestamp": "06:13:15", "text": "ああ、それを忘れてたよ。だからもっと"}, {"type": "subtitle", "time": 22398.23, "timestamp": "06:13:18", "text": "リレーサーバーのようなものなので、つまり"}, {"type": "subtitle", "time": 22401.83, "timestamp": "06:13:21", "text": "携帯電話からサーバーにストリーミングして"}, {"type": "subtitle", "time": 22406.868, "timestamp": "06:13:26", "text": "サーバー関連のもの、URL を入力します。"}, {"type": "subtitle", "time": 22408.548, "timestamp": "06:13:28", "text": "サーバー"}, {"type": "subtitle", "time": 22410.788, "timestamp": "06:13:30", "text": "えっと、あなたがストリーミングしているところは"}, {"type": "subtitle", "time": 22420.39, "timestamp": "06:13:40", "text": "OBS OBS、ええ、ただ使うだけでいいんです"}, {"type": "subtitle", "time": 22423.83, "timestamp": "06:13:43", "text": "OBSでストリーミングするには"}, {"type": "subtitle", "time": 22426.948, "timestamp": "06:13:46", "text": "プラットフォームにストリームして、"}, {"type": "subtitle", "time": 22429.03, "timestamp": "06:13:49", "text": "あなたの携帯電話にその物を送る"}, {"type": "subtitle", "time": 22432.31, "timestamp": "06:13:52", "text": "OBSはそういう感じですね。あ、待って。ゴースティ、あなたは"}, {"type": "subtitle", "time": 22434.948, "timestamp": "06:13:54", "text": "そうしたいならそうすればいい。忘れた。うん、"}, {"type": "subtitle", "time": 22437.51, "timestamp": "06:13:57", "text": "あなたならできますよ。あなたは何を使っていますか"}, {"type": "subtitle", "time": 22439.43, "timestamp": "06:13:59", "text": "モバイル配信にはどのアプリを使っていますか？"}]
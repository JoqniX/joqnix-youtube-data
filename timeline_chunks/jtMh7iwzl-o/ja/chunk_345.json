[{"type": "subtitle", "time": 20700.19, "timestamp": "05:45:00", "text": "ライブ配信で、それらすべてが予定されています"}, {"type": "subtitle", "time": 20703.67, "timestamp": "05:45:03", "text": "情報。ストリーム2、3、4、私たちはただ"}, {"type": "subtitle", "time": 20705.23, "timestamp": "05:45:05", "text": "独立性が必要だ"}, {"type": "subtitle", "time": 20707.15, "timestamp": "05:45:07", "text": "個々のもの、"}, {"type": "subtitle", "time": 20709.35, "timestamp": "05:45:09", "text": "右？じゃあ、そうしましょう。"}, {"type": "subtitle", "time": 20711.59, "timestamp": "05:45:11", "text": "私たちはこれを必要としていない。私たちはそれを上に置いた"}, {"type": "subtitle", "time": 20713.23, "timestamp": "05:45:13", "text": "ここ。"}, {"type": "subtitle", "time": 20716.83, "timestamp": "05:45:16", "text": "こんにちは。えっと、身分証明書ですよね？"}, {"type": "subtitle", "time": 20722.11, "timestamp": "05:45:22", "text": "um ID はこれになります。だから私はコピーします"}, {"type": "subtitle", "time": 20726.91, "timestamp": "05:45:26", "text": "パスとaの中で"}, {"type": "subtitle", "time": 20730.43, "timestamp": "05:45:30", "text": "URLをここに載せました"}, {"type": "subtitle", "time": 20738.708, "timestamp": "05:45:38", "text": "これ。指定したい場合は"}, {"type": "subtitle", "time": 20741.59, "timestamp": "05:45:41", "text": "変数のようなコマンドまたはID"}, {"type": "subtitle", "time": 20744.59, "timestamp": "05:45:44", "text": "やらなければならないこと"}, {"type": "subtitle", "time": 20748.67, "timestamp": "05:45:48", "text": "スラッシュは戻るか、前向きスラッシュではありません"}, {"type": "subtitle", "time": 20751.59, "timestamp": "05:45:51", "text": "スラッシュとドル記号を推測してください"}, {"type": "subtitle", "time": 20754.31, "timestamp": "05:45:54", "text": "ラップで包むか、"}, {"type": "subtitle", "time": 20755.788, "timestamp": "05:45:55", "text": "何か"}, {"type": "subtitle", "time": 20758.23, "timestamp": "05:45:58", "text": "ええ、あまりよく知らないけど、そうですね"}]
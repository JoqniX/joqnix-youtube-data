[{"type": "subtitle", "time": 22142.49, "timestamp": "06:09:02", "text": "あなた？セット。いいえ。この子を育てたのは私です。いいえ。"}, {"type": "subtitle", "time": 22144.27, "timestamp": "06:09:04", "text": "[音楽]"}, {"type": "subtitle", "time": 22156.868, "timestamp": "06:09:16", "text": "ブロック。これらの人たちをここに入れて"}, {"type": "subtitle", "time": 22159.99, "timestamp": "06:09:19", "text": "隠して。わかった。ここ。まずは"}, {"type": "subtitle", "time": 22163.868, "timestamp": "06:09:23", "text": "この配列。配列を作成します"}, {"type": "subtitle", "time": 22166.83, "timestamp": "06:09:26", "text": "呼ばれる"}, {"type": "subtitle", "time": 22172.75, "timestamp": "06:09:32", "text": "待って。これは必要ですか？大丈夫です。その"}, {"type": "subtitle", "time": 22180.548, "timestamp": "06:09:40", "text": "ああ、繊維をありがとうございます。行く"}, {"type": "subtitle", "time": 22183.31, "timestamp": "06:09:43", "text": "女王。こんにちは。こんにちは。元気ですか"}, {"type": "subtitle", "time": 22190.788, "timestamp": "06:09:50", "text": "こんにちは。こんにちは。ああ、あなたはストリーミング配信をしていたんですね"}, {"type": "subtitle", "time": 22192.788, "timestamp": "06:09:52", "text": "朝から始まったんですよね？ええ、私は"}, {"type": "subtitle", "time": 22199.67, "timestamp": "06:09:59", "text": "それ。私は、そうすべきかどうか決めているようなものでした"}]
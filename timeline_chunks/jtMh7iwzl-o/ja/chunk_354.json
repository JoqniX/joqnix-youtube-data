[{"type": "subtitle", "time": 21264.59, "timestamp": "05:54:24", "text": "はぁ。これは誰からのものですか？"}, {"type": "subtitle", "time": 21267.99, "timestamp": "05:54:27", "text": "いや。まさかこの人からじゃないよね。"}, {"type": "subtitle", "time": 21269.948, "timestamp": "05:54:29", "text": "削除させてください"}, {"type": "subtitle", "time": 21273.47, "timestamp": "05:54:33", "text": "それ。あの男は一体どこから来たんだ？"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "[音楽]"}, {"type": "subtitle", "time": 21279.548, "timestamp": "05:54:39", "text": "待って。では、もう一度試してみましょう。さあ"}, {"type": "subtitle", "time": 21283.27, "timestamp": "05:54:43", "text": "見る。これも削除します。いいえ、私は"}, {"type": "subtitle", "time": 21284.91, "timestamp": "05:54:44", "text": "ふと思いついた"}, {"type": "subtitle", "time": 21287.948, "timestamp": "05:54:47", "text": "それ。これは何のデータですか？"}]
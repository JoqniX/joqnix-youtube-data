[{"type": "subtitle", "time": 18781.708, "timestamp": "05:13:01", "text": "[音楽]"}, {"type": "subtitle", "time": 18785.67, "timestamp": "05:13:05", "text": "はい、サムネイルで構いません。なぜだめですか？"}, {"type": "subtitle", "time": 18787.99, "timestamp": "05:13:07", "text": "では、これをコピーして貼り付けます"}, {"type": "subtitle", "time": 18792.35, "timestamp": "05:13:12", "text": "こんな感じです。わかった。動画で開いてください。"}, {"type": "subtitle", "time": 18795.39, "timestamp": "05:13:15", "text": "次にビデオ"}, {"type": "subtitle", "time": 18797.35, "timestamp": "05:13:17", "text": "サムネイル。わかった。えっと、待って待って待って"}, {"type": "subtitle", "time": 18800.628, "timestamp": "05:13:20", "text": "待って。それは良くない考えだ。待って。えっと、私たちは"}, {"type": "subtitle", "time": 18804.35, "timestamp": "05:13:24", "text": "IDをコピーしてください。うん、これ"}, {"type": "subtitle", "time": 18806.67, "timestamp": "05:13:26", "text": "1つ。わかった。"}, {"type": "subtitle", "time": 18810.07, "timestamp": "05:13:30", "text": "物体。こんにちは。こんにちは。こんにちは。そこで、私たちがすることは"}, {"type": "subtitle", "time": 18812.59, "timestamp": "05:13:32", "text": "代わりにこれ"}, {"type": "subtitle", "time": 18814.19, "timestamp": "05:13:34", "text": "なれ"}, {"type": "subtitle", "time": 18819.39, "timestamp": "05:13:39", "text": "サムネイル"}, {"type": "subtitle", "time": 18822.628, "timestamp": "05:13:42", "text": "動画のサムネイル。これをコピーして貼り付けてください"}, {"type": "subtitle", "time": 18835.67, "timestamp": "05:13:55", "text": "うん。こんにちは。それで、ジョックに聞くことになる"}, {"type": "subtitle", "time": 18837.39, "timestamp": "05:13:57", "text": "どうやってやるつもり？"}]
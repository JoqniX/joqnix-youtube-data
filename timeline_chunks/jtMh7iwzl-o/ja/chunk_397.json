[{"type": "subtitle", "time": 23821.708, "timestamp": "06:37:01", "text": "チョーク。しかしそれは"}, {"type": "subtitle", "time": 23824.948, "timestamp": "06:37:04", "text": "それでも私は、手っ取り早い方法を信じています。"}, {"type": "subtitle", "time": 23825.948, "timestamp": "06:37:05", "text": "それは"}, {"type": "subtitle", "time": 23829.11, "timestamp": "06:37:09", "text": "えっと、ハードにステッカーを貼ったんだけど"}, {"type": "subtitle", "time": 23831.868, "timestamp": "06:37:11", "text": "ルートは簡単"}, {"type": "subtitle", "time": 23836.468, "timestamp": "06:37:16", "text": "ルート。でも、それでも大丈夫。ああ、わかった。"}, {"type": "subtitle", "time": 23838.59, "timestamp": "06:37:18", "text": "待って。考える"}, {"type": "subtitle", "time": 23852.708, "timestamp": "06:37:32", "text": "ああ、待って、待って、待って、待って。私は手に入れた"}, {"type": "subtitle", "time": 23857.15, "timestamp": "06:37:37", "text": "一つのアイデア。ローカル変数を設定します。地元"}, {"type": "subtitle", "time": 23859.99, "timestamp": "06:37:39", "text": "変数。待って。番号そうに違いない。待って。"}, {"type": "subtitle", "time": 23867.91, "timestamp": "06:37:47", "text": "[音楽]"}, {"type": "subtitle", "time": 23870.868, "timestamp": "06:37:50", "text": "最善の方法は何ですか？一番良いのは何ですか？"}]
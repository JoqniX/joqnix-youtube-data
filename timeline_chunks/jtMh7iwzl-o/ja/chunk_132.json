[{"type": "subtitle", "time": 7920.39, "timestamp": "02:12:00", "text": "ビーム。調子はどうですか？そしてどのようにして"}, {"type": "subtitle", "time": 7922.109, "timestamp": "02:12:02", "text": "あなたは私を見つける"}, {"type": "subtitle", "time": 7924.88, "timestamp": "02:12:04", "text": "今日？使用できますか"}, {"type": "subtitle", "time": 7939.189, "timestamp": "02:12:19", "text": "どうすればいいのか知りたいだけです"}, {"type": "subtitle", "time": 7941.91, "timestamp": "02:12:21", "text": "プロキシサーバーか何かを作ってください。私"}, {"type": "subtitle", "time": 7950.91, "timestamp": "02:12:30", "text": "は。これはとても難しい"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "[音楽]"}]
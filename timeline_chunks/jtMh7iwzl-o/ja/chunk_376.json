[{"type": "subtitle", "time": 22562.99, "timestamp": "06:16:02", "text": "4,000。ああ、720"}, {"type": "subtitle", "time": 22567.11, "timestamp": "06:16:07", "text": "30. おお、これはすごい。わかった。待って。だからもし"}, {"type": "subtitle", "time": 22571.15, "timestamp": "06:16:11", "text": "1080 ああ 60 ああ 行きたい"}, {"type": "subtitle", "time": 22574.15, "timestamp": "06:16:14", "text": "待って、1080を手に入れよう、これはこんな感じになる"}, {"type": "subtitle", "time": 22576.03, "timestamp": "06:16:16", "text": "[音楽]"}, {"type": "subtitle", "time": 22579.39, "timestamp": "06:16:19", "text": "何がいくら支払うのか"}, {"type": "subtitle", "time": 22590.75, "timestamp": "06:16:30", "text": "貿易による増加"}, {"type": "subtitle", "time": 22592.99, "timestamp": "06:16:32", "text": "トランスコーディング。ああ、わかった。"}, {"type": "subtitle", "time": 22595.59, "timestamp": "06:16:35", "text": "わかった。では、それは一体何のためにあるのでしょうか？全て"}, {"type": "subtitle", "time": 22598.31, "timestamp": "06:16:38", "text": "右。私に何ができるというのですか？ゲームとしてはどうですか？"}, {"type": "subtitle", "time": 22604.52, "timestamp": "06:16:44", "text": "チェック。"}, {"type": "subtitle", "time": 22611.51, "timestamp": "06:16:51", "text": "えっと、何か書いてありますか？いいえ、そうではありません"}, {"type": "subtitle", "time": 22612.35, "timestamp": "06:16:52", "text": "言う"}, {"type": "subtitle", "time": 22615.99, "timestamp": "06:16:55", "text": "多くの。ええ、サイトは今復旧しました。それで、"}, {"type": "subtitle", "time": 22619.27, "timestamp": "06:16:59", "text": "RAMなどの仕様が記載されています。それで"}]
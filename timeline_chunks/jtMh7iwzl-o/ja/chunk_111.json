[{"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "他の皆もいて、私は"}, {"type": "subtitle", "time": 6670.79, "timestamp": "01:51:10", "text": "バンにはたくさんあります。あなたは既にたくさん持っていた。あなた"}, {"type": "subtitle", "time": 6673.51, "timestamp": "01:51:13", "text": "少し追加しました。"}, {"type": "subtitle", "time": 6677.35, "timestamp": "01:51:17", "text": "たぶん、無理やりやらなきゃいけなかったからこうなったんだと思う"}, {"type": "subtitle", "time": 6679.75, "timestamp": "01:51:19", "text": "自分でドキュメントなどを読む"}, {"type": "subtitle", "time": 6683.189, "timestamp": "01:51:23", "text": "API の仕組み、WebSocket の仕組みについて説明します。"}, {"type": "subtitle", "time": 6686.229, "timestamp": "01:51:26", "text": "作品、明らかな文書、"}, {"type": "subtitle", "time": 6702.589, "timestamp": "01:51:42", "text": "これは何"}, {"type": "subtitle", "time": 6705.39, "timestamp": "01:51:45", "text": "週末？わからない、"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "男。まだ混乱しているような気がする。"}, {"type": "subtitle", "time": 6711.83, "timestamp": "01:51:51", "text": "英語はそのままにしておくべきでしょうか？"}, {"type": "subtitle", "time": 6714.629, "timestamp": "01:51:54", "text": "文学的なものか、それとも…わからない"}, {"type": "subtitle", "time": 6716.95, "timestamp": "01:51:56", "text": "何をするか？とても混乱しています。私はしません"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "自分の得意なことを知っている。わからない"}]
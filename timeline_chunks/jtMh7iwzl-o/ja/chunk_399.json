[{"type": "subtitle", "time": 23941.468, "timestamp": "06:39:01", "text": "だから二人とも道を譲って"}, {"type": "subtitle", "time": 23943.468, "timestamp": "06:39:03", "text": "うん、そこにいるよ"}, {"type": "subtitle", "time": 23948.11, "timestamp": "06:39:08", "text": "行く。それでは、本題に入りましょう。わかった。"}, {"type": "subtitle", "time": 23955.27, "timestamp": "06:39:15", "text": "いいえ。それなら冗談だと言うでしょう。違う、違う"}, {"type": "subtitle", "time": 23957.31, "timestamp": "06:39:17", "text": "ではない ではない"}, {"type": "subtitle", "time": 23960.868, "timestamp": "06:39:20", "text": "case文って簡単じゃないの？なぜ"}, {"type": "subtitle", "time": 23963.75, "timestamp": "06:39:23", "text": "大成功を収めたいですか？"}, {"type": "subtitle", "time": 23970.39, "timestamp": "06:39:30", "text": "とはいえ、ああ、それは良い質問ですね。待って。"}, {"type": "subtitle", "time": 23972.51, "timestamp": "06:39:32", "text": "おお、"}, {"type": "subtitle", "time": 23977.31, "timestamp": "06:39:37", "text": "神。あ、待って。それは良い"}, {"type": "subtitle", "time": 23984.35, "timestamp": "06:39:44", "text": "男。あなたの考えはこうでした。"}, {"type": "subtitle", "time": 23987.07, "timestamp": "06:39:47", "text": "実は。等しい場合"}, {"type": "subtitle", "time": 23990.59, "timestamp": "06:39:50", "text": "これは2に等しいですか？それから私は"}, {"type": "subtitle", "time": 23993.67, "timestamp": "06:39:53", "text": "そのうち2つをここに置いてください。"}, {"type": "subtitle", "time": 23996.548, "timestamp": "06:39:56", "text": "これは３なので、３を置きます。もしそれが"}]
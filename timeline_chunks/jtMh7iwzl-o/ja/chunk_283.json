[{"type": "subtitle", "time": 16980.51, "timestamp": "04:43:00", "text": "これ。私はこれが大嫌いだ"}, {"type": "subtitle", "time": 16985.07, "timestamp": "04:43:05", "text": "私はこれが大嫌いです"}, {"type": "subtitle", "time": 16987.39, "timestamp": "04:43:07", "text": "私の"}, {"type": "subtitle", "time": 16991.39, "timestamp": "04:43:11", "text": "なぜ、今後の予定が表示されないのですか"}, {"type": "subtitle", "time": 16994.83, "timestamp": "04:43:14", "text": "文字通り、これから配信があるとき"}, {"type": "subtitle", "time": 16997.75, "timestamp": "04:43:17", "text": "ストリーム？何かの上に置いた方がいいかな"}, {"type": "subtitle", "time": 17004.708, "timestamp": "04:43:24", "text": "公開。何か書いておく必要があるかな"}, {"type": "subtitle", "time": 17005.948, "timestamp": "04:43:25", "text": "近日公開"}, {"type": "subtitle", "time": 17008.83, "timestamp": "04:43:28", "text": "ストリーム？そこには"}, {"type": "subtitle", "time": 17016.43, "timestamp": "04:43:36", "text": "三つ。"}, {"type": "subtitle", "time": 17019.31, "timestamp": "04:43:39", "text": "なぜ"}]
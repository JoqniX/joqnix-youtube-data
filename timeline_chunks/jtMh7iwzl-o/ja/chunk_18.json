[{"type": "subtitle", "time": 1081.25, "timestamp": "00:18:01", "text": "もう。"}, {"type": "subtitle", "time": 1083.789, "timestamp": "00:18:03", "text": "[音楽]"}, {"type": "subtitle", "time": 1086.23, "timestamp": "00:18:06", "text": "兄弟。ああ、これらは"}, {"type": "subtitle", "time": 1089.23, "timestamp": "00:18:09", "text": "Discordサーバーとチャンネルを変更します"}, {"type": "subtitle", "time": 1093.35, "timestamp": "00:18:13", "text": "名前、チャンネルの説明、トピックなど。"}, {"type": "subtitle", "time": 1095.83, "timestamp": "00:18:15", "text": "VCの名前、すべて。そうそう。いつ"}, {"type": "subtitle", "time": 1096.83, "timestamp": "00:18:16", "text": "私は"}, {"type": "subtitle", "time": 1100.11, "timestamp": "00:18:20", "text": "ライブ。ああ、直さなくちゃいけないの？"}, {"type": "subtitle", "time": 1105.789, "timestamp": "00:18:25", "text": "これ？私はBトークンを置く必要があります"}, {"type": "subtitle", "time": 1109.63, "timestamp": "00:18:29", "text": "あれ。うん。テストしているとき、"}, {"type": "subtitle", "time": 1112.07, "timestamp": "00:18:32", "text": "マルチストリーミング、ストリーミングのスケジュール設定が簡単"}, {"type": "subtitle", "time": 1114.43, "timestamp": "00:18:34", "text": "所有者。うん。うん。うん。これらすべて"}, {"type": "subtitle", "time": 1117.71, "timestamp": "00:18:37", "text": "もの。私が持っている物の量は"}, {"type": "subtitle", "time": 1120.87, "timestamp": "00:18:40", "text": "非常識な。以前はコラボリストを持っていた"}, {"type": "subtitle", "time": 1124.789, "timestamp": "00:18:44", "text": "あれ。それは私が誰であるかを検出します"}, {"type": "subtitle", "time": 1128.71, "timestamp": "00:18:48", "text": "Discordに応じてコラボレーション"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "ID"}, {"type": "subtitle", "time": 1133.99, "timestamp": "00:18:53", "text": "ええと、その他すべて。私はそれをやったと思います"}, {"type": "subtitle", "time": 1135.789, "timestamp": "00:18:55", "text": "あんな感じ"}]
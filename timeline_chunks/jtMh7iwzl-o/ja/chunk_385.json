[{"type": "subtitle", "time": 23101.47, "timestamp": "06:25:01", "text": "彼は知っている"}, {"type": "subtitle", "time": 23111.35, "timestamp": "06:25:11", "text": "わかった。以前使った単語を確認してみてください。私はまだ"}, {"type": "subtitle", "time": 23122.27, "timestamp": "06:25:22", "text": "えっと、私は思う"}, {"type": "subtitle", "time": 23124.788, "timestamp": "06:25:24", "text": "待って、いや、いや、いや、いや。私は必要ない"}, {"type": "subtitle", "time": 23133.75, "timestamp": "06:25:33", "text": "私は自分が何をしているのか理解していません"}, {"type": "subtitle", "time": 23135.91, "timestamp": "06:25:35", "text": "やろうとしている。つまり、私は自分が何をしたいのか理解している"}, {"type": "subtitle", "time": 23138.868, "timestamp": "06:25:38", "text": "やろうとしている。例えば、私が"}, {"type": "subtitle", "time": 23141.43, "timestamp": "06:25:41", "text": "私のチャンネルの今後のスキャンを実行します"}, {"type": "subtitle", "time": 23144.07, "timestamp": "06:25:44", "text": "ストリームは私に2つ与えます"}, {"type": "subtitle", "time": 23146.47, "timestamp": "06:25:46", "text": "今後の配信の数"}, {"type": "subtitle", "time": 23149.91, "timestamp": "06:25:49", "text": "その数字を正しく入力してください。でも私はそれを望んでいます。"}, {"type": "subtitle", "time": 23152.948, "timestamp": "06:25:52", "text": "もしそれが2なら、"}]
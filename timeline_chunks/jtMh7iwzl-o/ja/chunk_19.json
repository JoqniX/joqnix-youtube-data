[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "もしくは、私はそれが好きだと思う、それから彼らは"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "Discord API を削除しました"}, {"type": "subtitle", "time": 1145.47, "timestamp": "00:19:05", "text": "あの声"}, {"type": "subtitle", "time": 1149.43, "timestamp": "00:19:09", "text": "そういうものなので、もう使えなくなりました"}, {"type": "subtitle", "time": 1152.47, "timestamp": "00:19:12", "text": "だって、人を宣伝したかったんだもん。いいえ、そして"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "マルチ視聴でこれを見ていた"}, {"type": "subtitle", "time": 1156.95, "timestamp": "00:19:16", "text": "ウェブサイトに掲載しなければならない"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "あまりにも。いいえ、誰かがウェブサイトを使用している場合"}, {"type": "subtitle", "time": 1163.63, "timestamp": "00:19:23", "text": "ストリームを視聴するためのリンクまたは"}, {"type": "subtitle", "time": 1178.63, "timestamp": "00:19:38", "text": "知ってるけど、うん、これらはすべて"}, {"type": "subtitle", "time": 1180.95, "timestamp": "00:19:40", "text": "バックエンドとみなされる。私は違います"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "フロントエンド開発は一切行いません。私は思う"}, {"type": "subtitle", "time": 1186.31, "timestamp": "00:19:46", "text": "アクティビティのものが"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "フロントエンドとして見ることができる画面。"}, {"type": "subtitle", "time": 1193.71, "timestamp": "00:19:53", "text": "だから、それは良いことだ。そのうちの一つは良い。"}, {"type": "subtitle", "time": 1196.75, "timestamp": "00:19:56", "text": "うん。たくさんの"}]
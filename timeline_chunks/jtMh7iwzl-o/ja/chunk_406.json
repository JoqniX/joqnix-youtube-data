[{"type": "subtitle", "time": 24361.11, "timestamp": "06:46:01", "text": "ストリーム。私は間違ったものを見ているのだろうか"}, {"type": "subtitle", "time": 24363.91, "timestamp": "06:46:03", "text": "1つ？私は。そうでした。わかった。うん。抜粋"}, {"type": "subtitle", "time": 24367.03, "timestamp": "06:46:07", "text": "チャンネルID。そして、これからやってくるもののように、"}, {"type": "subtitle", "time": 24368.788, "timestamp": "06:46:08", "text": "右？近日中に発売される予定です。"}, {"type": "subtitle", "time": 24375.52, "timestamp": "06:46:15", "text": "夢のように"}, {"type": "subtitle", "time": 24377.39, "timestamp": "06:46:17", "text": "[音楽]"}, {"type": "subtitle", "time": 24379.5, "timestamp": "06:46:19", "text": "私はストリーミング配信するつもりはありません"}, {"type": "subtitle", "time": 24381.23, "timestamp": "06:46:21", "text": "[音楽]"}, {"type": "subtitle", "time": 24391.27, "timestamp": "06:46:31", "text": "それ？うん。うん。私はこれをライブで見ています"}, {"type": "subtitle", "time": 24393.27, "timestamp": "06:46:33", "text": "放送コンテンツはありません。"}, {"type": "subtitle", "time": 24402.548, "timestamp": "06:46:42", "text": "バカ、なんでこれが表示されるの？どうやって"}, {"type": "subtitle", "time": 24404.628, "timestamp": "06:46:44", "text": "APIが使えるようになるまでどれくらい待つ必要がありますか？"}, {"type": "subtitle", "time": 24407.83, "timestamp": "06:46:47", "text": "仕事？それとも、私が疲れているからでしょうか？"}, {"type": "subtitle", "time": 24411.788, "timestamp": "06:46:51", "text": "私のAPIか何か？私はただ"}, {"type": "subtitle", "time": 24418.67, "timestamp": "06:46:58", "text": "API API と"}]
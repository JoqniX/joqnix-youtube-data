[{"type": "subtitle", "time": 19683.11, "timestamp": "05:28:03", "text": "1つ。うん、小さく見えるよね？"}, {"type": "subtitle", "time": 19686.31, "timestamp": "05:28:06", "text": "こういう紐は燃えさし全体をも引き立てる"}, {"type": "subtitle", "time": 19692.03, "timestamp": "05:28:12", "text": "少し小さく見える。だから、"}, {"type": "subtitle", "time": 19695.07, "timestamp": "05:28:15", "text": "高い、この男は"}, {"type": "subtitle", "time": 19699.39, "timestamp": "05:28:19", "text": "すると、同じことが起こると思う"}, {"type": "subtitle", "time": 19702.23, "timestamp": "05:28:22", "text": "右は良さそうだけど黒"}, {"type": "subtitle", "time": 19706.628, "timestamp": "05:28:26", "text": "国境は私たちにとっては関係ないですよね？"}, {"type": "subtitle", "time": 19709.67, "timestamp": "05:28:29", "text": "ミディアムにするとしたら、ミディアムか"}, {"type": "subtitle", "time": 19711.23, "timestamp": "05:28:31", "text": "待って、私は何をしたの？"}, {"type": "subtitle", "time": 19713.99, "timestamp": "05:28:33", "text": "クリック？中程度にすると、同じ"}, {"type": "subtitle", "time": 19716.628, "timestamp": "05:28:36", "text": "そういうことですよね？黒いボトル。国境。"}, {"type": "subtitle", "time": 19720.11, "timestamp": "05:28:40", "text": "いいえ、これはフィットしますが、小さすぎて"}, {"type": "subtitle", "time": 19721.628, "timestamp": "05:28:41", "text": "読む、"}, {"type": "subtitle", "time": 19724.99, "timestamp": "05:28:44", "text": "右？小さすぎる。"}, {"type": "subtitle", "time": 19728.788, "timestamp": "05:28:48", "text": "待って。うん、小さすぎて読めないよ。"}, {"type": "subtitle", "time": 19732.23, "timestamp": "05:28:52", "text": "だから、私たちは、えっと、私たち"}, {"type": "subtitle", "time": 19734.83, "timestamp": "05:28:54", "text": "マックスのように行く"}, {"type": "subtitle", "time": 19738.19, "timestamp": "05:28:58", "text": "解決策を見つける方が良いでしょう。だからもし"}]
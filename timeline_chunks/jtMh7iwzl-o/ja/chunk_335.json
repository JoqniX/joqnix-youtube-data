[{"type": "subtitle", "time": 20102.11, "timestamp": "05:35:02", "text": "えーと、それをやるのは"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "ツイッター。これはまた、"}, {"type": "subtitle", "time": 20106.548, "timestamp": "05:35:06", "text": "私がやりたいこと。しかし、これは"}, {"type": "subtitle", "time": 20109.708, "timestamp": "05:35:09", "text": "しかし、それは必要ありません。ただ"}, {"type": "subtitle", "time": 20113.67, "timestamp": "05:35:13", "text": "余分な不必要な小さなものが欲しい"}, {"type": "subtitle", "time": 20117.23, "timestamp": "05:35:17", "text": "やってみたり、学んだりすること。それで"}, {"type": "subtitle", "time": 20120.15, "timestamp": "05:35:20", "text": "ええ、戻ってきたら、私たちは"}, {"type": "subtitle", "time": 20122.59, "timestamp": "05:35:22", "text": "しかし、これには何か問題がある。"}, {"type": "subtitle", "time": 20126.03, "timestamp": "05:35:26", "text": "えっと、どうすればいいんだろう？何をするか？何を"}, {"type": "subtitle", "time": 20130.15, "timestamp": "05:35:30", "text": "する？ええと、わかりました。サムネイルを表示しましょう"}, {"type": "subtitle", "time": 20133.51, "timestamp": "05:35:33", "text": "開封動画。無効にしましょう。わかった。"}, {"type": "subtitle", "time": 20135.35, "timestamp": "05:35:35", "text": "ああ、そうだね。あ、待って。これは"}, {"type": "subtitle", "time": 20138.868, "timestamp": "05:35:38", "text": "その一つ。わかった。わかった。わかった。わかった。だから私は"}, {"type": "subtitle", "time": 20146.19, "timestamp": "05:35:46", "text": "これ。"}, {"type": "subtitle", "time": 20149.67, "timestamp": "05:35:49", "text": "右。ああ、あなたじゃないわ。うん、そうだね。うん。"}, {"type": "subtitle", "time": 20151.67, "timestamp": "05:35:51", "text": "うん。紐を結ばなければならない"}, {"type": "subtitle", "time": 20156.11, "timestamp": "05:35:56", "text": "変数。文字列変数は苦痛です"}, {"type": "subtitle", "time": 20159.23, "timestamp": "05:35:59", "text": "けれど。待って、"}]
[{"type": "subtitle", "time": 6601.59, "timestamp": "01:50:01", "text": "メニューガイドラインです。   この辺りのどこかにあるはずだ"}, {"type": "subtitle", "time": 6604.55, "timestamp": "01:50:04", "text": "。 見つけられればの話ですが"}, {"type": "subtitle", "time": 6607.189, "timestamp": "01:50:07", "text": "。 これらは、推奨されるガイドラインです。"}, {"type": "subtitle", "time": 6612.87, "timestamp": "01:50:12", "text": "ライブサポーターはどこにいますか？"}, {"type": "subtitle", "time": 6617.43, "timestamp": "01:50:17", "text": "ライブ配信を中止するようリクエストします。 ええ、"}, {"type": "subtitle", "time": 6619.75, "timestamp": "01:50:19", "text": "4番目です。"}, {"type": "subtitle", "time": 6621.35, "timestamp": "01:50:21", "text": "えっと、"}, {"type": "subtitle", "time": 6632.47, "timestamp": "01:50:32", "text": "心配はしているよ。"}, {"type": "subtitle", "time": 6635.27, "timestamp": "01:50:35", "text": "誰かがこのことを話してくれたのは初めてです。というのも、"}, {"type": "subtitle", "time": 6639.03, "timestamp": "01:50:39", "text": "私は"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "クリスチャンみたいなことをしていたのですが、"}, {"type": "subtitle", "time": 6645.99, "timestamp": "01:50:45", "text": "ほとんどのユーチューバーは"}, {"type": "subtitle", "time": 6649.669, "timestamp": "01:50:49", "text": "自分の宗教について公に言及しないのを見てきました"}, {"type": "subtitle", "time": 6654.229, "timestamp": "01:50:54", "text": "。   えっと"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "、ちょっと心配なんです。"}]
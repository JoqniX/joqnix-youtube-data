[{"type": "subtitle", "time": 6792.95, "timestamp": "01:53:12", "text": "[息を呑む] なぜなら私は祭壇係のようなことをしていて、"}, {"type": "subtitle", "time": 6796.629, "timestamp": "01:53:16", "text": "教会でいろいろなことが起こったから。でも、"}, {"type": "subtitle", "time": 6810.55, "timestamp": "01:53:30", "text": "[笑い] 神様、こんな風に過去の話をしたくないのですが、"}, {"type": "subtitle", "time": 6816.149, "timestamp": "01:53:36", "text": "TLDDR"}, {"type": "subtitle", "time": 6820.47, "timestamp": "01:53:40", "text": "えっと、私は人を簡単に信用するタイプで、"}, {"type": "subtitle", "time": 6828.39, "timestamp": "01:53:48", "text": "この分野でたくさんの素晴らしい人たちに出会いました。そして、"}, {"type": "subtitle", "time": 6834.31, "timestamp": "01:53:54", "text": "インド人ユーチューバーの顔としてこの立場にいることで、いろいろなことが起こりました。それは、"}, {"type": "subtitle", "time": 6839.83, "timestamp": "01:53:59", "text": "私がディッシュコミュニティのために行った貢献などによるものです。"}]
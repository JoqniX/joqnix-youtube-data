[{"type": "subtitle", "time": 7506.229, "timestamp": "02:05:06", "text": "数日前に何らかの理由でそれを表示させていたのですが、削除するのを忘れていました。"}, {"type": "subtitle", "time": 7509.03, "timestamp": "02:05:09", "text": "私のミスです。   まあ"}, {"type": "subtitle", "time": 7511.91, "timestamp": "02:05:11", "text": "、とにかくそういうことだ"}, {"type": "subtitle", "time": 7516.709, "timestamp": "02:05:16", "text": "。 今日は話が脱線してしまった。 ああ、"}, {"type": "subtitle", "time": 7520.55, "timestamp": "02:05:20", "text": "音があればもっと面白いのに。"}, {"type": "subtitle", "time": 7524.55, "timestamp": "02:05:24", "text": "私は、えっと、効果音の作業を担当することになっていたんです"}, {"type": "subtitle", "time": 7530.31, "timestamp": "02:05:30", "text": "。"}, {"type": "subtitle", "time": 7532.31, "timestamp": "02:05:32", "text": "次の「一緒に仕事をしよう」"}, {"type": "subtitle", "time": 7534.709, "timestamp": "02:05:34", "text": "配信でやります。 うん。"}, {"type": "subtitle", "time": 7549.189, "timestamp": "02:05:49", "text": "でも、でも、"}, {"type": "subtitle", "time": 7554.229, "timestamp": "02:05:54", "text": "ええ、あなたが私の味方になってくれたら、私はあなたの最高のバージョンになります。"}, {"type": "subtitle", "time": 7559.43, "timestamp": "02:05:59", "text": "待って、ああ、"}]
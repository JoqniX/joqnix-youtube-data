[{"type": "subtitle", "time": 7921.51, "timestamp": "02:12:01", "text": "えっと、私のサーバーにいる人"}, {"type": "subtitle", "time": 7925.83, "timestamp": "02:12:05", "text": "や、PCやチャットで私と話している人が、"}, {"type": "subtitle", "time": 7929.51, "timestamp": "02:12:09", "text": "他の場所でBANされているのを見たことがあります。   うーん、うーん、"}, {"type": "subtitle", "time": 7932.87, "timestamp": "02:12:12", "text": "人それぞれ"}, {"type": "subtitle", "time": 7935.35, "timestamp": "02:12:15", "text": "考え方が違うと思う。 えっと、おそらく"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "人々は私の2時間のビデオを見ていないと思っているでしょうが、それが現実なので、"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "見たくないからこそ、みんなが私たちを見る必要があるのです。私にはわかりませんし、私にはわかりません"}, {"type": "subtitle", "time": 7966.191, "timestamp": "02:12:46", "text": "。 今でも"}, {"type": "subtitle", "time": 7970.709, "timestamp": "02:12:50", "text": "人々の服を選んでいるという事実が、私は気に入っています（笑）。 それもまた"}, {"type": "subtitle", "time": 7977.83, "timestamp": "02:12:57", "text": "起こったにせよ、それは"}]
[{"type": "subtitle", "time": 7261.43, "timestamp": "02:01:01", "text": "子供の頃に起こったトラウマについて説明したことで、"}, {"type": "subtitle", "time": 7269.35, "timestamp": "02:01:09", "text": "物事を台無しにしてしまうようなことは望んでいません。 よく考えてみると、"}, {"type": "subtitle", "time": 7272.229, "timestamp": "02:01:12", "text": "私にはわからない。 怖いよ、兄弟。"}, {"type": "subtitle", "time": 7277.669, "timestamp": "02:01:17", "text": "物事の正しいやり方がわからない。   考え"}, {"type": "subtitle", "time": 7279.43, "timestamp": "02:01:19", "text": "すぎなのかもしれない。 わかった。 考え"}, {"type": "subtitle", "time": 7281.35, "timestamp": "02:01:21", "text": "すぎなのかもしれない。"}, {"type": "subtitle", "time": 7289.109, "timestamp": "02:01:29", "text": "なぜそう言ったのか自分でもわかりません。 えっと、もう一度言わせてください"}, {"type": "subtitle", "time": 7292.07, "timestamp": "02:01:32", "text": "。 私がそう言う理由は、"}, {"type": "subtitle", "time": 7299.109, "timestamp": "02:01:39", "text": "子供の頃に何も起こらなかったからです。 でも、"}, {"type": "subtitle", "time": 7303.35, "timestamp": "02:01:43", "text": "それが原因で、"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "信仰心とか教会に行くとか、そういうこととの繋がりが薄れてしまったんです。"}, {"type": "subtitle", "time": 7313.589, "timestamp": "02:01:53", "text": "フラッシュバックとかドラマがあったから。 でも、そうですね、"}, {"type": "subtitle", "time": 7317.189, "timestamp": "02:01:57", "text": "計画はしていますし、そうしたいと思っていますし、今日でもそうしたいと思っています。"}]
[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "？"}, {"type": "subtitle", "time": 4263.99, "timestamp": "01:11:03", "text": "私たちは友情を築く。 これについて動画を作りました"}, {"type": "subtitle", "time": 4266.709, "timestamp": "01:11:06", "text": "。"}, {"type": "subtitle", "time": 4268.63, "timestamp": "01:11:08", "text": "チャンネルの URL を指定すると、"}, {"type": "subtitle", "time": 4278.87, "timestamp": "01:11:18", "text": "通常の動画、短いストリーム、"}, {"type": "subtitle", "time": 4281.27, "timestamp": "01:11:21", "text": "ライブ タブからのみ取得されるアップロードされた動画が混在するチャンネル フィードをスクレイピングします。 名前「チャンネルフィード」を入力してください"}, {"type": "subtitle", "time": 4284.95, "timestamp": "01:11:24", "text": "。 ストリームを使ってこれを行うこともできますし、"}, {"type": "subtitle", "time": 4295.99, "timestamp": "01:11:35", "text": "。"}, {"type": "subtitle", "time": 4298.63, "timestamp": "01:11:38", "text": "それって準社会主義って言うんじゃないの？"}, {"type": "subtitle", "time": 4301.75, "timestamp": "01:11:41", "text": "私はパラ"}, {"type": "subtitle", "time": 4306.07, "timestamp": "01:11:46", "text": "ソーシャルリズムについてはまだあまり触れていません。"}, {"type": "subtitle", "time": 4309.35, "timestamp": "01:11:49", "text": "後で"}, {"type": "subtitle", "time": 4312.39, "timestamp": "01:11:52", "text": "視聴者向けの動画を作りたいと思っていました。"}, {"type": "subtitle", "time": 4317.189, "timestamp": "01:11:57", "text": "私は、あの"}, {"type": "subtitle", "time": 4318.87, "timestamp": "01:11:58", "text": "ビデオで私たちが友達だったクリエイターの"}]
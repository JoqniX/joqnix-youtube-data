[{"type": "subtitle", "time": 6420.229, "timestamp": "01:47:00", "text": "コントローラーのレイアウト。 何てことだ。  [笑い]"}, {"type": "subtitle", "time": 6426.629, "timestamp": "01:47:06", "text": "でも、えーと、つまり、今じゃなくて、いずれは、えーと、遠い"}, {"type": "subtitle", "time": 6432.47, "timestamp": "01:47:12", "text": "将来、女の子と結婚しなきゃいけなくなると思うんです"}, {"type": "subtitle", "time": 6434.87, "timestamp": "01:47:14", "text": "。 いいえ、私はストレートなので"}, {"type": "subtitle", "time": 6437.669, "timestamp": "01:47:17", "text": "。 ええ、なぜ"}, {"type": "subtitle", "time": 6439.99, "timestamp": "01:47:19", "text": "もう結婚について考えなければならないのでしょうか？ 家族は"}, {"type": "subtitle", "time": 6443.91, "timestamp": "01:47:23", "text": "私にいろいろ聞いてくるけど、私は「いや、自分の"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "人生に集中させて」って言う。 実際にどこかにたどり着くには、"}, {"type": "subtitle", "time": 6457.43, "timestamp": "01:47:37", "text": "えっと、あなたたちは反感主義者ですか？ わからない。"}, {"type": "subtitle", "time": 6464.39, "timestamp": "01:47:44", "text": "教会に行って祈るだけの普通のクリスチャンにならないでもいいですか？えっと、よくわからないんですけど"}, {"type": "subtitle", "time": 6474.229, "timestamp": "01:47:54", "text": "[笑い] 単にそうしなくてもいいんだよ"}, {"type": "subtitle", "time": 6477.109, "timestamp": "01:47:57", "text": "。 選択しないという"}]
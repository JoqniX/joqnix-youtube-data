[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "。"}, {"type": "subtitle", "time": 3602.789, "timestamp": "01:00:02", "text": "つまり、ウェブサイトに表示されるということですね"}, {"type": "subtitle", "time": 3605.829, "timestamp": "01:00:05", "text": "。 えーっと、私がこれをやっているのは、えーっと、"}, {"type": "subtitle", "time": 3612.15, "timestamp": "01:00:12", "text": "YouTube が"}, {"type": "subtitle", "time": 3619.99, "timestamp": "01:00:19", "text": "参照ポリシーのせいで、OBS や MEL で YouTube 埋め込みが機能しなくなったからです。 だから、そこに何かを入れるには、"}, {"type": "subtitle", "time": 3624.789, "timestamp": "01:00:24", "text": "参照を入れる必要があります。"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "つまり、私のウェブサイトであれば、"}, {"type": "subtitle", "time": 3628.789, "timestamp": "01:00:28", "text": "ウェブサイトのドメイン名を入力すればいいということですよね？それが"}, {"type": "subtitle", "time": 3633.03, "timestamp": "01:00:33", "text": "参照URLになりますよね？ ユーザーがそのウェブサイトにアクセスしている場合、"}, {"type": "subtitle", "time": 3637.51, "timestamp": "01:00:37", "text": "埋め込みを開いたり視聴したりすれば"}, {"type": "subtitle", "time": 3643.589, "timestamp": "01:00:43", "text": "視聴できますが、そうでない場合は表示されず、"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "このエラーが表示されます。そのため、このように設定しました。"}, {"type": "subtitle", "time": 3656.23, "timestamp": "01:00:56", "text": "今はいくつかの項目を追加してこの設定を修正する必要があります。"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "また、確認させてください。Notion で更新されたばかりです。"}]
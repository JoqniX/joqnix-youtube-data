[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "ああ、全部コピーしてしまえばいいじゃないか？"}, {"type": "chat", "time": 4741.957, "timestamp": "01:19:01", "author": "@WhiteGlint4Answer", "avatar": "https://yt4.ggpht.com/ytc/AIdro_naBVNcSxiu5dSXWZ9sg7-zrOuDci98mvg4tI6NAFMNEIQ=s64-c-k-c0x00ffffff-no-rj", "message": "Joachim"}, {"type": "subtitle", "time": 4743.43, "timestamp": "01:19:03", "text": "うっかり保存してしまったのかな？ はい、"}, {"type": "subtitle", "time": 4746.39, "timestamp": "01:19:06", "text": "大丈夫です。"}, {"type": "subtitle", "time": 4751.35, "timestamp": "01:19:11", "text": "えっと、なぜですか？ こんにちは、"}, {"type": "subtitle", "time": 4752.87, "timestamp": "01:19:12", "text": "ジョー。"}, {"type": "subtitle", "time": 4755.344, "timestamp": "01:19:15", "text": "待って、それってニックネーム？"}, {"type": "subtitle", "time": 4759.11, "timestamp": "01:19:19", "text": "[笑い] 私ですか？ ああ、それはニックネームだよ。"}, {"type": "subtitle", "time": 4762.39, "timestamp": "01:19:22", "text": "ジョアっていう名前の知り合いがいるから。"}, {"type": "subtitle", "time": 4765.75, "timestamp": "01:19:25", "text": "ジョア・キムだと思います。 彼は"}, {"type": "subtitle", "time": 4769.03, "timestamp": "01:19:29", "text": "私のクラスメートだった。"}, {"type": "subtitle", "time": 4773.59, "timestamp": "01:19:33", "text": "そう書いてあると、「あれ、あれって"}, {"type": "subtitle", "time": 4775.99, "timestamp": "01:19:35", "text": "私のクラスメート？なんで"}, {"type": "subtitle", "time": 4778.31, "timestamp": "01:19:38", "text": "ここにクラスメートの名前があるの？」って思い出してしまうんです。 それは"}, {"type": "subtitle", "time": 4780.709, "timestamp": "01:19:40", "text": "ユニークな名前ですね。 私はまだそんな名前の人に会ったことがない"}, {"type": "subtitle", "time": 4783.27, "timestamp": "01:19:43", "text": "。"}, {"type": "subtitle", "time": 4787.51, "timestamp": "01:19:47", "text": "「わあ、かっこいい名前だね」って思ったよ。"}, {"type": "subtitle", "time": 4790.39, "timestamp": "01:19:50", "text": "うん。 とにかく、ランダムボードは"}, {"type": "subtitle", "time": 4795.35, "timestamp": "01:19:55", "text": "電流ゼロです。 そんなものは必要ない。"}]
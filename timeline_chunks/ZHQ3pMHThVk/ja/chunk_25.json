[{"type": "subtitle", "time": 1504.47, "timestamp": "00:25:04", "text": "9月3日。 ええ、彼らはそれを変えました"}, {"type": "subtitle", "time": 1506.149, "timestamp": "00:25:06", "text": "。 彼らはデータソースと呼ばれるものを導入した"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "。"}, {"type": "subtitle", "time": 1510.63, "timestamp": "00:25:10", "text": "彼らはデータベースのシステムを変更した。 だから、"}, {"type": "subtitle", "time": 1513.269, "timestamp": "00:25:13", "text": "いろいろ変えなければならないことがあるんです。 私の"}, {"type": "subtitle", "time": 1515.11, "timestamp": "00:25:15", "text": "考えは、"}, {"type": "subtitle", "time": 1518.95, "timestamp": "00:25:18", "text": "コラボレーションパートナーやデータベースなど、私が"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "ウェブサイトに掲載している、これまでコラボレーションしたすべてのYouTuberのリストといったものに基づいています"}, {"type": "subtitle", "time": 1524.39, "timestamp": "00:25:24", "text": "。 ああ、君は"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "ここにいたのか、ドラゴン野郎。"}, {"type": "subtitle", "time": 1530.23, "timestamp": "00:25:30", "text": "ああ、それも全部直さなきゃいけないんだ"}, {"type": "subtitle", "time": 1533.11, "timestamp": "00:25:33", "text": "。 また、"}, {"type": "subtitle", "time": 1535.35, "timestamp": "00:25:35", "text": "人の"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "名前をクリックすると"}, {"type": "subtitle", "time": 1542.71, "timestamp": "00:25:42", "text": "その人のアバターがすべて表示されるような機能を追加する予定です。なぜなら、"}, {"type": "subtitle", "time": 1546.31, "timestamp": "00:25:46", "text": "noa で手動でホストする必要があるからです。 そっちの方が"}, {"type": "subtitle", "time": 1548.07, "timestamp": "00:25:48", "text": "いいでしょう。 彼らに"}, {"type": "subtitle", "time": 1550.39, "timestamp": "00:25:50", "text": "最新のPNG画像を頼む必要はない。"}, {"type": "subtitle", "time": 1554.07, "timestamp": "00:25:54", "text": "自分の家に何かを置いて、"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "すべて整理しておけばいいんですよね？"}]
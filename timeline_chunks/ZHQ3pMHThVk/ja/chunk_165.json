[{"type": "subtitle", "time": 9905.03, "timestamp": "02:45:05", "text": "。  Wをランダム化します。こんにちは。 全ては"}, {"type": "subtitle", "time": 9907.11, "timestamp": "02:45:07", "text": "ランダム化されている。 私がオフラインのときは、"}, {"type": "subtitle", "time": 9909.59, "timestamp": "02:45:09", "text": "私のウェブサイトにランダムな単語が生成されます"}, {"type": "subtitle", "time": 9913.11, "timestamp": "02:45:13", "text": "。"}, {"type": "subtitle", "time": 9919.19, "timestamp": "02:45:19", "text": "YouTube の埋め込みは"}, {"type": "subtitle", "time": 9921.269, "timestamp": "02:45:21", "text": "参照があるため不可能なので、OBS と Melt にこれを配置し、自分の"}, {"type": "subtitle", "time": 9925.59, "timestamp": "02:45:25", "text": "Web サイトを使用して参照埋め込みを行うことができます。 こんにちは。 やっとうまくいった"}, {"type": "subtitle", "time": 9928.63, "timestamp": "02:45:28", "text": "。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 9931.51, "timestamp": "02:45:31", "text": "これで終わりにします。"}, {"type": "subtitle", "time": 9933.19, "timestamp": "02:45:33", "text": "授業中に顔を洗ったりしないといけないので、急いで済ませます。"}, {"type": "subtitle", "time": 9939.51, "timestamp": "02:45:39", "text": "本日はありがとうございました。 とても楽しかったです。"}, {"type": "subtitle", "time": 9945.03, "timestamp": "02:45:45", "text": "そして、私はこれにかなり時間を費やしました。 次回の「"}, {"type": "subtitle", "time": 9947.11, "timestamp": "02:45:47", "text": "一緒に作業しよう」配信では、配信設定で使用している"}, {"type": "subtitle", "time": 9950.07, "timestamp": "02:45:50", "text": "他のボタンやその他諸々の不具合修正に取り組みます"}, {"type": "subtitle", "time": 9952.63, "timestamp": "02:45:52", "text": "。"}, {"type": "subtitle", "time": 9955.91, "timestamp": "02:45:55", "text": "また、自動"}, {"type": "subtitle", "time": 9958.389, "timestamp": "02:45:58", "text": "モデレーションシステムにも取り組みたいと思っています。特に"}]
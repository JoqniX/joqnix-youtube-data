[{"type": "subtitle", "time": 6844.07, "timestamp": "01:54:04", "text": "そして、"}, {"type": "subtitle", "time": 6846.39, "timestamp": "01:54:06", "text": "ええ、そういうことがすべて起こりました。私の"}, {"type": "subtitle", "time": 6849.43, "timestamp": "01:54:09", "text": "誕生日に、"}, {"type": "subtitle", "time": 6852.07, "timestamp": "01:54:12", "text": "別のコーンにいた友達からケーキをもらいました。他にもいろいろなことが"}, {"type": "subtitle", "time": 6856.39, "timestamp": "01:54:16", "text": "起こり、当時"}, {"type": "subtitle", "time": 6859.27, "timestamp": "01:54:19", "text": "私が繋がっていた人や"}, {"type": "subtitle", "time": 6861.189, "timestamp": "01:54:21", "text": "友達の中には、それを気に入らなかった人がいて、"}, {"type": "subtitle", "time": 6874.55, "timestamp": "01:54:34", "text": "プライベートなDMで売買された古いものを公表することを選びました。そして、"}, {"type": "subtitle", "time": 6878.47, "timestamp": "01:54:38", "text": "2021年からの出来事のように、それを公表しました。"}, {"type": "subtitle", "time": 6886.149, "timestamp": "01:54:46", "text": "ええ そして、文字通りそのGoogleドキュメントが"}, {"type": "subtitle", "time": 6889.91, "timestamp": "01:54:49", "text": "私に起こったのです。私が信頼していた人、"}, {"type": "subtitle", "time": 6894.31, "timestamp": "01:54:54", "text": "友達、"}, {"type": "subtitle", "time": 6898.07, "timestamp": "01:54:58", "text": "私が繋がっていたすべてのクリエイター、"}]
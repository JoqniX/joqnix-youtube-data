[{"type": "subtitle", "time": 2940.47, "timestamp": "00:49:00", "text": "私がオフラインの時は、ここでそういうことが起こるんです"}, {"type": "subtitle", "time": 2946.71, "timestamp": "00:49:06", "text": "そしてオンラインの時は、Twitchのカテゴリと、ここで起こっているすべての出来事をチェックします"}, {"type": "subtitle", "time": 2962.71, "timestamp": "00:49:22", "text": "この人が必要なんだな？ だから、"}, {"type": "subtitle", "time": 2976.79, "timestamp": "00:49:36", "text": "しかし、このデフォルト設定は何のために"}, {"type": "subtitle", "time": 2980.47, "timestamp": "00:49:40", "text": "ここにあるのでしょうか？ 辛い仕事だ。 ローカルステータスとは何ですか"}, {"type": "subtitle", "time": 2983.19, "timestamp": "00:49:43", "text": "？ あなたは何者ですか？なぜあなたは？なぜ私は"}, {"type": "subtitle", "time": 2987.109, "timestamp": "00:49:47", "text": "またあなたを必要とするのか、忘れてしまいました。   あの"}, {"type": "subtitle", "time": 2990.87, "timestamp": "00:49:50", "text": "、あのね？ 私も真似します。"}, {"type": "subtitle", "time": 2995.19, "timestamp": "00:49:55", "text": "えっと、"}, {"type": "subtitle", "time": 2996.95, "timestamp": "00:49:56", "text": "ここに入れてください。"}]
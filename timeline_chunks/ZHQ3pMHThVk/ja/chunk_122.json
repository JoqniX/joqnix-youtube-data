[{"type": "subtitle", "time": 7322.87, "timestamp": "02:02:02", "text": "時々教会にも行きますが、"}, {"type": "subtitle", "time": 7325.91, "timestamp": "02:02:05", "text": "また、あの、"}, {"type": "subtitle", "time": 7329.524, "timestamp": "02:02:09", "text": "戻って、"}, {"type": "subtitle", "time": 7333.91, "timestamp": "02:02:13", "text": "小さい頃の自分に戻りたいと思っています。[笑い] ええと、僕はまるで"}, {"type": "subtitle", "time": 7337.27, "timestamp": "02:02:17", "text": "祖母のような少年でした。"}, {"type": "subtitle", "time": 7339.51, "timestamp": "02:02:19", "text": "私の祖母はとても"}, {"type": "subtitle", "time": 7344.55, "timestamp": "02:02:24", "text": "迷信深くて、"}, {"type": "subtitle", "time": 7347.209, "timestamp": "02:02:27", "text": "祈りとかそういうことに熱心なんです。 今でも"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "（笑）彼女はテレビチャンネルを見て、"}, {"type": "subtitle", "time": 7352.629, "timestamp": "02:02:32", "text": "毎日祈ったりしているし、"}, {"type": "subtitle", "time": 7356.55, "timestamp": "02:02:36", "text": "そう、私も昔はそうやって祭壇係とか"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "教会のことをやるようになったんです。 そう、"}, {"type": "subtitle", "time": 7364.95, "timestamp": "02:02:44", "text": "昔の自分に戻りたいんです。"}, {"type": "subtitle", "time": 7366.87, "timestamp": "02:02:46", "text": "毎日教会に行って、"}, {"type": "subtitle", "time": 7371.27, "timestamp": "02:02:51", "text": "家族や自分のために祈ったり、色々なことをしたり。   確かに"}, {"type": "subtitle", "time": 7374.47, "timestamp": "02:02:54", "text": "、PTSDによる"}, {"type": "subtitle", "time": 7376.629, "timestamp": "02:02:56", "text": "トラウマからの回復は大変だったけど、それを言い訳にはでき"}]
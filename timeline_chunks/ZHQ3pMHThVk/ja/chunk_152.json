[{"type": "subtitle", "time": 9120.55, "timestamp": "02:32:00", "text": "。 プレイリストに基づいたボタンサイクル。"}, {"type": "subtitle", "time": 9133.59, "timestamp": "02:32:13", "text": "ストリームは11個あるはずです。  1 2 3 4 5 6"}, {"type": "subtitle", "time": 9139.19, "timestamp": "02:32:19", "text": "7 8 9 10 11。了解。  11. ああ、うまくいった。"}, {"type": "subtitle", "time": 9142.389, "timestamp": "02:32:22", "text": "しかし、なぜ未定義なのか？"}, {"type": "subtitle", "time": 9144.469, "timestamp": "02:32:24", "text": "これについては、遅延を解消する必要がありそうだ"}, {"type": "subtitle", "time": 9146.389, "timestamp": "02:32:26", "text": "。"}, {"type": "subtitle", "time": 9158.469, "timestamp": "02:32:38", "text": "うん、遅延を解消する必要があるね。 えっと、"}]
[{"type": "subtitle", "time": 2822.15, "timestamp": "00:47:02", "text": "？   ほんの少しだけ"}, {"type": "subtitle", "time": 2826.309, "timestamp": "00:47:06", "text": "良くなった。   そして、"}, {"type": "subtitle", "time": 2833.19, "timestamp": "00:47:13", "text": "2.0。 わかった。 待って。 これは空の"}, {"type": "subtitle", "time": 2836.309, "timestamp": "00:47:16", "text": "コメントですか？ わかった。 それを削除してください。"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "アートリングス。"}, {"type": "subtitle", "time": 2842.79, "timestamp": "00:47:22", "text": "あ、待って。 私には、あなたが必要です。"}, {"type": "subtitle", "time": 2861.43, "timestamp": "00:47:41", "text": "ああ、これは大丈夫だ。"}, {"type": "subtitle", "time": 2864.23, "timestamp": "00:47:44", "text": "えーっと [ため息] なぜ"}, {"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "こんなコメントボックスをたくさん作ったのか分かりません"}, {"type": "subtitle", "time": 2877.349, "timestamp": "00:47:57", "text": "。 より良く、より清潔に。   わかった"}]
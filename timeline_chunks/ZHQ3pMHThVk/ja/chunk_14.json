[{"type": "subtitle", "time": 841.03, "timestamp": "00:14:01", "text": "新しい YouTube の参照ポリシーなどの理由で [音楽] が機能しません"}, {"type": "subtitle", "time": 847.269, "timestamp": "00:14:07", "text": "。 つまり、"}, {"type": "subtitle", "time": 850.55, "timestamp": "00:14:10", "text": "153 ビデオプレーヤー"}, {"type": "chat", "time": 851.995, "timestamp": "00:14:11", "author": "@NowItz_SP", "avatar": "https://yt4.ggpht.com/xaUjzxLfQ0VJjzQvJiJfsKtaYR78kdc_Q955XexgF8g2tYgbDiK3RrrVKi-9Qki-F4Ql1jVnBtQ=s64-c-k-c0x00ffffff-no-rj", "message": "oh"}, {"type": "subtitle", "time": 853.269, "timestamp": "00:14:13", "text": "構成エラーと呼ばれるこのエラーが発生します。 それで、私の認証"}, {"type": "subtitle", "time": 856.629, "timestamp": "00:14:16", "text": "機能がもう動作しなくなりました。"}, {"type": "chat", "time": 857.15, "timestamp": "00:14:17", "author": "@NowItz_SP", "avatar": "https://yt4.ggpht.com/xaUjzxLfQ0VJjzQvJiJfsKtaYR78kdc_Q955XexgF8g2tYgbDiK3RrrVKi-9Qki-F4Ql1jVnBtQ=s64-c-k-c0x00ffffff-no-rj", "message": "this is something new"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "私のVA関連の機能はもう使えなくなってしまいました。"}, {"type": "subtitle", "time": 863.43, "timestamp": "00:14:23", "text": "だから、それを修正するために、"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "OBSには現在参照が必要なので、"}, {"type": "subtitle", "time": 870.949, "timestamp": "00:14:30", "text": "OBSの次の大きなアップデートまで対応しないと言っていたのだと思いました"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "。 あまりにも明白なことは、もはや絶望的だ。"}, {"type": "subtitle", "time": 876.47, "timestamp": "00:14:36", "text": "でも私の場合はメルを使っているので、"}, {"type": "subtitle", "time": 879.189, "timestamp": "00:14:39", "text": "良いことだと思います。 待って、メルの関係者も、私が"}, {"type": "subtitle", "time": 889.269, "timestamp": "00:14:49", "text": "この問題について彼らに話した時、私の問い合わせに返信しなかったみたいだったよ。 だから、"}, {"type": "subtitle", "time": 891.829, "timestamp": "00:14:51", "text": "私にできる解決策は一つしかない。 しかし私の"}, {"type": "subtitle", "time": 893.829, "timestamp": "00:14:53", "text": "場合は、自分のウェブサイトにホストすればいいだけです。"}]
[{"type": "subtitle", "time": 3375.349, "timestamp": "00:56:15", "text": "はい、ここでプレイリストが作成されますよね"}, {"type": "subtitle", "time": 3377.51, "timestamp": "00:56:17", "text": "？ つまり、"}, {"type": "subtitle", "time": 3379.91, "timestamp": "00:56:19", "text": "主に接続されているのはOBSです。  OBSは使っていない"}, {"type": "subtitle", "time": 3384.63, "timestamp": "00:56:24", "text": "ので、画面は空白です。 そうでなければ、meltが"}, {"type": "subtitle", "time": 3387.589, "timestamp": "00:56:27", "text": "接続されている場合は、ランダムな"}, {"type": "subtitle", "time": 3390.39, "timestamp": "00:56:30", "text": "ビデオ番号はゼロになります。"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "それなら、使わないよ。うん、それは使われていない。 ああ"}, {"type": "subtitle", "time": 3397.589, "timestamp": "00:56:37", "text": "、ここから先は"}, {"type": "subtitle", "time": 3399.829, "timestamp": "00:56:39", "text": "ランダムになります。"}, {"type": "subtitle", "time": 3403.99, "timestamp": "00:56:43", "text": "位置をランダム化して、"}, {"type": "subtitle", "time": 3413.03, "timestamp": "00:56:53", "text": "プレイリストの 30 個の変数すべてをログに記録します。 そして、期間に関する"}, {"type": "subtitle", "time": 3416.069, "timestamp": "00:56:56", "text": "問題が発生する。"}]
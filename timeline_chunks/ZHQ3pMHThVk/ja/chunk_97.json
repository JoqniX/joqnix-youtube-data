[{"type": "subtitle", "time": 5822.07, "timestamp": "01:37:02", "text": "あなたがルールを破っているのか、それとも"}, {"type": "subtitle", "time": 5824.629, "timestamp": "01:37:04", "text": "あなたが不快な思いをし、"}, {"type": "subtitle", "time": 5826.31, "timestamp": "01:37:06", "text": "他の人を不快にさせているのか、私には分かりません。 タイムアウトを取らざるを得ないかもしれない"}, {"type": "subtitle", "time": 5835.03, "timestamp": "01:37:15", "text": "私がクリスチャンだからクリスチャンと書いただけです。それに、"}, {"type": "subtitle", "time": 5844.07, "timestamp": "01:37:24", "text": "私のコンテンツは"}, {"type": "subtitle", "time": 5846.55, "timestamp": "01:37:26", "text": "あらゆる年齢層の方々がアクセスしやすいものにしたいんです。 だから私は悪態をついたりしないんです"}, {"type": "subtitle", "time": 5849.59, "timestamp": "01:37:29", "text": "。 それでおしまい。 あまり"}, {"type": "subtitle", "time": 5854.07, "timestamp": "01:37:34", "text": "深く考える必要はありません。"}, {"type": "subtitle", "time": 5856.47, "timestamp": "01:37:36", "text": "それでおしまい。 あまり"}, {"type": "subtitle", "time": 5864.47, "timestamp": "01:37:44", "text": "まあ、そうですね。 まあ、"}, {"type": "subtitle", "time": 5867.27, "timestamp": "01:37:47", "text": "あなたがそうしたいようにすればいいですよ。"}, {"type": "subtitle", "time": 5870.229, "timestamp": "01:37:50", "text": "あれ、私ツイートしてなかったっけ？ ツイートしましたよ。   わかった"}, {"type": "subtitle", "time": 5879.669, "timestamp": "01:37:59", "text": "同じですね、とにかく、ええ、"}]
[{"type": "subtitle", "time": 9961.67, "timestamp": "02:46:01", "text": "キックに関しては、GFXボットやスパム"}, {"type": "subtitle", "time": 9964.79, "timestamp": "02:46:04", "text": "ユーザーがいるので、改善が必要です。 それに取り組む必要がある。"}, {"type": "subtitle", "time": 9967.99, "timestamp": "02:46:07", "text": "Discordのチャットログも必要です。"}, {"type": "subtitle", "time": 9971.59, "timestamp": "02:46:11", "text": "それについては取り組みます。 次回はシステムを使用します。 今夜"}, {"type": "subtitle", "time": 9975.67, "timestamp": "02:46:15", "text": "ストリーミング配信する場合は、detになります。"}, {"type": "subtitle", "time": 9981.67, "timestamp": "02:46:21", "text": "ええ、明日はバトルフィールド"}, {"type": "subtitle", "time": 9983.51, "timestamp": "02:46:23", "text": "レッドサックの"}, {"type": "subtitle", "time": 9985.51, "timestamp": "02:46:25", "text": "配信をします。午前10時か11時頃です。了解です"}, {"type": "subtitle", "time": 9989.429, "timestamp": "02:46:29", "text": "。 えっと、"}, {"type": "subtitle", "time": 9991.75, "timestamp": "02:46:31", "text": "3時までには配信を終えて、その時間帯に寝たり"}, {"type": "subtitle", "time": 9994.469, "timestamp": "02:46:34", "text": "授業に出たりできるようにします。 こんにちは。 ともあれ、"}, {"type": "subtitle", "time": 9997.19, "timestamp": "02:46:37", "text": "今日はありがとうございました。 えっと、"}, {"type": "subtitle", "time": 10001.67, "timestamp": "02:46:41", "text": "今日はちょっと話すべきじゃなかったことを話してしまったけど、それでも見てくれてありがとう。それでは、"}, {"type": "subtitle", "time": 10006.79, "timestamp": "02:46:46", "text": "良い一日を。 今夜会いましょう。"}, {"type": "subtitle", "time": 10010.23, "timestamp": "02:46:50", "text": "こんにちは、もしくは明日。 こんにちは。 おやすみ。 おやすみなさいとは言いません"}]
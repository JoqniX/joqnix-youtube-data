[{"type": "subtitle", "time": 5705.91, "timestamp": "01:35:05", "text": "ああ、フォローコード011をありがとうございます。"}, {"type": "subtitle", "time": 5708.149, "timestamp": "01:35:08", "text": "行きます。」ということです。   ウェブ"}, {"type": "subtitle", "time": 5712.07, "timestamp": "01:35:12", "text": "サイトの件で、"}, {"type": "subtitle", "time": 5715.27, "timestamp": "01:35:15", "text": "あなたのルールのどの点に同意できないのですか"}, {"type": "subtitle", "time": 5728.55, "timestamp": "01:35:28", "text": "？ はぁ？ 私には理解できません"}, {"type": "subtitle", "time": 5732.39, "timestamp": "01:35:32", "text": "。 どういう意味ですか？"}, {"type": "subtitle", "time": 5735.03, "timestamp": "01:35:35", "text": "はぁ？   それは、"}, {"type": "subtitle", "time": 5737.669, "timestamp": "01:35:37", "text": "私には分からないということです。 分かりません（笑）"}, {"type": "subtitle", "time": 5739.83, "timestamp": "01:35:39", "text": "。   ええ、まあ"}, {"type": "subtitle", "time": 5742.87, "timestamp": "01:35:42", "text": "、ストリームへようこそ。 では、どのようにして"}, {"type": "subtitle", "time": 5745.75, "timestamp": "01:35:45", "text": "弊社を見つけられたのですか？ 元気ですか？ わかった。"}, {"type": "subtitle", "time": 5747.27, "timestamp": "01:35:47", "text": "えっと、"}, {"type": "subtitle", "time": 5749.35, "timestamp": "01:35:49", "text": "何の話をしてたんだっけ？ 私は混乱しました。 気が散ってしまった"}, {"type": "subtitle", "time": 5752.229, "timestamp": "01:35:52", "text": "。 ああ、なんてことだ"}, {"type": "subtitle", "time": 5755.35, "timestamp": "01:35:55", "text": "、私の脳が。 私は何を言っていたんだっけ？"}]
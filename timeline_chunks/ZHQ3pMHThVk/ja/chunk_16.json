[{"type": "subtitle", "time": 960.389, "timestamp": "00:16:00", "text": "ライブ配信中にTwitchでカテゴリを確認するというものです。Twitchは"}, {"type": "subtitle", "time": 965.11, "timestamp": "00:16:05", "text": "現在API呼び出しが速いためです。 つまり、私のカテゴリーをチェックしているということですね。"}, {"type": "subtitle", "time": 967.35, "timestamp": "00:16:07", "text": "現在、私はコワーキングスペースと"}, {"type": "subtitle", "time": 969.99, "timestamp": "00:16:09", "text": "学習スペースのカテゴリーを利用しています。 そこで、"}, {"type": "subtitle", "time": 976.79, "timestamp": "00:16:16", "text": "タイトルに「私と一緒に働く」や「コアワーキング」が含まれている場合は、"}, {"type": "subtitle", "time": 979.11, "timestamp": "00:16:19", "text": "それはコワーキング"}, {"type": "subtitle", "time": 982.389, "timestamp": "00:16:22", "text": "ストリームであるという意味だと区別しました。 つまり、私のYouTube"}, {"type": "subtitle", "time": 983.99, "timestamp": "00:16:23", "text": "プレイリスト、つまり私"}, {"type": "subtitle", "time": 986.31, "timestamp": "00:16:26", "text": "のチャンネルにあるすべてのプレイリストをチェックするということです"}, {"type": "subtitle", "time": 990.47, "timestamp": "00:16:30", "text": "。 見つけられれば、コワーキングスペース用のプレイリストを入手する"}, {"type": "subtitle", "time": 993.59, "timestamp": "00:16:33", "text": "。 うん、"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "コワーキングスペース用のプレイリストが手に入るよ。 これは、"}, {"type": "subtitle", "time": 998.15, "timestamp": "00:16:38", "text": "今日の配信を含めて 11 本の動画があり、"}, {"type": "subtitle", "time": 1001.269, "timestamp": "00:16:41", "text": "11 本の"}, {"type": "subtitle", "time": 1003.99, "timestamp": "00:16:43", "text": "動画すべてが表示され、11 本の中からランダムに選ばれ、"}, {"type": "subtitle", "time": 1009.829, "timestamp": "00:16:49", "text": "30 本の動画になるまでランダムに選ばれ続けます。 つまり、"}, {"type": "subtitle", "time": 1012.47, "timestamp": "00:16:52", "text": "プレイリストに入っているということですよね？ そして、それによって生成される"}, {"type": "subtitle", "time": 1015.829, "timestamp": "00:16:55", "text": "埋め込みリンクがこれです。"}, {"type": "subtitle", "time": 1018.31, "timestamp": "00:16:58", "text": "ええ、見つけられればね。  YouTube。 はい、"}]
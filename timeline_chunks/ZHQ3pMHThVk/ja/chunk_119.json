[{"type": "subtitle", "time": 7141.109, "timestamp": "01:59:01", "text": "6、7年になります。"}, {"type": "subtitle", "time": 7144.95, "timestamp": "01:59:04", "text": "ええ、そうですね、私はたくさんの人を知っていますし、以前はたくさんの"}, {"type": "subtitle", "time": 7148.55, "timestamp": "01:59:08", "text": "人を知っていました。   いや、もう今は違う"}, {"type": "subtitle", "time": 7152.31, "timestamp": "01:59:12", "text": "。 あれ以来、"}, {"type": "subtitle", "time": 7158.79, "timestamp": "01:59:18", "text": "人の本当の姿を見るようになったので、理解できたと思います。"}, {"type": "subtitle", "time": 7165.83, "timestamp": "01:59:25", "text": "ストリーミング動画に戻る前に説明したように、"}, {"type": "subtitle", "time": 7168.229, "timestamp": "01:59:28", "text": "VT"}, {"type": "subtitle", "time": 7172.31, "timestamp": "01:59:32", "text": "ドラマ動画に出演したときの気持ちや、部分的に"}, {"type": "subtitle", "time": 7174.709, "timestamp": "01:59:34", "text": "言及したように、それは私"}, {"type": "subtitle", "time": 7177.99, "timestamp": "01:59:37", "text": "個人のもので、自分が"}, {"type": "subtitle", "time": 7181.51, "timestamp": "01:59:41", "text": "有害な友情関係にあるのか、それとも常に"}, {"type": "subtitle", "time": 7183.99, "timestamp": "01:59:43", "text": "人の良い面を見ているのかさえわかりません。 私は"}, {"type": "subtitle", "time": 7188.07, "timestamp": "01:59:48", "text": "彼らの悪い面を批判したりはしません。 えっと、私はあまり"}, {"type": "subtitle", "time": 7190.39, "timestamp": "01:59:50", "text": "人を知りません。 わからない。   わからない"}, {"type": "subtitle", "time": 7192.629, "timestamp": "01:59:52", "text": "。   でも、それ以来、"}, {"type": "subtitle", "time": 7195.83, "timestamp": "01:59:55", "text": "私は多くのことを学びました。"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "ええと、私は自分を守らなければなりません。"}]
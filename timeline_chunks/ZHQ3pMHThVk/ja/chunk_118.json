[{"type": "subtitle", "time": 7081.27, "timestamp": "01:58:01", "text": "配信で全部明かしちゃったよ。 一体"}, {"type": "subtitle", "time": 7083.669, "timestamp": "01:58:03", "text": "私はどうしちゃったんだろう？ でも、もっと詳しい情報が欲しいなら"}, {"type": "subtitle", "time": 7085.35, "timestamp": "01:58:05", "text": "、ビデオを見ればいいし、気にしなくてもいいよ"}, {"type": "subtitle", "time": 7087.669, "timestamp": "01:58:07", "text": "。 わからない"}, {"type": "subtitle", "time": 7093.669, "timestamp": "01:58:13", "text": "[うめき声]"}, {"type": "subtitle", "time": 7095.589, "timestamp": "01:58:15", "text": "ああ、でも、ああ、私は、もっと多くの"}, {"type": "subtitle", "time": 7103.109, "timestamp": "01:58:23", "text": "人が私を見つけると、ああ、インドのユーチューバーだとは思わ"}, {"type": "subtitle", "time": 7106.31, "timestamp": "01:58:26", "text": "ない、彼らは私が新人か何かだと思っている、あるいは、"}, {"type": "subtitle", "time": 7108.95, "timestamp": "01:58:28", "text": "もし彼らが私を検索すれば、"}, {"type": "subtitle", "time": 7119.109, "timestamp": "01:58:39", "text": "ええ、ええ、TLDDR があることを知ってくれるかもしれないので、"}, {"type": "subtitle", "time": 7121.35, "timestamp": "01:58:41", "text": "ええ、もしあなたが望むなら、"}, {"type": "subtitle", "time": 7123.189, "timestamp": "01:58:43", "text": "TLDDR を読んでください、それは"}, {"type": "subtitle", "time": 7126.629, "timestamp": "01:58:46", "text": "私の YouTube チャンネルの黒いビデオです。 ええと、"}, {"type": "subtitle", "time": 7133.91, "timestamp": "01:58:53", "text": "あなたのDiscordに参加するまで、あなたは新人だと思っていました。"}, {"type": "subtitle", "time": 7137.589, "timestamp": "01:58:57", "text": "私は古参ファンだと思う。 私は小売業を始めてもう"}]
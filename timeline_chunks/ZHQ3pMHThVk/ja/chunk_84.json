[{"type": "subtitle", "time": 5047.11, "timestamp": "01:24:07", "text": "えっと、"}, {"type": "subtitle", "time": 5054.39, "timestamp": "01:24:14", "text": "私はあまり変わっていないよね？ ああ。   そうそう"}, {"type": "subtitle", "time": 5056.629, "timestamp": "01:24:16", "text": "。 お腹、"}, {"type": "subtitle", "time": 5059.43, "timestamp": "01:24:19", "text": "何かを変えなきゃ。 いいえ。わかりました"}, {"type": "subtitle", "time": 5063.11, "timestamp": "01:24:23", "text": "、すべてのビデオを入手しました。 これは"}, {"type": "subtitle", "time": 5066.39, "timestamp": "01:24:26", "text": "私たちの「リンズ」と呼ばれるものに入ります。   名前を"}, {"type": "subtitle", "time": 5069.59, "timestamp": "01:24:29", "text": "変えた方がいい気がする。"}, {"type": "subtitle", "time": 5072.07, "timestamp": "01:24:32", "text": "さらに混乱を招くでしょう。"}, {"type": "subtitle", "time": 5074.07, "timestamp": "01:24:34", "text": "ライブ配信をすべて取得します。 ええ、これらは"}, {"type": "subtitle", "time": 5079.91, "timestamp": "01:24:39", "text": "VODです。 わかった。 なぜ小さいのですか？ わかった。 待って。"}, {"type": "subtitle", "time": 5083.59, "timestamp": "01:24:43", "text": "時々、あなたはとてもマレーシア訛りで話すね。 ええ、そう思いますよ"}, {"type": "subtitle", "time": 5086.07, "timestamp": "01:24:46", "text": "。"}, {"type": "subtitle", "time": 5088.149, "timestamp": "01:24:48", "text": "何？   わかった"}]
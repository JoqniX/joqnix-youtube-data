[{"type": "subtitle", "time": 7022.07, "timestamp": "01:57:02", "text": "結論に飛びついたからです。ああ、彼は悪い人だ、あれこれ。ええ"}, {"type": "subtitle", "time": 7027.27, "timestamp": "01:57:07", "text": "、そういうことが起こり、ええ、"}, {"type": "subtitle", "time": 7029.189, "timestamp": "01:57:09", "text": "私に反対した私のコミュニティの人たちは"}, {"type": "subtitle", "time": 7030.79, "timestamp": "01:57:10", "text": "謝罪しました。"}, {"type": "subtitle", "time": 7032.79, "timestamp": "01:57:12", "text": "ええと、関係者や"}, {"type": "subtitle", "time": 7034.55, "timestamp": "01:57:14", "text": "ユーチューバーたちは、決して謝罪しませんでした。 彼らは"}, {"type": "subtitle", "time": 7044.55, "timestamp": "01:57:24", "text": "、いつか私の"}, {"type": "subtitle", "time": 7049.35, "timestamp": "01:57:29", "text": "主張に反論できたらいいなと思っています。なぜなら、私は"}, {"type": "subtitle", "time": 7052.47, "timestamp": "01:57:32", "text": "すべての証拠を提出したからです。 私は非常に"}, {"type": "subtitle", "time": 7054.709, "timestamp": "01:57:34", "text": "正直に話しました。 そして私は、"}, {"type": "subtitle", "time": 7058.629, "timestamp": "01:57:38", "text": "自分が小児性愛者ではないことを示すために、DiscordのDMにすべてを見せました。"}, {"type": "subtitle", "time": 7061.669, "timestamp": "01:57:41", "text": "彼らは"}, {"type": "subtitle", "time": 7063.43, "timestamp": "01:57:43", "text": "私が"}, {"type": "subtitle", "time": 7068.79, "timestamp": "01:57:48", "text": "子供の頃に現役の小児性愛者の被害者だったにもかかわらず、私が小児性愛者だと主張していました。"}, {"type": "subtitle", "time": 7071.669, "timestamp": "01:57:51", "text": "それが、"}, {"type": "subtitle", "time": 7074.07, "timestamp": "01:57:54", "text": "さっき話していた祭壇係"}, {"type": "subtitle", "time": 7076.691, "timestamp": "01:57:56", "text": "とか教会関係のあれこれといったことなんです。"}, {"type": "subtitle", "time": 7079.51, "timestamp": "01:57:59", "text": "[息を呑む] ええ。 くそ。 ああ、"}]
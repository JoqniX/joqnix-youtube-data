[{"type": "subtitle", "time": 8222.87, "timestamp": "02:17:02", "text": "30分後にジムと会う予定です。 こんにちは。"}, {"type": "subtitle", "time": 8225.589, "timestamp": "02:17:05", "text": "夜遅くに、DNAの配信をします。"}, {"type": "subtitle", "time": 8227.83, "timestamp": "02:17:07", "text": "私たちは農業をします。   運に恵まれなければならない"}, {"type": "subtitle", "time": 8230.23, "timestamp": "02:17:10", "text": "。 いや、あの"}, {"type": "subtitle", "time": 8233.19, "timestamp": "02:17:13", "text": "光沢のある箱型のやつが欲しいんだ。"}, {"type": "subtitle", "time": 8236.054, "timestamp": "02:17:16", "text": "ええと、それについては頑張って探します。"}, {"type": "subtitle", "time": 8237.349, "timestamp": "02:17:17", "text": "[咳払い]"}, {"type": "subtitle", "time": 8271.11, "timestamp": "02:17:51", "text": "よし、今日はのんびり過ごそう。 ええ、ちなみに、私たちはそれを"}, {"type": "subtitle", "time": 8273.27, "timestamp": "02:17:53", "text": "完成させましたし、うまく機能しています"}, {"type": "subtitle", "time": 8276.629, "timestamp": "02:17:56", "text": "。"}]
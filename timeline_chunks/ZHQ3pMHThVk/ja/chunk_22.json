[{"type": "subtitle", "time": 1322.07, "timestamp": "00:22:02", "text": "例えば、"}, {"type": "chat", "time": 1322.764, "timestamp": "00:22:02", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "ohhhhh"}, {"type": "subtitle", "time": 1326.31, "timestamp": "00:22:06", "text": "YouTube にアクセスして動画を埋め込むことはできません。"}, {"type": "subtitle", "time": 1331.669, "timestamp": "00:22:11", "text": "動画を右クリックして共有し、動画を埋め込むというリンクをコピーして、それを Web"}, {"type": "subtitle", "time": 1337.75, "timestamp": "00:22:17", "text": "サイトに配置する方法は現在ではできません。今後は参照ポリシーが必要になります。これは"}, {"type": "subtitle", "time": 1345.27, "timestamp": "00:22:25", "text": "少し面倒なので、機能しません"}, {"type": "subtitle", "time": 1346.789, "timestamp": "00:22:26", "text": "。"}, {"type": "subtitle", "time": 1349.83, "timestamp": "00:22:29", "text": "そこで、それを解決するために、"}, {"type": "subtitle", "time": 1352.07, "timestamp": "00:22:32", "text": "参照ポリシーが必要なので、それを自分のウェブ"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "サイトにホストすることにしました。"}, {"type": "subtitle", "time": 1356.549, "timestamp": "00:22:36", "text": "チャットGPTがそう提案したんです。 だから私は「よし、ここに置こう」と思ったんです"}, {"type": "subtitle", "time": 1359.35, "timestamp": "00:22:39", "text": "。 そして、それはうまくいった。"}, {"type": "subtitle", "time": 1361.99, "timestamp": "00:22:41", "text": "しかし今のところ、MELでは動作するものの、OBSでは"}, {"type": "subtitle", "time": 1364.789, "timestamp": "00:22:44", "text": "動作しません。"}, {"type": "subtitle", "time": 1368.149, "timestamp": "00:22:48", "text": "GitHubでプルリクエストを作成する必要があります。 プル"}, {"type": "subtitle", "time": 1371.029, "timestamp": "00:22:51", "text": "リクエストではなく、プルリクエストを作成して、"}, {"type": "subtitle", "time": 1374.63, "timestamp": "00:22:54", "text": "なぜ動作しないのかなどを質問してください"}, {"type": "subtitle", "time": 1378.07, "timestamp": "00:22:58", "text": "。  OBSも修正できるはずです。OBSの開発元は、"}]
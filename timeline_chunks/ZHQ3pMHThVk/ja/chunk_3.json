[{"type": "subtitle", "time": 181.99, "timestamp": "00:03:01", "text": "今日はDNAか"}, {"type": "subtitle", "time": 183.67, "timestamp": "00:03:03", "text": "Battlefield"}, {"type": "subtitle", "time": 189.50900000000001, "timestamp": "00:03:09", "text": "Red Sackを配信したかったんだけど、できなかったんだ。それで"}, {"type": "subtitle", "time": 192.55, "timestamp": "00:03:12", "text": "今日、すごくいいアイデアが浮かんで、「"}, {"type": "subtitle", "time": 194.71, "timestamp": "00:03:14", "text": "ああ、これならできる。これをやりたい"}, {"type": "subtitle", "time": 199.589, "timestamp": "00:03:19", "text": "」って思ったんだ。 えっと、またしてもサミー関連の作業をしています"}, {"type": "subtitle", "time": 202.39, "timestamp": "00:03:22", "text": "。"}, {"type": "subtitle", "time": 205.67000000000002, "timestamp": "00:03:25", "text": "えっと、自分で解決します。 もう"}, {"type": "subtitle", "time": 208.71, "timestamp": "00:03:28", "text": "半分近く終わった。 だから、心配いりません。 もう"}, {"type": "subtitle", "time": 212.47, "timestamp": "00:03:32", "text": "半分くらい終わった。 私は午前"}, {"type": "subtitle", "time": 216.22899999999998, "timestamp": "00:03:36", "text": "11時からその作業に取り組んでいました。"}, {"type": "subtitle", "time": 220.55, "timestamp": "00:03:40", "text": "その時間は配信する予定だったのですが。 私はそれを"}, {"type": "subtitle", "time": 224.39, "timestamp": "00:03:44", "text": "修正するために作業していました。   ええ"}, {"type": "subtitle", "time": 231.35, "timestamp": "00:03:51", "text": "、基本的なことはできました。"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "ああ、"}, {"type": "subtitle", "time": 238.47, "timestamp": "00:03:58", "text": "でもそういうことをいくつか付け加えなきゃいけないんです"}]
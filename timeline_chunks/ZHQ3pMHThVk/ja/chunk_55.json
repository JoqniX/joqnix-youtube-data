[{"type": "subtitle", "time": 3305.43, "timestamp": "00:55:05", "text": "よし、では"}, {"type": "subtitle", "time": 3309.589, "timestamp": "00:55:09", "text": "コマンドをKの外に保存しよう。あ、待てよ。 何？"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "何？ 何？ 何？ 何？ ねえ、"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "私、何かした？ ああ、この人か。 よし、この"}, {"type": "subtitle", "time": 3318.23, "timestamp": "00:55:18", "text": "男だ。 ごめんなさい。 えっと、すみません。"}, {"type": "subtitle", "time": 3320.309, "timestamp": "00:55:20", "text": "実際、あなたは必要ないんです。 じゃあ、そこに君を配置するよ"}, {"type": "subtitle", "time": 3322.843, "timestamp": "00:55:22", "text": "。"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "Notionのアップデートを常にチェックしておいてください。 それでは、"}, {"type": "subtitle", "time": 3337.43, "timestamp": "00:55:37", "text": "ここに何か数字を入れて"}, {"type": "subtitle", "time": 3340.63, "timestamp": "00:55:40", "text": "表示させましょう。   えっと、"}, {"type": "subtitle", "time": 3345.589, "timestamp": "00:55:45", "text": "ストリーミングをしている場合、ああ、"}, {"type": "subtitle", "time": 3349.99, "timestamp": "00:55:49", "text": "待って、これも問題になると思います。"}, {"type": "subtitle", "time": 3351.91, "timestamp": "00:55:51", "text": "将来修正できると思いますが、"}, {"type": "subtitle", "time": 3354.47, "timestamp": "00:55:54", "text": "今日全部修正した方がいいでしょうか。わかりませんが、"}, {"type": "subtitle", "time": 3357.75, "timestamp": "00:55:57", "text": "メル通貨がBRBまたはゲームの場合、"}]
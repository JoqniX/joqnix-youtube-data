[{"type": "subtitle", "time": 6255.669, "timestamp": "01:44:15", "text": "、待って。 正直に言うと、今日は"}, {"type": "subtitle", "time": 6258.95, "timestamp": "01:44:18", "text": "私がLGBTQとは何かを知った日のような気がします"}, {"type": "subtitle", "time": 6261.59, "timestamp": "01:44:21", "text": "。"}, {"type": "subtitle", "time": 6265.189, "timestamp": "01:44:25", "text": "2019年にこんな風に配信していたら、見知らぬ人がチャットに入ってきて、"}, {"type": "subtitle", "time": 6268.39, "timestamp": "01:44:28", "text": "「あなたはゲイですか"}, {"type": "subtitle", "time": 6270.47, "timestamp": "01:44:30", "text": "？LGBTコミュニティの一員ですか"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "？」と聞いてきたんです。  「え？"}, {"type": "subtitle", "time": 6277.43, "timestamp": "01:44:37", "text": "LGBTQ+って何？」って感じでした。 などなど。"}, {"type": "subtitle", "time": 6280.39, "timestamp": "01:44:40", "text": "そして私はそれをグーグルで検索した。 そうやって、人間にはいろんな性別があるんだ、とかいうことを知ったんだ"}, {"type": "subtitle", "time": 6288.47, "timestamp": "01:44:48", "text": "。 ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 6291.75, "timestamp": "01:44:51", "text": "驚いたし、何もかも"}]
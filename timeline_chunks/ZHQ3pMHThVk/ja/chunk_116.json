[{"type": "subtitle", "time": 6962.709, "timestamp": "01:56:02", "text": "真実は何なのか、すべてが明らかになりました。 こんにちは、これが"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "ええと、それ以来、ある意味でインドの"}, {"type": "subtitle", "time": 6973.669, "timestamp": "01:56:13", "text": "vtubingスペースを離れました。つまり、"}, {"type": "subtitle", "time": 6976.79, "timestamp": "01:56:16", "text": "インド人メンバーとしての自分を排除するのは難しいですよね。"}, {"type": "subtitle", "time": 6979.03, "timestamp": "01:56:19", "text": "すでにBBCの記事で"}, {"type": "subtitle", "time": 6981.83, "timestamp": "01:56:21", "text": "私とこのコミュニティへの貢献について書かれていて、"}, {"type": "subtitle", "time": 6985.99, "timestamp": "01:56:25", "text": "私はどこにでもいるので、"}, {"type": "subtitle", "time": 6988.55, "timestamp": "01:56:28", "text": "私の不透明さを排除するのは難しいです。でも、私はまだ"}, {"type": "subtitle", "time": 6996.229, "timestamp": "01:56:36", "text": "そのスペースに再び関わりたくありません。"}, {"type": "subtitle", "time": 6999.669, "timestamp": "01:56:39", "text": "なぜなら、それはあまりにも有害で、ええと、それ"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "以来、人やクリエイティブを信頼するのが難しく、私の"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "コミュニティが私に反対しました。"}, {"type": "subtitle", "time": 7010.79, "timestamp": "01:56:50", "text": "あの状況が起こったとき、ええと、"}, {"type": "subtitle", "time": 7015.589, "timestamp": "01:56:55", "text": "誰も"}, {"type": "subtitle", "time": 7018.39, "timestamp": "01:56:58", "text": "私の味方になりたくなくて、みんなが"}]
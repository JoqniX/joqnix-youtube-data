[{"type": "subtitle", "time": 6121.43, "timestamp": "01:42:01", "text": "また、それに関するチャットコメントがあったと思います"}, {"type": "subtitle", "time": 6122.87, "timestamp": "01:42:02", "text": "。"}, {"type": "subtitle", "time": 6125.59, "timestamp": "01:42:05", "text": "ええ、私の声が"}, {"type": "subtitle", "time": 6128.39, "timestamp": "01:42:08", "text": "人によっては分かりにくいかもしれないということは理解しています。"}, {"type": "subtitle", "time": 6132.07, "timestamp": "01:42:12", "text": "えっと、誰かが私の性別を間違えたり、あれこれ言ったりするんです。"}, {"type": "subtitle", "time": 6134.709, "timestamp": "01:42:14", "text": "人々の没入感を損ないたくないんです"}, {"type": "subtitle", "time": 6136.709, "timestamp": "01:42:16", "text": "。   だから、だから、"}, {"type": "subtitle", "time": 6142.47, "timestamp": "01:42:22", "text": "あなたが話したいことは何でも話せるようにしているんです。"}, {"type": "subtitle", "time": 6146.55, "timestamp": "01:42:26", "text": "パス B サイド B のものが"}, {"type": "subtitle", "time": 6148.47, "timestamp": "01:42:28", "text": "一般的には、"}, {"type": "subtitle", "time": 6151.43, "timestamp": "01:42:31", "text": "個人が LGBTQ であると自認する立場を指します。たとえば、"}, {"type": "subtitle", "time": 6152.87, "timestamp": "01:42:32", "text": "ゲイのキリスト教徒やポストコンの"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "転向療法ですが、結婚の伝統的な聖書的解釈に"}, {"type": "subtitle", "time": 6158.55, "timestamp": "01:42:38", "text": "基づく独身生活や非順応的な関係を実践し、"}, {"type": "subtitle", "time": 6166.07, "timestamp": "01:42:46", "text": "性的な日々を通じてのみ結婚が行われてきたと信じています。ゲイのアイデンティティは"}, {"type": "subtitle", "time": 6168.79, "timestamp": "01:42:48", "text": "同性婚と同じであると信じていますが、それは一体何なのでしょうか。"}, {"type": "subtitle", "time": 6175.99, "timestamp": "01:42:55", "text": "パス X は一般的に、"}]
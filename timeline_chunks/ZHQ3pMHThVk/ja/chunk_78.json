[{"type": "subtitle", "time": 4681.669, "timestamp": "01:18:01", "text": "コピー。"}, {"type": "subtitle", "time": 4684.79, "timestamp": "01:18:04", "text": "では、"}, {"type": "subtitle", "time": 4687.35, "timestamp": "01:18:07", "text": "変更しなかったらどうなるか見てみましょう。 私が興味を持っているのはまさにそれです"}, {"type": "subtitle", "time": 4691.669, "timestamp": "01:18:11", "text": "。 ここに置いておきますね。 それを私たちの"}, {"type": "subtitle", "time": 4693.91, "timestamp": "01:18:13", "text": "リンクとして残しておきます。 保存したらすぐにクラッシュするから保存しないよ"}, {"type": "subtitle", "time": 4699.91, "timestamp": "01:18:19", "text": "。 じゃあ、その"}, {"type": "subtitle", "time": 4709.669, "timestamp": "01:18:29", "text": "よく考えないと。"}, {"type": "subtitle", "time": 4711.75, "timestamp": "01:18:31", "text": "聖なる。   わかった"}, {"type": "subtitle", "time": 4715.99, "timestamp": "01:18:35", "text": "。 私が配信しているとき。   わかった"}, {"type": "subtitle", "time": 4719.03, "timestamp": "01:18:39", "text": "。 ライブカテゴリに基づいてプレイリストを取得します"}, {"type": "subtitle", "time": 4721.99, "timestamp": "01:18:41", "text": "。 これで完了です。 タイムアウトまでお待ちください"}, {"type": "subtitle", "time": 4726.709, "timestamp": "01:18:46", "text": "。 わかった。 ああ、わかった。 これです。 では、そのまま"}, {"type": "subtitle", "time": 4730.55, "timestamp": "01:18:50", "text": "コピーします。"}, {"type": "subtitle", "time": 4734.07, "timestamp": "01:18:54", "text": "全部コピーします。"}, {"type": "subtitle", "time": 4737.189, "timestamp": "01:18:57", "text": "なぜだめですか？"}]
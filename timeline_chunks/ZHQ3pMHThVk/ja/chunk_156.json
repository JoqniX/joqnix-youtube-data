[{"type": "subtitle", "time": 9360.63, "timestamp": "02:36:00", "text": "ええ、そうですね。 うん。 この男。 いや、この人だよ。"}, {"type": "subtitle", "time": 9363.03, "timestamp": "02:36:03", "text": "この男。 この男を変えなければならない。"}, {"type": "subtitle", "time": 9377.99, "timestamp": "02:36:17", "text": "ああ、だからさっき壊れたのか。"}, {"type": "subtitle", "time": 9392.15, "timestamp": "02:36:32", "text": "日あなたが話していた日本語学習ゲームって何だったんですか？ 自分。"}, {"type": "subtitle", "time": 9394.63, "timestamp": "02:36:34", "text": "ああ、"}, {"type": "subtitle", "time": 9396.389, "timestamp": "02:36:36", "text": "Steamに絵本みたいなのがあるよ。   それは"}, {"type": "subtitle", "time": 9419.51, "timestamp": "02:36:59", "text": "これです。"}]
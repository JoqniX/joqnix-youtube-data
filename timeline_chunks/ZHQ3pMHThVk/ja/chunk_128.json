[{"type": "subtitle", "time": 7684.79, "timestamp": "02:08:04", "text": "今日は皆さんに失礼なことを言っていなければいいのですが。 今すぐコメントしよう。   えっと、それはただ、"}, {"type": "subtitle", "time": 7688.149, "timestamp": "02:08:08", "text": "先ほどの話で、"}, {"type": "subtitle", "time": 7696.229, "timestamp": "02:08:16", "text": "AMによる友人側のアクセントについてです。 知らなかった。"}, {"type": "subtitle", "time": 7699.51, "timestamp": "02:08:19", "text": "失礼なことを言っていなければいいのですが。"}, {"type": "subtitle", "time": 7702.709, "timestamp": "02:08:22", "text": "えっと、いろいろありましたが、教えてくれてありがとうございます"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "。 わかった。"}, {"type": "subtitle", "time": 7707.75, "timestamp": "02:08:27", "text": "うん。"}, {"type": "subtitle", "time": 7711.35, "timestamp": "02:08:31", "text": "今なら誰かに聞かれたら、「"}, {"type": "subtitle", "time": 7714.149, "timestamp": "02:08:34", "text": "新しい情報を学んだ」と答えることができます。 うん、今日は"}, {"type": "subtitle", "time": 7715.91, "timestamp": "02:08:35", "text": "いい日だった。 私は新しい"}, {"type": "subtitle", "time": 7718.629, "timestamp": "02:08:38", "text": "情報を学びました。 ありがとうございました。"}, {"type": "subtitle", "time": 7721.03, "timestamp": "02:08:41", "text": "ありがとう。"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "こんにちは。   まあ"}, {"type": "subtitle", "time": 7735.51, "timestamp": "02:08:55", "text": "でも正直なところ、あの"}]
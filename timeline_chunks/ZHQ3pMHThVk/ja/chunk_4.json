[{"type": "subtitle", "time": 251.50900000000001, "timestamp": "00:04:11", "text": "よし、それで良さそうだ。 先ほど"}, {"type": "subtitle", "time": 255.50900000000001, "timestamp": "00:04:15", "text": "ツイートして、自分が"}, {"type": "subtitle", "time": 258.15, "timestamp": "00:04:18", "text": "ライブ配信中であることを投稿しました。 後で自動化します。"}, {"type": "subtitle", "time": 263.51, "timestamp": "00:04:23", "text": "今週中に、このようなコワーキングのライブ配信を行います。 ええと、"}, {"type": "subtitle", "time": 266.31, "timestamp": "00:04:26", "text": "おそらく数日のうちに、私はそれをやります"}, {"type": "subtitle", "time": 273.83, "timestamp": "00:04:33", "text": "。 うん。 こんにちは。"}, {"type": "subtitle", "time": 278.15, "timestamp": "00:04:38", "text": "画面を切り替えて、"}, {"type": "subtitle", "time": 286.55, "timestamp": "00:04:46", "text": "今日やろうとしていることや達成したいことについて作業を始めたり、話したりしようかな。 わかった。 こんにちは、わかりました"}, {"type": "subtitle", "time": 289.35, "timestamp": "00:04:49", "text": "。  [咳払い]"}, {"type": "subtitle", "time": 292.469, "timestamp": "00:04:52", "text": "こんにちは。 ということで、今日は、"}, {"type": "subtitle", "time": 294.71, "timestamp": "00:04:54", "text": "いえ、DNAは付いていません"}, {"type": "subtitle", "time": 299.59000000000003, "timestamp": "00:04:59", "text": "。それは昨日のものです。 わかった。 それで、今日"}]
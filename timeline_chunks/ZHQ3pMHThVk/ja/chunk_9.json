[{"type": "subtitle", "time": 543.03, "timestamp": "00:09:03", "text": "プレイリストが作成されます。これが、"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "私が現在カテゴリ分けされているものの 2 つ目の新しい追加機能です。"}, {"type": "subtitle", "time": 554.63, "timestamp": "00:09:14", "text": "バージョン 1 の"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "設定では、オフラインでライブ配信していないときに実行したいのです。Twitch の"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "コンテンツを確認する代わりに、ライブ配信していないときに再生を"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "ランダム化して、"}, {"type": "subtitle", "time": 571.67, "timestamp": "00:09:31", "text": "チャンネルにある 900 本の動画をすべて視聴するかどうかを確認したいのです。このように"}, {"type": "subtitle", "time": 577.509, "timestamp": "00:09:37", "text": "ここから視聴する人は、更新すると"}, {"type": "subtitle", "time": 579.509, "timestamp": "00:09:39", "text": "まったく新しいセットのコンテンツを受け取ることになります。"}, {"type": "subtitle", "time": 583.35, "timestamp": "00:09:43", "text": "これにより、以前short.io"}, {"type": "subtitle", "time": 586.55, "timestamp": "00:09:46", "text": "で使用していたカスタムリンクを生成する必要がなくなります"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "。   ええ"}, {"type": "subtitle", "time": 591.99, "timestamp": "00:09:51", "text": "、以前は持っていました。 だから、"}, {"type": "subtitle", "time": 594.15, "timestamp": "00:09:54", "text": "私はそれをする必要はない。"}, {"type": "subtitle", "time": 598.389, "timestamp": "00:09:58", "text": "皆さんが気に入ってくれた視聴者をユーザーに提供するだけでいいんです"}]
[{"type": "subtitle", "time": 2401.51, "timestamp": "00:40:01", "text": "哦，这里什么都没有。 好的。 哦。 哦。"}, {"type": "subtitle", "time": 2411.75, "timestamp": "00:40:11", "text": "是零。"}, {"type": "subtitle", "time": 2415.27, "timestamp": "00:40:15", "text": "死的。 欢迎你，儿子。 你好。 欢迎光临。"}, {"type": "subtitle", "time": 2425.03, "timestamp": "00:40:25", "text": "我的大脑一片空白。 啊，我"}, {"type": "subtitle", "time": 2428.47, "timestamp": "00:40:28", "text": "运行得怎么样？ 我不明白。 我"}, {"type": "subtitle", "time": 2434.069, "timestamp": "00:40:34", "text": "等等，等等，等等，等等。 想想，想想。"}, {"type": "subtitle", "time": 2435.589, "timestamp": "00:40:35", "text": "乐趣"}, {"type": "subtitle", "time": 2444.71, "timestamp": "00:40:44", "text": "哦，我的错。 但我必须把这个放在这里。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "赌博。"}, {"type": "subtitle", "time": 2449.27, "timestamp": "00:40:49", "text": "为什么我有两个条件语句？ 太令人"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "这是给我听的。"}]
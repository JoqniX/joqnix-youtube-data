[{"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "是啊，我看不懂印地语。 我（笑）"}, {"type": "subtitle", "time": 8167.669, "timestamp": "02:16:07", "text": "做不到。"}, {"type": "chat", "time": 8173.272, "timestamp": "02:16:13", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "I said f u in hindi to him just now"}, {"type": "subtitle", "time": 8176.709, "timestamp": "02:16:16", "text": "马来西亚人扮演印度人。 不，"}, {"type": "subtitle", "time": 8179.91, "timestamp": "02:16:19", "text": "我不是马来西亚人。"}, {"type": "subtitle", "time": 8183.03, "timestamp": "02:16:23", "text": "我用印地语说了句“去你的”，然后就惊呼“我的"}, {"type": "subtitle", "time": 8190.069, "timestamp": "02:16:30", "text": "它就像一个模棱两可的词。 啊，你好。 我"}, {"type": "subtitle", "time": 8212.15, "timestamp": "02:16:52", "text": "不出所料，我的老师"}, {"type": "subtitle", "time": 8216.549, "timestamp": "02:16:56", "text": "又要让我读一些东西，还要我"}, {"type": "subtitle", "time": 8219.11, "timestamp": "02:16:59", "text": "提问。"}]
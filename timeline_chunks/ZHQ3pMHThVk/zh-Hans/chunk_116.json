[{"type": "subtitle", "time": 6962.709, "timestamp": "01:56:02", "text": "真相是什么等等。 嗨，这就是"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "嗯，从那以后，我就离开了印度"}, {"type": "subtitle", "time": 6973.669, "timestamp": "01:56:13", "text": "虚拟主播圈。我的意思是，要彻底"}, {"type": "subtitle", "time": 6976.79, "timestamp": "01:56:16", "text": "摆脱印度成员的身份很难，"}, {"type": "subtitle", "time": 6979.03, "timestamp": "01:56:19", "text": "因为BBC已经有"}, {"type": "subtitle", "time": 6981.83, "timestamp": "01:56:21", "text": "关于我以及我对这个圈子的贡献的文章了，"}, {"type": "subtitle", "time": 6988.55, "timestamp": "01:56:28", "text": "到处都能看到我的身影，所以很难抹去我的个人印记。"}, {"type": "subtitle", "time": 6993.91, "timestamp": "01:56:33", "text": "但我仍然不想再和"}, {"type": "subtitle", "time": 6996.229, "timestamp": "01:56:36", "text": "那个圈子有任何瓜葛，"}, {"type": "subtitle", "time": 6999.669, "timestamp": "01:56:39", "text": "因为它太糟糕了，而且从那以后，"}, {"type": "subtitle", "time": 7002.55, "timestamp": "01:56:42", "text": "我很难再信任别人"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "和创作。我的"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "社群也反对我，你知道，当时的"}, {"type": "subtitle", "time": 7010.79, "timestamp": "01:56:50", "text": "情况是这样的，"}, {"type": "subtitle", "time": 7015.589, "timestamp": "01:56:55", "text": "因为没有人愿意站在"}, {"type": "subtitle", "time": 7018.39, "timestamp": "01:56:58", "text": "我这边，大家都妄下"}]
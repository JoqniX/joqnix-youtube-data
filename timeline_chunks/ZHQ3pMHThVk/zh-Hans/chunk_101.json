[{"type": "subtitle", "time": 6061.91, "timestamp": "01:41:01", "text": "这是什么？"}, {"type": "subtitle", "time": 6064.95, "timestamp": "01:41:04", "text": "哦，等等。"}, {"type": "subtitle", "time": 6068.229, "timestamp": "01:41:08", "text": "你似乎是半个"}, {"type": "subtitle", "time": 6071.109, "timestamp": "01:41:11", "text": "同性恋。 你这是在间接说我是同性恋"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "或者LGBTQ群体成员吗？ 我的天啊。 只是"}, {"type": "subtitle", "time": 6078.709, "timestamp": "01:41:18", "text": "因为我自己的……呃，我的声音听起来……"}, {"type": "subtitle", "time": 6083.03, "timestamp": "01:41:23", "text": "我的天啊，这家伙，"}, {"type": "subtitle", "time": 6085.27, "timestamp": "01:41:25", "text": "兄弟。"}, {"type": "subtitle", "time": 6088.709, "timestamp": "01:41:28", "text": "又一个。 哦，呃，"}, {"type": "subtitle", "time": 6090.95, "timestamp": "01:41:30", "text": "我声音轻柔"}, {"type": "subtitle", "time": 6093.109, "timestamp": "01:41:33", "text": "并不代表我是同性恋、狂热粉丝"}, {"type": "subtitle", "time": 6096.229, "timestamp": "01:41:36", "text": "什么的。 我只是个直男。 我"}, {"type": "subtitle", "time": 6101.27, "timestamp": "01:41:41", "text": "天生就有这样的嗓音。 呃，"}, {"type": "subtitle", "time": 6103.35, "timestamp": "01:41:43", "text": "性别并不重要，因为我是个"}, {"type": "subtitle", "time": 6105.91, "timestamp": "01:41:45", "text": "虚拟主播。 我是一颗星座。"}, {"type": "subtitle", "time": 6109.109, "timestamp": "01:41:49", "text": "它就在那里。 如果你……我不"}, {"type": "subtitle", "time": 6111.43, "timestamp": "01:41:51", "text": "知道我是否曾经……我不知道我是否已经把"}, {"type": "subtitle", "time": 6114.87, "timestamp": "01:41:54", "text": "它添加到我的 Twitch 面板或"}, {"type": "subtitle", "time": 6116.149, "timestamp": "01:41:56", "text": "其他什么地方了，但它确实在那里。 如果你在谷歌上"}, {"type": "subtitle", "time": 6119.27, "timestamp": "01:41:59", "text": "搜索我的名字和相关信息，就能找到。"}]
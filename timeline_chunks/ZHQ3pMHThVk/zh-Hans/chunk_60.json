[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "嗯，就是这样。"}, {"type": "subtitle", "time": 3602.789, "timestamp": "01:00:02", "text": "所以它会显示在"}, {"type": "subtitle", "time": 3605.829, "timestamp": "01:00:05", "text": "网站上。 呃，我这么做只是"}, {"type": "subtitle", "time": 3608.71, "timestamp": "01:00:08", "text": "因为，嗯，"}, {"type": "subtitle", "time": 3614.47, "timestamp": "01:00:14", "text": "YouTube 的嵌入功能不再适用"}, {"type": "subtitle", "time": 3617.109, "timestamp": "01:00:17", "text": "于 OBS 和 MEL，这是由于"}, {"type": "subtitle", "time": 3619.99, "timestamp": "01:00:19", "text": "他们的引用政策问题。 所以我要把他们"}, {"type": "subtitle", "time": 3622.39, "timestamp": "01:00:22", "text": "放在那里，你必须放上"}, {"type": "subtitle", "time": 3624.789, "timestamp": "01:00:24", "text": "参考文献。"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "所以如果是我的网站，我只需要把"}, {"type": "subtitle", "time": 3628.789, "timestamp": "01:00:28", "text": "网站域名填进去就行了，对吧？那就是"}, {"type": "subtitle", "time": 3633.03, "timestamp": "01:00:33", "text": "参考网址，对吧？ 如果用户"}, {"type": "subtitle", "time": 3637.51, "timestamp": "01:00:37", "text": "打开或观看嵌入内容，"}, {"type": "subtitle", "time": 3640.549, "timestamp": "01:00:40", "text": "并且他们正在访问该"}, {"type": "subtitle", "time": 3643.589, "timestamp": "01:00:43", "text": "网站，他们就能观看；如果他们不在该网站，则"}, {"type": "subtitle", "time": 3645.91, "timestamp": "01:00:45", "text": "无法观看，他们会"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "看到此错误。所以我这样设置了，"}, {"type": "subtitle", "time": 3656.23, "timestamp": "01:00:56", "text": "现在我只需要添加一些东西并修复这个设置。"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "另外，让我检查一下，它刚刚在"}]
[{"type": "subtitle", "time": 6420.229, "timestamp": "01:47:00", "text": "控制器布局。 我的天啊。  [笑声]"}, {"type": "subtitle", "time": 6426.629, "timestamp": "01:47:06", "text": "但是，呃，我的意思是，最终，呃，不是现在，而是"}, {"type": "subtitle", "time": 6429.43, "timestamp": "01:47:09", "text": "在遥远的"}, {"type": "subtitle", "time": 6432.47, "timestamp": "01:47:12", "text": "未来，我总得娶个女孩什么的"}, {"type": "subtitle", "time": 6434.87, "timestamp": "01:47:14", "text": "。 不，因为我是直男"}, {"type": "subtitle", "time": 6437.669, "timestamp": "01:47:17", "text": "。 所以，我为什么"}, {"type": "subtitle", "time": 6439.99, "timestamp": "01:47:19", "text": "现在就要考虑结婚呢？ 家人总是"}, {"type": "subtitle", "time": 6443.91, "timestamp": "01:47:23", "text": "问我近况如何，我就说，不，让"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "我专注于自己的生活吧。 让我好好努力工作，"}, {"type": "subtitle", "time": 6457.43, "timestamp": "01:47:37", "text": "呃，你们是反感者吗？ 我不知道。"}, {"type": "subtitle", "time": 6460.55, "timestamp": "01:47:40", "text": "我难道就不能不做个"}, {"type": "subtitle", "time": 6464.39, "timestamp": "01:47:44", "text": "去教堂祈祷的普通基督徒吗？"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "嗯……"}, {"type": "subtitle", "time": 6474.229, "timestamp": "01:47:54", "text": "[笑声]"}, {"type": "subtitle", "time": 6477.109, "timestamp": "01:47:57", "text": "你可以不……是的。 我难道不能"}]
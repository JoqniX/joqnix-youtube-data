[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "？"}, {"type": "subtitle", "time": 4263.99, "timestamp": "01:11:03", "text": "我们之间是友谊。 我为此制作了一个视频"}, {"type": "subtitle", "time": 4266.709, "timestamp": "01:11:06", "text": "。"}, {"type": "subtitle", "time": 4268.63, "timestamp": "01:11:08", "text": "当你提供频道网址时，它会"}, {"type": "subtitle", "time": 4270.709, "timestamp": "01:11:10", "text": "抓取频道内容，其中混合了"}, {"type": "subtitle", "time": 4273.03, "timestamp": "01:11:13", "text": "上传的"}, {"type": "subtitle", "time": 4278.87, "timestamp": "01:11:18", "text": "常规视频、短视频流，以及"}, {"type": "subtitle", "time": 4281.27, "timestamp": "01:11:21", "text": "仅从直播选项卡中获取的内容。 输入"}, {"type": "subtitle", "time": 4284.95, "timestamp": "01:11:24", "text": "名称、频道信息。 你可以通过流来实现，"}, {"type": "subtitle", "time": 4295.99, "timestamp": "01:11:35", "text": "好的，我会这么做。"}, {"type": "subtitle", "time": 4298.63, "timestamp": "01:11:38", "text": "那不就叫准社会主义吗？"}, {"type": "subtitle", "time": 4301.75, "timestamp": "01:11:41", "text": "我只是略微提及了准"}, {"type": "subtitle", "time": 4306.07, "timestamp": "01:11:46", "text": "社会主义，还没有深入探讨过。 我"}, {"type": "subtitle", "time": 4309.35, "timestamp": "01:11:49", "text": "之后想做个视频，跟"}, {"type": "subtitle", "time": 4312.39, "timestamp": "01:11:52", "text": "观众聊聊这个。"}, {"type": "subtitle", "time": 4317.189, "timestamp": "01:11:57", "text": "我真的触动了我们，就像"}, {"type": "subtitle", "time": 4318.87, "timestamp": "01:11:58", "text": "视频里那样，我们是朋友，是创作者之间的"}]
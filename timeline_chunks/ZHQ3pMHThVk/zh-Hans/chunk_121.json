[{"type": "subtitle", "time": 7261.43, "timestamp": "02:01:01", "text": "童年时期的创伤[音乐]，"}, {"type": "subtitle", "time": 7264.07, "timestamp": "02:01:04", "text": "这实际上可能会"}, {"type": "subtitle", "time": 7269.35, "timestamp": "02:01:09", "text": "搞砸一些事情。 仔细想想，"}, {"type": "subtitle", "time": 7272.229, "timestamp": "02:01:12", "text": "我也不知道。 兄弟，我好害怕。 我不"}, {"type": "subtitle", "time": 7277.669, "timestamp": "02:01:17", "text": "知道做事的正确方法是什么。"}, {"type": "subtitle", "time": 7279.43, "timestamp": "02:01:19", "text": "也许是我多虑了。 好的。 也许是"}, {"type": "subtitle", "time": 7281.35, "timestamp": "02:01:21", "text": "我多虑了。"}, {"type": "subtitle", "time": 7289.109, "timestamp": "02:01:29", "text": "我也不知道我为什么会这么说。 嗯，"}, {"type": "subtitle", "time": 7292.07, "timestamp": "02:01:32", "text": "让我再说一遍。 这就是我这么说的原因，"}, {"type": "subtitle", "time": 7295.43, "timestamp": "02:01:35", "text": "因为我小时候发生过一些不好的事情"}, {"type": "subtitle", "time": 7299.109, "timestamp": "02:01:39", "text": "。 好吧，但这同时"}, {"type": "subtitle", "time": 7303.35, "timestamp": "02:01:43", "text": "也让我与信仰的联系减少了，"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "比如"}, {"type": "subtitle", "time": 7309.589, "timestamp": "02:01:49", "text": "去教堂之类的，因为"}, {"type": "subtitle", "time": 7313.589, "timestamp": "02:01:53", "text": "回忆和一些不愉快的事情。 但是，是的，我的意思是，我的确有这个"}, {"type": "subtitle", "time": 7317.189, "timestamp": "02:01:57", "text": "计划，我的确希望，甚至今天我也"}, {"type": "subtitle", "time": 7319.91, "timestamp": "02:01:59", "text": "希望，我偶尔会去教堂，"}]
[{"type": "subtitle", "time": 1504.47, "timestamp": "00:25:04", "text": "9月3日。 是的，他们改了"}, {"type": "subtitle", "time": 1506.149, "timestamp": "00:25:06", "text": "。 他们引入了一种叫做"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "数据源的东西。"}, {"type": "subtitle", "time": 1510.63, "timestamp": "00:25:10", "text": "他们修改了数据库方面的信息。 所以"}, {"type": "subtitle", "time": 1513.269, "timestamp": "00:25:13", "text": "我必须做出很多改变。 我的"}, {"type": "subtitle", "time": 1515.11, "timestamp": "00:25:15", "text": "想法是基于一些正确的事情，比如"}, {"type": "subtitle", "time": 1518.95, "timestamp": "00:25:18", "text": "合作伙伴、数据库，以及我"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "网站上所有与"}, {"type": "subtitle", "time": 1524.39, "timestamp": "00:25:24", "text": "我合作过的 YouTuber 的信息。 哦，对啊，你来了，"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "龙骑士。"}, {"type": "subtitle", "time": 1530.23, "timestamp": "00:25:30", "text": "呃，这些我也得修好"}, {"type": "subtitle", "time": 1533.11, "timestamp": "00:25:33", "text": "。 另外，我还会添加一个"}, {"type": "subtitle", "time": 1535.35, "timestamp": "00:25:35", "text": "功能，点击"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "人名就能显示"}, {"type": "subtitle", "time": 1542.71, "timestamp": "00:25:42", "text": "该人的所有头像，因为我必须"}, {"type": "subtitle", "time": 1546.31, "timestamp": "00:25:46", "text": "手动在 noa 上托管这些头像。 那样"}, {"type": "subtitle", "time": 1548.07, "timestamp": "00:25:48", "text": "会好一些。 我不需要向他们索要"}, {"type": "subtitle", "time": 1550.39, "timestamp": "00:25:50", "text": "更新后的PNG文件。 我可以"}, {"type": "subtitle", "time": 1554.07, "timestamp": "00:25:54", "text": "在自己的地方办点事，把"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "一切都安排妥当，对吧？"}]
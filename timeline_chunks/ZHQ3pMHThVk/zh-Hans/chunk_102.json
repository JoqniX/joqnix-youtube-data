[{"type": "subtitle", "time": 6121.43, "timestamp": "01:42:01", "text": "我觉得我对此有条聊天评论"}, {"type": "subtitle", "time": 6122.87, "timestamp": "01:42:02", "text": "。"}, {"type": "subtitle", "time": 6125.59, "timestamp": "01:42:05", "text": "是的，我知道我的声音可能会让"}, {"type": "subtitle", "time": 6128.39, "timestamp": "01:42:08", "text": "一些人感到困惑。"}, {"type": "subtitle", "time": 6132.07, "timestamp": "01:42:12", "text": "呃，有些人总是用错我的性别代词。 我"}, {"type": "subtitle", "time": 6134.709, "timestamp": "01:42:14", "text": "不想破坏人们的沉浸感"}, {"type": "subtitle", "time": 6136.709, "timestamp": "01:42:16", "text": "。   所以，这就是"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "为什么我把它当作"}, {"type": "subtitle", "time": 6142.47, "timestamp": "01:42:22", "text": "你想谈论的任何话题。 如果"}, {"type": "subtitle", "time": 6146.55, "timestamp": "01:42:26", "text": "你不理解路径 B，那么 B 面"}, {"type": "subtitle", "time": 6148.47, "timestamp": "01:42:28", "text": "通常指的是这样一种立场："}, {"type": "subtitle", "time": 6151.43, "timestamp": "01:42:31", "text": "个人认同自己是 LGBTQ 群体的一员，"}, {"type": "subtitle", "time": 6152.87, "timestamp": "01:42:32", "text": "例如同性恋基督徒或接受过性取向"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "矫正治疗的人，但仍然"}, {"type": "subtitle", "time": 6157.03, "timestamp": "01:42:37", "text": "奉行独身主义或基于"}, {"type": "subtitle", "time": 6160.79, "timestamp": "01:42:40", "text": "传统圣经婚姻规范的非传统关系，"}, {"type": "subtitle", "time": 6166.07, "timestamp": "01:42:46", "text": "认为同性恋身份"}, {"type": "subtitle", "time": 6168.79, "timestamp": "01:42:48", "text": "等同于同性婚姻，这到底是怎么回事？"}, {"type": "subtitle", "time": 6175.99, "timestamp": "01:42:55", "text": "路径 X 通常指的是一种更为"}, {"type": "subtitle", "time": 6177.99, "timestamp": "01:42:57", "text": "保守的立场，它肯定了对"}]
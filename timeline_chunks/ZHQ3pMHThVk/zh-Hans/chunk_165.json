[{"type": "subtitle", "time": 9905.03, "timestamp": "02:45:05", "text": "哦，是的。 随机化 W. 你好。 一切都是"}, {"type": "subtitle", "time": 9907.11, "timestamp": "02:45:07", "text": "随机的。 当我离线时，"}, {"type": "subtitle", "time": 9909.59, "timestamp": "02:45:09", "text": "我的网站上会生成一个随机词"}, {"type": "subtitle", "time": 9913.11, "timestamp": "02:45:13", "text": "。 由于引用的原因，YouTube 嵌入功能无法使用，所以我可以把它放到 OBS 和 Melt 上，"}, {"type": "subtitle", "time": 9921.269, "timestamp": "02:45:21", "text": "用我的"}, {"type": "subtitle", "time": 9925.59, "timestamp": "02:45:25", "text": "网站进行引用嵌入。 你好。"}, {"type": "subtitle", "time": 9928.63, "timestamp": "02:45:28", "text": "终于成功了。 好的。 你好。 我们就到此为止吧"}, {"type": "subtitle", "time": 9931.51, "timestamp": "02:45:31", "text": "。 我得赶紧"}, {"type": "subtitle", "time": 9933.19, "timestamp": "02:45:33", "text": "洗脸什么的，而且不能在课堂上洗。"}, {"type": "subtitle", "time": 9939.51, "timestamp": "02:45:39", "text": "谢谢你今天抽出时间。 真的很有趣。"}, {"type": "subtitle", "time": 9945.03, "timestamp": "02:45:45", "text": "我在这方面投入了很多精力。 接下来，"}, {"type": "subtitle", "time": 9947.11, "timestamp": "02:45:47", "text": "我们将一起直播，"}, {"type": "subtitle", "time": 9950.07, "timestamp": "02:45:50", "text": "修复直播设置中其他按钮和其他一些问题"}, {"type": "subtitle", "time": 9952.63, "timestamp": "02:45:52", "text": "。"}, {"type": "subtitle", "time": 9955.91, "timestamp": "02:45:55", "text": "我还想改进自动化"}, {"type": "subtitle", "time": 9958.389, "timestamp": "02:45:58", "text": "审核系统，特别是针对"}]
[{"type": "subtitle", "time": 7325.91, "timestamp": "02:02:05", "text": "但我也希望，你知道，"}, {"type": "subtitle", "time": 7329.524, "timestamp": "02:02:09", "text": "嗯，回到"}, {"type": "subtitle", "time": 7333.91, "timestamp": "02:02:13", "text": "我小时候的样子[笑声]。 呃，我当时"}, {"type": "subtitle", "time": 7337.27, "timestamp": "02:02:17", "text": "就像个十足的奶奶辈男孩。 我的"}, {"type": "subtitle", "time": 7339.51, "timestamp": "02:02:19", "text": "祖母非常"}, {"type": "subtitle", "time": 7344.55, "timestamp": "02:02:24", "text": "迷信，她喜欢"}, {"type": "subtitle", "time": 7347.209, "timestamp": "02:02:27", "text": "祈祷之类的东西。 即使到了今天"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "[笑]，她还是会看电视，"}, {"type": "subtitle", "time": 7352.629, "timestamp": "02:02:32", "text": "每天都会祈祷什么的，是"}, {"type": "subtitle", "time": 7356.55, "timestamp": "02:02:36", "text": "啊，我以前也喜欢那样，"}, {"type": "subtitle", "time": 7358.95, "timestamp": "02:02:38", "text": "我就是这样开始"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "在教堂里当辅祭的。 所以，是的，我确实希望回到"}, {"type": "subtitle", "time": 7364.95, "timestamp": "02:02:44", "text": "过去的样子，你"}, {"type": "subtitle", "time": 7366.87, "timestamp": "02:02:46", "text": "知道，每天去教堂，为"}, {"type": "subtitle", "time": 7371.27, "timestamp": "02:02:51", "text": "我的家人、为我自己以及所有的一切祈祷。"}, {"type": "subtitle", "time": 7374.47, "timestamp": "02:02:54", "text": "是的，从物理治疗"}, {"type": "subtitle", "time": 7376.629, "timestamp": "02:02:56", "text": "创伤中恢复确实很困难，但"}]
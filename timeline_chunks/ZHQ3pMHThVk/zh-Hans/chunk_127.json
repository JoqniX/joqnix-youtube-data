[{"type": "subtitle", "time": 7621.589, "timestamp": "02:07:01", "text": "好好经营我自己的社区，比如"}, {"type": "subtitle", "time": 7624.229, "timestamp": "02:07:04", "text": "Jocknik the Constell，对吧？"}, {"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "呃，是的，还有这个原因。所以这次，"}, {"type": "subtitle", "time": 7630.95, "timestamp": "02:07:10", "text": "既然我已经不再是社区的一员了，"}, {"type": "subtitle", "time": 7634.069, "timestamp": "02:07:14", "text": "我想专注于我自己的空间，对吧？"}, {"type": "subtitle", "time": 7636.55, "timestamp": "02:07:16", "text": "保持一切……"}, {"type": "subtitle", "time": 7638.87, "timestamp": "02:07:18", "text": "呃，保持低调，这样我就不会受到伤害等等。"}, {"type": "subtitle", "time": 7642.55, "timestamp": "02:07:22", "text": "这也是为什么"}, {"type": "subtitle", "time": 7645.51, "timestamp": "02:07:25", "text": "不会再有版主的原因，"}, {"type": "subtitle", "time": 7649.35, "timestamp": "02:07:29", "text": "我必须找到我"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "信任的人。  [笑声]"}, {"type": "subtitle", "time": 7659.99, "timestamp": "02:07:39", "text": "但是，嗯，嗯，嗯，"}, {"type": "subtitle", "time": 7663.99, "timestamp": "02:07:43", "text": "回来吧，嗯，嗯，"}, {"type": "subtitle", "time": 7670.069, "timestamp": "02:07:50", "text": "我出了名的太爱讨好别人，"}, {"type": "subtitle", "time": 7672.069, "timestamp": "02:07:52", "text": "不懂得划清界限。 所以这就是为什么我"}, {"type": "subtitle", "time": 7675.99, "timestamp": "02:07:55", "text": "更想执行"}, {"type": "subtitle", "time": 7679.669, "timestamp": "02:07:59", "text": "规则之类的原因。 所以，我希望我"}]
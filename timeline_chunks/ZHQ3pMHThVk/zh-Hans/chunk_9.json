[{"type": "subtitle", "time": 543.03, "timestamp": "00:09:03", "text": "随机播放列表。嗯，这是"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "我想要添加的第二个功能。"}, {"type": "subtitle", "time": 548.389, "timestamp": "00:09:08", "text": "目前它在一个分类里，"}, {"type": "subtitle", "time": 551.03, "timestamp": "00:09:11", "text": "但现在我想为"}, {"type": "subtitle", "time": 554.63, "timestamp": "00:09:14", "text": "版本一的设置添加一个随机播放功能。"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "我想在离线状态下，也就是"}, {"type": "subtitle", "time": 559.75, "timestamp": "00:09:19", "text": "我不直播的时候，而不是检查"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "我的 Twitch 内容，我想检查"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "当我不直播的时候，是否随机"}, {"type": "subtitle", "time": 567.35, "timestamp": "00:09:27", "text": "播放"}, {"type": "subtitle", "time": 571.67, "timestamp": "00:09:31", "text": "我频道里的所有 900 个视频。"}, {"type": "subtitle", "time": 575.11, "timestamp": "00:09:35", "text": "这样，每个从这里观看的人，"}, {"type": "subtitle", "time": 577.509, "timestamp": "00:09:37", "text": "当他们刷新页面时，都会"}, {"type": "subtitle", "time": 579.509, "timestamp": "00:09:39", "text": "看到一组全新的内容，"}, {"type": "subtitle", "time": 583.35, "timestamp": "00:09:43", "text": "对吧？ 这让我无需像以前"}, {"type": "subtitle", "time": 586.55, "timestamp": "00:09:46", "text": "在 short.io 中那样生成自定义链接"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "。   嗯，是的，"}, {"type": "subtitle", "time": 591.99, "timestamp": "00:09:51", "text": "我以前有过。 所以"}, {"type": "subtitle", "time": 594.15, "timestamp": "00:09:54", "text": "我不需要那样做。 我可以把"}, {"type": "subtitle", "time": 598.389, "timestamp": "00:09:58", "text": "你们喜欢的这个"}]
[{"type": "subtitle", "time": 7742.31, "timestamp": "02:09:02", "text": "改一下那句话。"}, {"type": "subtitle", "time": 7744.31, "timestamp": "02:09:04", "text": "我只是害怕。 你永远无法预料"}, {"type": "subtitle", "time": 7746.629, "timestamp": "02:09:06", "text": "别人会是什么样的人。 我的意思是，我吸取了自己的"}, {"type": "subtitle", "time": 7748.39, "timestamp": "02:09:08", "text": "教训。  [笑声]"}, {"type": "subtitle", "time": 7752.39, "timestamp": "02:09:12", "text": "嗯，是啊，但"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "我担心的是"}, {"type": "subtitle", "time": 7758.069, "timestamp": "02:09:18", "text": "从未发生过的未来。 啊，我又开始想太多了"}, {"type": "subtitle", "time": 7766.95, "timestamp": "02:09:26", "text": "为什么我的想法会如此阴暗呢？"}, {"type": "subtitle", "time": 7770.069, "timestamp": "02:09:30", "text": "我的天哪，那太糟糕了。"}, {"type": "subtitle", "time": 7779.35, "timestamp": "02:09:39", "text": "现在，呃，我之所以说"}, {"type": "subtitle", "time": 7781.43, "timestamp": "02:09:41", "text": "我为什么还在想这件事，是因为"}, {"type": "subtitle", "time": 7785.27, "timestamp": "02:09:45", "text": "我在 YouTube 和 Twitter 上看到了一些东西，"}, {"type": "subtitle", "time": 7791.51, "timestamp": "02:09:51", "text": "哦，"}, {"type": "subtitle", "time": 7794.79, "timestamp": "02:09:54", "text": "如果我不小心，我也可能成为"}, {"type": "subtitle", "time": 7796.39, "timestamp": "02:09:56", "text": "目标之类的"}, {"type": "subtitle", "time": 7798.79, "timestamp": "02:09:58", "text": "。"}]
[{"type": "subtitle", "time": 7562.39, "timestamp": "02:06:02", "text": "得去……呃，维基百科，我总是"}, {"type": "subtitle", "time": 7564.87, "timestamp": "02:06:04", "text": "忘记……[倒吸一口凉气]"}, {"type": "subtitle", "time": 7577.109, "timestamp": "02:06:17", "text": "希望你能明白。 我会支持你。"}, {"type": "subtitle", "time": 7579.43, "timestamp": "02:06:19", "text": "你好。 谢谢。"}, {"type": "subtitle", "time": 7582.95, "timestamp": "02:06:22", "text": "而且，呃，我又来了，嗯，只是从那以后，"}, {"type": "subtitle", "time": 7585.27, "timestamp": "02:06:25", "text": "所有的"}, {"type": "subtitle", "time": 7588.07, "timestamp": "02:06:28", "text": "纷争和人，我觉得我的整个"}, {"type": "subtitle", "time": 7590.47, "timestamp": "02:06:30", "text": "社区都消失了。 更像是，"}, {"type": "subtitle", "time": 7593.109, "timestamp": "02:06:33", "text": "我重新开始积极地进行直播"}, {"type": "subtitle", "time": 7595.27, "timestamp": "02:06:35", "text": "等等，因为我想重建我"}, {"type": "subtitle", "time": 7600.31, "timestamp": "02:06:40", "text": "自己的空间，因为我从来没有好好地花"}, {"type": "subtitle", "time": 7603.189, "timestamp": "02:06:43", "text": "时间"}, {"type": "subtitle", "time": 7605.35, "timestamp": "02:06:45", "text": "专注于我自己的音乐社群。 不，因为我"}, {"type": "subtitle", "time": 7608.79, "timestamp": "02:06:48", "text": "是在为整个印度裔群体做贡献，而不是为我自己的"}, {"type": "subtitle", "time": 7611.51, "timestamp": "02:06:51", "text": "群体做贡献"}, {"type": "subtitle", "time": 7618.629, "timestamp": "02:06:58", "text": "。 呃，正因为如此，我才没能"}]
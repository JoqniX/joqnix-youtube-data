[{"type": "subtitle", "time": 2886.15, "timestamp": "00:48:06", "text": "我还是没能解决这个问题。  [笑声]"}, {"type": "subtitle", "time": 2910.23, "timestamp": "00:48:30", "text": "M吗？好的。 检查我是否正在直播。 如果"}, {"type": "subtitle", "time": 2914.79, "timestamp": "00:48:34", "text": "答案是“是”，则运行。 好的。 呃，把这个藏起来。"}, {"type": "subtitle", "time": 2917.109, "timestamp": "00:48:37", "text": "不。好的。 好的。 哦好的。 知道了。 知道了"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "。 知道了。 知道了。 我想我明白了。"}, {"type": "subtitle", "time": 2921.99, "timestamp": "00:48:41", "text": "所以，对于这个东西的第一个版本"}, {"type": "subtitle", "time": 2925.349, "timestamp": "00:48:45", "text": "，我把它放在"}, {"type": "subtitle", "time": 2929.43, "timestamp": "00:48:49", "text": "离线时随机发起战争的地方。"}, {"type": "subtitle", "time": 2931.589, "timestamp": "00:48:51", "text": "正确的。   是"}, {"type": "subtitle", "time": 2934.79, "timestamp": "00:48:54", "text": "啊，是啊，是啊，是啊。"}, {"type": "subtitle", "time": 2938.23, "timestamp": "00:48:58", "text": "哦，是的。 好的，明白了。"}]
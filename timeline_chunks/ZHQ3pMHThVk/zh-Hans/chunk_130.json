[{"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "哇。 哦，等等。 你听到我的"}, {"type": "subtitle", "time": 7806.87, "timestamp": "02:10:06", "text": "狗叫了吗？ 不。对。 是的。 我这么说的原因"}, {"type": "subtitle", "time": 7809.03, "timestamp": "02:10:09", "text": "是，你看，我的整个"}, {"type": "subtitle", "time": 7812.069, "timestamp": "02:10:12", "text": "职业生涯现在都毁了。 我的"}, {"type": "subtitle", "time": 7814.709, "timestamp": "02:10:14", "text": "人格遭到了抹黑。"}, {"type": "subtitle", "time": 7816.629, "timestamp": "02:10:16", "text": "我辛辛苦苦挣来的一切，全都"}, {"type": "subtitle", "time": 7820.629, "timestamp": "02:10:20", "text": "化为乌有。 海绵宝宝经纪公司，这个那个，"}, {"type": "subtitle", "time": 7823.51, "timestamp": "02:10:23", "text": "模特，一切都消失了。"}, {"type": "subtitle", "time": 7825.83, "timestamp": "02:10:25", "text": "所以，现在一切重新开始。 所以我不想让"}, {"type": "subtitle", "time": 7829.27, "timestamp": "02:10:29", "text": "人们对"}, {"type": "subtitle", "time": 7831.43, "timestamp": "02:10:31", "text": "一些新的闹剧吹毛求疵，把我卷进去，把"}, {"type": "subtitle", "time": 7835.589, "timestamp": "02:10:35", "text": "现在的闹剧和以前"}, {"type": "subtitle", "time": 7838.709, "timestamp": "02:10:38", "text": "发生的事混为一谈，然后彻底把我写死之类的"}, {"type": "subtitle", "time": 7840.39, "timestamp": "02:10:40", "text": "。 我不想"}, {"type": "subtitle", "time": 7848.069, "timestamp": "02:10:48", "text": "嗯，总之我觉得我应该结束了。"}, {"type": "subtitle", "time": 7850.629, "timestamp": "02:10:50", "text": "我们为什么要讨论这个问题？  [笑声]"}, {"type": "subtitle", "time": 7854.87, "timestamp": "02:10:54", "text": "无需制定规则，只需划定界限。 呃，"}]
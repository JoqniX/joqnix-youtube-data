[{"type": "subtitle", "time": 3375.349, "timestamp": "00:56:15", "text": "是的，播放列表就是在这里生成的，"}, {"type": "subtitle", "time": 3377.51, "timestamp": "00:56:17", "text": "对吧？ 所以"}, {"type": "subtitle", "time": 3379.91, "timestamp": "00:56:19", "text": "主要连接点是 OBS。 我没用"}, {"type": "subtitle", "time": 3384.63, "timestamp": "00:56:24", "text": "OBS，所以屏幕是空白的。 否则，如果 Melt"}, {"type": "subtitle", "time": 3387.589, "timestamp": "00:56:27", "text": "连接正常，则随机"}, {"type": "subtitle", "time": 3390.39, "timestamp": "00:56:30", "text": "视频编号将为零。"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "那我们就不用了。是的，那不常用。 哦，是的，"}, {"type": "subtitle", "time": 3397.589, "timestamp": "00:56:37", "text": "从这里开始，"}, {"type": "subtitle", "time": 3403.99, "timestamp": "00:56:43", "text": "它会随机化播放列表的位置，"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "并记录所有"}, {"type": "subtitle", "time": 3408.47, "timestamp": "00:56:48", "text": "30 个"}, {"type": "subtitle", "time": 3410.23, "timestamp": "00:56:50", "text": "变量"}, {"type": "subtitle", "time": 3413.03, "timestamp": "00:56:53", "text": "。 然后就是持续时间的"}, {"type": "subtitle", "time": 3416.069, "timestamp": "00:56:56", "text": "问题了。   是的"}]
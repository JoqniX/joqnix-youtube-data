[{"type": "subtitle", "time": 5822.07, "timestamp": "01:37:02", "text": "不知道你是违反了规则，还是只是让"}, {"type": "subtitle", "time": 5824.629, "timestamp": "01:37:04", "text": "自己感到不舒服，让"}, {"type": "subtitle", "time": 5826.31, "timestamp": "01:37:06", "text": "别人也感到不舒服。 我可能得暂停"}, {"type": "subtitle", "time": 5835.03, "timestamp": "01:37:15", "text": "我之所以写“基督徒”，是因为我是"}, {"type": "subtitle", "time": 5838.229, "timestamp": "01:37:18", "text": "基督徒，而且，"}, {"type": "subtitle", "time": 5844.07, "timestamp": "01:37:24", "text": "我希望我的内容能被"}, {"type": "subtitle", "time": 5846.55, "timestamp": "01:37:26", "text": "所有年龄段的人接受。 所以这就是我不说脏话的原因"}, {"type": "subtitle", "time": 5849.59, "timestamp": "01:37:29", "text": "。 就是这样。 没"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "必要想得太"}, {"type": "subtitle", "time": 5854.07, "timestamp": "01:37:34", "text": "深入。   就是这样。"}, {"type": "subtitle", "time": 5856.47, "timestamp": "01:37:36", "text": "不必想太多。   是的"}, {"type": "subtitle", "time": 5864.47, "timestamp": "01:37:44", "text": "。 嗯，不过随"}, {"type": "subtitle", "time": 5867.27, "timestamp": "01:37:47", "text": "你便。"}, {"type": "subtitle", "time": 5870.229, "timestamp": "01:37:50", "text": "等等，我不是没发推文吗？ 我确实发了推文。"}, {"type": "subtitle", "time": 5879.669, "timestamp": "01:37:59", "text": "我也是，反正我也不知道。"}]
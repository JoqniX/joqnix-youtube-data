[{"type": "subtitle", "time": 9733.429, "timestamp": "02:42:13", "text": "好的，就是这样。 我们来"}, {"type": "subtitle", "time": 9736.55, "timestamp": "02:42:16", "text": "了解一下这个人。"}, {"type": "subtitle", "time": 9741.83, "timestamp": "02:42:21", "text": "我会留着它。 是的。 呃，"}, {"type": "subtitle", "time": 9743.91, "timestamp": "02:42:23", "text": "这是离线版本，对吧？ 我"}, {"type": "subtitle", "time": 9745.99, "timestamp": "02:42:25", "text": "认为离线版现在应该已经很完美了"}, {"type": "subtitle", "time": 9757.75, "timestamp": "02:42:37", "text": "哦不，是这个。哦，不是这个。 糟糕。"}, {"type": "subtitle", "time": 9769.67, "timestamp": "02:42:49", "text": "为什么会有两个“是”？ 哦，等等，等等。"}, {"type": "subtitle", "time": 9771.91, "timestamp": "02:42:51", "text": "我只是改了个名字。 我的天哪，你这个笨蛋"}, {"type": "subtitle", "time": 9779.67, "timestamp": "02:42:59", "text": "所以，这应该会产生"}]
[{"type": "subtitle", "time": 7921.51, "timestamp": "02:12:01", "text": "嗯，我看到过一些在我服务器里、"}, {"type": "subtitle", "time": 7925.83, "timestamp": "02:12:05", "text": "或者在电脑上和我"}, {"type": "subtitle", "time": 7929.51, "timestamp": "02:12:09", "text": "聊天的人，在其他地方被封禁了。"}, {"type": "subtitle", "time": 7932.87, "timestamp": "02:12:12", "text": "嗯……我不知道，每个人对此都有自己的"}, {"type": "subtitle", "time": 7935.35, "timestamp": "02:12:15", "text": "看法。 呃，可能觉得"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "大家还没看过我那两个小时的"}, {"type": "subtitle", "time": 7943.589, "timestamp": "02:12:23", "text": "视频，但事情就是这样，所以"}, {"type": "subtitle", "time": 7946.069, "timestamp": "02:12:26", "text": "不想"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "看，这就是为什么大家最需要看到我们……"}, {"type": "subtitle", "time": 7962.629, "timestamp": "02:12:42", "text": "我不知道，我……"}, {"type": "subtitle", "time": 7966.191, "timestamp": "02:12:46", "text": "我不知道。 我喜欢"}, {"type": "subtitle", "time": 7967.75, "timestamp": "02:12:47", "text": "（笑）"}, {"type": "subtitle", "time": 7970.709, "timestamp": "02:12:50", "text": "直到今天我仍然在为人们设计服装这件事。 这也令人"}, {"type": "subtitle", "time": 7977.83, "timestamp": "02:12:57", "text": "嗯，即使我……不管发生了什么，呃，那件事还有"}]
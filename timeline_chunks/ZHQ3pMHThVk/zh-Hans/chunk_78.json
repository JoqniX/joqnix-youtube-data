[{"type": "subtitle", "time": 4681.669, "timestamp": "01:18:01", "text": "复制。"}, {"type": "subtitle", "time": 4684.79, "timestamp": "01:18:04", "text": "现在，让我们看看如果我不改变它会发生什么"}, {"type": "subtitle", "time": 4687.35, "timestamp": "01:18:07", "text": "。 这正是我感兴趣的地方"}, {"type": "subtitle", "time": 4691.669, "timestamp": "01:18:11", "text": "。 我把它放在这里。 我们会保留这些"}, {"type": "subtitle", "time": 4693.91, "timestamp": "01:18:13", "text": "链接。 我不保存了，因为它"}, {"type": "subtitle", "time": 4699.91, "timestamp": "01:18:19", "text": "现在就会崩溃。 好吧，"}, {"type": "subtitle", "time": 4709.669, "timestamp": "01:18:29", "text": "得仔细想想。"}, {"type": "subtitle", "time": 4711.75, "timestamp": "01:18:31", "text": "圣。"}, {"type": "subtitle", "time": 4715.99, "timestamp": "01:18:35", "text": "好的。 当我直播的时候。"}, {"type": "subtitle", "time": 4719.03, "timestamp": "01:18:39", "text": "好的。 根据直播类别获取播放列表"}, {"type": "subtitle", "time": 4721.99, "timestamp": "01:18:41", "text": "。 搞定了。 等待超时"}, {"type": "subtitle", "time": 4726.709, "timestamp": "01:18:46", "text": "。 好的。 呃，好的。 这个。 所以，我们就直接"}, {"type": "subtitle", "time": 4730.55, "timestamp": "01:18:50", "text": "复制，"}, {"type": "subtitle", "time": 4734.07, "timestamp": "01:18:54", "text": "我直接把整个内容复制过来。"}, {"type": "subtitle", "time": 4737.189, "timestamp": "01:18:57", "text": "为什么不呢？"}]
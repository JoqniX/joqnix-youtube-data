[{"type": "subtitle", "time": 6901.51, "timestamp": "01:55:01", "text": "以及所有YouTube博主都产生了误解，他们都"}, {"type": "subtitle", "time": 6904.07, "timestamp": "01:55:04", "text": "相信那份文件，结果却与"}, {"type": "subtitle", "time": 6906.07, "timestamp": "01:55:06", "text": "我作对。"}, {"type": "subtitle", "time": 6909.27, "timestamp": "01:55:09", "text": "没人听我解释。 那就像我的"}, {"type": "subtitle", "time": 6911.109, "timestamp": "01:55:11", "text": "第一次，"}, {"type": "subtitle", "time": 6914.229, "timestamp": "01:55:14", "text": "嗯，我不知道该怎么做。 我之所以花这么"}, {"type": "subtitle", "time": 6916.87, "timestamp": "01:55:16", "text": "长时间，是因为我在"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "现实生活中受到了骚扰。 我被人肉搜索了。"}, {"type": "subtitle", "time": 6923.35, "timestamp": "01:55:23", "text": "我被人肉搜索了。 我的手机号码"}, {"type": "subtitle", "time": 6926.694, "timestamp": "01:55:26", "text": "泄露了。 我的地址泄露了。"}, {"type": "subtitle", "time": 6927.35, "timestamp": "01:55:27", "text": "[叹气和倒吸一口气]"}, {"type": "subtitle", "time": 6929.91, "timestamp": "01:55:29", "text": "呃，我的家人知道了这件事。"}, {"type": "subtitle", "time": 6933.51, "timestamp": "01:55:33", "text": "不知何故，我父母的一些信息也"}, {"type": "subtitle", "time": 6936.87, "timestamp": "01:55:36", "text": "落入了某些人手中。"}, {"type": "subtitle", "time": 6945.669, "timestamp": "01:55:45", "text": "发生那些事之后，我不得不寻求法律帮助。 然后"}, {"type": "subtitle", "time": 6948.31, "timestamp": "01:55:48", "text": "我发送了我的谷歌文档、我的声明"}, {"type": "subtitle", "time": 6950.31, "timestamp": "01:55:50", "text": "和法律通知。 但有些人"}, {"type": "subtitle", "time": 6953.109, "timestamp": "01:55:53", "text": "感到困惑。 所以我制作了一个两小时"}, {"type": "subtitle", "time": 6956.55, "timestamp": "01:55:56", "text": "长的视频来解释整件事，"}, {"type": "subtitle", "time": 6959.189, "timestamp": "01:55:59", "text": "现在每个人都知道发生了什么，"}]
[{"type": "subtitle", "time": 301.99, "timestamp": "00:05:01", "text": "我还需要调整一下缩放级别"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "，对吧？"}, {"type": "subtitle", "time": 307.27, "timestamp": "00:05:07", "text": "好的。 你好。 所以，今天我们要做一些关于"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "萨米的事情。 我们将对基于播放"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "列表的 V 循环进行改进，迭代至"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "4.1 版本。"}, {"type": "subtitle", "time": 320.95, "timestamp": "00:05:20", "text": "我称之为 4.1。 所以，"}, {"type": "subtitle", "time": 325.909, "timestamp": "00:05:25", "text": "目前的情况是，如果"}, {"type": "subtitle", "time": 329.83, "timestamp": "00:05:29", "text": "我"}, {"type": "subtitle", "time": 332.629, "timestamp": "00:05:32", "text": "在 Twitch 上直播并检查类别，"}, {"type": "subtitle", "time": 336.55, "timestamp": "00:05:36", "text": "它会将该"}, {"type": "subtitle", "time": 339.35, "timestamp": "00:05:39", "text": "类别与"}, {"type": "subtitle", "time": 342.39, "timestamp": "00:05:42", "text": "我手动添加的 YouTube 播放列表进行交叉检查。是的，它会"}, {"type": "subtitle", "time": 346.23, "timestamp": "00:05:46", "text": "检查这些，然后列出"}, {"type": "subtitle", "time": 349.43, "timestamp": "00:05:49", "text": "播放列表中的所有视频。 然后"}, {"type": "subtitle", "time": 353.43, "timestamp": "00:05:53", "text": "它会创建一个播放列表，嗯，"}, {"type": "subtitle", "time": 356.07, "timestamp": "00:05:56", "text": "它会创建一个播放列表并进行 V"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "设置。 正确的。 但是，根据目前的"}]
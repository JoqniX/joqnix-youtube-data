[{"type": "subtitle", "time": 6723.51, "timestamp": "01:52:03", "text": "因为在那件事发生时，我的社区里的大多数人都"}, {"type": "subtitle", "time": 6726.55, "timestamp": "01:52:06", "text": "反对我。"}, {"type": "subtitle", "time": 6732.55, "timestamp": "01:52:12", "text": "所以我现在需要寻找"}, {"type": "subtitle", "time": 6735.189, "timestamp": "01:52:15", "text": "更好的模式来建立长期的信任。 我"}, {"type": "subtitle", "time": 6739.27, "timestamp": "01:52:19", "text": "现在需要信任我的社区，"}, {"type": "subtitle", "time": 6741.83, "timestamp": "01:52:21", "text": "但我做不到。 是的。 等等，发生了什么事？"}, {"type": "subtitle", "time": 6743.51, "timestamp": "01:52:23", "text": "哦，昨天我跟你讨论那些事的时候你不在场"}, {"type": "subtitle", "time": 6748.07, "timestamp": "01:52:28", "text": "。"}, {"type": "subtitle", "time": 6750.07, "timestamp": "01:52:30", "text": "我的意思是，它就在我的 YouTube 频道里。 是那段"}, {"type": "subtitle", "time": 6752.229, "timestamp": "01:52:32", "text": "黑色的视频。 如果你愿意的话，"}, {"type": "subtitle", "time": 6755.589, "timestamp": "01:52:35", "text": "可以看看。 这就解释了为什么"}, {"type": "subtitle", "time": 6758.79, "timestamp": "01:52:38", "text": "视频长达2小时。 它解释了"}, {"type": "subtitle", "time": 6761.83, "timestamp": "01:52:41", "text": "发生了什么事，以及我"}, {"type": "subtitle", "time": 6764.149, "timestamp": "01:52:44", "text": "回归直播、继续前进等等"}, {"type": "subtitle", "time": 6765.669, "timestamp": "01:52:45", "text": "一切。   是的"}, {"type": "subtitle", "time": 6768.55, "timestamp": "01:52:48", "text": "。"}, {"type": "subtitle", "time": 6777.03, "timestamp": "01:52:57", "text": "这里也谈到了基督教。 我"}, {"type": "subtitle", "time": 6779.27, "timestamp": "01:52:59", "text": "觉得我也一样，就我"}]
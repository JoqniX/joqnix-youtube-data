[{"type": "subtitle", "time": 543.03, "timestamp": "00:09:03", "text": "嗯，這是"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "我想要添加的第二個功能。"}, {"type": "subtitle", "time": 548.389, "timestamp": "00:09:08", "text": "目前它在一個分類裡，"}, {"type": "subtitle", "time": 551.03, "timestamp": "00:09:11", "text": "但現在我想為"}, {"type": "subtitle", "time": 554.63, "timestamp": "00:09:14", "text": "版本一的"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "設定添加一個隨機播放功能。我想在離線狀態下，也就是"}, {"type": "subtitle", "time": 559.75, "timestamp": "00:09:19", "text": "我不直播的時候，而不是檢查"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "我的 Twitch 內容，我想檢查"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "當我不直播的時候，是否隨機"}, {"type": "subtitle", "time": 567.35, "timestamp": "00:09:27", "text": "播放"}, {"type": "subtitle", "time": 571.67, "timestamp": "00:09:31", "text": "我頻道裡的所有 900 個影片。"}, {"type": "subtitle", "time": 575.11, "timestamp": "00:09:35", "text": "這樣，每個從這裡觀看的人，"}, {"type": "subtitle", "time": 577.509, "timestamp": "00:09:37", "text": "當他們刷新頁面時，都會"}, {"type": "subtitle", "time": 579.509, "timestamp": "00:09:39", "text": "看到一組全新的內容，"}, {"type": "subtitle", "time": 583.35, "timestamp": "00:09:43", "text": "對吧？這讓我無需像以前"}, {"type": "subtitle", "time": 586.55, "timestamp": "00:09:46", "text": "在 short.io 中那樣產生自訂連結"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "。"}, {"type": "subtitle", "time": 591.99, "timestamp": "00:09:51", "text": "嗯，是的，我以前有過。所以"}, {"type": "subtitle", "time": 594.15, "timestamp": "00:09:54", "text": "我不需要那樣做。我可以把"}, {"type": "subtitle", "time": 598.389, "timestamp": "00:09:58", "text": "你們喜歡的這個"}]
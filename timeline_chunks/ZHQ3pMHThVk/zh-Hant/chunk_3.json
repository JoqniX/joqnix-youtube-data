[{"type": "subtitle", "time": 181.99, "timestamp": "00:03:01", "text": "所以今天我想直播DNA或"}, {"type": "subtitle", "time": 183.67, "timestamp": "00:03:03", "text": "戰地："}, {"type": "subtitle", "time": 189.50900000000001, "timestamp": "00:03:09", "text": "紅色警戒，但沒能直播，然後我"}, {"type": "subtitle", "time": 192.55, "timestamp": "00:03:12", "text": "今天突然靈光一閃，心想：「哦，"}, {"type": "subtitle", "time": 194.71, "timestamp": "00:03:14", "text": "對，我可以這麼做。我想"}, {"type": "subtitle", "time": 199.589, "timestamp": "00:03:19", "text": "這麼做。」呃，我又開始做 Sammy 的"}, {"type": "subtitle", "time": 202.39, "timestamp": "00:03:22", "text": "東西了。"}, {"type": "subtitle", "time": 205.67000000000002, "timestamp": "00:03:25", "text": "嗯，我會想辦法的。我已經"}, {"type": "subtitle", "time": 208.71, "timestamp": "00:03:28", "text": "完成了一半左右。所以，不用擔心。我已經"}, {"type": "subtitle", "time": 212.47, "timestamp": "00:03:32", "text": "完成近一半了。我"}, {"type": "subtitle", "time": 216.22899999999998, "timestamp": "00:03:36", "text": "從上午 11 點就開始工作了，而我原本應該"}, {"type": "subtitle", "time": 220.55, "timestamp": "00:03:40", "text": "在那個時間直播。我正在努力"}, {"type": "subtitle", "time": 224.39, "timestamp": "00:03:44", "text": "修復它。"}, {"type": "subtitle", "time": 227.19, "timestamp": "00:03:47", "text": "所以，是的"}, {"type": "subtitle", "time": 231.35, "timestamp": "00:03:51", "text": "，我基本上完成了任務。"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "呃，"}, {"type": "subtitle", "time": 238.47, "timestamp": "00:03:58", "text": "但我還得補充一些類似的東西"}]
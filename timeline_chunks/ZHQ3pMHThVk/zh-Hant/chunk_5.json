[{"type": "subtitle", "time": 301.99, "timestamp": "00:05:01", "text": "我還需要調整一下縮放級別"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "，對吧？  好的。"}, {"type": "subtitle", "time": 307.27, "timestamp": "00:05:07", "text": "你好。所以，今天我們要做一些關於"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "薩米的事情。我們將對"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "基於播放清單的 V 循環進行改進，"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "迭代至 4.1 版本。"}, {"type": "subtitle", "time": 320.95, "timestamp": "00:05:20", "text": "我稱之為 4.1。所以，目前的情況是，如果我"}, {"type": "subtitle", "time": 332.629, "timestamp": "00:05:32", "text": "在 Twitch 上直播並檢查類別，"}, {"type": "subtitle", "time": 336.55, "timestamp": "00:05:36", "text": "它會將該"}, {"type": "subtitle", "time": 339.35, "timestamp": "00:05:39", "text": "類別與我手動新增的 YouTube 播放清單進行交叉檢查。"}, {"type": "subtitle", "time": 342.39, "timestamp": "00:05:42", "text": "是的，它會"}, {"type": "subtitle", "time": 346.23, "timestamp": "00:05:46", "text": "檢查這些，然後列出"}, {"type": "subtitle", "time": 349.43, "timestamp": "00:05:49", "text": "播放清單中的所有影片。然後它會創建"}, {"type": "subtitle", "time": 353.43, "timestamp": "00:05:53", "text": "一個播放列表，嗯，它會創建"}, {"type": "subtitle", "time": 356.07, "timestamp": "00:05:56", "text": "一個播放列表並進行 V"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "設定。正確的。但是，根據目前的"}]
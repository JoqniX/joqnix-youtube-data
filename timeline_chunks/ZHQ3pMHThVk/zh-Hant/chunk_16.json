[{"type": "subtitle", "time": 960.389, "timestamp": "00:16:00", "text": "當我在直播時，它會檢查我在 Twitch 上的類別，"}, {"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "因為 Twitch 現在的 API 呼叫速度更快。"}, {"type": "subtitle", "time": 965.11, "timestamp": "00:16:05", "text": "所以它會檢查我的類別。"}, {"type": "subtitle", "time": 967.35, "timestamp": "00:16:07", "text": "目前我屬於共享辦公室和"}, {"type": "subtitle", "time": 969.99, "timestamp": "00:16:09", "text": "學習類別。所以我做了區分，"}, {"type": "subtitle", "time": 973.35, "timestamp": "00:16:13", "text": "如果我的"}, {"type": "subtitle", "time": 976.79, "timestamp": "00:16:16", "text": "標題中有“與我合作”或“核心工作”，"}, {"type": "subtitle", "time": 979.11, "timestamp": "00:16:19", "text": "那就意味著它是"}, {"type": "subtitle", "time": 990.47, "timestamp": "00:16:30", "text": "合作的，它是"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "合作工作流程。它會檢查我的 YouTube 播放列表，就像我"}, {"type": "subtitle", "time": 1001.269, "timestamp": "00:16:41", "text": "頻道裡的所有播放清單一樣。如果能找到的話，就下載共享辦公歌單。是的，我會把共享辦公歌單加到歌單裡。這個包含 11 個視頻，包括今天的直播，它會填充所有"}, {"type": "subtitle", "time": 1007.189, "timestamp": "00:16:47", "text": "11 個視頻，然後從這 11 個視頻中隨機抽取一個，"}, {"type": "subtitle", "time": 1009.829, "timestamp": "00:16:49", "text": "如此循環往復，直到變成 30 個視頻。"}]
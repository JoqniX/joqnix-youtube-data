[{"type": "subtitle", "time": 7022.07, "timestamp": "01:57:02", "text": "是的，真的。那次谷歌事件讓我對所有我信任的人、所有"}, {"type": "subtitle", "time": 7027.27, "timestamp": "01:57:07", "text": "我的"}, {"type": "subtitle", "time": 7029.189, "timestamp": "01:57:09", "text": "朋友、所有我認識的創作者，"}, {"type": "subtitle", "time": 7032.79, "timestamp": "01:57:12", "text": "以及所有"}, {"type": "subtitle", "time": 7034.55, "timestamp": "01:57:14", "text": "YouTube部落客都產生了誤解，他們都相信那份文件，結果卻與我作對。  沒人聽我解釋。那就像我的第一次，"}, {"type": "subtitle", "time": 7044.55, "timestamp": "01:57:24", "text": "嗯，我不知道該怎麼做。"}, {"type": "subtitle", "time": 7058.629, "timestamp": "01:57:38", "text": "我之所以花這麼長時間，是因為"}, {"type": "subtitle", "time": 7063.43, "timestamp": "01:57:43", "text": "我在現實生活中受到了騷擾。我被人肉搜尋了。  我被人肉搜尋了。我的手機號碼洩漏了。我的地址洩漏了。"}, {"type": "subtitle", "time": 7079.51, "timestamp": "01:57:59", "text": "[嘆氣和倒吸一口氣] 呃，我的家人知道了這件事。  不知"}]
[{"type": "subtitle", "time": 1625.59, "timestamp": "00:27:05", "text": "令牌。那是h，但它仍然有效。我稍後會做。這是下週或第三週的共享辦公室直播。我們稍後會"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "處理這個問題。但是，今天我只專注於這件事。我只剩下"}, {"type": "subtitle", "time": 1631.43, "timestamp": "00:27:11", "text": "兩個小時了。 3點30分，對吧？ 3:30 至"}, {"type": "subtitle", "time": 1634.63, "timestamp": "00:27:14", "text": "4:30 4:30 5:30。是的，我還剩2個小時。"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "我得速通一下，因為我"}, {"type": "subtitle", "time": 1640.128, "timestamp": "00:27:20", "text": "今天有課。"}, {"type": "subtitle", "time": 1674.95, "timestamp": "00:27:54", "text": "Notion 標題。好的。"}]
[{"type": "subtitle", "time": 17238.708, "timestamp": "04:47:18", "text": "このゲームでは、さまざまな動物に乗れるようにしてほしいと思う。 もし私たちが"}, {"type": "subtitle", "time": 17242.93, "timestamp": "04:47:22", "text": "ホッキョクグマに乗れるとしたら。 うん。"}, {"type": "subtitle", "time": 17245.91, "timestamp": "04:47:25", "text": "【音楽】"}, {"type": "subtitle", "time": 17252.07, "timestamp": "04:47:32", "text": "冒険家。 今、このゲームは何もかもがおかしい"}, {"type": "subtitle", "time": 17254.07, "timestamp": "04:47:34", "text": "。 はい。 そう、彼らはひたすら"}, {"type": "subtitle", "time": 17257.43, "timestamp": "04:47:37", "text": "カットシーンを連発しているだけだ。"}, {"type": "subtitle", "time": 17264.67, "timestamp": "04:47:44", "text": "。 君の"}, {"type": "subtitle", "time": 17267.56, "timestamp": "04:47:47", "text": "船を叩き壊す羽目になったよ。 それで、"}, {"type": "subtitle", "time": 17270.51, "timestamp": "04:47:50", "text": "音楽と"}, {"type": "subtitle", "time": 17274.34, "timestamp": "04:47:54", "text": "食べ物について。 私はどこに行けばいいのですか？"}, {"type": "subtitle", "time": 17276.31, "timestamp": "04:47:56", "text": "【音楽】"}, {"type": "subtitle", "time": 17279.91, "timestamp": "04:47:59", "text": "あなたもそうしている。"}]
[{"type": "subtitle", "time": 19095.628, "timestamp": "05:18:15", "text": "では、"}, {"type": "subtitle", "time": 19099.43, "timestamp": "05:18:19", "text": "何を作らなければならないのでしょうか？ キャンプファイヤーを作ろう。 いや、"}, {"type": "subtitle", "time": 19116.55, "timestamp": "05:18:36", "text": "ああ、それは続く。 ああ、くそ。 くそっ。 くそっ。 くそっ。"}, {"type": "subtitle", "time": 19118.628, "timestamp": "05:18:38", "text": "くそっ。 くそっ。 くそっ。 くそっ。 戻る。 戻る。 どうすれば戻れますか"}, {"type": "subtitle", "time": 19122.31, "timestamp": "05:18:42", "text": "？  S. 調子はどうですか？"}, {"type": "subtitle", "time": 19128.788, "timestamp": "05:18:48", "text": "、戻ります。 はい。 戻ってきました。"}, {"type": "subtitle", "time": 19131.19, "timestamp": "05:18:51", "text": "近日公開。"}, {"type": "subtitle", "time": 19133.75, "timestamp": "05:18:53", "text": "ああ、できるよ。 彼らはすでにあなたに"}, {"type": "subtitle", "time": 19136.19, "timestamp": "05:18:56", "text": "シェルターの"}]
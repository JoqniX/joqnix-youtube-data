[{"type": "subtitle", "time": 423.589, "timestamp": "00:07:03", "text": "ここには5、6人の弁護士がいると思います。 反対側の裏側と"}, {"type": "subtitle", "time": 426.629, "timestamp": "00:07:06", "text": "正面のオフィススペースは、"}, {"type": "subtitle", "time": 428.39, "timestamp": "00:07:08", "text": "ブティックか何かに使われる予定です。 彼らは"}, {"type": "subtitle", "time": 431.11, "timestamp": "00:07:11", "text": "来週あたりに来るだろう。 ええ、それで、"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "彼らのために、私たちは、"}, {"type": "subtitle", "time": 440.15, "timestamp": "00:07:20", "text": "階下の"}, {"type": "subtitle", "time": 443.029, "timestamp": "00:07:23", "text": "家族用に、それぞれに3相接続を2つ別々に作りました。 私の家族はそれがまだ一"}, {"type": "subtitle", "time": 444.67, "timestamp": "00:07:24", "text": "段階だったため、"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "三段階に変更する必要がありました。 えっと、DVN関連の作業は"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "最近完了しました。 だから今、父は"}, {"type": "subtitle", "time": 455.43, "timestamp": "00:07:35", "text": "電気関係のオフィスでの"}, {"type": "subtitle", "time": 457.27, "timestamp": "00:07:37", "text": "交渉とかをやらなきゃいけないんだ。 警官に"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "来てもらって、配電盤や"}, {"type": "subtitle", "time": 461.43, "timestamp": "00:07:41", "text": "電気設備、"}, {"type": "subtitle", "time": 463.749, "timestamp": "00:07:43", "text": "メーターなど全てを点検してもらいましょう。 それからその人に料金を払い、"}, {"type": "subtitle", "time": 466.87, "timestamp": "00:07:46", "text": "三相メーターか"}, {"type": "subtitle", "time": 470.30899999999997, "timestamp": "00:07:50", "text": "何か接続用の部品をもらってください。 うん。 そうすれば"}, {"type": "subtitle", "time": 472.87, "timestamp": "00:07:52", "text": "電気代も"}, {"type": "subtitle", "time": 475.43, "timestamp": "00:07:55", "text": "安くなるような気がする。 それで、電気技師の"}, {"type": "subtitle", "time": 477.99, "timestamp": "00:07:57", "text": "人たちが、古い家なので、すべての部屋の配線の隅々までチェックしました"}]
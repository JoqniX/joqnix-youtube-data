[{"type": "subtitle", "time": 17463.99, "timestamp": "04:51:03", "text": "船を見失え。 私は"}, {"type": "subtitle", "time": 17466.31, "timestamp": "04:51:06", "text": "自分の船を失う寸前の段階に達したと思う。"}, {"type": "subtitle", "time": 17469.51, "timestamp": "04:51:09", "text": "いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 17474.15, "timestamp": "04:51:14", "text": "私がいる場所は、乾燥した地域のような別の場所です"}, {"type": "subtitle", "time": 17476.67, "timestamp": "04:51:16", "text": "。 ああ、わかった。"}, {"type": "subtitle", "time": 17479.67, "timestamp": "04:51:19", "text": "深淵の水域にたどり着きましたか？"}, {"type": "subtitle", "time": 17482.31, "timestamp": "04:51:22", "text": "いや、いや、いや。 待って、誰かが"}, {"type": "subtitle", "time": 17485.31, "timestamp": "04:51:25", "text": "私の近くにいる。 わかった。 えっと、"}, {"type": "subtitle", "time": 17489.27, "timestamp": "04:51:29", "text": "船に乗って、航海とかしたんですか？ 今すぐ発送してください"}, {"type": "subtitle", "time": 17491.91, "timestamp": "04:51:31", "text": "。 うん。 うん。"}, {"type": "subtitle", "time": 17493.75, "timestamp": "04:51:33", "text": "船をその島に停泊させてみてください。   どうなるか"}, {"type": "subtitle", "time": 17496.948, "timestamp": "04:51:36", "text": "見てみましょう。   減点しなかった"}, {"type": "subtitle", "time": 17503.83, "timestamp": "04:51:43", "text": "。 岩礁にぶつかる。 そのサンゴ礁は何ですか？ 帆"}, {"type": "subtitle", "time": 17514.708, "timestamp": "04:51:54", "text": "私は今から泳がなければならない。"}, {"type": "subtitle", "time": 17516.628, "timestamp": "04:51:56", "text": "それで、あなたに何があったのですか？ えっと、"}, {"type": "subtitle", "time": 17519.67, "timestamp": "04:51:59", "text": "まるで消えちゃったみたい？ えっと、船を後退させることができなかったんです"}]
[{"type": "subtitle", "time": 14829.15, "timestamp": "04:07:09", "text": "選択肢がないのですか？ 皆さんはどう思いますか？ 提案が"}, {"type": "subtitle", "time": 14838.27, "timestamp": "04:07:18", "text": "制作に反映させるべきでしょう。"}, {"type": "subtitle", "time": 14851.57, "timestamp": "04:07:31", "text": "オーケー、それが"}, {"type": "subtitle", "time": 14856.03, "timestamp": "04:07:36", "text": "[音楽]"}, {"type": "subtitle", "time": 14859.07, "timestamp": "04:07:39", "text": "そのサイン"}, {"type": "subtitle", "time": 14867.59, "timestamp": "04:07:47", "text": "忘れてた。 行く。 さあ行こう。"}, {"type": "subtitle", "time": 14873.59, "timestamp": "04:07:53", "text": "【音楽】"}]
[{"type": "subtitle", "time": 18848.23, "timestamp": "05:14:08", "text": "棒切れをあげてもいいですよ。 私のスティックはどこだ？ え、"}, {"type": "subtitle", "time": 18850.43, "timestamp": "05:14:10", "text": "何"}, {"type": "subtitle", "time": 18854.948, "timestamp": "05:14:14", "text": "だって？ 成長する。 さぁ行こう。 ちょっと待って、"}, {"type": "subtitle", "time": 18867.03, "timestamp": "05:14:27", "text": "ああを除いて。 そうそう"}, {"type": "subtitle", "time": 18870.69, "timestamp": "05:14:30", "text": "。 私のバナナを持って行ってください。 私の香辛料を受け取ってください。"}, {"type": "subtitle", "time": 18878.15, "timestamp": "05:14:38", "text": "くそ、これは本当に良い。"}, {"type": "subtitle", "time": 18880.23, "timestamp": "05:14:40", "text": "それはかなり良いですね。 だからこそ、"}, {"type": "subtitle", "time": 18882.55, "timestamp": "05:14:42", "text": "市長とかそういう人がいるんだと思う。"}, {"type": "subtitle", "time": 18887.59, "timestamp": "05:14:47", "text": "ここでコミュニティを作ることができるからね。"}, {"type": "subtitle", "time": 18893.91, "timestamp": "05:14:53", "text": "[音楽] クソみたいな"}]
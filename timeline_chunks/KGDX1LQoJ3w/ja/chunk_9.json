[{"type": "subtitle", "time": 542.79, "timestamp": "00:09:02", "text": "絶対に。 えっと、私のは900を使っています。 え、"}, {"type": "subtitle", "time": 544.03, "timestamp": "00:09:04", "text": "それだけ"}, {"type": "subtitle", "time": 546.91, "timestamp": "00:09:06", "text": "？"}, {"type": "subtitle", "time": 549.509, "timestamp": "00:09:09", "text": "何？ 待って。 エアコン、洗濯"}, {"type": "subtitle", "time": 552.75, "timestamp": "00:09:12", "text": "機、オーブンなど、設備は揃っているんですね。"}, {"type": "subtitle", "time": 555.43, "timestamp": "00:09:15", "text": "ああ、そうそう、一人暮らしなんですね。 うん。 だから、"}, {"type": "chat", "time": 557.95, "timestamp": "00:09:17", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "yep"}, {"type": "subtitle", "time": 558.23, "timestamp": "00:09:18", "text": "電気の使用量はそれほど多くない。"}, {"type": "subtitle", "time": 561.43, "timestamp": "00:09:21", "text": "一人用のみ。 ファンエアコンとかそういうのは一切なし"}, {"type": "chat", "time": 574.004, "timestamp": "00:09:34", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "the refrigerator is the only thing that's running 24/7"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "ハダシュ。 一人暮らしってどんな感じ？"}, {"type": "subtitle", "time": 590.31, "timestamp": "00:09:50", "text": "日本ではおそらく一人暮らしか、ルームメイトと暮らすことになると思うので。 だから、私はそれが"}]
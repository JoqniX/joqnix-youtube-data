[{"type": "subtitle", "time": 11368.15, "timestamp": "03:09:28", "text": "。 ありがとう。   行くよ"}, {"type": "subtitle", "time": 11374.71, "timestamp": "03:09:34", "text": "。 何てことだ。 私は"}, {"type": "subtitle", "time": 11380.349, "timestamp": "03:09:40", "text": "今日、素晴らしいことを成し遂げました。 私は今日、素晴らしいことを成し遂げました"}, {"type": "subtitle", "time": 11383.15, "timestamp": "03:09:43", "text": "。 ああ"}, {"type": "subtitle", "time": 11384.99, "timestamp": "03:09:44", "text": "、本当にありがとうございます"}, {"type": "subtitle", "time": 11388.23, "timestamp": "03:09:48", "text": "。 私は実際に話したり、コミュニケーションをとったりしました。"}, {"type": "subtitle", "time": 11391.429, "timestamp": "03:09:51", "text": "私は自己対話を行った。 私は、"}]
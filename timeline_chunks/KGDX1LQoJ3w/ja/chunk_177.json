[{"type": "subtitle", "time": 10626.95, "timestamp": "02:57:06", "text": "。 私はできません。 私はできません。 わかった。 だから、僕は"}, {"type": "subtitle", "time": 10631.75, "timestamp": "02:57:11", "text": "野球選手になりたいんです。 みんな"}, {"type": "subtitle", "time": 10636.269, "timestamp": "02:57:16", "text": "屋外のゲイスポーツを選んでいる。"}, {"type": "subtitle", "time": 10640.55, "timestamp": "02:57:20", "text": "中学生。 私はよくアニメを見ていました"}, {"type": "subtitle", "time": 10647.67, "timestamp": "02:57:27", "text": "。"}, {"type": "subtitle", "time": 10651.79, "timestamp": "02:57:31", "text": "主人公の"}, {"type": "subtitle", "time": 10655.83, "timestamp": "02:57:35", "text": "達也は高校生で、彼はあるグループの"}, {"type": "subtitle", "time": 10660.389, "timestamp": "02:57:40", "text": "メンバーです。目の前の障害を乗り越えれば、どんなことにも"}, {"type": "subtitle", "time": 10665.91, "timestamp": "02:57:45", "text": "自信を持って立ち向かえる。   だから、私はそれをやるつもりだ"}, {"type": "subtitle", "time": 10668.389, "timestamp": "02:57:48", "text": "。 君たちは"}, {"type": "subtitle", "time": 10671.99, "timestamp": "02:57:51", "text": "僕がそれをやるのを見てくれるんだね。 私は全力で取り組みます。 私がやります"}, {"type": "subtitle", "time": 10675.51, "timestamp": "02:57:55", "text": "。 大丈夫、任せて。 そして最終的に"}]
[{"type": "subtitle", "time": 13201.19, "timestamp": "03:40:01", "text": "気まずい。「何を話せばいいの？」って感じ。"}, {"type": "subtitle", "time": 13231.429, "timestamp": "03:40:31", "text": "聞きたいんだけど、待って、"}, {"type": "subtitle", "time": 13238.95, "timestamp": "03:40:38", "text": "アメリカという国。 ヨシさんに、"}, {"type": "subtitle", "time": 13244.87, "timestamp": "03:40:44", "text": "イベントをライブ配信してもいいか聞いてみたいです。 でも、"}, {"type": "subtitle", "time": 13248.55, "timestamp": "03:40:48", "text": "彼女が去る前とかそういうことじゃないんだよ"}, {"type": "subtitle", "time": 13251.429, "timestamp": "03:40:51", "text": "。 午前11時か午後11時くらいかな。"}, {"type": "subtitle", "time": 13256.229, "timestamp": "03:40:56", "text": "日本で。 いいえ、11 10 は日本の 10 時 30 分と同じ意味ですよね"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "？ うん。 それから、"}]
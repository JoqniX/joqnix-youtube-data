[{"type": "subtitle", "time": 13930.469, "timestamp": "03:52:10", "text": "チャットで遊んでるなんて変だよ。うん、日本語で話そうとしてるんだ。"}, {"type": "subtitle", "time": 13937.189, "timestamp": "03:52:17", "text": "明日、そこで面接があるんだ。 だから、私は"}, {"type": "subtitle", "time": 13940.55, "timestamp": "03:52:20", "text": "最善を尽くさなければならなかった。 しかし、今日ご覧になったように、私は"}, {"type": "subtitle", "time": 13943.48, "timestamp": "03:52:23", "text": "パニック状態でした。"}, {"type": "subtitle", "time": 13947.03, "timestamp": "03:52:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13948.03, "timestamp": "03:52:28", "text": "それは"}, {"type": "subtitle", "time": 13952.229, "timestamp": "03:52:32", "text": "まずい。 今日はすごくパニックになった。 明日の"}, {"type": "subtitle", "time": 13956.83, "timestamp": "03:52:36", "text": "実際の15分間の面接では、何をすればいいでしょうか"}, {"type": "subtitle", "time": 13959.309, "timestamp": "03:52:39", "text": "？ 私"}, {"type": "subtitle", "time": 13965.63, "timestamp": "03:52:45", "text": "もVCに参加します。 ああ、君は"}]
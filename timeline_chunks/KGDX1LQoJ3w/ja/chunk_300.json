[{"type": "subtitle", "time": 18000.708, "timestamp": "05:00:00", "text": "。"}, {"type": "subtitle", "time": 18003.35, "timestamp": "05:00:03", "text": "おそらく、人々が"}, {"type": "subtitle", "time": 18006.708, "timestamp": "05:00:06", "text": "独自のサーバーを作成するようなものだと思います。"}, {"type": "subtitle", "time": 18010.35, "timestamp": "05:00:10", "text": "ああ、神様、私が保存します。 つまり、"}, {"type": "subtitle", "time": 18015.51, "timestamp": "05:00:15", "text": "この件に関しては、私たち二人とも市長ということになる。 ごめん。 見てみましょう。"}, {"type": "subtitle", "time": 18018.47, "timestamp": "05:00:18", "text": "なぜ一人称で「あなた」と書くのですか？ 私は一人称視点が好きです"}, {"type": "subtitle", "time": 18021.27, "timestamp": "05:00:21", "text": "。"}, {"type": "subtitle", "time": 18024.07, "timestamp": "05:00:24", "text": "よし、次はそれをぶっ殺してやる。 ああ、やっつけよう"}, {"type": "subtitle", "time": 18032.47, "timestamp": "05:00:32", "text": "ああ、PvPにもダメージがあるんですね。"}, {"type": "subtitle", "time": 18035.59, "timestamp": "05:00:35", "text": "え、何？ 私を殴るってこと？ うん。 ああ、"}, {"type": "subtitle", "time": 18038.07, "timestamp": "05:00:38", "text": "殴られたよ。"}, {"type": "subtitle", "time": 18040.628, "timestamp": "05:00:40", "text": "あなたも被弾しましたか？ わかった。 わかった。 ああ、わかりました"}, {"type": "subtitle", "time": 18043.99, "timestamp": "05:00:43", "text": "。 うん。 待って、"}, {"type": "subtitle", "time": 18048.39, "timestamp": "05:00:48", "text": "それについては気をつけられるよ。 プレイヤーによる損害は発生していません。"}, {"type": "subtitle", "time": 18050.23, "timestamp": "05:00:50", "text": "損傷なし。 いや、それだと楽しくないね"}, {"type": "subtitle", "time": 18052.15, "timestamp": "05:00:52", "text": "。 来て。 楽しもうよ。"}, {"type": "subtitle", "time": 18055.59, "timestamp": "05:00:55", "text": "お互いに殺し合おう。 何？"}, {"type": "subtitle", "time": 18057.03, "timestamp": "05:00:57", "text": "いや、いや、いや。 互いに殺し合う。"}]
[{"type": "subtitle", "time": 15242.03, "timestamp": "04:14:02", "text": "難しいのか？ ああ、なるほど"}, {"type": "subtitle", "time": 15254.149, "timestamp": "04:14:14", "text": "これを読んでみましょう。 待って、なぜマウスが動かないの？   すみません"}, {"type": "subtitle", "time": 15268.309, "timestamp": "04:14:28", "text": "何？ 何？ バッテリーは交換したばかりです"}, {"type": "subtitle", "time": 15278.83, "timestamp": "04:14:38", "text": "何？ 神よ、第三のバッテリーよ。 いいえ。わかりました。"}, {"type": "subtitle", "time": 15282.11, "timestamp": "04:14:42", "text": "これはフル"}, {"type": "subtitle", "time": 15290.95, "timestamp": "04:14:50", "text": "この人、すごくたくさん写真を撮ってるね。   わかった"}]
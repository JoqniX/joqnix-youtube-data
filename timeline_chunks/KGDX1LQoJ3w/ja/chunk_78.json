[{"type": "subtitle", "time": 4700.87, "timestamp": "01:18:20", "text": "このガキ、いつまで経っても終わらないよ、兄弟。 よし、"}, {"type": "subtitle", "time": 4704.149, "timestamp": "01:18:24", "text": "パート2に15だけ入れて、"}, {"type": "subtitle", "time": 4711.55, "timestamp": "01:18:31", "text": "[音楽]"}, {"type": "subtitle", "time": 4716.27, "timestamp": "01:18:36", "text": "うん、パート2の59は、"}, {"type": "subtitle", "time": 4722.91, "timestamp": "01:18:42", "text": "大きなコラボの直後に寝る前の夜の配信みたいなものだ"}]
[{"type": "subtitle", "time": 1201.11, "timestamp": "00:20:01", "text": "実際、たとえ"}, {"type": "subtitle", "time": 1203.83, "timestamp": "00:20:03", "text": "それが1時間の配信で、"}, {"type": "subtitle", "time": 1207.19, "timestamp": "00:20:07", "text": "読み込み中の状態のままにしておいたとしても、"}, {"type": "subtitle", "time": 1210.39, "timestamp": "00:20:10", "text": "ランダムに終了してしまうのかどうか確認したいんです。"}, {"type": "subtitle", "time": 1213.23, "timestamp": "00:20:13", "text": "ランダムに終わるのを見たことがありますか、それとも、"}, {"type": "subtitle", "time": 1215.669, "timestamp": "00:20:15", "text": "何と呼ぶのでしょうか？"}, {"type": "subtitle", "time": 1222.95, "timestamp": "00:20:22", "text": "昨日みたいに、「ライブ配信の録画は利用できません」って言うだけでいいのかな？   つまり、"}, {"type": "subtitle", "time": 1252.789, "timestamp": "00:20:52", "text": "。 私はこれをインストールしていません。 いいえ。"}, {"type": "subtitle", "time": 1255.31, "timestamp": "00:20:55", "text": "どうやら、"}]
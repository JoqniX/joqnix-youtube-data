[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "現実世界でこれってできると思う？」って感じで、周りの人が話しているのに、自分は"}, {"type": "subtitle", "time": 14285.87, "timestamp": "03:58:05", "text": "後ろからじっと見つめて"}, {"type": "subtitle", "time": 14288.79, "timestamp": "03:58:08", "text": "壁みたいになるのは変な感じがする。 話したいのに"}, {"type": "subtitle", "time": 14291.66, "timestamp": "03:58:11", "text": "話せない瞬間。"}, {"type": "subtitle", "time": 14305.03, "timestamp": "03:58:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14320.59, "timestamp": "03:58:40", "text": "問題は、どうやって"}]
[{"type": "subtitle", "time": 13560.07, "timestamp": "03:46:00", "text": "彼らは二人とも別の"}, {"type": "subtitle", "time": 13568.55, "timestamp": "03:46:08", "text": "ちょっと待って。 大丈夫。   次の"}, {"type": "subtitle", "time": 13570.63, "timestamp": "03:46:10", "text": "イベントに行くときは、必ず行きます"}, {"type": "subtitle", "time": 13572.63, "timestamp": "03:46:12", "text": "。 次の"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "イベントはいつですか？ 待って。"}, {"type": "subtitle", "time": 13579.309, "timestamp": "03:46:19", "text": "あ、待って。 この日本人"}, {"type": "subtitle", "time": 13581.95, "timestamp": "03:46:21", "text": "コミュニティとは何ですか？ あ、私もこれに参加したんだよね"}, {"type": "subtitle", "time": 13588.269, "timestamp": "03:46:28", "text": "今日何をしているのですか？"}, {"type": "subtitle", "time": 13595.71, "timestamp": "03:46:35", "text": "あなたは"}, {"type": "subtitle", "time": 13598.63, "timestamp": "03:46:38", "text": "よくやっていましたよ。 ジョッキーは学生時代、"}, {"type": "subtitle", "time": 13610.59, "timestamp": "03:46:50", "text": "あ、待って。 いいえ、私は"}, {"type": "subtitle", "time": 13613.67, "timestamp": "03:46:53", "text": "キャプテンか"}, {"type": "subtitle", "time": 13615.83, "timestamp": "03:46:55", "text": "、青い家、緑の家、赤い"}, {"type": "subtitle", "time": 13618.55, "timestamp": "03:46:58", "text": "家、黄色い家のような存在でした。 私は青"}]
[{"type": "subtitle", "time": 18783.67, "timestamp": "05:13:03", "text": "おお。 だから、どこかで待っていてください。 ええ、"}, {"type": "subtitle", "time": 18785.43, "timestamp": "05:13:05", "text": "残りの部分も"}, {"type": "subtitle", "time": 18794.19, "timestamp": "05:13:14", "text": "いや。"}, {"type": "subtitle", "time": 18801.67, "timestamp": "05:13:21", "text": "私たちは物を置く必要があるのですか？"}, {"type": "subtitle", "time": 18804.23, "timestamp": "05:13:24", "text": "棒切れをいくつか見つけてきてくれ。   わかりました"}, {"type": "subtitle", "time": 18806.948, "timestamp": "05:13:26", "text": "、棒を持ってきますね。"}, {"type": "subtitle", "time": 18810.39, "timestamp": "05:13:30", "text": "機材を持ってきます。 ああ、"}, {"type": "subtitle", "time": 18814.23, "timestamp": "05:13:34", "text": "原始的な怒りを込めたのか？"}, {"type": "subtitle", "time": 18816.55, "timestamp": "05:13:36", "text": "うん。"}, {"type": "subtitle", "time": 18827.19, "timestamp": "05:13:47", "text": "舵。 舵はどうですか？"}, {"type": "subtitle", "time": 18829.75, "timestamp": "05:13:49", "text": "何目必要ですか？"}, {"type": "subtitle", "time": 18831.55, "timestamp": "05:13:51", "text": "棒。"}]
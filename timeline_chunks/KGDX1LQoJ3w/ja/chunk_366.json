[{"type": "subtitle", "time": 21960.23, "timestamp": "06:06:00", "text": "。それで、彼らは"}, {"type": "subtitle", "time": 21963.07, "timestamp": "06:06:03", "text": "プロジェクトか何か情熱プロジェクトか"}, {"type": "subtitle", "time": 21967.83, "timestamp": "06:06:07", "text": "何かを持っていて、真剣に取り組む人、例えば"}, {"type": "subtitle", "time": 21972.788, "timestamp": "06:06:12", "text": "コンテンツ"}, {"type": "subtitle", "time": 21974.708, "timestamp": "06:06:14", "text": "クリエイターで行き詰まっている人、"}, {"type": "subtitle", "time": 21978.868, "timestamp": "06:06:18", "text": "成長していないYouTuberで行き詰まっている人、でもこれで"}, {"type": "subtitle", "time": 21982.15, "timestamp": "06:06:22", "text": "生計を立てたいと思っている人などを対象にトレーニングをしているんだ"}, {"type": "subtitle", "time": 21984.788, "timestamp": "06:06:24", "text": "。それで彼女と他の人たちは、もっと多くの"}, {"type": "subtitle", "time": 21990.39, "timestamp": "06:06:30", "text": "大きなクリエイター、"}, {"type": "subtitle", "time": 21992.47, "timestamp": "06:06:32", "text": "独立系クリエイターを集めることができて、"}, {"type": "subtitle", "time": 21995.19, "timestamp": "06:06:35", "text": "グループで集まって、"}, {"type": "subtitle", "time": 21997.83, "timestamp": "06:06:37", "text": "個々の人に教えたり助けたりしていました。それが"}, {"type": "subtitle", "time": 22000.31, "timestamp": "06:06:40", "text": "始まり方で、その後、"}, {"type": "subtitle", "time": 22002.31, "timestamp": "06:06:42", "text": "管理が難しくなったので、"}]
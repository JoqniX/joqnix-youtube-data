[{"type": "subtitle", "time": 8112.47, "timestamp": "02:15:12", "text": "衝撃波。 衝撃波。 弾丸。 衝撃波。"}, {"type": "subtitle", "time": 8113.629, "timestamp": "02:15:13", "text": "えっと、"}, {"type": "subtitle", "time": 8148.149, "timestamp": "02:15:48", "text": "タブをロックするにはどうすればいいですか？ スイッチファイア。"}, {"type": "subtitle", "time": 8150.79, "timestamp": "02:15:50", "text": "武器を切り替える。 俺は別の"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "武器を持ってるぜ、兄弟。 ずっと私は"}]
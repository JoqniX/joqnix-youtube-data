[{"type": "subtitle", "time": 22380.31, "timestamp": "06:13:00", "text": "その状況が起こったとき、そのことについて深く考えていました。 私は「わあ、"}, {"type": "subtitle", "time": 22386.31, "timestamp": "06:13:06", "text": "私もそういう"}, {"type": "subtitle", "time": 22391.35, "timestamp": "06:13:11", "text": "経験があるかな」と思ったのですが、今はそうではなく、ただ、もし"}, {"type": "subtitle", "time": 22407.67, "timestamp": "06:13:27", "text": "シンダーのドラマの話をしていたのか"}, {"type": "subtitle", "time": 22409.47, "timestamp": "06:13:29", "text": "、という感じでした。"}, {"type": "subtitle", "time": 22413.628, "timestamp": "06:13:33", "text": "シンダーのことだけど、シンダーの"}, {"type": "subtitle", "time": 22417.99, "timestamp": "06:13:37", "text": "騒動はご存知ですよね。 えっと、TLD、彼女は"}, {"type": "subtitle", "time": 22419.31, "timestamp": "06:13:39", "text": "すごく"}, {"type": "subtitle", "time": 22422.15, "timestamp": "06:13:42", "text": "競争心が強くて、ある意味、"}, {"type": "subtitle", "time": 22427.548, "timestamp": "06:13:47", "text": "競争相手を全員排除したかったんです。 それで彼女は、"}, {"type": "subtitle", "time": 22433.35, "timestamp": "06:13:53", "text": "彼女の友人であり親しい友人でもあるアーティストを独占したり、"}]
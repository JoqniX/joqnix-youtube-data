[{"type": "subtitle", "time": 16863.31, "timestamp": "04:41:03", "text": "男は誰だ？ それは私です。"}, {"type": "subtitle", "time": 16866.07, "timestamp": "04:41:06", "text": "疑問符。 ゲーム投稿。"}, {"type": "subtitle", "time": 16869.91, "timestamp": "04:41:09", "text": "えっと、チュートリアルみたいなメールが届いたんです。"}, {"type": "subtitle", "time": 16879.43, "timestamp": "04:41:19", "text": "やあ、ミランダ。 私の回線に関するバグ報告は受け付けています"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "。 わかった。   わかった"}, {"type": "subtitle", "time": 16883.83, "timestamp": "04:41:23", "text": "。 つまり、Steam のようなゲームであなたに見せたということです"}, {"type": "subtitle", "time": 16886.07, "timestamp": "04:41:26", "text": "。"}, {"type": "subtitle", "time": 16889.27, "timestamp": "04:41:29", "text": "えっと、あなたはどこにいますか？"}, {"type": "subtitle", "time": 16897.27, "timestamp": "04:41:37", "text": "蒸しパンが見当たらないのですが。 いいえ、"}, {"type": "subtitle", "time": 16900.15, "timestamp": "04:41:40", "text": "私はあなたのプレーを見ています。"}, {"type": "subtitle", "time": 16903.27, "timestamp": "04:41:43", "text": "パンはどこ？"}, {"type": "subtitle", "time": 16905.35, "timestamp": "04:41:45", "text": "良くないね。"}, {"type": "subtitle", "time": 16909.59, "timestamp": "04:41:49", "text": "Steamでのあなたの名前は何ですか？ くそ。 私も"}, {"type": "subtitle", "time": 16913.19, "timestamp": "04:41:53", "text": "忘れていました。 ちょっと待ってください。 いい斧ですね。"}, {"type": "subtitle", "time": 16916.35, "timestamp": "04:41:56", "text": "ニース。 よし、じゃあ名前を「パン」に変えておこう。そうすればすぐに"}, {"type": "subtitle", "time": 16919.67, "timestamp": "04:41:59", "text": "君を見つけられるから。"}]
[{"type": "subtitle", "time": 20769.75, "timestamp": "05:46:09", "text": "62."}, {"type": "subtitle", "time": 20772.43, "timestamp": "05:46:12", "text": "[音楽]"}, {"type": "subtitle", "time": 20784.27, "timestamp": "05:46:24", "text": "えっと、"}, {"type": "subtitle", "time": 20787.83, "timestamp": "05:46:27", "text": "不適切なことを言ってるのはどういうことですか？ えっと、"}, {"type": "subtitle", "time": 20791.35, "timestamp": "05:46:31", "text": "あなたの"}, {"type": "subtitle", "time": 20794.19, "timestamp": "05:46:34", "text": "言葉遣いはどうなっているんですか？ 言葉遣いに気をつけなさいよ、"}, {"type": "subtitle", "time": 20796.03, "timestamp": "05:46:36", "text": "おじさん。"}, {"type": "subtitle", "time": 20800.39, "timestamp": "05:46:40", "text": "えっと、ビリービリーでユーザーをブロックするにはどうすればいいですか？"}, {"type": "subtitle", "time": 20803.51, "timestamp": "05:46:43", "text": "ところで、誰か知っていますか？ なあ、俺は"}, {"type": "subtitle", "time": 20807.548, "timestamp": "05:46:47", "text": "中国語が読めないんだ。 一体どういうことだ？"}, {"type": "subtitle", "time": 20811.35, "timestamp": "05:46:51", "text": "言葉遣いに気をつけましょう。 どうか、どうか、どうか"}, {"type": "subtitle", "time": 20813.67, "timestamp": "05:46:53", "text": "不適切なことはしないでください。 こちらは"}, {"type": "subtitle", "time": 20816.83, "timestamp": "05:46:56", "text": "家族向けのチャンネルです。"}]
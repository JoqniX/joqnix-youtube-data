[{"type": "subtitle", "time": 5641.83, "timestamp": "01:34:01", "text": "それは不完全な尺度だ。 しかし、現時点ではそれが最善の"}, {"type": "subtitle", "time": 5650.87, "timestamp": "01:34:10", "text": "。 どうしたの？ どうにも"}, {"type": "subtitle", "time": 5653.43, "timestamp": "01:34:13", "text": "その手を外せないようだ。 スタブは、私たちには"}, {"type": "subtitle", "time": 5655.43, "timestamp": "01:34:15", "text": "無駄にできる時間がないという点でも譲らない。"}, {"type": "subtitle", "time": 5664.87, "timestamp": "01:34:24", "text": "コンセントを確認してみましょう。 どちらが良いか、それとも私が"}, {"type": "subtitle", "time": 5679.59, "timestamp": "01:34:39", "text": "これは常に十分なダメージを受けてきました。"}, {"type": "subtitle", "time": 5687.639, "timestamp": "01:34:47", "text": "。 次のログの準備が整い、そして"}, {"type": "subtitle", "time": 5695.91, "timestamp": "01:34:55", "text": "死亡しました。 面白い。  Lドロップ。"}]
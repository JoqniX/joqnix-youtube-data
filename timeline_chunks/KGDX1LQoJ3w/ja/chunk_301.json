[{"type": "subtitle", "time": 18060.23, "timestamp": "05:01:00", "text": "今はダメだよ、犬。 あ、すみません。 ごめんなさい、ごめんなさい。 私たちは"}, {"type": "subtitle", "time": 18063.67, "timestamp": "05:01:03", "text": "これを撲滅しようとしている。   私はそれが"}, {"type": "subtitle", "time": 18069.15, "timestamp": "05:01:09", "text": "欲しい。 上へ行こう"}, {"type": "subtitle", "time": 18073.75, "timestamp": "05:01:13", "text": "。 誓って言いますが、私は中にいました"}, {"type": "subtitle", "time": 18094.948, "timestamp": "05:01:34", "text": "ええと、地図上に表示されるはずです。  Mを押してください。"}, {"type": "subtitle", "time": 18098.948, "timestamp": "05:01:38", "text": "ああ、わかりました。 はい、はい、はい。"}, {"type": "subtitle", "time": 18100.788, "timestamp": "05:01:40", "text": "あなたがそこにいるのは分かりますが、"}, {"type": "subtitle", "time": 18103.91, "timestamp": "05:01:43", "text": "その人がそこにいるという兆候は全くありません"}, {"type": "subtitle", "time": 18106.788, "timestamp": "05:01:46", "text": "。 うん。"}, {"type": "subtitle", "time": 18110.07, "timestamp": "05:01:50", "text": "そこから確認する必要があります。"}, {"type": "subtitle", "time": 18118.23, "timestamp": "05:01:58", "text": "私は怒っていません。 私は怒っていません。"}]
[{"type": "subtitle", "time": 13262.55, "timestamp": "03:41:02", "text": "レンジャー、元気でいることを願っています。 いらっしゃいませ。"}, {"type": "subtitle", "time": 13264.309, "timestamp": "03:41:04", "text": "このクエストはなかなか面白い。"}, {"type": "subtitle", "time": 13272.63, "timestamp": "03:41:12", "text": "仕事の進め方を見てください。"}, {"type": "subtitle", "time": 13274.95, "timestamp": "03:41:14", "text": "彼女は去るつもりだ。 知っている。"}, {"type": "subtitle", "time": 13278.469, "timestamp": "03:41:18", "text": "でも、聞いてみたいんです。 質問したいことがあります。 私はしたくない。"}, {"type": "subtitle", "time": 13287.389, "timestamp": "03:41:27", "text": "。 見ていてとても面白い"}, {"type": "subtitle", "time": 13292.229, "timestamp": "03:41:32", "text": "。 ああ、君は逃したね。 私が"}, {"type": "subtitle", "time": 13294.389, "timestamp": "03:41:34", "text": "パニックになっていた部分を見逃したんですね。 イベントで"}, {"type": "subtitle", "time": 13296.95, "timestamp": "03:41:36", "text": "自己紹介の番が来たとき、私はずっと泣いていました。"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "イベントのテーマは「もしあなたが"}, {"type": "subtitle", "time": 13309.51, "timestamp": "03:41:49", "text": "プロのスポーツ選手だったら、どの"}, {"type": "subtitle", "time": 13312.55, "timestamp": "03:41:52", "text": "スポーツを選びますか？」というもので、私はe"}, {"type": "subtitle", "time": 13314.95, "timestamp": "03:41:54", "text": "スポーツと答えました。私はパニックになっていました。私が"}, {"type": "subtitle", "time": 13317.429, "timestamp": "03:41:57", "text": "最後に話す番だったのは、"}]
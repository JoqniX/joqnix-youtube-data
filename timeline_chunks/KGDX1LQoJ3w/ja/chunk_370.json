[{"type": "subtitle", "time": 22217.19, "timestamp": "06:10:17", "text": "イルミナティにアプローチしただけです。 イルミナティとは何ですか？ わからない"}, {"type": "subtitle", "time": 22219.43, "timestamp": "06:10:19", "text": "。 ピラミッドみたいなものだってことしか知らないし、ああ、"}, {"type": "subtitle", "time": 22237.39, "timestamp": "06:10:37", "text": "その話題については何も知らないんだけど、でも、"}, {"type": "subtitle", "time": 22245.39, "timestamp": "06:10:45", "text": "こういう"}, {"type": "subtitle", "time": 22249.708, "timestamp": "06:10:49", "text": "やり取りをするのは初めてで、すごいと思った"}, {"type": "subtitle", "time": 22254.59, "timestamp": "06:10:54", "text": "。 どんな気持ちだったか、わかるかい？ まるで"}]
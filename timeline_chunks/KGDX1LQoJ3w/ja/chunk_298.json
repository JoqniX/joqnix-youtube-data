[{"type": "subtitle", "time": 17882.27, "timestamp": "04:58:02", "text": "ええと、協力プレイ2も良いですよ。"}, {"type": "subtitle", "time": 17885.31, "timestamp": "04:58:05", "text": "[音楽]"}, {"type": "subtitle", "time": 17889.11, "timestamp": "04:58:09", "text": "ああ、友達が地図上に表示されています。 わかった。"}, {"type": "subtitle", "time": 17892.15, "timestamp": "04:58:12", "text": "パスワードを設定すべきでしょうか？"}, {"type": "subtitle", "time": 17895.03, "timestamp": "04:58:15", "text": "もちろん。 何を入れたいですか？ ニャーとか"}, {"type": "subtitle", "time": 17898.07, "timestamp": "04:58:18", "text": "？ よし、ニャーとやろう。 いや、"}, {"type": "subtitle", "time": 17906.628, "timestamp": "04:58:26", "text": "8080みたいなのを考えていたんだ。わかった。 そして、私はそれを"}, {"type": "subtitle", "time": 17909.03, "timestamp": "04:58:29", "text": "配信で言ったばかりです。"}, {"type": "subtitle", "time": 17910.788, "timestamp": "04:58:30", "text": "それはいいですね。 どなたでも今すぐ参加できます"}, {"type": "subtitle", "time": 17914.948, "timestamp": "04:58:34", "text": "。 いいえ、配信中です。 だから、大丈夫です。"}, {"type": "subtitle", "time": 17916.55, "timestamp": "04:58:36", "text": "大丈夫です。 大丈夫です。 いいえ、今すぐ参加します"}, {"type": "subtitle", "time": 17920.15, "timestamp": "04:58:40", "text": "。 だから、私のゲームを私のゲームに残しておいて"}, {"type": "subtitle", "time": 17923.51, "timestamp": "04:58:43", "text": "。 うん、招待するよ。 わかった。"}, {"type": "subtitle", "time": 17929.35, "timestamp": "04:58:49", "text": "招待を受け入れました。うまくいくかどうか試してみましょう。"}, {"type": "subtitle", "time": 17931.19, "timestamp": "04:58:51", "text": "それで、ちょっと知りたいことがあるんです。"}, {"type": "subtitle", "time": 17934.39, "timestamp": "04:58:54", "text": "私が今参加しようとしているのは、厳密に言えばあなたの世界なのでしょうか？"}, {"type": "subtitle", "time": 17936.708, "timestamp": "04:58:56", "text": "はい、そう思います"}, {"type": "subtitle", "time": 17939.43, "timestamp": "04:58:59", "text": "。 えっと、待って、まだ"}]
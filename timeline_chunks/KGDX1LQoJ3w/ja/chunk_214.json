[{"type": "subtitle", "time": 12840.349, "timestamp": "03:34:00", "text": "彼女は"}, {"type": "subtitle", "time": 12844.79, "timestamp": "03:34:04", "text": "プロ野球の全身トラッキングを持っています。だから、"}, {"type": "subtitle", "time": 12856.71, "timestamp": "03:34:16", "text": "神様、私は持っていません"}, {"type": "subtitle", "time": 12859.67, "timestamp": "03:34:19", "text": "Discord Nitro を購入するお金が足りません。あ、"}, {"type": "subtitle", "time": 12861.67, "timestamp": "03:34:21", "text": "Discord サーバーには参加しませんが、"}, {"type": "subtitle", "time": 12864.389, "timestamp": "03:34:24", "text": "100 のサーバーから退出する必要があります。あ、いいですか？私の"}, {"type": "subtitle", "time": 12871.07, "timestamp": "03:34:31", "text": "別アカウントから参加します。"}, {"type": "subtitle", "time": 12878.79, "timestamp": "03:34:38", "text": "あと、免責事項を記載するのを忘れていました"}, {"type": "subtitle", "time": 12882.79, "timestamp": "03:34:42", "text": "。実はライブ配信をしています。"}, {"type": "subtitle", "time": 12890.95, "timestamp": "03:34:50", "text": "この日本語交換"}]
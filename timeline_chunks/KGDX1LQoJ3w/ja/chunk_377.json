[{"type": "subtitle", "time": 22636.75, "timestamp": "06:17:16", "text": "はい、これでズームできます。"}, {"type": "subtitle", "time": 22639.99, "timestamp": "06:17:19", "text": "ええ、今は映画的な作品も作っていますよ。"}, {"type": "subtitle", "time": 22654.39, "timestamp": "06:17:34", "text": "【音楽】"}, {"type": "subtitle", "time": 22656.788, "timestamp": "06:17:36", "text": "さあ、皆さん。 もう何時間も配信してるから、"}, {"type": "subtitle", "time": 22658.708, "timestamp": "06:17:38", "text": "配信を終了して2つ目の配信に切り替えようかな"}, {"type": "subtitle", "time": 22661.03, "timestamp": "06:17:41", "text": "？ 約8"}, {"type": "subtitle", "time": 22662.67, "timestamp": "06:17:42", "text": "時間。 それで十分だ"}, {"type": "subtitle", "time": 22667.31, "timestamp": "06:17:47", "text": "。 午前10時に目が覚めるといいな。"}, {"type": "subtitle", "time": 22669.91, "timestamp": "06:17:49", "text": "ところで、みんなは何時に"}, {"type": "subtitle", "time": 22672.948, "timestamp": "06:17:52", "text": "寝てるの？ アストラ、一体いつ"}]
[{"type": "subtitle", "time": 1682.83, "timestamp": "00:28:02", "text": "取引的な"}, {"type": "subtitle", "time": 1687.269, "timestamp": "00:28:07", "text": "アプローチよりも、自分の"}, {"type": "subtitle", "time": 1689.909, "timestamp": "00:28:09", "text": "戦略や自分の"}, {"type": "subtitle", "time": 1693.87, "timestamp": "00:28:13", "text": "チャンネルの利益などを考えるアプローチの方が好きだ。 私は"}, {"type": "subtitle", "time": 1697.51, "timestamp": "00:28:17", "text": "そういうコラボレーションはしません。 私は、取引的な目的では"}, {"type": "subtitle", "time": 1703.75, "timestamp": "00:28:23", "text": "なく、純粋に楽しむため、そして他のクリエイターと時間を過ごすためにコラボレーションをしています"}, {"type": "subtitle", "time": 1711.07, "timestamp": "00:28:31", "text": "。 でも、確かに、よく分からない"}, {"type": "subtitle", "time": 1734.83, "timestamp": "00:28:54", "text": "。 本当に素晴らしい"}, {"type": "subtitle", "time": 1739.549, "timestamp": "00:28:59", "text": "ゲームだった。 もう手に入れた人はいますか？"}]
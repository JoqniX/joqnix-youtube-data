[{"type": "subtitle", "time": 13813.47, "timestamp": "03:50:13", "text": "モードって何？ ああ、"}, {"type": "subtitle", "time": 13828.389, "timestamp": "03:50:28", "text": "そこに入れるべきだ。 待って、"}, {"type": "subtitle", "time": 13832.95, "timestamp": "03:50:32", "text": "座っていいですよ。 私たちはどこに座るべきでしょうか？"}, {"type": "subtitle", "time": 13839.389, "timestamp": "03:50:39", "text": "座ることができません。 でも、壁を変えてみようかな"}, {"type": "subtitle", "time": 13842.67, "timestamp": "03:50:42", "text": "。 ああ、そうやってやるんですね。"}, {"type": "subtitle", "time": 13845.91, "timestamp": "03:50:45", "text": "よし、じゃあこれもオフにしておこう"}, {"type": "subtitle", "time": 13848.389, "timestamp": "03:50:48", "text": "。 わかった。 私にはもうここに何も残っていないと思う"}, {"type": "subtitle", "time": 13850.349, "timestamp": "03:50:50", "text": "。"}, {"type": "subtitle", "time": 13858.92, "timestamp": "03:50:58", "text": "日本語で話すことです。"}]
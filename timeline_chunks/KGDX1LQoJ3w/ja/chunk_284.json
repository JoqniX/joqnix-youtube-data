[{"type": "subtitle", "time": 17056.91, "timestamp": "04:44:16", "text": "しかし、"}, {"type": "subtitle", "time": 17059.19, "timestamp": "04:44:19", "text": "敵がいる。 ちょっと、そこ。 ああ、"}, {"type": "subtitle", "time": 17073.67, "timestamp": "04:44:33", "text": "一人称もある。 一人称視点では"}, {"type": "subtitle", "time": 17081.31, "timestamp": "04:44:41", "text": "[音楽]が"}, {"type": "subtitle", "time": 17083.99, "timestamp": "04:44:43", "text": "大きく見える。 なんてこった。 これはかなり"}, {"type": "subtitle", "time": 17091.75, "timestamp": "04:44:51", "text": "なぜこんなにカットシーンが多いのですか？"}, {"type": "subtitle", "time": 17094.73, "timestamp": "04:44:54", "text": "乾杯。"}]
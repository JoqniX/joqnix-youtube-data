[{"type": "subtitle", "time": 8944.23, "timestamp": "02:29:04", "text": "ええと、武器が原因ではないと思います。 いや"}, {"type": "subtitle", "time": 8946.79, "timestamp": "02:29:06", "text": "、そうじゃなくて、私はただ単にスキルが高いだけだと"}, {"type": "subtitle", "time": 8948.309, "timestamp": "02:29:08", "text": "思う​​。"}, {"type": "subtitle", "time": 8951.01, "timestamp": "02:29:11", "text": "私には無理です。"}, {"type": "subtitle", "time": 8956.03, "timestamp": "02:29:16", "text": "ああ、"}, {"type": "subtitle", "time": 8959.11, "timestamp": "02:29:19", "text": "いいです、気にしないでください。 今のところは鎌の方が良い"}, {"type": "subtitle", "time": 8985.99, "timestamp": "02:29:45", "text": "わかりました。 ああ、なんてことだ、あのガキはまだドンドンというやつを持って"}]
[{"type": "subtitle", "time": 21721.74, "timestamp": "06:02:01", "text": "もう一度確認したいんです。 今は誰も"}, {"type": "subtitle", "time": 21724.03, "timestamp": "06:02:04", "text": "[Music]を見ていない"}, {"type": "subtitle", "time": 21726.708, "timestamp": "06:02:06", "text": "。 ええ、その人は"}, {"type": "subtitle", "time": 21728.868, "timestamp": "06:02:08", "text": "今頃寝ているでしょうね。 でも、陰口は言いたくないんです"}, {"type": "subtitle", "time": 21730.948, "timestamp": "06:02:10", "text": "。 それも良くない"}, {"type": "subtitle", "time": 21734.67, "timestamp": "06:02:14", "text": "。 でも、それは私が唯一"}, {"type": "subtitle", "time": 21737.43, "timestamp": "06:02:17", "text": "後悔していることなんです。 いや、そういう"}, {"type": "subtitle", "time": 21743.51, "timestamp": "06:02:23", "text": "反応とか、批評家みたいな反応は予想していなかったんです"}, {"type": "subtitle", "time": 21764.39, "timestamp": "06:02:44", "text": "何？ コメントのことではない。 私が言いたかったのは、"}, {"type": "subtitle", "time": 21772.59, "timestamp": "06:02:52", "text": "（音楽）のことです"}, {"type": "subtitle", "time": 21775.03, "timestamp": "06:02:55", "text": "。 ああ、それは別の"}]
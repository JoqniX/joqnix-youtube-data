[{"type": "subtitle", "time": 18422.67, "timestamp": "05:07:02", "text": "凍えそうだ。 わかった。 ああ、"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "あそこにいる私を見て。"}, {"type": "subtitle", "time": 18428.628, "timestamp": "05:07:08", "text": "あ、こんにちは。 今すぐ飛び降りたい。 よし"}, {"type": "subtitle", "time": 18431.59, "timestamp": "05:07:11", "text": "。 お前は死ぬだろう。 あのね？ いや、いや。"}, {"type": "subtitle", "time": 18444.23, "timestamp": "05:07:24", "text": "私たちはそうするべきだと思う。"}, {"type": "subtitle", "time": 18451.27, "timestamp": "05:07:31", "text": "あのね？ えっと、どうすればいいかな"}, {"type": "subtitle", "time": 18452.708, "timestamp": "05:07:32", "text": "？ この島を離れて、目の前にあるあの"}, {"type": "subtitle", "time": 18457.91, "timestamp": "05:07:37", "text": "島に行く、といった感じです。 いや、いや。"}, {"type": "subtitle", "time": 18464.31, "timestamp": "05:07:44", "text": "探検してみよう。 おいおい、頼むよ。 さあ、"}, {"type": "subtitle", "time": 18467.91, "timestamp": "05:07:47", "text": "探検してみようぜ。 でも、手芸用品ならね。 何かを作らなきゃ"}, {"type": "subtitle", "time": 18470.708, "timestamp": "05:07:50", "text": "。"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "ええ、その通りです。 書いてある通り、石炭です。"}, {"type": "subtitle", "time": 18475.67, "timestamp": "05:07:55", "text": "そこで私たちはいくつかの石を見つけました。"}, {"type": "subtitle", "time": 18479.67, "timestamp": "05:07:59", "text": "必要なログと、私が確認したログ"}]
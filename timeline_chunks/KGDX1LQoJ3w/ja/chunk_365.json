[{"type": "subtitle", "time": 21909.67, "timestamp": "06:05:09", "text": "それ。 うん。 つまり、私も"}, {"type": "subtitle", "time": 21912.43, "timestamp": "06:05:12", "text": "同じことを言えたかもしれないけど、"}, {"type": "subtitle", "time": 21915.51, "timestamp": "06:05:15", "text": "「うん、それは本当だ。"}, {"type": "subtitle", "time": 21921.19, "timestamp": "06:05:21", "text": "私には合わない。でも、うーん、"}, {"type": "subtitle", "time": 21929.91, "timestamp": "06:05:29", "text": "彼らを尊敬して憧れていたから、それはやりすぎだったと思う。"}, {"type": "subtitle", "time": 21932.868, "timestamp": "06:05:32", "text": "彼らがサポートグループみたいなことをやっていて、"}, {"type": "subtitle", "time": 21941.15, "timestamp": "06:05:41", "text": "Twitchで"}, {"type": "subtitle", "time": 21944.708, "timestamp": "06:05:44", "text": "8000人のフォロワーがいる人たちを助けているのはわかる。彼らはTwitchだけをやっていて、YouTubeはやっていない。"}, {"type": "subtitle", "time": 21946.31, "timestamp": "06:05:46", "text": "彼らはまだ伝統的な"}, {"type": "subtitle", "time": 21948.628, "timestamp": "06:05:48", "text": "やり方に従っている。新しいプラットフォームに切り替えるのは"}, {"type": "subtitle", "time": 21955.51, "timestamp": "06:05:55", "text": "2025年だって言ったのに。いや、その時は2023年だった。うん。"}, {"type": "subtitle", "time": 21957.628, "timestamp": "06:05:57", "text": "でも、うん"}]
[{"type": "subtitle", "time": 4562.149, "timestamp": "01:16:02", "text": "終わりだ。  60番目の動画をアップロードしたいんだけど、"}, {"type": "subtitle", "time": 4568.87, "timestamp": "01:16:08", "text": "待ってみようかな。  59番目をやって、それから"}, {"type": "subtitle", "time": 4592.87, "timestamp": "01:16:32", "text": "おっと。 えっと、今週の土曜日に"}, {"type": "subtitle", "time": 4595.35, "timestamp": "01:16:35", "text": "森をテーマにしたコラボ企画があります。"}, {"type": "subtitle", "time": 4607.99, "timestamp": "01:16:47", "text": "。 そして、『森の息子たち』が"}, {"type": "subtitle", "time": 4609.91, "timestamp": "01:16:49", "text": "セールになっている時は、それも買わなきゃいけない"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "。   私は"}, {"type": "subtitle", "time": 4619.51, "timestamp": "01:16:59", "text": "。 私の記憶が正しければ、私は既に『"}]
[{"type": "subtitle", "time": 20403.27, "timestamp": "05:40:03", "text": "ああ、またプラットフォームでライブ配信してるよ。"}, {"type": "subtitle", "time": 20406.628, "timestamp": "05:40:06", "text": "つまり、Minecraft には有限性がありました。   他に"}, {"type": "subtitle", "time": 20409.15, "timestamp": "05:40:09", "text": "何があっただろうか"}, {"type": "subtitle", "time": 20411.75, "timestamp": "05:40:11", "text": "？ 他に何を追加しただろうか？ 他に何を"}, {"type": "subtitle", "time": 20422.75, "timestamp": "05:40:22", "text": "？  6オーバー。   わかった"}, {"type": "subtitle", "time": 20425.59, "timestamp": "05:40:25", "text": "。 えーと、私たちは"}, {"type": "subtitle", "time": 20426.91, "timestamp": "05:40:26", "text": "[音楽]を演奏しました。"}, {"type": "subtitle", "time": 20432.39, "timestamp": "05:40:32", "text": "オーケー。 わかった。 理解できたと思います。"}, {"type": "subtitle", "time": 20434.31, "timestamp": "05:40:34", "text": "汗まみれのシーン。 来て。 来て。 私と来て。"}, {"type": "subtitle", "time": 20443.868, "timestamp": "05:40:43", "text": "一緒に取り組みましょう。 えーと、それで、えーと、"}]
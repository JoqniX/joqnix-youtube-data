[{"type": "subtitle", "time": 17282.47, "timestamp": "04:48:02", "text": "うん。 そして、魔法にかけられたシリーズを鳴らしましょう。"}, {"type": "subtitle", "time": 17294.59, "timestamp": "04:48:14", "text": "。 でも、もし私がまだ"}, {"type": "subtitle", "time": 17301.61, "timestamp": "04:48:21", "text": "？ 常に上品であれ"}, {"type": "subtitle", "time": 17305.948, "timestamp": "04:48:25", "text": "[音楽]"}, {"type": "subtitle", "time": 17310.41, "timestamp": "04:48:30", "text": "冒険家。 よし、今すぐ私と一緒にやってみよう。"}, {"type": "subtitle", "time": 17317.39, "timestamp": "04:48:37", "text": "【音楽】"}, {"type": "subtitle", "time": 17320.788, "timestamp": "04:48:40", "text": "ああ、どうすればあなたに加われるのでしょうか？ それが"}, {"type": "subtitle", "time": 17329.35, "timestamp": "04:48:49", "text": "あなたを招待できるとは書いてありません。"}, {"type": "subtitle", "time": 17331.43, "timestamp": "04:48:51", "text": "私の画面にも表示されていません。"}, {"type": "subtitle", "time": 17334.39, "timestamp": "04:48:54", "text": "このチュートリアルはもう終わりにしないと。"}]
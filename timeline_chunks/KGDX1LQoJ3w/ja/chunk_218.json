[{"type": "subtitle", "time": 13109.79, "timestamp": "03:38:29", "text": "人が似たようなものを選びます。私の"}, {"type": "subtitle", "time": 13113.51, "timestamp": "03:38:33", "text": "グループには"}, {"type": "subtitle", "time": 13116.71, "timestamp": "03:38:36", "text": "2人いました。なぜ私の表情は"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "他の2人はバレーボールをしていました。だから、"}, {"type": "subtitle", "time": 13133.51, "timestamp": "03:38:53", "text": "なぜ私の目は開かないのでしょう？待って、"}, {"type": "subtitle", "time": 13135.67, "timestamp": "03:38:55", "text": "切断したのでしょうか？"}, {"type": "subtitle", "time": 13138.86, "timestamp": "03:38:58", "text": "ロサンゼルスまで行くのは、まるで"}]
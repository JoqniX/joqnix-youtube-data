[{"type": "subtitle", "time": 18204.43, "timestamp": "05:03:24", "text": "木を摘む。 私は"}, {"type": "subtitle", "time": 18214.67, "timestamp": "05:03:34", "text": "スポーン時の破壊兵器用アーマーを製作できます。"}, {"type": "subtitle", "time": 18217.59, "timestamp": "05:03:37", "text": "ハンマーにはいろいろな種類があるんですね。   その"}, {"type": "subtitle", "time": 18220.788, "timestamp": "05:03:40", "text": "必要性は理解していますが、わかりました"}, {"type": "subtitle", "time": 18223.19, "timestamp": "05:03:43", "text": "。"}, {"type": "subtitle", "time": 18226.99, "timestamp": "05:03:46", "text": "うん。 こちらで保存してください。 プリミティブを最大で保存します"}, {"type": "subtitle", "time": 18238.07, "timestamp": "05:03:58", "text": "癒しとは何ですか？ 私は自分自身を癒すことができるだろうか？"}]
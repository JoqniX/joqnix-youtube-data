[{"type": "subtitle", "time": 3668.47, "timestamp": "01:01:08", "text": "彼の配信をそんなに頻繁に見るわけではないのですが、"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "たまたま"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "Twitchで彼の配信を見かけたんです。 見てみましょう。"}, {"type": "subtitle", "time": 3684.71, "timestamp": "01:01:24", "text": "ストリーム配信していただけますか？ 神様神様。 なんで"}, {"type": "subtitle", "time": 3702.23, "timestamp": "01:01:42", "text": "また。 一部の動画は地域によっては視聴が制限されています"}, {"type": "subtitle", "time": 3705.23, "timestamp": "01:01:45", "text": "。 いつも"}]
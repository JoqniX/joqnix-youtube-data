[{"type": "subtitle", "time": 15063.59, "timestamp": "04:11:03", "text": "大丈夫だと思います。 ああ、世界のせいで私の"}, {"type": "subtitle", "time": 15082.51, "timestamp": "04:11:22", "text": "彼らは動画"}, {"type": "subtitle", "time": 15086.51, "timestamp": "04:11:26", "text": "（音楽）をブロックしている"}, {"type": "subtitle", "time": 15089.07, "timestamp": "04:11:29", "text": "。 待って。"}, {"type": "subtitle", "time": 15092.83, "timestamp": "04:11:32", "text": "ああ。 もしそれが著作権で保護された"}]
[{"type": "subtitle", "time": 17524.628, "timestamp": "04:52:04", "text": "。 私は桟橋をまっすぐ通り過ぎた。"}, {"type": "subtitle", "time": 17528.868, "timestamp": "04:52:08", "text": "ああ、桟橋より先には行かないでください。"}, {"type": "subtitle", "time": 17532.39, "timestamp": "04:52:12", "text": "船を止めろ。 はい、そうしました。 はい、そうしました。 今、君はあの"}, {"type": "subtitle", "time": 17541.35, "timestamp": "04:52:21", "text": "私たちは今、この島に取り残されてしまった"}, {"type": "subtitle", "time": 17557.39, "timestamp": "04:52:37", "text": "手作りのものは、まるで"}, {"type": "subtitle", "time": 17571.11, "timestamp": "04:52:51", "text": "物語です。 ああ、これがその血なまぐさい話だ。"}, {"type": "subtitle", "time": 17572.868, "timestamp": "04:52:52", "text": "マイク、"}, {"type": "subtitle", "time": 17575.03, "timestamp": "04:52:55", "text": "何だって？"}, {"type": "subtitle", "time": 17577.27, "timestamp": "04:52:57", "text": "これがその物語です。"}, {"type": "subtitle", "time": 17578.59, "timestamp": "04:52:58", "text": "どんな"}]
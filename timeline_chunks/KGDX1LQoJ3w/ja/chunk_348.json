[{"type": "subtitle", "time": 20881.59, "timestamp": "05:48:01", "text": "。 いや。頼むよ。"}, {"type": "subtitle", "time": 20885.788, "timestamp": "05:48:05", "text": "私は親切にしているんです。 こんなことを言うべきではない"}, {"type": "subtitle", "time": 20888.948, "timestamp": "05:48:08", "text": "。 ぜひそうしてください。 わかった。 ご"}, {"type": "subtitle", "time": 20893.67, "timestamp": "05:48:13", "text": "理解いただきありがとうございます。 優しくしてください。 わかった。 こんにちは。   やりますよ"}, {"type": "subtitle", "time": 20899.35, "timestamp": "05:48:19", "text": "。 でも、どうか親切にして、ルールを"}, {"type": "subtitle", "time": 20902.628, "timestamp": "05:48:22", "text": "破らないで、変なことや"}, {"type": "subtitle", "time": 20905.75, "timestamp": "05:48:25", "text": "不適切なことを言わないでください。 わかった。"}, {"type": "subtitle", "time": 20909.51, "timestamp": "05:48:29", "text": "書いてください。その他"}, {"type": "subtitle", "time": 20911.948, "timestamp": "05:48:31", "text": "関連事項、"}, {"type": "subtitle", "time": 20924.91, "timestamp": "05:48:44", "text": "適切な言葉遣いやチャットはしないでください。 それは良くない"}, {"type": "subtitle", "time": 20926.59, "timestamp": "05:48:46", "text": "。 ご"}, {"type": "subtitle", "time": 20934.09, "timestamp": "05:48:54", "text": "理解のほどよろしくお願いいたします。  1秒。"}]
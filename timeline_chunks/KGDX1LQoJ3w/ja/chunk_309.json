[{"type": "subtitle", "time": 18551.95, "timestamp": "05:09:11", "text": "だから、あそこを自分たちの家とか、"}, {"type": "subtitle", "time": 18553.628, "timestamp": "05:09:13", "text": "音楽とか、そういう場所にするんだ"}, {"type": "subtitle", "time": 18556.55, "timestamp": "05:09:16", "text": "。 今、この大きな木を切り倒したところです"}, {"type": "subtitle", "time": 18562.07, "timestamp": "05:09:22", "text": "。 ああ、残りは抽出できますよ。"}, {"type": "subtitle", "time": 18566.43, "timestamp": "05:09:26", "text": "ああ、木が横倒しになっている。 木、木"}, {"type": "subtitle", "time": 18590.15, "timestamp": "05:09:50", "text": "はい。 降りた方がいいと思う。 ああ、"}, {"type": "subtitle", "time": 18593.75, "timestamp": "05:09:53", "text": "今すぐ船を作らなきゃ。"}, {"type": "subtitle", "time": 18595.67, "timestamp": "05:09:55", "text": "船を作らなければならない。 おいおい、頼むよ。   下に"}]
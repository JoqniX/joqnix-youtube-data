[{"type": "subtitle", "time": 13621.51, "timestamp": "03:47:01", "text": "隊の隊長だった。 私は思いっきり叫ばなければならなかった"}, {"type": "subtitle", "time": 13624.79, "timestamp": "03:47:04", "text": "。 私もボーイスカウトのリーダーみたいな感じだった"}, {"type": "subtitle", "time": 13626.95, "timestamp": "03:47:06", "text": "けど、思いっきり叫ばなきゃいけなかった"}, {"type": "subtitle", "time": 13628.95, "timestamp": "03:47:08", "text": "。   むしろ、"}, {"type": "subtitle", "time": 13630.87, "timestamp": "03:47:10", "text": "私はその"}, {"type": "subtitle", "time": 13648.73, "timestamp": "03:47:28", "text": "推測しました。"}]
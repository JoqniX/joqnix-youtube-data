[{"type": "subtitle", "time": 21848.27, "timestamp": "06:04:08", "text": "ああ、君の言ったことは"}, {"type": "subtitle", "time": 21851.99, "timestamp": "06:04:11", "text": "本当だよ。 うん、他の誰にもさせてはいけないね。"}, {"type": "subtitle", "time": 21854.75, "timestamp": "06:04:14", "text": "ええ、それは"}, {"type": "subtitle", "time": 21858.15, "timestamp": "06:04:18", "text": "本当です。 えっと、でも、"}, {"type": "subtitle", "time": 21860.948, "timestamp": "06:04:20", "text": "もし私が彼らに"}, {"type": "subtitle", "time": 21863.75, "timestamp": "06:04:23", "text": "私の作品について批評を求めたとしたら、それはそれでいいんだけど、"}, {"type": "subtitle", "time": 21866.23, "timestamp": "06:04:26", "text": "私は何も聞いてないのに、"}, {"type": "subtitle", "time": 21871.59, "timestamp": "06:04:31", "text": "コラボしてこれをやってくれませんか？って聞いただけなんです。 私はただ"}, {"type": "subtitle", "time": 21874.31, "timestamp": "06:04:34", "text": "イベントに参加しているだけです。 それでおしまい。 そして、"}, {"type": "subtitle", "time": 21880.548, "timestamp": "06:04:40", "text": "誰も見ていないのに、"}, {"type": "subtitle", "time": 21883.11, "timestamp": "06:04:43", "text": "3か月もやっているのにまだ"}]
[{"type": "subtitle", "time": 13334.469, "timestamp": "03:42:14", "text": "そして私はひどく失敗した。"}, {"type": "subtitle", "time": 13337.67, "timestamp": "03:42:17", "text": "私はチップの反応を見ていました。"}, {"type": "subtitle", "time": 13341.03, "timestamp": "03:42:21", "text": "それを読んだのですが、つまずいて諦めてしまい、"}, {"type": "subtitle", "time": 13357.75, "timestamp": "03:42:37", "text": "字幕は一切なし。 二人とも「わかった」という感じだ"}]
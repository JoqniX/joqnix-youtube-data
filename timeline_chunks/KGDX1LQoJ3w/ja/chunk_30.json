[{"type": "subtitle", "time": 1802.07, "timestamp": "00:30:02", "text": "王様をテーマにしたゲームは、アップグレードすればするほど"}, {"type": "subtitle", "time": 1804.83, "timestamp": "00:30:04", "text": "面白くなっていくところが楽しかったです"}, {"type": "subtitle", "time": 1807.99, "timestamp": "00:30:07", "text": "。 そして、"}, {"type": "subtitle", "time": 1811.11, "timestamp": "00:30:11", "text": "このゲームには、"}, {"type": "subtitle", "time": 1813.59, "timestamp": "00:30:13", "text": "視聴者の視点から見て、積極的な退屈さがあるように感じます。 えーと、"}, {"type": "subtitle", "time": 1816.029, "timestamp": "00:30:16", "text": "これをストリーミング配信していたら、ボット"}, {"type": "subtitle", "time": 1817.63, "timestamp": "00:30:17", "text": "視聴者もいて、"}, {"type": "subtitle", "time": 1821.35, "timestamp": "00:30:21", "text": "常に「ええ、"}, {"type": "subtitle", "time": 1824.19, "timestamp": "00:30:24", "text": "Twitchや"}, {"type": "subtitle", "time": 1826.789, "timestamp": "00:30:26", "text": "YouTube、特にYouTubeではボットが使われていると思います」と言っていました。  YouTube"}, {"type": "subtitle", "time": 1828.269, "timestamp": "00:30:28", "text": "でその問題が発生したので、"}, {"type": "subtitle", "time": 1831.029, "timestamp": "00:30:31", "text": "カテゴリを変更しました。"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "。 開発者自身がやっているのか、それとも"}]
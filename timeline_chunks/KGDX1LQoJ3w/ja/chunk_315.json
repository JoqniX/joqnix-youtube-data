[{"type": "subtitle", "time": 18908.628, "timestamp": "05:15:08", "text": "チキンがいっぱいだ [拍手] よし、じゃあもう少し"}, {"type": "subtitle", "time": 18911.83, "timestamp": "05:15:11", "text": "棒を買ってこようかな。"}, {"type": "subtitle", "time": 18912.868, "timestamp": "05:15:12", "text": "持続する。"}, {"type": "subtitle", "time": 18915.39, "timestamp": "05:15:15", "text": "では、自分が集中できるものを見つけるためには何が必要でしょうか"}, {"type": "subtitle", "time": 18925.03, "timestamp": "05:15:25", "text": "この卵は何？"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "アドベンチャーモードで、飛行機がどこかからやってくる。 最初の船を手に入れよう"}, {"type": "subtitle", "time": 18937.83, "timestamp": "05:15:37", "text": "船長。 あなたは10コイン"}, {"type": "subtitle", "time": 18941.19, "timestamp": "05:15:41", "text": "とキャプテンの称号を受け取りました。"}, {"type": "subtitle", "time": 18944.628, "timestamp": "05:15:44", "text": "おお。 ああ、ああ、あなたはすべてを持っている必要があります"}, {"type": "subtitle", "time": 18951.27, "timestamp": "05:15:51", "text": "。 しかし、このゲームは非常に複雑だ。"}, {"type": "subtitle", "time": 18953.27, "timestamp": "05:15:53", "text": "なぜ？"}, {"type": "subtitle", "time": 18955.83, "timestamp": "05:15:55", "text": "このゲームはちょっと複雑だ。"}, {"type": "subtitle", "time": 18958.708, "timestamp": "05:15:58", "text": "なぜ？ どうやって？"}]
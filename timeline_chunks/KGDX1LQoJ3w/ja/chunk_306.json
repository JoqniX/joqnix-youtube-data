[{"type": "subtitle", "time": 18361.91, "timestamp": "05:06:01", "text": "ほら、ジョー、このレバーが何なのか見てごらん。"}, {"type": "subtitle", "time": 18364.03, "timestamp": "05:06:04", "text": "レバー。"}, {"type": "subtitle", "time": 18366.51, "timestamp": "05:06:06", "text": "待って、"}, {"type": "subtitle", "time": 18369.39, "timestamp": "05:06:09", "text": "石。"}, {"type": "subtitle", "time": 18373.75, "timestamp": "05:06:13", "text": "私の無効化チュートリアルには参加しないでください。"}, {"type": "subtitle", "time": 18385.59, "timestamp": "05:06:25", "text": "マップをリセットできます。 これは何かの"}, {"type": "subtitle", "time": 18388.07, "timestamp": "05:06:28", "text": "参考資料ですか？"}, {"type": "subtitle", "time": 18391.67, "timestamp": "05:06:31", "text": "これは何かの参考資料ですか？   そうみたいですね。"}, {"type": "subtitle", "time": 18393.91, "timestamp": "05:06:33", "text": "私も、"}, {"type": "subtitle", "time": 18395.948, "timestamp": "05:06:35", "text": "これは何らかの参照元なのではないかと思います"}, {"type": "subtitle", "time": 18400.708, "timestamp": "05:06:40", "text": "。 思い切って挑戦してみるべきだろうか？"}, {"type": "subtitle", "time": 18405.27, "timestamp": "05:06:45", "text": "そんなに死にたいのか？ もちろん。   いいえ。ええ。"}, {"type": "subtitle", "time": 18407.67, "timestamp": "05:06:47", "text": "このゲームで死ぬとはどんな感じですか"}, {"type": "subtitle", "time": 18410.23, "timestamp": "05:06:50", "text": "？ 私ならそれを知っている。 なぜこの"}, {"type": "subtitle", "time": 18412.34, "timestamp": "05:06:52", "text": "島はこんなにぼやけているのですか？ ああ、"}, {"type": "subtitle", "time": 18415.948, "timestamp": "05:06:55", "text": "音楽よ。"}]
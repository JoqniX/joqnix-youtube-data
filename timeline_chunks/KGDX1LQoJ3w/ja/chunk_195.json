[{"type": "subtitle", "time": 11723.51, "timestamp": "03:15:23", "text": "。じゃあ、写真撮影が終わったら"}, {"type": "subtitle", "time": 11731.229, "timestamp": "03:15:31", "text": "カメラを外してください。"}, {"type": "subtitle", "time": 11739.429, "timestamp": "03:15:39", "text": "、もう一度やらなきゃいけないみたいだね"}, {"type": "subtitle", "time": 11742.88, "timestamp": "03:15:42", "text": "。よし。チーズって言って。"}, {"type": "subtitle", "time": 11752.71, "timestamp": "03:15:52", "text": "。皆さん、本当にありがとうございました。"}, {"type": "subtitle", "time": 11754.63, "timestamp": "03:15:54", "text": "来てくれてありがとう。"}]
[{"type": "subtitle", "time": 13866.87, "timestamp": "03:51:06", "text": "私はどこへ行けばいいの？"}, {"type": "subtitle", "time": 13869.99, "timestamp": "03:51:09", "text": "藤間はいいけど、"}, {"type": "subtitle", "time": 13873.51, "timestamp": "03:51:13", "text": "いい日本人の友達がいないと、行き詰まって"}, {"type": "subtitle", "time": 13876.229, "timestamp": "03:51:16", "text": "死んでしまうよ。 死んだというより、むしろ"}, {"type": "subtitle", "time": 13879.11, "timestamp": "03:51:19", "text": "全員が完全に本禅語を話すようになった、という感じだ。"}, {"type": "subtitle", "time": 13882.95, "timestamp": "03:51:22", "text": "日本人の友達ができたなら、それは"}, {"type": "subtitle", "time": 13886.11, "timestamp": "03:51:26", "text": "良いことだ。 そうでなければ、そうでは"}, {"type": "subtitle", "time": 13888.87, "timestamp": "03:51:28", "text": "ない。 しかし昨日、"}, {"type": "subtitle", "time": 13892.469, "timestamp": "03:51:32", "text": "Viaチャットにログインしたところ、ああ、"}, {"type": "subtitle", "time": 13895.99, "timestamp": "03:51:35", "text": "オフラインでした。  H ええ、彼らはここにいます。 私はメランのところへ行ったのですが、"}, {"type": "subtitle", "time": 13900.67, "timestamp": "03:51:40", "text": "メルソンは"}, {"type": "subtitle", "time": 13903.189, "timestamp": "03:51:43", "text": "私が先ほど話していた世界にいました"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "。 これは福建省の人で、"}, {"type": "subtitle", "time": 13908.87, "timestamp": "03:51:48", "text": "寝る前に挨拶して"}, {"type": "subtitle", "time": 13912.469, "timestamp": "03:51:52", "text": "少し話したんだけど、"}, {"type": "subtitle", "time": 13915.67, "timestamp": "03:51:55", "text": "会話を遮って「ただ挨拶しに来ただけ」って言うのはやっぱり気まずかった。"}]
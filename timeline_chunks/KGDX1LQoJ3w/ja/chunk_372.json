[{"type": "subtitle", "time": 22325.67, "timestamp": "06:12:05", "text": "個人的な、えーと、なんて言うのか"}, {"type": "subtitle", "time": 22327.868, "timestamp": "06:12:07", "text": "忘れちゃった"}, {"type": "subtitle", "time": 22331.59, "timestamp": "06:12:11", "text": "けど、ええ、そういうことで、"}, {"type": "subtitle", "time": 22337.03, "timestamp": "06:12:17", "text": "アーティストが他のクリエイターとやっていたプロジェクトや、その他いろいろな"}, {"type": "subtitle", "time": 22350.07, "timestamp": "06:12:30", "text": "ああ、ベールをバウバウ。 彼女は配信中に泣いた"}, {"type": "subtitle", "time": 22357.75, "timestamp": "06:12:37", "text": "うん。 うん。 想像してみてください。"}, {"type": "subtitle", "time": 22360.27, "timestamp": "06:12:40", "text": "親友がそんなことをしたら、やりすぎだよ"}, {"type": "subtitle", "time": 22364.75, "timestamp": "06:12:44", "text": "。 想像もできない"}, {"type": "subtitle", "time": 22373.35, "timestamp": "06:12:53", "text": "今となっては裏切り行為に等しい。"}, {"type": "subtitle", "time": 22375.628, "timestamp": "06:12:55", "text": "[音楽]"}, {"type": "subtitle", "time": 22378.548, "timestamp": "06:12:58", "text": "Mと私は、"}]
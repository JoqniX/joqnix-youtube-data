[{"type": "subtitle", "time": 301.99, "timestamp": "00:05:01", "text": "正しかった。 目を覚ましてYouTubeの配信を終了させるべきだった"}, {"type": "subtitle", "time": 304.23, "timestamp": "00:05:04", "text": "。   えっと、"}, {"type": "subtitle", "time": 313.43, "timestamp": "00:05:13", "text": "自分の"}, {"type": "subtitle", "time": 318.029, "timestamp": "00:05:18", "text": "不注意か"}, {"type": "subtitle", "time": 321.189, "timestamp": "00:05:21", "text": "何かで、ストリーム全体を失ってしまったのはこれで2回目です。 ああ、"}, {"type": "subtitle", "time": 324.27, "timestamp": "00:05:24", "text": "最近いろいろあって精神的にあまり良い状態じゃなかったんだ"}, {"type": "chat", "time": 334.951, "timestamp": "00:05:34", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "it be like that sometimes, you can always expect things to go smoothly"}, {"type": "subtitle", "time": 340.99, "timestamp": "00:05:40", "text": "サメだ。 こんにちは、ようこそ。 今、"}, {"type": "subtitle", "time": 343.189, "timestamp": "00:05:43", "text": "コメントを見ました。 物事が常に概算で進むとは限らない"}, {"type": "subtitle", "time": 345.469, "timestamp": "00:05:45", "text": "。 ええ、"}, {"type": "chat", "time": 348.316, "timestamp": "00:05:48", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "we live and we learn"}, {"type": "subtitle", "time": 348.39, "timestamp": "00:05:48", "text": "そうですね、今後はYouTubeの"}, {"type": "subtitle", "time": 352.71, "timestamp": "00:05:52", "text": "配信を停止して"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "バッファリング状態にするのではなく、少なくとも配信を終了するように気をつけます。 読み込み中のような感じでしたか"}]
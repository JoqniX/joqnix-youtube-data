[{"type": "subtitle", "time": 18603.628, "timestamp": "05:10:03", "text": "癒しの"}, {"type": "subtitle", "time": 18611.55, "timestamp": "05:10:11", "text": "そして私のキャラクターは、毎回必ず"}, {"type": "subtitle", "time": 18625.47, "timestamp": "05:10:25", "text": "この人、ちょっと"}, {"type": "subtitle", "time": 18632.23, "timestamp": "05:10:32", "text": "大丈夫です。 私たちはどこで"}, {"type": "subtitle", "time": 18638.47, "timestamp": "05:10:38", "text": "どこにいるの？"}, {"type": "subtitle", "time": 18640.628, "timestamp": "05:10:40", "text": "私は落ちていく。"}, {"type": "subtitle", "time": 18643.91, "timestamp": "05:10:43", "text": "私は既にスタート地点に立っている。 ああ、わかりました"}, {"type": "subtitle", "time": 18645.99, "timestamp": "05:10:45", "text": "。 わかった。"}, {"type": "subtitle", "time": 18656.47, "timestamp": "05:10:56", "text": "傷を癒すための杖が3つある。 わかった。 わかった。 こっちに来て、こっちに来て、"}, {"type": "subtitle", "time": 18658.948, "timestamp": "05:10:58", "text": "この容器を取って、それから、"}]
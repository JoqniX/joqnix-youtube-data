[{"type": "subtitle", "time": 20300.31, "timestamp": "05:38:20", "text": "。 わかった。 エアコンをタイマーでつけっぱなしにして、ここにいます"}, {"type": "subtitle", "time": 20303.83, "timestamp": "05:38:23", "text": "。 彼、だから"}, {"type": "subtitle", "time": 20306.15, "timestamp": "05:38:26", "text": "、すぐに、ああ、そうだ。 ビリー、ビリー、"}, {"type": "subtitle", "time": 20309.39, "timestamp": "05:38:29", "text": "忘れてた。 私はよく忘れてしまう。 ああ、ビリー、"}, {"type": "subtitle", "time": 20314.03, "timestamp": "05:38:34", "text": "ビリー。 ああ、それ忘れてた。 えっと、"}, {"type": "subtitle", "time": 20319.23, "timestamp": "05:38:39", "text": "？"}, {"type": "subtitle", "time": 20329.91, "timestamp": "05:38:49", "text": "ニューヤンへようこそ。 こんにちは。"}, {"type": "subtitle", "time": 20332.75, "timestamp": "05:38:52", "text": "よし、60日目だね"}, {"type": "subtitle", "time": 20336.03, "timestamp": "05:38:56", "text": "？  60日目、"}, {"type": "subtitle", "time": 20339.788, "timestamp": "05:38:59", "text": "私たちは何をしたんでしたっけ"}]
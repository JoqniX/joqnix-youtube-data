[{"type": "subtitle", "time": 4506.59, "timestamp": "01:15:06", "text": "ああ、あの曲、"}, {"type": "subtitle", "time": 4509.31, "timestamp": "01:15:09", "text": "えっと、何ていう曲だっけ？ ああ、"}, {"type": "subtitle", "time": 4512.83, "timestamp": "01:15:12", "text": "兄弟。 ああ、それか。 だから、彼女はそれを隠したんだよ"}, {"type": "subtitle", "time": 4519.99, "timestamp": "01:15:19", "text": "兄弟。 彼女はそれを見ている。 彼女はそれを見ていた。"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "彼女はアニメメダリストを見たんだよね？"}, {"type": "subtitle", "time": 4529.669, "timestamp": "01:15:29", "text": "彼女がオープニングでその曲をカバーしたなんて信じられない"}, {"type": "subtitle", "time": 4538.709, "timestamp": "01:15:38", "text": "。 ええ、カボチャです。 彼女は"}, {"type": "subtitle", "time": 4540.47, "timestamp": "01:15:40", "text": "知らない。 ええ、もちろん誰でも"}, {"type": "subtitle", "time": 4548.709, "timestamp": "01:15:48", "text": "。 今、閉じたの？ ああ、なんてことだ"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "。 あ、待って。 閉じるのをやめてください。"}]
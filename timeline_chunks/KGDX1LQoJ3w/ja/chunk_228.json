[{"type": "subtitle", "time": 13682.349, "timestamp": "03:48:02", "text": "11. このイベントは何"}, {"type": "subtitle", "time": 13686.63, "timestamp": "03:48:06", "text": "についてのものですか？ 説明が不十分です。   わかった"}, {"type": "subtitle", "time": 13690.07, "timestamp": "03:48:10", "text": "。 私たちは今日、このイベントに参加しました"}, {"type": "subtitle", "time": 13696.15, "timestamp": "03:48:16", "text": "。 これは毎週開催されるイベントです。 今日の"}, {"type": "subtitle", "time": 13698.55, "timestamp": "03:48:18", "text": "テーマは、もし"}, {"type": "subtitle", "time": 13700.55, "timestamp": "03:48:20", "text": "プロのスポーツ選手になれるとしたら、どのスポーツを"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "選び、その理由は何か、というものでした。 そして私は自分が選ぶと言った"}, {"type": "subtitle", "time": 13708.11, "timestamp": "03:48:28", "text": "。 私は、"}, {"type": "subtitle", "time": 13711.11, "timestamp": "03:48:31", "text": "内向的で屋外スポーツが苦手なので、スポーツ選手になりたいと言い、そのために"}, {"type": "subtitle", "time": 13718.87, "timestamp": "03:48:38", "text": "活動していると言いました"}, {"type": "subtitle", "time": 13722.15, "timestamp": "03:48:42", "text": "。"}, {"type": "subtitle", "time": 13724.389, "timestamp": "03:48:44", "text": "競争心とかそういうのだよね？ でも、"}, {"type": "subtitle", "time": 13728.63, "timestamp": "03:48:48", "text": "PCに問題が発生して以来、対戦型のゲームはあまりプレイしていないと思います"}, {"type": "subtitle", "time": 13730.87, "timestamp": "03:48:50", "text": "。   だから、それを自分の"}, {"type": "subtitle", "time": 13737.309, "timestamp": "03:48:57", "text": "限界にしてはいけない。 だから彼らは毎週イベントを開催しているんです"}]
[{"type": "subtitle", "time": 22261.51, "timestamp": "06:11:01", "text": "Twitterのあのシンダーの騒動みたいだった。"}, {"type": "subtitle", "time": 22263.948, "timestamp": "06:11:03", "text": "そんな感じだったけど、"}, {"type": "subtitle", "time": 22282.39, "timestamp": "06:11:22", "text": "ああ、なんていうか、"}, {"type": "subtitle", "time": 22285.07, "timestamp": "06:11:25", "text": "短く言うとしたら何て言うんだっけ？ それも1"}, {"type": "subtitle", "time": 22289.11, "timestamp": "06:11:29", "text": "秒くらいのことだ。 こんにちは、配信へようこ​​そ。"}, {"type": "subtitle", "time": 22292.31, "timestamp": "06:11:32", "text": "また、"}, {"type": "subtitle", "time": 22295.83, "timestamp": "06:11:35", "text": "V2リングの分野で非常に競争的であること、そしてその"}, {"type": "subtitle", "time": 22299.11, "timestamp": "06:11:39", "text": "非常に競争的なことが"}, {"type": "subtitle", "time": 22302.948, "timestamp": "06:11:42", "text": "親しい友人に対しても向けられること、そして、例えば"}, {"type": "subtitle", "time": 22305.75, "timestamp": "06:11:45", "text": "親しい友人も"}, {"type": "subtitle", "time": 22308.868, "timestamp": "06:11:48", "text": "あなたと同じように特定のアーティストと仕事をしていて、皆が"}, {"type": "subtitle", "time": 22311.51, "timestamp": "06:11:51", "text": "共通のアーティストを持っているといったことです。 それで彼女がやったことは、"}, {"type": "subtitle", "time": 22315.19, "timestamp": "06:11:55", "text": "アーティストに、何て言うんだっけ、"}]
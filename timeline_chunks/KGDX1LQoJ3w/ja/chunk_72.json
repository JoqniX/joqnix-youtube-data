[{"type": "subtitle", "time": 4345.11, "timestamp": "01:12:25", "text": "大丈夫です。 投票を済ませたら、"}, {"type": "subtitle", "time": 4349.07, "timestamp": "01:12:29", "text": "ゲームを起動します。 ソウルシリーズをプレイしたい"}, {"type": "subtitle", "time": 4357.59, "timestamp": "01:12:37", "text": "回避やパティなどのやり方を知りたいです"}, {"type": "subtitle", "time": 4360.47, "timestamp": "01:12:40", "text": "。 そういったスキルレベルに関する類のこと"}, {"type": "subtitle", "time": 4363.03, "timestamp": "01:12:43", "text": "。 私もそうしたいです。 それ、すごく好き。"}]
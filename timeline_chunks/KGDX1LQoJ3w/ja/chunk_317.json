[{"type": "subtitle", "time": 19022.07, "timestamp": "05:17:02", "text": "[音楽]"}, {"type": "subtitle", "time": 19025.35, "timestamp": "05:17:05", "text": "ああ、キャンプファイヤーを作ったり、何かを"}, {"type": "subtitle", "time": 19028.47, "timestamp": "05:17:08", "text": "調べたりできるよ。 物を転がすことができる"}, {"type": "subtitle", "time": 19031.35, "timestamp": "05:17:11", "text": "。 薬草療法、火気の利用、"}, {"type": "subtitle", "time": 19034.11, "timestamp": "05:17:14", "text": "原始的な漁法。"}, {"type": "subtitle", "time": 19057.23, "timestamp": "05:17:37", "text": "これが"}, {"type": "subtitle", "time": 19059.83, "timestamp": "05:17:39", "text": "最高かもしれない。 これは今まで見た中で一番複雑なものかもしれない"}, {"type": "subtitle", "time": 19072.15, "timestamp": "05:17:52", "text": "。 何てことだ。 史上最高のゲーム。 実に多くの"}, {"type": "subtitle", "time": 19074.628, "timestamp": "05:17:54", "text": "複雑な事柄。"}, {"type": "subtitle", "time": 19077.03, "timestamp": "05:17:57", "text": "史上最高のゲーム。 私は複雑な"}]
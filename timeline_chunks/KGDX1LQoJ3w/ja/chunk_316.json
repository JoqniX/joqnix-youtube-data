[{"type": "subtitle", "time": 18961.27, "timestamp": "05:16:01", "text": "それらはここにあるものと同じようなものだ。 例えば、あるものを"}, {"type": "subtitle", "time": 18965.75, "timestamp": "05:16:05", "text": "作るには、別のものを作るために、特定のものが必要になる、といった具合です"}, {"type": "subtitle", "time": 18970.31, "timestamp": "05:16:10", "text": "。 届きましたか？ うん。 うん。"}, {"type": "subtitle", "time": 18971.55, "timestamp": "05:16:11", "text": "それはかなり"}, {"type": "subtitle", "time": 18974.39, "timestamp": "05:16:14", "text": "奇妙だ。 あまり真っ直ぐではないですね。"}, {"type": "subtitle", "time": 18976.628, "timestamp": "05:16:16", "text": "私が切った木が、まるで"}, {"type": "subtitle", "time": 18986.39, "timestamp": "05:16:26", "text": "船を操縦して見てみよう"}, {"type": "subtitle", "time": 18988.27, "timestamp": "05:16:28", "text": "。   わかった"}, {"type": "subtitle", "time": 18991.99, "timestamp": "05:16:31", "text": "。 置いていかないでください。"}, {"type": "subtitle", "time": 18995.59, "timestamp": "05:16:35", "text": "クエスト完了の報酬などもちゃんと受け取れていますか"}, {"type": "subtitle", "time": 18998.07, "timestamp": "05:16:38", "text": "？ それはあなたにとって何かメリットがありますか？"}, {"type": "subtitle", "time": 19000.708, "timestamp": "05:16:40", "text": "うん。 メロンヘルメットフリック"}, {"type": "subtitle", "time": 19003.43, "timestamp": "05:16:43", "text": "探索ポイント３を褒賞します。 えっと、それは"}, {"type": "subtitle", "time": 19010.07, "timestamp": "05:16:50", "text": "後でやろうと思います。私が見た限りでは、私が"}, {"type": "subtitle", "time": 19018.15, "timestamp": "05:16:58", "text": "自分のサーバーで何かをすると、それはあなたのサーバーにもカウントされるからです。 ええ、そうですね。"}]
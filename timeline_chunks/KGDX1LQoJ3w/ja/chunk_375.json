[{"type": "subtitle", "time": 22510.75, "timestamp": "06:15:10", "text": "ジンダーが"}, {"type": "subtitle", "time": 22513.83, "timestamp": "06:15:13", "text": "戻ってきたらどうなるかは分からないけど、こういうドラマが"}, {"type": "subtitle", "time": 22515.99, "timestamp": "06:15:15", "text": "起こると、なぜ"}, {"type": "subtitle", "time": 22518.548, "timestamp": "06:15:18", "text": "深く考えすぎてしまうのか分からないけど、"}, {"type": "subtitle", "time": 22522.548, "timestamp": "06:15:22", "text": "時々、彼らの視点から見てみようとする。"}, {"type": "subtitle", "time": 22524.708, "timestamp": "06:15:24", "text": "もし自分が彼らの立場だったら、"}, {"type": "subtitle", "time": 22527.19, "timestamp": "06:15:27", "text": "どう対処するだろうか、と。 どう"}, {"type": "subtitle", "time": 22529.948, "timestamp": "06:15:29", "text": "受け止めたらいいの？ わからない。"}, {"type": "subtitle", "time": 22532.67, "timestamp": "06:15:32", "text": "馬鹿げている。 でも、"}, {"type": "subtitle", "time": 22535.43, "timestamp": "06:15:35", "text": "結局泣いちゃうんだよね。 しかし、公にする"}, {"type": "subtitle", "time": 22540.23, "timestamp": "06:15:40", "text": "よりも、個人的に解決しようと試みるだろうと思います"}]
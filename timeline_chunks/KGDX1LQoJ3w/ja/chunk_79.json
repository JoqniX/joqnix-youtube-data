[{"type": "subtitle", "time": 4785.669, "timestamp": "01:19:45", "text": "でも３、４日間はすごく"}, {"type": "subtitle", "time": 4787.229, "timestamp": "01:19:47", "text": "落ち込んでたんだよ、"}, {"type": "subtitle", "time": 4790.709, "timestamp": "01:19:50", "text": "兄弟。 落ち込んではいない。 このコラボ企画、うまくいってるね"}, {"type": "subtitle", "time": 4792.87, "timestamp": "01:19:52", "text": "。 いや、いや。 この日から事態は"}, {"type": "subtitle", "time": 4794.669, "timestamp": "01:19:54", "text": "悪化し始めた。"}, {"type": "subtitle", "time": 4798.75, "timestamp": "01:19:58", "text": "うん。 ええと、ここは"}]
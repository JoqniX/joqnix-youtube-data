[{"type": "subtitle", "time": 19146.628, "timestamp": "05:19:06", "text": "ええ、特定のミッションを完了するためのものです"}, {"type": "subtitle", "time": 19161.75, "timestamp": "05:19:21", "text": "。 ごめんなさい。"}, {"type": "subtitle", "time": 19163.39, "timestamp": "05:19:23", "text": "停電がありましたが、ちょうど"}, {"type": "subtitle", "time": 19171.31, "timestamp": "05:19:31", "text": "今頃復旧しました。 ということで、コメントしてください。"}, {"type": "subtitle", "time": 19175.47, "timestamp": "05:19:35", "text": "でも、午後"}, {"type": "subtitle", "time": 19178.19, "timestamp": "05:19:38", "text": "12時になります。   ということで"}, {"type": "subtitle", "time": 19182.59, "timestamp": "05:19:42", "text": "、おそらく新しい"}, {"type": "subtitle", "time": 19186.23, "timestamp": "05:19:46", "text": "配信、夜の配信を始めると思います。 そうします"}, {"type": "subtitle", "time": 19189.23, "timestamp": "05:19:49", "text": "。 友達と遊ぶよ。"}, {"type": "subtitle", "time": 19193.35, "timestamp": "05:19:53", "text": "えっと、毎日ぶらぶらしたり、いろいろやったりします。"}, {"type": "subtitle", "time": 19197.59, "timestamp": "05:19:57", "text": "あと、マインクラフトとか、もっとテストとか"}]
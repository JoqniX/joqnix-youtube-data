[{"type": "subtitle", "time": 17105.19, "timestamp": "04:45:05", "text": "何だって？ 彼は蚊を"}, {"type": "subtitle", "time": 17108.31, "timestamp": "04:45:08", "text": "鳴らす騎士か何かになったんだよね"}, {"type": "subtitle", "time": 17110.47, "timestamp": "04:45:10", "text": "？ あれは"}, {"type": "subtitle", "time": 17121.59, "timestamp": "04:45:21", "text": "うん、遅いね。"}, {"type": "subtitle", "time": 17142.39, "timestamp": "04:45:42", "text": "おお、これはすごい。 これが"}, {"type": "subtitle", "time": 17146.55, "timestamp": "04:45:46", "text": "ゲーム内での我々の武器になるのでしょうか？ おお。"}, {"type": "subtitle", "time": 17149.03, "timestamp": "04:45:49", "text": "おそらく。"}, {"type": "subtitle", "time": 17150.51, "timestamp": "04:45:50", "text": "よくやった"}]
[{"type": "subtitle", "time": 6815.27, "timestamp": "01:53:35", "text": "[音楽]"}, {"type": "subtitle", "time": 6817.75, "timestamp": "01:53:37", "text": "あなたは仕事を終わらせるために来た。"}, {"type": "subtitle", "time": 6819.31, "timestamp": "01:53:39", "text": "あなたを"}, {"type": "subtitle", "time": 6821.87, "timestamp": "01:53:41", "text": "別人と間違えていました。 私は"}, {"type": "subtitle", "time": 6825.709, "timestamp": "01:53:45", "text": "ランドスケープです。 見てみてください。 あなたは"}, {"type": "subtitle", "time": 6832.709, "timestamp": "01:53:52", "text": "目を凝らす。 私たちの世界観の外にある目、"}, {"type": "subtitle", "time": 6836.27, "timestamp": "01:53:56", "text": "そして治療を受け入れる別の誰かの目"}]
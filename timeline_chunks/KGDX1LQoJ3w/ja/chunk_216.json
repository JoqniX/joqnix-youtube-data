[{"type": "subtitle", "time": 12971.03, "timestamp": "03:36:11", "text": "初めてのようにどう聞けばいいですか？"}, {"type": "subtitle", "time": 12987.59, "timestamp": "03:36:27", "text": "聞いてみます。気にしないでください。"}, {"type": "subtitle", "time": 12999.83, "timestamp": "03:36:39", "text": "私もです。VR が必要です。"}, {"type": "subtitle", "time": 13002.03, "timestamp": "03:36:42", "text": "はい。だから、気にしないでください。"}, {"type": "subtitle", "time": 13009.59, "timestamp": "03:36:49", "text": "ルールもわかりません。何が"}, {"type": "subtitle", "time": 13012.429, "timestamp": "03:36:52", "text": "スコアになるのかもわかりません。 何がカウントされるのか、"}, {"type": "subtitle", "time": 13015.19, "timestamp": "03:36:55", "text": "ええ、わかりません。だから、ええ、"}, {"type": "subtitle", "time": 13018.469, "timestamp": "03:36:58", "text": "見ているとちょっと混乱しますが、"}]
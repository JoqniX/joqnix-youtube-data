[{"type": "subtitle", "time": 22081.03, "timestamp": "06:08:01", "text": "私が参加した時、"}, {"type": "subtitle", "time": 22083.27, "timestamp": "06:08:03", "text": "外国人は私だけだったと思います。いや、"}, {"type": "subtitle", "time": 22085.83, "timestamp": "06:08:05", "text": "他に2人いました。YouTuberと外国人です。"}, {"type": "subtitle", "time": 22088.07, "timestamp": "06:08:08", "text": "私が"}, {"type": "subtitle", "time": 22090.07, "timestamp": "06:08:10", "text": "彼らのコミュニティで活動していたので、外国人は私だけでした。だから、"}, {"type": "subtitle", "time": 22092.15, "timestamp": "06:08:12", "text": "彼らは私を受け入れてくれるだろうと思って、実際受け入れてくれました"}, {"type": "subtitle", "time": 22094.708, "timestamp": "06:08:14", "text": "。でも、私はたくさんの"}, {"type": "subtitle", "time": 22097.35, "timestamp": "06:08:17", "text": "ストリーマーサーバーなどに参加していたので、たくさんの通知が来ていました。それで、サーバーをミュートにしていたので、通知が来ていることに"}, {"type": "subtitle", "time": 22102.708, "timestamp": "06:08:22", "text": "気づきませんでした"}, {"type": "subtitle", "time": 22105.43, "timestamp": "06:08:25", "text": "。それで、たくさんの通知を見逃してしまい、"}, {"type": "subtitle", "time": 22111.43, "timestamp": "06:08:31", "text": "真剣に取り組んでいないという理由でキックされてしまいました。それで、なぜ"}, {"type": "subtitle", "time": 22113.91, "timestamp": "06:08:33", "text": "サーバーにいなくなったのかと聞いたら、彼女は"}, {"type": "subtitle", "time": 22116.07, "timestamp": "06:08:36", "text": "「ええ、私たちは たくさんpingを送っていたのに、"}, {"type": "subtitle", "time": 22119.59, "timestamp": "06:08:39", "text": "サーバーにいなくて"}, {"type": "subtitle", "time": 22121.43, "timestamp": "06:08:41", "text": "pingやメッセージに反応したり、"}, {"type": "subtitle", "time": 22128.628, "timestamp": "06:08:48", "text": "私たちが与えた日々の活動やタスク、目標などを何もしていませんでした。 だから、"}, {"type": "subtitle", "time": 22130.788, "timestamp": "06:08:50", "text": "あなたは全く真剣ではないように感じました。それに、"}, {"type": "subtitle", "time": 22133.35, "timestamp": "06:08:53", "text": "私たちは既に真剣な考えを持つ"}]
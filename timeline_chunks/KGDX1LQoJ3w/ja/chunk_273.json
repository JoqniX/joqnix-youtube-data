[{"type": "subtitle", "time": 16387.31, "timestamp": "04:33:07", "text": "おお。"}, {"type": "subtitle", "time": 16400.39, "timestamp": "04:33:20", "text": "[音楽]"}, {"type": "subtitle", "time": 16402.709, "timestamp": "04:33:22", "text": "このゲームはいいよ、兄弟。 男性の場合はどうでしょうか？"}, {"type": "subtitle", "time": 16404.03, "timestamp": "04:33:24", "text": "男性向けの"}, {"type": "subtitle", "time": 16415.429, "timestamp": "04:33:35", "text": "関連。 かっこいい男のやつもあるよ"}, {"type": "subtitle", "time": 16424.551, "timestamp": "04:33:44", "text": "。 これは史上最高のゲームでしょうか？"}, {"type": "subtitle", "time": 16427.629, "timestamp": "04:33:47", "text": "アニメに出てくるような男の子向けの"}, {"type": "subtitle", "time": 16437.47, "timestamp": "04:33:57", "text": "。 ああ、これだ"}]
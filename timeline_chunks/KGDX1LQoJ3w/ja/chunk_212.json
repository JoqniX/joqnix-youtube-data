[{"type": "subtitle", "time": 12731.269, "timestamp": "03:32:11", "text": "プロのこれの文脈を本当に知りたいのですが、そうすべきかどうかわかりません"}, {"type": "subtitle", "time": 12734.07, "timestamp": "03:32:14", "text": "。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 12736.15, "timestamp": "03:32:16", "text": "問題は、"}, {"type": "subtitle", "time": 12740.469, "timestamp": "03:32:20", "text": "グループのDiscordサーバーに参加したい場合、"}, {"type": "subtitle", "time": 12743.87, "timestamp": "03:32:23", "text": "Discord Nitroを購入しなければならないことです。なぜなら、"}, {"type": "subtitle", "time": 12747.11, "timestamp": "03:32:27", "text": "200以上のサーバーに参加しているからです。いや、"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "100以上のサーバーです。つまり、"}, {"type": "subtitle", "time": 12754.309, "timestamp": "03:32:34", "text": "サーバーに参加するには100のサーバーから退出する必要があります。"}, {"type": "subtitle", "time": 12756.63, "timestamp": "03:32:36", "text": "だから、ちょっと面倒です。私のことを悪く言わないでください。"}, {"type": "subtitle", "time": 12772.99, "timestamp": "03:32:52", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14346.55, "timestamp": "03:59:06", "text": "[音楽] から稼ぐかということです。"}, {"type": "subtitle", "time": 14349.349, "timestamp": "03:59:09", "text": "一部の人はそれに対して失礼かもしれません。 よし、"}, {"type": "subtitle", "time": 14355.46, "timestamp": "03:59:15", "text": "もう一度男の子たち[音楽]を交代しよう。 私は"}, {"type": "subtitle", "time": 14358.11, "timestamp": "03:59:18", "text": "[音楽]"}, {"type": "subtitle", "time": 14365.83, "timestamp": "03:59:25", "text": "私が話せると思いますか？"}, {"type": "subtitle", "time": 14370.59, "timestamp": "03:59:30", "text": "入り口付近に陣取って、誰かと少し話せるかもしれませんね"}, {"type": "subtitle", "time": 14373.28, "timestamp": "03:59:33", "text": "。 わかりました、試してみます。"}, {"type": "subtitle", "time": 14375.71, "timestamp": "03:59:35", "text": "【音楽】"}, {"type": "subtitle", "time": 14384.429, "timestamp": "03:59:44", "text": "ああ、すごくおしっこがしたい"}, {"type": "subtitle", "time": 14388.18, "timestamp": "03:59:48", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 14390.91, "timestamp": "03:59:50", "text": "[音楽] ええと、"}, {"type": "subtitle", "time": 14393.67, "timestamp": "03:59:53", "text": "今日のゴー、"}]
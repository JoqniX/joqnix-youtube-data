[{"type": "subtitle", "time": 21487.23, "timestamp": "05:58:07", "text": "ええと、これを見てください"}, {"type": "subtitle", "time": 21493.628, "timestamp": "05:58:13", "text": "12. こんにちは。"}, {"type": "subtitle", "time": 21495.67, "timestamp": "05:58:15", "text": "いらっしゃいませ。 そうそう。 次は"}, {"type": "subtitle", "time": 21496.75, "timestamp": "05:58:16", "text": "2回目のショーを作らなければならない"}, {"type": "subtitle", "time": 21501.19, "timestamp": "05:58:21", "text": "。 私は寝坊した。"}, {"type": "subtitle", "time": 21503.548, "timestamp": "05:58:23", "text": "おお。"}, {"type": "subtitle", "time": 21506.99, "timestamp": "05:58:26", "text": "ああ、"}, {"type": "subtitle", "time": 21511.91, "timestamp": "05:58:31", "text": "今夜は眠れるといいな。 私は昨晩寝ました。 ああ、"}, {"type": "subtitle", "time": 21521.11, "timestamp": "05:58:41", "text": "メッセージが届いていたので、対応しなければなりませんでした。 あなたは一晩中"}, {"type": "subtitle", "time": 21525.23, "timestamp": "05:58:45", "text": "メッセージを聞いていた。 うん。 ええ、考えを"}, {"type": "subtitle", "time": 21530.15, "timestamp": "05:58:50", "text": "巡らせて、思慮深く、"}, {"type": "subtitle", "time": 21532.31, "timestamp": "05:58:52", "text": "プロフェッショナルな"}, {"type": "subtitle", "time": 21535.59, "timestamp": "05:58:55", "text": "メッセージを作り上げていました。 何てことだ。"}, {"type": "subtitle", "time": 21539.91, "timestamp": "05:58:59", "text": "そして、それは結局、下り坂になってしまった。   どうやら"}]
[{"type": "subtitle", "time": 22688.31, "timestamp": "06:18:08", "text": "寝てしまったけど、ああ、もし"}, {"type": "subtitle", "time": 22690.23, "timestamp": "06:18:10", "text": "これをしていなかったら、"}, {"type": "subtitle", "time": 22692.948, "timestamp": "06:18:12", "text": "ぐっすり眠れたのに、と思った。 私は夜中に目が覚める。"}, {"type": "subtitle", "time": 22704.51, "timestamp": "06:18:24", "text": "いいものになることを願っています。"}, {"type": "subtitle", "time": 22717.19, "timestamp": "06:18:37", "text": "。 君たち二人は一人で寝ているんだね。"}, {"type": "subtitle", "time": 22719.91, "timestamp": "06:18:39", "text": "なぜ？ ニース。"}, {"type": "subtitle", "time": 22723.31, "timestamp": "06:18:43", "text": "待って、あなたたち二人とも"}]
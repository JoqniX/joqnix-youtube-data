[{"type": "subtitle", "time": 21603.43, "timestamp": "06:00:03", "text": "彼女はすべての"}, {"type": "subtitle", "time": 21606.31, "timestamp": "06:00:06", "text": "日本のユーチューバーを代表して謝罪し、そう、この"}, {"type": "subtitle", "time": 21621.23, "timestamp": "06:00:21", "text": "H。それは私の夢の"}, {"type": "subtitle", "time": 21624.35, "timestamp": "06:00:24", "text": "コラボでした。"}, {"type": "subtitle", "time": 21627.59, "timestamp": "06:00:27", "text": "最悪だよ。 もっと深い問題だと思っていた。 もっと"}, {"type": "subtitle", "time": 21629.59, "timestamp": "06:00:29", "text": "深い意味があるように感じた。 今でも、もっと"}, {"type": "subtitle", "time": 21632.39, "timestamp": "06:00:32", "text": "深いところまで来ているような気がするけれど、あまり心を"}]
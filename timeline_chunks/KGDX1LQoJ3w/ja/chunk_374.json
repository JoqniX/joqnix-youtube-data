[{"type": "subtitle", "time": 22440.39, "timestamp": "06:14:00", "text": "彼女自身の個人的なアーティストにしたりしました。つまり、"}, {"type": "subtitle", "time": 22442.708, "timestamp": "06:14:02", "text": "相互契約を結んで、"}, {"type": "subtitle", "time": 22445.548, "timestamp": "06:14:05", "text": "私の"}, {"type": "subtitle", "time": 22448.788, "timestamp": "06:14:08", "text": "独占アーティストになる、といった契約です。そのため、"}, {"type": "subtitle", "time": 22451.51, "timestamp": "06:14:11", "text": "アーティストは、彼女の親しい友人である"}, {"type": "subtitle", "time": 22458.15, "timestamp": "06:14:18", "text": "他のYouTuberなどとプロジェクトを行うことができなくなりました。そして、ある意味で、それは"}, {"type": "subtitle", "time": 22466.47, "timestamp": "06:14:26", "text": "悪いことになりました。"}, {"type": "subtitle", "time": 22469.19, "timestamp": "06:14:29", "text": "アーティストがGoogle"}, {"type": "subtitle", "time": 22472.628, "timestamp": "06:14:32", "text": "ドキュメントでそれを公表し、そこからすべてが"}, {"type": "subtitle", "time": 22475.75, "timestamp": "06:14:35", "text": "爆発し始めました。最終的に、その"}, {"type": "subtitle", "time": 22479.43, "timestamp": "06:14:39", "text": "人は謝罪しませんでしたが、"}, {"type": "subtitle", "time": 22485.11, "timestamp": "06:14:45", "text": "マネージャーのせいにしました。なぜなら、マネージャーが"}, {"type": "subtitle", "time": 22486.948, "timestamp": "06:14:46", "text": "すべてを話していたからです"}, {"type": "subtitle", "time": 22490.548, "timestamp": "06:14:50", "text": "。 でも、ある意味では彼女も"}, {"type": "subtitle", "time": 22493.91, "timestamp": "06:14:53", "text": "このことを知っていて、"}, {"type": "subtitle", "time": 22497.43, "timestamp": "06:14:57", "text": "アーティストたちに「アートはやらないで、"}, {"type": "subtitle", "time": 22499.59, "timestamp": "06:14:59", "text": "他のユーチューバーとのプロジェクトも断って」と言ったりもした。そういうわけで、"}]
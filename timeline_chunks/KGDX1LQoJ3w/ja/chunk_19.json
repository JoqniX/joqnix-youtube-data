[{"type": "subtitle", "time": 1141.59, "timestamp": "00:19:01", "text": "本来16まで動作していましたが、"}, {"type": "subtitle", "time": 1144.549, "timestamp": "00:19:04", "text": "接続を解除したため、"}, {"type": "subtitle", "time": 1151.19, "timestamp": "00:19:11", "text": "マルチバーからのリアルタイムのフィードバックを受信しませんでした。 ええと、それでも時間はカウントされていました。"}, {"type": "subtitle", "time": 1156.71, "timestamp": "00:19:16", "text": "どうやら YouTube は、"}, {"type": "subtitle", "time": 1166.83, "timestamp": "00:19:26", "text": "ライブ ストリームの 20 時間制限、つまり 20 時間に達すると、ストリームを"}, {"type": "subtitle", "time": 1169.99, "timestamp": "00:19:29", "text": "切断したかどうかに関係なく、たとえ"}, {"type": "subtitle", "time": 1175.99, "timestamp": "00:19:35", "text": "1 時間だけストリームして、"}, {"type": "subtitle", "time": 1178.47, "timestamp": "00:19:38", "text": "バッファリング状態などのアイドル状態を"}, {"type": "subtitle", "time": 1181.51, "timestamp": "00:19:41", "text": "24 時間維持したとしても、権利を"}, {"type": "subtitle", "time": 1183.95, "timestamp": "00:19:43", "text": "失うようにしているようです"}, {"type": "subtitle", "time": 1187.27, "timestamp": "00:19:47", "text": "。 いいえ、これは紛れもない事実です。"}, {"type": "subtitle", "time": 1190.029, "timestamp": "00:19:50", "text": "いいえ、昨日の配信は、それが実際にどういうものかをテストするための"}, {"type": "subtitle", "time": 1194.43, "timestamp": "00:19:54", "text": "実際のテストでした"}, {"type": "subtitle", "time": 1198.19, "timestamp": "00:19:58", "text": "。"}]
[{"type": "subtitle", "time": 12480.68, "timestamp": "03:28:00", "text": "ええ。 それで、あなたの"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "彼女が話してくれたことが嬉しいです 彼女が"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "私に話しかけてきたんです。私が彼女のことを話していたら、本当に"}, {"type": "subtitle", "time": 12518.51, "timestamp": "03:28:38", "text": "予想外でした。彼女はすごくクールで、外向的なので、"}, {"type": "subtitle", "time": 12524.15, "timestamp": "03:28:44", "text": "話しかけにくい人だと思っていました。ああ"}, {"type": "subtitle", "time": 12533.99, "timestamp": "03:28:53", "text": "、武器。そう、射撃。"}, {"type": "subtitle", "time": 12537.349, "timestamp": "03:28:57", "text": "そして予想外にも、彼女が私に近づいてきて、"}]
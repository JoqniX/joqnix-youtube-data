[{"type": "subtitle", "time": 12366.269, "timestamp": "03:26:06", "text": "スペイン語韓国"}, {"type": "subtitle", "time": 12368.03, "timestamp": "03:26:08", "text": "ABC"}, {"type": "subtitle", "time": 12371.269, "timestamp": "03:26:11", "text": "韓国を試しました。私はそれをしました"}, {"type": "subtitle", "time": 12376.229, "timestamp": "03:26:16", "text": "。でもゴールデン"}, {"type": "subtitle", "time": 12378.71, "timestamp": "03:26:18", "text": "ストロベリーは修正できません。"}, {"type": "subtitle", "time": 12382.07, "timestamp": "03:26:22", "text": "それは難しすぎます。"}, {"type": "subtitle", "time": 12384.03, "timestamp": "03:26:24", "text": "ゴールデン"}, {"type": "subtitle", "time": 12418.269, "timestamp": "03:26:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1501.19, "timestamp": "00:25:01", "text": "面白い。 またくしゃみが出てきた。 私が"}, {"type": "subtitle", "time": 1506.75, "timestamp": "00:25:06", "text": "エアコンをつけると、いつも同じなのはなぜですか"}, {"type": "subtitle", "time": 1511.47, "timestamp": "00:25:11", "text": "？ なぜ"}, {"type": "subtitle", "time": 1516.59, "timestamp": "00:25:16", "text": "5人までならこんなに似ているのでしょうか？ なぜ、"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "焼き加減が不十分な人々は、"}, {"type": "subtitle", "time": 1523.51, "timestamp": "00:25:23", "text": "隣人や妻に対して常に被害妄想を抱いているゲームほど面白くないのでしょうか。"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "隣人と駆け落ちしたあなたの妻は、"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "おそらく"}, {"type": "subtitle", "time": 1530.909, "timestamp": "00:25:30", "text": "あなたをスパイするために銃を所持していて、その後は止めるでしょう。"}, {"type": "subtitle", "time": 1539.43, "timestamp": "00:25:39", "text": "彼のもとを去ったのですか？ 彼は仕事もお金もなく、"}]
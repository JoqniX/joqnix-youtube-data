[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "銃とか全部持ってるの？"}, {"type": "subtitle", "time": 17946.47, "timestamp": "04:59:06", "text": "いや、船で戻ってきた時に失くしたんだ。ほら、"}, {"type": "subtitle", "time": 17951.868, "timestamp": "04:59:11", "text": "船に向かってまっすぐ進んでいた時にね。"}, {"type": "subtitle", "time": 17955.51, "timestamp": "04:59:15", "text": "ああ、音声チャットや会話ができるんですね。 おお。   わかった"}, {"type": "subtitle", "time": 17956.948, "timestamp": "04:59:16", "text": "。 待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 17960.23, "timestamp": "04:59:20", "text": "待って、待って、待って。 交換できます。 私は自分の"}, {"type": "subtitle", "time": 17963.59, "timestamp": "04:59:23", "text": "持ち物を持っています。 私は自分の"}, {"type": "subtitle", "time": 17967.67, "timestamp": "04:59:27", "text": "ゲームからアイテムを入手しました。 一体どういうことだ？ うわぁ。"}, {"type": "subtitle", "time": 17969.67, "timestamp": "04:59:29", "text": "ああ、斧は持ってるよ。"}, {"type": "subtitle", "time": 17971.11, "timestamp": "04:59:31", "text": "食料は全て揃っています。 私は松を持っています。 私は"}, {"type": "subtitle", "time": 17973.948, "timestamp": "04:59:33", "text": "全てを持っている。 一体どういうことだ？"}, {"type": "subtitle", "time": 17978.55, "timestamp": "04:59:38", "text": "えっと、あなたをどんな仕事"}, {"type": "subtitle", "time": 17981.51, "timestamp": "04:59:41", "text": "に昇進させられるんですか？"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "ない。"}, {"type": "subtitle", "time": 17993.35, "timestamp": "04:59:53", "text": "ええと、複数の設定でトータルセットを再生してください"}, {"type": "subtitle", "time": 17994.948, "timestamp": "04:59:54", "text": "。"}, {"type": "subtitle", "time": 17997.99, "timestamp": "04:59:57", "text": "これは一体何ですか？ 市民市長とかがいるんだよ"}]
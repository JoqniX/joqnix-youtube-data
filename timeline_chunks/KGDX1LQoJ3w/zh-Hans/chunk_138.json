[{"type": "subtitle", "time": 8294.99, "timestamp": "02:18:14", "text": "关闭。 嘿，我杀了"}, {"type": "subtitle", "time": 8297.87, "timestamp": "02:18:17", "text": "你。 这个游戏里我可以蹲下吗"}, {"type": "subtitle", "time": 8300.549, "timestamp": "02:18:20", "text": "？ 这个游戏里我不能蹲下吗？ 我"}, {"type": "subtitle", "time": 8307.97, "timestamp": "02:18:27", "text": "像我杀死"}, {"type": "subtitle", "time": 8313.669, "timestamp": "02:18:33", "text": "他们一样[音乐]。 哦，我看到另一个老板。 哦，球"}, {"type": "subtitle", "time": 8324.589, "timestamp": "02:18:44", "text": "走吧。"}, {"type": "subtitle", "time": 8327.15, "timestamp": "02:18:47", "text": "Ara，"}]
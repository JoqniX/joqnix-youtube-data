[{"type": "subtitle", "time": 20403.27, "timestamp": "05:40:03", "text": "嗯，我又开始在各个平台上直播了。"}, {"type": "subtitle", "time": 20406.628, "timestamp": "05:40:06", "text": "所以，我们之前有《我的世界：有限版》。"}, {"type": "subtitle", "time": 20409.15, "timestamp": "05:40:09", "text": "我们还有什么"}, {"type": "subtitle", "time": 20411.75, "timestamp": "05:40:11", "text": "？ 我们还添加了什么？"}, {"type": "subtitle", "time": 20422.75, "timestamp": "05:40:22", "text": "？ 六局结束。"}, {"type": "subtitle", "time": 20425.59, "timestamp": "05:40:25", "text": "好的。 呃，我们演奏了"}, {"type": "subtitle", "time": 20426.91, "timestamp": "05:40:26", "text": "[音乐]"}, {"type": "subtitle", "time": 20428.75, "timestamp": "05:40:28", "text": "呃，"}, {"type": "subtitle", "time": 20432.39, "timestamp": "05:40:32", "text": "好的。 好的。 我想我明白了。"}, {"type": "subtitle", "time": 20434.31, "timestamp": "05:40:34", "text": "汗流浃背的场景。 快点。 快点。 跟"}, {"type": "subtitle", "time": 20443.868, "timestamp": "05:40:43", "text": "一起合作。 呃，接着我"}, {"type": "subtitle", "time": 20448.43, "timestamp": "05:40:48", "text": "播放了一段"}]
[{"type": "subtitle", "time": 22261.51, "timestamp": "06:11:01", "text": "特上那个灰姑娘的闹剧一样。 感觉就像"}, {"type": "subtitle", "time": 22263.948, "timestamp": "06:11:03", "text": "那样，但更像是"}, {"type": "subtitle", "time": 22282.39, "timestamp": "06:11:22", "text": "后来，哦，这有点像我该怎么"}, {"type": "subtitle", "time": 22285.07, "timestamp": "06:11:25", "text": "简短地说呢？ 感觉就像只过了一"}, {"type": "subtitle", "time": 22289.11, "timestamp": "06:11:29", "text": "秒钟。 你好，欢迎来到直播间。"}, {"type": "subtitle", "time": 22292.31, "timestamp": "06:11:32", "text": "还有，嗯，这就像"}, {"type": "subtitle", "time": 22295.83, "timestamp": "06:11:35", "text": "在 V2 戒指领域里竞争非常激烈，而且这种"}, {"type": "subtitle", "time": 22299.11, "timestamp": "06:11:39", "text": "激烈的竞争也延伸到了你"}, {"type": "subtitle", "time": 22302.948, "timestamp": "06:11:42", "text": "最亲密的朋友身上，比如说，"}, {"type": "subtitle", "time": 22305.75, "timestamp": "06:11:45", "text": "你最亲密的朋友也和"}, {"type": "subtitle", "time": 22308.868, "timestamp": "06:11:48", "text": "你一样与某个艺术家合作，你们都有"}, {"type": "subtitle", "time": 22311.51, "timestamp": "06:11:51", "text": "共同的艺术家等等。 所以她做的就是"}, {"type": "subtitle", "time": 22315.19, "timestamp": "06:11:55", "text": "请艺术家画一个……该"}, {"type": "subtitle", "time": 22317.23, "timestamp": "06:11:57", "text": "怎么称呼它呢？"}]
[{"type": "subtitle", "time": 1501.19, "timestamp": "00:25:01", "text": "有意思。 我又打喷嚏了。"}, {"type": "subtitle", "time": 1506.75, "timestamp": "00:25:06", "text": "每次我打开空调，为什么情况都"}, {"type": "subtitle", "time": 1511.47, "timestamp": "00:25:11", "text": "一样？ 为什么"}, {"type": "subtitle", "time": 1516.59, "timestamp": "00:25:16", "text": "五个人看起来都这么相似？ 为什么性格"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "不成熟的人不如一款"}, {"type": "subtitle", "time": 1521.269, "timestamp": "00:25:21", "text": "游戏有趣，这款游戏讲述的是他们不断地"}, {"type": "subtitle", "time": 1523.51, "timestamp": "00:25:23", "text": "对你的邻居和妻子抱有偏执的想法。 你"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "妻子因为被邻居写信而离开你，"}, {"type": "subtitle", "time": 1528.23, "timestamp": "00:25:28", "text": "而且可能还携带了更多武器来"}, {"type": "subtitle", "time": 1530.909, "timestamp": "00:25:30", "text": "监视你，然后就停止了。"}, {"type": "subtitle", "time": 1539.43, "timestamp": "00:25:39", "text": "他？ 因为他没有工作，没有钱，所以"}]
[{"type": "subtitle", "time": 11400.23, "timestamp": "03:10:00", "text": "大家都在议论纷纷。 我没有"}, {"type": "subtitle", "time": 11402.83, "timestamp": "03:10:02", "text": "朋友。"}, {"type": "subtitle", "time": 11407.83, "timestamp": "03:10:07", "text": "我的电池"}, {"type": "subtitle", "time": 11409.99, "timestamp": "03:10:09", "text": "又一次播放到一半就没电了。 我发誓那声音就像哔哔声一样。"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "我的一个身体追踪器断开了连接，"}, {"type": "subtitle", "time": 11415.67, "timestamp": "03:10:15", "text": "然后我就想，"}, {"type": "subtitle", "time": 11431.95, "timestamp": "03:10:31", "text": "内裤"}, {"type": "subtitle", "time": 11449.51, "timestamp": "03:10:49", "text": "我当时在这个小组里，对吧？我就"}, {"type": "subtitle", "time": 11453.6, "timestamp": "03:10:53", "text": "站在那儿，真好，你混在一起。"}, {"type": "subtitle", "time": 11455.269, "timestamp": "03:10:55", "text": "[音乐]"}, {"type": "subtitle", "time": 11457.11, "timestamp": "03:10:57", "text": "天哪，"}]
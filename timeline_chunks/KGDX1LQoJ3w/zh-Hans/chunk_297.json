[{"type": "subtitle", "time": 17825.91, "timestamp": "04:57:05", "text": "我喜欢我的树底部滴水的时候"}, {"type": "subtitle", "time": 17831.07, "timestamp": "04:57:11", "text": "继续往下看，"}, {"type": "subtitle", "time": 17835.23, "timestamp": "04:57:15", "text": "哦，它会给你一个W之"}, {"type": "subtitle", "time": 17837.708, "timestamp": "04:57:17", "text": "类的。 这很"}, {"type": "subtitle", "time": 17842.788, "timestamp": "04:57:22", "text": "有意思。 但我该如何进行合作呢？"}, {"type": "subtitle", "time": 17845.51, "timestamp": "04:57:25", "text": "我的版本也是如此。 感觉"}, {"type": "subtitle", "time": 17848.31, "timestamp": "04:57:28", "text": "我们就像……我们该如何合作？ 啊，现在我们"}, {"type": "subtitle", "time": 17850.47, "timestamp": "04:57:30", "text": "可以邀请一位朋友了。 设置"}, {"type": "subtitle", "time": 17852.788, "timestamp": "04:57:32", "text": "多人游戏模式。"}, {"type": "subtitle", "time": 17854.628, "timestamp": "04:57:34", "text": "好的。 我需要完成类似"}, {"type": "subtitle", "time": 17856.23, "timestamp": "04:57:36", "text": "任务之类的东西吗？"}, {"type": "subtitle", "time": 17858.47, "timestamp": "04:57:38", "text": "不，不，不，不。 我可以帮你设置。 我"}, {"type": "subtitle", "time": 17862.628, "timestamp": "04:57:42", "text": "认为，一旦本地主机安全，它"}, {"type": "subtitle", "time": 17864.628, "timestamp": "04:57:44", "text": "就会关闭。 所以，我们暂时先用本地"}, {"type": "subtitle", "time": 17868.67, "timestamp": "04:57:48", "text": "主机。 我来主持。 首轮"}, {"type": "subtitle", "time": 17874.628, "timestamp": "04:57:54", "text": "公开赛通行证的玩家人数上限为三人。"}, {"type": "subtitle", "time": 17877.55, "timestamp": "04:57:57", "text": "可以凑成三个吧？"}]
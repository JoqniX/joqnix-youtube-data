[{"type": "subtitle", "time": 12480.67, "timestamp": "03:28:00", "text": "。"}, {"type": "subtitle", "time": 12495.07, "timestamp": "03:28:15", "text": "做了你的"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "我很高兴她和我说话"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "。我当时正在谈论她，这"}, {"type": "subtitle", "time": 12516.349, "timestamp": "03:28:36", "text": "太"}, {"type": "subtitle", "time": 12518.51, "timestamp": "03:28:38", "text": "出乎意料了。"}, {"type": "subtitle", "time": 12521.51, "timestamp": "03:28:41", "text": "就像我以为她就像那样"}, {"type": "subtitle", "time": 12524.15, "timestamp": "03:28:44", "text": "很难接近她，因为她太酷了，而且很"}, {"type": "subtitle", "time": 12528.79, "timestamp": "03:28:48", "text": "外向，就像……"}, {"type": "subtitle", "time": 12533.99, "timestamp": "03:28:53", "text": "哦，武器。对。还有射击。"}, {"type": "subtitle", "time": 12537.349, "timestamp": "03:28:57", "text": "没想到，她就走过来"}]
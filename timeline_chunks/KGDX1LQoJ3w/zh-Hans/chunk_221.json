[{"type": "subtitle", "time": 13262.55, "timestamp": "03:41:02", "text": "，Ranger。 欢迎。"}, {"type": "subtitle", "time": 13264.309, "timestamp": "03:41:04", "text": "这个任务挺有意思的。 我想入手"}, {"type": "subtitle", "time": 13272.63, "timestamp": "03:41:12", "text": "看看我该怎么完成我的工作。"}, {"type": "subtitle", "time": 13274.95, "timestamp": "03:41:14", "text": "她要走了。 我知道。"}, {"type": "subtitle", "time": 13278.469, "timestamp": "03:41:18", "text": "不过我还是想问一下。 我想问一下。 我不想"}, {"type": "subtitle", "time": 13287.389, "timestamp": "03:41:27", "text": "。 看到这一幕真是太搞笑了"}, {"type": "subtitle", "time": 13292.229, "timestamp": "03:41:32", "text": "。 哦，你错过了。 你错过了"}, {"type": "subtitle", "time": 13294.389, "timestamp": "03:41:34", "text": "我当时惊慌失措的那部分。 活动进行到"}, {"type": "subtitle", "time": 13296.95, "timestamp": "03:41:36", "text": "自我介绍环节时，我一直在哭。"}, {"type": "subtitle", "time": 13300.469, "timestamp": "03:41:40", "text": "当时我"}, {"type": "subtitle", "time": 13303.51, "timestamp": "03:41:43", "text": "要谈论的是本次"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "活动的主题：如果你"}, {"type": "subtitle", "time": 13309.51, "timestamp": "03:41:49", "text": "成为一名职业运动员，"}, {"type": "subtitle", "time": 13312.55, "timestamp": "03:41:52", "text": "你会选择哪项运动？我说的是"}, {"type": "subtitle", "time": 13314.95, "timestamp": "03:41:54", "text": "电子竞技，我当时慌了，宝贝，我是"}, {"type": "subtitle", "time": 13317.429, "timestamp": "03:41:57", "text": "最后一个说的，因为我太紧张了。"}]
[{"type": "subtitle", "time": 13866.87, "timestamp": "03:51:06", "text": "我该去哪里？"}, {"type": "subtitle", "time": 13869.99, "timestamp": "03:51:09", "text": "藤间不错，但如果你没有一个"}, {"type": "subtitle", "time": 13873.51, "timestamp": "03:51:13", "text": "很懂日本的朋友，你就寸步难行了"}, {"type": "subtitle", "time": 13876.229, "timestamp": "03:51:16", "text": "。 不是死了，而是"}, {"type": "subtitle", "time": 13879.11, "timestamp": "03:51:19", "text": "大家都完全说起了本禅语。 如果你交了"}, {"type": "subtitle", "time": 13882.95, "timestamp": "03:51:22", "text": "个日本朋友，"}, {"type": "subtitle", "time": 13886.11, "timestamp": "03:51:26", "text": "那就太好了。 否则，就"}, {"type": "subtitle", "time": 13888.87, "timestamp": "03:51:28", "text": "不是了。 但是昨天，当我"}, {"type": "subtitle", "time": 13892.469, "timestamp": "03:51:32", "text": "登录 Via 聊天时，我发现他们"}, {"type": "subtitle", "time": 13895.99, "timestamp": "03:51:35", "text": "离线了。 是啊，他们来了。 我去了"}, {"type": "subtitle", "time": 13897.67, "timestamp": "03:51:37", "text": "梅兰那里，"}, {"type": "subtitle", "time": 13900.67, "timestamp": "03:51:40", "text": "呃，梅尔森就在"}, {"type": "subtitle", "time": 13903.189, "timestamp": "03:51:43", "text": "我之前提到的那个世界里"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "。 这位福建人，我睡前跟他打了个招呼，"}, {"type": "subtitle", "time": 13908.87, "timestamp": "03:51:48", "text": "聊了"}, {"type": "subtitle", "time": 13912.469, "timestamp": "03:51:52", "text": "一会儿，但还是有点"}, {"type": "subtitle", "time": 13915.67, "timestamp": "03:51:55", "text": "尴尬，打断他们的谈话，说“我只是"}]
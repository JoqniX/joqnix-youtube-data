[{"type": "subtitle", "time": 13109.79, "timestamp": "03:38:29", "text": "组里随机[音乐]的人选了类似的"}, {"type": "subtitle", "time": 13113.51, "timestamp": "03:38:33", "text": "东西，因为我们组里有"}, {"type": "subtitle", "time": 13116.71, "timestamp": "03:38:36", "text": "两个人。为什么我的表情是"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "另外两个人打排球。所以，"}, {"type": "subtitle", "time": 13133.51, "timestamp": "03:38:53", "text": "为什么我的眼睛睁不开？等等，我"}, {"type": "subtitle", "time": 13135.67, "timestamp": "03:38:55", "text": "断线了吗？"}, {"type": "subtitle", "time": 13138.86, "timestamp": "03:38:58", "text": "一路飞到洛杉矶就像"}]
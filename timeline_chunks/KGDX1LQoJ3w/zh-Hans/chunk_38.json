[{"type": "subtitle", "time": 2288.069, "timestamp": "00:38:08", "text": "天哪。 啊，莉兹，我也想玩那个游戏。"}, {"type": "subtitle", "time": 2290.39, "timestamp": "00:38:10", "text": "哦，你知道，我很想"}, {"type": "subtitle", "time": 2294.03, "timestamp": "00:38:14", "text": "玩很多游戏，但我"}, {"type": "subtitle", "time": 2299.91, "timestamp": "00:38:19", "text": "目前的电脑配置有限。 我至少可以买个"}, {"type": "subtitle", "time": 2304.15, "timestamp": "00:38:24", "text": "Xbox 主机（比如 Ultimate 之前的版本），然后"}, {"type": "subtitle", "time": 2305.829, "timestamp": "00:38:25", "text": "就能玩到所有这些游戏了。   《"}, {"type": "subtitle", "time": 2307.67, "timestamp": "00:38:27", "text": "星空》刚"}, {"type": "subtitle", "time": 2310.47, "timestamp": "00:38:30", "text": "发售的时候，我就是这么做的。 我买了终极版，"}, {"type": "subtitle", "time": 2314.31, "timestamp": "00:38:34", "text": "然后试着玩了一下。"}, {"type": "subtitle", "time": 2317.91, "timestamp": "00:38:37", "text": "在自动化系统和星域服务器上做了很多农场"}, {"type": "subtitle", "time": 2320.79, "timestamp": "00:38:40", "text": "。 我从来没玩过那款"}, {"type": "subtitle", "time": 2322.03, "timestamp": "00:38:42", "text": "游戏"}, {"type": "subtitle", "time": 2324.03, "timestamp": "00:38:44", "text": "。"}, {"type": "subtitle", "time": 2327.19, "timestamp": "00:38:47", "text": "自从达到最高"}, {"type": "subtitle", "time": 2331.109, "timestamp": "00:38:51", "text": "等级后，我就一直在通过各种手段获取大量"}, {"type": "subtitle", "time": 2332.95, "timestamp": "00:38:52", "text": "金钱和资源，利用复制"}, {"type": "subtitle", "time": 2334.75, "timestamp": "00:38:54", "text": "漏洞等等。"}, {"type": "subtitle", "time": 2336.95, "timestamp": "00:38:56", "text": "[音乐] 是的"}]
[{"type": "subtitle", "time": 4506.59, "timestamp": "01:15:06", "text": "哦，是那首歌吗"}, {"type": "subtitle", "time": 4509.31, "timestamp": "01:15:09", "text": "？呃，叫什么名字来着？ 哦，"}, {"type": "subtitle", "time": 4512.83, "timestamp": "01:15:12", "text": "兄弟。 哦，原来是那个。 所以，她掩盖了"}, {"type": "subtitle", "time": 4519.99, "timestamp": "01:15:19", "text": "兄弟。 她会看那个。 她看了那个。"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "她看过那部动漫奖牌获得者吗？"}, {"type": "subtitle", "time": 4529.669, "timestamp": "01:15:29", "text": "不敢相信她竟然在开场曲里翻唱了那首歌"}, {"type": "subtitle", "time": 4538.709, "timestamp": "01:15:38", "text": "。 对，是南瓜。 她不"}, {"type": "subtitle", "time": 4540.47, "timestamp": "01:15:40", "text": "知道。 所以，当然任何人都会"}, {"type": "subtitle", "time": 4548.709, "timestamp": "01:15:48", "text": "。 我刚才是不是关掉了？ 我的"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "天哪。 哦，等等。 别再关了。"}]
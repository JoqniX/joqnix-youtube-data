[{"type": "subtitle", "time": 21302.47, "timestamp": "05:55:02", "text": "不要再这样做了。 是的。 我希望他们"}, {"type": "subtitle", "time": 21305.59, "timestamp": "05:55:05", "text": "不要那样做。"}, {"type": "subtitle", "time": 21308.868, "timestamp": "05:55:08", "text": "但我没想到"}, {"type": "subtitle", "time": 21315.83, "timestamp": "05:55:15", "text": "你居然会因为这个而咯咯笑。 好的。"}, {"type": "subtitle", "time": 21319.35, "timestamp": "05:55:19", "text": "不，我很少收到这样的评论"}, {"type": "subtitle", "time": 21322.19, "timestamp": "05:55:22", "text": "。 这真是太罕见了。 我当时"}, {"type": "subtitle", "time": 21325.99, "timestamp": "05:55:25", "text": "就想，哎呀，"}, {"type": "subtitle", "time": 21327.83, "timestamp": "05:55:27", "text": "我好像错过了什么。 我好像漏掉了什么。"}, {"type": "subtitle", "time": 21340.948, "timestamp": "05:55:40", "text": "乔看到这条评论咯咯地笑了起来。"}, {"type": "subtitle", "time": 21345.11, "timestamp": "05:55:45", "text": "哦，是那个啊。 我的天啊。"}, {"type": "subtitle", "time": 21350.788, "timestamp": "05:55:50", "text": "我的天啊。 乔。 不，不，我的意思是，你"}, {"type": "subtitle", "time": 21354.15, "timestamp": "05:55:54", "text": "看，现在人们很少会"}, {"type": "subtitle", "time": 21358.39, "timestamp": "05:55:58", "text": "说一些奇怪的话。 不。呃，比利，比利，"}]
[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "你的枪和所有装备都还在吗？"}, {"type": "subtitle", "time": 17946.47, "timestamp": "04:59:06", "text": "不，我是在乘船回来的时候弄丢的"}, {"type": "subtitle", "time": 17948.15, "timestamp": "04:59:08", "text": "，你知道，就是我径直走向"}, {"type": "subtitle", "time": 17951.868, "timestamp": "04:59:11", "text": "船的时候。"}, {"type": "subtitle", "time": 17955.51, "timestamp": "04:59:15", "text": "啊，你可以语音聊天和通话。 哇。"}, {"type": "subtitle", "time": 17956.948, "timestamp": "04:59:16", "text": "好的。 等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 17960.23, "timestamp": "04:59:20", "text": "等等，等等，等等。 我可以交换。 我的"}, {"type": "subtitle", "time": 17963.59, "timestamp": "04:59:23", "text": "物品都在那里。 我的物品都来自我自己的"}, {"type": "subtitle", "time": 17967.67, "timestamp": "04:59:27", "text": "游戏。 搞什么鬼？ 哇。   是的"}, {"type": "subtitle", "time": 17969.67, "timestamp": "04:59:29", "text": "，我带了斧子。"}, {"type": "subtitle", "time": 17971.11, "timestamp": "04:59:31", "text": "食物我都有了。 我有一根松木。 我什么都有了"}, {"type": "subtitle", "time": 17973.948, "timestamp": "04:59:33", "text": "。 搞什么鬼？"}, {"type": "subtitle", "time": 17978.55, "timestamp": "04:59:38", "text": "呃，我可以提拔你"}, {"type": "subtitle", "time": 17981.51, "timestamp": "04:59:41", "text": "做什么？"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "不知道。"}, {"type": "subtitle", "time": 17993.35, "timestamp": "04:59:53", "text": "呃，将整套设备设置为多种"}, {"type": "subtitle", "time": 17994.948, "timestamp": "04:59:54", "text": "设置。"}, {"type": "subtitle", "time": 17997.99, "timestamp": "04:59:57", "text": "这是什么？ 那里有个市民市长"}]
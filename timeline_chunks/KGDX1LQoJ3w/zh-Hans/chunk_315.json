[{"type": "subtitle", "time": 18908.628, "timestamp": "05:15:08", "text": "鸡。 好吧，看来我得再去拿些"}, {"type": "subtitle", "time": 18911.83, "timestamp": "05:15:11", "text": "木棍了。"}, {"type": "subtitle", "time": 18912.868, "timestamp": "05:15:12", "text": "坚持，稍等。"}, {"type": "subtitle", "time": 18915.39, "timestamp": "05:15:15", "text": "那么，我需要做些什么才能集中"}, {"type": "subtitle", "time": 18925.03, "timestamp": "05:15:25", "text": "这是什么蛋？"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "冒险模式下，飞机从任何地方飞来。 领取你的"}, {"type": "subtitle", "time": 18929.07, "timestamp": "05:15:29", "text": "第一"}, {"type": "subtitle", "time": 18937.83, "timestamp": "05:15:37", "text": "船长。 您已获得 10 枚金币"}, {"type": "subtitle", "time": 18941.19, "timestamp": "05:15:41", "text": "和队长称号。"}, {"type": "subtitle", "time": 18944.628, "timestamp": "05:15:44", "text": "哇。 哦，你必须拥有“"}, {"type": "subtitle", "time": 18951.27, "timestamp": "05:15:51", "text": "我的天哪”的一切。 不过，这个游戏真是太复杂了。"}, {"type": "subtitle", "time": 18953.27, "timestamp": "05:15:53", "text": "为什么？"}, {"type": "subtitle", "time": 18955.83, "timestamp": "05:15:55", "text": "这个游戏有点复杂。"}, {"type": "subtitle", "time": 18958.708, "timestamp": "05:15:58", "text": "为什么？ 如何？"}]
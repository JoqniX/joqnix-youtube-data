[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "但人们都在谈论你，你只能躲在"}, {"type": "subtitle", "time": 14285.87, "timestamp": "03:58:05", "text": "后面盯着他们，像一"}, {"type": "subtitle", "time": 14288.79, "timestamp": "03:58:08", "text": "堵墙一样。 你想说话，但却说不"}, {"type": "subtitle", "time": 14291.66, "timestamp": "03:58:11", "text": "出口。"}, {"type": "subtitle", "time": 14305.03, "timestamp": "03:58:25", "text": "[音乐]"}, {"type": "subtitle", "time": 14320.59, "timestamp": "03:58:40", "text": "我想知道如何用"}]
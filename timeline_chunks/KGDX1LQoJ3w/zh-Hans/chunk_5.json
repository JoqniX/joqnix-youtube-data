[{"type": "subtitle", "time": 301.99, "timestamp": "00:05:01", "text": "。 我本应该醒来并结束"}, {"type": "subtitle", "time": 304.23, "timestamp": "00:05:04", "text": "YouTube直播的。   呃，"}, {"type": "subtitle", "time": 307.67, "timestamp": "00:05:07", "text": "这已经是我第二次因为"}, {"type": "subtitle", "time": 313.43, "timestamp": "00:05:13", "text": "自己的"}, {"type": "subtitle", "time": 318.029, "timestamp": "00:05:18", "text": "疏忽或"}, {"type": "subtitle", "time": 321.189, "timestamp": "00:05:21", "text": "其他原因导致整个直播中断了。 唉，"}, {"type": "subtitle", "time": 324.27, "timestamp": "00:05:24", "text": "最近因为一些事，我的精神状态也不太好，真是糟糕透了"}, {"type": "chat", "time": 334.951, "timestamp": "00:05:34", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "it be like that sometimes, you can always expect things to go smoothly"}, {"type": "subtitle", "time": 340.99, "timestamp": "00:05:40", "text": "鲨鱼们。 您好，欢迎光临。 我刚刚看到一条"}, {"type": "subtitle", "time": 343.189, "timestamp": "00:05:43", "text": "评论。 你不能总是期望事情"}, {"type": "subtitle", "time": 345.469, "timestamp": "00:05:45", "text": "大致如此。 嗯，"}, {"type": "chat", "time": 348.316, "timestamp": "00:05:48", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "we live and we learn"}, {"type": "subtitle", "time": 348.39, "timestamp": "00:05:48", "text": "是的，我会更加小心，"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "至少要结束 YouTube 直播，而不是"}, {"type": "subtitle", "time": 352.71, "timestamp": "00:05:52", "text": "停止直播并使其处于"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "缓冲状态。 是像加载之类的吗"}]
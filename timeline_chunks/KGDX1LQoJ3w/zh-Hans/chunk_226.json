[{"type": "subtitle", "time": 13560.07, "timestamp": "03:46:00", "text": "他们俩都要去另一个"}, {"type": "subtitle", "time": 13568.55, "timestamp": "03:46:08", "text": "好的，等等。 没关系。"}, {"type": "subtitle", "time": 13570.63, "timestamp": "03:46:10", "text": "下次我参加活动的时候，我一定会"}, {"type": "subtitle", "time": 13572.63, "timestamp": "03:46:12", "text": "到场。 下一次活动是什么时候"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "？ 等待。"}, {"type": "subtitle", "time": 13579.309, "timestamp": "03:46:19", "text": "哦，等等。 这是什么日本"}, {"type": "subtitle", "time": 13581.95, "timestamp": "03:46:21", "text": "社区？ 哦，我也参加了，"}, {"type": "subtitle", "time": 13588.269, "timestamp": "03:46:28", "text": "？"}, {"type": "subtitle", "time": 13595.71, "timestamp": "03:46:35", "text": "你做得"}, {"type": "subtitle", "time": 13598.63, "timestamp": "03:46:38", "text": "很好。 我认为Jockey"}, {"type": "subtitle", "time": 13610.59, "timestamp": "03:46:50", "text": "啊，等等。 我真的做过吗？不，我就像个"}, {"type": "subtitle", "time": 13613.67, "timestamp": "03:46:53", "text": "船长，或者像你知道的那些"}, {"type": "subtitle", "time": 13615.83, "timestamp": "03:46:55", "text": "东西，比如蓝房子、绿房子、红"}, {"type": "subtitle", "time": 13618.55, "timestamp": "03:46:58", "text": "房子、黄房子。 我是蓝"}]
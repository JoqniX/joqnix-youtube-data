[{"type": "subtitle", "time": 2000.47, "timestamp": "00:33:20", "text": "你认为未来会有免费的类魂"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "？  “灵魂”是什么意思？ 是"}, {"type": "subtitle", "time": 2012.029, "timestamp": "00:33:32", "text": "因为《黑暗之魂》变成了"}, {"type": "subtitle", "time": 2015.909, "timestamp": "00:33:35", "text": "一种特定类型的游戏吗？ 他们开创了一种全新的音乐类型"}, {"type": "subtitle", "time": 2019.99, "timestamp": "00:33:39", "text": "。 是那样吗？   真是这样吗"}, {"type": "subtitle", "time": 2033.31, "timestamp": "00:33:53", "text": "东西。"}]
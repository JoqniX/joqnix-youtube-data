[{"type": "subtitle", "time": 21244.19, "timestamp": "05:54:04", "text": "我喜欢惊喜。 并不"}, {"type": "subtitle", "time": 21245.788, "timestamp": "05:54:05", "text": "意外，"}, {"type": "subtitle", "time": 21248.548, "timestamp": "05:54:08", "text": "不过等等，我这就把东西发给你"}, {"type": "subtitle", "time": 21250.948, "timestamp": "05:54:10", "text": "。"}, {"type": "subtitle", "time": 21255.03, "timestamp": "05:54:15", "text": "有人说这会延误。 好的。"}, {"type": "subtitle", "time": 21258.548, "timestamp": "05:54:18", "text": "有人说了这句话，我当时就想：“兄弟，"}, {"type": "chat", "time": 21258.669, "timestamp": "05:54:18", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "aha there you are"}, {"type": "subtitle", "time": 21261.11, "timestamp": "05:54:21", "text": "这是我第一次收到"}, {"type": "subtitle", "time": 21264.708, "timestamp": "05:54:24", "text": "关于比利·贝尔的奇怪评论。” 我当时就想，"}, {"type": "subtitle", "time": 21267.11, "timestamp": "05:54:27", "text": "“该死，"}, {"type": "subtitle", "time": 21275.03, "timestamp": "05:54:35", "text": "有人说了这句话。’好吧。”我当时就想，"}, {"type": "subtitle", "time": 21277.67, "timestamp": "05:54:37", "text": "“是啊，拜拜。” 别那样做。 你不应该"}, {"type": "subtitle", "time": 21284.03, "timestamp": "05:54:44", "text": "而且"}, {"type": "subtitle", "time": 21287.03, "timestamp": "05:54:47", "text": "显然是有办法编写"}, {"type": "subtitle", "time": 21289.83, "timestamp": "05:54:49", "text": "报告信息的。 难以置信。 我当时"}, {"type": "subtitle", "time": 21292.47, "timestamp": "05:54:52", "text": "就想，“是啊，我要跟"}, {"type": "subtitle", "time": 21296.628, "timestamp": "05:54:56", "text": "你睡一觉。” 所以，我就说了些不"}, {"type": "subtitle", "time": 21298.39, "timestamp": "05:54:58", "text": "恰当的话，并告诉他们"}]
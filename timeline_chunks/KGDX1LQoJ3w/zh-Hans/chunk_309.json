[{"type": "subtitle", "time": 18551.95, "timestamp": "05:09:11", "text": "所以，我们就在那里安家，或者搞点"}, {"type": "subtitle", "time": 18553.628, "timestamp": "05:09:13", "text": "音乐之类的"}, {"type": "subtitle", "time": 18556.55, "timestamp": "05:09:16", "text": "。 我刚刚砍倒了一棵大树"}, {"type": "subtitle", "time": 18562.07, "timestamp": "05:09:22", "text": "。 哦，剩下的我可以提取出来。"}, {"type": "subtitle", "time": 18566.43, "timestamp": "05:09:26", "text": "哦，树侧翻了。 树"}, {"type": "subtitle", "time": 18590.15, "timestamp": "05:09:50", "text": "。 我觉得我们应该下去。 是的，我们"}, {"type": "subtitle", "time": 18593.75, "timestamp": "05:09:53", "text": "现在就需要造船了。"}, {"type": "subtitle", "time": 18595.67, "timestamp": "05:09:55", "text": "我们需要造一艘船。 拜托，老兄。"}]
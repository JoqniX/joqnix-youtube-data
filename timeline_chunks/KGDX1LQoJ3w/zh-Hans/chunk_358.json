[{"type": "subtitle", "time": 21487.23, "timestamp": "05:58:07", "text": "呃，看看这个"}, {"type": "subtitle", "time": 21493.628, "timestamp": "05:58:13", "text": "12. 你好。"}, {"type": "subtitle", "time": 21495.67, "timestamp": "05:58:15", "text": "欢迎。 哦，是的。 我现在需要制作"}, {"type": "subtitle", "time": 21496.75, "timestamp": "05:58:16", "text": "第二场演出"}, {"type": "subtitle", "time": 21501.19, "timestamp": "05:58:21", "text": "。 我睡过头了。"}, {"type": "subtitle", "time": 21503.548, "timestamp": "05:58:23", "text": "哇。"}, {"type": "subtitle", "time": 21506.99, "timestamp": "05:58:26", "text": "呃，我希望今晚能睡个好觉"}, {"type": "subtitle", "time": 21511.91, "timestamp": "05:58:31", "text": "。 我昨晚睡得很好。 呃呃，"}, {"type": "subtitle", "time": 21517.67, "timestamp": "05:58:37", "text": "我得处理一条信息"}, {"type": "subtitle", "time": 21521.11, "timestamp": "05:58:41", "text": "。 你整晚都在"}, {"type": "subtitle", "time": 21525.23, "timestamp": "05:58:45", "text": "听讲道。 是的。 是的，"}, {"type": "subtitle", "time": 21530.15, "timestamp": "05:58:50", "text": "我当时正在集思广益，精心构思一条"}, {"type": "subtitle", "time": 21532.31, "timestamp": "05:58:52", "text": "周全、专业的"}, {"type": "subtitle", "time": 21535.59, "timestamp": "05:58:55", "text": "讯息。 我的天啊。"}, {"type": "subtitle", "time": 21539.91, "timestamp": "05:58:59", "text": "结果，事情开始走下坡路了。"}]
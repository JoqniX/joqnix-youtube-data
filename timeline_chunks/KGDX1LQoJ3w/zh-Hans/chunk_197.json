[{"type": "subtitle", "time": 11825.75, "timestamp": "03:17:05", "text": "我做了自我介绍，也谈到了"}, {"type": "subtitle", "time": 11828.309, "timestamp": "03:17:08", "text": "今天的主题——我想"}, {"type": "subtitle", "time": 11830.91, "timestamp": "03:17:10", "text": "成为一名职业电竞选"}, {"type": "subtitle", "time": 11833.349, "timestamp": "03:17:13", "text": "手。但是，我真希望可以"}, {"type": "subtitle", "time": 11836.55, "timestamp": "03:17:16", "text": "和人聊聊。"}, {"type": "subtitle", "time": 11856.75, "timestamp": "03:17:36", "text": "。啊，我的头"}]
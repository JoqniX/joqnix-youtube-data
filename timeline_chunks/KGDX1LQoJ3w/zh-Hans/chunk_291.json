[{"type": "subtitle", "time": 17460.83, "timestamp": "04:51:00", "text": "你的"}, {"type": "subtitle", "time": 17463.99, "timestamp": "04:51:03", "text": "船。 我觉得我已经到了"}, {"type": "subtitle", "time": 17466.31, "timestamp": "04:51:06", "text": "失去这艘船的地步了。"}, {"type": "subtitle", "time": 17469.51, "timestamp": "04:51:09", "text": "不，不，不，不，不，不。 你是不是觉得"}, {"type": "subtitle", "time": 17474.15, "timestamp": "04:51:14", "text": "我身处某个干燥的"}, {"type": "subtitle", "time": 17476.67, "timestamp": "04:51:16", "text": "地区？ 哦，好的。 你到达"}, {"type": "subtitle", "time": 17479.67, "timestamp": "04:51:19", "text": "深海沟了吗？"}, {"type": "subtitle", "time": 17482.31, "timestamp": "04:51:22", "text": "不，不，不。 你等一下，"}, {"type": "subtitle", "time": 17485.31, "timestamp": "04:51:25", "text": "附近有人。 好的。 呃，你上船"}, {"type": "subtitle", "time": 17489.27, "timestamp": "04:51:29", "text": "然后航行了吗？"}, {"type": "subtitle", "time": 17491.91, "timestamp": "04:51:31", "text": "立即发货。 是的。 是的。 试着把"}, {"type": "subtitle", "time": 17493.75, "timestamp": "04:51:33", "text": "你的船停靠到那个岛上之类的。"}, {"type": "subtitle", "time": 17496.948, "timestamp": "04:51:36", "text": "看看情况如何。"}, {"type": "subtitle", "time": 17499.15, "timestamp": "04:51:39", "text": "我没有把它停靠在码头"}, {"type": "subtitle", "time": 17503.83, "timestamp": "04:51:43", "text": "。 撞上礁石。 礁石是什么？ 帆"}, {"type": "subtitle", "time": 17514.708, "timestamp": "04:51:54", "text": "我现在得游泳了。"}, {"type": "subtitle", "time": 17516.628, "timestamp": "04:51:56", "text": "所以，你后来怎么样了？ 它就这么"}, {"type": "subtitle", "time": 17519.67, "timestamp": "04:51:59", "text": "消失了吗？ 呃，我无法让"}]
[{"type": "subtitle", "time": 16863.31, "timestamp": "04:41:03", "text": "？ 这就是我。"}, {"type": "subtitle", "time": 16866.07, "timestamp": "04:41:06", "text": "问号。 游戏帖子。"}, {"type": "subtitle", "time": 16869.91, "timestamp": "04:41:09", "text": "呃，我收到了一封类似教程的邮件。"}, {"type": "subtitle", "time": 16879.43, "timestamp": "04:41:19", "text": "嘿，米兰达。 您可以报告我代码中的错误"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "。 好的。"}, {"type": "subtitle", "time": 16883.83, "timestamp": "04:41:23", "text": "好的。 所以，就像通过Steam平台那样，我在游戏中向你展示了这一点"}, {"type": "subtitle", "time": 16886.07, "timestamp": "04:41:26", "text": "。"}, {"type": "subtitle", "time": 16889.27, "timestamp": "04:41:29", "text": "呃，你在哪里？"}, {"type": "subtitle", "time": 16893.23, "timestamp": "04:41:33", "text": "我没看到你"}, {"type": "subtitle", "time": 16897.27, "timestamp": "04:41:37", "text": "带馒头。 不，"}, {"type": "subtitle", "time": 16900.15, "timestamp": "04:41:40", "text": "我不是看着你玩。 我不知道"}, {"type": "subtitle", "time": 16903.27, "timestamp": "04:41:43", "text": "面包在哪儿？"}, {"type": "subtitle", "time": 16905.35, "timestamp": "04:41:45", "text": "不太好。"}, {"type": "subtitle", "time": 16909.59, "timestamp": "04:41:49", "text": "你的Steam用户名是什么？ 他妈的。 我也"}, {"type": "subtitle", "time": 16913.19, "timestamp": "04:41:53", "text": "忘了。 稍等片刻。 好斧子。"}, {"type": "subtitle", "time": 16916.35, "timestamp": "04:41:56", "text": "好的。 好的，那我把它改名为“"}, {"type": "subtitle", "time": 16919.67, "timestamp": "04:41:59", "text": "面包”，这样我就能很快找到你了。 很容易"}]
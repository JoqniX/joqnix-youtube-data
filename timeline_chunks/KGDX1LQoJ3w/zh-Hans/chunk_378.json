[{"type": "subtitle", "time": 22684.59, "timestamp": "06:18:04", "text": "我"}, {"type": "subtitle", "time": 22688.31, "timestamp": "06:18:08", "text": "睡着了，但我心想，啊，如果我没"}, {"type": "subtitle", "time": 22690.23, "timestamp": "06:18:10", "text": "做这件事，我本来可以睡得像"}, {"type": "subtitle", "time": 22692.948, "timestamp": "06:18:12", "text": "死猪一样。 我夜里醒来。 我"}, {"type": "subtitle", "time": 22704.51, "timestamp": "06:18:24", "text": "一个好人，我希望"}, {"type": "subtitle", "time": 22717.19, "timestamp": "06:18:37", "text": "。 你们两个都一个人睡。"}, {"type": "subtitle", "time": 22719.91, "timestamp": "06:18:39", "text": "为什么？ 好的。"}, {"type": "subtitle", "time": 22723.31, "timestamp": "06:18:43", "text": "等等，你们俩不是都去"}]
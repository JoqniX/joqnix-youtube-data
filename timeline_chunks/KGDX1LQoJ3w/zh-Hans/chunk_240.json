[{"type": "subtitle", "time": 14403.11, "timestamp": "04:00:03", "text": "说下去，入口处没有人守卫，"}, {"type": "subtitle", "time": 14422.229, "timestamp": "04:00:22", "text": "嗯，日语。 我知道。 我只是想"}, {"type": "subtitle", "time": 14425.269, "timestamp": "04:00:25", "text": "提高口语能力。 你知道，"}, {"type": "subtitle", "time": 14433.46, "timestamp": "04:00:33", "text": "不，他们进来了。他们把"}, {"type": "subtitle", "time": 14436.429, "timestamp": "04:00:36", "text": "[音乐]也弄"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "进来了。好的。 我试试看。什么？ 这是什么"}, {"type": "subtitle", "time": 14441.05, "timestamp": "04:00:41", "text": "？ 我们来读吧。 阿吉。"}, {"type": "subtitle", "time": 14442.55, "timestamp": "04:00:42", "text": "[音乐]"}, {"type": "subtitle", "time": 14446.99, "timestamp": "04:00:46", "text": "哦，天哪。 哦，汉字。 汉字。"}, {"type": "subtitle", "time": 14448.51, "timestamp": "04:00:48", "text": "不。"}, {"type": "subtitle", "time": 14451.63, "timestamp": "04:00:51", "text": "呃，那是小号的，"}, {"type": "subtitle", "time": 14455.229, "timestamp": "04:00:55", "text": "对吧？"}, {"type": "subtitle", "time": 14457.9, "timestamp": "04:00:57", "text": "卡帕卡帕。 卡帕。 等待。"}]
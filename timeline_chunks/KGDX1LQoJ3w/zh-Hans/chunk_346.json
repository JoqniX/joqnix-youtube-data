[{"type": "subtitle", "time": 20769.75, "timestamp": "05:46:09", "text": "62."}, {"type": "subtitle", "time": 20772.43, "timestamp": "05:46:12", "text": "[音乐]"}, {"type": "subtitle", "time": 20784.27, "timestamp": "05:46:24", "text": "呃，"}, {"type": "subtitle", "time": 20787.83, "timestamp": "05:46:27", "text": "你说的那些不恰当的话是怎么回事？ 呃，"}, {"type": "subtitle", "time": 20791.35, "timestamp": "05:46:31", "text": "请问，"}, {"type": "subtitle", "time": 20794.19, "timestamp": "05:46:34", "text": "你的语言是怎么回事？ 先生，请注意您的言辞"}, {"type": "subtitle", "time": 20796.03, "timestamp": "05:46:36", "text": "。"}, {"type": "subtitle", "time": 20800.39, "timestamp": "05:46:40", "text": "呃，我该如何在Billy Billy上屏蔽用户？"}, {"type": "subtitle", "time": 20803.51, "timestamp": "05:46:43", "text": "顺便问一下，有人知道吗？ 兄弟，我"}, {"type": "subtitle", "time": 20804.83, "timestamp": "05:46:44", "text": "看不懂"}, {"type": "subtitle", "time": 20807.548, "timestamp": "05:46:47", "text": "中文。 搞什么鬼？ 注意你的"}, {"type": "subtitle", "time": 20811.35, "timestamp": "05:46:51", "text": "言辞。 请不要发表不"}, {"type": "subtitle", "time": 20813.67, "timestamp": "05:46:53", "text": "恰当的言论。 这是一个适合"}, {"type": "subtitle", "time": 20816.83, "timestamp": "05:46:56", "text": "全家观看的频道。"}]
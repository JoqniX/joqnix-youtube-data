[{"type": "subtitle", "time": 22081.03, "timestamp": "06:08:01", "text": "就像我加入的时候，我好像是唯一的"}, {"type": "subtitle", "time": 22083.27, "timestamp": "06:08:03", "text": "外国人。不，还有"}, {"type": "subtitle", "time": 22085.83, "timestamp": "06:08:05", "text": "另外两个人，都是YouTuber，也是外国人。"}, {"type": "subtitle", "time": 22088.07, "timestamp": "06:08:08", "text": "因为​​我"}, {"type": "subtitle", "time": 22090.07, "timestamp": "06:08:10", "text": "在他们的社区很活跃，所以只有我一个人是外国人。所以"}, {"type": "subtitle", "time": 22092.15, "timestamp": "06:08:12", "text": "我以为他们会让我加入，他们也确实"}, {"type": "subtitle", "time": 22094.708, "timestamp": "06:08:14", "text": "让我加入了。但是你知道，我当时在很多"}, {"type": "subtitle", "time": 22097.35, "timestamp": "06:08:17", "text": "主播服务器里。所以收到了"}, {"type": "subtitle", "time": 22099.27, "timestamp": "06:08:19", "text": "很多ping。我就把"}, {"type": "subtitle", "time": 22102.708, "timestamp": "06:08:22", "text": "服务器静音了，不知道他们ping了"}, {"type": "subtitle", "time": 22105.43, "timestamp": "06:08:25", "text": "我。所以我错过了很多ping，"}, {"type": "subtitle", "time": 22107.91, "timestamp": "06:08:27", "text": "他们就因为我不够认真把我踢出去了"}, {"type": "subtitle", "time": 22111.43, "timestamp": "06:08:31", "text": "。我问为什么我被"}, {"type": "subtitle", "time": 22113.91, "timestamp": "06:08:33", "text": "踢出服务器了。她说："}, {"type": "subtitle", "time": 22116.07, "timestamp": "06:08:36", "text": "“是的，我们ping过你。” 很多时候，"}, {"type": "subtitle", "time": 22119.59, "timestamp": "06:08:39", "text": "你都不在服务器上，"}, {"type": "subtitle", "time": 22121.43, "timestamp": "06:08:41", "text": "对 ping 和消息没有反应，也没有"}, {"type": "subtitle", "time": 22124.07, "timestamp": "06:08:44", "text": "完成我们交给你的任何日常活动或任务、"}, {"type": "subtitle", "time": 22128.628, "timestamp": "06:08:48", "text": "目标等等。 所以"}, {"type": "subtitle", "time": 22130.788, "timestamp": "06:08:50", "text": "我觉得你根本不认真"}, {"type": "subtitle", "time": 22133.35, "timestamp": "06:08:53", "text": "等等。而我们已经招收了很多认真的"}]
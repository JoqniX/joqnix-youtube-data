[{"type": "subtitle", "time": 5641.83, "timestamp": "01:34:01", "text": "这是一个不完善的衡量标准。 但我们目前最好的"}, {"type": "subtitle", "time": 5650.87, "timestamp": "01:34:10", "text": "。 怎么了？ 我怎么也掰不"}, {"type": "subtitle", "time": 5653.43, "timestamp": "01:34:13", "text": "开那只手。 斯塔布甚至认为我们"}, {"type": "subtitle", "time": 5655.43, "timestamp": "01:34:15", "text": "没有那么多时间可以浪费。 我们来"}, {"type": "subtitle", "time": 5664.87, "timestamp": "01:34:24", "text": "套接字。 哪个更好？或者我"}, {"type": "subtitle", "time": 5679.59, "timestamp": "01:34:39", "text": "这已经遭受了足够的破坏。"}, {"type": "subtitle", "time": 5687.629, "timestamp": "01:34:47", "text": "。 好的。 准备好进行"}, {"type": "subtitle", "time": 5695.91, "timestamp": "01:34:55", "text": "死了。 有趣的。  L 下降。"}]
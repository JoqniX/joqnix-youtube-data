[{"type": "subtitle", "time": 18422.67, "timestamp": "05:07:02", "text": "冷死了。 好的。 哦，看看"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "我上面的样子。"}, {"type": "subtitle", "time": 18428.628, "timestamp": "05:07:08", "text": "哦，你好。 我想现在就跳。"}, {"type": "subtitle", "time": 18431.59, "timestamp": "05:07:11", "text": "好的。 你会死的。 你知道吗？ 不，"}, {"type": "subtitle", "time": 18444.23, "timestamp": "05:07:24", "text": "可以。 我觉得我们应该哇哦。 这是什么"}, {"type": "subtitle", "time": 18451.27, "timestamp": "05:07:31", "text": "你知道吗？ 我……呃……"}, {"type": "subtitle", "time": 18452.708, "timestamp": "05:07:32", "text": "我们该怎么办？ 就像离开这个"}, {"type": "subtitle", "time": 18455.43, "timestamp": "05:07:35", "text": "岛，去我们前面的那个"}, {"type": "subtitle", "time": 18457.91, "timestamp": "05:07:37", "text": "岛。 不，不。 我们需要做"}, {"type": "subtitle", "time": 18464.31, "timestamp": "05:07:44", "text": "咱们就随便逛逛吧。 拜托，老兄。 咱们就随便"}, {"type": "subtitle", "time": 18467.91, "timestamp": "05:07:47", "text": "逛逛吧，伙计。 但要做一些手工活。 得"}, {"type": "subtitle", "time": 18470.708, "timestamp": "05:07:50", "text": "做些手工活。   是的"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "，没错。 就像上面说的，嗯，煤炭。"}, {"type": "subtitle", "time": 18475.67, "timestamp": "05:07:55", "text": "于是我们找到了一些石头。 你看到"}, {"type": "subtitle", "time": 18479.67, "timestamp": "05:07:59", "text": "所需的日志了吗？我看到的是类似第"}]
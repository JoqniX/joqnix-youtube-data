[{"type": "subtitle", "time": 13621.51, "timestamp": "03:47:01", "text": "队队长。 我忍不住放声尖叫"}, {"type": "subtitle", "time": 13624.79, "timestamp": "03:47:04", "text": "。 我当时也像个童子军领队"}, {"type": "subtitle", "time": 13626.95, "timestamp": "03:47:06", "text": "，但我得拼命呐喊才行"}, {"type": "subtitle", "time": 13628.95, "timestamp": "03:47:08", "text": "。"}, {"type": "subtitle", "time": 13630.87, "timestamp": "03:47:10", "text": "更像是我被迫接受那个"}, {"type": "subtitle", "time": 13648.73, "timestamp": "03:47:28", "text": "猜"}]
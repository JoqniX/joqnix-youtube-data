[{"type": "subtitle", "time": 10681.99, "timestamp": "02:58:01", "text": "他移民到了美国，并且"}, {"type": "subtitle", "time": 10687.19, "timestamp": "02:58:07", "text": "成为了一名"}, {"type": "subtitle", "time": 10692.71, "timestamp": "02:58:12", "text": "职业球员。 所以，我我我我很喜欢"}, {"type": "subtitle", "time": 10694.99, "timestamp": "02:58:14", "text": "这个故事，"}, {"type": "subtitle", "time": 10701.269, "timestamp": "02:58:21", "text": "它足以让我"}, {"type": "subtitle", "time": 10704.71, "timestamp": "02:58:24", "text": "对一个棒球运动员产生好感。 就这样"}, {"type": "subtitle", "time": 10717.87, "timestamp": "02:58:37", "text": "谢谢。 先做那件事之后再做。 等等，"}]
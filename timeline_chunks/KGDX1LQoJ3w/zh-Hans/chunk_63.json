[{"type": "subtitle", "time": 3792.549, "timestamp": "01:03:12", "text": "又崩溃了。 我现在不会下载。 我们拿到"}, {"type": "subtitle", "time": 3794.72, "timestamp": "01:03:14", "text": "东西了。 我"}, {"type": "subtitle", "time": 3799.309, "timestamp": "01:03:19", "text": "（音乐）"}, {"type": "subtitle", "time": 3803.309, "timestamp": "01:03:23", "text": "奖，我的意思是，我这次很幸运，"}, {"type": "subtitle", "time": 3806.39, "timestamp": "01:03:26", "text": "但这是否意味着我会获得我错过的另外两个"}, {"type": "subtitle", "time": 3808.43, "timestamp": "01:03:28", "text": "奖项"}, {"type": "subtitle", "time": 3816.91, "timestamp": "01:03:36", "text": "这么认为。 另一个词是上个月的，对吧？今天是第"}, {"type": "subtitle", "time": 3823.309, "timestamp": "01:03:43", "text": "61天，对吧？"}, {"type": "subtitle", "time": 3829.15, "timestamp": "01:03:49", "text": "我"}, {"type": "subtitle", "time": 3832.27, "timestamp": "01:03:52", "text": "猜是第50、52、51、53天。 没有"}, {"type": "subtitle", "time": 3835.309, "timestamp": "01:03:55", "text": "把握。 我的天，它又卡住了"}]
[{"type": "subtitle", "time": 16928.628, "timestamp": "04:42:08", "text": "面包。 面包皇后面包。"}, {"type": "subtitle", "time": 16931.39, "timestamp": "04:42:11", "text": "我……勉强"}, {"type": "subtitle", "time": 16935.27, "timestamp": "04:42:15", "text": "应付。 嗯？ 它只是说请"}, {"type": "subtitle", "time": 16937.47, "timestamp": "04:42:17", "text": "稍候。 呃，请到你的"}, {"type": "subtitle", "time": 16943.67, "timestamp": "04:42:23", "text": "个人资料页面告诉我你"}, {"type": "subtitle", "time": 16947.868, "timestamp": "04:42:27", "text": "在游戏里的名字。"}, {"type": "subtitle", "time": 16950.708, "timestamp": "04:42:30", "text": "因为“面包小哥”这个名字已经被占用了，所以我"}, {"type": "subtitle", "time": 16954.07, "timestamp": "04:42:34", "text": "改成了“VT”。"}, {"type": "subtitle", "time": 16956.39, "timestamp": "04:42:36", "text": "我觉得我需要给"}, {"type": "subtitle", "time": 16959.83, "timestamp": "04:42:39", "text": "这个账户添加一些凭证之类的。"}, {"type": "subtitle", "time": 16961.35, "timestamp": "04:42:41", "text": "什么？ 什么？ 你叫什么名字？ 让我"}, {"type": "subtitle", "time": 16973.75, "timestamp": "04:42:53", "text": "。 给我发个好友请求吧。   是的"}, {"type": "subtitle", "time": 16976.19, "timestamp": "04:42:56", "text": "，我明白了。 我"}]
[{"type": "subtitle", "time": 18848.23, "timestamp": "05:14:08", "text": "你一些木棍。 我的棍子在哪儿？ 等等，这到底是"}, {"type": "subtitle", "time": 18850.43, "timestamp": "05:14:10", "text": "怎么"}, {"type": "subtitle", "time": 18854.948, "timestamp": "05:14:14", "text": "回事？ 长大。 开始了。 等等，让我"}, {"type": "subtitle", "time": 18863.75, "timestamp": "05:14:23", "text": "除了"}, {"type": "subtitle", "time": 18867.03, "timestamp": "05:14:27", "text": "哦。 哦，是的"}, {"type": "subtitle", "time": 18870.69, "timestamp": "05:14:30", "text": "。 把我的香蕉拿走。 收下我的香料。"}, {"type": "subtitle", "time": 18878.15, "timestamp": "05:14:38", "text": "哇，这太棒了。"}, {"type": "subtitle", "time": 18880.23, "timestamp": "05:14:40", "text": "那相当不错。 我认为这就是为什么"}, {"type": "subtitle", "time": 18882.55, "timestamp": "05:14:42", "text": "那里会有市长之类的"}, {"type": "subtitle", "time": 18884.31, "timestamp": "05:14:44", "text": "职位，因为你可以在"}, {"type": "subtitle", "time": 18887.59, "timestamp": "05:14:47", "text": "这里建立一个社区。   是的"}, {"type": "subtitle", "time": 18893.91, "timestamp": "05:14:53", "text": "[音乐]"}, {"type": "subtitle", "time": 18895.948, "timestamp": "05:14:55", "text": "这么多"}, {"type": "subtitle", "time": 18897.94, "timestamp": "05:14:57", "text": "该死的"}]
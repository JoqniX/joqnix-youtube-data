[{"type": "subtitle", "time": 21848.27, "timestamp": "06:04:08", "text": "伙计。 哦，是的，你说得"}, {"type": "subtitle", "time": 21851.99, "timestamp": "06:04:11", "text": "对。 是的，我不应该让其他人知道。   是的"}, {"type": "subtitle", "time": 21854.75, "timestamp": "06:04:14", "text": "，"}, {"type": "subtitle", "time": 21858.15, "timestamp": "06:04:18", "text": "没错。 呃，但我没明白，"}, {"type": "subtitle", "time": 21860.948, "timestamp": "06:04:20", "text": "如果我请他们"}, {"type": "subtitle", "time": 21863.75, "timestamp": "06:04:23", "text": "批评我的作品，那当然可以，但"}, {"type": "subtitle", "time": 21866.23, "timestamp": "06:04:26", "text": "我什么都没问，我只是问他们是否"}, {"type": "subtitle", "time": 21868.83, "timestamp": "06:04:28", "text": "有空"}, {"type": "subtitle", "time": 21871.59, "timestamp": "06:04:31", "text": "合作做这件事？ 我只是在参加一个"}, {"type": "subtitle", "time": 21874.31, "timestamp": "06:04:34", "text": "活动。 就是这样。 他们没"}, {"type": "subtitle", "time": 21877.67, "timestamp": "06:04:37", "text": "必要对我吹毛求疵，比如“根本没"}, {"type": "subtitle", "time": 21880.548, "timestamp": "06:04:40", "text": "人关注我，我做了"}, {"type": "subtitle", "time": 21883.11, "timestamp": "06:04:43", "text": "三个月，但只完成了"}]
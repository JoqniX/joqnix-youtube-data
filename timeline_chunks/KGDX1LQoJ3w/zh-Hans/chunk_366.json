[{"type": "subtitle", "time": 21960.23, "timestamp": "06:06:00", "text": "啊。所以他们有个"}, {"type": "subtitle", "time": 21963.07, "timestamp": "06:06:03", "text": "项目，或者说是某种热情项目之类的，他们"}, {"type": "subtitle", "time": 21967.83, "timestamp": "06:06:07", "text": "招募一些人来"}, {"type": "subtitle", "time": 21970.948, "timestamp": "06:06:10", "text": "培训他们，让他们成为认真思考的"}, {"type": "subtitle", "time": 21972.788, "timestamp": "06:06:12", "text": "人，或者像那些内容"}, {"type": "subtitle", "time": 21974.708, "timestamp": "06:06:14", "text": "创作者一样，现在"}, {"type": "subtitle", "time": 21977.11, "timestamp": "06:06:17", "text": "停滞不前，"}, {"type": "subtitle", "time": 21978.868, "timestamp": "06:06:18", "text": "没有发展，但又想靠"}, {"type": "subtitle", "time": 21982.15, "timestamp": "06:06:22", "text": "这个谋生等等，"}, {"type": "subtitle", "time": 21984.788, "timestamp": "06:06:24", "text": "想要认真起来。所以她和其他人设法招募到了"}, {"type": "subtitle", "time": 21990.39, "timestamp": "06:06:30", "text": "一些更大的创作者，呃，"}, {"type": "subtitle", "time": 21992.47, "timestamp": "06:06:32", "text": "独立创作者，他们做了"}, {"type": "subtitle", "time": 21995.19, "timestamp": "06:06:35", "text": "他们组成了一个团队，一起教学，帮助"}, {"type": "subtitle", "time": 21997.83, "timestamp": "06:06:37", "text": "个人等等。事情就是这样"}, {"type": "subtitle", "time": 22000.31, "timestamp": "06:06:40", "text": "开始的，后来我"}, {"type": "subtitle", "time": 22002.31, "timestamp": "06:06:42", "text": "觉得管理起来很困难，所以他们就把"}]
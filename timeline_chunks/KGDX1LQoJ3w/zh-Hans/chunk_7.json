[{"type": "subtitle", "time": 420.55, "timestamp": "00:07:00", "text": "想这里有五六个律师什么的"}, {"type": "subtitle", "time": 423.589, "timestamp": "00:07:03", "text": "。 另一侧的背面和"}, {"type": "subtitle", "time": 426.629, "timestamp": "00:07:06", "text": "正面办公空间可以用来做"}, {"type": "subtitle", "time": 428.39, "timestamp": "00:07:08", "text": "精品店之类的。 他们大概"}, {"type": "subtitle", "time": 431.11, "timestamp": "00:07:11", "text": "下周左右会来。 是的，所以我们为他们分别"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "做了一个三相"}, {"type": "subtitle", "time": 435.43, "timestamp": "00:07:15", "text": "连接，"}, {"type": "subtitle", "time": 437.67, "timestamp": "00:07:17", "text": "每个"}, {"type": "subtitle", "time": 440.15, "timestamp": "00:07:20", "text": "商业用途的楼下"}, {"type": "subtitle", "time": 443.029, "timestamp": "00:07:23", "text": "家庭用电都单独做了两个三相连接。 我家之前还是单"}, {"type": "subtitle", "time": 444.67, "timestamp": "00:07:24", "text": "相电，我们不得不把它改成"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "三相电。 所以，DVN 的相关工作"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "最近已经完成了。 所以现在我爸得"}, {"type": "subtitle", "time": 455.43, "timestamp": "00:07:35", "text": "去做一些类似电气办公室"}, {"type": "subtitle", "time": 457.27, "timestamp": "00:07:37", "text": "谈判之类的事情。 请官员"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "来检查配电箱、"}, {"type": "subtitle", "time": 461.43, "timestamp": "00:07:41", "text": "电气设备、"}, {"type": "subtitle", "time": 463.749, "timestamp": "00:07:43", "text": "电表等等所有东西。 然后付钱给那"}, {"type": "subtitle", "time": 466.87, "timestamp": "00:07:46", "text": "个人，拿到三相电表或"}, {"type": "subtitle", "time": 470.30899999999997, "timestamp": "00:07:50", "text": "其他连接装置。 是的。 这样一来，"}, {"type": "subtitle", "time": 475.43, "timestamp": "00:07:55", "text": "我觉得电费应该会减少。 所以"}, {"type": "subtitle", "time": 477.99, "timestamp": "00:07:57", "text": "电工们检查了"}]
[{"type": "subtitle", "time": 13682.349, "timestamp": "03:48:02", "text": "11. 这次活动是"}, {"type": "subtitle", "time": 13686.63, "timestamp": "03:48:06", "text": "关于什么的？ 解释得不够清楚。"}, {"type": "subtitle", "time": 13690.07, "timestamp": "03:48:10", "text": "好的。 我们今天参加了这个活动，"}, {"type": "subtitle", "time": 13692.79, "timestamp": "03:48:12", "text": "就是"}, {"type": "subtitle", "time": 13696.15, "timestamp": "03:48:16", "text": "这个活动。 这是一项每周一次的活动。 今天的"}, {"type": "subtitle", "time": 13698.55, "timestamp": "03:48:18", "text": "话题是：如果你能成为一名"}, {"type": "subtitle", "time": 13700.55, "timestamp": "03:48:20", "text": "职业运动员，"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "你会选择哪些运动项目，为什么？ 我说我"}, {"type": "subtitle", "time": 13705.07, "timestamp": "03:48:25", "text": "会"}, {"type": "subtitle", "time": 13708.11, "timestamp": "03:48:28", "text": "选。 我说我想成为一名"}, {"type": "subtitle", "time": 13711.11, "timestamp": "03:48:31", "text": "运动员，因为我性格内向，不擅长"}, {"type": "subtitle", "time": 13718.87, "timestamp": "03:48:38", "text": "而且我正在积极参加各种活动，以便将来能够"}, {"type": "subtitle", "time": 13722.15, "timestamp": "03:48:42", "text": "成为一名运动员。"}, {"type": "subtitle", "time": 13724.389, "timestamp": "03:48:44", "text": "竞争什么的，对吧？ 但是自从"}, {"type": "subtitle", "time": 13728.63, "timestamp": "03:48:48", "text": "我的电脑出问题后，我好像就没怎么玩竞技游戏了"}, {"type": "subtitle", "time": 13730.87, "timestamp": "03:48:50", "text": "。"}, {"type": "subtitle", "time": 13734.67, "timestamp": "03:48:54", "text": "所以，我不应该让这一点成为我的"}, {"type": "subtitle", "time": 13737.309, "timestamp": "03:48:57", "text": "局限。 所以他们每周都有活动"}]
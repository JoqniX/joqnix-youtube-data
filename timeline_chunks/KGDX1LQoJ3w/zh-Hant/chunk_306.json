[{"type": "subtitle", "time": 18364.03, "timestamp": "05:06:04", "text": "教程。  我必須完成教程嗎？快點。"}, {"type": "subtitle", "time": 18366.51, "timestamp": "05:06:06", "text": "拜託，"}, {"type": "subtitle", "time": 18369.39, "timestamp": "05:06:09", "text": "老兄。為什麼要進行本教程？  我死了。我中了陷阱死了。  好的。"}, {"type": "subtitle", "time": 18388.07, "timestamp": "05:06:28", "text": "按鈕嗎？  為什麼"}, {"type": "subtitle", "time": 18391.67, "timestamp": "05:06:31", "text": "這感覺像印第安納·瓊斯？對，沒錯。  哦"}, {"type": "subtitle", "time": 18393.91, "timestamp": "05:06:33", "text": "，我被"}, {"type": "subtitle", "time": 18395.948, "timestamp": "05:06:35", "text": "這驚艷到了。"}, {"type": "subtitle", "time": 18405.27, "timestamp": "05:06:45", "text": "編織。  但是敵人存在。嘿。"}]
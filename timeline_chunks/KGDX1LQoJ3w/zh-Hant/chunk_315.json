[{"type": "subtitle", "time": 18911.83, "timestamp": "05:15:11", "text": "我認為，一旦本地主機安全，它就會關閉。"}, {"type": "subtitle", "time": 18915.39, "timestamp": "05:15:15", "text": "所以，我們暫時先用本地主機。我來主持。首輪公開賽通行證的"}, {"type": "subtitle", "time": 18925.03, "timestamp": "05:15:25", "text": "玩家人數上限為三人。  可以湊成三個吧？"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "合作模式二也不錯。  [音樂]"}, {"type": "subtitle", "time": 18944.628, "timestamp": "05:15:44", "text": "嗯，朋友們在地圖"}]
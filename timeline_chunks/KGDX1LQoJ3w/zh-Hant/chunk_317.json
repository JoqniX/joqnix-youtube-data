[{"type": "subtitle", "time": 19025.35, "timestamp": "05:17:05", "text": "我可以提拔你做什麼？  我可以"}, {"type": "subtitle", "time": 19028.47, "timestamp": "05:17:08", "text": "降你的職"}, {"type": "subtitle", "time": 19031.35, "timestamp": "05:17:11", "text": "。提拔你。  不知道。  呃，將整套設備設置為多種"}, {"type": "subtitle", "time": 19059.83, "timestamp": "05:17:39", "text": "這大概就像人們自己搭建服務器一樣。  我的天，我得把它保存下來"}, {"type": "subtitle", "time": 19072.15, "timestamp": "05:17:52", "text": "。所以，在這部劇裡，我們倆都是市長。對不起。讓我們來看看。  為什麼用第一人稱"}]
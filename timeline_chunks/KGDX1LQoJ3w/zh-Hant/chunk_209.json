[{"type": "subtitle", "time": 12540.55, "timestamp": "03:29:00", "text": "魂系遊戲。兄弟，我並不想"}, {"type": "subtitle", "time": 12548.15, "timestamp": "03:29:08", "text": "那樣做。  我該如何起床"}, {"type": "subtitle", "time": 12549.75, "timestamp": "03:29:09", "text": "？好吧，我受傷了。我給它打了分。  哦。  一個大"}, {"type": "subtitle", "time": 12573.75, "timestamp": "03:29:33", "text": "[音樂] 寂靜的面具。我（音樂）在做什麼"}]
[{"type": "subtitle", "time": 18961.27, "timestamp": "05:16:01", "text": "上可見。好的。我們需要設置密碼嗎"}, {"type": "subtitle", "time": 18986.39, "timestamp": "05:16:26", "text": "你的槍"}, {"type": "subtitle", "time": 18995.59, "timestamp": "05:16:35", "text": "和"}, {"type": "subtitle", "time": 18998.07, "timestamp": "05:16:38", "text": "所有裝備都還在嗎？  是的，我帶了斧子。食物我都有了。我有一根"}, {"type": "subtitle", "time": 19000.708, "timestamp": "05:16:40", "text": "松木。我什麼都有了。搞什麼鬼？  呃，"}]
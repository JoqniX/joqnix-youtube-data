[{"type": "subtitle", "time": 22090.07, "timestamp": "06:08:10", "text": "所以現在這樣有點過頭了。我知道他們會搞那種互助小組之類的，幫助那些在Twitch上有"}, {"type": "subtitle", "time": 22094.708, "timestamp": "06:08:14", "text": "8000粉絲的人。他們只做Twitch，不做YouTube。他們還在遵循傳統。"}, {"type": "subtitle", "time": 22099.27, "timestamp": "06:08:19", "text": "我甚至跟他們說過，"}, {"type": "subtitle", "time": 22102.708, "timestamp": "06:08:22", "text": "換平台是2025年。不，當時是2023年。是"}, {"type": "subtitle", "time": 22116.07, "timestamp": "06:08:36", "text": "啊。但是，是啊。所以他們有個"}, {"type": "subtitle", "time": 22124.07, "timestamp": "06:08:44", "text": "項目，或者說是某種熱情項目之類的，他們招募一些人來培訓他們，讓他們成為認真"}]
[{"type": "subtitle", "time": 19860.07, "timestamp": "05:31:00", "text": "單獨的癒合桿綁住了三個傷口"}, {"type": "subtitle", "time": 19879.39, "timestamp": "05:31:19", "text": "。好的。好的。過來，過來，拿著這個容器，還有這些治愈"}, {"type": "subtitle", "time": 19905.35, "timestamp": "05:31:45", "text": "餡餅。  我認為我們需要一個“我們”，我認為我們首先還需要研製出一種藥物。"}, {"type": "subtitle", "time": 19909.31, "timestamp": "05:31:49", "text": "存儲方面沒有限制嗎"}]
[{"type": "subtitle", "time": 11228.79, "timestamp": "03:07:08", "text": "我想要"}, {"type": "subtitle", "time": 11230.99, "timestamp": "03:07:10", "text": "一個死神。我想選擇死神流。怎麼了？這已經是第15次了"}, {"type": "subtitle", "time": 11270.15, "timestamp": "03:07:50", "text": "怎麼了？我怎麼也掰不開那隻手。史塔布甚至認為我們沒有那麼多時間可以浪費。我們來檢查一下套接字。"}]
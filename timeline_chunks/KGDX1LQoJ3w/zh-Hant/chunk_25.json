[{"type": "subtitle", "time": 1501.19, "timestamp": "00:25:01", "text": "。然後我下來處理了一些事情，然後是的，做了很多事情。啊，這事兒讓我很煩惱，兄弟。  搞什麼鬼？"}, {"type": "subtitle", "time": 1511.47, "timestamp": "00:25:11", "text": "為什麼這件事讓我如此煩惱？這件事讓我非常煩惱。我"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "不知道是否應該繼續談論這件事。"}, {"type": "subtitle", "time": 1523.51, "timestamp": "00:25:23", "text": "你好。  [音樂] 你好。  [音樂]"}]
[{"type": "subtitle", "time": 1807.99, "timestamp": "00:30:07", "text": "我其實想看看，即使只是1個小時的直播，並且我"}, {"type": "subtitle", "time": 1821.35, "timestamp": "00:30:21", "text": "一直讓它保持"}, {"type": "subtitle", "time": 1824.19, "timestamp": "00:30:24", "text": "在加載狀態，它是否仍然會隨機結束？我看過它隨機結束，或者我會喜歡那種……該怎麼稱呼它呢？我是不是應該像昨天一樣，直接說「直播"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "事情了。"}]
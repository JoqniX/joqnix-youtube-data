[{"type": "subtitle", "time": 12840.349, "timestamp": "03:34:00", "text": "是一隻眼睛，對吧？"}, {"type": "subtitle", "time": 12856.71, "timestamp": "03:34:16", "text": "我死了。我現在有一隻"}, {"type": "subtitle", "time": 12859.67, "timestamp": "03:34:19", "text": "綠色的眼睛。哦。  [音樂] [音樂] 重建。  [音樂]"}, {"type": "subtitle", "time": 12884.83, "timestamp": "03:34:44", "text": "難道就沒有"}, {"type": "subtitle", "time": 12887.11, "timestamp": "03:34:47", "text": "辦法了嗎？還有這個。快點。熱。  我覺得他們反應很快之類的。"}]
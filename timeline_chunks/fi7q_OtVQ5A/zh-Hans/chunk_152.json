[{"type": "subtitle", "time": 9122.95, "timestamp": "02:32:02", "text": "不，我们只需要用那辆面包车就行了。"}, {"type": "subtitle", "time": 9126.389, "timestamp": "02:32:06", "text": "惠普的小玩意儿。"}, {"type": "subtitle", "time": 9128.95, "timestamp": "02:32:08", "text": "我只需要确保我们能活下来。"}, {"type": "subtitle", "time": 9131.67, "timestamp": "02:32:11", "text": "猜测。"}, {"type": "subtitle", "time": 9134.309, "timestamp": "02:32:14", "text": "好吧。你可以买任何东西"}, {"type": "subtitle", "time": 9137.27, "timestamp": "02:32:17", "text": "你想要。实际上，我们拿到了手榴弹和"}, {"type": "subtitle", "time": 9150.15, "timestamp": "02:32:30", "text": "我可以买到臭味。不，你没事。好的，"}, {"type": "subtitle", "time": 9153.99, "timestamp": "02:32:33", "text": "到时候我们就能拿到了。"}]
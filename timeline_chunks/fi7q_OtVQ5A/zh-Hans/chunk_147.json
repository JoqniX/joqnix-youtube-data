[{"type": "subtitle", "time": 8820.23, "timestamp": "02:27:00", "text": "事物"}, {"type": "subtitle", "time": 8821.91, "timestamp": "02:27:01", "text": "婴儿。"}, {"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "是的，这就是这张地图。不，"}, {"type": "subtitle", "time": 8827.91, "timestamp": "02:27:07", "text": "骷髅头就是那个人。头骨就在那里。"}, {"type": "subtitle", "time": 8829.59, "timestamp": "02:27:09", "text": "不，"}, {"type": "subtitle", "time": 8832.79, "timestamp": "02:27:12", "text": "头骨。没错，终极版。迄今为止，"}, {"type": "subtitle", "time": 8835.349, "timestamp": "02:27:15", "text": "最难打败的是红色"}, {"type": "subtitle", "time": 8837.59, "timestamp": "02:27:17", "text": "一。"}, {"type": "subtitle", "time": 8840.07, "timestamp": "02:27:20", "text": "红色的那一个。"}, {"type": "subtitle", "time": 8842.469, "timestamp": "02:27:22", "text": "我不太确定那是什么，但是，是的。"}, {"type": "subtitle", "time": 8858.309, "timestamp": "02:27:38", "text": "前往拍摄点时要小心。"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "我的天啊，"}, {"type": "subtitle", "time": 8862.23, "timestamp": "02:27:42", "text": "我几乎"}, {"type": "subtitle", "time": 8868.15, "timestamp": "02:27:48", "text": "被咬死了。是啊，我被咬了。"}, {"type": "subtitle", "time": 8876.07, "timestamp": "02:27:56", "text": "你为什么又要返回去？没有别的了。"}, {"type": "subtitle", "time": 8879.19, "timestamp": "02:27:59", "text": "我觉得我们把所有东西都洗劫一空了。"}]
[{"type": "subtitle", "time": 19563.43, "timestamp": "05:26:03", "text": "我哥哥怎么样了？"}, {"type": "subtitle", "time": 19565.51, "timestamp": "05:26:05", "text": "你过得怎么样？"}, {"type": "subtitle", "time": 19567.83, "timestamp": "05:26:07", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 19569.75, "timestamp": "05:26:09", "text": "我抓到了韦斯顿先生。我们把他带出去"}, {"type": "subtitle", "time": 19573.35, "timestamp": "05:26:13", "text": "这座城市。让它消失"}, {"type": "subtitle", "time": 19576.39, "timestamp": "05:26:16", "text": "在悬崖上"}, {"type": "subtitle", "time": 19588.23, "timestamp": "05:26:28", "text": "哦，那真是个不错的助力。"}]
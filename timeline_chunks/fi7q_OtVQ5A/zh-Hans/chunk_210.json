[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "我们会想出一个新名字。上次我"}, {"type": "subtitle", "time": 12619.349, "timestamp": "03:30:19", "text": "[音乐]"}, {"type": "subtitle", "time": 12627.11, "timestamp": "03:30:27", "text": "什么？"}, {"type": "subtitle", "time": 12629.83, "timestamp": "03:30:29", "text": "罗克福德山的一辆汽车，一家珠宝店。"}, {"type": "subtitle", "time": 12632.389, "timestamp": "03:30:32", "text": "我们把它从后面打掉了。等待。"}, {"type": "subtitle", "time": 12639.83, "timestamp": "03:30:39", "text": "哦，这是另一个版本。好的。等待，"}, {"type": "subtitle", "time": 12641.91, "timestamp": "03:30:41", "text": "等等，等等，等等，等等。小姐，那是"}, {"type": "subtitle", "time": 12645.75, "timestamp": "03:30:45", "text": "军团广场模板。使命"}]
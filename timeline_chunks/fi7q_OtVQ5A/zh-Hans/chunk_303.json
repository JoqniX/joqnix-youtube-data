[{"type": "subtitle", "time": 18206.948, "timestamp": "05:03:26", "text": "我的天啊。好的，我正在寻找"}, {"type": "subtitle", "time": 18233.35, "timestamp": "05:03:53", "text": "好吧，这次我不会死了。快点，"}, {"type": "subtitle", "time": 18237.59, "timestamp": "05:03:57", "text": "T：别这样。你这混蛋，你终于出现了。"}, {"type": "subtitle", "time": 18239.99, "timestamp": "05:03:59", "text": "问题出在哪里？我当时还很小"}]
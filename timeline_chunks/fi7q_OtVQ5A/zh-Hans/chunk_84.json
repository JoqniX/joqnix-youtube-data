[{"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "我的天哪。任何。真的吗？好的。哦"}, {"type": "subtitle", "time": 5064.31, "timestamp": "01:24:24", "text": "我以为你已经有了。好的。呃，"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "我不知道我是否应该这样做。"}, {"type": "subtitle", "time": 5070.55, "timestamp": "01:24:30", "text": "好的，他们转身的那一刻 10"}, {"type": "subtitle", "time": 5073.59, "timestamp": "01:24:33", "text": "转身，把它拿出来"}, {"type": "subtitle", "time": 5075.669, "timestamp": "01:24:35", "text": "进而"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "R：呃，好的。他们好像走了。"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "你没事。"}, {"type": "subtitle", "time": 5085.669, "timestamp": "01:24:45", "text": "所以，他们落后的那一刻就是"}, {"type": "subtitle", "time": 5088.629, "timestamp": "01:24:48", "text": "触发它的最佳地点。"}, {"type": "subtitle", "time": 5091.11, "timestamp": "01:24:51", "text": "哦，他们落后了，就像他们……"}, {"type": "subtitle", "time": 5093.35, "timestamp": "01:24:53", "text": "在他们身后。"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "他们在以下方面并不聪明："}]
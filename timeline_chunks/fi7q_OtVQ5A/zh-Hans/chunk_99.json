[{"type": "subtitle", "time": 5940.229, "timestamp": "01:39:00", "text": "是的，这是一件物品。可以。"}, {"type": "subtitle", "time": 5944.07, "timestamp": "01:39:04", "text": "那是一件物品。所以，当它发出“哦，我的天哪”的声音时"}, {"type": "subtitle", "time": 5950.95, "timestamp": "01:39:10", "text": "所以，当它发生时，意味着"}, {"type": "subtitle", "time": 5956.07, "timestamp": "01:39:16", "text": "别再拿着它了，它会把你电晕。"}, {"type": "subtitle", "time": 5973.91, "timestamp": "01:39:33", "text": "哦，这也是一双毛绒鞋。"}, {"type": "subtitle", "time": 5977.99, "timestamp": "01:39:37", "text": "那是一个看起来很诡异的毛绒玩具。"}, {"type": "subtitle", "time": 5980.31, "timestamp": "01:39:40", "text": "我的天哪，太可怕了。你是"}, {"type": "subtitle", "time": 5981.83, "timestamp": "01:39:41", "text": "会降落吗？坚持，稍等。我的"}, {"type": "subtitle", "time": 5984.39, "timestamp": "01:39:44", "text": "猫咪一直……我的天哪。是的。好了，就是这样。"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "你去。我的猫开始不耐烦了。哦"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "天哪。这是个小型体育场吗？"}, {"type": "subtitle", "time": 5998.87, "timestamp": "01:39:58", "text": "哦。我的天啊。我不需要这样做"}]
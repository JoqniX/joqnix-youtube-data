[{"type": "subtitle", "time": 16165.59, "timestamp": "04:29:25", "text": "嗨，我们有两个 F 代表富兰克林。我们开始吧"}, {"type": "subtitle", "time": 16168.55, "timestamp": "04:29:28", "text": "看看这样行不行。几乎就要成功了"}, {"type": "subtitle", "time": 16185.189, "timestamp": "04:29:45", "text": "但我究竟要去哪里呢？我其实"}, {"type": "subtitle", "time": 16196.71, "timestamp": "04:29:56", "text": "我们是要去迈克尔家吗？"}]
[{"type": "subtitle", "time": 6426.07, "timestamp": "01:47:06", "text": "哦，我找到你了。没关系。"}, {"type": "subtitle", "time": 6428.55, "timestamp": "01:47:08", "text": "你好，艾丽莎。欢迎来到直播间。"}, {"type": "subtitle", "time": 6429.669, "timestamp": "01:47:09", "text": "[音乐]"}, {"type": "subtitle", "time": 6438.149, "timestamp": "01:47:18", "text": "电话头砸到你了吗？"}, {"type": "subtitle", "time": 6440.39, "timestamp": "01:47:20", "text": "是的。"}, {"type": "subtitle", "time": 6443.43, "timestamp": "01:47:23", "text": "好了，我想我们已经准备好了。"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "好了，现在才是棘手的部分。"}, {"type": "subtitle", "time": 6447.84, "timestamp": "01:47:27", "text": "部分。 好的。"}, {"type": "subtitle", "time": 6479.21, "timestamp": "01:47:59", "text": "好，我们走吧。"}]
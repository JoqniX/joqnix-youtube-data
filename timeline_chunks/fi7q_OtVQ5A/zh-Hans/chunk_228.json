[{"type": "subtitle", "time": 13708.87, "timestamp": "03:48:28", "text": "DJ Snake最近在忙些什么呢？我"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "随时了解他的音乐动态。"}, {"type": "subtitle", "time": 13716.87, "timestamp": "03:48:36", "text": "他最近在忙些什么呢？"}, {"type": "subtitle", "time": 13719.03, "timestamp": "03:48:39", "text": "我对很多事情都一无所知。"}, {"type": "subtitle", "time": 13722.469, "timestamp": "03:48:42", "text": "我曾经是音乐剧作家。"}, {"type": "subtitle", "time": 13725.44, "timestamp": "03:48:45", "text": "积极关注。"}, {"type": "subtitle", "time": 13735.03, "timestamp": "03:48:55", "text": "我们走吧。是的，那是最后的……"}, {"type": "subtitle", "time": 13739.349, "timestamp": "03:48:59", "text": "我们需要一辆逃跑用的车。现在我们可以做到了。"}]
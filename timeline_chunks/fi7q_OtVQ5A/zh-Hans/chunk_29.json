[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "它。这些boss的判定框很奇怪。"}, {"type": "subtitle", "time": 1743.51, "timestamp": "00:29:03", "text": "男人。"}, {"type": "subtitle", "time": 1745.75, "timestamp": "00:29:05", "text": "他们来了。我是"}, {"type": "subtitle", "time": 1747.59, "timestamp": "00:29:07", "text": "你知道吗？很好。这很棒。"}, {"type": "subtitle", "time": 1749.59, "timestamp": "00:29:09", "text": "太棒了。就像这是"}, {"type": "subtitle", "time": 1751.35, "timestamp": "00:29:11", "text": "更新的第二天，所以我不能……"}, {"type": "subtitle", "time": 1754.63, "timestamp": "00:29:14", "text": "对此我非常生气。为什么门口不是"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "在职的？即将开始。哦，你你"}, {"type": "subtitle", "time": 1759.75, "timestamp": "00:29:19", "text": "也明白了吗？我的天啊。"}, {"type": "subtitle", "time": 1762.549, "timestamp": "00:29:22", "text": "嘿，使命召唤。你们很多人"}, {"type": "subtitle", "time": 1766.31, "timestamp": "00:29:26", "text": "你得把你的烂摊子收拾好，伙计。"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "是的。哦，有虫子。车子颠簸颠簸。游戏中"}, {"type": "subtitle", "time": 1774.789, "timestamp": "00:29:34", "text": "世界。"}, {"type": "subtitle", "time": 1777.35, "timestamp": "00:29:37", "text": "哦，对了，我们当时好像在计划"}, {"type": "subtitle", "time": 1781.19, "timestamp": "00:29:41", "text": "就像……呃……直播……呃……你……"}, {"type": "subtitle", "time": 1783.909, "timestamp": "00:29:43", "text": "那叫什么？就是那个绝地求生的事。 PUBG"}, {"type": "subtitle", "time": 1786.47, "timestamp": "00:29:46", "text": "游戏。实际上我们俩实际上"}, {"type": "subtitle", "time": 1790.63, "timestamp": "00:29:50", "text": "测试了游戏，但它不是，它不是"}, {"type": "subtitle", "time": 1793.83, "timestamp": "00:29:53", "text": "依我看，它并不算最好。它"}, {"type": "subtitle", "time": 1795.83, "timestamp": "00:29:55", "text": "还没有完全打磨好。非常"}, {"type": "subtitle", "time": 1797.59, "timestamp": "00:29:57", "text": "恼人的。韦恩很讨厌它。哦，是吗？"}]
[{"type": "subtitle", "time": 17175.59, "timestamp": "04:46:15", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 17183.75, "timestamp": "04:46:23", "text": "完成它需要20分钟。"}, {"type": "subtitle", "time": 17188.47, "timestamp": "04:46:28", "text": "真的吗？我关门了。差得远了。"}, {"type": "subtitle", "time": 17195.99, "timestamp": "04:46:35", "text": "我们去找莱斯特。我们打车去。"}, {"type": "subtitle", "time": 17197.91, "timestamp": "04:46:37", "text": "实际上，"}, {"type": "subtitle", "time": 17200.868, "timestamp": "04:46:40", "text": "我得离开这里。"}]
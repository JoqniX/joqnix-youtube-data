[{"type": "subtitle", "time": 20283.91, "timestamp": "05:38:03", "text": "喂饱你。我除掉你。看看你。"}, {"type": "subtitle", "time": 20288.07, "timestamp": "05:38:08", "text": "你一直是个忘恩负义、卑鄙无耻的人，"}, {"type": "subtitle", "time": 20291.11, "timestamp": "05:38:11", "text": "一个哭哭啼啼、卑鄙无耻的男孩。你"}, {"type": "subtitle", "time": 20295.11, "timestamp": "05:38:15", "text": "我知道，我也知道。一直以来都是如此"}, {"type": "subtitle", "time": 20298.39, "timestamp": "05:38:18", "text": "你肯定有问题。感到羞愧"}, {"type": "subtitle", "time": 20302.07, "timestamp": "05:38:22", "text": "你自己。我为自己感到羞耻。你自己的"}, {"type": "subtitle", "time": 20305.99, "timestamp": "05:38:25", "text": "母亲。我在这里已经待了好几个小时了，"}, {"type": "subtitle", "time": 20308.548, "timestamp": "05:38:28", "text": "你给我拿饮料了吗？"}, {"type": "subtitle", "time": 20312.948, "timestamp": "05:38:32", "text": "抽根烟还是给我按摩脚？"}, {"type": "subtitle", "time": 20317.35, "timestamp": "05:38:37", "text": "我是一位老妇人，而你正值壮年。"}, {"type": "subtitle", "time": 20321.99, "timestamp": "05:38:41", "text": "生活。你什么都没有吗？"}, {"type": "subtitle", "time": 20334.31, "timestamp": "05:38:54", "text": "那里。没关系，儿子。"}, {"type": "subtitle", "time": 20338.31, "timestamp": "05:38:58", "text": "哦，原来是这样。现在，"}]
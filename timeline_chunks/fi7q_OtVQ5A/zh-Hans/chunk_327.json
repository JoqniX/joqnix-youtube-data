[{"type": "subtitle", "time": 19635.59, "timestamp": "05:27:15", "text": "你真是个足智多谋的人。"}, {"type": "subtitle", "time": 19637.11, "timestamp": "05:27:17", "text": "我需要像你这样的人在我身边"}, {"type": "subtitle", "time": 19655.27, "timestamp": "05:27:35", "text": "有些人对你很有用。"}, {"type": "subtitle", "time": 19657.11, "timestamp": "05:27:37", "text": "以及那些不是的人和那些"}, {"type": "subtitle", "time": 19661.67, "timestamp": "05:27:41", "text": "不必走。我？我不是。我不"}, {"type": "subtitle", "time": 19665.35, "timestamp": "05:27:45", "text": "关心自己是否有用。我感觉"}, {"type": "subtitle", "time": 19668.628, "timestamp": "05:27:48", "text": "就像带你出去玩一样。这就是我"}, {"type": "subtitle", "time": 19675.99, "timestamp": "05:27:55", "text": "你将拥有的一切，我拥有的一切"}, {"type": "subtitle", "time": 19677.99, "timestamp": "05:27:57", "text": "我想要的是看着你忽进忽出。"}, {"type": "subtitle", "time": 19679.67, "timestamp": "05:27:59", "text": "意识，然后慢慢地"}]
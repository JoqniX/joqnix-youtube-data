[{"type": "subtitle", "time": 14885.189, "timestamp": "04:08:05", "text": "捡起。上面情况怎么样？不是"}, {"type": "subtitle", "time": 14887.11, "timestamp": "04:08:07", "text": "好兄弟。梅利韦瑟知道我们采取了"}, {"type": "subtitle", "time": 14890.07, "timestamp": "04:08:10", "text": "UD。他们正在外面找你。"}, {"type": "subtitle", "time": 14901.51, "timestamp": "04:08:21", "text": "哦不，是电话。"}, {"type": "subtitle", "time": 14903.03, "timestamp": "04:08:23", "text": "希望你已经找到解决办法了。"}, {"type": "subtitle", "time": 14905.11, "timestamp": "04:08:25", "text": "问题。等等，什么？是的，狗。我们拥有"}, {"type": "subtitle", "time": 14907.99, "timestamp": "04:08:27", "text": "它。好的，好的，好的。链接已激活"}, {"type": "subtitle", "time": 14909.99, "timestamp": "04:08:29", "text": "现在。你可以控制交通信号灯。"}, {"type": "subtitle", "time": 14912.95, "timestamp": "04:08:32", "text": "我们走吧。祝你好运。嘿，我们明白了。"}, {"type": "subtitle", "time": 14915.349, "timestamp": "04:08:35", "text": "哇，这看起来挺简单的。简单的"}, {"type": "subtitle", "time": 14918.07, "timestamp": "04:08:38", "text": "足够的。"}, {"type": "subtitle", "time": 14925.67, "timestamp": "04:08:45", "text": "箭头指向迈克尔"}, {"type": "subtitle", "time": 14937.51, "timestamp": "04:08:57", "text": "找到了。好的，"}]
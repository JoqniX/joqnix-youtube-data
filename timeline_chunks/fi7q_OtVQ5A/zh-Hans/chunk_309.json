[{"type": "subtitle", "time": 18541.27, "timestamp": "05:09:01", "text": "还有富兰克林·斯特雷奇。拉紧。是的，"}, {"type": "subtitle", "time": 18543.27, "timestamp": "05:09:03", "text": "男人。你看，他的真名叫哈罗德"}, {"type": "subtitle", "time": 18545.91, "timestamp": "05:09:05", "text": "约瑟夫。好的。嗯，我可以告诉你……"}, {"type": "subtitle", "time": 18548.07, "timestamp": "05:09:08", "text": "海恩斯探员正在录制一档节目。"}, {"type": "subtitle", "time": 18550.39, "timestamp": "05:09:10", "text": "德尔佩罗。射击许可证的事出现了"}, {"type": "subtitle", "time": 18552.39, "timestamp": "05:09:12", "text": "立即地。"}, {"type": "subtitle", "time": 18554.15, "timestamp": "05:09:14", "text": "我一直想把那混蛋冻死"}, {"type": "subtitle", "time": 18557.35, "timestamp": "05:09:17", "text": "我遇见他的那一刻。好的。好的。"}, {"type": "subtitle", "time": 18559.43, "timestamp": "05:09:19", "text": "来自哈罗德·约瑟夫先生手机的信号"}, {"type": "subtitle", "time": 18561.91, "timestamp": "05:09:21", "text": "在BJ Smith那边。"}, {"type": "subtitle", "time": 18563.51, "timestamp": "05:09:23", "text": "我抓到他了。我抓到他了。我们留住他吧。"}, {"type": "subtitle", "time": 18565.35, "timestamp": "05:09:25", "text": "清除。"}, {"type": "subtitle", "time": 18574.07, "timestamp": "05:09:34", "text": "太平洋悬崖。好的。我去问问他"}, {"type": "subtitle", "time": 18578.39, "timestamp": "05:09:38", "text": "别提他那副朋克屁股了。当我找到先生时"}, {"type": "subtitle", "time": 18579.51, "timestamp": "05:09:39", "text": "好的。"}, {"type": "subtitle", "time": 18581.43, "timestamp": "05:09:41", "text": "哇，"}, {"type": "subtitle", "time": 18586.39, "timestamp": "05:09:46", "text": "大家都要走了。哦，"}]
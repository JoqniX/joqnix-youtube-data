[{"type": "subtitle", "time": 600.389, "timestamp": "00:10:00", "text": "我没事。我一切都好。"}, {"type": "subtitle", "time": 607.43, "timestamp": "00:10:07", "text": "凉爽的。凉爽的。凉爽的。凉爽的。没关系。它是"}, {"type": "subtitle", "time": 608.79, "timestamp": "00:10:08", "text": "美好的。没关系。我只是想知道他在哪里？"}, {"type": "subtitle", "time": 610.07, "timestamp": "00:10:10", "text": "他在哪儿？他在哪儿？他在哪儿？"}, {"type": "subtitle", "time": 613.43, "timestamp": "00:10:13", "text": "在最上面。重新装弹。在最上面。在最上面。耶稣"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "基督。我的天啊。他在哪儿？你知道"}, {"type": "subtitle", "time": 618.15, "timestamp": "00:10:18", "text": "什么？他只是……他处于领先地位吗？它要走了"}, {"type": "subtitle", "time": 623.269, "timestamp": "00:10:23", "text": "要幽默。他处于领先地位。"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "我要黑掉他。准备黑掉"}, {"type": "subtitle", "time": 628.87, "timestamp": "00:10:28", "text": "他。哦，你可以黑掉他。哦，我可以"}, {"type": "subtitle", "time": 640.389, "timestamp": "00:10:40", "text": "是的。你好，P。你好吗？欢迎。"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "你们"}, {"type": "subtitle", "time": 644.63, "timestamp": "00:10:44", "text": "需要备份。你的队友已经"}, {"type": "subtitle", "time": 646.15, "timestamp": "00:10:46", "text": "被杀。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "好吧，我想我安全了。我不知道。"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "我安全吗？是的。该区域已消失。这"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "区域已经消失了。好的。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "我们赢了。他伤得更重了，他就……"}]
[{"type": "subtitle", "time": 8642.55, "timestamp": "02:24:02", "text": "我喜欢他们把《塞尔达传说》放进去"}, {"type": "subtitle", "time": 8647.51, "timestamp": "02:24:07", "text": "那个东西。这件乐器。"}, {"type": "subtitle", "time": 8649.99, "timestamp": "02:24:09", "text": "你应该加上“如果还有更多泡沫的话”"}, {"type": "subtitle", "time": 8653.429, "timestamp": "02:24:13", "text": "把M放进去。"}, {"type": "subtitle", "time": 8656.07, "timestamp": "02:24:16", "text": "我只要碰你一下，你就会……"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "复活了。"}, {"type": "subtitle", "time": 8668.309, "timestamp": "02:24:28", "text": "好了，我想我都准备好了。"}, {"type": "subtitle", "time": 8671.75, "timestamp": "02:24:31", "text": "哦，不。那里。好了，我现在有"}, {"type": "subtitle", "time": 8673.27, "timestamp": "02:24:33", "text": "一切。唯一我抓不到的东西"}, {"type": "subtitle", "time": 8677.27, "timestamp": "02:24:37", "text": "是花瓶。如果我得到你，那么我们"}]
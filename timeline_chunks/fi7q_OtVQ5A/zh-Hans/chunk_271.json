[{"type": "subtitle", "time": 16262.71, "timestamp": "04:31:02", "text": "有一张黑胶唱片和一张CGJ"}, {"type": "subtitle", "time": 16266.149, "timestamp": "04:31:06", "text": "和 a 和 a 的混合"}, {"type": "subtitle", "time": 16267.99, "timestamp": "04:31:07", "text": "什么？"}, {"type": "subtitle", "time": 16270.79, "timestamp": "04:31:10", "text": "嘿，斯利克。这就是我。"}, {"type": "subtitle", "time": 16272.63, "timestamp": "04:31:12", "text": "你他妈到底想干什么？你得到了我的"}, {"type": "subtitle", "time": 16275.03, "timestamp": "04:31:15", "text": "资金泵？嘿，你那儿有椰子吗？"}, {"type": "subtitle", "time": 16276.149, "timestamp": "04:31:16", "text": "水之类的东西？我需要"}, {"type": "subtitle", "time": 16278.63, "timestamp": "04:31:18", "text": "一些电解质。该死，这有点……"}, {"type": "subtitle", "time": 16281.189, "timestamp": "04:31:21", "text": "很暖和，不是吗？嘿，你死了"}, {"type": "subtitle", "time": 16283.11, "timestamp": "04:31:23", "text": "许愿之类的。我应该杀人吗？"}, {"type": "subtitle", "time": 16288.55, "timestamp": "04:31:28", "text": "你现在？哦，不，兄弟。不是我。"}, {"type": "subtitle", "time": 16290.07, "timestamp": "04:31:30", "text": "不。"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "哦，是的。但那是我儿子。是的，但是"}, {"type": "subtitle", "time": 16295.91, "timestamp": "04:31:35", "text": "那是我儿子。他背叛了所有人。"}, {"type": "subtitle", "time": 16297.83, "timestamp": "04:31:37", "text": "他一直都知道。他让你参与进来了。"}, {"type": "subtitle", "time": 16299.91, "timestamp": "04:31:39", "text": "与联邦政府"}, {"type": "subtitle", "time": 16301.99, "timestamp": "04:31:41", "text": "我的几项商业投资。他"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "必须离开。你知道吗？ ID"}, {"type": "subtitle", "time": 16305.83, "timestamp": "04:31:45", "text": "我想说这并非针对个人，"}, {"type": "subtitle", "time": 16308.389, "timestamp": "04:31:48", "text": "但这是个人私事。但是联邦政府啊，"}, {"type": "subtitle", "time": 16310.309, "timestamp": "04:31:50", "text": "那些家伙让我杀了特雷弗。和"}, {"type": "subtitle", "time": 16312.309, "timestamp": "04:31:52", "text": "我显然不可能把他们两个都杀了。这"}, {"type": "subtitle", "time": 16316.07, "timestamp": "04:31:56", "text": "联邦调查局、史蒂夫、戴夫·诺顿。我拥有购物"}, {"type": "subtitle", "time": 16317.75, "timestamp": "04:31:57", "text": "购物中心。我不会雇用那两个人。"}]
[{"type": "subtitle", "time": 1204.95, "timestamp": "00:20:04", "text": "和队友一起消灭昆虫"}, {"type": "subtitle", "time": 1207.35, "timestamp": "00:20:07", "text": "泰坦龙。"}, {"type": "subtitle", "time": 1210.15, "timestamp": "00:20:10", "text": "哦，我有10颗子弹。我这就去"}, {"type": "subtitle", "time": 1213.43, "timestamp": "00:20:13", "text": "用尽我所知道的所有伎俩，没有"}, {"type": "subtitle", "time": 1228.71, "timestamp": "00:20:28", "text": "韦恩和你在一起。哦，雅克是"}, {"type": "subtitle", "time": 1231.669, "timestamp": "00:20:31", "text": "与我一起。对了，韦恩在哪儿？"}, {"type": "subtitle", "time": 1233.38, "timestamp": "00:20:33", "text": "哦，"}, {"type": "subtitle", "time": 1238.63, "timestamp": "00:20:38", "text": "不，不，别担心。我支持我"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "比如帮你灭火。你好。"}, {"type": "subtitle", "time": 1244.87, "timestamp": "00:20:44", "text": "我在这里。哦，是的。下来。哦，他"}, {"type": "subtitle", "time": 1247.83, "timestamp": "00:20:47", "text": "死了。哦，不错。好的。好的，我当时正在做"}, {"type": "subtitle", "time": 1249.59, "timestamp": "00:20:49", "text": "灭火行动相当激烈"}, {"type": "subtitle", "time": 1256.47, "timestamp": "00:20:56", "text": "朋友，你做的任何事都谈不上惊天动地。我"}, {"type": "subtitle", "time": 1258.789, "timestamp": "00:20:58", "text": "躲开了。走开，韦恩。前往"}]
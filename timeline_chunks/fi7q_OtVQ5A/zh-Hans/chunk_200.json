[{"type": "subtitle", "time": 12012.95, "timestamp": "03:20:12", "text": "[音乐]"}, {"type": "subtitle", "time": 12015.75, "timestamp": "03:20:15", "text": "叮叮当当的摇摆声。"}, {"type": "subtitle", "time": 12018.15, "timestamp": "03:20:18", "text": "叮叮当当的响声。"}, {"type": "subtitle", "time": 12020.87, "timestamp": "03:20:20", "text": "你是说《铃儿响叮当》吗？"}, {"type": "subtitle", "time": 12036.229, "timestamp": "03:20:36", "text": "不，他没死，但是"}, {"type": "subtitle", "time": 12043.67, "timestamp": "03:20:43", "text": "怎么样？"}, {"type": "subtitle", "time": 12052.309, "timestamp": "03:20:52", "text": "安娜是谁？"}]
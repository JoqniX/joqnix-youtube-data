[{"type": "subtitle", "time": 11895.349, "timestamp": "03:18:15", "text": "所以，我附近的一家购物中心就有这个"}, {"type": "subtitle", "time": 11898.63, "timestamp": "03:18:18", "text": "类似停车场之类的东西。"}, {"type": "subtitle", "time": 11901.19, "timestamp": "03:18:21", "text": "我希望有一天能开着我的车，嗖的一声就走了。"}, {"type": "subtitle", "time": 11903.51, "timestamp": "03:18:23", "text": "然后就像上到屋顶那样，"}, {"type": "subtitle", "time": 11905.51, "timestamp": "03:18:25", "text": "停车"}, {"type": "subtitle", "time": 11923.99, "timestamp": "03:18:43", "text": "逃回洛杉矶"}, {"type": "subtitle", "time": 11926.63, "timestamp": "03:18:46", "text": "呃，海关。好了，我们走吧。我们开始吧"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "我应该做一个合格的平民吗？和"}]
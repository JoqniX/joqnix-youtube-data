[{"type": "subtitle", "time": 11821.67, "timestamp": "03:17:01", "text": "放宽点，因为我知道我"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "会崩溃。所以我不会那样做。"}, {"type": "subtitle", "time": 11827.75, "timestamp": "03:17:07", "text": "所以我就停下来，就像你知道的，拿走"}, {"type": "subtitle", "time": 11829.67, "timestamp": "03:17:09", "text": "大学教师。"}, {"type": "subtitle", "time": 11837.19, "timestamp": "03:17:17", "text": "我的天啊。"}, {"type": "subtitle", "time": 11846.389, "timestamp": "03:17:26", "text": "[音乐]"}, {"type": "subtitle", "time": 11849.91, "timestamp": "03:17:29", "text": "我刚出来。哦，我本来应该去的"}, {"type": "subtitle", "time": 11859.03, "timestamp": "03:17:39", "text": "我该去哪儿呢？好的，"}, {"type": "subtitle", "time": 11866.63, "timestamp": "03:17:46", "text": "哦，我崩溃了。不，没关系。"}, {"type": "subtitle", "time": 11869.349, "timestamp": "03:17:49", "text": "我的骑行方式更酷。我会超级棒"}, {"type": "subtitle", "time": 11870.95, "timestamp": "03:17:50", "text": "小心。别担心，查德。甚至"}, {"type": "subtitle", "time": 11875.19, "timestamp": "03:17:55", "text": "如果我在这里做，就不要在其他地方做。"}, {"type": "subtitle", "time": 11877.91, "timestamp": "03:17:57", "text": "家。好的？"}]
[{"type": "subtitle", "time": 13800.71, "timestamp": "03:50:00", "text": "太多还是不喜欢"}, {"type": "subtitle", "time": 13803.11, "timestamp": "03:50:03", "text": "我真不知道现在的孩子们都怎么了。"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "思考。"}, {"type": "subtitle", "time": 13806.63, "timestamp": "03:50:06", "text": "我就像每当我认识的人那样。"}, {"type": "subtitle", "time": 13810.469, "timestamp": "03:50:10", "text": "人们经常随意使用“bro”这个词，但"}, {"type": "subtitle", "time": 13812.95, "timestamp": "03:50:12", "text": "有点儿"}, {"type": "subtitle", "time": 13817.189, "timestamp": "03:50:17", "text": "感觉有点……不太对劲。我不"}, {"type": "subtitle", "time": 13818.95, "timestamp": "03:50:18", "text": "知道。"}, {"type": "subtitle", "time": 13820.55, "timestamp": "03:50:20", "text": "没跑题。我不知道那是什么"}, {"type": "subtitle", "time": 13822.87, "timestamp": "03:50:22", "text": "词语是但是"}, {"type": "subtitle", "time": 13829.51, "timestamp": "03:50:29", "text": "呃"}, {"type": "subtitle", "time": 13832.71, "timestamp": "03:50:32", "text": "是的，兄弟们"}, {"type": "subtitle", "time": 13835.67, "timestamp": "03:50:35", "text": "兄弟没事，但是就像，比如说如果"}, {"type": "subtitle", "time": 13837.11, "timestamp": "03:50:37", "text": "你就像是在说，如果我在谈论……"}, {"type": "subtitle", "time": 13840.95, "timestamp": "03:50:40", "text": "有什么东西，然后你，某人，就走了"}, {"type": "subtitle", "time": 13843.59, "timestamp": "03:50:43", "text": "兄弟，你感觉有点像"}, {"type": "subtitle", "time": 13846.309, "timestamp": "03:50:46", "text": "被忽略和喜欢"}, {"type": "subtitle", "time": 13850.389, "timestamp": "03:50:50", "text": "感觉自己好像被忽视了，而且"}, {"type": "subtitle", "time": 13854.55, "timestamp": "03:50:54", "text": "没有得到应有的关注和尊重"}, {"type": "subtitle", "time": 13856.07, "timestamp": "03:50:56", "text": "正确的。"}, {"type": "subtitle", "time": 13859.11, "timestamp": "03:50:59", "text": "其实我并不想那样。"}]
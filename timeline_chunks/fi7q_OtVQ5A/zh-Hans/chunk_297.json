[{"type": "subtitle", "time": 17824.23, "timestamp": "04:57:04", "text": "你必须杀了他们。让他们不"}, {"type": "subtitle", "time": 17850.708, "timestamp": "04:57:30", "text": "稍等，我这就去找你。"}, {"type": "subtitle", "time": 17863.11, "timestamp": "04:57:43", "text": "如果我必须拯救，那就不对了。"}, {"type": "subtitle", "time": 17866.07, "timestamp": "04:57:46", "text": "你屁股就一次。救救我，兄弟。我"}]
[{"type": "subtitle", "time": 17255.67, "timestamp": "04:47:35", "text": "把车停在这边。出去。"}, {"type": "subtitle", "time": 17263.83, "timestamp": "04:47:43", "text": "叫出租车。"}, {"type": "subtitle", "time": 17265.99, "timestamp": "04:47:45", "text": "即时DP。"}, {"type": "subtitle", "time": 17268.31, "timestamp": "04:47:48", "text": "嘿，我能叫辆出租车吗？"}, {"type": "subtitle", "time": 17270.948, "timestamp": "04:47:50", "text": "应该很快就能送到你那里了。听起来不错。"}, {"type": "subtitle", "time": 17273.19, "timestamp": "04:47:53", "text": "男人。我迫不及待地想卸载它。"}, {"type": "subtitle", "time": 17276.708, "timestamp": "04:47:56", "text": "游戏。我对此感到非常高兴。哦，"}]
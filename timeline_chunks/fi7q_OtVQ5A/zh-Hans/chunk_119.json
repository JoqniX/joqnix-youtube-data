[{"type": "subtitle", "time": 7142.79, "timestamp": "01:59:02", "text": "方式。哦，不。回去。回去。不。不。"}, {"type": "subtitle", "time": 7145.589, "timestamp": "01:59:05", "text": "直接进那个房间。"}, {"type": "subtitle", "time": 7148.629, "timestamp": "01:59:08", "text": "是的。呃，就是这个。不，不，下一个。呃，"}, {"type": "subtitle", "time": 7150.629, "timestamp": "01:59:10", "text": "另一个。另一个。是的。好的，继续"}, {"type": "subtitle", "time": 7153.03, "timestamp": "01:59:13", "text": "走到那里，然后往前走，再抬头看"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "那里。抬头。抬头。"}, {"type": "subtitle", "time": 7159.99, "timestamp": "01:59:19", "text": "不，转身。回转。哦，"}, {"type": "subtitle", "time": 7168.39, "timestamp": "01:59:28", "text": "我不知道。魔法。"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "冰雪女神的力量，我"}, {"type": "subtitle", "time": 7179.91, "timestamp": "01:59:39", "text": "我的天啊。我的天哪。我的天哪。我的天哪。哦"}, {"type": "subtitle", "time": 7183.589, "timestamp": "01:59:43", "text": "上帝。哦，不。我的天啊。这到底是怎么回事？"}, {"type": "subtitle", "time": 7190.149, "timestamp": "01:59:50", "text": "他刚刚被杀了。"}]
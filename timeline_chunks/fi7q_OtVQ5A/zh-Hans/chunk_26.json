[{"type": "subtitle", "time": 1566.149, "timestamp": "00:26:06", "text": "兴奋极了。我为什么会感到兴奋？我"}, {"type": "subtitle", "time": 1567.99, "timestamp": "00:26:07", "text": "不知道。"}, {"type": "subtitle", "time": 1573.51, "timestamp": "00:26:13", "text": "我感觉糟透了。这很糟糕。"}, {"type": "subtitle", "time": 1575.99, "timestamp": "00:26:15", "text": "我的我的"}, {"type": "subtitle", "time": 1578.23, "timestamp": "00:26:18", "text": "哦，等等。没有摔伤。哦，是"}, {"type": "subtitle", "time": 1579.99, "timestamp": "00:26:19", "text": "是否有跌落损伤？有。有"}, {"type": "subtitle", "time": 1583.269, "timestamp": "00:26:23", "text": "顺便提一下，这是摔伤造成的。哦，该死。我当时"}, {"type": "subtitle", "time": 1585.35, "timestamp": "00:26:25", "text": "那些天真的瓷砖之一，以为"}, {"type": "subtitle", "time": 1587.11, "timestamp": "00:26:27", "text": "就像那家伙回来了一样。这个人是"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "后退。那家伙回来了。是的。哦，真棒。"}, {"type": "subtitle", "time": 1598.95, "timestamp": "00:26:38", "text": "哦，该死。耶稣基督，人啊。"}, {"type": "subtitle", "time": 1600.71, "timestamp": "00:26:40", "text": "哦，他在那里。有个家伙在露营。有"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "一个露营的人。有个男的在露营。"}, {"type": "subtitle", "time": 1604.47, "timestamp": "00:26:44", "text": "有个男的在露营。有个家伙"}, {"type": "subtitle", "time": 1615.11, "timestamp": "00:26:55", "text": "好的。哦，我们赢了。好的。我们赢了。"}]
[{"type": "subtitle", "time": 15246.389, "timestamp": "04:14:06", "text": "死的。我想就是这样了。"}, {"type": "subtitle", "time": 15252.389, "timestamp": "04:14:12", "text": "子弹革命。我们总是得到"}, {"type": "subtitle", "time": 15254.87, "timestamp": "04:14:14", "text": "我耍了你。"}, {"type": "subtitle", "time": 15256.95, "timestamp": "04:14:16", "text": "你们车上的其他乘客。我们离开"}, {"type": "subtitle", "time": 15258.79, "timestamp": "04:14:18", "text": "趁我们还能做到的时候。嘿，是什么阻止了我"}, {"type": "subtitle", "time": 15261.429, "timestamp": "04:14:21", "text": "从骑马奔向夕阳开始，我"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "马鞍包？莱斯特唯一的翻板金属"}, {"type": "subtitle", "time": 15278.95, "timestamp": "04:14:38", "text": "它是六星级的。我的天哪。五星好评。哦，我的"}, {"type": "subtitle", "time": 15291.67, "timestamp": "04:14:51", "text": "我的天啊。"}]
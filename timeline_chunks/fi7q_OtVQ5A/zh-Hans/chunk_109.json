[{"type": "subtitle", "time": 6545.669, "timestamp": "01:49:05", "text": "哦，2万。哦，是的。"}, {"type": "subtitle", "time": 6548.79, "timestamp": "01:49:08", "text": "我们所有的钱都打了水漂。"}, {"type": "subtitle", "time": 6551.189, "timestamp": "01:49:11", "text": "我不认为它有无限弹药。"}, {"type": "subtitle", "time": 6555.03, "timestamp": "01:49:15", "text": "正确的？不，那个故障也消失了，我"}, {"type": "subtitle", "time": 6557.03, "timestamp": "01:49:17", "text": "害怕的。"}, {"type": "subtitle", "time": 6558.87, "timestamp": "01:49:18", "text": "它有一定的数量。然后你"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "需要七八充电 9 10 11 12 13。"}, {"type": "subtitle", "time": 6568.87, "timestamp": "01:49:28", "text": "它没有那么多。这是作弊的。"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "我不知道它是否有。这很多"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "尽管。"}, {"type": "subtitle", "time": 6579.99, "timestamp": "01:49:39", "text": "等等，真的吗？我觉得就是这样"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "无限的。"}, {"type": "subtitle", "time": 6583.91, "timestamp": "01:49:43", "text": "当然可以，如果你想的话，但我"}, {"type": "subtitle", "time": 6586.39, "timestamp": "01:49:46", "text": "警告。那只是因为你身处其中"}, {"type": "subtitle", "time": 6589.51, "timestamp": "01:49:49", "text": "这家商店无穷无尽。"}, {"type": "subtitle", "time": 6591.75, "timestamp": "01:49:51", "text": "好的。"}, {"type": "subtitle", "time": 6599.43, "timestamp": "01:49:59", "text": "我把它掉在地上的时候它自己就开火了。哇。"}]
[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "我希望不是这样。"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "这到底是怎么回事？这到底哪里出了问题？"}, {"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "哥们儿？"}, {"type": "subtitle", "time": 7512.95, "timestamp": "02:05:12", "text": "我不知道。我甚至不知道为什么"}, {"type": "subtitle", "time": 7514.55, "timestamp": "02:05:14", "text": "他还在第一层。他将要"}, {"type": "subtitle", "time": 7521.589, "timestamp": "02:05:21", "text": "来救我吧。我的天啊。我要"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "杀了你。"}, {"type": "subtitle", "time": 7526.629, "timestamp": "02:05:26", "text": "我希望你能做到。不，不，不。"}, {"type": "subtitle", "time": 7528.709, "timestamp": "02:05:28", "text": "我不是那个意思。我并非有意"}, {"type": "subtitle", "time": 7530.47, "timestamp": "02:05:30", "text": "那。我不是那个意思。对不起。"}, {"type": "subtitle", "time": 7534.229, "timestamp": "02:05:34", "text": "对不起。对不起。对不起。"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "他处境有利吗？"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "我的天啊。没关系。你明白我的意思。你"}]
[{"type": "subtitle", "time": 12062.71, "timestamp": "03:21:02", "text": "你知道我害怕写作的原因吗？"}, {"type": "subtitle", "time": 12064.71, "timestamp": "03:21:04", "text": "今年吃香蕉。但你永远不会"}, {"type": "subtitle", "time": 12068.71, "timestamp": "03:21:08", "text": "吃了香蕉。什么？为什么？"}, {"type": "subtitle", "time": 12079.349, "timestamp": "03:21:19", "text": "等等，你从来没吃过香蕉吗？为什么不呢？"}, {"type": "subtitle", "time": 12102.469, "timestamp": "03:21:42", "text": "这是谁？趁机溜走"}, {"type": "subtitle", "time": 12116.07, "timestamp": "03:21:56", "text": "等等，我到底该去哪儿来着？"}]
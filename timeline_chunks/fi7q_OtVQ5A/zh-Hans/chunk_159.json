[{"type": "subtitle", "time": 9548.79, "timestamp": "02:39:08", "text": "我们怎么才能把购物车放进去呢？"}, {"type": "subtitle", "time": 9551.75, "timestamp": "02:39:11", "text": "那里？这样一来，萃取量就减少了。"}, {"type": "subtitle", "time": 9559.91, "timestamp": "02:39:19", "text": "我们没有。我们已经完成了141个，对吧？"}, {"type": "subtitle", "time": 9563.429, "timestamp": "02:39:23", "text": "所以，你不能再这样做了。好的。是的。"}, {"type": "subtitle", "time": 9567.75, "timestamp": "02:39:27", "text": "不用担心购物车。这"}, {"type": "subtitle", "time": 9569.429, "timestamp": "02:39:29", "text": "购物车就可以。获得"}, {"type": "subtitle", "time": 9571.19, "timestamp": "02:39:31", "text": "已摧毁。"}, {"type": "subtitle", "time": 9574.55, "timestamp": "02:39:34", "text": "是的。然后还有一次机会。好的。"}, {"type": "subtitle", "time": 9579.19, "timestamp": "02:39:39", "text": "前往卡车"}, {"type": "subtitle", "time": 9588.63, "timestamp": "02:39:48", "text": "探索。"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "我没得到足够的。"}, {"type": "subtitle", "time": 9597.11, "timestamp": "02:39:57", "text": "哦。"}]
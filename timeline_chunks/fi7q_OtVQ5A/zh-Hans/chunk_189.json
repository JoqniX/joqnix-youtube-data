[{"type": "subtitle", "time": 11340.95, "timestamp": "03:09:00", "text": "无线时代已经结束了。"}, {"type": "subtitle", "time": 11343.349, "timestamp": "03:09:03", "text": "如果没有无线网络，你的生活将会怎样？"}, {"type": "subtitle", "time": 11345.51, "timestamp": "03:09:05", "text": "是疼痛。"}, {"type": "subtitle", "time": 11348.07, "timestamp": "03:09:08", "text": "身上插满电线的生活是痛苦的。我讨厌"}, {"type": "subtitle", "time": 11349.75, "timestamp": "03:09:09", "text": "电线。"}, {"type": "subtitle", "time": 11353.99, "timestamp": "03:09:13", "text": "我喜欢无线连接方式。"}, {"type": "subtitle", "time": 11363.75, "timestamp": "03:09:23", "text": "等等，P有无线网络。等等，最新的消息。"}, {"type": "subtitle", "time": 11365.349, "timestamp": "03:09:25", "text": "W"}, {"type": "subtitle", "time": 11367.349, "timestamp": "03:09:27", "text": "好的。"}, {"type": "subtitle", "time": 11369.83, "timestamp": "03:09:29", "text": "但目前，没错，我正在攒钱"}, {"type": "subtitle", "time": 11373.19, "timestamp": "03:09:33", "text": "购买脚踏板，"}, {"type": "subtitle", "time": 11375.99, "timestamp": "03:09:35", "text": "实际上是脚踏板，因为我想买一个"}, {"type": "subtitle", "time": 11379.349, "timestamp": "03:09:39", "text": "这款线缆的脚踏板和其他线缆一样。"}, {"type": "subtitle", "time": 11382.79, "timestamp": "03:09:42", "text": "东西。我不想买那1000美元。"}, {"type": "subtitle", "time": 11387.349, "timestamp": "03:09:47", "text": "亚马逊卢比脚踏板"}, {"type": "subtitle", "time": 11390.23, "timestamp": "03:09:50", "text": "目前还没有，因为它没有"}, {"type": "subtitle", "time": 11393.91, "timestamp": "03:09:53", "text": "更新固件或软件。"}, {"type": "subtitle", "time": 11397.75, "timestamp": "03:09:57", "text": "呃，所以我……我想选择Elgato。"}]
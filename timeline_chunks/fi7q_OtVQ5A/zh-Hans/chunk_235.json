[{"type": "subtitle", "time": 14102.79, "timestamp": "03:55:02", "text": "我的天哪。"}, {"type": "subtitle", "time": 14104.95, "timestamp": "03:55:04", "text": "你好呀。"}, {"type": "subtitle", "time": 14107.11, "timestamp": "03:55:07", "text": "但就像你说的话一样"}, {"type": "subtitle", "time": 14109.429, "timestamp": "03:55:09", "text": "有人说：“嘿，哟，怎么回事？”"}, {"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "什么？"}, {"type": "subtitle", "time": 14113.75, "timestamp": "03:55:13", "text": "我心想：“等等，我刚才是不是说过……”"}, {"type": "subtitle", "time": 14116.15, "timestamp": "03:55:16", "text": "我不该有的东西？什么？嗯？"}, {"type": "subtitle", "time": 14154.07, "timestamp": "03:55:54", "text": "等等，就是这样。你说 e。你说"}]
[{"type": "subtitle", "time": 2281.829, "timestamp": "00:38:01", "text": "艾莉森，"}, {"type": "subtitle", "time": 2285.43, "timestamp": "00:38:05", "text": "等等，史蒂夫，别让我失望。"}, {"type": "subtitle", "time": 2287.19, "timestamp": "00:38:07", "text": "呃"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "邀请获取。"}, {"type": "subtitle", "time": 2294.63, "timestamp": "00:38:14", "text": "你最近怎么样？生活怎么样？呃"}, {"type": "subtitle", "time": 2303.03, "timestamp": "00:38:23", "text": "你呢？已经有一段时间了"}, {"type": "subtitle", "time": 2305.589, "timestamp": "00:38:25", "text": "我上次跟你说话。是的。是的。是的。"}, {"type": "subtitle", "time": 2308.87, "timestamp": "00:38:28", "text": "对我来说，这只是一天。我觉得呃，生活是"}, {"type": "subtitle", "time": 2312.95, "timestamp": "00:38:32", "text": "一直起起伏伏，嗯，是的"}, {"type": "subtitle", "time": 2315.19, "timestamp": "00:38:35", "text": "我原本应该去日本的。"}, {"type": "subtitle", "time": 2317.829, "timestamp": "00:38:37", "text": "原定于下个月举行，但后来推迟了。"}, {"type": "subtitle", "time": 2322.63, "timestamp": "00:38:42", "text": "明年四月。就是这样。"}, {"type": "subtitle", "time": 2325.99, "timestamp": "00:38:45", "text": "是的，那是因为政治原因。"}, {"type": "subtitle", "time": 2328.95, "timestamp": "00:38:48", "text": "在我国家，这件事就是J"}, {"type": "subtitle", "time": 2330.79, "timestamp": "00:38:50", "text": "日本学校的反应是：是啊，我们没有。"}, {"type": "subtitle", "time": 2334.31, "timestamp": "00:38:54", "text": "现在想冒个险。"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "好的。"}]
[{"type": "subtitle", "time": 2162.069, "timestamp": "00:36:02", "text": "你好。好久不见。这已经是一段"}, {"type": "subtitle", "time": 2165.75, "timestamp": "00:36:05", "text": "尽管。是的。是的。如果我记得的话"}, {"type": "subtitle", "time": 2169.109, "timestamp": "00:36:09", "text": "没错，上次我们谈话的时候……"}, {"type": "subtitle", "time": 2172.23, "timestamp": "00:36:12", "text": "他们一起玩的游戏是《我的世界》。"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "我的世界。是的。"}, {"type": "subtitle", "time": 2183.75, "timestamp": "00:36:23", "text": "确实如此。是的。是的。"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "好的。嗯，今天我们要玩的是Repo游戏。"}, {"type": "subtitle", "time": 2191.91, "timestamp": "00:36:31", "text": "正确的？嗯。是的。"}, {"type": "subtitle", "time": 2195.51, "timestamp": "00:36:35", "text": "我玩的是普通版。我从未"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "玩过测试版。哦，他们"}, {"type": "subtitle", "time": 2201.99, "timestamp": "00:36:41", "text": "又添置了一些东西。他们还没有"}, {"type": "subtitle", "time": 2206.55, "timestamp": "00:36:46", "text": "改了。嗯，很多，但更像是一种"}, {"type": "subtitle", "time": 2208.86, "timestamp": "00:36:48", "text": "我想情况可能更糟一些。"}, {"type": "subtitle", "time": 2210.71, "timestamp": "00:36:50", "text": "[音乐]"}, {"type": "subtitle", "time": 2214.47, "timestamp": "00:36:54", "text": "是的。所以，我很兴奋能玩这个游戏。"}, {"type": "subtitle", "time": 2216.79, "timestamp": "00:36:56", "text": "测试版。"}, {"type": "subtitle", "time": 2219.03, "timestamp": "00:36:59", "text": "耶。"}]
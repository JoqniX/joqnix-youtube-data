[{"type": "subtitle", "time": 9661.75, "timestamp": "02:41:01", "text": "好的。你想怎么做？"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "既然这是你的直播，那我为什么不做呢？"}, {"type": "subtitle", "time": 9669.91, "timestamp": "02:41:09", "text": "对你来说容易吗？不。不。"}, {"type": "subtitle", "time": 9671.59, "timestamp": "02:41:11", "text": "你还在等什么？我站在右边。"}, {"type": "subtitle", "time": 9673.59, "timestamp": "02:41:13", "text": "紧挨着空气。我听说了。"}, {"type": "subtitle", "time": 9676.07, "timestamp": "02:41:16", "text": "他们会把杯子做成这样，如果"}, {"type": "subtitle", "time": 9678.15, "timestamp": "02:41:18", "text": "你拿着杯子，就会受到辐射。"}, {"type": "subtitle", "time": 9680.389, "timestamp": "02:41:20", "text": "或者别的什么。等等，不，他们已经"}, {"type": "subtitle", "time": 9683.59, "timestamp": "02:41:23", "text": "已经做到了。所以如果你"}, {"type": "subtitle", "time": 9688.309, "timestamp": "02:41:28", "text": "当你拿着它的时候，它就已经像"}, {"type": "subtitle", "time": 9691.429, "timestamp": "02:41:31", "text": "嗯，噼啪声。如果你这样做，"}, {"type": "subtitle", "time": 9695.75, "timestamp": "02:41:35", "text": "看得很清楚，是的，你能听到"}, {"type": "subtitle", "time": 9698.469, "timestamp": "02:41:38", "text": "对吧？是的。我的意思是，如果你是的话，嗯，"}, {"type": "subtitle", "time": 9701.19, "timestamp": "02:41:41", "text": "那就是它在辐射，而如果你你"}, {"type": "subtitle", "time": 9705.99, "timestamp": "02:41:45", "text": "把它弄坏，它也会"}, {"type": "subtitle", "time": 9708.469, "timestamp": "02:41:48", "text": "好了。辐射。"}, {"type": "subtitle", "time": 9712.07, "timestamp": "02:41:52", "text": "哦，它会影响"}, {"type": "subtitle", "time": 9713.67, "timestamp": "02:41:53", "text": "哇，"}, {"type": "subtitle", "time": 9716.79, "timestamp": "02:41:56", "text": "它已经在那里了。哇。是的，就是这样。"}]
[{"type": "subtitle", "time": 19861.99, "timestamp": "05:31:01", "text": "例如，当他那样说的时候，它"}, {"type": "subtitle", "time": 19863.67, "timestamp": "05:31:03", "text": "有道理。当然会。嘿，"}, {"type": "subtitle", "time": 19866.788, "timestamp": "05:31:06", "text": "迪昂。再见了，我的老朋友。谢谢"}, {"type": "subtitle", "time": 19894.708, "timestamp": "05:31:34", "text": "那么，接下来该怎么办？"}, {"type": "subtitle", "time": 19896.708, "timestamp": "05:31:36", "text": "现在我们保持低调，继续前进。"}, {"type": "subtitle", "time": 19899.75, "timestamp": "05:31:39", "text": "以朋友的身份生活。"}, {"type": "subtitle", "time": 19902.788, "timestamp": "05:31:42", "text": "我还有选择吗？不，其实不是。全部"}, {"type": "subtitle", "time": 19907.35, "timestamp": "05:31:47", "text": "好的。呃，有缺陷，糟糕透了"}, {"type": "subtitle", "time": 19909.19, "timestamp": "05:31:49", "text": "非常不舒服，而且很差"}, {"type": "subtitle", "time": 19911.99, "timestamp": "05:31:51", "text": "配对成功的朋友。绝对地。哦，那是"}, {"type": "subtitle", "time": 19913.35, "timestamp": "05:31:53", "text": "完美的。然后我们就可以回到正题了。"}, {"type": "subtitle", "time": 19915.83, "timestamp": "05:31:55", "text": "我们所奉行的这种资本主义。妈的，我"}, {"type": "subtitle", "time": 19917.11, "timestamp": "05:31:57", "text": "不知道这样能好多少。"}, {"type": "subtitle", "time": 19919.35, "timestamp": "05:31:59", "text": "比德文的骗局更甚。哦，虚伪！"}]
[{"type": "subtitle", "time": 4985.91, "timestamp": "01:23:05", "text": "小鸭子在哪里？我的天，他简直"}, {"type": "subtitle", "time": 4987.27, "timestamp": "01:23:07", "text": "把它敲掉。是啊，他就像是说，“是啊，"}, {"type": "subtitle", "time": 4989.58, "timestamp": "01:23:09", "text": "我要从你身上弹过去。"}, {"type": "subtitle", "time": 4996.47, "timestamp": "01:23:16", "text": "好的。哦，他为什么在那里？哦，那"}, {"type": "subtitle", "time": 4999.189, "timestamp": "01:23:19", "text": "小矮人。哦，不。"}, {"type": "subtitle", "time": 5005.59, "timestamp": "01:23:25", "text": "恐怖小丑。"}, {"type": "subtitle", "time": 5007.51, "timestamp": "01:23:27", "text": "我死了。是的，"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "我遭到了他们的伏击，然后……"}, {"type": "subtitle", "time": 5011.83, "timestamp": "01:23:31", "text": "恐怖小丑决定他要……"}, {"type": "subtitle", "time": 5014.95, "timestamp": "01:23:34", "text": "就像这样，把我踢飞，青蛙们也跟着飞。"}, {"type": "subtitle", "time": 5017.189, "timestamp": "01:23:37", "text": "是的，我正在考虑这件事。哦，看"}, {"type": "subtitle", "time": 5022.87, "timestamp": "01:23:42", "text": "不。"}, {"type": "subtitle", "time": 5026.149, "timestamp": "01:23:46", "text": "哦，你不能再那样做了。"}, {"type": "subtitle", "time": 5030.07, "timestamp": "01:23:50", "text": "哦，你不能。不，我甚至都不打算"}, {"type": "subtitle", "time": 5032.79, "timestamp": "01:23:52", "text": "用物品砸他。不太好"}, {"type": "subtitle", "time": 5035.35, "timestamp": "01:23:55", "text": "不再是了。"}]
[{"type": "subtitle", "time": 15840.07, "timestamp": "04:24:00", "text": "愚蠢的想法。"}, {"type": "subtitle", "time": 15853.51, "timestamp": "04:24:13", "text": "我的天啊。是的。现在来说说糖。糖。拿"}, {"type": "subtitle", "time": 15855.51, "timestamp": "04:24:15", "text": "你坐在那儿的那一刻"}, {"type": "subtitle", "time": 15858.79, "timestamp": "04:24:18", "text": "一大堆现金，用来放松一下"}, {"type": "subtitle", "time": 15861.51, "timestamp": "04:24:21", "text": "走出去，意识到事情已经发生了。"}, {"type": "subtitle", "time": 15864.63, "timestamp": "04:24:24", "text": "随便你怎么说。嗯，这很好"}, {"type": "subtitle", "time": 15866.309, "timestamp": "04:24:26", "text": "时间。"}, {"type": "subtitle", "time": 15869.03, "timestamp": "04:24:29", "text": "去你的，伙计。"}, {"type": "subtitle", "time": 15871.269, "timestamp": "04:24:31", "text": "一对来自美国中西部的持械抢劫犯。你"}, {"type": "subtitle", "time": 15873.75, "timestamp": "04:24:33", "text": "男人现在确实变得很爱抱怨了。"}, {"type": "subtitle", "time": 15876.79, "timestamp": "04:24:36", "text": "西海岸的混蛋们。这他妈是什么？"}, {"type": "subtitle", "time": 15878.63, "timestamp": "04:24:38", "text": "西海岸怎么了？哦，没什么。"}, {"type": "subtitle", "time": 15880.95, "timestamp": "04:24:40", "text": "我喜欢这里。每个人都麻木了。"}, {"type": "subtitle", "time": 15883.83, "timestamp": "04:24:43", "text": "太阳。三个音节的词。他们认为"}, {"type": "subtitle", "time": 15886.309, "timestamp": "04:24:46", "text": "你是教授。去你的。去你的，"}, {"type": "subtitle", "time": 15889.11, "timestamp": "04:24:49", "text": "你这高高在上的黄鼠狼！你呢"}, {"type": "subtitle", "time": 15891.75, "timestamp": "04:24:51", "text": "别用那种居高临下的语气跟这些白痴说话。"}, {"type": "subtitle", "time": 15895.11, "timestamp": "04:24:55", "text": "嘿，别再烦莱斯特了。哦，你和"}, {"type": "subtitle", "time": 15897.189, "timestamp": "04:24:57", "text": "莱斯特在一起？哦，现在这……"}]
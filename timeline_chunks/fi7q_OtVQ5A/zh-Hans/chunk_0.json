[{"type": "subtitle", "time": 1.829, "timestamp": "00:00:01", "text": "哦，不。那可是个高手。 M. 我的来"}, {"type": "subtitle", "time": 4.39, "timestamp": "00:00:04", "text": "这里。来。去。离开。离开。去"}, {"type": "subtitle", "time": 6.309, "timestamp": "00:00:06", "text": "离开。直接杀了他。杀了他。"}, {"type": "subtitle", "time": 7.909, "timestamp": "00:00:07", "text": "我不……哦，那可不行。凉爽的。"}, {"type": "subtitle", "time": 9.669, "timestamp": "00:00:09", "text": "凉爽的。凉爽的。人太多了"}, {"type": "subtitle", "time": 11.99, "timestamp": "00:00:11", "text": "在我们周围，韦恩。是的。你完全"}, {"type": "subtitle", "time": 14.95, "timestamp": "00:00:14", "text": "即将死去。人真多。一部电影。"}, {"type": "subtitle", "time": 16.79, "timestamp": "00:00:16", "text": "离开。"}, {"type": "subtitle", "time": 19.83, "timestamp": "00:00:19", "text": "我不会死。"}, {"type": "subtitle", "time": 23.67, "timestamp": "00:00:23", "text": "离开。给我一把破枪，你个笨蛋。"}, {"type": "subtitle", "time": 26.63, "timestamp": "00:00:26", "text": "你没有枪。你当时有枪。"}, {"type": "subtitle", "time": 30.87, "timestamp": "00:00:30", "text": "盔甲。啊，天哪。你不是认真的吧？"}, {"type": "subtitle", "time": 33.11, "timestamp": "00:00:33", "text": "快点。快点。快点。离开。我"}, {"type": "subtitle", "time": 36.47, "timestamp": "00:00:36", "text": "不在乎。把你的枪给我。"}, {"type": "subtitle", "time": 45.27, "timestamp": "00:00:45", "text": "好的。我觉得我不需要哦，天哪。这"}, {"type": "subtitle", "time": 48.229, "timestamp": "00:00:48", "text": "一。啊，里面没有弹药。该死的"}, {"type": "subtitle", "time": 55.75, "timestamp": "00:00:55", "text": "我遇到了一些问题。"}]
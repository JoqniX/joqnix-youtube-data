[{"type": "subtitle", "time": 2525.27, "timestamp": "00:42:05", "text": "上帝。这款游戏。等待。等待。呃，我应该……"}, {"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": "等等？我觉得我应该重新装弹了。"}, {"type": "subtitle", "time": 2529.19, "timestamp": "00:42:09", "text": "是Steam，对吧？"}, {"type": "subtitle", "time": 2532.23, "timestamp": "00:42:12", "text": "我正在展示我的Steam屏幕。好的。"}, {"type": "subtitle", "time": 2535.51, "timestamp": "00:42:15", "text": "所以，你就能看出哪些是优先事项了。"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "你从这里开始修改。"}, {"type": "subtitle", "time": 2544.15, "timestamp": "00:42:24", "text": "这个是B。是的。你点击了左键"}, {"type": "subtitle", "time": 2545.829, "timestamp": "00:42:25", "text": "或者右键点击它。不，右键点击它。"}, {"type": "subtitle", "time": 2548.39, "timestamp": "00:42:28", "text": "你先确定优先级，然后再改变。"}, {"type": "subtitle", "time": 2550.63, "timestamp": "00:42:30", "text": "它通过 B。"}, {"type": "subtitle", "time": 2553.43, "timestamp": "00:42:33", "text": "优先级。"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "隐私。等等，优先级在哪里？"}, {"type": "subtitle", "time": 2561.03, "timestamp": "00:42:41", "text": "P 特性。就在最底部。"}, {"type": "subtitle", "time": 2571.19, "timestamp": "00:42:51", "text": "然后进入测试版页面，选择这个版本。"}, {"type": "subtitle", "time": 2576.79, "timestamp": "00:42:56", "text": "是的，上面写着……测试版分支。所以"}, {"type": "subtitle", "time": 2579.589, "timestamp": "00:42:59", "text": "好的，我再把它放到 beta 分支。"}]
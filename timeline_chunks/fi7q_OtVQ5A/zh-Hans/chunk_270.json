[{"type": "subtitle", "time": 16204.63, "timestamp": "04:30:04", "text": "我相信。是的，那是迈克尔的房子。"}, {"type": "subtitle", "time": 16231.429, "timestamp": "04:30:31", "text": "这是他的房子。哇。"}, {"type": "subtitle", "time": 16242.71, "timestamp": "04:30:42", "text": "他像没事人一样把头盔放下来了。"}, {"type": "subtitle", "time": 16253.03, "timestamp": "04:30:53", "text": "你见过迈克·亨特吗？迈克是谁？"}, {"type": "subtitle", "time": 16259.59, "timestamp": "04:30:59", "text": "他有一套DJ设备。我的天啊。什么？他"}]
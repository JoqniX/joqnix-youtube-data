[{"type": "subtitle", "time": 19522.47, "timestamp": "05:25:22", "text": "绑架了他。他是否知道自己身处其中？"}, {"type": "subtitle", "time": 19524.23, "timestamp": "05:25:24", "text": "所有这些枪击事件都是真的吗？他是"}, {"type": "subtitle", "time": 19527.59, "timestamp": "05:25:27", "text": "就像在放松一样。"}, {"type": "subtitle", "time": 19534.31, "timestamp": "05:25:34", "text": "你说的“全部”是什么意思？"}]
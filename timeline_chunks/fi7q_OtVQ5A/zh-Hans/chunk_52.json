[{"type": "subtitle", "time": 3121.589, "timestamp": "00:52:01", "text": "哦，它已经失效了。通常情况下，"}, {"type": "subtitle", "time": 3125.75, "timestamp": "00:52:05", "text": "它会致命。真是够了，我的天哪。"}, {"type": "subtitle", "time": 3129.03, "timestamp": "00:52:09", "text": "快说出来。所以你起身倾诉"}, {"type": "subtitle", "time": 3132.069, "timestamp": "00:52:12", "text": "它。天哪，它真的挡路了。是的，"}, {"type": "subtitle", "time": 3133.829, "timestamp": "00:52:13", "text": "这是。"}, {"type": "subtitle", "time": 3140.87, "timestamp": "00:52:20", "text": "嗯，我觉得你已经够多了，对吧？"}, {"type": "subtitle", "time": 3142.63, "timestamp": "00:52:22", "text": "什么？是的。是的，我觉得你可以去"}, {"type": "subtitle", "time": 3144.95, "timestamp": "00:52:24", "text": "再多一点，然后喜欢"}, {"type": "subtitle", "time": 3147.99, "timestamp": "00:52:27", "text": "额外的东西，我想。"}, {"type": "subtitle", "time": 3152.15, "timestamp": "00:52:32", "text": "嗯，你身后有一台笔记本电脑。"}, {"type": "subtitle", "time": 3159.43, "timestamp": "00:52:39", "text": "是的。"}, {"type": "subtitle", "time": 3162.39, "timestamp": "00:52:42", "text": "一台笔记本电脑。"}, {"type": "subtitle", "time": 3169.349, "timestamp": "00:52:49", "text": "是的。然后他就会生气。"}, {"type": "subtitle", "time": 3171.349, "timestamp": "00:52:51", "text": "因为我碰了他，他就冲我发火。好像我没有似的"}, {"type": "subtitle", "time": 3174.47, "timestamp": "00:52:54", "text": "兄弟，摸摸你。我没碰你。没有"}]
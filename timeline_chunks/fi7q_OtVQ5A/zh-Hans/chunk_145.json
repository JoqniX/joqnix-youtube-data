[{"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "角落里的那个婴儿是吗？"}, {"type": "subtitle", "time": 8722.98, "timestamp": "02:25:22", "text": "我们够用吗？哦，我们已经足够了。"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "[音乐]"}, {"type": "subtitle", "time": 8736.23, "timestamp": "02:25:36", "text": "耶。"}, {"type": "subtitle", "time": 8744.95, "timestamp": "02:25:44", "text": "我本该还活着。然后它就落下来了"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "是的，确实如此。"}, {"type": "subtitle", "time": 8752.469, "timestamp": "02:25:52", "text": "哦，不错。"}, {"type": "subtitle", "time": 8755.349, "timestamp": "02:25:55", "text": "我知道你其实可以移动这张卡。"}, {"type": "subtitle", "time": 8758.63, "timestamp": "02:25:58", "text": "当你身处卡片内部时。"}]
[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "任何时候都好吗？是的。正如我所说，"}, {"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "韦恩讨厌它，我也讨厌它。所以，"}, {"type": "subtitle", "time": 1805.75, "timestamp": "00:30:05", "text": "我当时就想，你知道吗？我认为我们"}, {"type": "subtitle", "time": 1808.07, "timestamp": "00:30:08", "text": "需要一些东西。"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "是的。这是我玩过的最糟糕的游戏。"}, {"type": "subtitle", "time": 1813.51, "timestamp": "00:30:13", "text": "玩过。离开。离开。某人的"}, {"type": "subtitle", "time": 1815.19, "timestamp": "00:30:15", "text": "他们朝我们开枪，但我不在乎。和"}, {"type": "subtitle", "time": 1817.51, "timestamp": "00:30:17", "text": "你偷了我的M4。嘿，你知道"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "什么？我给你，我给你M4。"}, {"type": "chat", "time": 1820.08, "timestamp": "00:30:20", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooooooo"}, {"type": "subtitle", "time": 1821.83, "timestamp": "00:30:21", "text": "让我一个人待一会儿。是的。"}, {"type": "subtitle", "time": 1825.029, "timestamp": "00:30:25", "text": "你好。欢迎。欢迎。好的。我需要"}, {"type": "subtitle", "time": 1828.07, "timestamp": "00:30:28", "text": "某种枪。我需要一把枪。什么？死。"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "啊。钩。钩。钩。有人进来了。"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "有人进来了。有人"}, {"type": "subtitle", "time": 1841.59, "timestamp": "00:30:41", "text": "未来。不，不。这家伙正是我需要的。"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "冥界。把冥界给我。我不"}, {"type": "subtitle", "time": 1847.029, "timestamp": "00:30:47", "text": "关心。啊。呃，有人在朝我开枪。"}, {"type": "subtitle", "time": 1848.71, "timestamp": "00:30:48", "text": "帮助。"}, {"type": "subtitle", "time": 1854.389, "timestamp": "00:30:54", "text": "你。我刚刚救了你。"}, {"type": "subtitle", "time": 1855.909, "timestamp": "00:30:55", "text": "我"}]
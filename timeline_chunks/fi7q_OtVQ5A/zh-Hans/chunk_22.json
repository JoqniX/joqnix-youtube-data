[{"type": "subtitle", "time": 1322.47, "timestamp": "00:22:02", "text": "我的朋友。不是我。不，别看。看"}, {"type": "subtitle", "time": 1325.35, "timestamp": "00:22:05", "text": "离开。而那个人，只有你。让我来展示一下"}, {"type": "subtitle", "time": 1329.43, "timestamp": "00:22:09", "text": "离开。好的。让我来演示一下。只有我。"}, {"type": "subtitle", "time": 1334.149, "timestamp": "00:22:14", "text": "不，我不让你展示。离开。等待。"}, {"type": "subtitle", "time": 1336.71, "timestamp": "00:22:16", "text": "这就是我来这里的目的。哦，水平"}, {"type": "subtitle", "time": 1338.39, "timestamp": "00:22:18", "text": "三个背包。哦，还有一个。你"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "杰克，你能行的。"}, {"type": "subtitle", "time": 1343.43, "timestamp": "00:22:23", "text": "是的。这个。拿着。哦，你们这些人"}, {"type": "subtitle", "time": 1345.75, "timestamp": "00:22:25", "text": "离得太远了。"}, {"type": "subtitle", "time": 1347.35, "timestamp": "00:22:27", "text": "是的。我的意思是，你应该来。"}, {"type": "subtitle", "time": 1349.909, "timestamp": "00:22:29", "text": "和我们一起。很遗憾，"}, {"type": "subtitle", "time": 1352.63, "timestamp": "00:22:32", "text": "你的猿脑运转不正常。"}, {"type": "subtitle", "time": 1354.47, "timestamp": "00:22:34", "text": "如今。"}, {"type": "subtitle", "time": 1356.549, "timestamp": "00:22:36", "text": "呃，我们马上就要死了。这很酷。"}, {"type": "subtitle", "time": 1359.27, "timestamp": "00:22:39", "text": "没关系。我没意见。沙克，"}, {"type": "subtitle", "time": 1360.71, "timestamp": "00:22:40", "text": "你没拿起这个"}, {"type": "subtitle", "time": 1362.87, "timestamp": "00:22:42", "text": "兄弟，三级背包。哦，我有一个"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "三级背包。哦，真棒。等待，"}, {"type": "subtitle", "time": 1367.19, "timestamp": "00:22:47", "text": "我现在就上去送死。"}, {"type": "subtitle", "time": 1376.47, "timestamp": "00:22:56", "text": "哦，真棒。我有一个 4oot 7。"}]
[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "顺便问一下，这是最终任务吗？"}, {"type": "subtitle", "time": 14344.07, "timestamp": "03:59:04", "text": "有点想通关这个游戏了。到过"}, {"type": "subtitle", "time": 14346.79, "timestamp": "03:59:06", "text": "在这个系列节目中出场时间最长。"}, {"type": "subtitle", "time": 14351.269, "timestamp": "03:59:11", "text": "本系列文章始于一月。"}, {"type": "subtitle", "time": 14359.51, "timestamp": "03:59:19", "text": "我指的是新老成员的组合。"}, {"type": "subtitle", "time": 14361.91, "timestamp": "03:59:21", "text": "开玩笑"}, {"type": "subtitle", "time": 14363.59, "timestamp": "03:59:23", "text": "全体人员。"}, {"type": "subtitle", "time": 14365.67, "timestamp": "03:59:25", "text": "讲笑话时间。如果我没得到，我会非常生气。"}, {"type": "subtitle", "time": 14367.429, "timestamp": "03:59:27", "text": "给兄弟们打电话。你知道吗"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "我的意思是？"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "你知道，迈克尔以为你会……"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "非常适合《糖豆人1》的片段。"}, {"type": "subtitle", "time": 14376.95, "timestamp": "03:59:36", "text": "还有二。嘿，嘿，我们不需要说话"}, {"type": "subtitle", "time": 14379.03, "timestamp": "03:59:39", "text": "就是这样。今天不行。他们需要知道"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "什么"}, {"type": "subtitle", "time": 14382.389, "timestamp": "03:59:42", "text": "他们之间发生了冲突。你想"}, {"type": "subtitle", "time": 14384.309, "timestamp": "03:59:44", "text": "做个泼妇？下车，"}, {"type": "subtitle", "time": 14386.71, "timestamp": "03:59:46", "text": "贱人。你想做这件事吗？关闭"}, {"type": "subtitle", "time": 14388.63, "timestamp": "03:59:48", "text": "你他妈给我闭嘴，省省你的废话吧。"}, {"type": "subtitle", "time": 14399.75, "timestamp": "03:59:59", "text": "哦，今天是M猫的节日。是的。哦，是的。今天的"}]
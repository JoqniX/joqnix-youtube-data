[{"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "就像躲在灌木丛里一样，呃……"}, {"type": "subtitle", "time": 2045.83, "timestamp": "00:34:05", "text": "他是那种花花公子吗？我认为他"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "我的天啊。好的，明白了。嗯"}, {"type": "subtitle", "time": 2060.55, "timestamp": "00:34:20", "text": "惊人的。如果你知道，你就知道在哪里了。"}, {"type": "subtitle", "time": 2069.19, "timestamp": "00:34:29", "text": "哦，不。有人抢走了我的猎物。哦，我"}, {"type": "subtitle", "time": 2071.51, "timestamp": "00:34:31", "text": "别让你看见。呃，是它的"}, {"type": "subtitle", "time": 2073.43, "timestamp": "00:34:33", "text": "绝对不是我，韦恩。不用担心"}, {"type": "subtitle", "time": 2075.75, "timestamp": "00:34:35", "text": "关于它。"}, {"type": "subtitle", "time": 2077.03, "timestamp": "00:34:37", "text": "“如果是你，”我的朋友说，“我会……”"}, {"type": "subtitle", "time": 2078.79, "timestamp": "00:34:38", "text": "肯定已经找到了一种杀死的方法"}, {"type": "subtitle", "time": 2081.27, "timestamp": "00:34:41", "text": "你。"}, {"type": "subtitle", "time": 2083.27, "timestamp": "00:34:43", "text": "我只希望我们能互相残杀。"}, {"type": "subtitle", "time": 2085.99, "timestamp": "00:34:45", "text": "你知道，在这个游戏中，其他方面也会如此。"}, {"type": "subtitle", "time": 2089.03, "timestamp": "00:34:49", "text": "冷静点。这将是。确实如此，是吗？"}, {"type": "subtitle", "time": 2096.31, "timestamp": "00:34:56", "text": "我为什么要这个髋关节档案？"}]
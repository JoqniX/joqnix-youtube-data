[{"type": "subtitle", "time": 10261.03, "timestamp": "02:51:01", "text": "GTA。等等，算了。我们不要这样做。"}, {"type": "subtitle", "time": 10263.67, "timestamp": "02:51:03", "text": "现在启动。"}, {"type": "subtitle", "time": 10266.55, "timestamp": "02:51:06", "text": "让我们进入GTA的世界吧。这就是我们所……"}, {"type": "subtitle", "time": 10269.19, "timestamp": "02:51:09", "text": "直播本该如此。"}, {"type": "subtitle", "time": 10272.309, "timestamp": "02:51:12", "text": "我的天啊。我们走吧。"}, {"type": "subtitle", "time": 10274.389, "timestamp": "02:51:14", "text": "最后。"}, {"type": "subtitle", "time": 10276.71, "timestamp": "02:51:16", "text": "GDA，"}, {"type": "subtitle", "time": 10280.309, "timestamp": "02:51:20", "text": "请工作。请工作。如果你告诉我"}, {"type": "subtitle", "time": 10284.15, "timestamp": "02:51:24", "text": "如果你再犯错，我就杀了你。"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "我不会杀你。我要走了。"}, {"type": "subtitle", "time": 10289.67, "timestamp": "02:51:29", "text": "是的，我以前玩过昆卡，而且我当时"}, {"type": "subtitle", "time": 10291.59, "timestamp": "02:51:31", "text": "称为瞄准板。不知何故，我"}, {"type": "subtitle", "time": 10293.67, "timestamp": "02:51:33", "text": "当时我就想，啊？"}, {"type": "subtitle", "time": 10295.91, "timestamp": "02:51:35", "text": "为什么？我就像一个普通的体育爱好者，"}, {"type": "subtitle", "time": 10297.99, "timestamp": "02:51:37", "text": "我玩Apex和Valerant。"}, {"type": "subtitle", "time": 10300.23, "timestamp": "02:51:40", "text": "一切。"}, {"type": "subtitle", "time": 10308.23, "timestamp": "02:51:48", "text": "连接不上。哦不，不是这样的"}]
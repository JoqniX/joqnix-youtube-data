[{"type": "subtitle", "time": 1140.15, "timestamp": "00:19:00", "text": "我们的运动员真的被困住了。"}, {"type": "subtitle", "time": 1142.31, "timestamp": "00:19:02", "text": "我打算去那里。"}, {"type": "subtitle", "time": 1144.549, "timestamp": "00:19:04", "text": "对，就是这栋楼。是的，有很多。"}, {"type": "subtitle", "time": 1146.15, "timestamp": "00:19:06", "text": "是的，我要去，我就是要去"}, {"type": "subtitle", "time": 1148.23, "timestamp": "00:19:08", "text": "到那儿去。没关系。"}, {"type": "subtitle", "time": 1153.35, "timestamp": "00:19:13", "text": "H被割伤了。我讨厌它。耶稣基督。"}, {"type": "subtitle", "time": 1155.51, "timestamp": "00:19:15", "text": "我不喜欢，我不喜欢"}, {"type": "subtitle", "time": 1165.75, "timestamp": "00:19:25", "text": "[音乐]"}, {"type": "subtitle", "time": 1169.669, "timestamp": "00:19:29", "text": "哦，原来是那家伙抢了我的人头。哦，该死"}, {"type": "subtitle", "time": 1172.15, "timestamp": "00:19:32", "text": "它。哦，不。哦，不。我难道要死了吗？"}, {"type": "subtitle", "time": 1174.63, "timestamp": "00:19:34", "text": "耶稣基督。我喜欢我们吸血鬼的方式"}, {"type": "subtitle", "time": 1181.75, "timestamp": "00:19:41", "text": "我没有弹药了。我没有弹药了。我"}, {"type": "subtitle", "time": 1184.549, "timestamp": "00:19:44", "text": "不需要弹药。"}, {"type": "subtitle", "time": 1187.59, "timestamp": "00:19:47", "text": "哦，你"}, {"type": "subtitle", "time": 1189.11, "timestamp": "00:19:49", "text": "还没有。"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "我真为你感到骄傲。"}, {"type": "subtitle", "time": 1194.15, "timestamp": "00:19:54", "text": "与敌人交战。我这就去做"}, {"type": "subtitle", "time": 1197.43, "timestamp": "00:19:57", "text": "一场糟糕的比赛。和"}]
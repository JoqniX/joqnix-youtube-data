[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "在哪里？"}, {"type": "subtitle", "time": 1985.19, "timestamp": "00:33:05", "text": "哦，他们就在附近。"}, {"type": "subtitle", "time": 1987.11, "timestamp": "00:33:07", "text": "哦，我就在附近。哦，你在楼下。"}, {"type": "subtitle", "time": 2002.07, "timestamp": "00:33:22", "text": "去死吧。去死吧。去死吧。只是"}, {"type": "subtitle", "time": 2004.87, "timestamp": "00:33:24", "text": "哦，他死了。别担心。你"}, {"type": "subtitle", "time": 2012.31, "timestamp": "00:33:32", "text": "他只是在大喊大叫。想象一下韦恩是"}, {"type": "subtitle", "time": 2014.87, "timestamp": "00:33:34", "text": "对着尸体大喊大叫。去死吧，"}, {"type": "subtitle", "time": 2020.549, "timestamp": "00:33:40", "text": "去死吧，去死吧。那家伙简直就是个混蛋"}, {"type": "subtitle", "time": 2024.23, "timestamp": "00:33:44", "text": "拥有机器人皮肤。不，他用的是机器人皮肤。我"}, {"type": "subtitle", "time": 2026.389, "timestamp": "00:33:46", "text": "我要选他。凉爽的。我要去"}, {"type": "subtitle", "time": 2029.35, "timestamp": "00:33:49", "text": "去追他。狙击。"}, {"type": "subtitle", "time": 2032.23, "timestamp": "00:33:52", "text": "哦，我不认为这是操蛋的。"}, {"type": "subtitle", "time": 2034.07, "timestamp": "00:33:54", "text": "这是谁？"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "上帝。这人是谁？查克，你好"}, {"type": "subtitle", "time": 2039.909, "timestamp": "00:33:59", "text": "你要杀了他吗？如果真是这样，我很抱歉。"}]
[{"type": "subtitle", "time": 16628.551, "timestamp": "04:37:08", "text": "你确实说过她。好的。"}, {"type": "subtitle", "time": 16631.269, "timestamp": "04:37:11", "text": "她到底是什么人？我不知道。我已经"}, {"type": "subtitle", "time": 16653.029, "timestamp": "04:37:33", "text": "[音乐]"}, {"type": "subtitle", "time": 16655.189, "timestamp": "04:37:35", "text": "兄弟，你这是在恐慌什么？他妈的干什么"}, {"type": "subtitle", "time": 16657.99, "timestamp": "04:37:37", "text": "您认为？想象一下这样的场景"}, {"type": "subtitle", "time": 16661.429, "timestamp": "04:37:41", "text": "那会搞砸的。天哪，我的脑子里全是乱码"}, {"type": "subtitle", "time": 16663.99, "timestamp": "04:37:43", "text": "正在玩GTA Online。是的，有一点点。"}, {"type": "subtitle", "time": 16665.109, "timestamp": "04:37:45", "text": "没说不。只是有人"}, {"type": "subtitle", "time": 16666.949, "timestamp": "04:37:46", "text": "我纹了跟我一样的纹身。那么为什么不呢？"}, {"type": "subtitle", "time": 16668.629, "timestamp": "04:37:48", "text": "你直接告诉我一些吧。"}, {"type": "subtitle", "time": 16671.67, "timestamp": "04:37:51", "text": "这混蛋想让我杀了其他人"}, {"type": "subtitle", "time": 16673.99, "timestamp": "04:37:53", "text": "他想让我杀了特雷弗。我觉得我不能"}, {"type": "subtitle", "time": 16677.109, "timestamp": "04:37:57", "text": "杀了他们两个。唉，我完蛋了。"}, {"type": "subtitle", "time": 16678.47, "timestamp": "04:37:58", "text": "我真不知道该怎么办才对。"}]
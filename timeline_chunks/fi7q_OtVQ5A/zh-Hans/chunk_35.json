[{"type": "subtitle", "time": 2106.63, "timestamp": "00:35:06", "text": "天哪，如果这家伙真是个机器人……"}, {"type": "subtitle", "time": 2109.67, "timestamp": "00:35:09", "text": "真是蠢到家了。"}, {"type": "subtitle", "time": 2113.67, "timestamp": "00:35:13", "text": "天哪，我吓坏了。"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "如果你不开车，开车会非常令人紧张。"}, {"type": "subtitle", "time": 2124.95, "timestamp": "00:35:24", "text": "知道。他就在那儿"}, {"type": "subtitle", "time": 2128.87, "timestamp": "00:35:28", "text": "消失。她的工作。你是个爱炫耀的人"}, {"type": "subtitle", "time": 2145.67, "timestamp": "00:35:45", "text": "大家好。欢迎来到拉贾卡顿"}, {"type": "subtitle", "time": 2149.51, "timestamp": "00:35:49", "text": "第96天第一部分直播。所以今天我们有"}, {"type": "subtitle", "time": 2152.95, "timestamp": "00:35:52", "text": "今天的特邀嘉宾。我们有"}, {"type": "subtitle", "time": 2156.55, "timestamp": "00:35:56", "text": "艾莉。你好。"}, {"type": "subtitle", "time": 2158.79, "timestamp": "00:35:58", "text": "你好吗？"}]
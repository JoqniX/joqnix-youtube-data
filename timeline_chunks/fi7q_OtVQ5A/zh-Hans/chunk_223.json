[{"type": "subtitle", "time": 13386.07, "timestamp": "03:43:06", "text": "我觉得我不是，我觉得是我造就了我自己，呃，我是"}, {"type": "subtitle", "time": 13389.429, "timestamp": "03:43:09", "text": "不是游泳。"}, {"type": "subtitle", "time": 13408.87, "timestamp": "03:43:28", "text": "如何避免成为“圣女”？有人吗？"}, {"type": "subtitle", "time": 13410.95, "timestamp": "03:43:30", "text": "知道吗？"}, {"type": "subtitle", "time": 13421.75, "timestamp": "03:43:41", "text": "你越否认，你就越是……"}, {"type": "subtitle", "time": 13434.389, "timestamp": "03:43:54", "text": "我太喜欢这辆车了。这是奥迪吗？"}]
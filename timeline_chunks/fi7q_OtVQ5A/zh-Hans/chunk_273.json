[{"type": "subtitle", "time": 16384.15, "timestamp": "04:33:04", "text": "我真的不想杀了特拉"}, {"type": "subtitle", "time": 16386.95, "timestamp": "04:33:06", "text": "还有所有人。不。"}, {"type": "subtitle", "time": 16395.99, "timestamp": "04:33:15", "text": "所以你不知道我的狩猎目标是什么。不。"}, {"type": "subtitle", "time": 16397.83, "timestamp": "04:33:17", "text": "你看，大家都在说“看”。好的。那"}, {"type": "subtitle", "time": 16406.55, "timestamp": "04:33:26", "text": "你觉得我应该这么做吗？"}, {"type": "subtitle", "time": 16412.07, "timestamp": "04:33:32", "text": "[音乐]"}, {"type": "subtitle", "time": 16414.869, "timestamp": "04:33:34", "text": "我不想杀了我的米奇，"}, {"type": "subtitle", "time": 16423.67, "timestamp": "04:33:43", "text": "我不知道。"}, {"type": "subtitle", "time": 16426.709, "timestamp": "04:33:46", "text": "我为什么要这样做？我会哭的"}]
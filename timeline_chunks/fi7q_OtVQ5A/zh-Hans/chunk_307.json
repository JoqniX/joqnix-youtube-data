[{"type": "subtitle", "time": 18433.59, "timestamp": "05:07:13", "text": "是的。"}, {"type": "subtitle", "time": 18437.03, "timestamp": "05:07:17", "text": "那么这是什么一回事？接下来会发生什么？嗯？我们只是"}, {"type": "subtitle", "time": 18438.15, "timestamp": "05:07:18", "text": "打算等着有人来杀人"}, {"type": "subtitle", "time": 18439.59, "timestamp": "05:07:19", "text": "我们现在就行动，还是等到那时？"}, {"type": "subtitle", "time": 18443.27, "timestamp": "05:07:23", "text": "这混蛋被翻脸了吗？你进度落后了吗？不。"}, {"type": "subtitle", "time": 18445.83, "timestamp": "05:07:25", "text": "你心里也清楚。"}, {"type": "subtitle", "time": 18448.31, "timestamp": "05:07:28", "text": "我没有落后。我看到了。我们才刚刚"}, {"type": "subtitle", "time": 18450.15, "timestamp": "05:07:30", "text": "开始清理这些烂摊子。我们得到了一个"}, {"type": "subtitle", "time": 18451.75, "timestamp": "05:07:31", "text": "我觉得很多老朋友都需要……"}, {"type": "subtitle", "time": 18454.55, "timestamp": "05:07:34", "text": "再教育。朋友很多。我是说，"}, {"type": "subtitle", "time": 18457.35, "timestamp": "05:07:37", "text": "事情可能会变得非常糟糕。不，我们"}, {"type": "subtitle", "time": 18460.868, "timestamp": "05:07:40", "text": "只是需要让几个吵闹的人安静下来。"}, {"type": "subtitle", "time": 18463.27, "timestamp": "05:07:43", "text": "让我看看。那是史蒂夫。哦，你真棒"}, {"type": "subtitle", "time": 18466.948, "timestamp": "05:07:46", "text": "现在。我们需要他活着。"}, {"type": "subtitle", "time": 18469.35, "timestamp": "05:07:49", "text": "所以之后没人敢惹我们。什么"}, {"type": "subtitle", "time": 18471.27, "timestamp": "05:07:51", "text": "关于那个部落的混蛋？那个"}, {"type": "subtitle", "time": 18473.35, "timestamp": "05:07:53", "text": "我觉得你们两个男生在谈恋爱。拉屎。"}, {"type": "subtitle", "time": 18475.11, "timestamp": "05:07:55", "text": "你知道他肯定会回来的。是的，"}, {"type": "subtitle", "time": 18476.868, "timestamp": "05:07:56", "text": "还有那件事。那么，这个人是谁呢？"}, {"type": "subtitle", "time": 18479.51, "timestamp": "05:07:59", "text": "设置警报了吗？拉紧。你想要"}]
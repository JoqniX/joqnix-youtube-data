[{"type": "subtitle", "time": 541.91, "timestamp": "00:09:01", "text": "我觉得他正从对面射我。"}, {"type": "subtitle", "time": 544.31, "timestamp": "00:09:04", "text": "建筑。"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "我的手机。我有这款游戏。哦，这个呃"}, {"type": "subtitle", "time": 548.949, "timestamp": "00:09:08", "text": "我还没玩过使命召唤手游。"}, {"type": "subtitle", "time": 552.15, "timestamp": "00:09:12", "text": "一段时间以来，或者说任何手机游戏。所以"}, {"type": "subtitle", "time": 554.47, "timestamp": "00:09:14", "text": "是的，有人想从……杀我"}, {"type": "subtitle", "time": 556.389, "timestamp": "00:09:16", "text": "窗户。"}, {"type": "subtitle", "time": 558.55, "timestamp": "00:09:18", "text": "这是我第一次真正玩……"}, {"type": "subtitle", "time": 562.87, "timestamp": "00:09:22", "text": "手机游戏。哦。"}, {"type": "subtitle", "time": 564.87, "timestamp": "00:09:24", "text": "好吧，我觉得他只是在用手榴弹炸我们。"}, {"type": "subtitle", "time": 567.59, "timestamp": "00:09:27", "text": "现在，这很棒。顺便说一句，不要"}, {"type": "subtitle", "time": 569.91, "timestamp": "00:09:29", "text": "一点也不粗鲁。"}, {"type": "subtitle", "time": 571.59, "timestamp": "00:09:31", "text": "你能过来一下吗？确实有"}, {"type": "subtitle", "time": 575.35, "timestamp": "00:09:35", "text": "暴风雨来临前，附近有两个人。它是"}, {"type": "subtitle", "time": 577.59, "timestamp": "00:09:37", "text": "前往"}, {"type": "subtitle", "time": 579.35, "timestamp": "00:09:39", "text": "不是"}, {"type": "subtitle", "time": 587.99, "timestamp": "00:09:47", "text": "我只是个普通人。别去那里。你是"}, {"type": "subtitle", "time": 590.71, "timestamp": "00:09:50", "text": "我会死在那里。是的，我没事。我是"}, {"type": "subtitle", "time": 592.23, "timestamp": "00:09:52", "text": "我很好。我死了。别担心"}, {"type": "subtitle", "time": 595.829, "timestamp": "00:09:55", "text": "它。韦恩，死了也没关系。没关系。"}]
[{"type": "subtitle", "time": 3660.87, "timestamp": "01:01:00", "text": "那。是的。"}, {"type": "subtitle", "time": 3668.789, "timestamp": "01:01:08", "text": "戒指有效。我们可以带上我们携带的物品吗？"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "不用返回那个装置吗？"}, {"type": "subtitle", "time": 3678.15, "timestamp": "01:01:18", "text": "嗯，鸭子桶。是的。"}, {"type": "subtitle", "time": 3680.309, "timestamp": "01:01:20", "text": "但你可以把它们留在那里，它们就会"}, {"type": "subtitle", "time": 3682.87, "timestamp": "01:01:22", "text": "不管怎样，你还是回来吧。哦，这是……"}, {"type": "subtitle", "time": 3686.47, "timestamp": "01:01:26", "text": "等级？我的天哪。耶稣。"}, {"type": "subtitle", "time": 3689.27, "timestamp": "01:01:29", "text": "等等，我以前从没见过这个地方。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "这是一个全新的水平。这是一个博物馆。"}, {"type": "subtitle", "time": 3694.309, "timestamp": "01:01:34", "text": "我们可以帮你赚到很多钱"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "哦，瞧。一架飞机。哦，我还没看过"}]
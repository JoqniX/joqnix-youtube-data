[{"type": "subtitle", "time": 240.71, "timestamp": "00:04:00", "text": "你说了吗？好的。哦，麦克斯。马克斯来了。 O."}, {"type": "subtitle", "time": 253.03, "timestamp": "00:04:13", "text": "是的。米娅来了。真不错。哦，"}, {"type": "subtitle", "time": 255.11, "timestamp": "00:04:15", "text": "是的。 Mia以前直播过使命召唤"}, {"type": "subtitle", "time": 258.15, "timestamp": "00:04:18", "text": "手机长篇。"}, {"type": "subtitle", "time": 260.469, "timestamp": "00:04:20", "text": "情况好多了。顺便说一下，我是……"}, {"type": "subtitle", "time": 266.87, "timestamp": "00:04:26", "text": "他本可以像《使命召唤》那样做，"}, {"type": "subtitle", "time": 269.35, "timestamp": "00:04:29", "text": "但他并没有把它安装在他的"}, {"type": "subtitle", "time": 271.99, "timestamp": "00:04:31", "text": "手机，所以我就想，这才是正道。"}, {"type": "subtitle", "time": 277.03, "timestamp": "00:04:37", "text": "更轻松。我猜是有人从我身上滑下来了。哦"}, {"type": "subtitle", "time": 282.15, "timestamp": "00:04:42", "text": "不。哦，不。哦，不。哦，不。你你你"}, {"type": "subtitle", "time": 285.189, "timestamp": "00:04:45", "text": "臭。你们在哪儿？参与"}, {"type": "subtitle", "time": 287.189, "timestamp": "00:04:47", "text": "敌人。他妈的"}, {"type": "subtitle", "time": 288.95, "timestamp": "00:04:48", "text": "你。"}, {"type": "subtitle", "time": 291.35, "timestamp": "00:04:51", "text": "我做了。呃，雅克，我替你报仇了。我"}, {"type": "subtitle", "time": 292.79, "timestamp": "00:04:52", "text": "我报仇杀了你。别担心"}, {"type": "subtitle", "time": 294.79, "timestamp": "00:04:54", "text": "它。顺便说一句，我可以救你。"}, {"type": "subtitle", "time": 297.11, "timestamp": "00:04:57", "text": "你能保持静止吗？我杀了他。我"}, {"type": "subtitle", "time": 299.03, "timestamp": "00:04:59", "text": "杀了他。别担心。是的。"}]
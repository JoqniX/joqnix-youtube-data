[{"type": "subtitle", "time": 8224.79, "timestamp": "02:17:04", "text": "你在哪里？"}, {"type": "subtitle", "time": 8226.629, "timestamp": "02:17:06", "text": "我在房间里，试图弄明白"}, {"type": "subtitle", "time": 8229.589, "timestamp": "02:17:09", "text": "我这门课不及格。"}, {"type": "subtitle", "time": 8232.389, "timestamp": "02:17:12", "text": "我个子太小了。"}, {"type": "subtitle", "time": 8234.95, "timestamp": "02:17:14", "text": "哦，我搞不懂。"}, {"type": "subtitle", "time": 8236.469, "timestamp": "02:17:16", "text": "哦。"}, {"type": "subtitle", "time": 8239.91, "timestamp": "02:17:19", "text": "我的天哪。你能抓住它吗？我不能"}, {"type": "subtitle", "time": 8242.309, "timestamp": "02:17:22", "text": "抓住它。是的，你能看到，对吧？"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "啊，是那个。"}, {"type": "subtitle", "time": 8246.629, "timestamp": "02:17:26", "text": "这就像……"}, {"type": "subtitle", "time": 8261.349, "timestamp": "02:17:41", "text": "哦。我的天啊。哦，糟糕。"}, {"type": "subtitle", "time": 8265.99, "timestamp": "02:17:45", "text": "我在这里。我死了。不，我能看到。"}, {"type": "subtitle", "time": 8268.549, "timestamp": "02:17:48", "text": "他在哪儿？"}]
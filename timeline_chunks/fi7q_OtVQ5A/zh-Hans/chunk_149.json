[{"type": "subtitle", "time": 8953.19, "timestamp": "02:29:13", "text": "我是你的忠实粉丝。哦。我的天啊。我们开始吧"}, {"type": "subtitle", "time": 8954.79, "timestamp": "02:29:14", "text": "去。"}, {"type": "subtitle", "time": 8961.11, "timestamp": "02:29:21", "text": "哦，小矮人。"}, {"type": "subtitle", "time": 8964.309, "timestamp": "02:29:24", "text": "不，我听到的是像猫叫一样的声音。我当时就想，"}, {"type": "subtitle", "time": 8967.349, "timestamp": "02:29:27", "text": "“等等，这游戏里有猫。”不，"}, {"type": "subtitle", "time": 8971.19, "timestamp": "02:29:31", "text": "那是小矮人。那就是小矮人。"}, {"type": "subtitle", "time": 8972.55, "timestamp": "02:29:32", "text": "我不喜欢小矮人。他们是"}, {"type": "subtitle", "time": 8975.349, "timestamp": "02:29:35", "text": "按住很烦人。我希望"}]
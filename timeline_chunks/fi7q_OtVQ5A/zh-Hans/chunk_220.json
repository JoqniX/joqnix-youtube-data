[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "是啊，真是太离谱了。但"}, {"type": "subtitle", "time": 13204.309, "timestamp": "03:40:04", "text": "呃"}, {"type": "subtitle", "time": 13206.229, "timestamp": "03:40:06", "text": "不不不不"}, {"type": "subtitle", "time": 13210.07, "timestamp": "03:40:10", "text": "你知道，和凯伊什见面时，呃，他却"}, {"type": "subtitle", "time": 13215.349, "timestamp": "03:40:15", "text": "他说那个脏话时，他说的是猴子渔夫"}, {"type": "subtitle", "time": 13218.389, "timestamp": "03:40:18", "text": "羽毛，那太酷了，太酷了"}, {"type": "subtitle", "time": 13221.91, "timestamp": "03:40:21", "text": "比这个词更好"}, {"type": "subtitle", "time": 13224.55, "timestamp": "03:40:24", "text": "猴羽"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "那很好，所以我有点想找一个"}, {"type": "subtitle", "time": 13229.429, "timestamp": "03:40:29", "text": "单词"}, {"type": "subtitle", "time": 13245.429, "timestamp": "03:40:45", "text": "笨蛋。不，卡车司机这个词太过了。卡车司机"}, {"type": "subtitle", "time": 13248.229, "timestamp": "03:40:48", "text": "靠近树林。不会使用卡车司机。"}, {"type": "subtitle", "time": 13251.67, "timestamp": "03:40:51", "text": "少了一件烦心事。"}, {"type": "subtitle", "time": 13253.99, "timestamp": "03:40:53", "text": "嗯？"}, {"type": "subtitle", "time": 13258.15, "timestamp": "03:40:58", "text": "好的，下一个。最后一个。"}]
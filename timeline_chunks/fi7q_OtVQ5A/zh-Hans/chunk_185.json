[{"type": "subtitle", "time": 11101.11, "timestamp": "03:05:01", "text": "他不懂印地语。"}, {"type": "subtitle", "time": 11117.269, "timestamp": "03:05:17", "text": "没关系。"}, {"type": "subtitle", "time": 11122.55, "timestamp": "03:05:22", "text": "他会的。嗯？好的。就选美国吧。"}, {"type": "subtitle", "time": 11125.429, "timestamp": "03:05:25", "text": "我们就去纽约吧。雌鹿。"}, {"type": "subtitle", "time": 11145.51, "timestamp": "03:05:45", "text": "它叫什么名字？"}, {"type": "subtitle", "time": 11157.59, "timestamp": "03:05:57", "text": "是的。"}]
[{"type": "subtitle", "time": 4020.069, "timestamp": "01:07:00", "text": "嗯，提取，或者你可以我们可以"}, {"type": "subtitle", "time": 4022.549, "timestamp": "01:07:02", "text": "最后再做。"}, {"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "哦，液体物品。它会溢出来。我"}, {"type": "subtitle", "time": 4028.069, "timestamp": "01:07:08", "text": "你以为呢？是的，这个会洒出来。"}, {"type": "subtitle", "time": 4030.789, "timestamp": "01:07:10", "text": "是的，有……"}, {"type": "subtitle", "time": 4033.91, "timestamp": "01:07:13", "text": "你还得到了一套茶具。"}, {"type": "subtitle", "time": 4036.39, "timestamp": "01:07:16", "text": "和两个人一起接你"}, {"type": "subtitle", "time": 4040.39, "timestamp": "01:07:20", "text": "你知道，一个都不能丢。"}, {"type": "subtitle", "time": 4043.19, "timestamp": "01:07:23", "text": "否则，"}, {"type": "subtitle", "time": 4046.23, "timestamp": "01:07:26", "text": "你知道，这一切。"}, {"type": "subtitle", "time": 4049.99, "timestamp": "01:07:29", "text": "你把所有贵重物品都砸碎了。"}, {"type": "subtitle", "time": 4058.95, "timestamp": "01:07:38", "text": "好了。"}, {"type": "subtitle", "time": 4066.789, "timestamp": "01:07:46", "text": "那是什么？哦，是“你想……”"}]
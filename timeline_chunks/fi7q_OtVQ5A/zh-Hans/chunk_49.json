[{"type": "subtitle", "time": 2941.27, "timestamp": "00:49:01", "text": "嘿，过来帮帮我。"}, {"type": "subtitle", "time": 2945.75, "timestamp": "00:49:05", "text": "不知道这种技术是否仍然有效。"}, {"type": "subtitle", "time": 2947.51, "timestamp": "00:49:07", "text": "作品。"}, {"type": "subtitle", "time": 2949.75, "timestamp": "00:49:09", "text": "哦，那个拥抱怪兽。这"}, {"type": "subtitle", "time": 2951.91, "timestamp": "00:49:11", "text": "抱抱怪兽。"}, {"type": "subtitle", "time": 2953.91, "timestamp": "00:49:13", "text": "哦，"}, {"type": "subtitle", "time": 2957.19, "timestamp": "00:49:17", "text": "我死了，老兄。"}, {"type": "subtitle", "time": 2959.829, "timestamp": "00:49:19", "text": "哦，不。"}, {"type": "subtitle", "time": 2962.63, "timestamp": "00:49:22", "text": "我讨厌那家伙。"}, {"type": "subtitle", "time": 2972.47, "timestamp": "00:49:32", "text": "我发誓，如果你给我我的立场，我不会那样做。"}, {"type": "subtitle", "time": 2974.23, "timestamp": "00:49:34", "text": "离开。"}, {"type": "subtitle", "time": 2977.109, "timestamp": "00:49:37", "text": "好的。你去哪儿？你去了哪里？"}, {"type": "subtitle", "time": 2982.63, "timestamp": "00:49:42", "text": "对，就在那边。不，我想是……"}, {"type": "subtitle", "time": 2991.43, "timestamp": "00:49:51", "text": "你那儿还有另一个，对，就是那个。"}, {"type": "subtitle", "time": 2994.069, "timestamp": "00:49:54", "text": "都在这里。不，不。呃，后面那个"}, {"type": "subtitle", "time": 2996.71, "timestamp": "00:49:56", "text": "你。"}]
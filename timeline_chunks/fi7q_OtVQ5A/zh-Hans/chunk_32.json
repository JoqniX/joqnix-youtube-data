[{"type": "subtitle", "time": 1921.029, "timestamp": "00:32:01", "text": "他就像处于敬畏的状态，他"}, {"type": "subtitle", "time": 1923.669, "timestamp": "00:32:03", "text": "尖叫一声，然后开枪打死他。只是"}, {"type": "subtitle", "time": 1925.75, "timestamp": "00:32:05", "text": "对着他的脸大喊大叫，然后就杀了他"}, {"type": "subtitle", "time": 1934.549, "timestamp": "00:32:14", "text": "在哪里？"}, {"type": "subtitle", "time": 1936.549, "timestamp": "00:32:16", "text": "人都去哪儿了？我只想杀人"}, {"type": "subtitle", "time": 1938.23, "timestamp": "00:32:18", "text": "某人。"}, {"type": "subtitle", "time": 1940.149, "timestamp": "00:32:20", "text": "好的，明白了。他正在被建造"}, {"type": "subtitle", "time": 1941.99, "timestamp": "00:32:21", "text": "和往常一样口渴。别担心他。"}, {"type": "subtitle", "time": 1944.389, "timestamp": "00:32:24", "text": "我猜也是。呃，我现在要死了吗？"}, {"type": "subtitle", "time": 1945.99, "timestamp": "00:32:25", "text": "因为我觉得只有我一个人这么想"}, {"type": "subtitle", "time": 1949.83, "timestamp": "00:32:29", "text": "独自的。哦，现在只剩下我们三个人了。"}, {"type": "subtitle", "time": 1954.95, "timestamp": "00:32:34", "text": "幸福美满的一家人。哦，真棒。是的。等待，"}, {"type": "subtitle", "time": 1957.19, "timestamp": "00:32:37", "text": "太棒了。我们没有发言权。你"}, {"type": "subtitle", "time": 1959.35, "timestamp": "00:32:39", "text": "无需提及第四名球员。 WHO"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "关心哦，上帝。是的。你们所有人"}, {"type": "subtitle", "time": 1971.35, "timestamp": "00:32:51", "text": "好的。有人在逃离我。"}, {"type": "subtitle", "time": 1975.35, "timestamp": "00:32:55", "text": "某些绝对的家伙？谁在"}]
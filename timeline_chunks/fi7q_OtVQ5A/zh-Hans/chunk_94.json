[{"type": "subtitle", "time": 5645.35, "timestamp": "01:34:05", "text": "没睡。我发誓"}, {"type": "subtitle", "time": 5648.47, "timestamp": "01:34:08", "text": "我把板子放好，然后我就睡着了，我睡着了。"}, {"type": "subtitle", "time": 5651.669, "timestamp": "01:34:11", "text": "离开。实际上，我之前那个是"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "应该在之前重新制作直播"}, {"type": "subtitle", "time": 5662.47, "timestamp": "01:34:22", "text": "我的天哪。这个人是否曾经"}, {"type": "subtitle", "time": 5670.149, "timestamp": "01:34:30", "text": "他是怎么做到的？他太强了。"}, {"type": "subtitle", "time": 5684.39, "timestamp": "01:34:44", "text": "哦，不。"}, {"type": "subtitle", "time": 5687.83, "timestamp": "01:34:47", "text": "呃，这是哪里？好的。"}, {"type": "subtitle", "time": 5691.189, "timestamp": "01:34:51", "text": "哦，霍格沃茨。嗯，是的。我不是"}, {"type": "subtitle", "time": 5694.07, "timestamp": "01:34:54", "text": "非常喜欢这个。愿你拥有王冠"}, {"type": "subtitle", "time": 5697.03, "timestamp": "01:34:57", "text": "在你这个东西上。"}]
[{"type": "subtitle", "time": 721.11, "timestamp": "00:12:01", "text": "盒子。我需要这个盒子。他们给了我一个盒子，"}, {"type": "subtitle", "time": 724.87, "timestamp": "00:12:04", "text": "这很酷。我猜"}, {"type": "subtitle", "time": 727.43, "timestamp": "00:12:07", "text": "它给了我一个紫色的盒子，我要去"}, {"type": "subtitle", "time": 729.43, "timestamp": "00:12:09", "text": "打开。紫色盒子。"}, {"type": "subtitle", "time": 733.11, "timestamp": "00:12:13", "text": "我希望我能得到一个皮肤。"}, {"type": "subtitle", "time": 735.43, "timestamp": "00:12:15", "text": "不，你不会的。"}, {"type": "subtitle", "time": 738.31, "timestamp": "00:12:18", "text": "我点燃了火焰。蓝色火焰，并非"}, {"type": "subtitle", "time": 741.91, "timestamp": "00:12:21", "text": "一点也不酷。等待。 PUBG要免费了"}, {"type": "subtitle", "time": 745.99, "timestamp": "00:12:25", "text": "玩耍。什么？"}, {"type": "subtitle", "time": 749.19, "timestamp": "00:12:29", "text": "哦，1月12日。哦，是那个电脑游戏，我"}, {"type": "subtitle", "time": 751.59, "timestamp": "00:12:31", "text": "想想，是自由玩耍还是"}, {"type": "subtitle", "time": 754.79, "timestamp": "00:12:34", "text": "某物。哦，真棒。太棒了。"}, {"type": "subtitle", "time": 756.23, "timestamp": "00:12:36", "text": "听到这个消息真是太棒了。太棒了"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "依我看，酱汁最重要。哦。嗯，通过"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "嗯，我想我需要去……"}, {"type": "subtitle", "time": 767.509, "timestamp": "00:12:47", "text": "我觉得我需要去问问你……"}, {"type": "subtitle", "time": 769.91, "timestamp": "00:12:49", "text": "给他们打电话？"}, {"type": "subtitle", "time": 773.43, "timestamp": "00:12:53", "text": "我需要去……"}]
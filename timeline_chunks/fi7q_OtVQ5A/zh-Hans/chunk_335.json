[{"type": "subtitle", "time": 20100.23, "timestamp": "05:35:00", "text": "几分钟后即可启动。"}, {"type": "subtitle", "time": 20114.47, "timestamp": "05:35:14", "text": "这是什么？来自办公室"}, {"type": "subtitle", "time": 20118.15, "timestamp": "05:35:18", "text": "艾莎医生？客户须知。 H 词失败"}, {"type": "subtitle", "time": 20128.628, "timestamp": "05:35:28", "text": "客户信息并非高度保密。是什么"}, {"type": "subtitle", "time": 20130.788, "timestamp": "05:35:30", "text": "让我失望吗？他们绝对没有能力"}, {"type": "subtitle", "time": 20132.548, "timestamp": "05:35:32", "text": "在爱情中做出交易决定，却发现"}, {"type": "subtitle", "time": 20135.19, "timestamp": "05:35:35", "text": "糟糕的决定是有原因的"}, {"type": "subtitle", "time": 20139.19, "timestamp": "05:35:39", "text": "财务上正确"}, {"type": "subtitle", "time": 20140.948, "timestamp": "05:35:40", "text": "不负责任"}, {"type": "subtitle", "time": 20142.948, "timestamp": "05:35:42", "text": "自我意识比……更确定"}, {"type": "subtitle", "time": 20145.75, "timestamp": "05:35:45", "text": "可惜的是，我没有性意识。"}, {"type": "subtitle", "time": 20148.628, "timestamp": "05:35:48", "text": "其他地方的案例都喜欢这个疯狂的家庭"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "我想这应该算是避免的开始吧"}, {"type": "subtitle", "time": 20154.628, "timestamp": "05:35:54", "text": "近乎无情的推测"}, {"type": "subtitle", "time": 20157.99, "timestamp": "05:35:57", "text": "谈论此事的人会哭泣，并为此感到自豪。"}]
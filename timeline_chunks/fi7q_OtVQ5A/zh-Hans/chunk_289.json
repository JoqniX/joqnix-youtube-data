[{"type": "subtitle", "time": 17341.75, "timestamp": "04:49:01", "text": "合作。是啊，问题就在于此，这很难。"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "寻求合作。"}, {"type": "subtitle", "time": 17348.628, "timestamp": "04:49:08", "text": "我不是那样的人。"}, {"type": "subtitle", "time": 17350.788, "timestamp": "04:49:10", "text": "它叫什么？介绍就像额外"}, {"type": "subtitle", "time": 17352.868, "timestamp": "04:49:12", "text": "木材"}, {"type": "subtitle", "time": 17356.15, "timestamp": "04:49:16", "text": "并进行合作和真正的交流。我在这方面很差劲。"}, {"type": "subtitle", "time": 17359.51, "timestamp": "04:49:19", "text": "那。这就是我减少电话合作的原因。"}, {"type": "subtitle", "time": 17361.67, "timestamp": "04:49:21", "text": "还有其他一些东西。"}, {"type": "subtitle", "time": 17364.628, "timestamp": "04:49:24", "text": "他们中的大多数人，以及像现在这样的时代"}, {"type": "subtitle", "time": 17368.07, "timestamp": "04:49:28", "text": "我们喜欢在周日进行合作。"}, {"type": "subtitle", "time": 17372.43, "timestamp": "04:49:32", "text": "还有其他一些东西。我感觉很干净。"}, {"type": "subtitle", "time": 17374.948, "timestamp": "04:49:34", "text": "[音乐]"}, {"type": "subtitle", "time": 17377.99, "timestamp": "04:49:37", "text": "我知道该怎么做。你是认真的吗？"}, {"type": "subtitle", "time": 17380.07, "timestamp": "04:49:40", "text": "是的。"}, {"type": "subtitle", "time": 17383.75, "timestamp": "04:49:43", "text": "莱斯特·拉马尔来电了。"}, {"type": "subtitle", "time": 17385.59, "timestamp": "04:49:45", "text": "兄弟，最近怎么样？唉，世事难料。"}, {"type": "subtitle", "time": 17387.67, "timestamp": "04:49:47", "text": "我现在真是糟透了，老兄。这一切都是"}, {"type": "subtitle", "time": 17389.27, "timestamp": "04:49:49", "text": "好，兄弟。还有谁比他更适合呢？"}, {"type": "subtitle", "time": 17391.03, "timestamp": "04:49:51", "text": "比糟糕的情况更糟糕"}, {"type": "subtitle", "time": 17393.99, "timestamp": "04:49:53", "text": "像我这样的傻瓜？正合我意。"}, {"type": "subtitle", "time": 17395.43, "timestamp": "04:49:55", "text": "嘿，看。我要去你家了"}, {"type": "subtitle", "time": 17399.35, "timestamp": "04:49:59", "text": "滚开。我在这里。"}]
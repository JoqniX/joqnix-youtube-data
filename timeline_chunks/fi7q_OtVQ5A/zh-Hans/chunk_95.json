[{"type": "subtitle", "time": 5714.79, "timestamp": "01:35:14", "text": "这部分。"}, {"type": "subtitle", "time": 5717.11, "timestamp": "01:35:17", "text": "他们应该在这个环节加入一些仇恨内容。"}, {"type": "subtitle", "time": 5720.07, "timestamp": "01:35:20", "text": "观点。我的天哪，这真是太棒了"}, {"type": "subtitle", "time": 5723.99, "timestamp": "01:35:23", "text": "主意。是的。尽量不要把车停在……"}, {"type": "subtitle", "time": 5726.149, "timestamp": "01:35:26", "text": "你的走廊。好了。就这样吧"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "那里。完美的。我的天哪，这真是"}, {"type": "subtitle", "time": 5731.75, "timestamp": "01:35:31", "text": "好主意。你应该告诉他们。"}, {"type": "subtitle", "time": 5733.51, "timestamp": "01:35:33", "text": "[音乐]"}, {"type": "subtitle", "time": 5735.35, "timestamp": "01:35:35", "text": "你或许能从中获得一些收益。它是"}, {"type": "subtitle", "time": 5737.189, "timestamp": "01:35:37", "text": "你的想法。"}, {"type": "subtitle", "time": 5739.27, "timestamp": "01:35:39", "text": "真的吗？"}, {"type": "subtitle", "time": 5754.47, "timestamp": "01:35:54", "text": "是的。我觉得我没事，因为我也用力了。"}, {"type": "subtitle", "time": 5755.99, "timestamp": "01:35:55", "text": "你打算替他说什么？"}, {"type": "subtitle", "time": 5758.629, "timestamp": "01:35:58", "text": "那家伙能"}]
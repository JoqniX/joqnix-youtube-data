[{"type": "subtitle", "time": 181.27, "timestamp": "00:03:01", "text": "快点。我想给你，我想"}, {"type": "subtitle", "time": 184.07, "timestamp": "00:03:04", "text": "把这身盔甲给你。"}, {"type": "subtitle", "time": 186.309, "timestamp": "00:03:06", "text": "你在哪里？你心情愉悦还是低落？"}, {"type": "subtitle", "time": 189.589, "timestamp": "00:03:09", "text": "哦，你起床了。好的，我会去。"}, {"type": "subtitle", "time": 191.19, "timestamp": "00:03:11", "text": "别担心。哦，等等。停留"}, {"type": "subtitle", "time": 193.50900000000001, "timestamp": "00:03:13", "text": "那里。你，你听到了声音。哦，谢谢"}, {"type": "subtitle", "time": 196.22899999999998, "timestamp": "00:03:16", "text": "你。然后你给自己加满油"}, {"type": "subtitle", "time": 199.99, "timestamp": "00:03:19", "text": "我们出去吧。好的。韦恩，你在哪儿？"}, {"type": "subtitle", "time": 202.39, "timestamp": "00:03:22", "text": "又是你？进一步崩溃。我正在做"}, {"type": "subtitle", "time": 205.50900000000001, "timestamp": "00:03:25", "text": "我自己的事。是的，他自己做的。"}, {"type": "subtitle", "time": 208.309, "timestamp": "00:03:28", "text": "事物。没关系。"}, {"type": "subtitle", "time": 211.75, "timestamp": "00:03:31", "text": "他很享受他的冒险经历。不是"}, {"type": "subtitle", "time": 215.11, "timestamp": "00:03:35", "text": "感觉有点……我感觉很不舒服。"}, {"type": "subtitle", "time": 218.149, "timestamp": "00:03:38", "text": "附近有脚步声。哦，是的。那里"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "是脚步声。哦，与敌人交战。"}, {"type": "subtitle", "time": 228.149, "timestamp": "00:03:48", "text": "好的。哦，真棒。我的天哪。"}, {"type": "subtitle", "time": 231.82999999999998, "timestamp": "00:03:51", "text": "哦，真棒。一些极品装备。嗯，我是"}, {"type": "subtitle", "time": 233.99, "timestamp": "00:03:53", "text": "错过今天的直播。 WHO"}]
[{"type": "subtitle", "time": 14280.229, "timestamp": "03:58:00", "text": "哦，我需要去拿那个传感器。乔克"}, {"type": "subtitle", "time": 14282.55, "timestamp": "03:58:02", "text": "传感器模式。你在哪里？股骨传感器，"}, {"type": "subtitle", "time": 14284.63, "timestamp": "03:58:04", "text": "你在哪里？"}, {"type": "subtitle", "time": 14286.87, "timestamp": "03:58:06", "text": "我需要得到"}, {"type": "subtitle", "time": 14289.429, "timestamp": "03:58:09", "text": "传感器。"}, {"type": "subtitle", "time": 14292.63, "timestamp": "03:58:12", "text": "再见。等待，"}, {"type": "subtitle", "time": 14302.229, "timestamp": "03:58:22", "text": "嘿，伙计。拉屎。快点。就这样"}, {"type": "subtitle", "time": 14307.91, "timestamp": "03:58:27", "text": "啊，我们的网络黑客。别被骗了"}, {"type": "subtitle", "time": 14309.91, "timestamp": "03:58:29", "text": "通过CRT显示器和传真机。这"}, {"type": "subtitle", "time": 14313.03, "timestamp": "03:58:33", "text": "这里的硬件是最先进的。凉爽的。"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "嘿，其他船员呢？"}, {"type": "subtitle", "time": 14316.71, "timestamp": "03:58:36", "text": "外部。嘿，祝你们好运，兄弟们。患病的"}, {"type": "subtitle", "time": 14318.63, "timestamp": "03:58:38", "text": "Mission见！好的。哦，"}, {"type": "subtitle", "time": 14320.469, "timestamp": "03:58:40", "text": "我们大约会在那里见到你。"}, {"type": "subtitle", "time": 14323.189, "timestamp": "03:58:43", "text": "八吨黄金。四吨，不是"}, {"type": "subtitle", "time": 14326.07, "timestamp": "03:58:46", "text": "八。"}, {"type": "subtitle", "time": 14328.79, "timestamp": "03:58:48", "text": "好了，各位。我们走吧。进去"}, {"type": "subtitle", "time": 14332.469, "timestamp": "03:58:52", "text": "汽车，宝贝。我是在开玩笑。你在开玩笑吗？"}, {"type": "subtitle", "time": 14334.87, "timestamp": "03:58:54", "text": "为什么"}, {"type": "subtitle", "time": 14337.59, "timestamp": "03:58:57", "text": "我们要开车吗？我们走吧。这是"}]
[{"type": "subtitle", "time": 4562.709, "timestamp": "01:16:02", "text": "他们会说：“是啊，我们不想要你。”"}, {"type": "subtitle", "time": 4566.95, "timestamp": "01:16:06", "text": "想免费偷走我们的医疗包。”我，"}, {"type": "subtitle", "time": 4569.51, "timestamp": "01:16:09", "text": "看看这个。所以，你会怎么做？"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "什么？是的，这是新情况。这是一个"}, {"type": "subtitle", "time": 4575.27, "timestamp": "01:16:15", "text": "就像枪一样。所以，你把它放在上面"}, {"type": "subtitle", "time": 4579.27, "timestamp": "01:16:19", "text": "所以，你会这么做。"}, {"type": "subtitle", "time": 4581.669, "timestamp": "01:16:21", "text": "你把它放在车附近，然后你就可以"}, {"type": "subtitle", "time": 4583.91, "timestamp": "01:16:23", "text": "用它射击敌人。它很漂亮"}, {"type": "subtitle", "time": 4586.31, "timestamp": "01:16:26", "text": "强大的。"}, {"type": "subtitle", "time": 4587.91, "timestamp": "01:16:27", "text": "哇。"}, {"type": "subtitle", "time": 4591.11, "timestamp": "01:16:31", "text": "那确实有这么回事。是的。所以，你进去了"}, {"type": "subtitle", "time": 4594.47, "timestamp": "01:16:34", "text": "开车，然后按下这个按钮。"}, {"type": "subtitle", "time": 4596.39, "timestamp": "01:16:36", "text": "它会发射"}, {"type": "subtitle", "time": 4599.75, "timestamp": "01:16:39", "text": "一个巨大的激光器。但你必须这样做。"}, {"type": "subtitle", "time": 4602.07, "timestamp": "01:16:42", "text": "充电。"}, {"type": "subtitle", "time": 4605.27, "timestamp": "01:16:45", "text": "哦，找到了。"}]
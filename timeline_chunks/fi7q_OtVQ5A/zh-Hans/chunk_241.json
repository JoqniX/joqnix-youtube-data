[{"type": "subtitle", "time": 14465.59, "timestamp": "04:01:05", "text": "下车。离开"}, {"type": "subtitle", "time": 14468.71, "timestamp": "04:01:08", "text": "车辆。下车。"}, {"type": "subtitle", "time": 14471.189, "timestamp": "04:01:11", "text": "你不想为了这种破事丢掉性命。"}, {"type": "subtitle", "time": 14475.59, "timestamp": "04:01:15", "text": "拉屎。妈的。轮到你了，伙计。"}, {"type": "subtitle", "time": 14479.03, "timestamp": "04:01:19", "text": "赶紧他妈的动起来。快点。移动。"}, {"type": "subtitle", "time": 14489.429, "timestamp": "04:01:29", "text": "在TPS开始前我们还有一分钟时间。"}, {"type": "subtitle", "time": 14491.67, "timestamp": "04:01:31", "text": "读取异常。然后开始屠杀"}, {"type": "subtitle", "time": 14493.51, "timestamp": "04:01:33", "text": "进来。"}, {"type": "subtitle", "time": 14495.269, "timestamp": "04:01:35", "text": "这个。不。糟了。嘿，拜托。"}, {"type": "subtitle", "time": 14497.11, "timestamp": "04:01:37", "text": "无论你做什么。是的。没什么。我们需要"}, {"type": "subtitle", "time": 14500.07, "timestamp": "04:01:40", "text": "你。你叫什么名字？凯西。凯西。得到"}, {"type": "subtitle", "time": 14502.15, "timestamp": "04:01:42", "text": "在卡车里。我们走吧。去。去。"}, {"type": "subtitle", "time": 14509.11, "timestamp": "04:01:49", "text": "别再呜咽了。"}, {"type": "subtitle", "time": 14512.07, "timestamp": "04:01:52", "text": "下一站，联合储蓄银行。"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "不要把猫咪模式看作是"}]
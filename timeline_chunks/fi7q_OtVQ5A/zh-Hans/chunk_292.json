[{"type": "subtitle", "time": 17521.03, "timestamp": "04:52:01", "text": "我的兄弟们都是黑鬼。这不会改变我的"}, {"type": "subtitle", "time": 17523.11, "timestamp": "04:52:03", "text": "家庭。操，兄弟。你让我完全明白了"}, {"type": "subtitle", "time": 17525.03, "timestamp": "04:52:05", "text": "现在情绪激动。那家伙可能得停下来了。"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "别让我吸你的鸡巴，黑鬼。黑鬼，"}, {"type": "subtitle", "time": 17531.27, "timestamp": "04:52:11", "text": "滚开，你这人。镇上的每个傻瓜"}, {"type": "subtitle", "time": 17533.59, "timestamp": "04:52:13", "text": "有人想鼓掌。是的，但是"}, {"type": "subtitle", "time": 17535.51, "timestamp": "04:52:15", "text": "这句话对某些傻瓜来说尤其适用。"}, {"type": "subtitle", "time": 17537.83, "timestamp": "04:52:17", "text": "其他的。我听到了，兄弟。我在说话"}, {"type": "subtitle", "time": 17540.15, "timestamp": "04:52:20", "text": "关于你。镇上每个人都想"}, {"type": "subtitle", "time": 17543.51, "timestamp": "04:52:23", "text": "狠狠地打你屁股一下。排队和"}, {"type": "subtitle", "time": 17546.12, "timestamp": "04:52:26", "text": "希斯"}, {"type": "subtitle", "time": 17548.31, "timestamp": "04:52:28", "text": "[音乐]"}, {"type": "subtitle", "time": 17551.35, "timestamp": "04:52:31", "text": "干掉尽可能多的混蛋"}, {"type": "subtitle", "time": 17553.11, "timestamp": "04:52:33", "text": "拉屎。兄弟，你玩得大，你就得站稳脚跟"}]
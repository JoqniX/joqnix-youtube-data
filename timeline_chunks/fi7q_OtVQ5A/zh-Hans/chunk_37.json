[{"type": "subtitle", "time": 2221.43, "timestamp": "00:37:01", "text": "好吧，那就保持满载状态吧。所以，"}, {"type": "subtitle", "time": 2223.43, "timestamp": "00:37:03", "text": "我应该做什么？你想让我主持吗？"}, {"type": "subtitle", "time": 2225.27, "timestamp": "00:37:05", "text": "它？"}, {"type": "subtitle", "time": 2227.51, "timestamp": "00:37:07", "text": "呃，你可以主办。是啊，因为我得到了这么多"}, {"type": "subtitle", "time": 2230.39, "timestamp": "00:37:10", "text": "这里有很多这样的人。比如说，“好的，我私信你了。”"}, {"type": "subtitle", "time": 2236.71, "timestamp": "00:37:16", "text": "选择最佳地区。"}, {"type": "subtitle", "time": 2238.71, "timestamp": "00:37:18", "text": "哦，是的。我应该选择哪个地区？"}, {"type": "subtitle", "time": 2240.39, "timestamp": "00:37:20", "text": "选择？"}, {"type": "subtitle", "time": 2241.91, "timestamp": "00:37:21", "text": "哦，天哪，我不知道。因为我参与其中"}, {"type": "subtitle", "time": 2245.19, "timestamp": "00:37:25", "text": "欧洲，所以我不清楚。好的，我会"}, {"type": "subtitle", "time": 2248.55, "timestamp": "00:37:28", "text": "选择欧洲。好的。如果太卡顿，"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "你可以根据需要进行更改。我应该"}, {"type": "subtitle", "time": 2251.85, "timestamp": "00:37:31", "text": "没事的。"}, {"type": "subtitle", "time": 2253.589, "timestamp": "00:37:33", "text": "[音乐]"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "哦，我不得不写一部分。但这是"}, {"type": "subtitle", "time": 2277.109, "timestamp": "00:37:57", "text": "哇。"}]
[{"type": "subtitle", "time": 10744.87, "timestamp": "02:59:04", "text": "你那边现在是凌晨12点吗？我是谁？"}, {"type": "subtitle", "time": 10746.469, "timestamp": "02:59:06", "text": "正确的？你来自哪个时区？"}, {"type": "subtitle", "time": 10748.87, "timestamp": "02:59:08", "text": "再次？"}, {"type": "subtitle", "time": 10752.63, "timestamp": "02:59:12", "text": "呃，现在是格林威治标准时间吗？"}, {"type": "subtitle", "time": 10755.91, "timestamp": "02:59:15", "text": "是吗？是吗？是吗？是吗？是吗？"}, {"type": "subtitle", "time": 10758.15, "timestamp": "02:59:18", "text": "呃，现在几点了，伙计？什么是"}, {"type": "subtitle", "time": 10759.67, "timestamp": "02:59:19", "text": "你？"}, {"type": "subtitle", "time": 10764.23, "timestamp": "02:59:24", "text": "是的。呃，凌晨12点22分。是吗？"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "比如你的时区是格林威治标准时间减去……"}, {"type": "subtitle", "time": 10772.23, "timestamp": "02:59:32", "text": "5-7？"}, {"type": "subtitle", "time": 10776.87, "timestamp": "02:59:36", "text": "是零下7度吗？ GMT - 7 您的时区。"}, {"type": "subtitle", "time": 10780.71, "timestamp": "02:59:40", "text": "呃，等等，我应该看看……"}, {"type": "subtitle", "time": 10785.83, "timestamp": "02:59:45", "text": "太平洋夏令时，对吧？ PST PDT"}, {"type": "subtitle", "time": 10787.67, "timestamp": "02:59:47", "text": "为了您"}, {"type": "subtitle", "time": 10790.87, "timestamp": "02:59:50", "text": "准确的美国时间。"}, {"type": "subtitle", "time": 10793.99, "timestamp": "02:59:53", "text": "因为我对此感到困惑，因为我"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "我一直在关注这个太平洋夏令时 (PDT) 时间"}, {"type": "subtitle", "time": 10799.67, "timestamp": "02:59:59", "text": "日程安排什么的，但我知道我知道"}]
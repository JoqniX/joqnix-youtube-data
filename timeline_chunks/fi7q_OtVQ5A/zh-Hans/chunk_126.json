[{"type": "subtitle", "time": 7560.709, "timestamp": "02:06:00", "text": "得到它。他一点也不觉得痛苦。"}, {"type": "subtitle", "time": 7563.109, "timestamp": "02:06:03", "text": "你做得很好。"}, {"type": "subtitle", "time": 7566.709, "timestamp": "02:06:06", "text": "糟糕，他又要回来了。"}, {"type": "subtitle", "time": 7569.35, "timestamp": "02:06:09", "text": "哦，是修牙。抱歉，不要"}, {"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "别担心。"}, {"type": "subtitle", "time": 7575.43, "timestamp": "02:06:15", "text": "好吧，我其实放他们过去了。"}, {"type": "subtitle", "time": 7588.87, "timestamp": "02:06:28", "text": "让小丑上场有点不公平。"}, {"type": "subtitle", "time": 7591.43, "timestamp": "02:06:31", "text": "第一级。"}, {"type": "subtitle", "time": 7605.83, "timestamp": "02:06:45", "text": "好的，我就把你放在这里。"}]
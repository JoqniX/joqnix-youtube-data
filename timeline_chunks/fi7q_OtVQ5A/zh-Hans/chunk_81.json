[{"type": "subtitle", "time": 4874.63, "timestamp": "01:21:14", "text": "当这条更新发布或点赞时"}, {"type": "subtitle", "time": 4876.63, "timestamp": "01:21:16", "text": "现场直播，每个人都会……"}, {"type": "subtitle", "time": 4887.83, "timestamp": "01:21:27", "text": "大家都会说：“哇，你……”"}, {"type": "subtitle", "time": 4891.189, "timestamp": "01:21:31", "text": "无法再次出现健康故障"}, {"type": "subtitle", "time": 4894.87, "timestamp": "01:21:34", "text": "不再了。”我的天哪。"}, {"type": "subtitle", "time": 4896.63, "timestamp": "01:21:36", "text": "出色地，"}, {"type": "subtitle", "time": 4898.07, "timestamp": "01:21:38", "text": "我不知道他们什么时候会添加"}, {"type": "subtitle", "time": 4899.83, "timestamp": "01:21:39", "text": "它。我不知道他们是否已经有了"}, {"type": "subtitle", "time": 4902.39, "timestamp": "01:21:42", "text": "加上它，但他们计划添加一个"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "在游戏中模仿。模仿。"}, {"type": "subtitle", "time": 4907.83, "timestamp": "01:21:47", "text": "嗯哼。"}, {"type": "subtitle", "time": 4911.35, "timestamp": "01:21:51", "text": "哦。我的天啊。"}, {"type": "subtitle", "time": 4913.99, "timestamp": "01:21:53", "text": "生活发生了哪些变化？"}]
[{"type": "subtitle", "time": 3069.51, "timestamp": "00:51:09", "text": "好了，过来。快点。等待。跟我来。"}, {"type": "subtitle", "time": 3079.75, "timestamp": "00:51:19", "text": "小鸭子。是的。"}, {"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "哦，瞧。看看我们拥有什么。过来。"}, {"type": "subtitle", "time": 3097.109, "timestamp": "00:51:37", "text": "好的。就在这里。准备好了。不。"}, {"type": "subtitle", "time": 3119.589, "timestamp": "00:51:59", "text": "我还是第一次见到这种情况。为什么？"}]
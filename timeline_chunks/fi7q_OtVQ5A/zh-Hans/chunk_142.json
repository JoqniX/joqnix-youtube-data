[{"type": "subtitle", "time": 8522.469, "timestamp": "02:22:02", "text": "正在播放。"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "是的，我的手机里还保存着一些照片。"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "桌面不知在哪儿。啊，不错。"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "我一直都在尝试截图"}, {"type": "subtitle", "time": 8545.75, "timestamp": "02:22:25", "text": "当我们身处群体之中时，会发生一些事情。嗯。"}, {"type": "subtitle", "time": 8549.429, "timestamp": "02:22:29", "text": "是的。为了回忆。是的。"}, {"type": "subtitle", "time": 8553.429, "timestamp": "02:22:33", "text": "是的。我把它放在一个特别的地方。"}, {"type": "subtitle", "time": 8555.349, "timestamp": "02:22:35", "text": "哦，好诡异的婴儿。好可怕。那"}, {"type": "subtitle", "time": 8557.51, "timestamp": "02:22:37", "text": "吓到我了。"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "有多少个婴儿？哦，是这个。"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "它不见了。"}, {"type": "subtitle", "time": 8572.95, "timestamp": "02:22:52", "text": "但还有另一个。"}, {"type": "subtitle", "time": 8576.309, "timestamp": "02:22:56", "text": "没关系。就像站在那里一样"}, {"type": "subtitle", "time": 8578.79, "timestamp": "02:22:58", "text": "修长的人。"}]
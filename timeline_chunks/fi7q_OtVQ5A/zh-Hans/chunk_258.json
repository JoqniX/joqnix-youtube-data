[{"type": "subtitle", "time": 15481.99, "timestamp": "04:18:01", "text": "主。"}, {"type": "subtitle", "time": 15484.79, "timestamp": "04:18:04", "text": "对不起。我只是有些信任。"}, {"type": "subtitle", "time": 15495.349, "timestamp": "04:18:15", "text": "我以为你的电脑没有"}, {"type": "subtitle", "time": 15513.11, "timestamp": "04:18:33", "text": "因为我很有钱。我很伤心，因为我"}, {"type": "subtitle", "time": 15516.55, "timestamp": "04:18:36", "text": "成功的。真是太可悲了。"}, {"type": "subtitle", "time": 15520.71, "timestamp": "04:18:40", "text": "哦，我真是太抱歉了。"}, {"type": "subtitle", "time": 15530.309, "timestamp": "04:18:50", "text": "[音乐]"}, {"type": "subtitle", "time": 15536.87, "timestamp": "04:18:56", "text": "我刚刚猎杀了那只鹿。"}]
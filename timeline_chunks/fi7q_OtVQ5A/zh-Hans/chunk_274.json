[{"type": "subtitle", "time": 16443.83, "timestamp": "04:34:03", "text": "莱斯特，老兄，我们需要谈谈。我得到了"}, {"type": "subtitle", "time": 16446.23, "timestamp": "04:34:06", "text": "兄弟，我遇到个问题需要你帮忙。"}, {"type": "subtitle", "time": 16448.869, "timestamp": "04:34:08", "text": "算了，管他呢。我们都得到了"}, {"type": "subtitle", "time": 16451.109, "timestamp": "04:34:11", "text": "您能帮我们解决什么问题？冷静下来。"}, {"type": "subtitle", "time": 16453.83, "timestamp": "04:34:13", "text": "好的。来我家。好的。"}, {"type": "subtitle", "time": 16475.429, "timestamp": "04:34:35", "text": "不，我不想哭。我想要"}, {"type": "subtitle", "time": 16478.629, "timestamp": "04:34:38", "text": "圆满结局。"}]
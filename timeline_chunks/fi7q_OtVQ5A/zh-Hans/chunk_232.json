[{"type": "subtitle", "time": 13922.63, "timestamp": "03:52:02", "text": "让我们来画一个深深的问号。你已经"}, {"type": "subtitle", "time": 13925.11, "timestamp": "03:52:05", "text": "被击中"}, {"type": "subtitle", "time": 13931.59, "timestamp": "03:52:11", "text": "你原本打算这么做吗？"}, {"type": "subtitle", "time": 13933.75, "timestamp": "03:52:13", "text": "你被卡车撞了。哦，不。是"}, {"type": "subtitle", "time": 13937.99, "timestamp": "03:52:17", "text": "将会转世重生。我们走吧。"}, {"type": "subtitle", "time": 13948.229, "timestamp": "03:52:28", "text": "难道没有卡车VTuber吗？"}, {"type": "subtitle", "time": 13950.63, "timestamp": "03:52:30", "text": "哦，对了，有个卡车VTuber"}, {"type": "subtitle", "time": 13952.95, "timestamp": "03:52:32", "text": "让每个人都得到一个新风筝"}, {"type": "subtitle", "time": 13954.469, "timestamp": "03:52:34", "text": "世界。"}, {"type": "subtitle", "time": 13956.87, "timestamp": "03:52:36", "text": "哦，是的。"}, {"type": "subtitle", "time": 13959.429, "timestamp": "03:52:39", "text": "甚至还有耶稣。"}, {"type": "subtitle", "time": 13962.309, "timestamp": "03:52:42", "text": "还有一个耶稣基督的YouTube博主。哦"}, {"type": "subtitle", "time": 13966.71, "timestamp": "03:52:46", "text": "我的上帝。接下来会发生什么？"}, {"type": "subtitle", "time": 13969.349, "timestamp": "03:52:49", "text": "那里有什么？不是"}, {"type": "subtitle", "time": 13972.469, "timestamp": "03:52:52", "text": "下一个。我想看迈克尔·杰克逊"}, {"type": "subtitle", "time": 13974.87, "timestamp": "03:52:54", "text": "YouTuber。是的，有个耶稣相关的油管博主。"}, {"type": "subtitle", "time": 13977.83, "timestamp": "03:52:57", "text": "在推特上搜索“耶稣 YouTuber”即可。"}]
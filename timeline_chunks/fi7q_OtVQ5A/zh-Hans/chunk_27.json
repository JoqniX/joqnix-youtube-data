[{"type": "subtitle", "time": 1622.549, "timestamp": "00:27:02", "text": "太棒了。"}, {"type": "subtitle", "time": 1625.029, "timestamp": "00:27:05", "text": "顺便说一句，我没有杀任何人。我杀过人吗？"}, {"type": "subtitle", "time": 1627.029, "timestamp": "00:27:07", "text": "有人吗？我不这么认为。我不杀人"}, {"type": "subtitle", "time": 1629.029, "timestamp": "00:27:09", "text": "任何人。哦，我杀了三个人。哦，"}, {"type": "subtitle", "time": 1631.11, "timestamp": "00:27:11", "text": "凉爽的。"}, {"type": "subtitle", "time": 1636.07, "timestamp": "00:27:16", "text": "哦，乔克。嘿，你做得很好。"}, {"type": "subtitle", "time": 1639.269, "timestamp": "00:27:19", "text": "哦，等等。我击杀了两个人。什么？我"}, {"type": "subtitle", "time": 1641.43, "timestamp": "00:27:21", "text": "不知道"}, {"type": "subtitle", "time": 1661.75, "timestamp": "00:27:41", "text": "好的。总之，我这就去……"}, {"type": "subtitle", "time": 1670.23, "timestamp": "00:27:50", "text": "当我可以炫耀的时候，我就可以炫耀了。"}, {"type": "subtitle", "time": 1672.47, "timestamp": "00:27:52", "text": "我需要的很多东西。"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "全新状态。"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "你需要多少？"}]
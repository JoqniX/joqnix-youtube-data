[{"type": "subtitle", "time": 18481.19, "timestamp": "05:08:01", "text": "把他扔进去？拉屎。特雷弗会投掷"}, {"type": "subtitle", "time": 18482.948, "timestamp": "05:08:02", "text": "任何人只是为了满足自己的血欲。"}, {"type": "subtitle", "time": 18485.51, "timestamp": "05:08:05", "text": "欲望。嘿，这叫他妈的松散"}, {"type": "subtitle", "time": 18486.948, "timestamp": "05:08:06", "text": "结尾。好的。如果我们要……"}, {"type": "subtitle", "time": 18489.67, "timestamp": "05:08:09", "text": "爱好和平与安宁的人们，我们捆绑在一起"}, {"type": "subtitle", "time": 18493.43, "timestamp": "05:08:13", "text": "未完成的工作。是的。一直是个累赘。"}, {"type": "subtitle", "time": 18494.55, "timestamp": "05:08:14", "text": "那么我们就得处理……"}, {"type": "subtitle", "time": 18498.23, "timestamp": "05:08:18", "text": "我们的老朋友们和史蒂夫。他妈的。真是"}, {"type": "subtitle", "time": 18507.11, "timestamp": "05:08:27", "text": "[音乐]"}, {"type": "subtitle", "time": 18509.11, "timestamp": "05:08:29", "text": "这是谁？请勿拨打此号码。"}, {"type": "subtitle", "time": 18511.51, "timestamp": "05:08:31", "text": "嘿，是我，狗狗。你还活着。我"}, {"type": "subtitle", "time": 18512.948, "timestamp": "05:08:32", "text": "我以为有人可能拿走了你的手机。"}, {"type": "subtitle", "time": 18514.628, "timestamp": "05:08:34", "text": "不，不，不过你看，我开了免提。"}, {"type": "subtitle", "time": 18516.55, "timestamp": "05:08:36", "text": "电话。你或许能成功。是的，我是"}, {"type": "subtitle", "time": 18519.11, "timestamp": "05:08:39", "text": "这里。另一个呢？看到你放"}, {"type": "subtitle", "time": 18522.948, "timestamp": "05:08:42", "text": "地面轮。嗯哼。"}, {"type": "subtitle", "time": 18525.11, "timestamp": "05:08:45", "text": "不，我们还有工作要做。是的。你能得到"}, {"type": "subtitle", "time": 18527.43, "timestamp": "05:08:47", "text": "告诉我们你在哪里？我会尽力而为。"}, {"type": "subtitle", "time": 18531.03, "timestamp": "05:08:51", "text": "WHO？史蒂夫·海恩斯首发，迪昂·韦斯特"}, {"type": "subtitle", "time": 18537.67, "timestamp": "05:08:57", "text": "还有Ching。魏成"}]
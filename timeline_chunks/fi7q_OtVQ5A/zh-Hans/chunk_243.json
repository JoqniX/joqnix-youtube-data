[{"type": "subtitle", "time": 14610.389, "timestamp": "04:03:30", "text": "访问。"}, {"type": "subtitle", "time": 14612.87, "timestamp": "04:03:32", "text": "我的天啊。"}, {"type": "subtitle", "time": 14616.469, "timestamp": "04:03:36", "text": "问问马克斯这件事。他知道这件事。"}, {"type": "subtitle", "time": 14619.03, "timestamp": "04:03:39", "text": "嗯？"}, {"type": "subtitle", "time": 14620.71, "timestamp": "04:03:40", "text": "等等，这和什么有关？"}, {"type": "subtitle", "time": 14624.309, "timestamp": "04:03:44", "text": "你们在私信里发的东西"}, {"type": "subtitle", "time": 14626.87, "timestamp": "04:03:46", "text": "最近有团体吗？"}, {"type": "subtitle", "time": 14629.91, "timestamp": "04:03:49", "text": "那些可疑的东西？"}]
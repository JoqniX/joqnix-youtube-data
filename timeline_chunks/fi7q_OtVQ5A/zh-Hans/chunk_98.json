[{"type": "subtitle", "time": 5881.83, "timestamp": "01:38:01", "text": "你刚才是不是……"}, {"type": "subtitle", "time": 5886.07, "timestamp": "01:38:06", "text": "是的，你做到了。我的天哪。"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "如何？"}, {"type": "subtitle", "time": 5891.27, "timestamp": "01:38:11", "text": "我甚至都没跑。"}, {"type": "subtitle", "time": 5900.629, "timestamp": "01:38:20", "text": "哦，他能感觉到。我想他可以"}, {"type": "subtitle", "time": 5903.35, "timestamp": "01:38:23", "text": "我能听到你说话的声音，或者你能靠得太近。"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "对他来说。"}, {"type": "subtitle", "time": 5912.47, "timestamp": "01:38:32", "text": "哦，那是新品。开枪了。"}, {"type": "subtitle", "time": 5914.629, "timestamp": "01:38:34", "text": "想要。哦，等等。那后面是什么？"}, {"type": "subtitle", "time": 5918.229, "timestamp": "01:38:38", "text": "你？我不太确定它是不是……"}, {"type": "subtitle", "time": 5920.87, "timestamp": "01:38:40", "text": "百奇饼干或唱片。它看起来像一个"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "交通状况如何？"}]
[{"type": "subtitle", "time": 18060.15, "timestamp": "05:01:00", "text": "所以，我就选这个了。"}, {"type": "subtitle", "time": 18063.11, "timestamp": "05:01:03", "text": "你这混蛋，你终于出现了。是什么？"}, {"type": "subtitle", "time": 18065.51, "timestamp": "05:01:05", "text": "问题？我有点喘不过气来。全部"}, {"type": "subtitle", "time": 18068.788, "timestamp": "05:01:08", "text": "对，我很高兴见到你。"}, {"type": "subtitle", "time": 18072.788, "timestamp": "05:01:12", "text": "激动不已。下次"}, {"type": "subtitle", "time": 18092.39, "timestamp": "05:01:32", "text": "不，又来了。"}, {"type": "subtitle", "time": 18095.83, "timestamp": "05:01:35", "text": "我的天啊。"}]
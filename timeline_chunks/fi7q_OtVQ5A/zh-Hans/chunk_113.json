[{"type": "subtitle", "time": 6782.07, "timestamp": "01:53:02", "text": "你想去的地方，对吧？我也这么认为。"}, {"type": "subtitle", "time": 6789.589, "timestamp": "01:53:09", "text": "他是"}, {"type": "subtitle", "time": 6791.91, "timestamp": "01:53:11", "text": "迫降。"}, {"type": "subtitle", "time": 6796.149, "timestamp": "01:53:16", "text": "不，"}, {"type": "subtitle", "time": 6798.149, "timestamp": "01:53:18", "text": "这很好。"}, {"type": "subtitle", "time": 6802.95, "timestamp": "01:53:22", "text": "又一次迫降。好的。我是否"}, {"type": "subtitle", "time": 6805.51, "timestamp": "01:53:25", "text": "如果你只是按"}, {"type": "subtitle", "time": 6807.43, "timestamp": "01:53:27", "text": "换挡，它应该能阻止你做芭蕾动作。"}, {"type": "subtitle", "time": 6815.99, "timestamp": "01:53:35", "text": "我必须再按一次空格键。"}, {"type": "subtitle", "time": 6823.51, "timestamp": "01:53:43", "text": "真有趣。"}, {"type": "subtitle", "time": 6825.669, "timestamp": "01:53:45", "text": "你们可以。"}, {"type": "subtitle", "time": 6827.189, "timestamp": "01:53:47", "text": "好的。你还有什么其他想说的吗？"}, {"type": "subtitle", "time": 6831.91, "timestamp": "01:53:51", "text": "想？因为我们付不起那么贵的房租。"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "很多钱。哦，你带了吗？"}, {"type": "subtitle", "time": 6837.35, "timestamp": "01:53:57", "text": "东西？你需要什么？我有。是的。我"}]
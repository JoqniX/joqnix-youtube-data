[{"type": "subtitle", "time": 2700.47, "timestamp": "00:45:00", "text": "我们只要待在这里，就能听到彼此的声音。"}, {"type": "subtitle", "time": 2703.19, "timestamp": "00:45:03", "text": "其他的，因为我们在谈论的，都无关紧要。"}, {"type": "subtitle", "time": 2705.829, "timestamp": "00:45:05", "text": "关于音频。呃，你想用这个吗？"}, {"type": "subtitle", "time": 2709.19, "timestamp": "00:45:09", "text": "用汽车代替游戏里的汽车吗？唯一"}, {"type": "subtitle", "time": 2710.87, "timestamp": "00:45:10", "text": "游戏内出现问题，我们将无法"}, {"type": "subtitle", "time": 2713.19, "timestamp": "00:45:13", "text": "互相倾听。如果嗯，你可以这样做"}, {"type": "subtitle", "time": 2716.71, "timestamp": "00:45:16", "text": "但话说回来，当有人去世时，"}, {"type": "subtitle", "time": 2718.63, "timestamp": "00:45:18", "text": "你不会仅仅为了玩它而了解它。"}, {"type": "subtitle", "time": 2724.15, "timestamp": "00:45:24", "text": "然后我们就可以使用这张卡了，我"}, {"type": "subtitle", "time": 2727.27, "timestamp": "00:45:27", "text": "猜测。是的。"}, {"type": "subtitle", "time": 2736.309, "timestamp": "00:45:36", "text": "我们走吧。"}, {"type": "subtitle", "time": 2741.43, "timestamp": "00:45:41", "text": "我的天哪，这是我第一次来这里"}, {"type": "subtitle", "time": 2745.27, "timestamp": "00:45:45", "text": "测试版。那些怪物，你不能"}, {"type": "subtitle", "time": 2748.28, "timestamp": "00:45:48", "text": "像以前一样经常捡起来。"}, {"type": "subtitle", "time": 2750.71, "timestamp": "00:45:50", "text": "[音乐]"}, {"type": "subtitle", "time": 2754.71, "timestamp": "00:45:54", "text": "好的。哦，等等。如果你按下“哦，是的。”"}]
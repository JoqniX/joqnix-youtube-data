[{"type": "subtitle", "time": 11473.67, "timestamp": "03:11:13", "text": "我的天啊，特雷弗怎么了？为什么"}, {"type": "subtitle", "time": 11478.07, "timestamp": "03:11:18", "text": "他是不是赤身裸体地躺在女人……呃……"}, {"type": "subtitle", "time": 11481.75, "timestamp": "03:11:21", "text": "衣服？我们被外星人绑架了。"}, {"type": "subtitle", "time": 11483.75, "timestamp": "03:11:23", "text": "我的天啊。你发生了什么事？"}, {"type": "subtitle", "time": 11486.79, "timestamp": "03:11:26", "text": "特雷弗？你为什么穿女装"}, {"type": "subtitle", "time": 11489.51, "timestamp": "03:11:29", "text": "裙子之类的？这就是你所说的"}, {"type": "subtitle", "time": 11492.71, "timestamp": "03:11:32", "text": "再次一"}, {"type": "subtitle", "time": 11495.269, "timestamp": "03:11:35", "text": "因为我会做好事。不管是什么，我"}, {"type": "subtitle", "time": 11497.269, "timestamp": "03:11:37", "text": "我爱你，但我是一位妻子，妻子必须如此。"}, {"type": "subtitle", "time": 11500.23, "timestamp": "03:11:40", "text": "等等，等等，等等，等等。我需要"}, {"type": "subtitle", "time": 11516.63, "timestamp": "03:11:56", "text": "等等，帕特里夏甩了特雷弗吗？"}, {"type": "subtitle", "time": 11519.429, "timestamp": "03:11:59", "text": "什么？"}]
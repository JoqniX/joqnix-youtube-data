[{"type": "subtitle", "time": 903.75, "timestamp": "00:15:03", "text": "你好。你好。另外，请告诉我我的"}, {"type": "subtitle", "time": 906.31, "timestamp": "00:15:06", "text": "直播崩溃或其他什么情况"}, {"type": "subtitle", "time": 908.71, "timestamp": "00:15:08", "text": "看着我。但还是请让我"}, {"type": "subtitle", "time": 915.189, "timestamp": "00:15:15", "text": "好吧。好的。我会回来的。"}, {"type": "subtitle", "time": 917.43, "timestamp": "00:15:17", "text": "嘿。嘿，大家好。"}, {"type": "subtitle", "time": 919.59, "timestamp": "00:15:19", "text": "嘿，大家好。我回来了。嗨，大家好。我知道"}, {"type": "subtitle", "time": 921.99, "timestamp": "00:15:21", "text": "你很想我。嗯，好的。我们走吧。没有人"}, {"type": "subtitle", "time": 925.35, "timestamp": "00:15:25", "text": "死的。没有人这样做。没有人这样做。"}, {"type": "subtitle", "time": 927.75, "timestamp": "00:15:27", "text": "我完全确定有人真的"}, {"type": "subtitle", "time": 932.71, "timestamp": "00:15:32", "text": "做过。我不这么认为。等待。不是你。"}, {"type": "subtitle", "time": 934.389, "timestamp": "00:15:34", "text": "不，不，不。我想你是对的。没有人"}, {"type": "subtitle", "time": 937.269, "timestamp": "00:15:37", "text": "没有亲吻。"}, {"type": "subtitle", "time": 943.03, "timestamp": "00:15:43", "text": "等待。"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "你同意了。等待。什么是？"}, {"type": "subtitle", "time": 952.629, "timestamp": "00:15:52", "text": "没有人同意你刚才说的话。"}, {"type": "subtitle", "time": 956.47, "timestamp": "00:15:56", "text": "朋友，没人关心你。是的，我"}, {"type": "subtitle", "time": 958.71, "timestamp": "00:15:58", "text": "我说过了。我说过了。没人关心，"}]
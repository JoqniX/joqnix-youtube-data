[{"type": "subtitle", "time": 17280.07, "timestamp": "04:48:00", "text": "最后卸载这个游戏，就此结束。"}, {"type": "subtitle", "time": 17291.35, "timestamp": "04:48:11", "text": "只有在我……我只会……的情况下我才会安装它。"}, {"type": "subtitle", "time": 17293.43, "timestamp": "04:48:13", "text": "当我需要它的时候就安装它"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "合作或其他重要的事情"}, {"type": "subtitle", "time": 17299.59, "timestamp": "04:48:19", "text": "仅此一次重要。"}, {"type": "subtitle", "time": 17302.788, "timestamp": "04:48:22", "text": "我希望我已经……我非常抱歉"}, {"type": "subtitle", "time": 17307.59, "timestamp": "04:48:27", "text": "把它推出来。加油，兄弟。我会坚持下去"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "W 而不是"}, {"type": "subtitle", "time": 17323.03, "timestamp": "04:48:43", "text": "所以，我超级担心，也很困惑。"}, {"type": "subtitle", "time": 17325.83, "timestamp": "04:48:45", "text": "关于之前发生的事情。你看"}, {"type": "subtitle", "time": 17329.19, "timestamp": "04:48:49", "text": "它变黑了，对吧？"}, {"type": "subtitle", "time": 17332.31, "timestamp": "04:48:52", "text": "我有点担心。这到底是怎么回事？"}, {"type": "subtitle", "time": 17334.788, "timestamp": "04:48:54", "text": "对话无法跳过。你知道，我"}, {"type": "subtitle", "time": 17336.15, "timestamp": "04:48:56", "text": "不想说些什么。他们是"}, {"type": "subtitle", "time": 17337.83, "timestamp": "04:48:57", "text": "种族歧视者。你不能尝试那些"}]
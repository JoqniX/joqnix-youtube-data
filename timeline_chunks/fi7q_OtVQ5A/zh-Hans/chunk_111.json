[{"type": "subtitle", "time": 6662.31, "timestamp": "01:51:02", "text": "我拿到了这一边。耶。"}, {"type": "subtitle", "time": 6666.79, "timestamp": "01:51:06", "text": "不。好的。我，我自己，手榴弹。完美的。"}, {"type": "subtitle", "time": 6669.669, "timestamp": "01:51:09", "text": "给你，一颗手榴弹。"}, {"type": "subtitle", "time": 6673.75, "timestamp": "01:51:13", "text": "这是一枚手榴弹。这是一个桶。"}, {"type": "subtitle", "time": 6677.27, "timestamp": "01:51:17", "text": "然后你看，还有更多手榴弹。"}, {"type": "subtitle", "time": 6697.83, "timestamp": "01:51:37", "text": "想象一下你把这个放到战斗中。"}, {"type": "subtitle", "time": 6701.189, "timestamp": "01:51:41", "text": "还会这样吗？哦，我见过一些人。"}, {"type": "subtitle", "time": 6703.109, "timestamp": "01:51:43", "text": "把鸭子放在他们放鸭子的地方。"}, {"type": "subtitle", "time": 6707.109, "timestamp": "01:51:47", "text": "先将手榴弹放在下面，然后再放进去。"}, {"type": "subtitle", "time": 6710.07, "timestamp": "01:51:50", "text": "我见过这种情况。"}, {"type": "subtitle", "time": 6713.189, "timestamp": "01:51:53", "text": "A B."}]
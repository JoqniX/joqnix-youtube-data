[{"type": "subtitle", "time": 20160.708, "timestamp": "05:36:00", "text": "该国认为瑜伽很愚蠢"}, {"type": "subtitle", "time": 20164.07, "timestamp": "05:36:04", "text": "似乎喜欢盐屠宰"}, {"type": "subtitle", "time": 20167.43, "timestamp": "05:36:07", "text": "不具雄心壮志"}, {"type": "subtitle", "time": 20169.43, "timestamp": "05:36:09", "text": "友好但令人恐惧，没能完成"}, {"type": "subtitle", "time": 20171.35, "timestamp": "05:36:11", "text": "我不知道他们是否需要帮助，但我知道"}, {"type": "subtitle", "time": 20175.35, "timestamp": "05:36:15", "text": "我做什么？"}, {"type": "subtitle", "time": 20185.75, "timestamp": "05:36:25", "text": "这份报告可以成为你的精神科报告。"}, {"type": "subtitle", "time": 20187.67, "timestamp": "05:36:27", "text": "可以找到"}, {"type": "subtitle", "time": 20197.43, "timestamp": "05:36:37", "text": "嗯？这就是我问的原因"}, {"type": "subtitle", "time": 20201.27, "timestamp": "05:36:41", "text": "你按下那个愿望键。哦，原来如此。"}, {"type": "subtitle", "time": 20203.27, "timestamp": "05:36:43", "text": "哦好的。"}, {"type": "subtitle", "time": 20208.39, "timestamp": "05:36:48", "text": "我还有什么需要完成的吗？"}, {"type": "subtitle", "time": 20211.43, "timestamp": "05:36:51", "text": "只有怪人和异类才会这样，对吧？这"}]
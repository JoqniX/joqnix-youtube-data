[{"type": "subtitle", "time": 6840.39, "timestamp": "01:54:00", "text": "刚拿到手榴弹之类的东西。不，走吧。"}, {"type": "subtitle", "time": 6843.35, "timestamp": "01:54:03", "text": "是的，我们很好。好的，你可以"}, {"type": "subtitle", "time": 6846.709, "timestamp": "01:54:06", "text": "这次一定要买下来。嗯？"}, {"type": "subtitle", "time": 6859.99, "timestamp": "01:54:19", "text": "[音乐]"}, {"type": "subtitle", "time": 6863.589, "timestamp": "01:54:23", "text": "我要把它偷走。"}, {"type": "subtitle", "time": 6866.55, "timestamp": "01:54:26", "text": "好的。祝你好运。前往"}, {"type": "subtitle", "time": 6870.87, "timestamp": "01:54:30", "text": "看看你的模仿效果如何。枪。"}, {"type": "subtitle", "time": 6879.83, "timestamp": "01:54:39", "text": "你没看到吗？它不见了。我告诉你了。"}, {"type": "subtitle", "time": 6887.91, "timestamp": "01:54:47", "text": "你想要手榴弹还是你想要"}]
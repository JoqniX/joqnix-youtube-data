[{"type": "subtitle", "time": 17403.27, "timestamp": "04:50:03", "text": "去这所房子接布拉玛。好的，"}, {"type": "subtitle", "time": 17408.76, "timestamp": "04:50:08", "text": "五、"}, {"type": "subtitle", "time": 17410.07, "timestamp": "04:50:10", "text": "[音乐]"}, {"type": "subtitle", "time": 17414.95, "timestamp": "04:50:14", "text": "我们走吧。我们走吧。哦，"}, {"type": "subtitle", "time": 17430.47, "timestamp": "04:50:30", "text": "男人。我很好奇我选择的这个选项。"}, {"type": "subtitle", "time": 17433.75, "timestamp": "04:50:33", "text": "多少会有点帮助。"}, {"type": "subtitle", "time": 17436.23, "timestamp": "04:50:36", "text": "我没看到结局三部曲。"}, {"type": "subtitle", "time": 17437.99, "timestamp": "04:50:37", "text": "不同？等等，所以只有三个？"}, {"type": "subtitle", "time": 17441.19, "timestamp": "04:50:41", "text": "本游戏的结局。"}, {"type": "subtitle", "time": 17443.03, "timestamp": "04:50:43", "text": "哇。我以为会有什么秘密呢。"}, {"type": "subtitle", "time": 17445.19, "timestamp": "04:50:45", "text": "结尾之类的。第四种选择或"}, {"type": "subtitle", "time": 17447.43, "timestamp": "04:50:47", "text": "某物。"}, {"type": "subtitle", "time": 17455.27, "timestamp": "04:50:55", "text": "嗯，这是一场持久战，不会很快结束。"}]
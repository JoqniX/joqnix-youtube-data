[{"type": "subtitle", "time": 16508.949, "timestamp": "04:35:08", "text": "他们为什么不能再次快乐起来？"}, {"type": "subtitle", "time": 16512.949, "timestamp": "04:35:12", "text": "我弄到了一只微型老鼠"}, {"type": "subtitle", "time": 16514.629, "timestamp": "04:35:14", "text": "蟑螂。"}, {"type": "subtitle", "time": 16517.189, "timestamp": "04:35:17", "text": "什么是微型蟑螂？"}, {"type": "subtitle", "time": 16520.15, "timestamp": "04:35:20", "text": "嗯？"}, {"type": "subtitle", "time": 16523.349, "timestamp": "04:35:23", "text": "太近了。"}]
[{"type": "subtitle", "time": 12480.08, "timestamp": "03:28:00", "text": "那"}, {"type": "subtitle", "time": 12481.269, "timestamp": "03:28:01", "text": "[音乐]"}, {"type": "subtitle", "time": 12484.07, "timestamp": "03:28:04", "text": "有一天我说过，不要"}, {"type": "subtitle", "time": 12487.19, "timestamp": "03:28:07", "text": "记住祖玛。嗯？"}, {"type": "subtitle", "time": 12496.63, "timestamp": "03:28:16", "text": "别再叫我尊巴了。好了，嘘。喂，"}, {"type": "subtitle", "time": 12503.269, "timestamp": "03:28:23", "text": "这种不尊重"}, {"type": "subtitle", "time": 12505.51, "timestamp": "03:28:25", "text": "根本不是那种人。"}, {"type": "subtitle", "time": 12508.87, "timestamp": "03:28:28", "text": "我该叫你祖玛吗？嗯？"}, {"type": "subtitle", "time": 12512.07, "timestamp": "03:28:32", "text": "我该怎么称呼你呢？"}, {"type": "subtitle", "time": 12513.91, "timestamp": "03:28:33", "text": "巴。"}, {"type": "subtitle", "time": 12520.87, "timestamp": "03:28:40", "text": "如果你正在考虑bo the"}, {"type": "subtitle", "time": 12523.59, "timestamp": "03:28:43", "text": "我只做底部那个东西。艾莉"}, {"type": "subtitle", "time": 12525.11, "timestamp": "03:28:45", "text": "你说是因为你像是在戏弄你。"}, {"type": "subtitle", "time": 12527.349, "timestamp": "03:28:47", "text": "我不想当个房客"}, {"type": "subtitle", "time": 12530.71, "timestamp": "03:28:50", "text": "我自己也是双性恋。是的，其他"}]
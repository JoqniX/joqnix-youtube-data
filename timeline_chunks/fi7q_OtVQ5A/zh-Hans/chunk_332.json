[{"type": "subtitle", "time": 19921.75, "timestamp": "05:32:01", "text": "富兰克林。文明史上最伟大的"}, {"type": "subtitle", "time": 19924.23, "timestamp": "05:32:04", "text": "美德。耶稣，你的治疗师有很多问题。"}, {"type": "subtitle", "time": 19926.47, "timestamp": "05:32:06", "text": "负责回答。我知道。我仍然恨"}, {"type": "subtitle", "time": 19928.47, "timestamp": "05:32:08", "text": "我。但是，至少我知道……"}, {"type": "subtitle", "time": 19930.548, "timestamp": "05:32:10", "text": "现在该怎么说呢。是啊，但我恨你。"}, {"type": "subtitle", "time": 19931.99, "timestamp": "05:32:11", "text": "我知道它的说法。那么，是这样吗？"}, {"type": "subtitle", "time": 19933.51, "timestamp": "05:32:13", "text": "那是不是意味着我不用接受心理治疗了？"}, {"type": "subtitle", "time": 19936.07, "timestamp": "05:32:16", "text": "听着，伙计，你们两个混蛋真吓人。"}, {"type": "subtitle", "time": 19937.91, "timestamp": "05:32:17", "text": "我正值中年。我很好。你是"}, {"type": "subtitle", "time": 19939.99, "timestamp": "05:32:19", "text": "富兰克林，你的恐惧是对的。是的，"}, {"type": "subtitle", "time": 19951.51, "timestamp": "05:32:31", "text": "T，我跟你说一件事，"}, {"type": "subtitle", "time": 19961.59, "timestamp": "05:32:41", "text": "这是个圈套。这是个圈套。这是一个"}, {"type": "subtitle", "time": 19963.83, "timestamp": "05:32:43", "text": "设置。哦，这是个圈套。稍等片刻。"}, {"type": "subtitle", "time": 19966.47, "timestamp": "05:32:46", "text": "等待。什么？"}]
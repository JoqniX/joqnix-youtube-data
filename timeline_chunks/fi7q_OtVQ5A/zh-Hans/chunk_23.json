[{"type": "subtitle", "time": 1387.669, "timestamp": "00:23:07", "text": "有人想杀我。我有W。"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "哦，让我搬到这里来吧。"}, {"type": "subtitle", "time": 1393.19, "timestamp": "00:23:13", "text": "呃，我要去哪儿？哦，我的天啊。"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "呃，呃。哦。哦。哦。失业。你还好吗？"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "你还好吗？你还好吗？是的。我在这里。什么"}, {"type": "subtitle", "time": 1401.11, "timestamp": "00:23:21", "text": "发生了吗？我会去找你。你还好吗？"}, {"type": "subtitle", "time": 1404.07, "timestamp": "00:23:24", "text": "你现在没事了吧？"}, {"type": "subtitle", "time": 1407.51, "timestamp": "00:23:27", "text": "你活下来了。"}, {"type": "subtitle", "time": 1415.11, "timestamp": "00:23:35", "text": "美好的。为什么是杰克？我为什么要离开他？"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "独自的？没关系。没关系。我就在附近"}, {"type": "subtitle", "time": 1419.51, "timestamp": "00:23:39", "text": "你。"}, {"type": "subtitle", "time": 1422.87, "timestamp": "00:23:42", "text": "韦恩在哪儿？哦，他也在附近。"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "他为什么死了？他为什么死在外面？"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "我现在就要救你。"}, {"type": "subtitle", "time": 1438.95, "timestamp": "00:23:58", "text": "我要去玩一场职业比赛"}]
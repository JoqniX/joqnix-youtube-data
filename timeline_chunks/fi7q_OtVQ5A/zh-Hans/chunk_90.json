[{"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "哦，原来厕所里有一颗钻石。"}, {"type": "subtitle", "time": 5430.149, "timestamp": "01:30:30", "text": "哇。"}, {"type": "subtitle", "time": 5435.91, "timestamp": "01:30:35", "text": "什么？是的。什么？是的。"}, {"type": "subtitle", "time": 5459.189, "timestamp": "01:30:59", "text": "哦，拜托。死的。我又死了。他"}]
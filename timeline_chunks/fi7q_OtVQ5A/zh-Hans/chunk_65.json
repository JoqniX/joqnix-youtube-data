[{"type": "subtitle", "time": 3900.069, "timestamp": "01:05:00", "text": "是的。是的。我觉得它已经没了。"}, {"type": "subtitle", "time": 3901.67, "timestamp": "01:05:01", "text": "但"}, {"type": "subtitle", "time": 3904.71, "timestamp": "01:05:04", "text": "是啊，一旦没了，就真的没了。"}, {"type": "subtitle", "time": 3906.549, "timestamp": "01:05:06", "text": "哦，这里还有更多物品。大"}, {"type": "subtitle", "time": 3919.349, "timestamp": "01:05:19", "text": "蘑菇博物馆里有好多玩具啊。为什么"}, {"type": "subtitle", "time": 3921.19, "timestamp": "01:05:21", "text": "它看起来像个玩具吗？"}, {"type": "subtitle", "time": 3923.51, "timestamp": "01:05:23", "text": "工厂？"}, {"type": "subtitle", "time": 3925.589, "timestamp": "01:05:25", "text": "或许。我不知道。"}, {"type": "subtitle", "time": 3930.309, "timestamp": "01:05:30", "text": "哦，小心。小心。嗯，娃娃"}, {"type": "subtitle", "time": 3932.15, "timestamp": "01:05:32", "text": "带刀片的房间与……"}, {"type": "subtitle", "time": 3939.829, "timestamp": "01:05:39", "text": "哦，她做到了。"}, {"type": "subtitle", "time": 3942.789, "timestamp": "01:05:42", "text": "等等，你……哦，是个婴儿。这是一个"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "婴儿。我打算把它放在分散注意力的地方。"}, {"type": "subtitle", "time": 3949.349, "timestamp": "01:05:49", "text": "观点。是的。是的。大胆试试吧。"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "是的，"}, {"type": "subtitle", "time": 3953.19, "timestamp": "01:05:53", "text": "它会睁开眼睛，开始哭泣。"}, {"type": "subtitle", "time": 3955.029, "timestamp": "01:05:55", "text": "有点吓人。"}]
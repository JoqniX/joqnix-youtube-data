[{"type": "subtitle", "time": 17474.31, "timestamp": "04:51:14", "text": "嘿，看。"}, {"type": "subtitle", "time": 17476.55, "timestamp": "04:51:16", "text": "你可以退出。没什么大事发生。打我"}, {"type": "subtitle", "time": 17479.35, "timestamp": "04:51:19", "text": "没错，伙计。伙计，我们遇到大麻烦了。我的"}, {"type": "subtitle", "time": 17483.03, "timestamp": "04:51:23", "text": "男孩们，伙计。我们正在努力省钱。你"}, {"type": "subtitle", "time": 17484.708, "timestamp": "04:51:24", "text": "真正为你的兄弟们做点事"}, {"type": "subtitle", "time": 17487.75, "timestamp": "04:51:27", "text": "换个方式？当然，我参加。谁？"}, {"type": "subtitle", "time": 17489.83, "timestamp": "04:51:29", "text": "想为你的兄弟们鼓掌吗？谁不这样呢？"}, {"type": "subtitle", "time": 17492.868, "timestamp": "04:51:32", "text": "黑鬼？这些中国人？有些脂肪？"}, {"type": "subtitle", "time": 17495.03, "timestamp": "04:51:35", "text": "那个骗了我们的有钱白人混蛋"}, {"type": "subtitle", "time": 17496.55, "timestamp": "04:51:36", "text": "卡隆。"}, {"type": "subtitle", "time": 17498.868, "timestamp": "04:51:38", "text": "那个混蛋婊子。你为什么不说我们"}, {"type": "subtitle", "time": 17501.51, "timestamp": "04:51:41", "text": "是不是在偷偷摸摸地接近？我们不是偷偷摸摸地靠近。"}, {"type": "subtitle", "time": 17503.27, "timestamp": "04:51:43", "text": "他，黑鬼。至少我不认为他"}, {"type": "subtitle", "time": 17504.55, "timestamp": "04:51:44", "text": "我肯定会到场。我们必须全部拿走"}, {"type": "subtitle", "time": 17506.23, "timestamp": "04:51:46", "text": "炎热"}, {"type": "subtitle", "time": 17510.31, "timestamp": "04:51:50", "text": "关于他的屁股。"}, {"type": "subtitle", "time": 17513.03, "timestamp": "04:51:53", "text": "哦，当然！我们正在悄悄接近那个傻瓜。"}, {"type": "subtitle", "time": 17516.47, "timestamp": "04:51:56", "text": "不是你这混蛋"}, {"type": "subtitle", "time": 17518.868, "timestamp": "04:51:58", "text": "试图辨认"}]
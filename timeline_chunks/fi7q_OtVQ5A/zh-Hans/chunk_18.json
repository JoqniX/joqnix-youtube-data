[{"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "没关系。没关系。遭到攻击"}, {"type": "subtitle", "time": 1090.47, "timestamp": "00:18:10", "text": "被某人。也许我正在……"}, {"type": "subtitle", "time": 1091.909, "timestamp": "00:18:11", "text": "不知道。我遭到攻击了，我"}, {"type": "subtitle", "time": 1093.35, "timestamp": "00:18:13", "text": "猜测。"}, {"type": "subtitle", "time": 1095.75, "timestamp": "00:18:15", "text": "我很放心。别担心。别介意。"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "我只是有点紧张不安。不"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "别担心。这是谁？好的。"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "把你的武器给我。请问有人可以帮忙吗？"}, {"type": "subtitle", "time": 1106.95, "timestamp": "00:18:26", "text": "请靠近我好吗？这样我就可以……"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "我正朝你走来。你在哪"}, {"type": "subtitle", "time": 1110.95, "timestamp": "00:18:30", "text": "伙计们？你们为什么会在上面？和"}, {"type": "subtitle", "time": 1115.029, "timestamp": "00:18:35", "text": "我为什么会在这里？呃，还有一种选择是"}, {"type": "subtitle", "time": 1121.51, "timestamp": "00:18:41", "text": "放弃吧。上帝，"}, {"type": "subtitle", "time": 1123.83, "timestamp": "00:18:43", "text": "我当时都想放弃了。非常感谢，"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "为你感到骄傲。"}, {"type": "subtitle", "time": 1133.029, "timestamp": "00:18:53", "text": "是的。感到自豪吧。感到自豪吧。怎么样？"}]
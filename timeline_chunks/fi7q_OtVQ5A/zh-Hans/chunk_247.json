[{"type": "subtitle", "time": 14830.95, "timestamp": "04:07:10", "text": "好了，走吧。我们还是别谈这个了。"}, {"type": "subtitle", "time": 14832.389, "timestamp": "04:07:12", "text": "占用这位先生更多的时间"}, {"type": "subtitle", "time": 14838.79, "timestamp": "04:07:18", "text": "我们走吧。我们走吧。我感觉不太好。"}, {"type": "subtitle", "time": 14840.71, "timestamp": "04:07:20", "text": "出色地。我"}, {"type": "subtitle", "time": 14843.11, "timestamp": "04:07:23", "text": "忍着吧。"}, {"type": "subtitle", "time": 14845.189, "timestamp": "04:07:25", "text": "处理宿醉病例。不要"}, {"type": "subtitle", "time": 14847.51, "timestamp": "04:07:27", "text": "放纵。"}, {"type": "subtitle", "time": 14849.03, "timestamp": "04:07:29", "text": "这是正确的。这个人将会"}, {"type": "subtitle", "time": 14850.79, "timestamp": "04:07:30", "text": "教你一些关于……的知识"}, {"type": "subtitle", "time": 14853.189, "timestamp": "04:07:33", "text": "适度。"}, {"type": "subtitle", "time": 14855.429, "timestamp": "04:07:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 14858.87, "timestamp": "04:07:38", "text": "他只是让那家伙卷入这一切。"}, {"type": "subtitle", "time": 14861.99, "timestamp": "04:07:41", "text": "这些东西。他要丢掉工作了。"}, {"type": "subtitle", "time": 14871.59, "timestamp": "04:07:51", "text": "我们只是"}]
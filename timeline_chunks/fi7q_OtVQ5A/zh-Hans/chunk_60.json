[{"type": "subtitle", "time": 3603.51, "timestamp": "01:00:03", "text": "我认为我们应该把剩下的都保存下来，因为"}, {"type": "subtitle", "time": 3605.91, "timestamp": "01:00:05", "text": "其他东西都太贵了。"}, {"type": "subtitle", "time": 3608.47, "timestamp": "01:00:08", "text": "是的。"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "好的。故障。"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "我希望它还在测试版里。"}, {"type": "subtitle", "time": 3632.39, "timestamp": "01:00:32", "text": "我忘了。我忘了给你发战争警报。所以，就是这样。"}, {"type": "subtitle", "time": 3634.39, "timestamp": "01:00:34", "text": "你曾经是。"}, {"type": "subtitle", "time": 3639.91, "timestamp": "01:00:39", "text": "不是什么？不，抱歉。为什么？"}, {"type": "subtitle", "time": 3644.39, "timestamp": "01:00:44", "text": "我的天啊。开发者们，为什么？哦，我用"}, {"type": "subtitle", "time": 3647.75, "timestamp": "01:00:47", "text": "做错了。我按下E键。我知道了。哦，"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "另一个怎么样了？哦。哦，"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "不。是的。等待。你想要什么？"}, {"type": "subtitle", "time": 3654.789, "timestamp": "01:00:54", "text": "拿？是手榴弹还是黑色的枪管？"}, {"type": "subtitle", "time": 3656.95, "timestamp": "01:00:56", "text": "我接受。我的天哪。谢谢。拿"}]
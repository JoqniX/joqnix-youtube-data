[{"type": "subtitle", "time": 15068.79, "timestamp": "04:11:08", "text": "他参与其中。嗯？起床。嘿，起来。"}, {"type": "subtitle", "time": 15070.309, "timestamp": "04:11:10", "text": "你告诉他一些不在节目单上的事情"}, {"type": "subtitle", "time": 15072.389, "timestamp": "04:11:12", "text": "消息已发布。这一切都是你。"}, {"type": "subtitle", "time": 15073.99, "timestamp": "04:11:13", "text": "主意。"}, {"type": "subtitle", "time": 15076.389, "timestamp": "04:11:16", "text": "是的。是的，我明白了。一句话也没说。"}, {"type": "subtitle", "time": 15078.95, "timestamp": "04:11:18", "text": "确切地。是的。我总是跳。我 我"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "什么也没看见。滚蛋吧"}, {"type": "subtitle", "time": 15083.67, "timestamp": "04:11:23", "text": "像你家那个老弱病残一样软弱无力"}, {"type": "subtitle", "time": 15085.59, "timestamp": "04:11:25", "text": "裤子。离婚不会很快发生"}, {"type": "subtitle", "time": 15088.63, "timestamp": "04:11:28", "text": "足够的。操"}, {"type": "subtitle", "time": 15090.55, "timestamp": "04:11:30", "text": "先工作。晚点儿吧，伙计。全部"}, {"type": "subtitle", "time": 15092.15, "timestamp": "04:11:32", "text": "正确的。"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "妈的。"}, {"type": "subtitle", "time": 15096.18, "timestamp": "04:11:36", "text": "雇佣兵母亲。"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "[音乐]"}, {"type": "subtitle", "time": 15100.27, "timestamp": "04:11:40", "text": "好了，该做礼拜了。"}]
[{"type": "subtitle", "time": 15422.469, "timestamp": "04:17:02", "text": "哦，我看到你刚刚糟蹋了那只雄鹿。"}, {"type": "subtitle", "time": 15424.71, "timestamp": "04:17:04", "text": "箭。"}, {"type": "subtitle", "time": 15427.429, "timestamp": "04:17:07", "text": "但我早就知道了。是的，我知道"}, {"type": "subtitle", "time": 15436.149, "timestamp": "04:17:16", "text": "这。这让我想起了高速公路上的路标。"}, {"type": "subtitle", "time": 15448.229, "timestamp": "04:17:28", "text": "去迈克尔家。"}, {"type": "subtitle", "time": 15450.63, "timestamp": "04:17:30", "text": "离开"}, {"type": "subtitle", "time": 15453.91, "timestamp": "04:17:33", "text": "你想玩美元游戏"}, {"type": "subtitle", "time": 15465.03, "timestamp": "04:17:45", "text": "伙伴。好的。"}, {"type": "subtitle", "time": 15467.11, "timestamp": "04:17:47", "text": "快点。我们已经经历过无数次了。"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "能够全身而退才是关键所在。"}, {"type": "subtitle", "time": 15474.389, "timestamp": "04:17:54", "text": "自由行走者与自由行走者之间的区别"}, {"type": "subtitle", "time": 15476.95, "timestamp": "04:17:56", "text": "以及那些不这么认为的人。"}, {"type": "subtitle", "time": 15479.67, "timestamp": "04:17:59", "text": "我才不会碰那种玩意儿。哦，我的"}]
[{"type": "subtitle", "time": 1509.909, "timestamp": "00:25:09", "text": "不知为何，我……我……我……附近"}, {"type": "subtitle", "time": 1511.51, "timestamp": "00:25:11", "text": "我附近有个玩家，我附近有个玩家，我没有。"}, {"type": "subtitle", "time": 1515.19, "timestamp": "00:25:15", "text": "我知道为什么我要去他妈的"}, {"type": "subtitle", "time": 1517.669, "timestamp": "00:25:17", "text": "你的团队"}, {"type": "subtitle", "time": 1520.07, "timestamp": "00:25:20", "text": "我想死，我想，我想死在……"}, {"type": "subtitle", "time": 1523.19, "timestamp": "00:25:23", "text": "现在就放弃"}, {"type": "subtitle", "time": 1525.669, "timestamp": "00:25:25", "text": "好吧，哥们儿，如果你还活着的话……"}, {"type": "subtitle", "time": 1529.19, "timestamp": "00:25:29", "text": "应该会很安全，而且相当酷。"}, {"type": "subtitle", "time": 1531.669, "timestamp": "00:25:31", "text": "这是最后一次使用这张地图了。"}, {"type": "subtitle", "time": 1535.029, "timestamp": "00:25:35", "text": "为什么陷阱还能用？"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "是的，有个陷阱大师之类的东西。"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "还活着。不，为什么它还在运行？"}, {"type": "subtitle", "time": 1543.83, "timestamp": "00:25:43", "text": "请我帮忙？即使我回来之后，"}, {"type": "subtitle", "time": 1545.909, "timestamp": "00:25:45", "text": "空投即将到来。没关系。没关系，"}, {"type": "subtitle", "time": 1548.549, "timestamp": "00:25:48", "text": "韦恩。可能是某个穷玩家"}, {"type": "subtitle", "time": 1550.63, "timestamp": "00:25:50", "text": "没人知道的事。哦，有个家伙在……"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "屋顶。屋顶上有一个人。"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "对，别理他。不"}, {"type": "subtitle", "time": 1555.59, "timestamp": "00:25:55", "text": "与他互动。没关系。我们必须赢。"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "出于某种奇怪的原因。我们需要一个"}]
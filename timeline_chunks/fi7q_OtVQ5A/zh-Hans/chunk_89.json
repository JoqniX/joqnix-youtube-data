[{"type": "subtitle", "time": 5340.55, "timestamp": "01:29:00", "text": "难道我不打算把整张婴儿床都放进去吗？"}, {"type": "subtitle", "time": 5342.47, "timestamp": "01:29:02", "text": "我当时想把所有东西都买下来。哦，"}, {"type": "subtitle", "time": 5343.99, "timestamp": "01:29:03", "text": "等待。哦，是的。是的，我们有"}, {"type": "subtitle", "time": 5346.629, "timestamp": "01:29:06", "text": "提取，对吧？好的。好的。是的，"}, {"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "有两个。是的。好的。总会有的。"}, {"type": "subtitle", "time": 5352.47, "timestamp": "01:29:12", "text": "总会有“嗯”，你会在旁边看到。"}, {"type": "subtitle", "time": 5356.47, "timestamp": "01:29:16", "text": "钱取决于你做了多少次拔牙。"}, {"type": "subtitle", "time": 5358.31, "timestamp": "01:29:18", "text": "有两个。这是第一个。"}, {"type": "subtitle", "time": 5361.59, "timestamp": "01:29:21", "text": "现在，我们得找到另一个。是的。"}, {"type": "subtitle", "time": 5368.95, "timestamp": "01:29:28", "text": "[音乐]"}, {"type": "subtitle", "time": 5371.35, "timestamp": "01:29:31", "text": "欢迎回来。"}, {"type": "subtitle", "time": 5374.39, "timestamp": "01:29:34", "text": "耶。后退。纳税申报表。没有税"}, {"type": "subtitle", "time": 5382.07, "timestamp": "01:29:42", "text": "哦，等等。它就在我们的……哦，它就在这里。"}, {"type": "subtitle", "time": 5384.229, "timestamp": "01:29:44", "text": "好的。好的。就在里面。这是一个"}]
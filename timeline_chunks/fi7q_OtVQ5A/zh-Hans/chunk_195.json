[{"type": "subtitle", "time": 11702.87, "timestamp": "03:15:02", "text": "呃，"}, {"type": "subtitle", "time": 11705.59, "timestamp": "03:15:05", "text": "碉堡山。"}, {"type": "subtitle", "time": 11714.63, "timestamp": "03:15:14", "text": "在多层停车场的顶部。"}, {"type": "subtitle", "time": 11725.19, "timestamp": "03:15:25", "text": "我的天啊。好的。杀死它。好的。"}, {"type": "subtitle", "time": 11729.11, "timestamp": "03:15:29", "text": "菲尔博克斯山。菲尔博克斯山。填充盒"}, {"type": "subtitle", "time": 11734.79, "timestamp": "03:15:34", "text": "爬坡道。充满。装满盒子。我得到了它。知道了。"}, {"type": "subtitle", "time": 11737.269, "timestamp": "03:15:37", "text": "填充盒。"}, {"type": "subtitle", "time": 11740.469, "timestamp": "03:15:40", "text": "菲尔博克斯山。"}, {"type": "subtitle", "time": 11742.87, "timestamp": "03:15:42", "text": "它在哪里？"}, {"type": "subtitle", "time": 11747.19, "timestamp": "03:15:47", "text": "我正在看。结束了。"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "是的。"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "我离这里太远了吗？是的，我是"}, {"type": "subtitle", "time": 11758.79, "timestamp": "03:15:58", "text": "太远了。"}]
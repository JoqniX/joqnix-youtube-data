[{"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "我当时还没满18岁。哎呀，别这样。什么？你"}, {"type": "subtitle", "time": 5849.43, "timestamp": "01:37:29", "text": "死了？是的，我被那家伙开枪打中了。他是"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "在"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "房间之前就有人住过。这里有……一个盘子"}, {"type": "subtitle", "time": 5858.629, "timestamp": "01:37:38", "text": "里面。我来吧。我说话。我得到一个"}, {"type": "subtitle", "time": 5861.51, "timestamp": "01:37:41", "text": "杀。当你说话的时候，他会说：“不，"}, {"type": "subtitle", "time": 5864.47, "timestamp": "01:37:44", "text": "真好。"}, {"type": "subtitle", "time": 5873.189, "timestamp": "01:37:53", "text": "我觉得应该稍微削弱一下他。"}, {"type": "subtitle", "time": 5874.709, "timestamp": "01:37:54", "text": "少量。”"}]
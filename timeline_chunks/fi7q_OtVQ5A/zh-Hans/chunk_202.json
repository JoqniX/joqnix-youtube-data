[{"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "是的。你说着哈瓦哈瓦，但你"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "还没说过哈瓦。等待。哈瓦。等等，我……"}, {"type": "subtitle", "time": 12133.349, "timestamp": "03:22:13", "text": "我就说“哈瓦哈瓦？”我的天啊，那个"}, {"type": "subtitle", "time": 12135.91, "timestamp": "03:22:15", "text": "宝莱坞歌曲。我们刚刚用谷歌搜索了一下。"}, {"type": "subtitle", "time": 12138.07, "timestamp": "03:22:18", "text": "哈瓦是对的吗？然后我们看到哈瓦"}, {"type": "subtitle", "time": 12140.469, "timestamp": "03:22:20", "text": "哈瓦那玩意儿。"}, {"type": "subtitle", "time": 12142.15, "timestamp": "03:22:22", "text": "然后我才意识到，那是宝莱坞"}, {"type": "subtitle", "time": 12144.79, "timestamp": "03:22:24", "text": "歌曲。然后我听到了一些，然后我"}]
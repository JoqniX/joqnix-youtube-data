[{"type": "subtitle", "time": 20411.99, "timestamp": "05:40:11", "text": "找出带宽。然后是购物中心"}, {"type": "subtitle", "time": 20441.03, "timestamp": "05:40:41", "text": "胸罩呃，我写了这些胸罩，虽然你"}, {"type": "subtitle", "time": 20443.75, "timestamp": "05:40:43", "text": "看到的还是同一个我"}, {"type": "subtitle", "time": 20447.27, "timestamp": "05:40:47", "text": "人们都远离我。"}, {"type": "subtitle", "time": 20450.548, "timestamp": "05:40:50", "text": "妈妈，你还要继续走吗？是的。"}, {"type": "subtitle", "time": 20454.15, "timestamp": "05:40:54", "text": "凯，你好吗？你好吗？你吃了没"}, {"type": "subtitle", "time": 20457.67, "timestamp": "05:40:57", "text": "你的午餐和所有东西都带了吗？"}]
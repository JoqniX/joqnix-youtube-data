[{"type": "subtitle", "time": 12962.79, "timestamp": "03:36:02", "text": "小狗的叫声。弓弓。"}, {"type": "subtitle", "time": 12966.309, "timestamp": "03:36:06", "text": "如何吠叫和填充。我看见 我 我 我 看见"}, {"type": "subtitle", "time": 12977.91, "timestamp": "03:36:17", "text": "你可以对出租车做那种事。"}, {"type": "subtitle", "time": 12985.429, "timestamp": "03:36:25", "text": "怎么做？"}, {"type": "subtitle", "time": 12989.349, "timestamp": "03:36:29", "text": "哦，小狗的叫声。"}, {"type": "subtitle", "time": 12992.15, "timestamp": "03:36:32", "text": "弓弓。"}, {"type": "subtitle", "time": 12994.63, "timestamp": "03:36:34", "text": "汪汪。"}, {"type": "subtitle", "time": 12997.269, "timestamp": "03:36:37", "text": "哦，哇。你注意到……了吗？"}, {"type": "subtitle", "time": 13001.349, "timestamp": "03:36:41", "text": "女士，您在捡垃圾桶吗？"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "呃，不好意思打断你了。"}, {"type": "subtitle", "time": 13006.55, "timestamp": "03:36:46", "text": "家。"}, {"type": "subtitle", "time": 13019.51, "timestamp": "03:36:59", "text": "等等，这不是我需要的颜色。"}]
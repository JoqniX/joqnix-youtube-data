[{"type": "subtitle", "time": 10803.91, "timestamp": "03:00:03", "text": "这不是正确的那个，所以我有点……"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "呃，需要点什么，因为问题是美国。"}, {"type": "subtitle", "time": 10812.389, "timestamp": "03:00:12", "text": "整个州的每个城市都有"}, {"type": "subtitle", "time": 10814.389, "timestamp": "03:00:14", "text": "城市或州的时间安排各不相同。"}, {"type": "subtitle", "time": 10818.87, "timestamp": "03:00:18", "text": "区域。我当时就懵了？如何？我没有"}, {"type": "subtitle", "time": 10821.99, "timestamp": "03:00:21", "text": "直到今天我才知道这一点。今天不行。不，"}, {"type": "subtitle", "time": 10828.309, "timestamp": "03:00:28", "text": "这就是为什么，比如如果你输入“USA”的话。"}, {"type": "subtitle", "time": 10830.309, "timestamp": "03:00:30", "text": "在这个VPN中，情况有所不同。"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "城市等等。"}, {"type": "subtitle", "time": 10835.99, "timestamp": "03:00:35", "text": "为什么不能集中在一个地方呢？"}, {"type": "subtitle", "time": 10839.269, "timestamp": "03:00:39", "text": "例如，对于东京来说，就是东京时间"}, {"type": "subtitle", "time": 10841.59, "timestamp": "03:00:41", "text": "区域之类的，我们只是不是日本人。"}, {"type": "subtitle", "time": 10845.67, "timestamp": "03:00:45", "text": "时区之类的。嗯，直接输入东京就行了。"}, {"type": "subtitle", "time": 10848.23, "timestamp": "03:00:48", "text": "这样你就能听到日本时间了。"}, {"type": "subtitle", "time": 10850.63, "timestamp": "03:00:50", "text": "正确的？就像我在这里做的那样。对于中国来说，你"}, {"type": "subtitle", "time": 10853.11, "timestamp": "03:00:53", "text": "可以做北京那一个。"}, {"type": "subtitle", "time": 10855.91, "timestamp": "03:00:55", "text": "但对我们这里的人来说，如何"}, {"type": "subtitle", "time": 10858.55, "timestamp": "03:00:58", "text": "不同地方的时间观念不同"}]
[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "你好，MJ。哦，完全同意。我们完全"}, {"type": "subtitle", "time": 303.189, "timestamp": "00:05:03", "text": "这里很安全。你能补充你的护甲吗？"}, {"type": "subtitle", "time": 305.909, "timestamp": "00:05:05", "text": "道路？是的。"}, {"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "哦，他去世了。他又死了一次，伙计们。我只是"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "我的天哪。"}, {"type": "subtitle", "time": 317.11, "timestamp": "00:05:17", "text": "我希望我能穿上盔甲。我希望我"}, {"type": "subtitle", "time": 319.67, "timestamp": "00:05:19", "text": "我能做到，但显然我做不到。"}, {"type": "subtitle", "time": 327.27, "timestamp": "00:05:27", "text": "什么？哦，我看到你了。对不起。我是"}, {"type": "subtitle", "time": 330.629, "timestamp": "00:05:30", "text": "对不起。我当时正要杀了你。是的。"}, {"type": "subtitle", "time": 333.11, "timestamp": "00:05:33", "text": "是的。是的。是的。什么？他来了"}, {"type": "subtitle", "time": 335.11, "timestamp": "00:05:35", "text": "再次。他又来了。他来了"}, {"type": "subtitle", "time": 337.749, "timestamp": "00:05:37", "text": "再次。他来了。你知道吗？他是"}, {"type": "subtitle", "time": 339.51, "timestamp": "00:05:39", "text": "未来。"}, {"type": "subtitle", "time": 342.23, "timestamp": "00:05:42", "text": "他来了。"}, {"type": "subtitle", "time": 344.469, "timestamp": "00:05:44", "text": "你们就试试看能不能杀了我们。大概会去"}, {"type": "subtitle", "time": 353.43, "timestamp": "00:05:53", "text": "不知道是什么意思。你是做什么的"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "正在做？抱歉，我不会……但是"}, {"type": "subtitle", "time": 359.51, "timestamp": "00:05:59", "text": "你好，Pog。 Pog 的意思是存在"}]
[{"type": "subtitle", "time": 12364.309, "timestamp": "03:26:04", "text": "激光方框。这是激光方框。"}, {"type": "subtitle", "time": 12366.55, "timestamp": "03:26:06", "text": "任务街。哦，在这边。使命"}, {"type": "subtitle", "time": 12368.07, "timestamp": "03:26:08", "text": "排。"}, {"type": "subtitle", "time": 12376.469, "timestamp": "03:26:16", "text": "有点远，对吧？"}, {"type": "subtitle", "time": 12380.309, "timestamp": "03:26:20", "text": "只要我想，我就能做到。"}, {"type": "subtitle", "time": 12382.63, "timestamp": "03:26:22", "text": "这需要速度"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "车。你知道吗？就这么定了。"}, {"type": "subtitle", "time": 12388.55, "timestamp": "03:26:28", "text": "等等，你们是做什么的？你喜欢"}, {"type": "subtitle", "time": 12391.429, "timestamp": "03:26:31", "text": "写歌词什么的？那个人"}, {"type": "subtitle", "time": 12395.67, "timestamp": "03:26:35", "text": "我得带午饭去吃，而且我不得不……"}, {"type": "subtitle", "time": 12398.79, "timestamp": "03:26:38", "text": "我意识到自己身无分文。嗯？什么是"}, {"type": "subtitle", "time": 12400.71, "timestamp": "03:26:40", "text": "真的又发生了？我简直超级棒"}, {"type": "subtitle", "time": 12417.83, "timestamp": "03:26:57", "text": "帮助。那家伙偷了我的车。"}]
[{"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "开心吧？ Pog pog 就像是“耶”。"}, {"type": "subtitle", "time": 366.629, "timestamp": "00:06:06", "text": "太棒了之类的"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "沿着这条线。即将到达。是的，我是"}, {"type": "subtitle", "time": 371.99, "timestamp": "00:06:11", "text": "入侵他人系统。所以，非常感谢。"}, {"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "很多。附近有很多玩家。我"}, {"type": "subtitle", "time": 376.79, "timestamp": "00:06:16", "text": "想想那个人"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "你。你还好吗？你做得很好。是的。"}, {"type": "subtitle", "time": 389.749, "timestamp": "00:06:29", "text": "做得非常棒。别死。好的。呃"}, {"type": "subtitle", "time": 393.029, "timestamp": "00:06:33", "text": "好的，明白了。"}, {"type": "subtitle", "time": 394.71, "timestamp": "00:06:34", "text": "这是我唯一能给你的建议。"}, {"type": "subtitle", "time": 396.95, "timestamp": "00:06:36", "text": "别死。如果你那样做，我会非常非常"}, {"type": "subtitle", "time": 400.15, "timestamp": "00:06:40", "text": "生你的气了。空投来了。哦"}, {"type": "subtitle", "time": 407.749, "timestamp": "00:06:47", "text": "什么？他在哪儿？我想，我不想"}, {"type": "subtitle", "time": 409.59000000000003, "timestamp": "00:06:49", "text": "知道。他只是绕过我们而已。不，"}, {"type": "subtitle", "time": 411.99, "timestamp": "00:06:51", "text": "不，他就在那里。"}, {"type": "subtitle", "time": 414.39, "timestamp": "00:06:54", "text": "他正在玩职业游戏"}, {"type": "subtitle", "time": 418.23, "timestamp": "00:06:58", "text": "刚才就是一些操作。是的。"}]
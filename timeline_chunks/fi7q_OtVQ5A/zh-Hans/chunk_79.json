[{"type": "subtitle", "time": 4748.39, "timestamp": "01:19:08", "text": "我还要加上耐力。为什么不呢？"}, {"type": "subtitle", "time": 4762.709, "timestamp": "01:19:22", "text": "我们可以买下它然后离开。"}, {"type": "subtitle", "time": 4765.43, "timestamp": "01:19:25", "text": "休息。由你决定。"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "哇。我搞不懂。好的。下次。"}, {"type": "subtitle", "time": 4772.47, "timestamp": "01:19:32", "text": "这些晶体多少钱？"}, {"type": "subtitle", "time": 4775.99, "timestamp": "01:19:35", "text": "9月12日"}, {"type": "subtitle", "time": 4779.75, "timestamp": "01:19:39", "text": "我们不必这样做。有点贵。"}, {"type": "subtitle", "time": 4782.07, "timestamp": "01:19:42", "text": "是的。"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "好的。你的"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "你想要的那把枪？有。我们开始吧"}, {"type": "subtitle", "time": 4790.229, "timestamp": "01:19:50", "text": "那。"}, {"type": "subtitle", "time": 4796.55, "timestamp": "01:19:56", "text": "额外的"}]
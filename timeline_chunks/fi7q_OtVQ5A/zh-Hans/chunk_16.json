[{"type": "subtitle", "time": 963.509, "timestamp": "00:16:03", "text": "韦德。没人关心入侵。是的。不"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "有人在乎。是的。顺便说一句，人们来了"}, {"type": "subtitle", "time": 969.509, "timestamp": "00:16:09", "text": "来这里看我比赛。我也这么认为。呃"}, {"type": "subtitle", "time": 971.749, "timestamp": "00:16:11", "text": "就像我每次演出一样，都会有人来。"}, {"type": "subtitle", "time": 977.189, "timestamp": "00:16:17", "text": "总之，别在意我们。你们"}, {"type": "subtitle", "time": 978.71, "timestamp": "00:16:18", "text": "你以为这是一场低级别比赛，其实不是。"}, {"type": "subtitle", "time": 980.949, "timestamp": "00:16:20", "text": "别担心。我们只是聊聊天"}, {"type": "subtitle", "time": 982.31, "timestamp": "00:16:22", "text": "一直都是这样。所以别担心"}, {"type": "subtitle", "time": 985.269, "timestamp": "00:16:25", "text": "关于它。"}, {"type": "subtitle", "time": 987.11, "timestamp": "00:16:27", "text": "以防万一，你知道，只是以防万一"}, {"type": "subtitle", "time": 992.87, "timestamp": "00:16:32", "text": "人们不会这样想，是吗？"}, {"type": "subtitle", "time": 1001.99, "timestamp": "00:16:41", "text": "我们有机器人，呃……"}, {"type": "subtitle", "time": 1005.67, "timestamp": "00:16:45", "text": "哦，发生什么事了？哦，是 YouTube。"}, {"type": "subtitle", "time": 1009.67, "timestamp": "00:16:49", "text": "机器人。 YouTube机器人。一些随机"}, {"type": "subtitle", "time": 1013.269, "timestamp": "00:16:53", "text": "呃，你知道的"}, {"type": "subtitle", "time": 1018.15, "timestamp": "00:16:58", "text": "YouTube按钮，我觉得挺酷的。"}]
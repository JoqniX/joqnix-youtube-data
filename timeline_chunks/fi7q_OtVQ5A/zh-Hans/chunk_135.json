[{"type": "subtitle", "time": 8114.149, "timestamp": "02:15:14", "text": "您可以...吗"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "呃，帮我上去？你想"}, {"type": "subtitle", "time": 8125.189, "timestamp": "02:15:25", "text": "几乎。是的。"}, {"type": "subtitle", "time": 8128.709, "timestamp": "02:15:28", "text": "上面有什么吗？上面什么也没有。"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "那边的情况呢？"}, {"type": "subtitle", "time": 8136.55, "timestamp": "02:15:36", "text": "这里也什么都没有。哇。"}, {"type": "subtitle", "time": 8140.95, "timestamp": "02:15:40", "text": "被骗了。是吗？我的天啊。"}, {"type": "subtitle", "time": 8153.91, "timestamp": "02:15:53", "text": "这瓶药​​水有着如此辉煌的一生。我"}, {"type": "subtitle", "time": 8157.109, "timestamp": "02:15:57", "text": "破坏。你毁掉了左边的药水。"}]
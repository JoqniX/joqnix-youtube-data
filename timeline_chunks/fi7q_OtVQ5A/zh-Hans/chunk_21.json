[{"type": "subtitle", "time": 1262.149, "timestamp": "00:21:02", "text": "指示安全区域。"}, {"type": "subtitle", "time": 1265.909, "timestamp": "00:21:05", "text": "哦，真糟糕。"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "我当时想，哦，紫色弹药。你是"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "现在跟我打招呼？我来过这里"}, {"type": "subtitle", "time": 1272.23, "timestamp": "00:21:12", "text": "整个过程中。是的，你，你已经"}, {"type": "subtitle", "time": 1278.39, "timestamp": "00:21:18", "text": "嘿，没关系。我患有RPD，这"}, {"type": "subtitle", "time": 1280.87, "timestamp": "00:21:20", "text": "惊人的。"}, {"type": "subtitle", "time": 1284.549, "timestamp": "00:21:24", "text": "关于我的钻石RPD。"}, {"type": "subtitle", "time": 1287.27, "timestamp": "00:21:27", "text": "你们想看看我的钻石RPD吗？如果"}, {"type": "subtitle", "time": 1289.83, "timestamp": "00:21:29", "text": "想看钻石RPD吗？来我家吧！"}, {"type": "subtitle", "time": 1291.99, "timestamp": "00:21:31", "text": "溪流。我认为雅克与……有联系"}, {"type": "subtitle", "time": 1294.71, "timestamp": "00:21:34", "text": "它。是的。你们关心你们"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "关于我的钻石。哇。真是这样"}, {"type": "subtitle", "time": 1301.11, "timestamp": "00:21:41", "text": "钻石。"}, {"type": "subtitle", "time": 1304.149, "timestamp": "00:21:44", "text": "我不认为那就是真相，但是"}, {"type": "subtitle", "time": 1307.19, "timestamp": "00:21:47", "text": "昂贵的。价格昂贵。"}, {"type": "subtitle", "time": 1309.43, "timestamp": "00:21:49", "text": "是的，可以。你把所有的事情都告诉了人们。"}, {"type": "subtitle", "time": 1313.43, "timestamp": "00:21:53", "text": "我拥有的钻石。你有一个。"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "大概两个。我不知道。我不"}, {"type": "subtitle", "time": 1317.75, "timestamp": "00:21:57", "text": "关心。闭嘴。"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "我想你是在说你自己。"}]
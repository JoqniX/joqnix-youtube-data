[{"type": "subtitle", "time": 15009.03, "timestamp": "04:10:09", "text": "我的天啊。嘿，北边那边，伙计。"}, {"type": "subtitle", "time": 15011.349, "timestamp": "04:10:11", "text": "梅利韦瑟压在你身上。我们得到了一个"}, {"type": "subtitle", "time": 15026.71, "timestamp": "04:10:26", "text": "我的天啊。等待。"}, {"type": "subtitle", "time": 15028.229, "timestamp": "04:10:28", "text": "好的。好，好，好。我们很好。我们"}, {"type": "subtitle", "time": 15030.63, "timestamp": "04:10:30", "text": "很好。"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "哦，真好，真好，真好。"}, {"type": "subtitle", "time": 15045.67, "timestamp": "04:10:45", "text": "你们重新分配重量。"}, {"type": "subtitle", "time": 15048.55, "timestamp": "04:10:48", "text": "嘿，干得好。"}, {"type": "subtitle", "time": 15051.59, "timestamp": "04:10:51", "text": "该死，真不敢相信我们得到了这么好的"}, {"type": "subtitle", "time": 15054.87, "timestamp": "04:10:54", "text": "开火。别忘了，"}, {"type": "subtitle", "time": 15057.67, "timestamp": "04:10:57", "text": "让"}, {"type": "subtitle", "time": 15059.349, "timestamp": "04:10:59", "text": "我们生命中的十分之一。我们什么也不接受"}]
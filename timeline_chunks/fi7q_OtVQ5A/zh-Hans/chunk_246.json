[{"type": "subtitle", "time": 14774.63, "timestamp": "04:06:14", "text": "[音乐]"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "是的。那是很久以前的我。我愿意"}, {"type": "subtitle", "time": 14779.59, "timestamp": "04:06:19", "text": "对此我并不知情。我不知道"}, {"type": "subtitle", "time": 14787.269, "timestamp": "04:06:27", "text": "之后有找到工作吗？不，最后一个"}, {"type": "subtitle", "time": 14790.63, "timestamp": "04:06:30", "text": "一。他要退休了。"}, {"type": "subtitle", "time": 14792.87, "timestamp": "04:06:32", "text": "探索其他机会。嘿，"}, {"type": "subtitle", "time": 14794.63, "timestamp": "04:06:34", "text": "早逝的几率增加"}, {"type": "subtitle", "time": 14797.349, "timestamp": "04:06:37", "text": "退休后情况会发生巨大变化。是的，我会"}, {"type": "subtitle", "time": 14814.07, "timestamp": "04:06:54", "text": "难道不是吗？气氛很尴尬。"}, {"type": "subtitle", "time": 14816.55, "timestamp": "04:06:56", "text": "找到了。我心想，我为什么沉默不语？"}, {"type": "subtitle", "time": 14819.349, "timestamp": "04:06:59", "text": "尽管？我就像"}]
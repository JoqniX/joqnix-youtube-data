[{"type": "subtitle", "time": 420.309, "timestamp": "00:07:00", "text": "我来。我来。"}, {"type": "subtitle", "time": 422.15, "timestamp": "00:07:02", "text": "哦，不。"}, {"type": "subtitle", "time": 424.95, "timestamp": "00:07:04", "text": "别担心。离开。哦，你"}, {"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "愚蠢的。哦，韦恩也杀了他"}, {"type": "subtitle", "time": 429.909, "timestamp": "00:07:09", "text": "为你。"}, {"type": "subtitle", "time": 432.95, "timestamp": "00:07:12", "text": "是的，我们俩都为你报了仇。"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "他甚至都没死。有人来了。经过"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "这样一来，你甚至都没死。所以，我"}, {"type": "subtitle", "time": 441.11, "timestamp": "00:07:21", "text": "不知道。我想，我们是在为你报仇。"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "下一个人在哪里？我只想"}, {"type": "subtitle", "time": 446.23, "timestamp": "00:07:26", "text": "杀了他。他在哪儿？他在哪儿？"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "他确实如此。嗜血的混蛋。"}, {"type": "subtitle", "time": 452.95, "timestamp": "00:07:32", "text": "哦，那家伙又回来了。那家伙又回来了。"}, {"type": "subtitle", "time": 455.589, "timestamp": "00:07:35", "text": "那家伙又回来了？我要黑掉"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "我打算黑掉他的系统，以防万一。"}, {"type": "subtitle", "time": 462.23, "timestamp": "00:07:42", "text": "哦，你要黑掉他的号。是的，我是"}, {"type": "subtitle", "time": 464.23, "timestamp": "00:07:44", "text": "我要黑他。是的，"}, {"type": "subtitle", "time": 466.629, "timestamp": "00:07:46", "text": "看。哦，他就在附近。好的，明白了。"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "有一个机器人和两个。你的队友"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "已被杀害"}, {"type": "subtitle", "time": 472.469, "timestamp": "00:07:52", "text": "附近。"}, {"type": "subtitle", "time": 475.35, "timestamp": "00:07:55", "text": "他好像死了三次。哦，酷！"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "酷，酷。这很棒。太棒了。"}, {"type": "subtitle", "time": 478.39, "timestamp": "00:07:58", "text": "不，不，那只是个机器人。不"}]
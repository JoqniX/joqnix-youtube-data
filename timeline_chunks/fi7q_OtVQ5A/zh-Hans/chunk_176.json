[{"type": "subtitle", "time": 10562.63, "timestamp": "02:56:02", "text": "所以请耐心等待。我好像在哪里听过这句话？"}, {"type": "subtitle", "time": 10564.55, "timestamp": "02:56:04", "text": "我指的是承诺。"}, {"type": "subtitle", "time": 10566.55, "timestamp": "02:56:06", "text": "你到了那里之后就得不到它了。"}, {"type": "subtitle", "time": 10569.67, "timestamp": "02:56:09", "text": "开始时已断开连接。"}, {"type": "subtitle", "time": 10572.23, "timestamp": "02:56:12", "text": "啊，这是 Rickroll。"}, {"type": "subtitle", "time": 10575.429, "timestamp": "02:56:15", "text": "Rickroll。我的天哪，你们！"}, {"type": "subtitle", "time": 10577.429, "timestamp": "02:56:17", "text": "科拉，"}, {"type": "subtitle", "time": 10579.91, "timestamp": "02:56:19", "text": "我忘了。我只知道永远不会去"}, {"type": "subtitle", "time": 10582.95, "timestamp": "02:56:22", "text": "让你永远不会放弃你"}, {"type": "subtitle", "time": 10585.269, "timestamp": "02:56:25", "text": "而且永远不会让你失望，因为"}, {"type": "subtitle", "time": 10588.309, "timestamp": "02:56:28", "text": "这首歌的歌词。"}, {"type": "subtitle", "time": 10591.75, "timestamp": "02:56:31", "text": "我没明白。"}, {"type": "subtitle", "time": 10595.03, "timestamp": "02:56:35", "text": "你知道那首歌的特别之处吗？"}, {"type": "subtitle", "time": 10597.59, "timestamp": "02:56:37", "text": "有人想要的是真正真实的"}, {"type": "subtitle", "time": 10600.07, "timestamp": "02:56:40", "text": "就这么说。"}, {"type": "subtitle", "time": 10602.95, "timestamp": "02:56:42", "text": "我永远不会让你……永远不会让你"}, {"type": "subtitle", "time": 10604.87, "timestamp": "02:56:44", "text": "向下"}, {"type": "subtitle", "time": 10608.23, "timestamp": "02:56:48", "text": "呃，或者放弃你之类的。你不能"}, {"type": "subtitle", "time": 10610.95, "timestamp": "02:56:50", "text": "甚至说出来也好，因为对方会想：哦"}, {"type": "subtitle", "time": 10614.79, "timestamp": "02:56:54", "text": "这家伙，我的这家伙，这家伙在滚动"}, {"type": "subtitle", "time": 10617.75, "timestamp": "02:56:57", "text": "我要重新注册了。如果你想说"}]
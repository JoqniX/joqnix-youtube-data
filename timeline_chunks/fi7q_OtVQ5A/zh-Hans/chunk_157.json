[{"type": "subtitle", "time": 9424.79, "timestamp": "02:37:04", "text": "哦，拜托。"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "我死于“是”。好吧，我死了，但我"}, {"type": "subtitle", "time": 9431.99, "timestamp": "02:37:11", "text": "也把那个拿枪的人杀了。哦，"}, {"type": "subtitle", "time": 9438.309, "timestamp": "02:37:18", "text": "这值得庆祝。实际上，"}, {"type": "subtitle", "time": 9440.79, "timestamp": "02:37:20", "text": "我要把这个当作我们的奖杯。"}, {"type": "subtitle", "time": 9450.15, "timestamp": "02:37:30", "text": "呃，我们走吧。"}, {"type": "subtitle", "time": 9452.95, "timestamp": "02:37:32", "text": "他们或许已经牺牲，但他们为我们赢得了荣誉。"}, {"type": "subtitle", "time": 9458.79, "timestamp": "02:37:38", "text": "通过死亡获得额外收入。哦，不。我的天哪。你"}, {"type": "subtitle", "time": 9460.71, "timestamp": "02:37:40", "text": "得把它们捡起来吃掉。制作"}, {"type": "subtitle", "time": 9462.309, "timestamp": "02:37:42", "text": "确保他们不会靠近"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "抓住。"}, {"type": "subtitle", "time": 9477.83, "timestamp": "02:37:57", "text": "是的，它们很难弄到手。"}, {"type": "subtitle", "time": 9479.51, "timestamp": "02:37:59", "text": "的。"}]
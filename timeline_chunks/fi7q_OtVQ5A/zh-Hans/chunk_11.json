[{"type": "subtitle", "time": 661.11, "timestamp": "00:11:01", "text": "死的。是的。好的。"}, {"type": "subtitle", "time": 666.71, "timestamp": "00:11:06", "text": "我们赢了。我们赢了。是的。是的。 GG。"}, {"type": "subtitle", "time": 668.87, "timestamp": "00:11:08", "text": "现在是谁拯救了比赛？"}, {"type": "subtitle", "time": 670.949, "timestamp": "00:11:10", "text": "韦恩？"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "事实上，是我救了你。不是你"}, {"type": "subtitle", "time": 676.87, "timestamp": "00:11:16", "text": "道路。好吧，我想我的人生就此结束了。"}, {"type": "subtitle", "time": 680.23, "timestamp": "00:11:20", "text": "游戏。我们都可以说我是最新的。"}, {"type": "subtitle", "time": 682.389, "timestamp": "00:11:22", "text": "这里。所以"}, {"type": "subtitle", "time": 684.15, "timestamp": "00:11:24", "text": "我当时在屋顶上，是我……"}, {"type": "subtitle", "time": 686.79, "timestamp": "00:11:26", "text": "顺便说一句，我杀了他。他呃……不，不，"}, {"type": "subtitle", "time": 688.87, "timestamp": "00:11:28", "text": "不。你什么也没做。你做到了"}, {"type": "subtitle", "time": 692.069, "timestamp": "00:11:32", "text": "没有什么。你什么也没做。哦。哦，人们"}, {"type": "subtitle", "time": 693.91, "timestamp": "00:11:33", "text": "顺便说一句，我可能会看到结果。"}, {"type": "subtitle", "time": 698.389, "timestamp": "00:11:38", "text": "朋友。不，不。他们什么也看不见。"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "是的，他们可以。不，他们不能。不"}, {"type": "subtitle", "time": 703.91, "timestamp": "00:11:43", "text": "别担心。不，我们不会……"}, {"type": "subtitle", "time": 705.67, "timestamp": "00:11:45", "text": "再跟你一起玩一次。别走。"}, {"type": "subtitle", "time": 709.509, "timestamp": "00:11:49", "text": "反正你也没跟任何人玩。"}, {"type": "subtitle", "time": 711.99, "timestamp": "00:11:51", "text": "我是什么？所以盒子。我要去买一个"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "盒子。不，不，不。走，走开。回去。"}, {"type": "subtitle", "time": 717.91, "timestamp": "00:11:57", "text": "耶稣。我不需要你。呃，盒子。上帝。"}]
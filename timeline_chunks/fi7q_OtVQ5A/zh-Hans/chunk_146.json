[{"type": "subtitle", "time": 8760.55, "timestamp": "02:26:00", "text": "哦，不。"}, {"type": "subtitle", "time": 8764.79, "timestamp": "02:26:04", "text": "是的，你可以这样做。真吓人，宝贝。"}, {"type": "subtitle", "time": 8766.71, "timestamp": "02:26:06", "text": "是的，你可以这样做。所以，你知道的"}, {"type": "subtitle", "time": 8768.87, "timestamp": "02:26:08", "text": "我之前给你看的那把枪，"}, {"type": "subtitle", "time": 8773.83, "timestamp": "02:26:13", "text": "那是为了让你可以把它放在你的……"}, {"type": "subtitle", "time": 8777.83, "timestamp": "02:26:17", "text": "嗯，是的，我们来谈谈这件事。"}, {"type": "subtitle", "time": 8779.349, "timestamp": "02:26:19", "text": "是的，"}, {"type": "subtitle", "time": 8783.99, "timestamp": "02:26:23", "text": "这个词怎么发音？五、"}, {"type": "subtitle", "time": 8786.55, "timestamp": "02:26:26", "text": "这主要取决于你怎么说。它"}, {"type": "subtitle", "time": 8799.99, "timestamp": "02:26:39", "text": "它会保留下来吗？我不认为"}, {"type": "subtitle", "time": 8806.07, "timestamp": "02:26:46", "text": "它就留在里面。嗯，让我挪一下。"}, {"type": "subtitle", "time": 8812.23, "timestamp": "02:26:52", "text": "好了。可能有婴儿"}, {"type": "subtitle", "time": 8815.03, "timestamp": "02:26:55", "text": "到处。"}, {"type": "subtitle", "time": 8817.67, "timestamp": "02:26:57", "text": "我觉得他就是这个的头目。"}]
[{"type": "subtitle", "time": 2838.63, "timestamp": "00:47:18", "text": "你擅长玩恐怖游戏吗？"}, {"type": "subtitle", "time": 2840.47, "timestamp": "00:47:20", "text": "哦，不。"}, {"type": "subtitle", "time": 2845.44, "timestamp": "00:47:25", "text": "不。 呃，我不喜欢恐怖片。这件事一直困扰着我。"}, {"type": "subtitle", "time": 2848.8, "timestamp": "00:47:28", "text": "呃，我不喜欢恐怖片。这件事一直困扰着我。 我做了好几个月的梦。所以，"}, {"type": "subtitle", "time": 2851.04, "timestamp": "00:47:31", "text": "我做了好几个月的梦。所以， 我尽量远离它。这还不算太"}, {"type": "subtitle", "time": 2852.96, "timestamp": "00:47:32", "text": "我尽量远离它。这还不算太 坏的。我倒不是很介意。"}, {"type": "subtitle", "time": 2856.16, "timestamp": "00:47:36", "text": "坏的。我倒不是很介意。 其实没那么可怕。"}, {"type": "subtitle", "time": 2863.75, "timestamp": "00:47:43", "text": "是的。 《小鬼当家》正在播放。哦，我的"}, {"type": "subtitle", "time": 2866.79, "timestamp": "00:47:46", "text": "天哪。我不小心尖叫了一声。那是"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "可怕的。我被吓了一跳"}, {"type": "subtitle", "time": 2873.43, "timestamp": "00:47:53", "text": "邻居。我不知道是谁。哦"}, {"type": "subtitle", "time": 2879.589, "timestamp": "00:47:59", "text": "我的上帝。 M，你吓到我了吗？还是没有？"}]
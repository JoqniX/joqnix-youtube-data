[{"type": "subtitle", "time": 7094.95, "timestamp": "01:58:14", "text": "我的天啊。她怕灯。"}, {"type": "subtitle", "time": 7097.109, "timestamp": "01:58:17", "text": "哦，不。"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "我死了。"}, {"type": "subtitle", "time": 7103.99, "timestamp": "01:58:23", "text": "但是你，哦不。我要去。我是个爱拥抱的人"}, {"type": "subtitle", "time": 7106.149, "timestamp": "01:58:26", "text": "他喜欢称自己为“拥抱怪兽”。"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "它。它吓坏了，它把生命吓得魂飞魄散。"}, {"type": "subtitle", "time": 7111.51, "timestamp": "01:58:31", "text": "是我。那当然。那给了我一个"}, {"type": "subtitle", "time": 7113.51, "timestamp": "01:58:33", "text": "突然惊吓。"}, {"type": "subtitle", "time": 7116.149, "timestamp": "01:58:36", "text": "我当时并没有多管闲事。哦，是的。"}, {"type": "subtitle", "time": 7121.669, "timestamp": "01:58:41", "text": "哦，我应该用手榴弹。哦，等等。"}, {"type": "subtitle", "time": 7123.03, "timestamp": "01:58:43", "text": "手榴弹对那东西没用。"}, {"type": "subtitle", "time": 7126.07, "timestamp": "01:58:46", "text": "事物。那东西威力很大。"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "哦，天哪。"}, {"type": "subtitle", "time": 7130.95, "timestamp": "01:58:50", "text": "那吓到我了。嗯，我抢占了先机"}, {"type": "subtitle", "time": 7137.189, "timestamp": "01:58:57", "text": "等等，头呢？它位于顶部"}, {"type": "subtitle", "time": 7139.109, "timestamp": "01:58:59", "text": "帽子。去。不，你是对的。"}]
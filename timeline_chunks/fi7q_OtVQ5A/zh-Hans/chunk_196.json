[{"type": "subtitle", "time": 11777.349, "timestamp": "03:16:17", "text": "是的，他快到了。"}, {"type": "subtitle", "time": 11779.349, "timestamp": "03:16:19", "text": "我决定接受这个。非常感谢，"}, {"type": "subtitle", "time": 11784.07, "timestamp": "03:16:24", "text": "女士。是的，女士。是的。是的，人类"}, {"type": "subtitle", "time": 11797.269, "timestamp": "03:16:37", "text": "等等，不是等等，等等，等等。"}, {"type": "subtitle", "time": 11801.99, "timestamp": "03:16:41", "text": "等待。耽误。它变了，或者发生了什么变化。"}, {"type": "subtitle", "time": 11805.349, "timestamp": "03:16:45", "text": "看看这个。放那边去。我们开始吧"}, {"type": "subtitle", "time": 11807.99, "timestamp": "03:16:47", "text": "骑我们的自行车。所以，这就是我"}, {"type": "subtitle", "time": 11809.99, "timestamp": "03:16:49", "text": "明白了，就像……"}, {"type": "subtitle", "time": 11813.51, "timestamp": "03:16:53", "text": "GTA视角。就像我一样"}, {"type": "subtitle", "time": 11815.75, "timestamp": "03:16:55", "text": "我开始骑踏板车，我感觉"}, {"type": "subtitle", "time": 11818.15, "timestamp": "03:16:58", "text": "像这样，你知道吗？我害怕"}]
[{"type": "subtitle", "time": 20343.83, "timestamp": "05:39:03", "text": "我在这里。年老、疲惫、孤独。我是"}, {"type": "subtitle", "time": 20347.67, "timestamp": "05:39:07", "text": "对于发生的一切，我深感抱歉。确切地。为了"}, {"type": "subtitle", "time": 20350.15, "timestamp": "05:39:10", "text": "一切。"}, {"type": "subtitle", "time": 20355.03, "timestamp": "05:39:15", "text": "特雷弗，我是个老太太。我没有"}, {"type": "subtitle", "time": 20357.83, "timestamp": "05:39:17", "text": "保险。我有钱了。我不想"}, {"type": "subtitle", "time": 20360.23, "timestamp": "05:39:20", "text": "你那该死的钱。那就是你"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "非常痛苦。"}, {"type": "subtitle", "time": 20375.67, "timestamp": "05:39:35", "text": "我需要你再给我弄点儿迷幻药。"}, {"type": "subtitle", "time": 20378.31, "timestamp": "05:39:38", "text": "我可以做到。很多。一个"}, {"type": "subtitle", "time": 20381.03, "timestamp": "05:39:41", "text": "真的是一卡车。而不是那些"}, {"type": "subtitle", "time": 20385.11, "timestamp": "05:39:45", "text": "瘦弱的小家伙们。一千个。"}, {"type": "subtitle", "time": 20389.03, "timestamp": "05:39:49", "text": "如果你觉得我是一位绅士，那么，我们"}]
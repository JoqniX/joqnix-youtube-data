[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "是的，所以我才说我们应该继续前进。"}, {"type": "subtitle", "time": 8883.99, "timestamp": "02:28:03", "text": "后退。好了，我们离开这里吧。"}, {"type": "subtitle", "time": 8899.99, "timestamp": "02:28:19", "text": "[音乐]"}, {"type": "subtitle", "time": 8904.55, "timestamp": "02:28:24", "text": "好的，我还有时间再来一个。"}, {"type": "subtitle", "time": 8908.23, "timestamp": "02:28:28", "text": "我得留下来，哦，它要来了。"}, {"type": "subtitle", "time": 8921.19, "timestamp": "02:28:41", "text": "耶。"}, {"type": "subtitle", "time": 8923.27, "timestamp": "02:28:43", "text": "别管我。"}, {"type": "subtitle", "time": 8935.19, "timestamp": "02:28:55", "text": "跑步。我的天啊。"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "哦，如果不是那个诡异的婴儿，那就是……"}, {"type": "subtitle", "time": 8939.59, "timestamp": "02:28:59", "text": "头骨。"}]
[{"type": "subtitle", "time": 1021.269, "timestamp": "00:17:01", "text": "你知道我喜欢YouTube的机器人用户"}, {"type": "subtitle", "time": 1024.15, "timestamp": "00:17:04", "text": "用链接刷屏聊天"}, {"type": "subtitle", "time": 1027.99, "timestamp": "00:17:07", "text": "东西。哦，天哪，我现在不想死。"}, {"type": "subtitle", "time": 1031.27, "timestamp": "00:17:11", "text": "耶稣基督，离我远点。我"}, {"type": "subtitle", "time": 1034.069, "timestamp": "00:17:14", "text": "我不想现在就死。"}, {"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "好吧，我盯上这套盔甲了。"}, {"type": "subtitle", "time": 1039.669, "timestamp": "00:17:19", "text": "盘子。所以，我就直接选这个吧。"}, {"type": "subtitle", "time": 1043.51, "timestamp": "00:17:23", "text": "装甲板。我是一块盘子。我是一块盘子。"}, {"type": "subtitle", "time": 1047.029, "timestamp": "00:17:27", "text": "你想怎么称呼它都行。在哪里？"}, {"type": "subtitle", "time": 1050.549, "timestamp": "00:17:30", "text": "该死的。我的盔甲被人拿走了吗？"}, {"type": "subtitle", "time": 1052.71, "timestamp": "00:17:32", "text": "真愚蠢。"}, {"type": "subtitle", "time": 1055.83, "timestamp": "00:17:35", "text": "有人拿走了我的防弹板。"}, {"type": "subtitle", "time": 1059.029, "timestamp": "00:17:39", "text": "就在这栋楼里。"}, {"type": "subtitle", "time": 1062.549, "timestamp": "00:17:42", "text": "该死的。所以，上帝"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "哦，他死了。他死了。他死了。"}, {"type": "subtitle", "time": 1068.71, "timestamp": "00:17:48", "text": "没关系，韦恩。死了也没什么不好。"}, {"type": "subtitle", "time": 1070.549, "timestamp": "00:17:50", "text": "你不知道吗？你不知道死亡意味着什么吗？"}, {"type": "subtitle", "time": 1072.789, "timestamp": "00:17:52", "text": "现在可以了吗？这很酷"}, {"type": "subtitle", "time": 1079.909, "timestamp": "00:17:59", "text": "哦，我这是在拥抱死亡。"}]
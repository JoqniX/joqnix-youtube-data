[{"type": "subtitle", "time": 4625.35, "timestamp": "01:17:05", "text": "哦，现在到处都是东西了。床，"}, {"type": "subtitle", "time": 4627.99, "timestamp": "01:17:07", "text": "约翰。好的。"}, {"type": "subtitle", "time": 4630.149, "timestamp": "01:17:10", "text": "我从没碰过无人机。"}, {"type": "subtitle", "time": 4632.07, "timestamp": "01:17:12", "text": "系统尚未建立，"}, {"type": "subtitle", "time": 4634.39, "timestamp": "01:17:14", "text": "所以我也不知道。所以，等等。呃，如果你"}, {"type": "subtitle", "time": 4636.79, "timestamp": "01:17:16", "text": "在这场游戏中死亡，就结束了。你不能"}, {"type": "subtitle", "time": 4647.51, "timestamp": "01:17:27", "text": "视情况而定。不，死了就是死了。这"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "只有那时你才能真正"}, {"type": "subtitle", "time": 4653.35, "timestamp": "01:17:33", "text": "返回是"}, {"type": "subtitle", "time": 4656.95, "timestamp": "01:17:36", "text": "嗯，它叫什么来着？如果是一个团队成员"}, {"type": "subtitle", "time": 4659.189, "timestamp": "01:17:39", "text": "除非你安装了mod，否则不会。"}, {"type": "subtitle", "time": 4664.47, "timestamp": "01:17:44", "text": "继续按就能复活。"}, {"type": "subtitle", "time": 4667.91, "timestamp": "01:17:47", "text": "哦，我找不到秘密。在哪里？"}, {"type": "subtitle", "time": 4679.43, "timestamp": "01:17:59", "text": "哦，一切都乱套了。哦，我"}]
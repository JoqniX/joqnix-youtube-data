[{"type": "subtitle", "time": 19385.51, "timestamp": "05:23:05", "text": "我明白了。你的朋友Stretch可不是……"}, {"type": "subtitle", "time": 19388.788, "timestamp": "05:23:08", "text": "问题。我们走吧。"}, {"type": "subtitle", "time": 19404.868, "timestamp": "05:23:24", "text": "至少整体上还算协调。好的。"}, {"type": "subtitle", "time": 19408.55, "timestamp": "05:23:28", "text": "到了德文家。好的。"}, {"type": "subtitle", "time": 19410.15, "timestamp": "05:23:30", "text": "哦，那一百万美元都在里面。这"}, {"type": "subtitle", "time": 19412.708, "timestamp": "05:23:32", "text": "亿万富翁。我们走吧。"}, {"type": "subtitle", "time": 19429.03, "timestamp": "05:23:49", "text": "我要给他一些东西。"}, {"type": "subtitle", "time": 19435.27, "timestamp": "05:23:55", "text": "除非你从铸造厂得到消息。"}, {"type": "subtitle", "time": 19438.55, "timestamp": "05:23:58", "text": "团队。我不想被打扰。"}]
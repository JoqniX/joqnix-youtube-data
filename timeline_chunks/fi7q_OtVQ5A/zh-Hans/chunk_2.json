[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "屁股很翘。真不错。我"}, {"type": "subtitle", "time": 125.91, "timestamp": "00:02:05", "text": "看。我能听到很多脚步声。这"}, {"type": "subtitle", "time": 128.71, "timestamp": "00:02:08", "text": "依我看，它并不是最好的。我"}, {"type": "subtitle", "time": 136.63, "timestamp": "00:02:16", "text": "哦，杰克，你就在我附近。哦，你的名字"}, {"type": "subtitle", "time": 137.99, "timestamp": "00:02:17", "text": "等等，你离我不远。哦，你醒了"}, {"type": "subtitle", "time": 141.11, "timestamp": "00:02:21", "text": "那里。好的，明白了。天哪。"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "好的，我上来。我上来"}, {"type": "subtitle", "time": 144.47, "timestamp": "00:02:24", "text": "就在那儿。"}, {"type": "subtitle", "time": 153.43, "timestamp": "00:02:33", "text": "好的。对了，你有盔甲吗？"}, {"type": "subtitle", "time": 155.91, "timestamp": "00:02:35", "text": "是的，我愿意。"}, {"type": "subtitle", "time": 157.75, "timestamp": "00:02:37", "text": "你有高级三级证书吗？"}, {"type": "subtitle", "time": 161.589, "timestamp": "00:02:41", "text": "你身上带了什么东西？呃，我做了……"}, {"type": "subtitle", "time": 168.63, "timestamp": "00:02:48", "text": "我的天啊，真是太多了。"}, {"type": "subtitle", "time": 171.35, "timestamp": "00:02:51", "text": "这里的人。对不起。"}, {"type": "subtitle", "time": 179.03, "timestamp": "00:02:59", "text": "呃，对了，你在哪里？在哪里？"}]
[{"type": "subtitle", "time": 16680.709, "timestamp": "04:38:00", "text": "现在。"}, {"type": "subtitle", "time": 16682.551, "timestamp": "04:38:02", "text": "我明白了。谁是"}, {"type": "subtitle", "time": 16684.07, "timestamp": "04:38:04", "text": "混蛋？"}, {"type": "subtitle", "time": 16705.349, "timestamp": "04:38:25", "text": "你是认真的吗？你完蛋了。你"}, {"type": "subtitle", "time": 16708.23, "timestamp": "04:38:28", "text": "我不知道。你什么都知道，"}, {"type": "subtitle", "time": 16711.429, "timestamp": "04:38:31", "text": "狗。等等，什么？但我很抱歉。我猜"}, {"type": "subtitle", "time": 16714.23, "timestamp": "04:38:34", "text": "就是这样。你知道，我正在做我的"}, {"type": "subtitle", "time": 16715.59, "timestamp": "04:38:35", "text": "不知道该如何应对这两件事"}, {"type": "subtitle", "time": 16717.109, "timestamp": "04:38:37", "text": "他们。"}, {"type": "subtitle", "time": 16719.349, "timestamp": "04:38:39", "text": "我了解我自己。"}, {"type": "subtitle", "time": 16720.949, "timestamp": "04:38:40", "text": "拉屎。"}, {"type": "subtitle", "time": 16723.429, "timestamp": "04:38:43", "text": "完蛋了。我们每个人都是"}, {"type": "subtitle", "time": 16726.39, "timestamp": "04:38:46", "text": "操。"}, {"type": "subtitle", "time": 16731.83, "timestamp": "04:38:51", "text": "史蒂夫·海恩斯正承受着巨大的压力"}]
[{"type": "subtitle", "time": 480.23, "timestamp": "00:08:00", "text": "别担心。耶稣。哦，我不是。"}, {"type": "subtitle", "time": 484.15, "timestamp": "00:08:04", "text": "看起来有点像，所以，是的，我是"}, {"type": "subtitle", "time": 494.469, "timestamp": "00:08:14", "text": "即将到来。"}, {"type": "subtitle", "time": 498.23, "timestamp": "00:08:18", "text": "哦，他要掉下去了。嗯，好的。杰奎琳"}, {"type": "subtitle", "time": 499.99, "timestamp": "00:08:19", "text": "里面。对不起。数字四是"}, {"type": "subtitle", "time": 504.15, "timestamp": "00:08:24", "text": "外部。对不起。"}, {"type": "subtitle", "time": 507.83, "timestamp": "00:08:27", "text": "空投即将到来。"}, {"type": "subtitle", "time": 511.83, "timestamp": "00:08:31", "text": "哦，是的。你好，科迪·莱昂。利昂诺尔，你好吗？"}, {"type": "subtitle", "time": 513.67, "timestamp": "00:08:33", "text": "我该怎么念你的名字？你好吗？"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "嗯，它其实挺喜欢我的手机用户界面的。"}, {"type": "subtitle", "time": 518.31, "timestamp": "00:08:38", "text": "它不稳定。所以，它炒我的"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "母板。所以我申请了保修。"}, {"type": "subtitle", "time": 523.67, "timestamp": "00:08:43", "text": "替换它。你好吗？哦，等等。"}, {"type": "subtitle", "time": 525.35, "timestamp": "00:08:45", "text": "马克斯正在谈论他的手机，"}, {"type": "subtitle", "time": 527.59, "timestamp": "00:08:47", "text": "方式。"}, {"type": "subtitle", "time": 529.269, "timestamp": "00:08:49", "text": "我想他是在说他的"}, {"type": "subtitle", "time": 531.43, "timestamp": "00:08:51", "text": "主板？不，不是主板。"}, {"type": "subtitle", "time": 532.949, "timestamp": "00:08:52", "text": "呃，他是在说他的手机吗？"}, {"type": "subtitle", "time": 537.43, "timestamp": "00:08:57", "text": "像电脑那样吗？就是这里。"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "我想他是在说他的手机。"}]
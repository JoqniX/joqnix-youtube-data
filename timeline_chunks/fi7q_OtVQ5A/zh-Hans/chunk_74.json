[{"type": "subtitle", "time": 4446.709, "timestamp": "01:14:06", "text": "我只是在处理那些大件物品时比较吃力。"}, {"type": "subtitle", "time": 4450.95, "timestamp": "01:14:10", "text": "一直如此。比如竖琴之类的东西"}, {"type": "subtitle", "time": 4455.03, "timestamp": "01:14:15", "text": "还有那幅大画。真烦人。我"}, {"type": "subtitle", "time": 4458.31, "timestamp": "01:14:18", "text": "上面还有一颗樱桃。"}, {"type": "subtitle", "time": 4460.87, "timestamp": "01:14:20", "text": "是的，确实如此。我希望那是一颗樱桃。"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "就放在这里吧。今天的……"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "樱桃？是的，它是樱桃。好的。"}, {"type": "subtitle", "time": 4474.07, "timestamp": "01:14:34", "text": "好的。这是一颗樱桃。是的。是的。我是"}, {"type": "subtitle", "time": 4476.63, "timestamp": "01:14:36", "text": "快乐的。我很高兴。"}, {"type": "subtitle", "time": 4479.11, "timestamp": "01:14:39", "text": "好的，我进来了。"}, {"type": "subtitle", "time": 4482.79, "timestamp": "01:14:42", "text": "最好是像这样把它悬停在上面。"}, {"type": "subtitle", "time": 4486.47, "timestamp": "01:14:46", "text": "如果你知道怎么做，就在上方。"}, {"type": "subtitle", "time": 4488.709, "timestamp": "01:14:48", "text": "怎么样？"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "哦，往后退一点。哦，不。哦，不。"}, {"type": "subtitle", "time": 4494.149, "timestamp": "01:14:54", "text": "不过，别担心。就让它这样吧。"}]
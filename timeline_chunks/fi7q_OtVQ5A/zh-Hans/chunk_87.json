[{"type": "subtitle", "time": 5225.03, "timestamp": "01:27:05", "text": "所以大型地震将会大幅下跌。"}, {"type": "subtitle", "time": 5228.07, "timestamp": "01:27:08", "text": "大的。进而"}, {"type": "subtitle", "time": 5231.03, "timestamp": "01:27:11", "text": "哦，找到了。那会让你"}, {"type": "subtitle", "time": 5236.229, "timestamp": "01:27:16", "text": "钱。一台3D打印机。想要。是的。"}, {"type": "subtitle", "time": 5239.35, "timestamp": "01:27:19", "text": "我的天哪，我的猫。你能下来吗？"}, {"type": "subtitle", "time": 5240.81, "timestamp": "01:27:20", "text": "请？"}, {"type": "subtitle", "time": 5243.35, "timestamp": "01:27:23", "text": "[笑声]"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "我拿到匕首了。比如什么？好的"}]
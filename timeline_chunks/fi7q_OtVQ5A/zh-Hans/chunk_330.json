[{"type": "subtitle", "time": 19803.83, "timestamp": "05:30:03", "text": "是富兰克林。嘿，怎么了？"}, {"type": "subtitle", "time": 19807.35, "timestamp": "05:30:07", "text": "我猜你已经抓到他了。安全且并非如此"}, {"type": "subtitle", "time": 19809.67, "timestamp": "05:30:09", "text": "没错吧，伙计？"}, {"type": "subtitle", "time": 19812.548, "timestamp": "05:30:12", "text": "我的错，兄弟。我选了C。那不是吗？"}, {"type": "subtitle", "time": 19814.31, "timestamp": "05:30:14", "text": "婊子？"}, {"type": "subtitle", "time": 19816.628, "timestamp": "05:30:16", "text": "你知道，迪恩，在我看来，"}, {"type": "subtitle", "time": 19818.948, "timestamp": "05:30:18", "text": "嘿，我可不是那种精明的商人。"}, {"type": "subtitle", "time": 19821.43, "timestamp": "05:30:21", "text": "你，但依我看，有两个。"}, {"type": "subtitle", "time": 19823.27, "timestamp": "05:30:23", "text": "困扰美国的巨大罪恶"}, {"type": "subtitle", "time": 19825.67, "timestamp": "05:30:25", "text": "你所实践的那种资本主义。"}, {"type": "subtitle", "time": 19828.788, "timestamp": "05:30:28", "text": "第一点是外包。你付了钱"}, {"type": "subtitle", "time": 19830.628, "timestamp": "05:30:30", "text": "找家私人公司帮你做脏活"}, {"type": "subtitle", "time": 19832.39, "timestamp": "05:30:32", "text": "为你。然后你少付了那笔钱。"}, {"type": "subtitle", "time": 19834.07, "timestamp": "05:30:34", "text": "公司，因为你觉得自己很强大"}, {"type": "subtitle", "time": 19836.07, "timestamp": "05:30:36", "text": "够糟糕了，你竟然没做到"}, {"type": "subtitle", "time": 19838.628, "timestamp": "05:30:38", "text": "必须遵守规则。哦，数字"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "第二，将利润转移到海外。"}, {"type": "subtitle", "time": 19844.31, "timestamp": "05:30:44", "text": "离岸外包。哦，太糟糕了。你"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "不想被派往海外"}, {"type": "subtitle", "time": 19848.47, "timestamp": "05:30:48", "text": "为了省点钱，你会这么做吗？坦克，"}, {"type": "subtitle", "time": 19850.31, "timestamp": "05:30:50", "text": "我不会。哦，不。我不去"}, {"type": "subtitle", "time": 19853.59, "timestamp": "05:30:53", "text": "无处。哦，不。我们知道您的意见"}, {"type": "subtitle", "time": 19856.47, "timestamp": "05:30:56", "text": "关于这件事，迪恩。把你的问题留在那里"}, {"type": "subtitle", "time": 19859.67, "timestamp": "05:30:59", "text": "滚出美国。嗯？在此"}]
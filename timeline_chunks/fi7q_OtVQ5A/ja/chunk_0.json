[{"type": "subtitle", "time": 1.829, "timestamp": "00:00:01", "text": "なんてこった。あれは選手だ。 M. 私の来る"}, {"type": "subtitle", "time": 4.39, "timestamp": "00:00:04", "text": "ここ。来る。行く。どこかに行って。どこかに行って。行く"}, {"type": "subtitle", "time": 6.309, "timestamp": "00:00:06", "text": "離れて。彼を殺せばいい。彼を殺してしまえ。"}, {"type": "subtitle", "time": 7.909, "timestamp": "00:00:07", "text": "いいえ、それは違います。いいね。"}, {"type": "subtitle", "time": 9.669, "timestamp": "00:00:09", "text": "いいね。いいね。たくさんの人がいる"}, {"type": "subtitle", "time": 11.99, "timestamp": "00:00:11", "text": "ウェイン、私たちの周りではね。うん。あなたは完全に"}, {"type": "subtitle", "time": 14.95, "timestamp": "00:00:14", "text": "死ぬだろう。とても多くの人がいました。一瞬の出来事。"}, {"type": "subtitle", "time": 16.79, "timestamp": "00:00:16", "text": "どこかに行って。"}, {"type": "subtitle", "time": 19.83, "timestamp": "00:00:19", "text": "私は死なない。"}, {"type": "subtitle", "time": 23.67, "timestamp": "00:00:23", "text": "どこかに行って。バカな銃をくれよ、この間抜け。"}, {"type": "subtitle", "time": 26.63, "timestamp": "00:00:26", "text": "あなたは銃を持っていません。あなたは銃を持っていた。"}, {"type": "subtitle", "time": 30.87, "timestamp": "00:00:30", "text": "鎧。ああ、神様。まさか本気じゃないよね。"}, {"type": "subtitle", "time": 33.11, "timestamp": "00:00:33", "text": "来て。来て。来て。どこかに行って。私"}, {"type": "subtitle", "time": 36.47, "timestamp": "00:00:36", "text": "気にしない。とにかく、銃を渡してくれ。"}, {"type": "subtitle", "time": 45.27, "timestamp": "00:00:45", "text": "わかった。必要ないと思う、ああ神様。これ"}, {"type": "subtitle", "time": 48.229, "timestamp": "00:00:48", "text": "1つ。ああ、弾薬が入っていない。くそっ"}, {"type": "subtitle", "time": 55.75, "timestamp": "00:00:55", "text": "イナに問題があります。"}]
[{"type": "subtitle", "time": 15840.07, "timestamp": "04:24:00", "text": "ばかげた考えだ。"}, {"type": "subtitle", "time": 15853.51, "timestamp": "04:24:13", "text": "何てことだ。うん。さて、次は砂糖です。砂糖。取る"}, {"type": "subtitle", "time": 15855.51, "timestamp": "04:24:15", "text": "あなたがそこに座っている間に少し"}, {"type": "subtitle", "time": 15858.79, "timestamp": "04:24:18", "text": "くそったれな大金"}, {"type": "subtitle", "time": 15861.51, "timestamp": "04:24:21", "text": "起きてしまったことは仕方がないと受け入れる。"}, {"type": "subtitle", "time": 15864.63, "timestamp": "04:24:24", "text": "あなたが何を言おうと。まあ、これは良い"}, {"type": "subtitle", "time": 15866.309, "timestamp": "04:24:26", "text": "時間。"}, {"type": "subtitle", "time": 15869.03, "timestamp": "04:24:29", "text": "くたばれよ。"}, {"type": "subtitle", "time": 15871.269, "timestamp": "04:24:31", "text": "中西部の強盗犯2人組。あなた"}, {"type": "subtitle", "time": 15873.75, "timestamp": "04:24:33", "text": "男たちは本当に泣き虫になってしまった"}, {"type": "subtitle", "time": 15876.79, "timestamp": "04:24:36", "text": "西海岸の嫌な奴ら。一体何なんだ"}, {"type": "subtitle", "time": 15878.63, "timestamp": "04:24:38", "text": "西海岸の何が問題なの？ああ、何でもないよ。"}, {"type": "subtitle", "time": 15880.95, "timestamp": "04:24:40", "text": "私はここが大好きです。みんなとても麻痺している"}, {"type": "subtitle", "time": 15883.83, "timestamp": "04:24:43", "text": "太陽。 3音節の単語。彼らは考えている"}, {"type": "subtitle", "time": 15886.309, "timestamp": "04:24:46", "text": "あなたは教授です。くたばれ。くたばれ、"}, {"type": "subtitle", "time": 15889.11, "timestamp": "04:24:49", "text": "偉そうな卑劣な奴め。あなたも"}, {"type": "subtitle", "time": 15891.75, "timestamp": "04:24:51", "text": "こんなバカどもを見下すような話し方をするな。"}, {"type": "subtitle", "time": 15895.11, "timestamp": "04:24:55", "text": "おい、レスターを放っておいてくれ。ああ、あなたと"}, {"type": "subtitle", "time": 15897.189, "timestamp": "04:24:57", "text": "レスターは一緒に？ああ、これで"}]
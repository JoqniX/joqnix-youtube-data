[{"type": "subtitle", "time": 13708.87, "timestamp": "03:48:28", "text": "DJ Snakeは最近何をしているのでしょうか？私"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "彼の音楽の最新情報を知る。"}, {"type": "subtitle", "time": 13716.87, "timestamp": "03:48:36", "text": "彼は最近何をしているの？"}, {"type": "subtitle", "time": 13719.03, "timestamp": "03:48:39", "text": "私は多くのことについて全く情報に疎かった"}, {"type": "subtitle", "time": 13722.469, "timestamp": "03:48:42", "text": "私がかつて聴いていた音楽の作曲家"}, {"type": "subtitle", "time": 13725.44, "timestamp": "03:48:45", "text": "積極的にフォローする。"}, {"type": "subtitle", "time": 13735.03, "timestamp": "03:48:55", "text": "さあ行こう。ええ、それが最後です"}, {"type": "subtitle", "time": 13739.349, "timestamp": "03:48:59", "text": "逃走用の車が必要だった。今ならできる。"}]
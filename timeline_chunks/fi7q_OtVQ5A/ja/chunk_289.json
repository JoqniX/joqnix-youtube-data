[{"type": "subtitle", "time": 17341.75, "timestamp": "04:49:01", "text": "コラボレーション。ええ、それは難しいことです"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "コラボレーションを実現するため。"}, {"type": "subtitle", "time": 17348.628, "timestamp": "04:49:08", "text": "私はそうではない"}, {"type": "subtitle", "time": 17350.788, "timestamp": "04:49:10", "text": "それは何と呼ばれますか？イントロはエクストラ"}, {"type": "subtitle", "time": 17352.868, "timestamp": "04:49:12", "text": "木材を作る"}, {"type": "subtitle", "time": 17356.15, "timestamp": "04:49:16", "text": "そして協力し合い、実際に話し合う。私は下手です"}, {"type": "subtitle", "time": 17359.51, "timestamp": "04:49:19", "text": "それ。だから私はコラボレーションの電話をあまりしないんです"}, {"type": "subtitle", "time": 17361.67, "timestamp": "04:49:21", "text": "などなど。"}, {"type": "subtitle", "time": 17364.628, "timestamp": "04:49:24", "text": "彼らのほとんどと、このような時代"}, {"type": "subtitle", "time": 17368.07, "timestamp": "04:49:28", "text": "日曜日にコラボをするのが好きな時"}, {"type": "subtitle", "time": 17372.43, "timestamp": "04:49:32", "text": "などなど。私は清潔なのが好きです。"}, {"type": "subtitle", "time": 17374.948, "timestamp": "04:49:34", "text": "[音楽]"}, {"type": "subtitle", "time": 17377.99, "timestamp": "04:49:37", "text": "何をすべきか分かっています。本当に？"}, {"type": "subtitle", "time": 17380.07, "timestamp": "04:49:40", "text": "はい。"}, {"type": "subtitle", "time": 17383.75, "timestamp": "04:49:43", "text": "レスター・ラマーから電話です。"}, {"type": "subtitle", "time": 17385.59, "timestamp": "04:49:45", "text": "どうしたんだ、相棒？いやあ、物事は親切だ"}, {"type": "subtitle", "time": 17387.67, "timestamp": "04:49:47", "text": "今、めちゃくちゃな状態だよ、犬。すべて"}, {"type": "subtitle", "time": 17389.27, "timestamp": "04:49:49", "text": "いいぞ、[ __ ]。誰よりも適任なのは"}, {"type": "subtitle", "time": 17391.03, "timestamp": "04:49:51", "text": "最悪な状況"}, {"type": "subtitle", "time": 17393.99, "timestamp": "04:49:53", "text": "私のような愚か者？まさに私が聞きたかったことだ。"}, {"type": "subtitle", "time": 17395.43, "timestamp": "04:49:55", "text": "ねえ、見て。君の家に行くよ"}, {"type": "subtitle", "time": 17399.35, "timestamp": "04:49:59", "text": "さっさと出て行け。私はここにいます。"}]
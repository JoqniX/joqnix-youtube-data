[{"type": "subtitle", "time": 6601.27, "timestamp": "01:50:01", "text": "君が手に入れたかどうかさえ確認しなかった"}, {"type": "subtitle", "time": 6606.39, "timestamp": "01:50:06", "text": "それには料金がかかります。ああ、そして"}, {"type": "subtitle", "time": 6621.35, "timestamp": "01:50:21", "text": "それを受け取ります。"}, {"type": "subtitle", "time": 6625.27, "timestamp": "01:50:25", "text": "秘密のピースをくれたの？"}, {"type": "subtitle", "time": 6639.59, "timestamp": "01:50:39", "text": "了解です。"}, {"type": "subtitle", "time": 6651.189, "timestamp": "01:50:51", "text": "ああ、撫でてあげて。"}, {"type": "subtitle", "time": 6653.59, "timestamp": "01:50:53", "text": "何？"}, {"type": "subtitle", "time": 6658.31, "timestamp": "01:50:58", "text": "待って、待って。諦めずに続けてください。きっと理解できますよ。"}]
[{"type": "subtitle", "time": 7627.51, "timestamp": "02:07:07", "text": "ええ、あと少しだけ必要です。おお、"}, {"type": "subtitle", "time": 7630.229, "timestamp": "02:07:10", "text": "うん。今気づいたんだけど、HPが10しかないから、"}, {"type": "subtitle", "time": 7632.95, "timestamp": "02:07:12", "text": "もっと注意しなければならない。"}, {"type": "subtitle", "time": 7649.51, "timestamp": "02:07:29", "text": "お茶のカップをチェックできます。おお、"}, {"type": "subtitle", "time": 7652.55, "timestamp": "02:07:32", "text": "ほら、あそこにカップがある。ああ、カップと"}, {"type": "subtitle", "time": 7654.55, "timestamp": "02:07:34", "text": "ダイヤモンド。"}, {"type": "subtitle", "time": 7657.43, "timestamp": "02:07:37", "text": "いや、絶対にないよ。ああ、わかりました。私はあなたが"}, {"type": "subtitle", "time": 7660.229, "timestamp": "02:07:40", "text": "ぶち壊した。"}, {"type": "subtitle", "time": 7661.75, "timestamp": "02:07:41", "text": "それは反対側にあるはずだ。の"}, {"type": "subtitle", "time": 7674.79, "timestamp": "02:07:54", "text": "ダイヤモンドを手に入れました。"}]
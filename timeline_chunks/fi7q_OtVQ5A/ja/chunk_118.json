[{"type": "subtitle", "time": 7094.95, "timestamp": "01:58:14", "text": "何てことだ。彼女は光が怖い。"}, {"type": "subtitle", "time": 7097.109, "timestamp": "01:58:17", "text": "なんてこった。"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "私は死んだ。"}, {"type": "subtitle", "time": 7103.99, "timestamp": "01:58:23", "text": "でも、あなたはああ、いや。私は行きます。私はハグ好き"}, {"type": "subtitle", "time": 7106.149, "timestamp": "01:58:26", "text": "彼が呼ぶところのハグモンスター"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "それ。それは、それは、"}, {"type": "subtitle", "time": 7111.51, "timestamp": "01:58:31", "text": "私の。それは間違いない。それは私に"}, {"type": "subtitle", "time": 7113.51, "timestamp": "01:58:33", "text": "ジャンプスケア。"}, {"type": "subtitle", "time": 7116.149, "timestamp": "01:58:36", "text": "私は自分のことに集中していた。そうそう、"}, {"type": "subtitle", "time": 7121.669, "timestamp": "01:58:41", "text": "ああ、手榴弾を使うべきだった。あ、待って。"}, {"type": "subtitle", "time": 7123.03, "timestamp": "01:58:43", "text": "手榴弾はそれに対しては何の効果もない"}, {"type": "subtitle", "time": 7126.07, "timestamp": "01:58:46", "text": "もの。あれは強力だ。"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "ああ、もう。"}, {"type": "subtitle", "time": 7130.95, "timestamp": "01:58:50", "text": "それは怖かった。よし、ジャンプしたぞ"}, {"type": "subtitle", "time": 7137.189, "timestamp": "01:58:57", "text": "待って、頭はどこ？それは"}, {"type": "subtitle", "time": 7139.109, "timestamp": "01:58:59", "text": "キャップ。行く。いいえ、あなたの言う通りです"}]
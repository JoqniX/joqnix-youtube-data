[{"type": "subtitle", "time": 6545.669, "timestamp": "01:49:05", "text": "ああ、2万ドルか。そうそう。"}, {"type": "subtitle", "time": 6548.79, "timestamp": "01:49:08", "text": "それはまるで、私たちの全財産を失ったようなものだ。"}, {"type": "subtitle", "time": 6551.189, "timestamp": "01:49:11", "text": "弾薬が無限だとは思わない。"}, {"type": "subtitle", "time": 6555.03, "timestamp": "01:49:15", "text": "右？いいえ、その不具合もなくなりました。"}, {"type": "subtitle", "time": 6557.03, "timestamp": "01:49:17", "text": "恐れている。"}, {"type": "subtitle", "time": 6558.87, "timestamp": "01:49:18", "text": "一定量あります。そしてあなたは"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "7、8、9、10、11、12、13 の料金が必要です。"}, {"type": "subtitle", "time": 6568.87, "timestamp": "01:49:28", "text": "それほど多くはない。仕組まれている"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "そうかどうかは分かりません。これはたくさん"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "けれど。"}, {"type": "subtitle", "time": 6579.99, "timestamp": "01:49:39", "text": "え、本当に？これは、"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "無限。"}, {"type": "subtitle", "time": 6583.91, "timestamp": "01:49:43", "text": "まあ、君がそうしたいならそうしてもいいけど、私は"}, {"type": "subtitle", "time": 6586.39, "timestamp": "01:49:46", "text": "警告します。それはあなたが"}, {"type": "subtitle", "time": 6589.51, "timestamp": "01:49:49", "text": "その店は無限だ。"}, {"type": "subtitle", "time": 6591.75, "timestamp": "01:49:51", "text": "わかった。"}, {"type": "subtitle", "time": 6599.43, "timestamp": "01:49:59", "text": "落としたら勝手に撃たれた。おお。"}]
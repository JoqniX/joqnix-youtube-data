[{"type": "subtitle", "time": 6919.43, "timestamp": "01:55:19", "text": "あ、あ"}, {"type": "subtitle", "time": 6921.109, "timestamp": "01:55:21", "text": "わかった。"}, {"type": "subtitle", "time": 6923.51, "timestamp": "01:55:23", "text": "なぜこんなレベルにまでならなければならないのか？しないで"}, {"type": "subtitle", "time": 6925.91, "timestamp": "01:55:25", "text": "抽出ポイントが2つあることを忘れてください。"}, {"type": "subtitle", "time": 6934.87, "timestamp": "01:55:34", "text": "大柄な男。"}, {"type": "subtitle", "time": 6939.03, "timestamp": "01:55:39", "text": "大男。手に持つには大きな物だ。"}]
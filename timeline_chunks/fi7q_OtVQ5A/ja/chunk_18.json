[{"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "大丈夫です。大丈夫です。攻撃を受ける"}, {"type": "subtitle", "time": 1090.47, "timestamp": "00:18:10", "text": "誰かによって。たぶん私は"}, {"type": "subtitle", "time": 1091.909, "timestamp": "00:18:11", "text": "わからない。私は攻撃されている、私は"}, {"type": "subtitle", "time": 1093.35, "timestamp": "00:18:13", "text": "推測。"}, {"type": "subtitle", "time": 1095.75, "timestamp": "00:18:15", "text": "私はとても心配していません。気にしないでください。"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "ただ、私はただ神経質になっているだけです。しないで"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "それについて心配してください。誰？これは誰？わかった。"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "武器を渡せ。誰か"}, {"type": "subtitle", "time": 1106.95, "timestamp": "00:18:26", "text": "近くに来てください。だから私はただ"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "私はあなたに向かっています。どこにいるの"}, {"type": "subtitle", "time": 1110.95, "timestamp": "00:18:30", "text": "みんな？それで、あなたたちはなぜあそこにいるのですか？そして"}, {"type": "subtitle", "time": 1115.029, "timestamp": "00:18:35", "text": "私はなぜここにいるのか？ええと、オプションがあります"}, {"type": "subtitle", "time": 1121.51, "timestamp": "00:18:41", "text": "もう諦めろ。神、"}, {"type": "subtitle", "time": 1123.83, "timestamp": "00:18:43", "text": "私は諦めかけていた。どうもありがとうございます、"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "君のことをとても誇りに思うよ。"}, {"type": "subtitle", "time": 1133.029, "timestamp": "00:18:53", "text": "はい。誇りに思ってください。誇りに思ってください。どうですか？"}]
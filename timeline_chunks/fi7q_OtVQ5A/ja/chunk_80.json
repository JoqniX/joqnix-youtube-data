[{"type": "subtitle", "time": 4803.11, "timestamp": "01:20:03", "text": "健康になりたいですか、それとも今のままでいいですか？おお、"}, {"type": "subtitle", "time": 4806.229, "timestamp": "01:20:06", "text": "うん。健康。ええ、そうですね。私は99歳です。だから、私は"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "良い。私は大丈夫です。よし。あなたは上手い。"}, {"type": "subtitle", "time": 4815.35, "timestamp": "01:20:15", "text": "Sh。盗んでもいいですよ。"}, {"type": "subtitle", "time": 4817.189, "timestamp": "01:20:17", "text": "盗むこともできるよ。転向するかもしれない"}, {"type": "subtitle", "time": 4827.669, "timestamp": "01:20:27", "text": "他に何か？私たちはちょうど"}, {"type": "subtitle", "time": 4830.149, "timestamp": "01:20:30", "text": "ドローン。もっと軽い感じにしよう。の"}, {"type": "subtitle", "time": 4833.669, "timestamp": "01:20:33", "text": "ドローンを充電するための充電器。余分な"}, {"type": "subtitle", "time": 4838.07, "timestamp": "01:20:38", "text": "到着。体力回復のための休息。あなたはやりたいと思います"}, {"type": "subtitle", "time": 4840.55, "timestamp": "01:20:40", "text": "スタミナが欲しいのか？うん、もらうよ"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "スタミナ。よし。わかった。"}, {"type": "subtitle", "time": 4848.149, "timestamp": "01:20:48", "text": "それがあなたの望みですか？はい。"}, {"type": "subtitle", "time": 4849.58, "timestamp": "01:20:49", "text": "わかった、"}]
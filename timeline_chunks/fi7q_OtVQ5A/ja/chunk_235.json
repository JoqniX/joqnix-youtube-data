[{"type": "subtitle", "time": 14102.79, "timestamp": "03:55:02", "text": "なんてこった。"}, {"type": "subtitle", "time": 14104.95, "timestamp": "03:55:04", "text": "やあ。"}, {"type": "subtitle", "time": 14107.11, "timestamp": "03:55:07", "text": "でもそれは、あなたが何かを言うとき"}, {"type": "subtitle", "time": 14109.429, "timestamp": "03:55:09", "text": "誰かが「おいおい、何だ"}, {"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "えっ？"}, {"type": "subtitle", "time": 14113.75, "timestamp": "03:55:13", "text": "「ちょっと待って、私って言ったっけ？」"}, {"type": "subtitle", "time": 14116.15, "timestamp": "03:55:16", "text": "「私が持ってはいけないもの？」何？え？"}, {"type": "subtitle", "time": 14154.07, "timestamp": "03:55:54", "text": "待って、まさにその通り。あなたはeと言います。あなたは言う"}]
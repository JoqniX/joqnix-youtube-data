[{"type": "subtitle", "time": 4380.709, "timestamp": "01:13:00", "text": "だから最初の1つを手に入れたら、"}, {"type": "subtitle", "time": 4386.63, "timestamp": "01:13:06", "text": "いつも行くのが一番いい考えです"}, {"type": "subtitle", "time": 4391.669, "timestamp": "01:13:11", "text": "一番最後のものについて。"}, {"type": "subtitle", "time": 4395.11, "timestamp": "01:13:15", "text": "あなたは遠くへ行くわけではありません。"}, {"type": "subtitle", "time": 4403.11, "timestamp": "01:13:23", "text": "それは安全です。"}, {"type": "subtitle", "time": 4405.51, "timestamp": "01:13:25", "text": "うん。"}, {"type": "subtitle", "time": 4408.39, "timestamp": "01:13:28", "text": "待って。 16k。待って、41あります"}, {"type": "subtitle", "time": 4409.91, "timestamp": "01:13:29", "text": "けれど。"}, {"type": "subtitle", "time": 4412.709, "timestamp": "01:13:32", "text": "ああ、今何が起こったのか全く分かりません。"}, {"type": "subtitle", "time": 4421.03, "timestamp": "01:13:41", "text": "休憩しましょう。全く問題なかった。"}, {"type": "subtitle", "time": 4422.709, "timestamp": "01:13:42", "text": "うん。ええと、お金のことですよね？あなたがしなければならない"}, {"type": "subtitle", "time": 4425.59, "timestamp": "01:13:45", "text": "お金を持ってこい。そうだ、私たちは"}, {"type": "subtitle", "time": 4427.83, "timestamp": "01:13:47", "text": "お金を持ってきてください。"}, {"type": "subtitle", "time": 4430.47, "timestamp": "01:13:50", "text": "わかった。それまでは、私は飲み物を"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "私の弓。はい、それは良いですね"}, {"type": "subtitle", "time": 4435.189, "timestamp": "01:13:55", "text": "アイデア。"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "ここに残っているのはそれだけだ。"}]
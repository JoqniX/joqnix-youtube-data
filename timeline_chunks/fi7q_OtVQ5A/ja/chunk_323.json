[{"type": "subtitle", "time": 19385.51, "timestamp": "05:23:05", "text": "了解しました。君の友達はストレッチしない"}, {"type": "subtitle", "time": 19388.788, "timestamp": "05:23:08", "text": "問題。さあ行こう。"}, {"type": "subtitle", "time": 19404.868, "timestamp": "05:23:24", "text": "少なくとも、全員がきちんと一緒にいるべきだ。わかった。"}, {"type": "subtitle", "time": 19408.55, "timestamp": "05:23:28", "text": "デビンの家に到着した。わかった。"}, {"type": "subtitle", "time": 19410.15, "timestamp": "05:23:30", "text": "ああ、百万はそこにある。の"}, {"type": "subtitle", "time": 19412.708, "timestamp": "05:23:32", "text": "億万長者。さあ行こう。"}, {"type": "subtitle", "time": 19429.03, "timestamp": "05:23:49", "text": "私は彼に何かを譲り渡すつもりだ"}, {"type": "subtitle", "time": 19435.27, "timestamp": "05:23:55", "text": "鋳造所から連絡がない限り"}, {"type": "subtitle", "time": 19438.55, "timestamp": "05:23:58", "text": "チーム。邪魔されたくない。"}]
[{"type": "subtitle", "time": 4562.709, "timestamp": "01:16:02", "text": "彼らは「ああ、君は要らない」という感じだ。"}, {"type": "subtitle", "time": 4566.95, "timestamp": "01:16:06", "text": "「私たちのヘルスパックを無料で盗むために。」私、"}, {"type": "subtitle", "time": 4569.51, "timestamp": "01:16:09", "text": "これを見てください。では、あなたならどうしますか？"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "何？うん、これは新しいね。それは それは"}, {"type": "subtitle", "time": 4575.27, "timestamp": "01:16:15", "text": "まるで銃のようだ。だから、それを上に置くと"}, {"type": "subtitle", "time": 4579.27, "timestamp": "01:16:19", "text": "だから、あなたはこれをするでしょう。"}, {"type": "subtitle", "time": 4581.669, "timestamp": "01:16:21", "text": "車の近くに置いておけば"}, {"type": "subtitle", "time": 4583.91, "timestamp": "01:16:23", "text": "これで敵を撃て。きれい"}, {"type": "subtitle", "time": 4586.31, "timestamp": "01:16:26", "text": "強力だ。"}, {"type": "subtitle", "time": 4587.91, "timestamp": "01:16:27", "text": "おお。"}, {"type": "subtitle", "time": 4591.11, "timestamp": "01:16:31", "text": "それは確かに存在する。はい。だから、あなたは"}, {"type": "subtitle", "time": 4594.47, "timestamp": "01:16:34", "text": "車を選択して、次にこれを押します。"}, {"type": "subtitle", "time": 4596.39, "timestamp": "01:16:36", "text": "撃ちます"}, {"type": "subtitle", "time": 4599.75, "timestamp": "01:16:39", "text": "巨大なレーザー。でも、"}, {"type": "subtitle", "time": 4602.07, "timestamp": "01:16:42", "text": "充電はしておいてね。"}, {"type": "subtitle", "time": 4605.27, "timestamp": "01:16:45", "text": "ああ、そうそう。"}]
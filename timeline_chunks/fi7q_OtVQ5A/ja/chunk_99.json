[{"type": "subtitle", "time": 5940.229, "timestamp": "01:39:00", "text": "ええ、これは商品です。はい、できます。"}, {"type": "subtitle", "time": 5944.07, "timestamp": "01:39:04", "text": "それはアイテムです。だから、ああ"}, {"type": "subtitle", "time": 5950.95, "timestamp": "01:39:10", "text": "つまり、それが起こるということは"}, {"type": "subtitle", "time": 5956.07, "timestamp": "01:39:16", "text": "持つのをやめなさい。気絶しちゃうよ。"}, {"type": "subtitle", "time": 5973.91, "timestamp": "01:39:33", "text": "ああ、これもぬいぐるみ素材の靴ですね。"}, {"type": "subtitle", "time": 5977.99, "timestamp": "01:39:37", "text": "あれは不気味なぬいぐるみだ。"}, {"type": "subtitle", "time": 5980.31, "timestamp": "01:39:40", "text": "ああ、なんて恐ろしいんだ。あなたは"}, {"type": "subtitle", "time": 5981.83, "timestamp": "01:39:41", "text": "降りてくるのか、降りてこないのか？持続する。私の"}, {"type": "subtitle", "time": 5984.39, "timestamp": "01:39:44", "text": "猫はああ、なんてことだ。うん。はい、"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "あなたが行く。うちの猫がイライラしている。おお"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "ああ。これは小さなスタジアムですか？"}, {"type": "subtitle", "time": 5998.87, "timestamp": "01:39:58", "text": "おお。何てことだ。私はそうする必要はなかった"}]
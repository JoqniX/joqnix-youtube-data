[{"type": "subtitle", "time": 3603.51, "timestamp": "01:00:03", "text": "残りは保存すべきだと思う。"}, {"type": "subtitle", "time": 3605.91, "timestamp": "01:00:05", "text": "それ以外のものは全て高すぎる。"}, {"type": "subtitle", "time": 3608.47, "timestamp": "01:00:08", "text": "はい。"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "わかった。不具合。"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "ベータ版としてまだ残っているといいのですが。"}, {"type": "subtitle", "time": 3632.39, "timestamp": "01:00:32", "text": "忘れた。警告するのを忘れていました。だから、"}, {"type": "subtitle", "time": 3634.39, "timestamp": "01:00:34", "text": "あなたはそうだった。"}, {"type": "subtitle", "time": 3639.91, "timestamp": "01:00:39", "text": "何ではないのか？いいえ。申し訳ありません。なぜ？"}, {"type": "subtitle", "time": 3644.39, "timestamp": "01:00:44", "text": "何てことだ。開発者の皆さん、なぜですか？ああ、私は"}, {"type": "subtitle", "time": 3647.75, "timestamp": "01:00:47", "text": "間違ったことだ。 Eキーを押します。分かっています。おお、"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "もう片方はどうなったの？おお。おお、"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "いいえ。うん。待って。何をしたいですか"}, {"type": "subtitle", "time": 3654.789, "timestamp": "01:00:54", "text": "取る？手榴弾か、それとも黒い樽か？"}, {"type": "subtitle", "time": 3656.95, "timestamp": "01:00:56", "text": "それを受け取ります。ああ、神様。ありがとう。取る"}]
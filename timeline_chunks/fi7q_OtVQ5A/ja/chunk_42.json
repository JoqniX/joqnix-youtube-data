[{"type": "subtitle", "time": 2525.27, "timestamp": "00:42:05", "text": "神。このゲーム。待って。待って。えっと、私は"}, {"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": "え、ちょっと待って？再ロードした方がいいと思う"}, {"type": "subtitle", "time": 2529.19, "timestamp": "00:42:09", "text": "Steamのことですよね？"}, {"type": "subtitle", "time": 2532.23, "timestamp": "00:42:12", "text": "Steamの画面をお見せします。わかった。"}, {"type": "subtitle", "time": 2535.51, "timestamp": "00:42:15", "text": "つまり、優先順位がわかるということです。"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "ここから変更してください。"}, {"type": "subtitle", "time": 2544.15, "timestamp": "00:42:24", "text": "これはBだ。うん。左クリックしました"}, {"type": "subtitle", "time": 2545.829, "timestamp": "00:42:25", "text": "または右クリックしてください。いいえ、右クリックしてください。"}, {"type": "subtitle", "time": 2548.39, "timestamp": "00:42:28", "text": "優先順位をつけて、それから変更します"}, {"type": "subtitle", "time": 2550.63, "timestamp": "00:42:30", "text": "Bを通してそれを行います。"}, {"type": "subtitle", "time": 2553.43, "timestamp": "00:42:33", "text": "ええと、優先事項です。"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "プライバシー。待って、優先順位はどこにあるの？"}, {"type": "subtitle", "time": 2561.03, "timestamp": "00:42:41", "text": "Pの特性。一番下。"}, {"type": "subtitle", "time": 2571.19, "timestamp": "00:42:51", "text": "そしてベータ版にアクセスして、こちらを選択してください。"}, {"type": "subtitle", "time": 2576.79, "timestamp": "00:42:56", "text": "ええ、ベータ版ブランチって書いてありますね。それで"}, {"type": "subtitle", "time": 2579.589, "timestamp": "00:42:59", "text": "わかりました、もう一度ベータ版ブランチに反映させます。"}]
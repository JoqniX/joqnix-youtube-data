[{"type": "subtitle", "time": 19803.83, "timestamp": "05:30:03", "text": "フランクリンです。やぁ、何やってんの？"}, {"type": "subtitle", "time": 19807.35, "timestamp": "05:30:07", "text": "彼を捕まえたのでしょうね。安全で、"}, {"type": "subtitle", "time": 19809.67, "timestamp": "05:30:09", "text": "そうだろ、相棒？"}, {"type": "subtitle", "time": 19812.548, "timestamp": "05:30:12", "text": "ごめんよ、相棒。 Cを選んだ。"}, {"type": "subtitle", "time": 19814.31, "timestamp": "05:30:14", "text": "[ __ ]？"}, {"type": "subtitle", "time": 19816.628, "timestamp": "05:30:16", "text": "デオン、私の考えでは、"}, {"type": "subtitle", "time": 19818.948, "timestamp": "05:30:18", "text": "ねえ、私は賢いビジネスマンではない"}, {"type": "subtitle", "time": 19821.43, "timestamp": "05:30:21", "text": "あなた、でも私の見方では、2つあります"}, {"type": "subtitle", "time": 19823.27, "timestamp": "05:30:23", "text": "アメリカを悩ませる大きな悪"}, {"type": "subtitle", "time": 19825.67, "timestamp": "05:30:25", "text": "あなたが実践しているような資本主義。"}, {"type": "subtitle", "time": 19828.788, "timestamp": "05:30:28", "text": "1つ目はアウトソーシングです。あなたは支払いました"}, {"type": "subtitle", "time": 19830.628, "timestamp": "05:30:30", "text": "あなたの汚い仕事を代行してくれる民間企業"}, {"type": "subtitle", "time": 19832.39, "timestamp": "05:30:32", "text": "あなたのために。そしてあなたはそれを過少に支払いました"}, {"type": "subtitle", "time": 19834.07, "timestamp": "05:30:34", "text": "会社が大きかったから"}, {"type": "subtitle", "time": 19836.07, "timestamp": "05:30:36", "text": "十分悪くて、"}, {"type": "subtitle", "time": 19838.628, "timestamp": "05:30:38", "text": "ルールに従わなければならない。ああ、番号"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "2つ目は、利益を海外に移転すること。"}, {"type": "subtitle", "time": 19844.31, "timestamp": "05:30:44", "text": "オフショアリング。ああ、ひどい。あなた"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "海外に派遣されたくない"}, {"type": "subtitle", "time": 19848.47, "timestamp": "05:30:48", "text": "少しでもお金を節約したいと思いませんか？タンク、"}, {"type": "subtitle", "time": 19850.31, "timestamp": "05:30:50", "text": "私はそうはしない。なんてこった。私は行かない"}, {"type": "subtitle", "time": 19853.59, "timestamp": "05:30:53", "text": "どこにもない。なんてこった。私たちはあなたの意見を知っています"}, {"type": "subtitle", "time": 19856.47, "timestamp": "05:30:56", "text": "その件については、デオン。問題を"}, {"type": "subtitle", "time": 19859.67, "timestamp": "05:30:59", "text": "アメリカから出て行け。はぁ？この"}]
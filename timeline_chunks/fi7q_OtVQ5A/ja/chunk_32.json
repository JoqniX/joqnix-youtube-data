[{"type": "subtitle", "time": 1921.029, "timestamp": "00:32:01", "text": "彼は畏敬の念を抱いているようで、"}, {"type": "subtitle", "time": 1923.669, "timestamp": "00:32:03", "text": "ただ叫んで、彼を撃て。ただ"}, {"type": "subtitle", "time": 1925.75, "timestamp": "00:32:05", "text": "彼の顔に向かって叫び、そして殺した。"}, {"type": "subtitle", "time": 1934.549, "timestamp": "00:32:14", "text": "どこ？"}, {"type": "subtitle", "time": 1936.549, "timestamp": "00:32:16", "text": "みんなはどこにいるの？私はただ殺したいだけ"}, {"type": "subtitle", "time": 1938.23, "timestamp": "00:32:18", "text": "誰か。"}, {"type": "subtitle", "time": 1940.149, "timestamp": "00:32:20", "text": "了解、了解。彼は建設中です"}, {"type": "subtitle", "time": 1941.99, "timestamp": "00:32:21", "text": "いつものように喉が渇いた。彼のことは心配しないで、"}, {"type": "subtitle", "time": 1944.389, "timestamp": "00:32:24", "text": "私は推測する。えっと、私は今死ぬんですか？"}, {"type": "subtitle", "time": 1945.99, "timestamp": "00:32:25", "text": "なぜなら、私だけが"}, {"type": "subtitle", "time": 1949.83, "timestamp": "00:32:29", "text": "一人で。ああ、今は私たち３人だけだよ。"}, {"type": "subtitle", "time": 1954.95, "timestamp": "00:32:34", "text": "幸せな家族。おお、いいね。はい。待って、"}, {"type": "subtitle", "time": 1957.19, "timestamp": "00:32:37", "text": "それは素晴らしいですね。私たちには発言権がない。あなた"}, {"type": "subtitle", "time": 1959.35, "timestamp": "00:32:39", "text": "4人目のプレイヤーについて言及する必要はありません。誰が"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "ああ神様のことを気にかけている。うん。みんな"}, {"type": "subtitle", "time": 1971.35, "timestamp": "00:32:51", "text": "わかった。誰かが私から逃げている。"}, {"type": "subtitle", "time": 1975.35, "timestamp": "00:32:55", "text": "まったく、一体誰なんだ？誰が"}]
[{"type": "subtitle", "time": 20160.708, "timestamp": "05:36:00", "text": "国ではヨガは馬鹿げていると思っていた"}, {"type": "subtitle", "time": 20164.07, "timestamp": "05:36:04", "text": "塩漬けの屠殺を肉体的に好むようだ"}, {"type": "subtitle", "time": 20167.43, "timestamp": "05:36:07", "text": "野心のない"}, {"type": "subtitle", "time": 20169.43, "timestamp": "05:36:09", "text": "フレンドリーだけど、終わらせないのは恐ろしい"}, {"type": "subtitle", "time": 20171.35, "timestamp": "05:36:11", "text": "彼らが助けを必要としているかどうかはわかりませんが、私は"}, {"type": "subtitle", "time": 20175.35, "timestamp": "05:36:15", "text": "これは何ですか"}, {"type": "subtitle", "time": 20185.75, "timestamp": "05:36:25", "text": "あなたの精神鑑定報告書は、"}, {"type": "subtitle", "time": 20187.67, "timestamp": "05:36:27", "text": "見つかる"}, {"type": "subtitle", "time": 20197.43, "timestamp": "05:36:37", "text": "はぁ？だから私は尋ねたのです"}, {"type": "subtitle", "time": 20201.27, "timestamp": "05:36:41", "text": "あなたはその願いを押します。ああ、そういうことだったのか。"}, {"type": "subtitle", "time": 20203.27, "timestamp": "05:36:43", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 20208.39, "timestamp": "05:36:48", "text": "何か終わらせておかなければならないことはありますか？"}, {"type": "subtitle", "time": 20211.43, "timestamp": "05:36:51", "text": "変人や奇人だけ、ですよね？これ"}]
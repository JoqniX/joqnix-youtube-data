[{"type": "subtitle", "time": 2281.829, "timestamp": "00:38:01", "text": "アリソン、"}, {"type": "subtitle", "time": 2285.43, "timestamp": "00:38:05", "text": "待って、スティーブ、私を裏切らないで。"}, {"type": "subtitle", "time": 2287.19, "timestamp": "00:38:07", "text": "えーと"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "招待を受ける。"}, {"type": "subtitle", "time": 2294.63, "timestamp": "00:38:14", "text": "それで、お元気でしたか？調子はどうですか？えっと"}, {"type": "subtitle", "time": 2303.03, "timestamp": "00:38:23", "text": "あなたはどうですか？しばらく経ちました"}, {"type": "subtitle", "time": 2305.589, "timestamp": "00:38:25", "text": "最後にあなたと話したのはいつだったか。うん。うん。うん。"}, {"type": "subtitle", "time": 2308.87, "timestamp": "00:38:28", "text": "私にとっては、それは一日です。人生って、"}, {"type": "subtitle", "time": 2312.95, "timestamp": "00:38:32", "text": "上がったり下がったりして、ええ"}, {"type": "subtitle", "time": 2315.19, "timestamp": "00:38:35", "text": "最初は日本に行く予定だった"}, {"type": "subtitle", "time": 2317.829, "timestamp": "00:38:37", "text": "来月だったが延期された"}, {"type": "subtitle", "time": 2322.63, "timestamp": "00:38:42", "text": "来年の4月。そういうことだ。"}, {"type": "subtitle", "time": 2325.99, "timestamp": "00:38:45", "text": "ええ、それは政治的な理由によるものでした"}, {"type": "subtitle", "time": 2328.95, "timestamp": "00:38:48", "text": "私の国では問題があり、それからJ"}, {"type": "subtitle", "time": 2330.79, "timestamp": "00:38:50", "text": "日本の学校は「いや、私たちはそうしない」という感じでした"}, {"type": "subtitle", "time": 2334.31, "timestamp": "00:38:54", "text": "今はリスクを取ってみたい。"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "わかった。"}]
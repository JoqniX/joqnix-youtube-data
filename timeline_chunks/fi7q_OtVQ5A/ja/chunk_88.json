[{"type": "subtitle", "time": 5299.99, "timestamp": "01:28:19", "text": "いいえ。"}, {"type": "subtitle", "time": 5312.149, "timestamp": "01:28:32", "text": "これについては助けが必要だと思う。私は思う"}, {"type": "subtitle", "time": 5315.27, "timestamp": "01:28:35", "text": "あなたは出来る。残りは私たちが取ればいい。もし"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "あの怪物たちがもういないことを願おう"}]
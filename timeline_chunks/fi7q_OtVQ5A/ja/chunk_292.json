[{"type": "subtitle", "time": 17521.03, "timestamp": "04:52:01", "text": "俺の仲間は[ __ ]だ。それは私の"}, {"type": "subtitle", "time": 17523.11, "timestamp": "04:52:03", "text": "家族。ちくしょう、[ __ ]。君は私を完全に虜にする"}, {"type": "subtitle", "time": 17525.03, "timestamp": "04:52:05", "text": "今は感情的になっている。ニガは止めなければならないかもしれない"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "お前のチンポをしゃぶるのをやめろよ、[ __ ]。ニガ、"}, {"type": "subtitle", "time": 17531.27, "timestamp": "04:52:11", "text": "消え失せろよ。この町の愚か者どもは皆"}, {"type": "subtitle", "time": 17533.59, "timestamp": "04:52:13", "text": "拍手したい人がいる。ええ、でも"}, {"type": "subtitle", "time": 17535.51, "timestamp": "04:52:15", "text": "それは一部の愚か者に当てはまる"}, {"type": "subtitle", "time": 17537.83, "timestamp": "04:52:17", "text": "その他。聞こえたよ、[ __ ]。私は話している"}, {"type": "subtitle", "time": 17540.15, "timestamp": "04:52:20", "text": "あなたについて。この町の誰もが"}, {"type": "subtitle", "time": 17543.51, "timestamp": "04:52:23", "text": "お前のケツを殴ってやる。並んで"}, {"type": "subtitle", "time": 17546.12, "timestamp": "04:52:26", "text": "シューッと音を立てた"}, {"type": "subtitle", "time": 17548.31, "timestamp": "04:52:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17551.35, "timestamp": "04:52:31", "text": "できるだけ多くのクソ野郎を始末する"}, {"type": "subtitle", "time": 17553.11, "timestamp": "04:52:33", "text": "くそっ。おい、お前は大きく振る舞うが、"}]
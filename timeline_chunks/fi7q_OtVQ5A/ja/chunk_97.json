[{"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "私は18歳じゃなかった。おいおい、冗談だろ。何？あなた"}, {"type": "subtitle", "time": 5849.43, "timestamp": "01:37:29", "text": "死んだ？ああ、そいつに撃たれたんだ。彼は"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "で"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "部屋は以前からありました。お皿があります"}, {"type": "subtitle", "time": 5858.629, "timestamp": "01:37:38", "text": "そこに。さあ、行こう。私は話す。私は1つ手に入れる"}, {"type": "subtitle", "time": 5861.51, "timestamp": "01:37:41", "text": "殺す。あなたが話すと、彼は「いや、"}, {"type": "subtitle", "time": 5864.47, "timestamp": "01:37:44", "text": "それは素敵ですね。"}, {"type": "subtitle", "time": 5873.189, "timestamp": "01:37:53", "text": "彼を少し弱体化させるべきだと思う"}, {"type": "subtitle", "time": 5874.709, "timestamp": "01:37:54", "text": "少し。\""}]
[{"type": "subtitle", "time": 8114.149, "timestamp": "02:15:14", "text": "出来ますか"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "えっと、私をそこまで押し上げてくれませんか？あなたは"}, {"type": "subtitle", "time": 8125.189, "timestamp": "02:15:25", "text": "ほとんど。はい。"}, {"type": "subtitle", "time": 8128.709, "timestamp": "02:15:28", "text": "上空には何かありますか？上には何もありません。"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "側面はどうですか？"}, {"type": "subtitle", "time": 8136.55, "timestamp": "02:15:36", "text": "ここにも何もない。おお。"}, {"type": "subtitle", "time": 8140.95, "timestamp": "02:15:40", "text": "詐欺に遭った。そうだったっけ？何てことだ。"}, {"type": "subtitle", "time": 8153.91, "timestamp": "02:15:53", "text": "この薬は実に素晴らしい人生を送っている。私"}, {"type": "subtitle", "time": 8157.109, "timestamp": "02:15:57", "text": "破壊する。あなたは左側の薬を破壊しました。"}]
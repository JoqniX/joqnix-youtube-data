[{"type": "subtitle", "time": 2941.27, "timestamp": "00:49:01", "text": "ねえ、ちょっと手伝ってくれない？"}, {"type": "subtitle", "time": 2945.75, "timestamp": "00:49:05", "text": "この技術がまだ有効かどうかはわかりません"}, {"type": "subtitle", "time": 2947.51, "timestamp": "00:49:07", "text": "作品。"}, {"type": "subtitle", "time": 2949.75, "timestamp": "00:49:09", "text": "ああ、抱きしめまくるモンスター。の"}, {"type": "subtitle", "time": 2951.91, "timestamp": "00:49:11", "text": "ハグ好きのモンスター。"}, {"type": "subtitle", "time": 2953.91, "timestamp": "00:49:13", "text": "おお、"}, {"type": "subtitle", "time": 2957.19, "timestamp": "00:49:17", "text": "俺は死んだんだ。"}, {"type": "subtitle", "time": 2959.829, "timestamp": "00:49:19", "text": "なんてこった。"}, {"type": "subtitle", "time": 2962.63, "timestamp": "00:49:22", "text": "私はあの男が大嫌いだ。"}, {"type": "subtitle", "time": 2972.47, "timestamp": "00:49:32", "text": "もし私の立場を明かしたら誓います"}, {"type": "subtitle", "time": 2974.23, "timestamp": "00:49:34", "text": "離れて。"}, {"type": "subtitle", "time": 2977.109, "timestamp": "00:49:37", "text": "わかった。あなたは何処に行きましたか？どこで"}, {"type": "subtitle", "time": 2982.63, "timestamp": "00:49:42", "text": "ええ、あちらです。いいえ、それは"}, {"type": "subtitle", "time": 2991.43, "timestamp": "00:49:51", "text": "もう一つは、ああ、それだ。"}, {"type": "subtitle", "time": 2994.069, "timestamp": "00:49:54", "text": "すべてここにあります。いや、いや。えっと、後ろの方"}, {"type": "subtitle", "time": 2996.71, "timestamp": "00:49:56", "text": "あなた。"}]
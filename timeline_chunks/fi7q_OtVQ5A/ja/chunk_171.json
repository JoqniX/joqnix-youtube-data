[{"type": "subtitle", "time": 10261.03, "timestamp": "02:51:01", "text": "GTA。いや、やっぱりいいや。やめよう"}, {"type": "subtitle", "time": 10263.67, "timestamp": "02:51:03", "text": "今はクランクを回しているところだ。"}, {"type": "subtitle", "time": 10266.55, "timestamp": "02:51:06", "text": "GTAの話をしよう。それが我々の"}, {"type": "subtitle", "time": 10269.19, "timestamp": "02:51:09", "text": "ストリームはそうあるべきだった。"}, {"type": "subtitle", "time": 10272.309, "timestamp": "02:51:12", "text": "何てことだ。さあ行こう。"}, {"type": "subtitle", "time": 10274.389, "timestamp": "02:51:14", "text": "ついに。"}, {"type": "subtitle", "time": 10276.71, "timestamp": "02:51:16", "text": "GDA、"}, {"type": "subtitle", "time": 10280.309, "timestamp": "02:51:20", "text": "どうか働いてください。仕事をしてください。もしあなたが私に見せてくれるなら"}, {"type": "subtitle", "time": 10284.15, "timestamp": "02:51:24", "text": "もう一度ミスをしたら、お前を殺す。"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "私はあなたを殺さない。私が行きます。"}, {"type": "subtitle", "time": 10289.67, "timestamp": "02:51:29", "text": "ええ、私は昔クンカをプレイしていました"}, {"type": "subtitle", "time": 10291.59, "timestamp": "02:51:31", "text": "エイムボードと呼ばれる。どういうわけか、私は"}, {"type": "subtitle", "time": 10293.67, "timestamp": "02:51:33", "text": "え？って感じだった。"}, {"type": "subtitle", "time": 10295.91, "timestamp": "02:51:35", "text": "なぜ？私は普通の体育の人です"}, {"type": "subtitle", "time": 10297.99, "timestamp": "02:51:37", "text": "私はApexとValerantをプレイしています"}, {"type": "subtitle", "time": 10300.23, "timestamp": "02:51:40", "text": "すべて。"}, {"type": "subtitle", "time": 10308.23, "timestamp": "02:51:48", "text": "接続できません。いいえ、違います"}]
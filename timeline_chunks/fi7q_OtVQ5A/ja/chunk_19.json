[{"type": "subtitle", "time": 1140.15, "timestamp": "00:19:00", "text": "本当に、うちのスポーツマンは本当に身動きが取れない状態です。"}, {"type": "subtitle", "time": 1142.31, "timestamp": "00:19:02", "text": "私はただそこへ行くだけです。"}, {"type": "subtitle", "time": 1144.549, "timestamp": "00:19:04", "text": "ええ、この建物です。うん、たくさんあるよ"}, {"type": "subtitle", "time": 1146.15, "timestamp": "00:19:06", "text": "はい、私は行くつもりです。"}, {"type": "subtitle", "time": 1148.23, "timestamp": "00:19:08", "text": "そこへ来てください。大丈夫です。"}, {"type": "subtitle", "time": 1153.35, "timestamp": "00:19:13", "text": "Hは解雇された。私はそれが大嫌いです。イエス・キリスト。"}, {"type": "subtitle", "time": 1155.51, "timestamp": "00:19:15", "text": "私は好きではありません 私は好きではありません 私は好きではありません"}, {"type": "subtitle", "time": 1165.75, "timestamp": "00:19:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1169.669, "timestamp": "00:19:29", "text": "ああ、私のキルを横取りする奴だ。ああ、くそ"}, {"type": "subtitle", "time": 1172.15, "timestamp": "00:19:32", "text": "それ。なんてこった。なんてこった。私は今、死ぬのでしょうか？"}, {"type": "subtitle", "time": 1174.63, "timestamp": "00:19:34", "text": "イエス・キリスト。私たちの吸血鬼のやり方が好きです"}, {"type": "subtitle", "time": 1181.75, "timestamp": "00:19:41", "text": "弾薬がない。弾薬がない。私"}, {"type": "subtitle", "time": 1184.549, "timestamp": "00:19:44", "text": "弾薬はいらない。"}, {"type": "subtitle", "time": 1187.59, "timestamp": "00:19:47", "text": "ああ、君"}, {"type": "subtitle", "time": 1189.11, "timestamp": "00:19:49", "text": "ない。"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "あなたをとても誇りに思います。"}, {"type": "subtitle", "time": 1194.15, "timestamp": "00:19:54", "text": "敵と交戦する。私はただ"}, {"type": "subtitle", "time": 1197.43, "timestamp": "00:19:57", "text": "ひどい試合だった。そして"}]
[{"type": "subtitle", "time": 18433.59, "timestamp": "05:07:13", "text": "うん。"}, {"type": "subtitle", "time": 18437.03, "timestamp": "05:07:17", "text": "元気？次は？はぁ？私たちはただ"}, {"type": "subtitle", "time": 18438.15, "timestamp": "05:07:18", "text": "誰かが殺してくれるのを待つつもりだ"}, {"type": "subtitle", "time": 18439.59, "timestamp": "05:07:19", "text": "私たちか、それともこれが来るまで待つのか"}, {"type": "subtitle", "time": 18443.27, "timestamp": "05:07:23", "text": "あの野郎が寝返ったのか？ラグってますか？いいえ。"}, {"type": "subtitle", "time": 18445.83, "timestamp": "05:07:25", "text": "あなたもそれを知っているはずだ。"}, {"type": "subtitle", "time": 18448.31, "timestamp": "05:07:28", "text": "ラグは発生していません。分かりますよ。私たちはただ"}, {"type": "subtitle", "time": 18450.15, "timestamp": "05:07:30", "text": "この汚物を片付け始めた。私たちは"}, {"type": "subtitle", "time": 18451.75, "timestamp": "05:07:31", "text": "たくさんの古い友人が、"}, {"type": "subtitle", "time": 18454.55, "timestamp": "05:07:34", "text": "再教育された。友達がたくさんいる。つまり、"}, {"type": "subtitle", "time": 18457.35, "timestamp": "05:07:37", "text": "事態は非常に厄介になる可能性がある。いいえ、私たちは"}, {"type": "subtitle", "time": 18460.868, "timestamp": "05:07:40", "text": "ちょっとうるさい人たちを黙らせなきゃ。"}, {"type": "subtitle", "time": 18463.27, "timestamp": "05:07:43", "text": "そうねぇ。スティーブがいる。ああ、君はいい人だね"}, {"type": "subtitle", "time": 18466.948, "timestamp": "05:07:46", "text": "今すぐ。彼には生きていてほしい。"}, {"type": "subtitle", "time": 18469.35, "timestamp": "05:07:49", "text": "だからその後は誰も俺たちに手出しできない。何"}, {"type": "subtitle", "time": 18471.27, "timestamp": "05:07:51", "text": "あの部族のクソ野郎のことか？ 1つ"}, {"type": "subtitle", "time": 18473.35, "timestamp": "05:07:53", "text": "あなたたち二人の男の子が付き合っていると思っている。くそっ。"}, {"type": "subtitle", "time": 18475.11, "timestamp": "05:07:55", "text": "彼は必ず戻ってくるって分かってるでしょ。うん、"}, {"type": "subtitle", "time": 18476.868, "timestamp": "05:07:56", "text": "そういうこともある。さて、"}, {"type": "subtitle", "time": 18479.51, "timestamp": "05:07:59", "text": "アラームを設定しましたか？ストレッチ。あなたはしたい"}]
[{"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "ああ、なんてことだ。何でも。本当に？ニース。おお"}, {"type": "subtitle", "time": 5064.31, "timestamp": "01:24:24", "text": "君はそれを持っていると思っていたよ。わかった。えっと、"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "そうすべきかどうか分かりません。"}, {"type": "subtitle", "time": 5070.55, "timestamp": "01:24:30", "text": "よし、彼らが10を振り返った瞬間"}, {"type": "subtitle", "time": 5073.59, "timestamp": "01:24:33", "text": "ひっくり返して、取り出す"}, {"type": "subtitle", "time": 5075.669, "timestamp": "01:24:35", "text": "その後"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "R. ああ、わかった。彼らはもういなくなってしまったようだ。"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "大丈夫ですよ。"}, {"type": "subtitle", "time": 5085.669, "timestamp": "01:24:45", "text": "だから、彼らが後ろに来る瞬間は"}, {"type": "subtitle", "time": 5088.629, "timestamp": "01:24:48", "text": "それを引き起こすのに最適な場所。"}, {"type": "subtitle", "time": 5091.11, "timestamp": "01:24:51", "text": "ああ、彼らは遅れている、まるで"}, {"type": "subtitle", "time": 5093.35, "timestamp": "01:24:53", "text": "彼らの後ろに。"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "彼らは賢くない"}]
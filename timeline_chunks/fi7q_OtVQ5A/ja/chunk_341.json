[{"type": "subtitle", "time": 20485.35, "timestamp": "05:41:25", "text": "えっと、どうやって終わらせるかはわかってるんだけど"}, {"type": "subtitle", "time": 20487.35, "timestamp": "05:41:27", "text": "話"}, {"type": "subtitle", "time": 20489.19, "timestamp": "05:41:29", "text": "そしてインストールします。うん、そうするつもりだよ"}, {"type": "subtitle", "time": 20491.75, "timestamp": "05:41:31", "text": "もう少ししたら。完全に終わらせたい"}, {"type": "subtitle", "time": 20510.07, "timestamp": "05:41:50", "text": "待って、私は間違ってる、間違った方向に行ってる、"}]
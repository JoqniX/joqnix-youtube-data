[{"type": "subtitle", "time": 2642.39, "timestamp": "00:44:02", "text": "わかった。参加すべきか、それとも"}, {"type": "subtitle", "time": 2644.95, "timestamp": "00:44:04", "text": "1つ？今、やり直しているところです。やり直しています"}, {"type": "subtitle", "time": 2647.349, "timestamp": "00:44:07", "text": "また一人。"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "ああ、私も参加しますよ。持続する。はい。私は"}, {"type": "subtitle", "time": 2654.23, "timestamp": "00:44:14", "text": "新しい部屋を作っているところです。"}, {"type": "subtitle", "time": 2667.99, "timestamp": "00:44:27", "text": "わかった。"}, {"type": "subtitle", "time": 2671.99, "timestamp": "00:44:31", "text": "何？ええ、ただ、彼女がやったんです。わかった。"}, {"type": "subtitle", "time": 2678.55, "timestamp": "00:44:38", "text": "[音楽]"}, {"type": "subtitle", "time": 2681.67, "timestamp": "00:44:41", "text": "パスワードシステムは良かった。"}, {"type": "subtitle", "time": 2684.95, "timestamp": "00:44:44", "text": "ええ、周りの人から遮断されます。"}, {"type": "subtitle", "time": 2687.99, "timestamp": "00:44:47", "text": "ああ、そうそう。わーい。"}, {"type": "subtitle", "time": 2692.39, "timestamp": "00:44:52", "text": "ああ、音声を2倍にするのを忘れてた。"}]
[{"type": "subtitle", "time": 16443.83, "timestamp": "04:34:03", "text": "レスター、犬、いや、男、話をする必要がある。私は手に入れた"}, {"type": "subtitle", "time": 16446.23, "timestamp": "04:34:06", "text": "君の助けが必要な問題があるんだ。"}, {"type": "subtitle", "time": 16448.869, "timestamp": "04:34:08", "text": "いや、もうどうでもいいよ。私たちは皆"}, {"type": "subtitle", "time": 16451.109, "timestamp": "04:34:11", "text": "あなたが私たちを助けてくださる問題です。落ち着け。"}, {"type": "subtitle", "time": 16453.83, "timestamp": "04:34:13", "text": "よし。私の家に来てください。よし。"}, {"type": "subtitle", "time": 16475.429, "timestamp": "04:34:35", "text": "いいえ。泣きたくない。私は欲しい"}, {"type": "subtitle", "time": 16478.629, "timestamp": "04:34:38", "text": "ハッピーエンド。"}]
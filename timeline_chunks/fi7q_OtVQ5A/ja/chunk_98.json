[{"type": "subtitle", "time": 5881.83, "timestamp": "01:38:01", "text": "えっ、今？"}, {"type": "subtitle", "time": 5886.07, "timestamp": "01:38:06", "text": "はい、その通りです。でも、ああ、なんてことだ。"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "どうやって？"}, {"type": "subtitle", "time": 5891.27, "timestamp": "01:38:11", "text": "私は走らなかった。"}, {"type": "subtitle", "time": 5900.629, "timestamp": "01:38:20", "text": "ああ、彼はそれを感じ取っているんだ。彼ならできると思う"}, {"type": "subtitle", "time": 5903.35, "timestamp": "01:38:23", "text": "話しているときや近づきすぎたときに聞こえます"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "彼にとって。"}, {"type": "subtitle", "time": 5912.47, "timestamp": "01:38:32", "text": "ああ、それが新商品ですね。銃を撃った。"}, {"type": "subtitle", "time": 5914.629, "timestamp": "01:38:34", "text": "ファンシー。あ、待って。後ろにあるのは何？"}, {"type": "subtitle", "time": 5918.229, "timestamp": "01:38:38", "text": "あなた？それは、それが"}, {"type": "subtitle", "time": 5920.87, "timestamp": "01:38:40", "text": "ポッキーかレコード。それは"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "渋滞していますか？"}]
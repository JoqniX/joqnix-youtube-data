[{"type": "subtitle", "time": 10562.63, "timestamp": "02:56:02", "text": "だから、待っていてください。これ、どこかで聞いたことがあるような？"}, {"type": "subtitle", "time": 10564.55, "timestamp": "02:56:04", "text": "私が考えているのは、コミットメントのことです。"}, {"type": "subtitle", "time": 10566.55, "timestamp": "02:56:06", "text": "到着したら、そこからは得られないでしょう"}, {"type": "subtitle", "time": 10569.67, "timestamp": "02:56:09", "text": "切断された状態で開始します。"}, {"type": "subtitle", "time": 10572.23, "timestamp": "02:56:12", "text": "ああ、リックロールだ。"}, {"type": "subtitle", "time": 10575.429, "timestamp": "02:56:15", "text": "リックロール。ああ、君たち。"}, {"type": "subtitle", "time": 10577.429, "timestamp": "02:56:17", "text": "コーラ、"}, {"type": "subtitle", "time": 10579.91, "timestamp": "02:56:19", "text": "忘れた。私は決して"}, {"type": "subtitle", "time": 10582.95, "timestamp": "02:56:22", "text": "あなたを諦めない"}, {"type": "subtitle", "time": 10585.269, "timestamp": "02:56:25", "text": "そして決してあなたを失望させません"}, {"type": "subtitle", "time": 10588.309, "timestamp": "02:56:28", "text": "その曲の歌詞。"}, {"type": "subtitle", "time": 10591.75, "timestamp": "02:56:31", "text": "理解できませんでした。"}, {"type": "subtitle", "time": 10595.03, "timestamp": "02:56:35", "text": "あの曲について知ってるなら"}, {"type": "subtitle", "time": 10597.59, "timestamp": "02:56:37", "text": "誰かが本当にそれを望んでいる"}, {"type": "subtitle", "time": 10600.07, "timestamp": "02:56:40", "text": "こう言ってください"}, {"type": "subtitle", "time": 10602.95, "timestamp": "02:56:42", "text": "私は決してあなたを許さない、決してあなたを許さない"}, {"type": "subtitle", "time": 10604.87, "timestamp": "02:56:44", "text": "下"}, {"type": "subtitle", "time": 10608.23, "timestamp": "02:56:48", "text": "えっと、あるいはあなたを諦めたりとか。あなたはできません"}, {"type": "subtitle", "time": 10610.95, "timestamp": "02:56:50", "text": "たとえそれを口にしても、相手はああと思うだろう"}, {"type": "subtitle", "time": 10614.79, "timestamp": "02:56:54", "text": "この男は私のこのこの男は"}, {"type": "subtitle", "time": 10617.75, "timestamp": "02:56:57", "text": "私を巻き戻すつもりです。もしあなたが言いたいなら"}]
[{"type": "subtitle", "time": 15068.79, "timestamp": "04:11:08", "text": "彼もグルだ。はぁ？起きる。おい、起きろ。"}, {"type": "subtitle", "time": 15070.309, "timestamp": "04:11:10", "text": "彼に、"}, {"type": "subtitle", "time": 15072.389, "timestamp": "04:11:12", "text": "すでにニュースが出ている。この全てはあなたの"}, {"type": "subtitle", "time": 15073.99, "timestamp": "04:11:13", "text": "アイデア。"}, {"type": "subtitle", "time": 15076.389, "timestamp": "04:11:16", "text": "うん。ええ、分かります。一言も発しない。"}, {"type": "subtitle", "time": 15078.95, "timestamp": "04:11:18", "text": "その通り。うん。私はいつもジャンプしていた。私 私"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "何も見ていない。クソくらえ"}, {"type": "subtitle", "time": 15083.67, "timestamp": "04:11:23", "text": "あなたのあのぐにゃぐにゃした少年のように柔らかい"}, {"type": "subtitle", "time": 15085.59, "timestamp": "04:11:25", "text": "ズボン。離婚はすぐには起こらないだろう"}, {"type": "subtitle", "time": 15088.63, "timestamp": "04:11:28", "text": "十分。クソッ"}, {"type": "subtitle", "time": 15090.55, "timestamp": "04:11:30", "text": "まずは仕事から始めよう。後で選んでくれよ。全て"}, {"type": "subtitle", "time": 15092.15, "timestamp": "04:11:32", "text": "右。"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 15096.18, "timestamp": "04:11:36", "text": "傭兵の母親。"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "[音楽]"}, {"type": "subtitle", "time": 15100.27, "timestamp": "04:11:40", "text": "さあ、教会の時間だ。"}]
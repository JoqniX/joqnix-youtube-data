[{"type": "subtitle", "time": 11702.87, "timestamp": "03:15:02", "text": "えっと、"}, {"type": "subtitle", "time": 11705.59, "timestamp": "03:15:05", "text": "トーチカのある丘。"}, {"type": "subtitle", "time": 11714.63, "timestamp": "03:15:14", "text": "多層駐車場の上に。"}, {"type": "subtitle", "time": 11725.19, "timestamp": "03:15:25", "text": "何てことだ。わかった。それを殺すためだ。わかった。"}, {"type": "subtitle", "time": 11729.11, "timestamp": "03:15:29", "text": "フィルボックスヒル。フィルボックスヒル。フィルボックス"}, {"type": "subtitle", "time": 11734.79, "timestamp": "03:15:34", "text": "丘。埋める。ボックスに記入してください。わかった。わかった。"}, {"type": "subtitle", "time": 11737.269, "timestamp": "03:15:37", "text": "入力欄。"}, {"type": "subtitle", "time": 11740.469, "timestamp": "03:15:40", "text": "フィルボックス・ヒル。"}, {"type": "subtitle", "time": 11742.87, "timestamp": "03:15:42", "text": "どこですか？"}, {"type": "subtitle", "time": 11747.19, "timestamp": "03:15:47", "text": "今、それを見ているところです。終わりました。"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "うん。"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "私はこの件からあまりにもかけ離れすぎているのだろうか？ええ、私は"}, {"type": "subtitle", "time": 11758.79, "timestamp": "03:15:58", "text": "遠すぎる。"}]
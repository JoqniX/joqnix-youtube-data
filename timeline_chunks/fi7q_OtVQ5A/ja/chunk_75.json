[{"type": "subtitle", "time": 4500.47, "timestamp": "01:15:00", "text": "スクロールバックのようにスクロールします。お見せします"}, {"type": "subtitle", "time": 4503.669, "timestamp": "01:15:03", "text": "次回。"}, {"type": "subtitle", "time": 4505.91, "timestamp": "01:15:05", "text": "ええ、あなたはここを去る必要があるんですよね？おお、"}, {"type": "subtitle", "time": 4508.12, "timestamp": "01:15:08", "text": "うん。私たちはここを離れなければならない。"}, {"type": "subtitle", "time": 4511.189, "timestamp": "01:15:11", "text": "[音楽]"}, {"type": "subtitle", "time": 4513.03, "timestamp": "01:15:13", "text": "よし。つまり、３人になるということだ。"}, {"type": "subtitle", "time": 4515.91, "timestamp": "01:15:15", "text": "抽出ポイント。だから明らかに私たちは"}, {"type": "subtitle", "time": 4519.83, "timestamp": "01:15:19", "text": "最初の方でやって、"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "遠く離れた場所に行くのが一番良い"}, {"type": "subtitle", "time": 4532.55, "timestamp": "01:15:32", "text": "わかった。私は"}, {"type": "subtitle", "time": 4548.87, "timestamp": "01:15:48", "text": "しかし、それでも彼らは健康なものを取り除いてしまう"}]
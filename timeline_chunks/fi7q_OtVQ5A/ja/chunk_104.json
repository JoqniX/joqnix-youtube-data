[{"type": "subtitle", "time": 6244.149, "timestamp": "01:44:04", "text": "もうそれはできません。"}, {"type": "subtitle", "time": 6247.189, "timestamp": "01:44:07", "text": "しかし、それはできません。いいえ。私は、"}, {"type": "subtitle", "time": 6250.79, "timestamp": "01:44:10", "text": "軌道を調整する"}, {"type": "subtitle", "time": 6266.55, "timestamp": "01:44:26", "text": "敵を掴んで拘束することはできません"}, {"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "もう。それはまるで"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "今は赤いバーが表示されています。そして、あなたは"}, {"type": "subtitle", "time": 6276.229, "timestamp": "01:44:36", "text": "気絶させられる前に行け。"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "頭。"}, {"type": "subtitle", "time": 6282.07, "timestamp": "01:44:42", "text": "ああ、誰かが私の家のドアをノックしている。"}]
[{"type": "subtitle", "time": 20100.23, "timestamp": "05:35:00", "text": "開始まで数分。"}, {"type": "subtitle", "time": 20114.47, "timestamp": "05:35:14", "text": "これはオフィスからのものですか"}, {"type": "subtitle", "time": 20118.15, "timestamp": "05:35:18", "text": "アイシャ先生？お客様へのお知らせH で始まる言葉は失敗します"}, {"type": "subtitle", "time": 20128.628, "timestamp": "05:35:28", "text": "顧客情報は極秘扱いではありません。何ですか"}, {"type": "subtitle", "time": 20130.788, "timestamp": "05:35:30", "text": "私を見捨てる？彼らは絶対にできない"}, {"type": "subtitle", "time": 20132.548, "timestamp": "05:35:32", "text": "愛において取引の決断を下すが、"}, {"type": "subtitle", "time": 20135.19, "timestamp": "05:35:35", "text": "ひどい決断が下される理由"}, {"type": "subtitle", "time": 20139.19, "timestamp": "05:35:39", "text": "財政的に正しい"}, {"type": "subtitle", "time": 20140.948, "timestamp": "05:35:40", "text": "無責任に"}, {"type": "subtitle", "time": 20142.948, "timestamp": "05:35:42", "text": "自分自身の物事は、"}, {"type": "subtitle", "time": 20145.75, "timestamp": "05:35:45", "text": "残念ながら、性的に自覚しているわけではない"}, {"type": "subtitle", "time": 20148.628, "timestamp": "05:35:48", "text": "他のケースではクレイジーな家族を愛している"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "これは、回避するための第一歩だと思います。"}, {"type": "subtitle", "time": 20154.628, "timestamp": "05:35:54", "text": "ほとんど復讐心に満ちた憶測"}, {"type": "subtitle", "time": 20157.99, "timestamp": "05:35:57", "text": "このことを誇りに思って話す人が泣く"}]
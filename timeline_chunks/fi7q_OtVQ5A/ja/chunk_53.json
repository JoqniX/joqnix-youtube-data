[{"type": "subtitle", "time": 3187.91, "timestamp": "00:53:07", "text": "私はアクセスポイントを2つ持っています。"}, {"type": "subtitle", "time": 3192.39, "timestamp": "00:53:12", "text": "アヒルちゃんが本当にうざい。"}, {"type": "subtitle", "time": 3197.43, "timestamp": "00:53:17", "text": "はい、大丈夫です。おお、"}, {"type": "subtitle", "time": 3201.19, "timestamp": "00:53:21", "text": "待って。中規模または中規模は使用できません。"}, {"type": "subtitle", "time": 3204.549, "timestamp": "00:53:24", "text": "小さな物体を殺したり"}, {"type": "subtitle", "time": 3207.19, "timestamp": "00:53:27", "text": "彼。ああ、唯一の問題は彼らが"}, {"type": "subtitle", "time": 3209.99, "timestamp": "00:53:29", "text": "彼らはそれを少し変えた。君は"}, {"type": "subtitle", "time": 3213.829, "timestamp": "00:53:33", "text": "今はメーターみたいに、"}, {"type": "subtitle", "time": 3216.15, "timestamp": "00:53:36", "text": "一定期間だけそれを行う"}, {"type": "subtitle", "time": 3218.23, "timestamp": "00:53:38", "text": "一定期間。"}, {"type": "subtitle", "time": 3220.549, "timestamp": "00:53:40", "text": "はい、うまくいきました。でも、あなたほどではない"}, {"type": "subtitle", "time": 3224.39, "timestamp": "00:53:44", "text": "考える。ああ。"}, {"type": "subtitle", "time": 3231.75, "timestamp": "00:53:51", "text": "自由。"}]
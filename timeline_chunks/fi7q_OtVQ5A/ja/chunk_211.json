[{"type": "subtitle", "time": 12664.87, "timestamp": "03:31:04", "text": "レギオンスクエアのミッションエリア。"}, {"type": "subtitle", "time": 12671.99, "timestamp": "03:31:11", "text": "ここはミッション・ロウです。私はこれを信じます"}, {"type": "subtitle", "time": 12674.469, "timestamp": "03:31:14", "text": "軍団広場です。いいえ、ミッションロウは"}, {"type": "subtitle", "time": 12676.63, "timestamp": "03:31:16", "text": "なれ"}, {"type": "subtitle", "time": 12680.469, "timestamp": "03:31:20", "text": "ボックスの凡例。待って、伝説の広場ミッション"}, {"type": "subtitle", "time": 12683.51, "timestamp": "03:31:23", "text": "生。ミッションロウ。"}]
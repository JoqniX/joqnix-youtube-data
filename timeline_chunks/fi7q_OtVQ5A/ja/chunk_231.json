[{"type": "subtitle", "time": 13861.429, "timestamp": "03:51:01", "text": "私はそうは思わない、だから私は使わないと思う"}, {"type": "subtitle", "time": 13864.15, "timestamp": "03:51:04", "text": "兄弟、それくらいだよ。"}, {"type": "subtitle", "time": 13866.389, "timestamp": "03:51:06", "text": "何てことだ。俺の仲間と戦いたいのか？"}, {"type": "subtitle", "time": 13869.03, "timestamp": "03:51:09", "text": "はぁ？戦いたいのか？はぁ？"}, {"type": "subtitle", "time": 13871.189, "timestamp": "03:51:11", "text": "戦いたいのか？"}, {"type": "subtitle", "time": 13880.95, "timestamp": "03:51:20", "text": "誰が倒れたの？はぁ？誰が亡くなったのですか？はぁ？はぁ？"}, {"type": "subtitle", "time": 13883.59, "timestamp": "03:51:23", "text": "車のドアへ。"}, {"type": "subtitle", "time": 13900.07, "timestamp": "03:51:40", "text": "トラックをここから出して。 O."}, {"type": "subtitle", "time": 13909.99, "timestamp": "03:51:49", "text": "つまり、Dは疑問符です。そうします"}, {"type": "subtitle", "time": 13911.83, "timestamp": "03:51:51", "text": "D 疑問符、そして私たちがする前に"}]
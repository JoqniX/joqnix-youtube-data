[{"type": "subtitle", "time": 13473.189, "timestamp": "03:44:33", "text": "今から警察に通報する。何てことだ。あなたは"}, {"type": "subtitle", "time": 13474.55, "timestamp": "03:44:34", "text": "冗談でしょ？私をからかってるの？あなたは"}, {"type": "subtitle", "time": 13477.269, "timestamp": "03:44:37", "text": "冗談だろ、兄弟？"}, {"type": "subtitle", "time": 13480.15, "timestamp": "03:44:40", "text": "私をからかってるの？"}, {"type": "subtitle", "time": 13482.229, "timestamp": "03:44:42", "text": "正直に言うと、時々私は"}, {"type": "subtitle", "time": 13484.389, "timestamp": "03:44:44", "text": "ブラジャーは使わない方がいいと思う、"}, {"type": "subtitle", "time": 13487.91, "timestamp": "03:44:47", "text": "それはある意味、失礼なことですね。"}, {"type": "subtitle", "time": 13489.75, "timestamp": "03:44:49", "text": "まあ、何が起こるかわからないからね。人々は"}]
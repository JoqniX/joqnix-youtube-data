[{"type": "subtitle", "time": 14527.67, "timestamp": "04:02:07", "text": "ネオモードは最も柔らかく、"}, {"type": "subtitle", "time": 14541.83, "timestamp": "04:02:21", "text": "はい、あなたはやり遂げました。"}, {"type": "subtitle", "time": 14549.03, "timestamp": "04:02:29", "text": "待機する。"}, {"type": "subtitle", "time": 14551.59, "timestamp": "04:02:31", "text": "ねえ、半分くらいは君が来ると思ってたんだけど"}, {"type": "subtitle", "time": 14553.64, "timestamp": "04:02:33", "text": "1分前。"}, {"type": "subtitle", "time": 14564.55, "timestamp": "04:02:44", "text": "彼は7を持っていません。待ってください。セブン"}, {"type": "subtitle", "time": 14570.63, "timestamp": "04:02:50", "text": "うんうん。"}, {"type": "subtitle", "time": 14574.71, "timestamp": "04:02:54", "text": "つまり、それは主ではなく、代償なのだ。"}]
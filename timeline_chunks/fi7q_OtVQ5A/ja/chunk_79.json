[{"type": "subtitle", "time": 4748.39, "timestamp": "01:19:08", "text": "スタミナも追加しておこう。なぜだめですか？"}, {"type": "subtitle", "time": 4762.709, "timestamp": "01:19:22", "text": "私たちはそれを買って、"}, {"type": "subtitle", "time": 4765.43, "timestamp": "01:19:25", "text": "休む。それはあなた次第です。"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "おお。私には理解できません。わかった。次回。"}, {"type": "subtitle", "time": 4772.47, "timestamp": "01:19:32", "text": "結晶の値段はいくらですか？"}, {"type": "subtitle", "time": 4775.99, "timestamp": "01:19:35", "text": "9 12"}, {"type": "subtitle", "time": 4779.75, "timestamp": "01:19:39", "text": "そうする必要はない。少し値段が高いですね。"}, {"type": "subtitle", "time": 4782.07, "timestamp": "01:19:42", "text": "うん。"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "よし。あなたの"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "あなたが欲しかった銃？がある。さあ、始めよう"}, {"type": "subtitle", "time": 4790.229, "timestamp": "01:19:50", "text": "それ。"}, {"type": "subtitle", "time": 4796.55, "timestamp": "01:19:56", "text": "余分な"}]
[{"type": "subtitle", "time": 1387.669, "timestamp": "00:23:07", "text": "誰かが私を殺そうとしている。私はWを持っています。"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "ああ、ここに引っ越しさせてください。"}, {"type": "subtitle", "time": 1393.19, "timestamp": "00:23:13", "text": "えっと、私はどこへ行くんですか？ああ、なんてこった。"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "あぁ、あぁ。おお。おお。おお。仕事の喪失。大丈夫ですか？"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "大丈夫ですか？大丈夫ですか？うん。私はここにいます。何"}, {"type": "subtitle", "time": 1401.11, "timestamp": "00:23:21", "text": "何が起こったのか？私がそちらへ行きます。大丈夫ですか？"}, {"type": "subtitle", "time": 1404.07, "timestamp": "00:23:24", "text": "もう大丈夫ですか？"}, {"type": "subtitle", "time": 1407.51, "timestamp": "00:23:27", "text": "あなたは生きて帰ってきた。"}, {"type": "subtitle", "time": 1415.11, "timestamp": "00:23:35", "text": "大丈夫。ジャックはなぜ？なぜ私は彼と別れるのか"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "一人で？大丈夫。大丈夫。私は近くにいます"}, {"type": "subtitle", "time": 1419.51, "timestamp": "00:23:39", "text": "あなた。"}, {"type": "subtitle", "time": 1422.87, "timestamp": "00:23:42", "text": "ウェインはどこ？ああ、彼も近くにいるよ。"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "彼はなぜ死んだのか？なぜ彼は外で死んでいるのか"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "今から君を助けに行くよ。"}, {"type": "subtitle", "time": 1438.95, "timestamp": "00:23:58", "text": "私はプロの試合をするつもりです"}]
[{"type": "subtitle", "time": 5583.43, "timestamp": "01:33:03", "text": "私は日陰を手に入れた"}, {"type": "subtitle", "time": 5586.229, "timestamp": "01:33:06", "text": "コーナー。"}, {"type": "subtitle", "time": 5597.75, "timestamp": "01:33:17", "text": "[音楽]"}, {"type": "subtitle", "time": 5600.47, "timestamp": "01:33:20", "text": "ああ。"}, {"type": "subtitle", "time": 5610.39, "timestamp": "01:33:30", "text": "そうそう。えっと、どれくらい時間がありますか？"}, {"type": "subtitle", "time": 5619.03, "timestamp": "01:33:39", "text": "あと数時間なら遊べるよ。"}, {"type": "subtitle", "time": 5623.669, "timestamp": "01:33:43", "text": "よし、あと1時間プレイしよう。ああ、神様。私たちは"}, {"type": "subtitle", "time": 5625.51, "timestamp": "01:33:45", "text": "ご希望であれば、12で止めても構いません。だから、"}, {"type": "subtitle", "time": 5629.11, "timestamp": "01:33:49", "text": "2時間与えます。 M 私はすでに支払いました"}, {"type": "subtitle", "time": 5631.669, "timestamp": "01:33:51", "text": "私たちは既に時間分の料金を支払ったと思います。"}, {"type": "subtitle", "time": 5634.55, "timestamp": "01:33:54", "text": "どのぐらいの間？"}, {"type": "subtitle", "time": 5637.59, "timestamp": "01:33:57", "text": "私は24時間戦闘配信をします。知っている。"}]
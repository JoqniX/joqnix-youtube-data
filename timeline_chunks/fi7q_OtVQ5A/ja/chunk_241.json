[{"type": "subtitle", "time": 14465.59, "timestamp": "04:01:05", "text": "車から降りてください。外に出る"}, {"type": "subtitle", "time": 14468.71, "timestamp": "04:01:08", "text": "車両。車から降りてください。"}, {"type": "subtitle", "time": 14471.189, "timestamp": "04:01:11", "text": "こんなくだらないことで死にたくないだろう。"}, {"type": "subtitle", "time": 14475.59, "timestamp": "04:01:15", "text": "くそっ。ああ、くそ。次は君の番だ。"}, {"type": "subtitle", "time": 14479.03, "timestamp": "04:01:19", "text": "さっさと動けよ。来て。動く。"}, {"type": "subtitle", "time": 14489.429, "timestamp": "04:01:29", "text": "TPSが始まるまであと1分ある"}, {"type": "subtitle", "time": 14491.67, "timestamp": "04:01:31", "text": "読解異常。そして虐殺を始めよう"}, {"type": "subtitle", "time": 14493.51, "timestamp": "04:01:33", "text": "お入りください。"}, {"type": "subtitle", "time": 14495.269, "timestamp": "04:01:35", "text": "これです。いや。やばい。お願いです。"}, {"type": "subtitle", "time": 14497.11, "timestamp": "04:01:37", "text": "あなたが何をしようとも。うん。クソじゃない。私たちには必要だ"}, {"type": "subtitle", "time": 14500.07, "timestamp": "04:01:40", "text": "あなた。あなたの名前は何ですか？ケイシー。ケイシー。得る"}, {"type": "subtitle", "time": 14502.15, "timestamp": "04:01:42", "text": "クソトラックの中で。さあ行こう。行く。行く。"}, {"type": "subtitle", "time": 14509.11, "timestamp": "04:01:49", "text": "泣き言はやめろ。"}, {"type": "subtitle", "time": 14512.07, "timestamp": "04:01:52", "text": "次の目的地は、ユニオン・デポジトリーです。"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "ネコモードを"}]
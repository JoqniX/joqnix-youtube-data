[{"type": "subtitle", "time": 12300.55, "timestamp": "03:25:00", "text": "どれでも３つで構いません。これらがそれらであるならば"}, {"type": "subtitle", "time": 12303.03, "timestamp": "03:25:03", "text": "それらを手に入れる"}, {"type": "subtitle", "time": 12305.19, "timestamp": "03:25:05", "text": "で。"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "それはテンプラホテルの南東にあるホテルです"}, {"type": "subtitle", "time": 12324.63, "timestamp": "03:25:24", "text": "ミッション・ロウ。よし、ミッション・ロウだ。"}, {"type": "subtitle", "time": 12327.59, "timestamp": "03:25:27", "text": "レギオンの南東にあるテンプラーホテル"}, {"type": "subtitle", "time": 12331.67, "timestamp": "03:25:31", "text": "四角。レギオン広場。"}, {"type": "subtitle", "time": 12359.67, "timestamp": "03:25:59", "text": "箱。レギオン広場。魔術"}]
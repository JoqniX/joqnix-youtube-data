[{"type": "subtitle", "time": 7921.589, "timestamp": "02:12:01", "text": "外。"}, {"type": "subtitle", "time": 7924.39, "timestamp": "02:12:04", "text": "それは不可能だ。"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "いや、待って。やってみて。やってみて。私が試してみます。"}, {"type": "subtitle", "time": 7943.669, "timestamp": "02:12:23", "text": "ああ、それはできないよ。いいえ。"}, {"type": "subtitle", "time": 7958.31, "timestamp": "02:12:38", "text": "近い。"}, {"type": "subtitle", "time": 7977.669, "timestamp": "02:12:57", "text": "わあ、すごい。わかった。"}, {"type": "subtitle", "time": 7979.91, "timestamp": "02:12:59", "text": "二人の大きな男の子。"}]
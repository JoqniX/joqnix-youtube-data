[{"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "幸せでしょ？ポグポグ、そう、そう。"}, {"type": "subtitle", "time": 366.629, "timestamp": "00:06:06", "text": "すごいとか何とか"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "その線に沿って。到着。はい、私は"}, {"type": "subtitle", "time": 371.99, "timestamp": "00:06:11", "text": "人々をハッキングする。だから、本当にありがとう"}, {"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "多くの。近くにたくさんのプレイヤーがいます。私"}, {"type": "subtitle", "time": 376.79, "timestamp": "00:06:16", "text": "その男は"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "あなた。大丈夫ですか？あなたは素晴らしいです。うん。"}, {"type": "subtitle", "time": 389.749, "timestamp": "00:06:29", "text": "素晴らしい活躍ぶりです。死なないで。わかった。えっと"}, {"type": "subtitle", "time": 393.029, "timestamp": "00:06:33", "text": "了解、了解。"}, {"type": "subtitle", "time": 394.71, "timestamp": "00:06:34", "text": "それが私があなたに伝えられる唯一のアドバイスです。"}, {"type": "subtitle", "time": 396.95, "timestamp": "00:06:36", "text": "死ぬな。もしそうしたら、私はとても"}, {"type": "subtitle", "time": 400.15, "timestamp": "00:06:40", "text": "あなたに腹を立てています。空挺降下が来る。おお"}, {"type": "subtitle", "time": 407.749, "timestamp": "00:06:47", "text": "何？彼はどこにいますか？私はしたい、私はしたくない"}, {"type": "subtitle", "time": 409.59000000000003, "timestamp": "00:06:49", "text": "知る。彼はただ私たちの周りを回っているだけだ。いいえ、"}, {"type": "subtitle", "time": 411.99, "timestamp": "00:06:51", "text": "いや、彼はそこにいるよ。"}, {"type": "subtitle", "time": 414.39, "timestamp": "00:06:54", "text": "彼はプロの試合をしている"}, {"type": "subtitle", "time": 418.23, "timestamp": "00:06:58", "text": "まさにそこで操縦する。そう、そうですね。"}]
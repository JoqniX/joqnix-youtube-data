[{"type": "subtitle", "time": 782.949, "timestamp": "00:13:02", "text": "言いたいことが分かりますか？つまり、私は用を足したいんです。"}, {"type": "subtitle", "time": 785.19, "timestamp": "00:13:05", "text": "はい、どれくらいの間かわかりませんが、しばらく留守にします"}, {"type": "subtitle", "time": 786.629, "timestamp": "00:13:06", "text": "2分くらいかな。私は大丈夫"}, {"type": "subtitle", "time": 801.03, "timestamp": "00:13:21", "text": "ええ、皆さんこんにちは"}, {"type": "subtitle", "time": 812.87, "timestamp": "00:13:32", "text": "うん。リー、今日はどんな一日だった？はぁ？どうでしたか？"}, {"type": "subtitle", "time": 839.829, "timestamp": "00:13:59", "text": "わかった。えっと、もしそれが何なのか教えてください"}]
[{"type": "subtitle", "time": 10682.87, "timestamp": "02:58:02", "text": "なぜVPNを使わなければならなかったのか、私には分かりません。"}, {"type": "subtitle", "time": 10687.59, "timestamp": "02:58:07", "text": "VPNがなかったらどうなるか想像してみて。"}, {"type": "subtitle", "time": 10695.67, "timestamp": "02:58:15", "text": "私は今マインクラフトを作ったのか"}, {"type": "subtitle", "time": 10699.83, "timestamp": "02:58:19", "text": "ノイズ？はぁ？"}, {"type": "subtitle", "time": 10706.15, "timestamp": "02:58:26", "text": "私は大丈夫です。これからかなり深刻な事態になる"}, {"type": "subtitle", "time": 10709.269, "timestamp": "02:58:29", "text": "おいしい、おいしい、寝る前に"}, {"type": "subtitle", "time": 10711.429, "timestamp": "02:58:31", "text": "明日も仕事です。"}, {"type": "subtitle", "time": 10714.71, "timestamp": "02:58:34", "text": "ロボットが死んだとき、あなたなら何と言いますか？"}, {"type": "subtitle", "time": 10726.15, "timestamp": "02:58:46", "text": "あなたが何を言っているのか分かりません。あなたは何を"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "言う？こんにちは。また、Sans Waitによるものですが、12ですか？"}, {"type": "subtitle", "time": 10735.11, "timestamp": "02:58:55", "text": "今のあなたにとって午前中は？私の言っていることは正しいですか？は"}]
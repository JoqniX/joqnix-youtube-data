[{"type": "subtitle", "time": 20227.75, "timestamp": "05:37:07", "text": "それで、"}, {"type": "subtitle", "time": 20231.59, "timestamp": "05:37:11", "text": "あなたはよくやった。"}, {"type": "subtitle", "time": 20234.708, "timestamp": "05:37:14", "text": "何？ここで何をしているの？それは"}, {"type": "subtitle", "time": 20237.83, "timestamp": "05:37:17", "text": "トレバー、お母さんにはどのように挨拶するの？"}, {"type": "subtitle", "time": 20240.948, "timestamp": "05:37:20", "text": "トレバーの母親です。私は知らなかった"}, {"type": "subtitle", "time": 20243.51, "timestamp": "05:37:23", "text": "彼らはあなたを解放した。つまり、あなたは一度も手紙を書かなかったのですね"}, {"type": "subtitle", "time": 20252.31, "timestamp": "05:37:32", "text": "きっと君は一度も女の子を見つけたことがないんだろうね。"}, {"type": "subtitle", "time": 20255.11, "timestamp": "05:37:35", "text": "教えてくれ、トレバー。"}, {"type": "subtitle", "time": 20258.948, "timestamp": "05:37:38", "text": "あなたは同性愛者ですか？ああ、これがそういうことか"}, {"type": "subtitle", "time": 20264.31, "timestamp": "05:37:44", "text": "すべてについて？ああ、私は気にしないよ。実際には、"}, {"type": "subtitle", "time": 20269.59, "timestamp": "05:37:49", "text": "私はずっとゲイの息子が欲しかった。息子が"}, {"type": "subtitle", "time": 20279.99, "timestamp": "05:37:59", "text": "ああ、彼はあなたをここまで運んできたみたいね。私"}]
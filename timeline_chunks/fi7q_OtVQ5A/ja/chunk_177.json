[{"type": "subtitle", "time": 10625.59, "timestamp": "02:57:05", "text": "なし。そして私は誰かにこう言いました、"}, {"type": "subtitle", "time": 10628.15, "timestamp": "02:57:08", "text": "決してあなたを諦めない。いいえ。いいえ。いいえ。絶対に。"}, {"type": "subtitle", "time": 10632.07, "timestamp": "02:57:12", "text": "あなたを失望させるでしょう。あなた自身を見せてあげましょう。"}, {"type": "subtitle", "time": 10634.95, "timestamp": "02:57:14", "text": "CUダウンしていますか？そして彼はこう言った、彼らは"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "「え？君は"}, {"type": "subtitle", "time": 10640.23, "timestamp": "02:57:20", "text": "私をリロールするつもりですか？私はリックに反対です"}, {"type": "subtitle", "time": 10642.55, "timestamp": "02:57:22", "text": "ロール。 「あなたは私をリロールするつもりでしょう。」そして私は"}, {"type": "subtitle", "time": 10645.429, "timestamp": "02:57:25", "text": "「え？何？実は"}, {"type": "subtitle", "time": 10648.389, "timestamp": "02:57:28", "text": "これは本当に言っていることです。よお。"}, {"type": "subtitle", "time": 10651.67, "timestamp": "02:57:31", "text": "ああ、私はリックロールをするつもりはないよ。それからゆっくりと"}, {"type": "subtitle", "time": 10655.19, "timestamp": "02:57:35", "text": "リックロールが何なのかとか、そういうことを覚えた。"}, {"type": "subtitle", "time": 10657.99, "timestamp": "02:57:37", "text": "うん。そしてあなたもね。こんにちは"}, {"type": "subtitle", "time": 10660.55, "timestamp": "02:57:40", "text": "サンサン。元気かい？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 10662.15, "timestamp": "02:57:42", "text": "良い。"}, {"type": "subtitle", "time": 10664.79, "timestamp": "02:57:44", "text": "私たちは1時間くらい待たなければならなかった"}, {"type": "subtitle", "time": 10667.67, "timestamp": "02:57:47", "text": "ストリームに1時間45分"}, {"type": "subtitle", "time": 10671.429, "timestamp": "02:57:51", "text": "実際にこれをプレイするために"}, {"type": "subtitle", "time": 10673.99, "timestamp": "02:57:53", "text": "アップデートがあったのでゲームをアップデートしました。私はしませんでした"}, {"type": "subtitle", "time": 10676.15, "timestamp": "02:57:56", "text": "アップデートを入手してください。そして今、"}, {"type": "subtitle", "time": 10679.99, "timestamp": "02:57:59", "text": "えっと、ゲームを起動することすらできないんです。"}]
[{"type": "subtitle", "time": 12551.75, "timestamp": "03:29:11", "text": "なぜ私をいじめるの？"}, {"type": "subtitle", "time": 12559.19, "timestamp": "03:29:19", "text": "私はあなたを愚か者とは呼ばない。おお、"}, {"type": "subtitle", "time": 12561.67, "timestamp": "03:29:21", "text": "何度言えばわかるんだ"}, {"type": "subtitle", "time": 12564.229, "timestamp": "03:29:24", "text": "私がバカと言うとき、それは"}, {"type": "subtitle", "time": 12567.19, "timestamp": "03:29:27", "text": "バカ、知ってるでしょ"}, {"type": "subtitle", "time": 12569.75, "timestamp": "03:29:29", "text": "「バカ」の日本語の意味を忘れてください。おお"}, {"type": "subtitle", "time": 12571.51, "timestamp": "03:29:31", "text": "我が神よ。あのね？使用をやめます"}, {"type": "subtitle", "time": 12573.99, "timestamp": "03:29:33", "text": "バカ。大丈夫。わかった、いいよ。私は止めます"}, {"type": "subtitle", "time": 12579.51, "timestamp": "03:29:39", "text": "わかった、それでいいよ。そして私は使用をやめます"}, {"type": "subtitle", "time": 12581.75, "timestamp": "03:29:41", "text": "バルカは今から完全に"}, {"type": "subtitle", "time": 12588.15, "timestamp": "03:29:48", "text": "はい、それは誤解を招いています。"}, {"type": "subtitle", "time": 12591.269, "timestamp": "03:29:51", "text": "私はそれを望んでいません。私はこれが好きではない。"}, {"type": "subtitle", "time": 12595.429, "timestamp": "03:29:55", "text": "はい、バカを使うのはやめなければなりません。"}]
[{"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "隅っこにいる赤ちゃんは"}, {"type": "subtitle", "time": 8722.98, "timestamp": "02:25:22", "text": "十分な量があるだろうか？ああ、もう十分あるよ。"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "[音楽]"}, {"type": "subtitle", "time": 8736.23, "timestamp": "02:25:36", "text": "わーい。"}, {"type": "subtitle", "time": 8744.95, "timestamp": "02:25:44", "text": "そして、私は生きているはずだった。そしてそれは"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "はい、そうです。"}, {"type": "subtitle", "time": 8752.469, "timestamp": "02:25:52", "text": "おお、いいね。"}, {"type": "subtitle", "time": 8755.349, "timestamp": "02:25:55", "text": "カードを移動できることに気付きました"}, {"type": "subtitle", "time": 8758.63, "timestamp": "02:25:58", "text": "カードの中にいる間。"}]
[{"type": "subtitle", "time": 2106.63, "timestamp": "00:35:06", "text": "神よ、もしこの男がボットなら"}, {"type": "subtitle", "time": 2109.67, "timestamp": "00:35:09", "text": "まったく馬鹿げてる。"}, {"type": "subtitle", "time": 2113.67, "timestamp": "00:35:13", "text": "ああ、怖かったよ。"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "運転は、あなたがそうしないと非常にストレスが溜まります"}, {"type": "subtitle", "time": 2124.95, "timestamp": "00:35:24", "text": "知る。彼がちょうど"}, {"type": "subtitle", "time": 2128.87, "timestamp": "00:35:28", "text": "消えつつある。彼女は仕事だ。あなたは派手な"}, {"type": "subtitle", "time": 2145.67, "timestamp": "00:35:45", "text": "こんにちは、みんな。ラジャカトンへようこそ"}, {"type": "subtitle", "time": 2149.51, "timestamp": "00:35:49", "text": "96日目パート1の配信。今日は"}, {"type": "subtitle", "time": 2152.95, "timestamp": "00:35:52", "text": "本日の特別ゲスト。我々は持っています"}, {"type": "subtitle", "time": 2156.55, "timestamp": "00:35:56", "text": "エリー。こんにちは。"}, {"type": "subtitle", "time": 2158.79, "timestamp": "00:35:58", "text": "元気かい？"}]
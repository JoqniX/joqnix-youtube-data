[{"type": "subtitle", "time": 1442.23, "timestamp": "00:24:02", "text": "スキルを身につけて、"}, {"type": "subtitle", "time": 1444.07, "timestamp": "00:24:04", "text": "屋上で。"}, {"type": "subtitle", "time": 1445.75, "timestamp": "00:24:05", "text": "ああ、あなたは屋上にいるんですね。はい、あなたは"}, {"type": "subtitle", "time": 1448.98, "timestamp": "00:24:08", "text": "絶望的だ。大丈夫です。"}, {"type": "subtitle", "time": 1455.11, "timestamp": "00:24:15", "text": "来る。"}, {"type": "subtitle", "time": 1461.19, "timestamp": "00:24:21", "text": "近くにいるハッカーを見つけろ。素早く。わかった。"}, {"type": "subtitle", "time": 1466.149, "timestamp": "00:24:26", "text": "ただそれをしつけるだけだ。ディスク。"}, {"type": "subtitle", "time": 1468.07, "timestamp": "00:24:28", "text": "ああ、煙が出ている。近づかないでください。"}, {"type": "subtitle", "time": 1476.149, "timestamp": "00:24:36", "text": "痛い。痛い。ウェインは近くにいる。ああ、あなたはそうではない"}, {"type": "subtitle", "time": 1477.83, "timestamp": "00:24:37", "text": "そこには。"}, {"type": "subtitle", "time": 1480.789, "timestamp": "00:24:40", "text": "ああ、Aから離れているんですね。いいえ、私は死んでしまいました。"}, {"type": "subtitle", "time": 1485.269, "timestamp": "00:24:45", "text": "いいえ、大丈夫です。どこにいるの？どこ"}, {"type": "subtitle", "time": 1488.549, "timestamp": "00:24:48", "text": "あなたは？ああ、4人目の男の"}, {"type": "subtitle", "time": 1491.83, "timestamp": "00:24:51", "text": "AFK。本当に嫌な奴だ。"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "ちくしょう。ああ、死なないで。ああ、わかりました。"}, {"type": "subtitle", "time": 1499.51, "timestamp": "00:24:59", "text": "その男はAFKだった男だ、うーん"}]
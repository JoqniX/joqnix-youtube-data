[{"type": "subtitle", "time": 20411.99, "timestamp": "05:40:11", "text": "帯域幅を調べてください。それからモール"}, {"type": "subtitle", "time": 20441.03, "timestamp": "05:40:41", "text": "ブラジャー、私はこれらのブラジャーを書きましたが、"}, {"type": "subtitle", "time": 20443.75, "timestamp": "05:40:43", "text": "同じ私を見る"}, {"type": "subtitle", "time": 20447.27, "timestamp": "05:40:47", "text": "人々は私から距離を置く。"}, {"type": "subtitle", "time": 20450.548, "timestamp": "05:40:50", "text": "ママ、まだ行くの？うん。"}, {"type": "subtitle", "time": 20454.15, "timestamp": "05:40:54", "text": "どうしたんだ、カイ？元気ですか？あなたは食べましたか"}, {"type": "subtitle", "time": 20457.67, "timestamp": "05:40:57", "text": "お弁当とか全部？"}]
[{"type": "subtitle", "time": 7806.149, "timestamp": "02:10:06", "text": "おいおいおい、来いよ。"}, {"type": "subtitle", "time": 7808.31, "timestamp": "02:10:08", "text": "お前と戦ってやる。"}, {"type": "subtitle", "time": 7810.87, "timestamp": "02:10:10", "text": "ああ、なんてことだ、あなたはただ"}, {"type": "subtitle", "time": 7815.51, "timestamp": "02:10:15", "text": "今すぐコメントするなら、私と戦ってください。"}, {"type": "subtitle", "time": 7817.43, "timestamp": "02:10:17", "text": "アヒルが来ると思う。いいえ、アヒルは"}, {"type": "subtitle", "time": 7819.91, "timestamp": "02:10:19", "text": "来ません。"}, {"type": "subtitle", "time": 7822.47, "timestamp": "02:10:22", "text": "いいえ、そうは思いません。そうそう。あなたはできる"}, {"type": "subtitle", "time": 7826.47, "timestamp": "02:10:26", "text": "先にどうぞ。私たち二人とも同じくらい悪い。"}, {"type": "subtitle", "time": 7828.55, "timestamp": "02:10:28", "text": "よし、51番だ。"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "待って、リスポーンしたとき、"}, {"type": "subtitle", "time": 7837.51, "timestamp": "02:10:37", "text": "1つのような"}, {"type": "subtitle", "time": 7841.27, "timestamp": "02:10:41", "text": "HP？リスポーンしたとき、"}, {"type": "subtitle", "time": 7851.51, "timestamp": "02:10:51", "text": "そう、そういうことなんだ"}]
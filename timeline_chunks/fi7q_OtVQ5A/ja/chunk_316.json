[{"type": "subtitle", "time": 18978.15, "timestamp": "05:16:18", "text": "ああ、彼は私の友達のホイールを手に入れた。おお、"}, {"type": "subtitle", "time": 18990.55, "timestamp": "05:16:30", "text": "ああ、"}, {"type": "subtitle", "time": 18993.43, "timestamp": "05:16:33", "text": "私は車を持っていなかった。私は手に入れるべきだ"}, {"type": "subtitle", "time": 19011.19, "timestamp": "05:16:51", "text": "三合会から脱出せよ。よし、奴らを殺した。"}]
[{"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "たくさんの"}, {"type": "subtitle", "time": 7867.03, "timestamp": "02:11:07", "text": "手榴弾扉。さて、何があるかな"}, {"type": "subtitle", "time": 7869.03, "timestamp": "02:11:09", "text": "ここ？"}, {"type": "subtitle", "time": 7870.87, "timestamp": "02:11:10", "text": "強さがあるのは良いことだし、"}, {"type": "subtitle", "time": 7874.149, "timestamp": "02:11:14", "text": "スタミナがあるのは良いことだ。彼らはまだ"}, {"type": "subtitle", "time": 7878.709, "timestamp": "02:11:18", "text": "ひどい商品"}, {"type": "subtitle", "time": 7906.229, "timestamp": "02:11:46", "text": "うん。秘密の場所に行きたいですか？"}, {"type": "subtitle", "time": 7910.069, "timestamp": "02:11:50", "text": "穴？そうそう。うん。入って、手に入れて、手に入れて"}, {"type": "subtitle", "time": 7911.91, "timestamp": "02:11:51", "text": "車の中で。"}, {"type": "subtitle", "time": 7913.83, "timestamp": "02:11:53", "text": "ああ、車に乗って。わかった。乗る"}, {"type": "subtitle", "time": 7916.55, "timestamp": "02:11:56", "text": "車。"}, {"type": "subtitle", "time": 7918.47, "timestamp": "02:11:58", "text": "A 私はあなたを励ますことができたらいいなと思っていました"}, {"type": "subtitle", "time": 7919.99, "timestamp": "02:11:59", "text": "その中。どうでも。はい、"}]
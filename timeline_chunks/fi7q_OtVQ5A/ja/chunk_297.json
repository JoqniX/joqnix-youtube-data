[{"type": "subtitle", "time": 17824.23, "timestamp": "04:57:04", "text": "奴らを殺さなければならない。彼らにそうさせない"}, {"type": "subtitle", "time": 17850.708, "timestamp": "04:57:30", "text": "ちょっと待って、君のところへ行くよ。"}, {"type": "subtitle", "time": 17863.11, "timestamp": "04:57:43", "text": "保存しなければならないとしたら正しくないだろう"}, {"type": "subtitle", "time": 17866.07, "timestamp": "04:57:46", "text": "一度だけ、お前のケツを。助けてくれよ、[ __ ]。私"}]
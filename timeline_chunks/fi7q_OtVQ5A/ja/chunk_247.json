[{"type": "subtitle", "time": 14830.95, "timestamp": "04:07:10", "text": "よし、行こう。取り上げないで"}, {"type": "subtitle", "time": 14832.389, "timestamp": "04:07:12", "text": "この紳士の時間をこれ以上費やすことなく"}, {"type": "subtitle", "time": 14838.79, "timestamp": "04:07:18", "text": "さあ行こう。さあ行こう。あまり気分が良くない"}, {"type": "subtitle", "time": 14840.71, "timestamp": "04:07:20", "text": "良い。そして私は"}, {"type": "subtitle", "time": 14843.11, "timestamp": "04:07:23", "text": "我慢しろ。"}, {"type": "subtitle", "time": 14845.189, "timestamp": "04:07:25", "text": "二日酔いの件を処理する。しないでください"}, {"type": "subtitle", "time": 14847.51, "timestamp": "04:07:27", "text": "過剰摂取する。"}, {"type": "subtitle", "time": 14849.03, "timestamp": "04:07:29", "text": "それは正しい。この男は"}, {"type": "subtitle", "time": 14850.79, "timestamp": "04:07:30", "text": "あなたに少し教えたいことがあります"}, {"type": "subtitle", "time": 14853.189, "timestamp": "04:07:33", "text": "節度。"}, {"type": "subtitle", "time": 14855.429, "timestamp": "04:07:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 14858.87, "timestamp": "04:07:38", "text": "彼はただその男をあらゆることに巻き込ませている"}, {"type": "subtitle", "time": 14861.99, "timestamp": "04:07:41", "text": "これ。彼は仕事を失うだろう"}, {"type": "subtitle", "time": 14871.59, "timestamp": "04:07:51", "text": "私たちはただ"}]
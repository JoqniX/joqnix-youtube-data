[{"type": "subtitle", "time": 16860.23, "timestamp": "04:41:00", "text": "見てみましょう。"}, {"type": "subtitle", "time": 16863.03, "timestamp": "04:41:03", "text": "何が起こったのか分かりません。それらを削除してください。"}, {"type": "subtitle", "time": 16865.59, "timestamp": "04:41:05", "text": "でも、削除していないので削除できません"}, {"type": "subtitle", "time": 16869.35, "timestamp": "04:41:09", "text": "Dainciのバックアップを取っていません"}, {"type": "subtitle", "time": 16872.55, "timestamp": "04:41:12", "text": "編集とか色々。ダヴィンチのビデオは"}, {"type": "subtitle", "time": 16874.628, "timestamp": "04:41:14", "text": "編集作業など全て。腕時計のジョーク"}, {"type": "subtitle", "time": 16878.07, "timestamp": "04:41:18", "text": "時計も何もかも。私は"}, {"type": "subtitle", "time": 16880.47, "timestamp": "04:41:20", "text": "修理。"}, {"type": "subtitle", "time": 16882.868, "timestamp": "04:41:22", "text": "モニターの問題ではありません。それは"}, {"type": "subtitle", "time": 16885.91, "timestamp": "04:41:25", "text": "モニター。でも、もしそれがモニターだったら、"}, {"type": "subtitle", "time": 16890.07, "timestamp": "04:41:30", "text": "とても悲しいです。なぜなら、私は"}, {"type": "subtitle", "time": 16893.43, "timestamp": "04:41:33", "text": "変動問題は終わった。私は使い果たしました"}, {"type": "subtitle", "time": 16895.91, "timestamp": "04:41:35", "text": "最後のVenty関連のもの。"}, {"type": "subtitle", "time": 16900.47, "timestamp": "04:41:40", "text": "だから、私は痛みを感じるのです。では、これをぼかしましょう"}, {"type": "subtitle", "time": 16902.55, "timestamp": "04:41:42", "text": "このコードとすべてのポップアップが開く"}]
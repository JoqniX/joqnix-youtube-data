[{"type": "subtitle", "time": 12062.71, "timestamp": "03:21:02", "text": "私の恐怖の文章はご存知でしょう"}, {"type": "subtitle", "time": 12064.71, "timestamp": "03:21:04", "text": "今年はバナナを食べる。でもあなたは決して"}, {"type": "subtitle", "time": 12068.71, "timestamp": "03:21:08", "text": "バナナを食べた。何？なぜ？"}, {"type": "subtitle", "time": 12079.349, "timestamp": "03:21:19", "text": "え、バナナ食べたことないの？なぜだめですか"}, {"type": "subtitle", "time": 12102.469, "timestamp": "03:21:42", "text": "この人は誰ですか？逃げる"}, {"type": "subtitle", "time": 12116.07, "timestamp": "03:21:56", "text": "えっと、私はどこに行けばいいんだっけ？"}]
[{"type": "subtitle", "time": 8224.79, "timestamp": "02:17:04", "text": "どこにいるの？"}, {"type": "subtitle", "time": 8226.629, "timestamp": "02:17:06", "text": "私は部屋で"}, {"type": "subtitle", "time": 8229.589, "timestamp": "02:17:09", "text": "私が落第しそうな科目。"}, {"type": "subtitle", "time": 8232.389, "timestamp": "02:17:12", "text": "私は小さすぎる。"}, {"type": "subtitle", "time": 8234.95, "timestamp": "02:17:14", "text": "ああ、私には理解できません。"}, {"type": "subtitle", "time": 8236.469, "timestamp": "02:17:16", "text": "おお。"}, {"type": "subtitle", "time": 8239.91, "timestamp": "02:17:19", "text": "ああ、なんてことだ。それを取ってくれますか？私はできません"}, {"type": "subtitle", "time": 8242.309, "timestamp": "02:17:22", "text": "それを手に入れろ。ええ、分かりますよね？"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "ああ、あれか。"}, {"type": "subtitle", "time": 8246.629, "timestamp": "02:17:26", "text": "それはまるで"}, {"type": "subtitle", "time": 8261.349, "timestamp": "02:17:41", "text": "おお。何てことだ。ああ、しまった。"}, {"type": "subtitle", "time": 8265.99, "timestamp": "02:17:45", "text": "私はここにいます。私は死んだ。いいえ、見えました。"}, {"type": "subtitle", "time": 8268.549, "timestamp": "02:17:48", "text": "彼はどこにいますか？"}]
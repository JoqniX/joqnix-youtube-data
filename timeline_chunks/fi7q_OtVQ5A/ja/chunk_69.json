[{"type": "subtitle", "time": 4141.59, "timestamp": "01:09:01", "text": "まるでひどい揺れ方だった。その"}, {"type": "subtitle", "time": 4144.87, "timestamp": "01:09:04", "text": "「ああ、これはとても"}, {"type": "subtitle", "time": 4146.47, "timestamp": "01:09:06", "text": "吐き気がする。"}, {"type": "subtitle", "time": 4174.309, "timestamp": "01:09:34", "text": "私は"}, {"type": "subtitle", "time": 4178.149, "timestamp": "01:09:38", "text": "100. ここにはこれを載せられません。ああ、それであなたは"}, {"type": "subtitle", "time": 4181.189, "timestamp": "01:09:41", "text": "入れてもいいですよ。わかりました。"}, {"type": "subtitle", "time": 4185.829, "timestamp": "01:09:45", "text": "ああ、これだ。なんてこった。"}, {"type": "subtitle", "time": 4191.59, "timestamp": "01:09:51", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 4193.51, "timestamp": "01:09:53", "text": "えっと、"}, {"type": "subtitle", "time": 4196.31, "timestamp": "01:09:56", "text": "私たちは本当に"}, {"type": "subtitle", "time": 4199.03, "timestamp": "01:09:59", "text": "彼女を殺してしまうだろう、私たちが彼女を殺すまで"}]
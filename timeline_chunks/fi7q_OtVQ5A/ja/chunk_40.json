[{"type": "subtitle", "time": 2402.71, "timestamp": "00:40:02", "text": "えっと、設定？だから、もしあなたが行くなら、私が思うに"}, {"type": "subtitle", "time": 2404.95, "timestamp": "00:40:04", "text": "優先順位は"}, {"type": "subtitle", "time": 2408.39, "timestamp": "00:40:08", "text": "Steamで"}, {"type": "subtitle", "time": 2412.15, "timestamp": "00:40:12", "text": "あなたについて、リポジトリをクリックして、"}, {"type": "subtitle", "time": 2415.19, "timestamp": "00:40:15", "text": "ベータ版に行くと、"}, {"type": "subtitle", "time": 2417.589, "timestamp": "00:40:17", "text": "小さなバーに、次のように変更できます"}, {"type": "subtitle", "time": 2422.31, "timestamp": "00:40:22", "text": "9またはベータ。ん。だから、次のように変更します。"}, {"type": "subtitle", "time": 2424.63, "timestamp": "00:40:24", "text": "それ。"}, {"type": "subtitle", "time": 2429.19, "timestamp": "00:40:29", "text": "私はベータ版ブランチにいます。"}, {"type": "subtitle", "time": 2430.79, "timestamp": "00:40:30", "text": "おお、"}, {"type": "subtitle", "time": 2435.109, "timestamp": "00:40:35", "text": "代わりにあなたに試させてください。うん。うん。"}, {"type": "subtitle", "time": 2444.63, "timestamp": "00:40:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2447.589, "timestamp": "00:40:47", "text": "あるいは、新しいアップデートが配信されたのかもしれません。"}, {"type": "subtitle", "time": 2450.069, "timestamp": "00:40:50", "text": "まさに今この瞬間？"}, {"type": "subtitle", "time": 2453.03, "timestamp": "00:40:53", "text": "私はそれが大嫌いだ。"}]
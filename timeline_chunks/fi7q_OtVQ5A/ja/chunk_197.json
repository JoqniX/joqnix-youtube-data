[{"type": "subtitle", "time": 11821.67, "timestamp": "03:17:01", "text": "大きくて広いドンを取ってください、なぜなら私は知っているからです"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "クラッシュするでしょう。だから私はそうしない。"}, {"type": "subtitle", "time": 11827.75, "timestamp": "03:17:07", "text": "だから私はただ休憩して、"}, {"type": "subtitle", "time": 11829.67, "timestamp": "03:17:09", "text": "ドン。"}, {"type": "subtitle", "time": 11837.19, "timestamp": "03:17:17", "text": "何てことだ。"}, {"type": "subtitle", "time": 11846.389, "timestamp": "03:17:26", "text": "[音楽]"}, {"type": "subtitle", "time": 11849.91, "timestamp": "03:17:29", "text": "私はついさっきカミングアウトしたばかりです。ああ、私は行くはずだった"}, {"type": "subtitle", "time": 11859.03, "timestamp": "03:17:39", "text": "私は一体どこに行けばいいんだっけ？わかった、"}, {"type": "subtitle", "time": 11866.63, "timestamp": "03:17:46", "text": "ああ、墜落した。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 11869.349, "timestamp": "03:17:49", "text": "私のライディングの方がかっこいい。私は最高になる"}, {"type": "subtitle", "time": 11870.95, "timestamp": "03:17:50", "text": "注意深い。心配しないで、チャド。平"}, {"type": "subtitle", "time": 11875.19, "timestamp": "03:17:55", "text": "私がここでやっているなら、ここでやらないでください"}, {"type": "subtitle", "time": 11877.91, "timestamp": "03:17:57", "text": "家。わかった？"}]
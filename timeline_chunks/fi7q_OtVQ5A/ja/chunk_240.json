[{"type": "subtitle", "time": 14402.71, "timestamp": "04:00:02", "text": "猫の日。ああ、今日はネコの日だ。私"}, {"type": "subtitle", "time": 14405.75, "timestamp": "04:00:05", "text": "忘れた。ハッピー 待って、待って、待って、待って、"}, {"type": "subtitle", "time": 14407.269, "timestamp": "04:00:07", "text": "待って。"}, {"type": "subtitle", "time": 14409.51, "timestamp": "04:00:09", "text": "今日はネコの日です。つまりそれは"}, {"type": "subtitle", "time": 14411.75, "timestamp": "04:00:11", "text": "ただ一つだけ。それは意味のあることだ。"}, {"type": "subtitle", "time": 14414.95, "timestamp": "04:00:14", "text": "それは それは それは それは それは それは"}, {"type": "subtitle", "time": 14423.189, "timestamp": "04:00:23", "text": "[音楽]"}, {"type": "subtitle", "time": 14425.91, "timestamp": "04:00:25", "text": "ネコモードに入ります。まだここには来ていない。座りましょう"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "きつい。はい。"}, {"type": "subtitle", "time": 14432.15, "timestamp": "04:00:32", "text": "私は猫です。私は慰めの猫です"}]
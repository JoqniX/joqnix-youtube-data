[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "あそこですか？わかった。はい、最善を尽くします。"}, {"type": "subtitle", "time": 4266.39, "timestamp": "01:11:06", "text": "それを抽出しようとしているんです。"}, {"type": "subtitle", "time": 4269.99, "timestamp": "01:11:09", "text": "ああ、見て。大きな人形の卵がある。"}, {"type": "subtitle", "time": 4274.149, "timestamp": "01:11:14", "text": "ああ、気をつけて。あなたはそれを保持します"}, {"type": "subtitle", "time": 4277.83, "timestamp": "01:11:17", "text": "レイヤーのように、もしあなたが"}, {"type": "subtitle", "time": 4281.669, "timestamp": "01:11:21", "text": "赤い色が消えるまで叩き続けてください"}, {"type": "subtitle", "time": 4284.79, "timestamp": "01:11:24", "text": "それは爆発するだろう。"}, {"type": "chat", "time": 4289.368, "timestamp": "01:11:29", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eAUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eA"}, {"type": "subtitle", "time": 4319.83, "timestamp": "01:11:59", "text": "ああ、本当にたくさんの品物だ。"}]
[{"type": "subtitle", "time": 8522.469, "timestamp": "02:22:02", "text": "プレイ中。"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "うん、まだ写真が保存されてるよ"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "デスクトップのどこか。ああ、いいね。"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "私はスクリーンショットを撮ろうとしていました"}, {"type": "subtitle", "time": 8545.75, "timestamp": "02:22:25", "text": "グループでいるときに何か。うん。"}, {"type": "subtitle", "time": 8549.429, "timestamp": "02:22:29", "text": "うん。思い出のために。うん。"}, {"type": "subtitle", "time": 8553.429, "timestamp": "02:22:33", "text": "うん。そして私はそれを特別な場所に保管しています"}, {"type": "subtitle", "time": 8555.349, "timestamp": "02:22:35", "text": "ああ、気味の悪い赤ちゃん。怖かった。それ"}, {"type": "subtitle", "time": 8557.51, "timestamp": "02:22:37", "text": "怖かった。"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "赤ちゃんは何人いますか？ああ、これだ。"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "なくなってしまった。"}, {"type": "subtitle", "time": 8572.95, "timestamp": "02:22:52", "text": "しかし、もう1人。"}, {"type": "subtitle", "time": 8576.309, "timestamp": "02:22:56", "text": "大丈夫です。そこに立っていると"}, {"type": "subtitle", "time": 8578.79, "timestamp": "02:22:58", "text": "細身の男。"}]
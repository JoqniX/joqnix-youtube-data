[{"type": "subtitle", "time": 4322.229, "timestamp": "01:12:02", "text": "うん、これを手に入れようとしてるんだ"}, {"type": "subtitle", "time": 4344.39, "timestamp": "01:12:24", "text": "これを取り出しましょうか？あ、待って、"}, {"type": "subtitle", "time": 4346.63, "timestamp": "01:12:26", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 4349.03, "timestamp": "01:12:29", "text": "ああ、なるほど。あ、待って。 2つ必要です"}, {"type": "subtitle", "time": 4350.709, "timestamp": "01:12:30", "text": "抽出ポイント。わかった、わかった、気をつけて。"}, {"type": "subtitle", "time": 4353.59, "timestamp": "01:12:33", "text": "そうそう。実際に抽出できます。"}, {"type": "subtitle", "time": 4357.189, "timestamp": "01:12:37", "text": "はい。ロックを解除して、"}, {"type": "subtitle", "time": 4359.03, "timestamp": "01:12:39", "text": "そこに物を置いて、それからロックを解除します"}, {"type": "subtitle", "time": 4361.03, "timestamp": "01:12:41", "text": "2つ目。"}, {"type": "subtitle", "time": 4365.43, "timestamp": "01:12:45", "text": "わかった。わかった。これが計画だ"}, {"type": "subtitle", "time": 4367.27, "timestamp": "01:12:47", "text": "2回目の抽出時。私はそう思った"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "それは抽出された抽出物の1つに過ぎなかった。"}, {"type": "subtitle", "time": 4373.83, "timestamp": "01:12:53", "text": "いいえ、もっと行くほど"}, {"type": "subtitle", "time": 4376.79, "timestamp": "01:12:56", "text": "ゲーム内で。"}]
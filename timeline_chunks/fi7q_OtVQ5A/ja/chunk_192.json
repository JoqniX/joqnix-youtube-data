[{"type": "subtitle", "time": 11527.19, "timestamp": "03:12:07", "text": "でも、山々を見てください。それで"}, {"type": "subtitle", "time": 11553.67, "timestamp": "03:12:33", "text": "私に確認する前に記録を残してください。"}, {"type": "subtitle", "time": 11555.51, "timestamp": "03:12:35", "text": "ああ、ガントレット。そうそう。ええ、ええ、"}, {"type": "subtitle", "time": 11557.75, "timestamp": "03:12:37", "text": "うん。私たちはそれをやっていました。わかった。車"}, {"type": "subtitle", "time": 11560.23, "timestamp": "03:12:40", "text": "場所。"}, {"type": "subtitle", "time": 11563.75, "timestamp": "03:12:43", "text": "ガントレット。わかった。私たちは1つに行く"}, {"type": "subtitle", "time": 11565.99, "timestamp": "03:12:45", "text": "モデルと、それは3つだけ必要です"}, {"type": "subtitle", "time": 11569.269, "timestamp": "03:12:49", "text": "さらに画像を追加して編集します。"}, {"type": "subtitle", "time": 11570.79, "timestamp": "03:12:50", "text": "わかった。"}, {"type": "subtitle", "time": 11573.429, "timestamp": "03:12:53", "text": "えっと"}]
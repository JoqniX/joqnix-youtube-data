[{"type": "subtitle", "time": 13922.63, "timestamp": "03:52:02", "text": "深い疑問符を描いてみましょう。あなたは"}, {"type": "subtitle", "time": 13925.11, "timestamp": "03:52:05", "text": "に当たった"}, {"type": "subtitle", "time": 13931.59, "timestamp": "03:52:11", "text": "それがあなたの意図だったのですか？"}, {"type": "subtitle", "time": 13933.75, "timestamp": "03:52:13", "text": "あなたはトラックに轢かれました。なんてこった。だった"}, {"type": "subtitle", "time": 13937.99, "timestamp": "03:52:17", "text": "生まれ変わるつもりだ。さあ行こう。"}, {"type": "subtitle", "time": 13948.229, "timestamp": "03:52:28", "text": "トラックのVTuberはいないの？"}, {"type": "subtitle", "time": 13950.63, "timestamp": "03:52:30", "text": "ああ、トラックのVTuberがいて"}, {"type": "subtitle", "time": 13952.95, "timestamp": "03:52:32", "text": "みんなが新しい凧を手に入れる"}, {"type": "subtitle", "time": 13954.469, "timestamp": "03:52:34", "text": "世界。"}, {"type": "subtitle", "time": 13956.87, "timestamp": "03:52:36", "text": "そうそう。"}, {"type": "subtitle", "time": 13959.429, "timestamp": "03:52:39", "text": "そして、イエス・キリストまで登場する。"}, {"type": "subtitle", "time": 13962.309, "timestamp": "03:52:42", "text": "イエス・キリストに関するYouTuberもいるよ。おお"}, {"type": "subtitle", "time": 13966.71, "timestamp": "03:52:46", "text": "我が神よ。次は？"}, {"type": "subtitle", "time": 13969.349, "timestamp": "03:52:49", "text": "そこには何があるのですか？ない"}, {"type": "subtitle", "time": 13972.469, "timestamp": "03:52:52", "text": "次。マイケル・ジャクソンを見たい"}, {"type": "subtitle", "time": 13974.87, "timestamp": "03:52:54", "text": "YouTuber。ああ、イエス・キリストのYouTuberがいるよ。"}, {"type": "subtitle", "time": 13977.83, "timestamp": "03:52:57", "text": "Twitterで「Jesus YouTuber」と検索してみてください。"}]
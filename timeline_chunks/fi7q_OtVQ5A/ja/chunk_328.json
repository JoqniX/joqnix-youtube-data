[{"type": "subtitle", "time": 19684.948, "timestamp": "05:28:04", "text": "私が必要とする創造性の種類"}, {"type": "subtitle", "time": 19687.03, "timestamp": "05:28:07", "text": "チーム。来て。来て。私を"}, {"type": "subtitle", "time": 19690.15, "timestamp": "05:28:10", "text": "ここ。トレバー、俺は自分の会社を持っているんだ"}, {"type": "subtitle", "time": 19713.27, "timestamp": "05:28:33", "text": "いや、吠えるんだ。"}, {"type": "subtitle", "time": 19720.548, "timestamp": "05:28:40", "text": "これが、人々があなたを殺したがる理由です。あなた"}, {"type": "subtitle", "time": 19722.788, "timestamp": "05:28:42", "text": "黙らない。"}, {"type": "subtitle", "time": 19725.03, "timestamp": "05:28:45", "text": "うん、"}]
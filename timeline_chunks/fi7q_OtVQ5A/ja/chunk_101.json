[{"type": "subtitle", "time": 6067.83, "timestamp": "01:41:07", "text": "それを入れることができると思います。"}, {"type": "subtitle", "time": 6069.669, "timestamp": "01:41:09", "text": "抽出。"}, {"type": "subtitle", "time": 6071.83, "timestamp": "01:41:11", "text": "よし。よし。あなたが"}, {"type": "subtitle", "time": 6075.109, "timestamp": "01:41:15", "text": "物を収納できるので、より良い"}, {"type": "subtitle", "time": 6077.03, "timestamp": "01:41:17", "text": "いいですね。"}, {"type": "subtitle", "time": 6080.229, "timestamp": "01:41:20", "text": "あるいは、ああ、私たちは皆、ただ"}, {"type": "subtitle", "time": 6083.35, "timestamp": "01:41:23", "text": "今から開始します。それは実際良いことですね。そして"}, {"type": "subtitle", "time": 6087.59, "timestamp": "01:41:27", "text": "現在の公開されているものは、SP が保持する"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "他の物も洗ってください。通常、それは"}, {"type": "subtitle", "time": 6094.39, "timestamp": "01:41:34", "text": "大丈夫。ただ大きいだけですよね？それです"}, {"type": "subtitle", "time": 6096.31, "timestamp": "01:41:36", "text": "あなたに必要なのは"}, {"type": "subtitle", "time": 6098.79, "timestamp": "01:41:38", "text": "それを持ち上げるだけの力。私はほとんど"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "壊しそうになるんじゃないか？私"}, {"type": "subtitle", "time": 6104.149, "timestamp": "01:41:44", "text": "持ち運べない。"}]
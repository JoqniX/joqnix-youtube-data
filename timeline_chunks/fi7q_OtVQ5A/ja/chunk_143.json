[{"type": "subtitle", "time": 8584.23, "timestamp": "02:23:04", "text": "[音楽]"}, {"type": "subtitle", "time": 8590.63, "timestamp": "02:23:10", "text": "探していません。"}, {"type": "subtitle", "time": 8593.59, "timestamp": "02:23:13", "text": "なくなってしまった。わかった。良い。だって私は"}, {"type": "subtitle", "time": 8595.11, "timestamp": "02:23:15", "text": "ここ。"}, {"type": "subtitle", "time": 8598.469, "timestamp": "02:23:18", "text": "何てことだ。本当に？本当に？見ていない。"}, {"type": "subtitle", "time": 8630.09, "timestamp": "02:23:50", "text": "スポーン地点での待ち伏せ。"}, {"type": "subtitle", "time": 8631.19, "timestamp": "02:23:51", "text": "[音楽]"}, {"type": "subtitle", "time": 8632.95, "timestamp": "02:23:52", "text": "スポーン地点での待ち伏せ。ああ、グラスが置いてある"}, {"type": "subtitle", "time": 8635.27, "timestamp": "02:23:55", "text": "あなたの言う通りです。うん。私はただ"}, {"type": "subtitle", "time": 8637.11, "timestamp": "02:23:57", "text": "この部屋をチェックしてから、私は行く"}, {"type": "subtitle", "time": 8639.91, "timestamp": "02:23:59", "text": "抽出地点まで。"}]
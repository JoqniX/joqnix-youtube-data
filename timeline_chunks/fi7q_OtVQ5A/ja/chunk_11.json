[{"type": "subtitle", "time": 661.11, "timestamp": "00:11:01", "text": "死んだ。はい。ニース。"}, {"type": "subtitle", "time": 666.71, "timestamp": "00:11:06", "text": "私たちは勝った。私たちは勝った。はい。はい。 GG。"}, {"type": "subtitle", "time": 668.87, "timestamp": "00:11:08", "text": "ゲームを救ったのは誰だ？"}, {"type": "subtitle", "time": 670.949, "timestamp": "00:11:10", "text": "ウェイン？"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "実際、私はあなたを助けたんです。あなたではありません"}, {"type": "subtitle", "time": 676.87, "timestamp": "00:11:16", "text": "道。よし、私の人生は"}, {"type": "subtitle", "time": 680.23, "timestamp": "00:11:20", "text": "ゲーム。みんなが「私は最新だ」と言えるでしょうか"}, {"type": "subtitle", "time": 682.389, "timestamp": "00:11:22", "text": "ここ。それで"}, {"type": "subtitle", "time": 684.15, "timestamp": "00:11:24", "text": "私は屋根の上にいて、"}, {"type": "subtitle", "time": 686.79, "timestamp": "00:11:26", "text": "ちなみに、彼を殺したのは彼だ。彼は、いや、いや、"}, {"type": "subtitle", "time": 688.87, "timestamp": "00:11:28", "text": "いいえ。あなたは何もしていない。あなたはそうしました"}, {"type": "subtitle", "time": 692.069, "timestamp": "00:11:32", "text": "何もない。あなたは何もしていない。おお。ああ、人々よ"}, {"type": "subtitle", "time": 693.91, "timestamp": "00:11:33", "text": "結果がわかるかもしれない、ちなみに私の"}, {"type": "subtitle", "time": 698.389, "timestamp": "00:11:38", "text": "友人。いや、いや。彼らは何も見えない。"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "ええ、できますよ。いいえ、できません。しないで"}, {"type": "subtitle", "time": 703.91, "timestamp": "00:11:43", "text": "それについて心配してください。いいえ、私たちは"}, {"type": "subtitle", "time": 705.67, "timestamp": "00:11:45", "text": "また一緒に遊ぼう。行かないで。"}, {"type": "subtitle", "time": 709.509, "timestamp": "00:11:49", "text": "どうせ誰とも遊んでないんだから。"}, {"type": "subtitle", "time": 711.99, "timestamp": "00:11:51", "text": "私は何者？だから箱。私は"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "箱。いや、いや、いや。行け、あっちへ行け。戻ってください。"}, {"type": "subtitle", "time": 717.91, "timestamp": "00:11:57", "text": "イエス。君はいらない。えっと、箱。神。"}]
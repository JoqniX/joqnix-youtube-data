[{"type": "subtitle", "time": 3660.87, "timestamp": "01:01:00", "text": "それ。うん。"}, {"type": "subtitle", "time": 3668.789, "timestamp": "01:01:08", "text": "指輪は機能する。持ち込み可能なアイテム"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "元のものに戻って使用していないのですか？"}, {"type": "subtitle", "time": 3678.15, "timestamp": "01:01:18", "text": "えっと、アヒルの樽。はい。"}, {"type": "subtitle", "time": 3680.309, "timestamp": "01:01:20", "text": "でも、そのままにしておけば、"}, {"type": "subtitle", "time": 3682.87, "timestamp": "01:01:22", "text": "とにかく戻ってきてください。ああ、これは"}, {"type": "subtitle", "time": 3686.47, "timestamp": "01:01:26", "text": "レベル？ああ、なんてことだ。イエス。"}, {"type": "subtitle", "time": 3689.27, "timestamp": "01:01:29", "text": "待って、この場所、今まで見たことないわ。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "これは全く新しいレベルだ。ここは博物館です。"}, {"type": "subtitle", "time": 3694.309, "timestamp": "01:01:34", "text": "私たちはあなたにたくさんのお金を引き出すことができます"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "ああ、見て。飛行機。ああ、私は見たことがない"}]
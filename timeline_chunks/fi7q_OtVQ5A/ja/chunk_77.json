[{"type": "subtitle", "time": 4625.35, "timestamp": "01:17:05", "text": "ああ、今はあらゆるものが至る所にある。ベッド、"}, {"type": "subtitle", "time": 4627.99, "timestamp": "01:17:07", "text": "ジョン。わかった。"}, {"type": "subtitle", "time": 4630.149, "timestamp": "01:17:10", "text": "私はドローンをいじったことは一度もない"}, {"type": "subtitle", "time": 4632.07, "timestamp": "01:17:12", "text": "システムはまだ、"}, {"type": "subtitle", "time": 4634.39, "timestamp": "01:17:14", "text": "だから、私にはわからない。では、待ってください。えっと、もしあなたが"}, {"type": "subtitle", "time": 4636.79, "timestamp": "01:17:16", "text": "このゲームでは死ぬ、それだけだ。あなたはできません"}, {"type": "subtitle", "time": 4647.51, "timestamp": "01:17:27", "text": "場合によります。いいえ、死んだら死んだだけです。の"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "本当にできる唯一の時間"}, {"type": "subtitle", "time": 4653.35, "timestamp": "01:17:33", "text": "戻ることは"}, {"type": "subtitle", "time": 4656.95, "timestamp": "01:17:36", "text": "えっと、なんていう名前ですか？チームプレーヤーであれば"}, {"type": "subtitle", "time": 4659.189, "timestamp": "01:17:39", "text": "改造しない限り、"}, {"type": "subtitle", "time": 4664.47, "timestamp": "01:17:44", "text": "押し続ければ復活します。"}, {"type": "subtitle", "time": 4667.91, "timestamp": "01:17:47", "text": "ああ、秘密が見つからない。どこ"}, {"type": "subtitle", "time": 4679.43, "timestamp": "01:17:59", "text": "ああ、全部散らばってしまった。ああ、私は"}]
[{"type": "subtitle", "time": 9780.07, "timestamp": "02:43:00", "text": "うん。うん。あと11個くらいあるから"}, {"type": "subtitle", "time": 9782.71, "timestamp": "02:43:02", "text": "数ヶ月ですよね？だから、大丈夫です。"}, {"type": "subtitle", "time": 9786.15, "timestamp": "02:43:06", "text": "だから、嬉しいよ。うん。"}, {"type": "subtitle", "time": 9789.11, "timestamp": "02:43:09", "text": "うん。教えてください。わかった。こんにちは。全て"}, {"type": "subtitle", "time": 9791.75, "timestamp": "02:43:11", "text": "右。まだストリーミング配信中ですか？"}, {"type": "subtitle", "time": 9795.99, "timestamp": "02:43:15", "text": "または、ああ、私はストリーミングを続けます。"}, {"type": "subtitle", "time": 9798.23, "timestamp": "02:43:18", "text": "よし。わかった。それでは、残りの時間をお楽しみください。"}, {"type": "subtitle", "time": 9802.07, "timestamp": "02:43:22", "text": "私は何かを食べに行くのが好きかもしれないし、"}, {"type": "subtitle", "time": 9804.71, "timestamp": "02:43:24", "text": "うん。船に積み込んで、後で戻ってきてください。"}, {"type": "subtitle", "time": 9808.87, "timestamp": "02:43:28", "text": "うん。よし。こんにちは。皆さん、さようなら。"}, {"type": "subtitle", "time": 9811.59, "timestamp": "02:43:31", "text": "皆さん、さようなら。アリシアさん、ありがとう。"}, {"type": "subtitle", "time": 9813.349, "timestamp": "02:43:33", "text": "出発前に何か言いたいことはありますか？"}, {"type": "subtitle", "time": 9815.83, "timestamp": "02:43:35", "text": "発表や更新など、"}, {"type": "subtitle", "time": 9817.67, "timestamp": "02:43:37", "text": "何でも？"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "いいえ。そのままチャンネルを視聴し続けてください。"}, {"type": "subtitle", "time": 9828.23, "timestamp": "02:43:48", "text": "はい。はい。"}, {"type": "subtitle", "time": 9830.63, "timestamp": "02:43:50", "text": "デートのお誘いありがとうございます。"}, {"type": "subtitle", "time": 9839.99, "timestamp": "02:43:59", "text": "皆さん、以上がエリサでした。"}]
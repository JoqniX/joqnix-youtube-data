[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "ええ、だから先に進むべきだと言ったんです"}, {"type": "subtitle", "time": 8883.99, "timestamp": "02:28:03", "text": "戻る。よし、ここから出よう。"}, {"type": "subtitle", "time": 8899.99, "timestamp": "02:28:19", "text": "[音楽]"}, {"type": "subtitle", "time": 8904.55, "timestamp": "02:28:24", "text": "よし、もう1つ時間がある"}, {"type": "subtitle", "time": 8908.23, "timestamp": "02:28:28", "text": "そして私は、ああ、それが来る、と一緒にいなければなりませんでした。"}, {"type": "subtitle", "time": 8921.19, "timestamp": "02:28:41", "text": "わーい。"}, {"type": "subtitle", "time": 8923.27, "timestamp": "02:28:43", "text": "私抜きで行ってください。"}, {"type": "subtitle", "time": 8935.19, "timestamp": "02:28:55", "text": "走る。何てことだ。"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "ああ、不気味な赤ちゃんじゃなければ、"}, {"type": "subtitle", "time": 8939.59, "timestamp": "02:28:59", "text": "頭蓋骨。"}]
[{"type": "subtitle", "time": 3780.309, "timestamp": "01:03:00", "text": "うん。"}, {"type": "subtitle", "time": 3782.63, "timestamp": "01:03:02", "text": "あぁ、転んじゃった。"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "あ、待って。君はできる、君はできる、私はする"}, {"type": "subtitle", "time": 3787.19, "timestamp": "01:03:07", "text": "またそれか。"}, {"type": "subtitle", "time": 3790.87, "timestamp": "01:03:10", "text": "もっと近づければ。"}, {"type": "subtitle", "time": 3794.789, "timestamp": "01:03:14", "text": "この場所には戦利品がたくさんある。"}, {"type": "subtitle", "time": 3797.829, "timestamp": "01:03:17", "text": "はい。待って、君には翼があるはずだ。あなた"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "それらを使用できるはずです。私は違います"}, {"type": "subtitle", "time": 3801.349, "timestamp": "01:03:21", "text": "どちらを使うべきか、かなり迷っています。"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "おお。"}, {"type": "subtitle", "time": 3805.99, "timestamp": "01:03:25", "text": "おお、"}, {"type": "subtitle", "time": 3807.91, "timestamp": "01:03:27", "text": "うん。"}, {"type": "subtitle", "time": 3810.39, "timestamp": "01:03:30", "text": "何てことだ。"}, {"type": "subtitle", "time": 3812.549, "timestamp": "01:03:32", "text": "待って、"}, {"type": "subtitle", "time": 3817.51, "timestamp": "01:03:37", "text": "再び仕事に取り掛かる？"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "ああ、私はタンブリングがあまり得意じゃないんです"}, {"type": "subtitle", "time": 3837.99, "timestamp": "01:03:57", "text": "わかった。うん。うん。うん。もう一度やってみて。"}]
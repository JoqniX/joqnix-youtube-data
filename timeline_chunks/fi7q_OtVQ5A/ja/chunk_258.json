[{"type": "subtitle", "time": 15481.99, "timestamp": "04:18:01", "text": "主。"}, {"type": "subtitle", "time": 15484.79, "timestamp": "04:18:04", "text": "ごめんなさい。私はただ信頼しているだけです"}, {"type": "subtitle", "time": 15495.349, "timestamp": "04:18:15", "text": "あなたのPCは"}, {"type": "subtitle", "time": 15513.11, "timestamp": "04:18:33", "text": "なぜなら私は金持ちだから。私は悲しいです"}, {"type": "subtitle", "time": 15516.55, "timestamp": "04:18:36", "text": "成功。ああ、これは情けない。"}, {"type": "subtitle", "time": 15520.71, "timestamp": "04:18:40", "text": "ああ、本当に申し訳ありません。"}, {"type": "subtitle", "time": 15530.309, "timestamp": "04:18:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15536.87, "timestamp": "04:18:56", "text": "私は今、鹿を殺した。"}]
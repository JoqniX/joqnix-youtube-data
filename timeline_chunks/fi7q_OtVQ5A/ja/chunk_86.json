[{"type": "subtitle", "time": 5179.11, "timestamp": "01:26:19", "text": "何か見つかりましたか？"}, {"type": "subtitle", "time": 5195.52, "timestamp": "01:26:35", "text": "おお。おお。"}, {"type": "subtitle", "time": 5198.629, "timestamp": "01:26:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5202.229, "timestamp": "01:26:42", "text": "何てことだ。近い。"}, {"type": "subtitle", "time": 5205.03, "timestamp": "01:26:45", "text": "おお。えっと、モンスターの1体を手に入れたら、"}, {"type": "subtitle", "time": 5210.55, "timestamp": "01:26:50", "text": "彼らの余剰の魂は非常に価値がある。"}, {"type": "subtitle", "time": 5214.149, "timestamp": "01:26:54", "text": "えーとモンスターは"}, {"type": "subtitle", "time": 5216.149, "timestamp": "01:26:56", "text": "モンスターが目玉のようなものを落とす"}, {"type": "subtitle", "time": 5217.669, "timestamp": "01:26:57", "text": "壊れやすい。"}, {"type": "subtitle", "time": 5219.189, "timestamp": "01:26:59", "text": "はい。"}]
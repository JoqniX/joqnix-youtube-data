[{"type": "subtitle", "time": 3247.829, "timestamp": "00:54:07", "text": "さて、あなたの一番好きなゲームは何ですか？どの部屋でも"}, {"type": "subtitle", "time": 3250.95, "timestamp": "00:54:10", "text": "工場？私はルーンファクトリーが大好きです。の"}, {"type": "subtitle", "time": 3253.99, "timestamp": "00:54:13", "text": "私が気に入らなかったのは、"}, {"type": "subtitle", "time": 3255.67, "timestamp": "00:54:15", "text": "悪い。"}, {"type": "subtitle", "time": 3258.23, "timestamp": "00:54:18", "text": "あなたはどうですか？"}, {"type": "subtitle", "time": 3260.47, "timestamp": "00:54:20", "text": "わからない。おお。"}, {"type": "subtitle", "time": 3263.91, "timestamp": "00:54:23", "text": "えっ、今何が起こったの？わかった。"}, {"type": "subtitle", "time": 3266.47, "timestamp": "00:54:26", "text": "私自身は、よく分かりません。どれでも構いません"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "自分が楽しんでいる限りゲームを続ける"}, {"type": "subtitle", "time": 3271.109, "timestamp": "00:54:31", "text": "今。"}, {"type": "subtitle", "time": 3273.91, "timestamp": "00:54:33", "text": "ああ、なるほど。"}, {"type": "subtitle", "time": 3278.549, "timestamp": "00:54:38", "text": "えっと、私はどんなゲームをプレイしていたのでしょうか"}, {"type": "subtitle", "time": 3287.829, "timestamp": "00:54:47", "text": "うん、リーパーは楽しかったよ。その"}, {"type": "subtitle", "time": 3290.15, "timestamp": "00:54:50", "text": "リーパーは本当に良い。うん。うん。"}, {"type": "subtitle", "time": 3293.03, "timestamp": "00:54:53", "text": "時には怖いこともあるけれど、"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "そうそう。"}]
[{"type": "subtitle", "time": 4020.069, "timestamp": "01:07:00", "text": "ウム抽出または私たちは"}, {"type": "subtitle", "time": 4022.549, "timestamp": "01:07:02", "text": "最後にする。"}, {"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "ああ、液体物ですね。こぼれるだろう。私"}, {"type": "subtitle", "time": 4028.069, "timestamp": "01:07:08", "text": "思った通り、これはこぼれる。"}, {"type": "subtitle", "time": 4030.789, "timestamp": "01:07:10", "text": "ええ、"}, {"type": "subtitle", "time": 4033.91, "timestamp": "01:07:13", "text": "ティーセットも手に入れました"}, {"type": "subtitle", "time": 4036.39, "timestamp": "01:07:16", "text": "2人とあなたを迎えに行く"}, {"type": "subtitle", "time": 4040.39, "timestamp": "01:07:20", "text": "どれも手放せないんだよ。"}, {"type": "subtitle", "time": 4043.19, "timestamp": "01:07:23", "text": "さもないと、"}, {"type": "subtitle", "time": 4046.23, "timestamp": "01:07:26", "text": "全部だよ、わかるだろ、"}, {"type": "subtitle", "time": 4049.99, "timestamp": "01:07:29", "text": "あなたは自分の高価なものを全部壊してしまう。"}, {"type": "subtitle", "time": 4058.95, "timestamp": "01:07:38", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 4066.789, "timestamp": "01:07:46", "text": "それは何ですか？ああ、それは「あなたはしたいですか」です"}]
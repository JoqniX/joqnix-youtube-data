[{"type": "subtitle", "time": 12246.309, "timestamp": "03:24:06", "text": "ジューシーでとても美味しい。"}, {"type": "subtitle", "time": 12248.309, "timestamp": "03:24:08", "text": "でもイチゴがもっと"}, {"type": "subtitle", "time": 12251.99, "timestamp": "03:24:11", "text": "可愛いというより、甘い。いいえ、すでに"}, {"type": "subtitle", "time": 12258.309, "timestamp": "03:24:18", "text": "[音楽]"}, {"type": "subtitle", "time": 12262.309, "timestamp": "03:24:22", "text": "だから私たちは毎日それを食べなければならなかった"}, {"type": "subtitle", "time": 12271.91, "timestamp": "03:24:31", "text": "彼は歩み寄ってこなかった。歩いて上がってください。バナナはどうですか"}, {"type": "subtitle", "time": 12275.59, "timestamp": "03:24:35", "text": "何をしているの？どういう意味ですか？"}, {"type": "subtitle", "time": 12276.92, "timestamp": "03:24:36", "text": "バナナ。"}, {"type": "subtitle", "time": 12278.55, "timestamp": "03:24:38", "text": "[音楽]"}]
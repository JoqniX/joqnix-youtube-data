[{"type": "subtitle", "time": 2882.39, "timestamp": "00:48:02", "text": "それはゲームだった。ああ、ゲーム。わかった"}, {"type": "subtitle", "time": 2886.47, "timestamp": "00:48:06", "text": "ゲーム。わかった。わかった。このドアを動かさせてください"}, {"type": "subtitle", "time": 2898.95, "timestamp": "00:48:18", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 2901.67, "timestamp": "00:48:21", "text": "タブキーを押して地図を表示していますか？"}, {"type": "subtitle", "time": 2905.589, "timestamp": "00:48:25", "text": "良い？ああ、そうだね。はい。"}, {"type": "subtitle", "time": 2907.48, "timestamp": "00:48:27", "text": "そこにある。"}, {"type": "subtitle", "time": 2929.349, "timestamp": "00:48:49", "text": "ああ、ここにはたくさんの物がある。おお。おお、"}, {"type": "subtitle", "time": 2931.109, "timestamp": "00:48:51", "text": "アヒル。"}, {"type": "subtitle", "time": 2933.75, "timestamp": "00:48:53", "text": "アヒルに気を付けて。触らないでください"}, {"type": "subtitle", "time": 2935.67, "timestamp": "00:48:55", "text": "あれ、どこかにトイレがあったっけ？"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "ああ、あった"}]
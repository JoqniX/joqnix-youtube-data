[{"type": "subtitle", "time": 20040.39, "timestamp": "05:34:00", "text": "でもそうですね、"}, {"type": "subtitle", "time": 20043.51, "timestamp": "05:34:03", "text": "ついに成功した。ついにできた"}, {"type": "subtitle", "time": 20045.03, "timestamp": "05:34:05", "text": "けれど。"}, {"type": "subtitle", "time": 20047.59, "timestamp": "05:34:07", "text": "著作権は保護されていません。私はしません"}, {"type": "subtitle", "time": 20049.83, "timestamp": "05:34:09", "text": "理由を知りなさい。"}, {"type": "subtitle", "time": 20053.35, "timestamp": "05:34:13", "text": "でも、ついにGTA Vをクリアしました。"}, {"type": "subtitle", "time": 20056.708, "timestamp": "05:34:16", "text": "ずっとクリアしたかったゲーム"}, {"type": "subtitle", "time": 20060.708, "timestamp": "05:34:20", "text": "今。チャットで皆さんと一緒にやったんですか？"}, {"type": "subtitle", "time": 20063.35, "timestamp": "05:34:23", "text": "はい。今すぐオンラインでプレイしたいですか？私"}, {"type": "subtitle", "time": 20066.47, "timestamp": "05:34:26", "text": "わからない。私はそれをプレイできますが、"}, {"type": "subtitle", "time": 20068.948, "timestamp": "05:34:28", "text": "私は少しだけ感じます、なぜなら私はすでに"}, {"type": "subtitle", "time": 20077.27, "timestamp": "05:34:37", "text": "でも、ついに完成しました。そして"}, {"type": "subtitle", "time": 20079.99, "timestamp": "05:34:39", "text": "今日の配信が終わったので、ついに"}, {"type": "subtitle", "time": 20084.39, "timestamp": "05:34:44", "text": "これをアンインストールして、この章を閉じてください。"}, {"type": "subtitle", "time": 20087.75, "timestamp": "05:34:47", "text": "はい。そして、いくつか仕上げなければならない"}, {"type": "subtitle", "time": 20092.628, "timestamp": "05:34:52", "text": "ゲームをアンインストールできるようにしたいんです。"}, {"type": "subtitle", "time": 20095.19, "timestamp": "05:34:55", "text": "必要なのは、いくつかゲームがある"}, {"type": "subtitle", "time": 20097.83, "timestamp": "05:34:57", "text": "終わらせたい。 5分かかる"}]
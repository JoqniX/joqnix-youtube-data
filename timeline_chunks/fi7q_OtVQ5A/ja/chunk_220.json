[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "ああ、本当にそうだ。しかし"}, {"type": "subtitle", "time": 13204.309, "timestamp": "03:40:04", "text": "えーと"}, {"type": "subtitle", "time": 13206.229, "timestamp": "03:40:06", "text": "いやいやいやいや"}, {"type": "subtitle", "time": 13210.07, "timestamp": "03:40:10", "text": "海石に会ったんだけど、えっと、彼は"}, {"type": "subtitle", "time": 13215.349, "timestamp": "03:40:15", "text": "猿漁師が言う「mf」という言葉を言う"}, {"type": "subtitle", "time": 13218.389, "timestamp": "03:40:18", "text": "羽毛、それはとてもクールでとても"}, {"type": "subtitle", "time": 13221.91, "timestamp": "03:40:21", "text": "言葉よりも良い"}, {"type": "subtitle", "time": 13224.55, "timestamp": "03:40:24", "text": "猿の羽"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "それは良いことなので、私は"}, {"type": "subtitle", "time": 13229.429, "timestamp": "03:40:29", "text": "言葉"}, {"type": "subtitle", "time": 13245.429, "timestamp": "03:40:45", "text": "バカ。いや、トラック運転手というのは言い過ぎだ。トラック運転手"}, {"type": "subtitle", "time": 13248.229, "timestamp": "03:40:48", "text": "森に近い。トラック運転手は使いません。"}, {"type": "subtitle", "time": 13251.67, "timestamp": "03:40:51", "text": "心配事が一つ減った。"}, {"type": "subtitle", "time": 13253.99, "timestamp": "03:40:53", "text": "はぁ？"}, {"type": "subtitle", "time": 13258.15, "timestamp": "03:40:58", "text": "さて、次は。最後です。"}]
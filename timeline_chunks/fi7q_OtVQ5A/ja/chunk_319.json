[{"type": "subtitle", "time": 19153.43, "timestamp": "05:19:13", "text": "ああ、神様。神。神。またやります。私たちはそうします"}, {"type": "subtitle", "time": 19179.75, "timestamp": "05:19:39", "text": "さあ行こう。"}, {"type": "subtitle", "time": 19182.31, "timestamp": "05:19:42", "text": "待っていてください。これは明白だ。それは線です"}, {"type": "subtitle", "time": 19185.19, "timestamp": "05:19:45", "text": "視覚のことだと私は思います。"}, {"type": "subtitle", "time": 19195.43, "timestamp": "05:19:55", "text": "H. 大丈夫です。大丈夫です。リセットします。"}]
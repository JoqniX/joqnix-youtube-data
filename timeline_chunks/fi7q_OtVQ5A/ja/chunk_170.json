[{"type": "subtitle", "time": 10203.67, "timestamp": "02:50:03", "text": "いや、7月に買ったんだけど、それから8月にも買ったんだ。"}, {"type": "subtitle", "time": 10207.349, "timestamp": "02:50:07", "text": "だからおそらく9月まで時間があるだろう"}, {"type": "subtitle", "time": 10209.83, "timestamp": "02:50:09", "text": "無料のものを手に入れよう"}, {"type": "subtitle", "time": 10212.63, "timestamp": "02:50:12", "text": "無料トライアルみたいなものかな。私はできる"}, {"type": "subtitle", "time": 10215.429, "timestamp": "02:50:15", "text": "キャンセルしてください。キャンセルして"}, {"type": "subtitle", "time": 10217.83, "timestamp": "02:50:17", "text": "お金を返してくれ。"}, {"type": "subtitle", "time": 10220.55, "timestamp": "02:50:20", "text": "しかし、私がそれをしない理由は"}, {"type": "subtitle", "time": 10230.95, "timestamp": "02:50:30", "text": "うん。 VRチャットが追加され、彼はチートをしました。それで"}, {"type": "subtitle", "time": 10234.95, "timestamp": "02:50:34", "text": "SGEではもうMODは使えません。"}, {"type": "subtitle", "time": 10237.51, "timestamp": "02:50:37", "text": "もうMODも使えません。それは"}, {"type": "subtitle", "time": 10239.269, "timestamp": "02:50:39", "text": "痛み。"}, {"type": "subtitle", "time": 10241.67, "timestamp": "02:50:41", "text": "あのね？ピューピューと撃ちに行こうかな。"}, {"type": "subtitle", "time": 10245.03, "timestamp": "02:50:45", "text": "さあ行こう。さあ、このゲームを始めよう。待って。"}, {"type": "subtitle", "time": 10248.15, "timestamp": "02:50:48", "text": "ピューピューと撃ちたい。クンカ。どこ"}, {"type": "subtitle", "time": 10249.83, "timestamp": "02:50:49", "text": "クンカ？"}, {"type": "subtitle", "time": 10252.07, "timestamp": "02:50:52", "text": "参加してみませんか？"}, {"type": "subtitle", "time": 10255.19, "timestamp": "02:50:55", "text": "しかし、インターネットを使用します。"}, {"type": "subtitle", "time": 10257.19, "timestamp": "02:50:57", "text": "待って、終わったよ。あ、待って。完了しました。その"}, {"type": "subtitle", "time": 10258.71, "timestamp": "02:50:58", "text": "終わり。わかった。待って。さあ行こう。さあ行こう。"}]
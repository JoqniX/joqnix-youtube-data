[{"type": "subtitle", "time": 1204.95, "timestamp": "00:20:04", "text": "チームメイトと虫を殺す"}, {"type": "subtitle", "time": 1207.35, "timestamp": "00:20:07", "text": "ティトサウルス。"}, {"type": "subtitle", "time": 1210.15, "timestamp": "00:20:10", "text": "ああ、弾丸は10発あるよ。私はただ"}, {"type": "subtitle", "time": 1213.43, "timestamp": "00:20:13", "text": "私が知っているトリックをすべて実行します"}, {"type": "subtitle", "time": 1228.71, "timestamp": "00:20:28", "text": "ウェインはあなたと一緒にいます。ああ、ジャックは"}, {"type": "subtitle", "time": 1231.669, "timestamp": "00:20:31", "text": "私と一緒に。ところで、ウェインはどこにいるの？"}, {"type": "subtitle", "time": 1233.38, "timestamp": "00:20:33", "text": "おお、"}, {"type": "subtitle", "time": 1238.63, "timestamp": "00:20:38", "text": "いやいや、心配しないで。私は私はサポートします私は"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "君のために鎮火活動をするようなものだ。こんにちは。"}, {"type": "subtitle", "time": 1244.87, "timestamp": "00:20:44", "text": "私はここにいます。そうそう。伏せろ。ああ、彼は"}, {"type": "subtitle", "time": 1247.83, "timestamp": "00:20:47", "text": "亡くなった。おお、いいね。わかった。はい、私は"}, {"type": "subtitle", "time": 1249.59, "timestamp": "00:20:49", "text": "かなり鎮圧射撃"}, {"type": "subtitle", "time": 1256.47, "timestamp": "00:20:56", "text": "君がやることなんて、どれも壮大なことじゃないよ、友よ。私"}, {"type": "subtitle", "time": 1258.789, "timestamp": "00:20:58", "text": "かわした。ウェイン、あっちへ行け。旅行先"}]
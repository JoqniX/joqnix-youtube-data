[{"type": "subtitle", "time": 10803.91, "timestamp": "03:00:03", "text": "それは正しいものではないので、私は"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "えっと、何か必要なんです。なぜならアメリカだからです"}, {"type": "subtitle", "time": 10812.389, "timestamp": "03:00:12", "text": "州全体、すべての都市には"}, {"type": "subtitle", "time": 10814.389, "timestamp": "03:00:14", "text": "都市や州によって時間が異なる"}, {"type": "subtitle", "time": 10818.87, "timestamp": "03:00:18", "text": "ゾーン。私は「えっ？」って感じでした。どうやって？私はしませんでした"}, {"type": "subtitle", "time": 10821.99, "timestamp": "03:00:21", "text": "今日までそのことを知らなかった。今日はダメだ。いいえ、"}, {"type": "subtitle", "time": 10828.309, "timestamp": "03:00:28", "text": "だから、例えば「USA」と入力すると"}, {"type": "subtitle", "time": 10830.309, "timestamp": "03:00:30", "text": "このVPNでは、これは異なる"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "都市とかそういうもの。"}, {"type": "subtitle", "time": 10835.99, "timestamp": "03:00:35", "text": "なぜ一箇所に絞らないのか？"}, {"type": "subtitle", "time": 10839.269, "timestamp": "03:00:39", "text": "例えば東京の場合、東京時間"}, {"type": "subtitle", "time": 10841.59, "timestamp": "03:00:41", "text": "ゾーンとかそういうの、私たちは日本人じゃない"}, {"type": "subtitle", "time": 10845.67, "timestamp": "03:00:45", "text": "タイムゾーンとかそういうこと。えっと、東京って入力するだけ"}, {"type": "subtitle", "time": 10848.23, "timestamp": "03:00:48", "text": "そして、日本の時間を取得します。"}, {"type": "subtitle", "time": 10850.63, "timestamp": "03:00:50", "text": "右？私がここでやったように。中国の場合、"}, {"type": "subtitle", "time": 10853.11, "timestamp": "03:00:53", "text": "北京のやつならできます。"}, {"type": "subtitle", "time": 10855.91, "timestamp": "03:00:55", "text": "しかし、ここにいる私たちにとって、どのように"}, {"type": "subtitle", "time": 10858.55, "timestamp": "03:00:58", "text": "場所によって時間が異なるのはなぜか"}]
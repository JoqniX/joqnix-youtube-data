[{"type": "subtitle", "time": 9661.75, "timestamp": "02:41:01", "text": "わかった。どのように進めたいですか？"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "あなたの配信なので、私が作らないわけにはいきません"}, {"type": "subtitle", "time": 9669.91, "timestamp": "02:41:09", "text": "あなたにとっては簡単ですか？いいえ。いいえ。"}, {"type": "subtitle", "time": 9671.59, "timestamp": "02:41:11", "text": "何を待っているの？私は右に立っています"}, {"type": "subtitle", "time": 9673.59, "timestamp": "02:41:13", "text": "空気のすぐそばに。聞いたよ、聞いたよ"}, {"type": "subtitle", "time": 9676.07, "timestamp": "02:41:16", "text": "彼らはカップが"}, {"type": "subtitle", "time": 9678.15, "timestamp": "02:41:18", "text": "カップを持つと放射線を浴びる"}, {"type": "subtitle", "time": 9680.389, "timestamp": "02:41:20", "text": "あるいは、そんな感じ。待って、いや、彼らはすでに"}, {"type": "subtitle", "time": 9683.59, "timestamp": "02:41:23", "text": "それは済ませました。だからもしあなたが"}, {"type": "subtitle", "time": 9688.309, "timestamp": "02:41:28", "text": "手に取ると、すでに"}, {"type": "subtitle", "time": 9691.429, "timestamp": "02:41:31", "text": "うーん、パチパチ音がする。そして、これをすれば、"}, {"type": "subtitle", "time": 9695.75, "timestamp": "02:41:35", "text": "よく見えるよ、うん、聞こえるよ"}, {"type": "subtitle", "time": 9698.469, "timestamp": "02:41:38", "text": "そうですよね？うん。つまり、もしあなたが"}, {"type": "subtitle", "time": 9701.19, "timestamp": "02:41:41", "text": "それが放射されている間、もしあなたが"}, {"type": "subtitle", "time": 9705.99, "timestamp": "02:41:45", "text": "壊せば、"}, {"type": "subtitle", "time": 9708.469, "timestamp": "02:41:48", "text": "はい、どうぞ。放射線。"}, {"type": "subtitle", "time": 9712.07, "timestamp": "02:41:52", "text": "ああ、それは影響する"}, {"type": "subtitle", "time": 9713.67, "timestamp": "02:41:53", "text": "おお、"}, {"type": "subtitle", "time": 9716.79, "timestamp": "02:41:56", "text": "それは既にそこにある。おお。はい、そうです"}]
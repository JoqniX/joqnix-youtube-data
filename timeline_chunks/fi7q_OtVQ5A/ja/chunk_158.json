[{"type": "subtitle", "time": 9482.71, "timestamp": "02:38:02", "text": "よし。ああ、この車は置いていっていいですよ"}, {"type": "subtitle", "time": 9485.51, "timestamp": "02:38:05", "text": "あそこだ。わからない。私は"}, {"type": "subtitle", "time": 9487.429, "timestamp": "02:38:07", "text": "よし。えっと、行き止まりですか？ああ、それは"}, {"type": "subtitle", "time": 9489.59, "timestamp": "02:38:09", "text": "行き止まりだ。ああ、だから私は去るんだ"}, {"type": "subtitle", "time": 9491.27, "timestamp": "02:38:11", "text": "それを持ち上げる。"}, {"type": "subtitle", "time": 9492.71, "timestamp": "02:38:12", "text": "ダウンや"}, {"type": "subtitle", "time": 9496.309, "timestamp": "02:38:16", "text": "2階へは車を停めておくのが一番です"}, {"type": "subtitle", "time": 9504.55, "timestamp": "02:38:24", "text": "えっと、抽出方法を見つける必要があるだけです。おお、"}, {"type": "subtitle", "time": 9506.55, "timestamp": "02:38:26", "text": "下の方にある。そこに"}, {"type": "subtitle", "time": 9511.75, "timestamp": "02:38:31", "text": "それは、私たちの古いレコードプレーヤーのようなものでした。"}, {"type": "subtitle", "time": 9515.19, "timestamp": "02:38:35", "text": "おお。ああ、気にしないで。それは問題ではありません。"}, {"type": "subtitle", "time": 9517.27, "timestamp": "02:38:37", "text": "さらに良いものをご用意しました。の"}]
[{"type": "subtitle", "time": 11220.55, "timestamp": "03:07:00", "text": "GTAを持っている。"}, {"type": "subtitle", "time": 11224.309, "timestamp": "03:07:04", "text": "確かGTAのプロフィール持ってるはずですよね？"}, {"type": "subtitle", "time": 11226.55, "timestamp": "03:07:06", "text": "私はしません。何？"}, {"type": "subtitle", "time": 11233.99, "timestamp": "03:07:13", "text": "私はそうは思いません。わかった、気にしないで。それから、えーと"}, {"type": "subtitle", "time": 11235.91, "timestamp": "03:07:15", "text": "ゲームに戻りましょう。遊ぼう"}, {"type": "subtitle", "time": 11237.51, "timestamp": "03:07:17", "text": "それ。"}, {"type": "subtitle", "time": 11239.75, "timestamp": "03:07:19", "text": "ストーリーモードを開いて、それからこれ"}, {"type": "subtitle", "time": 11243.51, "timestamp": "03:07:23", "text": "男。でも、クラウドに保存する必要があるんですよね？"}, {"type": "subtitle", "time": 11246.79, "timestamp": "03:07:26", "text": "クラウドに保存されるはずですよね？必ず"}, {"type": "subtitle", "time": 11248.95, "timestamp": "03:07:28", "text": "クラウド保存。"}, {"type": "subtitle", "time": 11250.87, "timestamp": "03:07:30", "text": "でも、それでいいんです。私はちょっとそうしたい"}, {"type": "subtitle", "time": 11253.67, "timestamp": "03:07:33", "text": "ゲーム。えっと、犬さん、当ててみますか？"}, {"type": "subtitle", "time": 11257.59, "timestamp": "03:07:37", "text": "別の言語の単語ですか？はい。"}, {"type": "subtitle", "time": 11260.87, "timestamp": "03:07:40", "text": "チュアは"}, {"type": "subtitle", "time": 11263.99, "timestamp": "03:07:43", "text": "チュハ。ああ、ネズミ。"}, {"type": "subtitle", "time": 11274.309, "timestamp": "03:07:54", "text": "これは光速ですか？忘れた。これですか"}, {"type": "subtitle", "time": 11277.19, "timestamp": "03:07:57", "text": "光速？"}]
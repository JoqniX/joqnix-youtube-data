[{"type": "subtitle", "time": 5340.55, "timestamp": "01:29:00", "text": "ベビーベッドを丸ごと入れるつもりじゃないの？"}, {"type": "subtitle", "time": 5342.47, "timestamp": "01:29:02", "text": "全部買おうと思ってたんだ。おお、"}, {"type": "subtitle", "time": 5343.99, "timestamp": "01:29:03", "text": "待って。そうそう。はい、あります"}, {"type": "subtitle", "time": 5346.629, "timestamp": "01:29:06", "text": "抽出のことですよね？わかった。わかった。うん、"}, {"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "2つあります。うん。わかった。いつも"}, {"type": "subtitle", "time": 5352.47, "timestamp": "01:29:12", "text": "いつも、隣に"}, {"type": "subtitle", "time": 5356.47, "timestamp": "01:29:16", "text": "お金は、あなたが何回抽出したかによって決まります。"}, {"type": "subtitle", "time": 5358.31, "timestamp": "01:29:18", "text": "2つあります。これが最初のものです。"}, {"type": "subtitle", "time": 5361.59, "timestamp": "01:29:21", "text": "さて、次はもう一方を見つけなければならない。うん。"}, {"type": "subtitle", "time": 5368.95, "timestamp": "01:29:28", "text": "[音楽]"}, {"type": "subtitle", "time": 5371.35, "timestamp": "01:29:31", "text": "おかえり。"}, {"type": "subtitle", "time": 5374.39, "timestamp": "01:29:34", "text": "わーい。戻る。納税申告書。税金はかかりません"}, {"type": "subtitle", "time": 5382.07, "timestamp": "01:29:42", "text": "あ、待って。それは私たちの中にあります。ああ、ここにあります。"}, {"type": "subtitle", "time": 5384.229, "timestamp": "01:29:44", "text": "わかった。わかった。それはそこにある。それは"}]
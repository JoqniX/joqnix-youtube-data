[{"type": "subtitle", "time": 12962.79, "timestamp": "03:36:02", "text": "子犬の鳴き声。お辞儀。"}, {"type": "subtitle", "time": 12966.309, "timestamp": "03:36:06", "text": "吠え方と詰め方。私は見た 私は見た"}, {"type": "subtitle", "time": 12977.91, "timestamp": "03:36:17", "text": "タクシーにそんなことできるわけないだろ。"}, {"type": "subtitle", "time": 12985.429, "timestamp": "03:36:25", "text": "どうやってやるの？"}, {"type": "subtitle", "time": 12989.349, "timestamp": "03:36:29", "text": "ああ、子犬の鳴き声。"}, {"type": "subtitle", "time": 12992.15, "timestamp": "03:36:32", "text": "お辞儀。"}, {"type": "subtitle", "time": 12994.63, "timestamp": "03:36:34", "text": "ワンワン。"}, {"type": "subtitle", "time": 12997.269, "timestamp": "03:36:37", "text": "わあ、すごい。聞こえますか？"}, {"type": "subtitle", "time": 13001.349, "timestamp": "03:36:41", "text": "ゴミ箱を拾っているのですか、奥様？"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "えっと、私の話の途中ですみません"}, {"type": "subtitle", "time": 13006.55, "timestamp": "03:36:46", "text": "家。"}, {"type": "subtitle", "time": 13019.51, "timestamp": "03:36:59", "text": "待って、これは私が求めている色ではない。"}]
[{"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "ああ、ここにはたくさんの物が入っているね。"}, {"type": "subtitle", "time": 4934.79, "timestamp": "01:22:14", "text": "ねえ、ゲームを壊しちゃったの？"}, {"type": "subtitle", "time": 4945.669, "timestamp": "01:22:25", "text": "ああ、何てふわふわしたやつ？それは何ですか？おお、"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "ふわふわした感じが大好き。すごく可愛い。ああ、"}, {"type": "subtitle", "time": 4954.55, "timestamp": "01:22:34", "text": "神、"}, {"type": "subtitle", "time": 4957.03, "timestamp": "01:22:37", "text": "悪態をついているのは私ではありません。それで私は、"}, {"type": "subtitle", "time": 4960.629, "timestamp": "01:22:40", "text": "ふわふわ？うん。うん、それはすごくいいことだね。"}, {"type": "subtitle", "time": 4964.55, "timestamp": "01:22:44", "text": "それは単語です。ふわふわ。それは素晴らしいですね。私"}, {"type": "subtitle", "time": 4967.99, "timestamp": "01:22:47", "text": "魚か何かについて誓うよ。"}]
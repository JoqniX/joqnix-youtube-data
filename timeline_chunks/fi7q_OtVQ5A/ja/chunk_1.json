[{"type": "subtitle", "time": 60.47, "timestamp": "00:01:00", "text": "ゆっくりしてください。大丈夫。"}, {"type": "subtitle", "time": 62.47, "timestamp": "00:01:02", "text": "ああ、でもチャットを読んでたんだよ。待って、"}, {"type": "subtitle", "time": 64.869, "timestamp": "00:01:04", "text": "チャットを読むときはミュートにした方がいいですか？"}, {"type": "subtitle", "time": 69.109, "timestamp": "00:01:09", "text": "それは、ええと、私もそうするつもりです"}, {"type": "subtitle", "time": 71.429, "timestamp": "00:01:11", "text": "防具を手に入れろ。どうでも。ああ、そうだよ。あなた"}, {"type": "subtitle", "time": 74.149, "timestamp": "00:01:14", "text": "あなたは。大丈夫です。"}, {"type": "subtitle", "time": 76.87, "timestamp": "00:01:16", "text": "チャットを読むことのみ可能です。大丈夫です。"}, {"type": "subtitle", "time": 85.99, "timestamp": "00:01:25", "text": "いいね。絶好調だよ。"}, {"type": "subtitle", "time": 87.91, "timestamp": "00:01:27", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 90.31, "timestamp": "00:01:30", "text": "おっと、こいつは軽装甲だ。君たち"}, {"type": "subtitle", "time": 93.10900000000001, "timestamp": "00:01:33", "text": "必要だ。"}, {"type": "subtitle", "time": 95.429, "timestamp": "00:01:35", "text": "弾薬。 H. 周りをかき集めればいいんです。"}, {"type": "subtitle", "time": 99.35, "timestamp": "00:01:39", "text": "大丈夫です。わかった。待って、私たちは"}, {"type": "subtitle", "time": 103.03, "timestamp": "00:01:43", "text": "丸？はい、私たちは、"}, {"type": "subtitle", "time": 104.63, "timestamp": "00:01:44", "text": "丸。"}, {"type": "subtitle", "time": 107.429, "timestamp": "00:01:47", "text": "なかなかいいと思うよ。"}, {"type": "subtitle", "time": 110.55, "timestamp": "00:01:50", "text": "私はそうは思いません。それは良くありません。"}, {"type": "subtitle", "time": 113.429, "timestamp": "00:01:53", "text": "痛い。ちくしょう。ちょうど私が上げたところ"}, {"type": "subtitle", "time": 116.22999999999999, "timestamp": "00:01:56", "text": "弾薬。お前はバカな噛みつき野郎だ。"}, {"type": "subtitle", "time": 118.469, "timestamp": "00:01:58", "text": "おお、レベル3のバックパックだ。お見せしましょう"}, {"type": "subtitle", "time": 119.99000000000001, "timestamp": "00:01:59", "text": "あなた。"}]
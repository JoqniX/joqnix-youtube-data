[{"type": "subtitle", "time": 9842.55, "timestamp": "02:44:02", "text": "皆さん、以上がエリーでした。エリー"}, {"type": "subtitle", "time": 9844.87, "timestamp": "02:44:04", "text": "氷の女神。"}, {"type": "subtitle", "time": 9847.19, "timestamp": "02:44:07", "text": "もしあなたが今日アリサンの会社を楽しんでいるなら、"}, {"type": "subtitle", "time": 9851.75, "timestamp": "02:44:11", "text": "彼女のYouTubeチャンネルをぜひフォローしてください。そして"}, {"type": "subtitle", "time": 9853.429, "timestamp": "02:44:13", "text": "彼女はTwitchアカウントも持っている"}, {"type": "subtitle", "time": 9856.23, "timestamp": "02:44:16", "text": "彼女が最近作ったものだと思います。えっと"}, {"type": "subtitle", "time": 9858.389, "timestamp": "02:44:18", "text": "アリサがそこで配信しているかどうかはわかりませんが"}, {"type": "subtitle", "time": 9862.309, "timestamp": "02:44:22", "text": "そう、YouTube。彼女のYouTubeチャンネルをフォローしてください。"}, {"type": "subtitle", "time": 9864.469, "timestamp": "02:44:24", "text": "わーい。"}, {"type": "subtitle", "time": 9871.91, "timestamp": "02:44:31", "text": "はい。はい。"}, {"type": "subtitle", "time": 9874.79, "timestamp": "02:44:34", "text": "そのため、それらとリンクは"}, {"type": "subtitle", "time": 9876.389, "timestamp": "02:44:36", "text": "説明と固定されたコメント"}, {"type": "subtitle", "time": 9879.75, "timestamp": "02:44:39", "text": "すべてのプラットフォーム。どうぞお気軽にフォローしてください。"}]
[{"type": "subtitle", "time": 480.23, "timestamp": "00:08:00", "text": "それについて心配してください。イエス。ああ、私は違う"}, {"type": "subtitle", "time": 484.15, "timestamp": "00:08:04", "text": "それで、私は"}, {"type": "subtitle", "time": 494.469, "timestamp": "00:08:14", "text": "来る。"}, {"type": "subtitle", "time": 498.23, "timestamp": "00:08:18", "text": "ああ、彼は落ちている。ええと、わかりました。ジャックは"}, {"type": "subtitle", "time": 499.99, "timestamp": "00:08:19", "text": "内部。ごめんなさい。 4という数字は"}, {"type": "subtitle", "time": 504.15, "timestamp": "00:08:24", "text": "外。ごめんなさい。"}, {"type": "subtitle", "time": 507.83, "timestamp": "00:08:27", "text": "空輸が来るぞ。"}, {"type": "subtitle", "time": 511.83, "timestamp": "00:08:31", "text": "そうそう。こんにちは、コディ・ライオンさん。ライオノル、どうやって"}, {"type": "subtitle", "time": 513.67, "timestamp": "00:08:33", "text": "あなたの名前は正しく発音しますか？元気かい？"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "えっと、実は私のスマホのUIが好きで、"}, {"type": "subtitle", "time": 518.31, "timestamp": "00:08:38", "text": "不安定だ。だから、私の"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "マザーボード。そこで私は保証を請求し"}, {"type": "subtitle", "time": 523.67, "timestamp": "00:08:43", "text": "交換してください。ああ、お元気ですか？あ、待って。"}, {"type": "subtitle", "time": 525.35, "timestamp": "00:08:45", "text": "マックスは自分の携帯電話について話しています。"}, {"type": "subtitle", "time": 527.59, "timestamp": "00:08:47", "text": "方法。"}, {"type": "subtitle", "time": 529.269, "timestamp": "00:08:49", "text": "彼は自分のことについて話していると思う"}, {"type": "subtitle", "time": 531.43, "timestamp": "00:08:51", "text": "マザーボードか、いや、いや、マザーボードではない。"}, {"type": "subtitle", "time": 532.949, "timestamp": "00:08:52", "text": "えっと、彼は自分の携帯電話について話しているのか、それとも"}, {"type": "subtitle", "time": 537.43, "timestamp": "00:08:57", "text": "コンピューターみたい？ここはここです。"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "彼は自分の携帯電話のことを言っているのだと思う。"}]
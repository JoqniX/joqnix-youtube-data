[{"type": "subtitle", "time": 2341.349, "timestamp": "00:39:01", "text": "では、次は私の番です。願っています。指"}, {"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "交差した。"}, {"type": "subtitle", "time": 2346.47, "timestamp": "00:39:06", "text": "うん。えっと、招待状は届きましたか？私はそうしました"}, {"type": "subtitle", "time": 2350.87, "timestamp": "00:39:10", "text": "わからなかった。ああ、今わかった。わかった。"}, {"type": "subtitle", "time": 2354.31, "timestamp": "00:39:14", "text": "持続する。私のパソコン。それで、"}, {"type": "subtitle", "time": 2361.67, "timestamp": "00:39:21", "text": "ああ、そうだったの？"}, {"type": "subtitle", "time": 2364.63, "timestamp": "00:39:24", "text": "ゲームをアップデートしましたか？なぜなら、あなたは"}, {"type": "subtitle", "time": 2366.31, "timestamp": "00:39:26", "text": "ベータ版を実施する場合は変更してください"}, {"type": "subtitle", "time": 2373.349, "timestamp": "00:39:33", "text": "バージョン。おお。そうそう。はい、そうしました。ああ、わかりました。"}, {"type": "subtitle", "time": 2376.39, "timestamp": "00:39:36", "text": "何か書いてありますか？"}, {"type": "subtitle", "time": 2378.95, "timestamp": "00:39:38", "text": "「in」ではなく「on」と書いてあったので追い出されました"}, {"type": "subtitle", "time": 2383.48, "timestamp": "00:39:43", "text": "最新バージョンまたは"}, {"type": "subtitle", "time": 2389.75, "timestamp": "00:39:49", "text": "えっと、こう書いてあります"}, {"type": "subtitle", "time": 2391.589, "timestamp": "00:39:51", "text": "ベータ。"}, {"type": "subtitle", "time": 2395.829, "timestamp": "00:39:55", "text": "以前にベータ版はありましたか？"}, {"type": "subtitle", "time": 2398.47, "timestamp": "00:39:58", "text": "ゲームのバージョンを確認するにはどうすればいいですか？"}]
[{"type": "subtitle", "time": 6020.95, "timestamp": "01:40:20", "text": "待って。彼らはあなたを追い出す。"}, {"type": "subtitle", "time": 6024.95, "timestamp": "01:40:24", "text": "うん、限度があるよね。うわあ。の"}, {"type": "subtitle", "time": 6027.109, "timestamp": "01:40:27", "text": "誰かを速く押せば押すほど、"}, {"type": "subtitle", "time": 6044.629, "timestamp": "01:40:44", "text": "我々は勝利する"}, {"type": "subtitle", "time": 6046.95, "timestamp": "01:40:46", "text": "レベルが十分良ければ。おお、"}, {"type": "subtitle", "time": 6050.79, "timestamp": "01:40:50", "text": "ついに。少なくとも、あの豪邸じゃないのは幸いだ。"}]
[{"type": "subtitle", "time": 3069.51, "timestamp": "00:51:09", "text": "よし、来い。来て。待って。私に従ってください。"}, {"type": "subtitle", "time": 3079.75, "timestamp": "00:51:19", "text": "アヒルちゃん。うん。"}, {"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "ああ、見て。私たちが持っているものを見てください。ここに来て。"}, {"type": "subtitle", "time": 3097.109, "timestamp": "00:51:37", "text": "わかった。ここです。準備完了。いいえ。"}, {"type": "subtitle", "time": 3119.589, "timestamp": "00:51:59", "text": "初めて見ました。なぜ？"}]
[{"type": "subtitle", "time": 6782.07, "timestamp": "01:53:02", "text": "行きたい場所ですよね？そう思います。"}, {"type": "subtitle", "time": 6789.589, "timestamp": "01:53:09", "text": "彼は"}, {"type": "subtitle", "time": 6791.91, "timestamp": "01:53:11", "text": "不時着。"}, {"type": "subtitle", "time": 6796.149, "timestamp": "01:53:16", "text": "いいえ、"}, {"type": "subtitle", "time": 6798.149, "timestamp": "01:53:18", "text": "これはいいですね。"}, {"type": "subtitle", "time": 6802.95, "timestamp": "01:53:22", "text": "またもや墜落事故だ。わかった。私は"}, {"type": "subtitle", "time": 6805.51, "timestamp": "01:53:25", "text": "押すだけで"}, {"type": "subtitle", "time": 6807.43, "timestamp": "01:53:27", "text": "シフトすると、バールを止めることができます"}, {"type": "subtitle", "time": 6815.99, "timestamp": "01:53:35", "text": "もう一度スペースキーを押さなければならない。"}, {"type": "subtitle", "time": 6823.51, "timestamp": "01:53:43", "text": "いやあ、楽しかったよ。"}, {"type": "subtitle", "time": 6825.669, "timestamp": "01:53:45", "text": "君たちならできるよ。"}, {"type": "subtitle", "time": 6827.189, "timestamp": "01:53:47", "text": "わかった。他に何か本当に"}, {"type": "subtitle", "time": 6831.91, "timestamp": "01:53:51", "text": "欲しい？家賃が高すぎて払えないから"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "かなりの金額。ああ、あなたは"}, {"type": "subtitle", "time": 6837.35, "timestamp": "01:53:57", "text": "もの？何が必要ですか？私は持っている。うん。私"}]
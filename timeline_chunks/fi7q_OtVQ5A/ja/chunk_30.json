[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "どの時点でも良いですか？はい。先ほども申し上げたように、"}, {"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "ウェインはそれが大嫌いだったし、私も大嫌いだった。それで、"}, {"type": "subtitle", "time": 1805.75, "timestamp": "00:30:05", "text": "私はこう思った。「あのね、知ってる？」私たちは"}, {"type": "subtitle", "time": 1808.07, "timestamp": "00:30:08", "text": "何かが必要だ。"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "うん。今までで一番ひどい試合だった"}, {"type": "subtitle", "time": 1813.51, "timestamp": "00:30:13", "text": "プレイしました。どこかに行って。どこかに行って。誰かの"}, {"type": "subtitle", "time": 1815.19, "timestamp": "00:30:15", "text": "撃たれてきたけど、気にしない。そして"}, {"type": "subtitle", "time": 1817.51, "timestamp": "00:30:17", "text": "お前は俺のM4を盗んだな。ねえ、知ってる？"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "何？私はあなたにM4をあげます。"}, {"type": "chat", "time": 1820.08, "timestamp": "00:30:20", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooooooo"}, {"type": "subtitle", "time": 1821.83, "timestamp": "00:30:21", "text": "ちょっとの間、一人にしてくれないか。うん。"}, {"type": "subtitle", "time": 1825.029, "timestamp": "00:30:25", "text": "こんにちは。いらっしゃいませ。いらっしゃいませ。わかった。私は必要としている"}, {"type": "subtitle", "time": 1828.07, "timestamp": "00:30:28", "text": "銃。銃が必要だ。何？死ぬ。"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "ああ。フック。フック。フック。誰かが入ってくる。"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "誰かが入ってくる。誰かが"}, {"type": "subtitle", "time": 1841.59, "timestamp": "00:30:41", "text": "来るよ。いや、いや。この男はただ私が必要としている"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "冥界。冥府をくれ。私はしません"}, {"type": "subtitle", "time": 1847.029, "timestamp": "00:30:47", "text": "ケア。ああ。えっと、誰かが私を撃ってる。"}, {"type": "subtitle", "time": 1848.71, "timestamp": "00:30:48", "text": "ヘルプ。"}, {"type": "subtitle", "time": 1854.389, "timestamp": "00:30:54", "text": "あなた。今、君を救ったところだ。"}, {"type": "subtitle", "time": 1855.909, "timestamp": "00:30:55", "text": "私"}, {"type": "subtitle", "time": 1859.269, "timestamp": "00:30:59", "text": "弾薬が必要だ。誰でも私にくれる"}]
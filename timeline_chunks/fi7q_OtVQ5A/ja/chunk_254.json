[{"type": "subtitle", "time": 15246.389, "timestamp": "04:14:06", "text": "死んだ。これで全部だと思います。"}, {"type": "subtitle", "time": 15252.389, "timestamp": "04:14:12", "text": "弾丸革命。私たちはいつも"}, {"type": "subtitle", "time": 15254.87, "timestamp": "04:14:14", "text": "お前を騙した。"}, {"type": "subtitle", "time": 15256.95, "timestamp": "04:14:16", "text": "車に乗っている他の全員。私たちは出発します"}, {"type": "subtitle", "time": 15258.79, "timestamp": "04:14:18", "text": "できるうちに。ねえ、何が私を止めているの？"}, {"type": "subtitle", "time": 15261.429, "timestamp": "04:14:21", "text": "夕日に向かって馬に乗って走り去る"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "サドルバッグ？レスターの唯一のフリップメタル"}, {"type": "subtitle", "time": 15278.95, "timestamp": "04:14:38", "text": "それは六つ星だ。ああ、なんてことだ。五つ星。ああ、"}, {"type": "subtitle", "time": 15291.67, "timestamp": "04:14:51", "text": "何てことだ。"}]
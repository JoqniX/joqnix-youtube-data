[{"type": "subtitle", "time": 541.91, "timestamp": "00:09:01", "text": "彼は反対側から私を撃っていると思う"}, {"type": "subtitle", "time": 544.31, "timestamp": "00:09:04", "text": "建物。"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "私の携帯電話。私はこのゲームを持っています。ああ、これは"}, {"type": "subtitle", "time": 548.949, "timestamp": "00:09:08", "text": "私はCall of Duty Mobileをプレイしていません"}, {"type": "subtitle", "time": 552.15, "timestamp": "00:09:12", "text": "しばらくの間、あるいは実際にはどんなモバイルゲームでも。それで"}, {"type": "subtitle", "time": 554.47, "timestamp": "00:09:14", "text": "そう、私を殺そうとする奴らが"}, {"type": "subtitle", "time": 556.389, "timestamp": "00:09:16", "text": "ウィンドウ。"}, {"type": "subtitle", "time": 558.55, "timestamp": "00:09:18", "text": "これは私が実際にプレイするのは初めてです"}, {"type": "subtitle", "time": 562.87, "timestamp": "00:09:22", "text": "モバイルゲーム。痛い。"}, {"type": "subtitle", "time": 564.87, "timestamp": "00:09:24", "text": "わかった、彼は私たちに手榴弾を投げつけているだけだと思う"}, {"type": "subtitle", "time": 567.59, "timestamp": "00:09:27", "text": "それは素晴らしいことだ。ところで、"}, {"type": "subtitle", "time": 569.91, "timestamp": "00:09:29", "text": "全く失礼ではない。"}, {"type": "subtitle", "time": 571.59, "timestamp": "00:09:31", "text": "来ていただけますか？文字通り"}, {"type": "subtitle", "time": 575.35, "timestamp": "00:09:35", "text": "嵐の近くにいた2人。その"}, {"type": "subtitle", "time": 577.59, "timestamp": "00:09:37", "text": "行く"}, {"type": "subtitle", "time": 579.35, "timestamp": "00:09:39", "text": "ない"}, {"type": "subtitle", "time": 587.99, "timestamp": "00:09:47", "text": "俺はただの男だ。そこへは行かない方がいい。あなたは"}, {"type": "subtitle", "time": 590.71, "timestamp": "00:09:50", "text": "そこで死ぬことになるだろう。ええ、大丈夫です。私は"}, {"type": "subtitle", "time": 592.23, "timestamp": "00:09:52", "text": "元気です。私は死んだ。心配しないでください"}, {"type": "subtitle", "time": 595.829, "timestamp": "00:09:55", "text": "それ。死んでも構わないんだよ、ウェイン。大丈夫です。"}]
[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "こんにちは、MJさん。ああ、全くその通りだ。私たちは完全に"}, {"type": "subtitle", "time": 303.189, "timestamp": "00:05:03", "text": "ここは安全です。アーマーを補充できますか？"}, {"type": "subtitle", "time": 305.909, "timestamp": "00:05:05", "text": "道？うん。"}, {"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "ああ、彼は亡くなった。彼、また死んだよ。私はただ"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 317.11, "timestamp": "00:05:17", "text": "鎧を着られるといいな。私は願っていた"}, {"type": "subtitle", "time": 319.67, "timestamp": "00:05:19", "text": "それはできたはずなのに、どうやら私にはできなかった"}, {"type": "subtitle", "time": 327.27, "timestamp": "00:05:27", "text": "何？ああ、それは「君が見える」という意味ですね。ごめんなさい。私は"}, {"type": "subtitle", "time": 330.629, "timestamp": "00:05:30", "text": "ごめん。私はあなたを殺そうとしていた。うん。"}, {"type": "subtitle", "time": 333.11, "timestamp": "00:05:33", "text": "うん。うん。うん。何？彼が来る"}, {"type": "subtitle", "time": 335.11, "timestamp": "00:05:35", "text": "また。彼はまた来る。彼が来る"}, {"type": "subtitle", "time": 337.749, "timestamp": "00:05:37", "text": "また。彼が来る。あのね？彼は"}, {"type": "subtitle", "time": 339.51, "timestamp": "00:05:39", "text": "来るよ。"}, {"type": "subtitle", "time": 342.23, "timestamp": "00:05:42", "text": "彼が来る。"}, {"type": "subtitle", "time": 344.469, "timestamp": "00:05:44", "text": "私たちを殺してみろ。おそらく"}, {"type": "subtitle", "time": 353.43, "timestamp": "00:05:53", "text": "意味がわかりません。あなたは何者ですか"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "何をしているの？すみません、私は…"}, {"type": "subtitle", "time": 359.51, "timestamp": "00:05:59", "text": "こんにちは、ポグ。ポグ、それは、"}]
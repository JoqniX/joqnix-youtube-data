[{"type": "subtitle", "time": 7205.589, "timestamp": "02:00:05", "text": "あなたは立ち上がった。それは不公平だ、"}, {"type": "subtitle", "time": 7208.55, "timestamp": "02:00:08", "text": "男。"}, {"type": "subtitle", "time": 7219.03, "timestamp": "02:00:19", "text": "それは泣いている。"}, {"type": "subtitle", "time": 7221.99, "timestamp": "02:00:21", "text": "うん。見て。うん、泣いてるよ。彼の目"}, {"type": "subtitle", "time": 7224.149, "timestamp": "02:00:24", "text": "営業中です。"}, {"type": "subtitle", "time": 7232.07, "timestamp": "02:00:32", "text": "[音楽]"}, {"type": "subtitle", "time": 7234.629, "timestamp": "02:00:34", "text": "ああ、これは何をするものですか？"}, {"type": "subtitle", "time": 7237.27, "timestamp": "02:00:37", "text": "それは"}, {"type": "subtitle", "time": 7253.589, "timestamp": "02:00:53", "text": "ここにカートがあるのがいいですね。"}]
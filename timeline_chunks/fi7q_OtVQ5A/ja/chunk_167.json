[{"type": "subtitle", "time": 10020.309, "timestamp": "02:47:00", "text": "わかった。スイがコラボしたのを知ってるでしょ"}, {"type": "subtitle", "time": 10022.389, "timestamp": "02:47:02", "text": "プロジェクト・ヴィンダ"}, {"type": "chat", "time": 10024.503, "timestamp": "02:47:04", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}, {"type": "subtitle", "time": 10025.11, "timestamp": "02:47:05", "text": "そして彼女は斧で皆を殺していた。"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "だから、いつかプレイするならそれをやりたい"}, {"type": "subtitle", "time": 10031.349, "timestamp": "02:47:11", "text": "友人たちとヴィンダというプロジェクトに取り組んだ。"}, {"type": "subtitle", "time": 10035.269, "timestamp": "02:47:15", "text": "いや、私はそういうのを楽しみたいんです。"}, {"type": "subtitle", "time": 10063.67, "timestamp": "02:47:43", "text": "ヤンド"}, {"type": "subtitle", "time": 10068.15, "timestamp": "02:47:48", "text": "ヤンデレゲーム。ヤンデレゲーム。"}, {"type": "subtitle", "time": 10072.23, "timestamp": "02:47:52", "text": "ヤンデレはかっこいい。宇宙ヤンデレ"}, {"type": "subtitle", "time": 10076.23, "timestamp": "02:47:56", "text": "私のヤンドレは両方とも足です。一体どういうことだ？"}, {"type": "chat", "time": 10078.566, "timestamp": "02:47:58", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/tlkIfgXq"}]
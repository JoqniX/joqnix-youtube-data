[{"type": "subtitle", "time": 19861.99, "timestamp": "05:31:01", "text": "例えば、彼がそう言うと、"}, {"type": "subtitle", "time": 19863.67, "timestamp": "05:31:03", "text": "なるほど。もちろんそうです。おい、"}, {"type": "subtitle", "time": 19866.788, "timestamp": "05:31:06", "text": "デオン。さようなら、旧友よ。ありがとう"}, {"type": "subtitle", "time": 19894.708, "timestamp": "05:31:34", "text": "さて、これからどうする？"}, {"type": "subtitle", "time": 19896.708, "timestamp": "05:31:36", "text": "今は目立たないようにして、"}, {"type": "subtitle", "time": 19899.75, "timestamp": "05:31:39", "text": "私たちは友人として人生を共に歩む。"}, {"type": "subtitle", "time": 19902.788, "timestamp": "05:31:42", "text": "私には選択肢があるのでしょうか？いや、そうでもないよ。全て"}, {"type": "subtitle", "time": 19907.35, "timestamp": "05:31:47", "text": "では、そうしましょう。欠陥があり、ひどい、"}, {"type": "subtitle", "time": 19909.19, "timestamp": "05:31:49", "text": "全く不快で、ひどく"}, {"type": "subtitle", "time": 19911.99, "timestamp": "05:31:51", "text": "マッチングした友達。絶対に。ああ、それは"}, {"type": "subtitle", "time": 19913.35, "timestamp": "05:31:53", "text": "完璧。そうすれば、"}, {"type": "subtitle", "time": 19915.83, "timestamp": "05:31:55", "text": "私たちが実践している資本主義の形態。くそ、俺は"}, {"type": "subtitle", "time": 19917.11, "timestamp": "05:31:57", "text": "それがどれだけ良いことなのかはわからない"}, {"type": "subtitle", "time": 19919.35, "timestamp": "05:31:59", "text": "デヴォンの詐欺よりも。ああ、偽善、"}]
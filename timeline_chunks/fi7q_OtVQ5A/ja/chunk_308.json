[{"type": "subtitle", "time": 18481.19, "timestamp": "05:08:01", "text": "彼を投入しろ？くそっ。トレバーは投げる"}, {"type": "subtitle", "time": 18482.948, "timestamp": "05:08:02", "text": "誰でも彼の血を満たすためだけに"}, {"type": "subtitle", "time": 18485.51, "timestamp": "05:08:05", "text": "欲望。おい、それはクソ緩いって言うんだよ"}, {"type": "subtitle", "time": 18486.948, "timestamp": "05:08:06", "text": "終わり。よし。そしてもし私たちが"}, {"type": "subtitle", "time": 18489.67, "timestamp": "05:08:09", "text": "平和と静穏の男たちよ、我々は縛り付ける"}, {"type": "subtitle", "time": 18493.43, "timestamp": "05:08:13", "text": "未解決事項。はい。負担となってきた。"}, {"type": "subtitle", "time": 18494.55, "timestamp": "05:08:14", "text": "そうすれば、私たちは対処しなければなりません"}, {"type": "subtitle", "time": 18498.23, "timestamp": "05:08:18", "text": "昔からの仲間たちとスティーブ。くそ。なんてことだ"}, {"type": "subtitle", "time": 18507.11, "timestamp": "05:08:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18509.11, "timestamp": "05:08:29", "text": "これは誰ですか？この番号への電話はやめてください。"}, {"type": "subtitle", "time": 18511.51, "timestamp": "05:08:31", "text": "やあ、僕だよ、犬。あなたは生きている。私"}, {"type": "subtitle", "time": 18512.948, "timestamp": "05:08:32", "text": "誰かがあなたの携帯電話を持っているかもしれないと思いました。"}, {"type": "subtitle", "time": 18514.628, "timestamp": "05:08:34", "text": "いやいや、でも見て、スピーカーフォンで話してるよ"}, {"type": "subtitle", "time": 18516.55, "timestamp": "05:08:36", "text": "電話。君ならできるかもしれないよ。ええ、私は"}, {"type": "subtitle", "time": 18519.11, "timestamp": "05:08:39", "text": "ここ。では、もう片方は？準備中"}, {"type": "subtitle", "time": 18522.948, "timestamp": "05:08:42", "text": "地面に接地した車輪。うんうん。"}, {"type": "subtitle", "time": 18525.11, "timestamp": "05:08:45", "text": "いや、仕事が入ったんだ。はい。入手できますか？"}, {"type": "subtitle", "time": 18527.43, "timestamp": "05:08:47", "text": "私たちにどこにいるのか教えてくれますか？最善を尽くします。"}, {"type": "subtitle", "time": 18531.03, "timestamp": "05:08:51", "text": "誰が？スティーブ・ヘインズが先発、デオン・ウェスト"}, {"type": "subtitle", "time": 18537.67, "timestamp": "05:08:57", "text": "そしてチン。ウェイチェンギャング"}]
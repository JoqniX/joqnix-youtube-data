[{"type": "subtitle", "time": 11607.67, "timestamp": "03:13:27", "text": "あれ。ああ、私はそれを設定しておくべきだった"}, {"type": "subtitle", "time": 11610.469, "timestamp": "03:13:30", "text": "ストリーマーボーイ。それで、表示する代わりに"}, {"type": "subtitle", "time": 11613.83, "timestamp": "03:13:33", "text": "私のデスクトップは時々、ええと、私は思った"}, {"type": "subtitle", "time": 11616.87, "timestamp": "03:13:36", "text": "または、次のようなものを表示したい場合"}, {"type": "subtitle", "time": 11619.19, "timestamp": "03:13:39", "text": "私が考えたスケジュール例など"}, {"type": "subtitle", "time": 11620.95, "timestamp": "03:13:40", "text": "スクリーンショットを撮って"}, {"type": "subtitle", "time": 11623.75, "timestamp": "03:13:43", "text": "スクリーンショットは特定のスポークにあります"}, {"type": "subtitle", "time": 11629.67, "timestamp": "03:13:49", "text": "OBSが作成するフォルダ"}, {"type": "subtitle", "time": 11632.63, "timestamp": "03:13:52", "text": "それ用の新しいCSと、何が"}, {"type": "subtitle", "time": 11634.87, "timestamp": "03:13:54", "text": "スクリーンショットとか撮ったよ。私はしたい"}, {"type": "subtitle", "time": 11639.99, "timestamp": "03:13:59", "text": "えーと"}]
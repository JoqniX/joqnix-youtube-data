[{"type": "subtitle", "time": 4446.709, "timestamp": "01:14:06", "text": "大きなアイテムに関しては苦労する"}, {"type": "subtitle", "time": 4450.95, "timestamp": "01:14:10", "text": "いつも。ハープとかそういうのが好き"}, {"type": "subtitle", "time": 4455.03, "timestamp": "01:14:15", "text": "そして、大きな絵画。それは迷惑だ。私"}, {"type": "subtitle", "time": 4458.31, "timestamp": "01:14:18", "text": "チェリーが乗っている。"}, {"type": "subtitle", "time": 4460.87, "timestamp": "01:14:20", "text": "はい、そうです。それがチェリーだといいな、"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "ここに置いておいてください。今日の"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "チェリー？ええ、チェリーですね。わかった。"}, {"type": "subtitle", "time": 4474.07, "timestamp": "01:14:34", "text": "わかった。それはサクランボです。うん。うん。私は"}, {"type": "subtitle", "time": 4476.63, "timestamp": "01:14:36", "text": "ハッピー。私は嬉しい。"}, {"type": "subtitle", "time": 4479.11, "timestamp": "01:14:39", "text": "はい、入ります。"}, {"type": "subtitle", "time": 4482.79, "timestamp": "01:14:42", "text": "カーソルを合わせるのが一番です"}, {"type": "subtitle", "time": 4486.47, "timestamp": "01:14:46", "text": "もしやり方がわかるなら、その上に書いてください。"}, {"type": "subtitle", "time": 4488.709, "timestamp": "01:14:48", "text": "どうですか？"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "あ、少し後ろに下がってください。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 4494.149, "timestamp": "01:14:54", "text": "でも、大丈夫、心配しないで。そのままにしておいて"}]
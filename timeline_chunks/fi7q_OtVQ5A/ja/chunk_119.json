[{"type": "subtitle", "time": 7142.79, "timestamp": "01:59:02", "text": "方法。なんてこった。戻ってください。戻ってください。いいえ。いいえ。"}, {"type": "subtitle", "time": 7145.589, "timestamp": "01:59:05", "text": "その部屋への正しい入り方。"}, {"type": "subtitle", "time": 7148.629, "timestamp": "01:59:08", "text": "はい。ええと、これです。いいえ。いいえ。次。えっと、"}, {"type": "subtitle", "time": 7150.629, "timestamp": "01:59:10", "text": "もう一方。もう一つ。うん。はい、"}, {"type": "subtitle", "time": 7153.03, "timestamp": "01:59:13", "text": "そこへ進み、前へ進み、そして上を見上げる"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "そこには。見上げる。見上げる。"}, {"type": "subtitle", "time": 7159.99, "timestamp": "01:59:19", "text": "いいえ、振り向いてください。振り向く。おお、"}, {"type": "subtitle", "time": 7168.39, "timestamp": "01:59:28", "text": "わからない。魔法。"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "氷の女神であることの力、私は"}, {"type": "subtitle", "time": 7179.91, "timestamp": "01:59:39", "text": "何てことだ。ああ、神様。ああ、神様。ああ、神様。おお"}, {"type": "subtitle", "time": 7183.589, "timestamp": "01:59:43", "text": "神。なんてこった。何てことだ。一体何なんだ"}, {"type": "subtitle", "time": 7190.149, "timestamp": "01:59:50", "text": "彼は殺されたばかりだ。"}]
[{"type": "subtitle", "time": 2162.069, "timestamp": "00:36:02", "text": "こんにちは。久しぶりですね。それは"}, {"type": "subtitle", "time": 2165.75, "timestamp": "00:36:05", "text": "その間。はい。うん。もし私が覚えていたら"}, {"type": "subtitle", "time": 2169.109, "timestamp": "00:36:09", "text": "正しく言うと、前回話した時、"}, {"type": "subtitle", "time": 2172.23, "timestamp": "00:36:12", "text": "一緒に遊んだのはマインクラフトだった。"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "マインクラフト。うん。"}, {"type": "subtitle", "time": 2183.75, "timestamp": "00:36:23", "text": "そうだった。うん。うん。"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "わかった。えーと、今日はRepoをプレイします。"}, {"type": "subtitle", "time": 2191.91, "timestamp": "00:36:31", "text": "右？うん。うん。"}, {"type": "subtitle", "time": 2195.51, "timestamp": "00:36:35", "text": "私は通常版をプレイしました。私は決して"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "ベータ版をプレイしました。ああ、彼らは"}, {"type": "subtitle", "time": 2201.99, "timestamp": "00:36:41", "text": "もう少し荷物が増えました。彼らはそうしていない"}, {"type": "subtitle", "time": 2206.55, "timestamp": "00:36:46", "text": "変更しました。ええ、たくさんありますが、それはどちらかというと"}, {"type": "subtitle", "time": 2208.86, "timestamp": "00:36:48", "text": "もう少し悪い状態かな。"}, {"type": "subtitle", "time": 2210.71, "timestamp": "00:36:50", "text": "[音楽]"}, {"type": "subtitle", "time": 2214.47, "timestamp": "00:36:54", "text": "うん。だから、プレイするのが楽しみです"}, {"type": "subtitle", "time": 2216.79, "timestamp": "00:36:56", "text": "ベータ版。"}, {"type": "subtitle", "time": 2219.03, "timestamp": "00:36:59", "text": "わーい。"}]
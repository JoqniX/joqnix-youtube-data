[{"type": "subtitle", "time": 14280.229, "timestamp": "03:58:00", "text": "ああ、センサーを入手する必要がある。ジョック"}, {"type": "subtitle", "time": 14282.55, "timestamp": "03:58:02", "text": "センサーモード。どこにいるの？ジョックセンサー、"}, {"type": "subtitle", "time": 14284.63, "timestamp": "03:58:04", "text": "どこにいるの？"}, {"type": "subtitle", "time": 14286.87, "timestamp": "03:58:06", "text": "私は手に入れる必要がある"}, {"type": "subtitle", "time": 14289.429, "timestamp": "03:58:09", "text": "センサー。"}, {"type": "subtitle", "time": 14292.63, "timestamp": "03:58:12", "text": "またね。待って、"}, {"type": "subtitle", "time": 14302.229, "timestamp": "03:58:22", "text": "おい、君。くそっ。来て。それだけです"}, {"type": "subtitle", "time": 14307.91, "timestamp": "03:58:27", "text": "ああ、うちのネットワークハッカーだ。騙されないでください"}, {"type": "subtitle", "time": 14309.91, "timestamp": "03:58:29", "text": "CRTモニターとファックス機によって。の"}, {"type": "subtitle", "time": 14313.03, "timestamp": "03:58:33", "text": "ここのハードウェアは最新鋭だ。いいね。"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "おい、他のクルーはどこだ？"}, {"type": "subtitle", "time": 14316.71, "timestamp": "03:58:36", "text": "外。やあ、みんな頑張ってね。病気"}, {"type": "subtitle", "time": 14318.63, "timestamp": "03:58:38", "text": "ミッションで会いましょう。よし。おお、"}, {"type": "subtitle", "time": 14320.469, "timestamp": "03:58:40", "text": "約"}, {"type": "subtitle", "time": 14323.189, "timestamp": "03:58:43", "text": "金8トン。 4トンではなく"}, {"type": "subtitle", "time": 14326.07, "timestamp": "03:58:46", "text": "八。"}, {"type": "subtitle", "time": 14328.79, "timestamp": "03:58:48", "text": "よし、みんな。さあ行こう。乗る"}, {"type": "subtitle", "time": 14332.469, "timestamp": "03:58:52", "text": "車だよ、ベイビー。冗談です。なんで冗談を言ってるの？"}, {"type": "subtitle", "time": 14334.87, "timestamp": "03:58:54", "text": "なぜ"}, {"type": "subtitle", "time": 14337.59, "timestamp": "03:58:57", "text": "車で行くの？さあ行こう。これは"}]
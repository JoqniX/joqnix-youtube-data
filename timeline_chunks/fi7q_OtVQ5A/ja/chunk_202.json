[{"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "うん。あなたはハバハバと言っていますが、"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "ハバとは言っていません。待って。ハヴァ。待って、"}, {"type": "subtitle", "time": 12133.349, "timestamp": "03:22:13", "text": "私はただ「ハバハバ」と言うだけですか？ああ、それは"}, {"type": "subtitle", "time": 12135.91, "timestamp": "03:22:15", "text": "ボリウッドの歌。私たちはグーグルで"}, {"type": "subtitle", "time": 12138.07, "timestamp": "03:22:18", "text": "ハヴァはそうだったよね？それから私たちはハヴァを見た"}, {"type": "subtitle", "time": 12140.469, "timestamp": "03:22:20", "text": "ハヴァ・シング。"}, {"type": "subtitle", "time": 12142.15, "timestamp": "03:22:22", "text": "そして、それがボリウッド映画だと気づいた"}, {"type": "subtitle", "time": 12144.79, "timestamp": "03:22:24", "text": "歌。それから少し聞いて、"}]
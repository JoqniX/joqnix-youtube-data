[{"type": "subtitle", "time": 17588.07, "timestamp": "04:53:08", "text": "そして"}, {"type": "subtitle", "time": 17600.31, "timestamp": "04:53:20", "text": "銃撃戦が始まる。よし、"}, {"type": "subtitle", "time": 17602.628, "timestamp": "04:53:22", "text": "ヘッドホンを装着してください。私は着ていませんでした"}, {"type": "subtitle", "time": 17605.51, "timestamp": "04:53:25", "text": "ずっとヘッドホンをしていたんだ。うん、"}, {"type": "subtitle", "time": 17608.948, "timestamp": "04:53:28", "text": "ヘッドホンを着けると、"}]
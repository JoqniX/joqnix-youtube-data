[{"type": "subtitle", "time": 19635.59, "timestamp": "05:27:15", "text": "君は機転の利く人だね。"}, {"type": "subtitle", "time": 19637.11, "timestamp": "05:27:17", "text": "私の"}, {"type": "subtitle", "time": 19655.27, "timestamp": "05:27:35", "text": "あなたにとって役に立つ人がいる"}, {"type": "subtitle", "time": 19657.11, "timestamp": "05:27:37", "text": "そしてそうでない人々と"}, {"type": "subtitle", "time": 19661.67, "timestamp": "05:27:41", "text": "行かなくてもいいよ。自分？私は違います。私はしません"}, {"type": "subtitle", "time": 19665.35, "timestamp": "05:27:45", "text": "自分が役に立つかどうかを気にしない。私は感じる"}, {"type": "subtitle", "time": 19668.628, "timestamp": "05:27:48", "text": "君を連れ出すような。それが私の"}, {"type": "subtitle", "time": 19675.99, "timestamp": "05:27:55", "text": "あなたが今までに経験したことすべて 私が今までに経験したことすべて"}, {"type": "subtitle", "time": 19677.99, "timestamp": "05:27:57", "text": "君が浮かんだり消えたりするのを見たいだけ"}, {"type": "subtitle", "time": 19679.67, "timestamp": "05:27:59", "text": "意識がゆっくりと"}]
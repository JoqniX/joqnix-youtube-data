[{"type": "subtitle", "time": 2700.47, "timestamp": "00:45:00", "text": "私たちはただそこにいてお互いの声が聞こえる"}, {"type": "subtitle", "time": 2703.19, "timestamp": "00:45:03", "text": "他には関係ない、だって私たちは話しているんだから"}, {"type": "subtitle", "time": 2705.829, "timestamp": "00:45:05", "text": "音声について。えっと、これを使いたいですか？"}, {"type": "subtitle", "time": 2709.19, "timestamp": "00:45:09", "text": "ゲーム内の車の代わりに？それともゲームのように？唯一の"}, {"type": "subtitle", "time": 2710.87, "timestamp": "00:45:10", "text": "ゲーム内の問題について、"}, {"type": "subtitle", "time": 2713.19, "timestamp": "00:45:13", "text": "お互いの声に耳を傾ける。もしあなたができるなら"}, {"type": "subtitle", "time": 2716.71, "timestamp": "00:45:16", "text": "しかし、誰かが亡くなると、"}, {"type": "subtitle", "time": 2718.63, "timestamp": "00:45:18", "text": "プレイするだけでは、その存在を知らないでしょう"}, {"type": "subtitle", "time": 2724.15, "timestamp": "00:45:24", "text": "そして、このカードを使うことができます。"}, {"type": "subtitle", "time": 2727.27, "timestamp": "00:45:27", "text": "推測。うん。"}, {"type": "subtitle", "time": 2736.309, "timestamp": "00:45:36", "text": "さあ行こう。"}, {"type": "subtitle", "time": 2741.43, "timestamp": "00:45:41", "text": "ああ、これは私が初めて"}, {"type": "subtitle", "time": 2745.27, "timestamp": "00:45:45", "text": "ベータ版。モンスターは、"}, {"type": "subtitle", "time": 2748.28, "timestamp": "00:45:48", "text": "以前と同じくらい頻繁に手に取ってください。"}, {"type": "subtitle", "time": 2750.71, "timestamp": "00:45:50", "text": "[音楽]"}, {"type": "subtitle", "time": 2754.71, "timestamp": "00:45:54", "text": "わかった。あ、待って。 「ああ、そうだ」を押すと。"}]
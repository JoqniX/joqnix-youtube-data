[{"type": "subtitle", "time": 15782.87, "timestamp": "04:23:02", "text": "落ち着け、とあなたは言う。"}, {"type": "subtitle", "time": 15791.349, "timestamp": "04:23:11", "text": "私がDMで送ったメッセージ、見ましたか？"}, {"type": "subtitle", "time": 15795.51, "timestamp": "04:23:15", "text": "そうだったと思います。待って、"}, {"type": "subtitle", "time": 15797.99, "timestamp": "04:23:17", "text": "説明文を読んでください。 SM722。は"}, {"type": "subtitle", "time": 15801.429, "timestamp": "04:23:21", "text": "退屈してるの？ハニーハニー"}, {"type": "subtitle", "time": 15806.07, "timestamp": "04:23:26", "text": "手順はこちらですぐに確認できます。何てことだ。"}, {"type": "subtitle", "time": 15808.149, "timestamp": "04:23:28", "text": "コックを開けてスピードを上げることができます"}, {"type": "subtitle", "time": 15809.83, "timestamp": "04:23:29", "text": "食べ物をリッパーの上に置いて、"}, {"type": "subtitle", "time": 15812.229, "timestamp": "04:23:32", "text": "信じられないことが起こる"}, {"type": "subtitle", "time": 15814.229, "timestamp": "04:23:34", "text": "ステップ5で。一体どういうことだ？それは"}, {"type": "subtitle", "time": 15820.149, "timestamp": "04:23:40", "text": "ああ、それはすごく怪しい。私はしません"}, {"type": "subtitle", "time": 15822.07, "timestamp": "04:23:42", "text": "ここでくだらない質問をしたいのですが、"}, {"type": "subtitle", "time": 15824.79, "timestamp": "04:23:44", "text": "なぜ7GBにアップグレードしたのですか？私は実際に"}, {"type": "subtitle", "time": 15834.309, "timestamp": "04:23:54", "text": "誰かがつねられたとしましょう。良い、"}, {"type": "subtitle", "time": 15837.189, "timestamp": "04:23:57", "text": "そして証拠、あるいは誰かが何かを手に入れたら"}]
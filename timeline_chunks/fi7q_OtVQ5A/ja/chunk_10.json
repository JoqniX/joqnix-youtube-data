[{"type": "subtitle", "time": 600.389, "timestamp": "00:10:00", "text": "私は大丈夫です。私も元気です。"}, {"type": "subtitle", "time": 607.43, "timestamp": "00:10:07", "text": "いいね。いいね。いいね。いいね。大丈夫です。その"}, {"type": "subtitle", "time": 608.79, "timestamp": "00:10:08", "text": "大丈夫。大丈夫。彼はどこにいるの？"}, {"type": "subtitle", "time": 610.07, "timestamp": "00:10:10", "text": "彼はどこにいますか？彼はどこにいますか？彼はどこにいますか？"}, {"type": "subtitle", "time": 613.43, "timestamp": "00:10:13", "text": "一番上。再装填中。一番上。一番上。イエス"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "キリスト。何てことだ。彼はどこにいますか？あなたが知っている"}, {"type": "subtitle", "time": 618.15, "timestamp": "00:10:18", "text": "何？彼はただ、トップにいるのか？行くよ"}, {"type": "subtitle", "time": 623.269, "timestamp": "00:10:23", "text": "面白くするために。彼はトップに立っている。"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "彼をハッキングするつもりだ。ハッキングするだけ"}, {"type": "subtitle", "time": 628.87, "timestamp": "00:10:28", "text": "彼。ああ、彼をハッキングできるよ。ああ、できるよ"}, {"type": "subtitle", "time": 640.389, "timestamp": "00:10:40", "text": "うん。こんにちは、Pさん。お元気ですか？いらっしゃいませ。"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "君たち"}, {"type": "subtitle", "time": 644.63, "timestamp": "00:10:44", "text": "援護が必要だ。あなたのチームメイトは"}, {"type": "subtitle", "time": 646.15, "timestamp": "00:10:46", "text": "殺された。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "よし、私は安全だと思う。わからない。"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "私は安全ですか？はい。その区域は消滅した。の"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "そのゾーンは、そのゾーンがなくなったということです。わかった。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "私たちは勝った。彼にさらにダメージを与えれば、"}]
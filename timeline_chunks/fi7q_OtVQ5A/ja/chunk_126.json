[{"type": "subtitle", "time": 7560.709, "timestamp": "02:06:00", "text": "それを得る。彼は全く痛みを感じさせない。"}, {"type": "subtitle", "time": 7563.109, "timestamp": "02:06:03", "text": "あなたはよくやっています。"}, {"type": "subtitle", "time": 7566.709, "timestamp": "02:06:06", "text": "ああ、彼はもっと欲しがって戻ってきている。"}, {"type": "subtitle", "time": 7569.35, "timestamp": "02:06:09", "text": "ああ、歯を治すんだ。すみません、"}, {"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "それについて心配してください。"}, {"type": "subtitle", "time": 7575.43, "timestamp": "02:06:15", "text": "よし、実際、彼らを通した。"}, {"type": "subtitle", "time": 7588.87, "timestamp": "02:06:28", "text": "ピエロを乗せるのはちょっと不公平だ"}, {"type": "subtitle", "time": 7591.43, "timestamp": "02:06:31", "text": "最初のレベル。"}, {"type": "subtitle", "time": 7605.83, "timestamp": "02:06:45", "text": "わかりました、ここに配置します。"}]
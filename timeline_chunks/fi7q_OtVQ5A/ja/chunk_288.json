[{"type": "subtitle", "time": 17280.07, "timestamp": "04:48:00", "text": "ついにこのゲームをアンインストールして終わりにしよう"}, {"type": "subtitle", "time": 17291.35, "timestamp": "04:48:11", "text": "インストールするのは、私が、えっと、"}, {"type": "subtitle", "time": 17293.43, "timestamp": "04:48:13", "text": "必要なときにインストールします"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "コラボレーションやその他重要なこと"}, {"type": "subtitle", "time": 17299.59, "timestamp": "04:48:19", "text": "その時だけ重要だった。"}, {"type": "subtitle", "time": 17302.788, "timestamp": "04:48:22", "text": "私はそう願っています、私はとても申し訳なく思っています"}, {"type": "subtitle", "time": 17307.59, "timestamp": "04:48:27", "text": "それを押し出す。行けよ、相棒。私は持ちこたえる"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "W の代わりに"}, {"type": "subtitle", "time": 17323.03, "timestamp": "04:48:43", "text": "だから、すごく心配だし、混乱してる。"}, {"type": "subtitle", "time": 17325.83, "timestamp": "04:48:45", "text": "先ほど起こったことについて。ご覧のとおり"}, {"type": "subtitle", "time": 17329.19, "timestamp": "04:48:49", "text": "黒くなったんですよね？"}, {"type": "subtitle", "time": 17332.31, "timestamp": "04:48:52", "text": "心配です。一体どういうことだ？"}, {"type": "subtitle", "time": 17334.788, "timestamp": "04:48:54", "text": "会話シーンはスキップできません。ほら、私は"}, {"type": "subtitle", "time": 17336.15, "timestamp": "04:48:56", "text": "何も言いたくない。彼らは"}, {"type": "subtitle", "time": 17337.83, "timestamp": "04:48:57", "text": "人種差別主義者の男。それらは試すことができません"}]
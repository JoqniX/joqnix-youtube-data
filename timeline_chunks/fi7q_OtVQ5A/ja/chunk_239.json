[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "ちなみに、これが最後の任務ですか？"}, {"type": "subtitle", "time": 14344.07, "timestamp": "03:59:04", "text": "このゲームをクリアしたい気分だ。された"}, {"type": "subtitle", "time": 14346.79, "timestamp": "03:59:06", "text": "このシリーズで最も長く視聴しています。"}, {"type": "subtitle", "time": 14351.269, "timestamp": "03:59:11", "text": "このシリーズは1月に開始しました"}, {"type": "subtitle", "time": 14359.51, "timestamp": "03:59:19", "text": "つまり、新旧メンバーのことだ。"}, {"type": "subtitle", "time": 14361.91, "timestamp": "03:59:21", "text": "冗談だよ"}, {"type": "subtitle", "time": 14363.59, "timestamp": "03:59:23", "text": "クルー。"}, {"type": "subtitle", "time": 14365.67, "timestamp": "03:59:25", "text": "ジョークの時間です。もし私が手に入れられなかったら、すごく怒るだろう"}, {"type": "subtitle", "time": 14367.429, "timestamp": "03:59:27", "text": "仲間たちに電話する。あのね"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "私が言いたいのは？"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "マイケルは君が"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "Fall Guy 1 のパーツに最適です"}, {"type": "subtitle", "time": 14376.95, "timestamp": "03:59:36", "text": "そして２つ目。おいおい、話は必要ないよ"}, {"type": "subtitle", "time": 14379.03, "timestamp": "03:59:39", "text": "そんな感じ。今日はダメだ。彼らは知る必要がある"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "何"}, {"type": "subtitle", "time": 14382.389, "timestamp": "03:59:42", "text": "彼らはそれにのめり込んでいる。あなたは欲しい"}, {"type": "subtitle", "time": 14384.309, "timestamp": "03:59:44", "text": "意地悪な女になるってこと？車から降りて、"}, {"type": "subtitle", "time": 14386.71, "timestamp": "03:59:46", "text": "[ __ ]。これをやりたいの？近い"}, {"type": "subtitle", "time": 14388.63, "timestamp": "03:59:48", "text": "くだらないことを言うのはやめて、黙ってろ"}, {"type": "subtitle", "time": 14399.75, "timestamp": "03:59:59", "text": "ああ、M猫の日だ。うん。そうそう。今日の"}]
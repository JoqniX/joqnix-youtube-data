[{"type": "subtitle", "time": 7321.35, "timestamp": "02:02:01", "text": "右？"}, {"type": "subtitle", "time": 7324.229, "timestamp": "02:02:04", "text": "ほぼその通りです。うん。"}, {"type": "subtitle", "time": 7327.14, "timestamp": "02:02:07", "text": "それでもやっぱり好きじゃないよ、ベイビー。"}, {"type": "subtitle", "time": 7328.79, "timestamp": "02:02:08", "text": "[音楽]"}, {"type": "subtitle", "time": 7331.99, "timestamp": "02:02:11", "text": "博物館の方がずっといい。"}, {"type": "subtitle", "time": 7357.189, "timestamp": "02:02:37", "text": "実際に持ち運べるもの。"}, {"type": "subtitle", "time": 7365.109, "timestamp": "02:02:45", "text": "[音楽]"}]
[{"type": "subtitle", "time": 19563.43, "timestamp": "05:26:03", "text": "弟は元気だった？"}, {"type": "subtitle", "time": 19565.51, "timestamp": "05:26:05", "text": "お元気でしたか？"}, {"type": "subtitle", "time": 19567.83, "timestamp": "05:26:07", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 19569.75, "timestamp": "05:26:09", "text": "ウェストン氏に会えました。彼を連れ出しましょう"}, {"type": "subtitle", "time": 19573.35, "timestamp": "05:26:13", "text": "都市。それを消して"}, {"type": "subtitle", "time": 19576.39, "timestamp": "05:26:16", "text": "崖の上で"}, {"type": "subtitle", "time": 19588.23, "timestamp": "05:26:28", "text": "ああ、それは良い励みになった。"}]
[{"type": "subtitle", "time": 18541.27, "timestamp": "05:09:01", "text": "そしてフランクリン・ストレッチ。ストレッチ。うん、"}, {"type": "subtitle", "time": 18543.27, "timestamp": "05:09:03", "text": "男。彼の本当の名前はハロルドです"}, {"type": "subtitle", "time": 18545.91, "timestamp": "05:09:05", "text": "ジョセフ。わかった。ええ、それは"}, {"type": "subtitle", "time": 18548.07, "timestamp": "05:09:08", "text": "エージェント・ヘインズは、"}, {"type": "subtitle", "time": 18550.39, "timestamp": "05:09:10", "text": "デルペロ。射撃許可証が出てきた"}, {"type": "subtitle", "time": 18552.39, "timestamp": "05:09:12", "text": "すぐに。"}, {"type": "subtitle", "time": 18554.15, "timestamp": "05:09:14", "text": "私はあの野郎を殺したかった"}, {"type": "subtitle", "time": 18557.35, "timestamp": "05:09:17", "text": "彼に会った瞬間。よし。よし。"}, {"type": "subtitle", "time": 18559.43, "timestamp": "05:09:19", "text": "ハロルド・ジョセフ氏の電話からの信号"}, {"type": "subtitle", "time": 18561.91, "timestamp": "05:09:21", "text": "BJスミスのところへ。"}, {"type": "subtitle", "time": 18563.51, "timestamp": "05:09:23", "text": "捕まえたぞ。捕まえたぞ。彼をキープしよう"}, {"type": "subtitle", "time": 18565.35, "timestamp": "05:09:25", "text": "クリア。"}, {"type": "subtitle", "time": 18574.07, "timestamp": "05:09:34", "text": "パシフィック・ブラフス。わかった。彼に聞いてみます"}, {"type": "subtitle", "time": 18578.39, "timestamp": "05:09:38", "text": "彼のパンク野郎について。私がミスターを見つけたとき。"}, {"type": "subtitle", "time": 18579.51, "timestamp": "05:09:39", "text": "よし。"}, {"type": "subtitle", "time": 18581.43, "timestamp": "05:09:41", "text": "おお、"}, {"type": "subtitle", "time": 18586.39, "timestamp": "05:09:46", "text": "みんな行くよ。おお、"}]
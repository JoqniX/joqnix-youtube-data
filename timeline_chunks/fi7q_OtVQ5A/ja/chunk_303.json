[{"type": "subtitle", "time": 18206.948, "timestamp": "05:03:26", "text": "何てことだ。はい、探しているのは"}, {"type": "subtitle", "time": 18233.35, "timestamp": "05:03:53", "text": "よし、今度こそ私は死なない。来て、"}, {"type": "subtitle", "time": 18237.59, "timestamp": "05:03:57", "text": "T. やめなさい。ほら、いたぞ、この野郎。"}, {"type": "subtitle", "time": 18239.99, "timestamp": "05:03:59", "text": "何が問題だったのですか？私は少し"}]
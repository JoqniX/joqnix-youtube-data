[{"type": "subtitle", "time": 9363.12, "timestamp": "02:36:03", "text": "わかった。"}, {"type": "subtitle", "time": 9367.03, "timestamp": "02:36:07", "text": "[音楽]"}, {"type": "subtitle", "time": 9376.469, "timestamp": "02:36:16", "text": "そのアウェーゲームはもう諦めていいよ。あなたが知っている、"}, {"type": "subtitle", "time": 9380.87, "timestamp": "02:36:20", "text": "これを武器として使うことができます"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "望めばそうすることもできますよ。"}, {"type": "subtitle", "time": 9385.11, "timestamp": "02:36:25", "text": "おお、"}, {"type": "subtitle", "time": 9387.11, "timestamp": "02:36:27", "text": "爆発する"}, {"type": "subtitle", "time": 9401.03, "timestamp": "02:36:41", "text": "何てことだ。"}, {"type": "subtitle", "time": 9404.389, "timestamp": "02:36:44", "text": "銃を持った男には気をつけろ。"}, {"type": "subtitle", "time": 9413.27, "timestamp": "02:36:53", "text": "え、何？私は何をしているのでしょうか？私は手に入れた"}]
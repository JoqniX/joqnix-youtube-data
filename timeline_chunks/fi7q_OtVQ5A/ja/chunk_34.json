[{"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "茂みに隠れて、えーと"}, {"type": "subtitle", "time": 2045.83, "timestamp": "00:34:05", "text": "彼はプレイヤーなのか、それとも何か別のタイプなのか？彼は"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "何てことだ。了解、了解。えっと"}, {"type": "subtitle", "time": 2060.55, "timestamp": "00:34:20", "text": "素晴らしい。知ってるなら、どこか分かるよね"}, {"type": "subtitle", "time": 2069.19, "timestamp": "00:34:29", "text": "なんてこった。誰かが私の獲物を盗んだ。ああ、私は"}, {"type": "subtitle", "time": 2071.51, "timestamp": "00:34:31", "text": "見せないで。えっと、それは"}, {"type": "subtitle", "time": 2073.43, "timestamp": "00:34:33", "text": "絶対に私じゃないよ、ウェイン。心配しないで"}, {"type": "subtitle", "time": 2075.75, "timestamp": "00:34:35", "text": "それについて。"}, {"type": "subtitle", "time": 2077.03, "timestamp": "00:34:37", "text": "もし君だったら、と友人は言った。"}, {"type": "subtitle", "time": 2078.79, "timestamp": "00:34:38", "text": "確実に殺す方法を見つけた"}, {"type": "subtitle", "time": 2081.27, "timestamp": "00:34:41", "text": "あなた。"}, {"type": "subtitle", "time": 2083.27, "timestamp": "00:34:43", "text": "お互いを殺し合えたらいいのに"}, {"type": "subtitle", "time": 2085.99, "timestamp": "00:34:45", "text": "このゲームでは、他にもいろいろあるよ。"}, {"type": "subtitle", "time": 2089.03, "timestamp": "00:34:49", "text": "落ち着いて。だろう。そうだろうね？"}, {"type": "subtitle", "time": 2096.31, "timestamp": "00:34:56", "text": "なんでこんなヒップファイルが必要なんだよ、バカ！"}]
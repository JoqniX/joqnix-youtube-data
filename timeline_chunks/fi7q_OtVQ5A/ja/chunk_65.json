[{"type": "subtitle", "time": 3900.069, "timestamp": "01:05:00", "text": "うん。うん。えっと、もうなくなってしまったと思います。"}, {"type": "subtitle", "time": 3901.67, "timestamp": "01:05:01", "text": "しかし"}, {"type": "subtitle", "time": 3904.71, "timestamp": "01:05:04", "text": "ええ、一度なくなったら、もう二度と手に入りません。"}, {"type": "subtitle", "time": 3906.549, "timestamp": "01:05:06", "text": "ああ、ここには他にも商品がある。大きい"}, {"type": "subtitle", "time": 3919.349, "timestamp": "01:05:19", "text": "キノコ博物館にはおもちゃがいっぱいある。なぜ"}, {"type": "subtitle", "time": 3921.19, "timestamp": "01:05:21", "text": "おもちゃのように見えるか？"}, {"type": "subtitle", "time": 3923.51, "timestamp": "01:05:23", "text": "工場？"}, {"type": "subtitle", "time": 3925.589, "timestamp": "01:05:25", "text": "多分。わからない。"}, {"type": "subtitle", "time": 3930.309, "timestamp": "01:05:30", "text": "ああ、気をつけろ。気をつけて。えっと、人形"}, {"type": "subtitle", "time": 3932.15, "timestamp": "01:05:32", "text": "刃物を持った人が同じ部屋にいる"}, {"type": "subtitle", "time": 3939.829, "timestamp": "01:05:39", "text": "ああ、彼女はこれをやったんだ。"}, {"type": "subtitle", "time": 3942.789, "timestamp": "01:05:42", "text": "待って、あなたはああ、赤ちゃんです。それは"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "赤ちゃん。気を散らすものとして分類します"}, {"type": "subtitle", "time": 3949.349, "timestamp": "01:05:49", "text": "ポイント。うん。うん。頑張れ。"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "うん、"}, {"type": "subtitle", "time": 3953.19, "timestamp": "01:05:53", "text": "目を開けて泣き始めるだろう。"}, {"type": "subtitle", "time": 3955.029, "timestamp": "01:05:55", "text": "ちょっと不気味だ。"}]
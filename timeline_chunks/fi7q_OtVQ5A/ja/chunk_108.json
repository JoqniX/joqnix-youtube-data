[{"type": "subtitle", "time": 6480.55, "timestamp": "01:48:00", "text": "[音楽]"}, {"type": "subtitle", "time": 6488.149, "timestamp": "01:48:08", "text": "よし、君から始めてくれ。"}, {"type": "subtitle", "time": 6490.47, "timestamp": "01:48:10", "text": "わかった、"}, {"type": "subtitle", "time": 6493.43, "timestamp": "01:48:13", "text": "君はHPが低いから、まず君から始めよう。待って、"}, {"type": "subtitle", "time": 6496.55, "timestamp": "01:48:16", "text": "あなたが先に動いたらどうなりますか？"}, {"type": "subtitle", "time": 6500.31, "timestamp": "01:48:20", "text": "私はHPを選びます。だから、行った方がいいよ"}, {"type": "subtitle", "time": 6502.47, "timestamp": "01:48:22", "text": "初め。"}, {"type": "subtitle", "time": 6505.03, "timestamp": "01:48:25", "text": "ああ、ただ、もし私が"}, {"type": "subtitle", "time": 6506.95, "timestamp": "01:48:26", "text": "盗むか盗まないか。だから、私はただ作りたいだけです"}, {"type": "subtitle", "time": 6510.87, "timestamp": "01:48:30", "text": "もちろん、あなたが最初にそれを手に入れるでしょう。"}, {"type": "subtitle", "time": 6514.55, "timestamp": "01:48:34", "text": "つまり、HPが最も低い人"}, {"type": "subtitle", "time": 6516.709, "timestamp": "01:48:36", "text": "彼らが中に入った方が良いでしょう"}, {"type": "subtitle", "time": 6519.59, "timestamp": "01:48:39", "text": "まず、十分なHPを得ること。私は"}, {"type": "subtitle", "time": 6522.24, "timestamp": "01:48:42", "text": "全員が理解しているかどうかはよくわからない。"}]
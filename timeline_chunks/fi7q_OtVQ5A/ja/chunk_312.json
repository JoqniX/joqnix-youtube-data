[{"type": "subtitle", "time": 18731.03, "timestamp": "05:12:11", "text": "イエス・キリスト。私は最後までやり遂げなければならなかった"}, {"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "地図を開いて確認してください。うん、"}, {"type": "subtitle", "time": 18757.03, "timestamp": "05:12:37", "text": "後でそうします。はい、これでよし。"}, {"type": "subtitle", "time": 18763.59, "timestamp": "05:12:43", "text": "これはどれくらいの長さですか？"}, {"type": "subtitle", "time": 18765.43, "timestamp": "05:12:45", "text": "ああ、私は正しい方向に向かっている。私"}]
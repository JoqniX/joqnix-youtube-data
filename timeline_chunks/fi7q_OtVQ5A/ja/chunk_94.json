[{"type": "subtitle", "time": 5645.35, "timestamp": "01:34:05", "text": "眠れない。私は誓います"}, {"type": "subtitle", "time": 5648.47, "timestamp": "01:34:08", "text": "私はボードを置いて、寝ました"}, {"type": "subtitle", "time": 5651.669, "timestamp": "01:34:11", "text": "オフ。実際、私が最初に"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "ストリームをリメイクする予定だった"}, {"type": "subtitle", "time": 5662.47, "timestamp": "01:34:22", "text": "ああ、なんてことだ。この人は"}, {"type": "subtitle", "time": 5670.149, "timestamp": "01:34:30", "text": "彼はどうやってこれを成し遂げているのだろうか？彼は強すぎる。"}, {"type": "subtitle", "time": 5684.39, "timestamp": "01:34:44", "text": "なんてこった。"}, {"type": "subtitle", "time": 5687.83, "timestamp": "01:34:47", "text": "えっと、ここはどこですか？わかった。"}, {"type": "subtitle", "time": 5691.189, "timestamp": "01:34:51", "text": "ああ、ホグワーツ。ええ、そうですね。私は"}, {"type": "subtitle", "time": 5694.07, "timestamp": "01:34:54", "text": "これ、すごく好きです。メイ、あなたは王冠を持っている"}, {"type": "subtitle", "time": 5697.03, "timestamp": "01:34:57", "text": "このことについて。"}]
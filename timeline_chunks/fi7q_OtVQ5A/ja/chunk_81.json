[{"type": "subtitle", "time": 4874.63, "timestamp": "01:21:14", "text": "このアップデートが投稿されたら、またはいいね"}, {"type": "subtitle", "time": 4876.63, "timestamp": "01:21:16", "text": "ライブライブ、みんな"}, {"type": "subtitle", "time": 4887.83, "timestamp": "01:21:27", "text": "みんなが「わあ、君は"}, {"type": "subtitle", "time": 4891.189, "timestamp": "01:21:31", "text": "健康バグが再び発生しない"}, {"type": "subtitle", "time": 4894.87, "timestamp": "01:21:34", "text": "「もう無理だ。」ああ、なんてことだ。"}, {"type": "subtitle", "time": 4896.63, "timestamp": "01:21:36", "text": "良い、"}, {"type": "subtitle", "time": 4898.07, "timestamp": "01:21:38", "text": "いつ追加されるかはわかりません"}, {"type": "subtitle", "time": 4899.83, "timestamp": "01:21:39", "text": "それ。彼らが既に持っているかどうかはわかりません"}, {"type": "subtitle", "time": 4902.39, "timestamp": "01:21:42", "text": "それを追加するが、彼らは追加する予定である"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "ゲーム内で模倣する。真似る。"}, {"type": "subtitle", "time": 4907.83, "timestamp": "01:21:47", "text": "うんうん。"}, {"type": "subtitle", "time": 4911.35, "timestamp": "01:21:51", "text": "おお。何てことだ。"}, {"type": "subtitle", "time": 4913.99, "timestamp": "01:21:53", "text": "生活は何が変わったのか？"}]
[{"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "ああ、トイレの中にダイヤモンドが入っていたんだ。"}, {"type": "subtitle", "time": 5430.149, "timestamp": "01:30:30", "text": "おお。"}, {"type": "subtitle", "time": 5435.91, "timestamp": "01:30:35", "text": "何？うん。何？うん。"}, {"type": "subtitle", "time": 5459.189, "timestamp": "01:30:59", "text": "おいおい、勘弁してくれよ。死んだ。私はまた死んだ。彼"}]
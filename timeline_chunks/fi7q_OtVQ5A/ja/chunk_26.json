[{"type": "subtitle", "time": 1566.149, "timestamp": "00:26:06", "text": "興奮した。なぜ私は興奮しているのだろうか？私"}, {"type": "subtitle", "time": 1567.99, "timestamp": "00:26:07", "text": "わからない。"}, {"type": "subtitle", "time": 1573.51, "timestamp": "00:26:13", "text": "これはまずい。これはまずい。"}, {"type": "subtitle", "time": 1575.99, "timestamp": "00:26:15", "text": "私の私の"}, {"type": "subtitle", "time": 1578.23, "timestamp": "00:26:18", "text": "あ、待って。落下による損傷はありません。ああ、"}, {"type": "subtitle", "time": 1579.99, "timestamp": "00:26:19", "text": "落下による損傷はありますか？がある。がある"}, {"type": "subtitle", "time": 1583.269, "timestamp": "00:26:23", "text": "ちなみに、落下による損傷です。ああ、くそ。私は"}, {"type": "subtitle", "time": 1585.35, "timestamp": "00:26:25", "text": "世間知らずなタイルの1つが"}, {"type": "subtitle", "time": 1587.11, "timestamp": "00:26:27", "text": "まるで、あの男が戻ってきたみたいだ。その男は"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "戻る。あの男が戻ってきた。うん。おお、いいね。"}, {"type": "subtitle", "time": 1598.95, "timestamp": "00:26:38", "text": "ああ、くそ。イエス・キリストよ、おい。"}, {"type": "subtitle", "time": 1600.71, "timestamp": "00:26:40", "text": "ああ、彼はキャンプをしている男だ。そこには"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "キャンプをしている男。キャンプをしている男がいる。"}, {"type": "subtitle", "time": 1604.47, "timestamp": "00:26:44", "text": "キャンプをしている男がいる。男がいる"}, {"type": "subtitle", "time": 1615.11, "timestamp": "00:26:55", "text": "ニース。ああ、勝ったよ。ニース。私たちは勝った。"}]
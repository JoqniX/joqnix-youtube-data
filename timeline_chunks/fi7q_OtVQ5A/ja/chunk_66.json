[{"type": "subtitle", "time": 3966.47, "timestamp": "01:06:06", "text": "気をつけて。あ、つまずいちゃった。"}, {"type": "subtitle", "time": 3975.27, "timestamp": "01:06:15", "text": "これは私にとって全く新しい経験です。 「うわあ、"}, {"type": "subtitle", "time": 3979.109, "timestamp": "01:06:19", "text": "このゲームはベータ版の方がずっと面白い。"}, {"type": "subtitle", "time": 4003.51, "timestamp": "01:06:43", "text": "その飲み物が私が飲まないかどうか見てみましょう"}, {"type": "subtitle", "time": 4006.23, "timestamp": "01:06:46", "text": "カートに入れることができません。"}, {"type": "subtitle", "time": 4008.63, "timestamp": "01:06:48", "text": "液体がこぼれるでしょう。"}, {"type": "subtitle", "time": 4010.47, "timestamp": "01:06:50", "text": "どれ？"}, {"type": "subtitle", "time": 4013.43, "timestamp": "01:06:53", "text": "はい、それです。はい。"}, {"type": "subtitle", "time": 4015.75, "timestamp": "01:06:55", "text": "だから、慎重に置いてみてください。"}]
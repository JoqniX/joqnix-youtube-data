[{"type": "subtitle", "time": 14774.63, "timestamp": "04:06:14", "text": "[音楽]"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "はい。これは、とても昔の私です。私はします"}, {"type": "subtitle", "time": 14779.59, "timestamp": "04:06:19", "text": "それについては知らなかった。私は知りません"}, {"type": "subtitle", "time": 14787.269, "timestamp": "04:06:27", "text": "この後、何か仕事はありますか？いいえ、この最後の"}, {"type": "subtitle", "time": 14790.63, "timestamp": "04:06:30", "text": "1つ。彼は引退する。"}, {"type": "subtitle", "time": 14792.87, "timestamp": "04:06:32", "text": "他の機会を模索している。ねえ、"}, {"type": "subtitle", "time": 14794.63, "timestamp": "04:06:34", "text": "早期死亡の可能性が高まる"}, {"type": "subtitle", "time": 14797.349, "timestamp": "04:06:37", "text": "退職すると劇的に変わる。うん、そうするよ"}, {"type": "subtitle", "time": 14814.07, "timestamp": "04:06:54", "text": "そうでしょう？気まずかった。"}, {"type": "subtitle", "time": 14816.55, "timestamp": "04:06:56", "text": "あった。私は、なぜ黙っているんだろうと思う"}, {"type": "subtitle", "time": 14819.349, "timestamp": "04:06:59", "text": "けれど？私は"}]
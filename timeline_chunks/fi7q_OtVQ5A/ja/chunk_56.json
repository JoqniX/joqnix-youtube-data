[{"type": "subtitle", "time": 3369.91, "timestamp": "00:56:09", "text": "ああ、28k。それは正しい。中に入ると"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "まず、君のHPが低いからだ。はい、どうぞ。"}, {"type": "subtitle", "time": 3376.71, "timestamp": "00:56:16", "text": "現在のHPはいくつですか？ああ、51歳か。"}, {"type": "subtitle", "time": 3380.23, "timestamp": "00:56:20", "text": "それらはあなたに50馬力を与えます。おお。私はまだ"}, {"type": "subtitle", "time": 3382.23, "timestamp": "00:56:22", "text": "100点だから、大丈夫だ。だからあなたに言ったんだよ"}, {"type": "subtitle", "time": 3390.39, "timestamp": "00:56:30", "text": "それはすばらしい。概して"}, {"type": "subtitle", "time": 3395.349, "timestamp": "00:56:35", "text": "通常のものは、30 30 HP 程度です。"}, {"type": "subtitle", "time": 3397.349, "timestamp": "00:56:37", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 3400.87, "timestamp": "00:56:40", "text": "そうそう。"}, {"type": "subtitle", "time": 3402.63, "timestamp": "00:56:42", "text": "そして、変わる。"}, {"type": "subtitle", "time": 3407.67, "timestamp": "00:56:47", "text": "ああ、もう。羽根があるの？"}, {"type": "subtitle", "time": 3411.27, "timestamp": "00:56:51", "text": "フェザー。ああ、ドローンだ。ああ、それは"}, {"type": "subtitle", "time": 3414.15, "timestamp": "00:56:54", "text": "ドローン。物事を軽くするためだ。"}, {"type": "subtitle", "time": 3416.069, "timestamp": "00:56:56", "text": "ああ、"}]
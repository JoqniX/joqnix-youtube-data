[{"type": "subtitle", "time": 17474.31, "timestamp": "04:51:14", "text": "ねえ、見て。"}, {"type": "subtitle", "time": 17476.55, "timestamp": "04:51:16", "text": "キャンセルできます。ドラマチックな展開は一切なし。私を殴って"}, {"type": "subtitle", "time": 17479.35, "timestamp": "04:51:19", "text": "そうだよ、男。犬よ、大変なことになったぞ。私の"}, {"type": "subtitle", "time": 17483.03, "timestamp": "04:51:23", "text": "男の子たちだよ。ええ、私たちは救おうとしているんです。あなた"}, {"type": "subtitle", "time": 17484.708, "timestamp": "04:51:24", "text": "仲間たちのために実際に何かをする"}, {"type": "subtitle", "time": 17487.75, "timestamp": "04:51:27", "text": "気分転換に？もちろん参加するよ。誰が？"}, {"type": "subtitle", "time": 17489.83, "timestamp": "04:51:29", "text": "仲間を拍手したい？そうしない人は、"}, {"type": "subtitle", "time": 17492.868, "timestamp": "04:51:32", "text": "[ __ ]？この中国人ども？脂肪分が少し？"}, {"type": "subtitle", "time": 17495.03, "timestamp": "04:51:35", "text": "私たちを騙した金持ちの白人野郎"}, {"type": "subtitle", "time": 17496.55, "timestamp": "04:51:36", "text": "カロン。"}, {"type": "subtitle", "time": 17498.868, "timestamp": "04:51:38", "text": "あの生意気な女。なぜ私たちは言わなかったのですか"}, {"type": "subtitle", "time": 17501.51, "timestamp": "04:51:41", "text": "忍び寄っていたのか？こっそり忍び寄っているわけじゃない"}, {"type": "subtitle", "time": 17503.27, "timestamp": "04:51:43", "text": "あいつだよ、[ __ ]。少なくとも私は彼が"}, {"type": "subtitle", "time": 17504.55, "timestamp": "04:51:44", "text": "そこに行くつもりです。私たちはすべてを手に入れなければならない"}, {"type": "subtitle", "time": 17506.23, "timestamp": "04:51:46", "text": "暑さ"}, {"type": "subtitle", "time": 17510.31, "timestamp": "04:51:50", "text": "彼の尻について。"}, {"type": "subtitle", "time": 17513.03, "timestamp": "04:51:53", "text": "ああ、もちろんさ。俺たちはあのバカをこっそり監視している。"}, {"type": "subtitle", "time": 17516.47, "timestamp": "04:51:56", "text": "お前が"}, {"type": "subtitle", "time": 17518.868, "timestamp": "04:51:58", "text": "理解しようとしている"}]
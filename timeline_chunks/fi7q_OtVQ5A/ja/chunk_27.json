[{"type": "subtitle", "time": 1622.549, "timestamp": "00:27:02", "text": "すごくかっこいい。"}, {"type": "subtitle", "time": 1625.029, "timestamp": "00:27:05", "text": "ちなみに、私は誰も殺していません。私は殺したのか"}, {"type": "subtitle", "time": 1627.029, "timestamp": "00:27:07", "text": "誰でも？私はそうは思わない。私は殺さない"}, {"type": "subtitle", "time": 1629.029, "timestamp": "00:27:09", "text": "誰でも。ああ、私は３人を殺した。おお、"}, {"type": "subtitle", "time": 1631.11, "timestamp": "00:27:11", "text": "いいね。"}, {"type": "subtitle", "time": 1636.07, "timestamp": "00:27:16", "text": "ああ、ジョック。いやあ、君はすごくよくやってるよ。"}, {"type": "subtitle", "time": 1639.269, "timestamp": "00:27:19", "text": "あ、待って。私は2人倒しました。何？私"}, {"type": "subtitle", "time": 1641.43, "timestamp": "00:27:21", "text": "知らなかった"}, {"type": "subtitle", "time": 1661.75, "timestamp": "00:27:41", "text": "わかった。とにかく、私はただ"}, {"type": "subtitle", "time": 1670.23, "timestamp": "00:27:50", "text": "見せびらかせるときは見せびらかせる"}, {"type": "subtitle", "time": 1672.47, "timestamp": "00:27:52", "text": "私にはそれがとても必要です。"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "新品同様の状態です。"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "どれくらい必要ですか？"}]
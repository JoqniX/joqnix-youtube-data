[{"type": "subtitle", "time": 6121.03, "timestamp": "01:42:01", "text": "ここでチェックインしましょう。はい、氷があります"}, {"type": "subtitle", "time": 6122.87, "timestamp": "01:42:02", "text": "あれ。"}, {"type": "subtitle", "time": 6126.709, "timestamp": "01:42:06", "text": "氷だと思う。"}, {"type": "subtitle", "time": 6152.55, "timestamp": "01:42:32", "text": "車の横を通ってこちらへ進んでください。私は言った"}, {"type": "subtitle", "time": 6162.07, "timestamp": "01:42:42", "text": "私は車が"}, {"type": "subtitle", "time": 6171.03, "timestamp": "01:42:51", "text": "うん。ああ、わかりました。大丈夫です。それはそれ"}]
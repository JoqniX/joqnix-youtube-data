[{"type": "subtitle", "time": 9548.79, "timestamp": "02:39:08", "text": "ショッピングカートをどうやって"}, {"type": "subtitle", "time": 9551.75, "timestamp": "02:39:11", "text": "そこには？それは抽出量の減少を意味します。"}, {"type": "subtitle", "time": 9559.91, "timestamp": "02:39:19", "text": "私たちはもう141を終えましたよね？"}, {"type": "subtitle", "time": 9563.429, "timestamp": "02:39:23", "text": "だから、二度と同じことはできません。わかった。うん。"}, {"type": "subtitle", "time": 9567.75, "timestamp": "02:39:27", "text": "ショッピングカートのことは気にしないでください。の"}, {"type": "subtitle", "time": 9569.429, "timestamp": "02:39:29", "text": "ショッピングカートで構いません。手に入れる"}, {"type": "subtitle", "time": 9571.19, "timestamp": "02:39:31", "text": "破壊された。"}, {"type": "subtitle", "time": 9574.55, "timestamp": "02:39:34", "text": "うん。そして、もう一度チャンスがある。わかった。"}, {"type": "subtitle", "time": 9579.19, "timestamp": "02:39:39", "text": "トラックに向かう"}, {"type": "subtitle", "time": 9588.63, "timestamp": "02:39:48", "text": "探索中。"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "足りなかった。"}, {"type": "subtitle", "time": 9597.11, "timestamp": "02:39:57", "text": "おお。"}]
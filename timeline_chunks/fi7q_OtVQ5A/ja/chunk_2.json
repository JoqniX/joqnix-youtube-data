[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "お尻がすごく大きい。なかなかいい感じだ。私"}, {"type": "subtitle", "time": 125.91, "timestamp": "00:02:05", "text": "見る。たくさんの足音が聞こえる。これ"}, {"type": "subtitle", "time": 128.71, "timestamp": "00:02:08", "text": "私に言わせれば、最高とは言えない。私"}, {"type": "subtitle", "time": 136.63, "timestamp": "00:02:16", "text": "ああ、ジャック、君は私の近くにいるんだね。ああ、あなたの名前は"}, {"type": "subtitle", "time": 137.99, "timestamp": "00:02:17", "text": "待って、あなたは私の近くにいない。ああ、君の番だ"}, {"type": "subtitle", "time": 141.11, "timestamp": "00:02:21", "text": "そこには。了解、了解。ああ。"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "わかりました、こちらへ行きます。上に行くよ"}, {"type": "subtitle", "time": 144.47, "timestamp": "00:02:24", "text": "それでは。"}, {"type": "subtitle", "time": 153.43, "timestamp": "00:02:33", "text": "わかった。ところで、鎧は持っていますか？"}, {"type": "subtitle", "time": 155.91, "timestamp": "00:02:35", "text": "はい、そうします。"}, {"type": "subtitle", "time": 157.75, "timestamp": "00:02:37", "text": "上級レベル３をお持ちですか？"}, {"type": "subtitle", "time": 161.589, "timestamp": "00:02:41", "text": "何か持っていますか？えっと、私は"}, {"type": "subtitle", "time": 168.63, "timestamp": "00:02:48", "text": "イエス・キリスト、本当にたくさんいる"}, {"type": "subtitle", "time": 171.35, "timestamp": "00:02:51", "text": "ここにいる人々。ごめんなさい。"}, {"type": "subtitle", "time": 179.03, "timestamp": "00:02:59", "text": "えっと、ところで、あなたは今どこにいるんですか？どこ？"}]
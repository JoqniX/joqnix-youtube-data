[{"type": "subtitle", "time": 903.75, "timestamp": "00:15:03", "text": "こんにちは。こんにちは。また、私の"}, {"type": "subtitle", "time": 906.31, "timestamp": "00:15:06", "text": "ストリームがクラッシュしたか何か"}, {"type": "subtitle", "time": 908.71, "timestamp": "00:15:08", "text": "私を見張っていてください。でも、それでも私にさせてください"}, {"type": "subtitle", "time": 915.189, "timestamp": "00:15:15", "text": "でも、まあいいでしょう。よし。また戻ってきます。"}, {"type": "subtitle", "time": 917.43, "timestamp": "00:15:17", "text": "おい。みなさん、こんにちは。"}, {"type": "subtitle", "time": 919.59, "timestamp": "00:15:19", "text": "みなさん、こんにちは。戻ってきました。えっと、皆さんこんにちは。知っている"}, {"type": "subtitle", "time": 921.99, "timestamp": "00:15:21", "text": "あなたは私がいなくて寂しかったでしょう。ああ、わかった。さあ行こう。誰も"}, {"type": "subtitle", "time": 925.35, "timestamp": "00:15:25", "text": "死んだ。誰もそうしなかった。誰もそうしなかった。"}, {"type": "subtitle", "time": 927.75, "timestamp": "00:15:27", "text": "私は、誰かが実際に"}, {"type": "subtitle", "time": 932.71, "timestamp": "00:15:32", "text": "した。私はそうは思わない。待って。あなたではない。"}, {"type": "subtitle", "time": 934.389, "timestamp": "00:15:34", "text": "いや、いや、いや。君の言う通りだと思うよ。誰も"}, {"type": "subtitle", "time": 937.269, "timestamp": "00:15:37", "text": "誰もキスをしなかった。"}, {"type": "subtitle", "time": 943.03, "timestamp": "00:15:43", "text": "待って。"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "あなたは同意した。待って。何が何だ"}, {"type": "subtitle", "time": 952.629, "timestamp": "00:15:52", "text": "誰もあなたの発言に賛同していませんよ。"}, {"type": "subtitle", "time": 956.47, "timestamp": "00:15:56", "text": "誰も君のことを気にかけていないよ、友よ。ええ、私は"}, {"type": "subtitle", "time": 958.71, "timestamp": "00:15:58", "text": "私はそれを言った。私はそれを言った。誰も気にしない、"}]
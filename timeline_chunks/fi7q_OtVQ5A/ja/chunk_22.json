[{"type": "subtitle", "time": 1322.47, "timestamp": "00:22:02", "text": "私の友人。私じゃないよ。いいえ、見ないでください。見て"}, {"type": "subtitle", "time": 1325.35, "timestamp": "00:22:05", "text": "離れて。そして、それはまさにあなただった。お見せしましょう"}, {"type": "subtitle", "time": 1329.43, "timestamp": "00:22:09", "text": "オフ。わかった。お見せしましょう。私だけ。"}, {"type": "subtitle", "time": 1334.149, "timestamp": "00:22:14", "text": "いいえ、見せません。どこかに行って。待って。"}, {"type": "subtitle", "time": 1336.71, "timestamp": "00:22:16", "text": "それが私の役目です。おお、レベル"}, {"type": "subtitle", "time": 1338.39, "timestamp": "00:22:18", "text": "バックパック3つ。ああ、もう一人いる。あなた"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "ジャックならできるよ。"}, {"type": "subtitle", "time": 1343.43, "timestamp": "00:22:23", "text": "はい。これです。これを受け取って。ああ、君たち"}, {"type": "subtitle", "time": 1345.75, "timestamp": "00:22:25", "text": "とても遠い。"}, {"type": "subtitle", "time": 1347.35, "timestamp": "00:22:27", "text": "うん。つまり、あなたは来るはずだった"}, {"type": "subtitle", "time": 1349.909, "timestamp": "00:22:29", "text": "私たちと一緒に。残念ながら、"}, {"type": "subtitle", "time": 1352.63, "timestamp": "00:22:32", "text": "君の猿の脳はうまく機能していない"}, {"type": "subtitle", "time": 1354.47, "timestamp": "00:22:34", "text": "最近では。"}, {"type": "subtitle", "time": 1356.549, "timestamp": "00:22:36", "text": "ああ、私たちは今から死ぬんだ。かっこいい。"}, {"type": "subtitle", "time": 1359.27, "timestamp": "00:22:39", "text": "大丈夫です。それで構いません。シャク、"}, {"type": "subtitle", "time": 1360.71, "timestamp": "00:22:40", "text": "あなたはこれを拾っていません"}, {"type": "subtitle", "time": 1362.87, "timestamp": "00:22:42", "text": "レベル3のバックパックだよ、相棒。ああ、私は"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "レベル3のバックパック。おお、いいね。待って、"}, {"type": "subtitle", "time": 1367.19, "timestamp": "00:22:47", "text": "もう死ぬしかないな。"}, {"type": "subtitle", "time": 1376.47, "timestamp": "00:22:56", "text": "おお、いいね。私は407を持っています。"}]
[{"type": "subtitle", "time": 9910.469, "timestamp": "02:45:10", "text": "わかった。だから私は"}, {"type": "subtitle", "time": 9913.03, "timestamp": "02:45:13", "text": "時刻は4時45分です。わかりました、少し"}, {"type": "subtitle", "time": 9916.07, "timestamp": "02:45:16", "text": "壊す。すぐ戻ってきます。次に"}, {"type": "subtitle", "time": 9919.83, "timestamp": "02:45:19", "text": "コラボレーションは夜に行われます。私はまだ聞いていません"}, {"type": "subtitle", "time": 9921.429, "timestamp": "02:45:21", "text": "もし"}, {"type": "subtitle", "time": 9926.63, "timestamp": "02:45:26", "text": "えっと、もし彼女が今日都合がつくなら、あるいは私たちが"}, {"type": "subtitle", "time": 9931.67, "timestamp": "02:45:31", "text": "今日はリーミング作業が必要だ。ええと、でも、いいえ"}, {"type": "subtitle", "time": 9933.83, "timestamp": "02:45:33", "text": "本日中に日程変更をお願いします。まあ、そうですね。"}, {"type": "subtitle", "time": 9942.79, "timestamp": "02:45:42", "text": "全てが順調であることを願っています。"}, {"type": "subtitle", "time": 9945.67, "timestamp": "02:45:45", "text": "うん。"}]
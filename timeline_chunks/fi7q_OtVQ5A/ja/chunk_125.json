[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "そうでないことを願います。"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "何がおかしいんだ"}, {"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "お前？"}, {"type": "subtitle", "time": 7512.95, "timestamp": "02:05:12", "text": "分かりません。なぜなのかさえわからない"}, {"type": "subtitle", "time": 7514.55, "timestamp": "02:05:14", "text": "彼は第一レベルにいる。彼は"}, {"type": "subtitle", "time": 7521.589, "timestamp": "02:05:21", "text": "私のところへ来なさい。何てことだ。私は"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "お前を殺す。"}, {"type": "subtitle", "time": 7526.629, "timestamp": "02:05:26", "text": "できればいいのに。いや、いや、いや。"}, {"type": "subtitle", "time": 7528.709, "timestamp": "02:05:28", "text": "そんなつもりじゃなかったんです。私は意図していませんでした"}, {"type": "subtitle", "time": 7530.47, "timestamp": "02:05:30", "text": "それ。そんなつもりじゃなかったんです。ごめんなさい。"}, {"type": "subtitle", "time": 7534.229, "timestamp": "02:05:34", "text": "ごめんなさい。ごめんなさい。ごめんなさい。"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "彼はなぜ有利な立場にいるのですか？"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "何てことだ。大丈夫。お分かりですね。あなた"}]
[{"type": "subtitle", "time": 17403.27, "timestamp": "04:50:03", "text": "この家までブラマを迎えに行って。わかった、"}, {"type": "subtitle", "time": 17408.76, "timestamp": "04:50:08", "text": "V."}, {"type": "subtitle", "time": 17410.07, "timestamp": "04:50:10", "text": "[音楽]"}, {"type": "subtitle", "time": 17414.95, "timestamp": "04:50:14", "text": "さあ行こう。さあ行こう。おお、"}, {"type": "subtitle", "time": 17430.47, "timestamp": "04:50:30", "text": "男。私が選んだこの選択肢は"}, {"type": "subtitle", "time": 17433.75, "timestamp": "04:50:33", "text": "多少は役に立つだろう。"}, {"type": "subtitle", "time": 17436.23, "timestamp": "04:50:36", "text": "私は3つの結末を見ませんでした"}, {"type": "subtitle", "time": 17437.99, "timestamp": "04:50:37", "text": "違う 待って、つまり3つだけなの？"}, {"type": "subtitle", "time": 17441.19, "timestamp": "04:50:41", "text": "このゲームのエンディング。"}, {"type": "subtitle", "time": 17443.03, "timestamp": "04:50:43", "text": "おお。何か秘密があると思った"}, {"type": "subtitle", "time": 17445.19, "timestamp": "04:50:45", "text": "終わりとか、そんな感じ。 4つ目の選択肢または"}, {"type": "subtitle", "time": 17447.43, "timestamp": "04:50:47", "text": "何か。"}, {"type": "subtitle", "time": 17455.27, "timestamp": "04:50:55", "text": "まあ、これは長いゲームだから、"}]
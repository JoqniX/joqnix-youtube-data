[{"type": "subtitle", "time": 1509.909, "timestamp": "00:25:09", "text": "私は何らかの理由で私は近くにいます私は"}, {"type": "subtitle", "time": 1511.51, "timestamp": "00:25:11", "text": "プレイヤーの近くにいる プレイヤーの近くにいる 私はそうではない"}, {"type": "subtitle", "time": 1515.19, "timestamp": "00:25:15", "text": "なぜ私が[ __ ]しに行かなければならないのか、わかるでしょう"}, {"type": "subtitle", "time": 1517.669, "timestamp": "00:25:17", "text": "あなたのチーム"}, {"type": "subtitle", "time": 1520.07, "timestamp": "00:25:20", "text": "死にたい、死にたい、"}, {"type": "subtitle", "time": 1523.19, "timestamp": "00:25:23", "text": "今すぐ捨てる"}, {"type": "subtitle", "time": 1525.669, "timestamp": "00:25:25", "text": "わかったよ、もし生きてるなら、"}, {"type": "subtitle", "time": 1529.19, "timestamp": "00:25:29", "text": "かなりクールで安全になりそうだ"}, {"type": "subtitle", "time": 1531.669, "timestamp": "00:25:31", "text": "これがこの地図の最後の使用となります。"}, {"type": "subtitle", "time": 1535.029, "timestamp": "00:25:35", "text": "なぜあの罠はまだ機能しているのだろうか？"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "ええ、トラップマスターのアイテムがあります"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "まだ生きている。いいえ、なぜまだ動いているのですか？"}, {"type": "subtitle", "time": 1543.83, "timestamp": "00:25:43", "text": "私に対して？私が戻ってきた後も、"}, {"type": "subtitle", "time": 1545.909, "timestamp": "00:25:45", "text": "空挺降下作戦が来る。大丈夫です。大丈夫です、"}, {"type": "subtitle", "time": 1548.549, "timestamp": "00:25:48", "text": "ウェイン。おそらく、貧乏なゲーマーでしょう"}, {"type": "subtitle", "time": 1550.63, "timestamp": "00:25:50", "text": "誰も知らないもの ああ、そこに男がいる"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "屋根。屋根の上に男がいる。"}, {"type": "subtitle", "time": 1553.43, "timestamp": "00:25:53", "text": "ああ、彼とは関わらない方がいいよ。しないで"}, {"type": "subtitle", "time": 1555.59, "timestamp": "00:25:55", "text": "彼と関わる。大丈夫です。我々は勝つ必要がある"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "どういうわけか、これは奇妙な理由によるものだ。私たちには"}]
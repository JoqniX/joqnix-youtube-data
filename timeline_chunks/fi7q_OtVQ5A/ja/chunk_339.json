[{"type": "subtitle", "time": 20343.83, "timestamp": "05:39:03", "text": "ここにいるよ。年老いて、疲れ果てて、孤独だ。私は"}, {"type": "subtitle", "time": 20347.67, "timestamp": "05:39:07", "text": "本当に申し訳ありませんでした。その通り。のために"}, {"type": "subtitle", "time": 20350.15, "timestamp": "05:39:10", "text": "すべて。"}, {"type": "subtitle", "time": 20355.03, "timestamp": "05:39:15", "text": "私はもう年寄りなのよ、トレバー。私は持っていません"}, {"type": "subtitle", "time": 20357.83, "timestamp": "05:39:17", "text": "保険。お金がある。私はほしくない"}, {"type": "subtitle", "time": 20360.23, "timestamp": "05:39:20", "text": "お前の金だ。それはあなたが"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "ひどく痛む。"}, {"type": "subtitle", "time": 20375.67, "timestamp": "05:39:35", "text": "もっと妄想を仕入れてくれ。"}, {"type": "subtitle", "time": 20378.31, "timestamp": "05:39:38", "text": "私ならできます。たくさんあります。 A"}, {"type": "subtitle", "time": 20381.03, "timestamp": "05:39:41", "text": "文字通り、トラック一台分です。そしてそれらは"}, {"type": "subtitle", "time": 20385.11, "timestamp": "05:39:45", "text": "ひょろひょろとした小さなものたち。千個。"}, {"type": "subtitle", "time": 20389.03, "timestamp": "05:39:49", "text": "そして、もしあなたが私を紳士だと感じてくれるなら、"}]
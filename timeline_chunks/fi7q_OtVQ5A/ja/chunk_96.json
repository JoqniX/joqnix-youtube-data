[{"type": "subtitle", "time": 5760.55, "timestamp": "01:36:00", "text": "撃ったぞ。"}, {"type": "subtitle", "time": 5763.35, "timestamp": "01:36:03", "text": "ああ。わかった。"}, {"type": "subtitle", "time": 5765.35, "timestamp": "01:36:05", "text": "何てことだ。"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "どうしてあなたは、どうして見逃したのですか？それ"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "男が来た。何？なるほど、感心しました。おお"}, {"type": "subtitle", "time": 5793.669, "timestamp": "01:36:33", "text": "我が神よ。"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "おお。何が起こったのか、私には全く分からない。"}]
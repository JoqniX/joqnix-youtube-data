[{"type": "subtitle", "time": 5714.79, "timestamp": "01:35:14", "text": "その部分。"}, {"type": "subtitle", "time": 5717.11, "timestamp": "01:35:17", "text": "彼らはこの時に憎悪の部分を設けるべきだった"}, {"type": "subtitle", "time": 5720.07, "timestamp": "01:35:20", "text": "ポイント。ああ、それはとても良い"}, {"type": "subtitle", "time": 5723.99, "timestamp": "01:35:23", "text": "アイデア。はい。車を"}, {"type": "subtitle", "time": 5726.149, "timestamp": "01:35:26", "text": "あなたの廊下。はい、どうぞ。そのままにしておいて"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "そこには。完璧。ああ、それはとても"}, {"type": "subtitle", "time": 5731.75, "timestamp": "01:35:31", "text": "良い考えだ。あなたは彼らに伝えるべきです。"}, {"type": "subtitle", "time": 5733.51, "timestamp": "01:35:33", "text": "[音楽]"}, {"type": "subtitle", "time": 5735.35, "timestamp": "01:35:35", "text": "そこからいくらかお金が手に入るかもしれませんよ。その"}, {"type": "subtitle", "time": 5737.189, "timestamp": "01:35:37", "text": "あなたのアイデア。"}, {"type": "subtitle", "time": 5739.27, "timestamp": "01:35:39", "text": "本当に？"}, {"type": "subtitle", "time": 5754.47, "timestamp": "01:35:54", "text": "うん。私も押したから大丈夫だと思う。"}, {"type": "subtitle", "time": 5755.99, "timestamp": "01:35:55", "text": "あなたはあの男のために何を話すつもりですか？"}, {"type": "subtitle", "time": 5758.629, "timestamp": "01:35:58", "text": "あの男は"}]
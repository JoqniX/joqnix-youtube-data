[{"type": "subtitle", "time": 12480.08, "timestamp": "03:28:00", "text": "それ"}, {"type": "subtitle", "time": 12481.269, "timestamp": "03:28:01", "text": "[音楽]"}, {"type": "subtitle", "time": 12484.07, "timestamp": "03:28:04", "text": "ある日、私はこう言っていました、"}, {"type": "subtitle", "time": 12487.19, "timestamp": "03:28:07", "text": "ズマに気をつけろ。はぁ？"}, {"type": "subtitle", "time": 12496.63, "timestamp": "03:28:16", "text": "私をズンバと呼ぶのはやめてください。はい、静かに。おい、"}, {"type": "subtitle", "time": 12503.269, "timestamp": "03:28:23", "text": "その無礼さ"}, {"type": "subtitle", "time": 12505.51, "timestamp": "03:28:25", "text": "まったく男じゃない。"}, {"type": "subtitle", "time": 12508.87, "timestamp": "03:28:28", "text": "ズマって呼んだ方がいいですか？はぁ？"}, {"type": "subtitle", "time": 12512.07, "timestamp": "03:28:32", "text": "私はあなたのことを何か呼んでいますか？"}, {"type": "subtitle", "time": 12513.91, "timestamp": "03:28:33", "text": "バ。"}, {"type": "subtitle", "time": 12520.87, "timestamp": "03:28:40", "text": "もしあなたがそのボートについて考えているなら"}, {"type": "subtitle", "time": 12523.59, "timestamp": "03:28:43", "text": "一番下のやつは、私がそれしかやらないんです。エリー"}, {"type": "subtitle", "time": 12525.11, "timestamp": "03:28:45", "text": "からかうように言ったから"}, {"type": "subtitle", "time": 12527.349, "timestamp": "03:28:47", "text": "私がボームであることをやめること"}, {"type": "subtitle", "time": 12530.71, "timestamp": "03:28:50", "text": "そして、私自身もスイッチです。ええ、その他"}]
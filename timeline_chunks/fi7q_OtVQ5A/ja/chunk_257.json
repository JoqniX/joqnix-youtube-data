[{"type": "subtitle", "time": 15422.469, "timestamp": "04:17:02", "text": "ああ、君がその鹿を甘やかしたのを見たよ"}, {"type": "subtitle", "time": 15424.71, "timestamp": "04:17:04", "text": "矢印。"}, {"type": "subtitle", "time": 15427.429, "timestamp": "04:17:07", "text": "でも、私は既に知っていた。ええ、分かっています"}, {"type": "subtitle", "time": 15436.149, "timestamp": "04:17:16", "text": "これ。高速道路の標識を思い出させる。"}, {"type": "subtitle", "time": 15448.229, "timestamp": "04:17:28", "text": "マイケルの家に行きなさい。"}, {"type": "subtitle", "time": 15450.63, "timestamp": "04:17:30", "text": "残して"}, {"type": "subtitle", "time": 15453.91, "timestamp": "04:17:33", "text": "あなたは何百万ドルもプレイしたい"}, {"type": "subtitle", "time": 15465.03, "timestamp": "04:17:45", "text": "相棒。よし。"}, {"type": "subtitle", "time": 15467.11, "timestamp": "04:17:47", "text": "来て。私たちはそれを百万回も経験してきた"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "完全に逃げ切れることが"}, {"type": "subtitle", "time": 15474.389, "timestamp": "04:17:54", "text": "自由に歩く人々の違い"}, {"type": "subtitle", "time": 15476.95, "timestamp": "04:17:56", "text": "そして、そうしない人々もいる。"}, {"type": "subtitle", "time": 15479.67, "timestamp": "04:17:59", "text": "そんなくだらないことには関わりたくない。ああ、"}]
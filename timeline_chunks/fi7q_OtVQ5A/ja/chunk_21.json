[{"type": "subtitle", "time": 1262.149, "timestamp": "00:21:02", "text": "安全区域を示しています。"}, {"type": "subtitle", "time": 1265.909, "timestamp": "00:21:05", "text": "ああ、うんち。"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "「お、紫色の弾薬だ」って思ったよ。あなたは"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "今、私に挨拶してるの？私はここにいた"}, {"type": "subtitle", "time": 1272.23, "timestamp": "00:21:12", "text": "ずっと。ええ、あなたは"}, {"type": "subtitle", "time": 1278.39, "timestamp": "00:21:18", "text": "大丈夫だよ。私はRPDを持っていますが、"}, {"type": "subtitle", "time": 1280.87, "timestamp": "00:21:20", "text": "素晴らしい。"}, {"type": "subtitle", "time": 1284.549, "timestamp": "00:21:24", "text": "私のダイヤモンドRPDについて。"}, {"type": "subtitle", "time": 1287.27, "timestamp": "00:21:27", "text": "みんな、僕のダイヤモンドRPDを見たい？もし"}, {"type": "subtitle", "time": 1289.83, "timestamp": "00:21:29", "text": "ダイヤモンドRPDを見たいなら、私のところに来て"}, {"type": "subtitle", "time": 1291.99, "timestamp": "00:21:31", "text": "ストリーム。ジャックはリンクを持っていると思います"}, {"type": "subtitle", "time": 1294.71, "timestamp": "00:21:34", "text": "それ。はい。君たちは、君たちは気にしている"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "私のダイヤモンドについて。おお。それはとても"}, {"type": "subtitle", "time": 1301.11, "timestamp": "00:21:41", "text": "ダイヤモンド。"}, {"type": "subtitle", "time": 1304.149, "timestamp": "00:21:44", "text": "そうではないと思うが"}, {"type": "subtitle", "time": 1307.19, "timestamp": "00:21:47", "text": "高い。高価です。"}, {"type": "subtitle", "time": 1309.43, "timestamp": "00:21:49", "text": "はい、できますよ。あなたは人々にすべてを伝えます"}, {"type": "subtitle", "time": 1313.43, "timestamp": "00:21:53", "text": "私が持っているダイヤモンド。あなたは一つ持っています。"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "おそらく2人。わからない。私はしません"}, {"type": "subtitle", "time": 1317.75, "timestamp": "00:21:57", "text": "ケア。黙ってろ。"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "あなたは自分のことを言っているのだと思います。"}]
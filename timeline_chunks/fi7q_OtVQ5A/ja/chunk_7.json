[{"type": "subtitle", "time": 420.309, "timestamp": "00:07:00", "text": "私です。私です。"}, {"type": "subtitle", "time": 422.15, "timestamp": "00:07:02", "text": "なんてこった。"}, {"type": "subtitle", "time": 424.95, "timestamp": "00:07:04", "text": "ご心配なく。どこかに行って。ああ、君"}, {"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "バカ。ああ、ウェインも彼を殺した"}, {"type": "subtitle", "time": 429.909, "timestamp": "00:07:09", "text": "あなたのために。"}, {"type": "subtitle", "time": 432.95, "timestamp": "00:07:12", "text": "ああ、俺たちは二人ともお前の死の仇を討ったんだ。"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "死にさえしなかった。誰かが来る。による"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "そのやり方だと、あなたは死にさえしなかった。だから私は"}, {"type": "subtitle", "time": 441.11, "timestamp": "00:07:21", "text": "わからない。私たちはあなたの仇を討っているんだと思う。"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "次の人はどこにいる？私はただ"}, {"type": "subtitle", "time": 446.23, "timestamp": "00:07:26", "text": "彼を殺せ。彼はどこにいますか？彼はどこにいますか？"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "彼は確かにそうする。血に飢えたクソ野郎。"}, {"type": "subtitle", "time": 452.95, "timestamp": "00:07:32", "text": "ああ、あの男が戻ってきた。あの男が戻ってきた。"}, {"type": "subtitle", "time": 455.589, "timestamp": "00:07:35", "text": "あの男が戻ってきたのか？私はハックする"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "念のため、彼をハッキングしておこう。"}, {"type": "subtitle", "time": 462.23, "timestamp": "00:07:42", "text": "ああ、あなたは彼をハッキングするつもりなんですね。はい、私は"}, {"type": "subtitle", "time": 464.23, "timestamp": "00:07:44", "text": "ハッキングするつもりだ。彼をハッキングしてやる。うん、"}, {"type": "subtitle", "time": 466.629, "timestamp": "00:07:46", "text": "見て。ああ、彼は近くにいる。了解、了解。"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "ボットが1体と2体います。あなたのチームメイト"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "殺された"}, {"type": "subtitle", "time": 472.469, "timestamp": "00:07:52", "text": "近く。"}, {"type": "subtitle", "time": 475.35, "timestamp": "00:07:55", "text": "そして彼は３回も死んだ。おお、いいね、"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "いいね、いいね。それは素晴らしい。最高だ。"}, {"type": "subtitle", "time": 478.39, "timestamp": "00:07:58", "text": "いやいや、それはただのボットだよ。しないで"}]
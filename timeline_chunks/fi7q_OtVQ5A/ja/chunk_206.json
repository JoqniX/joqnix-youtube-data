[{"type": "subtitle", "time": 12364.309, "timestamp": "03:26:04", "text": "レーザースクエア。これはレーザースクエアです。"}, {"type": "subtitle", "time": 12366.55, "timestamp": "03:26:06", "text": "ミッションロウ。ああ、こっちだよ。ミッション"}, {"type": "subtitle", "time": 12368.07, "timestamp": "03:26:08", "text": "行。"}, {"type": "subtitle", "time": 12376.469, "timestamp": "03:26:16", "text": "ちょっと遠いですよね？"}, {"type": "subtitle", "time": 12380.309, "timestamp": "03:26:20", "text": "やろうと思えば作れる。"}, {"type": "subtitle", "time": 12382.63, "timestamp": "03:26:22", "text": "スピードが必要"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "車。あのね？これでいきましょう。"}, {"type": "subtitle", "time": 12388.55, "timestamp": "03:26:28", "text": "待って、あなたたちは一体何者なの？あなたは"}, {"type": "subtitle", "time": 12391.429, "timestamp": "03:26:31", "text": "歌詞を書いてるの？行った男"}, {"type": "subtitle", "time": 12395.67, "timestamp": "03:26:35", "text": "昼食を持って行って食べるために、"}, {"type": "subtitle", "time": 12398.79, "timestamp": "03:26:38", "text": "自分にはお金がないことに気づいた。はぁ？何が"}, {"type": "subtitle", "time": 12400.71, "timestamp": "03:26:40", "text": "実際にまた起こっているのですか？私は超"}, {"type": "subtitle", "time": 12417.83, "timestamp": "03:26:57", "text": "ヘルプ。あの男が私の車を盗んだ。"}]
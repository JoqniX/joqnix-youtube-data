[{"type": "subtitle", "time": 16262.71, "timestamp": "04:31:02", "text": "ビニールとCGJがあります"}, {"type": "subtitle", "time": 16266.149, "timestamp": "04:31:06", "text": "そして、そして、"}, {"type": "subtitle", "time": 16267.99, "timestamp": "04:31:07", "text": "何？"}, {"type": "subtitle", "time": 16270.79, "timestamp": "04:31:10", "text": "おい、スリック。それは私です。"}, {"type": "subtitle", "time": 16272.63, "timestamp": "04:31:12", "text": "一体何がしたいんだ？あなたは私の"}, {"type": "subtitle", "time": 16275.03, "timestamp": "04:31:15", "text": "マネーポンプ？ねえ、ココナッツ持ってる？"}, {"type": "subtitle", "time": 16276.149, "timestamp": "04:31:16", "text": "水とか、そんな感じのもの？私は必要としている"}, {"type": "subtitle", "time": 16278.63, "timestamp": "04:31:18", "text": "電解質の一部。くそ、それはちょっと"}, {"type": "subtitle", "time": 16281.189, "timestamp": "04:31:21", "text": "暖かいですね。おい、死が訪れたぞ"}, {"type": "subtitle", "time": 16283.11, "timestamp": "04:31:23", "text": "願い事とか、そんな感じ。私は殺すべきなのか"}, {"type": "subtitle", "time": 16288.55, "timestamp": "04:31:28", "text": "今のあなたですか？いや、違うよ。私じゃないよ。"}, {"type": "subtitle", "time": 16290.07, "timestamp": "04:31:30", "text": "いいえ。"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "そうそう。でも、あれは私の息子だ。ええ、でも"}, {"type": "subtitle", "time": 16295.91, "timestamp": "04:31:35", "text": "我が息子だ。彼は皆を裏切った"}, {"type": "subtitle", "time": 16297.83, "timestamp": "04:31:37", "text": "彼が今まで知っている中で。彼はあなたを巻き込んだ"}, {"type": "subtitle", "time": 16299.91, "timestamp": "04:31:39", "text": "連邦政府と共に"}, {"type": "subtitle", "time": 16301.99, "timestamp": "04:31:41", "text": "私のいくつかの事業。彼"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "出て行かなければならない。そして、知ってる？私は"}, {"type": "subtitle", "time": 16305.83, "timestamp": "04:31:45", "text": "これは個人的なことではないと言いたいのですが、"}, {"type": "subtitle", "time": 16308.389, "timestamp": "04:31:48", "text": "しかし、それは個人的な問題だ。でも連邦捜査官は、"}, {"type": "subtitle", "time": 16310.309, "timestamp": "04:31:50", "text": "FSは私にトレバーを殺すように言った。そして"}, {"type": "subtitle", "time": 16312.309, "timestamp": "04:31:52", "text": "もちろん、両方を殺すことはできない。の"}, {"type": "subtitle", "time": 16316.07, "timestamp": "04:31:56", "text": "連邦捜査官、スティーブ、デイブ・ノートン。私はショッピングを所有しています"}, {"type": "subtitle", "time": 16317.75, "timestamp": "04:31:57", "text": "ショッピングモール。私はあの二人を雇わないだろう"}]
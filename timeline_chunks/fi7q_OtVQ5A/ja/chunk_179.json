[{"type": "subtitle", "time": 10744.87, "timestamp": "02:59:04", "text": "あなたのところでは今、午前0時ですか？私は"}, {"type": "subtitle", "time": 10746.469, "timestamp": "02:59:06", "text": "右？あなたはどのタイムゾーン出身ですか？"}, {"type": "subtitle", "time": 10748.87, "timestamp": "02:59:08", "text": "また？"}, {"type": "subtitle", "time": 10752.63, "timestamp": "02:59:12", "text": "えっと、グリニッジ標準時ですか？"}, {"type": "subtitle", "time": 10755.91, "timestamp": "02:59:15", "text": "それは、それは、それは、それは、それは、それは？"}, {"type": "subtitle", "time": 10758.15, "timestamp": "02:59:18", "text": "えっと、この時間ってどこにあるの？何が"}, {"type": "subtitle", "time": 10759.67, "timestamp": "02:59:19", "text": "あなた？"}, {"type": "subtitle", "time": 10764.23, "timestamp": "02:59:24", "text": "うん。えっと、午前0時22分過ぎ。それで、"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "あなたのタイムゾーンは、GMTマイナスみたいな感じですね。"}, {"type": "subtitle", "time": 10772.23, "timestamp": "02:59:32", "text": "5〜7？"}, {"type": "subtitle", "time": 10776.87, "timestamp": "02:59:36", "text": "それは-7ですか？ GMT - 7（あなたのタイムゾーン）"}, {"type": "subtitle", "time": 10780.71, "timestamp": "02:59:40", "text": "えっと、じゃあ私は"}, {"type": "subtitle", "time": 10785.83, "timestamp": "02:59:45", "text": "太平洋夏時間ですよね？ PST PDT"}, {"type": "subtitle", "time": 10787.67, "timestamp": "02:59:47", "text": "あなたの"}, {"type": "subtitle", "time": 10790.87, "timestamp": "02:59:50", "text": "正確なアメリカ時間。"}, {"type": "subtitle", "time": 10793.99, "timestamp": "02:59:53", "text": "だって私はそれについて混乱しているから"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "私はこのPDT時間をずっとフォローしています"}, {"type": "subtitle", "time": 10799.67, "timestamp": "02:59:59", "text": "スケジュールとか色々あるけど、わかってる、わかってる"}]
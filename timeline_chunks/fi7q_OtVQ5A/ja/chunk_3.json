[{"type": "subtitle", "time": 181.27, "timestamp": "00:03:01", "text": "来て。私はあなたにあげたい 私はあなたにあげたい"}, {"type": "subtitle", "time": 184.07, "timestamp": "00:03:04", "text": "この鎧をあげよう。"}, {"type": "subtitle", "time": 186.309, "timestamp": "00:03:06", "text": "あなたはどこにいますか？あなたは上向きですか、下向きですか？"}, {"type": "subtitle", "time": 189.589, "timestamp": "00:03:09", "text": "ああ、あなたの番ですね。わかりました、行きます。"}, {"type": "subtitle", "time": 191.19, "timestamp": "00:03:11", "text": "ご心配なく。あ、待って。滞在する"}, {"type": "subtitle", "time": 193.50900000000001, "timestamp": "00:03:13", "text": "そこには。あなたは音を取ります。ああ、ありがとう"}, {"type": "subtitle", "time": 196.22899999999998, "timestamp": "00:03:16", "text": "あなた。そしてあなたは自分自身を補充し、"}, {"type": "subtitle", "time": 199.99, "timestamp": "00:03:19", "text": "出かけよう。わかった。そしてウェインはどこにいるのか"}, {"type": "subtitle", "time": 202.39, "timestamp": "00:03:22", "text": "また君か？さらなる崩壊。私は"}, {"type": "subtitle", "time": 205.50900000000001, "timestamp": "00:03:25", "text": "私自身のやり方。ああ、彼は自分のことをやっている"}, {"type": "subtitle", "time": 208.309, "timestamp": "00:03:28", "text": "もの。大丈夫です。"}, {"type": "subtitle", "time": 211.75, "timestamp": "00:03:31", "text": "彼は冒険を楽しんでいる。ない"}, {"type": "subtitle", "time": 215.11, "timestamp": "00:03:35", "text": "少し気分が悪いです。とても不快です。"}, {"type": "subtitle", "time": 218.149, "timestamp": "00:03:38", "text": "近くで足音が聞こえる。そうそう。そこには"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "足音です。ああ、敵と交戦中だ。"}, {"type": "subtitle", "time": 228.149, "timestamp": "00:03:48", "text": "ニース。おお、いいね。ああ、大変だ。"}, {"type": "subtitle", "time": 231.82999999999998, "timestamp": "00:03:51", "text": "おお、いいね。神装備のようなもの。ええと、私は"}, {"type": "subtitle", "time": 233.99, "timestamp": "00:03:53", "text": "この日の配信を見逃してしまった。誰が"}]
[{"type": "subtitle", "time": 10500.309, "timestamp": "02:55:00", "text": "献身。何？はぁ？はぁ？"}, {"type": "subtitle", "time": 10503.03, "timestamp": "02:55:03", "text": "おい。"}, {"type": "subtitle", "time": 10514.63, "timestamp": "02:55:14", "text": "おや、これは何でしょう？おい、使うべきじゃないよ"}, {"type": "subtitle", "time": 10517.67, "timestamp": "02:55:17", "text": "ここは人を見つけるための場所で、"}, {"type": "subtitle", "time": 10537.67, "timestamp": "02:55:37", "text": "君をそうさせるつもりだ。はぁ？"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "なぜ彼女は私に理解させようとするのか？"}, {"type": "subtitle", "time": 10544.87, "timestamp": "02:55:44", "text": "はぁ？"}, {"type": "subtitle", "time": 10547.59, "timestamp": "02:55:47", "text": "チャットでは何が起こっているのですか？"}, {"type": "subtitle", "time": 10553.75, "timestamp": "02:55:53", "text": "待って、VPNは使わないで。接続されます。"}, {"type": "subtitle", "time": 10555.51, "timestamp": "02:55:55", "text": "ゲームはまだセーブできます。こんにちは。"}, {"type": "subtitle", "time": 10557.67, "timestamp": "02:55:57", "text": "VPNを使用してゲームを再起動してください。私たちは"}, {"type": "subtitle", "time": 10559.19, "timestamp": "02:55:59", "text": "愛を知らない見知らぬ人たち。ルールはご存知でしょう。"}]
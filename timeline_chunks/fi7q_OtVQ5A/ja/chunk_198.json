[{"type": "subtitle", "time": 11895.349, "timestamp": "03:18:15", "text": "私の近くのモールにはこれがある"}, {"type": "subtitle", "time": 11898.63, "timestamp": "03:18:18", "text": "駐車場みたいな、こういうもの。"}, {"type": "subtitle", "time": 11901.19, "timestamp": "03:18:21", "text": "いつか自分の車に乗って、"}, {"type": "subtitle", "time": 11903.51, "timestamp": "03:18:23", "text": "そして屋上に行って、"}, {"type": "subtitle", "time": 11905.51, "timestamp": "03:18:25", "text": "車を駐車する"}, {"type": "subtitle", "time": 11923.99, "timestamp": "03:18:43", "text": "ロサンゼルスへの休暇をもう一度"}, {"type": "subtitle", "time": 11926.63, "timestamp": "03:18:46", "text": "えっと、税関。よし、行こう。さあ、始めよう"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "私はきちんとした一般市民であるべきでしょうか？そして"}]
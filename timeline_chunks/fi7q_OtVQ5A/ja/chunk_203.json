[{"type": "subtitle", "time": 12205.51, "timestamp": "03:23:25", "text": "痛かったよ。何てことだ。"}, {"type": "subtitle", "time": 12208.229, "timestamp": "03:23:28", "text": "O"}, {"type": "subtitle", "time": 12217.269, "timestamp": "03:23:37", "text": "何てことだ。何が起こっている？"}, {"type": "subtitle", "time": 12220.55, "timestamp": "03:23:40", "text": "バナナをもう1本買ってきたよ。ああ、な"}, {"type": "subtitle", "time": 12223.67, "timestamp": "03:23:43", "text": "ナ。ああ、バナナをたくさん失ってしまった。待って、"}, {"type": "subtitle", "time": 12227.03, "timestamp": "03:23:47", "text": "何？え、あなたもバナナが好きなの？私も"}, {"type": "subtitle", "time": 12233.47, "timestamp": "03:23:53", "text": "そして"}, {"type": "subtitle", "time": 12236.389, "timestamp": "03:23:56", "text": "[音楽]"}]
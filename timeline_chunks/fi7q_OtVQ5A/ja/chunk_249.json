[{"type": "subtitle", "time": 14945.59, "timestamp": "04:09:05", "text": "セクションを選択"}, {"type": "subtitle", "time": 14948.15, "timestamp": "04:09:08", "text": "東側。"}, {"type": "subtitle", "time": 14951.51, "timestamp": "04:09:11", "text": "よし、東へ行かなきゃ。"}, {"type": "subtitle", "time": 14957.349, "timestamp": "04:09:17", "text": "ねえ、ここで左に曲がってほしいんだ。"}, {"type": "subtitle", "time": 14960.55, "timestamp": "04:09:20", "text": "わかった。ああ、やばい、さらに"}, {"type": "subtitle", "time": 14971.429, "timestamp": "04:09:31", "text": "はい、この交差点を右に進んでください。わかった、"}, {"type": "subtitle", "time": 14979.349, "timestamp": "04:09:39", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 14990.55, "timestamp": "04:09:50", "text": "これは"}, {"type": "subtitle", "time": 14993.67, "timestamp": "04:09:53", "text": "グリッドの西側でクソをする。これは"}, {"type": "subtitle", "time": 14999.75, "timestamp": "04:09:59", "text": "そしてこれを置く"}]
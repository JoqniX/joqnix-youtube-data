[{"type": "subtitle", "time": 19921.75, "timestamp": "05:32:01", "text": "フランクリン。文明史上最も偉大な"}, {"type": "subtitle", "time": 19924.23, "timestamp": "05:32:04", "text": "美徳。イエス、あなたのセラピストはたくさん"}, {"type": "subtitle", "time": 19926.47, "timestamp": "05:32:06", "text": "責任を問われる。知っている。私はまだ嫌いです"}, {"type": "subtitle", "time": 19928.47, "timestamp": "05:32:08", "text": "自分自身。でもまあ、少なくとも私は"}, {"type": "subtitle", "time": 19930.548, "timestamp": "05:32:10", "text": "それについて今、言葉で表現しよう。ああ、でも私はあなたが嫌い​​だ。"}, {"type": "subtitle", "time": 19931.99, "timestamp": "05:32:11", "text": "そして、私はその言葉を知っている。では、"}, {"type": "subtitle", "time": 19933.51, "timestamp": "05:32:13", "text": "それはつまり、セラピーに行かなくてもいいということですか？"}, {"type": "subtitle", "time": 19936.07, "timestamp": "05:32:16", "text": "おい、あんた二人のクソ野郎は恐ろしい"}, {"type": "subtitle", "time": 19937.91, "timestamp": "05:32:17", "text": "中年期の私。私は大丈夫です。あなたは"}, {"type": "subtitle", "time": 19939.99, "timestamp": "05:32:19", "text": "フランクリン、恐れるのは当然だ。うん、"}, {"type": "subtitle", "time": 19951.51, "timestamp": "05:32:31", "text": "T、一つだけ言っておくよ。"}, {"type": "subtitle", "time": 19961.59, "timestamp": "05:32:41", "text": "これは仕組まれたものだ。これは仕組まれたものだ。それは"}, {"type": "subtitle", "time": 19963.83, "timestamp": "05:32:43", "text": "設定。ああ、これは仕組まれたものだ。待っていてください。"}, {"type": "subtitle", "time": 19966.47, "timestamp": "05:32:46", "text": "待って。何？"}]
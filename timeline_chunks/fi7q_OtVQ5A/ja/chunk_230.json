[{"type": "subtitle", "time": 13800.71, "timestamp": "03:50:00", "text": "多すぎるか、好きではない"}, {"type": "subtitle", "time": 13803.11, "timestamp": "03:50:03", "text": "最近の子供たちは一体何を考えているんだろう"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "考える。"}, {"type": "subtitle", "time": 13806.63, "timestamp": "03:50:06", "text": "私は、知り合いが"}, {"type": "subtitle", "time": 13810.469, "timestamp": "03:50:10", "text": "人々は「bro」をカジュアルによく使いますが"}, {"type": "subtitle", "time": 13812.95, "timestamp": "03:50:12", "text": "種の"}, {"type": "subtitle", "time": 13817.189, "timestamp": "03:50:17", "text": "なんだか、何だか違和感がある。私はしません"}, {"type": "subtitle", "time": 13818.95, "timestamp": "03:50:18", "text": "知る。"}, {"type": "subtitle", "time": 13820.55, "timestamp": "03:50:20", "text": "的外れではない。私は何が"}, {"type": "subtitle", "time": 13822.87, "timestamp": "03:50:22", "text": "言葉はだが"}, {"type": "subtitle", "time": 13829.51, "timestamp": "03:50:29", "text": "えーと"}, {"type": "subtitle", "time": 13832.71, "timestamp": "03:50:32", "text": "そうだよ、みんな"}, {"type": "subtitle", "time": 13835.67, "timestamp": "03:50:35", "text": "仲間は大丈夫だけど、例えば"}, {"type": "subtitle", "time": 13837.11, "timestamp": "03:50:37", "text": "私が話しているとあなたは"}, {"type": "subtitle", "time": 13840.95, "timestamp": "03:50:40", "text": "何かがあって、誰かがただ行く"}, {"type": "subtitle", "time": 13843.59, "timestamp": "03:50:43", "text": "君にブラザー、そして君はなんだか"}, {"type": "subtitle", "time": 13846.309, "timestamp": "03:50:46", "text": "無視されて、"}, {"type": "subtitle", "time": 13850.389, "timestamp": "03:50:50", "text": "無視されているような気分で、"}, {"type": "subtitle", "time": 13854.55, "timestamp": "03:50:54", "text": "注目と敬意を払われなかった"}, {"type": "subtitle", "time": 13856.07, "timestamp": "03:50:56", "text": "右。"}, {"type": "subtitle", "time": 13859.11, "timestamp": "03:50:59", "text": "実は、それは避けたかったんです。"}]
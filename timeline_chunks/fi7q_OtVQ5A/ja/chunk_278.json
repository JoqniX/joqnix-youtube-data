[{"type": "subtitle", "time": 16680.709, "timestamp": "04:38:00", "text": "今。"}, {"type": "subtitle", "time": 16682.551, "timestamp": "04:38:02", "text": "それは分かります。誰が"}, {"type": "subtitle", "time": 16684.07, "timestamp": "04:38:04", "text": "クソ野郎ども？"}, {"type": "subtitle", "time": 16705.349, "timestamp": "04:38:25", "text": "本当に？お前はもう終わりだ。あなた"}, {"type": "subtitle", "time": 16708.23, "timestamp": "04:38:28", "text": "わからない。あなたはすべてを知っている、"}, {"type": "subtitle", "time": 16711.429, "timestamp": "04:38:31", "text": "犬。え、何？でも、ごめんなさい。私は推測する"}, {"type": "subtitle", "time": 16714.23, "timestamp": "04:38:34", "text": "これで終わりだ。ほら、私は自分の"}, {"type": "subtitle", "time": 16715.59, "timestamp": "04:38:35", "text": "両方にどう対処すればいいのかわからない"}, {"type": "subtitle", "time": 16717.109, "timestamp": "04:38:37", "text": "彼ら。"}, {"type": "subtitle", "time": 16719.349, "timestamp": "04:38:39", "text": "私は自分のことをよく知っている。"}, {"type": "subtitle", "time": 16720.949, "timestamp": "04:38:40", "text": "くそっ。"}, {"type": "subtitle", "time": 16723.429, "timestamp": "04:38:43", "text": "最悪だ。私たち一人ひとりは"}, {"type": "subtitle", "time": 16726.39, "timestamp": "04:38:46", "text": "最悪だ。"}, {"type": "subtitle", "time": 16731.83, "timestamp": "04:38:51", "text": "スティーブ・ヘインズは大きなプレッシャーにさらされている"}]
[{"type": "subtitle", "time": 9724.55, "timestamp": "02:42:04", "text": "いいえ、ハンマーが落ちてしまいました。"}, {"type": "subtitle", "time": 9725.99, "timestamp": "02:42:05", "text": "来て。とても簡単にしているよ。私は違います"}, {"type": "subtitle", "time": 9730.469, "timestamp": "02:42:10", "text": "それを実行する。来て、"}, {"type": "subtitle", "time": 9740.87, "timestamp": "02:42:20", "text": "バンキー、それらを回転させてもいい？ああ、できるよ。あなた"}, {"type": "subtitle", "time": 9745.03, "timestamp": "02:42:25", "text": "できる。来て。もっと力を入れてください。"}, {"type": "subtitle", "time": 9755.75, "timestamp": "02:42:35", "text": "そうしなければならないのですか？いや、私たちは一緒に死ぬことができる。"}, {"type": "subtitle", "time": 9757.67, "timestamp": "02:42:37", "text": "そう、そっちの方がずっといい。ええ、私たちは"}, {"type": "subtitle", "time": 9760.23, "timestamp": "02:42:40", "text": "共に死ぬことができる。"}, {"type": "subtitle", "time": 9763.75, "timestamp": "02:42:43", "text": "私はあなたにとってとても簡単なことだったのに"}, {"type": "subtitle", "time": 9766.389, "timestamp": "02:42:46", "text": "ストリーミング配信する。彼にやらせるつもりだ。全て"}, {"type": "subtitle", "time": 9770.309, "timestamp": "02:42:50", "text": "右。よし。ランチ。"}, {"type": "subtitle", "time": 9774.309, "timestamp": "02:42:54", "text": "とても楽しかったです。ありがとう。"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "今後はもっとこういうことをするべきだ。"}]
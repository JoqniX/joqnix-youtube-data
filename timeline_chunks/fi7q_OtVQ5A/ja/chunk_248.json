[{"type": "subtitle", "time": 14885.189, "timestamp": "04:08:05", "text": "選び出す。そちらの様子はどうですか？ない"}, {"type": "subtitle", "time": 14887.11, "timestamp": "04:08:07", "text": "いいぞ、相棒。メリーウェザーは私たちが"}, {"type": "subtitle", "time": 14890.07, "timestamp": "04:08:10", "text": "UD。彼らはあなたを探している。"}, {"type": "subtitle", "time": 14901.51, "timestamp": "04:08:21", "text": "ああ、電話が。"}, {"type": "subtitle", "time": 14903.03, "timestamp": "04:08:23", "text": "この問題の解決策が見つかったことを願っています。"}, {"type": "subtitle", "time": 14905.11, "timestamp": "04:08:25", "text": "問題。え、何？ああ、そうだね。私たちは所有しています"}, {"type": "subtitle", "time": 14907.99, "timestamp": "04:08:27", "text": "それ。はい、はい、はい。リンクは有効です"}, {"type": "subtitle", "time": 14909.99, "timestamp": "04:08:29", "text": "今。信号機を制御できます。"}, {"type": "subtitle", "time": 14912.95, "timestamp": "04:08:32", "text": "さあ行こう。幸運を。はい、わかりました。"}, {"type": "subtitle", "time": 14915.349, "timestamp": "04:08:35", "text": "いやあ、これって簡単そうだったのに。簡単"}, {"type": "subtitle", "time": 14918.07, "timestamp": "04:08:38", "text": "十分。"}, {"type": "subtitle", "time": 14925.67, "timestamp": "04:08:45", "text": "アローはマイケルを映す"}, {"type": "subtitle", "time": 14937.51, "timestamp": "04:08:57", "text": "あった。わかった、"}]
[{"type": "subtitle", "time": 5463.03, "timestamp": "01:31:03", "text": "テーブルを通して私を切り裂いてください。何？"}, {"type": "subtitle", "time": 5469.99, "timestamp": "01:31:09", "text": "君ならできるよ。あなたを信頼しています。あなたは"}, {"type": "subtitle", "time": 5472.55, "timestamp": "01:31:12", "text": "手榴弾。手榴弾を使え。"}, {"type": "subtitle", "time": 5477.11, "timestamp": "01:31:17", "text": "え、死んだの？死ぬ。はい、私は死にました。私"}, {"type": "subtitle", "time": 5481.59, "timestamp": "01:31:21", "text": "いいえ、彼はテーブルを通して私を捕まえました。"}, {"type": "subtitle", "time": 5483.75, "timestamp": "01:31:23", "text": "方法がよくわかりません"}, {"type": "subtitle", "time": 5486.149, "timestamp": "01:31:26", "text": "私はそのテーブルを隠していたような感じだった。"}, {"type": "subtitle", "time": 5488.79, "timestamp": "01:31:28", "text": "私は大丈夫です。彼は私を下に潜り込ませることはできない"}, {"type": "subtitle", "time": 5506.55, "timestamp": "01:31:46", "text": "レーザーには十分注意してください。"}, {"type": "subtitle", "time": 5513.83, "timestamp": "01:31:53", "text": "私は壁だ。私は壁だ。私はああ"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "なんてこった。あなたはとてもよく受け止めます。わかった。さよなら、"}]
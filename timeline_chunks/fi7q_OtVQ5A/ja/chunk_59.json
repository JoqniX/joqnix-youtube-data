[{"type": "subtitle", "time": 3540.069, "timestamp": "00:59:00", "text": "何てことだ。ついに、私は止めさせられた"}, {"type": "subtitle", "time": 3546.47, "timestamp": "00:59:06", "text": "まあ、トイレのトリックはうまくいかないかもしれない"}, {"type": "subtitle", "time": 3550.22, "timestamp": "00:59:10", "text": "もうそうではないが、カラー版はまだそうである。"}, {"type": "subtitle", "time": 3552.39, "timestamp": "00:59:12", "text": "[音楽]"}, {"type": "subtitle", "time": 3555.43, "timestamp": "00:59:15", "text": "ねえ、新しい"}, {"type": "subtitle", "time": 3558.309, "timestamp": "00:59:18", "text": "君には今、翼が生えているようなものだね"}, {"type": "subtitle", "time": 3560.549, "timestamp": "00:59:20", "text": "あなたは飛ぶことができます"}, {"type": "subtitle", "time": 3562.39, "timestamp": "00:59:22", "text": "え、本当に？"}, {"type": "subtitle", "time": 3565.109, "timestamp": "00:59:25", "text": "うん。試してみますか？うん。うん。うん。"}, {"type": "subtitle", "time": 3567.91, "timestamp": "00:59:27", "text": "私はしたいです。よし。それから"}, {"type": "subtitle", "time": 3570.17, "timestamp": "00:59:30", "text": "それと連絡を取ってみてください。"}, {"type": "subtitle", "time": 3577.51, "timestamp": "00:59:37", "text": "[音楽]"}, {"type": "subtitle", "time": 3579.51, "timestamp": "00:59:39", "text": "ああ、スタミナも欲しいですか？"}, {"type": "subtitle", "time": 3589.589, "timestamp": "00:59:49", "text": "ああ、スタミナ"}, {"type": "subtitle", "time": 3592.63, "timestamp": "00:59:52", "text": "安いだろうけど、私たちは外出していたと思う。"}, {"type": "subtitle", "time": 3594.789, "timestamp": "00:59:54", "text": "おお。ああ、体力があれば"}, {"type": "subtitle", "time": 3596.63, "timestamp": "00:59:56", "text": "欲しい。"}]
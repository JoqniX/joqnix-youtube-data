[{"type": "subtitle", "time": 15009.03, "timestamp": "04:10:09", "text": "何てことだ。おい、北側だよ。"}, {"type": "subtitle", "time": 15011.349, "timestamp": "04:10:11", "text": "メリーウェザーがあなたの上にいます。私たちは"}, {"type": "subtitle", "time": 15026.71, "timestamp": "04:10:26", "text": "何てことだ。待って。"}, {"type": "subtitle", "time": 15028.229, "timestamp": "04:10:28", "text": "わかった。よしよしよし。私たちは元気です。私たちは"}, {"type": "subtitle", "time": 15030.63, "timestamp": "04:10:30", "text": "良いですね。"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "おお、いいね、いいね、いいね。"}, {"type": "subtitle", "time": 15045.67, "timestamp": "04:10:45", "text": "君たちが重量を再配分するんだ。"}, {"type": "subtitle", "time": 15048.55, "timestamp": "04:10:48", "text": "よくやったね。"}, {"type": "subtitle", "time": 15051.59, "timestamp": "04:10:51", "text": "くそ、こんなにいいものが手に入るなんて信じられない"}, {"type": "subtitle", "time": 15054.87, "timestamp": "04:10:54", "text": "発砲。忘れないで、"}, {"type": "subtitle", "time": 15057.67, "timestamp": "04:10:57", "text": "させて"}, {"type": "subtitle", "time": 15059.349, "timestamp": "04:10:59", "text": "私たちの人生のスコア。私たちは何も受け取らない"}]
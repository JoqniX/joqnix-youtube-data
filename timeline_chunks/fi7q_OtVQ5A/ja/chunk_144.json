[{"type": "subtitle", "time": 8642.55, "timestamp": "02:24:02", "text": "ゼルダの伝説を入れてくれたのが嬉しい"}, {"type": "subtitle", "time": 8647.51, "timestamp": "02:24:07", "text": "あれ。この楽器。"}, {"type": "subtitle", "time": 8649.99, "timestamp": "02:24:09", "text": "もっと泡があるなら、"}, {"type": "subtitle", "time": 8653.429, "timestamp": "02:24:13", "text": "そこにMを入れてください。"}, {"type": "subtitle", "time": 8656.07, "timestamp": "02:24:16", "text": "君に触れるだけで君は"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "復活した。"}, {"type": "subtitle", "time": 8668.309, "timestamp": "02:24:28", "text": "はい、これで全部揃ったと思います。"}, {"type": "subtitle", "time": 8671.75, "timestamp": "02:24:31", "text": "なんてこった。そこには。よし、これで"}, {"type": "subtitle", "time": 8673.27, "timestamp": "02:24:33", "text": "すべて。掴めない唯一のもの"}, {"type": "subtitle", "time": 8677.27, "timestamp": "02:24:37", "text": "花瓶です。もし私があなたを捕まえたら、私たちは"}]
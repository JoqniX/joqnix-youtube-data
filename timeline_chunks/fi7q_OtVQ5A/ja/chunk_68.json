[{"type": "subtitle", "time": 4080.95, "timestamp": "01:08:00", "text": "盲目。"}, {"type": "subtitle", "time": 4097.749, "timestamp": "01:08:17", "text": "それ。わーい。ああ、頭を爆撃するのを見たかい？"}, {"type": "subtitle", "time": 4104.149, "timestamp": "01:08:24", "text": "ああ、あなたはそれが"}, {"type": "subtitle", "time": 4106.55, "timestamp": "01:08:26", "text": "気を散らすもの？"}, {"type": "subtitle", "time": 4108.39, "timestamp": "01:08:28", "text": "うん。"}, {"type": "subtitle", "time": 4110.789, "timestamp": "01:08:30", "text": "ああ、わかりました。それは何ですか？それは何ですか"}, {"type": "subtitle", "time": 4112.39, "timestamp": "01:08:32", "text": "気味の悪い？はい、それを"}, {"type": "subtitle", "time": 4113.91, "timestamp": "01:08:33", "text": "抽出。"}, {"type": "subtitle", "time": 4115.43, "timestamp": "01:08:35", "text": "まあ、すぐに入れないでください。"}, {"type": "subtitle", "time": 4117.829, "timestamp": "01:08:37", "text": "隣に置いてください。それはうまくいくでしょう"}, {"type": "subtitle", "time": 4119.349, "timestamp": "01:08:39", "text": "大丈夫。"}, {"type": "subtitle", "time": 4121.91, "timestamp": "01:08:41", "text": "わかった。"}, {"type": "subtitle", "time": 4124.309, "timestamp": "01:08:44", "text": "部屋を明るく照らす。だから、本当に"}, {"type": "subtitle", "time": 4126.149, "timestamp": "01:08:46", "text": "種の"}, {"type": "subtitle", "time": 4127.99, "timestamp": "01:08:47", "text": "以前は本当にひどかったのですが、"}, {"type": "subtitle", "time": 4131.669, "timestamp": "01:08:51", "text": "最初に追加したときは、ほとんど動けなかった"}, {"type": "subtitle", "time": 4133.59, "timestamp": "01:08:53", "text": "私が最初にそれを追加したとき。そしてそれはそれを与えた"}, {"type": "subtitle", "time": 4136.39, "timestamp": "01:08:56", "text": "それは私にひどい頭痛を引き起こしたので"}, {"type": "subtitle", "time": 4139.829, "timestamp": "01:08:59", "text": "揺れ続けるのを止めなかった。"}]
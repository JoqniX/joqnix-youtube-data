[{"type": "subtitle", "time": 16320.95, "timestamp": "04:32:00", "text": "ピエロ。そして私は電話を1回かけ、"}, {"type": "subtitle", "time": 16324.229, "timestamp": "04:32:04", "text": "彼らのキャリアは終わった。だからあなたは"}, {"type": "subtitle", "time": 16327.189, "timestamp": "04:32:07", "text": "年間約5万ポンドの年金ハンターまたはb"}, {"type": "subtitle", "time": 16329.83, "timestamp": "04:32:09", "text": "億万長者、億万長者、指をさそう"}, {"type": "subtitle", "time": 16333.349, "timestamp": "04:32:13", "text": "彼の妻または泣く"}, {"type": "subtitle", "time": 16335.269, "timestamp": "04:32:15", "text": "そして、あの二人のバカなメンターを救え"}, {"type": "subtitle", "time": 16337.189, "timestamp": "04:32:17", "text": "あなたのもの、そしてクソッタレの全員"}, {"type": "subtitle", "time": 16340.229, "timestamp": "04:32:20", "text": "国家がお前のケツに這い上がってくる"}, {"type": "subtitle", "time": 16348.07, "timestamp": "04:32:28", "text": "あのね"}, {"type": "subtitle", "time": 16352.389, "timestamp": "04:32:32", "text": "くたばれ天才の答え、完全な天才"}, {"type": "subtitle", "time": 16354.55, "timestamp": "04:32:34", "text": "時間は刻々と過ぎている。"}, {"type": "subtitle", "time": 16366.229, "timestamp": "04:32:46", "text": "そんな風にドアをバタンと閉めないでください。"}, {"type": "subtitle", "time": 16373.99, "timestamp": "04:32:53", "text": "なんてこった。チャット、"}, {"type": "subtitle", "time": 16377.269, "timestamp": "04:32:57", "text": "あなたの助けが必要です。"}, {"type": "subtitle", "time": 16379.51, "timestamp": "04:32:59", "text": "どうすればいいですか？"}]
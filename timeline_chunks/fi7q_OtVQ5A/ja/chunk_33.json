[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "どこ"}, {"type": "subtitle", "time": 1985.19, "timestamp": "00:33:05", "text": "ああ、彼らは近くにいる。"}, {"type": "subtitle", "time": 1987.11, "timestamp": "00:33:07", "text": "ああ、私は近くにいます。ああ、あなたは階下にいるんですね。"}, {"type": "subtitle", "time": 2002.07, "timestamp": "00:33:22", "text": "おい、死ね。死んでしまえ。死んでしまえ。ただ"}, {"type": "subtitle", "time": 2004.87, "timestamp": "00:33:24", "text": "ああ、彼は死んだんだ。ご心配なく。あなた"}, {"type": "subtitle", "time": 2012.31, "timestamp": "00:33:32", "text": "彼はただ叫んでいるだけだ。ウェインが"}, {"type": "subtitle", "time": 2014.87, "timestamp": "00:33:34", "text": "死体に向かって叫んでいるだけだ。死んでしまえ、"}, {"type": "subtitle", "time": 2020.549, "timestamp": "00:33:40", "text": "死ね、死ね。まるでそいつはクソ野郎みたいだ"}, {"type": "subtitle", "time": 2024.23, "timestamp": "00:33:44", "text": "ボットのスキンを持っていた。いいえ、彼はボットのスキンを着けていました。私"}, {"type": "subtitle", "time": 2026.389, "timestamp": "00:33:46", "text": "私は彼を応援するつもりだ。いいね。私は行きます"}, {"type": "subtitle", "time": 2029.35, "timestamp": "00:33:49", "text": "彼のために行く。狙撃。"}, {"type": "subtitle", "time": 2032.23, "timestamp": "00:33:52", "text": "ああ、これは[ __ ]だとは思わない。"}, {"type": "subtitle", "time": 2034.07, "timestamp": "00:33:54", "text": "この人は誰ですか？"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "神。誰？この男は一体誰だったんだ？チャック、"}, {"type": "subtitle", "time": 2039.909, "timestamp": "00:33:59", "text": "お前が彼を殺したのか？もし彼が"}]
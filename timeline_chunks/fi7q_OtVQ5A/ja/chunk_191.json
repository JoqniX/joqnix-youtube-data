[{"type": "subtitle", "time": 11473.67, "timestamp": "03:11:13", "text": "ああ、トレバーに何があったの？なぜ"}, {"type": "subtitle", "time": 11478.07, "timestamp": "03:11:18", "text": "彼は女性の服を着て裸ですか？"}, {"type": "subtitle", "time": 11481.75, "timestamp": "03:11:21", "text": "服？私たちは宇宙人に誘拐された。"}, {"type": "subtitle", "time": 11483.75, "timestamp": "03:11:23", "text": "何てことだ。あなたに何があったの？"}, {"type": "subtitle", "time": 11486.79, "timestamp": "03:11:26", "text": "トレバー？なぜ女の子の服を着ているの？"}, {"type": "subtitle", "time": 11489.51, "timestamp": "03:11:29", "text": "スカートとかそういうやつ？それはあなたが言うところの"}, {"type": "subtitle", "time": 11492.71, "timestamp": "03:11:32", "text": "再び1つ"}, {"type": "subtitle", "time": 11495.269, "timestamp": "03:11:35", "text": "なぜなら、私は良い子だから。それが何であれ、私は"}, {"type": "subtitle", "time": 11497.269, "timestamp": "03:11:37", "text": "愛してるけど、私は妻だし、妻は"}, {"type": "subtitle", "time": 11500.23, "timestamp": "03:11:40", "text": "待って、待って、待って、待って。する必要がある"}, {"type": "subtitle", "time": 11516.63, "timestamp": "03:11:56", "text": "え、パトリシアはトレバーを捨てたの？"}, {"type": "subtitle", "time": 11519.429, "timestamp": "03:11:59", "text": "何？"}]
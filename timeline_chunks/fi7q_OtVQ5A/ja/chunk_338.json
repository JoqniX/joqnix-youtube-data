[{"type": "subtitle", "time": 20283.91, "timestamp": "05:38:03", "text": "食事を与えてあげたよ。雑草を抜いてやる。今の君を見てごらん。"}, {"type": "subtitle", "time": 20288.07, "timestamp": "05:38:08", "text": "あなたはいつも恩知らずで惨めな、"}, {"type": "subtitle", "time": 20291.11, "timestamp": "05:38:11", "text": "泣き虫でクソ野郎のガキ。あなた"}, {"type": "subtitle", "time": 20295.11, "timestamp": "05:38:15", "text": "あなたも私もそれを知っています。いつも"}, {"type": "subtitle", "time": 20298.39, "timestamp": "05:38:18", "text": "君はどこかおかしいよ。恥ずかしい"}, {"type": "subtitle", "time": 20302.07, "timestamp": "05:38:22", "text": "あなた自身。自分が情けない。あなた自身の"}, {"type": "subtitle", "time": 20305.99, "timestamp": "05:38:25", "text": "母親。私はここに何時間もいて、"}, {"type": "subtitle", "time": 20308.548, "timestamp": "05:38:28", "text": "飲み物か何か持ってきてくれた？"}, {"type": "subtitle", "time": 20312.948, "timestamp": "05:38:32", "text": "タバコを吸うか、それとも足のマッサージをするか？"}, {"type": "subtitle", "time": 20317.35, "timestamp": "05:38:37", "text": "私は老女で、あなたは全盛期"}, {"type": "subtitle", "time": 20321.99, "timestamp": "05:38:41", "text": "人生。何も持っていないの？"}, {"type": "subtitle", "time": 20334.31, "timestamp": "05:38:54", "text": "そこには。大丈夫だよ、息子よ。"}, {"type": "subtitle", "time": 20338.31, "timestamp": "05:38:58", "text": "ああ、それだ。今、"}]
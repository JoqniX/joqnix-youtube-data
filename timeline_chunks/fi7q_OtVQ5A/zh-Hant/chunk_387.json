[{"type": "subtitle", "time": 23226.468, "timestamp": "06:27:06", "text": "待會兒再上來。  啊，我真想死。  有人剛剛殺了我。  我們走吧。"}, {"type": "subtitle", "time": 23252.3, "timestamp": "06:27:32", "text": "我會照做就走。"}, {"type": "subtitle", "time": 23260.39, "timestamp": "06:27:40", "text": "麵包車給我。  好的"}, {"type": "subtitle", "time": 23278.31, "timestamp": "06:27:58", "text": "盒子。誰告訴我那裡有輛貨車？  等等，我們走吧。呃，填充"}]
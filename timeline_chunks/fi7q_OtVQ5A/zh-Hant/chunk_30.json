[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "我認為"}, {"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "雅克與此事有關。是的。"}, {"type": "subtitle", "time": 1805.75, "timestamp": "00:30:05", "text": "你們關心我的鑽石嗎？哇。真是太鑽石了。  我不認為"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "這就是原因，只是價格昂貴。價格昂貴。  是的，可以。"}, {"type": "subtitle", "time": 1817.51, "timestamp": "00:30:17", "text": "你到處跟人炫耀我擁有的所有鑽石。你有一個。  大概兩個。我不知道"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "。我不在乎。閉嘴。  朋友，我想你是在說你自己吧。不是我。不，別看。別看。而那"}, {"type": "chat", "time": 1820.08, "timestamp": "00:30:20", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooooooo"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "個人，只有你。讓我炫耀一下。好的。"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "讓我來示範一下。只有我。  不，我不讓"}, {"type": "subtitle", "time": 1847.029, "timestamp": "00:30:47", "text": "你展示。離開。等待。  這就是我來這裡的目的。哦，三級背包。"}]
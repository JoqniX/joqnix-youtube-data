[{"type": "subtitle", "time": 13742.229, "timestamp": "03:49:02", "text": "，兄弟。  等等，"}, {"type": "subtitle", "time": 13748.87, "timestamp": "03:49:08", "text": "什麼？我到底在做什麼？我拿到了一枚"}, {"type": "subtitle", "time": 13751.83, "timestamp": "03:49:11", "text": "手榴彈。  哦，拜託。"}, {"type": "subtitle", "time": 13771.51, "timestamp": "03:49:31", "text": "我死於"}, {"type": "subtitle", "time": 13773.91, "timestamp": "03:49:33", "text": "「是」。好吧，我死了，但我同時也殺了那個"}, {"type": "subtitle", "time": 13790.469, "timestamp": "03:49:50", "text": "慶祝。實際上，我要把這個當作我們殺死他的獎盃。  呃，我們"}]
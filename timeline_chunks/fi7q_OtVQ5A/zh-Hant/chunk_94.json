[{"type": "subtitle", "time": 5651.669, "timestamp": "01:34:11", "text": "我希望它還在"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "測試版裡。"}, {"type": "subtitle", "time": 5684.39, "timestamp": "01:34:44", "text": "不，不是。什麼？它不是。什麼？  我忘了。"}, {"type": "subtitle", "time": 5691.189, "timestamp": "01:34:51", "text": "我忘了給你發戰爭警報。當時，你就是這樣。  不是什麼？不，抱歉。為什麼？  我的天啊。開發者們，為什麼？"}]
[{"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "，"}, {"type": "subtitle", "time": 18757.03, "timestamp": "05:12:37", "text": "我知道。但我已經知道了。事情"}, {"type": "subtitle", "time": 18763.59, "timestamp": "05:12:43", "text": "是這樣的。這讓"}, {"type": "subtitle", "time": 18765.43, "timestamp": "05:12:45", "text": "我想起了高速公路上的路標。  你好。  去邁克爾家。  離開你想玩的現在價值數美元的黃金。嘿，哥們儿。"}]
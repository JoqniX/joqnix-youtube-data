[{"type": "subtitle", "time": 3497.43, "timestamp": "00:58:17", "text": "我應該沒事"}, {"type": "subtitle", "time": 3499.19, "timestamp": "00:58:19", "text": "。  [音樂]"}, {"type": "subtitle", "time": 3517.43, "timestamp": "00:58:37", "text": "新遊戲。  哦，我不得不寫一部分。但這一切都是新的。我的天啊。  哇。"}, {"type": "subtitle", "time": 3528.549, "timestamp": "00:58:48", "text": "艾瑪、艾莉森，還有，史蒂夫，別對我"}, {"type": "subtitle", "time": 3530.87, "timestamp": "00:58:50", "text": "發黑。  呃，邀請獲得。  你最近怎麼樣？"}]
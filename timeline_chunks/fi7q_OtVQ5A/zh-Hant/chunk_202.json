[{"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "離開。  哦，我看到了。  你要去哪裡？  [音樂] 我的天哪。  他低頭看向床底，說：「我的天哪。」"}, {"type": "subtitle", "time": 12133.349, "timestamp": "03:22:13", "text": "哦，他走了。"}, {"type": "subtitle", "time": 12138.07, "timestamp": "03:22:18", "text": "你好。  [音樂] 走開。  你好。"}, {"type": "subtitle", "time": 12142.15, "timestamp": "03:22:22", "text": "我依然能看見你。  [音樂] 我就"}]
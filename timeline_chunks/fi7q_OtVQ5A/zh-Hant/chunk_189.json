[{"type": "subtitle", "time": 11340.95, "timestamp": "03:09:00", "text": "。這是一場意外。  他處境有利嗎？  我的天啊。沒關係。你明白我的意思。你明白我的意思。他一點也不覺得"}, {"type": "subtitle", "time": 11348.07, "timestamp": "03:09:08", "text": "痛苦。  你做得很好。  糟糕，"}, {"type": "subtitle", "time": 11363.75, "timestamp": "03:09:23", "text": "是修牙。抱歉，別擔心。  好吧，"}, {"type": "subtitle", "time": 11369.83, "timestamp": "03:09:29", "text": "我其實放他們過去了。  是啊，把"}, {"type": "subtitle", "time": 11373.19, "timestamp": "03:09:33", "text": "小丑放在第一層"}, {"type": "subtitle", "time": 11375.99, "timestamp": "03:09:35", "text": "確實有點不公平。  是的。  好的，我就把你放在這裡。  謝謝。  小心那個恐怖小丑。  是的，我還"}, {"type": "subtitle", "time": 11382.79, "timestamp": "03:09:42", "text": "需要一點。哦，是的。我剛剛發現我只剩下 10 點"}, {"type": "subtitle", "time": 11393.91, "timestamp": "03:09:53", "text": "生命值了，"}]
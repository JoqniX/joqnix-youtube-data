[{"type": "subtitle", "time": 15791.349, "timestamp": "04:23:11", "text": "你知道那首歌的歌詞嗎？如果有人真的"}, {"type": "subtitle", "time": 15795.51, "timestamp": "04:23:15", "text": "想說，那就是我永遠不會讓"}, {"type": "subtitle", "time": 15801.429, "timestamp": "04:23:21", "text": "你失望，永遠不會放棄你之類的。你"}, {"type": "subtitle", "time": 15808.149, "timestamp": "04:23:28", "text": "甚至不能說出口，因為對方會想，哦，這傢伙，我的天，這傢伙要來坑我了。就算你想說，也說不"}]
[{"type": "subtitle", "time": 4266.39, "timestamp": "01:11:06", "text": "我們在說話，音訊品質並不重要。呃"}, {"type": "subtitle", "time": 4274.149, "timestamp": "01:11:14", "text": "，你是想用這輛車代替遊戲裡的那輛車嗎？遊戲裡唯一的問題是，我們聽不到彼此的聲音。"}, {"type": "subtitle", "time": 4277.83, "timestamp": "01:11:17", "text": "如果你能那樣做的話，但是話說回來，"}, {"type": "subtitle", "time": 4281.669, "timestamp": "01:11:21", "text": "當有人過世時，你不會知道的，只是為了演戲而已"}, {"type": "subtitle", "time": 4284.79, "timestamp": "01:11:24", "text": "。  那麼，我想我們就可以"}, {"type": "chat", "time": 4289.368, "timestamp": "01:11:29", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eAUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eA"}]
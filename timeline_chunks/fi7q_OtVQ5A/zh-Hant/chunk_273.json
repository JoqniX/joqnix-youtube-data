[{"type": "subtitle", "time": 16384.15, "timestamp": "04:33:04", "text": "不再用「笨蛋」了。說好吃的雞，"}, {"type": "subtitle", "time": 16397.83, "timestamp": "04:33:17", "text": "嗯？ 什麼？團廣場的範本。"}, {"type": "subtitle", "time": 16414.869, "timestamp": "04:33:34", "text": "我需要找到聖殿騎士酒店。 Poco 我看到追捕了吧。 Loco。"}, {"type": "subtitle", "time": 16426.709, "timestamp": "04:33:46", "text": "我的天哪。等等，什麼？你讓我生氣了。發生了什麼？參加最高級別的課程"}]
[{"type": "subtitle", "time": 6426.07, "timestamp": "01:47:06", "text": "，是「你想看點酷炫的東西嗎？"}, {"type": "subtitle", "time": 6440.39, "timestamp": "01:47:20", "text": "」不。你在哪裡？我將以"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "盲人的身份結束。  什麼？看看這個。我來撿起來"}, {"type": "subtitle", "time": 6479.21, "timestamp": "01:47:59", "text": "。耶。哦"}]
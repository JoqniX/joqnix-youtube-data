[{"type": "subtitle", "time": 8953.19, "timestamp": "02:29:13", "text": "很有洞察力的男孩。"}, {"type": "subtitle", "time": 8964.309, "timestamp": "02:29:24", "text": "我的天哪。我們必須這樣做嗎？我得到了一個籃球。是的。  [掌聲] 否。啊，我一路到角落都有"}, {"type": "subtitle", "time": 8975.349, "timestamp": "02:29:35", "text": "陰涼處了。  是的。嘿，屁股真翹。我們"}]
[{"type": "subtitle", "time": 4748.39, "timestamp": "01:19:08", "text": "不，"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "過來。快點。等待。跟我來。  它在哪裡？"}, {"type": "subtitle", "time": 4775.99, "timestamp": "01:19:35", "text": "小鴨子。是的。  哦，瞧。看看"}, {"type": "subtitle", "time": 4779.75, "timestamp": "01:19:39", "text": "我們擁有什麼。過來。  對，就是這樣。"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "好的。就在這裡。準備好了。不，就在這裡。  好了"}]
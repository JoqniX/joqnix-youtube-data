[{"type": "subtitle", "time": 1982.549, "timestamp": "00:33:02", "text": "哪裡？"}, {"type": "subtitle", "time": 1985.19, "timestamp": "00:33:05", "text": "哦，他也在附近。  他為什麼死了？他為什麼會在安全區外死亡？"}, {"type": "subtitle", "time": 2004.87, "timestamp": "00:33:24", "text": "他是不是掛機了？耶穌基督。  我現在就要救你。  我要玩一場高難度的職業遊戲，把你帶到"}, {"type": "subtitle", "time": 2014.87, "timestamp": "00:33:34", "text": "，L，找到附近的黑客。迅速地。好的。  好好管教它"}, {"type": "subtitle", "time": 2026.389, "timestamp": "00:33:46", "text": "。光碟.  哦，有煙了。不要靠近它。  是的，附近可能有"}, {"type": "subtitle", "time": 2032.23, "timestamp": "00:33:52", "text": "敵人。  哦。哦。韋恩，他就在附近。哦，你不在那裡。  哦"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "，"}, {"type": "subtitle", "time": 2039.909, "timestamp": "00:33:59", "text": "你不在A區。不，我死了。  不，沒事。"}]
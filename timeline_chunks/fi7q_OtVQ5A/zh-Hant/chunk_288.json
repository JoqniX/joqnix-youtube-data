[{"type": "subtitle", "time": 17291.35, "timestamp": "04:48:11", "text": "呃"}, {"type": "subtitle", "time": 17307.59, "timestamp": "04:48:27", "text": "，所以耶穌就是耶穌基督。對，就是這個人。我是"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "吉娜。耶穌。"}, {"type": "subtitle", "time": 17336.15, "timestamp": "04:48:56", "text": "不是說了“天才”？我的天啊。我是耶穌。跟我一起了解動漫、電子遊戲和桌遊吧！沒錯"}]
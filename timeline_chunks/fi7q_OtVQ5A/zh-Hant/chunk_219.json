[{"type": "subtitle", "time": 13155.03, "timestamp": "03:39:15", "text": "哦，"}, {"type": "subtitle", "time": 13157.67, "timestamp": "03:39:17", "text": "我死了。偉大的。  耶。  別管我。  跑步。"}, {"type": "subtitle", "time": 13162.15, "timestamp": "03:39:22", "text": "哦，那個桶子。  跑步。我的天啊。  哦"}, {"type": "subtitle", "time": 13164.15, "timestamp": "03:39:24", "text": "，如果不是那個"}, {"type": "subtitle", "time": 13168.389, "timestamp": "03:39:28", "text": "詭異的嬰兒，就是那些骷髏頭。  浮頭。  真是太麻煩了。  我是"}, {"type": "subtitle", "time": 13174.389, "timestamp": "03:39:34", "text": "你的"}, {"type": "subtitle", "time": 13177.429, "timestamp": "03:39:37", "text": "忠實粉絲。哦。我的天啊。我們走吧。  是的。我們離開這裡吧。  哦，小"}]
[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "它失去了原有的皇家紫色，而且"}, {"type": "subtitle", "time": 4623.27, "timestamp": "01:17:03", "text": "现在只剩下一个框架了。我可以移动东西"}, {"type": "subtitle", "time": 4625.11, "timestamp": "01:17:05", "text": "大约。我可以删除它们，我也可以就这么"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "我可以根据自己的意愿进行修改。但是，它确实如此。"}, {"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "与主电源失去连接"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "成分。所以，如果我搬家的话"}, {"type": "subtitle", "time": 4632.47, "timestamp": "01:17:12", "text": "这附近有些东西或者改变一下"}, {"type": "subtitle", "time": 4634.31, "timestamp": "01:17:14", "text": "你看它的颜色，你会发现只有"}, {"type": "subtitle", "time": 4636.07, "timestamp": "01:17:16", "text": "实例受到影响，并且有些事情"}, {"type": "subtitle", "time": 4637.75, "timestamp": "01:17:17", "text": "那曾经是一种实例"}, {"type": "subtitle", "time": 4639.59, "timestamp": "01:17:19", "text": "失去了联系。如此简单"}, {"type": "subtitle", "time": 4642.229, "timestamp": "01:17:22", "text": "组件很简单。我们继续……"}, {"type": "subtitle", "time": 4643.669, "timestamp": "01:17:23", "text": "接下来你需要了解的是……"}, {"type": "subtitle", "time": 4645.83, "timestamp": "01:17:25", "text": "组成部分，从而造成差异。"}, {"type": "subtitle", "time": 4648.709, "timestamp": "01:17:28", "text": "是的。我们来看一下这个进度圆。"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "我有10个不同的圆圈"}, {"type": "subtitle", "time": 4653.189, "timestamp": "01:17:33", "text": "这里。但它们真的有10种不同吗？"}, {"type": "subtitle", "time": 4655.03, "timestamp": "01:17:35", "text": "它们是组件还是一个组件"}, {"type": "subtitle", "time": 4657.51, "timestamp": "01:17:37", "text": "有变化吗？ Figma 中我们拥有什么"}, {"type": "subtitle", "time": 4660.39, "timestamp": "01:17:40", "text": "是一种创建组件集的方法。所以"}, {"type": "subtitle", "time": 4661.75, "timestamp": "01:17:41", "text": "我将选择所有这些"}, {"type": "subtitle", "time": 4664.07, "timestamp": "01:17:44", "text": "进度圈和设计面板"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "顶部有个小下拉菜单"}, {"type": "subtitle", "time": 4668.709, "timestamp": "01:17:48", "text": "我将创建一个组件集。"}, {"type": "subtitle", "time": 4670.55, "timestamp": "01:17:50", "text": "现在它周围会出现一条紫色的线。"}, {"type": "subtitle", "time": 4672.47, "timestamp": "01:17:52", "text": "比如我们知道某些部件会是紫色的。"}, {"type": "subtitle", "time": 4674.79, "timestamp": "01:17:54", "text": "但现在 Figma 告诉我我需要"}, {"type": "subtitle", "time": 4676.87, "timestamp": "01:17:56", "text": "告诉它区别是什么"}, {"type": "subtitle", "time": 4678.709, "timestamp": "01:17:58", "text": "在所有这些圆圈之间，因为"}]
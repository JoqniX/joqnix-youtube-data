[{"type": "subtitle", "time": 23102.35, "timestamp": "06:25:02", "text": "模糊不清，分辨率不高，感觉像是180p，不是160p。"}, {"type": "subtitle", "time": 23105.75, "timestamp": "06:25:05", "text": "瞬间像素不是像素化的，是的，更多"}, {"type": "subtitle", "time": 23109.59, "timestamp": "06:25:09", "text": "就像有人背叛了反外星人组织一样"}, {"type": "subtitle", "time": 23115.51, "timestamp": "06:25:15", "text": "别名和嗯呃，就像是的，一些和"}, {"type": "subtitle", "time": 23118.788, "timestamp": "06:25:18", "text": "唱歌和 FXM MX MSA 之类的"}, {"type": "subtitle", "time": 23120.788, "timestamp": "06:25:20", "text": "不知道那些最高品质的等级"}, {"type": "subtitle", "time": 23123.19, "timestamp": "06:25:23", "text": "还有DLC，对吧，唱歌也对吧，就像"}, {"type": "subtitle", "time": 23129.27, "timestamp": "06:25:29", "text": "那肯定没听到F为什么"}, {"type": "subtitle", "time": 23131.548, "timestamp": "06:25:31", "text": "我的发音"}, {"type": "subtitle", "time": 23136.67, "timestamp": "06:25:36", "text": "我知道这很糟糕，我有点明白。"}, {"type": "subtitle", "time": 23139.99, "timestamp": "06:25:39", "text": "很多人有时会听到我"}, {"type": "subtitle", "time": 23150.99, "timestamp": "06:25:50", "text": "[音乐]"}, {"type": "subtitle", "time": 23153.948, "timestamp": "06:25:53", "text": "某物。"}, {"type": "subtitle", "time": 23157.47, "timestamp": "06:25:57", "text": "猪猪蘑菇。霍吉"}]
[{"type": "subtitle", "time": 17642.83, "timestamp": "04:54:02", "text": "为什么？为什么我应该使用我的其他设备"}, {"type": "subtitle", "time": 17645.75, "timestamp": "04:54:05", "text": "帐户？互动就像结识新朋友"}, {"type": "subtitle", "time": 17648.39, "timestamp": "04:54:08", "text": "加入直播的人。那段日志"}, {"type": "subtitle", "time": 17656.07, "timestamp": "04:54:16", "text": "好的，你得给我一个互动。"}, {"type": "subtitle", "time": 17672.15, "timestamp": "04:54:32", "text": "生活。我的天，这真是一次互动"}, {"type": "subtitle", "time": 17679.75, "timestamp": "04:54:39", "text": "日志。是的。好，好，好，好，好。"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "所以我们完成了可信的互动。"}, {"type": "subtitle", "time": 17685.55, "timestamp": "04:54:45", "text": "日志。现在我们得去做其他事了。"}, {"type": "subtitle", "time": 17687.948, "timestamp": "04:54:47", "text": "东西。我们得去"}, {"type": "subtitle", "time": 17691.51, "timestamp": "04:54:51", "text": "我们必须观看更新吗？"}, {"type": "subtitle", "time": 17693.59, "timestamp": "04:54:53", "text": "更新并观看更新。如果一个人"}, {"type": "subtitle", "time": 17695.91, "timestamp": "04:54:55", "text": "一直在监视你，"}, {"type": "subtitle", "time": 17698.43, "timestamp": "04:54:58", "text": "一切的一切，那个人"}]
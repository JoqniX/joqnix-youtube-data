[{"type": "subtitle", "time": 21485.47, "timestamp": "05:58:05", "text": "沟通我"}, {"type": "subtitle", "time": 21489.27, "timestamp": "05:58:09", "text": "猜测。是的。我不知道。如今我"}, {"type": "subtitle", "time": 21492.23, "timestamp": "05:58:12", "text": "尽量不要与太多人接触。我"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "我想就是因为这个，我才失去了……"}, {"type": "subtitle", "time": 21501.19, "timestamp": "05:58:21", "text": "完全地。这是一次奇怪的交流。"}, {"type": "subtitle", "time": 21513.43, "timestamp": "05:58:33", "text": "我唯一知道的奇怪的交流就是我"}, {"type": "subtitle", "time": 21517.43, "timestamp": "05:58:37", "text": "有一天，有一次，因为对某些人来说，嗯，一些"}, {"type": "subtitle", "time": 21521.11, "timestamp": "05:58:41", "text": "嗯，规格，呃，出于某种原因我不得不去"}, {"type": "subtitle", "time": 21523.59, "timestamp": "05:58:43", "text": "向我的主要联系人发送消息"}, {"type": "subtitle", "time": 21525.67, "timestamp": "05:58:45", "text": "帐户"}, {"type": "subtitle", "time": 21530.628, "timestamp": "05:58:50", "text": "呃，然后让他们上私信，嗯"}, {"type": "subtitle", "time": 21533.03, "timestamp": "05:58:53", "text": "是的，确实有点疼。"}, {"type": "subtitle", "time": 21534.59, "timestamp": "05:58:54", "text": "好的。"}, {"type": "subtitle", "time": 21539.43, "timestamp": "05:58:59", "text": "哦，那真是个奇怪的第一印象。"}]
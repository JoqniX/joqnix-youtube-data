[{"type": "subtitle", "time": 20340.628, "timestamp": "05:39:00", "text": "某物。是的。为了安全和"}, {"type": "subtitle", "time": 20343.11, "timestamp": "05:39:03", "text": "我想，大概什么都有吧。我不知道。我"}, {"type": "subtitle", "time": 20345.99, "timestamp": "05:39:05", "text": "注意到它有很多很多很多"}, {"type": "subtitle", "time": 20349.07, "timestamp": "05:39:09", "text": "我家养了好多猫。"}, {"type": "subtitle", "time": 20352.11, "timestamp": "05:39:12", "text": "是的。什么是名字？"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "呃，我不，我们不，我的意思是，我不给。"}, {"type": "subtitle", "time": 20358.39, "timestamp": "05:39:18", "text": "它就是名字。我只是因为……才有个昵称。"}, {"type": "subtitle", "time": 20360.708, "timestamp": "05:39:20", "text": "来过好多猫咪啊"}, {"type": "subtitle", "time": 20363.07, "timestamp": "05:39:23", "text": "来来去去吧。所以我称之为"}, {"type": "subtitle", "time": 20370.07, "timestamp": "05:39:30", "text": "因为我把它弄丢了，所以就把它扔了。好的。我"}, {"type": "subtitle", "time": 20373.83, "timestamp": "05:39:33", "text": "大概有半年没和家人在一起了"}, {"type": "subtitle", "time": 20378.75, "timestamp": "05:39:38", "text": "一年，嗯，有点像我们一样"}, {"type": "subtitle", "time": 20382.788, "timestamp": "05:39:42", "text": "嗯嗯，就像嗯，成年中等大小"}, {"type": "subtitle", "time": 20387.39, "timestamp": "05:39:47", "text": "当时是ketto。那只猫"}, {"type": "subtitle", "time": 20390.75, "timestamp": "05:39:50", "text": "这。但另一个"}, {"type": "subtitle", "time": 20394.31, "timestamp": "05:39:54", "text": "嗯，很遗憾，在我待在那里的时候去世了。"}, {"type": "subtitle", "time": 20397.708, "timestamp": "05:39:57", "text": "我的呃，PG，就像我住的地方一样。"}]
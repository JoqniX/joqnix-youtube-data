[{"type": "subtitle", "time": 24121.99, "timestamp": "06:42:01", "text": "呃，这种参与就像参与其中一样"}, {"type": "subtitle", "time": 24123.59, "timestamp": "06:42:03", "text": "对话之类的。更像是"}, {"type": "subtitle", "time": 24124.51, "timestamp": "06:42:04", "text": "一个"}, {"type": "subtitle", "time": 24126.788, "timestamp": "06:42:06", "text": "测试。蹦床在哪儿？你想"}, {"type": "subtitle", "time": 24129.23, "timestamp": "06:42:09", "text": "现在该玩蹦床了吗？我可以做到"}, {"type": "subtitle", "time": 24132.548, "timestamp": "06:42:12", "text": "那。然后我们可以切换回"}, {"type": "subtitle", "time": 24135.59, "timestamp": "06:42:15", "text": "我想大概是在聊天吧。是的。让我来设置"}, {"type": "subtitle", "time": 24138.39, "timestamp": "06:42:18", "text": "搞定。好的。"}, {"type": "subtitle", "time": 24140.868, "timestamp": "06:42:20", "text": "FBI，开门。"}, {"type": "subtitle", "time": 24143.99, "timestamp": "06:42:23", "text": "你好，Amar。你好。你好。我懂了"}, {"type": "subtitle", "time": 24146.868, "timestamp": "06:42:26", "text": "你敲门。我正在和……啪啪啪"}, {"type": "subtitle", "time": 24153.08, "timestamp": "06:42:33", "text": "门。你好。欢迎。"}, {"type": "subtitle", "time": 24154.35, "timestamp": "06:42:34", "text": "[音乐]"}, {"type": "subtitle", "time": 24158.35, "timestamp": "06:42:38", "text": "欢迎。希望你一切都好。"}, {"type": "subtitle", "time": 24159.48, "timestamp": "06:42:39", "text": "你好。"}, {"type": "subtitle", "time": 24161.23, "timestamp": "06:42:41", "text": "[音乐]"}, {"type": "subtitle", "time": 24164.67, "timestamp": "06:42:44", "text": "砰。是的。波"}, {"type": "subtitle", "time": 24167.19, "timestamp": "06:42:47", "text": "的确。好的。"}, {"type": "subtitle", "time": 24169.31, "timestamp": "06:42:49", "text": "我热得满头大汗。"}, {"type": "subtitle", "time": 24172.948, "timestamp": "06:42:52", "text": "哇。因为我房间里有台风扇"}, {"type": "subtitle", "time": 24173.948, "timestamp": "06:42:53", "text": "活着的"}, {"type": "subtitle", "time": 24179.788, "timestamp": "06:42:59", "text": "房间。但是疼痛，我却感受不到。"}]
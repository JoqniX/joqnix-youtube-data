[{"type": "subtitle", "time": 22260.15, "timestamp": "06:11:00", "text": "哦，你觉得你父母会"}, {"type": "subtitle", "time": 22265.43, "timestamp": "06:11:05", "text": "告诉你，就像，是的，我的孩子，我的儿子"}, {"type": "subtitle", "time": 22268.708, "timestamp": "06:11:08", "text": "嗯，是啊，交朋友的时候对吧？"}, {"type": "subtitle", "time": 22271.35, "timestamp": "06:11:11", "text": "生活中总会遇到这样那样的事情。"}, {"type": "subtitle", "time": 22274.23, "timestamp": "06:11:14", "text": "必须确保你理解……"}, {"type": "subtitle", "time": 22277.91, "timestamp": "06:11:17", "text": "友谊的价值以及朋友如何相处"}, {"type": "subtitle", "time": 22281.27, "timestamp": "06:11:21", "text": "系统如何运作？"}, {"type": "subtitle", "time": 22284.67, "timestamp": "06:11:24", "text": "在这个时代，你还像喂婴儿一样喂Dio？"}, {"type": "subtitle", "time": 22289.35, "timestamp": "06:11:29", "text": "但是我觉得，我觉得就像……我的意思是……我"}, {"type": "subtitle", "time": 22292.39, "timestamp": "06:11:32", "text": "意思是你可以随时用谷歌搜索，或者你可以"}, {"type": "subtitle", "time": 22294.628, "timestamp": "06:11:34", "text": "查一下吧，我想应该有相关的文章。"}, {"type": "subtitle", "time": 22297.788, "timestamp": "06:11:37", "text": "大概吧，是的，那是一个。"}, {"type": "subtitle", "time": 22302.948, "timestamp": "06:11:42", "text": "东西，但也包括你的祖先或"}, {"type": "subtitle", "time": 22305.43, "timestamp": "06:11:45", "text": "父母或祖父母会像"}, {"type": "subtitle", "time": 22308.51, "timestamp": "06:11:48", "text": "是的，回到我的"}, {"type": "subtitle", "time": 22312.23, "timestamp": "06:11:52", "text": "想当年，我做过这些事。"}, {"type": "subtitle", "time": 22315.99, "timestamp": "06:11:55", "text": "所以，我就是这样自学的。"}, {"type": "subtitle", "time": 22319.11, "timestamp": "06:11:59", "text": "观察他人等等。我在这里给予"}]
[{"type": "subtitle", "time": 785.31, "timestamp": "00:13:05", "text": "我的天哪，我要……"}, {"type": "subtitle", "time": 805.47, "timestamp": "00:13:25", "text": "哦，我的"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "上帝。所以，精品店和呃呃女士们"}, {"type": "subtitle", "time": 811.43, "timestamp": "00:13:31", "text": "呃，阿姨她们要来了，"}, {"type": "subtitle", "time": 816.19, "timestamp": "00:13:36", "text": "我爸爸告诉我，要保持喜欢"}, {"type": "subtitle", "time": 819.87, "timestamp": "00:13:39", "text": "嗯，他告诉我最好保持……"}, {"type": "subtitle", "time": 838.389, "timestamp": "00:13:58", "text": "可以加急送货吗？它只会"}]
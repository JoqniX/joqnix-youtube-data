[{"type": "subtitle", "time": 7090.669, "timestamp": "01:58:10", "text": "主意。"}, {"type": "subtitle", "time": 7102.75, "timestamp": "01:58:22", "text": "我必须把每样东西都做出来。"}, {"type": "subtitle", "time": 7105.51, "timestamp": "01:58:25", "text": "正确的房产一。我不想要一个"}, {"type": "subtitle", "time": 7111.07, "timestamp": "01:58:31", "text": "一个主要"}, {"type": "subtitle", "time": 7129.07, "timestamp": "01:58:49", "text": "好的。休息一下，我睡觉，打盹，休息一美元。"}, {"type": "subtitle", "time": 7134.229, "timestamp": "01:58:54", "text": "早餐、午餐、下午茶、晚餐、音乐"}, {"type": "subtitle", "time": 7136.47, "timestamp": "01:58:56", "text": "班级，"}]
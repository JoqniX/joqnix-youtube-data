[{"type": "subtitle", "time": 21541.59, "timestamp": "05:59:01", "text": "情绪低落，一蹶不振。它"}, {"type": "subtitle", "time": 21544.83, "timestamp": "05:59:04", "text": "感觉有点怪异的疼痛。自从"}, {"type": "subtitle", "time": 21549.75, "timestamp": "05:59:09", "text": "然后，我就想，是啊，这玩意儿推特"}, {"type": "subtitle", "time": 21551.91, "timestamp": "05:59:11", "text": "互动或类似触及"}, {"type": "subtitle", "time": 21553.75, "timestamp": "05:59:13", "text": "向一个随机的陌生人透露信息"}, {"type": "subtitle", "time": 21555.948, "timestamp": "05:59:15", "text": "互联网，就是"}, {"type": "subtitle", "time": 21559.19, "timestamp": "05:59:19", "text": "难的。但我并没有放弃。我只是"}, {"type": "subtitle", "time": 21562.788, "timestamp": "05:59:22", "text": "但我仍然尝试与他们联系。"}, {"type": "subtitle", "time": 21566.07, "timestamp": "05:59:26", "text": "还有其他一些东西。就像你跟我谈话之后那样"}, {"type": "subtitle", "time": 21569.35, "timestamp": "05:59:29", "text": "关于你与他们谈话的目的，"}, {"type": "subtitle", "time": 21572.59, "timestamp": "05:59:32", "text": "接下来你想说什么？这就是我的原因"}, {"type": "subtitle", "time": 21575.03, "timestamp": "05:59:35", "text": "使困惑。接下来你想说什么？后"}, {"type": "subtitle", "time": 21578.07, "timestamp": "05:59:38", "text": "那你怎么说？如果你尝试"}, {"type": "subtitle", "time": 21580.39, "timestamp": "05:59:40", "text": "闲聊几句，或者打个招呼，你好，好"}, {"type": "subtitle", "time": 21583.15, "timestamp": "05:59:43", "text": "早晨。所有这些都是"}, {"type": "subtitle", "time": 21586.15, "timestamp": "05:59:46", "text": "有时会让某些人觉得烦人，"}, {"type": "subtitle", "time": 21587.91, "timestamp": "05:59:47", "text": "正确的？"}, {"type": "subtitle", "time": 21591.03, "timestamp": "05:59:51", "text": "就像你不知道该如何来一样"}, {"type": "subtitle", "time": 21594.948, "timestamp": "05:59:54", "text": "提出一个主题或话题，你就失败了。"}, {"type": "subtitle", "time": 21596.788, "timestamp": "05:59:56", "text": "在谈话中或其他什么地方。我"}, {"type": "subtitle", "time": 21598.19, "timestamp": "05:59:58", "text": "不"}]
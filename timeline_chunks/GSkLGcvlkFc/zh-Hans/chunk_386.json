[{"type": "subtitle", "time": 23165.43, "timestamp": "06:26:05", "text": "蟑螂。好久不见了。那"}, {"type": "subtitle", "time": 23167.67, "timestamp": "06:26:07", "text": "卡通片。不，是那部卡通动画片。不是"}, {"type": "subtitle", "time": 23169.91, "timestamp": "06:26:09", "text": "日本动画片。是动漫吗？这是最好的卡通片"}, {"type": "subtitle", "time": 23172.07, "timestamp": "06:26:12", "text": "尽管。虽然是动漫，但又不是动漫"}, {"type": "subtitle", "time": 23175.19, "timestamp": "06:26:15", "text": "尽管。等等，卡通片。我称之为"}, {"type": "subtitle", "time": 23177.708, "timestamp": "06:26:17", "text": "动画系列。好的。好的，"}, {"type": "subtitle", "time": 23185.07, "timestamp": "06:26:25", "text": "它。我想我以前在……上看过。"}, {"type": "subtitle", "time": 23188.47, "timestamp": "06:26:28", "text": "纳洛迪安。我猜大部分是用印地语写的。"}, {"type": "subtitle", "time": 23197.548, "timestamp": "06:26:37", "text": "我明白了"}, {"type": "subtitle", "time": 23200.35, "timestamp": "06:26:40", "text": "蟑螂。"}, {"type": "subtitle", "time": 23204.59, "timestamp": "06:26:44", "text": "不，是啊，那部动画挺好看的。我"}, {"type": "subtitle", "time": 23207.13, "timestamp": "06:26:47", "text": "猜猜看"}]
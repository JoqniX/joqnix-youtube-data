[{"type": "subtitle", "time": 22621.59, "timestamp": "06:17:01", "text": "忘了。呃，我本来想说点什么。"}, {"type": "subtitle", "time": 22623.23, "timestamp": "06:17:03", "text": "然后我"}, {"type": "subtitle", "time": 22626.39, "timestamp": "06:17:06", "text": "忘了。嗯，哦，这个闹钟"}, {"type": "subtitle", "time": 22629.19, "timestamp": "06:17:09", "text": "通知功能真烦人，怎么会这样"}, {"type": "subtitle", "time": 22632.43, "timestamp": "06:17:12", "text": "我该等等吗？你知道吗？呃，给我一个"}, {"type": "subtitle", "time": 22635.51, "timestamp": "06:17:15", "text": "分钟。让我用手机翻译一下"}, {"type": "subtitle", "time": 22643.03, "timestamp": "06:17:23", "text": "好的。我希望有一天，能有一个美好的日子。"}, {"type": "subtitle", "time": 22645.948, "timestamp": "06:17:25", "text": "我能读懂"}, {"type": "subtitle", "time": 22655.83, "timestamp": "06:17:35", "text": "打扰？好的。请勿打扰信息。"}, {"type": "subtitle", "time": 22657.6, "timestamp": "06:17:37", "text": "知道了。哦，那里有一个"}, {"type": "subtitle", "time": 22660.83, "timestamp": "06:17:40", "text": "[音乐]"}, {"type": "subtitle", "time": 22663.27, "timestamp": "06:17:43", "text": "期间。无需接收消息"}, {"type": "subtitle", "time": 22672.628, "timestamp": "06:17:52", "text": "我等待加入群组助理，但没有"}, {"type": "subtitle", "time": 22674.628, "timestamp": "06:17:54", "text": "提醒。好的，我认为第一个选项"}, {"type": "subtitle", "time": 22678.15, "timestamp": "06:17:58", "text": "对我有好处。是的。好的，应该"}]
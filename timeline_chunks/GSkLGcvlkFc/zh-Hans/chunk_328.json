[{"type": "subtitle", "time": 19682.11, "timestamp": "05:28:02", "text": "哦好的。好，好，好"}, {"type": "subtitle", "time": 19685.03, "timestamp": "05:28:05", "text": "好的。天哪，我得小心点，当我"}, {"type": "subtitle", "time": 19687.99, "timestamp": "05:28:07", "text": "家人进来了。嗯，我得……"}, {"type": "subtitle", "time": 19691.07, "timestamp": "05:28:11", "text": "比如把两个麦克风都静音。"}, {"type": "subtitle", "time": 19693.19, "timestamp": "05:28:13", "text": "[音乐]"}, {"type": "subtitle", "time": 19697.23, "timestamp": "05:28:17", "text": "我甚至不希望它像……"}, {"type": "subtitle", "time": 19698.99, "timestamp": "05:28:18", "text": "实际上"}, {"type": "subtitle", "time": 19702.39, "timestamp": "05:28:22", "text": "翻译我家人说的话。所以"}, {"type": "subtitle", "time": 19704.15, "timestamp": "05:28:24", "text": "是的。你最喜欢的角色是谁？我"}, {"type": "subtitle", "time": 19705.868, "timestamp": "05:28:25", "text": "不知道。它们都是"}, {"type": "subtitle", "time": 19708.75, "timestamp": "05:28:28", "text": "好的。嗯，从那方面来说。"}, {"type": "subtitle", "time": 19712.47, "timestamp": "05:28:32", "text": "出自那部动画。为什么是翻译器"}, {"type": "subtitle", "time": 19715.39, "timestamp": "05:28:35", "text": "我说“动物”的时候"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "什么？我的女孩是蓝头发的。哦，"}, {"type": "subtitle", "time": 19725.27, "timestamp": "05:28:45", "text": "好的。好的。我的意思是，两个我都喜欢。这"}, {"type": "subtitle", "time": 19728.23, "timestamp": "05:28:48", "text": "金发女郎和"}, {"type": "subtitle", "time": 19730.51, "timestamp": "05:28:50", "text": "呃，金发女孩和"}, {"type": "subtitle", "time": 19734.75, "timestamp": "05:28:54", "text": "蓝头发或深色头发的女孩。"}, {"type": "subtitle", "time": 19739.23, "timestamp": "05:28:59", "text": "是的。是的。是的。他们俩都是"}]
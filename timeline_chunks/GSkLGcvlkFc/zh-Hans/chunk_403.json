[{"type": "subtitle", "time": 24182.31, "timestamp": "06:43:02", "text": "扇子。你的模型出现了故障，就像我们的一样。"}, {"type": "subtitle", "time": 24184.39, "timestamp": "06:43:04", "text": "拉丁裔。等等，我的模型出故障了。"}, {"type": "subtitle", "time": 24200.03, "timestamp": "06:43:20", "text": "出现故障。等待，"}, {"type": "subtitle", "time": 24202.548, "timestamp": "06:43:22", "text": "真的吗？嗯，是的，它运行困难。"}, {"type": "subtitle", "time": 24204.43, "timestamp": "06:43:24", "text": "跟上"}, {"type": "subtitle", "time": 24207.19, "timestamp": "06:43:27", "text": "运动。这就像是拿到B级一样"}, {"type": "subtitle", "time": 24208.948, "timestamp": "06:43:28", "text": "第二。是啊，也许是因为我当时在看"}, {"type": "subtitle", "time": 24210.51, "timestamp": "06:43:30", "text": "向下或"}, {"type": "subtitle", "time": 24212.948, "timestamp": "06:43:32", "text": "某物。我手机的放置位置是"}, {"type": "subtitle", "time": 24214.75, "timestamp": "06:43:34", "text": "也是一个"}, {"type": "subtitle", "time": 24218.468, "timestamp": "06:43:38", "text": "疼痛。我等不及了。一旦我的房间"}, {"type": "subtitle", "time": 24221.83, "timestamp": "06:43:41", "text": "我的办公室已经准备好了。我是"}, {"type": "subtitle", "time": 24225.39, "timestamp": "06:43:45", "text": "去吧，我不能"}, {"type": "subtitle", "time": 24227.99, "timestamp": "06:43:47", "text": "等待。我不知道它持续了多久"}, {"type": "subtitle", "time": 24234.868, "timestamp": "06:43:54", "text": "男人。将会有大量的"}, {"type": "subtitle", "time": 24237.91, "timestamp": "06:43:57", "text": "停电期间，电力工人会……"}, {"type": "subtitle", "time": 24239.468, "timestamp": "06:43:59", "text": "务必到场。"}]
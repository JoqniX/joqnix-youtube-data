[{"type": "subtitle", "time": 22500.31, "timestamp": "06:15:00", "text": "我是中国人，所以我可以……嗯……呃……你……"}, {"type": "subtitle", "time": 22504.07, "timestamp": "06:15:04", "text": "叫它什么？在两种语言之间切换"}, {"type": "subtitle", "time": 22507.59, "timestamp": "06:15:07", "text": "解释一下我的意思，因为……"}, {"type": "subtitle", "time": 22509.628, "timestamp": "06:15:09", "text": "翻译相关内容"}, {"type": "subtitle", "time": 22512.75, "timestamp": "06:15:12", "text": "疼痛。所以你"}, {"type": "subtitle", "time": 22515.91, "timestamp": "06:15:15", "text": "意思是问他们告诉我你是"}, {"type": "subtitle", "time": 22517.43, "timestamp": "06:15:17", "text": "宇宙中最强的人证明"}, {"type": "subtitle", "time": 22519.59, "timestamp": "06:15:19", "text": "它。所以你在这里拿走了一些沙子。"}, {"type": "subtitle", "time": 22523.11, "timestamp": "06:15:23", "text": "握紧拳头，然后再张开。"}, {"type": "subtitle", "time": 22526.75, "timestamp": "06:15:26", "text": "沙子变成了钻石。什么？"}, {"type": "subtitle", "time": 22530.15, "timestamp": "06:15:30", "text": "真的吗？嗯？但他是如何结识巴拉克的呢？"}, {"type": "subtitle", "time": 22533.948, "timestamp": "06:15:33", "text": "奥巴马呢？就像虚构的故事一样"}, {"type": "subtitle", "time": 22537.548, "timestamp": "06:15:37", "text": "明智的。哇。那是"}, {"type": "subtitle", "time": 22545.15, "timestamp": "06:15:45", "text": "尽管。"}, {"type": "subtitle", "time": 22549.39, "timestamp": "06:15:49", "text": "哇。在漫画中。等待，"}, {"type": "subtitle", "time": 22552.788, "timestamp": "06:15:52", "text": "真的吗？哇。"}]
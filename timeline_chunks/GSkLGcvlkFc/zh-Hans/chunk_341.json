[{"type": "subtitle", "time": 20461.67, "timestamp": "05:41:01", "text": "窗户"}, {"type": "subtitle", "time": 20464.788, "timestamp": "05:41:04", "text": "呃，就像……一个很短的窗口期或时间范围"}, {"type": "subtitle", "time": 20467.59, "timestamp": "05:41:07", "text": "至少得把晚饭吃完吧"}, {"type": "subtitle", "time": 20469.75, "timestamp": "05:41:09", "text": "吃光"}, {"type": "subtitle", "time": 20473.03, "timestamp": "05:41:13", "text": "呃，在家人打电话给我之前"}, {"type": "subtitle", "time": 20481.43, "timestamp": "05:41:21", "text": "时间。是的。"}, {"type": "subtitle", "time": 20483.47, "timestamp": "05:41:23", "text": "所以，我其实并没有。"}, {"type": "subtitle", "time": 20487.11, "timestamp": "05:41:27", "text": "吃，但是，呃，今天我就……嗯……"}, {"type": "subtitle", "time": 20489.75, "timestamp": "05:41:29", "text": "吃了一些晚上剩下的东西。"}, {"type": "subtitle", "time": 20493.03, "timestamp": "05:41:33", "text": "是啊，因为我觉得我会浪费时间"}, {"type": "subtitle", "time": 20496.628, "timestamp": "05:41:36", "text": "今天没吃东西，因为我的肚子，你知道的。"}, {"type": "subtitle", "time": 20498.47, "timestamp": "05:41:38", "text": "虽然我吃得不多，但我仍然"}, {"type": "subtitle", "time": 20500.788, "timestamp": "05:41:40", "text": "我的肚子，我觉得我的肠子……"}, {"type": "subtitle", "time": 20506.628, "timestamp": "05:41:46", "text": "更小。吃了几勺食物之后，"}, {"type": "subtitle", "time": 20510.788, "timestamp": "05:41:50", "text": "我吃饱了。那可糟了。"}, {"type": "subtitle", "time": 20514.27, "timestamp": "05:41:54", "text": "我的新陈代谢也变得很奇怪。"}, {"type": "subtitle", "time": 20517.67, "timestamp": "05:41:57", "text": "如今。我不知道。就好像……"}]
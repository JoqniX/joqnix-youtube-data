[{"type": "subtitle", "time": 11761.229, "timestamp": "03:16:01", "text": "这组星座并非它的"}, {"type": "subtitle", "time": 11763.79, "timestamp": "03:16:03", "text": "未受影响。那是"}, {"type": "subtitle", "time": 11767.55, "timestamp": "03:16:07", "text": "美好的。将来如果我想"}, {"type": "subtitle", "time": 11769.87, "timestamp": "03:16:09", "text": "去"}, {"type": "subtitle", "time": 11781.55, "timestamp": "03:16:21", "text": "嗯，我不知道。"}, {"type": "subtitle", "time": 11785.269, "timestamp": "03:16:25", "text": "疼痛。啊，现在的问题是，我该怎么做？"}, {"type": "subtitle", "time": 11786.99, "timestamp": "03:16:26", "text": "互连"}, {"type": "subtitle", "time": 11789.67, "timestamp": "03:16:29", "text": "一切？这就是我的问题。我该怎么做？"}, {"type": "subtitle", "time": 11797.91, "timestamp": "03:16:37", "text": "这些大部分都是我做的。"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "这些图标都是我自己设计的。但这几乎"}, {"type": "subtitle", "time": 11802.349, "timestamp": "03:16:42", "text": "比如这些"}, {"type": "subtitle", "time": 11805.11, "timestamp": "03:16:45", "text": "已创建，我可以查看此编辑按钮"}, {"type": "subtitle", "time": 11806.79, "timestamp": "03:16:46", "text": "你会看到优先值。如果我点击"}, {"type": "subtitle", "time": 11808.83, "timestamp": "03:16:48", "text": "加"}, {"type": "subtitle", "time": 11810.64, "timestamp": "03:16:50", "text": "它箭头"}, {"type": "subtitle", "time": 11813.15, "timestamp": "03:16:53", "text": "[音乐]"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "右键。所以我会上来这里，"}, {"type": "subtitle", "time": 11818.63, "timestamp": "03:16:58", "text": "添加新变体。"}]
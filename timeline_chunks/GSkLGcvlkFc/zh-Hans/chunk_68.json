[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "将其转换为组件。在"}, {"type": "subtitle", "time": 4083.349, "timestamp": "01:08:03", "text": "右侧边栏新增了一个"}, {"type": "subtitle", "time": 4085.67, "timestamp": "01:08:05", "text": "变体部分。组件集"}, {"type": "subtitle", "time": 4087.27, "timestamp": "01:08:07", "text": "需要有多个变体"}, {"type": "subtitle", "time": 4089.51, "timestamp": "01:08:09", "text": "在它们之中。我们点击加号图标"}, {"type": "subtitle", "time": 4091.309, "timestamp": "01:08:11", "text": "在变体部分查看具体内容"}, {"type": "subtitle", "time": 4093.99, "timestamp": "01:08:13", "text": "事情发生了。哇。让我们来探讨一下……"}, {"type": "subtitle", "time": 4096.229, "timestamp": "01:08:16", "text": "改变了。 Figma 创建了我们网站的副本。"}, {"type": "subtitle", "time": 4098.229, "timestamp": "01:08:18", "text": "复选框组件并放置于"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "将组件放入一个新容器中。这"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "容器是一个组件集，我们"}, {"type": "subtitle", "time": 4104.229, "timestamp": "01:08:24", "text": "可通过紫色虚线识别"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "中风。在图层面板中，我们可以看到"}, {"type": "subtitle", "time": 4108.789, "timestamp": "01:08:28", "text": "该组件集具有相同的四个组件。"}, {"type": "subtitle", "time": 4110.709, "timestamp": "01:08:30", "text": "我们通常看到的钻石图标"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "我们的组件。我们每个变体中的"}, {"type": "subtitle", "time": 4114.63, "timestamp": "01:08:34", "text": "组件集包含一个已填充的组件。"}, {"type": "subtitle", "time": 4116.95, "timestamp": "01:08:36", "text": "钻石图标。我们各层的名称"}, {"type": "subtitle", "time": 4119.43, "timestamp": "01:08:39", "text": "也已进行了更改。前文"}, {"type": "subtitle", "time": 4121.91, "timestamp": "01:08:41", "text": "斜杠复选框现在的名称是"}, {"type": "subtitle", "time": 4124.39, "timestamp": "01:08:44", "text": "我们的组件集。后面的文字"}, {"type": "subtitle", "time": 4126.87, "timestamp": "01:08:46", "text": "slash unchecked 现在是我们的名称"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "默认变体。复选框具有"}, {"type": "subtitle", "time": 4131.03, "timestamp": "01:08:51", "text": "通用名后跟升序"}, {"type": "subtitle", "time": 4133.829, "timestamp": "01:08:53", "text": "数字变体 2 层命名是一种"}, {"type": "subtitle", "time": 4135.43, "timestamp": "01:08:55", "text": "创建的重要方面和"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "管理变体。与面板不同，我们可以"}, {"type": "subtitle", "time": 4139.55, "timestamp": "01:08:59", "text": "参见"}]
[{"type": "subtitle", "time": 21962.51, "timestamp": "06:06:02", "text": "年。所以，但我始终不知道什么"}, {"type": "subtitle", "time": 21965.47, "timestamp": "06:06:05", "text": "到"}, {"type": "subtitle", "time": 21968.39, "timestamp": "06:06:08", "text": "回复。这很难。"}, {"type": "subtitle", "time": 21970.07, "timestamp": "06:06:10", "text": "当他们问我“最近怎么样”时，我就说："}, {"type": "subtitle", "time": 21972.948, "timestamp": "06:06:12", "text": "“哦，我很好。我一直都很好。”"}, {"type": "subtitle", "time": 21975.43, "timestamp": "06:06:15", "text": "所以。”但我注意到，当你当某人"}, {"type": "subtitle", "time": 21977.35, "timestamp": "06:06:17", "text": "问你：“你好吗？”有两个"}, {"type": "subtitle", "time": 21979.99, "timestamp": "06:06:19", "text": "实现方法。你可以选择短款。"}, {"type": "subtitle", "time": 21982.39, "timestamp": "06:06:22", "text": "版本。我很好。哦，我正在做"}, {"type": "subtitle", "time": 21984.708, "timestamp": "06:06:24", "text": "美好的。我一切都好。谢谢。"}, {"type": "subtitle", "time": 21987.03, "timestamp": "06:06:27", "text": "你呢？差不多是这样。你"}, {"type": "subtitle", "time": 21988.868, "timestamp": "06:06:28", "text": "可以选择长版本。我正在做"}, {"type": "subtitle", "time": 21992.868, "timestamp": "06:06:32", "text": "好的。我刚起床，刷了牙，"}, {"type": "subtitle", "time": 21995.39, "timestamp": "06:06:35", "text": "我该开始一天的工作了。你呢，"}, {"type": "subtitle", "time": 21999.51, "timestamp": "06:06:39", "text": "兄弟？差不多是这样。是的。而且"}, {"type": "subtitle", "time": 22001.83, "timestamp": "06:06:41", "text": "我不小心切换到了休闲模式"}, {"type": "subtitle", "time": 22005.39, "timestamp": "06:06:45", "text": "模式。所以我进入了那个领域。"}, {"type": "subtitle", "time": 22008.788, "timestamp": "06:06:48", "text": "第二个版本的“你好吗？”"}, {"type": "subtitle", "time": 22010.99, "timestamp": "06:06:50", "text": "有人问你"}, {"type": "subtitle", "time": 22015.27, "timestamp": "06:06:55", "text": "那。然后那个人就说，好吧"}, {"type": "subtitle", "time": 22017.67, "timestamp": "06:06:57", "text": "我没要求你详细说明。"}]
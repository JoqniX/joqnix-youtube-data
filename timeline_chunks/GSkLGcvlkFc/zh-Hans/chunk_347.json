[{"type": "subtitle", "time": 20822.15, "timestamp": "05:47:02", "text": "猜测。是啊，他们有点挑剔。他们"}, {"type": "subtitle", "time": 20824.39, "timestamp": "05:47:04", "text": "他们游手好闲，自顾自地过日子"}, {"type": "subtitle", "time": 20827.708, "timestamp": "05:47:07", "text": "东西。我觉得狗更"}, {"type": "subtitle", "time": 20830.35, "timestamp": "05:47:10", "text": "忠于他们"}, {"type": "subtitle", "time": 20832.948, "timestamp": "05:47:12", "text": "业主。但猫就未必如此了。它"}, {"type": "subtitle", "time": 20834.67, "timestamp": "05:47:14", "text": "我想这取决于猫的性格。我不"}, {"type": "subtitle", "time": 20837.948, "timestamp": "05:47:17", "text": "知道。他们就像喜怒无常的人或"}, {"type": "subtitle", "time": 20840.548, "timestamp": "05:47:20", "text": "你知道，就是那种感觉？如果你仔细想想"}, {"type": "subtitle", "time": 20843.948, "timestamp": "05:47:23", "text": "确实如此。你难道没有这种感觉吗？"}, {"type": "subtitle", "time": 20846.91, "timestamp": "05:47:26", "text": "一些"}, {"type": "subtitle", "time": 20850.47, "timestamp": "05:47:30", "text": "他们很关心狗狗，就像没有喜欢一样。"}, {"type": "subtitle", "time": 20852.47, "timestamp": "05:47:32", "text": "发生了一些事，不是某个窃贼，也不是某个……"}, {"type": "subtitle", "time": 20854.948, "timestamp": "05:47:34", "text": "某种东西出现了，就像……"}, {"type": "subtitle", "time": 20857.59, "timestamp": "05:47:37", "text": "会提醒你等等。所以是"}, {"type": "subtitle", "time": 20859.11, "timestamp": "05:47:39", "text": "不妨这样想。"}, {"type": "subtitle", "time": 20860.19, "timestamp": "05:47:40", "text": "他们是"}, {"type": "subtitle", "time": 20863.91, "timestamp": "05:47:43", "text": "嗯，用“泼辣”来形容最贴切。还，"}, {"type": "subtitle", "time": 20868.24, "timestamp": "05:47:48", "text": "欢迎来到直播间，或者点赞吧！"}, {"type": "subtitle", "time": 20869.788, "timestamp": "05:47:49", "text": "[音乐]"}, {"type": "subtitle", "time": 20873.51, "timestamp": "05:47:53", "text": "欢迎说“是”。是的。是的。我 我"}, {"type": "subtitle", "time": 20875.99, "timestamp": "05:47:55", "text": "我不是说猫狗不好。好的。"}, {"type": "subtitle", "time": 20878.39, "timestamp": "05:47:58", "text": "我的意思是，这取决于猫的性格。"}]
[{"type": "subtitle", "time": 4861.03, "timestamp": "01:21:01", "text": "更改起来更快，而且"}, {"type": "subtitle", "time": 4863.03, "timestamp": "01:21:03", "text": "在这种情况下也说得通。所以"}, {"type": "subtitle", "time": 4864.55, "timestamp": "01:21:04", "text": "这算是一种提升，但是"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "不过，创建起来还是相当简单的。"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "Figma 中的变体。现在，我们来看一下……"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "更进一步，即使用"}, {"type": "subtitle", "time": 4872.07, "timestamp": "01:21:12", "text": "组件属性。所以我有这个"}, {"type": "subtitle", "time": 4874.07, "timestamp": "01:21:14", "text": "按钮。里面贴着标签，"}, {"type": "subtitle", "time": 4876.47, "timestamp": "01:21:16", "text": "它有一个图标。假设我想要一个"}, {"type": "subtitle", "time": 4878.229, "timestamp": "01:21:18", "text": "这个按钮的变体，其中没有"}, {"type": "subtitle", "time": 4880.07, "timestamp": "01:21:20", "text": "有时有图标，有时没有。"}, {"type": "subtitle", "time": 4881.59, "timestamp": "01:21:21", "text": "有时候会贴标签。所以有时候"}, {"type": "subtitle", "time": 4883.91, "timestamp": "01:21:23", "text": "这只是个图标。我也想"}, {"type": "subtitle", "time": 4886.39, "timestamp": "01:21:26", "text": "能够互换图标。所以"}, {"type": "subtitle", "time": 4888.229, "timestamp": "01:21:28", "text": "有时是颗心，有时是……"}, {"type": "subtitle", "time": 4889.35, "timestamp": "01:21:29", "text": "这里显示的图标与之前的图标不同。"}, {"type": "subtitle", "time": 4891.43, "timestamp": "01:21:31", "text": "底部。让我来做吧。设置这个"}, {"type": "subtitle", "time": 4893.11, "timestamp": "01:21:33", "text": "在深入细节之前，先说一下这个。这"}, {"type": "subtitle", "time": 4894.709, "timestamp": "01:21:34", "text": "按钮本身是自动布局的，"}, {"type": "subtitle", "time": 4897.669, "timestamp": "01:21:37", "text": "里面有一个心形图标，"}, {"type": "subtitle", "time": 4900.31, "timestamp": "01:21:40", "text": "是心脏组件的一个实例，"}, {"type": "subtitle", "time": 4902.47, "timestamp": "01:21:42", "text": "我有一个文本框，上面写着“标签”。这"}, {"type": "subtitle", "time": 4904.07, "timestamp": "01:21:44", "text": "之所以采用自动布局，原因如下"}, {"type": "subtitle", "time": 4906.229, "timestamp": "01:21:46", "text": "如果文本发生变化或有任何内容"}, {"type": "subtitle", "time": 4909.59, "timestamp": "01:21:49", "text": "移除或添加了它的大小"}, {"type": "subtitle", "time": 4911.59, "timestamp": "01:21:51", "text": "按钮移动。我没有使用自动布局。"}, {"type": "subtitle", "time": 4913.11, "timestamp": "01:21:53", "text": "东西。你好。你看它是怎么移动的"}, {"type": "subtitle", "time": 4915.91, "timestamp": "01:21:55", "text": "与我一起。正如我所说，这个图标，心形"}, {"type": "subtitle", "time": 4918.31, "timestamp": "01:21:58", "text": "图标是组件的一个实例。所以"}]
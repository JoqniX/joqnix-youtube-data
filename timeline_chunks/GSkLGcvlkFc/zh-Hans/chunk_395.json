[{"type": "subtitle", "time": 23720.39, "timestamp": "06:35:20", "text": "是的。哦，是的。 Pal world 正在呃做呃"}, {"type": "subtitle", "time": 23722.868, "timestamp": "06:35:22", "text": "比如日式主题的DLC之类的"}, {"type": "subtitle", "time": 23723.6, "timestamp": "06:35:23", "text": "某物，"}, {"type": "subtitle", "time": 23725.23, "timestamp": "06:35:25", "text": "[音乐]"}, {"type": "subtitle", "time": 23729.35, "timestamp": "06:35:29", "text": "正确的？或者叫阿迪亚之类的。是的。哦，"}, {"type": "subtitle", "time": 23731.19, "timestamp": "06:35:31", "text": "顺便一提，说到这个，Darken"}, {"type": "subtitle", "time": 23733.75, "timestamp": "06:35:33", "text": "《黑暗与黑暗》是免费游戏。"}, {"type": "subtitle", "time": 23737.11, "timestamp": "06:35:37", "text": "他们于6月6日发布了它。那是"}, {"type": "subtitle", "time": 23740.75, "timestamp": "06:35:40", "text": "就像我迟到了7天一样。第六天"}, {"type": "subtitle", "time": 23743.59, "timestamp": "06:35:43", "text": "周四。他们于6号发布了。我"}, {"type": "subtitle", "time": 23745.99, "timestamp": "06:35:45", "text": "我之前完全不知道。我正在查看Epic"}, {"type": "subtitle", "time": 23748.59, "timestamp": "06:35:48", "text": "最近玩了一些游戏，我看到了。我当时就想，"}, {"type": "subtitle", "time": 23751.27, "timestamp": "06:35:51", "text": "“嗯？什么时候发布的？”"}, {"type": "subtitle", "time": 23753.83, "timestamp": "06:35:53", "text": "是吗？我以为我以为我以为他们"}, {"type": "subtitle", "time": 23757.75, "timestamp": "06:35:57", "text": "他们停止在Steam上发布内容了。"}]
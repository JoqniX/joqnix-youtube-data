[{"type": "subtitle", "time": 3960.23, "timestamp": "01:06:00", "text": "在选择器中匹配。我想知道"}, {"type": "subtitle", "time": 3963.43, "timestamp": "01:06:03", "text": "如何使用组件"}, {"type": "subtitle", "time": 3978.88, "timestamp": "01:06:18", "text": "但组件告诉我"}, {"type": "subtitle", "time": 3986.63, "timestamp": "01:06:26", "text": "组件创造和利用差异。"}, {"type": "subtitle", "time": 3989.109, "timestamp": "01:06:29", "text": "对，就是这个。"}, {"type": "subtitle", "time": 3991.589, "timestamp": "01:06:31", "text": "当您创建单个组件或"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "建立公司的设计系统，"}, {"type": "subtitle", "time": 3995.67, "timestamp": "01:06:35", "text": "你会发现对类似事物的需求，但"}, {"type": "chat", "time": 3998.065, "timestamp": "01:06:38", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "😮😮"}, {"type": "subtitle", "time": 3998.15, "timestamp": "01:06:38", "text": "不同的组成部分。在设计时"}, {"type": "subtitle", "time": 4000.309, "timestamp": "01:06:40", "text": "表单中，您将使用组件进行输入。"}, {"type": "subtitle", "time": 4002.789, "timestamp": "01:06:42", "text": "字段和按钮。或许还有一台收音机"}, {"type": "subtitle", "time": 4005.829, "timestamp": "01:06:45", "text": "按钮或复选框。输入字段可以"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "仅接受文本或下拉菜单"}, {"type": "subtitle", "time": 4010.87, "timestamp": "01:06:50", "text": "或者日期选择器。他们可能有一个蓝色"}, {"type": "subtitle", "time": 4013.19, "timestamp": "01:06:53", "text": "聚焦时边框描边会变成"}, {"type": "subtitle", "time": 4015.75, "timestamp": "01:06:55", "text": "当值无效时，显示红色。复选框"}, {"type": "subtitle", "time": 4017.99, "timestamp": "01:06:57", "text": "可以是未选中、已选中、主要"}, {"type": "subtitle", "time": 4019.91, "timestamp": "01:06:59", "text": "按钮。按钮的数量可以"}]
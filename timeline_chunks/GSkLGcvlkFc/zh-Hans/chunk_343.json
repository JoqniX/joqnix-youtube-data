[{"type": "subtitle", "time": 20581.19, "timestamp": "05:43:01", "text": "正确的？有些房子不允许你住。"}, {"type": "subtitle", "time": 20582.51, "timestamp": "05:43:02", "text": "到"}, {"type": "subtitle", "time": 20586.31, "timestamp": "05:43:06", "text": "嗯，或者他们允许你养宠物。"}, {"type": "subtitle", "time": 20588.868, "timestamp": "05:43:08", "text": "里面，里面，因为它们会到处拉屎。"}, {"type": "subtitle", "time": 20592.628, "timestamp": "05:43:12", "text": "等等，所有那些东西，对吧？是的。它"}, {"type": "subtitle", "time": 20594.99, "timestamp": "05:43:14", "text": "清理起来会很麻烦。"}, {"type": "subtitle", "time": 20598.23, "timestamp": "05:43:18", "text": "等等。所以有些人对过敏或"}, {"type": "subtitle", "time": 20601.948, "timestamp": "05:43:21", "text": "某物。我不知道。这取决于。所以"}, {"type": "subtitle", "time": 20605.51, "timestamp": "05:43:25", "text": "是啊，我希望我也有"}, {"type": "subtitle", "time": 20609.27, "timestamp": "05:43:29", "text": "嗯，我希望我能，我希望我能像那样……"}, {"type": "subtitle", "time": 20611.99, "timestamp": "05:43:31", "text": "就像你知道的，和猫一起睡觉一样"}, {"type": "subtitle", "time": 20614.27, "timestamp": "05:43:34", "text": "而且真的"}, {"type": "subtitle", "time": 20617.548, "timestamp": "05:43:37", "text": "嗯……它叫什么？"}, {"type": "subtitle", "time": 20621.708, "timestamp": "05:43:41", "text": "嗯，承担责任，而且实际上"}, {"type": "subtitle", "time": 20624.868, "timestamp": "05:43:44", "text": "嗯……和猫一起生活，而且喜欢你"}, {"type": "subtitle", "time": 20627.67, "timestamp": "05:43:47", "text": "知道一起睡觉，也喜欢抚摸它们"}, {"type": "subtitle", "time": 20632.07, "timestamp": "05:43:52", "text": "时间。呃，让我的舒适圈小一点吧"}, {"type": "subtitle", "time": 20635.67, "timestamp": "05:43:55", "text": "那个一直给我带来舒适感的生物"}, {"type": "subtitle", "time": 20638.83, "timestamp": "05:43:58", "text": "抚摸它，感受它的温暖等等。"}]
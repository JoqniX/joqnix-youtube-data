[{"type": "subtitle", "time": 5041.95, "timestamp": "01:24:01", "text": "多组件编辑并说点什么"}, {"type": "subtitle", "time": 5044.629, "timestamp": "01:24:04", "text": "不同的。你看，它改变了一切。"}, {"type": "subtitle", "time": 5046.87, "timestamp": "01:24:06", "text": "同时存在多个实例。所以文本组件"}, {"type": "subtitle", "time": 5048.95, "timestamp": "01:24:08", "text": "属性非常强大。此外，"}, {"type": "subtitle", "time": 5050.47, "timestamp": "01:24:10", "text": "这个例子显然很容易理解。"}, {"type": "subtitle", "time": 5051.91, "timestamp": "01:24:11", "text": "找到文本。我只需要加倍。"}, {"type": "subtitle", "time": 5054.07, "timestamp": "01:24:14", "text": "点击。但如果情况非常，你知道，"}, {"type": "subtitle", "time": 5055.91, "timestamp": "01:24:15", "text": "包含嵌套、嵌套的大型组件"}, {"type": "subtitle", "time": 5057.83, "timestamp": "01:24:17", "text": "嵌套，嵌套在里面，到达文本"}, {"type": "subtitle", "time": 5059.59, "timestamp": "01:24:19", "text": "有时候真的很烦人。所以"}, {"type": "subtitle", "time": 5061.11, "timestamp": "01:24:21", "text": "能够随意更改它"}, {"type": "subtitle", "time": 5063.35, "timestamp": "01:24:23", "text": "设计小组的意见令人惊叹。我们开始吧"}, {"type": "subtitle", "time": 5065.189, "timestamp": "01:24:25", "text": "再来看第二种类型的组件"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "属性，该属性为布尔值。布尔值。"}, {"type": "subtitle", "time": 5069.43, "timestamp": "01:24:29", "text": "布尔值就是真和假。"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "情况。这就是布尔值的全部意义。它是"}, {"type": "subtitle", "time": 5073.91, "timestamp": "01:24:33", "text": "一个意思很怪的词，基本上就是“真的”。"}, {"type": "subtitle", "time": 5076.39, "timestamp": "01:24:36", "text": "或者错误。所以我要进行布尔运算。"}, {"type": "subtitle", "time": 5077.83, "timestamp": "01:24:37", "text": "以一种略微不同的方式看待房产。"}, {"type": "subtitle", "time": 5079.35, "timestamp": "01:24:39", "text": "创建组件有两种方法"}, {"type": "subtitle", "time": 5081.59, "timestamp": "01:24:41", "text": "财产。你可以选择一个元素，"}, {"type": "subtitle", "time": 5083.11, "timestamp": "01:24:43", "text": "然后从中创建一个组件属性"}, {"type": "subtitle", "time": 5084.55, "timestamp": "01:24:44", "text": "它。或者您可以创建组件"}, {"type": "subtitle", "time": 5086.55, "timestamp": "01:24:46", "text": "属性，然后将其分配给"}, {"type": "subtitle", "time": 5088.95, "timestamp": "01:24:48", "text": "元素。在我们选择文本框之前"}, {"type": "subtitle", "time": 5090.95, "timestamp": "01:24:50", "text": "并添加了一个组件属性，现在我是"}, {"type": "subtitle", "time": 5092.629, "timestamp": "01:24:52", "text": "直接选择组件，开始"}, {"type": "subtitle", "time": 5094.79, "timestamp": "01:24:54", "text": "在属性中添加一个布尔值"}, {"type": "subtitle", "time": 5098.629, "timestamp": "01:24:58", "text": "属性和图标。然后你会发现它有一个"}]
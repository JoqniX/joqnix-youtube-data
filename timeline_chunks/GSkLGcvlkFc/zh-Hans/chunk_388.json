[{"type": "subtitle", "time": 23281.628, "timestamp": "06:28:01", "text": "向上，对吧？ Bean Max 之类的。豆"}, {"type": "subtitle", "time": 23286.11, "timestamp": "06:28:06", "text": "豆。我忘了它的名字。"}, {"type": "subtitle", "time": 23289.67, "timestamp": "06:28:09", "text": "呃，我居然真的忘了名字。"}, {"type": "subtitle", "time": 23290.69, "timestamp": "06:28:10", "text": "呃"}, {"type": "subtitle", "time": 23293.11, "timestamp": "06:28:13", "text": "[音乐]"}, {"type": "subtitle", "time": 23296.75, "timestamp": "06:28:16", "text": "呃，豆子杀手。对，就是那个。豆"}, {"type": "subtitle", "time": 23300.628, "timestamp": "06:28:20", "text": "杀手。我看到了。当时的感觉就像，哇，真是太棒了。"}, {"type": "subtitle", "time": 23308.67, "timestamp": "06:28:28", "text": "它给我的感觉就是这样。"}, {"type": "subtitle", "time": 23311.868, "timestamp": "06:28:31", "text": "嗯，它给了我"}, {"type": "subtitle", "time": 23314.708, "timestamp": "06:28:34", "text": "嗯……它叫什么来着？它给了我"}, {"type": "subtitle", "time": 23315.52, "timestamp": "06:28:35", "text": "氛围"}, {"type": "subtitle", "time": 23317.31, "timestamp": "06:28:37", "text": "[音乐]"}, {"type": "subtitle", "time": 23320.59, "timestamp": "06:28:40", "text": "嗯，我忘了你知道的。"}, {"type": "subtitle", "time": 23325.59, "timestamp": "06:28:45", "text": "呃，那个墨西哥主题的游戏"}, {"type": "subtitle", "time": 23327.83, "timestamp": "06:28:47", "text": "一款有慢动作的游戏"}, {"type": "subtitle", "time": 23331.23, "timestamp": "06:28:51", "text": "东西。你就像……"}, {"type": "subtitle", "time": 23334.07, "timestamp": "06:28:54", "text": "呃，这个游戏叫什么名字？我"}, {"type": "subtitle", "time": 23337.788, "timestamp": "06:28:57", "text": "忘了。那就像一个老古董"}]
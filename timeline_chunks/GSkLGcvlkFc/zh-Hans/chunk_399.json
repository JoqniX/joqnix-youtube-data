[{"type": "subtitle", "time": 23940.75, "timestamp": "06:39:00", "text": "《骑士精神2》？是的，我确实买了DLC。"}, {"type": "subtitle", "time": 23943.99, "timestamp": "06:39:03", "text": "内容、国王版和"}, {"type": "subtitle", "time": 23947.59, "timestamp": "06:39:07", "text": "特别版结束。我得到了酷"}, {"type": "subtitle", "time": 23955.19, "timestamp": "06:39:15", "text": "因为有个报价还不错，60%"}, {"type": "subtitle", "time": 23958.31, "timestamp": "06:39:18", "text": "来自 Epic Games。所以我花了95美元买下了它。"}, {"type": "subtitle", "time": 23961.99, "timestamp": "06:39:21", "text": "两者均为卢比。所以一个大概两个"}, {"type": "subtitle", "time": 23965.628, "timestamp": "06:39:25", "text": "200 我猜 眨眼"}, {"type": "subtitle", "time": 23970.91, "timestamp": "06:39:30", "text": "呃，也谢谢你。我迫不及待地想体验中世纪生活。"}, {"type": "subtitle", "time": 23975.59, "timestamp": "06:39:35", "text": "模式斩击敌人，用我的盾牌防御"}, {"type": "subtitle", "time": 23981.628, "timestamp": "06:39:41", "text": "然后向前冲锋，就像那样"}, {"type": "subtitle", "time": 23987.11, "timestamp": "06:39:47", "text": "在小屋里捅一刀，呃，就像什么肉饼"}, {"type": "subtitle", "time": 23990.788, "timestamp": "06:39:50", "text": "穿着我的锁子甲，我不知道，嗯"}, {"type": "subtitle", "time": 23993.67, "timestamp": "06:39:53", "text": "也许我能弄到那把弓，你知道，就是那把弓。"}, {"type": "subtitle", "time": 23997.75, "timestamp": "06:39:57", "text": "然后瞄准，轰！攻击！"}]
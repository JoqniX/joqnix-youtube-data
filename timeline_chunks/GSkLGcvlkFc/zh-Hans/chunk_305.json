[{"type": "subtitle", "time": 18302.67, "timestamp": "05:05:02", "text": "排行榜。我们只需要"}, {"type": "subtitle", "time": 18305.75, "timestamp": "05:05:05", "text": "手动，非手动"}, {"type": "subtitle", "time": 18308.788, "timestamp": "05:05:08", "text": "自动、动态地编辑谁"}, {"type": "subtitle", "time": 18310.788, "timestamp": "05:05:10", "text": "看的人，没看的人，谁在看"}, {"type": "subtitle", "time": 18313.07, "timestamp": "05:05:13", "text": "活跃的，不活跃的"}, {"type": "subtitle", "time": 18316.708, "timestamp": "05:05:16", "text": "积极的。正确的？排行榜部分"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "这边有人来的时候，他们"}, {"type": "subtitle", "time": 18321.99, "timestamp": "05:05:21", "text": "排行榜状态，你可以聊天"}, {"type": "subtitle", "time": 18324.47, "timestamp": "05:05:24", "text": "一。如果有两个人在场，就会聊天"}, {"type": "subtitle", "time": 18328.31, "timestamp": "05:05:28", "text": "二。所以，我必须指出一点："}, {"type": "subtitle", "time": 18331.788, "timestamp": "05:05:31", "text": "我该如何应对这里的聊天者呢？"}, {"type": "subtitle", "time": 18333.868, "timestamp": "05:05:33", "text": "排行榜。就是这样。"}, {"type": "subtitle", "time": 18347.788, "timestamp": "05:05:47", "text": "排名赛事"}, {"type": "subtitle", "time": 18356.59, "timestamp": "05:05:56", "text": "准备在线排名更新。对，这个"}]
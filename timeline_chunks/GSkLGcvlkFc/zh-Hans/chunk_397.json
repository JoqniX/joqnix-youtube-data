[{"type": "subtitle", "time": 23821.75, "timestamp": "06:37:01", "text": "是的，我其实没料到我会"}, {"type": "subtitle", "time": 23824.628, "timestamp": "06:37:04", "text": "嗯，聊聊这个游戏吧。"}, {"type": "subtitle", "time": 23831.35, "timestamp": "06:37:11", "text": "过量服用，我说的是TP（可能是指某种药物或药品）"}, {"type": "subtitle", "time": 23833.35, "timestamp": "06:37:13", "text": "某物。显然，这不是卫生纸。它是"}, {"type": "subtitle", "time": 23841.15, "timestamp": "06:37:21", "text": "过量。没关系。但"}, {"type": "subtitle", "time": 23845.03, "timestamp": "06:37:25", "text": "是的，达尔，我不知道你们是不是"}, {"type": "subtitle", "time": 23847.91, "timestamp": "06:37:27", "text": "记住。我曾经看过一次。我们曾"}, {"type": "subtitle", "time": 23850.99, "timestamp": "06:37:30", "text": "与……的即兴合作"}, {"type": "subtitle", "time": 23853.868, "timestamp": "06:37:33", "text": "塞诺斯和"}, {"type": "subtitle", "time": 23857.39, "timestamp": "06:37:37", "text": "当时的莫森和阿库。"}, {"type": "subtitle", "time": 23861.03, "timestamp": "06:37:41", "text": "是的。是的。 Sen 和 Aku 正在直播。"}, {"type": "subtitle", "time": 23863.868, "timestamp": "06:37:43", "text": "Areu正在直播。还是森？我"}, {"type": "subtitle", "time": 23867.03, "timestamp": "06:37:47", "text": "忘了。然后他们看到我正在直播。"}, {"type": "subtitle", "time": 23869.628, "timestamp": "06:37:49", "text": "蒸汽。就像他们从……看到了那东西"}, {"type": "subtitle", "time": 23872.15, "timestamp": "06:37:52", "text": "蒸汽。他们来看我的直播。我当时"}, {"type": "subtitle", "time": 23873.83, "timestamp": "06:37:53", "text": "例如，“想一起加入吗？想……”"}, {"type": "subtitle", "time": 23877.43, "timestamp": "06:37:57", "text": "“要不要开派对？”然后我们就大获全胜。"}]
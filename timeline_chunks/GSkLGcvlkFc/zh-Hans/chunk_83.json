[{"type": "subtitle", "time": 4980.149, "timestamp": "01:23:00", "text": "我们的按钮可以申请房产，或者也可以申请房产。"}, {"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "多变的。如果我点击它，我现在需要"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "添加新的文本属性。所以我点击"}, {"type": "subtitle", "time": 4986.629, "timestamp": "01:23:06", "text": "往好的方面想，我确保自己……"}, {"type": "subtitle", "time": 4988.39, "timestamp": "01:23:08", "text": "创建的是属性而不是变量。"}, {"type": "subtitle", "time": 4990.79, "timestamp": "01:23:10", "text": "它的名字，我们暂且称之为标签。和"}, {"type": "subtitle", "time": 4992.709, "timestamp": "01:23:12", "text": "它的价值就在于它接受任何……"}, {"type": "subtitle", "time": 4994.55, "timestamp": "01:23:14", "text": "此文本框中输入的内容。上面是这么说的"}, {"type": "subtitle", "time": 4995.99, "timestamp": "01:23:15", "text": "标签，所以它只是个标签。我要走了"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "创建它。既然我已经做到了，"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "你看，我们有一条紫色的线。"}, {"type": "subtitle", "time": 5000.55, "timestamp": "01:23:20", "text": "如果我选择“是”，那就是我们"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "之前见过。是的。那么，这意味着什么呢？"}, {"type": "subtitle", "time": 5006.95, "timestamp": "01:23:26", "text": "当我选择顶部的实例时。"}, {"type": "subtitle", "time": 5009.11, "timestamp": "01:23:29", "text": "在设计面板中，我现在拥有"}, {"type": "subtitle", "time": 5011.59, "timestamp": "01:23:31", "text": "能够从……更改文本"}, {"type": "subtitle", "time": 5014.149, "timestamp": "01:23:34", "text": "设计面板。所以，我可以把它从"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "那里。你会看到它发生了变化。"}, {"type": "subtitle", "time": 5018.07, "timestamp": "01:23:38", "text": "实际组件。而不是我拥有"}, {"type": "subtitle", "time": 5020.47, "timestamp": "01:23:40", "text": "双击内部即可更改"}, {"type": "subtitle", "time": 5023.11, "timestamp": "01:23:43", "text": "从这里，我可以选择我的"}, {"type": "subtitle", "time": 5024.87, "timestamp": "01:23:44", "text": "组件并在设计中进行更改"}, {"type": "subtitle", "time": 5026.79, "timestamp": "01:23:46", "text": "控制板。还有一件事，真的"}, {"type": "subtitle", "time": 5028.47, "timestamp": "01:23:48", "text": "文本组件功能强大"}, {"type": "subtitle", "time": 5030.07, "timestamp": "01:23:50", "text": "属性是您可以更改多个"}, {"type": "subtitle", "time": 5032.39, "timestamp": "01:23:52", "text": "同时存在多个实例。所以我只是"}, {"type": "subtitle", "time": 5034.229, "timestamp": "01:23:54", "text": "打算复制这个实例几次。"}, {"type": "subtitle", "time": 5036.87, "timestamp": "01:23:56", "text": "多次，然后当我全部选中它们时"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "我可以进入设计面板。哦"}]
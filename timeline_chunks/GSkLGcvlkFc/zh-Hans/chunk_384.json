[{"type": "subtitle", "time": 23040.47, "timestamp": "06:24:00", "text": "某物。对，就是那个模糊的东西。"}, {"type": "subtitle", "time": 23044.868, "timestamp": "06:24:04", "text": "就像加了些模糊滤镜，嗯，是的。"}, {"type": "subtitle", "time": 23047.27, "timestamp": "06:24:07", "text": "就像那种字面意义上的吹气过滤器一样"}, {"type": "subtitle", "time": 23049.99, "timestamp": "06:24:09", "text": "呃，一些东西。这就是我目前的情况"}, {"type": "subtitle", "time": 23052.11, "timestamp": "06:24:12", "text": "感觉就像当我脱掉我的"}, {"type": "subtitle", "time": 23064.83, "timestamp": "06:24:24", "text": "嗨，我是"}, {"type": "subtitle", "time": 23067.51, "timestamp": "06:24:27", "text": "后退。他很强壮。等等，什么？让我"}, {"type": "subtitle", "time": 23067.9, "timestamp": "06:24:27", "text": "读"}, {"type": "subtitle", "time": 23069.15, "timestamp": "06:24:29", "text": "[音乐]"}, {"type": "subtitle", "time": 23072.31, "timestamp": "06:24:32", "text": "它。呃，有一次也出现了"}, {"type": "subtitle", "time": 23074.948, "timestamp": "06:24:34", "text": "史前穴居人释放并"}, {"type": "subtitle", "time": 23078.39, "timestamp": "06:24:38", "text": "进入现代社会后，就不得不"}, {"type": "subtitle", "time": 23081.43, "timestamp": "06:24:41", "text": "与他战斗。哇。"}, {"type": "subtitle", "time": 23084.27, "timestamp": "06:24:44", "text": "我说雾蒙蒙的"}, {"type": "subtitle", "time": 23086.43, "timestamp": "06:24:46", "text": "巴卡·福吉"}, {"type": "subtitle", "time": 23090.75, "timestamp": "06:24:50", "text": "模糊的，是的，就像"}, {"type": "subtitle", "time": 23094.628, "timestamp": "06:24:54", "text": "那我该怎么弄？它好像有点模糊，好吧。"}, {"type": "subtitle", "time": 23097.548, "timestamp": "06:24:57", "text": "我的视野里什么都是"}]
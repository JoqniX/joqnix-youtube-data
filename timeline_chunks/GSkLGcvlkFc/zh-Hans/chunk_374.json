[{"type": "subtitle", "time": 22442.15, "timestamp": "06:14:02", "text": "男。是的，那也是真的"}, {"type": "subtitle", "time": 22443.9, "timestamp": "06:14:03", "text": "凉爽的。由"}, {"type": "subtitle", "time": 22459.75, "timestamp": "06:14:19", "text": "我来告诉你巴基的一件事。好的。"}, {"type": "subtitle", "time": 22462.08, "timestamp": "06:14:22", "text": "娜妮。"}, {"type": "subtitle", "time": 22464.99, "timestamp": "06:14:24", "text": "[音乐]"}, {"type": "subtitle", "time": 22468.548, "timestamp": "06:14:28", "text": "娜妮。已经过了很久了。我很好。"}, {"type": "subtitle", "time": 22471.59, "timestamp": "06:14:31", "text": "你好吗？我很好。是的，就是这样。"}, {"type": "subtitle", "time": 22473.47, "timestamp": "06:14:33", "text": "已经很久了"}, {"type": "subtitle", "time": 22476.948, "timestamp": "06:14:36", "text": "的确。最近怎么样？希望你"}, {"type": "subtitle", "time": 22483.47, "timestamp": "06:14:43", "text": "现在。希望你一切都好。"}, {"type": "subtitle", "time": 22486.868, "timestamp": "06:14:46", "text": "东西。祝新婚快乐。什么？我没有"}, {"type": "subtitle", "time": 22490.19, "timestamp": "06:14:50", "text": "说出来。哦。我的天啊。这"}, {"type": "subtitle", "time": 22494.31, "timestamp": "06:14:54", "text": "翻译，我讨厌它。"}, {"type": "subtitle", "time": 22496.11, "timestamp": "06:14:56", "text": "我需要学习"}]
[{"type": "subtitle", "time": 21663.07, "timestamp": "06:01:03", "text": "像有说服力的人，或者像某人"}, {"type": "subtitle", "time": 21667.99, "timestamp": "06:01:07", "text": "那些只想占便宜的人"}, {"type": "subtitle", "time": 21669.99, "timestamp": "06:01:09", "text": "占你便宜之类的，"}, {"type": "subtitle", "time": 21673.91, "timestamp": "06:01:13", "text": "正确的？所以，这也很难。我该怎么做"}, {"type": "subtitle", "time": 21676.47, "timestamp": "06:01:16", "text": "它？"}, {"type": "subtitle", "time": 21679.51, "timestamp": "06:01:19", "text": "所以主要的，还有那些东西很难。"}, {"type": "subtitle", "time": 21681.51, "timestamp": "06:01:21", "text": "尽管。我总是处于被动的一方。"}, {"type": "subtitle", "time": 21684.07, "timestamp": "06:01:24", "text": "就像有人向我寻求帮助一样。"}, {"type": "subtitle", "time": 21686.07, "timestamp": "06:01:26", "text": "所以我没想那么多。所以，我"}, {"type": "subtitle", "time": 21688.788, "timestamp": "06:01:28", "text": "就当是普通的对话吧。但是当"}, {"type": "subtitle", "time": 21692.75, "timestamp": "06:01:32", "text": "我尝试在接近对方时这样做。"}, {"type": "subtitle", "time": 21696.708, "timestamp": "06:01:36", "text": "需要人帮忙吗？为什么？"}, {"type": "subtitle", "time": 21700.11, "timestamp": "06:01:40", "text": "这么难吗？然后我问"}, {"type": "subtitle", "time": 21704.99, "timestamp": "06:01:44", "text": "我自己是怎么做的？其他人又是怎么做的？"}, {"type": "subtitle", "time": 21706.548, "timestamp": "06:01:46", "text": "[音乐]"}, {"type": "subtitle", "time": 21709.27, "timestamp": "06:01:49", "text": "是的，艺术，整个概念"}, {"type": "subtitle", "time": 21711.628, "timestamp": "06:01:51", "text": "沟通是"}, {"type": "subtitle", "time": 21713.788, "timestamp": "06:01:53", "text": "如此复杂"}, {"type": "subtitle", "time": 21716.35, "timestamp": "06:01:56", "text": "难以形容"}, {"type": "subtitle", "time": 21719.708, "timestamp": "06:01:59", "text": "呃，对于像他这样的人来说很难理解。"}]
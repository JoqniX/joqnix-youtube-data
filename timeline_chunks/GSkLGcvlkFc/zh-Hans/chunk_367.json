[{"type": "subtitle", "time": 22020.83, "timestamp": "06:07:00", "text": "好的。就像那种感觉"}, {"type": "subtitle", "time": 22027.11, "timestamp": "06:07:07", "text": "长版本比较随意。"}, {"type": "subtitle", "time": 22041.75, "timestamp": "06:07:21", "text": "是的。我学到的其中一件事"}, {"type": "subtitle", "time": 22046.99, "timestamp": "06:07:26", "text": "随着时间的推移，上网会……"}, {"type": "subtitle", "time": 22050.23, "timestamp": "06:07:30", "text": "嗯，现实生活中没人会教你这些。好的，"}, {"type": "subtitle", "time": 22052.39, "timestamp": "06:07:32", "text": "让我来告诉你。没有人教你。"}, {"type": "subtitle", "time": 22054.31, "timestamp": "06:07:34", "text": "他们只是希望你知道这些。"}, {"type": "subtitle", "time": 22057.19, "timestamp": "06:07:37", "text": "无处可去。我当时就想，我身边没有一个人可以依靠。"}, {"type": "subtitle", "time": 22058.868, "timestamp": "06:07:38", "text": "告诉我这件事，所以我不得不弄明白。"}, {"type": "subtitle", "time": 22061.27, "timestamp": "06:07:41", "text": "我。我想至少对我而言是这样的。"}, {"type": "subtitle", "time": 22063.39, "timestamp": "06:07:43", "text": "喜欢"}, {"type": "subtitle", "time": 22067.43, "timestamp": "06:07:47", "text": "嗯，就像……如果你知道的话"}, {"type": "subtitle", "time": 22069.15, "timestamp": "06:07:49", "text": "人更多"}, {"type": "subtitle", "time": 22072.91, "timestamp": "06:07:52", "text": "没错，然后回到那种类型"}, {"type": "subtitle", "time": 22075.31, "timestamp": "06:07:55", "text": "东西"}, {"type": "subtitle", "time": 22079.19, "timestamp": "06:07:59", "text": "就像友谊之类的东西"}]
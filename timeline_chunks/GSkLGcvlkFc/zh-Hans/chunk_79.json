[{"type": "subtitle", "time": 4741.59, "timestamp": "01:19:01", "text": "从资产面板中取出，只是为了向您展示。"}, {"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "既然我已经给了它，那现在又发生了什么呢？"}, {"type": "subtitle", "time": 4745.35, "timestamp": "01:19:05", "text": "进步的这种特性以及那些"}, {"type": "subtitle", "time": 4748.55, "timestamp": "01:19:08", "text": "我有一个下拉菜单，里面列出了需要的值。所以，我作为一个"}, {"type": "subtitle", "time": 4750.39, "timestamp": "01:19:10", "text": "我可以选择我想要的哪一个。做"}, {"type": "subtitle", "time": 4751.99, "timestamp": "01:19:11", "text": "我想要100？我想要25吗？我该怎么做？"}, {"type": "subtitle", "time": 4753.83, "timestamp": "01:19:13", "text": "想要那50个吗？显然，我们还没完。"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "然而，这就是方差的运作方式。所以"}, {"type": "subtitle", "time": 4761.27, "timestamp": "01:19:21", "text": "所以每个州的其中两个是25"}, {"type": "subtitle", "time": 4764.07, "timestamp": "01:19:24", "text": "等等。你怎么知道哪个是哪个呢？"}, {"type": "subtitle", "time": 4766.149, "timestamp": "01:19:26", "text": "为此，我想再添加一个"}, {"type": "subtitle", "time": 4767.59, "timestamp": "01:19:27", "text": "财产。所以在选择我的"}, {"type": "subtitle", "time": 4769.669, "timestamp": "01:19:29", "text": "我将要进入的组件集"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "在此处创建属性并创建一个新的"}, {"type": "subtitle", "time": 4773.59, "timestamp": "01:19:33", "text": "组件属性。这将是一个"}, {"type": "subtitle", "time": 4775.43, "timestamp": "01:19:35", "text": "变体。所以这处房产将会是"}, {"type": "subtitle", "time": 4777.27, "timestamp": "01:19:37", "text": "关于是否有文字，还是没有文字。"}, {"type": "subtitle", "time": 4778.95, "timestamp": "01:19:38", "text": "所以我就把它叫做文本吧。而对于"}, {"type": "subtitle", "time": 4781.03, "timestamp": "01:19:41", "text": "这里我将使用真和假。所以"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "我会选择所有这些，然后我会说"}, {"type": "subtitle", "time": 4787.43, "timestamp": "01:19:47", "text": "真的。我会选择所有这些。"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "我会说是假的。首先我可以看到"}, {"type": "subtitle", "time": 4791.27, "timestamp": "01:19:51", "text": "我已经没有警告了"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "因为 Figma 现在很开心。它有"}, {"type": "subtitle", "time": 4794.229, "timestamp": "01:19:54", "text": "有足够的信息来区分"}, {"type": "subtitle", "time": 4795.83, "timestamp": "01:19:55", "text": "不同变体之间。我只是"}, {"type": "subtitle", "time": 4798.07, "timestamp": "01:19:58", "text": "我注意到这个问题，所以打算修复它。"}]
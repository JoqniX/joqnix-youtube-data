[{"type": "subtitle", "time": 24666.23, "timestamp": "06:51:06", "text": "重启。我没有切换到测试版。"}, {"type": "subtitle", "time": 24670.628, "timestamp": "06:51:10", "text": "为我的主要设置而构建。"}, {"type": "subtitle", "time": 24672.99, "timestamp": "06:51:12", "text": "我没把它带到呃呃主会场。"}, {"type": "subtitle", "time": 24675.83, "timestamp": "06:51:15", "text": "虽然是用于生产，但我呃，我把它用在我的……"}, {"type": "subtitle", "time": 24677.31, "timestamp": "06:51:17", "text": "直播游戏"}, {"type": "subtitle", "time": 24681.628, "timestamp": "06:51:21", "text": "我用PC直播，因为我现在得用它直播。"}, {"type": "subtitle", "time": 24685.51, "timestamp": "06:51:25", "text": "我的游戏电脑上运行着OBS。"}, {"type": "subtitle", "time": 24688.43, "timestamp": "06:51:28", "text": "不是用 OBS 直播，而是保留 OBS"}, {"type": "subtitle", "time": 24693.03, "timestamp": "06:51:33", "text": "开放，以便那边的数据可以进入。"}, {"type": "subtitle", "time": 24694.67, "timestamp": "06:51:34", "text": "这"}, {"type": "subtitle", "time": 24698.03, "timestamp": "06:51:38", "text": "个人电脑。是的，它没有显示。"}, {"type": "subtitle", "time": 24701.99, "timestamp": "06:51:41", "text": "向上。笨蛋大笨蛋，你为什么不"}, {"type": "subtitle", "time": 24704.548, "timestamp": "06:51:44", "text": "在职的？我需要关掉我的"}, {"type": "subtitle", "time": 24706.27, "timestamp": "06:51:46", "text": "溪流？"}, {"type": "subtitle", "time": 24710.11, "timestamp": "06:51:50", "text": "为什么？这是一个短篇小说"}, {"type": "subtitle", "time": 24714.948, "timestamp": "06:51:54", "text": "桌面。等等，快点。到场。"}, {"type": "subtitle", "time": 24717.75, "timestamp": "06:51:57", "text": "我当时觉得一切都很好。"}]
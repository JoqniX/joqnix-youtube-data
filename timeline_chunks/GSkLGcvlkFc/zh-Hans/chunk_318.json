[{"type": "subtitle", "time": 19083.03, "timestamp": "05:18:03", "text": "所以我今天晚上睡到很晚才醒。"}, {"type": "subtitle", "time": 19084.99, "timestamp": "05:18:04", "text": "就像晚上不再那样"}, {"type": "subtitle", "time": 19086.91, "timestamp": "05:18:06", "text": "喜欢"}, {"type": "subtitle", "time": 19090.11, "timestamp": "05:18:10", "text": "下午左右。嗯，大概下午左右。"}, {"type": "subtitle", "time": 19093.708, "timestamp": "05:18:13", "text": "但我又开始睡着了。"}, {"type": "subtitle", "time": 19097.788, "timestamp": "05:18:17", "text": "更多的。是的。所以，那件事就有点……嗯……"}, {"type": "subtitle", "time": 19101.27, "timestamp": "05:18:21", "text": "那件事让我有点迟到了。"}, {"type": "subtitle", "time": 19103.708, "timestamp": "05:18:23", "text": "把配音演员和所有东西都上传给比利"}, {"type": "subtitle", "time": 19106.628, "timestamp": "05:18:26", "text": "比利还有我需要做的所有那些事"}, {"type": "subtitle", "time": 19109.03, "timestamp": "05:18:29", "text": "当天。所以，是的，有点……"}, {"type": "subtitle", "time": 19118.03, "timestamp": "05:18:38", "text": "它。好的。"}, {"type": "subtitle", "time": 19121.35, "timestamp": "05:18:41", "text": "嗯，昨天我们谈到了……"}, {"type": "subtitle", "time": 19123.59, "timestamp": "05:18:43", "text": "粉红色的践踏。呃，等等。我该怎么做？"}, {"type": "subtitle", "time": 19126.27, "timestamp": "05:18:46", "text": "再念一遍？"}, {"type": "subtitle", "time": 19131.03, "timestamp": "05:18:51", "text": "嗯，长号。长号。是的。"}, {"type": "subtitle", "time": 19132.55, "timestamp": "05:18:52", "text": "所以，"}, {"type": "subtitle", "time": 19135.19, "timestamp": "05:18:55", "text": "嗯，我们会对此进行试验。"}, {"type": "subtitle", "time": 19138.15, "timestamp": "05:18:58", "text": "叮咚一声，长号那玩意儿。是的。是的。出色地"}]
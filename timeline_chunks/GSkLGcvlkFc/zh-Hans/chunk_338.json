[{"type": "subtitle", "time": 20280.708, "timestamp": "05:38:00", "text": "周围之类的。是的，就像"}, {"type": "subtitle", "time": 20282.788, "timestamp": "05:38:02", "text": "是啊，太酷了。不，我希望我的"}, {"type": "subtitle", "time": 20286.23, "timestamp": "05:38:06", "text": "猫也会这样做。哦，我的猫不想"}, {"type": "subtitle", "time": 20289.31, "timestamp": "05:38:09", "text": "让我抚摸她。"}, {"type": "subtitle", "time": 20292.47, "timestamp": "05:38:12", "text": "为什么？我的猫不想让我抚摸它。"}, {"type": "subtitle", "time": 20295.43, "timestamp": "05:38:15", "text": "她。她却逃走了。最近，"}, {"type": "subtitle", "time": 20298.15, "timestamp": "05:38:18", "text": "它生下了三个小家伙"}, {"type": "subtitle", "time": 20301.43, "timestamp": "05:38:21", "text": "小猫。它就在我的床底下。"}, {"type": "subtitle", "time": 20305.35, "timestamp": "05:38:25", "text": "她在那里……呃……就像在玩小猫咪游戏"}, {"type": "subtitle", "time": 20309.43, "timestamp": "05:38:29", "text": "还有一些其他的东西，嗯，是的。所以我不能"}, {"type": "subtitle", "time": 20312.35, "timestamp": "05:38:32", "text": "连我都不敢下去看一眼。"}, {"type": "subtitle", "time": 20315.03, "timestamp": "05:38:35", "text": "因为一旦它知道我"}, {"type": "subtitle", "time": 20318.07, "timestamp": "05:38:38", "text": "我或我的家人都看过它。"}, {"type": "subtitle", "time": 20321.27, "timestamp": "05:38:41", "text": "看了看，它会尝试改变"}, {"type": "subtitle", "time": 20323.75, "timestamp": "05:38:43", "text": "地点。如果你不知道的话，当一只猫"}, {"type": "subtitle", "time": 20327.43, "timestamp": "05:38:47", "text": "生孩子或者类似的事情，嗯，生孩子"}, {"type": "subtitle", "time": 20330.15, "timestamp": "05:38:50", "text": "比如喜欢小猫之类的，呃，他们会尝试。"}, {"type": "subtitle", "time": 20333.548, "timestamp": "05:38:53", "text": "改变位置"}, {"type": "subtitle", "time": 20337.628, "timestamp": "05:38:57", "text": "它的位置像七次或"}]
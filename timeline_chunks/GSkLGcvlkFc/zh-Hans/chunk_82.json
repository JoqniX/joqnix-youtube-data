[{"type": "subtitle", "time": 4920.39, "timestamp": "01:22:00", "text": "你会看到，在这个相框里，我有"}, {"type": "subtitle", "time": 4921.99, "timestamp": "01:22:01", "text": "很多不同的组成部分"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "不同的图标。现在如果我选择一个"}, {"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "例如，我可以点击这里的下拉菜单。"}, {"type": "subtitle", "time": 4928.55, "timestamp": "01:22:08", "text": "顶部告诉我的是"}, {"type": "subtitle", "time": 4930.47, "timestamp": "01:22:10", "text": "一颗心的例子。如果我看一下这个"}, {"type": "subtitle", "time": 4931.83, "timestamp": "01:22:11", "text": "下拉菜单我可以把它改成别的什么。"}, {"type": "subtitle", "time": 4933.79, "timestamp": "01:22:13", "text": "否则，比如说我其实希望它是一个"}, {"type": "subtitle", "time": 4936.39, "timestamp": "01:22:16", "text": "铃铛删除按钮。是的。所以就"}, {"type": "subtitle", "time": 4939.35, "timestamp": "01:22:19", "text": "兄弟，你得注意一下。现在我们开始吧"}, {"type": "subtitle", "time": 4941.75, "timestamp": "01:22:21", "text": "将其制作成组件并开始"}, {"type": "subtitle", "time": 4943.91, "timestamp": "01:22:23", "text": "查看组件属性。所以我已经"}, {"type": "subtitle", "time": 4945.75, "timestamp": "01:22:25", "text": "点击我的按钮，然后就有很多人"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "组件部分。哦，我的大脑"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "立刻行动，因为我希望我们"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "看看组件如何变化。"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "特性。给我们的标题加个小标题吧。"}, {"type": "subtitle", "time": 4956.39, "timestamp": "01:22:36", "text": "举例来说，这样我们就知道这是"}, {"type": "subtitle", "time": 4958.07, "timestamp": "01:22:38", "text": "是实例，而不是主组件。"}, {"type": "subtitle", "time": 4959.669, "timestamp": "01:22:39", "text": "所以我现在想添加一个组件"}, {"type": "subtitle", "time": 4961.03, "timestamp": "01:22:41", "text": "财产。有三种类型"}, {"type": "subtitle", "time": 4962.709, "timestamp": "01:22:42", "text": "组件属性。第一个我"}, {"type": "subtitle", "time": 4964.79, "timestamp": "01:22:44", "text": "你想让我们看的是文本。那么，我们开始吧"}, {"type": "subtitle", "time": 4966.47, "timestamp": "01:22:46", "text": "选择我们文本框内的"}, {"type": "subtitle", "time": 4967.83, "timestamp": "01:22:47", "text": "成分。你马上就会看到"}, {"type": "subtitle", "time": 4969.669, "timestamp": "01:22:49", "text": "这里出现了一个新兴领域。"}, {"type": "subtitle", "time": 4971.11, "timestamp": "01:22:51", "text": "我们通常得不到的顶峰"}, {"type": "subtitle", "time": 4973.27, "timestamp": "01:22:53", "text": "选中一个文本框。如果我将鼠标悬停在"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "右边，会有一颗钻石"}, {"type": "subtitle", "time": 4977.03, "timestamp": "01:22:57", "text": "里面好像有一根棍子。那是"}]
[{"type": "subtitle", "time": 19320.868, "timestamp": "05:22:00", "text": "它。所以，这就是我的直播总结，对吧？为了"}, {"type": "subtitle", "time": 19323.59, "timestamp": "05:22:03", "text": "那些不了解的人，我们每条溪流"}, {"type": "subtitle", "time": 19326.47, "timestamp": "05:22:06", "text": "确实如此，我为那些没能跟上的人解释一下。"}, {"type": "subtitle", "time": 19328.948, "timestamp": "05:22:08", "text": "它，或者那些错过它的人等等。"}, {"type": "subtitle", "time": 19331.83, "timestamp": "05:22:11", "text": "他们只是想……就像他们只是想……"}, {"type": "subtitle", "time": 19335.51, "timestamp": "05:22:15", "text": "他们好像只是想知道……"}, {"type": "subtitle", "time": 19339.11, "timestamp": "05:22:19", "text": "到底发生了什么事等等。"}, {"type": "subtitle", "time": 19340.91, "timestamp": "05:22:20", "text": "像写摘要一样写"}, {"type": "subtitle", "time": 19343.83, "timestamp": "05:22:23", "text": "就是个小总结。"}, {"type": "subtitle", "time": 19346.23, "timestamp": "05:22:26", "text": "好的。如果我想，我可以美化"}, {"type": "subtitle", "time": 19348.83, "timestamp": "05:22:28", "text": "让它对Discord用户来说更美观一些。"}, {"type": "subtitle", "time": 19351.67, "timestamp": "05:22:31", "text": "人们。是的，它就像一个短篇小说"}, {"type": "subtitle", "time": 19354.55, "timestamp": "05:22:34", "text": "概括。所以现在我成功了。"}, {"type": "subtitle", "time": 19356.39, "timestamp": "05:22:36", "text": "现在有了新的格式，但就此而言"}, {"type": "subtitle", "time": 19358.948, "timestamp": "05:22:38", "text": "我制作了这个系统，因为我要发布我的"}, {"type": "subtitle", "time": 19364.15, "timestamp": "05:22:44", "text": "Q 上也有相关内容。呃，我做了，我会是"}, {"type": "subtitle", "time": 19366.31, "timestamp": "05:22:46", "text": "呃，保留中文翻译"}, {"type": "subtitle", "time": 19368.07, "timestamp": "05:22:48", "text": "那。所以如果你身处其中，你就可以……"}, {"type": "subtitle", "time": 19369.91, "timestamp": "05:22:49", "text": "如果你是中国人，你可以使用Discord。"}, {"type": "subtitle", "time": 19372.788, "timestamp": "05:22:52", "text": "点击中文翻译按钮"}, {"type": "subtitle", "time": 19374.47, "timestamp": "05:22:54", "text": "您将获得翻译"}, {"type": "subtitle", "time": 19376.67, "timestamp": "05:22:56", "text": "嵌入内容的翻译。"}]
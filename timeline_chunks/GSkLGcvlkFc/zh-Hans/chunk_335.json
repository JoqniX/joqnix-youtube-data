[{"type": "subtitle", "time": 20102.31, "timestamp": "05:35:02", "text": "嗯，就像某种活动之类的。是的。"}, {"type": "subtitle", "time": 20104.708, "timestamp": "05:35:04", "text": "将来我确实想以某种方式实现"}, {"type": "subtitle", "time": 20108.548, "timestamp": "05:35:08", "text": "这样不仅对我而言，对所有人来说都是如此。"}, {"type": "subtitle", "time": 20111.868, "timestamp": "05:35:11", "text": "我的OnXia角色，你可以像"}, {"type": "subtitle", "time": 20117.03, "timestamp": "05:35:17", "text": "实时数据流之类的东西。但"}, {"type": "subtitle", "time": 20119.11, "timestamp": "05:35:19", "text": "是啊，这个角色在干什么？"}, {"type": "subtitle", "time": 20120.948, "timestamp": "05:35:20", "text": "那一刻？他在哪里？什么是"}, {"type": "subtitle", "time": 20123.03, "timestamp": "05:35:23", "text": "他在做什么？她这是在做什么？善良"}, {"type": "subtitle", "time": 20125.51, "timestamp": "05:35:25", "text": "那个东西。挺酷的。现在"}, {"type": "subtitle", "time": 20127.83, "timestamp": "05:35:27", "text": "让你画故事板之类的"}, {"type": "subtitle", "time": 20132.628, "timestamp": "05:35:32", "text": "提出一些理论。哦，我为什么……我为什么……"}, {"type": "subtitle", "time": 20135.83, "timestamp": "05:35:35", "text": "Jo 去某某地方"}, {"type": "subtitle", "time": 20138.23, "timestamp": "05:35:38", "text": "具体时间？为什么会这样"}, {"type": "subtitle", "time": 20140.708, "timestamp": "05:35:40", "text": "一年中的特定时间，尤其"}, {"type": "subtitle", "time": 20144.15, "timestamp": "05:35:44", "text": "就是这一天，具体日期？他为什么？"}, {"type": "subtitle", "time": 20147.35, "timestamp": "05:35:47", "text": "这个东西上写着他简直……"}, {"type": "subtitle", "time": 20149.67, "timestamp": "05:35:49", "text": "在山洞之类的地方吗？然后你试试"}, {"type": "subtitle", "time": 20152.868, "timestamp": "05:35:52", "text": "编造一些理论，比如“哦，会怎么样？”"}, {"type": "subtitle", "time": 20155.35, "timestamp": "05:35:55", "text": "身处洞穴之中，会是什么感觉？"}, {"type": "subtitle", "time": 20157.39, "timestamp": "05:35:57", "text": "一切"}]
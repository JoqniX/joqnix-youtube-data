[{"type": "subtitle", "time": 1221.19, "timestamp": "00:20:21", "text": "因为我开了空调，所以我开始……"}, {"type": "subtitle", "time": 1223.07, "timestamp": "00:20:23", "text": "打喷嚏"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "所有免费游戏都已被领取。"}, {"type": "subtitle", "time": 1241.669, "timestamp": "00:20:41", "text": "好的。还有什么呢？我当时有什么？"}, {"type": "subtitle", "time": 1254.549, "timestamp": "00:20:54", "text": "音乐。我知道。我知道。为什么我听不见"}, {"type": "subtitle", "time": 1256.75, "timestamp": "00:20:56", "text": "它？"}, {"type": "chat", "time": 1258.809, "timestamp": "00:20:58", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "horror when?"}]
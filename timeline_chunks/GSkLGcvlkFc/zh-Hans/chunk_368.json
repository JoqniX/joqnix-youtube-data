[{"type": "subtitle", "time": 22081.788, "timestamp": "06:08:01", "text": "熟人"}, {"type": "subtitle", "time": 22085.67, "timestamp": "06:08:05", "text": "我碰巧认识这个人。"}, {"type": "subtitle", "time": 22089.43, "timestamp": "06:08:09", "text": "等等等等，或者更奇怪的是，属于这一类。没错。"}, {"type": "subtitle", "time": 22092.91, "timestamp": "06:08:12", "text": "是的。是的。是的。就像有……"}, {"type": "subtitle", "time": 22097.708, "timestamp": "06:08:17", "text": "嗯，这个系统，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 22101.83, "timestamp": "06:08:21", "text": "对某些人来说，他们可以看到"}, {"type": "subtitle", "time": 22103.91, "timestamp": "06:08:23", "text": "把对方当作朋友一样看待"}, {"type": "subtitle", "time": 22106.31, "timestamp": "06:08:26", "text": "我想大概一两个月或者三个月吧。"}, {"type": "subtitle", "time": 22108.948, "timestamp": "06:08:28", "text": "取决于众多的"}, {"type": "subtitle", "time": 22113.11, "timestamp": "06:08:33", "text": "互动。所以对话结束了吗？"}, {"type": "subtitle", "time": 22115.91, "timestamp": "06:08:35", "text": "就像有些人一样，他们只看到别人"}, {"type": "subtitle", "time": 22119.99, "timestamp": "06:08:39", "text": "认识他们之后，我把他们当成了朋友。"}, {"type": "subtitle", "time": 22122.07, "timestamp": "06:08:42", "text": "了解他们的为人等等，并获得"}, {"type": "subtitle", "time": 22125.43, "timestamp": "06:08:45", "text": "用了好几年了等等。"}, {"type": "subtitle", "time": 22128.31, "timestamp": "06:08:48", "text": "然后把他们视为朋友或"}, {"type": "subtitle", "time": 22137.99, "timestamp": "06:08:57", "text": "是的，我可是吃过苦头才明白的，因为我"}]
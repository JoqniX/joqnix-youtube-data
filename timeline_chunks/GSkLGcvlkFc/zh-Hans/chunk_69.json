[{"type": "subtitle", "time": 4142.07, "timestamp": "01:09:02", "text": "改变了。所以我们将使用未选中的键。"}, {"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "变体。我们的默认状态"}, {"type": "subtitle", "time": 4146.91, "timestamp": "01:09:06", "text": "复选框。所以我们将它重新命名为"}, {"type": "subtitle", "time": 4149.03, "timestamp": "01:09:09", "text": "复选框/未选中。组件集可以"}, {"type": "subtitle", "time": 4150.87, "timestamp": "01:09:10", "text": "只能由组件构成。所以"}, {"type": "subtitle", "time": 4152.47, "timestamp": "01:09:12", "text": "我们将使用键盘快捷键"}, {"type": "subtitle", "time": 4154.87, "timestamp": "01:09:14", "text": "使用命令选项 K 将其转换为"}, {"type": "subtitle", "time": 4157.03, "timestamp": "01:09:17", "text": "成分。在右侧边栏中，"}, {"type": "subtitle", "time": 4159.87, "timestamp": "01:09:19", "text": "新增了一个版块，用于"}, {"type": "subtitle", "time": 4163.54, "timestamp": "01:09:23", "text": "变体。我觉得我略懂一些。"}, {"type": "subtitle", "time": 4165.87, "timestamp": "01:09:25", "text": "[音乐]"}]
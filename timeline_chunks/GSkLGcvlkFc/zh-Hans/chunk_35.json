[{"type": "subtitle", "time": 2125.79, "timestamp": "00:35:25", "text": "好吧，我掸去了不少灰尘"}, {"type": "subtitle", "time": 2148.51, "timestamp": "00:35:48", "text": "另外，我忘了带我的"}, {"type": "subtitle", "time": 2151.79, "timestamp": "00:35:51", "text": "维生素。请提醒我。"}, {"type": "subtitle", "time": 2156.349, "timestamp": "00:35:56", "text": "好的，银牌。所以，我拿起我的"}]
[{"type": "subtitle", "time": 1320.31, "timestamp": "00:22:00", "text": "触摸他们就会得到。是的。是的。是的。"}, {"type": "subtitle", "time": 1322.31, "timestamp": "00:22:02", "text": "他们会想知道发生了什么事。"}, {"type": "subtitle", "time": 1325.19, "timestamp": "00:22:05", "text": "还有其他一些东西。这就是为什么我感觉自己像在……"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "早上好，等等。这有点麻烦"}, {"type": "subtitle", "time": 1329.149, "timestamp": "00:22:09", "text": "让我"}, {"type": "subtitle", "time": 1338.07, "timestamp": "00:22:18", "text": "早上之类的。不，因为"}, {"type": "subtitle", "time": 1339.789, "timestamp": "00:22:19", "text": "人民是"}, {"type": "subtitle", "time": 1343.31, "timestamp": "00:22:23", "text": "与他们律师合作"}, {"type": "subtitle", "time": 1345.549, "timestamp": "00:22:25", "text": "等等。什么？"}, {"type": "subtitle", "time": 1348.63, "timestamp": "00:22:28", "text": "并非因为律师有很多……"}, {"type": "subtitle", "time": 1351.149, "timestamp": "00:22:31", "text": "书籍之类的东西，"}, {"type": "chat", "time": 1351.856, "timestamp": "00:22:31", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "don't they go to court? or is it their chamber?"}, {"type": "subtitle", "time": 1362.149, "timestamp": "00:22:42", "text": "疯狂的。是那个房间吗？我认为是"}, {"type": "subtitle", "time": 1363.549, "timestamp": "00:22:43", "text": "一个房间。"}, {"type": "subtitle", "time": 1366.47, "timestamp": "00:22:46", "text": "是的。呃，法院。我认为其中一个"}, {"type": "subtitle", "time": 1367.99, "timestamp": "00:22:47", "text": "律师们去了，有些律师是"}, {"type": "subtitle", "time": 1370.95, "timestamp": "00:22:50", "text": "留在这里做其他事。他们是"}, {"type": "subtitle", "time": 1373.75, "timestamp": "00:22:53", "text": "仍在移动。不，已经完成一半了。这"}, {"type": "chat", "time": 1379.866, "timestamp": "00:22:59", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message":
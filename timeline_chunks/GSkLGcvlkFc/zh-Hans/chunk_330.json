[{"type": "subtitle", "time": 19802.56, "timestamp": "05:30:02", "text": "嗯？等等，什么？为什么会这样？"}, {"type": "subtitle", "time": 19803.788, "timestamp": "05:30:03", "text": "[音乐]"}, {"type": "subtitle", "time": 19806.38, "timestamp": "05:30:06", "text": "等待。说"}, {"type": "subtitle", "time": 19808.59, "timestamp": "05:30:08", "text": "[音乐]"}, {"type": "subtitle", "time": 19812.47, "timestamp": "05:30:12", "text": "哦，我其实是第四集。"}, {"type": "subtitle", "time": 19815.23, "timestamp": "05:30:15", "text": "显然不是"}, {"type": "subtitle", "time": 19817.99, "timestamp": "05:30:17", "text": "五。而目前的情况是……"}, {"type": "subtitle", "time": 19820.59, "timestamp": "05:30:20", "text": "在第 1 集中"}, {"type": "subtitle", "time": 19825.51, "timestamp": "05:30:25", "text": "9. 所以上帝啊，我最近看了很多东西。我不是"}, {"type": "subtitle", "time": 19828.35, "timestamp": "05:30:28", "text": "有时间观看"}, {"type": "subtitle", "time": 19831.67, "timestamp": "05:30:31", "text": "日本动画片。之前我好像还有个借口。"}, {"type": "subtitle", "time": 19833.67, "timestamp": "05:30:33", "text": "连续播放12小时。嗯？但"}, {"type": "subtitle", "time": 19835.83, "timestamp": "05:30:35", "text": "现在，呃，即使我不直播。"}, {"type": "subtitle", "time": 19839.35, "timestamp": "05:30:39", "text": "整整12个小时，我几乎都坐在电脑前。"}, {"type": "subtitle", "time": 19842.548, "timestamp": "05:30:42", "text": "从早到晚，午夜，我"}, {"type": "subtitle", "time": 19846.19, "timestamp": "05:30:46", "text": "猜猜，就像为直播做些事情一样。"}, {"type": "subtitle", "time": 19850.43, "timestamp": "05:30:50", "text": "东西。更像是我呃……在做"}, {"type": "subtitle", "time": 19853.35, "timestamp": "05:30:53", "text": "比如确保一切运转良好"}, {"type": "subtitle", "time": 19855.27, "timestamp": "05:30:55", "text": "以及所有的一切。以便你知道"}, {"type": "subtitle", "time": 19858.628, "timestamp": "05:30:58", "text": "最近最后三场直播我觉得是两场。"}]
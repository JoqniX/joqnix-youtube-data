[{"type": "subtitle", "time": 20401.75, "timestamp": "05:40:01", "text": "在。嗯，是的。所以，是的，我不，我不"}, {"type": "subtitle", "time": 20403.51, "timestamp": "05:40:03", "text": "做好记录。所以我不知道是哪个。"}, {"type": "subtitle", "time": 20406.03, "timestamp": "05:40:06", "text": "是哪个，哪个是"}, {"type": "subtitle", "time": 20409.83, "timestamp": "05:40:09", "text": "因为他们都喜欢到处闲逛"}, {"type": "subtitle", "time": 20413.19, "timestamp": "05:40:13", "text": "来来去去。他们喜欢这样"}, {"type": "subtitle", "time": 20416.548, "timestamp": "05:40:16", "text": "它们只来觅食，然后就四处游荡。"}, {"type": "subtitle", "time": 20419.27, "timestamp": "05:40:19", "text": "附近及周边地区"}, {"type": "subtitle", "time": 20421.59, "timestamp": "05:40:21", "text": "有时晚上会来"}, {"type": "subtitle", "time": 20423.99, "timestamp": "05:40:23", "text": "不是在夜深人静的时候发生的。"}, {"type": "subtitle", "time": 20427.15, "timestamp": "05:40:27", "text": "我当时就想，"}, {"type": "subtitle", "time": 20430.75, "timestamp": "05:40:30", "text": "哇，你为什么这样做"}, {"type": "subtitle", "time": 20439.19, "timestamp": "05:40:39", "text": "还有吗？”所以，是的。你们都吃完了吗？"}, {"type": "subtitle", "time": 20442.708, "timestamp": "05:40:42", "text": "晚餐之类的？就像……你……"}, {"type": "subtitle", "time": 20446.31, "timestamp": "05:40:46", "text": "你们都吃完晚饭了吗？就像……夜晚"}, {"type": "subtitle", "time": 20447.39, "timestamp": "05:40:47", "text": "时间，"}, {"type": "subtitle", "time": 20455.59, "timestamp": "05:40:55", "text": "说实话。现在，每当我"}, {"type": "subtitle", "time": 20459.35, "timestamp": "05:40:59", "text": "直播到6点以后，我只有一小会儿"}]
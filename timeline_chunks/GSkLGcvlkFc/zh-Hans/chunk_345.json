[{"type": "subtitle", "time": 20706.23, "timestamp": "05:45:06", "text": "为什么？猫吃人，反之亦然。"}, {"type": "subtitle", "time": 20708.47, "timestamp": "05:45:08", "text": "什么？不，我不认为那是真的。"}, {"type": "subtitle", "time": 20712.548, "timestamp": "05:45:12", "text": "什么？不，不，不，不，不，不，不。什么？"}, {"type": "subtitle", "time": 20715.91, "timestamp": "05:45:15", "text": "等待。真的吗？什么？什么？我们真的"}, {"type": "subtitle", "time": 20723.868, "timestamp": "05:45:23", "text": "正确的。全身和脸部都像。"}, {"type": "subtitle", "time": 20727.67, "timestamp": "05:45:27", "text": "不，不，不，我不。等待。等待。真的吗？"}, {"type": "subtitle", "time": 20730.39, "timestamp": "05:45:30", "text": "等待。我好像明白了。我听说过这件事。"}, {"type": "subtitle", "time": 20740.47, "timestamp": "05:45:40", "text": "我为什么要那样对待店主？"}, {"type": "subtitle", "time": 20743.39, "timestamp": "05:45:43", "text": "谁照顾他？"}, {"type": "subtitle", "time": 20747.07, "timestamp": "05:45:47", "text": "东西？情况好转了一些。呃，但这是事实。"}, {"type": "subtitle", "time": 20749.628, "timestamp": "05:45:49", "text": "啊。是的。"}, {"type": "subtitle", "time": 20753.39, "timestamp": "05:45:53", "text": "为什么？真可怕。"}]
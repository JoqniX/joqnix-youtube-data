[{"type": "subtitle", "time": 20521.51, "timestamp": "05:42:01", "text": "我晚上吃点东西，大概5点左右。"}, {"type": "subtitle", "time": 20525.35, "timestamp": "05:42:05", "text": "或者 6，好吧，那样我就无法……"}, {"type": "subtitle", "time": 20529.51, "timestamp": "05:42:09", "text": "晚上想吃任何东西。如果"}, {"type": "subtitle", "time": 20532.07, "timestamp": "05:42:12", "text": "我正在吃晚饭，我得……呃……"}, {"type": "subtitle", "time": 20535.43, "timestamp": "05:42:15", "text": "份量真的很小。极端主义者"}, {"type": "subtitle", "time": 20538.07, "timestamp": "05:42:18", "text": "少量。是的。"}, {"type": "subtitle", "time": 20540.07, "timestamp": "05:42:20", "text": "这是你们之间的一种现象吗？"}, {"type": "subtitle", "time": 20544.27, "timestamp": "05:42:24", "text": "出色地？还有其他人有这个问题吗？"}, {"type": "subtitle", "time": 20547.43, "timestamp": "05:42:27", "text": "问题？有时我会想，我们真的"}, {"type": "subtitle", "time": 20550.15, "timestamp": "05:42:30", "text": "印度人？因为印度球迷说我们已经"}, {"type": "subtitle", "time": 20554.83, "timestamp": "05:42:34", "text": "我们养宠物。嗯？"}, {"type": "subtitle", "time": 20556.83, "timestamp": "05:42:36", "text": "什么？等待，"}, {"type": "subtitle", "time": 20558.51, "timestamp": "05:42:38", "text": "什么？"}, {"type": "subtitle", "time": 20560.948, "timestamp": "05:42:40", "text": "呃，我的意思是，说到印度人……"}, {"type": "subtitle", "time": 20563.35, "timestamp": "05:42:43", "text": "家长们，好像有两个……嗯……东西，"}, {"type": "subtitle", "time": 20567.51, "timestamp": "05:42:47", "text": "正确的？一些模式家族允许"}, {"type": "subtitle", "time": 20568.59, "timestamp": "05:42:48", "text": "你"}, {"type": "subtitle", "time": 20574.868, "timestamp": "05:42:54", "text": "房子，抚摸它，和它一起睡觉"}, {"type": "subtitle", "time": 20578.15, "timestamp": "05:42:58", "text": "它，不管是狗狗、猫咪、仓鼠还是其他什么动物，"}]
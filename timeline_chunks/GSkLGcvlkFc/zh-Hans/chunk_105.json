[{"type": "subtitle", "time": 6335.669, "timestamp": "01:45:35", "text": "等等，不对。这不是我有的那一个。"}, {"type": "subtitle", "time": 6338.229, "timestamp": "01:45:38", "text": "等等，不，不，不，不，不，不，不。那是"}, {"type": "subtitle", "time": 6342.189, "timestamp": "01:45:42", "text": "错误的。等等，睡觉又是另一回事了。"}, {"type": "subtitle", "time": 6345.109, "timestamp": "01:45:45", "text": "正确的？乔卡斯上床睡觉了。那就是"}, {"type": "subtitle", "time": 6347.95, "timestamp": "01:45:47", "text": "睡着的一个人。"}, {"type": "subtitle", "time": 6351.75, "timestamp": "01:45:51", "text": "什么？我什么时候改的？嗯？我是否"}, {"type": "subtitle", "time": 6353.79, "timestamp": "01:45:53", "text": "也撤销它"}, {"type": "subtitle", "time": 6356.43, "timestamp": "01:45:56", "text": "远的？"}]
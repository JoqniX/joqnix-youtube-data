[{"type": "subtitle", "time": 1620.43, "timestamp": "00:27:00", "text": "一旦我进入状态，"}, {"type": "subtitle", "time": 1625.909, "timestamp": "00:27:05", "text": "正确的？我也……我也……我太……投入了。患病的"}, {"type": "subtitle", "time": 1639.07, "timestamp": "00:27:19", "text": "呃"}, {"type": "subtitle", "time": 1648.59, "timestamp": "00:27:28", "text": "电缆发射返回"}, {"type": "subtitle", "time": 1656.83, "timestamp": "00:27:36", "text": "电缆电缆。什么？"}, {"type": "subtitle", "time": 1671.35, "timestamp": "00:27:51", "text": "开始。呃，我想创建一个小组"}, {"type": "subtitle", "time": 1673.19, "timestamp": "00:27:53", "text": "鼠标加速功能正常"}, {"type": "subtitle", "time": 1676.23, "timestamp": "00:27:56", "text": "这也是我把它放在一边的原因之一。"}, {"type": "subtitle", "time": 1679.269, "timestamp": "00:27:59", "text": "原始轴距起步已经放好了，我现在就放上去。"}]
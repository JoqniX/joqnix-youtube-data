[{"type": "subtitle", "time": 22579.39, "timestamp": "06:16:19", "text": "不。我的天哪。我的我的"}, {"type": "subtitle", "time": 22582.99, "timestamp": "06:16:22", "text": "我的天，我在打嗝。"}, {"type": "subtitle", "time": 22584.67, "timestamp": "06:16:24", "text": "很多。"}, {"type": "subtitle", "time": 22588.19, "timestamp": "06:16:28", "text": "嗯，是啊，太酷了！"}, {"type": "subtitle", "time": 22591.15, "timestamp": "06:16:31", "text": "男人。凉爽的。"}, {"type": "subtitle", "time": 22593.83, "timestamp": "06:16:33", "text": "凉爽的。我再给你讲一个场景，但是"}, {"type": "subtitle", "time": 22596.628, "timestamp": "06:16:36", "text": "这是不适宜工作场所观看的内容。哦，不。那就别说。"}, {"type": "subtitle", "time": 22597.47, "timestamp": "06:16:37", "text": "它是"}, {"type": "subtitle", "time": 22600.43, "timestamp": "06:16:40", "text": "好的。那将适合家庭。"}, {"type": "subtitle", "time": 22607.87, "timestamp": "06:16:47", "text": "友好的。"}, {"type": "subtitle", "time": 22612.11, "timestamp": "06:16:52", "text": "[音乐]"}, {"type": "subtitle", "time": 22614.788, "timestamp": "06:16:54", "text": "嗯，等等。呃，我本来想说"}, {"type": "subtitle", "time": 22615.99, "timestamp": "06:16:55", "text": "然后我做了点什么，然后我就"}, {"type": "subtitle", "time": 22618.43, "timestamp": "06:16:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 21000.27, "timestamp": "05:50:00", "text": "等到"}, {"type": "subtitle", "time": 21005.03, "timestamp": "05:50:05", "text": "我的呃……又回来了，在一个东西里。我其实"}, {"type": "subtitle", "time": 21008.07, "timestamp": "05:50:08", "text": "看那支MV的时候哭了。我当时"}, {"type": "subtitle", "time": 21012.548, "timestamp": "05:50:12", "text": "比如，为什么狗狗莫在等什么？"}, {"type": "subtitle", "time": 21015.948, "timestamp": "05:50:15", "text": "年和像"}, {"type": "subtitle", "time": 21019.11, "timestamp": "05:50:19", "text": "几个月？为什么？我的天哪，儿子，你去哪儿了？"}, {"type": "subtitle", "time": 21020.948, "timestamp": "05:50:20", "text": "去？"}, {"type": "subtitle", "time": 21022.628, "timestamp": "05:50:22", "text": "请您回来。最后，他"}, {"type": "subtitle", "time": 21024.788, "timestamp": "05:50:24", "text": "返回。顺便说一下，在结尾"}, {"type": "subtitle", "time": 21028.43, "timestamp": "05:50:28", "text": "音乐录影带，当时我就想，"}, {"type": "subtitle", "time": 21034.51, "timestamp": "05:50:34", "text": "来了。最后，你"}, {"type": "subtitle", "time": 21036.83, "timestamp": "05:50:36", "text": "来了。”但是"}, {"type": "subtitle", "time": 21039.39, "timestamp": "05:50:39", "text": "是的，它也是。"}, {"type": "subtitle", "time": 21042.47, "timestamp": "05:50:42", "text": "哈蒂科。哦，是的。它的名字是八海"}, {"type": "subtitle", "time": 21043.75, "timestamp": "05:50:43", "text": "或者别的什么。 Hatiko 或其他什么名字，"}, {"type": "subtitle", "time": 21046.31, "timestamp": "05:50:46", "text": "正确的？是的。是的。是的。我认为那是"}, {"type": "subtitle", "time": 21049.27, "timestamp": "05:50:49", "text": "那个东西。是的。那只狗狗。是的。感谢"}, {"type": "subtitle", "time": 21052.11, "timestamp": "05:50:52", "text": "你。鼻子。"}, {"type": "subtitle", "time": 21056.03, "timestamp": "05:50:56", "text": "是的。哦，有部电影。哈蒂，一只狗的"}, {"type": "subtitle", "time": 21058.788, "timestamp": "05:50:58", "text": "尾巴。哦，那是一部关于……的英国电影"}]
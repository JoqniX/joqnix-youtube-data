[{"type": "subtitle", "time": 19860.868, "timestamp": "05:31:00", "text": "两条溪流和一条可信的溪流"}, {"type": "subtitle", "time": 19864.39, "timestamp": "05:31:04", "text": "我注意到这里存在一些问题，呃，"}, {"type": "subtitle", "time": 19866.23, "timestamp": "05:31:06", "text": "所以当时我就想确认一下。"}, {"type": "subtitle", "time": 19869.15, "timestamp": "05:31:09", "text": "从未发生过，就像打断一样"}, {"type": "subtitle", "time": 19872.708, "timestamp": "05:31:12", "text": "法律。你觉得第四集怎么样？它"}, {"type": "subtitle", "time": 19876.19, "timestamp": "05:31:16", "text": "很好。我忘了第四集讲的是什么了。"}, {"type": "subtitle", "time": 19880.03, "timestamp": "05:31:20", "text": "嗯，还不错。嗯，这是一个它的"}, {"type": "subtitle", "time": 19882.99, "timestamp": "05:31:22", "text": "关于第三个角色，对吧？这"}, {"type": "subtitle", "time": 19886.07, "timestamp": "05:31:26", "text": "金发，像双马尾之类的"}, {"type": "subtitle", "time": 19888.708, "timestamp": "05:31:28", "text": "短头。嗯，"}, {"type": "subtitle", "time": 19890.868, "timestamp": "05:31:30", "text": "嗯，是的，第三个角色是"}, {"type": "subtitle", "time": 19893.19, "timestamp": "05:31:33", "text": "马上就来，但我还没看过。"}, {"type": "subtitle", "time": 19895.43, "timestamp": "05:31:35", "text": "插曲。我对此感到很兴奋。提醒"}, {"type": "subtitle", "time": 19897.75, "timestamp": "05:31:37", "text": "我是个Shinoco。是的，我确实谈到了"}, {"type": "subtitle", "time": 19899.99, "timestamp": "05:31:39", "text": "当时我正在谈论这件事"}, {"type": "subtitle", "time": 19903.03, "timestamp": "05:31:43", "text": "动漫之类的。呃，是哪个直播流？"}, {"type": "subtitle", "time": 19905.43, "timestamp": "05:31:45", "text": "它？我想是在那个播客里提到的。"}, {"type": "subtitle", "time": 19907.67, "timestamp": "05:31:47", "text": "塔桑。"}, {"type": "subtitle", "time": 19911.83, "timestamp": "05:31:51", "text": "我不知道。是的，沿着……"}, {"type": "subtitle", "time": 19914.628, "timestamp": "05:31:54", "text": "我想，在我开始之前，那些直播节目"}, {"type": "subtitle", "time": 19916.35, "timestamp": "05:31:56", "text": "这阵阵枯萎的浪潮不断碾压着"}, {"type": "subtitle", "time": 19919.83, "timestamp": "05:31:59", "text": "我谈到了所有的事情，包括如何"}]
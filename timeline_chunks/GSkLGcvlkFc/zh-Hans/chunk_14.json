[{"type": "subtitle", "time": 845.629, "timestamp": "00:14:05", "text": "明天。约瑟亚命令"}, {"type": "subtitle", "time": 849.629, "timestamp": "00:14:09", "text": "晚的。不，我爸爸要去。我爸爸是"}, {"type": "subtitle", "time": 860.389, "timestamp": "00:14:20", "text": "所以即使我现在订购，也没用。"}, {"type": "subtitle", "time": 863.509, "timestamp": "00:14:23", "text": "很多。我稍后会问他，然后再做。"}, {"type": "subtitle", "time": 865.829, "timestamp": "00:14:25", "text": "好的，我们可能会被打断。所以，我"}, {"type": "subtitle", "time": 869.31, "timestamp": "00:14:29", "text": "想把迈克的状态设为静音"}, {"type": "chat", "time": 871.918, "timestamp": "00:14:31", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "isn't it better to buy from store then?"}, {"type": "subtitle", "time": 872.15, "timestamp": "00:14:32", "text": "出色地。我们将建立一个国家。不是它"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "不会是那种直接上线的状态。它将"}, {"type": "subtitle", "time": 877.509, "timestamp": "00:14:37", "text": "处于其他状态。而我的"}, {"type": "subtitle", "time": 879.91, "timestamp": "00:14:39", "text": "小部件能正常工作吗？它正在运行。我这就去"}, {"type": "subtitle", "time": 882.03, "timestamp": "00:14:42", "text": "给它一个"}, {"type": "subtitle", "time": 886.15, "timestamp": "00:14:46", "text": "屋顶。这家店东西贵。"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "亲爱的宁，商店很贵的。他们"}, {"type": "chat", "time": 891.518, "timestamp": "00:14:51", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ooh"}, {"type": "subtitle", "time": 893.43, "timestamp": "00:14:53", "text": "他们说充电器要2000或1000，"}]
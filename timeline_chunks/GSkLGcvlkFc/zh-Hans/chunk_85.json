[{"type": "subtitle", "time": 5100.47, "timestamp": "01:25:00", "text": "事物。它显示我没有使用它。现在"}, {"type": "subtitle", "time": 5102.229, "timestamp": "01:25:02", "text": "我将选择接下来要做什么"}, {"type": "subtitle", "time": 5104.87, "timestamp": "01:25:04", "text": "分配给该组件属性。"}, {"type": "subtitle", "time": 5107.75, "timestamp": "01:25:07", "text": "我会选择我的心。然后，在"}, {"type": "subtitle", "time": 5110.709, "timestamp": "01:25:10", "text": "外观部分，我有我的组件"}, {"type": "subtitle", "time": 5113.59, "timestamp": "01:25:13", "text": "属性按钮。点击它，我就会"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "将其分配给图标。现在这是什么布尔运算？"}, {"type": "subtitle", "time": 5118.07, "timestamp": "01:25:18", "text": "属性的作用类似于布尔值。"}, {"type": "subtitle", "time": 5119.99, "timestamp": "01:25:19", "text": "顺便一提，这个变量是控制变量。"}, {"type": "subtitle", "time": 5122.91, "timestamp": "01:25:22", "text": "元素的可见性。"}, {"type": "subtitle", "time": 5125.99, "timestamp": "01:25:25", "text": "我看到我有一个类似于这样的切换开关"}, {"type": "subtitle", "time": 5129.189, "timestamp": "01:25:29", "text": "我们之前有过。如果我哦我的天哪。"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "消失了。它回来了。它消失了。"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "它回来了。它消失了。是的。以便"}, {"type": "subtitle", "time": 5135.99, "timestamp": "01:25:35", "text": "这就是布尔属性的作用。现在"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "您可以将多个设备连接到"}, {"type": "subtitle", "time": 5140.47, "timestamp": "01:25:40", "text": "同一处房产。假设我想"}, {"type": "subtitle", "time": 5143.11, "timestamp": "01:25:43", "text": "启用此切换按钮，即可同时显示文本"}, {"type": "subtitle", "time": 5145.189, "timestamp": "01:25:45", "text": "图标消失了。所以我可以就"}, {"type": "subtitle", "time": 5147.43, "timestamp": "01:25:47", "text": "在外观中选择我的文本框"}, {"type": "subtitle", "time": 5149.99, "timestamp": "01:25:49", "text": "找到该部分，找到按钮，将其连接到"}, {"type": "subtitle", "time": 5151.75, "timestamp": "01:25:51", "text": "图标。现在，让我们来看一个例子。"}, {"type": "subtitle", "time": 5153.59, "timestamp": "01:25:53", "text": "当我切换这个选项时，它们都会"}, {"type": "subtitle", "time": 5155.35, "timestamp": "01:25:55", "text": "消失。在这种情况下，我不是"}, {"type": "subtitle", "time": 5157.43, "timestamp": "01:25:57", "text": "当然是这样，但它仍然是"}, {"type": "subtitle", "time": 5159.43, "timestamp": "01:25:59", "text": "很高兴知道它的存在。我只是"}]
[{"type": "subtitle", "time": 22747.07, "timestamp": "06:19:07", "text": "恭喜你，巴基！"}, {"type": "subtitle", "time": 22750.15, "timestamp": "06:19:10", "text": "猜测。欢迎来到直播间，Akabi。"}, {"type": "subtitle", "time": 22752.548, "timestamp": "06:19:12", "text": "你好。"}, {"type": "subtitle", "time": 22754.67, "timestamp": "06:19:14", "text": "剧情已经出局了。"}, {"type": "subtitle", "time": 22758.23, "timestamp": "06:19:18", "text": "啊，我不想看到新的《阿修罗拳》"}, {"type": "subtitle", "time": 22760.07, "timestamp": "06:19:20", "text": "巴基电影，但我还没看过。"}, {"type": "subtitle", "time": 22763.27, "timestamp": "06:19:23", "text": "阿修罗系列还没完结。哦，我还没看过。"}, {"type": "subtitle", "time": 22765.67, "timestamp": "06:19:25", "text": "这部《Baky》和《Ashira》系列，或者任何其他"}, {"type": "subtitle", "time": 22768.67, "timestamp": "06:19:28", "text": "这些还没有。所以，我对这方面了解不多。"}, {"type": "subtitle", "time": 22772.31, "timestamp": "06:19:32", "text": "这。我只知道烘焙之类的东西。巴基"}, {"type": "subtitle", "time": 22774.99, "timestamp": "06:19:34", "text": "狂战士之类的东西很酷，"}, {"type": "subtitle", "time": 22779.15, "timestamp": "06:19:39", "text": "好的。而且它还有很多"}, {"type": "subtitle", "time": 22782.59, "timestamp": "06:19:42", "text": "深入的背景故事、传说和各种内容"}, {"type": "subtitle", "time": 22785.47, "timestamp": "06:19:45", "text": "它和一些东西。这就是我全部的内容。"}, {"type": "subtitle", "time": 22795.19, "timestamp": "06:19:55", "text": "知道。所以《刃牙》的剧情和漫画的剧情是一致的。"}]
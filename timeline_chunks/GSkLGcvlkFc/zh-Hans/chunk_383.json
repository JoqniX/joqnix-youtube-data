[{"type": "subtitle", "time": 22981.43, "timestamp": "06:23:01", "text": "但我同时也担心如果每个人"}, {"type": "subtitle", "time": 22985.43, "timestamp": "06:23:05", "text": "有足够的时间来参加活动"}, {"type": "subtitle", "time": 22986.59, "timestamp": "06:23:06", "text": "这些"}, {"type": "subtitle", "time": 22991.07, "timestamp": "06:23:11", "text": "东西。这就像一场社交聚会。"}, {"type": "subtitle", "time": 22993.51, "timestamp": "06:23:13", "text": "不。是的。所以我是"}, {"type": "subtitle", "time": 23002.27, "timestamp": "06:23:22", "text": "[音乐]"}, {"type": "subtitle", "time": 23006.27, "timestamp": "06:23:26", "text": "就像我看不见一样。等待。"}, {"type": "subtitle", "time": 23008.11, "timestamp": "06:23:28", "text": "啊，它在哪儿？"}, {"type": "subtitle", "time": 23013.23, "timestamp": "06:23:33", "text": "我汗流浃背。我的脸是"}, {"type": "subtitle", "time": 23016.15, "timestamp": "06:23:36", "text": "出汗。我一直在擦衬衫。"}, {"type": "subtitle", "time": 23018.43, "timestamp": "06:23:38", "text": "所以，我必须移除我的"}, {"type": "subtitle", "time": 23021.43, "timestamp": "06:23:41", "text": "我戴着眼镜，而且当我……的时候，我属于法定盲人。"}, {"type": "subtitle", "time": 23023.91, "timestamp": "06:23:43", "text": "没有眼镜。字面上地，"}, {"type": "subtitle", "time": 23026.39, "timestamp": "06:23:46", "text": "一切都模糊不清。我连字都看不懂。"}, {"type": "subtitle", "time": 23028.708, "timestamp": "06:23:48", "text": "一切都像，你知道，当你"}, {"type": "subtitle", "time": 23033.11, "timestamp": "06:23:53", "text": "透过雾蒙蒙的玻璃观察交通状况"}, {"type": "subtitle", "time": 23035.67, "timestamp": "06:23:55", "text": "像窗户一样的东西，就像……"}, {"type": "subtitle", "time": 23038.03, "timestamp": "06:23:58", "text": "下雨而且有雾"}]
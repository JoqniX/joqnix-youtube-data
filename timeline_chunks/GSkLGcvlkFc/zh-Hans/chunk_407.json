[{"type": "subtitle", "time": 24427.19, "timestamp": "06:47:07", "text": "向上。一切进展顺利。你好。我们走吧。"}, {"type": "subtitle", "time": 24435.11, "timestamp": "06:47:15", "text": "呃，这个怎么发音？哦，"}, {"type": "subtitle", "time": 24447.868, "timestamp": "06:47:27", "text": "眨眼"}, {"type": "subtitle", "time": 24450.788, "timestamp": "06:47:30", "text": "蹦床。好的。呃，如果你……请告诉我"}, {"type": "subtitle", "time": 24451.92, "timestamp": "06:47:31", "text": "能听到。"}, {"type": "subtitle", "time": 24454.11, "timestamp": "06:47:34", "text": "[音乐]"}, {"type": "subtitle", "time": 24458.11, "timestamp": "06:47:38", "text": "呃，哦不，我们遇到麻烦了。"}, {"type": "subtitle", "time": 24460.23, "timestamp": "06:47:40", "text": "我们自己。我的采集卡不是"}, {"type": "subtitle", "time": 24462.868, "timestamp": "06:47:42", "text": "已连接。哦，不。让我下去吧"}, {"type": "subtitle", "time": 24474.15, "timestamp": "06:47:54", "text": "第二。给我一分钟时间。呃，让我来解决这个问题"}]
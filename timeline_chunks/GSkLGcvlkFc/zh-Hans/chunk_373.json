[{"type": "subtitle", "time": 22381.91, "timestamp": "06:13:01", "text": "他自己待了16年，然后我就离开我的"}, {"type": "subtitle", "time": 22383.91, "timestamp": "06:13:03", "text": "儿子，那他以后就得自谋生路了。"}, {"type": "subtitle", "time": 22386.14, "timestamp": "06:13:06", "text": "16年后，我将"}, {"type": "subtitle", "time": 22389.07, "timestamp": "06:13:09", "text": "[笑声]"}, {"type": "subtitle", "time": 22392.948, "timestamp": "06:13:12", "text": "回归尤金·汉马的精神。哦"}, {"type": "subtitle", "time": 22397.19, "timestamp": "06:13:17", "text": "我的上帝。袁汉马是谁？什么？ WHO？"}, {"type": "subtitle", "time": 22408.43, "timestamp": "06:13:28", "text": "[音乐]"}, {"type": "subtitle", "time": 22414.99, "timestamp": "06:13:34", "text": "哟。哦，这个人，"}, {"type": "subtitle", "time": 22419.19, "timestamp": "06:13:39", "text": "来自巴基的红发女郎。你好。你好。你好。"}, {"type": "subtitle", "time": 22420.43, "timestamp": "06:13:40", "text": "一直以来"}, {"type": "subtitle", "time": 22424.708, "timestamp": "06:13:44", "text": "尽管。你好。你好。你好吗？"}, {"type": "subtitle", "time": 22427.03, "timestamp": "06:13:47", "text": "你没见过巴基吗？我还没看过。"}, {"type": "subtitle", "time": 22429.99, "timestamp": "06:13:49", "text": "但我看过一些片段。我见过"}, {"type": "subtitle", "time": 22431.628, "timestamp": "06:13:51", "text": "抖音"}, {"type": "subtitle", "time": 22435.31, "timestamp": "06:13:55", "text": "真正玩cosplay并制作内容的人"}, {"type": "subtitle", "time": 22439.15, "timestamp": "06:13:59", "text": "饰演 范马裕次郎。那"}]
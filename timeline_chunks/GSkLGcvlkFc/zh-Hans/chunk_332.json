[{"type": "subtitle", "time": 19923.51, "timestamp": "05:32:03", "text": "呃，这部动漫真的很好看，而且"}, {"type": "subtitle", "time": 19924.91, "timestamp": "05:32:04", "text": "帮助你"}, {"type": "subtitle", "time": 19927.75, "timestamp": "05:32:07", "text": "想象一下所有挣扎会带来什么后果。"}, {"type": "subtitle", "time": 19930.67, "timestamp": "05:32:10", "text": "这些配音演员会经历……"}, {"type": "subtitle", "time": 19933.35, "timestamp": "05:32:13", "text": "一切。比如，如果你是那种"}, {"type": "subtitle", "time": 19937.27, "timestamp": "05:32:17", "text": "开始启动，还有谁呃"}, {"type": "subtitle", "time": 19939.67, "timestamp": "05:32:19", "text": "想做语音编辑之类的工作，"}, {"type": "subtitle", "time": 19941.868, "timestamp": "05:32:21", "text": "你最终与一家经纪公司签约了"}, {"type": "subtitle", "time": 19943.39, "timestamp": "05:32:23", "text": "东西。"}, {"type": "subtitle", "time": 19947.27, "timestamp": "05:32:27", "text": "嗯，是的，升职……"}, {"type": "subtitle", "time": 19950.15, "timestamp": "05:32:30", "text": "获得新的工作机会很重要。"}, {"type": "subtitle", "time": 19953.59, "timestamp": "05:32:33", "text": "这样你才能成长等等。所以"}, {"type": "subtitle", "time": 19956.15, "timestamp": "05:32:36", "text": "是啊，这感觉挺酷的。"}, {"type": "subtitle", "time": 19958.35, "timestamp": "05:32:38", "text": "看看里面的景色"}, {"type": "subtitle", "time": 19961.83, "timestamp": "05:32:41", "text": "它。是的。"}, {"type": "subtitle", "time": 19965.708, "timestamp": "05:32:45", "text": "请请求计时器。再试一次。"}, {"type": "subtitle", "time": 19969.628, "timestamp": "05:32:49", "text": "我猜我跟踪的次数很多。"}, {"type": "subtitle", "time": 19973.23, "timestamp": "05:32:53", "text": "嗯，跟踪。什么？禁止交谈。啊，"}, {"type": "subtitle", "time": 19975.47, "timestamp": "05:32:55", "text": "翻译。"}, {"type": "subtitle", "time": 19979.67, "timestamp": "05:32:59", "text": "哦，让我试着找找合适的PNG图片。"}]
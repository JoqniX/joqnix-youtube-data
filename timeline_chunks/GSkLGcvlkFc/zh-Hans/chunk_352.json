[{"type": "subtitle", "time": 21121.43, "timestamp": "05:52:01", "text": "呃，对于那些相信的人来说，呃，对于那些"}, {"type": "subtitle", "time": 21124.07, "timestamp": "05:52:04", "text": "在 Q 频道，呃，你可以点赞"}, {"type": "subtitle", "time": 21126.23, "timestamp": "05:52:06", "text": "我会尽量"}, {"type": "subtitle", "time": 21128.788, "timestamp": "05:52:08", "text": "呃，如果可以的话，试着播放一下。"}, {"type": "subtitle", "time": 21130.83, "timestamp": "05:52:10", "text": "允许我这样做。"}, {"type": "subtitle", "time": 21134.39, "timestamp": "05:52:14", "text": "是的，还没测试过流媒体播放情况。"}, {"type": "subtitle", "time": 21137.31, "timestamp": "05:52:17", "text": "还没完工。我测试了一下语音功能。"}, {"type": "subtitle", "time": 21141.59, "timestamp": "05:52:21", "text": "频道，没错。嗯，我需要"}, {"type": "subtitle", "time": 21144.51, "timestamp": "05:52:24", "text": "弄清楚这一点。"}, {"type": "subtitle", "time": 21155.03, "timestamp": "05:52:35", "text": "欢迎光临。很久没有了。你好吗？"}, {"type": "subtitle", "time": 21156.19, "timestamp": "05:52:36", "text": "到过，"}, {"type": "subtitle", "time": 21159.23, "timestamp": "05:52:39", "text": "笨蛋？大家最近怎么样？"}, {"type": "subtitle", "time": 21162.548, "timestamp": "05:52:42", "text": "到过？是啊，最近我一直都是这样。"}, {"type": "subtitle", "time": 21165.27, "timestamp": "05:52:45", "text": "并停止流媒体播放，直到……"}, {"type": "subtitle", "time": 21173.47, "timestamp": "05:52:53", "text": "每个人。啊，打开我的前任。"}, {"type": "subtitle", "time": 21176.19, "timestamp": "05:52:56", "text": "什么？打开我的什么？"}]
[{"type": "subtitle", "time": 20222.39, "timestamp": "05:37:02", "text": "而且我尽量不去诉诸或"}, {"type": "subtitle", "time": 20224.948, "timestamp": "05:37:04", "text": "将我的个人生活融入到我的工作中"}, {"type": "subtitle", "time": 20233.948, "timestamp": "05:37:13", "text": "是的，啊，翻译"}, {"type": "subtitle", "time": 20243.948, "timestamp": "05:37:23", "text": "嗯，但是"}, {"type": "subtitle", "time": 20247.75, "timestamp": "05:37:27", "text": "是的，嗯……如果我的猫跟踪我，我该怎么办？"}, {"type": "subtitle", "time": 20253.91, "timestamp": "05:37:33", "text": "什么？你会怎么办？我的意思是，我看到"}, {"type": "subtitle", "time": 20257.67, "timestamp": "05:37:37", "text": "这是一个很奇怪的视频片段。呃，不是视频片段，不是"}, {"type": "subtitle", "time": 20260.708, "timestamp": "05:37:40", "text": "诡异的。更像是一种有趣的……酷"}, {"type": "subtitle", "time": 20264.19, "timestamp": "05:37:44", "text": "类似YouTube视频中的可爱片段"}, {"type": "subtitle", "time": 20268.548, "timestamp": "05:37:48", "text": "镜头。嗯，就是那个人说的，呃，"}, {"type": "subtitle", "time": 20270.868, "timestamp": "05:37:50", "text": "我的猫好像出问题了。"}, {"type": "subtitle", "time": 20274.948, "timestamp": "05:37:54", "text": "东西坏了。它总是……不"}, {"type": "subtitle", "time": 20277.19, "timestamp": "05:37:57", "text": "放开我。它总是跟着我"}]
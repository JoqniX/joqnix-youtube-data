[{"type": "subtitle", "time": 24900.35, "timestamp": "06:55:00", "text": "那。三、二、一。我向你们介绍"}, {"type": "subtitle", "time": 24902.948, "timestamp": "06:55:02", "text": "粉色"}, {"type": "subtitle", "time": 24904.99, "timestamp": "06:55:04", "text": "嗯"}, {"type": "subtitle", "time": 24911.868, "timestamp": "06:55:11", "text": "呃，长号，呃，又名，我叫它，呃，粉红色的，呃"}, {"type": "subtitle", "time": 24913.868, "timestamp": "06:55:13", "text": "蹦床。"}, {"type": "subtitle", "time": 24916.39, "timestamp": "06:55:16", "text": "是的。等等，什么？为什么是和什么有关？"}, {"type": "subtitle", "time": 24919.788, "timestamp": "06:55:19", "text": "翻译后加上#标签"}, {"type": "subtitle", "time": 24923.27, "timestamp": "06:55:23", "text": "削减？嗯？我没有说脏话。什么？什么"}, {"type": "subtitle", "time": 24925.548, "timestamp": "06:55:25", "text": "你有什么问题吗？"}, {"type": "subtitle", "time": 24934.628, "timestamp": "06:55:34", "text": "不是F11吧？好的。您好，这里是"}, {"type": "subtitle", "time": 24939.31, "timestamp": "06:55:39", "text": "Ping Tramp，我的意思是呃，音调之类的。"}, {"type": "subtitle", "time": 24942.868, "timestamp": "06:55:42", "text": "是的。所以，这款游戏实际上是关于……"}, {"type": "subtitle", "time": 24947.31, "timestamp": "06:55:47", "text": "你在调制声音。什么声音可以"}, {"type": "subtitle", "time": 24951.23, "timestamp": "06:55:51", "text": "人类声带如何运作？"}, {"type": "subtitle", "time": 24954.548, "timestamp": "06:55:54", "text": "是啊，挺有意思的，不是吗？呃"}, {"type": "subtitle", "time": 24959.39, "timestamp": "06:55:59", "text": "是的。所以，如果我左键点击你……"}]
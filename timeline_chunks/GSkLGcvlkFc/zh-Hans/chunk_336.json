[{"type": "subtitle", "time": 20160.31, "timestamp": "05:36:00", "text": "就像那样，所以我想要"}, {"type": "subtitle", "time": 20162.15, "timestamp": "05:36:02", "text": "正是因为有了那段经历，我才……"}, {"type": "subtitle", "time": 20166.07, "timestamp": "05:36:06", "text": "推广长筒袜之类的东西，呃，就像呃……"}, {"type": "subtitle", "time": 20169.03, "timestamp": "05:36:09", "text": "目前我只知道什么什么"}, {"type": "subtitle", "time": 20172.39, "timestamp": "05:36:12", "text": "我听的音乐是什么？运动员的音乐是什么？"}, {"type": "subtitle", "time": 20174.47, "timestamp": "05:36:14", "text": "他们用尽了一切，所以你可以"}, {"type": "subtitle", "time": 20176.868, "timestamp": "05:36:16", "text": "直接从上届FM查一下就知道了。"}, {"type": "subtitle", "time": 20179.67, "timestamp": "05:36:19", "text": "也是一首带有感叹号的歌曲。能"}, {"type": "subtitle", "time": 20182.868, "timestamp": "05:36:22", "text": "仔细检查一下，看看你能不能输入它。"}, {"type": "subtitle", "time": 20185.91, "timestamp": "05:36:25", "text": "YouTube 或 Twitch 聊天中的感叹号"}, {"type": "subtitle", "time": 20188.39, "timestamp": "05:36:28", "text": "歌曲也是。真的可以看到是哪首歌"}, {"type": "subtitle", "time": 20190.23, "timestamp": "05:36:30", "text": "我现在正在听这个"}, {"type": "subtitle", "time": 20192.83, "timestamp": "05:36:32", "text": "二听"}, {"type": "subtitle", "time": 20196.47, "timestamp": "05:36:36", "text": "嗯，还有，像一些小事，比如"}, {"type": "subtitle", "time": 20199.19, "timestamp": "05:36:39", "text": "因为我……想给……"}, {"type": "subtitle", "time": 20201.75, "timestamp": "05:36:41", "text": "经验或其他什么，我不知道，但是"}, {"type": "subtitle", "time": 20205.83, "timestamp": "05:36:45", "text": "嗯，总的来说，跟踪骚扰是不好的。"}, {"type": "subtitle", "time": 20207.91, "timestamp": "05:36:47", "text": "呃，说话就像你知道的那种"}, {"type": "subtitle", "time": 20211.51, "timestamp": "05:36:51", "text": "过度深究某人的……"}, {"type": "subtitle", "time": 20215.11, "timestamp": "05:36:55", "text": "个人信息或任何不好的东西"}, {"type": "subtitle", "time": 20218.27, "timestamp": "05:36:58", "text": "那太糟糕了。"}]
[{"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "如果每个按钮都有一个按钮，气球就会迅速膨胀。"}, {"type": "subtitle", "time": 4024.63, "timestamp": "01:07:04", "text": "没有图标的选项。当用于"}, {"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "平板电脑或手机，我们也可能需要"}, {"type": "subtitle", "time": 4029.349, "timestamp": "01:07:09", "text": "我们的按钮有中号和小号两种版本。"}, {"type": "subtitle", "time": 4031.27, "timestamp": "01:07:11", "text": "我们可以立即将组件数量翻倍。"}, {"type": "subtitle", "time": 4033.99, "timestamp": "01:07:13", "text": "通过添加深色模式。如果没有变体，"}, {"type": "subtitle", "time": 4035.75, "timestamp": "01:07:15", "text": "找到你需要的确切按钮可能"}, {"type": "subtitle", "time": 4037.829, "timestamp": "01:07:17", "text": "真麻烦。所有这些按钮都是"}, {"type": "subtitle", "time": 4039.75, "timestamp": "01:07:19", "text": "虽然不同，但我们也可以这样认为。"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "作为单个孔的一部分，一个组件"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "放。而且无需搜索"}, {"type": "subtitle", "time": 4047.029, "timestamp": "01:07:27", "text": "通过几十个按钮，我们都可以"}, {"type": "subtitle", "time": 4049.43, "timestamp": "01:07:29", "text": "组件和点击合并变体"}, {"type": "subtitle", "time": 4051.19, "timestamp": "01:07:31", "text": "在属性面板中立即"}, {"type": "subtitle", "time": 4052.95, "timestamp": "01:07:32", "text": "将它们转换为单个组件"}, {"type": "subtitle", "time": 4055.27, "timestamp": "01:07:35", "text": "放。只需重命名标签即可"}, {"type": "subtitle", "time": 4056.87, "timestamp": "01:07:36", "text": "拥有各种属性，你就可以……"}, {"type": "subtitle", "time": 4059.19, "timestamp": "01:07:39", "text": "去。如果你属于一支职业球队"}, {"type": "subtitle", "time": 4061.589, "timestamp": "01:07:41", "text": "或者，您也可以创建一个 Figma 组织。"}, {"type": "subtitle", "time": 4063.349, "timestamp": "01:07:43", "text": "将您的组件集发布给团队"}, {"type": "subtitle", "time": 4065.589, "timestamp": "01:07:45", "text": "图书馆。这可以显著降低"}, {"type": "subtitle", "time": 4067.349, "timestamp": "01:07:47", "text": "资产中的组件数量"}, {"type": "subtitle", "time": 4069.75, "timestamp": "01:07:49", "text": "面板并简化合并变体的操作"}, {"type": "subtitle", "time": 4071.589, "timestamp": "01:07:51", "text": "在属性面板中立即"}, {"type": "subtitle", "time": 4073.349, "timestamp": "01:07:53", "text": "将它们转换为单个组件"}, {"type": "subtitle", "time": 4075.589, "timestamp": "01:07:55", "text": "放。只需重命名标签即可"}, {"type": "subtitle", "time": 4078.789, "timestamp": "01:07:58", "text": "各种可转换的资产。不用担心"}]
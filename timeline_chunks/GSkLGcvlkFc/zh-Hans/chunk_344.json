[{"type": "subtitle", "time": 20642.39, "timestamp": "05:44:02", "text": "等等，并妥善处理等等。是的，我"}, {"type": "subtitle", "time": 20645.51, "timestamp": "05:44:05", "text": "我很想要那个。但就像我"}, {"type": "subtitle", "time": 20647.948, "timestamp": "05:44:07", "text": "感觉自己像"}, {"type": "subtitle", "time": 20652.67, "timestamp": "05:44:12", "text": "坏的。我觉得自己不太擅长和宠物相处。"}, {"type": "subtitle", "time": 20655.59, "timestamp": "05:44:15", "text": "呃，因为我从来没养过宠物。"}, {"type": "subtitle", "time": 20667.19, "timestamp": "05:44:27", "text": "呃，你想知道一个关于……的黑暗事实吗？"}, {"type": "subtitle", "time": 20675.83, "timestamp": "05:44:35", "text": "如果你想分享的话，那当然可以。"}, {"type": "subtitle", "time": 20677.868, "timestamp": "05:44:37", "text": "什么是深色脂肪？"}, {"type": "subtitle", "time": 20680.548, "timestamp": "05:44:40", "text": "猫？我看过一些视频，如果你尝试……"}, {"type": "subtitle", "time": 20682.91, "timestamp": "05:44:42", "text": "翻转"}, {"type": "subtitle", "time": 20686.788, "timestamp": "05:44:46", "text": "猫就像你知道的，扔一只猫"}, {"type": "subtitle", "time": 20689.27, "timestamp": "05:44:49", "text": "从倒置的状态来看，它最终总会朝上。"}, {"type": "subtitle", "time": 20691.628, "timestamp": "05:44:51", "text": "直的或"}, {"type": "subtitle", "time": 20695.19, "timestamp": "05:44:55", "text": "某物。我不知道。我看过一段视频"}]
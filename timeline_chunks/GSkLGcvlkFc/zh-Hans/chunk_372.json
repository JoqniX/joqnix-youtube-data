[{"type": "subtitle", "time": 22322.43, "timestamp": "06:12:02", "text": "你们这些喂饭的"}, {"type": "subtitle", "time": 22325.67, "timestamp": "06:12:05", "text": "类似那种建议之类的东西"}, {"type": "subtitle", "time": 22332.39, "timestamp": "06:12:12", "text": "学习。别担心。呃，我只会"}, {"type": "subtitle", "time": 22334.788, "timestamp": "06:12:14", "text": "告诉我的儿子，你就会知道哪个"}, {"type": "subtitle", "time": 22336.47, "timestamp": "06:12:16", "text": "人是你的朋友，哪些是你的朋友？"}, {"type": "subtitle", "time": 22339.708, "timestamp": "06:12:19", "text": "不是。让我去商店看看吧"}, {"type": "subtitle", "time": 22343.708, "timestamp": "06:12:23", "text": "我不让你来。哦，我的"}, {"type": "subtitle", "time": 22345.31, "timestamp": "06:12:25", "text": "上帝。"}, {"type": "subtitle", "time": 22348.59, "timestamp": "06:12:28", "text": "阿尼赫拉机器人。欢迎，欢迎来到"}, {"type": "subtitle", "time": 22350.708, "timestamp": "06:12:30", "text": "溪流。欢迎，欢迎。希望你"}, {"type": "subtitle", "time": 22356.99, "timestamp": "06:12:36", "text": "[音乐]"}, {"type": "subtitle", "time": 22361.948, "timestamp": "06:12:41", "text": "晚上？对，就是类似的事情。"}, {"type": "subtitle", "time": 22367.19, "timestamp": "06:12:47", "text": "不，包括谈话内容。哇。"}, {"type": "subtitle", "time": 22368.948, "timestamp": "06:12:48", "text": "从某种意义上说，这是一种善意。"}, {"type": "subtitle", "time": 22371.07, "timestamp": "06:12:51", "text": "的"}, {"type": "subtitle", "time": 22376.11, "timestamp": "06:12:56", "text": "某种程度上来说，挺酷的，或者说挺酷的。"}, {"type": "subtitle", "time": 22378.628, "timestamp": "06:12:58", "text": "是啊，然后他就会离开，自谋生路。"}]
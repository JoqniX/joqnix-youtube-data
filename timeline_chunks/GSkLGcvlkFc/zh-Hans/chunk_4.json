[{"type": "subtitle", "time": 242.63, "timestamp": "00:04:02", "text": "嗯，《枯萎的浪潮》和《漫威劲敌》"}, {"type": "subtitle", "time": 244.429, "timestamp": "00:04:04", "text": "昨天我"}, {"type": "subtitle", "time": 246.789, "timestamp": "00:04:06", "text": "睡觉时没穿它们"}, {"type": "subtitle", "time": 250.99, "timestamp": "00:04:10", "text": "下载。我真是个笨蛋，但是……"}, {"type": "subtitle", "time": 253.429, "timestamp": "00:04:13", "text": "好的。完全没问题。没关系。"}, {"type": "subtitle", "time": 256.15, "timestamp": "00:04:16", "text": "我还在下载。快到99了"}, {"type": "subtitle", "time": 261.469, "timestamp": "00:04:21", "text": "目前已达98%。 95%好的。"}, {"type": "subtitle", "time": 264.07, "timestamp": "00:04:24", "text": "嗯，今天就会下载。什么"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "我们会做的就是准备一份清单或……"}, {"type": "subtitle", "time": 269.67, "timestamp": "00:04:29", "text": "我们需要完成的任务清单。一是"}, {"type": "subtitle", "time": 272.71, "timestamp": "00:04:32", "text": "比利比利为比利比利伐木。全部"}, {"type": "subtitle", "time": 275.59000000000003, "timestamp": "00:04:35", "text": "我会记录日志相关的内容。"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "比利记录东西。我今天就去做。二"}, {"type": "subtitle", "time": 281.189, "timestamp": "00:04:41", "text": "活动相关内容。 Jocknix 活动用品"}, {"type": "subtitle", "time": 284.629, "timestamp": "00:04:44", "text": "以及 RPC 系统。我们会这么做。"}, {"type": "subtitle", "time": 287.27, "timestamp": "00:04:47", "text": "昨天我们做了这件事。我不知道是否"}, {"type": "subtitle", "time": 289.27, "timestamp": "00:04:49", "text": "你知道，但我们做到了。等等"}, {"type": "subtitle", "time": 291.23, "timestamp": "00:04:51", "text": "第二。给我一个"}, {"type": "subtitle", "time": 294.469, "timestamp": "00:04:54", "text": "分钟。昨天晚上一直到5点"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "早上之类的。不，凌晨4点。我做了。"}]
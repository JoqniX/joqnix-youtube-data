[{"type": "subtitle", "time": 24301.07, "timestamp": "06:45:01", "text": "我不知道自己能不能做到。但"}, {"type": "subtitle", "time": 24304.548, "timestamp": "06:45:04", "text": "是的，包括维护保养等等。什么"}, {"type": "subtitle", "time": 24307.03, "timestamp": "06:45:07", "text": "你的布加迪是什么颜色？什么？我不"}, {"type": "subtitle", "time": 24317.15, "timestamp": "06:45:17", "text": "嗯？我的天哪，我的鼻子。好的，粉色"}, {"type": "subtitle", "time": 24319.99, "timestamp": "06:45:19", "text": "蹦床。呃，有没有一个类别是……"}, {"type": "subtitle", "time": 24321.39, "timestamp": "06:45:21", "text": "可以切换"}, {"type": "subtitle", "time": 24323.67, "timestamp": "06:45:23", "text": "到？不。对。我不认为有"}, {"type": "subtitle", "time": 24325.67, "timestamp": "06:45:25", "text": "仅限粉色蹦床类别。"}, {"type": "subtitle", "time": 24332.27, "timestamp": "06:45:32", "text": "查看。"}, {"type": "subtitle", "time": 24334.0, "timestamp": "06:45:34", "text": "粉色的"}, {"type": "subtitle", "time": 24342.67, "timestamp": "06:45:42", "text": "蹦床。不，那里没有。"}, {"type": "subtitle", "time": 24345.628, "timestamp": "06:45:45", "text": "好的。"}, {"type": "subtitle", "time": 24348.708, "timestamp": "06:45:48", "text": "没有践踏。哦，坦普隆。好的。不是"}, {"type": "subtitle", "time": 24355.35, "timestamp": "06:45:55", "text": "好的。嗯，我可以换成这个。"}, {"type": "subtitle", "time": 24357.03, "timestamp": "06:45:57", "text": "是的，我必须确保我不会做空。"}, {"type": "subtitle", "time": 24359.43, "timestamp": "06:45:59", "text": "Twitch 或其他任何平台。希望我不会收到"}]
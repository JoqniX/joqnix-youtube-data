[{"type": "subtitle", "time": 21185.67, "timestamp": "05:53:05", "text": "正在做？我一直在看很多"}, {"type": "subtitle", "time": 21188.23, "timestamp": "05:53:08", "text": "现在的电影。哦，你看了什么？"}, {"type": "subtitle", "time": 21204.03, "timestamp": "05:53:24", "text": "凉爽的。呃，我想念看电影的日子。"}, {"type": "subtitle", "time": 21206.868, "timestamp": "05:53:26", "text": "东西。我最后看的节目是"}, {"type": "subtitle", "time": 21209.75, "timestamp": "05:53:29", "text": "那部蜘蛛侠电影和"}, {"type": "subtitle", "time": 21214.07, "timestamp": "05:53:34", "text": "嗯，就是毒液那部。就是这样。"}, {"type": "subtitle", "time": 21218.03, "timestamp": "05:53:38", "text": "嗯，我想我开始"}, {"type": "subtitle", "time": 21221.47, "timestamp": "05:53:41", "text": "看着约翰·维克，但我"}, {"type": "subtitle", "time": 21223.83, "timestamp": "05:53:43", "text": "停止。是的，我没有继续下去。"}, {"type": "subtitle", "time": 21226.39, "timestamp": "05:53:46", "text": "我猜也是。约翰·维克二号或三号"}, {"type": "subtitle", "time": 21227.31, "timestamp": "05:53:47", "text": "我想我"}, {"type": "subtitle", "time": 21230.27, "timestamp": "05:53:50", "text": "忘了。我没看"}, {"type": "subtitle", "time": 21233.35, "timestamp": "05:53:53", "text": "它。呃，《夜行者》、《囚徒》"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "行星与分离。哦，我从来没有"}, {"type": "subtitle", "time": 21238.99, "timestamp": "05:53:58", "text": "你听说过这些吗？"}]
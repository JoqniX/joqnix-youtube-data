[{"type": "subtitle", "time": 23220.67, "timestamp": "06:27:00", "text": "说。如今的音乐和各种东西"}, {"type": "subtitle", "time": 23223.628, "timestamp": "06:27:03", "text": "电视。他们现在用哪个频道？"}, {"type": "subtitle", "time": 23226.07, "timestamp": "06:27:06", "text": "Anniplex。不，我不认为Anniplex"}, {"type": "subtitle", "time": 23230.19, "timestamp": "06:27:10", "text": "就是那个频道。等等，我没有"}, {"type": "subtitle", "time": 23244.548, "timestamp": "06:27:24", "text": "那里？关注 Disney Plus。嗯，Pogo。我"}, {"type": "subtitle", "time": 23251.67, "timestamp": "06:27:31", "text": "什么？卡通频道。当然，那是"}, {"type": "subtitle", "time": 23257.868, "timestamp": "06:27:37", "text": "那里的人们正在观看"}, {"type": "subtitle", "time": 23262.03, "timestamp": "06:27:42", "text": "电视。那正是我本人。"}, {"type": "subtitle", "time": 23266.27, "timestamp": "06:27:46", "text": "想知道现在的人们"}, {"type": "subtitle", "time": 23268.27, "timestamp": "06:27:48", "text": "手表"}, {"type": "subtitle", "time": 23276.07, "timestamp": "06:27:56", "text": "观看《蟑螂杀手》。"}, {"type": "subtitle", "time": 23278.39, "timestamp": "06:27:58", "text": "哦，对了，有个新游戏要出了。"}]
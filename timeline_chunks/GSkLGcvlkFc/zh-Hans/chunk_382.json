[{"type": "subtitle", "time": 22920.788, "timestamp": "06:22:00", "text": "考试结束了吗？不，还没有结束。"}, {"type": "subtitle", "time": 22928.788, "timestamp": "06:22:08", "text": "那是周五，还有下周五的21号。然后"}, {"type": "subtitle", "time": 22946.75, "timestamp": "06:22:26", "text": "他不是曾经殴打过一个孩子吗？"}, {"type": "subtitle", "time": 22955.83, "timestamp": "06:22:35", "text": "哇，巴基看起来真酷。我们应该观看"}, {"type": "subtitle", "time": 22959.19, "timestamp": "06:22:39", "text": "总有一天会实现的，伙计。我真的很想"}, {"type": "subtitle", "time": 22961.75, "timestamp": "06:22:41", "text": "推广更多社区活动"}, {"type": "subtitle", "time": 22963.708, "timestamp": "06:22:43", "text": "Discord"}, {"type": "subtitle", "time": 22967.35, "timestamp": "06:22:47", "text": "服务器，但我感觉，嗯，在某种程度上我是"}, {"type": "subtitle", "time": 22968.75, "timestamp": "06:22:48", "text": "喜欢"}, {"type": "subtitle", "time": 22972.708, "timestamp": "06:22:52", "text": "我没有让自己对社区敞开心扉"}, {"type": "subtitle", "time": 22975.19, "timestamp": "06:22:55", "text": "事件。所以，更确切地说，它更像是少了些什么。"}, {"type": "subtitle", "time": 22978.39, "timestamp": "06:22:58", "text": "这是我的看法。"}]
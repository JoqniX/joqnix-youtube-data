[{"type": "subtitle", "time": 6661.95, "timestamp": "01:51:01", "text": "特性。好的，我们做到了"}, {"type": "subtitle", "time": 6664.75, "timestamp": "01:51:04", "text": "那。呃，午餐，"}, {"type": "subtitle", "time": 6668.51, "timestamp": "01:51:08", "text": "早餐，午餐，早餐，"}, {"type": "subtitle", "time": 6671.51, "timestamp": "01:51:11", "text": "午餐，下午茶。我必须完成剩下的部分"}, {"type": "subtitle", "time": 6673.31, "timestamp": "01:51:13", "text": "他们，"}, {"type": "subtitle", "time": 6681.31, "timestamp": "01:51:21", "text": "晚餐。这将"}, {"type": "subtitle", "time": 6683.55, "timestamp": "01:51:23", "text": "成为音乐"}, {"type": "subtitle", "time": 6687.64, "timestamp": "01:51:27", "text": "班级。这将是私人时间。"}, {"type": "subtitle", "time": 6690.07, "timestamp": "01:51:30", "text": "[音乐]"}, {"type": "subtitle", "time": 6700.91, "timestamp": "01:51:40", "text": "学习中。"}, {"type": "subtitle", "time": 6707.91, "timestamp": "01:51:47", "text": "东西。我终于写完了文本"}, {"type": "subtitle", "time": 6710.22, "timestamp": "01:51:50", "text": "东西。好的，我们搞定了那部分。"}, {"type": "subtitle", "time": 6711.39, "timestamp": "01:51:51", "text": "[音乐]"}, {"type": "subtitle", "time": 6714.47, "timestamp": "01:51:54", "text": "完毕。现在时间太长了。"}, {"type": "subtitle", "time": 6718.07, "timestamp": "01:51:58", "text": "感觉看得太多了。啊，什么？"}]
[{"type": "subtitle", "time": 4680.79, "timestamp": "01:18:00", "text": "当我进入资产面板时，你会"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "你看，我这里有一个组件，对吧？"}, {"type": "subtitle", "time": 4685.35, "timestamp": "01:18:05", "text": "旁边还有一个小小的10，意思是："}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "共有 10 种变体。但我"}, {"type": "subtitle", "time": 4689.03, "timestamp": "01:18:09", "text": "需要告诉 Figma 什么是"}, {"type": "subtitle", "time": 4690.31, "timestamp": "01:18:10", "text": "它们之间都存在差异，因此"}, {"type": "subtitle", "time": 4692.47, "timestamp": "01:18:12", "text": "使用此功能的人可以访问所有 10 个"}, {"type": "subtitle", "time": 4694.39, "timestamp": "01:18:14", "text": "只需拉入一个即可。我选择"}, {"type": "subtitle", "time": 4696.07, "timestamp": "01:18:16", "text": "我的组件甚至能看到它正在提供"}, {"type": "subtitle", "time": 4698.47, "timestamp": "01:18:18", "text": "我在这里收到这条警告。我需要告诉"}, {"type": "subtitle", "time": 4700.55, "timestamp": "01:18:20", "text": "Figma 的属性是什么？"}, {"type": "subtitle", "time": 4702.79, "timestamp": "01:18:22", "text": "区分彼此的价值观。所以其中之一"}, {"type": "subtitle", "time": 4704.709, "timestamp": "01:18:24", "text": "我们在这里可以看到的属性是："}, {"type": "subtitle", "time": 4707.27, "timestamp": "01:18:27", "text": "进展。正确的？这是 0 25"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "50、75 和 100。所以已经有一个了。"}, {"type": "subtitle", "time": 4712.709, "timestamp": "01:18:32", "text": "房产已创建。所以我干脆加倍。"}, {"type": "subtitle", "time": 4714.87, "timestamp": "01:18:34", "text": "点击即可更改名称"}, {"type": "subtitle", "time": 4716.95, "timestamp": "01:18:36", "text": "进步。然后我就会开始添加……"}, {"type": "subtitle", "time": 4718.95, "timestamp": "01:18:38", "text": "价值观。所以这个和这个都拿着"}, {"type": "subtitle", "time": 4720.63, "timestamp": "01:18:40", "text": "向下切换以选择两者。"}, {"type": "subtitle", "time": 4722.87, "timestamp": "01:18:42", "text": "为零。这两个都要走了"}, {"type": "subtitle", "time": 4725.35, "timestamp": "01:18:45", "text": "25岁。这个和这个都是"}, {"type": "subtitle", "time": 4727.83, "timestamp": "01:18:47", "text": "即将年满50岁。现在你会注意到……"}, {"type": "subtitle", "time": 4729.59, "timestamp": "01:18:49", "text": "我只是在输入代替单词。"}, {"type": "subtitle", "time": 4731.27, "timestamp": "01:18:51", "text": "默认。我可以点击下拉菜单"}, {"type": "subtitle", "time": 4732.95, "timestamp": "01:18:52", "text": "然后说要重命名之类的。但"}, {"type": "subtitle", "time": 4736.07, "timestamp": "01:18:56", "text": "没问题。所以这些是75，这些"}, {"type": "subtitle", "time": 4739.51, "timestamp": "01:18:59", "text": "100% 没问题。现在如果我拖动一个实例"}]
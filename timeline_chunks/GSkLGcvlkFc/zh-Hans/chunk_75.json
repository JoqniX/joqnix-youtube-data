[{"type": "subtitle", "time": 4501.27, "timestamp": "01:15:01", "text": "控制板。你会看到，现在它是一个"}, {"type": "subtitle", "time": 4503.03, "timestamp": "01:15:03", "text": "空心钻石，意味着它是一个"}, {"type": "subtitle", "time": 4505.669, "timestamp": "01:15:05", "text": "组件实例。我也可以"}, {"type": "subtitle", "time": 4507.99, "timestamp": "01:15:07", "text": "复制我的组件。所以我选择"}, {"type": "subtitle", "time": 4510.47, "timestamp": "01:15:10", "text": "它和命令 D 进行复制。看"}, {"type": "subtitle", "time": 4513.189, "timestamp": "01:15:13", "text": "另一个实例，或者我可以复制"}, {"type": "subtitle", "time": 4514.95, "timestamp": "01:15:14", "text": "另一个例子。现在如果我选择其中一个"}, {"type": "subtitle", "time": 4516.55, "timestamp": "01:15:16", "text": "这些情况，这里会说明。"}, {"type": "subtitle", "time": 4518.63, "timestamp": "01:15:18", "text": "顶部是它的一个实例"}, {"type": "subtitle", "time": 4520.31, "timestamp": "01:15:20", "text": "证言，即名称"}, {"type": "subtitle", "time": 4522.229, "timestamp": "01:15:22", "text": "组件，它是在这个文件中创建的。"}, {"type": "subtitle", "time": 4524.07, "timestamp": "01:15:24", "text": "如果我右键点击它，我可以选择“转到”。"}, {"type": "subtitle", "time": 4525.91, "timestamp": "01:15:25", "text": "主要部件，它将带我到"}, {"type": "subtitle", "time": 4527.669, "timestamp": "01:15:27", "text": "它的主要组成部分是"}, {"type": "subtitle", "time": 4529.91, "timestamp": "01:15:29", "text": "例如。那么，让我们来看看究竟是什么"}, {"type": "subtitle", "time": 4531.669, "timestamp": "01:15:31", "text": "我们之前谈过。现在我想"}, {"type": "subtitle", "time": 4533.43, "timestamp": "01:15:33", "text": "移动这张图片，我想移动它"}, {"type": "subtitle", "time": 4535.75, "timestamp": "01:15:35", "text": "向下。看看发生了什么？他们所有人"}, {"type": "chat", "time": 4537.63, "timestamp": "01:15:37", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "big brain stuff man"}, {"type": "subtitle", "time": 4538.39, "timestamp": "01:15:38", "text": "正在发生变化。哦，它们都是实例。"}, {"type": "subtitle", "time": 4541.51, "timestamp": "01:15:41", "text": "该主要部件。但实例"}, {"type": "subtitle", "time": 4543.91, "timestamp": "01:15:43", "text": "也可能发生变化，但这不会"}, {"type": "subtitle", "time": 4545.669, "timestamp": "01:15:45", "text": "影响其他实例或主要"}, {"type": "subtitle", "time": 4547.51, "timestamp": "01:15:47", "text": "成分。例如，假设在"}, {"type": "subtitle", "time": 4549.43, "timestamp": "01:15:49", "text": "我想修改这个文本，"}, {"type": "subtitle", "time": 4551.39, "timestamp": "01:15:51", "text": "我不想做这一切，我只想……"}, {"type": "subtitle", "time": 4553.99, "timestamp": "01:15:53", "text": "问好。是的。所以你只能看到这些。"}, {"type": "subtitle", "time": 4556.31, "timestamp": "01:15:56", "text": "实例发生了变化，而其他实例则没有。"}, {"type": "subtitle", "time": 4558.07, "timestamp": "01:15:58", "text": "做作的。如果我想带这个"}, {"type": "subtitle", "time": 4559.83, "timestamp": "01:15:59", "text": "实例恢复到与主实例相同的外观"}]
[{"type": "subtitle", "time": 3924.71, "timestamp": "01:05:24", "text": "我们很高兴能基于这种语言"}, {"type": "subtitle", "time": 3928.069, "timestamp": "01:05:28", "text": "正在使用，我们只使用它们"}, {"type": "subtitle", "time": 3929.829, "timestamp": "01:05:29", "text": "计划推出一个响应式博客"}, {"type": "subtitle", "time": 3931.75, "timestamp": "01:05:31", "text": "我们需要更改主要字体"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "我们使用的系统来创建群组"}, {"type": "subtitle", "time": 3937.549, "timestamp": "01:05:37", "text": "为了帮助我们整理变量"}, {"type": "subtitle", "time": 3943.589, "timestamp": "01:05:43", "text": "纺织品并更新字符串变量"}, {"type": "subtitle", "time": 3945.829, "timestamp": "01:05:45", "text": "切换到不同的字体系列名称"}, {"type": "subtitle", "time": 3947.589, "timestamp": "01:05:47", "text": "特性。注意他们有三个"}, {"type": "subtitle", "time": 3950.23, "timestamp": "01:05:50", "text": "为字体创建变量组"}, {"type": "subtitle", "time": 3953.029, "timestamp": "01:05:53", "text": "重量通常有时被称为书本"}]
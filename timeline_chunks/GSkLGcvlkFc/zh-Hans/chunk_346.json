[{"type": "subtitle", "time": 20766.19, "timestamp": "05:46:06", "text": "可怕的。哇。"}, {"type": "subtitle", "time": 20775.11, "timestamp": "05:46:15", "text": "该死。但了解这些也很酷"}, {"type": "subtitle", "time": 20777.868, "timestamp": "05:46:17", "text": "这些脂肪之类的东西。"}, {"type": "subtitle", "time": 20780.9, "timestamp": "05:46:20", "text": "是的。所以，"}, {"type": "subtitle", "time": 20784.67, "timestamp": "05:46:24", "text": "[音乐]"}, {"type": "subtitle", "time": 20787.868, "timestamp": "05:46:27", "text": "是的，戴安娜。"}, {"type": "subtitle", "time": 20790.788, "timestamp": "05:46:30", "text": "嗯，哦，是的，我得继续前进。"}, {"type": "subtitle", "time": 20792.67, "timestamp": "05:46:32", "text": "说。"}, {"type": "subtitle", "time": 20795.59, "timestamp": "05:46:35", "text": "嗯，这对我来说就像一次练习，你。"}, {"type": "subtitle", "time": 20803.948, "timestamp": "05:46:43", "text": "对话。呃，猫不信任人。"}, {"type": "subtitle", "time": 20808.35, "timestamp": "05:46:48", "text": "任何人。真的。是的，猫很温柔"}, {"type": "subtitle", "time": 20812.43, "timestamp": "05:46:52", "text": "养猫有点难"}, {"type": "subtitle", "time": 20815.67, "timestamp": "05:46:55", "text": "你管它叫什么？他们很挑剔"}, {"type": "subtitle", "time": 20818.27, "timestamp": "05:46:58", "text": "生物，我"}]
[{"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "看看會發生什麼。哇。讓我們來"}, {"type": "subtitle", "time": 4689.03, "timestamp": "01:18:09", "text": "探究一下究竟發生了什麼變化。 Figma"}, {"type": "subtitle", "time": 4694.39, "timestamp": "01:18:14", "text": "建立了我們複選框元件的副本，並將這兩個元件放置在一個新的容器中。這個容器是一個組件集，我們"}, {"type": "subtitle", "time": 4698.47, "timestamp": "01:18:18", "text": "可以透過紫色虛線來識別它。在圖層面板中，我們可以看到組件集"}, {"type": "subtitle", "time": 4700.55, "timestamp": "01:18:20", "text": "具有與我們通常看到的組件相同的四菱形圖示。我們的組件集中每個變體都有"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "一個實心菱形圖示"}, {"type": "subtitle", "time": 4712.709, "timestamp": "01:18:32", "text": "。我們的圖層"}, {"type": "subtitle", "time": 4714.87, "timestamp": "01:18:34", "text": "名稱也已更改。斜線複選框前的文字"}, {"type": "subtitle", "time": 4727.83, "timestamp": "01:18:47", "text": "現在是我們組件集的名稱。斜線後面的文字（未選取）現在是我們的"}, {"type": "subtitle", "time": 4731.27, "timestamp": "01:18:51", "text": "預設變體的名稱。複選框具有通用名稱，後面跟著升序數字。變體 2 層命名是創建和管理變體的重要方面。與面板不同，我們可以看到變化。所以我們將使用未檢查的關鍵變體。複選框的預設狀態。"}]
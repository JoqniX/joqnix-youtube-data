[{"type": "subtitle", "time": 5529.91, "timestamp": "01:32:09", "text": "看，這讓我多麼感動。正如我所說，這個圖標，也就是心"}, {"type": "subtitle", "time": 5533.47, "timestamp": "01:32:13", "text": "形圖標，是一個元件實例。所以你會看到，在這個框架裡，"}, {"type": "subtitle", "time": 5536.87, "timestamp": "01:32:16", "text": "我有很多不同圖示的不同元件"}, {"type": "subtitle", "time": 5541.27, "timestamp": "01:32:21", "text": "。現在，"}, {"type": "subtitle", "time": 5546.95, "timestamp": "01:32:26", "text": "如果"}, {"type": "subtitle", "time": 5548.95, "timestamp": "01:32:28", "text": "我選擇一個實例，"}, {"type": "subtitle", "time": 5552.709, "timestamp": "01:32:32", "text": "我可以轉到頂部的這個下拉式選單，它會告訴我這是一個「心」的"}]
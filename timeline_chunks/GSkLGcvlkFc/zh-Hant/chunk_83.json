[{"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "變化，但這不會影響其他實例或主元件。例如，假設在這個例子中，我想"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "更改文本，把所有這些內容都改成「你好」。是的。所以你會看到只有那一個"}, {"type": "subtitle", "time": 4988.39, "timestamp": "01:23:08", "text": "實例發生了變化，其他實例沒有受到影響。如果我想讓"}, {"type": "subtitle", "time": 4994.55, "timestamp": "01:23:14", "text": "這個實例恢復到主組件的樣子，我可以右鍵單擊並選擇“重置所有更改”"}, {"type": "subtitle", "time": 4995.99, "timestamp": "01:23:15", "text": "，這樣就會自動恢復之前發生的情況。所以我可以"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "修改實例內部的內容。需要記住的一點"}, {"type": "subtitle", "time": 5006.95, "timestamp": "01:23:26", "text": "是，我無法刪除實例中的任何內容。我們來看一個例子。如果我選取這張圖片，"}, {"type": "subtitle", "time": 5009.11, "timestamp": "01:23:29", "text": "我可以按下鍵盤上的退格鍵或刪除鍵，它就會消失。看起來好像我已經把它刪除了，但是當我查看"}, {"type": "subtitle", "time": 5014.149, "timestamp": "01:23:34", "text": "圖層面板時，發現它實際上還在"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "那裡。所以你可以看到圖層被隱藏了，但它仍然存在，這是因為它存在於"}, {"type": "subtitle", "time": 5028.47, "timestamp": "01:23:48", "text": "主元件中。"}, {"type": "subtitle", "time": 5032.39, "timestamp": "01:23:52", "text": "所以我無法刪除它。我也不能移動物品。例如，假設"}, {"type": "subtitle", "time": 5036.87, "timestamp": "01:23:56", "text": "我想拿到這個讚"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "按鈕，我會盡我所能地把它移開。"}]
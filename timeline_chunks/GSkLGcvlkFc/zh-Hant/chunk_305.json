[{"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "來製作"}, {"type": "subtitle", "time": 18321.99, "timestamp": "05:05:21", "text": "主標題。主標題。這裡什麼也沒有。我做錯什麼了嗎？我犯錯了嗎？我做錯什麼了嗎？  我好困惑。好的，這樣我就可以這麼做了"}, {"type": "subtitle", "time": 18324.47, "timestamp": "05:05:24", "text": "。"}, {"type": "subtitle", "time": 18328.31, "timestamp": "05:05:28", "text": "我明白了。  好吧，我們試試預設的…"}]
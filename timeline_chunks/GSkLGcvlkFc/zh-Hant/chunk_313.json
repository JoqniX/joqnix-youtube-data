[{"type": "subtitle", "time": 18787.43, "timestamp": "05:13:07", "text": "因為現在輪廓線，但是這個變體中的文字標籤與組件屬性相連，而這個變體沒有，但是發生了什麼？你看，它說這樣我就可以留在[音樂]中，我覺得我做錯了什麼。我覺得自己好像"}, {"type": "subtitle", "time": 18790.628, "timestamp": "05:13:10", "text": "做錯了什麼事。"}, {"type": "subtitle", "time": 18799.19, "timestamp": "05:13:19", "text": "我們舉個例子。哦，成功了。哦，原來"}, {"type": "subtitle", "time": 18808.708, "timestamp": "05:13:28", "text": "我應該這樣做。好的。好的。  好的。好的。我得到了它。看。看。我得到了它。"}, {"type": "subtitle", "time": 18814.39, "timestamp": "05:13:34", "text": "我想我明白了。好的。屬性預設值。好的。"}, {"type": "subtitle", "time": 18818.948, "timestamp": "05:13:38", "text": "睡眠。我覺得我修好了。我覺得我做到了。我覺得"}]
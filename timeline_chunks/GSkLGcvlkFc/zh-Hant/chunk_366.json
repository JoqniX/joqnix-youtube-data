[{"type": "subtitle", "time": 21962.51, "timestamp": "06:06:02", "text": "沒有你，我該怎麼辦？好的，我正在想辦法看看有沒有辦法提高幀率，"}, {"type": "subtitle", "time": 21972.948, "timestamp": "06:06:12", "text": "哦，"}, {"type": "subtitle", "time": 21975.43, "timestamp": "06:06:15", "text": "等等。"}, {"type": "subtitle", "time": 21979.99, "timestamp": "06:06:19", "text": "我可以把背景去掉。 60格即時播放。我的天啊。我應該放張圖片之類的東西。"}, {"type": "subtitle", "time": 21982.39, "timestamp": "06:06:22", "text": "哦，是的。  嗯……你看過那部講述多方聲音廣播的動畫嗎？是的。嗯，你說你看過那部"}, {"type": "subtitle", "time": 21984.708, "timestamp": "06:06:24", "text": "動漫嗎"}, {"type": "subtitle", "time": 21987.03, "timestamp": "06:06:27", "text": "？是的，"}, {"type": "subtitle", "time": 22001.83, "timestamp": "06:06:41", "text": "我正在看。我得趕緊補上。比它落後五集。我堅持到了一秒鐘。  [音樂] 好了，我回來了。呃，我看到"}, {"type": "subtitle", "time": 22008.788, "timestamp": "06:06:48", "text": "第六集了。  哦好的。好，好，好，好。"}, {"type": "subtitle", "time": 22015.27, "timestamp": "06:06:55", "text": "天哪，家人進來的時候"}, {"type": "subtitle", "time": 22017.67, "timestamp": "06:06:57", "text": "我得小心一點。嗯，我得把兩支麥克風都關掉。  [音樂] 我甚至不想讓它翻譯我"}]
[{"type": "subtitle", "time": 23223.628, "timestamp": "06:27:03", "text": "有時候"}, {"type": "subtitle", "time": 23226.07, "timestamp": "06:27:06", "text": "我都在想我們"}, {"type": "subtitle", "time": 23230.19, "timestamp": "06:27:10", "text": "是不是真的印度人？因為"}, {"type": "subtitle", "time": 23244.548, "timestamp": "06:27:24", "text": "印度粉絲說我們本來就養寵物，那就是我們。哈？什麼？等等，什麼？嗯，我的意思是，說到印度父母，好像有兩種情況，對吧"}]
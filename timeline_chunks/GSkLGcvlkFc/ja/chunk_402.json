[{"type": "subtitle", "time": 24121.99, "timestamp": "06:42:01", "text": "ええと、関与するというのは、"}, {"type": "subtitle", "time": 24123.59, "timestamp": "06:42:03", "text": "会話とかそういうこと。むしろこうだ"}, {"type": "subtitle", "time": 24124.51, "timestamp": "06:42:04", "text": "1"}, {"type": "subtitle", "time": 24126.788, "timestamp": "06:42:06", "text": "テスト中。トランポリンはどこ？あなたは欲しい"}, {"type": "subtitle", "time": 24129.23, "timestamp": "06:42:09", "text": "今度はトランポリン？私はできます"}, {"type": "subtitle", "time": 24132.548, "timestamp": "06:42:12", "text": "それ。そうすれば、"}, {"type": "subtitle", "time": 24135.59, "timestamp": "06:42:15", "text": "話しているんだと思う。うん。設定させてください"}, {"type": "subtitle", "time": 24138.39, "timestamp": "06:42:18", "text": "これを上に。わかった。"}, {"type": "subtitle", "time": 24140.868, "timestamp": "06:42:20", "text": "FBI、開けろ。"}, {"type": "subtitle", "time": 24143.99, "timestamp": "06:42:23", "text": "こんにちは、アマルさん。こんにちは。こんにちは。なるほど"}, {"type": "subtitle", "time": 24146.868, "timestamp": "06:42:26", "text": "あなたがドアをノックしている。私はセックスしている"}, {"type": "subtitle", "time": 24153.08, "timestamp": "06:42:33", "text": "ドア。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 24154.35, "timestamp": "06:42:34", "text": "[音楽]"}, {"type": "subtitle", "time": 24158.35, "timestamp": "06:42:38", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 24159.48, "timestamp": "06:42:39", "text": "こんにちは。"}, {"type": "subtitle", "time": 24161.23, "timestamp": "06:42:41", "text": "[音楽]"}, {"type": "subtitle", "time": 24164.67, "timestamp": "06:42:44", "text": "ボイン。はい。ボー"}, {"type": "subtitle", "time": 24167.19, "timestamp": "06:42:47", "text": "確かに。わかった。"}, {"type": "subtitle", "time": 24169.31, "timestamp": "06:42:49", "text": "汗だくで、すごく暑い。"}, {"type": "subtitle", "time": 24172.948, "timestamp": "06:42:52", "text": "おお。私の部屋には扇風機があるから"}, {"type": "subtitle", "time": 24173.948, "timestamp": "06:42:53", "text": "生きている"}, {"type": "subtitle", "time": 24179.788, "timestamp": "06:42:59", "text": "部屋。でも痛みは"}]
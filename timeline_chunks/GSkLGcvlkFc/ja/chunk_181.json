[{"type": "subtitle", "time": 10863.75, "timestamp": "03:01:03", "text": "きちんと。そう、こんな感じ。それはすべきです"}, {"type": "subtitle", "time": 10867.269, "timestamp": "03:01:07", "text": "権利はそうやって変わる。これは"}, {"type": "subtitle", "time": 10870.55, "timestamp": "03:01:10", "text": "シングルからシングルに変更すると問題が発生します"}, {"type": "subtitle", "time": 10873.15, "timestamp": "03:01:13", "text": "エモートはグッチにぴったり"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "完璧だけど二重輸入はしたくない"}, {"type": "subtitle", "time": 10878.67, "timestamp": "03:01:18", "text": "私はこうあってほしい"}, {"type": "subtitle", "time": 10881.11, "timestamp": "03:01:21", "text": "中央集権的。たとえ私がそれを次のように変更したとしても"}, {"type": "subtitle", "time": 10884.07, "timestamp": "03:01:24", "text": "もし私が単数モードに戻ると"}, {"type": "subtitle", "time": 10887.63, "timestamp": "03:01:27", "text": "このような。私は何をしなければならないのか"}, {"type": "chat", "time": 10910.603, "timestamp": "03:01:50", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "gimma a min"}]
[{"type": "subtitle", "time": 19802.56, "timestamp": "05:30:02", "text": "はぁ？え、何？なぜでしょうか？"}, {"type": "subtitle", "time": 19803.788, "timestamp": "05:30:03", "text": "[音楽]"}, {"type": "subtitle", "time": 19806.38, "timestamp": "05:30:06", "text": "待って。言って言って"}, {"type": "subtitle", "time": 19808.59, "timestamp": "05:30:08", "text": "[音楽]"}, {"type": "subtitle", "time": 19812.47, "timestamp": "05:30:12", "text": "ああ、実はエピソード4なんです"}, {"type": "subtitle", "time": 19815.23, "timestamp": "05:30:15", "text": "どうやらそうではないようだ"}, {"type": "subtitle", "time": 19817.99, "timestamp": "05:30:17", "text": "五。そして、現在の状況は"}, {"type": "subtitle", "time": 19820.59, "timestamp": "05:30:20", "text": "エピソードで"}, {"type": "subtitle", "time": 19825.51, "timestamp": "05:30:25", "text": "9. それで、最近はよく見ています。私は違います"}, {"type": "subtitle", "time": 19828.35, "timestamp": "05:30:28", "text": "見る時間を得る"}, {"type": "subtitle", "time": 19831.67, "timestamp": "05:30:31", "text": "アニメ。以前は、私には言い訳があった"}, {"type": "subtitle", "time": 19833.67, "timestamp": "05:30:33", "text": "12時間ストリーミング配信。はぁ？しかし"}, {"type": "subtitle", "time": 19835.83, "timestamp": "05:30:35", "text": "最近では、たとえストリーミング配信していなくても"}, {"type": "subtitle", "time": 19839.35, "timestamp": "05:30:39", "text": "12時間ずっと、文字通りPCの前にいます。"}, {"type": "subtitle", "time": 19842.548, "timestamp": "05:30:42", "text": "朝から晩まで、真夜中まで、私は"}, {"type": "subtitle", "time": 19846.19, "timestamp": "05:30:46", "text": "ストリームのために何かをするのと同じようなものだと思う"}, {"type": "subtitle", "time": 19850.43, "timestamp": "05:30:50", "text": "もの。それはむしろ私が"}, {"type": "subtitle", "time": 19853.35, "timestamp": "05:30:53", "text": "すべてがうまく機能するようにするなど"}, {"type": "subtitle", "time": 19855.27, "timestamp": "05:30:55", "text": "そして全て。知っておいてほしい"}, {"type": "subtitle", "time": 19858.628, "timestamp": "05:30:58", "text": "最近、最後の3、2回の配信だと思います"}]
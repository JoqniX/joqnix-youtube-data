[{"type": "subtitle", "time": 5281.669, "timestamp": "01:28:01", "text": "この滴まで。これはすごくクールだ。によって"}, {"type": "subtitle", "time": 5284.149, "timestamp": "01:28:04", "text": "自分でアイコンをすべて見つける方法。しかしこれは"}, {"type": "subtitle", "time": 5286.31, "timestamp": "01:28:06", "text": "まるで、ねえ、これらは"}, {"type": "subtitle", "time": 5288.07, "timestamp": "01:28:08", "text": "私が作成したオプション"}, {"type": "subtitle", "time": 5289.75, "timestamp": "01:28:09", "text": "このコンポーネントは、あなたにこれを使ってほしいと思っています。もしあなたが"}, {"type": "subtitle", "time": 5291.189, "timestamp": "01:28:11", "text": "他のものを使いたい場合は、どうぞ。"}, {"type": "subtitle", "time": 5294.39, "timestamp": "01:28:14", "text": "しかし、これが許可されているアイコンです"}, {"type": "subtitle", "time": 5295.99, "timestamp": "01:28:15", "text": "このコンポーネントについて。さて、重要な"}, {"type": "subtitle", "time": 5297.83, "timestamp": "01:28:17", "text": "コンポーネントのプロパティについて知っておくべきこと"}, {"type": "subtitle", "time": 5299.51, "timestamp": "01:28:19", "text": "コンポーネントを組み合わせることができる"}, {"type": "subtitle", "time": 5301.99, "timestamp": "01:28:21", "text": "同じプロパティとバリアント"}, {"type": "subtitle", "time": 5303.75, "timestamp": "01:28:23", "text": "時間。では、追加したいとしましょう"}, {"type": "subtitle", "time": 5306.229, "timestamp": "01:28:26", "text": "このボタンの別バージョンです。だから、"}, {"type": "subtitle", "time": 5308.629, "timestamp": "01:28:28", "text": "ここまで上がって、新しいバリエーションを追加してください。えっと、"}, {"type": "subtitle", "time": 5310.11, "timestamp": "01:28:30", "text": "これはこう言おう"}, {"type": "subtitle", "time": 5313.55, "timestamp": "01:28:33", "text": "これはアウトラインで、これは"}, {"type": "subtitle", "time": 5316.629, "timestamp": "01:28:36", "text": "満員です。うん。そして、こちらについては、"}, {"type": "subtitle", "time": 5318.709, "timestamp": "01:28:38", "text": "フィルを取り除いて、"}, {"type": "subtitle", "time": 5320.79, "timestamp": "01:28:40", "text": "一筆で、色を変えます"}, {"type": "subtitle", "time": 5323.03, "timestamp": "01:28:43", "text": "中のテキストも同様です。だから私は2つ持っています"}, {"type": "subtitle", "time": 5325.27, "timestamp": "01:28:45", "text": "以前私が持っていたようなさまざまなバリエーション"}, {"type": "subtitle", "time": 5327.03, "timestamp": "01:28:47", "text": "コンポーネントの特性は次のとおりです。"}, {"type": "subtitle", "time": 5329.189, "timestamp": "01:28:49", "text": "両者と繋がっている。うん。だからもし私が"}, {"type": "subtitle", "time": 5331.189, "timestamp": "01:28:51", "text": "例えばこの例を見てください、私は"}, {"type": "subtitle", "time": 5333.27, "timestamp": "01:28:53", "text": "スタイルをアウトラインに変更します。"}, {"type": "subtitle", "time": 5334.629, "timestamp": "01:28:54", "text": "私が変更したすべてのもの"}, {"type": "subtitle", "time": 5336.229, "timestamp": "01:28:56", "text": "最初のコンポーネントプロパティ"}, {"type": "subtitle", "time": 5339.35, "timestamp": "01:28:59", "text": "この変異体は、この変異体のままです。あなたはできる"}]
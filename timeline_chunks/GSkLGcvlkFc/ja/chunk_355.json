[{"type": "subtitle", "time": 21306.47, "timestamp": "05:55:06", "text": "見ていても退屈しないの？"}, {"type": "subtitle", "time": 21309.83, "timestamp": "05:55:09", "text": "同じ映画を何度も見る？私は決して"}, {"type": "subtitle", "time": 21312.43, "timestamp": "05:55:12", "text": "アニメでそれをやってください。"}, {"type": "subtitle", "time": 21315.27, "timestamp": "05:55:15", "text": "あまりにも。まるであなたがすでに何を知っているかのようです"}, {"type": "subtitle", "time": 21316.19, "timestamp": "05:55:16", "text": "行く"}, {"type": "subtitle", "time": 21320.67, "timestamp": "05:55:20", "text": "出てくるもの、または現れるもの、または"}, {"type": "subtitle", "time": 21332.07, "timestamp": "05:55:32", "text": "[音楽]"}, {"type": "subtitle", "time": 21344.15, "timestamp": "05:55:44", "text": "このQグループをミュートする方法を教えてください。私は試した"}, {"type": "subtitle", "time": 21348.99, "timestamp": "05:55:48", "text": "日本人の誰かに加わる"}, {"type": "subtitle", "time": 21352.628, "timestamp": "05:55:52", "text": "私がフォローしているストリーマー"}, {"type": "subtitle", "time": 21357.67, "timestamp": "05:55:57", "text": "えっと、ユクの公式グループで、私はできない"}, {"type": "subtitle", "time": 21359.31, "timestamp": "05:55:59", "text": "無効にする"}]
[{"type": "subtitle", "time": 3242.87, "timestamp": "00:54:02", "text": "ああ、あなたはもういないのね。ああ、私は去った、私は"}, {"type": "subtitle", "time": 3253.109, "timestamp": "00:54:13", "text": "卒業した？何てことだ。くそ。たくさん"}, {"type": "subtitle", "time": 3261.589, "timestamp": "00:54:21", "text": "何と簡単にコラボレーションできますか？ヴォー"}, {"type": "subtitle", "time": 3263.069, "timestamp": "00:54:23", "text": "また、"}, {"type": "subtitle", "time": 3265.87, "timestamp": "00:54:25", "text": "そうだよ、兄弟。わかった、"}, {"type": "subtitle", "time": 3268.99, "timestamp": "00:54:28", "text": "待って。ああ、彼の"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "これ？ダウンロードを一時停止します。私はできません"}, {"type": "subtitle", "time": 3284.92, "timestamp": "00:54:44", "text": "えーと"}]
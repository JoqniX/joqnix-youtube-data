[{"type": "subtitle", "time": 3960.23, "timestamp": "01:06:00", "text": "ピッカーで一致するもの。私は知りたいです"}, {"type": "subtitle", "time": 3963.43, "timestamp": "01:06:03", "text": "コンポーネントの使い方"}, {"type": "subtitle", "time": 3978.88, "timestamp": "01:06:18", "text": "しかし、コンポーネントは私に教えてくれます"}, {"type": "subtitle", "time": 3986.63, "timestamp": "01:06:26", "text": "コンポーネントは差異を生み出し、それを利用する。"}, {"type": "subtitle", "time": 3989.109, "timestamp": "01:06:29", "text": "ええ、これです。"}, {"type": "subtitle", "time": 3991.589, "timestamp": "01:06:31", "text": "個々のコンポーネントを作成すると、"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "自社のデザインシステムを開発する、"}, {"type": "subtitle", "time": 3995.67, "timestamp": "01:06:35", "text": "同様のニーズが見つかるでしょうが"}, {"type": "chat", "time": 3998.065, "timestamp": "01:06:38", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "😮😮"}, {"type": "subtitle", "time": 3998.15, "timestamp": "01:06:38", "text": "異なる構成要素。設計する際"}, {"type": "subtitle", "time": 4000.309, "timestamp": "01:06:40", "text": "フォームでは、入力にコンポーネントを使用します"}, {"type": "subtitle", "time": 4002.789, "timestamp": "01:06:42", "text": "フィールドとボタン。ラジオもあるかも"}, {"type": "subtitle", "time": 4005.829, "timestamp": "01:06:45", "text": "ボタンまたはチェックボックス。入力フィールドは"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "テキストのみを受け付けるか、ドロップダウンメニューにする"}, {"type": "subtitle", "time": 4010.87, "timestamp": "01:06:50", "text": "または日付選択ツール。青色にできる"}, {"type": "subtitle", "time": 4013.19, "timestamp": "01:06:53", "text": "フォーカスすると回転する境界線ストローク"}, {"type": "subtitle", "time": 4015.75, "timestamp": "01:06:55", "text": "値が無効な場合は赤色で表示されます。チェックボックス"}, {"type": "subtitle", "time": 4017.99, "timestamp": "01:06:57", "text": "未チェック、チェック済み、プライマリになる可能性があります"}, {"type": "subtitle", "time": 4019.91, "timestamp": "01:06:59", "text": "ボタン。ボタンの数は"}]
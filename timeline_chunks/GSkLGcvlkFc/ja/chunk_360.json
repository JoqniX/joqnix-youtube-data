[{"type": "subtitle", "time": 21600.59, "timestamp": "06:00:00", "text": "知る。まるで"}, {"type": "subtitle", "time": 21603.51, "timestamp": "06:00:03", "text": "えっと、それは挑戦か戦いみたいなものです"}, {"type": "subtitle", "time": 21605.11, "timestamp": "06:00:05", "text": "間"}, {"type": "subtitle", "time": 21607.51, "timestamp": "06:00:07", "text": "えーっと、これは、えーっと、Bみたいな感じだよ、わかるでしょ？"}, {"type": "subtitle", "time": 21610.548, "timestamp": "06:00:10", "text": "正義のバランスとか、そういうやつだよね？えっと"}, {"type": "subtitle", "time": 21613.788, "timestamp": "06:00:13", "text": "変換みたいなもの"}, {"type": "subtitle", "time": 21616.548, "timestamp": "06:00:16", "text": "あれ、なんて言うんだっけ？の"}, {"type": "subtitle", "time": 21620.23, "timestamp": "06:00:20", "text": "正義、あの黄金のチャル、聖杯じゃない"}, {"type": "subtitle", "time": 21623.19, "timestamp": "06:00:23", "text": "金色のもの、バランスをとるもの、物体"}, {"type": "subtitle", "time": 21626.31, "timestamp": "06:00:26", "text": "それは、"}, {"type": "subtitle", "time": 21628.39, "timestamp": "06:00:28", "text": "良い印象とネガティブな印象"}, {"type": "subtitle", "time": 21631.19, "timestamp": "06:00:31", "text": "印象みたいなもの、わかった、行くよ"}, {"type": "subtitle", "time": 21633.75, "timestamp": "06:00:33", "text": "今回はこれで失礼します"}, {"type": "subtitle", "time": 21636.23, "timestamp": "06:00:36", "text": "やらなければならない仕事がある やらなければならないことがある"}, {"type": "subtitle", "time": 21639.628, "timestamp": "06:00:39", "text": "ただ「いいよ」と言えば、それが私が"}, {"type": "subtitle", "time": 21643.03, "timestamp": "06:00:43", "text": "するが、どのように開始するか"}, {"type": "subtitle", "time": 21646.39, "timestamp": "06:00:46", "text": "その後の会話、翌日または"}, {"type": "subtitle", "time": 21649.15, "timestamp": "06:00:49", "text": "何か別のもの、"}, {"type": "subtitle", "time": 21653.19, "timestamp": "06:00:53", "text": "右？誰かに近づく場合"}, {"type": "subtitle", "time": 21656.23, "timestamp": "06:00:56", "text": "何か必要なものがあれば、あなたは"}, {"type": "subtitle", "time": 21659.35, "timestamp": "06:00:59", "text": "困窮者とみなされるか、"}]
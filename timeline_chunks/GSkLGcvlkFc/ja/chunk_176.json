[{"type": "subtitle", "time": 10578.79, "timestamp": "02:56:18", "text": "これ？私が何をしてこれを台無しにしたんだろう？わかった、"}, {"type": "subtitle", "time": 10581.99, "timestamp": "02:56:21", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 10588.99, "timestamp": "02:56:28", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 10593.309, "timestamp": "02:56:33", "text": "寝るんだよね？私は睡眠を優先した"}, {"type": "subtitle", "time": 10595.87, "timestamp": "02:56:35", "text": "ここ。そしてもし"}, {"type": "subtitle", "time": 10599.11, "timestamp": "02:56:39", "text": "私は泡を考えています。いいえ、私が置きました"}, {"type": "subtitle", "time": 10603.349, "timestamp": "02:56:43", "text": "その中。つまり、ここがそれですよね？しかし"}, {"type": "subtitle", "time": 10606.71, "timestamp": "02:56:46", "text": "2つ目の2つの絵文字が来たら、"}]
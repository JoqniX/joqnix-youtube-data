[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "これをコンポーネントに変換するには、ストロークを実行します。で"}, {"type": "subtitle", "time": 4083.349, "timestamp": "01:08:03", "text": "右側のサイドバーに新しい"}, {"type": "subtitle", "time": 4085.67, "timestamp": "01:08:05", "text": "バリエーションに関するセクション。コンポーネントセット"}, {"type": "subtitle", "time": 4087.27, "timestamp": "01:08:07", "text": "複数のバリエーションが必要"}, {"type": "subtitle", "time": 4089.51, "timestamp": "01:08:09", "text": "それらの中に。プラスアイコンをクリックしましょう"}, {"type": "subtitle", "time": 4091.309, "timestamp": "01:08:11", "text": "バリアントセクションで何を見るか"}, {"type": "subtitle", "time": 4093.99, "timestamp": "01:08:13", "text": "起こる。うわぁ。では、"}, {"type": "subtitle", "time": 4096.229, "timestamp": "01:08:16", "text": "変更しました。 Figma が私たちのコピーを作成しました"}, {"type": "subtitle", "time": 4098.229, "timestamp": "01:08:18", "text": "チェックボックスコンポーネントを配置し、両方を配置しました"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "新しいコンテナ内のコンポーネント。これ"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "コンテナは、"}, {"type": "subtitle", "time": 4104.229, "timestamp": "01:08:24", "text": "紫色の点線で識別できます"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "脳卒中。レイヤーパネルでは、"}, {"type": "subtitle", "time": 4108.789, "timestamp": "01:08:28", "text": "コンポーネントセットには同じ4つが含まれています"}, {"type": "subtitle", "time": 4110.709, "timestamp": "01:08:30", "text": "ダイヤモンドのアイコンは、"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "当社の部品。当社の各バリアント"}, {"type": "subtitle", "time": 4114.63, "timestamp": "01:08:34", "text": "コンポーネントセットには、塗りつぶされた単一のコンポーネントがあります。"}, {"type": "subtitle", "time": 4116.95, "timestamp": "01:08:36", "text": "ダイヤモンドのアイコン。レイヤーの名前"}, {"type": "subtitle", "time": 4119.43, "timestamp": "01:08:39", "text": "変更点もあります。前のテキスト"}, {"type": "subtitle", "time": 4121.91, "timestamp": "01:08:41", "text": "スラッシュチェックボックスの名前は"}, {"type": "subtitle", "time": 4124.39, "timestamp": "01:08:44", "text": "当社のコンポーネントセット。テキストの後に"}, {"type": "subtitle", "time": 4126.87, "timestamp": "01:08:46", "text": "スラッシュ チェックなしは、現在私たちの名前です"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "デフォルトバリアント。チェックボックスには"}, {"type": "subtitle", "time": 4131.03, "timestamp": "01:08:51", "text": "一般名に続いて昇順のアルファベットが続く"}, {"type": "subtitle", "time": 4133.829, "timestamp": "01:08:53", "text": "番号バリアント2レイヤー命名は"}, {"type": "subtitle", "time": 4135.43, "timestamp": "01:08:55", "text": "作成の重要な側面と"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "バリアントの管理。パネルとは異なり、"}, {"type": "subtitle", "time": 4139.55, "timestamp": "01:08:59", "text": "見る"}]
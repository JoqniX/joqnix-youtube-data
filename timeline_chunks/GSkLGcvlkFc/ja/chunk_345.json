[{"type": "subtitle", "time": 20706.23, "timestamp": "05:45:06", "text": "なぜ？猫は人間のものを食べる。"}, {"type": "subtitle", "time": 20708.47, "timestamp": "05:45:08", "text": "何？いいえ、それは違うと思います。"}, {"type": "subtitle", "time": 20712.548, "timestamp": "05:45:12", "text": "何？いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。何？"}, {"type": "subtitle", "time": 20715.91, "timestamp": "05:45:15", "text": "待って。本当に？何？何？私たちは本当に"}, {"type": "subtitle", "time": 20723.868, "timestamp": "05:45:23", "text": "右。全身と顔のように。"}, {"type": "subtitle", "time": 20727.67, "timestamp": "05:45:27", "text": "いいえ。いいえ。いいえ。私はそうは思いません。待って。待って。本当に？"}, {"type": "subtitle", "time": 20730.39, "timestamp": "05:45:30", "text": "待って。なるほど、分かりました。これについて聞いた"}, {"type": "subtitle", "time": 20740.47, "timestamp": "05:45:40", "text": "なぜ私がオーナーにそんなことをするの？"}, {"type": "subtitle", "time": 20743.39, "timestamp": "05:45:43", "text": "彼の世話をした人、そして"}, {"type": "subtitle", "time": 20747.07, "timestamp": "05:45:47", "text": "もの？少し良くなった。ああ、でも本当だよ。"}, {"type": "subtitle", "time": 20749.628, "timestamp": "05:45:49", "text": "ああ。うん。"}, {"type": "subtitle", "time": 20753.39, "timestamp": "05:45:53", "text": "なぜ？それは不気味だ。"}]
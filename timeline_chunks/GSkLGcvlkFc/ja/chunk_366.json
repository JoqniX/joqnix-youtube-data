[{"type": "subtitle", "time": 21962.51, "timestamp": "06:06:02", "text": "年。だから、でも私は"}, {"type": "subtitle", "time": 21965.47, "timestamp": "06:06:05", "text": "に"}, {"type": "subtitle", "time": 21968.39, "timestamp": "06:06:08", "text": "返事。大変だった。"}, {"type": "subtitle", "time": 21970.07, "timestamp": "06:06:10", "text": "彼らが「どうしたの？」と聞いてきたら、私はこう答える。"}, {"type": "subtitle", "time": 21972.948, "timestamp": "06:06:12", "text": "「ああ、私は元気です。私はそうしていましたし、"}, {"type": "subtitle", "time": 21975.43, "timestamp": "06:06:15", "text": "「だから。」でも、誰かが"}, {"type": "subtitle", "time": 21977.35, "timestamp": "06:06:17", "text": "「お元気ですか？」と尋ねてきます。 2つあります"}, {"type": "subtitle", "time": 21979.99, "timestamp": "06:06:19", "text": "それを行う方法。短い方を選んでください"}, {"type": "subtitle", "time": 21982.39, "timestamp": "06:06:22", "text": "バージョン。元気です。ああ、私は"}, {"type": "subtitle", "time": 21984.708, "timestamp": "06:06:24", "text": "大丈夫。絶好調です。ありがとう。"}, {"type": "subtitle", "time": 21987.03, "timestamp": "06:06:27", "text": "あなたはどうですか？そんな感じですね。あなた"}, {"type": "subtitle", "time": 21988.868, "timestamp": "06:06:28", "text": "長いバージョンでも構いません。私は"}, {"type": "subtitle", "time": 21992.868, "timestamp": "06:06:32", "text": "良い。目が覚めて、歯を磨いて、"}, {"type": "subtitle", "time": 21995.39, "timestamp": "06:06:35", "text": "一日を始めなくちゃ。あなたはどうですか、"}, {"type": "subtitle", "time": 21999.51, "timestamp": "06:06:39", "text": "兄弟？そんな感じですね。うん。そして、そして"}, {"type": "subtitle", "time": 22001.83, "timestamp": "06:06:41", "text": "うっかりカジュアルに切り替えてしまった"}, {"type": "subtitle", "time": 22005.39, "timestamp": "06:06:45", "text": "モード。それで私はそのことについて話す"}, {"type": "subtitle", "time": 22008.788, "timestamp": "06:06:48", "text": "調子はどうですか？の2番目のバージョン"}, {"type": "subtitle", "time": 22010.99, "timestamp": "06:06:50", "text": "誰かがあなたに尋ねます"}, {"type": "subtitle", "time": 22015.27, "timestamp": "06:06:55", "text": "それ。するとその人は「わかった」と言う"}, {"type": "subtitle", "time": 22017.67, "timestamp": "06:06:57", "text": "そこまで詳しく説明するようにとは頼んでいません。"}]
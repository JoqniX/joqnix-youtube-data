[{"type": "subtitle", "time": 7260.55, "timestamp": "02:01:00", "text": "10種類のバリエーションがあるのですが、私は"}, {"type": "subtitle", "time": 7262.47, "timestamp": "02:01:02", "text": "Figmaに何を伝える必要があるか"}, {"type": "subtitle", "time": 7263.99, "timestamp": "02:01:03", "text": "これら全てにおける違い。となることによって"}, {"type": "subtitle", "time": 7265.43, "timestamp": "02:01:05", "text": "ほら、これらは違うとさえ言われている"}, {"type": "subtitle", "time": 7267.51, "timestamp": "02:01:07", "text": "ゼロにしました。じゃあ、ダブルクリックするよ"}, {"type": "subtitle", "time": 7269.109, "timestamp": "02:01:09", "text": "変更するには、シフトキーを押しながら"}, {"type": "subtitle", "time": 7271.43, "timestamp": "02:01:11", "text": "両方ともゼロを選択します。これ"}, {"type": "subtitle", "time": 7291.589, "timestamp": "02:01:31", "text": "わかった。すぐにタイピング時間に入ります"}, {"type": "subtitle", "time": 7293.35, "timestamp": "02:01:33", "text": "それらの価値観における進歩について。私は"}, {"type": "subtitle", "time": 7296.31, "timestamp": "02:01:36", "text": "落ちる。つまり、ユーザーである私は選択できる"}, {"type": "subtitle", "time": 7297.91, "timestamp": "02:01:37", "text": "これらのうちどれが欲しいか。私は欲しいですか"}]
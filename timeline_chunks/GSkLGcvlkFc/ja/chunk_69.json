[{"type": "subtitle", "time": 4142.07, "timestamp": "01:09:02", "text": "変更しました。それでは、キーをチェックせずに使用します。"}, {"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "変異体。デフォルトの状態"}, {"type": "subtitle", "time": 4146.91, "timestamp": "01:09:06", "text": "チェックボックス。それでは、名前を変更します。"}, {"type": "subtitle", "time": 4149.03, "timestamp": "01:09:09", "text": "チェックボックス／チェックなし。コンポーネントセットは"}, {"type": "subtitle", "time": 4150.87, "timestamp": "01:09:10", "text": "コンポーネントからのみ作成できる。それで"}, {"type": "subtitle", "time": 4152.47, "timestamp": "01:09:12", "text": "キーボードショートカットを使用します"}, {"type": "subtitle", "time": 4154.87, "timestamp": "01:09:14", "text": "コマンドオプション K でこれを"}, {"type": "subtitle", "time": 4157.03, "timestamp": "01:09:17", "text": "成分。右側のサイドバーに、"}, {"type": "subtitle", "time": 4159.87, "timestamp": "01:09:19", "text": "新しいセクションがあります"}, {"type": "subtitle", "time": 4163.54, "timestamp": "01:09:23", "text": "変異体。私は少し理解できたと思う"}, {"type": "subtitle", "time": 4165.87, "timestamp": "01:09:25", "text": "[音楽]"}]
[{"type": "subtitle", "time": 22381.91, "timestamp": "06:13:01", "text": "16年間彼自身を、その後私は"}, {"type": "subtitle", "time": 22383.91, "timestamp": "06:13:03", "text": "息子よ、彼は自分で生きていかなければならないだろう"}, {"type": "subtitle", "time": 22386.14, "timestamp": "06:13:06", "text": "16年間、それから私は"}, {"type": "subtitle", "time": 22389.07, "timestamp": "06:13:09", "text": "[笑い]"}, {"type": "subtitle", "time": 22392.948, "timestamp": "06:13:12", "text": "オイゲン・ハンマの精神を取り戻す。おお"}, {"type": "subtitle", "time": 22397.19, "timestamp": "06:13:17", "text": "我が神よ。ユエン・ハンマとは誰ですか？何？誰が？"}, {"type": "subtitle", "time": 22408.43, "timestamp": "06:13:28", "text": "[音楽]"}, {"type": "subtitle", "time": 22414.99, "timestamp": "06:13:34", "text": "よお。ああ、この男は"}, {"type": "subtitle", "time": 22419.19, "timestamp": "06:13:39", "text": "バッキー出身の赤毛。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 22420.43, "timestamp": "06:13:40", "text": "それは"}, {"type": "subtitle", "time": 22424.708, "timestamp": "06:13:44", "text": "その間。こんにちは。こんにちは。元気ですか？"}, {"type": "subtitle", "time": 22427.03, "timestamp": "06:13:47", "text": "ベイキーを見たことがないの？私はそれを見ていません。"}, {"type": "subtitle", "time": 22429.99, "timestamp": "06:13:49", "text": "でも、その映像クリップは見たことがある。私は"}, {"type": "subtitle", "time": 22431.628, "timestamp": "06:13:51", "text": "ティックトッカー"}, {"type": "subtitle", "time": 22435.31, "timestamp": "06:13:55", "text": "実際にコスプレをしてコンテンツを作っているのは誰？"}, {"type": "subtitle", "time": 22439.15, "timestamp": "06:13:59", "text": "範馬勇次郎として。それ"}]
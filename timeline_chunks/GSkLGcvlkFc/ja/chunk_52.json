[{"type": "subtitle", "time": 3134.549, "timestamp": "00:52:14", "text": "財産。私は自分が何者なのか理解できません"}, {"type": "subtitle", "time": 3143.91, "timestamp": "00:52:23", "text": "テスト。何てことだ。理解できません"}, {"type": "subtitle", "time": 3147.19, "timestamp": "00:52:27", "text": "私がやっていること。"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "このコンポーネントには"}, {"type": "subtitle", "time": 3151.03, "timestamp": "00:52:31", "text": "変異体。背景色を変更します。"}, {"type": "subtitle", "time": 3152.95, "timestamp": "00:52:32", "text": "ファンシー。 Shift E。切り替えます"}, {"type": "subtitle", "time": 3155.47, "timestamp": "00:52:35", "text": "プロトタイプモード。さて、これは下がる"}, {"type": "subtitle", "time": 3158.47, "timestamp": "00:52:38", "text": "タップするとここに表示されます。いいえ。私たちは行く"}, {"type": "subtitle", "time": 3160.95, "timestamp": "00:52:40", "text": "ホバリングしながら進むと、"}, {"type": "subtitle", "time": 3163.19, "timestamp": "00:52:43", "text": "溶解する。はい、どうぞ。私はそれを引きずって"}, {"type": "subtitle", "time": 3178.71, "timestamp": "00:52:58", "text": "ええと、私たちが気づく最大の変化は"}]
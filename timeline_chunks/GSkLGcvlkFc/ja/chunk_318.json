[{"type": "subtitle", "time": 19083.03, "timestamp": "05:18:03", "text": "今日は夕方遅くに起きた。"}, {"type": "subtitle", "time": 19084.99, "timestamp": "05:18:04", "text": "夕方にならないように"}, {"type": "subtitle", "time": 19086.91, "timestamp": "05:18:06", "text": "のように"}, {"type": "subtitle", "time": 19090.11, "timestamp": "05:18:10", "text": "午後頃。ええ、午後の時間帯ですね。"}, {"type": "subtitle", "time": 19093.708, "timestamp": "05:18:13", "text": "しかし私は再び眠り始めた"}, {"type": "subtitle", "time": 19097.788, "timestamp": "05:18:17", "text": "もっと。うん。それで、そういう感じの"}, {"type": "subtitle", "time": 19101.27, "timestamp": "05:18:21", "text": "私にとってそれは、私が遅刻する原因になった"}, {"type": "subtitle", "time": 19103.708, "timestamp": "05:18:23", "text": "音声ファイルとその他すべてをビリーにアップロードしてください"}, {"type": "subtitle", "time": 19106.628, "timestamp": "05:18:26", "text": "ビリーと、私がやらなければならなかったすべてのこと"}, {"type": "subtitle", "time": 19109.03, "timestamp": "05:18:29", "text": "今日はこれで終わりです。そうですね、それはある意味"}, {"type": "subtitle", "time": 19118.03, "timestamp": "05:18:38", "text": "それ。わかった。"}, {"type": "subtitle", "time": 19121.35, "timestamp": "05:18:41", "text": "えっと、昨日は"}, {"type": "subtitle", "time": 19123.59, "timestamp": "05:18:43", "text": "ピンクの踏みつけ。えっと、待って。どうすればいいですか"}, {"type": "subtitle", "time": 19126.27, "timestamp": "05:18:46", "text": "これをもう一度発音してください。"}, {"type": "subtitle", "time": 19131.03, "timestamp": "05:18:51", "text": "えっと、ピン・トロンボーン。ピン・トロンボーン。うん。"}, {"type": "subtitle", "time": 19132.55, "timestamp": "05:18:52", "text": "それで、"}, {"type": "subtitle", "time": 19135.19, "timestamp": "05:18:55", "text": "ええと、それについては実験してみます"}, {"type": "subtitle", "time": 19138.15, "timestamp": "05:18:58", "text": "ピンというトロンボーンみたいなもの。うん。うん。良い"}]
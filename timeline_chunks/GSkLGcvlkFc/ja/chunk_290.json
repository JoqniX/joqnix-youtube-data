[{"type": "subtitle", "time": 17402.948, "timestamp": "04:50:02", "text": "待って、待って。スレッドIDを入力する必要があります。"}, {"type": "subtitle", "time": 17405.55, "timestamp": "04:50:05", "text": "右？そうそう。私"}, {"type": "subtitle", "time": 17409.15, "timestamp": "04:50:09", "text": "忘れた。スレッドをコピー"}, {"type": "subtitle", "time": 17412.47, "timestamp": "04:50:12", "text": "ID。えっと、スレッドID。私は変わる必要がある"}, {"type": "subtitle", "time": 17423.55, "timestamp": "04:50:23", "text": "保存。そして"}, {"type": "subtitle", "time": 17428.708, "timestamp": "04:50:28", "text": "これ。ここへ行ってください。ざまあみろ。ここへ行ってください。彼らは"}, {"type": "subtitle", "time": 17432.31, "timestamp": "04:50:32", "text": "ここに来て。拡張トリガーを設置してください。"}, {"type": "subtitle", "time": 17434.51, "timestamp": "04:50:34", "text": "そしてこれを置く"}, {"type": "subtitle", "time": 17437.91, "timestamp": "04:50:37", "text": "そこには。それで、"}, {"type": "subtitle", "time": 17447.51, "timestamp": "04:50:47", "text": "今、私は誰かが"}, {"type": "subtitle", "time": 17450.788, "timestamp": "04:50:50", "text": "配信に参加してください。もしくは、私が自分で配信することもできます。"}, {"type": "subtitle", "time": 17454.708, "timestamp": "04:50:54", "text": "えっと、皆さんはこれを注視してください"}]
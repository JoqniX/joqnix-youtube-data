[{"type": "subtitle", "time": 18255.15, "timestamp": "05:04:15", "text": "３つは、互いに続いていく。フルまたは"}, {"type": "subtitle", "time": 18258.39, "timestamp": "05:04:18", "text": "集中。フォーカスとはどういう意味ですか？そしてあなたは"}, {"type": "subtitle", "time": 18267.43, "timestamp": "05:04:27", "text": "集中する。リーダーボードシステムがあります。"}, {"type": "subtitle", "time": 18270.89, "timestamp": "05:04:30", "text": "あまりにも。どうすればいいのかわからない"}, {"type": "subtitle", "time": 18279.91, "timestamp": "05:04:39", "text": "それはリーダーボード用です。それは"}, {"type": "subtitle", "time": 18284.15, "timestamp": "05:04:44", "text": "手動で操作する方が良いです。"}, {"type": "subtitle", "time": 18287.19, "timestamp": "05:04:47", "text": "ストリームを編集するには"}, {"type": "subtitle", "time": 18289.55, "timestamp": "05:04:49", "text": "毎回"}, {"type": "subtitle", "time": 18293.43, "timestamp": "05:04:53", "text": "そうですよね、その方法の方が良いのではないでしょうか"}, {"type": "subtitle", "time": 18296.23, "timestamp": "05:04:56", "text": "リーダーボードに載るから、やれよ。いいえ、私たちは"}, {"type": "subtitle", "time": 18299.39, "timestamp": "05:04:59", "text": "ログはそれほど必要ありません"}]
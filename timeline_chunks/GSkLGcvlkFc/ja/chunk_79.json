[{"type": "subtitle", "time": 4741.59, "timestamp": "01:19:01", "text": "アセットパネルからお見せします"}, {"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "私がそれを渡した今、それが何をしたのか"}, {"type": "subtitle", "time": 4745.35, "timestamp": "01:19:05", "text": "進歩の特性とそれらの"}, {"type": "subtitle", "time": 4748.55, "timestamp": "01:19:08", "text": "値にはドロップダウンリストがあります。だから私は"}, {"type": "subtitle", "time": 4750.39, "timestamp": "01:19:10", "text": "これらのうちどれを選ぶかは自分で決められます。する"}, {"type": "subtitle", "time": 4751.99, "timestamp": "01:19:11", "text": "100が欲しいです。 25ドルでいいかな？私は"}, {"type": "subtitle", "time": 4753.83, "timestamp": "01:19:13", "text": "50が欲しいですか？もちろん、これで終わりではありません。"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "しかし、それが分散の仕組みなのです。それで"}, {"type": "subtitle", "time": 4761.27, "timestamp": "01:19:21", "text": "つまり、これらの2つのうちの1つが25であるすべての州"}, {"type": "subtitle", "time": 4764.07, "timestamp": "01:19:24", "text": "など。どれがどれかどうやってわかるのですか？"}, {"type": "subtitle", "time": 4766.149, "timestamp": "01:19:26", "text": "そのためには、もう一つ追加したい"}, {"type": "subtitle", "time": 4767.59, "timestamp": "01:19:27", "text": "財産。だから、私の"}, {"type": "subtitle", "time": 4769.669, "timestamp": "01:19:29", "text": "コンポーネントセットについて説明します"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "ここにプロパティがあり、新しいものを作成します"}, {"type": "subtitle", "time": 4773.59, "timestamp": "01:19:33", "text": "コンポーネントのプロパティ。それは"}, {"type": "subtitle", "time": 4775.43, "timestamp": "01:19:35", "text": "変異体。この物件は"}, {"type": "subtitle", "time": 4777.27, "timestamp": "01:19:37", "text": "テキストがあるか、ないかについて。"}, {"type": "subtitle", "time": 4778.95, "timestamp": "01:19:38", "text": "では、それをテキストと呼ぶことにします。そして、"}, {"type": "subtitle", "time": 4781.03, "timestamp": "01:19:41", "text": "ここでは真偽を使います。それで"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "私はこれら全てを選び、こう言います"}, {"type": "subtitle", "time": 4787.43, "timestamp": "01:19:47", "text": "真実。そして私はこれら全てを選びます"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "そして私は、それは間違いだと答えます。まず最初に、"}, {"type": "subtitle", "time": 4791.27, "timestamp": "01:19:51", "text": "もう警告は出ない"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "Figmaが幸せになったから。それは"}, {"type": "subtitle", "time": 4794.229, "timestamp": "01:19:54", "text": "区別するのに十分な情報"}, {"type": "subtitle", "time": 4795.83, "timestamp": "01:19:55", "text": "異なるバリエーション間で。私はただ"}, {"type": "subtitle", "time": 4798.07, "timestamp": "01:19:58", "text": "気づいたので修正します"}]
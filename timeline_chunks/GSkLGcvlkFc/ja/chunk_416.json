[{"type": "subtitle", "time": 24962.83, "timestamp": "06:56:02", "text": "通常。待って、聞こえる？"}, {"type": "subtitle", "time": 24964.59, "timestamp": "06:56:04", "text": "それ？"}, {"type": "subtitle", "time": 24973.83, "timestamp": "06:56:13", "text": "もの。ええ、それが普通です。だから私は"}, {"type": "subtitle", "time": 24983.67, "timestamp": "06:56:23", "text": "虫歯か何か。"}, {"type": "subtitle", "time": 24986.43, "timestamp": "06:56:26", "text": "これは何の舌ですか"}, {"type": "subtitle", "time": 24993.59, "timestamp": "06:56:33", "text": "[音楽]"}, {"type": "subtitle", "time": 24995.91, "timestamp": "06:56:35", "text": "うん、文字通り遊んでみてもいいよ"}, {"type": "subtitle", "time": 25000.39, "timestamp": "06:56:40", "text": "これで。でも、これは楽しいですね。"}, {"type": "subtitle", "time": 25010.15, "timestamp": "06:56:50", "text": "おお。いや、いや、いや、いや。何てことだ。あなたはできる"}, {"type": "subtitle", "time": 25013.39, "timestamp": "06:56:53", "text": "本当に楽しいことをたくさんする"}, {"type": "subtitle", "time": 25016.99, "timestamp": "06:56:56", "text": "これ。声を変えることができます"}]
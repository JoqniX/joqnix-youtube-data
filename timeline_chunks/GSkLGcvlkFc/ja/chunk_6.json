[{"type": "subtitle", "time": 363.35, "timestamp": "00:06:03", "text": "昨日。だから、私たちはそれを実行しているのです。こんにちは、私は"}, {"type": "subtitle", "time": 366.71, "timestamp": "00:06:06", "text": "それも削除できます。それはそれ上で生きている"}, {"type": "subtitle", "time": 370.55, "timestamp": "00:06:10", "text": "あらゆる輝きのために存在する。わかった。それで、"}, {"type": "subtitle", "time": 375.11, "timestamp": "00:06:15", "text": "明日は5月ですよね？"}, {"type": "subtitle", "time": 378.23, "timestamp": "00:06:18", "text": "それはつまり、3年が経過したということだ"}, {"type": "subtitle", "time": 381.909, "timestamp": "00:06:21", "text": "正式には3ヶ月が経過しました"}, {"type": "subtitle", "time": 385.029, "timestamp": "00:06:25", "text": "24時間配信を毎日行っています"}, {"type": "subtitle", "time": 389.55, "timestamp": "00:06:29", "text": "一日。 24時間。ええと、ある意味で私は"}, {"type": "subtitle", "time": 392.79, "timestamp": "00:06:32", "text": "約1,000に及ぶ"}, {"type": "subtitle", "time": 396.67, "timestamp": "00:06:36", "text": "えっと、ちょっと確認させてください。3月12日から4月"}, {"type": "subtitle", "time": 399.23, "timestamp": "00:06:39", "text": "30歳と"}, {"type": "subtitle", "time": 403.79, "timestamp": "00:06:43", "text": "私たちが横断した時間"}, {"type": "subtitle", "time": 406.59000000000003, "timestamp": "00:06:46", "text": "1.76時間"}, {"type": "subtitle", "time": 409.15, "timestamp": "00:06:49", "text": "正式に"}, {"type": "subtitle", "time": 413.83, "timestamp": "00:06:53", "text": "やったー！自分の記録を破れて本当に誇りに思うよ"}, {"type": "subtitle", "time": 417.469, "timestamp": "00:06:57", "text": "自分たちのレコードは最善を尽くしたので、"}]
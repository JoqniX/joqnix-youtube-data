[{"type": "subtitle", "time": 21185.67, "timestamp": "05:53:05", "text": "何をしているの？私はたくさんの"}, {"type": "subtitle", "time": 21188.23, "timestamp": "05:53:08", "text": "最近の映画。ああ、何を見たの？"}, {"type": "subtitle", "time": 21204.03, "timestamp": "05:53:24", "text": "いいね。ああ、映画を見るのが恋しいし、"}, {"type": "subtitle", "time": 21206.868, "timestamp": "05:53:26", "text": "もの。最後に見たのは"}, {"type": "subtitle", "time": 21209.75, "timestamp": "05:53:29", "text": "あのスパイダーマンの映画と"}, {"type": "subtitle", "time": 21214.07, "timestamp": "05:53:34", "text": "えっと、ヴェノムの方ですね。それでおしまい。"}, {"type": "subtitle", "time": 21218.03, "timestamp": "05:53:38", "text": "そして、えっと、私は始めたと思います"}, {"type": "subtitle", "time": 21221.47, "timestamp": "05:53:41", "text": "ジョン・ヴィックを見ているが、"}, {"type": "subtitle", "time": 21223.83, "timestamp": "05:53:43", "text": "停止しました。ええ、私はそれを続けませんでした"}, {"type": "subtitle", "time": 21226.39, "timestamp": "05:53:46", "text": "私は推測する。ジョン・ヴィック2番か3番"}, {"type": "subtitle", "time": 21227.31, "timestamp": "05:53:47", "text": "たぶん"}, {"type": "subtitle", "time": 21230.27, "timestamp": "05:53:50", "text": "忘れた。私は見ませんでした"}, {"type": "subtitle", "time": 21233.35, "timestamp": "05:53:53", "text": "それ。ナイトクローラー、囚人、"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "惑星と分離。ああ、私は決して"}, {"type": "subtitle", "time": 21238.99, "timestamp": "05:53:58", "text": "これらのどれかについて聞いたことがありますか。"}]
[{"type": "subtitle", "time": 18302.67, "timestamp": "05:05:02", "text": "リーダーボード。必要なのは"}, {"type": "subtitle", "time": 18305.75, "timestamp": "05:05:05", "text": "手動で、手動以外で、"}, {"type": "subtitle", "time": 18308.788, "timestamp": "05:05:08", "text": "自動的に、動的に編集する"}, {"type": "subtitle", "time": 18310.788, "timestamp": "05:05:10", "text": "見ている、見ていない、見ている"}, {"type": "subtitle", "time": 18313.07, "timestamp": "05:05:13", "text": "活動的ではない人"}, {"type": "subtitle", "time": 18316.708, "timestamp": "05:05:16", "text": "アクティブ。右？このリーダーボードセクション"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "誰かが来ると、こちらでは"}, {"type": "subtitle", "time": 18321.99, "timestamp": "05:05:21", "text": "リーダーボードのステータス、チャットできます"}, {"type": "subtitle", "time": 18324.47, "timestamp": "05:05:24", "text": "1つ。二人いる場合は、おしゃべり"}, {"type": "subtitle", "time": 18328.31, "timestamp": "05:05:28", "text": "二。だから、ここで一つ注意しておかなければならないのは"}, {"type": "subtitle", "time": 18331.788, "timestamp": "05:05:31", "text": "どうすればここでチャットする人たちの"}, {"type": "subtitle", "time": 18333.868, "timestamp": "05:05:33", "text": "リーダーボード。つまり"}, {"type": "subtitle", "time": 18347.788, "timestamp": "05:05:47", "text": "ランキングイベント"}, {"type": "subtitle", "time": 18356.59, "timestamp": "05:05:56", "text": "オンラインランキングの更新を準備してください。うん、これ"}]
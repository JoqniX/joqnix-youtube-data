[{"type": "subtitle", "time": 22981.43, "timestamp": "06:23:01", "text": "でも、みんなが心配してる"}, {"type": "subtitle", "time": 22985.43, "timestamp": "06:23:05", "text": "来て出席するのに十分な時間があります"}, {"type": "subtitle", "time": 22986.59, "timestamp": "06:23:06", "text": "これら"}, {"type": "subtitle", "time": 22991.07, "timestamp": "06:23:11", "text": "もの。それはまるで社交の集まりのようだ。"}, {"type": "subtitle", "time": 22993.51, "timestamp": "06:23:13", "text": "いいえ。ええ。だから私は"}, {"type": "subtitle", "time": 23002.27, "timestamp": "06:23:22", "text": "[音楽]"}, {"type": "subtitle", "time": 23006.27, "timestamp": "06:23:26", "text": "まるで何も見えないみたいだ。待って。"}, {"type": "subtitle", "time": 23008.11, "timestamp": "06:23:28", "text": "ああ、どこ"}, {"type": "subtitle", "time": 23013.23, "timestamp": "06:23:33", "text": "ああ、すごく汗をかいている。私の顔は"}, {"type": "subtitle", "time": 23016.15, "timestamp": "06:23:36", "text": "発汗。そして私はシャツを拭き続けた。"}, {"type": "subtitle", "time": 23018.43, "timestamp": "06:23:38", "text": "だから、私は自分の"}, {"type": "subtitle", "time": 23021.43, "timestamp": "06:23:41", "text": "眼鏡をかけていて、私は法定盲目です"}, {"type": "subtitle", "time": 23023.91, "timestamp": "06:23:43", "text": "眼鏡をかけていない。文字通り、"}, {"type": "subtitle", "time": 23026.39, "timestamp": "06:23:46", "text": "全てがぼやけている。私は字も読めない。"}, {"type": "subtitle", "time": 23028.708, "timestamp": "06:23:48", "text": "すべては、ほら、あなたが"}, {"type": "subtitle", "time": 23033.11, "timestamp": "06:23:53", "text": "曇ったガラス越しに交通を眺める、"}, {"type": "subtitle", "time": 23035.67, "timestamp": "06:23:55", "text": "窓のようなもの、"}, {"type": "subtitle", "time": 23038.03, "timestamp": "06:23:58", "text": "雨が降っていて霧が出ている、または"}]
[{"type": "subtitle", "time": 20280.708, "timestamp": "05:38:00", "text": "周りとか色々。うん、それは"}, {"type": "subtitle", "time": 20282.788, "timestamp": "05:38:02", "text": "うん、それはすごくクールだね。いいえ、私は私の"}, {"type": "subtitle", "time": 20286.23, "timestamp": "05:38:06", "text": "猫はそうする。ああ、うちの猫は"}, {"type": "subtitle", "time": 20289.31, "timestamp": "05:38:09", "text": "彼女を撫でてあげた。"}, {"type": "subtitle", "time": 20292.47, "timestamp": "05:38:12", "text": "なぜ？うちの猫は撫でられるのを嫌がる"}, {"type": "subtitle", "time": 20295.43, "timestamp": "05:38:15", "text": "彼女。彼女は逃げ出してしまった。そして最近、"}, {"type": "subtitle", "time": 20298.15, "timestamp": "05:38:18", "text": "それは3人の小さな子供を産みました"}, {"type": "subtitle", "time": 20301.43, "timestamp": "05:38:21", "text": "子猫たち。そしてそれは私のベッドの下にある"}, {"type": "subtitle", "time": 20305.35, "timestamp": "05:38:25", "text": "彼女は子猫たちと遊んでいる"}, {"type": "subtitle", "time": 20309.43, "timestamp": "05:38:29", "text": "とか、そういうこと、ええ、そうですね。だから私はできない"}, {"type": "subtitle", "time": 20312.35, "timestamp": "05:38:32", "text": "私ですら下へ降りて見に行くことすらできない"}, {"type": "subtitle", "time": 20315.03, "timestamp": "05:38:35", "text": "なぜなら、私が"}, {"type": "subtitle", "time": 20318.07, "timestamp": "05:38:38", "text": "それを見た、あるいは私の家族の誰かが"}, {"type": "subtitle", "time": 20321.27, "timestamp": "05:38:41", "text": "それを見ると、"}, {"type": "subtitle", "time": 20323.75, "timestamp": "05:38:43", "text": "場所。知らなかったら、猫が"}, {"type": "subtitle", "time": 20327.43, "timestamp": "05:38:47", "text": "出産する、もしくは出産する"}, {"type": "subtitle", "time": 20330.15, "timestamp": "05:38:50", "text": "子猫とかが好きで、彼らは"}, {"type": "subtitle", "time": 20333.548, "timestamp": "05:38:53", "text": "場所を変更する"}, {"type": "subtitle", "time": 20337.628, "timestamp": "05:38:57", "text": "7回くらいの場所か"}]
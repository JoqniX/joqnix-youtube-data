[{"type": "subtitle", "time": 22142.948, "timestamp": "06:09:02", "text": "知らなかった。わかった。私は、もし私が"}, {"type": "subtitle", "time": 22145.43, "timestamp": "06:09:05", "text": "初めて誰かと話す"}, {"type": "subtitle", "time": 22148.39, "timestamp": "06:09:08", "text": "そして私は彼らとたくさん話をして"}, {"type": "subtitle", "time": 22151.07, "timestamp": "06:09:11", "text": "自動的に"}, {"type": "subtitle", "time": 22155.19, "timestamp": "06:09:15", "text": "友達だけど、相手はそうじゃないだろう"}, {"type": "subtitle", "time": 22158.15, "timestamp": "06:09:18", "text": "彼らにはそれぞれ異なる権利がある"}, {"type": "subtitle", "time": 22162.07, "timestamp": "06:09:22", "text": "彼らのシステム、彼ら自身のために"}, {"type": "subtitle", "time": 22164.868, "timestamp": "06:09:24", "text": "そう、つまりそれは人に依存しているということだ"}, {"type": "subtitle", "time": 22169.23, "timestamp": "06:09:29", "text": "すべての人に、愛を。"}, {"type": "subtitle", "time": 22171.91, "timestamp": "06:09:31", "text": "ええ、こんなことがあったなんて知りませんでした"}, {"type": "subtitle", "time": 22173.948, "timestamp": "06:09:33", "text": "人々"}, {"type": "subtitle", "time": 22176.83, "timestamp": "06:09:36", "text": "する。"}, {"type": "subtitle", "time": 22179.19, "timestamp": "06:09:39", "text": "えっと、兄貴はみんなと話したよ"}, {"type": "subtitle", "time": 22182.11, "timestamp": "06:09:42", "text": "自動的に友達になった。"}, {"type": "subtitle", "time": 22186.19, "timestamp": "06:09:46", "text": "うん、友達みたいな感じかな"}, {"type": "subtitle", "time": 22188.868, "timestamp": "06:09:48", "text": "あれ。ああ、私は見ていたから"}, {"type": "subtitle", "time": 22195.51, "timestamp": "06:09:55", "text": "もの。ああ、それはフレンズになるだろう"}]
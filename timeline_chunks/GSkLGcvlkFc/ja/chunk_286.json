[{"type": "subtitle", "time": 17165.59, "timestamp": "04:46:05", "text": "よし、じゃあビリーのことをやろう。わかった、"}, {"type": "subtitle", "time": 17169.11, "timestamp": "04:46:09", "text": "つまり、スコアのバックエンドイベントです。これは、えーと"}, {"type": "subtitle", "time": 17172.47, "timestamp": "04:46:12", "text": "これらはすべてYouTubeのコンテンツです。"}, {"type": "subtitle", "time": 17175.27, "timestamp": "04:46:15", "text": "YouTube 登録者、スーパーチャット、スーパー"}, {"type": "subtitle", "time": 17178.07, "timestamp": "04:46:18", "text": "ステッカー、スーパーメンバー、その他諸々。"}, {"type": "subtitle", "time": 17187.868, "timestamp": "04:46:27", "text": "[音楽]"}, {"type": "subtitle", "time": 17192.07, "timestamp": "04:46:32", "text": "そのプラットフォーム。いや。ここは一体どこだ？"}, {"type": "subtitle", "time": 17194.27, "timestamp": "04:46:34", "text": "プラットフォームを取得する予定"}, {"type": "subtitle", "time": 17200.75, "timestamp": "04:46:40", "text": "[音楽]"}, {"type": "subtitle", "time": 17204.27, "timestamp": "04:46:44", "text": "えっと、私は思う"}, {"type": "subtitle", "time": 17208.19, "timestamp": "04:46:48", "text": "えっと、これってトリガータイプみたいなものですよね？"}, {"type": "subtitle", "time": 17211.99, "timestamp": "04:46:51", "text": "わかった。トリガーの種類。だから私は"}]
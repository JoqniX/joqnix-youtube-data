[{"type": "subtitle", "time": 22747.07, "timestamp": "06:19:07", "text": "バッキー、おめでとう。"}, {"type": "subtitle", "time": 22750.15, "timestamp": "06:19:10", "text": "推測。配信へようこ​​そ、アカビさん。"}, {"type": "subtitle", "time": 22752.548, "timestamp": "06:19:12", "text": "こんにちは。"}, {"type": "subtitle", "time": 22754.67, "timestamp": "06:19:14", "text": "そして、陰謀論は部屋から出て行った。"}, {"type": "subtitle", "time": 22758.23, "timestamp": "06:19:18", "text": "ああ、新しいケン・アシュラ対決は要らない"}, {"type": "subtitle", "time": 22760.07, "timestamp": "06:19:20", "text": "ベイク映画だけど、まだ見てない"}, {"type": "subtitle", "time": 22763.27, "timestamp": "06:19:23", "text": "アシュラシリーズはまだです。ああ、見ていない"}, {"type": "subtitle", "time": 22765.67, "timestamp": "06:19:25", "text": "このBaky and Ashiraシリーズまたは"}, {"type": "subtitle", "time": 22768.67, "timestamp": "06:19:28", "text": "これらはまだです。だから、私はあまり知らない"}, {"type": "subtitle", "time": 22772.31, "timestamp": "06:19:32", "text": "これ。私が知っているのはベイキーとかそういう類のことだけです。ベイク"}, {"type": "subtitle", "time": 22774.99, "timestamp": "06:19:34", "text": "バーサーカーとかはかっこいいし"}, {"type": "subtitle", "time": 22779.15, "timestamp": "06:19:39", "text": "良い。また、"}, {"type": "subtitle", "time": 22782.59, "timestamp": "06:19:42", "text": "詳細な伝承やストーリーなどを"}, {"type": "subtitle", "time": 22785.47, "timestamp": "06:19:45", "text": "それとかそういう類。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 22795.19, "timestamp": "06:19:55", "text": "知る。つまりバキは漫画と同等だ"}]
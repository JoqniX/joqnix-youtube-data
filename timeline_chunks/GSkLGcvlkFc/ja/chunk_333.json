[{"type": "subtitle", "time": 19982.788, "timestamp": "05:33:02", "text": "もしくは、これに使えるような何か。えっと、"}, {"type": "subtitle", "time": 19986.31, "timestamp": "05:33:06", "text": "味が薄すぎるよね？つまり、私は"}, {"type": "subtitle", "time": 19996.15, "timestamp": "05:33:16", "text": "Oは、私のPiが壊れているだけです。待って、ちょっと"}, {"type": "subtitle", "time": 19999.51, "timestamp": "05:33:19", "text": "一時停止しますか？ああ、一時停止できるよ。それ"}, {"type": "subtitle", "time": 20002.27, "timestamp": "05:33:22", "text": "作品。そうである必要はない"}, {"type": "subtitle", "time": 20004.19, "timestamp": "05:33:24", "text": "移動中。"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "ああ、私はすべての人々が必要としていると思う"}, {"type": "subtitle", "time": 20009.03, "timestamp": "05:33:29", "text": "プライバシー、特に有名人のプライバシーは重要だ。はい、"}, {"type": "subtitle", "time": 20011.51, "timestamp": "05:33:31", "text": "もちろん。もちろん。ストーカー行為をする人もいる"}, {"type": "subtitle", "time": 20013.99, "timestamp": "05:33:33", "text": "彼らのアイドルであり、それは正しくありません。"}, {"type": "subtitle", "time": 20018.548, "timestamp": "05:33:38", "text": "真実。それは本当です。それは本当です。うん、それ"}, {"type": "subtitle", "time": 20021.51, "timestamp": "05:33:41", "text": "それは本当です。それが現実だ。人々"}, {"type": "subtitle", "time": 20023.548, "timestamp": "05:33:43", "text": "そうして"}, {"type": "subtitle", "time": 20028.43, "timestamp": "05:33:48", "text": "すべて。一方、私はこれの背後にいる"}, {"type": "subtitle", "time": 20031.51, "timestamp": "05:33:51", "text": "会話。私を知っている人の中には"}, {"type": "subtitle", "time": 20035.03, "timestamp": "05:33:55", "text": "知ってるよ、えっと、私はある意味、"}, {"type": "subtitle", "time": 20038.548, "timestamp": "05:33:58", "text": "ストーカー行為。悪い意味ではなくて。わかった。"}]
[{"type": "subtitle", "time": 22081.788, "timestamp": "06:08:01", "text": "知り合い"}, {"type": "subtitle", "time": 22085.67, "timestamp": "06:08:05", "text": "そして私はたまたまこの人を知っていた"}, {"type": "subtitle", "time": 22089.43, "timestamp": "06:08:09", "text": "などなど、あるいはそのカテゴリーの見知らぬ人。"}, {"type": "subtitle", "time": 22092.91, "timestamp": "06:08:12", "text": "うん。うん。うん。そして、"}, {"type": "subtitle", "time": 22097.708, "timestamp": "06:08:17", "text": "えーと、そのシステムって何て言うんだっけ？"}, {"type": "subtitle", "time": 22101.83, "timestamp": "06:08:21", "text": "それは一部の人にとっては、"}, {"type": "subtitle", "time": 22103.91, "timestamp": "06:08:23", "text": "友人として他の人と"}, {"type": "subtitle", "time": 22106.31, "timestamp": "06:08:26", "text": "1ヶ月か2ヶ月か3ヶ月くらいかな"}, {"type": "subtitle", "time": 22108.948, "timestamp": "06:08:28", "text": "多数の量に応じて"}, {"type": "subtitle", "time": 22113.11, "timestamp": "06:08:33", "text": "相互作用。会話は終了しましたか、"}, {"type": "subtitle", "time": 22115.91, "timestamp": "06:08:35", "text": "他の人と同じように、"}, {"type": "subtitle", "time": 22119.99, "timestamp": "06:08:39", "text": "彼らと知り合った後、友人として"}, {"type": "subtitle", "time": 22122.07, "timestamp": "06:08:42", "text": "彼らがどんな人かなどを知って、"}, {"type": "subtitle", "time": 22125.43, "timestamp": "06:08:45", "text": "何年もそれらに慣れているなど"}, {"type": "subtitle", "time": 22128.31, "timestamp": "06:08:48", "text": "そして彼らを友人として見るか"}, {"type": "subtitle", "time": 22137.99, "timestamp": "06:08:57", "text": "ああ、私は苦労して学んだんだ"}]
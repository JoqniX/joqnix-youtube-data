[{"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "城。私はたくさんのキャンディーを持っています"}, {"type": "subtitle", "time": 2166.95, "timestamp": "00:36:06", "text": "引き出し。私はそれを一つずつ食べます"}, {"type": "subtitle", "time": 2168.87, "timestamp": "00:36:08", "text": "ゆっくり。"}, {"type": "subtitle", "time": 2212.79, "timestamp": "00:36:52", "text": "良い。今日はずっと走っていて、"}]
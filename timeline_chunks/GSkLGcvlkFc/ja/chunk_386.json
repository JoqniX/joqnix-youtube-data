[{"type": "subtitle", "time": 23165.43, "timestamp": "06:26:05", "text": "ゴキブリ。久しぶりですね。それ"}, {"type": "subtitle", "time": 23167.67, "timestamp": "06:26:07", "text": "漫画。いや、あの漫画やアニメだよ。ない"}, {"type": "subtitle", "time": 23169.91, "timestamp": "06:26:09", "text": "アニメ。これはアニメですか？これは最高の漫画です"}, {"type": "subtitle", "time": 23172.07, "timestamp": "06:26:12", "text": "けれど。アニメだけど、アニメじゃない"}, {"type": "subtitle", "time": 23175.19, "timestamp": "06:26:15", "text": "けれど。待って、漫画。私はそれをこう呼ぶことにします"}, {"type": "subtitle", "time": 23177.708, "timestamp": "06:26:17", "text": "アニメシリーズ。わかった。わかった、"}, {"type": "subtitle", "time": 23185.07, "timestamp": "06:26:25", "text": "それ。以前はテレビで見ていたと思う"}, {"type": "subtitle", "time": 23188.47, "timestamp": "06:26:28", "text": "ナロルディアン。おそらくほとんどヒンディー語だったと思います"}, {"type": "subtitle", "time": 23197.548, "timestamp": "06:26:37", "text": "理解します"}, {"type": "subtitle", "time": 23200.35, "timestamp": "06:26:40", "text": "ゴキブリ。"}, {"type": "subtitle", "time": 23204.59, "timestamp": "06:26:44", "text": "いや、うん、あれは楽しいアニメだったよ。私"}, {"type": "subtitle", "time": 23207.13, "timestamp": "06:26:47", "text": "できると思う"}]
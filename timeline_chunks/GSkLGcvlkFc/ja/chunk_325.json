[{"type": "subtitle", "time": 19505.788, "timestamp": "05:25:05", "text": "トレーニング。私のパソコン、すごく調子が悪いんです。"}, {"type": "subtitle", "time": 19514.27, "timestamp": "05:25:14", "text": "D 私はすべて着ました"}, {"type": "subtitle", "time": 19518.75, "timestamp": "05:25:18", "text": "低くて、あなたは苦労している。言い訳"}, {"type": "subtitle", "time": 19522.67, "timestamp": "05:25:22", "text": "自分。うん、そうする必要があると思う"}, {"type": "subtitle", "time": 19533.35, "timestamp": "05:25:33", "text": "うん。ああ、大変だ。少なくとも私はそう願っています"}, {"type": "subtitle", "time": 19537.27, "timestamp": "05:25:37", "text": "聞こえて見えてはっきりしていて"}, {"type": "subtitle", "time": 19538.62, "timestamp": "05:25:38", "text": "ストリームが実行中です"}, {"type": "subtitle", "time": 19539.708, "timestamp": "05:25:39", "text": "[音楽]"}, {"type": "subtitle", "time": 19546.03, "timestamp": "05:25:46", "text": "おそらくそうでしょう"}, {"type": "subtitle", "time": 19549.708, "timestamp": "05:25:49", "text": "は。ええ、私は"}, {"type": "subtitle", "time": 19556.55, "timestamp": "05:25:56", "text": "わかった。少し下げてあげよう"}, {"type": "subtitle", "time": 19558.44, "timestamp": "05:25:58", "text": "もう少し。"}]
[{"type": "subtitle", "time": 18730.55, "timestamp": "05:12:10", "text": "次に、チェーンが必要です。これを変更する"}, {"type": "subtitle", "time": 18731.97, "timestamp": "05:12:11", "text": "もの"}, {"type": "subtitle", "time": 18734.99, "timestamp": "05:12:14", "text": "[音楽]"}, {"type": "subtitle", "time": 18739.15, "timestamp": "05:12:19", "text": "あまりにも。しかし、なぜもう片方はそうではないのか"}, {"type": "subtitle", "time": 18765.44, "timestamp": "05:12:45", "text": "行く。"}, {"type": "subtitle", "time": 18769.948, "timestamp": "05:12:49", "text": "[音楽]"}, {"type": "subtitle", "time": 18773.19, "timestamp": "05:12:53", "text": "ええ、そうですね。こんにちは、ミナさん。皆さんが"}, {"type": "subtitle", "time": 18774.11, "timestamp": "05:12:54", "text": "行う"}, {"type": "subtitle", "time": 18777.948, "timestamp": "05:12:57", "text": "良い。皆さんお元気でお過ごしでしょうか。"}]
[{"type": "subtitle", "time": 22020.83, "timestamp": "06:07:00", "text": "わかった。そういう感じ"}, {"type": "subtitle", "time": 22027.11, "timestamp": "06:07:07", "text": "長いバージョンはよりカジュアルなだけです"}, {"type": "subtitle", "time": 22041.75, "timestamp": "06:07:21", "text": "うん。そして私が学んだことの一つは"}, {"type": "subtitle", "time": 22046.99, "timestamp": "06:07:26", "text": "時間が経つにつれてインターネット上にいると"}, {"type": "subtitle", "time": 22050.23, "timestamp": "06:07:30", "text": "えっと、またしても誰も現実世界では教えてくれないよ。わかった、"}, {"type": "subtitle", "time": 22052.39, "timestamp": "06:07:32", "text": "教えてあげましょう。誰も教えてくれない。"}, {"type": "subtitle", "time": 22054.31, "timestamp": "06:07:34", "text": "彼らはあなたがこれらを知っていることを期待しているだけです"}, {"type": "subtitle", "time": 22057.19, "timestamp": "06:07:37", "text": "どこからともなく。私は、誰も"}, {"type": "subtitle", "time": 22058.868, "timestamp": "06:07:38", "text": "私にこれを教えてくれたので、私はそれを解明しなければならなかった"}, {"type": "subtitle", "time": 22061.27, "timestamp": "06:07:41", "text": "自分自身。少なくとも私にとっては"}, {"type": "subtitle", "time": 22063.39, "timestamp": "06:07:43", "text": "のように"}, {"type": "subtitle", "time": 22067.43, "timestamp": "06:07:47", "text": "えっと、もしあなたが知っているなら"}, {"type": "subtitle", "time": 22069.15, "timestamp": "06:07:49", "text": "人"}, {"type": "subtitle", "time": 22072.91, "timestamp": "06:07:52", "text": "ちょうどその時、そのタイプが戻ってきました"}, {"type": "subtitle", "time": 22075.31, "timestamp": "06:07:55", "text": "あれ"}, {"type": "subtitle", "time": 22079.19, "timestamp": "06:07:59", "text": "友情みたいなもの"}]
[{"type": "subtitle", "time": 23281.628, "timestamp": "06:28:01", "text": "上ですよね？ビーンマックスとかいうやつ。ビーン"}, {"type": "subtitle", "time": 23286.11, "timestamp": "06:28:06", "text": "豆。名前を忘れてしまった。"}, {"type": "subtitle", "time": 23289.67, "timestamp": "06:28:09", "text": "えっと、実は名前をすっかり忘れてしまいました。"}, {"type": "subtitle", "time": 23290.69, "timestamp": "06:28:10", "text": "えっと"}, {"type": "subtitle", "time": 23293.11, "timestamp": "06:28:13", "text": "[音楽]"}, {"type": "subtitle", "time": 23296.75, "timestamp": "06:28:16", "text": "えーと、ビーンキラー。そう、それだ。ビーン"}, {"type": "subtitle", "time": 23300.628, "timestamp": "06:28:20", "text": "キラー。見たよ。それはまるで、うわあ、"}, {"type": "subtitle", "time": 23308.67, "timestamp": "06:28:28", "text": "それは私にそんな雰囲気を感じさせた"}, {"type": "subtitle", "time": 23311.868, "timestamp": "06:28:31", "text": "えっと、それは私に"}, {"type": "subtitle", "time": 23314.708, "timestamp": "06:28:34", "text": "えっと、なんて呼ぶんですか？それは私に"}, {"type": "subtitle", "time": 23315.52, "timestamp": "06:28:35", "text": "雰囲気"}, {"type": "subtitle", "time": 23317.31, "timestamp": "06:28:37", "text": "[音楽]"}, {"type": "subtitle", "time": 23320.59, "timestamp": "06:28:40", "text": "えっと、何のことか忘れちゃったけど、"}, {"type": "subtitle", "time": 23325.59, "timestamp": "06:28:45", "text": "えっと、あのメキシコのゲーム、メキシコをテーマにしたやつ"}, {"type": "subtitle", "time": 23327.83, "timestamp": "06:28:47", "text": "スローモーションと"}, {"type": "subtitle", "time": 23331.23, "timestamp": "06:28:51", "text": "もの。あなたは、えっと、あなたは"}, {"type": "subtitle", "time": 23334.07, "timestamp": "06:28:54", "text": "えっと、そのゲームの名前は何ですか？私"}, {"type": "subtitle", "time": 23337.788, "timestamp": "06:28:57", "text": "忘れた。それは古い"}]
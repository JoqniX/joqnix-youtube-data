[{"type": "subtitle", "time": 242.63, "timestamp": "00:04:02", "text": "ウィザリング・ウェーブスとマーベル・ライバルズ"}, {"type": "subtitle", "time": 244.429, "timestamp": "00:04:04", "text": "昨日、そして私は"}, {"type": "subtitle", "time": 246.789, "timestamp": "00:04:06", "text": "それらを装着せずに寝た"}, {"type": "subtitle", "time": 250.99, "timestamp": "00:04:10", "text": "ダウンロード。私は本当にバカだけど、"}, {"type": "subtitle", "time": 253.429, "timestamp": "00:04:13", "text": "わかった。全く問題ありません。大丈夫。"}, {"type": "subtitle", "time": 256.15, "timestamp": "00:04:16", "text": "まだダウンロード中です。もうすぐ99"}, {"type": "subtitle", "time": 261.469, "timestamp": "00:04:21", "text": "現時点で98％です。 95%。わかった。"}, {"type": "subtitle", "time": 264.07, "timestamp": "00:04:24", "text": "ええと、それは今日ダウンロードされます。何"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "チェックリストがあれば、"}, {"type": "subtitle", "time": 269.67, "timestamp": "00:04:29", "text": "私たちがやらなければならないことのタスクリスト。 1つは"}, {"type": "subtitle", "time": 272.71, "timestamp": "00:04:32", "text": "ビリー・ビリーがビリー・ビリーのために伐採作業を行っている。全て"}, {"type": "subtitle", "time": 275.59000000000003, "timestamp": "00:04:35", "text": "ログ関連の情報は記録します。"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "ビリー・ログの物。今日中にやります。二"}, {"type": "subtitle", "time": 281.189, "timestamp": "00:04:41", "text": "活動内容。 Jocknixの活動関連"}, {"type": "subtitle", "time": 284.629, "timestamp": "00:04:44", "text": "そしてRPCシステム。そうするつもりです。"}, {"type": "subtitle", "time": 287.27, "timestamp": "00:04:47", "text": "昨日、私たちはこれをしました。わからない"}, {"type": "subtitle", "time": 289.27, "timestamp": "00:04:49", "text": "でも、私たちはこれを成し遂げたんです。ちょっと待って"}, {"type": "subtitle", "time": 291.23, "timestamp": "00:04:51", "text": "2番。私に"}, {"type": "subtitle", "time": 294.469, "timestamp": "00:04:54", "text": "分。昨日は夜通し午前5時まで"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "午前中とか。いいえ、午前4時です。"}]
[{"type": "subtitle", "time": 21420.19, "timestamp": "05:57:00", "text": "それ？その"}, {"type": "subtitle", "time": 21422.11, "timestamp": "05:57:02", "text": "あなたのような"}, {"type": "subtitle", "time": 21425.27, "timestamp": "05:57:05", "text": "いつかは誰もが立ち止まる時が来ることを知っている"}, {"type": "subtitle", "time": 21427.948, "timestamp": "05:57:07", "text": "テレビを見る"}, {"type": "subtitle", "time": 21431.43, "timestamp": "05:57:11", "text": "まさにその瞬間、私はこう思う"}, {"type": "subtitle", "time": 21434.708, "timestamp": "05:57:14", "text": "瞬間は、私がよく見ていた"}, {"type": "subtitle", "time": 21444.868, "timestamp": "05:57:24", "text": "以前、あなたがユーチューバーに近づいていくのを見たことがあります"}, {"type": "subtitle", "time": 21447.83, "timestamp": "05:57:27", "text": "仕事の目的で探していたのは"}, {"type": "subtitle", "time": 21449.19, "timestamp": "05:57:29", "text": "奇妙な"}, {"type": "subtitle", "time": 21457.43, "timestamp": "05:57:37", "text": "した。待って。詳しく説明してください。待って。どこ"}, {"type": "subtitle", "time": 21460.83, "timestamp": "05:57:40", "text": "そうだったのか？不和、"}, {"type": "subtitle", "time": 21463.15, "timestamp": "05:57:43", "text": "ツイッター。私はできる"}, {"type": "subtitle", "time": 21471.63, "timestamp": "05:57:51", "text": "待って。教えません。"}, {"type": "subtitle", "time": 21473.47, "timestamp": "05:57:53", "text": "[音楽]"}, {"type": "subtitle", "time": 21476.03, "timestamp": "05:57:56", "text": "O. それは"}, {"type": "subtitle", "time": 21477.99, "timestamp": "05:57:57", "text": "奇妙な。助けて。"}]
[{"type": "subtitle", "time": 6062.149, "timestamp": "01:41:02", "text": "歌。あのね？私はそれを追加します"}, {"type": "subtitle", "time": 6065.109, "timestamp": "01:41:05", "text": "後で歌えるようにプレイリストを作っておこう"}, {"type": "subtitle", "time": 6079.229, "timestamp": "01:41:19", "text": "ええと、ここに追加します"}, {"type": "subtitle", "time": 6110.27, "timestamp": "01:41:50", "text": "出席する。聴いていたのは"}, {"type": "subtitle", "time": 6113.669, "timestamp": "01:41:53", "text": "ミツは彼らの曲の1曲を歌った。私"}]
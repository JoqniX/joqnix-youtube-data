[{"type": "subtitle", "time": 21723.67, "timestamp": "06:02:03", "text": "自分。よくわからない。でも、それは"}, {"type": "subtitle", "time": 21727.62, "timestamp": "06:02:07", "text": "結局のところ、試行錯誤の連続だ。"}, {"type": "subtitle", "time": 21729.43, "timestamp": "06:02:09", "text": "[音楽]"}, {"type": "subtitle", "time": 21732.07, "timestamp": "06:02:12", "text": "えっと、なぜ会話を始めるんですか？"}, {"type": "subtitle", "time": 21734.39, "timestamp": "06:02:14", "text": "彼らと一緒に？もし私が人と交流したら"}, {"type": "subtitle", "time": 21736.15, "timestamp": "06:02:16", "text": "初めて、私は"}, {"type": "subtitle", "time": 21738.628, "timestamp": "06:02:18", "text": "彼らと気軽に話し始める"}, {"type": "subtitle", "time": 21741.628, "timestamp": "06:02:21", "text": "DM。でもでもでも、よく考えてみると、"}, {"type": "subtitle", "time": 21744.628, "timestamp": "06:02:24", "text": "いいえ。えーと、"}, {"type": "subtitle", "time": 21748.43, "timestamp": "06:02:28", "text": "会話や第一印象に関すること、"}, {"type": "subtitle", "time": 21753.07, "timestamp": "06:02:33", "text": "えっと、それは人によると思うし、"}, {"type": "subtitle", "time": 21756.23, "timestamp": "06:02:36", "text": "その人が慣れている性質または"}, {"type": "subtitle", "time": 21757.83, "timestamp": "06:02:37", "text": "環境や何か、あるいは国、"}, {"type": "subtitle", "time": 21760.15, "timestamp": "06:02:40", "text": "私は推測する。わからないけど、私が見た限りでは"}, {"type": "subtitle", "time": 21763.51, "timestamp": "06:02:43", "text": "えっと、私が試すときはいつでも"}, {"type": "subtitle", "time": 21765.91, "timestamp": "06:02:45", "text": "見知らぬ人と会話を始める"}, {"type": "subtitle", "time": 21769.11, "timestamp": "06:02:49", "text": "あるいは、誰かが初めて"}, {"type": "subtitle", "time": 21772.548, "timestamp": "06:02:52", "text": "時間的には、私は形式的なことはしないと思います"}, {"type": "subtitle", "time": 21774.868, "timestamp": "06:02:54", "text": "実際、形式ばった感じがするから"}, {"type": "subtitle", "time": 21778.19, "timestamp": "06:02:58", "text": "人々を怖がらせる"}, {"type": "subtitle", "time": 21779.788, "timestamp": "06:02:59", "text": "それ"}]
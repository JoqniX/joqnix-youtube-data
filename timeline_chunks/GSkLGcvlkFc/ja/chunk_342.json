[{"type": "subtitle", "time": 20521.51, "timestamp": "05:42:01", "text": "夕食に何か食べるよ、えっと、5時くらいにね"}, {"type": "subtitle", "time": 20525.35, "timestamp": "05:42:05", "text": "または6、わかりました、それでは私にはできません"}, {"type": "subtitle", "time": 20529.51, "timestamp": "05:42:09", "text": "夜食に何か食べたい。そしてもし"}, {"type": "subtitle", "time": 20532.07, "timestamp": "05:42:12", "text": "夕食を食べているところです。"}, {"type": "subtitle", "time": 20535.43, "timestamp": "05:42:15", "text": "まるで少量みたいだ。ウルトラ"}, {"type": "subtitle", "time": 20538.07, "timestamp": "05:42:18", "text": "少量。うん。"}, {"type": "subtitle", "time": 20540.07, "timestamp": "05:42:20", "text": "それはあなたたちの間ではよくあることですか"}, {"type": "subtitle", "time": 20544.27, "timestamp": "05:42:24", "text": "良い？他にも同じような症状の人いますか？"}, {"type": "subtitle", "time": 20547.43, "timestamp": "05:42:27", "text": "問題？時々、私たちは本当に"}, {"type": "subtitle", "time": 20550.15, "timestamp": "05:42:30", "text": "インド人？なぜならインドのファンはすでに"}, {"type": "subtitle", "time": 20554.83, "timestamp": "05:42:34", "text": "私たちもペットを飼っています。はぁ？"}, {"type": "subtitle", "time": 20556.83, "timestamp": "05:42:36", "text": "何？待って、"}, {"type": "subtitle", "time": 20558.51, "timestamp": "05:42:38", "text": "何？"}, {"type": "subtitle", "time": 20560.948, "timestamp": "05:42:40", "text": "えーと、インド人に関しては"}, {"type": "subtitle", "time": 20563.35, "timestamp": "05:42:43", "text": "両親、えっと、2つくらいあるんだけど、"}, {"type": "subtitle", "time": 20567.51, "timestamp": "05:42:47", "text": "右？ええと、いくつかのパターンファミリーは"}, {"type": "subtitle", "time": 20568.59, "timestamp": "05:42:48", "text": "あなた"}, {"type": "subtitle", "time": 20572.07, "timestamp": "05:42:52", "text": "ペットを中に入れてください"}, {"type": "subtitle", "time": 20574.868, "timestamp": "05:42:54", "text": "家で、ペットを撫でて、一緒に寝る"}, {"type": "subtitle", "time": 20578.15, "timestamp": "05:42:58", "text": "犬でも猫でもハムスターでも何でも、"}]
[{"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "各ボタンにバルーンがすぐに付いている場合"}, {"type": "subtitle", "time": 4024.63, "timestamp": "01:07:04", "text": "アイコンのないオプション。使用時に"}, {"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "タブレットやモバイル端末も必要になる場合があります"}, {"type": "subtitle", "time": 4029.349, "timestamp": "01:07:09", "text": "当社製ボタンの中型または小型サイズ。"}, {"type": "subtitle", "time": 4031.27, "timestamp": "01:07:11", "text": "コンポーネントを瞬時に倍増できます"}, {"type": "subtitle", "time": 4033.99, "timestamp": "01:07:13", "text": "ダークモードを追加することで。バリアントなしで、"}, {"type": "subtitle", "time": 4035.75, "timestamp": "01:07:15", "text": "必要なボタンを正確に見つけることは"}, {"type": "subtitle", "time": 4037.829, "timestamp": "01:07:17", "text": "面倒くさい。これらのボタンはすべて"}, {"type": "subtitle", "time": 4039.75, "timestamp": "01:07:19", "text": "異なるが、それらを考えることもできる"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "単一の穴の一部として、コンポーネント"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "セット。検索する代わりに"}, {"type": "subtitle", "time": 4047.029, "timestamp": "01:07:27", "text": "何十ものボタンを通して、私たちは皆"}, {"type": "subtitle", "time": 4049.43, "timestamp": "01:07:29", "text": "コンポーネントとクリックマージバリアント"}, {"type": "subtitle", "time": 4051.19, "timestamp": "01:07:31", "text": "プロパティパネルで即座に"}, {"type": "subtitle", "time": 4052.95, "timestamp": "01:07:32", "text": "それらを単一のコンポーネントに変換する"}, {"type": "subtitle", "time": 4055.27, "timestamp": "01:07:35", "text": "セット。ラベルの名前を変更するだけです"}, {"type": "subtitle", "time": 4056.87, "timestamp": "01:07:36", "text": "さまざまな物件があり、"}, {"type": "subtitle", "time": 4059.19, "timestamp": "01:07:39", "text": "行く。あなたがプロチームに所属している場合"}, {"type": "subtitle", "time": 4061.589, "timestamp": "01:07:41", "text": "Figma組織の場合、"}, {"type": "subtitle", "time": 4063.349, "timestamp": "01:07:43", "text": "コンポーネントセットをチームに公開する"}, {"type": "subtitle", "time": 4065.589, "timestamp": "01:07:45", "text": "図書館。これにより劇的に減少"}, {"type": "subtitle", "time": 4067.349, "timestamp": "01:07:47", "text": "資産に含まれるコンポーネントの数"}, {"type": "subtitle", "time": 4069.75, "timestamp": "01:07:49", "text": "パネルとマージバリアントを簡単にします"}, {"type": "subtitle", "time": 4071.589, "timestamp": "01:07:51", "text": "プロパティパネルで即座に"}, {"type": "subtitle", "time": 4073.349, "timestamp": "01:07:53", "text": "それらを単一のコンポーネントに変換する"}, {"type": "subtitle", "time": 4075.589, "timestamp": "01:07:55", "text": "セット。ラベルの名前を変更するだけです"}, {"type": "subtitle", "time": 4078.789, "timestamp": "01:07:58", "text": "変換対象となる様々な物件。心配しないで"}]
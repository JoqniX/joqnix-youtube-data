[{"type": "subtitle", "time": 20401.75, "timestamp": "05:40:01", "text": "で。ええ、そうですね。そう、私はそうは思わない、私はそうは思わない"}, {"type": "subtitle", "time": 20403.51, "timestamp": "05:40:03", "text": "それを記録しておいてください。だから私はどちらかわからない"}, {"type": "subtitle", "time": 20406.03, "timestamp": "05:40:06", "text": "はどれで、どれは"}, {"type": "subtitle", "time": 20409.83, "timestamp": "05:40:09", "text": "だって、みんなうーんうーん歩き回ってるから"}, {"type": "subtitle", "time": 20413.19, "timestamp": "05:40:13", "text": "そして、現れては消える。彼らはそれがまるで"}, {"type": "subtitle", "time": 20416.548, "timestamp": "05:40:16", "text": "彼らは食べ物を求めてやって来て、その後は徘徊する。"}, {"type": "subtitle", "time": 20419.27, "timestamp": "05:40:19", "text": "近所を歩き回って、"}, {"type": "subtitle", "time": 20421.59, "timestamp": "05:40:21", "text": "時々夜に来る 時々"}, {"type": "subtitle", "time": 20423.99, "timestamp": "05:40:23", "text": "夜には訪れないような瞬間。"}, {"type": "subtitle", "time": 20427.15, "timestamp": "05:40:27", "text": "そして私はこう思った。"}, {"type": "subtitle", "time": 20430.75, "timestamp": "05:40:30", "text": "「わあ、どうして"}, {"type": "subtitle", "time": 20439.19, "timestamp": "05:40:39", "text": "「もっと？」そう、みんな食べた？"}, {"type": "subtitle", "time": 20442.708, "timestamp": "05:40:42", "text": "夕食とか？それはまるで、えっと、あなたは"}, {"type": "subtitle", "time": 20446.31, "timestamp": "05:40:46", "text": "みんな夕食を食べましたか？夜みたい"}, {"type": "subtitle", "time": 20447.39, "timestamp": "05:40:47", "text": "時間、"}, {"type": "subtitle", "time": 20455.59, "timestamp": "05:40:55", "text": "実を言うと。今、私が"}, {"type": "subtitle", "time": 20459.35, "timestamp": "05:40:59", "text": "6時以降はストリーミング配信していますが、短いものしかありません。"}]
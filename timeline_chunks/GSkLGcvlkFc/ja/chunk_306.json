[{"type": "subtitle", "time": 18370.35, "timestamp": "05:06:10", "text": "[音楽]"}, {"type": "subtitle", "time": 18375.19, "timestamp": "05:06:15", "text": "アップデート。ええと、彼らはそう願っていると思います。"}, {"type": "subtitle", "time": 18377.628, "timestamp": "05:06:17", "text": "ええ、オンラインで"}, {"type": "subtitle", "time": 18380.31, "timestamp": "05:06:20", "text": "アップデート。これは誰かが歩くときに起こります"}, {"type": "subtitle", "time": 18387.67, "timestamp": "05:06:27", "text": "いいえ、それは入り口です。えっと、わかりました、待ってください。"}, {"type": "subtitle", "time": 18389.31, "timestamp": "05:06:29", "text": "時計"}, {"type": "subtitle", "time": 18392.23, "timestamp": "05:06:32", "text": "オンラインランキングを更新しました。はい、"}, {"type": "subtitle", "time": 18399.75, "timestamp": "05:06:39", "text": "ユーザー。ユニバーサルネーム戦術ウォッチ。"}, {"type": "subtitle", "time": 18401.82, "timestamp": "05:06:41", "text": "わかった。公式情報タイプ"}, {"type": "subtitle", "time": 18413.628, "timestamp": "05:06:53", "text": "1つ。ああ、得点だ。私たちはスコアを取得します"}, {"type": "subtitle", "time": 18417.868, "timestamp": "05:06:57", "text": "ユーザー報酬数"}]
[{"type": "subtitle", "time": 22680.868, "timestamp": "06:18:00", "text": "このおっぱいアラームで私を遠ざけてください"}, {"type": "subtitle", "time": 22685.91, "timestamp": "06:18:05", "text": "OP の時計通知音。彼"}, {"type": "subtitle", "time": 22687.75, "timestamp": "06:18:07", "text": "悲しみを"}, {"type": "subtitle", "time": 22690.11, "timestamp": "06:18:10", "text": "不可能。"}, {"type": "subtitle", "time": 22693.03, "timestamp": "06:18:13", "text": "おお。ユンの息子バキは"}, {"type": "subtitle", "time": 22695.11, "timestamp": "06:18:15", "text": "彼女。彼らはその瞬間を味わっていた"}, {"type": "subtitle", "time": 22697.99, "timestamp": "06:18:17", "text": "サックスセッションと勇次郎が"}, {"type": "subtitle", "time": 22700.47, "timestamp": "06:18:20", "text": "幽霊のようにポートが立ち上がり、そして"}, {"type": "subtitle", "time": 22717.47, "timestamp": "06:18:37", "text": "本当に"}, {"type": "subtitle", "time": 22727.07, "timestamp": "06:18:47", "text": "なぜ？"}]
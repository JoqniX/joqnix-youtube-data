[{"type": "subtitle", "time": 180.47, "timestamp": "00:03:00", "text": "6時間ほどの長さです。なぜなら"}, {"type": "subtitle", "time": 183.43, "timestamp": "00:03:03", "text": "ご存知のように、最近私たちは"}, {"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "ジョッカソンが始まって、終わっています"}, {"type": "subtitle", "time": 190.79, "timestamp": "00:03:10", "text": "ジョッカソン1日目、パート1"}, {"type": "subtitle", "time": 193.27, "timestamp": "00:03:13", "text": "午後6時に配信開始そして"}, {"type": "subtitle", "time": 196.869, "timestamp": "00:03:16", "text": "2回目の配信は午後6時です。"}, {"type": "subtitle", "time": 199.50900000000001, "timestamp": "00:03:19", "text": "えーと、それから朝から"}, {"type": "subtitle", "time": 202.11, "timestamp": "00:03:22", "text": "午前6時"}, {"type": "subtitle", "time": 205.27, "timestamp": "00:03:25", "text": "だから後で何とかするつもりだけど"}, {"type": "subtitle", "time": 207.03, "timestamp": "00:03:27", "text": "大丈夫。まあ、何とか解決するよ"}, {"type": "subtitle", "time": 209.39, "timestamp": "00:03:29", "text": "一緒に。"}, {"type": "subtitle", "time": 212.35, "timestamp": "00:03:32", "text": "うん。"}, {"type": "subtitle", "time": 215.309, "timestamp": "00:03:35", "text": "はい。ああ、"}, {"type": "subtitle", "time": 218.82999999999998, "timestamp": "00:03:38", "text": "神。人生は"}, {"type": "subtitle", "time": 222.63, "timestamp": "00:03:42", "text": "痛み。今日は、"}, {"type": "subtitle", "time": 226.869, "timestamp": "00:03:46", "text": "いくつかあります。えーと今日は、私たちは"}, {"type": "subtitle", "time": 230.50900000000001, "timestamp": "00:03:50", "text": "ゲームはおそらく"}, {"type": "subtitle", "time": 233.789, "timestamp": "00:03:53", "text": "えっと、うっかり"}, {"type": "subtitle", "time": 235.789, "timestamp": "00:03:55", "text": "忘れた"}, {"type": "subtitle", "time": 239.309, "timestamp": "00:03:59", "text": "ダウンロードを受け取るには"}]
[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "コンポーネント、右クリックして、"}, {"type": "subtitle", "time": 4563.51, "timestamp": "01:16:03", "text": "すべての変更をリセットすると、"}, {"type": "subtitle", "time": 4565.75, "timestamp": "01:16:05", "text": "自動的に復元される"}, {"type": "subtitle", "time": 4567.669, "timestamp": "01:16:07", "text": "以前にも起こったことだ。だから私は物事を変えることができる"}, {"type": "subtitle", "time": 4569.51, "timestamp": "01:16:09", "text": "インスタンス内部。まあ、本当に"}, {"type": "subtitle", "time": 4570.87, "timestamp": "01:16:10", "text": "覚えておくべき重要なことは、"}, {"type": "subtitle", "time": 4573.11, "timestamp": "01:16:13", "text": "内部のものは削除できません"}, {"type": "subtitle", "time": 4575.03, "timestamp": "01:16:15", "text": "実例。例を見てみましょう。もし私が"}, {"type": "subtitle", "time": 4577.11, "timestamp": "01:16:17", "text": "この画像を選択すると、「いいね！」をクリックできます"}, {"type": "subtitle", "time": 4579.03, "timestamp": "01:16:19", "text": "キーボードのバックスペースまたは削除ボタンで"}, {"type": "subtitle", "time": 4580.87, "timestamp": "01:16:20", "text": "それは消え去るだろう。どうやら私は"}, {"type": "subtitle", "time": 4582.47, "timestamp": "01:16:22", "text": "削除しましたが、"}, {"type": "subtitle", "time": 4584.39, "timestamp": "01:16:24", "text": "レイヤーパネル、実際には"}, {"type": "subtitle", "time": 4586.149, "timestamp": "01:16:26", "text": "そこには。つまり、レイヤーが非表示になっているということです。"}, {"type": "subtitle", "time": 4587.99, "timestamp": "01:16:27", "text": "しかしそれはまだ存在しており、それは"}, {"type": "subtitle", "time": 4589.75, "timestamp": "01:16:29", "text": "それはメインコンポーネントに存在します。だから私は"}, {"type": "subtitle", "time": 4591.669, "timestamp": "01:16:31", "text": "削除できません。私も動けない"}, {"type": "subtitle", "time": 4593.75, "timestamp": "01:16:33", "text": "周囲の物。例えば、"}, {"type": "subtitle", "time": 4595.75, "timestamp": "01:16:35", "text": "このいいねボタンを取りたいのですが、"}, {"type": "subtitle", "time": 4597.35, "timestamp": "01:16:37", "text": "全身全霊をかけて動かしてみよう"}, {"type": "subtitle", "time": 4598.95, "timestamp": "01:16:38", "text": "かもしれない。それはできません。主な"}, {"type": "subtitle", "time": 4600.95, "timestamp": "01:16:40", "text": "コンポーネントは、"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "事例の中にあるもの。もし私がそうしたら"}, {"type": "subtitle", "time": 4605.75, "timestamp": "01:16:45", "text": "重要な変更を加えたい場合は、"}, {"type": "subtitle", "time": 4608.149, "timestamp": "01:16:48", "text": "インスタンスをメインから切り離す"}, {"type": "subtitle", "time": 4610.07, "timestamp": "01:16:50", "text": "部品なので、取り外すことができます。それでは、"}, {"type": "subtitle", "time": 4612.39, "timestamp": "01:16:52", "text": "取り外すには、右クリックして「取り外す」を選択します。"}, {"type": "subtitle", "time": 4613.99, "timestamp": "01:16:53", "text": "または、上部でそれを行うこともできます"}, {"type": "subtitle", "time": 4615.99, "timestamp": "01:16:55", "text": "デザインパネル。取り外しボタンがあります。"}, {"type": "subtitle", "time": 4617.43, "timestamp": "01:16:57", "text": "それは、私たちが切り離す方法と似ています"}, {"type": "subtitle", "time": 4619.27, "timestamp": "01:16:59", "text": "スタイル。だから、いったん分離すると、"}]
[{"type": "subtitle", "time": 5161.11, "timestamp": "01:26:01", "text": "接続を切断します。だから、もし私がクリックしたら"}, {"type": "subtitle", "time": 5162.629, "timestamp": "01:26:02", "text": "テキストボックス、私はそれを欲しくない"}, {"type": "subtitle", "time": 5164.149, "timestamp": "01:26:04", "text": "アイコンのブートに接続されています"}, {"type": "subtitle", "time": 5166.55, "timestamp": "01:26:06", "text": "もはや不動産ではない。また。さて、3番目"}, {"type": "subtitle", "time": 5169.669, "timestamp": "01:26:09", "text": "型はインスタンススワップです。はい、私は"}, {"type": "subtitle", "time": 5171.59, "timestamp": "01:26:11", "text": "それを知っておくべきだ。これは一体何なのか見てみましょう"}, {"type": "subtitle", "time": 5173.27, "timestamp": "01:26:13", "text": "私たちがそれをするのを手伝ってくれるでしょう。私が選択すると"}, {"type": "subtitle", "time": 5175.03, "timestamp": "01:26:15", "text": "私のボタンのインスタンス、例えば私は"}, {"type": "subtitle", "time": 5176.55, "timestamp": "01:26:16", "text": "このハートのアイコンを変更するには。だから私たちは"}, {"type": "subtitle", "time": 5178.07, "timestamp": "01:26:18", "text": "以前どうやってやったか覚えてるよね？私"}, {"type": "subtitle", "time": 5180.39, "timestamp": "01:26:20", "text": "選択するにはダブルクリックする必要がありました"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "ここに例があります。ほら、今でも私は"}, {"type": "subtitle", "time": 5183.75, "timestamp": "01:26:23", "text": "もがく。クリックしすぎている。だから私は"}, {"type": "subtitle", "time": 5185.27, "timestamp": "01:26:25", "text": "レイヤーパネルでも確認できます"}, {"type": "subtitle", "time": 5187.51, "timestamp": "01:26:27", "text": "ハートインスタンスを選択します。それから私は"}, {"type": "subtitle", "time": 5189.43, "timestamp": "01:26:29", "text": "デザインパネルを開いて変更する"}, {"type": "subtitle", "time": 5191.83, "timestamp": "01:26:31", "text": "別の何かへ。今、"}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "インスタンス スワップ コンポーネント プロパティは"}, {"type": "subtitle", "time": 5196.709, "timestamp": "01:26:36", "text": "それはそれをほぼ最高レベルに引き上げる"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "テキストの場合と同様です。だからもし"}, {"type": "subtitle", "time": 5201.83, "timestamp": "01:26:41", "text": "一番上のハートのアイコンを選択します"}, {"type": "subtitle", "time": 5203.51, "timestamp": "01:26:43", "text": "デザインパネルに表示されている"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "これは私が持っている事例です"}, {"type": "subtitle", "time": 5208.55, "timestamp": "01:26:48", "text": "インスタンスを作成するためのこのボタン"}, {"type": "subtitle", "time": 5211.669, "timestamp": "01:26:51", "text": "物件を交換する。それを選択すると、"}, {"type": "subtitle", "time": 5213.75, "timestamp": "01:26:53", "text": "このようなポップアップが表示され、作成されます"}, {"type": "subtitle", "time": 5216.149, "timestamp": "01:26:56", "text": "確認プロパティ。名前を付けよう"}, {"type": "subtitle", "time": 5218.189, "timestamp": "01:26:58", "text": "umアイコン"}]
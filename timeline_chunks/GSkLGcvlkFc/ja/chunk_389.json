[{"type": "subtitle", "time": 23340.19, "timestamp": "06:29:00", "text": "ゲーム。"}, {"type": "subtitle", "time": 23343.07, "timestamp": "06:29:03", "text": "えっと、ただ進んでいくような感じ"}, {"type": "subtitle", "time": 23347.27, "timestamp": "06:29:07", "text": "あれ。忘れていた。ええ、スローモーション"}, {"type": "subtitle", "time": 23350.67, "timestamp": "06:29:10", "text": "などなど。すべてのホイールをデュアルホイールにすることができます"}, {"type": "subtitle", "time": 23353.83, "timestamp": "06:29:13", "text": "銃と、もしキルできるなら"}, {"type": "subtitle", "time": 23357.03, "timestamp": "06:29:17", "text": "スローモーションで、より多くのポイントを獲得し、"}, {"type": "subtitle", "time": 23360.468, "timestamp": "06:29:20", "text": "アイテムを集め、コインを集め、マフィアを倒す"}, {"type": "subtitle", "time": 23363.43, "timestamp": "06:29:23", "text": "あるいは、そんな感じ。最大の痛みではない。ああ、マックス"}, {"type": "subtitle", "time": 23367.83, "timestamp": "06:29:27", "text": "痛みにもスローモーションのような動きがある。はい。ない"}, {"type": "subtitle", "time": 23371.19, "timestamp": "06:29:31", "text": "Torto に関する何か、全く何か"}, {"type": "subtitle", "time": 23375.43, "timestamp": "06:29:35", "text": "大混乱。いいえ、なんていう名前ですか？ええ、わかってます"}, {"type": "subtitle", "time": 23379.31, "timestamp": "06:29:39", "text": "TとPに関係がある"}, {"type": "subtitle", "time": 23392.23, "timestamp": "06:29:52", "text": "メキシコをテーマにした作品。ゲームは、"}, {"type": "subtitle", "time": 23394.59, "timestamp": "06:29:54", "text": "名前"}]
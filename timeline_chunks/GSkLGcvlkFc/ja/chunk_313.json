[{"type": "subtitle", "time": 18780.19, "timestamp": "05:13:00", "text": "えっと"}, {"type": "subtitle", "time": 18784.39, "timestamp": "05:13:04", "text": "こんにちは。それはジャックにとってため息ではない。私"}, {"type": "subtitle", "time": 18787.43, "timestamp": "05:13:07", "text": "自分で決めたのは、これが"}, {"type": "subtitle", "time": 18790.628, "timestamp": "05:13:10", "text": "非常に残念な配信になるだろう。"}, {"type": "subtitle", "time": 18792.55, "timestamp": "05:13:12", "text": "えっと、あまり多くは持たないでください"}, {"type": "subtitle", "time": 18794.47, "timestamp": "05:13:14", "text": "私たちへの期待と、私たちはただ"}, {"type": "subtitle", "time": 18797.43, "timestamp": "05:13:17", "text": "ゲームを開始する。実際、大丈夫です。"}, {"type": "subtitle", "time": 18799.19, "timestamp": "05:13:19", "text": "はい。はい。はい。はい。はい。私たちはただ"}, {"type": "subtitle", "time": 18800.788, "timestamp": "05:13:20", "text": "ゲームに飛び込むつもりです。なぜなら私たちは"}, {"type": "subtitle", "time": 18804.31, "timestamp": "05:13:24", "text": "マッチングするとは思っていなかったけど、"}, {"type": "subtitle", "time": 18805.99, "timestamp": "05:13:25", "text": "のように"}, {"type": "subtitle", "time": 18808.708, "timestamp": "05:13:28", "text": "私も予想していませんでした。何てことだ。ジョック。"}, {"type": "subtitle", "time": 18812.39, "timestamp": "05:13:32", "text": "あなたもここに参加したいですか？どれ？あなた"}, {"type": "subtitle", "time": 18814.39, "timestamp": "05:13:34", "text": "参加してみませんか？わかった。理由が分かった。"}, {"type": "subtitle", "time": 18816.07, "timestamp": "05:13:36", "text": "待って、待って、待って、待って。私はただ"}, {"type": "subtitle", "time": 18818.948, "timestamp": "05:13:38", "text": "何かを同時に素早くこなす。待って、"}, {"type": "subtitle", "time": 18822.35, "timestamp": "05:13:42", "text": "なぜ私は期待しているのでしょうか、いや、彼らは"}, {"type": "subtitle", "time": 18825.43, "timestamp": "05:13:45", "text": "明らかに、実際に試合を開始した。"}, {"type": "subtitle", "time": 18832.15, "timestamp": "05:13:52", "text": "えっと、どうやって待つか、いや。とても怖い。"}, {"type": "subtitle", "time": 18833.91, "timestamp": "05:13:53", "text": "ちなみに、変更したい場合は変更しても構いません。ああ神様、"}, {"type": "subtitle", "time": 18837.83, "timestamp": "05:13:57", "text": "それは私が恐れているVだ。"}]
[{"type": "subtitle", "time": 1104.95, "timestamp": "00:18:24", "text": "を通して。たぶん私はそうすべきだった"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "明らかに再起動する必要があるかもしれません"}, {"type": "subtitle", "time": 1112.19, "timestamp": "00:18:32", "text": "[音楽]"}, {"type": "subtitle", "time": 1119.789, "timestamp": "00:18:39", "text": "働く。私は幸せです"}, {"type": "subtitle", "time": 1123.47, "timestamp": "00:18:43", "text": "それ。やりたいことがたくさんあります"}, {"type": "subtitle", "time": 1126.15, "timestamp": "00:18:46", "text": "する。私はただ一つだけを確実にしなければならない"}, {"type": "subtitle", "time": 1130.07, "timestamp": "00:18:50", "text": "インスタンスはこの時点から生存している。"}, {"type": "subtitle", "time": 1135.909, "timestamp": "00:18:55", "text": "多くの。私たちは多くのことをしなければならない"}, {"type": "subtitle", "time": 1138.47, "timestamp": "00:18:58", "text": "今日は技術的な話題です。私が"}]
[{"type": "subtitle", "time": 18900.19, "timestamp": "05:15:00", "text": "何か。"}, {"type": "subtitle", "time": 18903.83, "timestamp": "05:15:03", "text": "ええ、翻訳を覚えておいてください"}, {"type": "subtitle", "time": 18909.23, "timestamp": "05:15:09", "text": "少し気難しいところがある。うーん、間違っているかもしれない"}, {"type": "subtitle", "time": 18913.75, "timestamp": "05:15:13", "text": "時々。だから、もしこう書いてあっても気にしないでください"}, {"type": "subtitle", "time": 18916.39, "timestamp": "05:15:16", "text": "言ってはいけないこと、"}, {"type": "subtitle", "time": 18919.47, "timestamp": "05:15:19", "text": "私が決してしないようなこと"}, {"type": "subtitle", "time": 18922.868, "timestamp": "05:15:22", "text": "言う。翻訳は大変だけど、大丈夫。"}, {"type": "subtitle", "time": 18925.35, "timestamp": "05:15:25", "text": "ご理解いただければ幸いです。私は"}, {"type": "subtitle", "time": 18928.35, "timestamp": "05:15:28", "text": "下のあの部分"}, {"type": "subtitle", "time": 18930.35, "timestamp": "05:15:30", "text": "それ。それで、"}, {"type": "subtitle", "time": 18934.788, "timestamp": "05:15:34", "text": "うん。今日、私の声はちょっと遅かったかな？いいえ。"}, {"type": "subtitle", "time": 18946.948, "timestamp": "05:15:46", "text": "チェック。私の声とすべてのすべてが"}, {"type": "subtitle", "time": 18949.59, "timestamp": "05:15:49", "text": "良い？ええと、いいと思うんですけど、そうですよね？その"}, {"type": "subtitle", "time": 18957.43, "timestamp": "05:15:57", "text": "ええ、今日は、"}]
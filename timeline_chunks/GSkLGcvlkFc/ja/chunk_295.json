[{"type": "subtitle", "time": 17701.03, "timestamp": "04:55:01", "text": "こうすれば誰が見ているか分かる"}, {"type": "subtitle", "time": 17703.19, "timestamp": "04:55:03", "text": "私とか、いろいろ。これが不要であることは承知しています。"}, {"type": "subtitle", "time": 17707.35, "timestamp": "04:55:07", "text": "これは追加料金ですが、問題ありません。ただ欲しかっただけ"}, {"type": "subtitle", "time": 17709.59, "timestamp": "04:55:09", "text": "丸太男を飼う。わからない。知っている"}, {"type": "subtitle", "time": 17716.67, "timestamp": "04:55:16", "text": "重要ではないが、そうだね"}, {"type": "subtitle", "time": 17723.788, "timestamp": "04:55:23", "text": "観たと思われる"}, {"type": "subtitle", "time": 17726.11, "timestamp": "04:55:26", "text": "ライブアップデート"}, {"type": "subtitle", "time": 17728.868, "timestamp": "04:55:28", "text": "警告ライブ警告など"}, {"type": "subtitle", "time": 17732.07, "timestamp": "04:55:32", "text": "私が本当に調べなければならないこと"}, {"type": "subtitle", "time": 17734.948, "timestamp": "04:55:34", "text": "ライブ警告 警告を受け取る必要がある"}, {"type": "subtitle", "time": 17745.788, "timestamp": "04:55:45", "text": "神よ、いくつかのことは"}, {"type": "subtitle", "time": 17756.19, "timestamp": "04:55:56", "text": "言った。いくつかのことは"}, {"type": "subtitle", "time": 17758.868, "timestamp": "04:55:58", "text": "えっと、これは何ですか？ １、２、３、４。"}]
[{"type": "subtitle", "time": 23220.67, "timestamp": "06:27:00", "text": "言う。最近の曲やその他"}, {"type": "subtitle", "time": 23223.628, "timestamp": "06:27:03", "text": "テレビ。彼らは最近、どのチャンネルを使っているのですか？"}, {"type": "subtitle", "time": 23226.07, "timestamp": "06:27:06", "text": "アニプレックス。いいえ、アニプレックスは"}, {"type": "subtitle", "time": 23230.19, "timestamp": "06:27:10", "text": "それはチャンネルです。待って、私は"}, {"type": "subtitle", "time": 23244.548, "timestamp": "06:27:24", "text": "そこには？ Disney Plusを止めてください。えっと、ポゴ。私"}, {"type": "subtitle", "time": 23251.67, "timestamp": "06:27:31", "text": "何？カートゥーンネットワーク。もちろん、それは"}, {"type": "subtitle", "time": 23257.868, "timestamp": "06:27:37", "text": "人々が見ている"}, {"type": "subtitle", "time": 23262.03, "timestamp": "06:27:42", "text": "テレビ。まさに私も"}, {"type": "subtitle", "time": 23266.27, "timestamp": "06:27:46", "text": "人々が現在の"}, {"type": "subtitle", "time": 23268.27, "timestamp": "06:27:48", "text": "時計"}, {"type": "subtitle", "time": 23276.07, "timestamp": "06:27:56", "text": "『ゴキブリ退治』を観よう。"}, {"type": "subtitle", "time": 23278.39, "timestamp": "06:27:58", "text": "ああ、新しいゲームが発売されるんだ"}]
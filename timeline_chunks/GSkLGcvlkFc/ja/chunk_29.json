[{"type": "subtitle", "time": 1742.23, "timestamp": "00:29:02", "text": "そういうことばかり。そして私は"}, {"type": "subtitle", "time": 1745.669, "timestamp": "00:29:05", "text": "名前が翻訳される機能。"}, {"type": "subtitle", "time": 1748.23, "timestamp": "00:29:08", "text": "この翻訳にお金を払ったと思う"}, {"type": "subtitle", "time": 1750.909, "timestamp": "00:29:10", "text": "あれ。どこに"}, {"type": "subtitle", "time": 1755.149, "timestamp": "00:29:15", "text": "あなた？翻訳する。なぜそうではないのか"}, {"type": "subtitle", "time": 1758.51, "timestamp": "00:29:18", "text": "ここ？うん。翻訳する。私は支払いました 私は支払いました"}, {"type": "subtitle", "time": 1760.35, "timestamp": "00:29:20", "text": "これ。"}, {"type": "subtitle", "time": 1762.95, "timestamp": "00:29:22", "text": "えっと、ちょっと待ってください。確認する必要がある"}, {"type": "subtitle", "time": 1769.269, "timestamp": "00:29:29", "text": "これ。確認する必要がある"}, {"type": "subtitle", "time": 1774.51, "timestamp": "00:29:34", "text": "えっと、"}, {"type": "subtitle", "time": 1776.63, "timestamp": "00:29:36", "text": "翻訳する。そうそう。心がある"}, {"type": "subtitle", "time": 1779.269, "timestamp": "00:29:39", "text": "清掃員。 Twitchを始めたんですね。遊ぶことができます"}, {"type": "subtitle", "time": 1783.07, "timestamp": "00:29:43", "text": "それについてはよくわかりませんが、"}, {"type": "subtitle", "time": 1791.59, "timestamp": "00:29:51", "text": "このディスコは引き金となる。私はこれを買いました"}, {"type": "subtitle", "time": 1794.549, "timestamp": "00:29:54", "text": "動的トリガー。私はまだしていないと思います"}, {"type": "subtitle", "time": 1797.07, "timestamp": "00:29:57", "text": "買いました。私は買いましたか"}, {"type": "subtitle", "time": 1799.789, "timestamp": "00:29:59", "text": "それ？私は買いましたか"}]
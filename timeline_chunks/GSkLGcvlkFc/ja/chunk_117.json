[{"type": "subtitle", "time": 7020.07, "timestamp": "01:57:00", "text": "しかし、それらは10種類の異なるコンポーネントですか、それとも"}, {"type": "subtitle", "time": 7021.75, "timestamp": "01:57:01", "text": "それらは異なる1つのコンポーネントですか"}, {"type": "subtitle", "time": 7023.99, "timestamp": "01:57:03", "text": "バリエーション？ Figmaには、"}, {"type": "subtitle", "time": 7026.709, "timestamp": "01:57:06", "text": "コンポーネントセットを作成する方法。だから私は"}, {"type": "subtitle", "time": 7028.31, "timestamp": "01:57:08", "text": "これらの進捗状況をすべて選択する予定です"}, {"type": "subtitle", "time": 7030.55, "timestamp": "01:57:10", "text": "円とデザインパネルで"}, {"type": "subtitle", "time": 7032.07, "timestamp": "01:57:12", "text": "上部には少し下がっていて、私は"}, {"type": "subtitle", "time": 7034.39, "timestamp": "01:57:14", "text": "コンポーネントを作成します。"}, {"type": "subtitle", "time": 7037.629, "timestamp": "01:57:17", "text": "よし、私はすべてを"}, {"type": "subtitle", "time": 7058.589, "timestamp": "01:57:38", "text": "セット。はい、コンポーネントセットを作成しました。"}, {"type": "subtitle", "time": 7062.149, "timestamp": "01:57:42", "text": "ニース。壊す。よし、これで手配できる"}, {"type": "subtitle", "time": 7065.51, "timestamp": "01:57:45", "text": "これもまた、当然のことですよね？"}]
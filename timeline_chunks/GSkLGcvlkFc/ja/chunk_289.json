[{"type": "subtitle", "time": 17340.23, "timestamp": "04:49:00", "text": "それが私たちが持っている基本的なもので、"}, {"type": "subtitle", "time": 17342.91, "timestamp": "04:49:02", "text": "UIDも同様"}, {"type": "subtitle", "time": 17345.11, "timestamp": "04:49:05", "text": "つまり、基本的には、あまり多くはない"}, {"type": "subtitle", "time": 17346.11, "timestamp": "04:49:06", "text": "に"}, {"type": "subtitle", "time": 17348.628, "timestamp": "04:49:08", "text": "する。基本的に、私たちにはあまりやることがない。"}, {"type": "subtitle", "time": 17352.07, "timestamp": "04:49:12", "text": "待って、待って。これは恥ずべき出来事だ。"}, {"type": "subtitle", "time": 17354.11, "timestamp": "04:49:14", "text": "タイムスタンプ"}, {"type": "subtitle", "time": 17355.708, "timestamp": "04:49:15", "text": "色"}, {"type": "subtitle", "time": 17379.07, "timestamp": "04:49:39", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 17388.99, "timestamp": "04:49:48", "text": "もしそれが"}, {"type": "subtitle", "time": 17391.39, "timestamp": "04:49:51", "text": "相互作用により、これが引き起こされます"}, {"type": "subtitle", "time": 17399.11, "timestamp": "04:49:59", "text": "ここ。見てみましょうか？あ、待って、待って、"}]
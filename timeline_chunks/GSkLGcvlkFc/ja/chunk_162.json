[{"type": "subtitle", "time": 9726.37, "timestamp": "02:42:06", "text": "えっと、"}, {"type": "subtitle", "time": 9752.15, "timestamp": "02:42:32", "text": "待って、彼女が何をするか見てみよう"}, {"type": "subtitle", "time": 9753.99, "timestamp": "02:42:33", "text": "コンポーネントを見て、コンポーネントを調べ始めます"}, {"type": "subtitle", "time": 9755.83, "timestamp": "02:42:35", "text": "特性。それで、私は自分の"}, {"type": "subtitle", "time": 9757.67, "timestamp": "02:42:37", "text": "ボタン、そして私はこれを"}, {"type": "subtitle", "time": 9759.429, "timestamp": "02:42:39", "text": "成分。私は取り出すつもりです"}, {"type": "subtitle", "time": 9761.19, "timestamp": "02:42:41", "text": "すぐにでも、私たちは"}, {"type": "subtitle", "time": 9763.75, "timestamp": "02:42:43", "text": "物事がどのように変化するかを見るために"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "コンポーネントの特性。タイトルを少し追加してください"}, {"type": "subtitle", "time": 9767.349, "timestamp": "02:42:47", "text": "私たちのインスタンスで、"}, {"type": "subtitle", "time": 9768.79, "timestamp": "02:42:48", "text": "これはインスタンスであり、メインではありません"}, {"type": "subtitle", "time": 9770.469, "timestamp": "02:42:50", "text": "成分。そこで、私は今、"}, {"type": "subtitle", "time": 9771.91, "timestamp": "02:42:51", "text": "コンポーネントのプロパティ。 3つあります"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "コンポーネントの特性の種類。最初"}, {"type": "subtitle", "time": 9775.75, "timestamp": "02:42:55", "text": "私が注目したかったのはテキストです。それで"}, {"type": "subtitle", "time": 9778.469, "timestamp": "02:42:58", "text": "「このテキストは不要です」を選択しましょう。私"}]
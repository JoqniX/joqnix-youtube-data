[{"type": "subtitle", "time": 23040.47, "timestamp": "06:24:00", "text": "何か。ああ、あのぼやけたもの。"}, {"type": "subtitle", "time": 23044.868, "timestamp": "06:24:04", "text": "ぼかしフィルターみたいな感じで、ええ、"}, {"type": "subtitle", "time": 23047.27, "timestamp": "06:24:07", "text": "文字通りのブローフィルターのようなタイプ"}, {"type": "subtitle", "time": 23049.99, "timestamp": "06:24:09", "text": "えーと、いろいろ。それが今の私の状況です"}, {"type": "subtitle", "time": 23052.11, "timestamp": "06:24:12", "text": "外すと"}, {"type": "subtitle", "time": 23064.83, "timestamp": "06:24:24", "text": "こんにちは、私は"}, {"type": "subtitle", "time": 23067.51, "timestamp": "06:24:27", "text": "戻る。彼は強い。え、何？私にさせて"}, {"type": "subtitle", "time": 23067.9, "timestamp": "06:24:27", "text": "読む"}, {"type": "subtitle", "time": 23069.15, "timestamp": "06:24:29", "text": "[音楽]"}, {"type": "subtitle", "time": 23072.31, "timestamp": "06:24:32", "text": "それ。ええと、ある時は"}, {"type": "subtitle", "time": 23074.948, "timestamp": "06:24:34", "text": "先史時代の洞窟人が解き放ち、"}, {"type": "subtitle", "time": 23078.39, "timestamp": "06:24:38", "text": "現代世界に入って、"}, {"type": "subtitle", "time": 23081.43, "timestamp": "06:24:41", "text": "彼と戦え。おお。"}, {"type": "subtitle", "time": 23084.27, "timestamp": "06:24:44", "text": "霧がかかっていると言った"}, {"type": "subtitle", "time": 23086.43, "timestamp": "06:24:46", "text": "バカ霧"}, {"type": "subtitle", "time": 23090.75, "timestamp": "06:24:50", "text": "ぼやけた、うん、そんな感じ"}, {"type": "subtitle", "time": 23094.628, "timestamp": "06:24:54", "text": "どうすればいいの？ぼやけてるみたい。"}, {"type": "subtitle", "time": 23097.548, "timestamp": "06:24:57", "text": "私の視野にはすべてが"}]
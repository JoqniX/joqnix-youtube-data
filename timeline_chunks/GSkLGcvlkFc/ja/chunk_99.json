[{"type": "subtitle", "time": 5946.03, "timestamp": "01:39:06", "text": "みつまくま。見つかりません。何"}, {"type": "subtitle", "time": 5947.79, "timestamp": "01:39:07", "text": "の"}, {"type": "subtitle", "time": 5955.35, "timestamp": "01:39:15", "text": "ラジアン。 YouTube をあまり見せられないのは、"}, {"type": "subtitle", "time": 5959.229, "timestamp": "01:39:19", "text": "Billy Billyでストリーミング配信中。これは"}, {"type": "subtitle", "time": 5968.07, "timestamp": "01:39:28", "text": "この曲知ってるよ。人々は尋ねていた"}, {"type": "subtitle", "time": 5974.629, "timestamp": "01:39:34", "text": "それ。ビリーのシーンを変えるべきだ"}, {"type": "subtitle", "time": 5989.149, "timestamp": "01:39:49", "text": "何？ああ、これ"}, {"type": "subtitle", "time": 5997.229, "timestamp": "01:39:57", "text": "知っている"}]
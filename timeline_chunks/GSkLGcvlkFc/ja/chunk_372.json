[{"type": "subtitle", "time": 22322.43, "timestamp": "06:12:02", "text": "君たちはみんなスプーンで食べさせてもらう"}, {"type": "subtitle", "time": 22325.67, "timestamp": "06:12:05", "text": "そういう類のアドバイス"}, {"type": "subtitle", "time": 22332.39, "timestamp": "06:12:12", "text": "学ぶ。ああ、心配しないで。えっと、私はただ"}, {"type": "subtitle", "time": 22334.788, "timestamp": "06:12:14", "text": "息子に言って、君はどれが"}, {"type": "subtitle", "time": 22336.47, "timestamp": "06:12:16", "text": "人々はあなたの友達であり、"}, {"type": "subtitle", "time": 22339.708, "timestamp": "06:12:19", "text": "ない。お店に行って"}, {"type": "subtitle", "time": 22343.708, "timestamp": "06:12:23", "text": "私にそうさせてくれなかった。ああ、"}, {"type": "subtitle", "time": 22345.31, "timestamp": "06:12:25", "text": "神。"}, {"type": "subtitle", "time": 22348.59, "timestamp": "06:12:28", "text": "アニラロボット。ようこそ、ようこそ"}, {"type": "subtitle", "time": 22350.708, "timestamp": "06:12:30", "text": "ストリーム。ようこそ、ようこそ。元気でいてくれるといいな"}, {"type": "subtitle", "time": 22356.99, "timestamp": "06:12:36", "text": "[音楽]"}, {"type": "subtitle", "time": 22361.948, "timestamp": "06:12:41", "text": "夕方？そう、そういう感じですね。"}, {"type": "subtitle", "time": 22367.19, "timestamp": "06:12:47", "text": "いいえ、会話も含めてすべてです。おお。"}, {"type": "subtitle", "time": 22368.948, "timestamp": "06:12:48", "text": "ある意味、それは親切な"}, {"type": "subtitle", "time": 22371.07, "timestamp": "06:12:51", "text": "の"}, {"type": "subtitle", "time": 22376.11, "timestamp": "06:12:56", "text": "ある意味クールで、ちょっとクール、あるいは"}, {"type": "subtitle", "time": 22378.628, "timestamp": "06:12:58", "text": "そうすると彼は自力で生き延びることになる"}]
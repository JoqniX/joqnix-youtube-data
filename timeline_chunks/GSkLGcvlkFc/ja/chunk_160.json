[{"type": "subtitle", "time": 9601.349, "timestamp": "02:40:01", "text": "自分。先ほども言いましたが、このアイコン、ハートのアイコン"}, {"type": "subtitle", "time": 9603.75, "timestamp": "02:40:03", "text": "コンポーネントのインスタンスです。だからあなたは"}, {"type": "subtitle", "time": 9606.07, "timestamp": "02:40:06", "text": "このフレームにはたくさんの"}, {"type": "subtitle", "time": 9612.91, "timestamp": "02:40:12", "text": "えっと、"}, {"type": "subtitle", "time": 9637.63, "timestamp": "02:40:37", "text": "今すぐ。私が選択すると"}, {"type": "subtitle", "time": 9642.23, "timestamp": "02:40:42", "text": "例えば、私たちと私が前に何かをする"}, {"type": "subtitle", "time": 9644.23, "timestamp": "02:40:44", "text": "また、そうしたいと思うかもしれないし、そうでないかもしれない"}, {"type": "subtitle", "time": 9646.11, "timestamp": "02:40:46", "text": "ラベルが付いている場合もある"}, {"type": "subtitle", "time": 9650.309, "timestamp": "02:40:50", "text": "それでは、ボタンを見てみましょう。"}, {"type": "subtitle", "time": 9655.23, "timestamp": "02:40:55", "text": "変更を行う必要があるため、時々"}, {"type": "subtitle", "time": 9659.27, "timestamp": "02:40:59", "text": "時々、動きの鐘が私の心を求めます"}]
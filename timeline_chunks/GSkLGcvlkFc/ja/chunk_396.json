[{"type": "subtitle", "time": 23761.11, "timestamp": "06:36:01", "text": "何か。彼らは、えーっと、"}, {"type": "subtitle", "time": 23764.468, "timestamp": "06:36:04", "text": "えっと、抽出シューティングゲームって何？"}, {"type": "subtitle", "time": 23771.51, "timestamp": "06:36:11", "text": "えーと、それはどの外部でも動作するものです"}, {"type": "subtitle", "time": 23772.868, "timestamp": "06:36:12", "text": "店舗があり、独自の"}, {"type": "subtitle", "time": 23776.31, "timestamp": "06:36:16", "text": "独立したウェブサイト。そう、そんな感じ。"}, {"type": "subtitle", "time": 23778.23, "timestamp": "06:36:18", "text": "より暗く、そしてダーカ。はい、できますよ。その"}, {"type": "subtitle", "time": 23780.23, "timestamp": "06:36:20", "text": "ダンジョン探索ゲームのような感じ。それはとても"}, {"type": "subtitle", "time": 23783.19, "timestamp": "06:36:23", "text": "もしそのゲームの問題が楽しいなら"}, {"type": "subtitle", "time": 23785.35, "timestamp": "06:36:25", "text": "まるでマルチプレイヤーゲームみたいだ。あなたには人が必要です"}, {"type": "subtitle", "time": 23787.03, "timestamp": "06:36:27", "text": "他の３人か２人が一緒に"}, {"type": "subtitle", "time": 23790.708, "timestamp": "06:36:30", "text": "あなた。つまり、３つの政党のテーマですね。這う"}, {"type": "subtitle", "time": 23791.948, "timestamp": "06:36:31", "text": "クロール"}, {"type": "subtitle", "time": 23795.11, "timestamp": "06:36:35", "text": "そして他の人々から略奪し、脱出する。それで"}, {"type": "subtitle", "time": 23797.948, "timestamp": "06:36:37", "text": "まるで抽出ダンジョンのようだ"}, {"type": "subtitle", "time": 23801.19, "timestamp": "06:36:41", "text": "クローラー。全部実行できないと思った"}, {"type": "subtitle", "time": 23803.35, "timestamp": "06:36:43", "text": "愛人。だから私はマックスをプレイして時間を過ごしている"}]
[{"type": "subtitle", "time": 8532.98, "timestamp": "02:22:12", "text": "私"}, {"type": "subtitle", "time": 8539.389, "timestamp": "02:22:19", "text": "[音楽]"}, {"type": "subtitle", "time": 8540.73, "timestamp": "02:22:20", "text": "置くべき"}, {"type": "subtitle", "time": 8547.95, "timestamp": "02:22:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8559.75, "timestamp": "02:22:39", "text": "私は法律上盲人ですか？ああ、私は"}, {"type": "subtitle", "time": 8561.23, "timestamp": "02:22:41", "text": "できない"}, {"type": "subtitle", "time": 8564.429, "timestamp": "02:22:44", "text": "見る。兄弟、どこにいるの"}, {"type": "subtitle", "time": 8579.71, "timestamp": "02:22:59", "text": "なぜできないのか"}]
[{"type": "subtitle", "time": 4680.79, "timestamp": "01:18:00", "text": "アセットパネルを開くと"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "私には1つのコンポーネントがあるのがわかりますよね？"}, {"type": "subtitle", "time": 4685.35, "timestamp": "01:18:05", "text": "そしてその横には小さな10が付いていて、"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "10種類のバリエーションがあるということです。でも私は"}, {"type": "subtitle", "time": 4689.03, "timestamp": "01:18:09", "text": "Figmaに何を伝える必要があるか"}, {"type": "subtitle", "time": 4690.31, "timestamp": "01:18:10", "text": "これら全ての違いは"}, {"type": "subtitle", "time": 4692.47, "timestamp": "01:18:12", "text": "これを使用する人は、10 個すべてにアクセスできます"}, {"type": "subtitle", "time": 4694.39, "timestamp": "01:18:14", "text": "これらは、1つ引き込むだけで実現します。私は選択する"}, {"type": "subtitle", "time": 4696.07, "timestamp": "01:18:16", "text": "私のコンポーネントは、それが与えていることさえも認識しています"}, {"type": "subtitle", "time": 4698.47, "timestamp": "01:18:18", "text": "ここに警告文があります。伝えなければならない"}, {"type": "subtitle", "time": 4700.55, "timestamp": "01:18:20", "text": "Figma のプロパティは何ですか、そして"}, {"type": "subtitle", "time": 4702.79, "timestamp": "01:18:22", "text": "差別化要因となる価値観。だから"}, {"type": "subtitle", "time": 4704.709, "timestamp": "01:18:24", "text": "ここで確認できる特性は"}, {"type": "subtitle", "time": 4707.27, "timestamp": "01:18:27", "text": "進歩。右？これは0 25です"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "50、75、100。つまり、すでに1つあります。"}, {"type": "subtitle", "time": 4712.709, "timestamp": "01:18:32", "text": "プロパティが作成されました。だから私はただ倍にする"}, {"type": "subtitle", "time": 4714.87, "timestamp": "01:18:34", "text": "名前を変更するには、それをクリックしてください。"}, {"type": "subtitle", "time": 4716.95, "timestamp": "01:18:36", "text": "進捗。そして、私は追加し始めます"}, {"type": "subtitle", "time": 4718.95, "timestamp": "01:18:38", "text": "価値観。だから、これとこれが保持されている"}, {"type": "subtitle", "time": 4720.63, "timestamp": "01:18:40", "text": "両方を選択するにはシフトダウンします"}, {"type": "subtitle", "time": 4722.87, "timestamp": "01:18:42", "text": "ゼロとする。これとこれが行く"}, {"type": "subtitle", "time": 4725.35, "timestamp": "01:18:45", "text": "25歳になる。これとこれは"}, {"type": "subtitle", "time": 4727.83, "timestamp": "01:18:47", "text": "50歳になります。"}, {"type": "subtitle", "time": 4729.59, "timestamp": "01:18:49", "text": "単語の代わりに入力しています"}, {"type": "subtitle", "time": 4731.27, "timestamp": "01:18:51", "text": "デフォルト。ドロップダウンをクリックできます"}, {"type": "subtitle", "time": 4732.95, "timestamp": "01:18:52", "text": "名前を変更したり、そういうことを言ったりする。しかし"}, {"type": "subtitle", "time": 4736.07, "timestamp": "01:18:56", "text": "全く問題ありません。つまり、これらは75で、これらは"}, {"type": "subtitle", "time": 4739.51, "timestamp": "01:18:59", "text": "100 大丈夫です。"}]
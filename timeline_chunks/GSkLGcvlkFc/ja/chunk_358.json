[{"type": "subtitle", "time": 21485.47, "timestamp": "05:58:05", "text": "コミュニケーションI"}, {"type": "subtitle", "time": 21489.27, "timestamp": "05:58:09", "text": "推測。うん。わからない。最近では私は"}, {"type": "subtitle", "time": 21492.23, "timestamp": "05:58:12", "text": "できるだけ多くの人と交流しないようにしてください。私"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "その理由だと思う、私は"}, {"type": "subtitle", "time": 21501.19, "timestamp": "05:58:21", "text": "完全に。それは奇妙なやり取りだった"}, {"type": "subtitle", "time": 21513.43, "timestamp": "05:58:33", "text": "私が知っている唯一の奇妙なやり取りは、私自身のことだ"}, {"type": "subtitle", "time": 21517.43, "timestamp": "05:58:37", "text": "ある日、ある時、なぜなら、ある人にとっては、"}, {"type": "subtitle", "time": 21521.11, "timestamp": "05:58:41", "text": "えっと、スペック、何らかの理由で私は"}, {"type": "subtitle", "time": 21523.59, "timestamp": "05:58:43", "text": "私のメインから私の人へ"}, {"type": "subtitle", "time": 21525.67, "timestamp": "05:58:45", "text": "アカウント"}, {"type": "subtitle", "time": 21530.628, "timestamp": "05:58:50", "text": "えーと、DMで連絡を取って、えーと"}, {"type": "subtitle", "time": 21533.03, "timestamp": "05:58:53", "text": "彼らは「ああ、あれは一種の痛みだった」と言っていました。"}, {"type": "subtitle", "time": 21534.59, "timestamp": "05:58:54", "text": "わかった。"}, {"type": "subtitle", "time": 21539.43, "timestamp": "05:58:59", "text": "ああ、それは奇妙な第一印象だった"}]
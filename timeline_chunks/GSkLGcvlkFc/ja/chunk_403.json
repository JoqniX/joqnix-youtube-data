[{"type": "subtitle", "time": 24182.31, "timestamp": "06:43:02", "text": "ファン。あなたのモデルは私たちのものと同じようにグリッチを起こしています"}, {"type": "subtitle", "time": 24184.39, "timestamp": "06:43:04", "text": "ラテン系の人々。待って、モデルに不具合が発生している。"}, {"type": "subtitle", "time": 24200.03, "timestamp": "06:43:20", "text": "不具合が発生しています。待って、"}, {"type": "subtitle", "time": 24202.548, "timestamp": "06:43:22", "text": "本当に？ええ、苦戦しています"}, {"type": "subtitle", "time": 24204.43, "timestamp": "06:43:24", "text": "に追いつく"}, {"type": "subtitle", "time": 24207.19, "timestamp": "06:43:27", "text": "モーション。それはまるでBに行くようなものだった"}, {"type": "subtitle", "time": 24208.948, "timestamp": "06:43:28", "text": "2番。うん、たぶん私が探していたから"}, {"type": "subtitle", "time": 24210.51, "timestamp": "06:43:30", "text": "下または"}, {"type": "subtitle", "time": 24212.948, "timestamp": "06:43:32", "text": "何か。私の携帯電話の配置は"}, {"type": "subtitle", "time": 24214.75, "timestamp": "06:43:34", "text": "また"}, {"type": "subtitle", "time": 24218.468, "timestamp": "06:43:38", "text": "痛み。待ちきれない。私の部屋が"}, {"type": "subtitle", "time": 24221.83, "timestamp": "06:43:41", "text": "準備完了です。私のオフィスルームの準備ができました。私は"}, {"type": "subtitle", "time": 24225.39, "timestamp": "06:43:45", "text": "行けない"}, {"type": "subtitle", "time": 24227.99, "timestamp": "06:43:47", "text": "待って。どれくらいかかるかわかりません"}, {"type": "subtitle", "time": 24234.868, "timestamp": "06:43:54", "text": "男。大量の"}, {"type": "subtitle", "time": 24237.91, "timestamp": "06:43:57", "text": "ダウンタイムと電気技師は"}, {"type": "subtitle", "time": 24239.468, "timestamp": "06:43:59", "text": "そこにいて、"}]
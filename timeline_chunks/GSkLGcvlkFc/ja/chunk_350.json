[{"type": "subtitle", "time": 21000.27, "timestamp": "05:50:00", "text": "まで待つ"}, {"type": "subtitle", "time": 21005.03, "timestamp": "05:50:05", "text": "私のえーと、何かで戻ってきます。私は実際に"}, {"type": "subtitle", "time": 21008.07, "timestamp": "05:50:08", "text": "そのミュージックビデオを見て泣いた。私は"}, {"type": "subtitle", "time": 21012.548, "timestamp": "05:50:12", "text": "例えば、犬のモーはなぜ待っているのか"}, {"type": "subtitle", "time": 21015.948, "timestamp": "05:50:15", "text": "年と"}, {"type": "subtitle", "time": 21019.11, "timestamp": "05:50:19", "text": "数ヶ月？なぜ？ああ、息子よ、どこで"}, {"type": "subtitle", "time": 21020.948, "timestamp": "05:50:20", "text": "行く？"}, {"type": "subtitle", "time": 21022.628, "timestamp": "05:50:22", "text": "戻ってきてください。そして最後に、彼は"}, {"type": "subtitle", "time": 21024.788, "timestamp": "05:50:24", "text": "戻ります。ちなみに、"}, {"type": "subtitle", "time": 21028.43, "timestamp": "05:50:28", "text": "ミュージックビデオ、それはまるで私がこう言ったようなものだった。"}, {"type": "subtitle", "time": 21034.51, "timestamp": "05:50:34", "text": "来た。最後に、"}, {"type": "subtitle", "time": 21036.83, "timestamp": "05:50:36", "text": "「来た。」しかし"}, {"type": "subtitle", "time": 21039.39, "timestamp": "05:50:39", "text": "うん、それも"}, {"type": "subtitle", "time": 21042.47, "timestamp": "05:50:42", "text": "ハティコ。そうそう。その名前はハチハティです"}, {"type": "subtitle", "time": 21043.75, "timestamp": "05:50:43", "text": "あるいは、そんな感じ。ハティコとかいう名前の、"}, {"type": "subtitle", "time": 21046.31, "timestamp": "05:50:46", "text": "右？うん。うん。うん。それは"}, {"type": "subtitle", "time": 21049.27, "timestamp": "05:50:49", "text": "その物。うん。あの犬め。うん。感謝"}, {"type": "subtitle", "time": 21052.11, "timestamp": "05:50:52", "text": "あなた。鼻。"}, {"type": "subtitle", "time": 21056.03, "timestamp": "05:50:56", "text": "うん。ああ、映画があるんですね。ハティ、犬の"}, {"type": "subtitle", "time": 21058.788, "timestamp": "05:50:58", "text": "しっぽ。ああ、それはイギリスの映画で"}]
[{"type": "subtitle", "time": 17760.83, "timestamp": "04:56:00", "text": "1つ"}, {"type": "subtitle", "time": 17763.83, "timestamp": "04:56:03", "text": "2番。エントリー、フォロー、シェア、フォーカス、"}, {"type": "subtitle", "time": 17771.67, "timestamp": "04:56:11", "text": "おお。ああ、アクション番号があります"}, {"type": "subtitle", "time": 17775.47, "timestamp": "04:56:15", "text": "相互作用挙動。ああ、いつも"}, {"type": "subtitle", "time": 17777.47, "timestamp": "04:56:17", "text": "エントリ。"}, {"type": "subtitle", "time": 17781.27, "timestamp": "04:56:21", "text": "つまり、これがその行動の一つです。もし誰かが"}, {"type": "subtitle", "time": 17784.39, "timestamp": "04:56:24", "text": "フォローしてくれたら、それが2つに増える。もし"}, {"type": "subtitle", "time": 17785.83, "timestamp": "04:56:25", "text": "誰かがストリームを共有している"}, {"type": "subtitle", "time": 17788.868, "timestamp": "04:56:28", "text": "3になる。わかった。だから、私たちは"}]
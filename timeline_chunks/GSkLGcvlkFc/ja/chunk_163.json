[{"type": "subtitle", "time": 9785.99, "timestamp": "02:43:05", "text": "真偽を見ていきましょう。では今"}, {"type": "subtitle", "time": 9789.15, "timestamp": "02:43:09", "text": "私はただ"}, {"type": "subtitle", "time": 9798.03, "timestamp": "02:43:18", "text": "やり方を教えてください"}, {"type": "subtitle", "time": 9801.11, "timestamp": "02:43:21", "text": "ここにインスタンスを選択するためのテキストを入力してください。見る"}, {"type": "subtitle", "time": 9802.55, "timestamp": "02:43:22", "text": "私も苦労しています。私もクリックしています"}, {"type": "subtitle", "time": 9804.389, "timestamp": "02:43:24", "text": "多くの。レイヤーパネルを見ると"}, {"type": "subtitle", "time": 9805.99, "timestamp": "02:43:25", "text": "ええ、私はハートを選んでいます"}, {"type": "subtitle", "time": 9807.99, "timestamp": "02:43:27", "text": "実例。それからデザインを進めます"}, {"type": "subtitle", "time": 9810.309, "timestamp": "02:43:30", "text": "パネルを開いて、別のものに変更してください。"}, {"type": "subtitle", "time": 9812.71, "timestamp": "02:43:32", "text": "現在、どのインスタンスのスワップコンポーネントが"}, {"type": "subtitle", "time": 9815.349, "timestamp": "02:43:35", "text": "不動産は、それを持ち上げるようなものです"}, {"type": "subtitle", "time": 9817.27, "timestamp": "02:43:37", "text": "最上位レベルまで同様のデザイン"}, {"type": "subtitle", "time": 9819.51, "timestamp": "02:43:39", "text": "これは何なのかを示すパネル"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "一例として。私はこのボタンを持っています"}]
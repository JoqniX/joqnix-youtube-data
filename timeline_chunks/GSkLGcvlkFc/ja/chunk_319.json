[{"type": "subtitle", "time": 19140.708, "timestamp": "05:19:00", "text": "そうして、どうすれば"}, {"type": "subtitle", "time": 19144.51, "timestamp": "05:19:04", "text": "声のトーンを調整して"}, {"type": "subtitle", "time": 19147.75, "timestamp": "05:19:07", "text": "すべて。こんにちは、ドラゴンさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 19149.27, "timestamp": "05:19:09", "text": "いらっしゃいませ。いらっしゃいませ。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 19155.83, "timestamp": "05:19:15", "text": "おお。私のPCが壊れかけているんです。文字通り、"}, {"type": "subtitle", "time": 19157.628, "timestamp": "05:19:17", "text": "私のPCは"}, {"type": "subtitle", "time": 19161.708, "timestamp": "05:19:21", "text": "死にかけている。私のPCではこれらすべてを処理できません。"}, {"type": "subtitle", "time": 19170.59, "timestamp": "05:19:30", "text": "神。ストリームへようこそ、12Kさん。"}, {"type": "subtitle", "time": 19172.83, "timestamp": "05:19:32", "text": "いらっしゃいませ。こんにちは。"}, {"type": "subtitle", "time": 19176.27, "timestamp": "05:19:36", "text": "こんにちは。そしてドラゴンも。"}, {"type": "subtitle", "time": 19179.948, "timestamp": "05:19:39", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 19187.75, "timestamp": "05:19:47", "text": "男の子。今日は、えっと、調べていたんだけど"}, {"type": "subtitle", "time": 19193.15, "timestamp": "05:19:53", "text": "今日はたくさんのことがあります、ええと、以来です"}, {"type": "subtitle", "time": 19197.55, "timestamp": "05:19:57", "text": "ついにコミュニティのようなものを作りました"}]
[{"type": "subtitle", "time": 24243.31, "timestamp": "06:44:03", "text": "あるフェーズから"}, {"type": "subtitle", "time": 24245.75, "timestamp": "06:44:05", "text": "三相接続とすべての配線の点検"}, {"type": "subtitle", "time": 24246.83, "timestamp": "06:44:06", "text": "そして"}, {"type": "subtitle", "time": 24250.788, "timestamp": "06:44:10", "text": "そういうことが起こった時のこと。いいえ。ええ。"}, {"type": "subtitle", "time": 24252.788, "timestamp": "06:44:12", "text": "私はストリーミングできないと思います"}, {"type": "subtitle", "time": 24254.59, "timestamp": "06:44:14", "text": "いくつか"}, {"type": "subtitle", "time": 24258.15, "timestamp": "06:44:18", "text": "日。それが唯一の欠点だ。残念ながら、"}, {"type": "subtitle", "time": 24260.59, "timestamp": "06:44:20", "text": "ジョッキー リッチ リッチ ノー"}, {"type": "subtitle", "time": 24265.35, "timestamp": "06:44:25", "text": "リッチ。つまり、私の家族は未来のような存在です"}, {"type": "subtitle", "time": 24267.91, "timestamp": "06:44:27", "text": "校正作業。だから、彼らは与えるようなものだ"}, {"type": "subtitle", "time": 24270.868, "timestamp": "06:44:30", "text": "上層階の賃貸物件"}, {"type": "subtitle", "time": 24273.468, "timestamp": "06:44:33", "text": "家、最初の"}, {"type": "subtitle", "time": 24277.35, "timestamp": "06:44:37", "text": "床。うん。オフィスとかそういうもの"}, {"type": "subtitle", "time": 24278.91, "timestamp": "06:44:38", "text": "使ってみてもいいと思います。"}, {"type": "subtitle", "time": 24280.43, "timestamp": "06:44:40", "text": "いいえ。"}, {"type": "subtitle", "time": 24283.11, "timestamp": "06:44:43", "text": "Mと私はそれについて心配する必要はありません"}, {"type": "subtitle", "time": 24286.51, "timestamp": "06:44:46", "text": "未来的なものみたいだ。そうすれば私は"}, {"type": "subtitle", "time": 24290.43, "timestamp": "06:44:50", "text": "うん、だって私はそうは思わないから"}, {"type": "subtitle", "time": 24293.43, "timestamp": "06:44:53", "text": "実際責任と好き"}, {"type": "subtitle", "time": 24295.11, "timestamp": "06:44:55", "text": "すべてが維持されていることを確認し、"}, {"type": "subtitle", "time": 24296.868, "timestamp": "06:44:56", "text": "もの。それはやりすぎだ。私はしません"}]
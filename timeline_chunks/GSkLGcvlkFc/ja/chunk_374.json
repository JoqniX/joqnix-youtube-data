[{"type": "subtitle", "time": 22442.15, "timestamp": "06:14:02", "text": "男。ええ、それも本当に"}, {"type": "subtitle", "time": 22443.9, "timestamp": "06:14:03", "text": "いいね。によって"}, {"type": "subtitle", "time": 22459.75, "timestamp": "06:14:19", "text": "ベイキーから聞いた話を教えてあげよう。わかった。"}, {"type": "subtitle", "time": 22462.08, "timestamp": "06:14:22", "text": "ナニ。"}, {"type": "subtitle", "time": 22464.99, "timestamp": "06:14:24", "text": "[音楽]"}, {"type": "subtitle", "time": 22468.548, "timestamp": "06:14:28", "text": "ナニ。久しぶりですね。私は大丈夫です。"}, {"type": "subtitle", "time": 22471.59, "timestamp": "06:14:31", "text": "元気ですか？元気です。はい、そうです"}, {"type": "subtitle", "time": 22473.47, "timestamp": "06:14:33", "text": "久しぶりだ"}, {"type": "subtitle", "time": 22476.948, "timestamp": "06:14:36", "text": "確かに。調子はどう？あなたが"}, {"type": "subtitle", "time": 22483.47, "timestamp": "06:14:43", "text": "今。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 22486.868, "timestamp": "06:14:46", "text": "もの。ご結婚おめでとうございます。何？私はしませんでした"}, {"type": "subtitle", "time": 22490.19, "timestamp": "06:14:50", "text": "そう言ってください。おお。何てことだ。これ"}, {"type": "subtitle", "time": 22494.31, "timestamp": "06:14:54", "text": "翻訳、大嫌い。"}, {"type": "subtitle", "time": 22496.11, "timestamp": "06:14:56", "text": "私は学ぶ必要がある"}]
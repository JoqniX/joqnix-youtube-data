[{"type": "subtitle", "time": 5341.59, "timestamp": "01:29:01", "text": "バリアント間の不整合。だから私は"}, {"type": "subtitle", "time": 5344.39, "timestamp": "01:29:04", "text": "テキストラベルが"}, {"type": "subtitle", "time": 5346.47, "timestamp": "01:29:06", "text": "このバリアントは"}, {"type": "subtitle", "time": 5349.03, "timestamp": "01:29:09", "text": "コンポーネントのプロパティですが、これは違います。"}, {"type": "subtitle", "time": 5350.79, "timestamp": "01:29:10", "text": "でも、何が起こったか分かりますか？それは"}, {"type": "subtitle", "time": 5352.709, "timestamp": "01:29:12", "text": "ちょっと変な感じになるのは、もし私が"}, {"type": "subtitle", "time": 5355.11, "timestamp": "01:29:15", "text": "塗りつぶしバージョンに変更してください。"}, {"type": "subtitle", "time": 5357.03, "timestamp": "01:29:17", "text": "プールと書いてあります。でも、それを"}, {"type": "subtitle", "time": 5358.79, "timestamp": "01:29:18", "text": "アウトライン版にはラベルと書いてあります"}, {"type": "subtitle", "time": 5361.59, "timestamp": "01:29:21", "text": "なぜなら、まだここから取り込んでいるからです。それで"}, {"type": "subtitle", "time": 5363.51, "timestamp": "01:29:23", "text": "使用している場合は、"}, {"type": "subtitle", "time": 5365.189, "timestamp": "01:29:25", "text": "同じ特性と差異"}, {"type": "subtitle", "time": 5367.35, "timestamp": "01:29:27", "text": "コンポーネントセット、すべてが"}, {"type": "subtitle", "time": 5369.59, "timestamp": "01:29:29", "text": "常に接続されている"}, {"type": "subtitle", "time": 5372.07, "timestamp": "01:29:32", "text": "全てを繋げよう。そうしない良い理由"}, {"type": "subtitle", "time": 5373.83, "timestamp": "01:29:33", "text": "接続してください。そこで私たちは"}, {"type": "subtitle", "time": 5377.75, "timestamp": "01:29:37", "text": "単純。なるほど、少しは理解できました。私"}, {"type": "subtitle", "time": 5380.229, "timestamp": "01:29:40", "text": "私が何に取り組んでいるのかを理解する。"}]
[{"type": "subtitle", "time": 21363.788, "timestamp": "05:56:03", "text": "それ。さよなら。たくさん"}, {"type": "subtitle", "time": 21366.51, "timestamp": "05:56:06", "text": "通知。わかった、そのままにしておこう"}, {"type": "subtitle", "time": 21370.07, "timestamp": "05:56:10", "text": "これ。なぜ私が、なぜあなたが彼に会う必要があるのですか？"}, {"type": "subtitle", "time": 21372.39, "timestamp": "05:56:12", "text": "私はそんなにお金持ちじゃない。つまり、あなたは見ることができます"}, {"type": "subtitle", "time": 21394.94, "timestamp": "05:56:34", "text": "それ。大丈夫。"}, {"type": "subtitle", "time": 21396.15, "timestamp": "05:56:36", "text": "[音楽]"}, {"type": "subtitle", "time": 21403.23, "timestamp": "05:56:43", "text": "えっと、私はめったにこれをしません"}, {"type": "subtitle", "time": 21405.628, "timestamp": "05:56:45", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 21410.47, "timestamp": "05:56:50", "text": "それ？えーと、映画とか見てるから"}, {"type": "subtitle", "time": 21418.15, "timestamp": "05:56:58", "text": "何でも。どう言えばいいだろうか"}]
[{"type": "subtitle", "time": 11761.229, "timestamp": "03:16:01", "text": "この星座のグループは、"}, {"type": "subtitle", "time": 11763.79, "timestamp": "03:16:03", "text": "手つかず。それは"}, {"type": "subtitle", "time": 11767.55, "timestamp": "03:16:07", "text": "大丈夫。将来、私が望むなら"}, {"type": "subtitle", "time": 11769.87, "timestamp": "03:16:09", "text": "持ち帰り"}, {"type": "subtitle", "time": 11781.55, "timestamp": "03:16:21", "text": "えっと、わからない"}, {"type": "subtitle", "time": 11785.269, "timestamp": "03:16:25", "text": "痛み。ああ、問題は、どうすれば"}, {"type": "subtitle", "time": 11786.99, "timestamp": "03:16:26", "text": "相互接続"}, {"type": "subtitle", "time": 11789.67, "timestamp": "03:16:29", "text": "すべて？それが私の疑問です。どうすればいいですか"}, {"type": "subtitle", "time": 11797.91, "timestamp": "03:16:37", "text": "私はそのほとんどを自分でやりました。"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "アイコンは私自身が作ったものです。しかしこれはほとんど"}, {"type": "subtitle", "time": 11802.349, "timestamp": "03:16:42", "text": "ねえ、これ"}, {"type": "subtitle", "time": 11805.11, "timestamp": "03:16:45", "text": "作成しました。この編集ボタンを見ることができます。"}, {"type": "subtitle", "time": 11806.79, "timestamp": "03:16:46", "text": "そして、好ましい値が表示されます。クリックすると"}, {"type": "subtitle", "time": 11808.83, "timestamp": "03:16:48", "text": "プラス"}, {"type": "subtitle", "time": 11810.64, "timestamp": "03:16:50", "text": "それは矢印"}, {"type": "subtitle", "time": 11813.15, "timestamp": "03:16:53", "text": "[音楽]"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "右ボタン。それで、ここまで行って"}, {"type": "subtitle", "time": 11818.63, "timestamp": "03:16:58", "text": "新しいバリエーションを追加する。"}]
[{"type": "subtitle", "time": 4980.149, "timestamp": "01:23:00", "text": "プロパティを適用するボタン、または"}, {"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "変数。それをクリックすると、"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "新しいテキストプロパティを追加する。だからクリックする"}, {"type": "subtitle", "time": 4986.629, "timestamp": "01:23:06", "text": "プラス面では、私は自分が"}, {"type": "subtitle", "time": 4988.39, "timestamp": "01:23:08", "text": "変数ではなく、プロパティを作成している。"}, {"type": "subtitle", "time": 4990.79, "timestamp": "01:23:10", "text": "その名前を、ラベルと呼ぼう。そして"}, {"type": "subtitle", "time": 4992.709, "timestamp": "01:23:12", "text": "価値は、ただ何でも取ることです"}, {"type": "subtitle", "time": 4994.55, "timestamp": "01:23:14", "text": "このテキストボックスに書かれている内容。と書いてある"}, {"type": "subtitle", "time": 4995.99, "timestamp": "01:23:15", "text": "ラベルなので、単にラベルです。そして私は行く"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "それを作り出すために。それが終わったので、"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "ほら、紫色の線が見えますね。"}, {"type": "subtitle", "time": 5000.55, "timestamp": "01:23:20", "text": "そして、私が選ぶと、そう、それが"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "先ほど見た。うん。さて、これはどういう意味でしょうか"}, {"type": "subtitle", "time": 5006.95, "timestamp": "01:23:26", "text": "一番上のインスタンスを選択したとき"}, {"type": "subtitle", "time": 5009.11, "timestamp": "01:23:29", "text": "デザインパネルの"}, {"type": "subtitle", "time": 5011.59, "timestamp": "01:23:31", "text": "テキストを変更する機能"}, {"type": "subtitle", "time": 5014.149, "timestamp": "01:23:34", "text": "デザインパネル。だから、私はそれを変更できます"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "そこには。そして、それが変化するのを目にする"}, {"type": "subtitle", "time": 5018.07, "timestamp": "01:23:38", "text": "実際の部品。私が"}, {"type": "subtitle", "time": 5020.47, "timestamp": "01:23:40", "text": "内部をダブルクリックして変更します"}, {"type": "subtitle", "time": 5023.11, "timestamp": "01:23:43", "text": "ここから、私は自分の"}, {"type": "subtitle", "time": 5024.87, "timestamp": "01:23:44", "text": "コンポーネントを変更し、デザインを修正する"}, {"type": "subtitle", "time": 5026.79, "timestamp": "01:23:46", "text": "パネル。もう一つ本当に"}, {"type": "subtitle", "time": 5028.47, "timestamp": "01:23:48", "text": "テキストコンポーネントについて強力"}, {"type": "subtitle", "time": 5030.07, "timestamp": "01:23:50", "text": "複数のプロパティを変更できる"}, {"type": "subtitle", "time": 5032.39, "timestamp": "01:23:52", "text": "同時に発生するインスタンス。だから私はただ"}, {"type": "subtitle", "time": 5034.229, "timestamp": "01:23:54", "text": "このインスタンスを数個複製します"}, {"type": "subtitle", "time": 5036.87, "timestamp": "01:23:56", "text": "何回も、そしてそれらすべてを選択すると"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "デザインパネルを開くことができます。おお"}]
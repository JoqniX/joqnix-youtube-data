[{"type": "subtitle", "time": 20461.67, "timestamp": "05:41:01", "text": "ウィンドウ"}, {"type": "subtitle", "time": 20464.788, "timestamp": "05:41:04", "text": "えーと、短い期間や時間枠で"}, {"type": "subtitle", "time": 20467.59, "timestamp": "05:41:07", "text": "えっと、少なくとも夕食は食べられるように、"}, {"type": "subtitle", "time": 20469.75, "timestamp": "05:41:09", "text": "食べて"}, {"type": "subtitle", "time": 20473.03, "timestamp": "05:41:13", "text": "えっと、家族から電話がかかってくる前に"}, {"type": "subtitle", "time": 20481.43, "timestamp": "05:41:21", "text": "時間。ええ、そうですね。"}, {"type": "subtitle", "time": 20483.47, "timestamp": "05:41:23", "text": "だから、実際にはそうしなかった"}, {"type": "subtitle", "time": 20487.11, "timestamp": "05:41:27", "text": "食べるけど、今日はただ"}, {"type": "subtitle", "time": 20489.75, "timestamp": "05:41:29", "text": "夕食の残り物を食べている。"}, {"type": "subtitle", "time": 20493.03, "timestamp": "05:41:33", "text": "うん、だって私は無駄にしてしまうと思ったから"}, {"type": "subtitle", "time": 20496.628, "timestamp": "05:41:36", "text": "今日は食べ物がないんです。お腹の調子が悪いので、"}, {"type": "subtitle", "time": 20498.47, "timestamp": "05:41:38", "text": "私はあまり食べないけれど、それでも私の"}, {"type": "subtitle", "time": 20500.788, "timestamp": "05:41:40", "text": "お腹が痛い、腸が痛いと思う"}, {"type": "subtitle", "time": 20506.628, "timestamp": "05:41:46", "text": "より小さい。ほんの数さじの食べ物の後、"}, {"type": "subtitle", "time": 20510.788, "timestamp": "05:41:50", "text": "お腹いっぱいです。それはまずい。"}, {"type": "subtitle", "time": 20514.27, "timestamp": "05:41:54", "text": "私の代謝もおかしくなってきている"}, {"type": "subtitle", "time": 20517.67, "timestamp": "05:41:57", "text": "最近では。さあ、どうだろう。まるで"}]
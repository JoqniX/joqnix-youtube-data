[{"type": "subtitle", "time": 22260.15, "timestamp": "06:11:00", "text": "ああ、あなたの両親は"}, {"type": "subtitle", "time": 22265.43, "timestamp": "06:11:05", "text": "ああ、私の子供、私の息子よ、そう言ってあげよう"}, {"type": "subtitle", "time": 22268.708, "timestamp": "06:11:08", "text": "うんうん、友達ができたらね"}, {"type": "subtitle", "time": 22271.35, "timestamp": "06:11:11", "text": "人生にはこういうものがある"}, {"type": "subtitle", "time": 22274.23, "timestamp": "06:11:14", "text": "理解していることを確認する必要があります"}, {"type": "subtitle", "time": 22277.91, "timestamp": "06:11:17", "text": "友情の価値と友人関係の仕組み"}, {"type": "subtitle", "time": 22281.27, "timestamp": "06:11:21", "text": "システムの仕組みはいいえ"}, {"type": "subtitle", "time": 22284.67, "timestamp": "06:11:24", "text": "現代では、ディオにスプーンで食事を与えるようなものだ"}, {"type": "subtitle", "time": 22289.35, "timestamp": "06:11:29", "text": "でも、私は、えっと、えっと、私は"}, {"type": "subtitle", "time": 22292.39, "timestamp": "06:11:32", "text": "つまり、いつでもGoogleで検索したり、"}, {"type": "subtitle", "time": 22294.628, "timestamp": "06:11:34", "text": "調べてみて。記事みたいなのがあると思うよ。"}, {"type": "subtitle", "time": 22297.788, "timestamp": "06:11:37", "text": "そうですね、そうですね、それが一つです。"}, {"type": "subtitle", "time": 22302.948, "timestamp": "06:11:42", "text": "物事だけでなく、あなたの祖先や"}, {"type": "subtitle", "time": 22305.43, "timestamp": "06:11:45", "text": "両親や祖父母はこう思うでしょう"}, {"type": "subtitle", "time": 22308.51, "timestamp": "06:11:48", "text": "うん、私の"}, {"type": "subtitle", "time": 22312.23, "timestamp": "06:11:52", "text": "昔はこうやっていた。"}, {"type": "subtitle", "time": 22315.99, "timestamp": "06:11:55", "text": "そうやって私は自分で学んだのです"}, {"type": "subtitle", "time": 22319.11, "timestamp": "06:11:59", "text": "他の人を見たりなど。ここで私は"}]
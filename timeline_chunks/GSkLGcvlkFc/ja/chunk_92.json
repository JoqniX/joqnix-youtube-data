[{"type": "subtitle", "time": 5527.03, "timestamp": "01:32:07", "text": "文章。中央のテキスト。問題はそれが"}, {"type": "subtitle", "time": 5529.91, "timestamp": "01:32:09", "text": "以前のものよりずっと良い。さあ、見てみよう"}, {"type": "subtitle", "time": 5533.47, "timestamp": "01:32:13", "text": "これ。このサムネイルを見てください。それで"}, {"type": "subtitle", "time": 5536.87, "timestamp": "01:32:16", "text": "多くの人がこれを見ています。たくさんのレイヤーがあります"}, {"type": "subtitle", "time": 5538.47, "timestamp": "01:32:18", "text": "これとあれとこれとあれをクリックする"}, {"type": "subtitle", "time": 5541.27, "timestamp": "01:32:21", "text": "あれこれと。物が多すぎる。今"}, {"type": "subtitle", "time": 5543.83, "timestamp": "01:32:23", "text": "脳死状態になるぞ"}, {"type": "subtitle", "time": 5546.95, "timestamp": "01:32:26", "text": "そうすると、たくさんの時間が失われてしまうんですよね？もし"}, {"type": "subtitle", "time": 5548.95, "timestamp": "01:32:28", "text": "これを自動化する方法を学ぶことができます"}, {"type": "subtitle", "time": 5552.709, "timestamp": "01:32:32", "text": "さあ、それから私はゆっくりと"}, {"type": "subtitle", "time": 5556.75, "timestamp": "01:32:36", "text": "それは私のサムネイルにも当てはまりますよね？"}, {"type": "subtitle", "time": 5559.99, "timestamp": "01:32:39", "text": "簡単に。だから、そう、だから私はこう思うんだ"}, {"type": "subtitle", "time": 5579.67, "timestamp": "01:32:59", "text": "はい、フォルダを3つ作成しました。"}]
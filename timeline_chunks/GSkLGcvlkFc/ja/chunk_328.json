[{"type": "subtitle", "time": 19682.11, "timestamp": "05:28:02", "text": "ああ、わかりました。いいね、いいね、いいね、"}, {"type": "subtitle", "time": 19685.03, "timestamp": "05:28:05", "text": "ニース。神様、私は気をつけなければなりません"}, {"type": "subtitle", "time": 19687.99, "timestamp": "05:28:07", "text": "家族が入ってきました。えっと、私は"}, {"type": "subtitle", "time": 19691.07, "timestamp": "05:28:11", "text": "両方のマイクをミュートするようなものです。"}, {"type": "subtitle", "time": 19693.19, "timestamp": "05:28:13", "text": "[音楽]"}, {"type": "subtitle", "time": 19697.23, "timestamp": "05:28:17", "text": "私はそれを望んでいません、えーっと"}, {"type": "subtitle", "time": 19698.99, "timestamp": "05:28:18", "text": "実は"}, {"type": "subtitle", "time": 19702.39, "timestamp": "05:28:22", "text": "家族の発言を翻訳してください。それで"}, {"type": "subtitle", "time": 19704.15, "timestamp": "05:28:24", "text": "うん。あなたのお気に入りのキャラクターは誰ですか？私"}, {"type": "subtitle", "time": 19705.868, "timestamp": "05:28:25", "text": "わからない。それらはすべて"}, {"type": "subtitle", "time": 19708.75, "timestamp": "05:28:28", "text": "良い。えっと、そこから"}, {"type": "subtitle", "time": 19712.47, "timestamp": "05:28:32", "text": "そこからアニメ化。なぜ翻訳者は"}, {"type": "subtitle", "time": 19715.39, "timestamp": "05:28:35", "text": "動物と言っているときに、"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "何？私の推しは青い髪の女の子です。おお、"}, {"type": "subtitle", "time": 19725.27, "timestamp": "05:28:45", "text": "ニース。ニース。どちらも好きです。の"}, {"type": "subtitle", "time": 19728.23, "timestamp": "05:28:48", "text": "金髪で"}, {"type": "subtitle", "time": 19730.51, "timestamp": "05:28:50", "text": "金髪の女の子と"}, {"type": "subtitle", "time": 19734.75, "timestamp": "05:28:54", "text": "青い髪、もしくは濃い色の髪の女の子。"}, {"type": "subtitle", "time": 19739.23, "timestamp": "05:28:59", "text": "うん。うん。うん。両方とも"}]
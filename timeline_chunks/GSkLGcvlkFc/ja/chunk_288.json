[{"type": "subtitle", "time": 17282.47, "timestamp": "04:48:02", "text": "ser ユーザー名は私たちが必要とするもので、"}, {"type": "subtitle", "time": 17285.15, "timestamp": "04:48:05", "text": "アバターが必要です"}, {"type": "subtitle", "time": 17286.99, "timestamp": "04:48:06", "text": "それ"}, {"type": "subtitle", "time": 17291.75, "timestamp": "04:48:11", "text": "UID ああ、Origin が何なのかはわかりません"}, {"type": "subtitle", "time": 17295.23, "timestamp": "04:48:15", "text": "私の部屋ですよね？ Originは私のライブです"}, {"type": "subtitle", "time": 17298.19, "timestamp": "04:48:18", "text": "部屋。与える"}, {"type": "subtitle", "time": 17314.58, "timestamp": "04:48:34", "text": "ああ、わかりました。わかった。わかった。"}, {"type": "subtitle", "time": 17316.59, "timestamp": "04:48:36", "text": "[音楽]"}, {"type": "subtitle", "time": 17326.43, "timestamp": "04:48:46", "text": "えっと、私たちは手に入れることができます"}, {"type": "subtitle", "time": 17330.31, "timestamp": "04:48:50", "text": "イベントタイプ（今後はイベント）"}, {"type": "subtitle", "time": 17332.15, "timestamp": "04:48:52", "text": "タイプして、それを作って、"}, {"type": "subtitle", "time": 17334.788, "timestamp": "04:48:54", "text": "交流"}, {"type": "subtitle", "time": 17337.03, "timestamp": "04:48:57", "text": "えっと、ユーザー名とアバターですよね？"}]
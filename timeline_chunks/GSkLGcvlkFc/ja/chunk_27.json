[{"type": "subtitle", "time": 1620.43, "timestamp": "00:27:00", "text": "一度集中モードに入ると、"}, {"type": "subtitle", "time": 1625.909, "timestamp": "00:27:05", "text": "右？私はそれに、私は、ええと、夢中になりすぎている。病気"}, {"type": "subtitle", "time": 1639.07, "timestamp": "00:27:19", "text": "えっと、"}, {"type": "subtitle", "time": 1648.59, "timestamp": "00:27:28", "text": "ケーブル発射バック"}, {"type": "subtitle", "time": 1656.83, "timestamp": "00:27:36", "text": "ケーブル、ケーブル。何？"}, {"type": "subtitle", "time": 1671.35, "timestamp": "00:27:51", "text": "始める。えっと、グループを作りたいのですが"}, {"type": "subtitle", "time": 1673.19, "timestamp": "00:27:53", "text": "マウス加速が正しく機能する"}, {"type": "subtitle", "time": 1676.23, "timestamp": "00:27:56", "text": "それも私がこれを上回ったもの"}, {"type": "subtitle", "time": 1679.269, "timestamp": "00:27:59", "text": "生の車軸発進はそこにあります。今それを置きました。"}]
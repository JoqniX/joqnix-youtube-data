[{"type": "subtitle", "time": 20766.19, "timestamp": "05:46:06", "text": "怖い。おお。"}, {"type": "subtitle", "time": 20775.11, "timestamp": "05:46:15", "text": "くそ。でも、学ぶのも面白い"}, {"type": "subtitle", "time": 20777.868, "timestamp": "05:46:17", "text": "脂肪とかそういうもの。"}, {"type": "subtitle", "time": 20780.9, "timestamp": "05:46:20", "text": "うん。それで、"}, {"type": "subtitle", "time": 20784.67, "timestamp": "05:46:24", "text": "[音楽]"}, {"type": "subtitle", "time": 20787.868, "timestamp": "05:46:27", "text": "ダイアナ、でもそうだね。"}, {"type": "subtitle", "time": 20790.788, "timestamp": "05:46:30", "text": "ああ、そうだ、私は進み続けなければならない"}, {"type": "subtitle", "time": 20792.67, "timestamp": "05:46:32", "text": "話している。"}, {"type": "subtitle", "time": 20795.59, "timestamp": "05:46:35", "text": "H、それは私にとって練習のようなもので、"}, {"type": "subtitle", "time": 20803.948, "timestamp": "05:46:43", "text": "会話。猫は信用しない"}, {"type": "subtitle", "time": 20808.35, "timestamp": "05:46:48", "text": "誰でも。真実。うん、猫は優しい"}, {"type": "subtitle", "time": 20812.43, "timestamp": "05:46:52", "text": "猫はちょっと難しい"}, {"type": "subtitle", "time": 20815.67, "timestamp": "05:46:55", "text": "それは何と呼ぶのでしょうか？彼らは好き嫌いが激しい"}, {"type": "subtitle", "time": 20818.27, "timestamp": "05:46:58", "text": "生き物たち、私は"}]
[{"type": "subtitle", "time": 5100.47, "timestamp": "01:25:00", "text": "もの。使用していないと表示されます。では今"}, {"type": "subtitle", "time": 5102.229, "timestamp": "01:25:02", "text": "私はこれから何を選ぶか決めます"}, {"type": "subtitle", "time": 5104.87, "timestamp": "01:25:04", "text": "そのコンポーネントプロパティに割り当てられました。"}, {"type": "subtitle", "time": 5107.75, "timestamp": "01:25:07", "text": "私は自分の心を選ぶ。そして、"}, {"type": "subtitle", "time": 5110.709, "timestamp": "01:25:10", "text": "外観セクション、コンポーネントがあります"}, {"type": "subtitle", "time": 5113.59, "timestamp": "01:25:13", "text": "プロパティボタン。それをクリックすると、"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "アイコンに割り当ててください。さて、これはブール値ですね"}, {"type": "subtitle", "time": 5118.07, "timestamp": "01:25:18", "text": "プロパティは、ブール値に似ています"}, {"type": "subtitle", "time": 5119.99, "timestamp": "01:25:19", "text": "ちなみに変数は、"}, {"type": "subtitle", "time": 5122.91, "timestamp": "01:25:22", "text": "要素の可視性。"}, {"type": "subtitle", "time": 5125.99, "timestamp": "01:25:25", "text": "つまり、私は次のようなトグルを持っているようです"}, {"type": "subtitle", "time": 5129.189, "timestamp": "01:25:29", "text": "以前にもあった。そしてもし私がああ、なんてことだ。"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "姿を消した。復活した。それは消える。"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "復活した。それは消える。うん。となることによって"}, {"type": "subtitle", "time": 5135.99, "timestamp": "01:25:35", "text": "これがブール型プロパティの機能です。今"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "複数のものを接続できます"}, {"type": "subtitle", "time": 5140.47, "timestamp": "01:25:40", "text": "同じ物件。では、私が"}, {"type": "subtitle", "time": 5143.11, "timestamp": "01:25:43", "text": "テキストの両方をこのトグルで切り替えることができます"}, {"type": "subtitle", "time": 5145.189, "timestamp": "01:25:45", "text": "そしてアイコンが消える。だから私はただ"}, {"type": "subtitle", "time": 5147.43, "timestamp": "01:25:47", "text": "外観でテキストボックスを選択します"}, {"type": "subtitle", "time": 5149.99, "timestamp": "01:25:49", "text": "セクションで、ボタンを見つけて、それを接続します"}, {"type": "subtitle", "time": 5151.75, "timestamp": "01:25:51", "text": "アイコン。さて、この例では"}, {"type": "subtitle", "time": 5153.59, "timestamp": "01:25:53", "text": "これを切り替えると、両方とも"}, {"type": "subtitle", "time": 5155.35, "timestamp": "01:25:55", "text": "消える。この状況では、私は"}, {"type": "subtitle", "time": 5157.43, "timestamp": "01:25:57", "text": "確かにこんな感じだけど、それでも"}, {"type": "subtitle", "time": 5159.43, "timestamp": "01:25:59", "text": "それが存在することを知っておくのは良いことだ。私はただ"}]
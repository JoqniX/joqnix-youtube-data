[{"type": "subtitle", "time": 21663.07, "timestamp": "06:01:03", "text": "説得力がある、あるいは誰かのような"}, {"type": "subtitle", "time": 21667.99, "timestamp": "06:01:07", "text": "利用したいだけの人"}, {"type": "subtitle", "time": 21669.99, "timestamp": "06:01:09", "text": "あなたを利用したり、何か"}, {"type": "subtitle", "time": 21673.91, "timestamp": "06:01:13", "text": "右？それもまた難しいですね。どうすればいいですか"}, {"type": "subtitle", "time": 21676.47, "timestamp": "06:01:16", "text": "それ？"}, {"type": "subtitle", "time": 21679.51, "timestamp": "06:01:19", "text": "つまり、主なことは、それらのことが難しいということです。"}, {"type": "subtitle", "time": 21681.51, "timestamp": "06:01:21", "text": "けれど。私はいつも受け身の立場だ"}, {"type": "subtitle", "time": 21684.07, "timestamp": "06:01:24", "text": "それに関して、人々は私に助けを求めてくる。"}, {"type": "subtitle", "time": 21686.07, "timestamp": "06:01:26", "text": "だから、私はそれについて何も考えません。だから私は"}, {"type": "subtitle", "time": 21688.788, "timestamp": "06:01:28", "text": "普通の会話として受け止めてください。しかし、"}, {"type": "subtitle", "time": 21692.75, "timestamp": "06:01:32", "text": "私はアプローチしようとするときにそうするようにしています"}, {"type": "subtitle", "time": 21696.708, "timestamp": "06:01:36", "text": "誰かに助けを求めたり、何かを求めたりするのはなぜですか？"}, {"type": "subtitle", "time": 21700.11, "timestamp": "06:01:40", "text": "そんなに難しいの？それから私は尋ねる"}, {"type": "subtitle", "time": 21704.99, "timestamp": "06:01:44", "text": "私自身はそうしているが、他の人はどうしているのだろうか？"}, {"type": "subtitle", "time": 21706.548, "timestamp": "06:01:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21709.27, "timestamp": "06:01:49", "text": "ええ、アート、コンセプト全体が"}, {"type": "subtitle", "time": 21711.628, "timestamp": "06:01:51", "text": "コミュニケーションの"}, {"type": "subtitle", "time": 21713.788, "timestamp": "06:01:53", "text": "とても複雑"}, {"type": "subtitle", "time": 21716.35, "timestamp": "06:01:56", "text": "そして言葉では言い表せないほど"}, {"type": "subtitle", "time": 21719.708, "timestamp": "06:01:59", "text": "うーん、こういう人には理解しにくい"}]
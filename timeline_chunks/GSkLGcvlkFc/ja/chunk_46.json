[{"type": "subtitle", "time": 2774.15, "timestamp": "00:46:14", "text": "Pigmaのインタラクションを作成して変更します"}, {"type": "subtitle", "time": 2777.109, "timestamp": "00:46:17", "text": "変数を用いたバリアント状態。"}, {"type": "subtitle", "time": 2779.55, "timestamp": "00:46:19", "text": "ブール型のプロパティ。何が"}, {"type": "subtitle", "time": 2781.829, "timestamp": "00:46:21", "text": "それ？インタラクティブなコンポーネント。何が"}, {"type": "subtitle", "time": 2783.75, "timestamp": "00:46:23", "text": "これ？ Figmaでやるのはすごく難しそうですね。"}, {"type": "subtitle", "time": 2785.99, "timestamp": "00:46:25", "text": "しかし実際はとても簡単です。それは"}, {"type": "subtitle", "time": 2788.79, "timestamp": "00:46:28", "text": "バリアントを使用したインタラクティブなコンポーネント。"}, {"type": "subtitle", "time": 2790.39, "timestamp": "00:46:30", "text": "これって、全部難解な言葉で言い換えてるだけ。見て、"}, {"type": "subtitle", "time": 2791.829, "timestamp": "00:46:31", "text": "それはボタンです。ホバリング機能があります"}, {"type": "subtitle", "time": 2793.75, "timestamp": "00:46:33", "text": "交流。このコンポーネントは"}, {"type": "subtitle", "time": 2795.589, "timestamp": "00:46:35", "text": "バリエーションがあります。私は変更するつもりです"}, {"type": "subtitle", "time": 2798.069, "timestamp": "00:46:38", "text": "背景色。分散を使用しています"}, {"type": "subtitle", "time": 2799.75, "timestamp": "00:46:39", "text": "また、マウスオーバー時のインタラクション機能も備えています。全て"}, {"type": "subtitle", "time": 2801.349, "timestamp": "00:46:41", "text": "右。それで、ボタンを作ってみました。それは"}, {"type": "subtitle", "time": 2802.95, "timestamp": "00:46:42", "text": "何でもいい。変換します"}, {"type": "subtitle", "time": 2805.03, "timestamp": "00:46:45", "text": "コンポーネントに変換する。"}, {"type": "subtitle", "time": 2807.47, "timestamp": "00:46:47", "text": "そして、"}]
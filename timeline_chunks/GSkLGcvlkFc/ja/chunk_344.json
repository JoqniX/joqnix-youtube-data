[{"type": "subtitle", "time": 20642.39, "timestamp": "05:44:02", "text": "などなど、それを管理します。ええ、私は"}, {"type": "subtitle", "time": 20645.51, "timestamp": "05:44:05", "text": "ぜひ欲しいです。でも私も"}, {"type": "subtitle", "time": 20647.948, "timestamp": "05:44:07", "text": "まるで"}, {"type": "subtitle", "time": 20652.67, "timestamp": "05:44:12", "text": "悪い。私はペットの扱いが苦手な気がします。"}, {"type": "subtitle", "time": 20655.59, "timestamp": "05:44:15", "text": "だって、私はペットの世話をしたことがないから。"}, {"type": "subtitle", "time": 20667.19, "timestamp": "05:44:27", "text": "えっと、暗い事実を知りたいですか？"}, {"type": "subtitle", "time": 20675.83, "timestamp": "05:44:35", "text": "もしあなたがそれを共有したいのであれば、それは"}, {"type": "subtitle", "time": 20677.868, "timestamp": "05:44:37", "text": "ダークファットとは"}, {"type": "subtitle", "time": 20680.548, "timestamp": "05:44:40", "text": "猫？試してみたら"}, {"type": "subtitle", "time": 20682.91, "timestamp": "05:44:42", "text": "ひっくり返す"}, {"type": "subtitle", "time": 20686.788, "timestamp": "05:44:46", "text": "猫みたいに、えっと、猫を投げる"}, {"type": "subtitle", "time": 20689.27, "timestamp": "05:44:49", "text": "逆さまにしても必ず上向きになる"}, {"type": "subtitle", "time": 20691.628, "timestamp": "05:44:51", "text": "まっすぐまたは"}, {"type": "subtitle", "time": 20695.19, "timestamp": "05:44:55", "text": "何か。わからない。私はビデオを見た"}]
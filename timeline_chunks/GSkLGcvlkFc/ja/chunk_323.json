[{"type": "subtitle", "time": 19380.708, "timestamp": "05:23:00", "text": "はい、新しいメンバーが加わりました。ああ、アレックス、君は"}, {"type": "subtitle", "time": 19383.27, "timestamp": "05:23:03", "text": "ストリングマスターを手に入れました。ニース、"}, {"type": "subtitle", "time": 19389.59, "timestamp": "05:23:09", "text": "ニース。よかったね、バカ。貯金しています"}, {"type": "subtitle", "time": 19392.35, "timestamp": "05:23:12", "text": "チャンギと"}, {"type": "subtitle", "time": 19394.628, "timestamp": "05:23:14", "text": "えーと、これから来るのは"}, {"type": "subtitle", "time": 19396.23, "timestamp": "05:23:16", "text": "その後。"}, {"type": "subtitle", "time": 19399.51, "timestamp": "05:23:19", "text": "ピンガトロンボーンとは何ですか？えっと、待って、"}, {"type": "subtitle", "time": 19401.47, "timestamp": "05:23:21", "text": "私にリンクを貼って"}, {"type": "subtitle", "time": 19404.868, "timestamp": "05:23:24", "text": "説明なので、皆さんはチェックできます"}, {"type": "subtitle", "time": 19405.628, "timestamp": "05:23:25", "text": "それ"}, {"type": "subtitle", "time": 19409.75, "timestamp": "05:23:29", "text": "外。えっと、ちょっと待ってください。1分ほど時間をください。"}, {"type": "subtitle", "time": 19411.788, "timestamp": "05:23:31", "text": "これをやるのを忘れていました。えっと、私の"}, {"type": "subtitle", "time": 19413.47, "timestamp": "05:23:33", "text": "悪い。"}, {"type": "subtitle", "time": 19417.51, "timestamp": "05:23:37", "text": "説明を確認すると、"}, {"type": "subtitle", "time": 19419.83, "timestamp": "05:23:39", "text": "待って、ちょっとやらせてください。"}, {"type": "subtitle", "time": 19422.788, "timestamp": "05:23:42", "text": "ピンクのトランプトロンボーンは、"}, {"type": "subtitle", "time": 19426.31, "timestamp": "05:23:46", "text": "ゲーム。それはアプリケーションか"}, {"type": "subtitle", "time": 19431.55, "timestamp": "05:23:51", "text": "GitHubみたいなやつで、えっと、"}, {"type": "subtitle", "time": 19435.83, "timestamp": "05:23:55", "text": "あなたの声ではなくあなたの声がわかる"}, {"type": "subtitle", "time": 19437.59, "timestamp": "05:23:57", "text": "普通の人間の声のように"}, {"type": "subtitle", "time": 19439.39, "timestamp": "05:23:59", "text": "変調され、"}]
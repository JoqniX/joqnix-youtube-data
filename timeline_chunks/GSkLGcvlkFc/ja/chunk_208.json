[{"type": "subtitle", "time": 12480.15, "timestamp": "03:28:00", "text": "実例。ああ、うまくいった。ああ、つまり私は"}, {"type": "subtitle", "time": 12481.83, "timestamp": "03:28:01", "text": "こうするべきだった。わかった。わかった。"}, {"type": "subtitle", "time": 12491.469, "timestamp": "03:28:11", "text": "それ。私は手に入れたと思います"}, {"type": "subtitle", "time": 12494.51, "timestamp": "03:28:14", "text": "それ。わかった。財産"}, {"type": "subtitle", "time": 12508.87, "timestamp": "03:28:28", "text": "寝ている。直ったと思います。私は思う"}, {"type": "subtitle", "time": 12519.51, "timestamp": "03:28:39", "text": "それ。なぜこうなっているのか分かりませんが、"}, {"type": "subtitle", "time": 12522.349, "timestamp": "03:28:42", "text": "まあ、そうですね。えっと、"}, {"type": "subtitle", "time": 12533.71, "timestamp": "03:28:53", "text": "2番目は"}, {"type": "subtitle", "time": 12537.07, "timestamp": "03:28:57", "text": "トイレ休憩です。右。それで"}]
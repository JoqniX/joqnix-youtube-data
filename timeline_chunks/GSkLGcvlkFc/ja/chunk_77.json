[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "ロイヤルパープルの色を失い、"}, {"type": "subtitle", "time": 4623.27, "timestamp": "01:17:03", "text": "今はただの額縁だ。私は物を動かすことができます"}, {"type": "subtitle", "time": 4625.11, "timestamp": "01:17:05", "text": "その周り。それらを削除して、"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "これを好きなように修正する。しかし、それは"}, {"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "メインからの接続が失われる"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "成分。だから、もし私が引っ越すとしたら"}, {"type": "subtitle", "time": 4632.47, "timestamp": "01:17:12", "text": "この辺りの何かを変えるか"}, {"type": "subtitle", "time": 4634.31, "timestamp": "01:17:14", "text": "その色を見ると、"}, {"type": "subtitle", "time": 4636.07, "timestamp": "01:17:16", "text": "インスタンスが影響を受け、何か"}, {"type": "subtitle", "time": 4637.75, "timestamp": "01:17:17", "text": "それはかつては一種の事例だった"}, {"type": "subtitle", "time": 4639.59, "timestamp": "01:17:19", "text": "その接続が失われる。とても簡単"}, {"type": "subtitle", "time": 4642.229, "timestamp": "01:17:22", "text": "構成要素はシンプルです。次に"}, {"type": "subtitle", "time": 4643.669, "timestamp": "01:17:23", "text": "次に知っておくべきこと"}, {"type": "subtitle", "time": 4645.83, "timestamp": "01:17:25", "text": "構成要素がばらつきを生み出している。"}, {"type": "subtitle", "time": 4648.709, "timestamp": "01:17:28", "text": "はい。この進捗状況を示す円グラフを見てみましょう。"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "私は10種類の異なる円を持っています"}, {"type": "subtitle", "time": 4653.189, "timestamp": "01:17:33", "text": "ここ。しかし、それらは10種類違うのでしょうか？"}, {"type": "subtitle", "time": 4655.03, "timestamp": "01:17:35", "text": "構成要素なのか、それとも単一の構成要素なのか？"}, {"type": "subtitle", "time": 4657.51, "timestamp": "01:17:37", "text": "バリエーションはありますか？ Figmaにあるもの"}, {"type": "subtitle", "time": 4660.39, "timestamp": "01:17:40", "text": "これはコンポーネントセットを作成する方法です。それで"}, {"type": "subtitle", "time": 4661.75, "timestamp": "01:17:41", "text": "これら全てを選択します"}, {"type": "subtitle", "time": 4664.07, "timestamp": "01:17:44", "text": "進捗状況を示す円とデザインパネル"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "一番上には小さな段差があります"}, {"type": "subtitle", "time": 4668.709, "timestamp": "01:17:48", "text": "そして、コンポーネントセットを作成します。"}, {"type": "subtitle", "time": 4670.55, "timestamp": "01:17:50", "text": "これで周囲に紫色の線が表示されます"}, {"type": "subtitle", "time": 4672.47, "timestamp": "01:17:52", "text": "部品が紫色になることは分かっています。"}, {"type": "subtitle", "time": 4674.79, "timestamp": "01:17:54", "text": "しかしFigmaは私に、"}, {"type": "subtitle", "time": 4676.87, "timestamp": "01:17:56", "text": "違いとは何かを伝える"}, {"type": "subtitle", "time": 4678.709, "timestamp": "01:17:58", "text": "これらの円の間には、"}]
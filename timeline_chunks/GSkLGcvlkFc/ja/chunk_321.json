[{"type": "subtitle", "time": 19263.23, "timestamp": "05:21:03", "text": "何？ああ、無理だ。これはやりすぎだ。"}, {"type": "subtitle", "time": 19269.31, "timestamp": "05:21:09", "text": "さよなら。おお"}, {"type": "subtitle", "time": 19272.23, "timestamp": "05:21:12", "text": "男の子。ええ、そうですね。えっと、もし私の"}, {"type": "subtitle", "time": 19274.868, "timestamp": "05:21:14", "text": "ストリームの遅延とか何か"}, {"type": "subtitle", "time": 19276.67, "timestamp": "05:21:16", "text": "私のPCは"}, {"type": "subtitle", "time": 19279.35, "timestamp": "05:21:19", "text": "死にかけている。ストリームブレッドへようこそ。"}, {"type": "subtitle", "time": 19282.51, "timestamp": "05:21:22", "text": "いらっしゃいませ。お元気ですか？パンはどうですか？"}, {"type": "subtitle", "time": 19284.27, "timestamp": "05:21:24", "text": "けれど？"}, {"type": "subtitle", "time": 19299.55, "timestamp": "05:21:39", "text": "おお。何てことだ。一生懸命頑張っている、"}, {"type": "subtitle", "time": 19312.07, "timestamp": "05:21:52", "text": "うん。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 19314.15, "timestamp": "05:21:54", "text": "えっと、何の話をしていましたっけ？えっと、"}, {"type": "subtitle", "time": 19317.51, "timestamp": "05:21:57", "text": "うん。えっと、気づいてなかったら、私は"}]
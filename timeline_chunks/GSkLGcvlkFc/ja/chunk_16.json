[{"type": "subtitle", "time": 962.5, "timestamp": "00:16:02", "text": "スペースがないから"}, {"type": "subtitle", "time": 964.43, "timestamp": "00:16:04", "text": "[音楽]"}, {"type": "subtitle", "time": 968.43, "timestamp": "00:16:08", "text": "兄弟。私は81GBくらい持っています"}, {"type": "subtitle", "time": 972.87, "timestamp": "00:16:12", "text": "スペースですが、それをインストールすると"}, {"type": "subtitle", "time": 975.15, "timestamp": "00:16:15", "text": "不足"}, {"type": "subtitle", "time": 977.67, "timestamp": "00:16:17", "text": "空間。私にはたくさんのものがあります"}, {"type": "subtitle", "time": 983.509, "timestamp": "00:16:23", "text": "今日。 Discordのアクティビティをしなければならない"}, {"type": "subtitle", "time": 986.15, "timestamp": "00:16:26", "text": "もの。必要ないのは分かっています。なぜ"}, {"type": "subtitle", "time": 987.99, "timestamp": "00:16:27", "text": "私はこれをやっているのだろうか？わからない。のために"}, {"type": "subtitle", "time": 991.87, "timestamp": "00:16:31", "text": "なぜダメなのか？くそっ"}, {"type": "subtitle", "time": 993.949, "timestamp": "00:16:33", "text": "それ。しかしそれは"}, {"type": "subtitle", "time": 997.71, "timestamp": "00:16:37", "text": "大丈夫。来る。一緒に取り組みましょう。"}, {"type": "subtitle", "time": 1005.749, "timestamp": "00:16:45", "text": "コア。私はまだ心配しています"}, {"type": "subtitle", "time": 1008.829, "timestamp": "00:16:48", "text": "ビジェットではないもの"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "表示中。まるで死んでしまったみたいだ、"}, {"type": "subtitle", "time": 1014.069, "timestamp": "00:16:54", "text": "兄弟？"}]
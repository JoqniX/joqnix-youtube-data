[{"type": "subtitle", "time": 19621.67, "timestamp": "05:27:01", "text": "あなた？はい、私は"}, {"type": "subtitle", "time": 19630.91, "timestamp": "05:27:10", "text": "えっと、どうにかしてもっと"}, {"type": "subtitle", "time": 19634.27, "timestamp": "05:27:14", "text": "FPS ああ、待って。削除するだけで"}, {"type": "subtitle", "time": 19637.948, "timestamp": "05:27:17", "text": "背景。 60fps"}, {"type": "subtitle", "time": 19640.788, "timestamp": "05:27:20", "text": "インスタント。何てことだ。私は"}, {"type": "subtitle", "time": 19650.07, "timestamp": "05:27:30", "text": "えっと、そのアニメをそんなにたくさん見たんですか？"}, {"type": "subtitle", "time": 19653.35, "timestamp": "05:27:33", "text": "音声ラジオの側面？はい。えっと、あなたは"}, {"type": "subtitle", "time": 19656.23, "timestamp": "05:27:36", "text": "あのアニメ？はい、見ています。私"}, {"type": "subtitle", "time": 19659.83, "timestamp": "05:27:39", "text": "実際、追いつく必要がある。えっと、5"}, {"type": "subtitle", "time": 19663.51, "timestamp": "05:27:43", "text": "その背後にはいくつかのエピソードがある。私は1つ手に入れました"}, {"type": "subtitle", "time": 19679.91, "timestamp": "05:27:59", "text": "はい、戻ってきました。えっと、私はエピソード6を見ています。"}]
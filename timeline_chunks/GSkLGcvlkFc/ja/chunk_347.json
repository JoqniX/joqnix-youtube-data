[{"type": "subtitle", "time": 20822.15, "timestamp": "05:47:02", "text": "推測。ええ、彼らはちょっと好みがうるさいんです。彼らは"}, {"type": "subtitle", "time": 20824.39, "timestamp": "05:47:04", "text": "彼らは怠けて、自分の好きなことをして"}, {"type": "subtitle", "time": 20827.708, "timestamp": "05:47:07", "text": "もの。犬はもっと"}, {"type": "subtitle", "time": 20830.35, "timestamp": "05:47:10", "text": "彼らに忠実"}, {"type": "subtitle", "time": 20832.948, "timestamp": "05:47:12", "text": "所有者。しかし、猫はそうかもしれない。それ"}, {"type": "subtitle", "time": 20834.67, "timestamp": "05:47:14", "text": "猫によると思うよ。私はしません"}, {"type": "subtitle", "time": 20837.948, "timestamp": "05:47:17", "text": "知る。彼らは気まぐれで"}, {"type": "subtitle", "time": 20840.548, "timestamp": "05:47:20", "text": "何か、わかるでしょ？考えてみると"}, {"type": "subtitle", "time": 20843.948, "timestamp": "05:47:23", "text": "実際そうなんです。あなたもそう感じませんか？"}, {"type": "subtitle", "time": 20846.91, "timestamp": "05:47:26", "text": "いくつかいくつか"}, {"type": "subtitle", "time": 20850.47, "timestamp": "05:47:30", "text": "犬たちは、まるで、いや、もし"}, {"type": "subtitle", "time": 20852.47, "timestamp": "05:47:32", "text": "何かが起こるが、泥棒や"}, {"type": "subtitle", "time": 20854.948, "timestamp": "05:47:34", "text": "バカバキが来て、"}, {"type": "subtitle", "time": 20857.59, "timestamp": "05:47:37", "text": "アラートも出ますし、その他いろいろ。だからそれは"}, {"type": "subtitle", "time": 20859.11, "timestamp": "05:47:39", "text": "こう考えてみてください。"}, {"type": "subtitle", "time": 20860.19, "timestamp": "05:47:40", "text": "彼らは"}, {"type": "subtitle", "time": 20863.91, "timestamp": "05:47:43", "text": "えっと、気が強い、というのがぴったりの言葉ですね。また、"}, {"type": "subtitle", "time": 20868.24, "timestamp": "05:47:48", "text": "ストリームへようこそ、またはいいねして"}, {"type": "subtitle", "time": 20869.788, "timestamp": "05:47:49", "text": "[音楽]"}, {"type": "subtitle", "time": 20873.51, "timestamp": "05:47:53", "text": "「はい」と言ってください。うん。うん。私は私は"}, {"type": "subtitle", "time": 20875.99, "timestamp": "05:47:55", "text": "猫や犬が悪いと言っているわけではありません。わかった。"}, {"type": "subtitle", "time": 20878.39, "timestamp": "05:47:58", "text": "猫によるって言ってるんだよ"}]
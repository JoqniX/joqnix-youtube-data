[{"type": "subtitle", "time": 18840.948, "timestamp": "05:14:00", "text": "ああ、私は観戦しているだけです。私はそうあるべきではない"}, {"type": "subtitle", "time": 18850.03, "timestamp": "05:14:10", "text": "こちらの曲を演奏しましょう。"}, {"type": "subtitle", "time": 18852.788, "timestamp": "05:14:12", "text": "わかった。だって俺はビリー・ビリーだから。それが理由です"}, {"type": "subtitle", "time": 18860.07, "timestamp": "05:14:20", "text": "注意深い。皆さん、こんばんは。そして"}, {"type": "subtitle", "time": 18862.43, "timestamp": "05:14:22", "text": "こんにちは。うん。"}, {"type": "subtitle", "time": 18864.91, "timestamp": "05:14:24", "text": "こんにちは。ああ、"}, {"type": "subtitle", "time": 18867.91, "timestamp": "05:14:27", "text": "神。私は少し遅れて"}, {"type": "subtitle", "time": 18873.35, "timestamp": "05:14:33", "text": "配信中ですが、すべて順調であることを願っています。"}, {"type": "subtitle", "time": 18876.91, "timestamp": "05:14:36", "text": "こんにちは。翻訳が"}, {"type": "subtitle", "time": 18880.83, "timestamp": "05:14:40", "text": "働く。えっと、もっと"}, {"type": "subtitle", "time": 18883.51, "timestamp": "05:14:43", "text": "より大きく。こんにちは、アロンソサさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 18885.788, "timestamp": "05:14:45", "text": "配信へようこ​​そ。"}, {"type": "subtitle", "time": 18888.43, "timestamp": "05:14:48", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 18890.75, "timestamp": "05:14:50", "text": "こんにちは。わかった。"}, {"type": "subtitle", "time": 18894.19, "timestamp": "05:14:54", "text": "えっと、ちょっと待ってください。わかった。"}, {"type": "subtitle", "time": 18897.628, "timestamp": "05:14:57", "text": "えっと、これを直させてください"}]
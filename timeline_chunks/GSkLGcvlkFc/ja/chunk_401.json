[{"type": "subtitle", "time": 24061.468, "timestamp": "06:41:01", "text": "ブラックリスト"}, {"type": "subtitle", "time": 24065.11, "timestamp": "06:41:05", "text": "ストリーミングできないゲームの種類"}, {"type": "subtitle", "time": 24067.75, "timestamp": "06:41:07", "text": "あれの。そう、私はそうしなければならない"}, {"type": "subtitle", "time": 24070.628, "timestamp": "06:41:10", "text": "その点に関しては、実際には注意が必要だ"}, {"type": "subtitle", "time": 24079.11, "timestamp": "06:41:19", "text": "もの。なぜ翻訳ではオーストラリアと言っているのですか？"}, {"type": "subtitle", "time": 24085.23, "timestamp": "06:41:25", "text": "何？何？"}, {"type": "subtitle", "time": 24087.628, "timestamp": "06:41:27", "text": "はぁ？"}, {"type": "subtitle", "time": 24089.31, "timestamp": "06:41:29", "text": "何？"}, {"type": "subtitle", "time": 24093.868, "timestamp": "06:41:33", "text": "ナノ、どうしてこれが好きなの？なぜこれをするのか"}, {"type": "subtitle", "time": 24099.35, "timestamp": "06:41:39", "text": "翻訳？わかった。そうそう。えっと、それは"}, {"type": "subtitle", "time": 24101.75, "timestamp": "06:41:41", "text": "現在1時間30分です。私たちはテストしていません"}, {"type": "subtitle", "time": 24105.27, "timestamp": "06:41:45", "text": "トランポリンよりも優れている。ああ、そうだね。"}, {"type": "subtitle", "time": 24107.99, "timestamp": "06:41:47", "text": "それについては後ほど検討します。わかった。"}, {"type": "subtitle", "time": 24110.548, "timestamp": "06:41:50", "text": "今日の配信では、"}, {"type": "subtitle", "time": 24113.59, "timestamp": "06:41:53", "text": "ただおしゃべりして、主に私が"}, {"type": "subtitle", "time": 24116.628, "timestamp": "06:41:56", "text": "もし私が小さなことから始められるなら"}, {"type": "subtitle", "time": 24119.27, "timestamp": "06:41:59", "text": "話し合いを続け、"}]
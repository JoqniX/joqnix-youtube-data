[{"type": "subtitle", "time": 20581.19, "timestamp": "05:43:01", "text": "右？家によっては許可されていないところもあります"}, {"type": "subtitle", "time": 20582.51, "timestamp": "05:43:02", "text": "に"}, {"type": "subtitle", "time": 20586.31, "timestamp": "05:43:06", "text": "えっと、ペットを飼うことを許可しているとか、そういうことです"}, {"type": "subtitle", "time": 20588.868, "timestamp": "05:43:08", "text": "中に入れておかないと、あちこちでうんちしちゃうよ"}, {"type": "subtitle", "time": 20592.628, "timestamp": "05:43:12", "text": "などなど。そういうこと全部ですよね？うん。それ"}, {"type": "subtitle", "time": 20594.99, "timestamp": "05:43:14", "text": "彼らにとって片付けるのは大変だろう"}, {"type": "subtitle", "time": 20598.23, "timestamp": "05:43:18", "text": "など。だからアレルギーのある人もいれば、"}, {"type": "subtitle", "time": 20601.948, "timestamp": "05:43:21", "text": "何か。わからない。場合によります。それで"}, {"type": "subtitle", "time": 20605.51, "timestamp": "05:43:25", "text": "ああ、私も"}, {"type": "subtitle", "time": 20609.27, "timestamp": "05:43:29", "text": "えっと、私は、私は、"}, {"type": "subtitle", "time": 20611.99, "timestamp": "05:43:31", "text": "猫と一緒に寝ることもできる"}, {"type": "subtitle", "time": 20614.27, "timestamp": "05:43:34", "text": "そして実際"}, {"type": "subtitle", "time": 20617.548, "timestamp": "05:43:37", "text": "えっと、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 20621.708, "timestamp": "05:43:41", "text": "えっと、責任を取って、実際に"}, {"type": "subtitle", "time": 20624.868, "timestamp": "05:43:44", "text": "えっと、猫と一緒に暮らして、あなたみたいに"}, {"type": "subtitle", "time": 20627.67, "timestamp": "05:43:47", "text": "一緒に寝て、撫でるのが好きだと知っている"}, {"type": "subtitle", "time": 20632.07, "timestamp": "05:43:52", "text": "時間。私の小さな安心空間になって"}, {"type": "subtitle", "time": 20635.67, "timestamp": "05:43:55", "text": "いつも私の安心感を与えてくれる生き物"}, {"type": "subtitle", "time": 20638.83, "timestamp": "05:43:58", "text": "撫でて温もりを感じるなど"}]
[{"type": "subtitle", "time": 22621.59, "timestamp": "06:17:01", "text": "忘れた。えっと、何か言おうと思ってたんだけど"}, {"type": "subtitle", "time": 22623.23, "timestamp": "06:17:03", "text": "それから私は"}, {"type": "subtitle", "time": 22626.39, "timestamp": "06:17:06", "text": "忘れた。えっと、この目覚まし時計"}, {"type": "subtitle", "time": 22629.19, "timestamp": "06:17:09", "text": "通知の仕組みが迷惑です"}, {"type": "subtitle", "time": 22632.43, "timestamp": "06:17:12", "text": "待って、あのね？えっと、"}, {"type": "subtitle", "time": 22635.51, "timestamp": "06:17:15", "text": "分。携帯電話を使って翻訳します"}, {"type": "subtitle", "time": 22643.03, "timestamp": "06:17:23", "text": "わかった。いつか、いつか良い日に、"}, {"type": "subtitle", "time": 22645.948, "timestamp": "06:17:25", "text": "私は読むことができます"}, {"type": "subtitle", "time": 22655.83, "timestamp": "06:17:35", "text": "乱す？わかった。おやすみメッセージはお控えください。"}, {"type": "subtitle", "time": 22657.6, "timestamp": "06:17:37", "text": "わかった。ああ、"}, {"type": "subtitle", "time": 22660.83, "timestamp": "06:17:40", "text": "[音楽]"}, {"type": "subtitle", "time": 22663.27, "timestamp": "06:17:43", "text": "間隔。メッセージを受信する"}, {"type": "subtitle", "time": 22672.628, "timestamp": "06:17:52", "text": "グループアシスタントに参加して待っていますが、"}, {"type": "subtitle", "time": 22674.628, "timestamp": "06:17:54", "text": "思い出させる。よし、最初の選択肢がいいと思う"}, {"type": "subtitle", "time": 22678.15, "timestamp": "06:17:58", "text": "それは私にとって良いことです。うん。はい、これで大丈夫です"}]
[{"type": "subtitle", "time": 19200.67, "timestamp": "05:20:00", "text": "人々がおしゃべりできる場所みたいなもの"}, {"type": "subtitle", "time": 19205.03, "timestamp": "05:20:05", "text": "Q設定のビリービリーからのもの"}, {"type": "subtitle", "time": 19208.868, "timestamp": "05:20:08", "text": "質疑応答コーナーをもっと充実させよう。ええ、私はこう思いました"}, {"type": "subtitle", "time": 19211.91, "timestamp": "05:20:11", "text": "他の調査や確認"}, {"type": "subtitle", "time": 19215.91, "timestamp": "05:20:15", "text": "クリエイターたちもこれを使いました。どうやって"}, {"type": "subtitle", "time": 19220.708, "timestamp": "05:20:20", "text": "やる？これを正しく行うにはどうすればいいですか？"}, {"type": "subtitle", "time": 19223.31, "timestamp": "05:20:23", "text": "物と"}, {"type": "subtitle", "time": 19227.35, "timestamp": "05:20:27", "text": "など。ああ、大変だ。心の奥底では"}, {"type": "subtitle", "time": 19229.19, "timestamp": "05:20:29", "text": "確認して確認して、どうすればいいですか、"}, {"type": "subtitle", "time": 19232.35, "timestamp": "05:20:32", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 19235.67, "timestamp": "05:20:35", "text": "もの。それで、新しいものを作りました。はい、私は"}, {"type": "subtitle", "time": 19237.27, "timestamp": "05:20:37", "text": "気づいたかどうかわかりませんが、"}, {"type": "subtitle", "time": 19239.19, "timestamp": "05:20:39", "text": "セラ"}, {"type": "subtitle", "time": 19241.67, "timestamp": "05:20:41", "text": "えっと、翻訳がすごい"}, {"type": "subtitle", "time": 19242.75, "timestamp": "05:20:42", "text": "間違っている。"}, {"type": "subtitle", "time": 19244.27, "timestamp": "05:20:44", "text": "何？"}, {"type": "subtitle", "time": 19247.99, "timestamp": "05:20:47", "text": "待って、なぜこんなに翻訳が間違っているの？"}, {"type": "subtitle", "time": 19250.788, "timestamp": "05:20:50", "text": "これは普通のことですか？待って、これは違う"}, {"type": "subtitle", "time": 19253.31, "timestamp": "05:20:53", "text": "普通。"}]
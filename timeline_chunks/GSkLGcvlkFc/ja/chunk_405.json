[{"type": "subtitle", "time": 24301.07, "timestamp": "06:45:01", "text": "私にそれができるかどうかさえ分からない。しかし"}, {"type": "subtitle", "time": 24304.548, "timestamp": "06:45:04", "text": "ええ、メンテナンスとか全部です。何"}, {"type": "subtitle", "time": 24307.03, "timestamp": "06:45:07", "text": "あなたのブガッティの色は？何？私はしません"}, {"type": "subtitle", "time": 24317.15, "timestamp": "06:45:17", "text": "はぁ？ああ、なんてことだ、私の鼻が。はい、ピンク"}, {"type": "subtitle", "time": 24319.99, "timestamp": "06:45:19", "text": "トランポリン。えっと、カテゴリーはありますか？"}, {"type": "subtitle", "time": 24321.39, "timestamp": "06:45:21", "text": "切り替え可能"}, {"type": "subtitle", "time": 24323.67, "timestamp": "06:45:23", "text": "に？いいえ。そうです。ないと思います"}, {"type": "subtitle", "time": 24325.67, "timestamp": "06:45:25", "text": "ピンクのトランポリン専用のカテゴリー。"}, {"type": "subtitle", "time": 24332.27, "timestamp": "06:45:32", "text": "チェック。"}, {"type": "subtitle", "time": 24334.0, "timestamp": "06:45:34", "text": "ピンク"}, {"type": "subtitle", "time": 24342.67, "timestamp": "06:45:42", "text": "トランポリン。いいえ、そこにはありません。"}, {"type": "subtitle", "time": 24345.628, "timestamp": "06:45:45", "text": "わかった。"}, {"type": "subtitle", "time": 24348.708, "timestamp": "06:45:48", "text": "踏みつけなかった。ああ、テンプルオン。わかった。ない"}, {"type": "subtitle", "time": 24355.35, "timestamp": "06:45:55", "text": "わかった。えっと、これに切り替えてもいいかな。"}, {"type": "subtitle", "time": 24357.03, "timestamp": "06:45:57", "text": "ええ、不足しないように気をつけなければなりません"}, {"type": "subtitle", "time": 24359.43, "timestamp": "06:45:59", "text": "Twitchでも何でもいい。そうなってほしくない"}]
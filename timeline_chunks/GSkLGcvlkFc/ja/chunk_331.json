[{"type": "subtitle", "time": 19860.868, "timestamp": "05:31:00", "text": "2つのストリームと1つの信じられるストリームI"}, {"type": "subtitle", "time": 19864.39, "timestamp": "05:31:04", "text": "いくつか問題があることに気づきました。"}, {"type": "subtitle", "time": 19866.23, "timestamp": "05:31:06", "text": "そこで私は確認していた"}, {"type": "subtitle", "time": 19869.15, "timestamp": "05:31:09", "text": "決して起こらないし、中断するみたい"}, {"type": "subtitle", "time": 19872.708, "timestamp": "05:31:12", "text": "法律。第4話はいかがでしたか？それ"}, {"type": "subtitle", "time": 19876.19, "timestamp": "05:31:16", "text": "良かった。第4話が何話だったか忘れてしまった。"}, {"type": "subtitle", "time": 19880.03, "timestamp": "05:31:20", "text": "うん、良かったよ。えっと、それはそれは"}, {"type": "subtitle", "time": 19882.99, "timestamp": "05:31:22", "text": "3人目のキャラクターのことですよね？の"}, {"type": "subtitle", "time": 19886.07, "timestamp": "05:31:26", "text": "ブロンドでツインテールみたいな感じ"}, {"type": "subtitle", "time": 19888.708, "timestamp": "05:31:28", "text": "ショートヘッド。えっと、"}, {"type": "subtitle", "time": 19890.868, "timestamp": "05:31:30", "text": "ええと、3人目のキャラクターは"}, {"type": "subtitle", "time": 19893.19, "timestamp": "05:31:33", "text": "来る予定だけど、まだ見てない"}, {"type": "subtitle", "time": 19895.43, "timestamp": "05:31:35", "text": "エピソード。楽しみです。リマインダー"}, {"type": "subtitle", "time": 19897.75, "timestamp": "05:31:37", "text": "シノコの私。ええ、話しました"}, {"type": "subtitle", "time": 19899.99, "timestamp": "05:31:39", "text": "私が話していたとき、これは、"}, {"type": "subtitle", "time": 19903.03, "timestamp": "05:31:43", "text": "アニメとかそういうもの。えっと、どのストリームが"}, {"type": "subtitle", "time": 19905.43, "timestamp": "05:31:45", "text": "それ？ポッドキャストで聞いたと思うんだけど"}, {"type": "subtitle", "time": 19907.67, "timestamp": "05:31:47", "text": "タサン。"}, {"type": "subtitle", "time": 19911.83, "timestamp": "05:31:51", "text": "わからない。でも、その辺りでは"}, {"type": "subtitle", "time": 19914.628, "timestamp": "05:31:54", "text": "それらのストリームは、私が始める前に"}, {"type": "subtitle", "time": 19916.35, "timestamp": "05:31:56", "text": "この衰弱させる波は砕き、"}, {"type": "subtitle", "time": 19919.83, "timestamp": "05:31:59", "text": "すべて、私はどのように"}]
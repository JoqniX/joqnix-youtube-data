[{"type": "subtitle", "time": 4441.189, "timestamp": "01:14:01", "text": "原子のコンポーネントを見ていきます"}, {"type": "subtitle", "time": 4443.59, "timestamp": "01:14:03", "text": "デザイン。早速始めましょう。"}, {"type": "subtitle", "time": 4445.27, "timestamp": "01:14:05", "text": "シンプルな部品。そしてそれによって私たちも"}, {"type": "subtitle", "time": 4447.59, "timestamp": "01:14:07", "text": "そもそもコンポーネントとは何なのかを学ぶ。私は持っている"}, {"type": "subtitle", "time": 4449.27, "timestamp": "01:14:09", "text": "ここに推薦状カードがあり、"}, {"type": "subtitle", "time": 4450.95, "timestamp": "01:14:10", "text": "画像、テキスト、そして「いいね！」"}, {"type": "subtitle", "time": 4452.39, "timestamp": "01:14:12", "text": "ボタン。さて、私が使いたいとしましょう"}, {"type": "subtitle", "time": 4454.07, "timestamp": "01:14:14", "text": "これは私のデザインにおいて非常に重要な要素です。私はただ"}, {"type": "subtitle", "time": 4455.51, "timestamp": "01:14:15", "text": "それを何度も複製しますが、その後"}, {"type": "subtitle", "time": 4456.79, "timestamp": "01:14:16", "text": "何かを変えたい場合、例えば"}, {"type": "subtitle", "time": 4458.63, "timestamp": "01:14:18", "text": "画像をここに表示したいので、"}, {"type": "subtitle", "time": 4459.83, "timestamp": "01:14:19", "text": "すべてにそれを行う必要がある"}, {"type": "subtitle", "time": 4462.07, "timestamp": "01:14:22", "text": "たった1つ。しかし、コンポーネントでは、"}, {"type": "subtitle", "time": 4463.75, "timestamp": "01:14:23", "text": "主要部品のみを変更するだけで、"}, {"type": "subtitle", "time": 4466.07, "timestamp": "01:14:26", "text": "そしてその複製や事例のすべて"}, {"type": "subtitle", "time": 4467.669, "timestamp": "01:14:27", "text": "自動的に変更されます。私は"}, {"type": "subtitle", "time": 4469.669, "timestamp": "01:14:29", "text": "私の推薦状カードを選択し、"}, {"type": "subtitle", "time": 4471.27, "timestamp": "01:14:31", "text": "デザインパネルの上部には、"}, {"type": "subtitle", "time": 4473.27, "timestamp": "01:14:33", "text": "これら4つのダイヤモンドを持っています。タップすると"}, {"type": "subtitle", "time": 4475.43, "timestamp": "01:14:35", "text": "それらに対して、私はコンポーネントを作成しました。"}, {"type": "subtitle", "time": 4477.11, "timestamp": "01:14:37", "text": "紫色をしていることに気づくでしょう"}, {"type": "subtitle", "time": 4478.709, "timestamp": "01:14:38", "text": "その周囲にバウンディングボックスを配置する。そしてあなたは見るでしょう"}, {"type": "subtitle", "time": 4480.63, "timestamp": "01:14:40", "text": "レイヤーパネルにも同じように表示されます。トピック"}, {"type": "subtitle", "time": 4482.87, "timestamp": "01:14:42", "text": "あなたのために。紫色のものはすべて"}, {"type": "subtitle", "time": 4485.03, "timestamp": "01:14:45", "text": "コンポーネントまたはコンポーネントのインスタンス"}, {"type": "subtitle", "time": 4487.03, "timestamp": "01:14:47", "text": "あるいはその複製。だから今、"}, {"type": "subtitle", "time": 4488.79, "timestamp": "01:14:48", "text": "コンポーネントであり、私の中にも存在します"}, {"type": "subtitle", "time": 4490.47, "timestamp": "01:14:50", "text": "アセットパネル。だから、もし私がここに入ると、"}, {"type": "subtitle", "time": 4492.31, "timestamp": "01:14:52", "text": "そこにそれがあるのがわかるでしょう"}, {"type": "subtitle", "time": 4494.149, "timestamp": "01:14:54", "text": "このファイルで作成されました。今私は"}, {"type": "subtitle", "time": 4495.99, "timestamp": "01:14:55", "text": "このコンポーネントのインスタンスを作成します。"}, {"type": "subtitle", "time": 4498.229, "timestamp": "01:14:58", "text": "それを行う方法は3つあります。ドラッグして"}, {"type": "subtitle", "time": 4499.669, "timestamp": "01:14:59", "text": "私のアセットからインスタンスを作成する"}]
[{"type": "subtitle", "time": 20044.07, "timestamp": "05:34:04", "text": "えーと、私が配っているもの"}, {"type": "subtitle", "time": 20046.628, "timestamp": "05:34:06", "text": "公衆が見るべきものと、見るべきでないもの。のために"}, {"type": "subtitle", "time": 20049.59, "timestamp": "05:34:09", "text": "例えば、私のDiscord関連のことですよね？の"}, {"type": "subtitle", "time": 20053.83, "timestamp": "05:34:13", "text": "ステータスや活動状況に関する情報。えっと、私は"}, {"type": "subtitle", "time": 20055.91, "timestamp": "05:34:15", "text": "つまり、物事には二つの側面があるということですよね？"}, {"type": "subtitle", "time": 20059.99, "timestamp": "05:34:19", "text": "時々、YouTuberとしての私にとって、"}, {"type": "subtitle", "time": 20063.59, "timestamp": "05:34:23", "text": "皆さんに知っておいてほしいのは、"}, {"type": "subtitle", "time": 20065.91, "timestamp": "05:34:25", "text": "VTuberジョッキーはそうするの？いいえ、"}, {"type": "subtitle", "time": 20068.868, "timestamp": "05:34:28", "text": "キャラクターがすることなど、その経験、"}, {"type": "subtitle", "time": 20071.51, "timestamp": "05:34:31", "text": "右？例えば、例えば、"}, {"type": "subtitle", "time": 20073.83, "timestamp": "05:34:33", "text": "あなたはそれを何と呼ぶのですか？キャラクターがいるか、"}, {"type": "subtitle", "time": 20076.948, "timestamp": "05:34:36", "text": "アニメキャラクターは何でも好きなもの"}, {"type": "subtitle", "time": 20079.51, "timestamp": "05:34:39", "text": "いつも疑問に思うよね、彼らは何をしているんだろうって。"}, {"type": "subtitle", "time": 20081.23, "timestamp": "05:34:41", "text": "オフ"}, {"type": "subtitle", "time": 20085.91, "timestamp": "05:34:45", "text": "画面だから、私は、えっと、いじろうとする"}, {"type": "subtitle", "time": 20089.51, "timestamp": "05:34:49", "text": "周りに何かを提供するような"}, {"type": "subtitle", "time": 20094.31, "timestamp": "05:34:54", "text": "私は何をしているの？ストリーミングしているの？"}, {"type": "subtitle", "time": 20097.51, "timestamp": "05:34:57", "text": "声に出して考えているあらゆる種類のオペレーション"}, {"type": "subtitle", "time": 20098.27, "timestamp": "05:34:58", "text": "のように"}]
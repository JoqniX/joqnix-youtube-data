[{"type": "subtitle", "time": 24850.31, "timestamp": "06:54:10", "text": "えっと、それから音声が再開します。"}, {"type": "subtitle", "time": 24853.39, "timestamp": "06:54:13", "text": "そして、"}, {"type": "subtitle", "time": 24856.07, "timestamp": "06:54:16", "text": "それ。はい、大丈夫です。大丈夫です。うん、"}, {"type": "subtitle", "time": 24858.03, "timestamp": "06:54:18", "text": "私たちは"}, {"type": "subtitle", "time": 24861.75, "timestamp": "06:54:21", "text": "良い。よし、行こう。私は発表します"}, {"type": "subtitle", "time": 24863.628, "timestamp": "06:54:23", "text": "ヨガ。"}, {"type": "subtitle", "time": 24866.708, "timestamp": "06:54:26", "text": "待って、翻訳者くん。えっと、あなたは"}, {"type": "subtitle", "time": 24867.468, "timestamp": "06:54:27", "text": "来る"}, {"type": "subtitle", "time": 24884.27, "timestamp": "06:54:44", "text": "こんにちは。これで十分でしょう"}, {"type": "subtitle", "time": 24891.8, "timestamp": "06:54:51", "text": "えっと、わかりました。"}, {"type": "subtitle", "time": 24893.15, "timestamp": "06:54:53", "text": "[音楽]"}, {"type": "subtitle", "time": 24896.11, "timestamp": "06:54:56", "text": "作品。近い"}]
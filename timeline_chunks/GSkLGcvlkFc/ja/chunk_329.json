[{"type": "subtitle", "time": 19743.03, "timestamp": "05:29:03", "text": "良い。おお。ニャー。ニャー。私は"}, {"type": "subtitle", "time": 19744.99, "timestamp": "05:29:04", "text": "私が言った。"}, {"type": "subtitle", "time": 19748.15, "timestamp": "05:29:08", "text": "なぜ？これはすごく面白い。"}, {"type": "subtitle", "time": 19750.628, "timestamp": "05:29:10", "text": "えっと、現在エピソード中です。私にさせて"}, {"type": "subtitle", "time": 19753.83, "timestamp": "05:29:13", "text": "チェック。ええと、私はおそらく"}, {"type": "subtitle", "time": 19756.75, "timestamp": "05:29:16", "text": "エピソード。ああ、どこに"}, {"type": "subtitle", "time": 19759.91, "timestamp": "05:29:19", "text": "あなた？えっと、"}, {"type": "subtitle", "time": 19764.51, "timestamp": "05:29:24", "text": "えっと、待って。拡張機能はどこにありますか？"}, {"type": "subtitle", "time": 19767.23, "timestamp": "05:29:27", "text": "何？えっと、"}, {"type": "subtitle", "time": 19770.788, "timestamp": "05:29:30", "text": "何？拡張機能を管理する。待って、"}, {"type": "subtitle", "time": 19778.788, "timestamp": "05:29:38", "text": "何？えっと、私はここにいるべきだと思うのですが"}, {"type": "subtitle", "time": 19781.83, "timestamp": "05:29:41", "text": "第5話。いや、違う、5人じゃない。三つ。"}, {"type": "subtitle", "time": 19784.43, "timestamp": "05:29:44", "text": "３つか４つ、"}, {"type": "subtitle", "time": 19787.15, "timestamp": "05:29:47", "text": "おそらく。待って、それは"}, {"type": "subtitle", "time": 19789.31, "timestamp": "05:29:49", "text": "えーと、1つ"}, {"type": "subtitle", "time": 19792.99, "timestamp": "05:29:52", "text": "2番目？確認してみます。"}, {"type": "subtitle", "time": 19797.868, "timestamp": "05:29:57", "text": "え、何？アップデートではありません。何？"}]
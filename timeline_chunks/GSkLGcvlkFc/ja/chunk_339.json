[{"type": "subtitle", "time": 20340.628, "timestamp": "05:39:00", "text": "何か。うん。セキュリティと"}, {"type": "subtitle", "time": 20343.11, "timestamp": "05:39:03", "text": "すべて、と言えるでしょう。わからない。私"}, {"type": "subtitle", "time": 20345.99, "timestamp": "05:39:05", "text": "たくさん、たくさん、たくさん"}, {"type": "subtitle", "time": 20349.07, "timestamp": "05:39:09", "text": "私の家にいる猫たち。"}, {"type": "subtitle", "time": 20352.11, "timestamp": "05:39:12", "text": "うん。名前とは何か？"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "えっと、私はそうは思わない、つまり私はそうは思わない"}, {"type": "subtitle", "time": 20358.39, "timestamp": "05:39:18", "text": "それは名前です。ニックネームがあるのは"}, {"type": "subtitle", "time": 20360.708, "timestamp": "05:39:20", "text": "たくさんの猫が来て"}, {"type": "subtitle", "time": 20363.07, "timestamp": "05:39:23", "text": "さあ、来て、行って。だから私はそれを呼ぶ"}, {"type": "subtitle", "time": 20370.07, "timestamp": "05:39:30", "text": "猫、だって見失っちゃったんだもん。わかった。私"}, {"type": "subtitle", "time": 20373.83, "timestamp": "05:39:33", "text": "家族と半日ほど一緒にいなかった"}, {"type": "subtitle", "time": 20378.75, "timestamp": "05:39:38", "text": "年と、えっと、私たちは"}, {"type": "subtitle", "time": 20382.788, "timestamp": "05:39:42", "text": "えーっと、えーっと、成長した中くらいのサイズ"}, {"type": "subtitle", "time": 20387.39, "timestamp": "05:39:47", "text": "当時はケトダイエットをしていた。しかしその猫は"}, {"type": "subtitle", "time": 20390.75, "timestamp": "05:39:50", "text": "これ。しかしもう一方"}, {"type": "subtitle", "time": 20394.31, "timestamp": "05:39:54", "text": "えっと、残念ながら、私がそこにいる間に亡くなりました"}, {"type": "subtitle", "time": 20397.708, "timestamp": "05:39:57", "text": "私が滞在していたPGのような場所"}]
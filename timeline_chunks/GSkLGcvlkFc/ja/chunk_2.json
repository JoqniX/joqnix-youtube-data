[{"type": "subtitle", "time": 120.31, "timestamp": "00:02:00", "text": "自分。こんにちは、ムービージャンクション。ようこそ"}, {"type": "subtitle", "time": 141.589, "timestamp": "00:02:21", "text": "[音楽]"}, {"type": "subtitle", "time": 143.67000000000002, "timestamp": "00:02:23", "text": "あと、イントロを入れるのを忘れていました。えっと、"}, {"type": "subtitle", "time": 145.99, "timestamp": "00:02:25", "text": "ジョアソン・デイブへようこそ"}, {"type": "subtitle", "time": 147.22899999999998, "timestamp": "00:02:27", "text": "番号"}, {"type": "subtitle", "time": 150.07, "timestamp": "00:02:30", "text": "50. ヴァネッサの配信へようこ​​そ。その"}, {"type": "subtitle", "time": 153.11, "timestamp": "00:02:33", "text": "現在時刻は午後3時13分です。知っている。私たちは"}, {"type": "subtitle", "time": 155.99, "timestamp": "00:02:35", "text": "朝の頃に始まる予定"}, {"type": "subtitle", "time": 159.47, "timestamp": "00:02:39", "text": "10時、もしくは少なくとも3時には。私もそうでした"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "揚げ足取り。私は「じゃあ、行くよ」って感じだった"}, {"type": "subtitle", "time": 164.22899999999998, "timestamp": "00:02:44", "text": "昼食後に戻って、"}, {"type": "subtitle", "time": 167.82999999999998, "timestamp": "00:02:47", "text": "2番目は最初の部分で、50日目の配信ですが、"}, {"type": "subtitle", "time": 170.79, "timestamp": "00:02:50", "text": "ちょっと遅刻しちゃった。私のせいだ。私は"}, {"type": "subtitle", "time": 173.27, "timestamp": "00:02:53", "text": "ごめん。しかし今日は、"}, {"type": "subtitle", "time": 176.15, "timestamp": "00:02:56", "text": "2番目の部分を拡張する最初の部分"}]
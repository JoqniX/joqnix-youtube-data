[{"type": "subtitle", "time": 20941.35, "timestamp": "05:49:01", "text": "私もそれを見たことがあります。実際には"}, {"type": "subtitle", "time": 20944.15, "timestamp": "05:49:04", "text": "それについての日本の民話と、"}, {"type": "subtitle", "time": 20946.628, "timestamp": "05:49:06", "text": "ミュージックビデオ。私たちはそれについて話したと思います"}, {"type": "subtitle", "time": 20949.03, "timestamp": "05:49:09", "text": "最近のポッドキャストで"}, {"type": "subtitle", "time": 20951.67, "timestamp": "05:49:11", "text": "ええと、音の面では。私は配信しませんでした"}, {"type": "subtitle", "time": 20954.868, "timestamp": "05:49:14", "text": "今週分は先週分です。ええ、でもそれは"}, {"type": "subtitle", "time": 20957.75, "timestamp": "05:49:17", "text": "そこには。私たちは、私が送ったことについて話し合いました。"}, {"type": "subtitle", "time": 20959.548, "timestamp": "05:49:19", "text": "彼女の"}, {"type": "subtitle", "time": 20963.23, "timestamp": "05:49:23", "text": "ビデオ。うん。私はそれを覚えています。"}, {"type": "subtitle", "time": 20968.628, "timestamp": "05:49:28", "text": "うん。それは真実ではありません。うん。"}, {"type": "subtitle", "time": 20971.91, "timestamp": "05:49:31", "text": "すごくかっこいい。さあ、犬がどれほど忠実か見てみましょう。"}, {"type": "subtitle", "time": 20974.788, "timestamp": "05:49:34", "text": "一方、ネコちゃんたちは「あぁ、"}, {"type": "subtitle", "time": 20977.35, "timestamp": "05:49:37", "text": "名誉は失われた。それでは次に進みましょう"}, {"type": "subtitle", "time": 20980.19, "timestamp": "05:49:40", "text": "当時は、名誉のあり方が違っていた。ただぶらぶらするだけ"}, {"type": "subtitle", "time": 20983.75, "timestamp": "05:49:43", "text": "その周り。私は、私はそれを止めることができません。私は持っている"}, {"type": "subtitle", "time": 20985.628, "timestamp": "05:49:45", "text": "自分の人生を生きる"}, {"type": "subtitle", "time": 20988.31, "timestamp": "05:49:48", "text": "人生とか、そういうこと。つまり、それは"}, {"type": "subtitle", "time": 20991.35, "timestamp": "05:49:51", "text": "いいやり方ですね、つまり、それは本当に"}, {"type": "subtitle", "time": 20993.628, "timestamp": "05:49:53", "text": "現実。」しかし"}, {"type": "subtitle", "time": 20996.948, "timestamp": "05:49:56", "text": "うん、でもチンピラって、ほら、"}, {"type": "subtitle", "time": 20998.868, "timestamp": "05:49:58", "text": "私は待って待って待って"}]
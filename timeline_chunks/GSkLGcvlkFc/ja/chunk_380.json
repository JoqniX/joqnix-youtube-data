[{"type": "subtitle", "time": 22800.05, "timestamp": "06:20:00", "text": "ジョジョみたいなバカさ加減。ああ、それは"}, {"type": "subtitle", "time": 22802.35, "timestamp": "06:20:02", "text": "[音楽]"}, {"type": "subtitle", "time": 22806.628, "timestamp": "06:20:06", "text": "面白い。それは興味深いですね。"}, {"type": "subtitle", "time": 22812.23, "timestamp": "06:20:12", "text": "面白い。うん、見てみるべきだね。多分"}, {"type": "subtitle", "time": 22815.59, "timestamp": "06:20:15", "text": "私たち、あの、えっと、もし私が「私たち」と言うなら、"}, {"type": "subtitle", "time": 22817.75, "timestamp": "06:20:17", "text": "見てみて、たぶん私はしないよ"}, {"type": "subtitle", "time": 22820.39, "timestamp": "06:20:20", "text": "それ。では、もし誰かが、もし全員が"}, {"type": "subtitle", "time": 22823.59, "timestamp": "06:20:23", "text": "喜んでやってくれるなら、"}, {"type": "subtitle", "time": 22826.548, "timestamp": "06:20:26", "text": "一緒に観るとか、何かいい方法があるよ。それは"}, {"type": "subtitle", "time": 22829.91, "timestamp": "06:20:29", "text": "まあ、良くなったと思う。わからない。それ"}, {"type": "subtitle", "time": 22832.27, "timestamp": "06:20:32", "text": "つまり、実際に座って"}, {"type": "subtitle", "time": 22843.19, "timestamp": "06:20:43", "text": "それも私がまだやっていないことの一つです"}, {"type": "subtitle", "time": 22844.24, "timestamp": "06:20:44", "text": "見た"}, {"type": "subtitle", "time": 22845.868, "timestamp": "06:20:45", "text": "[音楽]"}, {"type": "subtitle", "time": 22855.948, "timestamp": "06:20:55", "text": "痛みを誇張したユーモア。"}, {"type": "subtitle", "time": 22859.11, "timestamp": "06:20:59", "text": "おお。笑っちゃうかな"}]
[{"type": "subtitle", "time": 9430.469, "timestamp": "02:37:10", "text": "さらにいくつかの作業が完了しました。さて、問題は"}, {"type": "subtitle", "time": 9454.15, "timestamp": "02:37:34", "text": "ドロップダウンメニューで州を選択して名前を変更する"}, {"type": "subtitle", "time": 9458.95, "timestamp": "02:37:38", "text": "そういう類のことです。テキストなし"}, {"type": "subtitle", "time": 9462.469, "timestamp": "02:37:42", "text": "テキストで値を変更すると"}, {"type": "subtitle", "time": 9464.95, "timestamp": "02:37:44", "text": "ドロップダウンになります。"}, {"type": "subtitle", "time": 9467.83, "timestamp": "02:37:47", "text": "周囲の状況によります。"}, {"type": "subtitle", "time": 9470.389, "timestamp": "02:37:50", "text": "これはフレームです。私はたくさんの異なるものを持っています"}, {"type": "subtitle", "time": 9473.19, "timestamp": "02:37:53", "text": "異なるアイコンのコンポーネント"}, {"type": "subtitle", "time": 9475.27, "timestamp": "02:37:55", "text": "インスタンスを選択してください。ここに移動できます。"}, {"type": "subtitle", "time": 9476.95, "timestamp": "02:37:56", "text": "上部のドロップダウンメニュー"}, {"type": "subtitle", "time": 9478.87, "timestamp": "02:37:58", "text": "これは心の事例だと私に言う"}]
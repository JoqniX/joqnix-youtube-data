[{"type": "subtitle", "time": 5041.95, "timestamp": "01:24:01", "text": "マルチコンポーネント編集と何か言ってください"}, {"type": "subtitle", "time": 5044.629, "timestamp": "01:24:04", "text": "違う。見て、そしてそれはすべてを変える"}, {"type": "subtitle", "time": 5046.87, "timestamp": "01:24:06", "text": "一度に複数のインスタンス。テキストコンポーネント"}, {"type": "subtitle", "time": 5048.95, "timestamp": "01:24:08", "text": "特性は非常に強力です。また、"}, {"type": "subtitle", "time": 5050.47, "timestamp": "01:24:10", "text": "この例では明らかにとても簡単です"}, {"type": "subtitle", "time": 5051.91, "timestamp": "01:24:11", "text": "本文にアクセスしてください。倍にする必要がある"}, {"type": "subtitle", "time": 5054.07, "timestamp": "01:24:14", "text": "クリック。でも、もしそれがとても、ほら、"}, {"type": "subtitle", "time": 5055.91, "timestamp": "01:24:15", "text": "ネストされた、ネストされた巨大なコンポーネント、"}, {"type": "subtitle", "time": 5057.83, "timestamp": "01:24:17", "text": "入れ子、中に入れ子、テキストを取得"}, {"type": "subtitle", "time": 5059.59, "timestamp": "01:24:19", "text": "時々、本当にイライラさせられることがある。それで"}, {"type": "subtitle", "time": 5061.11, "timestamp": "01:24:21", "text": "それを簡単に変更できる能力を持つ"}, {"type": "subtitle", "time": 5063.35, "timestamp": "01:24:23", "text": "デザインパネルからの意見は、素晴らしいものでした。さあ"}, {"type": "subtitle", "time": 5065.189, "timestamp": "01:24:25", "text": "2番目のタイプのコンポーネントを見てみましょう"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "これはブール値であるプロパティです。ブール値。"}, {"type": "subtitle", "time": 5069.43, "timestamp": "01:24:29", "text": "ブール値は真偽値です"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "状況。それがブール値のすべてです。その"}, {"type": "subtitle", "time": 5073.91, "timestamp": "01:24:33", "text": "基本的に真実を意味する奇妙な言葉"}, {"type": "subtitle", "time": 5076.39, "timestamp": "01:24:36", "text": "または偽。それでは、ブール演算を行います。"}, {"type": "subtitle", "time": 5077.83, "timestamp": "01:24:37", "text": "不動産を少し違った視点から捉える。"}, {"type": "subtitle", "time": 5079.35, "timestamp": "01:24:39", "text": "コンポーネントを作成する方法は2つあります"}, {"type": "subtitle", "time": 5081.59, "timestamp": "01:24:41", "text": "財産。要素を選択して"}, {"type": "subtitle", "time": 5083.11, "timestamp": "01:24:43", "text": "次に、コンポーネントプロパティを作成します。"}, {"type": "subtitle", "time": 5084.55, "timestamp": "01:24:44", "text": "それ。または、コンポーネントを作成することもできます。"}, {"type": "subtitle", "time": 5086.55, "timestamp": "01:24:46", "text": "プロパティを割り当てて"}, {"type": "subtitle", "time": 5088.95, "timestamp": "01:24:48", "text": "要素。テキストボックスを選択する前に"}, {"type": "subtitle", "time": 5090.95, "timestamp": "01:24:50", "text": "そしてコンポーネントプロパティを追加しました。"}, {"type": "subtitle", "time": 5092.629, "timestamp": "01:24:52", "text": "コンポーネントを選択するだけです。"}, {"type": "subtitle", "time": 5094.79, "timestamp": "01:24:54", "text": "プロパティに追加してブール値を追加します"}, {"type": "subtitle", "time": 5098.629, "timestamp": "01:24:58", "text": "プロパティとアイコン。すると、"}]
[{"type": "subtitle", "time": 24666.23, "timestamp": "06:51:06", "text": "再起動。私はベータ版に切り替えませんでした"}, {"type": "subtitle", "time": 24670.628, "timestamp": "06:51:10", "text": "私のメインセットアップ用に構築します。"}, {"type": "subtitle", "time": 24672.99, "timestamp": "06:51:12", "text": "私はそれをメインに持って行かなかった"}, {"type": "subtitle", "time": 24675.83, "timestamp": "06:51:15", "text": "制作のためではなく、私のために使っています"}, {"type": "subtitle", "time": 24677.31, "timestamp": "06:51:17", "text": "ストリームゲーム"}, {"type": "subtitle", "time": 24681.628, "timestamp": "06:51:21", "text": "PCで配信しないといけないので"}, {"type": "subtitle", "time": 24685.51, "timestamp": "06:51:25", "text": "ゲーム用PCでOBSを使用しています。"}, {"type": "subtitle", "time": 24688.43, "timestamp": "06:51:28", "text": "OBSで配信するのではなく、OBSを使い続けるということです。"}, {"type": "subtitle", "time": 24693.03, "timestamp": "06:51:33", "text": "オープンにして、そちら側からのデータを取り込めるようにする"}, {"type": "subtitle", "time": 24694.67, "timestamp": "06:51:34", "text": "これ"}, {"type": "subtitle", "time": 24698.03, "timestamp": "06:51:38", "text": "PC。はい、表示されていません"}, {"type": "subtitle", "time": 24701.99, "timestamp": "06:51:41", "text": "上。バカ大バカ、なぜあなたは"}, {"type": "subtitle", "time": 24704.548, "timestamp": "06:51:44", "text": "働く？電源を切る必要がありますか"}, {"type": "subtitle", "time": 24706.27, "timestamp": "06:51:46", "text": "ストリーム？"}, {"type": "subtitle", "time": 24710.11, "timestamp": "06:51:50", "text": "なぜ？それは短い"}, {"type": "subtitle", "time": 24714.948, "timestamp": "06:51:54", "text": "デスクトップ。待って、頼むよ。姿を現せ。"}, {"type": "subtitle", "time": 24717.75, "timestamp": "06:51:57", "text": "すべて順調だと思ったとき"}]
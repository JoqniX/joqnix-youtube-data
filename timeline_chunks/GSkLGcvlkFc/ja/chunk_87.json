[{"type": "subtitle", "time": 5221.51, "timestamp": "01:27:01", "text": "テキストと同様に値を入れ替えます"}, {"type": "subtitle", "time": 5222.95, "timestamp": "01:27:02", "text": "それは、あらゆるものの価値を取る"}, {"type": "subtitle", "time": 5224.79, "timestamp": "01:27:04", "text": "すでにそこにあるので、自分の心を知っている"}, {"type": "subtitle", "time": 5227.669, "timestamp": "01:27:07", "text": "今は下に必ずマイナスしてください"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "まず最初に、これが何なのかを説明します。"}, {"type": "subtitle", "time": 5230.87, "timestamp": "01:27:10", "text": "すぐに分かりますが、今はただマイナスにしましょう"}, {"type": "subtitle", "time": 5232.79, "timestamp": "01:27:12", "text": "それを作成してプロパティを作成すると、"}, {"type": "subtitle", "time": 5234.55, "timestamp": "01:27:14", "text": "ボタンインスタンスを選択すると、"}, {"type": "subtitle", "time": 5236.55, "timestamp": "01:27:16", "text": "ドロップダウンリストが同じドロップダウンリストにある"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "以前ここにあったものですね。"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "すべてを表面に出すので、"}, {"type": "subtitle", "time": 5242.39, "timestamp": "01:27:22", "text": "選択するためにダブルクリックする必要はありません"}, {"type": "subtitle", "time": 5243.83, "timestamp": "01:27:23", "text": "バリアントを探し、ドロップを探します"}, {"type": "subtitle", "time": 5245.43, "timestamp": "01:27:25", "text": "下へ、私が選択するとそこにあります"}, {"type": "subtitle", "time": 5247.27, "timestamp": "01:27:27", "text": "成分。これで、"}, {"type": "subtitle", "time": 5249.99, "timestamp": "01:27:29", "text": "目、または矢印に変更することもできます。"}, {"type": "subtitle", "time": 5251.91, "timestamp": "01:27:31", "text": "私が欲しいものは何でも。 Figma は、"}, {"type": "subtitle", "time": 5253.91, "timestamp": "01:27:33", "text": "優先値を作成するオプションと"}, {"type": "subtitle", "time": 5255.03, "timestamp": "01:27:35", "text": "それが私たちが目にしたことで、"}, {"type": "subtitle", "time": 5256.87, "timestamp": "01:27:36", "text": "マイナス。それでは、それについて調べてみましょう。私はできる"}, {"type": "subtitle", "time": 5258.79, "timestamp": "01:27:38", "text": "この編集ボタンを見ると、"}, {"type": "subtitle", "time": 5260.87, "timestamp": "01:27:40", "text": "好ましい値。プラスをクリックすると、"}, {"type": "subtitle", "time": 5262.709, "timestamp": "01:27:42", "text": "これにより、"}, {"type": "subtitle", "time": 5265.11, "timestamp": "01:27:45", "text": "オプション。では、私が欲しいのは"}, {"type": "subtitle", "time": 5266.95, "timestamp": "01:27:46", "text": "ユーザーが矢印を選択できるようにする"}, {"type": "subtitle", "time": 5269.99, "timestamp": "01:27:49", "text": "左、右矢印、そしてジャンプ。うん、"}, {"type": "subtitle", "time": 5272.229, "timestamp": "01:27:52", "text": "それでおしまい。それ以上ではない。では今"}, {"type": "subtitle", "time": 5273.75, "timestamp": "01:27:53", "text": "このインスタンスに移動して見てみると"}, {"type": "subtitle", "time": 5275.59, "timestamp": "01:27:55", "text": "ドロップダウンメニューには、"}, {"type": "subtitle", "time": 5277.189, "timestamp": "01:27:57", "text": "推奨"}, {"type": "subtitle", "time": 5279.75, "timestamp": "01:27:59", "text": "他の人に相談してもいいですよね？私はただ行くことができます"}]
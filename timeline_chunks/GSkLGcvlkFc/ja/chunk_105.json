[{"type": "subtitle", "time": 6335.669, "timestamp": "01:45:35", "text": "いや、違う。これは私が持っているものとは違います。"}, {"type": "subtitle", "time": 6338.229, "timestamp": "01:45:38", "text": "待って、いや、いや、いや、いや、いや、いや、いや。それは"}, {"type": "subtitle", "time": 6342.189, "timestamp": "01:45:42", "text": "間違っている。待って、睡眠は別物だ、"}, {"type": "subtitle", "time": 6345.109, "timestamp": "01:45:45", "text": "右？ジョッカスはベッドに入った。それは"}, {"type": "subtitle", "time": 6347.95, "timestamp": "01:45:47", "text": "1人が寝ている。"}, {"type": "subtitle", "time": 6351.75, "timestamp": "01:45:51", "text": "何？私がそれを変えたのはいつだったっけ？はぁ？私は"}, {"type": "subtitle", "time": 6353.79, "timestamp": "01:45:53", "text": "それも元に戻す"}, {"type": "subtitle", "time": 6356.43, "timestamp": "01:45:56", "text": "遠い？"}]
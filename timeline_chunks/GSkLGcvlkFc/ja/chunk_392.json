[{"type": "subtitle", "time": 23521.468, "timestamp": "06:32:01", "text": "一度？の"}, {"type": "subtitle", "time": 23528.788, "timestamp": "06:32:08", "text": "ミッションミッションゲーム。"}, {"type": "subtitle", "time": 23532.548, "timestamp": "06:32:12", "text": "来て。何かがそこにあるはずだ。 D."}, {"type": "subtitle", "time": 23535.708, "timestamp": "06:32:15", "text": "ありえない"}, {"type": "subtitle", "time": 23538.51, "timestamp": "06:32:18", "text": "いいえ、それは何と呼ばれていますか？"}, {"type": "subtitle", "time": 23542.548, "timestamp": "06:32:22", "text": "合計？ああ、トータル・オーバードーズ。バカ。手に入れた"}, {"type": "subtitle", "time": 23546.548, "timestamp": "06:32:26", "text": "それ。メキシコのゲーム。もちろん。合計"}, {"type": "subtitle", "time": 23549.03, "timestamp": "06:32:29", "text": "過剰摂取。メキシコを舞台にしたガンマンの物語"}, {"type": "subtitle", "time": 23551.19, "timestamp": "06:32:31", "text": "オープンワールドの三人称視点シューティングゲーム"}, {"type": "subtitle", "time": 23555.23, "timestamp": "06:32:35", "text": "Deadline Gamesが開発したゲーム。うん、"}, {"type": "subtitle", "time": 23559.19, "timestamp": "06:32:39", "text": "元。何てことだ。ついに、あなたを見つけたわ。"}, {"type": "subtitle", "time": 23563.43, "timestamp": "06:32:43", "text": "合計でそれらを超える。 DEA（麻薬取締局）私はこれが恋しい"}, {"type": "subtitle", "time": 23567.43, "timestamp": "06:32:47", "text": "ディオ。このゲームが恋しい。私はかつて教会の席に座っていた"}, {"type": "subtitle", "time": 23570.03, "timestamp": "06:32:50", "text": "ピューピューピューピュー"}, {"type": "subtitle", "time": 23574.03, "timestamp": "06:32:54", "text": "楽しい。私はこれを楽しんだ"}]
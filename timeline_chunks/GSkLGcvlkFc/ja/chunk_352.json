[{"type": "subtitle", "time": 21121.43, "timestamp": "05:52:01", "text": "ええと、信じる人たちのために、ええと、"}, {"type": "subtitle", "time": 21124.07, "timestamp": "05:52:04", "text": "Qチャンネルにいる、えっと、"}, {"type": "subtitle", "time": 21126.23, "timestamp": "05:52:06", "text": "やってみます"}, {"type": "subtitle", "time": 21128.788, "timestamp": "05:52:08", "text": "ストリーミングを試してみて、もしそれが"}, {"type": "subtitle", "time": 21130.83, "timestamp": "05:52:10", "text": "許可します。"}, {"type": "subtitle", "time": 21134.39, "timestamp": "05:52:14", "text": "ええ、ストリーミングについてはテストしていません"}, {"type": "subtitle", "time": 21137.31, "timestamp": "05:52:17", "text": "まだ何かある。音声テストをしてみました"}, {"type": "subtitle", "time": 21141.59, "timestamp": "05:52:21", "text": "チャンネルだけど、うん。えっと、私は"}, {"type": "subtitle", "time": 21144.51, "timestamp": "05:52:24", "text": "それを調べてください。"}, {"type": "subtitle", "time": 21155.03, "timestamp": "05:52:35", "text": "ようこそ。長い間、いいえ。どのように"}, {"type": "subtitle", "time": 21156.19, "timestamp": "05:52:36", "text": "された、"}, {"type": "subtitle", "time": 21159.23, "timestamp": "05:52:39", "text": "バカ？皆さんはどうですか？"}, {"type": "subtitle", "time": 21162.548, "timestamp": "05:52:42", "text": "された？うん、最近はこんな感じ"}, {"type": "subtitle", "time": 21165.27, "timestamp": "05:52:45", "text": "そしてストリーミングをやめて"}, {"type": "subtitle", "time": 21173.47, "timestamp": "05:52:53", "text": "みんな。ああ、私の元カレを開いて。"}, {"type": "subtitle", "time": 21176.19, "timestamp": "05:52:56", "text": "何？私の何を開けるの？"}]
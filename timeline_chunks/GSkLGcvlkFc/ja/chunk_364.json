[{"type": "subtitle", "time": 21842.31, "timestamp": "06:04:02", "text": "どちらのことを言っているのですか？の"}, {"type": "subtitle", "time": 21844.19, "timestamp": "06:04:04", "text": "奇妙な会話"}, {"type": "subtitle", "time": 21848.39, "timestamp": "06:04:08", "text": "あれって最近のやつ？"}, {"type": "subtitle", "time": 21851.67, "timestamp": "06:04:11", "text": "VT で気づいたんだけど、"}, {"type": "subtitle", "time": 21854.15, "timestamp": "06:04:14", "text": "最近フォローされたのでチェックしてみました"}, {"type": "subtitle", "time": 21856.31, "timestamp": "06:04:16", "text": "いろいろなものがあり、たまたま私はそれらが"}, {"type": "subtitle", "time": 21859.91, "timestamp": "06:04:19", "text": "彼らはインド人なので、"}, {"type": "subtitle", "time": 21863.19, "timestamp": "06:04:23", "text": "彼らのビデオにコメントしたり、"}, {"type": "subtitle", "time": 21866.11, "timestamp": "06:04:26", "text": "最近何か"}, {"type": "subtitle", "time": 21868.51, "timestamp": "06:04:28", "text": "えっと"}, {"type": "subtitle", "time": 21871.75, "timestamp": "06:04:31", "text": "うん、もし私がメッセージを送ったら、私は"}, {"type": "subtitle", "time": 21873.59, "timestamp": "06:04:33", "text": "あなたが話しているのはお父さんのことですね"}, {"type": "subtitle", "time": 21875.23, "timestamp": "06:04:35", "text": "または"}, {"type": "subtitle", "time": 21878.43, "timestamp": "06:04:38", "text": "もしかしたら、誰だったんだろう？私にさせて"}, {"type": "subtitle", "time": 21881.51, "timestamp": "06:04:41", "text": "だって、私はそれが私のためだって知ってるから"}, {"type": "subtitle", "time": 21882.99, "timestamp": "06:04:42", "text": "可算名詞"}, {"type": "subtitle", "time": 21886.47, "timestamp": "06:04:46", "text": "なぜなら私は、うーん、乗ろうとしないからです"}, {"type": "subtitle", "time": 21889.11, "timestamp": "06:04:49", "text": "多くの人々。つまり、私は努力しているのですが、"}, {"type": "subtitle", "time": 21894.11, "timestamp": "06:04:54", "text": "私は距離を置いています、ええと、私は"}, {"type": "subtitle", "time": 21897.43, "timestamp": "06:04:57", "text": "DMでミスターがそこにいるかどうか知りたい"}, {"type": "subtitle", "time": 21899.27, "timestamp": "06:04:59", "text": "コラボレーションを初めて"}]
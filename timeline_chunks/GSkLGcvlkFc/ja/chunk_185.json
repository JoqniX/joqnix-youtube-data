[{"type": "subtitle", "time": 11112.07, "timestamp": "03:05:12", "text": "インタラクションの設定は済ませましたか？何"}, {"type": "subtitle", "time": 11114.79, "timestamp": "03:05:14", "text": "あなたが言っているのは、どのようなやり取りのことですか？私は"}, {"type": "subtitle", "time": 11117.03, "timestamp": "03:05:17", "text": "コンポーネントをいじって遊んでいるだけで、"}, {"type": "chat", "time": 11123.435, "timestamp": "03:05:23", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "where's the flow points tho"}, {"type": "subtitle", "time": 11127.269, "timestamp": "03:05:27", "text": "もの。部品とか色々。うん。"}, {"type": "subtitle", "time": 11129.67, "timestamp": "03:05:29", "text": "部品を使って再生するだけです。私"}, {"type": "subtitle", "time": 11132.11, "timestamp": "03:05:32", "text": "複数の部品を製造"}, {"type": "subtitle", "time": 11142.469, "timestamp": "03:05:42", "text": "はぁ？いや、私が何をしようとしているのか見てください"}, {"type": "subtitle", "time": 11146.269, "timestamp": "03:05:46", "text": "こんな感じです。えっと、いくつか"}, {"type": "subtitle", "time": 11149.19, "timestamp": "03:05:49", "text": "人々はこういうものが好きなんだ。あなた"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "それをクリックして日付を変更し、"}, {"type": "subtitle", "time": 11153.75, "timestamp": "03:05:53", "text": "こういったアイコンはすべて"}, {"type": "subtitle", "time": 11154.67, "timestamp": "03:05:54", "text": "設定。"}, {"type": "subtitle", "time": 11158.15, "timestamp": "03:05:58", "text": "いや、ドラッグアンドドロップみたいなものじゃないよ。これはドラッグじゃない。"}]
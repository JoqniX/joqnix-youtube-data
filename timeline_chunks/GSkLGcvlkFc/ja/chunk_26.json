[{"type": "subtitle", "time": 1565.269, "timestamp": "00:26:05", "text": "それ。理想的には、私はできるはずです"}, {"type": "subtitle", "time": 1568.789, "timestamp": "00:26:08", "text": "聞こえること。今日は"}, {"type": "subtitle", "time": 1571.99, "timestamp": "00:26:11", "text": "水曜日。正直に言うと、私は音楽をやりたかったんです"}, {"type": "subtitle", "time": 1574.75, "timestamp": "00:26:14", "text": "一日中、しかし"}, {"type": "subtitle", "time": 1577.549, "timestamp": "00:26:17", "text": "o"}, {"type": "subtitle", "time": 1600.31, "timestamp": "00:26:40", "text": "一日中音楽をやっていたけど、他のことも"}, {"type": "subtitle", "time": 1605.87, "timestamp": "00:26:45", "text": "右？活動"}, {"type": "subtitle", "time": 1608.669, "timestamp": "00:26:48", "text": "状態。ビリー"}, {"type": "subtitle", "time": 1612.95, "timestamp": "00:26:52", "text": "ログアクティビティのようなもの。"}, {"type": "subtitle", "time": 1617.23, "timestamp": "00:26:57", "text": "多くの自動化のアイデアが生まれた"}]
[{"type": "subtitle", "time": 22500.31, "timestamp": "06:15:00", "text": "中国語なので、えーっと、えーっと、あなたは"}, {"type": "subtitle", "time": 22504.07, "timestamp": "06:15:04", "text": "それって何？両言語間での言語交換"}, {"type": "subtitle", "time": 22507.59, "timestamp": "06:15:07", "text": "そして私が言っていることを説明します。なぜならこれは"}, {"type": "subtitle", "time": 22509.628, "timestamp": "06:15:09", "text": "翻訳関連のものは"}, {"type": "subtitle", "time": 22512.75, "timestamp": "06:15:12", "text": "痛み。だからあなたは"}, {"type": "subtitle", "time": 22515.91, "timestamp": "06:15:15", "text": "意味は、彼らが私にあなたが"}, {"type": "subtitle", "time": 22517.43, "timestamp": "06:15:17", "text": "宇宙最強の人物が証明する"}, {"type": "subtitle", "time": 22519.59, "timestamp": "06:15:19", "text": "それ。だから、この砂を少し取り込む"}, {"type": "subtitle", "time": 22523.11, "timestamp": "06:15:23", "text": "拳を閉じて、また開く。"}, {"type": "subtitle", "time": 22526.75, "timestamp": "06:15:26", "text": "砂がダイヤモンドに変わった。何？"}, {"type": "subtitle", "time": 22530.15, "timestamp": "06:15:30", "text": "本当に？はぁ？しかし、彼はどのようにしてバラクと出会ったのか"}, {"type": "subtitle", "time": 22533.948, "timestamp": "06:15:33", "text": "オバマは？まるでフィクションの物語のように"}, {"type": "subtitle", "time": 22537.548, "timestamp": "06:15:37", "text": "賢い。おお。それは"}, {"type": "subtitle", "time": 22545.15, "timestamp": "06:15:45", "text": "けれど。"}, {"type": "subtitle", "time": 22549.39, "timestamp": "06:15:49", "text": "おお。漫画では。待って、"}, {"type": "subtitle", "time": 22552.788, "timestamp": "06:15:52", "text": "本当に？おお。"}]
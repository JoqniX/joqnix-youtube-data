[{"type": "subtitle", "time": 19923.51, "timestamp": "05:32:03", "text": "えっと、このアニメは本当に良いし、"}, {"type": "subtitle", "time": 19924.91, "timestamp": "05:32:04", "text": "あなたを助けます"}, {"type": "subtitle", "time": 19927.75, "timestamp": "05:32:07", "text": "すべての苦難が何をするのかを想像してみてください"}, {"type": "subtitle", "time": 19930.67, "timestamp": "05:32:10", "text": "これらの声優たちは、"}, {"type": "subtitle", "time": 19933.35, "timestamp": "05:32:13", "text": "すべて。例えばあなたが"}, {"type": "subtitle", "time": 19937.27, "timestamp": "05:32:17", "text": "始まり始めているのは誰ですか"}, {"type": "subtitle", "time": 19939.67, "timestamp": "05:32:19", "text": "音声編集などをやりたいと思っていて"}, {"type": "subtitle", "time": 19941.868, "timestamp": "05:32:21", "text": "最終的に代理店と契約し、"}, {"type": "subtitle", "time": 19943.39, "timestamp": "05:32:23", "text": "もの。"}, {"type": "subtitle", "time": 19947.27, "timestamp": "05:32:27", "text": "ええ、昇進して"}, {"type": "subtitle", "time": 19950.15, "timestamp": "05:32:30", "text": "新しい仕事を得ることは重要です。"}, {"type": "subtitle", "time": 19953.59, "timestamp": "05:32:33", "text": "そうやって成長していくんだよ。それで"}, {"type": "subtitle", "time": 19956.15, "timestamp": "05:32:36", "text": "うん、それはちょっとクールだね"}, {"type": "subtitle", "time": 19958.35, "timestamp": "05:32:38", "text": "内部の景色を見る"}, {"type": "subtitle", "time": 19961.83, "timestamp": "05:32:41", "text": "それ。うん。"}, {"type": "subtitle", "time": 19965.708, "timestamp": "05:32:45", "text": "タイマーをリクエストしてください。もう一度やり直してください。"}, {"type": "subtitle", "time": 19969.628, "timestamp": "05:32:49", "text": "うーん、結構ストーキングしてるみたいですね。"}, {"type": "subtitle", "time": 19973.23, "timestamp": "05:32:53", "text": "えっと、ストーカー行為。何？会話禁止。ああ、"}, {"type": "subtitle", "time": 19975.47, "timestamp": "05:32:55", "text": "翻訳。"}, {"type": "subtitle", "time": 19979.67, "timestamp": "05:32:59", "text": "えっと、いいPNG画像を探してみようかな"}]
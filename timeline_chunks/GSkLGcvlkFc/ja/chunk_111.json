[{"type": "subtitle", "time": 6661.95, "timestamp": "01:51:01", "text": "特性。はい、私たちは"}, {"type": "subtitle", "time": 6664.75, "timestamp": "01:51:04", "text": "それ。えーと、ランチ、"}, {"type": "subtitle", "time": 6668.51, "timestamp": "01:51:08", "text": "朝食、昼食、朝食、"}, {"type": "subtitle", "time": 6671.51, "timestamp": "01:51:11", "text": "昼食、お茶。残りの"}, {"type": "subtitle", "time": 6673.31, "timestamp": "01:51:13", "text": "彼ら、"}, {"type": "subtitle", "time": 6681.31, "timestamp": "01:51:21", "text": "夕食。そしてこれは"}, {"type": "subtitle", "time": 6683.55, "timestamp": "01:51:23", "text": "音楽である"}, {"type": "subtitle", "time": 6687.64, "timestamp": "01:51:27", "text": "クラス。そして、これはプライベートな時間になります。"}, {"type": "subtitle", "time": 6690.07, "timestamp": "01:51:30", "text": "[音楽]"}, {"type": "subtitle", "time": 6700.91, "timestamp": "01:51:40", "text": "勉強する。"}, {"type": "subtitle", "time": 6707.91, "timestamp": "01:51:47", "text": "あれ。ついにテキストを作成しました"}, {"type": "subtitle", "time": 6710.22, "timestamp": "01:51:50", "text": "あれ。よし、その部分は理解できた。"}, {"type": "subtitle", "time": 6711.39, "timestamp": "01:51:51", "text": "[音楽]"}, {"type": "subtitle", "time": 6714.47, "timestamp": "01:51:54", "text": "終わり。もう長くなりすぎる"}, {"type": "subtitle", "time": 6718.07, "timestamp": "01:51:58", "text": "これを見たら、やりすぎだ。ああ、何"}]
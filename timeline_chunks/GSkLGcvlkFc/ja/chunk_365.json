[{"type": "subtitle", "time": 21902.948, "timestamp": "06:05:02", "text": "見知らぬ人、私はあなたに話しかけません"}, {"type": "subtitle", "time": 21905.708, "timestamp": "06:05:05", "text": "あ、待って、読まなくちゃいけないんだ。"}, {"type": "subtitle", "time": 21925.948, "timestamp": "06:05:25", "text": "何？ちょっと待って、指を拭いてあげる。"}, {"type": "subtitle", "time": 21929.31, "timestamp": "06:05:29", "text": "待って、私、このえーと何か食べてるの。"}, {"type": "subtitle", "time": 21932.19, "timestamp": "06:05:32", "text": "待って、私は"}, {"type": "subtitle", "time": 21940.23, "timestamp": "06:05:40", "text": "神。まるで「どうしたの？」って感じ。はい、"}, {"type": "subtitle", "time": 21950.23, "timestamp": "06:05:50", "text": "[音楽]"}, {"type": "subtitle", "time": 21954.19, "timestamp": "06:05:54", "text": "ええ、そういう語彙の人に会ったことはありますが、"}]
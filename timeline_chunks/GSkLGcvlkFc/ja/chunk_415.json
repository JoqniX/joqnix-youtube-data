[{"type": "subtitle", "time": 24900.35, "timestamp": "06:55:00", "text": "それ。 ３、２、１。皆さんに紹介します"}, {"type": "subtitle", "time": 24902.948, "timestamp": "06:55:02", "text": "ピンク色の男の子"}, {"type": "subtitle", "time": 24904.99, "timestamp": "06:55:04", "text": "えっと、"}, {"type": "subtitle", "time": 24911.868, "timestamp": "06:55:11", "text": "えーとトロンボーン、えーとピンクって呼ぶやつ"}, {"type": "subtitle", "time": 24913.868, "timestamp": "06:55:13", "text": "トランポリン。"}, {"type": "subtitle", "time": 24916.39, "timestamp": "06:55:16", "text": "うん。え、何？なぜ、"}, {"type": "subtitle", "time": 24919.788, "timestamp": "06:55:19", "text": "翻訳はハッシュタグになります"}, {"type": "subtitle", "time": 24923.27, "timestamp": "06:55:23", "text": "スラッシュ？はぁ？私は悪態をつきませんでした。何？何"}, {"type": "subtitle", "time": 24925.548, "timestamp": "06:55:25", "text": "どうしたの？"}, {"type": "subtitle", "time": 24934.628, "timestamp": "06:55:34", "text": "あのF11じゃないよね？わかった。こんにちは、こちらは"}, {"type": "subtitle", "time": 24939.31, "timestamp": "06:55:39", "text": "ピング・トランプ、いや、えーと、トーンとかそんな感じ。"}, {"type": "subtitle", "time": 24942.868, "timestamp": "06:55:42", "text": "うん。つまり、このゲームは文字通り"}, {"type": "subtitle", "time": 24947.31, "timestamp": "06:55:47", "text": "音を変調させる。どのような音"}, {"type": "subtitle", "time": 24951.23, "timestamp": "06:55:51", "text": "人間の声帯は？"}, {"type": "subtitle", "time": 24954.548, "timestamp": "06:55:54", "text": "うん、面白いよね？えっと"}, {"type": "subtitle", "time": 24959.39, "timestamp": "06:55:59", "text": "うん。だから、もし私が左クリックしたら"}]
[{"type": "subtitle", "time": 22920.788, "timestamp": "06:22:00", "text": "試験は終わったの？ いいえ、まだ終わってない"}, {"type": "subtitle", "time": 22928.788, "timestamp": "06:22:08", "text": "それは金曜日で、来週の金曜日は21日です。それから"}, {"type": "subtitle", "time": 22946.75, "timestamp": "06:22:26", "text": "彼は1歳の時に子供を殴ったんじゃなかったっけ？"}, {"type": "subtitle", "time": 22955.83, "timestamp": "06:22:35", "text": "くそ、バッキーはかっこいいな。私たちは見るべき"}, {"type": "subtitle", "time": 22959.19, "timestamp": "06:22:39", "text": "いつかはそうなるよ。本当に欲しい"}, {"type": "subtitle", "time": 22961.75, "timestamp": "06:22:41", "text": "コミュニティ関連の活動をさらに促進する"}, {"type": "subtitle", "time": 22963.708, "timestamp": "06:22:43", "text": "不和"}, {"type": "subtitle", "time": 22967.35, "timestamp": "06:22:47", "text": "サーバーですが、ある意味で私は"}, {"type": "subtitle", "time": 22968.75, "timestamp": "06:22:48", "text": "のように"}, {"type": "subtitle", "time": 22972.708, "timestamp": "06:22:52", "text": "コミュニティに心を開くことをやめ"}, {"type": "subtitle", "time": 22975.19, "timestamp": "06:22:55", "text": "イベント。つまり、より少ない方が"}, {"type": "subtitle", "time": 22978.39, "timestamp": "06:22:58", "text": "これはあくまで私の意見ですが。"}]
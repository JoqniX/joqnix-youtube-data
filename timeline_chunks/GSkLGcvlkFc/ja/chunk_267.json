[{"type": "subtitle", "time": 16040.71, "timestamp": "04:27:20", "text": "男。よし、正式に"}, {"type": "subtitle", "time": 16041.87, "timestamp": "04:27:21", "text": "終了した"}, {"type": "subtitle", "time": 16044.03, "timestamp": "04:27:24", "text": "それ。"}, {"type": "subtitle", "time": 16046.429, "timestamp": "04:27:26", "text": "正式に完了しました。"}, {"type": "subtitle", "time": 16049.55, "timestamp": "04:27:29", "text": "こんにちは、ようこそ"}, {"type": "subtitle", "time": 16052.75, "timestamp": "04:27:32", "text": "家。それはかわいい"}, {"type": "subtitle", "time": 16054.02, "timestamp": "04:27:34", "text": "モッド。"}, {"type": "subtitle", "time": 16066.83, "timestamp": "04:27:46", "text": "えっと、終わりました"}, {"type": "subtitle", "time": 16069.99, "timestamp": "04:27:49", "text": "それ。そして、それを輸出しなければならないんですよね？私"}]
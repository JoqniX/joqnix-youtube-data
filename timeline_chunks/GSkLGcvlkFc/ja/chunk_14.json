[{"type": "subtitle", "time": 845.629, "timestamp": "00:14:05", "text": "明日。ホセイアの注文"}, {"type": "subtitle", "time": 849.629, "timestamp": "00:14:09", "text": "遅い。いいえ、父が行きます。私の父は"}, {"type": "subtitle", "time": 860.389, "timestamp": "00:14:20", "text": "だから今注文してもダメだ"}, {"type": "subtitle", "time": 863.509, "timestamp": "00:14:23", "text": "多くの。後で彼に聞いて、そうします。"}, {"type": "subtitle", "time": 865.829, "timestamp": "00:14:25", "text": "はい、途中で中断されるかもしれません。だから私は"}, {"type": "subtitle", "time": 869.31, "timestamp": "00:14:29", "text": "マイクをミュートして状態を作りたい"}, {"type": "chat", "time": 871.918, "timestamp": "00:14:31", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "isn't it better to buy from store then?"}, {"type": "subtitle", "time": 872.15, "timestamp": "00:14:32", "text": "良い。私たちは州を作る。それは違う"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "BRBストレートステートにはならないでしょう。それは"}, {"type": "subtitle", "time": 877.509, "timestamp": "00:14:37", "text": "別の状態になる。そしてそれは私の"}, {"type": "subtitle", "time": 879.91, "timestamp": "00:14:39", "text": "ウィジェットは正常に動作していますか？うまくいっています。私はただ"}, {"type": "subtitle", "time": 882.03, "timestamp": "00:14:42", "text": "それを"}, {"type": "subtitle", "time": 886.15, "timestamp": "00:14:46", "text": "屋根。この店は値段が高い。"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "親愛なるニン、お店の商品は高いですよ。彼らは"}, {"type": "chat", "time": 891.518, "timestamp": "00:14:51", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ooh"}, {"type": "subtitle", "time": 893.43, "timestamp": "00:14:53", "text": "充電器は2,000か1,000だと言われている。"}]
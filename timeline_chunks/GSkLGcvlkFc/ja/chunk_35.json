[{"type": "subtitle", "time": 2125.79, "timestamp": "00:35:25", "text": "よし、かなり埃を払った"}, {"type": "subtitle", "time": 2148.51, "timestamp": "00:35:48", "text": "また、私は"}, {"type": "subtitle", "time": 2151.79, "timestamp": "00:35:51", "text": "ビタミン。思い出させてください。"}, {"type": "subtitle", "time": 2156.349, "timestamp": "00:35:56", "text": "よし、シルバーだ。だから私は"}]
[{"type": "subtitle", "time": 23645.788, "timestamp": "06:34:05", "text": "ええ、本当に"}, {"type": "subtitle", "time": 23650.11, "timestamp": "06:34:10", "text": "楽しい。牛に乗ることができ、"}, {"type": "subtitle", "time": 23656.628, "timestamp": "06:34:16", "text": "いいね。それで、"}, {"type": "subtitle", "time": 23658.948, "timestamp": "06:34:18", "text": "えっと、主人公はキオ・カズムにちょっと似てるね"}, {"type": "subtitle", "time": 23677.51, "timestamp": "06:34:37", "text": "どうして私たちはこの話をすることになったのか"}, {"type": "subtitle", "time": 23680.948, "timestamp": "06:34:40", "text": "突然現れたゲーム？わからない。の"}, {"type": "subtitle", "time": 23683.35, "timestamp": "06:34:43", "text": "ゆっくり。そう、キラービーンのスローモーション。"}, {"type": "subtitle", "time": 23685.03, "timestamp": "06:34:45", "text": "いや、それで思い出したのはこれだ。うん。"}, {"type": "subtitle", "time": 23691.07, "timestamp": "06:34:51", "text": "その通り。ええ、まさにそのゲームです"}, {"type": "subtitle", "time": 23694.41, "timestamp": "06:34:54", "text": "まさにこれを思い出させてくれた。"}]
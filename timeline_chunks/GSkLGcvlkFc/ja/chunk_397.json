[{"type": "subtitle", "time": 23821.75, "timestamp": "06:37:01", "text": "ええ、私は実際に自分が"}, {"type": "subtitle", "time": 23824.628, "timestamp": "06:37:04", "text": "えっと、このゲームについて話す"}, {"type": "subtitle", "time": 23831.35, "timestamp": "06:37:11", "text": "過剰摂取で、​​トイレットペーパーか"}, {"type": "subtitle", "time": 23833.35, "timestamp": "06:37:13", "text": "何か。どうやら、トイレットペーパーではないようです。その"}, {"type": "subtitle", "time": 23841.15, "timestamp": "06:37:21", "text": "過剰摂取。大丈夫。しかし"}, {"type": "subtitle", "time": 23845.03, "timestamp": "06:37:25", "text": "ええ、それでダー、皆さんが"}, {"type": "subtitle", "time": 23847.91, "timestamp": "06:37:27", "text": "覚えて。一度ストリーミング配信で見たことがある。我々は持っていた"}, {"type": "subtitle", "time": 23850.99, "timestamp": "06:37:30", "text": "即興コラボレーション"}, {"type": "subtitle", "time": 23853.868, "timestamp": "06:37:33", "text": "セノスと"}, {"type": "subtitle", "time": 23857.39, "timestamp": "06:37:37", "text": "当時のモーセンとアク。"}, {"type": "subtitle", "time": 23861.03, "timestamp": "06:37:41", "text": "うん。うん。 SenとAkuが配信していた。"}, {"type": "subtitle", "time": 23863.868, "timestamp": "06:37:43", "text": "アレウがそれを配信していた。それともセンだったかな？私"}, {"type": "subtitle", "time": 23867.03, "timestamp": "06:37:47", "text": "忘れた。そして彼らは私がそれをストリーミング配信しているのを見た"}, {"type": "subtitle", "time": 23869.628, "timestamp": "06:37:49", "text": "スチーム。まるで彼らがその物体を見たかのように"}, {"type": "subtitle", "time": 23872.15, "timestamp": "06:37:52", "text": "スチーム。彼らは私の配信に飛びついてきた。私は"}, {"type": "subtitle", "time": 23873.83, "timestamp": "06:37:53", "text": "「一緒に参加したいですか？"}, {"type": "subtitle", "time": 23877.43, "timestamp": "06:37:57", "text": "パーティーしようか？そして、私たちは得点した。"}]
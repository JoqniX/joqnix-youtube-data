[{"type": "subtitle", "time": 20102.31, "timestamp": "05:35:02", "text": "えーっと、アクティビティみたいなやつ。うん、"}, {"type": "subtitle", "time": 20104.708, "timestamp": "05:35:04", "text": "将来は、何らかの方法で"}, {"type": "subtitle", "time": 20108.548, "timestamp": "05:35:08", "text": "それは、私だけでなく、すべての人にとって"}, {"type": "subtitle", "time": 20111.868, "timestamp": "05:35:11", "text": "私のOnXiaのキャラクターは、"}, {"type": "subtitle", "time": 20117.03, "timestamp": "05:35:17", "text": "リアルタイムのデータフィードとか、そういうもの。しかし"}, {"type": "subtitle", "time": 20119.11, "timestamp": "05:35:19", "text": "ええ、このキャラクターは何をしていますか"}, {"type": "subtitle", "time": 20120.948, "timestamp": "05:35:20", "text": "その瞬間？彼はどこにいるのか？何が"}, {"type": "subtitle", "time": 20123.03, "timestamp": "05:35:23", "text": "彼は何をしているのですか？彼女は何をしているの？"}, {"type": "subtitle", "time": 20125.51, "timestamp": "05:35:25", "text": "あれの。なかなかいい感じだね。今"}, {"type": "subtitle", "time": 20127.83, "timestamp": "05:35:27", "text": "ストーリーボードを作って、"}, {"type": "subtitle", "time": 20132.628, "timestamp": "05:35:32", "text": "理論を練る。ああ、なぜ私は"}, {"type": "subtitle", "time": 20135.83, "timestamp": "05:35:35", "text": "ジョーは〇〇にこの場所に行く"}, {"type": "subtitle", "time": 20138.23, "timestamp": "05:35:38", "text": "具体的な時間？なぜこの"}, {"type": "subtitle", "time": 20140.708, "timestamp": "05:35:40", "text": "一年の特定の時期、特に"}, {"type": "subtitle", "time": 20144.15, "timestamp": "05:35:44", "text": "この日、特定の日付ですか？なぜ彼はなぜ"}, {"type": "subtitle", "time": 20147.35, "timestamp": "05:35:47", "text": "この物には、彼は文字通り"}, {"type": "subtitle", "time": 20149.67, "timestamp": "05:35:49", "text": "洞窟の中とか？それから試してみます"}, {"type": "subtitle", "time": 20152.868, "timestamp": "05:35:52", "text": "「ああ、"}, {"type": "subtitle", "time": 20155.35, "timestamp": "05:35:55", "text": "洞窟の中にあるものと"}, {"type": "subtitle", "time": 20157.39, "timestamp": "05:35:57", "text": "すべて"}]
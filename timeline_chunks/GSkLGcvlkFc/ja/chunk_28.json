[{"type": "subtitle", "time": 1686.23, "timestamp": "00:28:06", "text": "スクリプト、そしてビリービリーローカル"}, {"type": "subtitle", "time": 1691.19, "timestamp": "00:28:11", "text": "サーバー関連のもの、つまりこの人です。なぜ"}, {"type": "subtitle", "time": 1693.87, "timestamp": "00:28:13", "text": "複数個が"}, {"type": "subtitle", "time": 1696.23, "timestamp": "00:28:16", "text": "接続されていますか？もう一度確認させてください"}, {"type": "subtitle", "time": 1704.35, "timestamp": "00:28:24", "text": "そうですね、私がやりたいことはいくつかあります"}, {"type": "subtitle", "time": 1708.149, "timestamp": "00:28:28", "text": "する。えっと、ビリービリーのローカルサーバー"}, {"type": "subtitle", "time": 1711.35, "timestamp": "00:28:31", "text": "今日はこれを手に入れよう"}, {"type": "subtitle", "time": 1714.87, "timestamp": "00:28:34", "text": "あらゆる種類のイベントの交流 私と"}, {"type": "subtitle", "time": 1717.75, "timestamp": "00:28:37", "text": "ようやく修正されたメッセージ"}, {"type": "subtitle", "time": 1720.71, "timestamp": "00:28:40", "text": "オンラインアップデートを取得するには、オンラインでアップデートを確認してください。"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "そのエントリを更新するなど。"}, {"type": "subtitle", "time": 1727.029, "timestamp": "00:28:47", "text": "今日中にその件についてDiscordのログを作成してください。"}, {"type": "subtitle", "time": 1729.11, "timestamp": "00:28:49", "text": "必要ないのは分かっているけど、やらなきゃいけない"}, {"type": "subtitle", "time": 1732.31, "timestamp": "00:28:52", "text": "アクティブログのようなものを取得したい"}, {"type": "subtitle", "time": 1734.95, "timestamp": "00:28:54", "text": "川にやってくる人々は"}, {"type": "subtitle", "time": 1736.83, "timestamp": "00:28:56", "text": "ストリームとやり取りしています"}, {"type": "subtitle", "time": 1739.47, "timestamp": "00:28:59", "text": "プレゼントとストリームと"}]
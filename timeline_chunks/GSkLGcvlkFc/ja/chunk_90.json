[{"type": "subtitle", "time": 5408.03, "timestamp": "01:30:08", "text": "それで、それで"}, {"type": "subtitle", "time": 5411.83, "timestamp": "01:30:11", "text": "えーっと、すごく頭を使うやつですね。ああ、それは"}, {"type": "subtitle", "time": 5414.31, "timestamp": "01:30:14", "text": "高度な思考を要する内容。正直言って、それは大きな"}, {"type": "subtitle", "time": 5417.669, "timestamp": "01:30:17", "text": "脳に関すること。ああ、これは本当に"}, {"type": "subtitle", "time": 5424.709, "timestamp": "01:30:24", "text": "正直に言うと、私がこれからすることは"}, {"type": "subtitle", "time": 5436.43, "timestamp": "01:30:36", "text": "これ。私たちはこれに取り組みます"}, {"type": "subtitle", "time": 5447.91, "timestamp": "01:30:47", "text": "えっと、私の理解が正しければ、私は"}, {"type": "subtitle", "time": 5449.55, "timestamp": "01:30:49", "text": "これを変数として"}, {"type": "subtitle", "time": 5458.39, "timestamp": "01:30:58", "text": "状態と多くのブール値を実行するかどうか"}]
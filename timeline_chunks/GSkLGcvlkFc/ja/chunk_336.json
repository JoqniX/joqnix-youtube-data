[{"type": "subtitle", "time": 20160.31, "timestamp": "05:36:00", "text": "こんな感じ、こんな感じ、だから私は"}, {"type": "subtitle", "time": 20162.15, "timestamp": "05:36:02", "text": "その経験を与えるために私は"}, {"type": "subtitle", "time": 20166.07, "timestamp": "05:36:06", "text": "ストッキングの件を宣伝する、つまり、"}, {"type": "subtitle", "time": 20169.03, "timestamp": "05:36:09", "text": "今のところ、私は何を持っているのでしょうか"}, {"type": "subtitle", "time": 20172.39, "timestamp": "05:36:12", "text": "私が聴く音楽は、ジョックの音楽です"}, {"type": "subtitle", "time": 20174.47, "timestamp": "05:36:14", "text": "彼らはすべてを使用したので、"}, {"type": "subtitle", "time": 20176.868, "timestamp": "05:36:16", "text": "文字通り最後のFMからチェックすると、"}, {"type": "subtitle", "time": 20179.67, "timestamp": "05:36:19", "text": "命令感嘆歌も。できる"}, {"type": "subtitle", "time": 20182.868, "timestamp": "05:36:22", "text": "文字通りチェックして、入力してみてください"}, {"type": "subtitle", "time": 20185.91, "timestamp": "05:36:25", "text": "チャットで YouTube または Twitch の感嘆符"}, {"type": "subtitle", "time": 20188.39, "timestamp": "05:36:28", "text": "歌もね。文字通りどの曲か見ることができます"}, {"type": "subtitle", "time": 20190.23, "timestamp": "05:36:30", "text": "今まさにこれを聞いています"}, {"type": "subtitle", "time": 20192.83, "timestamp": "05:36:32", "text": "2回目のリスニング"}, {"type": "subtitle", "time": 20196.47, "timestamp": "05:36:36", "text": "ああ、小さな小さなもの"}, {"type": "subtitle", "time": 20199.19, "timestamp": "05:36:39", "text": "それは、私が、"}, {"type": "subtitle", "time": 20201.75, "timestamp": "05:36:41", "text": "経験か何か分からないけど"}, {"type": "subtitle", "time": 20205.83, "timestamp": "05:36:45", "text": "一般的に言って、ストーカー行為は悪いことです"}, {"type": "subtitle", "time": 20207.91, "timestamp": "05:36:47", "text": "えーっと、つまり、ほら、"}, {"type": "subtitle", "time": 20211.51, "timestamp": "05:36:51", "text": "誰かのことを深く掘り下げすぎると"}, {"type": "subtitle", "time": 20215.11, "timestamp": "05:36:55", "text": "個人情報やその他悪いもの"}, {"type": "subtitle", "time": 20218.27, "timestamp": "05:36:58", "text": "それは良くないですね、それはあまりにも"}]
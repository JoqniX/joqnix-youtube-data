[{"type": "subtitle", "time": 21541.59, "timestamp": "05:59:01", "text": "落ち込んでしまうし、いろいろと。それ"}, {"type": "subtitle", "time": 21544.83, "timestamp": "05:59:04", "text": "妙に変な痛みだった。それ以来"}, {"type": "subtitle", "time": 21549.75, "timestamp": "05:59:09", "text": "それで、私はこう思った。「ああ、このツイッターは"}, {"type": "subtitle", "time": 21551.91, "timestamp": "05:59:11", "text": "相互作用や到達のようなもの"}, {"type": "subtitle", "time": 21553.75, "timestamp": "05:59:13", "text": "見知らぬ人に話しかける"}, {"type": "subtitle", "time": 21555.948, "timestamp": "05:59:15", "text": "インターネット、つまり"}, {"type": "subtitle", "time": 21559.19, "timestamp": "05:59:19", "text": "難しい。しかし、私は諦めなかった。私はただ"}, {"type": "subtitle", "time": 21562.788, "timestamp": "05:59:22", "text": "それでも私は彼らと連絡を取ろうとした"}, {"type": "subtitle", "time": 21566.07, "timestamp": "05:59:26", "text": "などなど。まるであなたが話した後みたい"}, {"type": "subtitle", "time": 21569.35, "timestamp": "05:59:29", "text": "彼らと話す目的について、"}, {"type": "subtitle", "time": 21572.59, "timestamp": "05:59:32", "text": "次に何と言いますか？だから私は"}, {"type": "subtitle", "time": 21575.03, "timestamp": "05:59:35", "text": "混乱した。次に何と言いますか？後"}, {"type": "subtitle", "time": 21578.07, "timestamp": "05:59:38", "text": "それについて、どう思いますか？もしあなたが試みるなら"}, {"type": "subtitle", "time": 21580.39, "timestamp": "05:59:40", "text": "ちょっとした会話、または「こんにちは」「やあ」「元気」と言う"}, {"type": "subtitle", "time": 21583.15, "timestamp": "05:59:43", "text": "朝。それらはすべて"}, {"type": "subtitle", "time": 21586.15, "timestamp": "05:59:46", "text": "時々一部の人にとっては迷惑なように、"}, {"type": "subtitle", "time": 21587.91, "timestamp": "05:59:47", "text": "右？"}, {"type": "subtitle", "time": 21591.03, "timestamp": "05:59:51", "text": "まるで、どうやって来るか分からないようなものだ"}, {"type": "subtitle", "time": 21594.948, "timestamp": "05:59:54", "text": "主題やトピックを思いついたら、失敗する"}, {"type": "subtitle", "time": 21596.788, "timestamp": "05:59:56", "text": "会話か何かで。私"}, {"type": "subtitle", "time": 21598.19, "timestamp": "05:59:58", "text": "しないで"}]
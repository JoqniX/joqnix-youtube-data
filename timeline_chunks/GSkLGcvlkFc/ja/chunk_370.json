[{"type": "subtitle", "time": 22208.788, "timestamp": "06:10:08", "text": "うん。うん、それは大変だね。まだ終わっていない。"}, {"type": "subtitle", "time": 22211.47, "timestamp": "06:10:11", "text": "そして、"}, {"type": "subtitle", "time": 22215.91, "timestamp": "06:10:15", "text": "えっと、現実世界でそれについて話すと"}, {"type": "subtitle", "time": 22219.99, "timestamp": "06:10:19", "text": "えっと、現実的には、それは、いや"}, {"type": "subtitle", "time": 22222.15, "timestamp": "06:10:22", "text": "面と向かって言うような感じ"}, {"type": "subtitle", "time": 22225.35, "timestamp": "06:10:25", "text": "ちょっと問題だけど、自分で解決しないといけないよ。もし"}, {"type": "subtitle", "time": 22228.07, "timestamp": "06:10:28", "text": "一つは、あなたにイライラしているような、あるいは"}, {"type": "subtitle", "time": 22230.628, "timestamp": "06:10:30", "text": "あなたから離れたり、あなたを無視したり、"}, {"type": "subtitle", "time": 22232.47, "timestamp": "06:10:32", "text": "あなたから離れていく、またはあなたとの縁を切る"}, {"type": "subtitle", "time": 22234.868, "timestamp": "06:10:34", "text": "静かに、あるいはそんな感じで、"}, {"type": "subtitle", "time": 22239.19, "timestamp": "06:10:39", "text": "どうやって知ったのか、たぶん、"}, {"type": "subtitle", "time": 22242.15, "timestamp": "06:10:42", "text": "そんな感じ。ちょっと変な感じ"}, {"type": "subtitle", "time": 22244.75, "timestamp": "06:10:44", "text": "システムだが、"}, {"type": "subtitle", "time": 22247.83, "timestamp": "06:10:47", "text": "ああ、そういうものなんだよ。"}, {"type": "subtitle", "time": 22255.11, "timestamp": "06:10:55", "text": "だから、ジョッキーはこれが基本だと言うだろう"}, {"type": "subtitle", "time": 22257.35, "timestamp": "06:10:57", "text": "常識とかそういうことだけど、覚えておいてね"}]
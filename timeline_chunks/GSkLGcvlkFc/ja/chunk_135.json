[{"type": "subtitle", "time": 8109.669, "timestamp": "02:15:09", "text": "これらは問題のある部品です。えっと、底"}, {"type": "subtitle", "time": 8129.43, "timestamp": "02:15:29", "text": "はい、削除できます。はい、３つ"}, {"type": "subtitle", "time": 8130.91, "timestamp": "02:15:30", "text": "物事は"}, {"type": "subtitle", "time": 8133.589, "timestamp": "02:15:33", "text": "終わり。 ３つのことが完了した。テキストは"}, {"type": "subtitle", "time": 8141.31, "timestamp": "02:15:41", "text": "ジョック ジョックと"}, {"type": "subtitle", "time": 8148.79, "timestamp": "02:15:48", "text": "左。これは今やアイコンです。だから私は"}, {"type": "subtitle", "time": 8156.149, "timestamp": "02:15:56", "text": "こうすれば、どんな状態でも変更できます"}, {"type": "subtitle", "time": 8159.43, "timestamp": "02:15:59", "text": "欲しい。でも、私はすぐに"}]
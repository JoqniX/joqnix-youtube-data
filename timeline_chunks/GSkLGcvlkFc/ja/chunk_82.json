[{"type": "subtitle", "time": 4920.39, "timestamp": "01:22:00", "text": "このフレームには、"}, {"type": "subtitle", "time": 4921.99, "timestamp": "01:22:01", "text": "さまざまなコンポーネント"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "異なるアイコン。ここで、"}, {"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "例えば、ここのドロップダウンメニューに移動できます"}, {"type": "subtitle", "time": 4928.55, "timestamp": "01:22:08", "text": "一番上にはこう書いてある"}, {"type": "subtitle", "time": 4930.47, "timestamp": "01:22:10", "text": "心温まる出来事。これを見ると"}, {"type": "subtitle", "time": 4931.83, "timestamp": "01:22:11", "text": "ドロップダウンリストを何かに変更できる"}, {"type": "subtitle", "time": 4933.79, "timestamp": "01:22:13", "text": "そうでなければ、例えば、実際にそれを"}, {"type": "subtitle", "time": 4936.39, "timestamp": "01:22:16", "text": "ベル削除ボタン。うん。だから"}, {"type": "subtitle", "time": 4939.35, "timestamp": "01:22:19", "text": "気をつけた方がいいよ、兄弟。それでは"}, {"type": "subtitle", "time": 4941.75, "timestamp": "01:22:21", "text": "これをコンポーネントにして開始します"}, {"type": "subtitle", "time": 4943.91, "timestamp": "01:22:23", "text": "コンポーネントのプロパティを確認する。だから私は"}, {"type": "subtitle", "time": 4945.75, "timestamp": "01:22:25", "text": "私のボタンをクリックすると、たくさんの"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "コンポーネント関連のもの。ああ、私の脳と"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "すぐにインスタンスを、なぜなら私たちは"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "コンポーネントによって何が変わるかを確認してください"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "特性。私たちの上に小さなタイトルを付けてください"}, {"type": "subtitle", "time": 4956.39, "timestamp": "01:22:36", "text": "これは、"}, {"type": "subtitle", "time": 4958.07, "timestamp": "01:22:38", "text": "メインコンポーネントではなく、インスタンスです。"}, {"type": "subtitle", "time": 4959.669, "timestamp": "01:22:39", "text": "そこで、コンポーネントを追加したいと思います。"}, {"type": "subtitle", "time": 4961.03, "timestamp": "01:22:41", "text": "財産。 3つのタイプがあります"}, {"type": "subtitle", "time": 4962.709, "timestamp": "01:22:42", "text": "コンポーネントの特性。最初の"}, {"type": "subtitle", "time": 4964.79, "timestamp": "01:22:44", "text": "私たちに見てほしいのはテキストです。それでは"}, {"type": "subtitle", "time": 4966.47, "timestamp": "01:22:46", "text": "テキストボックスを選択してください"}, {"type": "subtitle", "time": 4967.83, "timestamp": "01:22:47", "text": "成分。そしてすぐにわかる"}, {"type": "subtitle", "time": 4969.669, "timestamp": "01:22:49", "text": "ここには新しい分野がある"}, {"type": "subtitle", "time": 4971.11, "timestamp": "01:22:51", "text": "通常は手に入らないトップ"}, {"type": "subtitle", "time": 4973.27, "timestamp": "01:22:53", "text": "テキストボックスを選択します。そして私がホバリングすると"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "右側には、ダイヤモンドがあります"}, {"type": "subtitle", "time": 4977.03, "timestamp": "01:22:57", "text": "その中に棒のようなものが入っている。それは"}]
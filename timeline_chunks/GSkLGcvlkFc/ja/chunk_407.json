[{"type": "subtitle", "time": 24427.19, "timestamp": "06:47:07", "text": "上。物事は順調に進んでいる。こんにちは。さあ行こう。"}, {"type": "subtitle", "time": 24435.11, "timestamp": "06:47:15", "text": "つまり、えっと、これはどう発音するんですか？おお、"}, {"type": "subtitle", "time": 24447.868, "timestamp": "06:47:27", "text": "ウィンク"}, {"type": "subtitle", "time": 24450.788, "timestamp": "06:47:30", "text": "トランポリン。わかった。えっと、もしあなたが"}, {"type": "subtitle", "time": 24451.92, "timestamp": "06:47:31", "text": "聞こえるよ。"}, {"type": "subtitle", "time": 24454.11, "timestamp": "06:47:34", "text": "[音楽]"}, {"type": "subtitle", "time": 24458.11, "timestamp": "06:47:38", "text": "えっと、ああ、まずい状況です"}, {"type": "subtitle", "time": 24460.23, "timestamp": "06:47:40", "text": "私たち自身。私のキャプチャカードは"}, {"type": "subtitle", "time": 24462.868, "timestamp": "06:47:42", "text": "接続済み。なんてこった。そして私を下に行かせて"}, {"type": "subtitle", "time": 24474.15, "timestamp": "06:47:54", "text": "2番。少し時間をください。えっと、直させてください"}]
[{"type": "subtitle", "time": 19320.868, "timestamp": "05:22:00", "text": "それ。ということで、私の配信の要約ですね。のために"}, {"type": "subtitle", "time": 19323.59, "timestamp": "05:22:03", "text": "知らない人、私たちが"}, {"type": "subtitle", "time": 19326.47, "timestamp": "05:22:06", "text": "追いつけなかった人のために、"}, {"type": "subtitle", "time": 19328.948, "timestamp": "05:22:08", "text": "それやそれを見逃した人やその他"}, {"type": "subtitle", "time": 19331.83, "timestamp": "05:22:11", "text": "彼らはただ"}, {"type": "subtitle", "time": 19335.51, "timestamp": "05:22:15", "text": "えっと、彼らはただ知りたかっただけなんです"}, {"type": "subtitle", "time": 19339.11, "timestamp": "05:22:19", "text": "何が起こったか、すべて、など。"}, {"type": "subtitle", "time": 19340.91, "timestamp": "05:22:20", "text": "要約のように書く"}, {"type": "subtitle", "time": 19343.83, "timestamp": "05:22:23", "text": "つまり、簡単な要約みたいなものです。"}, {"type": "subtitle", "time": 19346.23, "timestamp": "05:22:26", "text": "わかった。もし私が望むなら、美しくすることもできる"}, {"type": "subtitle", "time": 19348.83, "timestamp": "05:22:28", "text": "Discordユーザー向けにもっと見栄え良くしよう"}, {"type": "subtitle", "time": 19351.67, "timestamp": "05:22:31", "text": "人々。でも、それは短い"}, {"type": "subtitle", "time": 19354.55, "timestamp": "05:22:34", "text": "まとめ。だから、今では私はそれを成し遂げました。"}, {"type": "subtitle", "time": 19356.39, "timestamp": "05:22:36", "text": "今は新しいフォーマットですが、"}, {"type": "subtitle", "time": 19358.948, "timestamp": "05:22:38", "text": "私が作ったシステムは、投稿するので"}, {"type": "subtitle", "time": 19364.15, "timestamp": "05:22:44", "text": "Qに関する情報もあります。えっと、私は作りました、私は"}, {"type": "subtitle", "time": 19366.31, "timestamp": "05:22:46", "text": "中国語の翻訳を保持しています"}, {"type": "subtitle", "time": 19368.07, "timestamp": "05:22:48", "text": "それ。だから、あなたが"}, {"type": "subtitle", "time": 19369.91, "timestamp": "05:22:49", "text": "Discord、あなたが中国人なら、"}, {"type": "subtitle", "time": 19372.788, "timestamp": "05:22:52", "text": "中国語翻訳ボタンをクリックしてください"}, {"type": "subtitle", "time": 19374.47, "timestamp": "05:22:54", "text": "翻訳が表示されます"}, {"type": "subtitle", "time": 19376.67, "timestamp": "05:22:56", "text": "埋め込みの翻訳。"}]
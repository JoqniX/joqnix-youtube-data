[{"type": "subtitle", "time": 10500.51, "timestamp": "02:55:00", "text": "次のようなもの"}, {"type": "subtitle", "time": 10502.19, "timestamp": "02:55:02", "text": "それ。"}, {"type": "subtitle", "time": 10505.11, "timestamp": "02:55:05", "text": "うん。現在、メインタイトルに移動すると"}, {"type": "subtitle", "time": 10507.91, "timestamp": "02:55:07", "text": "ここからタイトルを選択できます"}, {"type": "subtitle", "time": 10509.83, "timestamp": "02:55:09", "text": "私が好きな方を選べます。私はそれを作ろうとしています"}, {"type": "subtitle", "time": 10512.309, "timestamp": "02:55:12", "text": "簡略化されているので、探す必要はありません"}, {"type": "subtitle", "time": 10514.51, "timestamp": "02:55:14", "text": "すべての層や物を通して、"}, {"type": "subtitle", "time": 10517.95, "timestamp": "02:55:17", "text": "痛みが強すぎる"}, {"type": "subtitle", "time": 10521.79, "timestamp": "02:55:21", "text": "右。そこで私はその物件を作り、"}, {"type": "subtitle", "time": 10524.55, "timestamp": "02:55:24", "text": "もの。それで私は不動産などを作った"}, {"type": "subtitle", "time": 10527.51, "timestamp": "02:55:27", "text": "こういうことが３つあります。今私は"}, {"type": "subtitle", "time": 10529.91, "timestamp": "02:55:29", "text": "アイコンに苦戦しています。つまり問題は"}, {"type": "subtitle", "time": 10532.71, "timestamp": "02:55:32", "text": "もしそれが一つだけなら、それをお見せします"}, {"type": "subtitle", "time": 10540.429, "timestamp": "02:55:40", "text": "[音楽]"}, {"type": "subtitle", "time": 10543.75, "timestamp": "02:55:43", "text": "見せる。つまり、これのことですよね？これを置いたら"}, {"type": "subtitle", "time": 10546.03, "timestamp": "02:55:46", "text": "男。それで"}, {"type": "subtitle", "time": 10547.87, "timestamp": "02:55:47", "text": "資産。さあ"}]
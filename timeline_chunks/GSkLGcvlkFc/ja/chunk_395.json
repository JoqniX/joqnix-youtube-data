[{"type": "subtitle", "time": 23720.39, "timestamp": "06:35:20", "text": "うん。そうそう。パルワールドは、えーと、"}, {"type": "subtitle", "time": 23722.868, "timestamp": "06:35:22", "text": "日本をテーマにしたDLCとか"}, {"type": "subtitle", "time": 23723.6, "timestamp": "06:35:23", "text": "何か、"}, {"type": "subtitle", "time": 23725.23, "timestamp": "06:35:25", "text": "[音楽]"}, {"type": "subtitle", "time": 23729.35, "timestamp": "06:35:29", "text": "右？もしくはアディアとかいう名前の人。うん。おお、"}, {"type": "subtitle", "time": 23731.19, "timestamp": "06:35:31", "text": "そういえば、ダーケン"}, {"type": "subtitle", "time": 23733.75, "timestamp": "06:35:33", "text": "また、『Darker and Darker』は無料でプレイできます。"}, {"type": "subtitle", "time": 23737.11, "timestamp": "06:35:37", "text": "彼らはそれを6月6日にリリースした。それは"}, {"type": "subtitle", "time": 23740.75, "timestamp": "06:35:40", "text": "えっと、私は7日遅れているんです。 6番目"}, {"type": "subtitle", "time": 23743.59, "timestamp": "06:35:43", "text": "木曜日。彼らはそれを6日にリリースした。私"}, {"type": "subtitle", "time": 23745.99, "timestamp": "06:35:45", "text": "知らなかった。 Epicをチェックしていた"}, {"type": "subtitle", "time": 23748.59, "timestamp": "06:35:48", "text": "最近ゲームをやってみて、それを見ました。私はこう思った。"}, {"type": "subtitle", "time": 23751.27, "timestamp": "06:35:51", "text": "「え？いつリリースされたの？」"}, {"type": "subtitle", "time": 23753.83, "timestamp": "06:35:53", "text": "それ？私は彼らが"}, {"type": "subtitle", "time": 23757.75, "timestamp": "06:35:57", "text": "彼らはSteamでの公開を停止しました"}]
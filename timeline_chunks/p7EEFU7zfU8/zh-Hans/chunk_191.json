[{"type": "subtitle", "time": 11470.75, "timestamp": "03:11:10", "text": "[音乐]"}, {"type": "subtitle", "time": 11474.07, "timestamp": "03:11:14", "text": "切换装置具有一项主要违规行为"}, {"type": "subtitle", "time": 11476.79, "timestamp": "03:11:16", "text": "默认防御"}, {"type": "subtitle", "time": 11478.95, "timestamp": "03:11:18", "text": "魔法物品可以与这种药剂一起使用。"}, {"type": "subtitle", "time": 11482.87, "timestamp": "03:11:22", "text": "准备添加一个升级次要属性"}, {"type": "subtitle", "time": 11486.469, "timestamp": "03:11:26", "text": "或者将特性应用到你的装备上。多种的"}, {"type": "subtitle", "time": 11488.87, "timestamp": "03:11:28", "text": "小幅升级也能带来显著效果。"}, {"type": "subtitle", "time": 11492.63, "timestamp": "03:11:32", "text": "提升战斗力。新蜜蜂可以"}, {"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "获救和"}, {"type": "subtitle", "time": 11497.91, "timestamp": "03:11:37", "text": "在任务中解锁或解锁。新贸易"}, {"type": "subtitle", "time": 11501.63, "timestamp": "03:11:41", "text": "可以在强盗营地解锁食谱。"}, {"type": "subtitle", "time": 11505.11, "timestamp": "03:11:45", "text": "好的。呃，我不知道该怎么办。"}, {"type": "subtitle", "time": 11506.75, "timestamp": "03:11:46", "text": "问题"}, {"type": "subtitle", "time": 11508.75, "timestamp": "03:11:48", "text": "标记。"}, {"type": "subtitle", "time": 11511.63, "timestamp": "03:11:51", "text": "哦，景色"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "升级。我可以加强防御。你好"}]
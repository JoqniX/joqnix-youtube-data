[{"type": "subtitle", "time": 5051.47, "timestamp": "01:24:11", "text": "凉爽的。就是这样，"}, {"type": "subtitle", "time": 5062.55, "timestamp": "01:24:22", "text": "那么，你觉得Highwing怎么样？"}, {"type": "subtitle", "time": 5065.629, "timestamp": "01:24:25", "text": "她非常出色。我以为她是"}, {"type": "subtitle", "time": 5067.91, "timestamp": "01:24:27", "text": "杰出的。真不敢相信是你介绍的"}, {"type": "subtitle", "time": 5070.31, "timestamp": "01:24:30", "text": "我对她说。我怀疑你们两个可能会……"}, {"type": "subtitle", "time": 5072.629, "timestamp": "01:24:32", "text": "沿着。你就是学生们抱怨的原因吗？"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "看到鹰马在空中飞翔"}, {"type": "subtitle", "time": 5077.43, "timestamp": "01:24:37", "text": "禁林？或许是H。你……"}, {"type": "subtitle", "time": 5079.35, "timestamp": "01:24:39", "text": "要知道，一旦你获得了一只鹰头马身兽……"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "相信我，他们总会在你身边？"}, {"type": "subtitle", "time": 5084.149, "timestamp": "01:24:44", "text": "我亲眼见过她这样。如何"}, {"type": "subtitle", "time": 5086.31, "timestamp": "01:24:46", "text": "你和Highwing到底是怎么交叉的？"}, {"type": "subtitle", "time": 5089.669, "timestamp": "01:24:49", "text": "路径？那是另一个故事了，但我救了"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "几年前她从偷猎者手中获救。哦。"}, {"type": "subtitle", "time": 5094.55, "timestamp": "01:24:54", "text": "把她安全救出来了，然后，她就……"}, {"type": "subtitle", "time": 5097.35, "timestamp": "01:24:57", "text": "直到最近都还很好。你可能有"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "注意到偷猎者在某种程度上是"}]
[{"type": "subtitle", "time": 7151.51, "timestamp": "01:59:11", "text": "知道。是的。你好，Hexa。早上好"}, {"type": "subtitle", "time": 7160.149, "timestamp": "01:59:20", "text": "周三。希望你今天一切顺利。"}, {"type": "subtitle", "time": 7162.87, "timestamp": "01:59:22", "text": "我得弄清楚这件事才会离开。"}, {"type": "subtitle", "time": 7164.95, "timestamp": "01:59:24", "text": "那边有东西。那"}, {"type": "subtitle", "time": 7168.629, "timestamp": "01:59:28", "text": "宝藏似乎，哦，那宝藏似乎"}, {"type": "subtitle", "time": 7171.43, "timestamp": "01:59:31", "text": "金饰之类的东西。如果他们喜欢"}, {"type": "subtitle", "time": 7174.07, "timestamp": "01:59:34", "text": "像这样的大型难题，或者像这样的简单难题"}, {"type": "subtitle", "time": 7176.229, "timestamp": "01:59:36", "text": "像这样解开谜题，然后在那里放一个箱子。"}, {"type": "subtitle", "time": 7179.229, "timestamp": "01:59:39", "text": "这绝对会是金牌"}, {"type": "subtitle", "time": 7182.83, "timestamp": "01:59:42", "text": "物品。想象一下如果你抽到紫色会怎样。患病的"}, {"type": "subtitle", "time": 7188.629, "timestamp": "01:59:48", "text": "哭。我的天啊。光。我的天哪。所以，就像"}, {"type": "subtitle", "time": 7191.95, "timestamp": "01:59:51", "text": "你看，这个有一个"}, {"type": "subtitle", "time": 7194.629, "timestamp": "01:59:54", "text": "骨骼。哦，我应该把"}, {"type": "subtitle", "time": 7196.629, "timestamp": "01:59:56", "text": "颅骨。在哪里？骷髅头在哪儿？"}, {"type": "subtitle", "time": 7198.669, "timestamp": "01:59:58", "text": "太多了。"}]
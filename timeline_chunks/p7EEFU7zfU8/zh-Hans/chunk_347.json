[{"type": "subtitle", "time": 20822.708, "timestamp": "05:47:02", "text": "音乐软件，这样我就可以保存并发送它。"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "一条音轨对应不同的虚拟音频"}, {"type": "subtitle", "time": 20828.07, "timestamp": "05:47:08", "text": "电缆和一条轨道连接到另一条轨道。"}, {"type": "subtitle", "time": 20831.31, "timestamp": "05:47:11", "text": "所以原件归我了……"}, {"type": "subtitle", "time": 20835.67, "timestamp": "05:47:15", "text": "耳机，另一个连接到……"}, {"type": "subtitle", "time": 20838.07, "timestamp": "05:47:18", "text": "呃，虚拟电缆，这很明显"}, {"type": "subtitle", "time": 20841.19, "timestamp": "05:47:21", "text": "它会像这样听下去。"}, {"type": "subtitle", "time": 20844.07, "timestamp": "05:47:24", "text": "我当时就想，嗯，加了很多东西。"}, {"type": "subtitle", "time": 20847.51, "timestamp": "05:47:27", "text": "日语歌曲等等"}, {"type": "subtitle", "time": 20850.628, "timestamp": "05:47:30", "text": "测试哪首歌能让我得到"}, {"type": "subtitle", "time": 20853.11, "timestamp": "05:47:33", "text": "版权频道被警告，因为有一次我"}, {"type": "subtitle", "time": 20855.11, "timestamp": "05:47:35", "text": "现在我误操作了。"}, {"type": "subtitle", "time": 20858.07, "timestamp": "05:47:38", "text": "你知道的那首歌的器乐版"}, {"type": "subtitle", "time": 20860.548, "timestamp": "05:47:40", "text": "Botchi the Rock 动画。对，就是巨石强森。"}, {"type": "subtitle", "time": 20863.75, "timestamp": "05:47:43", "text": "是的，我最近刚看过。所以，我"}, {"type": "subtitle", "time": 20866.31, "timestamp": "05:47:46", "text": "演奏了《如果我能成为星座》"}, {"type": "subtitle", "time": 20868.39, "timestamp": "05:47:48", "text": "歌曲，纯音乐版。我真的得到了"}, {"type": "subtitle", "time": 20871.99, "timestamp": "05:47:51", "text": "日本索尼音乐发起频道罢工。"}, {"type": "subtitle", "time": 20874.708, "timestamp": "05:47:54", "text": "我等了一整年。是的，我"}, {"type": "subtitle", "time": 20876.708, "timestamp": "05:47:56", "text": "等了一整年才放行"}, {"type": "subtitle", "time": 20879.51, "timestamp": "05:47:59", "text": "频道罢工已经结束。而现在它"}]
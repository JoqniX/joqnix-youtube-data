[{"type": "subtitle", "time": 12184.429, "timestamp": "03:23:04", "text": "我们制造"}, {"type": "subtitle", "time": 12187.389, "timestamp": "03:23:07", "text": "钱。四个人。"}, {"type": "subtitle", "time": 12191.79, "timestamp": "03:23:11", "text": "不，等等。我们该去谁那里？好的。是吗？"}, {"type": "subtitle", "time": 12194.75, "timestamp": "03:23:14", "text": "这里？植物"}, {"type": "subtitle", "time": 12197.07, "timestamp": "03:23:17", "text": "店铺。老的"}, {"type": "subtitle", "time": 12201.97, "timestamp": "03:23:21", "text": "肥料。"}, {"type": "subtitle", "time": 12205.229, "timestamp": "03:23:25", "text": "[音乐]"}, {"type": "subtitle", "time": 12209.67, "timestamp": "03:23:29", "text": "呃。嗯。等一下。"}, {"type": "subtitle", "time": 12212.429, "timestamp": "03:23:32", "text": "我该去找谁呢？"}, {"type": "subtitle", "time": 12216.349, "timestamp": "03:23:36", "text": "还能再次出售吗？不是那个女孩，对吧？"}, {"type": "subtitle", "time": 12219.79, "timestamp": "03:23:39", "text": "这里没有吧？"}, {"type": "subtitle", "time": 12227.07, "timestamp": "03:23:47", "text": "再次？"}]
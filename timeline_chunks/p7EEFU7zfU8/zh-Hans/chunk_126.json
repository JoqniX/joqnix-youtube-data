[{"type": "subtitle", "time": 7561.95, "timestamp": "02:06:01", "text": "敌人。召唤两个敌人"}, {"type": "subtitle", "time": 7564.149, "timestamp": "02:06:04", "text": "同时地。两个敌人。我可以吗？"}, {"type": "subtitle", "time": 7568.109, "timestamp": "02:06:08", "text": "召唤我的中文"}, {"type": "subtitle", "time": 7588.39, "timestamp": "02:06:28", "text": "我的天啊，我的生命值太低了。 G，是H吗？哦"}, {"type": "subtitle", "time": 7593.43, "timestamp": "02:06:33", "text": "上帝。谢谢你带来的恶臭"}, {"type": "subtitle", "time": 7617.83, "timestamp": "02:06:57", "text": "攻击。哦，等等。我正在吸大麻"}]
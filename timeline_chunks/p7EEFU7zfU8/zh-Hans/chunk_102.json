[{"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "嗯，Jo，你最喜欢的动漫是什么？我"}, {"type": "subtitle", "time": 6135.149, "timestamp": "01:42:15", "text": "但我没有偏爱谁。"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "它叫什么？我喜欢各种类型"}, {"type": "subtitle", "time": 6141.91, "timestamp": "01:42:21", "text": "市面上有很多动漫。很难选择"}, {"type": "subtitle", "time": 6144.709, "timestamp": "01:42:24", "text": "收藏夹。就像，就像 f 就像"}, {"type": "subtitle", "time": 6147.51, "timestamp": "01:42:27", "text": "问你最喜欢的家长是谁？是吗？"}, {"type": "subtitle", "time": 6150.07, "timestamp": "01:42:30", "text": "你的母亲还是你的父亲？我是某人"}, {"type": "subtitle", "time": 6153.27, "timestamp": "01:42:33", "text": "他们总是说这两个词。我不能"}, {"type": "subtitle", "time": 6155.39, "timestamp": "01:42:35", "text": "比较一下。它是"}, {"type": "subtitle", "time": 6159.83, "timestamp": "01:42:39", "text": "疼痛。这对我来说太难了。"}, {"type": "subtitle", "time": 6161.79, "timestamp": "01:42:41", "text": "到"}, {"type": "subtitle", "time": 6164.55, "timestamp": "01:42:44", "text": "比较。我就是这样。比如你问"}, {"type": "subtitle", "time": 6166.709, "timestamp": "01:42:46", "text": "我喜欢你的，如果是你的"}, {"type": "subtitle", "time": 6175.669, "timestamp": "01:42:55", "text": "比较。是的。杰夫·罗萨是新来的。"}, {"type": "subtitle", "time": 6177.669, "timestamp": "01:42:57", "text": "是的。"}]
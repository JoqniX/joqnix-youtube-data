[{"type": "subtitle", "time": 3661.589, "timestamp": "01:01:01", "text": "总之，这就是我今天迟到的原因。"}, {"type": "subtitle", "time": 3664.39, "timestamp": "01:01:04", "text": "和往常一样，我遇到了困难，但是……"}, {"type": "subtitle", "time": 3668.549, "timestamp": "01:01:08", "text": "我喜欢吃东西。我不知道为什么我"}, {"type": "subtitle", "time": 3670.63, "timestamp": "01:01:10", "text": "所以，呃，阿姨给了我三个"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "印度薄饼。好的。我告诉她我不想要"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "三张印度薄饼。我只吃你能吃的东西"}, {"type": "subtitle", "time": 3678.23, "timestamp": "01:01:18", "text": "去掉这两个。我当时就想"}, {"type": "subtitle", "time": 3680.309, "timestamp": "01:01:20", "text": "我有信心能吃下两个。好的。但"}, {"type": "subtitle", "time": 3682.71, "timestamp": "01:01:22", "text": "你知道发生了什么事吗？我的肚子变得"}, {"type": "subtitle", "time": 3684.43, "timestamp": "01:01:24", "text": "完全之后"}, {"type": "subtitle", "time": 3686.03, "timestamp": "01:01:26", "text": "一"}, {"type": "subtitle", "time": 3690.95, "timestamp": "01:01:30", "text": "印度薄饼。所以我几乎没怎么吃东西。"}, {"type": "subtitle", "time": 3693.67, "timestamp": "01:01:33", "text": "第二个。我开始感觉"}, {"type": "subtitle", "time": 3697.03, "timestamp": "01:01:37", "text": "感觉很不舒服，我几乎不得不"}, {"type": "subtitle", "time": 3699.03, "timestamp": "01:01:39", "text": "呕吐之类的。老兄，这是什么？"}, {"type": "subtitle", "time": 3701.309, "timestamp": "01:01:41", "text": "正在发生？午餐也是如此。"}, {"type": "subtitle", "time": 3704.63, "timestamp": "01:01:44", "text": "晚餐。怎么了？身体查玛"}, {"type": "subtitle", "time": 3707.109, "timestamp": "01:01:47", "text": "然后，然后，当我回到我的"}, {"type": "subtitle", "time": 3710.069, "timestamp": "01:01:50", "text": "椅子，这里有一张很大的蜘蛛网。我"}, {"type": "subtitle", "time": 3713.03, "timestamp": "01:01:53", "text": "当时的感觉是，这太美了，但是……"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "我得坐下来直播。哦，我当时"}, {"type": "subtitle", "time": 3718.23, "timestamp": "01:01:58", "text": "我当时感觉很糟糕，不忍心毁掉它。"}]
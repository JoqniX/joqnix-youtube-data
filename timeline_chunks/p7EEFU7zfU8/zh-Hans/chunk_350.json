[{"type": "subtitle", "time": 21001.27, "timestamp": "05:50:01", "text": "即使是那些有"}, {"type": "subtitle", "time": 21010.868, "timestamp": "05:50:10", "text": "是的。不仅仅是像有些歌曲那样。"}, {"type": "subtitle", "time": 21013.75, "timestamp": "05:50:13", "text": "没有在线工具"}, {"type": "subtitle", "time": 21016.788, "timestamp": "05:50:16", "text": "现在。即使是像那些歌一样的歌，我"}, {"type": "subtitle", "time": 21019.51, "timestamp": "05:50:19", "text": "我相信他们发挥了重要作用。是的。"}, {"type": "subtitle", "time": 21023.19, "timestamp": "05:50:23", "text": "如果你试着看看，呃，比如检查一下"}, {"type": "subtitle", "time": 21025.99, "timestamp": "05:50:25", "text": "在他们的推特之类的东西里有链接，"}, {"type": "subtitle", "time": 21029.868, "timestamp": "05:50:29", "text": "不会显示，因为……它会说"}, {"type": "subtitle", "time": 21032.948, "timestamp": "05:50:32", "text": "地区限制之类的，因为他们"}, {"type": "subtitle", "time": 21035.27, "timestamp": "05:50:35", "text": "仅限于日本。我就像"}, {"type": "subtitle", "time": 21037.59, "timestamp": "05:50:37", "text": "请让它在全球范围内传播。有"}, {"type": "subtitle", "time": 21039.51, "timestamp": "05:50:39", "text": "那些想唱歌什么的，你"}, {"type": "subtitle", "time": 21047.03, "timestamp": "05:50:47", "text": "很多。可能只有日本流行歌曲。我"}, {"type": "subtitle", "time": 21048.628, "timestamp": "05:50:48", "text": "我觉得有一些歌是"}, {"type": "subtitle", "time": 21050.948, "timestamp": "05:50:50", "text": "就像韩国流行音乐那样。除此之外，就是"}]
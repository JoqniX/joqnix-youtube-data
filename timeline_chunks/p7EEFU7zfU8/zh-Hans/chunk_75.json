[{"type": "subtitle", "time": 4500.03, "timestamp": "01:15:00", "text": "刷并按住即可拖动"}, {"type": "subtitle", "time": 4507.31, "timestamp": "01:15:07", "text": "出色地。啊，该怎么用呢？哦，"}, {"type": "subtitle", "time": 4515.55, "timestamp": "01:15:15", "text": "看。"}, {"type": "subtitle", "time": 4518.55, "timestamp": "01:15:18", "text": "刷个妆。"}, {"type": "subtitle", "time": 4520.95, "timestamp": "01:15:20", "text": "真漂亮。我相信他内心有很多感受。"}, {"type": "subtitle", "time": 4522.55, "timestamp": "01:15:22", "text": "更好的。"}, {"type": "subtitle", "time": 4525.35, "timestamp": "01:15:25", "text": "看看这个。你可能饿了。会"}, {"type": "subtitle", "time": 4528.229, "timestamp": "01:15:28", "text": "你介意给他喂点牲畜饲料吗？"}, {"type": "subtitle", "time": 4530.43, "timestamp": "01:15:30", "text": "不，你要把这个咒语给我。"}, {"type": "subtitle", "time": 4538.63, "timestamp": "01:15:38", "text": "哦，我猜这些颗粒尝起来像什么呢？"}, {"type": "subtitle", "time": 4541.669, "timestamp": "01:15:41", "text": "杰拉尔德。布丁。我喜欢这样想"}, {"type": "subtitle", "time": 4543.59, "timestamp": "01:15:43", "text": "布丁。我认为我们可以肯定地说"}, {"type": "subtitle", "time": 4547.03, "timestamp": "01:15:47", "text": "杰拉尔德喜欢你。这是个好消息。他"}, {"type": "subtitle", "time": 4550.95, "timestamp": "01:15:50", "text": "看起来很不错。嗯。他是。善良是"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "紧随其后的是他最优秀的品质之一。"}, {"type": "subtitle", "time": 4557.35, "timestamp": "01:15:57", "text": "善良、热情和清洁。"}, {"type": "subtitle", "time": 4559.83, "timestamp": "01:15:59", "text": "大家做得都很棒。但这就是……"}]
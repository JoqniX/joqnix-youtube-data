[{"type": "subtitle", "time": 8643.83, "timestamp": "02:24:03", "text": "100。这很贵。或者"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "明智的决定。谢谢。"}, {"type": "subtitle", "time": 8649.71, "timestamp": "02:24:09", "text": "好的。三份。那会很好"}, {"type": "subtitle", "time": 8653.03, "timestamp": "02:24:13", "text": "足够的。我可以把我的原料卖给你吗？"}, {"type": "subtitle", "time": 8655.429, "timestamp": "02:24:15", "text": "不。好的。希望还能再见到你。"}, {"type": "subtitle", "time": 8659.15, "timestamp": "02:24:19", "text": "暂别了。再见。告别。"}, {"type": "subtitle", "time": 8666.71, "timestamp": "02:24:26", "text": "斗争。那孩子正要跑。"}, {"type": "subtitle", "time": 8669.91, "timestamp": "02:24:29", "text": "有只羊没能变好。好的，"}, {"type": "subtitle", "time": 8677.87, "timestamp": "02:24:37", "text": "好的。我们开始吧"}, {"type": "subtitle", "time": 8685.95, "timestamp": "02:24:45", "text": "[音乐]"}, {"type": "subtitle", "time": 8695.99, "timestamp": "02:24:55", "text": "我要撞到树上了。"}]
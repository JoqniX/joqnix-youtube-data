[{"type": "subtitle", "time": 11040.389, "timestamp": "03:04:00", "text": "我的天哪，这是一座岛。"}, {"type": "subtitle", "time": 11042.55, "timestamp": "03:04:02", "text": "这里似乎是你们野兽的栖身之处。"}, {"type": "subtitle", "time": 11044.55, "timestamp": "03:04:04", "text": "活着。某种类型的温室。一个"}, {"type": "subtitle", "time": 11047.11, "timestamp": "03:04:07", "text": "vavarium。你的野兽会相当……"}, {"type": "subtitle", "time": 11049.71, "timestamp": "03:04:09", "text": "是吗？什么？我听着呢。安全的"}, {"type": "subtitle", "time": 11052.79, "timestamp": "03:04:12", "text": "光。或许你想释放他们。"}, {"type": "subtitle", "time": 11056.15, "timestamp": "03:04:16", "text": "让他们看看他们的新家。是的。 H 代表"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "管理。我的天啊。我有很多"}, {"type": "subtitle", "time": 11060.75, "timestamp": "03:04:20", "text": "他们。"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "你好。哦，等等。你只能添加“呃，你”。"}, {"type": "subtitle", "time": 11084.309, "timestamp": "03:04:44", "text": "[音乐]"}, {"type": "subtitle", "time": 11088.23, "timestamp": "03:04:48", "text": "其他人呢？"}, {"type": "subtitle", "time": 11091.99, "timestamp": "03:04:51", "text": "接下来我要做的一切。"}, {"type": "subtitle", "time": 11094.389, "timestamp": "03:04:54", "text": "哦，看看他们。太可爱了。蓝色"}, {"type": "subtitle", "time": 11096.87, "timestamp": "03:04:56", "text": "鸟。德认为兽医诊所将会是一个"}, {"type": "subtitle", "time": 11099.75, "timestamp": "03:04:59", "text": "为你的动物们找到一个合适的新家。"}]
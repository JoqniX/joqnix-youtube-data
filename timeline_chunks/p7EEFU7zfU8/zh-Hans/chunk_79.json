[{"type": "subtitle", "time": 4741.75, "timestamp": "01:19:01", "text": "优质的？等等，什么？你是高级会员吗？做"}, {"type": "subtitle", "time": 4745.03, "timestamp": "01:19:05", "text": "不包括为了获取胡须而对它们进行虐待。"}, {"type": "subtitle", "time": 4748.07, "timestamp": "01:19:08", "text": "我的天啊。顺便说一句，干得好。"}, {"type": "subtitle", "time": 4750.55, "timestamp": "01:19:10", "text": "接下来最好还是让我来处理。"}, {"type": "subtitle", "time": 4753.59, "timestamp": "01:19:13", "text": "时间。我会让你处理几乎同样糟糕的事情。"}, {"type": "subtitle", "time": 4756.07, "timestamp": "01:19:16", "text": "就像鲁克伍德偷猎者中的野蛮人一样"}, {"type": "subtitle", "time": 4759.99, "timestamp": "01:19:19", "text": "盒。哦，可惜，我们才是那些"}, {"type": "subtitle", "time": 4763.11, "timestamp": "01:19:23", "text": "遭受。绊倒在死去的野兽身上。"}, {"type": "subtitle", "time": 4765.83, "timestamp": "01:19:25", "text": "真是对资源的巨大浪费。"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "偷猎者终将受到法律制裁。"}, {"type": "subtitle", "time": 4771.189, "timestamp": "01:19:31", "text": "被某人。今天就把蚂蚁放进去。一个"}, {"type": "subtitle", "time": 4773.91, "timestamp": "01:19:33", "text": "乐天派。我跟他有交情。是"}, {"type": "subtitle", "time": 4776.95, "timestamp": "01:19:36", "text": "郁闷。我们更关注眼前的事务。"}, {"type": "subtitle", "time": 4780.39, "timestamp": "01:19:40", "text": "我们能够控制的事情。教授"}, {"type": "subtitle", "time": 4782.87, "timestamp": "01:19:42", "text": "韦斯莱先生让我准备一些"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "旨在帮助你掌握的作业"}, {"type": "subtitle", "time": 4788.229, "timestamp": "01:19:48", "text": "直至其他五年级学生。参与"}, {"type": "subtitle", "time": 4790.189, "timestamp": "01:19:50", "text": "帮我留意一下我的猫头鹰。"}, {"type": "subtitle", "time": 4793.75, "timestamp": "01:19:53", "text": "阿拉，我也鼓励你学习……"}, {"type": "subtitle", "time": 4798.27, "timestamp": "01:19:58", "text": "尽可能多地利用自己的时间去猎杀野兽。"}]
[{"type": "subtitle", "time": 10560.83, "timestamp": "02:56:00", "text": "[掌声]"}, {"type": "subtitle", "time": 10564.71, "timestamp": "02:56:04", "text": "是的，我全都收到了。"}, {"type": "subtitle", "time": 10567.349, "timestamp": "02:56:07", "text": "那里。那里。我不会伤害你。"}, {"type": "subtitle", "time": 10574.269, "timestamp": "02:56:14", "text": "认为。"}, {"type": "subtitle", "time": 10578.23, "timestamp": "02:56:18", "text": "我全都拿到了。我保住了一份工作。"}, {"type": "subtitle", "time": 10580.55, "timestamp": "02:56:20", "text": "全部。不，我救了七八个。"}, {"type": "subtitle", "time": 10583.51, "timestamp": "02:56:23", "text": "背包。舒适温馨。偷猎者想要"}, {"type": "subtitle", "time": 10586.07, "timestamp": "02:56:26", "text": "它们为了羽毛而攻击它们，而且并不友善。"}, {"type": "subtitle", "time": 10587.99, "timestamp": "02:56:27", "text": "当他们聚集它们的时候。有吗？"}, {"type": "subtitle", "time": 10590.469, "timestamp": "02:56:30", "text": "附近还有其他野兽吗？迪伊就有一个"}, {"type": "subtitle", "time": 10593.03, "timestamp": "02:56:33", "text": "知道。一群月亮雕刻者。他们"}, {"type": "subtitle", "time": 10596.309, "timestamp": "02:56:36", "text": "住在这条小路尽头的一片树林里。"}, {"type": "subtitle", "time": 10602.51, "timestamp": "02:56:42", "text": "好的。哦"}, {"type": "subtitle", "time": 10607.269, "timestamp": "02:56:47", "text": "男生。现在已经过去两小时了。"}]
[{"type": "subtitle", "time": 14520.71, "timestamp": "04:02:00", "text": "顺便说一下，我叫克拉·布尔蒙特。很高兴"}, {"type": "subtitle", "time": 14522.95, "timestamp": "04:02:02", "text": "遇见你。兰洛克和他的追随者们"}, {"type": "subtitle", "time": 14525.59, "timestamp": "04:02:05", "text": "在此安营扎寨。完全不顾及我们的利益"}, {"type": "subtitle", "time": 14527.63, "timestamp": "04:02:07", "text": "我们挚爱的哈姆雷特或我们"}, {"type": "subtitle", "time": 14531.189, "timestamp": "04:02:11", "text": "生计。无情。我的兄弟巴德"}, {"type": "subtitle", "time": 14533.189, "timestamp": "04:02:13", "text": "敢于反抗他们，结果"}, {"type": "subtitle", "time": 14536.389, "timestamp": "04:02:16", "text": "在圣蒙戈。我当时真是束手无策。"}, {"type": "subtitle", "time": 14541.269, "timestamp": "04:02:21", "text": "好的。"}, {"type": "subtitle", "time": 14543.269, "timestamp": "04:02:23", "text": "不幸的是，我对……非常熟悉。"}, {"type": "subtitle", "time": 14545.67, "timestamp": "04:02:25", "text": "仁罗的忠实拥护者。或许我可以"}, {"type": "subtitle", "time": 14548.389, "timestamp": "04:02:28", "text": "某物。尽管我很想成为"}, {"type": "subtitle", "time": 14549.99, "timestamp": "04:02:29", "text": "摆脱它们。我们走吧。我不想要你"}, {"type": "subtitle", "time": 14553.269, "timestamp": "04:02:33", "text": "冒着受伤甚至更严重后果的风险。请"}, {"type": "subtitle", "time": 14556.07, "timestamp": "04:02:36", "text": "谨慎。"}, {"type": "subtitle", "time": 14558.55, "timestamp": "04:02:38", "text": "我们不应该生活在恐惧之中。这"}, {"type": "subtitle", "time": 14560.67, "timestamp": "04:02:40", "text": "这是我们的家。"}, {"type": "subtitle", "time": 14563.269, "timestamp": "04:02:43", "text": "好的。我有一瞬间以为我真的"}, {"type": "subtitle", "time": 14564.91, "timestamp": "04:02:44", "text": "激活了另一个"}, {"type": "subtitle", "time": 14567.349, "timestamp": "04:02:47", "text": "寻求。我乐意做多件事。"}, {"type": "subtitle", "time": 14575.11, "timestamp": "04:02:55", "text": "但我们缺乏时间。我希望我的"}, {"type": "subtitle", "time": 14578.189, "timestamp": "04:02:58", "text": "哥哥没事。"}, {"type": "subtitle", "time": 14579.79, "timestamp": "04:02:59", "text": "娜塔莉，"}]
[{"type": "subtitle", "time": 19563.35, "timestamp": "05:26:03", "text": "15号，但我当时想我还是会继续直播"}, {"type": "subtitle", "time": 19566.39, "timestamp": "05:26:06", "text": "考试期间我试着直播"}, {"type": "subtitle", "time": 19570.07, "timestamp": "05:26:10", "text": "从16号开始的第三周，我就要考试了。"}, {"type": "subtitle", "time": 19572.788, "timestamp": "05:26:12", "text": "开始。所以我决定还是赶紧结束吧。"}, {"type": "subtitle", "time": 19576.788, "timestamp": "05:26:16", "text": "合作等等，然后打包"}, {"type": "subtitle", "time": 19588.55, "timestamp": "05:26:28", "text": "哦，我刚刚才意识到。哦，等等。让我"}, {"type": "subtitle", "time": 19590.708, "timestamp": "05:26:30", "text": "解除。好的。你好，你的声音可以听到。"}, {"type": "subtitle", "time": 19594.948, "timestamp": "05:26:34", "text": "溪流。你好。好的。好的。你好。你好。"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "是的，可听见。好的。好的。就像"}, {"type": "subtitle", "time": 19601.19, "timestamp": "05:26:41", "text": "奇怪的声音。这只是我的"}, {"type": "subtitle", "time": 19603.99, "timestamp": "05:26:43", "text": "背景中可以看到父母。"}, {"type": "subtitle", "time": 19606.39, "timestamp": "05:26:46", "text": "我安装了降噪功能，所以它会"}, {"type": "subtitle", "time": 19609.67, "timestamp": "05:26:49", "text": "抵消。好的。不用担心。我不是"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "知道它是如何运作的。所以，可能不会。"}, {"type": "subtitle", "time": 19615.99, "timestamp": "05:26:55", "text": "我的完毕。我什么都没做，因为……"}, {"type": "subtitle", "time": 19617.83, "timestamp": "05:26:57", "text": "是的，已经过去很久了，我也不"}, {"type": "subtitle", "time": 19619.59, "timestamp": "05:26:59", "text": "我知道我该如何跟我的妇产科医生沟通。"}]
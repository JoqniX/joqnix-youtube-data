[{"type": "subtitle", "time": 15123.91, "timestamp": "04:12:03", "text": "扫帚。我要这个。实际上，谢谢"}, {"type": "subtitle", "time": 15131.59, "timestamp": "04:12:11", "text": "我卖给他一些东西。"}, {"type": "subtitle", "time": 15135.2, "timestamp": "04:12:15", "text": "我希望有机会与您合作。"}, {"type": "subtitle", "time": 15150.91, "timestamp": "04:12:30", "text": "再次。看着我。我是"}]
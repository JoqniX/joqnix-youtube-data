[{"type": "subtitle", "time": 20401.35, "timestamp": "05:40:01", "text": "尤其是因为无所不知的读者是"}, {"type": "subtitle", "time": 20404.31, "timestamp": "05:40:04", "text": "仍然呃，不像被锁住了那样"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "章节没有锁定，所以不太确定。所以"}, {"type": "subtitle", "time": 20419.35, "timestamp": "05:40:19", "text": "是的。最近情况如何？"}, {"type": "subtitle", "time": 20421.51, "timestamp": "05:40:21", "text": "排除考试压力和"}, {"type": "subtitle", "time": 20424.07, "timestamp": "05:40:24", "text": "一切？"}, {"type": "subtitle", "time": 20426.03, "timestamp": "05:40:26", "text": "我生活中除了……之外什么都没有。"}, {"type": "subtitle", "time": 20428.35, "timestamp": "05:40:28", "text": "考试。我的意思是……"}, {"type": "subtitle", "time": 20432.15, "timestamp": "05:40:32", "text": "我的意思是，呃，我猜我唯一想说的就是这个。"}, {"type": "subtitle", "time": 20434.15, "timestamp": "05:40:34", "text": "我可能正在做的是我的YouTube频道。"}, {"type": "subtitle", "time": 20437.67, "timestamp": "05:40:37", "text": "频道和所有相关内容。"}, {"type": "subtitle", "time": 20440.15, "timestamp": "05:40:40", "text": "差不多就是这样。我只是，我只是"}, {"type": "subtitle", "time": 20446.34, "timestamp": "05:40:46", "text": "到处闲逛，勉强维持生计。"}, {"type": "subtitle", "time": 20449.35, "timestamp": "05:40:49", "text": "[音乐]"}, {"type": "subtitle", "time": 20452.23, "timestamp": "05:40:52", "text": "那挺好的。我看到了你上传的内容。"}, {"type": "subtitle", "time": 20455.27, "timestamp": "05:40:55", "text": "还有一些其他的东西。那挺好的。"}, {"type": "subtitle", "time": 20459.91, "timestamp": "05:40:59", "text": "我只是有很多备份。"}]
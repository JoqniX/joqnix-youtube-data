[{"type": "subtitle", "time": 19801.83, "timestamp": "05:30:01", "text": "因为我现在还没复习，所以我就想：哦"}, {"type": "subtitle", "time": 19805.59, "timestamp": "05:30:05", "text": "是啊，怎么办？怎么办？你觉得呢？"}, {"type": "subtitle", "time": 19807.91, "timestamp": "05:30:07", "text": "你去日本就会明白这一点。"}, {"type": "subtitle", "time": 19810.868, "timestamp": "05:30:10", "text": "比如，哦，他们会进行考试"}, {"type": "subtitle", "time": 19813.83, "timestamp": "05:30:13", "text": "学校里的人又开始说语言了。"}, {"type": "subtitle", "time": 19816.948, "timestamp": "05:30:16", "text": "学校将在第一周进行考试。"}, {"type": "subtitle", "time": 19820.91, "timestamp": "05:30:20", "text": "六月，然后我就能进入了。"}, {"type": "subtitle", "time": 19824.15, "timestamp": "05:30:24", "text": "仪式，是的，他们会……"}, {"type": "subtitle", "time": 19827.59, "timestamp": "05:30:27", "text": "分配我到一个类"}, {"type": "subtitle", "time": 19830.39, "timestamp": "05:30:30", "text": "取决于我的理解水平"}, {"type": "subtitle", "time": 19833.83, "timestamp": "05:30:33", "text": "比如，如果我只知道一些基本知识，如果我……"}, {"type": "subtitle", "time": 19836.07, "timestamp": "05:30:36", "text": "如果N4没问题，他们会安排我上去。"}, {"type": "subtitle", "time": 19839.43, "timestamp": "05:30:39", "text": "四批，呃，或者像这样，我想"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "这就是学生们的同学们是如何做到的"}, {"type": "subtitle", "time": 19846.39, "timestamp": "05:30:46", "text": "四月份入学的时候，他们告诉我就是这样。"}, {"type": "subtitle", "time": 19849.67, "timestamp": "05:30:49", "text": "他们会进行格式化或"}, {"type": "subtitle", "time": 19852.788, "timestamp": "05:30:52", "text": "哦，听起来好像我不能喜欢"}, {"type": "subtitle", "time": 19855.27, "timestamp": "05:30:55", "text": "想象一下，我只从你那里了解你"}, {"type": "subtitle", "time": 19857.75, "timestamp": "05:30:57", "text": "感觉就像有这么一件事……"}]
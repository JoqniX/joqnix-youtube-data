[{"type": "subtitle", "time": 4981.03, "timestamp": "01:23:01", "text": "在你接近之前"}, {"type": "subtitle", "time": 4987.629, "timestamp": "01:23:07", "text": "[音乐]"}, {"type": "subtitle", "time": 5009.189, "timestamp": "01:23:29", "text": "他们接受我。我想我从来没有过"}, {"type": "subtitle", "time": 5011.47, "timestamp": "01:23:31", "text": "看到一只鹰马对某人说了这句话"}, {"type": "subtitle", "time": 5013.75, "timestamp": "01:23:33", "text": "迅速地。你可以喂她、给她梳毛。"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "你会喜欢的。是啊，我……不，不，我只是想"}, {"type": "subtitle", "time": 5019.59, "timestamp": "01:23:39", "text": "骑上他，迪奥。我想，我想飞"}, {"type": "subtitle", "time": 5022.07, "timestamp": "01:23:42", "text": "仰望天空，你从观察中就能明白。"}, {"type": "subtitle", "time": 5024.87, "timestamp": "01:23:44", "text": "她看着她，但她是一条龙。而是使用"}, {"type": "subtitle", "time": 5027.31, "timestamp": "01:23:47", "text": "我那得力的扫帚，我想要个支架"}, {"type": "subtitle", "time": 5036.75, "timestamp": "01:23:56", "text": "[音乐]"}]
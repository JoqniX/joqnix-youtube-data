[{"type": "subtitle", "time": 3853.67, "timestamp": "01:04:13", "text": "这里。聊天室就在那里。"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "是的。所以，今天，让我们来看看这位骑师……"}, {"type": "subtitle", "time": 3865.67, "timestamp": "01:04:25", "text": "就像这种很酷的眼镜。"}, {"type": "subtitle", "time": 3868.71, "timestamp": "01:04:28", "text": "这是哪种类型的眼镜来着？"}, {"type": "subtitle", "time": 3875.67, "timestamp": "01:04:35", "text": "所以我们会问：他们为什么看着我？"}, {"type": "subtitle", "time": 3877.75, "timestamp": "01:04:37", "text": "是吗？"}, {"type": "subtitle", "time": 3880.069, "timestamp": "01:04:40", "text": "或许现在我们可以阻止这一切了。"}, {"type": "subtitle", "time": 3883.51, "timestamp": "01:04:43", "text": "令人作呕的血迹。你是吗？你是吗？"}, {"type": "subtitle", "time": 3887.589, "timestamp": "01:04:47", "text": "是在说我吗？亲爱的先生，孩子们"}, {"type": "subtitle", "time": 3889.109, "timestamp": "01:04:49", "text": "讨厌。"}, {"type": "subtitle", "time": 3891.109, "timestamp": "01:04:51", "text": "好吧，我父母是，我想他们是"}, {"type": "subtitle", "time": 3893.829, "timestamp": "01:04:53", "text": "我不是在讨论他们会不会只是随便坐坐。"}, {"type": "subtitle", "time": 3896.47, "timestamp": "01:04:56", "text": "座位。"}]
[{"type": "subtitle", "time": 194.03, "timestamp": "00:03:14", "text": "这是什么？如何从家到达目的地"}, {"type": "subtitle", "time": 197.50900000000001, "timestamp": "00:03:17", "text": "回家做作业还是去学校做作业？但我不会去"}, {"type": "subtitle", "time": 207.43, "timestamp": "00:03:27", "text": "工作。这是一份居家办公的工作。考试"}, {"type": "subtitle", "time": 210.63, "timestamp": "00:03:30", "text": "只有考试的时候我才需要去"}, {"type": "subtitle", "time": 219.67000000000002, "timestamp": "00:03:39", "text": "尽管。我不想骑车。我是否拥有"}, {"type": "subtitle", "time": 226.99, "timestamp": "00:03:46", "text": "写"}]
[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "我像只杜鹃鸟。杜鹃鸟到底是什么来着？"}, {"type": "subtitle", "time": 1802.15, "timestamp": "00:30:02", "text": "凉爽的。"}, {"type": "subtitle", "time": 1809.909, "timestamp": "00:30:09", "text": "如果我不学习这些词汇，那就是我"}, {"type": "subtitle", "time": 1812.75, "timestamp": "00:30:12", "text": "我肯定会遇到困难。"}, {"type": "subtitle", "time": 1819.23, "timestamp": "00:30:19", "text": "做"}, {"type": "subtitle", "time": 1821.63, "timestamp": "00:30:21", "text": "这"}, {"type": "subtitle", "time": 1843.549, "timestamp": "00:30:43", "text": "斤。好的。这个人，或者其中一个。是的。"}, {"type": "subtitle", "time": 1853.63, "timestamp": "00:30:53", "text": "你好。然后是第四个"}, {"type": "subtitle", "time": 1856.23, "timestamp": "00:30:56", "text": "一。第四个，也是最特别的那个。"}, {"type": "subtitle", "time": 1858.07, "timestamp": "00:30:58", "text": "由此"}]
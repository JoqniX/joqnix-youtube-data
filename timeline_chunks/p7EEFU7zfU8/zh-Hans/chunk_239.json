[{"type": "subtitle", "time": 14340.03, "timestamp": "03:59:00", "text": "我杀了他吗？"}, {"type": "subtitle", "time": 14342.309, "timestamp": "03:59:02", "text": "不，让他来。让他来。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "烈焰焚身，"}, {"type": "subtitle", "time": 14356.15, "timestamp": "03:59:16", "text": "叛乱。"}, {"type": "subtitle", "time": 14363.189, "timestamp": "03:59:23", "text": "蜘蛛。哦，就像，好吧，你得瞄准。"}, {"type": "subtitle", "time": 14383.95, "timestamp": "03:59:43", "text": "在那里"}, {"type": "subtitle", "time": 14394.189, "timestamp": "03:59:54", "text": "完毕。我该如何处理这些呢？"}]
[{"type": "subtitle", "time": 9601.429, "timestamp": "02:40:01", "text": "微风拂面，令人心旷神怡。我一直"}, {"type": "subtitle", "time": 9603.27, "timestamp": "02:40:03", "text": "霍温教授正在思考一些事情"}, {"type": "subtitle", "time": 9605.91, "timestamp": "02:40:05", "text": "在野兽课上说的。我应该学习"}, {"type": "subtitle", "time": 9609.429, "timestamp": "02:40:09", "text": "很多都是我利用自己的时间做的。她还提到"}, {"type": "subtitle", "time": 9611.11, "timestamp": "02:40:11", "text": "偷猎者一直很活跃"}, {"type": "subtitle", "time": 9613.83, "timestamp": "02:40:13", "text": "区域。所以或许这头野兽会更安全。"}, {"type": "subtitle", "time": 9615.51, "timestamp": "02:40:15", "text": "他们宁愿和我们在一起，也不愿独自在外。"}, {"type": "subtitle", "time": 9617.67, "timestamp": "02:40:17", "text": "真的。这正是Deep的本质。是的。"}, {"type": "subtitle", "time": 9620.23, "timestamp": "02:40:20", "text": "你好。你看，放松点，孩子。我希望"}, {"type": "subtitle", "time": 9623.11, "timestamp": "02:40:23", "text": "你做得很好。幸运的是，德可以"}, {"type": "subtitle", "time": 9627.09, "timestamp": "02:40:27", "text": "让你看看怎么让别人看到我的鸡巴。和"}, {"type": "subtitle", "time": 9634.87, "timestamp": "02:40:34", "text": "然后呢？我应该等。不。"}, {"type": "subtitle", "time": 9638.389, "timestamp": "02:40:38", "text": "我的天哪。我先停下来。稍等片刻。"}, {"type": "subtitle", "time": 9640.389, "timestamp": "02:40:40", "text": "好的。顺道去三把扫帚酒吧看看"}, {"type": "subtitle", "time": 9643.67, "timestamp": "02:40:43", "text": "你可以。让我把这些装备都拿来。"}, {"type": "subtitle", "time": 9646.15, "timestamp": "02:40:46", "text": "那我之后就跟你一起去。只是"}, {"type": "subtitle", "time": 9647.55, "timestamp": "02:40:47", "text": "等待。"}, {"type": "subtitle", "time": 9652.469, "timestamp": "02:40:52", "text": "好的。我会放呃"}, {"type": "subtitle", "time": 9654.389, "timestamp": "02:40:54", "text": "正如我提到的，我的姐姐和夫人。"}, {"type": "subtitle", "time": 9656.55, "timestamp": "02:40:56", "text": "霍格沃茨。她状态不太好。我"}, {"type": "subtitle", "time": 9658.389, "timestamp": "02:40:58", "text": "需要一部分。我想接受你的提议。"}, {"type": "subtitle", "time": 9659.91, "timestamp": "02:40:59", "text": "你答应过要和我一起去看她。我是"}]
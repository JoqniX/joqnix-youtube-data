[{"type": "subtitle", "time": 4622.07, "timestamp": "01:17:02", "text": "她的名字叫菲妮。"}, {"type": "subtitle", "time": 4624.01, "timestamp": "01:17:04", "text": "这真的一点都不好笑。"}, {"type": "subtitle", "time": 4647.51, "timestamp": "01:17:27", "text": "任何接近这个级别的。我的天啊。"}, {"type": "subtitle", "time": 4651.43, "timestamp": "01:17:31", "text": "帕妮立刻就识破了他们的伎俩。哇。"}, {"type": "subtitle", "time": 4654.07, "timestamp": "01:17:34", "text": "我们继续。喂食和刷毛"}, {"type": "subtitle", "time": 4656.39, "timestamp": "01:17:36", "text": "就像你对杰拉德做的那样。"}, {"type": "subtitle", "time": 4660.39, "timestamp": "01:17:40", "text": "内尔斯。好的。这种猫科动物。"}, {"type": "subtitle", "time": 4662.149, "timestamp": "01:17:42", "text": "哦，看看他们。实际上，看起来"}, {"type": "subtitle", "time": 4665.189, "timestamp": "01:17:45", "text": "像猫一样，但手里拿着一支大画笔"}, {"type": "subtitle", "time": 4679.91, "timestamp": "01:17:59", "text": "如果你喜欢的话，我可以给你一只脚。"}]
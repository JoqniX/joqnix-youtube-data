[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "波比，有什么事吗？再次感谢您"}, {"type": "subtitle", "time": 4863.11, "timestamp": "01:21:03", "text": "对那些畜生说些什么，以便"}, {"type": "subtitle", "time": 4865.75, "timestamp": "01:21:05", "text": "我本来不必这么做。你曾是预兆"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "沙漠正午。我肯定是在中午。"}, {"type": "subtitle", "time": 4872.31, "timestamp": "01:21:12", "text": "我和我奶奶都说，这意味着"}, {"type": "subtitle", "time": 4874.79, "timestamp": "01:21:14", "text": "某人或某事令人欣喜"}, {"type": "subtitle", "time": 4877.43, "timestamp": "01:21:17", "text": "惊喜。哦，至少我们是这么认为的。"}, {"type": "subtitle", "time": 4879.59, "timestamp": "01:21:19", "text": "决定了它的含义。我无法站在那里"}, {"type": "subtitle", "time": 4881.43, "timestamp": "01:21:21", "text": "眼睁睁看着他们伤害这可怜的小家伙。"}, {"type": "subtitle", "time": 4884.55, "timestamp": "01:21:24", "text": "我们想法很相似。实际上，在"}, {"type": "subtitle", "time": 4886.709, "timestamp": "01:21:26", "text": "鉴于此，我喜欢一个人。"}, {"type": "subtitle", "time": 4889.51, "timestamp": "01:21:29", "text": "你们将在森林里见面。在"}, {"type": "subtitle", "time": 4891.11, "timestamp": "01:21:31", "text": "森林。"}, {"type": "subtitle", "time": 4893.83, "timestamp": "01:21:33", "text": "哦，你引起了我的兴趣。那非常"}, {"type": "subtitle", "time": 4897.11, "timestamp": "01:21:37", "text": "出色地。带路。我原本希望如此。"}, {"type": "subtitle", "time": 4904.95, "timestamp": "01:21:44", "text": "好的，等等。随便哪个人都行。实际上，"}, {"type": "subtitle", "time": 4908.229, "timestamp": "01:21:48", "text": "你是第一个。真的吗？那种感觉"}, {"type": "subtitle", "time": 4910.55, "timestamp": "01:21:50", "text": "动画太酷了。是的。是的。你好，"}, {"type": "subtitle", "time": 4913.43, "timestamp": "01:21:53", "text": "哈拉萨。欢迎。我们思考并感到快乐"}, {"type": "subtitle", "time": 4917.189, "timestamp": "01:21:57", "text": "消失日惊喜"}, {"type": "subtitle", "time": 4919.75, "timestamp": "01:21:59", "text": "还有，嗯，等等，也祝你早上好。"}]
[{"type": "subtitle", "time": 19980.868, "timestamp": "05:33:00", "text": "写。我就是那种痛苦，我就是那种痛苦。"}, {"type": "subtitle", "time": 19983.03, "timestamp": "05:33:03", "text": "我打算学习日语。我当时就想，"}, {"type": "subtitle", "time": 19985.27, "timestamp": "05:33:05", "text": "是的，我的意思是，我必须认真对待这件事。"}, {"type": "subtitle", "time": 19988.39, "timestamp": "05:33:08", "text": "它。已经花费了大量资金。"}, {"type": "subtitle", "time": 19990.708, "timestamp": "05:33:10", "text": "呃，父母要送我去……"}, {"type": "subtitle", "time": 19993.99, "timestamp": "05:33:13", "text": "对我来说，去国外不同的国家。"}, {"type": "subtitle", "time": 19997.11, "timestamp": "05:33:17", "text": "学习等等。是的，所以……"}, {"type": "subtitle", "time": 20006.23, "timestamp": "05:33:26", "text": "感觉就像压力一样。"}, {"type": "subtitle", "time": 20009.75, "timestamp": "05:33:29", "text": "那里。嗯，是的，压力确实存在。"}, {"type": "subtitle", "time": 20014.39, "timestamp": "05:33:34", "text": "我没有，但如果我……呃，如果我……什么"}, {"type": "subtitle", "time": 20016.23, "timestamp": "05:33:36", "text": "发生什么事了，比如我违反了规则之类的。"}, {"type": "subtitle", "time": 20017.99, "timestamp": "05:33:37", "text": "或者如果我没有完全理解所有内容"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "如果我说对了，然后被送回家，我会"}, {"type": "subtitle", "time": 20027.59, "timestamp": "05:33:47", "text": "失望，我肯定喜欢"}, {"type": "subtitle", "time": 20030.708, "timestamp": "05:33:50", "text": "完全理解"}, {"type": "subtitle", "time": 20032.75, "timestamp": "05:33:52", "text": "我只是"}, {"type": "subtitle", "time": 20037.91, "timestamp": "05:33:57", "text": "嗯，是的，我需要找到那台相机。"}]
[{"type": "subtitle", "time": 20762.39, "timestamp": "05:46:02", "text": "我尝试过，我尝试过，我练习过"}, {"type": "subtitle", "time": 20764.868, "timestamp": "05:46:04", "text": "参加 Joathon 活动。我练习过了，而且我做到了"}, {"type": "subtitle", "time": 20767.35, "timestamp": "05:46:07", "text": "收到几次版权警告"}, {"type": "subtitle", "time": 20770.948, "timestamp": "05:46:10", "text": "练习时。你知道我做了什么吗？我"}, {"type": "subtitle", "time": 20773.51, "timestamp": "05:46:13", "text": "把伴奏和原曲放进去"}, {"type": "subtitle", "time": 20777.03, "timestamp": "05:46:17", "text": "在音乐软件上。我使用 Ableton"}, {"type": "subtitle", "time": 20779.51, "timestamp": "05:46:19", "text": "现在。所以我找到了你可以……的方法"}, {"type": "subtitle", "time": 20781.23, "timestamp": "05:46:21", "text": "分开"}, {"type": "subtitle", "time": 20785.11, "timestamp": "05:46:25", "text": "出去。你可以把它分开。所以我尝试"}, {"type": "subtitle", "time": 20789.27, "timestamp": "05:46:29", "text": "这样做。嗯，所以直播会"}, {"type": "subtitle", "time": 20791.51, "timestamp": "05:46:31", "text": "只听伴奏，我就能听见了。"}, {"type": "subtitle", "time": 20795.59, "timestamp": "05:46:35", "text": "呃，原版。所以问题是……"}, {"type": "subtitle", "time": 20798.31, "timestamp": "05:46:38", "text": "问题出在我以前这样做的时候"}, {"type": "subtitle", "time": 20801.51, "timestamp": "05:46:41", "text": "我用的是类似浏览器的那种。我使用的"}, {"type": "subtitle", "time": 20804.31, "timestamp": "05:46:44", "text": "用浏览器播放歌曲"}, {"type": "subtitle", "time": 20807.91, "timestamp": "05:46:47", "text": "原曲，并使用 VLC 播放器播放"}, {"type": "subtitle", "time": 20810.47, "timestamp": "05:46:50", "text": "媒体播放器或其他流媒体播放器"}, {"type": "subtitle", "time": 20813.35, "timestamp": "05:46:53", "text": "现在时机很难把握，呃……"}, {"type": "subtitle", "time": 20817.19, "timestamp": "05:46:57", "text": "两首歌都要播放。"}, {"type": "subtitle", "time": 20819.91, "timestamp": "05:46:59", "text": "是的。所以我想到用……来做这件事。"}]
[{"type": "subtitle", "time": 18062.07, "timestamp": "05:01:02", "text": "很高兴能帮上忙。布鲁特尔夫人"}, {"type": "subtitle", "time": 18063.67, "timestamp": "05:01:03", "text": "代她向她问好。不知道我会拥有什么。"}, {"type": "subtitle", "time": 18065.23, "timestamp": "05:01:05", "text": "没有她，一切都完成了。"}, {"type": "subtitle", "time": 18068.15, "timestamp": "05:01:08", "text": "艾登。谢谢。看到这种情况真令人难过。"}, {"type": "subtitle", "time": 18072.07, "timestamp": "05:01:12", "text": "感谢你帮助她。英伟达现在正在进军人工智能领域"}, {"type": "subtitle", "time": 18074.67, "timestamp": "05:01:14", "text": "迈向人工智能。回想美好回忆"}, {"type": "subtitle", "time": 18077.91, "timestamp": "05:01:17", "text": "优先考虑人工智能计算的内容"}, {"type": "subtitle", "time": 18082.03, "timestamp": "05:01:22", "text": "以及所有那些正在运转的人工智能工具"}, {"type": "subtitle", "time": 18092.948, "timestamp": "05:01:32", "text": "感觉英伟达的表现实际上更好。"}, {"type": "subtitle", "time": 18095.07, "timestamp": "05:01:35", "text": "英伟达和英特尔"}, {"type": "subtitle", "time": 18099.67, "timestamp": "05:01:39", "text": "实际的CPU，比如CPU处理器"}, {"type": "subtitle", "time": 18103.59, "timestamp": "05:01:43", "text": "品牌实际上做得更好了。"}, {"type": "subtitle", "time": 18105.91, "timestamp": "05:01:45", "text": "不，"}, {"type": "subtitle", "time": 18109.03, "timestamp": "05:01:49", "text": "因为英伟达是其中的一部分，就像是"}, {"type": "subtitle", "time": 18111.628, "timestamp": "05:01:51", "text": "在游戏领域处于领先地位，但是"}, {"type": "subtitle", "time": 18117.31, "timestamp": "05:01:57", "text": "现在他们改变了人工智能。哦，不。我是"}]
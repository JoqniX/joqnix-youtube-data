[{"type": "subtitle", "time": 14473.79, "timestamp": "04:01:13", "text": "我不知道该怎么骗它。好的。"}, {"type": "subtitle", "time": 14477.189, "timestamp": "04:01:17", "text": "总之，天色渐晚，而且"}, {"type": "subtitle", "time": 14478.83, "timestamp": "04:01:18", "text": "我需要去"}, {"type": "subtitle", "time": 14506.63, "timestamp": "04:01:46", "text": "兰德罗克的忠实拥护者是个威胁。什么"}, {"type": "subtitle", "time": 14509.75, "timestamp": "04:01:49", "text": "可以做到吗？糟糕，不。我帮不上忙。"}, {"type": "subtitle", "time": 14512.87, "timestamp": "04:01:52", "text": "就在这里。你提到兰德罗克了吗？"}, {"type": "subtitle", "time": 14516.469, "timestamp": "04:01:56", "text": "忠诚派？我做了。从未想过他们会"}, {"type": "subtitle", "time": 14518.469, "timestamp": "04:01:58", "text": "采取如此致命的行动。"}]
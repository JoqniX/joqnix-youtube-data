[{"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "哇。但你可以一直跑下去。是"}, {"type": "subtitle", "time": 5853.91, "timestamp": "01:37:33", "text": "跑步。伙计，你完全可以一直跑下去。"}, {"type": "subtitle", "time": 5857.109, "timestamp": "01:37:37", "text": "啊，找到了。女巫的坟墓。"}, {"type": "subtitle", "time": 5859.43, "timestamp": "01:37:39", "text": "我以前不是常来这儿吗？"}, {"type": "subtitle", "time": 5867.91, "timestamp": "01:37:47", "text": "祝你好运，希望你能找回头盔。"}, {"type": "subtitle", "time": 5869.669, "timestamp": "01:37:49", "text": "魔杖携带者。你应该有一个"}, {"type": "subtitle", "time": 5872.95, "timestamp": "01:37:52", "text": "优势。现在，在你出发之前，请这样做"}, {"type": "subtitle", "time": 5879.51, "timestamp": "01:37:59", "text": "好了，我准备好了。一切都很清楚了。"}]
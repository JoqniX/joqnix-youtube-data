[{"type": "subtitle", "time": 542.829, "timestamp": "00:09:02", "text": "上帝派错了人"}, {"type": "subtitle", "time": 550.19, "timestamp": "00:09:10", "text": "是的。哦，不。哦"}, {"type": "subtitle", "time": 552.64, "timestamp": "00:09:12", "text": "男生。我刚才说到哪儿了？我"}, {"type": "subtitle", "time": 554.75, "timestamp": "00:09:14", "text": "[笑声]"}, {"type": "subtitle", "time": 557.91, "timestamp": "00:09:17", "text": "忘了。是的。这叫做学习。"}, {"type": "subtitle", "time": 559.99, "timestamp": "00:09:19", "text": "是的。"}, {"type": "subtitle", "time": 562.509, "timestamp": "00:09:22", "text": "我无法保持这么长时间的稳定。"}, {"type": "subtitle", "time": 566.47, "timestamp": "00:09:26", "text": "尽管。你知道，如果我只是直播的话，"}, {"type": "subtitle", "time": 568.99, "timestamp": "00:09:28", "text": "我非常认真地对待这件事。"}, {"type": "subtitle", "time": 571.67, "timestamp": "00:09:31", "text": "某物。我注意到，即使"}, {"type": "subtitle", "time": 573.35, "timestamp": "00:09:33", "text": "比如说，你想让我做什么"}, {"type": "subtitle", "time": 575.829, "timestamp": "00:09:35", "text": "做点什么，画画、创作音乐或者喜欢"}, {"type": "subtitle", "time": 578.11, "timestamp": "00:09:38", "text": "玩或者做点什么"}, {"type": "subtitle", "time": 581.71, "timestamp": "00:09:41", "text": "我必须认真专注地做一件事"}, {"type": "subtitle", "time": 584.389, "timestamp": "00:09:44", "text": "溪流。这就是我如此严肃的原因。"}, {"type": "subtitle", "time": 585.55, "timestamp": "00:09:45", "text": "或者"}, {"type": "subtitle", "time": 588.87, "timestamp": "00:09:48", "text": "有时候会发生一些事。但有时当"}, {"type": "subtitle", "time": 591.03, "timestamp": "00:09:51", "text": "我直播的时候会分心，因为"}, {"type": "subtitle", "time": 592.43, "timestamp": "00:09:52", "text": "聊天和"}, {"type": "subtitle", "time": 596.03, "timestamp": "00:09:56", "text": "东西，还有试图说话和"}, {"type": "subtitle", "time": 599.75, "timestamp": "00:09:59", "text": "东西。但是，我也不知道。也许我"}]
[{"type": "subtitle", "time": 17822.948, "timestamp": "04:57:02", "text": "我的天啊。我一直都说旅行"}, {"type": "subtitle", "time": 17825.59, "timestamp": "04:57:05", "text": "我们已经有四个人了。我的天哪。 WHO"}, {"type": "subtitle", "time": 17829.03, "timestamp": "04:57:09", "text": "住在这里吗？这是汽车吗？"}, {"type": "subtitle", "time": 17832.67, "timestamp": "04:57:12", "text": "谢谢大家"}, {"type": "subtitle", "time": 17835.75, "timestamp": "04:57:15", "text": "增加我的直播时长。您好，先生。"}, {"type": "subtitle", "time": 17838.47, "timestamp": "04:57:18", "text": "斯克鲁特尔。我有个好消息。我能够"}, {"type": "subtitle", "time": 17840.31, "timestamp": "04:57:20", "text": "为你采集一些鹰巢"}, {"type": "subtitle", "time": 17842.868, "timestamp": "04:57:22", "text": "我找到了塞罗娜的信件盒。哦，"}, {"type": "subtitle", "time": 17846.55, "timestamp": "04:57:26", "text": "谢谢。太好了。旅行"}, {"type": "subtitle", "time": 17848.708, "timestamp": "04:57:28", "text": "供应商们会非常乐意补货"}, {"type": "subtitle", "time": 17851.75, "timestamp": "04:57:31", "text": "他们的假发和焊接药水库存。和"}, {"type": "subtitle", "time": 17853.75, "timestamp": "04:57:33", "text": "塞罗纳会很高兴拥有这些"}, {"type": "subtitle", "time": 17857.19, "timestamp": "04:57:37", "text": "信件。你真好。现在你是"}, {"type": "subtitle", "time": 17861.27, "timestamp": "04:57:41", "text": "小心返回霍格莫。"}, {"type": "subtitle", "time": 17862.868, "timestamp": "04:57:42", "text": "我应该把这箱信件带到"}, {"type": "subtitle", "time": 17875.91, "timestamp": "04:57:55", "text": "塞罗纳。哦，是的。所以，呃，接下来的计划是什么？"}, {"type": "subtitle", "time": 17877.91, "timestamp": "04:57:57", "text": "一周，对吧？我一直在说。所以，我们"}]
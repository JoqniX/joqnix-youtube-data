[{"type": "subtitle", "time": 20281.39, "timestamp": "05:38:01", "text": "你有权这样做。你是"}, {"type": "subtitle", "time": 20284.51, "timestamp": "05:38:04", "text": "安全的。不过，还是要小心。"}, {"type": "subtitle", "time": 20288.07, "timestamp": "05:38:08", "text": "是的，我确实想过这个问题，但是"}, {"type": "subtitle", "time": 20291.43, "timestamp": "05:38:11", "text": "就像我有点像那样分享"}, {"type": "subtitle", "time": 20294.47, "timestamp": "05:38:14", "text": "不确定。我只见过一个主播"}, {"type": "subtitle", "time": 20296.83, "timestamp": "05:38:16", "text": "就像奇怪的缺失"}, {"type": "subtitle", "time": 20304.19, "timestamp": "05:38:24", "text": "他。"}, {"type": "subtitle", "time": 20310.19, "timestamp": "05:38:30", "text": "呃，我不知道该怎么说……等等，说到这个……"}, {"type": "subtitle", "time": 20312.708, "timestamp": "05:38:32", "text": "首次亮相时，你需要做的事情太多了。"}, {"type": "subtitle", "time": 20315.83, "timestamp": "05:38:35", "text": "做好充分准备"}, {"type": "subtitle", "time": 20319.67, "timestamp": "05:38:39", "text": "首次亮相，关于首次亮相。是啊，就像如果你是"}, {"type": "subtitle", "time": 20322.23, "timestamp": "05:38:42", "text": "如果你想出道，我并不反对。"}, {"type": "subtitle", "time": 20323.99, "timestamp": "05:38:43", "text": "有什么东西吗？"}, {"type": "subtitle", "time": 20327.51, "timestamp": "05:38:47", "text": "比如幻灯片之类的。幻灯片。不"}, {"type": "subtitle", "time": 20330.47, "timestamp": "05:38:50", "text": "喜欢这条腿。是的。很多次了。"}, {"type": "subtitle", "time": 20332.708, "timestamp": "05:38:52", "text": "我没有什么新作品要发布。那是"}, {"type": "subtitle", "time": 20334.31, "timestamp": "05:38:54", "text": "那个东西。我没有什么可说的"}, {"type": "subtitle", "time": 20337.43, "timestamp": "05:38:57", "text": "首次亮相。嗯。"}, {"type": "subtitle", "time": 20339.75, "timestamp": "05:38:59", "text": "我觉得这才是最重要的。"}]
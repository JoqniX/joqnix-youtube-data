[{"type": "subtitle", "time": 1923.549, "timestamp": "00:32:03", "text": "意义。 223 223。"}, {"type": "subtitle", "time": 1926.549, "timestamp": "00:32:06", "text": "你好，帕里斯的儿子最近怎么样？我希望你"}, {"type": "subtitle", "time": 1933.23, "timestamp": "00:32:13", "text": "那个人"}, {"type": "subtitle", "time": 1950.43, "timestamp": "00:32:30", "text": "Furu 阻止了我的音频。"}, {"type": "subtitle", "time": 1955.43, "timestamp": "00:32:35", "text": "等等，我需要重置一下我的搅拌机。"}, {"type": "subtitle", "time": 1978.31, "timestamp": "00:32:58", "text": "哦，明白了。你好，截图。嗯？等等，不对。"}]
[{"type": "subtitle", "time": 10082.75, "timestamp": "02:48:02", "text": "一个"}, {"type": "subtitle", "time": 10085.23, "timestamp": "02:48:05", "text": "卡达瓦拉"}, {"type": "subtitle", "time": 10087.15, "timestamp": "02:48:07", "text": "abacadabra。这"}, {"type": "subtitle", "time": 10090.71, "timestamp": "02:48:10", "text": "我一直在等这些。何时"}, {"type": "subtitle", "time": 10092.429, "timestamp": "02:48:12", "text": "你给我"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "我想我们得学个新咒语了。"}, {"type": "subtitle", "time": 10102.19, "timestamp": "02:48:22", "text": "我们有"}, {"type": "subtitle", "time": 10104.79, "timestamp": "02:48:24", "text": "到达的。迪克很喜欢来这里"}, {"type": "subtitle", "time": 10107.19, "timestamp": "02:48:27", "text": "注意那些野兽，尤其是泡芙。"}, {"type": "subtitle", "time": 10110.07, "timestamp": "02:48:30", "text": "附近有泡芙皮。噗。要友善"}, {"type": "subtitle", "time": 10112.55, "timestamp": "02:48:32", "text": "保护好他们。你只需要做"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "靠近后，直接打开背包"}, {"type": "subtitle", "time": 10117.91, "timestamp": "02:48:37", "text": "朝着海鹦的方向走去，它就会进去。全部"}]
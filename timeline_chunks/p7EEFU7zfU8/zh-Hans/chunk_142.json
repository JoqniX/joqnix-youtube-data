[{"type": "subtitle", "time": 8521.63, "timestamp": "02:22:01", "text": "现在。你知道"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "什么？我想我应该……你知道"}, {"type": "subtitle", "time": 8528.91, "timestamp": "02:22:08", "text": "我该怎么办？我还是回去养猪吧。"}, {"type": "subtitle", "time": 8541.429, "timestamp": "02:22:21", "text": "补给品。我想这应该算是不错吧。"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "猜测。我们去补充一下库存吧。"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "我需要找个商家。是的，就是这样"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "最后一个克莱门汀。欢迎。请进。"}, {"type": "subtitle", "time": 8563.349, "timestamp": "02:22:43", "text": "好的。我刚才说到哪儿了？正确的。哦是的。"}, {"type": "subtitle", "time": 8565.19, "timestamp": "02:22:45", "text": "我不需要种子之类的东西。我只是"}, {"type": "subtitle", "time": 8568.59, "timestamp": "02:22:48", "text": "需要出售物品。我不"}, {"type": "subtitle", "time": 8571.27, "timestamp": "02:22:51", "text": "出售此商品。你很有头脑"}, {"type": "subtitle", "time": 8574.349, "timestamp": "02:22:54", "text": "你是为了生意，对吧？卖"}]
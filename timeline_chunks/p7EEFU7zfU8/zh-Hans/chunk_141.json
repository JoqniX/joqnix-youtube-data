[{"type": "subtitle", "time": 8461.99, "timestamp": "02:21:01", "text": "因为我穷，所以需要钱。我需要，我需要"}, {"type": "subtitle", "time": 8464.11, "timestamp": "02:21:04", "text": "实际上制作"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "钱。你好呀。石棺一直是"}, {"type": "subtitle", "time": 8470.469, "timestamp": "02:21:10", "text": "突袭。我没找到头盔。只有死者"}, {"type": "subtitle", "time": 8473.91, "timestamp": "02:21:13", "text": "阿什维纳。该死，他们先到了。我们"}, {"type": "subtitle", "time": 8475.99, "timestamp": "02:21:15", "text": "必须在鲁克伍德使用它之前拿到它"}, {"type": "subtitle", "time": 8477.67, "timestamp": "02:21:17", "text": "为了进一步讨好他"}, {"type": "subtitle", "time": 8480.389, "timestamp": "02:21:20", "text": "兰德罗克。我看到了他们的一个营地。"}, {"type": "subtitle", "time": 8482.63, "timestamp": "02:21:22", "text": "离这里不远，但我恐怕你必须"}, {"type": "subtitle", "time": 8485.19, "timestamp": "02:21:25", "text": "独自进去。我的战斗生涯已经结束了。"}, {"type": "subtitle", "time": 8487.429, "timestamp": "02:21:27", "text": "我。"}, {"type": "subtitle", "time": 8491.03, "timestamp": "02:21:31", "text": "我会尽力而为。"}, {"type": "subtitle", "time": 8493.51, "timestamp": "02:21:33", "text": "我现在就去那里。好的。没有"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "浪费时间。赶在……之前拿到头盔"}, {"type": "subtitle", "time": 8498.309, "timestamp": "02:21:38", "text": "鲁克伍德必须这么做，否则我们将失去机会。"}, {"type": "subtitle", "time": 8501.03, "timestamp": "02:21:41", "text": "任何级别。无论多么微小"}, {"type": "subtitle", "time": 8503.91, "timestamp": "02:21:43", "text": "兰洛克，我需要先拿到一些份量。"}, {"type": "subtitle", "time": 8505.75, "timestamp": "02:21:45", "text": "想想那些可恶的窃贼……"}, {"type": "subtitle", "time": 8507.83, "timestamp": "02:21:47", "text": "他们竟然能接触到这样的文物。我需要"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "份量和其他东西。我有4000块钱。"}, {"type": "subtitle", "time": 8518.51, "timestamp": "02:21:58", "text": "富有的。有点远。"}]
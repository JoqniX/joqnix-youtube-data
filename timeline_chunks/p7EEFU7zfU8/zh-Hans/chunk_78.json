[{"type": "subtitle", "time": 4683.11, "timestamp": "01:18:03", "text": "它。你的膝盖真的太适合你了。他们"}, {"type": "subtitle", "time": 4688.39, "timestamp": "01:18:08", "text": "他们和我一样，一眼就能认出来。"}, {"type": "subtitle", "time": 4691.91, "timestamp": "01:18:11", "text": "看来我们的时间已经到了。"}, {"type": "subtitle", "time": 4694.55, "timestamp": "01:18:14", "text": "请合上笔，看看自己。"}, {"type": "subtitle", "time": 4699.11, "timestamp": "01:18:19", "text": "出去。我们的新学生在哪里？你好，"}, {"type": "subtitle", "time": 4702.39, "timestamp": "01:18:22", "text": "我是沙尔多。你在那里。我想"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "请稍等片刻。是的。"}, {"type": "subtitle", "time": 4707.35, "timestamp": "01:18:27", "text": "讲话。"}, {"type": "subtitle", "time": 4709.59, "timestamp": "01:18:29", "text": "教授您好。你想说话"}, {"type": "subtitle", "time": 4713.189, "timestamp": "01:18:33", "text": "与我一起？我做了。你是如何找到你的"}, {"type": "subtitle", "time": 4716.47, "timestamp": "01:18:36", "text": "第一头野兽的教训？很有趣。"}, {"type": "subtitle", "time": 4720.99, "timestamp": "01:18:40", "text": "我看到一个像小球一样的东西"}, {"type": "subtitle", "time": 4725.27, "timestamp": "01:18:45", "text": "动物像动物一样，死灵也像动物一样。"}, {"type": "subtitle", "time": 4728.39, "timestamp": "01:18:48", "text": "画笔的尾巴。你似乎"}, {"type": "subtitle", "time": 4731.59, "timestamp": "01:18:51", "text": "真正理解这一点。我不去"}, {"type": "subtitle", "time": 4734.55, "timestamp": "01:18:54", "text": "出去。我不去。我付了"}, {"type": "subtitle", "time": 4737.35, "timestamp": "01:18:57", "text": "额外费用，高级版，蕴含神奇力量"}, {"type": "subtitle", "time": 4739.669, "timestamp": "01:18:59", "text": "材料。优质的？你买了什么？"}]
[{"type": "subtitle", "time": 5702.11, "timestamp": "01:35:02", "text": "英亩。哦，胸口停顿。非常感谢"}, {"type": "subtitle", "time": 5705.43, "timestamp": "01:35:05", "text": "很多。兄弟，你在忙什么呢？你曾是"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "哦。 H：我觉得你不是刚来这儿的。"}, {"type": "subtitle", "time": 5717.43, "timestamp": "01:35:17", "text": "用爪子擦拭。"}, {"type": "subtitle", "time": 5720.6, "timestamp": "01:35:20", "text": "问号。"}, {"type": "subtitle", "time": 5735.43, "timestamp": "01:35:35", "text": "你。我本应该占据主导地位"}, {"type": "subtitle", "time": 5739.95, "timestamp": "01:35:39", "text": "呃，要跳板，好吧，就这样吧。"}, {"type": "subtitle", "time": 5744.07, "timestamp": "01:35:44", "text": "美好的。陵墓。"}, {"type": "subtitle", "time": 5747.75, "timestamp": "01:35:47", "text": "我准备好了。我们走吧。好的。没有"}, {"type": "subtitle", "time": 5749.21, "timestamp": "01:35:49", "text": "浪费时间。"}, {"type": "subtitle", "time": 5754.709, "timestamp": "01:35:54", "text": "我要找的这件遗物究竟是什么？"}, {"type": "subtitle", "time": 5757.189, "timestamp": "01:35:57", "text": "取回？一个价值。我的天哪，看看"}]
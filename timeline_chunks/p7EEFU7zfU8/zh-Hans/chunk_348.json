[{"type": "subtitle", "time": 20882.03, "timestamp": "05:48:02", "text": "走了。但"}, {"type": "subtitle", "time": 20885.51, "timestamp": "05:48:05", "text": "是啊，经典款。是的。"}, {"type": "subtitle", "time": 20888.31, "timestamp": "05:48:08", "text": "是啊，听起来确实有点棘手。"}, {"type": "subtitle", "time": 20891.03, "timestamp": "05:48:11", "text": "男装和摇滚真的就像是……"}, {"type": "subtitle", "time": 20893.51, "timestamp": "05:48:13", "text": "你说这真的很有共鸣，除了我"}, {"type": "subtitle", "time": 20896.07, "timestamp": "05:48:16", "text": "我没有可以藏身的柜子。"}, {"type": "subtitle", "time": 20902.47, "timestamp": "05:48:22", "text": "另外，呃，我注意到如果你在日本，"}, {"type": "subtitle", "time": 20904.788, "timestamp": "05:48:24", "text": "呃，如果你想的话"}, {"type": "subtitle", "time": 20907.27, "timestamp": "05:48:27", "text": "唱歌和做科克舞之类的，还有这个"}, {"type": "subtitle", "time": 20910.07, "timestamp": "05:48:30", "text": "名为 Joy Sound 的软件或应用程序"}, {"type": "subtitle", "time": 20913.43, "timestamp": "05:48:33", "text": "或者给主播用的kok之类的东西。所以，"}, {"type": "subtitle", "time": 20915.35, "timestamp": "05:48:35", "text": "我在想，反正我最终都要去。"}, {"type": "subtitle", "time": 20917.67, "timestamp": "05:48:37", "text": "如果要去日本，我必须改变我的"}, {"type": "subtitle", "time": 20921.03, "timestamp": "05:48:41", "text": "Steam 的服务器地址在日本，对吧？店铺"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "搬到日本，这样我终于可以"}, {"type": "subtitle", "time": 20926.948, "timestamp": "05:48:46", "text": "获得访问权限后，我终于可以……呃……你"}, {"type": "subtitle", "time": 20932.47, "timestamp": "05:48:52", "text": "可以。呃，比如在那里做直播。"}, {"type": "subtitle", "time": 20935.35, "timestamp": "05:48:55", "text": "是的，我可以做 Kok 的事，所以我不会"}, {"type": "subtitle", "time": 20938.31, "timestamp": "05:48:58", "text": "收到版权警告之类的"}]
[{"type": "subtitle", "time": 13565.83, "timestamp": "03:46:05", "text": "摘自巴德的日记。他"}, {"type": "subtitle", "time": 13569.189, "timestamp": "03:46:09", "text": "无意间听到的窃窃私语。计划一些事情去做"}, {"type": "subtitle", "time": 13570.92, "timestamp": "03:46:10", "text": "与我一起。"}, {"type": "subtitle", "time": 13573.03, "timestamp": "03:46:13", "text": "[掌声]"}, {"type": "subtitle", "time": 13578.229, "timestamp": "03:46:18", "text": "[音乐]"}, {"type": "subtitle", "time": 13600.51, "timestamp": "03:46:40", "text": "我要"}, {"type": "subtitle", "time": 13607.95, "timestamp": "03:46:47", "text": "[掌声]"}, {"type": "subtitle", "time": 13609.83, "timestamp": "03:46:49", "text": "[音乐]"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "好的，这是第三个了。好了，就这么定了。"}, {"type": "subtitle", "time": 13616.229, "timestamp": "03:46:56", "text": "你自己。我没有恶意。"}, {"type": "subtitle", "time": 13619.29, "timestamp": "03:46:59", "text": "还有一个。"}]
[{"type": "subtitle", "time": 9904.389, "timestamp": "02:45:04", "text": "什么？任务真不少。"}, {"type": "subtitle", "time": 9905.55, "timestamp": "02:45:05", "text": "哦，我的"}, {"type": "subtitle", "time": 9909.269, "timestamp": "02:45:09", "text": "上帝。哇。哇。将会是两个"}, {"type": "subtitle", "time": 9911.07, "timestamp": "02:45:11", "text": "小时"}, {"type": "subtitle", "time": 9927.91, "timestamp": "02:45:27", "text": "面具。哦，那是南瓜面具。哦，全部"}, {"type": "subtitle", "time": 9933.67, "timestamp": "02:45:33", "text": "面具。看看她。"}, {"type": "subtitle", "time": 9935.83, "timestamp": "02:45:35", "text": "既然你已经上过野兽的课了，"}, {"type": "subtitle", "time": 9938.07, "timestamp": "02:45:38", "text": "我已经安排迪克协助你使用"}, {"type": "subtitle", "time": 9940.15, "timestamp": "02:45:40", "text": "那个房间可以让你继续深造。"}, {"type": "subtitle", "time": 9942.15, "timestamp": "02:45:42", "text": "看待。请你到时在那里与他见面"}, {"type": "subtitle", "time": 9944.95, "timestamp": "02:45:44", "text": "能。好的。"}, {"type": "subtitle", "time": 9946.87, "timestamp": "02:45:46", "text": "我一直没有收到叔叔罗兰的消息。"}, {"type": "subtitle", "time": 9949.19, "timestamp": "02:45:49", "text": "相当长一段时间了。我简直要疯了。"}, {"type": "subtitle", "time": 9952.67, "timestamp": "02:45:52", "text": "忧心忡忡。我觉得我需要做"}, {"type": "subtitle", "time": 9956.429, "timestamp": "02:45:56", "text": "你知道吗？我们需要得到"}, {"type": "subtitle", "time": 9959.19, "timestamp": "02:45:59", "text": "我不知道我是否需要钱"}]
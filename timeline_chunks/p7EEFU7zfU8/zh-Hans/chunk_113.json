[{"type": "subtitle", "time": 6798.75, "timestamp": "01:53:18", "text": "啊，好的"}, {"type": "subtitle", "time": 6802.229, "timestamp": "01:53:22", "text": "我相信你没事的"}, {"type": "subtitle", "time": 6803.75, "timestamp": "01:53:23", "text": "嗯"}, {"type": "subtitle", "time": 6804.91, "timestamp": "01:53:24", "text": "[音乐]"}, {"type": "subtitle", "time": 6808.669, "timestamp": "01:53:28", "text": "嗯，你知道，我当时，我当时，我当时，我当时"}, {"type": "subtitle", "time": 6810.35, "timestamp": "01:53:30", "text": "让你感到沮丧"}, {"type": "subtitle", "time": 6813.629, "timestamp": "01:53:33", "text": "只需记住这一点"}, {"type": "subtitle", "time": 6816.79, "timestamp": "01:53:36", "text": "就这一次，让我之前就……"}, {"type": "subtitle", "time": 6826.189, "timestamp": "01:53:46", "text": "眨眼。我保证。承诺。下次我"}, {"type": "subtitle", "time": 6828.91, "timestamp": "01:53:48", "text": "惯于"}, {"type": "subtitle", "time": 6831.629, "timestamp": "01:53:51", "text": "欺骗。是的。不"}, {"type": "subtitle", "time": 6834.51, "timestamp": "01:53:54", "text": "担忧。我"}, {"type": "subtitle", "time": 6839.31, "timestamp": "01:53:59", "text": "惯于。这是我们之间的承诺"}]
[{"type": "subtitle", "time": 20702.07, "timestamp": "05:45:02", "text": "为了比赛。欢迎雷尼什。我们是"}, {"type": "subtitle", "time": 20705.59, "timestamp": "05:45:05", "text": "和丹一起出去玩，丹是V"}, {"type": "subtitle", "time": 20707.83, "timestamp": "05:45:07", "text": "来自印度的歌手。"}, {"type": "subtitle", "time": 20712.948, "timestamp": "05:45:12", "text": "你好。是的，我是D。我是一名来自[此处应填写平台名称]的虚拟主播。"}, {"type": "subtitle", "time": 20716.708, "timestamp": "05:45:16", "text": "呃，印度。我主要就是唱歌，嗯……"}, {"type": "subtitle", "time": 20719.11, "timestamp": "05:45:19", "text": "本地化歌曲，任何类型的日本流行音乐"}, {"type": "subtitle", "time": 20722.23, "timestamp": "05:45:22", "text": "歌曲。差不多就是这样。我也喜欢"}, {"type": "subtitle", "time": 20724.948, "timestamp": "05:45:24", "text": "来自 Alien Stage 的翻唱歌曲。是的。是的。"}, {"type": "subtitle", "time": 20727.59, "timestamp": "05:45:27", "text": "那是我目前最主要的事情。需要"}, {"type": "subtitle", "time": 20729.51, "timestamp": "05:45:29", "text": "完成所有外星人关卡的歌曲，这样我"}, {"type": "subtitle", "time": 20731.64, "timestamp": "05:45:31", "text": "终于可以继续前进了。"}, {"type": "subtitle", "time": 20733.51, "timestamp": "05:45:33", "text": "[音乐]"}, {"type": "subtitle", "time": 20736.868, "timestamp": "05:45:36", "text": "是的。她也是那个……"}, {"type": "subtitle", "time": 20742.27, "timestamp": "05:45:42", "text": "他指导我唱了几首歌。这"}, {"type": "subtitle", "time": 20743.868, "timestamp": "05:45:43", "text": "是的。"}, {"type": "subtitle", "time": 20747.708, "timestamp": "05:45:47", "text": "八和十一"}, {"type": "subtitle", "time": 20749.708, "timestamp": "05:45:49", "text": "一切。呃"}, {"type": "subtitle", "time": 20751.99, "timestamp": "05:45:51", "text": "是的。你还在练习吗？"}, {"type": "subtitle", "time": 20757.11, "timestamp": "05:45:57", "text": "单曲只听一遍？我喜欢，我的意思是，我猜"}]
[{"type": "subtitle", "time": 2883.95, "timestamp": "00:48:03", "text": "好吧，那我该怎么办？"}, {"type": "subtitle", "time": 2887.03, "timestamp": "00:48:07", "text": "做？写什么？有哪些东西"}, {"type": "subtitle", "time": 2890.069, "timestamp": "00:48:10", "text": "你们镇上有吗？用三个字母写。"}, {"type": "subtitle", "time": 2898.27, "timestamp": "00:48:18", "text": "关于？呃，富士。等待。"}, {"type": "subtitle", "time": 2905.23, "timestamp": "00:48:25", "text": "富士机器 fu 富士机器。富士町。"}, {"type": "subtitle", "time": 2907.71, "timestamp": "00:48:27", "text": "富士山"}, {"type": "subtitle", "time": 2911.589, "timestamp": "00:48:31", "text": "论坛。等等，我没明白。哪个"}, {"type": "subtitle", "time": 2914.589, "timestamp": "00:48:34", "text": "机器？哪个村？哪个哪个哪个"}, {"type": "subtitle", "time": 2918.23, "timestamp": "00:48:38", "text": "州？富士山。富科卡。是福冈吗？"}, {"type": "subtitle", "time": 2920.63, "timestamp": "00:48:40", "text": "我认为如果会提到富士的话，"}, {"type": "subtitle", "time": 2928.63, "timestamp": "00:48:48", "text": "相信。然后我会使用相同的"}, {"type": "subtitle", "time": 2929.53, "timestamp": "00:48:49", "text": "例如"}, {"type": "subtitle", "time": 2932.589, "timestamp": "00:48:52", "text": "[音乐]"}, {"type": "subtitle", "time": 2935.15, "timestamp": "00:48:55", "text": "嗯"}]
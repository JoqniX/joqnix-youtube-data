[{"type": "subtitle", "time": 19683.03, "timestamp": "05:28:03", "text": "平假名和片假名语法知识"}, {"type": "subtitle", "time": 19686.47, "timestamp": "05:28:06", "text": "懂一点汉字，但我不知道怎么做"}, {"type": "subtitle", "time": 19690.15, "timestamp": "05:28:10", "text": "但不知为何我通过了，而其他人全都通过了。"}, {"type": "subtitle", "time": 19693.99, "timestamp": "05:28:13", "text": "我考同一个徽章失败了，我当时就想：哇！"}, {"type": "subtitle", "time": 19695.91, "timestamp": "05:28:15", "text": "就像那样，大概过了三个月。"}, {"type": "subtitle", "time": 19697.91, "timestamp": "05:28:17", "text": "速度很快。我感觉自己像是在为……做准备"}, {"type": "subtitle", "time": 19700.548, "timestamp": "05:28:20", "text": "我现在就在监狱五号里，因为我感觉就像"}, {"type": "subtitle", "time": 19703.91, "timestamp": "05:28:23", "text": "有很多空闲时间。"}, {"type": "subtitle", "time": 19705.99, "timestamp": "05:28:25", "text": "所以，我就想，呃，我应该从……开始吗？"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "汉字？比如，我已经知道很多"}, {"type": "subtitle", "time": 19710.47, "timestamp": "05:28:30", "text": "词汇，但就像汉字一样"}, {"type": "subtitle", "time": 19712.47, "timestamp": "05:28:32", "text": "确实很难。比如，我必须"}, {"type": "subtitle", "time": 19715.91, "timestamp": "05:28:35", "text": "看过一两次就够了。"}, {"type": "subtitle", "time": 19719.43, "timestamp": "05:28:39", "text": "是的。我不知道，也许就像……"}, {"type": "subtitle", "time": 19721.43, "timestamp": "05:28:41", "text": "既然你像个历史系学生，我"}, {"type": "subtitle", "time": 19724.07, "timestamp": "05:28:44", "text": "猜想写出 ki 会是"}, {"type": "subtitle", "time": 19726.39, "timestamp": "05:28:46", "text": "对你有帮助，但对我来说没用。"}, {"type": "subtitle", "time": 19731.11, "timestamp": "05:28:51", "text": "工作。它不起作用。等等，为什么？喜欢"}, {"type": "subtitle", "time": 19733.59, "timestamp": "05:28:53", "text": "它不再像我以前那样了。"}, {"type": "subtitle", "time": 19736.07, "timestamp": "05:28:56", "text": "阅读一些我喜欢的东西，比如我写的"}, {"type": "subtitle", "time": 19739.18, "timestamp": "05:28:59", "text": "我实在记不起来了。"}]
[{"type": "subtitle", "time": 7986.069, "timestamp": "02:13:06", "text": "呃，Lumos。我的天啊。"}, {"type": "subtitle", "time": 7992.99, "timestamp": "02:13:12", "text": "完美？有人能说出“告诉”吗？"}, {"type": "subtitle", "time": 7996.55, "timestamp": "02:13:16", "text": "我？哦，你应该这样做："}, {"type": "subtitle", "time": 8013.43, "timestamp": "02:13:33", "text": "不。不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 8015.199, "timestamp": "02:13:35", "text": "不，不，不，不。 这是错误的。"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "那边有一个。哦好的。好的。"}, {"type": "subtitle", "time": 8031.95, "timestamp": "02:13:51", "text": "还。什么"}, {"type": "subtitle", "time": 8037.069, "timestamp": "02:13:57", "text": "这款游戏的物理原理是什么？"}]
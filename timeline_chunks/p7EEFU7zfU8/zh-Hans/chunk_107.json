[{"type": "subtitle", "time": 6423.43, "timestamp": "01:47:03", "text": "呃。就是日语。这是一些"}, {"type": "subtitle", "time": 6425.91, "timestamp": "01:47:05", "text": "更多菲律宾信息。但我做了什么？那是"}, {"type": "subtitle", "time": 6428.95, "timestamp": "01:47:08", "text": "这是我的第一次。有人说我看到"}, {"type": "subtitle", "time": 6436.55, "timestamp": "01:47:16", "text": "哇。我曾亲耳听到有人这样告诉我。"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "你在俄罗斯看到了。有人说你"}, {"type": "subtitle", "time": 6442.51, "timestamp": "01:47:22", "text": "听起来像是法语之类的。"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "嗯，大概就是这样。所以"}, {"type": "subtitle", "time": 6451.149, "timestamp": "01:47:31", "text": "呃，你们怎么称呼语言或地方？"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "请注意，我并非专家。就像，"}, {"type": "subtitle", "time": 6463.35, "timestamp": "01:47:43", "text": "你看过《进击的巨人》（Attack of Titan）吗？"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "我确实看过，但我没怎么关注《进击的巨人》。"}, {"type": "subtitle", "time": 6469.35, "timestamp": "01:47:49", "text": "东西。我只记得看过第一季。"}, {"type": "subtitle", "time": 6471.55, "timestamp": "01:47:51", "text": "第二，我"}, {"type": "subtitle", "time": 6475.35, "timestamp": "01:47:55", "text": "相信。嗯，我不太了解。"}]
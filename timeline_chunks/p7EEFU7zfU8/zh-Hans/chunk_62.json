[{"type": "subtitle", "time": 3721.43, "timestamp": "01:02:01", "text": "剪断那团火蜘蛛丝网"}, {"type": "subtitle", "time": 3724.549, "timestamp": "01:02:04", "text": "就是从这里传出来的那个东西"}, {"type": "subtitle", "time": 3727.349, "timestamp": "01:02:07", "text": "呃，从角落的墙角到另一个角落，"}, {"type": "subtitle", "time": 3735.589, "timestamp": "01:02:15", "text": "就像你原谅我一样，蜘蛛，我只会……"}, {"type": "subtitle", "time": 3743.51, "timestamp": "01:02:23", "text": "希望你过得愉快……呃……什么？"}, {"type": "subtitle", "time": 3746.309, "timestamp": "01:02:26", "text": "今天又是今天吗？呃，星期三。嗯，是的。"}, {"type": "subtitle", "time": 3753.27, "timestamp": "01:02:33", "text": "周三。我的天啊。就是这样。"}, {"type": "subtitle", "time": 3762.309, "timestamp": "01:02:42", "text": "乐趣。我的天哪。昨天真是太棒了。呃，我"}, {"type": "subtitle", "time": 3764.309, "timestamp": "01:02:44", "text": "昨天直播了。我完全"}, {"type": "subtitle", "time": 3766.39, "timestamp": "01:02:46", "text": "我忘了这件事了。是的。所以，我做了"}, {"type": "subtitle", "time": 3769.67, "timestamp": "01:02:49", "text": "昨天直播的时候说很有趣，但是"}, {"type": "subtitle", "time": 3772.15, "timestamp": "01:02:52", "text": "但我昨天太累了。我来了"}, {"type": "subtitle", "time": 3776.47, "timestamp": "01:02:56", "text": "回到家就像……嗯，是的，真的让我……"}, {"type": "subtitle", "time": 3779.91, "timestamp": "01:02:59", "text": "我猜大概是9点，不，是8点半之类的。"}]
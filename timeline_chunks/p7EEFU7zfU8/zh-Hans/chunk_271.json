[{"type": "subtitle", "time": 16263.03, "timestamp": "04:31:03", "text": "男生。我的天啊，我死定了。我死了。我是"}, {"type": "subtitle", "time": 16267.11, "timestamp": "04:31:07", "text": "死的。我死了。我死了。我死了。"}, {"type": "subtitle", "time": 16284.229, "timestamp": "04:31:24", "text": "该死，我差一点就成功了。我受到了伤害"}, {"type": "subtitle", "time": 16286.91, "timestamp": "04:31:26", "text": "弥补这一缺口。它是"}, {"type": "subtitle", "time": 16289.91, "timestamp": "04:31:29", "text": "好的。我们做得更好。让我推动一下"}, {"type": "subtitle", "time": 16304.07, "timestamp": "04:31:44", "text": "好的，我现在24级，而之前是26级。"}, {"type": "subtitle", "time": 16314.469, "timestamp": "04:31:54", "text": "男人。我先把这个放回去，一会儿再回来。"}]
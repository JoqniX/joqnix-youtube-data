[{"type": "subtitle", "time": 5101.75, "timestamp": "01:25:01", "text": "该地区存在问题。所以，我担心他们"}, {"type": "subtitle", "time": 5104.47, "timestamp": "01:25:04", "text": "我可能还会再得到她，而我可能不会……"}, {"type": "subtitle", "time": 5106.87, "timestamp": "01:25:06", "text": "下次再见。是的，我会救她。"}, {"type": "subtitle", "time": 5108.79, "timestamp": "01:25:08", "text": "这次。不用担心。你似乎"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "暗示我们不能依赖"}, {"type": "subtitle", "time": 5112.629, "timestamp": "01:25:12", "text": "协助部门工作。我并不经常同意"}, {"type": "subtitle", "time": 5115.35, "timestamp": "01:25:15", "text": "与霍文教授合作，但我对此感到担忧。"}, {"type": "subtitle", "time": 5118.39, "timestamp": "01:25:18", "text": "她说得对。偷猎者的影响是"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "生长。我每天都能看到他们。"}, {"type": "subtitle", "time": 5123.91, "timestamp": "01:25:23", "text": "在村子里闲逛，和人们聊天。"}, {"type": "subtitle", "time": 5126.229, "timestamp": "01:25:26", "text": "他们肯定在密谋什么。好的。我只是"}, {"type": "subtitle", "time": 5129.11, "timestamp": "01:25:29", "text": "不太确定是什么。"}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "听起来很可疑。是的。确切地。"}, {"type": "subtitle", "time": 5134.629, "timestamp": "01:25:34", "text": "等待。几乎不可疑，就好像它不是这样一样。"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "确实很可疑，对吧？类似"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "那。正在做"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "我认为这将是最终结果。"}, {"type": "subtitle", "time": 5145.669, "timestamp": "01:25:45", "text": "现在我越能更好地保有地堡"}, {"type": "subtitle", "time": 5148.79, "timestamp": "01:25:48", "text": "高翼安全，你似乎毫不气馁。"}]
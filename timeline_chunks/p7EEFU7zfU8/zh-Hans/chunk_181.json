[{"type": "subtitle", "time": 10863.83, "timestamp": "03:01:03", "text": "哦，你的野兽背包已满。"}, {"type": "subtitle", "time": 10864.99, "timestamp": "03:01:04", "text": "哦，"}, {"type": "subtitle", "time": 10871.05, "timestamp": "03:01:11", "text": "呃，好的。我们"}, {"type": "subtitle", "time": 10882.9, "timestamp": "03:01:22", "text": "必须发送"}, {"type": "subtitle", "time": 10894.469, "timestamp": "03:01:34", "text": "我不明白。这是一个可交互的"}, {"type": "subtitle", "time": 10896.95, "timestamp": "03:01:36", "text": "目的。为什么？我应该……"}, {"type": "subtitle", "time": 10899.67, "timestamp": "03:01:39", "text": "正在做。"}, {"type": "subtitle", "time": 10901.51, "timestamp": "03:01:41", "text": "这道题比其他的要难一些。"}, {"type": "subtitle", "time": 10903.51, "timestamp": "03:01:43", "text": "但我现在得了咳嗽。我们走吧。"}, {"type": "subtitle", "time": 10906.23, "timestamp": "03:01:46", "text": "又一个猛兽。平安无事。是的，德。"}, {"type": "subtitle", "time": 10908.71, "timestamp": "03:01:48", "text": "我们没看到月亮。我知道。迪，"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "真是令人惊叹的景象。迪伊认为"}, {"type": "subtitle", "time": 10913.67, "timestamp": "03:01:53", "text": "你到此为止了。你将能够"}, {"type": "subtitle", "time": 10916.23, "timestamp": "03:01:56", "text": "营救更多野兽。但就目前而言，"}, {"type": "subtitle", "time": 10917.91, "timestamp": "03:01:57", "text": "咱们把你们收集到的那些都带来吧"}]
[{"type": "subtitle", "time": 12382.55, "timestamp": "03:26:22", "text": "说到打水漂，对吧？"}, {"type": "subtitle", "time": 12384.269, "timestamp": "03:26:24", "text": "你好。"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "昨天，如果你被困在宿舍里"}, {"type": "subtitle", "time": 12389.429, "timestamp": "03:26:29", "text": "羽毛，真疼啊。你好。"}, {"type": "subtitle", "time": 12392.87, "timestamp": "03:26:32", "text": "昨天我试着打水漂。"}, {"type": "subtitle", "time": 12395.429, "timestamp": "03:26:35", "text": "我打水漂的最高得分是"}, {"type": "subtitle", "time": 12397.51, "timestamp": "03:26:37", "text": "实际上，其中很多都被一家公司收购了。"}, {"type": "subtitle", "time": 12400.309, "timestamp": "03:26:40", "text": "圣帕特里克的商人。是的，我明白了。"}, {"type": "subtitle", "time": 12406.87, "timestamp": "03:26:46", "text": "显然有过不愉快的经历"}, {"type": "subtitle", "time": 12409.469, "timestamp": "03:26:49", "text": "有人给我的 Wampus 寄头发"}, {"type": "subtitle", "time": 12411.75, "timestamp": "03:26:51", "text": "猫。肯定是某个人"}, {"type": "subtitle", "time": 12413.99, "timestamp": "03:26:53", "text": "毫无疑问是美国，因为我们甚至都不……"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "有个米娅。总之，你来这里做什么？"}]
[{"type": "subtitle", "time": 14582.75, "timestamp": "04:03:02", "text": "放松。我"}, {"type": "subtitle", "time": 14588.429, "timestamp": "04:03:08", "text": "我的一部分希望死者能够流利地观看。"}, {"type": "subtitle", "time": 14590.95, "timestamp": "04:03:10", "text": "今天。我想直播一款游戏。"}, {"type": "subtitle", "time": 14591.71, "timestamp": "04:03:11", "text": "所以"}, {"type": "subtitle", "time": 14594.229, "timestamp": "04:03:14", "text": "最近情况很糟糕。似乎事情"}, {"type": "subtitle", "time": 14597.59, "timestamp": "04:03:17", "text": "情况越来越糟。我最好提高警惕。"}, {"type": "subtitle", "time": 14599.91, "timestamp": "04:03:19", "text": "所以，我就想，我想直播那个节目。"}, {"type": "subtitle", "time": 14603.269, "timestamp": "04:03:23", "text": "游戏。我不想做任何直播"}, {"type": "subtitle", "time": 14605.269, "timestamp": "04:03:25", "text": "死。"}, {"type": "subtitle", "time": 14607.83, "timestamp": "04:03:27", "text": "但昨天我接手了。我没有"}, {"type": "subtitle", "time": 14610.71, "timestamp": "04:03:30", "text": "溪流。你会后悔来这里的。"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "安卓。所以我觉得我应该……"}, {"type": "subtitle", "time": 14616.07, "timestamp": "04:03:36", "text": "和你一起工作。但是，呃，我有个哥哥"}, {"type": "subtitle", "time": 14618.389, "timestamp": "04:03:38", "text": "在Gringots工作的人。它叫做这个"}, {"type": "subtitle", "time": 14620.469, "timestamp": "04:03:40", "text": "一。足以坐在办公桌后了"}, {"type": "subtitle", "time": 14622.99, "timestamp": "04:03:42", "text": "天。它叫做这个"}, {"type": "subtitle", "time": 14626.269, "timestamp": "04:03:46", "text": "呃，它叫这个"}, {"type": "subtitle", "time": 14628.189, "timestamp": "04:03:48", "text": "游戏。"}, {"type": "subtitle", "time": 14631.349, "timestamp": "04:03:51", "text": "这种运动就像高速运动一样"}]
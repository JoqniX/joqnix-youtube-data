[{"type": "subtitle", "time": 7923.189, "timestamp": "02:12:03", "text": "我怀疑你就是那个一直……的人"}, {"type": "subtitle", "time": 7925.069, "timestamp": "02:12:05", "text": "干涉一件相当私人的事情"}, {"type": "subtitle", "time": 7928.069, "timestamp": "02:12:08", "text": "事情。德米凯雕像和"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "其中所包含的伤口被放置为"}, {"type": "subtitle", "time": 7933.589, "timestamp": "02:12:13", "text": "他们这样做是有充分理由的。你应该"}, {"type": "subtitle", "time": 7935.83, "timestamp": "02:12:15", "text": "不要干涉他人的私事"}, {"type": "subtitle", "time": 7939.109, "timestamp": "02:12:19", "text": "其他的。对不起，Ryas Pam 或"}, {"type": "subtitle", "time": 7940.83, "timestamp": "02:12:20", "text": "某物。佩顿先生"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "静止不动了。"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "他知道一些关于那些小恶魔的事。"}, {"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": "月亮。他好像在霍格米德村。"}, {"type": "subtitle", "time": 7949.83, "timestamp": "02:12:29", "text": "或许我应该去拜访他。是的，"}, {"type": "subtitle", "time": 7952.229, "timestamp": "02:12:32", "text": "你应该这么做。卢莫斯，"}, {"type": "subtitle", "time": 7968.51, "timestamp": "02:12:48", "text": "嗯"}]
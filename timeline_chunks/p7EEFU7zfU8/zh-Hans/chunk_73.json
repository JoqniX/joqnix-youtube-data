[{"type": "subtitle", "time": 4381.229, "timestamp": "01:13:01", "text": "嗨，我感觉"}, {"type": "subtitle", "time": 4396.95, "timestamp": "01:13:16", "text": "那里。就像有只猫头鹰一样。"}, {"type": "subtitle", "time": 4399.59, "timestamp": "01:13:19", "text": "看来你已经见过一些人了。那是……"}, {"type": "subtitle", "time": 4402.669, "timestamp": "01:13:22", "text": "猫？学习这方面的内容。什么？虽然"}, {"type": "subtitle", "time": 4404.95, "timestamp": "01:13:24", "text": "建议，这些生物都不应该"}, {"type": "subtitle", "time": 4407.83, "timestamp": "01:13:27", "text": "被带走。哦，那是一只渡渡鸟。他们"}, {"type": "subtitle", "time": 4412.189, "timestamp": "01:13:32", "text": "他们都沉浸在自己的小世界里。呃，我"}, {"type": "subtitle", "time": 4415.709, "timestamp": "01:13:35", "text": "显示正确处理它们。哦，还有"}, {"type": "subtitle", "time": 4419.11, "timestamp": "01:13:39", "text": "并非你们很多人都不在，我展示了我"}, {"type": "subtitle", "time": 4422.149, "timestamp": "01:13:42", "text": "我知道我看到了速度，但我展示的是肉体。"}, {"type": "subtitle", "time": 4425.99, "timestamp": "01:13:45", "text": "兽。什么？他做了什么？你愿意吗？"}, {"type": "subtitle", "time": 4428.229, "timestamp": "01:13:48", "text": "请协助我们的新学生。"}, {"type": "subtitle", "time": 4431.35, "timestamp": "01:13:51", "text": "今天要上什么课？是的，霍文教授。什么"}, {"type": "subtitle", "time": 4434.31, "timestamp": "01:13:54", "text": "他做了吗？我是波比。罂粟甜味剂。"}, {"type": "subtitle", "time": 4435.91, "timestamp": "01:13:55", "text": "别担心教授。我的天啊，"}, {"type": "subtitle", "time": 4437.43, "timestamp": "01:13:57", "text": "她的声音真好听。夸大"}, {"type": "subtitle", "time": 4439.03, "timestamp": "01:13:59", "text": "有时。"}]
[{"type": "subtitle", "time": 17020.19, "timestamp": "04:43:40", "text": "好了，这些是僵尸。"}, {"type": "subtitle", "time": 17023.11, "timestamp": "04:43:43", "text": "好吧，那我接下来该去哪儿？"}, {"type": "subtitle", "time": 17025.39, "timestamp": "04:43:45", "text": "我在哪里"}, {"type": "subtitle", "time": 17029.708, "timestamp": "04:43:49", "text": "我？这是个好主意"}, {"type": "subtitle", "time": 17030.71, "timestamp": "04:43:50", "text": "森林。"}, {"type": "subtitle", "time": 17032.99, "timestamp": "04:43:52", "text": "[音乐]"}, {"type": "subtitle", "time": 17035.51, "timestamp": "04:43:55", "text": "呃，有一种古老的魔法。你知道"}, {"type": "subtitle", "time": 17038.39, "timestamp": "04:43:58", "text": "什么？我要去那里。"}]
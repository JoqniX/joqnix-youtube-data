[{"type": "subtitle", "time": 20101.35, "timestamp": "05:35:01", "text": "我已经受够了这一切"}, {"type": "subtitle", "time": 20104.868, "timestamp": "05:35:04", "text": "词汇。嗯。因为那就是我所在的地方"}, {"type": "subtitle", "time": 20107.27, "timestamp": "05:35:07", "text": "是的。是的。前进。哦，是的。是的。去"}, {"type": "subtitle", "time": 20111.75, "timestamp": "05:35:11", "text": "前方。是的。我注意到一件事"}, {"type": "subtitle", "time": 20115.03, "timestamp": "05:35:15", "text": "参加日语考试时，如果你不能"}, {"type": "subtitle", "time": 20117.67, "timestamp": "05:35:17", "text": "你读不了，你写不了任何东西"}, {"type": "subtitle", "time": 20121.548, "timestamp": "05:35:21", "text": "就像他们给了你很多棘手的问题"}, {"type": "subtitle", "time": 20125.43, "timestamp": "05:35:25", "text": "即使是像选择题那样的问题"}, {"type": "subtitle", "time": 20128.868, "timestamp": "05:35:28", "text": "是的，是选择题，但它会非常……"}, {"type": "subtitle", "time": 20131.91, "timestamp": "05:35:31", "text": "棘手的问题，所以你必须……"}, {"type": "subtitle", "time": 20135.67, "timestamp": "05:35:35", "text": "比如，你要聪明，他们也会聪明，所以你"}, {"type": "subtitle", "time": 20138.03, "timestamp": "05:35:38", "text": "得想办法解决这个问题"}, {"type": "subtitle", "time": 20149.19, "timestamp": "05:35:49", "text": "即使现在，那也是我想做的事。"}, {"type": "subtitle", "time": 20151.35, "timestamp": "05:35:51", "text": "如果让我重写一遍，我会"}, {"type": "subtitle", "time": 20154.39, "timestamp": "05:35:54", "text": "确实应该多练习阅读。如何"}, {"type": "subtitle", "time": 20155.948, "timestamp": "05:35:55", "text": "我能读懂一个"}, {"type": "subtitle", "time": 20158.47, "timestamp": "05:35:58", "text": "像英语一样轻松地造句"}]
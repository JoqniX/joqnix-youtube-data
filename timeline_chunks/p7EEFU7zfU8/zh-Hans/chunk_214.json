[{"type": "subtitle", "time": 12842.349, "timestamp": "03:34:02", "text": "我的天啊。哦，这条鱼很难……"}, {"type": "subtitle", "time": 12847.429, "timestamp": "03:34:07", "text": "用勺子够到。哦。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 12850.309, "timestamp": "03:34:10", "text": "啊。上霍克菲尔德。那么，去哪里找呢？"}, {"type": "subtitle", "time": 12852.63, "timestamp": "03:34:12", "text": "斯普拉特尔夫人？"}, {"type": "subtitle", "time": 12863.67, "timestamp": "03:34:23", "text": "阿沙姆·巴德认为黑暗魔法是"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "回答。你好呀。我估计是布鲁克伍兹"}, {"type": "subtitle", "time": 12873.11, "timestamp": "03:34:33", "text": "你好，布鲁特尔夫人。实际上，塞罗娜"}, {"type": "subtitle", "time": 12876.07, "timestamp": "03:34:36", "text": "瑞恩问我愿不愿意去看你。哦，"}, {"type": "subtitle", "time": 12880.229, "timestamp": "03:34:40", "text": "亲爱的塞罗娜。一颗璀璨的宝石。一直以来都是如此"}, {"type": "subtitle", "time": 12882.389, "timestamp": "03:34:42", "text": "据我所知，她就是这样的人。她觉得你可能会"}, {"type": "subtitle", "time": 12883.83, "timestamp": "03:34:43", "text": "需要帮忙收集食材"}, {"type": "subtitle", "time": 12885.91, "timestamp": "03:34:45", "text": "你的威根世界药水。而她"}, {"type": "subtitle", "time": 12888.87, "timestamp": "03:34:48", "text": "正确的。我亲爱的艾登过去常常"}, {"type": "subtitle", "time": 12891.269, "timestamp": "03:34:51", "text": "帮我收集鹰的粪便。因为他"}, {"type": "subtitle", "time": 12894.15, "timestamp": "03:34:54", "text": "死了，我的存货也越来越少了。对不起"}, {"type": "subtitle", "time": 12897.229, "timestamp": "03:34:57", "text": "布鲁塔尔夫人，节哀顺变。哦，谢谢"}]
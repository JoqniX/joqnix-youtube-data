[{"type": "subtitle", "time": 18001.35, "timestamp": "05:00:01", "text": "我发现AMD在FS方面完胜Dvidia。"}, {"type": "subtitle", "time": 18003.15, "timestamp": "05:00:03", "text": "三。等等，这是什么？让我看看"}, {"type": "subtitle", "time": 18012.15, "timestamp": "05:00:12", "text": "许多。好的。嗯，也许吧。好的。我想知道"}, {"type": "subtitle", "time": 18014.83, "timestamp": "05:00:14", "text": "关于盒子里的一些信件。的"}, {"type": "subtitle", "time": 18017.11, "timestamp": "05:00:17", "text": "当然，似乎大部分字母"}, {"type": "subtitle", "time": 18025.99, "timestamp": "05:00:25", "text": "[音乐]"}, {"type": "subtitle", "time": 18027.75, "timestamp": "05:00:27", "text": "其中一封信提到了魁地奇。"}, {"type": "subtitle", "time": 18031.03, "timestamp": "05:00:31", "text": "实践。你玩了吗？我做了。是"}, {"type": "subtitle", "time": 18034.31, "timestamp": "05:00:34", "text": "担任拉文克劳学院找球手三年。哦，"}, {"type": "subtitle", "time": 18037.59, "timestamp": "05:00:37", "text": "梅林的胡子。我非常喜欢魁地奇。"}, {"type": "subtitle", "time": 18039.35, "timestamp": "05:00:39", "text": "没有什么比抓住机会的感觉更棒了"}, {"type": "subtitle", "time": 18041.51, "timestamp": "05:00:41", "text": "当你的球队落后时，金色飞贼"}, {"type": "subtitle", "time": 18044.31, "timestamp": "05:00:44", "text": "140分。我永远不会原谅教授"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "布莱克因今年取消该活动而受到批评。我"}, {"type": "subtitle", "time": 18047.868, "timestamp": "05:00:47", "text": "错过了为……加油"}, {"type": "subtitle", "time": 18049.91, "timestamp": "05:00:49", "text": "拉文克劳。我们本可以为他们加油的"}, {"type": "subtitle", "time": 18059.35, "timestamp": "05:00:59", "text": "嗯，乐意效劳。"}]
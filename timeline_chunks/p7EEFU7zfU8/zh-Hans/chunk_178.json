[{"type": "subtitle", "time": 10683.71, "timestamp": "02:58:03", "text": "oi。"}, {"type": "subtitle", "time": 10687.429, "timestamp": "02:58:07", "text": "三。已购入。"}, {"type": "subtitle", "time": 10691.83, "timestamp": "02:58:11", "text": "请安静下来。我没有恶意。"}, {"type": "subtitle", "time": 10693.91, "timestamp": "02:58:13", "text": "你等着瞧吧。有一只松鼠"}, {"type": "subtitle", "time": 10710.83, "timestamp": "02:58:30", "text": "请？等等，另一个月亮在哪儿？"}, {"type": "subtitle", "time": 10713.469, "timestamp": "02:58:33", "text": "去？嘿"}, {"type": "subtitle", "time": 10723.75, "timestamp": "02:58:43", "text": "移动。我看到有动静。我爱你"}, {"type": "subtitle", "time": 10724.99, "timestamp": "02:58:44", "text": "还。"}]
[{"type": "subtitle", "time": 17461.07, "timestamp": "04:51:01", "text": "这里。"}, {"type": "subtitle", "time": 17464.35, "timestamp": "04:51:04", "text": "好的。我是一名蜘蛛猎人。"}, {"type": "subtitle", "time": 17472.99, "timestamp": "04:51:12", "text": "哦，大老板。"}, {"type": "subtitle", "time": 17478.868, "timestamp": "04:51:18", "text": "哦，是老板出场时间吗？是时候展现你的实力了。"}, {"type": "subtitle", "time": 17497.948, "timestamp": "04:51:37", "text": "[掌声]"}, {"type": "subtitle", "time": 17511.51, "timestamp": "04:51:51", "text": "什么？总之，我们走吧。已经浪费了"}, {"type": "subtitle", "time": 17514.15, "timestamp": "04:51:54", "text": "时间过得很慢。是的，这些岩石有"}]
[{"type": "subtitle", "time": 15842.309, "timestamp": "04:24:02", "text": "[掌声]"}, {"type": "subtitle", "time": 15861.389, "timestamp": "04:24:21", "text": "魔术师。 Kawai最近怎么样？我正在做"}, {"type": "subtitle", "time": 15864.229, "timestamp": "04:24:24", "text": "好的。承受痛苦，并尽力而为"}, {"type": "subtitle", "time": 15865.71, "timestamp": "04:24:25", "text": "吃"}, {"type": "subtitle", "time": 15869.95, "timestamp": "04:24:29", "text": "晚餐。我是指午餐。我的天哪，我"}, {"type": "subtitle", "time": 15873.67, "timestamp": "04:24:33", "text": "一直说错。"}, {"type": "subtitle", "time": 15876.03, "timestamp": "04:24:36", "text": "最好四处看看。看"}, {"type": "subtitle", "time": 15879.11, "timestamp": "04:24:39", "text": "关于信件。"}, {"type": "subtitle", "time": 15881.429, "timestamp": "04:24:41", "text": "霍克汉姆家族的故事就到此为止了。太太。"}]
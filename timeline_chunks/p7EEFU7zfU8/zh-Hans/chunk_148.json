[{"type": "subtitle", "time": 8894.23, "timestamp": "02:28:14", "text": "我的天哪。我只有一份。我需要"}, {"type": "subtitle", "time": 8897.27, "timestamp": "02:28:17", "text": "我需要制定策略。"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "制定策略。我杀了他。我杀了"}, {"type": "subtitle", "time": 8910.79, "timestamp": "02:28:30", "text": "好的。好的。好的。我是"}, {"type": "subtitle", "time": 8913.55, "timestamp": "02:28:33", "text": "只是"}, {"type": "subtitle", "time": 8916.07, "timestamp": "02:28:36", "text": "好的。我仍然相信我战胜了"}, {"type": "subtitle", "time": 8918.99, "timestamp": "02:28:38", "text": "我自己动手做灰烬风笛。是的，你做到了。"}, {"type": "subtitle", "time": 8921.79, "timestamp": "02:28:41", "text": "迪奥。凭借……的力量"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "魔法。等等，我在哪里杀死了黑暗？"}, {"type": "subtitle", "time": 8926.71, "timestamp": "02:28:46", "text": "巫师？"}, {"type": "subtitle", "time": 8929.67, "timestamp": "02:28:49", "text": "我的战利品在哪里？迪奥，我杀了一个"}, {"type": "subtitle", "time": 8932.15, "timestamp": "02:28:52", "text": "强大的敌人。你应该给予"}, {"type": "subtitle", "time": 8939.309, "timestamp": "02:28:59", "text": "大家好，小鸟们。哦不，是"}]
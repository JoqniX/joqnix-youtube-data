[{"type": "subtitle", "time": 14226.189, "timestamp": "03:57:06", "text": "真可惜你这么……"}, {"type": "subtitle", "time": 14229.389, "timestamp": "03:57:09", "text": "犯规并带他们来"}, {"type": "subtitle", "time": 14232.55, "timestamp": "03:57:12", "text": "哦，是的。"}, {"type": "subtitle", "time": 14235.91, "timestamp": "03:57:15", "text": "我真的没清理过这个地方，但是"}, {"type": "subtitle", "time": 14242.51, "timestamp": "03:57:22", "text": "不是？让我们做得更多"}, {"type": "subtitle", "time": 14245.51, "timestamp": "03:57:25", "text": "敌人。我需要我的战斗经验"}, {"type": "subtitle", "time": 14267.71, "timestamp": "03:57:47", "text": "那里。你好呀。还有一个"}, {"type": "subtitle", "time": 14274.07, "timestamp": "03:57:54", "text": "你不应该去偷哥布林。"}, {"type": "subtitle", "time": 14278.63, "timestamp": "03:57:58", "text": "如果舵被别人偷走了，你也应该偷吗？"}]
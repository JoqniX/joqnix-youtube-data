[{"type": "subtitle", "time": 7261.189, "timestamp": "02:01:01", "text": "胸部。我的天，满了。哦，等等。嗯，"}, {"type": "subtitle", "time": 7263.669, "timestamp": "02:01:03", "text": "让我先扔掉一些东西。"}, {"type": "subtitle", "time": 7265.39, "timestamp": "02:01:05", "text": "我会扔掉"}, {"type": "subtitle", "time": 7274.39, "timestamp": "02:01:14", "text": "我不知道我做了什么。你在开玩笑吧"}, {"type": "subtitle", "time": 7278.589, "timestamp": "02:01:18", "text": "我？这一切都只是为了一个蓝色物品。哦，我的"}, {"type": "subtitle", "time": 7282.75, "timestamp": "02:01:22", "text": "上帝。这款游戏并不慷慨，因为它"}, {"type": "subtitle", "time": 7285.55, "timestamp": "02:01:25", "text": "似乎如此。"}, {"type": "subtitle", "time": 7289.07, "timestamp": "02:01:29", "text": "什么？我有点想彻底完成"}, {"type": "subtitle", "time": 7293.73, "timestamp": "02:01:33", "text": "这。我想玩高价野猪。"}, {"type": "subtitle", "time": 7305.43, "timestamp": "02:01:45", "text": "哦，不知何故，它变成了"}, {"type": "subtitle", "time": 7319.99, "timestamp": "02:01:59", "text": "歌曲。我真的至少会得到一个"}]
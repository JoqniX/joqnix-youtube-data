[{"type": "subtitle", "time": 7512.149, "timestamp": "02:05:12", "text": "揭秘。很多培根。我从来没有过"}, {"type": "subtitle", "time": 7516.35, "timestamp": "02:05:16", "text": "我这辈子只吃过培根。所以有一天我"}, {"type": "subtitle", "time": 7526.55, "timestamp": "02:05:26", "text": "熏肉。 H：那是我一直以来的愿望之一，就像……"}, {"type": "subtitle", "time": 7529.669, "timestamp": "02:05:29", "text": "还有很多食物我没吃过。"}, {"type": "subtitle", "time": 7531.55, "timestamp": "02:05:31", "text": "曾经吃过"}, {"type": "subtitle", "time": 7533.629, "timestamp": "02:05:33", "text": "前。所以"}, {"type": "subtitle", "time": 7536.109, "timestamp": "02:05:36", "text": "是的。是的。"}, {"type": "subtitle", "time": 7538.95, "timestamp": "02:05:38", "text": "你好。欢迎，早上好！"}, {"type": "subtitle", "time": 7540.51, "timestamp": "02:05:40", "text": "快乐的"}, {"type": "subtitle", "time": 7543.709, "timestamp": "02:05:43", "text": "天。希望你一切都好。"}, {"type": "subtitle", "time": 7551.39, "timestamp": "02:05:51", "text": "你好。一个袋子。"}, {"type": "subtitle", "time": 7554.55, "timestamp": "02:05:54", "text": "好的。哦，原来是僵尸。"}]
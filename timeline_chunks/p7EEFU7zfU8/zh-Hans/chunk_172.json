[{"type": "subtitle", "time": 10321.95, "timestamp": "02:52:01", "text": "他就像啪的一声消失了一样。"}, {"type": "subtitle", "time": 10337.19, "timestamp": "02:52:17", "text": "现在。城堡一定相当……"}, {"type": "subtitle", "time": 10340.55, "timestamp": "02:52:20", "text": "在当时，它显得庄严典雅。"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "俯瞰霍格沃茨。好的，所以这个"}, {"type": "subtitle", "time": 10353.63, "timestamp": "02:52:33", "text": "树。"}, {"type": "subtitle", "time": 10362.23, "timestamp": "02:52:42", "text": "那里。这是一位绵羊女王。绵羊"}, {"type": "subtitle", "time": 10366.07, "timestamp": "02:52:46", "text": "绵羊绵羊。很抱歉我刚才那样攻击别人。"}, {"type": "subtitle", "time": 10368.55, "timestamp": "02:52:48", "text": "你想吃点东西吗？问号。等待，"}]
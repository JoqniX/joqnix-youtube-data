[{"type": "subtitle", "time": 10444.79, "timestamp": "02:54:04", "text": "勒维奥萨。哦，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 10446.95, "timestamp": "02:54:06", "text": "等等，等等。我忘了，我忘了"}, {"type": "subtitle", "time": 10451.86, "timestamp": "02:54:11", "text": "实际上。将袋子套在"}, {"type": "subtitle", "time": 10458.91, "timestamp": "02:54:18", "text": "这里。过来，"}, {"type": "subtitle", "time": 10462.389, "timestamp": "02:54:22", "text": "迪翁。耶。已购得的那一个。我是说你"}, {"type": "subtitle", "time": 10473.95, "timestamp": "02:54:33", "text": "[掌声]"}, {"type": "subtitle", "time": 10478.13, "timestamp": "02:54:38", "text": "它。谁获得了"}, {"type": "subtitle", "time": 10491.19, "timestamp": "02:54:51", "text": "第四个出现时获得的？不"}, {"type": "subtitle", "time": 10493.59, "timestamp": "02:54:53", "text": "谁都不会相信这件事。"}]
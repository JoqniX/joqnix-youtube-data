[{"type": "subtitle", "time": 20222.548, "timestamp": "05:37:02", "text": "文件夹。就像我应该喜欢的那样"}, {"type": "subtitle", "time": 20225.51, "timestamp": "05:37:05", "text": "就像有索具一样。所以就像我想要的那样"}, {"type": "subtitle", "time": 20228.07, "timestamp": "05:37:08", "text": "想做动画，但是，嗯，我只是"}, {"type": "subtitle", "time": 20231.43, "timestamp": "05:37:11", "text": "目前在体重榜上。"}, {"type": "subtitle", "time": 20234.708, "timestamp": "05:37:14", "text": "迫不及待想看到你首次亮相"}, {"type": "subtitle", "time": 20237.27, "timestamp": "05:37:17", "text": "模型什么的都齐全，对吧？"}, {"type": "subtitle", "time": 20239.51, "timestamp": "05:37:19", "text": "呃，我的意思是，我觉得我不会……"}, {"type": "subtitle", "time": 20242.52, "timestamp": "05:37:22", "text": "实际上，那就是"}, {"type": "subtitle", "time": 20244.788, "timestamp": "05:37:24", "text": "[音乐]"}, {"type": "subtitle", "time": 20254.07, "timestamp": "05:37:34", "text": "哦，是的。嗯……呃……其中一个……"}, {"type": "subtitle", "time": 20256.31, "timestamp": "05:37:36", "text": "我有一些关于流媒体的想法，就像我一样。"}, {"type": "subtitle", "time": 20259.51, "timestamp": "05:37:39", "text": "阅读网络歌曲。啊，是的。唯一"}, {"type": "subtitle", "time": 20263.43, "timestamp": "05:37:43", "text": "是的。比如，直播可以吗？"}, {"type": "subtitle", "time": 20264.948, "timestamp": "05:37:44", "text": "它？"}, {"type": "subtitle", "time": 20267.19, "timestamp": "05:37:47", "text": "就是这样。这不就像版权问题吗？"}, {"type": "subtitle", "time": 20270.548, "timestamp": "05:37:50", "text": "我能从《全知读者》中阅读吗？"}, {"type": "subtitle", "time": 20273.51, "timestamp": "05:37:53", "text": "这里？这样可以吗？我见过一个"}, {"type": "subtitle", "time": 20277.75, "timestamp": "05:37:57", "text": "主播们会这么做。我认为除非"}]
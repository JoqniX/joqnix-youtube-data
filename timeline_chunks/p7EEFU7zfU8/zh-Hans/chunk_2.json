[{"type": "subtitle", "time": 124.27, "timestamp": "00:02:04", "text": "你这家伙"}, {"type": "subtitle", "time": 127.63, "timestamp": "00:02:07", "text": "你看他们说话的方式就是这样"}, {"type": "subtitle", "time": 130.15, "timestamp": "00:02:10", "text": "你知道吗，他们就像是老年人。"}, {"type": "subtitle", "time": 132.39, "timestamp": "00:02:12", "text": "而且他们看起来也很像大男子主义者。"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "嗓音。而且你可以知道它很年轻"}, {"type": "subtitle", "time": 162.55, "timestamp": "00:02:42", "text": "仅凭声音就能判断出这个年轻人。我"}, {"type": "subtitle", "time": 164.67000000000002, "timestamp": "00:02:44", "text": "不知道"}]
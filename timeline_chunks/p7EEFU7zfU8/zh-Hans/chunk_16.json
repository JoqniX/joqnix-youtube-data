[{"type": "subtitle", "time": 966.47, "timestamp": "00:16:06", "text": "耻辱。为什么我不能？说实话，我没有"}, {"type": "subtitle", "time": 968.79, "timestamp": "00:16:08", "text": "知道哪个是正确答案。我只是要走了"}, {"type": "subtitle", "time": 971.23, "timestamp": "00:16:11", "text": "飞向天空"}, {"type": "subtitle", "time": 974.47, "timestamp": "00:16:14", "text": "它。为什么这件事会双重发生"}, {"type": "subtitle", "time": 977.269, "timestamp": "00:16:17", "text": "冒号、分号之类的？为什么是"}, {"type": "subtitle", "time": 979.829, "timestamp": "00:16:19", "text": "这里有分号吗？这是什么意思？"}, {"type": "subtitle", "time": 983.22, "timestamp": "00:16:23", "text": "任何事物？为什么是这个订单？"}, {"type": "subtitle", "time": 985.629, "timestamp": "00:16:25", "text": "[音乐]"}, {"type": "subtitle", "time": 988.55, "timestamp": "00:16:28", "text": "不同的？这也一样。为什么是"}, {"type": "subtitle", "time": 990.829, "timestamp": "00:16:30", "text": "时间跌至谷底，而现在正处于……"}, {"type": "subtitle", "time": 997.91, "timestamp": "00:16:37", "text": "A. 我觉得这……基于这个"}, {"type": "subtitle", "time": 1000.189, "timestamp": "00:16:40", "text": "格式将是"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "看来一切都一样了。"}]
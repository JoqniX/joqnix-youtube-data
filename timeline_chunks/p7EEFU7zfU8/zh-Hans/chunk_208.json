[{"type": "subtitle", "time": 12480.07, "timestamp": "03:28:00", "text": "确保这些牲畜安全无恙"}, {"type": "subtitle", "time": 12482.309, "timestamp": "03:28:02", "text": "得到照顾。无法保证这一点"}, {"type": "subtitle", "time": 12485.349, "timestamp": "03:28:05", "text": "这些潜在业主中的一些人。现在，"}, {"type": "subtitle", "time": 12487.03, "timestamp": "03:28:07", "text": "为什么不好好四处看看呢？"}, {"type": "subtitle", "time": 12489.11, "timestamp": "03:28:09", "text": "股票价格时刻都在波动，而且不仅仅是"}, {"type": "subtitle", "time": 12491.59, "timestamp": "03:28:11", "text": "因为它们会消失。最好始终"}, {"type": "subtitle", "time": 12493.429, "timestamp": "03:28:13", "text": "有空的时候就过来买东西。"}, {"type": "subtitle", "time": 12496.229, "timestamp": "03:28:16", "text": "在它们用完之前。好的。他们"}, {"type": "subtitle", "time": 12498.47, "timestamp": "03:28:18", "text": "过去确实如此。"}, {"type": "subtitle", "time": 12501.11, "timestamp": "03:28:21", "text": "[笑声]"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "谢谢。我会占用你所有的时间"}, {"type": "subtitle", "time": 12505.429, "timestamp": "03:28:25", "text": "需要。好的。感谢您的驻足。"}, {"type": "subtitle", "time": 12509.19, "timestamp": "03:28:29", "text": "经过。非常荣幸您能光临。"}, {"type": "subtitle", "time": 12515.91, "timestamp": "03:28:35", "text": "现在？哪些类型的动物副产品"}, {"type": "subtitle", "time": 12517.51, "timestamp": "03:28:37", "text": "您是否正在考虑收购？我是一名"}, {"type": "subtitle", "time": 12520.15, "timestamp": "03:28:40", "text": "卖家的东西。我不介意卖。"}, {"type": "subtitle", "time": 12522.389, "timestamp": "03:28:42", "text": "为特定客户提供的服务。你知道吗"}, {"type": "subtitle", "time": 12523.78, "timestamp": "03:28:43", "text": "在哪里可以找到"}, {"type": "subtitle", "time": 12533.309, "timestamp": "03:28:53", "text": "我？看看这些钱。哦，我的"}]
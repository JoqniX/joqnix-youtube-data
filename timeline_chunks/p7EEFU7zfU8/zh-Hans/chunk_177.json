[{"type": "subtitle", "time": 10623.11, "timestamp": "02:57:03", "text": "你好呀。你好，迪。这是"}, {"type": "subtitle", "time": 10625.429, "timestamp": "02:57:05", "text": "你提到的清理工作？这是。月亮"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "碳水化合物聚集在大树附近"}, {"type": "subtitle", "time": 10630.63, "timestamp": "02:57:10", "text": "前面的螺旋图案，但在下面"}, {"type": "subtitle", "time": 10634.07, "timestamp": "02:57:14", "text": "月光。所以很遗憾，"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "除非你有办法加快速度，"}, {"type": "subtitle", "time": 10639.269, "timestamp": "02:57:19", "text": "你有时可能需要等到"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "夜幕降临时可以看到它们。嗯？克洛。将"}, {"type": "subtitle", "time": 10645.99, "timestamp": "02:57:25", "text": "那你去找辆月球车吧。德会"}, {"type": "subtitle", "time": 10648.63, "timestamp": "02:57:28", "text": "期待您的归来。你好。他要走了"}, {"type": "subtitle", "time": 10651.63, "timestamp": "02:57:31", "text": "打个响指，然后"}, {"type": "subtitle", "time": 10662.469, "timestamp": "02:57:42", "text": "你好。夜幕降临，迪克依然……"}, {"type": "subtitle", "time": 10666.15, "timestamp": "02:57:46", "text": "这里。哦，他正在耐心等待。"}, {"type": "subtitle", "time": 10669.79, "timestamp": "02:57:49", "text": "我们。我太高兴了。我想抱抱它"}, {"type": "subtitle", "time": 10673.309, "timestamp": "02:57:53", "text": "斗牛士。月亮"}, {"type": "subtitle", "time": 10676.349, "timestamp": "02:57:56", "text": "车。一，"}]
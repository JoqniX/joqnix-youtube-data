[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "我只希望我们有足够的空间。"}, {"type": "subtitle", "time": 11104.309, "timestamp": "03:05:04", "text": "全部。是的，迪也希望如此。但"}, {"type": "subtitle", "time": 11106.71, "timestamp": "03:05:06", "text": "如果空间不够用了，皮克夫人"}, {"type": "subtitle", "time": 11109.59, "timestamp": "03:05:09", "text": "在霍格莫的育雏和窥视处会有所帮助"}, {"type": "subtitle", "time": 11112.469, "timestamp": "03:05:12", "text": "为它们找到安全的家。任何野兽"}, {"type": "subtitle", "time": 11115.03, "timestamp": "03:05:15", "text": "房间容不下？是的，她很有名。"}, {"type": "subtitle", "time": 11117.59, "timestamp": "03:05:17", "text": "感谢他们帮助照顾需要帮助的动物，"}, {"type": "subtitle", "time": 11119.75, "timestamp": "03:05:19", "text": "她会给你一个合理的价格。"}, {"type": "subtitle", "time": 11122.07, "timestamp": "03:05:22", "text": "他们。好的，那些我们可以卖掉。好的。"}, {"type": "subtitle", "time": 11124.63, "timestamp": "03:05:24", "text": "喂养得当、毛发整洁的牲畜会"}, {"type": "subtitle", "time": 11126.75, "timestamp": "03:05:26", "text": "为您提供宝贵的魔法"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "材料，例如蓬松的皮毛，用于"}, {"type": "subtitle", "time": 11132.63, "timestamp": "03:05:32", "text": "例子。如果你收集一些魔法"}, {"type": "subtitle", "time": 11134.79, "timestamp": "03:05:34", "text": "我们可以展示你们野兽身上的材料"}, {"type": "subtitle", "time": 11136.95, "timestamp": "03:05:36", "text": "教你如何使用它们。如何使用？非常"}, {"type": "subtitle", "time": 11138.79, "timestamp": "03:05:38", "text": "出色地。我到时候会通知你。"}, {"type": "subtitle", "time": 11142.309, "timestamp": "03:05:42", "text": "一些。是的。"}, {"type": "subtitle", "time": 11145.15, "timestamp": "03:05:45", "text": "我得喂饱你们。"}, {"type": "subtitle", "time": 11146.97, "timestamp": "03:05:46", "text": "不，该喂食了。"}, {"type": "subtitle", "time": 11154.29, "timestamp": "03:05:54", "text": "你。精彩的。"}]
[{"type": "subtitle", "time": 9427.63, "timestamp": "02:37:07", "text": "耶。一会儿"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "森林。是的，我需要多做一些……"}, {"type": "subtitle", "time": 9432.91, "timestamp": "02:37:12", "text": "这"}, {"type": "subtitle", "time": 9437.19, "timestamp": "02:37:17", "text": "部分，否则我就会……我就会那样"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "以前从未阻止过我。"}, {"type": "subtitle", "time": 9441.349, "timestamp": "02:37:21", "text": "你好呀。从……取回了头盔"}, {"type": "subtitle", "time": 9444.309, "timestamp": "02:37:24", "text": "灰烬缠绕者。做得好。这是肯定的"}, {"type": "subtitle", "time": 9447.27, "timestamp": "02:37:27", "text": "为了给兰洛克留下深刻印象。头盔闪闪发光"}, {"type": "subtitle", "time": 9449.99, "timestamp": "02:37:29", "text": "比我想象的还要明亮。这"}, {"type": "subtitle", "time": 9452.71, "timestamp": "02:37:32", "text": "蚀刻图案，轮廓线。"}, {"type": "subtitle", "time": 9461.67, "timestamp": "02:37:41", "text": "LG，它看起来棒极了。我明白你为什么这么说了"}, {"type": "subtitle", "time": 9463.83, "timestamp": "02:37:43", "text": "想把它要回来。你对窃贼做了"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "通过恢复来提供服务。恢复？我"}, {"type": "subtitle", "time": 9467.83, "timestamp": "02:37:47", "text": "我认识很多会杀人的哥布林"}, {"type": "subtitle", "time": 9469.83, "timestamp": "02:37:49", "text": "为此。哦，那我很高兴摆脱了它。"}, {"type": "subtitle", "time": 9472.23, "timestamp": "02:37:52", "text": "我自己做的。是的。谢谢。这应该"}, {"type": "subtitle", "time": 9474.469, "timestamp": "02:37:54", "text": "赢得兰洛克的信任。我会把它带走"}, {"type": "subtitle", "time": 9476.79, "timestamp": "02:37:56", "text": "立即联系他。这可能会分散他的注意力。"}]
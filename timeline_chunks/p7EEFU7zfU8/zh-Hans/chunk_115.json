[{"type": "subtitle", "time": 6903.149, "timestamp": "01:55:03", "text": "这些独特的"}, {"type": "subtitle", "time": 6906.51, "timestamp": "01:55:06", "text": "呃，这是什么？"}, {"type": "subtitle", "time": 6914.39, "timestamp": "01:55:14", "text": "哦，那个平台附近的骷髅头。这"}, {"type": "subtitle", "time": 6916.109, "timestamp": "01:55:16", "text": "颅骨"}, {"type": "subtitle", "time": 6927.39, "timestamp": "01:55:27", "text": "什么平台？平台在哪里？"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "好的。哦，这个地方的灯光好像……"}, {"type": "subtitle", "time": 6948.87, "timestamp": "01:55:48", "text": "就像是在欢迎我一样。欢迎你，人类。"}, {"type": "subtitle", "time": 6950.629, "timestamp": "01:55:50", "text": "哦，女巫。"}, {"type": "subtitle", "time": 6957.669, "timestamp": "01:55:57", "text": "古怪，你喜欢做什么？"}]
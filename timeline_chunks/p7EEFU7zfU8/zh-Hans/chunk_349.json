[{"type": "subtitle", "time": 20941.11, "timestamp": "05:49:01", "text": "因为我用的是 Joy Joy Joy 音效"}, {"type": "subtitle", "time": 20943.51, "timestamp": "05:49:03", "text": "东西。"}, {"type": "subtitle", "time": 20945.91, "timestamp": "05:49:05", "text": "是的。 JSON 究竟是如何工作的？我"}, {"type": "subtitle", "time": 20948.548, "timestamp": "05:49:08", "text": "我其实不太了解它。"}, {"type": "subtitle", "time": 20952.31, "timestamp": "05:49:12", "text": "就像我看到一些人用它时说的那样"}, {"type": "subtitle", "time": 20954.948, "timestamp": "05:49:14", "text": "比如你上YouTube就会看到一些"}, {"type": "subtitle", "time": 20957.91, "timestamp": "05:49:17", "text": "人们使用它。我当时就想，他们为什么会这样？"}, {"type": "subtitle", "time": 20959.83, "timestamp": "05:49:19", "text": "用它吗？然后我意识到，不仅如此。"}, {"type": "subtitle", "time": 20963.11, "timestamp": "05:49:23", "text": "它会显示歌词并教你如何演唱。"}, {"type": "subtitle", "time": 20965.91, "timestamp": "05:49:25", "text": "它还可以保护你免受版权侵权。"}, {"type": "subtitle", "time": 20968.83, "timestamp": "05:49:28", "text": "罢工或其他什么原因，因为就是这样。"}, {"type": "subtitle", "time": 20972.11, "timestamp": "05:49:32", "text": "在“是的”下面，你必须注明出处。"}, {"type": "subtitle", "time": 20975.19, "timestamp": "05:49:35", "text": "妥善处理并拥有"}, {"type": "subtitle", "time": 20978.39, "timestamp": "05:49:38", "text": "关于欢乐骑行的直播水印"}, {"type": "subtitle", "time": 20980.708, "timestamp": "05:49:40", "text": "声音之类的。"}, {"type": "subtitle", "time": 20982.868, "timestamp": "05:49:42", "text": "哦，这很有意思。"}, {"type": "subtitle", "time": 20985.35, "timestamp": "05:49:45", "text": "这是新鲜事。我从来没有真正"}, {"type": "subtitle", "time": 20987.19, "timestamp": "05:49:47", "text": "现在想想，你"}, {"type": "subtitle", "time": 20988.948, "timestamp": "05:49:48", "text": "这么说好像挺好的。"}, {"type": "subtitle", "time": 20990.628, "timestamp": "05:49:50", "text": "很有趣。"}, {"type": "subtitle", "time": 20992.868, "timestamp": "05:49:52", "text": "是的，那样你就可以唱任何你想唱的歌了。"}, {"type": "subtitle", "time": 20996.868, "timestamp": "05:49:56", "text": "例如 Joy Sound 上提供的那些。"}, {"type": "subtitle", "time": 20999.35, "timestamp": "05:49:59", "text": "那首歌其实有很多首歌，不是吗？"}]
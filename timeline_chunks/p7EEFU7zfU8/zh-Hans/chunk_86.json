[{"type": "subtitle", "time": 5167.87, "timestamp": "01:26:07", "text": "那是我可以拿走的熔岩"}, {"type": "subtitle", "time": 5171.709, "timestamp": "01:26:11", "text": "现在。我们在哪里？他们如何如何，多少"}, {"type": "subtitle", "time": 5174.709, "timestamp": "01:26:14", "text": "她让我们走多远？好的，我们是"}, {"type": "subtitle", "time": 5176.83, "timestamp": "01:26:16", "text": "就像这边一样。"}, {"type": "subtitle", "time": 5180.27, "timestamp": "01:26:20", "text": "哦，有意思。好的。"}, {"type": "subtitle", "time": 5182.91, "timestamp": "01:26:22", "text": "[音乐]"}, {"type": "subtitle", "time": 5186.95, "timestamp": "01:26:26", "text": "嗯，就这些。好的。德普尔索。与……交谈"}, {"type": "subtitle", "time": 5190.11, "timestamp": "01:26:30", "text": "西罗娜和三把扫帚。"}, {"type": "subtitle", "time": 5194.229, "timestamp": "01:26:34", "text": "好的。我们又弄到了一些东西。"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "我觉得这款游戏需要……"}, {"type": "subtitle", "time": 5200.75, "timestamp": "01:26:40", "text": "提升技能"}, {"type": "subtitle", "time": 5204.709, "timestamp": "01:26:44", "text": "老虎机，但有些人会说，“哦，"}, {"type": "subtitle", "time": 5207.91, "timestamp": "01:26:47", "text": "“骑师森林过度杀戮迪奥娜。”但是"}, {"type": "subtitle", "time": 5211.07, "timestamp": "01:26:51", "text": "东西太多了。"}, {"type": "subtitle", "time": 5213.31, "timestamp": "01:26:53", "text": "我是"}, {"type": "subtitle", "time": 5216.39, "timestamp": "01:26:56", "text": "等等，为什么我会感到脉搏跳动？"}, {"type": "subtitle", "time": 5219.07, "timestamp": "01:26:59", "text": "又是这里？"}]
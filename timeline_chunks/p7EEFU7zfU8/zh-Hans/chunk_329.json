[{"type": "subtitle", "time": 19741.03, "timestamp": "05:29:01", "text": "[音乐]"}, {"type": "subtitle", "time": 19743.43, "timestamp": "05:29:03", "text": "就好像这是最难的部分一样"}, {"type": "subtitle", "time": 19745.67, "timestamp": "05:29:05", "text": "在Exa中写作的真正意义在于你并不真的"}, {"type": "subtitle", "time": 19748.35, "timestamp": "05:29:08", "text": "除了你喜欢的东西之外，还要记住其他事情。"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "重复，就像我喜欢说很多话一样。"}, {"type": "subtitle", "time": 19755.43, "timestamp": "05:29:15", "text": "我就是这样记住的，而不是通过写作。"}, {"type": "subtitle", "time": 19757.91, "timestamp": "05:29:17", "text": "是的，那确实很难，只有"}, {"type": "subtitle", "time": 19759.35, "timestamp": "05:29:19", "text": "我喜欢写的东西就像"}, {"type": "subtitle", "time": 19763.11, "timestamp": "05:29:23", "text": "公式或者任何类似的东西"}, {"type": "subtitle", "time": 19772.39, "timestamp": "05:29:32", "text": "就像你写吻的时候，就像我的"}, {"type": "subtitle", "time": 19774.628, "timestamp": "05:29:34", "text": "朋友们就像在读汉字一样。"}, {"type": "subtitle", "time": 19777.51, "timestamp": "05:29:37", "text": "感觉就像你还好吗？你能……"}, {"type": "subtitle", "time": 19781.19, "timestamp": "05:29:41", "text": "记得从 kis 阅读 kis 我那里得到的一切"}, {"type": "subtitle", "time": 19784.23, "timestamp": "05:29:44", "text": "我汉字很差，看到那个我就想："}, {"type": "subtitle", "time": 19787.75, "timestamp": "05:29:47", "text": "我是个离家出走的女人，但我会尽力而为"}, {"type": "subtitle", "time": 19790.07, "timestamp": "05:29:50", "text": "阅读它就像尝试理解……"}, {"type": "subtitle", "time": 19793.47, "timestamp": "05:29:53", "text": "该符号的含义"}, {"type": "subtitle", "time": 19796.788, "timestamp": "05:29:56", "text": "嗯，呃，现在好像是柯里格咖啡机之类的了。"}, {"type": "subtitle", "time": 19799.11, "timestamp": "05:29:59", "text": "我现在把所有基本知识都忘光了。"}]
[{"type": "subtitle", "time": 5643.669, "timestamp": "01:34:03", "text": "相信你。好的。嗯，我可能知道"}, {"type": "subtitle", "time": 5646.07, "timestamp": "01:34:06", "text": "这或许对我们俩都有帮助。离开"}, {"type": "subtitle", "time": 5648.79, "timestamp": "01:34:08", "text": "让兰洛克向他吐露他的计划"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "我。我在听。多年前，一场令人发指的"}, {"type": "subtitle", "time": 5655.189, "timestamp": "01:34:15", "text": "女巫偷走了一件神圣的哥布林遗物。谣言"}, {"type": "subtitle", "time": 5657.39, "timestamp": "01:34:17", "text": "据说它现在安放在她那里。"}, {"type": "subtitle", "time": 5660.629, "timestamp": "01:34:20", "text": "墓穴中的石棺只能通过以下方式进入："}, {"type": "subtitle", "time": 5662.83, "timestamp": "01:34:22", "text": "巫师类型。巫师"}, {"type": "subtitle", "time": 5666.229, "timestamp": "01:34:26", "text": "之前有点闹矛盾。是的，"}, {"type": "subtitle", "time": 5668.95, "timestamp": "01:34:28", "text": "你不会因为日食而死。"}, {"type": "subtitle", "time": 5670.75, "timestamp": "01:34:30", "text": "之间"}, {"type": "subtitle", "time": 5674.95, "timestamp": "01:34:34", "text": "明天，然后哦，好的。很好。"}, {"type": "subtitle", "time": 5676.95, "timestamp": "01:34:36", "text": "如果你答应，我就去取回那件圣物。"}, {"type": "subtitle", "time": 5679.11, "timestamp": "01:34:39", "text": "向我分享兰洛克的计划。我们"}, {"type": "subtitle", "time": 5681.83, "timestamp": "01:34:41", "text": "他们需要彼此信任。我就是"}, {"type": "subtitle", "time": 5684.31, "timestamp": "01:34:44", "text": "你不会带着圣物逃跑的，"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "我会把我学到的东西分享给你。收集"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "您可能需要的任何物资，并满足"}, {"type": "subtitle", "time": 5692.709, "timestamp": "01:34:52", "text": "我在女巫墓附近。"}]
[{"type": "subtitle", "time": 6304.51, "timestamp": "01:45:04", "text": "你自己？我可以给自己施个魔法吗？"}, {"type": "subtitle", "time": 6312.669, "timestamp": "01:45:12", "text": "必须有"}, {"type": "subtitle", "time": 6329.27, "timestamp": "01:45:29", "text": "所以我觉得我不能站在我这边。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "不，我不能。好吧，我做不到。呃，是"}, {"type": "subtitle", "time": 6335.75, "timestamp": "01:45:35", "text": "某物。总比没有强。这是"}, {"type": "subtitle", "time": 6338.189, "timestamp": "01:45:38", "text": "某物。这是"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "疼痛。等等，等等，等等，等等，等等。所以，我"}, {"type": "subtitle", "time": 6344.149, "timestamp": "01:45:44", "text": "站在这里。问号。"}, {"type": "subtitle", "time": 6352.669, "timestamp": "01:45:52", "text": "击退。"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "不。我该如何才能爬到顶端？"}]
[{"type": "subtitle", "time": 10399.349, "timestamp": "02:53:19", "text": "你好，迪。我们继续吗？是的。"}, {"type": "subtitle", "time": 10401.75, "timestamp": "02:53:21", "text": "好的。迪伊很担心你。什么"}, {"type": "subtitle", "time": 10403.67, "timestamp": "02:53:23", "text": "这片区域偷猎者那么多？我"}, {"type": "subtitle", "time": 10406.469, "timestamp": "02:53:26", "text": "飞走了。我们应该抓紧时间。这份工作"}, {"type": "subtitle", "time": 10409.269, "timestamp": "02:53:29", "text": "它们就在这棵大树上。"}, {"type": "subtitle", "time": 10412.15, "timestamp": "02:53:32", "text": "很有帮助。德见过莱维奥索过去的样子"}, {"type": "subtitle", "time": 10414.469, "timestamp": "02:53:34", "text": "飞行缓慢的野兽。"}, {"type": "subtitle", "time": 10420.79, "timestamp": "02:53:40", "text": "然后我就要去拯救一份工作了。好的"}, {"type": "subtitle", "time": 10427.59, "timestamp": "02:53:47", "text": "[音乐]"}, {"type": "subtitle", "time": 10429.07, "timestamp": "02:53:49", "text": "就是那个。"}, {"type": "subtitle", "time": 10432.63, "timestamp": "02:53:52", "text": "嗯？勒维奥萨。"}, {"type": "subtitle", "time": 10434.75, "timestamp": "02:53:54", "text": "Leviosa，这就是"}, {"type": "subtitle", "time": 10438.11, "timestamp": "02:53:58", "text": "勒维奥萨。羽加迪姆·勒维奥萨。好的，明白了。"}]
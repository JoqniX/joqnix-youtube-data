[{"type": "subtitle", "time": 6180.109, "timestamp": "01:43:00", "text": "你今天是怎么找到我的？"}, {"type": "subtitle", "time": 6183.669, "timestamp": "01:43:03", "text": "杰夫罗？为什么你总是含糊不清地说些什么？"}, {"type": "subtitle", "time": 6187.229, "timestamp": "01:43:07", "text": "混合？我不知道。这是……"}, {"type": "subtitle", "time": 6192.35, "timestamp": "01:43:12", "text": "我。说到这，真是痛苦不堪。"}, {"type": "subtitle", "time": 6195.06, "timestamp": "01:43:15", "text": "那。这是……"}, {"type": "subtitle", "time": 6196.59, "timestamp": "01:43:16", "text": "[音乐]"}, {"type": "subtitle", "time": 6201.669, "timestamp": "01:43:21", "text": "我。我有个表亲，呃，英语是"}, {"type": "subtitle", "time": 6204.709, "timestamp": "01:43:24", "text": "这不是我的母语。确实如此。"}, {"type": "subtitle", "time": 6207.87, "timestamp": "01:43:27", "text": "权力和……的原因之一是"}, {"type": "subtitle", "time": 6210.55, "timestamp": "01:43:30", "text": "我认为它可以旋转。是的，就是这样。"}, {"type": "subtitle", "time": 6211.629, "timestamp": "01:43:31", "text": "喜欢"}, {"type": "subtitle", "time": 6214.709, "timestamp": "01:43:34", "text": "嗯，我发音有点困难。"}, {"type": "subtitle", "time": 6217.47, "timestamp": "01:43:37", "text": "还有一些词语。加入它"}, {"type": "subtitle", "time": 6221.07, "timestamp": "01:43:41", "text": "疼痛。我也是姆布拉人。"}, {"type": "subtitle", "time": 6231.229, "timestamp": "01:43:51", "text": "独自的。好的。嗯，怎么做？"}, {"type": "subtitle", "time": 6235.51, "timestamp": "01:43:55", "text": "我漂浮起来了？"}]
[{"type": "subtitle", "time": 17101.35, "timestamp": "04:45:01", "text": "我会救任何需要帮助的人，只要他们身在……"}, {"type": "subtitle", "time": 17113.11, "timestamp": "04:45:13", "text": "康弗林戈。"}, {"type": "subtitle", "time": 17118.47, "timestamp": "04:45:18", "text": "等等，这头野兽。我这就去拿。"}, {"type": "subtitle", "time": 17138.47, "timestamp": "04:45:38", "text": "那儿有胡子。我不会受伤"}, {"type": "subtitle", "time": 17152.628, "timestamp": "04:45:52", "text": "我懂了。我听到了同伴的声音。你"}, {"type": "subtitle", "time": 17155.51, "timestamp": "04:45:55", "text": "需要。"}]
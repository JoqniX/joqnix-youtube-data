[{"type": "subtitle", "time": 20343.07, "timestamp": "05:39:03", "text": "除此之外，就只有我一个人了。是的。"}, {"type": "subtitle", "time": 20346.11, "timestamp": "05:39:06", "text": "是的。你正走在……的道路上"}, {"type": "subtitle", "time": 20349.91, "timestamp": "05:39:09", "text": "首次亮相。 M：是啊，就像我可能会做的那样"}, {"type": "subtitle", "time": 20352.868, "timestamp": "05:39:12", "text": "我感觉，你知道，大概1000美元吧。"}, {"type": "subtitle", "time": 20357.03, "timestamp": "05:39:17", "text": "订阅者之类的东西也行。是的，"}, {"type": "subtitle", "time": 20367.19, "timestamp": "05:39:27", "text": "我想直播，呃，就像我一样。"}, {"type": "subtitle", "time": 20368.788, "timestamp": "05:39:28", "text": "阅读网络歌曲。那会有点……"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "乐趣。是的，我认为只要你"}, {"type": "subtitle", "time": 20374.47, "timestamp": "05:39:34", "text": "不要在直播中显示内容，这是"}, {"type": "subtitle", "time": 20377.03, "timestamp": "05:39:37", "text": "美好的。人们可以像享受ASMR一样享受它。"}, {"type": "subtitle", "time": 20383.628, "timestamp": "05:39:43", "text": "正确的？你没看到吗？"}, {"type": "subtitle", "time": 20385.99, "timestamp": "05:39:45", "text": "研究？我可能需要做些研究。"}, {"type": "subtitle", "time": 20389.15, "timestamp": "05:39:49", "text": "就像有些人喜欢这样做一样"}, {"type": "subtitle", "time": 20394.71, "timestamp": "05:39:54", "text": "演奏这首曲子。所以我不确定"}, {"type": "subtitle", "time": 20398.708, "timestamp": "05:39:58", "text": "[音乐]"}]
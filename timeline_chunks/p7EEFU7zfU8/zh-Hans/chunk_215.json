[{"type": "subtitle", "time": 12901.269, "timestamp": "03:35:01", "text": "你。我一生的挚爱。没有它，我有点迷茫。"}, {"type": "subtitle", "time": 12904.07, "timestamp": "03:35:04", "text": "他。如果你不介意的话，可以收集一些"}, {"type": "subtitle", "time": 12905.99, "timestamp": "03:35:05", "text": "对我来说，鹰群会很乐意。"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "我当然可以试着找一些。"}, {"type": "subtitle", "time": 12918.15, "timestamp": "03:35:18", "text": "你。那太好了。我是"}, {"type": "subtitle", "time": 12919.83, "timestamp": "03:35:19", "text": "担心流动商贩和"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "很想了解更多维根世界的信息"}, {"type": "subtitle", "time": 12924.71, "timestamp": "03:35:24", "text": "药水。塞罗纳还提到，先生"}, {"type": "subtitle", "time": 12926.55, "timestamp": "03:35:26", "text": "斯普尔给她带来了一箱信。"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "他生病的时候。的确如此。 ID"}, {"type": "subtitle", "time": 12932.63, "timestamp": "03:35:32", "text": "几乎被遗忘了。我偶然发现了它"}, {"type": "subtitle", "time": 12935.349, "timestamp": "03:35:35", "text": "就在艾登去世前不久。他希望"}, {"type": "subtitle", "time": 12937.19, "timestamp": "03:35:37", "text": "和塞罗娜一起过一遍"}, {"type": "subtitle", "time": 12940.309, "timestamp": "03:35:40", "text": "一两杯黄油啤酒。那两个人总是"}, {"type": "subtitle", "time": 12943.75, "timestamp": "03:35:43", "text": "就像树枝上的两个弓形卡车司机。艾登"}, {"type": "subtitle", "time": 12945.75, "timestamp": "03:35:45", "text": "他在收集鹰标本时生病了。"}, {"type": "subtitle", "time": 12948.389, "timestamp": "03:35:48", "text": "在他去看她的路上，他结结实实地走了一小堆东西。他做到了"}, {"type": "subtitle", "time": 12951.03, "timestamp": "03:35:51", "text": "在家，但我担心他把盒子掉在了……"}, {"type": "subtitle", "time": 12953.59, "timestamp": "03:35:53", "text": "洞穴。洞穴位于山丘中。"}, {"type": "subtitle", "time": 12956.229, "timestamp": "03:35:56", "text": "就在我们村庄的西南方向。你可以"}, {"type": "subtitle", "time": 12958.71, "timestamp": "03:35:58", "text": "收集鹰群并收集盒子"}]
[{"type": "subtitle", "time": 15960.429, "timestamp": "04:26:00", "text": "我"}, {"type": "subtitle", "time": 15963.189, "timestamp": "04:26:03", "text": "表现？它应该显示帧率，但是"}, {"type": "subtitle", "time": 15972.51, "timestamp": "04:26:12", "text": "诡异的。我降低图形设置了吗？"}, {"type": "subtitle", "time": 15975.79, "timestamp": "04:26:15", "text": "再次？搞什么鬼？它是"}, {"type": "subtitle", "time": 15980.149, "timestamp": "04:26:20", "text": "低。打扰一下。这是超高性能的。什么"}, {"type": "subtitle", "time": 15983.11, "timestamp": "04:26:23", "text": "我喝的是什么？ 4090 之类的。不"}, {"type": "subtitle", "time": 15986.83, "timestamp": "04:26:26", "text": "真奇怪我的电脑为什么这么热"}, {"type": "subtitle", "time": 15995.22, "timestamp": "04:26:35", "text": "什么？我的天啊。"}, {"type": "subtitle", "time": 15996.87, "timestamp": "04:26:36", "text": "[音乐]"}, {"type": "subtitle", "time": 16000.229, "timestamp": "04:26:40", "text": "我希望我有1490拨号盘。一切都将如此"}, {"type": "subtitle", "time": 16009.11, "timestamp": "04:26:49", "text": "要么我得跟那个喷子打一架，要么"}]
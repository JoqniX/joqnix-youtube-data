[{"type": "subtitle", "time": 6723.189, "timestamp": "01:52:03", "text": "不。好吧，我这是在浪费时间。什么？是什么"}, {"type": "subtitle", "time": 6732.31, "timestamp": "01:52:12", "text": "等等，我在墓里找头盔。我是"}, {"type": "subtitle", "time": 6736.589, "timestamp": "01:52:16", "text": "非常非常非常抱歉。我只是要走了"}, {"type": "subtitle", "time": 6741.07, "timestamp": "01:52:21", "text": "去墓穴里寻找"}, {"type": "subtitle", "time": 6744.79, "timestamp": "01:52:24", "text": "头盔。 Hogwise，我很抱歉这么做"}, {"type": "subtitle", "time": 6749.39, "timestamp": "01:52:29", "text": "这。对不起，但我不得不这样做。"}, {"type": "subtitle", "time": 6765.189, "timestamp": "01:52:45", "text": "这。哦，我真是太笨了。等待。"}, {"type": "subtitle", "time": 6772.27, "timestamp": "01:52:52", "text": "回到"}]
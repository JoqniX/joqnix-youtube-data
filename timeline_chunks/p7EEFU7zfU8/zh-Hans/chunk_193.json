[{"type": "subtitle", "time": 11581.269, "timestamp": "03:13:01", "text": "是的。希望你一切都好。我的儿子"}, {"type": "subtitle", "time": 11588.389, "timestamp": "03:13:08", "text": "我用的是魔法织布机，迪。"}, {"type": "subtitle", "time": 11590.87, "timestamp": "03:13:10", "text": "精彩的。我能织出……吗？"}, {"type": "subtitle", "time": 11592.79, "timestamp": "03:13:12", "text": "更强大的魔法注入我的衣服"}, {"type": "subtitle", "time": 11595.429, "timestamp": "03:13:15", "text": "用织布机吗？是的，我会。通过营救"}, {"type": "subtitle", "time": 11598.23, "timestamp": "03:13:18", "text": "更加强大的野兽。好的。为了"}, {"type": "subtitle", "time": 11600.55, "timestamp": "03:13:20", "text": "不过，迪伊现在建议你去探索一下"}, {"type": "subtitle", "time": 11602.95, "timestamp": "03:13:22", "text": "去巴伐利亚博物馆，了解这头野兽"}, {"type": "subtitle", "time": 11607.03, "timestamp": "03:13:27", "text": "你已经获救了。您好，谢谢。"}, {"type": "subtitle", "time": 11609.29, "timestamp": "03:13:29", "text": "谢谢你的帮助，De。"}, {"type": "subtitle", "time": 11617.229, "timestamp": "03:13:37", "text": "我得去吃饭了"}, {"type": "subtitle", "time": 11620.229, "timestamp": "03:13:40", "text": "午餐。哦，我什么都没有。"}, {"type": "subtitle", "time": 11627.91, "timestamp": "03:13:47", "text": "我得去吃午饭了。好的。"}, {"type": "subtitle", "time": 11631.309, "timestamp": "03:13:51", "text": "今天我们还要直播多久？"}, {"type": "subtitle", "time": 11635.2, "timestamp": "03:13:55", "text": "嗯，我们就到此为止吧？"}, {"type": "subtitle", "time": 11637.15, "timestamp": "03:13:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 12067.469, "timestamp": "03:21:07", "text": "哦，来吧，我还年轻。"}, {"type": "subtitle", "time": 12076.67, "timestamp": "03:21:16", "text": "这里。希望我没让你久等。"}, {"type": "subtitle", "time": 12080.75, "timestamp": "03:21:20", "text": "长的。你好。我得到了我的"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "午餐。今天我吃米饭。然后我就"}, {"type": "subtitle", "time": 12087.19, "timestamp": "03:21:27", "text": "例如蔬菜咖喱。我觉得是"}, {"type": "subtitle", "time": 12090.79, "timestamp": "03:21:30", "text": "我猜是豆子，或者豌豆。不，豌豆。我"}, {"type": "subtitle", "time": 12093.59, "timestamp": "03:21:33", "text": "猜猜看尿。佩。不，豆子。是豆子。"}, {"type": "subtitle", "time": 12096.07, "timestamp": "03:21:36", "text": "对，是豆子。然后，然后，然后我就得到了"}, {"type": "subtitle", "time": 12097.63, "timestamp": "03:21:37", "text": "一些"}, {"type": "subtitle", "time": 12100.389, "timestamp": "03:21:40", "text": "虾。对，就像小虾米一样。"}, {"type": "subtitle", "time": 12101.63, "timestamp": "03:21:41", "text": "你"}, {"type": "subtitle", "time": 12105.11, "timestamp": "03:21:45", "text": "知道。是的，我明白了，你呢？"}, {"type": "subtitle", "time": 12107.91, "timestamp": "03:21:47", "text": "那叫什么？嗯，那该怎么称呼呢？"}, {"type": "subtitle", "time": 12112.389, "timestamp": "03:21:52", "text": "再次？呃，那种白色是什么颜色？"}, {"type": "subtitle", "time": 12114.229, "timestamp": "03:21:54", "text": "类似牛奶的东西，但不是牛奶。呃"}, {"type": "subtitle", "time": 12116.59, "timestamp": "03:21:56", "text": "那东西叫什么来着？温和的。"}]
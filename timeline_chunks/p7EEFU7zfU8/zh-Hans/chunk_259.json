[{"type": "subtitle", "time": 15542.189, "timestamp": "04:19:02", "text": "[掌声]"}, {"type": "subtitle", "time": 15547.51, "timestamp": "04:19:07", "text": "抓到那只蟾蜍了。我的新宠物。"}, {"type": "subtitle", "time": 15549.149, "timestamp": "04:19:09", "text": "一切都好"}, {"type": "subtitle", "time": 15561.71, "timestamp": "04:19:21", "text": "反叛。"}, {"type": "subtitle", "time": 15585.63, "timestamp": "04:19:45", "text": "[掌声]"}, {"type": "subtitle", "time": 15588.71, "timestamp": "04:19:48", "text": "上帝。你无处可藏。跑步。但你不能"}, {"type": "subtitle", "time": 15593.71, "timestamp": "04:19:53", "text": "霍华德教授永远不会相信"}]
[{"type": "subtitle", "time": 18308.03, "timestamp": "05:05:08", "text": "美好的。"}, {"type": "subtitle", "time": 18310.83, "timestamp": "05:05:10", "text": "上帝。"}, {"type": "subtitle", "time": 18324.43, "timestamp": "05:05:24", "text": "[音乐]"}, {"type": "subtitle", "time": 18343.628, "timestamp": "05:05:43", "text": "现在？月亮背后的人。"}, {"type": "subtitle", "time": 18346.948, "timestamp": "05:05:46", "text": "呃，好的。外貌。好的。你知道"}, {"type": "subtitle", "time": 18350.23, "timestamp": "05:05:50", "text": "什么？呃，已经四点了。没关系。"}, {"type": "subtitle", "time": 18353.27, "timestamp": "05:05:53", "text": "嗯，我想把这件事做完。一直以来"}, {"type": "subtitle", "time": 18355.15, "timestamp": "05:05:55", "text": "当我"}, {"type": "subtitle", "time": 18358.19, "timestamp": "05:05:58", "text": "一直都有这两个孩子。"}]
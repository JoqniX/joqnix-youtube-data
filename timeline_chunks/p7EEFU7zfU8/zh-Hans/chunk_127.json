[{"type": "subtitle", "time": 7634.75, "timestamp": "02:07:14", "text": "哦，我的"}, {"type": "subtitle", "time": 7637.189, "timestamp": "02:07:17", "text": "天哪，这太糟糕了。情况很糟糕。那很糟糕。"}, {"type": "subtitle", "time": 7638.39, "timestamp": "02:07:18", "text": "那很糟糕。那很糟糕。那很糟糕。"}, {"type": "subtitle", "time": 7643.83, "timestamp": "02:07:23", "text": "坏的。为什么它们不排放任何污染物？"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "损害？你为什么会在这里？"}, {"type": "subtitle", "time": 7659.109, "timestamp": "02:07:39", "text": "爆炸决斗阶段？我该怎么做呢？"}, {"type": "subtitle", "time": 7660.91, "timestamp": "02:07:40", "text": "相互竞争的饲料"}, {"type": "subtitle", "time": 7675.39, "timestamp": "02:07:55", "text": "说谎？你好。你到底是怎么做到的？"}, {"type": "subtitle", "time": 7677.99, "timestamp": "02:07:57", "text": "猜测？我猜想这是……"}, {"type": "subtitle", "time": 7679.99, "timestamp": "02:07:59", "text": "因异样而浮肿。我知道这一点"}]
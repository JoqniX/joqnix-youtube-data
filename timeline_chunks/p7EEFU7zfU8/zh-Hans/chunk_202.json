[{"type": "subtitle", "time": 12120.229, "timestamp": "03:22:00", "text": "等待。凝乳。呃，不，我忘了。是的，差不多"}, {"type": "subtitle", "time": 12123.07, "timestamp": "03:22:03", "text": "像凝乳，但又不像"}, {"type": "subtitle", "time": 12129.55, "timestamp": "03:22:09", "text": "[音乐]"}, {"type": "subtitle", "time": 12133.469, "timestamp": "03:22:13", "text": "出色地。我的天啊。短跑"}, {"type": "subtitle", "time": 12138.91, "timestamp": "03:22:18", "text": "面具。谣言需求。远古魔法"}, {"type": "subtitle", "time": 12142.3, "timestamp": "03:22:22", "text": "供应。哦，"}, {"type": "subtitle", "time": 12167.07, "timestamp": "03:22:47", "text": "一"}, {"type": "subtitle", "time": 12170.15, "timestamp": "03:22:50", "text": "存货。我们这里有很多蜜蜂。我们需要"}, {"type": "subtitle", "time": 12172.11, "timestamp": "03:22:52", "text": "出售"}, {"type": "subtitle", "time": 12178.87, "timestamp": "03:22:58", "text": "一。在我们离开之前，让我们卖掉……"}]
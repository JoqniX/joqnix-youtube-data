[{"type": "subtitle", "time": 19381.35, "timestamp": "05:23:01", "text": "任何事物。打扰了，抱歉。如果"}, {"type": "subtitle", "time": 19384.07, "timestamp": "05:23:04", "text": "我什么都做，就好像我根本不跟他们说话一样。"}, {"type": "subtitle", "time": 19386.948, "timestamp": "05:23:06", "text": "不再有人了。不用担心。不用担心。"}, {"type": "subtitle", "time": 19389.91, "timestamp": "05:23:09", "text": "不用担心。一切都好。"}, {"type": "subtitle", "time": 19392.31, "timestamp": "05:23:12", "text": "是的，已经过去很久了。"}, {"type": "subtitle", "time": 19395.35, "timestamp": "05:23:15", "text": "我喜欢用英语正常交谈。"}, {"type": "subtitle", "time": 19397.35, "timestamp": "05:23:17", "text": "要诚实。"}, {"type": "subtitle", "time": 19404.15, "timestamp": "05:23:24", "text": "我唯一会做的事就是唱歌。"}, {"type": "subtitle", "time": 19406.868, "timestamp": "05:23:26", "text": "并进行编辑。所以，就只有这一件事。"}, {"type": "subtitle", "time": 19409.91, "timestamp": "05:23:29", "text": "我确实会做这些，而且我还在创作一些小说。"}, {"type": "subtitle", "time": 19412.23, "timestamp": "05:23:32", "text": "我现在就像在写自己的小说一样。"}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "所以我现在就像是在策划和行动。"}, {"type": "subtitle", "time": 19420.868, "timestamp": "05:23:40", "text": "我也毕业了。是的，我也毕业了。"}, {"type": "subtitle", "time": 19423.67, "timestamp": "05:23:43", "text": "今年毕业。所以"}, {"type": "subtitle", "time": 19427.11, "timestamp": "05:23:47", "text": "是的，我的执业资格考试结束了。"}, {"type": "subtitle", "time": 19430.55, "timestamp": "05:23:50", "text": "是的，我拿到了最高等级的成绩。"}, {"type": "subtitle", "time": 19432.91, "timestamp": "05:23:52", "text": "好的。那是"}, {"type": "subtitle", "time": 19435.91, "timestamp": "05:23:55", "text": "难的。而分数就像一场游戏。所以，"}]
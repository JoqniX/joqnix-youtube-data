[{"type": "subtitle", "time": 8716.15, "timestamp": "02:25:16", "text": "我的天哪，这威力真大！"}, {"type": "subtitle", "time": 8719.349, "timestamp": "02:25:19", "text": "攻击。你将为你的罪行付出代价。是"}, {"type": "subtitle", "time": 8722.309, "timestamp": "02:25:22", "text": "你确定吗？仅此而已"}, {"type": "subtitle", "time": 8732.389, "timestamp": "02:25:32", "text": "我知道你还在挂断电话。"}, {"type": "subtitle", "time": 8734.95, "timestamp": "02:25:34", "text": "啊哈。后退。糟糕。不，不，不，不。哦，"}, {"type": "subtitle", "time": 8740.469, "timestamp": "02:25:40", "text": "上帝。上帝，上帝，上帝，上帝，上帝，上帝。移动。"}, {"type": "subtitle", "time": 8749.99, "timestamp": "02:25:49", "text": "我的天啊，他们越来越……"}]
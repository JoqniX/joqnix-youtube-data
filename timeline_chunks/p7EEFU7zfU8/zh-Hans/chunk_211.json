[{"type": "subtitle", "time": 12661.349, "timestamp": "03:31:01", "text": "帮我朋友多萝西·斯普拉特尔一个忙"}, {"type": "subtitle", "time": 12665.51, "timestamp": "03:31:05", "text": "在上霍克菲尔德。我不相信"}, {"type": "subtitle", "time": 12668.469, "timestamp": "03:31:08", "text": "她很可爱。她已故的丈夫艾登是"}, {"type": "subtitle", "time": 12671.11, "timestamp": "03:31:11", "text": "我父亲的一位朋友。事实上，我会"}, {"type": "subtitle", "time": 12672.71, "timestamp": "03:31:12", "text": "整个夏天我都和多特和艾登待在一起。"}, {"type": "subtitle", "time": 12675.349, "timestamp": "03:31:15", "text": "我学生时代曾在这里当过服务员。我已经"}, {"type": "subtitle", "time": 12678.15, "timestamp": "03:31:18", "text": "自从艾登去世后，我见过她几次。"}, {"type": "subtitle", "time": 12680.71, "timestamp": "03:31:20", "text": "但最近酒吧太忙了，我"}, {"type": "subtitle", "time": 12684.309, "timestamp": "03:31:24", "text": "没有像我希望的那样细心周到。"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "进去看看她吧。快乐和美好"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "下午。我正在收集原料"}, {"type": "subtitle", "time": 12690.07, "timestamp": "03:31:30", "text": "因为她做得很好"}, {"type": "subtitle", "time": 12692.389, "timestamp": "03:31:32", "text": "下午。而且你可以检索"}, {"type": "subtitle", "time": 12696.15, "timestamp": "03:31:36", "text": "在这个过程中，我也贡献了一份力量。一个盒子"}, {"type": "subtitle", "time": 12702.95, "timestamp": "03:31:42", "text": "我可以试着过去看看。我会尽量去。"}, {"type": "subtitle", "time": 12704.87, "timestamp": "03:31:44", "text": "有时间就去看她。这意味着"}, {"type": "subtitle", "time": 12707.99, "timestamp": "03:31:47", "text": "对我和多萝西来说，世界就是这个世界。艾登是"}, {"type": "subtitle", "time": 12709.349, "timestamp": "03:31:49", "text": "当有人把那箱信件拿给我的时候"}, {"type": "subtitle", "time": 12711.75, "timestamp": "03:31:51", "text": "他生病了。 Dot可以告诉你哪里"}, {"type": "subtitle", "time": 12715.19, "timestamp": "03:31:55", "text": "他可能把它弄掉了。好的。你会"}, {"type": "subtitle", "time": 12717.91, "timestamp": "03:31:57", "text": "找到霍格莫以北的小村庄。"}]
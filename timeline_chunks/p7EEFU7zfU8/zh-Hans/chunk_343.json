[{"type": "subtitle", "time": 20581.27, "timestamp": "05:43:01", "text": "这就是我必须买笔记本电脑的原因。"}, {"type": "subtitle", "time": 20583.67, "timestamp": "05:43:03", "text": "第一的。不，因为我可以直播。"}, {"type": "subtitle", "time": 20585.99, "timestamp": "05:43:05", "text": "音乐、一切、工作和学习"}, {"type": "subtitle", "time": 20588.23, "timestamp": "05:43:08", "text": "一切。"}, {"type": "subtitle", "time": 20591.75, "timestamp": "05:43:11", "text": "是的。他拿到笔记本电脑了吗？还是我？"}, {"type": "subtitle", "time": 20594.23, "timestamp": "05:43:14", "text": "打算买吗？计划从"}, {"type": "subtitle", "time": 20597.11, "timestamp": "05:43:17", "text": "那里。没错，很可能就是你。"}, {"type": "subtitle", "time": 20599.75, "timestamp": "05:43:19", "text": "应该 想要 至少 嗯"}, {"type": "subtitle", "time": 20603.35, "timestamp": "05:43:23", "text": "比如，修复你想要的型号"}, {"type": "subtitle", "time": 20607.35, "timestamp": "05:43:27", "text": "至少在去之前买好。是的。"}, {"type": "subtitle", "time": 20609.43, "timestamp": "05:43:29", "text": "是的。你打算在那里买吗？"}, {"type": "subtitle", "time": 20611.75, "timestamp": "05:43:31", "text": "然后？对，在那儿买吧。所以，"}, {"type": "subtitle", "time": 20613.83, "timestamp": "05:43:33", "text": "学院，本地的学院，"}, {"type": "subtitle", "time": 20616.628, "timestamp": "05:43:36", "text": "他们说他们有一些呃人"}, {"type": "subtitle", "time": 20620.23, "timestamp": "05:43:40", "text": "他们会在我需要的时候帮助我吗？"}, {"type": "subtitle", "time": 20624.23, "timestamp": "05:43:44", "text": "抵达日本后，他们将前往"}, {"type": "subtitle", "time": 20628.548, "timestamp": "05:43:48", "text": "和我一起去商店，我们一起"}, {"type": "subtitle", "time": 20631.31, "timestamp": "05:43:51", "text": "呃，买"}, {"type": "subtitle", "time": 20635.11, "timestamp": "05:43:55", "text": "东西。你好，我是说，打个招呼。"}, {"type": "subtitle", "time": 20637.83, "timestamp": "05:43:57", "text": "在日本购买会更便宜。是的。"}]
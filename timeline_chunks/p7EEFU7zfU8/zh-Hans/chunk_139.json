[{"type": "subtitle", "time": 8340.11, "timestamp": "02:19:00", "text": "我是否属于法定盲人？"}, {"type": "subtitle", "time": 8342.91, "timestamp": "02:19:02", "text": "原谅。我太"}, {"type": "subtitle", "time": 8346.389, "timestamp": "02:19:06", "text": "使困惑。他们怎么没放进去呢？"}, {"type": "subtitle", "time": 8353.79, "timestamp": "02:19:13", "text": "我记得我把那家伙放上去了。"}, {"type": "subtitle", "time": 8358.03, "timestamp": "02:19:18", "text": "门。你怎么能这样？为什么会这样？"}, {"type": "subtitle", "time": 8361.19, "timestamp": "02:19:21", "text": "我的天哪。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "你为什么会在这里？我把你放在了"}, {"type": "subtitle", "time": 8366.03, "timestamp": "02:19:26", "text": "门"}, {"type": "subtitle", "time": 8373.75, "timestamp": "02:19:33", "text": "什么？我的天啊。但无论如何，我们最终"}, {"type": "subtitle", "time": 8376.79, "timestamp": "02:19:36", "text": "把她扔了进去。休息场所。 LG"}, {"type": "subtitle", "time": 8391.91, "timestamp": "02:19:51", "text": "一只死去的灰烬行者。你的同胞必须"}, {"type": "subtitle", "time": 8394.15, "timestamp": "02:19:54", "text": "我已经和好了，我需要移除一些"}]
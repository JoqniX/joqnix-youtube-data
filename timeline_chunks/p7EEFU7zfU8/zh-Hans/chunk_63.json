[{"type": "subtitle", "time": 3782.71, "timestamp": "01:03:02", "text": "嗯，大概八点半左右。但昨天"}, {"type": "subtitle", "time": 3785.75, "timestamp": "01:03:05", "text": "就像我所有的庆祝活动之类的，"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "那些东西都在那里。所以当时"}, {"type": "subtitle", "time": 3791.19, "timestamp": "01:03:11", "text": "受我房东，我以前的邀请"}, {"type": "subtitle", "time": 3794.63, "timestamp": "01:03:14", "text": "房东，我第一个喜欢他的房东"}, {"type": "subtitle", "time": 3799.23, "timestamp": "01:03:19", "text": "在那儿吃吃喝喝。所以我就想，"}, {"type": "subtitle", "time": 3802.39, "timestamp": "01:03:22", "text": "“好吧，我当时真的非常惊讶。”"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "可以从那里吃东西。” 兄弟，这怎么可能"}, {"type": "subtitle", "time": 3809.589, "timestamp": "01:03:29", "text": "我到底是怎么做到的？真是这样"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "奇怪。而在这里，我甚至都无法触碰。"}, {"type": "subtitle", "time": 3815.43, "timestamp": "01:03:35", "text": "三勺米饭。三勺之后"}, {"type": "subtitle", "time": 3818.109, "timestamp": "01:03:38", "text": "看到米饭，我就想，“啊，我不想……”"}, {"type": "subtitle", "time": 3820.789, "timestamp": "01:03:40", "text": "吃。我觉得出问题了。"}, {"type": "subtitle", "time": 3821.87, "timestamp": "01:03:41", "text": "我的"}, {"type": "subtitle", "time": 3824.549, "timestamp": "01:03:44", "text": "肚子。该怎么办？我的肚子不"}, {"type": "subtitle", "time": 3825.71, "timestamp": "01:03:45", "text": "正在听"}, {"type": "subtitle", "time": 3830.39, "timestamp": "01:03:50", "text": "我。这难道不是一件坏事吗？我感觉"}, {"type": "subtitle", "time": 3834.51, "timestamp": "01:03:54", "text": "这样其实很糟糕"}, {"type": "subtitle", "time": 3837.19, "timestamp": "01:03:57", "text": "事物。就像你的肚子不听使唤一样。"}, {"type": "subtitle", "time": 3839.99, "timestamp": "01:03:59", "text": "你知道的，那些乱七八糟的事。你"}]
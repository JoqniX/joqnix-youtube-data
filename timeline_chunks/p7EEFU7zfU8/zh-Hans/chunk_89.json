[{"type": "subtitle", "time": 5342.87, "timestamp": "01:29:02", "text": "mas 找到你了？我也是。什么？你曾是"}, {"type": "subtitle", "time": 5345.35, "timestamp": "01:29:05", "text": "那天我在这里和一个地精交谈过。是的，"}, {"type": "subtitle", "time": 5349.43, "timestamp": "01:29:09", "text": "主上帝。哦，这声音真低沉。我是"}, {"type": "subtitle", "time": 5351.11, "timestamp": "01:29:11", "text": "很高兴听到这个消息。似乎你"}, {"type": "subtitle", "time": 5352.79, "timestamp": "01:29:12", "text": "我和他关系很好。我知道"}, {"type": "subtitle", "time": 5355.189, "timestamp": "01:29:15", "text": "多年来他一直陪伴着他。我等候的时候我们相遇了"}, {"type": "subtitle", "time": 5357.27, "timestamp": "01:29:17", "text": "这里是学生时代的桌子。在我之前很久"}, {"type": "subtitle", "time": 5359.11, "timestamp": "01:29:19", "text": "买下了这处房产。在我购买之前很久"}, {"type": "subtitle", "time": 5360.87, "timestamp": "01:29:20", "text": "这个地方。但那时我们还不是朋友。"}, {"type": "subtitle", "time": 5363.91, "timestamp": "01:29:23", "text": "他对巫师一族的不信任根深蒂固。"}, {"type": "subtitle", "time": 5366.95, "timestamp": "01:29:26", "text": "但现在你们是朋友了。我们是。之前没有"}, {"type": "subtitle", "time": 5368.629, "timestamp": "01:29:28", "text": "好几年没见过他了，他偶尔会来。"}, {"type": "subtitle", "time": 5372.55, "timestamp": "01:29:32", "text": "几个月前。但他认出了我"}, {"type": "subtitle", "time": 5374.629, "timestamp": "01:29:34", "text": "瞬间，这比我能说的还要多。"}, {"type": "subtitle", "time": 5377.03, "timestamp": "01:29:37", "text": "对我的一些同学来说。带走了他们"}, {"type": "subtitle", "time": 5378.55, "timestamp": "01:29:38", "text": "我愣了一下才意识到自己其实是……"}, {"type": "subtitle", "time": 5381.03, "timestamp": "01:29:41", "text": "女巫，不是巫师。并非所有哥布林都是"}, {"type": "subtitle", "time": 5382.629, "timestamp": "01:29:42", "text": "就像兰洛克和他的忠诚追随者一样。哦，是的。"}, {"type": "subtitle", "time": 5384.55, "timestamp": "01:29:44", "text": "女巫是女性，男巫是男性。"}, {"type": "subtitle", "time": 5386.149, "timestamp": "01:29:46", "text": "男性。我们俩都对过去发生的事情感到困惑。"}, {"type": "subtitle", "time": 5388.229, "timestamp": "01:29:48", "text": "正在进行中。那样的话，我想谈谈。"}, {"type": "subtitle", "time": 5391.189, "timestamp": "01:29:51", "text": "特别是和他谈兰德罗克的事。"}, {"type": "subtitle", "time": 5393.51, "timestamp": "01:29:53", "text": "我该去哪里找他？我猜你的"}, {"type": "subtitle", "time": 5395.27, "timestamp": "01:29:55", "text": "我的兴趣与我听到的传闻有关。"}, {"type": "subtitle", "time": 5397.11, "timestamp": "01:29:57", "text": "听说兰德罗克公司与我们合作"}, {"type": "subtitle", "time": 5399.51, "timestamp": "01:29:59", "text": "朋友鲁克伍德。这是。如果他不是"}]
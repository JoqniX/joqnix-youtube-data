[{"type": "subtitle", "time": 1867.669, "timestamp": "00:31:07", "text": "[音乐]"}, {"type": "subtitle", "time": 1870.75, "timestamp": "00:31:10", "text": "什么是"}, {"type": "subtitle", "time": 1882.43, "timestamp": "00:31:22", "text": "[音乐]"}, {"type": "subtitle", "time": 1886.23, "timestamp": "00:31:26", "text": "好的。我以前是不是听过这个故事？"}, {"type": "subtitle", "time": 1887.63, "timestamp": "00:31:27", "text": "那是旧的"}, {"type": "subtitle", "time": 1894.23, "timestamp": "00:31:34", "text": "一家餐厅和呃，吻 kisa kisa"}, {"type": "subtitle", "time": 1897.35, "timestamp": "00:31:37", "text": "那就像咖啡店一样吧？所以"}, {"type": "subtitle", "time": 1898.95, "timestamp": "00:31:38", "text": "餐厅，咖啡馆。然后是这个"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "或者旧的那个。第五个是寿司。"}, {"type": "subtitle", "time": 1904.75, "timestamp": "00:31:44", "text": "寿司"}, {"type": "subtitle", "time": 1914.63, "timestamp": "00:31:54", "text": "佐班。 Zoba zoba。哦，荞麦面店。然后"}, {"type": "subtitle", "time": 1916.71, "timestamp": "00:31:56", "text": "好的。出院后。那就是"}, {"type": "subtitle", "time": 1919.029, "timestamp": "00:31:59", "text": "奇怪的。选择带有字母 o o o o 的单词"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "哦哦哦哦哦哦哦哦哦哦哦哦哦"}, {"type": "subtitle", "time": 1919.509, "timestamp": "00:31:59", "text": "对面哦哦哦哦哦哦"}]
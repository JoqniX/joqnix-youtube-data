[{"type": "subtitle", "time": 15241.11, "timestamp": "04:14:01", "text": "而且没有返回的意愿。但"}, {"type": "subtitle", "time": 15244.469, "timestamp": "04:14:04", "text": "什么？不，不，这不可能。他是"}, {"type": "subtitle", "time": 15247.429, "timestamp": "04:14:07", "text": "只是想征求他们的意见而已。我是"}, {"type": "subtitle", "time": 15250.59, "timestamp": "04:14:10", "text": "非常抱歉。我希望情况能更好一些。"}, {"type": "subtitle", "time": 15257.79, "timestamp": "04:14:17", "text": "哦不，她哭了。"}, {"type": "subtitle", "time": 15267.349, "timestamp": "04:14:27", "text": "她已经恢复正常了。什么？情况很糟糕。我的"}, {"type": "subtitle", "time": 15271.349, "timestamp": "04:14:31", "text": "亲爱的哥哥。"}, {"type": "subtitle", "time": 15273.67, "timestamp": "04:14:33", "text": "我确实很怀念《你好，Bmont 女士》。好的"}, {"type": "subtitle", "time": 15275.91, "timestamp": "04:14:35", "text": "消息。我成功清空了兰罗克的"}, {"type": "subtitle", "time": 15279.269, "timestamp": "04:14:39", "text": "营地。你把它们都清理掉了？如何？我做了"}, {"type": "subtitle", "time": 15282.309, "timestamp": "04:14:42", "text": "全部死去。那真是令人痛心，他们挖了起来。"}, {"type": "subtitle", "time": 15285.67, "timestamp": "04:14:45", "text": "她们穿着高跟鞋，但我还是做到了。哦，我"}, {"type": "subtitle", "time": 15287.189, "timestamp": "04:14:47", "text": "真希望我哥哥也能做到你这样的事"}, {"type": "subtitle", "time": 15289.91, "timestamp": "04:14:49", "text": "做过。或许他现在还会和我在一起。"}, {"type": "subtitle", "time": 15292.79, "timestamp": "04:14:52", "text": "我尤其感激。你为……做了"}, {"type": "subtitle", "time": 15295.59, "timestamp": "04:14:55", "text": "吟游诗人吟唱我无法吟唱的诗篇。你拯救了我们"}, {"type": "subtitle", "time": 15297.91, "timestamp": "04:14:57", "text": "哈姆雷特，我的年轻朋友。这不会"}]
[{"type": "subtitle", "time": 18603.23, "timestamp": "05:10:03", "text": "真是太"}, {"type": "subtitle", "time": 18605.83, "timestamp": "05:10:05", "text": "好的。嗯？"}, {"type": "subtitle", "time": 18622.31, "timestamp": "05:10:22", "text": "是的，我打开了。所以，这"}, {"type": "subtitle", "time": 18626.15, "timestamp": "05:10:26", "text": "完成了。二点结束了。三就像钟一样"}, {"type": "subtitle", "time": 18628.55, "timestamp": "05:10:28", "text": "它。她是个麻瓜。所以，当然，"}, {"type": "subtitle", "time": 18630.11, "timestamp": "05:10:30", "text": "贝尔"}, {"type": "subtitle", "time": 18633.15, "timestamp": "05:10:33", "text": "贝朗。贝尔庭院，"}, {"type": "subtitle", "time": 18636.628, "timestamp": "05:10:36", "text": "正确的？呃，钟楼砰的一声。钟"}, {"type": "subtitle", "time": 18656.27, "timestamp": "05:10:56", "text": "直的。爬上去。我记得当时看到"}]
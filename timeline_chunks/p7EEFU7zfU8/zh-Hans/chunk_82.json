[{"type": "subtitle", "time": 4921.669, "timestamp": "01:22:01", "text": "等等，我刚才跟自己说早安了吗？我"}, {"type": "subtitle", "time": 4924.95, "timestamp": "01:22:04", "text": "也应该跟小狗说声早安喵喵。"}, {"type": "subtitle", "time": 4927.75, "timestamp": "01:22:07", "text": "你要带我去哪里？确实如此"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "我直接给你演示给你看会更好。"}, {"type": "subtitle", "time": 4934.31, "timestamp": "01:22:14", "text": "天哪，短发的人真的好可爱。"}, {"type": "subtitle", "time": 4936.629, "timestamp": "01:22:16", "text": "我们快到了。我只是希望"}, {"type": "subtitle", "time": 4939.47, "timestamp": "01:22:19", "text": "它们会增加更多头发"}, {"type": "subtitle", "time": 4948.55, "timestamp": "01:22:28", "text": "退后。"}, {"type": "subtitle", "time": 4958.189, "timestamp": "01:22:38", "text": "哦。哦，我的"}, {"type": "subtitle", "time": 4963.189, "timestamp": "01:22:43", "text": "上帝。这是一只猫头鹰。飞马座问号。"}, {"type": "subtitle", "time": 4966.95, "timestamp": "01:22:46", "text": "不，是只鸟。不，不是猫头鹰，而是一种鸟。"}, {"type": "subtitle", "time": 4969.75, "timestamp": "01:22:49", "text": "高翼。高翼。好的。她不就是吗？"}, {"type": "subtitle", "time": 4972.79, "timestamp": "01:22:52", "text": "壮丽？它看起来像个鹰头"}, {"type": "subtitle", "time": 4977.27, "timestamp": "01:22:57", "text": "骑马。但要小心。你必须"}, {"type": "subtitle", "time": 4979.83, "timestamp": "01:22:59", "text": "永远对河马表现出应有的礼貌"}]
[{"type": "subtitle", "time": 20462.47, "timestamp": "05:41:02", "text": "我制作的视频，音乐视频"}, {"type": "subtitle", "time": 20473.27, "timestamp": "05:41:13", "text": "感觉有点疯狂，因为我……"}, {"type": "subtitle", "time": 20476.548, "timestamp": "05:41:16", "text": "嗯，我该怎么说呢，我录了很多。"}, {"type": "subtitle", "time": 20478.95, "timestamp": "05:41:18", "text": "九月份。"}, {"type": "subtitle", "time": 20481.27, "timestamp": "05:41:21", "text": "[音乐]"}, {"type": "subtitle", "time": 20485.788, "timestamp": "05:41:25", "text": "所以，我有很多音乐视频要拍。"}, {"type": "subtitle", "time": 20488.948, "timestamp": "05:41:28", "text": "上传。差不多就是这样。我没有"}, {"type": "subtitle", "time": 20491.14, "timestamp": "05:41:31", "text": "我生命中没有什么特别的事情发生。"}, {"type": "subtitle", "time": 20493.43, "timestamp": "05:41:33", "text": "[音乐]"}, {"type": "subtitle", "time": 20496.39, "timestamp": "05:41:36", "text": "是的。比如，你会学习吗？"}, {"type": "subtitle", "time": 20499.27, "timestamp": "05:41:39", "text": "如何像音乐制作人那样工作"}, {"type": "subtitle", "time": 20501.91, "timestamp": "05:41:41", "text": "你在日本吗？你要出去吗？"}, {"type": "subtitle", "time": 20511.708, "timestamp": "05:41:51", "text": "嗯，让我想想。让我想想。"}, {"type": "subtitle", "time": 20513.99, "timestamp": "05:41:53", "text": "呃，等等，刚才的问题是什么来着？我"}, {"type": "subtitle", "time": 20517.11, "timestamp": "05:41:57", "text": "一片空白。对不起。就是这样。"}, {"type": "subtitle", "time": 20519.91, "timestamp": "05:41:59", "text": "是的。好的。是的。音乐制作人。我"}]
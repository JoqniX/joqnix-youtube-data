[{"type": "subtitle", "time": 5760.229, "timestamp": "01:36:00", "text": "天空。太美了。女巫"}, {"type": "subtitle", "time": 5762.629, "timestamp": "01:36:02", "text": "她认为自己是一名收藏家，"}, {"type": "subtitle", "time": 5764.629, "timestamp": "01:36:04", "text": "买这个头盔是想当个小饰品。"}, {"type": "subtitle", "time": 5766.91, "timestamp": "01:36:06", "text": "那是霍格沃茨。凉爽的。她称之为"}, {"type": "subtitle", "time": 5770.709, "timestamp": "01:36:10", "text": "哥布林是任何事物的合法所有者"}, {"type": "subtitle", "time": 5773.83, "timestamp": "01:36:13", "text": "物体如同其制造者。太可爱了。所以"}, {"type": "subtitle", "time": 5777.35, "timestamp": "01:36:17", "text": "美丽的。比如烟囱之类的东西。"}, {"type": "subtitle", "time": 5778.95, "timestamp": "01:36:18", "text": "而且巫师们一直都能工作"}, {"type": "subtitle", "time": 5781.75, "timestamp": "01:36:21", "text": "一起。哇。在我们这些类型之间"}, {"type": "subtitle", "time": 5784.709, "timestamp": "01:36:24", "text": "似乎数不胜数。这或许会令人惊讶"}, {"type": "subtitle", "time": 5787.99, "timestamp": "01:36:27", "text": "让你了解更多。我的天哪，有风筝！"}, {"type": "subtitle", "time": 5792.03, "timestamp": "01:36:32", "text": "还有一些其他的东西。这就是我发现的原因"}, {"type": "subtitle", "time": 5806.189, "timestamp": "01:36:46", "text": "上帝。所以"}, {"type": "subtitle", "time": 5808.68, "timestamp": "01:36:48", "text": "可爱的。是鸟。"}, {"type": "subtitle", "time": 5810.31, "timestamp": "01:36:50", "text": "[音乐]"}, {"type": "subtitle", "time": 5812.189, "timestamp": "01:36:52", "text": "我不知道那是什么。"}]
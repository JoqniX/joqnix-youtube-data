[{"type": "subtitle", "time": 9721.27, "timestamp": "02:42:01", "text": "你知道吗，我一直戴着梅林"}, {"type": "subtitle", "time": 9723.11, "timestamp": "02:42:03", "text": "钟。咱们就用黑魔法吧。"}, {"type": "subtitle", "time": 9754.349, "timestamp": "02:42:34", "text": "某人。我们还是别把这个放在这里了。"}, {"type": "subtitle", "time": 9761.91, "timestamp": "02:42:41", "text": "眼镜。我的眼镜去哪儿了？那里"}, {"type": "subtitle", "time": 9765.77, "timestamp": "02:42:45", "text": "你去。圆形玻璃杯。"}, {"type": "subtitle", "time": 9768.349, "timestamp": "02:42:48", "text": "[音乐]"}, {"type": "subtitle", "time": 9770.83, "timestamp": "02:42:50", "text": "嗯，那应该没问题。"}, {"type": "subtitle", "time": 9773.389, "timestamp": "02:42:53", "text": "足够的。"}]
[{"type": "subtitle", "time": 15061.03, "timestamp": "04:11:01", "text": "没错，但是，呃，学生是什么样的呢？"}, {"type": "subtitle", "time": 15063.51, "timestamp": "04:11:03", "text": "你现在在做什么？你迷路了，"}, {"type": "subtitle", "time": 15066.229, "timestamp": "04:11:06", "text": "你做了吗？"}, {"type": "subtitle", "time": 15068.309, "timestamp": "04:11:08", "text": "我愿意。我只是在乡间闲逛。"}, {"type": "subtitle", "time": 15071.51, "timestamp": "04:11:11", "text": "少量。嘿，现在打破常规真不错"}, {"type": "subtitle", "time": 15074.63, "timestamp": "04:11:14", "text": "进而。我本人也喜欢四处游荡。在"}, {"type": "subtitle", "time": 15078.55, "timestamp": "04:11:18", "text": "事实上，我的名字叫利奥波德·巴布科克，而我"}, {"type": "subtitle", "time": 15082.309, "timestamp": "04:11:22", "text": "我确实是来卖东西的。现在，对于某些人来说"}, {"type": "subtitle", "time": 15084.55, "timestamp": "04:11:24", "text": "像你一样，也容易……"}, {"type": "subtitle", "time": 15087.03, "timestamp": "04:11:27", "text": "漫游，我无法低估"}, {"type": "subtitle", "time": 15089.269, "timestamp": "04:11:29", "text": "保留一些威根韦尔德的重要性"}, {"type": "subtitle", "time": 15091.91, "timestamp": "04:11:31", "text": "手边有药水。我不敢踏足这步田地。"}, {"type": "subtitle", "time": 15093.59, "timestamp": "04:11:33", "text": "在像禁林那样的地方"}, {"type": "subtitle", "time": 15095.99, "timestamp": "04:11:35", "text": "缺乏稳定的供应。你是什​​么"}, {"type": "subtitle", "time": 15098.15, "timestamp": "04:11:38", "text": "比如说，我的年轻朋友？衡量"}, {"type": "subtitle", "time": 15101.269, "timestamp": "04:11:41", "text": "为前路安全保驾护航。某种"}, {"type": "subtitle", "time": 15103.189, "timestamp": "04:11:43", "text": "考虑。谢谢您的帮助，先生。"}, {"type": "subtitle", "time": 15105.51, "timestamp": "04:11:45", "text": "贝尔科克。嘿，如果你看到的话告诉我一声。"}, {"type": "subtitle", "time": 15107.55, "timestamp": "04:11:47", "text": "你喜欢的东西。"}, {"type": "subtitle", "time": 15109.99, "timestamp": "04:11:49", "text": "嘿，宝贝。现在可能就要走了。感谢"}, {"type": "subtitle", "time": 15113.349, "timestamp": "04:11:53", "text": "你。天哪，我本应该选择的"}]
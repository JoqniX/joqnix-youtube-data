[{"type": "subtitle", "time": 4026.309, "timestamp": "01:07:06", "text": "衣服？哦，这是个衣橱。它不是"}, {"type": "subtitle", "time": 4028.309, "timestamp": "01:07:08", "text": "投降。这是一个clo。是衣服。"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "那边好像有个凳子。"}, {"type": "subtitle", "time": 4032.19, "timestamp": "01:07:12", "text": "像"}, {"type": "subtitle", "time": 4039.27, "timestamp": "01:07:19", "text": "诡异的。对，就是这东西。这个东西。"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "这？哇。好的。总之，但是……在哪里？"}, {"type": "subtitle", "time": 4050.15, "timestamp": "01:07:30", "text": "我们今天做什么？所以，今天我们要去"}, {"type": "subtitle", "time": 4053.589, "timestamp": "01:07:33", "text": "正如标题所说，我们要这样做"}, {"type": "subtitle", "time": 4055.789, "timestamp": "01:07:35", "text": "要做野兽"}, {"type": "subtitle", "time": 4058.99, "timestamp": "01:07:38", "text": "这门课是由教授讲授的。"}, {"type": "subtitle", "time": 4062.39, "timestamp": "01:07:42", "text": "霍文德。我们要去蜂巢里学习"}, {"type": "subtitle", "time": 4066.63, "timestamp": "01:07:46", "text": "如何与蜜蜂和野兽一起冒险"}, {"type": "subtitle", "time": 4071.309, "timestamp": "01:07:51", "text": "还有一些其他的东西。珊，我们还是做我们的事吧"}]
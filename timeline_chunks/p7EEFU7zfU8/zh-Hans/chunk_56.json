[{"type": "subtitle", "time": 3360.309, "timestamp": "00:56:00", "text": "你。但没关系。好的。谢谢"}, {"type": "subtitle", "time": 3362.39, "timestamp": "00:56:02", "text": "每个人。没关系。我会下载"}, {"type": "subtitle", "time": 3364.39, "timestamp": "00:56:04", "text": "Twitch 版主。不用担心。不用担心。你好。"}, {"type": "subtitle", "time": 3368.069, "timestamp": "00:56:08", "text": "另外，感谢 Mia Cat 送的六张卡片。"}, {"type": "subtitle", "time": 3371.349, "timestamp": "00:56:11", "text": "比特。谢谢。这对我意义重大。"}, {"type": "subtitle", "time": 3374.15, "timestamp": "00:56:14", "text": "就这样。我相信，谢谢你"}, {"type": "subtitle", "time": 3375.829, "timestamp": "00:56:15", "text": "所有在 Twitch 上加入的人，以及"}, {"type": "subtitle", "time": 3377.51, "timestamp": "00:56:17", "text": "在 YouTube 上。希望你喜欢这篇文章。"}, {"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "今天和我一起的学习会是这样的："}, {"type": "subtitle", "time": 3382.789, "timestamp": "00:56:22", "text": "大部分时间可能是我，大部分时间可能是我在工作"}, {"type": "subtitle", "time": 3384.789, "timestamp": "00:56:24", "text": "我会尽我所能。我希望这个板子"}, {"type": "subtitle", "time": 3386.03, "timestamp": "00:56:26", "text": "不"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "起床，就像……呃，受版权保护。我们开始吧"}, {"type": "subtitle", "time": 3392.51, "timestamp": "00:56:32", "text": "希望不会发生。但"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "是的，今天玩得很开心。我很喜欢。"}, {"type": "subtitle", "time": 3398.069, "timestamp": "00:56:38", "text": "感谢观看，谢谢。"}, {"type": "subtitle", "time": 3400.47, "timestamp": "00:56:40", "text": "因为他坚持到了最后。真正意味着"}, {"type": "subtitle", "time": 3402.789, "timestamp": "00:56:42", "text": "很多。明天或下天见。"}, {"type": "subtitle", "time": 3404.789, "timestamp": "00:56:44", "text": "明天就是情人节了。出色地"}, {"type": "subtitle", "time": 3407.27, "timestamp": "00:56:47", "text": "早上直播一次。去。你好。是什么？"}]
[{"type": "subtitle", "time": 15203.51, "timestamp": "04:13:23", "text": "[音乐]"}, {"type": "subtitle", "time": 15215.75, "timestamp": "04:13:35", "text": "我确实很怀念熙熙攘攘的商业氛围。贫穷的"}, {"type": "subtitle", "time": 15218.389, "timestamp": "04:13:38", "text": "顾客不敢外出。女士"}, {"type": "subtitle", "time": 15219.91, "timestamp": "04:13:39", "text": "鲍蒙特"}, {"type": "subtitle", "time": 15222.07, "timestamp": "04:13:42", "text": "我想我有一些关于你的消息。"}, {"type": "subtitle", "time": 15225.11, "timestamp": "04:13:45", "text": "兄弟。巴多夫，你对我的了解多少？"}, {"type": "subtitle", "time": 15227.18, "timestamp": "04:13:47", "text": "兄弟？"}, {"type": "subtitle", "time": 15235.99, "timestamp": "04:13:55", "text": "呃，怎么办？"}, {"type": "subtitle", "time": 15238.63, "timestamp": "04:13:58", "text": "恐怕他已经加入了阿什温德帮。"}]
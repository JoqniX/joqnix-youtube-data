[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "实际视频。我们将前往"}, {"type": "subtitle", "time": 4565.03, "timestamp": "01:16:05", "text": "用笔挑选另一只野兽。和"}, {"type": "subtitle", "time": 4568.149, "timestamp": "01:16:08", "text": "喂食时请务必小心。"}, {"type": "subtitle", "time": 4571.75, "timestamp": "01:16:11", "text": "给它们梳理毛发。斯威廷小姐，你为什么不……"}, {"type": "subtitle", "time": 4574.149, "timestamp": "01:16:14", "text": "带我们的新学生去看看麻疹。"}, {"type": "subtitle", "time": 4576.55, "timestamp": "01:16:16", "text": "最远的笔？"}, {"type": "subtitle", "time": 4578.55, "timestamp": "01:16:18", "text": "好的。这边走。麻疹疫情已经结束了。"}, {"type": "subtitle", "time": 4592.07, "timestamp": "01:16:32", "text": "我的天啊。哦，几条膝盖或者你"}, {"type": "subtitle", "time": 4594.39, "timestamp": "01:16:34", "text": "至少够买点东西了。"}, {"type": "subtitle", "time": 4597.51, "timestamp": "01:16:37", "text": "来自 Honey Jes。"}, {"type": "subtitle", "time": 4612.709, "timestamp": "01:16:52", "text": "你在做什么？我的天哪。"}, {"type": "subtitle", "time": 4616.95, "timestamp": "01:16:56", "text": "我的天哪。你。她的名字是"}, {"type": "subtitle", "time": 4618.79, "timestamp": "01:16:58", "text": "菲妮。"}]
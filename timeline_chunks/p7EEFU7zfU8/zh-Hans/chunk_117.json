[{"type": "subtitle", "time": 7023.589, "timestamp": "01:57:03", "text": "它静止不动，我的天哪。"}, {"type": "subtitle", "time": 7028.229, "timestamp": "01:57:08", "text": "怎么样？好的，像这样。回来。"}, {"type": "subtitle", "time": 7030.43, "timestamp": "01:57:10", "text": "倒退。"}, {"type": "subtitle", "time": 7032.35, "timestamp": "01:57:12", "text": "左边。"}, {"type": "subtitle", "time": 7036.91, "timestamp": "01:57:16", "text": "暂停。好的。呃，"}, {"type": "subtitle", "time": 7039.55, "timestamp": "01:57:19", "text": "停留。好的。停留。好的。好的。好的。"}, {"type": "subtitle", "time": 7055.83, "timestamp": "01:57:35", "text": "嗯。这真是太奇怪、太令人困惑了。我"}, {"type": "subtitle", "time": 7058.95, "timestamp": "01:57:38", "text": "我想去参观一下，但是"}, {"type": "subtitle", "time": 7076.99, "timestamp": "01:57:56", "text": "哦，你应该得到所有"}]
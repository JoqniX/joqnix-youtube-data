[{"type": "subtitle", "time": 17948.67, "timestamp": "04:59:08", "text": "好的。我还做了什么？"}, {"type": "subtitle", "time": 17952.03, "timestamp": "04:59:12", "text": "计划？我忘了。我说什么了？"}, {"type": "subtitle", "time": 17954.99, "timestamp": "04:59:14", "text": "再次？哦，主啊，我"}, {"type": "subtitle", "time": 17967.75, "timestamp": "04:59:27", "text": "忘了？你好。忘了。我是在开玩笑。"}, {"type": "subtitle", "time": 17980.868, "timestamp": "04:59:40", "text": "[音乐]"}, {"type": "subtitle", "time": 17983.31, "timestamp": "04:59:43", "text": "是的。游戏减少"}, {"type": "subtitle", "time": 17993.11, "timestamp": "04:59:53", "text": "是的。所有这些元素。我能够"}, {"type": "subtitle", "time": 17994.788, "timestamp": "04:59:54", "text": "给你的朋友，瓶子太太"}, {"type": "subtitle", "time": 17997.03, "timestamp": "04:59:57", "text": "给她准备了一些维根世界药剂。"}]
[{"type": "subtitle", "time": 13021.269, "timestamp": "03:37:01", "text": "再见。是的，我做了。我当时只是"}, {"type": "subtitle", "time": 13023.07, "timestamp": "03:37:03", "text": "担心克莱尔·鲍蒙特的哥哥，"}, {"type": "subtitle", "time": 13026.79, "timestamp": "03:37:06", "text": "诗人。只有他失踪了。传闻是"}, {"type": "subtitle", "time": 13028.95, "timestamp": "03:37:08", "text": "有人看到他在森林里练习。"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "黑魔法。我亲眼见过他，就在附近。"}, {"type": "subtitle", "time": 13034.71, "timestamp": "03:37:14", "text": "鲁克伍德地块的废墟。我是黑暗魔法。"}, {"type": "subtitle", "time": 13036.95, "timestamp": "03:37:16", "text": "我担心他给自己惹了麻烦。"}, {"type": "subtitle", "time": 13039.51, "timestamp": "03:37:19", "text": "阿什温德人，尤其是如果他制造"}, {"type": "subtitle", "time": 13042.07, "timestamp": "03:37:22", "text": "给他们一个他无法兑现的承诺。 ID"}, {"type": "subtitle", "time": 13044.55, "timestamp": "03:37:24", "text": "我自己也参与了寻找他的行动，但是没有人。"}, {"type": "subtitle", "time": 13046.87, "timestamp": "03:37:26", "text": "将面临遭遇随机事件的风险。哦，等等。"}, {"type": "subtitle", "time": 13049.51, "timestamp": "03:37:29", "text": "我不小心开启了支线任务"}, {"type": "subtitle", "time": 13054.75, "timestamp": "03:37:34", "text": "哦，不。我当然可以照顾他。"}, {"type": "subtitle", "time": 13057.83, "timestamp": "03:37:37", "text": "非常感谢。你可能会和……"}, {"type": "subtitle", "time": 13060.229, "timestamp": "03:37:40", "text": "克莱尔先来。或许她有一些"}, {"type": "subtitle", "time": 13063.51, "timestamp": "03:37:43", "text": "我没有的见解。我可以告诉你"}, {"type": "subtitle", "time": 13066.07, "timestamp": "03:37:46", "text": "最后一次有人看到巴多夫是在森林里。"}, {"type": "subtitle", "time": 13069.11, "timestamp": "03:37:49", "text": "穿着一件特别的羊毛套衫，"}, {"type": "subtitle", "time": 13073.269, "timestamp": "03:37:53", "text": "那是克拉自己织的毛线。好的。"}, {"type": "subtitle", "time": 13075.03, "timestamp": "03:37:55", "text": "如果你愿意的话，克莱尔会在她的店里。"}]
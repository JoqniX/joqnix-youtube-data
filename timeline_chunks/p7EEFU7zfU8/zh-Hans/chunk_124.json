[{"type": "subtitle", "time": 7446.79, "timestamp": "02:04:06", "text": "嗯，"}, {"type": "subtitle", "time": 7450.95, "timestamp": "02:04:10", "text": "有人会说，呃，比安的东西会"}, {"type": "subtitle", "time": 7455.47, "timestamp": "02:04:15", "text": "成为你最喜欢的，但是不，我的意思是他们是"}, {"type": "subtitle", "time": 7458.95, "timestamp": "02:04:18", "text": "好的。比阿鸡。哦。嗯，我喜欢它们"}, {"type": "subtitle", "time": 7462.149, "timestamp": "02:04:22", "text": "实际上两者都是。有时我更喜欢"}, {"type": "subtitle", "time": 7465.03, "timestamp": "02:04:25", "text": "无骨的就很好。"}, {"type": "subtitle", "time": 7473.99, "timestamp": "02:04:33", "text": "是的。我的意思是，我什么都吃。我吃"}, {"type": "subtitle", "time": 7485.55, "timestamp": "02:04:45", "text": "是的。哦，又是这个地方。"}, {"type": "subtitle", "time": 7494.709, "timestamp": "02:04:54", "text": "正确的？无处可去。"}]
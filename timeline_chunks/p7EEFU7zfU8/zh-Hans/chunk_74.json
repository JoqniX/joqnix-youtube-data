[{"type": "subtitle", "time": 4440.63, "timestamp": "01:14:00", "text": "班上所有的野兽都完美无缺"}, {"type": "subtitle", "time": 4442.51, "timestamp": "01:14:02", "text": "安全的。我"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "请注意。舌头"}, {"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "一只小海蓬子可能非常狡猾。"}, {"type": "subtitle", "time": 4451.99, "timestamp": "01:14:11", "text": "好的。为什么要打开 Twitter？你们所有人"}, {"type": "subtitle", "time": 4453.669, "timestamp": "01:14:13", "text": "需要了解。哦，原来是这样展示的"}, {"type": "subtitle", "time": 4458.709, "timestamp": "01:14:18", "text": "速度。好的。杰拉德，你只要留意一下就行了。"}, {"type": "subtitle", "time": 4463.43, "timestamp": "01:14:23", "text": "不小心闪到了六月。我的天啊。"}, {"type": "subtitle", "time": 4466.31, "timestamp": "01:14:26", "text": "哦，还有，想想愉快的事情。我喜欢"}, {"type": "subtitle", "time": 4469.39, "timestamp": "01:14:29", "text": "认为这丰富了他的经历。"}, {"type": "subtitle", "time": 4471.39, "timestamp": "01:14:31", "text": "安息。"}, {"type": "subtitle", "time": 4474.03, "timestamp": "01:14:34", "text": "上帝。"}, {"type": "subtitle", "time": 4477.189, "timestamp": "01:14:37", "text": "该死。密切关注“好的”。哦，看"}, {"type": "subtitle", "time": 4479.99, "timestamp": "01:14:39", "text": "就是这个封面。看看这只眼睛。"}, {"type": "subtitle", "time": 4483.03, "timestamp": "01:14:43", "text": "太可爱了。鱼就像一个毛茸茸的吹气球"}, {"type": "subtitle", "time": 4484.75, "timestamp": "01:14:44", "text": "你的"}, {"type": "subtitle", "time": 4487.35, "timestamp": "01:14:47", "text": "杰拉尔德。这只野兽的抚摸刷是"}, {"type": "subtitle", "time": 4489.709, "timestamp": "01:14:49", "text": "用于培育"}, {"type": "subtitle", "time": 4491.709, "timestamp": "01:14:51", "text": "米卡尔"}, {"type": "subtitle", "time": 4494.189, "timestamp": "01:14:54", "text": "蜜蜂。"}, {"type": "subtitle", "time": 4497.35, "timestamp": "01:14:57", "text": "哦，点击 t 将鼠标悬停在画笔上，然后"}]
[{"type": "subtitle", "time": 9480.23, "timestamp": "02:38:00", "text": "从他的搜索中。他的搜索？呃，是"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "只是一丝预感。你给我留下了深刻的印象。"}, {"type": "subtitle", "time": 9485.59, "timestamp": "02:38:05", "text": "非常感谢，朋友。我很高兴我"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "我信任你。我希望他不会很快这样做。"}, {"type": "subtitle", "time": 9492.469, "timestamp": "02:38:12", "text": "背叛我。对我们的安排保密"}, {"type": "subtitle", "time": 9494.87, "timestamp": "02:38:14", "text": "现在。许多人不会相信我们的目标"}, {"type": "subtitle", "time": 9504.15, "timestamp": "02:38:24", "text": "完成主线任务。七分之七"}, {"type": "subtitle", "time": 9516.11, "timestamp": "02:38:36", "text": "我没看到任何新的任务了。"}, {"type": "subtitle", "time": 9520.11, "timestamp": "02:38:40", "text": "片刻。只需要把菜做完。"}, {"type": "subtitle", "time": 9524.23, "timestamp": "02:38:44", "text": "现在。哦耶，我们开始吧。实际上，我"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "记得我上次直播时说过我会"}, {"type": "subtitle", "time": 9528.55, "timestamp": "02:38:48", "text": "现在先在直播之外做，但是再说一遍"}, {"type": "subtitle", "time": 9532.07, "timestamp": "02:38:52", "text": "无法在直播之外玩游戏。最多"}, {"type": "subtitle", "time": 9534.23, "timestamp": "02:38:54", "text": "我当时可能在休息或者在工作。"}, {"type": "subtitle", "time": 9536.469, "timestamp": "02:38:56", "text": "其他方面。"}]
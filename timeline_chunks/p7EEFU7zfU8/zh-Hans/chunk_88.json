[{"type": "subtitle", "time": 5280.91, "timestamp": "01:28:00", "text": "呃呃，那是什么地方？"}, {"type": "subtitle", "time": 5285.629, "timestamp": "01:28:05", "text": "再次？呃，霍格沃茨？不，不是霍格沃茨。"}, {"type": "subtitle", "time": 5297.11, "timestamp": "01:28:17", "text": "我按了什么？哦，我按了"}, {"type": "subtitle", "time": 5309.99, "timestamp": "01:28:29", "text": "为什么现在人这么多？"}, {"type": "subtitle", "time": 5312.71, "timestamp": "01:28:32", "text": "只有一只毛茸茸的。"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "[音乐]"}, {"type": "subtitle", "time": 5325.03, "timestamp": "01:28:45", "text": "你好呀。很高兴见到你。"}, {"type": "subtitle", "time": 5327.99, "timestamp": "01:28:47", "text": "大家好。你好，瑞恩小姐。我想"}, {"type": "subtitle", "time": 5329.35, "timestamp": "01:28:49", "text": "再次感谢您的帮助。"}, {"type": "subtitle", "time": 5331.11, "timestamp": "01:28:51", "text": "鲁克伍德和哈洛，巨魔之日"}, {"type": "subtitle", "time": 5334.39, "timestamp": "01:28:54", "text": "攻击。请叫我塞罗娜。那时我很开心。"}, {"type": "subtitle", "time": 5337.83, "timestamp": "01:28:57", "text": "帮忙。等等，那两个人是她吗？"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "嗓音"}]
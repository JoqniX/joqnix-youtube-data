[{"type": "subtitle", "time": 10277.59, "timestamp": "02:51:17", "text": "您好，医生。我设法救出了一只"}, {"type": "subtitle", "time": 10280.07, "timestamp": "02:51:20", "text": "蓬蓬。你可以救出尽可能多的人"}, {"type": "subtitle", "time": 10282.87, "timestamp": "02:51:22", "text": "背包可以装下。偷猎者被捕"}, {"type": "subtitle", "time": 10285.75, "timestamp": "02:51:25", "text": "泡芙皮，嗯，迪卡不太确定。"}, {"type": "subtitle", "time": 10288.55, "timestamp": "02:51:28", "text": "他们会如何处理这些物品。迪伊确信"}, {"type": "subtitle", "time": 10291.349, "timestamp": "02:51:31", "text": "他们跟你在一起会更安全。现在，不是"}, {"type": "subtitle", "time": 10293.429, "timestamp": "02:51:33", "text": "所有野兽都很容易被救出"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "作为一种虚假宣传。迪克建议你接下来"}, {"type": "subtitle", "time": 10298.71, "timestamp": "02:51:38", "text": "找到一种会飞的野兽。一份工作，"}, {"type": "subtitle", "time": 10301.349, "timestamp": "02:51:41", "text": "也许。工作。"}, {"type": "subtitle", "time": 10304.15, "timestamp": "02:51:44", "text": "迪克知道西边有一些筑巢的地方。"}, {"type": "subtitle", "time": 10306.55, "timestamp": "02:51:46", "text": "在一棵可以俯瞰霍格沃茨的大树上。"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "好的，但我们必须小心。迪克有"}, {"type": "subtitle", "time": 10311.91, "timestamp": "02:51:51", "text": "最近在该地区发现过偷猎者。"}, {"type": "subtitle", "time": 10313.91, "timestamp": "02:51:53", "text": "酒精是杀手。我们到时在那里与你见面。"}]
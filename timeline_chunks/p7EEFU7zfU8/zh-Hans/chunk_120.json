[{"type": "subtitle", "time": 7214.31, "timestamp": "02:00:14", "text": "我也跳不起来。我的天哪。我是"}, {"type": "subtitle", "time": 7217.09, "timestamp": "02:00:17", "text": "本来应该制作一个骨架笔刷，但是"}, {"type": "subtitle", "time": 7219.229, "timestamp": "02:00:19", "text": "[音乐]"}, {"type": "subtitle", "time": 7222.75, "timestamp": "02:00:22", "text": "如何"}, {"type": "subtitle", "time": 7228.79, "timestamp": "02:00:28", "text": "一？哦。哦。哦。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 7234.109, "timestamp": "02:00:34", "text": "哦。哦。我做了件事。现在有两个"}, {"type": "subtitle", "time": 7237.03, "timestamp": "02:00:37", "text": "头骨。这边有个骷髅头。"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "哦，我做了件事。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 7247.95, "timestamp": "02:00:47", "text": "我做了"}, {"type": "subtitle", "time": 7251.47, "timestamp": "02:00:51", "text": "某物。哇，我做到了"}, {"type": "subtitle", "time": 7254.31, "timestamp": "02:00:54", "text": "某物。我不知道我做了什么，但是"}, {"type": "subtitle", "time": 7256.35, "timestamp": "02:00:56", "text": "好的，我接受"}]
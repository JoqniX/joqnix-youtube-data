[{"type": "subtitle", "time": 10022.309, "timestamp": "02:47:02", "text": "拉紧。希望你一切都好。放松"}, {"type": "subtitle", "time": 10024.58, "timestamp": "02:47:04", "text": "ASMR，儿子。"}, {"type": "subtitle", "time": 10026.389, "timestamp": "02:47:06", "text": "[音乐]"}, {"type": "subtitle", "time": 10029.59, "timestamp": "02:47:09", "text": "那是我人生中一段黑暗的时期。成立"}, {"type": "subtitle", "time": 10031.83, "timestamp": "02:47:11", "text": "他自己则为最残酷的巫师效力。"}, {"type": "subtitle", "time": 10035.429, "timestamp": "02:47:15", "text": "他见过的最恶劣的教皇。迪克讨厌"}, {"type": "subtitle", "time": 10038.15, "timestamp": "02:47:18", "text": "为他工作时，他做了很多可怕的事情"}, {"type": "subtitle", "time": 10040.71, "timestamp": "02:47:20", "text": "美丽的野兽。这就是"}, {"type": "subtitle", "time": 10042.389, "timestamp": "02:47:22", "text": "伸展的感觉就像……那些日子里，"}, {"type": "subtitle", "time": 10044.349, "timestamp": "02:47:24", "text": "迪克第一次看到"}, {"type": "subtitle", "time": 10047.11, "timestamp": "02:47:27", "text": "背包。很高兴看到有人使用它。"}, {"type": "subtitle", "time": 10061.15, "timestamp": "02:47:41", "text": "[音乐]"}, {"type": "subtitle", "time": 10075.83, "timestamp": "02:47:55", "text": "转变。我明白了。所以我是"}, {"type": "subtitle", "time": 10076.75, "timestamp": "02:47:56", "text": "等待"}]
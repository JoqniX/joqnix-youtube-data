[{"type": "subtitle", "time": 10140.11, "timestamp": "02:49:00", "text": "[掌声]"}, {"type": "subtitle", "time": 10142.79, "timestamp": "02:49:02", "text": "船长。哦，"}, {"type": "subtitle", "time": 10146.59, "timestamp": "02:49:06", "text": "你得到一个。我得到了一个。我们开始吧"}, {"type": "subtitle", "time": 10149.95, "timestamp": "02:49:09", "text": "去。我还要更多。"}, {"type": "subtitle", "time": 10153.429, "timestamp": "02:49:13", "text": "哦，真难。你们这些滚来滚去的蜜蜂。"}, {"type": "subtitle", "time": 10158.19, "timestamp": "02:49:18", "text": "是的。你好，Aruchama。哦，真好"}, {"type": "subtitle", "time": 10166.469, "timestamp": "02:49:26", "text": "神一。好的。更多的。过来"}, {"type": "subtitle", "time": 10170.67, "timestamp": "02:49:30", "text": "滚动。滚动。呃"}, {"type": "subtitle", "time": 10172.83, "timestamp": "02:49:32", "text": "一。"}, {"type": "subtitle", "time": 10175.55, "timestamp": "02:49:35", "text": "是的。"}, {"type": "subtitle", "time": 10178.19, "timestamp": "02:49:38", "text": "耶。其他"}, {"type": "subtitle", "time": 10180.79, "timestamp": "02:49:40", "text": "一。过来。新滚动"}, {"type": "subtitle", "time": 10183.469, "timestamp": "02:49:43", "text": "可爱泡芙"}, {"type": "subtitle", "time": 10186.67, "timestamp": "02:49:46", "text": "球。其他"}, {"type": "subtitle", "time": 10189.11, "timestamp": "02:49:49", "text": "一。我今天可能要去看全科医生了。"}, {"type": "subtitle", "time": 10191.75, "timestamp": "02:49:51", "text": "明天。哟哟，那就是，那就是要"}, {"type": "subtitle", "time": 10194.55, "timestamp": "02:49:54", "text": "伤害你。我本无法拒绝她。"}, {"type": "subtitle", "time": 10195.95, "timestamp": "02:49:55", "text": "提供。"}, {"type": "subtitle", "time": 10198.23, "timestamp": "02:49:58", "text": "等等，我以为你要去"}]
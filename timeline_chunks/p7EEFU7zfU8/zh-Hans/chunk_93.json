[{"type": "subtitle", "time": 5581.189, "timestamp": "01:33:01", "text": "你好，阿迪蒂。"}, {"type": "subtitle", "time": 5590.07, "timestamp": "01:33:10", "text": "早上好，祝您 Raa Bandan 节快乐。等等，是"}, {"type": "subtitle", "time": 5602.87, "timestamp": "01:33:22", "text": "您好，戈克大人。塞雷娜说我可能会"}, {"type": "subtitle", "time": 5605.91, "timestamp": "01:33:25", "text": "在这里找到你。她做到了。是吗？她真的吗？"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "给你发消息吗？不，其实我"}, {"type": "subtitle", "time": 5611.35, "timestamp": "01:33:31", "text": "想和你谈谈。这是关于"}, {"type": "subtitle", "time": 5614.99, "timestamp": "01:33:34", "text": "兰洛克。现在我想起来了，这三个"}, {"type": "subtitle", "time": 5617.59, "timestamp": "01:33:37", "text": "扫帚怪袭击日。"}, {"type": "subtitle", "time": 5620.79, "timestamp": "01:33:40", "text": "你就是他要招揽的学生。我是。和"}, {"type": "subtitle", "time": 5622.55, "timestamp": "01:33:42", "text": "我需要知道他和他的忠实拥护者们在做什么。"}, {"type": "subtitle", "time": 5625.27, "timestamp": "01:33:45", "text": "我正在努力，这样我才能始终领先一步。"}, {"type": "subtitle", "time": 5628.55, "timestamp": "01:33:48", "text": "假设我确实知道。我为什么要相信"}, {"type": "subtitle", "time": 5634.629, "timestamp": "01:33:54", "text": "她信任我，她说她觉得"}, {"type": "subtitle", "time": 5636.79, "timestamp": "01:33:56", "text": "她的利益可能与此一致。这"}, {"type": "subtitle", "time": 5639.83, "timestamp": "01:33:59", "text": "天气预报持续两天。哦，投降吧。"}]
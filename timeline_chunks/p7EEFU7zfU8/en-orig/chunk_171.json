[{"type": "subtitle", "time": 10277.59, "timestamp": "02:51:17", "text": "Hi, doctor. I managed to rescue a"}, {"type": "subtitle", "time": 10280.07, "timestamp": "02:51:20", "text": "puffkine. You can rescue as many as the"}, {"type": "subtitle", "time": 10282.87, "timestamp": "02:51:22", "text": "knapsack will hold. Poachers capture"}, {"type": "subtitle", "time": 10285.75, "timestamp": "02:51:25", "text": "puff skins, and well, Deika isn't sure"}, {"type": "subtitle", "time": 10288.55, "timestamp": "02:51:28", "text": "what they do with them. Dee is certain"}, {"type": "subtitle", "time": 10291.349, "timestamp": "02:51:31", "text": "they will be safer with you. Now, not"}, {"type": "subtitle", "time": 10293.429, "timestamp": "02:51:33", "text": "all beasts will be as simple to rescue"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "as a puff scheme. Deak suggests you next"}, {"type": "subtitle", "time": 10298.71, "timestamp": "02:51:38", "text": "find a beast that can fly. A jobal,"}, {"type": "subtitle", "time": 10301.349, "timestamp": "02:51:41", "text": "perhaps. Job."}, {"type": "subtitle", "time": 10304.15, "timestamp": "02:51:44", "text": "Deak knows of some to the west nesting"}, {"type": "subtitle", "time": 10306.55, "timestamp": "02:51:46", "text": "in a large tree overlooking Hogwarts."}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "Okay, but we must be careful. Deak has"}, {"type": "subtitle", "time": 10311.91, "timestamp": "02:51:51", "text": "seen poachers in the area recently."}, {"type": "subtitle", "time": 10313.91, "timestamp": "02:51:53", "text": "Alcohol killer. We'll meet you there"}]
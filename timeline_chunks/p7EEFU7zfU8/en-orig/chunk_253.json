[{"type": "subtitle", "time": 15203.51, "timestamp": "04:13:23", "text": "[Music]"}, {"type": "subtitle", "time": 15215.75, "timestamp": "04:13:35", "text": "I do miss the bustle of business. Poor"}, {"type": "subtitle", "time": 15218.389, "timestamp": "04:13:38", "text": "customers afraid to venture out. Madam"}, {"type": "subtitle", "time": 15219.91, "timestamp": "04:13:39", "text": "Bowmont,"}, {"type": "subtitle", "time": 15222.07, "timestamp": "04:13:42", "text": "I believe I have some news of your"}, {"type": "subtitle", "time": 15225.11, "timestamp": "04:13:45", "text": "brother. Badolf, what do you know of my"}, {"type": "subtitle", "time": 15227.18, "timestamp": "04:13:47", "text": "brother?"}, {"type": "subtitle", "time": 15235.99, "timestamp": "04:13:55", "text": "Uh, what to do?"}, {"type": "subtitle", "time": 15238.63, "timestamp": "04:13:58", "text": "I'm afraid he's joined the Ashwinders"}]
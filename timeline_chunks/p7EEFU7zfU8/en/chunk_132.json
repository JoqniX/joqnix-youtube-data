[{"type": "subtitle", "time": 7923.189, "timestamp": "02:12:03", "text": "I suspect you are the one who has been"}, {"type": "subtitle", "time": 7925.069, "timestamp": "02:12:05", "text": "interfering with a rather personal"}, {"type": "subtitle", "time": 7928.069, "timestamp": "02:12:08", "text": "matter. The Demikai statues and the"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "wounds contained therein were placed as"}, {"type": "subtitle", "time": 7933.589, "timestamp": "02:12:13", "text": "they were for good reason. You should"}, {"type": "subtitle", "time": 7935.83, "timestamp": "02:12:15", "text": "not meddle in the personal affairs of"}, {"type": "subtitle", "time": 7939.109, "timestamp": "02:12:19", "text": "others. I'm sorry, Ryas Pam or"}, {"type": "subtitle", "time": 7940.83, "timestamp": "02:12:20", "text": "something. Mr. Peton"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "went stationary."}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "He knows something about those demiguiz"}, {"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": "moons. He's in Hogmead apparently."}, {"type": "subtitle", "time": 7949.83, "timestamp": "02:12:29", "text": "Perhaps I shall pay him a visit. Yeah,"}, {"type": "subtitle", "time": 7952.229, "timestamp": "02:12:32", "text": "you should. Lumos,"}, {"type": "subtitle", "time": 7968.51, "timestamp": "02:12:48", "text": "um"}]
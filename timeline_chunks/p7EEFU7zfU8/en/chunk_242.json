[{"type": "subtitle", "time": 14520.71, "timestamp": "04:02:00", "text": "I'm Cla Bulmont, by the way. Nice to"}, {"type": "subtitle", "time": 14522.95, "timestamp": "04:02:02", "text": "meet you. Ranrock and his followers have"}, {"type": "subtitle", "time": 14525.59, "timestamp": "04:02:05", "text": "set up camp here. No regard for our"}, {"type": "subtitle", "time": 14527.63, "timestamp": "04:02:07", "text": "beloved Hamlet or our"}, {"type": "subtitle", "time": 14531.189, "timestamp": "04:02:11", "text": "livelihoods. Ruthless. My brother Bard"}, {"type": "subtitle", "time": 14533.189, "timestamp": "04:02:13", "text": "dared to stand up to them and ended up"}, {"type": "subtitle", "time": 14536.389, "timestamp": "04:02:16", "text": "in St. Mongo's. I was simply at my wit's"}, {"type": "subtitle", "time": 14541.269, "timestamp": "04:02:21", "text": "Okay."}, {"type": "subtitle", "time": 14543.269, "timestamp": "04:02:23", "text": "I am unfortunately quite familiar with"}, {"type": "subtitle", "time": 14545.67, "timestamp": "04:02:25", "text": "Renro's loyalists. Perhaps I can do"}, {"type": "subtitle", "time": 14548.389, "timestamp": "04:02:28", "text": "something. Much as I would love to be"}, {"type": "subtitle", "time": 14549.99, "timestamp": "04:02:29", "text": "rid of them. Let's go. I don't want you"}, {"type": "subtitle", "time": 14553.269, "timestamp": "04:02:33", "text": "to risk injury or worse. Please be"}, {"type": "subtitle", "time": 14556.07, "timestamp": "04:02:36", "text": "cautious."}, {"type": "subtitle", "time": 14558.55, "timestamp": "04:02:38", "text": "We should not have to live in fear. This"}, {"type": "subtitle", "time": 14560.67, "timestamp": "04:02:40", "text": "is our home."}, {"type": "subtitle", "time": 14563.269, "timestamp": "04:02:43", "text": "Okay. I thought for a second I actually"}, {"type": "subtitle", "time": 14564.91, "timestamp": "04:02:44", "text": "activated another"}, {"type": "subtitle", "time": 14567.349, "timestamp": "04:02:47", "text": "quest. I'm fine with doing multiple"}, {"type": "subtitle", "time": 14575.11, "timestamp": "04:02:55", "text": "but we lack the time. I do hope my"}, {"type": "subtitle", "time": 14578.189, "timestamp": "04:02:58", "text": "brother is all right."}, {"type": "subtitle", "time": 14579.79, "timestamp": "04:02:59", "text": "Natalie,"}]
[{"type": "subtitle", "time": 13565.83, "timestamp": "03:46:05", "text": "An entry from Bard's journal. He"}, {"type": "subtitle", "time": 13569.189, "timestamp": "03:46:09", "text": "overheard whispers. Plan something to do"}, {"type": "subtitle", "time": 13570.92, "timestamp": "03:46:10", "text": "with me."}, {"type": "subtitle", "time": 13573.03, "timestamp": "03:46:13", "text": "[Applause]"}, {"type": "subtitle", "time": 13578.229, "timestamp": "03:46:18", "text": "[Music]"}, {"type": "subtitle", "time": 13600.51, "timestamp": "03:46:40", "text": "I'm going to"}, {"type": "subtitle", "time": 13607.95, "timestamp": "03:46:47", "text": "[Applause]"}, {"type": "subtitle", "time": 13609.83, "timestamp": "03:46:49", "text": "[Music]"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "Okay, that's three. All right, settle"}, {"type": "subtitle", "time": 13616.229, "timestamp": "03:46:56", "text": "yourself. I mean you no harm."}, {"type": "subtitle", "time": 13619.29, "timestamp": "03:46:59", "text": "One more."}]
[{"type": "subtitle", "time": 10082.75, "timestamp": "02:48:02", "text": "a"}, {"type": "subtitle", "time": 10085.23, "timestamp": "02:48:05", "text": "kadavra"}, {"type": "subtitle", "time": 10087.15, "timestamp": "02:48:07", "text": "abacadabra. This"}, {"type": "subtitle", "time": 10090.71, "timestamp": "02:48:10", "text": "thing I'm waiting for these. When will"}, {"type": "subtitle", "time": 10092.429, "timestamp": "02:48:12", "text": "you give me"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "I guess we'll learn a new spell."}, {"type": "subtitle", "time": 10102.19, "timestamp": "02:48:22", "text": "We have"}, {"type": "subtitle", "time": 10104.79, "timestamp": "02:48:24", "text": "arrived. Deak enjoys coming here to"}, {"type": "subtitle", "time": 10107.19, "timestamp": "02:48:27", "text": "watch the beasts, especially the puffle"}, {"type": "subtitle", "time": 10110.07, "timestamp": "02:48:30", "text": "of puff skins nearby. Puff. Be nice to"}, {"type": "subtitle", "time": 10112.55, "timestamp": "02:48:32", "text": "keep them safe. All you will need to do"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "is get close, direct the open knabsack"}, {"type": "subtitle", "time": 10117.91, "timestamp": "02:48:37", "text": "toward the puffine, and in it'll go. All"}]
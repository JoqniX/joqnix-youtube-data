[{"type": "subtitle", "time": 11346.43, "timestamp": "03:09:06", "text": "知道，我們帶"}, {"type": "subtitle", "time": 11370.03, "timestamp": "03:09:30", "text": "好好餵飽他。"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "好的。哦，但我對你也是一樣。"}, {"type": "subtitle", "time": 11376.63, "timestamp": "03:09:36", "text": "你呢？我不認為我餵得"}, {"type": "subtitle", "time": 11379.55, "timestamp": "03:09:39", "text": "夠。"}]
[{"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "可以把我的原料賣給你嗎？  不。好的。希望還能再見到你。  暫別了。再見。"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "告別。  告別。我們回去戰鬥吧。那孩子正要跑。  有隻羊沒能變好。好的，沒關係。我們"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "我要撞到樹上了"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "。"}, {"type": "subtitle", "time": 8563.349, "timestamp": "02:22:43", "text": "啊，阿什，你犯了個大錯。是嗎？  我的天，這攻擊力太強了吧。"}, {"type": "subtitle", "time": 8571.27, "timestamp": "02:22:51", "text": "你將為你的"}, {"type": "subtitle", "time": 8574.349, "timestamp": "02:22:54", "text": "罪行付出代價。你確定嗎？這只是個開始。  我知道你還在掛斷電話。  啊哈。"}]
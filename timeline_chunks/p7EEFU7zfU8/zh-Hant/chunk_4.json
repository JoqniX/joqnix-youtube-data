[{"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "son 寫了一些筆記，內容是正確的。"}, {"type": "subtitle", "time": 259.59, "timestamp": "00:04:19", "text": "我的天哪，我一定要讀讀那本書。我的"}, {"type": "subtitle", "time": 290.31, "timestamp": "00:04:50", "text": "東。東是在西邊，對吧？不，不，"}, {"type": "subtitle", "time": 292.39, "timestamp": "00:04:52", "text": "不，不，不。是西部嗎？西方。不"}]
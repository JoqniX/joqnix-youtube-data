[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "我只希望我們有足夠的空間容納他們"}, {"type": "subtitle", "time": 11104.309, "timestamp": "03:05:04", "text": "所有人。是的，迪也希望如此。但"}, {"type": "subtitle", "time": 11106.71, "timestamp": "03:05:06", "text": "如果你真的沒有地方安置它們了，"}, {"type": "subtitle", "time": 11109.59, "timestamp": "03:05:09", "text": "布魯德的皮克夫人和霍格莫的皮克會幫助"}, {"type": "subtitle", "time": 11112.469, "timestamp": "03:05:12", "text": "它們找到安全的房子。房間裡有什麼野獸"}, {"type": "subtitle", "time": 11115.03, "timestamp": "03:05:15", "text": "容不下嗎？是的，她"}, {"type": "subtitle", "time": 11117.59, "timestamp": "03:05:17", "text": "因幫助照顧需要幫助的動物而聞名，"}, {"type": "subtitle", "time": 11119.75, "timestamp": "03:05:19", "text": "而且她會給你一個合理的價格"}, {"type": "subtitle", "time": 11122.07, "timestamp": "03:05:22", "text": "。好的，那些我們可以賣掉。好的。"}, {"type": "subtitle", "time": 11124.63, "timestamp": "03:05:24", "text": "餵養得當、精心打理的野獸會"}, {"type": "subtitle", "time": 11126.75, "timestamp": "03:05:26", "text": "提供你珍貴的魔法"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "材料，例如蓬鬆的皮毛"}, {"type": "subtitle", "time": 11132.63, "timestamp": "03:05:32", "text": "。如果你能從"}, {"type": "subtitle", "time": 11134.79, "timestamp": "03:05:34", "text": "你的野獸身上收集到一些魔法材料，我們可以教"}, {"type": "subtitle", "time": 11136.95, "timestamp": "03:05:36", "text": "你如何使用它們。如何使用？"}, {"type": "subtitle", "time": 11138.79, "timestamp": "03:05:38", "text": "很好。等我有了會通知你"}, {"type": "subtitle", "time": 11142.309, "timestamp": "03:05:42", "text": "。是的。  我"}, {"type": "subtitle", "time": 11145.15, "timestamp": "03:05:45", "text": "得餵飽你們。"}, {"type": "subtitle", "time": 11146.97, "timestamp": "03:05:46", "text": "不，是時候餵你"}, {"type": "subtitle", "time": 11154.29, "timestamp": "03:05:54", "text": "。精彩的。"}]
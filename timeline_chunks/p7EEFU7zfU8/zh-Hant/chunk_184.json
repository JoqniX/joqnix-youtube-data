[{"type": "subtitle", "time": 11040.389, "timestamp": "03:04:00", "text": "天哪，這是一座島。  這裡"}, {"type": "subtitle", "time": 11042.55, "timestamp": "03:04:02", "text": "似乎是供你的牲畜"}, {"type": "subtitle", "time": 11044.55, "timestamp": "03:04:04", "text": "居住的地方。某種類型的溫室。一個"}, {"type": "subtitle", "time": 11047.11, "timestamp": "03:04:07", "text": "vavarium。你的野獸會很……那"}, {"type": "subtitle", "time": 11049.71, "timestamp": "03:04:09", "text": "是什麼？什麼？我聽著呢。"}, {"type": "subtitle", "time": 11052.79, "timestamp": "03:04:12", "text": "安全燈。或許你想釋放他們。"}, {"type": "subtitle", "time": 11056.15, "timestamp": "03:04:16", "text": "讓他們看看他們的新家。是的。 H代表"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "管理。我的天啊。我有很多這樣的書"}, {"type": "subtitle", "time": 11060.75, "timestamp": "03:04:20", "text": "。"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "你好。哦，等等。你"}, {"type": "subtitle", "time": 11084.309, "timestamp": "03:04:44", "text": "[音樂]"}, {"type": "subtitle", "time": 11088.23, "timestamp": "03:04:48", "text": "其他人呢？"}, {"type": "subtitle", "time": 11091.99, "timestamp": "03:04:51", "text": "接下來我要做的一切。"}, {"type": "subtitle", "time": 11094.389, "timestamp": "03:04:54", "text": "哦，看看他們。太可愛了。"}, {"type": "subtitle", "time": 11096.87, "timestamp": "03:04:56", "text": "藍鳥。德認為，動物飼養室將會是"}, {"type": "subtitle", "time": 11099.75, "timestamp": "03:04:59", "text": "你們這些動物們一個合適的新家。"}]
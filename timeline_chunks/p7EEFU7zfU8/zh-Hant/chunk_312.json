[{"type": "subtitle", "time": 18734.23, "timestamp": "05:12:14", "text": "哦不。我們走吧。抓到他了。  美好的。  上帝。  好的。  [音樂] 這些還可以。"}, {"type": "subtitle", "time": 18748.35, "timestamp": "05:12:28", "text": "我已經有了那些[音樂]。那我們現在該"}, {"type": "subtitle", "time": 18754.59, "timestamp": "05:12:34", "text": "怎麼辦？月亮背後的人。  呃，好的。外貌。好的。你知道嗎"}, {"type": "subtitle", "time": 18758.07, "timestamp": "05:12:38", "text": "？呃，已經四點了。"}, {"type": "subtitle", "time": 18759.83, "timestamp": "05:12:39", "text": "沒關係。  嗯，"}, {"type": "subtitle", "time": 18764.15, "timestamp": "05:12:44", "text": "我想把這件事做完。我養這兩個孩子已經有一段時間了。  所以，是丹特·基斯，對吧？"}]
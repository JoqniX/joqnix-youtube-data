[{"type": "subtitle", "time": 367.469, "timestamp": "00:06:07", "text": "猜是東吧。呃，我有截圖嗎？"}, {"type": "subtitle", "time": 370.39, "timestamp": "00:06:10", "text": "我沒有。等等，讓我截圖，把"}, {"type": "subtitle", "time": 390.67, "timestamp": "00:06:30", "text": "[音樂]"}, {"type": "subtitle", "time": 410.59000000000003, "timestamp": "00:06:50", "text": "東。你不累嗎？我"}, {"type": "subtitle", "time": 413.59000000000003, "timestamp": "00:06:53", "text": "確實是。我必須完成這件事。難道我不需要把它"}, {"type": "subtitle", "time": 415.30899999999997, "timestamp": "00:06:55", "text": "完成嗎？真"}]
[{"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "燃燒彈"}, {"type": "subtitle", "time": 14356.15, "timestamp": "03:59:16", "text": "煽動性。  那傢伙在哪裡？  好了"}, {"type": "subtitle", "time": 14363.189, "timestamp": "03:59:23", "text": "，又打到一隻蜘蛛了。蜘蛛在哪裡呢？爆炸。"}, {"type": "subtitle", "time": 14394.189, "timestamp": "03:59:54", "text": "但我卻爆炸了。  [音樂]"}]
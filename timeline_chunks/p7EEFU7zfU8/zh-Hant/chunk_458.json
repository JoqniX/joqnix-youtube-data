[{"type": "subtitle", "time": 27482.07, "timestamp": "07:38:02", "text": "呃，那個叫什麼來著？那根大柱子。東西。啊，好痛。"}, {"type": "subtitle", "time": 27487.75, "timestamp": "07:38:07", "text": "哦，等等。你可以飛起來什麼的。你可以往上飛。哦，"}, {"type": "subtitle", "time": 27491.03, "timestamp": "07:38:11", "text": "那樣會更快。你可以往上飛。什麼？什麼？我不知道。哇。我的天。我的"}, {"type": "subtitle", "time": 27493.51, "timestamp": "07:38:13", "text": "意思是，你可以，"}, {"type": "subtitle", "time": 27516.548, "timestamp": "07:38:36", "text": "但我覺得你需要從側面飛。是啊。那我就不知道了。我想……是啊，是因為降噪。我的天。我能……"}, {"type": "subtitle", "time": 27519.91, "timestamp": "07:38:39", "text": "我不能。這太難了。她就是這麼說的。我的天。我摔下去了。我的天。我摔下去了"}]
[{"type": "subtitle", "time": 194.03, "timestamp": "00:03:14", "text": "這是什麼？你如何從家"}, {"type": "subtitle", "time": 197.50900000000001, "timestamp": "00:03:17", "text": "到學校上班？但我沒去"}, {"type": "subtitle", "time": 207.43, "timestamp": "00:03:27", "text": "這是一份居家工作的工作。"}, {"type": "subtitle", "time": 210.63, "timestamp": "00:03:30", "text": "只參加考試，不過我還是得去"}, {"type": "subtitle", "time": 219.67000000000002, "timestamp": "00:03:39", "text": "。我不想騎車。"}, {"type": "subtitle", "time": 226.99, "timestamp": "00:03:46", "text": "寫下"}]
[{"type": "subtitle", "time": 11161.75, "timestamp": "03:06:01", "text": "[音樂]"}, {"type": "subtitle", "time": 11165.7, "timestamp": "03:06:05", "text": "我會這麼做。"}, {"type": "subtitle", "time": 11172.23, "timestamp": "03:06:12", "text": "[音樂]"}, {"type": "subtitle", "time": 11173.65, "timestamp": "03:06:13", "text": "找回"}, {"type": "subtitle", "time": 11182.11, "timestamp": "03:06:22", "text": "。哦，我可以去拿"}, {"type": "subtitle", "time": 11185.07, "timestamp": "03:06:25", "text": "。"}, {"type": "subtitle", "time": 11189.15, "timestamp": "03:06:29", "text": "莫娜。哦，我正在"}, {"type": "subtitle", "time": 11198.63, "timestamp": "03:06:38", "text": "[音樂]"}, {"type": "subtitle", "time": 11200.469, "timestamp": "03:06:40", "text": "和迪克談談。迪，我收集了一些"}, {"type": "subtitle", "time": 11203.03, "timestamp": "03:06:43", "text": "魔法材料。現在，迪伊可以"}, {"type": "subtitle", "time": 11205.59, "timestamp": "03:06:45", "text": "教你如何使用它們。哦，首先"}, {"type": "subtitle", "time": 11207.91, "timestamp": "03:06:47", "text": "你需要運用這種魔法來"}, {"type": "subtitle", "time": 11210.95, "timestamp": "03:06:50", "text": "召喚一台魔法織布機。一台織布"}, {"type": "subtitle", "time": 11213.75, "timestamp": "03:06:53", "text": "機？確切地。它能讓你"}, {"type": "subtitle", "time": 11216.07, "timestamp": "03:06:56", "text": "利用魔法材料，將"}, {"type": "subtitle", "time": 11217.99, "timestamp": "03:06:57", "text": "魔法融入衣服的每一根線"}, {"type": "subtitle", "time": 11219.59, "timestamp": "03:06:59", "text": "。等等，真的嗎？讓你的"}]
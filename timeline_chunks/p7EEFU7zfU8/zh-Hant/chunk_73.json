[{"type": "subtitle", "time": 4396.95, "timestamp": "01:13:16", "text": "靠近這個班級。我的天哪。菲妮立刻就"}, {"type": "subtitle", "time": 4399.59, "timestamp": "01:13:19", "text": "發現了他們。哇。我們繼續。像你餵傑拉德和尼爾斯一樣餵食和梳理麻疹。好的。這隻貓某種"}, {"type": "subtitle", "time": 4404.95, "timestamp": "01:13:24", "text": "動物"}, {"type": "subtitle", "time": 4407.83, "timestamp": "01:13:27", "text": "。"}, {"type": "subtitle", "time": 4412.189, "timestamp": "01:13:32", "text": "哦，"}, {"type": "subtitle", "time": 4415.709, "timestamp": "01:13:35", "text": "看看它們。實際上，它看起來像"}, {"type": "subtitle", "time": 4422.149, "timestamp": "01:13:42", "text": "隻貓，但尾巴像個大畫筆"}, {"type": "subtitle", "time": 4425.99, "timestamp": "01:13:45", "text": "。哦，畫筆項鍊。如果你喜歡，我可以給你一隻腳。膝蓋真的對你很有興趣。它們一眼就能認出來，我也一樣。看來我們的時間到了。請關上圍欄，各自離開。現在，"}, {"type": "subtitle", "time": 4428.229, "timestamp": "01:13:48", "text": "我們的新學生在哪裡"}, {"type": "subtitle", "time": 4434.31, "timestamp": "01:13:54", "text": "？嗨，我是沙爾多。你在這兒。請允許我跟你單獨聊一會兒。"}]
[{"type": "subtitle", "time": 11470.75, "timestamp": "03:11:10", "text": "[音樂]"}, {"type": "subtitle", "time": 11474.07, "timestamp": "03:11:14", "text": "切換裝備一樣，它具有一個主要攻擊屬性"}, {"type": "subtitle", "time": 11476.79, "timestamp": "03:11:16", "text": "和一個預設防禦屬性，預設情況下，"}, {"type": "subtitle", "time": 11478.95, "timestamp": "03:11:18", "text": "魔法物品可以與釀造"}, {"type": "subtitle", "time": 11482.87, "timestamp": "03:11:22", "text": "工藝一起使用，以增加或升級次要屬性"}, {"type": "subtitle", "time": 11486.469, "timestamp": "03:11:26", "text": "或將特性應用到你的裝備上。多次"}, {"type": "subtitle", "time": 11488.87, "timestamp": "03:11:28", "text": "小幅升級即可顯著"}, {"type": "subtitle", "time": 11492.63, "timestamp": "03:11:32", "text": "提升戰鬥力。新的蜜蜂可以被"}, {"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "拯救，"}, {"type": "subtitle", "time": 11497.91, "timestamp": "03:11:37", "text": "也可以在任務中解鎖。"}, {"type": "subtitle", "time": 11501.63, "timestamp": "03:11:41", "text": "可以在強盜營地解鎖新的交易配方。"}, {"type": "subtitle", "time": 11505.11, "timestamp": "03:11:45", "text": "好的。呃，我不知道該怎麼辦。"}, {"type": "subtitle", "time": 11508.75, "timestamp": "03:11:48", "text": "問號。"}, {"type": "subtitle", "time": 11511.63, "timestamp": "03:11:51", "text": "哦，視圖"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "升級了。我可以加強防禦。我"}]
[{"type": "subtitle", "time": 28624.07, "timestamp": "07:57:04", "text": "啊。軟體太簡陋了，用起來很困難。現在卻如此便捷。"}, {"type": "subtitle", "time": 28628.788, "timestamp": "07:57:08", "text": "所以，能夠弄清楚這些東西真的很酷，每當有新的軟體或創新的東西出現時，"}, {"type": "subtitle", "time": 28633.35, "timestamp": "07:57:13", "text": "你也會"}, {"type": "subtitle", "time": 28636.23, "timestamp": "07:57:16", "text": "嘗試一下。我喜歡"}, {"type": "subtitle", "time": 28664.708, "timestamp": "07:57:44", "text": "涉獵、實驗等等。這很棒。是的，這源自於我的另一個嗜好，我小時候喜歡製作音樂"}, {"type": "subtitle", "time": 28677.35, "timestamp": "07:57:57", "text": "很酷。是的。因為我曾經有一個成為"}]
[{"type": "subtitle", "time": 67.27, "timestamp": "00:01:07", "text": "嘿，聽聽下面的對話。"}, {"type": "subtitle", "time": 75.109, "timestamp": "00:01:15", "text": "哦，好的”。好的。好的。那是在"}, {"type": "subtitle", "time": 77.67, "timestamp": "00:01:17", "text": "底部。好的。我當時想，等等，難道我"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "應該聽聽招募錄音，"}, {"type": "subtitle", "time": 82.149, "timestamp": "00:01:22", "text": "然後猜猜他們在哪裡之"}, {"type": "subtitle", "time": 92.99000000000001, "timestamp": "00:01:32", "text": "富士"}, {"type": "subtitle", "time": 97.35, "timestamp": "00:01:37", "text": "酒店，你知道那種老大哥，呃，是"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "Oisan，不是Ojisan，是像上班族或"}, {"type": "subtitle", "time": 103.67, "timestamp": "00:01:43", "text": "成年人那樣的Ojisan，對吧？日本飯店裡"}, {"type": "subtitle", "time": 108.59, "timestamp": "00:01:48", "text": "有一種像成熟大叔一樣的說話方式，"}, {"type": "subtitle", "time": 115.03, "timestamp": "00:01:55", "text": "不像日本人那樣，他們的聲音很酷，"}]
[{"type": "subtitle", "time": 785.87, "timestamp": "00:13:05", "text": "。哦，我也有[音樂]。哦，等等。這是薩比塔在"}, {"type": "subtitle", "time": 792.55, "timestamp": "00:13:12", "text": "回答。不，不，不。"}, {"type": "subtitle", "time": 804.79, "timestamp": "00:13:24", "text": "薩比塔，等等，等等，等等，等等，等等，等等，等等。麗莎質問了她。薩比塔給了答案，麗莎回覆了薩比塔的訊息。"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "我們目前正在努力"}]
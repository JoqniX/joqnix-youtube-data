[{"type": "subtitle", "time": 22921.19, "timestamp": "06:22:01", "text": "學位需要幾年時間才能完成？  就像現在很多榮譽學位，你知道，會讓你經歷多年的競爭。  所以"}, {"type": "subtitle", "time": 22923.91, "timestamp": "06:22:03", "text": "我就想知道，到底過了多少年？不是三年嗎？是的，"}, {"type": "subtitle", "time": 22926.39, "timestamp": "06:22:06", "text": "實際上是三年了。通常需要三年。  所以"}, {"type": "subtitle", "time": 22940.07, "timestamp": "06:22:20", "text": "我覺得大多數學位都值四年，因為如果是三年制的國際學位，就"}, {"type": "subtitle", "time": 22951.59, "timestamp": "06:22:31", "text": "不會被承認為學位"}, {"type": "subtitle", "time": 22955.548, "timestamp": "06:22:35", "text": "。  [音樂] 所以"}, {"type": "subtitle", "time": 22963.708, "timestamp": "06:22:43", "text": "我就想，你打算怎麼辦？  我的意思是，我好像要帶著我的「加兩人」計畫去日本，對吧"}, {"type": "subtitle", "time": 22965.31, "timestamp": "06:22:45", "text": "？這就是為什麼我可以透過高中畢業文憑進入那所語言學校的原因，因為我還在攻讀學位，對吧"}, {"type": "subtitle", "time": 22969.75, "timestamp": "06:22:49", "text": "？所以，我手邊還沒有學位證書。嗯，我當時就在想你是不是得讀碩士。"}, {"type": "subtitle", "time": 22975.99, "timestamp": "06:22:55", "text": "我非常肯定"}, {"type": "subtitle", "time": 22977.83, "timestamp": "06:22:57", "text": "他們不會承認這個學位。  不過我也不確定。是的"}]
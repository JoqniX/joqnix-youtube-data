[{"type": "subtitle", "time": 10863.83, "timestamp": "03:01:03", "text": "哦，你的野獸背包已滿。"}, {"type": "subtitle", "time": 10864.99, "timestamp": "03:01:04", "text": "哦好的。  呃，"}, {"type": "subtitle", "time": 10894.469, "timestamp": "03:01:34", "text": "我沒明白嗎？這是一個可交互對象。為什麼？我應該做這件事。  雖然比"}, {"type": "subtitle", "time": 10901.51, "timestamp": "03:01:41", "text": "其他的要難一些，"}, {"type": "subtitle", "time": 10903.51, "timestamp": "03:01:43", "text": "但我現在得了月咳。我們走吧。  又一個"}, {"type": "subtitle", "time": 10906.23, "timestamp": "03:01:46", "text": "猛獸。平安無事。是的，德。"}, {"type": "subtitle", "time": 10908.71, "timestamp": "03:01:48", "text": "我們沒看到月亮。我知道。迪，這景象"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "太壯觀了。迪伊覺得"}, {"type": "subtitle", "time": 10913.67, "timestamp": "03:01:53", "text": "你已經完成了。你將能夠救出更多野獸。但現在，我們先把收集到的"}, {"type": "subtitle", "time": 10917.91, "timestamp": "03:01:57", "text": "那些東西帶回"}]
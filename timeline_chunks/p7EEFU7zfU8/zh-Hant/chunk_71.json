[{"type": "subtitle", "time": 4284.83, "timestamp": "01:11:24", "text": "，怎麼用啊。哦，好的。疼痛。好的，讓我看看。刷一刷。真可愛。我相信他感覺好多了。看看這個。你"}, {"type": "subtitle", "time": 4293.51, "timestamp": "01:11:33", "text": "可能餓了。"}, {"type": "subtitle", "time": 4309.59, "timestamp": "01:11:49", "text": "你介意給他一些野獸飼料嗎？"}, {"type": "subtitle", "time": 4313.03, "timestamp": "01:11:53", "text": "不。你要把這個咒語給我，是嗎？三。哦，我猜這些顆粒"}]
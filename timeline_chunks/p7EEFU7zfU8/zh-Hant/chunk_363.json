[{"type": "subtitle", "time": 21781.67, "timestamp": "06:03:01", "text": "想參加一天。是的，你應該這麼做。確實很酷。太好了"}, {"type": "subtitle", "time": 21785.59, "timestamp": "06:03:05", "text": "。不只是那種"}, {"type": "subtitle", "time": 21787.35, "timestamp": "06:03:07", "text": "Vocaloid 音樂，嗯，那是"}, {"type": "subtitle", "time": 21794.548, "timestamp": "06:03:14", "text": "我很期待的事。如果可能的話，等我的語言課程結束後，我可能會嘗試把它當作副業來做"}, {"type": "subtitle", "time": 21811.51, "timestamp": "06:03:31", "text": "。嗯，就像職業學校那種課程。好吧，我的意思是，你"}, {"type": "subtitle", "time": 21813.91, "timestamp": "06:03:33", "text": "總是可以去日本，也許加入一家公司，他們會僱用學習教練之類的"}, {"type": "subtitle", "time": 21821.43, "timestamp": "06:03:41", "text": "，你打算……"}, {"type": "subtitle", "time": 21831.22, "timestamp": "06:03:51", "text": "呃……怎麼說呢，發布一些關於汽車的歌曲嗎？  汽車"}, {"type": "subtitle", "time": 21833.35, "timestamp": "06:03:53", "text": "歌曲。是的。"}, {"type": "subtitle", "time": 21837.11, "timestamp": "06:03:57", "text": "你做這件事的時候總是很害羞。是的。我仍然"}]
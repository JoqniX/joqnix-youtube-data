[{"type": "subtitle", "time": 4157.189, "timestamp": "01:09:17", "text": "好嗎？好的，霍文教授。他"}, {"type": "subtitle", "time": 4172.47, "timestamp": "01:09:32", "text": "做了什麼？我是波比。波比·斯威廷。別擔心教授。哦，我的天哪，她的聲音真好聽。有時候誇張一點。班上的所有動物都很安全。我演示請集中註意力。泡芙的舌頭可是個滑溜溜的魔鬼。好的。"}, {"type": "subtitle", "time": 4190.03, "timestamp": "01:09:50", "text": "為什麼要打開推特？"}, {"type": "subtitle", "time": 4195.11, "timestamp": "01:09:55", "text": "你需要知道的一切。哦，原來你展示"}]
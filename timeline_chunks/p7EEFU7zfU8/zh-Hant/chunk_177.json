[{"type": "subtitle", "time": 10625.429, "timestamp": "02:57:05", "text": "月球車吧。德會等你回來。你好。他要打個響指就走。提前準備。 F. 是的。  你好。"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "夜幕降臨，迪克還在這裡。哦，他正在耐心地等我們。我太高興了。我想"}, {"type": "subtitle", "time": 10645.99, "timestamp": "02:57:25", "text": "抱抱這頭小公牛。月球車。一，二。哦，哦。  三。已購入。  請安靜"}, {"type": "subtitle", "time": 10648.63, "timestamp": "02:57:28", "text": "下來。"}, {"type": "subtitle", "time": 10669.79, "timestamp": "02:57:49", "text": "我沒有惡意。  你等著瞧吧。這裡還有一隻松鼠。我可以收養這隻"}, {"type": "subtitle", "time": 10673.309, "timestamp": "02:57:53", "text": "松鼠嗎？等等，另一顆月亮去哪了？嘿喲。好的，我看到有動靜了。我看到有動靜。我看到有動靜。"}]
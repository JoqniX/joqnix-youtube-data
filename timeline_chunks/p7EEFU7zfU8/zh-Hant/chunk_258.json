[{"type": "subtitle", "time": 15499.389, "timestamp": "04:18:19", "text": "很懷念《你好，Bmont 女士》。"}, {"type": "subtitle", "time": 15507.71, "timestamp": "04:18:27", "text": "好消息。我成功清除了蘭洛克的營地。"}, {"type": "subtitle", "time": 15510.149, "timestamp": "04:18:30", "text": "你把它們都清理掉了？"}, {"type": "subtitle", "time": 15513.269, "timestamp": "04:18:33", "text": "如何？我確實"}]
[{"type": "subtitle", "time": 20822.708, "timestamp": "05:47:02", "text": "我必須理解基本原理，學習和堅持"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "某種音樂風格"}, {"type": "subtitle", "time": 20828.07, "timestamp": "05:47:08", "text": "等等，這有點難，我在音樂方面仍然很迷茫。所以最後我還是得繼續，繼續在日本做一些事。"}, {"type": "subtitle", "time": 20831.31, "timestamp": "05:47:11", "text": "所以，我必須先買到筆記型"}, {"type": "subtitle", "time": 20838.07, "timestamp": "05:47:18", "text": "電腦。不，因為我可以做直播、做音樂、做所有"}, {"type": "subtitle", "time": 20847.51, "timestamp": "05:47:27", "text": "事、工作和學習，所有事情都可以。  是的。他拿到筆記型電腦了嗎？還是我？你打算買嗎？"}, {"type": "subtitle", "time": 20853.11, "timestamp": "05:47:33", "text": "打算從那裡購買。是的，你可能至少應該在去之前確定"}, {"type": "subtitle", "time": 20866.31, "timestamp": "05:47:46", "text": "你想買哪個型號。是的。  是的。那你打算在那裡買嗎？對，在那兒買吧"}, {"type": "subtitle", "time": 20874.708, "timestamp": "05:47:54", "text": "。所以，這邊的學院，當地的學院，他們說他們那裡有一些人，等我到了日本，他們會幫助我，他們會陪我去商店，我們會一起買那個東西。你好，我"}, {"type": "subtitle", "time": 20876.708, "timestamp": "05:47:56", "text": "是說，打個招呼"}, {"type": "subtitle", "time": 20879.51, "timestamp": "05:47:59", "text": "。  在日本購買會"}]
[{"type": "subtitle", "time": 11221.75, "timestamp": "03:07:01", "text": "衣服在很多方面更有用"}, {"type": "subtitle", "time": 11225.269, "timestamp": "03:07:05", "text": "。哦，就像元素魔法，呃，就像給"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "裝備添加元素效果，例如閃電耐久度之類的。諸如此類。"}, {"type": "subtitle", "time": 11235.87, "timestamp": "03:07:15", "text": "織布機。"}, {"type": "subtitle", "time": 11239.67, "timestamp": "03:07:19", "text": "好的。你們這些人玩得很開心。好的。我"}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": "不知道該怎麼處置這些"}, {"type": "subtitle", "time": 11244.03, "timestamp": "03:07:24", "text": "人，也許我會把他們賣掉。"}, {"type": "subtitle", "time": 11246.79, "timestamp": "03:07:26", "text": "問號。我想把他留在這裡。"}, {"type": "subtitle", "time": 11253.309, "timestamp": "03:07:33", "text": "你移除嗎？我挺喜歡這種"}, {"type": "subtitle", "time": 11256.59, "timestamp": "03:07:36", "text": "黑白照片的。如果你那樣做，會有什麼不好的影響嗎"}, {"type": "subtitle", "time": 11258.95, "timestamp": "03:07:38", "text": "？對不起。我永遠無法"}, {"type": "subtitle", "time": 11261.75, "timestamp": "03:07:41", "text": "相信這是真的。對不起。我就是喜歡"}, {"type": "subtitle", "time": 11263.95, "timestamp": "03:07:43", "text": "你。"}, {"type": "subtitle", "time": 11266.79, "timestamp": "03:07:46", "text": "好的。我就是喜歡這個。它看起來像一輛"}]
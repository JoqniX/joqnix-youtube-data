[{"type": "subtitle", "time": 25745.27, "timestamp": "07:09:05", "text": "。我今天幾乎沒睡。"}, {"type": "subtitle", "time": 25748.868, "timestamp": "07:09:08", "text": "呃呃，我得"}, {"type": "subtitle", "time": 25753.948, "timestamp": "07:09:13", "text": "吃點東西。我"}, {"type": "subtitle", "time": 25756.708, "timestamp": "07:09:16", "text": "很快會回來。我猜我確實放了東西，嗯，我把它蓋住了。"}, {"type": "subtitle", "time": 25764.868, "timestamp": "07:09:24", "text": "所以，我得再看看我的午餐，還有，如果你去我的…等等，你發了視訊留言？等等，什麼？我的天哪"}, {"type": "subtitle", "time": 25769.75, "timestamp": "07:09:29", "text": "。"}, {"type": "subtitle", "time": 25797.27, "timestamp": "07:09:57", "text": "的天啊。等等，什麼？"}, {"type": "subtitle", "time": 25799.23, "timestamp": "07:09:59", "text": "啊，評論"}]
[{"type": "subtitle", "time": 29581.51, "timestamp": "08:13:01", "text": "救你嗎？  沒有。我勉強還活著。我的引擎沒有損壞。  你會成功的。  當然。"}, {"type": "subtitle", "time": 29593.11, "timestamp": "08:13:13", "text": "我正在接近敵人"}, {"type": "subtitle", "time": 29595.43, "timestamp": "08:13:15", "text": "。我希望我能幹掉它。離我這裡大約4公里。但我注意到，如果我從遠處射擊它們"}, {"type": "subtitle", "time": 29606.23, "timestamp": "08:13:26", "text": "。是的，這對他們沒有任何傷害。所以，我正在努力接近他們。"}, {"type": "subtitle", "time": 29608.868, "timestamp": "08:13:28", "text": "哦，是別人"}, {"type": "subtitle", "time": 29611.19, "timestamp": "08:13:31", "text": "拍的。是別人開的"}, {"type": "subtitle", "time": 29619.19, "timestamp": "08:13:39", "text": "槍。我死了。  當然。我死了。哦，不。你死了嗎？  哦，不。好的，我會帶我的"}, {"type": "subtitle", "time": 29627.27, "timestamp": "08:13:47", "text": "第二架飛機過來。  我的天哪。我會等你一會兒。在此"}, {"type": "subtitle", "time": 29635.35, "timestamp": "08:13:55", "text": "之前，讓我來幫你減少敵人的數量。等你到這裡的時候，我可能已經坐了兩、三架飛機了。你好"}]
[{"type": "subtitle", "time": 9984.309, "timestamp": "02:46:24", "text": "背包。如果能"}, {"type": "subtitle", "time": 9985.469, "timestamp": "02:46:25", "text": "看到它被"}, {"type": "subtitle", "time": 10000.95, "timestamp": "02:46:40", "text": "用於[音樂]方面的好事，那就太好了。呃，不，不，不，不，不。這裡為什麼是點頭？  轉變。我明白了。所以"}, {"type": "subtitle", "time": 10002.95, "timestamp": "02:46:42", "text": "我正在等待一個"}, {"type": "subtitle", "time": 10005.51, "timestamp": "02:46:45", "text": "卡達瓦咒語。我一直在等這個。你什麼時候把這些東西給我？眨眼。  我想我們得學個新咒語了。  我們"}, {"type": "subtitle", "time": 10008.19, "timestamp": "02:46:48", "text": "到了"}]
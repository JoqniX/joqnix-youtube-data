[{"type": "subtitle", "time": 13565.83, "timestamp": "03:46:05", "text": "バードの日記からの抜粋。彼"}, {"type": "subtitle", "time": 13569.189, "timestamp": "03:46:09", "text": "耳にしたささやき声。何か計画を立てる"}, {"type": "subtitle", "time": 13570.92, "timestamp": "03:46:10", "text": "私と一緒に。"}, {"type": "subtitle", "time": 13573.03, "timestamp": "03:46:13", "text": "[拍手]"}, {"type": "subtitle", "time": 13578.229, "timestamp": "03:46:18", "text": "[音楽]"}, {"type": "subtitle", "time": 13600.51, "timestamp": "03:46:40", "text": "私は"}, {"type": "subtitle", "time": 13607.95, "timestamp": "03:46:47", "text": "[拍手]"}, {"type": "subtitle", "time": 13609.83, "timestamp": "03:46:49", "text": "[音楽]"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "よし、これで３つだ。よし、落ち着け"}, {"type": "subtitle", "time": 13616.229, "timestamp": "03:46:56", "text": "あなた自身。あなたに危害を加えるつもりはありません。"}, {"type": "subtitle", "time": 13619.29, "timestamp": "03:46:59", "text": "あと1つ。"}]
[{"type": "subtitle", "time": 608.55, "timestamp": "00:10:08", "text": "嘘。つまり、誰かが"}, {"type": "subtitle", "time": 620.35, "timestamp": "00:10:20", "text": "お湯は"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "天気。あなたは会話に前向きですね。うん、"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "私はオープンすぎるので、私は、私は、私は"}, {"type": "subtitle", "time": 633.31, "timestamp": "00:10:33", "text": "そうしないように自分を律する必要がある。"}, {"type": "subtitle", "time": 659.35, "timestamp": "00:10:59", "text": "しかし、それは悪いことではない。親切です"}]
[{"type": "subtitle", "time": 5520.91, "timestamp": "01:32:00", "text": "ニース。"}, {"type": "subtitle", "time": 5525.39, "timestamp": "01:32:05", "text": "こんにちは。ねえ、実際に中に入ることはできる？"}, {"type": "subtitle", "time": 5529.629, "timestamp": "01:32:09", "text": "今？宝箱がたくさんあって"}, {"type": "subtitle", "time": 5533.27, "timestamp": "01:32:13", "text": "実際に訪れてみたい場所だけど、"}, {"type": "subtitle", "time": 5543.149, "timestamp": "01:32:23", "text": "ない。うん、そうするよ"}, {"type": "subtitle", "time": 5546.31, "timestamp": "01:32:26", "text": "後で。行き詰まってしまった。通り過ぎるだけ。"}, {"type": "subtitle", "time": 5548.709, "timestamp": "01:32:28", "text": "城の外で会えてよかった。あなた"}, {"type": "subtitle", "time": 5551.149, "timestamp": "01:32:31", "text": "アミットもそうだ。"}, {"type": "subtitle", "time": 5566.629, "timestamp": "01:32:46", "text": "彼女はなぜここにいるのだろうか？"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5577.95, "timestamp": "01:32:57", "text": "うん。"}]
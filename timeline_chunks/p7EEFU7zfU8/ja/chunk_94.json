[{"type": "subtitle", "time": 5643.669, "timestamp": "01:34:03", "text": "あなたを信じます。わかった。ええ、私は知っているかもしれません"}, {"type": "subtitle", "time": 5646.07, "timestamp": "01:34:06", "text": "それは私たち双方にとって有益なことかもしれない。離れて"}, {"type": "subtitle", "time": 5648.79, "timestamp": "01:34:08", "text": "ランロックに計画を打ち明けてもらうために"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "自分。聞いています。何年も前、凶悪な"}, {"type": "subtitle", "time": 5655.189, "timestamp": "01:34:15", "text": "魔女がゴブリンの聖なる遺物を盗んだ。噂"}, {"type": "subtitle", "time": 5657.39, "timestamp": "01:34:17", "text": "それは今、彼女の手に委ねられている"}, {"type": "subtitle", "time": 5660.629, "timestamp": "01:34:20", "text": "墓の中にある石棺は"}, {"type": "subtitle", "time": 5662.83, "timestamp": "01:34:22", "text": "魔法使いのような。ウィザード"}, {"type": "subtitle", "time": 5666.229, "timestamp": "01:34:26", "text": "少し前にちょっとした仲違いがあったんです。うん、"}, {"type": "subtitle", "time": 5668.95, "timestamp": "01:34:28", "text": "日食のせいで死ぬことはない"}, {"type": "subtitle", "time": 5670.75, "timestamp": "01:34:30", "text": "間"}, {"type": "subtitle", "time": 5674.95, "timestamp": "01:34:34", "text": "明日、それから。ああ、わかった。非常によく。"}, {"type": "subtitle", "time": 5676.95, "timestamp": "01:34:36", "text": "約束してくれるなら、遺物を取り戻します"}, {"type": "subtitle", "time": 5679.11, "timestamp": "01:34:39", "text": "ランロックの計画を私と共有するため。私たちは"}, {"type": "subtitle", "time": 5681.83, "timestamp": "01:34:41", "text": "お互いを信頼し合う必要があるだろう。私は"}, {"type": "subtitle", "time": 5684.31, "timestamp": "01:34:44", "text": "あなたは聖遺物を持ち逃げしてはならない。"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "私が学んだことを皆さんと共有します。集める"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "必要な物資を何でも満たし、"}, {"type": "subtitle", "time": 5692.709, "timestamp": "01:34:52", "text": "魔女の墓の近くにいる私。"}]
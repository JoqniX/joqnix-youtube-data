[{"type": "subtitle", "time": 15960.429, "timestamp": "04:26:00", "text": "私"}, {"type": "subtitle", "time": 15963.189, "timestamp": "04:26:03", "text": "パフォーマンス？ FPSが表示されるはずですが、"}, {"type": "subtitle", "time": 15972.51, "timestamp": "04:26:12", "text": "奇妙な。グラフィック設定を下げましたか？"}, {"type": "subtitle", "time": 15975.79, "timestamp": "04:26:15", "text": "また？一体どういうことだ？その"}, {"type": "subtitle", "time": 15980.149, "timestamp": "04:26:20", "text": "低速で。すみません。これはウルトラだ。何"}, {"type": "subtitle", "time": 15983.11, "timestamp": "04:26:23", "text": "私は何をしているのですか？ 4090とかそんな感じ。いいえ"}, {"type": "subtitle", "time": 15986.83, "timestamp": "04:26:26", "text": "私のPCがこんなに熱くなるなんて不思議だ"}, {"type": "subtitle", "time": 15995.22, "timestamp": "04:26:35", "text": "えっ？何てことだ。"}, {"type": "subtitle", "time": 15996.87, "timestamp": "04:26:36", "text": "[音楽]"}, {"type": "subtitle", "time": 16000.229, "timestamp": "04:26:40", "text": "1490ダイヤルがあればよかったのに。すべて"}, {"type": "subtitle", "time": 16009.11, "timestamp": "04:26:49", "text": "私はあの荒らしと戦うか、"}]
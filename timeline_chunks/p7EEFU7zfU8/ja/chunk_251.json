[{"type": "subtitle", "time": 15061.03, "timestamp": "04:11:01", "text": "そうですね、でも学生ってどんな感じですか？"}, {"type": "subtitle", "time": 15063.51, "timestamp": "04:11:03", "text": "あなたは今何をしているのですか？道に迷ってしまった、"}, {"type": "subtitle", "time": 15066.229, "timestamp": "04:11:06", "text": "そうしたのですか？"}, {"type": "subtitle", "time": 15068.309, "timestamp": "04:11:08", "text": "私はします。私はただ田舎を探索している"}, {"type": "subtitle", "time": 15071.51, "timestamp": "04:11:11", "text": "少し。ああ、たまには日常から抜け出すのもいいものだ"}, {"type": "subtitle", "time": 15074.63, "timestamp": "04:11:14", "text": "その後。私もどちらかというと放浪癖があるんです。で"}, {"type": "subtitle", "time": 15078.55, "timestamp": "04:11:18", "text": "実際、名前はレオポルド・バブコックで、私は"}, {"type": "subtitle", "time": 15082.309, "timestamp": "04:11:22", "text": "私は確かに販売目的でここにいます。さて、誰かのために"}, {"type": "subtitle", "time": 15084.55, "timestamp": "04:11:24", "text": "あなたと同じように"}, {"type": "subtitle", "time": 15087.03, "timestamp": "04:11:27", "text": "さまよう、私は"}, {"type": "subtitle", "time": 15089.269, "timestamp": "04:11:29", "text": "ウィガンウェルドを維持することの重要性"}, {"type": "subtitle", "time": 15091.91, "timestamp": "04:11:31", "text": "手元に薬がある。私は足を踏み入れる勇気はない"}, {"type": "subtitle", "time": 15093.59, "timestamp": "04:11:33", "text": "禁断の森のような場所で"}, {"type": "subtitle", "time": 15095.99, "timestamp": "04:11:35", "text": "安定した供給がない。あなたは何を"}, {"type": "subtitle", "time": 15098.15, "timestamp": "04:11:38", "text": "ねえ、若い友よ？尺度"}, {"type": "subtitle", "time": 15101.269, "timestamp": "04:11:41", "text": "今後の道のりの安全。何か"}, {"type": "subtitle", "time": 15103.189, "timestamp": "04:11:43", "text": "考慮する。ご協力ありがとうございました、〇〇さん。"}, {"type": "subtitle", "time": 15105.51, "timestamp": "04:11:45", "text": "ベルコック。ねえ、もし見かけたら教えてね"}, {"type": "subtitle", "time": 15107.55, "timestamp": "04:11:47", "text": "あなたが好きなもの。"}, {"type": "subtitle", "time": 15109.99, "timestamp": "04:11:49", "text": "ねえ、ベイビー。もう出発するかもしれない。感謝"}, {"type": "subtitle", "time": 15113.349, "timestamp": "04:11:53", "text": "あなた。神様、私は"}]
[{"type": "subtitle", "time": 4140.95, "timestamp": "01:09:00", "text": "DMのことだよ。私はただこれをしたいだけです"}, {"type": "subtitle", "time": 4143.149, "timestamp": "01:09:03", "text": "本物"}, {"type": "subtitle", "time": 4157.189, "timestamp": "01:09:17", "text": "メイト。わかった。すべて。わかった。ストリーム"}, {"type": "subtitle", "time": 4160.51, "timestamp": "01:09:20", "text": "水が出ています。それは"}, {"type": "subtitle", "time": 4163.669, "timestamp": "01:09:23", "text": "良い。よし。ええと、私たちは"}, {"type": "subtitle", "time": 4172.47, "timestamp": "01:09:32", "text": "ギヤ。何か良い装備はありますか？いいえ、"}, {"type": "subtitle", "time": 4175.07, "timestamp": "01:09:35", "text": "何もない。はい、それは"}, {"type": "subtitle", "time": 4179.229, "timestamp": "01:09:39", "text": "大丈夫。ええ、そうですね。こんにちは、"}, {"type": "subtitle", "time": 4190.03, "timestamp": "01:09:50", "text": "こんにちは。そうでない場合はどうなるか"}, {"type": "subtitle", "time": 4192.709, "timestamp": "01:09:52", "text": "の上？電源が入っていない場合はどうなりますか？理解します"}, {"type": "subtitle", "time": 4195.11, "timestamp": "01:09:55", "text": "ストリームは、"}, {"type": "subtitle", "time": 4197.669, "timestamp": "01:09:57", "text": "この物。だから私は普段自分の"}]
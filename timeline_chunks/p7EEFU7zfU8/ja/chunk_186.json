[{"type": "subtitle", "time": 11161.75, "timestamp": "03:06:01", "text": "[音楽]"}, {"type": "subtitle", "time": 11165.7, "timestamp": "03:06:05", "text": "私はこれをやります。"}, {"type": "subtitle", "time": 11172.23, "timestamp": "03:06:12", "text": "[音楽]"}, {"type": "subtitle", "time": 11173.65, "timestamp": "03:06:13", "text": "得る"}, {"type": "subtitle", "time": 11182.11, "timestamp": "03:06:22", "text": "戻る。ああ、私は集めることができます"}, {"type": "subtitle", "time": 11185.07, "timestamp": "03:06:25", "text": "それ。"}, {"type": "subtitle", "time": 11189.15, "timestamp": "03:06:29", "text": "モナ。ああ、私は"}, {"type": "subtitle", "time": 11198.63, "timestamp": "03:06:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11200.469, "timestamp": "03:06:40", "text": "ディークと話してください。いくつか集めました"}, {"type": "subtitle", "time": 11203.03, "timestamp": "03:06:43", "text": "魔法の素材だよ、ディー。今、ディーは"}, {"type": "subtitle", "time": 11205.59, "timestamp": "03:06:45", "text": "それらの使い方をお教えします。ああ、まず"}, {"type": "subtitle", "time": 11207.91, "timestamp": "03:06:47", "text": "この呪文を使う必要がある"}, {"type": "subtitle", "time": 11210.95, "timestamp": "03:06:50", "text": "魔法の織機を召喚する。迫り来る"}, {"type": "subtitle", "time": 11213.75, "timestamp": "03:06:53", "text": "機械？その通り。これにより、"}, {"type": "subtitle", "time": 11216.07, "timestamp": "03:06:56", "text": "魔法の素材を使って織る"}, {"type": "subtitle", "time": 11217.99, "timestamp": "03:06:57", "text": "あなたの糸の奥深くに魔法をかける"}, {"type": "subtitle", "time": 11219.59, "timestamp": "03:06:59", "text": "衣服。え、本当に？あなたの"}]
[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "カッコウに話しかけてみて。カッコウって何でしたっけ？"}, {"type": "subtitle", "time": 1802.15, "timestamp": "00:30:02", "text": "いいね。"}, {"type": "subtitle", "time": 1809.909, "timestamp": "00:30:09", "text": "語彙を覚えなければ、"}, {"type": "subtitle", "time": 1812.75, "timestamp": "00:30:12", "text": "確かに私は苦労するだろう"}, {"type": "subtitle", "time": 1819.23, "timestamp": "00:30:19", "text": "する"}, {"type": "subtitle", "time": 1821.63, "timestamp": "00:30:21", "text": "の"}, {"type": "subtitle", "time": 1843.549, "timestamp": "00:30:43", "text": "ジン。わかった。この男か、あるいはもう一人。うん。"}, {"type": "subtitle", "time": 1853.63, "timestamp": "00:30:53", "text": "こんにちは。そして4番目"}, {"type": "subtitle", "time": 1856.23, "timestamp": "00:30:56", "text": "1つ。 4つ目は異質なものだ"}, {"type": "subtitle", "time": 1858.07, "timestamp": "00:30:58", "text": "このことから"}]
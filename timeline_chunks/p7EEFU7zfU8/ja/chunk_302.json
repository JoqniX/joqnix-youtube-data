[{"type": "subtitle", "time": 18120.15, "timestamp": "05:02:00", "text": "つまり、私たちは競合相手を失ったということだ。つまり、"}, {"type": "subtitle", "time": 18123.07, "timestamp": "05:02:03", "text": "より優れた競争相手。しかし"}, {"type": "subtitle", "time": 18126.23, "timestamp": "05:02:06", "text": "さて、えっと、これは"}, {"type": "subtitle", "time": 18129.19, "timestamp": "05:02:09", "text": "中国製のGPUブランド。名前を忘れてしまった。"}, {"type": "subtitle", "time": 18131.59, "timestamp": "05:02:11", "text": "すごくいい感じだよ。彼らは捕らえている"}, {"type": "subtitle", "time": 18134.47, "timestamp": "05:02:14", "text": "Nvidia、IMD、Intelのような企業まで。私"}, {"type": "subtitle", "time": 18137.19, "timestamp": "05:02:17", "text": "名前は忘れちゃったけど。ちょっと忘れてた"}, {"type": "subtitle", "time": 18139.75, "timestamp": "05:02:19", "text": "名前がね。"}, {"type": "subtitle", "time": 18143.55, "timestamp": "05:02:23", "text": "私はいくつかのクリップを見た"}, {"type": "subtitle", "time": 18150.83, "timestamp": "05:02:30", "text": "[音楽]"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": "どれの。だから、私は"}, {"type": "subtitle", "time": 18156.948, "timestamp": "05:02:36", "text": "実際に得るために考えるプロセス"}, {"type": "subtitle", "time": 18160.09, "timestamp": "05:02:40", "text": "3台目のジープPC。"}, {"type": "subtitle", "time": 18162.59, "timestamp": "05:02:42", "text": "[音楽]"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "おお、それはいかがですか？ええ、そうでした"}, {"type": "subtitle", "time": 18169.55, "timestamp": "05:02:49", "text": "実際にカードを購入しようと考えています"}, {"type": "subtitle", "time": 18173.23, "timestamp": "05:02:53", "text": "PC。ジョー、あなたはこう思っているかもしれません。"}, {"type": "subtitle", "time": 18176.27, "timestamp": "05:02:56", "text": "なぜ？しないで"}]
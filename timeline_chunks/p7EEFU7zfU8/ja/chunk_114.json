[{"type": "subtitle", "time": 6842.47, "timestamp": "01:54:02", "text": "それから。わかった。これは何ですか？ああ、もう1つ"}, {"type": "subtitle", "time": 6843.669, "timestamp": "01:54:03", "text": "血液の分布場所。"}, {"type": "subtitle", "time": 6845.149, "timestamp": "01:54:05", "text": "前に"}, {"type": "subtitle", "time": 6848.07, "timestamp": "01:54:08", "text": "その胸"}, {"type": "subtitle", "time": 6851.07, "timestamp": "01:54:11", "text": "レリア。"}, {"type": "subtitle", "time": 6854.07, "timestamp": "01:54:14", "text": "えっと、あの場所はただ私が行くところです"}, {"type": "subtitle", "time": 6859.39, "timestamp": "01:54:19", "text": "行くよ"}, {"type": "subtitle", "time": 6865.55, "timestamp": "01:54:25", "text": "おお。何が"}, {"type": "subtitle", "time": 6868.31, "timestamp": "01:54:28", "text": "これ？完了しました。何？そうだと思います。は"}, {"type": "subtitle", "time": 6875.229, "timestamp": "01:54:35", "text": "彼らを逮捕するとき"}, {"type": "subtitle", "time": 6883.189, "timestamp": "01:54:43", "text": "待って、あれは何？まるで"}]
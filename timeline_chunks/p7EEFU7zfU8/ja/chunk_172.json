[{"type": "subtitle", "time": 10321.95, "timestamp": "02:52:01", "text": "彼はまるでパチンと音がしたように消え去った"}, {"type": "subtitle", "time": 10337.19, "timestamp": "02:52:17", "text": "今。その城はきっとかなり"}, {"type": "subtitle", "time": 10340.55, "timestamp": "02:52:20", "text": "当時としては威厳のある佇まいだった。"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "ホグワーツを見下ろす場所。よし、じゃあこれは"}, {"type": "subtitle", "time": 10353.63, "timestamp": "02:52:33", "text": "木。"}, {"type": "subtitle", "time": 10362.23, "timestamp": "02:52:42", "text": "そこには。それは羊のような女王だ。羊の"}, {"type": "subtitle", "time": 10366.07, "timestamp": "02:52:46", "text": "羊ちゃん、羊ちゃん。攻撃してしまって申し訳ありません。"}, {"type": "subtitle", "time": 10368.55, "timestamp": "02:52:48", "text": "食べ物が欲しいですか？疑問符。待って、"}]
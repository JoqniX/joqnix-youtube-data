[{"type": "subtitle", "time": 15300.83, "timestamp": "04:15:00", "text": "忘れ去られる。他の集落のことも心配だ。"}, {"type": "subtitle", "time": 15303.51, "timestamp": "04:15:03", "text": "確かに、ランロックとその仲間たちは"}, {"type": "chat", "time": 15305.976, "timestamp": "04:15:05", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "sup"}, {"type": "subtitle", "time": 15306.149, "timestamp": "04:15:06", "text": "私が今まで見たゴブリンの中では。"}, {"type": "subtitle", "time": 15307.67, "timestamp": "04:15:07", "text": "慈悲、"}, {"type": "subtitle", "time": 15314.389, "timestamp": "04:15:14", "text": "何をお探しですか？ありがとう。"}, {"type": "subtitle", "time": 15318.99, "timestamp": "04:15:18", "text": "買ってよかった"}, {"type": "subtitle", "time": 15321.67, "timestamp": "04:15:21", "text": "これ。それでは不十分だ。じゃあ、買います。"}, {"type": "subtitle", "time": 15325.11, "timestamp": "04:15:25", "text": "お、それがお好きなんですね？素晴らしい選択です。"}, {"type": "subtitle", "time": 15331.95, "timestamp": "04:15:31", "text": "立ち寄っていただきありがとうございました。"}, {"type": "subtitle", "time": 15333.75, "timestamp": "04:15:33", "text": "[音楽]"}]
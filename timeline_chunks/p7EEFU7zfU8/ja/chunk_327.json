[{"type": "subtitle", "time": 19621.75, "timestamp": "05:27:01", "text": "スタジオ。"}, {"type": "subtitle", "time": 19624.708, "timestamp": "05:27:04", "text": "ああ、よかった。すべて順調です。大丈夫ですよ。わかった"}, {"type": "subtitle", "time": 19626.23, "timestamp": "05:27:06", "text": "それから。"}, {"type": "subtitle", "time": 19630.788, "timestamp": "05:27:10", "text": "あなたが今ストリーミング配信をしてくれていることが、より一層嬉しいです。"}, {"type": "subtitle", "time": 19632.868, "timestamp": "05:27:12", "text": "戻るべきかどうかわからなかった"}, {"type": "subtitle", "time": 19635.99, "timestamp": "05:27:15", "text": "ストリーミング配信。なんだか恐ろしい"}, {"type": "subtitle", "time": 19639.55, "timestamp": "05:27:19", "text": "一人でストリーミング配信する。"}, {"type": "subtitle", "time": 19643.11, "timestamp": "05:27:23", "text": "うん。うん。ええと、ああ、そうですね。によって"}, {"type": "subtitle", "time": 19645.67, "timestamp": "05:27:25", "text": "ところで、どうやって日本語を学んだのですか？のように"}, {"type": "subtitle", "time": 19649.51, "timestamp": "05:27:29", "text": "どれくらいの時間がかかったか"}, {"type": "subtitle", "time": 19654.548, "timestamp": "05:27:34", "text": "JL JPT試験全体ですか？私は書いた"}, {"type": "subtitle", "time": 19658.07, "timestamp": "05:27:38", "text": "NAT試験はJPTと同等の試験でした。"}, {"type": "subtitle", "time": 19663.91, "timestamp": "05:27:43", "text": "テスト。それで、コースは3でした"}, {"type": "subtitle", "time": 19668.07, "timestamp": "05:27:48", "text": "確か3ヶ月だったと思います。"}, {"type": "subtitle", "time": 19670.47, "timestamp": "05:27:50", "text": "何ヶ月もかかったのに、ほとんど何も終わらなかった。"}, {"type": "subtitle", "time": 19673.83, "timestamp": "05:27:53", "text": "それは多くのことに触れてさえいなかった"}, {"type": "subtitle", "time": 19675.99, "timestamp": "05:27:55", "text": "試験に出たトピックは次のようなものでした。"}, {"type": "subtitle", "time": 19679.35, "timestamp": "05:27:59", "text": "漢字は一度書けば全てです。それで私は"}]
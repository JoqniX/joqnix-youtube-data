[{"type": "subtitle", "time": 124.27, "timestamp": "00:02:04", "text": "君"}, {"type": "subtitle", "time": 127.63, "timestamp": "00:02:07", "text": "彼らの言い方を見てください"}, {"type": "subtitle", "time": 130.15, "timestamp": "00:02:10", "text": "すごいね、彼らは年上みたいなんだ"}, {"type": "subtitle", "time": 132.39, "timestamp": "00:02:12", "text": "そして彼らはマッチョで"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "声。そして、それが若いものであることがわかる"}, {"type": "subtitle", "time": 162.55, "timestamp": "00:02:42", "text": "声だけで若い男だとわかる。私"}, {"type": "subtitle", "time": 164.67000000000002, "timestamp": "00:02:44", "text": "わからない"}]
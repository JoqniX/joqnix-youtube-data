[{"type": "subtitle", "time": 7383.59, "timestamp": "02:03:03", "text": "彼はまるで蝶のように飛んでいく。ああ、ここにいて。"}, {"type": "subtitle", "time": 7400.589, "timestamp": "02:03:20", "text": "男。わかった、あのね？移動しましょう"}, {"type": "subtitle", "time": 7403.99, "timestamp": "02:03:23", "text": "の上。あなたのお気に入りの非ヴィディカリアンは何ですか？"}, {"type": "subtitle", "time": 7405.95, "timestamp": "02:03:25", "text": "食べ物？おお、"}, {"type": "subtitle", "time": 7408.31, "timestamp": "02:03:28", "text": "非動詞それって、肉とかそういう類のことだよね？"}, {"type": "subtitle", "time": 7411.83, "timestamp": "02:03:31", "text": "ああ、わかりました。うーん、危なっかしいですね。"}, {"type": "subtitle", "time": 7414.709, "timestamp": "02:03:34", "text": "不安定だ。"}, {"type": "subtitle", "time": 7418.229, "timestamp": "02:03:38", "text": "下へ降りるよ。他に方法はない。"}, {"type": "subtitle", "time": 7420.75, "timestamp": "02:03:40", "text": "えっと、非ベジタリアンです。私はあまり持っていません"}, {"type": "subtitle", "time": 7423.07, "timestamp": "02:03:43", "text": "お気に入り、"}, {"type": "subtitle", "time": 7431.189, "timestamp": "02:03:51", "text": "何でも。何でも。食べ物である限り"}]
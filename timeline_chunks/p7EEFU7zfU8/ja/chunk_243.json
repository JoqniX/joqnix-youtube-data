[{"type": "subtitle", "time": 14582.75, "timestamp": "04:03:02", "text": "リラックス。私"}, {"type": "subtitle", "time": 14588.429, "timestamp": "04:03:08", "text": "私の中には死者がストリーミング配信することを望む部分がある"}, {"type": "subtitle", "time": 14590.95, "timestamp": "04:03:10", "text": "今日。配信したいゲームが1つあります"}, {"type": "subtitle", "time": 14591.71, "timestamp": "04:03:11", "text": "それで"}, {"type": "subtitle", "time": 14594.229, "timestamp": "04:03:14", "text": "最近は調子が悪い。物事は"}, {"type": "subtitle", "time": 14597.59, "timestamp": "04:03:17", "text": "状況は悪化している。用心しておいた方が良さそうだ。"}, {"type": "subtitle", "time": 14599.91, "timestamp": "04:03:19", "text": "だから、私はそれをストリーミングしたいと思った"}, {"type": "subtitle", "time": 14603.269, "timestamp": "04:03:23", "text": "ゲーム。私はストリームをしたくない"}, {"type": "subtitle", "time": 14605.269, "timestamp": "04:03:25", "text": "死ぬ。"}, {"type": "subtitle", "time": 14607.83, "timestamp": "04:03:27", "text": "しかし昨日、私が引き継いだ。私はしませんでした"}, {"type": "subtitle", "time": 14610.71, "timestamp": "04:03:30", "text": "ストリーム。ここに来たことを後悔するでしょう。"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "アンドロイド。だから私はこう思う"}, {"type": "subtitle", "time": 14616.07, "timestamp": "04:03:36", "text": "あなたと協力していきます。でも、私には兄弟がいるんです"}, {"type": "subtitle", "time": 14618.389, "timestamp": "04:03:38", "text": "グリンゴッツ銀行に勤務している人。これはこう呼ばれています"}, {"type": "subtitle", "time": 14620.469, "timestamp": "04:03:40", "text": "1つ。机の後ろに座るのに十分な量"}, {"type": "subtitle", "time": 14622.99, "timestamp": "04:03:42", "text": "日。これはこう呼ばれています"}, {"type": "subtitle", "time": 14626.269, "timestamp": "04:03:46", "text": "えっと、これはこう呼ばれています"}, {"type": "subtitle", "time": 14628.189, "timestamp": "04:03:48", "text": "ゲーム。"}, {"type": "subtitle", "time": 14631.349, "timestamp": "04:03:51", "text": "この動きは高速な動きのようだ"}]
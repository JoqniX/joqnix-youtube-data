[{"type": "subtitle", "time": 10082.75, "timestamp": "02:48:02", "text": "1"}, {"type": "subtitle", "time": 10085.23, "timestamp": "02:48:05", "text": "カダブラ"}, {"type": "subtitle", "time": 10087.15, "timestamp": "02:48:07", "text": "アバカダブラ。これ"}, {"type": "subtitle", "time": 10090.71, "timestamp": "02:48:10", "text": "私がこれらを待っているんです。いつ"}, {"type": "subtitle", "time": 10092.429, "timestamp": "02:48:12", "text": "あなたは私に"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "新しい呪文を覚えることになりそうだ。"}, {"type": "subtitle", "time": 10102.19, "timestamp": "02:48:22", "text": "我々は持っています"}, {"type": "subtitle", "time": 10104.79, "timestamp": "02:48:24", "text": "到着した。ディークはここに来るのが好きで"}, {"type": "subtitle", "time": 10107.19, "timestamp": "02:48:27", "text": "獣たち、特にパッフルに注目してください"}, {"type": "subtitle", "time": 10110.07, "timestamp": "02:48:30", "text": "近くにパフスキンがいくつかある。パフ。親切に"}, {"type": "subtitle", "time": 10112.55, "timestamp": "02:48:32", "text": "彼らを安全に守ってください。あなたがする必要があるのは"}, {"type": "subtitle", "time": 10115.03, "timestamp": "02:48:35", "text": "近づいて、開いたナップサックを向けます"}, {"type": "subtitle", "time": 10117.91, "timestamp": "02:48:37", "text": "パフィンの方へ向かえば、中に入るだろう。全て"}]
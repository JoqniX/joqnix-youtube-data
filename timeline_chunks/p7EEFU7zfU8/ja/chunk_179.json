[{"type": "subtitle", "time": 10746.23, "timestamp": "02:59:06", "text": "ああ、それは違う色ですね。おお。おお。"}, {"type": "subtitle", "time": 10748.309, "timestamp": "02:59:08", "text": "おお。おお。おお。必ず捕まえてやる。私は手に入れる"}, {"type": "subtitle", "time": 10757.87, "timestamp": "02:59:17", "text": "あなた。 1 2 3。"}, {"type": "subtitle", "time": 10760.309, "timestamp": "02:59:20", "text": "はい。色が違う方。待って。"}, {"type": "subtitle", "time": 10761.83, "timestamp": "02:59:21", "text": "待って。今行ってる。今行ってる。教授"}, {"type": "subtitle", "time": 10763.67, "timestamp": "02:59:23", "text": "こんなこと、絶対に信じないだろう。今行ってる。"}, {"type": "subtitle", "time": 10773.23, "timestamp": "02:59:33", "text": "君は僕のものだ、D。君を離さない。"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "行く。私はみんなを救う。戻ってきます"}, {"type": "subtitle", "time": 10780.03, "timestamp": "02:59:40", "text": "私の家に。君を"}, {"type": "subtitle", "time": 10783.67, "timestamp": "02:59:43", "text": "安全。約束します。"}, {"type": "subtitle", "time": 10785.309, "timestamp": "02:59:45", "text": "うん。 2つが1つに。"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "今行ってる。"}]
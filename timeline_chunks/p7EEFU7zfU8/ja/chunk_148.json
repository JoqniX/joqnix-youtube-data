[{"type": "subtitle", "time": 8894.23, "timestamp": "02:28:14", "text": "ああ、神様。私は一食分しか持っていません。私は必要としている"}, {"type": "subtitle", "time": 8897.27, "timestamp": "02:28:17", "text": "戦略を立てる必要がある。"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "戦略を立てる。私が彼を殺した。私は殺した"}, {"type": "subtitle", "time": 8910.79, "timestamp": "02:28:30", "text": "よし。よし。よし。私は"}, {"type": "subtitle", "time": 8913.55, "timestamp": "02:28:33", "text": "ただ"}, {"type": "subtitle", "time": 8916.07, "timestamp": "02:28:36", "text": "良い。私は今でも、"}, {"type": "subtitle", "time": 8918.99, "timestamp": "02:28:38", "text": "一人でアッシュワインダーを。はい、あなたはそうしました。"}, {"type": "subtitle", "time": 8921.79, "timestamp": "02:28:41", "text": "ディオ。の力で"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "魔法。待って、どこで闇を殺したんだ？"}, {"type": "subtitle", "time": 8926.71, "timestamp": "02:28:46", "text": "魔法使い？"}, {"type": "subtitle", "time": 8929.67, "timestamp": "02:28:49", "text": "私の戦利品はどこにある？ディオ、私は"}, {"type": "subtitle", "time": 8932.15, "timestamp": "02:28:52", "text": "大敵。あなたは与えるべきである"}, {"type": "subtitle", "time": 8939.309, "timestamp": "02:28:59", "text": "こんにちは、小鳥たち。ああ、それは"}]
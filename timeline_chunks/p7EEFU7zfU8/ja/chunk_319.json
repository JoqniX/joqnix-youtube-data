[{"type": "subtitle", "time": 19142.708, "timestamp": "05:19:02", "text": "40シリーズのカードは入手できませんでした。"}, {"type": "subtitle", "time": 19146.31, "timestamp": "05:19:06", "text": "つまり、30 3060 Ti は良いということです。だから行けるよ"}, {"type": "subtitle", "time": 19149.868, "timestamp": "05:19:09", "text": "それと。知らなくても心配しないでください。それは"}, {"type": "subtitle", "time": 19153.19, "timestamp": "05:19:13", "text": "良い。ゲームなどには最適です。"}, {"type": "subtitle", "time": 19155.19, "timestamp": "05:19:15", "text": "ストリーミング配信をする場合は、"}, {"type": "subtitle", "time": 19157.59, "timestamp": "05:19:17", "text": "少し痛みはありますが、"}, {"type": "subtitle", "time": 19160.35, "timestamp": "05:19:20", "text": "グラフィック設定を低くしてください。"}, {"type": "subtitle", "time": 19163.75, "timestamp": "05:19:23", "text": "それで、ああ、最終的にはあなたは"}, {"type": "subtitle", "time": 19167.788, "timestamp": "05:19:27", "text": "デュアルPC構成を試してみます。"}, {"type": "subtitle", "time": 19170.15, "timestamp": "05:19:30", "text": "右？古い部品と"}, {"type": "subtitle", "time": 19172.07, "timestamp": "05:19:32", "text": "もの。現在、あなたはかつて"}, {"type": "subtitle", "time": 19174.23, "timestamp": "05:19:34", "text": "GPU を入手したら、"}, {"type": "subtitle", "time": 19176.55, "timestamp": "05:19:36", "text": "新しいマザーボードや電源ユニットなど、"}, {"type": "subtitle", "time": 19179.91, "timestamp": "05:19:39", "text": "もの。だから、私はあなたが"}, {"type": "subtitle", "time": 19183.51, "timestamp": "05:19:43", "text": "3060 を手に入れてゲームに使って、"}, {"type": "subtitle", "time": 19186.07, "timestamp": "05:19:46", "text": "古いバージョンであって、現在のバージョンではないですよね？のように、"}, {"type": "subtitle", "time": 19188.23, "timestamp": "05:19:48", "text": "だから、ああ、待って、待って、待って、待って。もしあなたが"}, {"type": "subtitle", "time": 19191.11, "timestamp": "05:19:51", "text": "そうするなら、キャプチャカードはどうですか？あなた"}, {"type": "subtitle", "time": 19193.91, "timestamp": "05:19:53", "text": "それにはかなりの費用がかかる。または、"}, {"type": "subtitle", "time": 19197.43, "timestamp": "05:19:57", "text": "良いものがあれば、使用できます。"}]
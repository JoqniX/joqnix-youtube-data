[{"type": "subtitle", "time": 13501.67, "timestamp": "03:45:01", "text": "敵がどこを望んでいるのかよくわからない"}, {"type": "subtitle", "time": 13517.429, "timestamp": "03:45:17", "text": "終わり。私は今とてもうまくプレイしました"}, {"type": "subtitle", "time": 13519.59, "timestamp": "03:45:19", "text": "いかなる損害も受けない。いやあ、いいね。それは"}, {"type": "subtitle", "time": 13528.229, "timestamp": "03:45:28", "text": "これは激怒と何かについて言及しています"}, {"type": "subtitle", "time": 13544.79, "timestamp": "03:45:44", "text": "チェス。わかった。さあ、お金を稼ぐ時間だ。その時が来た"}]
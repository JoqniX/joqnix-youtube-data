[{"type": "subtitle", "time": 12785.99, "timestamp": "03:33:05", "text": "[音楽]"}, {"type": "subtitle", "time": 12787.83, "timestamp": "03:33:07", "text": "ああ、ほうきが開かない。質問"}, {"type": "subtitle", "time": 12789.56, "timestamp": "03:33:09", "text": "マーク。"}, {"type": "subtitle", "time": 12829.71, "timestamp": "03:33:49", "text": "そうですね、"}, {"type": "subtitle", "time": 12833.03, "timestamp": "03:33:53", "text": "行く。私はそれを自動実行して、"}, {"type": "subtitle", "time": 12835.67, "timestamp": "03:33:55", "text": "私はそこへ飛んでいく。それまでは、私は"}, {"type": "subtitle", "time": 12838.15, "timestamp": "03:33:58", "text": "食べる。"}]
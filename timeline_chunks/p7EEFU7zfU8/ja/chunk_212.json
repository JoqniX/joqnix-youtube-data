[{"type": "subtitle", "time": 12732.309, "timestamp": "03:32:12", "text": "もしかして、メインクエストをうっかり進めてしまっているのでしょうか？"}, {"type": "subtitle", "time": 12740.309, "timestamp": "03:32:20", "text": "わかった。これで終わらせよう"}, {"type": "subtitle", "time": 12743.309, "timestamp": "03:32:23", "text": "このストリーム。わかった。"}, {"type": "subtitle", "time": 12756.8, "timestamp": "03:32:36", "text": "青色は使えません。"}, {"type": "subtitle", "time": 12759.03, "timestamp": "03:32:39", "text": "[音楽]"}, {"type": "subtitle", "time": 12761.269, "timestamp": "03:32:41", "text": "元気です。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 12763.87, "timestamp": "03:32:43", "text": "同じように。はい、私は自分が素晴らしいことをしていると知っています"}, {"type": "subtitle", "time": 12766.87, "timestamp": "03:32:46", "text": "良い。この女性はまるで"}, {"type": "subtitle", "time": 12768.79, "timestamp": "03:32:48", "text": "盗みと何かから逃げること"}]
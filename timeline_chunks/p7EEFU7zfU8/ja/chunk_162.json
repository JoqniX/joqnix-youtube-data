[{"type": "subtitle", "time": 9721.27, "timestamp": "02:42:01", "text": "ご存知の通り、私はマーリンを着用しています"}, {"type": "subtitle", "time": 9723.11, "timestamp": "02:42:03", "text": "クロック。闇の魔術で行こう"}, {"type": "subtitle", "time": 9754.349, "timestamp": "02:42:34", "text": "誰か。これを載せないで"}, {"type": "subtitle", "time": 9761.91, "timestamp": "02:42:41", "text": "眼鏡。私のメガネはどこに行ったの？そこには"}, {"type": "subtitle", "time": 9765.77, "timestamp": "02:42:45", "text": "あなたが行く。丸い眼鏡。"}, {"type": "subtitle", "time": 9768.349, "timestamp": "02:42:48", "text": "[音楽]"}, {"type": "subtitle", "time": 9770.83, "timestamp": "02:42:50", "text": "うん、それでいいと思うよ"}, {"type": "subtitle", "time": 9773.389, "timestamp": "02:42:53", "text": "十分。"}]
[{"type": "subtitle", "time": 6180.109, "timestamp": "01:43:00", "text": "今日はどうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 6183.669, "timestamp": "01:43:03", "text": "ジェフロ？なぜ言葉をぶつぶつ言うのですか"}, {"type": "subtitle", "time": 6187.229, "timestamp": "01:43:07", "text": "ブレンド？わかりません。それは"}, {"type": "subtitle", "time": 6192.35, "timestamp": "01:43:12", "text": "自分。それは痛みを伴うもので、"}, {"type": "subtitle", "time": 6195.06, "timestamp": "01:43:15", "text": "それ。それは"}, {"type": "subtitle", "time": 6196.59, "timestamp": "01:43:16", "text": "[音楽]"}, {"type": "subtitle", "time": 6201.669, "timestamp": "01:43:21", "text": "自分。私は英語が"}, {"type": "subtitle", "time": 6204.709, "timestamp": "01:43:24", "text": "私の母語ではありません。それは本当ですね。"}, {"type": "subtitle", "time": 6207.87, "timestamp": "01:43:27", "text": "権力と"}, {"type": "subtitle", "time": 6210.55, "timestamp": "01:43:30", "text": "回転させてもいいと思う。ええ、そうです"}, {"type": "subtitle", "time": 6211.629, "timestamp": "01:43:31", "text": "のように"}, {"type": "subtitle", "time": 6214.709, "timestamp": "01:43:34", "text": "えっと、発音に少し苦労しました"}, {"type": "subtitle", "time": 6217.47, "timestamp": "01:43:37", "text": "言葉もいくつか。参加する"}, {"type": "subtitle", "time": 6221.07, "timestamp": "01:43:41", "text": "痛み。私もムンブラです。"}, {"type": "subtitle", "time": 6231.229, "timestamp": "01:43:51", "text": "一人で。わかった。えっと、どうすれば"}, {"type": "subtitle", "time": 6235.51, "timestamp": "01:43:55", "text": "私が浮遊する？"}]
[{"type": "subtitle", "time": 11221.75, "timestamp": "03:07:01", "text": "さまざまな用途でより役立つ衣類"}, {"type": "subtitle", "time": 11225.269, "timestamp": "03:07:05", "text": "方法。ああ、元素魔法みたいな感じ"}, {"type": "subtitle", "time": 11228.389, "timestamp": "03:07:08", "text": "元素的なものを追加するような"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "雷耐性などの装備"}, {"type": "subtitle", "time": 11233.07, "timestamp": "03:07:13", "text": "のように"}, {"type": "subtitle", "time": 11235.87, "timestamp": "03:07:15", "text": "それ。織機。"}, {"type": "subtitle", "time": 11239.67, "timestamp": "03:07:19", "text": "わかった。君たち、遊んでるね。わかった。私"}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": "これらをどうしたらいいかわからない"}, {"type": "subtitle", "time": 11244.03, "timestamp": "03:07:24", "text": "みんな、でも売っちゃうかも。質問"}, {"type": "subtitle", "time": 11246.79, "timestamp": "03:07:26", "text": "マーク。私はこの男をここに留めておきたい。できる"}, {"type": "subtitle", "time": 11253.309, "timestamp": "03:07:33", "text": "あなた？私はこの黒が好きで"}, {"type": "subtitle", "time": 11256.59, "timestamp": "03:07:36", "text": "白。もしあなたがそうしたら、それは悪いことでしょうか？"}, {"type": "subtitle", "time": 11258.95, "timestamp": "03:07:38", "text": "それ？ごめんなさい。どういうわけか私は決して"}, {"type": "subtitle", "time": 11261.75, "timestamp": "03:07:41", "text": "これを信じてください。ごめんなさい。私はただ好き"}, {"type": "subtitle", "time": 11263.95, "timestamp": "03:07:43", "text": "あなた。"}, {"type": "subtitle", "time": 11266.79, "timestamp": "03:07:46", "text": "わかった。私はこれが好きなんです。それは"}]
[{"type": "subtitle", "time": 6662.99, "timestamp": "01:51:02", "text": "えっと、私はできません"}, {"type": "subtitle", "time": 6667.189, "timestamp": "01:51:07", "text": "どれが満員か確認してください。 24/24。ああ、私は"}, {"type": "subtitle", "time": 6670.59, "timestamp": "01:51:10", "text": "ここから何かを破壊する必要がある。私"}, {"type": "subtitle", "time": 6674.229, "timestamp": "01:51:14", "text": "おそらく1つ破壊されたのだろう。あなたは"}, {"type": "subtitle", "time": 6676.189, "timestamp": "01:51:16", "text": "ハッピー"}, {"type": "subtitle", "time": 6681.39, "timestamp": "01:51:21", "text": "今？正体不明の手持ち物。"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "わかった。だから、もし私がそれをできるなら、"}, {"type": "subtitle", "time": 6687.31, "timestamp": "01:51:27", "text": "つまり、私は文字通り他のことができるということです"}, {"type": "subtitle", "time": 6690.189, "timestamp": "01:51:30", "text": "場所。信じるしかない、"}, {"type": "subtitle", "time": 6692.43, "timestamp": "01:51:32", "text": "ドキュメント。信じる"}, {"type": "subtitle", "time": 6695.189, "timestamp": "01:51:35", "text": "あなた自身。うん。ああ、そうだね。はい。ほとんど"}, {"type": "subtitle", "time": 6696.669, "timestamp": "01:51:36", "text": "そこには。"}, {"type": "subtitle", "time": 6699.75, "timestamp": "01:51:39", "text": "信じる。うん。ああ、それ、見える？私"}, {"type": "subtitle", "time": 6707.39, "timestamp": "01:51:47", "text": "2番。私はそこに立って"}, {"type": "subtitle", "time": 6711.75, "timestamp": "01:51:51", "text": "2番。君ならできるよ。それはそれはそれはそれは"}, {"type": "subtitle", "time": 6714.43, "timestamp": "01:51:54", "text": "タイミング、私は"}, {"type": "subtitle", "time": 6717.31, "timestamp": "01:51:57", "text": "推測。"}]
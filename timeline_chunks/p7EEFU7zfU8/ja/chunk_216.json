[{"type": "subtitle", "time": 12965.269, "timestamp": "03:36:05", "text": "ありがとうございます、ミス。ありがとうございます、ミセス。"}, {"type": "subtitle", "time": 12968.309, "timestamp": "03:36:08", "text": "スプルートル。ありがとう。あなたがここにいるなら"}, {"type": "subtitle", "time": 12971.75, "timestamp": "03:36:11", "text": "それらのタカの群れを収集することができる。私"}, {"type": "subtitle", "time": 12973.99, "timestamp": "03:36:13", "text": "そして私が支援しているベンダーは"}, {"type": "subtitle", "time": 12981.269, "timestamp": "03:36:21", "text": "はい、最善を尽くします。"}, {"type": "subtitle", "time": 12983.75, "timestamp": "03:36:23", "text": "バルド・ボウモントは、"}, {"type": "subtitle", "time": 12987.51, "timestamp": "03:36:27", "text": "今。彼は闇の魔法使いに捕らえられていた。"}, {"type": "subtitle", "time": 12990.07, "timestamp": "03:36:30", "text": "[音楽]"}, {"type": "subtitle", "time": 12991.87, "timestamp": "03:36:31", "text": "ああ、"}, {"type": "subtitle", "time": 13007.349, "timestamp": "03:36:47", "text": "新鮮な。シェーン・バードは、闇の魔法は"}, {"type": "subtitle", "time": 13010.15, "timestamp": "03:36:50", "text": "答え。ブルックウッズは"}, {"type": "subtitle", "time": 13012.309, "timestamp": "03:36:52", "text": "彼の失踪に関与している。すみません。"}, {"type": "subtitle", "time": 13014.63, "timestamp": "03:36:54", "text": "バードルフについて何か言いましたか？"}, {"type": "subtitle", "time": 13017.59, "timestamp": "03:36:57", "text": "ボウモント？ああ、また会いましたね。なんて素敵なことでしょう"}]
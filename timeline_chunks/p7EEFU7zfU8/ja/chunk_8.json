[{"type": "subtitle", "time": 483.189, "timestamp": "00:08:03", "text": "息子。サビタの息子。いいえ。"}, {"type": "subtitle", "time": 494.74, "timestamp": "00:08:14", "text": "彼女"}, {"type": "subtitle", "time": 496.029, "timestamp": "00:08:16", "text": "[音楽]"}, {"type": "subtitle", "time": 515.87, "timestamp": "00:08:35", "text": "彼女は、ああそれは"}, {"type": "subtitle", "time": 524.91, "timestamp": "00:08:44", "text": "レストラン。わかった。"}, {"type": "subtitle", "time": 526.949, "timestamp": "00:08:46", "text": "レストラン。疲れていたのは私の方です"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "長い間、安定した関係を続けている。"}, {"type": "subtitle", "time": 537.63, "timestamp": "00:08:57", "text": "の？何てことだ。"}, {"type": "subtitle", "time": 539.389, "timestamp": "00:08:59", "text": "水"}]
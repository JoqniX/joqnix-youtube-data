[{"type": "subtitle", "time": 20822.708, "timestamp": "05:47:02", "text": "音楽ソフトウェアなので、それを保存して送信できます"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "別の仮想オーディオへの1つのトラック"}, {"type": "subtitle", "time": 20828.07, "timestamp": "05:47:08", "text": "ケーブルと、一方のトラックを別のトラックに接続する。"}, {"type": "subtitle", "time": 20831.31, "timestamp": "05:47:11", "text": "だから元のものは私の"}, {"type": "subtitle", "time": 20835.67, "timestamp": "05:47:15", "text": "ヘッドホンと、もう片方は"}, {"type": "subtitle", "time": 20838.07, "timestamp": "05:47:18", "text": "ええと、仮想ケーブルは明らかに"}, {"type": "subtitle", "time": 20841.19, "timestamp": "05:47:21", "text": "そしてそれはそのようにそれを聞き、"}, {"type": "subtitle", "time": 20844.07, "timestamp": "05:47:24", "text": "私は、かなり多くのものを追加していました"}, {"type": "subtitle", "time": 20847.51, "timestamp": "05:47:27", "text": "日本の歌とか全部"}, {"type": "subtitle", "time": 20850.628, "timestamp": "05:47:30", "text": "どの曲が私に"}, {"type": "subtitle", "time": 20853.11, "timestamp": "05:47:33", "text": "著作権侵害チャンネルストライキ なぜなら私は"}, {"type": "subtitle", "time": 20855.11, "timestamp": "05:47:35", "text": "これをやった今、うっかり再生してしまった"}, {"type": "subtitle", "time": 20858.07, "timestamp": "05:47:38", "text": "えっと、あのインストゥルメンタルバージョン"}, {"type": "subtitle", "time": 20860.548, "timestamp": "05:47:40", "text": "アニメ「ボッチ・ザ・ロック」。そう、ザ・ロックだ。"}, {"type": "subtitle", "time": 20863.75, "timestamp": "05:47:43", "text": "ええ、つい最近観たばかりです。だから私は"}, {"type": "subtitle", "time": 20866.31, "timestamp": "05:47:46", "text": "「If I Could Be a Constellation」を演奏した"}, {"type": "subtitle", "time": 20868.39, "timestamp": "05:47:48", "text": "曲、インストゥルメンタル。文字通り"}, {"type": "subtitle", "time": 20871.99, "timestamp": "05:47:51", "text": "ソニー・ミュージック・ジャパンによるチャンネルストライキ。"}, {"type": "subtitle", "time": 20874.708, "timestamp": "05:47:54", "text": "私は丸一年待たなければならなかった。ええ、私は"}, {"type": "subtitle", "time": 20876.708, "timestamp": "05:47:56", "text": "それを許すまで丸一年待たなければならなかった"}, {"type": "subtitle", "time": 20879.51, "timestamp": "05:47:59", "text": "チャンネルストライキは解消されるだろう。そして今それは"}]
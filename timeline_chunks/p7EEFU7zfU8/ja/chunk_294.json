[{"type": "subtitle", "time": 17645.99, "timestamp": "04:54:05", "text": "えっと、私は何杯飲んだんだっけ？わかった、"}, {"type": "subtitle", "time": 17663.31, "timestamp": "04:54:23", "text": "紛らわしい。あなたが知っている"}, {"type": "subtitle", "time": 17666.708, "timestamp": "04:54:26", "text": "何？そこにいたんですね。"}, {"type": "subtitle", "time": 17668.15, "timestamp": "04:54:28", "text": "恥辱にはそれを受け入れる観客がいなかった"}, {"type": "subtitle", "time": 17671.03, "timestamp": "04:54:31", "text": "1つ。"}, {"type": "subtitle", "time": 17679.19, "timestamp": "04:54:39", "text": "私"}]
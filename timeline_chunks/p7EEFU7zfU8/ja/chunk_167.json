[{"type": "subtitle", "time": 10022.309, "timestamp": "02:47:02", "text": "ストレッチ。お元気でお過ごしでしょうか。リラックス"}, {"type": "subtitle", "time": 10024.58, "timestamp": "02:47:04", "text": "ASMRだよ、息子よ。"}, {"type": "subtitle", "time": 10026.389, "timestamp": "02:47:06", "text": "[音楽]"}, {"type": "subtitle", "time": 10029.59, "timestamp": "02:47:09", "text": "それは、人生における暗黒の時代だった。見つかった"}, {"type": "subtitle", "time": 10031.83, "timestamp": "02:47:11", "text": "最も残酷な魔法使いに仕える彼自身"}, {"type": "subtitle", "time": 10035.429, "timestamp": "02:47:15", "text": "彼がこれまでに出会った中で、最も意地悪な教皇だった。ディークは嫌っていた"}, {"type": "subtitle", "time": 10038.15, "timestamp": "02:47:18", "text": "彼は、"}, {"type": "subtitle", "time": 10040.71, "timestamp": "02:47:20", "text": "美しい獣たち。これは"}, {"type": "subtitle", "time": 10042.389, "timestamp": "02:47:22", "text": "ストレッチをしているような感覚。あの頃は、"}, {"type": "subtitle", "time": 10044.349, "timestamp": "02:47:24", "text": "最初に見た"}, {"type": "subtitle", "time": 10047.11, "timestamp": "02:47:27", "text": "ナップザック。実際に使われるのを見るのは良いことだろう"}, {"type": "subtitle", "time": 10061.15, "timestamp": "02:47:41", "text": "[音楽]"}, {"type": "subtitle", "time": 10075.83, "timestamp": "02:47:55", "text": "変換。分かります。だから私は"}, {"type": "subtitle", "time": 10076.75, "timestamp": "02:47:56", "text": "待っている"}]
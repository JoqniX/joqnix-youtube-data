[{"type": "subtitle", "time": 18180.75, "timestamp": "05:03:00", "text": "心配。心配しないでください。だからそれは"}, {"type": "subtitle", "time": 18189.99, "timestamp": "05:03:09", "text": "えーっと、どうすればいいか考えてみましょう"}, {"type": "subtitle", "time": 18193.23, "timestamp": "05:03:13", "text": "実際に"}, {"type": "subtitle", "time": 18197.47, "timestamp": "05:03:17", "text": "なれ？つまり私の考えは"}, {"type": "subtitle", "time": 18200.788, "timestamp": "05:03:20", "text": "いいえ、現在のものは使用できません。"}, {"type": "subtitle", "time": 18204.31, "timestamp": "05:03:24", "text": "ストリーミング用のビデオカードはもう必要ない"}, {"type": "subtitle", "time": 18206.788, "timestamp": "05:03:26", "text": "3つ目を手に入れろ。わかった。つまりそのアイデアは"}, {"type": "subtitle", "time": 18209.75, "timestamp": "05:03:29", "text": "文字通りには次のようになります。私は...するだろう"}, {"type": "subtitle", "time": 18213.99, "timestamp": "05:03:33", "text": "実際にIntel Arc GPUを入手した場合、または"}, {"type": "subtitle", "time": 18217.35, "timestamp": "05:03:37", "text": "40枚組CDカード。いいえ、それは"}, {"type": "subtitle", "time": 18219.75, "timestamp": "05:03:39", "text": "入手不可能。しかし将来"}, {"type": "subtitle", "time": 18222.47, "timestamp": "05:03:42", "text": "年、つまり、ええ、"}, {"type": "subtitle", "time": 18225.43, "timestamp": "05:03:45", "text": "未来の未来の年。もし私が"}, {"type": "subtitle", "time": 18233.43, "timestamp": "05:03:53", "text": "50シリーズの場合、40シリーズはそうです。"}, {"type": "subtitle", "time": 18234.628, "timestamp": "05:03:54", "text": "うん。うん。"}, {"type": "subtitle", "time": 18237.11, "timestamp": "05:03:57", "text": "えっと、40シリーズか50シリーズのカードですね。それは"}, {"type": "subtitle", "time": 18239.47, "timestamp": "05:03:59", "text": "ストリーミングに最適"}]
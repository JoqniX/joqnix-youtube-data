[{"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "おお。でも、あなたはこれまでずっと走り続けることができる。は"}, {"type": "subtitle", "time": 5853.91, "timestamp": "01:37:33", "text": "走る。ずっと走り続けることもできるんだよ。"}, {"type": "subtitle", "time": 5857.109, "timestamp": "01:37:37", "text": "ああ、それだ。魔女の墓。"}, {"type": "subtitle", "time": 5859.43, "timestamp": "01:37:39", "text": "昔ここに来たことなかったっけ？"}, {"type": "subtitle", "time": 5867.91, "timestamp": "01:37:47", "text": "ヘルメットの回収がうまくいくことを祈っています。"}, {"type": "subtitle", "time": 5869.669, "timestamp": "01:37:49", "text": "杖の持ち主。あなたは"}, {"type": "subtitle", "time": 5872.95, "timestamp": "01:37:52", "text": "アドバンテージ。さあ、出発する前に、"}, {"type": "subtitle", "time": 5879.51, "timestamp": "01:37:59", "text": "はい、準備はできました。全てがはっきりしているように思える"}]
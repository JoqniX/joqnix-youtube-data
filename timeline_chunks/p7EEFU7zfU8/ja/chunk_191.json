[{"type": "subtitle", "time": 11470.75, "timestamp": "03:11:10", "text": "[音楽]"}, {"type": "subtitle", "time": 11474.07, "timestamp": "03:11:14", "text": "スイッチギアの主な特徴は1つです"}, {"type": "subtitle", "time": 11476.79, "timestamp": "03:11:16", "text": "そしてデフォルトで防御"}, {"type": "subtitle", "time": 11478.95, "timestamp": "03:11:18", "text": "魔法のアイテムは醸造液と一緒に使用できます"}, {"type": "subtitle", "time": 11482.87, "timestamp": "03:11:22", "text": "二次ステータスをアップグレードするaloom"}, {"type": "subtitle", "time": 11486.469, "timestamp": "03:11:26", "text": "または、装備に特性を適用する。複数"}, {"type": "subtitle", "time": 11488.87, "timestamp": "03:11:28", "text": "小さなアップグレードでも意味のある結果が得られる"}, {"type": "subtitle", "time": 11492.63, "timestamp": "03:11:32", "text": "戦闘力の向上。新しい蜂は"}, {"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "救助され、"}, {"type": "subtitle", "time": 11497.91, "timestamp": "03:11:37", "text": "クエストでアンロックされるか、アンロックされる。新規取引"}, {"type": "subtitle", "time": 11501.63, "timestamp": "03:11:41", "text": "レシピは山賊の野営地で入手できます。"}, {"type": "subtitle", "time": 11505.11, "timestamp": "03:11:45", "text": "わかった。えっと、どうしたらいいのか分かりません。"}, {"type": "subtitle", "time": 11506.75, "timestamp": "03:11:46", "text": "質問"}, {"type": "subtitle", "time": 11508.75, "timestamp": "03:11:48", "text": "マーク。"}, {"type": "subtitle", "time": 11511.63, "timestamp": "03:11:51", "text": "ああ、景色"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "アップグレードします。防御力を上げることができます。こんにちは"}]
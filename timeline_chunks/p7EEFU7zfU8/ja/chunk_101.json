[{"type": "subtitle", "time": 6068.189, "timestamp": "01:41:08", "text": "え、どうやって？なぜダメージを与えないのか？"}, {"type": "subtitle", "time": 6076.79, "timestamp": "01:41:16", "text": "何？ああ、そうそう。今彼らは"}, {"type": "subtitle", "time": 6107.91, "timestamp": "01:41:47", "text": "ない。最初は英語に聞こえなかった。"}, {"type": "subtitle", "time": 6109.55, "timestamp": "01:41:49", "text": "何？それ"}, {"type": "subtitle", "time": 6113.39, "timestamp": "01:41:53", "text": "そうしなかった。なぜ？ああ、私は時々変わる"}, {"type": "subtitle", "time": 6115.31, "timestamp": "01:41:55", "text": "日本語"}]
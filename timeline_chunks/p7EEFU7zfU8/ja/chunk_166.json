[{"type": "subtitle", "time": 9971.83, "timestamp": "02:46:11", "text": "まるで魔法薬のような、大きなものを手に入れる。私はそうは思わない"}, {"type": "subtitle", "time": 9973.389, "timestamp": "02:46:13", "text": "持っている"}, {"type": "subtitle", "time": 9976.91, "timestamp": "02:46:16", "text": "お金。えっと"}, {"type": "subtitle", "time": 9979.79, "timestamp": "02:46:19", "text": "私は飛び跳ねる"}, {"type": "subtitle", "time": 9984.309, "timestamp": "02:46:24", "text": "鍋でランダムなポーションを調合する。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 9985.469, "timestamp": "02:46:25", "text": "入手する必要がある"}, {"type": "subtitle", "time": 9988.349, "timestamp": "02:46:28", "text": "これ"}, {"type": "subtitle", "time": 9992.83, "timestamp": "02:46:32", "text": "中くらい。中くらいかな、あるいは"}, {"type": "subtitle", "time": 9996.19, "timestamp": "02:46:36", "text": "T字型。買わないといけない、"}, {"type": "subtitle", "time": 9998.59, "timestamp": "02:46:38", "text": "はぁ？うん、そうしよう"}, {"type": "subtitle", "time": 10000.95, "timestamp": "02:46:40", "text": "行く。私は使い方を学ぶつもりです"}, {"type": "subtitle", "time": 10002.95, "timestamp": "02:46:42", "text": "スナップサック。使い方を学ぶ準備ができています"}, {"type": "subtitle", "time": 10005.51, "timestamp": "02:46:45", "text": "リュックサック。完璧。ディーは"}, {"type": "subtitle", "time": 10008.19, "timestamp": "02:46:48", "text": "外出。さあ行こう、"}, {"type": "subtitle", "time": 10019.55, "timestamp": "02:46:59", "text": "何てことだ。必要"}]
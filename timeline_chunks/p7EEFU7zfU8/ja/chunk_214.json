[{"type": "subtitle", "time": 12842.349, "timestamp": "03:34:02", "text": "何てことだ。ああ、この魚は難しい"}, {"type": "subtitle", "time": 12847.429, "timestamp": "03:34:07", "text": "スプーンで届く。おお。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 12850.309, "timestamp": "03:34:10", "text": "ああ。アッパーホークフィールド。さて、どこで見つけるか"}, {"type": "subtitle", "time": 12852.63, "timestamp": "03:34:12", "text": "スプラットル夫人？"}, {"type": "subtitle", "time": 12863.67, "timestamp": "03:34:23", "text": "バードは暗黒魔法が"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "答え。こんにちは。ブルックウッズだと思う"}, {"type": "subtitle", "time": 12873.11, "timestamp": "03:34:33", "text": "こんにちは、ブルートル夫人。実際、セロナ"}, {"type": "subtitle", "time": 12876.07, "timestamp": "03:34:36", "text": "ライアンが、君に会いに来てくれないかと頼んできたんだ。おお、"}, {"type": "subtitle", "time": 12880.229, "timestamp": "03:34:40", "text": "親愛なるセローナ。逸品。ずっと"}, {"type": "subtitle", "time": 12882.389, "timestamp": "03:34:42", "text": "私が彼女を知って以来、そう思っています。彼女はあなたがそう思うかもしれないと思った"}, {"type": "subtitle", "time": 12883.83, "timestamp": "03:34:43", "text": "材料を集めるのに助けが必要です"}, {"type": "subtitle", "time": 12885.91, "timestamp": "03:34:45", "text": "あなたのウィガンワールドのポーション。そして彼女は"}, {"type": "subtitle", "time": 12888.87, "timestamp": "03:34:48", "text": "正しい。私の愛しいエイデンはかつて"}, {"type": "subtitle", "time": 12891.269, "timestamp": "03:34:51", "text": "私のためにタカの骨を集めてくれ。彼が"}, {"type": "subtitle", "time": 12894.15, "timestamp": "03:34:54", "text": "亡くなったので、私の在庫は減ってしまった。ごめんなさい"}, {"type": "subtitle", "time": 12897.229, "timestamp": "03:34:57", "text": "ブルータル夫人、ご愁傷様です。ああ、ありがとう"}]
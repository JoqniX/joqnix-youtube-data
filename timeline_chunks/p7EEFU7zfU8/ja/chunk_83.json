[{"type": "subtitle", "time": 4981.03, "timestamp": "01:23:01", "text": "近づく前に"}, {"type": "subtitle", "time": 4987.629, "timestamp": "01:23:07", "text": "[音楽]"}, {"type": "subtitle", "time": 5009.189, "timestamp": "01:23:29", "text": "彼らは私を受け入れてくれる。私は今まで"}, {"type": "subtitle", "time": 5011.47, "timestamp": "01:23:31", "text": "ヒッポグリが誰かに襲いかかるのを見た"}, {"type": "subtitle", "time": 5013.75, "timestamp": "01:23:33", "text": "素早く。餌を与えたりブラッシングしたりできるなら"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "あなたが望むもの。うん、いや、いや、ただ欲しいだけ"}, {"type": "subtitle", "time": 5019.59, "timestamp": "01:23:39", "text": "ディオ、彼に乗るんだ。私は飛びたい"}, {"type": "subtitle", "time": 5022.07, "timestamp": "01:23:42", "text": "空を見上げて、"}, {"type": "subtitle", "time": 5024.87, "timestamp": "01:23:44", "text": "彼女を見てみたが、彼女はドラゴンだ。むしろ"}, {"type": "subtitle", "time": 5027.31, "timestamp": "01:23:47", "text": "私の便利なほうき、マウントが欲しい"}, {"type": "subtitle", "time": 5036.75, "timestamp": "01:23:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11581.269, "timestamp": "03:13:01", "text": "はい。お元気でお過ごしでしょうか。私の息子"}, {"type": "subtitle", "time": 11588.389, "timestamp": "03:13:08", "text": "私は魔法の織機、ディーを使っています。"}, {"type": "subtitle", "time": 11590.87, "timestamp": "03:13:10", "text": "素晴らしい。私は織ることができるだろうか"}, {"type": "subtitle", "time": 11592.79, "timestamp": "03:13:12", "text": "私の服にもっと強力な魔法を"}, {"type": "subtitle", "time": 11595.429, "timestamp": "03:13:15", "text": "織機で？はい、そうします。救出することで"}, {"type": "subtitle", "time": 11598.23, "timestamp": "03:13:18", "text": "さらに強力な獣たち。わかった。のために"}, {"type": "subtitle", "time": 11600.55, "timestamp": "03:13:20", "text": "しかし今、ディーはあなたに探求することを勧めています"}, {"type": "subtitle", "time": 11602.95, "timestamp": "03:13:22", "text": "バイエルンで野獣を知る"}, {"type": "subtitle", "time": 11607.03, "timestamp": "03:13:27", "text": "あなたは既に救出しました。こんにちは、ありがとうございます。"}, {"type": "subtitle", "time": 11609.29, "timestamp": "03:13:29", "text": "Deさん、ご協力ありがとうございました。"}, {"type": "subtitle", "time": 11617.229, "timestamp": "03:13:37", "text": "食事に行かなきゃ"}, {"type": "subtitle", "time": 11620.229, "timestamp": "03:13:40", "text": "ランチ。ああ、私は何も持っていません"}, {"type": "subtitle", "time": 11627.91, "timestamp": "03:13:47", "text": "昼食を食べに行かなければならない。わかった。"}, {"type": "subtitle", "time": 11631.309, "timestamp": "03:13:51", "text": "今日は何時間配信する予定ですか？"}, {"type": "subtitle", "time": 11635.2, "timestamp": "03:13:55", "text": "えっと、ここで終わりにしましょうか、それとも"}, {"type": "subtitle", "time": 11637.15, "timestamp": "03:13:57", "text": "[音楽]"}]
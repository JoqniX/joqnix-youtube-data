[{"type": "subtitle", "time": 17948.67, "timestamp": "04:59:08", "text": "わかった。他に何を"}, {"type": "subtitle", "time": 17952.03, "timestamp": "04:59:12", "text": "プラン？忘れた。私は何て言った？"}, {"type": "subtitle", "time": 17954.99, "timestamp": "04:59:14", "text": "また？ああ、主よ、私は"}, {"type": "subtitle", "time": 17967.75, "timestamp": "04:59:27", "text": "忘れたの？こんにちは。忘れていた。冗談です。"}, {"type": "subtitle", "time": 17980.868, "timestamp": "04:59:40", "text": "[音楽]"}, {"type": "subtitle", "time": 17983.31, "timestamp": "04:59:43", "text": "うん。ゲームが少なくなり、"}, {"type": "subtitle", "time": 17993.11, "timestamp": "04:59:53", "text": "うん。それらのエレアントすべて。私は"}, {"type": "subtitle", "time": 17994.788, "timestamp": "04:59:54", "text": "お友達のミセス・ボトルに"}, {"type": "subtitle", "time": 17997.03, "timestamp": "04:59:57", "text": "彼女のウィガン世界のポーションのための塊がいくつか。"}]
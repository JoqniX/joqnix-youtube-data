[{"type": "subtitle", "time": 3964.47, "timestamp": "01:06:04", "text": "いいえ、何か"}, {"type": "subtitle", "time": 3978.95, "timestamp": "01:06:18", "text": "右？彼らは特別な存在だ。おお。おお。何が"}, {"type": "subtitle", "time": 3981.58, "timestamp": "01:06:21", "text": "これ？"}, {"type": "subtitle", "time": 3983.67, "timestamp": "01:06:23", "text": "[音楽]"}, {"type": "subtitle", "time": 3986.19, "timestamp": "01:06:26", "text": "ここには何かある、"}, {"type": "subtitle", "time": 3988.71, "timestamp": "01:06:28", "text": "ハニー。私は変態ではないと誓います"}, {"type": "subtitle", "time": 3996.67, "timestamp": "01:06:36", "text": "サス。それは"}, {"type": "subtitle", "time": 4002.67, "timestamp": "01:06:42", "text": "何？"}, {"type": "subtitle", "time": 4008.829, "timestamp": "01:06:48", "text": "それ？待って、今の見た？"}, {"type": "subtitle", "time": 4010.99, "timestamp": "01:06:50", "text": "待って。待って。"}, {"type": "subtitle", "time": 4014.549, "timestamp": "01:06:54", "text": "わかった。わかった。あれが浴槽です。一部の人にとって"}, {"type": "subtitle", "time": 4016.87, "timestamp": "01:06:56", "text": "気まずい理由ですが、浴槽は"}]
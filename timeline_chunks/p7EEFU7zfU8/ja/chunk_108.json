[{"type": "subtitle", "time": 6486.709, "timestamp": "01:48:06", "text": "Dさん、どうやってそこへ行くのですか？どうやって"}, {"type": "subtitle", "time": 6488.669, "timestamp": "01:48:08", "text": "どうすれば手に入れられるの？"}, {"type": "subtitle", "time": 6492.39, "timestamp": "01:48:12", "text": "そこには？正直に話すのはズルでしょうか？"}, {"type": "subtitle", "time": 6499.55, "timestamp": "01:48:19", "text": "上？それは"}, {"type": "subtitle", "time": 6503.47, "timestamp": "01:48:23", "text": "不正行為？私はただ、私は本当に欲しい"}, {"type": "subtitle", "time": 6507.43, "timestamp": "01:48:27", "text": "あ、待って。何てことだ。ああ、"}, {"type": "subtitle", "time": 6513.43, "timestamp": "01:48:33", "text": "あ、待って。"}, {"type": "subtitle", "time": 6514.95, "timestamp": "01:48:34", "text": "待って、待って、待って。これは これは これは"}, {"type": "subtitle", "time": 6523.109, "timestamp": "01:48:43", "text": "待って。ここに何かある。待って、"}, {"type": "subtitle", "time": 6532.55, "timestamp": "01:48:52", "text": "うーうーうーうー。お願いします。レヴィオーサ。何もない"}, {"type": "subtitle", "time": 6537.55, "timestamp": "01:48:57", "text": "そこに刻印されている。ドアと同じだ。"}]
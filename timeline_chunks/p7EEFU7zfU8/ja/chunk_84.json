[{"type": "subtitle", "time": 5051.47, "timestamp": "01:24:11", "text": "いいね。それでおしまい、"}, {"type": "subtitle", "time": 5062.55, "timestamp": "01:24:22", "text": "さて、ハイウィングについてどう思いましたか？"}, {"type": "subtitle", "time": 5065.629, "timestamp": "01:24:25", "text": "彼女は素晴らしかった。彼女は"}, {"type": "subtitle", "time": 5067.91, "timestamp": "01:24:27", "text": "素晴らしい。紹介したなんて信じられない"}, {"type": "subtitle", "time": 5070.31, "timestamp": "01:24:30", "text": "私から彼女へ。あなたたち二人が"}, {"type": "subtitle", "time": 5072.629, "timestamp": "01:24:32", "text": "平行。学生が"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "ヒッポグリスが上空を飛んでいるのを見ました"}, {"type": "subtitle", "time": 5077.43, "timestamp": "01:24:37", "text": "禁断の森？ああ、そうかもしれない。あなたは"}, {"type": "subtitle", "time": 5079.35, "timestamp": "01:24:39", "text": "ヒッポグリの"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "信じてください、彼らはいつもあなたのそばにいてくれますよ？"}, {"type": "subtitle", "time": 5084.149, "timestamp": "01:24:44", "text": "私は彼女を通してそれを直接見てきました。どうやって"}, {"type": "subtitle", "time": 5086.31, "timestamp": "01:24:46", "text": "あなたとハイウィングは一体どこに行ったのですか？"}, {"type": "subtitle", "time": 5089.669, "timestamp": "01:24:49", "text": "経路？それはまた別の話だが、私は救出した"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "彼女は数年前、密猟者から保護された。おお。"}, {"type": "subtitle", "time": 5094.55, "timestamp": "01:24:54", "text": "彼女を安全な場所に連れて行ったところ、彼女は"}, {"type": "subtitle", "time": 5097.35, "timestamp": "01:24:57", "text": "最近までは問題なかった。あなたには"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "密猟者はある種の"}]
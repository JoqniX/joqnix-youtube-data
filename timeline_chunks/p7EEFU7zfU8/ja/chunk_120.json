[{"type": "subtitle", "time": 7214.31, "timestamp": "02:00:14", "text": "私もジャンプできない。ああ、なんてことだ。私は"}, {"type": "subtitle", "time": 7217.09, "timestamp": "02:00:17", "text": "スケルトンブラシを作るはずだったのですが、"}, {"type": "subtitle", "time": 7219.229, "timestamp": "02:00:19", "text": "[音楽]"}, {"type": "subtitle", "time": 7222.75, "timestamp": "02:00:22", "text": "どのように"}, {"type": "subtitle", "time": 7228.79, "timestamp": "02:00:28", "text": "1つ？おお。おお。おお。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 7234.109, "timestamp": "02:00:34", "text": "おお。おお。私は何かをした。今は2つあります"}, {"type": "subtitle", "time": 7237.03, "timestamp": "02:00:37", "text": "頭蓋骨。ほら、こっちに頭蓋骨があるよ。"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "あぁ、私、何かしたんだ。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 7247.95, "timestamp": "02:00:47", "text": "私はそうしました"}, {"type": "subtitle", "time": 7251.47, "timestamp": "02:00:51", "text": "何か。わあ、そうだった"}, {"type": "subtitle", "time": 7254.31, "timestamp": "02:00:54", "text": "何か。何をしたのか分からないけど、"}, {"type": "subtitle", "time": 7256.35, "timestamp": "02:00:56", "text": "わかりました、"}]
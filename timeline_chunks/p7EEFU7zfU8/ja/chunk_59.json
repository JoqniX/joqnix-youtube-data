[{"type": "subtitle", "time": 3569.91, "timestamp": "00:59:29", "text": "[音楽]"}, {"type": "subtitle", "time": 3574.349, "timestamp": "00:59:34", "text": "うん。こんにちは、みんな。あ、待って、待って、"}, {"type": "subtitle", "time": 3578.63, "timestamp": "00:59:38", "text": "待って。私は自分のことを完全に忘れていました"}, {"type": "subtitle", "time": 3580.67, "timestamp": "00:59:40", "text": "人間。ああ、"}, {"type": "subtitle", "time": 3583.15, "timestamp": "00:59:43", "text": "神。うん。"}, {"type": "subtitle", "time": 3597.27, "timestamp": "00:59:57", "text": "えっと、画像はありますか？えっと"}]
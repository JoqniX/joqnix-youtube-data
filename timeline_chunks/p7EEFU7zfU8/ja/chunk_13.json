[{"type": "subtitle", "time": 785.87, "timestamp": "00:13:05", "text": "に。あ、待って。こちらはサビタです"}, {"type": "subtitle", "time": 792.55, "timestamp": "00:13:12", "text": "回答しました。いや、いや、いや。サビタ、待って、"}, {"type": "subtitle", "time": 794.79, "timestamp": "00:13:14", "text": "待って、待って、待って、待って、待って、待って。リサ"}, {"type": "subtitle", "time": 797.03, "timestamp": "00:13:17", "text": "彼女に質問した。サビタは答えた"}, {"type": "subtitle", "time": 800.389, "timestamp": "00:13:20", "text": "そしてリサはサビタのメッセージに返信した。"}, {"type": "subtitle", "time": 802.87, "timestamp": "00:13:22", "text": "そこで、現在私たちはどの"}, {"type": "subtitle", "time": 804.79, "timestamp": "00:13:24", "text": "サビタのメールアドレスですよね？わかった。わかった。"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "チャは待っている。チカ。なぜチャオと言うのですか"}, {"type": "subtitle", "time": 823.71, "timestamp": "00:13:43", "text": "また？私"}, {"type": "subtitle", "time": 825.79, "timestamp": "00:13:45", "text": "忘れた。"}, {"type": "subtitle", "time": 836.35, "timestamp": "00:13:56", "text": "電車？ああ、地下鉄。"}]
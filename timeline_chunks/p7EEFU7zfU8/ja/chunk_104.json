[{"type": "subtitle", "time": 6242.55, "timestamp": "01:44:02", "text": "上？はい、その先に秘密の宝箱があります"}, {"type": "subtitle", "time": 6244.669, "timestamp": "01:44:04", "text": "ここ。"}, {"type": "subtitle", "time": 6248.27, "timestamp": "01:44:08", "text": "ああ、どうやって起き上がればいいの？"}, {"type": "subtitle", "time": 6252.109, "timestamp": "01:44:12", "text": "そこには？どうやって起き上がるつもりですか？"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "そこには？この中に何かあるはずだ"}, {"type": "subtitle", "time": 6256.75, "timestamp": "01:44:16", "text": "部屋"}, {"type": "subtitle", "time": 6263.07, "timestamp": "01:44:23", "text": "おお、"}, {"type": "subtitle", "time": 6265.95, "timestamp": "01:44:25", "text": "正体不明の顔面アイテム。"}, {"type": "subtitle", "time": 6269.43, "timestamp": "01:44:29", "text": "わかった。うん。こんにちは、ヴァン。見逃した"}, {"type": "subtitle", "time": 6271.59, "timestamp": "01:44:31", "text": "あなた。ずいぶん久しぶりですね。あなたが"}, {"type": "subtitle", "time": 6272.43, "timestamp": "01:44:32", "text": "行う"}, {"type": "subtitle", "time": 6276.03, "timestamp": "01:44:36", "text": "良い。モーとハッピーV"}, {"type": "subtitle", "time": 6279.43, "timestamp": "01:44:39", "text": "日。バレンタインデーおめでとう。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 6280.75, "timestamp": "01:44:40", "text": "良いことをしている。"}, {"type": "subtitle", "time": 6283.59, "timestamp": "01:44:43", "text": "いいえ。あなたに会うのは久しぶりですね。"}, {"type": "subtitle", "time": 6284.99, "timestamp": "01:44:44", "text": "で"}, {"type": "subtitle", "time": 6288.51, "timestamp": "01:44:48", "text": "ストリーム。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 6294.07, "timestamp": "01:44:54", "text": "良い。どうすればあの胸のスタイルを手に入れられますか？"}, {"type": "subtitle", "time": 6295.95, "timestamp": "01:44:55", "text": "どうすればそれを手に入れられますか？"}, {"type": "subtitle", "time": 6299.629, "timestamp": "01:44:59", "text": "胸？どうやって浮遊するの？"}]
[{"type": "subtitle", "time": 5702.11, "timestamp": "01:35:02", "text": "エーカー。ああ、胸が止まる。どうもありがとうございました"}, {"type": "subtitle", "time": 5705.43, "timestamp": "01:35:05", "text": "多くの。おい、何やってんだ？あなたは"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "おお。 H. あなたはただここに来ただけではないと思います"}, {"type": "subtitle", "time": 5717.43, "timestamp": "01:35:17", "text": "爪を使って拭き取ります。"}, {"type": "subtitle", "time": 5720.6, "timestamp": "01:35:20", "text": "疑問符。"}, {"type": "subtitle", "time": 5735.43, "timestamp": "01:35:35", "text": "あなた。私はトップに立つはずだった"}, {"type": "subtitle", "time": 5739.95, "timestamp": "01:35:39", "text": "えっと、飛び込むためのボードだけど、まあいいよ、"}, {"type": "subtitle", "time": 5744.07, "timestamp": "01:35:44", "text": "大丈夫。墓。"}, {"type": "subtitle", "time": 5747.75, "timestamp": "01:35:47", "text": "準備できました。さあ行こう。良い。ない"}, {"type": "subtitle", "time": 5749.21, "timestamp": "01:35:49", "text": "負ける時が来た。"}, {"type": "subtitle", "time": 5754.709, "timestamp": "01:35:54", "text": "私が探している遺物は一体何ですか？"}, {"type": "subtitle", "time": 5757.189, "timestamp": "01:35:57", "text": "取得しますか？価値。ああ、見て"}]
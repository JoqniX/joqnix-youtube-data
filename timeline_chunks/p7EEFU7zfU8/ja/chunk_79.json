[{"type": "subtitle", "time": 4741.75, "timestamp": "01:19:01", "text": "プレミアム？え、何？あなたはプレミアム会員ですか？する"}, {"type": "subtitle", "time": 4745.03, "timestamp": "01:19:05", "text": "ヒゲのために彼らを拷​​問することは含まれません。"}, {"type": "subtitle", "time": 4748.07, "timestamp": "01:19:08", "text": "何てことだ。ちなみに、よくやったね。"}, {"type": "subtitle", "time": 4750.55, "timestamp": "01:19:10", "text": "次は私に任せた方が良さそうだ。"}, {"type": "subtitle", "time": 4753.59, "timestamp": "01:19:13", "text": "時間。ほぼ同じくらいひどい状況はあなたに任せます"}, {"type": "subtitle", "time": 4756.07, "timestamp": "01:19:16", "text": "ルークウッドの密猟者の野蛮人として"}, {"type": "subtitle", "time": 4759.99, "timestamp": "01:19:19", "text": "パック。ああ、悲しいことに、私たちは"}, {"type": "subtitle", "time": 4763.11, "timestamp": "01:19:23", "text": "苦しむ。死んだ獣につまずきながら。"}, {"type": "subtitle", "time": 4765.83, "timestamp": "01:19:25", "text": "資源のひどい無駄遣いだ。"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "密猟者は裁きを受けることができる"}, {"type": "subtitle", "time": 4771.189, "timestamp": "01:19:31", "text": "誰かによって。今日アリを放してください。 1"}, {"type": "subtitle", "time": 4773.91, "timestamp": "01:19:33", "text": "楽観主義者。私はその友人です。は"}, {"type": "subtitle", "time": 4776.95, "timestamp": "01:19:36", "text": "押し下げられた。私たちはより差し迫ったことに焦点を当てています"}, {"type": "subtitle", "time": 4780.39, "timestamp": "01:19:40", "text": "私たちがコントロールできる事柄。教授"}, {"type": "subtitle", "time": 4782.87, "timestamp": "01:19:42", "text": "ウィーズリーは私にいくつか準備するように頼んだ"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "課題は、"}, {"type": "subtitle", "time": 4788.229, "timestamp": "01:19:48", "text": "他の5年生まで。に"}, {"type": "subtitle", "time": 4790.189, "timestamp": "01:19:50", "text": "私のフクロウに気を付けて。"}, {"type": "subtitle", "time": 4793.75, "timestamp": "01:19:53", "text": "アラ、私も勉強することを勧めます"}, {"type": "subtitle", "time": 4798.27, "timestamp": "01:19:58", "text": "自分の時間を使って、できるだけ多くの獣を捕まえましょう。"}]
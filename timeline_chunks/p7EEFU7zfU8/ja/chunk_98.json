[{"type": "subtitle", "time": 5881.51, "timestamp": "01:38:01", "text": "せっかくここまで来たのだから。私たちは"}, {"type": "subtitle", "time": 5883.189, "timestamp": "01:38:03", "text": "同盟は私がクリックするはずだったことを証明する"}, {"type": "subtitle", "time": 5885.35, "timestamp": "01:38:05", "text": "それらの対話についてですが、今は"}, {"type": "subtitle", "time": 5887.189, "timestamp": "01:38:07", "text": "大丈夫です。"}, {"type": "subtitle", "time": 5889.669, "timestamp": "01:38:09", "text": "私はここであなたのことを心待ちにしています"}, {"type": "subtitle", "time": 5894.27, "timestamp": "01:38:14", "text": "戻る。わかった。気をつけてください。"}]
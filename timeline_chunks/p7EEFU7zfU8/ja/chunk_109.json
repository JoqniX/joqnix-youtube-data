[{"type": "subtitle", "time": 6548.189, "timestamp": "01:49:08", "text": "[音楽]"}, {"type": "subtitle", "time": 6550.87, "timestamp": "01:49:10", "text": "えっと、初めて見ました"}, {"type": "subtitle", "time": 6552.229, "timestamp": "01:49:12", "text": "あなた。あなたはドイツ人だと思っていました。おお、"}, {"type": "subtitle", "time": 6554.99, "timestamp": "01:49:14", "text": "お前はドイツをクソくらえだ。ああ、"}, {"type": "subtitle", "time": 6568.95, "timestamp": "01:49:28", "text": "アクセント？何てことだ。待って、私は"}, {"type": "subtitle", "time": 6572.47, "timestamp": "01:49:32", "text": "火。どうやって自動的に私の"}, {"type": "subtitle", "time": 6581.149, "timestamp": "01:49:41", "text": "なぜ私がそうしなければならないのですか？ああ、"}, {"type": "subtitle", "time": 6589.629, "timestamp": "01:49:49", "text": "わかった。私はただ手に入れたいだけです"}, {"type": "subtitle", "time": 6599.669, "timestamp": "01:49:59", "text": "このシンボルは何か"}]
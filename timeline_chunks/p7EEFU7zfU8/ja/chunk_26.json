[{"type": "subtitle", "time": 1566.909, "timestamp": "00:26:06", "text": "[笑い]"}, {"type": "subtitle", "time": 1576.75, "timestamp": "00:26:16", "text": "30. それはもう一方に触れた"}, {"type": "subtitle", "time": 1585.789, "timestamp": "00:26:25", "text": "のために"}, {"type": "subtitle", "time": 1601.63, "timestamp": "00:26:41", "text": "はい、私が書きました。わかった、それ"}, {"type": "subtitle", "time": 1613.83, "timestamp": "00:26:53", "text": "右？何てことだ。 14. 私は"}, {"type": "subtitle", "time": 1618.59, "timestamp": "00:26:58", "text": "あなた。わかった。 1 2 3 4。あと4つ残っています"}]
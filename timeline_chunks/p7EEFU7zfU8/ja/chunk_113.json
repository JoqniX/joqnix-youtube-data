[{"type": "subtitle", "time": 6798.75, "timestamp": "01:53:18", "text": "ああ、わかった"}, {"type": "subtitle", "time": 6802.229, "timestamp": "01:53:22", "text": "きっと大丈夫でしょう"}, {"type": "subtitle", "time": 6803.75, "timestamp": "01:53:23", "text": "えっと"}, {"type": "subtitle", "time": 6804.91, "timestamp": "01:53:24", "text": "[音楽]"}, {"type": "subtitle", "time": 6808.669, "timestamp": "01:53:28", "text": "えっと、私は、私は、私は、"}, {"type": "subtitle", "time": 6810.35, "timestamp": "01:53:30", "text": "イライラした"}, {"type": "subtitle", "time": 6813.629, "timestamp": "01:53:33", "text": "これだけは知っておく"}, {"type": "subtitle", "time": 6816.79, "timestamp": "01:53:36", "text": "一度だけ、この一度だけ、前に私にさせてください"}, {"type": "subtitle", "time": 6826.189, "timestamp": "01:53:46", "text": "ウィンク。約束します。約束。次回は"}, {"type": "subtitle", "time": 6828.91, "timestamp": "01:53:48", "text": "しないだろう"}, {"type": "subtitle", "time": 6831.629, "timestamp": "01:53:51", "text": "浮気。うん。いいえ"}, {"type": "subtitle", "time": 6834.51, "timestamp": "01:53:54", "text": "心配事。私"}, {"type": "subtitle", "time": 6839.31, "timestamp": "01:53:59", "text": "そうはしないだろう。それは私たち二人の間の約束です"}]
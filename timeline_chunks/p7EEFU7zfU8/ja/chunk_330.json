[{"type": "subtitle", "time": 19801.83, "timestamp": "05:30:01", "text": "だって今まで復習してないから、ああ"}, {"type": "subtitle", "time": 19805.59, "timestamp": "05:30:05", "text": "うん、どうすればいいと思う？"}, {"type": "subtitle", "time": 19807.91, "timestamp": "05:30:07", "text": "日本に行けばわかるよ"}, {"type": "subtitle", "time": 19810.868, "timestamp": "05:30:10", "text": "ああ、試験をするだろうから"}, {"type": "subtitle", "time": 19813.83, "timestamp": "05:30:13", "text": "また学校の人たちは言語"}, {"type": "subtitle", "time": 19816.948, "timestamp": "05:30:16", "text": "学校は最初の週に試験を行います"}, {"type": "subtitle", "time": 19820.91, "timestamp": "05:30:20", "text": "6月になったら、入り口があります"}, {"type": "subtitle", "time": 19824.15, "timestamp": "05:30:24", "text": "式典、そう、彼らは"}, {"type": "subtitle", "time": 19827.59, "timestamp": "05:30:27", "text": "私をクラスに割り当ててください"}, {"type": "subtitle", "time": 19830.39, "timestamp": "05:30:30", "text": "私の理解度に応じて"}, {"type": "subtitle", "time": 19833.83, "timestamp": "05:30:33", "text": "もし私が基本的なことを知っているなら、"}, {"type": "subtitle", "time": 19836.07, "timestamp": "05:30:36", "text": "N4でよければ、彼らは私を"}, {"type": "subtitle", "time": 19839.43, "timestamp": "05:30:39", "text": "4バッチ、というかそんな感じだと思う"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "それで生徒のクラスメートは"}, {"type": "subtitle", "time": 19846.39, "timestamp": "05:30:46", "text": "4月に入学した人が私にこう言った"}, {"type": "subtitle", "time": 19849.67, "timestamp": "05:30:49", "text": "彼らはそれをフォーマットするか、"}, {"type": "subtitle", "time": 19852.788, "timestamp": "05:30:52", "text": "ああ、それは私には好きになれないみたい"}, {"type": "subtitle", "time": 19855.27, "timestamp": "05:30:55", "text": "想像してみて、私はあなたからしか知らない"}, {"type": "subtitle", "time": 19857.75, "timestamp": "05:30:57", "text": "体験すると、"}]
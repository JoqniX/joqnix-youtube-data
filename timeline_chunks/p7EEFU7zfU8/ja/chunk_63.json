[{"type": "subtitle", "time": 3782.71, "timestamp": "01:03:02", "text": "うん、8時半くらいかな。しかし昨日"}, {"type": "subtitle", "time": 3785.75, "timestamp": "01:03:05", "text": "私のお祝い事やその他諸々と同じように、"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "それら全てはそこにある。だから私は"}, {"type": "subtitle", "time": 3791.19, "timestamp": "01:03:11", "text": "えーと、大家さんに招待された、私の昔の"}, {"type": "subtitle", "time": 3794.63, "timestamp": "01:03:14", "text": "大家さん、私の最初の大家さんで、えっと"}, {"type": "subtitle", "time": 3799.23, "timestamp": "01:03:19", "text": "そこで食事をしたり、いろいろと食べたりしてください。だから私はこう思った、"}, {"type": "subtitle", "time": 3802.39, "timestamp": "01:03:22", "text": "「ああ、私はとても驚いた"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "「そこから食べられるんだ。」って、マジで、どうやって"}, {"type": "subtitle", "time": 3809.589, "timestamp": "01:03:29", "text": "一体どうやってそんなことをしたんだろう？それはとても"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "驚きだ。そしてここでは触れることさえできない"}, {"type": "subtitle", "time": 3815.43, "timestamp": "01:03:35", "text": "ご飯をスプーン３杯。スプーン3杯後"}, {"type": "subtitle", "time": 3818.109, "timestamp": "01:03:38", "text": "米のことですが、「ああ、私は"}, {"type": "subtitle", "time": 3820.789, "timestamp": "01:03:40", "text": "食べる。何かおかしいと思う"}, {"type": "subtitle", "time": 3821.87, "timestamp": "01:03:41", "text": "私の"}, {"type": "subtitle", "time": 3824.549, "timestamp": "01:03:44", "text": "お腹。何をするか？私のお腹は"}, {"type": "subtitle", "time": 3825.71, "timestamp": "01:03:45", "text": "聴いている"}, {"type": "subtitle", "time": 3830.39, "timestamp": "01:03:50", "text": "自分。これは悪いことではないでしょうか？私は感じる"}, {"type": "subtitle", "time": 3834.51, "timestamp": "01:03:54", "text": "これは実際には悪い"}, {"type": "subtitle", "time": 3837.19, "timestamp": "01:03:57", "text": "もの。まるで、お腹が言うことを聞かないみたいだ。"}, {"type": "subtitle", "time": 3839.99, "timestamp": "01:03:59", "text": "そういう悪ふざけのことですよ。あなた"}]
[{"type": "subtitle", "time": 19501.35, "timestamp": "05:25:01", "text": "もうすぐ6月ですよね？次の明日は"}, {"type": "subtitle", "time": 19518.47, "timestamp": "05:25:18", "text": "私が作らなければならないもののリスト"}, {"type": "subtitle", "time": 19522.31, "timestamp": "05:25:22", "text": "もちろん、配信しながら仕事もできますよ。つまりラップトップは"}, {"type": "subtitle", "time": 19523.55, "timestamp": "05:25:23", "text": "1つ"}, {"type": "subtitle", "time": 19526.47, "timestamp": "05:25:26", "text": "優先順位と部屋とすべてが"}, {"type": "subtitle", "time": 19529.99, "timestamp": "05:25:29", "text": "ドメトリと、秒に関するすべてのもの。"}, {"type": "subtitle", "time": 19531.75, "timestamp": "05:25:31", "text": "ええ、それも必要です。ああ、あれら"}, {"type": "subtitle", "time": 19534.07, "timestamp": "05:25:34", "text": "最優先事項です。"}, {"type": "subtitle", "time": 19537.19, "timestamp": "05:25:37", "text": "授業は私が思うすべてです"}, {"type": "subtitle", "time": 19541.11, "timestamp": "05:25:41", "text": "どうすればいいか見てみよう"}, {"type": "subtitle", "time": 19544.39, "timestamp": "05:25:44", "text": "それにも全て適応しなければならない。だからそれは"}, {"type": "subtitle", "time": 19545.798, "timestamp": "05:25:45", "text": "は でも、それは少しは意味があるでしょう。"}, {"type": "subtitle", "time": 19556.11, "timestamp": "05:25:56", "text": "Uh Jakata は終了します"}, {"type": "subtitle", "time": 19559.708, "timestamp": "05:25:59", "text": "6月に終了する予定"}]
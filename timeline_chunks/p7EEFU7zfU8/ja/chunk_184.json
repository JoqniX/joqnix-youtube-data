[{"type": "subtitle", "time": 11040.389, "timestamp": "03:04:00", "text": "どこだ？ ああ、なんてことだ、島だ。"}, {"type": "subtitle", "time": 11042.55, "timestamp": "03:04:02", "text": "ここはあなたの獣たちのための場所のようですね"}, {"type": "subtitle", "time": 11044.55, "timestamp": "03:04:04", "text": "生きる。何らかのババリウム。 A"}, {"type": "subtitle", "time": 11047.11, "timestamp": "03:04:07", "text": "ヴァヴァリウム。あなたの獣はまさに何"}, {"type": "subtitle", "time": 11049.71, "timestamp": "03:04:09", "text": "あれは？何？私はそれを聞いて立ち尽くす。安全"}, {"type": "subtitle", "time": 11052.79, "timestamp": "03:04:12", "text": "ライト。もしかしたら、あなたは彼らを解放したいと思っているのかもしれません。"}, {"type": "subtitle", "time": 11056.15, "timestamp": "03:04:16", "text": "彼らに新しい家を見せてあげましょう。はい。 Hは"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "管理。何てことだ。私はたくさんの"}, {"type": "subtitle", "time": 11060.75, "timestamp": "03:04:20", "text": "彼ら。"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "こんにちは。あ、待って。追加できるのはあなただけです"}, {"type": "subtitle", "time": 11084.309, "timestamp": "03:04:44", "text": "[音楽]"}, {"type": "subtitle", "time": 11088.23, "timestamp": "03:04:48", "text": "残りの人たちはどうですか？"}, {"type": "subtitle", "time": 11091.99, "timestamp": "03:04:51", "text": "次に私がすること。"}, {"type": "subtitle", "time": 11094.389, "timestamp": "03:04:54", "text": "ああ、彼らを見てごらん。とてもかわいい。青"}, {"type": "subtitle", "time": 11096.87, "timestamp": "03:04:56", "text": "鳥。 Deは、ヴァヴァリウムが"}, {"type": "subtitle", "time": 11099.75, "timestamp": "03:04:59", "text": "あなたのペットにぴったりの新しい家。"}]
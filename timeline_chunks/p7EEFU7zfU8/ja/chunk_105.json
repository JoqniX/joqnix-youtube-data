[{"type": "subtitle", "time": 6304.51, "timestamp": "01:45:04", "text": "あなた自身ですか？自分自身に魔法をかけることはできますか？"}, {"type": "subtitle", "time": 6312.669, "timestamp": "01:45:12", "text": "必ずあるはずだ"}, {"type": "subtitle", "time": 6329.27, "timestamp": "01:45:29", "text": "だから、私は自分の側につくことはできないと思う。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "いいえ、できません。はい、できません。えっと、それは"}, {"type": "subtitle", "time": 6335.75, "timestamp": "01:45:35", "text": "何か。それはそれで良いことだ。それは"}, {"type": "subtitle", "time": 6338.189, "timestamp": "01:45:38", "text": "何か。これは"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "痛み。待って、待って、待って、待って、待って。だから私は"}, {"type": "subtitle", "time": 6344.149, "timestamp": "01:45:44", "text": "ここに立ってください。疑問符。"}, {"type": "subtitle", "time": 6352.669, "timestamp": "01:45:52", "text": "撃退する。"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "いいえ。どうすれば上に立てるんですか？"}]
[{"type": "subtitle", "time": 19261.59, "timestamp": "05:21:01", "text": "1080pまたは4Kのようなキャプチャカード。いいえ、あなた"}, {"type": "subtitle", "time": 19262.75, "timestamp": "05:21:02", "text": "必要ない"}, {"type": "subtitle", "time": 19266.948, "timestamp": "05:21:06", "text": "4K。 1080pキャプチャカード。それでうまくいくでしょう。"}, {"type": "subtitle", "time": 19270.51, "timestamp": "05:21:10", "text": "でも、キャプチャ"}, {"type": "subtitle", "time": 19273.35, "timestamp": "05:21:13", "text": "カード。ええ、こういうキャプチャですね"}, {"type": "subtitle", "time": 19275.788, "timestamp": "05:21:15", "text": "あなたができるカード、私は"}, {"type": "subtitle", "time": 19281.47, "timestamp": "05:21:21", "text": "推測。待って、それってうまくいくの？はぁ？どうやって"}, {"type": "subtitle", "time": 19285.15, "timestamp": "05:21:25", "text": "多くの？そしてCXCには"}, {"type": "subtitle", "time": 19288.948, "timestamp": "05:21:28", "text": "15,000。私は「うん、うん、6」って感じだった。"}, {"type": "subtitle", "time": 19295.07, "timestamp": "05:21:35", "text": "あ、待って。 9,999。わかった。わずか9,000人。何？"}, {"type": "subtitle", "time": 19297.91, "timestamp": "05:21:37", "text": "よし、こういうキャプチャカードは、"}, {"type": "subtitle", "time": 19300.07, "timestamp": "05:21:40", "text": "故障などを引き起こす可能性があります。なれ"}, {"type": "subtitle", "time": 19302.47, "timestamp": "05:21:42", "text": "偽ブランド品を買わないように注意してください"}, {"type": "subtitle", "time": 19305.11, "timestamp": "05:21:45", "text": "そして、これらは偽物ではなく、"}, {"type": "subtitle", "time": 19308.788, "timestamp": "05:21:48", "text": "任天堂、Switch、PS4、PS5、それらすべて"}, {"type": "subtitle", "time": 19310.948, "timestamp": "05:21:50", "text": "PCの場合は、次のようなものを入手するのが良いでしょう"}, {"type": "subtitle", "time": 19313.23, "timestamp": "05:21:53", "text": "内部のような"}, {"type": "subtitle", "time": 19315.83, "timestamp": "05:21:55", "text": "1つ。内部的に入手する方が良い"}, {"type": "subtitle", "time": 19318.07, "timestamp": "05:21:58", "text": "1つ。つまり、マザーボードを購入する必要があるということですね。"}]
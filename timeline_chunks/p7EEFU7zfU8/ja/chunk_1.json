[{"type": "subtitle", "time": 67.27, "timestamp": "00:01:07", "text": "ねえ、下の会話を聞いてみて。"}, {"type": "subtitle", "time": 75.109, "timestamp": "00:01:15", "text": "ああ、わかった。わかった。わかった。それは"}, {"type": "subtitle", "time": 77.67, "timestamp": "00:01:17", "text": "底。わかった。私は「待って、私は」と思った。"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "音声を聞くことになっている"}, {"type": "subtitle", "time": 82.149, "timestamp": "00:01:22", "text": "雇用と、彼らが"}, {"type": "subtitle", "time": 92.99000000000001, "timestamp": "00:01:32", "text": "富士"}, {"type": "subtitle", "time": 97.35, "timestamp": "00:01:37", "text": "ホテル、ほら、あの昔のおじさんみたいな"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "おじさんではなく、サラリーマンや"}, {"type": "subtitle", "time": 103.67, "timestamp": "00:01:43", "text": "大人みたいにね？日本のホテルは"}, {"type": "subtitle", "time": 108.59, "timestamp": "00:01:48", "text": "成熟した叔父のような存在"}, {"type": "subtitle", "time": 110.10900000000001, "timestamp": "00:01:50", "text": "ない"}, {"type": "subtitle", "time": 115.03, "timestamp": "00:01:55", "text": "日本人のように、彼らはクールな声をしている"}]
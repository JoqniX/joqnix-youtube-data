[{"type": "subtitle", "time": 3661.589, "timestamp": "01:01:01", "text": "とにかく、今日私が遅刻した理由は"}, {"type": "subtitle", "time": 3664.39, "timestamp": "01:01:04", "text": "いつものように、私は困難に直面していましたが、"}, {"type": "subtitle", "time": 3668.549, "timestamp": "01:01:08", "text": "私は食べるのが好きです。なぜだかわからない"}, {"type": "subtitle", "time": 3670.63, "timestamp": "01:01:10", "text": "それで、叔母が私に３つくれた"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "チャパティ。わかった。私は彼女に、"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "チャパティ3枚。私はあなたが食べられるものだけを食べます"}, {"type": "subtitle", "time": 3678.23, "timestamp": "01:01:18", "text": "2つ取り除く。そして私はこう思った"}, {"type": "subtitle", "time": 3680.309, "timestamp": "01:01:20", "text": "2つは食べられる自信がある。わかった。しかし"}, {"type": "subtitle", "time": 3682.71, "timestamp": "01:01:22", "text": "何が起こったか知ってる？私のお腹は"}, {"type": "subtitle", "time": 3684.43, "timestamp": "01:01:24", "text": "フルアフター"}, {"type": "subtitle", "time": 3686.03, "timestamp": "01:01:26", "text": "1つ"}, {"type": "subtitle", "time": 3690.95, "timestamp": "01:01:30", "text": "チャパティ。だから私はほとんどほとんど食べなかった"}, {"type": "subtitle", "time": 3693.67, "timestamp": "01:01:33", "text": "2番目。そして私は感じ始めた"}, {"type": "subtitle", "time": 3697.03, "timestamp": "01:01:37", "text": "不快で、ほとんど"}, {"type": "subtitle", "time": 3699.03, "timestamp": "01:01:39", "text": "吐いたりした。おい、何なんだ"}, {"type": "subtitle", "time": 3701.309, "timestamp": "01:01:41", "text": "ハプニング？昼食も同じです。"}, {"type": "subtitle", "time": 3704.63, "timestamp": "01:01:44", "text": "夕食。何が起こっている？ボディチャマ"}, {"type": "subtitle", "time": 3707.109, "timestamp": "01:01:47", "text": "そして、そして、私が戻ってきたとき"}, {"type": "subtitle", "time": 3710.069, "timestamp": "01:01:50", "text": "椅子のところに、大きな蜘蛛の巣がある。私"}, {"type": "subtitle", "time": 3713.03, "timestamp": "01:01:53", "text": "これはとても美しいのですが、"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "座って配信しないといけない。ああ、私は"}, {"type": "subtitle", "time": 3718.23, "timestamp": "01:01:58", "text": "破壊するのがとても辛かったので、"}]
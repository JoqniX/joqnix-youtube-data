[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "十分なスペースがあることを願うばかりです"}, {"type": "subtitle", "time": 11104.309, "timestamp": "03:05:04", "text": "全員です。ええ、ディーもそう願っています。しかし"}, {"type": "subtitle", "time": 11106.71, "timestamp": "03:05:06", "text": "もしスペースが足りなくなったら、マダム・ピーク"}, {"type": "subtitle", "time": 11109.59, "timestamp": "03:05:09", "text": "ホグスミーのブルードとピークでは、"}, {"type": "subtitle", "time": 11112.469, "timestamp": "03:05:12", "text": "彼らのために安全な住まいを見つけてあげましょう。どんな獣でも"}, {"type": "subtitle", "time": 11115.03, "timestamp": "03:05:15", "text": "部屋がいっぱいですか？はい、彼女はよく知られています"}, {"type": "subtitle", "time": 11117.59, "timestamp": "03:05:17", "text": "困っている動物たちの世話を手伝うために、"}, {"type": "subtitle", "time": 11119.75, "timestamp": "03:05:19", "text": "そして彼女はあなたに適正な価格を提示するでしょう"}, {"type": "subtitle", "time": 11122.07, "timestamp": "03:05:22", "text": "彼ら。はい、それらは販売できます。わかった。"}, {"type": "subtitle", "time": 11124.63, "timestamp": "03:05:24", "text": "十分に餌を与えられ、手入れされた動物は"}, {"type": "subtitle", "time": 11126.75, "timestamp": "03:05:26", "text": "貴重な魔法を提供します"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "パフスキンヘアなどの素材"}, {"type": "subtitle", "time": 11132.63, "timestamp": "03:05:32", "text": "例。魔法のアイテムを集めたら"}, {"type": "subtitle", "time": 11134.79, "timestamp": "03:05:34", "text": "あなたの獣の素材を見せることができます"}, {"type": "subtitle", "time": 11136.95, "timestamp": "03:05:36", "text": "それらの使い方を教えてあげます。使用方法とても"}, {"type": "subtitle", "time": 11138.79, "timestamp": "03:05:38", "text": "良い。準備ができたらお知らせします"}, {"type": "subtitle", "time": 11142.309, "timestamp": "03:05:42", "text": "いくつかの。はい。"}, {"type": "subtitle", "time": 11145.15, "timestamp": "03:05:45", "text": "君たちに食事を与えなきゃいけないんだ。"}, {"type": "subtitle", "time": 11146.97, "timestamp": "03:05:46", "text": "いいえ。餌やりの時間です。"}, {"type": "subtitle", "time": 11154.29, "timestamp": "03:05:54", "text": "あなた。素晴らしい。"}]
[{"type": "subtitle", "time": 16263.03, "timestamp": "04:31:03", "text": "男の子。ああ、神様、私は死んでしまった。私は死んだ。私は"}, {"type": "subtitle", "time": 16267.11, "timestamp": "04:31:07", "text": "死んだ。私は死んだ。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 16284.229, "timestamp": "04:31:24", "text": "くそ、あと少しだったのに。ダメージを受けた"}, {"type": "subtitle", "time": 16286.91, "timestamp": "04:31:26", "text": "その不足分から。その"}, {"type": "subtitle", "time": 16289.91, "timestamp": "04:31:29", "text": "わかった。私たちはもっとうまくやれる。これを押させてください"}, {"type": "subtitle", "time": 16304.07, "timestamp": "04:31:44", "text": "はい、私はレベル24ですが、レベルは26でした。"}, {"type": "subtitle", "time": 16314.469, "timestamp": "04:31:54", "text": "男。これを元に戻してから戻ってきます。"}]
[{"type": "subtitle", "time": 8461.99, "timestamp": "02:21:01", "text": "お金がないんです。貧乏なので。私は必要としている 私は必要としている"}, {"type": "subtitle", "time": 8464.11, "timestamp": "02:21:04", "text": "実際に作る"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "お金。こんにちは。石棺は"}, {"type": "subtitle", "time": 8470.469, "timestamp": "02:21:10", "text": "襲撃された。ヘルメットは見つからなかった。死者のみ"}, {"type": "subtitle", "time": 8473.91, "timestamp": "02:21:13", "text": "アシュウィナー。くそ、奴らが先だったのか。私たちは"}, {"type": "subtitle", "time": 8475.99, "timestamp": "02:21:15", "text": "ルークウッドが使う前に手に入れる必要がある"}, {"type": "subtitle", "time": 8477.67, "timestamp": "02:21:17", "text": "さらに彼に取り入るために"}, {"type": "subtitle", "time": 8480.389, "timestamp": "02:21:20", "text": "ランドロック。彼らのキャンプサイトの一つを見た"}, {"type": "subtitle", "time": 8482.63, "timestamp": "02:21:22", "text": "ここからそう遠くないが、あなたは"}, {"type": "subtitle", "time": 8485.19, "timestamp": "02:21:25", "text": "一人で入りなさい。私の闘士時代は終わった"}, {"type": "subtitle", "time": 8487.429, "timestamp": "02:21:27", "text": "自分。"}, {"type": "subtitle", "time": 8491.03, "timestamp": "02:21:31", "text": "最善を尽くします。"}, {"type": "subtitle", "time": 8493.51, "timestamp": "02:21:33", "text": "今からそこへ向かいます。良い。ない"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "負ける時が来た。ヘルメットを手に入れる前に"}, {"type": "subtitle", "time": 8498.309, "timestamp": "02:21:38", "text": "ルークウッドがそうしないと、チャンスを失ってしまう"}, {"type": "subtitle", "time": 8501.03, "timestamp": "02:21:41", "text": "あらゆるレベルで。どんなに小さくても"}, {"type": "subtitle", "time": 8503.91, "timestamp": "02:21:43", "text": "ランロック、まずは分け前をもらわないといけない。"}, {"type": "subtitle", "time": 8505.75, "timestamp": "02:21:45", "text": "あの忌まわしい泥棒どもが"}, {"type": "subtitle", "time": 8507.83, "timestamp": "02:21:47", "text": "彼らの手がそのような遺物に触れるとは。私は必要としている"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "分量とか色々。私は4000ドル持っています。"}, {"type": "subtitle", "time": 8518.51, "timestamp": "02:21:58", "text": "リッチ。ちょっと遠いですね"}]
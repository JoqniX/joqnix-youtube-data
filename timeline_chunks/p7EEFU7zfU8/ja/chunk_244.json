[{"type": "subtitle", "time": 14645.03, "timestamp": "04:04:05", "text": "戦争。それはモロッコと呼ばれています。これです。それは"}, {"type": "subtitle", "time": 14647.91, "timestamp": "04:04:07", "text": "移動シューティングゲーム。私の好みの私の好みの"}, {"type": "subtitle", "time": 14650.95, "timestamp": "04:04:10", "text": "ある種のゲーム。素敵な"}, {"type": "subtitle", "time": 14665.75, "timestamp": "04:04:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14668.469, "timestamp": "04:04:28", "text": "インセンディオ。"}, {"type": "subtitle", "time": 14672.5, "timestamp": "04:04:32", "text": "なぜ聞こえないのですか？こんにちは。"}, {"type": "subtitle", "time": 14674.55, "timestamp": "04:04:34", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4500.03, "timestamp": "01:15:00", "text": "ブラシを押してドラッグします"}, {"type": "subtitle", "time": 4507.31, "timestamp": "01:15:07", "text": "良い。ああ、どうやって使うのか。おお、"}, {"type": "subtitle", "time": 4515.55, "timestamp": "01:15:15", "text": "見る。"}, {"type": "subtitle", "time": 4518.55, "timestamp": "01:15:18", "text": "ブラシでルックを描きましょう。"}, {"type": "subtitle", "time": 4520.95, "timestamp": "01:15:20", "text": "素敵ですね。彼はきっと"}, {"type": "subtitle", "time": 4522.55, "timestamp": "01:15:22", "text": "より良い。"}, {"type": "subtitle", "time": 4525.35, "timestamp": "01:15:25", "text": "これを見てください。お腹が空いているかもしれませんね。だろう"}, {"type": "subtitle", "time": 4528.229, "timestamp": "01:15:28", "text": "彼に獣用の餌をあげてもらえませんか？"}, {"type": "subtitle", "time": 4530.43, "timestamp": "01:15:30", "text": "いいえ。あなたは私にこの呪文を授けるつもりです。"}, {"type": "subtitle", "time": 4538.63, "timestamp": "01:15:38", "text": "ああ、ペレットの味は"}, {"type": "subtitle", "time": 4541.669, "timestamp": "01:15:41", "text": "ジェラルド。プリン。私は思うのが好きです"}, {"type": "subtitle", "time": 4543.59, "timestamp": "01:15:43", "text": "プリン。安心して言えると思う"}, {"type": "subtitle", "time": 4547.03, "timestamp": "01:15:47", "text": "ジェラルドは君のことが好きだよ。それは良い知らせですね。彼"}, {"type": "subtitle", "time": 4550.95, "timestamp": "01:15:50", "text": "とても良さそうですね。うん。彼はそうだ。親切とは"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "彼の最も優れた資質のひとつが、まさにその直後に現れた。"}, {"type": "subtitle", "time": 4557.35, "timestamp": "01:15:57", "text": "親切、温かさ、そして清潔さ。"}, {"type": "subtitle", "time": 4559.83, "timestamp": "01:15:59", "text": "皆さん、よく頑張りました。しかしそれは"}]
[{"type": "subtitle", "time": 17101.35, "timestamp": "04:45:01", "text": "必要な人は誰でも救うつもりです"}, {"type": "subtitle", "time": 17113.11, "timestamp": "04:45:13", "text": "コンフリンゴ。"}, {"type": "subtitle", "time": 17118.47, "timestamp": "04:45:18", "text": "待て、この獣は。自分で取りに行きます。"}, {"type": "subtitle", "time": 17138.47, "timestamp": "04:45:38", "text": "そこにヒゲがある。私は傷つけない"}, {"type": "subtitle", "time": 17152.628, "timestamp": "04:45:52", "text": "ああ、なるほど。仲間たちの声が聞こえる。あなた"}, {"type": "subtitle", "time": 17155.51, "timestamp": "04:45:55", "text": "必要。"}]
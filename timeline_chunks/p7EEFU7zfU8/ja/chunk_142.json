[{"type": "subtitle", "time": 8521.63, "timestamp": "02:22:01", "text": "今。あなたが知っている"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "何？私はそうするべきだと思う、ほら"}, {"type": "subtitle", "time": 8528.91, "timestamp": "02:22:08", "text": "私はどうする？私は豚に戻ります"}, {"type": "subtitle", "time": 8541.429, "timestamp": "02:22:21", "text": "用品。それは良いことだと思います"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "推測。補充しておきましょう。"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "商人を探さなければならない。はい、これです"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "最後のクレメンタイン。いらっしゃいませ。どうぞお入りください。"}, {"type": "subtitle", "time": 8563.349, "timestamp": "02:22:43", "text": "わかった。さて、どこまで話したっけ？右。ああ、そうだね。"}, {"type": "subtitle", "time": 8565.19, "timestamp": "02:22:45", "text": "種とかは要らないよ。私はただ"}, {"type": "subtitle", "time": 8568.59, "timestamp": "02:22:48", "text": "商品を売る必要がある。私はしません"}, {"type": "subtitle", "time": 8571.27, "timestamp": "02:22:51", "text": "これを売ってください。あなたは頭が良いので"}, {"type": "subtitle", "time": 8574.349, "timestamp": "02:22:54", "text": "ビジネスをしているんですよね？売る"}]
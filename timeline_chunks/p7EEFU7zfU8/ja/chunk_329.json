[{"type": "subtitle", "time": 19741.03, "timestamp": "05:29:01", "text": "[音楽]"}, {"type": "subtitle", "time": 19743.43, "timestamp": "05:29:03", "text": "まるでこれが難しい部分であるかのように"}, {"type": "subtitle", "time": 19745.67, "timestamp": "05:29:05", "text": "exa での執筆は、実際には"}, {"type": "subtitle", "time": 19748.35, "timestamp": "05:29:08", "text": "好きなもの以外にも覚えておいてください"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "繰り返して、私はたくさん話すのが好きです"}, {"type": "subtitle", "time": 19755.43, "timestamp": "05:29:15", "text": "私はそうやって覚えているのであって、書くわけではないので"}, {"type": "subtitle", "time": 19757.91, "timestamp": "05:29:17", "text": "うん、それは本当に難しいことだ"}, {"type": "subtitle", "time": 19759.35, "timestamp": "05:29:19", "text": "私が書くのが好きなものは"}, {"type": "subtitle", "time": 19763.11, "timestamp": "05:29:23", "text": "数式や、"}, {"type": "subtitle", "time": 19772.39, "timestamp": "05:29:32", "text": "キスを書くとき、私の"}, {"type": "subtitle", "time": 19774.628, "timestamp": "05:29:34", "text": "友達は漢字を読んだみたいだった"}, {"type": "subtitle", "time": 19777.51, "timestamp": "05:29:37", "text": "それで、あなたは大丈夫、あなたは"}, {"type": "subtitle", "time": 19781.19, "timestamp": "05:29:41", "text": "キスを読んで覚えていることは"}, {"type": "subtitle", "time": 19784.23, "timestamp": "05:29:44", "text": "漢字が苦手な私を見ると、"}, {"type": "subtitle", "time": 19787.75, "timestamp": "05:29:47", "text": "家出少女だけど、まあ、最善を尽くすわ"}, {"type": "subtitle", "time": 19790.07, "timestamp": "05:29:50", "text": "読んで理解しようとする"}, {"type": "subtitle", "time": 19793.47, "timestamp": "05:29:53", "text": "記号の意味"}, {"type": "subtitle", "time": 19796.788, "timestamp": "05:29:56", "text": "えっと、クリグは今か何か"}, {"type": "subtitle", "time": 19799.11, "timestamp": "05:29:59", "text": "基本的なことを全部忘れてしまった"}]
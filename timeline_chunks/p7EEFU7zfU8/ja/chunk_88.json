[{"type": "subtitle", "time": 5280.91, "timestamp": "01:28:00", "text": "えーっと、あの場所って何？"}, {"type": "subtitle", "time": 5285.629, "timestamp": "01:28:05", "text": "また？えっと、ホグワーツ？ いや、ホグワーツじゃないよ。"}, {"type": "subtitle", "time": 5297.11, "timestamp": "01:28:17", "text": "え、何？ 何を押せばいいの？ああ、私は押しました"}, {"type": "subtitle", "time": 5309.99, "timestamp": "01:28:29", "text": "なぜ今、こんなに多くの人がいるのでしょうか？"}, {"type": "subtitle", "time": 5312.71, "timestamp": "01:28:32", "text": "毛深いだけ。"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "[音楽]"}, {"type": "subtitle", "time": 5325.03, "timestamp": "01:28:45", "text": "こんにちは。会えてうれしい。"}, {"type": "subtitle", "time": 5327.99, "timestamp": "01:28:47", "text": "みなさん、こんにちは。こんにちは、ライアンさん。私は"}, {"type": "subtitle", "time": 5329.35, "timestamp": "01:28:49", "text": "ご協力ありがとうございました。"}, {"type": "subtitle", "time": 5331.11, "timestamp": "01:28:51", "text": "ルークウッドとハーロウ、トロールの日"}, {"type": "subtitle", "time": 5334.39, "timestamp": "01:28:54", "text": "攻撃。セローナをお願いします。その時私は幸せだった"}, {"type": "subtitle", "time": 5337.83, "timestamp": "01:28:57", "text": "手伝うために。待って、あの二人はなぜ彼女は"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "声"}]
[{"type": "subtitle", "time": 4921.669, "timestamp": "01:22:01", "text": "あれ、私、自分に「おはよう」って言ったっけ？私"}, {"type": "subtitle", "time": 4924.95, "timestamp": "01:22:04", "text": "おはよう、ニャー、子犬ちゃん。"}, {"type": "subtitle", "time": 4927.75, "timestamp": "01:22:07", "text": "私をどこへ連れて行くつもりですか？本当にそうですね"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "実際にお見せした方がずっと分かりやすいでしょう。"}, {"type": "subtitle", "time": 4934.31, "timestamp": "01:22:14", "text": "いやー、ショートヘアの人って本当に可愛いよね。"}, {"type": "subtitle", "time": 4936.629, "timestamp": "01:22:16", "text": "もうすぐだ。ただ、私は"}, {"type": "subtitle", "time": 4939.47, "timestamp": "01:22:19", "text": "髪の毛が増える"}, {"type": "subtitle", "time": 4948.55, "timestamp": "01:22:28", "text": "下がってください。"}, {"type": "subtitle", "time": 4958.189, "timestamp": "01:22:38", "text": "おお。ああ、"}, {"type": "subtitle", "time": 4963.189, "timestamp": "01:22:43", "text": "神。フクロウです。ペガサスの疑問符。"}, {"type": "subtitle", "time": 4966.95, "timestamp": "01:22:46", "text": "いいえ、鳥です。いいえ、フクロウではなく、鳥です。"}, {"type": "subtitle", "time": 4969.75, "timestamp": "01:22:49", "text": "ハイウィング。ハイウィング。わかった。彼女はただ"}, {"type": "subtitle", "time": 4972.79, "timestamp": "01:22:52", "text": "壮大？鷲の頭のように見える"}, {"type": "subtitle", "time": 4977.27, "timestamp": "01:22:57", "text": "馬と一緒に。しかし、注意してください。絶対です"}, {"type": "subtitle", "time": 4979.83, "timestamp": "01:22:59", "text": "カバには常に適切な礼儀を示すこと"}]
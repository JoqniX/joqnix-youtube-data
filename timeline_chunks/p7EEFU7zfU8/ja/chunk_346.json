[{"type": "subtitle", "time": 20762.39, "timestamp": "05:46:02", "text": "私は試しました 私は試しました 私は練習しました"}, {"type": "subtitle", "time": 20764.868, "timestamp": "05:46:04", "text": "ヨアトンをやっている。私は練習しましたし、"}, {"type": "subtitle", "time": 20767.35, "timestamp": "05:46:07", "text": "著作権侵害警告をいくつか受けた"}, {"type": "subtitle", "time": 20770.948, "timestamp": "05:46:10", "text": "練習しながら。私が何をしたか知ってる？私"}, {"type": "subtitle", "time": 20773.51, "timestamp": "05:46:13", "text": "インストゥルメンタルとオリジナル曲を入れる"}, {"type": "subtitle", "time": 20777.03, "timestamp": "05:46:17", "text": "音楽ソフトウェア上で。私はAbletonを使っています"}, {"type": "subtitle", "time": 20779.51, "timestamp": "05:46:19", "text": "今。だから、私はあなたが"}, {"type": "subtitle", "time": 20781.23, "timestamp": "05:46:21", "text": "分離する"}, {"type": "subtitle", "time": 20785.11, "timestamp": "05:46:25", "text": "外。分けて考えることができます。だから私は試してみます"}, {"type": "subtitle", "time": 20789.27, "timestamp": "05:46:29", "text": "それを行うために。ええと、それでストリームは"}, {"type": "subtitle", "time": 20791.51, "timestamp": "05:46:31", "text": "インストゥルメンタルだけを聴けば、"}, {"type": "subtitle", "time": 20795.59, "timestamp": "05:46:35", "text": "ええと、オリジナル版です。そこで質問は"}, {"type": "subtitle", "time": 20798.31, "timestamp": "05:46:38", "text": "問題は、以前はこうしていたのですが"}, {"type": "subtitle", "time": 20801.51, "timestamp": "05:46:41", "text": "私はあるブラウザを使いました。私が使っているもの"}, {"type": "subtitle", "time": 20804.31, "timestamp": "05:46:44", "text": "ブラウザで曲を再生する"}, {"type": "subtitle", "time": 20807.91, "timestamp": "05:46:47", "text": "オリジナル曲をVLCで再生して"}, {"type": "subtitle", "time": 20810.47, "timestamp": "05:46:50", "text": "メディアプレーヤーか何かストリーミング用のものだけど"}, {"type": "subtitle", "time": 20813.35, "timestamp": "05:46:53", "text": "タイミングが悪くて、今はプレイするのが難しかった"}, {"type": "subtitle", "time": 20817.19, "timestamp": "05:46:57", "text": "両面、両方のトラックを再生してください。"}, {"type": "subtitle", "time": 20819.91, "timestamp": "05:46:59", "text": "うん。そこで私は"}]
[{"type": "subtitle", "time": 367.469, "timestamp": "00:06:07", "text": "推測。えっと、スクリーンショットはありますか？"}, {"type": "subtitle", "time": 370.39, "timestamp": "00:06:10", "text": "私はそうは思いません。待って、"}, {"type": "subtitle", "time": 390.67, "timestamp": "00:06:30", "text": "[音楽]"}, {"type": "subtitle", "time": 410.59000000000003, "timestamp": "00:06:50", "text": "東。疲れていないのですか？私は"}, {"type": "subtitle", "time": 413.59000000000003, "timestamp": "00:06:53", "text": "けれど。これを終わらせなければならない。そうじゃない？"}, {"type": "subtitle", "time": 415.30899999999997, "timestamp": "00:06:55", "text": "終わらせなければならない"}]
[{"type": "subtitle", "time": 13200.55, "timestamp": "03:40:00", "text": "胸。動作が遅い場合は申し訳ありません。"}, {"type": "subtitle", "time": 13211.95, "timestamp": "03:40:11", "text": "いや、いや、いや。何てことだ。何てことだ。ああ、"}, {"type": "subtitle", "time": 13213.79, "timestamp": "03:40:13", "text": "神。私"}, {"type": "subtitle", "time": 13216.269, "timestamp": "03:40:16", "text": "亡くなった。私の足は"}, {"type": "subtitle", "time": 13223.95, "timestamp": "03:40:23", "text": "神。私はカップを割った"}, {"type": "subtitle", "time": 13225.71, "timestamp": "03:40:25", "text": "電子レンジ。"}, {"type": "subtitle", "time": 13236.15, "timestamp": "03:40:36", "text": "何てことだ。そして今、マイクロ波"}, {"type": "subtitle", "time": 13245.309, "timestamp": "03:40:45", "text": "[音楽]"}]
[{"type": "subtitle", "time": 10986.429, "timestamp": "03:03:06", "text": "ああ、なぜ私は"}, {"type": "subtitle", "time": 10989.67, "timestamp": "03:03:09", "text": "島？私有島。"}, {"type": "subtitle", "time": 10992.349, "timestamp": "03:03:12", "text": "H. 具体的に何ですか？私は緑の部屋が好きです。"}, {"type": "subtitle", "time": 10998.75, "timestamp": "03:03:18", "text": "惑星。"}, {"type": "subtitle", "time": 11000.75, "timestamp": "03:03:20", "text": "おお。おお、"}, {"type": "subtitle", "time": 11006.23, "timestamp": "03:03:26", "text": "いいえ。うわあ、大きい！"}, {"type": "subtitle", "time": 11008.469, "timestamp": "03:03:28", "text": "よくやったね。"}, {"type": "subtitle", "time": 11012.07, "timestamp": "03:03:32", "text": "しかし、それは一体何なのでしょうか？ピーク氏は確信が持てない。のみ"}, {"type": "subtitle", "time": 11014.99, "timestamp": "03:03:34", "text": "見つける方法の一つ"}, {"type": "subtitle", "time": 11018.23, "timestamp": "03:03:38", "text": "外。待って。まるで新しい島に来たような気分だ"}, {"type": "subtitle", "time": 11020.51, "timestamp": "03:03:40", "text": "あるいは、そんな感じ。待って。待って、待って、"}, {"type": "subtitle", "time": 11022.95, "timestamp": "03:03:42", "text": "待って。まるで新しい惑星か"}, {"type": "subtitle", "time": 11024.75, "timestamp": "03:03:44", "text": "何か、"}, {"type": "subtitle", "time": 11028.99, "timestamp": "03:03:48", "text": "男。ああ、なんてことだ。それは それは"}, {"type": "subtitle", "time": 11030.51, "timestamp": "03:03:50", "text": "美しく"}, {"type": "subtitle", "time": 11033.389, "timestamp": "03:03:53", "text": "素晴らしすぎる。"}, {"type": "subtitle", "time": 11037.03, "timestamp": "03:03:57", "text": "奇跡的に素晴らしい。"}]
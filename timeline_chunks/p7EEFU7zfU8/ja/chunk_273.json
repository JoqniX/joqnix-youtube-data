[{"type": "subtitle", "time": 16400.83, "timestamp": "04:33:20", "text": "はい、私は"}, {"type": "subtitle", "time": 16405.51, "timestamp": "04:33:25", "text": "ここ。ああ、大変だ。再挑戦して最善を尽くします"}, {"type": "subtitle", "time": 16407.949, "timestamp": "04:33:27", "text": "これが一番"}, {"type": "subtitle", "time": 16418.47, "timestamp": "04:33:38", "text": "今のところ、塊は以上です。夫人"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "スプトルは喜ぶはずだ。レベリ、"}, {"type": "subtitle", "time": 16425.269, "timestamp": "04:33:45", "text": "これらを受け取らなかったのか？"}, {"type": "subtitle", "time": 16427.83, "timestamp": "04:33:47", "text": "私はあの荒らしと戦うか、"}]
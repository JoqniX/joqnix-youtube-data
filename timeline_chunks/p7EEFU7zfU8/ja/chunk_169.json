[{"type": "subtitle", "time": 10140.11, "timestamp": "02:49:00", "text": "[拍手]"}, {"type": "subtitle", "time": 10142.79, "timestamp": "02:49:02", "text": "キャプテン。おお、"}, {"type": "subtitle", "time": 10146.59, "timestamp": "02:49:06", "text": "1つ手に入れましたね。とった。さあ"}, {"type": "subtitle", "time": 10149.95, "timestamp": "02:49:09", "text": "行く。もっと手に入れるつもりだ。"}, {"type": "subtitle", "time": 10153.429, "timestamp": "02:49:13", "text": "ああ、難しいですね。あなたたちは、転がる蜂たちです。"}, {"type": "subtitle", "time": 10158.19, "timestamp": "02:49:18", "text": "うん。こんにちは、アルチャマ。ああ、そして良い"}, {"type": "subtitle", "time": 10166.469, "timestamp": "02:49:26", "text": "神は唯一である。わかった。もっと。こっちへ来い"}, {"type": "subtitle", "time": 10170.67, "timestamp": "02:49:30", "text": "ローリング。ローリング。えっと"}, {"type": "subtitle", "time": 10172.83, "timestamp": "02:49:32", "text": "1つ。"}, {"type": "subtitle", "time": 10175.55, "timestamp": "02:49:35", "text": "はい。"}, {"type": "subtitle", "time": 10178.19, "timestamp": "02:49:38", "text": "わーい。別の"}, {"type": "subtitle", "time": 10180.79, "timestamp": "02:49:40", "text": "1つ。ここに来て。新しいローリングローリング"}, {"type": "subtitle", "time": 10183.469, "timestamp": "02:49:43", "text": "かわいいパフ"}, {"type": "subtitle", "time": 10186.67, "timestamp": "02:49:46", "text": "ボール。別の"}, {"type": "subtitle", "time": 10189.11, "timestamp": "02:49:49", "text": "1つ。今日GPを受けるかもしれないし"}, {"type": "subtitle", "time": 10191.75, "timestamp": "02:49:51", "text": "明日。よぉよぉ、それは"}, {"type": "subtitle", "time": 10194.55, "timestamp": "02:49:54", "text": "あなたを傷つける。私は彼女を拒絶できなかった"}, {"type": "subtitle", "time": 10195.95, "timestamp": "02:49:55", "text": "オファー。"}, {"type": "subtitle", "time": 10198.23, "timestamp": "02:49:58", "text": "待って、あなたは"}]
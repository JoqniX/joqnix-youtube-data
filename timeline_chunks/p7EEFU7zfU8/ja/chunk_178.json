[{"type": "subtitle", "time": 10683.71, "timestamp": "02:58:03", "text": "おい。"}, {"type": "subtitle", "time": 10687.429, "timestamp": "02:58:07", "text": "三つ。 1つ入手しました。"}, {"type": "subtitle", "time": 10691.83, "timestamp": "02:58:11", "text": "落ち着いてください。あなたに危害を加えるつもりはありません。"}, {"type": "subtitle", "time": 10693.91, "timestamp": "02:58:13", "text": "待ってろよ。リスがいます"}, {"type": "subtitle", "time": 10710.83, "timestamp": "02:58:30", "text": "お願いします？待って、もう一方の月はどこに行ったの？"}, {"type": "subtitle", "time": 10713.469, "timestamp": "02:58:33", "text": "行く？おい"}, {"type": "subtitle", "time": 10723.75, "timestamp": "02:58:43", "text": "動き。動きが見える。愛してる"}, {"type": "subtitle", "time": 10724.99, "timestamp": "02:58:44", "text": "また。"}]
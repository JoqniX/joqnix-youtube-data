[{"type": "subtitle", "time": 9904.389, "timestamp": "02:45:04", "text": "何？かなりの数のクエストですね。"}, {"type": "subtitle", "time": 9905.55, "timestamp": "02:45:05", "text": "ああ、"}, {"type": "subtitle", "time": 9909.269, "timestamp": "02:45:09", "text": "神。おお。おお。 2つになる予定です"}, {"type": "subtitle", "time": 9911.07, "timestamp": "02:45:11", "text": "営業時間"}, {"type": "subtitle", "time": 9927.91, "timestamp": "02:45:27", "text": "マスク。ああ、それはカボチャのマスクだ。ああ、すべて"}, {"type": "subtitle", "time": 9933.67, "timestamp": "02:45:33", "text": "マスク。彼女を見て。"}, {"type": "subtitle", "time": 9935.83, "timestamp": "02:45:35", "text": "ビーストの授業に出席した今、"}, {"type": "subtitle", "time": 9938.07, "timestamp": "02:45:38", "text": "私は、Deakがあなたの使用を支援することを申し出ました"}, {"type": "subtitle", "time": 9940.15, "timestamp": "02:45:40", "text": "その分野でさらに研究を進めるためのスペース"}, {"type": "subtitle", "time": 9942.15, "timestamp": "02:45:42", "text": "尊重する。彼とそこで会ってください"}, {"type": "subtitle", "time": 9944.95, "timestamp": "02:45:44", "text": "できる。わかった。"}, {"type": "subtitle", "time": 9946.87, "timestamp": "02:45:46", "text": "叔父のローランドから連絡がない"}, {"type": "subtitle", "time": 9949.19, "timestamp": "02:45:49", "text": "かなり長い間。私は我を忘れてしまった"}, {"type": "subtitle", "time": 9952.67, "timestamp": "02:45:52", "text": "心配しながら。私は作る必要があると思う"}, {"type": "subtitle", "time": 9956.429, "timestamp": "02:45:56", "text": "あのね？私たちは手に入れる必要がある"}, {"type": "subtitle", "time": 9959.19, "timestamp": "02:45:59", "text": "お金が必要なのか、それとも"}]
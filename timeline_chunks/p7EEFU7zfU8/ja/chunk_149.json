[{"type": "subtitle", "time": 8943.15, "timestamp": "02:29:03", "text": "魚類。それらを飛ばしてもいいですか？"}, {"type": "subtitle", "time": 8945.99, "timestamp": "02:29:05", "text": "いいえ。ああ、それは揚げられません。少なくともできる"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "私は彼らを海に戻したのですか？"}, {"type": "subtitle", "time": 8971.51, "timestamp": "02:29:31", "text": "えっと、"}, {"type": "subtitle", "time": 8972.87, "timestamp": "02:29:32", "text": "わかった。あなたは何もできません"}, {"type": "subtitle", "time": 8976.23, "timestamp": "02:29:36", "text": "魚類。ごめんなさい。かわいそうな魚たち。それは"}, {"type": "subtitle", "time": 8990.11, "timestamp": "02:29:50", "text": "でも、私は"}, {"type": "subtitle", "time": 8998.63, "timestamp": "02:29:58", "text": "文字通りここから抜け出す。"}]
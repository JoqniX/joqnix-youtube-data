[{"type": "subtitle", "time": 20101.35, "timestamp": "05:35:01", "text": "私はもう全部終わった"}, {"type": "subtitle", "time": 20104.868, "timestamp": "05:35:04", "text": "語彙。うん。だってそこが"}, {"type": "subtitle", "time": 20107.27, "timestamp": "05:35:07", "text": "うん。うん。どうぞ。そうそう。うん。行く"}, {"type": "subtitle", "time": 20111.75, "timestamp": "05:35:11", "text": "先に。はい。それで私が気づいたことの一つは"}, {"type": "subtitle", "time": 20115.03, "timestamp": "05:35:15", "text": "日本語の試験を受ける際に、もし"}, {"type": "subtitle", "time": 20117.67, "timestamp": "05:35:17", "text": "読めない、書けない"}, {"type": "subtitle", "time": 20121.548, "timestamp": "05:35:21", "text": "まるで、たくさんのトリッキーなことを仕掛けてくるみたいだ"}, {"type": "subtitle", "time": 20125.43, "timestamp": "05:35:25", "text": "MCQのような質問でも"}, {"type": "subtitle", "time": 20128.868, "timestamp": "05:35:28", "text": "ええ、MCQですが、本当に"}, {"type": "subtitle", "time": 20131.91, "timestamp": "05:35:31", "text": "難しい質問なので、"}, {"type": "subtitle", "time": 20135.67, "timestamp": "05:35:35", "text": "賢くなれば彼らも賢くなるから"}, {"type": "subtitle", "time": 20138.03, "timestamp": "05:35:38", "text": "それを理解しなければならない、理解しなければならない"}, {"type": "subtitle", "time": 20149.19, "timestamp": "05:35:49", "text": "そして今でも、それが私のやりたいことなんです。"}, {"type": "subtitle", "time": 20151.35, "timestamp": "05:35:51", "text": "もしもう一度書くとしたら、"}, {"type": "subtitle", "time": 20154.39, "timestamp": "05:35:54", "text": "文字通り、もっと読書の練習をしましょう。どうやって"}, {"type": "subtitle", "time": 20155.948, "timestamp": "05:35:55", "text": "私は1つ読むことができます"}, {"type": "subtitle", "time": 20158.47, "timestamp": "05:35:58", "text": "英語の文を簡単に"}]
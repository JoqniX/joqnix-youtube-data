[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "アカル、それが何を意味するか分かるかい？話す"}, {"type": "subtitle", "time": 4804.149, "timestamp": "01:20:04", "text": "あなたへ。ここに来て。よし、その前に"}, {"type": "subtitle", "time": 4806.07, "timestamp": "01:20:06", "text": "あなたと話したいのですが、この孔雀を捕まえさせてください"}, {"type": "subtitle", "time": 4809.229, "timestamp": "01:20:09", "text": "一種の仲間。この落書き"}, {"type": "subtitle", "time": 4817.709, "timestamp": "01:20:17", "text": "[音楽]"}, {"type": "subtitle", "time": 4825.95, "timestamp": "01:20:25", "text": "かわいい。おお、"}, {"type": "subtitle", "time": 4829.39, "timestamp": "01:20:29", "text": "餌。もしそれが男性なら。ああ、私たちは二人とも"}, {"type": "subtitle", "time": 4832.79, "timestamp": "01:20:32", "text": "男。これもまたすべて友達の話です。待って。おお、"}, {"type": "subtitle", "time": 4841.709, "timestamp": "01:20:41", "text": "[音楽]"}, {"type": "subtitle", "time": 4843.47, "timestamp": "01:20:43", "text": "わかった、"}, {"type": "subtitle", "time": 4845.91, "timestamp": "01:20:45", "text": "アボカド。連れて行ってもいいですか、それとも"}, {"type": "subtitle", "time": 4847.149, "timestamp": "01:20:47", "text": "何か？"}, {"type": "subtitle", "time": 4850.75, "timestamp": "01:20:50", "text": "いいえ。ああ、あなたはそれらを受け取ることはできません"}, {"type": "subtitle", "time": 4855.11, "timestamp": "01:20:55", "text": "家。何てことだ。どうやって脱出するか？わかった、"}, {"type": "subtitle", "time": 4859.03, "timestamp": "01:20:59", "text": "はい、どうぞ。はい、ポピー。必要でしたか？"}]
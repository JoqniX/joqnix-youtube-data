[{"type": "subtitle", "time": 9427.63, "timestamp": "02:37:07", "text": "わーい。しばらくの間"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "森。うん、もっと作らないといけないな"}, {"type": "subtitle", "time": 9432.91, "timestamp": "02:37:12", "text": "これ"}, {"type": "subtitle", "time": 9437.19, "timestamp": "02:37:17", "text": "一部、さもないと私はそうなるだろう"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "今まで私を止めたことは一度もなかった。"}, {"type": "subtitle", "time": 9441.349, "timestamp": "02:37:21", "text": "こんにちは。ヘルメットを回収しました"}, {"type": "subtitle", "time": 9444.309, "timestamp": "02:37:24", "text": "アッシュワインダーズ。よくやった。これは確かだ"}, {"type": "subtitle", "time": 9447.27, "timestamp": "02:37:27", "text": "ランロックに好印象を与えるため。ヘルメットが光る"}, {"type": "subtitle", "time": 9449.99, "timestamp": "02:37:29", "text": "想像していたよりもずっと明るかった。の"}, {"type": "subtitle", "time": 9452.71, "timestamp": "02:37:32", "text": "エッチング、輪郭線。"}, {"type": "subtitle", "time": 9461.67, "timestamp": "02:37:41", "text": "LGさん、素晴らしいですね。あなたがなぜそう思うのか分かります"}, {"type": "subtitle", "time": 9463.83, "timestamp": "02:37:43", "text": "取り戻したかった。あなたは泥棒たちに"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "サービスを復旧することで、そのサービスを回復します。回復する？私"}, {"type": "subtitle", "time": 9467.83, "timestamp": "02:37:47", "text": "殺すであろうゴブリンを何匹も知っている"}, {"type": "subtitle", "time": 9469.83, "timestamp": "02:37:49", "text": "それに対して。ああ、それなら私は"}, {"type": "subtitle", "time": 9472.23, "timestamp": "02:37:52", "text": "自分でやります。はい。ありがとう。これは"}, {"type": "subtitle", "time": 9474.469, "timestamp": "02:37:54", "text": "ランロックの信頼を得る。私はそれを持っていきます"}, {"type": "subtitle", "time": 9476.79, "timestamp": "02:37:56", "text": "すぐに彼に連絡を取った。それは彼の気を散らすかもしれない"}]
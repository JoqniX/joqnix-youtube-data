[{"type": "subtitle", "time": 17020.19, "timestamp": "04:43:40", "text": "よし、こいつらはゾンビだ。"}, {"type": "subtitle", "time": 17023.11, "timestamp": "04:43:43", "text": "えっと、じゃあ、私はどこに行けばいいんですか？"}, {"type": "subtitle", "time": 17025.39, "timestamp": "04:43:45", "text": "私はどこにいるのか"}, {"type": "subtitle", "time": 17029.708, "timestamp": "04:43:49", "text": "私？これは良い"}, {"type": "subtitle", "time": 17030.71, "timestamp": "04:43:50", "text": "森。"}, {"type": "subtitle", "time": 17032.99, "timestamp": "04:43:52", "text": "[音楽]"}, {"type": "subtitle", "time": 17035.51, "timestamp": "04:43:55", "text": "ええと、古代の魔法が一つあります。あなたが知っている"}, {"type": "subtitle", "time": 17038.39, "timestamp": "04:43:58", "text": "何？私はそこへ行くつもりです。"}]
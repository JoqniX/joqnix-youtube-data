[{"type": "subtitle", "time": 2820.43, "timestamp": "00:47:00", "text": "うん、私は"}, {"type": "subtitle", "time": 2830.309, "timestamp": "00:47:10", "text": "に。わかった。大丈夫。大丈夫。えっと、私は"}, {"type": "subtitle", "time": 2831.63, "timestamp": "00:47:11", "text": "できない"}, {"type": "subtitle", "time": 2833.95, "timestamp": "00:47:13", "text": "それ。無線"}, {"type": "subtitle", "time": 2846.79, "timestamp": "00:47:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2847.82, "timestamp": "00:47:27", "text": "念のため確認です。"}, {"type": "subtitle", "time": 2848.99, "timestamp": "00:47:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2851.15, "timestamp": "00:47:31", "text": "わかった。"}]
[{"type": "subtitle", "time": 4683.11, "timestamp": "01:18:03", "text": "それ。膝が本当にあなたに馴染んだようですね。彼らは"}, {"type": "subtitle", "time": 4688.39, "timestamp": "01:18:08", "text": "彼らはそれを見ればすぐにわかるし、私もそうだ。"}, {"type": "subtitle", "time": 4691.91, "timestamp": "01:18:11", "text": "私たちの時代は終わりを迎えたようだ。"}, {"type": "subtitle", "time": 4694.55, "timestamp": "01:18:14", "text": "ペンを閉じて、ご自身でご覧ください"}, {"type": "subtitle", "time": 4699.11, "timestamp": "01:18:19", "text": "外。さて、新しい生徒はどこにいるだろうか？こんにちは、"}, {"type": "subtitle", "time": 4702.39, "timestamp": "01:18:22", "text": "私はシャードです。そこにいたんですね。をお願いします。"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "少々お待ちください。はい。"}, {"type": "subtitle", "time": 4707.35, "timestamp": "01:18:27", "text": "話す。"}, {"type": "subtitle", "time": 4709.59, "timestamp": "01:18:29", "text": "こんにちは、教授。あなたは話したかった"}, {"type": "subtitle", "time": 4713.189, "timestamp": "01:18:33", "text": "私と一緒に？はい、そうしました。どのようにして見つけましたか"}, {"type": "subtitle", "time": 4716.47, "timestamp": "01:18:36", "text": "最初の獣の教訓？楽しかった。"}, {"type": "subtitle", "time": 4720.99, "timestamp": "01:18:40", "text": "小さな球のようなものが見えました"}, {"type": "subtitle", "time": 4725.27, "timestamp": "01:18:45", "text": "動物のような動物とネクロアン"}, {"type": "subtitle", "time": 4728.39, "timestamp": "01:18:48", "text": "絵筆の尻尾。あなたは"}, {"type": "subtitle", "time": 4731.59, "timestamp": "01:18:51", "text": "それをきちんと理解してください。私は行かない"}, {"type": "subtitle", "time": 4734.55, "timestamp": "01:18:54", "text": "外出する。私は行かないよ。支払いました"}, {"type": "subtitle", "time": 4737.35, "timestamp": "01:18:57", "text": "魔法が込められたプレミアム版には追加料金がかかります"}, {"type": "subtitle", "time": 4739.669, "timestamp": "01:18:59", "text": "材料。プレミアム？何のために買ったの？"}]
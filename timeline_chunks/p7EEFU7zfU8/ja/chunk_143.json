[{"type": "subtitle", "time": 8581.79, "timestamp": "02:23:01", "text": "これ。それは良い。"}, {"type": "subtitle", "time": 8583.08, "timestamp": "02:23:03", "text": "それで、"}, {"type": "subtitle", "time": 8586.349, "timestamp": "02:23:06", "text": "[音楽]"}, {"type": "subtitle", "time": 8588.83, "timestamp": "02:23:08", "text": "それは良いことだ。"}, {"type": "subtitle", "time": 8592.19, "timestamp": "02:23:12", "text": "えっと、それで"}, {"type": "subtitle", "time": 8594.99, "timestamp": "02:23:14", "text": "これだから"}, {"type": "subtitle", "time": 8601.67, "timestamp": "02:23:21", "text": "そうそう。"}, {"type": "subtitle", "time": 8603.429, "timestamp": "02:23:23", "text": "私が札束を保管していないとは誰も言えない"}, {"type": "subtitle", "time": 8605.389, "timestamp": "02:23:25", "text": "棚。"}, {"type": "subtitle", "time": 8608.15, "timestamp": "02:23:28", "text": "こんにちは。もう少しで。"}, {"type": "subtitle", "time": 8609.75, "timestamp": "02:23:29", "text": "当ててみようか。あなたは何かを求めている"}, {"type": "subtitle", "time": 8611.67, "timestamp": "02:23:31", "text": "無料。いいえ、あなたとはやり取りしていません。おお、"}, {"type": "subtitle", "time": 8615.99, "timestamp": "02:23:35", "text": "私は棚の中身を取るべきではない。"}, {"type": "subtitle", "time": 8617.71, "timestamp": "02:23:37", "text": "[音楽]"}, {"type": "subtitle", "time": 8619.309, "timestamp": "02:23:39", "text": "XP。"}, {"type": "subtitle", "time": 8634.79, "timestamp": "02:23:54", "text": "これ？ああ、そうですね。薬。ペピン、否定ではない。"}, {"type": "subtitle", "time": 8637.51, "timestamp": "02:23:57", "text": "はい、私の間違いでした。こんにちは。私は必要としている"}]
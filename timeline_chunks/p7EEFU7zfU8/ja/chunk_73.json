[{"type": "subtitle", "time": 4381.229, "timestamp": "01:13:01", "text": "ああ、私は"}, {"type": "subtitle", "time": 4396.95, "timestamp": "01:13:16", "text": "そこには。まるでフクロウがいるみたいだ。"}, {"type": "subtitle", "time": 4399.59, "timestamp": "01:13:19", "text": "あなたは既に何人かと会っているようですね。それは"}, {"type": "subtitle", "time": 4402.669, "timestamp": "01:13:22", "text": "猫？これについて勉強してください。何？しかし、"}, {"type": "subtitle", "time": 4404.95, "timestamp": "01:13:24", "text": "助言されたこれらの生き物はどれも"}, {"type": "subtitle", "time": 4407.83, "timestamp": "01:13:27", "text": "取られる。ああ、あれはドードー鳥だ。彼らは"}, {"type": "subtitle", "time": 4412.189, "timestamp": "01:13:32", "text": "みんなそれぞれ自分のことに夢中だ。えっと、私は"}, {"type": "subtitle", "time": 4415.709, "timestamp": "01:13:35", "text": "それらを適切に扱う方法を示してください。ああ、"}, {"type": "subtitle", "time": 4419.11, "timestamp": "01:13:39", "text": "いいえとは、あなた方の多くが私が見せるものから外れているという意味です"}, {"type": "subtitle", "time": 4422.149, "timestamp": "01:13:42", "text": "スピードを見たことは分かっているが、肉を見せて"}, {"type": "subtitle", "time": 4425.99, "timestamp": "01:13:45", "text": "獣。何？彼は何をしたのですか？あなたなら"}, {"type": "subtitle", "time": 4428.229, "timestamp": "01:13:48", "text": "新入生のお手伝いをお願いします"}, {"type": "subtitle", "time": 4431.35, "timestamp": "01:13:51", "text": "今日の授業は？はい、ハウエン教授。何"}, {"type": "subtitle", "time": 4434.31, "timestamp": "01:13:54", "text": "彼はそうしたのか？私はポピーです。ポピーの甘味付け。"}, {"type": "subtitle", "time": 4435.91, "timestamp": "01:13:55", "text": "教授のことは心配しないでください。何てことだ、"}, {"type": "subtitle", "time": 4437.43, "timestamp": "01:13:57", "text": "彼女の声は本当に素晴らしい。誇張する"}, {"type": "subtitle", "time": 4439.03, "timestamp": "01:13:59", "text": "時々。"}]
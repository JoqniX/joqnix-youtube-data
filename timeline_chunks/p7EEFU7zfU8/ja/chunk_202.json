[{"type": "subtitle", "time": 12120.229, "timestamp": "03:22:00", "text": "待って。カード。ああ、いや、忘れてた。うん、まあね"}, {"type": "subtitle", "time": 12123.07, "timestamp": "03:22:03", "text": "カードのようなものだが、"}, {"type": "subtitle", "time": 12129.55, "timestamp": "03:22:09", "text": "[音楽]"}, {"type": "subtitle", "time": 12133.469, "timestamp": "03:22:13", "text": "良い。何てことだ。ダッシュ"}, {"type": "subtitle", "time": 12138.91, "timestamp": "03:22:18", "text": "マスク。噂の要件。古代の魔法"}, {"type": "subtitle", "time": 12142.3, "timestamp": "03:22:22", "text": "供給。おお、"}, {"type": "subtitle", "time": 12167.07, "timestamp": "03:22:47", "text": "1つ"}, {"type": "subtitle", "time": 12170.15, "timestamp": "03:22:50", "text": "在庫。私たちはたくさんのミツバチを飼っています。私たちには必要だ"}, {"type": "subtitle", "time": 12172.11, "timestamp": "03:22:52", "text": "売る"}, {"type": "subtitle", "time": 12178.87, "timestamp": "03:22:58", "text": "1つ。そして行く前に、売って"}]
[{"type": "subtitle", "time": 12480.07, "timestamp": "03:28:00", "text": "動物たちが安全で元気であることを確認してください"}, {"type": "subtitle", "time": 12482.309, "timestamp": "03:28:02", "text": "世話をされた。それは保証できない"}, {"type": "subtitle", "time": 12485.349, "timestamp": "03:28:05", "text": "これらの将来の所有者の中には、今、"}, {"type": "subtitle", "time": 12487.03, "timestamp": "03:28:07", "text": "ちょっと周りをよく見て回ってみたらどうですか？"}, {"type": "subtitle", "time": 12489.11, "timestamp": "03:28:09", "text": "株価は常に変動しており、"}, {"type": "subtitle", "time": 12491.59, "timestamp": "03:28:11", "text": "なぜなら、それらは消えてしまうからだ。常に最善"}, {"type": "subtitle", "time": 12493.429, "timestamp": "03:28:13", "text": "都合の良い時に立ち寄って必要なものを手に入れましょう"}, {"type": "subtitle", "time": 12496.229, "timestamp": "03:28:16", "text": "在庫がなくなる前に。わかった。彼らは"}, {"type": "subtitle", "time": 12498.47, "timestamp": "03:28:18", "text": "文字通り、以前はそうしていた。"}, {"type": "subtitle", "time": 12501.11, "timestamp": "03:28:21", "text": "[笑い]"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "ありがとう。私はあなたの時間をすべて使います"}, {"type": "subtitle", "time": 12505.429, "timestamp": "03:28:25", "text": "必要。わかった。立ち寄っていただきありがとうございます。"}, {"type": "subtitle", "time": 12509.19, "timestamp": "03:28:29", "text": "による。お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 12515.91, "timestamp": "03:28:35", "text": "今？どのような種類の動物副産物"}, {"type": "subtitle", "time": 12517.51, "timestamp": "03:28:37", "text": "購入を検討されているのでしょうか？私は"}, {"type": "subtitle", "time": 12520.15, "timestamp": "03:28:40", "text": "販売者向け。売っても構わない"}, {"type": "subtitle", "time": 12522.389, "timestamp": "03:28:42", "text": "特定の顧客向けの商品。あなたは知っていますか"}, {"type": "subtitle", "time": 12523.78, "timestamp": "03:28:43", "text": "どこで見つけられるか"}, {"type": "subtitle", "time": 12533.309, "timestamp": "03:28:53", "text": "自分？お金を見てみろ。ああ、"}]
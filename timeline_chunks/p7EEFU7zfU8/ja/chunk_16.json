[{"type": "subtitle", "time": 966.47, "timestamp": "00:16:06", "text": "恥。なぜできないのですか？正直に言うと、私は"}, {"type": "subtitle", "time": 968.79, "timestamp": "00:16:08", "text": "どれが答えか分かる。私はただ行くだけです"}, {"type": "subtitle", "time": 971.23, "timestamp": "00:16:11", "text": "翼を伸ばす"}, {"type": "subtitle", "time": 974.47, "timestamp": "00:16:14", "text": "それ。なぜこのものが二重になるのか"}, {"type": "subtitle", "time": 977.269, "timestamp": "00:16:17", "text": "コロン、セミコロン、それとも何か別のもの？なぜ"}, {"type": "subtitle", "time": 979.829, "timestamp": "00:16:19", "text": "セミコロンはありますか？それはつまり"}, {"type": "subtitle", "time": 983.22, "timestamp": "00:16:23", "text": "何でも？なぜその順序なのか"}, {"type": "subtitle", "time": 985.629, "timestamp": "00:16:25", "text": "[音楽]"}, {"type": "subtitle", "time": 988.55, "timestamp": "00:16:28", "text": "違う？これも同じです。なぜ"}, {"type": "subtitle", "time": 990.829, "timestamp": "00:16:30", "text": "一番下の時間、そしてこれは"}, {"type": "subtitle", "time": 997.91, "timestamp": "00:16:37", "text": "A. これに基づいて、私はこう感じます"}, {"type": "subtitle", "time": 1000.189, "timestamp": "00:16:40", "text": "フォーマットは、"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "文字通り何もかも同じだと思う。"}]
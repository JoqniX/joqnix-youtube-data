[{"type": "subtitle", "time": 18001.35, "timestamp": "05:00:01", "text": "そして私は、AMDがFSでDvidiaを圧倒していることを発見しました"}, {"type": "subtitle", "time": 18003.15, "timestamp": "05:00:03", "text": "三つ。待って、これは何？見せてください"}, {"type": "subtitle", "time": 18012.15, "timestamp": "05:00:12", "text": "多くの。わかった。うーん、そうかもね。わかった。私は疑問に思った"}, {"type": "subtitle", "time": 18014.83, "timestamp": "05:00:14", "text": "箱の中の手紙について。の"}, {"type": "subtitle", "time": 18017.11, "timestamp": "05:00:17", "text": "もちろん、ほとんどの文字は"}, {"type": "subtitle", "time": 18025.99, "timestamp": "05:00:25", "text": "[音楽]"}, {"type": "subtitle", "time": 18027.75, "timestamp": "05:00:27", "text": "手紙の一つにクィディッチについて言及されていた。"}, {"type": "subtitle", "time": 18031.03, "timestamp": "05:00:31", "text": "練習する。プレイしましたか？はい、そうしました。は"}, {"type": "subtitle", "time": 18034.31, "timestamp": "05:00:34", "text": "レイブンクローのシーカーとして3年間活動。おお、"}, {"type": "subtitle", "time": 18037.59, "timestamp": "05:00:37", "text": "マーリンの髭。私はクィディッチが大好きです。"}, {"type": "subtitle", "time": 18039.35, "timestamp": "05:00:39", "text": "捕まえる感覚に勝るものはない"}, {"type": "subtitle", "time": 18041.51, "timestamp": "05:00:41", "text": "チームが劣勢の時にゴールデンスニッチ"}, {"type": "subtitle", "time": 18044.31, "timestamp": "05:00:44", "text": "140点。私は教授を絶対に許さない"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "ブラック氏は今年、それを中止した。私"}, {"type": "subtitle", "time": 18047.868, "timestamp": "05:00:47", "text": "応援できなかった"}, {"type": "subtitle", "time": 18049.91, "timestamp": "05:00:49", "text": "レイブンクロー。私たちは彼らを応援できたはずなのに"}, {"type": "subtitle", "time": 18059.35, "timestamp": "05:00:59", "text": "ええと、喜んでお手伝いします。"}]
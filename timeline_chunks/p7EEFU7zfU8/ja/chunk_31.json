[{"type": "subtitle", "time": 1867.669, "timestamp": "00:31:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1870.75, "timestamp": "00:31:10", "text": "何が"}, {"type": "subtitle", "time": 1882.43, "timestamp": "00:31:22", "text": "[音楽]"}, {"type": "subtitle", "time": 1886.23, "timestamp": "00:31:26", "text": "わかった。それとも、以前にも聞いたことがあるような？"}, {"type": "subtitle", "time": 1887.63, "timestamp": "00:31:27", "text": "それは古い"}, {"type": "subtitle", "time": 1894.23, "timestamp": "00:31:34", "text": "1つはレストランで、キスキサキサ"}, {"type": "subtitle", "time": 1897.35, "timestamp": "00:31:37", "text": "それって、コーヒーショップみたいな感じですよね？それで"}, {"type": "subtitle", "time": 1898.95, "timestamp": "00:31:38", "text": "レストラン、コーヒーショップ。それからこれ"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "または古いもの。 5番目は寿司です"}, {"type": "subtitle", "time": 1904.75, "timestamp": "00:31:44", "text": "寿司"}, {"type": "subtitle", "time": 1914.63, "timestamp": "00:31:54", "text": "ゾバン。ゾバゾバ。あぁ、そば屋さん。それから"}, {"type": "subtitle", "time": 1916.71, "timestamp": "00:31:56", "text": "わかった。入院後も。それは"}, {"type": "subtitle", "time": 1919.029, "timestamp": "00:31:59", "text": "奇数。 o o o o の単語を選んでください"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○ ○"}, {"type": "subtitle", "time": 1919.509, "timestamp": "00:31:59", "text": "o oooooooooooooo反対側"}]
[{"type": "subtitle", "time": 19381.35, "timestamp": "05:23:01", "text": "何でも。お邪魔して申し訳ありません。もし"}, {"type": "subtitle", "time": 19384.07, "timestamp": "05:23:04", "text": "私は、話もしないようなことをします"}, {"type": "subtitle", "time": 19386.948, "timestamp": "05:23:06", "text": "もはや人々はいない。心配ない。心配ない。"}, {"type": "subtitle", "time": 19389.91, "timestamp": "05:23:09", "text": "心配ない。すべて順調です。"}, {"type": "subtitle", "time": 19392.31, "timestamp": "05:23:12", "text": "ええ、本当に長い間"}, {"type": "subtitle", "time": 19395.35, "timestamp": "05:23:15", "text": "私は英語で普通に話すのが好きです"}, {"type": "subtitle", "time": 19397.35, "timestamp": "05:23:17", "text": "正直に言ってください。"}, {"type": "subtitle", "time": 19404.15, "timestamp": "05:23:24", "text": "私がやっているのは歌うことだけです"}, {"type": "subtitle", "time": 19406.868, "timestamp": "05:23:26", "text": "そして編集する。つまり、それが唯一のことなんです"}, {"type": "subtitle", "time": 19409.91, "timestamp": "05:23:29", "text": "私は小説もいくつか書いていて、それと並行して仕事をしています。"}, {"type": "subtitle", "time": 19412.23, "timestamp": "05:23:32", "text": "そして、まるで今、自分の小説を書いているような気分だ。"}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "だから私はただ計画を立てて実行しているだけです"}, {"type": "subtitle", "time": 19420.868, "timestamp": "05:23:40", "text": "そして私も卒業しました。ええ、私も"}, {"type": "subtitle", "time": 19423.67, "timestamp": "05:23:43", "text": "今年、学校を卒業した。それで"}, {"type": "subtitle", "time": 19427.11, "timestamp": "05:23:47", "text": "うん、これで国家試験が終わったよ。"}, {"type": "subtitle", "time": 19430.55, "timestamp": "05:23:50", "text": "ええ、最高レベルの成績を収めました。"}, {"type": "subtitle", "time": 19432.91, "timestamp": "05:23:52", "text": "ニース。そうだった"}, {"type": "subtitle", "time": 19435.91, "timestamp": "05:23:55", "text": "難しい。そして、点数は一種のゲームだった。それで、"}]
[{"type": "subtitle", "time": 20161.43, "timestamp": "05:36:01", "text": "物事、私たちはそれを簡単に読むことができます、"}, {"type": "subtitle", "time": 20163.43, "timestamp": "05:36:03", "text": "右？なぜなら私たちはそれをより多く与えているから"}, {"type": "subtitle", "time": 20165.91, "timestamp": "05:36:05", "text": "もっと練習して、もっと没頭する"}, {"type": "subtitle", "time": 20168.07, "timestamp": "05:36:08", "text": "そして、それを使うのが好きです。私たちはそれを読んだ"}, {"type": "subtitle", "time": 20170.548, "timestamp": "05:36:10", "text": "すべて。私たちはそれを至る所で目にしました。それで"}, {"type": "subtitle", "time": 20172.31, "timestamp": "05:36:12", "text": "日本語とは似ていません。私たちは"}, {"type": "subtitle", "time": 20175.43, "timestamp": "05:36:15", "text": "どこでも読んではいけません。うん。"}, {"type": "subtitle", "time": 20178.948, "timestamp": "05:36:18", "text": "そう、ここでも同じことが起こっている。"}, {"type": "subtitle", "time": 20182.708, "timestamp": "05:36:22", "text": "最善を尽くして慣れるしかない"}, {"type": "subtitle", "time": 20186.868, "timestamp": "05:36:26", "text": "読書へ。私が見つけた最良の方法は"}, {"type": "subtitle", "time": 20189.39, "timestamp": "05:36:29", "text": "読む"}, {"type": "subtitle", "time": 20192.548, "timestamp": "05:36:32", "text": "えっと、日本のライブ配信からの日本語のコメント"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "ストリームか何か、なぜならそれは"}, {"type": "subtitle", "time": 20197.11, "timestamp": "05:36:37", "text": "速い。トレーニングすればいいんだよ"}, {"type": "subtitle", "time": 20200.39, "timestamp": "05:36:40", "text": "あなた自身はどうすればもっと速く読めるでしょうか。私'"}, {"type": "subtitle", "time": 20202.47, "timestamp": "05:36:42", "text": "実は私もそれを試したことがあるんです。その"}, {"type": "subtitle", "time": 20204.39, "timestamp": "05:36:44", "text": "最もよく使うので、とても簡単です"}, {"type": "subtitle", "time": 20206.948, "timestamp": "05:36:46", "text": "一般。"}, {"type": "subtitle", "time": 20209.75, "timestamp": "05:36:49", "text": "うん、"}, {"type": "subtitle", "time": 20215.788, "timestamp": "05:36:55", "text": "それで"}, {"type": "subtitle", "time": 20219.11, "timestamp": "05:36:59", "text": "うんうん、このモデルは私のために作ったんだ"}]
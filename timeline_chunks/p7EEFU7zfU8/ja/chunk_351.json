[{"type": "subtitle", "time": 21063.51, "timestamp": "05:51:03", "text": "うん。あなたはVlogを撮るつもりですか？"}, {"type": "subtitle", "time": 21066.708, "timestamp": "05:51:06", "text": "日本？そういう感じのいい感じ。"}, {"type": "subtitle", "time": 21071.91, "timestamp": "05:51:11", "text": "Hはvlogのようなvlogを投稿する。はい。うん。私は思った"}, {"type": "subtitle", "time": 21074.788, "timestamp": "05:51:14", "text": "収益化のためにVlogをやっている"}, {"type": "subtitle", "time": 21077.91, "timestamp": "05:51:17", "text": "YouTubeで配信中。だから私は何とかして"}, {"type": "subtitle", "time": 21079.91, "timestamp": "05:51:19", "text": "YouTubeに私が生きていることを証明し、"}, {"type": "subtitle", "time": 21082.39, "timestamp": "05:51:22", "text": "アクティブ。だから私は必要ない、私はしなくていい"}, {"type": "subtitle", "time": 21084.83, "timestamp": "05:51:24", "text": "もう一度挽き直したよ、だっていくつか見たから"}, {"type": "subtitle", "time": 21088.39, "timestamp": "05:51:28", "text": "友人たちが会員資格をすべて失う"}, {"type": "subtitle", "time": 21090.628, "timestamp": "05:51:30", "text": "あれやその他すべては、彼らが"}, {"type": "subtitle", "time": 21093.67, "timestamp": "05:51:33", "text": "1ヶ月または2ヶ月間活動がなく、"}, {"type": "subtitle", "time": 21097.11, "timestamp": "05:51:37", "text": "そう、彼女はそれをもう一度挽かなければならない。"}, {"type": "subtitle", "time": 21099.27, "timestamp": "05:51:39", "text": "ああ、また4000まで頑張らないといけないよ"}, {"type": "subtitle", "time": 21103.03, "timestamp": "05:51:43", "text": "視聴時間。いいえ、それは本当に難しいことです。"}, {"type": "subtitle", "time": 21105.51, "timestamp": "05:51:45", "text": "それは本当に本当に難しい。私は持っていません"}]
[{"type": "subtitle", "time": 9480.23, "timestamp": "02:38:00", "text": "彼の捜索から。彼の捜索？それは、"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "ほんのわずかな予感。あなたは私に感銘を与えました。"}, {"type": "subtitle", "time": 9485.59, "timestamp": "02:38:05", "text": "大変ありがたいです、友よ。私は"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "あなたを信じていました。彼がすぐにそうしないことを願います"}, {"type": "subtitle", "time": 9492.469, "timestamp": "02:38:12", "text": "私を裏切る。私たちの取り決めは秘密にしておいてください"}, {"type": "subtitle", "time": 9494.87, "timestamp": "02:38:14", "text": "今。私たちの目標は"}, {"type": "subtitle", "time": 9504.15, "timestamp": "02:38:24", "text": "メインクエストを完了してください。 7人中"}, {"type": "subtitle", "time": 9516.11, "timestamp": "02:38:36", "text": "クエストがもう見当たらない"}, {"type": "subtitle", "time": 9520.11, "timestamp": "02:38:40", "text": "一瞬。料理を仕上げるだけ"}, {"type": "subtitle", "time": 9524.23, "timestamp": "02:38:44", "text": "今。ああ、そうしよう。実際、私は"}, {"type": "subtitle", "time": 9526.23, "timestamp": "02:38:46", "text": "前回の配信で私が言ったことを覚えていますか？"}, {"type": "subtitle", "time": 9528.55, "timestamp": "02:38:48", "text": "今は配信外でやるけど、また"}, {"type": "subtitle", "time": 9532.07, "timestamp": "02:38:52", "text": "配信外でゲームをプレイすることはできませんでした。ほとんど"}, {"type": "subtitle", "time": 9534.23, "timestamp": "02:38:54", "text": "おそらく私は休んでいたか、仕事をするのが好きだったのでしょう"}, {"type": "subtitle", "time": 9536.469, "timestamp": "02:38:56", "text": "他のことについて。"}]
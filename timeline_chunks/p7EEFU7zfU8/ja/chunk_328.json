[{"type": "subtitle", "time": 19683.03, "timestamp": "05:28:03", "text": "ひらがなとカタカナの文法事項と"}, {"type": "subtitle", "time": 19686.47, "timestamp": "05:28:06", "text": "漢字が少しあって、どうやって"}, {"type": "subtitle", "time": 19690.15, "timestamp": "05:28:10", "text": "しかし、どういうわけか私は合格したが、他の全員は合格しなかった。"}, {"type": "subtitle", "time": 19693.99, "timestamp": "05:28:13", "text": "同じバッジで失敗したんだけど、うわぁ"}, {"type": "subtitle", "time": 19695.91, "timestamp": "05:28:15", "text": "あれは3ヶ月くらいだったかな"}, {"type": "subtitle", "time": 19697.91, "timestamp": "05:28:17", "text": "すごく速い。私は準備しているようなものです"}, {"type": "subtitle", "time": 19700.548, "timestamp": "05:28:20", "text": "今は刑務所5番です。"}, {"type": "subtitle", "time": 19703.91, "timestamp": "05:28:23", "text": "自由時間がたくさんある。"}, {"type": "subtitle", "time": 19705.99, "timestamp": "05:28:25", "text": "それで、えっと、まずは"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "漢字？例えば、私はすでにたくさんの"}, {"type": "subtitle", "time": 19710.47, "timestamp": "05:28:30", "text": "語彙は、漢字のように"}, {"type": "subtitle", "time": 19712.47, "timestamp": "05:28:32", "text": "間違いなく非常に難しい。つまり、私は"}, {"type": "subtitle", "time": 19715.91, "timestamp": "05:28:35", "text": "1、2回くらい見る程度。"}, {"type": "subtitle", "time": 19719.43, "timestamp": "05:28:39", "text": "うん。そして、わからないけど、たぶん、えーと"}, {"type": "subtitle", "time": 19721.43, "timestamp": "05:28:41", "text": "あなたは歴史の学生みたいなので、"}, {"type": "subtitle", "time": 19724.07, "timestamp": "05:28:44", "text": "キを書き出すのは"}, {"type": "subtitle", "time": 19726.39, "timestamp": "05:28:46", "text": "あなたにとっては役に立つかもしれませんが、私にとっては役に立ちません"}, {"type": "subtitle", "time": 19731.11, "timestamp": "05:28:51", "text": "仕事。うまくいきません。待って、なぜ？のように"}, {"type": "subtitle", "time": 19733.59, "timestamp": "05:28:53", "text": "それは私が慣れ親しんだものとは全く違う"}, {"type": "subtitle", "time": 19736.07, "timestamp": "05:28:56", "text": "私が書いたものを読むと"}, {"type": "subtitle", "time": 19739.18, "timestamp": "05:28:59", "text": "何も覚えていない"}]
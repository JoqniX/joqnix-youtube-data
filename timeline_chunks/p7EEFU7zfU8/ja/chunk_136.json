[{"type": "subtitle", "time": 8162.709, "timestamp": "02:16:02", "text": "より簡単に。わかった。それは、"}, {"type": "subtitle", "time": 8165.75, "timestamp": "02:16:05", "text": "今すぐ。だから私がすることは、"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "倒れる、私は"}, {"type": "subtitle", "time": 8190.669, "timestamp": "02:16:30", "text": "ルモス"}, {"type": "subtitle", "time": 8207.549, "timestamp": "02:16:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8211.11, "timestamp": "02:16:51", "text": "はぁ。起き上がるのが良いでしょう"}]
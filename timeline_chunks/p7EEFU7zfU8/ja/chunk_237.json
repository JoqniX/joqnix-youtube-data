[{"type": "subtitle", "time": 14226.189, "timestamp": "03:57:06", "text": "残念なことに、あなたは"}, {"type": "subtitle", "time": 14229.389, "timestamp": "03:57:09", "text": "汚して持ってきて"}, {"type": "subtitle", "time": 14232.55, "timestamp": "03:57:12", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 14235.91, "timestamp": "03:57:15", "text": "私は本当にこの場所を片付けたわけではないが、"}, {"type": "subtitle", "time": 14242.51, "timestamp": "03:57:22", "text": "ない？もっとやろう"}, {"type": "subtitle", "time": 14245.51, "timestamp": "03:57:25", "text": "敵。私は戦闘経験が必要だ"}, {"type": "subtitle", "time": 14267.71, "timestamp": "03:57:47", "text": "そこには。こんにちは。もう1つあります"}, {"type": "subtitle", "time": 14274.07, "timestamp": "03:57:54", "text": "ゴブリンを盗むべきではない"}, {"type": "subtitle", "time": 14278.63, "timestamp": "03:57:58", "text": "他人に盗まれた兜を、あなたも盗むべきでしょうか？"}]
[{"type": "subtitle", "time": 19925.19, "timestamp": "05:32:05", "text": "N3と書く。"}, {"type": "subtitle", "time": 19928.31, "timestamp": "05:32:08", "text": "N3は本当に難しい。 Cの数のように"}, {"type": "subtitle", "time": 19930.07, "timestamp": "05:32:10", "text": "たぶんあなたは"}, {"type": "subtitle", "time": 19932.07, "timestamp": "05:32:12", "text": "フルタイムで勉強しているのに、"}, {"type": "subtitle", "time": 19934.99, "timestamp": "05:32:14", "text": "ライブ配信はそれほど重要だ。うん、"}, {"type": "subtitle", "time": 19937.27, "timestamp": "05:32:17", "text": "それほど多くはなくても。うん、勉強しなきゃ。"}, {"type": "subtitle", "time": 19941.35, "timestamp": "05:32:21", "text": "勉強、勉強、そして真剣に取り組みなさい。"}, {"type": "subtitle", "time": 19944.07, "timestamp": "05:32:24", "text": "ああ、そういうこともあるよね。私は"}, {"type": "subtitle", "time": 19946.948, "timestamp": "05:32:26", "text": "複数のことを同時に行うのは本当に"}, {"type": "subtitle", "time": 19949.75, "timestamp": "05:32:29", "text": "一つのことに集中し続けるのは難しい"}, {"type": "subtitle", "time": 19952.15, "timestamp": "05:32:32", "text": "ええ、間違いなくそうです。本当に"}, {"type": "subtitle", "time": 19953.99, "timestamp": "05:32:33", "text": "難しい。"}, {"type": "subtitle", "time": 19962.628, "timestamp": "05:32:42", "text": "はい、私は自分が下手だったら心配です。"}, {"type": "subtitle", "time": 19965.43, "timestamp": "05:32:45", "text": "勉強もしている。勉強が下手というわけではない。私"}, {"type": "subtitle", "time": 19967.35, "timestamp": "05:32:47", "text": "勉強する意欲を失ってしまったんだよ。"}, {"type": "subtitle", "time": 19970.23, "timestamp": "05:32:50", "text": "だから、次の試験でも"}, {"type": "subtitle", "time": 19971.83, "timestamp": "05:32:51", "text": "今月は、勉強すらしていません。私はしません"}, {"type": "subtitle", "time": 19973.868, "timestamp": "05:32:53", "text": "自分がどの科目を勉強すべきかさえわからない"}, {"type": "subtitle", "time": 19975.868, "timestamp": "05:32:55", "text": "研究と"}]
[{"type": "subtitle", "time": 1923.549, "timestamp": "00:32:03", "text": "意味。 223 223。"}, {"type": "subtitle", "time": 1926.549, "timestamp": "00:32:06", "text": "こんにちは、パリの息子さんは元気ですか？あなたが"}, {"type": "subtitle", "time": 1933.23, "timestamp": "00:32:13", "text": "その男"}, {"type": "subtitle", "time": 1950.43, "timestamp": "00:32:30", "text": "フルー、私のオーディオは妨げられました。"}, {"type": "subtitle", "time": 1955.43, "timestamp": "00:32:35", "text": "ちょっと待って、ミキサーの設定をリセットする必要がある。"}, {"type": "subtitle", "time": 1978.31, "timestamp": "00:32:58", "text": "ああ、なるほど。こんにちは、スクリーンショットです。はぁ？待って、いや、"}]
[{"type": "subtitle", "time": 20522.07, "timestamp": "05:42:02", "text": "そうやって続けるつもりです。はい。はい。"}, {"type": "subtitle", "time": 20526.39, "timestamp": "05:42:06", "text": "はい。はい。えっと、それについてなんですが。私は"}, {"type": "subtitle", "time": 20529.23, "timestamp": "05:42:09", "text": "コースはほぼ終了しました。"}, {"type": "subtitle", "time": 20534.31, "timestamp": "05:42:14", "text": "しかし、現在も続いている問題は"}, {"type": "subtitle", "time": 20537.51, "timestamp": "05:42:17", "text": "えっと、どう言えばいいかな？私はそうしなければならない"}, {"type": "subtitle", "time": 20540.31, "timestamp": "05:42:20", "text": "あと1ヶ月残っているが、彼は"}, {"type": "subtitle", "time": 20544.31, "timestamp": "05:42:24", "text": "まだカリキュラム全体を終えていないし、"}, {"type": "subtitle", "time": 20546.47, "timestamp": "05:42:26", "text": "まだ支払わなければならない"}, {"type": "subtitle", "time": 20550.23, "timestamp": "05:42:30", "text": "えーと、最後のコースのあれ"}, {"type": "subtitle", "time": 20552.948, "timestamp": "05:42:32", "text": "月。まだやってないのは、"}, {"type": "subtitle", "time": 20555.59, "timestamp": "05:42:35", "text": "少し壊れた。ちょっときつい"}, {"type": "subtitle", "time": 20560.07, "timestamp": "05:42:40", "text": "お金と、えっと、でも問題は、私は"}, {"type": "subtitle", "time": 20562.788, "timestamp": "05:42:42", "text": "基本を理解するために"}, {"type": "subtitle", "time": 20565.03, "timestamp": "05:42:45", "text": "ジャンルを学び、それに固執する"}, {"type": "subtitle", "time": 20567.43, "timestamp": "05:42:47", "text": "そういうことはたくさんあって、ちょっと"}, {"type": "subtitle", "time": 20570.07, "timestamp": "05:42:50", "text": "難しいし、まだ行き詰まっている"}, {"type": "subtitle", "time": 20572.948, "timestamp": "05:42:52", "text": "音楽関係のこと。だから結局私はまだ"}, {"type": "subtitle", "time": 20576.07, "timestamp": "05:42:56", "text": "続けなければならないし、"}, {"type": "subtitle", "time": 20579.11, "timestamp": "05:42:59", "text": "日本からの活動も続けてください。"}]
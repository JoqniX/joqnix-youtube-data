[{"type": "subtitle", "time": 8716.15, "timestamp": "02:25:16", "text": "ああ、それは強い"}, {"type": "subtitle", "time": 8719.349, "timestamp": "02:25:19", "text": "攻撃。あなたは自分の行いの代償を払うことになるだろう。は"}, {"type": "subtitle", "time": 8722.309, "timestamp": "02:25:22", "text": "本当にそう思いますか？それはただ"}, {"type": "subtitle", "time": 8732.389, "timestamp": "02:25:32", "text": "まだ電話を切ろうとしているのが分かっていた。"}, {"type": "subtitle", "time": 8734.95, "timestamp": "02:25:34", "text": "ああ。戻る。あらら。いや、いや、いや、いや。おお、"}, {"type": "subtitle", "time": 8740.469, "timestamp": "02:25:40", "text": "神。神様、神様、神様、神様、神様、神様。動く。"}, {"type": "subtitle", "time": 8749.99, "timestamp": "02:25:49", "text": "なんてこった、彼らはとても"}]
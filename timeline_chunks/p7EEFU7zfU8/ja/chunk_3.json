[{"type": "subtitle", "time": 194.03, "timestamp": "00:03:14", "text": "これは何ですか？自宅からどうやって行きますか？"}, {"type": "subtitle", "time": 197.50900000000001, "timestamp": "00:03:17", "text": "自宅から学校へ、仕事へ？でも私は行かない"}, {"type": "subtitle", "time": 207.43, "timestamp": "00:03:27", "text": "仕事。在宅勤務です。試験のために"}, {"type": "subtitle", "time": 210.63, "timestamp": "00:03:30", "text": "試験のためだけに、私は行かなければならない"}, {"type": "subtitle", "time": 219.67000000000002, "timestamp": "00:03:39", "text": "けれど。私は乗りたくない。私は持っていますか"}, {"type": "subtitle", "time": 226.99, "timestamp": "00:03:46", "text": "書く"}]
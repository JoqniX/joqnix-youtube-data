[{"type": "subtitle", "time": 20702.07, "timestamp": "05:45:02", "text": "レースのために。レイニッシュさん、ようこそ。私たちは"}, {"type": "subtitle", "time": 20705.59, "timestamp": "05:45:05", "text": "Vであるダンと遊んでいる"}, {"type": "subtitle", "time": 20707.83, "timestamp": "05:45:07", "text": "インド出身の歌手。"}, {"type": "subtitle", "time": 20712.948, "timestamp": "05:45:12", "text": "こんにちは。はい、私はDです。私はVTuberです。"}, {"type": "subtitle", "time": 20716.708, "timestamp": "05:45:16", "text": "ええと、インド。私は主に歌うだけです"}, {"type": "subtitle", "time": 20719.11, "timestamp": "05:45:19", "text": "ローカライズされた楽曲、あらゆるタイプのJ-POP"}, {"type": "subtitle", "time": 20722.23, "timestamp": "05:45:22", "text": "歌。以上です。私も好きです"}, {"type": "subtitle", "time": 20724.948, "timestamp": "05:45:24", "text": "Alien Stageのカバー曲。はい。はい。"}, {"type": "subtitle", "time": 20727.59, "timestamp": "05:45:27", "text": "それが今の私の最優先事項です。必要"}, {"type": "subtitle", "time": 20729.51, "timestamp": "05:45:29", "text": "エイリアンステージの曲を全部終わらせて"}, {"type": "subtitle", "time": 20731.64, "timestamp": "05:45:31", "text": "ようやく前に進める。"}, {"type": "subtitle", "time": 20733.51, "timestamp": "05:45:33", "text": "[音楽]"}, {"type": "subtitle", "time": 20736.868, "timestamp": "05:45:36", "text": "うん。そして彼女はまた、"}, {"type": "subtitle", "time": 20742.27, "timestamp": "05:45:42", "text": "歌の歌い方を教えてくれた。の"}, {"type": "subtitle", "time": 20743.868, "timestamp": "05:45:43", "text": "うん。"}, {"type": "subtitle", "time": 20747.708, "timestamp": "05:45:47", "text": "8と11"}, {"type": "subtitle", "time": 20749.708, "timestamp": "05:45:49", "text": "すべて。えっと"}, {"type": "subtitle", "time": 20751.99, "timestamp": "05:45:51", "text": "うん。あなたはまだ練習していますか"}, {"type": "subtitle", "time": 20757.11, "timestamp": "05:45:57", "text": "1曲だけ？好きです、つまり、たぶん"}]
[{"type": "subtitle", "time": 3853.67, "timestamp": "01:04:13", "text": "ここ。チャットチャットがあるのはそこです"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "はい。では今日、この騎手を見てください"}, {"type": "subtitle", "time": 3865.67, "timestamp": "01:04:25", "text": "こういうクールなメガネが好き。"}, {"type": "subtitle", "time": 3868.71, "timestamp": "01:04:28", "text": "このメガネって、一体どんな種類でしたっけ？"}, {"type": "subtitle", "time": 3875.67, "timestamp": "01:04:35", "text": "だから私たちは、なぜ彼らは私を見ているのか"}, {"type": "subtitle", "time": 3877.75, "timestamp": "01:04:37", "text": "え？"}, {"type": "subtitle", "time": 3880.069, "timestamp": "01:04:40", "text": "おそらく今ならこれらすべてを止めることができる"}, {"type": "subtitle", "time": 3883.51, "timestamp": "01:04:43", "text": "気持ち悪いマグカップの血。あなたは"}, {"type": "subtitle", "time": 3887.589, "timestamp": "01:04:47", "text": "私のことを話しているの？親愛なる子供たち"}, {"type": "subtitle", "time": 3889.109, "timestamp": "01:04:49", "text": "嫌い。"}, {"type": "subtitle", "time": 3891.109, "timestamp": "01:04:51", "text": "はい、私の両親は、"}, {"type": "subtitle", "time": 3893.829, "timestamp": "01:04:53", "text": "彼らがただ座るかどうかについて話しているのではなく"}, {"type": "subtitle", "time": 3896.47, "timestamp": "01:04:56", "text": "ピュー。"}]
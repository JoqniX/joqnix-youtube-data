[{"type": "subtitle", "time": 8108.75, "timestamp": "02:15:08", "text": "でも、もし私が"}, {"type": "subtitle", "time": 8124.83, "timestamp": "02:15:24", "text": "ああ、私は"}, {"type": "subtitle", "time": 8128.35, "timestamp": "02:15:28", "text": "遅い。ああ、遅刻しちゃった。遅刻だ。遅刻だ。"}, {"type": "subtitle", "time": 8131.589, "timestamp": "02:15:31", "text": "えっと、私がそうしないとき、私が"}, {"type": "subtitle", "time": 8134.629, "timestamp": "02:15:34", "text": "脈拍を測るのをやめてください。えっと、待って。私は思う"}, {"type": "subtitle", "time": 8136.99, "timestamp": "02:15:36", "text": "それは"}, {"type": "subtitle", "time": 8139.03, "timestamp": "02:15:39", "text": "ねえ、知ってる？あのね？あなた"}, {"type": "subtitle", "time": 8141.109, "timestamp": "02:15:41", "text": "何だと思う？スキルを整理させてください"}, {"type": "subtitle", "time": 8143.39, "timestamp": "02:15:43", "text": "スロット。どこにある"}, {"type": "chat", "time": 8147.343, "timestamp": "02:15:47", "author": "@scaramouche611", "avatar": "https://yt4.ggpht.com/gpl17RW8KxrqN5kkedVdeH0DagiGDZKnYGlwnQwIQNNQjzeTxJdFzEouNPC3L1t1lj8jUAxv7Q4=s64-c-k-c0x00ffffff-no-rj", "message": "Hello buddy did you sleep well"}, {"type": "subtitle", "time": 8148.069, "timestamp": "02:15:48", "text": "パルサー？えーと、これらを置いてみましょう"}]
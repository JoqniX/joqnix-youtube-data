[{"type": "subtitle", "time": 6002.83, "timestamp": "01:40:02", "text": "もっと。これは英語の配信ですか？はい、"}, {"type": "subtitle", "time": 6007.47, "timestamp": "01:40:07", "text": "は。うん。こんにちは、ジャフロ。いらっしゃいませ、"}, {"type": "subtitle", "time": 6008.99, "timestamp": "01:40:08", "text": "ようこそ、ようこそ、"}, {"type": "subtitle", "time": 6010.43, "timestamp": "01:40:10", "text": "[音楽]"}, {"type": "subtitle", "time": 6014.99, "timestamp": "01:40:14", "text": "いらっしゃいませ。どうやって私を見つけますか？調子はどうですか"}, {"type": "subtitle", "time": 6018.629, "timestamp": "01:40:18", "text": "あなた？えっと、"}, {"type": "subtitle", "time": 6020.55, "timestamp": "01:40:20", "text": "いいえ。"}, {"type": "subtitle", "time": 6024.39, "timestamp": "01:40:24", "text": "そうそう。どうすれば強制的に開けられますか？"}, {"type": "subtitle", "time": 6026.99, "timestamp": "01:40:26", "text": "ああ、反重力。"}, {"type": "subtitle", "time": 6042.03, "timestamp": "01:40:42", "text": "わかりました。ああ、そこにいるよ"}, {"type": "subtitle", "time": 6049.91, "timestamp": "01:40:49", "text": "ついに。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 6051.51, "timestamp": "01:40:51", "text": "ジェスロ。"}, {"type": "subtitle", "time": 6053.51, "timestamp": "01:40:53", "text": "なんとなくそんな気がする。そして幸せなヴァニスターと"}, {"type": "subtitle", "time": 6054.59, "timestamp": "01:40:54", "text": "良い"}, {"type": "subtitle", "time": 6057.189, "timestamp": "01:40:57", "text": "朝。ああ、そこには"}, {"type": "subtitle", "time": 6059.95, "timestamp": "01:40:59", "text": "骸骨。ああ、"}]
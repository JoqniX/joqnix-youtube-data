[{"type": "subtitle", "time": 15203.51, "timestamp": "04:13:23", "text": "[音楽]"}, {"type": "subtitle", "time": 15215.75, "timestamp": "04:13:35", "text": "ビジネスの喧騒が恋しい。貧しい"}, {"type": "subtitle", "time": 15218.389, "timestamp": "04:13:38", "text": "外出を恐れる顧客たち。マダム"}, {"type": "subtitle", "time": 15219.91, "timestamp": "04:13:39", "text": "ボウモント、"}, {"type": "subtitle", "time": 15222.07, "timestamp": "04:13:42", "text": "あなたのニュースがあると思います"}, {"type": "subtitle", "time": 15225.11, "timestamp": "04:13:45", "text": "兄弟。バドルフ、私の"}, {"type": "subtitle", "time": 15227.18, "timestamp": "04:13:47", "text": "兄弟？"}, {"type": "subtitle", "time": 15235.99, "timestamp": "04:13:55", "text": "えっと、どうすればいいんだろう？"}, {"type": "subtitle", "time": 15238.63, "timestamp": "04:13:58", "text": "残念ながら彼はアシュウィンダーズに加わったようです"}]
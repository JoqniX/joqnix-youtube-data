[{"type": "subtitle", "time": 20941.11, "timestamp": "05:49:01", "text": "ジョイジョイジョイの音を使っているので"}, {"type": "subtitle", "time": 20943.51, "timestamp": "05:49:03", "text": "あれ。"}, {"type": "subtitle", "time": 20945.91, "timestamp": "05:49:05", "text": "うん。 JSONは一体どういう仕組みで動作するのでしょうか？私"}, {"type": "subtitle", "time": 20948.548, "timestamp": "05:49:08", "text": "正直言って、それについてはあまりよく知らないんです。"}, {"type": "subtitle", "time": 20952.31, "timestamp": "05:49:12", "text": "まるで、それを使う人たちが言うように"}, {"type": "subtitle", "time": 20954.948, "timestamp": "05:49:14", "text": "例えばYouTubeに行くと、"}, {"type": "subtitle", "time": 20957.91, "timestamp": "05:49:17", "text": "人々はそれを使っています。私は「なぜ彼らは"}, {"type": "subtitle", "time": 20959.83, "timestamp": "05:49:19", "text": "それを使う？そして私はそれだけでなく"}, {"type": "subtitle", "time": 20963.11, "timestamp": "05:49:23", "text": "歌詞と歌い方を教えてくれます。"}, {"type": "subtitle", "time": 20965.91, "timestamp": "05:49:25", "text": "また、著作権からも保護されます。"}, {"type": "subtitle", "time": 20968.83, "timestamp": "05:49:28", "text": "ストライキとか何とか、"}, {"type": "subtitle", "time": 20972.11, "timestamp": "05:49:32", "text": "はい、クレジットを記載する必要があります"}, {"type": "subtitle", "time": 20975.19, "timestamp": "05:49:35", "text": "きちんとして、いろいろと"}, {"type": "subtitle", "time": 20978.39, "timestamp": "05:49:38", "text": "ストリーム上のウォーターマークは、ジョイライドジョイについてです。"}, {"type": "subtitle", "time": 20980.708, "timestamp": "05:49:40", "text": "音か何か。"}, {"type": "subtitle", "time": 20982.868, "timestamp": "05:49:42", "text": "なるほど、それは興味深いですね。"}, {"type": "subtitle", "time": 20985.35, "timestamp": "05:49:45", "text": "それは新しいことだ。私は本当に"}, {"type": "subtitle", "time": 20987.19, "timestamp": "05:49:47", "text": "あなたが今、それについてよく考えました"}, {"type": "subtitle", "time": 20988.948, "timestamp": "05:49:48", "text": "それは実際には親切なことであるかのように言及した"}, {"type": "subtitle", "time": 20990.628, "timestamp": "05:49:50", "text": "興味深い。"}, {"type": "subtitle", "time": 20992.868, "timestamp": "05:49:52", "text": "うん、それならどんな歌でも歌えるよ"}, {"type": "subtitle", "time": 20996.868, "timestamp": "05:49:56", "text": "Joy Soundで入手できるものと同様です。"}, {"type": "subtitle", "time": 20999.35, "timestamp": "05:49:59", "text": "その曲には本当にたくさんの曲がある、"}]
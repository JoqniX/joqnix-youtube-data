[{"type": "subtitle", "time": 14838.51, "timestamp": "04:07:18", "text": "必ず償わせる。"}, {"type": "subtitle", "time": 14841.269, "timestamp": "04:07:21", "text": "[音楽]"}, {"type": "subtitle", "time": 14847.309, "timestamp": "04:07:27", "text": "私は休まない"}, {"type": "subtitle", "time": 14855.11, "timestamp": "04:07:35", "text": "終わり。"}, {"type": "subtitle", "time": 14858.71, "timestamp": "04:07:38", "text": "責めるべきはレンロックだけだ。"}, {"type": "subtitle", "time": 14861.189, "timestamp": "04:07:41", "text": "両キャンプとも撤去された。ボウモント夫人は"}, {"type": "subtitle", "time": 14869.79, "timestamp": "04:07:49", "text": "でも行く前に、"}, {"type": "subtitle", "time": 14874.269, "timestamp": "04:07:54", "text": "古代の"}]
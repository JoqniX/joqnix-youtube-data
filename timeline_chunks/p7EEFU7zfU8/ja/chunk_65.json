[{"type": "subtitle", "time": 3903.51, "timestamp": "01:05:03", "text": "待って。なぜ私は自分自身が毎日聞いているのか"}, {"type": "subtitle", "time": 3906.23, "timestamp": "01:05:06", "text": "一度だけ？なぜ私は自分の"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "バックグラウンドでストリーミング再生？アドベンチャー。は"}, {"type": "subtitle", "time": 3911.43, "timestamp": "01:05:11", "text": "私たちは"}, {"type": "subtitle", "time": 3920.309, "timestamp": "01:05:20", "text": "アドベンチャー。ということで、前回の配信ではロックを解除しました"}, {"type": "subtitle", "time": 3924.069, "timestamp": "01:05:24", "text": "えっと、このゲームの鍵開けシステム。"}, {"type": "subtitle", "time": 3929.069, "timestamp": "01:05:29", "text": "つまり、私は鍵を開けて錠前を解くことができるということです"}, {"type": "subtitle", "time": 3933.549, "timestamp": "01:05:33", "text": "開閉可能な部屋や家、または"}, {"type": "subtitle", "time": 3940.27, "timestamp": "01:05:40", "text": "よお。何もない"}, {"type": "subtitle", "time": 3944.19, "timestamp": "01:05:44", "text": "ここ。そしてここには何もありません。何もない"}, {"type": "subtitle", "time": 3948.43, "timestamp": "01:05:48", "text": "ここ。ここには何もない。何もない"}, {"type": "subtitle", "time": 3950.87, "timestamp": "01:05:50", "text": "ここ。いくつかはどこにあるの？存在するべきである"}, {"type": "subtitle", "time": 3953.87, "timestamp": "01:05:53", "text": "何か。"}, {"type": "subtitle", "time": 3958.27, "timestamp": "01:05:58", "text": "おい。このギャップとは何ですか？このギャップは"}]
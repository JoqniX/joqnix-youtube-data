[{"type": "subtitle", "time": 10277.59, "timestamp": "02:51:17", "text": "こんにちは、先生。私は救出に成功しました"}, {"type": "subtitle", "time": 10280.07, "timestamp": "02:51:20", "text": "パフキン。救出できる人数は"}, {"type": "subtitle", "time": 10282.87, "timestamp": "02:51:22", "text": "リュックサックには入るだろう。密猟者が捕獲"}, {"type": "subtitle", "time": 10285.75, "timestamp": "02:51:25", "text": "パフスキン、そして、デイカはよくわからない"}, {"type": "subtitle", "time": 10288.55, "timestamp": "02:51:28", "text": "彼らはそれらをどう使うのか。ディーは確信している"}, {"type": "subtitle", "time": 10291.349, "timestamp": "02:51:31", "text": "彼らはあなたと一緒にいる方が安全です。今は、"}, {"type": "subtitle", "time": 10293.429, "timestamp": "02:51:33", "text": "すべての獣は簡単に救出できるだろう"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "宣伝目的の策略として。 Deak が次に提案する"}, {"type": "subtitle", "time": 10298.71, "timestamp": "02:51:38", "text": "空を飛べる獣を見つけろ。ジョブバル、"}, {"type": "subtitle", "time": 10301.349, "timestamp": "02:51:41", "text": "多分。仕事。"}, {"type": "subtitle", "time": 10304.15, "timestamp": "02:51:44", "text": "ディークは西の方で営巣している鳥が何羽かいることを知っている"}, {"type": "subtitle", "time": 10306.55, "timestamp": "02:51:46", "text": "ホグワーツを見下ろす大きな木の上で。"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "わかりました。でも、注意が必要です。ディークは"}, {"type": "subtitle", "time": 10311.91, "timestamp": "02:51:51", "text": "最近、その地域で密猟者を見かけた。"}, {"type": "subtitle", "time": 10313.91, "timestamp": "02:51:53", "text": "アルコールは命取りだ。そこで会いましょう"}]
[{"type": "subtitle", "time": 16804.47, "timestamp": "04:40:04", "text": "うーうー、デビルサン、ストリーミングして"}, {"type": "subtitle", "time": 16821.07, "timestamp": "04:40:21", "text": "何か。どこですか"}, {"type": "subtitle", "time": 16824.15, "timestamp": "04:40:24", "text": "それから？一番上。それが上にあるなら、私は"}, {"type": "subtitle", "time": 16839.07, "timestamp": "04:40:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16841.33, "timestamp": "04:40:41", "text": "いいえ。では、どうしたらいいのでしょうか？"}]
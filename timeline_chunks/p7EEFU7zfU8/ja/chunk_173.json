[{"type": "subtitle", "time": 10399.349, "timestamp": "02:53:19", "text": "こんにちは、ディー。続けましょうか？はい。"}, {"type": "subtitle", "time": 10401.75, "timestamp": "02:53:21", "text": "良い。ディーはあなたのことを心配していました。何"}, {"type": "subtitle", "time": 10403.67, "timestamp": "02:53:23", "text": "その地域には密猟者が大勢いるのに？私"}, {"type": "subtitle", "time": 10406.469, "timestamp": "02:53:26", "text": "飛んだ。迅速に行動すべきだ。仕事"}, {"type": "subtitle", "time": 10409.269, "timestamp": "02:53:29", "text": "彼らはまさにこの大きな木の中にいます。"}, {"type": "subtitle", "time": 10412.15, "timestamp": "02:53:32", "text": "役立つ。デはレヴィオーソが"}, {"type": "subtitle", "time": 10414.469, "timestamp": "02:53:34", "text": "動きの遅い空飛ぶ獣たち。"}, {"type": "subtitle", "time": 10420.79, "timestamp": "02:53:40", "text": "それなら、私は仕事を探しに行こう。良い"}, {"type": "subtitle", "time": 10427.59, "timestamp": "02:53:47", "text": "[音楽]"}, {"type": "subtitle", "time": 10429.07, "timestamp": "02:53:49", "text": "それだ。"}, {"type": "subtitle", "time": 10432.63, "timestamp": "02:53:52", "text": "はぁ？レヴィオーサ。"}, {"type": "subtitle", "time": 10434.75, "timestamp": "02:53:54", "text": "レヴィオーサ、そしてこれは"}, {"type": "subtitle", "time": 10438.11, "timestamp": "02:53:58", "text": "レヴィオーサ。ウィンガーディアム・レヴィオーサ。はい、わかりました"}]
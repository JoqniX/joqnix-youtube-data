[{"type": "subtitle", "time": 14340.03, "timestamp": "03:59:00", "text": "私が彼を殺したのか？"}, {"type": "subtitle", "time": 14342.309, "timestamp": "03:59:02", "text": "いや、彼を来させよう。彼を来させなさい。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "インセンディオ、"}, {"type": "subtitle", "time": 14356.15, "timestamp": "03:59:16", "text": "反乱。"}, {"type": "subtitle", "time": 14363.189, "timestamp": "03:59:23", "text": "クモ。ああ、なるほど、狙いを定めなければならない"}, {"type": "subtitle", "time": 14383.95, "timestamp": "03:59:43", "text": "そこにいる"}, {"type": "subtitle", "time": 14394.189, "timestamp": "03:59:54", "text": "終わり。そして、私はこれをどうするだろうか"}]
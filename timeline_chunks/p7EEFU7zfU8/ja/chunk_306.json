[{"type": "subtitle", "time": 18369.35, "timestamp": "05:06:09", "text": "右？ええと、ダンとキーズはみんなレガシーを受け継ぐんだ。私"}, {"type": "subtitle", "time": 18373.23, "timestamp": "05:06:13", "text": "正しいものを見つけたい"}, {"type": "subtitle", "time": 18377.07, "timestamp": "05:06:17", "text": "あれ。さっさと終わらせよう。"}, {"type": "subtitle", "time": 18379.47, "timestamp": "05:06:19", "text": "わかった。それが"}, {"type": "subtitle", "time": 18388.24, "timestamp": "05:06:28", "text": "これ。残りのタンポポ15個"}, {"type": "subtitle", "time": 18390.03, "timestamp": "05:06:30", "text": "[音楽]"}, {"type": "subtitle", "time": 18393.948, "timestamp": "05:06:33", "text": "鍵。現時点では、私は"}, {"type": "subtitle", "time": 18403.07, "timestamp": "05:06:43", "text": "よし、ダークアートの部屋だ。暗闇に行こう"}, {"type": "subtitle", "time": 18405.99, "timestamp": "05:06:45", "text": "部屋。私はこの男を見つけなければならない。私は"}, {"type": "subtitle", "time": 18414.23, "timestamp": "05:06:54", "text": "オフ。終わらせよう。わかった。防衛"}, {"type": "subtitle", "time": 18419.55, "timestamp": "05:06:59", "text": "神々。これ"}]
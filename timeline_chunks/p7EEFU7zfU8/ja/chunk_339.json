[{"type": "subtitle", "time": 20343.07, "timestamp": "05:39:03", "text": "それ以外は、私だけです。はい。"}, {"type": "subtitle", "time": 20346.11, "timestamp": "05:39:06", "text": "はい。あなたは"}, {"type": "subtitle", "time": 20349.91, "timestamp": "05:39:09", "text": "デビュー。 M. うん、私がそうするかもしれないのは"}, {"type": "subtitle", "time": 20352.868, "timestamp": "05:39:12", "text": "そうですね、たぶん1Kくらいかな"}, {"type": "subtitle", "time": 20357.03, "timestamp": "05:39:17", "text": "少なくとも購読者数とか、何かは必要だ。うん、"}, {"type": "subtitle", "time": 20367.19, "timestamp": "05:39:27", "text": "私は自分のように配信したい"}, {"type": "subtitle", "time": 20368.788, "timestamp": "05:39:28", "text": "ウェブ上の曲を読む。それはある意味"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "楽しい。うん、君が"}, {"type": "subtitle", "time": 20374.47, "timestamp": "05:39:34", "text": "ストリームでコンテンツを表示しないでください、"}, {"type": "subtitle", "time": 20377.03, "timestamp": "05:39:37", "text": "大丈夫。人々はASMRのように楽しむことができる"}, {"type": "subtitle", "time": 20383.628, "timestamp": "05:39:43", "text": "右？見たことないの？"}, {"type": "subtitle", "time": 20385.99, "timestamp": "05:39:45", "text": "研究？おそらく調査が必要だった"}, {"type": "subtitle", "time": 20389.15, "timestamp": "05:39:49", "text": "好きな人がいるように"}, {"type": "subtitle", "time": 20394.71, "timestamp": "05:39:54", "text": "その曲の上映。だからよくわからない"}, {"type": "subtitle", "time": 20398.708, "timestamp": "05:39:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14520.71, "timestamp": "04:02:00", "text": "ちなみに、私はクラ・ブルモントです。いい感じ"}, {"type": "subtitle", "time": 14522.95, "timestamp": "04:02:02", "text": "お会いしましょう。ランロックとその信者たちは"}, {"type": "subtitle", "time": 14525.59, "timestamp": "04:02:05", "text": "ここにキャンプを設営する。私たちの"}, {"type": "subtitle", "time": 14527.63, "timestamp": "04:02:07", "text": "愛するハムレット、あるいは私たちの"}, {"type": "subtitle", "time": 14531.189, "timestamp": "04:02:11", "text": "生計。冷酷だ。私の兄、バード"}, {"type": "subtitle", "time": 14533.189, "timestamp": "04:02:13", "text": "彼らに立ち向かう勇気があり、結果的に"}, {"type": "subtitle", "time": 14536.389, "timestamp": "04:02:16", "text": "セント・モンゴスにて。私はただただ途方に暮れていた"}, {"type": "subtitle", "time": 14541.269, "timestamp": "04:02:21", "text": "わかった。"}, {"type": "subtitle", "time": 14543.269, "timestamp": "04:02:23", "text": "残念ながら私はよく知っています"}, {"type": "subtitle", "time": 14545.67, "timestamp": "04:02:25", "text": "レンロの忠誠者たち。多分私はできる"}, {"type": "subtitle", "time": 14548.389, "timestamp": "04:02:28", "text": "何か。私はそうなりたいと切望しているが"}, {"type": "subtitle", "time": 14549.99, "timestamp": "04:02:29", "text": "それらを排除する。さあ行こう。君は要らない"}, {"type": "subtitle", "time": 14553.269, "timestamp": "04:02:33", "text": "怪我、あるいはそれ以上の危険を冒す。どうぞ"}, {"type": "subtitle", "time": 14556.07, "timestamp": "04:02:36", "text": "用心深い。"}, {"type": "subtitle", "time": 14558.55, "timestamp": "04:02:38", "text": "私たちは恐怖の中で生きる必要はないはずだ。これ"}, {"type": "subtitle", "time": 14560.67, "timestamp": "04:02:40", "text": "ここは私たちの家です。"}, {"type": "subtitle", "time": 14563.269, "timestamp": "04:02:43", "text": "わかった。一瞬、本当に"}, {"type": "subtitle", "time": 14564.91, "timestamp": "04:02:44", "text": "別のものをアクティブ化"}, {"type": "subtitle", "time": 14567.349, "timestamp": "04:02:47", "text": "クエスト。複数でも構いません"}, {"type": "subtitle", "time": 14575.11, "timestamp": "04:02:55", "text": "しかし、私たちには時間がない。私は自分の"}, {"type": "subtitle", "time": 14578.189, "timestamp": "04:02:58", "text": "兄は大丈夫だ。"}, {"type": "subtitle", "time": 14579.79, "timestamp": "04:02:59", "text": "ナタリー、"}]
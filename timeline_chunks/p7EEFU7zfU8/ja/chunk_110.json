[{"type": "subtitle", "time": 6601.55, "timestamp": "01:50:01", "text": "上の記号"}, {"type": "subtitle", "time": 6604.39, "timestamp": "01:50:04", "text": "ここでは戻る方がずっと良いと思う"}, {"type": "subtitle", "time": 6606.51, "timestamp": "01:50:06", "text": "そして、えーと"}, {"type": "subtitle", "time": 6608.95, "timestamp": "01:50:08", "text": "調べてみると、全くインド風には聞こえない。"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "これは何だ、これは装飾品だ"}, {"type": "subtitle", "time": 6623.709, "timestamp": "01:50:23", "text": "[音楽]"}, {"type": "subtitle", "time": 6626.99, "timestamp": "01:50:26", "text": "ゴドゥはああしなければならない。おお。"}, {"type": "subtitle", "time": 6629.239, "timestamp": "01:50:29", "text": "おお。 いいえ。私はここまで登ることができます。わかった。の"}, {"type": "subtitle", "time": 6634.44, "timestamp": "01:50:34", "text": "いいえ。私はここまで登ることができます。わかった。の 柱。まるでなりすましに遭っているような気分だ"}, {"type": "subtitle", "time": 6637.36, "timestamp": "01:50:37", "text": "柱。まるでなりすましに遭っているような気分だ あなたの"}, {"type": "subtitle", "time": 6639.48, "timestamp": "01:50:39", "text": "あなたの 事故。何てことだ。 5月"}, {"type": "subtitle", "time": 6648.149, "timestamp": "01:50:48", "text": "待っていてください。 「オーマイゴッド」を手に入れることができました。"}, {"type": "subtitle", "time": 6649.629, "timestamp": "01:50:49", "text": "私の出来はどうでしたか？"}, {"type": "subtitle", "time": 6652.189, "timestamp": "01:50:52", "text": "それ？どうやってやったのか？"}, {"type": "subtitle", "time": 6656.189, "timestamp": "01:50:56", "text": "おお。何てことだ。おお。"}, {"type": "subtitle", "time": 6659.59, "timestamp": "01:50:59", "text": "ああ、わかった。えっと、この商品って何でしたっけ？"}]
[{"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "えっと、ジョー、あなたの好きなアニメは何ですか？私"}, {"type": "subtitle", "time": 6135.149, "timestamp": "01:42:15", "text": "特に好きなものはありません。"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "それは何と呼ばれますか？私はあらゆるタイプが好きです"}, {"type": "subtitle", "time": 6141.91, "timestamp": "01:42:21", "text": "世の中にはたくさんのアニメがある。選ぶのは難しい"}, {"type": "subtitle", "time": 6144.709, "timestamp": "01:42:24", "text": "お気に入り。まるで、まるで"}, {"type": "subtitle", "time": 6147.51, "timestamp": "01:42:27", "text": "「あなたの一番好きな親は誰ですか？」と尋ねる。それは"}, {"type": "subtitle", "time": 6150.07, "timestamp": "01:42:30", "text": "あなたの母親ですか、それとも父親ですか？私は誰か"}, {"type": "subtitle", "time": 6153.27, "timestamp": "01:42:33", "text": "彼らはいつも両方とも言う。私はできません"}, {"type": "subtitle", "time": 6155.39, "timestamp": "01:42:35", "text": "yoを比較してください。その"}, {"type": "subtitle", "time": 6159.83, "timestamp": "01:42:39", "text": "痛み。それは、それは私にとってとても難しい"}, {"type": "subtitle", "time": 6161.79, "timestamp": "01:42:41", "text": "に"}, {"type": "subtitle", "time": 6164.55, "timestamp": "01:42:44", "text": "比較する。私もそういうタイプです。質問するなら"}, {"type": "subtitle", "time": 6166.709, "timestamp": "01:42:46", "text": "私の好きなのはどれですか、もしそれがあなたのものなら"}, {"type": "subtitle", "time": 6175.669, "timestamp": "01:42:55", "text": "比較する。はい。ジェフ・ローザはここに新しく来た。"}, {"type": "subtitle", "time": 6177.669, "timestamp": "01:42:57", "text": "はい。"}]
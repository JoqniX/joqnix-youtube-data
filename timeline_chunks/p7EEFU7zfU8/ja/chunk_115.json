[{"type": "subtitle", "time": 6903.149, "timestamp": "01:55:03", "text": "これらのユニークな"}, {"type": "subtitle", "time": 6906.51, "timestamp": "01:55:06", "text": "えっと、これは何？"}, {"type": "subtitle", "time": 6914.39, "timestamp": "01:55:14", "text": "ああ、あの頭蓋骨がプラットフォームに近づいてくる。の"}, {"type": "subtitle", "time": 6916.109, "timestamp": "01:55:16", "text": "頭蓋骨"}, {"type": "subtitle", "time": 6927.39, "timestamp": "01:55:27", "text": "どのプラットフォームですか？プラットフォームはどこにありますか？"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "わかった。ああ、この場所はまるで"}, {"type": "subtitle", "time": 6948.87, "timestamp": "01:55:48", "text": "それはまるで私を歓迎しているかのようだ。ようこそ、人間よ。"}, {"type": "subtitle", "time": 6950.629, "timestamp": "01:55:50", "text": "ああ、魔女め。"}, {"type": "subtitle", "time": 6957.669, "timestamp": "01:55:57", "text": "ビザード、何をするのが好き？"}]
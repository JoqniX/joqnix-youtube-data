[{"type": "subtitle", "time": 3721.43, "timestamp": "01:02:01", "text": "火を噴くクモの糸の巣を切り取る"}, {"type": "subtitle", "time": 3724.549, "timestamp": "01:02:04", "text": "このことから出回っていたもの"}, {"type": "subtitle", "time": 3727.349, "timestamp": "01:02:07", "text": "えーと、角の壁からもう一方の角へ"}, {"type": "subtitle", "time": 3735.589, "timestamp": "01:02:15", "text": "スパイダー、許してくれよ。"}, {"type": "subtitle", "time": 3743.51, "timestamp": "01:02:23", "text": "良い一日をお過ごしください。えっと、何ですか"}, {"type": "subtitle", "time": 3746.309, "timestamp": "01:02:26", "text": "今日もまた同じ日なの？えっと、水曜日。ああ、そうだね。"}, {"type": "subtitle", "time": 3753.27, "timestamp": "01:02:33", "text": "水曜日。何てことだ。つまり"}, {"type": "subtitle", "time": 3762.309, "timestamp": "01:02:42", "text": "楽しい。ああ、大変だ。昨日は、ああ、そうだった。えっと、私は"}, {"type": "subtitle", "time": 3764.309, "timestamp": "01:02:44", "text": "昨日、配信をしました。私は完全に"}, {"type": "subtitle", "time": 3766.39, "timestamp": "01:02:46", "text": "それを忘れてた。うん。それで、私は"}, {"type": "subtitle", "time": 3769.67, "timestamp": "01:02:49", "text": "昨日配信して楽しかったけど、"}, {"type": "subtitle", "time": 3772.15, "timestamp": "01:02:52", "text": "でも昨日はすごく疲れていたんです。私は来た"}, {"type": "subtitle", "time": 3776.47, "timestamp": "01:02:56", "text": "家に帰ると、ええ、本当に作りました"}, {"type": "subtitle", "time": 3779.91, "timestamp": "01:02:59", "text": "たぶん9時か8時半くらいかな。"}]
[{"type": "subtitle", "time": 7512.149, "timestamp": "02:05:12", "text": "レベリオ。ベーコンがたっぷり。私は一度も"}, {"type": "subtitle", "time": 7516.35, "timestamp": "02:05:16", "text": "私の人生でベーコンを食べたことは一度もありません。だから、ある日私は"}, {"type": "subtitle", "time": 7526.55, "timestamp": "02:05:26", "text": "ベーコン。 H. それは私の願いの一つです。"}, {"type": "subtitle", "time": 7529.669, "timestamp": "02:05:29", "text": "まだ食べたことのない食品がたくさんある"}, {"type": "subtitle", "time": 7531.55, "timestamp": "02:05:31", "text": "今まで食べた"}, {"type": "subtitle", "time": 7533.629, "timestamp": "02:05:33", "text": "前に。それで"}, {"type": "subtitle", "time": 7536.109, "timestamp": "02:05:36", "text": "うん。うん。"}, {"type": "subtitle", "time": 7538.95, "timestamp": "02:05:38", "text": "こんにちは。ようこそ、おはようございます。"}, {"type": "subtitle", "time": 7540.51, "timestamp": "02:05:40", "text": "ハッピー"}, {"type": "subtitle", "time": 7543.709, "timestamp": "02:05:43", "text": "日。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 7551.39, "timestamp": "02:05:51", "text": "こんにちは。バッグ。"}, {"type": "subtitle", "time": 7554.55, "timestamp": "02:05:54", "text": "わかった。ああ、ゾンビだ。"}]
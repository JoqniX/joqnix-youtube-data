[{"type": "subtitle", "time": 20222.548, "timestamp": "05:37:02", "text": "ポートフォリオ。好きになるはずだったのに"}, {"type": "subtitle", "time": 20225.51, "timestamp": "05:37:05", "text": "索具があるような感じ。だから私は"}, {"type": "subtitle", "time": 20228.07, "timestamp": "05:37:08", "text": "アニメーションを作るために、でも、まあ、私はただ"}, {"type": "subtitle", "time": 20231.43, "timestamp": "05:37:11", "text": "現在、計量リストに載っています。"}, {"type": "subtitle", "time": 20234.708, "timestamp": "05:37:14", "text": "デビューするのが待ちきれない"}, {"type": "subtitle", "time": 20237.27, "timestamp": "05:37:17", "text": "モデルとか、そういうの全部含めて、ですよね？"}, {"type": "subtitle", "time": 20239.51, "timestamp": "05:37:19", "text": "えっと、私はそうは思わない"}, {"type": "subtitle", "time": 20242.52, "timestamp": "05:37:22", "text": "実際それは"}, {"type": "subtitle", "time": 20244.788, "timestamp": "05:37:24", "text": "[音楽]"}, {"type": "subtitle", "time": 20254.07, "timestamp": "05:37:34", "text": "そうそう。えーっと、その中のどれか"}, {"type": "subtitle", "time": 20256.31, "timestamp": "05:37:36", "text": "私が考えているストリーミングのアイデアは、私自身に似ています"}, {"type": "subtitle", "time": 20259.51, "timestamp": "05:37:39", "text": "ウェブ上の曲を読む。ああ、そうですね。唯一の"}, {"type": "subtitle", "time": 20263.43, "timestamp": "05:37:43", "text": "うん。ストリーミング配信しても大丈夫でしょうか？"}, {"type": "subtitle", "time": 20264.948, "timestamp": "05:37:44", "text": "それ？"}, {"type": "subtitle", "time": 20267.19, "timestamp": "05:37:47", "text": "それでおしまい。それって著作権みたいなもんじゃない？"}, {"type": "subtitle", "time": 20270.548, "timestamp": "05:37:50", "text": "オムニシエントリーダーを読めますか？"}, {"type": "subtitle", "time": 20273.51, "timestamp": "05:37:53", "text": "ここ？大丈夫でしょうか？私は"}, {"type": "subtitle", "time": 20277.75, "timestamp": "05:37:57", "text": "ストリーマーはそうする。私はそう思うのですが"}]
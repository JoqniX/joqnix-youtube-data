[{"type": "subtitle", "time": 9661.83, "timestamp": "02:41:01", "text": "もうすぐフェルドクラフトに行くので、見てみます"}, {"type": "subtitle", "time": 9663.67, "timestamp": "02:41:03", "text": "現地でお会いできるのを楽しみにしています。ただ"}, {"type": "subtitle", "time": 9666.15, "timestamp": "02:41:06", "text": "ホグワーツの南。ところで、希望"}, {"type": "subtitle", "time": 9668.95, "timestamp": "02:41:08", "text": "ブラスターの扱いは上手ですね。"}, {"type": "subtitle", "time": 9679.15, "timestamp": "02:41:19", "text": "こんにちは。私たちが行く前に"}, {"type": "subtitle", "time": 9688.03, "timestamp": "02:41:28", "text": "装備はたくさん揃ってるよね？それで、"}, {"type": "subtitle", "time": 9695.79, "timestamp": "02:41:35", "text": "えーと"}, {"type": "subtitle", "time": 9702.23, "timestamp": "02:41:42", "text": "ああ、わかりました。残りのすべてを売ることができます"}, {"type": "subtitle", "time": 9707.23, "timestamp": "02:41:47", "text": "[音楽]"}]
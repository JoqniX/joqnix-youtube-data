[{"type": "subtitle", "time": 20882.03, "timestamp": "05:48:02", "text": "去った。しかし"}, {"type": "subtitle", "time": 20885.51, "timestamp": "05:48:05", "text": "うん、定番だね。うん。"}, {"type": "subtitle", "time": 20888.31, "timestamp": "05:48:08", "text": "うん、それはちょっと大変そうだね。"}, {"type": "subtitle", "time": 20891.03, "timestamp": "05:48:11", "text": "ブッチとロックは本当にどう"}, {"type": "subtitle", "time": 20893.51, "timestamp": "05:48:13", "text": "あなたは本当に共感できると言うが、私は"}, {"type": "subtitle", "time": 20896.07, "timestamp": "05:48:16", "text": "隠れる場所がない"}, {"type": "subtitle", "time": 20902.47, "timestamp": "05:48:22", "text": "それに、もしあなたが日本にいるなら、"}, {"type": "subtitle", "time": 20904.788, "timestamp": "05:48:24", "text": "もしあなたが、もしあなたが"}, {"type": "subtitle", "time": 20907.27, "timestamp": "05:48:27", "text": "歌ってコカインをやる、これがある"}, {"type": "subtitle", "time": 20910.07, "timestamp": "05:48:30", "text": "Joy Sound というソフトウェアまたはアプリケーション"}, {"type": "subtitle", "time": 20913.43, "timestamp": "05:48:33", "text": "もしくは、ストリーマー向けのkokに関する何か。それで、"}, {"type": "subtitle", "time": 20915.35, "timestamp": "05:48:35", "text": "いずれ行くことになると思うので"}, {"type": "subtitle", "time": 20917.67, "timestamp": "05:48:37", "text": "日本に行くには、"}, {"type": "subtitle", "time": 20921.03, "timestamp": "05:48:41", "text": "Steamの所在地は日本ですよね？店"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "日本の場所に移動して、ついに"}, {"type": "subtitle", "time": 20926.948, "timestamp": "05:48:46", "text": "それにアクセスして、やっと"}, {"type": "subtitle", "time": 20932.47, "timestamp": "05:48:52", "text": "はい。えっと、そこでライブ配信をするんです。"}, {"type": "subtitle", "time": 20935.35, "timestamp": "05:48:55", "text": "うん、コックのことはできるから、しないよ"}, {"type": "subtitle", "time": 20938.31, "timestamp": "05:48:58", "text": "著作権侵害警告とか何か"}]
[{"type": "subtitle", "time": 17881.03, "timestamp": "04:58:01", "text": "歌声が響く小川が一つできるだろう。二。"}, {"type": "subtitle", "time": 17882.07, "timestamp": "04:58:02", "text": "待って、待って、待って。何が"}, {"type": "subtitle", "time": 17884.03, "timestamp": "04:58:04", "text": "今回は私のためにお店を買ってくれますか？"}, {"type": "subtitle", "time": 17887.15, "timestamp": "04:58:07", "text": "2つの歌"}, {"type": "subtitle", "time": 17890.67, "timestamp": "04:58:10", "text": "sh なぜ壊せないの？"}, {"type": "subtitle", "time": 17893.27, "timestamp": "04:58:13", "text": "待って。一つは歌の練習で、"}, {"type": "subtitle", "time": 17895.11, "timestamp": "04:58:15", "text": "コカエビではありません。それを覚えておいてください。私たちは"}, {"type": "subtitle", "time": 17897.43, "timestamp": "04:58:17", "text": "たった1曲だけ練習するつもりです"}, {"type": "subtitle", "time": 17905.67, "timestamp": "04:58:25", "text": "二。ええと、２は、ええと、デュアル言語ストリームです。"}, {"type": "subtitle", "time": 17909.67, "timestamp": "04:58:29", "text": "私たちは実際に中国語を学んでいるのかもしれません。"}, {"type": "subtitle", "time": 17913.31, "timestamp": "04:58:33", "text": "日本人ではない。日本語で1つずつやります"}, {"type": "subtitle", "time": 17918.35, "timestamp": "04:58:38", "text": "日。いつか日本語を勉強しよう。しかし、"}, {"type": "subtitle", "time": 17923.39, "timestamp": "04:58:43", "text": "欲しい"}, {"type": "subtitle", "time": 17930.99, "timestamp": "04:58:50", "text": "優先度。それから"}, {"type": "subtitle", "time": 17933.65, "timestamp": "04:58:53", "text": "えっと、それは2つですよね？ ３人は"}, {"type": "subtitle", "time": 17935.15, "timestamp": "04:58:55", "text": "[音楽]"}]
[{"type": "subtitle", "time": 20581.27, "timestamp": "05:43:01", "text": "だからノートパソコンを手に入れなければならない"}, {"type": "subtitle", "time": 20583.67, "timestamp": "05:43:03", "text": "初め。いいえ、ストリーミング配信ができるからです。"}, {"type": "subtitle", "time": 20585.99, "timestamp": "05:43:05", "text": "音楽、すべて、仕事と勉強、"}, {"type": "subtitle", "time": 20588.23, "timestamp": "05:43:08", "text": "すべて。"}, {"type": "subtitle", "time": 20591.75, "timestamp": "05:43:11", "text": "うん。彼はラップトップを手に入れたのか、それとも私は"}, {"type": "subtitle", "time": 20594.23, "timestamp": "05:43:14", "text": "購入予定ですか？購入予定"}, {"type": "subtitle", "time": 20597.11, "timestamp": "05:43:17", "text": "そこには。そうだよ、たぶん君だよ"}, {"type": "subtitle", "time": 20599.75, "timestamp": "05:43:19", "text": "少なくとも、"}, {"type": "subtitle", "time": 20603.35, "timestamp": "05:43:23", "text": "好きなモデルを修正する"}, {"type": "subtitle", "time": 20607.35, "timestamp": "05:43:27", "text": "行く前に少なくとも買っておく。うん。"}, {"type": "subtitle", "time": 20609.43, "timestamp": "05:43:29", "text": "うん。そこで購入する予定ですか？"}, {"type": "subtitle", "time": 20611.75, "timestamp": "05:43:31", "text": "それから？うん、そこで買えばいいよ。だから、"}, {"type": "subtitle", "time": 20613.83, "timestamp": "05:43:33", "text": "アカデミー、ここからの地元のアカデミー、"}, {"type": "subtitle", "time": 20616.628, "timestamp": "05:43:36", "text": "彼らは、"}, {"type": "subtitle", "time": 20620.23, "timestamp": "05:43:40", "text": "えっと、私が"}, {"type": "subtitle", "time": 20624.23, "timestamp": "05:43:44", "text": "日本に着陸すると、彼らは"}, {"type": "subtitle", "time": 20628.548, "timestamp": "05:43:48", "text": "私と一緒にお店に行って、一緒に"}, {"type": "subtitle", "time": 20631.31, "timestamp": "05:43:51", "text": "えっと、買う"}, {"type": "subtitle", "time": 20635.11, "timestamp": "05:43:55", "text": "あれ。こんにちは、つまり、こんにちはと言ってください。"}, {"type": "subtitle", "time": 20637.83, "timestamp": "05:43:57", "text": "日本で買った方が安いだろう。はい。"}]
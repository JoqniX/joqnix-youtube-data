[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "実際の動画。私たちは"}, {"type": "subtitle", "time": 4565.03, "timestamp": "01:16:05", "text": "ペンを取り出し、別の獣を選択します。そして"}, {"type": "subtitle", "time": 4568.149, "timestamp": "01:16:08", "text": "餌を与える際は十分注意してください。"}, {"type": "subtitle", "time": 4571.75, "timestamp": "01:16:11", "text": "彼らをきちんと手入れする。スウィーティングさん、なぜあなたは"}, {"type": "subtitle", "time": 4574.149, "timestamp": "01:16:14", "text": "私たちの新しい生徒に麻疹を見せて"}, {"type": "subtitle", "time": 4576.55, "timestamp": "01:16:16", "text": "一番遠い檻？"}, {"type": "subtitle", "time": 4578.55, "timestamp": "01:16:18", "text": "わかった。こちらです。麻疹は終息しました"}, {"type": "subtitle", "time": 4592.07, "timestamp": "01:16:32", "text": "何てことだ。ああ、膝をいくつか、または"}, {"type": "subtitle", "time": 4594.39, "timestamp": "01:16:34", "text": "少なくとも何かを買うのに十分な金額"}, {"type": "subtitle", "time": 4597.51, "timestamp": "01:16:37", "text": "ハニー・ジェスより。"}, {"type": "subtitle", "time": 4612.709, "timestamp": "01:16:52", "text": "何をしているんですか？ああ、なんてことだ。"}, {"type": "subtitle", "time": 4616.95, "timestamp": "01:16:56", "text": "ああ、なんてことだ。あなた。彼女の名前は"}, {"type": "subtitle", "time": 4618.79, "timestamp": "01:16:58", "text": "ファニー。"}]
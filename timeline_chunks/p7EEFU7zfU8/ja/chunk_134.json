[{"type": "subtitle", "time": 8040.79, "timestamp": "02:14:00", "text": "ハプニング？ジャンプ。それほど簡単にジャンプできるんです。"}, {"type": "subtitle", "time": 8048.629, "timestamp": "02:14:08", "text": "わかった。"}, {"type": "subtitle", "time": 8051.43, "timestamp": "02:14:11", "text": "何てことだ。"}, {"type": "subtitle", "time": 8054.83, "timestamp": "02:14:14", "text": "蛾を玄関に連れてこなくてはならない。"}, {"type": "subtitle", "time": 8066.47, "timestamp": "02:14:26", "text": "だから、あと2つ手に入れるのが私の考えなんです。"}, {"type": "subtitle", "time": 8070.39, "timestamp": "02:14:30", "text": "だから私は、"}, {"type": "subtitle", "time": 8073.229, "timestamp": "02:14:33", "text": "あそこのあの物を回す"}, {"type": "subtitle", "time": 8078.669, "timestamp": "02:14:38", "text": "スピン。だから、私は、えっと、"}, {"type": "subtitle", "time": 8093.35, "timestamp": "02:14:53", "text": "神。そして"}]
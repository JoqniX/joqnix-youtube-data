[{"type": "subtitle", "time": 5401.51, "timestamp": "01:30:01", "text": "ここで、彼が仕事をしているのを見かけるかもしれません。"}, {"type": "subtitle", "time": 5404.87, "timestamp": "01:30:04", "text": "ホッグス・ヘッドにて。彼は信頼できる金属です"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "トレーラー。わかった。私たちが話したことを話した。"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "彼が魔女を警戒するのは当然のことだ"}, {"type": "subtitle", "time": 5413.51, "timestamp": "01:30:13", "text": "そして魔法使いも、君と同じくらい若い魔法使いもいる。"}, {"type": "subtitle", "time": 5415.03, "timestamp": "01:30:15", "text": "とはいえ、もしあなたが探しているなら"}, {"type": "subtitle", "time": 5416.95, "timestamp": "01:30:16", "text": "レンロックに関する情報は、彼を抑えるのに役立ちます"}, {"type": "subtitle", "time": 5420.31, "timestamp": "01:30:20", "text": "そこへ行けば、ロドゴクという味方が見つかるでしょう。"}, {"type": "subtitle", "time": 5423.43, "timestamp": "01:30:23", "text": "わかった。ありがとう。"}, {"type": "subtitle", "time": 5426.629, "timestamp": "01:30:26", "text": "ありがとう、セレナ。ゴク卿を見つけたら、"}, {"type": "subtitle", "time": 5429.43, "timestamp": "01:30:29", "text": "彼によろしくお伝えください。彼に私の"}, {"type": "subtitle", "time": 5431.03, "timestamp": "01:30:31", "text": "最高。わかった。あなたが何をしたのかわかりません"}, {"type": "subtitle", "time": 5434.43, "timestamp": "01:30:34", "text": "このような強力な敵を作るために行われたが、"}, {"type": "subtitle", "time": 5440.75, "timestamp": "01:30:40", "text": "あなた"}, {"type": "subtitle", "time": 5454.189, "timestamp": "01:30:54", "text": "すみません、入ってもいいですか？"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "うん。ああ、ここは一体どこなの？まるで"}]
[{"type": "subtitle", "time": 7261.189, "timestamp": "02:01:01", "text": "胸。ああ、満員だ。あ、待って。えっと、"}, {"type": "subtitle", "time": 7263.669, "timestamp": "02:01:03", "text": "ちょっと、何か捨てなきゃいけないものがあるんです。"}, {"type": "subtitle", "time": 7265.39, "timestamp": "02:01:05", "text": "捨てる"}, {"type": "subtitle", "time": 7274.39, "timestamp": "02:01:14", "text": "自分が何をしたのか分からない。冗談ですか"}, {"type": "subtitle", "time": 7278.589, "timestamp": "02:01:18", "text": "自分？すべては青いアイテムのためだった。ああ、"}, {"type": "subtitle", "time": 7282.75, "timestamp": "02:01:22", "text": "神。このゲームは寛大ではありません"}, {"type": "subtitle", "time": 7285.55, "timestamp": "02:01:25", "text": "そうみたいだ。"}, {"type": "subtitle", "time": 7289.07, "timestamp": "02:01:29", "text": "何？完全に完成させたい"}, {"type": "subtitle", "time": 7293.73, "timestamp": "02:01:33", "text": "これ。私は高価なホッグを使いたい。"}, {"type": "subtitle", "time": 7305.43, "timestamp": "02:01:45", "text": "ああ、奇妙な理由で"}, {"type": "subtitle", "time": 7319.99, "timestamp": "02:01:59", "text": "歌。私は本当に少なくとも"}]
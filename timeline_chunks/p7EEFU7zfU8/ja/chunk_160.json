[{"type": "subtitle", "time": 9601.429, "timestamp": "02:40:01", "text": "心地よいそよ風。私は"}, {"type": "subtitle", "time": 9603.27, "timestamp": "02:40:03", "text": "ハウイン教授が何かを考えている"}, {"type": "subtitle", "time": 9605.91, "timestamp": "02:40:05", "text": "獣の授業で言った。私は勉強しなければならない"}, {"type": "subtitle", "time": 9609.429, "timestamp": "02:40:09", "text": "多くは自分の時間を使って行った。彼女はまた、"}, {"type": "subtitle", "time": 9611.11, "timestamp": "02:40:11", "text": "密猟者が活動している"}, {"type": "subtitle", "time": 9613.83, "timestamp": "02:40:13", "text": "エリア。そうすれば獣はより安全になるかもしれない"}, {"type": "subtitle", "time": 9615.51, "timestamp": "02:40:15", "text": "彼らにとって、私たちと一緒にいる方が、一人でいるよりもずっと良い。"}, {"type": "subtitle", "time": 9617.67, "timestamp": "02:40:17", "text": "真実。まさにディープの本質そのものだった。うん。"}, {"type": "subtitle", "time": 9620.23, "timestamp": "02:40:20", "text": "こんにちは。ほら、リラックスしなさい、息子よ。願っています"}, {"type": "subtitle", "time": 9623.11, "timestamp": "02:40:23", "text": "あなたはよくやっています。そして幸運なことに、デは"}, {"type": "subtitle", "time": 9627.09, "timestamp": "02:40:27", "text": "誰にも俺の[ __ ]を見せないようにする方法を教えてやるよ。そして"}, {"type": "subtitle", "time": 9634.87, "timestamp": "02:40:34", "text": "では、その後はどこへ？私は待つことになっている。やめてください。"}, {"type": "subtitle", "time": 9638.389, "timestamp": "02:40:38", "text": "ああ、神様。まず最初に立ち寄ります。ちょっと待って。"}, {"type": "subtitle", "time": 9640.389, "timestamp": "02:40:40", "text": "わかった。 3本のほうきのそばに立ち寄ってください"}, {"type": "subtitle", "time": 9643.67, "timestamp": "02:40:43", "text": "あなたはできる。とりあえず、これらの装備を全部揃えましょう"}, {"type": "subtitle", "time": 9646.15, "timestamp": "02:40:46", "text": "荷物が揃ったら、私も一緒に行きます。ただ"}, {"type": "subtitle", "time": 9647.55, "timestamp": "02:40:47", "text": "待って。"}, {"type": "subtitle", "time": 9652.469, "timestamp": "02:40:52", "text": "わかった。えーと置きます"}, {"type": "subtitle", "time": 9654.389, "timestamp": "02:40:54", "text": "先ほど申し上げたように、私の妹と奥様。"}, {"type": "subtitle", "time": 9656.55, "timestamp": "02:40:56", "text": "ホグワーツ。彼女はいつもの彼女らしくない。私"}, {"type": "subtitle", "time": 9658.389, "timestamp": "02:40:58", "text": "必要な分量。ぜひお願いしたいのですが"}, {"type": "subtitle", "time": 9659.91, "timestamp": "02:40:59", "text": "私と一緒に彼女を訪ねるというあなたの約束。私は"}]
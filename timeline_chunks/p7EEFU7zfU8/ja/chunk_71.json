[{"type": "subtitle", "time": 4280.87, "timestamp": "01:11:20", "text": "なぜ？ビーストクロースはこんな感じだと思う"}, {"type": "subtitle", "time": 4284.83, "timestamp": "01:11:24", "text": "外。そうそう。もう終わったってわかってる"}, {"type": "subtitle", "time": 4288.149, "timestamp": "01:11:28", "text": "ここ。こんにちは。あ、待って。私は着ていません"}, {"type": "subtitle", "time": 4290.189, "timestamp": "01:11:30", "text": "スーツ。ああ、"}, {"type": "subtitle", "time": 4293.51, "timestamp": "01:11:33", "text": "神。私は特定のものを着ることになっている"}, {"type": "subtitle", "time": 4297.03, "timestamp": "01:11:37", "text": "川遊びに適した服装をしてください。ああ、こんにちは。"}, {"type": "subtitle", "time": 4309.59, "timestamp": "01:11:49", "text": "忘れた。いや、そうではないと思う。知ってる？"}, {"type": "subtitle", "time": 4313.03, "timestamp": "01:11:53", "text": "は？そうそう。あなたも。ああ、そうだね。そうそう。"}, {"type": "subtitle", "time": 4314.189, "timestamp": "01:11:54", "text": "うん。"}, {"type": "subtitle", "time": 4317.03, "timestamp": "01:11:57", "text": "昨日、私はこれを読んでいました"}]
[{"type": "subtitle", "time": 12661.349, "timestamp": "03:31:01", "text": "私の友人ドロシー・スプラットルへの好意"}, {"type": "subtitle", "time": 12665.51, "timestamp": "03:31:05", "text": "アッパーホークフィールドにて。 H 私は信じません"}, {"type": "subtitle", "time": 12668.469, "timestamp": "03:31:08", "text": "彼女は素敵だ。彼女の亡くなった夫エイデンは"}, {"type": "subtitle", "time": 12671.11, "timestamp": "03:31:11", "text": "父の友人。実際、私は"}, {"type": "subtitle", "time": 12672.71, "timestamp": "03:31:12", "text": "夏の間、ドットとエイデンと一緒に過ごした"}, {"type": "subtitle", "time": 12675.349, "timestamp": "03:31:15", "text": "学生時代にここでウェイトレスとして働いていました。私は"}, {"type": "subtitle", "time": 12678.15, "timestamp": "03:31:18", "text": "エイデンが亡くなってから彼女に何度か会った。"}, {"type": "subtitle", "time": 12680.71, "timestamp": "03:31:20", "text": "でも最近パブはすごく忙しいので、"}, {"type": "subtitle", "time": 12684.309, "timestamp": "03:31:24", "text": "思ったほど注意を払っていなかった。"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "ちょっと立ち寄って彼女に会いに行ってみて。幸せで良い"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "午後。材料を集めています"}, {"type": "subtitle", "time": 12690.07, "timestamp": "03:31:30", "text": "彼女がこれをうまくやるために"}, {"type": "subtitle", "time": 12692.389, "timestamp": "03:31:32", "text": "午後。そしてあなたは取り戻すことができます"}, {"type": "subtitle", "time": 12696.15, "timestamp": "03:31:36", "text": "その過程で、私自身の何かが加わった。箱"}, {"type": "subtitle", "time": 12702.95, "timestamp": "03:31:42", "text": "立ち寄ってみようかな。行ってみます"}, {"type": "subtitle", "time": 12704.87, "timestamp": "03:31:44", "text": "できる限り彼女に会いに行く。それはつまり"}, {"type": "subtitle", "time": 12707.99, "timestamp": "03:31:47", "text": "私にとってもドロシーにとっても、世界はそうだった。エイデンは"}, {"type": "subtitle", "time": 12709.349, "timestamp": "03:31:49", "text": "手紙の箱を私に持ってきてくれたとき"}, {"type": "subtitle", "time": 12711.75, "timestamp": "03:31:51", "text": "彼は病気になった。ドットは、"}, {"type": "subtitle", "time": 12715.19, "timestamp": "03:31:55", "text": "彼はそれを落としたのかもしれない。わかった。あなたは"}, {"type": "subtitle", "time": 12717.91, "timestamp": "03:31:57", "text": "ホグスメのすぐ北にある小さな集落を探してください。"}]
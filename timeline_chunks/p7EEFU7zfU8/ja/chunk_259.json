[{"type": "subtitle", "time": 15542.189, "timestamp": "04:19:02", "text": "[拍手]"}, {"type": "subtitle", "time": 15547.51, "timestamp": "04:19:07", "text": "ヒキガエルを捕まえたぞ。私の新しいペット。"}, {"type": "subtitle", "time": 15549.149, "timestamp": "04:19:09", "text": "すべて順調です"}, {"type": "subtitle", "time": 15561.71, "timestamp": "04:19:21", "text": "反乱。"}, {"type": "subtitle", "time": 15585.63, "timestamp": "04:19:45", "text": "[拍手]"}, {"type": "subtitle", "time": 15588.71, "timestamp": "04:19:48", "text": "神。隠れることはできない。走る。でもできない"}, {"type": "subtitle", "time": 15593.71, "timestamp": "04:19:53", "text": "ハワード教授は決して信じないだろう"}]
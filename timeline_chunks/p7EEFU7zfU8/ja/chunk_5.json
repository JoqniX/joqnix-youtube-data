[{"type": "subtitle", "time": 312.45, "timestamp": "00:05:12", "text": "それ。よし、いいぞ。"}, {"type": "subtitle", "time": 314.71, "timestamp": "00:05:14", "text": "[音楽]"}, {"type": "subtitle", "time": 316.59, "timestamp": "00:05:16", "text": "A"}, {"type": "subtitle", "time": 339.11, "timestamp": "00:05:39", "text": "うふ、こおじ。クージー。ロク。クージ。右。"}, {"type": "subtitle", "time": 342.469, "timestamp": "00:05:42", "text": "そう、クージーって発音するんだよ。"}, {"type": "subtitle", "time": 345.23, "timestamp": "00:05:45", "text": "えっと、ルーク。ええ、そうですね。"}, {"type": "subtitle", "time": 346.25, "timestamp": "00:05:46", "text": "クーイ"}, {"type": "subtitle", "time": 347.39, "timestamp": "00:05:47", "text": "[音楽]"}]
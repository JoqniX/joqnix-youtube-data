[{"type": "subtitle", "time": 10920.309, "timestamp": "03:02:00", "text": "部屋に戻る。はい。よし。デ"}, {"type": "subtitle", "time": 10921.99, "timestamp": "03:02:01", "text": "部屋でお会いしましょう"}, {"type": "subtitle", "time": 10925.11, "timestamp": "03:02:05", "text": "準備は万端です。"}, {"type": "subtitle", "time": 10932.92, "timestamp": "03:02:12", "text": "へま。ああ、そうだね。"}, {"type": "subtitle", "time": 10958.03, "timestamp": "03:02:38", "text": "[音楽]"}, {"type": "subtitle", "time": 10960.95, "timestamp": "03:02:40", "text": "要件。そこにいたんですね。今、私たちは"}, {"type": "subtitle", "time": 10963.11, "timestamp": "03:02:43", "text": "あなたが救出した獣に新しい"}, {"type": "subtitle", "time": 10966.07, "timestamp": "03:02:46", "text": "家。はい、"}, {"type": "subtitle", "time": 10969.03, "timestamp": "03:02:49", "text": "でも、彼らを外に出すにはスペースが足りない"}, {"type": "subtitle", "time": 10971.19, "timestamp": "03:02:51", "text": "ここ。では、それらの獣たちを想像してみてください"}, {"type": "subtitle", "time": 10973.19, "timestamp": "03:02:53", "text": "モックを実行する"}, {"type": "subtitle", "time": 10974.51, "timestamp": "03:02:54", "text": "で"}, {"type": "subtitle", "time": 10977.269, "timestamp": "03:02:57", "text": "全て。おそらく、あなたの"}]
[{"type": "subtitle", "time": 2883.95, "timestamp": "00:48:03", "text": "じゃあ、私は何をすればいいの？"}, {"type": "subtitle", "time": 2887.03, "timestamp": "00:48:07", "text": "する？何を書くのか？物は何ですか"}, {"type": "subtitle", "time": 2890.069, "timestamp": "00:48:10", "text": "あなたの町にも？ ３つを使って書いてください。"}, {"type": "subtitle", "time": 2898.27, "timestamp": "00:48:18", "text": "について？えっと、富士山。待って。"}, {"type": "subtitle", "time": 2905.23, "timestamp": "00:48:25", "text": "フジマチフフジマチニ。富士町。"}, {"type": "subtitle", "time": 2907.71, "timestamp": "00:48:27", "text": "富士山"}, {"type": "subtitle", "time": 2911.589, "timestamp": "00:48:31", "text": "フォーラム。待って、よく分からなかった。どれの"}, {"type": "subtitle", "time": 2914.589, "timestamp": "00:48:34", "text": "マチ？どの村ですか？どれどれどれ"}, {"type": "subtitle", "time": 2918.23, "timestamp": "00:48:38", "text": "県？富士。ふこか。福岡ですか？"}, {"type": "subtitle", "time": 2920.63, "timestamp": "00:48:40", "text": "富士山について言及があれば、"}, {"type": "subtitle", "time": 2928.63, "timestamp": "00:48:48", "text": "信じる。そして私は同じものを使う"}, {"type": "subtitle", "time": 2929.53, "timestamp": "00:48:49", "text": "例"}, {"type": "subtitle", "time": 2932.589, "timestamp": "00:48:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2935.15, "timestamp": "00:48:55", "text": "えっと"}]
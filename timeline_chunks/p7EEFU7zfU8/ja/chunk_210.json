[{"type": "subtitle", "time": 12615.99, "timestamp": "03:30:15", "text": "あなたが来てうれしい"}, {"type": "subtitle", "time": 12620.28, "timestamp": "03:30:20", "text": "不思議。"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "[音楽]"}, {"type": "subtitle", "time": 12626.07, "timestamp": "03:30:26", "text": "こんにちは。こんにちは、セローナ。私は受け取りました"}, {"type": "subtitle", "time": 12629.51, "timestamp": "03:30:29", "text": "あなたのフクロウ。元気ですか？こんにちは、友よ。"}, {"type": "subtitle", "time": 12632.229, "timestamp": "03:30:32", "text": "ログは見つかりましたか？"}, {"type": "subtitle", "time": 12635.67, "timestamp": "03:30:35", "text": "ええ、私は話しました。ありがとう。私たちは"}, {"type": "subtitle", "time": 12637.75, "timestamp": "03:30:37", "text": "良い会話ができた。彼はあなたを"}, {"type": "subtitle", "time": 12640.389, "timestamp": "03:30:40", "text": "彼の最高傑作。それは良かったです。"}, {"type": "subtitle", "time": 12642.63, "timestamp": "03:30:42", "text": "あなたの小さな詳細を尋ねます"}, {"type": "subtitle", "time": 12645.349, "timestamp": "03:30:45", "text": "チャットして、あなたには言わないようにします"}, {"type": "subtitle", "time": 12648.469, "timestamp": "03:30:48", "text": "改めて注意が必要だ。でも、あなたが"}, {"type": "subtitle", "time": 12652.95, "timestamp": "03:30:52", "text": "それはあなたの計画次第です。もちろん"}, {"type": "subtitle", "time": 12654.63, "timestamp": "03:30:54", "text": "あなたは私の助けが必要だと言いました"}, {"type": "subtitle", "time": 12657.59, "timestamp": "03:30:57", "text": "何かと共に。私はします。知っている。私は思った"}, {"type": "subtitle", "time": 12659.429, "timestamp": "03:30:59", "text": "あなたはまさに、"}]
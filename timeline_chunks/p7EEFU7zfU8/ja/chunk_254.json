[{"type": "subtitle", "time": 15241.11, "timestamp": "04:14:01", "text": "そして、戻るつもりは全くない。しかし"}, {"type": "subtitle", "time": 15244.469, "timestamp": "04:14:04", "text": "何？いや、そんなはずはない。彼は"}, {"type": "subtitle", "time": 15247.429, "timestamp": "04:14:07", "text": "彼らに助言を求めただけです。私は"}, {"type": "subtitle", "time": 15250.59, "timestamp": "04:14:10", "text": "本当に申し訳ありません。もっと良ければよかったのに"}, {"type": "subtitle", "time": 15257.79, "timestamp": "04:14:17", "text": "ああ、彼女は泣いている。"}, {"type": "subtitle", "time": 15267.349, "timestamp": "04:14:27", "text": "彼女はすっかり元気になった。何？ひどい状態だ。私の"}, {"type": "subtitle", "time": 15271.349, "timestamp": "04:14:31", "text": "愛する、愛する兄よ。"}, {"type": "subtitle", "time": 15273.67, "timestamp": "04:14:33", "text": "「こんにちは、ブモント夫人」が懐かしいです。良い"}, {"type": "subtitle", "time": 15275.91, "timestamp": "04:14:35", "text": "ニュース。私はランロックの"}, {"type": "subtitle", "time": 15279.269, "timestamp": "04:14:39", "text": "キャンプ。それらを片付けたのですか？どうやって？私はそうしました"}, {"type": "subtitle", "time": 15282.309, "timestamp": "04:14:42", "text": "全員死ぬ。それは恐ろしい出来事で、彼らは掘りました"}, {"type": "subtitle", "time": 15285.67, "timestamp": "04:14:45", "text": "彼らのハイヒールに追いつかれたが、なんとかやり遂げた。ああ、私は"}, {"type": "subtitle", "time": 15287.189, "timestamp": "04:14:47", "text": "兄があなたと同じことができたらよかったのに"}, {"type": "subtitle", "time": 15289.91, "timestamp": "04:14:49", "text": "した。もしかしたら、彼は今も私のそばにいてくれたかもしれない。"}, {"type": "subtitle", "time": 15292.79, "timestamp": "04:14:52", "text": "特に感謝しています。あなたは"}, {"type": "subtitle", "time": 15295.59, "timestamp": "04:14:55", "text": "私にはできなかったことを、吟遊詩人に。あなたは私たちの"}, {"type": "subtitle", "time": 15297.91, "timestamp": "04:14:57", "text": "ハムレットよ、私の若い友よ。これは"}]
[{"type": "subtitle", "time": 7081.109, "timestamp": "01:58:01", "text": "これら。おお。おお。おお。おお。わかった。"}, {"type": "subtitle", "time": 7084.31, "timestamp": "01:58:04", "text": "秋生なら助けてくれるかもしれない。 A. 待ってください。ああ。"}, {"type": "subtitle", "time": 7087.669, "timestamp": "01:58:07", "text": "アコって何だったっけ？この男。わかった。それで"}, {"type": "subtitle", "time": 7090.43, "timestamp": "01:58:10", "text": "つまり私は"}, {"type": "subtitle", "time": 7095.07, "timestamp": "01:58:15", "text": "追い払う。いいえ。"}, {"type": "subtitle", "time": 7098.189, "timestamp": "01:58:18", "text": "えっと、待って。どうすればいいの？"}, {"type": "subtitle", "time": 7100.95, "timestamp": "01:58:20", "text": "うん。うん。うん。すべてを手に入れよう"}, {"type": "subtitle", "time": 7104.669, "timestamp": "01:58:24", "text": "隠されていた秘密が明らかになった。それが私の仕事です。"}, {"type": "subtitle", "time": 7110.109, "timestamp": "01:58:30", "text": "わかった。隠された秘密をすべて暴き出せ。"}, {"type": "subtitle", "time": 7112.87, "timestamp": "01:58:32", "text": "わかった。だから私が理解したことの一つは"}, {"type": "subtitle", "time": 7114.83, "timestamp": "01:58:34", "text": "この"}, {"type": "subtitle", "time": 7119.229, "timestamp": "01:58:39", "text": "男は他の全員を引き付ける"}, {"type": "subtitle", "time": 7122.79, "timestamp": "01:58:42", "text": "骨も。"}, {"type": "subtitle", "time": 7124.589, "timestamp": "01:58:44", "text": "もし私が使うなら"}, {"type": "subtitle", "time": 7131.189, "timestamp": "01:58:51", "text": "ここは実際に人を惹きつける場所なのだろうか？それ"}, {"type": "subtitle", "time": 7137.669, "timestamp": "01:58:57", "text": "わかった。私は、"}]
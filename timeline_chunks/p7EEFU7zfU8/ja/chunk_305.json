[{"type": "subtitle", "time": 18308.03, "timestamp": "05:05:08", "text": "大丈夫。"}, {"type": "subtitle", "time": 18310.83, "timestamp": "05:05:10", "text": "神。"}, {"type": "subtitle", "time": 18324.43, "timestamp": "05:05:24", "text": "[音楽]"}, {"type": "subtitle", "time": 18343.628, "timestamp": "05:05:43", "text": "今？月の背後にいる男。"}, {"type": "subtitle", "time": 18346.948, "timestamp": "05:05:46", "text": "ああ、わかった。外見。わかった。あなたが知っている"}, {"type": "subtitle", "time": 18350.23, "timestamp": "05:05:50", "text": "何？えっと、もう4時ですよ。大丈夫。"}, {"type": "subtitle", "time": 18353.27, "timestamp": "05:05:53", "text": "えっと、これを終わらせたいんです。それは"}, {"type": "subtitle", "time": 18355.15, "timestamp": "05:05:55", "text": "私が"}, {"type": "subtitle", "time": 18358.19, "timestamp": "05:05:58", "text": "この2つを所有しています。"}]
[{"type": "subtitle", "time": 13021.269, "timestamp": "03:37:01", "text": "またね。はい、そうしました。私はただ"}, {"type": "subtitle", "time": 13023.07, "timestamp": "03:37:03", "text": "クレア・ボウモントの弟のことを心配して、"}, {"type": "subtitle", "time": 13026.79, "timestamp": "03:37:06", "text": "吟遊詩人。ただ、彼だけが行方不明になった。噂によると"}, {"type": "subtitle", "time": 13028.95, "timestamp": "03:37:08", "text": "彼は森の中で練習しているところを目撃された。"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "闇の魔法。彼を近くで見た"}, {"type": "subtitle", "time": 13034.71, "timestamp": "03:37:14", "text": "ルークウッドの所有地にある遺跡。私は闇の魔法を使う。"}, {"type": "subtitle", "time": 13036.95, "timestamp": "03:37:16", "text": "彼はトラブルに巻き込まれたのではないかと心配しています"}, {"type": "subtitle", "time": 13039.51, "timestamp": "03:37:19", "text": "アシュウィンダーズ、特に彼が"}, {"type": "subtitle", "time": 13042.07, "timestamp": "03:37:22", "text": "彼は彼らに、守ることのできない約束をした。私は"}, {"type": "subtitle", "time": 13044.55, "timestamp": "03:37:24", "text": "自分で彼を探すのを手伝ったが、誰も"}, {"type": "subtitle", "time": 13046.87, "timestamp": "03:37:26", "text": "ランダムな事象に遭遇するリスクがあります。あ、待って。"}, {"type": "subtitle", "time": 13049.51, "timestamp": "03:37:29", "text": "誤ってサイドクエストを開始してしまった"}, {"type": "subtitle", "time": 13054.75, "timestamp": "03:37:34", "text": "なんてこった。確かに彼のことは気にかけています"}, {"type": "subtitle", "time": 13057.83, "timestamp": "03:37:37", "text": "どんなものでもありがたいです。あなたは、"}, {"type": "subtitle", "time": 13060.229, "timestamp": "03:37:40", "text": "まずはクレア。彼女には何か"}, {"type": "subtitle", "time": 13063.51, "timestamp": "03:37:43", "text": "私が持っていない洞察。あなたに伝えることができます"}, {"type": "subtitle", "time": 13066.07, "timestamp": "03:37:46", "text": "バードルフが最後に目撃されたのは森の中だった。"}, {"type": "subtitle", "time": 13069.11, "timestamp": "03:37:49", "text": "ある特定のウールのセーターを着て、"}, {"type": "subtitle", "time": 13073.269, "timestamp": "03:37:53", "text": "それはクラが自分で編んだものだ。わかった。"}, {"type": "subtitle", "time": 13075.03, "timestamp": "03:37:55", "text": "クレアはお店にいますので、もしよろしければ"}]
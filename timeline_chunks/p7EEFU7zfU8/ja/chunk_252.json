[{"type": "subtitle", "time": 15123.91, "timestamp": "04:12:03", "text": "ほうき。これを買います。実際、ありがとう"}, {"type": "subtitle", "time": 15131.59, "timestamp": "04:12:11", "text": "私は彼にいくつか商品を売った。"}, {"type": "subtitle", "time": 15135.2, "timestamp": "04:12:15", "text": "あなたとビジネスができることを願っています"}, {"type": "subtitle", "time": 15150.91, "timestamp": "04:12:30", "text": "また。私を見て。私は"}]
[{"type": "subtitle", "time": 20041.03, "timestamp": "05:34:01", "text": "再度設定します。はい、どうぞ。おい。"}, {"type": "subtitle", "time": 20043.43, "timestamp": "05:34:03", "text": "はい、ありがとうございます。"}, {"type": "subtitle", "time": 20046.548, "timestamp": "05:34:06", "text": "ありがとう。他に何かありますか？えっと、えっと、どうやって"}, {"type": "subtitle", "time": 20049.03, "timestamp": "05:34:09", "text": "あなたから友好的な準備をするべきでしょうか"}, {"type": "subtitle", "time": 20052.39, "timestamp": "05:34:12", "text": "経験？それは"}, {"type": "subtitle", "time": 20054.548, "timestamp": "05:34:14", "text": "今の私はまさに"}, {"type": "subtitle", "time": 20056.07, "timestamp": "05:34:16", "text": "自分なりの知識を身につける"}, {"type": "subtitle", "time": 20064.39, "timestamp": "05:34:24", "text": "ええ、まずは"}, {"type": "subtitle", "time": 20066.788, "timestamp": "05:34:26", "text": "手紙を書いて、"}, {"type": "subtitle", "time": 20070.15, "timestamp": "05:34:30", "text": "文法とか、そういうこと。いいえ、それは"}, {"type": "subtitle", "time": 20072.948, "timestamp": "05:34:32", "text": "調べる必要がある"}, {"type": "subtitle", "time": 20076.23, "timestamp": "05:34:36", "text": "粒子は、それをいつ使うかすべてです。"}, {"type": "subtitle", "time": 20079.11, "timestamp": "05:34:39", "text": "私はすでにたくさんの語彙を知っていて、"}, {"type": "subtitle", "time": 20081.43, "timestamp": "05:34:41", "text": "文法は文法のように、私が"}, {"type": "subtitle", "time": 20083.03, "timestamp": "05:34:43", "text": "アニメを見始めて7年くらい"}, {"type": "subtitle", "time": 20085.59, "timestamp": "05:34:45", "text": "年。文法の部分ですね"}, {"type": "subtitle", "time": 20090.99, "timestamp": "05:34:50", "text": "N5については、ある程度カバーされています。はい。そして"}, {"type": "subtitle", "time": 20095.59, "timestamp": "05:34:55", "text": "さらに、もっと読書をするように心がけてください。"}, {"type": "subtitle", "time": 20098.07, "timestamp": "05:34:58", "text": "わかった。多分私は好きになると思う"}, {"type": "subtitle", "time": 20099.99, "timestamp": "05:34:59", "text": "問題用紙を見始めるのは"}]
[{"type": "subtitle", "time": 17704.31, "timestamp": "04:55:04", "text": "ここに何かの動物がいる。"}, {"type": "subtitle", "time": 17708.19, "timestamp": "04:55:08", "text": "ああ、カエルたち。私は"}, {"type": "subtitle", "time": 17710.34, "timestamp": "04:55:10", "text": "彼ら。私はそうしなくても大丈夫だと思います"}, {"type": "subtitle", "time": 17711.948, "timestamp": "04:55:11", "text": "[音楽]"}, {"type": "subtitle", "time": 17731.59, "timestamp": "04:55:31", "text": "今。これらは全て馬鹿げた内容だ。わかった。"}, {"type": "subtitle", "time": 17742.51, "timestamp": "04:55:42", "text": "磔刑の費用"}, {"type": "subtitle", "time": 17744.51, "timestamp": "04:55:44", "text": "敵"}, {"type": "subtitle", "time": 17747.628, "timestamp": "04:55:47", "text": "愚かに追放する？"}, {"type": "subtitle", "time": 17749.948, "timestamp": "04:55:49", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 17754.27, "timestamp": "04:55:54", "text": "フレックスコスト敵レスト"}, {"type": "subtitle", "time": 17756.59, "timestamp": "04:55:56", "text": "呪文。"}]
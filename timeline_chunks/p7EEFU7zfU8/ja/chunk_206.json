[{"type": "subtitle", "time": 12382.55, "timestamp": "03:26:22", "text": "石投げの話といえば、そうですよね？"}, {"type": "subtitle", "time": 12384.269, "timestamp": "03:26:24", "text": "こんにちは。"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "昨日、もしあなたがドアに閉じ込められていたら"}, {"type": "subtitle", "time": 12389.429, "timestamp": "03:26:29", "text": "羽毛、それはかなり痛い。こんにちは。"}, {"type": "subtitle", "time": 12392.87, "timestamp": "03:26:32", "text": "昨日、石投げに挑戦してみました。"}, {"type": "subtitle", "time": 12395.429, "timestamp": "03:26:35", "text": "石投げの最高得点は"}, {"type": "subtitle", "time": 12397.51, "timestamp": "03:26:37", "text": "実際、その多くは"}, {"type": "subtitle", "time": 12400.309, "timestamp": "03:26:40", "text": "セントパトリックの商人。うん、わかるよ"}, {"type": "subtitle", "time": 12406.87, "timestamp": "03:26:46", "text": "どうやら悪い経験をしたようだ"}, {"type": "subtitle", "time": 12409.469, "timestamp": "03:26:49", "text": "誰かが私のキャンパスに髪の毛を送っている"}, {"type": "subtitle", "time": 12411.75, "timestamp": "03:26:51", "text": "猫。誰かだったに違いない"}, {"type": "subtitle", "time": 12413.99, "timestamp": "03:26:53", "text": "アメリカ、間違いなく、だって私たちは"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "ミアを飼っています。ところで、あなたはここで何をしているのですか？"}]
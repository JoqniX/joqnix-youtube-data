[{"type": "subtitle", "time": 14473.79, "timestamp": "04:01:13", "text": "それをどうやって騙せばいいのか分からない。わかった。"}, {"type": "subtitle", "time": 14477.189, "timestamp": "04:01:17", "text": "とにかく、夜になってきて、"}, {"type": "subtitle", "time": 14478.83, "timestamp": "04:01:18", "text": "私は行く必要があります"}, {"type": "subtitle", "time": 14506.63, "timestamp": "04:01:46", "text": "ランドロックの忠誠派は脅威だ。何"}, {"type": "subtitle", "time": 14509.75, "timestamp": "04:01:49", "text": "可能でしょうか？ああ、まずい。私は助けることができなかった"}, {"type": "subtitle", "time": 14512.87, "timestamp": "04:01:52", "text": "こっちへどうぞ。ランドロックについて言及しましたか？"}, {"type": "subtitle", "time": 14516.469, "timestamp": "04:01:56", "text": "忠誠派？はい、そうしました。彼らが"}, {"type": "subtitle", "time": 14518.469, "timestamp": "04:01:58", "text": "これほどまでに致命的な行動をとる。"}]
[{"type": "subtitle", "time": 17040.47, "timestamp": "04:44:00", "text": "私は持っていないことを知っています 私は持っていません"}, {"type": "subtitle", "time": 17042.868, "timestamp": "04:44:02", "text": "それと関係あることなら何でもいいけど、それでも私は"}, {"type": "subtitle", "time": 17045.11, "timestamp": "04:44:05", "text": "戦闘力を上げる必要があるだけです"}, {"type": "subtitle", "time": 17052.67, "timestamp": "04:44:12", "text": "知ってるよ、私は"}, {"type": "subtitle", "time": 17067.67, "timestamp": "04:44:27", "text": "だからこれらは"}, {"type": "subtitle", "time": 17070.55, "timestamp": "04:44:30", "text": "ロックされています。わかった、"}, {"type": "subtitle", "time": 17072.12, "timestamp": "04:44:32", "text": "それは私のものです。"}, {"type": "subtitle", "time": 17081.75, "timestamp": "04:44:41", "text": "何だって？あなたは間違いを犯しました。"}, {"type": "subtitle", "time": 17086.708, "timestamp": "04:44:46", "text": "あなたは"}, {"type": "subtitle", "time": 17088.868, "timestamp": "04:44:48", "text": "間違いです。"}, {"type": "subtitle", "time": 17091.35, "timestamp": "04:44:51", "text": "さよなら。"}, {"type": "subtitle", "time": 17094.868, "timestamp": "04:44:54", "text": "どうもありがとうございます。ビーストはこれでより安全になった。"}]
[{"type": "subtitle", "time": 6378.86, "timestamp": "01:46:18", "text": "これもダメだ"}, {"type": "subtitle", "time": 6382.27, "timestamp": "01:46:22", "text": "[音楽]"}, {"type": "subtitle", "time": 6387.07, "timestamp": "01:46:27", "text": "ああ。"}, {"type": "subtitle", "time": 6392.189, "timestamp": "01:46:32", "text": "どうやって？私はどうすればいいのでしょうか？ああ、"}, {"type": "subtitle", "time": 6396.31, "timestamp": "01:46:36", "text": "神。どうやって起き上がればいいですか？何か見落としているのでしょうか？"}, {"type": "subtitle", "time": 6403.83, "timestamp": "01:46:43", "text": "私は行方不明ですか？レヴィオーサは"}, {"type": "subtitle", "time": 6406.629, "timestamp": "01:46:46", "text": "ええと、それらを飛ばすような物体のことです。"}]
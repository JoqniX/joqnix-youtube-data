[{"type": "subtitle", "time": 16889.59, "timestamp": "04:41:29", "text": "でも、あれはかっこよかったよ。私は避けていた"}, {"type": "subtitle", "time": 16898.708, "timestamp": "04:41:38", "text": "私は狂ったように身をかわしていた。そうするべきです。"}, {"type": "subtitle", "time": 16900.788, "timestamp": "04:41:40", "text": "スプラットル夫人を探してください。彼女は喜んで"}]
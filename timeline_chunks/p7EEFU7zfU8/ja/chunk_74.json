[{"type": "subtitle", "time": 4440.63, "timestamp": "01:14:00", "text": "クラスのすべての獣は完璧です"}, {"type": "subtitle", "time": 4442.51, "timestamp": "01:14:02", "text": "安全。私"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "ご注意ください。舌"}, {"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "パフキンは、とんでもなくずる賢い生き物になり得る。"}, {"type": "subtitle", "time": 4451.99, "timestamp": "01:14:11", "text": "わかった。なぜTwitterをオンにするのか？すべて"}, {"type": "subtitle", "time": 4453.669, "timestamp": "01:14:13", "text": "知っておく必要がある。ああ、そうやって見せるんだ"}, {"type": "subtitle", "time": 4458.709, "timestamp": "01:14:18", "text": "スピード。わかった。ジェラルド、ただ目を離さないように"}, {"type": "subtitle", "time": 4463.43, "timestamp": "01:14:23", "text": "誤って6月を表示してしまう。何てことだ。"}, {"type": "subtitle", "time": 4466.31, "timestamp": "01:14:26", "text": "ああ、それから、楽しいことを考えてくださいね。私は好きです"}, {"type": "subtitle", "time": 4469.39, "timestamp": "01:14:29", "text": "それが彼の経験を豊かにすると考える。"}, {"type": "subtitle", "time": 4471.39, "timestamp": "01:14:31", "text": "RIP。"}, {"type": "subtitle", "time": 4474.03, "timestamp": "01:14:34", "text": "神。"}, {"type": "subtitle", "time": 4477.189, "timestamp": "01:14:37", "text": "くそ。 Okayに注目してください。ああ、見て"}, {"type": "subtitle", "time": 4479.99, "timestamp": "01:14:39", "text": "この表紙のところで。この目を見てください。"}, {"type": "subtitle", "time": 4483.03, "timestamp": "01:14:43", "text": "とてもかわいい。ふわふわのブローボールのような魚"}, {"type": "subtitle", "time": 4484.75, "timestamp": "01:14:44", "text": "あなたの"}, {"type": "subtitle", "time": 4487.35, "timestamp": "01:14:47", "text": "ジェラルド。獣の撫でブラシは"}, {"type": "subtitle", "time": 4489.709, "timestamp": "01:14:49", "text": "育てるために使われた"}, {"type": "subtitle", "time": 4491.709, "timestamp": "01:14:51", "text": "ミカル"}, {"type": "subtitle", "time": 4494.189, "timestamp": "01:14:54", "text": "ミツバチ。"}, {"type": "subtitle", "time": 4497.35, "timestamp": "01:14:57", "text": "ああ、t をタップして be ブラシにカーソルを合わせ、"}]
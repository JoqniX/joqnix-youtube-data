[{"type": "subtitle", "time": 6423.43, "timestamp": "01:47:03", "text": "えーと。それはただの日本語です。それはいくつか"}, {"type": "subtitle", "time": 6425.91, "timestamp": "01:47:05", "text": "もっとフィリピンを。でも、私は何をするの？それは"}, {"type": "subtitle", "time": 6428.95, "timestamp": "01:47:08", "text": "生まれて初めてです。誰かが私が見たと言った"}, {"type": "subtitle", "time": 6436.55, "timestamp": "01:47:16", "text": "おお。私は人々が私にこう言っているのを見たことがあります"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "ロシアでご覧になったものですね。何人かの人があなたに言った"}, {"type": "subtitle", "time": 6442.51, "timestamp": "01:47:22", "text": "フランス語か何かの音。"}, {"type": "subtitle", "time": 6444.95, "timestamp": "01:47:24", "text": "ええと、そんな感じですね。それで"}, {"type": "subtitle", "time": 6451.149, "timestamp": "01:47:31", "text": "えっと、言語や場所を何と呼ぶんですか？"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "ただし、私は専門家ではありません。それはまるで、"}, {"type": "subtitle", "time": 6463.35, "timestamp": "01:47:43", "text": "進撃の巨人（AOT）は観ましたか？"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "やったよ、でも進撃の巨人の最新情報は知らないんだ"}, {"type": "subtitle", "time": 6469.35, "timestamp": "01:47:49", "text": "もの。シーズン1しか見ていない記憶がある"}, {"type": "subtitle", "time": 6471.55, "timestamp": "01:47:51", "text": "そして２つ目に、私は"}, {"type": "subtitle", "time": 6475.35, "timestamp": "01:47:55", "text": "信じる。 H ええ、ほとんど知りません"}]
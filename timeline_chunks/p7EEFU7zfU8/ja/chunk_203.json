[{"type": "subtitle", "time": 12184.429, "timestamp": "03:23:04", "text": "私たちは作ります"}, {"type": "subtitle", "time": 12187.389, "timestamp": "03:23:07", "text": "お金。 4人全員。"}, {"type": "subtitle", "time": 12191.79, "timestamp": "03:23:11", "text": "いや、待って。誰のところへ行こうか？わかった。それは"}, {"type": "subtitle", "time": 12194.75, "timestamp": "03:23:14", "text": "ここ？植物"}, {"type": "subtitle", "time": 12197.07, "timestamp": "03:23:17", "text": "店。古い"}, {"type": "subtitle", "time": 12201.97, "timestamp": "03:23:21", "text": "肥料。"}, {"type": "subtitle", "time": 12205.229, "timestamp": "03:23:25", "text": "[音楽]"}, {"type": "subtitle", "time": 12209.67, "timestamp": "03:23:29", "text": "えっと。えっと。ちょっと待って。"}, {"type": "subtitle", "time": 12212.429, "timestamp": "03:23:32", "text": "誰に相談すればいいですか？"}, {"type": "subtitle", "time": 12216.349, "timestamp": "03:23:36", "text": "再び売れる？あの女の子じゃないよね？"}, {"type": "subtitle", "time": 12219.79, "timestamp": "03:23:39", "text": "ここにはないのですか？"}, {"type": "subtitle", "time": 12227.07, "timestamp": "03:23:47", "text": "また？"}]
[{"type": "subtitle", "time": 5342.87, "timestamp": "01:29:02", "text": "masがあなたを見つけましたか？私もです。何？あなたは"}, {"type": "subtitle", "time": 5345.35, "timestamp": "01:29:05", "text": "その日、ここでゴブリンと話していた。はい、"}, {"type": "subtitle", "time": 5349.43, "timestamp": "01:29:09", "text": "主なる神よ。おお、低い声ですね。私は"}, {"type": "subtitle", "time": 5351.11, "timestamp": "01:29:11", "text": "それを聞いて嬉しいです。まるであなたが"}, {"type": "subtitle", "time": 5352.79, "timestamp": "01:29:12", "text": "彼らは彼と良好な関係にあった。私は知っている"}, {"type": "subtitle", "time": 5355.189, "timestamp": "01:29:15", "text": "彼にとって何年ものことだった。私が待っている間に私たちは出会った"}, {"type": "subtitle", "time": 5357.27, "timestamp": "01:29:17", "text": "学生としてここにテーブルがあります。私が"}, {"type": "subtitle", "time": 5359.11, "timestamp": "01:29:19", "text": "その場所を買った。購入する前に"}, {"type": "subtitle", "time": 5360.87, "timestamp": "01:29:20", "text": "その場所。でも、当時は私たちは友達ではなかった。"}, {"type": "subtitle", "time": 5363.91, "timestamp": "01:29:23", "text": "彼は魔法使いという存在を深く不信していた。"}, {"type": "subtitle", "time": 5366.95, "timestamp": "01:29:26", "text": "でも、今は友達ですよね。私たちは。していなかった"}, {"type": "subtitle", "time": 5368.629, "timestamp": "01:29:28", "text": "彼が数年ぶりに来た時に会った"}, {"type": "subtitle", "time": 5372.55, "timestamp": "01:29:32", "text": "数か月前。しかし彼は私だと気づいた"}, {"type": "subtitle", "time": 5374.629, "timestamp": "01:29:34", "text": "すぐに、それは私が言える以上のことです"}, {"type": "subtitle", "time": 5377.03, "timestamp": "01:29:37", "text": "私のクラスメートの中には、そういう人もいる。それらを取った"}, {"type": "subtitle", "time": 5378.55, "timestamp": "01:29:38", "text": "自分が実際には"}, {"type": "subtitle", "time": 5381.03, "timestamp": "01:29:41", "text": "魔女であって、魔法使いではない。すべてのゴブリンが"}, {"type": "subtitle", "time": 5382.629, "timestamp": "01:29:42", "text": "ランロックとその忠実な部下のように。そうそう。"}, {"type": "subtitle", "time": 5384.55, "timestamp": "01:29:44", "text": "魔女は女性で魔法使いは"}, {"type": "subtitle", "time": 5386.149, "timestamp": "01:29:46", "text": "男性。私たち二人は"}, {"type": "subtitle", "time": 5388.229, "timestamp": "01:29:48", "text": "続いている。その場合は、"}, {"type": "subtitle", "time": 5391.189, "timestamp": "01:29:51", "text": "特にランドロックについて彼と話した。"}, {"type": "subtitle", "time": 5393.51, "timestamp": "01:29:53", "text": "彼とはどこで会えるでしょうか？私はあなたの"}, {"type": "subtitle", "time": 5395.27, "timestamp": "01:29:55", "text": "興味は私が持っている噂に関係しています"}, {"type": "subtitle", "time": 5397.11, "timestamp": "01:29:57", "text": "Randrockが私たちの"}, {"type": "subtitle", "time": 5399.51, "timestamp": "01:29:59", "text": "友人ルークウッド。そうです。彼がそうでないなら"}]
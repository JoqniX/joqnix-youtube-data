[{"type": "subtitle", "time": 15799.149, "timestamp": "04:23:19", "text": "よし、これは保管しておかないといけない"}, {"type": "subtitle", "time": 15810.229, "timestamp": "04:23:30", "text": "戻る。 3時間が経過しました。うん、"}, {"type": "subtitle", "time": 15813.71, "timestamp": "04:23:33", "text": "今日の配信は4時間経過しました。しないで"}, {"type": "subtitle", "time": 15816.79, "timestamp": "04:23:36", "text": "心配です、これは私が必要としているシリーズの一つです"}, {"type": "subtitle", "time": 15836.71, "timestamp": "04:23:56", "text": "ここが洞窟に違いない、スプル夫人"}, {"type": "subtitle", "time": 15839.09, "timestamp": "04:23:59", "text": "言及された。"}]
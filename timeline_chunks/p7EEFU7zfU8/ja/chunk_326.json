[{"type": "subtitle", "time": 19563.35, "timestamp": "05:26:03", "text": "15日だったけど、それでも配信しようと思った"}, {"type": "subtitle", "time": 19566.39, "timestamp": "05:26:06", "text": "試験中にストリーミングを試みる"}, {"type": "subtitle", "time": 19570.07, "timestamp": "05:26:10", "text": "16日から3週目、私の試験が"}, {"type": "subtitle", "time": 19572.788, "timestamp": "05:26:12", "text": "開始します。だから、終わらせようと思った"}, {"type": "subtitle", "time": 19576.788, "timestamp": "05:26:16", "text": "コラボレーションとその他すべて、そしてパック"}, {"type": "subtitle", "time": 19588.55, "timestamp": "05:26:28", "text": "あ、今気づいた。あ、待って。私にさせて"}, {"type": "subtitle", "time": 19590.708, "timestamp": "05:26:30", "text": "未確定。わかった。こんにちは、あなたは"}, {"type": "subtitle", "time": 19594.948, "timestamp": "05:26:34", "text": "ストリーム。こんにちは。わかった。わかった。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "うん、聞こえるよ。ニース。わかった。まるで"}, {"type": "subtitle", "time": 19601.19, "timestamp": "05:26:41", "text": "奇妙な音。これはただ私の"}, {"type": "subtitle", "time": 19603.99, "timestamp": "05:26:43", "text": "背景に両親が写っている。"}, {"type": "subtitle", "time": 19606.39, "timestamp": "05:26:46", "text": "ノイズ抑制機能があるので"}, {"type": "subtitle", "time": 19609.67, "timestamp": "05:26:49", "text": "相殺する。わかった。心配ない。私は違います"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "仕組みはよくわからない。だから、おそらく"}, {"type": "subtitle", "time": 19615.99, "timestamp": "05:26:55", "text": "私の終わり。私は何もしていません、なぜなら"}, {"type": "subtitle", "time": 19617.83, "timestamp": "05:26:57", "text": "ええ、ずいぶん時間が経ちましたし、私は"}, {"type": "subtitle", "time": 19619.59, "timestamp": "05:26:59", "text": "産婦人科医と何をすべきか知っていますか"}]
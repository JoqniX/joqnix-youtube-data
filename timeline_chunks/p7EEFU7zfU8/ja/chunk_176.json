[{"type": "subtitle", "time": 10560.83, "timestamp": "02:56:00", "text": "[拍手]"}, {"type": "subtitle", "time": 10564.71, "timestamp": "02:56:04", "text": "はい、全部手に入れました。"}, {"type": "subtitle", "time": 10567.349, "timestamp": "02:56:07", "text": "そこには。そこには。あなたを傷つけるつもりはありません。"}, {"type": "subtitle", "time": 10574.269, "timestamp": "02:56:14", "text": "仮定する。"}, {"type": "subtitle", "time": 10578.23, "timestamp": "02:56:18", "text": "全部手に入れました。私は仕事を救い、"}, {"type": "subtitle", "time": 10580.55, "timestamp": "02:56:20", "text": "全て。いいえ、私は7、8匹を救助しました"}, {"type": "subtitle", "time": 10583.51, "timestamp": "02:56:23", "text": "ナップザック。素敵で居心地が良い。密猟者は"}, {"type": "subtitle", "time": 10586.07, "timestamp": "02:56:26", "text": "羽毛のために彼らを襲い、親切ではない"}, {"type": "subtitle", "time": 10587.99, "timestamp": "02:56:27", "text": "彼らがそれらを集めるとき。何かありますか？"}, {"type": "subtitle", "time": 10590.469, "timestamp": "02:56:30", "text": "近くに他の獣がいる？ディーが"}, {"type": "subtitle", "time": 10593.03, "timestamp": "02:56:33", "text": "知っている。月の彫刻の群れ。彼らは"}, {"type": "subtitle", "time": 10596.309, "timestamp": "02:56:36", "text": "この小道を登った先の、木々が生い茂る場所に住んでいます。"}, {"type": "subtitle", "time": 10602.51, "timestamp": "02:56:42", "text": "わかった。おお"}, {"type": "subtitle", "time": 10607.269, "timestamp": "02:56:47", "text": "男の子。もう2時間経ちました。"}]
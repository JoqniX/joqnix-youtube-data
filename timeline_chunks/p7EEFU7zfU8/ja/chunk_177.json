[{"type": "subtitle", "time": 10623.11, "timestamp": "02:57:03", "text": "こんにちは。こんにちは、ディー。これは"}, {"type": "subtitle", "time": 10625.429, "timestamp": "02:57:05", "text": "あなたが言及したクリアリングのことですか？そうです。月"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "炭水化物は大きな木の近くに集まります"}, {"type": "subtitle", "time": 10630.63, "timestamp": "02:57:10", "text": "前面の螺旋模様だが、下側は"}, {"type": "subtitle", "time": 10634.07, "timestamp": "02:57:14", "text": "月の光。残念ながら、"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "時間を早める方法がない限り、"}, {"type": "subtitle", "time": 10639.269, "timestamp": "02:57:19", "text": "場合によっては、"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "彼らを見るには夜になる。はぁ？クロ。する"}, {"type": "subtitle", "time": 10645.99, "timestamp": "02:57:25", "text": "それなら月面車を探しに行けばいいじゃないか。デール・ビー"}, {"type": "subtitle", "time": 10648.63, "timestamp": "02:57:28", "text": "あなたの帰りを待っています。こんにちは。彼は行く"}, {"type": "subtitle", "time": 10651.63, "timestamp": "02:57:31", "text": "指を鳴らして"}, {"type": "subtitle", "time": 10662.469, "timestamp": "02:57:42", "text": "こんにちは。夜で、ディックはまだ"}, {"type": "subtitle", "time": 10666.15, "timestamp": "02:57:46", "text": "ここ。ああ、彼は辛抱強く待っている"}, {"type": "subtitle", "time": 10669.79, "timestamp": "02:57:49", "text": "私たち。私はとても幸せです。これを抱きしめたい"}, {"type": "subtitle", "time": 10673.309, "timestamp": "02:57:53", "text": "バックアー。月"}, {"type": "subtitle", "time": 10676.349, "timestamp": "02:57:56", "text": "車。 1つ、"}]
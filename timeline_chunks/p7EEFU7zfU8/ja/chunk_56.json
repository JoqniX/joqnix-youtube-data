[{"type": "subtitle", "time": 3360.309, "timestamp": "00:56:00", "text": "あなた。でも大丈夫。わかった。ありがとうございます"}, {"type": "subtitle", "time": 3362.39, "timestamp": "00:56:02", "text": "みんな。大丈夫。ダウンロードします"}, {"type": "subtitle", "time": 3364.39, "timestamp": "00:56:04", "text": "Twitchのモデレーター。心配ない。心配ない。こんにちは。"}, {"type": "subtitle", "time": 3368.069, "timestamp": "00:56:08", "text": "また、ミア・キャットさんにも感謝します。"}, {"type": "subtitle", "time": 3371.349, "timestamp": "00:56:11", "text": "ビット。ありがとう。それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 3374.15, "timestamp": "00:56:14", "text": "以上です。私は、"}, {"type": "subtitle", "time": 3375.829, "timestamp": "00:56:15", "text": "Twitchで参加したすべての人と、"}, {"type": "subtitle", "time": 3377.51, "timestamp": "00:56:17", "text": "YouTubeで。楽しんでいただけたでしょうか"}, {"type": "subtitle", "time": 3380.15, "timestamp": "00:56:20", "text": "今日の勉強会は私と一緒に"}, {"type": "subtitle", "time": 3382.789, "timestamp": "00:56:22", "text": "おそらく私、ほとんど私、仕事中"}, {"type": "subtitle", "time": 3384.789, "timestamp": "00:56:24", "text": "そして、最善を尽くしています。この掲示板が"}, {"type": "subtitle", "time": 3386.03, "timestamp": "00:56:26", "text": "しない"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "起き上がる、つまり、著作権で保護されています。さあ"}, {"type": "subtitle", "time": 3392.51, "timestamp": "00:56:32", "text": "そうなってほしくない。しかし"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "うん、今日は楽しかったよ。楽しかったです。"}, {"type": "subtitle", "time": 3398.069, "timestamp": "00:56:38", "text": "ご視聴いただきありがとうございました。"}, {"type": "subtitle", "time": 3400.47, "timestamp": "00:56:40", "text": "最後まで残ってくれてありがとう。本当は"}, {"type": "subtitle", "time": 3402.789, "timestamp": "00:56:42", "text": "多く。明日か明後日、また会いましょう"}, {"type": "subtitle", "time": 3404.789, "timestamp": "00:56:44", "text": "明日のバレンタインデー以降。良い"}, {"type": "subtitle", "time": 3407.27, "timestamp": "00:56:47", "text": "朝の配信をする。行く。こんにちは。何が"}]
[{"type": "subtitle", "time": 20281.39, "timestamp": "05:38:01", "text": "あなたにはそうする権利があります。あなたは"}, {"type": "subtitle", "time": 20284.51, "timestamp": "05:38:04", "text": "安全。でも、気をつけてくださいね。"}, {"type": "subtitle", "time": 20288.07, "timestamp": "05:38:08", "text": "ええ、私も少しは考えましたが、"}, {"type": "subtitle", "time": 20291.43, "timestamp": "05:38:11", "text": "シェアするみたいに、私はある意味"}, {"type": "subtitle", "time": 20294.47, "timestamp": "05:38:14", "text": "不明。ストリーマーを一人だけ見かけました"}, {"type": "subtitle", "time": 20296.83, "timestamp": "05:38:16", "text": "奇妙な欠落"}, {"type": "subtitle", "time": 20304.19, "timestamp": "05:38:24", "text": "彼。"}, {"type": "subtitle", "time": 20310.19, "timestamp": "05:38:30", "text": "えっと、どうすればいいのかわからないけど、"}, {"type": "subtitle", "time": 20312.708, "timestamp": "05:38:32", "text": "デビューにはやらなければならないことがたくさんある"}, {"type": "subtitle", "time": 20315.83, "timestamp": "05:38:35", "text": "正しく準備する"}, {"type": "subtitle", "time": 20319.67, "timestamp": "05:38:39", "text": "デビューについてのデビュー。うん、もしあなたが"}, {"type": "subtitle", "time": 20322.23, "timestamp": "05:38:42", "text": "デビューしたいなら、私は"}, {"type": "subtitle", "time": 20323.99, "timestamp": "05:38:43", "text": "何かありますか？"}, {"type": "subtitle", "time": 20327.51, "timestamp": "05:38:47", "text": "スライドとか、そういうの全部。スライド。いいえ"}, {"type": "subtitle", "time": 20330.47, "timestamp": "05:38:50", "text": "この脚が好きです。うん。何度も。"}, {"type": "subtitle", "time": 20332.708, "timestamp": "05:38:52", "text": "デビューさせるものは何もありません。それは"}, {"type": "subtitle", "time": 20334.31, "timestamp": "05:38:54", "text": "その物。私には何も"}, {"type": "subtitle", "time": 20337.43, "timestamp": "05:38:57", "text": "デビュー。うん。"}, {"type": "subtitle", "time": 20339.75, "timestamp": "05:38:59", "text": "それが一番重要なことだと思うんです。"}]
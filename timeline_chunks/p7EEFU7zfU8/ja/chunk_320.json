[{"type": "subtitle", "time": 19200.91, "timestamp": "05:20:00", "text": "今は接続があなたを助けてくれます"}, {"type": "subtitle", "time": 19204.628, "timestamp": "05:20:04", "text": "その間。ええ、それは役に立つでしょう。 NDI"}, {"type": "subtitle", "time": 19207.67, "timestamp": "05:20:07", "text": "テレポートするか、SRTストリーミングを行うことができます。"}, {"type": "subtitle", "time": 19212.39, "timestamp": "05:20:12", "text": "つまり、OBS1 をストリーミングして"}, {"type": "subtitle", "time": 19215.11, "timestamp": "05:20:15", "text": "OBSでストリーミングすると、"}, {"type": "subtitle", "time": 19217.03, "timestamp": "05:20:17", "text": "3060Tiをお持ちですか？"}, {"type": "subtitle", "time": 19220.708, "timestamp": "05:20:20", "text": "OBSでストリーミングしてメディアを配置します"}, {"type": "subtitle", "time": 19224.47, "timestamp": "05:20:24", "text": "ストリームPCのソースと再生"}, {"type": "subtitle", "time": 19227.59, "timestamp": "05:20:27", "text": "そのストリームは別のOBSから配信されています。あなたはできる"}, {"type": "subtitle", "time": 19230.47, "timestamp": "05:20:30", "text": "ローカルのSRTストリーミングでも同じようにできます。"}, {"type": "subtitle", "time": 19233.91, "timestamp": "05:20:33", "text": "そうすることもできますし、NDIを使用することもできます。"}, {"type": "subtitle", "time": 19235.99, "timestamp": "05:20:35", "text": "昔やっていたようにテレポートする"}, {"type": "subtitle", "time": 19239.628, "timestamp": "05:20:39", "text": "日。インターネットが"}, {"type": "subtitle", "time": 19241.628, "timestamp": "05:20:41", "text": "痛み、"}, {"type": "subtitle", "time": 19244.91, "timestamp": "05:20:44", "text": "そうすれば、カードをキャッチするのが唯一の方法だと私は信じます"}, {"type": "subtitle", "time": 19247.91, "timestamp": "05:20:47", "text": "オプション。安価なキャプチャーカードを入手できます"}, {"type": "subtitle", "time": 19250.27, "timestamp": "05:20:50", "text": "あまりにも、"}, {"type": "subtitle", "time": 19258.55, "timestamp": "05:20:58", "text": "作品。うん。ええ、安いものを使ってもいいですよ"}]
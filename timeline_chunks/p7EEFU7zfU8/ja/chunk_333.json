[{"type": "subtitle", "time": 19980.868, "timestamp": "05:33:00", "text": "書く。私は、私は、あの痛みであり、"}, {"type": "subtitle", "time": 19983.03, "timestamp": "05:33:03", "text": "私は日本語を勉強するつもりです。私はこう思う、"}, {"type": "subtitle", "time": 19985.27, "timestamp": "05:33:05", "text": "ええ、つまり、私は真剣に考えなければならない"}, {"type": "subtitle", "time": 19988.39, "timestamp": "05:33:08", "text": "それ。多額のお金が費やされた"}, {"type": "subtitle", "time": 19990.708, "timestamp": "05:33:10", "text": "えーと、両親は私を"}, {"type": "subtitle", "time": 19993.99, "timestamp": "05:33:13", "text": "私にとって海外の別の国"}, {"type": "subtitle", "time": 19997.11, "timestamp": "05:33:17", "text": "勉強とか、その他いろいろ。ええ、それで私は"}, {"type": "subtitle", "time": 20006.23, "timestamp": "05:33:26", "text": "プレッシャーって感じかな"}, {"type": "subtitle", "time": 20009.75, "timestamp": "05:33:29", "text": "そこには。ああ、プレッシャーはあるよ"}, {"type": "subtitle", "time": 20014.39, "timestamp": "05:33:34", "text": "私はそうは思わないけど、もし私が何かを手に入れたら"}, {"type": "subtitle", "time": 20016.23, "timestamp": "05:33:36", "text": "ルールを破ったとか、そういうことが起きてる"}, {"type": "subtitle", "time": 20017.99, "timestamp": "05:33:37", "text": "あるいは、私がすべてに従わなかった場合"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "正しく、そして私は家に送り返されます"}, {"type": "subtitle", "time": 20027.59, "timestamp": "05:33:47", "text": "間違いなく私が"}, {"type": "subtitle", "time": 20030.708, "timestamp": "05:33:50", "text": "間違いなく理解できます"}, {"type": "subtitle", "time": 20032.75, "timestamp": "05:33:52", "text": "私はただ"}, {"type": "subtitle", "time": 20037.91, "timestamp": "05:33:57", "text": "ああ、カメラを見つける必要がある"}]
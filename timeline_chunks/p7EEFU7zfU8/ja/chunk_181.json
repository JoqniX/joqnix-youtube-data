[{"type": "subtitle", "time": 10863.83, "timestamp": "03:01:03", "text": "ああ、あなたの獣のインベントリは満杯です。"}, {"type": "subtitle", "time": 10864.99, "timestamp": "03:01:04", "text": "おお、"}, {"type": "subtitle", "time": 10871.05, "timestamp": "03:01:11", "text": "ああ、わかった。私たちは"}, {"type": "subtitle", "time": 10882.9, "timestamp": "03:01:22", "text": "送信する必要があります"}, {"type": "subtitle", "time": 10894.469, "timestamp": "03:01:34", "text": "理解できません。これはインタラクティブな"}, {"type": "subtitle", "time": 10896.95, "timestamp": "03:01:36", "text": "物体。なぜ？私がなるべきもの"}, {"type": "subtitle", "time": 10899.67, "timestamp": "03:01:39", "text": "実行中。"}, {"type": "subtitle", "time": 10901.51, "timestamp": "03:01:41", "text": "他のものより少し難しかった。"}, {"type": "subtitle", "time": 10903.51, "timestamp": "03:01:43", "text": "でも今は、月のような咳が出ています。さあ行こう。"}, {"type": "subtitle", "time": 10906.23, "timestamp": "03:01:46", "text": "またしても怪物だ。無事です。はい、デ。"}, {"type": "subtitle", "time": 10908.71, "timestamp": "03:01:48", "text": "月は見えなかった。知っている。ディー、"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "それは素晴らしい光景だ。ディーは"}, {"type": "subtitle", "time": 10913.67, "timestamp": "03:01:53", "text": "ここでの作業は終了です。あなたは"}, {"type": "subtitle", "time": 10916.23, "timestamp": "03:01:56", "text": "さらに多くの動物を救出する。しかし今のところは、"}, {"type": "subtitle", "time": 10917.91, "timestamp": "03:01:57", "text": "集めたものを持ってきましょう"}]
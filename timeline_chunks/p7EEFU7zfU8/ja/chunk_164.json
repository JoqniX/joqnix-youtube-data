[{"type": "subtitle", "time": 9841.07, "timestamp": "02:44:01", "text": "では、私の体幹はどうでしょうか？"}, {"type": "subtitle", "time": 9843.75, "timestamp": "02:44:03", "text": "もの？ええと、長い間呆然としたまま"}, {"type": "subtitle", "time": 9844.66, "timestamp": "02:44:04", "text": "期間"}, {"type": "subtitle", "time": 9845.95, "timestamp": "02:44:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9850.51, "timestamp": "02:44:10", "text": "時間。ブロックを保護すると、"}, {"type": "subtitle", "time": 9853.4, "timestamp": "02:44:13", "text": "もっと。ええと、もしあなたが取引をしているなら"}, {"type": "subtitle", "time": 9855.23, "timestamp": "02:44:15", "text": "[音楽]"}, {"type": "subtitle", "time": 9858.03, "timestamp": "02:44:18", "text": "敵を打ち砕く衝撃"}, {"type": "subtitle", "time": 9861.469, "timestamp": "02:44:21", "text": "貝殻。どれがいいかな"}, {"type": "subtitle", "time": 9864.87, "timestamp": "02:44:24", "text": "取る？私はこれを手に入れたいのですが、"}, {"type": "subtitle", "time": 9868.389, "timestamp": "02:44:28", "text": "さらにポイントを追加します"}, {"type": "subtitle", "time": 9870.95, "timestamp": "02:44:30", "text": "古代の魔法計。だから私は思う、私は思う"}, {"type": "subtitle", "time": 9873.11, "timestamp": "02:44:33", "text": "こちらの方が良いと思います。"}, {"type": "subtitle", "time": 9875.83, "timestamp": "02:44:35", "text": "うん、とりあえずこれでいこう。後"}, {"type": "subtitle", "time": 9878.07, "timestamp": "02:44:38", "text": "それについては、すべてを手に入れようと努力する必要があります"}, {"type": "subtitle", "time": 9879.87, "timestamp": "02:44:39", "text": "これらのもの"}, {"type": "subtitle", "time": 9884.59, "timestamp": "02:44:44", "text": "良い。ああ、私ならこうできたのに。 O"}, {"type": "subtitle", "time": 9887.19, "timestamp": "02:44:47", "text": "健康。ああ、次回は"}, {"type": "subtitle", "time": 9889.349, "timestamp": "02:44:49", "text": "その他のカードやグッズ。うん。うん。うん。"}, {"type": "subtitle", "time": 9891.79, "timestamp": "02:44:51", "text": "レベルアップする必要がある"}, {"type": "subtitle", "time": 9895.07, "timestamp": "02:44:55", "text": "けれど。ああ、たくさんあるよ"}, {"type": "subtitle", "time": 9897.95, "timestamp": "02:44:57", "text": "それはたくさんだ"}, {"type": "subtitle", "time": 9899.87, "timestamp": "02:44:59", "text": "クエスト。"}]
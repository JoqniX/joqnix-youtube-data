[{"type": "subtitle", "time": 5760.229, "timestamp": "01:36:00", "text": "空。とても美しい。魔女"}, {"type": "subtitle", "time": 5762.629, "timestamp": "01:36:02", "text": "彼女自身はコレクターだと考えており、"}, {"type": "subtitle", "time": 5764.629, "timestamp": "01:36:04", "text": "装飾品としてヘルメットを購入した。"}, {"type": "subtitle", "time": 5766.91, "timestamp": "01:36:06", "text": "あれがホグワーツだ。いいね。彼女は"}, {"type": "subtitle", "time": 5770.709, "timestamp": "01:36:10", "text": "ゴブリンはどんなものでも正当な所有者になる"}, {"type": "subtitle", "time": 5773.83, "timestamp": "01:36:13", "text": "物体をその製作者として捉える。とてもかわいい。それで"}, {"type": "subtitle", "time": 5777.35, "timestamp": "01:36:17", "text": "美しい。煙突とかそういうやつ。"}, {"type": "subtitle", "time": 5778.95, "timestamp": "01:36:18", "text": "そして魔法使いはこれまで働くことができた"}, {"type": "subtitle", "time": 5781.75, "timestamp": "01:36:21", "text": "一緒に。おお。私たちの種類の"}, {"type": "subtitle", "time": 5784.709, "timestamp": "01:36:24", "text": "数えきれないほど多いようだ。驚くかもしれない"}, {"type": "subtitle", "time": 5787.99, "timestamp": "01:36:27", "text": "あなたにもっと多くのことを。ああ、凧がある"}, {"type": "subtitle", "time": 5792.03, "timestamp": "01:36:32", "text": "などなど。それが私が"}, {"type": "subtitle", "time": 5806.189, "timestamp": "01:36:46", "text": "神。それで"}, {"type": "subtitle", "time": 5808.68, "timestamp": "01:36:48", "text": "かわいい。鳥だよ。"}, {"type": "subtitle", "time": 5810.31, "timestamp": "01:36:50", "text": "[音楽]"}, {"type": "subtitle", "time": 5812.189, "timestamp": "01:36:52", "text": "それが何なのか分かりません"}]
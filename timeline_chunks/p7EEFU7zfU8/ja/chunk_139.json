[{"type": "subtitle", "time": 8340.11, "timestamp": "02:19:00", "text": "私は法的に盲目ですか？"}, {"type": "subtitle", "time": 8342.91, "timestamp": "02:19:02", "text": "言い訳。私はとても"}, {"type": "subtitle", "time": 8346.389, "timestamp": "02:19:06", "text": "混乱した。どうして彼らはそれを置かなかったのか"}, {"type": "subtitle", "time": 8353.79, "timestamp": "02:19:13", "text": "私はあの男を"}, {"type": "subtitle", "time": 8358.03, "timestamp": "02:19:18", "text": "ドア。どうしてそんなことができたの？そしてなぜ"}, {"type": "subtitle", "time": 8361.19, "timestamp": "02:19:21", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "あなたはなぜここにいるのですか？あなたを"}, {"type": "subtitle", "time": 8366.03, "timestamp": "02:19:26", "text": "ドア"}, {"type": "subtitle", "time": 8373.75, "timestamp": "02:19:33", "text": "何？何てことだ。でもとにかく、ついに"}, {"type": "subtitle", "time": 8376.79, "timestamp": "02:19:36", "text": "彼女をその中に放り込んだ。安息の地。 LG"}, {"type": "subtitle", "time": 8391.91, "timestamp": "02:19:51", "text": "死んだアッシュワインダー。あなたの同胞は"}, {"type": "subtitle", "time": 8394.15, "timestamp": "02:19:54", "text": "仲直りしたので、いくつか削除する必要があります"}]
[{"type": "subtitle", "time": 5101.75, "timestamp": "01:25:01", "text": "その地域で問題が起きている。だから、私は彼らが心配している"}, {"type": "subtitle", "time": 5104.47, "timestamp": "01:25:04", "text": "彼女を再び手に入れることができるかもしれないし、私はそうではないかもしれない"}, {"type": "subtitle", "time": 5106.87, "timestamp": "01:25:06", "text": "次回はぜひ行ってみてください。ああ、彼女を助けるよ"}, {"type": "subtitle", "time": 5108.79, "timestamp": "01:25:08", "text": "この時。心配しないで。あなたは"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "それは、私たちが"}, {"type": "subtitle", "time": 5112.629, "timestamp": "01:25:12", "text": "支援のための省庁。私はあまり同意しない"}, {"type": "subtitle", "time": 5115.35, "timestamp": "01:25:15", "text": "ハウエン教授と一緒ですが、その点については心配しています"}, {"type": "subtitle", "time": 5118.39, "timestamp": "01:25:18", "text": "彼女の言う通りだ。密猟者の影響は"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "成長している。私は毎日彼らを"}, {"type": "subtitle", "time": 5123.91, "timestamp": "01:25:23", "text": "村に佇み、人々と語り合う。"}, {"type": "subtitle", "time": 5126.229, "timestamp": "01:25:26", "text": "彼らは何か企んでいる。わかった。私はただ"}, {"type": "subtitle", "time": 5129.11, "timestamp": "01:25:29", "text": "何のことかよくわからない。"}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "それは怪しいですね。はい。その通り。"}, {"type": "subtitle", "time": 5134.629, "timestamp": "01:25:34", "text": "待って。疑わしいとは言い難い"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "それって怪しいですよね？次のような"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "それ。行う"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "これが最後だと思う"}, {"type": "subtitle", "time": 5145.669, "timestamp": "01:25:45", "text": "バンカーがあれば、私はもっとよく保つことができる"}, {"type": "subtitle", "time": 5148.79, "timestamp": "01:25:48", "text": "ハイウィングは安全で、あなたはひるまないようです"}]
[{"type": "subtitle", "time": 7634.75, "timestamp": "02:07:14", "text": "ああ、"}, {"type": "subtitle", "time": 7638.39, "timestamp": "02:07:18", "text": "それはまずい。それはまずい。それはまずい。"}, {"type": "subtitle", "time": 7643.83, "timestamp": "02:07:23", "text": "悪い。なぜ彼らは何も排出しないのか"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "ダメージ？なぜあなたはここに閉じ込められているのですか？"}, {"type": "subtitle", "time": 7659.109, "timestamp": "02:07:39", "text": "ブーム決闘フェーズ？どうすればいいの？"}, {"type": "subtitle", "time": 7660.91, "timestamp": "02:07:40", "text": "決闘フィード"}, {"type": "subtitle", "time": 7675.39, "timestamp": "02:07:55", "text": "嘘をついている？こんにちは。一体どうやって"}, {"type": "subtitle", "time": 7677.99, "timestamp": "02:07:57", "text": "推測？これは"}, {"type": "subtitle", "time": 7679.99, "timestamp": "02:07:59", "text": "異質さからくる膨らみ。私はそれが"}]
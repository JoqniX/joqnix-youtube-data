[{"type": "subtitle", "time": 12901.269, "timestamp": "03:35:01", "text": "あなた。人生最愛の人。少し途方に暮れる"}, {"type": "subtitle", "time": 12904.07, "timestamp": "03:35:04", "text": "彼。いくつか集めてもいいですか？"}, {"type": "subtitle", "time": 12905.99, "timestamp": "03:35:05", "text": "私にとってタカの群れは、"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "確かに探してみます"}, {"type": "subtitle", "time": 12918.15, "timestamp": "03:35:18", "text": "あなた。それは素晴らしいですね。私は"}, {"type": "subtitle", "time": 12919.83, "timestamp": "03:35:19", "text": "移動販売業者と"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "Wiganworld をもっと手に入れたい"}, {"type": "subtitle", "time": 12924.71, "timestamp": "03:35:24", "text": "薬。セローナ氏はまた、ミスターについても言及した。"}, {"type": "subtitle", "time": 12926.55, "timestamp": "03:35:26", "text": "スプルは彼女に手紙の入った箱を届けていた"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "彼が病気になったとき。確かに、彼はそうだった。私は"}, {"type": "subtitle", "time": 12932.63, "timestamp": "03:35:32", "text": "ほとんど忘れ去られていた。偶然見つけた"}, {"type": "subtitle", "time": 12935.349, "timestamp": "03:35:35", "text": "エイデンが亡くなる直前。彼は期待していた"}, {"type": "subtitle", "time": 12937.19, "timestamp": "03:35:37", "text": "セローナと一緒にそれをやり遂げる"}, {"type": "subtitle", "time": 12940.309, "timestamp": "03:35:40", "text": "バタービールを1、2杯。あの二人はいつも"}, {"type": "subtitle", "time": 12943.75, "timestamp": "03:35:43", "text": "まるで枝にとまっている2人の弓矢使いのようだ。エイデン"}, {"type": "subtitle", "time": 12945.75, "timestamp": "03:35:45", "text": "タカを捕獲していた時に病気になった"}, {"type": "subtitle", "time": 12948.389, "timestamp": "03:35:48", "text": "彼女に会いに行く途中で、彼は塊になっていました。彼はそれを成し遂げた"}, {"type": "subtitle", "time": 12951.03, "timestamp": "03:35:51", "text": "家に帰ったが、箱を落としてしまったのではないかと心配している"}, {"type": "subtitle", "time": 12953.59, "timestamp": "03:35:53", "text": "洞窟。その洞窟は丘陵地帯にある。"}, {"type": "subtitle", "time": 12956.229, "timestamp": "03:35:56", "text": "私たちの集落のすぐ南西に位置する。あなたはできる"}, {"type": "subtitle", "time": 12958.71, "timestamp": "03:35:58", "text": "タカの群れを集めて箱を回収する"}]
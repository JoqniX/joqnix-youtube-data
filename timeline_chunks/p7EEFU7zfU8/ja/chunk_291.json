[{"type": "subtitle", "time": 17461.07, "timestamp": "04:51:01", "text": "ここ。"}, {"type": "subtitle", "time": 17464.35, "timestamp": "04:51:04", "text": "良い。私はクモハンターです"}, {"type": "subtitle", "time": 17472.99, "timestamp": "04:51:12", "text": "おお、ボス。"}, {"type": "subtitle", "time": 17478.868, "timestamp": "04:51:18", "text": "ああ、ボス戦の時間ですか？ボスタイムだ。"}, {"type": "subtitle", "time": 17497.948, "timestamp": "04:51:37", "text": "[拍手]"}, {"type": "subtitle", "time": 17511.51, "timestamp": "04:51:51", "text": "何？とにかく、行こう。すでに無駄になっている"}, {"type": "subtitle", "time": 17514.15, "timestamp": "04:51:54", "text": "非常に長い時間。ええ、これらの岩には"}]
[{"type": "subtitle", "time": 5945.629, "timestamp": "01:39:05", "text": "[音楽]"}, {"type": "subtitle", "time": 5948.229, "timestamp": "01:39:08", "text": "何？私が受け取らなかったものがある"}, {"type": "subtitle", "time": 5952.149, "timestamp": "01:39:12", "text": "ここからこちらへ。反乱"}, {"type": "subtitle", "time": 5954.35, "timestamp": "01:39:14", "text": "それは私の考えです。"}, {"type": "subtitle", "time": 5977.99, "timestamp": "01:39:37", "text": "社会。ここは魔女の墓のはずがない。"}, {"type": "subtitle", "time": 5999.87, "timestamp": "01:39:59", "text": "1つあります"}]
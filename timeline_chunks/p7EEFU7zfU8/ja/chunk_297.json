[{"type": "subtitle", "time": 17822.948, "timestamp": "04:57:02", "text": "何てことだ。私はいつも旅行について言っています"}, {"type": "subtitle", "time": 17825.59, "timestamp": "04:57:05", "text": "もう4人いるよ。ああ、大変だ。誰が"}, {"type": "subtitle", "time": 17829.03, "timestamp": "04:57:09", "text": "ここに住んでいる？それは車ですか？"}, {"type": "subtitle", "time": 17832.67, "timestamp": "04:57:12", "text": "ありがとうございました"}, {"type": "subtitle", "time": 17835.75, "timestamp": "04:57:15", "text": "配信時間を増やします。こんにちは、ミスター。"}, {"type": "subtitle", "time": 17838.47, "timestamp": "04:57:18", "text": "スクラトル。良い知らせがあります。私はできた"}, {"type": "subtitle", "time": 17840.31, "timestamp": "04:57:20", "text": "あなたのためにタカの群れをいくつか収穫し、"}, {"type": "subtitle", "time": 17842.868, "timestamp": "04:57:22", "text": "セローナの手紙が入った箱を見つけた。おお、"}, {"type": "subtitle", "time": 17846.55, "timestamp": "04:57:26", "text": "ありがとう。なんて素晴らしいのでしょう。旅行"}, {"type": "subtitle", "time": 17848.708, "timestamp": "04:57:28", "text": "ベンダーは補充できることに大喜びするだろう"}, {"type": "subtitle", "time": 17851.75, "timestamp": "04:57:31", "text": "彼らのカツラと溶接薬の在庫。そして"}, {"type": "subtitle", "time": 17853.75, "timestamp": "04:57:33", "text": "セローナは、"}, {"type": "subtitle", "time": 17857.19, "timestamp": "04:57:37", "text": "手紙。お親切にありがとうございます。さあ、あなたは"}, {"type": "subtitle", "time": 17861.27, "timestamp": "04:57:41", "text": "ホグズミーへ戻る際は、くれぐれもご注意ください。"}, {"type": "subtitle", "time": 17862.868, "timestamp": "04:57:42", "text": "私はこの手紙の箱を"}, {"type": "subtitle", "time": 17875.91, "timestamp": "04:57:55", "text": "セローナ。そうそう。それで、次の計画は"}, {"type": "subtitle", "time": 17877.91, "timestamp": "04:57:57", "text": "1週間ですよね？私は何度も言い続けている。だから私たちは"}]
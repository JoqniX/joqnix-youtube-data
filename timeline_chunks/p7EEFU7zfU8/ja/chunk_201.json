[{"type": "subtitle", "time": 12067.469, "timestamp": "03:21:07", "text": "ああ、私と一緒に来て、私は若い"}, {"type": "subtitle", "time": 12076.67, "timestamp": "03:21:16", "text": "ここ。あなたを待たせてしまっていなければいいのですが"}, {"type": "subtitle", "time": 12080.75, "timestamp": "03:21:20", "text": "長さ。こんにちは。私は手に入れた"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "ランチ。今日はご飯を食べます。それから私は"}, {"type": "subtitle", "time": 12087.19, "timestamp": "03:21:27", "text": "野菜カレーのような。思うに"}, {"type": "subtitle", "time": 12090.79, "timestamp": "03:21:30", "text": "豆、もしくはエンドウ豆かな。いいえ、エンドウ豆です。私"}, {"type": "subtitle", "time": 12093.59, "timestamp": "03:21:33", "text": "おしっこを推測する。ペ。いいえ、豆。豆だよ。"}, {"type": "subtitle", "time": 12096.07, "timestamp": "03:21:36", "text": "ええ、豆です。それからそれから私は"}, {"type": "subtitle", "time": 12097.63, "timestamp": "03:21:37", "text": "いくつかの"}, {"type": "subtitle", "time": 12100.389, "timestamp": "03:21:40", "text": "エビ。そう、小さなエビみたいに、"}, {"type": "subtitle", "time": 12101.63, "timestamp": "03:21:41", "text": "あなた"}, {"type": "subtitle", "time": 12105.11, "timestamp": "03:21:45", "text": "知る。ええ、私は何を手に入れたか"}, {"type": "subtitle", "time": 12107.91, "timestamp": "03:21:47", "text": "それを何と呼ぶ？えっと、それは何て言うんだっけ？"}, {"type": "subtitle", "time": 12112.389, "timestamp": "03:21:52", "text": "また？えっと、あの白い色って何？"}, {"type": "subtitle", "time": 12114.229, "timestamp": "03:21:54", "text": "牛乳みたいなものだけど、牛乳ではない。えっと"}, {"type": "subtitle", "time": 12116.59, "timestamp": "03:21:56", "text": "あれってなんて言うんだっけ？軽度。"}]
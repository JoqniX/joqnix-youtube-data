[{"type": "subtitle", "time": 9543.23, "timestamp": "02:39:03", "text": "できなかった。さあ"}, {"type": "subtitle", "time": 9546.55, "timestamp": "02:39:06", "text": "えっと、これをやってください。ホグワーツへ行こう"}, {"type": "subtitle", "time": 9548.429, "timestamp": "02:39:08", "text": "秘密の部屋の"}, {"type": "subtitle", "time": 9552.91, "timestamp": "02:39:12", "text": "要件を取得し、"}, {"type": "subtitle", "time": 9556.03, "timestamp": "02:39:16", "text": "ギヤ。えっと、それをどう言えばいいですか？秘密"}, {"type": "subtitle", "time": 9558.429, "timestamp": "02:39:18", "text": "部屋。これ"}, {"type": "subtitle", "time": 9562.55, "timestamp": "02:39:22", "text": "必要の部屋が1つ。わかった。えっと、私たちは"}, {"type": "subtitle", "time": 9566.95, "timestamp": "02:39:26", "text": "えーっと、えーっと、抽出する、または"}, {"type": "subtitle", "time": 9570.389, "timestamp": "02:39:30", "text": "抽出って、なんて言うんだっけ？おお、"}, {"type": "subtitle", "time": 9573.75, "timestamp": "02:39:33", "text": "こんにちは。デはあなたに会えてとても喜んでいます。こんにちは"}, {"type": "subtitle", "time": 9575.83, "timestamp": "02:39:35", "text": "そこには。部屋でこのバッグに気づきました"}, {"type": "subtitle", "time": 9577.75, "timestamp": "02:39:37", "text": "先日。助けるためには、それが必要です。"}, {"type": "subtitle", "time": 9580.55, "timestamp": "02:39:40", "text": "あなたの学校の課題。デは"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "これらは以前にも触れたものです。リュックサック。デはそれを"}, {"type": "subtitle", "time": 9592.07, "timestamp": "02:39:52", "text": "これは何ですか？"}, {"type": "subtitle", "time": 9594.23, "timestamp": "02:39:54", "text": "まるで掃除機みたいだ。最適"}, {"type": "subtitle", "time": 9599.19, "timestamp": "02:39:59", "text": "獣の収集と輸送。おお、"}]
[{"type": "subtitle", "time": 5167.87, "timestamp": "01:26:07", "text": "あれは溶岩ですか？"}, {"type": "subtitle", "time": 5171.709, "timestamp": "01:26:11", "text": "今。ここはどこ？どうやって、どれだけ"}, {"type": "subtitle", "time": 5174.709, "timestamp": "01:26:14", "text": "彼女は私たちをどこまで連れて行くのだろうか？はい、私たちは"}, {"type": "subtitle", "time": 5176.83, "timestamp": "01:26:16", "text": "こちらのよう。"}, {"type": "subtitle", "time": 5180.27, "timestamp": "01:26:20", "text": "おお、興味深い。わかった。"}, {"type": "subtitle", "time": 5182.91, "timestamp": "01:26:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5186.95, "timestamp": "01:26:26", "text": "ええと、以上です。わかった。デプルソ。話す"}, {"type": "subtitle", "time": 5190.11, "timestamp": "01:26:30", "text": "シロナと3本の箒。"}, {"type": "subtitle", "time": 5194.229, "timestamp": "01:26:34", "text": "わかった。私たちは別のものを手に入れます。"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "このゲームは、"}, {"type": "subtitle", "time": 5200.75, "timestamp": "01:26:40", "text": "より多くのスキルを与える"}, {"type": "subtitle", "time": 5204.709, "timestamp": "01:26:44", "text": "スロットマシンですが、一部の人は「ああ、"}, {"type": "subtitle", "time": 5207.91, "timestamp": "01:26:47", "text": "ジョッキーフォレストオーバーキルディオナ」しかし"}, {"type": "subtitle", "time": 5211.07, "timestamp": "01:26:51", "text": "たくさんの物がある"}, {"type": "subtitle", "time": 5213.31, "timestamp": "01:26:53", "text": "私は"}, {"type": "subtitle", "time": 5216.39, "timestamp": "01:26:56", "text": "えっと、なんで脈拍が"}, {"type": "subtitle", "time": 5219.07, "timestamp": "01:26:59", "text": "またここに来たの？"}]
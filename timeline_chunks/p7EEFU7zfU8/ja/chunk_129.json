[{"type": "subtitle", "time": 7744.669, "timestamp": "02:09:04", "text": "ルモス。わかった。取っていく"}, {"type": "subtitle", "time": 7768.03, "timestamp": "02:09:28", "text": "待って"}, {"type": "subtitle", "time": 7788.22, "timestamp": "02:09:48", "text": "えっと、３つ。ニース。"}, {"type": "subtitle", "time": 7795.589, "timestamp": "02:09:55", "text": "待って、どこに保管すればいいの？"}, {"type": "subtitle", "time": 7797.709, "timestamp": "02:09:57", "text": "ああ、一番上だ。一番上。"}]
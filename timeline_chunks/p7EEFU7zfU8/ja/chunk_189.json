[{"type": "subtitle", "time": 11346.43, "timestamp": "03:09:06", "text": "わかった、では"}, {"type": "subtitle", "time": 11370.03, "timestamp": "03:09:30", "text": "彼は良い人だ。"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "わかった。ああ、でも私もあなたに同じことをしたわ。"}, {"type": "subtitle", "time": 11376.63, "timestamp": "03:09:36", "text": "あなたはどうですか？私は餌を与えなかった"}, {"type": "subtitle", "time": 11379.55, "timestamp": "03:09:39", "text": "あなただけで十分です。"}]
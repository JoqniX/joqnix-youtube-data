[{"type": "subtitle", "time": 4026.309, "timestamp": "01:07:06", "text": "服？ああ、それはクロだ。それは"}, {"type": "subtitle", "time": 4028.309, "timestamp": "01:07:08", "text": "降伏。それはクロです。それは服です。"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "あそこに何かの椅子がある"}, {"type": "subtitle", "time": 4032.19, "timestamp": "01:07:12", "text": "いいね"}, {"type": "subtitle", "time": 4039.27, "timestamp": "01:07:19", "text": "奇妙な。そう、これだよ。これだよ。"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "これ？おお。わかった。とにかく、でもどこに"}, {"type": "subtitle", "time": 4050.15, "timestamp": "01:07:30", "text": "今日は何をするの？では、今日は"}, {"type": "subtitle", "time": 4053.589, "timestamp": "01:07:33", "text": "タイトルにあるように、私たちは"}, {"type": "subtitle", "time": 4055.789, "timestamp": "01:07:35", "text": "ビーストをやるつもりだ"}, {"type": "subtitle", "time": 4058.99, "timestamp": "01:07:38", "text": "教授が教える授業"}, {"type": "subtitle", "time": 4062.39, "timestamp": "01:07:42", "text": "ホビンド。私たちは蜂の巣を作り、学ぶつもりです"}, {"type": "subtitle", "time": 4066.63, "timestamp": "01:07:46", "text": "ミツバチや獣たちと冒険する方法"}, {"type": "subtitle", "time": 4071.309, "timestamp": "01:07:51", "text": "などなど。シャン、私たちにやらせてください"}]
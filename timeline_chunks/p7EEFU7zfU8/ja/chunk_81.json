[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "何かあったの、ポピー？改めて感謝申し上げます"}, {"type": "subtitle", "time": 4863.11, "timestamp": "01:21:03", "text": "あの野蛮人たちに何か言って"}, {"type": "subtitle", "time": 4865.75, "timestamp": "01:21:05", "text": "そうする必要はなかった。あなたは予兆でした"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "砂漠の正午。確かに正午には"}, {"type": "subtitle", "time": 4872.31, "timestamp": "01:21:12", "text": "祖母と私が言う意味"}, {"type": "subtitle", "time": 4874.79, "timestamp": "01:21:14", "text": "その何かまたは誰かが歓迎される"}, {"type": "subtitle", "time": 4877.43, "timestamp": "01:21:17", "text": "驚き。ああ、少なくとも私たちは"}, {"type": "subtitle", "time": 4879.59, "timestamp": "01:21:19", "text": "それが何を意味するのか、私はそう判断した。私はそこに立っていられなかった"}, {"type": "subtitle", "time": 4881.43, "timestamp": "01:21:21", "text": "そして、彼らがそのかわいそうな生き物を傷つけるのを見守る。"}, {"type": "subtitle", "time": 4884.55, "timestamp": "01:21:24", "text": "私たちは同じ考えを持っています。実際、"}, {"type": "subtitle", "time": 4886.709, "timestamp": "01:21:26", "text": "それを踏まえて、私が欲しい人がいる"}, {"type": "subtitle", "time": 4889.51, "timestamp": "01:21:29", "text": "森の中で会う。で"}, {"type": "subtitle", "time": 4891.11, "timestamp": "01:21:31", "text": "森。"}, {"type": "subtitle", "time": 4893.83, "timestamp": "01:21:33", "text": "ああ、興味をそそられました。それはとても"}, {"type": "subtitle", "time": 4897.11, "timestamp": "01:21:37", "text": "良い。先頭に立って進め。そうなることを期待していた。"}, {"type": "subtitle", "time": 4904.95, "timestamp": "01:21:44", "text": "ちょっと待って。そこにいる誰でもいい。実際には、"}, {"type": "subtitle", "time": 4908.229, "timestamp": "01:21:48", "text": "あなたが初めてです。本当に？その感覚"}, {"type": "subtitle", "time": 4910.55, "timestamp": "01:21:50", "text": "アニメーションってすごくかっこいいよね。うん。うん。こんにちは、"}, {"type": "subtitle", "time": 4913.43, "timestamp": "01:21:53", "text": "ハラサ。いらっしゃいませ。私たちは考え、幸せです"}, {"type": "subtitle", "time": 4917.189, "timestamp": "01:21:57", "text": "消える日のサプライズ"}, {"type": "subtitle", "time": 4919.75, "timestamp": "01:21:59", "text": "そして、ハッピー、えっと、待って、それから、おはようございます。"}]
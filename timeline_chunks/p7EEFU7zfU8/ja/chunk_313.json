[{"type": "subtitle", "time": 18782.788, "timestamp": "05:13:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18787.59, "timestamp": "05:13:07", "text": "再び下がるかもしれない。まだ。いいえ。そして下へ。"}, {"type": "subtitle", "time": 18789.59, "timestamp": "05:13:09", "text": "また。"}, {"type": "subtitle", "time": 18791.43, "timestamp": "05:13:11", "text": "大丈夫だよ。後で様子を見に行きます。"}, {"type": "subtitle", "time": 18793.15, "timestamp": "05:13:13", "text": "おお、"}, {"type": "subtitle", "time": 18806.07, "timestamp": "05:13:26", "text": "マーカーが盗聴していた"}, {"type": "subtitle", "time": 18809.43, "timestamp": "05:13:29", "text": "ヘッドホン。あ、こんにちは。頑張ってください"}, {"type": "subtitle", "time": 18811.61, "timestamp": "05:13:31", "text": "マーケットブロウ"}, {"type": "subtitle", "time": 18814.67, "timestamp": "05:13:34", "text": "[音楽]"}, {"type": "subtitle", "time": 18817.948, "timestamp": "05:13:37", "text": "片目で買い物をする"}, {"type": "subtitle", "time": 18829.948, "timestamp": "05:13:49", "text": "[音楽]"}, {"type": "subtitle", "time": 18832.93, "timestamp": "05:13:52", "text": "ニース。あなたは勝てない。"}]
[{"type": "subtitle", "time": 18724.31, "timestamp": "05:12:04", "text": "そこに、私はすでに"}, {"type": "subtitle", "time": 18734.23, "timestamp": "05:12:14", "text": "ああ、ここから下へ降りてください。私たちは"}, {"type": "subtitle", "time": 18739.47, "timestamp": "05:12:19", "text": "パズル。これは私がホグワーツに入学した最初の頃のことでした。"}, {"type": "subtitle", "time": 18742.43, "timestamp": "05:12:22", "text": "フレーム。鍵はすぐそこにあるはずです"}, {"type": "subtitle", "time": 18745.59, "timestamp": "05:12:25", "text": "そこに存在しているのに、私たちはそれを聞いていない、ということですよね？"}, {"type": "subtitle", "time": 18748.35, "timestamp": "05:12:28", "text": "つまり、私たちはすでに集められているということです"}, {"type": "subtitle", "time": 18752.15, "timestamp": "05:12:32", "text": "そうだと思います。"}, {"type": "subtitle", "time": 18754.59, "timestamp": "05:12:34", "text": "彼らはそれらをどうするつもりですか？"}, {"type": "subtitle", "time": 18758.07, "timestamp": "05:12:38", "text": "学生？このままでいいですか？"}, {"type": "subtitle", "time": 18759.83, "timestamp": "05:12:39", "text": "何？ばかげたことを言うな。効果が切れるまで"}, {"type": "subtitle", "time": 18764.15, "timestamp": "05:12:44", "text": "いくつか。あなたはそうは思っていないようですね。"}]
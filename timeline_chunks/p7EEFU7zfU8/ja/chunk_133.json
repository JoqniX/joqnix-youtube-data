[{"type": "subtitle", "time": 7986.069, "timestamp": "02:13:06", "text": "えっと、ルモス。何てことだ。"}, {"type": "subtitle", "time": 7992.99, "timestamp": "02:13:12", "text": "完璧に？誰か「言う」って言えるかな？"}, {"type": "subtitle", "time": 7996.55, "timestamp": "02:13:16", "text": "自分？ああ、こうするべきなんだ"}, {"type": "subtitle", "time": 8013.43, "timestamp": "02:13:33", "text": "いいえ。いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 8015.189, "timestamp": "02:13:35", "text": "いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "あそこに1つあります。ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 8031.95, "timestamp": "02:13:51", "text": "また。一体何なんだ"}, {"type": "subtitle", "time": 8037.069, "timestamp": "02:13:57", "text": "このゲームの物理法則における何が"}]
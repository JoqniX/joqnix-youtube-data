[{"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "私は何人か殺したい。   下着なしで行くよ"}, {"type": "subtitle", "time": 3621.349, "timestamp": "01:00:21", "text": "ヘリコプターを見かけたら、"}, {"type": "subtitle", "time": 3642.15, "timestamp": "01:00:42", "text": "おお、"}, {"type": "subtitle", "time": 3645.67, "timestamp": "01:00:45", "text": "敵が見える。"}, {"type": "subtitle", "time": 3652.39, "timestamp": "01:00:52", "text": "それは攻撃だ。"}, {"type": "subtitle", "time": 3655.109, "timestamp": "01:00:55", "text": "あれは攻撃ヘリコプターだ。 そして、あそこにいたのは"}, {"type": "subtitle", "time": 3658.15, "timestamp": "01:00:58", "text": "選手だった。   あいつ、一体"}]
[{"type": "subtitle", "time": 4149.99, "timestamp": "01:09:09", "text": "もし私がファイルガンを持っていたら、"}, {"type": "subtitle", "time": 4153.669, "timestamp": "01:09:13", "text": "ヘリコプターを至近距離から撃ち落とせたはずだ。"}, {"type": "subtitle", "time": 4166.789, "timestamp": "01:09:26", "text": "少なくとも、こうやって間接的にお金を稼いでいるのはいいことだ"}, {"type": "subtitle", "time": 4175.669, "timestamp": "01:09:35", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 4177.59, "timestamp": "01:09:37", "text": "捕まった。 捕まった。"}]
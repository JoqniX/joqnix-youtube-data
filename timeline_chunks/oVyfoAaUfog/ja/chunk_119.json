[{"type": "subtitle", "time": 7142.55, "timestamp": "01:59:02", "text": "はい、私は彼を殴りました。"}, {"type": "subtitle", "time": 7153.03, "timestamp": "01:59:13", "text": "ジョエントはいつも何かしらの用事で"}, {"type": "subtitle", "time": 7155.83, "timestamp": "01:59:15", "text": "忙しくしている。 おお。 私はそんなに"}, {"type": "subtitle", "time": 7177.91, "timestamp": "01:59:37", "text": "ああ、またゲームがカクカクして、"}, {"type": "subtitle", "time": 7181.35, "timestamp": "01:59:41", "text": "ビットレートも下がってる。"}]
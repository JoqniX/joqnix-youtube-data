[{"type": "subtitle", "time": 1043.11, "timestamp": "00:17:23", "text": "もし私が全力で操縦桿を握った場合、機体は"}, {"type": "subtitle", "time": 1046.71, "timestamp": "00:17:26", "text": "空中に留まるのでしょうか、それとも"}, {"type": "subtitle", "time": 1051.27, "timestamp": "00:17:31", "text": "私が設定した高度で空中に留まるのでしょうか？"}, {"type": "subtitle", "time": 1057.75, "timestamp": "00:17:37", "text": "標高が高い場所にある。"}, {"type": "subtitle", "time": 1078.71, "timestamp": "00:17:58", "text": "実際、鼻を高く上げている。 しかし"}]
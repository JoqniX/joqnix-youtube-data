[{"type": "subtitle", "time": 5522.07, "timestamp": "01:32:02", "text": "兄さんを連れて行って、おいで。 他の"}, {"type": "subtitle", "time": 5527.75, "timestamp": "01:32:07", "text": "あなたの言っていることを理解できない前に、早く入ってください。私は"}, {"type": "subtitle", "time": 5549.99, "timestamp": "01:32:29", "text": "他の人たち、他のヘリコプターも戻ってきている"}, {"type": "subtitle", "time": 5552.87, "timestamp": "01:32:32", "text": "。"}]
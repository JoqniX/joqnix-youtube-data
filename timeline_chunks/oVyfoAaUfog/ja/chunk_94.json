[{"type": "subtitle", "time": 5643.43, "timestamp": "01:34:03", "text": "ああ、くそ。 ああ、くそ。 ああ、くそ。 ああ、くそ。 ああ、くそ"}, {"type": "subtitle", "time": 5653.91, "timestamp": "01:34:13", "text": "ああ、クソスナイパーめ。"}, {"type": "subtitle", "time": 5679.03, "timestamp": "01:34:39", "text": "ああ、そうなんですか？ くそ。 彼は私を見捨てた。"}, {"type": "subtitle", "time": 5681.669, "timestamp": "01:34:41", "text": "これは一体どういう状況なのでしょうか？"}, {"type": "subtitle", "time": 5685.83, "timestamp": "01:34:45", "text": "これは一体何の地図ですか？   何てことだ"}, {"type": "subtitle", "time": 5693.51, "timestamp": "01:34:53", "text": "。 ああ。"}, {"type": "subtitle", "time": 5695.83, "timestamp": "01:34:55", "text": "ああ。 私は"}, {"type": "subtitle", "time": 5698.55, "timestamp": "01:34:58", "text": "こんなことをするべきではなかった。 来るべきだった。"}]
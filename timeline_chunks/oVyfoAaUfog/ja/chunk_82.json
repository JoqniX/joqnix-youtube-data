[{"type": "subtitle", "time": 4939.99, "timestamp": "01:22:19", "text": "少年たちはあなたを判断している。 何？"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "つまり、私は、私は、私は知っている。 知っている。 私は"}, {"type": "subtitle", "time": 4948.55, "timestamp": "01:22:28", "text": "安全策を取ろうとした。 私は"}, {"type": "subtitle", "time": 4951.669, "timestamp": "01:22:31", "text": "敵である彼らに、私を殺させなかった。 私は"}, {"type": "subtitle", "time": 4955.43, "timestamp": "01:22:35", "text": "交渉を試みた。 彼らは私を生かしてくれた。 しかし、"}, {"type": "subtitle", "time": 4958.629, "timestamp": "01:22:38", "text": "ゲームがクラッシュしてしまった。 私のパソコンの動作が"}, {"type": "subtitle", "time": 4961.03, "timestamp": "01:22:41", "text": "遅かった。 全てが遅延していた。 それは"}, {"type": "subtitle", "time": 4962.95, "timestamp": "01:22:42", "text": "残念だった。 実は、"}, {"type": "subtitle", "time": 4965.51, "timestamp": "01:22:45", "text": "復讐計画があったんです。"}, {"type": "subtitle", "time": 4968.31, "timestamp": "01:22:48", "text": "だから、それが要望として出ていればよかったのにと思います。 何？"}, {"type": "subtitle", "time": 4971.75, "timestamp": "01:22:51", "text": "チームを組んだことでアカウント停止になったのでしょうか？ 何？"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "何？   私もなんとなく"}, {"type": "subtitle", "time": 4976.709, "timestamp": "01:22:56", "text": "参加するけどね。"}, {"type": "subtitle", "time": 4979.75, "timestamp": "01:22:59", "text": "まあ、AKを持って"}]
[{"type": "subtitle", "time": 5311.75, "timestamp": "01:28:31", "text": "、たくさんありすぎる。 敵の"}, {"type": "subtitle", "time": 5323.35, "timestamp": "01:28:43", "text": "よし、戻るよ。 気をつけて。 俺はそこにいるぜ、相棒"}, {"type": "subtitle", "time": 5325.91, "timestamp": "01:28:45", "text": "。"}, {"type": "subtitle", "time": 5328.47, "timestamp": "01:28:48", "text": "君ならできるよ。"}, {"type": "subtitle", "time": 5332.31, "timestamp": "01:28:52", "text": "ああ、誰かが上に着陸している。"}]
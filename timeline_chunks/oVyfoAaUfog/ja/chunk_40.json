[{"type": "subtitle", "time": 2408.71, "timestamp": "00:40:08", "text": "1人選手が加わった。"}, {"type": "subtitle", "time": 2412.069, "timestamp": "00:40:12", "text": "あと1つ。"}, {"type": "subtitle", "time": 2415.589, "timestamp": "00:40:15", "text": "うん。 良い。 良い。 良い。 もう空きスペースがありません"}, {"type": "subtitle", "time": 2417.349, "timestamp": "00:40:17", "text": "。"}, {"type": "subtitle", "time": 2419.829, "timestamp": "00:40:19", "text": "さあ、"}, {"type": "subtitle", "time": 2435.91, "timestamp": "00:40:35", "text": "ここに着陸する方が安全だと感じる。 彼らは"}, {"type": "subtitle", "time": 2439.109, "timestamp": "00:40:39", "text": "そこに行ってゆっくり入っていくことができると確信しています。私が"}, {"type": "subtitle", "time": 2442.15, "timestamp": "00:40:42", "text": "頭の片隅で"}, {"type": "subtitle", "time": 2444.47, "timestamp": "00:40:44", "text": "ここに着陸したいと言うよりも、木が多すぎて"}, {"type": "subtitle", "time": 2446.443, "timestamp": "00:40:46", "text": "安全ではないからです。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 2450.95, "timestamp": "00:40:50", "text": "だから、わからない。 彼らが"}]
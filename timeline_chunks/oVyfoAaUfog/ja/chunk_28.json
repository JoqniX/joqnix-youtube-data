[{"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "完璧な着陸だった。 わーい。"}, {"type": "subtitle", "time": 1700.389, "timestamp": "00:28:20", "text": "実際に着陸しました。 何てことだ。 何てことだ。"}, {"type": "subtitle", "time": 1703.029, "timestamp": "00:28:23", "text": "いいえ。さて、ここからが本題です。 私は"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "物資を届けるだけです。"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "ああ、お金が入ってくるんだ。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "。 ゆっくり、ゆっくり、ゆっくり。"}, {"type": "subtitle", "time": 1717.11, "timestamp": "00:28:37", "text": "そしてGキーを押してください。やった！"}, {"type": "subtitle", "time": 1721.269, "timestamp": "00:28:41", "text": "パイロットレベル2。"}, {"type": "subtitle", "time": 1724.149, "timestamp": "00:28:44", "text": "さあ、ゆっくりと上へ戻っていく"}, {"type": "subtitle", "time": 1728.07, "timestamp": "00:28:48", "text": "。 では、私が"}, {"type": "subtitle", "time": 1732.07, "timestamp": "00:28:52", "text": "言っていたことに戻りましょう。 マウスをここに移動してください。 なぜ？ わかった。"}, {"type": "subtitle", "time": 1734.789, "timestamp": "00:28:54", "text": "待って。"}, {"type": "subtitle", "time": 1737.83, "timestamp": "00:28:57", "text": "きちんとファイリングする方法を学ばなければならない。 うん、"}]
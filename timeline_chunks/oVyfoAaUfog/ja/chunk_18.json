[{"type": "subtitle", "time": 1081.59, "timestamp": "00:18:01", "text": "問題は、それが漂流してしまうことだ。 いいえ、"}, {"type": "subtitle", "time": 1085.19, "timestamp": "00:18:05", "text": "後退します。 私はそれが好きではありません。"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "私が何をしているのか不思議に思っているでしょう？ 今、"}, {"type": "subtitle", "time": 1125.19, "timestamp": "00:18:45", "text": "そして私たちはゆっくりとこちらへ降りていきます"}, {"type": "subtitle", "time": 1128.789, "timestamp": "00:18:48", "text": "。"}, {"type": "subtitle", "time": 1135.99, "timestamp": "00:18:55", "text": "ええと、それは"}, {"type": "subtitle", "time": 1138.39, "timestamp": "00:18:58", "text": "不時着です。"}]
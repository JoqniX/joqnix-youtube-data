[{"type": "subtitle", "time": 1987.909, "timestamp": "00:33:07", "text": "ええ、下降しようとしています。 なぜこんなに"}, {"type": "subtitle", "time": 1991.75, "timestamp": "00:33:11", "text": "時間がかかるのですか？ 私はこれが得意ではありません"}, {"type": "subtitle", "time": 2006.71, "timestamp": "00:33:26", "text": "おい、"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "抽出しろ。 ありがとう。"}, {"type": "subtitle", "time": 2012.549, "timestamp": "00:33:32", "text": "基地ではなくここに降ろしてしまってごめんなさい。私は下手なんです。"}, {"type": "subtitle", "time": 2015.83, "timestamp": "00:33:35", "text": "ああ、よかった、よかった、よかった。"}, {"type": "subtitle", "time": 2018.07, "timestamp": "00:33:38", "text": "いや、いや、いや、いや。 ああ、ああ、神様ありがとう。 ああ、助かった"}, {"type": "subtitle", "time": 2019.59, "timestamp": "00:33:39", "text": "。"}, {"type": "subtitle", "time": 2022.95, "timestamp": "00:33:42", "text": "そして今、私は基地にいます。  Gキーをもう少し押してください"}, {"type": "subtitle", "time": 2026.389, "timestamp": "00:33:46", "text": "。"}, {"type": "subtitle", "time": 2031.269, "timestamp": "00:33:51", "text": "えっと、Gキーを押してください。はい。"}, {"type": "subtitle", "time": 2034.63, "timestamp": "00:33:54", "text": "ああ、レベル３か。 さあ行こう。 もっと。 もっと。"}, {"type": "subtitle", "time": 2037.909, "timestamp": "00:33:57", "text": "顧客数を増やす。 さあ行こう。 私は空飛ぶ"}]
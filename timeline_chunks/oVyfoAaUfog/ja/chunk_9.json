[{"type": "subtitle", "time": 545.99, "timestamp": "00:09:05", "text": "。   ちょっと待ってください"}, {"type": "subtitle", "time": 548.55, "timestamp": "00:09:08", "text": "。"}, {"type": "subtitle", "time": 553.11, "timestamp": "00:09:13", "text": "再読み込み中。正直なところ、"}, {"type": "subtitle", "time": 558.31, "timestamp": "00:09:18", "text": "何らかの方法で"}, {"type": "subtitle", "time": 562.15, "timestamp": "00:09:22", "text": "画面上で明らかな裏切りを見ることができれば、とても嬉しいです"}, {"type": "subtitle", "time": 565.91, "timestamp": "00:09:25", "text": "。 とにかく、"}, {"type": "subtitle", "time": 570.71, "timestamp": "00:09:30", "text": "私がそれを頼んだ理由は、"}, {"type": "subtitle", "time": 574.63, "timestamp": "00:09:34", "text": "このドメトリのインターネット接続が悪いからです。 それを知っている"}, {"type": "subtitle", "time": 578.15, "timestamp": "00:09:38", "text": "。 裏切りがひどい場合を知りたい。そうすれば、何らかの方法で知ることが"}, {"type": "subtitle", "time": 582.31, "timestamp": "00:09:42", "text": "できる"}, {"type": "subtitle", "time": 585.75, "timestamp": "00:09:45", "text": "。 ああ、ちょっと問題が発生しているみたいですね"}, {"type": "subtitle", "time": 595.829, "timestamp": "00:09:55", "text": "そう、これがポテトモードです。"}]
[{"type": "subtitle", "time": 2295.43, "timestamp": "00:38:15", "text": "ああ、パレットは使えないんですね。 ちくしょう。 なぜ私は"}, {"type": "subtitle", "time": 2298.71, "timestamp": "00:38:18", "text": "500番のスロットを割り当てられているのですか？"}, {"type": "subtitle", "time": 2301.109, "timestamp": "00:38:21", "text": "今は小さな木箱だけなら運べる。"}, {"type": "subtitle", "time": 2326.79, "timestamp": "00:38:46", "text": "プレイヤーはいますか？ プレイヤーはいません。 死者は出なかった。"}, {"type": "subtitle", "time": 2329.99, "timestamp": "00:38:49", "text": "ええ、確かに亡くなっている人もいます。"}, {"type": "subtitle", "time": 2334.069, "timestamp": "00:38:54", "text": "誰でも？ 誰も。 誰でも？"}, {"type": "subtitle", "time": 2335.829, "timestamp": "00:38:55", "text": "おお。"}, {"type": "subtitle", "time": 2338.79, "timestamp": "00:38:58", "text": "私は文字通り空飛ぶUber Dです。さあ。"}]
[{"type": "subtitle", "time": 2225.67, "timestamp": "00:37:05", "text": "H地点に到達したが、青チームは実際には勝っていない。"}, {"type": "subtitle", "time": 2228.15, "timestamp": "00:37:08", "text": "こんにちは、カダサ。"}, {"type": "subtitle", "time": 2236.95, "timestamp": "00:37:16", "text": "久しぶりにストリーミング配信。 ええ、"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "正直に言うと、配信したかったんです。 でも木曜日"}, {"type": "subtitle", "time": 2243.27, "timestamp": "00:37:23", "text": "と金曜日は、2つ目の"}, {"type": "subtitle", "time": 2248.55, "timestamp": "00:37:28", "text": "アルバイトをしていたんです。 えっと、それで、"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "電車に乗って家に帰って"}, {"type": "subtitle", "time": 2254.79, "timestamp": "00:37:34", "text": "、"}, {"type": "subtitle", "time": 2257.43, "timestamp": "00:37:37", "text": "夕食を食べた後、歩いて家に帰ったのは10時頃でした。 あまりにも疲れていたので、そのまま眠ってしまった"}, {"type": "subtitle", "time": 2260.55, "timestamp": "00:37:40", "text": "。 午前3時"}, {"type": "subtitle", "time": 2264.55, "timestamp": "00:37:44", "text": "か4時頃に目が覚めたと思う。配信したかったんだけどできなかった"}, {"type": "subtitle", "time": 2267.19, "timestamp": "00:37:47", "text": "。"}]
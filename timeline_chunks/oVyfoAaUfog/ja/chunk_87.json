[{"type": "subtitle", "time": 5222.47, "timestamp": "01:27:02", "text": "。入って。うん。 どうぞ入って。うん。 うん。"}, {"type": "subtitle", "time": 5226.95, "timestamp": "01:27:06", "text": "顧客が増えれば増えるほど、収入も増える。"}, {"type": "subtitle", "time": 5232.31, "timestamp": "01:27:12", "text": "彼は一体何で死んだんだ？ 彼はチームを移籍したばかりなのか"}, {"type": "subtitle", "time": 5247.03, "timestamp": "01:27:27", "text": "。 たとえそれが一人であっても。 さあ行こうぜ"}, {"type": "subtitle", "time": 5249.35, "timestamp": "01:27:29", "text": "。"}, {"type": "subtitle", "time": 5251.99, "timestamp": "01:27:31", "text": "おいおい、こいつはパーティーの点数が満点だな。"}, {"type": "subtitle", "time": 5254.87, "timestamp": "01:27:34", "text": "彼を見て。"}, {"type": "subtitle", "time": 5262.55, "timestamp": "01:27:42", "text": "せめて物資くらいは持って行くべきだった。"}, {"type": "subtitle", "time": 5264.87, "timestamp": "01:27:44", "text": "こんにちは、"}]
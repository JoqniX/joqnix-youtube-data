[{"type": "subtitle", "time": 3964.23, "timestamp": "01:06:04", "text": "ない。"}, {"type": "subtitle", "time": 3967.589, "timestamp": "01:06:07", "text": "でも、私ならできたはずだ。"}, {"type": "subtitle", "time": 3978.069, "timestamp": "01:06:18", "text": "待って。 あのヘルはどこへ行ったんだ？ それはここ"}, {"type": "subtitle", "time": 3980.069, "timestamp": "01:06:20", "text": "から来た。"}, {"type": "subtitle", "time": 3985.67, "timestamp": "01:06:25", "text": "ああ、もう。 待って。 そこが彼らの拠点かもしれない。"}, {"type": "subtitle", "time": 3988.95, "timestamp": "01:06:28", "text": "ああ、今あそこから来ている。"}, {"type": "subtitle", "time": 4017.829, "timestamp": "01:06:57", "text": "。 私は潜入している"}]
[{"type": "subtitle", "time": 7293.03, "timestamp": "02:01:33", "text": "私は友人の先輩の"}, {"type": "subtitle", "time": 7301.43, "timestamp": "02:01:41", "text": "誕生日パーティーに行きました。 彼は美味しい料理を作った。"}, {"type": "subtitle", "time": 7304.95, "timestamp": "02:01:44", "text": "チキンカレー関連のものがたくさん。"}, {"type": "subtitle", "time": 7310.47, "timestamp": "02:01:50", "text": "グリルチキンカレーなど、さまざまな種類のカレー。 あれこれ"}, {"type": "subtitle", "time": 7313.83, "timestamp": "02:01:53", "text": "。 あれこれ。 とても良かったです。"}, {"type": "subtitle", "time": 7318.79, "timestamp": "02:01:58", "text": "そこで食事をして、映画を見て、戻ってきました"}]
[{"type": "subtitle", "time": 5341.91, "timestamp": "01:29:01", "text": "もし私が攻撃ヘリコプターをアンロックしていたら、もし私が"}, {"type": "subtitle", "time": 5345.03, "timestamp": "01:29:05", "text": "攻撃ヘリコプターをアンロックしていたら、"}, {"type": "subtitle", "time": 5348.55, "timestamp": "01:29:08", "text": "今頃は撃ち落としていただろう。"}, {"type": "subtitle", "time": 5357.27, "timestamp": "01:29:17", "text": "待って、私はお金を受け取っていません"}, {"type": "subtitle", "time": 5359.83, "timestamp": "01:29:19", "text": "。"}, {"type": "subtitle", "time": 5367.75, "timestamp": "01:29:27", "text": "あの男を運んだのに、お金はもらえなかったじゃないか。 彼は死んだのか"}]
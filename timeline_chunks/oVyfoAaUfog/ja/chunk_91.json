[{"type": "subtitle", "time": 5463.51, "timestamp": "01:31:03", "text": "え、彼はもう行ってしまったの？ なんてこった？ なんてこった"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "ああ、もう、本当に腹が立つ。 私が"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "ちょっと物資を買ったからって、あなたは"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "出て行かなきゃいけなかったの？ 離れる。 冗談でしょう"}, {"type": "subtitle", "time": 5490.95, "timestamp": "01:31:30", "text": "いや。"}]
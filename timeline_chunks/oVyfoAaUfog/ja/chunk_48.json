[{"type": "subtitle", "time": 2882.23, "timestamp": "00:48:02", "text": "。 誰も来ないよ、兄弟。"}, {"type": "subtitle", "time": 2885.109, "timestamp": "00:48:05", "text": "もしかしたらこのトラックが来るかもしれない。"}, {"type": "subtitle", "time": 2891.99, "timestamp": "00:48:11", "text": "さあ。 私を蘇らせてください。"}, {"type": "subtitle", "time": 2894.79, "timestamp": "00:48:14", "text": "ヒッチハイクで家に帰りたいんです。 基地に戻る。 リスポーンしたくない。"}, {"type": "subtitle", "time": 2898.56, "timestamp": "00:48:18", "text": "リスポーンしたくない。 うん、それは楽しいね。"}, {"type": "subtitle", "time": 2930.069, "timestamp": "00:48:50", "text": "誰も行かないよ。"}, {"type": "subtitle", "time": 2931.99, "timestamp": "00:48:51", "text": "リスポーンボタンを押します。   ちくしょう"}]
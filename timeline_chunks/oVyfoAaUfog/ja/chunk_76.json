[{"type": "subtitle", "time": 4577.189, "timestamp": "01:16:17", "text": "怖くなった。 ごめんなさい。 ごめんなさい。 怖かった"}, {"type": "subtitle", "time": 4591.35, "timestamp": "01:16:31", "text": "君は私たちを攻撃できない。"}, {"type": "subtitle", "time": 4593.75, "timestamp": "01:16:33", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 4596.709, "timestamp": "01:16:36", "text": "武器を取ることができます。 偵察のレベルを上げたいだけです"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "私の武器は持って行っていいよ。 私はただ"}, {"type": "subtitle", "time": 4611.83, "timestamp": "01:16:51", "text": "。  1秒。"}, {"type": "subtitle", "time": 4615.43, "timestamp": "01:16:55", "text": "もし望むなら、私の武器をあげよう。 私はただ自分の"}, {"type": "subtitle", "time": 4616.79, "timestamp": "01:16:56", "text": "スカウトが欲しいだけです。 ありがとう。"}]
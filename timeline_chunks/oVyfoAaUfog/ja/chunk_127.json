[{"type": "subtitle", "time": 7620.39, "timestamp": "02:07:00", "text": "誰が単発弾薬でそれを装着したのか？"}, {"type": "subtitle", "time": 7642.069, "timestamp": "02:07:22", "text": "ああ、彼は弓を持っているよ。"}, {"type": "subtitle", "time": 7643.99, "timestamp": "02:07:23", "text": "彼の荷物を全部出してあげたい。 私は"}, {"type": "subtitle", "time": 7673.75, "timestamp": "02:07:53", "text": "よし、弓を手に入れた。 弓を手に入れた。"}]
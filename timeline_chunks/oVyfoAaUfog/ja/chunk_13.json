[{"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "。 設定を変更できません。"}, {"type": "subtitle", "time": 785.43, "timestamp": "00:13:05", "text": "設定を変更すると、"}, {"type": "subtitle", "time": 788.47, "timestamp": "00:13:08", "text": "設定ファイルが壊れてしまいます。 ああ、しまった"}, {"type": "subtitle", "time": 790.79, "timestamp": "00:13:10", "text": "。"}, {"type": "subtitle", "time": 794.71, "timestamp": "00:13:14", "text": "しかし、あくびのピッチは、"}, {"type": "subtitle", "time": 799.91, "timestamp": "00:13:19", "text": "ほとんどの側面の弱い軸を持っています。 つまり、"}, {"type": "subtitle", "time": 802.47, "timestamp": "00:13:22", "text": "フィルターを破壊するってことだ"}, {"type": "subtitle", "time": 804.71, "timestamp": "00:13:24", "text": "。   ああ"}, {"type": "subtitle", "time": 823.99, "timestamp": "00:13:43", "text": "ああ、いい着陸だったね。 はい、もう一度"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "後ろ向きに飛ぶ方法を学ぶべきだ。"}]
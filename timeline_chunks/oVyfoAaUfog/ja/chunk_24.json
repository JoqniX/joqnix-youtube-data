[{"type": "subtitle", "time": 1440.07, "timestamp": "00:24:00", "text": "誕生日パーティーみたいなのに出席しなきゃいけなかったんです。 私のミスです"}, {"type": "subtitle", "time": 1443.029, "timestamp": "00:24:03", "text": "。"}, {"type": "subtitle", "time": 1446.63, "timestamp": "00:24:06", "text": "そして私たちは美味しいものを食べました。"}, {"type": "subtitle", "time": 1450.23, "timestamp": "00:24:10", "text": "それから一緒に映画を見て、"}, {"type": "subtitle", "time": 1452.71, "timestamp": "00:24:12", "text": "先輩たちと時間を過ごしてから、家に帰りました"}, {"type": "subtitle", "time": 1457.75, "timestamp": "00:24:17", "text": "。   ええ"}, {"type": "subtitle", "time": 1459.99, "timestamp": "00:24:19", "text": "、ここにいますよ"}, {"type": "subtitle", "time": 1472.789, "timestamp": "00:24:32", "text": "男が今一体何を"}]
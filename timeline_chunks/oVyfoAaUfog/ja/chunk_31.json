[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "家に帰りたい人いますか？"}, {"type": "subtitle", "time": 1864.149, "timestamp": "00:31:04", "text": "さあ、どうぞ。"}, {"type": "subtitle", "time": 1865.909, "timestamp": "00:31:05", "text": "ラグはありません。"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "それで構いません。 でも、問題は"}, {"type": "subtitle", "time": 1877.43, "timestamp": "00:31:17", "text": "？ できるだけ滑らかな動きを望んでいます"}, {"type": "subtitle", "time": 1879.35, "timestamp": "00:31:19", "text": "。"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "しかも彼らはプロのパイロットだ。"}, {"type": "subtitle", "time": 1884.149, "timestamp": "00:31:24", "text": "彼が飛んでいるのを見て。"}, {"type": "subtitle", "time": 1886.789, "timestamp": "00:31:26", "text": "なぜ人がいないのか？ 私のものに乗って。"}, {"type": "subtitle", "time": 1889.279, "timestamp": "00:31:29", "text": "私のものに乗って。 よし、誰かが来るぞ。 どうぞ"}, {"type": "subtitle", "time": 1891.84, "timestamp": "00:31:31", "text": "よし、誰かが来るぞ。 どうぞ 私のところに来てください。どうぞ私のところに来てください。いいえ、"}, {"type": "subtitle", "time": 1894.48, "timestamp": "00:31:34", "text": "私のところに来てください。どうぞ私のところに来てください。いいえ、 降りないでください。 うん。 私に乗って。 はい、と答えてください。 はい。"}, {"type": "subtitle", "time": 1896.48, "timestamp": "00:31:36", "text": "降りないでください。 うん。 私に乗って。 はい、と答えてください。 はい。 はい。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 1904.95, "timestamp": "00:31:44", "text": "もっと多くのプレイヤー。 来て。 来て。 来て。"}, {"type": "subtitle", "time": 1908.149, "timestamp": "00:31:48", "text": "うん。 来て。 来て。 来て。 私はあなたが欲しいです。"}, {"type": "subtitle", "time": 1910.71, "timestamp": "00:31:50", "text": "いいえ。こちらへ来てください。 ここに来て。 ここに来て"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "。 ここに来て。 はい。 はい。 はい。 はい。"}]
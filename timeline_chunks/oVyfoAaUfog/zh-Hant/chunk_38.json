[{"type": "subtitle", "time": 2295.43, "timestamp": "00:38:15", "text": "啊，不能用托盤。該死。為什麼我的名額是500？"}, {"type": "subtitle", "time": 2298.71, "timestamp": "00:38:18", "text": "我現在可以帶走一個"}, {"type": "subtitle", "time": 2301.109, "timestamp": "00:38:21", "text": "小箱子了。  好的，我們來談談燃料。  嗯，四個降落傘。  有玩家嗎？沒有"}, {"type": "subtitle", "time": 2326.79, "timestamp": "00:38:46", "text": "玩家。無人死亡。  是的，確實有人在死。  有人嗎？沒有人。有人嗎？"}, {"type": "subtitle", "time": 2335.829, "timestamp": "00:38:55", "text": "哇。"}, {"type": "subtitle", "time": 2338.79, "timestamp": "00:38:58", "text": "我簡直就是空中優步D。拜託。我需要"}]
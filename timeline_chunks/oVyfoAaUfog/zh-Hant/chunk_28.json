[{"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "我完美著陸了。耶。"}, {"type": "subtitle", "time": 1700.389, "timestamp": "00:28:20", "text": "我已經著陸了。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 1703.029, "timestamp": "00:28:23", "text": "不。現在到了最重要的部分。我只需要把"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "物資送過去。"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "哦，我要拿到錢了。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "好的。慢慢來，慢慢來，慢慢來。"}, {"type": "subtitle", "time": 1717.11, "timestamp": "00:28:37", "text": "然後按"}, {"type": "subtitle", "time": 1721.269, "timestamp": "00:28:41", "text": "G鍵。耶！二級飛行員。"}, {"type": "subtitle", "time": 1724.149, "timestamp": "00:28:44", "text": "現在我慢慢地往回走"}, {"type": "subtitle", "time": 1728.07, "timestamp": "00:28:48", "text": "。所以，回到我剛才"}, {"type": "subtitle", "time": 1732.07, "timestamp": "00:28:52", "text": "說的話。將滑鼠移到這裡。為什麼？好的。"}, {"type": "subtitle", "time": 1734.789, "timestamp": "00:28:54", "text": "等待。我必須學習如何"}, {"type": "subtitle", "time": 1737.83, "timestamp": "00:28:57", "text": "正確歸檔。是的，我需要提升一下"}]
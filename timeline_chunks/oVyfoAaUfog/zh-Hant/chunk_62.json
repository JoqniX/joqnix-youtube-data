[{"type": "subtitle", "time": 3733.51, "timestamp": "01:02:13", "text": "只要我不被抓到，我就可以……"}, {"type": "subtitle", "time": 3735.43, "timestamp": "01:02:15", "text": "那傢伙在狙擊。我聽到他"}, {"type": "subtitle", "time": 3739.27, "timestamp": "01:02:19", "text": "開槍的聲音。我聽到他開槍的聲音。"}, {"type": "subtitle", "time": 3741.27, "timestamp": "01:02:21", "text": "我只需要知道他的具體位置。"}, {"type": "subtitle", "time": 3744.87, "timestamp": "01:02:24", "text": "它現在應該已經過期了。"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "哦，我看到他了。我看見他了。"}, {"type": "subtitle", "time": 3752.63, "timestamp": "01:02:32", "text": "他正在這裡進行狙擊。這邊。"}, {"type": "subtitle", "time": 3755.43, "timestamp": "01:02:35", "text": "但是，我該冒這個險嗎？難道沒有"}, {"type": "subtitle", "time": 3758.39, "timestamp": "01:02:38", "text": "比他更優秀的人嗎？"}, {"type": "subtitle", "time": 3770.87, "timestamp": "01:02:50", "text": "檢查邊角。檢查每一棟建築物。"}, {"type": "subtitle", "time": 3779.589, "timestamp": "01:02:59", "text": "即使現在沒有陰影，"}]
[{"type": "subtitle", "time": 4149.99, "timestamp": "01:09:09", "text": "如果我有一把銼刀槍，我就可以近距離"}, {"type": "subtitle", "time": 4153.669, "timestamp": "01:09:13", "text": "射擊那架直升機了。"}, {"type": "subtitle", "time": 4166.789, "timestamp": "01:09:26", "text": "至少我還能透過這種方式間接賺錢"}, {"type": "subtitle", "time": 4175.669, "timestamp": "01:09:35", "text": "。"}, {"type": "subtitle", "time": 4177.59, "timestamp": "01:09:37", "text": "我被抓住了。我被抓住了。"}, {"type": "subtitle", "time": 4182.149, "timestamp": "01:09:42", "text": "我被抓住了。  我被抓住了。我被抓住了。我被抓住了。"}]
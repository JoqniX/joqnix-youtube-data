[{"type": "subtitle", "time": 663.11, "timestamp": "00:11:03", "text": "還是我在做什麼？"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "痛苦的是轉身的過程。我能"}, {"type": "subtitle", "time": 680.63, "timestamp": "00:11:20", "text": "理解。"}, {"type": "subtitle", "time": 685.75, "timestamp": "00:11:25", "text": "轉彎有點難。"}, {"type": "subtitle", "time": 700.47, "timestamp": "00:11:40", "text": "撞到樹了。什麼？我怎麼"}]
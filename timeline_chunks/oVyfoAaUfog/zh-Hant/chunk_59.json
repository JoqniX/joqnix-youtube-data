[{"type": "subtitle", "time": 3559.349, "timestamp": "00:59:19", "text": "好吧，我可能只要把"}, {"type": "subtitle", "time": 3568.309, "timestamp": "00:59:28", "text": "這些不是我的嗎？為什麼沒有人存入"}, {"type": "subtitle", "time": 3577.67, "timestamp": "00:59:37", "text": "哦，他們有個叫Sam的人。"}, {"type": "subtitle", "time": 3588.95, "timestamp": "00:59:48", "text": "應該出去打獵。我不"}, {"type": "subtitle", "time": 3598.95, "timestamp": "00:59:58", "text": "拜託各位。我們去打獵吧。"}]
[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "我的落地技巧。我不擅長這個。"}, {"type": "subtitle", "time": 1744.47, "timestamp": "00:29:04", "text": "直升機降落花了一些時間，不過"}, {"type": "subtitle", "time": 1746.63, "timestamp": "00:29:06", "text": "沒關係。回到我剛才"}, {"type": "subtitle", "time": 1749.029, "timestamp": "00:29:09", "text": "說的。嗯，"}, {"type": "subtitle", "time": 1751.43, "timestamp": "00:29:11", "text": "是的，我覺得目前我不知道"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "直播品質如何，是不是有"}, {"type": "subtitle", "time": 1757.75, "timestamp": "00:29:17", "text": "點卡頓？我目前甚至嘗試"}, {"type": "subtitle", "time": 1761.19, "timestamp": "00:29:21", "text": "修改遊戲內的配置"}, {"type": "subtitle", "time": 1764.47, "timestamp": "00:29:24", "text": "文件，把"}, {"type": "chat", "time": 1765.359, "timestamp": "00:29:25", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "it's good"}, {"type": "subtitle", "time": 1767.029, "timestamp": "00:29:27", "text": "所有設定都調到最低。"}, {"type": "subtitle", "time": 1769.43, "timestamp": "00:29:29", "text": "嗯，"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "低設定。感覺有延遲，"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "動作不夠流暢。  所以"}, {"type": "subtitle", "time": 1778.95, "timestamp": "00:29:38", "text": "我覺得我應該這麼做。所以我才"}, {"type": "subtitle", "time": 1782.23, "timestamp": "00:29:42", "text": "覺得，如果我"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "有了第二台電腦，我就可以把"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "直播"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "錄製的工作都轉移到那台電腦上。我只是把"}, {"type": "subtitle", "time": 1796.63, "timestamp": "00:29:56", "text": "當前遊戲畫面、"}, {"type": "subtitle", "time": 1799.51, "timestamp": "00:29:59", "text": "音訊之類的東西從我的筆記型電腦發送出去。"}]
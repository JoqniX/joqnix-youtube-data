[{"type": "subtitle", "time": 2346.15, "timestamp": "00:39:06", "text": "。他和我做的是同一"}, {"type": "subtitle", "time": 2349.03, "timestamp": "00:39:09", "text": "件事。好的，現在只有一個玩家。  請進，請進，請進。"}, {"type": "subtitle", "time": 2359.349, "timestamp": "00:39:19", "text": "我的服務開始了。進來。我不會"}, {"type": "subtitle", "time": 2369.43, "timestamp": "00:39:29", "text": "抓住他。是的。是的。來。來。來。"}, {"type": "subtitle", "time": 2379.51, "timestamp": "00:39:39", "text": "哦，第三位玩家。好的。  第四名玩家。好的。哦，"}, {"type": "subtitle", "time": 2382.79, "timestamp": "00:39:42", "text": "他走了。他離開了。好的。"}, {"type": "subtitle", "time": 2385.51, "timestamp": "00:39:45", "text": "我會把所有"}, {"type": "subtitle", "time": 2387.67, "timestamp": "00:39:47", "text": "顧客都召集起來。  好的。進來。進來。來。"}, {"type": "subtitle", "time": 2391.99, "timestamp": "00:39:51", "text": "有人"}, {"type": "subtitle", "time": 2394.23, "timestamp": "00:39:54", "text": "買了"}]
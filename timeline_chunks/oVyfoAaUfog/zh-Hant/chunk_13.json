[{"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "無法更改設定。如果我更改設置，會搞亂"}, {"type": "subtitle", "time": 788.47, "timestamp": "00:13:08", "text": "設定檔。啊，真糟糕。"}, {"type": "subtitle", "time": 794.71, "timestamp": "00:13:14", "text": "但是打哈欠的俯仰角是大多數側面"}, {"type": "subtitle", "time": 799.91, "timestamp": "00:13:19", "text": "較弱的軸線。所以，這就是"}, {"type": "subtitle", "time": 802.47, "timestamp": "00:13:22", "text": "破壞過濾器的"}, {"type": "subtitle", "time": 804.71, "timestamp": "00:13:24", "text": "咒罵。  天哪，"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "應該學學怎麼倒飛。"}]
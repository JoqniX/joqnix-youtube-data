[{"type": "subtitle", "time": 2225.67, "timestamp": "00:37:05", "text": "H 點，藍隊實際上並沒有贏。"}, {"type": "subtitle", "time": 2228.15, "timestamp": "00:37:08", "text": "你好，卡達薩。"}, {"type": "subtitle", "time": 2236.95, "timestamp": "00:37:16", "text": "。是啊，說實話，我本來就想"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "直播。但在周四"}, {"type": "subtitle", "time": 2243.27, "timestamp": "00:37:23", "text": "和周五，我做了我的第二份"}, {"type": "subtitle", "time": 2248.55, "timestamp": "00:37:28", "text": "兼職工作。嗯，我"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "大概晚上 10 點坐火車回家，吃完晚餐後再步行回家。"}, {"type": "subtitle", "time": 2257.43, "timestamp": "00:37:37", "text": "我太累了，睡著了"}, {"type": "subtitle", "time": 2260.55, "timestamp": "00:37:40", "text": "。我想我大概凌晨三、四點就醒了。我想直播，"}, {"type": "subtitle", "time": 2264.55, "timestamp": "00:37:44", "text": "但是"}, {"type": "subtitle", "time": 2267.19, "timestamp": "00:37:47", "text": "沒能直播。"}]
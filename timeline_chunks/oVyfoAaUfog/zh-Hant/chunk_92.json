[{"type": "subtitle", "time": 5522.07, "timestamp": "01:32:02", "text": "布羅，過來。趕快說完，免得其他"}, {"type": "subtitle", "time": 5527.75, "timestamp": "01:32:07", "text": "你在說什麼，因為我不懂"}, {"type": "subtitle", "time": 5549.99, "timestamp": "01:32:29", "text": "其他人，其他直升機正在"}, {"type": "subtitle", "time": 5552.87, "timestamp": "01:32:32", "text": "返回。"}]
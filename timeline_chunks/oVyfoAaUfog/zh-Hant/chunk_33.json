[{"type": "subtitle", "time": 1987.909, "timestamp": "00:33:07", "text": "我正在嘗試下降。為什麼這麼"}, {"type": "subtitle", "time": 1991.75, "timestamp": "00:33:11", "text": "久？我不擅長這個。  嘿"}, {"type": "subtitle", "time": 2006.71, "timestamp": "00:33:26", "text": "，"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "提取。謝謝。很抱歉把你送到這裡而不是基地，因為我不"}, {"type": "subtitle", "time": 2015.83, "timestamp": "00:33:35", "text": "擅長……哦，好，好，好。  不，不，不，不。哦，"}, {"type": "subtitle", "time": 2018.07, "timestamp": "00:33:38", "text": "哦，感謝"}, {"type": "subtitle", "time": 2019.59, "timestamp": "00:33:39", "text": "上帝。感謝上帝。"}, {"type": "subtitle", "time": 2022.95, "timestamp": "00:33:42", "text": "現在我到了這裡，也就是基地。再稍微按一下 G 鍵。"}, {"type": "subtitle", "time": 2031.269, "timestamp": "00:33:51", "text": "呃，然後按 G 鍵。好的。"}, {"type": "subtitle", "time": 2034.63, "timestamp": "00:33:54", "text": "哦，三級。我們走吧。更多的。更多的。  更多"}, {"type": "subtitle", "time": 2037.909, "timestamp": "00:33:57", "text": "顧客。我們走吧。我是空中優步。  他媽的。"}]
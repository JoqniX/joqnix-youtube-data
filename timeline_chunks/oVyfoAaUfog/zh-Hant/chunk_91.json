[{"type": "subtitle", "time": 5463.51, "timestamp": "01:31:03", "text": "等等，他走了嗎？我勒個去？我勒個去？我勒個去"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "天哪，我太生氣了。就因為我買"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "了些東西，你就得"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "走？離開。你現在是在跟我開玩笑嗎"}, {"type": "subtitle", "time": 5490.95, "timestamp": "01:31:30", "text": "不。"}]
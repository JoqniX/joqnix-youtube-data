[{"type": "subtitle", "time": 2882.23, "timestamp": "00:48:02", "text": "好的。沒人會來，兄弟。"}, {"type": "subtitle", "time": 2885.109, "timestamp": "00:48:05", "text": "也許這輛卡車會來。"}, {"type": "subtitle", "time": 2891.99, "timestamp": "00:48:11", "text": "快點。救救我。給我一張票，我想"}, {"type": "subtitle", "time": 2894.79, "timestamp": "00:48:14", "text": "搭便車回家。返回基地。我"}, {"type": "subtitle", "time": 2896.069, "timestamp": "00:48:16", "text": "不想"}, {"type": "subtitle", "time": 2898.55, "timestamp": "00:48:18", "text": "重生。"}, {"type": "subtitle", "time": 2930.069, "timestamp": "00:48:50", "text": "沒人去。"}, {"type": "subtitle", "time": 2931.99, "timestamp": "00:48:51", "text": "我會按下重生鍵。  該死的"}]
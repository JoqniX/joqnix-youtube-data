[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "搭車回家嗎？"}, {"type": "subtitle", "time": 1864.149, "timestamp": "00:31:04", "text": "進來，進來。"}, {"type": "subtitle", "time": 1865.909, "timestamp": "00:31:05", "text": "沒有延遲。  沒"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "問題。但是，呃，問題是我覺得我更喜歡第一人稱射擊"}, {"type": "subtitle", "time": 1877.43, "timestamp": "00:31:17", "text": "不是嗎？我只是想要盡可能流暢的動作"}, {"type": "subtitle", "time": 1879.35, "timestamp": "00:31:19", "text": "。"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "而且他們都是職業飛行員。看"}, {"type": "subtitle", "time": 1884.149, "timestamp": "00:31:24", "text": "他飛起來的樣子。"}, {"type": "subtitle", "time": 1886.789, "timestamp": "00:31:26", "text": "為什麼沒有人？跟我來。"}, {"type": "subtitle", "time": 1891.83, "timestamp": "00:31:31", "text": "好了，有人來了。請過來，請到我身上。"}, {"type": "subtitle", "time": 1894.47, "timestamp": "00:31:34", "text": "不，不要"}, {"type": "subtitle", "time": 1896.47, "timestamp": "00:31:36", "text": "下去。是的。到我身上來。得到“是”。是的。  是的。是的。是的。是的。  是的。"}, {"type": "subtitle", "time": 1904.95, "timestamp": "00:31:44", "text": "更多玩家。快點。快點。快點。  是的。快點。快點。快點。"}, {"type": "subtitle", "time": 1908.149, "timestamp": "00:31:48", "text": "我想要"}, {"type": "subtitle", "time": 1910.71, "timestamp": "00:31:50", "text": "你。不，過來。過來。過來。過來。是的。是的。是的。是的。  是的。  謝謝。我們走吧。  耶。好的"}]
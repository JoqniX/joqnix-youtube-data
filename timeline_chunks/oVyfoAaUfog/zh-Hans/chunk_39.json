[{"type": "subtitle", "time": 2346.15, "timestamp": "00:39:06", "text": "久保走了。 他和我做的是同一"}, {"type": "subtitle", "time": 2349.03, "timestamp": "00:39:09", "text": "件事。 好的，现在只有一个玩家。"}, {"type": "subtitle", "time": 2351.99, "timestamp": "00:39:11", "text": "请进，请进，"}, {"type": "subtitle", "time": 2354.95, "timestamp": "00:39:14", "text": "请进。"}, {"type": "subtitle", "time": 2359.349, "timestamp": "00:39:19", "text": "我的服务开始了。 进来。我不会把"}, {"type": "subtitle", "time": 2367.43, "timestamp": "00:39:27", "text": "快点。"}, {"type": "subtitle", "time": 2369.43, "timestamp": "00:39:29", "text": "他要买下他的主人。 好的。 另一名"}, {"type": "subtitle", "time": 2371.589, "timestamp": "00:39:31", "text": "玩家。 快点。"}, {"type": "subtitle", "time": 2376.31, "timestamp": "00:39:36", "text": "抓住他。 是的。 是的。 来。 来。 来。"}, {"type": "subtitle", "time": 2379.51, "timestamp": "00:39:39", "text": "哦，第三位玩家。 好的。"}, {"type": "subtitle", "time": 2382.79, "timestamp": "00:39:42", "text": "第四名玩家。 好的。 哦，他走了。 他"}, {"type": "subtitle", "time": 2385.51, "timestamp": "00:39:45", "text": "离开了。 好的。 我会把所有顾客都召集起来"}, {"type": "subtitle", "time": 2387.67, "timestamp": "00:39:47", "text": "。"}, {"type": "subtitle", "time": 2391.99, "timestamp": "00:39:51", "text": "好的。 进来。进来。 来。 有人"}, {"type": "subtitle", "time": 2394.23, "timestamp": "00:39:54", "text": "买了"}]
[{"type": "subtitle", "time": 1081.59, "timestamp": "00:18:01", "text": "问题是它会漂移。 不，它会"}, {"type": "subtitle", "time": 1085.19, "timestamp": "00:18:05", "text": "向后漂移。 我不喜欢那样。"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "你想知道我在做什么吗？ 我还在"}, {"type": "subtitle", "time": 1099.75, "timestamp": "00:18:19", "text": "摸索，"}, {"type": "subtitle", "time": 1102.789, "timestamp": "00:18:22", "text": "我还在努力弄明白"}, {"type": "subtitle", "time": 1125.19, "timestamp": "00:18:45", "text": "然后我们慢慢地就到"}, {"type": "subtitle", "time": 1128.789, "timestamp": "00:18:48", "text": "这里来了。"}, {"type": "subtitle", "time": 1135.99, "timestamp": "00:18:55", "text": "呃，"}, {"type": "subtitle", "time": 1138.39, "timestamp": "00:18:58", "text": "那是一次迫降。"}]
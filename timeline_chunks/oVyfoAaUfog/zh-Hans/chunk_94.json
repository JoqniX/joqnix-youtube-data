[{"type": "subtitle", "time": 5643.43, "timestamp": "01:34:03", "text": "。 妈的。 妈的。 妈的。 妈的"}, {"type": "subtitle", "time": 5653.91, "timestamp": "01:34:13", "text": "啊，该死的狙击手。"}, {"type": "subtitle", "time": 5679.03, "timestamp": "01:34:39", "text": "哦，是吗？ 他妈的。 他抛弃了我。 这是什么"}, {"type": "subtitle", "time": 5681.669, "timestamp": "01:34:41", "text": "情况？"}, {"type": "subtitle", "time": 5685.83, "timestamp": "01:34:45", "text": "这是什么地图？"}, {"type": "subtitle", "time": 5693.51, "timestamp": "01:34:53", "text": "太多了。 啊。"}, {"type": "subtitle", "time": 5695.83, "timestamp": "01:34:55", "text": "见鬼。 我不应该，我不应该"}, {"type": "subtitle", "time": 5698.55, "timestamp": "01:34:58", "text": "这样做。 应该来的。 不应该"}]
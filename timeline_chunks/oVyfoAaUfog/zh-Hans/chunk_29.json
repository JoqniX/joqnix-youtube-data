[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "我的落地技巧。 我不擅长这个。"}, {"type": "subtitle", "time": 1744.47, "timestamp": "00:29:04", "text": "直升机降落花了一些时间，不过"}, {"type": "subtitle", "time": 1746.63, "timestamp": "00:29:06", "text": "没关系。 回到我刚才"}, {"type": "subtitle", "time": 1749.029, "timestamp": "00:29:09", "text": "说的。 嗯，"}, {"type": "subtitle", "time": 1751.43, "timestamp": "00:29:11", "text": "是的，我觉得目前我不知道"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "直播质量如何，是不是有"}, {"type": "subtitle", "time": 1757.75, "timestamp": "00:29:17", "text": "点卡顿？ 我目前甚至尝试"}, {"type": "subtitle", "time": 1761.19, "timestamp": "00:29:21", "text": "修改游戏内的配置"}, {"type": "subtitle", "time": 1764.47, "timestamp": "00:29:24", "text": "文件，把所有"}, {"type": "chat", "time": 1765.359, "timestamp": "00:29:25", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "it's good"}, {"type": "subtitle", "time": 1767.029, "timestamp": "00:29:27", "text": "设置都调到最低。"}, {"type": "subtitle", "time": 1769.43, "timestamp": "00:29:29", "text": "嗯，"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "低设置。 感觉有延迟，"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "而且动作不够流畅。"}, {"type": "subtitle", "time": 1778.95, "timestamp": "00:29:38", "text": "所以我觉得我应该这么做。所以我才觉得，"}, {"type": "subtitle", "time": 1782.23, "timestamp": "00:29:42", "text": "如果我"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "有了第二台电脑，我就可以把"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "直播和录制的工作都转移到那台"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "电脑上。 我只是把"}, {"type": "subtitle", "time": 1796.63, "timestamp": "00:29:56", "text": "当前游戏画面、"}, {"type": "subtitle", "time": 1799.51, "timestamp": "00:29:59", "text": "音频之类的东西从我的笔记本"}]
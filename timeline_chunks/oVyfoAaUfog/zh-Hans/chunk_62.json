[{"type": "subtitle", "time": 3733.51, "timestamp": "01:02:13", "text": "只要我不被抓到，我就可以……"}, {"type": "subtitle", "time": 3735.43, "timestamp": "01:02:15", "text": "那家伙在狙击。 我能听到他"}, {"type": "subtitle", "time": 3739.27, "timestamp": "01:02:19", "text": "开枪的声音。 我能听到他开枪的声音。"}, {"type": "subtitle", "time": 3741.27, "timestamp": "01:02:21", "text": "我只需要知道他的具体位置。"}, {"type": "subtitle", "time": 3744.87, "timestamp": "01:02:24", "text": "它现在应该已经过期了。"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "哦，我看到他了。 我看见他了。"}, {"type": "subtitle", "time": 3752.63, "timestamp": "01:02:32", "text": "他正在这里进行狙击。 这边。"}, {"type": "subtitle", "time": 3755.43, "timestamp": "01:02:35", "text": "但是，我应该冒这个险吗？ 难道就没有比"}, {"type": "subtitle", "time": 3758.39, "timestamp": "01:02:38", "text": "他更优秀的人吗？"}, {"type": "subtitle", "time": 3770.87, "timestamp": "01:02:50", "text": "检查边角。 检查每一栋建筑物。"}, {"type": "subtitle", "time": 3779.589, "timestamp": "01:02:59", "text": "即使现在没有阴影，"}]
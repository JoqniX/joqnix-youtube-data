[{"type": "subtitle", "time": 2408.71, "timestamp": "00:40:08", "text": "我又招到了一名球员。"}, {"type": "subtitle", "time": 2412.069, "timestamp": "00:40:12", "text": "还有一个。   是的"}, {"type": "subtitle", "time": 2415.589, "timestamp": "00:40:15", "text": "。 好的。 好的。 好的。 没有空位了"}, {"type": "subtitle", "time": 2417.349, "timestamp": "00:40:17", "text": "。"}, {"type": "subtitle", "time": 2419.829, "timestamp": "00:40:19", "text": "好了，我们继续"}, {"type": "subtitle", "time": 2433.19, "timestamp": "00:40:33", "text": "我觉得在"}, {"type": "subtitle", "time": 2435.91, "timestamp": "00:40:35", "text": "这里降落更安全。 他们肯定可以像那样"}, {"type": "subtitle", "time": 2439.109, "timestamp": "00:40:39", "text": "去那里，慢慢地进去，而不是像我一样直接把"}, {"type": "subtitle", "time": 2442.15, "timestamp": "00:40:42", "text": "头顶朝下栽进去。我想在"}, {"type": "subtitle", "time": 2444.47, "timestamp": "00:40:44", "text": "这里降落，但是树太多了，"}, {"type": "subtitle", "time": 2446.443, "timestamp": "00:40:46", "text": "不太安全。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "[嗤笑]"}, {"type": "subtitle", "time": 2450.95, "timestamp": "00:40:50", "text": "所以我不知道。 我希望他们能原谅"}]
[{"type": "subtitle", "time": 2225.67, "timestamp": "00:37:05", "text": "H 点，蓝队实际上并没有赢。"}, {"type": "subtitle", "time": 2228.15, "timestamp": "00:37:08", "text": "你好，卡达萨。"}, {"type": "subtitle", "time": 2236.95, "timestamp": "00:37:16", "text": "好久没看直播了。 是啊，说实话，我本来就想"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "直播。 但周四"}, {"type": "subtitle", "time": 2243.27, "timestamp": "00:37:23", "text": "和周五，我做了我的第二份"}, {"type": "subtitle", "time": 2248.55, "timestamp": "00:37:28", "text": "兼职工作。 嗯，我"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "大概晚上 10 点坐火车回家"}, {"type": "subtitle", "time": 2254.79, "timestamp": "00:37:34", "text": "，"}, {"type": "subtitle", "time": 2257.43, "timestamp": "00:37:37", "text": "吃完晚饭后步行回家。 我太累了，睡着了"}, {"type": "subtitle", "time": 2260.55, "timestamp": "00:37:40", "text": "。 我想我大概凌晨三四点就醒了。"}, {"type": "subtitle", "time": 2264.55, "timestamp": "00:37:44", "text": "我想直播，但是"}, {"type": "subtitle", "time": 2267.19, "timestamp": "00:37:47", "text": "没能直播。"}]
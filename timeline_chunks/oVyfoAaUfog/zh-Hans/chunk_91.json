[{"type": "subtitle", "time": 5463.51, "timestamp": "01:31:03", "text": "等等，他走了吗？ 我勒个去？ 我勒个去"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "我的天哪，我太生气了。 就因为我"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "买了些东西，你就得"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "走？ 离开。 你现在是在跟我开玩笑吗"}, {"type": "subtitle", "time": 5490.95, "timestamp": "01:31:30", "text": "不。"}]
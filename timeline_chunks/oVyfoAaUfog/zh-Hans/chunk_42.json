[{"type": "subtitle", "time": 2524.87, "timestamp": "00:42:04", "text": "嗯，那是敌方直升机吗？   妈的"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "我的天啊。 敌人。"}, {"type": "subtitle", "time": 2540.309, "timestamp": "00:42:20", "text": "雅达。 我只是个优步司机。"}, {"type": "subtitle", "time": 2543.43, "timestamp": "00:42:23", "text": "我是你的优步。"}, {"type": "subtitle", "time": 2561.109, "timestamp": "00:42:41", "text": "好了，我们返回基地。"}]
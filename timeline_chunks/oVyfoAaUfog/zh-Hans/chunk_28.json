[{"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "我完美着陆了。 耶。"}, {"type": "subtitle", "time": 1700.389, "timestamp": "00:28:20", "text": "我已经着陆了。 我的天啊。 我的天啊。"}, {"type": "subtitle", "time": 1703.029, "timestamp": "00:28:23", "text": "不。现在到了最重要的部分。 我"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "只需要把物资送过去。"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "哦，我要拿到钱了。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "好的。 慢慢来，慢慢来，慢慢来。"}, {"type": "subtitle", "time": 1717.11, "timestamp": "00:28:37", "text": "然后按"}, {"type": "subtitle", "time": 1721.269, "timestamp": "00:28:41", "text": "G键。耶！ 二级飞行员。"}, {"type": "subtitle", "time": 1724.149, "timestamp": "00:28:44", "text": "现在我慢慢地往回走"}, {"type": "subtitle", "time": 1728.07, "timestamp": "00:28:48", "text": "。 所以，回到我刚才"}, {"type": "subtitle", "time": 1732.07, "timestamp": "00:28:52", "text": "说的话。 将鼠标移到这里。 为什么？ 好的。"}, {"type": "subtitle", "time": 1734.789, "timestamp": "00:28:54", "text": "等待。 我必须学习如何"}, {"type": "subtitle", "time": 1737.83, "timestamp": "00:28:57", "text": "正确归档。 是的，我需要提高一下"}]
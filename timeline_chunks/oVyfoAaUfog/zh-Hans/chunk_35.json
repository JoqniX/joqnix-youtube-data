[{"type": "subtitle", "time": 2107.109, "timestamp": "00:35:07", "text": "庆祝得太早了。 对，应该"}, {"type": "subtitle", "time": 2126.71, "timestamp": "00:35:26", "text": "我会返回基地，再弄一架"}, {"type": "subtitle", "time": 2132.87, "timestamp": "00:35:32", "text": "让我好好养伤。"}, {"type": "subtitle", "time": 2135.99, "timestamp": "00:35:35", "text": "啊，三块绷带。"}, {"type": "subtitle", "time": 2139.51, "timestamp": "00:35:39", "text": "没关系。 好的。 进展。"}, {"type": "subtitle", "time": 2142.47, "timestamp": "00:35:42", "text": "好的。 飞行员三号。 这样我就可以解锁这把"}, {"type": "subtitle", "time": 2146.47, "timestamp": "00:35:46", "text": "迷你枪了。 四级。 好的。 好的。 我"}, {"type": "subtitle", "time": 2149.829, "timestamp": "00:35:49", "text": "想升到"}, {"type": "subtitle", "time": 2153.99, "timestamp": "00:35:53", "text": "10级。这个重要的关卡。 我可以载11个"}, {"type": "subtitle", "time": 2155.75, "timestamp": "00:35:55", "text": "乘客什么的"}, {"type": "subtitle", "time": 2159.829, "timestamp": "00:35:59", "text": "。 太好了。 大型装甲"}]
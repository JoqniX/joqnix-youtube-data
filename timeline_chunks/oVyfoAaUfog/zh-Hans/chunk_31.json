[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "搭车回家吗？"}, {"type": "subtitle", "time": 1864.149, "timestamp": "00:31:04", "text": "进来，进来。"}, {"type": "subtitle", "time": 1865.909, "timestamp": "00:31:05", "text": "没有延迟。"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "没问题。 但是，呃，问题是我"}, {"type": "subtitle", "time": 1877.43, "timestamp": "00:31:17", "text": "不是吗？ 我只是想要尽可能流畅的动作"}, {"type": "subtitle", "time": 1879.35, "timestamp": "00:31:19", "text": "。"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "而且他们都是职业飞行员。 看"}, {"type": "subtitle", "time": 1884.149, "timestamp": "00:31:24", "text": "他飞起来的样子。"}, {"type": "subtitle", "time": 1886.789, "timestamp": "00:31:26", "text": "为什么没有人？ 跟我来"}, {"type": "subtitle", "time": 1889.269, "timestamp": "00:31:29", "text": "。"}, {"type": "subtitle", "time": 1891.83, "timestamp": "00:31:31", "text": "好了，有人来了。 请过来，请到"}, {"type": "subtitle", "time": 1894.47, "timestamp": "00:31:34", "text": "我身上来。不，不要"}, {"type": "subtitle", "time": 1896.47, "timestamp": "00:31:36", "text": "下去。 是的。 到我身上来。 得到“是”。 是的。   是的"}, {"type": "subtitle", "time": 1900.149, "timestamp": "00:31:40", "text": "。 是的。 是的。 是的。   是的"}, {"type": "subtitle", "time": 1904.95, "timestamp": "00:31:44", "text": "更多玩家。 快点。 快点。 快点。   是的"}, {"type": "subtitle", "time": 1908.149, "timestamp": "00:31:48", "text": "。 快点。 快点。 快点。 我想要"}, {"type": "subtitle", "time": 1910.71, "timestamp": "00:31:50", "text": "你。 不，过来。 过来。 过来"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "。 过来。 是的。 是的。 是的。 是的。   是的"}]
[{"type": "subtitle", "time": 663.11, "timestamp": "00:11:03", "text": "我这是要降落吗？还是我在做什么？"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "痛苦的是转身的过程。 我能"}, {"type": "subtitle", "time": 680.63, "timestamp": "00:11:20", "text": "理解。"}, {"type": "subtitle", "time": 685.75, "timestamp": "00:11:25", "text": "转弯有点难。"}, {"type": "subtitle", "time": 700.47, "timestamp": "00:11:40", "text": "我撞到树了。 什么？ 我怎么"}]
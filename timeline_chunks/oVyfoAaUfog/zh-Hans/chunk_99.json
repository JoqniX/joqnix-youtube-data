[{"type": "subtitle", "time": 5957.27, "timestamp": "01:39:17", "text": "他是不是不来了？还是怎么回事？"}, {"type": "subtitle", "time": 5980.47, "timestamp": "01:39:40", "text": "我懂那种感觉。 他弃车而逃，"}, {"type": "subtitle", "time": 5983.59, "timestamp": "01:39:43", "text": "因为没人愿意登上他的"}, {"type": "subtitle", "time": 5989.83, "timestamp": "01:39:49", "text": "这场比赛太痛苦了。 没人上我的车。"}]
[{"type": "subtitle", "time": 1560.71, "timestamp": "00:26:00", "text": "So, please never let doubt steal the joy"}, {"type": "subtitle", "time": 1562.789, "timestamp": "00:26:02", "text": "from things you love. Never convince"}, {"type": "subtitle", "time": 1565.43, "timestamp": "00:26:05", "text": "yourself you're not capable. Because the"}, {"type": "subtitle", "time": 1568.23, "timestamp": "00:26:08", "text": "truth is you are. And when you can't"}, {"type": "subtitle", "time": 1571.51, "timestamp": "00:26:11", "text": "quite believe in yourself, remember"}, {"type": "chat", "time": 1572.709, "timestamp": "00:26:12", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🫠🫠🫠"}, {"type": "subtitle", "time": 1575.11, "timestamp": "00:26:15", "text": "there are people, myself included, who"}, {"type": "subtitle", "time": 1578.47, "timestamp": "00:26:18", "text": "believe in you without hesitation. Oh,"}, {"type": "subtitle", "time": 1580.95, "timestamp": "00:26:20", "text": "thank you D."}, {"type": "subtitle", "time": 1582.71, "timestamp": "00:26:22", "text": "I know every journey has it rough"}, {"type": "subtitle", "time": 1585.59, "timestamp": "00:26:25", "text": "patches and yours has probably been no"}, {"type": "subtitle", "time": 1588.31, "timestamp": "00:26:28", "text": "different. But that's why it's important"}, {"type": "subtitle", "time": 1591.35, "timestamp": "00:26:31", "text": "to let others walk alongside you to"}, {"type": "subtitle", "time": 1594.23, "timestamp": "00:26:34", "text": "share in the highs and help carry the"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "lows. There's strength in asking for"}, {"type": "subtitle", "time": 1599.35, "timestamp": "00:26:39", "text": "help and it makes the road a little"}, {"type": "subtitle", "time": 1602.23, "timestamp": "00:26:42", "text": "brighter for everyone."}, {"type": "subtitle", "time": 1606.149, "timestamp": "00:26:46", "text": "So today I hope you pause, celebrate and"}, {"type": "subtitle", "time": 1608.87, "timestamp": "00:26:48", "text": "let yourself fully enjoy this moment."}, {"type": "subtitle", "time": 1611.909, "timestamp": "00:26:51", "text": "You earned it. Not just for what you"}, {"type": "subtitle", "time": 1614.95, "timestamp": "00:26:54", "text": "have done, but for the person you are."}, {"type": "subtitle", "time": 1617.269, "timestamp": "00:26:57", "text": "You deserve every bit of happiness and"}, {"type": "subtitle", "time": 1619.59, "timestamp": "00:26:59", "text": "every good thing this world has to"}]
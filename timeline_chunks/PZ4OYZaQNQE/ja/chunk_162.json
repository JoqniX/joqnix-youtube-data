[{"type": "subtitle", "time": 9722.07, "timestamp": "02:42:02", "text": "次はジャックに聞いてみて。"}, {"type": "subtitle", "time": 9724.309, "timestamp": "02:42:04", "text": "手袋をはめたままケーキを食べるのはどうするの？"}, {"type": "subtitle", "time": 9726.389, "timestamp": "02:42:06", "text": "信じてください、私にはその方法がわかりません。 あ、"}, {"type": "subtitle", "time": 9728.87, "timestamp": "02:42:08", "text": "スプーン持ってるよ。   なんとか詰め込んでみます"}, {"type": "subtitle", "time": 9732.23, "timestamp": "02:42:12", "text": "。ああ、台無しにしちゃいました"}, {"type": "subtitle", "time": 9734.07, "timestamp": "02:42:14", "text": "。"}, {"type": "subtitle", "time": 9744.23, "timestamp": "02:42:24", "text": "待って、フォークが必要だ。 待って、待って。"}, {"type": "subtitle", "time": 9749.51, "timestamp": "02:42:29", "text": "フォークを手に入れた。 何とか時間を作ってやらなきゃ。"}, {"type": "subtitle", "time": 9753.59, "timestamp": "02:42:33", "text": "いや、無理だ。  2回。 いや、いや。 入れて。"}, {"type": "subtitle", "time": 9756.23, "timestamp": "02:42:36", "text": "ああ、なんてことだ。 入れられない。入れた。"}, {"type": "subtitle", "time": 9763.91, "timestamp": "02:42:43", "text": "ゆっくり、"}]
[{"type": "subtitle", "time": 6605.91, "timestamp": "01:50:05", "text": "ここから先はベストを尽くしたいと思っています。"}, {"type": "subtitle", "time": 6609.109, "timestamp": "01:50:09", "text": "モデルを公開したので、私の"}, {"type": "subtitle", "time": 6610.95, "timestamp": "01:50:10", "text": "心配事や、ジョアソンの配信で話していたことすべてをご存知でしょう。とても"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "ハイエンドなモデルなので、"}, {"type": "subtitle", "time": 6619.109, "timestamp": "01:50:19", "text": "多くの期待が寄せられるでしょう。"}, {"type": "subtitle", "time": 6622.39, "timestamp": "01:50:22", "text": "コンテンツ面で準備して、"}, {"type": "subtitle", "time": 6627.43, "timestamp": "01:50:27", "text": "失敗しないようにしなければなりません。いいえ、このモデルは、ええ、"}, {"type": "subtitle", "time": 6629.27, "timestamp": "01:50:29", "text": "このモデルが"}, {"type": "subtitle", "time": 6632.31, "timestamp": "01:50:32", "text": "失敗作になることを望んでいません。 これは私の公式"}, {"type": "subtitle", "time": 6633.99, "timestamp": "01:50:33", "text": "モデルになる予定で、"}, {"type": "subtitle", "time": 6637.669, "timestamp": "01:50:37", "text": "少なくとも4、5年は使うつもりです。 ええ、たとえ"}, {"type": "subtitle", "time": 6650.07, "timestamp": "01:50:50", "text": "将来的に衣装や衣装のデザイン、ヘアスタイルのデザイン、あるいはちょっとしたデザイン変更ができなくなるとしても。 でも、ええ、ええと、私は"}, {"type": "subtitle", "time": 6653.83, "timestamp": "01:50:53", "text": "これをかなり長い間使うつもりです、信じてください。"}, {"type": "subtitle", "time": 6659.27, "timestamp": "01:50:59", "text": "ええ、これで私がずっと秘密にしていたことがお分かりいただけたと思います"}]
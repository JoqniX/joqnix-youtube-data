[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "なぜシフトしたの？なぜシフトしたの？"}, {"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "ああ、なぜシフトしたの？"}, {"type": "subtitle", "time": 1507.35, "timestamp": "00:25:07", "text": "待て、位置が変わった。 はい、はい、はい、"}, {"type": "subtitle", "time": 1510.23, "timestamp": "00:25:10", "text": "はい。 ああ、このフォーマット。 はい、"}, {"type": "subtitle", "time": 1512.39, "timestamp": "00:25:12", "text": "オレンジ色です。"}, {"type": "subtitle", "time": 1514.95, "timestamp": "00:25:14", "text": "おい、君。 私は普段、"}, {"type": "subtitle", "time": 1517.43, "timestamp": "00:25:17", "text": "誕生日メッセージを書くのがあまり得意ではありません。 正直言って、私"}, {"type": "subtitle", "time": 1519.59, "timestamp": "00:25:19", "text": "自身もそういうのは避けるようにしているのですが、あなたのためなら"}, {"type": "subtitle", "time": 1522.31, "timestamp": "00:25:22", "text": "例外とせざるを得ませんでした。 このコミュニティに"}, {"type": "subtitle", "time": 1523.75, "timestamp": "00:25:23", "text": "参加してからのこの3年間、私は"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "静かに、"}, {"type": "subtitle", "time": 1528.07, "timestamp": "00:25:28", "text": "静かに傍観者として、皆さんが"}, {"type": "subtitle", "time": 1531.269, "timestamp": "00:25:31", "text": "日々努力を重ねる様子を見守ってきました"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "。 称賛のためではなく、"}, {"type": "subtitle", "time": 1540.149, "timestamp": "00:25:40", "text": "周囲の人々の幸福のために。 あなたは自分の仕事に時間、エネルギー、そして"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "情熱を注ぎ込んでおり、それがよく表れています。"}, {"type": "subtitle", "time": 1546.47, "timestamp": "00:25:46", "text": "あなたの才能は疑いようがなく、あなたの"}, {"type": "subtitle", "time": 1549.35, "timestamp": "00:25:49", "text": "可能性は無限大です。 何てことだ。"}, {"type": "subtitle", "time": 1551.59, "timestamp": "00:25:51", "text": "ありがとう。"}, {"type": "subtitle", "time": 1555.269, "timestamp": "00:25:55", "text": "あなたは偉大なことを成し遂げる運命にある。 私はそれを"}, {"type": "subtitle", "time": 1557.43, "timestamp": "00:25:57", "text": "心から信じています。   だから"}]
[{"type": "subtitle", "time": 1982.149, "timestamp": "00:33:02", "text": "あなたに会って一緒に時間を過ごせたのは素晴らしい旅でした。"}, {"type": "subtitle", "time": 1985.35, "timestamp": "00:33:05", "text": "ハトジ、あなたが"}, {"type": "subtitle", "time": 1987.75, "timestamp": "00:33:07", "text": "素晴らしい一日と素晴らしい一年を過ごせることを願っています。豆知識："}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "チャドは広告を待った後、開くのが面倒くさいんです。"}, {"type": "subtitle", "time": 2001.029, "timestamp": "00:33:21", "text": "彼はチャドです。 彼は開けるのが面倒くさい。 待って、"}, {"type": "subtitle", "time": 2013.669, "timestamp": "00:33:33", "text": "彼はパソコンを起動した後にアプリを開くのが面倒なので、代わりにアプリを開いてくれる"}, {"type": "subtitle", "time": 2016.31, "timestamp": "00:33:36", "text": "ツールを使っている"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "。 彼の"}, {"type": "subtitle", "time": 2022.389, "timestamp": "00:33:42", "text": "動画をチェックしてみてください。"}, {"type": "subtitle", "time": 2025.59, "timestamp": "00:33:45", "text": "ああ、実は今日それをやらなきゃいけなかったんです。   えっと、停電で"}, {"type": "subtitle", "time": 2028.71, "timestamp": "00:33:48", "text": "パソコンの電源が入っていないことに気づいて、2階に上がって"}, {"type": "subtitle", "time": 2033.269, "timestamp": "00:33:53", "text": "パソコンの電源を入れたら、"}, {"type": "subtitle", "time": 2035.75, "timestamp": "00:33:55", "text": "スマホのボタンをクリックしたんです。"}, {"type": "subtitle", "time": 2037.99, "timestamp": "00:33:57", "text": "自宅のネットワークに接続して、"}, {"type": "subtitle", "time": 2039.669, "timestamp": "00:33:59", "text": "ボタンをクリックしただけです。"}]
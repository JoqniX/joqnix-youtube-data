[{"type": "subtitle", "time": 8223.27, "timestamp": "02:17:03", "text": "。 ちょっとこれをやらせてください。 これを閉じてください。   それは"}, {"type": "subtitle", "time": 8230.389, "timestamp": "02:17:10", "text": "こんにちは、"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "ママ。  M."}, {"type": "subtitle", "time": 8237.99, "timestamp": "02:17:17", "text": "なぜ私を追跡しないのですか？  M."}, {"type": "subtitle", "time": 8241.19, "timestamp": "02:17:21", "text": "まだ電話を追跡している。"}, {"type": "subtitle", "time": 8243.03, "timestamp": "02:17:23", "text": "キャリブレーションしてください。"}, {"type": "subtitle", "time": 8247.99, "timestamp": "02:17:27", "text": "そして、この棒を、見た目通りのところまでねじります"}, {"type": "subtitle", "time": 8249.91, "timestamp": "02:17:29", "text": "。"}, {"type": "subtitle", "time": 8252.15, "timestamp": "02:17:32", "text": "ああ、神様。 いや、いや、いや、いや。ああ、"}, {"type": "subtitle", "time": 8256.549, "timestamp": "02:17:36", "text": "こんな感じだ。 はい、結構です。 そして、スマホのカメラを起動する"}, {"type": "subtitle", "time": 8258.23, "timestamp": "02:17:38", "text": "。"}, {"type": "subtitle", "time": 8260.79, "timestamp": "02:17:40", "text": "うん、それなら十分良さそうだね。   わかった"}, {"type": "subtitle", "time": 8263.509, "timestamp": "02:17:43", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 8266.23, "timestamp": "02:17:46", "text": "うん、準備はできてるよ。   準備は万端だ"}, {"type": "subtitle", "time": 8273.83, "timestamp": "02:17:53", "text": "ええ、ケーキはご覧いただけますよ。"}]
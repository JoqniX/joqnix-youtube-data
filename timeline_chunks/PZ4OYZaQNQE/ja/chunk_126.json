[{"type": "subtitle", "time": 7560.229, "timestamp": "02:06:00", "text": "手袋は持っていません。 ああ、神様。 私は何をしますか？"}, {"type": "subtitle", "time": 7563.03, "timestamp": "02:06:03", "text": "父に聞いてみます。 わかった。 とにかく、"}, {"type": "subtitle", "time": 7567.03, "timestamp": "02:06:07", "text": "注文品は集荷されるところです。"}, {"type": "subtitle", "time": 7570.229, "timestamp": "02:06:10", "text": "30分か30分で届きます。"}, {"type": "subtitle", "time": 7571.91, "timestamp": "02:06:11", "text": "マヤ、"}, {"type": "subtitle", "time": 7575.03, "timestamp": "02:06:15", "text": "えっと、今はとりあえずゆっくりしよう。"}, {"type": "subtitle", "time": 7578.07, "timestamp": "02:06:18", "text": "えっと、今はとりあえずのんびりしましょう。 さて、一体何が"}, {"type": "subtitle", "time": 7581.189, "timestamp": "02:06:21", "text": "起こったのでしょうか？ えー、パンはケーキを注文したよ。 それで、"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "ケーキをもらうことになったんです。 それでは、"}, {"type": "subtitle", "time": 7586.149, "timestamp": "02:06:26", "text": "手持ちカメラでケーキを食べる様子を少し撮影してみます"}, {"type": "subtitle", "time": 7588.95, "timestamp": "02:06:28", "text": "。"}, {"type": "subtitle", "time": 7597.109, "timestamp": "02:06:37", "text": "画面に映っているケーキそのものです。 これです。"}, {"type": "subtitle", "time": 7600.629, "timestamp": "02:06:40", "text": "うん、たぶんあのケーキだと思う。  「ちょっと"}, {"type": "subtitle", "time": 7607.99, "timestamp": "02:06:47", "text": "チョコレートトリュフケーキ。"}, {"type": "subtitle", "time": 7611.99, "timestamp": "02:06:51", "text": "チョコレートトリュフケーキはどんな見た目ですか？"}, {"type": "subtitle", "time": 7617.83, "timestamp": "02:06:57", "text": "。 楽しい。"}]
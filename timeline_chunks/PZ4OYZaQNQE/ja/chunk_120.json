[{"type": "subtitle", "time": 7206.31, "timestamp": "02:00:06", "text": "彼に何したのか聞きたいんだけど"}, {"type": "subtitle", "time": 7210.47, "timestamp": "02:00:10", "text": "、え、何？  600gとはどういう意味ですか？"}, {"type": "subtitle", "time": 7215.99, "timestamp": "02:00:15", "text": "600グラム 小さな一切れのようなものですか、それとも、"}, {"type": "subtitle", "time": 7224.709, "timestamp": "02:00:24", "text": "これがなぜ6つなのか、聖なる神よ？ それは"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "。 なぜそんなことをするのですか？ 何てことだ"}, {"type": "subtitle", "time": 7235.35, "timestamp": "02:00:35", "text": "。"}, {"type": "subtitle", "time": 7237.99, "timestamp": "02:00:37", "text": "ああ、"}, {"type": "subtitle", "time": 7243.669, "timestamp": "02:00:43", "text": "おい。   はい"}, {"type": "subtitle", "time": 7247.35, "timestamp": "02:00:47", "text": "、ではちょっと"}, {"type": "subtitle", "time": 7250.709, "timestamp": "02:00:50", "text": "メールを確認します。 小さくはない。 ああ、神様。"}, {"type": "subtitle", "time": 7255.109, "timestamp": "02:00:55", "text": "ああ、神様。 わかった。 ケーキを一切れ食べたい人いますか"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "？   わかった"}]
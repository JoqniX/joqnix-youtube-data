[{"type": "subtitle", "time": 3541.43, "timestamp": "00:59:01", "text": "誕生日のお祝いメッセージをありがとうございます。"}, {"type": "subtitle", "time": 3545.589, "timestamp": "00:59:05", "text": "こんにちは。 次はクレイ・レイヴンです。 ああ、"}, {"type": "subtitle", "time": 3548.069, "timestamp": "00:59:08", "text": "彼女は本当に。"}, {"type": "subtitle", "time": 3549.99, "timestamp": "00:59:09", "text": "お誕生日おめでとう。"}, {"type": "subtitle", "time": 3552.23, "timestamp": "00:59:12", "text": "あなたが夢に近づいているのを見て、とても嬉しいです"}, {"type": "subtitle", "time": 3554.069, "timestamp": "00:59:14", "text": "。 同時に、"}, {"type": "subtitle", "time": 3558.549, "timestamp": "00:59:18", "text": "あなたのプロジェクトに関するさらなる情報公開や進捗状況の報告を心待ちにしています"}, {"type": "subtitle", "time": 3562.069, "timestamp": "00:59:22", "text": "。 あなたの計画が、"}, {"type": "subtitle", "time": 3567.75, "timestamp": "00:59:27", "text": "その可能性ゆえに、より多くの人々に認められることを心から願っています。"}, {"type": "subtitle", "time": 3569.589, "timestamp": "00:59:29", "text": "いつか"}, {"type": "subtitle", "time": 3576.15, "timestamp": "00:59:36", "text": "旧友のジョックンに素敵な"}, {"type": "subtitle", "time": 3578.789, "timestamp": "00:59:38", "text": "誕生日をお祝いします。 ライブ配信が"}, {"type": "subtitle", "time": 3580.47, "timestamp": "00:59:40", "text": "スムーズに進むことを願っています。そして、来年、さらに"}, {"type": "subtitle", "time": 3582.47, "timestamp": "00:59:42", "text": "進化したJocknikがどんな活躍を見せてくれるのか、とても楽しみにしています"}, {"type": "subtitle", "time": 3585.03, "timestamp": "00:59:45", "text": "。"}, {"type": "subtitle", "time": 3587.19, "timestamp": "00:59:47", "text": "翻訳ツールを使ったので、"}, {"type": "subtitle", "time": 3591.19, "timestamp": "00:59:51", "text": "メッセージに誤解がなかったことを願っています。 改めて、誕生日おめでとうございます。"}, {"type": "subtitle", "time": 3596.309, "timestamp": "00:59:56", "text": "ありがとう、スクリュー・レイヴン。 ありがとう、D"}]
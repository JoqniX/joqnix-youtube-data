[{"type": "subtitle", "time": 3721.349, "timestamp": "01:02:01", "text": "また、私たちはビリー・"}, {"type": "subtitle", "time": 3723.829, "timestamp": "01:02:03", "text": "ベリナからのメッセージを読んでいるので、"}, {"type": "subtitle", "time": 3729.43, "timestamp": "01:02:09", "text": "ビリー・ビリーのグループにはたくさんの人がいました。私たちはQQというグループを持っています。"}, {"type": "subtitle", "time": 3731.589, "timestamp": "01:02:11", "text": "中国人はQQとVATを使っています。私は"}, {"type": "subtitle", "time": 3733.51, "timestamp": "01:02:13", "text": "VCHATを持っていません。インドでは利用できないからです。ほとんどの"}, {"type": "subtitle", "time": 3736.95, "timestamp": "01:02:16", "text": "中国製アプリは禁止されていますが、"}, {"type": "subtitle", "time": 3739.43, "timestamp": "01:02:19", "text": "QQにはすでにアカウントを持っていたので、アクセスできました。Qで"}, {"type": "subtitle", "time": 3744.23, "timestamp": "01:02:24", "text": "みんなが私に"}, {"type": "subtitle", "time": 3745.91, "timestamp": "01:02:25", "text": "誕生日おめでとうと言ってくれました。"}, {"type": "subtitle", "time": 3751.589, "timestamp": "01:02:31", "text": "ありがとう。"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "もし私にそれが可能であれば、いつかまた信じるようになるでしょう。"}, {"type": "subtitle", "time": 3756.95, "timestamp": "01:02:36", "text": "最善を尽くします。 それは2年間私の夢でした。"}, {"type": "subtitle", "time": 3761.75, "timestamp": "01:02:41", "text": "1年間配信することができましたが、あまり配信はできませんでした"}, {"type": "subtitle", "time": 3769.03, "timestamp": "01:02:49", "text": "。それでも、これからも努力を続け、そこで配信できるようにしたいと思っています。 こんにちは。 次は、"}, {"type": "subtitle", "time": 3771.109, "timestamp": "01:02:51", "text": "誕生日メッセージをありがとう、というお話です。"}, {"type": "subtitle", "time": 3774.789, "timestamp": "01:02:54", "text": "レイヴンなんてクソくらえだ。 次はアギー・ブルー・エイリアンです。"}, {"type": "subtitle", "time": 3777.349, "timestamp": "01:02:57", "text": "お誕生日おめでとうございます。"}, {"type": "subtitle", "time": 3779.75, "timestamp": "01:02:59", "text": "新規登録者ですが、皆さんの"}]
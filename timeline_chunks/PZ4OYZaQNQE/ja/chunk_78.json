[{"type": "subtitle", "time": 4685.91, "timestamp": "01:18:05", "text": "個人的に誕生日のお祝いのメッセージを送ってくれました"}, {"type": "subtitle", "time": 4687.91, "timestamp": "01:18:07", "text": "。誕生日のメッセージを送ってくれた皆さん、ありがとう。ありがとう。"}, {"type": "subtitle", "time": 4702.07, "timestamp": "01:18:22", "text": "誕生日のメッセージを送ってくれた皆さん、ありがとう。"}, {"type": "subtitle", "time": 4712.149, "timestamp": "01:18:32", "text": "、ちょっと待って。"}, {"type": "subtitle", "time": 4720.709, "timestamp": "01:18:40", "text": "よく眠れるかな。配信終了。うん"}, {"type": "subtitle", "time": 4722.47, "timestamp": "01:18:42", "text": "、タキス、君のメッセージも読んだよ"}, {"type": "subtitle", "time": 4725.27, "timestamp": "01:18:45", "text": "。どういたしまして。"}, {"type": "subtitle", "time": 4729.51, "timestamp": "01:18:49", "text": "誕生日おめでとう。誕生日のメッセージをありがとう。今、誕生日おめでとうって言ったっけ"}]
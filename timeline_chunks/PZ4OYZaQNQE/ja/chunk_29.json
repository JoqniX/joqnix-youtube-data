[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "花をください。"}, {"type": "subtitle", "time": 1745.029, "timestamp": "00:29:05", "text": "どうもありがとう。 アナンはいつも"}, {"type": "subtitle", "time": 1748.23, "timestamp": "00:29:08", "text": "私の配信を見てくれている"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "。"}, {"type": "subtitle", "time": 1752.31, "timestamp": "00:29:12", "text": "あなたが私の"}, {"type": "subtitle", "time": 1758.149, "timestamp": "00:29:18", "text": "配信などを見に来てくれることに、本当に感謝しています。 どうもありがとう。"}, {"type": "subtitle", "time": 1761.19, "timestamp": "00:29:21", "text": "いいえ、私が"}, {"type": "subtitle", "time": 1764.07, "timestamp": "00:29:24", "text": "仕事をしている時や、自分の"}, {"type": "subtitle", "time": 1768.47, "timestamp": "00:29:28", "text": "悪ふざけをしている時に付き添ってくれるためです。 ありがとう。"}, {"type": "subtitle", "time": 1771.35, "timestamp": "00:29:31", "text": "そしてロイヤンも。 お越しいただきありがとうございます"}, {"type": "subtitle", "time": 1774.87, "timestamp": "00:29:34", "text": "。 あなたが時々幸運を呼ぶことは知っていますが、それでも"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "私の誕生日を覚えていて、"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "メッセージを書いてくれたことに感謝します。 いいえ、"}, {"type": "subtitle", "time": 1784.63, "timestamp": "00:29:44", "text": "あなたも"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "オレンジも。 そして、アストラを手に入れた。"}, {"type": "subtitle", "time": 1791.19, "timestamp": "00:29:51", "text": "ジョイ、誕生日おめでとう。   えっと、指"}, {"type": "subtitle", "time": 1795.19, "timestamp": "00:29:55", "text": "ハートの絵文字、ハートの絵文字、そして"}, {"type": "subtitle", "time": 1799.75, "timestamp": "00:29:59", "text": "パーティーの絵文字。 正直に言うと、"}]
[{"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "プロのように仕事に戻るところが大好きです。 それは"}, {"type": "subtitle", "time": 2528.95, "timestamp": "00:42:08", "text": "君の勝利だね。 あと、"}, {"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "あなたのモデルにはハワイとワイフが関係しているという点も。"}, {"type": "subtitle", "time": 2538.309, "timestamp": "00:42:18", "text": "すごく楽しみです。"}, {"type": "subtitle", "time": 2541.91, "timestamp": "00:42:21", "text": "新しいモデルさん、あなたらしくいてくれて"}, {"type": "subtitle", "time": 2547.109, "timestamp": "00:42:27", "text": "ありがとう。 えっと、"}, {"type": "subtitle", "time": 2556.47, "timestamp": "00:42:36", "text": "大変な日にも来てしまって申し訳ないです。 それはきっと大変だっただろうし、私の"}, {"type": "subtitle", "time": 2562.79, "timestamp": "00:42:42", "text": "旅の始まりとなった種を、しつこく、そして迷惑なことに蒔いたに違いない。"}, {"type": "subtitle", "time": 2565.27, "timestamp": "00:42:45", "text": "もしこれがすべて単なる言葉で、"}, {"type": "subtitle", "time": 2567.829, "timestamp": "00:42:47", "text": "私が一瞬たりとも本気で言っていないと思うなら（そうは思わないが）、"}, {"type": "subtitle", "time": 2572.71, "timestamp": "00:42:52", "text": "私のこれまでの最大の目標は、"}, {"type": "subtitle", "time": 2578.63, "timestamp": "00:42:58", "text": "いつかあなたとコラボレーションできるほどの能力を持つことだということだけは知っておいてください。"}]
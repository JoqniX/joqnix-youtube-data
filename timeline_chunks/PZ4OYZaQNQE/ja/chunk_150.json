[{"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "うん。 えっと、写真を撮りました。"}, {"type": "subtitle", "time": 9026.469, "timestamp": "02:30:26", "text": "心配しないでください。 写真を撮った。"}, {"type": "subtitle", "time": 9029.99, "timestamp": "02:30:29", "text": "私は写真を撮りました。 大丈夫。"}, {"type": "subtitle", "time": 9033.59, "timestamp": "02:30:33", "text": "写真1枚だけです。 ああ、なんてことだ、私は走った。"}, {"type": "subtitle", "time": 9041.51, "timestamp": "02:30:41", "text": "ちょっと待って、待って、待って。"}, {"type": "subtitle", "time": 9045.03, "timestamp": "02:30:45", "text": "手袋で体を覆う必要がある。"}]
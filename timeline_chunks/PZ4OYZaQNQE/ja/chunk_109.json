[{"type": "subtitle", "time": 6552.55, "timestamp": "01:49:12", "text": "私も王冠を持っているんです。 あなたは見ましたか？ 私は"}, {"type": "subtitle", "time": 6555.59, "timestamp": "01:49:15", "text": "王冠を持っている。 あまりからかうのはやめておこう。   もうやり過ぎちゃったよ"}, {"type": "subtitle", "time": 6558.79, "timestamp": "01:49:18", "text": "、兄弟。 これは"}, {"type": "subtitle", "time": 6561.03, "timestamp": "01:49:21", "text": "デビュー用で、デビュー前"}, {"type": "subtitle", "time": 6563.669, "timestamp": "01:49:23", "text": "や、デビュー前のプロモーション"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "ツイート、そしてずっと先の未来のすべてに使います。"}, {"type": "subtitle", "time": 6569.669, "timestamp": "01:49:29", "text": "いつか、もし買える余裕ができたら、そのモデルを手に入れたい。   えっと、"}, {"type": "subtitle", "time": 6574.79, "timestamp": "01:49:34", "text": "今は値段が高いので。   というわけで"}, {"type": "subtitle", "time": 6580.39, "timestamp": "01:49:40", "text": "、今日は"}, {"type": "subtitle", "time": 6584.95, "timestamp": "01:49:44", "text": "楽しんでください。 しばらくの間は再び目にすることはないかもしれないが"}, {"type": "subtitle", "time": 6587.189, "timestamp": "01:49:47", "text": "、"}, {"type": "subtitle", "time": 6589.43, "timestamp": "01:49:49", "text": "はるか未来には、それが皆さんが"}, {"type": "subtitle", "time": 6591.84, "timestamp": "01:49:51", "text": "毎日目にすることになるモデルになるだろう。"}, {"type": "subtitle", "time": 6593.27, "timestamp": "01:49:53", "text": "【音楽】"}, {"type": "subtitle", "time": 6595.43, "timestamp": "01:49:55", "text": "さよなら。"}, {"type": "subtitle", "time": 6597.189, "timestamp": "01:49:57", "text": "私の"}, {"type": "subtitle", "time": 6599.75, "timestamp": "01:49:59", "text": "楽しみです。"}]
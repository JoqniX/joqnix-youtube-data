[{"type": "subtitle", "time": 7141.189, "timestamp": "01:59:01", "text": "ああ、パンデット、"}, {"type": "subtitle", "time": 7163.91, "timestamp": "01:59:23", "text": "ああ神様を注文しましたか。"}, {"type": "subtitle", "time": 7167.109, "timestamp": "01:59:27", "text": "ああ、神様。 待って。 今、配信を終了することはできないと思います"}, {"type": "subtitle", "time": 7176.229, "timestamp": "01:59:36", "text": "もしあなたが、もしあなたが、ああ、なんてことだ。   わかった"}, {"type": "subtitle", "time": 7183.27, "timestamp": "01:59:43", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 7186.07, "timestamp": "01:59:46", "text": "ユーザー名とパスワードも使用できます。"}, {"type": "subtitle", "time": 7193.589, "timestamp": "01:59:53", "text": "パスワードを忘れた皿があります。 あの、"}, {"type": "subtitle", "time": 7195.91, "timestamp": "01:59:55", "text": "皆さん、"}]
[{"type": "subtitle", "time": 4925.83, "timestamp": "01:22:05", "text": "このウェブサイトは中国では利用できないので"}, {"type": "subtitle", "time": 4928.95, "timestamp": "01:22:08", "text": "、来年は何か"}, {"type": "subtitle", "time": 4932.229, "timestamp": "01:22:12", "text": "別のことを試してみます。 もしくは、"}, {"type": "subtitle", "time": 4937.35, "timestamp": "01:22:17", "text": "このウェブサイトを管理している人たちに、"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "中国からのブロックを解除するように頼んでください。だから"}, {"type": "subtitle", "time": 4948.229, "timestamp": "01:22:28", "text": "、ビリーやQの人たちも、みんな"}, {"type": "subtitle", "time": 4952.07, "timestamp": "01:22:32", "text": "願い事を送れます。いいえ。ええ。"}, {"type": "subtitle", "time": 4955.27, "timestamp": "01:22:35", "text": "みんなを分けたくありません。でも、"}, {"type": "subtitle", "time": 4962.149, "timestamp": "01:22:42", "text": "皆さん、ありがとうございます。えっと、ちょっと待って、"}, {"type": "subtitle", "time": 4964.709, "timestamp": "01:22:44", "text": "これを読んでいないことに今気づきました。ちょっと待って"}, {"type": "subtitle", "time": 4966.39, "timestamp": "01:22:46", "text": "。待って、待って、待って。1つ見落としたことに今気づきました。待って"}, {"type": "subtitle", "time": 4969.75, "timestamp": "01:22:49", "text": "、"}, {"type": "subtitle", "time": 4973.03, "timestamp": "01:22:53", "text": "えっと、ゼロしか読んでいません。わかりました"}, {"type": "subtitle", "time": 4975.51, "timestamp": "01:22:55", "text": "、1人読んでいませんでした。"}, {"type": "subtitle", "time": 4977.27, "timestamp": "01:22:57", "text": "ごめんなさい。"}]
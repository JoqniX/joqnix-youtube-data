[{"type": "subtitle", "time": 2100.31, "timestamp": "00:35:00", "text": "ジャスミン・ソンさん、誕生日のお祝いメッセージをありがとうございました。 ジャスミン・ソン、ええ"}, {"type": "chat", "time": 2102.688, "timestamp": "00:35:02", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "happy birthdayyyyyyy 🎁🎂"}, {"type": "subtitle", "time": 2102.71, "timestamp": "00:35:02", "text": "、彼女が言ったように、彼女は私が"}, {"type": "chat", "time": 2104.737, "timestamp": "00:35:04", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! yp streem~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2105.27, "timestamp": "00:35:05", "text": "原神"}, {"type": "subtitle", "time": 2107.27, "timestamp": "00:35:07", "text": "猫をチェックしていた時に私を見つけたんです。 確か、"}, {"type": "subtitle", "time": 2111.67, "timestamp": "00:35:11", "text": "久しぶりに原神をプレイしていた時だったと思う。"}, {"type": "subtitle", "time": 2117.51, "timestamp": "00:35:17", "text": "彼女がユーチューバーで、しかも"}, {"type": "subtitle", "time": 2119.51, "timestamp": "00:35:19", "text": "インド人ユーチューバーだとは思っていなかった。"}, {"type": "subtitle", "time": 2122.31, "timestamp": "00:35:22", "text": "彼女が「待って、"}, {"type": "subtitle", "time": 2125.75, "timestamp": "00:35:25", "text": "ジョック、あなたはインド人なの？」と言うまでは。 私は「はい、私は"}, {"type": "subtitle", "time": 2127.67, "timestamp": "00:35:27", "text": "インド人のユーチューバーです」と言い、彼女は「ええ、"}, {"type": "subtitle", "time": 2130.23, "timestamp": "00:35:30", "text": "私もインド人のユーチューバーです」と言いました。"}, {"type": "subtitle", "time": 2134.47, "timestamp": "00:35:34", "text": "うん、すごく楽しかったよ。 ジャスミンの息子は"}, {"type": "chat", "time": 2137.428, "timestamp": "00:35:37", "author": "@nullZ1R0", "avatar": "https://yt4.ggpht.com/gfCnIq6HKGBm3XIs8AyJerBQ5X47zEsdPfn-Z5Sh_Htnj2P4Pr9WYai35E3WJ639q7ycBjY7=s64-c-k-c0x00ffffff-no-rj", "message": "many many happy returns of the day. "}, {"type": "subtitle", "time": 2137.43, "timestamp": "00:35:37", "text": "私にとって良い人だった。 私たちは"}, {"type": "chat", "time": 2139.475, "timestamp": "00:35:39", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Nenu Mi Z1R0~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2139.67, "timestamp": "00:35:39", "text": "Astraas Minecraftサーバーで出会い、そこで一緒に時間を過ごしました。その前には"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "電話をしていました。 彼女は、ジョッカソンのサブミッションの件"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "で私を手伝ってくれていたんですよね"}, {"type": "subtitle", "time": 2150.15, "timestamp": "00:35:50", "text": "。 最初は、"}, {"type": "subtitle", "time": 2152.79, "timestamp": "00:35:52", "text": "彼女がサバトンのようなことをしたことがあったので、彼女に助けを求めたのですが、2つ目も"}]
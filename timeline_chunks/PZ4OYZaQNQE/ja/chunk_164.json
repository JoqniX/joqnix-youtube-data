[{"type": "subtitle", "time": 9841.03, "timestamp": "02:44:01", "text": "一緒に切りましょう。 わかった。"}, {"type": "subtitle", "time": 9843.429, "timestamp": "02:44:03", "text": "えっと、"}, {"type": "subtitle", "time": 9855.51, "timestamp": "02:44:15", "text": "ねえ、でもあなたは私の手を握っているじゃない。"}, {"type": "subtitle", "time": 9858.389, "timestamp": "02:44:18", "text": "一緒に編集しましょう。"}, {"type": "subtitle", "time": 9863.51, "timestamp": "02:44:23", "text": "ジョック、誕生日おめでとう。 テックス、誕生日おめでとう"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "。"}, {"type": "subtitle", "time": 9877.51, "timestamp": "02:44:37", "text": "そしてそれがハッピーバースデーです。"}, {"type": "subtitle", "time": 9879.83, "timestamp": "02:44:39", "text": "お誕生日おめでとう。"}, {"type": "subtitle", "time": 9882.23, "timestamp": "02:44:42", "text": "誕生日おめでとう、"}]
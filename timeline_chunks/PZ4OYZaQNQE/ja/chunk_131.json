[{"type": "chat", "time": 7861.67, "timestamp": "02:11:01", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "yeppppp"}, {"type": "subtitle", "time": 7862.069, "timestamp": "02:11:02", "text": "私の親友がケーキを注文しました。 えっと、"}, {"type": "subtitle", "time": 7863.99, "timestamp": "02:11:03", "text": "ケーキが届くのを待っているところです。"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "もうすぐ来るよ。"}, {"type": "subtitle", "time": 7868.149, "timestamp": "02:11:08", "text": "ええと、ええ"}, {"type": "subtitle", "time": 7872.95, "timestamp": "02:11:12", "text": "、そうですね。 それで、問題は、"}, {"type": "subtitle", "time": 7875.83, "timestamp": "02:11:15", "text": "ケーキをこぼさずに"}, {"type": "subtitle", "time": 7879.99, "timestamp": "02:11:19", "text": "、綿の手袋を汚さずに食べるにはどうすればいいかということだ。"}, {"type": "subtitle", "time": 7884.709, "timestamp": "02:11:24", "text": "ああ、フォークがないんです。 待って、"}, {"type": "subtitle", "time": 7887.43, "timestamp": "02:11:27", "text": "フォーク持ってるよ。"}, {"type": "subtitle", "time": 7889.75, "timestamp": "02:11:29", "text": "ええ、フォークとスプーンは持っていますよ。 わかった、じゃあ"}, {"type": "subtitle", "time": 7893.189, "timestamp": "02:11:33", "text": "スプーンで食べるよ。 それは"}, {"type": "subtitle", "time": 7897.109, "timestamp": "02:11:37", "text": "神聖なケーキです。それは文字通り、"}, {"type": "subtitle", "time": 7901.43, "timestamp": "02:11:41", "text": "画面に映っているこのケーキです。"}, {"type": "subtitle", "time": 7903.83, "timestamp": "02:11:43", "text": "ああ、これだ。 チョコレートトリュフケーキ"}, {"type": "subtitle", "time": 7912.149, "timestamp": "02:11:52", "text": "、皆さんを代表して、私が一切れと、もう"}, {"type": "subtitle", "time": 7914.629, "timestamp": "02:11:54", "text": "一切れ食べます。"}, {"type": "subtitle", "time": 7919.669, "timestamp": "02:11:59", "text": "残りは家族にあげて、"}]
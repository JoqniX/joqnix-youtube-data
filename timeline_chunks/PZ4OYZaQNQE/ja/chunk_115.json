[{"type": "subtitle", "time": 6906.149, "timestamp": "01:55:06", "text": "原神のバースデー"}, {"type": "subtitle", "time": 6908.31, "timestamp": "01:55:08", "text": "ケーキが欲しいのですが、原神を"}, {"type": "subtitle", "time": 6923.27, "timestamp": "01:55:23", "text": "ゲームのベータ版をプレイしてみてください。 ダウンロードしなければならない。"}, {"type": "subtitle", "time": 6926.79, "timestamp": "01:55:26", "text": "ダウンロードのために取っておいたのですが、問題は、"}, {"type": "subtitle", "time": 6934.04, "timestamp": "01:55:34", "text": "。"}, {"type": "subtitle", "time": 6940.31, "timestamp": "01:55:40", "text": "よし、これはダウンロード用に取っておこう。 まあ、とにかく、"}, {"type": "subtitle", "time": 6942.47, "timestamp": "01:55:42", "text": "こんにちは。 それでは、そろそろ"}, {"type": "subtitle", "time": 6944.229, "timestamp": "01:55:44", "text": "締めくくりたいと思います。"}, {"type": "subtitle", "time": 6946.87, "timestamp": "01:55:46", "text": "本日お越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 6949.99, "timestamp": "01:55:49", "text": "誕生日のお祝いと、"}, {"type": "subtitle", "time": 6952.07, "timestamp": "01:55:52", "text": "昨日のココクなど、すべてを楽しんでいただけたことを願っています"}, {"type": "subtitle", "time": 6953.83, "timestamp": "01:55:53", "text": "。 うん。 うん。 さて、そろそろ終わりにしましょう"}, {"type": "subtitle", "time": 6957.35, "timestamp": "01:55:57", "text": "。 またね、みんな。 ああ、なんてことだ"}, {"type": "subtitle", "time": 6959.43, "timestamp": "01:55:59", "text": "、荒波もある。 私は"}]
[{"type": "subtitle", "time": 5881.08, "timestamp": "01:38:01", "text": "このモデルを成功させたいんです。"}, {"type": "subtitle", "time": 5882.31, "timestamp": "01:38:02", "text": "[音楽] これは"}, {"type": "subtitle", "time": 5884.87, "timestamp": "01:38:04", "text": "私のモデルで、"}, {"type": "subtitle", "time": 5887.75, "timestamp": "01:38:07", "text": "多くの人がこのモデルを実現するために努力してくれました。"}, {"type": "subtitle", "time": 5895.91, "timestamp": "01:38:15", "text": "デザイナーのAisanさん、Regantさんには本当に感謝しています。"}, {"type": "subtitle", "time": 5900.55, "timestamp": "01:38:20", "text": "お金が貯まったら依頼するつもりです。"}, {"type": "subtitle", "time": 5904.229, "timestamp": "01:38:24", "text": "リギングは高額ですからね。"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "こんにちは。来年3月に"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "日本に行く前に"}, {"type": "subtitle", "time": 5915.99, "timestamp": "01:38:35", "text": "、何か良いことが"}, {"type": "subtitle", "time": 5919.03, "timestamp": "01:38:39", "text": "起こるか、奇跡が起こるといいのですが。もしかしたら、"}, {"type": "subtitle", "time": 5922.79, "timestamp": "01:38:42", "text": "最終的に"}, {"type": "subtitle", "time": 5926.629, "timestamp": "01:38:46", "text": "このモデルを買えるだけのお金が貯まるかもしれません。 ええと、敬意"}, {"type": "subtitle", "time": 5930.95, "timestamp": "01:38:50", "text": "とか全部。ええ、"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "私たちでさえ知らないままでいられるといいですね。うん。"}]
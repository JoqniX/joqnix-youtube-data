[{"type": "subtitle", "time": 601.509, "timestamp": "00:10:01", "text": "」って感じだった。 でも、私にはわからない。"}, {"type": "subtitle", "time": 603.03, "timestamp": "00:10:03", "text": "配信することもできたけど、「いや、"}, {"type": "chat", "time": 605.819, "timestamp": "00:10:05", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉🎀❣♥🎂🥳❣🎀"}, {"type": "subtitle", "time": 605.99, "timestamp": "00:10:05", "text": "大丈夫」って思ったんだ。 ストリーミングしていないときは、なぜかかなりうまく動作しました"}, {"type": "subtitle", "time": 611.91, "timestamp": "00:10:11", "text": "。"}, {"type": "subtitle", "time": 619.829, "timestamp": "00:10:19", "text": "、それより前の午後6時15分頃です。"}, {"type": "subtitle", "time": 623.67, "timestamp": "00:10:23", "text": "私の番だったんだけど、"}, {"type": "subtitle", "time": 625.829, "timestamp": "00:10:25", "text": "家で誕生日のお祝いとか色々あったんだ。"}, {"type": "subtitle", "time": 628.71, "timestamp": "00:10:28", "text": "そして今、私は皆さんと一緒にそれを祝っています"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "こんにちは、レイヴン。誕生日のお祝い"}, {"type": "subtitle", "time": 638.23, "timestamp": "00:10:38", "text": "メッセージをありがとう。 ナーフの写真、そして"}, {"type": "subtitle", "time": 641.11, "timestamp": "00:10:41", "text": "誕生日のお祝いメッセージもありがとうございました。 ヴァラン、"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "来てくれてありがとう。そして"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "誕生日のお祝いもありがとう。 ありがとう、ソーン・サン。"}, {"type": "subtitle", "time": 646.23, "timestamp": "00:10:46", "text": "青い宇宙人の息子よ、"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "誕生日のお祝いをありがとう。 えっと"}, {"type": "subtitle", "time": 651.11, "timestamp": "00:10:51", "text": "、誕生日のお祝いのメッセージをありがとうございます。"}, {"type": "subtitle", "time": 653.35, "timestamp": "00:10:53", "text": "SPさん、誕生日のお祝いメッセージをありがとうございます。"}]
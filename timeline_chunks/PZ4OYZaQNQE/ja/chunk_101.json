[{"type": "subtitle", "time": 6060.629, "timestamp": "01:41:00", "text": "忘れて、"}, {"type": "subtitle", "time": 6062.87, "timestamp": "01:41:02", "text": "4、5ヶ"}, {"type": "subtitle", "time": 6066.55, "timestamp": "01:41:06", "text": "月後に戻ってくるようなことはしません。今回は、ウェブ"}, {"type": "subtitle", "time": 6068.87, "timestamp": "01:41:08", "text": "サイトを作っていた時と同じように、"}, {"type": "subtitle", "time": 6071.51, "timestamp": "01:41:11", "text": "HTMLやCSSなどを知りませんでしたが、"}, {"type": "subtitle", "time": 6073.91, "timestamp": "01:41:13", "text": "それでも粘り強く"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "学び、できる限りの努力をしました"}, {"type": "subtitle", "time": 6080.629, "timestamp": "01:41:20", "text": "。ウェブサイトでここまでできたように、"}, {"type": "subtitle", "time": 6087.91, "timestamp": "01:41:27", "text": "音楽でも同じことができると信じています。"}, {"type": "subtitle", "time": 6092.07, "timestamp": "01:41:32", "text": "ええ、それが私たちがこれからやっていくことです。 やっています。"}, {"type": "subtitle", "time": 6097.82, "timestamp": "01:41:37", "text": "音楽関連のこともやりたいと思っています。"}, {"type": "subtitle", "time": 6099.669, "timestamp": "01:41:39", "text": "[音楽]"}, {"type": "subtitle", "time": 6105.35, "timestamp": "01:41:45", "text": "こんにちは。それが期待できることです。そして、いつもの"}, {"type": "subtitle", "time": 6109.189, "timestamp": "01:41:49", "text": "毎日の配信。こんにちは。頑張ります"}, {"type": "subtitle", "time": 6111.99, "timestamp": "01:41:51", "text": "。"}, {"type": "subtitle", "time": 6116.709, "timestamp": "01:41:56", "text": "配信を締めくくります。  ここ。   わかった"}]
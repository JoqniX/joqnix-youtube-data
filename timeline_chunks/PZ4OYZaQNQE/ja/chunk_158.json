[{"type": "subtitle", "time": 9494.15, "timestamp": "02:38:14", "text": "["}, {"type": "subtitle", "time": 9498.389, "timestamp": "02:38:18", "text": "音楽]"}, {"type": "subtitle", "time": 9504.389, "timestamp": "02:38:24", "text": "骨の腕の泡は、"}, {"type": "subtitle", "time": 9506.309, "timestamp": "02:38:26", "text": "いや、いや、いやのようです。 それの上に落ちている。   なんてこった。"}, {"type": "subtitle", "time": 9509.19, "timestamp": "02:38:29", "text": "それは悪いことですか？ クリーミーですか？"}, {"type": "subtitle", "time": 9512.23, "timestamp": "02:38:32", "text": "ろうそくを食べてもいいですか？ 待って。 それは"}, {"type": "subtitle", "time": 9514.24, "timestamp": "02:38:34", "text": "悪いことではないですか？"}, {"type": "subtitle", "time": 9518.309, "timestamp": "02:38:38", "text": "[音楽] ちょっと"}, {"type": "subtitle", "time": 9520.71, "timestamp": "02:38:40", "text": "待って、ろうそくを食べるの？ わかった。 こんにちは。"}, {"type": "subtitle", "time": 9523.349, "timestamp": "02:38:43", "text": "上がっています。 時間切れ。 時間切れ。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 9527.349, "timestamp": "02:38:47", "text": "そこが問題なんです。 では、誕生日のお祝いの"}, {"type": "subtitle", "time": 9532.23, "timestamp": "02:38:52", "text": "歌を歌いましょう。 わかった。 わかった。   改めて"}, {"type": "subtitle", "time": 9535.11, "timestamp": "02:38:55", "text": "、"}, {"type": "subtitle", "time": 9538.469, "timestamp": "02:38:58", "text": "今日来てくださった皆様に感謝申し上げます。そして、"}]
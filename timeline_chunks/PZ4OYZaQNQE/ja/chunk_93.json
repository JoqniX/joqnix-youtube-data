[{"type": "subtitle", "time": 5583.189, "timestamp": "01:33:03", "text": "今日だけだよ、ポコ。"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "今日だけ。"}, {"type": "subtitle", "time": 5590.149, "timestamp": "01:33:10", "text": "そして、こうやってぼかします"}, {"type": "subtitle", "time": 5595.03, "timestamp": "01:33:15", "text": "。よし。みんな準備はいい？えっと、ちょっと待って"}, {"type": "subtitle", "time": 5599.27, "timestamp": "01:33:19", "text": "。オリジナルが上。"}, {"type": "subtitle", "time": 5601.99, "timestamp": "01:33:21", "text": "新しいモデルを見る準備はいい？その"}, {"type": "subtitle", "time": 5606.39, "timestamp": "01:33:26", "text": "下位バージョンだよ。えっと、ちょっと待って。"}, {"type": "subtitle", "time": 5609.35, "timestamp": "01:33:29", "text": "もう一度確認させて。えっと、おいおい。"}, {"type": "subtitle", "time": 5612.709, "timestamp": "01:33:32", "text": "えっと、実際のものは表示されてないよね"}, {"type": "subtitle", "time": 5614.709, "timestamp": "01:33:34", "text": "？よし。よし。"}, {"type": "subtitle", "time": 5617.91, "timestamp": "01:33:37", "text": "これだけ。よし。"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "ああ、神様、"}, {"type": "subtitle", "time": 5626.31, "timestamp": "01:33:46", "text": "やってるよ。"}, {"type": "subtitle", "time": 5631.189, "timestamp": "01:33:51", "text": "どう思うか教えて。よし。えっと"}, {"type": "subtitle", "time": 5633.189, "timestamp": "01:33:53", "text": "、"}, {"type": "subtitle", "time": 5635.51, "timestamp": "01:33:55", "text": "３、２、１"}, {"type": "chat", "time": 5638.934, "timestamp": "01:33:58", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/LsMfY8P6G-yckNAPjoWA8AI"}]
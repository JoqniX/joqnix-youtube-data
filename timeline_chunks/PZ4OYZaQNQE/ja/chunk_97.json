[{"type": "subtitle", "time": 5822.55, "timestamp": "01:37:02", "text": "何かを見ることができましたよ"}, {"type": "subtitle", "time": 5824.87, "timestamp": "01:37:04", "text": "ね？"}, {"type": "subtitle", "time": 5827.35, "timestamp": "01:37:07", "text": "シルエットがとてもフリルです。大好きです。"}, {"type": "subtitle", "time": 5829.83, "timestamp": "01:37:09", "text": "ええ。ええ。ええ、そうです。とても"}, {"type": "subtitle", "time": 5832.629, "timestamp": "01:37:12", "text": "フレンドリーです。とてもエレガントです 本当に綺麗です"}, {"type": "subtitle", "time": 5843.35, "timestamp": "01:37:23", "text": "だからこそ、このモデルこそが"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "私がChoathonを頑張っている理由なんです。"}, {"type": "subtitle", "time": 5852.149, "timestamp": "01:37:32", "text": "自分にはできる、このモデルを使う資格がある、"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "このモデルを使う資格があることを証明するために、全力を尽くしています"}, {"type": "subtitle", "time": 5863.99, "timestamp": "01:37:43", "text": "。本当に綺麗な"}, {"type": "subtitle", "time": 5867.03, "timestamp": "01:37:47", "text": "モデルで、"}, {"type": "subtitle", "time": 5869.75, "timestamp": "01:37:49", "text": "心から愛しています。一生懸命"}, {"type": "subtitle", "time": 5873.35, "timestamp": "01:37:53", "text": "働かなければならないとしても、パートタイムでも何でも構いません。"}, {"type": "subtitle", "time": 5876.39, "timestamp": "01:37:56", "text": "最終的には"}]
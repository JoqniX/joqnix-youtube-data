[{"type": "subtitle", "time": 10629.83, "timestamp": "02:57:09", "text": "。   それを"}, {"type": "subtitle", "time": 10642.95, "timestamp": "02:57:22", "text": "家族は、このキャンディーをくれました。"}, {"type": "subtitle", "time": 10652.95, "timestamp": "02:57:32", "text": "。 こんにちは。 ええと、"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "ここで終わりにします。"}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "父を捕まえて、彼らと一緒に"}, {"type": "subtitle", "time": 10662.23, "timestamp": "02:57:42", "text": "夕食を食べようと思います。 えっと、母は"}, {"type": "subtitle", "time": 10665.429, "timestamp": "02:57:45", "text": "もう食事を済ませていて、"}, {"type": "subtitle", "time": 10667.75, "timestamp": "02:57:47", "text": "10時からずっと私と一緒にいますよね？"}, {"type": "subtitle", "time": 10669.349, "timestamp": "02:57:49", "text": "こんにちは。"}, {"type": "subtitle", "time": 10674.389, "timestamp": "02:57:54", "text": "誕生日配信をご覧いただき、ありがとうございました"}, {"type": "subtitle", "time": 10677.11, "timestamp": "02:57:57", "text": "。 楽しんでいただけたなら幸いです。"}]
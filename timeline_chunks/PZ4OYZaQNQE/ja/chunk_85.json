[{"type": "subtitle", "time": 5100.82, "timestamp": "01:25:00", "text": "最後の瞬間に聞いても大丈夫なのかわかりませんし、"}, {"type": "subtitle", "time": 5106.07, "timestamp": "01:25:06", "text": "許可なしでは見せるべきではないのかもわかりません。"}, {"type": "subtitle", "time": 5124.39, "timestamp": "01:25:24", "text": "待って。私はただ"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "つまり、去年の今日、去年の"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "8月12日、私の誕生日の後、"}, {"type": "subtitle", "time": 5142.55, "timestamp": "01:25:42", "text": "初めて"}, {"type": "subtitle", "time": 5144.629, "timestamp": "01:25:44", "text": "新しいモデルを見たんです。"}, {"type": "subtitle", "time": 5146.47, "timestamp": "01:25:46", "text": "えっと、"}, {"type": "subtitle", "time": 5149.51, "timestamp": "01:25:49", "text": "アーティストから。ええ"}, {"type": "subtitle", "time": 5153.35, "timestamp": "01:25:53", "text": "。それで、"}, {"type": "subtitle", "time": 5155.99, "timestamp": "01:25:55", "text": "シャナ、大丈夫かどうか聞きたいんだけど。わから"}, {"type": "subtitle", "time": 5159.189, "timestamp": "01:25:59", "text": "ない。オンラインじゃないし。"}]
[{"type": "subtitle", "time": 4200.709, "timestamp": "01:10:00", "text": "。得意なことをしたいんです"}, {"type": "subtitle", "time": 4202.709, "timestamp": "01:10:02", "text": "。だから、"}, {"type": "subtitle", "time": 4203.669, "timestamp": "01:10:03", "text": "歌を歌います。"}, {"type": "subtitle", "time": 4206.07, "timestamp": "01:10:06", "text": "ああ、神様。"}, {"type": "subtitle", "time": 4211.669, "timestamp": "01:10:11", "text": "お誕生日おめでとう。お誕生日おめでとう。お誕生日おめでとう"}, {"type": "subtitle", "time": 4217.27, "timestamp": "01:10:17", "text": "、ダーリン。"}, {"type": "subtitle", "time": 4221.189, "timestamp": "01:10:21", "text": "お誕生日おめでとう。"}, {"type": "subtitle", "time": 4224.149, "timestamp": "01:10:24", "text": "神のご加護がありますように。"}, {"type": "subtitle", "time": 4226.48, "timestamp": "01:10:26", "text": "ああ、神様、私はとても幸せです。"}, {"type": "subtitle", "time": 4227.99, "timestamp": "01:10:27", "text": "[音楽]"}, {"type": "subtitle", "time": 4231.75, "timestamp": "01:10:31", "text": "神のご加護がありますように。"}, {"type": "subtitle", "time": 4235.51, "timestamp": "01:10:35", "text": "お誕生日おめでとう。"}, {"type": "subtitle", "time": 4236.55, "timestamp": "01:10:36", "text": "ありがとう。よし。"}, {"type": "subtitle", "time": 4240.79, "timestamp": "01:10:40", "text": "これで著作権侵害にならないことを願いますが、ええ。私の"}, {"type": "subtitle", "time": 4243.35, "timestamp": "01:10:43", "text": "友達でいてくれて本当にありがとう。あなたに"}, {"type": "subtitle", "time": 4247.43, "timestamp": "01:10:47", "text": "出会えて、友達と呼べることをとても嬉しく思います"}, {"type": "subtitle", "time": 4249.669, "timestamp": "01:10:49", "text": "。あなたは本当に素晴らしい人です。"}, {"type": "subtitle", "time": 4251.91, "timestamp": "01:10:51", "text": "いつも"}, {"type": "subtitle", "time": 4255.11, "timestamp": "01:10:55", "text": "私を支えてくれて、いつも助けてくれて、"}]
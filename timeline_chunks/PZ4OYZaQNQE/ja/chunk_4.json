[{"type": "subtitle", "time": 241.99, "timestamp": "00:04:01", "text": "ちょっと遅かったですね。 えっと、あまり"}, {"type": "subtitle", "time": 244.949, "timestamp": "00:04:04", "text": "多くの人を招待しなかったんです。"}, {"type": "subtitle", "time": 247.75, "timestamp": "00:04:07", "text": "えっと、どちらかというと家族的な感じですね。   えーっと、"}, {"type": "subtitle", "time": 251.75, "timestamp": "00:04:11", "text": "私の家族、母、"}, {"type": "subtitle", "time": 255.83, "timestamp": "00:04:15", "text": "父、私、祖母、"}, {"type": "subtitle", "time": 259.83, "timestamp": "00:04:19", "text": "そして、えーっと、こちらは叔母さんというか、"}, {"type": "subtitle", "time": 263.43, "timestamp": "00:04:23", "text": "料理などを手伝ってくれる人です"}, {"type": "subtitle", "time": 266.95, "timestamp": "00:04:26", "text": "。 それに、彼女も私たちの"}, {"type": "subtitle", "time": 270.629, "timestamp": "00:04:30", "text": "家の近くに住んでいます。 それで"}, {"type": "subtitle", "time": 273.27, "timestamp": "00:04:33", "text": "彼女もやって来た。"}, {"type": "subtitle", "time": 275.35, "timestamp": "00:04:35", "text": "うん。"}, {"type": "subtitle", "time": 279.43, "timestamp": "00:04:39", "text": "全体的に見て、ちょっと残念な誕生日だったけど、その残念な状況も"}, {"type": "chat", "time": 282.852, "timestamp": "00:04:42", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "hewoooo yay"}, {"type": "chat", "time": 286.214, "timestamp": "00:04:46", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Thorn— VT~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "chat", "time": 288.69, "timestamp": "00:04:48", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "HAPPY BIRTHDAY FINALLY"
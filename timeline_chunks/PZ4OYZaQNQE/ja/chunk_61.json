[{"type": "subtitle", "time": 3660.47, "timestamp": "01:01:00", "text": "か来月には実施したいと思っています。 えっと、"}, {"type": "subtitle", "time": 3662.789, "timestamp": "01:01:02", "text": "コラボレーションする予定だったんですが、"}, {"type": "subtitle", "time": 3665.109, "timestamp": "01:01:05", "text": "残念ながらビリー・ビリーへのアクセスが"}, {"type": "subtitle", "time": 3668.069, "timestamp": "01:01:08", "text": "制限されてしまいました。 だから、もうBilly Bullyで配信はできない"}, {"type": "subtitle", "time": 3672.71, "timestamp": "01:01:12", "text": "けど、"}, {"type": "subtitle", "time": 3675.19, "timestamp": "01:01:15", "text": "またBilly Bullyで配信できるといいなと思っています。 もうどうでもいい"}, {"type": "subtitle", "time": 3678.15, "timestamp": "01:01:18", "text": "。 レイブンソンは私をとても助けてくれました。特に、"}, {"type": "subtitle", "time": 3682.63, "timestamp": "01:01:22", "text": "会社が解散してストリーミング配信ができなくなった後も、ずっと助けてくれました"}, {"type": "subtitle", "time": 3685.75, "timestamp": "01:01:25", "text": "。 彼女は、機会があれば"}, {"type": "subtitle", "time": 3693.91, "timestamp": "01:01:33", "text": "他の企業MCNやMGNなどに連絡を取ろうと最善を尽くしました"}, {"type": "subtitle", "time": 3697.91, "timestamp": "01:01:37", "text": "。 ええ、MCN は、"}, {"type": "subtitle", "time": 3700.87, "timestamp": "01:01:40", "text": "私の作品について話してくれました。"}, {"type": "subtitle", "time": 3703.03, "timestamp": "01:01:43", "text": "ビリー ビリー MCN は、チャンネルの"}, {"type": "subtitle", "time": 3708.069, "timestamp": "01:01:48", "text": "視聴回数やエンゲージメントを増やす必要があるため、より要求が厳しかったのですが"}, {"type": "subtitle", "time": 3711.109, "timestamp": "01:01:51", "text": "。 でも、うまくいけば今年、うまくいけば"}, {"type": "subtitle", "time": 3713.109, "timestamp": "01:01:53", "text": "来年、来年までには、"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "何らかの方法でそこで配信できることを願っています。"}, {"type": "subtitle", "time": 3718.87, "timestamp": "01:01:58", "text": "配信とか色々好きになれるように頑張ります。"}]
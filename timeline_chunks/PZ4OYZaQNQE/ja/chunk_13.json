[{"type": "subtitle", "time": 781.03, "timestamp": "00:13:01", "text": "感情的に「"}, {"type": "subtitle", "time": 785.03, "timestamp": "00:13:05", "text": "あなたは私を作ったわけじゃないのに、"}, {"type": "subtitle", "time": 788.23, "timestamp": "00:13:08", "text": "どうして長年友達でいられたの？」なんて思ったりはしません"}, {"type": "subtitle", "time": 796.069, "timestamp": "00:13:16", "text": "こんにちは。   えっと、"}, {"type": "subtitle", "time": 799.19, "timestamp": "00:13:19", "text": "皆さんにも見ていただけるように、これを録画しておきますね"}, {"type": "subtitle", "time": 804.069, "timestamp": "00:13:24", "text": "。 私たちは一緒にやる。 わかった。"}, {"type": "chat", "time": 805.436, "timestamp": "00:13:25", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "I would be petty like that tho"}, {"type": "subtitle", "time": 807.03, "timestamp": "00:13:27", "text": "神。 ええと、ちょっとだけ覗いただけです。"}, {"type": "subtitle", "time": 809.99, "timestamp": "00:13:29", "text": "私は内容を一切読んでいません。   えっと、わかりました"}, {"type": "subtitle", "time": 817.99, "timestamp": "00:13:37", "text": "。 えっと、改めて、"}, {"type": "subtitle", "time": 821.509, "timestamp": "00:13:41", "text": "時間を割いて"}, {"type": "subtitle", "time": 824.87, "timestamp": "00:13:44", "text": "メッセージを書いてくださった皆さんに感謝します。"}, {"type": "subtitle", "time": 826.47, "timestamp": "00:13:46", "text": "アンナさん、ありがとう。"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "[音楽]"}, {"type": "subtitle", "time": 832.949, "timestamp": "00:13:52", "text": "ああ、よし、これを録音しておこう。"}, {"type": "subtitle", "time": 835.99, "timestamp": "00:13:55", "text": "なんてこった、どうして何もかもなくなってしまったんだ"}]
[{"type": "subtitle", "time": 3241.75, "timestamp": "00:54:01", "text": "素敵なプレゼントと"}, {"type": "subtitle", "time": 3243.75, "timestamp": "00:54:03", "text": "誕生日メッセージをありがとうございました。"}, {"type": "subtitle", "time": 3246.71, "timestamp": "00:54:06", "text": "Dさん、ありがとう。ディオとのコラボレーションは本当に楽しかったです。"}, {"type": "subtitle", "time": 3250.39, "timestamp": "00:54:10", "text": "ありがとう。"}, {"type": "subtitle", "time": 3253.43, "timestamp": "00:54:13", "text": "混沌としていたけれど、本当に楽しかったです。"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "コラボって何て言うんだっけ？"}, {"type": "subtitle", "time": 3259.75, "timestamp": "00:54:19", "text": "誰も料理をしていなかったし、すべてが"}, {"type": "subtitle", "time": 3262.87, "timestamp": "00:54:22", "text": "本当に楽しかったです。ずっと前に"}, {"type": "subtitle", "time": 3265.19, "timestamp": "00:54:25", "text": "一緒にフォートナイトをプレイしたのを今でも覚えています。"}, {"type": "subtitle", "time": 3268.63, "timestamp": "00:54:28", "text": "覚えているかどうかわかりませんが、"}, {"type": "subtitle", "time": 3271.75, "timestamp": "00:54:31", "text": "ヴァレラントも一緒にプレイしました。"}, {"type": "subtitle", "time": 3278.79, "timestamp": "00:54:38", "text": "私と一緒に小さな思い出を作ってくれてありがとう。温かくて"}, {"type": "subtitle", "time": 3280.23, "timestamp": "00:54:40", "text": "親切で"}, {"type": "subtitle", "time": 3288.63, "timestamp": "00:54:48", "text": "。 だから、"}, {"type": "subtitle", "time": 3291.75, "timestamp": "00:54:51", "text": "読んだ記憶がないんです。"}, {"type": "subtitle", "time": 3295.03, "timestamp": "00:54:55", "text": "次はザキです。"}, {"type": "subtitle", "time": 3298.23, "timestamp": "00:54:58", "text": "素敵な誕生日メッセージをありがとうございました。"}]
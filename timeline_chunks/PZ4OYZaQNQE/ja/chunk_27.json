[{"type": "subtitle", "time": 1621.19, "timestamp": "00:27:01", "text": "。"}, {"type": "subtitle", "time": 1624.39, "timestamp": "00:27:04", "text": "ドクター、誕生日おめでとうございます。 正直言って、"}, {"type": "subtitle", "time": 1626.63, "timestamp": "00:27:06", "text": "星座が"}, {"type": "subtitle", "time": 1630.31, "timestamp": "00:27:10", "text": "人間の年齢で祝っているなんて、今でも信じられない。"}, {"type": "subtitle", "time": 1639.75, "timestamp": "00:27:19", "text": "オレンジ色の点々のおかげで、宇宙が少し小さく感じられ、ずっと暖かく感じられる。"}, {"type": "subtitle", "time": 1642.39, "timestamp": "00:27:22", "text": "あなたが正しい。 何てことだ。"}, {"type": "subtitle", "time": 1644.71, "timestamp": "00:27:24", "text": "素敵な"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "メッセージと誕生日のお祝いをありがとうございます。"}, {"type": "subtitle", "time": 1650.549, "timestamp": "00:27:30", "text": "Dさん、ありがとう。時間を割いて"}, {"type": "subtitle", "time": 1653.75, "timestamp": "00:27:33", "text": "メッセージを書いてくれて本当にありがとう"}, {"type": "chat", "time": 1656.837, "timestamp": "00:27:36", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "😭❣❣❣🎉"}, {"type": "subtitle", "time": 1657.59, "timestamp": "00:27:37", "text": "。  Dさん、ありがとうございます。"}, {"type": "subtitle", "time": 1661.75, "timestamp": "00:27:41", "text": "このメッセージにどれほど感謝しているか、言葉では言い表せません。"}, {"type": "subtitle", "time": 1665.269, "timestamp": "00:27:45", "text": "ええ、特に、"}, {"type": "subtitle", "time": 1669.51, "timestamp": "00:27:49", "text": "皆さんもご存知のあの部分ですね。 私は、えーっと、なんて"}, {"type": "subtitle", "time": 1672.71, "timestamp": "00:27:52", "text": "言うんでしょうか、インポスター"}, {"type": "subtitle", "time": 1674.87, "timestamp": "00:27:54", "text": "症候群なので、自分の好きなことを認めず、"}, {"type": "subtitle", "time": 1677.909, "timestamp": "00:27:57", "text": "自分の"}]
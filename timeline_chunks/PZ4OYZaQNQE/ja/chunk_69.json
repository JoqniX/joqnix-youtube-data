[{"type": "subtitle", "time": 4148.709, "timestamp": "01:09:08", "text": "。彼女はストリーミング配信している。ああ、そうね。"}, {"type": "subtitle", "time": 4161.349, "timestamp": "01:09:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 4164.95, "timestamp": "01:09:24", "text": "えっと、音声がちゃんと聞こえるか確認させてください。あまり大丈夫じゃないんです。よし、音声は入ってるよね？"}, {"type": "subtitle", "time": 4167.349, "timestamp": "01:09:27", "text": "ミュートして、"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "こんにちは。このビデオメッセージを一緒に共有しましょうか"}, {"type": "subtitle", "time": 4175.91, "timestamp": "01:09:35", "text": "？"}, {"type": "subtitle", "time": 4181.189, "timestamp": "01:09:41", "text": "。３、２、１"}, {"type": "subtitle", "time": 4184.39, "timestamp": "01:09:44", "text": "。"}, {"type": "subtitle", "time": 4186.309, "timestamp": "01:09:46", "text": "とても幸せな"}, {"type": "subtitle", "time": 4188.709, "timestamp": "01:09:48", "text": "誕生日を願っています。ジョー、神のご加護がありますように。この"}, {"type": "subtitle", "time": 4190.95, "timestamp": "01:09:50", "text": "髪があなたにたくさんの喜びと幸せをもたらしますように"}, {"type": "subtitle", "time": 4194.79, "timestamp": "01:09:54", "text": "。そして、ええ、私は"}, {"type": "subtitle", "time": 4198.149, "timestamp": "01:09:58", "text": "言葉があまり得意ではないんです。だから、 私はただ自分の得意なことをするだけです"}]
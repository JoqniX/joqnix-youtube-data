[{"type": "subtitle", "time": 4322.55, "timestamp": "01:12:02", "text": "ああ、神様。彼女は"}, {"type": "subtitle", "time": 4325.189, "timestamp": "01:12:05", "text": "誕生日の歌についてのビデオメッセージを歌ってくれた。ああ、"}, {"type": "subtitle", "time": 4329.35, "timestamp": "01:12:09", "text": "神様。うん。"}, {"type": "subtitle", "time": 4332.07, "timestamp": "01:12:12", "text": "ええと、共有の話ですが、私は、私が"}, {"type": "subtitle", "time": 4344.47, "timestamp": "01:12:24", "text": "シャリンと出会った経緯や、"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "シャリンと過ごしたすべての思い出、そして"}, {"type": "subtitle", "time": 4350.95, "timestamp": "01:12:30", "text": "将来、"}, {"type": "subtitle", "time": 4354.47, "timestamp": "01:12:34", "text": "彼女とコラボしたいと思ったことなどについて、15分のビデオメッセージを作ったと思います。ええ、"}, {"type": "subtitle", "time": 4357.669, "timestamp": "01:12:37", "text": "それを見ることができます。ええと、それはshですが、"}, {"type": "subtitle", "time": 4362.31, "timestamp": "01:12:42", "text": "ええと、本当にありがとう。"}, {"type": "subtitle", "time": 4365.83, "timestamp": "01:12:45", "text": "コラボしましょう。ちゃんとしたコラボをしましょう。 はい。はい。そうですね、"}, {"type": "subtitle", "time": 4373.75, "timestamp": "01:12:53", "text": "今月は"}, {"type": "subtitle", "time": 4379.83, "timestamp": "01:12:59", "text": "コラボとかそういうのに時間が空いているので、ぜひコラボしましょう。スケジュールとかは"}]
[{"type": "subtitle", "time": 6482.709, "timestamp": "01:48:02", "text": "私はたくさんの人に感謝しています。"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "彼らの名前を口に出して言えたらいいのに、"}, {"type": "subtitle", "time": 6488.709, "timestamp": "01:48:08", "text": "できないんです。"}, {"type": "subtitle", "time": 6491.75, "timestamp": "01:48:11", "text": "デビュー配信のために取っておかないといけないからです。 はぁ？"}, {"type": "subtitle", "time": 6494.47, "timestamp": "01:48:14", "text": "皆さんがこの件で私を助けてくれました。"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "うん。"}, {"type": "subtitle", "time": 6497.669, "timestamp": "01:48:17", "text": "うーん、"}, {"type": "subtitle", "time": 6500.47, "timestamp": "01:48:20", "text": "それはまさに夢のようです。 いや、それは"}, {"type": "subtitle", "time": 6503.669, "timestamp": "01:48:23", "text": "失われた夢のようなものだった。 まるで夢のような出来事だったけれど"}, {"type": "subtitle", "time": 6508.229, "timestamp": "01:48:28", "text": "、私が"}, {"type": "subtitle", "time": 6512.149, "timestamp": "01:48:32", "text": "選んだアーティストのおかげで、今まで以上に美しくなれたことが本当に嬉しい"}, {"type": "subtitle", "time": 6515.99, "timestamp": "01:48:35", "text": "。 私は彼女の画風が本当に大好きで、ずっと"}, {"type": "subtitle", "time": 6527.51, "timestamp": "01:48:47", "text": "舞台裏で全てが解決して、"}, {"type": "subtitle", "time": 6529.43, "timestamp": "01:48:49", "text": "これが将来の公式モデルになることを本当に願っています。今のところ、"}, {"type": "subtitle", "time": 6532.55, "timestamp": "01:48:52", "text": "これが私たちが"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "見ることのできる全てです。"}, {"type": "subtitle", "time": 6537.75, "timestamp": "01:48:57", "text": "はい、まさにジェンダーニュートラルなモデルです。 はい。"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "つまり、つまり、それは"}]
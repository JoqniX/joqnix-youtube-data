[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "？ 私はしていません。 わかった。 わかった。 そうだったと思います"}, {"type": "subtitle", "time": 3003.67, "timestamp": "00:50:03", "text": "。 わからない。"}, {"type": "subtitle", "time": 3005.589, "timestamp": "00:50:05", "text": "何かを読んだ記憶がある。"}, {"type": "subtitle", "time": 3008.15, "timestamp": "00:50:08", "text": "マヤ、ありがとう。ザキ、"}, {"type": "subtitle", "time": 3011.43, "timestamp": "00:50:11", "text": "素敵なメッセージをありがとう。"}, {"type": "subtitle", "time": 3013.829, "timestamp": "00:50:13", "text": "そして、どこかへ行かなくちゃ。 それでは、"}, {"type": "subtitle", "time": 3018.71, "timestamp": "00:50:18", "text": "お気をつけて、安全な旅を。"}, {"type": "subtitle", "time": 3021.43, "timestamp": "00:50:21", "text": "無事に帰宅してください。"}, {"type": "subtitle", "time": 3023.91, "timestamp": "00:50:23", "text": "こんにちは、アディ。 誕生日の"}, {"type": "subtitle", "time": 3027.67, "timestamp": "00:50:27", "text": "お祝いのメッセージをありがとうございます。 ありがとう。   ソーン・サン"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "素敵なメッセージを書いてくださってありがとうございます。"}, {"type": "subtitle", "time": 3040.47, "timestamp": "00:50:40", "text": "ええと、それは本当に大きな意味があります。 ええと"}, {"type": "subtitle", "time": 3043.349, "timestamp": "00:50:43", "text": "、"}, {"type": "subtitle", "time": 3045.349, "timestamp": "00:50:45", "text": "ご存知の通り、私はよく自分に自信が持てなくて、考えすぎてしまうんです"}, {"type": "subtitle", "time": 3049.43, "timestamp": "00:50:49", "text": "。 でも、えっと、長年の間に、私が彼らにインスピレーションを与えたとか、そういうことを言う"}, {"type": "subtitle", "time": 3052.069, "timestamp": "00:50:52", "text": "人が何人かいることに気づきましたが"}, {"type": "subtitle", "time": 3059.19, "timestamp": "00:50:59", "text": "、それでも、私はよくわかりません"}]
[{"type": "subtitle", "time": 6782.709, "timestamp": "01:53:02", "text": "？"}, {"type": "subtitle", "time": 6784.95, "timestamp": "01:53:04", "text": "パンダさんにも感謝します。"}, {"type": "subtitle", "time": 6788.28, "timestamp": "01:53:08", "text": "ひどい料理をありがとう。"}, {"type": "subtitle", "time": 6799.589, "timestamp": "01:53:19", "text": "よし、大丈夫だと思う。 すべてはまあまあ"}, {"type": "subtitle", "time": 6803.51, "timestamp": "01:53:23", "text": "良いはずだ。   わかりました"}, {"type": "subtitle", "time": 6815.03, "timestamp": "01:53:35", "text": "[音楽]"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "ええと、わかりました"}, {"type": "subtitle", "time": 6821.99, "timestamp": "01:53:41", "text": "。 こんにちは。 というわけで、明日はゲーム配信を予定しています"}, {"type": "subtitle", "time": 6824.629, "timestamp": "01:53:44", "text": "。"}, {"type": "subtitle", "time": 6827.51, "timestamp": "01:53:47", "text": "ゲーム配信を予定しています。"}, {"type": "subtitle", "time": 6829.83, "timestamp": "01:53:49", "text": "今日は小川が短かった。 うん。"}, {"type": "subtitle", "time": 6832.07, "timestamp": "01:53:52", "text": "短くしようと思ったのは、いいえ、今日は私の誕生日なので、"}, {"type": "subtitle", "time": 6835.109, "timestamp": "01:53:55", "text": "家族と少し楽しむつもりだからです"}, {"type": "subtitle", "time": 6838.709, "timestamp": "01:53:58", "text": "。 一緒に食事をしたり、何でも一緒にします。"}]
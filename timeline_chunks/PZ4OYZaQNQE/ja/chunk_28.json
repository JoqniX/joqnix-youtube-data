[{"type": "subtitle", "time": 1680.389, "timestamp": "00:28:00", "text": "能力やスキル、その他自分がしてきたことすべてを常に疑っています"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "。 ああ、でも、私には"}, {"type": "subtitle", "time": 1686.789, "timestamp": "00:28:06", "text": "これが本当に必要だったと思う。"}, {"type": "subtitle", "time": 1699.669, "timestamp": "00:28:19", "text": "誕生日のお祝いのメッセージをありがとうございました。 次は、"}, {"type": "subtitle", "time": 1703.59, "timestamp": "00:28:23", "text": "ロアが登場します。 誕生日おめでとう、兄弟。 今年も"}, {"type": "subtitle", "time": 1706.389, "timestamp": "00:28:26", "text": "素晴らしい一年になりますように。"}, {"type": "subtitle", "time": 1710.549, "timestamp": "00:28:30", "text": "素敵な誕生日プレゼントをありがとうございました。"}, {"type": "chat", "time": 1711.609, "timestamp": "00:28:31", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "you're not crying are you"}, {"type": "subtitle", "time": 1714.149, "timestamp": "00:28:34", "text": "ありがとう、ロー。"}, {"type": "subtitle", "time": 1722.389, "timestamp": "00:28:42", "text": "私は泣いていません。 あなたは家に帰ってきました。"}, {"type": "subtitle", "time": 1726.389, "timestamp": "00:28:46", "text": "ああ、バカ。 そして、アニケタがいます。"}, {"type": "subtitle", "time": 1729.51, "timestamp": "00:28:49", "text": "誕生日おめでとう、相棒。 キックの絵文字。"}, {"type": "subtitle", "time": 1730.95, "timestamp": "00:28:50", "text": "あなたは私が今まで見てきた中で最も勤勉な"}, {"type": "subtitle", "time": 1733.11, "timestamp": "00:28:53", "text": "配信者の一人です。 健康でいて、"}, {"type": "subtitle", "time": 1735.83, "timestamp": "00:28:55", "text": "カッコよくあり続けよう。 筋肉の絵文字。"}, {"type": "subtitle", "time": 1738.63, "timestamp": "00:28:58", "text": "ありがとう。 子供たちをありがとう。 私たちに"}]
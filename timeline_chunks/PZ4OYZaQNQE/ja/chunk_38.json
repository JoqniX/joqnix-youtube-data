[{"type": "subtitle", "time": 2287.27, "timestamp": "00:38:07", "text": "あなたにお会いしたり、彼と話したりできて本当に楽しかったです"}, {"type": "subtitle", "time": 2289.43, "timestamp": "00:38:09", "text": "。"}, {"type": "subtitle", "time": 2291.829, "timestamp": "00:38:11", "text": "私にとって良い友達でいてくれてありがとう。これからも"}, {"type": "subtitle", "time": 2297.03, "timestamp": "00:38:17", "text": "一緒にたくさんの思い出を作り、もっと多くの時間を過ごし、"}, {"type": "subtitle", "time": 2299.349, "timestamp": "00:38:19", "text": "将来もたくさんコラボレーションできたらいいなと思っています。"}, {"type": "subtitle", "time": 2302.39, "timestamp": "00:38:22", "text": "いえ、誕生日のお祝いのメッセージをいただき、本当にありがとうございます。そして、"}, {"type": "subtitle", "time": 2315.109, "timestamp": "00:38:35", "text": "Twitchでたまたま配信を探していた時に私を見つけてくださったことにも感謝しています。 それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 2317.829, "timestamp": "00:38:37", "text": "こんにちは、えっと、"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "私が"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "読み終えたものをいくつか紹介します。 わかった。"}, {"type": "subtitle", "time": 2326.63, "timestamp": "00:38:46", "text": "こんにちは、ザン。誕生日のお祝いをありがとう。お誕生日おめでとうございます。"}, {"type": "subtitle", "time": 2330.87, "timestamp": "00:38:50", "text": "ありがとう。"}]
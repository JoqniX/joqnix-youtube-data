[{"type": "subtitle", "time": 3600.15, "timestamp": "01:00:00", "text": "さん。 スクリュー・レイヴンは、"}, {"type": "subtitle", "time": 3602.47, "timestamp": "01:00:02", "text": "ビリー・ビリーで知り合った人です。"}, {"type": "subtitle", "time": 3605.43, "timestamp": "01:00:05", "text": "えっと、YouTuberを探していました。 私は"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "ビリービリーという中国のユーチューバーをたくさん見ていました。"}, {"type": "subtitle", "time": 3613.67, "timestamp": "01:00:13", "text": "あるYouTuberが"}, {"type": "subtitle", "time": 3616.47, "timestamp": "01:00:16", "text": "英語の動画を見ているのを見かけた。  YouTube が"}, {"type": "chat", "time": 3618.203, "timestamp": "01:00:18", "author": "@ogbluealien", "avatar": "https://yt4.ggpht.com/kiZ3VTdjn3AS-JTnZV0Knzaa5v1Dk1BttGbjFA5CUBf-41f-rGfxFChEJlSkv4jicC8lwTvNdw=s64-c-k-c0x00ffffff-no-rj", "message": "🎂🍰🍰🍰 "}, {"type": "subtitle", "time": 3620.069, "timestamp": "01:00:20", "text": "ビリーで実際に公開されたので、私は驚いたのですが、"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "彼らと話しました。"}, {"type": "subtitle", "time": 3625.91, "timestamp": "01:00:25", "text": "ビリーでチャットすると私の"}, {"type": "subtitle", "time": 3628.23, "timestamp": "01:00:28", "text": "IP が表示されるので、私はインド出身です。彼らは私の"}, {"type": "subtitle", "time": 3630.23, "timestamp": "01:00:30", "text": "プロフィールを確認し、"}, {"type": "subtitle", "time": 3632.87, "timestamp": "01:00:32", "text": "インド出身の西洋人なのに、なぜビリーで何をしているのかと言いました。"}, {"type": "subtitle", "time": 3634.71, "timestamp": "01:00:34", "text": "それから私たちはゆっくりとチャットしてコミュニケーションを取りました。"}, {"type": "subtitle", "time": 3637.75, "timestamp": "01:00:37", "text": "スクリュー"}, {"type": "subtitle", "time": 3640.549, "timestamp": "01:00:40", "text": "レイヴンソンは、ビリーでの私の旅で私を大いに助けてくれました。"}, {"type": "subtitle", "time": 3643.99, "timestamp": "01:00:43", "text": "彼女は私を助​​けてくれました。私たちは、"}, {"type": "subtitle", "time": 3648.15, "timestamp": "01:00:48", "text": "昨年の 6 月にコラボレーションを計画していました"}, {"type": "subtitle", "time": 3651.67, "timestamp": "01:00:51", "text": "。 えっと、でも彼女は引っ越さなきゃいけなかったから、できなかったんです"}, {"type": "subtitle", "time": 3654.309, "timestamp": "01:00:54", "text": "。 しかし、できれば"}, {"type": "subtitle", "time": 3656.549, "timestamp": "01:00:56", "text": "今月"}]
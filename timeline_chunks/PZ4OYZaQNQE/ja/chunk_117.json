[{"type": "subtitle", "time": 7035.109, "timestamp": "01:57:15", "text": "何をしたいですか？ なんでしょう"}, {"type": "subtitle", "time": 7036.79, "timestamp": "01:57:16", "text": "？ 私はケーキを受け取るだけです。"}, {"type": "subtitle", "time": 7039.75, "timestamp": "01:57:19", "text": "ケーキでも何でも、"}, {"type": "subtitle", "time": 7041.43, "timestamp": "01:57:21", "text": "できることがあれば、好きなようにすればいい"}, {"type": "subtitle", "time": 7046.31, "timestamp": "01:57:26", "text": "。 原始の宝石とか何とか。 ええと、わかりました"}, {"type": "subtitle", "time": 7050.55, "timestamp": "01:57:30", "text": "。 わかった。 わかった。 えっと、"}, {"type": "subtitle", "time": 7057.27, "timestamp": "01:57:37", "text": "Google経由でログインしたのか、"}, {"type": "subtitle", "time": 7061.91, "timestamp": "01:57:41", "text": "メール経由でログインしたのか覚えていません。 正直、よくわかりません。 えっと、ちょっとウェブ"}, {"type": "subtitle", "time": 7064.629, "timestamp": "01:57:44", "text": "サイトにログインしてみますね。ログインしたら、結果をお見せします"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "ああ、まるで"}]
[{"type": "subtitle", "time": 9540.79, "timestamp": "02:39:00", "text": "ケーキをプレゼントしてくれたFunにも感謝します。"}, {"type": "subtitle", "time": 9544.87, "timestamp": "02:39:04", "text": "今までこんなことはしたことがなかったけど、本当に、すごく意味がある"}, {"type": "subtitle", "time": 9548.07, "timestamp": "02:39:08", "text": "。 ありがとう。   ろうそくを"}, {"type": "subtitle", "time": 9550.79, "timestamp": "02:39:10", "text": "食べないでください。 わかった。 こんにちは。 わかった。 じゃあ、もうろうそくは使わないってことね"}, {"type": "subtitle", "time": 9554.71, "timestamp": "02:39:14", "text": "。 わかった。 ええと、わかりました"}, {"type": "subtitle", "time": 9558.07, "timestamp": "02:39:18", "text": "。 こんにちは。 というわけで、"}, {"type": "subtitle", "time": 9562.23, "timestamp": "02:39:22", "text": "私の"}, {"type": "subtitle", "time": 9569.349, "timestamp": "02:39:29", "text": "2025年の5回目のUスターデーを祝ってくれた皆さんに改めて感謝します。 そして、この"}, {"type": "subtitle", "time": 9571.349, "timestamp": "02:39:31", "text": "祝賀はミームのためだけでなく、"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "ジョックニックのためでもある。 では、やってみましょう"}, {"type": "subtitle", "time": 9580.95, "timestamp": "02:39:40", "text": "。 誕生日おめでとう、私。 お誕生日おめでとう"}, {"type": "subtitle", "time": 9582.87, "timestamp": "02:39:42", "text": "。"}, {"type": "subtitle", "time": 9587.27, "timestamp": "02:39:47", "text": "ドクター・ネックスと私、誕生日おめでとう。"}, {"type": "subtitle", "time": 9592.07, "timestamp": "02:39:52", "text": "あなたと私、誕生日おめでとう。"}, {"type": "subtitle", "time": 9596.389, "timestamp": "02:39:56", "text": "こんにちは。"}, {"type": "subtitle", "time": 9599.91, "timestamp": "02:39:59", "text": "コンサートプレートや私の棚にいる私たち全員がそれをやります"}]
[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "私はそれを読みます。ええと、"}, {"type": "subtitle", "time": 6004.87, "timestamp": "01:40:04", "text": "新しいメッセージがあれば、今すぐ、または"}, {"type": "subtitle", "time": 6006.95, "timestamp": "01:40:06", "text": "明日、明後日に読みます。いつでも"}, {"type": "subtitle", "time": 6009.59, "timestamp": "01:40:09", "text": "メッセージを送ることができます。すべて順調です。"}, {"type": "subtitle", "time": 6011.109, "timestamp": "01:40:11", "text": "うん。"}, {"type": "subtitle", "time": 6016.31, "timestamp": "01:40:16", "text": "ええ、今日は来てくれてありがとう。"}, {"type": "subtitle", "time": 6019.75, "timestamp": "01:40:19", "text": "そして、今日、"}, {"type": "subtitle", "time": 6024.149, "timestamp": "01:40:24", "text": "つまり明日の8月12日、私の"}, {"type": "subtitle", "time": 6027.189, "timestamp": "01:40:27", "text": "誕生日に期待できることは、自分自身に誓ったこと、というか、"}, {"type": "subtitle", "time": 6035.189, "timestamp": "01:40:35", "text": "新年の抱負の一つでもあるのですが、"}, {"type": "subtitle", "time": 6037.99, "timestamp": "01:40:37", "text": "ゲームだけでなく、原点に立ち返りたいということです"}, {"type": "subtitle", "time": 6039.91, "timestamp": "01:40:39", "text": "。ゲームやゲーム関連のコラボレーション、"}, {"type": "subtitle", "time": 6042.31, "timestamp": "01:40:42", "text": "その他の"}, {"type": "subtitle", "time": 6047.03, "timestamp": "01:40:47", "text": "コンテンツももちろんありますが、"}, {"type": "subtitle", "time": 6050.149, "timestamp": "01:40:50", "text": "音楽もやっていきます。ですから、"}, {"type": "subtitle", "time": 6052.229, "timestamp": "01:40:52", "text": "Joathonの配信に新しい要素が加わり、私がきちんと"}, {"type": "subtitle", "time": 6055.27, "timestamp": "01:40:55", "text": "音楽に取り組んでいる様子をご覧いただけると思います"}, {"type": "subtitle", "time": 6058.229, "timestamp": "01:40:58", "text": "。前回のように、音楽をやめて"}]
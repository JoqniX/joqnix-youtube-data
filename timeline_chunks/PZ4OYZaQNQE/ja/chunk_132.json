[{"type": "subtitle", "time": 7921.43, "timestamp": "02:12:01", "text": "近所の人たちや"}, {"type": "subtitle", "time": 7924.149, "timestamp": "02:12:04", "text": "皆さんと分け合います。 わかりました、そうします。"}, {"type": "subtitle", "time": 7927.35, "timestamp": "02:12:07", "text": "おそらく彼らは既に、それを与えてくれたかもしれないプラムケーキを手に入れているのだろう"}, {"type": "subtitle", "time": 7930.95, "timestamp": "02:12:10", "text": "。"}, {"type": "chat", "time": 7934.711, "timestamp": "02:12:14", "author": "@RonbisLatous", "avatar": "https://yt4.ggpht.com/QhoPVPMtg_CuV7TwMh4wmsfkTMmSQp9m4w9HDvjzmjmjgLrfHkWkOfadwlnBu66OPcw0g4NH=s64-c-k-c0x00ffffff-no-rj", "message": "yum 😋"}, {"type": "subtitle", "time": 7937.669, "timestamp": "02:12:17", "text": "そして、"}, {"type": "subtitle", "time": 7941.83, "timestamp": "02:12:21", "text": "これから発売されるモデルも少しだけご紹介しました。 本当はそうすべきじゃないって分かってるんだ"}, {"type": "subtitle", "time": 7944.87, "timestamp": "02:12:24", "text": "けど、"}, {"type": "subtitle", "time": 7948.069, "timestamp": "02:12:28", "text": "今日は例外だった。 それで、"}, {"type": "subtitle", "time": 7951.91, "timestamp": "02:12:31", "text": "レイシュにも見せたんです。 あと"}, {"type": "subtitle", "time": 7953.91, "timestamp": "02:12:33", "text": "30分くらいここにいる予定なので、とりあえずお見せしますね"}, {"type": "subtitle", "time": 7956.55, "timestamp": "02:12:36", "text": "。 終わるはずだったんだけど、あと"}, {"type": "subtitle", "time": 7958.229, "timestamp": "02:12:38", "text": "30分ここにいるよ。でも、"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "もし僕に会いたいなら、これが"}, {"type": "subtitle", "time": 7965.83, "timestamp": "02:12:45", "text": "モデルで、"}, {"type": "subtitle", "time": 7968.229, "timestamp": "02:12:48", "text": "これがバカ。僕はこれのために一生懸命頑張ってるんだ。"}, {"type": "subtitle", "time": 7970.629, "timestamp": "02:12:50", "text": "このモデルのためだけにジョッカソンやってるんだ。"}, {"type": "subtitle", "time": 7974.709, "timestamp": "02:12:54", "text": "綺麗じゃない？えっと、ああ、なんてこった、これは"}]
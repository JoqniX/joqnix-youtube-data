[{"type": "subtitle", "time": 6661.59, "timestamp": "01:51:01", "text": "。"}, {"type": "subtitle", "time": 6663.27, "timestamp": "01:51:03", "text": "でも、モデルさん、そして私自身にとっても、1周年おめでとうございます"}, {"type": "subtitle", "time": 6667.91, "timestamp": "01:51:07", "text": "。"}, {"type": "subtitle", "time": 6673.35, "timestamp": "01:51:13", "text": "待って、最終的な完成レンダリングも数えるべきだよ"}, {"type": "subtitle", "time": 6675.99, "timestamp": "01:51:15", "text": "ね？ それは明日のことです。 だから、ある"}, {"type": "subtitle", "time": 6678.07, "timestamp": "01:51:18", "text": "意味では、私は一日早く到着したけれど、それでもちゃんと"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "カウントされる。 こんにちは。"}, {"type": "subtitle", "time": 6705.35, "timestamp": "01:51:45", "text": "。 戻ってきました。 戻ってきました。 戻ってきました。   戻ってきました"}, {"type": "subtitle", "time": 6715.99, "timestamp": "01:51:55", "text": "うっかり閉じてしまいました。 私のミスです。 私の"}, {"type": "subtitle", "time": 6719.27, "timestamp": "01:51:59", "text": "ミスです。 うっかり閉じてしまいました。"}]
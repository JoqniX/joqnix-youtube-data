[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "、読んで"}, {"type": "subtitle", "time": 4864.07, "timestamp": "01:21:04", "text": "返信します。"}, {"type": "subtitle", "time": 4868.95, "timestamp": "01:21:08", "text": "でも、ほとんどの人は"}, {"type": "subtitle", "time": 4872.229, "timestamp": "01:21:12", "text": "実際に出席していました。いいえ。ああ、よかった。挨拶もしました。"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "待って、中国語でどう挨拶するか忘れた。忘れた。"}, {"type": "subtitle", "time": 4887.99, "timestamp": "01:21:27", "text": "こんにちは。誕生日おめでとう。"}, {"type": "subtitle", "time": 4891.11, "timestamp": "01:21:31", "text": "ありがとう。メッセージを読みました"}, {"type": "subtitle", "time": 4894.47, "timestamp": "01:21:34", "text": "。メッセージを書いてくれてありがとう"}, {"type": "subtitle", "time": 4895.71, "timestamp": "01:21:35", "text": "。"}, {"type": "subtitle", "time": 4897.51, "timestamp": "01:21:37", "text": "[音楽]"}, {"type": "subtitle", "time": 4910.95, "timestamp": "01:21:50", "text": "忘れたけど、中国語の挨拶を忘れた"}]
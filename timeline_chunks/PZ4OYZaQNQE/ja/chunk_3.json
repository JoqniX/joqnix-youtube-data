[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "私が生放送で配信できているといいのですが。"}, {"type": "subtitle", "time": 182.949, "timestamp": "00:03:02", "text": "接続が正常かどうかは確認していませんが"}, {"type": "subtitle", "time": 185.75, "timestamp": "00:03:05", "text": "、おそらくライブ配信されているはずです。"}, {"type": "subtitle", "time": 190.149, "timestamp": "00:03:10", "text": "うん。 こんにちは、ライブ配信中です。 こんにちは。 今日は、"}, {"type": "subtitle", "time": 193.27, "timestamp": "00:03:13", "text": "えっと、私の誕生日です。 えっと、ちょっと待ってください。   私は"}, {"type": "subtitle", "time": 196.07, "timestamp": "00:03:16", "text": "これは必要ないと思います。 だから、"}, {"type": "subtitle", "time": 198.869, "timestamp": "00:03:18", "text": "削除できます。 ちょっと待ってくれよ"}, {"type": "subtitle", "time": 200.55, "timestamp": "00:03:20", "text": "。"}, {"type": "subtitle", "time": 203.11, "timestamp": "00:03:23", "text": "チャットが起動しません。 ごめんなさい。"}, {"type": "subtitle", "time": 205.99, "timestamp": "00:03:25", "text": "えっと、今日はチャットを稼働させることができません"}, {"type": "subtitle", "time": 209.35, "timestamp": "00:03:29", "text": "。 えっと、でも、すみません、すべてが"}, {"type": "subtitle", "time": 213.27, "timestamp": "00:03:33", "text": "直前になってしまいました。というのも、"}, {"type": "subtitle", "time": 217.03, "timestamp": "00:03:37", "text": "今日は"}, {"type": "subtitle", "time": 219.19, "timestamp": "00:03:39", "text": "現実世界で誕生日を迎えたので、すべてが直前になってしまったのです。   私も今日が"}, {"type": "subtitle", "time": 224.71, "timestamp": "00:03:44", "text": "誕生日なんです。 それで、えっと、"}, {"type": "subtitle", "time": 227.91, "timestamp": "00:03:47", "text": "家族と私はケーキカットとか"}, {"type": "subtitle", "time": 230.39, "timestamp": "00:03:50", "text": "色々やっていたんですが、それは6時"}, {"type": "subtitle", "time": 234.869, "timestamp": "00:03:54", "text": "50分か6時"}, {"type": "subtitle", "time": 237.50900000000001, "timestamp": "00:03:57", "text": "40分頃だったと思います。"}]
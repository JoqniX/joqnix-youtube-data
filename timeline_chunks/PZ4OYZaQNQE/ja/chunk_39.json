[{"type": "subtitle", "time": 2344.23, "timestamp": "00:39:04", "text": "。   わかった"}, {"type": "subtitle", "time": 2347.349, "timestamp": "00:39:07", "text": "。 贅沢。 これは本当に長い記事です。"}, {"type": "subtitle", "time": 2351.349, "timestamp": "00:39:11", "text": "これは長い話です。 わかった。 圧倒的に多い。"}, {"type": "subtitle", "time": 2354.55, "timestamp": "00:39:14", "text": "誕生日のお祝いメッセージをありがとうございます。"}, {"type": "subtitle", "time": 2357.91, "timestamp": "00:39:17", "text": "ジャッキー、誕生日おめでとう。"}, {"type": "subtitle", "time": 2361.349, "timestamp": "00:39:21", "text": "初めて"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "あなたの配信を見つけた時の私の反応は、パーティーの絵文字でした。 ちょっと待って、"}, {"type": "subtitle", "time": 2368.47, "timestamp": "00:39:28", "text": "これを下に移動させてください。 それが上向きの部分です。"}, {"type": "subtitle", "time": 2372.47, "timestamp": "00:39:32", "text": "まあ、私のことは気にしないでください。 隠すのを忘れていました。"}, {"type": "subtitle", "time": 2374.23, "timestamp": "00:39:34", "text": "必要であれば、説明欄に記載されています。 でも"}, {"type": "subtitle", "time": 2377.589, "timestamp": "00:39:37", "text": "、"}, {"type": "subtitle", "time": 2379.67, "timestamp": "00:39:39", "text": "数ヶ月前に偶然あなたの配信を見つけた時は、特に"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "壮大な計画があったわけではありませんでした。 単に興味があっただけです。"}, {"type": "subtitle", "time": 2385.99, "timestamp": "00:39:45", "text": "チューブ滑りのシーンに、インド人の顔や声が聞こえてくるだろうか、と私は思った。"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "距離を測って、ちょっと確認しただけだったんだけど、"}, {"type": "subtitle", "time": 2391.91, "timestamp": "00:39:51", "text": "そしたら君を見つけたんだ。 えっと、"}, {"type": "subtitle", "time": 2394.47, "timestamp": "00:39:54", "text": "それらの配信の合間に、ちょっと立ち寄って見てみました"}, {"type": "subtitle", "time": 2396.23, "timestamp": "00:39:56", "text": "。"}, {"type": "chat", "time": 2399.35, "timestamp": "00:39:59", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "HAPPY BIRTHDAY JOQ!!!!UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}]
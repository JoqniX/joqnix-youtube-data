[{"type": "subtitle", "time": 2581.91, "timestamp": "00:43:01", "text": "今、私の長々とした話を読んでくれてありがとう。   さあ、"}, {"type": "subtitle", "time": 2585.51, "timestamp": "00:43:05", "text": "もっと笑い、もっと"}, {"type": "subtitle", "time": 2588.79, "timestamp": "00:43:08", "text": "配信、もっと混沌、そしてもっとあなたたちを。"}, {"type": "subtitle", "time": 2590.79, "timestamp": "00:43:10", "text": "この誕生日が、あなたがどれほど大切な存在であるかを思い出させてくれることを願っています"}, {"type": "subtitle", "time": 2599.589, "timestamp": "00:43:19", "text": "。 私個人ではなく、"}, {"type": "chat", "time": 2602.087, "timestamp": "00:43:22", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "could u read mine rn ;w; im sorry for asking"}, {"type": "subtitle", "time": 2602.23, "timestamp": "00:43:22", "text": "あなたが人生を明るく照らしてくれたすべての人々に、"}, {"type": "subtitle", "time": 2604.79, "timestamp": "00:43:24", "text": "お誕生日おめでとうございます。そして、"}, {"type": "subtitle", "time": 2608.39, "timestamp": "00:43:28", "text": "私にインスピレーションを与えてくれてありがとう。 習を覚えているなら、尚。"}, {"type": "subtitle", "time": 2610.63, "timestamp": "00:43:30", "text": "はい、"}, {"type": "subtitle", "time": 2612.55, "timestamp": "00:43:32", "text": "シャンガさん、ありがとうございます。"}, {"type": "subtitle", "time": 2614.87, "timestamp": "00:43:34", "text": "こんにちは。 今すぐお願いできますか？ うん。"}, {"type": "subtitle", "time": 2617.43, "timestamp": "00:43:37", "text": "ええ、もちろんです。 はい、はい、はい。"}, {"type": "chat", "time": 2617.457, "timestamp": "00:43:37", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "i need to eat ;w; and i have to go somewhere"}, {"type": "subtitle", "time": 2620.79, "timestamp": "00:43:40", "text": "シャンガンさん、素敵なメッセージをありがとうございます。"}, {"type": "subtitle", "time": 2624.15, "timestamp": "00:43:44", "text": "ズキさんのメッセージも読ませていただきました。後ほど、"}, {"type": "subtitle", "time": 2627.349, "timesta
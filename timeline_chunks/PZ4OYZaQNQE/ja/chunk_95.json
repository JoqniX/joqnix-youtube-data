[{"type": "subtitle", "time": 5706.39, "timestamp": "01:35:06", "text": "。すべてが完成したら、TwitterなどでTシャツか何かとしてこれを見ることができるかもしれません"}, {"type": "subtitle", "time": 5713.669, "timestamp": "01:35:13", "text": "。今日は私の誕生日です。"}, {"type": "subtitle", "time": 5716.31, "timestamp": "01:35:16", "text": "これは、"}, {"type": "subtitle", "time": 5720.39, "timestamp": "01:35:20", "text": "独占のティーザーまたはプレビューのようなものだと思っただけです。それだけです"}, {"type": "subtitle", "time": 5722.229, "timestamp": "01:35:22", "text": "。"}, {"type": "subtitle", "time": 5724.31, "timestamp": "01:35:24", "text": "こんにちは。"}, {"type": "subtitle", "time": 5727.75, "timestamp": "01:35:27", "text": "とてもショーです。私は王冠を持っています。私は"}, {"type": "subtitle", "time": 5730.709, "timestamp": "01:35:30", "text": "物を持っています。私はたくさんの物を持っています。"}, {"type": "subtitle", "time": 5733.75, "timestamp": "01:35:33", "text": "ベルトかもしれません。 わからない。たくさんの隠し場所"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "とキラキラ光るキログラムの物。オーケー。えっと、何か"}, {"type": "subtitle", "time": 5741.11, "timestamp": "01:35:41", "text": "他のものを作る前に、失敗する前に、"}, {"type": "subtitle", "time": 5745.189, "timestamp": "01:35:45", "text": "切り替えます。こんにちは。これで全部です"}, {"type": "subtitle", "time": 5752.55, "timestamp": "01:35:52", "text": "私がそうしてよかったといいのですが。わからない"}, {"type": "subtitle", "time": 5754.55, "timestamp": "01:35:54", "text": "。"}, {"type": "subtitle", "time": 5757.189, "timestamp": "01:35:57", "text": "とてもきれいなモデルなので、"}]
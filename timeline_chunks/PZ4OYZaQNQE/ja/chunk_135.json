[{"type": "subtitle", "time": 8101.35, "timestamp": "02:15:01", "text": "16分待ってください。 わかった。 すべてモードです。"}, {"type": "subtitle", "time": 8104.39, "timestamp": "02:15:04", "text": "ああ、神様。 この男は速い。"}, {"type": "subtitle", "time": 8107.51, "timestamp": "02:15:07", "text": "うん。 さよなら。   わかった"}, {"type": "subtitle", "time": 8109.99, "timestamp": "02:15:09", "text": "。 少し時間をください。 もうすぐ"}, {"type": "subtitle", "time": 8112.229, "timestamp": "02:15:12", "text": "出かけなければなりません。 わかった。"}, {"type": "subtitle", "time": 8115.83, "timestamp": "02:15:15", "text": "鍵を受け取るためだけに。 だから、皆さんに感謝しています。"}, {"type": "subtitle", "time": 8119.109, "timestamp": "02:15:19", "text": "手持ちカメラでの配信に切り替えます。"}, {"type": "subtitle", "time": 8121.51, "timestamp": "02:15:21", "text": "待って、どうやって、一体どうやって"}, {"type": "subtitle", "time": 8124.31, "timestamp": "02:15:24", "text": "手持ちカメラで撮影するの？ ちょっと待って。 よく考えていなかった"}, {"type": "subtitle", "time": 8126.39, "timestamp": "02:15:26", "text": "。"}, {"type": "subtitle", "time": 8130.55, "timestamp": "02:15:30", "text": "ああ、神様。 待って。 えーっと、えーっと、えーっと、あ、待って。 あ、"}, {"type": "subtitle", "time": 8133.91, "timestamp": "02:15:33", "text": "待って。 私は"}, {"type": "subtitle", "time": 8138.55, "timestamp": "02:15:38", "text": "自分の顔を映せるウェブカメラを持っています。 いいえ、私は、"}, {"type": "subtitle", "time": 8147.83, "timestamp": "02:15:47", "text": "安全な方法で何ができるか考えなければなりません。わかりました"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "、待って。 えっと、"}]
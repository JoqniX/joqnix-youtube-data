[{"type": "subtitle", "time": 6180.95, "timestamp": "01:43:00", "text": "今日は皆さんお時間をいただき、改めてありがとうございました。 楽しんで、ゆっくり休んでくださいね。"}, {"type": "subtitle", "time": 6182.79, "timestamp": "01:43:02", "text": "他の人の配信を見ている場合は、"}, {"type": "subtitle", "time": 6185.99, "timestamp": "01:43:05", "text": "遠慮なくその人の配信に行って、"}, {"type": "subtitle", "time": 6188.709, "timestamp": "01:43:08", "text": "応援や励ましの言葉を送ってください。 よし、もし"}, {"type": "subtitle", "time": 6190.31, "timestamp": "01:43:10", "text": "他のものを見るつもりなら、楽しんでくれ"}, {"type": "subtitle", "time": 6191.83, "timestamp": "01:43:11", "text": "。"}, {"type": "subtitle", "time": 6195.109, "timestamp": "01:43:15", "text": "寝るなら、ぐっすり"}, {"type": "subtitle", "time": 6197.51, "timestamp": "01:43:17", "text": "眠ってください。 それでは、今夜は星々があなたを導き、"}, {"type": "subtitle", "time": 6204.31, "timestamp": "01:43:24", "text": "素敵な夢を見させてくれますように。 わかった。 こんにちは。 あなたが"}, {"type": "subtitle", "time": 6206.229, "timestamp": "01:43:26", "text": "今どこにいようと、どこにいようと、何時であろうと、"}, {"type": "subtitle", "time": 6209.03, "timestamp": "01:43:29", "text": "良い一"}, {"type": "subtitle", "time": 6211.99, "timestamp": "01:43:31", "text": "日をお過ごしください。 昼夜を問わず、昼夜を問わず、あるいは"}, {"type": "subtitle", "time": 6215.03, "timestamp": "01:43:35", "text": "夕方が近づいても。 良い一日を、そして素敵な"}, {"type": "subtitle", "time": 6216.95, "timestamp": "01:43:36", "text": "月曜日をお過ごしください。   いつものように"}, {"type": "subtitle", "time": 6219.27, "timestamp": "01:43:39", "text": "、また明日お会いしましょう。"}, {"type": "subtitle", "time": 6222.149, "timestamp": "01:43:42", "text": "明日、私たちが何をするのか疑問に思っているなら、"}, {"type": "subtitle", "time": 6230.79, "timestamp": "01:43:50", "text": "私たちは実際にプレイするかもしれません。ああ、なんてことだ"}, {"type": "subtitle", "time": 6232.95, "timestamp": "01:43:52", "text": "、原神はダウンロードされていません。 私は"}, {"type": "subtitle", "time": 6235.83, "timestamp": "01:43:55", "text": "自分の誕生日を受け取りたかった。"}]
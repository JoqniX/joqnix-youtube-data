[{"type": "subtitle", "time": 1261.029, "timestamp": "00:21:01", "text": "私のお気に入りの思い出の一つです。 それは完全にコスプレだったが、"}, {"type": "subtitle", "time": 1264.549, "timestamp": "00:21:04", "text": "最高の意味でのコスプレだった。   あの"}, {"type": "subtitle", "time": 1267.43, "timestamp": "00:21:07", "text": "瞬間を共有できて本当に嬉しかったし、これからも"}, {"type": "subtitle", "time": 1274.95, "timestamp": "00:21:14", "text": "一緒に楽しい時間を過ごせるのが待ち遠しい。 はい、私もです。 ということで、"}, {"type": "subtitle", "time": 1277.669, "timestamp": "00:21:17", "text": "Jakatanコラボレーションの一環として行ったコラボレーションです。 私たちは"}, {"type": "chat", "time": 1282.235, "timestamp": "00:21:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉♥♥♥♥🥳🎉🎉🎉🥀"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "Jarisaとのコラボレーションハングアウトでコラボレーションを楽しみました。"}, {"type": "subtitle", "time": 1286.549, "timestamp": "00:21:26", "text": "彼女とコラボレーションするのは今回が初めてだった。 ええと、"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "Minecraftとか、グループ設定でコラボレーションしたことはありますが、"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "そうですね。"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "えっと、デルパンと遊ぶのは初めてだったんだけど、"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "彼女のことをもっとよく知ることができてよかったし、"}, {"type": "subtitle", "time": 1306.07, "timestamp": "00:21:46", "text": "共通の趣味もたくさんあって、"}, {"type": "subtitle", "time": 1308.31, "timestamp": "00:21:48", "text": "楽しいことを話したりできた。 とても楽しかった。"}, {"type": "subtitle", "time": 1311.83, "timestamp": "00:21:51", "text": "楽しかったです。 これからも夜遅くまで"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "笑い合ったり、コラボレーションしたり、もっと"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "クレイジーな瞬間を作ったりできるといいですね。 今年はさらにクレイジーな思い出が増えました"}]
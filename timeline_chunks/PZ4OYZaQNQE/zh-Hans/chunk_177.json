[{"type": "subtitle", "time": 10629.83, "timestamp": "02:57:09", "text": "耶。"}, {"type": "subtitle", "time": 10642.95, "timestamp": "02:57:22", "text": "家人当时在送这种糖果。 呃，祝"}, {"type": "subtitle", "time": 10652.95, "timestamp": "02:57:32", "text": "我的天啊。 你好。 嗯，我就说到"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "这里吧。"}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "我打算找个时间跟我爸一起"}, {"type": "subtitle", "time": 10662.23, "timestamp": "02:57:42", "text": "吃顿饭。 嗯，妈妈"}, {"type": "subtitle", "time": 10665.429, "timestamp": "02:57:45", "text": "已经吃过了，她从"}, {"type": "subtitle", "time": 10667.75, "timestamp": "02:57:47", "text": "十点就一直陪着我，对吧？"}, {"type": "subtitle", "time": 10669.349, "timestamp": "02:57:49", "text": "你好。"}, {"type": "subtitle", "time": 10674.389, "timestamp": "02:57:54", "text": "感谢大家观看生日"}, {"type": "subtitle", "time": 10677.11, "timestamp": "02:57:57", "text": "直播。 希望你喜欢。 感谢您"}]
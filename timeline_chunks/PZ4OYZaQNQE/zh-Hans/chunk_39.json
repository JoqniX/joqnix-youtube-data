[{"type": "subtitle", "time": 2344.23, "timestamp": "00:39:04", "text": "好的。"}, {"type": "subtitle", "time": 2351.349, "timestamp": "00:39:11", "text": "这篇很长。 好的。 差了很多。"}, {"type": "subtitle", "time": 2354.55, "timestamp": "00:39:14", "text": "谢谢你的生日祝福。"}, {"type": "subtitle", "time": 2357.91, "timestamp": "00:39:17", "text": "杰基，生日快乐。"}, {"type": "subtitle", "time": 2361.349, "timestamp": "00:39:21", "text": "当我第一次偶然发现"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "你的直播时，我忍不住发了个派对表情。 等等，我先把它移到下面去"}, {"type": "subtitle", "time": 2368.47, "timestamp": "00:39:28", "text": "。 那是向上移动的那个东西。"}, {"type": "subtitle", "time": 2372.47, "timestamp": "00:39:32", "text": "现在，别理我。 我忘了把它藏起来。"}, {"type": "subtitle", "time": 2374.23, "timestamp": "00:39:34", "text": "如果你想看的话，说明里有。 不过"}, {"type": "subtitle", "time": 2377.589, "timestamp": "00:39:37", "text": "，几个月前我第一次偶然发现你的"}, {"type": "subtitle", "time": 2379.67, "timestamp": "00:39:39", "text": "直播时，并没有什么"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "宏伟的计划。 我只是好奇而已。 我"}, {"type": "subtitle", "time": 2383.67, "timestamp": "00:39:43", "text": "想知道"}, {"type": "subtitle", "time": 2385.99, "timestamp": "00:39:45", "text": "在漂流圈里有没有印度人的面孔或声音。 就像进行"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "远距离搜索一样，只是快速查看一下，"}, {"type": "subtitle", "time": 2391.91, "timestamp": "00:39:51", "text": "结果就找到了你。 嗯，在"}, {"type": "subtitle", "time": 2394.47, "timestamp": "00:39:54", "text": "那些直播的间隙，我顺便来"}, {"type": "subtitle", "time": 2396.23, "timestamp": "00:39:56", "text": "看看。"}, {"type": "chat", "time": 2399.35, "timestamp": "00:39:59", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "HAPPY BIRTHDAY JOQ!!!!UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}]
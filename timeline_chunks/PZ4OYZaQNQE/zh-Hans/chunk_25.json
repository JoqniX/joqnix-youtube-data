[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "为什么它变了？为什么它变了？"}, {"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "哦不，为什么它变了？"}, {"type": "subtitle", "time": 1507.35, "timestamp": "00:25:07", "text": "等等，它变了。 好的，这里，这里，"}, {"type": "subtitle", "time": 1510.23, "timestamp": "00:25:10", "text": "这里。 我的天，这格式。 好的，"}, {"type": "subtitle", "time": 1512.39, "timestamp": "00:25:12", "text": "橙色。"}, {"type": "subtitle", "time": 1514.95, "timestamp": "00:25:14", "text": "嘿，哥们儿。 我通常不太擅长写"}, {"type": "subtitle", "time": 1517.43, "timestamp": "00:25:17", "text": "生日祝福。 说实话，我通常都会尽量"}, {"type": "subtitle", "time": 1519.59, "timestamp": "00:25:19", "text": "避免这种情况，即使是对自己，但为了你，"}, {"type": "subtitle", "time": 1522.31, "timestamp": "00:25:22", "text": "我必须破例。"}, {"type": "subtitle", "time": 1523.75, "timestamp": "00:25:23", "text": "自从我加入这个"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "社区以来的这三年里，我一直"}, {"type": "subtitle", "time": 1528.07, "timestamp": "00:25:28", "text": "默默地在一旁看着"}, {"type": "subtitle", "time": 1531.269, "timestamp": "00:25:31", "text": "你们日复一日地努力工作"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "。 不是为了获得认可，而是"}, {"type": "subtitle", "time": 1536.789, "timestamp": "00:25:36", "text": "为了让身边的人变得更好"}, {"type": "subtitle", "time": 1540.149, "timestamp": "00:25:40", "text": "。 你把时间、精力和"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "心血倾注到你所做的事情中，这一点显而易见。"}, {"type": "subtitle", "time": 1546.47, "timestamp": "00:25:46", "text": "你的才华毋庸置疑，你的"}, {"type": "subtitle", "time": 1549.35, "timestamp": "00:25:49", "text": "潜力无限。 我的天啊。"}, {"type": "subtitle", "time": 1551.59, "timestamp": "00:25:51", "text": "谢谢。"}, {"type": "subtitle", "time": 1555.269, "timestamp": "00:25:55", "text": "你注定要成就一番伟业。 我对此深信不疑"}, {"type": "subtitle", "time": 1557.43, "timestamp": "00:25:57", "text": "。"}]
[{"type": "subtitle", "time": 1680.389, "timestamp": "00:28:00", "text": "能力、技能以及"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "我所做的一切。 呃，但我认为我"}, {"type": "subtitle", "time": 1686.789, "timestamp": "00:28:06", "text": "真的需要这个。 由衷感谢"}, {"type": "subtitle", "time": 1697.35, "timestamp": "00:28:17", "text": "那么，接下来，谢谢你的"}, {"type": "subtitle", "time": 1699.669, "timestamp": "00:28:19", "text": "生日祝福。 接下来，我们将介绍"}, {"type": "subtitle", "time": 1703.59, "timestamp": "00:28:23", "text": "罗阿。 生日快乐，兄弟。 祝你"}, {"type": "subtitle", "time": 1706.389, "timestamp": "00:28:26", "text": "未来一年再创佳绩。 谢谢"}, {"type": "subtitle", "time": 1710.549, "timestamp": "00:28:30", "text": "你送的可爱生日礼物。"}, {"type": "chat", "time": 1711.609, "timestamp": "00:28:31", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "you're not crying are you"}, {"type": "subtitle", "time": 1714.149, "timestamp": "00:28:34", "text": "谢谢你，罗。"}, {"type": "subtitle", "time": 1722.389, "timestamp": "00:28:42", "text": "我没哭。 你到家了。"}, {"type": "subtitle", "time": 1726.389, "timestamp": "00:28:46", "text": "哦，笨蛋。 然后是阿尼凯塔。"}, {"type": "subtitle", "time": 1729.51, "timestamp": "00:28:49", "text": "生日快乐，兄弟。 踢腿表情符号。"}, {"type": "subtitle", "time": 1730.95, "timestamp": "00:28:50", "text": "你是"}, {"type": "subtitle", "time": 1733.11, "timestamp": "00:28:53", "text": "我见过最勤奋的主播之一。 保持健康，"}, {"type": "subtitle", "time": 1735.83, "timestamp": "00:28:55", "text": "保持酷炫。 肌肉表情符号。"}, {"type": "subtitle", "time": 1738.63, "timestamp": "00:28:58", "text": "谢谢。 谢谢你送来的孩子们。 送我们"}]
[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "现在还有迟到的生日祝福，我会读一读，嗯，"}, {"type": "subtitle", "time": 4864.07, "timestamp": "01:21:04", "text": "也许会回复。"}, {"type": "subtitle", "time": 4868.95, "timestamp": "01:21:08", "text": "但是，嗯，大多数人"}, {"type": "subtitle", "time": 4872.229, "timestamp": "01:21:12", "text": "实际上都来了。不。啊，太好了。我甚至"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "等等，我忘了中文怎么问候了。"}, {"type": "subtitle", "time": 4887.99, "timestamp": "01:21:27", "text": "我忘了。你好。生日快乐。"}, {"type": "subtitle", "time": 4891.11, "timestamp": "01:21:31", "text": "谢谢。我读了你的留言。我读了你的"}, {"type": "subtitle", "time": 4894.47, "timestamp": "01:21:34", "text": "留言。谢谢你留言"}, {"type": "subtitle", "time": 4895.71, "timestamp": "01:21:35", "text": "。"}, {"type": "subtitle", "time": 4897.51, "timestamp": "01:21:37", "text": "[音乐]"}, {"type": "subtitle", "time": 4910.95, "timestamp": "01:21:50", "text": "我忘了，我忘了中文"}]
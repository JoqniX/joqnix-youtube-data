[{"type": "subtitle", "time": 1985.35, "timestamp": "00:33:05", "text": "哈托吉。我希望你今天过得"}, {"type": "subtitle", "time": 1987.75, "timestamp": "00:33:07", "text": "愉快，也希望你未来一年一切顺利。"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "有趣的是，查德很懒，等了很久才打开广告。"}, {"type": "subtitle", "time": 2001.029, "timestamp": "00:33:21", "text": "他就是查德。 他懒得开门。 等等，"}, {"type": "subtitle", "time": 2013.669, "timestamp": "00:33:33", "text": "他懒得在开机后手动打开应用程序，"}, {"type": "subtitle", "time": 2016.31, "timestamp": "00:33:36", "text": "而是用一些能帮"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "他打开应用程序的软件。 去看看他的"}, {"type": "subtitle", "time": 2022.389, "timestamp": "00:33:42", "text": "视频片段。"}, {"type": "subtitle", "time": 2025.59, "timestamp": "00:33:45", "text": "哦，你知道，我今天不得不做这件事。   嗯，"}, {"type": "subtitle", "time": 2028.71, "timestamp": "00:33:48", "text": "我发现我的电脑因为"}, {"type": "subtitle", "time": 2030.95, "timestamp": "00:33:50", "text": "停电而没开机，我只好"}, {"type": "subtitle", "time": 2033.269, "timestamp": "00:33:53", "text": "上楼，打开电脑，然后就用"}, {"type": "subtitle", "time": 2035.75, "timestamp": "00:33:55", "text": "手机点了一下按钮。 我"}, {"type": "subtitle", "time": 2037.99, "timestamp": "00:33:57", "text": "连接到我的家庭网络，然后"}, {"type": "subtitle", "time": 2039.669, "timestamp": "00:33:59", "text": "点击了一个按钮。 它打开了"}]
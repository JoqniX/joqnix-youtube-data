[{"type": "subtitle", "time": 6542.149, "timestamp": "01:49:02", "text": "它将成为真正的普遍中立"}, {"type": "subtitle", "time": 6552.55, "timestamp": "01:49:12", "text": "我也有一个王冠。 你有没有看到？ 我有"}, {"type": "subtitle", "time": 6555.59, "timestamp": "01:49:15", "text": "一顶王冠。 我不该过度戏弄别人。"}, {"type": "subtitle", "time": 6558.79, "timestamp": "01:49:18", "text": "我已经看得太多了，兄弟。 这是"}, {"type": "subtitle", "time": 6561.03, "timestamp": "01:49:21", "text": "为了……我会把它留到出道、"}, {"type": "subtitle", "time": 6563.669, "timestamp": "01:49:23", "text": "出道前的宣传"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "推文以及未来很长一段时间里使用。"}, {"type": "subtitle", "time": 6569.669, "timestamp": "01:49:29", "text": "如果有一天我能买得起这款车型的话。   嗯，"}, {"type": "subtitle", "time": 6574.79, "timestamp": "01:49:34", "text": "因为现在很贵。"}, {"type": "subtitle", "time": 6577.75, "timestamp": "01:49:37", "text": "所以"}, {"type": "subtitle", "time": 6580.39, "timestamp": "01:49:40", "text": "，今天就到此为止吧，好好"}, {"type": "subtitle", "time": 6584.95, "timestamp": "01:49:44", "text": "享受今天。 我们可能一段时间内都看不到它了"}, {"type": "subtitle", "time": 6587.189, "timestamp": "01:49:47", "text": "，但"}, {"type": "subtitle", "time": 6589.43, "timestamp": "01:49:49", "text": "在遥远的未来，那将是"}, {"type": "subtitle", "time": 6591.84, "timestamp": "01:49:51", "text": "你们每天都能看到的模型。"}, {"type": "subtitle", "time": 6593.27, "timestamp": "01:49:53", "text": "[音乐]"}, {"type": "subtitle", "time": 6595.43, "timestamp": "01:49:55", "text": "再见。"}, {"type": "subtitle", "time": 6597.189, "timestamp": "01:49:57", "text": "我"}, {"type": "subtitle", "time": 6599.75, "timestamp": "01:49:59", "text": "很享受这个过程，"}]
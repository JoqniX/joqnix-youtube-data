[{"type": "subtitle", "time": 1443.669, "timestamp": "00:24:03", "text": "请求他们允许"}, {"type": "subtitle", "time": 1447.27, "timestamp": "00:24:07", "text": "来自中国的用户访问，比如取消地理限制。"}, {"type": "subtitle", "time": 1450.47, "timestamp": "00:24:10", "text": "我还是直接问他们吧，不然我就"}, {"type": "subtitle", "time": 1452.47, "timestamp": "00:24:12", "text": "换个网站了。 我也希望"}, {"type": "subtitle", "time": 1455.75, "timestamp": "00:24:15", "text": "比利·米纳能祝福我什么的"}, {"type": "subtitle", "time": 1458.87, "timestamp": "00:24:18", "text": "。"}, {"type": "subtitle", "time": 1460.71, "timestamp": "00:24:20", "text": "过去两年，我一直梦想着能在"}, {"type": "subtitle", "time": 1467.83, "timestamp": "00:24:27", "text": "Billy Billy上直播我的生日，但"}, {"type": "subtitle", "time": 1471.669, "timestamp": "00:24:31", "text": "可惜的是，我现在不能在那里直播了。"}, {"type": "subtitle", "time": 1474.39, "timestamp": "00:24:34", "text": "嗯，但希望将来也能，"}, {"type": "subtitle", "time": 1476.95, "timestamp": "00:24:36", "text": "在遥远的未来，我希望我能以"}, {"type": "subtitle", "time": 1482.63, "timestamp": "00:24:42", "text": "某种方式直播……嗯，"}, {"type": "subtitle", "time": 1483.99, "timestamp": "00:24:43", "text": "谢谢苏珊的生日"}, {"type": "subtitle", "time": 1486.87, "timestamp": "00:24:46", "text": "祝福，谢谢。"}, {"type": "subtitle", "time": 1490.47, "timestamp": "00:24:50", "text": "然后我们……嗯，这个，我们"}, {"type": "subtitle", "time": 1492.39, "timestamp": "00:24:52", "text": "读一下这个，好的。然后我们继续"}, {"type": "subtitle", "time": 1494.07, "timestamp": "00:24:54", "text": "另一个，"}, {"type": "subtitle", "time": 1495.99, "timestamp": "00:24:55", "text": "橙色，"}, {"type": "subtitle", "time": 1499.51, "timestamp": "00:24:59", "text": "发生了什么？我刚才做了什么？"}]
[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "没有吗？ 我没有。 好的。 好的。 我想我"}, {"type": "subtitle", "time": 3003.67, "timestamp": "00:50:03", "text": "做到了。 我不知道。 我记得我"}, {"type": "subtitle", "time": 3005.589, "timestamp": "00:50:05", "text": "读过一些东西。"}, {"type": "subtitle", "time": 3008.15, "timestamp": "00:50:08", "text": "玛雅，谢谢你，"}, {"type": "subtitle", "time": 3011.43, "timestamp": "00:50:11", "text": "也谢谢扎基的精彩留言，"}, {"type": "subtitle", "time": 3013.829, "timestamp": "00:50:13", "text": "你得去某个地方了。 所以请"}, {"type": "subtitle", "time": 3018.71, "timestamp": "00:50:18", "text": "多保重，祝您旅途平安。"}, {"type": "subtitle", "time": 3021.43, "timestamp": "00:50:21", "text": "安全到家。"}, {"type": "subtitle", "time": 3023.91, "timestamp": "00:50:23", "text": "你好，Adi。 谢谢大家的生日"}, {"type": "subtitle", "time": 3027.67, "timestamp": "00:50:27", "text": "祝福。 谢谢。"}, {"type": "subtitle", "time": 3034.23, "timestamp": "00:50:34", "text": "谢谢你写了这么"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "美好的留言。"}, {"type": "subtitle", "time": 3040.47, "timestamp": "00:50:40", "text": "嗯，这对我来说意义重大。 嗯"}, {"type": "subtitle", "time": 3043.349, "timestamp": "00:50:43", "text": "，"}, {"type": "subtitle", "time": 3045.349, "timestamp": "00:50:45", "text": "你自己也知道，我经常自我怀疑，"}, {"type": "subtitle", "time": 3049.43, "timestamp": "00:50:49", "text": "也经常想太多。 但是，嗯，这些"}, {"type": "subtitle", "time": 3052.069, "timestamp": "00:50:52", "text": "年来，我注意到有些人"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "告诉我，我激励了"}, {"type": "subtitle", "time": 3059.19, "timestamp": "00:50:59", "text": "他们等等，但"}]
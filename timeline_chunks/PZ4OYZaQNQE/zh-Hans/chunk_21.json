[{"type": "subtitle", "time": 1261.029, "timestamp": "00:21:01", "text": "我最喜欢的时刻之一。 这纯粹是cosplay，"}, {"type": "subtitle", "time": 1264.549, "timestamp": "00:21:04", "text": "但却是以一种最好的方式呈现。"}, {"type": "subtitle", "time": 1267.43, "timestamp": "00:21:07", "text": "我很高兴我们能一起分享那一刻，"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "我迫不及待地想和你一起体验更多有趣的事情"}, {"type": "subtitle", "time": 1274.95, "timestamp": "00:21:14", "text": "。 是的，我也是。 所以，这是我们"}, {"type": "subtitle", "time": 1277.669, "timestamp": "00:21:17", "text": "作为 Jakatan 合作项目的一部分进行的合作。 我们"}, {"type": "chat", "time": 1282.235, "timestamp": "00:21:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉♥♥♥♥🥳🎉🎉🎉🥀"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "和 Jarisa 进行了一次类似合作的聚会。 这"}, {"type": "subtitle", "time": 1286.549, "timestamp": "00:21:26", "text": "是我第一次和她合作。 嗯，"}, {"type": "subtitle", "time": 1288.31, "timestamp": "00:21:28", "text": "虽然我们之前在一些团队合作的场合，比如玩"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "Minecraft 之类的"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "，但是，嗯。"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "嗯，这是我第一次和"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "德尔潘一起出去玩，很高兴能"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "更了解她，而且我们有"}, {"type": "subtitle", "time": 1306.07, "timestamp": "00:21:46", "text": "很多共同的爱好等等，"}, {"type": "subtitle", "time": 1308.31, "timestamp": "00:21:48", "text": "聊些有趣的事情。 太好玩了。 我很"}, {"type": "subtitle", "time": 1311.83, "timestamp": "00:21:51", "text": "喜欢。 希望以后能有更多深夜"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "欢笑、更多合作，以及更多"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "疯狂的时刻。 今年真是发生了不少疯狂的事"}]
[{"type": "subtitle", "time": 4980.47, "timestamp": "01:23:00", "text": "没有牛奶活不下去。对不起。"}, {"type": "subtitle", "time": 4983.669, "timestamp": "01:23:03", "text": "我刚才才看到你的留言。"}, {"type": "subtitle", "time": 4985.75, "timestamp": "01:23:05", "text": "谢谢你的生日祝福。呃，"}, {"type": "subtitle", "time": 4988.79, "timestamp": "01:23:08", "text": "兄弟，生日快乐。派对表情 蛋糕"}, {"type": "subtitle", "time": 4991.99, "timestamp": "01:23:11", "text": "表情。祝你赚很多钱，"}, {"type": "subtitle", "time": 4994.709, "timestamp": "01:23:14", "text": "去世界各地旅行，无论"}, {"type": "subtitle", "time": 4997.75, "timestamp": "01:23:17", "text": "是学习、工作还是休闲放松，都"}, {"type": "subtitle", "time": 5000.47, "timestamp": "01:23:20", "text": "无忧无虑。祝你"}, {"type": "subtitle", "time": 5006.47, "timestamp": "01:23:26", "text": "随着时间的推移变得越来越强壮、越来越睿智、越来越健康、越来越富有。"}, {"type": "subtitle", "time": 5010.47, "timestamp": "01:23:30", "text": "紫色爱心表情。谢谢。没有"}, {"type": "subtitle", "time": 5013.99, "timestamp": "01:23:33", "text": "牛奶活不下去。谢谢。谢谢。谢谢"}, {"type": "subtitle", "time": 5017.51, "timestamp": "01:23:37", "text": "。谢谢你的"}, {"type": "subtitle", "time": 5019.669, "timestamp": "01:23:39", "text": "生日祝福。"}, {"type": "subtitle", "time": 5022.95, "timestamp": "01:23:42", "text": "如果 我在赚钱，我只是想，我"}, {"type": "subtitle", "time": 5027.27, "timestamp": "01:23:47", "text": "只是想让我的模特项目启动，这样我就可以正式"}, {"type": "subtitle", "time": 5032.55, "timestamp": "01:23:52", "text": "发布了。那个帅气的运动型模特。"}, {"type": "subtitle", "time": 5034.07, "timestamp": "01:23:54", "text": "我，"}, {"type": "subtitle", "time": 5037.27, "timestamp": "01:23:57", "text": "我其实忘了。"}, {"type": "subtitle", "time": 5039.669, "timestamp": "01:23:59", "text": "呃，让我再确认一下，"}]
[{"type": "subtitle", "time": 6482.709, "timestamp": "01:48:02", "text": "我非常感谢很多人。 我真"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "希望我能直接说出他们的名字，但"}, {"type": "subtitle", "time": 6488.709, "timestamp": "01:48:08", "text": "我做不到。 嗯，因为我得把它留到"}, {"type": "subtitle", "time": 6491.75, "timestamp": "01:48:11", "text": "首播的时候用。 嗯？"}, {"type": "subtitle", "time": 6494.47, "timestamp": "01:48:14", "text": "所有人都帮助了我。   是的"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "。"}, {"type": "subtitle", "time": 6497.669, "timestamp": "01:48:17", "text": "嗯，简直像"}, {"type": "subtitle", "time": 6500.47, "timestamp": "01:48:20", "text": "做梦一样。 不，那就像一场"}, {"type": "subtitle", "time": 6503.669, "timestamp": "01:48:23", "text": "逝去的梦。 就像我从未想过"}, {"type": "subtitle", "time": 6508.229, "timestamp": "01:48:28", "text": "会拥有的梦想一样，我很高兴"}, {"type": "subtitle", "time": 6512.149, "timestamp": "01:48:32", "text": "我选择的这位艺术家让我"}, {"type": "subtitle", "time": 6515.99, "timestamp": "01:48:35", "text": "比以往任何时候都更漂亮。 我非常喜欢她的画风，一直是"}, {"type": "subtitle", "time": 6523.99, "timestamp": "01:48:43", "text": "我真心希望幕后的一切都能顺利解决，是的，"}, {"type": "subtitle", "time": 6529.43, "timestamp": "01:48:49", "text": "这将会是未来的官方模型，但"}, {"type": "subtitle", "time": 6532.55, "timestamp": "01:48:52", "text": "目前我们"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "只能看到这些。"}, {"type": "subtitle", "time": 6537.75, "timestamp": "01:48:57", "text": "是的，这是一款真正的性别中立模型。 是的。"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "所以，所以，所以"}]
[{"type": "subtitle", "time": 3721.349, "timestamp": "01:02:01", "text": "而且，既然我们正在"}, {"type": "subtitle", "time": 3723.829, "timestamp": "01:02:03", "text": "阅读来自比利·贝利纳的消息，那么"}, {"type": "subtitle", "time": 3729.43, "timestamp": "01:02:09", "text": "比利·贝利纳的很多人，我们有一个QQ群，"}, {"type": "subtitle", "time": 3731.589, "timestamp": "01:02:11", "text": "中国人用QQ，我"}, {"type": "subtitle", "time": 3733.51, "timestamp": "01:02:13", "text": "没有vchhat，因为它在"}, {"type": "subtitle", "time": 3736.95, "timestamp": "01:02:16", "text": "印度用不了，大多数中国应用都被禁了，但"}, {"type": "subtitle", "time": 3739.43, "timestamp": "01:02:19", "text": "我已经有了QQ账号，所以我能用它，"}, {"type": "subtitle", "time": 3744.23, "timestamp": "01:02:24", "text": "人们在QQ上祝我"}, {"type": "subtitle", "time": 3745.91, "timestamp": "01:02:25", "text": "生日快乐，"}, {"type": "subtitle", "time": 3751.589, "timestamp": "01:02:31", "text": "谢谢。 总有一天，"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "如果可以的话，我会重新相信的。 我会"}, {"type": "subtitle", "time": 3756.95, "timestamp": "01:02:36", "text": "尽力而为。 两年来，这一直是我的梦想。"}, {"type": "subtitle", "time": 3759.109, "timestamp": "01:02:39", "text": "虽然我曾经直播过"}, {"type": "subtitle", "time": 3761.75, "timestamp": "01:02:41", "text": "一年，但直播次数不多，"}, {"type": "subtitle", "time": 3765.03, "timestamp": "01:02:45", "text": "不过我还是会继续努力，"}, {"type": "subtitle", "time": 3769.03, "timestamp": "01:02:49", "text": "确保我能在那里直播。 你好。 接下来，"}, {"type": "subtitle", "time": 3771.109, "timestamp": "01:02:51", "text": "谢谢你的生日祝福。"}, {"type": "subtitle", "time": 3774.789, "timestamp": "01:02:54", "text": "去他妈的雷文。 接下来是艾吉·布鲁·外星人。"}, {"type": "subtitle", "time": 3777.349, "timestamp": "01:02:57", "text": "祝你生日快乐。 我是"}, {"type": "subtitle", "time": 3779.75, "timestamp": "01:02:59", "text": "新订阅用户，很高兴"}]
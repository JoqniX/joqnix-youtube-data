[{"type": "subtitle", "time": 9064.63, "timestamp": "02:31:04", "text": "我"}, {"type": "subtitle", "time": 9067.91, "timestamp": "02:31:07", "text": "什么时候不笨手笨脚的"}, {"type": "subtitle", "time": 9071.83, "timestamp": "02:31:11", "text": "？ 看着我。 看着我。 不，我"}, {"type": "subtitle", "time": 9075.19, "timestamp": "02:31:15", "text": "没有。 别看我把“不”扔掉，看"}, {"type": "subtitle", "time": 9078.71, "timestamp": "02:31:18", "text": "我弄脏手套，"}, {"type": "subtitle", "time": 9081.67, "timestamp": "02:31:21", "text": "因为我要戴着"}, {"type": "subtitle", "time": 9083.27, "timestamp": "02:31:23", "text": "手套吃蛋糕。"}, {"type": "subtitle", "time": 9090.55, "timestamp": "02:31:30", "text": "我不知道。 别想那个混蛋。"}, {"type": "subtitle", "time": 9092.95, "timestamp": "02:31:32", "text": "好的，等等。 我要打开"}, {"type": "subtitle", "time": 9095.27, "timestamp": "02:31:35", "text": "摄像头了。"}]
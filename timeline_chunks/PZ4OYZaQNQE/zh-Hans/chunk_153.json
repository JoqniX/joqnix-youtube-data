[{"type": "subtitle", "time": 9181.27, "timestamp": "02:33:01", "text": "我从来不那样做。 不用担心。 不用"}, {"type": "subtitle", "time": 9184.79, "timestamp": "02:33:04", "text": "担心。 别提那件事了。"}, {"type": "subtitle", "time": 9187.75, "timestamp": "02:33:07", "text": "好的。 我是一名油管博主。 我永远不会那样"}, {"type": "subtitle", "time": 9191.75, "timestamp": "02:33:11", "text": "做。 甚至有人"}, {"type": "subtitle", "time": 9195.91, "timestamp": "02:33:15", "text": "在放枪。 我绝不会那样做。"}, {"type": "subtitle", "time": 9197.31, "timestamp": "02:33:17", "text": "我是蜘蛛侠。"}, {"type": "subtitle", "time": 9198.469, "timestamp": "02:33:18", "text": "[音乐]"}, {"type": "subtitle", "time": 9212.63, "timestamp": "02:33:32", "text": "这就是蛋糕。"}, {"type": "subtitle", "time": 9215.57, "timestamp": "02:33:35", "text": "这是我犯下的错误。"}, {"type": "subtitle", "time": 9216.71, "timestamp": "02:33:36", "text": "[音乐]"}, {"type": "subtitle", "time": 9218.55, "timestamp": "02:33:38", "text": "等等，我可能会把手机掉地上。 等等，"}, {"type": "subtitle", "time": 9221.429, "timestamp": "02:33:41", "text": "抱歉。 它很滑。 我戴着"}, {"type": "subtitle", "time": 9224.15, "timestamp": "02:33:44", "text": "手套。"}, {"type": "subtitle", "time": 9229.59, "timestamp": "02:33:49", "text": "瞧，这是巧克力丝绒蛋糕。"}, {"type": "subtitle", "time": 9238.23, "timestamp": "02:33:58", "text": "哦，找到了。"}]
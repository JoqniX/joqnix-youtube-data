[{"type": "subtitle", "time": 10566.63, "timestamp": "02:56:06", "text": "再次。 我得把它舔干净才行。   上面"}, {"type": "subtitle", "time": 10568.389, "timestamp": "02:56:08", "text": "好像有一小块蛋糕。 我不想"}, {"type": "subtitle", "time": 10587.75, "timestamp": "02:56:27", "text": "你好。"}, {"type": "subtitle", "time": 10591.19, "timestamp": "02:56:31", "text": "嘿。 谢谢。"}, {"type": "subtitle", "time": 10606.15, "timestamp": "02:56:46", "text": "我把它放进了它原本的蛋糕盒里"}]
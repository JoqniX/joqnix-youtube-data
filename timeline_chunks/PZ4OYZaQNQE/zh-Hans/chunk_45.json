[{"type": "subtitle", "time": 2700.95, "timestamp": "00:45:00", "text": "。 不，尤其是浦那"}, {"type": "subtitle", "time": 2705.19, "timestamp": "00:45:05", "text": "动漫展。 那是一段我永远都不会"}, {"type": "chat", "time": 2707.452, "timestamp": "00:45:07", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is super adorable irl lol"}, {"type": "subtitle", "time": 2707.75, "timestamp": "00:45:07", "text": "忘记的记忆。"}, {"type": "subtitle", "time": 2711.03, "timestamp": "00:45:11", "text": "谢谢你照顾我。 嗯，"}, {"type": "subtitle", "time": 2713.51, "timestamp": "00:45:13", "text": "谢谢你照顾我。 我以及几乎所有人都是如此"}, {"type": "subtitle", "time": 2717.349, "timestamp": "00:45:17", "text": "。 我"}, {"type": "subtitle", "time": 2719.349, "timestamp": "00:45:19", "text": "总是很依赖"}, {"type": "subtitle", "time": 2722.15, "timestamp": "00:45:22", "text": "你，因为"}, {"type": "subtitle", "time": 2726.309, "timestamp": "00:45:26", "text": "在我的人生旅途中，只有你真正……嗯，怎么"}, {"type": "subtitle", "time": 2728.55, "timestamp": "00:45:28", "text": "说呢？ 嗯，它"}, {"type": "subtitle", "time": 2730.95, "timestamp": "00:45:30", "text": "让我克服了与人交谈的恐惧"}, {"type": "subtitle", "time": 2735.349, "timestamp": "00:45:35", "text": "。 你知道，"}, {"type": "subtitle", "time": 2738.15, "timestamp": "00:45:38", "text": "我也跟"}, {"type": "subtitle", "time": 2741.109, "timestamp": "00:45:41", "text": "每个人都讲过很多次这个故事了。 我通常会花 10 到"}, {"type": "subtitle", "time": 2744.069, "timestamp": "00:45:44", "text": "30 到 40 分钟的时间来准备，包括"}, {"type": "subtitle", "time": 2746.47, "timestamp": "00:45:46", "text": "心理和生理上的准备，以便能够"}, {"type": "subtitle", "time": 2750.069, "timestamp": "00:45:50", "text": "在视频会议中发言。 但是，我在视频通话中说得越多，我就越努力地"}, {"type": "chat", "time": 2753.563, "timestamp": "00:45:53", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff
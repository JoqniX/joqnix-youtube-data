[{"type": "subtitle", "time": 8820.23, "timestamp": "02:27:00", "text": "兄弟，兄弟，下一个是运动员。 下一个笑话是Jock。"}, {"type": "subtitle", "time": 8822.23, "timestamp": "02:27:02", "text": "谢谢。 不。"}, {"type": "subtitle", "time": 8825.75, "timestamp": "02:27:05", "text": "我差点把它摔了。"}, {"type": "subtitle", "time": 8863.87, "timestamp": "02:27:43", "text": "为什么？"}, {"type": "subtitle", "time": 8869.83, "timestamp": "02:27:49", "text": "[音乐]"}, {"type": "subtitle", "time": 8875.59, "timestamp": "02:27:55", "text": "蛋糕。 盒子。 盒子。 盒子。"}]
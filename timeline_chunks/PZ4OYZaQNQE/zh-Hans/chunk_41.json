[{"type": "subtitle", "time": 2471.99, "timestamp": "00:41:11", "text": "好了，我回来了。 呃，我爸爸可以吗？"}, {"type": "subtitle", "time": 2474.15, "timestamp": "00:41:14", "text": "我告诉爸爸把冰淇淋放进"}, {"type": "subtitle", "time": 2477.51, "timestamp": "00:41:17", "text": "冰箱里了。 你好。 嗯，我把努力、"}, {"type": "subtitle", "time": 2479.51, "timestamp": "00:41:19", "text": "精力、热情，还有你"}, {"type": "subtitle", "time": 2481.27, "timestamp": "00:41:21", "text": "投入到工作中的心血都传递出去。 你营造的"}, {"type": "subtitle", "time": 2483.03, "timestamp": "00:41:23", "text": "空间让人感觉很温馨，让人没有丝毫犹豫，不"}, {"type": "subtitle", "time": 2486.15, "timestamp": "00:41:26", "text": "知道自己是会在"}, {"type": "subtitle", "time": 2487.91, "timestamp": "00:41:27", "text": "这里待5分钟还是会长期"}, {"type": "subtitle", "time": 2490.069, "timestamp": "00:41:30", "text": "停留。 你不只是直播，你"}, {"type": "subtitle", "time": 2492.79, "timestamp": "00:41:32", "text": "创造瞬间，让人们感觉"}, {"type": "subtitle", "time": 2495.829, "timestamp": "00:41:35", "text": "自己融入其中。"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "你"}, {"type": "subtitle", "time": 2501.349, "timestamp": "00:41:41", "text": "肯定不是那种被大肆宣传的圈子里的人。 然而，"}, {"type": "subtitle", "time": 2504.39, "timestamp": "00:41:44", "text": "你带来的平静却令人感到"}, {"type": "subtitle", "time": 2507.91, "timestamp": "00:41:47", "text": "安慰和鼓舞。 我喜欢你，"}, {"type": "subtitle", "time": 2510.47, "timestamp": "00:41:50", "text": "我喜欢你"}, {"type": "subtitle", "time": 2513.349, "timestamp": "00:41:53", "text": "对所有事情的看法总是那么独特。 我"}, {"type": "subtitle", "time": 2516.23, "timestamp": "00:41:56", "text": "从你身上学到了很多。 我喜欢你"}, {"type": "subtitle", "time": 2518.55, "timestamp": "00:41:58", "text": "经常陷入过度思考的漩涡，然后又像个"}]
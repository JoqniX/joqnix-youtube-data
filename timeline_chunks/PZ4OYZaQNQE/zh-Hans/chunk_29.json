[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "鲜花。"}, {"type": "subtitle", "time": 1745.029, "timestamp": "00:29:05", "text": "太感谢了。 阿南一直都在"}, {"type": "subtitle", "time": 1748.23, "timestamp": "00:29:08", "text": "看我的直播"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "。"}, {"type": "subtitle", "time": 1752.31, "timestamp": "00:29:12", "text": "我真的很感谢你经常来"}, {"type": "subtitle", "time": 1756.389, "timestamp": "00:29:16", "text": "我的"}, {"type": "subtitle", "time": 1758.149, "timestamp": "00:29:18", "text": "直播间看看。 太感谢了。"}, {"type": "subtitle", "time": 1761.19, "timestamp": "00:29:21", "text": "不，是为了在我"}, {"type": "subtitle", "time": 1764.07, "timestamp": "00:29:24", "text": "工作或做我自己的"}, {"type": "subtitle", "time": 1768.47, "timestamp": "00:29:28", "text": "胡闹事情时陪伴我。 谢谢。   罗"}, {"type": "subtitle", "time": 1771.35, "timestamp": "00:29:31", "text": "扬也是。 谢谢"}, {"type": "subtitle", "time": 1774.87, "timestamp": "00:29:34", "text": "光临。 我知道你有时运气不好，但"}, {"type": "subtitle", "time": 1776.95, "timestamp": "00:29:36", "text": "还是要"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "感谢你记得我的生日，"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "还写了祝福信息。"}, {"type": "subtitle", "time": 1784.63, "timestamp": "00:29:44", "text": "你们两个和"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "橙子都不行。 然后我们引进了阿斯特拉。"}, {"type": "subtitle", "time": 1791.19, "timestamp": "00:29:51", "text": "祝乔伊生日快乐。"}, {"type": "subtitle", "time": 1795.19, "timestamp": "00:29:55", "text": "呃，手指爱心表情符号、爱心表情符号和"}, {"type": "subtitle", "time": 1799.75, "timestamp": "00:29:59", "text": "派对表情符号。 说实话，我不擅长"}]
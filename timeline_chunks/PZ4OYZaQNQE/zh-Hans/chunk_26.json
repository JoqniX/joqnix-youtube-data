[{"type": "subtitle", "time": 1560.71, "timestamp": "00:26:00", "text": "所以，请永远不要让怀疑夺走"}, {"type": "subtitle", "time": 1562.789, "timestamp": "00:26:02", "text": "你所热爱的事物带来的快乐。 永远不要让"}, {"type": "subtitle", "time": 1565.43, "timestamp": "00:26:05", "text": "自己相信你没有能力。 因为"}, {"type": "subtitle", "time": 1568.23, "timestamp": "00:26:08", "text": "事实就是如此。 当你"}, {"type": "subtitle", "time": 1571.51, "timestamp": "00:26:11", "text": "对自己缺乏信心时，请记住，"}, {"type": "chat", "time": 1572.709, "timestamp": "00:26:12", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🫠🫠🫠"}, {"type": "subtitle", "time": 1575.11, "timestamp": "00:26:15", "text": "包括我在内的许多人都会"}, {"type": "subtitle", "time": 1578.47, "timestamp": "00:26:18", "text": "毫不犹豫地相信你。 哦，"}, {"type": "subtitle", "time": 1580.95, "timestamp": "00:26:20", "text": "谢谢你，D。"}, {"type": "subtitle", "time": 1582.71, "timestamp": "00:26:22", "text": "我知道每个人的人生旅程都会遇到坎坷，"}, {"type": "subtitle", "time": 1585.59, "timestamp": "00:26:25", "text": "你的旅程可能也不"}, {"type": "subtitle", "time": 1588.31, "timestamp": "00:26:28", "text": "例外。 但正因如此，"}, {"type": "subtitle", "time": 1591.35, "timestamp": "00:26:31", "text": "让别人与你并肩前行，"}, {"type": "subtitle", "time": 1594.23, "timestamp": "00:26:34", "text": "分享喜悦，分担"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "低谷，才显得尤为重要。 寻求帮助是一种力量，"}, {"type": "subtitle", "time": 1599.35, "timestamp": "00:26:39", "text": "它能让"}, {"type": "subtitle", "time": 1602.23, "timestamp": "00:26:42", "text": "每个人的道路都更加光明。"}, {"type": "subtitle", "time": 1606.149, "timestamp": "00:26:46", "text": "所以今天，我希望你们能停下来，庆祝一下，"}, {"type": "subtitle", "time": 1608.87, "timestamp": "00:26:48", "text": "让自己充分享受这一刻。   这是"}, {"type": "subtitle", "time": 1611.909, "timestamp": "00:26:51", "text": "你应得的。 不仅是因为你"}, {"type": "subtitle", "time": 1614.95, "timestamp": "00:26:54", "text": "所做的事，更是因为你的人格魅力。"}, {"type": "subtitle", "time": 1617.269, "timestamp": "00:26:57", "text": "你值得拥有世间所有的幸福和"}, {"type": "subtitle", "time": 1619.59, "timestamp": "00:26:59", "text": "美好事物"}]
[{"type": "subtitle", "time": 2223.43, "timestamp": "00:37:03", "text": "像我这样的邻居过来"}, {"type": "subtitle", "time": 2227.03, "timestamp": "00:37:07", "text": "串门。 我爸爸给他们打了电话。 所以我只好"}, {"type": "subtitle", "time": 2230.31, "timestamp": "00:37:10", "text": "给他们太妃糖之类的东西。 我"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "刚刚收到一份生日礼物——冰淇淋"}, {"type": "subtitle", "time": 2236.55, "timestamp": "00:37:16", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 2240.47, "timestamp": "00:37:20", "text": "嗯，是的。 是的。 是的。 邻居们，嗯，"}, {"type": "subtitle", "time": 2244.31, "timestamp": "00:37:24", "text": "他们一直陪着"}, {"type": "subtitle", "time": 2247.43, "timestamp": "00:37:27", "text": "我，帮了我很多。 他们就像"}, {"type": "subtitle", "time": 2249.91, "timestamp": "00:37:29", "text": "爸爸的朋友一样，是的，在"}, {"type": "chat", "time": 2250.563, "timestamp": "00:37:30", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "which flavour?"}, {"type": "subtitle", "time": 2251.99, "timestamp": "00:37:31", "text": "我不在的时候，他们也一直照顾我"}, {"type": "subtitle", "time": 2253.75, "timestamp": "00:37:33", "text": "。"}, {"type": "subtitle", "time": 2255.75, "timestamp": "00:37:35", "text": "我真的很感谢他们过来"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "祝我生日快乐，"}, {"type": "subtitle", "time": 2263.109, "timestamp": "00:37:43", "text": "因为除此之外，呃，没多少人知道今天是"}, {"type": "chat", "time": 2263.643, "timestamp": "00:37:43", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "peaks"}, {"type": "chat", "time": 2264.089, "timestamp": "00:37:44", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "🍧🍨"}, {"type": "subtitle", "time": 2264.79, "timestamp": "00:37:44", "text": "我的生日。 是的"}, {"type": "chat", "time": 2266.66, "timestamp": "00:37:46", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "cute lil joq"}, {"type": "subtitle", "time": 2268.87, "timestamp": "00:37:48", "text": "，我买的是奶油"}, {"type": "subtitle", "time": 2272.87, "timestamp": "00:37:52", "text": "糖果口味的，主要是"}, {"type": "subtitle", "time": 2274.63, "timestamp": "00:37:54", "text": "冰淇淋。"}, {"type": "subtitle", "time": 2279.75, "timestamp": "00:37:59", "text": "所以，就像我刚才说的，谢谢你的"}]
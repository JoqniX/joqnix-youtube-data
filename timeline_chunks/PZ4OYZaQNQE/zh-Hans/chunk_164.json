[{"type": "subtitle", "time": 9841.03, "timestamp": "02:44:01", "text": "我们一起来切吧。 好的。"}, {"type": "subtitle", "time": 9843.429, "timestamp": "02:44:03", "text": "嗯，"}, {"type": "subtitle", "time": 9855.51, "timestamp": "02:44:15", "text": "嘿，不过你牵着我的手呢。"}, {"type": "subtitle", "time": 9858.389, "timestamp": "02:44:18", "text": "我们要把它剪辑在一起。"}, {"type": "subtitle", "time": 9863.51, "timestamp": "02:44:23", "text": "乔克，生日快乐。 生日快乐，"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "Tex。"}, {"type": "subtitle", "time": 9877.51, "timestamp": "02:44:37", "text": "这就是生日快乐。"}]
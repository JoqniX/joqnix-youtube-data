[{"type": "subtitle", "time": 5100.82, "timestamp": "01:25:00", "text": "最后一刻问是否合适。"}, {"type": "subtitle", "time": 5103.51, "timestamp": "01:25:03", "text": "[音乐]"}, {"type": "subtitle", "time": 5106.07, "timestamp": "01:25:06", "text": "而且，呃，我不知道，没有得到许可"}, {"type": "subtitle", "time": 5109.27, "timestamp": "01:25:09", "text": "我不应该展示"}, {"type": "subtitle", "time": 5124.39, "timestamp": "01:25:24", "text": "呃，等等。"}, {"type": "subtitle", "time": 5127.35, "timestamp": "01:25:27", "text": "呃，"}, {"type": "subtitle", "time": 5132.629, "timestamp": "01:25:32", "text": "我应该……我只是想……"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "我的意思是，去年今天，去年"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "8月12日，那是在我的……之后 生日那天，"}, {"type": "subtitle", "time": 5142.55, "timestamp": "01:25:42", "text": "我第一次见到我的"}, {"type": "subtitle", "time": 5144.629, "timestamp": "01:25:44", "text": "新模型。"}, {"type": "subtitle", "time": 5146.47, "timestamp": "01:25:46", "text": "嗯，"}, {"type": "subtitle", "time": 5149.51, "timestamp": "01:25:49", "text": "来自Artistan。"}, {"type": "subtitle", "time": 5153.35, "timestamp": "01:25:53", "text": "嗯，是的。所以"}, {"type": "subtitle", "time": 5155.99, "timestamp": "01:25:55", "text": "Shana，我想问问这样可以吗？我"}, {"type": "subtitle", "time": 5159.189, "timestamp": "01:25:59", "text": "不知道。他们不在线。"}]
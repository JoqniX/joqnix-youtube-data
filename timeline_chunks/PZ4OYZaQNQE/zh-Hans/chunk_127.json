[{"type": "subtitle", "time": 7620.39, "timestamp": "02:07:00", "text": "我的天哪，这蛋糕真精致。"}, {"type": "subtitle", "time": 7622.709, "timestamp": "02:07:02", "text": "你为什么要花钱？ 实际价格是多少"}, {"type": "subtitle", "time": 7645.43, "timestamp": "02:07:25", "text": "巧克力酥皮蛋糕怎么样？ 我"}, {"type": "subtitle", "time": 7659.51, "timestamp": "02:07:39", "text": "呃，你……呃，我不想去，我"}, {"type": "subtitle", "time": 7662.79, "timestamp": "02:07:42", "text": "想下去，但我不能下去。"}, {"type": "subtitle", "time": 7667.77, "timestamp": "02:07:47", "text": "请稍等片刻。"}, {"type": "subtitle", "time": 7674.55, "timestamp": "02:07:54", "text": "我现在要安静一会儿。 请欣赏"}, {"type": "subtitle", "time": 7676.95, "timestamp": "02:07:56", "text": "背景音乐。"}]
[{"type": "subtitle", "time": 2281.589, "timestamp": "00:38:01", "text": "生日祝福，"}, {"type": "subtitle", "time": 2285.27, "timestamp": "00:38:05", "text": "而且我真的很高兴"}, {"type": "subtitle", "time": 2287.27, "timestamp": "00:38:07", "text": "见到你，和他聊天什么的"}, {"type": "subtitle", "time": 2289.43, "timestamp": "00:38:09", "text": "。"}, {"type": "subtitle", "time": 2291.829, "timestamp": "00:38:11", "text": "感谢你一直以来对我的好，"}, {"type": "subtitle", "time": 2295.19, "timestamp": "00:38:15", "text": "希望我们以后也能一起创造更多美好的"}, {"type": "subtitle", "time": 2297.03, "timestamp": "00:38:17", "text": "回忆，共度更多时光，"}, {"type": "subtitle", "time": 2299.349, "timestamp": "00:38:19", "text": "并有更多合作的机会。"}, {"type": "subtitle", "time": 2302.39, "timestamp": "00:38:22", "text": "不，应该非常感谢你祝我"}, {"type": "subtitle", "time": 2305.349, "timestamp": "00:38:25", "text": "生日快乐，也感谢你"}, {"type": "subtitle", "time": 2307.99, "timestamp": "00:38:27", "text": "那天"}, {"type": "subtitle", "time": 2310.71, "timestamp": "00:38:30", "text": "在 Twitch 上随意搜索直播时找到了我"}, {"type": "subtitle", "time": 2315.109, "timestamp": "00:38:35", "text": "。 这对我意义重大。"}, {"type": "subtitle", "time": 2317.829, "timestamp": "00:38:37", "text": "嗨，嗯，"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "我会列出我已经读完的那些书"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "。 好的。"}, {"type": "subtitle", "time": 2326.63, "timestamp": "00:38:46", "text": "Zan，你好，谢谢你的生日祝福，祝你"}, {"type": "subtitle", "time": 2328.31, "timestamp": "00:38:48", "text": "生日快乐！"}, {"type": "subtitle", "time": 2330.87, "timestamp": "00:38:50", "text": "谢谢。"}]
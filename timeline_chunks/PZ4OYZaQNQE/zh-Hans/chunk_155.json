[{"type": "subtitle", "time": 9301.75, "timestamp": "02:35:01", "text": "哦"}, {"type": "subtitle", "time": 9304.79, "timestamp": "02:35:04", "text": "好的。 声音没有破音。 是的，我"}, {"type": "subtitle", "time": 9314.87, "timestamp": "02:35:14", "text": "我必须确保自己不碰"}, {"type": "subtitle", "time": 9317.11, "timestamp": "02:35:17", "text": "蛋糕。"}, {"type": "subtitle", "time": 9335.03, "timestamp": "02:35:35", "text": "我应该在直播开始时就这么做的"}, {"type": "subtitle", "time": 9338.79, "timestamp": "02:35:38", "text": "，不过算了。 嗨，"}, {"type": "subtitle", "time": 9342.389, "timestamp": "02:35:42", "text": "我有一些，"}, {"type": "subtitle", "time": 9345.349, "timestamp": "02:35:45", "text": "嗯，我有一些蜡烛，是那个东西附带的"}, {"type": "subtitle", "time": 9350.95, "timestamp": "02:35:50", "text": "。 所以我把它放在这里。"}]
[{"type": "subtitle", "time": 3241.75, "timestamp": "00:54:01", "text": "谢谢你送的精美礼物和"}, {"type": "subtitle", "time": 3243.75, "timestamp": "00:54:03", "text": "生日祝福。"}, {"type": "subtitle", "time": 3246.71, "timestamp": "00:54:06", "text": "谢谢D。我非常享受和"}, {"type": "subtitle", "time": 3250.39, "timestamp": "00:54:10", "text": "Dio的合作，也谢谢你。"}, {"type": "subtitle", "time": 3253.43, "timestamp": "00:54:13", "text": "虽然有点混乱，但真的很有趣。嗯，"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "在那个叫什么来着，合作的时候，我们"}, {"type": "subtitle", "time": 3259.75, "timestamp": "00:54:19", "text": "没人做饭，一切都很"}, {"type": "subtitle", "time": 3262.87, "timestamp": "00:54:22", "text": "开心。我还记得很久"}, {"type": "subtitle", "time": 3266.63, "timestamp": "00:54:26", "text": "以前我们一起玩过一次《堡垒之夜》，如果你不记得了，我不知道"}, {"type": "subtitle", "time": 3268.63, "timestamp": "00:54:28", "text": "你是否还记得。对了，我们还"}, {"type": "subtitle", "time": 3271.75, "timestamp": "00:54:31", "text": "一起玩过《瓦伦特》。谢谢你"}, {"type": "subtitle", "time": 3278.79, "timestamp": "00:54:38", "text": "和我一起创造了一些美好的回忆，谢谢你温暖、"}, {"type": "subtitle", "time": 3280.23, "timestamp": "00:54:40", "text": "友善、"}, {"type": "subtitle", "time": 3288.63, "timestamp": "00:54:48", "text": "别忘了给它点个赞。 所以我"}, {"type": "subtitle", "time": 3291.75, "timestamp": "00:54:51", "text": "不记得我读过。"}, {"type": "subtitle", "time": 3295.03, "timestamp": "00:54:55", "text": "接下来是扎基。 再次感谢您"}, {"type": "subtitle", "time": 3298.23, "timestamp": "00:54:58", "text": "美好的生日祝福。"}]
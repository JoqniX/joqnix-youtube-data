[{"type": "subtitle", "time": 9540.79, "timestamp": "02:39:00", "text": "感谢Fun送我的蛋糕。 我"}, {"type": "subtitle", "time": 9544.87, "timestamp": "02:39:04", "text": "以前从未这样做过，但是，嗯，这对我来说意义"}, {"type": "subtitle", "time": 9548.07, "timestamp": "02:39:08", "text": "重大。 谢谢。"}, {"type": "subtitle", "time": 9550.79, "timestamp": "02:39:10", "text": "不要吃蜡烛。 好的。 你好。 好的。 所以，"}, {"type": "subtitle", "time": 9554.71, "timestamp": "02:39:14", "text": "蜡烛就此告别了。 好的。 嗯，"}, {"type": "subtitle", "time": 9558.07, "timestamp": "02:39:18", "text": "好的。 你好。 再次感谢"}, {"type": "subtitle", "time": 9562.23, "timestamp": "02:39:22", "text": "大家庆祝我的……"}, {"type": "subtitle", "time": 9569.349, "timestamp": "02:39:29", "text": "嗯……2025年第五个……嗯……明星日。 这场"}, {"type": "subtitle", "time": 9571.349, "timestamp": "02:39:31", "text": "庆祝活动不仅是为了这个梗，"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "也是为了运动健将。 嗨，我们开始吧"}, {"type": "subtitle", "time": 9580.95, "timestamp": "02:39:40", "text": "。 祝我生日快乐。 祝你生日快乐"}, {"type": "subtitle", "time": 9582.87, "timestamp": "02:39:42", "text": "。   祝"}, {"type": "subtitle", "time": 9587.27, "timestamp": "02:39:47", "text": "我和 Doc Nex 生日快乐。   祝"}, {"type": "subtitle", "time": 9592.07, "timestamp": "02:39:52", "text": "你我生日快乐。"}, {"type": "subtitle", "time": 9596.389, "timestamp": "02:39:56", "text": "你好。 我们所有人，从所有"}, {"type": "subtitle", "time": 9599.91, "timestamp": "02:39:59", "text": "音乐会的盘子到我的架子，都要这样做"}]
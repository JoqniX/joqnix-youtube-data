[{"type": "subtitle", "time": 1621.19, "timestamp": "00:27:01", "text": "。"}, {"type": "subtitle", "time": 1624.39, "timestamp": "00:27:04", "text": "生日快乐，医生。 说实话，我"}, {"type": "subtitle", "time": 1626.63, "timestamp": "00:27:06", "text": "仍然觉得不可思议，一个星座竟然会以"}, {"type": "subtitle", "time": 1630.31, "timestamp": "00:27:10", "text": "人类的年份来庆祝。"}, {"type": "subtitle", "time": 1633.19, "timestamp": "00:27:13", "text": "让宇宙感觉小了一些，"}, {"type": "subtitle", "time": 1635.43, "timestamp": "00:27:15", "text": "也温暖了很多（"}, {"type": "subtitle", "time": 1639.75, "timestamp": "00:27:19", "text": "橙色点点点）。"}, {"type": "subtitle", "time": 1642.39, "timestamp": "00:27:22", "text": "你说得对。 我的天啊。 谢谢你发来的"}, {"type": "subtitle", "time": 1644.71, "timestamp": "00:27:24", "text": "美好"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "留言和生日祝福。 谢谢"}, {"type": "subtitle", "time": 1650.549, "timestamp": "00:27:30", "text": "你，D。谢谢你抽出时间"}, {"type": "subtitle", "time": 1653.75, "timestamp": "00:27:33", "text": "为我写这条信息"}, {"type": "chat", "time": 1656.837, "timestamp": "00:27:36", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "😭❣❣❣🎉"}, {"type": "subtitle", "time": 1657.59, "timestamp": "00:27:37", "text": "。 谢谢你，D。我不知道"}, {"type": "subtitle", "time": 1659.43, "timestamp": "00:27:39", "text": "我有多"}, {"type": "subtitle", "time": 1661.75, "timestamp": "00:27:41", "text": "感激你发来的这条信息。   是的"}, {"type": "subtitle", "time": 1665.269, "timestamp": "00:27:45", "text": "，尤其是"}, {"type": "subtitle", "time": 1669.51, "timestamp": "00:27:49", "text": "你们也知道的那部分。 我患有……"}, {"type": "subtitle", "time": 1672.71, "timestamp": "00:27:52", "text": "呃……该怎么形容呢，叫什么来着？冒名顶替"}, {"type": "subtitle", "time": 1674.87, "timestamp": "00:27:54", "text": "综合症。所以我不承认自己"}, {"type": "subtitle", "time": 1677.909, "timestamp": "00:27:57", "text": "喜欢的东西，我总是怀疑自己的"}]
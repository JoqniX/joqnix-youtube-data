[{"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "专业人士一样迅速回到工作中去。 必须"}, {"type": "subtitle", "time": 2528.95, "timestamp": "00:42:08", "text": "给你打个分。 还有"}, {"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "你模特身上那种夏威夷风情和老婆气质。 我对此感到"}, {"type": "subtitle", "time": 2538.309, "timestamp": "00:42:18", "text": "非常兴奋。"}, {"type": "subtitle", "time": 2541.91, "timestamp": "00:42:21", "text": "所以，新模特，"}, {"type": "subtitle", "time": 2547.109, "timestamp": "00:42:27", "text": "谢谢你做你自己。 所以，嗯，很"}, {"type": "subtitle", "time": 2548.79, "timestamp": "00:42:28", "text": "抱歉，"}, {"type": "subtitle", "time": 2553.27, "timestamp": "00:42:33", "text": "即使在这样"}, {"type": "subtitle", "time": 2556.47, "timestamp": "00:42:36", "text": "艰难的日子里，我还是来了。 这一定很艰难，"}, {"type": "subtitle", "time": 2559.589, "timestamp": "00:42:39", "text": "也很令人恼火，因为它播下了"}, {"type": "subtitle", "time": 2562.79, "timestamp": "00:42:42", "text": "开启我自己旅程的种子。"}, {"type": "subtitle", "time": 2565.27, "timestamp": "00:42:45", "text": "如果你认为这一切都只是说说而已，"}, {"type": "subtitle", "time": 2567.829, "timestamp": "00:42:47", "text": "我连一秒钟都没认真想过（"}, {"type": "subtitle", "time": 2570.39, "timestamp": "00:42:50", "text": "虽然我怀疑你不会这么想），那么请记住，"}, {"type": "subtitle", "time": 2572.71, "timestamp": "00:42:52", "text": "我目前最大的愿望就是有"}, {"type": "subtitle", "time": 2578.63, "timestamp": "00:42:58", "text": "一天能够与你合作。 感谢您"}]
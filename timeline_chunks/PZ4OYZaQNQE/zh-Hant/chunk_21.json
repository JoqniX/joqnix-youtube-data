[{"type": "subtitle", "time": 1261.029, "timestamp": "00:21:01", "text": "我最喜歡的時刻之一。這純粹是cosplay，"}, {"type": "subtitle", "time": 1264.549, "timestamp": "00:21:04", "text": "但卻是以最好的方式呈現。"}, {"type": "subtitle", "time": 1267.43, "timestamp": "00:21:07", "text": "我很高興我們能一起分享那一刻，"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "我迫不及待想和你一起體驗更多有趣的事"}, {"type": "subtitle", "time": 1274.95, "timestamp": "00:21:14", "text": "。是的，我也是。所以，這是我們"}, {"type": "subtitle", "time": 1277.669, "timestamp": "00:21:17", "text": "作為 Jakatan 合作計畫的一部分的合作。我們和"}, {"type": "chat", "time": 1282.235, "timestamp": "00:21:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉♥♥♥♥🥳🎉🎉🎉🥀"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "Jarisa 進行了一次類似合作的"}, {"type": "subtitle", "time": 1286.549, "timestamp": "00:21:26", "text": "聚會。這是我第一次和她合作。嗯，"}, {"type": "subtitle", "time": 1288.31, "timestamp": "00:21:28", "text": "雖然我們之前在一些團隊合作的"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "場合，比如玩 Minecraft 之類的"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "，但是，嗯。  嗯，"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "這是我第一次和"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "德爾潘一起出去玩，很高興能"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "更了解她，"}, {"type": "subtitle", "time": 1306.07, "timestamp": "00:21:46", "text": "而且我們有很多共同的愛好等等，"}, {"type": "subtitle", "time": 1308.31, "timestamp": "00:21:48", "text": "聊些有趣的事情。太好玩了。我很"}, {"type": "subtitle", "time": 1311.83, "timestamp": "00:21:51", "text": "喜歡。希望以後能有更多深夜"}, {"type": "subtitle", "time": 1315.029, "timestamp": "00:21:55", "text": "歡笑、更多合作，以及更多"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "瘋狂的時刻。"}]
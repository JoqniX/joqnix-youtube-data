[{"type": "subtitle", "time": 1022.23, "timestamp": "00:17:02", "text": "。不用擔心。"}, {"type": "subtitle", "time": 1024.39, "timestamp": "00:17:04", "text": "一切都好。你祝我好運。你只需"}, {"type": "subtitle", "time": 1027.27, "timestamp": "00:17:07", "text": "要花兩分鐘或五分鐘就能寫出一條"}, {"type": "subtitle", "time": 1029.829, "timestamp": "00:17:09", "text": "生日祝福語。這對我來說"}, {"type": "subtitle", "time": 1032.87, "timestamp": "00:17:12", "text": "意義非凡。那會讓我又哭"}, {"type": "subtitle", "time": 1036.23, "timestamp": "00:17:16", "text": "又高興。是的，我很高興。謝謝。"}, {"type": "subtitle", "time": 1039.75, "timestamp": "00:17:19", "text": "不需要什麼昂貴的禮物之類的"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "。沒事。"}, {"type": "subtitle", "time": 1044.15, "timestamp": "00:17:24", "text": "您好，"}, {"type": "chat", "time": 1045.497, "timestamp": "00:17:25", "author": "@meow_miko", "avatar": "https://yt4.ggpht.com/ASvDvYYIzbsKhRZHUW96TfjrUSWXRG124t_MDqszJYXjA87uEcIZVvjFBsBfRncMogN0tWEt0iI=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/fish-orange-wide-eyesUCkszU2WH9gy1mb0dV-11UJg/fish-orange-wide-eyes"}, {"type": "subtitle", "time": 1046.63, "timestamp": "00:17:26", "text": "由於個人因素。什麼都沒做成。我原本計劃了一些事情。"}, {"type": "subtitle", "time": 1054.23, "timestamp": "00:17:34", "text": "生日快樂。開心閃閃的表情"}, {"type": "subtitle", "time": 1057.43, "timestamp": "00:17:37", "text": "符號。呃，舒服的表情符號。我有生日表情"}, {"type": "subtitle", "time": 1061.19, "timestamp": "00:17:41", "text": "符號。哦，這也太可愛了吧。"}, {"type": "subtitle", "time": 1064.71, "timestamp": "00:17:44", "text": "你知道，你知道我是誰。所以，"}, {"type": "chat", "time": 1065.122, "timestamp": "00:17:45", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🎀happy happy cat dance"}, {"type": "chat", "time": 1066.802, "timestamp": "00:17:46", "author": "@meow_miko", "avatar": "https://yt4.ggpht.com/ASvDvYYIzbsKhRZHUW96TfjrUSWXRG124t_MDqszJYXjA87uEcIZVvjFBsBfRncMogN0tWEt0iI=s64-c-k-c0x00ffffff-no-rj", "message": "We need cake photos 😶‍🌫😶‍🌫"}, {"type": "subtitle", "time": 1067.35, "timestamp": "00:17:47", "text": "網站上可能還會收到一份生日祝福。"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "沒什麼特別的。呃，真的很抱歉，祝你"}, {"type": "subtitle", "time": 1075.19, "timestamp": "00:17:55", "text": "生日快樂。"}, {"type": "subtitle", "time": 1076.95, "timestamp": "00:17:56", "text": "我不知道還能說什麼。或許"}]
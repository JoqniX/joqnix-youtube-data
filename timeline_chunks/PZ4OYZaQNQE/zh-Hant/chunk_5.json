[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "當時在做生日"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "祈禱之類的事情。大家各自走"}, {"type": "subtitle", "time": 307.27, "timestamp": "00:05:07", "text": "自己的路，我也去了那裡。我的"}, {"type": "subtitle", "time": 310.629, "timestamp": "00:05:10", "text": "天哪，太搞笑了。"}, {"type": "chat", "time": 312.96, "timestamp": "00:05:12", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🥳🥳🎉🎉"}, {"type": "subtitle", "time": 314.87, "timestamp": "00:05:14", "text": "然後我手忙腳亂的。我在祈禱的時候咬到了舌頭"}, {"type": "subtitle", "time": 319.11, "timestamp": "00:05:19", "text": "。"}, {"type": "subtitle", "time": 321.99, "timestamp": "00:05:21", "text": "發生了很多事。"}, {"type": "subtitle", "time": 323.67, "timestamp": "00:05:23", "text": "哦，"}, {"type": "subtitle", "time": 326.31, "timestamp": "00:05:26", "text": "發生了很多事。是的。今天，"}, {"type": "subtitle", "time": 328.469, "timestamp": "00:05:28", "text": "對於收看節目的朋友們，今天是我的"}, {"type": "chat", "time": 328.793, "timestamp": "00:05:28", "author": "@ValikValik-b2u", "avatar": "https://yt4.ggpht.com/C1JlkVEJDh0gzPP-LdyE6_0Cuq4eR-MdZKt5LYRqiusVebnNifrMX_s9qVS2ETVv0k1Wm_QHKg=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉🎉🎉🎉🥳"}, {"type": "chat", "time": 330.863, "timestamp": "00:05:30", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Valik_Evpiq~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 332.629, "timestamp": "00:05:32", "text": "生日。今天是我的幸運日。嗯嗯，xx x x x x x"}, {"type": "subtitle", "time": 336.95, "timestamp": "00:05:36", "text": "x 歲。  我"}, {"type": "subtitle", "time": 340.55, "timestamp": "00:05:40", "text": "老了。是啊，我老了。"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "我不想變老。我想"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "永遠80歲。我的意思是，我就是一顆"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "星。我不會變老。是啊，"}, {"type": "subtitle", "time": 351.67, "timestamp": "00:05:51", "text": "不過還是…"}, {"type": "subtitle", "time": 355.029, "timestamp": "00:05:55", "text": "所以，今天，我們將一起閱讀大家傳給我的"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "生日祝福"}]
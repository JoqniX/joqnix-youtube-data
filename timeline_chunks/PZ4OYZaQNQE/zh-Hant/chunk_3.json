[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "希望我在線上。我沒有"}, {"type": "subtitle", "time": 182.949, "timestamp": "00:03:02", "text": "檢查我的連接是否正常"}, {"type": "subtitle", "time": 185.75, "timestamp": "00:03:05", "text": "，但我應該可以正常在線了。"}, {"type": "subtitle", "time": 190.149, "timestamp": "00:03:10", "text": "是的。大家好，我正在直播。你好。所以，今天，"}, {"type": "subtitle", "time": 193.27, "timestamp": "00:03:13", "text": "呃，今天是我的生日。嗯，稍等一下。"}, {"type": "subtitle", "time": 196.07, "timestamp": "00:03:16", "text": "我認為我們不需要這個。所以，我可以把"}, {"type": "subtitle", "time": 198.869, "timestamp": "00:03:18", "text": "它刪掉。呃，等等，"}, {"type": "subtitle", "time": 200.55, "timestamp": "00:03:20", "text": "夥計。"}, {"type": "subtitle", "time": 203.11, "timestamp": "00:03:23", "text": "我打不開聊天視窗。我很抱歉。  呃，"}, {"type": "subtitle", "time": 205.99, "timestamp": "00:03:25", "text": "我今天沒辦法讓聊天功能正常運作"}, {"type": "subtitle", "time": 209.35, "timestamp": "00:03:29", "text": "。嗯，抱歉一切都"}, {"type": "subtitle", "time": 213.27, "timestamp": "00:03:33", "text": "這麼倉促，因為"}, {"type": "subtitle", "time": 217.03, "timestamp": "00:03:37", "text": "今天是我"}, {"type": "subtitle", "time": 219.19, "timestamp": "00:03:39", "text": "現實生活中的生日，所以一切都很倉促。  今天也是"}, {"type": "subtitle", "time": 224.71, "timestamp": "00:03:44", "text": "我的生日。所以，我"}, {"type": "subtitle", "time": 227.91, "timestamp": "00:03:47", "text": "和我的家人當時在切蛋糕什麼的，大概是"}, {"type": "subtitle", "time": 234.869, "timestamp": "00:03:54", "text": "6點50分"}, {"type": "subtitle", "time": 237.50900000000001, "timestamp": "00:03:57", "text": "或是6點40分左右。"}]
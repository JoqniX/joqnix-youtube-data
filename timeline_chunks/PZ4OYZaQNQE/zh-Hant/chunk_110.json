[{"type": "subtitle", "time": 6605.91, "timestamp": "01:50:05", "text": "我從未想過會擁有的夢想一樣，我很高興我選擇的這位"}, {"type": "subtitle", "time": 6609.109, "timestamp": "01:50:09", "text": "藝術家讓我比以往任何時候都更"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "漂亮。我非常喜歡她的畫風，一直是她的忠實粉絲。  我真心希望幕後的一切都能順利解決，是的，這將會是未來的官方模型，但目前我們只能看到這些。  是的，"}, {"type": "subtitle", "time": 6627.43, "timestamp": "01:50:27", "text": "這是一款真正的性別中立模型。是的。  所以，所以，所以它將成為真正的普遍中立"}, {"type": "subtitle", "time": 6633.99, "timestamp": "01:50:33", "text": "模型，作為一個整體，對嗎？所以，我也有一個王冠"}, {"type": "subtitle", "time": 6637.669, "timestamp": "01:50:37", "text": "。你有沒有看到？我有一頂王冠。我不該過度"}, {"type": "subtitle", "time": 6644.07, "timestamp": "01:50:44", "text": "戲弄別人。  我已經看太多了，兄弟。這是為了……"}, {"type": "subtitle", "time": 6650.07, "timestamp": "01:50:50", "text": "我會把它留到出道、出道前的宣傳推文以及未來很長一段時間裡"}, {"type": "subtitle", "time": 6653.83, "timestamp": "01:50:53", "text": "使用。  如果有一天"}, {"type": "subtitle", "time": 6659.27, "timestamp": "01:50:59", "text": "我能買得起這款車型的話。  嗯，因為現在很貴"}]
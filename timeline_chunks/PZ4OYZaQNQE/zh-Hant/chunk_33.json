[{"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "證件，我驚訝地發現你"}, {"type": "subtitle", "time": 2001.029, "timestamp": "00:33:21", "text": "是印度人。啊。哦，一切都是從那裡開始的。  嗯，過去半年你一直是我很好的朋友，但時間並不重要，對吧"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "認識你、和你在一起的時光是一段美好的旅程，哈托吉。我希望你"}, {"type": "subtitle", "time": 2025.59, "timestamp": "00:33:45", "text": "今天過得愉快，也希望你未來一年一切順利。有趣的是，查德很懶，等了很久才打開廣告。他就是查德。他懶得開門。等等，你"}, {"type": "subtitle", "time": 2028.71, "timestamp": "00:33:48", "text": "看得到這個嗎？讓我先"}, {"type": "subtitle", "time": 2035.75, "timestamp": "00:33:55", "text": "挪一下"}, {"type": "subtitle", "time": 2039.669, "timestamp": "00:33:59", "text": "。我該挪一下嗎？好的。  他懶得在"}]
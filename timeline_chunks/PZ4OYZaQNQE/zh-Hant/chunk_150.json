[{"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "一支蠟燭。等待。  我的天啊。兄弟，其實是有蛋糕的。"}, {"type": "subtitle", "time": 9029.99, "timestamp": "02:30:29", "text": "我的天啊。  巴。我的天啊。好的。  我的天啊"}, {"type": "subtitle", "time": 9033.59, "timestamp": "02:30:33", "text": "。我這輩子第一次要在直播切蛋糕了。"}, {"type": "subtitle", "time": 9047.349, "timestamp": "02:30:47", "text": "我從不給運動員"}]
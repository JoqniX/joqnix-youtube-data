[{"type": "subtitle", "time": 2646.79, "timestamp": "00:44:06", "text": "我没有忘记登录。嗯？所以如果"}, {"type": "subtitle", "time": 2650.95, "timestamp": "00:44:10", "text": "如果你在云端输入 jocknix，你就会明白我的意思。"}, {"type": "subtitle", "time": 2654.309, "timestamp": "00:44:14", "text": "你会得到这些，是的，这些"}, {"type": "subtitle", "time": 2658.87, "timestamp": "00:44:18", "text": "有 Jocknix OST、Jon OST 以及所有这些东西吗？"}, {"type": "subtitle", "time": 2662.87, "timestamp": "00:44:22", "text": "就是那些，还有泷须"}, {"type": "subtitle", "time": 2665.99, "timestamp": "00:44:25", "text": "这里也在这里。"}, {"type": "subtitle", "time": 2667.67, "timestamp": "00:44:27", "text": "呃"}, {"type": "chat", "time": 2669.597, "timestamp": "00:44:29", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "is it a sad song"}, {"type": "subtitle", "time": 2675.67, "timestamp": "00:44:35", "text": "但是，为什么播放列表是……"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "悲伤的歌。你当时正在听的那段"}, {"type": "subtitle", "time": 2681.109, "timestamp": "00:44:41", "text": "之前名为 Constellar Pognitier"}, {"type": "subtitle", "time": 2684.55, "timestamp": "00:44:44", "text": "是古典类型的钱德拉。"}, {"type": "subtitle", "time": 2687.03, "timestamp": "00:44:47", "text": "你现在正在收听的这个，就是这个"}, {"type": "subtitle", "time": 2690.71, "timestamp": "00:44:50", "text": "其中之一是 Jocknik 的 D 动画。这是一个"}, {"type": "subtitle", "time": 2693.51, "timestamp": "00:44:53", "text": "显然是首摇滚歌曲。"}, {"type": "subtitle", "time": 2699.67, "timestamp": "00:44:59", "text": "好了。我会把音量调大。"}]
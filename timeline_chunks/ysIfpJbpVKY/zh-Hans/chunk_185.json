[{"type": "subtitle", "time": 11116.95, "timestamp": "03:05:16", "text": "一旦我觉得几年后我会觉得"}, {"type": "subtitle", "time": 11120.07, "timestamp": "03:05:20", "text": "像其他印度独立YouTuber一样"}, {"type": "subtitle", "time": 11122.15, "timestamp": "03:05:22", "text": "印度的YouTube博主们也会这样做。"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "就像我正在做的那样。是的，问题是……"}, {"type": "subtitle", "time": 11129.75, "timestamp": "03:05:29", "text": "现在大家都把它当作爱好而不是爱好来做。"}, {"type": "subtitle", "time": 11132.79, "timestamp": "03:05:32", "text": "像件严肃的事情一样，对吧？但是如果"}, {"type": "subtitle", "time": 11135.429, "timestamp": "03:05:35", "text": "他们有没有想过卖周边产品之类的？"}, {"type": "subtitle", "time": 11138.23, "timestamp": "03:05:38", "text": "他们会怎么做？正确的。"}, {"type": "subtitle", "time": 11139.99, "timestamp": "03:05:39", "text": "是的，我认为我们可以从中看到这一点。"}, {"type": "subtitle", "time": 11143.19, "timestamp": "03:05:43", "text": "未来。希望如此"}, {"type": "subtitle", "time": 11145.349, "timestamp": "03:05:45", "text": "人们会做和我一样的事"}, {"type": "subtitle", "time": 11147.03, "timestamp": "03:05:47", "text": "正在做。"}, {"type": "subtitle", "time": 11153.59, "timestamp": "03:05:53", "text": "做所有事"}]
[{"type": "subtitle", "time": 6600.49, "timestamp": "01:50:00", "text": "就像附近的另一套公寓或房子一样。"}, {"type": "subtitle", "time": 6602.149, "timestamp": "01:50:02", "text": "[笑声]"}, {"type": "subtitle", "time": 6604.45, "timestamp": "01:50:04", "text": "我当时就想，“不，"}, {"type": "subtitle", "time": 6606.79, "timestamp": "01:50:06", "text": "[音乐]"}, {"type": "subtitle", "time": 6610.229, "timestamp": "01:50:10", "text": "我想要你。"}, {"type": "subtitle", "time": 6613.03, "timestamp": "01:50:13", "text": "我需要你，"}, {"type": "subtitle", "time": 6620.07, "timestamp": "01:50:20", "text": "玛雅。"}, {"type": "subtitle", "time": 6623.99, "timestamp": "01:50:23", "text": "和往常一样，Dogo Chan 就像"}, {"type": "subtitle", "time": 6628.34, "timestamp": "01:50:28", "text": "看到那只蝴蝶，我叫个不停"}, {"type": "subtitle", "time": 6634.87, "timestamp": "01:50:34", "text": "最近知道。我的天啊。让我告诉你"}, {"type": "subtitle", "time": 6636.87, "timestamp": "01:50:36", "text": "你听过这个故事吗？"}, {"type": "subtitle", "time": 6642.39, "timestamp": "01:50:42", "text": "我的天哪。他对着一具尸体吠叫"}, {"type": "subtitle", "time": 6646.55, "timestamp": "01:50:46", "text": "在他的……狗窝上。不，他就是他"}, {"type": "subtitle", "time": 6648.79, "timestamp": "01:50:48", "text": "我无法接受。他就像……"}, {"type": "subtitle", "time": 6651.91, "timestamp": "01:50:51", "text": "一条死虫子之类的东西，或者类似的东西"}, {"type": "subtitle", "time": 6655.109, "timestamp": "01:50:55", "text": "苍蝇或者其他什么东西死了或者别的什么"}, {"type": "subtitle", "time": 6658.629, "timestamp": "01:50:58", "text": "就像呃，在他的狗身上，我当时在想……"}]
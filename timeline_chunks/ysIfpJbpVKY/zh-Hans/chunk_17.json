[{"type": "subtitle", "time": 1023.59, "timestamp": "00:17:03", "text": "老师当时就说："}, {"type": "subtitle", "time": 1027.11, "timestamp": "00:17:07", "text": "我的老师说：“是啊，别穿……”"}, {"type": "subtitle", "time": 1035.669, "timestamp": "00:17:15", "text": "我当时就像在听音乐，沉浸在氛围里，"}, {"type": "subtitle", "time": 1038.87, "timestamp": "00:17:18", "text": "我当时正准备着……"}, {"type": "subtitle", "time": 1040.87, "timestamp": "00:17:20", "text": "课程"}, {"type": "subtitle", "time": 1043.35, "timestamp": "00:17:23", "text": "我懒得去查有多少个。"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "我点击的次数，呃，按压的次数"}, {"type": "subtitle", "time": 1066.71, "timestamp": "00:17:46", "text": "我还没仔细核查过。我的"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 120.469, "timestamp": "00:02:00", "text": "插上电源，让它充电"}, {"type": "subtitle", "time": 125.109, "timestamp": "00:02:05", "text": "等等。当然可以。"}, {"type": "subtitle", "time": 128.63, "timestamp": "00:02:08", "text": "大家最近怎么样？温暖"}, {"type": "subtitle", "time": 132.15, "timestamp": "00:02:12", "text": "祝大家早安！"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "希望你们一切都好。我正在获得"}, {"type": "subtitle", "time": 145.51, "timestamp": "00:02:25", "text": "今天就讲这个。嗯，我们将继续"}, {"type": "subtitle", "time": 149.19, "timestamp": "00:02:29", "text": "昨天的东西。我意识到我"}, {"type": "subtitle", "time": 153.27, "timestamp": "00:02:33", "text": "有点突然。我当时感觉"}, {"type": "subtitle", "time": 155.19, "timestamp": "00:02:35", "text": "压力极大，"}, {"type": "subtitle", "time": 158.07, "timestamp": "00:02:38", "text": "超级累。我一直经历着"}, {"type": "subtitle", "time": 160.309, "timestamp": "00:02:40", "text": "最近感觉筋疲力尽。"}, {"type": "subtitle", "time": 163.11, "timestamp": "00:02:43", "text": "那确实有这么回事。我一直经历着"}, {"type": "subtitle", "time": 167.91, "timestamp": "00:02:47", "text": "最近感觉筋疲力尽。有点糟糕。"}, {"type": "subtitle", "time": 169.50900000000001, "timestamp": "00:02:49", "text": "嗯，"}, {"type": "subtitle", "time": 173.50900000000001, "timestamp": "00:02:53", "text": "所以有点糟糕。"}, {"type": "subtitle", "time": 175.27, "timestamp": "00:02:55", "text": "显然，"}, {"type": "subtitle", "time": 177.43, "timestamp": "00:02:57", "text": "但"}, {"type": "subtitle", "time": 178.95, "timestamp": "00:02:58", "text": "目前"}]
[{"type": "subtitle", "time": 4681.01, "timestamp": "01:18:01", "text": "请允许我登录一下我的云端账户。"}, {"type": "subtitle", "time": 4698.31, "timestamp": "01:18:18", "text": "[音乐]"}, {"type": "subtitle", "time": 4706.31, "timestamp": "01:18:26", "text": "说实话，你知道的。"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "曾几何时，我心想："}, {"type": "subtitle", "time": 4711.83, "timestamp": "01:18:31", "text": "制作NFD"}, {"type": "subtitle", "time": 4715.43, "timestamp": "01:18:35", "text": "然后我才意识到NFD有多糟糕。你可以"}, {"type": "subtitle", "time": 4718.63, "timestamp": "01:18:38", "text": "直接截图就行。"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "然后我就想，好吧，不，为什么我想到了"}, {"type": "subtitle", "time": 4724.47, "timestamp": "01:18:44", "text": "这样做是因为，嗯，我看到了"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "神椿工作室的人会做这件事，而且他们"}, {"type": "subtitle", "time": 4730.06, "timestamp": "01:18:50", "text": "现在停止这样做了"}, {"type": "subtitle", "time": 4731.669, "timestamp": "01:18:51", "text": "[音乐]"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "他们创造了一个完整的U形传说，"}, {"type": "subtitle", "time": 4736.79, "timestamp": "01:18:56", "text": "动漫里的一切，那就是"}, {"type": "subtitle", "time": 4738.87, "timestamp": "01:18:58", "text": "现在正在播出，就在神椿"}]
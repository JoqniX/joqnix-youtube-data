[{"type": "subtitle", "time": 660.55, "timestamp": "00:11:00", "text": "好的。所以昨天"}, {"type": "subtitle", "time": 663.67, "timestamp": "00:11:03", "text": "当我的大脑濒临死亡时，我意识到了一些"}, {"type": "subtitle", "time": 667.35, "timestamp": "00:11:07", "text": "我忘记处理的一些问题，例如……"}, {"type": "subtitle", "time": 669.35, "timestamp": "00:11:09", "text": "这些文本"}, {"type": "subtitle", "time": 672.71, "timestamp": "00:11:12", "text": "我忘了加上“如果你注意到的话”"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "右侧我不知道我能不能看到它"}, {"type": "subtitle", "time": 678.71, "timestamp": "00:11:18", "text": "但是，是的，他们中的一些人没有……"}, {"type": "subtitle", "time": 681.35, "timestamp": "00:11:21", "text": "正确的"}, {"type": "subtitle", "time": 683.75, "timestamp": "00:11:23", "text": "设计代币。"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "是的。"}, {"type": "subtitle", "time": 688.71, "timestamp": "00:11:28", "text": "所以D，它的设计不正确。"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "令牌"}, {"type": "subtitle", "time": 693.43, "timestamp": "00:11:33", "text": "我昨天还在复制粘贴呢"}, {"type": "subtitle", "time": 696.63, "timestamp": "00:11:36", "text": "并且速通。我没来得及检查"}, {"type": "subtitle", "time": 699.67, "timestamp": "00:11:39", "text": "其中一些事情。"}, {"type": "subtitle", "time": 704.15, "timestamp": "00:11:44", "text": "现在我才意识到，我的天哪"}, {"type": "subtitle", "time": 707.03, "timestamp": "00:11:47", "text": "它没有那个功能。"}, {"type": "subtitle", "time": 710.389, "timestamp": "00:11:50", "text": "你看，很多东西都没有"}, {"type": "subtitle", "time": 712.23, "timestamp": "00:11:52", "text": "正确的事情。这个也没有"}, {"type": "subtitle", "time": 714.63, "timestamp": "00:11:54", "text": "有了。"}, {"type": "subtitle", "time": 717.03, "timestamp": "00:11:57", "text": "我必须把一切都放进去。"}, {"type": "subtitle", "time": 719.59, "timestamp": "00:11:59", "text": "确保所有这些都具备"}]
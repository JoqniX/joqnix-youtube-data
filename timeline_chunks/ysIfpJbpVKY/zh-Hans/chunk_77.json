[{"type": "subtitle", "time": 4620.709, "timestamp": "01:17:00", "text": "我尝试添加我的域名。它不"}, {"type": "subtitle", "time": 4623.11, "timestamp": "01:17:03", "text": "干活，伙计。"}, {"type": "subtitle", "time": 4627.75, "timestamp": "01:17:07", "text": "我尽力了。店铺。隔壁空间。"}, {"type": "subtitle", "time": 4645.03, "timestamp": "01:17:25", "text": "但是我们打算……我们打算……"}, {"type": "subtitle", "time": 4648.87, "timestamp": "01:17:28", "text": "商品即将到货。他"}, {"type": "subtitle", "time": 4657.99, "timestamp": "01:17:37", "text": "我很快就要开始卖商品了。他"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "我会要免费的。好的。就像"}, {"type": "subtitle", "time": 4661.75, "timestamp": "01:17:41", "text": "适用于手机的数字壁纸"}, {"type": "subtitle", "time": 4664.229, "timestamp": "01:17:44", "text": "一切。我会把所有东西都整理好。"}, {"type": "subtitle", "time": 4666.95, "timestamp": "01:17:46", "text": "店铺。"}, {"type": "subtitle", "time": 4670.63, "timestamp": "01:17:50", "text": "是的，我们会准备的。"}, {"type": "subtitle", "time": 4673.11, "timestamp": "01:17:53", "text": "[音乐]"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "希望一切顺利。诚实地，"}]
[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "忘了是哪个了。我忘了这是什么"}, {"type": "subtitle", "time": 5050.07, "timestamp": "01:24:10", "text": "七。哦，所以这将在……中出现。"}, {"type": "subtitle", "time": 5051.75, "timestamp": "01:24:11", "text": "冒险游戏。哦，对，对，那个"}, {"type": "subtitle", "time": 5054.149, "timestamp": "01:24:14", "text": "冒险游戏。我忘了这个。它是"}, {"type": "subtitle", "time": 5057.99, "timestamp": "01:24:17", "text": "一款已在Steam平台上发售的游戏。这个。"}, {"type": "subtitle", "time": 5061.51, "timestamp": "01:24:21", "text": "哦，我忘了。我把这件事忘了。"}, {"type": "subtitle", "time": 5064.709, "timestamp": "01:24:24", "text": "七个人被选中。所以我觉得"}, {"type": "subtitle", "time": 5068.39, "timestamp": "01:24:28", "text": "获胜者的作品本应在……"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "这部动画。不，它应该在……"}, {"type": "subtitle", "time": 5073.59, "timestamp": "01:24:33", "text": "游戏已经开始了。"}, {"type": "subtitle", "time": 5077.03, "timestamp": "01:24:37", "text": "太好了。不。"}, {"type": "subtitle", "time": 5082.31, "timestamp": "01:24:42", "text": "总之，我分心了。我们可以？嗯"}, {"type": "subtitle", "time": 5083.59, "timestamp": "01:24:43", "text": "[音乐]"}, {"type": "subtitle", "time": 5087.83, "timestamp": "01:24:47", "text": "你看，他们确实没有印度。"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "这里是国家"}, {"type": "subtitle", "time": 5091.73, "timestamp": "01:24:51", "text": "真糟糕。"}, {"type": "subtitle", "time": 5096.709, "timestamp": "01:24:56", "text": "[音乐]"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "好吧，我经常分心。呃"}]
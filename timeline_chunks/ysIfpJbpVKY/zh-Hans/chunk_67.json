[{"type": "subtitle", "time": 4023.029, "timestamp": "01:07:03", "text": "是的，我觉得对于印度来说就是如此。"}, {"type": "subtitle", "time": 4024.95, "timestamp": "01:07:04", "text": "卢比"}, {"type": "subtitle", "time": 4027.27, "timestamp": "01:07:07", "text": "鲁普"}, {"type": "subtitle", "time": 4029.589, "timestamp": "01:07:09", "text": "卢比。"}, {"type": "subtitle", "time": 4034.789, "timestamp": "01:07:14", "text": "是的，印度有卢比，马来西亚有马来西亚货币。"}, {"type": "subtitle", "time": 4038.47, "timestamp": "01:07:18", "text": "马来西亚货币不一样。"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "哦，铃声响了。"}, {"type": "subtitle", "time": 4042.789, "timestamp": "01:07:22", "text": "林古特"}, {"type": "subtitle", "time": 4046.549, "timestamp": "01:07:26", "text": "我的天，这不一样。"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "等待。"}, {"type": "subtitle", "time": 4053.43, "timestamp": "01:07:33", "text": "卢比。"}, {"type": "subtitle", "time": 4057.43, "timestamp": "01:07:37", "text": "啊，卢比。卢比亚。等等，是这个。"}, {"type": "subtitle", "time": 4060.71, "timestamp": "01:07:40", "text": "我见过这个印尼人。它不是"}, {"type": "subtitle", "time": 4063.109, "timestamp": "01:07:43", "text": "马来西亚人。这是印尼语。"}, {"type": "subtitle", "time": 4071.349, "timestamp": "01:07:51", "text": "哦，"}, {"type": "subtitle", "time": 4073.029, "timestamp": "01:07:53", "text": "RP。"}, {"type": "subtitle", "time": 4075.27, "timestamp": "01:07:55", "text": "RS还在哪里？"}, {"type": "subtitle", "time": 4077.56, "timestamp": "01:07:57", "text": "卢比？"}, {"type": "chat", "time": 4079.88, "timestamp": "01:07:59", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "sorry made a mistake"}]
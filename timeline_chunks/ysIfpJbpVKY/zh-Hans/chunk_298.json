[{"type": "subtitle", "time": 17880.15, "timestamp": "04:58:00", "text": "合作方积极主动"}, {"type": "subtitle", "time": 17883.51, "timestamp": "04:58:03", "text": "与他们的聊天对象交谈"}, {"type": "subtitle", "time": 17886.788, "timestamp": "04:58:06", "text": "其他聊天，比如不给……"}, {"type": "subtitle", "time": 17888.948, "timestamp": "04:58:08", "text": "致合作方："}, {"type": "subtitle", "time": 17892.788, "timestamp": "04:58:12", "text": "这也被认为是一种粗鲁的行为。"}, {"type": "subtitle", "time": 17895.19, "timestamp": "04:58:15", "text": "就合作精神而言"}, {"type": "subtitle", "time": 17899.19, "timestamp": "04:58:19", "text": "辞职就是因为人们往往会这样做"}, {"type": "subtitle", "time": 17901.59, "timestamp": "04:58:21", "text": "置顶一条消息，内容是“我，我们……”"}, {"type": "subtitle", "time": 17904.31, "timestamp": "04:58:24", "text": "我正在和某某进行合作直播"}, {"type": "subtitle", "time": 17906.628, "timestamp": "04:58:26", "text": "创作者，我无法重新发送那个"}, {"type": "subtitle", "time": 17908.788, "timestamp": "04:58:28", "text": "她自己也经常这样，"}, {"type": "subtitle", "time": 17911.51, "timestamp": "04:58:31", "text": "正确的？就像那条免责声明信息一样"}, {"type": "subtitle", "time": 17913.59, "timestamp": "04:58:33", "text": "这一点很重要，这样那些人就能……"}, {"type": "subtitle", "time": 17915.51, "timestamp": "04:58:35", "text": "观看你的观众是谁？"}, {"type": "subtitle", "time": 17918.55, "timestamp": "04:58:38", "text": "总是在那里，呃，那些习惯了你的人"}, {"type": "subtitle", "time": 17921.83, "timestamp": "04:58:41", "text": "积极回应那些习惯于你的人"}, {"type": "subtitle", "time": 17923.51, "timestamp": "04:58:43", "text": "真正对你的评论做出回应"}, {"type": "subtitle", "time": 17925.35, "timestamp": "04:58:45", "text": "一切。"}, {"type": "subtitle", "time": 17927.03, "timestamp": "04:58:47", "text": "他们会说：“哦，为什么Doc不在？”"}, {"type": "subtitle", "time": 17929.03, "timestamp": "04:58:49", "text": "听我说话就像看我读书一样。"}, {"type": "subtitle", "time": 17930.23, "timestamp": "04:58:50", "text": "评论之类的？”他们会收到"}, {"type": "subtitle", "time": 17932.55, "timestamp": "04:58:52", "text": "生气了之类的。就是这样。"}, {"type": "subtitle", "time": 17935.43, "timestamp": "04:58:55", "text": "这东西为什么会在这里？如果"}, {"type": "subtitle", "time": 17937.03, "timestamp": "04:58:57", "text": "你们有版主"}, {"type": "subtitle", "time": 17939.67, "timestamp": "04:58:59", "text": "渠道，他们也可以像……一样强制执行。"}]
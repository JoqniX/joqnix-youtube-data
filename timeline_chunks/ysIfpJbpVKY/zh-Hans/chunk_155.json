[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "我的天啊。好的。好的。 Twitch 原始数据。"}, {"type": "subtitle", "time": 9305.59, "timestamp": "02:35:05", "text": "我们添加了一个新的行绘制行数据触发器"}, {"type": "subtitle", "time": 9307.75, "timestamp": "02:35:07", "text": "为所有现有的 Twitch 带来价值"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "触发器。所以你，所以你，所以如果你想"}, {"type": "subtitle", "time": 9312.79, "timestamp": "02:35:12", "text": "要亲身接触数据，你"}, {"type": "subtitle", "time": 9315.91, "timestamp": "02:35:15", "text": "可以拥有所有自定义的 Twitch 内容，甚至包括订阅"}, {"type": "subtitle", "time": 9319.27, "timestamp": "02:35:19", "text": "触发器。等萨米等得不耐烦了"}, {"type": "subtitle", "time": 9321.59, "timestamp": "02:35:21", "text": "更新以创造一些很棒的东西"}, {"type": "subtitle", "time": 9323.11, "timestamp": "02:35:23", "text": "新的"}, {"type": "subtitle", "time": 9327.19, "timestamp": "02:35:27", "text": "哦，更快捷的命令相关命令"}, {"type": "subtitle", "time": 9329.75, "timestamp": "02:35:29", "text": "失败。直到……之前，不要再悬挂纽扣。"}, {"type": "subtitle", "time": 9332.469, "timestamp": "02:35:32", "text": "时间模数。相反，改为解决"}, {"type": "subtitle", "time": 9335.83, "timestamp": "02:35:35", "text": "立即与未定义内容一起。"}, {"type": "subtitle", "time": 9339.51, "timestamp": "02:35:39", "text": "呃，那么就是10万亿个虫子南瓜。不是"}, {"type": "subtitle", "time": 9341.99, "timestamp": "02:35:41", "text": "真的。我们请到了一些重量级人物。好的。"}, {"type": "chat", "time": 9344.029, "timestamp": "02:35:44", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "make the good good very good good"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "而且下载量更大。好的。让我看看"}, {"type": "subtitle", "time": 9347.91, "timestamp": "02:35:47", "text": "更新说明。等待。"}, {"type": "subtitle", "time": 9349.75, "timestamp": "02:35:49", "text": "等待。我想看看补丁卷起来的样子。"}, {"type": "subtitle", "time": 9351.59, "timestamp": "02:35:51", "text": "笔记。"}, {"type": "subtitle", "time": 9355.51, "timestamp": "02:35:55", "text": "快点。维瓦尔第勋爵。"}, {"type": "subtitle", "time": 9358.87, "timestamp": "02:35:58", "text": "我的天啊。那我直接复制一份就行了。"}]
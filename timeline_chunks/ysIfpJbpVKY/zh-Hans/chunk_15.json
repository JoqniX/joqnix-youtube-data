[{"type": "subtitle", "time": 902.87, "timestamp": "00:15:02", "text": "香水或身体香氛"}, {"type": "subtitle", "time": 905.509, "timestamp": "00:15:05", "text": "东西。还有一个比较轻便的，"}, {"type": "subtitle", "time": 909.509, "timestamp": "00:15:09", "text": "很重的东西等等。我从未知道"}, {"type": "subtitle", "time": 912.23, "timestamp": "00:15:12", "text": "香水也有分类。"}, {"type": "subtitle", "time": 914.55, "timestamp": "00:15:14", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 920.87, "timestamp": "00:15:20", "text": "打扰一下。"}, {"type": "subtitle", "time": 931.189, "timestamp": "00:15:31", "text": "嗯，是的，我不知道。"}, {"type": "subtitle", "time": 935.91, "timestamp": "00:15:35", "text": "我的回答当然是嗯……"}, {"type": "subtitle", "time": 939.269, "timestamp": "00:15:39", "text": "呃，就是任何有气味的东西。"}, {"type": "subtitle", "time": 942.55, "timestamp": "00:15:42", "text": "好的。我会用它。我没问题"}, {"type": "subtitle", "time": 944.629, "timestamp": "00:15:44", "text": "任何东西都可以。"}, {"type": "subtitle", "time": 948.389, "timestamp": "00:15:48", "text": "没关系。是的。"}, {"type": "subtitle", "time": 951.99, "timestamp": "00:15:51", "text": "呃，只要走路的人还在走路"}, {"type": "subtitle", "time": 954.949, "timestamp": "00:15:54", "text": "无论在我身后还是在我对面，他们都不会喜欢我。"}, {"type": "subtitle", "time": 957.91, "timestamp": "00:15:57", "text": "抓住他们的呃，就像试图阻止呃，就像"}, {"type": "subtitle", "time": 959.91, "timestamp": "00:15:59", "text": "捏着鼻子，转身就走。"}]
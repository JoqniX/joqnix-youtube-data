[{"type": "subtitle", "time": 8341.349, "timestamp": "02:19:01", "text": "快完成了。我快完成了。"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "和"}, {"type": "subtitle", "time": 8345.97, "timestamp": "02:19:05", "text": "这"}, {"type": "subtitle", "time": 8358.79, "timestamp": "02:19:18", "text": "好了，我们结束了。"}, {"type": "subtitle", "time": 8366.389, "timestamp": "02:19:26", "text": "让我仔细检查每一个角落"}, {"type": "subtitle", "time": 8369.99, "timestamp": "02:19:29", "text": "以及这个角落。所以，塔芒塔姆"}, {"type": "subtitle", "time": 8373.03, "timestamp": "02:19:33", "text": "仪式已正式举行。"}, {"type": "subtitle", "time": 8378.79, "timestamp": "02:19:38", "text": "我仍然不知道该怎么办"}, {"type": "subtitle", "time": 8381.589, "timestamp": "02:19:41", "text": "包含“呃呃”字样的目录"}, {"type": "subtitle", "time": 8384.309, "timestamp": "02:19:44", "text": "东西。那是另一个问题。"}, {"type": "subtitle", "time": 8387.83, "timestamp": "02:19:47", "text": "我必须面对。哦"}, {"type": "subtitle", "time": 8389.83, "timestamp": "02:19:49", "text": "但从某种意义上说，这件事已经完成了。我是"}]
[{"type": "subtitle", "time": 6661.75, "timestamp": "01:51:01", "text": "在类似拐角侧的末端"}, {"type": "subtitle", "time": 6664.31, "timestamp": "01:51:04", "text": "墙壁之类的东西。是的。他是"}, {"type": "subtitle", "time": 6666.229, "timestamp": "01:51:06", "text": "汪汪汪汪汪汪。"}, {"type": "subtitle", "time": 6668.95, "timestamp": "01:51:08", "text": "我当时就想：发生了什么事？"}, {"type": "subtitle", "time": 6671.669, "timestamp": "01:51:11", "text": "我看了看。它就像一个死人"}, {"type": "subtitle", "time": 6674.95, "timestamp": "01:51:14", "text": "苍蝇、虫子之类的东西。他的吠叫"}, {"type": "subtitle", "time": 6677.27, "timestamp": "01:51:17", "text": "它抓挠着，试图把它弄出来。"}, {"type": "subtitle", "time": 6679.43, "timestamp": "01:51:19", "text": "以及所有的一切，"}, {"type": "subtitle", "time": 6693.99, "timestamp": "01:51:33", "text": "就像有人抢劫时那样尖叫"}, {"type": "subtitle", "time": 6696.95, "timestamp": "01:51:36", "text": "房子之类的。"}, {"type": "subtitle", "time": 6705.75, "timestamp": "01:51:45", "text": "那是你发誓要做的事"}, {"type": "chat", "time": 6706.12, "timestamp": "01:51:46", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 6709.27, "timestamp": "01:51:49", "text": "我的天，真是不可思议。于是，我清理了……"}, {"type": "subtitle", "time": 6711.99, "timestamp": "01:51:51", "text": "全部。把所有的狗都赶走"}, {"type": "subtitle", "time": 6715.75, "timestamp": "01:51:55", "text": "头发什么的。清理干净了。你呃"}, {"type": "subtitle", "time": 6719.27, "timestamp": "01:51:59", "text": "用软管浇水冲洗。已清洗"}]
[{"type": "subtitle", "time": 1801.11, "timestamp": "00:30:01", "text": "页，"}, {"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "政策等等。是的。然后"}, {"type": "subtitle", "time": 1805.99, "timestamp": "00:30:05", "text": "我会申请。我必须做这件事"}, {"type": "subtitle", "time": 1807.59, "timestamp": "00:30:07", "text": "确认。"}, {"type": "subtitle", "time": 1810.149, "timestamp": "00:30:10", "text": "不，我得替补。我确实提交了我的"}, {"type": "subtitle", "time": 1811.669, "timestamp": "00:30:11", "text": "文件，"}, {"type": "chat", "time": 1816.137, "timestamp": "00:30:16", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "do you type this all on your own or did you have a lawyer with you"}, {"type": "subtitle", "time": 1816.149, "timestamp": "00:30:16", "text": "但我需要做一些视频验证"}, {"type": "subtitle", "time": 1818.31, "timestamp": "00:30:18", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "呃，"}, {"type": "subtitle", "time": 1821.909, "timestamp": "00:30:21", "text": "这些都是你自己打的吗？"}, {"type": "subtitle", "time": 1823.83, "timestamp": "00:30:23", "text": "你当时带了很多东西吗？我只是闲聊。"}, {"type": "subtitle", "time": 1825.99, "timestamp": "00:30:25", "text": "GPD。"}, {"type": "subtitle", "time": 1829.35, "timestamp": "00:30:29", "text": "我只是在用 GPT 聊天。所以，我试图做的是"}, {"type": "subtitle", "time": 1832.549, "timestamp": "00:30:32", "text": "我会尽量先起草一份草稿。"}, {"type": "subtitle", "time": 1835.909, "timestamp": "00:30:35", "text": "它。我对此一无所知。"}, {"type": "subtitle", "time": 1838.549, "timestamp": "00:30:38", "text": "这些东西其实跟商业有关。"}, {"type": "subtitle", "time": 1843.43, "timestamp": "00:30:43", "text": "或者呃，我自己全部起草。所以，我……"}, {"type": "subtitle", "time": 1845.99, "timestamp": "00:30:45", "text": "它。所以我接下来要做的事就像……"}, {"type": "subtitle", "time": 1848.549, "timestamp": "00:30:48", "text": "好了，就按指南来的。"}, {"type": "subtitle", "time": 1853.43, "timestamp": "00:30:53", "text": "我会把这一页交给一个会读的人。"}, {"type": "subtitle", "time": 1855.83, "timestamp": "00:30:55", "text": "比如指导方针等等"}, {"type": "subtitle", "time": 1858.07, "timestamp": "00:30:58", "text": "文件，例如正规律师或"}]
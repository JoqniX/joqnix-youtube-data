[{"type": "subtitle", "time": 12362.95, "timestamp": "03:26:02", "text": "是的。嗯，一般般。"}, {"type": "subtitle", "time": 12365.83, "timestamp": "03:26:05", "text": "呃，让我……说完。我花了多少钱？"}, {"type": "subtitle", "time": 12368.63, "timestamp": "03:26:08", "text": "再次尝试？我们现在讨论退款方式和"}, {"type": "subtitle", "time": 12375.19, "timestamp": "03:26:15", "text": "你们会销售哪些类型的商品？"}, {"type": "subtitle", "time": 12378.229, "timestamp": "03:26:18", "text": "我其实不知道，因为……我觉得"}, {"type": "subtitle", "time": 12380.469, "timestamp": "03:26:20", "text": "我正在考虑把它卖掉。"}, {"type": "subtitle", "time": 12384.389, "timestamp": "03:26:24", "text": "先在印度当地试试看效果如何。"}, {"type": "subtitle", "time": 12386.79, "timestamp": "03:26:26", "text": "走了。然后我会做国际版的。"}, {"type": "subtitle", "time": 12390.07, "timestamp": "03:26:30", "text": "因为我没有那种东西，嗯嗯"}, {"type": "subtitle", "time": 12392.79, "timestamp": "03:26:32", "text": "仓库或像所有这些公司一样"}, {"type": "subtitle", "time": 12395.269, "timestamp": "03:26:35", "text": "一些能帮到我的东西。不。嗯，我会"}, {"type": "subtitle", "time": 12397.99, "timestamp": "03:26:37", "text": "一切都得我自己做，对吧？"}, {"type": "subtitle", "time": 12401.83, "timestamp": "03:26:41", "text": "我自己打印，我自己发货。"}, {"type": "subtitle", "time": 12403.11, "timestamp": "03:26:43", "text": "正确的？"}, {"type": "subtitle", "time": 12407.03, "timestamp": "03:26:47", "text": "所以，我当时在想，嗯……现在我……"}, {"type": "subtitle", "time": 12410.07, "timestamp": "03:26:50", "text": "思考一些小事，比如……"}, {"type": "subtitle", "time": 12412.87, "timestamp": "03:26:52", "text": "贴纸包之类的东西，然后"}, {"type": "subtitle", "time": 12415.19, "timestamp": "03:26:55", "text": "钥匙链之类的东西，或者别针之类的"}, {"type": "subtitle", "time": 12419.51, "timestamp": "03:26:59", "text": "跟我那……呃……运动健将……呃……的东西有关。"}]
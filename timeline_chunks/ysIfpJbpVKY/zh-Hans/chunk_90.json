[{"type": "subtitle", "time": 5402.229, "timestamp": "01:30:02", "text": "Mel，因为我已经不再使用 OBS 了。"}, {"type": "subtitle", "time": 5405.99, "timestamp": "01:30:05", "text": "这个东西看起来有点模糊。我当时"}, {"type": "subtitle", "time": 5409.51, "timestamp": "01:30:09", "text": "我心想，不如现在就去做吧。"}, {"type": "subtitle", "time": 5412.31, "timestamp": "01:30:12", "text": "让我测试一下。好的，我试着检查了一下。"}, {"type": "subtitle", "time": 5415.189, "timestamp": "01:30:15", "text": "如果他们有方法在 API 中重新加载"}, {"type": "subtitle", "time": 5418.39, "timestamp": "01:30:18", "text": "浏览器。他们不这样做。我希望他们能增加"}, {"type": "subtitle", "time": 5421.59, "timestamp": "01:30:21", "text": "很快就会发生。但是，嗯，所以我想我"}, {"type": "subtitle", "time": 5425.83, "timestamp": "01:30:25", "text": "应该使用 meld"}, {"type": "subtitle", "time": 5428.629, "timestamp": "01:30:28", "text": "这个开关可以看到努力程度。这个"}, {"type": "subtitle", "time": 5432.149, "timestamp": "01:30:32", "text": "这个。所以场景名称应该是"}, {"type": "subtitle", "time": 5435.59, "timestamp": "01:30:35", "text": "赌博。图层名称应为"}, {"type": "subtitle", "time": 5437.83, "timestamp": "01:30:37", "text": "显示截图。"}, {"type": "subtitle", "time": 5442.629, "timestamp": "01:30:42", "text": "效果名称将是“啊，我看到你了”。"}, {"type": "subtitle", "time": 5445.83, "timestamp": "01:30:45", "text": "戈亚模糊。"}, {"type": "subtitle", "time": 5449.51, "timestamp": "01:30:49", "text": "哦，你不能重命名效果。"}, {"type": "subtitle", "time": 5452.47, "timestamp": "01:30:52", "text": "哦"}, {"type": "subtitle", "time": 5453.83, "timestamp": "01:30:53", "text": "等等等等。我想看看。我想要"}]
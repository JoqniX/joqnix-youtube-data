[{"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "我的天哪，我就是那种人。如果我看到一个"}, {"type": "subtitle", "time": 6553.43, "timestamp": "01:49:13", "text": "蝴蝶，我要去追它。"}, {"type": "subtitle", "time": 6555.99, "timestamp": "01:49:15", "text": "我最近也这么做过。我做过这件事。"}, {"type": "subtitle", "time": 6558.39, "timestamp": "01:49:18", "text": "最近。实际上"}, {"type": "subtitle", "time": 6560.87, "timestamp": "01:49:20", "text": "呃，当时我正要回房间。"}, {"type": "chat", "time": 6562.317, "timestamp": "01:49:22", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "ok offstream is a bit unacceptable 🤣"}, {"type": "subtitle", "time": 6564.39, "timestamp": "01:49:24", "text": "现在，呃，既然我必须……通过"}, {"type": "subtitle", "time": 6566.95, "timestamp": "01:49:26", "text": "现在要走到前门来找我"}, {"type": "subtitle", "time": 6570.79, "timestamp": "01:49:30", "text": "直播间。我在……看到了这只蝴蝶"}, {"type": "subtitle", "time": 6574.31, "timestamp": "01:49:34", "text": "就像朋友的那些地方。 U 那里就像"}, {"type": "subtitle", "time": 6576.709, "timestamp": "01:49:36", "text": "朋友家有一些植物之类的东西。"}, {"type": "subtitle", "time": 6579.669, "timestamp": "01:49:39", "text": "路边区域。是的。所以"}, {"type": "subtitle", "time": 6581.35, "timestamp": "01:49:41", "text": "看到一只蝴蝶在飞。我当时就想，"}, {"type": "subtitle", "time": 6583.43, "timestamp": "01:49:43", "text": "“好吧，我希望我当时是这么想的，‘好吧，我"}, {"type": "subtitle", "time": 6585.669, "timestamp": "01:49:45", "text": "我想仔细看看。"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "或许我会拿手机拍张照片。我"}, {"type": "subtitle", "time": 6591.91, "timestamp": "01:49:51", "text": "因为过去了，所以没拍到照片。"}, {"type": "subtitle", "time": 6594.39, "timestamp": "01:49:54", "text": "它走到了马路对面。"}]
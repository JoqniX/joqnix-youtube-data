[{"type": "subtitle", "time": 3662.309, "timestamp": "01:01:02", "text": "您保留了此物的所有权。所以"}, {"type": "subtitle", "time": 3665.349, "timestamp": "01:01:05", "text": "嗯，呃，我为什么要写政策页面？"}, {"type": "subtitle", "time": 3669.19, "timestamp": "01:01:09", "text": "我当时就想用 Razer Pay。"}, {"type": "subtitle", "time": 3671.99, "timestamp": "01:01:11", "text": "我需要正确完成二维码支付。"}, {"type": "subtitle", "time": 3675.43, "timestamp": "01:01:15", "text": "现在可以使用二维码进行UPI支付，对吧？"}, {"type": "subtitle", "time": 3678.63, "timestamp": "01:01:18", "text": "问题是，我目前用的UPI系统"}, {"type": "subtitle", "time": 3681.43, "timestamp": "01:01:21", "text": "有G Pay之类的东西，它会显示手机"}, {"type": "subtitle", "time": 3683.349, "timestamp": "01:01:23", "text": "即使它显示的是 Jocknik 的数字"}, {"type": "subtitle", "time": 3686.47, "timestamp": "01:01:26", "text": "银行名称像 Jocknik 的东西，但它"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "显示的电话号码，它认为我是……"}, {"type": "subtitle", "time": 3690.63, "timestamp": "01:01:30", "text": "实体店"}, {"type": "subtitle", "time": 3694.069, "timestamp": "01:01:34", "text": "我不想那样"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "数字是我的VTuber编号。"}, {"type": "subtitle", "time": 3702.63, "timestamp": "01:01:42", "text": "我"}, {"type": "subtitle", "time": 3710.23, "timestamp": "01:01:50", "text": "不希望人们滥用电话或"}, {"type": "subtitle", "time": 3711.99, "timestamp": "01:01:51", "text": "未来某件事。那将是"}, {"type": "subtitle", "time": 3719.03, "timestamp": "01:01:59", "text": "是的，你会单独准备一部手机吗？"}]
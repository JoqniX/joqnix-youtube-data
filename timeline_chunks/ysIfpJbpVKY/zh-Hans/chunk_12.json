[{"type": "subtitle", "time": 722.23, "timestamp": "00:12:02", "text": "正确的设计令牌。"}, {"type": "subtitle", "time": 724.47, "timestamp": "00:12:04", "text": "所以如果我需要更改任何东西，比如"}, {"type": "subtitle", "time": 726.71, "timestamp": "00:12:06", "text": "我能做的只是一点小小的改变"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "换成其中一个，一切就都好了。"}, {"type": "subtitle", "time": 732.55, "timestamp": "00:12:12", "text": "否则将进行更改"}, {"type": "subtitle", "time": 737.509, "timestamp": "00:12:17", "text": "所有页面都是这样。是的。所以，所以"}, {"type": "subtitle", "time": 739.509, "timestamp": "00:12:19", "text": "我们可能会收集以下物品"}, {"type": "subtitle", "time": 743.59, "timestamp": "00:12:23", "text": "这里。我觉得正文已经写好了。"}, {"type": "subtitle", "time": 745.35, "timestamp": "00:12:25", "text": "有。"}, {"type": "subtitle", "time": 747.829, "timestamp": "00:12:27", "text": "好的。那这个人呢？它"}, {"type": "subtitle", "time": 750.87, "timestamp": "00:12:30", "text": "已经有了。你已经拥有它了。什么"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "你呢？你没有。粘贴。"}, {"type": "subtitle", "time": 759.19, "timestamp": "00:12:39", "text": "Cookie 和跟踪。"}, {"type": "subtitle", "time": 761.59, "timestamp": "00:12:41", "text": "是的。你也没有。没有任何"}, {"type": "subtitle", "time": 764.15, "timestamp": "00:12:44", "text": "那里。"}, {"type": "chat", "time": 766.018, "timestamp": "00:12:46", "author": "@cls_c69", "avatar": "https://yt4.ggpht.com/1xH00l4co0AqxQmOLp2YF4nFFs-UBbNlpq_DoiGUhLHz03uM5S1Zs8RwEOVwnKpZAX9wM3P_Zg=s64-c-k-c0x00ffffff-no-rj", "message": "what is your favorite perfume?"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "嗯，"}, {"type": "subtitle", "time": 770.71, "timestamp": "00:12:50", "text": "这一切。你最喜欢的香水是什么？"}, {"type": "subtitle", "time": 773.03, "timestamp": "00:12:53", "text": "什么？我的天，这真是个莫名其妙的怪事"}, {"type": "subtitle", "time": 777.269, "timestamp": "00:12:57", "text": "我以前从未遇到过这个问题。嗯"}, {"type": "subtitle", "time": 779.35, "timestamp": "00:12:59", "text": "H"}]
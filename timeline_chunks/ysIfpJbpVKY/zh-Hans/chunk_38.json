[{"type": "subtitle", "time": 2281.349, "timestamp": "00:38:01", "text": "这个有。好的。你有吗？"}, {"type": "subtitle", "time": 2283.51, "timestamp": "00:38:03", "text": "你？"}, {"type": "subtitle", "time": 2286.63, "timestamp": "00:38:06", "text": "哦。哦，我看到罪魁祸首了。你没有"}, {"type": "subtitle", "time": 2288.55, "timestamp": "00:38:08", "text": "那个东西。"}, {"type": "subtitle", "time": 2291.109, "timestamp": "00:38:11", "text": "所以，列表项。"}, {"type": "subtitle", "time": 2294.55, "timestamp": "00:38:14", "text": "H：你呢？好的。这个人也"}, {"type": "subtitle", "time": 2297.75, "timestamp": "00:38:17", "text": "没有列表项。好的。"}, {"type": "subtitle", "time": 2300.95, "timestamp": "00:38:20", "text": "真奇怪。"}, {"type": "subtitle", "time": 2303.829, "timestamp": "00:38:23", "text": "哦，等等。我从别处复制的。"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "正确的？圣。等待。"}, {"type": "subtitle", "time": 2310.15, "timestamp": "00:38:30", "text": "我想我知道罪魁祸首是谁了。"}, {"type": "subtitle", "time": 2313.51, "timestamp": "00:38:33", "text": "是你。难道不是吗？你在哪里？它是"}, {"type": "subtitle", "time": 2316.63, "timestamp": "00:38:36", "text": "对，就是这些人。"}, {"type": "subtitle", "time": 2319.27, "timestamp": "00:38:39", "text": "是的，这些人没有那种东西。那是"}, {"type": "subtitle", "time": 2321.349, "timestamp": "00:38:41", "text": "为什么。"}, {"type": "subtitle", "time": 2324.55, "timestamp": "00:38:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "[音乐]"}, {"type": "subtitle", "time": 2336.87, "timestamp": "00:38:56", "text": "所以，在列表项中，第二个列表"}]
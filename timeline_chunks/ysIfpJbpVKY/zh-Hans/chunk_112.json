[{"type": "subtitle", "time": 6722.629, "timestamp": "01:52:02", "text": "它。知道了。而那个笨蛋就像"}, {"type": "subtitle", "time": 6726.31, "timestamp": "01:52:06", "text": "它想咬我。别咬我。喜欢"}, {"type": "subtitle", "time": 6729.109, "timestamp": "01:52:09", "text": "试图咬住扫帚柄。"}, {"type": "chat", "time": 6729.201, "timestamp": "01:52:09", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "whats this about a worm"}, {"type": "subtitle", "time": 6732.39, "timestamp": "01:52:12", "text": "我的天哪。"}, {"type": "subtitle", "time": 6734.229, "timestamp": "01:52:14", "text": "这是关于……的，好像……"}, {"type": "subtitle", "time": 6737.99, "timestamp": "01:52:17", "text": "蠕虫或类似死昆虫的东西"}, {"type": "chat", "time": 6739.586, "timestamp": "01:52:19", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "ayo"}, {"type": "subtitle", "time": 6740.39, "timestamp": "01:52:20", "text": "狗窝"}, {"type": "subtitle", "time": 6744.149, "timestamp": "01:52:24", "text": "嗯，在墙角，还有我"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "他当时正在尝试，对着它狂吠不止。"}, {"type": "subtitle", "time": 6749.83, "timestamp": "01:52:29", "text": "我当时想，“好吧，我进去吧。”"}, {"type": "subtitle", "time": 6752.95, "timestamp": "01:52:32", "text": "把娃娃屋拿出来，然后试着把它弄出来。”"}, {"type": "subtitle", "time": 6756.229, "timestamp": "01:52:36", "text": "把整个地方都清理干净了。是的，这是最好的。"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "彻底清理一下狗窝……嗯……"}, {"type": "subtitle", "time": 6762.79, "timestamp": "01:52:42", "text": "他没被冷落。一旦他像"}, {"type": "subtitle", "time": 6765.51, "timestamp": "01:52:45", "text": "嗯，被锁链拴在……你叫什么来着？"}, {"type": "subtitle", "time": 6769.51, "timestamp": "01:52:49", "text": "它？呃，附近的杆子和东西，呃，在"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "车棚区域。"}, {"type": "subtitle", "time": 6775.99, "timestamp": "01:52:55", "text": "是啊，因为那会很痛苦。他没有"}, {"type": "subtitle", "time": 6778.55, "timestamp": "01:52:58", "text": "比如，他也讨厌水。"}]
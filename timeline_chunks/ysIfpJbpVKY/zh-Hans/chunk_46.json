[{"type": "subtitle", "time": 2760.79, "timestamp": "00:46:00", "text": "升起的泪水。哦，等等。已经"}, {"type": "subtitle", "time": 2763.43, "timestamp": "00:46:03", "text": "就在那儿。其中有一首歌"}, {"type": "subtitle", "time": 2766.23, "timestamp": "00:46:06", "text": "他曾经寄给我的"}, {"type": "subtitle", "time": 2769.75, "timestamp": "00:46:09", "text": "我忘了在直播中展示它。"}, {"type": "subtitle", "time": 2772.15, "timestamp": "00:46:12", "text": "我当时完全沉浸在各种无关的事情中……"}, {"type": "subtitle", "time": 2773.73, "timestamp": "00:46:13", "text": "我竟然忘了。"}, {"type": "subtitle", "time": 2775.67, "timestamp": "00:46:15", "text": "[音乐]"}, {"type": "subtitle", "time": 2794.55, "timestamp": "00:46:34", "text": "未找到音轨。没有。你删除了吗？"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "它？"}, {"type": "subtitle", "time": 2798.55, "timestamp": "00:46:38", "text": "第六版。"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "原本应该是11号，但是"}, {"type": "subtitle", "time": 2808.95, "timestamp": "00:46:48", "text": "[音乐]"}, {"type": "subtitle", "time": 2811.349, "timestamp": "00:46:51", "text": "呃，"}, {"type": "subtitle", "time": 2813.51, "timestamp": "00:46:53", "text": "让我暂时把屏幕调暗一下。我"}, {"type": "subtitle", "time": 2816.71, "timestamp": "00:46:56", "text": "刚刚收到谷歌的邮件。"}]
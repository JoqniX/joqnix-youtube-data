[{"type": "subtitle", "time": 10324.389, "timestamp": "02:52:04", "text": "是的，你可以，我想我会直播的。"}, {"type": "subtitle", "time": 10328.63, "timestamp": "02:52:08", "text": "我就像个男人一样，在直播里做这件事"}, {"type": "subtitle", "time": 10331.51, "timestamp": "02:52:11", "text": "就像我尝试包装商品一样。"}, {"type": "subtitle", "time": 10333.83, "timestamp": "02:52:13", "text": "一切以及所有那些景象"}, {"type": "subtitle", "time": 10336.63, "timestamp": "02:52:16", "text": "东西。"}, {"type": "subtitle", "time": 10338.63, "timestamp": "02:52:18", "text": "我的天啊。"}, {"type": "subtitle", "time": 10342.389, "timestamp": "02:52:22", "text": "想到这件事我就觉得好开心啊"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "那真是太好了。不。"}, {"type": "subtitle", "time": 10348.55, "timestamp": "02:52:28", "text": "而且你不仅能看到我，呃"}, {"type": "subtitle", "time": 10351.59, "timestamp": "02:52:31", "text": "为您准备一份订单，该订单正在运送"}, {"type": "subtitle", "time": 10353.99, "timestamp": "02:52:33", "text": "当你有事要办的时候，我会来找你。"}, {"type": "subtitle", "time": 10356.389, "timestamp": "02:52:36", "text": "把它拿到手里。您还可以看到"}, {"type": "subtitle", "time": 10364.95, "timestamp": "02:52:44", "text": "我的天哪，那真是太好了。"}, {"type": "subtitle", "time": 10367.19, "timestamp": "02:52:47", "text": "等不及了。"}, {"type": "subtitle", "time": 10370.11, "timestamp": "02:52:50", "text": "你是否曾期盼过那一天的到来？"}]
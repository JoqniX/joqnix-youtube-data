[{"type": "subtitle", "time": 5343.03, "timestamp": "01:29:03", "text": "所以，我不应该违背那个承诺。"}, {"type": "subtitle", "time": 5345.669, "timestamp": "01:29:05", "text": "哇，我犒劳了自己！"}, {"type": "subtitle", "time": 5348.87, "timestamp": "01:29:08", "text": "正确的？如果我弄坏了，那就糟了。所以，我"}, {"type": "subtitle", "time": 5352.55, "timestamp": "01:29:12", "text": "我必须确保不会破坏它。"}, {"type": "subtitle", "time": 5355.75, "timestamp": "01:29:15", "text": "尤其是我用的是自己的钱。我"}, {"type": "subtitle", "time": 5361.27, "timestamp": "01:29:21", "text": "看来我是不会碰运动员的钱了。"}, {"type": "subtitle", "time": 5363.27, "timestamp": "01:29:23", "text": "因为我必须确保我必须"}, {"type": "subtitle", "time": 5365.83, "timestamp": "01:29:25", "text": "确保我现在不会滥用它，因为"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "现在这笔钱是你们的了。所以我不得不"}, {"type": "subtitle", "time": 5383.83, "timestamp": "01:29:43", "text": "释放自我。你好。我不会那样做。"}, {"type": "subtitle", "time": 5385.669, "timestamp": "01:29:45", "text": "是的。我必须确保我不会这样做"}, {"type": "subtitle", "time": 5393.91, "timestamp": "01:29:53", "text": "说话就像让我把这件事说完一样"}, {"type": "subtitle", "time": 5395.75, "timestamp": "01:29:55", "text": "然后我会做点什么。好的，我有"}, {"type": "subtitle", "time": 5399.35, "timestamp": "01:29:59", "text": "一个想法。我现在有这个模糊的东西"}]
[{"type": "subtitle", "time": 2041.59, "timestamp": "00:34:01", "text": "是的，我可以问他们，但是为此我"}, {"type": "subtitle", "time": 2044.549, "timestamp": "00:34:04", "text": "我必须和他们交朋友，否则我可以放手。"}, {"type": "subtitle", "time": 2048.23, "timestamp": "00:34:08", "text": "爸爸帮我做这件事，因为他们了解我"}, {"type": "subtitle", "time": 2049.75, "timestamp": "00:34:09", "text": "爸爸"}, {"type": "subtitle", "time": 2054.069, "timestamp": "00:34:14", "text": "因为他是他们的土地所有者。"}, {"type": "subtitle", "time": 2056.31, "timestamp": "00:34:16", "text": "是的，我得自己动手。"}, {"type": "subtitle", "time": 2058.55, "timestamp": "00:34:18", "text": "现在，因为这是我的爱好。我不应该"}, {"type": "subtitle", "time": 2061.51, "timestamp": "00:34:21", "text": "我太依赖家人了。"}, {"type": "subtitle", "time": 2064.55, "timestamp": "00:34:24", "text": "所以，明年我就会过上……"}, {"type": "subtitle", "time": 2067.829, "timestamp": "00:34:27", "text": "我独自一人，现在在日本。我有"}, {"type": "subtitle", "time": 2070.31, "timestamp": "00:34:30", "text": "我必须自己完成所有事情。"}, {"type": "subtitle", "time": 2072.389, "timestamp": "00:34:32", "text": "内向者。"}, {"type": "subtitle", "time": 2087.19, "timestamp": "00:34:47", "text": "我觉得我拿到了大部分东西，或者"}, {"type": "subtitle", "time": 2088.79, "timestamp": "00:34:48", "text": "凯"}, {"type": "subtitle", "time": 2092.47, "timestamp": "00:34:52", "text": "不，它并不坏，虽然它有"}, {"type": "subtitle", "time": 2095.51, "timestamp": "00:34:55", "text": "你需要的一切"}, {"type": "subtitle", "time": 2098.79, "timestamp": "00:34:58", "text": "但我感觉"}, {"type": "chat", "time": 2099.097, "timestamp": "00:34:59", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "imagine a world where legall advise wouldnt take a year off your life span"}]
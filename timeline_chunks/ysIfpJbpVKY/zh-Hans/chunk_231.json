[{"type": "subtitle", "time": 13863.51, "timestamp": "03:51:03", "text": "我曾想过提交我的声音。"}, {"type": "subtitle", "time": 13865.91, "timestamp": "03:51:05", "text": "我考虑过提交我的声音，所以我"}, {"type": "subtitle", "time": 13867.67, "timestamp": "03:51:07", "text": "如果我能免费得到它之类的东西，我"}, {"type": "subtitle", "time": 13870.389, "timestamp": "03:51:10", "text": "想"}, {"type": "subtitle", "time": 13873.429, "timestamp": "03:51:13", "text": "然后我意识到它存在的问题，比如"}, {"type": "subtitle", "time": 13875.67, "timestamp": "03:51:15", "text": "我会"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "是的，我想过申请。"}, {"type": "subtitle", "time": 13880.469, "timestamp": "03:51:20", "text": "然后我表达了自己的意见"}, {"type": "subtitle", "time": 13883.11, "timestamp": "03:51:23", "text": "意识到不，我不应该，我必须这么做。"}, {"type": "subtitle", "time": 13886.63, "timestamp": "03:51:26", "text": "未来要处理这么多问题"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "即使我想把它撤下来，如果我"}, {"type": "subtitle", "time": 13892.469, "timestamp": "03:51:32", "text": "不想买或者你知道的"}, {"type": "subtitle", "time": 13894.79, "timestamp": "03:51:34", "text": "是的，我意识到那是一个很大的缺点。"}, {"type": "subtitle", "time": 13896.87, "timestamp": "03:51:36", "text": "事物。"}, {"type": "subtitle", "time": 13898.95, "timestamp": "03:51:38", "text": "哦，难道你没有吗？看看这个。他们"}, {"type": "subtitle", "time": 13900.87, "timestamp": "03:51:40", "text": "提供了他们的公司注册信息"}, {"type": "subtitle", "time": 13904.309, "timestamp": "03:51:44", "text": "数字，一切。"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "太酷了！哦，他们有退款政策。"}, {"type": "subtitle", "time": 13915.189, "timestamp": "03:51:55", "text": "[音乐]"}, {"type": "subtitle", "time": 13918.71, "timestamp": "03:51:58", "text": "他们有自己的CEO之类的。商业"}]
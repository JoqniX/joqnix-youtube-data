[{"type": "subtitle", "time": 3541.829, "timestamp": "00:59:01", "text": "我昨天昏倒了，醒来时……"}, {"type": "subtitle", "time": 3545.27, "timestamp": "00:59:05", "text": "凌晨3点到4点，然后我就睡着了。"}, {"type": "subtitle", "time": 3547.75, "timestamp": "00:59:07", "text": "又一次，早上6点醒了。还没有"}, {"type": "subtitle", "time": 3550.39, "timestamp": "00:59:10", "text": "睡着了。圣。"}, {"type": "subtitle", "time": 3553.03, "timestamp": "00:59:13", "text": "是的。再见。"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "我的天啊。"}, {"type": "subtitle", "time": 3564.87, "timestamp": "00:59:24", "text": "你在干什么？"}, {"type": "subtitle", "time": 3567.67, "timestamp": "00:59:27", "text": "你为什么还没睡？"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "是的，感觉不舒服的时候就应该睡觉。"}, {"type": "subtitle", "time": 3572.95, "timestamp": "00:59:32", "text": "困。祝你好运。"}, {"type": "subtitle", "time": 3582.63, "timestamp": "00:59:42", "text": "好的，从现在开始我们需要……"}, {"type": "subtitle", "time": 3585.43, "timestamp": "00:59:45", "text": "改一下，对吧？用户提交和"}, {"type": "subtitle", "time": 3587.51, "timestamp": "00:59:47", "text": "互动。"}, {"type": "subtitle", "time": 3589.51, "timestamp": "00:59:49", "text": "我不喜欢晚上睡觉。哦，我的"}, {"type": "subtitle", "time": 3591.109, "timestamp": "00:59:51", "text": "上帝，"}, {"type": "subtitle", "time": 3594.069, "timestamp": "00:59:54", "text": "你说的这话听起来像个夜晚"}, {"type": "subtitle", "time": 3595.589, "timestamp": "00:59:55", "text": "猫头鹰。"}]
[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "你照做了，然后你请律师……"}, {"type": "subtitle", "time": 1923.83, "timestamp": "00:32:03", "text": "检查一下，校对一下，对吧？我不"}, {"type": "chat", "time": 1925.918, "timestamp": "00:32:05", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "ya true"}, {"type": "subtitle", "time": 1926.549, "timestamp": "00:32:06", "text": "知道。是的，我也是这样。"}, {"type": "subtitle", "time": 1928.71, "timestamp": "00:32:08", "text": "想想该怎么做"}, {"type": "subtitle", "time": 1931.19, "timestamp": "00:32:11", "text": "因为会很贵。拥有"}, {"type": "subtitle", "time": 1934.789, "timestamp": "00:32:14", "text": "律师费和其他费用太贵了。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "他们是那种爱开玩笑的人。我真的"}, {"type": "subtitle", "time": 1940.31, "timestamp": "00:32:20", "text": "附近有律师事务所吗？"}, {"type": "subtitle", "time": 1943.669, "timestamp": "00:32:23", "text": "门。就像隔壁房间真的就是"}, {"type": "subtitle", "time": 1946.07, "timestamp": "00:32:26", "text": "律师的职位。"}, {"type": "subtitle", "time": 1949.43, "timestamp": "00:32:29", "text": "我不知道他们是否真的会做所有这些事。"}, {"type": "subtitle", "time": 1953.509, "timestamp": "00:32:33", "text": "网络内容。我的意思是，嗯，你知道的"}, {"type": "subtitle", "time": 1955.669, "timestamp": "00:32:35", "text": "律师们，当他们尝试的时候"}, {"type": "subtitle", "time": 1958.47, "timestamp": "00:32:38", "text": "他们先来查看房间。"}, {"type": "subtitle", "time": 1960.07, "timestamp": "00:32:40", "text": "以及他们办公室所需的一切"}, {"type": "subtitle", "time": 1963.19, "timestamp": "00:32:43", "text": "他们看到了我直播间的布置。"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "以及所有的一切。他们当时就说，哦，是啊。"}, {"type": "subtitle", "time": 1967.11, "timestamp": "00:32:47", "text": "我们也可以"}, {"type": "subtitle", "time": 1969.83, "timestamp": "00:32:49", "text": "他们就像我们也可以一样"}, {"type": "subtitle", "time": 1972.95, "timestamp": "00:32:52", "text": "我们有很多电脑，并且得到了我们的 Chad GPT"}, {"type": "subtitle", "time": 1976.23, "timestamp": "00:32:56", "text": "一些小玩意儿之类的。我当时就想，咦，等等，我"}, {"type": "subtitle", "time": 1978.23, "timestamp": "00:32:58", "text": "我还以为你们都是律师呢。什么"}]
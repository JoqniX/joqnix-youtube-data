[{"type": "subtitle", "time": 5522.39, "timestamp": "01:32:02", "text": "没错。请告诉我那不是真的"}, {"type": "subtitle", "time": 5527.99, "timestamp": "01:32:07", "text": "再见。"}, {"type": "subtitle", "time": 5535.43, "timestamp": "01:32:15", "text": "哦，对，我们需要那个增强功能。"}, {"type": "subtitle", "time": 5539.91, "timestamp": "01:32:19", "text": "正确的？好久不见了。我也有一个。"}, {"type": "subtitle", "time": 5543.91, "timestamp": "01:32:23", "text": "哦，他以前经常在2020年关注我，就像这样"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "很久以前。如果有人曾经是"}, {"type": "subtitle", "time": 5549.59, "timestamp": "01:32:29", "text": "回想过去，我曾经拥有一个"}, {"type": "subtitle", "time": 5553.51, "timestamp": "01:32:33", "text": "增强功能。它放大到我的脸上。"}, {"type": "subtitle", "time": 5556.55, "timestamp": "01:32:36", "text": "我说的是增强。"}, {"type": "subtitle", "time": 5560.95, "timestamp": "01:32:40", "text": "我以前用语音攻击来……"}, {"type": "subtitle", "time": 5562.87, "timestamp": "01:32:42", "text": "使其能够检测到我说过的话"}, {"type": "chat", "time": 5564.115, "timestamp": "01:32:44", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "perhaps AI is scary😨"}, {"type": "subtitle", "time": 5566.229, "timestamp": "01:32:46", "text": "增强词语和"}, {"type": "subtitle", "time": 5569.03, "timestamp": "01:32:49", "text": "它会触发那个东西。"}, {"type": "subtitle", "time": 5573.75, "timestamp": "01:32:53", "text": "在 Sammy 中，它像一个快捷键，比如控制键。"}, {"type": "subtitle", "time": 5575.83, "timestamp": "01:32:55", "text": "转移"}, {"type": "subtitle", "time": 5578.95, "timestamp": "01:32:58", "text": "控制换挡，呃，全部变成一个之类的。"}]
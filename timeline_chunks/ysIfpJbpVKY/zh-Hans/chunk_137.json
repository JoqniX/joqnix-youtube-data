[{"type": "subtitle", "time": 8220.469, "timestamp": "02:17:00", "text": "网站相关的东西？不。我最初想的是"}, {"type": "subtitle", "time": 8223.27, "timestamp": "02:17:03", "text": "把它放在 Onexia 页面上，就像这样"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "我自己和一切。然后我意识到，"}, {"type": "subtitle", "time": 8227.509, "timestamp": "02:17:07", "text": "是的，喜欢不同的事物更好。"}, {"type": "subtitle", "time": 8230.629, "timestamp": "02:17:10", "text": "把它们俩分开，对吧？"}, {"type": "subtitle", "time": 8232.629, "timestamp": "02:17:12", "text": "那是我倾注心血的项目，而我……"}, {"type": "subtitle", "time": 8234.549, "timestamp": "02:17:14", "text": "我是创建者，所以我必须拥有自己的页面"}, {"type": "subtitle", "time": 8240.93, "timestamp": "02:17:20", "text": "太多了"}, {"type": "subtitle", "time": 8267.99, "timestamp": "02:17:47", "text": "等等，你知道吗？我打算这样做"}, {"type": "subtitle", "time": 8270.87, "timestamp": "02:17:50", "text": "这次合并。我希望你们将两者合并。"}, {"type": "subtitle", "time": 8273.03, "timestamp": "02:17:53", "text": "他们。"}]
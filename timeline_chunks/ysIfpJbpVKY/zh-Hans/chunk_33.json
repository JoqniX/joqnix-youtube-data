[{"type": "subtitle", "time": 1980.789, "timestamp": "00:33:00", "text": "你的意思是说，chaji 同情和分享者"}, {"type": "subtitle", "time": 1983.509, "timestamp": "00:33:03", "text": "东西？问号。"}, {"type": "subtitle", "time": 1984.95, "timestamp": "00:33:04", "text": "我不知道。他说了类似这样的话"}, {"type": "subtitle", "time": 1987.269, "timestamp": "00:33:07", "text": "那。那里的一位律师就像……"}, {"type": "subtitle", "time": 1990.95, "timestamp": "00:33:10", "text": "三个或三个。是三个吗？呃，两个和"}, {"type": "subtitle", "time": 1994.23, "timestamp": "00:33:14", "text": "我想那里有三位律师。然后"}, {"type": "subtitle", "time": 1996.389, "timestamp": "00:33:16", "text": "其他所有工作人员"}, {"type": "subtitle", "time": 1999.19, "timestamp": "00:33:19", "text": "大概三个小时后就到了"}, {"type": "subtitle", "time": 2002.389, "timestamp": "00:33:22", "text": "现在是7点30分。不，他们会在10点左右到。"}, {"type": "subtitle", "time": 2005.83, "timestamp": "00:33:25", "text": "或者早上9点。所以其他人也像这样"}, {"type": "subtitle", "time": 2008.71, "timestamp": "00:33:28", "text": "我想应该是实习生吧。"}, {"type": "subtitle", "time": 2011.029, "timestamp": "00:33:31", "text": "是的。是的。然后还有清洁工作。"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "女士也一样。嗯，我想是的，工作人员"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "成员。然后他们都会在9点或10点左右到。"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "为……做好一切准备"}, {"type": "subtitle", "time": 2025.029, "timestamp": "00:33:45", "text": "律师，主要律师，其中三位"}, {"type": "subtitle", "time": 2029.509, "timestamp": "00:33:49", "text": "他们实际上是在晚上来的，之后"}, {"type": "subtitle", "time": 2034.23, "timestamp": "00:33:54", "text": "嗯，就是法庭那边的事儿。"}, {"type": "subtitle", "time": 2038.95, "timestamp": "00:33:58", "text": "[音乐]"}]
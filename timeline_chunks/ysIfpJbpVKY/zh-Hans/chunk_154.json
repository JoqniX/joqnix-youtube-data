[{"type": "subtitle", "time": 9243.11, "timestamp": "02:34:03", "text": "哦，有新更新了。 Sammy 最新消息。"}, {"type": "subtitle", "time": 9246.23, "timestamp": "02:34:06", "text": "好的，我们来读一下。萨米又出新角色了"}, {"type": "subtitle", "time": 9247.429, "timestamp": "02:34:07", "text": "更新。等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 9251.27, "timestamp": "02:34:11", "text": "等待。更新日期版本 25 2025.2.0"}, {"type": "subtitle", "time": 9254.79, "timestamp": "02:34:14", "text": "已退出。我们收到了大量的爱，"}, {"type": "subtitle", "time": 9256.71, "timestamp": "02:34:16", "text": "这是迄今为止付出的最大努力。我们说"}, {"type": "subtitle", "time": 9258.79, "timestamp": "02:34:18", "text": "每次都这样，但我们发誓"}, {"type": "subtitle", "time": 9260.95, "timestamp": "02:34:20", "text": "没错。情况只会越来越好。"}, {"type": "subtitle", "time": 9262.87, "timestamp": "02:34:22", "text": "更好的。新增内容太多了，"}, {"type": "subtitle", "time": 9264.389, "timestamp": "02:34:24", "text": "变革，以及推动变革的总体努力"}, {"type": "subtitle", "time": 9266.71, "timestamp": "02:34:26", "text": "萨米朝那个方向走去。努力工作"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "提供对新用户更友好的程序"}, {"type": "subtitle", "time": 9271.51, "timestamp": "02:34:31", "text": "退伍军人。重点关注那些实力强劲的球员"}, {"type": "subtitle", "time": 9273.51, "timestamp": "02:34:33", "text": "这篇文章。"}, {"type": "subtitle", "time": 9276.469, "timestamp": "02:34:36", "text": "异步到同步。超过30条指令"}, {"type": "subtitle", "time": 9279.67, "timestamp": "02:34:39", "text": "改为支持同步行为"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "使其像其他命令一样工作。哦，"}, {"type": "subtitle", "time": 9286.469, "timestamp": "02:34:46", "text": "快速酒吧升级。快捷栏现在有"}, {"type": "subtitle", "time": 9288.55, "timestamp": "02:34:48", "text": "几个用于添加常用功能的新按钮"}, {"type": "subtitle", "time": 9291.91, "timestamp": "02:34:51", "text": "访问权限，但命令以及拥有"}, {"type": "subtitle", "time": 9294.95, "timestamp": "02:34:54", "text": "上下文相关的按钮，仅用于"}, {"type": "subtitle", "time": 9297.99, "timestamp": "02:34:57", "text": "显示在“哦”下方"}]
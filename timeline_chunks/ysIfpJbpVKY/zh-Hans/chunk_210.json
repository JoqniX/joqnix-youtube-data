[{"type": "subtitle", "time": 12602.95, "timestamp": "03:30:02", "text": "猜测。没错，那可是一大笔钱。"}, {"type": "subtitle", "time": 12607.349, "timestamp": "03:30:07", "text": "嗯，到目前为止，我已经成功登录了我的Twitch频道。"}, {"type": "subtitle", "time": 12609.19, "timestamp": "03:30:09", "text": "YouTube。 YouTube 我还在等"}, {"type": "subtitle", "time": 12612.469, "timestamp": "03:30:12", "text": "它。 Twitch 收益分成。我得到了它。呃，所以我当时"}, {"type": "subtitle", "time": 12614.389, "timestamp": "03:30:14", "text": "因为我有一家正规的银行"}, {"type": "subtitle", "time": 12617.99, "timestamp": "03:30:17", "text": "现在要考虑运动员，接下来我们可以考虑运动员。"}, {"type": "subtitle", "time": 12621.11, "timestamp": "03:30:21", "text": "把钱放在那里。所以我在想"}, {"type": "subtitle", "time": 12623.349, "timestamp": "03:30:23", "text": "因为……目标尚未达成。"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "好的。我想到的是发布"}, {"type": "subtitle", "time": 12629.11, "timestamp": "03:30:29", "text": "看看周边产品的效果如何。如果每个人"}, {"type": "subtitle", "time": 12631.75, "timestamp": "03:30:31", "text": "呃，前提是人们愿意购买。"}, {"type": "subtitle", "time": 12634.309, "timestamp": "03:30:34", "text": "如果需求量很大，那么我会"}, {"type": "subtitle", "time": 12636.469, "timestamp": "03:30:36", "text": "带上更多物品，一切投资"}, {"type": "subtitle", "time": 12642.15, "timestamp": "03:30:42", "text": "更多相关内容等等。是的。希望如此，我"}, {"type": "subtitle", "time": 12644.389, "timestamp": "03:30:44", "text": "希望我至少能买得起我的型号。"}, {"type": "subtitle", "time": 12648.309, "timestamp": "03:30:48", "text": "把东西拿出来，首发，然后偿还贷款"}, {"type": "subtitle", "time": 12650.15, "timestamp": "03:30:50", "text": "嗯"}, {"type": "subtitle", "time": 12653.19, "timestamp": "03:30:53", "text": "支付许可证和许可问题的费用"}, {"type": "subtitle", "time": 12655.59, "timestamp": "03:30:55", "text": "以及所有的一切。所有合同和保密协议"}, {"type": "subtitle", "time": 12658.469, "timestamp": "03:30:58", "text": "我正在处理一些我无法透露的事情"}]
[{"type": "subtitle", "time": 2584.63, "timestamp": "00:43:04", "text": "粉丝们，这些就像是粉丝自制的OSD。"}, {"type": "subtitle", "time": 2587.589, "timestamp": "00:43:07", "text": "呃，来自 Reality Studios。嗯，他们是"}, {"type": "subtitle", "time": 2589.589, "timestamp": "00:43:09", "text": "好心人"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "给我写首歌什么的。所以当时"}, {"type": "subtitle", "time": 2597.109, "timestamp": "00:43:17", "text": "是啊，我不应该用呃"}, {"type": "subtitle", "time": 2598.63, "timestamp": "00:43:18", "text": "非版权所有"}, {"type": "subtitle", "time": 2603.829, "timestamp": "00:43:23", "text": "呃，其他歌曲，如果他们有时间的话"}, {"type": "subtitle", "time": 2607.99, "timestamp": "00:43:27", "text": "花费时间和精力为我创作歌曲"}, {"type": "subtitle", "time": 2612.47, "timestamp": "00:43:32", "text": "东西。不，我应该……我应该……呃"}, {"type": "subtitle", "time": 2615.43, "timestamp": "00:43:35", "text": "实际上，你知道，支持他们，"}, {"type": "subtitle", "time": 2617.91, "timestamp": "00:43:37", "text": "播放他们为我创作的那些歌曲"}, {"type": "subtitle", "time": 2621.43, "timestamp": "00:43:41", "text": "用他们的心，还有我投入的时间"}, {"type": "subtitle", "time": 2622.95, "timestamp": "00:43:42", "text": "一直都在直播。所以，我一直"}, {"type": "subtitle", "time": 2625.829, "timestamp": "00:43:45", "text": "一直在播放它们。你可以得到"}, {"type": "subtitle", "time": 2628.39, "timestamp": "00:43:48", "text": "播放列表中的这些歌曲。有一个"}, {"type": "chat", "time": 2630.34, "timestamp": "00:43:50", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "it sounds familiar"}, {"type": "subtitle", "time": 2631.27, "timestamp": "00:43:51", "text": "SoundCloud 上的播放列表。"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "呃，让我找找播放列表。我觉得我"}, {"type": "subtitle", "time": 2636.95, "timestamp": "00:43:56", "text": "有链接。 SoundCloud"}]
[{"type": "subtitle", "time": 2160.55, "timestamp": "00:36:00", "text": "想象一下，如果法律咨询真的存在的话……"}, {"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "不会摘掉耳朵"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "不会缩短一年寿命。"}, {"type": "subtitle", "time": 2169.19, "timestamp": "00:36:09", "text": "为什么？"}, {"type": "subtitle", "time": 2170.48, "timestamp": "00:36:10", "text": "呃"}, {"type": "subtitle", "time": 2173.349, "timestamp": "00:36:13", "text": "[音乐]"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "嗯"}, {"type": "subtitle", "time": 2179.349, "timestamp": "00:36:19", "text": "好的。我想我到达第一个了。我"}, {"type": "subtitle", "time": 2183.109, "timestamp": "00:36:23", "text": "我认为他们都有设计令牌。"}, {"type": "subtitle", "time": 2185.19, "timestamp": "00:36:25", "text": "我没看到任何没有……的东西。"}, {"type": "subtitle", "time": 2188.17, "timestamp": "00:36:28", "text": "它。"}, {"type": "subtitle", "time": 2191.27, "timestamp": "00:36:31", "text": "[音乐]"}, {"type": "subtitle", "time": 2193.75, "timestamp": "00:36:33", "text": "昨天我怎么会说，哦，有些"}, {"type": "subtitle", "time": 2195.75, "timestamp": "00:36:35", "text": "这些东西没有正确的"}, {"type": "subtitle", "time": 2197.67, "timestamp": "00:36:37", "text": "一。"}, {"type": "subtitle", "time": 2202.87, "timestamp": "00:36:42", "text": "哦，打电话给罪魁祸首。哦，没事了。"}, {"type": "subtitle", "time": 2206.47, "timestamp": "00:36:46", "text": "呃，好的。所以，一切都很好。"}, {"type": "subtitle", "time": 2207.91, "timestamp": "00:36:47", "text": "那么，我们接下来讨论术语和条款。"}, {"type": "subtitle", "time": 2210.23, "timestamp": "00:36:50", "text": "状况。我们当时在做的事"}, {"type": "subtitle", "time": 2212.47, "timestamp": "00:36:52", "text": "昨天。是的，这家伙没有"}]
[{"type": "subtitle", "time": 3901.75, "timestamp": "01:05:01", "text": "扩大规模。不，那么……你是……"}, {"type": "subtitle", "time": 3905.19, "timestamp": "01:05:05", "text": "马来西亚人？不，我是印度人。"}, {"type": "subtitle", "time": 3908.789, "timestamp": "01:05:08", "text": "我来自印度。你忘了？"}, {"type": "subtitle", "time": 3913.029, "timestamp": "01:05:13", "text": "我们的印度，你和我，以及仍然"}, {"type": "subtitle", "time": 3915.349, "timestamp": "01:05:15", "text": "Madson也在Twitch上聊天。"}, {"type": "subtitle", "time": 3917.43, "timestamp": "01:05:17", "text": "他也是印度人。"}, {"type": "subtitle", "time": 3919.109, "timestamp": "01:05:19", "text": "一定"}, {"type": "subtitle", "time": 3922.95, "timestamp": "01:05:22", "text": "但是，嗯，我想做奥妮克西亚的"}, {"type": "subtitle", "time": 3926.39, "timestamp": "01:05:26", "text": "有限责任公司（LLC）是个合适的东西，如果我仔细想想的话。"}, {"type": "subtitle", "time": 3930.309, "timestamp": "01:05:30", "text": "如果要扩大规模，我就必须做一个 I I"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "我觉得我必须"}, {"type": "subtitle", "time": 3935.43, "timestamp": "01:05:35", "text": "我不知道"}, {"type": "subtitle", "time": 3941.67, "timestamp": "01:05:41", "text": "呃，YouTube 的朋友们，大家好。是的，你好。"}, {"type": "subtitle", "time": 3945.51, "timestamp": "01:05:45", "text": "我不想把事情说得太明显，因为……"}, {"type": "subtitle", "time": 3948.069, "timestamp": "01:05:48", "text": "Twitch正在封禁那些……"}, {"type": "subtitle", "time": 3952.39, "timestamp": "01:05:52", "text": "他们正在进行多房间聊天"}, {"type": "subtitle", "time": 3955.99, "timestamp": "01:05:55", "text": "屏幕，对吧？所以我就想，我能怎么办？"}, {"type": "subtitle", "time": 3958.069, "timestamp": "01:05:58", "text": "做？"}, {"type": "subtitle", "time": 3959.91, "timestamp": "01:05:59", "text": "我希望人们不会在……发现这件事。"}]
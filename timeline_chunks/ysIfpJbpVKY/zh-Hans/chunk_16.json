[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "我。如果那样的话，我会哭的。"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "我也遇到过这种情况。我会想，我是不是？"}, {"type": "subtitle", "time": 967.91, "timestamp": "00:16:07", "text": "臭吗？"}, {"type": "subtitle", "time": 988.71, "timestamp": "00:16:28", "text": "[音乐]"}, {"type": "subtitle", "time": 992.31, "timestamp": "00:16:32", "text": "有一次经历，我觉得我"}, {"type": "subtitle", "time": 995.35, "timestamp": "00:16:35", "text": "感觉像浓烈的香水"}, {"type": "subtitle", "time": 999.67, "timestamp": "00:16:39", "text": "呃，去我的班级之类的，然后我"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "我不小心喷了太多。"}, {"type": "subtitle", "time": 1008.31, "timestamp": "00:16:48", "text": "我闻到了浓浓的香水味。"}, {"type": "subtitle", "time": 1010.629, "timestamp": "00:16:50", "text": "整个教室就像……"}, {"type": "subtitle", "time": 1013.91, "timestamp": "00:16:53", "text": "指着我。那段时间很长"}, {"type": "subtitle", "time": 1017.11, "timestamp": "00:16:57", "text": "背部，很长的背部。"}]
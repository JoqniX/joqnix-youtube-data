[{"type": "subtitle", "time": 5471.27, "timestamp": "01:31:11", "text": "現金支付。是的，祈禱的競賽。我試過了。對，卡朱。"}, {"type": "subtitle", "time": 5487.59, "timestamp": "01:31:27", "text": "這是免費的。唯一的問題是，他們"}, {"type": "subtitle", "time": 5493.75, "timestamp": "01:31:33", "text": "只會抽成一部分。唯一的區別是，他們只收取交易"}, {"type": "subtitle", "time": 5509.99, "timestamp": "01:31:49", "text": "手續費。就是這樣。  [音樂] 我"}]
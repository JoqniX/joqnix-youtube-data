[{"type": "subtitle", "time": 3240.95, "timestamp": "00:54:00", "text": "為什麼它沒有這個功能。是因為"}, {"type": "subtitle", "time": 3243.19, "timestamp": "00:54:03", "text": "我沒有複製貼上，還是只是簡單地複製貼上？"}, {"type": "subtitle", "time": 3252.549, "timestamp": "00:54:12", "text": "H，你有嗎？好的。你有嗎？"}, {"type": "subtitle", "time": 3254.39, "timestamp": "00:54:14", "text": "這個有。這個可以。  這個有。好的。你有嗎"}, {"type": "subtitle", "time": 3290.309, "timestamp": "00:54:50", "text": "？  你？  哦。哦，我看到罪魁禍首了。你沒有那個東西。  所以，列表項。  H：那你呢？"}]
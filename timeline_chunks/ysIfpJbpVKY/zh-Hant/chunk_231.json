[{"type": "subtitle", "time": 13863.51, "timestamp": "03:51:03", "text": "我的天哪。"}, {"type": "subtitle", "time": 13865.91, "timestamp": "03:51:05", "text": "我喜歡下巴連接粗糙，但我不需要那樣做。"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "我只是希望現在節目之間發生的事情不會在印度，在印度"}, {"type": "subtitle", "time": 13900.87, "timestamp": "03:51:40", "text": "企業裡發生，你可能會……我不知道，我感覺它可能會發生。它更像是一種適應性材料"}, {"type": "subtitle", "time": 13904.309, "timestamp": "03:51:44", "text": "，一種適應性類型。我指的"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "是收入分成"}]
[{"type": "subtitle", "time": 120.469, "timestamp": "00:02:00", "text": "プラグを差し込んで充電してください"}, {"type": "subtitle", "time": 125.109, "timestamp": "00:02:05", "text": "など。確かに。"}, {"type": "subtitle", "time": 128.63, "timestamp": "00:02:08", "text": "皆さん、お元気ですか？暖かい"}, {"type": "subtitle", "time": 132.15, "timestamp": "00:02:12", "text": "皆様、おはようございます。"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "皆さんお元気でお過ごしでしょうか。私は手に入れている"}, {"type": "subtitle", "time": 145.51, "timestamp": "00:02:25", "text": "今日はそれに取り組んでいます。ええと、私たちは続けます"}, {"type": "subtitle", "time": 149.19, "timestamp": "00:02:29", "text": "昨日の出来事。私は気づいた"}, {"type": "subtitle", "time": 153.27, "timestamp": "00:02:33", "text": "なんだか唐突に終わった。私は感じていた"}, {"type": "subtitle", "time": 155.19, "timestamp": "00:02:35", "text": "非常にストレスが溜まっている、"}, {"type": "subtitle", "time": 158.07, "timestamp": "00:02:38", "text": "すごく、ええと、燃え尽きた。私は"}, {"type": "subtitle", "time": 160.309, "timestamp": "00:02:40", "text": "最近、燃え尽き症候群気味です。"}, {"type": "subtitle", "time": 163.11, "timestamp": "00:02:43", "text": "それは確かに存在する。私は"}, {"type": "subtitle", "time": 167.91, "timestamp": "00:02:47", "text": "最近、燃え尽き症候群気味です。少し残念だ。"}, {"type": "subtitle", "time": 169.50900000000001, "timestamp": "00:02:49", "text": "えっと、"}, {"type": "subtitle", "time": 173.50900000000001, "timestamp": "00:02:53", "text": "ちょっと悪いですね"}, {"type": "subtitle", "time": 175.27, "timestamp": "00:02:55", "text": "どうやら、"}, {"type": "subtitle", "time": 177.43, "timestamp": "00:02:57", "text": "しかし"}, {"type": "subtitle", "time": 178.95, "timestamp": "00:02:58", "text": "今のところ"}]
[{"type": "subtitle", "time": 8880.79, "timestamp": "02:28:00", "text": "2はえーと"}, {"type": "subtitle", "time": 8884.15, "timestamp": "02:28:04", "text": "人々が私のブログを読む方法として、"}, {"type": "subtitle", "time": 8885.51, "timestamp": "02:28:05", "text": "何か。つまり、彼らは"}, {"type": "subtitle", "time": 8887.91, "timestamp": "02:28:07", "text": "ウェブサイトですが、リアルタイムのようなもので"}, {"type": "subtitle", "time": 8890.55, "timestamp": "02:28:10", "text": "あなたは次のようなゲームを持つことができます"}, {"type": "subtitle", "time": 8893.11, "timestamp": "02:28:13", "text": "ジョックをチェックするようなもの"}, {"type": "subtitle", "time": 8895.67, "timestamp": "02:28:15", "text": "そのスポーツマンはやっている。私が話したことを覚えているでしょう"}, {"type": "subtitle", "time": 8897.91, "timestamp": "02:28:17", "text": "アクティビティステータスのことですよね？"}, {"type": "subtitle", "time": 8899.99, "timestamp": "02:28:19", "text": "うん。ああ、あれは本物だ"}, {"type": "subtitle", "time": 8901.75, "timestamp": "02:28:21", "text": "時間。"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "いや、もしかしたら試してみるかもしれない"}, {"type": "subtitle", "time": 8907.11, "timestamp": "02:28:27", "text": "ウェブサイトをモバイルアプリにすることができます"}, {"type": "subtitle", "time": 8911.51, "timestamp": "02:28:31", "text": "またはプログレッシブのようなもの"}, {"type": "subtitle", "time": 8914.95, "timestamp": "02:28:34", "text": "電話がかかってきた？ここで右クリックしてみましょう。"}, {"type": "subtitle", "time": 8919.429, "timestamp": "02:28:39", "text": "ああ、プログレッシブアプリが今"}, {"type": "subtitle", "time": 8922.55, "timestamp": "02:28:42", "text": "何かわからない。うん、"}, {"type": "chat", "time": 8925.466, "timestamp": "02:28:45", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "Hmm... progressive web app"}, {"type": "subtitle", "time": 8927.59, "timestamp": "02:28:47", "text": "PWAアプリ（プログレッシブウェブアプリケーション）。"}, {"type": "subtitle", "time": 8930.63, "timestamp": "02:28:50", "text": "うん、もし私が"}]
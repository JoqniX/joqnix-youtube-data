[{"type": "subtitle", "time": 2160.55, "timestamp": "00:36:00", "text": "法律相談が"}, {"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "耳を切り落とすことはないだろう"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "寿命を1年縮めることはないだろう。"}, {"type": "subtitle", "time": 2169.19, "timestamp": "00:36:09", "text": "なぜ？"}, {"type": "subtitle", "time": 2170.48, "timestamp": "00:36:10", "text": "えっと"}, {"type": "subtitle", "time": 2173.349, "timestamp": "00:36:13", "text": "[音楽]"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "えっと"}, {"type": "subtitle", "time": 2179.349, "timestamp": "00:36:19", "text": "わかった。最初の地点に到達したと思います。私"}, {"type": "subtitle", "time": 2183.109, "timestamp": "00:36:23", "text": "それら全てにデザイントークンがあると思う。"}, {"type": "subtitle", "time": 2185.19, "timestamp": "00:36:25", "text": "何も見当たらない"}, {"type": "subtitle", "time": 2188.17, "timestamp": "00:36:28", "text": "それ。"}, {"type": "subtitle", "time": 2191.27, "timestamp": "00:36:31", "text": "[音楽]"}, {"type": "subtitle", "time": 2193.75, "timestamp": "00:36:33", "text": "どうして昨日私は「ああ、いくつか"}, {"type": "subtitle", "time": 2195.75, "timestamp": "00:36:35", "text": "これらのものには正しいものがありません"}, {"type": "subtitle", "time": 2197.67, "timestamp": "00:36:37", "text": "1つ。"}, {"type": "subtitle", "time": 2202.87, "timestamp": "00:36:42", "text": "ああ、犯人に電話して。ああ、気にしないで。"}, {"type": "subtitle", "time": 2206.47, "timestamp": "00:36:46", "text": "ああ、わかった。つまり、すべて順調ということですね。"}, {"type": "subtitle", "time": 2207.91, "timestamp": "00:36:47", "text": "それでは、用語と"}, {"type": "subtitle", "time": 2210.23, "timestamp": "00:36:50", "text": "条件。私たちがやっていたこと"}, {"type": "subtitle", "time": 2212.47, "timestamp": "00:36:52", "text": "昨日。ええ、この男は持っていません"}]
[{"type": "subtitle", "time": 4922.87, "timestamp": "01:22:02", "text": "下のボタンをクリックしてください"}, {"type": "subtitle", "time": 4927.03, "timestamp": "01:22:07", "text": "ジョブドッジを閉じます。はい、完了しました。私"}, {"type": "subtitle", "time": 4941.99, "timestamp": "01:22:21", "text": "わかった、Twitterで見せるよ。"}, {"type": "subtitle", "time": 4943.83, "timestamp": "01:22:23", "text": "あと、Twitterのこともやらなきゃいけないし、"}, {"type": "subtitle", "time": 4949.59, "timestamp": "01:22:29", "text": "右？私はまだそれを先延ばしにしている。"}, {"type": "subtitle", "time": 4953.99, "timestamp": "01:22:33", "text": "えっと、ここでメディアタブを開くと、"}, {"type": "subtitle", "time": 4958.79, "timestamp": "01:22:38", "text": "私にはそれがわかる。あなたにも分かると思いますよ。"}, {"type": "subtitle", "time": 4963.27, "timestamp": "01:22:43", "text": "[音楽]"}, {"type": "subtitle", "time": 4966.629, "timestamp": "01:22:46", "text": "どこですか？うん、これは私が作ったんだ"}, {"type": "subtitle", "time": 4969.51, "timestamp": "01:22:49", "text": "神椿 再生 創造 共創"}, {"type": "subtitle", "time": 4971.51, "timestamp": "01:22:51", "text": "あれ。"}, {"type": "subtitle", "time": 4974.87, "timestamp": "01:22:54", "text": "それで彼らはウェブサイトを持っていた kamisubaki"}, {"type": "subtitle", "time": 4977.51, "timestamp": "01:22:57", "text": "キャラクタージェネレーター"}]
[{"type": "subtitle", "time": 7443.109, "timestamp": "02:04:03", "text": "えっと、私もそうしないといけないと思うんです。"}, {"type": "subtitle", "time": 7445.43, "timestamp": "02:04:05", "text": "私がこれをやろうとしていたとき"}, {"type": "subtitle", "time": 7448.229, "timestamp": "02:04:08", "text": "決済処理業者が支払いを要求した"}, {"type": "subtitle", "time": 7451.589, "timestamp": "02:04:11", "text": "もし私が持っているなら"}, {"type": "subtitle", "time": 7459.27, "timestamp": "02:04:19", "text": "ちょっと待って、どこで聞いたか確認させて"}, {"type": "subtitle", "time": 7461.669, "timestamp": "02:04:21", "text": "まさにその通り。"}, {"type": "subtitle", "time": 7469.189, "timestamp": "02:04:29", "text": "えーと"}, {"type": "subtitle", "time": 7471.99, "timestamp": "02:04:31", "text": "どこで誰に聞いたのか覚えていない"}, {"type": "subtitle", "time": 7478.79, "timestamp": "02:04:38", "text": "ああ、それでは適切な登録ガイド"}, {"type": "subtitle", "time": 7482.149, "timestamp": "02:04:42", "text": "よし、これだ"}, {"type": "subtitle", "time": 7490.709, "timestamp": "02:04:50", "text": "どこにあるの？どこにあるの？"}]
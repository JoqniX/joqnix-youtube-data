[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "それはまるで君のフクロウ、ジャワみたいだね。あなたのフクロウ。えっと、"}, {"type": "subtitle", "time": 3603.589, "timestamp": "01:00:03", "text": "あなたのフクロウを混ぜるにはどうすればいいですか"}, {"type": "subtitle", "time": 3606.39, "timestamp": "01:00:06", "text": "あなたの名前に？"}, {"type": "subtitle", "time": 3608.309, "timestamp": "01:00:08", "text": "えっと、"}, {"type": "subtitle", "time": 3612.95, "timestamp": "01:00:12", "text": "夜型の私。マット、それでいいよ。"}, {"type": "subtitle", "time": 3624.23, "timestamp": "01:00:24", "text": "[音楽]"}, {"type": "subtitle", "time": 3628.28, "timestamp": "01:00:28", "text": "ニアみたいなのが付いています。"}, {"type": "subtitle", "time": 3639.829, "timestamp": "01:00:39", "text": "[音楽]"}, {"type": "subtitle", "time": 3652.46, "timestamp": "01:00:52", "text": "それをコピーして貼り付けてください。"}]
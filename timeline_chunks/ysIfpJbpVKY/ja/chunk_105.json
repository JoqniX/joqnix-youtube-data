[{"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "私のストリームミュージックは"}, {"type": "subtitle", "time": 6311.43, "timestamp": "01:45:11", "text": "えーと、Mミュージックは"}, {"type": "subtitle", "time": 6326.47, "timestamp": "01:45:26", "text": "によって行われた作品"}, {"type": "subtitle", "time": 6329.43, "timestamp": "01:45:29", "text": "コミュニティチームのメンバー。"}, {"type": "subtitle", "time": 6336.95, "timestamp": "01:45:36", "text": "この件ではリンクを貼ることができます。"}, {"type": "subtitle", "time": 6340.55, "timestamp": "01:45:40", "text": "そのリンクではありません。だから、えっと、私は"}, {"type": "subtitle", "time": 6343.99, "timestamp": "01:45:43", "text": "これを考えてみてください。もし私が"}, {"type": "subtitle", "time": 6347.03, "timestamp": "01:45:47", "text": "アイゼンのアルバムを聴いて、それから私は"}, {"type": "subtitle", "time": 6348.87, "timestamp": "01:45:48", "text": "再生中"}, {"type": "subtitle", "time": 6353.27, "timestamp": "01:45:53", "text": "将来、もし私たちが"}, {"type": "subtitle", "time": 6356.31, "timestamp": "01:45:56", "text": "音楽を作って、もっと音楽を手に入れたら"}, {"type": "subtitle", "time": 6359.189, "timestamp": "01:45:59", "text": "プロデューサーの視聴者も"}]
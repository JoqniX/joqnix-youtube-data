[{"type": "subtitle", "time": 5280.229, "timestamp": "01:28:00", "text": "いや、私は「何があっても」って感じだった"}, {"type": "chat", "time": 5281.253, "timestamp": "01:28:01", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "dont docks yourself"}, {"type": "subtitle", "time": 5282.07, "timestamp": "01:28:02", "text": "起こる"}, {"type": "subtitle", "time": 5285.189, "timestamp": "01:28:05", "text": "たとえ私がこの状況にあっても、たとえ私が"}, {"type": "subtitle", "time": 5288.55, "timestamp": "01:28:08", "text": "お金や物が少なくて困っている"}, {"type": "subtitle", "time": 5292.07, "timestamp": "01:28:12", "text": "誓って、私は自分自身に誓います"}, {"type": "subtitle", "time": 5295.75, "timestamp": "01:28:15", "text": "ジョックニックの銀行口座には触れないでください。"}, {"type": "subtitle", "time": 5299.59, "timestamp": "01:28:19", "text": "何があっても、私はそれをジョックのためにのみ使用します"}, {"type": "subtitle", "time": 5302.39, "timestamp": "01:28:22", "text": "チャンネル専用のものだけ"}, {"type": "subtitle", "time": 5305.27, "timestamp": "01:28:25", "text": "モデル関連のものすべて"}, {"type": "subtitle", "time": 5308.229, "timestamp": "01:28:28", "text": "その後も私はそれを"}, {"type": "subtitle", "time": 5310.95, "timestamp": "01:28:30", "text": "ジョックのための物やその他すべて、そして私は"}, {"type": "subtitle", "time": 5314.07, "timestamp": "01:28:34", "text": "他の銀行口座を使うことを誓います"}, {"type": "subtitle", "time": 5317.03, "timestamp": "01:28:37", "text": "個人的なものについては、"}, {"type": "subtitle", "time": 5319.43, "timestamp": "01:28:39", "text": "現実世界で使う"}, {"type": "subtitle", "time": 5322.39, "timestamp": "01:28:42", "text": "そして私が現実世界で何をするか、あるいは何であれ"}, {"type": "subtitle", "time": 5325.189, "timestamp": "01:28:45", "text": "私は現実の仕事か何かから得ている"}, {"type": "subtitle", "time": 5328.07, "timestamp": "01:28:48", "text": "銀行口座に関しては、首には触れません"}, {"type": "subtitle", "time": 5329.99, "timestamp": "01:28:49", "text": "誓って、昨日と同じように"}, {"type": "subtitle", "time": 5337.99, "timestamp": "01:28:57", "text": "うん。一度、私は、私は、私は、私は、私は"}, {"type": "subtitle", "time": 5339.59, "timestamp": "01:28:59", "text": "それ。"}]
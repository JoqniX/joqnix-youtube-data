[{"type": "subtitle", "time": 14280.95, "timestamp": "03:58:00", "text": "ホラーゲーム。セレナ"}, {"type": "subtitle", "time": 14285.189, "timestamp": "03:58:05", "text": "ワーフは死んだ。ポピー・プレイタイムは無料です。"}, {"type": "subtitle", "time": 14292.55, "timestamp": "03:58:12", "text": "ああ、もしあなたがドキドキを持っているなら"}, {"type": "subtitle", "time": 14295.51, "timestamp": "03:58:15", "text": "文学部、ぜひプレイしてみてください。いいですね"}, {"type": "subtitle", "time": 14298.79, "timestamp": "03:58:18", "text": "しかし、同時に生々しい描写もある。"}, {"type": "subtitle", "time": 14306.229, "timestamp": "03:58:26", "text": "ほかに何か？"}, {"type": "subtitle", "time": 14309.75, "timestamp": "03:58:29", "text": "推薦するのは難しい。"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "おお、"}, {"type": "subtitle", "time": 14313.59, "timestamp": "03:58:33", "text": "ゲームの種類が多すぎるんですよね。でももしあなたが"}, {"type": "subtitle", "time": 14315.91, "timestamp": "03:58:35", "text": "自分で確認したいのですが、"}, {"type": "subtitle", "time": 14317.91, "timestamp": "03:58:37", "text": "Steamがインストールされていることを願います。もしあなたが"}, {"type": "subtitle", "time": 14321.189, "timestamp": "03:58:41", "text": "お持ちでない場合は、ダウンロードしてください。それから、えっと、行く"}, {"type": "subtitle", "time": 14323.429, "timestamp": "03:58:43", "text": "ストアページへ。"}, {"type": "subtitle", "time": 14326.95, "timestamp": "03:58:46", "text": "実際にできることは、ホバーすることです"}, {"type": "subtitle", "time": 14329.429, "timestamp": "03:58:49", "text": "カテゴリー別"}, {"type": "subtitle", "time": 14332.87, "timestamp": "03:58:52", "text": "そして「無料プレイ」をクリックしてください。"}, {"type": "subtitle", "time": 14335.189, "timestamp": "03:58:55", "text": "そしてクリックする必要があると思います。"}, {"type": "subtitle", "time": 14336.87, "timestamp": "03:58:56", "text": "こちらにはジャンルがあります。あなたはできる"}]
[{"type": "subtitle", "time": 11109.11, "timestamp": "03:05:09", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 11113.349, "timestamp": "03:05:13", "text": "正直に言うと、今は"}, {"type": "subtitle", "time": 11116.95, "timestamp": "03:05:16", "text": "数年後には"}, {"type": "subtitle", "time": 11120.07, "timestamp": "03:05:20", "text": "他のインド人ユーチューバーと同様に独立系"}, {"type": "subtitle", "time": 11122.15, "timestamp": "03:05:22", "text": "インドのユーチューバーたちも同じことをするだろう"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "私がやっていることと同じことを。ええ、問題は"}, {"type": "subtitle", "time": 11129.75, "timestamp": "03:05:29", "text": "今では誰もが趣味としてやっていて、"}, {"type": "subtitle", "time": 11132.79, "timestamp": "03:05:32", "text": "真剣な話ですよね？でももし"}, {"type": "subtitle", "time": 11135.429, "timestamp": "03:05:35", "text": "彼らはグッズなどを販売したいと思ったことはありますか？"}, {"type": "subtitle", "time": 11138.23, "timestamp": "03:05:38", "text": "彼らはどうするだろうか？右。"}, {"type": "subtitle", "time": 11139.99, "timestamp": "03:05:39", "text": "ええ、それは"}, {"type": "subtitle", "time": 11143.19, "timestamp": "03:05:43", "text": "未来。うまくいけば"}, {"type": "subtitle", "time": 11145.349, "timestamp": "03:05:45", "text": "人々は私と同じことをするだろう"}, {"type": "subtitle", "time": 11147.03, "timestamp": "03:05:47", "text": "実行中。"}, {"type": "subtitle", "time": 11153.59, "timestamp": "03:05:53", "text": "すべてを行う"}]
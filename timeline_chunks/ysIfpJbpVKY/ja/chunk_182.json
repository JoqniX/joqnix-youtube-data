[{"type": "subtitle", "time": 10920.23, "timestamp": "03:02:00", "text": "朝 ああ、そうそう、10時だよね？彼らは"}, {"type": "subtitle", "time": 10923.11, "timestamp": "03:02:03", "text": "そこにあるはずだ。いいえ、清掃婦さん"}, {"type": "subtitle", "time": 10925.67, "timestamp": "03:02:05", "text": "叔母は今から来るよ。いいえ、"}, {"type": "subtitle", "time": 10928.63, "timestamp": "03:02:08", "text": "9時ですよね？あなたもそこにいるかもしれません。私は思う"}, {"type": "subtitle", "time": 10932.07, "timestamp": "03:02:12", "text": "私はまだ外に出ていません"}, {"type": "subtitle", "time": 10935.03, "timestamp": "03:02:15", "text": "ドア。うん、実際に彼らに聞いてみようかな"}, {"type": "subtitle", "time": 10937.98, "timestamp": "03:02:17", "text": "彼らは私と一緒に来る。"}, {"type": "subtitle", "time": 10939.59, "timestamp": "03:02:19", "text": "[音楽]"}, {"type": "subtitle", "time": 10942.309, "timestamp": "03:02:22", "text": "うん、実際に聞いてみるべきだね"}, {"type": "subtitle", "time": 10945.91, "timestamp": "03:02:25", "text": "正直に言うと"}, {"type": "subtitle", "time": 10949.03, "timestamp": "03:02:29", "text": "[音楽]"}, {"type": "chat", "time": 10951.505, "timestamp": "03:02:31", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "dayyum hes got personal lawyers"}, {"type": "subtitle", "time": 10956.79, "timestamp": "03:02:36", "text": "えっと"}, {"type": "subtitle", "time": 10960.15, "timestamp": "03:02:40", "text": "個人的な弁護士ではなく、"}, {"type": "subtitle", "time": 10964.55, "timestamp": "03:02:44", "text": "弁護士の書類みたいなもの。えっと、私のトップ"}, {"type": "subtitle", "time": 10967.99, "timestamp": "03:02:47", "text": "私の家の1階の一部は"}, {"type": "subtitle", "time": 10971.269, "timestamp": "03:02:51", "text": "私たちは、私はそれを引き裂くために与えました"}, {"type": "subtitle", "time": 10975.269, "timestamp": "03:02:55", "text": "外側の穴と内側のホール"}]
[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "あなたがそれを行い、弁護士に依頼する"}, {"type": "subtitle", "time": 1923.83, "timestamp": "00:32:03", "text": "確認して、校正するんだよね？私はしません"}, {"type": "chat", "time": 1925.918, "timestamp": "00:32:05", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "ya true"}, {"type": "subtitle", "time": 1926.549, "timestamp": "00:32:06", "text": "知る。でも、私もそういう人間です"}, {"type": "subtitle", "time": 1928.71, "timestamp": "00:32:08", "text": "考えてみる"}, {"type": "subtitle", "time": 1931.19, "timestamp": "00:32:11", "text": "なぜなら、費用がかさむからです。持つこと"}, {"type": "subtitle", "time": 1934.789, "timestamp": "00:32:14", "text": "弁護士費用とかは高すぎる。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "彼らはとても[ __ ]な人たちです。私は文字通り"}, {"type": "subtitle", "time": 1940.31, "timestamp": "00:32:20", "text": "弁護士事務所が近くにある"}, {"type": "subtitle", "time": 1943.669, "timestamp": "00:32:23", "text": "ドア。隣の部屋は文字通り"}, {"type": "subtitle", "time": 1946.07, "timestamp": "00:32:26", "text": "弁護士の家。"}, {"type": "subtitle", "time": 1949.43, "timestamp": "00:32:29", "text": "彼らがこれらすべてを行うかどうかはわかりません"}, {"type": "subtitle", "time": 1953.509, "timestamp": "00:32:33", "text": "オンライン上のもの。つまり、あの、"}, {"type": "subtitle", "time": 1955.669, "timestamp": "00:32:35", "text": "弁護士の人たちが、彼らが試みたとき"}, {"type": "subtitle", "time": 1958.47, "timestamp": "00:32:38", "text": "彼らはまず部屋を見に来た"}, {"type": "subtitle", "time": 1960.07, "timestamp": "00:32:40", "text": "そして彼らのオフィスと"}, {"type": "subtitle", "time": 1963.19, "timestamp": "00:32:43", "text": "いろいろ見て、私の配信ルームのセットアップを見た"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "そして全て。彼らは「ああ、そうだね」と言った"}, {"type": "subtitle", "time": 1967.11, "timestamp": "00:32:47", "text": "また、"}, {"type": "subtitle", "time": 1969.83, "timestamp": "00:32:49", "text": "彼らは、私たちも"}, {"type": "subtitle", "time": 1972.95, "timestamp": "00:32:52", "text": "たくさんのPCを持っていて、Chad GPTを入手します"}, {"type": "subtitle", "time": 1976.23, "timestamp": "00:32:56", "text": "あれこれ。私は「えっ、待って」って感じだった"}, {"type": "subtitle", "time": 1978.23, "timestamp": "00:32:58", "text": "てっきり君たちは弁護士だと思っていたよ。何が"}]
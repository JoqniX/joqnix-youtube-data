[{"type": "subtitle", "time": 902.87, "timestamp": "00:15:02", "text": "香水またはボディフレグランス"}, {"type": "subtitle", "time": 905.509, "timestamp": "00:15:05", "text": "もの。もっと軽いものもあるし"}, {"type": "subtitle", "time": 909.509, "timestamp": "00:15:09", "text": "重いものとか。私は私は知らなかった"}, {"type": "subtitle", "time": 912.23, "timestamp": "00:15:12", "text": "香水にも分類がある"}, {"type": "subtitle", "time": 914.55, "timestamp": "00:15:14", "text": "などなど。"}, {"type": "subtitle", "time": 920.87, "timestamp": "00:15:20", "text": "すみません。"}, {"type": "subtitle", "time": 931.189, "timestamp": "00:15:31", "text": "うーん、でも、そうですね、わかりません。"}, {"type": "subtitle", "time": 935.91, "timestamp": "00:15:35", "text": "それに対する私の答えは確かに"}, {"type": "subtitle", "time": 939.269, "timestamp": "00:15:39", "text": "えーと、匂いのするものなら何でも"}, {"type": "subtitle", "time": 942.55, "timestamp": "00:15:42", "text": "良い。使ってみます。私はそれで構いません"}, {"type": "subtitle", "time": 944.629, "timestamp": "00:15:44", "text": "実際、何でもいいんです。"}, {"type": "subtitle", "time": 948.389, "timestamp": "00:15:48", "text": "関係ない。うん。"}, {"type": "subtitle", "time": 951.99, "timestamp": "00:15:51", "text": "ええと、歩く人が歩く限り"}, {"type": "subtitle", "time": 954.949, "timestamp": "00:15:54", "text": "私の横や後ろにいると、彼らは気に入らないだろう"}, {"type": "subtitle", "time": 957.91, "timestamp": "00:15:57", "text": "彼らを止めようとする"}, {"type": "subtitle", "time": 959.91, "timestamp": "00:15:59", "text": "鼻をつまんで、"}]
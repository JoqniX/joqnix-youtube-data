[{"type": "subtitle", "time": 3240.95, "timestamp": "00:54:00", "text": "いつ持ってきてくれるのかは分かりません。"}, {"type": "subtitle", "time": 3243.19, "timestamp": "00:54:03", "text": "彼らは、それは現在進行中だと述べた。私が行くと"}, {"type": "subtitle", "time": 3245.03, "timestamp": "00:54:05", "text": "電子商取引は、これから来ると言われています"}, {"type": "subtitle", "time": 3249.67, "timestamp": "00:54:09", "text": "すぐ。私はこれをクリックします。"}, {"type": "subtitle", "time": 3252.549, "timestamp": "00:54:12", "text": "えっと、これに関する最新情報はありますか？"}, {"type": "subtitle", "time": 3254.39, "timestamp": "00:54:14", "text": "年？彼らはそれが今年来ると言っている"}, {"type": "subtitle", "time": 3260.87, "timestamp": "00:54:20", "text": "模擬店舗がある。そうそう。うん。リミックス"}, {"type": "subtitle", "time": 3263.43, "timestamp": "00:54:23", "text": "の方が良い。そのウェブスタジオはumによって作られました"}, {"type": "subtitle", "time": 3266.549, "timestamp": "00:54:26", "text": "Remixを使用して実行されています。"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "Shopifyの模擬ストア。"}, {"type": "subtitle", "time": 3275.27, "timestamp": "00:54:35", "text": "それはどこですか？嘲笑。お店に行った。これです。"}, {"type": "subtitle", "time": 3278.63, "timestamp": "00:54:38", "text": "待って、これ、これなの？私は"}, {"type": "subtitle", "time": 3285.109, "timestamp": "00:54:45", "text": "ショップのストアフロントを構築してホストするには"}, {"type": "subtitle", "time": 3286.71, "timestamp": "00:54:46", "text": "Shopify。"}, {"type": "subtitle", "time": 3290.309, "timestamp": "00:54:50", "text": "でも、まずShopifyが必要なの？"}, {"type": "subtitle", "time": 3293.27, "timestamp": "00:54:53", "text": "Shopifyによって提供されています。"}, {"type": "subtitle", "time": 3296.069, "timestamp": "00:54:56", "text": "Hydroenによるヘッドレスeコマース。何が"}]
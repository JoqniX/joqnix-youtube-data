[{"type": "subtitle", "time": 6722.629, "timestamp": "01:52:02", "text": "それ。わかった。そしてバカはこう言った"}, {"type": "subtitle", "time": 6726.31, "timestamp": "01:52:06", "text": "私に噛みつこうとしている。私を噛まないで。のように"}, {"type": "subtitle", "time": 6729.109, "timestamp": "01:52:09", "text": "ほうきの柄を噛もうとしている。"}, {"type": "chat", "time": 6729.201, "timestamp": "01:52:09", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "whats this about a worm"}, {"type": "subtitle", "time": 6732.39, "timestamp": "01:52:12", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 6734.229, "timestamp": "01:52:14", "text": "これは、ええ、"}, {"type": "subtitle", "time": 6737.99, "timestamp": "01:52:17", "text": "虫か何か死んだ昆虫のようなものが"}, {"type": "chat", "time": 6739.586, "timestamp": "01:52:19", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "ayo"}, {"type": "subtitle", "time": 6740.39, "timestamp": "01:52:20", "text": "犬小屋"}, {"type": "subtitle", "time": 6744.149, "timestamp": "01:52:24", "text": "壁の隅に、"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "彼はそれに向かって吠えまくっていた。"}, {"type": "subtitle", "time": 6749.83, "timestamp": "01:52:29", "text": "私は「よし、中に入って"}, {"type": "subtitle", "time": 6752.95, "timestamp": "01:52:32", "text": "ドールハウスから取り出そうとする。」"}, {"type": "subtitle", "time": 6756.229, "timestamp": "01:52:36", "text": "全体を掃除した。うん、それが一番いいよ"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "犬小屋全体を一度掃除する"}, {"type": "subtitle", "time": 6762.79, "timestamp": "01:52:42", "text": "彼は不遇な立場ではない。彼が"}, {"type": "subtitle", "time": 6765.51, "timestamp": "01:52:45", "text": "えっと、何て言うんだっけに鎖で繋がれて"}, {"type": "subtitle", "time": 6769.51, "timestamp": "01:52:49", "text": "それ？ポールとか近くの物"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "車庫エリア。"}, {"type": "subtitle", "time": 6775.99, "timestamp": "01:52:55", "text": "そう、だってそれは痛みみたいなものだから。彼はそうしない"}, {"type": "subtitle", "time": 6778.55, "timestamp": "01:52:58", "text": "また、彼は水も嫌いです。"}]
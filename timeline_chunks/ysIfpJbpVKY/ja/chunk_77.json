[{"type": "subtitle", "time": 4620.709, "timestamp": "01:17:00", "text": "自分のドメインを追加しようとしました。そうではない"}, {"type": "subtitle", "time": 4623.11, "timestamp": "01:17:03", "text": "仕事だよ、相棒。"}, {"type": "subtitle", "time": 4627.75, "timestamp": "01:17:07", "text": "私は本当に努力しました。店。隣のスペース。"}, {"type": "subtitle", "time": 4645.03, "timestamp": "01:17:25", "text": "しかし、私たちは、私たちは、"}, {"type": "subtitle", "time": 4648.87, "timestamp": "01:17:28", "text": "近日中にグッズを入荷予定です。彼"}, {"type": "subtitle", "time": 4657.99, "timestamp": "01:17:37", "text": "近々グッズ販売を開始する予定です。彼"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "無料で差し上げます。わかった。のように"}, {"type": "subtitle", "time": 4661.75, "timestamp": "01:17:41", "text": "あなたの携帯電話用のデジタル壁紙と"}, {"type": "subtitle", "time": 4664.229, "timestamp": "01:17:44", "text": "すべて。すべてアップロードします"}, {"type": "subtitle", "time": 4666.95, "timestamp": "01:17:46", "text": "店。"}, {"type": "subtitle", "time": 4670.63, "timestamp": "01:17:50", "text": "ええ、それをお願いします。"}, {"type": "subtitle", "time": 4673.11, "timestamp": "01:17:53", "text": "[音楽]"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "うまくいくといいですね。正直に、"}]
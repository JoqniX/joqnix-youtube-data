[{"type": "subtitle", "time": 840.87, "timestamp": "00:14:00", "text": "何かありますか？"}, {"type": "subtitle", "time": 844.15, "timestamp": "00:14:04", "text": "これって何か味とかあるの？私"}, {"type": "subtitle", "time": 847.03, "timestamp": "00:14:07", "text": "わからない。私は使いません 私は持っていません"}, {"type": "subtitle", "time": 851.03, "timestamp": "00:14:11", "text": "実は一番好きなんです。えっと、私はただの"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "だから、そこにあるものは何でも受け入れます"}, {"type": "subtitle", "time": 862.23, "timestamp": "00:14:22", "text": "いい匂いがすればそれでいいんです。うん。"}, {"type": "subtitle", "time": 866.15, "timestamp": "00:14:26", "text": "しかし私は気づいた"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "えっと、行く予定なので、私は"}, {"type": "subtitle", "time": 872.069, "timestamp": "00:14:32", "text": "来年日本に行く予定です。ああ、気づいたんだ"}, {"type": "subtitle", "time": 875.03, "timestamp": "00:14:35", "text": "日本では、いや、全体的に"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "この文化は、つまり、一部の人々にとって"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "あなたが香水をつけているのは好きではない"}, {"type": "subtitle", "time": 886.31, "timestamp": "00:14:46", "text": "多すぎる、つまり、"}, {"type": "subtitle", "time": 889.67, "timestamp": "00:14:49", "text": "匂いが強すぎる。いいえ。ええ。それはまるで"}, {"type": "subtitle", "time": 893.11, "timestamp": "00:14:53", "text": "悪いことだ。そして私が気づいたのは、"}, {"type": "subtitle", "time": 894.79, "timestamp": "00:14:54", "text": "調査したり、ビデオを見たり"}, {"type": "subtitle", "time": 897.75, "timestamp": "00:14:57", "text": "それについて、動画を見たんです。私は"}, {"type": "subtitle", "time": 899.35, "timestamp": "00:14:59", "text": "2種類の"}]
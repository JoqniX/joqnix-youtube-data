[{"type": "subtitle", "time": 13576.95, "timestamp": "03:46:16", "text": "兄弟それがあなたの100％です、ミスター。"}, {"type": "subtitle", "time": 13579.99, "timestamp": "03:46:19", "text": "そして、これが私の望みだ。うん。これ"}, {"type": "subtitle", "time": 13583.03, "timestamp": "03:46:23", "text": "それが私の望みです。あなたにとってなぜ難しいのですか"}, {"type": "subtitle", "time": 13607.189, "timestamp": "03:46:47", "text": "私がオーガズムに達しても変に見えないのは幸いです。"}, {"type": "subtitle", "time": 13614.05, "timestamp": "03:46:54", "text": "もちろん、それはひどい見た目です。"}]
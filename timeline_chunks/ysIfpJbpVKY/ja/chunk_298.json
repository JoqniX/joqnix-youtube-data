[{"type": "subtitle", "time": 17880.15, "timestamp": "04:58:00", "text": "コラボパートナーは積極的に"}, {"type": "subtitle", "time": 17883.51, "timestamp": "04:58:03", "text": "チャットで話したり、"}, {"type": "subtitle", "time": 17886.788, "timestamp": "04:58:06", "text": "他のチャットや、与えないような"}, {"type": "subtitle", "time": 17888.948, "timestamp": "04:58:08", "text": "コラボレーションパートナーであるあなたに注目してください"}, {"type": "subtitle", "time": 17892.788, "timestamp": "04:58:12", "text": "失礼な行為とも見なされる"}, {"type": "subtitle", "time": 17895.19, "timestamp": "04:58:15", "text": "コラボレーション倫理に関しては"}, {"type": "subtitle", "time": 17899.19, "timestamp": "04:58:19", "text": "辞める、だから人々は"}, {"type": "subtitle", "time": 17901.59, "timestamp": "04:58:21", "text": "私が、私たちは"}, {"type": "subtitle", "time": 17904.31, "timestamp": "04:58:24", "text": "〇〇さんとコラボ配信をします"}, {"type": "subtitle", "time": 17906.628, "timestamp": "04:58:26", "text": "作成者 私はそれを再作成できません"}, {"type": "subtitle", "time": 17908.788, "timestamp": "04:58:28", "text": "彼女自身も、"}, {"type": "subtitle", "time": 17911.51, "timestamp": "04:58:31", "text": "右？免責事項メッセージのようなもの"}, {"type": "subtitle", "time": 17913.59, "timestamp": "04:58:33", "text": "人々が"}, {"type": "subtitle", "time": 17915.51, "timestamp": "04:58:35", "text": "あなたを見ている視聴者は"}, {"type": "subtitle", "time": 17918.55, "timestamp": "04:58:38", "text": "いつもそこにいる、あなたに慣れている人たち"}, {"type": "subtitle", "time": 17921.83, "timestamp": "04:58:41", "text": "あなたに慣れている人たちに積極的に反応する"}, {"type": "subtitle", "time": 17923.51, "timestamp": "04:58:43", "text": "実際にあなたのコメントに反応し、"}, {"type": "subtitle", "time": 17925.35, "timestamp": "04:58:45", "text": "すべて。"}, {"type": "subtitle", "time": 17927.03, "timestamp": "04:58:47", "text": "彼らはこう言うだろう。「ああ、なぜドクは"}, {"type": "subtitle", "time": 17929.03, "timestamp": "04:58:49", "text": "私の話を聞くことは、私の読書を見るのと似ています"}, {"type": "subtitle", "time": 17930.23, "timestamp": "04:58:50", "text": "コメントとか？彼らは"}, {"type": "subtitle", "time": 17932.55, "timestamp": "04:58:52", "text": "イライラしているとか、そんな感じ。それは、それは"}, {"type": "subtitle", "time": 17935.43, "timestamp": "04:58:55", "text": "なぜこれがそこにあるのか。そしてもし"}, {"type": "subtitle", "time": 17937.03, "timestamp": "04:58:57", "text": "モデレーターが"}, {"type": "subtitle", "time": 17939.67, "timestamp": "04:58:59", "text": "チャネルでは、次のように強制することもできます。"}]
[{"type": "subtitle", "time": 8341.349, "timestamp": "02:19:01", "text": "もうすぐ終わります。もうすぐ終わります。"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "そして"}, {"type": "subtitle", "time": 8345.97, "timestamp": "02:19:05", "text": "これ"}, {"type": "subtitle", "time": 8358.79, "timestamp": "02:19:18", "text": "はい、これで終わりです。"}, {"type": "subtitle", "time": 8366.389, "timestamp": "02:19:26", "text": "隅々まで念入りに確認させてください"}, {"type": "subtitle", "time": 8369.99, "timestamp": "02:19:29", "text": "そしてこの隅っこ。それで、タマンタム"}, {"type": "subtitle", "time": 8373.03, "timestamp": "02:19:33", "text": "サービスは正式に完了しました。"}, {"type": "subtitle", "time": 8378.79, "timestamp": "02:19:38", "text": "私はまだ何をすべきかわからない"}, {"type": "subtitle", "time": 8381.589, "timestamp": "02:19:41", "text": "目次の用語で"}, {"type": "subtitle", "time": 8384.309, "timestamp": "02:19:44", "text": "あれ。それはまた別の問題だ"}, {"type": "subtitle", "time": 8387.83, "timestamp": "02:19:47", "text": "私は向き合わなければならない。 O"}, {"type": "subtitle", "time": 8389.83, "timestamp": "02:19:49", "text": "でも、ある意味では、それは達成されたと言えるでしょう。私は"}]
[{"type": "subtitle", "time": 2041.59, "timestamp": "00:34:01", "text": "ええ、彼らに聞いてもいいですが、そのためには"}, {"type": "subtitle", "time": 2044.549, "timestamp": "00:34:04", "text": "彼らと友達にならなければ、"}, {"type": "subtitle", "time": 2048.23, "timestamp": "00:34:08", "text": "父は私のために仕事をする、なぜなら彼らは私の"}, {"type": "subtitle", "time": 2049.75, "timestamp": "00:34:09", "text": "お父さん"}, {"type": "subtitle", "time": 2054.069, "timestamp": "00:34:14", "text": "彼は彼らの土地の所有者だから。"}, {"type": "subtitle", "time": 2056.31, "timestamp": "00:34:16", "text": "でも、自分でやらなきゃいけないだろうね。"}, {"type": "subtitle", "time": 2058.55, "timestamp": "00:34:18", "text": "だって、それが私の趣味だから。私はそうすべきではない"}, {"type": "subtitle", "time": 2061.51, "timestamp": "00:34:21", "text": "私は家族に頼りすぎている。"}, {"type": "subtitle", "time": 2064.55, "timestamp": "00:34:24", "text": "だから来年は、"}, {"type": "subtitle", "time": 2067.829, "timestamp": "00:34:27", "text": "私は一人で、今は日本にいます。私は持っている"}, {"type": "subtitle", "time": 2070.31, "timestamp": "00:34:30", "text": "私はすべてを自分でやらなければならない"}, {"type": "subtitle", "time": 2072.389, "timestamp": "00:34:32", "text": "内向的。"}, {"type": "subtitle", "time": 2087.19, "timestamp": "00:34:47", "text": "ほとんどのものを手に入れたと思います。"}, {"type": "subtitle", "time": 2088.79, "timestamp": "00:34:48", "text": "ケイ"}, {"type": "subtitle", "time": 2092.47, "timestamp": "00:34:52", "text": "悪くはないけど、"}, {"type": "subtitle", "time": 2095.51, "timestamp": "00:34:55", "text": "必要なものがすべて揃っています"}, {"type": "subtitle", "time": 2098.79, "timestamp": "00:34:58", "text": "でも私は"}, {"type": "chat", "time": 2099.097, "timestamp": "00:34:59", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "imagine a world where legall advise wouldnt take a year off your life span"}]
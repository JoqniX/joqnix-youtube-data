[{"type": "subtitle", "time": 9243.11, "timestamp": "02:34:03", "text": "ああ、新しいアップデートがあるよ。サミーの最新情報。"}, {"type": "subtitle", "time": 9246.23, "timestamp": "02:34:06", "text": "では、読んでみましょう。新しいサミーが登場"}, {"type": "subtitle", "time": 9247.429, "timestamp": "02:34:07", "text": "アップデート。待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 9251.27, "timestamp": "02:34:11", "text": "待って。アップデート日バージョン25 2025.2.0"}, {"type": "subtitle", "time": 9254.79, "timestamp": "02:34:14", "text": "脱落しました。私たちはたくさんの愛をもらい、"}, {"type": "subtitle", "time": 9256.71, "timestamp": "02:34:16", "text": "これまでで最大の努力が必要となるだろう。私たちは言う"}, {"type": "subtitle", "time": 9258.79, "timestamp": "02:34:18", "text": "毎回こうなるんだけど、誓って"}, {"type": "subtitle", "time": 9260.95, "timestamp": "02:34:20", "text": "それは本当です。どんどん良くなって、"}, {"type": "subtitle", "time": 9262.87, "timestamp": "02:34:22", "text": "より良い。追加要素がたくさんあるので、"}, {"type": "subtitle", "time": 9264.389, "timestamp": "02:34:24", "text": "変更、そして全体的な推進努力"}, {"type": "subtitle", "time": 9266.71, "timestamp": "02:34:26", "text": "サミーはそちらの方向へ。作業する"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "新規ユーザーにとって使いやすいプログラムで、"}, {"type": "subtitle", "time": 9271.51, "timestamp": "02:34:31", "text": "退役軍人。主力選手に注目して"}, {"type": "subtitle", "time": 9273.51, "timestamp": "02:34:33", "text": "この投稿。"}, {"type": "subtitle", "time": 9276.469, "timestamp": "02:34:36", "text": "非同期から同期へ。 30以上のコマンドが"}, {"type": "subtitle", "time": 9279.67, "timestamp": "02:34:39", "text": "同期動作をサポートするように変更されました。"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "他のコマンドと同じように動作するようにする。おお、"}, {"type": "subtitle", "time": 9286.469, "timestamp": "02:34:46", "text": "手軽なバーのアップグレード。クイックバーは現在"}, {"type": "subtitle", "time": 9288.55, "timestamp": "02:34:48", "text": "頻繁に追加するための新しいボタンがいくつか"}, {"type": "subtitle", "time": 9291.91, "timestamp": "02:34:51", "text": "アクセスだけでなくコマンドも"}, {"type": "subtitle", "time": 9294.95, "timestamp": "02:34:54", "text": "コンテキストに応じたボタンで、"}, {"type": "subtitle", "time": 9297.99, "timestamp": "02:34:57", "text": "Oh の下に示されている、"}]
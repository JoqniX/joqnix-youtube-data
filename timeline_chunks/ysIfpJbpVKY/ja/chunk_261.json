[{"type": "subtitle", "time": 15662.79, "timestamp": "04:21:02", "text": "物やその他場所、その他諸々。しないでください"}, {"type": "subtitle", "time": 15666.07, "timestamp": "04:21:06", "text": "えーっと、そんなことしないで"}, {"type": "subtitle", "time": 15669.75, "timestamp": "04:21:09", "text": "あなたは人々のDiscordサーバーに参加します"}, {"type": "subtitle", "time": 15672.07, "timestamp": "04:21:12", "text": "配信者と交流し、そこで自己宣伝する。私"}, {"type": "chat", "time": 15672.405, "timestamp": "04:21:12", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "oh god twitter. im scared"}, {"type": "subtitle", "time": 15674.55, "timestamp": "04:21:14", "text": "つまり、あなたならできるということです。責められるべきではない"}, {"type": "subtitle", "time": 15678.149, "timestamp": "04:21:18", "text": "しかし、単にコミュニティに参加するだけでは"}, {"type": "subtitle", "time": 15680.95, "timestamp": "04:21:20", "text": "自己宣伝のためだけのDiscordサーバー。あなた"}, {"type": "subtitle", "time": 15683.03, "timestamp": "04:21:23", "text": "関与する必要がある"}, {"type": "subtitle", "time": 15685.189, "timestamp": "04:21:25", "text": "ええと、あのコミュニティとかで。それは"}, {"type": "subtitle", "time": 15687.67, "timestamp": "04:21:27", "text": "それが最善の方法です。だから、そんなことはしないでください。"}, {"type": "subtitle", "time": 15689.51, "timestamp": "04:21:29", "text": "自分自身を宣伝し、"}, {"type": "subtitle", "time": 15691.83, "timestamp": "04:21:31", "text": "ツイッター。次のような形式で行うことができます。"}, {"type": "subtitle", "time": 15694.79, "timestamp": "04:21:34", "text": "私は短いビデオを作っています"}, {"type": "subtitle", "time": 15696.389, "timestamp": "04:21:36", "text": "配信開始。私たちはこれを実行し、"}, {"type": "subtitle", "time": 15699.11, "timestamp": "04:21:39", "text": "それ。ぜひ参加してください。"}, {"type": "subtitle", "time": 15704.229, "timestamp": "04:21:44", "text": "私のストリームに参加して、体験を楽しみましょう"}, {"type": "subtitle", "time": 15706.63, "timestamp": "04:21:46", "text": "あれこれ。フォーマットを作成する。見る"}, {"type": "subtitle", "time": 15708.79, "timestamp": "04:21:48", "text": "その形式が機能するなら。 Twitter動画を活用する"}, {"type": "subtitle", "time": 15710.95, "timestamp": "04:21:50", "text": "そして全て。アップロードしてください"}, {"type": "subtitle", "time": 15713.11, "timestamp": "04:21:53", "text": "Xプレミアムでは動画をアップロードできます"}, {"type": "subtitle", "time": 15715.99, "timestamp": "04:21:55", "text": "もの。広告にも使用できます"}, {"type": "subtitle", "time": 15717.269, "timestamp": "04:21:57", "text": "あなたはそれをしたいと思っていて、"}]
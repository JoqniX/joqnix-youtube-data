[{"type": "subtitle", "time": 10865.41, "timestamp": "03:01:05", "text": "ここへ行ってください。"}, {"type": "subtitle", "time": 10870.469, "timestamp": "03:01:10", "text": "[音楽]"}, {"type": "chat", "time": 10871.092, "timestamp": "03:01:11", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "you better treat it as a placeholder. get a lawyer later maybe"}, {"type": "subtitle", "time": 10874.79, "timestamp": "03:01:14", "text": "しかし、ここでは5ポイントが必要です。"}, {"type": "subtitle", "time": 10877.03, "timestamp": "03:01:17", "text": "３回プレイした方がいいよ。だから私は"}, {"type": "subtitle", "time": 10878.71, "timestamp": "03:01:18", "text": "弁護士は後で呼ぶかもしれない。うん。うん。うん。"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "うん。私はそれをしなければならない。"}, {"type": "subtitle", "time": 10883.91, "timestamp": "03:01:23", "text": "これらは仮のものです。それはとても"}, {"type": "subtitle", "time": 10886.15, "timestamp": "03:01:26", "text": "支払いバスを入手できます"}, {"type": "subtitle", "time": 10898.15, "timestamp": "03:01:38", "text": "つまり、近くに弁護士がいるってことだよ"}, {"type": "subtitle", "time": 10901.51, "timestamp": "03:01:41", "text": "ここ、文字通り隣の部屋です。"}, {"type": "subtitle", "time": 10904.55, "timestamp": "03:01:44", "text": "父に聞いてみないと、"}, {"type": "subtitle", "time": 10908.15, "timestamp": "03:01:48", "text": "彼らは私の書いたものを読むことができる。"}, {"type": "subtitle", "time": 10910.389, "timestamp": "03:01:50", "text": "主なものは3つ、あるいは4つあります"}, {"type": "subtitle", "time": 10913.03, "timestamp": "03:01:53", "text": "弁護士やその他の人たちは"}, {"type": "subtitle", "time": 10915.67, "timestamp": "03:01:55", "text": "朝に来るインターン生たち。 1つ"}, {"type": "subtitle", "time": 10917.99, "timestamp": "03:01:57", "text": "彼らのうちの何人かはいつもそこにいる"}]
[{"type": "subtitle", "time": 6120.229, "timestamp": "01:42:00", "text": "あれ。それがForwellのやり方です。私は"}, {"type": "subtitle", "time": 6123.669, "timestamp": "01:42:03", "text": "私は「うん、これはいいものだ」と思うし"}, {"type": "subtitle", "time": 6127.59, "timestamp": "01:42:07", "text": "でも、もし自分のカスタムが欲しい場合はどうすればいいですか？"}, {"type": "subtitle", "time": 6131.109, "timestamp": "01:42:11", "text": "特注品ですか？私の言いたいこと、分かりますか？"}, {"type": "subtitle", "time": 6133.189, "timestamp": "01:42:13", "text": "うん。もし私が自分の"}, {"type": "subtitle", "time": 6137.189, "timestamp": "01:42:17", "text": "特注品。"}, {"type": "subtitle", "time": 6139.83, "timestamp": "01:42:19", "text": "カスタムとは"}, {"type": "subtitle", "time": 6142.709, "timestamp": "01:42:22", "text": "うん。ドラッグを描いて"}, {"type": "subtitle", "time": 6146.229, "timestamp": "01:42:26", "text": "私のデザインを下ろすと、まるでn8のようです。"}, {"type": "subtitle", "time": 6156.31, "timestamp": "01:42:36", "text": "例えば、"}, {"type": "subtitle", "time": 6158.87, "timestamp": "01:42:38", "text": "えっと"}, {"type": "chat", "time": 6166.469, "timestamp": "01:42:46", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "that might be way to go for beginners"}, {"type": "subtitle", "time": 6172.07, "timestamp": "01:42:52", "text": "どのように表示されるのでしょうか？"}, {"type": "subtitle", "time": 6173.75, "timestamp": "01:42:53", "text": "それが最善の方法かもしれない"}, {"type": "subtitle", "time": 6176.709, "timestamp": "01:42:56", "text": "初心者向け。ええ、見てください、"}, {"type": "subtitle", "time": 6179.51, "timestamp": "01:42:59", "text": "サムネイル。"}]
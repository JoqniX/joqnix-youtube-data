[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "紫色のものが灰色になった"}, {"type": "subtitle", "time": 9425.349, "timestamp": "02:37:05", "text": "ボタン。つまり、同期的に同期するということです。"}, {"type": "chat", "time": 9426.774, "timestamp": "02:37:06", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "now it runs sequentially"}, {"type": "subtitle", "time": 9428.55, "timestamp": "02:37:08", "text": "ああ、それは素晴らしいアップデートだ。"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "拡張機能の同期サポートを追加する"}, {"type": "subtitle", "time": 9433.67, "timestamp": "02:37:13", "text": "利用するためのコマンド。サミを訪ねて"}, {"type": "subtitle", "time": 9435.75, "timestamp": "02:37:15", "text": "ソリューションアクセスブラシ"}, {"type": "subtitle", "time": 9438.15, "timestamp": "02:37:18", "text": "ドキュメント。"}, {"type": "subtitle", "time": 9441.99, "timestamp": "02:37:21", "text": "Oo は、非同期設定を op に追加しました。"}, {"type": "subtitle", "time": 9444.71, "timestamp": "02:37:24", "text": "非同期コマンドかどうかを判断するオプション"}, {"type": "subtitle", "time": 9448.15, "timestamp": "02:37:28", "text": "同期のデフォルト設定である場合に作成されます"}, {"type": "subtitle", "time": 9451.03, "timestamp": "02:37:31", "text": "それは本当です。新しいコマンドを追加します。これらは"}, {"type": "subtitle", "time": 9454.15, "timestamp": "02:37:34", "text": "twitchコマンド。わかった。 Twitch作成"}, {"type": "subtitle", "time": 9458.15, "timestamp": "02:37:38", "text": "このイベント。あ、そういえば"}, {"type": "subtitle", "time": 9460.469, "timestamp": "02:37:40", "text": "ここに写っているチェスの人は"}, {"type": "subtitle", "time": 9464.15, "timestamp": "02:37:44", "text": "最近、sami開発チームが。"}, {"type": "subtitle", "time": 9467.429, "timestamp": "02:37:47", "text": "でも、ほとんどは文字通り"}, {"type": "subtitle", "time": 9470.71, "timestamp": "02:37:50", "text": "多くの新しいアップデートが行われました"}, {"type": "subtitle", "time": 9474.469, "timestamp": "02:37:54", "text": "チェスと、チェスが"}, {"type": "subtitle", "time": 9477.429, "timestamp"
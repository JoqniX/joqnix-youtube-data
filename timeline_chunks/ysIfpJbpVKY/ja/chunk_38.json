[{"type": "subtitle", "time": 2281.349, "timestamp": "00:38:01", "text": "これはそれを持っている。わかった。お持ちですか？"}, {"type": "subtitle", "time": 2283.51, "timestamp": "00:38:03", "text": "あなたは？"}, {"type": "subtitle", "time": 2286.63, "timestamp": "00:38:06", "text": "おお。ああ、犯人が分かったぞ。あなたは持っていません"}, {"type": "subtitle", "time": 2288.55, "timestamp": "00:38:08", "text": "その物。"}, {"type": "subtitle", "time": 2291.109, "timestamp": "00:38:11", "text": "それでは、リスト項目です。"}, {"type": "subtitle", "time": 2294.55, "timestamp": "00:38:14", "text": "H. あなたはどうですか？わかった。この男も"}, {"type": "subtitle", "time": 2297.75, "timestamp": "00:38:17", "text": "リスト項目がありません。わかった。"}, {"type": "subtitle", "time": 2300.95, "timestamp": "00:38:20", "text": "それは奇妙だ。"}, {"type": "subtitle", "time": 2303.829, "timestamp": "00:38:23", "text": "あ、待って。これはどこかからコピーしたものです。"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "右？聖なる。待って。"}, {"type": "subtitle", "time": 2310.15, "timestamp": "00:38:30", "text": "犯人が誰なのか、分かった気がする。"}, {"type": "subtitle", "time": 2313.51, "timestamp": "00:38:33", "text": "あなたです。そうじゃない？どこにいるの？その"}, {"type": "subtitle", "time": 2316.63, "timestamp": "00:38:36", "text": "そう、こいつらだよ。"}, {"type": "subtitle", "time": 2319.27, "timestamp": "00:38:39", "text": "ああ、彼らにはそれがなかったんだ。それは"}, {"type": "subtitle", "time": 2321.349, "timestamp": "00:38:41", "text": "なぜ。"}, {"type": "subtitle", "time": 2324.55, "timestamp": "00:38:44", "text": "何てことだ。"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2336.87, "timestamp": "00:38:56", "text": "つまり、リスト項目では、2 番目のリスト"}]
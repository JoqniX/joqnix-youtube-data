[{"type": "subtitle", "time": 1522.789, "timestamp": "00:25:22", "text": "おお、"}, {"type": "subtitle", "time": 1526.23, "timestamp": "00:25:26", "text": "つまり、私がコンテンツを編集しているとき"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "アパレルを制作する場合、こんな感じでしょうか？"}, {"type": "subtitle", "time": 1536.95, "timestamp": "00:25:36", "text": "わかった。それは素晴らしいですね。"}, {"type": "subtitle", "time": 1539.75, "timestamp": "00:25:39", "text": "それは多少は役に立つだろうが、大した効果はないだろう。"}, {"type": "subtitle", "time": 1543.909, "timestamp": "00:25:43", "text": "たくさんの時間を節約できます。"}, {"type": "subtitle", "time": 1546.39, "timestamp": "00:25:46", "text": "実は"}]
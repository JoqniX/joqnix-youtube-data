[{"type": "subtitle", "time": 2222.47, "timestamp": "00:37:02", "text": "よし、これで1つ目だ。これは"}, {"type": "subtitle", "time": 2230.069, "timestamp": "00:37:10", "text": "これなら分かる。これなら分かる。これなら分かる。"}, {"type": "subtitle", "time": 2232.8, "timestamp": "00:37:12", "text": "これなら分かる。 これはそれを持っていません。わかった。本文。"}, {"type": "subtitle", "time": 2243.99, "timestamp": "00:37:23", "text": "これなら分かる。これなら分かる。うん。"}, {"type": "subtitle", "time": 2251.27, "timestamp": "00:37:31", "text": "そして親。わかった。"}, {"type": "subtitle", "time": 2253.75, "timestamp": "00:37:33", "text": "これはそれを持っていません。わかった。ただ"}, {"type": "subtitle", "time": 2256.79, "timestamp": "00:37:36", "text": "それが含まれていない本文"}, {"type": "subtitle", "time": 2259.19, "timestamp": "00:37:39", "text": "どうやら。"}, {"type": "subtitle", "time": 2261.589, "timestamp": "00:37:41", "text": "なぜそれが付いていないのか不思議だ。それは"}, {"type": "subtitle", "time": 2264.71, "timestamp": "00:37:44", "text": "なぜなら、私はそれを複製していないから、あるいは私は"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "あなたはそれを持っていますか？わかった。あなたは"}, {"type": "subtitle", "time": 2277.91, "timestamp": "00:37:57", "text": "それを持っていますか？これはそれを持っている。これはそうだ。"}]
[{"type": "subtitle", "time": 12961.83, "timestamp": "03:36:01", "text": "いいえ、それはウェブサイトです。いいえ、あなたはそうではありません。それは"}, {"type": "subtitle", "time": 12964.469, "timestamp": "03:36:04", "text": "税金をきちんと納めていれば問題ない"}, {"type": "subtitle", "time": 12968.63, "timestamp": "03:36:08", "text": "適切に、そしてまた、GSTを提供してください"}, {"type": "subtitle", "time": 12971.11, "timestamp": "03:36:11", "text": "番号と登録"}, {"type": "subtitle", "time": 12973.429, "timestamp": "03:36:13", "text": "ビジネスIDとその他すべて"}, {"type": "subtitle", "time": 12975.51, "timestamp": "03:36:15", "text": "もの。言及しなくても構いません"}, {"type": "subtitle", "time": 12977.349, "timestamp": "03:36:17", "text": "あなたの現在地と電話番号と"}, {"type": "subtitle", "time": 12979.99, "timestamp": "03:36:19", "text": "もの。正当なものでなければならない"}, {"type": "subtitle", "time": 12982.469, "timestamp": "03:36:22", "text": "ビジネスとか何か、その他すべて"}, {"type": "subtitle", "time": 12984.389, "timestamp": "03:36:24", "text": "人々は物を注文することができ、"}, {"type": "subtitle", "time": 12987.51, "timestamp": "03:36:27", "text": "それとか、その他諸々、そうだよね？そして"}, {"type": "subtitle", "time": 12989.83, "timestamp": "03:36:29", "text": "結局私も同じことをしなければならない"}, {"type": "subtitle", "time": 12992.309, "timestamp": "03:36:32", "text": "これで完了です。アップロードしなければならない"}, {"type": "subtitle", "time": 12995.75, "timestamp": "03:36:35", "text": "Google Payに動画を録画しました。だからGoogleは"}, {"type": "subtitle", "time": 12997.51, "timestamp": "03:36:37", "text": "私をビジネスとして認証し、"}, {"type": "subtitle", "time": 12999.429, "timestamp": "03:36:39", "text": "すべて。だから彼らは私に"}, {"type": "subtitle", "time": 13002.79, "timestamp": "03:36:42", "text": "Google Payのことですよね？だって、もし私がそうしなかったら"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "以前に気づいた場合"}, {"type": "subtitle", "time": 13008.79, "timestamp": "03:36:48", "text": "えっと"}, {"type": "subtitle", "time": 13014.87, "timestamp": "03:36:54", "text": "いいえ、こちらではGoogle Payが利用できます。"}, {"type": "subtitle", "time": 13017.11, "timestamp": "03:36:57", "text": "Google Payを導入しないのは、"}, {"type": "subtitle", "time": 13019.67, "timestamp": "03:36:59", "text": "彼らはこれを完全に検証しました"}]
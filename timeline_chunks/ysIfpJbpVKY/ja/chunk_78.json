[{"type": "subtitle", "time": 4681.01, "timestamp": "01:18:01", "text": "ちょっとクラウドにログインさせてください。"}, {"type": "subtitle", "time": 4698.31, "timestamp": "01:18:18", "text": "[音楽]"}, {"type": "subtitle", "time": 4706.31, "timestamp": "01:18:26", "text": "正直に言うと、"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "かつて私はこう思っていた"}, {"type": "subtitle", "time": 4711.83, "timestamp": "01:18:31", "text": "NFDを作成する"}, {"type": "subtitle", "time": 4715.43, "timestamp": "01:18:35", "text": "その時、NFDがいかにひどいものかを悟った。あなたはできる"}, {"type": "subtitle", "time": 4718.63, "timestamp": "01:18:38", "text": "スクリーンショットを撮るだけです。"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "それから私は、なぜ私が考えたのか"}, {"type": "subtitle", "time": 4724.47, "timestamp": "01:18:44", "text": "そうした理由は、いや、私は見た"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "上椿スタジオの人たちがそれをやって、"}, {"type": "subtitle", "time": 4730.06, "timestamp": "01:18:50", "text": "今はもうやめました"}, {"type": "subtitle", "time": 4731.669, "timestamp": "01:18:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "彼らは、U の伝承全体を作り上げ、"}, {"type": "subtitle", "time": 4736.79, "timestamp": "01:18:56", "text": "アニメのすべては"}, {"type": "subtitle", "time": 4738.87, "timestamp": "01:18:58", "text": "今まさに上椿で放送中"}]
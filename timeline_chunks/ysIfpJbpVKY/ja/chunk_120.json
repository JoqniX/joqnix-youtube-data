[{"type": "subtitle", "time": 7200.31, "timestamp": "02:00:00", "text": "ランダムなものを作って、"}, {"type": "subtitle", "time": 7207.99, "timestamp": "02:00:07", "text": "1つと"}, {"type": "subtitle", "time": 7223.669, "timestamp": "02:00:23", "text": "ブラウザは、私はヴィヴァルディがとても気に入っています"}, {"type": "subtitle", "time": 7226.95, "timestamp": "02:00:26", "text": "ブラウザ。ジョー、絵は描ける？はい。えっと、"}, {"type": "subtitle", "time": 7230.07, "timestamp": "02:00:30", "text": "若干。すみません、読んだことを忘れていました"}, {"type": "subtitle", "time": 7232.79, "timestamp": "02:00:32", "text": "そうですが、声に出して読むのを忘れてしまいました。"}, {"type": "subtitle", "time": 7236.07, "timestamp": "02:00:36", "text": "先ほどあなたが質問した時。私は色を塗ることができません。"}, {"type": "subtitle", "time": 7238.07, "timestamp": "02:00:38", "text": "私は色塗りが苦手ですが、私は上手です"}, {"type": "subtitle", "time": 7241.03, "timestamp": "02:00:41", "text": "何かを見て、"}, {"type": "subtitle", "time": 7243.43, "timestamp": "02:00:43", "text": "それを再現してください。"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "線画とかは大丈夫です。私たちは"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "最近はアート配信をやるべきですね。私は"}, {"type": "subtitle", "time": 7251.27, "timestamp": "02:00:51", "text": "それらのことはしていませんでした"}]
[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "何てことだ。ニース。わかった。 Twitchの生データ。"}, {"type": "subtitle", "time": 9305.59, "timestamp": "02:35:05", "text": "新しい行描画データトリガーを追加しました"}, {"type": "subtitle", "time": 9307.75, "timestamp": "02:35:07", "text": "既存のすべてのTwitchに価値を引き出す"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "トリガー。だから、もしあなたが望むなら、"}, {"type": "subtitle", "time": 9312.79, "timestamp": "02:35:12", "text": "データに触れるには、"}, {"type": "subtitle", "time": 9315.91, "timestamp": "02:35:15", "text": "Twitchのサブスクリプションも含め、すべてカスタマイズ可能です"}, {"type": "subtitle", "time": 9319.27, "timestamp": "02:35:19", "text": "トリガー。サミーを待つのに疲れた"}, {"type": "subtitle", "time": 9321.59, "timestamp": "02:35:21", "text": "アップデートして素晴らしいものを作りましょう"}, {"type": "subtitle", "time": 9323.11, "timestamp": "02:35:23", "text": "新しい"}, {"type": "subtitle", "time": 9327.19, "timestamp": "02:35:27", "text": "ああ、より速いコマンド関連のコマンド"}, {"type": "subtitle", "time": 9329.75, "timestamp": "02:35:29", "text": "失敗。ボタンを吊るすのはもうやめてください"}, {"type": "subtitle", "time": 9332.469, "timestamp": "02:35:32", "text": "時間修正。代わりに、代わりに解決する"}, {"type": "subtitle", "time": 9335.83, "timestamp": "02:35:35", "text": "すぐに未定義で終了します。"}, {"type": "subtitle", "time": 9339.51, "timestamp": "02:35:39", "text": "ええと、10兆匹の虫を潰します。ない"}, {"type": "subtitle", "time": 9341.99, "timestamp": "02:35:41", "text": "本当に。強力な戦力が揃った。わかった。"}, {"type": "chat", "time": 9344.029, "timestamp": "02:35:44", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "make the good good very good good"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "そしてダウンロード数も大幅に増加しました。わかった。そうねぇ"}, {"type": "subtitle", "time": 9347.91, "timestamp": "02:35:47", "text": "パッチノート。待って。"}, {"type": "subtitle", "time": 9349.75, "timestamp": "02:35:49", "text": "待って。パッチロールを見たい"}, {"type": "subtitle", "time": 9351.59, "timestamp": "02:35:51", "text": "注記。"}, {"type": "subtitle", "time": 9355.51, "timestamp": "02:35:55", "text": "来て。ヴィヴァルディ卿。"}, {"type": "subtitle", "time": 9358.87, "timestamp": "02:35:58", "text": "何てことだ。それをそのままコピーします。"}]
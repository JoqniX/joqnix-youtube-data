[{"type": "subtitle", "time": 5161.669, "timestamp": "01:26:01", "text": "あーあ、広告だけが必要だと気づいた"}, {"type": "subtitle", "time": 5164.709, "timestamp": "01:26:04", "text": "休憩のリマインダー"}, {"type": "subtitle", "time": 5168.31, "timestamp": "01:26:08", "text": "えーっと、私たちがえーっと"}, {"type": "subtitle", "time": 5172.07, "timestamp": "01:26:12", "text": "ライブでライブライブライブライブ、そう、私たちは"}, {"type": "subtitle", "time": 5175.43, "timestamp": "01:26:15", "text": "アクティブに活動していないときは必要ない"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "ストリーム右に存在する"}, {"type": "subtitle", "time": 5181.27, "timestamp": "01:26:21", "text": "それで、どういうわけか"}, {"type": "subtitle", "time": 5184.95, "timestamp": "01:26:24", "text": "自動化して、私がBRBにいるときに"}, {"type": "subtitle", "time": 5188.229, "timestamp": "01:26:28", "text": "そのシーンはTwitchには投稿されません"}, {"type": "subtitle", "time": 5192.07, "timestamp": "01:26:32", "text": "チャットして、私がただ"}, {"type": "subtitle", "time": 5194.79, "timestamp": "01:26:34", "text": "実際にストリームに存在している"}, {"type": "subtitle", "time": 5196.79, "timestamp": "01:26:36", "text": "それを投稿するだけ、または次のような"}, {"type": "subtitle", "time": 5200.47, "timestamp": "01:26:40", "text": "それ。ああ、それを十字にしないといけない"}, {"type": "subtitle", "time": 5203.43, "timestamp": "01:26:43", "text": "私がYouTubeでライブ配信中かどうかを確認します。"}, {"type": "subtitle", "time": 5205.59, "timestamp": "01:26:45", "text": "その場合は、その種類の設定のみを行ってください。あなた"}, {"type": "subtitle", "time": 5208.39, "timestamp": "01:26:48", "text": "そうしなければならない。あなたはただ米国を稼ぐことができます"}, {"type": "subtitle", "time": 5209.99, "timestamp": "01:26:49", "text": "ドルをインド・ルピーに換算する。"}, {"type": "subtitle", "time": 5213.02, "timestamp": "01:26:53", "text": "ええ、私もそうできますよ。"}, {"type": "subtitle", "time": 5214.87, "timestamp": "01:26:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 3541.829, "timestamp": "00:59:01", "text": "昨日気を失って、目が覚めたのは"}, {"type": "subtitle", "time": 3545.27, "timestamp": "00:59:05", "text": "えっと、午前3時、午前4時。それから寝てしまった。"}, {"type": "subtitle", "time": 3547.75, "timestamp": "00:59:07", "text": "また起きて、6時に目が覚めた。まだ"}, {"type": "subtitle", "time": 3550.39, "timestamp": "00:59:10", "text": "眠った。聖なる。"}, {"type": "subtitle", "time": 3553.03, "timestamp": "00:59:13", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "何てことだ。"}, {"type": "subtitle", "time": 3564.87, "timestamp": "00:59:24", "text": "何してるの？"}, {"type": "subtitle", "time": 3567.67, "timestamp": "00:59:27", "text": "なぜ寝ていないのですか？"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "でも、そう、気分が悪い時は寝てください"}, {"type": "subtitle", "time": 3572.95, "timestamp": "00:59:32", "text": "眠い。幸運を。"}, {"type": "subtitle", "time": 3582.63, "timestamp": "00:59:42", "text": "さて、ここから先は"}, {"type": "subtitle", "time": 3585.43, "timestamp": "00:59:45", "text": "変更するべきですよね？ユーザー投稿と"}, {"type": "subtitle", "time": 3587.51, "timestamp": "00:59:47", "text": "相互作用。"}, {"type": "subtitle", "time": 3589.51, "timestamp": "00:59:49", "text": "私は夜寝るのが好きではありません。ああ、"}, {"type": "subtitle", "time": 3591.109, "timestamp": "00:59:51", "text": "神、"}, {"type": "subtitle", "time": 3594.069, "timestamp": "00:59:54", "text": "あなたの言い方だと夜みたい"}, {"type": "subtitle", "time": 3595.589, "timestamp": "00:59:55", "text": "フクロウ。"}]
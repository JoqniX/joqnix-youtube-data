[{"type": "subtitle", "time": 17822.23, "timestamp": "04:57:02", "text": "ええと、もしあなたが観客がいることに気づいたら"}, {"type": "subtitle", "time": 17825.03, "timestamp": "04:57:05", "text": "米国、シンガポール、インドネシアから、"}, {"type": "subtitle", "time": 17826.55, "timestamp": "04:57:06", "text": "世界の他の地域では、"}, {"type": "subtitle", "time": 17831.43, "timestamp": "04:57:11", "text": "彼らにも同じように対応します"}, {"type": "subtitle", "time": 17834.628, "timestamp": "04:57:14", "text": "たくさんのことが正しく"}, {"type": "subtitle", "time": 17837.51, "timestamp": "04:57:17", "text": "そしてコラボレーションに関しては"}, {"type": "chat", "time": 17839.685, "timestamp": "04:57:19", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "how to expand globally?"}, {"type": "subtitle", "time": 17840.31, "timestamp": "04:57:20", "text": "問題は一つあります。"}, {"type": "subtitle", "time": 17842.55, "timestamp": "04:57:22", "text": "協力パートナーの1つは大きく、"}, {"type": "subtitle", "time": 17844.47, "timestamp": "04:57:24", "text": "彼らはより多くのビューや物を持っていて、"}, {"type": "subtitle", "time": 17847.91, "timestamp": "04:57:27", "text": "自分のことをしている人はいますか"}, {"type": "subtitle", "time": 17850.23, "timestamp": "04:57:30", "text": "最高で、あなたはより小さなストリーマーです"}, {"type": "subtitle", "time": 17853.99, "timestamp": "04:57:33", "text": "再生回数も少なく、何もかもが減った。そして、"}, {"type": "subtitle", "time": 17855.43, "timestamp": "04:57:35", "text": "コラボ配信をやっているんだね、"}, {"type": "subtitle", "time": 17857.75, "timestamp": "04:57:37", "text": "チャットが空で、"}, {"type": "subtitle", "time": 17859.99, "timestamp": "04:57:39", "text": "多くの人があなたのコラボレーションについて話しています"}, {"type": "subtitle", "time": 17863.35, "timestamp": "04:57:43", "text": "人気ストリーマーのパートナー、または"}, {"type": "subtitle", "time": 17866.31, "timestamp": "04:57:46", "text": "良い観客だった。彼らは、彼らが持っていることを知っている"}, {"type": "subtitle", "time": 17868.23, "timestamp": "04:57:48", "text": "彼らのチャットは活発だし、いろいろと面白い。"}, {"type": "subtitle", "time": 17870.23, "timestamp": "04:57:50", "text": "時にはそれがあなたの精神に影響を与えることがあります"}, {"type": "subtitle", "time": 17872.788, "timestamp": "04:57:52", "text": "健康のためですよね？時々"}, {"type": "subtitle", "time": 17874.55, "timestamp": "04:57:54", "text": "あなたのメンタルヘルスにどう影響するか"}, {"type": "subtitle", "time": 17877.75, "timestamp": "04:57:57", "text": "コラボ配信中にパフォーマンスを行う。もし"}]
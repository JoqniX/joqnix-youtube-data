[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "インド・ルピーは取り扱っていません。そうです"}, {"type": "subtitle", "time": 4564.95, "timestamp": "01:16:04", "text": "UPI決済に対応していません。すべてPayPalです"}, {"type": "subtitle", "time": 4566.87, "timestamp": "01:16:06", "text": "そして、これを見て寄付をしてください。これ"}, {"type": "subtitle", "time": 4569.189, "timestamp": "01:16:09", "text": "私が付け加えたいのは、まさにその点です。"}, {"type": "subtitle", "time": 4571.669, "timestamp": "01:16:11", "text": "こんな感じ。だから誰でも好きになれる"}, {"type": "subtitle", "time": 4574.149, "timestamp": "01:16:14", "text": "1ルピーなどのカスタム金額を入力してください"}, {"type": "subtitle", "time": 4575.91, "timestamp": "01:16:15", "text": "何かを送って、"}, {"type": "subtitle", "time": 4580.07, "timestamp": "01:16:20", "text": "メッセージが表示され、ストリームに表示されます。"}, {"type": "subtitle", "time": 4582.79, "timestamp": "01:16:22", "text": "などなど、そうですよね？"}, {"type": "subtitle", "time": 4585.51, "timestamp": "01:16:25", "text": "うん。私を阻む唯一のものは"}, {"type": "subtitle", "time": 4589.99, "timestamp": "01:16:29", "text": "これをしないのは、単にサイト構築者の問題です。"}, {"type": "subtitle", "time": 4592.39, "timestamp": "01:16:32", "text": "PayPalはAyaに変換されるんですよね？でもあなたは"}, {"type": "subtitle", "time": 4596.229, "timestamp": "01:16:36", "text": "PayPalの手数料を忘れてた。"}, {"type": "subtitle", "time": 4599.189, "timestamp": "01:16:39", "text": "そうですよね？ PayPalは手数料を取り、"}, {"type": "subtitle", "time": 4617.83, "timestamp": "01:16:57", "text": "[音楽]"}]
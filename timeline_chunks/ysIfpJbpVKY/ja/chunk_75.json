[{"type": "subtitle", "time": 4504.31, "timestamp": "01:15:04", "text": "あるいは、そんな感じですよね？そうそう。"}, {"type": "subtitle", "time": 4506.47, "timestamp": "01:15:06", "text": "あれはどうなったの？やってみました。"}, {"type": "subtitle", "time": 4509.91, "timestamp": "01:15:09", "text": "いいえ、片面デザインです。私はほしくない"}, {"type": "subtitle", "time": 4512.47, "timestamp": "01:15:12", "text": "これを設計する。"}, {"type": "subtitle", "time": 4514.709, "timestamp": "01:15:14", "text": "他の場所に持っていくことはできないのですか？"}, {"type": "subtitle", "time": 4517.59, "timestamp": "01:15:17", "text": "なぜ私は好きになれないの？"}, {"type": "subtitle", "time": 4521.51, "timestamp": "01:15:21", "text": "私はこれが好きじゃない。"}, {"type": "subtitle", "time": 4524.149, "timestamp": "01:15:24", "text": "なぜできないの？ああ、そうだね。彼らは"}, {"type": "subtitle", "time": 4525.99, "timestamp": "01:15:25", "text": "テンプレート"}, {"type": "subtitle", "time": 4530.55, "timestamp": "01:15:30", "text": "プライバシーポリシーなど全て既に"}, {"type": "subtitle", "time": 4536.95, "timestamp": "01:15:36", "text": "えっと"}, {"type": "subtitle", "time": 4539.11, "timestamp": "01:15:39", "text": "[音楽]"}, {"type": "subtitle", "time": 4541.91, "timestamp": "01:15:41", "text": "ええ、私は実際にプライバシーポリシーを持っています"}, {"type": "subtitle", "time": 4544.39, "timestamp": "01:15:44", "text": "あれ。"}, {"type": "subtitle", "time": 4557.83, "timestamp": "01:15:57", "text": "そして今、これに関して唯一悲しいことは"}]
[{"type": "subtitle", "time": 3001.75, "timestamp": "00:50:01", "text": "問題は、私には適切な"}, {"type": "subtitle", "time": 3005.75, "timestamp": "00:50:05", "text": "ストアページはまだですよね？"}, {"type": "subtitle", "time": 3008.71, "timestamp": "00:50:08", "text": "正直に言うと、私は"}, {"type": "subtitle", "time": 3011.109, "timestamp": "00:50:11", "text": "完全に無一文。私は何も持っていません"}, {"type": "subtitle", "time": 3014.79, "timestamp": "00:50:14", "text": "今のところ私の名前はこれです。私は一文無しです。のように"}, {"type": "subtitle", "time": 3017.03, "timestamp": "00:50:17", "text": "もし私が望むなら、"}, {"type": "subtitle", "time": 3018.87, "timestamp": "00:50:18", "text": "Shopify"}, {"type": "subtitle", "time": 3021.43, "timestamp": "00:50:21", "text": "店。しかし、Shopifyは"}, {"type": "subtitle", "time": 3026.63, "timestamp": "00:50:26", "text": "はぁ？"}, {"type": "subtitle", "time": 3030.39, "timestamp": "00:50:30", "text": "20ルピー。何？ 3つのプログラムにサインアップしてください"}, {"type": "subtitle", "time": 3032.549, "timestamp": "00:50:32", "text": "無料トライアルで6ヶ月間お楽しみください"}, {"type": "subtitle", "time": 3035.51, "timestamp": "00:50:35", "text": "Spotify Shopify。"}, {"type": "subtitle", "time": 3038.069, "timestamp": "00:50:38", "text": "今までずっとSpotifyって言ってたっけ？"}, {"type": "subtitle", "time": 3041.109, "timestamp": "00:50:41", "text": "何てことだ。でも、これは高いですね。"}, {"type": "subtitle", "time": 3043.27, "timestamp": "00:50:43", "text": "実は。待って、"}, {"type": "subtitle", "time": 3046.23, "timestamp": "00:50:46", "text": "いくらかかりますか？"}, {"type": "subtitle", "time": 3050.23, "timestamp": "00:50:50", "text": "Shopifyを3日間無料でお試しください。いいえ、いいえ、"}, {"type": "subtitle", "time": 3052.39, "timestamp": "00:50:52", "text": "いや、いや、いや、いや、いや。あなたは"}, {"type": "subtitle", "time": 3056.39, "timestamp": "00:50:56", "text": "真実を語る。本当の値段を教えてください"}, {"type": "subtitle", "time": 3058.87, "timestamp": "00:50:58", "text": "1ヶ月間"}]
[{"type": "subtitle", "time": 1742.87, "timestamp": "00:29:02", "text": "ビジネスポリシーページ。"}, {"type": "subtitle", "time": 1746.07, "timestamp": "00:29:06", "text": "ポリシーページ。うん。どうやらこれは"}, {"type": "subtitle", "time": 1749.19, "timestamp": "00:29:09", "text": "ポリシーページは重要です。だから私は"}, {"type": "subtitle", "time": 1752.149, "timestamp": "00:29:12", "text": "銀行口座を最新の状態にしようとしています"}, {"type": "subtitle", "time": 1754.95, "timestamp": "00:29:14", "text": "jocknのアカウントは現在完全に公開されています。"}, {"type": "subtitle", "time": 1758.07, "timestamp": "00:29:18", "text": "完了しました。しかし"}, {"type": "subtitle", "time": 1760.87, "timestamp": "00:29:20", "text": "えーと、私が応募しようとしていたとき"}, {"type": "subtitle", "time": 1762.87, "timestamp": "00:29:22", "text": "決済処理業者、"}, {"type": "subtitle", "time": 1768.549, "timestamp": "00:29:28", "text": "そう、彼らは尋ねた"}, {"type": "subtitle", "time": 1772.389, "timestamp": "00:29:32", "text": "利用規約などのポリシーページ"}, {"type": "subtitle", "time": 1774.149, "timestamp": "00:29:34", "text": "ええ、利用規約、利用規約と"}, {"type": "subtitle", "time": 1777.83, "timestamp": "00:29:37", "text": "条件や返金ポリシーなど"}, {"type": "subtitle", "time": 1780.87, "timestamp": "00:29:40", "text": "ウェブサイトのプライバシーポリシーと"}, {"type": "subtitle", "time": 1783.029, "timestamp": "00:29:43", "text": "すべて。だから私は「よし、私は"}, {"type": "subtitle", "time": 1786.47, "timestamp": "00:29:46", "text": "それでも私はそれをやらなければならない。」ふむ。それで私は"}, {"type": "subtitle", "time": 1788.789, "timestamp": "00:29:48", "text": "今日それを実行する。さあ、始めよう"}, {"type": "subtitle", "time": 1790.47, "timestamp": "00:29:50", "text": "昨日。それを終えました。これは"}, {"type": "subtitle", "time": 1792.87, "timestamp": "00:29:52", "text": "プライバシーポリシーページ。私たちはこれを終えました"}, {"type": "subtitle", "time": 1795.59, "timestamp": "00:29:55", "text": "昨日。えっと、今日は"}, {"type": "subtitle", "time": 1799.029, "timestamp": "00:29:59", "text": "利用規約ページと返金"}]
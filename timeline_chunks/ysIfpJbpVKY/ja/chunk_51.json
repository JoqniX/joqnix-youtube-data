[{"type": "subtitle", "time": 3061.75, "timestamp": "00:51:01", "text": "価格設定。"}, {"type": "subtitle", "time": 3066.71, "timestamp": "00:51:06", "text": "聖なる主よ、"}, {"type": "subtitle", "time": 3072.549, "timestamp": "00:51:12", "text": "1ヶ月で1500ドル？高い、"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "兄弟。値段が高い。値段が高い。"}, {"type": "subtitle", "time": 3079.19, "timestamp": "00:51:19", "text": "私はあまり持っていません。"}, {"type": "subtitle", "time": 3081.349, "timestamp": "00:51:21", "text": "これの2倍は私がしなければならないものです"}, {"type": "subtitle", "time": 3083.51, "timestamp": "00:51:23", "text": "音楽ソフトウェアの料金を支払ってください。私はそうは思わない"}, {"type": "subtitle", "time": 3086.069, "timestamp": "00:51:26", "text": "給料すら払えなかったから、それも打ち切らざるを得なかった。私"}, {"type": "subtitle", "time": 3088.47, "timestamp": "00:51:28", "text": "私はそのサブスクリプションを一時停止しなければならなかったので"}, {"type": "subtitle", "time": 3094.95, "timestamp": "00:51:34", "text": "これはいくらですか？何を計画していますか？"}, {"type": "subtitle", "time": 3097.03, "timestamp": "00:51:37", "text": "売る？マーチD。"}, {"type": "subtitle", "time": 3099.51, "timestamp": "00:51:39", "text": "私たちは取り組んでいます。私は銀行口座を持っています。"}, {"type": "subtitle", "time": 3102.39, "timestamp": "00:51:42", "text": "アカウント。ということで、グッズを販売します"}, {"type": "subtitle", "time": 3105.51, "timestamp": "00:51:45", "text": "インドの人々のためのデジタルとフィジカル"}, {"type": "chat", "time": 3105.718, "timestamp": "00:51:45", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "emotional damage"}, {"type": "subtitle", "time": 3108.71, "timestamp": "00:51:48", "text": "今のところ。そして、うまくいけば、"}, {"type": "subtitle", "time": 3110.39, "timestamp": "00:51:50", "text": "製品の品質もその他すべて良好です"}, {"type": "subtitle", "time": 3112.069, "timestamp": "00:51:52", "text": "良い、"}, {"type": "subtitle", "time": 3114.95, "timestamp": "00:51:54", "text": "えっと、できるかどうか確認してみます"}, {"type": "subtitle", "time": 3117.589, "timestamp": "00:51:57", "text": "国際決済、国際"}]
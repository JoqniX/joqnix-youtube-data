[{"type": "subtitle", "time": 13863.51, "timestamp": "03:51:03", "text": "自分の声を投稿してみようと思った。"}, {"type": "subtitle", "time": 13865.91, "timestamp": "03:51:05", "text": "自分の声を提出しようと思ったので、"}, {"type": "subtitle", "time": 13867.67, "timestamp": "03:51:07", "text": "もし私が無料で手に入れられるなら"}, {"type": "subtitle", "time": 13870.389, "timestamp": "03:51:10", "text": "欲しい"}, {"type": "subtitle", "time": 13873.429, "timestamp": "03:51:13", "text": "そして私はその問題点に気づいた。"}, {"type": "subtitle", "time": 13875.67, "timestamp": "03:51:15", "text": "私はします"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "うん、応募しようと思ったよ"}, {"type": "subtitle", "time": 13880.469, "timestamp": "03:51:20", "text": "私がこのことについて自分の意見を述べると、"}, {"type": "subtitle", "time": 13883.11, "timestamp": "03:51:23", "text": "いや、そうすべきではないと気づいた。"}, {"type": "subtitle", "time": 13886.63, "timestamp": "03:51:26", "text": "将来、多くの問題に対処する"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "たとえ私がそれを削除したいと思っても、"}, {"type": "subtitle", "time": 13892.469, "timestamp": "03:51:32", "text": "欲しくないとか、そういうこと"}, {"type": "subtitle", "time": 13894.79, "timestamp": "03:51:34", "text": "ええ、それは大きな悪だと分かっています"}, {"type": "subtitle", "time": 13896.87, "timestamp": "03:51:36", "text": "もの。"}, {"type": "subtitle", "time": 13898.95, "timestamp": "03:51:38", "text": "あら、そうではなかったのですか？これを見てください。彼らは"}, {"type": "subtitle", "time": 13900.87, "timestamp": "03:51:40", "text": "会社登録情報を提供しました"}, {"type": "subtitle", "time": 13904.309, "timestamp": "03:51:44", "text": "数字、すべて。"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "それはすごくクールですね。ああ、返金があるよ"}, {"type": "subtitle", "time": 13915.189, "timestamp": "03:51:55", "text": "[音楽]"}, {"type": "subtitle", "time": 13918.71, "timestamp": "03:51:58", "text": "彼らにはCEOとかがいるんだ。仕事"}]
[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "自分。もし私が泣いたら"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "私にも同じことが起こりました。私はこう思うだろう"}, {"type": "subtitle", "time": 967.91, "timestamp": "00:16:07", "text": "臭い？"}, {"type": "subtitle", "time": 988.71, "timestamp": "00:16:28", "text": "[音楽]"}, {"type": "subtitle", "time": 992.31, "timestamp": "00:16:32", "text": "私はある経験で、"}, {"type": "subtitle", "time": 995.35, "timestamp": "00:16:35", "text": "重たい香水のように"}, {"type": "subtitle", "time": 999.67, "timestamp": "00:16:39", "text": "えっと、私のクラスか何かに、そして私は"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "うっかりスプレーしすぎちゃった"}, {"type": "subtitle", "time": 1008.31, "timestamp": "00:16:48", "text": "そして私は香水の匂いを強く感じた"}, {"type": "subtitle", "time": 1010.629, "timestamp": "00:16:50", "text": "そして教室全体が"}, {"type": "subtitle", "time": 1013.91, "timestamp": "00:16:53", "text": "私を指差している。長かった"}, {"type": "subtitle", "time": 1017.11, "timestamp": "00:16:57", "text": "後ろ、ずっと後ろ。"}]
[{"type": "subtitle", "time": 784.87, "timestamp": "00:13:04", "text": "実は、特に好きなものはありません。"}, {"type": "subtitle", "time": 789.269, "timestamp": "00:13:09", "text": "えっと、わかりません。私はあまり知らない"}, {"type": "subtitle", "time": 794.31, "timestamp": "00:13:14", "text": "香水ブランドですが、正直に言うと"}, {"type": "subtitle", "time": 799.19, "timestamp": "00:13:19", "text": "いい匂いがするものなら何でもいいと思う"}, {"type": "subtitle", "time": 802.71, "timestamp": "00:13:22", "text": "いい匂いがするものなら何でもいいし、"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "多すぎないですよね？"}, {"type": "subtitle", "time": 813.829, "timestamp": "00:13:33", "text": "かなり多いように感じます"}, {"type": "subtitle", "time": 816.71, "timestamp": "00:13:36", "text": "香水ブランドは現在"}, {"type": "subtitle", "time": 819.43, "timestamp": "00:13:39", "text": "えっと"}, {"type": "subtitle", "time": 821.99, "timestamp": "00:13:41", "text": "ええ、香水の香りがかなり強いですね"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "走るんだよね？ここに香水があります"}, {"type": "subtitle", "time": 828.949, "timestamp": "00:13:48", "text": "私の配信ルーム。これは何ですか？えっと、それは"}, {"type": "subtitle", "time": 834.31, "timestamp": "00:13:54", "text": "樹液、サピル、サピルと呼ばれる"}, {"type": "subtitle", "time": 838.71, "timestamp": "00:13:58", "text": "樹木。これは一体何の固体ですか？"}]
[{"type": "subtitle", "time": 15302.0, "timestamp": "04:15:02", "text": "ええ、それは良くないですね。悪い。"}, {"type": "subtitle", "time": 15315.189, "timestamp": "04:15:15", "text": "それはまるで私が両親に"}, {"type": "subtitle", "time": 15318.87, "timestamp": "04:15:18", "text": "親の情報、このような"}, {"type": "subtitle", "time": 15322.07, "timestamp": "04:15:22", "text": "安全ではないし、すべて"}, {"type": "subtitle", "time": 15332.11, "timestamp": "04:15:32", "text": "暗闇は生意気なヴァカです、あなたは何をしますか"}, {"type": "subtitle", "time": 15339.349, "timestamp": "04:15:39", "text": "[音楽]"}, {"type": "subtitle", "time": 15340.58, "timestamp": "04:15:40", "text": "もっと"}, {"type": "subtitle", "time": 15344.07, "timestamp": "04:15:44", "text": "[音楽]"}]
[{"type": "subtitle", "time": 2525.829, "timestamp": "00:42:05", "text": "私は、音量が"}, {"type": "subtitle", "time": 2528.63, "timestamp": "00:42:08", "text": "低すぎる。私は耳を澄ませて"}, {"type": "subtitle", "time": 2531.589, "timestamp": "00:42:11", "text": "自分のストリーム。"}, {"type": "subtitle", "time": 2534.79, "timestamp": "00:42:14", "text": "ええと、そうなんです、VCPは聴けません"}, {"type": "subtitle", "time": 2538.71, "timestamp": "00:42:18", "text": "プレイヤーはこれを実行しているため"}, {"type": "subtitle", "time": 2541.03, "timestamp": "00:42:21", "text": "バーチャルケーブル"}, {"type": "subtitle", "time": 2543.67, "timestamp": "00:42:23", "text": "2番 YO2"}, {"type": "subtitle", "time": 2546.95, "timestamp": "00:42:26", "text": "そして、これが送信されています。あ、待って。いいえ。ええ。"}, {"type": "subtitle", "time": 2548.71, "timestamp": "00:42:28", "text": "うん。だから、私はそれを聴くことができない。私は思う"}, {"type": "subtitle", "time": 2559.51, "timestamp": "00:42:39", "text": "ああ、これはジャズタイプのギターですね"}, {"type": "subtitle", "time": 2561.51, "timestamp": "00:42:41", "text": "そしてすべてとジャズギターまたは"}, {"type": "subtitle", "time": 2563.99, "timestamp": "00:42:43", "text": "何か。"}, {"type": "chat", "time": 2565.198, "timestamp": "00:42:45", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "is that the song that every one is making sad edit"}, {"type": "subtitle", "time": 2570.95, "timestamp": "00:42:50", "text": "それはみんなが歌っている曲ですか"}, {"type": "subtitle", "time": 2573.03, "timestamp": "00:42:53", "text": "悲しませている？いや、いや、いや、いや。これらは"}, {"type": "subtitle", "time": 2575.349, "timestamp": "00:42:55", "text": "オリジナル曲。"}, {"type": "subtitle", "time": 2577.03, "timestamp": "00:42:57", "text": "いや、いや。私は他人のゲームをプレイしません"}, {"type": "subtitle", "time": 2579.51, "timestamp": "00:42:59", "text": "歌。これらはまるで"}]
[{"type": "subtitle", "time": 11461.99, "timestamp": "03:11:01", "text": "見たことあります 見たことありません 見ていません"}, {"type": "subtitle", "time": 11464.23, "timestamp": "03:11:04", "text": "知っているが"}, {"type": "subtitle", "time": 11468.95, "timestamp": "03:11:08", "text": "例：umを除外、企業を除外"}, {"type": "subtitle", "time": 11471.19, "timestamp": "03:11:11", "text": "独立系に関しては、私は誰にも会っていません"}, {"type": "subtitle", "time": 11474.95, "timestamp": "03:11:14", "text": "できません。だから、私は入っていく"}, {"type": "subtitle", "time": 11477.99, "timestamp": "03:11:17", "text": "何の予備知識もなく、盲目的に。それで、"}, {"type": "subtitle", "time": 11484.79, "timestamp": "03:11:24", "text": "インドに代理店があったら"}, {"type": "subtitle", "time": 11486.71, "timestamp": "03:11:26", "text": "インドでは、彼らはインド人を作っただろう"}, {"type": "subtitle", "time": 11488.469, "timestamp": "03:11:28", "text": "優勝した人たちから盗んだアイドル"}, {"type": "subtitle", "time": 11490.55, "timestamp": "03:11:30", "text": "オーディション。"}, {"type": "subtitle", "time": 11493.83, "timestamp": "03:11:33", "text": "それはまだ見ていません。ここでは、"}, {"type": "subtitle", "time": 11496.15, "timestamp": "03:11:36", "text": "ここではヤゴの夢を見たことがない。私たちは"}, {"type": "subtitle", "time": 11511.11, "timestamp": "03:11:51", "text": "私はただ、ある代理店が"}, {"type": "subtitle", "time": 11515.99, "timestamp": "03:11:55", "text": "そういう企業を持つような"}, {"type": "subtitle", "time": 11519.269, "timestamp": "03:11:59", "text": "えっと、3Dコンサートとかそういうのと、エリアみたいな感じ"}]
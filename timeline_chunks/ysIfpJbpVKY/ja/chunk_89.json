[{"type": "subtitle", "time": 5343.03, "timestamp": "01:29:03", "text": "だから私はその約束を破るべきではない"}, {"type": "subtitle", "time": 5345.669, "timestamp": "01:29:05", "text": "わあ、私は自分自身に与えた、"}, {"type": "subtitle", "time": 5348.87, "timestamp": "01:29:08", "text": "右？もし私がそれを壊してしまったとしたら、それはまずいことだ。だから私は"}, {"type": "subtitle", "time": 5352.55, "timestamp": "01:29:12", "text": "それを破らないように気をつけなければならない。"}, {"type": "subtitle", "time": 5355.75, "timestamp": "01:29:15", "text": "特に、私は自分の個人的なお金を使います。私"}, {"type": "subtitle", "time": 5361.27, "timestamp": "01:29:21", "text": "運動選手の金には手を出さないでおこう"}, {"type": "subtitle", "time": 5363.27, "timestamp": "01:29:23", "text": "なぜなら、私は確認しなければならないからです"}, {"type": "subtitle", "time": 5365.83, "timestamp": "01:29:25", "text": "今は悪用しないように気をつけます。"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "今は君たちのお金だ。だから私は"}, {"type": "subtitle", "time": 5383.83, "timestamp": "01:29:43", "text": "自分自身を解き放て。こんにちは。私はそうはしません。"}, {"type": "subtitle", "time": 5385.669, "timestamp": "01:29:45", "text": "うん。私は絶対にしないようにしなければならない"}, {"type": "subtitle", "time": 5393.91, "timestamp": "01:29:53", "text": "話し方：これを終わらせるだけ"}, {"type": "subtitle", "time": 5395.75, "timestamp": "01:29:55", "text": "そして、私は何かをするだろう。はい、私は"}, {"type": "subtitle", "time": 5399.35, "timestamp": "01:29:59", "text": "一つのアイデア。今、ぼやけたものが"}]
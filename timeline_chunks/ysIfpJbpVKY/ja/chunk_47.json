[{"type": "subtitle", "time": 2820.63, "timestamp": "00:47:00", "text": "実はサポートチケットを作成しました。"}, {"type": "subtitle", "time": 2838.309, "timestamp": "00:47:18", "text": "このメールは、"}, {"type": "subtitle", "time": 2840.47, "timestamp": "00:47:20", "text": "あなたのオンライン加盟店アカウント。に"}, {"type": "subtitle", "time": 2846.15, "timestamp": "00:47:26", "text": "または、あなたの"}, {"type": "subtitle", "time": 2847.75, "timestamp": "00:47:27", "text": "オンラインマーチャントアカウント、私たちは親切に"}, {"type": "subtitle", "time": 2849.19, "timestamp": "00:47:29", "text": "動画を送っていただくようお願いします"}, {"type": "subtitle", "time": 2851.19, "timestamp": "00:47:31", "text": "支払いフローのデモンストレーション"}, {"type": "subtitle", "time": 2853.589, "timestamp": "00:47:33", "text": "あなたのビジネスウェブサイトで利用可能または"}, {"type": "subtitle", "time": 2856.23, "timestamp": "00:47:36", "text": "アプリ。支払いの流れのビデオについては、"}, {"type": "subtitle", "time": 2858.15, "timestamp": "00:47:38", "text": "以下の手順に従ってください。商品を追加する"}, {"type": "subtitle", "time": 2861.51, "timestamp": "00:47:41", "text": "あなたのカードへ。チェックに進んでください"}, {"type": "subtitle", "time": 2864.069, "timestamp": "00:47:44", "text": "支払いまで処理を続けます"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "ステージ。記録全体を記録します"}, {"type": "subtitle", "time": 2870.47, "timestamp": "00:47:50", "text": "全プロセス。私たちに送ってください"}, {"type": "subtitle", "time": 2871.67, "timestamp": "00:47:51", "text": "目的のためにビデオを録画する"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "男性による検証。"}, {"type": "subtitle", "time": 2879.19, "timestamp": "00:47:59", "text": "私はその設定をしていません。私は"}]
[{"type": "subtitle", "time": 9480.55, "timestamp": "02:38:00", "text": "あなたの名前を間違って発音しました。クレサンは"}, {"type": "subtitle", "time": 9484.469, "timestamp": "02:38:04", "text": "Sammyのソフトウェアはこれで終わりだ。私は"}, {"type": "subtitle", "time": 9488.63, "timestamp": "02:38:08", "text": "ハッピー。わかった。アクティブイベントサブを取得する"}, {"type": "subtitle", "time": 9491.51, "timestamp": "02:38:11", "text": "サブスクリプション。イベントの購読を削除します。"}, {"type": "subtitle", "time": 9494.23, "timestamp": "02:38:14", "text": "再マッピング。これは何ですか？ブルップ。何が"}, {"type": "subtitle", "time": 9496.469, "timestamp": "02:38:16", "text": "これ？新しいコマンド。わかった。新しいものを追加する"}, {"type": "subtitle", "time": 9499.59, "timestamp": "02:38:19", "text": "トリガー。 Twitchの連続視聴記録。ああ、見て"}, {"type": "subtitle", "time": 9501.91, "timestamp": "02:38:21", "text": "連勝記録がここにあります。"}, {"type": "subtitle", "time": 9504.389, "timestamp": "02:38:24", "text": "Twitchのパワーアップアイテム。これは以前は"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "以前はTwitchの自動機能に含まれていました"}, {"type": "subtitle", "time": 9508.95, "timestamp": "02:38:28", "text": "報酬の交換だが、"}, {"type": "subtitle", "time": 9511.349, "timestamp": "02:38:31", "text": "トゥイッチ。トリガーを調整してください"}, {"type": "subtitle", "time": 9513.51, "timestamp": "02:38:33", "text": "それに応じて。これは、"}, {"type": "subtitle", "time": 9515.11, "timestamp": "02:38:35", "text": "ビットが含まれています。だから、もしあなたがテストなら"}, {"type": "subtitle", "time": 9517.75, "timestamp": "02:38:37", "text": "放送局さん、これはうまくいきません。わかった。"}, {"type": "subtitle", "time": 9520.87, "timestamp": "02:38:40", "text": "新しいトリガーを追加します。イベントのステータスが変更されました。"}, {"type": "subtitle", "time": 9523.75, "timestamp": "02:38:43", "text": "カスタムイベント。わかった。改善点。ビット"}, {"type": "subtitle", "time": 9525.99, "timestamp": "02:38:45", "text": "チャネルビットを使用する"}, {"type": "subtitle", "time": 9527.99, "timestamp": "02:38:47", "text": "channel.bits を channel の代わりに使用します"}, {"type": "subtitle", "time": 9531.03, "timestamp": "02:38:51", "text": "応援する。ああ、Discordのアカウントを変更する必要がある"}, {"type": "subtitle", "time": 9534.469, "timestamp": "02:38:54", "text": "ウェブフック。だから、誰かが送ってくると"}, {"type": "subtitle", "time": 9537.91, "timestamp": "02:38:57", "text": "Twitchでビットやチアーズをすると、"}, {"type": "subtitle", "time": 9539.91, "timestamp": "02:38:59", "text": "彼らがどれだけ応援するか、だから私は"}]
[{"type": "subtitle", "time": 6781.75, "timestamp": "01:53:01", "text": "理由。まるで旅に出るような気分になるでしょう。しかし彼は"}, {"type": "subtitle", "time": 6784.06, "timestamp": "01:53:04", "text": "彼は入浴する。"}, {"type": "subtitle", "time": 6785.669, "timestamp": "01:53:05", "text": "[音楽]"}, {"type": "subtitle", "time": 6787.35, "timestamp": "01:53:07", "text": "待って、違う、彼じゃなくて彼女だ。私"}, {"type": "subtitle", "time": 6818.55, "timestamp": "01:53:38", "text": "あ、待って。私はインスタグラムを作ったのか？"}, {"type": "subtitle", "time": 6836.629, "timestamp": "01:53:56", "text": "でも、本当にキーホルダーを作りたいんです。"}, {"type": "subtitle", "time": 6838.709, "timestamp": "01:53:58", "text": "実は。"}]
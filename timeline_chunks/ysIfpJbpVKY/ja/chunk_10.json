[{"type": "subtitle", "time": 604.23, "timestamp": "00:10:04", "text": "よし、じゃあ全部準備しよう。"}, {"type": "subtitle", "time": 607.829, "timestamp": "00:10:07", "text": "えっと、昨日の昨日のえっと、私が"}, {"type": "subtitle", "time": 610.63, "timestamp": "00:10:10", "text": "配信を終了し、PCはそのままにしておきました。"}, {"type": "subtitle", "time": 614.949, "timestamp": "00:10:14", "text": "触ってないのに、またここに戻ってきちゃった"}, {"type": "subtitle", "time": 618.069, "timestamp": "00:10:18", "text": "だって昨日の夜はずっとTwitchとKick"}, {"type": "subtitle", "time": 620.79, "timestamp": "00:10:20", "text": "VOD のように見ていた、すべて"}, {"type": "subtitle", "time": 623.43, "timestamp": "00:10:23", "text": "報酬とか、その他諸々。"}, {"type": "subtitle", "time": 630.31, "timestamp": "00:10:30", "text": "わかった。"}, {"type": "subtitle", "time": 634.069, "timestamp": "00:10:34", "text": "こんにちは。えっと、もうすぐ終わる気がする"}, {"type": "subtitle", "time": 636.71, "timestamp": "00:10:36", "text": "もっと色々。"}, {"type": "subtitle", "time": 642.23, "timestamp": "00:10:42", "text": "この男をどこかに配置してもいいだろう。"}, {"type": "subtitle", "time": 644.949, "timestamp": "00:10:44", "text": "それを閉じてください。"}, {"type": "subtitle", "time": 655.35, "timestamp": "00:10:55", "text": "わかった。次。スイッチゲーム機。"}, {"type": "subtitle", "time": 657.19, "timestamp": "00:10:57", "text": "わーい。"}]
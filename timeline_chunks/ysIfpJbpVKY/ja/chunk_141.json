[{"type": "subtitle", "time": 8461.59, "timestamp": "02:21:01", "text": "とにかく、返金があるかどうか見てみましょう"}, {"type": "subtitle", "time": 8464.23, "timestamp": "02:21:04", "text": "ここにポリシーがあります。"}, {"type": "subtitle", "time": 8467.59, "timestamp": "02:21:07", "text": "いいえ、ありません。"}, {"type": "subtitle", "time": 8469.59, "timestamp": "02:21:09", "text": "ここからはお任せください。船。ああ、"}, {"type": "subtitle", "time": 8472.87, "timestamp": "02:21:12", "text": "配送ポリシー"}, {"type": "subtitle", "time": 8479.67, "timestamp": "02:21:19", "text": "私は待つ。配送ポリシーについて"}, {"type": "subtitle", "time": 8483.03, "timestamp": "02:21:23", "text": "国際的な設定ができたら"}, {"type": "subtitle", "time": 8485.59, "timestamp": "02:21:25", "text": "上。"}, {"type": "subtitle", "time": 8500.55, "timestamp": "02:21:40", "text": "今。手伝ってください 手伝ってください 手伝ってください"}, {"type": "subtitle", "time": 8504.79, "timestamp": "02:21:44", "text": "返金ポリシーページ。いくつかご紹介します"}, {"type": "subtitle", "time": 8509.99, "timestamp": "02:21:49", "text": "する"}]
[{"type": "subtitle", "time": 8641.51, "timestamp": "02:24:01", "text": "このポリシーは、true によって購入されました"}, {"type": "subtitle", "time": 8645.75, "timestamp": "02:24:05", "text": "商品を制限する。では、定義はありますか？"}, {"type": "subtitle", "time": 8649.91, "timestamp": "02:24:09", "text": "範囲内ですか？いいえ。"}, {"type": "subtitle", "time": 8652.87, "timestamp": "02:24:12", "text": "はい、スコープは持っていませんでした。いいえ、違います"}, {"type": "subtitle", "time": 8656.309, "timestamp": "02:24:16", "text": "リクエスト。えっと、"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "わかった。サブページなどもあります。"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "[音楽]"}]
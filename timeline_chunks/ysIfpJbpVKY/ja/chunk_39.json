[{"type": "subtitle", "time": 2340.069, "timestamp": "00:39:00", "text": "二次リスト。"}, {"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "何てことだ。すべては"}, {"type": "subtitle", "time": 2352.55, "timestamp": "00:39:12", "text": "そしてこれも。午後10時までにいいえ、"}, {"type": "subtitle", "time": 2355.589, "timestamp": "00:39:15", "text": "午前10時。朝食を食べに行きます。"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "わかった。 10時09分それまではできる限りのことをします"}, {"type": "subtitle", "time": 2362.069, "timestamp": "00:39:22", "text": "私が終わらせることができるものとして"}, {"type": "subtitle", "time": 2366.23, "timestamp": "00:39:26", "text": "今日までに。ええ、そうですね。そして午後3時で"}, {"type": "subtitle", "time": 2368.15, "timestamp": "00:39:28", "text": "午後にはコラボレーションを行います"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "ダザンと一緒に歌い、"}, {"type": "subtitle", "time": 2378.23, "timestamp": "00:39:38", "text": "皆さんが都合がよければ、彼女もそこにいます"}]
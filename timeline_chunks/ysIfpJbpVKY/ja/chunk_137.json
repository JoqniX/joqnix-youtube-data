[{"type": "subtitle", "time": 8220.469, "timestamp": "02:17:00", "text": "ウェブサイト関連のことですか？いいえ。最初は"}, {"type": "subtitle", "time": 8223.27, "timestamp": "02:17:03", "text": "Onexiaのページには、次のように記載してください。"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "私自身と、その他すべて。そして私は気づいた、"}, {"type": "subtitle", "time": 8227.509, "timestamp": "02:17:07", "text": "うん、違うのが好きの方がいいよ"}, {"type": "subtitle", "time": 8230.629, "timestamp": "02:17:10", "text": "両者を別々に扱うべきですよね？"}, {"type": "subtitle", "time": 8232.629, "timestamp": "02:17:12", "text": "それは情熱を注いだプロジェクトであり、私は"}, {"type": "subtitle", "time": 8234.549, "timestamp": "02:17:14", "text": "作成者なので、自分のページが必要です"}, {"type": "subtitle", "time": 8240.93, "timestamp": "02:17:20", "text": "たくさん"}, {"type": "subtitle", "time": 8267.99, "timestamp": "02:17:47", "text": "待って、あのね？私は"}, {"type": "subtitle", "time": 8270.87, "timestamp": "02:17:50", "text": "このマージ。両方を統合してほしい"}, {"type": "subtitle", "time": 8273.03, "timestamp": "02:17:53", "text": "彼ら。"}]
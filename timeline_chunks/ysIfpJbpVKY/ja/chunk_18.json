[{"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "ちょっと待って。チェック。ああ、私は違う"}, {"type": "subtitle", "time": 1099.75, "timestamp": "00:18:19", "text": "ヘッドホンを装着しています。バカめ。"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "ああ、それはあなたのスマホのイヤホンだったんですね。おお"}, {"type": "subtitle", "time": 1112.95, "timestamp": "00:18:32", "text": "[音楽]"}, {"type": "subtitle", "time": 1116.549, "timestamp": "00:18:36", "text": "チェック。 １、２。"}, {"type": "subtitle", "time": 1119.19, "timestamp": "00:18:39", "text": "はい、マイクの音声は聞こえますが、"}, {"type": "subtitle", "time": 1121.19, "timestamp": "00:18:41", "text": "背景音楽は聞こえません、"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "そうみたいだ。 H"}]
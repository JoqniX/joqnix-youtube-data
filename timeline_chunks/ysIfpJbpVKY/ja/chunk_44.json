[{"type": "subtitle", "time": 2646.79, "timestamp": "00:44:06", "text": "ログインし忘れたわけではありません。はぁ？だからもし"}, {"type": "subtitle", "time": 2650.95, "timestamp": "00:44:10", "text": "クラウドでjocknixと入力すると"}, {"type": "subtitle", "time": 2654.309, "timestamp": "00:44:14", "text": "そう、これらを手に入れることができます"}, {"type": "subtitle", "time": 2658.87, "timestamp": "00:44:18", "text": "jocknix ost jon ost これらすべてのもの"}, {"type": "subtitle", "time": 2662.87, "timestamp": "00:44:22", "text": "それらはタキスです"}, {"type": "subtitle", "time": 2665.99, "timestamp": "00:44:25", "text": "ここにもあります"}, {"type": "subtitle", "time": 2667.67, "timestamp": "00:44:27", "text": "えーと"}, {"type": "chat", "time": 2669.597, "timestamp": "00:44:29", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "is it a sad song"}, {"type": "subtitle", "time": 2675.67, "timestamp": "00:44:35", "text": "でも、どうしてプレイリストは"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "悲しい歌。あなたが聴いていたもの"}, {"type": "subtitle", "time": 2681.109, "timestamp": "00:44:41", "text": "以前はコンステラー・ポグニティアと呼ばれていた"}, {"type": "subtitle", "time": 2684.55, "timestamp": "00:44:44", "text": "これは古典的なタイプのチャンドラです。"}, {"type": "subtitle", "time": 2687.03, "timestamp": "00:44:47", "text": "今あなたが聴いているこの曲は"}, {"type": "subtitle", "time": 2690.71, "timestamp": "00:44:50", "text": "一つはジョックニックのDアニメーションです。それは"}, {"type": "subtitle", "time": 2693.51, "timestamp": "00:44:53", "text": "どうやらロックソングらしい。"}, {"type": "subtitle", "time": 2699.67, "timestamp": "00:44:59", "text": "よし、これでいい。音量を上げます"}]
[{"type": "subtitle", "time": 14522.07, "timestamp": "04:02:02", "text": "えっと、それは"}, {"type": "chat", "time": 14522.454, "timestamp": "04:02:02", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "BREAD"}, {"type": "subtitle", "time": 14527.51, "timestamp": "04:02:07", "text": "アーテックスの息子。もし斧が見つかれば、"}, {"type": "subtitle", "time": 14529.67, "timestamp": "04:02:09", "text": "どこにいるの？"}, {"type": "subtitle", "time": 14537.03, "timestamp": "04:02:17", "text": "ああ、そこにいたんですね。"}, {"type": "subtitle", "time": 14541.75, "timestamp": "04:02:21", "text": "これで70日目だ。ああ、もう143日も経つのか。"}, {"type": "subtitle", "time": 14544.95, "timestamp": "04:02:24", "text": "ほら、70日目だよ。これはコラボ企画だったんだ。"}, {"type": "subtitle", "time": 14547.11, "timestamp": "04:02:27", "text": "彼女と一緒に。"}, {"type": "subtitle", "time": 14550.63, "timestamp": "04:02:30", "text": "それはここにあった。"}, {"type": "subtitle", "time": 14553.59, "timestamp": "04:02:33", "text": "うん。うん。だから、一緒に作業する"}, {"type": "subtitle", "time": 14559.189, "timestamp": "04:02:39", "text": "協力して働く"}, {"type": "subtitle", "time": 14561.83, "timestamp": "04:02:41", "text": "もし行けるなら。"}, {"type": "subtitle", "time": 14563.91, "timestamp": "04:02:43", "text": "うん。そして、あなたは読み上げなければなりません"}, {"type": "subtitle", "time": 14566.95, "timestamp": "04:02:46", "text": "お好みであれば、対話形式でも構いません。もしあなたが"}, {"type": "subtitle", "time": 14569.429, "timestamp": "04:02:49", "text": "1つの対話を読み上げるカバー"}, {"type": "subtitle", "time": 14571.51, "timestamp": "04:02:51", "text": "あなたの対話を読むことができます、その他"}, {"type": "subtitle", "time": 14573.51, "timestamp": "04:02:53", "text": "人は他人の会話を読むことができる"}, {"type": "subtitle", "time": 14575.75, "timestamp": "04:02:55", "text": "などなど。"}, {"type": "subtitle", "time": 14578.309, "timestamp": "04:02:58", "text": "可能です。"}]
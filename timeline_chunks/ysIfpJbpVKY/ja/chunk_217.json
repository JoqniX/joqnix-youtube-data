[{"type": "subtitle", "time": 13021.269, "timestamp": "03:37:01", "text": "ビジネスとすべての正しい"}, {"type": "subtitle", "time": 13024.309, "timestamp": "03:37:04", "text": "支払い手順 支払い方法"}, {"type": "subtitle", "time": 13027.59, "timestamp": "03:37:07", "text": "えーと、商品をカートに追加して支払いをしてください。"}, {"type": "subtitle", "time": 13029.99, "timestamp": "03:37:09", "text": "支払いなどを行う必要があるので、"}, {"type": "subtitle", "time": 13032.55, "timestamp": "03:37:12", "text": "Google Pay 用にそのビデオを録画し、"}, {"type": "subtitle", "time": 13034.87, "timestamp": "03:37:14", "text": "もの。 Phone Payについて調べて、"}, {"type": "subtitle", "time": 13037.99, "timestamp": "03:37:17", "text": "Paytmも同様です。どうすればいいのかわからない"}, {"type": "subtitle", "time": 13041.51, "timestamp": "03:37:21", "text": "そうするべきだが、そうせざるを得ない。"}, {"type": "subtitle", "time": 13043.99, "timestamp": "03:37:23", "text": "本当に残念だ。たくさんあります"}, {"type": "subtitle", "time": 13045.51, "timestamp": "03:37:25", "text": "もの。"}, {"type": "subtitle", "time": 13047.349, "timestamp": "03:37:27", "text": "そしてそれが、ほとんどのユーチューバーが参加する理由です"}, {"type": "subtitle", "time": 13050.229, "timestamp": "03:37:30", "text": "代理店。はい、おっしゃる通りです。"}, {"type": "subtitle", "time": 13052.71, "timestamp": "03:37:32", "text": "私は無所属です。私は頼らなければならない"}, {"type": "subtitle", "time": 13060.36, "timestamp": "03:37:40", "text": "私にとって人生は辛い。"}, {"type": "subtitle", "time": 13061.91, "timestamp": "03:37:41", "text": "[音楽]"}, {"type": "subtitle", "time": 13063.75, "timestamp": "03:37:43", "text": "でも大丈夫。全部コピー＆ペーストします"}, {"type": "subtitle", "time": 13066.15, "timestamp": "03:37:46", "text": "それらのうちの1つを取り、仕上げる。私はしていません"}, {"type": "subtitle", "time": 13069.99, "timestamp": "03:37:49", "text": "まだ朝食を食べていないので、行かなければなりません"}, {"type": "subtitle", "time": 13072.229, "timestamp": "03:37:52", "text": "すぐ。"}, {"type": "subtitle", "time": 13075.59, "timestamp": "03:37:55", "text": "カード決済、"}, {"type": "subtitle", "time": 13078.87, "timestamp": "03:37:58", "text": "3～7日。"}]
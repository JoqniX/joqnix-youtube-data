[{"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "ああ、私はまさにそういうタイプだ。もし私が"}, {"type": "subtitle", "time": 6553.43, "timestamp": "01:49:13", "text": "蝶々だ、追いかけてみよう。"}, {"type": "subtitle", "time": 6555.99, "timestamp": "01:49:15", "text": "私も最近そうしました。私はそれをしました"}, {"type": "subtitle", "time": 6558.39, "timestamp": "01:49:18", "text": "最近。実は"}, {"type": "subtitle", "time": 6560.87, "timestamp": "01:49:20", "text": "えっと、自分の部屋に行こうとしていたとき"}, {"type": "chat", "time": 6562.317, "timestamp": "01:49:22", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "ok offstream is a bit unacceptable 🤣"}, {"type": "subtitle", "time": 6564.39, "timestamp": "01:49:24", "text": "えーと、私は通らなければならないので"}, {"type": "subtitle", "time": 6566.95, "timestamp": "01:49:26", "text": "正面ゲートから私のところへ"}, {"type": "subtitle", "time": 6570.79, "timestamp": "01:49:30", "text": "ストリームルーム。それで私はこの蝶を見ました"}, {"type": "subtitle", "time": 6574.31, "timestamp": "01:49:34", "text": "友達のエリアみたいに。ああ、そこには"}, {"type": "subtitle", "time": 6576.709, "timestamp": "01:49:36", "text": "友人の家に植物や物が少しある"}, {"type": "subtitle", "time": 6579.669, "timestamp": "01:49:39", "text": "道路沿いのエリア。うん。それで"}, {"type": "subtitle", "time": 6581.35, "timestamp": "01:49:41", "text": "この蝶が飛んでいるのを見ました。私はこう思った。"}, {"type": "subtitle", "time": 6583.43, "timestamp": "01:49:43", "text": "「よし、私はこう思った。「よし、私は"}, {"type": "subtitle", "time": 6585.669, "timestamp": "01:49:45", "text": "もっと詳しく見てみたい。"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "私の携帯電話を取って、写真を撮ってもいいかも。そして私は"}, {"type": "subtitle", "time": 6591.91, "timestamp": "01:49:51", "text": "通り過ぎてしまったので写真が撮れませんでした"}, {"type": "subtitle", "time": 6594.39, "timestamp": "01:49:54", "text": "それは道路の反対側へ行った。"}]
[{"type": "subtitle", "time": 660.55, "timestamp": "00:11:00", "text": "わかった。昨日"}, {"type": "subtitle", "time": 663.67, "timestamp": "00:11:03", "text": "脳が死にかけている間に私はいくつかのことに気づいた"}, {"type": "subtitle", "time": 667.35, "timestamp": "00:11:07", "text": "私が忘れていた問題、例えば"}, {"type": "subtitle", "time": 669.35, "timestamp": "00:11:09", "text": "これらのテキスト"}, {"type": "subtitle", "time": 672.71, "timestamp": "00:11:12", "text": "忘れてたよ"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "右側は見えるかどうかわかりません"}, {"type": "subtitle", "time": 678.71, "timestamp": "00:11:18", "text": "でも、中には"}, {"type": "subtitle", "time": 681.35, "timestamp": "00:11:21", "text": "正しい"}, {"type": "subtitle", "time": 683.75, "timestamp": "00:11:23", "text": "デザイントークン。"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "うん。"}, {"type": "subtitle", "time": 688.71, "timestamp": "00:11:28", "text": "Dは正しいデザインではない"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "トークン"}, {"type": "subtitle", "time": 693.43, "timestamp": "00:11:33", "text": "そして昨日、私はコピー＆ペーストしていた"}, {"type": "subtitle", "time": 696.63, "timestamp": "00:11:36", "text": "そしてそれをスピードランする。確認を怠った"}, {"type": "subtitle", "time": 699.67, "timestamp": "00:11:39", "text": "これらのうちのいくつか。"}, {"type": "subtitle", "time": 704.15, "timestamp": "00:11:44", "text": "今、ああ、なんてことだと気づいた"}, {"type": "subtitle", "time": 707.03, "timestamp": "00:11:47", "text": "それはありません。"}, {"type": "subtitle", "time": 710.389, "timestamp": "00:11:50", "text": "見て、たくさんのものがない"}, {"type": "subtitle", "time": 712.23, "timestamp": "00:11:52", "text": "正しいこと。これも"}, {"type": "subtitle", "time": 714.63, "timestamp": "00:11:54", "text": "それを持っている。"}, {"type": "subtitle", "time": 717.03, "timestamp": "00:11:57", "text": "全てを投入しなければならない"}, {"type": "subtitle", "time": 719.59, "timestamp": "00:11:59", "text": "これらすべてが"}]
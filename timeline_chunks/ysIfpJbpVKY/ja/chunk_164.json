[{"type": "subtitle", "time": 9845.59, "timestamp": "02:44:05", "text": "待って、これはどのバージョンだったっけ？ 2.0ですよね？"}, {"type": "subtitle", "time": 9847.91, "timestamp": "02:44:07", "text": "以前のものは「ああ、わかった」でした。更新されました。その"}, {"type": "subtitle", "time": 9851.11, "timestamp": "02:44:11", "text": "更新しました。更新されました。よし、いいね。"}, {"type": "subtitle", "time": 9855.03, "timestamp": "02:44:15", "text": "カスタムイベントを介してすべてのイベントとサブイベントを発火する"}, {"type": "subtitle", "time": 9857.99, "timestamp": "02:44:17", "text": "トリガー。これは何ですか？"}, {"type": "subtitle", "time": 9860.389, "timestamp": "02:44:20", "text": "ネイティブでサポートされている機能を含めるように有効にする"}, {"type": "subtitle", "time": 9862.55, "timestamp": "02:44:22", "text": "カスタムイベントサブでTwitchがトリガーされます"}, {"type": "subtitle", "time": 9864.79, "timestamp": "02:44:24", "text": "トリガー"}, {"type": "subtitle", "time": 9867.59, "timestamp": "02:44:27", "text": "インターフェース全般。"}, {"type": "subtitle", "time": 9870.79, "timestamp": "02:44:30", "text": "ああ、非同期は非同期だ。ああ、非同期かどうか"}, {"type": "subtitle", "time": 9873.75, "timestamp": "02:44:33", "text": "コマンドは作成時に非同期で切り替えられます"}, {"type": "subtitle", "time": 9875.83, "timestamp": "02:44:35", "text": "信号がないこと、あるいは信号が仮想化されていること。"}, {"type": "subtitle", "time": 9879.269, "timestamp": "02:44:39", "text": "わかった。タイマーのデフォルト値。わかった。"}, {"type": "subtitle", "time": 9880.63, "timestamp": "02:44:40", "text": "わかった。わかった。見たい。したい"}, {"type": "subtitle", "time": 9888.71, "timestamp": "02:44:48", "text": "ああ、アインが見えました。 Aが見えますか？"}, {"type": "subtitle", "time": 9892.95, "timestamp": "02:44:52", "text": "単一のもの？ああ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 9896.15, "timestamp": "02:44:56", "text": "いいね、いいね、いいね、いいね、いいね。待って、"}, {"type": "subtitle", "time": 9899.99, "timestamp": "02:44:59", "text": "それは、"}]
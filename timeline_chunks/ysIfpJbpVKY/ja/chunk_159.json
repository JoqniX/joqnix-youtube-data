[{"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "それを変えなさい。えっと、イベント２。わかった。"}, {"type": "subtitle", "time": 9546.389, "timestamp": "02:39:06", "text": "66のトリガープル値を更新しました"}, {"type": "subtitle", "time": 9549.27, "timestamp": "02:39:09", "text": "コマンド。ニース。非同期処理は現在"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "同期。デフォルトではグレーです。えっと、もしそうでないなら"}, {"type": "subtitle", "time": 9556.87, "timestamp": "02:39:16", "text": "色はコマンドで提供されています 今すぐ再インストール"}, {"type": "subtitle", "time": 9558.87, "timestamp": "02:39:18", "text": "デフォルト変数を再インストールするまでお待ちください"}, {"type": "subtitle", "time": 9561.19, "timestamp": "02:39:21", "text": "フィールドボタンIDが残されている場合は、"}, {"type": "subtitle", "time": 9564.309, "timestamp": "02:39:24", "text": "現在のボタン。それはいいですね。コピー"}, {"type": "subtitle", "time": 9567.67, "timestamp": "02:39:27", "text": "変数名をコピーする"}, {"type": "subtitle", "time": 9569.83, "timestamp": "02:39:29", "text": "現在のオープンからの変数名"}, {"type": "subtitle", "time": 9577.59, "timestamp": "02:39:37", "text": "おお、それは良いアップデートですね。私はいつも"}, {"type": "subtitle", "time": 9579.19, "timestamp": "02:39:39", "text": "バックスペースで現在の"}, {"type": "subtitle", "time": 9581.83, "timestamp": "02:39:41", "text": "変数をコピーする際のボタンID"}, {"type": "subtitle", "time": 9585.11, "timestamp": "02:39:45", "text": "名前。うん、いい感じの非同期配色だね。"}, {"type": "subtitle", "time": 9589.349, "timestamp": "02:39:49", "text": "録音機みたいなもの。ええと、デフォルトです。わかった。"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "コマンド名を変更しました。わかった。わかった。だから、再作業"}, {"type": "subtitle", "time": 9595.67, "timestamp": "02:39:55", "text": "若干の修正。ゲームコマンドを追加しました。"}, {"type": "subtitle", "time": 9598.469, "timestamp": "02:39:58", "text": "TwitchのゲームAPI呼び出し。たくさんの"}]
[{"type": "subtitle", "time": 5640.709, "timestamp": "01:34:00", "text": "Beamからも視聴できます。"}, {"type": "subtitle", "time": 5645.99, "timestamp": "01:34:05", "text": "[音楽]"}, {"type": "subtitle", "time": 5648.47, "timestamp": "01:34:08", "text": "Beamstreamプレーヤーを試してみてください。それも"}, {"type": "subtitle", "time": 5651.669, "timestamp": "01:34:11", "text": "まあ、いいんじゃない？"}, {"type": "chat", "time": 5653.479, "timestamp": "01:34:13", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "im here"}, {"type": "subtitle", "time": 5653.51, "timestamp": "01:34:13", "text": "私のチャンネルが"}, {"type": "subtitle", "time": 5656.31, "timestamp": "01:34:16", "text": "オフラインでも動作しますか？"}, {"type": "subtitle", "time": 5658.87, "timestamp": "01:34:18", "text": "うん、広告みたいなものがあるよ、だって私は"}, {"type": "subtitle", "time": 5666.55, "timestamp": "01:34:26", "text": "分遣隊の後。"}, {"type": "subtitle", "time": 5670.07, "timestamp": "01:34:30", "text": "ええ、ビームプレイヤーはこんな感じです。"}, {"type": "subtitle", "time": 5672.39, "timestamp": "01:34:32", "text": "再生機能みたいなものがあります。あなたはできる"}, {"type": "subtitle", "time": 5675.51, "timestamp": "01:34:35", "text": "ループ、スピード、品質、"}, {"type": "subtitle", "time": 5677.99, "timestamp": "01:34:37", "text": "品質も同様です。"}, {"type": "subtitle", "time": 5680.07, "timestamp": "01:34:40", "text": "アクセシビリティ担当者はアナウンスを行います。私はします"}, {"type": "subtitle", "time": 5683.03, "timestamp": "01:34:43", "text": "アナウンスが何なのか分からない。"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "でも、Google Castで検索すれば見つかりますよ。"}, {"type": "subtitle", "time": 5697.06, "timestamp": "01:34:57", "text": "おかえり。ようこそ。"}, {"type": "subtitle", "time": 5699.189, "timestamp": "01:34:59", "text": "[音楽]"}]
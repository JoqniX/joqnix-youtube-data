[{"type": "subtitle", "time": 1702.549, "timestamp": "00:28:22", "text": "はい、本文です。はい、これで終わりです"}, {"type": "subtitle", "time": 1706.149, "timestamp": "00:28:26", "text": "デザイントークンを追加する。"}, {"type": "subtitle", "time": 1708.87, "timestamp": "00:28:28", "text": "すべて揃っているか二重チェックしています"}, {"type": "subtitle", "time": 1712.07, "timestamp": "00:28:32", "text": "デザイントークン。どうやら一部の人にとって"}, {"type": "subtitle", "time": 1714.87, "timestamp": "00:28:34", "text": "理由として、一部の部品は"}, {"type": "subtitle", "time": 1719.269, "timestamp": "00:28:39", "text": "持っているのが不思議だ。でも、そうだね、"}, {"type": "subtitle", "time": 1723.669, "timestamp": "00:28:43", "text": "終わった。さて、これはドットデータです"}, {"type": "subtitle", "time": 1726.07, "timestamp": "00:28:46", "text": "リスト項目。"}, {"type": "subtitle", "time": 1730.47, "timestamp": "00:28:50", "text": "名前を変えてコピーするだけです。"}, {"type": "subtitle", "time": 1732.789, "timestamp": "00:28:52", "text": "だから、コピー＆ペーストできるんです。よし、これだ"}, {"type": "chat", "time": 1734.895, "timestamp": "00:28:54", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "still making your website"}, {"type": "subtitle", "time": 1735.35, "timestamp": "00:28:55", "text": "持っている。これはそれを持っている。だから私は倍にする"}, {"type": "subtitle", "time": 1737.75, "timestamp": "00:28:57", "text": "リストにある項目をすべて確認してください。今も製造中"}, {"type": "subtitle", "time": 1739.909, "timestamp": "00:28:59", "text": "ウェブサイト。ええと、今日は"}]
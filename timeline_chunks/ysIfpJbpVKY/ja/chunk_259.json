[{"type": "subtitle", "time": 15548.55, "timestamp": "04:19:08", "text": "そして、初日は必要ない。取り除く"}, {"type": "subtitle", "time": 15550.389, "timestamp": "04:19:10", "text": "それ。"}, {"type": "subtitle", "time": 15553.429, "timestamp": "04:19:13", "text": "ライブストリーミングは必要ありません。"}, {"type": "subtitle", "time": 15565.429, "timestamp": "04:19:25", "text": "それを動かしてください。他に何かあったかな"}, {"type": "subtitle", "time": 15568.07, "timestamp": "04:19:28", "text": "した？わからない。次のようにできます"}, {"type": "subtitle", "time": 15573.91, "timestamp": "04:19:33", "text": "これはファンだった。これはファンアートです"}, {"type": "subtitle", "time": 15577.83, "timestamp": "04:19:37", "text": "先に来たパン。"}, {"type": "subtitle", "time": 15584.79, "timestamp": "04:19:44", "text": "彼は私がまだ"}, {"type": "subtitle", "time": 15594.229, "timestamp": "04:19:54", "text": "はい、これは午後3時になります。わかりました、"}, {"type": "subtitle", "time": 15597.59, "timestamp": "04:19:57", "text": "数分後には到着します。ああ神様、"}]
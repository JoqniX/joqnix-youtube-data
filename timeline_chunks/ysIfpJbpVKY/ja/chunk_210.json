[{"type": "subtitle", "time": 12602.95, "timestamp": "03:30:02", "text": "推測。でも、確かにそれは莫大な金額ですね。"}, {"type": "subtitle", "time": 12607.349, "timestamp": "03:30:07", "text": "そして、今のところ私はTwitchを手に入れました"}, {"type": "subtitle", "time": 12609.19, "timestamp": "03:30:09", "text": "YouTube。 YouTube 私はまだ待っています"}, {"type": "subtitle", "time": 12612.469, "timestamp": "03:30:12", "text": "それ。 Twitchへの支払い。わかった。えっと、それで私は"}, {"type": "subtitle", "time": 12614.389, "timestamp": "03:30:14", "text": "ちゃんとした銀行口座を持っているので"}, {"type": "subtitle", "time": 12617.99, "timestamp": "03:30:17", "text": "ジョックのアカウントを次にジョックにすることができます"}, {"type": "subtitle", "time": 12621.11, "timestamp": "03:30:21", "text": "そこにお金を入れてください。だから私は考えている"}, {"type": "subtitle", "time": 12623.349, "timestamp": "03:30:23", "text": "目標はまだ達成されていないので。"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "よし。リリースすることを考えた"}, {"type": "subtitle", "time": 12629.11, "timestamp": "03:30:29", "text": "グッズを販売してみて、どうなるか見てみよう。全員が"}, {"type": "subtitle", "time": 12631.75, "timestamp": "03:30:31", "text": "人々がそれを買いたいと望むなら"}, {"type": "subtitle", "time": 12634.309, "timestamp": "03:30:34", "text": "そして、もし需要が非常に高ければ、"}, {"type": "subtitle", "time": 12636.469, "timestamp": "03:30:36", "text": "もっと多くのアイテムと投資を"}, {"type": "subtitle", "time": 12642.15, "timestamp": "03:30:42", "text": "それについてもっと詳しく調べたり、いろいろと。うん。願わくば、私は"}, {"type": "subtitle", "time": 12644.389, "timestamp": "03:30:44", "text": "せめて自分のモデルを買う余裕があればいいな"}, {"type": "subtitle", "time": 12648.309, "timestamp": "03:30:48", "text": "物を出してデビューさせて返済する"}, {"type": "subtitle", "time": 12650.15, "timestamp": "03:30:50", "text": "えっと"}, {"type": "subtitle", "time": 12653.19, "timestamp": "03:30:53", "text": "ライセンス料とライセンス関連費用を支払う"}, {"type": "subtitle", "time": 12655.59, "timestamp": "03:30:55", "text": "そして全て。すべての契約書と秘密保持契約書"}, {"type": "subtitle", "time": 12658.469, "timestamp": "03:30:58", "text": "開示できない状況"}]
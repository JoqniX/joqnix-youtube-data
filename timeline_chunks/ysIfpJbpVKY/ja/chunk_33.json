[{"type": "subtitle", "time": 1980.789, "timestamp": "00:33:00", "text": "チャジの哀れみとシェアラーと"}, {"type": "subtitle", "time": 1983.509, "timestamp": "00:33:03", "text": "もの？疑問符。"}, {"type": "subtitle", "time": 1984.95, "timestamp": "00:33:04", "text": "わからない。彼はこう言った"}, {"type": "subtitle", "time": 1987.269, "timestamp": "00:33:07", "text": "それ。そこの弁護士の一人は"}, {"type": "subtitle", "time": 1990.95, "timestamp": "00:33:10", "text": "３つか３つ。 ３つだったかな？えっと、２と"}, {"type": "subtitle", "time": 1994.23, "timestamp": "00:33:14", "text": "弁護士は３人いると思います。それから"}, {"type": "subtitle", "time": 1996.389, "timestamp": "00:33:16", "text": "他のスタッフ全員"}, {"type": "subtitle", "time": 1999.19, "timestamp": "00:33:19", "text": "約3時間後には"}, {"type": "subtitle", "time": 2002.389, "timestamp": "00:33:22", "text": "現在時刻は7時30分です。いいえ、10時頃に来ます"}, {"type": "subtitle", "time": 2005.83, "timestamp": "00:33:25", "text": "または午前9時。だから他の人はこう思う。"}, {"type": "subtitle", "time": 2008.71, "timestamp": "00:33:28", "text": "インターン生だと思います。"}, {"type": "subtitle", "time": 2011.029, "timestamp": "00:33:31", "text": "うん。うん。それから掃除もある"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "女性も。ええ、スタッフの皆さん、"}, {"type": "subtitle", "time": 2019.43, "timestamp": "00:33:39", "text": "メンバー。そして彼らは皆9時か10時頃にやって来る"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "と の準備を全て整える"}, {"type": "subtitle", "time": 2025.029, "timestamp": "00:33:45", "text": "弁護士、主任弁護士３名"}, {"type": "subtitle", "time": 2029.509, "timestamp": "00:33:49", "text": "彼らは夜にやって来るが、"}, {"type": "subtitle", "time": 2034.23, "timestamp": "00:33:54", "text": "えっと、裁判関係の件とか、そういうこと全部。"}, {"type": "subtitle", "time": 2038.95, "timestamp": "00:33:58", "text": "[音楽]"}]
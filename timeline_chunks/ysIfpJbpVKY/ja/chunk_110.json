[{"type": "subtitle", "time": 6600.49, "timestamp": "01:50:00", "text": "近くの他のアパートや家のように。"}, {"type": "subtitle", "time": 6602.149, "timestamp": "01:50:02", "text": "[笑い]"}, {"type": "subtitle", "time": 6604.45, "timestamp": "01:50:04", "text": "そして私は「いや、"}, {"type": "subtitle", "time": 6606.79, "timestamp": "01:50:06", "text": "[音楽]"}, {"type": "subtitle", "time": 6610.229, "timestamp": "01:50:10", "text": "君が欲しかった。"}, {"type": "subtitle", "time": 6613.03, "timestamp": "01:50:13", "text": "あなたが必要だった"}, {"type": "subtitle", "time": 6620.07, "timestamp": "01:50:20", "text": "マヤ。"}, {"type": "subtitle", "time": 6623.99, "timestamp": "01:50:23", "text": "そしていつものように、ドゴちゃんは"}, {"type": "subtitle", "time": 6628.34, "timestamp": "01:50:28", "text": "蝶を見て吠えまくる"}, {"type": "subtitle", "time": 6634.87, "timestamp": "01:50:34", "text": "最近知った。何てことだ。教えてあげよう"}, {"type": "subtitle", "time": 6636.87, "timestamp": "01:50:36", "text": "物語"}, {"type": "subtitle", "time": 6642.39, "timestamp": "01:50:42", "text": "ああ、なんてことだ。彼は死んだ"}, {"type": "subtitle", "time": 6646.55, "timestamp": "01:50:46", "text": "彼の犬小屋の上で。いいえ、彼は彼でした"}, {"type": "subtitle", "time": 6648.79, "timestamp": "01:50:48", "text": "それは受け入れられなかった。彼はまるで"}, {"type": "subtitle", "time": 6651.91, "timestamp": "01:50:51", "text": "死んだミミズか何か、あるいは何か"}, {"type": "subtitle", "time": 6655.109, "timestamp": "01:50:55", "text": "死んだハエか何かか何か"}, {"type": "subtitle", "time": 6658.629, "timestamp": "01:50:58", "text": "えっと、彼の犬について考えていた"}]
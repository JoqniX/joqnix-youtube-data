[{"type": "subtitle", "time": 13080.87, "timestamp": "03:38:00", "text": "でも、私は"}, {"type": "subtitle", "time": 13083.91, "timestamp": "03:38:03", "text": "弁護士。私は何人かの弁護士を雇っています"}, {"type": "subtitle", "time": 13087.429, "timestamp": "03:38:07", "text": "私の部屋は、隣の部屋のような部屋ではありません。えーと"}, {"type": "subtitle", "time": 13091.75, "timestamp": "03:38:11", "text": "私の家の1階は"}, {"type": "subtitle", "time": 13094.309, "timestamp": "03:38:14", "text": "レンタル用に提供されるレンタルのような"}, {"type": "subtitle", "time": 13097.59, "timestamp": "03:38:17", "text": "商業スペース。ホールの1つは"}, {"type": "subtitle", "time": 13100.07, "timestamp": "03:38:20", "text": "弁護士にとっては当然のこととされている。それは法律だ"}, {"type": "subtitle", "time": 13102.07, "timestamp": "03:38:22", "text": "まるで弁護士事務所のようだ。わからない"}, {"type": "subtitle", "time": 13104.469, "timestamp": "03:38:24", "text": "彼らがどんな弁護士かはともかく、"}, {"type": "subtitle", "time": 13106.63, "timestamp": "03:38:26", "text": "弁護士は4人くらいいる。彼らに聞いてみてください"}, {"type": "subtitle", "time": 13109.269, "timestamp": "03:38:29", "text": "到着時に彼らに会ったら、何気なく"}, {"type": "chat", "time": 13110.474, "timestamp": "03:38:30", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "bro keeps lawyer in his room"}, {"type": "subtitle", "time": 13114.229, "timestamp": "03:38:34", "text": "部屋から出て行った。えっと、それは"}, {"type": "subtitle", "time": 13116.15, "timestamp": "03:38:36", "text": "皆さん、手伝ってくれませんか？"}, {"type": "subtitle", "time": 13119.03, "timestamp": "03:38:39", "text": "何か？私はそうしなければならないかもしれないと思う"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "彼らに支払ってください。わかりません。"}, {"type": "subtitle", "time": 13126.71, "timestamp": "03:38:46", "text": "ええ、調べてみます。もし彼らが"}, {"type": "subtitle", "time": 13129.03, "timestamp": "03:38:49", "text": "私を助けてくれるでしょう、それはとても役に立つでしょう"}, {"type": "subtitle", "time": 13137.99, "timestamp": "03:38:57", "text": "そう、彼らは私を助けてくれるかもしれない。それは"}]
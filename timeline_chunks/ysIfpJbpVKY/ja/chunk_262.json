[{"type": "subtitle", "time": 15720.309, "timestamp": "04:22:00", "text": "すべて。うん。そうすれば主に"}, {"type": "subtitle", "time": 15723.83, "timestamp": "04:22:03", "text": "チャンネル紹介が必要で、"}, {"type": "subtitle", "time": 15726.55, "timestamp": "04:22:06", "text": "リピーター向けの機能。ああ、あれだ"}, {"type": "subtitle", "time": 15729.189, "timestamp": "04:22:09", "text": "チャンネルの紹介とか色々"}, {"type": "subtitle", "time": 15730.79, "timestamp": "04:22:10", "text": "チャンネルの紹介と内容"}, {"type": "subtitle", "time": 15734.229, "timestamp": "04:22:14", "text": "重要なことなどについてであり、また"}, {"type": "subtitle", "time": 15736.309, "timestamp": "04:22:16", "text": "デビュー動画または自己紹介動画"}, {"type": "subtitle", "time": 15738.63, "timestamp": "04:22:18", "text": "それも重要です。私は持っていません"}, {"type": "chat", "time": 15739.072, "timestamp": "04:22:19", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "they have a twitter account and they promote their content but there are less views"}, {"type": "subtitle", "time": 15741.11, "timestamp": "04:22:21", "text": "二人とも。"}, {"type": "subtitle", "time": 15743.75, "timestamp": "04:22:23", "text": "それから、えっと"}, {"type": "subtitle", "time": 15746.07, "timestamp": "04:22:26", "text": "彼らの主な目的はクロスオスト"}, {"type": "subtitle", "time": 15747.83, "timestamp": "04:22:27", "text": "複数"}, {"type": "subtitle", "time": 15750.309, "timestamp": "04:22:30", "text": "プラットフォームとか、その他諸々。彼らは"}, {"type": "subtitle", "time": 15751.67, "timestamp": "04:22:31", "text": "Twitterアカウントで宣伝しています"}, {"type": "subtitle", "time": 15753.51, "timestamp": "04:22:33", "text": "コンテンツですが、それらは少なく"}, {"type": "subtitle", "time": 15756.229, "timestamp": "04:22:36", "text": "閲覧数。ふむ。"}, {"type": "subtitle", "time": 15759.83, "timestamp": "04:22:39", "text": "それから、もしあなたが会社に所属しているか、"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "何か、もしあなたが"}, {"type": "subtitle", "time": 15765.11, "timestamp": "04:22:4
[{"type": "subtitle", "time": 2760.79, "timestamp": "00:46:00", "text": "上昇の涙。あ、待って。すでに"}, {"type": "subtitle", "time": 2763.43, "timestamp": "00:46:03", "text": "それでは。歌の一つ"}, {"type": "subtitle", "time": 2766.23, "timestamp": "00:46:06", "text": "彼が一度私に送ってきたもの"}, {"type": "subtitle", "time": 2769.75, "timestamp": "00:46:09", "text": "配信で紹介するのを忘れていました。"}, {"type": "subtitle", "time": 2772.15, "timestamp": "00:46:12", "text": "私は話が脱線しすぎて"}, {"type": "subtitle", "time": 2773.73, "timestamp": "00:46:13", "text": "実は忘れていました。"}, {"type": "subtitle", "time": 2775.67, "timestamp": "00:46:15", "text": "[音楽]"}, {"type": "subtitle", "time": 2794.55, "timestamp": "00:46:34", "text": "トラックが見つかりませんでした。いいえ。削除しましたか？"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "それ？"}, {"type": "subtitle", "time": 2798.55, "timestamp": "00:46:38", "text": "バージョン6。"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "それは11日になるはずだったが、"}, {"type": "subtitle", "time": 2808.95, "timestamp": "00:46:48", "text": "[音楽]"}, {"type": "subtitle", "time": 2811.349, "timestamp": "00:46:51", "text": "えっと、"}, {"type": "subtitle", "time": 2813.51, "timestamp": "00:46:53", "text": "それでは、少しの間画面をぼかさせてください。私"}, {"type": "subtitle", "time": 2816.71, "timestamp": "00:46:56", "text": "Googleからメールが届きました。"}]
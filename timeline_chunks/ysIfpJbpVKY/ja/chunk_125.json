[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "輸入業者・輸出業者コード"}, {"type": "subtitle", "time": 7503.27, "timestamp": "02:05:03", "text": "それが何なのかはわかりませんが、輸入業者"}, {"type": "subtitle", "time": 7506.47, "timestamp": "02:05:06", "text": "エクスポートコードのやり方がわかりません"}, {"type": "subtitle", "time": 7510.229, "timestamp": "02:05:10", "text": "でも、そうしないといけないと思う"}, {"type": "subtitle", "time": 7514.95, "timestamp": "02:05:14", "text": "えーと、DGFT政府、オーケー、ああ、私は"}, {"type": "subtitle", "time": 7518.709, "timestamp": "02:05:18", "text": "直接貿易 外国貿易総局"}, {"type": "subtitle", "time": 7528.709, "timestamp": "02:05:28", "text": "えっと、もし私がそれを売る場合、または海外で売る場合"}, {"type": "subtitle", "time": 7530.629, "timestamp": "02:05:30", "text": "などなど。いいえ、"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "IEC認証。"}, {"type": "subtitle", "time": 7535.35, "timestamp": "02:05:35", "text": "聖なる"}, {"type": "subtitle", "time": 7539.75, "timestamp": "02:05:39", "text": "たくさんの物。何も得られない"}, {"type": "subtitle", "time": 7543.83, "timestamp": "02:05:43", "text": "私の脳。でも、そうするしかないだろうね。"}, {"type": "subtitle", "time": 7546.47, "timestamp": "02:05:46", "text": "皆さんのためにやります"}, {"type": "subtitle", "time": 7548.629, "timestamp": "02:05:48", "text": "なぜなら、私は人々にグッズを買ってもらいたいし、"}, {"type": "subtitle", "time": 7552.47, "timestamp": "02:05:52", "text": "すべて。そして何かを楽しむ"}, {"type": "subtitle", "time": 7555.189, "timestamp": "02:05:55", "text": "今頃は私のことを覚えていてくれるだろう。"}]
[{"type": "subtitle", "time": 10324.389, "timestamp": "02:52:04", "text": "うん、できるよ。配信しようと思う。"}, {"type": "subtitle", "time": 10328.63, "timestamp": "02:52:08", "text": "俺はストリームでそれをやってる男だ"}, {"type": "subtitle", "time": 10331.51, "timestamp": "02:52:11", "text": "まるで私がグッズを梱包しようとしているみたいだ"}, {"type": "subtitle", "time": 10333.83, "timestamp": "02:52:13", "text": "すべてを見て、それらすべてを目撃する"}, {"type": "subtitle", "time": 10336.63, "timestamp": "02:52:16", "text": "もの。"}, {"type": "subtitle", "time": 10338.63, "timestamp": "02:52:18", "text": "何てことだ。"}, {"type": "subtitle", "time": 10342.389, "timestamp": "02:52:22", "text": "それを考えると幸せな気分になる、あぁ"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "それはとても素晴らしいですね。いいえ。"}, {"type": "subtitle", "time": 10348.55, "timestamp": "02:52:28", "text": "そして、私を見ることができるのはあなただけではありません。"}, {"type": "subtitle", "time": 10351.59, "timestamp": "02:52:31", "text": "あなたのために注文を準備します"}, {"type": "subtitle", "time": 10353.99, "timestamp": "02:52:33", "text": "あなたが行くときにあなたのところに来る"}, {"type": "subtitle", "time": 10356.389, "timestamp": "02:52:36", "text": "手に取ってみてください。また、"}, {"type": "subtitle", "time": 10364.95, "timestamp": "02:52:44", "text": "ああ、それは本当に素晴らしいことになりそうだ。"}, {"type": "subtitle", "time": 10367.19, "timestamp": "02:52:47", "text": "待てません。"}, {"type": "subtitle", "time": 10370.11, "timestamp": "02:52:50", "text": "そんな日がいつか来ることを願ったことはありませんか。"}]
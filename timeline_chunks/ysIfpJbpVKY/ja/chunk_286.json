[{"type": "subtitle", "time": 17179.75, "timestamp": "04:46:19", "text": "[音楽]"}, {"type": "subtitle", "time": 17188.788, "timestamp": "04:46:28", "text": "感謝の気持ちを込めて、チーム組織"}, {"type": "subtitle", "time": 17192.15, "timestamp": "04:46:32", "text": "はい、私はシングルプレイヤーです。私は"}, {"type": "subtitle", "time": 17195.75, "timestamp": "04:46:35", "text": "本作ではソロプレイヤーがプレイします。チームはどこにいるの？"}, {"type": "subtitle", "time": 17197.99, "timestamp": "04:46:37", "text": "私はチームを雇うお金がない"}, {"type": "subtitle", "time": 17200.54, "timestamp": "04:46:40", "text": "いろいろ手伝ってくれる人たち。"}]
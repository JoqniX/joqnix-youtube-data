[{"type": "subtitle", "time": 8523.83, "timestamp": "02:22:03", "text": "この人たちは返金に応じてくれるの？ NISだと思います"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "ストアページに掲載されています。"}, {"type": "subtitle", "time": 8528.97, "timestamp": "02:22:08", "text": "はい、返金ポリシーです。"}, {"type": "subtitle", "time": 8537.27, "timestamp": "02:22:17", "text": "彼らのページは読み込みに非常に時間がかかる。のために"}, {"type": "subtitle", "time": 8540.389, "timestamp": "02:22:20", "text": "あなた。ストアページが"}, {"type": "subtitle", "time": 8546.79, "timestamp": "02:22:26", "text": "動作が非常に遅く、ラグが発生するのは良くない。"}, {"type": "subtitle", "time": 8552.469, "timestamp": "02:22:32", "text": "[音楽]"}, {"type": "subtitle", "time": 8563.429, "timestamp": "02:22:43", "text": "これらは十分良いものだろうか？あ、待って、"}, {"type": "subtitle", "time": 8565.91, "timestamp": "02:22:45", "text": "待って、待って。星空も載せられます"}, {"type": "subtitle", "time": 8568.469, "timestamp": "02:22:48", "text": "1つですよね？返金も受けられます"}, {"type": "subtitle", "time": 8570.63, "timestamp": "02:22:50", "text": "ポリシー。"}, {"type": "subtitle", "time": 8573.11, "timestamp": "02:22:53", "text": "ちなみに、スタースケープショップは"}, {"type": "subtitle", "time": 8575.19, "timestamp": "02:22:55", "text": "動作していません。だから、ウェブを使わなければならない"}, {"type": "subtitle", "time": 8577.91, "timestamp": "02:22:57", "text": "アーカイブ"}]
[{"type": "subtitle", "time": 8040.87, "timestamp": "02:14:00", "text": "それが問題なんです。"}, {"type": "subtitle", "time": 8042.87, "timestamp": "02:14:02", "text": "えっと、もしかしたら作ろうかなと思ってたんだけど"}, {"type": "subtitle", "time": 8046.47, "timestamp": "02:14:06", "text": "darknix.space の広告管理者として認めるようなものです"}, {"type": "subtitle", "time": 8048.47, "timestamp": "02:14:08", "text": "あるいは何か"}, {"type": "subtitle", "time": 8051.109, "timestamp": "02:14:11", "text": "混乱した。私はこう考えている"}, {"type": "subtitle", "time": 8053.99, "timestamp": "02:14:13", "text": "そうすべきか、そうすべきでないか。"}, {"type": "subtitle", "time": 8056.709, "timestamp": "02:14:16", "text": "わからない。私はどのようにするかを学ばなければならない"}, {"type": "subtitle", "time": 8059.43, "timestamp": "02:14:19", "text": "人々はメールマガジン関連の作業をしている。"}, {"type": "subtitle", "time": 8061.03, "timestamp": "02:14:21", "text": "いいえ。"}, {"type": "subtitle", "time": 8063.27, "timestamp": "02:14:23", "text": "うん。うん。私は、"}, {"type": "subtitle", "time": 8067.589, "timestamp": "02:14:27", "text": "そうすれば私の配信コンテンツが"}, {"type": "subtitle", "time": 8070.55, "timestamp": "02:14:30", "text": "メール形式。私は何をしたの？すべて"}, {"type": "subtitle", "time": 8073.91, "timestamp": "02:14:33", "text": "今後の配信などがあれば"}, {"type": "subtitle", "time": 8084.55, "timestamp": "02:14:44", "text": "重要な情報、"}, {"type": "subtitle", "time": 8087.43, "timestamp": "02:14:47", "text": "右？何かをするのではなく、もし"}, {"type": "subtitle", "time": 8089.75, "timestamp": "02:14:49", "text": "Discord通知"}, {"type": "subtitle", "time": 8093.51, "timestamp": "02:14:53", "text": "えっと、Twitchは、Discordはありません"}, {"type": "subtitle", "time": 8096.229, "timestamp": "02:14:56", "text": "通知、Twitterの発表、"}, {"type": "subtitle", "time": 8098.149, "timestamp": "02:14:58", "text": "YouTubeのコミュニティ投稿だけでは不十分です。もし"}]
[{"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "そう、他の人たちとチームを組むと"}, {"type": "subtitle", "time": 16086.469, "timestamp": "04:28:06", "text": "コラボレーションとか、その他諸々。"}, {"type": "subtitle", "time": 16089.91, "timestamp": "04:28:09", "text": "しかし、主な事実部分は"}, {"type": "subtitle", "time": 16092.149, "timestamp": "04:28:12", "text": "今、適切な視聴者がいます。そこにいる視聴者"}, {"type": "chat", "time": 16092.633, "timestamp": "04:28:12", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "ok so i should promote it on Twitter, Facebook, Instagram, twitch, kick, discord"}, {"type": "subtitle", "time": 16094.71, "timestamp": "04:28:14", "text": "あなたのコンテンツを実際に楽しんでいる人たち"}, {"type": "subtitle", "time": 16097.189, "timestamp": "04:28:17", "text": "その他"}, {"type": "subtitle", "time": 16099.99, "timestamp": "04:28:19", "text": "望んでいない人々ではなく"}, {"type": "subtitle", "time": 16102.309, "timestamp": "04:28:22", "text": "あなたとすべてを楽しんでいます。そして、誰が有害ですか？"}, {"type": "subtitle", "time": 16105.03, "timestamp": "04:28:25", "text": "などなど。私たちはそんなことは望んでいませんよね？"}, {"type": "subtitle", "time": 16106.79, "timestamp": "04:28:26", "text": "だからTwitterで宣伝するべきだ。"}, {"type": "subtitle", "time": 16110.229, "timestamp": "04:28:30", "text": "Facebook、Instagram、Twitchkind。"}, {"type": "subtitle", "time": 16112.06, "timestamp": "04:28:32", "text": "はい。"}, {"type": "subtitle", "time": 16113.75, "timestamp": "04:28:33", "text": "[音楽]"}, {"type": "subtitle", "time": 16117.91, "timestamp": "04:28:37", "text": "それを宣伝しながら、"}, {"type": "chat", "time": 16118.85, "timestamp": "04:28:38", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "and the gfx people"}, {"type": "subtitle", "time": 16120.389, "timestamp": "04:28:40", "text": "プラットフォーム"}, {"type": "subtitle", "time": 16130.07, "timestamp": "04:28:50", "text": "グラフィックデザイナーみたいにやらないでください。お願いします"}, {"type": "subtitle", "time": 16133.83, "timestamp": "04:28:53", "text": "サーバーにアクセスしないでください、スパム広告"}, {"type": "subtitle", "time": 16136.389, "timestamp": "04:28:56", "text": "そのサーバーとDMにいる全員"}, {"type": "chat", "time": 16136.767, "timestamp": "04:28:56", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "platform what?"}, {"type": "subtitle", "time": 16138.229, "timestamp": "04:28:58", "text": "彼ら。うん、このユーチューバーを見て"}]
[{"type": "subtitle", "time": 3423.51, "timestamp": "00:57:03", "text": "Google Pay関連のものが手に入る限りは"}, {"type": "subtitle", "time": 3426.15, "timestamp": "00:57:06", "text": "確認済み、実際にやっても構いません"}, {"type": "subtitle", "time": 3428.87, "timestamp": "00:57:08", "text": "その無料トライアル。もしかしたら手に入れられるかも"}, {"type": "subtitle", "time": 3431.75, "timestamp": "00:57:11", "text": "このストアは、私がこれを使用できるように実行されています"}, {"type": "subtitle", "time": 3435.109, "timestamp": "00:57:15", "text": "無料トライアルですよね？そしてその後は"}, {"type": "subtitle", "time": 3437.829, "timestamp": "00:57:17", "text": "完了しました。Googleによる認証が完了次第、できるようになります。"}, {"type": "subtitle", "time": 3441.73, "timestamp": "00:57:21", "text": "いいえ、それなら大丈夫ですよね？うん、"}, {"type": "subtitle", "time": 3444.23, "timestamp": "00:57:24", "text": "[音楽]"}, {"type": "subtitle", "time": 3448.23, "timestamp": "00:57:28", "text": "まあ、大丈夫だろう。わからない。"}, {"type": "subtitle", "time": 3451.03, "timestamp": "00:57:31", "text": "あなたが確信しているなら、3月には売れるでしょう。私"}, {"type": "subtitle", "time": 3454.71, "timestamp": "00:57:34", "text": "わからない。私は確信しています。私は確信が持てません"}, {"type": "subtitle", "time": 3456.47, "timestamp": "00:57:36", "text": "あなた"}, {"type": "subtitle", "time": 3460.47, "timestamp": "00:57:40", "text": "それが問題の原因かどうかは分かりません。"}, {"type": "subtitle", "time": 3464.15, "timestamp": "00:57:44", "text": "まだ制作すら始めていない。"}, {"type": "subtitle", "time": 3467.43, "timestamp": "00:57:47", "text": "私は場所を探しに行かなければならない"}, {"type": "subtitle", "time": 3470.47, "timestamp": "00:57:50", "text": "好き"}, {"type": "subtitle", "time": 3472.549, "timestamp": "00:57:52", "text": "でも、それでも私はやりたい"}, {"type": "subtitle", "time": 3476.549, "timestamp": "00:57:56", "text": "お店のやつ。私はそうしなければならない 私はそうしない"}, {"type": "subtitle", "time": 3478.63, "timestamp": "00:57:58", "text": "どうすればいいのかわからない"}]
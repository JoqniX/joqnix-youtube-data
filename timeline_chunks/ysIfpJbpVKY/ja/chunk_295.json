[{"type": "subtitle", "time": 17700.788, "timestamp": "04:55:00", "text": "人々"}, {"type": "subtitle", "time": 17704.07, "timestamp": "04:55:04", "text": "それらをどのように保管しますか？"}, {"type": "subtitle", "time": 17706.788, "timestamp": "04:55:06", "text": "チャットに参加して、配信から離れないでください"}, {"type": "subtitle", "time": 17708.628, "timestamp": "04:55:08", "text": "他の人の試合を見に行く。あなたがしなければならない"}, {"type": "subtitle", "time": 17711.83, "timestamp": "04:55:11", "text": "また、たくさんの人がいると思う"}, {"type": "subtitle", "time": 17713.67, "timestamp": "04:55:13", "text": "あなたと同じことをしている人たち。"}, {"type": "subtitle", "time": 17715.11, "timestamp": "04:55:15", "text": "たとえあなたがユーチューバーであっても、たとえ"}, {"type": "subtitle", "time": 17717.27, "timestamp": "04:55:17", "text": "あなたは今、VTuberをやっているんですよね？"}, {"type": "subtitle", "time": 17719.43, "timestamp": "04:55:19", "text": "多くの人が"}, {"type": "subtitle", "time": 17722.708, "timestamp": "04:55:22", "text": "インドからBtuvingしてるんだよね？とても"}, {"type": "subtitle", "time": 17725.11, "timestamp": "04:55:25", "text": "数多くの競技会も開催された。あなたがしなければならない"}, {"type": "subtitle", "time": 17729.35, "timestamp": "04:55:29", "text": "あなたを他の人と区別するものは何かを理解してください"}, {"type": "subtitle", "time": 17732.07, "timestamp": "04:55:32", "text": "残り。あなたをユニークにしているものは何ですか？"}, {"type": "subtitle", "time": 17733.75, "timestamp": "04:55:33", "text": "人々があなたを見に来て、"}, {"type": "subtitle", "time": 17735.59, "timestamp": "04:55:35", "text": "すべて。しかし、それらすべてを考えてみてください"}, {"type": "chat", "time": 17737.659, "timestamp": "04:55:37", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "ok sorry i stop"}, {"type": "chat", "time": 17738.435, "timestamp": "04:55:38", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "right"}, {"type": "subtitle", "time": 17738.788, "timestamp": "04:55:38", "text": "要因も関係しますよね？そしてもしあなたが"}, {"type": "subtitle", "time": 17741.43, "timestamp": "04:55:41", "text": "拡大したいとか、そういうことを覚えておいてください"}, {"type": "subtitle", "time": 17745.35, "timestamp": "04:55:45", "text": "タイムゾーンを覚えておいてください"}, {"type": "subtitle", "time": 17749.11, "timestamp": "04:55:49", "text": "そして、ええと、いろいろなものも。なぜなら、"}, {"type": "subtitle", "time": 17752.31, "timestamp": "04:55:52", "text": "例えば、午後7時に配信するとします。その時"}, {"type": "subtitle", "time": 17754.628, "timestamp": "04:55:54", "text": "別のYouTuberも配信している。彼らは"}, {"type": "subtitle", "time": 17756.628, "timestamp": "04:55:56", "text": "彼らを観たい人たちがやって来る"}, {"type": "subtitle", "time": 17759.27, "timestamp": "04:55:59", "text": "彼らも見ていますが、私は"}]
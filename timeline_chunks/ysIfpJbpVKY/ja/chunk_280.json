[{"type": "subtitle", "time": 16803.19, "timestamp": "04:40:03", "text": "ええ、それは私にはできないと思います。"}, {"type": "subtitle", "time": 16807.35, "timestamp": "04:40:07", "text": "私は反応を示すのが苦手です。"}, {"type": "subtitle", "time": 16809.51, "timestamp": "04:40:09", "text": "次に観るのは私です。"}, {"type": "subtitle", "time": 16837.51, "timestamp": "04:40:37", "text": "でも情報は得られるよ、"}, {"type": "chat", "time": 16838.975, "timestamp": "04:40:38", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "you love her? Why don't you confess to her then?"}, {"type": "subtitle", "time": 16839.51, "timestamp": "04:40:39", "text": "右？世界では何が起こっているのか"}, {"type": "subtitle", "time": 16841.83, "timestamp": "04:40:41", "text": "あなたの周りは？私はアスペンゴールドを見て"}, {"type": "subtitle", "time": 16845.03, "timestamp": "04:40:45", "text": "テクノロジーは時に時に重要だ。"}, {"type": "subtitle", "time": 16848.23, "timestamp": "04:40:48", "text": "彼らがこれほど多くのコンテンツを作っているという事実"}, {"type": "chat", "time": 16849.804, "timestamp": "04:40:49", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 16850.47, "timestamp": "04:40:50", "text": "ライブストリームを通じて、"}, {"type": "subtitle", "time": 16853.91, "timestamp": "04:40:53", "text": "ビデオ編集者はWSとその他すべてをカットし、"}, {"type": "chat", "time": 16856.23, "timestamp": "04:40:56", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "ok i stop being stupid"}, {"type": "subtitle", "time": 16856.31, "timestamp": "04:40:56", "text": "ちゃんとした動画とかとして公開するんだ。"}]
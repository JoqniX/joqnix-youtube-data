[{"type": "subtitle", "time": 9602.469, "timestamp": "02:40:02", "text": "Twitch関連のもの。 YouTubeはどこにあるの？"}, {"type": "subtitle", "time": 9604.55, "timestamp": "02:40:04", "text": "待って、YouTubeはどこにあるの？たくさんあります"}, {"type": "subtitle", "time": 9606.79, "timestamp": "02:40:06", "text": "Twitch関連のもの。うわあ、たくさんありますね。"}, {"type": "subtitle", "time": 9609.99, "timestamp": "02:40:09", "text": "わかった。 HTTP は現在 undefined を返します"}, {"type": "subtitle", "time": 9613.429, "timestamp": "02:40:13", "text": "リクエストが"}, {"type": "subtitle", "time": 9615.349, "timestamp": "02:40:15", "text": "失敗した。"}, {"type": "subtitle", "time": 9618.07, "timestamp": "02:40:18", "text": "わかった。"}, {"type": "subtitle", "time": 9621.11, "timestamp": "02:40:21", "text": "動画を入手しましょう。 Twitchでの配信。 Twitch がたくさんある"}, {"type": "subtitle", "time": 9623.59, "timestamp": "02:40:23", "text": "コマンド。これらのTwitchを見てください"}, {"type": "subtitle", "time": 9626.309, "timestamp": "02:40:26", "text": "コマンドの修正。"}, {"type": "subtitle", "time": 9629.11, "timestamp": "02:40:29", "text": "私はTWを使っていません。わかった。さあ、ユーザーを推測してみましょう"}, {"type": "subtitle", "time": 9631.11, "timestamp": "02:40:31", "text": "リクエストが失敗した場合。詳細説明"}, {"type": "subtitle", "time": 9636.309, "timestamp": "02:40:36", "text": "エラーはここから発生しました。おお、"}, {"type": "subtitle", "time": 9640.63, "timestamp": "02:40:40", "text": "いいね、いいね、いいね。えっと、アップロードします。わかった。"}, {"type": "subtitle", "time": 9643.349, "timestamp": "02:40:43", "text": "行データトリガーのプル機能を追加しました。わかった。のために"}, {"type": "subtitle", "time": 9646.15, "timestamp": "02:40:46", "text": "Twitchのことですよね？ああ、Twitchが恋しい。どこ"}, {"type": "subtitle", "time": 9649.11, "timestamp": "02:40:49", "text": "私の息子はIOと一緒にYouTubeをやってるの？"}, {"type": "subtitle", "time": 9651.75, "timestamp": "02:40:51", "text": "わかった。紫色のコマンドが今、命令を出しています。非同期"}, {"type": "subtitle", "time": 9654.23, "timestamp": "02:40:54", "text": "チェックボックスは新しい同期型と交換されます"}, {"type": "subtitle", "time": 9657.19, "timestamp": "02:40:57", "text": "グレーのコマンドオプション。指示。わかった。えっと、"}]
[{"type": "subtitle", "time": 12902.15, "timestamp": "03:35:02", "text": "そのため、私はその女性に説明しました"}, {"type": "subtitle", "time": 12905.03, "timestamp": "03:35:05", "text": "電話しながら「ああ、だから私は"}, {"type": "subtitle", "time": 12908.309, "timestamp": "03:35:08", "text": "自分で「はい」を押したので、彼らは「わかった」という感じでした。"}, {"type": "subtitle", "time": 12909.99, "timestamp": "03:35:09", "text": "それについては何とか考えます"}, {"type": "subtitle", "time": 12912.63, "timestamp": "03:35:12", "text": "心配しないで、それから私は疑問を尋ねました"}, {"type": "subtitle", "time": 12915.99, "timestamp": "03:35:15", "text": "ポリシーページに気づいたのですが、"}, {"type": "subtitle", "time": 12918.55, "timestamp": "03:35:18", "text": "レーサーペイによって提供された私の"}, {"type": "subtitle", "time": 12920.71, "timestamp": "03:35:20", "text": "住所などの情報"}, {"type": "subtitle", "time": 12923.269, "timestamp": "03:35:23", "text": "立地も全て含めて。もし私が"}, {"type": "subtitle", "time": 12925.83, "timestamp": "03:35:25", "text": "自分のポリシーとかを作るってこと？"}, {"type": "subtitle", "time": 12930.15, "timestamp": "03:35:30", "text": "場所を含めなくても大丈夫です"}, {"type": "subtitle", "time": 12932.469, "timestamp": "03:35:32", "text": "私のビジネスがある場所、"}, {"type": "subtitle", "time": 12934.229, "timestamp": "03:35:34", "text": "詳細情報と電話番号。"}, {"type": "subtitle", "time": 12936.469, "timestamp": "03:35:36", "text": "彼らは「それは必須事項だ」と言った。私は"}, {"type": "subtitle", "time": 12939.269, "timestamp": "03:35:39", "text": "えーっと"}, {"type": "subtitle", "time": 12942.229, "timestamp": "03:35:42", "text": "そして私はインカンダックスのオフィスへ行った。"}, {"type": "subtitle", "time": 12946.15, "timestamp": "03:35:46", "text": "私の家の近くにあるとヘッドが尋ねた"}, {"type": "subtitle", "time": 12949.349, "timestamp": "03:35:49", "text": "ヘッドレディは、えっと、これは私のこれです"}, {"type": "subtitle", "time": 12952.07, "timestamp": "03:35:52", "text": "問題は、彼らがこう言ったのは大丈夫かということですか"}, {"type": "subtitle", "time": 12954.15, "timestamp": "03:35:54", "text": "私が自分の荷物を手伝うとき"}, {"type": "chat", "time": 12956.549, "timestamp": "03:35:56", "author": "@mattmeownster", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k0PVo4Ayjzf9FlRcdjZAQYBwK430_hLvWlP9jgikQjC65W-ONDWjkk4dykteuHJ96HgQ=s64-c-k-c0x00ffffff-no-rj", "message": "yea"}, {"type": "subtitle", "time": 12956.79, "timestamp": "03:35:56", "text": "最初は彼らに助けを求めに行った"}, {"type": "subtitle", "time": 12959.51, "timestamp": "03:35:59", "text": "両親は「うん、そうだね」って感じだった"}]
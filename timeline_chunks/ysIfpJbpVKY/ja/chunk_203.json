[{"type": "subtitle", "time": 12180.389, "timestamp": "03:23:00", "text": "あらゆるジャンルの音楽を制作"}, {"type": "subtitle", "time": 12183.67, "timestamp": "03:23:03", "text": "イラスト ファン ラジオ"}, {"type": "subtitle", "time": 12185.67, "timestamp": "03:23:05", "text": "そこで働く人々と支援者ガイドライン"}, {"type": "subtitle", "time": 12188.79, "timestamp": "03:23:08", "text": "サポーターの行動はヴィシュにとって"}, {"type": "subtitle", "time": 12191.11, "timestamp": "03:23:11", "text": "基本的な倫理観とすべてのこと、そしてもし"}, {"type": "subtitle", "time": 12193.75, "timestamp": "03:23:13", "text": "あなたはマイナーにとって小さな要求です"}, {"type": "subtitle", "time": 12195.91, "timestamp": "03:23:15", "text": "では、何をすべきか、何をすべきでないか、そして"}, {"type": "subtitle", "time": 12198.79, "timestamp": "03:23:18", "text": "すべてと違法な保護者関連"}, {"type": "subtitle", "time": 12202.389, "timestamp": "03:23:22", "text": "それからライブチャットなどには、"}, {"type": "subtitle", "time": 12204.87, "timestamp": "03:23:24", "text": "ライブチャットのガイドラインがあり、"}, {"type": "subtitle", "time": 12207.349, "timestamp": "03:23:27", "text": "ライブストリームのコミュニティ、そして"}, {"type": "subtitle", "time": 12211.67, "timestamp": "03:23:31", "text": "法的なことも全てここにあります"}, {"type": "subtitle", "time": 12215.59, "timestamp": "03:23:35", "text": "これは長すぎる、長すぎる"}, {"type": "subtitle", "time": 12218.309, "timestamp": "03:23:38", "text": "そう、ここのグッズは"}, {"type": "subtitle", "time": 12220.55, "timestamp": "03:23:40", "text": "えっと、あのウェブサイトの作業をしないといけないんです"}, {"type": "subtitle", "time": 12222.07, "timestamp": "03:23:42", "text": "後で。"}, {"type": "subtitle", "time": 12225.269, "timestamp": "03:23:45", "text": "私はまだ考えているところです。"}, {"type": "subtitle", "time": 12228.309, "timestamp": "03:23:48", "text": "プログラミングの知識があること。私はこのウェブビルダーを使っています"}, {"type": "subtitle", "time": 12235.51, "timestamp": "03:23:55", "text": "彼らが追加するのを待たなければならない"}, {"type": "subtitle", "time": 12238.55, "timestamp": "03:23:58", "text": "これはeコマース統合です。"}]
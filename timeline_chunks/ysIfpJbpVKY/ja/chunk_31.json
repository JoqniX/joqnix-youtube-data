[{"type": "subtitle", "time": 1862.87, "timestamp": "00:31:02", "text": "何か、えっと、彼らに頼んで、"}, {"type": "subtitle", "time": 1865.11, "timestamp": "00:31:05", "text": "すべて問題なければ校正してください。"}, {"type": "subtitle", "time": 1868.07, "timestamp": "00:31:08", "text": "ない。うん。うん。だから私はただ"}, {"type": "subtitle", "time": 1876.389, "timestamp": "00:31:16", "text": "自分で書くにはどうすればいいですか、"}, {"type": "subtitle", "time": 1878.87, "timestamp": "00:31:18", "text": "どれくらい高価かご存知ですか"}, {"type": "subtitle", "time": 1881.35, "timestamp": "00:31:21", "text": "弁護士に書いてもらう。その"}, {"type": "subtitle", "time": 1884.63, "timestamp": "00:31:24", "text": "自分で下書きして、質問した方がいいでしょう"}, {"type": "subtitle", "time": 1887.11, "timestamp": "00:31:27", "text": "彼らにそれを読ませ、もしあらゆる選択肢があれば"}, {"type": "subtitle", "time": 1888.95, "timestamp": "00:31:28", "text": "何か変更する必要がある場合は、"}, {"type": "subtitle", "time": 1891.669, "timestamp": "00:31:31", "text": "すぐに変更してください。それは"}, {"type": "subtitle", "time": 1894.87, "timestamp": "00:31:34", "text": "弁護士に頼む方がずっといい"}, {"type": "subtitle", "time": 1900.389, "timestamp": "00:31:40", "text": "あなた？ええと、高価になるでしょう。"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "彼らにはただ読んでもらうように頼むだけです"}, {"type": "subtitle", "time": 1905.99, "timestamp": "00:31:45", "text": "何かあれば教えてください。それは"}, {"type": "subtitle", "time": 1909.11, "timestamp": "00:31:49", "text": "まあ、良くなったと思う。わからない。"}, {"type": "subtitle", "time": 1910.95, "timestamp": "00:31:50", "text": "正しい方法がわからない。私"}, {"type": "subtitle", "time": 1915.11, "timestamp": "00:31:55", "text": "正しいやり方は、えっと"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "弁護士に頼んだ方がいいと思うよ。または"}]
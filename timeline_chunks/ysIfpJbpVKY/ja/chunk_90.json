[{"type": "subtitle", "time": 5402.229, "timestamp": "01:30:02", "text": "私はもうOBSを使っていないので、メル。"}, {"type": "subtitle", "time": 5405.99, "timestamp": "01:30:05", "text": "これ、右のぼやけたやつ。私は"}, {"type": "subtitle", "time": 5409.51, "timestamp": "01:30:09", "text": "「よし、今すぐやってみよう」と思った。"}, {"type": "subtitle", "time": 5412.31, "timestamp": "01:30:12", "text": "試してみましょう。はい、確認してみました"}, {"type": "subtitle", "time": 5415.189, "timestamp": "01:30:15", "text": "APIに再読み込みする方法があれば"}, {"type": "subtitle", "time": 5418.39, "timestamp": "01:30:18", "text": "ブラウザ。そうではない。追加してほしい"}, {"type": "subtitle", "time": 5421.59, "timestamp": "01:30:21", "text": "すぐに。でも、ええ、それで私は"}, {"type": "subtitle", "time": 5425.83, "timestamp": "01:30:25", "text": "使用すべきなのはmeldです"}, {"type": "subtitle", "time": 5428.629, "timestamp": "01:30:28", "text": "努力の切り替えはこちらで表示されます。これです"}, {"type": "subtitle", "time": 5432.149, "timestamp": "01:30:32", "text": "これです。シーン名は"}, {"type": "subtitle", "time": 5435.59, "timestamp": "01:30:35", "text": "ゲーム。レイヤー名は"}, {"type": "subtitle", "time": 5437.83, "timestamp": "01:30:37", "text": "画面キャプチャ。"}, {"type": "subtitle", "time": 5442.629, "timestamp": "01:30:42", "text": "効果名は「ああ、君が見える」になります"}, {"type": "subtitle", "time": 5445.83, "timestamp": "01:30:45", "text": "ゴイアン・ブラー。"}, {"type": "subtitle", "time": 5449.51, "timestamp": "01:30:49", "text": "ああ、その効果の名前は変更できません。"}, {"type": "subtitle", "time": 5452.47, "timestamp": "01:30:52", "text": "おお"}, {"type": "subtitle", "time": 5453.83, "timestamp": "01:30:53", "text": "待って待って待って。見たい。したい"}]
[{"type": "subtitle", "time": 12362.95, "timestamp": "03:26:02", "text": "うん。うーん、まあまあ"}, {"type": "subtitle", "time": 12365.83, "timestamp": "03:26:05", "text": "えっと、最後まで言わせてください。私はいくら"}, {"type": "subtitle", "time": 12368.63, "timestamp": "03:26:08", "text": "もう一度連絡できますか？返金方法と"}, {"type": "subtitle", "time": 12375.19, "timestamp": "03:26:15", "text": "どのような商品を販売する予定ですか？"}, {"type": "subtitle", "time": 12378.229, "timestamp": "03:26:18", "text": "正直よくわからないのですが、"}, {"type": "subtitle", "time": 12380.469, "timestamp": "03:26:20", "text": "売ろうかと考えています"}, {"type": "subtitle", "time": 12384.389, "timestamp": "03:26:24", "text": "まずはインド国内で試してみて、"}, {"type": "subtitle", "time": 12386.79, "timestamp": "03:26:26", "text": "行く。じゃあ国際的にやるよ"}, {"type": "subtitle", "time": 12390.07, "timestamp": "03:26:30", "text": "私には、えっと、えっと、"}, {"type": "subtitle", "time": 12392.79, "timestamp": "03:26:32", "text": "倉庫、またはこれらすべての会社と同様、または"}, {"type": "subtitle", "time": 12395.269, "timestamp": "03:26:35", "text": "私を助けてくれるもの。いいえ。ええと、私は"}, {"type": "subtitle", "time": 12397.99, "timestamp": "03:26:37", "text": "全部自分でやらなきゃいけないんだよね？"}, {"type": "subtitle", "time": 12401.83, "timestamp": "03:26:41", "text": "自分で印刷して自分で発送する。"}, {"type": "subtitle", "time": 12403.11, "timestamp": "03:26:43", "text": "右？"}, {"type": "subtitle", "time": 12407.03, "timestamp": "03:26:47", "text": "それで、今は、えーと、"}, {"type": "subtitle", "time": 12410.07, "timestamp": "03:26:50", "text": "小さなことを考える"}, {"type": "subtitle", "time": 12412.87, "timestamp": "03:26:52", "text": "ステッカーパックか何か、それから"}, {"type": "subtitle", "time": 12415.19, "timestamp": "03:26:55", "text": "キーホルダーか何か、ピンバッジか何か"}, {"type": "subtitle", "time": 12419.51, "timestamp": "03:26:59", "text": "私のスポーツマンっぽいものについて何か"}]
[{"type": "subtitle", "time": 6242.55, "timestamp": "01:44:02", "text": "音楽。えっと、BGMかな"}, {"type": "subtitle", "time": 6246.149, "timestamp": "01:44:06", "text": "GB。はい、イギリス人騎手のぬいぐるみです。はい、必要です"}, {"type": "subtitle", "time": 6249.27, "timestamp": "01:44:09", "text": "それ。私たちは必要としなければならない それは私の"}, {"type": "subtitle", "time": 6252.39, "timestamp": "01:44:12", "text": "最優先事項。本当にそれが必要なんです。私 私"}, {"type": "subtitle", "time": 6255.91, "timestamp": "01:44:15", "text": "それが欲しい。私はそれが欲しい。ハグしたい"}, {"type": "subtitle", "time": 6258.149, "timestamp": "01:44:18", "text": "ちびジョッキーのぬいぐるみと寝る"}, {"type": "subtitle", "time": 6261.51, "timestamp": "01:44:21", "text": "夜になると、「私の"}, {"type": "subtitle", "time": 6265.109, "timestamp": "01:44:25", "text": "「息子よ、ご飯食べたか？」まるで甘やかすように"}, {"type": "subtitle", "time": 6276.31, "timestamp": "01:44:36", "text": "えーと、BJミュージック"}, {"type": "subtitle", "time": 6279.59, "timestamp": "01:44:39", "text": "現実による"}, {"type": "subtitle", "time": 6287.35, "timestamp": "01:44:47", "text": "ウム・イセン"}, {"type": "subtitle", "time": 6289.51, "timestamp": "01:44:49", "text": "えっと"}, {"type": "subtitle", "time": 6298.95, "timestamp": "01:44:58", "text": "私の配信のBGM音楽は私の"}]
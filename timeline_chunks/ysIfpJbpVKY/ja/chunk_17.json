[{"type": "subtitle", "time": 1023.59, "timestamp": "00:17:03", "text": "先生はこう言った。"}, {"type": "subtitle", "time": 1027.11, "timestamp": "00:17:07", "text": "先生は「うん、着ないで」って言った"}, {"type": "subtitle", "time": 1035.669, "timestamp": "00:17:15", "text": "音楽を聴きながら、いい感じに、"}, {"type": "subtitle", "time": 1038.87, "timestamp": "00:17:18", "text": "そして私は自分の準備をしていた"}, {"type": "subtitle", "time": 1040.87, "timestamp": "00:17:20", "text": "クラス"}, {"type": "subtitle", "time": 1043.35, "timestamp": "00:17:23", "text": "そして私はいくつあるか確認する気にもならなかった"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "クリックした回数"}, {"type": "subtitle", "time": 1066.71, "timestamp": "00:17:46", "text": "実際には確認していません。私の調子はどうですか？"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "[音楽]"}]
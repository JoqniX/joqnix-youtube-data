[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "どちらだったか忘れてしまった。これが何だったか忘れてしまった"}, {"type": "subtitle", "time": 5050.07, "timestamp": "01:24:10", "text": "セブン。ああ、それは特集されるんですね"}, {"type": "subtitle", "time": 5051.75, "timestamp": "01:24:11", "text": "アドベンチャーゲーム。ああ、そうだ、そうだ、"}, {"type": "subtitle", "time": 5054.149, "timestamp": "01:24:14", "text": "アドベンチャーゲーム。これを忘れてた。その"}, {"type": "subtitle", "time": 5057.99, "timestamp": "01:24:17", "text": "Steamで配信されているゲーム。これです。"}, {"type": "subtitle", "time": 5061.51, "timestamp": "01:24:21", "text": "ああ、忘れてた。これを忘れてた。"}, {"type": "subtitle", "time": 5064.709, "timestamp": "01:24:24", "text": "7つの民族が選ばれた。だから私は思う"}, {"type": "subtitle", "time": 5068.39, "timestamp": "01:24:28", "text": "優勝者の作品は"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "アニメ。いいえ、それは"}, {"type": "subtitle", "time": 5073.59, "timestamp": "01:24:33", "text": "ゲームはもう始まっている。"}, {"type": "subtitle", "time": 5077.03, "timestamp": "01:24:37", "text": "それはとても素晴らしいですね。いいえ。"}, {"type": "subtitle", "time": 5082.31, "timestamp": "01:24:42", "text": "とにかく、気が散ってしまった。しましょうか？えっと"}, {"type": "subtitle", "time": 5083.59, "timestamp": "01:24:43", "text": "[音楽]"}, {"type": "subtitle", "time": 5087.83, "timestamp": "01:24:47", "text": "ほら、彼らはインドを持っていない"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "ここの国"}, {"type": "subtitle", "time": 5091.73, "timestamp": "01:24:51", "text": "でも残念だね。"}, {"type": "subtitle", "time": 5096.709, "timestamp": "01:24:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "はい、何度も気が散ってしまいました。えっと"}]
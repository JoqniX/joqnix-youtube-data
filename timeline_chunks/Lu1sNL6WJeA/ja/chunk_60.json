[{"type": "subtitle", "time": 3604.47, "timestamp": "01:00:04", "text": "こちらは故障しています。   わかった"}, {"type": "subtitle", "time": 3615.03, "timestamp": "01:00:15", "text": "ああ、あなたはどこから来たのですか？ 手伝っていただけますか"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "？ 私は良い"}, {"type": "subtitle", "time": 3618.95, "timestamp": "01:00:18", "text": "武器を持っていません。 何てことだ。 まさか本気じゃないよね。   まさか"}, {"type": "subtitle", "time": 3622.069, "timestamp": "01:00:22", "text": "本気じゃないよね。 よし、"}, {"type": "subtitle", "time": 3624.71, "timestamp": "01:00:24", "text": "武器を手に入れたぞ。 どうやら私は複数の"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "武器を持っているようだ。   何てことだ"}, {"type": "subtitle", "time": 3635.78, "timestamp": "01:00:35", "text": "私は彼らと向き合わなければならない。"}, {"type": "subtitle", "time": 3646.23, "timestamp": "01:00:46", "text": "我々が銃を持った男を捕まえる。   ああ"}, {"type": "subtitle", "time": 3650.829, "timestamp": "01:00:50", "text": "、私は死んでしまった。 彼は何をしているのですか"}]
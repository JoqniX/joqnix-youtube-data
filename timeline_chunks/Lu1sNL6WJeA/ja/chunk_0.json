[{"type": "subtitle", "time": 18.07, "timestamp": "00:00:18", "text": "ああ、やったー。 停止。 彼らはどうなの？"}, {"type": "subtitle", "time": 19.99, "timestamp": "00:00:19", "text": "今はもう、彼らの問題はあなたの問題です。"}, {"type": "subtitle", "time": 22.39, "timestamp": "00:00:22", "text": "彼らをここに置いておくわけにはいかない。 彼らは民間人だ。 もし私が"}, {"type": "subtitle", "time": 24.47, "timestamp": "00:00:24", "text": "あなただったら、自分の"}, {"type": "subtitle", "time": 26.87, "timestamp": "00:00:26", "text": "生存を心配するでしょうね、大佐。   何てことだ"}, {"type": "subtitle", "time": 30.15, "timestamp": "00:00:30", "text": "。 なぜノックがないのか。"}, {"type": "subtitle", "time": 32.95, "timestamp": "00:00:32", "text": "彼は私たちのもとを去った。 一体どういうことだ？"}, {"type": "subtitle", "time": 36.229, "timestamp": "00:00:36", "text": "ここまで登ってきてください。 隊長、応答せよ。兵士よ、"}, {"type": "subtitle", "time": 39.11, "timestamp": "00:00:39", "text": "隊長は死んだ。   なんてこった。"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "あれは岩ですか？   なんてこった。"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "私たちは衝突に向かっている。 私たちは"}, {"type": "subtitle", "time": 51.51, "timestamp": "00:00:51", "text": "橋にたどり着かなければならない。 ああ、また別の"}, {"type": "subtitle", "time": 54.389, "timestamp": "00:00:54", "text": "問題が発生した。 星しかもらえなかった。 ああ、"}, {"type": "subtitle", "time": 57.75, "timestamp": "00:00:57", "text": "ライフル銃は持ってるよ。 さあ行こう。"}]
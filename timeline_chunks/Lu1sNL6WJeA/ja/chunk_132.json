[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "うんうん、まさにその通り。うん、今まであまり気にしたことはなかった"}, {"type": "subtitle", "time": 7923.99, "timestamp": "02:12:03", "text": "けど、"}, {"type": "subtitle", "time": 7925.91, "timestamp": "02:12:05", "text": "最近アニメで気付いたんだ。"}, {"type": "subtitle", "time": 7927.75, "timestamp": "02:12:07", "text": "え、"}, {"type": "subtitle", "time": 7930.229, "timestamp": "02:12:10", "text": "ちょっと待って。どういう意味？って思ったよ。"}, {"type": "subtitle", "time": 7931.99, "timestamp": "02:12:11", "text": "昔のものみたいな感じもすると思う"}, {"type": "subtitle", "time": 7954.87, "timestamp": "02:12:34", "text": "ああ、ゲームがすごくラグい。ああ、"}, {"type": "subtitle", "time": 7958.87, "timestamp": "02:12:38", "text": "これはちょっと変だ。"}, {"type": "subtitle", "time": 7974.229, "timestamp": "02:12:54", "text": "オーケー。あそこにいるのか、ここにいるのか？"}, {"type": "subtitle", "time": 7979.109, "timestamp": "02:12:59", "text": "Aにある。Aは"}]
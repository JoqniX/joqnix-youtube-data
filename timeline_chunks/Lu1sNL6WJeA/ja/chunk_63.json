[{"type": "subtitle", "time": 3781.19, "timestamp": "01:03:01", "text": "ああ、私は凶悪犯を殺してしまった。 私はチンピラを殺した。"}, {"type": "subtitle", "time": 3784.309, "timestamp": "01:03:04", "text": "ああ、なんてことだ、私はチンピラを殺してしまった。"}, {"type": "subtitle", "time": 3787.19, "timestamp": "01:03:07", "text": "ああ、あなたは彼を殺したのですね。 おお、いいね。 了解、"}, {"type": "subtitle", "time": 3790.71, "timestamp": "01:03:10", "text": "了解。 ああ、ああ、一体何なんだ、私が今やっているこの"}, {"type": "subtitle", "time": 3793.75, "timestamp": "01:03:13", "text": "奇妙にリアルなデタラメは"}, {"type": "subtitle", "time": 3801.99, "timestamp": "01:03:21", "text": "それから、ロコ、ハッピーバレンタインデー！   凶悪な"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "ナイフ。"}, {"type": "subtitle", "time": 3807.589, "timestamp": "01:03:27", "text": "おお。 お越しいただきありがとうございます。 このために"}, {"type": "subtitle", "time": 3810.349, "timestamp": "01:03:30", "text": "4つの"}, {"type": "subtitle", "time": 3813.19, "timestamp": "01:03:33", "text": "メディキットと戦った甲斐があったと、本当に嬉しい。"}, {"type": "subtitle", "time": 3815.589, "timestamp": "01:03:35", "text": "ここに修理台はありますか？ そうそう。"}, {"type": "subtitle", "time": 3819.349, "timestamp": "01:03:39", "text": "あそこに"}, {"type": "subtitle", "time": 3826.069, "timestamp": "01:03:46", "text": "ああ、わかりました。 わかった。"}, {"type": "subtitle", "time": 3839.27, "timestamp": "01:03:59", "text": "ああ、これだ。"}]
[{"type": "subtitle", "time": 2941.67, "timestamp": "00:49:01", "text": "。 じゃあ、"}, {"type": "subtitle", "time": 2944.87, "timestamp": "00:49:04", "text": "そこへ行ってみようか。"}, {"type": "subtitle", "time": 2948.309, "timestamp": "00:49:08", "text": "うん。 途中で。 毒爆弾。 一体どういうことだ"}, {"type": "subtitle", "time": 2951.19, "timestamp": "00:49:11", "text": "？ ああ、どうせ"}, {"type": "subtitle", "time": 2964.99, "timestamp": "00:49:24", "text": "？ ああ、ちなみにそれは違うよ"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "。 うん。 こんにちは、ドラゴンさん。 いらっしゃいませ。 元気かい"}, {"type": "subtitle", "time": 2970.39, "timestamp": "00:49:30", "text": "？ メディアミアは順調に活動している。 元気ですか"}, {"type": "subtitle", "time": 2973.349, "timestamp": "00:49:33", "text": "？ お元気でお過ごしでしょうか。 何てことだ"}, {"type": "subtitle", "time": 2976.15, "timestamp": "00:49:36", "text": "。"}, {"type": "subtitle", "time": 2989.87, "timestamp": "00:49:49", "text": "あれ、今気づいたんだけど、私には"}, {"type": "subtitle", "time": 2992.43, "timestamp": "00:49:52", "text": "回復アイテムがないんだ"}, {"type": "subtitle", "time": 2996.79, "timestamp": "00:49:56", "text": "。 私の救急箱はもうなくなってしまいました。"}]
[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "。私のPFPは"}, {"type": "subtitle", "time": 7322.87, "timestamp": "02:02:02", "text": "実は、"}, {"type": "subtitle", "time": 7324.79, "timestamp": "02:02:04", "text": "えっと、夜、ほら、騎士が"}, {"type": "subtitle", "time": 7328.51, "timestamp": "02:02:08", "text": "電話に出ているの。すごく面白いわ。"}, {"type": "subtitle", "time": 7332.79, "timestamp": "02:02:12", "text": "ああ、わかった。追加したと思うわ。"}, {"type": "subtitle", "time": 7334.79, "timestamp": "02:02:14", "text": "うん。 わかった。どうぞ。どうぞ。よし。"}, {"type": "subtitle", "time": 7341.35, "timestamp": "02:02:21", "text": "インスタグラムやってる？"}, {"type": "subtitle", "time": 7346.87, "timestamp": "02:02:26", "text": "視聴者と遊んでたんだ。じゃあ、"}, {"type": "subtitle", "time": 7349.189, "timestamp": "02:02:29", "text": "待ってたよ。あ、ブロンズ1か。"}, {"type": "subtitle", "time": 7351.03, "timestamp": "02:02:31", "text": "あ、いや。大丈夫。"}, {"type": "subtitle", "time": 7352.709, "timestamp": "02:02:32", "text": "アンレートでプレイしよう。"}, {"type": "subtitle", "time": 7355.35, "timestamp": "02:02:35", "text": "ランクマッチも"}, {"type": "subtitle", "time": 7357.83, "timestamp": "02:02:37", "text": "たまにやるよね。たまにね。"}, {"type": "subtitle", "time": 7360.109, "timestamp": "02:02:40", "text": "すごい。ゴールドもか。いい感じ"}, {"type": "subtitle", "time": 7363.43, "timestamp": "02:02:43", "text": "。えーと、それが問題なんだよ。"}, {"type": "subtitle", "time": 7367.75, "timestamp": "02:02:47", "text": "ゴールドって、本当に"}, {"type": "subtitle", "time": 7376.87, "timestamp": "02:02:56", "text": "人はスマーフィングしてるか、ゲームが下手かのどっちかなんだ。中間は"}]
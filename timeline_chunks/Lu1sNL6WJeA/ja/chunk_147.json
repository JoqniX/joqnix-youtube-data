[{"type": "subtitle", "time": 8821.51, "timestamp": "02:27:01", "text": "プロになりたかったんだね。うん。うん。"}, {"type": "subtitle", "time": 8823.19, "timestamp": "02:27:03", "text": "プロのカウンターストライク"}, {"type": "subtitle", "time": 8825.91, "timestamp": "02:27:05", "text": "プレイヤーになりたかったんだ。ああ、同じリーグだね。うん"}, {"type": "subtitle", "time": 8832.95, "timestamp": "02:27:12", "text": "子供の頃は、"}, {"type": "subtitle", "time": 8836.63, "timestamp": "02:27:16", "text": "スポーツ選手とかになりたかったよね。"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "ゲームをして"}, {"type": "subtitle", "time": 8843.51, "timestamp": "02:27:23", "text": "お金を稼ぐ夢の仕事とか。うん。 まさにその通り。まさにその通り。"}, {"type": "subtitle", "time": 8845.59, "timestamp": "02:27:25", "text": "残念ながら、そういう仕組みじゃないんだ。"}, {"type": "subtitle", "time": 8848.63, "timestamp": "02:27:28", "text": "現実世界では残念なことだ"}, {"type": "subtitle", "time": 8850.49, "timestamp": "02:27:30", "text": "けど、まあいいさ。"}, {"type": "subtitle", "time": 8851.67, "timestamp": "02:27:31", "text": "[音楽]"}, {"type": "subtitle", "time": 8855.26, "timestamp": "02:27:35", "text": "夢とかそういうのを持つのはいいことだ。"}, {"type": "subtitle", "time": 8863.67, "timestamp": "02:27:43", "text": "[音楽]"}, {"type": "subtitle", "time": 8866.95, "timestamp": "02:27:46", "text": "ああ、そうだね。君もスプリットゲートをプレイしたことがある"}, {"type": "subtitle", "time": 8870.389, "timestamp": "02:27:50", "text": "？ スプリットゲート。ああ、"}, {"type": "subtitle", "time": 8872.79, "timestamp": "02:27:52", "text": "オリジナル版はプレイしたことがあるよ。彼らは"}, {"type": "subtitle", "time": 8874.55, "timestamp": "02:27:54", "text": "それを削除したか、削除したと思う"}, {"type": "subtitle", "time": 8876.15, "timestamp": "02:27:56", "text": "。持っていると思うけど。わからない。彼らは"}, {"type": "subtitle", "time": 8877.75, "timestamp": "02:27:57", "text": "新しいものを作っているんだ。いや。うん。うん、"}]
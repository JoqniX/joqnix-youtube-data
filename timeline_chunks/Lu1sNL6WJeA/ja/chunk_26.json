[{"type": "subtitle", "time": 1564.84, "timestamp": "00:26:04", "text": "。 ああ、私の武器が破損しています。 それが"}, {"type": "subtitle", "time": 1576.87, "timestamp": "00:26:16", "text": "今度こそ本当に死んでしまった。"}, {"type": "subtitle", "time": 1580.03, "timestamp": "00:26:20", "text": "ああ、よかった。"}, {"type": "subtitle", "time": 1594.87, "timestamp": "00:26:34", "text": "[拍手]"}, {"type": "subtitle", "time": 1597.19, "timestamp": "00:26:37", "text": "ああ、また死んでしまった。 そして、スキルを選択してください"}, {"type": "subtitle", "time": 1611.31, "timestamp": "00:26:51", "text": "ええ、できますよ。"}, {"type": "subtitle", "time": 1614.39, "timestamp": "00:26:54", "text": "[拍手]"}]
[{"type": "subtitle", "time": 7560.95, "timestamp": "02:06:00", "text": "ああ、もう。わかった。"}, {"type": "subtitle", "time": 7564.07, "timestamp": "02:06:04", "text": "何をしたいの？"}, {"type": "subtitle", "time": 7566.95, "timestamp": "02:06:06", "text": "えっと、ちょっと待って。待って、"}, {"type": "subtitle", "time": 7569.75, "timestamp": "02:06:09", "text": "ゲームにマウスのキーバインドを設定してる？"}, {"type": "subtitle", "time": 7582.149, "timestamp": "02:06:22", "text": "マウスに割り当ててる。わかった、ちょっと待って。"}, {"type": "subtitle", "time": 7584.149, "timestamp": "02:06:24", "text": "ドアを閉めるね。"}, {"type": "subtitle", "time": 7586.07, "timestamp": "02:06:26", "text": "どうぞ。あの"}, {"type": "subtitle", "time": 7591.43, "timestamp": "02:06:31", "text": "人はスパイクを持っている。あ、"}, {"type": "subtitle", "time": 7599.51, "timestamp": "02:06:39", "text": "あ、2人いる。気をつけろ。1人"}, {"type": "subtitle", "time": 7602.149, "timestamp": "02:06:42", "text": "低い。"}, {"type": "subtitle", "time": 7603.91, "timestamp": "02:06:43", "text": "あ、あれは君じゃなかった。あれは誰だ？誰が"}, {"type": "subtitle", "time": 7609.83, "timestamp": "02:06:49", "text": "リロードは？なんてこった。リロードボタンは？なんてこった。"}, {"type": "subtitle", "time": 7614.31, "timestamp": "02:06:54", "text": "リロードボタンは？R。"}, {"type": "subtitle", "time": 7618.149, "timestamp": "02:06:58", "text": "あ、Rじゃない。違う。"}]
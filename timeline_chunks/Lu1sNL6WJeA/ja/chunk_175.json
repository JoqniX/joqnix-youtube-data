[{"type": "subtitle", "time": 10501.91, "timestamp": "02:55:01", "text": "。 もうあちらに置いてあります。"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "大丈夫。 来て。 さあ行こう。 ネオンを使った"}, {"type": "subtitle", "time": 10506.07, "timestamp": "02:55:06", "text": "ゲームプレイ。 ええ、これは基本的にネオンを使った"}, {"type": "subtitle", "time": 10518.23, "timestamp": "02:55:18", "text": "大丈夫ですか？ うん。 うまくいけば。 あなたはもう"}, {"type": "subtitle", "time": 10521.19, "timestamp": "02:55:21", "text": "動かない。 待って、今引っ越すところなの。 私は"}, {"type": "subtitle", "time": 10524.389, "timestamp": "02:55:24", "text": "あなたの後ろにいました。 またこれか。 あなたは"}, {"type": "subtitle", "time": 10527.51, "timestamp": "02:55:27", "text": "死んだのですか？ はい。 私は今、死んだ。"}, {"type": "subtitle", "time": 10529.03, "timestamp": "02:55:29", "text": "あなたは身動きが取れなくなっていた。"}, {"type": "subtitle", "time": 10531.11, "timestamp": "02:55:31", "text": "何が起こっているのか分かりません。"}, {"type": "subtitle", "time": 10533.91, "timestamp": "02:55:33", "text": "何が起こっているのかわかりません。ああ"}, {"type": "subtitle", "time": 10536.63, "timestamp": "02:55:36", "text": "、ゲームがバグっています。"}, {"type": "subtitle", "time": 10539.67, "timestamp": "02:55:39", "text": "地図を再読み込みしているのかもしれません。 ええ、"}, {"type": "subtitle", "time": 10541.429, "timestamp": "02:55:41", "text": "新しいマップですね。 新しい"}, {"type": "subtitle", "time": 10543.67, "timestamp": "02:55:43", "text": "マップが読み込まれません。"}, {"type": "subtitle", "time": 10546.11, "timestamp": "02:55:46", "text": "こんにちは、ペッパー。 配信へようこ​​そ"}, {"type": "subtitle", "time": 10550.15, "timestamp": "02:55:50", "text": "。 おはよう。"}, {"type": "subtitle", "time": 10553.269, "timestamp": "02:55:53", "text": "おはよう。 いらっしゃいませ。"}, {"type": "subtitle", "time": 10559.51, "timestamp": "02:55:59", "text": "彼にとっては実際には夜だ。 ああ、あなたは今ここにいるようですね。"}]
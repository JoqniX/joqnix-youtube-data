[{"type": "subtitle", "time": 12782.309, "timestamp": "03:33:02", "text": "ジョンさん、ご参加いただきありがとうございます。 本日はありがとうございました。"}, {"type": "subtitle", "time": 12784.79, "timestamp": "03:33:04", "text": "本当に楽しかったです。   彼がそうしたいので、"}, {"type": "subtitle", "time": 12788.229, "timestamp": "03:33:08", "text": "招待します。"}, {"type": "subtitle", "time": 12792.389, "timestamp": "03:33:12", "text": "来週開催されるオープンコラボレーションに参加してみませんか？ まだ"}, {"type": "subtitle", "time": 12794.469, "timestamp": "03:33:14", "text": "確定していませんが、日時が決まり次第お知らせします"}, {"type": "subtitle", "time": 12796.95, "timestamp": "03:33:16", "text": "。"}, {"type": "subtitle", "time": 12799.269, "timestamp": "03:33:19", "text": "実際に投稿します。 私は"}, {"type": "subtitle", "time": 12801.99, "timestamp": "03:33:21", "text": "二つのことを考えました。 えっと、"}, {"type": "subtitle", "time": 12804.429, "timestamp": "03:33:24", "text": "特定のゲームで即興のコラボレーションをオープンにしようよ。例えば、"}, {"type": "subtitle", "time": 12806.87, "timestamp": "03:33:26", "text": "リポジトリを作ったり、友達とプレイしたりとか"}, {"type": "subtitle", "time": 12808.63, "timestamp": "03:33:28", "text": "。 人が出入りしたり、いろいろなことが起こる"}, {"type": "subtitle", "time": 12812.63, "timestamp": "03:33:32", "text": "。 ええ、もちろんです。 次に"}, {"type": "subtitle", "time": 12814.95, "timestamp": "03:33:34", "text": "やりたいことは、コラボレーションの修正、"}, {"type": "subtitle", "time": 12817.19, "timestamp": "03:33:37", "text": "つまりコラボレーションの大きな修正のようなものです。"}, {"type": "subtitle", "time": 12819.269, "timestamp": "03:33:39", "text": "巨大なものみたいだ。 よし。 うん、それでいいよ。"}, {"type": "subtitle", "time": 12821.59, "timestamp": "03:33:41", "text": "うん。  5人以上、といった感じ。 よし"}, {"type": "subtitle", "time": 12823.67, "timestamp": "03:33:43", "text": "。"}, {"type": "subtitle", "time": 12829.03, "timestamp": "03:33:49", "text": "お知らせいたします。 こんにちは。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 12831.67, "timestamp": "03:33:51", "text": "こんにちは。 ゲームをありがとうございました。さようなら。"}]
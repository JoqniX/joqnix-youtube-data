[{"type": "subtitle", "time": 3360.43, "timestamp": "00:56:00", "text": "望むものは何でもあげるよ。"}, {"type": "subtitle", "time": 3361.75, "timestamp": "00:56:01", "text": "[拍手]"}, {"type": "subtitle", "time": 3364.87, "timestamp": "00:56:04", "text": "ああ、なんてことだ。 本当に？"}, {"type": "subtitle", "time": 3376.87, "timestamp": "00:56:16", "text": "強力な武器か"}, {"type": "subtitle", "time": 3378.549, "timestamp": "00:56:18", "text": "何かが必要だ。"}, {"type": "subtitle", "time": 3380.87, "timestamp": "00:56:20", "text": "ええ、何もしていません。 ええと、"}, {"type": "subtitle", "time": 3384.789, "timestamp": "00:56:24", "text": "武器と呼べるものは何もありません。"}, {"type": "subtitle", "time": 3386.39, "timestamp": "00:56:26", "text": "在庫を確認してください。"}, {"type": "subtitle", "time": 3395.67, "timestamp": "00:56:35", "text": "彼らは私を殺そうとしている。"}, {"type": "subtitle", "time": 3397.589, "timestamp": "00:56:37", "text": "あのね？ いい考えがある。 離れてください"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "。 皆さん全員。 皆さん全員。 動く。"}, {"type": "subtitle", "time": 3401.829, "timestamp": "00:56:41", "text": "動く。 動く。 動く。 動く。"}, {"type": "subtitle", "time": 3411.109, "timestamp": "00:56:51", "text": "ああ、落ち込んでるんだね。 助けて。 君が"}, {"type": "subtitle", "time": 3418.87, "timestamp": "00:56:58", "text": "待って。 わかった。"}]
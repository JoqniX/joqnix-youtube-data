[{"type": "subtitle", "time": 8283.349, "timestamp": "02:18:03", "text": "そうです。もう一度言いますが、"}, {"type": "subtitle", "time": 8287.83, "timestamp": "02:18:07", "text": "細胞のパワーハウスです。ええと、"}, {"type": "subtitle", "time": 8291.1, "timestamp": "02:18:11", "text": "ミトコンドリアを倒すには協力する必要があります。"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "神様。今日は何回コラボしましたか"}, {"type": "subtitle", "time": 8302.629, "timestamp": "02:18:22", "text": "？この前にもコラボしましたか"}, {"type": "subtitle", "time": 8304.549, "timestamp": "02:18:24", "text": "？いいえ、いいえ、いいえ。あなたが最初です"}, {"type": "subtitle", "time": 8309.11, "timestamp": "02:18:29", "text": "。ああ、なるほど。なるほど。ええ。あなたは"}, {"type": "subtitle", "time": 8315.91, "timestamp": "02:18:35", "text": "？そう思います。ええ。何かが起こったら"}, {"type": "subtitle", "time": 8317.509, "timestamp": "02:18:37", "text": "、ストリーミングできるようになりますか"}, {"type": "subtitle", "time": 8320.309, "timestamp": "02:18:40", "text": "？よくわかりません"}, {"type": "subtitle", "time": 8322.95, "timestamp": "02:18:42", "text": "。でも、本当にそれを実現したいです"}, {"type": "subtitle", "time": 8324.95, "timestamp": "02:18:44", "text": "。"}, {"type": "subtitle", "time": 8327.349, "timestamp": "02:18:47", "text": "もちろん試してみてもいいですよ。"}, {"type": "subtitle", "time": 8330.469, "timestamp": "02:18:50", "text": "ラップトップなどを買わないといけないので。え"}, {"type": "subtitle", "time": 8332.87, "timestamp": "02:18:52", "text": "？ラップトップはもう持っていないのですか？いいえ。"}, {"type": "subtitle", "time": 8336.389, "timestamp": "02:18:56", "text": "いいえ。私はPCを使っています。いいえ。ラップトップは"}, {"type": "subtitle", "time": 8338.629, "timestamp": "02:18:58", "text": "どこで買わないといけないのですか"}]
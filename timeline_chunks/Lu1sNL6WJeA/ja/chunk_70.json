[{"type": "subtitle", "time": 4201.75, "timestamp": "01:10:01", "text": "いいえ、持っていません。いいえ、"}, {"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "今はそのゲームを持っていません。 実は、アンインストールしました。"}, {"type": "subtitle", "time": 4205.95, "timestamp": "01:10:05", "text": "それが"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "理由です。 ああ、大変だ。   そうすべきではありません"}, {"type": "subtitle", "time": 4211.51, "timestamp": "01:10:11", "text": "。 ああ、わかった。"}, {"type": "subtitle", "time": 4213.75, "timestamp": "01:10:13", "text": "ストリームにはインストールしません。"}, {"type": "subtitle", "time": 4217.83, "timestamp": "01:10:17", "text": "なぜ？ いいえ、少し時間がかかりますよ。"}, {"type": "subtitle", "time": 4219.99, "timestamp": "01:10:19", "text": "時間がかかりそうだね。"}, {"type": "subtitle", "time": 4226.149, "timestamp": "01:10:26", "text": "私が華々しくスタートすれば、"}, {"type": "subtitle", "time": 4228.43, "timestamp": "01:10:28", "text": "君たちはもうゲームを終えているだろう、ということだ。   ええ"}, {"type": "subtitle", "time": 4231.35, "timestamp": "01:10:31", "text": "、次回は"}, {"type": "subtitle", "time": 4233.189, "timestamp": "01:10:33", "text": "パスポートを持って行きます。 わかった。 わかった。 わかった。 わかった。"}, {"type": "subtitle", "time": 4235.11, "timestamp": "01:10:35", "text": "ジャック、ちょっと待ってくれ。 あなたは"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "入隊しましたか？"}, {"type": "subtitle", "time": 4238.91, "timestamp": "01:10:38", "text": "私は"}, {"type": "subtitle", "time": 4242.47, "timestamp": "01:10:42", "text": "入隊しています。 まさか今入隊したなんて言わないでくれよ。"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "ああ、"}, {"type": "subtitle", "time": 4245.83, "timestamp": "01:10:45", "text": "入隊していないなら、私たちにできることはあまりありません"}, {"type": "subtitle", "time": 4247.75, "timestamp": "01:10:47", "text": "。 しかし、あなたが入隊しているなら、入隊者モード"}, {"type": "subtitle", "time": 4250.47, "timestamp": "01:10:50", "text": "にゲームを切り替えるだけで済みます。 ええ、"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "入隊していますよ。 うん。"}, {"type": "subtitle", "time": 4256.59, "timestamp": "01:10:56", "text": "レオコ、入隊したの？   えーっと、"}]
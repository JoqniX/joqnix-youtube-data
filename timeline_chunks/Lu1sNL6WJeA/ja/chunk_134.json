[{"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "ショットでこいつを倒すのは難しいんだよ。ああ、シールドは"}, {"type": "subtitle", "time": 8073.709, "timestamp": "02:14:33", "text": "ここで私たちを足止めすると思う"}, {"type": "subtitle", "time": 8077.51, "timestamp": "02:14:37", "text": "。いや、気にしないで。みんな"}, {"type": "subtitle", "time": 8079.83, "timestamp": "02:14:39", "text": "スパイクの上にいる。1キル取れたら、"}, {"type": "subtitle", "time": 8083.51, "timestamp": "02:14:43", "text": "オールできる。よし。オールも持っている。"}, {"type": "subtitle", "time": 8085.47, "timestamp": "02:14:45", "text": "トップに行くよ。"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "今は温存しておこう。そして、もし3"}, {"type": "subtitle", "time": 8091.31, "timestamp": "02:14:51", "text": "対2になったら、オールすべきだと思う"}, {"type": "subtitle", "time": 8098.39, "timestamp": "02:14:58", "text": "賢い奴らなら、"}]
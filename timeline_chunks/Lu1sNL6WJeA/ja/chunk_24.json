[{"type": "subtitle", "time": 1442.23, "timestamp": "00:24:02", "text": "まずはあなた自身を癒すべきだと思います。"}, {"type": "subtitle", "time": 1445.11, "timestamp": "00:24:05", "text": "いや、必要ないよ。"}, {"type": "subtitle", "time": 1447.51, "timestamp": "00:24:07", "text": "目を休ませたいだけなんです。"}, {"type": "subtitle", "time": 1468.71, "timestamp": "00:24:28", "text": "、このゲーム大好きだよ。"}, {"type": "subtitle", "time": 1472.269, "timestamp": "00:24:32", "text": "このゲームが好きなんですね？ なんてこった。 何てことだ"}, {"type": "subtitle", "time": 1475.19, "timestamp": "00:24:35", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 1482.07, "timestamp": "00:24:42", "text": "入れよう。"}, {"type": "subtitle", "time": 1484.47, "timestamp": "00:24:44", "text": "そうそう。 こんにちは。 私たちの配信へようこ​​そ。"}, {"type": "subtitle", "time": 1487.029, "timestamp": "00:24:47", "text": "ハッピーバレンタインデー。 ねえ、"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "これ何？ あれは男の子です。   わからない"}, {"type": "subtitle", "time": 1491.35, "timestamp": "00:24:51", "text": "。 まるで"}]
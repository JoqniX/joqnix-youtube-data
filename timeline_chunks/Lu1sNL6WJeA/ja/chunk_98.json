[{"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "でも、あなたの言う通り、"}, {"type": "subtitle", "time": 5902.39, "timestamp": "01:38:22", "text": "復習する必要がある。実際、復習する時間がない。"}, {"type": "subtitle", "time": 5905.149, "timestamp": "01:38:25", "text": "それは"}, {"type": "subtitle", "time": 5908.189, "timestamp": "01:38:28", "text": "本当だ。 ところで、"}, {"type": "subtitle", "time": 5914.59, "timestamp": "01:38:34", "text": "War Thunderをプレイしますか？ あなたはWar Thunderをプレイしますか"}, {"type": "subtitle", "time": 5917.709, "timestamp": "01:38:37", "text": "？ あなたは"}, {"type": "subtitle", "time": 5924.95, "timestamp": "01:38:44", "text": "。 あなたはワタンダをプレイしますか？ あなたは"}, {"type": "subtitle", "time": 5927.629, "timestamp": "01:38:47", "text": "飛行機が好きですか？"}, {"type": "subtitle", "time": 5930.95, "timestamp": "01:38:50", "text": "ありがとうございます。 それ以来、私は"}, {"type": "subtitle", "time": 5937.82, "timestamp": "01:38:57", "text": "えっと"}, {"type": "subtitle", "time": 5939.39, "timestamp": "01:38:59", "text": "[音楽]"}]
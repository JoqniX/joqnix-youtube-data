[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "私は「しまった」とは思いません"}, {"type": "subtitle", "time": 3423.03, "timestamp": "00:57:03", "text": "。 私も熱があります。 わかった。   どうでも。"}, {"type": "subtitle", "time": 3429.99, "timestamp": "00:57:09", "text": "ああ、彼は死んだんだ。 手伝わせて、ジョー。   わーい"}, {"type": "subtitle", "time": 3431.67, "timestamp": "00:57:11", "text": "。"}, {"type": "subtitle", "time": 3435.19, "timestamp": "00:57:15", "text": "ありがとう、相棒。 さあ、二階へ上がってください。"}, {"type": "subtitle", "time": 3437.99, "timestamp": "00:57:17", "text": "ああ、誰かいる。"}, {"type": "subtitle", "time": 3440.95, "timestamp": "00:57:20", "text": "待って、それはサイドクエストだよ。"}, {"type": "subtitle", "time": 3443.349, "timestamp": "00:57:23", "text": "あ、待って。 やらなければならない。 いいえ、"}, {"type": "subtitle", "time": 3445.75, "timestamp": "00:57:25", "text": "必要ありません。ああ、わかりました。 それは選択肢の一つです。 どうでも。"}, {"type": "subtitle", "time": 3455.03, "timestamp": "00:57:35", "text": "うん。 さて、このクソ野郎を救おう。 釘打ち"}, {"type": "subtitle", "time": 3463.19, "timestamp": "00:57:43", "text": "私はこの村か何かの中に入ってみます"}, {"type": "subtitle", "time": 3466.39, "timestamp": "00:57:46", "text": "。 自動車修理工場。 うん。"}, {"type": "subtitle", "time": 3468.39, "timestamp": "00:57:48", "text": "それで、私はラグーンを見つけたんだ、ハーロ。"}, {"type": "subtitle", "time": 3470.23, "timestamp": "00:57:50", "text": "ここにはマリーナがあるんだけど、"}, {"type": "subtitle", "time": 3471.99, "timestamp": "00:57:51", "text": "感染者がたくさんいるんだ。"}, {"type": "subtitle", "time": 3474.15, "timestamp": "00:57:54", "text": "ボートを探す前に、まずは彼らと交渉しなければならない。 おい、やめろよ"}]
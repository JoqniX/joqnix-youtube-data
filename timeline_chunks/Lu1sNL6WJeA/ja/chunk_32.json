[{"type": "subtitle", "time": 1932.789, "timestamp": "00:32:12", "text": "私はなんてバカなんだろう。 何てことだ。 私たちはあちらへ行くことになっている"}, {"type": "subtitle", "time": 1935.43, "timestamp": "00:32:15", "text": "。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "ああ、大丈夫ですよ。 まるで俺たちが"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "そのクソみたいな状況を修復したかったみたいに。 うん。 ええ、"}, {"type": "subtitle", "time": 1943.35, "timestamp": "00:32:23", "text": "ナイフの修理は終わりました。 それは楽しいですね。 でも、あなたはそうした。 あ、"}, {"type": "subtitle", "time": 1945.509, "timestamp": "00:32:25", "text": "待って。 私はこれをいただきます。 じゃあ、そうします"}, {"type": "subtitle", "time": 1947.75, "timestamp": "00:32:27", "text": "。"}, {"type": "subtitle", "time": 1952.789, "timestamp": "00:32:32", "text": "何？ 何を取るのか？ 燃料タンク。"}, {"type": "subtitle", "time": 1955.029, "timestamp": "00:32:35", "text": "ところで、私たちはどこに行けばいいのでしょうか？ えっと、"}, {"type": "subtitle", "time": 1957.029, "timestamp": "00:32:37", "text": "マーカーの中にあります。 わかった。"}, {"type": "subtitle", "time": 1959.549, "timestamp": "00:32:39", "text": "反対側みたいですよね？"}, {"type": "subtitle", "time": 1965.07, "timestamp": "00:32:45", "text": "うん。 ああ、やばい。 ああ、なんてこった"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "。 ああ、ゾンビはまるで外骨格のよう、あるいは"}]
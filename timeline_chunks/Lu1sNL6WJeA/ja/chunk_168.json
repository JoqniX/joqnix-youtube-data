[{"type": "subtitle", "time": 10082.469, "timestamp": "02:48:02", "text": "。 ああ、神様。 我が神よ。 ここに来て。 どこにいるの"}, {"type": "subtitle", "time": 10086.79, "timestamp": "02:48:06", "text": "？ 私はトップだ。 ええ、同じ場所です。"}, {"type": "subtitle", "time": 10089.99, "timestamp": "02:48:09", "text": "ええ、下の方です。 こんにちは。 下に。 わかった。"}, {"type": "subtitle", "time": 10093.91, "timestamp": "02:48:13", "text": "あなたの後ろにいます。 私の友人の後ろに。 うん。 わかった。 わかった。"}, {"type": "subtitle", "time": 10095.91, "timestamp": "02:48:15", "text": "えっと、真ん中に行ってやろうか"}, {"type": "subtitle", "time": 10098.15, "timestamp": "02:48:18", "text": "？ うん。 はい。"}, {"type": "subtitle", "time": 10100.63, "timestamp": "02:48:20", "text": "橋の上ではきっと壮大な光景になるだろうね。 うん。 うん。"}, {"type": "subtitle", "time": 10102.15, "timestamp": "02:48:22", "text": "橋の反対側へ渡ってください。"}, {"type": "subtitle", "time": 10105.23, "timestamp": "02:48:25", "text": "大丈夫です。 わかった。 三つ。 よし。"}, {"type": "subtitle", "time": 10109.91, "timestamp": "02:48:29", "text": "３、２、１、１、ゴー。 行く。   わーい"}, {"type": "subtitle", "time": 10112.23, "timestamp": "02:48:32", "text": "。 さあ行こう。 わかった。 これで"}, {"type": "subtitle", "time": 10117.91, "timestamp": "02:48:37", "text": "リボルバーのみ。 拳銃は持って行かないで。"}, {"type": "subtitle", "time": 10119.83, "timestamp": "02:48:39", "text": "リボルバーのみ。 面白いこと知ってる"}, {"type": "subtitle", "time": 10122.23, "timestamp": "02:48:42", "text": "？ それはリボルバーですが、よく"}, {"type": "subtitle", "time": 10124.23, "timestamp": "02:48:44", "text": "見るとマガジンが付いています。 全く"}, {"type": "subtitle", "time": 10126.2, "timestamp": "02:48:46", "text": "意味が分からない。"}, {"type": "subtitle", "time": 10132.95, "timestamp": "02:48:52", "text": "【拍手】さあ、"}, {"type": "subtitle", "time": 10136.15, "timestamp": "02:48:56", "text": "行こう。 私はこのタイプの"}]
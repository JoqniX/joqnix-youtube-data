[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "。"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "そう、それは「"}, {"type": "subtitle", "time": 1686.549, "timestamp": "00:28:06", "text": "一瞬で殺さなくても大丈夫」みたいな感じじゃない"}, {"type": "subtitle", "time": 1689.35, "timestamp": "00:28:09", "text": "。 おお。 おお。 何てことだ。"}, {"type": "subtitle", "time": 1691.75, "timestamp": "00:28:11", "text": "ジョー、何してるの？"}, {"type": "subtitle", "time": 1695.389, "timestamp": "00:28:15", "text": "何？"}, {"type": "subtitle", "time": 1700.549, "timestamp": "00:28:20", "text": "ポイントを増やさせてください。 利用可能なアップグレード。 戦闘。"}, {"type": "subtitle", "time": 1711.16, "timestamp": "00:28:31", "text": "ああ、この人か。"}, {"type": "subtitle", "time": 1719.59, "timestamp": "00:28:39", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "もう少し性能の良い銃が必要だ。 ああ、神様。"}, {"type": "subtitle", "time": 1735.51, "timestamp": "00:28:55", "text": "彼の挨拶の仕方は、まるで誰かが"}, {"type": "subtitle", "time": 1737.75, "timestamp": "00:28:57", "text": "実際に"}]
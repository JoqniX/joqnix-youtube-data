[{"type": "subtitle", "time": 1380.07, "timestamp": "00:23:00", "text": "。"}, {"type": "subtitle", "time": 1383.75, "timestamp": "00:23:03", "text": "私は牛乳を買いたいのです。 ちょっと待ってください。"}, {"type": "subtitle", "time": 1386.63, "timestamp": "00:23:06", "text": "前庭に誰かいますか"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "。 よし、誰もいないぞ。"}, {"type": "subtitle", "time": 1403.11, "timestamp": "00:23:23", "text": "よし、念のためカメラをオンにしておこう"}, {"type": "subtitle", "time": 1406.31, "timestamp": "00:23:26", "text": "。 あ、待って。 あ、ちょっと待って。 待って。   なあ"}, {"type": "subtitle", "time": 1409.59, "timestamp": "00:23:29", "text": "、聞いてくれよ。   そうするべきでは"}, {"type": "subtitle", "time": 1429.149, "timestamp": "00:23:49", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 1432.549, "timestamp": "00:23:52", "text": "。 それで十分だったのか？"}, {"type": "subtitle", "time": 1436.07, "timestamp": "00:23:56", "text": "実際、それで十分すぎるくらいだと思います。"}, {"type": "subtitle", "time": 1439.11, "timestamp": "00:23:59", "text": "私の燃えるものはどこ？"}]
[{"type": "subtitle", "time": 4920.11, "timestamp": "01:22:00", "text": "。 ああ、"}, {"type": "subtitle", "time": 4922.669, "timestamp": "01:22:02", "text": "そうだね。 それは楽しみですね"}, {"type": "subtitle", "time": 4926.47, "timestamp": "01:22:06", "text": "。 最善を尽くします。 はい。 礼儀正しい。"}, {"type": "subtitle", "time": 4928.39, "timestamp": "01:22:08", "text": "うん、キスとかはちゃんともらえるよ"}, {"type": "subtitle", "time": 4931.27, "timestamp": "01:22:11", "text": "。 はい、チョコレートです。 あなたは"}, {"type": "subtitle", "time": 4934.31, "timestamp": "01:22:14", "text": "チョコレートを持っています。 ほら、わかるでしょ？ ああ、もしあなたが"}, {"type": "subtitle", "time": 4937.79, "timestamp": "01:22:17", "text": "タイピングしながらチャットしていたら、チョコレートがもらえますよ。"}, {"type": "subtitle", "time": 4941.51, "timestamp": "01:22:21", "text": "カ、君にはバレンタインカードが届くよ"}, {"type": "subtitle", "time": 4943.75, "timestamp": "01:22:23", "text": "。その中に僕が君にあげるものが入っているんだ。"}, {"type": "subtitle", "time": 4945.55, "timestamp": "01:22:25", "text": "チョコレートがあります。 チョコレートがあると仮定してください"}, {"type": "subtitle", "time": 4959.669, "timestamp": "01:22:39", "text": "ああ、心配しないでください。"}]
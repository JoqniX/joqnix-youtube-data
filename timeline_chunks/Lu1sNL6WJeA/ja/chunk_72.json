[{"type": "subtitle", "time": 4322.95, "timestamp": "01:12:02", "text": "ロコ、最後に何か一言ありますか？ 待って。   えっと"}, {"type": "subtitle", "time": 4325.149, "timestamp": "01:12:05", "text": "、私は何をしていたんだっけ？"}, {"type": "subtitle", "time": 4328.87, "timestamp": "01:12:08", "text": "忘れた。 私はコードを持っています。 コード。 うん。"}, {"type": "subtitle", "time": 4331.07, "timestamp": "01:12:11", "text": "そして、最後に"}, {"type": "subtitle", "time": 4339.51, "timestamp": "01:12:19", "text": "この配信をご覧いただきありがとうございました"}, {"type": "subtitle", "time": 4341.59, "timestamp": "01:12:21", "text": "。 ごめん。"}, {"type": "subtitle", "time": 4343.99, "timestamp": "01:12:23", "text": "皆さん、この配信をご覧いただきありがとうございました。 楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 4346.149, "timestamp": "01:12:26", "text": "それでも見続けたい場合は、"}, {"type": "subtitle", "time": 4350.59, "timestamp": "01:12:30", "text": "引き続き視聴できます。 ええ、そうですね、"}, {"type": "subtitle", "time": 4353.189, "timestamp": "01:12:33", "text": "この吸血鬼配信もそうです。"}, {"type": "subtitle", "time": 4356.63, "timestamp": "01:12:36", "text": "この歯医者さんは良い方です。 はい。"}, {"type": "subtitle", "time": 4359.27, "timestamp": "01:12:39", "text": "歯に何か問題があれば、"}, {"type": "subtitle", "time": 4363.189, "timestamp": "01:12:43", "text": "この人に診てもらいましょう。 うん。   つまり"}, {"type": "subtitle", "time": 4365.189, "timestamp": "01:12:45", "text": "彼は吸血鬼みたいなものだ。 つまり、彼は"}, {"type": "subtitle", "time": 4366.79, "timestamp": "01:12:46", "text": "千年以上も生きてきたということだ。   だから当然、"}, {"type": "subtitle", "time": 4368.229, "timestamp": "01:12:48", "text": "彼は誰よりもよく知っているのだ"}, {"type": "subtitle", "time": 4370.07, "timestamp": "01:12:50", "text": "。"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "はい。 配信にご参加いただきありがとうございます。"}, {"type": "subtitle", "time": 4374.07, "timestamp": "01:12:54", "text": "楽しんでいただけたなら幸いです。また"}]
[{"type": "subtitle", "time": 8880.95, "timestamp": "02:28:00", "text": "ベータ版が出ているよ。ベータ版が出ているんだ。"}, {"type": "subtitle", "time": 8883.83, "timestamp": "02:28:03", "text": "それをプレイできるよ。私はそれをずっと取っておいたんだ"}, {"type": "subtitle", "time": 8885.59, "timestamp": "02:28:05", "text": "。"}, {"type": "subtitle", "time": 8887.75, "timestamp": "02:28:07", "text": "ええと、実はオリジナル版が好きなんだ。"}, {"type": "subtitle", "time": 8890.469, "timestamp": "02:28:10", "text": "えっと、なんて言うんだっけ？ ハローみたいな"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "クエイクを思い出す。ハローだよね？ ハロー。"}, {"type": "subtitle", "time": 8896.309, "timestamp": "02:28:16", "text": "まさにその通り。楽しみにしていたんだ"}, {"type": "subtitle", "time": 8898.469, "timestamp": "02:28:18", "text": "。"}, {"type": "subtitle", "time": 8899.83, "timestamp": "02:28:19", "text": "なぜ最初のものを削除したのかわからない。"}, {"type": "subtitle", "time": 8902.07, "timestamp": "02:28:22", "text": "最初のものは問題なかったのに。"}, {"type": "subtitle", "time": 8905.75, "timestamp": "02:28:25", "text": "何が問題だったんだろう？"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "動きもすべて良かったのに。"}, {"type": "subtitle", "time": 8911.349, "timestamp": "02:28:31", "text": "うん、君は そう。その通り。Apexみたいな"}, {"type": "subtitle", "time": 8916.309, "timestamp": "02:28:36", "text": "Titanfall 2の瞬間を思い出すね。うん。まさに。"}, {"type": "subtitle", "time": 8918.15, "timestamp": "02:28:38", "text": "まさに。彼らはたくさんの"}, {"type": "subtitle", "time": 8920.389, "timestamp": "02:28:40", "text": "ゲームを組み合わせたんだと思う。Titanfallや"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "Haloみたいな似たようなゲームをたくさん組み合わせて、あの"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "ゲームの動きのメカニズムとかを作ったんだと思う"}, {"type": "subtitle", "time": 8929.27, "timestamp": "02:28:49", "text": "。Titanfall"}, {"type": "subtitle", "time": 8938.79, "timestamp": "02:28:58", "text": "2以来最高の動きだと彼らが言うのは大丈夫なのかな。そう言ってるよ"}]
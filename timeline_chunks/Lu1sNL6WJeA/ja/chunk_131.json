[{"type": "subtitle", "time": 7862.47, "timestamp": "02:11:02", "text": "。古風で丁寧な言葉だよね？"}, {"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "そう。"}, {"type": "subtitle", "time": 7866.79, "timestamp": "02:11:06", "text": "上司を「坊や」とか呼ぶような感じ"}, {"type": "subtitle", "time": 7869.03, "timestamp": "02:11:09", "text": "。"}, {"type": "subtitle", "time": 7870.87, "timestamp": "02:11:10", "text": "サマー。いやいやいや。様は、えーと、"}, {"type": "subtitle", "time": 7874.069, "timestamp": "02:11:14", "text": "お姫様みたいな人に使う言葉だよ。それは夜沈むような"}, {"type": "subtitle", "time": 7876.87, "timestamp": "02:11:16", "text": "エラーの種類。違う。わかった"}, {"type": "subtitle", "time": 7880.87, "timestamp": "02:11:20", "text": "。これもSLだよ。ボアソン。うん、"}, {"type": "subtitle", "time": 7883.75, "timestamp": "02:11:23", "text": "敬意を込めて、君と僕。オン。わかった、わかった"}, {"type": "subtitle", "time": 7891.51, "timestamp": "02:11:31", "text": "ああ、そうだった。忘れてた。"}, {"type": "subtitle", "time": 7893.99, "timestamp": "02:11:33", "text": "今日はゲームがすごく重い。うん、"}, {"type": "subtitle", "time": 7898.47, "timestamp": "02:11:38", "text": "日本には名誉効果がたくさんあるよね？うん。実際、"}, {"type": "subtitle", "time": 7901.43, "timestamp": "02:11:41", "text": "最近まで知らなかったものもあるんだ。ちょっと"}, {"type": "subtitle", "time": 7904.39, "timestamp": "02:11:44", "text": "変だよね。ああ、何を知ってたの？えーと、"}, {"type": "subtitle", "time": 7906.95, "timestamp": "02:11:46", "text": "最近何を学んだの？えーと、"}, {"type": "subtitle", "time": 7913.669, "timestamp": "02:11:53", "text": "何だったっけ？忘れちゃった。 ドノだと思う。"}, {"type": "subtitle", "time": 7919.31, "timestamp": "02:11:59", "text": "ああ、ドノ。うん、サーヴォみたいな感じだと思う。"}]
[{"type": "subtitle", "time": 12963.75, "timestamp": "03:36:03", "text": "えーと、もっと多くの人に参加してもらいたいと思うんです。"}, {"type": "subtitle", "time": 12967.11, "timestamp": "03:36:07", "text": "つまり、"}, {"type": "subtitle", "time": 12969.91, "timestamp": "03:36:09", "text": "ROM専の人もたくさんいると思うけど、もっと多くの"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "人に参加してもらいたいんです。"}, {"type": "subtitle", "time": 12975.75, "timestamp": "03:36:15", "text": "ジマコラボの時にもツイートして支払いもした"}, {"type": "subtitle", "time": 12978.63, "timestamp": "03:36:18", "text": "けど、今日は"}, {"type": "subtitle", "time": 12983.59, "timestamp": "03:36:23", "text": "多くの人にとって忙しい日だと思うので、ちょっと大変です。"}, {"type": "subtitle", "time": 12985.67, "timestamp": "03:36:25", "text": "川の流れはどうですか？ 君がクルド・クバン・"}, {"type": "subtitle", "time": 12992.469, "timestamp": "03:36:32", "text": "シミュレーターをプレイしているのを見たよ。 クバンシミュレーター。 あれは何でしょう？"}, {"type": "subtitle", "time": 12996.229, "timestamp": "03:36:36", "text": "ロシアンルーレットのことですか？ ノー・ア・"}, {"type": "subtitle", "time": 12999.99, "timestamp": "03:36:39", "text": "バックショット・ルーレット。 よし。 うん、"}, {"type": "subtitle", "time": 13004.349, "timestamp": "03:36:44", "text": "楽しかったよ。 こんにちは、Subsaさん。 調子はどうですか"}]
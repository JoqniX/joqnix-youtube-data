[{"type": "subtitle", "time": 6496.709, "timestamp": "01:48:16", "text": "インタビューして、"}, {"type": "subtitle", "time": 6498.55, "timestamp": "01:48:18", "text": "君が積極的に座ってた時に、"}, {"type": "chat", "time": 6503.029, "timestamp": "01:48:23", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i meant more like you know how people tend to stick together as immigrants "}, {"type": "subtitle", "time": 6504.79, "timestamp": "01:48:24", "text": "今は全部失ったって言ってくれ。だから、君の言う通りなんだ。"}, {"type": "subtitle", "time": 6506.55, "timestamp": "01:48:26", "text": "でも、実は"}, {"type": "subtitle", "time": 6508.709, "timestamp": "01:48:28", "text": "インタビューの準備はしてなかったんだ。知ってるよね"}, {"type": "subtitle", "time": 6512.229, "timestamp": "01:48:32", "text": "？誰も準備してなかった。"}, {"type": "subtitle", "time": 6514.91, "timestamp": "01:48:34", "text": "ほとんどハングイッシュじゃなかった"}, {"type": "subtitle", "time": 6517.75, "timestamp": "01:48:37", "text": "。 わかってるよ。でも、そうだけど、"}, {"type": "subtitle", "time": 6519.43, "timestamp": "01:48:39", "text": "もし"}, {"type": "subtitle", "time": 6521.109, "timestamp": "01:48:41", "text": "日本に行くなら、"}, {"type": "subtitle", "time": 6525.35, "timestamp": "01:48:45", "text": "同じ人、つまり自分の"}, {"type": "subtitle", "time": 6527.109, "timestamp": "01:48:47", "text": "州の人と一緒にいるのは嫌なんだ。そういう人たちとばかり一緒にいると居心地が良くなって、"}, {"type": "subtitle", "time": 6537.99, "timestamp": "01:48:57", "text": "外国人や日本人などと交流したり、入り込んだりしなくなるから。"}]
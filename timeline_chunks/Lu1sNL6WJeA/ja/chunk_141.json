[{"type": "subtitle", "time": 8464.309, "timestamp": "02:21:04", "text": "。君は 時間を無駄にするだけだよ"}, {"type": "subtitle", "time": 8477.51, "timestamp": "02:21:17", "text": "心配しないで。やってみて"}, {"type": "subtitle", "time": 8482.87, "timestamp": "02:21:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8485.23, "timestamp": "02:21:25", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8491.27, "timestamp": "02:21:31", "text": "アルティメットを無駄にすべきだった。うん。ああ、そうだね。うん。"}, {"type": "subtitle", "time": 8495.23, "timestamp": "02:21:35", "text": "時々あることだよ。"}, {"type": "subtitle", "time": 8498.71, "timestamp": "02:21:38", "text": "正直に言うと、もし"}, {"type": "subtitle", "time": 8503.67, "timestamp": "02:21:43", "text": "今スキンでプレイすることに慣れているなら、デフォルト"}, {"type": "subtitle", "time": 8506.71, "timestamp": "02:21:46", "text": "スキンでプレイするとすごくいい気分になる。すごく"}, {"type": "subtitle", "time": 8509.11, "timestamp": "02:21:49", "text": "いい気分になる。まさに。違う感じがする。"}, {"type": "subtitle", "time": 8512.07, "timestamp": "02:21:52", "text": "だからだよ。うん。違うのは、いつものスキン"}, {"type": "subtitle", "time": 8513.67, "timestamp": "02:21:53", "text": "に慣れてから"}, {"type": "subtitle", "time": 8515.75, "timestamp": "02:21:55", "text": "それを変えると、"}]
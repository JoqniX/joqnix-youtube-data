[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "実はサイファーをプレイしたいんだけど。うん、サイファーをプレイするよ。"}, {"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "それで、ジョックさん、今日はどうですか"}, {"type": "subtitle", "time": 7504.709, "timestamp": "02:05:04", "text": "？今日の調子はどうですか？"}, {"type": "subtitle", "time": 7508.55, "timestamp": "02:05:08", "text": "街の件があったからストレスが溜まってる。"}, {"type": "subtitle", "time": 7511.35, "timestamp": "02:05:11", "text": "ああ、なんてこと。でも、いい日になるはずだったのに"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "。うん、いい日になるはずだったのに。 そうだね。"}, {"type": "subtitle", "time": 7515.109, "timestamp": "02:05:15", "text": "うん。つまり、もうすぐ別の"}, {"type": "subtitle", "time": 7518.229, "timestamp": "02:05:18", "text": "コラボがあるんだよね？うん。韓国の"}, {"type": "subtitle", "time": 7520.95, "timestamp": "02:05:20", "text": "Vtuberコラボだよ。それで"}, {"type": "subtitle", "time": 7523.109, "timestamp": "02:05:23", "text": "日本語で話すんだ。"}, {"type": "subtitle", "time": 7525.39, "timestamp": "02:05:25", "text": "生き残れるといいんだけど。"}, {"type": "subtitle", "time": 7528.55, "timestamp": "02:05:28", "text": "日本語。ああ、もう。自分の"}, {"type": "subtitle", "time": 7530.31, "timestamp": "02:05:30", "text": "スキルを使わなきゃね。君も"}, {"type": "subtitle", "time": 7531.75, "timestamp": "02:05:31", "text": "私に教えてくれないと。日本語のやり方を教えてよ"}, {"type": "subtitle", "time": 7536.87, "timestamp": "02:05:36", "text": "、ジョー。うん。ああ、もう"}, {"type": "subtitle", "time": 7539.43, "timestamp": "02:05:39", "text": "。私が"}, {"type": "subtitle", "time": 7544.39, "timestamp": "02:05:44", "text": "人々にヒンディー語を教える配信をやりたいみたいなのが面白いと思う"}, {"type": "subtitle", "time": 7545.99, "timestamp": "02:05:45", "text": "。リロード中。ああ、そう。そう。"}, {"type": "subtitle", "time": 7550.87, "timestamp": "02:05:50", "text": "ぜひ教えて。私はヒンディー語が苦手なんだ。"}, {"type": "subtitle", "time": 7552.229, "timestamp": "02:05:52", "text": "教えてあげるけど、"}, {"type": "subtitle", "time": 7558.709, "timestamp": "02:05:58", "text": "冗談だよ。冗談だよ。"}]
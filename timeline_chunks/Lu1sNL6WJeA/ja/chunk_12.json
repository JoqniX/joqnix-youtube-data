[{"type": "subtitle", "time": 728.069, "timestamp": "00:12:08", "text": "。"}, {"type": "subtitle", "time": 731.03, "timestamp": "00:12:11", "text": "助けて。"}, {"type": "subtitle", "time": 734.629, "timestamp": "00:12:14", "text": "待って。 どこ？ ああ、これは、私たちが"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "保持する必要があるということですか。よし、それは私たちの側にあります。"}, {"type": "subtitle", "time": 741.67, "timestamp": "00:12:21", "text": "待て、奴らを"}, {"type": "subtitle", "time": 744.99, "timestamp": "00:12:24", "text": "殺せ。 全員殺せ。 全員殺せ。   わかった"}, {"type": "subtitle", "time": 761.47, "timestamp": "00:12:41", "text": "やあ、"}, {"type": "subtitle", "time": 764.31, "timestamp": "00:12:44", "text": "みんな。 アート。"}, {"type": "subtitle", "time": 768.4, "timestamp": "00:12:48", "text": "はい、参加します。 私はこちらの方法で参加します。"}, {"type": "subtitle", "time": 771.829, "timestamp": "00:12:51", "text": "[拍手]"}, {"type": "subtitle", "time": 775.99, "timestamp": "00:12:55", "text": "こんにちは。 ごめん。 私がこれを作ります。 私はこれを乗り越える"}, {"type": "subtitle", "time": 778.23, "timestamp": "00:12:58", "text": "。   規模が大きければ大きいほど良い"}]
[{"type": "subtitle", "time": 10035.67, "timestamp": "02:47:15", "text": "時々そうなるんです【拍手】 男らしく私と戦ってみろ。"}, {"type": "subtitle", "time": 10039.75, "timestamp": "02:47:19", "text": "男らしく戦え。 来て。"}, {"type": "subtitle", "time": 10041.349, "timestamp": "02:47:21", "text": "ええ、"}, {"type": "subtitle", "time": 10049.91, "timestamp": "02:47:29", "text": "ああ、神様。"}, {"type": "subtitle", "time": 10052.15, "timestamp": "02:47:32", "text": "私たちは戦えるだろうか？ ナイフのことは忘れて、"}, {"type": "subtitle", "time": 10053.67, "timestamp": "02:47:33", "text": "撃て。"}, {"type": "subtitle", "time": 10056.15, "timestamp": "02:47:36", "text": "ええ、もちろんです。"}, {"type": "subtitle", "time": 10059.75, "timestamp": "02:47:39", "text": "シュート。 ナイフを撃ちたいのか？"}, {"type": "subtitle", "time": 10062.15, "timestamp": "02:47:42", "text": "ナイフはどこだ？   わからない"}, {"type": "subtitle", "time": 10064.79, "timestamp": "02:47:44", "text": "。 それを見つけなければならない。"}, {"type": "subtitle", "time": 10066.87, "timestamp": "02:47:46", "text": "リボルバー。"}, {"type": "subtitle", "time": 10068.63, "timestamp": "02:47:48", "text": "それは教会の中にあった。"}, {"type": "subtitle", "time": 10071.15, "timestamp": "02:47:51", "text": "あ、こっちだよ"}, {"type": "subtitle", "time": 10076.469, "timestamp": "02:47:56", "text": "。 いいえ、ここが私の出身地です。 ああ"}, {"type": "subtitle", "time": 10078.309, "timestamp": "02:47:58", "text": "、ここは発射速度が本当に速いですね"}]
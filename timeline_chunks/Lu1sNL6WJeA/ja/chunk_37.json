[{"type": "subtitle", "time": 2224.55, "timestamp": "00:37:04", "text": "ああ、くそ。 ああ、わかりました。"}, {"type": "subtitle", "time": 2226.55, "timestamp": "00:37:06", "text": "ここには電流が流れている。"}, {"type": "subtitle", "time": 2229.589, "timestamp": "00:37:09", "text": "どうやって物を落とすのですか？ ああ、あなたは"}, {"type": "subtitle", "time": 2235.75, "timestamp": "00:37:15", "text": "修理にお金を使ったんですね。 くそ。 そんな"}, {"type": "subtitle", "time": 2239.51, "timestamp": "00:37:19", "text": "投げ方しなくてもよかったのに。   だから"}, {"type": "subtitle", "time": 2241.67, "timestamp": "00:37:21", "text": "、俺はただ缶を蹴ってるだけさ。   ご"}, {"type": "subtitle", "time": 2244.79, "timestamp": "00:37:24", "text": "心配なく。"}, {"type": "subtitle", "time": 2247.75, "timestamp": "00:37:27", "text": "ああ、くそ。 これは何ですか？"}, {"type": "subtitle", "time": 2250.31, "timestamp": "00:37:30", "text": "これが何なのか全く分かりません。 待って、どうやって"}, {"type": "subtitle", "time": 2253.99, "timestamp": "00:37:33", "text": "そこに行ったの？ よくわからない。 何てことだ"}, {"type": "subtitle", "time": 2256.55, "timestamp": "00:37:36", "text": "。 ええ、それは電流です。"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "私が言ったのはそういうことです。 ああ、それは"}, {"type": "subtitle", "time": 2260.87, "timestamp": "00:37:40", "text": "興味深いですね。"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "面白いでしょう？"}, {"type": "subtitle", "time": 2267.67, "timestamp": "00:37:47", "text": "刺してもいいですか？ うんうん。 もちろん。 どうぞ。"}, {"type": "subtitle", "time": 2269.67, "timestamp": "00:37:49", "text": "どうぞご自由に。"}, {"type": "subtitle", "time": 2273.99, "timestamp": "00:37:53", "text": "了解、了解。 私はもう死にません。 ニース。"}, {"type": "subtitle", "time": 2276.47, "timestamp": "00:37:56", "text": "待って、今すぐ戻らないといけないの？   わからない"}, {"type": "subtitle", "time": 2277.99, "timestamp": "00:37:57", "text": "。 私たちは何をすればいいのですか"}]
[{"type": "subtitle", "time": 8662.309, "timestamp": "02:24:22", "text": "ああ、なんてこった。彼がこれを元に戻したら、"}, {"type": "subtitle", "time": 8663.91, "timestamp": "02:24:23", "text": "クラッチすると想像してみて。彼が"}, {"type": "subtitle", "time": 8668.429, "timestamp": "02:24:28", "text": "クラッチしたら勝たなきゃいけない。気にしないで。攻撃側が勝つ。オーケー。GG。GG"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "。ああ、なんてこった。君は"}, {"type": "subtitle", "time": 8674.95, "timestamp": "02:24:34", "text": "それを知ってるよ。うん。うん。じゃあ、そうしよう。"}, {"type": "subtitle", "time": 8677.11, "timestamp": "02:24:37", "text": "うん。行こう。行こう。このゲームは"}, {"type": "subtitle", "time": 8679.75, "timestamp": "02:24:39", "text": "ラグってるから、もう楽しくない。"}, {"type": "subtitle", "time": 8685.19, "timestamp": "02:24:45", "text": "うん。わかった。開けてみよう ストラスハット。"}]
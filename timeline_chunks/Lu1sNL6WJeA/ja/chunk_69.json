[{"type": "subtitle", "time": 4142.47, "timestamp": "01:09:02", "text": "インストールしました。   くそっ"}, {"type": "subtitle", "time": 4145.59, "timestamp": "01:09:05", "text": "、ジャック。"}, {"type": "subtitle", "time": 4148.55, "timestamp": "01:09:08", "text": "なぜ？ なぜ"}, {"type": "subtitle", "time": 4151.91, "timestamp": "01:09:11", "text": "このゲームを入れるスペースがなかったのか。 わかった。 スペースがなかった。"}, {"type": "subtitle", "time": 4156.47, "timestamp": "01:09:16", "text": "8ギガを収納するスペースがなかった。 本当に？"}, {"type": "subtitle", "time": 4158.55, "timestamp": "01:09:18", "text": "なぜ？ 私もこれを持っていた。 この"}, {"type": "subtitle", "time": 4163.669, "timestamp": "01:09:23", "text": "男はテレビを2台くらい持っていると思う。 いいえ、テレビは1台だけです。"}, {"type": "subtitle", "time": 4168.269, "timestamp": "01:09:28", "text": "ああ、大丈夫ですよ。 半分くらい入っている。 だから、それで"}, {"type": "subtitle", "time": 4177.349, "timestamp": "01:09:37", "text": "いいんです。 君たちはそれを楽しんでいるんだね。"}, {"type": "subtitle", "time": 4180.39, "timestamp": "01:09:40", "text": "何？  「楽しむ」とはどういう意味ですか？ ジャック・"}, {"type": "subtitle", "time": 4182.63, "timestamp": "01:09:42", "text": "ミックス氏。"}, {"type": "subtitle", "time": 4185.829, "timestamp": "01:09:45", "text": "幽霊のエンディング。 なぜあなたはこのような"}, {"type": "subtitle", "time": 4188.709, "timestamp": "01:09:48", "text": "幽霊ゲームをやっているのですか？  10月はもう終わったわけではない。"}, {"type": "subtitle", "time": 4191.189, "timestamp": "01:09:51", "text": "いいえ、まだよく分かりません。 ハロウィンは"}, {"type": "subtitle", "time": 4193.349, "timestamp": "01:09:53", "text": "終わった。 なぜあなたは今でもホラー"}, {"type": "subtitle", "time": 4195.59, "timestamp": "01:09:55", "text": "ゲームをプレイするのですか？ 今、私はジョックが"}, {"type": "subtitle", "time": 4198.55, "timestamp": "01:09:58", "text": "ゲームを掌握しているのに、それをプレイしていないような気がする。"}]
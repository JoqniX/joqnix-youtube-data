[{"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "ドラゴンはどこかへ向かっている。 痛い。 私はここにいますよ"}, {"type": "subtitle", "time": 3013.03, "timestamp": "00:50:13", "text": "。 これが道だ。   「"}, {"type": "subtitle", "time": 3015.91, "timestamp": "00:50:15", "text": "ああ、まさに"}, {"type": "subtitle", "time": 3018.589, "timestamp": "00:50:18", "text": "川を渡っているところだよ」って感じだった。 おっと、"}, {"type": "subtitle", "time": 3021.91, "timestamp": "00:50:21", "text": "衝撃があった。 はぁ？ え、何？ うん。"}, {"type": "subtitle", "time": 3023.95, "timestamp": "00:50:23", "text": "彼を釘打ち銃で撃ち殺すとか、"}, {"type": "subtitle", "time": 3026.39, "timestamp": "00:50:26", "text": "何かできないかな？ ありがとう。"}, {"type": "subtitle", "time": 3027.829, "timestamp": "00:50:27", "text": "ああ、彼を焼き尽くしてやる。 体が燃えるように熱い。"}, {"type": "subtitle", "time": 3057.15, "timestamp": "00:50:57", "text": "くそ、あの男を見てみろよ。"}, {"type": "subtitle", "time": 3059.27, "timestamp": "00:50:59", "text": "[拍手]"}]
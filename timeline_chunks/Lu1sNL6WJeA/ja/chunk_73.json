[{"type": "subtitle", "time": 4390.63, "timestamp": "01:13:10", "text": "こんにちは。 わかった。 待って。 私にやらせてください。   というわけで"}, {"type": "subtitle", "time": 4392.55, "timestamp": "01:13:12", "text": "、皆さん、"}, {"type": "subtitle", "time": 4394.35, "timestamp": "01:13:14", "text": "今日は来てくださってありがとうございました。   ここまで"}, {"type": "subtitle", "time": 4397.99, "timestamp": "01:13:17", "text": "お越しいただき、ありがとうございました。 ええ、残念ながら"}, {"type": "subtitle", "time": 4403.75, "timestamp": "01:13:23", "text": "ゲームをアンインストールしました。 ええ、"}, {"type": "subtitle", "time": 4406.43, "timestamp": "01:13:26", "text": "このストリームは特に、特に、特に、"}, {"type": "subtitle", "time": 4413.27, "timestamp": "01:13:33", "text": "えーと、これを何と呼ぶんですか？ えっと、あの"}, {"type": "subtitle", "time": 4414.87, "timestamp": "01:13:34", "text": "島みたいなやつですよね"}, {"type": "subtitle", "time": 4419.03, "timestamp": "01:13:39", "text": "？ そう、そう、そう、そう、うん、"}, {"type": "subtitle", "time": 4422.189, "timestamp": "01:13:42", "text": "大丈夫だよ。 その島は楽しかった。 動作が"}, {"type": "subtitle", "time": 4426.229, "timestamp": "01:13:46", "text": "遅くて少し面倒だったけど、それでも"}, {"type": "subtitle", "time": 4429.99, "timestamp": "01:13:49", "text": "楽しいゲームだった。 時々プレイする自分の姿が想像できる"}, {"type": "subtitle", "time": 4433.83, "timestamp": "01:13:53", "text": "。 ええ、そうですね。 うん。 だから、二人がそれぞれ"}, {"type": "subtitle", "time": 4439.229, "timestamp": "01:13:59", "text": "自分のことをしている間に、私たちはエンディングのシーンを撮ることにしよう。 この後、"}]
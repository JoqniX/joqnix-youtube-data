[{"type": "subtitle", "time": 10623.11, "timestamp": "02:57:03", "text": "二丁拳銃を取り出して、私と戦え。"}, {"type": "subtitle", "time": 10627.51, "timestamp": "02:57:07", "text": "おお。 あ、ありがとう。 ニース。"}, {"type": "subtitle", "time": 10631.11, "timestamp": "02:57:11", "text": "私たちはショットガンを持っていた。 何てことだ。 ああ、これは"}, {"type": "subtitle", "time": 10650.269, "timestamp": "02:57:30", "text": "。 やめて"}, {"type": "subtitle", "time": 10654.67, "timestamp": "02:57:34", "text": "。 君の方向に手榴弾を投げつけてみよう"}, {"type": "subtitle", "time": 10657.79, "timestamp": "02:57:37", "text": "。 これは実際にはヒットしないと思う"}, {"type": "subtitle", "time": 10660.79, "timestamp": "02:57:40", "text": "。 くそ。"}, {"type": "subtitle", "time": 10664.15, "timestamp": "02:57:44", "text": "これを解決する方法を、私は知っています。"}, {"type": "subtitle", "time": 10675.389, "timestamp": "02:57:55", "text": "死んだ。 ああ、"}, {"type": "subtitle", "time": 10677.59, "timestamp": "02:57:57", "text": "神様。"}]
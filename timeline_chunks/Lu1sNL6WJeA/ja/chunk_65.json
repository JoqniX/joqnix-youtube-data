[{"type": "subtitle", "time": 3900.95, "timestamp": "01:05:00", "text": "ああ、ああ、私はこの武器を持っています。 じゃあ、"}, {"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "私は一体何をやっているんだ？ わかりました、"}, {"type": "subtitle", "time": 3906.95, "timestamp": "01:05:06", "text": "これを装備します。"}, {"type": "subtitle", "time": 3910.309, "timestamp": "01:05:10", "text": "武器を作れるんだね？"}, {"type": "subtitle", "time": 3913.349, "timestamp": "01:05:13", "text": "いや、いや、いや、いや、いや、いや、いや。 私は、"}, {"type": "subtitle", "time": 3916.39, "timestamp": "01:05:16", "text": "レベル2のロックが必要な武器のようなものを持っていました"}, {"type": "subtitle", "time": 3919.51, "timestamp": "01:05:19", "text": "。私たちはスキルを目撃します。 うん。 えっと、"}, {"type": "subtitle", "time": 3921.67, "timestamp": "01:05:21", "text": "スキルポイントをやらせてください。 私はそんなことは全くしていません"}, {"type": "subtitle", "time": 3923.75, "timestamp": "01:05:23", "text": "。"}, {"type": "subtitle", "time": 3927.43, "timestamp": "01:05:27", "text": "サメはスキルポイントを全く持っていなかったのに、"}, {"type": "subtitle", "time": 3930.63, "timestamp": "01:05:30", "text": "私たちよりもゾンビをうまく倒した。 何？ ちくしょう。   ある意味本当だ"}, {"type": "subtitle", "time": 3945.549, "timestamp": "01:05:45", "text": "待ち方。 ちょっと"}, {"type": "subtitle", "time": 3949.789, "timestamp": "01:05:49", "text": "待って、"}, {"type": "subtitle", "time": 3953.43, "timestamp": "01:05:53", "text": "スキルアップグレードは利用可能だったっけ？ 五。 ああ、"}, {"type": "subtitle", "time": 3956.109, "timestamp": "01:05:56", "text": "黒いやつですね。 わかった。"}]
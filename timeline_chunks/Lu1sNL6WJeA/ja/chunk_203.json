[{"type": "subtitle", "time": 12185.03, "timestamp": "03:23:05", "text": "。 何てことだ。 私はナイフを何本持っていますか"}, {"type": "subtitle", "time": 12186.95, "timestamp": "03:23:06", "text": "？ ああ、ほら、君が持ってるあの"}, {"type": "subtitle", "time": 12189.349, "timestamp": "03:23:09", "text": "黒いチューブみたいなやつ。"}, {"type": "subtitle", "time": 12191.349, "timestamp": "03:23:11", "text": "そう、それは"}, {"type": "subtitle", "time": 12200.87, "timestamp": "03:23:20", "text": "。 ブランク２つ、ライフ３つ。 よし。"}, {"type": "subtitle", "time": 12203.19, "timestamp": "03:23:23", "text": "ブランク２つ、ライフ３つ。   たくさんの"}, {"type": "subtitle", "time": 12205.67, "timestamp": "03:23:25", "text": "商品。 現在のシェルの極性を反転させる"}, {"type": "subtitle", "time": 12208.269, "timestamp": "03:23:28", "text": "。"}, {"type": "subtitle", "time": 12216.63, "timestamp": "03:23:36", "text": "えっと、あれは何？"}, {"type": "subtitle", "time": 12220.309, "timestamp": "03:23:40", "text": "コーラのボトルとか持ってるでしょ？"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "今は自分の持ち物を見ることができないので、"}, {"type": "subtitle", "time": 12224.01, "timestamp": "03:23:44", "text": "お答えできません。"}, {"type": "subtitle", "time": 12227.03, "timestamp": "03:23:47", "text": "【音楽】"}, {"type": "subtitle", "time": 12229.51, "timestamp": "03:23:49", "text": "私自身もわからない。 ああ、"}, {"type": "subtitle", "time": 12233.03, "timestamp": "03:23:53", "text": "ビールのことですか？ ああ、そうだった。 ビール。 それは、何でも"}]
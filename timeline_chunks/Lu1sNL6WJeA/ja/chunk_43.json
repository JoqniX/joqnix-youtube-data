[{"type": "subtitle", "time": 2584.47, "timestamp": "00:43:04", "text": "乗り物とか"}, {"type": "subtitle", "time": 2586.109, "timestamp": "00:43:06", "text": "そういうのをもらえるとは思わないで。 わからない"}, {"type": "subtitle", "time": 2589.67, "timestamp": "00:43:09", "text": "。 車両が必要だ。 うん。"}, {"type": "subtitle", "time": 2591.829, "timestamp": "00:43:11", "text": "信じられない。 私たちは日記を見つけた。 橋"}, {"type": "subtitle", "time": 2593.75, "timestamp": "00:43:13", "text": "や道路を封鎖し、民間人の移動を阻止する"}, {"type": "subtitle", "time": 2596.069, "timestamp": "00:43:16", "text": "。"}, {"type": "subtitle", "time": 2597.75, "timestamp": "00:43:17", "text": "彼らは、焼夷弾攻撃から逃れた多くの村人を殺すよう我々に命じている"}, {"type": "subtitle", "time": 2602.43, "timestamp": "00:43:22", "text": "。 感染者だけでなく、すべての"}, {"type": "subtitle", "time": 2613.19, "timestamp": "00:43:33", "text": "なぜ私は燃料缶を持ち歩いているのか？"}, {"type": "subtitle", "time": 2615.91, "timestamp": "00:43:35", "text": "うん。 ええ、任務には必要です。"}, {"type": "subtitle", "time": 2619.589, "timestamp": "00:43:39", "text": "赤いX印のところまで行ってください。 赤いバツ"}, {"type": "subtitle", "time": 2622.069, "timestamp": "00:43:42", "text": "印は"}, {"type": "subtitle", "time": 2625.589, "timestamp": "00:43:45", "text": "赤い愛撫で描かれている。"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "私の部下たち。  300メートルくらい行かないといけないんだよ。"}, {"type": "subtitle", "time": 2632.23, "timestamp": "00:43:52", "text": "はい。 ちょっと待ってくれよ。"}, {"type": "subtitle", "time": 2635.43, "timestamp": "00:43:55", "text": "ああ、銃があるみたいだ。 私は"}, {"type": "subtitle", "time": 2639.19, "timestamp": "00:43:59", "text": "大型のキットです。 わかった、俺は本物の"}]
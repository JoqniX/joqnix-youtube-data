[{"type": "subtitle", "time": 2823.829, "timestamp": "00:47:03", "text": "バグだらけだ。 このゲームはバグが多い。 正直言って、ただただ圧倒的な"}, {"type": "subtitle", "time": 2833.39, "timestamp": "00:47:13", "text": "やまと。 こんにちは。 私は蹴って行くことができます"}, {"type": "subtitle", "time": 2836.109, "timestamp": "00:47:16", "text": "。 何てことだ"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "いじめっ子。 聖なる。 私は死んだ。 なんてこった。 ああ、彼は"}, {"type": "subtitle", "time": 2852.19, "timestamp": "00:47:32", "text": "マチェットを持っている。 ああ、それが必要だ。 ああ、ありがとうございます"}, {"type": "subtitle", "time": 2855.67, "timestamp": "00:47:35", "text": "。 我々は彼を殺す。 おお。"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "おい、なんで"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "バッグだ。 ヨーコ、何してるの？ 大丈夫？   そうそう"}, {"type": "subtitle", "time": 2872.309, "timestamp": "00:47:52", "text": "よし、新しい銃を手に入れた。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "ニース。"}, {"type": "subtitle", "time": 2876.47, "timestamp": "00:47:56", "text": "銃ではない。 新しい銃。 いや、いや、いや。"}, {"type": "subtitle", "time": 2878.87, "timestamp": "00:47:58", "text": "マチェットのことです。"}]
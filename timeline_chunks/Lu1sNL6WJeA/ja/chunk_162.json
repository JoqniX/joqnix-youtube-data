[{"type": "subtitle", "time": 9724.15, "timestamp": "02:42:04", "text": "ああ、待って。 それは君じゃない。 ああ、何を見てるの"}, {"type": "subtitle", "time": 9725.59, "timestamp": "02:42:05", "text": "？ 何を見てるの？"}, {"type": "subtitle", "time": 9728.389, "timestamp": "02:42:08", "text": "あそこの青いものを見てたんだ。"}, {"type": "subtitle", "time": 9731.11, "timestamp": "02:42:11", "text": "「待って、あれは君だよね？」って思ったんだ。"}, {"type": "subtitle", "time": 9738.03, "timestamp": "02:42:18", "text": "おお、いいね。"}, {"type": "subtitle", "time": 9753.23, "timestamp": "02:42:33", "text": "ああ、お互いに殺し合ったんだ。 わあ。 ああ、"}, {"type": "subtitle", "time": 9755.349, "timestamp": "02:42:35", "text": "神様。 2キル先取だと思う。 だからだよ"}, {"type": "subtitle", "time": 9762.71, "timestamp": "02:42:42", "text": "ああ、グレネードを早く使いすぎた。 ああ、"}, {"type": "subtitle", "time": 9764.79, "timestamp": "02:42:44", "text": "待って。自分のグレネードで死んだんだ。 こんにちは。"}, {"type": "subtitle", "time": 9774.59, "timestamp": "02:42:54", "text": "。 実はこいつはすぐにキレるんだ"}, {"type": "subtitle", "time": 9778.11, "timestamp": "02:42:58", "text": "。 なんてこった。 あなたは私を殴った"}]
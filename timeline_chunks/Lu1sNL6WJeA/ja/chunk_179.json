[{"type": "subtitle", "time": 10762.63, "timestamp": "02:59:22", "text": "こんにちは。"}, {"type": "subtitle", "time": 10764.389, "timestamp": "02:59:24", "text": "どこにいるの？ こんにちは、ジョン。 わからない"}, {"type": "subtitle", "time": 10768.87, "timestamp": "02:59:28", "text": "。 ええ、どこにいるんですか？"}, {"type": "subtitle", "time": 10771.429, "timestamp": "02:59:31", "text": "あなたを探しているんです。"}, {"type": "subtitle", "time": 10773.03, "timestamp": "02:59:33", "text": "ええ、わかっています。 私もあなたを探しています。"}, {"type": "subtitle", "time": 10774.95, "timestamp": "02:59:34", "text": "どこにいるの？"}, {"type": "subtitle", "time": 10779.59, "timestamp": "02:59:39", "text": "私はここにいます。 私にとっては面白い。"}, {"type": "subtitle", "time": 10786.51, "timestamp": "02:59:46", "text": "ジャック、君はどこにいるの？ いずれあなたは私のところに来るでしょう。"}, {"type": "subtitle", "time": 10791.269, "timestamp": "02:59:51", "text": "いいえ、私はとても忍耐強い人間です。"}, {"type": "subtitle", "time": 10794.07, "timestamp": "02:59:54", "text": "いずれあなたは来るでしょう。"}, {"type": "subtitle", "time": 10796.95, "timestamp": "02:59:56", "text": "いいえ、それは違います。   私は少し"}]
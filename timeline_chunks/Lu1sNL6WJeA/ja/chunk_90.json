[{"type": "subtitle", "time": 5403.39, "timestamp": "01:30:03", "text": "背景を少し暗くしたらどうでしょうか"}, {"type": "subtitle", "time": 5405.95, "timestamp": "01:30:05", "text": "？ 私の声は"}, {"type": "subtitle", "time": 5407.87, "timestamp": "01:30:07", "text": "聞こえますか？ わからない"}, {"type": "subtitle", "time": 5420.31, "timestamp": "01:30:20", "text": "聞こえていますか？ 聞こえますか？ いいかい、"}, {"type": "subtitle", "time": 5436.79, "timestamp": "01:30:36", "text": "ASMRをやります。なぜなら、"}, {"type": "subtitle", "time": 5447.35, "timestamp": "01:30:47", "text": "苦手です。 だから、無関心な人たち。 わかった。"}, {"type": "subtitle", "time": 5451.27, "timestamp": "01:30:51", "text": "自分の声は聞こえないのですが、"}, {"type": "subtitle", "time": 5455.59, "timestamp": "01:30:55", "text": "モニタリングして"}]
[{"type": "subtitle", "time": 5821.27, "timestamp": "01:37:01", "text": "午後5時 いいえ。ええと、午後5時30分です。 えーと、午後"}, {"type": "subtitle", "time": 5824.629, "timestamp": "01:37:04", "text": "9時ですね。  JST。 うん。"}, {"type": "subtitle", "time": 5826.629, "timestamp": "01:37:06", "text": "彼らとはコミュニケーションすら取れない。 どういう意味ですか？"}, {"type": "subtitle", "time": 5831.35, "timestamp": "01:37:11", "text": "大丈夫。 ほら、ほら、ほら。 今のところ、私の"}, {"type": "subtitle", "time": 5833.87, "timestamp": "01:37:13", "text": "日本語はジョーではありません"}, {"type": "subtitle", "time": 5846.87, "timestamp": "01:37:26", "text": "。 時が経てば、そうなるだろう。 問題は、"}, {"type": "subtitle", "time": 5851.95, "timestamp": "01:37:31", "text": "今回コラボしている日本のユーチューバー全員の日本語が下手なのは"}, {"type": "subtitle", "time": 5855.59, "timestamp": "01:37:35", "text": "当然で、私の"}, {"type": "subtitle", "time": 5859.79, "timestamp": "01:37:39", "text": "日本語も下手になるだろう"}, {"type": "subtitle", "time": 5867.629, "timestamp": "01:37:47", "text": "運が良かったから合格できた。でも、まだ"}, {"type": "subtitle", "time": 5878.07, "timestamp": "01:37:58", "text": "日本語の勉強に集中している間は大丈夫。そこから先は大丈夫。"}]
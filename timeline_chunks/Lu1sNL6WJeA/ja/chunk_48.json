[{"type": "subtitle", "time": 2883.349, "timestamp": "00:48:03", "text": "新たな武器。 うん。"}, {"type": "subtitle", "time": 2886.55, "timestamp": "00:48:06", "text": "盲目的な武器は、一人を殺す。 これは何ですか？"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "あなたは何者ですか？ あなたは何者ですか？ 何てことだ。"}, {"type": "subtitle", "time": 2892.29, "timestamp": "00:48:12", "text": "あなたは何者ですか？ あなたは何者ですか？"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "釘打ち銃の件は分かります。"}, {"type": "subtitle", "time": 2900.71, "timestamp": "00:48:20", "text": "【音楽】"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "ありとあらゆる火力を駆使するだけです。 うん。 わかった。   ああ"}, {"type": "subtitle", "time": 2912.03, "timestamp": "00:48:32", "text": "、これは本当に面白い。"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "あれ、缶落としちゃった？ ああ、本当にそうだった"}, {"type": "subtitle", "time": 2917.51, "timestamp": "00:48:37", "text": "。"}, {"type": "subtitle", "time": 2921.39, "timestamp": "00:48:41", "text": "私たちはそれをやらなければならないのではないですか？ 私たちはしなければならない。"}, {"type": "subtitle", "time": 2923.91, "timestamp": "00:48:43", "text": "うん、大丈夫だよ。 君たちのおかげで道が開けたよ"}, {"type": "subtitle", "time": 2926.95, "timestamp": "00:48:46", "text": "。  200メートルです。 大丈夫。 私たちは"}, {"type": "subtitle", "time": 2936.23, "timestamp": "00:48:56", "text": "まっすぐ。 近くに車か何かがあるみたいだ"}, {"type": "subtitle", "time": 2939.51, "timestamp": "00:48:59", "text": "。   まるでそれがもうすぐやってくるかのように"}]
[{"type": "subtitle", "time": 2102.19, "timestamp": "00:35:02", "text": "。"}, {"type": "subtitle", "time": 2105.03, "timestamp": "00:35:05", "text": "ニース。 何が起こっていますか？ 皆さん、"}, {"type": "subtitle", "time": 2108.63, "timestamp": "00:35:08", "text": "大丈夫ですか？ 今は大丈夫じゃない。 確かにそうですね"}, {"type": "subtitle", "time": 2126.23, "timestamp": "00:35:26", "text": "このチンピラを殺す必要があると思う。"}, {"type": "subtitle", "time": 2137.03, "timestamp": "00:35:37", "text": "うわぁ。 彼はただ彼に向かって叫んでいるだけだ。"}, {"type": "subtitle", "time": 2139.27, "timestamp": "00:35:39", "text": "実際、遅すぎるんです。"}, {"type": "subtitle", "time": 2142.63, "timestamp": "00:35:42", "text": "彼はきっと、とかそういう感じだと思う。 見てみましょう。 まあ、"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "実際には大した問題ではない。 ああ、やばい、俺は"}, {"type": "subtitle", "time": 2151.829, "timestamp": "00:35:51", "text": "しかし、彼は死にかけているわけではない。 あ、待って。"}, {"type": "subtitle", "time": 2158.03, "timestamp": "00:35:58", "text": "くそ。 彼は"}]
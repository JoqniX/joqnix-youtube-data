[{"type": "subtitle", "time": 2041.83, "timestamp": "00:34:01", "text": "ただこいつを蹴るのが好きなだけなんだ。"}, {"type": "subtitle", "time": 2043.99, "timestamp": "00:34:03", "text": "ちなみに、人の頭を踏みつけることもできる。   そうそう"}, {"type": "subtitle", "time": 2045.19, "timestamp": "00:34:05", "text": "。 知っている。 それが私がやろうとしていたことです"}, {"type": "subtitle", "time": 2047.669, "timestamp": "00:34:07", "text": "。"}, {"type": "subtitle", "time": 2050.149, "timestamp": "00:34:10", "text": "ああ、くそ。 待って、ジャックは"}, {"type": "subtitle", "time": 2055.99, "timestamp": "00:34:15", "text": "自分の好きなものをアップグレードしてるの？ いいえ、私は回復中です。"}, {"type": "subtitle", "time": 2058.149, "timestamp": "00:34:18", "text": "あ、そういえば、ヨーコ、疲れてるみたいだね。"}, {"type": "subtitle", "time": 2066.55, "timestamp": "00:34:26", "text": "ニース。"}, {"type": "subtitle", "time": 2068.95, "timestamp": "00:34:28", "text": "ああ、そうだね。 私が言ってたのはそれだよ"}, {"type": "subtitle", "time": 2070.19, "timestamp": "00:34:30", "text": "、"}, {"type": "subtitle", "time": 2080.149, "timestamp": "00:34:40", "text": "[拍手]"}, {"type": "subtitle", "time": 2083.909, "timestamp": "00:34:43", "text": "ああ、やばい、死にそうだ。"}, {"type": "subtitle", "time": 2094.23, "timestamp": "00:34:54", "text": "[音楽]"}]
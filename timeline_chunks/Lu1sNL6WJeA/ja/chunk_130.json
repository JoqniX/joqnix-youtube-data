[{"type": "subtitle", "time": 7815.99, "timestamp": "02:10:15", "text": "いや、彼の顔を撃ったんだ。 一体何なんだ"}, {"type": "subtitle", "time": 7819.91, "timestamp": "02:10:19", "text": "？ 最後のプレイヤーが立っている。 やべえ。"}, {"type": "subtitle", "time": 7823.03, "timestamp": "02:10:23", "text": "これは評価されていないゲームだよね？"}, {"type": "subtitle", "time": 7825.27, "timestamp": "02:10:25", "text": "どこにあるの？ そうだね。 そうだね。"}, {"type": "subtitle", "time": 7826.87, "timestamp": "02:10:26", "text": "なぜ彼らのチームには上手いプレイヤーがいるの"}, {"type": "subtitle", "time": 7834.91, "timestamp": "02:10:34", "text": "プレイしているの"}, {"type": "subtitle", "time": 7838.709, "timestamp": "02:10:38", "text": "？ こんにちは。 こんにちは、プレニップ。"}, {"type": "subtitle", "time": 7840.09, "timestamp": "02:10:40", "text": "こんにちは、プレニップ。 [音楽]"}, {"type": "subtitle", "time": 7841.599, "timestamp": "02:10:41", "text": "[音楽] 様。"}, {"type": "subtitle", "time": 7846.47, "timestamp": "02:10:46", "text": "それって2つ違うものじゃない？ちょっと"}, {"type": "subtitle", "time": 7849.99, "timestamp": "02:10:49", "text": "待って。クインは男の子用。ちゃんは"}, {"type": "subtitle", "time": 7854.709, "timestamp": "02:10:54", "text": "女の子用だよね？Sは様のSで、様は"}, {"type": "subtitle", "time": 7859.47, "timestamp": "02:10:59", "text": "えーと、尊敬の気持ちを表す言葉だよね？うん。尊敬の気持ちを表す言葉"}]
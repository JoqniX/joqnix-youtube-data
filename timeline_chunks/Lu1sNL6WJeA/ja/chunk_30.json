[{"type": "subtitle", "time": 1801.43, "timestamp": "00:30:01", "text": "。"}, {"type": "subtitle", "time": 1804.47, "timestamp": "00:30:04", "text": "これはこれはこれは私が"}, {"type": "subtitle", "time": 1808.789, "timestamp": "00:30:08", "text": "知っていたジョークではなかったよ。 親しみやすい人柄。 聞く。 私は"}, {"type": "subtitle", "time": 1810.789, "timestamp": "00:30:10", "text": "経営している事業がある。 ご存知の通り、私は"}, {"type": "subtitle", "time": 1813.51, "timestamp": "00:30:13", "text": "自分の荷物を放置しておくことはできません。 ジョーク。"}, {"type": "subtitle", "time": 1816.549, "timestamp": "00:30:16", "text": "私はこの男を信用できない。 いいえ。口を開く"}, {"type": "subtitle", "time": 1818.389, "timestamp": "00:30:18", "text": "前に発電機の燃料が必要です"}, {"type": "subtitle", "time": 1822.07, "timestamp": "00:30:22", "text": "。 これは私には疑わしいように思える。"}, {"type": "subtitle", "time": 1824.31, "timestamp": "00:30:24", "text": "私はもう死んでいるのか？ あなたはそこに"}, {"type": "subtitle", "time": 1826.789, "timestamp": "00:30:26", "text": "生きていると思います。 うん、君も来るんだね。"}, {"type": "subtitle", "time": 1830.389, "timestamp": "00:30:30", "text": "はい。 ここに来て。 どうぞお入りください。件名はこちら。"}, {"type": "subtitle", "time": 1833.19, "timestamp": "00:30:33", "text": "ボイスチャットがオンになっていると思います。"}, {"type": "subtitle", "time": 1836.07, "timestamp": "00:30:36", "text": "私のボイスチャット。 ええ、あなたのボイスチャットのことですね。"}, {"type": "subtitle", "time": 1838.789, "timestamp": "00:30:38", "text": "うん。 うん。 うん。 あなたの分は燃料に書いてありますよ、"}, {"type": "subtitle", "time": 1841.43, "timestamp": "00:30:41", "text": "約束します。 今、私の声が聞こえますか？ いや、"}, {"type": "subtitle", "time": 1842.669, "timestamp": "00:30:42", "text": "いや、いや、そうじゃないよ"}, {"type": "subtitle", "time": 1849.269, "timestamp": "00:30:49", "text": "えっと、このゲームで唯一気に入っている点は、"}, {"type": "subtitle", "time": 1852.87, "timestamp": "00:30:52", "text": "実際に相手を蹴ることができることですね。 ああ、そうだな"}, {"type": "subtitle", "time": 1854.33, "timestamp": "00:30:54", "text": "。"}, {"type": "subtitle", "time": 1857.19, "timestamp": "00:30:57", "text": "[音楽]"}]
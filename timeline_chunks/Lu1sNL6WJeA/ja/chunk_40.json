[{"type": "subtitle", "time": 2401.75, "timestamp": "00:40:01", "text": "猿。 猿。 サル。 ああ、わかりました。 待って、あれは"}, {"type": "subtitle", "time": 2404.23, "timestamp": "00:40:04", "text": "何だ？ 君が"}, {"type": "subtitle", "time": 2405.44, "timestamp": "00:40:05", "text": "蹴ったように？"}, {"type": "subtitle", "time": 2409.67, "timestamp": "00:40:09", "text": "[笑い]"}, {"type": "subtitle", "time": 2411.91, "timestamp": "00:40:11", "text": "いや、違うよ。 私は違います。 キューピッドの"}, {"type": "subtitle", "time": 2418.55, "timestamp": "00:40:18", "text": "どの曲？ 実際、これはショットですか？ なんてこった。"}, {"type": "subtitle", "time": 2420.91, "timestamp": "00:40:20", "text": "今、Super"}, {"type": "subtitle", "time": 2423.589, "timestamp": "00:40:23", "text": "Shyを聴いています。 独身なのに、ロマンチックな音楽ばかり聴いてしまう"}, {"type": "subtitle", "time": 2425.349, "timestamp": "00:40:25", "text": "。 はい。 待って、"}, {"type": "subtitle", "time": 2429.43, "timestamp": "00:40:29", "text": "あの音楽は何？ ああ、こんにちは。 お腹がすきましたか？   それを手に"}, {"type": "subtitle", "time": 2431.27, "timestamp": "00:40:31", "text": "入れろ。"}, {"type": "subtitle", "time": 2432.95, "timestamp": "00:40:32", "text": "ああ、ここに人がいる。 君たちは何者"}, {"type": "subtitle", "time": 2436.47, "timestamp": "00:40:36", "text": "？ それを手に入れろ。"}, {"type": "subtitle", "time": 2439.589, "timestamp": "00:40:39", "text": "うん。 あのね？ うん。 私はただ"}, {"type": "subtitle", "time": 2442.23, "timestamp": "00:40:42", "text": "貧しい人を助けただけです。 彼は空腹だった。 うん、"}, {"type": "subtitle", "time": 2444.87, "timestamp": "00:40:44", "text": "大丈夫だよ。 あなたは彼に食べ物を与えてください。"}, {"type": "subtitle", "time": 2446.109, "timestamp": "00:40:46", "text": "もちろん。"}, {"type": "subtitle", "time": 2449.43, "timestamp": "00:40:49", "text": "うん。 ほら、彼はそういうのが好きだったみたいなんだ"}, {"type": "subtitle", "time": 2451.829, "timestamp": "00:40:51", "text": "。 うん。"}, {"type": "subtitle", "time": 2459.19, "timestamp": "00:40:59", "text": "私はただ前に進むだけです。 私はそうは思わない。"}]
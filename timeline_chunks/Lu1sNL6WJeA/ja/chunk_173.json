[{"type": "subtitle", "time": 10382.469, "timestamp": "02:53:02", "text": "ああ、ああ。 おお。 おお。 おお。 おお。   さあ行こう"}, {"type": "subtitle", "time": 10385.59, "timestamp": "02:53:05", "text": "。 えっと、"}, {"type": "subtitle", "time": 10389.51, "timestamp": "02:53:09", "text": "銃を投げると偽物になることに気づきました。 うん。"}, {"type": "subtitle", "time": 10393.75, "timestamp": "02:53:13", "text": "爆発するんだろうな。 うん。"}, {"type": "subtitle", "time": 10396.99, "timestamp": "02:53:16", "text": "ああ、剣だ。"}, {"type": "subtitle", "time": 10400.23, "timestamp": "02:53:20", "text": "フランベルジュ。 フランベルジュとは何ですか？ おお、"}, {"type": "subtitle", "time": 10402.75, "timestamp": "02:53:22", "text": "炎の剣か。"}, {"type": "subtitle", "time": 10406.63, "timestamp": "02:53:26", "text": "本当に？ 炎は見えません。"}, {"type": "subtitle", "time": 10416.91, "timestamp": "02:53:36", "text": "しかし、炎は見当たらない。 とても"}, {"type": "subtitle", "time": 10420.07, "timestamp": "02:53:40", "text": "悲しい。 どこにいるの？   気をつけて。"}, {"type": "subtitle", "time": 10425.03, "timestamp": "02:53:45", "text": "これは何ですか？ かくれんぼ。"}, {"type": "subtitle", "time": 10428.71, "timestamp": "02:53:48", "text": "ゲームは永遠に続くって分かってるよね？"}, {"type": "subtitle", "time": 10430.11, "timestamp": "02:53:50", "text": "うん。 ゲームは"}, {"type": "subtitle", "time": 10434.79, "timestamp": "02:53:54", "text": "永遠に続きます。ああ、すごい。 あなたは銃を持っています。"}, {"type": "subtitle", "time": 10437.83, "timestamp": "02:53:57", "text": "ああ、剣で戦いたいのか？ いや、違う。ただお前を"}]
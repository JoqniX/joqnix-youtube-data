[{"type": "subtitle", "time": 3244.79, "timestamp": "00:54:04", "text": "助けて。 君が"}, {"type": "subtitle", "time": 3247.12, "timestamp": "00:54:07", "text": "望むものは何でもあげるよ。"}, {"type": "subtitle", "time": 3252.79, "timestamp": "00:54:12", "text": "ああ、なんてことだ。 私は嫌いだ なぜ私はこんな"}, {"type": "subtitle", "time": 3256.15, "timestamp": "00:54:16", "text": "馬鹿げた冗談を言うのか？"}, {"type": "subtitle", "time": 3258.65, "timestamp": "00:54:18", "text": "ああ、夜と拳。 わかった。"}, {"type": "subtitle", "time": 3264.88, "timestamp": "00:54:24", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 3269.829, "timestamp": "00:54:29", "text": "、私は死んでしまった。"}, {"type": "subtitle", "time": 3272.23, "timestamp": "00:54:32", "text": "まさに私が言いたかったのはそれです。 あなたが"}, {"type": "subtitle", "time": 3280.549, "timestamp": "00:54:40", "text": "ああ、損をするんですね。 なんてこった"}, {"type": "subtitle", "time": 3284.63, "timestamp": "00:54:44", "text": "、お金が減ってる。"}, {"type": "subtitle", "time": 3299.589, "timestamp": "00:54:59", "text": "彼女は私に頭突きをした。 あいつを蹴飛ばせばいいんだよ。"}]
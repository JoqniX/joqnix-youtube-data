[{"type": "subtitle", "time": 11783.03, "timestamp": "03:16:23", "text": "【音楽】"}, {"type": "subtitle", "time": 11788.229, "timestamp": "03:16:28", "text": "そう、それだ。 うん。 うん。 うん。 それです。"}, {"type": "subtitle", "time": 11791.51, "timestamp": "03:16:31", "text": "それです。 それです。 覚醒。"}, {"type": "subtitle", "time": 11795.87, "timestamp": "03:16:35", "text": "インペリウムは問題ない。 これはカード"}, {"type": "subtitle", "time": 11799.91, "timestamp": "03:16:39", "text": "ゲームです。 デューン・アウェイクニング。"}, {"type": "subtitle", "time": 11802.11, "timestamp": "03:16:42", "text": "2週間後に発売される予定です。"}, {"type": "subtitle", "time": 11804.309, "timestamp": "03:16:44", "text": "[音楽]"}, {"type": "subtitle", "time": 11806.15, "timestamp": "03:16:46", "text": "ああ、これは本当に良さそうだ。"}, {"type": "subtitle", "time": 11808.469, "timestamp": "03:16:48", "text": "おお。"}, {"type": "subtitle", "time": 11813.429, "timestamp": "03:16:53", "text": "うん。 そしてそれはスター・ウォーズだ。 うん。 なんだか"}]
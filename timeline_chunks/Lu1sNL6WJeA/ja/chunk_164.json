[{"type": "subtitle", "time": 9845.99, "timestamp": "02:44:05", "text": "難しい。 よし、これでいい。 私にはたった1回だけチャンスが必要なんです。"}, {"type": "subtitle", "time": 9847.83, "timestamp": "02:44:07", "text": "ウェブリーとその他諸々を含めて、1回だけ撮影したいんです"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "。"}, {"type": "subtitle", "time": 9852.389, "timestamp": "02:44:12", "text": "はい。   戻ってくる"}, {"type": "subtitle", "time": 9854.03, "timestamp": "02:44:14", "text": "。 どこに行くの"}, {"type": "subtitle", "time": 9867.91, "timestamp": "02:44:27", "text": "おお。 さあ行こう。 さあ行こう。 リボルバーを二丁"}, {"type": "subtitle", "time": 9870.389, "timestamp": "02:44:30", "text": "持ちすると、本当に"}, {"type": "subtitle", "time": 9873.19, "timestamp": "02:44:33", "text": "いい感じだよ。 タブを1つ入手してください。 つまり、右"}, {"type": "subtitle", "time": 9874.469, "timestamp": "02:44:34", "text": "クリックと左クリックを同時に行っているということですね"}, {"type": "subtitle", "time": 9882.19, "timestamp": "02:44:42", "text": "はい。 いいえ。なぜここに来たのですか？ 何てことだ"}, {"type": "subtitle", "time": 9884.71, "timestamp": "02:44:44", "text": "。 私は銃を手に入れた。 私は銃を手に入れた。 私は人を"}, {"type": "subtitle", "time": 9886.75, "timestamp": "02:44:46", "text": "殺せる。"}, {"type": "subtitle", "time": 9894.79, "timestamp": "02:44:54", "text": "あなたはどこにいるのですか？ 何てことだ。 あれも頭部への一撃だった"}, {"type": "subtitle", "time": 9896.07, "timestamp": "02:44:56", "text": "。   一体"}, {"type": "subtitle", "time": 9899.19, "timestamp": "02:44:59", "text": "どういうことだ？"}]
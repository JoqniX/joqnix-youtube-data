[{"type": "subtitle", "time": 5468.669, "timestamp": "01:31:08", "text": "。"}, {"type": "subtitle", "time": 5471.51, "timestamp": "01:31:11", "text": "こんにちは。  VODを楽しんでいただければ幸いです。 戻ってきました。"}, {"type": "subtitle", "time": 5472.51, "timestamp": "01:31:12", "text": "私は"}, {"type": "subtitle", "time": 5474.11, "timestamp": "01:31:14", "text": "生きている。"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "こんにちは。 夕食から戻りました。 ええと、"}, {"type": "subtitle", "time": 5479.83, "timestamp": "01:31:19", "text": "夕食ではありません。 ランチ。 ランチ。 ランチ。 ランチ。"}, {"type": "subtitle", "time": 5487.31, "timestamp": "01:31:27", "text": "コラボレーションに残された時間は、およそ15分、いや20分ほどです。"}, {"type": "subtitle", "time": 5492.91, "timestamp": "01:31:32", "text": "皆さん、ヨアトンの73日目へようこそ"}, {"type": "subtitle", "time": 5494.51, "timestamp": "01:31:34", "text": "。   わーい"}, {"type": "subtitle", "time": 5497.31, "timestamp": "01:31:37", "text": "。 ようこそ、"}, {"type": "subtitle", "time": 5499.31, "timestamp": "01:31:39", "text": "ディオ。"}, {"type": "subtitle", "time": 5505.03, "timestamp": "01:31:45", "text": "配信開始時に私が不在だったことをお詫び申し上げます。"}, {"type": "subtitle", "time": 5507.83, "timestamp": "01:31:47", "text": "停電はあったけど、とにかく"}, {"type": "subtitle", "time": 5510.91, "timestamp": "01:31:50", "text": "配信は開始したよ。"}, {"type": "subtitle", "time": 5513.51, "timestamp": "01:31:53", "text": "こんにちは、モデルを正しく接続する必要があります。"}, {"type": "subtitle", "time": 5515.47, "timestamp": "01:31:55", "text": "1"}]
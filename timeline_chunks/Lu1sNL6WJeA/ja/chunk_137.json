[{"type": "subtitle", "time": 8224.95, "timestamp": "02:17:04", "text": "そうだ。おいおい。おいおい。俺を"}, {"type": "subtitle", "time": 8227.349, "timestamp": "02:17:07", "text": "殺したいんだろ。俺を殺したいんだろ？俺を殺したくてたまらないんだな。あぁ"}, {"type": "subtitle", "time": 8236.709, "timestamp": "02:17:16", "text": "、ラグった。もう少しでラグるところだった。これは"}, {"type": "subtitle", "time": 8240.509, "timestamp": "02:17:20", "text": "とても悲しい。奴らは中央から来る。"}, {"type": "subtitle", "time": 8242.79, "timestamp": "02:17:22", "text": "気をつけろ。あぁ、それから、どうやら後ろにもいる"}, {"type": "subtitle", "time": 8244.91, "timestamp": "02:17:24", "text": "。ああ、"}, {"type": "subtitle", "time": 8248.669, "timestamp": "02:17:28", "text": "神様。中央、中央、中央。誰もいない"}, {"type": "subtitle", "time": 8253.27, "timestamp": "02:17:33", "text": "。奴らは今、視界に入っている。バン。"}, {"type": "subtitle", "time": 8254.709, "timestamp": "02:17:34", "text": "よし、奴らは"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "さっきまで見ていたところから来る。"}, {"type": "subtitle", "time": 8259.19, "timestamp": "02:17:39", "text": "敵はあと一人。あと一人。あと一人。"}, {"type": "subtitle", "time": 8262.27, "timestamp": "02:17:42", "text": "最後のプレイヤーが立っている。ミトコンドリアだ。"}, {"type": "subtitle", "time": 8266.23, "timestamp": "02:17:46", "text": "気をつけろ。ミトコンドリア。"}, {"type": "subtitle", "time": 8268.469, "timestamp": "02:17:48", "text": "奴は今、スパイクの上にいる。ケビン、君なら"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "奴をスタンさせられる。奴は見えなかった"}, {"type": "subtitle", "time": 8273.589, "timestamp": "02:17:53", "text": "。"}, {"type": "subtitle", "time": 8276.23, "timestamp": "02:17:56", "text": "あいつは賢い。マインドコントロールは"}, {"type": "subtitle", "time": 8277.83, "timestamp": "02:17:57", "text": "賢い。"}]
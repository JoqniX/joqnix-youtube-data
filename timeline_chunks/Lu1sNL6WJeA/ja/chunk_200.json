[{"type": "subtitle", "time": 12001.67, "timestamp": "03:20:01", "text": "特定の場所に配置するんです。 はい、これでいいでしょう。"}, {"type": "subtitle", "time": 12003.59, "timestamp": "03:20:03", "text": "ランダムなアイテムの詰め合わせも手に入ります"}, {"type": "subtitle", "time": 12011.349, "timestamp": "03:20:11", "text": "じゃあ青色は偽物ってことですよね？ はい、"}, {"type": "subtitle", "time": 12014.15, "timestamp": "03:20:14", "text": "青色は偽物です。"}, {"type": "subtitle", "time": 12017.03, "timestamp": "03:20:17", "text": "スパンコールは見えませんでした。 くそ。 持続する。"}, {"type": "subtitle", "time": 12020.469, "timestamp": "03:20:20", "text": "自分の通りに戻ればいいだけだ。   次は"}, {"type": "subtitle", "time": 12022.389, "timestamp": "03:20:22", "text": "あなたの番だったと思います。 そして、どちらかを選んで、"}, {"type": "subtitle", "time": 12023.67, "timestamp": "03:20:23", "text": "自分の持ち物の一つを使うことができます"}, {"type": "subtitle", "time": 12026.309, "timestamp": "03:20:26", "text": "。 アイテムのいずれかをクリックすると、"}, {"type": "subtitle", "time": 12029.51, "timestamp": "03:20:29", "text": "青色が偽物になりますよね？ 青色は"}, {"type": "subtitle", "time": 12044.59, "timestamp": "03:20:44", "text": "こんにちは。 私を撃つつもりですか？ それは、それは、"}, {"type": "subtitle", "time": 12051.269, "timestamp": "03:20:51", "text": "それは生きていた。 おお。 ああ、神様。   よし"}, {"type": "subtitle", "time": 12052.87, "timestamp": "03:20:52", "text": "。 あのね？"}, {"type": "subtitle", "time": 12059.19, "timestamp": "03:20:59", "text": "ここでこれを使ってみるよ。思い切ってやってみる。"}]
[{"type": "subtitle", "time": 10921.309, "timestamp": "03:02:01", "text": "どんな気持ちか、想像できますか"}, {"type": "subtitle", "time": 10923.91, "timestamp": "03:02:03", "text": "？ 一体どうして彼は私の後ろにいたんだろう？"}, {"type": "subtitle", "time": 10931.11, "timestamp": "03:02:11", "text": "ああ、これはこれは"}, {"type": "subtitle", "time": 10940.429, "timestamp": "03:02:20", "text": "実際、マガジンを"}, {"type": "subtitle", "time": 10944.269, "timestamp": "03:02:24", "text": "空にする量。 なんてこった。 何てことだ"}, {"type": "subtitle", "time": 10946.67, "timestamp": "03:02:26", "text": "。 来て"}, {"type": "subtitle", "time": 10949.79, "timestamp": "03:02:29", "text": "。 さあ、ジョック。"}, {"type": "subtitle", "time": 10953.11, "timestamp": "03:02:33", "text": "クイニックス。 おお。 ええ、そうですね。 うん。 バイバイ。"}, {"type": "subtitle", "time": 10961.11, "timestamp": "03:02:41", "text": "。 くそ。 私がばらまいた弾丸の数と、"}, {"type": "subtitle", "time": 10963.83, "timestamp": "03:02:43", "text": "そう。"}, {"type": "subtitle", "time": 10965.67, "timestamp": "03:02:45", "text": "ああ、これだ。 これです。 これは、"}, {"type": "subtitle", "time": 10975.16, "timestamp": "03:02:55", "text": "しまった。 さあ行こう。 ニース。"}]
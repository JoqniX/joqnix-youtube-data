[{"type": "subtitle", "time": 9122.15, "timestamp": "02:32:02", "text": "？私はこのゲームをApexとしてプレイしているんだ。"}, {"type": "subtitle", "time": 9123.389, "timestamp": "02:32:03", "text": "私はApexをプレイしていない"}, {"type": "subtitle", "time": 9125.91, "timestamp": "02:32:05", "text": "。Apexで一体何をするんだ？なんてこった。なんてこった"}, {"type": "subtitle", "time": 9133.51, "timestamp": "02:32:13", "text": "。よし、"}, {"type": "subtitle", "time": 9135.87, "timestamp": "02:32:15", "text": "実はここで何をすべきか分かった。"}, {"type": "subtitle", "time": 9138.389, "timestamp": "02:32:18", "text": "[拍手]"}, {"type": "subtitle", "time": 9141.19, "timestamp": "02:32:21", "text": "待って、どうやって？やった。行こう。"}, {"type": "subtitle", "time": 9142.87, "timestamp": "02:32:22", "text": "ほら、壁越しに撃てるんだ。私は"}, {"type": "subtitle", "time": 9158.67, "timestamp": "02:32:38", "text": "あ、"}, {"type": "subtitle", "time": 9163.27, "timestamp": "02:32:43", "text": "待って。何だって？落ちた。"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "ああ、飛び越えたんだ。なるほど。"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "そんなことができるなんて知らなかった。くそ。"}, {"type": "subtitle", "time": 9172.07, "timestamp": "02:32:52", "text": "壁越しに撃つだけだと思ってた。すごい。ああ、神様。これは"}, {"type": "subtitle", "time": 9174.95, "timestamp": "02:32:54", "text": "私の苦手なマップだ。"}, {"type": "subtitle", "time": 9178.309, "timestamp": "02:32:58", "text": "苦手なマップなの？苦手なマップがあるの？"}]
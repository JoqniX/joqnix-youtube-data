[{"type": "subtitle", "time": 7154.03, "timestamp": "01:59:14", "text": "[音楽]"}, {"type": "subtitle", "time": 7156.35, "timestamp": "01:59:16", "text": "ええと、"}, {"type": "subtitle", "time": 7163.83, "timestamp": "01:59:23", "text": "こんにちは。配信中ですよね？"}, {"type": "subtitle", "time": 7165.75, "timestamp": "01:59:25", "text": "配信は好きですか？はい、配信を開始しました"}, {"type": "subtitle", "time": 7168.79, "timestamp": "01:59:28", "text": "。わかりました。こんにちは、Jocknix。こんにちは。"}, {"type": "subtitle", "time": 7171.709, "timestamp": "01:59:31", "text": "自己紹介してください。何か言ってください。"}, {"type": "subtitle", "time": 7175.189, "timestamp": "01:59:35", "text": "皆さんこんにちは。私の名前はJocknです。"}, {"type": "subtitle", "time": 7178.629, "timestamp": "01:59:38", "text": "インド出身の星座系YouTuberです。"}, {"type": "subtitle", "time": 7181.99, "timestamp": "01:59:41", "text": "皆さんにお会いできて嬉しいです。さあ、行きましょう。さあ、行きましょう。わかりました。わかりました。"}, {"type": "subtitle", "time": 7184.55, "timestamp": "01:59:44", "text": "それで、"}, {"type": "subtitle", "time": 7185.91, "timestamp": "01:59:45", "text": "このアカウントにあなたを追加していないということは、"}, {"type": "subtitle", "time": 7188.47, "timestamp": "01:59:48", "text": "私を追加する必要がある。ああ、"}, {"type": "subtitle", "time": 7190.55, "timestamp": "01:59:50", "text": "走るよ。よし。ちょっと待って。1分だけ時間をくれ。やらせてくれ。"}, {"type": "subtitle", "time": 7193.189, "timestamp": "01:59:53", "text": "ああ、発射する。うわ、今"}]
[{"type": "subtitle", "time": 9540.429, "timestamp": "02:39:00", "text": "カニエッドを手に入れろ。ああ。"}, {"type": "subtitle", "time": 9543.59, "timestamp": "02:39:03", "text": "ああ、くそ。これは何のゲームだ？俺の勝ちだ。俺の"}, {"type": "subtitle", "time": 9545.59, "timestamp": "02:39:05", "text": "勝ちだと思う。"}, {"type": "subtitle", "time": 9549.11, "timestamp": "02:39:09", "text": "何ラウンドだ？6ラウンド。"}, {"type": "subtitle", "time": 9552.96, "timestamp": "02:39:12", "text": "一緒に踊ろう。さあ。"}, {"type": "subtitle", "time": 9559.59, "timestamp": "02:39:19", "text": "よし、行こう。もう一度やろう。行こう"}, {"type": "subtitle", "time": 9562.71, "timestamp": "02:39:22", "text": "。"}]
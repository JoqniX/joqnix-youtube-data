[{"type": "subtitle", "time": 11700.71, "timestamp": "03:15:00", "text": "映画が公開された時に見てみたところ"}, {"type": "subtitle", "time": 11703.67, "timestamp": "03:15:03", "text": "、Prime Gamingというサービスで"}, {"type": "subtitle", "time": 11706.469, "timestamp": "03:15:06", "text": "PCとXbox版のFalloutシリーズが無料で配信されていたことに気づいたんです"}, {"type": "subtitle", "time": 11710.11, "timestamp": "03:15:10", "text": "。"}, {"type": "subtitle", "time": 11718.87, "timestamp": "03:15:18", "text": "ええ、私が試してみたいゲームの一つは、"}, {"type": "subtitle", "time": 11722.469, "timestamp": "03:15:22", "text": "デューンなんとかっていうゲームです。"}, {"type": "subtitle", "time": 11726.63, "timestamp": "03:15:26", "text": "破滅。 砂丘。 砂丘。  D. 待って、"}, {"type": "subtitle", "time": 11734.229, "timestamp": "03:15:34", "text": "はぁ？"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "オープンワールド型ですか？それともストーリー重視型ですか"}, {"type": "subtitle", "time": 11740.229, "timestamp": "03:15:40", "text": "？ オープンワールドのクラフタータイプ。"}, {"type": "subtitle", "time": 11743.03, "timestamp": "03:15:43", "text": "ああ、わかった。 サバイバル"}, {"type": "subtitle", "time": 11749.309, "timestamp": "03:15:49", "text": "デューンが利用可能です。 それは"}, {"type": "subtitle", "time": 11751.71, "timestamp": "03:15:51", "text": "インフェリウムですか？ ちょっと待ってください"}, {"type": "subtitle", "time": 11754.63, "timestamp": "03:15:54", "text": "。 ああ、これだ。 ええ、"}, {"type": "subtitle", "time": 11757.55, "timestamp": "03:15:57", "text": "Steamで販売されていますよ。 わかりました、見せてください"}, {"type": "subtitle", "time": 11759.99, "timestamp": "03:15:59", "text": "。 あ、そうそう、私もゲームに参加しているので、何かあれば教えてください"}]
[{"type": "subtitle", "time": 10563.429, "timestamp": "02:56:03", "text": "あなたはここにいますか？ うん。 よし、これでいい。 ええ、今"}, {"type": "subtitle", "time": 10569.469, "timestamp": "02:56:09", "text": "。 俺はフェラーリにグロックを積んでいる"}, {"type": "subtitle", "time": 10579.389, "timestamp": "02:56:19", "text": "ああ、俺の"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "フェラーリにはグロックが積んである。  17発。  「うん、彼女は"}, {"type": "subtitle", "time": 10586.07, "timestamp": "02:56:26", "text": "大丈夫だよ」って感じだった。 驚きは"}, {"type": "subtitle", "time": 10594.07, "timestamp": "02:56:34", "text": "気分だった。 あなたの曲、すごくノリノリでした。"}, {"type": "subtitle", "time": 10595.91, "timestamp": "02:56:35", "text": "私は「"}, {"type": "subtitle", "time": 10600.269, "timestamp": "02:56:40", "text": "オーマイゴッド」が好きです。 ちょっとノリすぎたかな"}, {"type": "subtitle", "time": 10607.87, "timestamp": "02:56:47", "text": "。 どこにいるの"}, {"type": "subtitle", "time": 10610.309, "timestamp": "02:56:50", "text": "？ 君の姿すら見えないよ。 ああ、そこにいたんですね"}, {"type": "subtitle", "time": 10615.07, "timestamp": "02:56:55", "text": "さあ、私と戦ってみろ"}, {"type": "subtitle", "time": 10619.67, "timestamp": "02:56:59", "text": "。 男らしく戦え。"}]
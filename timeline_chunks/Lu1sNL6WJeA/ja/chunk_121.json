[{"type": "subtitle", "time": 7261.83, "timestamp": "02:01:01", "text": "今すぐ始めなきゃいけないとか、追いつかなきゃいけないとか、延々と説教し続けたのよ。その間に、授業時間の"}, {"type": "subtitle", "time": 7264.87, "timestamp": "02:01:04", "text": "半分が無駄になったのよ。もう、本当に。延々と説教されてる。信じられない"}, {"type": "subtitle", "time": 7271.189, "timestamp": "02:01:11", "text": "。私はただ"}, {"type": "subtitle", "time": 7273.03, "timestamp": "02:01:13", "text": "そこに立ってただけ。立ってたのよ。  25"}, {"type": "subtitle", "time": 7274.39, "timestamp": "02:01:14", "text": "分間そこにいたのよ。"}, {"type": "subtitle", "time": 7278.39, "timestamp": "02:01:18", "text": "座らせてもくれなかったの。信じられる？何？わから"}, {"type": "subtitle", "time": 7279.91, "timestamp": "02:01:19", "text": "ない。"}, {"type": "subtitle", "time": 7281.51, "timestamp": "02:01:21", "text": "この人たちがどうなっているのか、まったくわからない。まったくわからない。"}, {"type": "subtitle", "time": 7286.87, "timestamp": "02:01:26", "text": "ええと、大丈夫よ。"}, {"type": "subtitle", "time": 7289.629, "timestamp": "02:01:29", "text": "教授みたいなものだ"}, {"type": "subtitle", "time": 7292.47, "timestamp": "02:01:32", "text": "けど、"}, {"type": "subtitle", "time": 7294.39, "timestamp": "02:01:34", "text": "大丈夫？えっと、読み込み"}, {"type": "subtitle", "time": 7297.189, "timestamp": "02:01:37", "text": "画面なの。よし、入ったわ。えっと、あなたの"}, {"type": "subtitle", "time": 7300.31, "timestamp": "02:01:40", "text": "IDは？えっと、Discordで送って。追加するわ。うん。うん。Discord"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "大好き。えっと、なんて"}, {"type": "subtitle", "time": 7308.47, "timestamp": "02:01:48", "text": "言うんだっけ？低データモードみたいなやつ？"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "アバターが読み込まれてないでしょ？そう"}, {"type": "subtitle", "time": 7313.83, "timestamp": "02:01:53", "text": "なの？え、そうなの？私のPFPが見えないの"}, {"type": "subtitle", "time": 7317.35, "timestamp": "02:01:57", "text": "？私の？いいえ、真っ黒よ。空白よ。ああ、なんてこと"}]
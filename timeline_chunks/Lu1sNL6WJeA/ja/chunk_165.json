[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "それを切り取るためのスコープを知らなかった。"}, {"type": "subtitle", "time": 9905.55, "timestamp": "02:45:05", "text": "ジョック。 あれは一体何だったんだ？ 私は"}, {"type": "subtitle", "time": 9909.07, "timestamp": "02:45:09", "text": "ショットガンを持っていた。 すみません。 どこにいるの"}, {"type": "subtitle", "time": 9916.95, "timestamp": "02:45:16", "text": "催眠術をかけられた。 実際、スコープで確認してもらいましょう。 はい、これでいいでしょう"}, {"type": "subtitle", "time": 9929.67, "timestamp": "02:45:29", "text": "ああ、こんにちは。"}, {"type": "subtitle", "time": 9933.03, "timestamp": "02:45:33", "text": "私たちも同じことを目指しているんですよね？   何てことだ"}, {"type": "subtitle", "time": 9935.59, "timestamp": "02:45:35", "text": "。"}, {"type": "subtitle", "time": 9938.63, "timestamp": "02:45:38", "text": "何？ 両方ともください。"}, {"type": "subtitle", "time": 9941.11, "timestamp": "02:45:41", "text": "私たちは互いに殺し合った。 つまり、私が私たち二人を殺したんです"}, {"type": "subtitle", "time": 9954.23, "timestamp": "02:45:54", "text": "。 ああ、スコープの感度が"}, {"type": "subtitle", "time": 9957.309, "timestamp": "02:45:57", "text": "高すぎる。 全く"}]
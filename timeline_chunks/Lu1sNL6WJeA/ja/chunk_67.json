[{"type": "subtitle", "time": 4025.67, "timestamp": "01:07:05", "text": "オーケー。 ニース。"}, {"type": "subtitle", "time": 4028.95, "timestamp": "01:07:08", "text": "じゃあ、君たちは交代したいってこと？ もちろん。   わかった"}, {"type": "subtitle", "time": 4031.71, "timestamp": "01:07:11", "text": "。 それから配信を終了して、また"}, {"type": "subtitle", "time": 4035.27, "timestamp": "01:07:15", "text": "配信を始めます。"}, {"type": "subtitle", "time": 4042.47, "timestamp": "01:07:22", "text": "ええ、そうですね。 えっと、"}, {"type": "subtitle", "time": 4045.029, "timestamp": "01:07:25", "text": "皆さん、画面を見ないでください。 画面を見ないでください。 待って、"}, {"type": "subtitle", "time": 4047.27, "timestamp": "01:07:27", "text": "あなたたちは本当にああ、私が"}, {"type": "subtitle", "time": 4049.63, "timestamp": "01:07:29", "text": "あなたを癒してあげましょう。 なんてこった。"}, {"type": "subtitle", "time": 4057.19, "timestamp": "01:07:37", "text": "つまり、この進行状況はここにあるすべてのものに保存されるということですよね"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "？ はい。 これはどのように"}, {"type": "subtitle", "time": 4067.549, "timestamp": "01:07:47", "text": "ああ、君は殴りつけているんだね。"}, {"type": "subtitle", "time": 4070.349, "timestamp": "01:07:50", "text": "場所 何てことだ。"}, {"type": "subtitle", "time": 4072.43, "timestamp": "01:07:52", "text": "うん。 何てことだ"}, {"type": "subtitle", "time": 4075.029, "timestamp": "01:07:55", "text": "。 お子様向けです。このゲームは"}, {"type": "subtitle", "time": 4077.829, "timestamp": "01:07:57", "text": "お子様には向いていません。 ええ、そうですね。   えっと"}]
[{"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "クリアだったから、彼はローテーションしているはずだ。"}, {"type": "subtitle", "time": 7985.91, "timestamp": "02:13:05", "text": "クリアじゃない。Aにいたけど、うん。"}, {"type": "subtitle", "time": 7988.589, "timestamp": "02:13:08", "text": "いや、彼は私じゃない。あそこにいる"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "。見逃した。"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "最後のプレイヤーが立っている。"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "また見逃した。うん、あそこに1人、あそこに1人"}, {"type": "subtitle", "time": 8000.83, "timestamp": "02:13:20", "text": "。"}, {"type": "subtitle", "time": 8002.95, "timestamp": "02:13:22", "text": "まあ、彼らは私を見つけて殺すつもりだろうね"}, {"type": "subtitle", "time": 8005.589, "timestamp": "02:13:25", "text": "？敵が1人残っている。私の"}, {"type": "subtitle", "time": 8007.629, "timestamp": "02:13:27", "text": "アルティメットは"}, {"type": "subtitle", "time": 8010.87, "timestamp": "02:13:30", "text": "ああ、ミアンドラは良いプレイヤーだ。彼は さっきワンタップで倒してきたやつだ"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "。もちろん、彼は"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "セルのパワーハウスだ。そうでないわけがないだろう？"}, {"type": "subtitle", "time": 8021.669, "timestamp": "02:13:41", "text": "彼は最高のプレイヤーだ。ああ、"}, {"type": "subtitle", "time": 8023.51, "timestamp": "02:13:43", "text": "大丈夫だ。ミトコンドリアのことは何とかするよ"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "こいつはミッドでスナイプするのが好きなんだ。ああ、そうだな"}, {"type": "subtitle", "time": 8034.229, "timestamp": "02:13:54", "text": "。ああ、こいつを"}, {"type": "subtitle", "time": 8036.39, "timestamp": "02:13:56", "text": "倒すよ。こいつはシールドを持っている。だから、"}]
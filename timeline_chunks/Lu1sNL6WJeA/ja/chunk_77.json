[{"type": "subtitle", "time": 4620.149, "timestamp": "01:17:00", "text": "バレンタインデーの配信を午後"}, {"type": "subtitle", "time": 4621.95, "timestamp": "01:17:01", "text": "3時45分に行いました。"}, {"type": "subtitle", "time": 4626.149, "timestamp": "01:17:06", "text": "えーっと、1時間かけて"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "バレンタインの物語をまるまる語る配信をしました。 そして、"}, {"type": "subtitle", "time": 4632.149, "timestamp": "01:17:12", "text": "私たちはこの配信を行った。 ストリームの長さはどれくらいでしたっけ"}, {"type": "subtitle", "time": 4634.39, "timestamp": "01:17:14", "text": "？ ああ、もうすぐ"}, {"type": "subtitle", "time": 4636.79, "timestamp": "01:17:16", "text": "2時間になるよ。 ニース。"}, {"type": "subtitle", "time": 4639.87, "timestamp": "01:17:19", "text": "ええ、休んでください。 ああ、本当に"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "疲れたよ。 私はただ昼食、"}, {"type": "subtitle", "time": 4646.229, "timestamp": "01:17:26", "text": "いや夕食を食べて、そのまま"}, {"type": "subtitle", "time": 4649.35, "timestamp": "01:17:29", "text": "眠りにつきたいだけです。 ただそうしたかっただけなんです。 うん。"}, {"type": "subtitle", "time": 4651.39, "timestamp": "01:17:31", "text": "ええ、"}, {"type": "subtitle", "time": 4654.669, "timestamp": "01:17:34", "text": "明日ですね。"}, {"type": "subtitle", "time": 4658.11, "timestamp": "01:17:38", "text": "明日とは何でしょうか？ 明日は"}, {"type": "subtitle", "time": 4662.229, "timestamp": "01:17:42", "text": "15日です。 いいえ。ええ、明日です。   ああ"}, {"type": "subtitle", "time": 4664.229, "timestamp": "01:17:44", "text": "、忘れてた。 明日は"}, {"type": "subtitle", "time": 4667.55, "timestamp": "01:17:47", "text": "お腹の部分をやらなきゃ。 準備してないよ"}, {"type": "subtitle", "time": 4670.95, "timestamp": "01:17:50", "text": "。 私は、"}, {"type": "subtitle", "time": 4676.149, "timestamp": "01:17:56", "text": "今日から14日から2ヶ月間くらいストリームが必要だと知りました"}]
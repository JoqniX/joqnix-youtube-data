[{"type": "subtitle", "time": 7620.629, "timestamp": "02:07:00", "text": "ラストプレイヤースタンディング。"}, {"type": "subtitle", "time": 7624.95, "timestamp": "02:07:04", "text": "待って。何だ？あ、フォートナイト"}, {"type": "subtitle", "time": 7633.03, "timestamp": "02:07:13", "text": "ヴァレラントのはずなのに。リロードはえーと、左角"}, {"type": "subtitle", "time": 7635.91, "timestamp": "02:07:15", "text": "括弧。"}, {"type": "subtitle", "time": 7638.79, "timestamp": "02:07:18", "text": "左四角。何？何してるんだ？なんでそんなことするんだ？一体何なんだ？"}, {"type": "subtitle", "time": 7641.589, "timestamp": "02:07:21", "text": "Rは"}, {"type": "subtitle", "time": 7645.589, "timestamp": "02:07:25", "text": "アビリティみたいなものだ。なんで？待って、Rは何だ"}, {"type": "subtitle", "time": 7650.39, "timestamp": "02:07:30", "text": "？そうだ。待って、Rは何だ？ちょっと待って"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "。Rは知らない。確認して。待って、確認させてくれ"}, {"type": "subtitle", "time": 7656.95, "timestamp": "02:07:36", "text": "。デフォルトだ。"}, {"type": "subtitle", "time": 7659.35, "timestamp": "02:07:39", "text": "デフォルトのキーを全部教えてやるよ。"}, {"type": "subtitle", "time": 7668.27, "timestamp": "02:07:48", "text": "装備だ。あ、Rを入れればよかった。"}, {"type": "subtitle", "time": 7671.55, "timestamp": "02:07:51", "text": "なんで入れなかったんだ？ わかった、R を押してみよう。"}, {"type": "subtitle", "time": 7674.149, "timestamp": "02:07:54", "text": "うん。標準のキーバインド。だから、うん、そうするべきだ"}]
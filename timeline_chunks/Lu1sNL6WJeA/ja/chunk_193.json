[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "あなたは神だ。"}, {"type": "subtitle", "time": 11583.99, "timestamp": "03:13:03", "text": "ああ、君がフォールアウト"}, {"type": "subtitle", "time": 11587.67, "timestamp": "03:13:07", "text": "シリーズをプレイしているのを見たよ。 どうだった？ おお、フォールアウト。 ああ、"}, {"type": "subtitle", "time": 11589.91, "timestamp": "03:13:09", "text": "フォールアウト大好き。 ええと、ニューベガスが一番"}, {"type": "subtitle", "time": 11592.15, "timestamp": "03:13:12", "text": "好きです。 読み終えていないと思います。"}, {"type": "subtitle", "time": 11594.15, "timestamp": "03:13:14", "text": "実は、近いうちに取りに行く予定だったんです。"}, {"type": "subtitle", "time": 11595.67, "timestamp": "03:13:15", "text": "また、"}, {"type": "subtitle", "time": 11598.389, "timestamp": "03:13:18", "text": "フォールアウトをプレイしました。   そうそう"}, {"type": "subtitle", "time": 11601.349, "timestamp": "03:13:21", "text": "。"}, {"type": "subtitle", "time": 11603.75, "timestamp": "03:13:23", "text": "あなたは実際にFalloutをプレイしたことがありますか？ まだ。 私が"}, {"type": "subtitle", "time": 11609.11, "timestamp": "03:13:29", "text": "フォールアウトシリーズとその"}, {"type": "subtitle", "time": 11610.91, "timestamp": "03:13:30", "text": "世界観にハマるきっかけとなった映画は観ました。"}, {"type": "subtitle", "time": 11615.11, "timestamp": "03:13:35", "text": "おお。 ああ、このシリーズは本当に素晴らしいですね。 えっと、"}, {"type": "subtitle", "time": 11617.11, "timestamp": "03:13:37", "text": "もし始めたいなら、"}, {"type": "subtitle", "time": 11619.269, "timestamp": "03:13:39", "text": "Fallout 4 から始めて、それから"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "New Vegas をプレイするのがいいと思うよ。Fallout"}, {"type": "subtitle", "time": 11623.67, "timestamp": "03:13:43", "text": "4 の方がユーザーフレンドリーだし、"}, {"type": "subtitle", "time": 11627.11, "timestamp": "03:13:47", "text": "New Vegas みたいなのは、"}, {"type": "subtitle", "time": 11636.389, "timestamp": "03:13:56", "text": "新しいプレイヤーにとっては、まあ、圧倒されるような感じだから。えっと、なんて言うんだっけ？"}]
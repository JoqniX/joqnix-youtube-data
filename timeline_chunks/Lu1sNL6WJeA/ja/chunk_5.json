[{"type": "subtitle", "time": 300.35, "timestamp": "00:05:00", "text": "音楽業界では何が"}, {"type": "subtitle", "time": 302.31, "timestamp": "00:05:02", "text": "起こっているの？ わかった。 あなたは"}, {"type": "subtitle", "time": 306.189, "timestamp": "00:05:06", "text": "序章から文句を言っていますね。 ええ、"}, {"type": "subtitle", "time": 309.029, "timestamp": "00:05:09", "text": "そうです。 プロローグをクリアして、今はちょっと変わった"}, {"type": "subtitle", "time": 311.35, "timestamp": "00:05:11", "text": "キャンパークエストみたいなことをやってる"}, {"type": "subtitle", "time": 314.63, "timestamp": "00:05:14", "text": "。 ああ、わかりました。"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "[音楽]"}]
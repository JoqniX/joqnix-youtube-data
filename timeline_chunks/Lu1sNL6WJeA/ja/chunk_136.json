[{"type": "subtitle", "time": 8160.229, "timestamp": "02:16:00", "text": "うん、実はわからない。"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "真ん中に3人いる。なんてこった。もう行くよ"}, {"type": "subtitle", "time": 8170.069, "timestamp": "02:16:10", "text": "ああ、ランクがついたんだね。ああ、だめだ。そうじゃない。"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "ああ、助けて。助けて。助けて。助けて。助けて。助けて。誰か。誰か"}, {"type": "subtitle", "time": 8173.03, "timestamp": "02:16:13", "text": "。"}, {"type": "subtitle", "time": 8176.55, "timestamp": "02:16:16", "text": "それを撃て。ああ、神様。ああ、神様。彼らは。"}, {"type": "subtitle", "time": 8181.189, "timestamp": "02:16:21", "text": "うわあ。彼らは、ああ、"}, {"type": "subtitle", "time": 8184.109, "timestamp": "02:16:24", "text": "それは悲しい。"}, {"type": "subtitle", "time": 8188.629, "timestamp": "02:16:28", "text": "うん、それは。ああ、それは。彼らは"}, {"type": "subtitle", "time": 8191.51, "timestamp": "02:16:31", "text": "ちなみに、みんな見てるよ。"}, {"type": "subtitle", "time": 8192.91, "timestamp": "02:16:32", "text": "あぁ、くそ。"}, {"type": "subtitle", "time": 8195.75, "timestamp": "02:16:35", "text": "よし、いいか？"}, {"type": "subtitle", "time": 8198.79, "timestamp": "02:16:38", "text": "この問題の解決策がある。"}, {"type": "subtitle", "time": 8200.549, "timestamp": "02:16:40", "text": "一人ずつ片付けていくんだ"}, {"type": "subtitle", "time": 8202.15, "timestamp": "02:16:42", "text": "。"}, {"type": "subtitle", "time": 8203.669, "timestamp": "02:16:43", "text": "あぁ。"}, {"type": "subtitle", "time": 8214.07, "timestamp": "02:16:54", "text": "ドロップが必要だ。奴らを"}]
[{"type": "subtitle", "time": 9182.23, "timestamp": "02:33:02", "text": "うん、だって私は今、"}, {"type": "subtitle", "time": 9186.15, "timestamp": "02:33:06", "text": "ランダムな人たちとこれをよくプレイしているから。"}, {"type": "subtitle", "time": 9187.75, "timestamp": "02:33:07", "text": "すごい。"}, {"type": "subtitle", "time": 9189.99, "timestamp": "02:33:09", "text": "うん、この銃は嫌いだ。"}, {"type": "subtitle", "time": 9192.63, "timestamp": "02:33:12", "text": "撃つのをやめろ。"}, {"type": "subtitle", "time": 9194.95, "timestamp": "02:33:14", "text": "一度クリックしたら、"}, {"type": "subtitle", "time": 9212.83, "timestamp": "02:33:32", "text": "。行こう。"}]
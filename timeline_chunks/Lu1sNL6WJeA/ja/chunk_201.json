[{"type": "subtitle", "time": 12061.309, "timestamp": "03:21:01", "text": "あ、実は私もこれできますよ"}, {"type": "subtitle", "time": 12063.95, "timestamp": "03:21:03", "text": "。"}, {"type": "subtitle", "time": 12067.59, "timestamp": "03:21:07", "text": "えっと、"}, {"type": "subtitle", "time": 12070.79, "timestamp": "03:21:10", "text": "アドレナリンは後で使ってあなたのアイテムを盗むべきだったと思うんだけど、"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "待って、あなたは私のアイテムを盗めるの？ ええ、まさに今やったところです"}, {"type": "subtitle", "time": 12074.229, "timestamp": "03:21:14", "text": "。 あなたの"}, {"type": "subtitle", "time": 12076.63, "timestamp": "03:21:16", "text": "物を盗みました。   何てことだ"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "。 そして私はあなたのターンをブロックしました。"}, {"type": "subtitle", "time": 12084.07, "timestamp": "03:21:24", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 12085.95, "timestamp": "03:21:25", "text": "申し訳ありません、"}, {"type": "subtitle", "time": 12091.03, "timestamp": "03:21:31", "text": "ジョブさん。 さて、これで空欄が1つ増えました。"}, {"type": "subtitle", "time": 12094.15, "timestamp": "03:21:34", "text": "今度はあなたの番です。 どうぞ。"}, {"type": "subtitle", "time": 12097.429, "timestamp": "03:21:37", "text": "あなたの物を盗むことはできません。 わかった。 はい、"}, {"type": "subtitle", "time": 12099.349, "timestamp": "03:21:39", "text": "できますよ。 ああ、"}, {"type": "subtitle", "time": 12101.63, "timestamp": "03:21:41", "text": "アドレナリンというアイテムがあれば、それを装備して"}, {"type": "subtitle", "time": 12105.99, "timestamp": "03:21:45", "text": "アイテムを盗むんだ。 わかったよ。 ボンク。"}, {"type": "subtitle", "time": 12109.19, "timestamp": "03:21:49", "text": "おお。 よし、可能性が非常に高いから、お前を撃つぞ"}, {"type": "subtitle", "time": 12111.91, "timestamp": "03:21:51", "text": "。 大丈夫です。"}, {"type": "subtitle", "time": 12113.99, "timestamp": "03:21:53", "text": "おお。"}, {"type": "subtitle", "time": 12116.55, "timestamp": "03:21:56", "text": "これで私たちは対等な立場になったと言えるでしょう。 それは"}]
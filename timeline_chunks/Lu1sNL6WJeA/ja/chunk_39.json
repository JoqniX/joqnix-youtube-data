[{"type": "subtitle", "time": 2340.87, "timestamp": "00:39:00", "text": "何？ 何が起こっている？ 何？"}, {"type": "subtitle", "time": 2344.23, "timestamp": "00:39:04", "text": "釘打ち銃はどうやって入手するのですか？ 今、手に入れました。 ああ、しまった"}, {"type": "subtitle", "time": 2347.31, "timestamp": "00:39:07", "text": "。 たくさんの人がいる。"}, {"type": "subtitle", "time": 2351.51, "timestamp": "00:39:11", "text": "おい、聞いてくれよ。 さっき、やっとあの"}, {"type": "subtitle", "time": 2354.47, "timestamp": "00:39:14", "text": "クソみたいなものを修理したんだ。 わかったよ、兄弟。"}, {"type": "subtitle", "time": 2357.67, "timestamp": "00:39:17", "text": "彼女はあなたに興味がないだけよ。 心配しないで。"}, {"type": "subtitle", "time": 2360.15, "timestamp": "00:39:20", "text": "待って、私は何をしているの？ なぜ私は突進しているのだろうか"}, {"type": "subtitle", "time": 2366.63, "timestamp": "00:39:26", "text": "、じゃあ歩いて行くよ。 それが自業自得だ"}, {"type": "subtitle", "time": 2368.47, "timestamp": "00:39:28", "text": "。"}, {"type": "subtitle", "time": 2370.79, "timestamp": "00:39:30", "text": "ああ、もっと人が増えてる。ああ、"}, {"type": "subtitle", "time": 2373.829, "timestamp": "00:39:33", "text": "彼らが来る。 彼らが来る。   一体どういうことだよ"}, {"type": "subtitle", "time": 2376.23, "timestamp": "00:39:36", "text": "？"}, {"type": "subtitle", "time": 2380.109, "timestamp": "00:39:40", "text": "ああ、つまり、"}, {"type": "subtitle", "time": 2386.069, "timestamp": "00:39:46", "text": "撃った釘は最終的にすべて再び使えるということですね。 ええ、"}, {"type": "subtitle", "time": 2395.43, "timestamp": "00:39:55", "text": "猿の声が聞こえる。"}, {"type": "subtitle", "time": 2397.349, "timestamp": "00:39:57", "text": "ワンピース。"}]
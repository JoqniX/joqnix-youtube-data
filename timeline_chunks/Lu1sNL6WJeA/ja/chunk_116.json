[{"type": "subtitle", "time": 6967.87, "timestamp": "01:56:07", "text": "ノエルとのコラボは午後4時だったかな。すみません。夕方頃、ドラッグノエルとクラブがあって、ワンアームザクックをプレイした"}, {"type": "subtitle", "time": 6977.35, "timestamp": "01:56:17", "text": "。楽しい配信があって、"}, {"type": "subtitle", "time": 6980.51, "timestamp": "01:56:20", "text": "最後には"}, {"type": "subtitle", "time": 6983.39, "timestamp": "01:56:23", "text": "ポッドキャストみたいな"}, {"type": "subtitle", "time": 6986.149, "timestamp": "01:56:26", "text": "インタビュー、"}, {"type": "subtitle", "time": 6987.47, "timestamp": "01:56:27", "text": "えーと、"}, {"type": "subtitle", "time": 7014.55, "timestamp": "01:56:54", "text": "夜、夜早い時間に、えーと、えーと、"}]
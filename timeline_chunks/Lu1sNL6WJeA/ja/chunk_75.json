[{"type": "subtitle", "time": 4502.149, "timestamp": "01:15:02", "text": "それはやりすぎでしょう。 でも、それでも"}, {"type": "subtitle", "time": 4506.47, "timestamp": "01:15:06", "text": "今日は楽しかったよ。 それでは、"}, {"type": "subtitle", "time": 4512.27, "timestamp": "01:15:12", "text": "本日はこれで終わりにします。 君たちも楽しんで、撫でてあげて"}, {"type": "subtitle", "time": 4516.95, "timestamp": "01:15:16", "text": "。 というわけで、ここで終了とします"}, {"type": "subtitle", "time": 4526.43, "timestamp": "01:15:26", "text": "こんにちは"}, {"type": "subtitle", "time": 4528.79, "timestamp": "01:15:28", "text": "。 お越しいただきありがとうございます。 待って。"}, {"type": "subtitle", "time": 4531.31, "timestamp": "01:15:31", "text": "アルスが配信してたと思うんだけど、"}, {"type": "subtitle", "time": 4534.39, "timestamp": "01:15:34", "text": "そうだよね？ アルスがまだ"}, {"type": "subtitle", "time": 4549.83, "timestamp": "01:15:49", "text": "？ 彼がそうだと思うか、そうでないと思うか。 わからない"}, {"type": "subtitle", "time": 4552.03, "timestamp": "01:15:52", "text": "。 ストリームを読み込んでいます。 まあ、"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "とにかく、来てくれてありがとう。 クロノス、"}, {"type": "subtitle", "time": 4556.149, "timestamp": "01:15:56", "text": "来てくれてありがとう。 ニンジャさん、"}, {"type": "subtitle", "time": 4558.95, "timestamp": "01:15:58", "text": "来てくれてありがとう。 ブラックウルフさん、お越しいただきありがとうございます"}]
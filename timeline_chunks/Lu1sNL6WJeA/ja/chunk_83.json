[{"type": "subtitle", "time": 4983.03, "timestamp": "01:23:03", "text": "Twitch以外の配信を楽しんでいますか？ ともあれ"}, {"type": "subtitle", "time": 4985.35, "timestamp": "01:23:05", "text": "、そろそろ締めくくりたいと思います。 さあ、"}, {"type": "subtitle", "time": 4992.55, "timestamp": "01:23:12", "text": "VectorとRocoの動画を視聴して応援することを忘れないでくださいね。"}, {"type": "subtitle", "time": 4994.229, "timestamp": "01:23:14", "text": "YouTubeで視聴する場合は、"}, {"type": "subtitle", "time": 4996.31, "timestamp": "01:23:16", "text": "Vチャンネルに行くことをお勧めします。Twitchで視聴する場合は、"}, {"type": "subtitle", "time": 4999.35, "timestamp": "01:23:19", "text": "Rocoチャンネルに行くことをお勧めします。"}, {"type": "subtitle", "time": 5002.55, "timestamp": "01:23:22", "text": "皆さんをTwitchのRoに送ります。"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "もし私がYouTubeみたいなものを持っていて、それを"}, {"type": "subtitle", "time": 5011.189, "timestamp": "01:23:31", "text": "皆さんに送ったり、大きなストリームを送ったりできたら"}, {"type": "subtitle", "time": 5013.99, "timestamp": "01:23:33", "text": "いいのにと思うのですが、私はそれを持っていません。 でも"}, {"type": "subtitle", "time": 5016.629, "timestamp": "01:23:36", "text": "大丈夫だよ。 でも、皆さん本当にありがとうございました。 私は"}, {"type": "subtitle", "time": 5018.95, "timestamp": "01:23:38", "text": "全員の名前を呼びました。"}, {"type": "subtitle", "time": 5022.11, "timestamp": "01:23:42", "text": "施錠してくださった方々にも感謝申し上げます"}, {"type": "subtitle", "time": 5024.95, "timestamp": "01:23:44", "text": "。 本日はありがとうございました。 本当に"}, {"type": "subtitle", "time": 5027.669, "timestamp": "01:23:47", "text": "素晴らしい一日でした。 皆さんと一緒に過ごせて楽しかったです"}, {"type": "subtitle", "time": 5030.07, "timestamp": "01:23:50", "text": "。 あなたも楽しんでいただけたなら幸いです"}, {"type": "subtitle", "time": 5032.47, "timestamp": "01:23:52", "text": "。 ご視聴ありがとうございました。 本当に感謝しています"}]
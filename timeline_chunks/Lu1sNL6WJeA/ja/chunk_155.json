[{"type": "subtitle", "time": 9300.15, "timestamp": "02:35:00", "text": "。これはまさにスターウォーズのストーム"}, {"type": "subtitle", "time": 9304.95, "timestamp": "02:35:04", "text": "トルーパーがお互いに撃ち合っている。なんてこった。ああ。ああ。ああ"}, {"type": "subtitle", "time": 9321.349, "timestamp": "02:35:21", "text": "待って。実際に君に当たった。そうだ、当たった"}, {"type": "subtitle", "time": 9324.23, "timestamp": "02:35:24", "text": "。"}, {"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "戻ってこい。戻ってこい。戻ってこい。ああ、"}, {"type": "subtitle", "time": 9327.15, "timestamp": "02:35:27", "text": "この"}, {"type": "subtitle", "time": 9342.71, "timestamp": "02:35:42", "text": "ああ、どこにいるの？どこにいるの？ああ"}, {"type": "subtitle", "time": 9348.75, "timestamp": "02:35:48", "text": "。戻ってきて"}]
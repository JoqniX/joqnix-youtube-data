[{"type": "subtitle", "time": 9671.11, "timestamp": "02:41:11", "text": "行こう。 ああ、だめだ。ナイスショット。ナイスショット。ナイス"}, {"type": "subtitle", "time": 9673.03, "timestamp": "02:41:13", "text": "ショット。"}, {"type": "subtitle", "time": 9681.71, "timestamp": "02:41:21", "text": "ものだ。 なんてこった。一体何なんだ？"}, {"type": "subtitle", "time": 9687.91, "timestamp": "02:41:27", "text": "ああ、待って。"}, {"type": "subtitle", "time": 9698.23, "timestamp": "02:41:38", "text": "これはヴァラーのガーディアンみたいだ。"}, {"type": "subtitle", "time": 9710.87, "timestamp": "02:41:50", "text": "おお、すごい。 いいね。"}]
[{"type": "subtitle", "time": 12302.389, "timestamp": "03:25:02", "text": "。 だから、本当にごめんなさい。 なぜ？"}, {"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "うん。 はぁ？ 例えば、"}, {"type": "subtitle", "time": 12307.349, "timestamp": "03:25:07", "text": "7つのシェルがある場合、ランダムに「"}, {"type": "subtitle", "time": 12309.269, "timestamp": "03:25:09", "text": "4番目のシェルは生きている」"}, {"type": "subtitle", "time": 12311.59, "timestamp": "03:25:11", "text": "とか「4番目のシェルは空いている」とか「"}, {"type": "subtitle", "time": 12313.309, "timestamp": "03:25:13", "text": "5番目のシェルは生きている」などと教えてくれます。 そんな感じですね"}, {"type": "subtitle", "time": 12315.99, "timestamp": "03:25:15", "text": "。 待てよ、もう俺の勝ちだ。 全部で"}, {"type": "subtitle", "time": 12318.55, "timestamp": "03:25:18", "text": "3ラウンドあるはずだ。"}, {"type": "subtitle", "time": 12321.269, "timestamp": "03:25:21", "text": "ああ、私たちは2番目です。 うん。   よし、これでいい"}, {"type": "subtitle", "time": 12328.429, "timestamp": "03:25:28", "text": "ああ、音楽が"}, {"type": "subtitle", "time": 12330.87, "timestamp": "03:25:30", "text": "変わった。 私はそれが好きです。 新しい"}, {"type": "subtitle", "time": 12337.99, "timestamp": "03:25:37", "text": "33."}, {"type": "subtitle", "time": 12341.67, "timestamp": "03:25:41", "text": "よし、次は君の番だ。"}, {"type": "subtitle", "time": 12344.07, "timestamp": "03:25:44", "text": "ボス、どうするつもりですか？"}, {"type": "subtitle", "time": 12347.03, "timestamp": "03:25:47", "text": "スキップするにはどうすればいいですか？ 順番を飛ばす。"}, {"type": "subtitle", "time": 12349.75, "timestamp": "03:25:49", "text": "自分の番を飛ばすことはできません。"}, {"type": "subtitle", "time": 12351.429, "timestamp": "03:25:51", "text": "ああ、大変だ。 まあ、"}, {"type": "subtitle", "time": 12359.91, "timestamp": "03:25:59", "text": "ああ、それはできますよ。"}]
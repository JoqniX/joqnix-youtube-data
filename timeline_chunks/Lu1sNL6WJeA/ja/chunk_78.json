[{"type": "subtitle", "time": 4680.55, "timestamp": "01:18:00", "text": "。"}, {"type": "subtitle", "time": 4684.75, "timestamp": "01:18:04", "text": "2月14日から3月まで。"}, {"type": "subtitle", "time": 4687.75, "timestamp": "01:18:07", "text": "待って、2月3月だ。 何？"}, {"type": "subtitle", "time": 4690.99, "timestamp": "01:18:10", "text": "3月14日。"}, {"type": "subtitle", "time": 4695.51, "timestamp": "01:18:15", "text": "3月14日は私にとって特別な日です。 限定"}, {"type": "subtitle", "time": 4699.43, "timestamp": "01:18:19", "text": "契約。 ええ、そうですね、そこで配信する必要があるんです"}, {"type": "subtitle", "time": 4702.31, "timestamp": "01:18:22", "text": "。 だから、しばらくの間、"}, {"type": "subtitle", "time": 4704.47, "timestamp": "01:18:24", "text": "YouTubeとTwitchで配信したりしなかったりすることになると思います。というのも、"}, {"type": "subtitle", "time": 4711.27, "timestamp": "01:18:31", "text": "Billy Billyではマルチストリーミングができないからです。YouTube"}, {"type": "subtitle", "time": 4717.99, "timestamp": "01:18:37", "text": "とTwitchで配信しているものをマルチストリーミングすると、Twitch"}, {"type": "subtitle", "time": 4720.79, "timestamp": "01:18:40", "text": "とYouTubeのチャットを検閲したり非表示にしたりする必要があるからです。"}, {"type": "subtitle", "time": 4722.95, "timestamp": "01:18:42", "text": "YouTubeのロゴや"}, {"type": "subtitle", "time": 4726.39, "timestamp": "01:18:46", "text": "Twitchのロゴは表示すべきではない。 アカウント停止されるだろう。"}, {"type": "subtitle", "time": 4729.03, "timestamp": "01:18:49", "text": "制約が多すぎる。"}, {"type": "subtitle", "time": 4733.83, "timestamp": "01:18:53", "text": "ゾンビゲームのような暴力的な"}, {"type": "subtitle", "time": 4736.87, "timestamp": "01:18:56", "text": "ゲームなど、特定のゲームはストリーミングできません。 非常に多くの制約がある。"}, {"type": "subtitle", "time": 4739.75, "timestamp": "01:18:59", "text": "そう、敬意を払わなきゃいけないし、その他もろもろ、すべてにおいてね"}]
[{"type": "subtitle", "time": 616.069, "timestamp": "00:10:16", "text": "ああ、あなたも参加したんですね。 さあ行こう。   ちょっと待ってください"}, {"type": "subtitle", "time": 618.949, "timestamp": "00:10:18", "text": "。 すべてをリセットしているような気分です"}, {"type": "subtitle", "time": 620.55, "timestamp": "00:10:20", "text": "。 私はもうゲームから完全に外れてしまったようなものだ"}, {"type": "subtitle", "time": 621.91, "timestamp": "00:10:21", "text": "。 ああ、それはあなただったんですね。 そうそう。 あなたが"}, {"type": "subtitle", "time": 622.99, "timestamp": "00:10:22", "text": "見えてます"}, {"type": "subtitle", "time": 628.47, "timestamp": "00:10:28", "text": "。 あなたも同じキャラクターを選んだんですね。   そうそう"}, {"type": "subtitle", "time": 630.87, "timestamp": "00:10:30", "text": "。"}, {"type": "subtitle", "time": 634.79, "timestamp": "00:10:34", "text": "ニース。 おや、これは何でしょう？"}, {"type": "subtitle", "time": 636.55, "timestamp": "00:10:36", "text": "ええ、味方からの誤射はありません。 これは"}, {"type": "subtitle", "time": 640.87, "timestamp": "00:10:40", "text": "武器ですか？ それは武器だ。 うん。"}, {"type": "subtitle", "time": 644.23, "timestamp": "00:10:44", "text": "炎の要素が付いているのがいいですね。 ああ、それで、"}, {"type": "subtitle", "time": 652.069, "timestamp": "00:10:52", "text": "いや、いや、いや。 なんで"}, {"type": "subtitle", "time": 656.389, "timestamp": "00:10:56", "text": "私の刃にこんな炎みたいなものが付いてるの？ うん、だってパイロは"}]
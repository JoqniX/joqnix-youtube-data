[{"type": "subtitle", "time": 1321.029, "timestamp": "00:22:01", "text": "ダイを手に入れたのですか。   ああ"}, {"type": "subtitle", "time": 1329.27, "timestamp": "00:22:09", "text": "おお、私も含まれているんですね。 ああ、彼は"}, {"type": "subtitle", "time": 1330.909, "timestamp": "00:22:10", "text": "死んだんだ。 どうでも。"}, {"type": "subtitle", "time": 1336.63, "timestamp": "00:22:16", "text": "こんにちは、ボンク。 ボンク。"}, {"type": "subtitle", "time": 1339.59, "timestamp": "00:22:19", "text": "君はできると思うのか？"}, {"type": "subtitle", "time": 1346.149, "timestamp": "00:22:26", "text": "ああ、くそ。  1秒だけ時間がある。 携帯"}, {"type": "subtitle", "time": 1353.149, "timestamp": "00:22:33", "text": "。 ここに来て"}, {"type": "subtitle", "time": 1357.31, "timestamp": "00:22:37", "text": "。 来て。 できるよ"}, {"type": "subtitle", "time": 1367.11, "timestamp": "00:22:47", "text": "[音楽]"}, {"type": "subtitle", "time": 1368.71, "timestamp": "00:22:48", "text": "オーケー。 えっと、ちょっと待ってください。 私は戻ってきます"}, {"type": "subtitle", "time": 1371.27, "timestamp": "00:22:51", "text": "。 君たちは探検していいよ。 心配しないで。"}, {"type": "subtitle", "time": 1373.83, "timestamp": "00:22:53", "text": "はい、わかりました。   元に戻ったら戻ってきます"}, {"type": "subtitle", "time": 1376.549, "timestamp": "00:22:56", "text": "。 ちょっと待ってください"}]
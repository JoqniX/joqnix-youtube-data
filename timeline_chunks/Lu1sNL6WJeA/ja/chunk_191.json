[{"type": "subtitle", "time": 11460.95, "timestamp": "03:11:00", "text": "あなたが[ __ ]と言ったという書面による証拠を手に入れました。"}, {"type": "subtitle", "time": 11466.87, "timestamp": "03:11:06", "text": "信じられますか？ 何？ ええ、彼は"}, {"type": "subtitle", "time": 11470.15, "timestamp": "03:11:10", "text": "誓いました。 彼は誓った。 みんな、入って。ああ、なんてことだ"}, {"type": "subtitle", "time": 11472.389, "timestamp": "03:11:12", "text": "。   もう完全に終わった"}, {"type": "subtitle", "time": 11475.67, "timestamp": "03:11:15", "text": "。 うん、すごくイライラしたよ。だって、本当は"}, {"type": "subtitle", "time": 11479.03, "timestamp": "03:11:19", "text": "君たちとゆっくり過ごしたかったんだ"}, {"type": "subtitle", "time": 11481.59, "timestamp": "03:11:21", "text": "けど、"}, {"type": "subtitle", "time": 11483.75, "timestamp": "03:11:23", "text": "時間通りに着きたかったんだもん。 私は時間通りに到着したのに、"}, {"type": "subtitle", "time": 11486.15, "timestamp": "03:11:26", "text": "こんなことが起こった。 それなら、まあいいか、と思いました"}, {"type": "subtitle", "time": 11489.51, "timestamp": "03:11:29", "text": "。 大丈夫。 単に"}, {"type": "subtitle", "time": 11491.269, "timestamp": "03:11:31", "text": "不運な状況だっただけだよ。 私にはどうすることもでき"}, {"type": "subtitle", "time": 11493.29, "timestamp": "03:11:33", "text": "ない。"}, {"type": "subtitle", "time": 11494.95, "timestamp": "03:11:34", "text": "[音楽]"}, {"type": "subtitle", "time": 11496.55, "timestamp": "03:11:36", "text": "ああ、少なくとも君は今ここにいるんだよ"}, {"type": "subtitle", "time": 11501.11, "timestamp": "03:11:41", "text": "。 ええ、ここにいますよ。 さあ行こう。 私は"}, {"type": "subtitle", "time": 11502.63, "timestamp": "03:11:42", "text": "幸せです。   さあ行こう"}, {"type": "subtitle", "time": 11508.07, "timestamp": "03:11:48", "text": "。 うん。 よし。 えっと、"}, {"type": "subtitle", "time": 11511.59, "timestamp": "03:11:51", "text": "12%完了しました。 ああ、たったの"}, {"type": "subtitle", "time": 11517.75, "timestamp": "03:11:57", "text": "8MB、いや58MBです。 ええ、大きくはないですよ。"}]
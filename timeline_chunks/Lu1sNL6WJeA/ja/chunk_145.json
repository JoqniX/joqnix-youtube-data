[{"type": "subtitle", "time": 8709.23, "timestamp": "02:25:09", "text": "。Steamの終了が刺された。"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "うん。かわいそうに。刺されたんだ。それに"}, {"type": "subtitle", "time": 8713.83, "timestamp": "02:25:13", "text": "両親が離婚するらしい。"}, {"type": "subtitle", "time": 8716.03, "timestamp": "02:25:16", "text": "彼はどこだ？"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "よし、ゲームを開く。あ、待って。"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "いや、ちょっと待って。まだだ。まだだ。うん、そうだと"}, {"type": "subtitle", "time": 8731.51, "timestamp": "02:25:31", "text": "思う。そうだったらいいんだけど。それで、"}, {"type": "subtitle", "time": 8734.07, "timestamp": "02:25:34", "text": "ゲームの内容は知ってるよね？"}, {"type": "subtitle", "time": 8738.23, "timestamp": "02:25:38", "text": "お互いに殺し合うゲームだってことは。うん。わかった"}, {"type": "subtitle", "time": 8741.95, "timestamp": "02:25:41", "text": "。"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "えっと、質問なんだけど、君は"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "僕を殺せると思う？"}, {"type": "subtitle", "time": 8751.91, "timestamp": "02:25:51", "text": "えっと、わからない。ああ、アン"}, {"type": "subtitle", "time": 8754.07, "timestamp": "02:25:54", "text": "インストールしたかもしれない。ああ、"}]
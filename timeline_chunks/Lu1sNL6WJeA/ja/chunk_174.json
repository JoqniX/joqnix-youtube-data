[{"type": "subtitle", "time": 10445.75, "timestamp": "02:54:05", "text": "銃はいくらでも持っていて構わない。"}, {"type": "subtitle", "time": 10449.269, "timestamp": "02:54:09", "text": "私はあなたを止めません。"}, {"type": "subtitle", "time": 10451.51, "timestamp": "02:54:11", "text": "2回連続ではない。  2回連続ではない。   そんなことは"}, {"type": "subtitle", "time": 10455.91, "timestamp": "02:54:15", "text": "起こらない。 ええと、どうしてそこに攻撃が当たらないんだろう"}, {"type": "subtitle", "time": 10459.55, "timestamp": "02:54:19", "text": "？ 何てことだ。 炎。"}, {"type": "subtitle", "time": 10462.07, "timestamp": "02:54:22", "text": "はい。 あ、待って。 あれを見てください。 実は、私も"}, {"type": "subtitle", "time": 10464.23, "timestamp": "02:54:24", "text": "あそこに行きたいんです。 そこには何か"}, {"type": "subtitle", "time": 10476.23, "timestamp": "02:54:36", "text": "こんにちは。 こんにちは。   わかった"}, {"type": "subtitle", "time": 10477.349, "timestamp": "02:54:37", "text": "、あのね？ 持続する。 持続する。"}, {"type": "subtitle", "time": 10480.469, "timestamp": "02:54:40", "text": "持続する。 持続する。 持続する。 これは私が取って、"}, {"type": "subtitle", "time": 10482.87, "timestamp": "02:54:42", "text": "それからスコープなしの"}, {"type": "subtitle", "time": 10486.67, "timestamp": "02:54:46", "text": "戦闘をしよう。 うん。 どこにいるの"}, {"type": "subtitle", "time": 10490.55, "timestamp": "02:54:50", "text": "？ わあ、すごい。"}, {"type": "subtitle", "time": 10492.55, "timestamp": "02:54:52", "text": "カウントダウン。 まあ、仕方ない、"}, {"type": "subtitle", "time": 10494.309, "timestamp": "02:54:54", "text": "今こうするしかないか。 あ、待って。 待って。"}, {"type": "subtitle", "time": 10496.63, "timestamp": "02:54:56", "text": "カウントダウンを始めましょう。 きちんとやりましょう。 真ん中に"}, {"type": "subtitle", "time": 10499.349, "timestamp": "02:54:59", "text": "武器を置いてあげよう"}]
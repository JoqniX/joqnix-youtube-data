[{"type": "subtitle", "time": 11345.19, "timestamp": "03:09:05", "text": "2021年に刻印されています。バックショットはいつ発売されましたか？  2024年。昨年。"}, {"type": "subtitle", "time": 11348.269, "timestamp": "03:09:08", "text": "うん。"}, {"type": "subtitle", "time": 11351.11, "timestamp": "03:09:11", "text": "ああ、実は遊べるゲームがたくさんあるんですよ"}, {"type": "subtitle", "time": 11352.87, "timestamp": "03:09:12", "text": "。"}, {"type": "subtitle", "time": 11355.59, "timestamp": "03:09:15", "text": "ゲームを買ってほしいの？"}, {"type": "subtitle", "time": 11359.75, "timestamp": "03:09:19", "text": "レンズを持っていると思います。 はい、もう一度確認させてください。   いくらかかりますか"}, {"type": "subtitle", "time": 11361.19, "timestamp": "03:09:21", "text": "？"}, {"type": "subtitle", "time": 11363.429, "timestamp": "03:09:23", "text": "もしあなたが"}, {"type": "subtitle", "time": 11367.03, "timestamp": "03:09:27", "text": "それを買いたくないなら、いつでも「レポ」をプレイできますよ。 ああ、大丈夫です。"}, {"type": "subtitle", "time": 11370.309, "timestamp": "03:09:30", "text": "両方とも持っておくこともできますよ。"}, {"type": "subtitle", "time": 11371.67, "timestamp": "03:09:31", "text": "でも、あなたに"}, {"type": "subtitle", "time": 11385.83, "timestamp": "03:09:45", "text": "私は800ルピー持っています。"}, {"type": "subtitle", "time": 11388.63, "timestamp": "03:09:48", "text": "ああ、なんてことだ、君は金持ちなんだね。 あなたも私に"}, {"type": "subtitle", "time": 11391.19, "timestamp": "03:09:51", "text": "アイスクリームを買ってください。 アイスクリーム？"}, {"type": "subtitle", "time": 11393.349, "timestamp": "03:09:53", "text": "アイスクリームを作ってあげるよ。"}, {"type": "subtitle", "time": 11396.15, "timestamp": "03:09:56", "text": "ああ、ありがとうございます。 もちろん。 うん、"}, {"type": "subtitle", "time": 11398.87, "timestamp": "03:09:58", "text": "アイスクリームプリンを作ってあげるよ。"}]
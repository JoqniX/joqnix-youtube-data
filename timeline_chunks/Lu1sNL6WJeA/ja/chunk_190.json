[{"type": "subtitle", "time": 11401.11, "timestamp": "03:10:01", "text": "ああ、しまった。 待って、どうやってその方法を知っているの？"}, {"type": "subtitle", "time": 11403.429, "timestamp": "03:10:03", "text": "本当に？ いいえ、母が作ります。 だから、私は"}, {"type": "subtitle", "time": 11405.91, "timestamp": "03:10:05", "text": "あなたと一緒に料理をするんです。 ああ、彼女に直接聞いてみればいいよ。   わかった"}, {"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "。 ところで、料理の"}, {"type": "subtitle", "time": 11411.269, "timestamp": "03:10:11", "text": "調子はどうですか？ 例えば、"}, {"type": "subtitle", "time": 11413.83, "timestamp": "03:10:13", "text": "料理の仕方を覚えた？ ええ、そうですね。 それがやらなきゃいけないことだって忘れてた"}, {"type": "subtitle", "time": 11416.23, "timestamp": "03:10:16", "text": "。   よし"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "。 私は学ばなければならない。 はい。"}, {"type": "subtitle", "time": 11422.67, "timestamp": "03:10:22", "text": "さあ、学んでみろよ。"}, {"type": "subtitle", "time": 11424.63, "timestamp": "03:10:24", "text": "[音楽]"}, {"type": "subtitle", "time": 11426.55, "timestamp": "03:10:26", "text": "私はごく基本的な料理の仕方は知っています"}, {"type": "subtitle", "time": 11429.51, "timestamp": "03:10:29", "text": "。   わかった"}, {"type": "subtitle", "time": 11430.87, "timestamp": "03:10:30", "text": "。 じゃあ、逮捕時の顔写真が撮られるってこと"}, {"type": "subtitle", "time": 11440.15, "timestamp": "03:10:40", "text": "。 実は、『バックショット』の音楽が大好きなんです"}, {"type": "subtitle", "time": 11442.309, "timestamp": "03:10:42", "text": "。   それは"}, {"type": "subtitle", "time": 11444.79, "timestamp": "03:10:44", "text": "とても、どう表現すればいいのか分かりません"}, {"type": "subtitle", "time": 11447.07, "timestamp": "03:10:47", "text": "。 ただただ"}, {"type": "subtitle", "time": 11450.82, "timestamp": "03:10:50", "text": "良いんです。 かなり良い。"}, {"type": "subtitle", "time": 11452.07, "timestamp": "03:10:52", "text": "[音楽]"}, {"type": "subtitle", "time": 11454.429, "timestamp": "03:10:54", "text": "ああ、そうだ。 ところで、ついに、えーっと、えーっと、"}]
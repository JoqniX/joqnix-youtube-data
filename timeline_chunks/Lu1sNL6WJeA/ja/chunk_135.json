[{"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "最後のプレイヤーが残る。あるいは、"}, {"type": "subtitle", "time": 8112.99, "timestamp": "02:15:12", "text": "これを受け取れ。後ろだ。後ろ"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "と前だ。"}, {"type": "subtitle", "time": 8119.83, "timestamp": "02:15:19", "text": "空っぽだ。大丈夫だ。"}, {"type": "subtitle", "time": 8125.27, "timestamp": "02:15:25", "text": "大変だった。彼を覗き込んだけど、"}, {"type": "subtitle", "time": 8127.83, "timestamp": "02:15:27", "text": "ゲームがフリーズして何もできなかった。"}, {"type": "subtitle", "time": 8130.39, "timestamp": "02:15:30", "text": "とても悲しい。"}, {"type": "subtitle", "time": 8143.229, "timestamp": "02:15:43", "text": "ゲームの神様が話してるよ。みんな"}, {"type": "subtitle", "time": 8147.189, "timestamp": "02:15:47", "text": "静かに、ゲームの神様が話してる。"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "ゲームの神様。"}, {"type": "subtitle", "time": 8152.47, "timestamp": "02:15:52", "text": "オーケー。今までで一番好きなゲームは何？"}, {"type": "subtitle", "time": 8155.35, "timestamp": "02:15:55", "text": "一番好きなゲーム？うーん、それは難しい"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "質問だね。"}]
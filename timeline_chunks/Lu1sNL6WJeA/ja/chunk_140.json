[{"type": "subtitle", "time": 8405.11, "timestamp": "02:20:05", "text": "[拍手]"}, {"type": "subtitle", "time": 8407.27, "timestamp": "02:20:07", "text": "Bにスパイク。降参すべきだったかもしれない"}, {"type": "subtitle", "time": 8415.429, "timestamp": "02:20:15", "text": "いや、いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 8416.87, "timestamp": "02:20:16", "text": "よし、わかった。うん、私たちは"}, {"type": "subtitle", "time": 8419.27, "timestamp": "02:20:19", "text": "ここから戻ってくる。必ずここから戻ってくる。"}, {"type": "subtitle", "time": 8427.11, "timestamp": "02:20:27", "text": "敵はあと1人。ナイス。ナイスショット。"}, {"type": "subtitle", "time": 8436.79, "timestamp": "02:20:36", "text": "最後のプレイヤーが立っている。スパイクを手に入れた。"}, {"type": "subtitle", "time": 8439.75, "timestamp": "02:20:39", "text": "彼は私たちのスポーンにいる。"}, {"type": "subtitle", "time": 8442.15, "timestamp": "02:20:42", "text": "よし。うん、ただ植えて戻ればいい"}, {"type": "subtitle", "time": 8443.75, "timestamp": "02:20:43", "text": "。彼は君が"}, {"type": "subtitle", "time": 8446.63, "timestamp": "02:20:46", "text": "そこにいるとは思っていないと思う。"}, {"type": "subtitle", "time": 8451.27, "timestamp": "02:20:51", "text": "メインに戻れ。メイン。メイン。"}]
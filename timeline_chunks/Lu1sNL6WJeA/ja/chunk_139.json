[{"type": "subtitle", "time": 8348.309, "timestamp": "02:19:08", "text": "あなたと私です。"}, {"type": "subtitle", "time": 8350.469, "timestamp": "02:19:10", "text": "ああ、なるほど。何が起こったか見ましたか？"}, {"type": "subtitle", "time": 8353.429, "timestamp": "02:19:13", "text": "ええ、彼はあなたをワンタップしました。ああ、"}, {"type": "subtitle", "time": 8356.79, "timestamp": "02:19:16", "text": "そうではなく、私が彼を撃ったのですが、 すると"}, {"type": "subtitle", "time": 8359.99, "timestamp": "02:19:19", "text": "ゲームがフリーズした。よくあることだ。"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "このゲーム中ずっとこうなんだ。"}, {"type": "subtitle", "time": 8365.349, "timestamp": "02:19:25", "text": "理由はわからない。ああ、他のプレイヤーが来るときか。"}, {"type": "subtitle", "time": 8367.91, "timestamp": "02:19:27", "text": "うん。うん。画面に映ると"}, {"type": "subtitle", "time": 8376.669, "timestamp": "02:19:36", "text": "とても"}, {"type": "subtitle", "time": 8392.429, "timestamp": "02:19:52", "text": "ああ、彼らはいつもミッドに来る。"}, {"type": "subtitle", "time": 8394.63, "timestamp": "02:19:54", "text": "ああ、彼らは"}]
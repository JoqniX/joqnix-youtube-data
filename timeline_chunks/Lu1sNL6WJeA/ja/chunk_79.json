[{"type": "subtitle", "time": 4741.55, "timestamp": "01:19:01", "text": "。 たくさんの"}, {"type": "subtitle", "time": 4745.27, "timestamp": "01:19:05", "text": "物。 うん。 では、明日、ビリービリーのストリーミングがどうなるかテストしてみます"}, {"type": "subtitle", "time": 4750.149, "timestamp": "01:19:10", "text": "。 告知とかを載せておきますね"}, {"type": "subtitle", "time": 4753.189, "timestamp": "01:19:13", "text": "。 私は"}, {"type": "subtitle", "time": 4756.11, "timestamp": "01:19:16", "text": "バレンタインデーのお祝いツイートをしていません。 だから、"}, {"type": "subtitle", "time": 4760.229, "timestamp": "01:19:20", "text": "PNGとか"}, {"type": "subtitle", "time": 4763.87, "timestamp": "01:19:23", "text": "Twitterとか、みんながどこにでもいるようなことをやります。"}, {"type": "subtitle", "time": 4770.669, "timestamp": "01:19:30", "text": "今日は4つのストリームを配信します。"}, {"type": "subtitle", "time": 4773.99, "timestamp": "01:19:33", "text": "うん。  5回配信したかったんだけど、"}, {"type": "subtitle", "time": 4776.47, "timestamp": "01:19:36", "text": "うん、すごく疲れた。"}, {"type": "subtitle", "time": 4779.03, "timestamp": "01:19:39", "text": "今日は睡眠不足だったと思う。   だから、"}, {"type": "subtitle", "time": 4782.75, "timestamp": "01:19:42", "text": "これら4つのストリームはある意味で"}, {"type": "subtitle", "time": 4787.43, "timestamp": "01:19:47", "text": "12時間に相当するのです。 そして、"}, {"type": "subtitle", "time": 4789.59, "timestamp": "01:19:49", "text": "見ればわかるように、大したことではないのですが、それでも、"}, {"type": "subtitle", "time": 4793.03, "timestamp": "01:19:53", "text": "12 時間配信したような、"}, {"type": "subtitle", "time": 4799.87, "timestamp": "01:19:59", "text": "12 時間配信した時と同じような疲労感を感じます"}]
[{"type": "subtitle", "time": 900.069, "timestamp": "00:15:00", "text": "ゲーム内で私の声とヴィックの声、どっちが聞こえる？ ヴィックだよ、ヴィックだ。 うん。"}, {"type": "subtitle", "time": 903.189, "timestamp": "00:15:03", "text": "うん。 ああ、彼は電源を切る必要がある。"}, {"type": "subtitle", "time": 904.79, "timestamp": "00:15:04", "text": "何？ わかった。 私たちはどこへ行けばいいのでしょうか？"}, {"type": "subtitle", "time": 906.87, "timestamp": "00:15:06", "text": "ところで、"}, {"type": "subtitle", "time": 909.069, "timestamp": "00:15:09", "text": "どれですか？ 君は"}, {"type": "subtitle", "time": 912.15, "timestamp": "00:15:12", "text": "クエストをこなすんだと思うよ。 ああ、これでもくらえ。 ここに来て"}, {"type": "subtitle", "time": 922.87, "timestamp": "00:15:22", "text": "ああ、くそ。 あと2つやらなければならない。 ああ、わかりました"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "。 ニース。 実際にはもう1つあります。 そうそう。"}, {"type": "subtitle", "time": 929.269, "timestamp": "00:15:29", "text": "うん。 わかった。"}, {"type": "subtitle", "time": 931.91, "timestamp": "00:15:31", "text": "うん。 私たちはモンスターを倒しに行くんだ。"}, {"type": "subtitle", "time": 937.43, "timestamp": "00:15:37", "text": "これからもっとたくさんのモンスターを倒していくぞ。 わかった。"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "我々は彼らを食い止めなければならない。 彼らがやってくる"}, {"type": "subtitle", "time": 948.47, "timestamp": "00:15:48", "text": "ああ、彼らを拘束する必要がある。 ああ、必ず"}, {"type": "subtitle", "time": 950.15, "timestamp": "00:15:50", "text": "打ち勝つさ。 彼らを打ち負かそう。"}, {"type": "subtitle", "time": 954.71, "timestamp": "00:15:54", "text": "銃は持っていますか？ いいえ。わかりました、気にしないでください。 私は"}, {"type": "subtitle", "time": 958.55, "timestamp": "00:15:58", "text": "彼らを蹴り飛ばせる。 それなら蹴飛ばしてやるよ。"}]
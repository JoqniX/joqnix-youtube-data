[{"type": "subtitle", "time": 9482.469, "timestamp": "02:38:02", "text": "。いいね。ヘッド"}, {"type": "subtitle", "time": 9485.99, "timestamp": "02:38:05", "text": "ショットじゃなかったけど、まあいいや、受け取ろう。"}, {"type": "subtitle", "time": 9488.469, "timestamp": "02:38:08", "text": "ああ、SMGを持っていたんだね。わかった。わかった。"}, {"type": "subtitle", "time": 9491.11, "timestamp": "02:38:11", "text": "ストリーマーみたいなケソを持ってるんだね。なんで"}, {"type": "subtitle", "time": 9494.63, "timestamp": "02:38:14", "text": "そう呼ばれてるのか知らないけど。"}, {"type": "subtitle", "time": 9498.79, "timestamp": "02:38:18", "text": "なぜかカニエっていう銃を持ってるんだ。"}, {"type": "subtitle", "time": 9500.389, "timestamp": "02:38:20", "text": "君も持ってる？君も持ってるの？"}, {"type": "subtitle", "time": 9503.83, "timestamp": "02:38:23", "text": "いや、まだ。やめて。"}, {"type": "subtitle", "time": 9508.71, "timestamp": "02:38:28", "text": "ああ、地面を撃たなきゃいけないんだ、"}, {"type": "subtitle", "time": 9509.87, "timestamp": "02:38:29", "text": "君を撃っちゃいけない。"}, {"type": "subtitle", "time": 9512.07, "timestamp": "02:38:32", "text": "わかった。ああ、気にしないで。うん、"}, {"type": "subtitle", "time": 9514.95, "timestamp": "02:38:34", "text": "これを受け取って。離れてたらどう？"}, {"type": "subtitle", "time": 9517.15, "timestamp": "02:38:37", "text": "カニエを持ってるよ。さあ。"}, {"type": "subtitle", "time": 9519.99, "timestamp": "02:38:39", "text": "これは？うん、これはそうだ。"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "こんにちは、カンタレッラ。ようこそ。ようこそ。"}, {"type": "subtitle", "time": 9524.07, "timestamp": "02:38:44", "text": "もうヴァレラントじゃないよ。"}, {"type": "subtitle", "time": 9529.309, "timestamp": "02:38:49", "text": "騙されたんだ。ああ、"}, {"type": "subtitle", "time": 9533.03, "timestamp": "02:38:53", "text": "神様。二丁持ちできる？ いや、できない。"}]
[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "。 どこ？ あ、ありがとう。"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "おやつがあります。 くそ。 でも、私はそれらを拾うことはできません"}, {"type": "subtitle", "time": 847.91, "timestamp": "00:14:07", "text": "。 お会いできて嬉しいです。 これは誰のサーバーですか"}, {"type": "subtitle", "time": 850.15, "timestamp": "00:14:10", "text": "？"}, {"type": "subtitle", "time": 853.43, "timestamp": "00:14:13", "text": "ああ、イエス様。 私たちはもう終わりだと思った。 私も拾えない"}, {"type": "subtitle", "time": 855.03, "timestamp": "00:14:15", "text": "。 一体どういうことだ"}, {"type": "subtitle", "time": 857.269, "timestamp": "00:14:17", "text": "？ ああ、"}, {"type": "subtitle", "time": 860.79, "timestamp": "00:14:20", "text": "クエストを始めなきゃ。 おお。 えっと。 あ、待って、待って、待って、"}, {"type": "subtitle", "time": 863.59, "timestamp": "00:14:23", "text": "待って。 うん、うん、うん。 わかった。 わかった。"}, {"type": "subtitle", "time": 865.67, "timestamp": "00:14:25", "text": "うん。 うん。 わかった。 さあ、すべてに触ってみて。"}, {"type": "subtitle", "time": 868.069, "timestamp": "00:14:28", "text": "うん。 ちょっと待ってください。 私がやります"}, {"type": "subtitle", "time": 876.629, "timestamp": "00:14:36", "text": "バレンタインデーにフェンシングをするんですね、"}, {"type": "subtitle", "time": 879.75, "timestamp": "00:14:39", "text": "皆さん。 さあ行こう。 バレンタインデーのフェンシング。 私たちは"}, {"type": "subtitle", "time": 884.629, "timestamp": "00:14:44", "text": "バレンタインデーに向けてフェンスを張っています。 ええ、もちろんです。"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "ゲームオプションのサーバーでミュートするにはどうすればいいですか？オンラインでvureをオフにするにはどうすればいいですか？"}, {"type": "subtitle", "time": 897.43, "timestamp": "00:14:57", "text": "危なかった。 待って、"}]
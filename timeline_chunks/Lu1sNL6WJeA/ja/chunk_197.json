[{"type": "subtitle", "time": 11823.469, "timestamp": "03:17:03", "text": "。 来て"}, {"type": "subtitle", "time": 11826.309, "timestamp": "03:17:06", "text": "。 乗る。 待って。 持続する。"}, {"type": "subtitle", "time": 11827.83, "timestamp": "03:17:07", "text": "ダウンロード中ですか？ はい、ダウンロード中です。"}, {"type": "subtitle", "time": 11829.91, "timestamp": "03:17:09", "text": "ダウンロード中です。 ちょうど今。"}, {"type": "subtitle", "time": 11832.95, "timestamp": "03:17:12", "text": "あなたが「乗れ」と言った瞬間、それはもう終わりです。   さあ行こう"}, {"type": "subtitle", "time": 11840.15, "timestamp": "03:17:20", "text": "あなたを招待します。 なんてこった。 待って。 えっと、今あなたにあげたと思うんだけど、あぁ、違う"}, {"type": "subtitle", "time": 11844.07, "timestamp": "03:17:24", "text": "。 招待してもいいですよね？ 招待できます"}, {"type": "subtitle", "time": 11846.389, "timestamp": "03:17:26", "text": "。 よし、これでいい。 受け入れる。 ご"}, {"type": "subtitle", "time": 11852.95, "timestamp": "03:17:32", "text": "ゲームのやり方は分かってるよね？"}, {"type": "subtitle", "time": 11868.11, "timestamp": "03:17:48", "text": "はぁ？ 私が教えてあげましょう。 それは問題ではありません"}, {"type": "subtitle", "time": 11872.71, "timestamp": "03:17:52", "text": "。 来て。 なぜそんなに奇妙なのか？ えっと、"}, {"type": "subtitle", "time": 11876.15, "timestamp": "03:17:56", "text": "待って。 画面は"}]
[{"type": "subtitle", "time": 7203.75, "timestamp": "02:00:03", "text": "ちょっとした癇癪を起こしたりしたんだ。"}, {"type": "subtitle", "time": 7205.109, "timestamp": "02:00:05", "text": "私が、ほら、"}, {"type": "subtitle", "time": 7207.03, "timestamp": "02:00:07", "text": "あの厳しい教授タイプじゃないことを喜ぶべきだよ。厳しい"}, {"type": "subtitle", "time": 7208.79, "timestamp": "02:00:08", "text": "教授タイプは、「ああ、なぜ"}, {"type": "subtitle", "time": 7211.03, "timestamp": "02:00:11", "text": "遅れたんだ？」みたいな感じだ。 あなたは5分遅刻しています。"}, {"type": "subtitle", "time": 7212.629, "timestamp": "02:00:12", "text": "5分前に来ていればよかったのに。  「"}, {"type": "subtitle", "time": 7215.03, "timestamp": "02:00:15", "text": "一体何なの？」って感じだったんだけど、実は私にもそういうことがあったの"}, {"type": "subtitle", "time": 7217.75, "timestamp": "02:00:17", "text": "。知ってた？ え、実はね。うん、うん"}, {"type": "subtitle", "time": 7219.31, "timestamp": "02:00:19", "text": "。"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "それで、授業に行ったんだけど、5"}, {"type": "subtitle", "time": 7225.31, "timestamp": "02:00:25", "text": "分遅刻しちゃったの。"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "ケイト、ちょっと説明させて。"}, {"type": "subtitle", "time": 7232.39, "timestamp": "02:00:32", "text": "授業に5分遅刻したら、"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "教授が私を見て、"}, {"type": "subtitle", "time": 7236.55, "timestamp": "02:00:36", "text": "「5分早く来るべきだよ」って言うの。それから、"}, {"type": "subtitle", "time": 7240.39, "timestamp": "02:00:40", "text": "5分早く来るべきだとか、"}, {"type": "subtitle", "time": 7242.47, "timestamp": "02:00:42", "text": "礼儀作法を守るべきだとか、10分間も延々と説教し始めたの。授業時間"}, {"type": "subtitle", "time": 7244.79, "timestamp": "02:00:44", "text": "全部を使って、その説教を延々と続けたのよ"}, {"type": "subtitle", "time": 7247.589, "timestamp": "02:00:47", "text": "。それからまた"}, {"type": "subtitle", "time": 7250.229, "timestamp": "02:00:50", "text": "10分間も説教して、"}, {"type": "subtitle", "time": 7253.43, "timestamp": "02:00:53", "text": "授業時間の25分くらいを無駄にしたの。シラバスを"}, {"type": "subtitle", "time": 7257.43, "timestamp": "02:00:57", "text": "終わらせる時間がほとんどないとか、"}]
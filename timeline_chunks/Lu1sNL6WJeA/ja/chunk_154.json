[{"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "？地雷に当たったと思う"}, {"type": "subtitle", "time": 9248.15, "timestamp": "02:34:08", "text": "。あんた、金玉に"}, {"type": "subtitle", "time": 9251.63, "timestamp": "02:34:11", "text": "置いたのか"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "？あんたはなんて狂人なんだ。"}, {"type": "subtitle", "time": 9262.71, "timestamp": "02:34:22", "text": "、あれはランダムなヘッドショットだった。"}, {"type": "subtitle", "time": 9265.99, "timestamp": "02:34:25", "text": "嘘はつかない。でもうまくいった"}, {"type": "subtitle", "time": 9269.03, "timestamp": "02:34:29", "text": "。嬉しい。"}, {"type": "subtitle", "time": 9275.07, "timestamp": "02:34:35", "text": "これは何だ？ああ、これはビームガンだ。ああ"}]
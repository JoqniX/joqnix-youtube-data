[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "ゲームに参加している。 俺はただこのデカい"}, {"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "奴を殺しているだけだ。 あ、待って。 待って。 彼は、そうですね、"}, {"type": "subtitle", "time": 425.11, "timestamp": "00:07:05", "text": "彼を何と呼ぶべきかは分かりません。"}, {"type": "subtitle", "time": 426.55, "timestamp": "00:07:06", "text": "ところで、"}, {"type": "subtitle", "time": 429.11, "timestamp": "00:07:09", "text": "これを完成させるにはどれくらい時間がかかるんですか？ ほんの数"}, {"type": "subtitle", "time": 432.07, "timestamp": "00:07:12", "text": "分です。 彼はただ走った。 そんなに"}, {"type": "subtitle", "time": 434.79, "timestamp": "00:07:14", "text": "長くはないよ。 心配しないで。 仕事。 読み終えました"}, {"type": "subtitle", "time": 436.35, "timestamp": "00:07:16", "text": "。"}, {"type": "subtitle", "time": 440.71, "timestamp": "00:07:20", "text": "船上で殺人を犯した後。 うん。 どれくらい"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "時間がかかるんだろう？ せいぜい"}, {"type": "subtitle", "time": 445.029, "timestamp": "00:07:25", "text": "10分くらいで終わるでしょう。"}, {"type": "subtitle", "time": 447.51, "timestamp": "00:07:27", "text": "10分。 それでおしまい。 わかった。 わかった。"}, {"type": "subtitle", "time": 459.51, "timestamp": "00:07:39", "text": "あなたの声はまだ聞こえています。 待って。 どうすればいいですか？ ああ、"}, {"type": "subtitle", "time": 478.79, "timestamp": "00:07:58", "text": "チャットで誰かが「サム・バレンタイン"}]
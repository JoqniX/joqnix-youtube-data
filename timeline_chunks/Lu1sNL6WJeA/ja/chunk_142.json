[{"type": "subtitle", "time": 8532.75, "timestamp": "02:22:12", "text": "よし、ミッドにたくさんいる。ああ、なんてことだ、"}, {"type": "subtitle", "time": 8535.91, "timestamp": "02:22:15", "text": "ケージを起動するべきだった。スパイクを手に入れた。"}, {"type": "subtitle", "time": 8544.469, "timestamp": "02:22:24", "text": "最後のプレイヤーが立っている。おい、"}, {"type": "subtitle", "time": 8552.55, "timestamp": "02:22:32", "text": "ああ、だめだ。"}, {"type": "subtitle", "time": 8563.59, "timestamp": "02:22:43", "text": "ああ、なんてことだ。あれは何だったんだ？なんてこった。2"}, {"type": "subtitle", "time": 8575.27, "timestamp": "02:22:55", "text": "あれはクリップだったんだ 今まで見たことないよ。"}]
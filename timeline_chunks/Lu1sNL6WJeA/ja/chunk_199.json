[{"type": "subtitle", "time": 11944.59, "timestamp": "03:19:04", "text": "。 この"}, {"type": "subtitle", "time": 11948.309, "timestamp": "03:19:08", "text": "ゲームでは、ランダムな組み合わせの空砲"}, {"type": "subtitle", "time": 11953.67, "timestamp": "03:19:13", "text": "と"}, {"type": "subtitle", "time": 11955.269, "timestamp": "03:19:15", "text": "実弾のシーケンスのようなものが手に入ります。 つまり、青い貝殻は何も"}, {"type": "subtitle", "time": 11958.95, "timestamp": "03:19:18", "text": "書かれていないということです。 赤いものは生きています。 わかった。 そして、"}, {"type": "subtitle", "time": 11960.71, "timestamp": "03:19:20", "text": "それらはランダムな順序でショットガンに装填される"}, {"type": "subtitle", "time": 11963.91, "timestamp": "03:19:23", "text": "。 そして、あなたは"}, {"type": "subtitle", "time": 11967.59, "timestamp": "03:19:27", "text": "自分を撃つか、目の前に座っている人を撃つかのどちらかを選択します"}, {"type": "subtitle", "time": 11969.59, "timestamp": "03:19:29", "text": "。 そして、"}, {"type": "subtitle", "time": 11974.349, "timestamp": "03:19:34", "text": "使えるアイテムもたくさん手に入ります。どのアイテムにもそれぞれ"}, {"type": "subtitle", "time": 11976.95, "timestamp": "03:19:36", "text": "目的があります。 タバコを吸うことで"}, {"type": "subtitle", "time": 11978.63, "timestamp": "03:19:38", "text": "健康になる人もいる。 彼らが何をしているのか聞いてくれれば、教えてあげますよ"}, {"type": "subtitle", "time": 11985.429, "timestamp": "03:19:45", "text": "それと、これで最後になるから、これで終わりにしよう。きっと"}, {"type": "subtitle", "time": 11987.67, "timestamp": "03:19:47", "text": "大丈夫だよ。 いいえ。ええ、"}, {"type": "subtitle", "time": 11989.75, "timestamp": "03:19:49", "text": "もちろん。 もちろん。 うん。  2回目の"}, {"type": "subtitle", "time": 11992.309, "timestamp": "03:19:52", "text": "コラボレーションが始まります。   わかった"}, {"type": "subtitle", "time": 11995.59, "timestamp": "03:19:55", "text": "。 何がもらえるの？"}, {"type": "subtitle", "time": 11998.07, "timestamp": "03:19:58", "text": "ボックスをクリックして、"}]
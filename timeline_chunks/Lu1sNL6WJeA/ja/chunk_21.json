[{"type": "subtitle", "time": 1261.27, "timestamp": "00:21:01", "text": "これはただの探索ミッションだから、"}, {"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "もっとゾンビを倒せるんだ。   わーい"}, {"type": "subtitle", "time": 1272.23, "timestamp": "00:21:12", "text": "私たちは一体どこへ行けばいいんだっけ？ ああ、"}, {"type": "subtitle", "time": 1275.27, "timestamp": "00:21:15", "text": "私はここにいます。 私はゾンビを倒している。   さあ行こう"}, {"type": "subtitle", "time": 1277.99, "timestamp": "00:21:17", "text": "。"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "私たちはどんな大騒ぎを起こしたの？ 私たちは文字通り"}, {"type": "subtitle", "time": 1287.11, "timestamp": "00:21:27", "text": "。 君たち、速いね。 一体どういうことだよ、"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "兄弟？ 銃が必要だ。"}, {"type": "subtitle", "time": 1293.029, "timestamp": "00:21:33", "text": "釘打ち機が必要なら持っていますよ。 どうやって"}, {"type": "subtitle", "time": 1304.56, "timestamp": "00:21:44", "text": "どうやって？ 誰かが私を殴った。 どうやって"}]
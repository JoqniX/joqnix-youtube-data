[{"type": "subtitle", "time": 10328.15, "timestamp": "02:52:08", "text": "あなたを待っています。 ああ、気にしないで。"}, {"type": "subtitle", "time": 10335.91, "timestamp": "02:52:15", "text": "神様。 古き良き硫黄の香りを漂わせながら、あなたをお待ちしています"}, {"type": "subtitle", "time": 10342.19, "timestamp": "02:52:22", "text": "。 私は陰鬱で血なまぐさい"}, {"type": "subtitle", "time": 10344.349, "timestamp": "02:52:24", "text": "寓話だ。 おいおい、勘弁してくれよ"}, {"type": "subtitle", "time": 10348.51, "timestamp": "02:52:28", "text": "。 そうじゃない。 何てことだ"}, {"type": "subtitle", "time": 10361.469, "timestamp": "02:52:41", "text": "どこにいるの"}, {"type": "subtitle", "time": 10368.91, "timestamp": "02:52:48", "text": "ジャックイ、さあ。 私と戦え"}]
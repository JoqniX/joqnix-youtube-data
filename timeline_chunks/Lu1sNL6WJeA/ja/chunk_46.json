[{"type": "subtitle", "time": 2761.829, "timestamp": "00:46:01", "text": "立ち去ろうとしているところだ。 彼はただ人を殺しているだけだ。"}, {"type": "subtitle", "time": 2765.109, "timestamp": "00:46:05", "text": "実際、大丈夫です。 ごく普通のスポーツマンの"}, {"type": "subtitle", "time": 2768.71, "timestamp": "00:46:08", "text": "行動だ。 ああ、典型的なスポーツマンの行動だね。"}, {"type": "subtitle", "time": 2774.15, "timestamp": "00:46:14", "text": "それは全く普通のことです。 一体何なんだ？"}, {"type": "subtitle", "time": 2775.15, "timestamp": "00:46:15", "text": "ああ、しまった"}, {"type": "subtitle", "time": 2777.99, "timestamp": "00:46:17", "text": "。 彼女はただ皆を殺しているだけだ。"}, {"type": "subtitle", "time": 2780.47, "timestamp": "00:46:20", "text": "一体何なんだ？"}, {"type": "subtitle", "time": 2781.75, "timestamp": "00:46:21", "text": "[拍手]"}, {"type": "subtitle", "time": 2783.91, "timestamp": "00:46:23", "text": "ああ、容器が爆発でもしたんですか"}, {"type": "subtitle", "time": 2785.349, "timestamp": "00:46:25", "text": "？ 何だって？ いや、違う。"}, {"type": "subtitle", "time": 2787.03, "timestamp": "00:46:27", "text": "火炎瓶を投げたんだ。"}, {"type": "subtitle", "time": 2788.75, "timestamp": "00:46:28", "text": "ああ、"}, {"type": "subtitle", "time": 2791.99, "timestamp": "00:46:31", "text": "火炎瓶だ。 それで、どうやって火炎瓶を手に入れたんだっけ"}, {"type": "subtitle", "time": 2809.23, "timestamp": "00:46:49", "text": "容器はあちらにありますか"}, {"type": "subtitle", "time": 2812.71, "timestamp": "00:46:52", "text": "？ そうそう。"}, {"type": "subtitle", "time": 2814.95, "timestamp": "00:46:54", "text": "何が起こっていますか？"}]
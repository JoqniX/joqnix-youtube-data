[{"type": "subtitle", "time": 1021.269, "timestamp": "00:17:01", "text": "ありがとう、トッド。"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "あ、すみません。 危なかった。"}, {"type": "subtitle", "time": 1026.87, "timestamp": "00:17:06", "text": "それは真実だ。 そうなってほしくなかったが、そうなっていたら"}, {"type": "subtitle", "time": 1028.549, "timestamp": "00:17:08", "text": "彼らは"}, {"type": "subtitle", "time": 1030.949, "timestamp": "00:17:10", "text": "我々を圧倒していただろう。 フェンスは機能していませんが"}, {"type": "subtitle", "time": 1032.23, "timestamp": "00:17:12", "text": "、橋についてはあなたの言う通りでした"}, {"type": "subtitle", "time": 1034.47, "timestamp": "00:17:14", "text": "。 我々はそれを台無しにする必要がある。"}, {"type": "subtitle", "time": 1038.789, "timestamp": "00:17:18", "text": "危険すぎる。 持って行け。"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "相棒。 これは何ですか？ 俺は今、銃を持っているんだ"}, {"type": "subtitle", "time": 1048.63, "timestamp": "00:17:28", "text": "。 さあ行こうぜ、"}, {"type": "subtitle", "time": 1068.15, "timestamp": "00:17:48", "text": "[拍手]"}, {"type": "subtitle", "time": 1076.95, "timestamp": "00:17:56", "text": "ああ、終わってしまった。 ああ、終わってしまった。 わかった。"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "死んだのかと思った。"}]
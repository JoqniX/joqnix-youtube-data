[{"type": "subtitle", "time": 9780.55, "timestamp": "02:43:00", "text": "。 後で反撃するよ。 どうでも。"}, {"type": "subtitle", "time": 9794.309, "timestamp": "02:43:14", "text": "ああ、しまった。 ニース。 ニース。 ニース。 クラッチが良かった。"}, {"type": "subtitle", "time": 9800.87, "timestamp": "02:43:20", "text": "クラッチが良かった。 おお。"}, {"type": "subtitle", "time": 9802.07, "timestamp": "02:43:22", "text": "どこ？ 武器はどこだ？"}, {"type": "subtitle", "time": 9803.91, "timestamp": "02:43:23", "text": "武器はどこだ？ 武器はどこだ？"}, {"type": "subtitle", "time": 9807.59, "timestamp": "02:43:27", "text": "あなたの目の前に。 ここ。 ここ。 私にはそうは見えません。 分から"}, {"type": "subtitle", "time": 9811.19, "timestamp": "02:43:31", "text": "ないの？ いいえ。わかりました。 わかった。"}, {"type": "subtitle", "time": 9813.429, "timestamp": "02:43:33", "text": "大丈夫。 わかりました。 私は"}, {"type": "subtitle", "time": 9818.15, "timestamp": "02:43:38", "text": "あなたを助けようとしていたのです。 大丈夫。 そうしてください。 おお。 おお。"}, {"type": "subtitle", "time": 9821.19, "timestamp": "02:43:41", "text": "待って。 ああ、大丈夫ですよ。 この"}, {"type": "subtitle", "time": 9824.23, "timestamp": "02:43:44", "text": "ラウンドは君の勝ちだ。 いいえ、大丈夫です。 来る。"}, {"type": "subtitle", "time": 9830.349, "timestamp": "02:43:50", "text": "狙撃手か"}]
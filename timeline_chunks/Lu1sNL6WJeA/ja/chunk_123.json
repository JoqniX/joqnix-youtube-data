[{"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "ないんだよ。"}, {"type": "subtitle", "time": 7386.87, "timestamp": "02:03:06", "text": "ああ、つまり"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "ゴールドの人はスマーフィングしてるか、ゲームが本当に下手かのどっちかなんだ。"}, {"type": "subtitle", "time": 7394.149, "timestamp": "02:03:14", "text": "たまに面白い人を見つけることもある"}, {"type": "subtitle", "time": 7396.07, "timestamp": "02:03:16", "text": "けど、それだけ。ゴールドから"}, {"type": "subtitle", "time": 7403.03, "timestamp": "02:03:23", "text": "ゴールドになるのもすごく難しいんだ。"}, {"type": "subtitle", "time": 7406.87, "timestamp": "02:03:26", "text": "シルバーもあるしね。うん。君は"}, {"type": "subtitle", "time": 7408.79, "timestamp": "02:03:28", "text": "このゲームをランクマッチでよくやってると思ってたよ。"}, {"type": "subtitle", "time": 7411.27, "timestamp": "02:03:31", "text": "そうじゃない？"}, {"type": "subtitle", "time": 7415.27, "timestamp": "02:03:35", "text": "試合でばったり会ったよね。確かに会ったと思う。"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "うん。1年くらい前にシルバーでランクマッチをやってた時に会ったんだ。"}, {"type": "subtitle", "time": 7421.109, "timestamp": "02:03:41", "text": "それで、"}, {"type": "subtitle", "time": 7424.55, "timestamp": "02:03:44", "text": "君はオンラインマッチでオフラインになったりしてたよね。ああ、そう"}, {"type": "subtitle", "time": 7428.55, "timestamp": "02:03:48", "text": "。うん。うん。騙すやつ。"}, {"type": "subtitle", "time": 7431.43, "timestamp": "02:03:51", "text": "君がそうして、僕は"}, {"type": "subtitle", "time": 7433.189, "timestamp": "02:03:53", "text": "君に会ったんだ。「何？」って感じだったよ。 ちょっと待って、"}, {"type": "subtitle", "time": 7435.109, "timestamp": "02:03:55", "text": "ジョックニック。」"}, {"type": "subtitle", "time": 7437.55, "timestamp": "02:03:57", "text": "そして、あなたもストリーミング配信していることに気づいた"}]
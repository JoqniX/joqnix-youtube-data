[{"type": "subtitle", "time": 4563.59, "timestamp": "01:16:03", "text": "。 スカリア判事、お越しいただきありがとうございます。 ハッシュさん、"}, {"type": "subtitle", "time": 4565.43, "timestamp": "01:16:05", "text": "来てくれてありがとう。 ええ、私は"}, {"type": "subtitle", "time": 4567.59, "timestamp": "01:16:07", "text": "彼らの名前を呼びました。 はい。 アディティさん、"}, {"type": "subtitle", "time": 4570.55, "timestamp": "01:16:10", "text": "来てくれてありがとう。 ドラゴナさん、来てくれてありがとう"}, {"type": "subtitle", "time": 4574.229, "timestamp": "01:16:14", "text": "。 ここまで来てくれてありがとう。"}, {"type": "subtitle", "time": 4577.189, "timestamp": "01:16:17", "text": "最後になりましたが、ロアシュさん、お越しいただきありがとうございました"}, {"type": "subtitle", "time": 4581.35, "timestamp": "01:16:21", "text": "。 来てくれてありがとう。"}, {"type": "subtitle", "time": 4588.79, "timestamp": "01:16:28", "text": "百花を締めくくります。 しばらくVexと"}, {"type": "subtitle", "time": 4590.87, "timestamp": "01:16:30", "text": "Rocoの配信を見てから、出かけます"}, {"type": "subtitle", "time": 4599.59, "timestamp": "01:16:39", "text": "疲れている。 今日の予定は？"}, {"type": "subtitle", "time": 4602.95, "timestamp": "01:16:42", "text": "今日の予定はこれで終わりです。"}, {"type": "subtitle", "time": 4605.99, "timestamp": "01:16:45", "text": "今日は4回配信しました。"}, {"type": "subtitle", "time": 4610.91, "timestamp": "01:16:50", "text": "配信、30分間の配信を行いました。 私たちは"}, {"type": "subtitle", "time": 4614.75, "timestamp": "01:16:54", "text": "Apexを3時間プレイしました。"}]
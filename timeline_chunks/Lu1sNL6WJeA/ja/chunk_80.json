[{"type": "subtitle", "time": 4802.31, "timestamp": "01:20:02", "text": "。 うん。 でも、ぐっすり"}, {"type": "subtitle", "time": 4805.63, "timestamp": "01:20:05", "text": "眠って、しっかり休養して、元気を取り戻したいです"}, {"type": "subtitle", "time": 4808.39, "timestamp": "01:20:08", "text": "。 うん。 というわけで、明日は"}, {"type": "subtitle", "time": 4815.31, "timestamp": "01:20:15", "text": "asoはありますが、おそらくYouTubeやTwitchでの配信はありません"}, {"type": "subtitle", "time": 4819.59, "timestamp": "01:20:19", "text": "。 いいえ、おそらく後で配信はしません。"}, {"type": "subtitle", "time": 4821.51, "timestamp": "01:20:21", "text": "ビリーの配信をする予定だからです。"}, {"type": "subtitle", "time": 4826.55, "timestamp": "01:20:26", "text": "そこに注意を払わなければならない。 でも、"}, {"type": "subtitle", "time": 4829.11, "timestamp": "01:20:29", "text": "ローカルで録画するので、"}, {"type": "subtitle", "time": 4833.11, "timestamp": "01:20:33", "text": "私のVODチャンネルでVODをご覧いただけます。 私が"}, {"type": "subtitle", "time": 4836.63, "timestamp": "01:20:36", "text": "配信を終了するのと全く同じタイミングで上がります。 はい、"}, {"type": "subtitle", "time": 4840.07, "timestamp": "01:20:40", "text": "すぐにアップロードします。 編集などは"}, {"type": "subtitle", "time": 4842.149, "timestamp": "01:20:42", "text": "一切していません。 つまり、もし私がそれを擦ったら、"}, {"type": "subtitle", "time": 4845.669, "timestamp": "01:20:45", "text": "その擦り傷が見えるということです。 ああ、怖い。"}, {"type": "subtitle", "time": 4848.229, "timestamp": "01:20:48", "text": "でも、皆さんも私を見てください。"}, {"type": "subtitle", "time": 4850.79, "timestamp": "01:20:50", "text": "明日までに全て準備しておきます。"}, {"type": "subtitle", "time": 4853.27, "timestamp": "01:20:53", "text": "うん、今日の配信が良かったらいいなと思ってたよ"}, {"type": "subtitle", "time": 4856.47, "timestamp": "01:20:56", "text": "。"}, {"type": "subtitle", "time": 4858.87, "timestamp": "01:20:58", "text": "時間があまりなかったので、急いで"}, {"type": "subtitle", "time": 4859.709, "timestamp": "01:20:59", "text": "プレイしました"}]
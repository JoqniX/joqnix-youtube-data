[{"type": "subtitle", "time": 10200.63, "timestamp": "02:50:00", "text": "うん。 待って、何が起こったの？ あなたは動いていない"}, {"type": "subtitle", "time": 10203.389, "timestamp": "02:50:03", "text": "。 ああ、君は"}, {"type": "subtitle", "time": 10207.269, "timestamp": "02:50:07", "text": "動かないんだね。 待って、攻撃を受けてる。 どうやって？"}, {"type": "subtitle", "time": 10208.87, "timestamp": "02:50:08", "text": "何？"}, {"type": "subtitle", "time": 10211.269, "timestamp": "02:50:11", "text": "何らかの不具合が発生したのだと思います。 わからない"}, {"type": "subtitle", "time": 10213.269, "timestamp": "02:50:13", "text": "。 おお。 あなたはもうここにはいない"}, {"type": "subtitle", "time": 10218.79, "timestamp": "02:50:18", "text": "。 何てことだ。 なぜ？ 私は、私は、あなたは"}, {"type": "subtitle", "time": 10220.389, "timestamp": "02:50:20", "text": "死んだが、戻ってこなかった。 なんてこった"}, {"type": "subtitle", "time": 10222.59, "timestamp": "02:50:22", "text": "？"}, {"type": "subtitle", "time": 10226.309, "timestamp": "02:50:26", "text": "はぁ？ これは何ですか？ どうしたの？"}, {"type": "subtitle", "time": 10227.83, "timestamp": "02:50:27", "text": "ゲームに不具合が起きたんだと思います。 持続する。"}, {"type": "subtitle", "time": 10234.23, "timestamp": "02:50:34", "text": "死ぬだろう。 私は死ぬだろう。 ちょっと待ってください。   ゆっくりしてください"}, {"type": "subtitle", "time": 10236.95, "timestamp": "02:50:36", "text": "。"}, {"type": "subtitle", "time": 10239.269, "timestamp": "02:50:39", "text": "はい、これでよし。  「ああ、あなたは今"}, {"type": "subtitle", "time": 10242.71, "timestamp": "02:50:42", "text": "ロビーを出たところです」と表示された。 なんてこった。 はい、わかりました"}, {"type": "subtitle", "time": 10244.63, "timestamp": "02:50:44", "text": "。 わかった。 うっかり"}, {"type": "subtitle", "time": 10246.63, "timestamp": "02:50:46", "text": "あなたを追い出してしまったようです。 ああ、新しいマップをたくさんアンロックしたよ"}, {"type": "subtitle", "time": 10249.91, "timestamp": "02:50:49", "text": "。 ニース。 地図がたくさんある。"}, {"type": "subtitle", "time": 10252.07, "timestamp": "02:50:52", "text": "このゲームにはたくさんのマップがあります。 だから"}, {"type": "subtitle", "time": 10254.23, "timestamp": "02:50:54", "text": "8GBなんです。 まるで膨大な"}, {"type": "subtitle", "time": 10256.469, "timestamp": "02:50:56", "text": "地図のコレクションのようだ。   ちょっと"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "待って、たった数秒で8GBもダウンロードしたの？"}]
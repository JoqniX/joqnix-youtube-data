[{"type": "subtitle", "time": 7682.35, "timestamp": "02:08:02", "text": "私もワンタップダウンして"}, {"type": "subtitle", "time": 7692.629, "timestamp": "02:08:12", "text": "どれくらい"}, {"type": "subtitle", "time": 7693.91, "timestamp": "02:08:13", "text": "このゲームをプレイしたの"}, {"type": "subtitle", "time": 7700.79, "timestamp": "02:08:20", "text": "？えーと、かなり最近プレイしたよ。"}, {"type": "subtitle", "time": 7703.75, "timestamp": "02:08:23", "text": "えーと、ジャスミンとね、ジャスミン知ってるでしょ"}, {"type": "subtitle", "time": 7705.669, "timestamp": "02:08:25", "text": "？私もジャスミン知ってると思う。うん。うん。うん"}, {"type": "subtitle", "time": 7708.069, "timestamp": "02:08:28", "text": "。投資。えーと、それはいつだったっけ"}, {"type": "subtitle", "time": 7711.43, "timestamp": "02:08:31", "text": "？先週か"}, {"type": "subtitle", "time": 7721.669, "timestamp": "02:08:41", "text": "、まあいいと思うけど、それでは"}, {"type": "subtitle", "time": 7723.589, "timestamp": "02:08:43", "text": "どうやって？"}, {"type": "subtitle", "time": 7725.83, "timestamp": "02:08:45", "text": "実際に同じキーバインドを使ったの？"}, {"type": "subtitle", "time": 7727.83, "timestamp": "02:08:47", "text": "うん。うん。うん。あの時は"}, {"type": "subtitle", "time": 7730.47, "timestamp": "02:08:50", "text": "全部開いてた。今は全部急いでる"}, {"type": "subtitle", "time": 7732.069, "timestamp": "02:08:52", "text": "。エイムボードとか全部"}, {"type": "subtitle", "time": 7733.99, "timestamp": "02:08:53", "text": "。"}, {"type": "subtitle", "time": 7737.109, "timestamp": "02:08:57", "text": "何？まさか。"}]
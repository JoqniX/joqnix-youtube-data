[{"type": "subtitle", "time": 3124.15, "timestamp": "00:52:04", "text": "大騒ぎだ。 それは何ですか？  Ch. しないでください。 おお。 おお。 おお。"}, {"type": "subtitle", "time": 3127.27, "timestamp": "00:52:07", "text": "おお。 おお。 おお。 ここ出身ではない。 あ、待って。 できるだろうか"}, {"type": "subtitle", "time": 3128.99, "timestamp": "00:52:08", "text": "？ できると思うよ。 なんてこった。 できません"}, {"type": "subtitle", "time": 3132.589, "timestamp": "00:52:12", "text": "。 おお。 車両。"}, {"type": "subtitle", "time": 3137.109, "timestamp": "00:52:17", "text": "車両。 死ぬ。 あ、待って。 君たちはどこにいるの"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "？ 大丈夫。 大丈夫。 大丈夫。"}, {"type": "subtitle", "time": 3143.589, "timestamp": "00:52:23", "text": "ジャック、そんな風に私たちを一人にしないでくれよ。"}, {"type": "subtitle", "time": 3144.589, "timestamp": "00:52:24", "text": "どういう"}, {"type": "subtitle", "time": 3148.71, "timestamp": "00:52:28", "text": "意味ですか？ 私はその場所に到着した。 ルークを助けて。"}, {"type": "subtitle", "time": 3150.99, "timestamp": "00:52:30", "text": "ルークって誰？ ああ、この"}, {"type": "subtitle", "time": 3157.23, "timestamp": "00:52:37", "text": "人か。 死ぬ。 死ぬ。 死ぬ。 死ぬ。 死ぬ。 死ぬ。 私は"}, {"type": "subtitle", "time": 3159.75, "timestamp": "00:52:39", "text": "死んだ。 ああ"}, {"type": "subtitle", "time": 3161.99, "timestamp": "00:52:41", "text": "、それは難しいですね。 知っている。 私は死ななかった"}, {"type": "subtitle", "time": 3165.03, "timestamp": "00:52:45", "text": "。 私は死ななかった。 ジャック、君と僕が「私たちを一人にしないで」って言う時、僕が何を言いたいのか分かるよね"}, {"type": "subtitle", "time": 3168.79, "timestamp": "00:52:48", "text": "。   いや"}, {"type": "subtitle", "time": 3171.19, "timestamp": "00:52:51", "text": "、違うよ。"}, {"type": "subtitle", "time": 3174.549, "timestamp": "00:52:54", "text": "大丈夫です。 心配しないで。 すぐにそうなるよ。   わかった"}]
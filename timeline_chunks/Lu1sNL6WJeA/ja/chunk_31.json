[{"type": "subtitle", "time": 1860.549, "timestamp": "00:31:00", "text": "ああ、パトロールがあるんだ。 私のパソコンがフリーズしてしまいました。"}, {"type": "subtitle", "time": 1866.389, "timestamp": "00:31:06", "text": "これが欲しいのか？ これをどうやって削除すればいいですか？ わかった。"}, {"type": "subtitle", "time": 1868.909, "timestamp": "00:31:08", "text": "刺してもいいですか？ 刺してもいいですか？"}, {"type": "subtitle", "time": 1871.549, "timestamp": "00:31:11", "text": "いや、ひどいゲームだ。 最悪の"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "ゲーム。 ああ、わかったよ。"}, {"type": "subtitle", "time": 1887.51, "timestamp": "00:31:27", "text": "これを落とさせてくれないんです。"}, {"type": "subtitle", "time": 1888.95, "timestamp": "00:31:28", "text": "ジョック、この物を落とす方法を知ってるか"}, {"type": "subtitle", "time": 1895.19, "timestamp": "00:31:35", "text": "？  G. Gを試してみて。落ちてないよ。   ああ"}, {"type": "subtitle", "time": 1899.99, "timestamp": "00:31:39", "text": "、そうだね。 左クリック。 わかった。 わかった。"}, {"type": "subtitle", "time": 1902.63, "timestamp": "00:31:42", "text": "Q9。 ああ、修理できますよ。 わかった。 ええ、たった"}, {"type": "subtitle", "time": 1909.029, "timestamp": "00:31:49", "text": "6ドルで返済できますよ。"}, {"type": "subtitle", "time": 1911.669, "timestamp": "00:31:51", "text": "彼に投げ渡すべきだと思うよ。"}, {"type": "subtitle", "time": 1914.31, "timestamp": "00:31:54", "text": "はぁ？  600ドル。 一体どういうことだ？"}, {"type": "subtitle", "time": 1916.23, "timestamp": "00:31:56", "text": "私がオープンすれば、きっと何か役に立つものが見つかるはずです"}]
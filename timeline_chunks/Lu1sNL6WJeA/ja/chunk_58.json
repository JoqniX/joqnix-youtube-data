[{"type": "subtitle", "time": 3484.069, "timestamp": "00:58:04", "text": "私は死んだ。"}, {"type": "subtitle", "time": 3487.75, "timestamp": "00:58:07", "text": "チョーク。 おお。 誰が私を殺したの？ それは、"}, {"type": "subtitle", "time": 3490.72, "timestamp": "00:58:10", "text": "私たちを放っておかないということだ。"}, {"type": "subtitle", "time": 3497.549, "timestamp": "00:58:17", "text": "待って。"}, {"type": "subtitle", "time": 3501.61, "timestamp": "00:58:21", "text": "ニース。 ただ踏み潰すだけだ。 彼らの頭を踏みつける"}, {"type": "subtitle", "time": 3502.829, "timestamp": "00:58:22", "text": "[拍手]"}, {"type": "subtitle", "time": 3510.63, "timestamp": "00:58:30", "text": "あ、待って。 そうそう。"}, {"type": "subtitle", "time": 3520.15, "timestamp": "00:58:40", "text": "、何でもありません。 ただのお金。 待って、チャック、"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "そこにいるの？ 私はここにいます。 私はここにいます。 私はここにいます"}, {"type": "subtitle", "time": 3528.99, "timestamp": "00:58:48", "text": "私は"}, {"type": "subtitle", "time": 3531.99, "timestamp": "00:58:51", "text": "目標を達成しています。 ああ、それは痛手だ。 ああ、気をつけろよ"}, {"type": "subtitle", "time": 3534.15, "timestamp": "00:58:54", "text": "。"}, {"type": "subtitle", "time": 3536.95, "timestamp": "00:58:56", "text": "起きる。 起きる。 起きる。 起きる。 ああ、なんてことだ。"}, {"type": "subtitle", "time": 3539.51, "timestamp": "00:58:59", "text": "こいつ、一撃で俺を倒した。 何てことだ。"}]
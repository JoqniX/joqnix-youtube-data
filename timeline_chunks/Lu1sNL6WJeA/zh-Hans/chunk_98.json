[{"type": "subtitle", "time": 5886.99, "timestamp": "01:38:06", "text": "好起来的，别"}, {"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "但是你说得对，我的确需要"}, {"type": "subtitle", "time": 5902.39, "timestamp": "01:38:22", "text": "复习一下，实际上我没有时间"}, {"type": "subtitle", "time": 5905.149, "timestamp": "01:38:25", "text": "复习，"}, {"type": "subtitle", "time": 5908.189, "timestamp": "01:38:28", "text": "没错。 对"}, {"type": "subtitle", "time": 5910.95, "timestamp": "01:38:30", "text": "了，我想问一下，你"}, {"type": "subtitle", "time": 5914.59, "timestamp": "01:38:34", "text": "玩《战争雷霆》吗？ 你玩《战争"}, {"type": "subtitle", "time": 5917.709, "timestamp": "01:38:37", "text": "雷霆》吗？ 你"}, {"type": "subtitle", "time": 5924.95, "timestamp": "01:38:44", "text": "。 你玩《Watanda》吗？ 你喜欢"}, {"type": "subtitle", "time": 5927.629, "timestamp": "01:38:47", "text": "飞机吗？"}, {"type": "subtitle", "time": 5930.95, "timestamp": "01:38:50", "text": "谢谢。 自从我看了"}, {"type": "subtitle", "time": 5937.82, "timestamp": "01:38:57", "text": "嗯"}, {"type": "subtitle", "time": 5939.39, "timestamp": "01:38:59", "text": "[音乐]"}]
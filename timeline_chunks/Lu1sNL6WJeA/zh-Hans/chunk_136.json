[{"type": "subtitle", "time": 8160.229, "timestamp": "02:16:00", "text": "啊，其实我也不知道。"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "他们有三个在中间。我的天。"}, {"type": "subtitle", "time": 8170.069, "timestamp": "02:16:10", "text": "哦，你升到军衔了。哦，不。那不是……"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "哦，救命。救命。救命。救命。救命。救命。救命。有人吗？有人吗？"}, {"type": "subtitle", "time": 8176.55, "timestamp": "02:16:16", "text": "打死它。哦，天哪。"}, {"type": "subtitle", "time": 8181.189, "timestamp": "02:16:21", "text": "我的天哪。他们……哇。他们……好吧，"}, {"type": "subtitle", "time": 8184.109, "timestamp": "02:16:24", "text": "这太可惜了。是"}, {"type": "subtitle", "time": 8188.629, "timestamp": "02:16:28", "text": "啊，那……哦，不，那……顺便说一句，他们都在"}, {"type": "subtitle", "time": 8191.51, "timestamp": "02:16:31", "text": "看着呢。"}, {"type": "subtitle", "time": 8192.91, "timestamp": "02:16:32", "text": "哦，操。"}, {"type": "subtitle", "time": 8195.75, "timestamp": "02:16:35", "text": "好吧，你知道吗？我有个解决办法"}, {"type": "subtitle", "time": 8198.79, "timestamp": "02:16:38", "text": "。"}, {"type": "subtitle", "time": 8200.549, "timestamp": "02:16:40", "text": "我要一个一个地干掉他们"}, {"type": "subtitle", "time": 8202.15, "timestamp": "02:16:42", "text": "。"}, {"type": "subtitle", "time": 8203.669, "timestamp": "02:16:43", "text": "啊。"}, {"type": "subtitle", "time": 8214.07, "timestamp": "02:16:54", "text": "需要空投。我要引诱他们…… 过来"}]
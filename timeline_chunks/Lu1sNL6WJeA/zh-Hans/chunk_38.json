[{"type": "subtitle", "time": 2280.069, "timestamp": "00:38:00", "text": "办？ 哦，我想我假设"}, {"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "我们需要从那里经过。 我的"}, {"type": "subtitle", "time": 2283.829, "timestamp": "00:38:03", "text": "天哪，看看这个人。 这男的帅"}, {"type": "subtitle", "time": 2287.27, "timestamp": "00:38:07", "text": "爆了。 好了，我们走吧。"}, {"type": "subtitle", "time": 2290.47, "timestamp": "00:38:10", "text": "哦，是的。"}, {"type": "subtitle", "time": 2292.47, "timestamp": "00:38:12", "text": "他其实只是晒伤了而已。 就这样"}, {"type": "subtitle", "time": 2294.47, "timestamp": "00:38:14", "text": "。 没什么大碍。 不用"}, {"type": "subtitle", "time": 2297.589, "timestamp": "00:38:17", "text": "担心。 对，只是晒伤。 好吧，既然你"}, {"type": "subtitle", "time": 2301.51, "timestamp": "00:38:21", "text": "这么说。 我同意。"}, {"type": "subtitle", "time": 2303.67, "timestamp": "00:38:23", "text": "我的天哪，有人！"}, {"type": "subtitle", "time": 2307.7, "timestamp": "00:38:27", "text": "搞什么鬼？ 需要更多弹药。"}, {"type": "subtitle", "time": 2333.91, "timestamp": "00:38:53", "text": "你不能把用过的钉枪子弹换回来"}, {"type": "subtitle", "time": 2336.47, "timestamp": "00:38:56", "text": "。 等等，怎么才能弄到"}, {"type": "subtitle", "time": 2338.63, "timestamp": "00:38:58", "text": "射钉枪？"}]
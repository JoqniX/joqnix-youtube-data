[{"type": "subtitle", "time": 7440.47, "timestamp": "02:04:00", "text": "。我完全没想到。我当时真的"}, {"type": "subtitle", "time": 7442.87, "timestamp": "02:04:02", "text": "懵了。我"}, {"type": "subtitle", "time": 7444.47, "timestamp": "02:04:04", "text": "就想，“Jocknix怎么会出现在这里？”"}, {"type": "subtitle", "time": 7447.27, "timestamp": "02:04:07", "text": "“他是不是跟我组队了？”我的"}, {"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "天啊。我的天啊。以前也发生过。"}, {"type": "subtitle", "time": 7452.629, "timestamp": "02:04:12", "text": "我想我之前也遇到过凯拉和塞莱斯特"}, {"type": "subtitle", "time": 7456.709, "timestamp": "02:04:16", "text": "。我的天啊。真好。是啊。是啊"}, {"type": "subtitle", "time": 7459.03, "timestamp": "02:04:19", "text": "。还有一次，"}, {"type": "subtitle", "time": 7462.55, "timestamp": "02:04:22", "text": "我们其实有四个人"}, {"type": "subtitle", "time": 7465.109, "timestamp": "02:04:25", "text": "。是啊。我们有四个人，然后"}, {"type": "subtitle", "time": 7467.109, "timestamp": "02:04:27", "text": "我们决定分开排队"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "，我们两个人一组，因为我们"}, {"type": "subtitle", "time": 7470.95, "timestamp": "02:04:30", "text": "不能一起排队，对吧？是啊。"}, {"type": "subtitle", "time": 7473.35, "timestamp": "02:04:33", "text": "然后我们最后进了同一局，"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "但是分到了不同的队伍。"}, {"type": "subtitle", "time": 7479.51, "timestamp": "02:04:39", "text": "哦。我的天啊。是啊。还有，你是怎么"}, {"type": "subtitle", "time": 7481.589, "timestamp": "02:04:41", "text": "录制你的VAL的？窗口录制"}, {"type": "subtitle", "time": 7484.629, "timestamp": "02:04:44", "text": "还是游戏窗口录制？我用"}, {"type": "subtitle", "time": 7488.31, "timestamp": "02:04:48", "text": "窗口录制，然后我"}, {"type": "subtitle", "time": 7491.35, "timestamp": "02:04:51", "text": "的游戏保持窗口全屏模式。"}, {"type": "subtitle", "time": 7495.189, "timestamp": "02:04:55", "text": "啊，明白了。是的。是的。"}, {"type": "subtitle", "time": 7497.51, "timestamp": "02:04:57", "text": "你知道吗？我其实想玩密码师"}]
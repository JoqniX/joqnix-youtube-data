[{"type": "subtitle", "time": 10623.11, "timestamp": "02:57:03", "text": "双枪来跟我打。"}, {"type": "subtitle", "time": 10627.51, "timestamp": "02:57:07", "text": "哇。 哦，谢谢。 好的。"}, {"type": "subtitle", "time": 10631.11, "timestamp": "02:57:11", "text": "我们有一支猎枪。 我的天啊。 哦，这个真的"}, {"type": "subtitle", "time": 10650.269, "timestamp": "02:57:30", "text": "。 住手"}, {"type": "subtitle", "time": 10654.67, "timestamp": "02:57:34", "text": "。 让我朝你这边扔几颗手榴弹"}, {"type": "subtitle", "time": 10657.79, "timestamp": "02:57:37", "text": "。 我觉得这事儿实际上不会发生"}, {"type": "subtitle", "time": 10660.79, "timestamp": "02:57:40", "text": "。 该死的。 我知道，我知道"}, {"type": "subtitle", "time": 10664.15, "timestamp": "02:57:44", "text": "解决这个问题的办法。 我知道该怎么"}, {"type": "subtitle", "time": 10675.389, "timestamp": "02:57:55", "text": "死了。 我的"}, {"type": "subtitle", "time": 10677.59, "timestamp": "02:57:57", "text": "天哪。 我本来打算拿着手榴弹冲向你"}]
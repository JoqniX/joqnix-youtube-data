[{"type": "subtitle", "time": 8348.309, "timestamp": "02:19:08", "text": "是你和我。"}, {"type": "subtitle", "time": 8350.469, "timestamp": "02:19:10", "text": "啊，看到了。你看到发生了什么吗？"}, {"type": "subtitle", "time": 8353.429, "timestamp": "02:19:13", "text": "是的，他一枪爆了你。哦，好吧，不是"}, {"type": "subtitle", "time": 8356.79, "timestamp": "02:19:16", "text": "那样，我是说我朝他开枪，然后"}, {"type": "subtitle", "time": 8359.99, "timestamp": "02:19:19", "text": "我的游戏就卡住了。这种情况经常发生。"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "整个游戏过程中都在发生。我不知道"}, {"type": "subtitle", "time": 8365.349, "timestamp": "02:19:25", "text": "为什么。哦，当其他玩家出现的时候。是"}, {"type": "subtitle", "time": 8367.91, "timestamp": "02:19:27", "text": "啊。是啊。当他们出现在屏幕上时，我的"}, {"type": "subtitle", "time": 8376.669, "timestamp": "02:19:36", "text": "很"}, {"type": "subtitle", "time": 8392.429, "timestamp": "02:19:52", "text": "我的天啊，他们总是来中路。"}, {"type": "subtitle", "time": 8394.63, "timestamp": "02:19:54", "text": "哦，他们"}]
[{"type": "subtitle", "time": 2041.83, "timestamp": "00:34:01", "text": "我就是喜欢踢这家伙。"}, {"type": "subtitle", "time": 2043.99, "timestamp": "00:34:03", "text": "顺便一提，它还能踩人头。"}, {"type": "subtitle", "time": 2045.19, "timestamp": "00:34:05", "text": "哦，是的。 我知道。 我当时就是想这么做"}, {"type": "subtitle", "time": 2047.669, "timestamp": "00:34:07", "text": "。   妈的"}, {"type": "subtitle", "time": 2050.149, "timestamp": "00:34:10", "text": "。 等等，Jacqu 是在升级"}, {"type": "subtitle", "time": 2055.99, "timestamp": "00:34:15", "text": "他喜欢的东西吗？ 不，我正在康复。"}, {"type": "subtitle", "time": 2058.149, "timestamp": "00:34:18", "text": "对了，洋子，你累了吧。 我"}, {"type": "subtitle", "time": 2066.55, "timestamp": "00:34:26", "text": "好的。"}, {"type": "subtitle", "time": 2068.95, "timestamp": "00:34:28", "text": "啊，是的。 宝贝，我说的就是这个"}, {"type": "subtitle", "time": 2080.149, "timestamp": "00:34:40", "text": "[掌声]"}, {"type": "subtitle", "time": 2083.909, "timestamp": "00:34:43", "text": "注意你的“哦，天哪，我要死了”。"}, {"type": "subtitle", "time": 2094.23, "timestamp": "00:34:54", "text": "[音乐]"}]
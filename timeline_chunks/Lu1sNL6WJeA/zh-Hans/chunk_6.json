[{"type": "subtitle", "time": 366.23, "timestamp": "00:06:06", "text": "听着，你完全没问题。 那么"}, {"type": "subtitle", "time": 368.83, "timestamp": "00:06:08", "text": "我们该怎么办？ 我们该怎么办？ 呃，"}, {"type": "subtitle", "time": 371.909, "timestamp": "00:06:11", "text": "在线的。 我应该点击简历链接还是点击“"}, {"type": "subtitle", "time": 375.51, "timestamp": "00:06:15", "text": "邀请您”之类的选项？"}, {"type": "subtitle", "time": 379.11, "timestamp": "00:06:19", "text": "嘿。 嘿，醒醒。 你还好吗？ 哦，"}, {"type": "subtitle", "time": 382.07, "timestamp": "00:06:22", "text": "其实没事。 呃，游戏大厅。"}, {"type": "subtitle", "time": 385.029, "timestamp": "00:06:25", "text": "那艘船。 这里有大厅。"}, {"type": "subtitle", "time": 387.99, "timestamp": "00:06:27", "text": "是的，这里有个游戏大厅。"}, {"type": "subtitle", "time": 390.07, "timestamp": "00:06:30", "text": "顺便一提，我是我最好的朋友之一。 我"}, {"type": "subtitle", "time": 392.55, "timestamp": "00:06:32", "text": "不需要其他人。 但我觉得在这里接受"}, {"type": "subtitle", "time": 400.67, "timestamp": "00:06:40", "text": "邀请并不安全。 天哪，我可以邀请你们"}, {"type": "subtitle", "time": 402.95, "timestamp": "00:06:42", "text": "全员来玩吗？ 它正在"}, {"type": "subtitle", "time": 405.27, "timestamp": "00:06:45", "text": "蔓延。 对，就让他"}, {"type": "subtitle", "time": 406.87, "timestamp": "00:06:46", "text": "现在把话说完吧。 你需要搬家。 好的，日本"}, {"type": "subtitle", "time": 409.51, "timestamp": "00:06:49", "text": "通过Steam邀请了你。 寻找那座"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "大树屋。 好的，等等。 让我跳过这段过场动画"}, {"type": "subtitle", "time": 414.95, "timestamp": "00:06:54", "text": "。 这场风暴简直是一场灾难。"}, {"type": "subtitle", "time": 417.83, "timestamp": "00:06:57", "text": "等等，你没参加游戏吗？ 我已加入"}]
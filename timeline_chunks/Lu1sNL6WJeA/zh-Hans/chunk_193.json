[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "上帝啊。"}, {"type": "subtitle", "time": 11583.99, "timestamp": "03:13:03", "text": "哦，是的，我看到你玩《辐射》"}, {"type": "subtitle", "time": 11587.67, "timestamp": "03:13:07", "text": "系列游戏了。 它怎么样？ 哦，辐射系列。 哦，我超"}, {"type": "subtitle", "time": 11589.91, "timestamp": "03:13:09", "text": "爱《辐射》系列。 嗯，新维加斯是我"}, {"type": "subtitle", "time": 11592.15, "timestamp": "03:13:12", "text": "最喜欢的。 我觉得我没看完。"}, {"type": "subtitle", "time": 11594.15, "timestamp": "03:13:14", "text": "其实我本来就打算很快就去取的。"}, {"type": "subtitle", "time": 11598.389, "timestamp": "03:13:18", "text": "我又玩了一次《辐射》。"}, {"type": "subtitle", "time": 11601.349, "timestamp": "03:13:21", "text": "哦，是的。"}, {"type": "subtitle", "time": 11603.75, "timestamp": "03:13:23", "text": "你玩过《辐射》系列游戏吗？ 还没有"}, {"type": "subtitle", "time": 11606.23, "timestamp": "03:13:26", "text": "。 我看了那部启发"}, {"type": "subtitle", "time": 11609.11, "timestamp": "03:13:29", "text": "我入坑《辐射》系列和"}, {"type": "subtitle", "time": 11610.91, "timestamp": "03:13:30", "text": "宇宙的电影。"}, {"type": "subtitle", "time": 11615.11, "timestamp": "03:13:35", "text": "哦。 哦，这部剧真的很好看。"}, {"type": "subtitle", "time": 11617.11, "timestamp": "03:13:37", "text": "你知道，如果你想开始玩，我觉得"}, {"type": "subtitle", "time": 11619.269, "timestamp": "03:13:39", "text": "你应该先玩《辐射4》，然后"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "再玩《辐射：新维加斯》，因为《"}, {"type": "subtitle", "time": 11623.67, "timestamp": "03:13:43", "text": "辐射4》对用户更友好一些，"}, {"type": "subtitle", "time": 11627.11, "timestamp": "03:13:47", "text": "而像《辐射：新维加斯》这样的游戏对新手来说可能会让人"}, {"type": "subtitle", "time": 11632.309, "timestamp": "03:13:52", "text": "不知所措，"}, {"type": "subtitle", "time": 11636.389, "timestamp": "03:13:56", "text": "因为……呃，它叫什么来着？"}, {"type": "subtitle", "time": 11637.71, "timestamp": "03:13:57", "text": "这里"}]
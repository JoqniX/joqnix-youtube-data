[{"type": "subtitle", "time": 3484.069, "timestamp": "00:58:04", "text": "我死了。"}, {"type": "subtitle", "time": 3487.75, "timestamp": "00:58:07", "text": "粉笔。 哇。 谁杀了我？ 关键是"}, {"type": "subtitle", "time": 3490.72, "timestamp": "00:58:10", "text": "不要让我们独自待着。"}, {"type": "subtitle", "time": 3497.549, "timestamp": "00:58:17", "text": "等等。"}, {"type": "subtitle", "time": 3501.61, "timestamp": "00:58:21", "text": "好的。 直接踩扁他们。 狠狠踩爆他们的"}, {"type": "subtitle", "time": 3510.63, "timestamp": "00:58:30", "text": "哦，等等。 哦，是的。 那里可能有"}, {"type": "subtitle", "time": 3520.15, "timestamp": "00:58:40", "text": "，没什么。 只是钱。 等等，查克，"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "你在吗？ 我在这里。 我在这里。 我在"}, {"type": "subtitle", "time": 3528.99, "timestamp": "00:58:48", "text": "我正在完成"}, {"type": "subtitle", "time": 3531.99, "timestamp": "00:58:51", "text": "目标。 哦，真是个打击。 哦，小心"}, {"type": "subtitle", "time": 3534.15, "timestamp": "00:58:54", "text": "点。"}, {"type": "subtitle", "time": 3536.95, "timestamp": "00:58:56", "text": "起床。 起床。 起床。 起床。 我的天哪。"}, {"type": "subtitle", "time": 3539.51, "timestamp": "00:58:59", "text": "这家伙一枪就把我秒了。 我的天啊。"}]
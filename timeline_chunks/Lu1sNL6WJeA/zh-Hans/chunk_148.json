[{"type": "subtitle", "time": 8880.95, "timestamp": "02:28:00", "text": "出测试版了。它已经出测试版了。你"}, {"type": "subtitle", "time": 8883.83, "timestamp": "02:28:03", "text": "可以玩玩。我一直留着它"}, {"type": "subtitle", "time": 8885.59, "timestamp": "02:28:05", "text": "。"}, {"type": "subtitle", "time": 8887.75, "timestamp": "02:28:07", "text": "呃，其实我挺喜欢原版的。它让"}, {"type": "subtitle", "time": 8890.469, "timestamp": "02:28:10", "text": "我想起……叫什么来着？有点"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "像《光环》和《雷神之锤》的结合体。《光环》，对吧？《光环》。"}, {"type": "subtitle", "time": 8896.309, "timestamp": "02:28:16", "text": "没错。"}, {"type": "subtitle", "time": 8898.469, "timestamp": "02:28:18", "text": "我一直很期待它。我不"}, {"type": "subtitle", "time": 8899.83, "timestamp": "02:28:19", "text": "知道他们为什么要移除第一部。"}, {"type": "subtitle", "time": 8902.07, "timestamp": "02:28:22", "text": "第一部挺好的。有"}, {"type": "subtitle", "time": 8905.75, "timestamp": "02:28:25", "text": "什么问题吗？"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "它的移动机制和其他方面都很棒。"}, {"type": "subtitle", "time": 8911.349, "timestamp": "02:28:31", "text": "是的，你说得对。你说得对。"}, {"type": "subtitle", "time": 8913.75, "timestamp": "02:28:33", "text": "让我想起了《Apex英雄》那种感觉，呃，有点像《"}, {"type": "subtitle", "time": 8916.309, "timestamp": "02:28:36", "text": "泰坦陨落2》。是的。没错。"}, {"type": "subtitle", "time": 8918.15, "timestamp": "02:28:38", "text": "没错。你知道，他们融合了很多"}, {"type": "subtitle", "time": 8920.389, "timestamp": "02:28:40", "text": "游戏，我觉得，比如很多类似的"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "游戏，像《泰坦陨落》和《光环》，我"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "想，来制作这款游戏​​的移动"}, {"type": "subtitle", "time": 8929.27, "timestamp": "02:28:49", "text": "机制等等。我想知道，是的"}, {"type": "subtitle", "time": 8932.15, "timestamp": "02:28:52", "text": "。我想知道他们是否可以"}, {"type": "subtitle", "time": 8935.19, "timestamp": "02:28:55", "text": "宣称这是自《"}, {"type": "subtitle", "time": 8938.79, "timestamp": "02:28:58", "text": "泰坦陨落2》以来最好的移动机制。"}]
[{"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "你明白了吗？我觉得我被"}, {"type": "subtitle", "time": 9248.15, "timestamp": "02:34:08", "text": "地雷炸到了。"}, {"type": "subtitle", "time": 9251.63, "timestamp": "02:34:11", "text": "你把它们放在"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "蛋蛋上了吗？你真是个疯子。你把"}, {"type": "subtitle", "time": 9262.71, "timestamp": "02:34:22", "text": "好吧，那是个随机爆头。我"}, {"type": "subtitle", "time": 9265.99, "timestamp": "02:34:25", "text": "不会撒谎。但"}, {"type": "subtitle", "time": 9269.03, "timestamp": "02:34:29", "text": "它奏效了。 我很高兴。"}, {"type": "subtitle", "time": 9275.07, "timestamp": "02:34:35", "text": "这是什么？哦，这是光束枪。"}]
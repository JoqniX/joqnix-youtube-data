[{"type": "subtitle", "time": 9122.15, "timestamp": "02:32:02", "text": "搞什么鬼？我在玩Apex英雄。"}, {"type": "subtitle", "time": 9123.389, "timestamp": "02:32:03", "text": "我不玩"}, {"type": "subtitle", "time": 9125.91, "timestamp": "02:32:05", "text": "Apex英雄。Apex英雄到底怎么玩？我的天"}, {"type": "subtitle", "time": 9131.07, "timestamp": "02:32:11", "text": "。我的天"}, {"type": "subtitle", "time": 9133.51, "timestamp": "02:32:13", "text": "。好吧，其实我知道该怎么做了"}, {"type": "subtitle", "time": 9135.87, "timestamp": "02:32:15", "text": "。"}, {"type": "subtitle", "time": 9138.389, "timestamp": "02:32:18", "text": "[掌声]"}, {"type": "subtitle", "time": 9141.19, "timestamp": "02:32:21", "text": "等等，怎么做？耶。走吧。你"}, {"type": "subtitle", "time": 9142.87, "timestamp": "02:32:22", "text": "看，你可以穿墙射击。 我"}, {"type": "subtitle", "time": 9158.67, "timestamp": "02:32:38", "text": "哦，"}, {"type": "subtitle", "time": 9163.27, "timestamp": "02:32:43", "text": "等等。什么鬼？我摔下去了。"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "哦，你是跳过去的。好吧，我明白了。我"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "不知道你还能这么做。该死。我还"}, {"type": "subtitle", "time": 9169.19, "timestamp": "02:32:49", "text": "以为你只能"}, {"type": "subtitle", "time": 9172.07, "timestamp": "02:32:52", "text": "隔墙射击呢。哇。我的天。这张"}, {"type": "subtitle", "time": 9174.95, "timestamp": "02:32:54", "text": "地图我玩得最烂。"}, {"type": "subtitle", "time": 9178.309, "timestamp": "02:32:58", "text": "这张地图很烂吗？你居然有玩得烂的地图？"}]
[{"type": "subtitle", "time": 7045.91, "timestamp": "01:57:25", "text": "对吧？等等，他有推特账号。是这样吗"}, {"type": "subtitle", "time": 7047.229, "timestamp": "01:57:27", "text": "？"}, {"type": "subtitle", "time": 7050.109, "timestamp": "01:57:30", "text": "等等，为什么我昨天看的时候"}, {"type": "subtitle", "time": 7052.39, "timestamp": "01:57:32", "text": "，这些人都没有"}, {"type": "subtitle", "time": 7055.189, "timestamp": "01:57:35", "text": "推特账号，也没有在频道里链接？"}, {"type": "subtitle", "time": 7062.189, "timestamp": "01:57:42", "text": "世界上？等等，不可能"}, {"type": "subtitle", "time": 7068.91, "timestamp": "01:57:48", "text": "等等。"}, {"type": "subtitle", "time": 7070.95, "timestamp": "01:57:50", "text": "复制。等等。那真的是"}, {"type": "subtitle", "time": 7073.229, "timestamp": "01:57:53", "text": "夏树吗？"}, {"type": "subtitle", "time": 7077.55, "timestamp": "01:57:57", "text": "夏树。Vub 现在很震惊。"}]
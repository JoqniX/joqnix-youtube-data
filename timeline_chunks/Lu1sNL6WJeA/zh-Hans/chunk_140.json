[{"type": "subtitle", "time": 8405.11, "timestamp": "02:20:05", "text": "[掌声]"}, {"type": "subtitle", "time": 8407.27, "timestamp": "02:20:07", "text": "击落B点。也许我们应该"}, {"type": "subtitle", "time": 8415.429, "timestamp": "02:20:15", "text": "不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 8416.87, "timestamp": "02:20:16", "text": "好吧，你知道吗？是的，我们能从"}, {"type": "subtitle", "time": 8419.27, "timestamp": "02:20:19", "text": "这种困境中翻盘。我们肯定能从这种困境中翻盘"}, {"type": "subtitle", "time": 8427.11, "timestamp": "02:20:27", "text": "还剩一个敌人。漂亮。好枪法。"}, {"type": "subtitle", "time": 8436.79, "timestamp": "02:20:36", "text": "最后一个幸存者。我击落了炸弹。"}, {"type": "subtitle", "time": 8439.75, "timestamp": "02:20:39", "text": "他在我们的出生点。"}, {"type": "subtitle", "time": 8442.15, "timestamp": "02:20:42", "text": "好的。是的，你可以安放炸弹然后回去"}, {"type": "subtitle", "time": 8443.75, "timestamp": "02:20:43", "text": "。我想他不会想到你会在"}, {"type": "subtitle", "time": 8446.63, "timestamp": "02:20:46", "text": "那里。"}, {"type": "subtitle", "time": 8451.27, "timestamp": "02:20:51", "text": "回主基地。主基地。主基地。"}]
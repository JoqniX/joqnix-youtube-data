[{"type": "subtitle", "time": 8940.07, "timestamp": "02:29:00", "text": "他们就是这么说的。"}, {"type": "subtitle", "time": 8944.87, "timestamp": "02:29:04", "text": "是啊，预告片里或者分屏里也提到了。"}, {"type": "subtitle", "time": 8947.99, "timestamp": "02:29:07", "text": "我不知道。我希望Respawn能赢"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "他们什么的。"}, {"type": "subtitle", "time": 8953.03, "timestamp": "02:29:13", "text": "这标准确实挺高的。嗯。"}, {"type": "subtitle", "time": 8955.75, "timestamp": "02:29:15", "text": "好的。等等，等等，稍等一下。我建个"}, {"type": "subtitle", "time": 8959.03, "timestamp": "02:29:19", "text": "只有好友的私人房间。嗯。嗯。"}, {"type": "subtitle", "time": 8962.95, "timestamp": "02:29:22", "text": "我会邀请你。好了。"}, {"type": "subtitle", "time": 8966.15, "timestamp": "02:29:26", "text": "来吧。好了。来吧。好的。"}, {"type": "subtitle", "time": 8978.87, "timestamp": "02:29:38", "text": "不错。嗯，是啊。头像不错，兄弟。准备好了"}, {"type": "subtitle", "time": 8982.469, "timestamp": "02:29:42", "text": "。准备好了。来吧。嗨。走吧。"}, {"type": "subtitle", "time": 8987.27, "timestamp": "02:29:47", "text": "准备好了。走吧。走吧。"}, {"type": "subtitle", "time": 8991.75, "timestamp": "02:29:51", "text": "哦，这是什么？欢迎来到星际争霸。"}, {"type": "subtitle", "time": 8994.51, "timestamp": "02:29:54", "text": "不。等等。怎么……怎么……"}, {"type": "subtitle", "time": 8998.23, "timestamp": "02:29:58", "text": "哦我的天，我忘了操作了。"}]
[{"type": "subtitle", "time": 18.07, "timestamp": "00:00:18", "text": "哦，太棒了。 停止。 他们呢？"}, {"type": "subtitle", "time": 19.99, "timestamp": "00:00:19", "text": "现在那是你的问题了。 你不能就这么把"}, {"type": "subtitle", "time": 22.39, "timestamp": "00:00:22", "text": "他们留在这里。 他们是平民。 如果我"}, {"type": "subtitle", "time": 24.47, "timestamp": "00:00:24", "text": "是你，我会担心自己的"}, {"type": "subtitle", "time": 26.87, "timestamp": "00:00:26", "text": "安危，上校。"}, {"type": "subtitle", "time": 30.15, "timestamp": "00:00:30", "text": "我的天啊。 为什么没有敲门声？"}, {"type": "subtitle", "time": 32.95, "timestamp": "00:00:32", "text": "那家伙就这么走了。 搞什么鬼？ 你"}, {"type": "subtitle", "time": 36.229, "timestamp": "00:00:36", "text": "上来。 队长，请回答。士兵，你的"}, {"type": "subtitle", "time": 39.11, "timestamp": "00:00:39", "text": "队长阵亡了。"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "哦，不。 那是块石头吗？"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "我们正走向一场冲突。 我们必须"}, {"type": "subtitle", "time": 51.51, "timestamp": "00:00:51", "text": "到达桥边。 是的，我们又遇到一个"}, {"type": "subtitle", "time": 54.389, "timestamp": "00:00:54", "text": "问题。 只得了一颗星。 哦，我们有"}, {"type": "subtitle", "time": 57.75, "timestamp": "00:00:57", "text": "步枪。 我们走吧。"}]
[{"type": "subtitle", "time": 1021.269, "timestamp": "00:17:01", "text": "谢谢你，托德。"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "哦，对不起。 我的天，好险！"}, {"type": "subtitle", "time": 1026.87, "timestamp": "00:17:06", "text": "这是事实。 我原本希望不会"}, {"type": "subtitle", "time": 1028.549, "timestamp": "00:17:08", "text": "发展到那种地步，但他们确实会把"}, {"type": "subtitle", "time": 1030.949, "timestamp": "00:17:10", "text": "我们打得落花流水。 现在，围栏虽然不好"}, {"type": "subtitle", "time": 1032.23, "timestamp": "00:17:12", "text": "用了，但你对"}, {"type": "subtitle", "time": 1034.47, "timestamp": "00:17:14", "text": "桥的看法是对的。 我们需要把它炸掉。 太"}, {"type": "subtitle", "time": 1038.789, "timestamp": "00:17:18", "text": "危险了。 带走。 炸毁这座"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "兄弟。 这是什么？ 我现在有枪了，"}, {"type": "subtitle", "time": 1048.63, "timestamp": "00:17:28", "text": "伙计。 走吧，"}, {"type": "subtitle", "time": 1068.15, "timestamp": "00:17:48", "text": "[掌声]"}, {"type": "subtitle", "time": 1076.95, "timestamp": "00:17:56", "text": "哦，结束了。 哦，结束了。 好的。 我当时"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "以为自己死了什么的。"}]
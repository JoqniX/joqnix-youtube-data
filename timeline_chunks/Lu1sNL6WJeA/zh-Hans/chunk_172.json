[{"type": "subtitle", "time": 10328.15, "timestamp": "02:52:08", "text": "你。 哦，没事了。   我的"}, {"type": "subtitle", "time": 10335.91, "timestamp": "02:52:15", "text": "天哪。 我会带着一丝"}, {"type": "subtitle", "time": 10338.269, "timestamp": "02:52:18", "text": "古老的"}, {"type": "subtitle", "time": 10342.19, "timestamp": "02:52:22", "text": "硫磺之火等着你。 我是一个阴森恐怖的"}, {"type": "subtitle", "time": 10344.349, "timestamp": "02:52:24", "text": "寓言故事。 哦，拜托"}, {"type": "subtitle", "time": 10348.51, "timestamp": "02:52:28", "text": "。 不是那样的。 我的"}, {"type": "subtitle", "time": 10368.91, "timestamp": "02:52:48", "text": "雅克维克斯，拜托。 来打"}]
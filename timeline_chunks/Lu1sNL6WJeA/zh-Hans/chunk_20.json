[{"type": "subtitle", "time": 1201.43, "timestamp": "00:20:01", "text": "现在那些该死的假话什么时候又会冒出来呢。 呃，说说吧。 嗯，是的，我在说话。"}, {"type": "subtitle", "time": 1207.909, "timestamp": "00:20:07", "text": "嘿，V talk。"}, {"type": "subtitle", "time": 1210.63, "timestamp": "00:20:10", "text": "你好。 你好。"}, {"type": "subtitle", "time": 1213.029, "timestamp": "00:20:13", "text": "哦，我们当然不能。 好的，没问题。"}, {"type": "subtitle", "time": 1216.63, "timestamp": "00:20:16", "text": "过来。 我们需要谈谈。"}, {"type": "subtitle", "time": 1220.39, "timestamp": "00:20:20", "text": "那我这儿有把射钉枪，兄弟。 我们走吧。"}, {"type": "subtitle", "time": 1222.47, "timestamp": "00:20:22", "text": "你准备好谈谈亨德森了吗？"}, {"type": "subtitle", "time": 1225.19, "timestamp": "00:20:25", "text": "我们要去哪里？ 这是谁？ 等等，看到"}, {"type": "subtitle", "time": 1226.87, "timestamp": "00:20:26", "text": "这个了吗？"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "你们看到这个故障了吗？"}, {"type": "subtitle", "time": 1231.909, "timestamp": "00:20:31", "text": "在门口。 过来。 过来。 过来"}, {"type": "subtitle", "time": 1236.23, "timestamp": "00:20:36", "text": "。 只有我这样吗？ 你在哪里？"}, {"type": "subtitle", "time": 1238.87, "timestamp": "00:20:38", "text": "里面那个人。"}, {"type": "subtitle", "time": 1242.31, "timestamp": "00:20:42", "text": "瞧瞧那家伙。 我的天啊。"}, {"type": "subtitle", "time": 1246.39, "timestamp": "00:20:46", "text": "他会感到疼痛。"}, {"type": "subtitle", "time": 1253.19, "timestamp": "00:20:53", "text": "我不该这么说。 我刚刚接受了一个"}, {"type": "subtitle", "time": 1256.71, "timestamp": "00:20:56", "text": "任务。 所以，让我们去痛扁僵尸吧。"}, {"type": "subtitle", "time": 1259.59, "timestamp": "00:20:59", "text": "哦，是的。 当然。"}]
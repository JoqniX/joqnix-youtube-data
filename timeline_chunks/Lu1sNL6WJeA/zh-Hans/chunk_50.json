[{"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "龙要去某个地方。 哎哟。"}, {"type": "subtitle", "time": 3013.03, "timestamp": "00:50:13", "text": "但我在这里。 这就是方法。"}, {"type": "subtitle", "time": 3015.91, "timestamp": "00:50:15", "text": "我当时就想，是啊，我简直就像在"}, {"type": "subtitle", "time": 3018.589, "timestamp": "00:50:18", "text": "过河一样。 哦，有"}, {"type": "subtitle", "time": 3021.91, "timestamp": "00:50:21", "text": "击中了。 嗯？ 等等，什么？ 是的。 你能不能用"}, {"type": "subtitle", "time": 3023.95, "timestamp": "00:50:23", "text": "钉枪之类的"}, {"type": "subtitle", "time": 3026.39, "timestamp": "00:50:26", "text": "东西把他钉死？ 谢谢。"}, {"type": "subtitle", "time": 3027.829, "timestamp": "00:50:27", "text": "没错，我要把他烧死。 我感觉浑身发热。"}, {"type": "subtitle", "time": 3057.15, "timestamp": "00:50:57", "text": "天哪，看看那家伙。"}, {"type": "subtitle", "time": 3059.27, "timestamp": "00:50:59", "text": "[掌声]"}]
[{"type": "subtitle", "time": 9300.15, "timestamp": "02:35:00", "text": "我了。这简直就是《星球大战》里的冲锋"}, {"type": "subtitle", "time": 9304.95, "timestamp": "02:35:04", "text": "队员在互相射击。我的天哪。是啊。哦"}, {"type": "subtitle", "time": 9321.349, "timestamp": "02:35:21", "text": "不。等等。我居然打中你了。是的，"}, {"type": "subtitle", "time": 9324.23, "timestamp": "02:35:24", "text": "你打中了。回来。回来。"}, {"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "回来。哦，你"}, {"type": "subtitle", "time": 9327.15, "timestamp": "02:35:27", "text": "可以打开这"}, {"type": "subtitle", "time": 9342.71, "timestamp": "02:35:42", "text": "哦，你在哪里？你在哪里？我的"}, {"type": "subtitle", "time": 9348.75, "timestamp": "02:35:48", "text": "。回来"}, {"type": "subtitle", "time": 9353.87, "timestamp": "02:35:53", "text": "我该放"}]
[{"type": "subtitle", "time": 4081.27, "timestamp": "01:08:01", "text": "呃，哦，我们来这里做什么？ 我们正在"}, {"type": "subtitle", "time": 4082.87, "timestamp": "01:08:02", "text": "痛扁僵尸，"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "现在要换个游戏了。 我们不去"}, {"type": "subtitle", "time": 4087.67, "timestamp": "01:08:07", "text": "猎杀僵尸了，我们现在要去猎杀幽灵了"}, {"type": "subtitle", "time": 4090.41, "timestamp": "01:08:10", "text": "。"}, {"type": "subtitle", "time": 4093.349, "timestamp": "01:08:13", "text": "[音乐]"}, {"type": "subtitle", "time": 4096.63, "timestamp": "01:08:16", "text": "好吧，我就等着。 好了，你们要"}, {"type": "subtitle", "time": 4098.309, "timestamp": "01:08:18", "text": "退出。 好的，那我这就"}, {"type": "subtitle", "time": 4100.789, "timestamp": "01:08:20", "text": "结束直播了。"}, {"type": "subtitle", "time": 4105.349, "timestamp": "01:08:25", "text": "嗯，就等着吧。"}, {"type": "subtitle", "time": 4107.189, "timestamp": "01:08:27", "text": "顺便说一句，我的猫现在正睡在我"}, {"type": "subtitle", "time": 4111.11, "timestamp": "01:08:31", "text": "腿上。 哎呀，"}, {"type": "subtitle", "time": 4113.98, "timestamp": "01:08:33", "text": "Niko"}, {"type": "subtitle", "time": 4117.47, "timestamp": "01:08:37", "text": "[Music] 在干什么"}, {"type": "subtitle", "time": 4120.07, "timestamp": "01:08:40", "text": "？ 杰里米·卢克，谢谢你的光临"}, {"type": "subtitle", "time": 4123.309, "timestamp": "01:08:43", "text": "。 非常感谢！"}, {"type": "subtitle", "time": 4126.91, "timestamp": "01:08:46", "text": "是的，我们要"}, {"type": "subtitle", "time": 4130.309, "timestamp": "01:08:50", "text": "收尾了，为什么不呢？"}, {"type": "subtitle", "time": 4133.669, "timestamp": "01:08:53", "text": "是的，我要结束了。"}, {"type": "subtitle", "time": 4137.51, "timestamp": "01:08:57", "text": "等等，呃，你要玩Fasmo吗？   当然可以"}, {"type": "subtitle", "time": 4139.99, "timestamp": "01:08:59", "text": "，如果你想加入的话。 我"}]
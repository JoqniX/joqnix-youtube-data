[{"type": "subtitle", "time": 3303.109, "timestamp": "00:55:03", "text": "没关系。 我的天啊，这只丧尸刚才"}, {"type": "subtitle", "time": 3305.67, "timestamp": "00:55:05", "text": "用头撞我了。 把他踢来踢去。"}, {"type": "subtitle", "time": 3307.75, "timestamp": "00:55:07", "text": "没关系。 感觉就像又被连续眩晕锁定了一样"}, {"type": "subtitle", "time": 3311.27, "timestamp": "00:55:11", "text": "。 杰克，我要死了"}, {"type": "subtitle", "time": 3314.549, "timestamp": "00:55:14", "text": "。 哟，"}, {"type": "subtitle", "time": 3316.71, "timestamp": "00:55:16", "text": "查克，我们正忙着给一个臃肿的家伙打晕眩呢"}, {"type": "subtitle", "time": 3319.63, "timestamp": "00:55:19", "text": "。 快点。 哦。 我的"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "天啊。 我们忙着进行眩晕锁定。 哦。"}, {"type": "subtitle", "time": 3326.15, "timestamp": "00:55:26", "text": "住口。 别朝我们吐口水了，伙计。 哦。"}, {"type": "subtitle", "time": 3333.51, "timestamp": "00:55:33", "text": "用我的手枪帮了他。"}, {"type": "subtitle", "time": 3337.43, "timestamp": "00:55:37", "text": "[掌声]"}, {"type": "subtitle", "time": 3338.95, "timestamp": "00:55:38", "text": "好。   是的"}, {"type": "subtitle", "time": 3351.349, "timestamp": "00:55:51", "text": "好的。 那边好像有个大老板"}, {"type": "subtitle", "time": 3359.43, "timestamp": "00:55:59", "text": "帮我。 你想要什么我都给你"}]
[{"type": "subtitle", "time": 2702.87, "timestamp": "00:45:02", "text": "米 红色解释符号。 是的。"}, {"type": "subtitle", "time": 2706.95, "timestamp": "00:45:06", "text": "不，是十字架。 是的。 圆形的东西。"}, {"type": "subtitle", "time": 2709.99, "timestamp": "00:45:09", "text": "哦，是的。 哦好的。 知道了。 我觉得我们"}, {"type": "subtitle", "time": 2711.91, "timestamp": "00:45:11", "text": "可以开车。"}, {"type": "subtitle", "time": 2715.63, "timestamp": "00:45:15", "text": "但是没有车。 哦，我们可以"}, {"type": "subtitle", "time": 2718.309, "timestamp": "00:45:18", "text": "等。 那我们去车里吧。 就在"}, {"type": "subtitle", "time": 2720.63, "timestamp": "00:45:20", "text": "附近。"}, {"type": "subtitle", "time": 2722.95, "timestamp": "00:45:22", "text": "大概有100多米。 我不想走"}, {"type": "subtitle", "time": 2727.349, "timestamp": "00:45:27", "text": "那么多路，伙计。 我，"}, {"type": "subtitle", "time": 2733.43, "timestamp": "00:45:33", "text": "你不能开着罐子走。"}, {"type": "subtitle", "time": 2735.23, "timestamp": "00:45:35", "text": "放下它。 放下它。 放下它。 放下"}, {"type": "subtitle", "time": 2738.47, "timestamp": "00:45:38", "text": "罐子。 放下罐子。 好的。 我"}, {"type": "subtitle", "time": 2740.47, "timestamp": "00:45:40", "text": "去把它取回来。 弗里克。 我不"}, {"type": "subtitle", "time": 2742.63, "timestamp": "00:45:42", "text": "应该踢它。 我想"}, {"type": "subtitle", "time": 2745.03, "timestamp": "00:45:45", "text": "这样达成目标。 啊，没事了。"}, {"type": "subtitle", "time": 2746.95, "timestamp": "00:45:46", "text": "我想我可能不知道去"}, {"type": "subtitle", "time": 2750.79, "timestamp": "00:45:50", "text": "车那里的路。"}, {"type": "subtitle", "time": 2753.19, "timestamp": "00:45:53", "text": "好的，你会去……好的，"}, {"type": "subtitle", "time": 2756.67, "timestamp": "00:45:56", "text": "谢谢。 那我来为你扫清障碍。"}, {"type": "subtitle", "time": 2759.829, "timestamp": "00:45:59", "text": "好的，正在接电话。 乔克正在"}]
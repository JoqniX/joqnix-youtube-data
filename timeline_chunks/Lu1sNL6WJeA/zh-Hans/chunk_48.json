[{"type": "subtitle", "time": 2883.349, "timestamp": "00:48:03", "text": "一种新型武器。 是的。"}, {"type": "subtitle", "time": 2886.55, "timestamp": "00:48:06", "text": "盲目使用武器会杀死一人。 这是什么？"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "你是做什么的？ 你是做什么的？ 我的天啊。"}, {"type": "subtitle", "time": 2892.29, "timestamp": "00:48:12", "text": "你是做什么的？ 你是做什么的？"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "我看到了射钉枪之类的东西。"}, {"type": "subtitle", "time": 2900.71, "timestamp": "00:48:20", "text": "[音乐]"}, {"type": "subtitle", "time": 2904.47, "timestamp": "00:48:24", "text": "就是用尽一切"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "可能的火力。 是的。 好的。   我的"}, {"type": "subtitle", "time": 2912.03, "timestamp": "00:48:32", "text": "天，太搞笑了。"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "等等，我们是不是把罐子掉地上了？ 我的天啊，我们真的做到了"}, {"type": "subtitle", "time": 2917.51, "timestamp": "00:48:37", "text": "。"}, {"type": "subtitle", "time": 2921.39, "timestamp": "00:48:41", "text": "我们难道不必这样做吗？ 我们必须。"}, {"type": "subtitle", "time": 2923.91, "timestamp": "00:48:43", "text": "嗯，没关系。 你们帮"}, {"type": "subtitle", "time": 2926.95, "timestamp": "00:48:46", "text": "我开路。 距离是200米。 没关系。 我们"}, {"type": "subtitle", "time": 2936.23, "timestamp": "00:48:56", "text": "直行。"}, {"type": "subtitle", "time": 2939.51, "timestamp": "00:48:59", "text": "附近好像有辆车之类的东西。"}]
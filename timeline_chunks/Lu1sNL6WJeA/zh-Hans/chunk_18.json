[{"type": "subtitle", "time": 1081.83, "timestamp": "00:18:01", "text": "不，还没有。   还"}, {"type": "subtitle", "time": 1084.95, "timestamp": "00:18:04", "text": "没有。 我听到了爆炸声。 你把"}, {"type": "subtitle", "time": 1087.029, "timestamp": "00:18:07", "text": "那座该死的桥炸了。 真的有"}, {"type": "subtitle", "time": 1089.669, "timestamp": "00:18:09", "text": "必要吗？ 哦，感谢上帝你活了下来。   是的"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "。 现在我欠你一个人情了，你这混蛋"}, {"type": "subtitle", "time": 1093.59, "timestamp": "00:18:13", "text": "。 我的天啊。 你这个混蛋"}, {"type": "subtitle", "time": 1096.47, "timestamp": "00:18:16", "text": "。 哇。 我也欠你一个人情。"}, {"type": "subtitle", "time": 1098.63, "timestamp": "00:18:18", "text": "看来你们都见过面。 我知道"}, {"type": "subtitle", "time": 1100.39, "timestamp": "00:18:20", "text": "这看起来是什么样子，但我向上帝发誓，我"}, {"type": "subtitle", "time": 1102.95, "timestamp": "00:18:22", "text": "没有恶意。 那不是我能控制的"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "。 是Sero。 那么，他究竟是谁？ 他"}, {"type": "subtitle", "time": 1107.909, "timestamp": "00:18:27", "text": "在一家私营企业工作。 他的"}, {"type": "subtitle", "time": 1109.99, "timestamp": "00:18:29", "text": "上级管辖我的上级，他们才是真正"}, {"type": "subtitle", "time": 1111.59, "timestamp": "00:18:31", "text": "做主的人。 我很抱歉"}, {"type": "subtitle", "time": 1113.029, "timestamp": "00:18:33", "text": "他们对你做了那样的事，但他不可能……"}, {"type": "subtitle", "time": 1117.35, "timestamp": "00:18:37", "text": "上校，他们到底在这里做什么？ 传闻他们正"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "试图将这种瘟疫武器化，用作"}, {"type": "subtitle", "time": 1121.99, "timestamp": "00:18:41", "text": "弓箭武器。 弓箭？ 我猜"}, {"type": "subtitle", "time": 1124.31, "timestamp": "00:18:44", "text": "你的血液里流淌着你的血液，"}, {"type": "subtitle", "time": 1128.15, "timestamp": "00:18:48", "text": "你知道这一点。 我的天啊，糟了。"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "好的，我打算跳过过场动画。"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "士兵，这是你的命令。"}, {"type": "subtitle", "time": 1135.35, "timestamp": "00:18:55", "text": "去你妈的。 你听我说。"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "语言"}]
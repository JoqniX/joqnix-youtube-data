[{"type": "subtitle", "time": 3541.43, "timestamp": "00:59:01", "text": "他还一击就击倒了我，老兄。"}, {"type": "subtitle", "time": 3543.51, "timestamp": "00:59:03", "text": "搞什么鬼？ 而且，他还狠狠地训斥了他。 好吧，没事了"}, {"type": "subtitle", "time": 3545.99, "timestamp": "00:59:05", "text": "。 有道理。 自我毁灭。"}, {"type": "subtitle", "time": 3549.03, "timestamp": "00:59:09", "text": "没错，就是自我毁灭。"}, {"type": "subtitle", "time": 3551.19, "timestamp": "00:59:11", "text": "有时候你必须牺牲自己。"}, {"type": "subtitle", "time": 3571.27, "timestamp": "00:59:31", "text": "恶棍。 我的天啊。 有多少僵尸"}, {"type": "subtitle", "time": 3573.67, "timestamp": "00:59:33", "text": "？ 顺便说一句，我一般不喜欢近战"}, {"type": "subtitle", "time": 3576.47, "timestamp": "00:59:36", "text": "。"}, {"type": "subtitle", "time": 3579.51, "timestamp": "00:59:39", "text": "谁杀了我？"}, {"type": "subtitle", "time": 3581.589, "timestamp": "00:59:41", "text": "我甚至不恨那个恶棍。 好吧，我甚至都不"}, {"type": "subtitle", "time": 3583.75, "timestamp": "00:59:43", "text": "恨那个恶棍。 别打"}, {"type": "subtitle", "time": 3586.71, "timestamp": "00:59:46", "text": "我了，你这个混蛋。 我没有近"}, {"type": "subtitle", "time": 3595.109, "timestamp": "00:59:55", "text": "，开始了。"}, {"type": "subtitle", "time": 3597.349, "timestamp": "00:59:57", "text": "你为什么不能？你为什么不能不用"}]
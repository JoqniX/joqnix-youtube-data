[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "。是的，我玩密码师。"}, {"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "那么，你今天过得怎么样，运动"}, {"type": "subtitle", "time": 7504.709, "timestamp": "02:05:04", "text": "健将先生？你今天过得怎么样？因为城市那件事，压力很大。我的天啊。"}, {"type": "subtitle", "time": 7511.35, "timestamp": "02:05:11", "text": "但本来应该是美好的"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "一天。是的，本来应该是的。"}, {"type": "subtitle", "time": 7515.109, "timestamp": "02:05:15", "text": "是的。我的意思是， 你"}, {"type": "subtitle", "time": 7518.229, "timestamp": "02:05:18", "text": "很快又要搞合作了吧？对。跟韩国"}, {"type": "subtitle", "time": 7520.95, "timestamp": "02:05:20", "text": "虚拟主播合作。那次我要用"}, {"type": "subtitle", "time": 7523.109, "timestamp": "02:05:23", "text": "日语。希望我能撑"}, {"type": "subtitle", "time": 7525.39, "timestamp": "02:05:25", "text": "过去。"}, {"type": "subtitle", "time": 7528.55, "timestamp": "02:05:28", "text": "日语。我的天。得好好利用你的"}, {"type": "subtitle", "time": 7530.31, "timestamp": "02:05:30", "text": "技能了，你知道的。你"}, {"type": "subtitle", "time": 7531.75, "timestamp": "02:05:31", "text": "也得教我。你得教我"}, {"type": "subtitle", "time": 7536.87, "timestamp": "02:05:36", "text": "日语，Jo，你知道的。是的。我的天。"}, {"type": "subtitle", "time": 7541.83, "timestamp": "02:05:41", "text": "那会很有趣，我想开个"}, {"type": "subtitle", "time": 7544.39, "timestamp": "02:05:44", "text": "直播教大家印地语什么的"}, {"type": "subtitle", "time": 7545.99, "timestamp": "02:05:45", "text": "。正在加载。哦，是的。是的。"}, {"type": "subtitle", "time": 7550.87, "timestamp": "02:05:50", "text": "请教我吧。我的印地语很烂。"}, {"type": "subtitle", "time": 7552.229, "timestamp": "02:05:52", "text": "我会教你的，但只会说些"}, {"type": "subtitle", "time": 7558.709, "timestamp": "02:05:58", "text": "开玩笑的。开玩笑的。我的天哪"}]
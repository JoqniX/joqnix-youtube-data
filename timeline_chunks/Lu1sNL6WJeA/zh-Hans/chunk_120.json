[{"type": "subtitle", "time": 7203.75, "timestamp": "02:00:03", "text": "我有点儿发脾气什么的。你"}, {"type": "subtitle", "time": 7205.109, "timestamp": "02:00:05", "text": "应该庆幸我不是那种，你知道的，"}, {"type": "subtitle", "time": 7207.03, "timestamp": "02:00:07", "text": "严厉的教授。严厉的"}, {"type": "subtitle", "time": 7208.79, "timestamp": "02:00:08", "text": "教授会说：“哦，"}, {"type": "subtitle", "time": 7211.03, "timestamp": "02:00:11", "text": "你为什么迟到了？” 你迟到了5分钟。 你"}, {"type": "subtitle", "time": 7212.629, "timestamp": "02:00:12", "text": "应该提前5分钟到的。  “"}, {"type": "subtitle", "time": 7215.03, "timestamp": "02:00:15", "text": "搞什么鬼？”顺便说一句，这事儿就发生在我身上"}, {"type": "subtitle", "time": 7217.75, "timestamp": "02:00:17", "text": "。你知道吗？等等，其实……是的。是的"}, {"type": "subtitle", "time": 7219.31, "timestamp": "02:00:19", "text": "。"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "所以，我去上课了，对吧？我"}, {"type": "subtitle", "time": 7225.31, "timestamp": "02:00:25", "text": "迟到了5分钟。"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "凯特，让我跟你解释一下。"}, {"type": "subtitle", "time": 7232.39, "timestamp": "02:00:32", "text": "我上课迟到了5分钟，然后"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "我的教授看着我说："}, {"type": "subtitle", "time": 7236.55, "timestamp": "02:00:36", "text": "“你应该提前5分钟到。”"}, {"type": "subtitle", "time": 7238.55, "timestamp": "02:00:38", "text": "然后她就开始滔滔不绝地讲了10分钟，说我"}, {"type": "subtitle", "time": 7240.39, "timestamp": "02:00:40", "text": "应该提前5分钟到，说"}, {"type": "subtitle", "time": 7242.47, "timestamp": "02:00:42", "text": "我需要保持课堂秩序。然后"}, {"type": "subtitle", "time": 7244.79, "timestamp": "02:00:44", "text": "她对着全班同学"}, {"type": "subtitle", "time": 7247.589, "timestamp": "02:00:47", "text": "大发雷霆。之后，她又"}, {"type": "subtitle", "time": 7250.229, "timestamp": "02:00:50", "text": "讲了10分钟，"}, {"type": "subtitle", "time": 7253.43, "timestamp": "02:00:53", "text": "占用了大概25分钟的课堂时间。"}, {"type": "subtitle", "time": 7255.51, "timestamp": "02:00:55", "text": "她一直在抱怨"}, {"type": "subtitle", "time": 7257.43, "timestamp": "02:00:57", "text": "我们时间不够，没时间完成"}, {"type": "subtitle", "time": 7259.35, "timestamp": "02:00:59", "text": "教学大纲。你知道，我们"}]
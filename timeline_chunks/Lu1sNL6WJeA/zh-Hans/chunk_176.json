[{"type": "subtitle", "time": 10563.429, "timestamp": "02:56:03", "text": "你在这里？ 是的。 好了。 是的，你现在来了"}, {"type": "subtitle", "time": 10569.469, "timestamp": "02:56:09", "text": "。 我的法拉利里有一把格洛克手枪"}, {"type": "subtitle", "time": 10579.389, "timestamp": "02:56:19", "text": "啊，我的法拉利里有把格洛克手枪"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "。  17 发子弹。 我心想：“是啊，她"}, {"type": "subtitle", "time": 10586.07, "timestamp": "02:56:26", "text": "没事。” 愿奇迹"}, {"type": "subtitle", "time": 10594.07, "timestamp": "02:56:34", "text": "我当时感觉很棒。 我很喜欢你的歌。"}, {"type": "subtitle", "time": 10595.91, "timestamp": "02:56:35", "text": "我喜欢《我的"}, {"type": "subtitle", "time": 10600.269, "timestamp": "02:56:40", "text": "天哪》。 感觉震动有点太强烈了"}, {"type": "subtitle", "time": 10607.87, "timestamp": "02:56:47", "text": "上帝。"}, {"type": "subtitle", "time": 10610.309, "timestamp": "02:56:50", "text": "你在哪里？ 我根本看不到你。 哦，原来你在这儿啊"}, {"type": "subtitle", "time": 10615.07, "timestamp": "02:56:55", "text": "来啊，跟"}, {"type": "subtitle", "time": 10619.67, "timestamp": "02:56:59", "text": "我打一架。 像个男人一样跟我打。 拔出你的"}]
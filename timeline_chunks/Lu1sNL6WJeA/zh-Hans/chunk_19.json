[{"type": "subtitle", "time": 1140.07, "timestamp": "00:19:00", "text": "大师，说实话，你对他的期望是什么？"}, {"type": "subtitle", "time": 1145.51, "timestamp": "00:19:05", "text": "他对这些家伙说了些什么？ 我"}, {"type": "subtitle", "time": 1147.669, "timestamp": "00:19:07", "text": "其实预料到了这样的回答。"}, {"type": "subtitle", "time": 1149.909, "timestamp": "00:19:09", "text": "你看，我明白。 我们正在直播。"}, {"type": "subtitle", "time": 1152.63, "timestamp": "00:19:12", "text": "但是我们在这里时间不多了。"}, {"type": "subtitle", "time": 1154.39, "timestamp": "00:19:14", "text": "我们无法控制比赛结果，伙计。 它"}, {"type": "subtitle", "time": 1156.63, "timestamp": "00:19:16", "text": "即将被核弹摧毁。 是的。 哦，我们还可以"}, {"type": "subtitle", "time": 1158.63, "timestamp": "00:19:18", "text": "通过跳过过场动画来控制游戏"}, {"type": "subtitle", "time": 1161.99, "timestamp": "00:19:21", "text": "。 哦，你想跳过吗？ 好的，跳过。"}, {"type": "subtitle", "time": 1164.47, "timestamp": "00:19:24", "text": "我们为什么要关心这些？"}, {"type": "subtitle", "time": 1167.43, "timestamp": "00:19:27", "text": "过来。 你好。 嘿，大家把"}, {"type": "subtitle", "time": 1169.51, "timestamp": "00:19:29", "text": "声音关掉，不然"}, {"type": "subtitle", "time": 1173.11, "timestamp": "00:19:33", "text": "游戏开始后，我们弃牌的时候你们的声音就会被听到"}, {"type": "subtitle", "time": 1176.87, "timestamp": "00:19:36", "text": "。 我们来打开看看。"}, {"type": "subtitle", "time": 1179.83, "timestamp": "00:19:39", "text": "这是什么？ 哦，我关掉了语音"}, {"type": "subtitle", "time": 1183.43, "timestamp": "00:19:43", "text": "聊天。 哦，"}, {"type": "subtitle", "time": 1189.909, "timestamp": "00:19:49", "text": "我是在这里吗？ 是的。 在线游戏。"}, {"type": "subtitle", "time": 1191.27, "timestamp": "00:19:51", "text": "当然。 我们"}, {"type": "subtitle", "time": 1193.75, "timestamp": "00:19:53", "text": "去找那艘船之前不需要准备任何东西。 谁知道"}]
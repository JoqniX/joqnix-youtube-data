[{"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "最后一个幸存者。或者他们可以那样"}, {"type": "subtitle", "time": 8112.99, "timestamp": "02:15:12", "text": "接招。在你身后。"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "你身后和你面前。"}, {"type": "subtitle", "time": 8119.83, "timestamp": "02:15:19", "text": "空无一人。"}, {"type": "subtitle", "time": 8125.27, "timestamp": "02:15:25", "text": "没关系。这太难了。我瞄准了他，但是"}, {"type": "subtitle", "time": 8127.83, "timestamp": "02:15:27", "text": "游戏卡住了，所以我什么也做不了。"}, {"type": "subtitle", "time": 8130.39, "timestamp": "02:15:30", "text": "真可惜。"}, {"type": "subtitle", "time": 8143.229, "timestamp": "02:15:43", "text": "游戏大神要说话了，各位。"}, {"type": "subtitle", "time": 8147.189, "timestamp": "02:15:47", "text": "安静，游戏大神要说话了。"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "游戏大神。"}, {"type": "subtitle", "time": 8152.47, "timestamp": "02:15:52", "text": "好的。你最喜欢的游戏是什么？"}, {"type": "subtitle", "time": 8155.35, "timestamp": "02:15:55", "text": "最喜欢的游戏？嗯，这可真是个"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "难题，是吧？是"}]
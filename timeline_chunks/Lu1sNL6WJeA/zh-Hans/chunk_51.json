[{"type": "subtitle", "time": 3062.36, "timestamp": "00:51:02", "text": "哦，我要死了。"}, {"type": "subtitle", "time": 3075.63, "timestamp": "00:51:15", "text": "哦，"}, {"type": "subtitle", "time": 3078.71, "timestamp": "00:51:18", "text": "不。 哦不，我死定了。 不，不，别"}, {"type": "subtitle", "time": 3080.069, "timestamp": "00:51:20", "text": "担心。 不用担心。 别死。 不，别"}, {"type": "subtitle", "time": 3082.79, "timestamp": "00:51:22", "text": "死。"}, {"type": "subtitle", "time": 3085.19, "timestamp": "00:51:25", "text": "哦，我能让你复活吗？ 我"}, {"type": "subtitle", "time": 3088.99, "timestamp": "00:51:28", "text": "觉得其实并不重要。 就在附近。"}, {"type": "subtitle", "time": 3093.67, "timestamp": "00:51:33", "text": "是的，从某种意义上说，这其实是件好事。   就这样把"}, {"type": "subtitle", "time": 3096.71, "timestamp": "00:51:36", "text": "你踢出局。"}, {"type": "subtitle", "time": 3099.91, "timestamp": "00:51:39", "text": "水位还在上涨。 对，就是这样。"}, {"type": "subtitle", "time": 3107.829, "timestamp": "00:51:47", "text": "。 原来是这样啊？ 是的。"}, {"type": "subtitle", "time": 3115.349, "timestamp": "00:51:55", "text": "[掌声]"}]
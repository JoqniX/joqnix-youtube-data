[{"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "因为A点已经清空了。"}, {"type": "subtitle", "time": 7985.91, "timestamp": "02:13:05", "text": "没有清空。他之前在A点，但是……"}, {"type": "subtitle", "time": 7988.589, "timestamp": "02:13:08", "text": "不，他不是我。他在那儿。"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "我错过了他。"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "最后一个幸存者。我又错过了他"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "。是的，那边一个，那边一个"}, {"type": "subtitle", "time": 8000.83, "timestamp": "02:13:20", "text": "。"}, {"type": "subtitle", "time": 8002.95, "timestamp": "02:13:22", "text": "好吧，他们会看到我然后杀了"}, {"type": "subtitle", "time": 8005.589, "timestamp": "02:13:25", "text": "我，对吧？还剩一个敌人。我的"}, {"type": "subtitle", "time": 8007.629, "timestamp": "02:13:27", "text": "大招是……"}, {"type": "subtitle", "time": 8010.87, "timestamp": "02:13:30", "text": "啊，米安德拉是个好玩家。我想他"}, {"type": "subtitle", "time": 8012.709, "timestamp": "02:13:32", "text": "就是之前一枪爆头我们的那个人"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "。当然，他是我们"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "小队的主力。他为什么不行？"}, {"type": "subtitle", "time": 8021.669, "timestamp": "02:13:41", "text": "他是最强的玩家。 嗯，"}, {"type": "subtitle", "time": 8023.51, "timestamp": "02:13:43", "text": "没事。我会想办法解决"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "这家伙喜欢在中路狙击。是啊，"}, {"type": "subtitle", "time": 8034.229, "timestamp": "02:13:54", "text": "他确实喜欢。嗯，"}, {"type": "subtitle", "time": 8036.39, "timestamp": "02:13:56", "text": "我会杀了他。他有护盾。"}, {"type": "subtitle", "time": 8037.75, "timestamp": "02:13:57", "text": "所以很难"}]
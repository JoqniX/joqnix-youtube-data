[{"type": "subtitle", "time": 12302.389, "timestamp": "03:25:02", "text": "。 所以，我很抱歉。 为什么？   是的"}, {"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "。 嗯？ 例如，如果"}, {"type": "subtitle", "time": 12307.349, "timestamp": "03:25:07", "text": "有七个贝壳，它会随机"}, {"type": "subtitle", "time": 12309.269, "timestamp": "03:25:09", "text": "告诉你，哦，第四个贝壳是活的，"}, {"type": "subtitle", "time": 12311.59, "timestamp": "03:25:11", "text": "或者第四个贝壳是空白的，或者"}, {"type": "subtitle", "time": 12313.309, "timestamp": "03:25:13", "text": "第五个贝壳是活的。 差不多是"}, {"type": "subtitle", "time": 12315.99, "timestamp": "03:25:15", "text": "这样。 等等，我已经赢了。"}, {"type": "subtitle", "time": 12318.55, "timestamp": "03:25:18", "text": "应该有三轮比赛。"}, {"type": "subtitle", "time": 12321.269, "timestamp": "03:25:21", "text": "哦，我们是第二名。 是的。   好了"}, {"type": "subtitle", "time": 12328.429, "timestamp": "03:25:28", "text": "哦，音乐"}, {"type": "subtitle", "time": 12330.87, "timestamp": "03:25:30", "text": "变了。 我喜欢这个。 我喜欢这首"}, {"type": "subtitle", "time": 12337.99, "timestamp": "03:25:37", "text": "33."}, {"type": "subtitle", "time": 12341.67, "timestamp": "03:25:41", "text": "好，轮到你了。 老板，你打算怎么办"}, {"type": "subtitle", "time": 12344.07, "timestamp": "03:25:44", "text": "？"}, {"type": "subtitle", "time": 12347.03, "timestamp": "03:25:47", "text": "如何跳过一轮？ 跳过回合。 你"}, {"type": "subtitle", "time": 12349.75, "timestamp": "03:25:49", "text": "不能跳过你的回合。   我的"}, {"type": "subtitle", "time": 12351.429, "timestamp": "03:25:51", "text": "天哪。 我想这算是跳过轮次的一种方法吧"}, {"type": "subtitle", "time": 12359.91, "timestamp": "03:25:59", "text": "哦，我可以做到。"}]
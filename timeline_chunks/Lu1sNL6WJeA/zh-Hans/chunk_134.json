[{"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "一枪毙了他，你知道的。啊，护盾会保护"}, {"type": "subtitle", "time": 8073.709, "timestamp": "02:14:33", "text": "我觉得如果他在这里，他会把我们困住"}, {"type": "subtitle", "time": 8077.51, "timestamp": "02:14:37", "text": "。不。算了。他们都在开"}, {"type": "subtitle", "time": 8079.83, "timestamp": "02:14:39", "text": "爆。如果我能拿到一个人头，我就可以……"}, {"type": "subtitle", "time": 8083.51, "timestamp": "02:14:43", "text": "好的。我还有大招。我去"}, {"type": "subtitle", "time": 8085.47, "timestamp": "02:14:45", "text": "上路。先留着"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "。如果我们"}, {"type": "subtitle", "time": 8091.31, "timestamp": "02:14:51", "text": "变成3打2，那你应该……我觉得……"}, {"type": "subtitle", "time": 8098.39, "timestamp": "02:14:58", "text": "如果他们够聪明，他们会"}]
[{"type": "subtitle", "time": 12185.03, "timestamp": "03:23:05", "text": "好的。 我的天啊。 我有多少把刀"}, {"type": "subtitle", "time": 12186.95, "timestamp": "03:23:06", "text": "？ 哦，你看到那个"}, {"type": "subtitle", "time": 12189.349, "timestamp": "03:23:09", "text": "黑色的管状物了吗？"}, {"type": "subtitle", "time": 12191.349, "timestamp": "03:23:11", "text": "是的，基本上可以用来偷"}, {"type": "subtitle", "time": 12200.87, "timestamp": "03:23:20", "text": "。 两张空白，三条生命。 好的。"}, {"type": "subtitle", "time": 12203.19, "timestamp": "03:23:23", "text": "两张空白，三条生命。"}, {"type": "subtitle", "time": 12205.67, "timestamp": "03:23:25", "text": "好多东西啊。 交换"}, {"type": "subtitle", "time": 12208.269, "timestamp": "03:23:28", "text": "当前 shell 的极性。"}, {"type": "subtitle", "time": 12216.63, "timestamp": "03:23:36", "text": "呃，那是什么东西？ 你手里有"}, {"type": "subtitle", "time": 12220.309, "timestamp": "03:23:40", "text": "瓶可乐之类的东西，对吧？"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "我现在看不到我的物品，所以"}, {"type": "subtitle", "time": 12224.01, "timestamp": "03:23:44", "text": "无法告诉你。"}, {"type": "subtitle", "time": 12227.03, "timestamp": "03:23:47", "text": "[音乐]"}, {"type": "subtitle", "time": 12229.51, "timestamp": "03:23:49", "text": "我自己都不了解自己。 哦，你是说"}, {"type": "subtitle", "time": 12233.03, "timestamp": "03:23:53", "text": "啤酒吗？ 哦，对。 啤酒。 它会"}]
[{"type": "subtitle", "time": 3720.39, "timestamp": "01:02:00", "text": "。 哦，不。 不，是我治好了你。 我"}, {"type": "subtitle", "time": 3724.15, "timestamp": "01:02:04", "text": "治好了你。 哦好的。 天哪，他怎么这样"}, {"type": "subtitle", "time": 3725.87, "timestamp": "01:02:05", "text": "打我"}, {"type": "subtitle", "time": 3729.03, "timestamp": "01:02:09", "text": "？ 被普通僵尸轻击一次。"}, {"type": "subtitle", "time": 3748.309, "timestamp": "01:02:28", "text": "我需要一把开锁用的双人锁。"}, {"type": "subtitle", "time": 3750.63, "timestamp": "01:02:30", "text": "好吧，这算是一种技能。 那是一种技能。"}, {"type": "subtitle", "time": 3753.03, "timestamp": "01:02:33", "text": "你需要自己去研究一下。 好了，我"}, {"type": "subtitle", "time": 3758.549, "timestamp": "01:02:38", "text": "要去修理我的枪支，确切地说是武器。"}, {"type": "subtitle", "time": 3764.63, "timestamp": "01:02:44", "text": "[音乐]"}, {"type": "subtitle", "time": 3768.95, "timestamp": "01:02:48", "text": "我不太爱走路。 我的天啊。 我"}, {"type": "subtitle", "time": 3770.63, "timestamp": "01:02:50", "text": "不知道该怎么处理这些"}]
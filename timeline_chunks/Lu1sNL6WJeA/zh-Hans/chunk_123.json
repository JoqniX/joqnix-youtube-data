[{"type": "subtitle", "time": 7381.27, "timestamp": "02:03:01", "text": "要么就是游戏玩得很烂。就像"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "没有中间地带，你知道吗？"}, {"type": "subtitle", "time": 7386.87, "timestamp": "02:03:06", "text": "啊，"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "所以黄金段位的人要么是小号，要么就是"}, {"type": "subtitle", "time": 7392.55, "timestamp": "02:03:12", "text": "游戏玩得非常烂。"}, {"type": "subtitle", "time": 7394.149, "timestamp": "02:03:14", "text": "有时候你会遇到一些"}, {"type": "subtitle", "time": 7396.07, "timestamp": "02:03:16", "text": "有趣的人，但也仅此而已。你"}, {"type": "subtitle", "time": 7403.03, "timestamp": "02:03:23", "text": "升到黄金也很难，"}, {"type": "subtitle", "time": 7406.87, "timestamp": "02:03:26", "text": "因为白银，你知道的。是啊。"}, {"type": "subtitle", "time": 7408.79, "timestamp": "02:03:28", "text": "我还以为你经常玩排位赛呢"}, {"type": "subtitle", "time": 7411.27, "timestamp": "02:03:31", "text": "，不是吗？ 你？我们"}, {"type": "subtitle", "time": 7415.27, "timestamp": "02:03:35", "text": "在一场比赛里碰面了。我确定我们碰面了。是的。"}, {"type": "subtitle", "time": 7419.03, "timestamp": "02:03:39", "text": "大概一年前，我在白银段位打排位赛，然后我"}, {"type": "subtitle", "time": 7421.109, "timestamp": "02:03:41", "text": "看到了你。事情就是这样。显然，"}, {"type": "subtitle", "time": 7424.55, "timestamp": "02:03:44", "text": "你以前经常离线玩。啊，对。对。"}, {"type": "subtitle", "time": 7428.55, "timestamp": "02:03:48", "text": "对。就是那个骗人的把戏。"}, {"type": "subtitle", "time": 7431.43, "timestamp": "02:03:51", "text": "你干了那件事，然后我就"}, {"type": "subtitle", "time": 7433.189, "timestamp": "02:03:53", "text": "碰面了。我当时就想，“什么？” 等等，"}, {"type": "subtitle", "time": 7435.109, "timestamp": "02:03:55", "text": "Jocknick。”"}, {"type": "subtitle", "time": 7437.55, "timestamp": "02:03:57", "text": "然后我才意识到你也在直播"}]
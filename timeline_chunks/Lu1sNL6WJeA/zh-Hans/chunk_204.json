[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "，你挡了我的路，是不是？   是的"}, {"type": "subtitle", "time": 12242.229, "timestamp": "03:24:02", "text": "。"}, {"type": "subtitle", "time": 12245.349, "timestamp": "03:24:05", "text": "你知道我原本打算做什么吗？"}, {"type": "subtitle", "time": 12247.429, "timestamp": "03:24:07", "text": "很公平。"}, {"type": "subtitle", "time": 12251.15, "timestamp": "03:24:11", "text": "我会回答“是”。 是的。 是的。 我要去"}, {"type": "subtitle", "time": 12254.309, "timestamp": "03:24:14", "text": "Yoink。 你会怎样做？ 不，那"}, {"type": "subtitle", "time": 12257.71, "timestamp": "03:24:17", "text": "不是我的啤酒。 该死的。 好了，这样就"}, {"type": "subtitle", "time": 12260.87, "timestamp": "03:24:20", "text": "浪费了三条命。"}, {"type": "subtitle", "time": 12263.389, "timestamp": "03:24:23", "text": "你会怎样做？ 开枪打死"}, {"type": "subtitle", "time": 12267.349, "timestamp": "03:24:27", "text": "我。 我们走吧。 哦，我太喜欢我的好运了。 感谢"}, {"type": "subtitle", "time": 12269.03, "timestamp": "03:24:29", "text": "上帝。 我的天啊。 你会怎样"}, {"type": "subtitle", "time": 12271.67, "timestamp": "03:24:31", "text": "做？ 开枪打我？ 嗯？ 哦，等等。 我不能。"}, {"type": "subtitle", "time": 12273.75, "timestamp": "03:24:33", "text": "哦，"}, {"type": "subtitle", "time": 12275.429, "timestamp": "03:24:35", "text": "你打算怎么办？ 开枪打我？   是的"}, {"type": "subtitle", "time": 12283.99, "timestamp": "03:24:43", "text": "好吧，我要非常聪明地处理这件事"}, {"type": "subtitle", "time": 12286.75, "timestamp": "03:24:46", "text": "。"}, {"type": "subtitle", "time": 12290.15, "timestamp": "03:24:50", "text": "哦，这部手机有什么功能？"}, {"type": "subtitle", "time": 12292.95, "timestamp": "03:24:52", "text": "哦，等等。 哦，手机会告诉你，"}, {"type": "subtitle", "time": 12295.83, "timestamp": "03:24:55", "text": "它会告诉你贝壳在哪里，顺序"}, {"type": "subtitle", "time": 12299.349, "timestamp": "03:24:59", "text": "随机。 哦，对了，我赢了"}]
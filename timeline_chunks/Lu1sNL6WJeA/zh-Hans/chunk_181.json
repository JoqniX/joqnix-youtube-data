[{"type": "subtitle", "time": 10861.11, "timestamp": "03:01:01", "text": "屋顶上。"}, {"type": "subtitle", "time": 10864.469, "timestamp": "03:01:04", "text": "哪个屋顶？ 搞什么鬼？"}, {"type": "subtitle", "time": 10869.03, "timestamp": "03:01:09", "text": "我的天啊。 是的，我真的同意了。"}, {"type": "subtitle", "time": 10870.95, "timestamp": "03:01:10", "text": "你倒下了。 我知道。 我知道"}, {"type": "subtitle", "time": 10872.79, "timestamp": "03:01:12", "text": "你们两个正坐在角落里。 太"}, {"type": "subtitle", "time": 10875.03, "timestamp": "03:01:15", "text": "疯狂了。   是的"}, {"type": "subtitle", "time": 10876.79, "timestamp": "03:01:16", "text": "，我们最终会找到"}, {"type": "subtitle", "time": 10878.95, "timestamp": "03:01:18", "text": "彼此的。 或许是明天，或许是"}, {"type": "subtitle", "time": 10882.79, "timestamp": "03:01:22", "text": "后天。 你不知道。"}, {"type": "subtitle", "time": 10885.87, "timestamp": "03:01:25", "text": "我能听到你滑行的声音。   是的"}, {"type": "subtitle", "time": 10893.03, "timestamp": "03:01:33", "text": "你可以告诉我我是否更接近目标了"}, {"type": "subtitle", "time": 10899.11, "timestamp": "03:01:39", "text": "你听到我的脚步声了吗？"}, {"type": "subtitle", "time": 10901.269, "timestamp": "03:01:41", "text": "不。"}, {"type": "subtitle", "time": 10902.55, "timestamp": "03:01:42", "text": "当你开始听到“哦，你在那儿”的声音时告诉我"}, {"type": "subtitle", "time": 10914.309, "timestamp": "03:01:54", "text": "。 我的天啊。 我不能走，兄弟。 我"}]
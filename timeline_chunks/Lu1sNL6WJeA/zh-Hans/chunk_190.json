[{"type": "subtitle", "time": 11401.11, "timestamp": "03:10:01", "text": "哦，糟糕。 等等，你怎么知道的？"}, {"type": "subtitle", "time": 11403.429, "timestamp": "03:10:03", "text": "真的吗？ 不，是我妈妈做的。 所以我"}, {"type": "subtitle", "time": 11405.91, "timestamp": "03:10:05", "text": "跟你一起做饭。 啊，你直接问她就行了。"}, {"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "好的。 对了，你的烹饪"}, {"type": "subtitle", "time": 11411.269, "timestamp": "03:10:11", "text": "进展如何？ 比如说，你学会"}, {"type": "subtitle", "time": 11413.83, "timestamp": "03:10:13", "text": "做饭了吗？ 嗯，是的。 我忘了还有这"}, {"type": "subtitle", "time": 11416.23, "timestamp": "03:10:16", "text": "件事要做。"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "好的。 我必须学习。 是的。"}, {"type": "subtitle", "time": 11422.67, "timestamp": "03:10:22", "text": "去学吧，伙计。"}, {"type": "subtitle", "time": 11424.63, "timestamp": "03:10:24", "text": "[音乐]"}, {"type": "subtitle", "time": 11426.55, "timestamp": "03:10:26", "text": "我会做一些非常简单的菜"}, {"type": "subtitle", "time": 11429.51, "timestamp": "03:10:29", "text": "。"}, {"type": "subtitle", "time": 11430.87, "timestamp": "03:10:30", "text": "好的。 所以，你要拍嫌犯照了"}, {"type": "subtitle", "time": 11440.15, "timestamp": "03:10:40", "text": "好的。 其实我很喜欢《Buckshot》里的配乐"}, {"type": "subtitle", "time": 11442.309, "timestamp": "03:10:42", "text": "。"}, {"type": "subtitle", "time": 11444.79, "timestamp": "03:10:44", "text": "非常……我不知道该怎么形容"}, {"type": "subtitle", "time": 11447.07, "timestamp": "03:10:47", "text": "。 真"}, {"type": "subtitle", "time": 11450.82, "timestamp": "03:10:50", "text": "不错。 真他妈不错。"}, {"type": "subtitle", "time": 11452.07, "timestamp": "03:10:52", "text": "[音乐]"}, {"type": "subtitle", "time": 11454.429, "timestamp": "03:10:54", "text": "哦，是的。 顺便说一句，我终于……"}, {"type": "subtitle", "time": 11457.87, "timestamp": "03:10:57", "text": "我终于……你"}]
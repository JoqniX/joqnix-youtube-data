[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "。   是的"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "，不是说"}, {"type": "subtitle", "time": 1686.549, "timestamp": "00:28:06", "text": "只要你不是瞬间把他们杀了就没事"}, {"type": "subtitle", "time": 1689.35, "timestamp": "00:28:09", "text": "。 哦。 哦。 我的天啊。"}, {"type": "subtitle", "time": 1691.75, "timestamp": "00:28:11", "text": "乔，你在做什么？"}, {"type": "subtitle", "time": 1695.389, "timestamp": "00:28:15", "text": "什么？ 让我增加我的"}, {"type": "subtitle", "time": 1700.549, "timestamp": "00:28:20", "text": "积分。 可升级项。 战斗。"}, {"type": "subtitle", "time": 1711.16, "timestamp": "00:28:31", "text": "哦，这个人。"}, {"type": "subtitle", "time": 1719.59, "timestamp": "00:28:39", "text": "哦，好的。"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "我需要一把更好的枪。 我的天哪。"}, {"type": "subtitle", "time": 1735.51, "timestamp": "00:28:55", "text": "他打招呼的方式让我感觉自己"}, {"type": "subtitle", "time": 1737.75, "timestamp": "00:28:57", "text": "像个真人，"}, {"type": "subtitle", "time": 1739.909, "timestamp": "00:28:59", "text": "不，感觉就像有人在"}]
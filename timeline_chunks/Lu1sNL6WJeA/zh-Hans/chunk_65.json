[{"type": "subtitle", "time": 3900.95, "timestamp": "01:05:00", "text": "哦，我，我有这件武器。 那"}, {"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "我到底在干什么？ 好的，我这就去"}, {"type": "subtitle", "time": 3906.95, "timestamp": "01:05:06", "text": "装备上。"}, {"type": "subtitle", "time": 3910.309, "timestamp": "01:05:10", "text": "你能打造武器吗？"}, {"type": "subtitle", "time": 3913.349, "timestamp": "01:05:13", "text": "不，不，不，不，不，不，不。 我 我 我 我"}, {"type": "subtitle", "time": 3916.39, "timestamp": "01:05:16", "text": "拥有这个 就像 武器 需要 2 级"}, {"type": "subtitle", "time": 3919.51, "timestamp": "01:05:19", "text": "锁定 我们见证技能。 是的。 呃，让我来点"}, {"type": "subtitle", "time": 3921.67, "timestamp": "01:05:21", "text": "技能点吧。 我根本就没做"}, {"type": "subtitle", "time": 3923.75, "timestamp": "01:05:23", "text": "那种事。"}, {"type": "subtitle", "time": 3927.43, "timestamp": "01:05:27", "text": "鲨鱼没有任何技能点，但仍然"}, {"type": "subtitle", "time": 3930.63, "timestamp": "01:05:30", "text": "比我们更擅长击败僵尸。 什么？ 该死。"}, {"type": "subtitle", "time": 3945.549, "timestamp": "01:05:45", "text": "等待。"}, {"type": "subtitle", "time": 3949.789, "timestamp": "01:05:49", "text": "等等，我还有"}, {"type": "subtitle", "time": 3953.43, "timestamp": "01:05:53", "text": "技能升级的机会吗？ 五。 哦，是"}, {"type": "subtitle", "time": 3956.109, "timestamp": "01:05:56", "text": "黑色的那款。 好的。"}]
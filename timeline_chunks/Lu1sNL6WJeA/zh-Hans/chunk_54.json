[{"type": "subtitle", "time": 3244.79, "timestamp": "00:54:04", "text": "帮我。 你想要什么我都给你"}, {"type": "subtitle", "time": 3247.12, "timestamp": "00:54:07", "text": "。"}, {"type": "subtitle", "time": 3252.79, "timestamp": "00:54:12", "text": "我的天哪。 我讨厌为什么？为什么我要开这种"}, {"type": "subtitle", "time": 3256.15, "timestamp": "00:54:16", "text": "愚蠢的玩笑？"}, {"type": "subtitle", "time": 3258.65, "timestamp": "00:54:18", "text": "哦，夜晚和指关节。 好的。"}, {"type": "subtitle", "time": 3264.88, "timestamp": "00:54:24", "text": "我的"}, {"type": "subtitle", "time": 3269.829, "timestamp": "00:54:29", "text": "天哪[掌声]，我死了。"}, {"type": "subtitle", "time": 3272.23, "timestamp": "00:54:32", "text": "原来我的意思就是这样。 任何你"}, {"type": "subtitle", "time": 3280.549, "timestamp": "00:54:40", "text": "哦，你赔钱了。"}, {"type": "subtitle", "time": 3284.63, "timestamp": "00:54:44", "text": "我的天哪，我亏钱了。"}, {"type": "subtitle", "time": 3299.589, "timestamp": "00:54:59", "text": "她用头撞了我。 直接踢他一脚就行了，兄弟。"}]
[{"type": "subtitle", "time": 1981.07, "timestamp": "00:33:01", "text": "外骨骼的样子，或者像"}, {"type": "subtitle", "time": 1990.07, "timestamp": "00:33:10", "text": "红色的样子。 哦，看，那里有苹果。"}, {"type": "subtitle", "time": 1991.509, "timestamp": "00:33:11", "text": "等等，你是想"}, {"type": "subtitle", "time": 1993.909, "timestamp": "00:33:13", "text": "交易什么东西吗？"}, {"type": "subtitle", "time": 1996.31, "timestamp": "00:33:16", "text": "嗯，我不小心按到了交易。"}, {"type": "subtitle", "time": 1997.669, "timestamp": "00:33:17", "text": "哦，是的。 我当时在想，等等，等等，"}, {"type": "subtitle", "time": 2003.029, "timestamp": "00:33:23", "text": "哦，"}, {"type": "subtitle", "time": 2006.71, "timestamp": "00:33:26", "text": "背景音乐是​​什么？"}, {"type": "subtitle", "time": 2009.83, "timestamp": "00:33:29", "text": "你有音乐之类的东西吗？ 是的。   没事"}, {"type": "subtitle", "time": 2026.389, "timestamp": "00:33:46", "text": "，他很享受生活。"}, {"type": "subtitle", "time": 2027.99, "timestamp": "00:33:47", "text": "等等，等等，让我踢他一脚。 等等，"}, {"type": "subtitle", "time": 2030.63, "timestamp": "00:33:50", "text": "让我……让我……让我砸碎他的头骨。 糟了"}, {"type": "subtitle", "time": 2034.47, "timestamp": "00:33:54", "text": "，他死了。 天然气和石油。   里"}, {"type": "subtitle", "time": 2038.63, "timestamp": "00:33:58", "text": "约，住手！ 他已经死了。 抱歉，"}]
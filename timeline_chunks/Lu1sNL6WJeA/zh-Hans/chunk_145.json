[{"type": "subtitle", "time": 8709.23, "timestamp": "02:25:09", "text": "退出被捅了。是"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "啊。可怜的家伙。他被捅了。而且他"}, {"type": "subtitle", "time": 8713.83, "timestamp": "02:25:13", "text": "父母正在离婚。他在哪儿"}, {"type": "subtitle", "time": 8716.03, "timestamp": "02:25:16", "text": "？"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "好的，我打开游戏了。哦，等等。"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "不，等等。还没。还没。是啊，我"}, {"type": "subtitle", "time": 8731.51, "timestamp": "02:25:31", "text": "想我打开了。但愿如此。所以，你知道这"}, {"type": "subtitle", "time": 8734.07, "timestamp": "02:25:34", "text": "游戏讲的是什么，对吧？"}, {"type": "subtitle", "time": 8735.429, "timestamp": "02:25:35", "text": "你 你 我知道我们要"}, {"type": "subtitle", "time": 8738.23, "timestamp": "02:25:38", "text": "互相残杀。是的。"}, {"type": "subtitle", "time": 8741.95, "timestamp": "02:25:41", "text": "好的。"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "呃，问题是，你觉得你能"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "杀了我吗？"}, {"type": "subtitle", "time": 8751.91, "timestamp": "02:25:51", "text": "嗯，不知道。哦，好吧，我可能已经"}, {"type": "subtitle", "time": 8754.07, "timestamp": "02:25:54", "text": "卸载了。哦，"}]
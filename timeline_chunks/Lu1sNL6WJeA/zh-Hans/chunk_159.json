[{"type": "subtitle", "time": 9540.429, "timestamp": "02:39:00", "text": "坎耶的攻击。耶。"}, {"type": "subtitle", "time": 9543.59, "timestamp": "02:39:03", "text": "哦，该死。这是什么游戏？我赢了。我"}, {"type": "subtitle", "time": 9545.59, "timestamp": "02:39:05", "text": "想我赢了。"}, {"type": "subtitle", "time": 9549.11, "timestamp": "02:39:09", "text": "几局？六局。"}, {"type": "subtitle", "time": 9552.96, "timestamp": "02:39:12", "text": "来和我跳舞。来吧。"}, {"type": "subtitle", "time": 9559.59, "timestamp": "02:39:19", "text": "好，开始。再来一局。开始。"}]
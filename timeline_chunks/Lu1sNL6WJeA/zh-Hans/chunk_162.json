[{"type": "subtitle", "time": 9724.15, "timestamp": "02:42:04", "text": "哦，等等。那不是你。哦，"}, {"type": "subtitle", "time": 9725.59, "timestamp": "02:42:05", "text": "你在看什么？你在看什么？我当时在"}, {"type": "subtitle", "time": 9728.389, "timestamp": "02:42:08", "text": "看那边的蓝色东西。我当时"}, {"type": "subtitle", "time": 9731.11, "timestamp": "02:42:11", "text": "想，“等等，那是你，对吧？”"}, {"type": "subtitle", "time": 9738.03, "timestamp": "02:42:18", "text": "哦，不错。如果你双持的话"}, {"type": "subtitle", "time": 9753.23, "timestamp": "02:42:33", "text": "哦，我们互相残杀了。哇。我的天"}, {"type": "subtitle", "time": 9755.349, "timestamp": "02:42:35", "text": "。我想应该是先杀两人的。"}, {"type": "subtitle", "time": 9762.71, "timestamp": "02:42:42", "text": "哦，我手雷用得太早了。哦，"}, {"type": "subtitle", "time": 9764.79, "timestamp": "02:42:44", "text": "等等。我被自己的手雷炸死了。喂。"}, {"type": "subtitle", "time": 9774.59, "timestamp": "02:42:54", "text": "手榴弹。 实际上，这个家伙的保险丝很短"}, {"type": "subtitle", "time": 9778.11, "timestamp": "02:42:58", "text": "。 哦，不。 你打"}]
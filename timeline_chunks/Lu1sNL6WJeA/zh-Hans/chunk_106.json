[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "我们都是外国人，对吧？"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "去一个陌生的地方，去一个"}, {"type": "subtitle", "time": 6366.229, "timestamp": "01:46:06", "text": "主要"}, {"type": "subtitle", "time": 6368.709, "timestamp": "01:46:08", "text": "语言不同的国家，对吧？"}, {"type": "subtitle", "time": 6373.99, "timestamp": "01:46:13", "text": "你会得到外国人通行证，所以没"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "不是每个人都能"}, {"type": "chat", "time": 6382.436, "timestamp": "01:46:22", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i mean there must be some other indian people there too right?"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "更快地掌握一门语言。 不，每个人都有自己的"}, {"type": "subtitle", "time": 6385.91, "timestamp": "01:46:25", "text": "节奏。 现在对你来说会更"}, {"type": "subtitle", "time": 6387.83, "timestamp": "01:46:27", "text": "容易、更快捷，因为你投入了"}, {"type": "subtitle", "time": 6390.59, "timestamp": "01:46:30", "text": "时间和精力。 对"}, {"type": "subtitle", "time": 6393.43, "timestamp": "01:46:33", "text": "我来说，我没有投入时间。 我像个"}, {"type": "subtitle", "time": 6396.629, "timestamp": "01:46:36", "text": "傻瓜一样浪费了时间。 我本来可以的"}, {"type": "chat", "time": 6401.26, "timestamp": "01:46:41", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "@Lord HeadAss there's a whole ahh village in japan of indians"}, {"type": "subtitle", "time": 6402.07, "timestamp": "01:46:42", "text": "，但是没关系。 我会到场"}, {"type": "subtitle", "time": 6404.51, "timestamp": "01:46:44", "text": "告诉你。 我跟"}, {"type": "subtitle", "time": 6407.43, "timestamp": "01:46:47", "text": "你说过，你知道，我能看到这一点。 我已经"}, {"type": "subtitle", "time": 6409.83, "timestamp": "01:46:49", "text": "能预见到这一点了"}, {"type": "subtitle", "time": 6412.189, "timestamp": "01:46:52", "text": "。 我会说："}, {"type": "subtitle", "time": 6416.149, "timestamp": "01:46:56", "text": "“Mo，Mo，等"}, {"type": "subtitle", "time": 6418.55, "timestamp": "01:46:58", "text": "我到日本一周或一个月后，我会私信你。我会说，"}]
[{"type": "subtitle", "time": 486.469, "timestamp": "00:08:06", "text": "哦，乔克。"}, {"type": "subtitle", "time": 488.309, "timestamp": "00:08:08", "text": "你是僵尸吗？ 不，他不是。 不，"}, {"type": "subtitle", "time": 495.029, "timestamp": "00:08:15", "text": "等等，你怎么知道怎么改变"}, {"type": "subtitle", "time": 498.309, "timestamp": "00:08:18", "text": "声音？ 比如，哦，你需要"}, {"type": "subtitle", "time": 499.909, "timestamp": "00:08:19", "text": "从你那边把它关掉之类的。 哦，没事了"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "所以，这就像是我们在探索之类的"}, {"type": "subtitle", "time": 513.43, "timestamp": "00:08:33", "text": "，对吧？ 不，我们需要"}, {"type": "subtitle", "time": 516.79, "timestamp": "00:08:36", "text": "返回营地。 就这么简单。"}, {"type": "subtitle", "time": 518.389, "timestamp": "00:08:38", "text": "哦，你是不是在跟着我说话？"}, {"type": "subtitle", "time": 519.99, "timestamp": "00:08:39", "text": "东部的一个小村庄。 不，我在做"}, {"type": "subtitle", "time": 522.79, "timestamp": "00:08:42", "text": "别的事。 我好像在一个小屋之类的地方"}, {"type": "subtitle", "time": 525.269, "timestamp": "00:08:45", "text": "。 不，快离开那里。"}, {"type": "subtitle", "time": 527.63, "timestamp": "00:08:47", "text": "跟着我来。"}, {"type": "subtitle", "time": 530.23, "timestamp": "00:08:50", "text": "咱们玩游戏吧，这样我们就可以到处"}, {"type": "subtitle", "time": 532.07, "timestamp": "00:08:52", "text": "杀僵尸了，伙计。"}, {"type": "subtitle", "time": 534.87, "timestamp": "00:08:54", "text": "很遗憾。 是的。 一种奇怪的疾病"}, {"type": "subtitle", "time": 537.67, "timestamp": "00:08:57", "text": "席卷了整个村庄。"}]
[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "尝试剪辑它。"}, {"type": "subtitle", "time": 9905.55, "timestamp": "02:45:05", "text": "乔克。 那到底是什么鬼东西？ 我当时有一把"}, {"type": "subtitle", "time": 9909.07, "timestamp": "02:45:09", "text": "猎枪。 打扰一下。"}, {"type": "subtitle", "time": 9916.95, "timestamp": "02:45:16", "text": "催眠镜检查。 实际上，要进行范围界定。 好了，就是这样"}, {"type": "subtitle", "time": 9929.67, "timestamp": "02:45:29", "text": "哦，你好啊。 哈尔，我们追求的是同一"}, {"type": "subtitle", "time": 9933.03, "timestamp": "02:45:33", "text": "件事，对吧？"}, {"type": "subtitle", "time": 9935.59, "timestamp": "02:45:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 9938.63, "timestamp": "02:45:38", "text": "什么？ 我两个都要。"}, {"type": "subtitle", "time": 9941.11, "timestamp": "02:45:41", "text": "我们互相残杀了。 我的意思是，我害死了我们俩"}, {"type": "subtitle", "time": 9954.23, "timestamp": "02:45:54", "text": "不要。 哦，我的瞄准镜灵敏度"}, {"type": "subtitle", "time": 9957.309, "timestamp": "02:45:57", "text": "太高了。 我完全没有"}]
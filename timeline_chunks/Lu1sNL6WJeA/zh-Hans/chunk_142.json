[{"type": "subtitle", "time": 8532.75, "timestamp": "02:22:12", "text": "好了，好多人都在中路。我的"}, {"type": "subtitle", "time": 8535.91, "timestamp": "02:22:15", "text": "天，我应该激活我的笼子。我拿到了"}, {"type": "subtitle", "time": 8544.469, "timestamp": "02:22:24", "text": "最后一个玩家。兄弟，"}, {"type": "subtitle", "time": 8552.55, "timestamp": "02:22:32", "text": "哦不。"}, {"type": "subtitle", "time": 8566.67, "timestamp": "02:22:46", "text": "老天。我看了你两"}, {"type": "subtitle", "time": 8575.27, "timestamp": "02:22:55", "text": "是我见过的最精彩的片段。"}]
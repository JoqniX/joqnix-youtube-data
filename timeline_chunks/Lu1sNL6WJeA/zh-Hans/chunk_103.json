[{"type": "subtitle", "time": 6190.79, "timestamp": "01:43:10", "text": "你本来可以在直播中学习的。 啊，是的"}, {"type": "subtitle", "time": 6192.83, "timestamp": "01:43:12", "text": "。 我本可以把"}, {"type": "subtitle", "time": 6196.03, "timestamp": "01:43:16", "text": "你的学业搞砸得这么厉害。   是的"}, {"type": "subtitle", "time": 6200.35, "timestamp": "01:43:20", "text": "。 所以，我要直播24"}, {"type": "subtitle", "time": 6207.43, "timestamp": "01:43:27", "text": "。 感觉我上个月就能做这件事"}, {"type": "subtitle", "time": 6210.709, "timestamp": "01:43:30", "text": "，而不是这个月。 这个月我"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "就知道我会更忙，"}, {"type": "subtitle", "time": 6216.31, "timestamp": "01:43:36", "text": "因为有很多"}, {"type": "subtitle", "time": 6218.149, "timestamp": "01:43:38", "text": "合作项目要找我。 不，我不称之为"}, {"type": "subtitle", "time": 6220.91, "timestamp": "01:43:40", "text": "合作。 更像是朋友"}, {"type": "subtitle", "time": 6223.91, "timestamp": "01:43:43", "text": "聚会。 离开之前，我想和他们一起享受最后的快乐时光"}, {"type": "subtitle", "time": 6230.07, "timestamp": "01:43:50", "text": "。 而且这不像是最终的"}, {"type": "subtitle", "time": 6232.189, "timestamp": "01:43:52", "text": "告别，但是"}, {"type": "subtitle", "time": 6234.35, "timestamp": "01:43:54", "text": "嗯，是的，"}, {"type": "subtitle", "time": 6236.99, "timestamp": "01:43:56", "text": "所以"}, {"type": "subtitle", "time": 6239.229, "timestamp": "01:43:59", "text": "[音乐]"}]
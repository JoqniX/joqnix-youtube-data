[{"type": "subtitle", "time": 1380.07, "timestamp": "00:23:00", "text": "片刻。"}, {"type": "subtitle", "time": 1383.75, "timestamp": "00:23:03", "text": "我想买牛奶。 稍等片刻。"}, {"type": "subtitle", "time": 1386.63, "timestamp": "00:23:06", "text": "前院有人吗"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "看看。 好吧，里面一个人都没有。"}, {"type": "subtitle", "time": 1403.11, "timestamp": "00:23:23", "text": "好吧，为了以防万一，我还是把摄像头开着吧"}, {"type": "subtitle", "time": 1406.31, "timestamp": "00:23:26", "text": "。 哦，等等。 哦，等等。 等待。"}, {"type": "subtitle", "time": 1409.59, "timestamp": "00:23:29", "text": "听着，伙计。"}, {"type": "subtitle", "time": 1429.149, "timestamp": "00:23:49", "text": "哦"}, {"type": "subtitle", "time": 1432.549, "timestamp": "00:23:52", "text": "好的。 这样就够了吗？ 我觉得这已经"}, {"type": "subtitle", "time": 1436.07, "timestamp": "00:23:56", "text": "足够了。"}, {"type": "subtitle", "time": 1439.11, "timestamp": "00:23:59", "text": "我的燃烧器在哪儿？"}]
[{"type": "subtitle", "time": 9074.71, "timestamp": "02:31:14", "text": "好吧，我……我卡住了。不，我卡住了。"}, {"type": "subtitle", "time": 9096.469, "timestamp": "02:31:36", "text": "不。哦，其实打得不错。哇。"}, {"type": "subtitle", "time": 9098.4, "timestamp": "02:31:38", "text": "我很惊讶。"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "不。"}, {"type": "subtitle", "time": 9112.23, "timestamp": "02:31:52", "text": "哦，打得不错。你在干什么？"}, {"type": "subtitle", "time": 9115.11, "timestamp": "02:31:55", "text": "你只是在到处乱动。我的天。"}, {"type": "subtitle", "time": 9117.349, "timestamp": "02:31:57", "text": "你像猴子一样跳来跳去。"}]
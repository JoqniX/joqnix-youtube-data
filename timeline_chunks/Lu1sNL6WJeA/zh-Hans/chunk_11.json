[{"type": "subtitle", "time": 660.03, "timestamp": "00:11:00", "text": "火焰特效一样。 有毒药。 是的"}, {"type": "subtitle", "time": 667.91, "timestamp": "00:11:07", "text": "。 你在哪里？ 哦，"}, {"type": "subtitle", "time": 669.91, "timestamp": "00:11:09", "text": "维克去哪儿了？"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "我很快就会加入。 我很快就会加入。   稍等"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "片刻。 我只是重新启动了我的"}, {"type": "subtitle", "time": 676.63, "timestamp": "00:11:16", "text": "oboose，因为 obus 运行正常。 好的。"}, {"type": "subtitle", "time": 684.069, "timestamp": "00:11:24", "text": "该死。 我看到人。 是的。 战斗时刻到了。"}, {"type": "subtitle", "time": 686.509, "timestamp": "00:11:26", "text": "快点。 匆忙。 匆忙。"}, {"type": "subtitle", "time": 689.19, "timestamp": "00:11:29", "text": "匆忙。 耶。"}, {"type": "subtitle", "time": 690.59, "timestamp": "00:11:30", "text": "我的"}, {"type": "subtitle", "time": 693.75, "timestamp": "00:11:33", "text": "天啊。 我的天啊。 别这么执着"}, {"type": "subtitle", "time": 695.15, "timestamp": "00:11:35", "text": "于"}, {"type": "subtitle", "time": 697.23, "timestamp": "00:11:37", "text": "我。"}, {"type": "subtitle", "time": 700.75, "timestamp": "00:11:40", "text": "妈的，兄弟。"}, {"type": "subtitle", "time": 704.47, "timestamp": "00:11:44", "text": "搞什么鬼？ 这到底是怎么回事？ 踢他一脚。"}, {"type": "subtitle", "time": 705.47, "timestamp": "00:11:45", "text": "我要"}, {"type": "subtitle", "time": 716.31, "timestamp": "00:11:56", "text": "好的。 去他妈的。 就待在那儿别动。"}]
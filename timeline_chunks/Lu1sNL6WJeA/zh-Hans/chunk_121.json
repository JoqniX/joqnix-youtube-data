[{"type": "subtitle", "time": 7261.83, "timestamp": "02:01:01", "text": "现在就得开始。我们得跟上进度。与此同时，"}, {"type": "subtitle", "time": 7264.87, "timestamp": "02:01:04", "text": "半节课的时间就这么浪费了。"}, {"type": "subtitle", "time": 7271.189, "timestamp": "02:01:11", "text": "我当时就站在"}, {"type": "subtitle", "time": 7273.03, "timestamp": "02:01:13", "text": "那里。我不得不站在那里。 整整25"}, {"type": "subtitle", "time": 7274.39, "timestamp": "02:01:14", "text": "分钟。她甚至都不让我"}, {"type": "subtitle", "time": 7278.39, "timestamp": "02:01:18", "text": "坐下。你敢信？什么？我"}, {"type": "subtitle", "time": 7279.91, "timestamp": "02:01:19", "text": "不知道。我不"}, {"type": "subtitle", "time": 7281.51, "timestamp": "02:01:21", "text": "知道这些人怎么了。我完全摸不着头脑。"}, {"type": "subtitle", "time": 7286.87, "timestamp": "02:01:26", "text": "嗯，没关系。这只是"}, {"type": "subtitle", "time": 7289.629, "timestamp": "02:01:29", "text": "教授的例行公事，"}, {"type": "subtitle", "time": 7292.47, "timestamp": "02:01:32", "text": "你还"}, {"type": "subtitle", "time": 7294.39, "timestamp": "02:01:34", "text": "好吗？呃，它卡在加载"}, {"type": "subtitle", "time": 7297.189, "timestamp": "02:01:37", "text": "界面了。好的，我进去了。呃，你的ID是什么"}, {"type": "subtitle", "time": 7300.31, "timestamp": "02:01:40", "text": "？呃，发到Discord里吧。我加你。"}, {"type": "subtitle", "time": 7302.229, "timestamp": "02:01:42", "text": "好的。好的。"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "我喜欢Discord，它就像……呃，该怎么"}, {"type": "subtitle", "time": 7308.47, "timestamp": "02:01:48", "text": "称呼它呢？就像低流量模式，对吧？"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "你的头像都没加载出来。"}, {"type": "subtitle", "time": 7313.83, "timestamp": "02:01:53", "text": "是吗？哦，真的吗？你看不到我的"}, {"type": "subtitle", "time": 7317.35, "timestamp": "02:01:57", "text": "头像？我的……不，它是黑色的。它是空白的。我的天哪。"}]
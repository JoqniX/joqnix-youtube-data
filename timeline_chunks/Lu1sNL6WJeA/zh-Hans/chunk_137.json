[{"type": "subtitle", "time": 8224.95, "timestamp": "02:17:04", "text": "对。来啊，兄弟。来啊。你"}, {"type": "subtitle", "time": 8227.349, "timestamp": "02:17:07", "text": "想杀了我。你想杀了我，对吧？"}, {"type": "subtitle", "time": 8236.709, "timestamp": "02:17:16", "text": "啊，我掉线了。差点掉线。真惨。"}, {"type": "subtitle", "time": 8240.509, "timestamp": "02:17:20", "text": "他们从中间过来。"}, {"type": "subtitle", "time": 8242.79, "timestamp": "02:17:22", "text": "小心。哦，还有，好像在我们后面"}, {"type": "subtitle", "time": 8244.91, "timestamp": "02:17:24", "text": "。我的天"}, {"type": "subtitle", "time": 8248.669, "timestamp": "02:17:28", "text": "。中间，中间，中间。这里没人"}, {"type": "subtitle", "time": 8253.27, "timestamp": "02:17:33", "text": "。他们现在就在我们眼前了。砰。"}, {"type": "subtitle", "time": 8254.709, "timestamp": "02:17:34", "text": "好了，他们从你"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "之前观察的方向过来。"}, {"type": "subtitle", "time": 8259.19, "timestamp": "02:17:39", "text": "还剩一个敌人。还有一个。还有一个。"}, {"type": "subtitle", "time": 8262.27, "timestamp": "02:17:42", "text": "最后一个玩家。是线粒体。"}, {"type": "subtitle", "time": 8266.23, "timestamp": "02:17:46", "text": "小心。线粒体。"}, {"type": "subtitle", "time": 8268.469, "timestamp": "02:17:48", "text": "他现在在尖刺上。凯文，你"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "可以晕住他。"}, {"type": "subtitle", "time": 8273.589, "timestamp": "02:17:53", "text": "我没看到他。"}, {"type": "subtitle", "time": 8276.23, "timestamp": "02:17:56", "text": "兄弟真聪明。精神控制太"}, {"type": "subtitle", "time": 8277.83, "timestamp": "02:17:57", "text": "厉害了。是"}]
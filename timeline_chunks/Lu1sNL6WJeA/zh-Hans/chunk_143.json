[{"type": "subtitle", "time": 8583.55, "timestamp": "02:23:03", "text": "尤其是最后那声该死的尖叫"}, {"type": "subtitle", "time": 8601.349, "timestamp": "02:23:21", "text": "我们要把它重新放回去吗？我不知道"}, {"type": "subtitle", "time": 8610.389, "timestamp": "02:23:30", "text": "哦，他们是B。耶。我很高兴他们"}, {"type": "subtitle", "time": 8620.23, "timestamp": "02:23:40", "text": "有人是B。我的天。"}, {"type": "subtitle", "time": 8623.75, "timestamp": "02:23:43", "text": "也许我们应该玩斯特拉思的头。"}, {"type": "subtitle", "time": 8625.389, "timestamp": "02:23:45", "text": "怎么样？"}, {"type": "subtitle", "time": 8628.23, "timestamp": "02:23:48", "text": "好，走吧。我已经安装好了。我们"}]
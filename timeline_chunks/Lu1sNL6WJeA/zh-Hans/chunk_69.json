[{"type": "subtitle", "time": 4142.47, "timestamp": "01:09:02", "text": "卸载了它。   该死的"}, {"type": "subtitle", "time": 4145.59, "timestamp": "01:09:05", "text": "，杰克。"}, {"type": "subtitle", "time": 4148.55, "timestamp": "01:09:08", "text": "为什么？ 为什么会有"}, {"type": "subtitle", "time": 4151.91, "timestamp": "01:09:11", "text": "这个游戏？因为没有空间容纳它。 好的。 没有空间了。 你"}, {"type": "subtitle", "time": 4156.47, "timestamp": "01:09:16", "text": "没有地方放八个G。 真的吗？"}, {"type": "subtitle", "time": 4158.55, "timestamp": "01:09:18", "text": "为什么？ 我以前也有过这个。 我敢肯定这"}, {"type": "subtitle", "time": 4163.669, "timestamp": "01:09:23", "text": "家伙至少有两台电视。 不，只有一台电视。"}, {"type": "subtitle", "time": 4168.269, "timestamp": "01:09:28", "text": "哦，没关系。 它已经装了一半了。 所以，所以"}, {"type": "subtitle", "time": 4177.349, "timestamp": "01:09:37", "text": "没关系。 你们喜欢这样。"}, {"type": "subtitle", "time": 4180.39, "timestamp": "01:09:40", "text": "什么？ 你说的“享受”是什么意思？ 杰奎先生"}, {"type": "subtitle", "time": 4182.63, "timestamp": "01:09:42", "text": "混合。"}, {"type": "subtitle", "time": 4185.829, "timestamp": "01:09:45", "text": "鬼魂结局。 你为什么要玩这些"}, {"type": "subtitle", "time": 4188.709, "timestamp": "01:09:48", "text": "幽灵游戏？ 十月还没过去呢。"}, {"type": "subtitle", "time": 4191.189, "timestamp": "01:09:51", "text": "不，我还是不明白。 万圣节已经"}, {"type": "subtitle", "time": 4193.349, "timestamp": "01:09:53", "text": "结束了。 你为什么还在玩恐怖"}, {"type": "subtitle", "time": 4195.59, "timestamp": "01:09:55", "text": "游戏？ 现在，我感觉乔克"}, {"type": "subtitle", "time": 4198.55, "timestamp": "01:09:58", "text": "掌握了主动权，但他却不肯配合。"}]
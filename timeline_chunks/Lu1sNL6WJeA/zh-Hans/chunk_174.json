[{"type": "subtitle", "time": 10445.75, "timestamp": "02:54:05", "text": "你想拥有枪支就拥有它。"}, {"type": "subtitle", "time": 10449.269, "timestamp": "02:54:09", "text": "我不会阻止你。"}, {"type": "subtitle", "time": 10451.51, "timestamp": "02:54:11", "text": "不是连续两次。 不是连续两次。"}, {"type": "subtitle", "time": 10452.75, "timestamp": "02:54:12", "text": "这事不会"}, {"type": "subtitle", "time": 10455.91, "timestamp": "02:54:15", "text": "发生。 那我怎么就打不到你"}, {"type": "subtitle", "time": 10459.55, "timestamp": "02:54:19", "text": "那里呢？ 我的天啊。 火焰。   是的"}, {"type": "subtitle", "time": 10462.07, "timestamp": "02:54:22", "text": "。 哦，等等。 瞧瞧。 其实，我"}, {"type": "subtitle", "time": 10464.23, "timestamp": "02:54:24", "text": "很想上去。"}, {"type": "subtitle", "time": 10476.23, "timestamp": "02:54:36", "text": "你好。 你好。"}, {"type": "subtitle", "time": 10477.349, "timestamp": "02:54:37", "text": "好吧，你知道吗？ 坚持，稍等。 坚持，稍等。"}, {"type": "subtitle", "time": 10480.469, "timestamp": "02:54:40", "text": "坚持，稍等。 坚持，稍等。 坚持，稍等。 我先拿下"}, {"type": "subtitle", "time": 10482.87, "timestamp": "02:54:42", "text": "这个，然后我们来打一场无瞄准镜的"}, {"type": "subtitle", "time": 10486.67, "timestamp": "02:54:46", "text": "战斗。 是的。"}, {"type": "subtitle", "time": 10490.55, "timestamp": "02:54:50", "text": "你在哪里？ 哦，哇。"}, {"type": "subtitle", "time": 10492.55, "timestamp": "02:54:52", "text": "倒计时。 好吧，看来我们"}, {"type": "subtitle", "time": 10494.309, "timestamp": "02:54:54", "text": "现在只能这么做了。 哦，等等。 等待。 我们来"}, {"type": "subtitle", "time": 10496.63, "timestamp": "02:54:56", "text": "倒计时吧。 让我们认真对待这件事。 我"}, {"type": "subtitle", "time": 10499.349, "timestamp": "02:54:59", "text": "会给你，我会在中间丢下一件武器"}]
[{"type": "subtitle", "time": 4201.75, "timestamp": "01:10:01", "text": "不，我"}, {"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "现在没有这款游戏。 实际上，我已经卸载了它。"}, {"type": "subtitle", "time": 4205.95, "timestamp": "01:10:05", "text": "这就是"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "原因。 我的天哪。"}, {"type": "subtitle", "time": 4211.51, "timestamp": "01:10:11", "text": "你不应该这样做。 呃，好的。 我没有"}, {"type": "subtitle", "time": 4213.75, "timestamp": "01:10:13", "text": "在流媒体上安装它。"}, {"type": "subtitle", "time": 4217.83, "timestamp": "01:10:17", "text": "为什么？ 不，不过这需要一段时间。"}, {"type": "subtitle", "time": 4219.99, "timestamp": "01:10:19", "text": "看来还需要一段时间。 不会"}, {"type": "subtitle", "time": 4226.149, "timestamp": "01:10:26", "text": "我的意思是，如果我一开始就气势如虹，你们早就"}, {"type": "subtitle", "time": 4228.43, "timestamp": "01:10:28", "text": "结束游戏了。"}, {"type": "subtitle", "time": 4231.35, "timestamp": "01:10:31", "text": "所以，下次我会带上"}, {"type": "subtitle", "time": 4233.189, "timestamp": "01:10:33", "text": "护照。 好的。 好的。 好的。 好的。"}, {"type": "subtitle", "time": 4235.11, "timestamp": "01:10:35", "text": "雅克，稍等片刻。 你"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "参军了吗？"}, {"type": "subtitle", "time": 4238.91, "timestamp": "01:10:38", "text": "我已经"}, {"type": "subtitle", "time": 4242.47, "timestamp": "01:10:42", "text": "入伍了。 别告诉我你现在入伍了。"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "啊，"}, {"type": "subtitle", "time": 4245.83, "timestamp": "01:10:45", "text": "如果你没有入伍，我们也无能为力"}, {"type": "subtitle", "time": 4247.75, "timestamp": "01:10:47", "text": "。 但是如果你已经入伍，我们可以把"}, {"type": "subtitle", "time": 4250.47, "timestamp": "01:10:50", "text": "游戏模式切换到入伍模式。 嗯，是的，我已经"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "入伍了。 是的。"}, {"type": "subtitle", "time": 4256.59, "timestamp": "01:10:56", "text": "莱奥科，你入伍了吗？"}]
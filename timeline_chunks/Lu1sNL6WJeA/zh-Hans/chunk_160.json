[{"type": "subtitle", "time": 9602.59, "timestamp": "02:40:02", "text": "我想我们"}, {"type": "subtitle", "time": 9604.87, "timestamp": "02:40:04", "text": "现在都快没血了。哦，我的天哪。你之前有多少血"}, {"type": "subtitle", "time": 9622.79, "timestamp": "02:40:22", "text": "搞什么鬼 那是？哦，天哪，"}, {"type": "subtitle", "time": 9625.11, "timestamp": "02:40:25", "text": "我吓了一跳。哦，我的天哪，我吓了一跳。我"}, {"type": "subtitle", "time": 9628.55, "timestamp": "02:40:28", "text": "尖叫了。不，伙计，我……他其实断线了。"}, {"type": "subtitle", "time": 9631.03, "timestamp": "02:40:31", "text": "我当时想，“哦，他去哪儿了？”哦，"}, {"type": "subtitle", "time": 9640.83, "timestamp": "02:40:40", "text": "啊，我们"}, {"type": "subtitle", "time": 9647.71, "timestamp": "02:40:47", "text": "哦，"}, {"type": "subtitle", "time": 9654.27, "timestamp": "02:40:54", "text": "奶酪。"}, {"type": "subtitle", "time": 9657.71, "timestamp": "02:40:57", "text": "你在哪儿？哦，我的天哪。你在干什么"}]
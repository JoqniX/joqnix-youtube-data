[{"type": "subtitle", "time": 12361.429, "timestamp": "03:26:01", "text": "不可能连续三条命都是"}, {"type": "subtitle", "time": 12363.91, "timestamp": "03:26:03", "text": "空白。"}, {"type": "subtitle", "time": 12367.03, "timestamp": "03:26:07", "text": "但我们看到了三个空白和三条"}, {"type": "subtitle", "time": 12369.269, "timestamp": "03:26:09", "text": "生命，对吧？ 订单怎么被"}, {"type": "subtitle", "time": 12371.83, "timestamp": "03:26:11", "text": "改了？ 不，顺序不会"}, {"type": "subtitle", "time": 12375.55, "timestamp": "03:26:15", "text": "改变。 顺序似乎是随机的。"}, {"type": "subtitle", "time": 12378.389, "timestamp": "03:26:18", "text": "就像它只向你展示空白和生活。"}, {"type": "subtitle", "time": 12387.429, "timestamp": "03:26:27", "text": "。 它只会告诉你"}, {"type": "subtitle", "time": 12389.11, "timestamp": "03:26:29", "text": "霰弹枪里有多少发子弹。 它"}, {"type": "subtitle", "time": 12391.269, "timestamp": "03:26:31", "text": "不会告诉你它们的顺序。"}, {"type": "subtitle", "time": 12393.67, "timestamp": "03:26:33", "text": "好像你不知道似的。 就是这样。"}, {"type": "subtitle", "time": 12396.229, "timestamp": "03:26:36", "text": "该死。 好的。 所以，你用空包弹射中了我"}, {"type": "subtitle", "time": 12399.67, "timestamp": "03:26:39", "text": "。 所以，带着现场直播。"}, {"type": "subtitle", "time": 12403.389, "timestamp": "03:26:43", "text": "呃，所以这是两条命。 现在胜负五五开"}, {"type": "subtitle", "time": 12406.59, "timestamp": "03:26:46", "text": "。 去他妈的。 我决定去，我决定"}, {"type": "subtitle", "time": 12409.03, "timestamp": "03:26:49", "text": "放手一搏。 也不可能出现连续两世的情况"}, {"type": "subtitle", "time": 12411.87, "timestamp": "03:26:51", "text": "。   是的"}, {"type": "subtitle", "time": 12415.03, "timestamp": "03:26:55", "text": "。 我们走吧。"}, {"type": "subtitle", "time": 12417.99, "timestamp": "03:26:57", "text": "这意味着下一个"}]
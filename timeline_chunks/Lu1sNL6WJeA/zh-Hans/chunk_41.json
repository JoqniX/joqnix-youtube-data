[{"type": "subtitle", "time": 2462.55, "timestamp": "00:41:02", "text": "我的天哪。 发生了什么？ 我的天啊。 我"}, {"type": "subtitle", "time": 2464.27, "timestamp": "00:41:04", "text": "死了。"}, {"type": "subtitle", "time": 2465.349, "timestamp": "00:41:05", "text": "[掌声]"}, {"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "哦，我不知何故死了。 我已经"}, {"type": "subtitle", "time": 2470.05, "timestamp": "00:41:10", "text": "死了。 什么鬼？"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "好的。 我踩爆了它的头。 踩碎"}, {"type": "subtitle", "time": 2502.15, "timestamp": "00:41:42", "text": "敌人的头颅。 好的。 这里还有一个。"}, {"type": "subtitle", "time": 2505.109, "timestamp": "00:41:45", "text": "我认为这不是正确的做法。"}, {"type": "subtitle", "time": 2506.87, "timestamp": "00:41:46", "text": "它们正在爆炸。"}, {"type": "subtitle", "time": 2508.47, "timestamp": "00:41:48", "text": "其实还好。"}, {"type": "subtitle", "time": 2512.71, "timestamp": "00:41:52", "text": "我们会游泳吗？"}, {"type": "subtitle", "time": 2515.109, "timestamp": "00:41:55", "text": "我的天哪。 别把我丢下，兄弟。   是的"}, {"type": "subtitle", "time": 2516.309, "timestamp": "00:41:56", "text": "。 是的。 是的。 来。"}, {"type": "subtitle", "time": 2518.069, "timestamp": "00:41:58", "text": "这里有一个燃料罐。 是的。   是的"}, {"type": "subtitle", "time": 2519.75, "timestamp": "00:41:59", "text": "。 我把它掉地上了。 我把它掉地上了。 我们"}]
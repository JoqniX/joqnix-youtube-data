[{"type": "subtitle", "time": 11520.71, "timestamp": "03:12:00", "text": "它很小。 是的。 我的意思是，"}, {"type": "subtitle", "time": 11524.71, "timestamp": "03:12:04", "text": "跟现在的游戏相比，这款游戏的"}, {"type": "subtitle", "time": 11529.29, "timestamp": "03:12:09", "text": "大小只有以前的百分之一，你知道，就像"}, {"type": "subtitle", "time": 11531.67, "timestamp": "03:12:11", "text": "[音乐]那样，有点"}, {"type": "subtitle", "time": 11535.59, "timestamp": "03:12:15", "text": "吓人，"}, {"type": "subtitle", "time": 11540.469, "timestamp": "03:12:20", "text": "像《战区》这样的游戏，一点"}, {"type": "subtitle", "time": 11542.95, "timestamp": "03:12:22", "text": "都不好玩。 我试过战区模式。"}, {"type": "subtitle", "time": 11544.71, "timestamp": "03:12:24", "text": "我觉得人们觉得不好玩是因为"}, {"type": "subtitle", "time": 11547.19, "timestamp": "03:12:27", "text": "出汗太多了。   是的"}, {"type": "subtitle", "time": 11549.11, "timestamp": "03:12:29", "text": "。 即使在《堡垒之夜》这款游戏中，也有很多"}, {"type": "subtitle", "time": 11552.469, "timestamp": "03:12:32", "text": "高手玩家。 当然可以。 类似"}, {"type": "subtitle", "time": 11556.07, "timestamp": "03:12:36", "text": "这样的游戏要 100 GB，但我玩"}, {"type": "subtitle", "time": 11559.15, "timestamp": "03:12:39", "text": "这个游戏玩得更开心，而它只有"}, {"type": "subtitle", "time": 11561.429, "timestamp": "03:12:41", "text": "1GB。 我觉得人们好像都忘了"}, {"type": "subtitle", "time": 11565.269, "timestamp": "03:12:45", "text": "怎么制作电子游戏了，你知道吗？"}, {"type": "subtitle", "time": 11567.95, "timestamp": "03:12:47", "text": "嗯。 而这正是电子游戏的全部意义所在"}, {"type": "subtitle", "time": 11570.63, "timestamp": "03:12:50", "text": "，但现在说这些就有点跑题了"}, {"type": "subtitle", "time": 11573.269, "timestamp": "03:12:53", "text": "。 如果我一直说"}]
[{"type": "subtitle", "time": 1261.27, "timestamp": "00:21:01", "text": "这只是个探索任务，这样我就可以多"}, {"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "揍几顿僵尸了。"}, {"type": "subtitle", "time": 1272.23, "timestamp": "00:21:12", "text": "我们到底该去哪儿？ 哦，"}, {"type": "subtitle", "time": 1275.27, "timestamp": "00:21:15", "text": "我在这边。 我在痛扁僵尸。   我们"}, {"type": "subtitle", "time": 1277.99, "timestamp": "00:21:17", "text": "走吧。"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "我们搞砸了什么？ 我们直接"}, {"type": "subtitle", "time": 1287.11, "timestamp": "00:21:27", "text": "。 你们速度真快。 搞什么鬼，"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "兄弟？ 我需要一把枪。"}, {"type": "subtitle", "time": 1293.029, "timestamp": "00:21:33", "text": "如果你需要的话，我这里有一把射钉枪。"}, {"type": "subtitle", "time": 1304.56, "timestamp": "00:21:44", "text": "如何？ 有人打了我。 你是怎么得到"}]
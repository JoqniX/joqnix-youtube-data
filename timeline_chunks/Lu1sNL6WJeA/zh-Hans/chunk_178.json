[{"type": "subtitle", "time": 10680.429, "timestamp": "02:58:00", "text": "，不过"}, {"type": "subtitle", "time": 10682.55, "timestamp": "02:58:02", "text": "好吧。 这是什么？ 我以前从没玩过"}, {"type": "subtitle", "time": 10685.91, "timestamp": "02:58:05", "text": "这款游戏。 是啊，我也是。 哦，你们"}, {"type": "subtitle", "time": 10688.23, "timestamp": "02:58:08", "text": "得用木桶互相残杀。"}, {"type": "subtitle", "time": 10692.91, "timestamp": "02:58:12", "text": "天啊。"}, {"type": "subtitle", "time": 10696.63, "timestamp": "02:58:16", "text": "你在哪里？ 这里。 受到一些伤害。"}, {"type": "subtitle", "time": 10698.95, "timestamp": "02:58:18", "text": "你受到伤害了吗？"}, {"type": "subtitle", "time": 10701.23, "timestamp": "02:58:21", "text": "天哪，我"}, {"type": "subtitle", "time": 10704.51, "timestamp": "02:58:24", "text": "受伤了。"}, {"type": "subtitle", "time": 10709.429, "timestamp": "02:58:29", "text": "你在哪里？ 我的天哪，我自杀了。 我想，"}, {"type": "subtitle", "time": 10724.23, "timestamp": "02:58:44", "text": "。 感谢上帝。"}, {"type": "subtitle", "time": 10726.23, "timestamp": "02:58:46", "text": "我的天啊。"}, {"type": "subtitle", "time": 10730.309, "timestamp": "02:58:50", "text": "不，不，我讨厌这个。 我太讨厌这个了"}]
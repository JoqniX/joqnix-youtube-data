[{"type": "subtitle", "time": 3182.15, "timestamp": "00:53:02", "text": "。 好的。 曲棍球杆。 死。 死。"}, {"type": "subtitle", "time": 3185.91, "timestamp": "00:53:05", "text": "爆头。 哦，我的天哪。 他是"}, {"type": "subtitle", "time": 3188.549, "timestamp": "00:53:08", "text": "为了你而竞选。"}, {"type": "subtitle", "time": 3191.91, "timestamp": "00:53:11", "text": "哦，发生什么事了？"}, {"type": "subtitle", "time": 3195.349, "timestamp": "00:53:15", "text": "就像一记重拳。"}, {"type": "subtitle", "time": 3196.79, "timestamp": "00:53:16", "text": "你知道吗？ 我也会进行正面"}, {"type": "subtitle", "time": 3200.39, "timestamp": "00:53:20", "text": "交锋。 他扔东西。"}, {"type": "subtitle", "time": 3202.79, "timestamp": "00:53:22", "text": "他们会杀了我。"}, {"type": "subtitle", "time": 3204.87, "timestamp": "00:53:24", "text": "说实话，这比那些武器更有趣"}, {"type": "subtitle", "time": 3214.549, "timestamp": "00:53:34", "text": "嘘，该死。 里克和我正在"}, {"type": "subtitle", "time": 3217.67, "timestamp": "00:53:37", "text": "水里放松。 他走路的样子，真酷。"}, {"type": "subtitle", "time": 3221.91, "timestamp": "00:53:41", "text": "你想要什么我都给你。 啊，"}, {"type": "subtitle", "time": 3226.15, "timestamp": "00:53:46", "text": "顺便说一句，我可以谈谈我自己。 杀了"}, {"type": "subtitle", "time": 3228.39, "timestamp": "00:53:48", "text": "我。   往"}, {"type": "subtitle", "time": 3231.67, "timestamp": "00:53:51", "text": "视频下方看就行了。"}]
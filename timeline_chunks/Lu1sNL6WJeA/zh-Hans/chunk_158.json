[{"type": "subtitle", "time": 9482.469, "timestamp": "02:38:02", "text": "走吧。不错。虽然不是"}, {"type": "subtitle", "time": 9485.99, "timestamp": "02:38:05", "text": "爆头，但好吧，我接受。"}, {"type": "subtitle", "time": 9488.469, "timestamp": "02:38:08", "text": "哦，你用的是冲锋枪。好的。好的。你"}, {"type": "subtitle", "time": 9491.11, "timestamp": "02:38:11", "text": "用的是“queso”，就像那个主播一样。我"}, {"type": "subtitle", "time": 9494.63, "timestamp": "02:38:14", "text": "不知道它为什么叫这个名字。我有一把"}, {"type": "subtitle", "time": 9498.79, "timestamp": "02:38:18", "text": "枪，不知道为什么叫“坎耶”。"}, {"type": "subtitle", "time": 9500.389, "timestamp": "02:38:20", "text": "你也有这把枪吗？你"}, {"type": "subtitle", "time": 9503.83, "timestamp": "02:38:23", "text": "也有吗？没有，还没有。别这样。它叫……"}, {"type": "subtitle", "time": 9508.71, "timestamp": "02:38:28", "text": "哦，我得朝地上开枪，不能"}, {"type": "subtitle", "time": 9509.87, "timestamp": "02:38:29", "text": "打你。我"}, {"type": "subtitle", "time": 9512.07, "timestamp": "02:38:32", "text": "明白了。哦，没事了。对，就拿着吧"}, {"type": "subtitle", "time": 9514.95, "timestamp": "02:38:34", "text": "。你为什么不离我远点？我有"}, {"type": "subtitle", "time": 9517.15, "timestamp": "02:38:37", "text": "坎耶。我们……"}, {"type": "subtitle", "time": 9519.99, "timestamp": "02:38:39", "text": "是这一局吗？是的，就是这一局。"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "你好，坎特雷拉。欢迎。欢迎。"}, {"type": "subtitle", "time": 9524.07, "timestamp": "02:38:44", "text": "这已经不是瓦莱兰特了。你"}, {"type": "subtitle", "time": 9529.309, "timestamp": "02:38:49", "text": "被骗了。哦，"}, {"type": "subtitle", "time": 9533.03, "timestamp": "02:38:53", "text": "天哪。我可以双持吗？不，我不能。"}, {"type": "subtitle", "time": 9538.03, "timestamp": "02:38:58", "text": "接受"}]
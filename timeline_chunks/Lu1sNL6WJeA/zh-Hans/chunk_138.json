[{"type": "subtitle", "time": 8283.349, "timestamp": "02:18:03", "text": "他确实很聪明。再说一遍，就像我说的，"}, {"type": "subtitle", "time": 8287.83, "timestamp": "02:18:07", "text": "细胞的强力输出。嗯，"}, {"type": "subtitle", "time": 8289.349, "timestamp": "02:18:09", "text": "我们需要合作才能打败"}, {"type": "subtitle", "time": 8291.1, "timestamp": "02:18:11", "text": "线粒体。"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "天哪。你今天有多少次联动"}, {"type": "subtitle", "time": 8302.629, "timestamp": "02:18:22", "text": "？之前也有联动吗"}, {"type": "subtitle", "time": 8304.549, "timestamp": "02:18:24", "text": "？ 不，不，不。你是第"}, {"type": "subtitle", "time": 8309.11, "timestamp": "02:18:29", "text": "一个。哦，我明白了。我明白了。是啊。你只是在"}, {"type": "subtitle", "time": 8315.91, "timestamp": "02:18:35", "text": "？我想是的。是啊。等你……"}, {"type": "subtitle", "time": 8320.309, "timestamp": "02:18:40", "text": "你知道的，事情进展顺利之后，你能直播吗？我……我"}, {"type": "subtitle", "time": 8322.95, "timestamp": "02:18:42", "text": "不确定。不过我真的很想直播"}, {"type": "subtitle", "time": 8324.95, "timestamp": "02:18:44", "text": "。"}, {"type": "subtitle", "time": 8327.349, "timestamp": "02:18:47", "text": "当然你可以试试，因为我得买台"}, {"type": "subtitle", "time": 8330.469, "timestamp": "02:18:50", "text": "笔记本电脑什么的。"}, {"type": "subtitle", "time": 8332.87, "timestamp": "02:18:52", "text": "什么？你还没有笔记本电脑？"}, {"type": "subtitle", "time": 8336.389, "timestamp": "02:18:56", "text": "没有。没有。我用的是台式机。没有。"}, {"type": "subtitle", "time": 8338.629, "timestamp": "02:18:58", "text": "我得从那里买笔记本电脑"}]
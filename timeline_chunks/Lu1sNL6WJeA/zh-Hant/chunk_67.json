[{"type": "subtitle", "time": 4042.47, "timestamp": "01:07:22", "text": "弄到了一件武器。看來我好像有多件武器。  我的天啊。羅科，你在哪裡？  我必須去面對他們。  [掌聲] 他反應慢嗎？他反應慢嗎？  我們要抓捕槍手。"}, {"type": "subtitle", "time": 4049.63, "timestamp": "01:07:29", "text": "哦"}, {"type": "subtitle", "time": 4067.549, "timestamp": "01:07:47", "text": "跑。這裡人很多。  是的。你好，"}, {"type": "subtitle", "time": 4070.349, "timestamp": "01:07:50", "text": "Roku。不，只是每次我跟羅納說話的時候，我總是"}]
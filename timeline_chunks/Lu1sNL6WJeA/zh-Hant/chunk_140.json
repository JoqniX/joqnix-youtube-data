[{"type": "subtitle", "time": 8415.429, "timestamp": "02:20:15", "text": "哦，好吧，不是那樣，我是說我朝他開槍，然後我的遊戲就卡住了。這種情況經常發生。整個遊戲過程中都在發生。"}, {"type": "subtitle", "time": 8416.87, "timestamp": "02:20:16", "text": "我不知道為什麼。哦，當其他"}, {"type": "subtitle", "time": 8436.79, "timestamp": "02:20:36", "text": "玩家出現的時候。是啊。是啊。當他們出現在螢幕上時，我的遊戲就會卡住。很奇怪。很遺憾。是"}, {"type": "subtitle", "time": 8442.15, "timestamp": "02:20:42", "text": "啊。它又發生了。我的"}]
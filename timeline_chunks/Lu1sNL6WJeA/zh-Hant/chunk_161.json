[{"type": "subtitle", "time": 9671.11, "timestamp": "02:41:11", "text": "不錯。雖然不是爆頭，但好吧，我接受。哦，你用的是"}, {"type": "subtitle", "time": 9673.03, "timestamp": "02:41:13", "text": "衝鋒槍。好的。好的。你用的"}, {"type": "subtitle", "time": 9687.91, "timestamp": "02:41:27", "text": "我不知道它為什麼叫這個名字。我有一把槍，不知道為什麼叫「坎耶」。你也有這把槍嗎"}]
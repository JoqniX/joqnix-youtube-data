[{"type": "subtitle", "time": 8160.229, "timestamp": "02:16:00", "text": "其實我也不知道。"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "他們有三個在中間。"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "，你升到軍階了。哦，不。那不是……哦，救命。救命。救命。救命。救命。救命。救命"}, {"type": "subtitle", "time": 8181.189, "timestamp": "02:16:21", "text": "。有人嗎"}, {"type": "subtitle", "time": 8195.75, "timestamp": "02:16:35", "text": "？有人嗎？"}, {"type": "subtitle", "time": 8200.549, "timestamp": "02:16:40", "text": "打死它"}, {"type": "subtitle", "time": 8202.15, "timestamp": "02:16:42", "text": "。哦，天哪"}]
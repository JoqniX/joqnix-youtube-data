[{"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "一槍斃了他，你知道的。啊，護盾會保護"}, {"type": "subtitle", "time": 8073.709, "timestamp": "02:14:33", "text": "我覺得如果他在這裡，他會把我們困住"}, {"type": "subtitle", "time": 8077.51, "timestamp": "02:14:37", "text": "。不。算了。他們都在開"}, {"type": "subtitle", "time": 8079.83, "timestamp": "02:14:39", "text": "爆。如果我能拿到一個人頭，我就可以…"}, {"type": "subtitle", "time": 8083.51, "timestamp": "02:14:43", "text": "好的。我還有大招。我去"}, {"type": "subtitle", "time": 8085.47, "timestamp": "02:14:45", "text": "上路。先留著"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "。如果我們"}, {"type": "subtitle", "time": 8091.31, "timestamp": "02:14:51", "text": "變成3打2，那你應該……我覺得……"}, {"type": "subtitle", "time": 8098.39, "timestamp": "02:14:58", "text": "如果他們夠聰明，他們會"}]
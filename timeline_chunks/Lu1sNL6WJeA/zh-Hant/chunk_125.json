[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "。你得教我"}, {"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "日語，"}, {"type": "subtitle", "time": 7504.709, "timestamp": "02:05:04", "text": "Jo，你知道的。是的。我的天。那會很有趣，我想開個"}, {"type": "subtitle", "time": 7520.95, "timestamp": "02:05:20", "text": "直播教大家印地語什麼的。正在加載。哦，是的。是的。請教我吧。我的印地語很爛"}, {"type": "subtitle", "time": 7523.109, "timestamp": "02:05:23", "text": "。"}, {"type": "subtitle", "time": 7530.31, "timestamp": "02:05:30", "text": "我會教你的，但只會說些髒話。好吧。開玩笑的。開玩笑的。我的天哪。好吧。你想做什麼？呃，等一下。等等，你的遊戲裡有滑鼠按鍵綁定嗎？我的遊戲裡有滑鼠按鍵綁定嗎？呃，有的。我的按鍵說話功能綁定在滑鼠上。好的，給我一分鐘"}, {"type": "subtitle", "time": 7531.75, "timestamp": "02:05:31", "text": "。我去關門。請便。那個人是我有尖峰。哦，有人在那裡。來了。哦，他們有兩個。小心。"}]
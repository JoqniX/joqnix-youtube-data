[{"type": "subtitle", "time": 8348.309, "timestamp": "02:19:08", "text": "你……"}, {"type": "subtitle", "time": 8350.469, "timestamp": "02:19:10", "text": "你知道的，事情進展順利"}, {"type": "subtitle", "time": 8356.79, "timestamp": "02:19:16", "text": "之後，你能直播嗎？我……我不確定。不過我真的很想直播"}, {"type": "subtitle", "time": 8359.99, "timestamp": "02:19:19", "text": "。當然你可以試試，因為我得買一台筆記型電腦什麼的。什麼？你還沒有筆記型電腦？沒有。沒有。我用的是桌上型電腦。沒有。我得從那裡買筆記"}, {"type": "subtitle", "time": 8392.429, "timestamp": "02:19:52", "text": "啊，看到了。你看到發生了什麼事嗎？是的，"}, {"type": "subtitle", "time": 8394.63, "timestamp": "02:19:54", "text": "他一槍爆了你。"}]
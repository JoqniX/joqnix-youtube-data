[{"type": "subtitle", "time": 3618.95, "timestamp": "01:00:18", "text": "她用頭撞了我。直接踢他一腳就行了，兄弟。  沒關係。我的天啊，這隻殭屍剛才用頭撞我了。把他踢來踢去。  沒關係。感覺"}, {"type": "subtitle", "time": 3624.71, "timestamp": "01:00:24", "text": "就像又被連續眩暈鎖定了一樣"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "。"}, {"type": "subtitle", "time": 3646.23, "timestamp": "01:00:46", "text": "眩暈鎖定。"}, {"type": "subtitle", "time": 3650.829, "timestamp": "01:00:50", "text": "哦。  住口。別朝我們吐口水了，老兄。哦。"}]
[{"type": "subtitle", "time": 2833.39, "timestamp": "00:47:13", "text": "村民。不僅是感染者，而是所有人。男人、女人、孩子。  我為什麼要"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "帶著燃料罐"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "的。等等，夥計。  好像，哦，那裡有"}, {"type": "subtitle", "time": 2872.309, "timestamp": "00:47:52", "text": "槍。我是一個大型工具包。好吧，我"}, {"type": "subtitle", "time": 2878.87, "timestamp": "00:47:58", "text": "確實有一把"}]
[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "啊，我從來沒…我真的非常"}, {"type": "subtitle", "time": 7923.99, "timestamp": "02:12:03", "text": "注意它，但我"}, {"type": "subtitle", "time": 7925.91, "timestamp": "02:12:05", "text": "最近在一些動漫裡也看到了。我當時"}, {"type": "subtitle", "time": 7927.75, "timestamp": "02:12:07", "text": "就想，咦，等等。"}, {"type": "subtitle", "time": 7930.229, "timestamp": "02:12:10", "text": "這是什麼意思？我"}, {"type": "subtitle", "time": 7931.99, "timestamp": "02:12:11", "text": "覺得這更像是一種老式的表達方式"}, {"type": "subtitle", "time": 7954.87, "timestamp": "02:12:34", "text": "啊，我的遊戲好卡。啊，"}, {"type": "subtitle", "time": 7958.87, "timestamp": "02:12:38", "text": "這有點奇怪。"}, {"type": "subtitle", "time": 7961.51, "timestamp": "02:12:41", "text": "如果我有幻影，我就能幹掉他了"}, {"type": "subtitle", "time": 7974.229, "timestamp": "02:12:54", "text": "好吧。他是在那邊還是在這裡？"}, {"type": "subtitle", "time": 7979.109, "timestamp": "02:12:59", "text": "那是A點。他應該在輪換，"}]
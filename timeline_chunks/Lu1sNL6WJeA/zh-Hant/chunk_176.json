[{"type": "subtitle", "time": 10569.469, "timestamp": "02:56:09", "text": "我被斬首了。我沒有，我的頭還連著。你具體指的是什麼？"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "你說的「我被斬首"}, {"type": "subtitle", "time": 10586.07, "timestamp": "02:56:26", "text": "」是什麼意思？  什麼？  你沒看到嗎？  你知道嗎？快點。我在等你。哦"}, {"type": "subtitle", "time": 10594.07, "timestamp": "02:56:34", "text": "。我會帶著一絲古老的硫磺之火等著你。我是一個陰森恐怖的寓言故事。"}, {"type": "subtitle", "time": 10610.309, "timestamp": "02:56:50", "text": "不是那樣的。我的天啊。啊。  你在哪裡？你在哪裡？  雅克維克斯，拜託"}]
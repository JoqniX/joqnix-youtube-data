[{"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "天啊。是啊。還有，你是怎麼錄製你的VAL的？視窗錄製還是遊戲錄製視窗？我用"}, {"type": "subtitle", "time": 7452.629, "timestamp": "02:04:12", "text": "視窗錄製，然後我的遊戲保持視窗全螢幕模式。啊，明白了。是的。是的。你知道嗎？我"}, {"type": "subtitle", "time": 7465.109, "timestamp": "02:04:25", "text": "其實想玩密碼師。是的，我玩密碼師。那麼，你今天過得怎麼樣，運動健將先生？"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "你今天過得怎麼樣？因為城市那件事，壓力很大。我的天啊。但本來應該是美好的一天。是的，本來應該是的。是的。我的意思是"}, {"type": "subtitle", "time": 7479.51, "timestamp": "02:04:39", "text": "，你很快又"}, {"type": "subtitle", "time": 7481.589, "timestamp": "02:04:41", "text": "要搞合作了吧？對。跟"}, {"type": "subtitle", "time": 7484.629, "timestamp": "02:04:44", "text": "韓國虛擬主播合作。那次我要用日文。希望"}, {"type": "subtitle", "time": 7488.31, "timestamp": "02:04:48", "text": "我能撐過去。日語。我的天。得好好利用你的技能了，你知道的。你也得教我"}]
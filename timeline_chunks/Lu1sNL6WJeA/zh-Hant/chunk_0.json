[{"type": "subtitle", "time": 18.07, "timestamp": "00:00:18", "text": "哦，太棒了。停止。他們呢？"}, {"type": "subtitle", "time": 19.99, "timestamp": "00:00:19", "text": "現在那是你的問題了。你不能就這麼把"}, {"type": "subtitle", "time": 22.39, "timestamp": "00:00:22", "text": "他們留在這裡。他們是平民。如果我"}, {"type": "subtitle", "time": 24.47, "timestamp": "00:00:24", "text": "是你，我會擔心自己的"}, {"type": "subtitle", "time": 26.87, "timestamp": "00:00:26", "text": "安危，上校。"}, {"type": "subtitle", "time": 30.15, "timestamp": "00:00:30", "text": "我的天啊。為什麼沒有敲門聲？"}, {"type": "subtitle", "time": 32.95, "timestamp": "00:00:32", "text": "那傢伙就這麼走了。搞什麼鬼？你上來"}, {"type": "subtitle", "time": 36.229, "timestamp": "00:00:36", "text": "。隊長，請回答。士兵，你的"}, {"type": "subtitle", "time": 39.11, "timestamp": "00:00:39", "text": "隊長陣亡了。"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "哦，不。那是塊石頭嗎？"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "我們正走向一場衝突。我們必須"}, {"type": "subtitle", "time": 51.51, "timestamp": "00:00:51", "text": "到達橋邊。是的，我們又遇到一個"}, {"type": "subtitle", "time": 54.389, "timestamp": "00:00:54", "text": "問題。只得了一顆星。哦，我們有"}, {"type": "subtitle", "time": 57.75, "timestamp": "00:00:57", "text": "步槍。我們走吧。"}]
[{"type": "subtitle", "time": 1981.07, "timestamp": "00:33:01", "text": "才能開口說話"}, {"type": "subtitle", "time": 1990.07, "timestamp": "00:33:10", "text": "。"}, {"type": "subtitle", "time": 1996.31, "timestamp": "00:33:16", "text": "我覺得很可疑。  我死了嗎？我死了嗎？我覺得你現在還活著。是的，你會來的。  是的。過來。進來。主題"}, {"type": "subtitle", "time": 2006.71, "timestamp": "00:33:26", "text": "語音聊天功能已開啟。  我的語音聊天。對，就是"}, {"type": "subtitle", "time": 2009.83, "timestamp": "00:33:29", "text": "你的語音聊天。  是的。是的。是的。你的錢在油表上，我保證。現在能聽到我說話嗎？不，"}, {"type": "subtitle", "time": 2011.389, "timestamp": "00:33:31", "text": "不，不，"}, {"type": "subtitle", "time": 2027.99, "timestamp": "00:33:47", "text": "呃，這款遊戲我唯一喜歡的地方就是你可以踢他們。是啊"}, {"type": "subtitle", "time": 2034.47, "timestamp": "00:33:54", "text": "，拜託。  [音樂] 哦，我得巡邏。我的電腦"}, {"type": "subtitle", "time": 2038.63, "timestamp": "00:33:58", "text": "死機了。你想要這個嗎？我該如何卸載它？好的。我"}]
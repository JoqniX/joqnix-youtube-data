[{"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "嘿，這是什麼"}, {"type": "subtitle", "time": 1691.75, "timestamp": "00:28:11", "text": "？那是個男孩。  我不知道。就像有個箭頭指向那裡一樣。"}, {"type": "subtitle", "time": 1700.549, "timestamp": "00:28:20", "text": "怪胎。"}, {"type": "subtitle", "time": 1711.16, "timestamp": "00:28:31", "text": "喬克。喬，你真壞。"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "哦，你累了。小心點"}]
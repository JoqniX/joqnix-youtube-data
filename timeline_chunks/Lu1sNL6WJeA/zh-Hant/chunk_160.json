[{"type": "subtitle", "time": 9602.59, "timestamp": "02:40:02", "text": "黑屏。我想是地圖"}, {"type": "subtitle", "time": 9604.87, "timestamp": "02:40:04", "text": "。哦，對。對，是"}, {"type": "subtitle", "time": 9625.11, "timestamp": "02:40:25", "text": "。其實我討厭這張地圖。"}, {"type": "subtitle", "time": 9631.03, "timestamp": "02:40:31", "text": "哦，該死。我的天。是的。看吧，我早就說過你的槍法很好。什麼？我沒撒謊。等等，"}]
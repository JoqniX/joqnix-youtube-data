[{"type": "subtitle", "time": 6601.51, "timestamp": "01:50:01", "text": "我最近沒怎麼"}, {"type": "subtitle", "time": 6604.75, "timestamp": "01:50:04", "text": "練習日語，因為我一直專注於其他事情。我連時間都問不出來。而且這不僅發生在日本。我到底有沒有複習下個月要考的11門補考科目？我沒有，"}, {"type": "subtitle", "time": 6607.43, "timestamp": "01:50:07", "text": "兄弟。  我沒有，我甚至不知道發生了什麼事。我的考試是什麼？  我的考試是什麼時候？"}, {"type": "subtitle", "time": 6624.79, "timestamp": "01:50:24", "text": "我覺得整張票都洩漏了。我得下載下來，列印出來"}, {"type": "subtitle", "time": 6632.91, "timestamp": "01:50:32", "text": "等等。或者也許你不知道那些我不知道的子類，反正我覺得我學得很好。好的。呃，我們別再拖延了。"}, {"type": "subtitle", "time": 6645.27, "timestamp": "01:50:45", "text": "我得發條推"}, {"type": "subtitle", "time": 6657.31, "timestamp": "01:50:57", "text": "今天的直播安排。"}]
[{"type": "subtitle", "time": 1932.789, "timestamp": "00:32:12", "text": "哦，你！"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "哦，太好了，你可以瞬間復活"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "。  雙踢。是的。等等，等等，等等，等等，等等。是的。我的天哪。開玩笑。我的天啊。  我的天啊。  這不是我之前知道的那個笑話，老兄。心地善良。聽。我還有生意要打理。你知道，我不能讓我的"}, {"type": "subtitle", "time": 1943.35, "timestamp": "00:32:23", "text": "貨物無人看管。"}, {"type": "subtitle", "time": 1957.029, "timestamp": "00:32:37", "text": "開玩笑。  我不信任這個人。不，我得先給發電機加滿油"}]
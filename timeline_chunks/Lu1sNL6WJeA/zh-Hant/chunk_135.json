[{"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "最後一個倖存者。或者他們可以"}, {"type": "subtitle", "time": 8112.99, "timestamp": "02:15:12", "text": "接招。在你身後。"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "你身後和你面前。"}, {"type": "subtitle", "time": 8119.83, "timestamp": "02:15:19", "text": "空無一人。"}, {"type": "subtitle", "time": 8125.27, "timestamp": "02:15:25", "text": "沒關係。這太難了。我瞄準了他，但是"}, {"type": "subtitle", "time": 8127.83, "timestamp": "02:15:27", "text": "遊戲卡住了，所以我什麼都做不了。"}, {"type": "subtitle", "time": 8130.39, "timestamp": "02:15:30", "text": "真可惜。"}, {"type": "subtitle", "time": 8143.229, "timestamp": "02:15:43", "text": "遊戲大神要說話了，各位。"}, {"type": "subtitle", "time": 8147.189, "timestamp": "02:15:47", "text": "安靜，遊戲大神要說話了。"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "遊戲大神。"}, {"type": "subtitle", "time": 8152.47, "timestamp": "02:15:52", "text": "好的。你最喜歡的遊戲是什麼？"}, {"type": "subtitle", "time": 8155.35, "timestamp": "02:15:55", "text": "最喜歡的遊戲？嗯，這可真是個"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "難題，對吧？是啊，"}]
[{"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "因為A點已經清空了。"}, {"type": "subtitle", "time": 7985.91, "timestamp": "02:13:05", "text": "沒有清空。他之前在A點，但…"}, {"type": "subtitle", "time": 7988.589, "timestamp": "02:13:08", "text": "不，他不是我。他在那兒"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "。我錯過了他。"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "最後一個倖存者。我又錯過他了"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "。是的，那邊一個，那邊一個"}, {"type": "subtitle", "time": 8000.83, "timestamp": "02:13:20", "text": "。"}, {"type": "subtitle", "time": 8002.95, "timestamp": "02:13:22", "text": "好吧，他們會看到我然後殺了"}, {"type": "subtitle", "time": 8005.589, "timestamp": "02:13:25", "text": "我，對吧？還剩一個敵人。我的"}, {"type": "subtitle", "time": 8007.629, "timestamp": "02:13:27", "text": "大招是……"}, {"type": "subtitle", "time": 8010.87, "timestamp": "02:13:30", "text": "啊，米安德拉是個好玩家。我想他就是"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "之前一槍爆頭我們的那個人。當然，他是我們"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "小隊的主力。他為什麼不行？"}, {"type": "subtitle", "time": 8021.669, "timestamp": "02:13:41", "text": "他是最強的玩家。嗯，"}, {"type": "subtitle", "time": 8023.51, "timestamp": "02:13:43", "text": "沒事。我會想辦法解決"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "這傢伙喜歡在中路狙擊。是啊，"}, {"type": "subtitle", "time": 8034.229, "timestamp": "02:13:54", "text": "他確實喜歡。嗯，"}, {"type": "subtitle", "time": 8036.39, "timestamp": "02:13:56", "text": "我會殺了他。他有護盾。"}, {"type": "subtitle", "time": 8037.75, "timestamp": "02:13:57", "text": "所以很難"}]
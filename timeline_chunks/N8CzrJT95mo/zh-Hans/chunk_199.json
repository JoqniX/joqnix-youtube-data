[{"type": "subtitle", "time": 11948.269, "timestamp": "03:19:08", "text": "那。"}, {"type": "subtitle", "time": 11950.63, "timestamp": "03:19:10", "text": "是的。是时候让你上线了"}, {"type": "subtitle", "time": 11954.469, "timestamp": "03:19:14", "text": "替代。不，没关系。糟糕。你看到我的"}, {"type": "subtitle", "time": 11957.75, "timestamp": "03:19:17", "text": "备选方案？哦，我的天哪。谢天谢地我没写"}, {"type": "subtitle", "time": 11960.229, "timestamp": "03:19:20", "text": "名称。是的，就是这些场景。"}, {"type": "subtitle", "time": 11965.349, "timestamp": "03:19:25", "text": "是我用来听音乐的小号。我"}, {"type": "subtitle", "time": 11968.309, "timestamp": "03:19:28", "text": "实际上像这样彻底清除"}, {"type": "subtitle", "time": 11971.99, "timestamp": "03:19:31", "text": "OBS小场景。这是个小问题。我使用"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "共有 87 个场景。我曾经拥有过"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "复杂的设置。"}, {"type": "subtitle", "time": 11980.229, "timestamp": "03:19:40", "text": "我为什么要精简它？因为我的这个"}, {"type": "subtitle", "time": 11983.83, "timestamp": "03:19:43", "text": "串流电脑：这台电脑配置较低。我有"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "限制很多事情。好的，我们会"}, {"type": "subtitle", "time": 11988.11, "timestamp": "03:19:48", "text": "我想，还是别这么做吧。"}, {"type": "subtitle", "time": 11991.269, "timestamp": "03:19:51", "text": "嗯，我们不会这么做。让我让我放"}, {"type": "subtitle", "time": 11992.269, "timestamp": "03:19:52", "text": "让我"}, {"type": "subtitle", "time": 11996.15, "timestamp": "03:19:56", "text": "我：不，我会移除实验室的控制项。"}]
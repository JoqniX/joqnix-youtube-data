[{"type": "subtitle", "time": 8460.07, "timestamp": "02:21:00", "text": "是个好主意。谢谢你送的蝴蝶"}, {"type": "subtitle", "time": 8463.75, "timestamp": "02:21:03", "text": "东西。各位晚安。小心。"}, {"type": "subtitle", "time": 8465.95, "timestamp": "02:21:05", "text": "别死。好的"}, {"type": "subtitle", "time": 8474.309, "timestamp": "02:21:14", "text": "哦，等等。我该让我自己展示吗？"}, {"type": "subtitle", "time": 8477.51, "timestamp": "02:21:17", "text": "直播中？不，你可以看看"}, {"type": "subtitle", "time": 8479.75, "timestamp": "02:21:19", "text": "它。太恶心了。我不知道该怎么做"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "它来了。"}, {"type": "subtitle", "time": 8484.23, "timestamp": "02:21:24", "text": "没关系。"}, {"type": "subtitle", "time": 8486.429, "timestamp": "02:21:26", "text": "再见。"}, {"type": "subtitle", "time": 8488.71, "timestamp": "02:21:28", "text": "再见，晚安。谢谢。"}, {"type": "subtitle", "time": 8492.07, "timestamp": "02:21:32", "text": "今天就到这里。我玩得很开心"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "再次合作。那就这么定了。"}, {"type": "subtitle", "time": 8501.19, "timestamp": "02:21:41", "text": "我要休息一下，因为我……而且我"}, {"type": "subtitle", "time": 8504.07, "timestamp": "02:21:44", "text": "我忘了喝我的袖口糖浆。"}, {"type": "subtitle", "time": 8506.95, "timestamp": "02:21:46", "text": "我喝。是的。是的。喝药。"}, {"type": "subtitle", "time": 8508.95, "timestamp": "02:21:48", "text": "我甚至连打扫卫生的欲望都没有。"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "晚安。你好。晚安。再见。"}]
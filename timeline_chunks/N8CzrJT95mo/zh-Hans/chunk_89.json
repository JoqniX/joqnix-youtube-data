[{"type": "subtitle", "time": 5371.31, "timestamp": "01:29:31", "text": "你好"}, {"type": "subtitle", "time": 5373.75, "timestamp": "01:29:33", "text": "现在假装走。观看愉快。好的。"}, {"type": "subtitle", "time": 5375.59, "timestamp": "01:29:35", "text": "好的。晚安，兄弟。你好。晚安。"}, {"type": "subtitle", "time": 5377.47, "timestamp": "01:29:37", "text": "睡得好。"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "夜晚。我的天哪，我的喉咙卡住了"}, {"type": "subtitle", "time": 5393.31, "timestamp": "01:29:53", "text": "在"}]
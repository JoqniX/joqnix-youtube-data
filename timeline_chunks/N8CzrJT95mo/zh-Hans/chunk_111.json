[{"type": "subtitle", "time": 6664.629, "timestamp": "01:51:04", "text": "你不觉得吗？嗯？约阿巴卡。"}, {"type": "subtitle", "time": 6667.239, "timestamp": "01:51:07", "text": "约阿巴卡。 约阿巴卡。它就像一只小猪。"}, {"type": "subtitle", "time": 6682.47, "timestamp": "01:51:22", "text": "等等，那是卡卡鹦鹉。是的。我如何跌倒？"}, {"type": "subtitle", "time": 6685.7, "timestamp": "01:51:25", "text": "我的天啊。等等，这个？不。"}, {"type": "subtitle", "time": 6687.47, "timestamp": "01:51:27", "text": "[音乐]"}, {"type": "subtitle", "time": 6690.669, "timestamp": "01:51:30", "text": "呃，嗨。好的。等待。这"}, {"type": "subtitle", "time": 6694.709, "timestamp": "01:51:34", "text": "方式。这边走。"}, {"type": "subtitle", "time": 6697.189, "timestamp": "01:51:37", "text": "哦，是同一件事。我们也是一样。"}, {"type": "subtitle", "time": 6698.91, "timestamp": "01:51:38", "text": "做过。但到"}, {"type": "subtitle", "time": 6704.39, "timestamp": "01:51:44", "text": "顺便一提，多林戈去世了。嘿，"}, {"type": "subtitle", "time": 6706.149, "timestamp": "01:51:46", "text": "什么？"}, {"type": "subtitle", "time": 6711.91, "timestamp": "01:51:51", "text": "那只鸟死了。哦，我把它杀了。"}, {"type": "subtitle", "time": 6713.669, "timestamp": "01:51:53", "text": "什么？接下来我该怎么办"}, {"type": "subtitle", "time": 6717.35, "timestamp": "01:51:57", "text": "现在是这样吗？哦。呃，打开它然后做"}]
[{"type": "subtitle", "time": 11400.87, "timestamp": "03:10:00", "text": "生活。即使你的生命……你也可以"}, {"type": "subtitle", "time": 11405.11, "timestamp": "03:10:05", "text": "你自身的生活方式和日常生活是"}, {"type": "subtitle", "time": 11408.309, "timestamp": "03:10:08", "text": "比如无聊之类的，这就是你可以怎么做"}, {"type": "subtitle", "time": 11411.11, "timestamp": "03:10:11", "text": "让你的现在的自己充满乐趣"}, {"type": "subtitle", "time": 11413.11, "timestamp": "03:10:13", "text": "而且很有趣，所以你可以……"}, {"type": "subtitle", "time": 11416.309, "timestamp": "03:10:16", "text": "一些值得期待的事情，嗯，制作"}, {"type": "subtitle", "time": 11418.87, "timestamp": "03:10:18", "text": "更有趣、更吸引人的事情"}, {"type": "subtitle", "time": 11421.91, "timestamp": "03:10:21", "text": "在你的生活中，这才是关键所在。"}, {"type": "subtitle", "time": 11423.83, "timestamp": "03:10:23", "text": "而不是担忧未来"}, {"type": "subtitle", "time": 11426.95, "timestamp": "03:10:26", "text": "我认为，过去是你最重要的事。"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "重点是……所以，呃，在你的现在……如何……"}, {"type": "subtitle", "time": 11434.71, "timestamp": "03:10:34", "text": "你塑造了现在的自己"}, {"type": "subtitle", "time": 11438.19, "timestamp": "03:10:38", "text": "呃，目前的生活方式充实而有意义。"}, {"type": "subtitle", "time": 11440.87, "timestamp": "03:10:40", "text": "有趣，让你一直……"}, {"type": "subtitle", "time": 11444.95, "timestamp": "03:10:44", "text": "继续前进。弄到酒很容易。我"}, {"type": "subtitle", "time": 11447.51, "timestamp": "03:10:47", "text": "了解一下非酒精饮料"}, {"type": "subtitle", "time": 11457.99, "timestamp": "03:10:57", "text": "我。是的，但我需要热水。我忘了"}, {"type": "subtitle", "time": 11459.83, "timestamp": "03:10:59", "text": "去续热水。没关系。患病的"}]
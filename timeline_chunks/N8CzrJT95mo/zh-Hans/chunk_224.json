[{"type": "subtitle", "time": 13442.59, "timestamp": "03:44:02", "text": "它。有"}, {"type": "subtitle", "time": 13445.63, "timestamp": "03:44:05", "text": "我当时就想，“哦，这是……”"}, {"type": "subtitle", "time": 13448.87, "timestamp": "03:44:08", "text": "“酷。”你确定吗？我觉得我不太酷。"}, {"type": "subtitle", "time": 13451.67, "timestamp": "03:44:11", "text": "我随时都会梦到萨米"}, {"type": "subtitle", "time": 13454.11, "timestamp": "03:44:14", "text": "很快。我已经很久没碰过它了"}, {"type": "subtitle", "time": 13456.71, "timestamp": "03:44:16", "text": "这。呃，我想它在……"}, {"type": "subtitle", "time": 13458.63, "timestamp": "03:44:18", "text": "换个名字之类的。它在"}, {"type": "subtitle", "time": 13460.389, "timestamp": "03:44:20", "text": "它可能用了另一个名字。"}, {"type": "subtitle", "time": 13463.75, "timestamp": "03:44:23", "text": "我知道它在这里。我知道它在这里。为什么"}, {"type": "subtitle", "time": 13465.79, "timestamp": "03:44:25", "text": "难道不是吗？"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "这里？我真的在做梦吗？啊，设置"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "隐藏变量。哦，等等。你看，你看，我"}, {"type": "subtitle", "time": 13474.03, "timestamp": "03:44:34", "text": "我早就跟你说过"}, {"type": "subtitle", "time": 13478.309, "timestamp": "03:44:38", "text": "伙计们。我的天啊。测试。测试。是的。看，"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "看，看，看，看。它变成了哈希值"}, {"type": "subtitle", "time": 13483.03, "timestamp": "03:44:43", "text": "东西。耶。隐藏变量。这是"}, {"type": "subtitle", "time": 13490.269, "timestamp": "03:44:50", "text": "关于。但"}, {"type": "subtitle", "time": 13493.349, "timestamp": "03:44:53", "text": "嗯，对不起。对不起。对不起。"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "但是，当我打开变量时，"}, {"type": "subtitle", "time": 13498.309, "timestamp": "03:44:58", "text": "窗户有点漏水，水会从窗户里流出来。"}]
[{"type": "subtitle", "time": 15662.63, "timestamp": "04:21:02", "text": "嗯？什么？我做错了什么？什么"}, {"type": "subtitle", "time": 15663.63, "timestamp": "04:21:03", "text": "我愿意"}, {"type": "subtitle", "time": 15667.149, "timestamp": "04:21:07", "text": "错误的？我做了什么？"}, {"type": "subtitle", "time": 15669.03, "timestamp": "04:21:09", "text": "错误的？等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 15699.349, "timestamp": "04:21:39", "text": "这很令人困惑。我的大脑并非如此"}, {"type": "subtitle", "time": 15704.59, "timestamp": "04:21:44", "text": "片刻。"}, {"type": "subtitle", "time": 15707.83, "timestamp": "04:21:47", "text": "糟糕，等等。我有个主意。如果我"}, {"type": "subtitle", "time": 15711.11, "timestamp": "04:21:51", "text": "添加文本框？呃，我就在附近。呃"}, {"type": "subtitle", "time": 15713.87, "timestamp": "04:21:53", "text": "这样我就可以把"}, {"type": "subtitle", "time": 15715.55, "timestamp": "04:21:55", "text": "事物。"}]
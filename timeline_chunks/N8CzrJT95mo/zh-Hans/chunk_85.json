[{"type": "subtitle", "time": 5115.31, "timestamp": "01:25:15", "text": "嗨，那个"}, {"type": "subtitle", "time": 5123.43, "timestamp": "01:25:23", "text": "瓜纳。我觉得我正在努力，我觉得"}, {"type": "subtitle", "time": 5126.149, "timestamp": "01:25:26", "text": "我正在慢慢地努力好起来。"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "我正在慢慢地尝试成为"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "这首歌终于表达了情感。"}, {"type": "subtitle", "time": 5132.99, "timestamp": "01:25:32", "text": "如此漫长"}, {"type": "subtitle", "time": 5136.75, "timestamp": "01:25:36", "text": "实践。它正慢慢地、慢慢地到来。"}]
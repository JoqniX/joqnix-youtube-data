[{"type": "subtitle", "time": 21243.91, "timestamp": "05:54:03", "text": "th00and 好的 1,000 和随机化"}, {"type": "subtitle", "time": 21251.83, "timestamp": "05:54:11", "text": "1500毫秒，然后是"}, {"type": "subtitle", "time": 21255.11, "timestamp": "05:54:15", "text": "洗牌可以在最后进行。"}, {"type": "subtitle", "time": 21258.67, "timestamp": "05:54:18", "text": "字符串变量将如下所示"}, {"type": "subtitle", "time": 21261.27, "timestamp": "05:54:21", "text": "这。等等，现在别换台。"}, {"type": "subtitle", "time": 21262.868, "timestamp": "05:54:22", "text": "实际上，"}, {"type": "subtitle", "time": 21266.91, "timestamp": "05:54:26", "text": "呃，我们需要测试一下。"}, {"type": "subtitle", "time": 21270.27, "timestamp": "05:54:30", "text": "保存并"}, {"type": "subtitle", "time": 21273.91, "timestamp": "05:54:33", "text": "跑步。这样我们就得到了数组的大小。是的，我们"}, {"type": "subtitle", "time": 21277.27, "timestamp": "05:54:37", "text": "获取完整尺寸。好的。所以现在我们这样做"}, {"type": "subtitle", "time": 21279.99, "timestamp": "05:54:39", "text": "最小值和最大值。"}, {"type": "subtitle", "time": 21283.91, "timestamp": "05:54:43", "text": "所以我们把尺寸放在这里。复制"}, {"type": "subtitle", "time": 21286.868, "timestamp": "05:54:46", "text": "小路。我们把它放在这里了。最大限度"}, {"type": "subtitle", "time": 21289.23, "timestamp": "05:54:49", "text": "允许"}, {"type": "subtitle", "time": 21294.27, "timestamp": "05:54:54", "text": "尺寸。好的。最低限度是呃"}, {"type": "subtitle", "time": 21299.67, "timestamp": "05:54:59", "text": "零。我们把它写成……嗯，它会是"}]
[{"type": "subtitle", "time": 9000.83, "timestamp": "02:30:00", "text": "大的。正确的。"}, {"type": "subtitle", "time": 9002.51, "timestamp": "02:30:02", "text": "[音乐]"}, {"type": "subtitle", "time": 9017.23, "timestamp": "02:30:17", "text": "你好。好的。所以，我需要打扫一下。"}, {"type": "subtitle", "time": 9020.03, "timestamp": "02:30:20", "text": "我们尽力了。"}, {"type": "subtitle", "time": 9022.55, "timestamp": "02:30:22", "text": "今天。好的。我们会再见面的。"}, {"type": "subtitle", "time": 9024.349, "timestamp": "02:30:24", "text": "下一期。"}, {"type": "subtitle", "time": 9027.23, "timestamp": "02:30:27", "text": "好的。晚安，祝你一切顺利"}, {"type": "subtitle", "time": 9030.79, "timestamp": "02:30:30", "text": "一。再见。我该怎么做？我该怎么做？"}, {"type": "subtitle", "time": 9032.03, "timestamp": "02:30:32", "text": "像这样？"}, {"type": "subtitle", "time": 9034.93, "timestamp": "02:30:34", "text": "不，那是错的。"}, {"type": "subtitle", "time": 9036.27, "timestamp": "02:30:36", "text": "[音乐]"}, {"type": "subtitle", "time": 9052.349, "timestamp": "02:30:52", "text": "宝贝，好"}, {"type": "subtitle", "time": 9055.349, "timestamp": "02:30:55", "text": "晚安，感谢大家今天的陪伴。你"}, {"type": "subtitle", "time": 9057.27, "timestamp": "02:30:57", "text": "我知道，每次我结束直播的时候，我都会这样做。"}, {"type": "subtitle", "time": 9059.91, "timestamp": "02:30:59", "text": "这种挥手的情绪"}]
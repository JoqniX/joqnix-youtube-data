[{"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "哦，不。这行不通。你必须是"}, {"type": "subtitle", "time": 11887.09, "timestamp": "03:18:07", "text": "为了控制而活"}, {"type": "subtitle", "time": 11893.49, "timestamp": "03:18:13", "text": "奥比亚。不。"}, {"type": "subtitle", "time": 11897.87, "timestamp": "03:18:17", "text": "[笑声]"}, {"type": "subtitle", "time": 11906.63, "timestamp": "03:18:26", "text": "等待。好吧，行。我们不会使用这个。"}, {"type": "subtitle", "time": 11909.469, "timestamp": "03:18:29", "text": "美好的。我当时就像"}, {"type": "subtitle", "time": 11915.95, "timestamp": "03:18:35", "text": "[音乐]"}, {"type": "subtitle", "time": 11919.469, "timestamp": "03:18:39", "text": "手。我刷新"}, {"type": "subtitle", "time": 11923.03, "timestamp": "03:18:43", "text": "你。好的，它奏效了。好的。移动的"}, {"type": "subtitle", "time": 11925.99, "timestamp": "03:18:45", "text": "移动低流量。它知道它拥有一切。"}, {"type": "subtitle", "time": 11928.75, "timestamp": "03:18:48", "text": "我的戏份，对吧？好的。"}, {"type": "subtitle", "time": 11933.309, "timestamp": "03:18:53", "text": "好的。所以，我正在寻找的是我的"}, {"type": "subtitle", "time": 11936.469, "timestamp": "03:18:56", "text": "场景。但是等等，这是有限的。否"}, {"type": "subtitle", "time": 11939.83, "timestamp": "03:18:59", "text": "有限的。我不能……哦，等等。这只是"}]
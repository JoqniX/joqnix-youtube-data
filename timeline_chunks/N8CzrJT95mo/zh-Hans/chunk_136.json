[{"type": "subtitle", "time": 8167.47, "timestamp": "02:16:07", "text": "不，我不能吗？"}, {"type": "subtitle", "time": 8172.87, "timestamp": "02:16:12", "text": "就像，嗯，是的，在认识你之后，我"}, {"type": "subtitle", "time": 8175.35, "timestamp": "02:16:15", "text": "了解到关于睡眠醉酒的事情"}, {"type": "subtitle", "time": 8177.35, "timestamp": "02:16:17", "text": "东西。我不知道那是什么。我"}, {"type": "subtitle", "time": 8181.27, "timestamp": "02:16:21", "text": "我觉得我喝醉了，袖子都快掉下来了"}, {"type": "subtitle", "time": 8183.75, "timestamp": "02:16:23", "text": "当你在户外附近散步时"}, {"type": "subtitle", "time": 8186.39, "timestamp": "02:16:26", "text": "湖。"}, {"type": "subtitle", "time": 8189.91, "timestamp": "02:16:29", "text": "我当时大概是又累又醉了吧。我的天啊，快看"}, {"type": "subtitle", "time": 8193.03, "timestamp": "02:16:33", "text": "落入我手中。查德，我不知道它在哪里"}, {"type": "subtitle", "time": 8203.83, "timestamp": "02:16:43", "text": "真恶心。我该怎么做？哦，对了。哦，"}, {"type": "subtitle", "time": 8211.07, "timestamp": "02:16:51", "text": "好的。好的。好的。我是"}, {"type": "subtitle", "time": 8218.469, "timestamp": "02:16:58", "text": "未来。好的。看起来像是"}]
[{"type": "subtitle", "time": 12360.309, "timestamp": "03:26:00", "text": "呃"}, {"type": "subtitle", "time": 12364.309, "timestamp": "03:26:04", "text": "东西。聊天命令，这很好"}, {"type": "subtitle", "time": 12366.79, "timestamp": "03:26:06", "text": "我用了一段时间了。聊天"}, {"type": "subtitle", "time": 12370.429, "timestamp": "03:26:10", "text": "命令。这个人，我没认识。"}, {"type": "subtitle", "time": 12374.309, "timestamp": "03:26:14", "text": "双倍的。这是桑多·兰迪的风格。啊，"}, {"type": "subtitle", "time": 12379.15, "timestamp": "03:26:19", "text": "对，就是那个。我没碰过"}, {"type": "subtitle", "time": 12383.15, "timestamp": "03:26:23", "text": "它。好的。呃，哪里是"}, {"type": "subtitle", "time": 12386.03, "timestamp": "03:26:26", "text": "我在哪里"}, {"type": "subtitle", "time": 12390.11, "timestamp": "03:26:30", "text": "我的天，是这个吗？"}, {"type": "subtitle", "time": 12402.75, "timestamp": "03:26:42", "text": "是"}, {"type": "subtitle", "time": 12405.19, "timestamp": "03:26:45", "text": "假的。哦，没关系。没关系。它是"}, {"type": "subtitle", "time": 12410.19, "timestamp": "03:26:50", "text": "哦"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "圣。我确信我应该做些什么。"}, {"type": "subtitle", "time": 12419.67, "timestamp": "03:26:59", "text": "已经完成了。我的天啊。等待了多久？"}]
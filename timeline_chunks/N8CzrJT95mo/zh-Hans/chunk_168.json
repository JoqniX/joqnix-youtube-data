[{"type": "subtitle", "time": 10082.19, "timestamp": "02:48:02", "text": "哦。哦"}, {"type": "subtitle", "time": 10090.469, "timestamp": "02:48:10", "text": "该组甚至在15号开始"}, {"type": "subtitle", "time": 10093.03, "timestamp": "02:48:13", "text": "分钟。刚才讨论的是什么来着？什么"}, {"type": "subtitle", "time": 10095.349, "timestamp": "02:48:15", "text": "你们国家有哪些风俗习惯？"}, {"type": "subtitle", "time": 10098.469, "timestamp": "02:48:18", "text": "情人节那天？有人在聊天吗？"}, {"type": "subtitle", "time": 10101.11, "timestamp": "02:48:21", "text": "谁是印度人，可以告诉我什么"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "我们有哪些习俗？再说一遍，我没有"}, {"type": "subtitle", "time": 10106.59, "timestamp": "02:48:26", "text": "我们认为我们有特定的习俗，"}, {"type": "subtitle", "time": 10109.309, "timestamp": "02:48:29", "text": "正确的？都是些普通的事儿。"}, {"type": "subtitle", "time": 10116.79, "timestamp": "02:48:36", "text": "白天，就是一些普通的琐事。"}, {"type": "subtitle", "time": 10126.269, "timestamp": "02:48:46", "text": "天。"}, {"type": "subtitle", "time": 10128.67, "timestamp": "02:48:48", "text": "嗯，它在哪儿？"}, {"type": "subtitle", "time": 10133.07, "timestamp": "02:48:53", "text": "是的。实例。我的天，九个人"}, {"type": "subtitle", "time": 10136.15, "timestamp": "02:48:56", "text": "那里。谢谢。我们应该加入吗？"}, {"type": "subtitle", "time": 10138.95, "timestamp": "02:48:58", "text": "最后时刻？我们应该加入吗？等等"}]
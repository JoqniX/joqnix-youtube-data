[{"type": "subtitle", "time": 7861.37, "timestamp": "02:11:01", "text": "这边"}, {"type": "subtitle", "time": 7876.629, "timestamp": "02:11:16", "text": "[音乐]"}, {"type": "subtitle", "time": 7880.03, "timestamp": "02:11:20", "text": "折纸作品完成了。折纸是"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "完全的。美丽的纸手镯"}, {"type": "subtitle", "time": 7886.75, "timestamp": "02:11:26", "text": "心形。我的天哪，这看起来很难……"}, {"type": "subtitle", "time": 7896.51, "timestamp": "02:11:36", "text": "庆典。给我们办个派对，好好招待我们。"}, {"type": "subtitle", "time": 7898.76, "timestamp": "02:11:38", "text": "我们。 恭喜。它是"}, {"type": "subtitle", "time": 7901.239, "timestamp": "02:11:41", "text": "恭喜。它是 庆祝活动。"}, {"type": "subtitle", "time": 7902.81, "timestamp": "02:11:42", "text": "庆祝活动。 [音乐]"}, {"type": "subtitle", "time": 7904.119, "timestamp": "02:11:44", "text": "[音乐] 欺骗，然后睡觉。好的。"}, {"type": "subtitle", "time": 7915.03, "timestamp": "02:11:55", "text": "好了，各位。我们完成了。耶。"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "我不知道它是否漂亮。"}]
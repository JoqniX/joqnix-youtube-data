[{"type": "subtitle", "time": 7980.79, "timestamp": "02:13:00", "text": "你的。哦好的。好的。好的。放我走"}, {"type": "subtitle", "time": 8014.589, "timestamp": "02:13:34", "text": "我得到了它。"}, {"type": "subtitle", "time": 8018.39, "timestamp": "02:13:38", "text": "耶。我需要一把……嗯，就是这种剪刀。"}, {"type": "subtitle", "time": 8021.83, "timestamp": "02:13:41", "text": "太酷了。你可以把它拆开。"}, {"type": "subtitle", "time": 8025.149, "timestamp": "02:13:45", "text": "并变成它变成了一个"}, {"type": "subtitle", "time": 8028.709, "timestamp": "02:13:48", "text": "剪刀。好的。是的，这就像……"}, {"type": "subtitle", "time": 8030.109, "timestamp": "02:13:50", "text": "折叠式"}, {"type": "subtitle", "time": 8033.35, "timestamp": "02:13:53", "text": "剪刀。看看它。太可爱了。就像"}, {"type": "subtitle", "time": 8036.79, "timestamp": "02:13:56", "text": "不过是儿童剪刀。是的。狗是"}, {"type": "subtitle", "time": 8038.79, "timestamp": "02:13:58", "text": "孩子。"}]
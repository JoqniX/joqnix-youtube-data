[{"type": "subtitle", "time": 8111.589, "timestamp": "02:15:11", "text": "GTA 6 之前就有 Joker Hand 了。什么？"}, {"type": "subtitle", "time": 8114.629, "timestamp": "02:15:14", "text": "不，我以前就射伤过自己的手。"}, {"type": "subtitle", "time": 8116.47, "timestamp": "02:15:16", "text": "我猜"}, {"type": "subtitle", "time": 8118.31, "timestamp": "02:15:18", "text": "呃，那是很久以前的事了。那时"}, {"type": "subtitle", "time": 8121.709, "timestamp": "02:15:21", "text": "我当时身处临时住所。"}, {"type": "subtitle", "time": 8124.55, "timestamp": "02:15:24", "text": "活的。等等，他怎么做到的？他怎么做到的？"}, {"type": "subtitle", "time": 8128.149, "timestamp": "02:15:28", "text": "你也要锻炼身体吗？"}, {"type": "subtitle", "time": 8130.189, "timestamp": "02:15:30", "text": "伊阿什。"}, {"type": "subtitle", "time": 8134.55, "timestamp": "02:15:34", "text": "不，等等，我好像做过。不，我不这么认为。"}, {"type": "subtitle", "time": 8135.709, "timestamp": "02:15:35", "text": "怎么可能"}, {"type": "subtitle", "time": 8139.35, "timestamp": "02:15:39", "text": "我？等等，我……我不记得了。"}, {"type": "subtitle", "time": 8141.669, "timestamp": "02:15:41", "text": "蠢事，我本来会有的，我有"}, {"type": "subtitle", "time": 8147.83, "timestamp": "02:15:47", "text": "我不这么认为。等等，我真的有吗？不，我"}, {"type": "subtitle", "time": 8149.75, "timestamp": "02:15:49", "text": "我不这么认为。"}, {"type": "subtitle", "time": 8152.87, "timestamp": "02:15:52", "text": "以前你经常去溪边散步。"}, {"type": "subtitle", "time": 8156.31, "timestamp": "02:15:56", "text": "哦，不。我不记得了。我当时就想，"}, {"type": "subtitle", "time": 8159.87, "timestamp": "02:15:59", "text": "嗯，是啊，你让我记起来了。"}]
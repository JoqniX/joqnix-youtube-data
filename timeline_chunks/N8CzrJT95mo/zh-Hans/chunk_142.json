[{"type": "subtitle", "time": 8526.11, "timestamp": "02:22:06", "text": "结束。然后她就离开了。"}, {"type": "subtitle", "time": 8529.99, "timestamp": "02:22:09", "text": "耶。好的品质是关键。谢谢"}, {"type": "subtitle", "time": 8533.349, "timestamp": "02:22:13", "text": "所有到场的人也都一样。等等，我想"}, {"type": "subtitle", "time": 8537.07, "timestamp": "02:22:17", "text": "我仍然可以对着镜头，我"}, {"type": "subtitle", "time": 8540.91, "timestamp": "02:22:20", "text": "猜测。所以，谢谢你们"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "感谢各位的光临。"}, {"type": "subtitle", "time": 8548.23, "timestamp": "02:22:28", "text": "你们喜欢和Zuki一起玩吗？"}, {"type": "subtitle", "time": 8551.87, "timestamp": "02:22:31", "text": "陪我们一起制作纸工艺品"}, {"type": "subtitle", "time": 8554.349, "timestamp": "02:22:34", "text": "一切？很有趣。"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "正确的？祖琪尽力了。所以，我是"}, {"type": "subtitle", "time": 8566.95, "timestamp": "02:22:46", "text": "最好的。下次我想做某事的时候"}, {"type": "subtitle", "time": 8571.51, "timestamp": "02:22:51", "text": "呃，该怎么办呢？提出一些你手上能想到的主意吧。"}]
[{"type": "subtitle", "time": 7022.189, "timestamp": "01:57:02", "text": "一天结束时我们共同创造的回忆。"}, {"type": "subtitle", "time": 7024.95, "timestamp": "01:57:04", "text": "是的。但如今的选择太多了。它是"}, {"type": "subtitle", "time": 7033.03, "timestamp": "01:57:13", "text": "是的。那么，你的计划是什么？"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "情人节？你是吗？你是那种……呃……"}, {"type": "subtitle", "time": 7038.629, "timestamp": "01:57:18", "text": "做巧克力吗？"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "我打算做个蛋糕。哦。"}, {"type": "subtitle", "time": 7045.91, "timestamp": "01:57:25", "text": "等等，你去年都做了些什么？做过"}, {"type": "subtitle", "time": 7047.75, "timestamp": "01:57:27", "text": "你不是烤了个蛋糕，还在电视上展示了吗？"}, {"type": "subtitle", "time": 7050.39, "timestamp": "01:57:30", "text": "直播之类的？我什么？"}, {"type": "subtitle", "time": 7053.91, "timestamp": "01:57:33", "text": "甚至还记得我去年做了什么。我"}, {"type": "subtitle", "time": 7058.35, "timestamp": "01:57:38", "text": "我想我当时没做什么。我最后做了什么吗？"}, {"type": "subtitle", "time": 7061.149, "timestamp": "01:57:41", "text": "年？呃，我得……"}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "查看。前年的那一天"}, {"type": "subtitle", "time": 7067.47, "timestamp": "01:57:47", "text": "我喜欢巧克力揭晓仪式。"}, {"type": "subtitle", "time": 7070.12, "timestamp": "01:57:50", "text": "溪流。啊。"}, {"type": "subtitle", "time": 7072.47, "timestamp": "01:57:52", "text": "[音乐]"}, {"type": "subtitle", "time": 7074.709, "timestamp": "01:57:54", "text": "我觉得我当时直播的次数并不多。"}, {"type": "subtitle", "time": 7079.03, "timestamp": "01:57:59", "text": "回到过去。翻。"}]
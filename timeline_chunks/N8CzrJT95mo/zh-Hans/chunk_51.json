[{"type": "subtitle", "time": 3063.15, "timestamp": "00:51:03", "text": "呃，"}, {"type": "subtitle", "time": 3067.03, "timestamp": "00:51:07", "text": "英语太差了。没关系。不"}, {"type": "subtitle", "time": 3069.309, "timestamp": "00:51:09", "text": "担心。它是"}, {"type": "subtitle", "time": 3081.23, "timestamp": "00:51:21", "text": "担忧。这是最新的一起。"}, {"type": "subtitle", "time": 3085.069, "timestamp": "00:51:25", "text": "星之始祖两个月"}, {"type": "subtitle", "time": 3089.99, "timestamp": "00:51:29", "text": "前。还可以做得更好。哈哈。"}, {"type": "subtitle", "time": 3098.23, "timestamp": "00:51:38", "text": "伤心。我要去，我想找到"}, {"type": "subtitle", "time": 3100.63, "timestamp": "00:51:40", "text": "这样我就可以把它保存到播放列表里了。为什么"}, {"type": "subtitle", "time": 3103.19, "timestamp": "00:51:43", "text": "我找不到播放列表吗？我记得"}, {"type": "subtitle", "time": 3105.19, "timestamp": "00:51:45", "text": "从这里下载，对吧？让我"}, {"type": "subtitle", "time": 3111.5, "timestamp": "00:51:51", "text": "那。它在哪里？黄升"}, {"type": "subtitle", "time": 3113.71, "timestamp": "00:51:53", "text": "[音乐]"}, {"type": "subtitle", "time": 3118.67, "timestamp": "00:51:58", "text": "星星。你在哪里？我"}]
[{"type": "subtitle", "time": 13681.91, "timestamp": "03:48:01", "text": "呃。啊。点。我们加了一个点。好的。我们放"}, {"type": "subtitle", "time": 13688.87, "timestamp": "03:48:08", "text": "我也停止使用 Notion 了。它是"}, {"type": "subtitle", "time": 13690.349, "timestamp": "03:48:10", "text": "一直是"}, {"type": "subtitle", "time": 13693.07, "timestamp": "03:48:13", "text": "尽管。呃，他去哪儿了？"}, {"type": "subtitle", "time": 13699.229, "timestamp": "03:48:19", "text": "东西？呃"}, {"type": "subtitle", "time": 13703.63, "timestamp": "03:48:23", "text": "等等，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 13707.67, "timestamp": "03:48:27", "text": "糟糕，我的翻译器出问题了。哦。哦，"}, {"type": "subtitle", "time": 13710.75, "timestamp": "03:48:30", "text": "等待。好久不见了。"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "呃，等等。我当时在哪儿做另一件事呢？"}, {"type": "subtitle", "time": 13716.229, "timestamp": "03:48:36", "text": "我之前展示的那个东西？等等，在哪儿？"}, {"type": "subtitle", "time": 13720.07, "timestamp": "03:48:40", "text": "我做过这个吗？不。为什么我有这么多"}, {"type": "subtitle", "time": 13722.349, "timestamp": "03:48:42", "text": "很多装饰性按钮？"}, {"type": "subtitle", "time": 13725.87, "timestamp": "03:48:45", "text": "删除。这到底是什么？好的，等等。"}, {"type": "subtitle", "time": 13729.91, "timestamp": "03:48:49", "text": "不。它在哪儿？我刚打开它。等待，"}, {"type": "subtitle", "time": 13732.03, "timestamp": "03:48:52", "text": "它不见了。好吧，行。我来做。"}, {"type": "subtitle", "time": 13735.75, "timestamp": "03:48:55", "text": "再次。我的东西太乱了。我是"}, {"type": "subtitle", "time": 13739.309, "timestamp": "03:48:59", "text": "对不起。好的。所以对于变量"}]
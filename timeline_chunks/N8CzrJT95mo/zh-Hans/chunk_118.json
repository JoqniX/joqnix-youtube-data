[{"type": "subtitle", "time": 7083.589, "timestamp": "01:58:03", "text": "是的，我想我当时应该没有直播。"}, {"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "她会做噩梦的。"}, {"type": "subtitle", "time": 7087.47, "timestamp": "01:58:07", "text": "今天的"}, {"type": "subtitle", "time": 7091.51, "timestamp": "01:58:11", "text": "手工制作。不，她不会。"}, {"type": "subtitle", "time": 7094.149, "timestamp": "01:58:14", "text": "将年龄分为三个部分。她"}, {"type": "subtitle", "time": 7097.87, "timestamp": "01:58:17", "text": "那段时间我参加了一场婚礼。"}, {"type": "subtitle", "time": 7101.79, "timestamp": "01:58:21", "text": "时间。嗯。什么时候"}, {"type": "subtitle", "time": 7107.91, "timestamp": "01:58:27", "text": "呃，去年情人节的时候啊"}, {"type": "subtitle", "time": 7111.709, "timestamp": "01:58:31", "text": "我曾经直播过一次俄罗斯方块游戏"}, {"type": "subtitle", "time": 7116.79, "timestamp": "01:58:36", "text": "四月 二月十四日。那很好笑。"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "哇。哦，对了，还有沙子俄罗斯方块。"}, {"type": "subtitle", "time": 7121.99, "timestamp": "01:58:41", "text": "现在的情况。"}, {"type": "subtitle", "time": 7125.83, "timestamp": "01:58:45", "text": "我还没玩过。"}, {"type": "subtitle", "time": 7128.229, "timestamp": "01:58:48", "text": "我的身体一直不太好。所以，我还没有"}, {"type": "subtitle", "time": 7129.31, "timestamp": "01:58:49", "text": "真的"}, {"type": "subtitle", "time": 7132.31, "timestamp": "01:58:52", "text": "今天是我真正坐下来的日子"}, {"type": "subtitle", "time": 7133.229, "timestamp": "01:58:53", "text": "我的"}, {"type": "subtitle", "time": 7136.35, "timestamp": "01:58:56", "text": "几天后，你的电脑……"}, {"type": "subtitle", "time": 7139.91, "timestamp": "01:58:59", "text": "知道了，正在离开流媒体平台。我一直没有"}]
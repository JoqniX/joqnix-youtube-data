[{"type": "subtitle", "time": 7441.43, "timestamp": "02:04:01", "text": "你不玩游戏。你不玩"}, {"type": "subtitle", "time": 7449.83, "timestamp": "02:04:09", "text": "我也不玩原神。"}, {"type": "subtitle", "time": 7452.95, "timestamp": "02:04:12", "text": "我最近没玩《无限暖暖》"}, {"type": "subtitle", "time": 7456.229, "timestamp": "02:04:16", "text": "任何一个。我当时对它上瘾了。哦，我"}, {"type": "subtitle", "time": 7458.87, "timestamp": "02:04:18", "text": "也。耕作和故事都很美好。"}, {"type": "subtitle", "time": 7464.87, "timestamp": "02:04:24", "text": "但我喜欢装扮这个环节。好的。"}, {"type": "subtitle", "time": 7467.02, "timestamp": "02:04:27", "text": "是的。"}, {"type": "subtitle", "time": 7469.51, "timestamp": "02:04:29", "text": "[音乐]"}, {"type": "subtitle", "time": 7472.95, "timestamp": "02:04:32", "text": "过错。把它记下来。得到它。把它写下来"}, {"type": "subtitle", "time": 7474.189, "timestamp": "02:04:34", "text": "超过"}, {"type": "subtitle", "time": 7477.43, "timestamp": "02:04:37", "text": "它。我觉得我们应该在你……之后结束。"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "完毕。我好困。上角"}, {"type": "subtitle", "time": 7485.51, "timestamp": "02:04:45", "text": "向下。是的，我的也快完成了。"}, {"type": "subtitle", "time": 7491.03, "timestamp": "02:04:51", "text": "我会尽力自己制作"}, {"type": "subtitle", "time": 7493.149, "timestamp": "02:04:53", "text": "心"}, {"type": "subtitle", "time": 7497.669, "timestamp": "02:04:57", "text": "弓。好的，我会试试。即使它不"}]
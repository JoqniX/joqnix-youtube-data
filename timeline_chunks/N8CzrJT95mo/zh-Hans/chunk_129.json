[{"type": "subtitle", "time": 7740.229, "timestamp": "02:09:00", "text": "你直播吗？你为什么不做……"}, {"type": "subtitle", "time": 7743.109, "timestamp": "02:09:03", "text": "烘焙直播，但就像烘焙视频一样？"}, {"type": "subtitle", "time": 7746.069, "timestamp": "02:09:06", "text": "我今天就像你知道的那样，就像我的"}, {"type": "subtitle", "time": 7749.91, "timestamp": "02:09:09", "text": "我和我兄弟就那样，呃，我付给他200。"}, {"type": "subtitle", "time": 7752.75, "timestamp": "02:09:12", "text": "花费卢比即可获得这种独特的口味"}, {"type": "subtitle", "time": 7757.03, "timestamp": "02:09:17", "text": "奥利奥。奥利奥可乐。好的。可口可乐但是"}, {"type": "subtitle", "time": 7760.629, "timestamp": "02:09:20", "text": "奥利奥口味的，味道出乎意料的好。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "小心翼翼地，但同时又像"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "可口可乐。挺好的。"}, {"type": "subtitle", "time": 7769.99, "timestamp": "02:09:29", "text": "所以我和我的哥哥比库就像他一样"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "好吧，我们当时在拍一些照片。"}, {"type": "subtitle", "time": 7777.51, "timestamp": "02:09:37", "text": "像可怜的ASMR饮酒者一样翻来覆去地喝着"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "我可能会上传。"}, {"type": "subtitle", "time": 7790.47, "timestamp": "02:09:50", "text": "哦，你录下来了？是的。哇。好的。"}, {"type": "subtitle", "time": 7795.149, "timestamp": "02:09:55", "text": "也许我也会做个类似的烘焙视频。"}]
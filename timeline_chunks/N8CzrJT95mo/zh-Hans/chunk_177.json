[{"type": "subtitle", "time": 10628.63, "timestamp": "02:57:08", "text": "我迷上了这个孩子。啊，这个话题"}, {"type": "subtitle", "time": 10631.79, "timestamp": "02:57:11", "text": "各位帮帮我"}, {"type": "subtitle", "time": 10636.07, "timestamp": "02:57:16", "text": "呃，各位帮帮我。我们有哪些习俗？"}, {"type": "subtitle", "time": 10638.99, "timestamp": "02:57:18", "text": "在印度过情人节"}, {"type": "subtitle", "time": 10641.269, "timestamp": "02:57:21", "text": "天？我们有哪些习俗？"}, {"type": "subtitle", "time": 10644.15, "timestamp": "02:57:24", "text": "印度的情人节？我会尽量"}, {"type": "subtitle", "time": 10648.07, "timestamp": "02:57:28", "text": "把它放在公共领域，并在……中讨论。"}, {"type": "subtitle", "time": 10663.91, "timestamp": "02:57:43", "text": "嗯，你好吗？我很好。呃，我是"}, {"type": "subtitle", "time": 10666.63, "timestamp": "02:57:46", "text": "缓解喉咙痛的一种方式。"}, {"type": "subtitle", "time": 10670.389, "timestamp": "02:57:50", "text": "此外，它也逐渐过渡到"}, {"type": "subtitle", "time": 10674.67, "timestamp": "02:57:54", "text": "呃，发烧了，但谢天谢地，我还活着。"}, {"type": "subtitle", "time": 10677.51, "timestamp": "02:57:57", "text": "正在康复，我必须确保喝水"}, {"type": "subtitle", "time": 10679.64, "timestamp": "02:57:59", "text": "水 今天。大量的水。"}]
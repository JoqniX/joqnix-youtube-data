[{"type": "subtitle", "time": 7506.149, "timestamp": "02:05:06", "text": "尝试。但这还挺酷的。"}, {"type": "subtitle", "time": 7510.83, "timestamp": "02:05:10", "text": "就像纸艺一样。我从来不喜欢"}, {"type": "subtitle", "time": 7514.95, "timestamp": "02:05:14", "text": "全身心投入，付出这样的努力，但是"}, {"type": "subtitle", "time": 7521.189, "timestamp": "02:05:21", "text": "乐趣。所以，而且因为我买了类似的东西"}, {"type": "subtitle", "time": 7524.47, "timestamp": "02:05:24", "text": "素描本之类的东西，我真的应该"}, {"type": "subtitle", "time": 7525.629, "timestamp": "02:05:25", "text": "做"}, {"type": "subtitle", "time": 7530.95, "timestamp": "02:05:30", "text": "我想，更像是这种垫片吧。"}, {"type": "subtitle", "time": 7535.03, "timestamp": "02:05:35", "text": "并学习如何去做。将底部折叠起来"}, {"type": "subtitle", "time": 7542.47, "timestamp": "02:05:42", "text": "狗。"}, {"type": "subtitle", "time": 7543.62, "timestamp": "02:05:43", "text": "是的。"}, {"type": "subtitle", "time": 7546.47, "timestamp": "02:05:46", "text": "[音乐]"}, {"type": "subtitle", "time": 7548.95, "timestamp": "02:05:48", "text": "你竟然还住在我附近？"}, {"type": "subtitle", "time": 7553.35, "timestamp": "02:05:53", "text": "是？是的。那是什么问题？护士"}, {"type": "subtitle", "time": 7555.669, "timestamp": "02:05:55", "text": "里面。是的，我还在同一个地方"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "我出生于。"}]
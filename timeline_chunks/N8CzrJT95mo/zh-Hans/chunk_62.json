[{"type": "subtitle", "time": 3721.47, "timestamp": "01:02:01", "text": "到"}, {"type": "subtitle", "time": 3724.069, "timestamp": "01:02:04", "text": "选择。我不擅长做选择。就像"}, {"type": "subtitle", "time": 3725.75, "timestamp": "01:02:05", "text": "你是说，“你喜欢你妈妈吗？”"}, {"type": "subtitle", "time": 3733.349, "timestamp": "01:02:13", "text": "“两个都。”每次我都会这样"}, {"type": "subtitle", "time": 3745.25, "timestamp": "01:02:25", "text": "我想要你一些东西"}, {"type": "subtitle", "time": 3756.58, "timestamp": "01:02:36", "text": "决定性。我说不。"}]
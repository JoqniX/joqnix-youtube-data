[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "YouTube聊天。所以，我当时在想……"}, {"type": "subtitle", "time": 11103.389, "timestamp": "03:05:03", "text": "我可以通过某种方式复制 YouTube 聊天记录"}, {"type": "subtitle", "time": 11107.19, "timestamp": "03:05:07", "text": "直接从我的电脑传输到我的手机"}, {"type": "subtitle", "time": 11108.87, "timestamp": "03:05:08", "text": "用剪贴板，因为我的手机总是"}, {"type": "subtitle", "time": 11111.99, "timestamp": "03:05:11", "text": "已连接到手机链路，对吗？呃，"}, {"type": "subtitle", "time": 11115.59, "timestamp": "03:05:15", "text": "我可以做到。嗯，所以我觉得是"}, {"type": "subtitle", "time": 11118.63, "timestamp": "03:05:18", "text": "可能的。我们一起来解决这个问题。我想我"}, {"type": "subtitle", "time": 11120.95, "timestamp": "03:05:20", "text": "可能需要问问小队里的一些人。"}, {"type": "subtitle", "time": 11123.19, "timestamp": "03:05:23", "text": "服务器如何操作？呃，如果可以的话。"}, {"type": "subtitle", "time": 11125.59, "timestamp": "03:05:25", "text": "或不。但我们一起来解决这个问题吧，我"}, {"type": "subtitle", "time": 11128.15, "timestamp": "03:05:28", "text": "猜测。呃，还有什么？还有什么？呃"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "这是其中之一。第二，我们需要做点什么。"}, {"type": "subtitle", "time": 11132.63, "timestamp": "03:05:32", "text": "关于退伍军人事务部"}, {"type": "subtitle", "time": 11136.07, "timestamp": "03:05:36", "text": "呃，随机生成器，呃，也就是BBI V"}, {"type": "subtitle", "time": 11139.03, "timestamp": "03:05:39", "text": "东西。但对于聊天版主来说"}, {"type": "subtitle", "time": 11140.71, "timestamp": "03:05:40", "text": "YouTube 和 Twitch，我希望你们……"}, {"type": "subtitle", "time": 11144.23, "timestamp": "03:05:44", "text": "如果W结束，就重新加载W。"}, {"type": "subtitle", "time": 11147.67, "timestamp": "03:05:47", "text": "至于沉睡的溪流，我的意思是……"}, {"type": "subtitle", "time": 11150.95, "timestamp": "03:05:50", "text": "你看到的场景就像……"}, {"type": "subtitle", "time": 11153.19, "timestamp": "03:05:53", "text": "是流媒体，对吧？我的直播。我想"}, {"type": "subtitle", "time": 11155.83, "timestamp": "03:05:55", "text": "也把它做成随机扭蛋之类的东西吧。"}, {"type": "subtitle", "time": 11159.67, "timestamp": "03:05:59", "text": "它会播放一段随机的滑稽剧。"}]
[{"type": "subtitle", "time": 2042.95, "timestamp": "00:34:02", "text": "Twitch，我的直播将暂停一段时间。"}, {"type": "subtitle", "time": 2045.47, "timestamp": "00:34:05", "text": "第二秒，它就会重新开始。"}, {"type": "subtitle", "time": 2048.99, "timestamp": "00:34:08", "text": "又来了，因为现在已经……"}, {"type": "subtitle", "time": 2054.03, "timestamp": "00:34:14", "text": "嗯，现在已经47了。"}, {"type": "subtitle", "time": 2061.75, "timestamp": "00:34:21", "text": "正确的。是的，47小时60分钟。呃"}, {"type": "subtitle", "time": 2064.869, "timestamp": "00:34:24", "text": "时间会过得很快，我"}, {"type": "subtitle", "time": 2067.589, "timestamp": "00:34:27", "text": "根本不会注意到。所以，我就这么做吧"}, {"type": "subtitle", "time": 2094.95, "timestamp": "00:34:54", "text": "忘了。这是断路保护。"}, {"type": "subtitle", "time": 2098.069, "timestamp": "00:34:58", "text": "我都忘了还有这回事了。我的天啊。"}, {"type": "subtitle", "time": 2099.23, "timestamp": "00:34:59", "text": "好的，"}]
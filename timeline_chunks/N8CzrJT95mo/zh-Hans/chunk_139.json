[{"type": "subtitle", "time": 8341.429, "timestamp": "02:19:01", "text": "它。等待。我也应该这样做吗？等待。"}, {"type": "subtitle", "time": 8344.389, "timestamp": "02:19:04", "text": "你想把它撑起来吗？"}, {"type": "subtitle", "time": 8345.91, "timestamp": "02:19:05", "text": "等待。"}, {"type": "subtitle", "time": 8346.34, "timestamp": "02:19:06", "text": "如何"}, {"type": "subtitle", "time": 8348.99, "timestamp": "02:19:08", "text": "[音乐]"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "这有可能吗？好的，放"}, {"type": "subtitle", "time": 8357.509, "timestamp": "02:19:17", "text": "手感火热，蝴蝶翩翩起舞。如何"}, {"type": "subtitle", "time": 8359.509, "timestamp": "02:19:19", "text": "我会进行筛选吗？好的，你们可以"}, {"type": "subtitle", "time": 8362.629, "timestamp": "02:19:22", "text": "截图之类的。发给我们"}, {"type": "subtitle", "time": 8364.19, "timestamp": "02:19:24", "text": "在"}, {"type": "subtitle", "time": 8367.509, "timestamp": "02:19:27", "text": "Discord。耶。然后发布出去。我们会发布"}, {"type": "subtitle", "time": 8379.469, "timestamp": "02:19:39", "text": "是的。上午 16:46"}, {"type": "subtitle", "time": 8390.389, "timestamp": "02:19:50", "text": "天哪，我好累。我不用撞头"}, {"type": "subtitle", "time": 8391.389, "timestamp": "02:19:51", "text": "在"}, {"type": "subtitle", "time": 8397.429, "timestamp": "02:19:57", "text": "墙。哦，不。我的意思是，就像我想喜欢"}]
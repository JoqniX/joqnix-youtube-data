[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "草莓。等等，你喜欢吗？"}, {"type": "subtitle", "time": 7683.589, "timestamp": "02:08:03", "text": "草莓？我喜欢草莓。我确实喜欢"}, {"type": "subtitle", "time": 7685.109, "timestamp": "02:08:05", "text": "草莓。"}, {"type": "subtitle", "time": 7688.87, "timestamp": "02:08:08", "text": "耶。草莓帮。我相信"}, {"type": "subtitle", "time": 7690.55, "timestamp": "02:08:10", "text": "尤其是巧克力涂层的"}, {"type": "subtitle", "time": 7695.51, "timestamp": "02:08:15", "text": "[音乐]"}, {"type": "subtitle", "time": 7697.75, "timestamp": "02:08:17", "text": "巧克力涂层。哦，我还没有。"}, {"type": "subtitle", "time": 7701.91, "timestamp": "02:08:21", "text": "还没有。我只是……嗯，因为我太投入了。"}, {"type": "subtitle", "time": 7705.51, "timestamp": "02:08:25", "text": "把边角弄成草莓状。嗯，是的。"}, {"type": "subtitle", "time": 7707.75, "timestamp": "02:08:27", "text": "因为我太爱草莓了，所以我"}, {"type": "subtitle", "time": 7711.27, "timestamp": "02:08:31", "text": "只买草莓口味的。"}, {"type": "subtitle", "time": 7713.75, "timestamp": "02:08:33", "text": "我不知道。你应该就像那样得到"}, {"type": "subtitle", "time": 7716.31, "timestamp": "02:08:36", "text": "加点Nutella巧克力酱，再放上草莓"}, {"type": "subtitle", "time": 7717.99, "timestamp": "02:08:37", "text": "在其中。"}, {"type": "subtitle", "time": 7720.47, "timestamp": "02:08:40", "text": "谢谢你还记得我。"}, {"type": "subtitle", "time": 7722.709, "timestamp": "02:08:42", "text": "我的冰箱里有Nutella巧克力酱。我要去"}, {"type": "subtitle", "time": 7725.31, "timestamp": "02:08:45", "text": "吃掉它"}, {"type": "subtitle", "time": 7729.189, "timestamp": "02:08:49", "text": "完全。我当时就想，我觉得自己好像……"}, {"type": "subtitle", "time": 7731.43, "timestamp": "02:08:51", "text": "忘记了某件事。那可真是件了不起的事。"}, {"type": "subtitle", "time": 7735.669, "timestamp": "02:08:55", "text": "我习惯了吃东西。我超爱吃。"}, {"type": "subtitle", "time": 7736.83, "timestamp": "02:08:56", "text": "等等，做"}]
[{"type": "subtitle", "time": 9601.19, "timestamp": "02:40:01", "text": "溪流。是的。呃，我简直就是那样。"}, {"type": "subtitle", "time": 9604.469, "timestamp": "02:40:04", "text": "有点像要发烧了，但是"}, {"type": "subtitle", "time": 9606.79, "timestamp": "02:40:06", "text": "我确实吃了药之类的东西。"}, {"type": "subtitle", "time": 9609.19, "timestamp": "02:40:09", "text": "昨天。我休息好了。所以今天的"}, {"type": "subtitle", "time": 9613.349, "timestamp": "02:40:13", "text": "直播的时候我会尽量少做点什么。"}, {"type": "subtitle", "time": 9615.71, "timestamp": "02:40:15", "text": "好的。你好。你好。我们开始吧"}, {"type": "subtitle", "time": 9618.15, "timestamp": "02:40:18", "text": "转变。希望您喜欢新的过渡效果。"}, {"type": "subtitle", "time": 9622.91, "timestamp": "02:40:22", "text": "有。是的。"}, {"type": "subtitle", "time": 9625.63, "timestamp": "02:40:25", "text": "聊天。你看到了吗？"}, {"type": "subtitle", "time": 9646.349, "timestamp": "02:40:46", "text": "你好。哦，等等。什么是"}, {"type": "subtitle", "time": 9650.03, "timestamp": "02:40:50", "text": "这？箭头指向"}, {"type": "subtitle", "time": 9652.03, "timestamp": "02:40:52", "text": "你的"}, {"type": "subtitle", "time": 9656.15, "timestamp": "02:40:56", "text": "叔叔。使用。哦，你好凯蒂猫。三层"}]
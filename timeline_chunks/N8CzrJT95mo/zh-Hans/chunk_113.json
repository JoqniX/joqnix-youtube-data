[{"type": "subtitle", "time": 6780.55, "timestamp": "01:53:00", "text": "什么都听不懂。是的。是的。"}, {"type": "subtitle", "time": 6783.91, "timestamp": "01:53:03", "text": "呃，我把它像这样压平。把你的"}, {"type": "subtitle", "time": 6786.709, "timestamp": "01:53:06", "text": "中指像这样伸进去。做"}, {"type": "subtitle", "time": 6788.79, "timestamp": "01:53:08", "text": "用手将中间部分向内拉。"}, {"type": "subtitle", "time": 6799.589, "timestamp": "01:53:19", "text": "是的。是的。是的。是的。你正在获得"}, {"type": "subtitle", "time": 6802.709, "timestamp": "01:53:22", "text": "它。你明白了。是的。是的。抓住"}, {"type": "subtitle", "time": 6804.91, "timestamp": "01:53:24", "text": "两者兼备"}, {"type": "subtitle", "time": 6807.109, "timestamp": "01:53:27", "text": "双方。是的。是的。是的。答对了。"}, {"type": "subtitle", "time": 6809.99, "timestamp": "01:53:29", "text": "是的。是的。呃，把它连接起来。是的。"}, {"type": "subtitle", "time": 6813.109, "timestamp": "01:53:33", "text": "是的。是的。是的。是的。是的。好的。做"}, {"type": "subtitle", "time": 6815.229, "timestamp": "01:53:35", "text": "其他情况也一样"}, {"type": "subtitle", "time": 6817.669, "timestamp": "01:53:37", "text": "边。那意味着它将成为"}, {"type": "subtitle", "time": 6821.189, "timestamp": "01:53:41", "text": "像直角一样。"}, {"type": "subtitle", "time": 6828.149, "timestamp": "01:53:48", "text": "解释。最后，你需要"}, {"type": "subtitle", "time": 6830.83, "timestamp": "01:53:50", "text": "做类似的东西"}, {"type": "subtitle", "time": 6833.83, "timestamp": "01:53:53", "text": "这。直角。是的。是的。你是"}, {"type": "subtitle", "time": 6835.27, "timestamp": "01:53:55", "text": "明白了。你明白了。你得到了"}, {"type": "subtitle", "time": 6838.35, "timestamp": "01:53:58", "text": "一边。另一面"}]
[{"type": "subtitle", "time": 8943.87, "timestamp": "02:29:03", "text": "直播效果不错，我当时正在用手机"}, {"type": "subtitle", "time": 8946.79, "timestamp": "02:29:06", "text": "我当时用的是手机摄像头。"}, {"type": "subtitle", "time": 8949.19, "timestamp": "02:29:09", "text": "如果它很好，就不要说了。我认为它正在使用"}, {"type": "subtitle", "time": 8952.27, "timestamp": "02:29:12", "text": "后置摄像头，2倍变焦"}, {"type": "subtitle", "time": 8955.99, "timestamp": "02:29:15", "text": "一。不，不，是外置摄像头。"}, {"type": "subtitle", "time": 8961.19, "timestamp": "02:29:21", "text": "我猜是远处的摄像头。呃，但是"}, {"type": "subtitle", "time": 8969.429, "timestamp": "02:29:29", "text": "你好。你好。那么，我就简单总结一下吧。"}, {"type": "subtitle", "time": 8972.309, "timestamp": "02:29:32", "text": "这里。所以，谢谢大家。而且我"}, {"type": "subtitle", "time": 8975.51, "timestamp": "02:29:35", "text": "真的很想向那些人道歉。"}, {"type": "subtitle", "time": 8978.469, "timestamp": "02:29:38", "text": "今天和我聊天的人，我都没聊。"}, {"type": "subtitle", "time": 8980.469, "timestamp": "02:29:40", "text": "我看了你的聊天记录，但我确实注意到了。"}, {"type": "subtitle", "time": 8983.75, "timestamp": "02:29:43", "text": "尽管。谢谢你今天抽出时间。那是"}, {"type": "subtitle", "time": 8991.67, "timestamp": "02:29:51", "text": "乐趣。是的。而且我能感觉到自己"}, {"type": "subtitle", "time": 8992.67, "timestamp": "02:29:52", "text": "获得"}, {"type": "subtitle", "time": 8995.75, "timestamp": "02:29:55", "text": "脱水。我需要喝水。做"}, {"type": "subtitle", "time": 8998.309, "timestamp": "02:29:58", "text": "你知道这是我的水壶吗？太过了"}]
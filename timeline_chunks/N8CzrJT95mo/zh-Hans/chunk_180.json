[{"type": "subtitle", "time": 10810.23, "timestamp": "03:00:10", "text": "或许可以稍微探讨一下这个话题"}, {"type": "subtitle", "time": 10813.269, "timestamp": "03:00:13", "text": "为他人感到难过吗？是的。期待着"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "今天只有我一个工作人员。"}, {"type": "subtitle", "time": 10831.67, "timestamp": "03:00:31", "text": "我会在一号房间整理东西。所以如果"}, {"type": "subtitle", "time": 10834.15, "timestamp": "03:00:34", "text": "有没有人想加入工作人员队伍？"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "各位成员请到一号房间。呃，有人吗？"}, {"type": "subtitle", "time": 10843.91, "timestamp": "03:00:43", "text": "有人要参加吗？"}, {"type": "subtitle", "time": 10844.67, "timestamp": "03:00:44", "text": "第一的"}, {"type": "subtitle", "time": 10859.269, "timestamp": "03:00:59", "text": "正确的。好的。让我们进入房间模式。"}]
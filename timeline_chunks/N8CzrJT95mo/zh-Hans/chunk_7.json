[{"type": "subtitle", "time": 420.23, "timestamp": "00:07:00", "text": "亡灵的尊贵皮肤。最后"}, {"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "Ravi Chan拥有高级肌肤。我感到自豪"}, {"type": "subtitle", "time": 425.39, "timestamp": "00:07:05", "text": "的"}, {"type": "subtitle", "time": 428.029, "timestamp": "00:07:08", "text": "他。"}, {"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "所以，而且你知道，今天是"}, {"type": "subtitle", "time": 433.07, "timestamp": "00:07:13", "text": "10月18日是……的周年纪念日"}, {"type": "subtitle", "time": 438.27, "timestamp": "00:07:18", "text": "卡凡。我的天啊。我的天啊。今天的"}, {"type": "subtitle", "time": 442.469, "timestamp": "00:07:22", "text": "咖啡。我的天啊。离开。我太……"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "总之，我的嗓子快不行了。"}, {"type": "subtitle", "time": 467.909, "timestamp": "00:07:47", "text": "好了，我们开始游戏吧。我做了"}, {"type": "subtitle", "time": 472.43, "timestamp": "00:07:52", "text": "我还没打开。什么？你好，"}, {"type": "subtitle", "time": 476.30899999999997, "timestamp": "00:07:56", "text": "娜妮。卡尼。我的天啊。让我们进入正题"}, {"type": "subtitle", "time": 478.749, "timestamp": "00:07:58", "text": "游戏。也应该开始进食了"}]
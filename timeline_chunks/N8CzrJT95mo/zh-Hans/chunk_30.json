[{"type": "subtitle", "time": 1805.23, "timestamp": "00:30:05", "text": "[音乐]"}, {"type": "subtitle", "time": 1808.549, "timestamp": "00:30:08", "text": "D：好了，晚饭吃完了。所以，我是"}, {"type": "subtitle", "time": 1810.95, "timestamp": "00:30:10", "text": "我这就截个图。"}, {"type": "subtitle", "time": 1814.87, "timestamp": "00:30:14", "text": "那天晚上，我跟Willy Willy聊天。"}, {"type": "subtitle", "time": 1816.389, "timestamp": "00:30:16", "text": "正在研究那件事。现在，那里"}, {"type": "subtitle", "time": 1819.35, "timestamp": "00:30:19", "text": "当时有很多聊天记录，对吧？我这就去"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "截个图，我这就设置好。"}, {"type": "subtitle", "time": 1824.43, "timestamp": "00:30:24", "text": "在那之后"}, {"type": "subtitle", "time": 1828.909, "timestamp": "00:30:28", "text": "我会，我们会唱歌"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "正确的。你晚饭吃了什么？呃"}, {"type": "subtitle", "time": 1855.73, "timestamp": "00:30:55", "text": "鱼"}, {"type": "subtitle", "time": 1857.95, "timestamp": "00:30:57", "text": "[音乐]"}]
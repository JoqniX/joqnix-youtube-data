[{"type": "subtitle", "time": 3963.51, "timestamp": "01:06:03", "text": "星星。把它放进去。把它放进去。"}, {"type": "subtitle", "time": 3967.99, "timestamp": "01:06:07", "text": "分配轨道颜色并确定向下"}, {"type": "subtitle", "time": 3970.91, "timestamp": "01:06:10", "text": "接下来还有三个"}, {"type": "subtitle", "time": 3973.87, "timestamp": "01:06:13", "text": "不，这是"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "那是一种乐器，那是一个完整的"}, {"type": "subtitle", "time": 3978.349, "timestamp": "01:06:18", "text": "所以我不得不把它放进歌里"}, {"type": "subtitle", "time": 3992.87, "timestamp": "01:06:32", "text": "一个，对，就是这个，这个，这个，嗯。"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "你会在这里。好的，我们有一个"}, {"type": "subtitle", "time": 3998.829, "timestamp": "01:06:38", "text": "问题。为什么太"}, {"type": "subtitle", "time": 4001.109, "timestamp": "01:06:41", "text": "短的？好吧，选错了。它是"}, {"type": "subtitle", "time": 4003.43, "timestamp": "01:06:43", "text": "错了。没关系。这个。是"}, {"type": "subtitle", "time": 4005.71, "timestamp": "01:06:45", "text": "是你吗？"}, {"type": "subtitle", "time": 4010.43, "timestamp": "01:06:50", "text": "是的。你好。所以，这两个选择外部"}, {"type": "subtitle", "time": 4015.789, "timestamp": "01:06:55", "text": "出去。最后一个会传到我的音箱上。 3"}]
[{"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "等等，等等，等等，等等，等等。在哪里？"}, {"type": "subtitle", "time": 3913.63, "timestamp": "01:05:13", "text": "星星？"}, {"type": "subtitle", "time": 3916.789, "timestamp": "01:05:16", "text": "等待。橙色星星在哪里？等待。橙子"}, {"type": "subtitle", "time": 3919.549, "timestamp": "01:05:19", "text": "星星。爱丽丝。哦，爱丽丝。"}, {"type": "subtitle", "time": 3924.349, "timestamp": "01:05:24", "text": "好的。这个。好的。所以，这将是"}, {"type": "subtitle", "time": 3928.589, "timestamp": "01:05:28", "text": "发送双击同时和外部"}, {"type": "subtitle", "time": 3931.51, "timestamp": "01:05:31", "text": "出去。第一首伴奏曲将发送"}, {"type": "subtitle", "time": 3934.549, "timestamp": "01:05:34", "text": "到 OBS，然后就轮到我了。所以"}, {"type": "subtitle", "time": 3936.51, "timestamp": "01:05:36", "text": "你会听到类似这样的话"}, {"type": "subtitle", "time": 3939.069, "timestamp": "01:05:39", "text": "这。正确的。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "正确的。好的。应该可以正常运行了。"}, {"type": "subtitle", "time": 3944.109, "timestamp": "01:05:44", "text": "那是"}, {"type": "subtitle", "time": 3950.91, "timestamp": "01:05:50", "text": "它。我要走了"}, {"type": "subtitle", "time": 3954.109, "timestamp": "01:05:54", "text": "放置"}, {"type": "subtitle", "time": 3956.589, "timestamp": "01:05:56", "text": "结束"}, {"type": "subtitle", "time": 3958.99, "timestamp": "01:05:58", "text": "这里。橙子"}]
[{"type": "subtitle", "time": 9540.79, "timestamp": "02:39:00", "text": "你好。说到VR聊天，呃，我确实聊过。"}, {"type": "subtitle", "time": 9546.67, "timestamp": "02:39:06", "text": "我确实做了一些事情。我确实做了一些"}, {"type": "subtitle", "time": 9551.07, "timestamp": "02:39:11", "text": "东西，我其实还做了另一个"}, {"type": "subtitle", "time": 9555.03, "timestamp": "02:39:15", "text": "呃，我在这方面真是费了九牛二虎之力。我做了"}, {"type": "subtitle", "time": 9556.59, "timestamp": "02:39:16", "text": "又一个嘘声"}, {"type": "subtitle", "time": 9559.55, "timestamp": "02:39:19", "text": "嘘。我其实又做了一个嘘"}, {"type": "subtitle", "time": 9563.59, "timestamp": "02:39:23", "text": "嘘。实际上是通过聊天高级会员购买的"}, {"type": "subtitle", "time": 9567.429, "timestamp": "02:39:27", "text": "希望我能多一个最喜欢的"}, {"type": "subtitle", "time": 9570.95, "timestamp": "02:39:30", "text": "好友名额，结果被骗了。我"}, {"type": "subtitle", "time": 9574.15, "timestamp": "02:39:34", "text": "没有获得额外的好友名额。这"}, {"type": "subtitle", "time": 9576.11, "timestamp": "02:39:36", "text": "最大值是"}, {"type": "subtitle", "time": 9580.389, "timestamp": "02:39:40", "text": "三个，这让我内心彻底崩溃了。我是"}, {"type": "subtitle", "time": 9590.79, "timestamp": "02:39:50", "text": "上帝。正如你所看到的，我并不"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "你能不能从我的声音里认出我来？"}, {"type": "subtitle", "time": 9597.15, "timestamp": "02:39:57", "text": "呃，我上次喉咙痛。"}]
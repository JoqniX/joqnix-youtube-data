[{"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "给我爸爸一些恋爱建议。哦，但是"}, {"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "我当时紧张极了。我没有"}, {"type": "subtitle", "time": 7211.83, "timestamp": "02:00:11", "text": "你本可以拥有"}, {"type": "subtitle", "time": 7216.149, "timestamp": "02:00:16", "text": "正如我所展示的，两个角都是如此。"}, {"type": "subtitle", "time": 7218.709, "timestamp": "02:00:18", "text": "所以，我改用了一个 Undertale 的字符串。"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "天。"}, {"type": "subtitle", "time": 7223.189, "timestamp": "02:00:23", "text": "啊，《传说之下》。我有。你做到了"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "如果我"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "记住。真的很好。你应该"}, {"type": "subtitle", "time": 7230.75, "timestamp": "02:00:30", "text": "播放它。它很漂亮"}, {"type": "subtitle", "time": 7238.229, "timestamp": "02:00:38", "text": "乔克，你……你……你在哪儿？"}, {"type": "subtitle", "time": 7241.91, "timestamp": "02:00:41", "text": "现在直播吗？在直播中问这个问题可以吗？"}, {"type": "subtitle", "time": 7245.109, "timestamp": "02:00:45", "text": "我住在自己的房子里。不用担心。我 我"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "搬出了我刚才说的那个地方。"}, {"type": "subtitle", "time": 7252.47, "timestamp": "02:00:52", "text": "暂时地。是的。是的。这将是我的"}, {"type": "subtitle", "time": 7255.109, "timestamp": "02:00:55", "text": "直播间。这就是为什么我有一个大"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "桌子和东西。"}]
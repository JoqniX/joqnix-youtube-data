[{"type": "subtitle", "time": 2522.71, "timestamp": "00:42:02", "text": "纯音乐。呃，你今天过得怎么样？"}, {"type": "subtitle", "time": 2523.95, "timestamp": "00:42:03", "text": "你好，"}, {"type": "subtitle", "time": 2554.39, "timestamp": "00:42:34", "text": "公斤。好了，完成了。以及全部"}, {"type": "subtitle", "time": 2556.67, "timestamp": "00:42:36", "text": "歌曲将是"}, {"type": "subtitle", "time": 2560.27, "timestamp": "00:42:40", "text": "这个，我们来聊聊这个。"}, {"type": "subtitle", "time": 2564.63, "timestamp": "00:42:44", "text": "现在。你是印度人，叫我艾伦。好的。"}, {"type": "subtitle", "time": 2569.109, "timestamp": "00:42:49", "text": "呃，问题是你的用户名在……"}, {"type": "subtitle", "time": 2572.71, "timestamp": "00:42:52", "text": "中国人不会，所以对我来说会很困难。"}, {"type": "subtitle", "time": 2576.99, "timestamp": "00:42:56", "text": "但我会尽力而为"}, {"type": "subtitle", "time": 2579.71, "timestamp": "00:42:59", "text": "记住。我会试试我的"}]
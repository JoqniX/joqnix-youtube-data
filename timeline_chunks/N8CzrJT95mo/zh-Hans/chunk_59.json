[{"type": "subtitle", "time": 3541.03, "timestamp": "00:59:01", "text": "歌声。哦，我只是说说而已。"}, {"type": "subtitle", "time": 3543.51, "timestamp": "00:59:03", "text": "试着唱歌。我们将要唱歌"}, {"type": "subtitle", "time": 3547.47, "timestamp": "00:59:07", "text": "一点。我正在努力……我正在努力"}, {"type": "subtitle", "time": 3552.03, "timestamp": "00:59:12", "text": "嗯，我正在尝试"}, {"type": "subtitle", "time": 3556.43, "timestamp": "00:59:16", "text": "嗯，我正试图把这个放在这里。做"}, {"type": "subtitle", "time": 3560.75, "timestamp": "00:59:20", "text": "我唱歌不好听。我不擅长"}, {"type": "subtitle", "time": 3564.36, "timestamp": "00:59:24", "text": "唱歌，但我很想学唱歌。"}, {"type": "subtitle", "time": 3580.15, "timestamp": "00:59:40", "text": "[音乐]"}, {"type": "subtitle", "time": 3599.36, "timestamp": "00:59:59", "text": "将会有"}]
[{"type": "subtitle", "time": 9901.23, "timestamp": "02:45:01", "text": "好的，这是唯一的"}, {"type": "subtitle", "time": 9904.95, "timestamp": "02:45:04", "text": "是东西吗？有票。啊，你"}, {"type": "subtitle", "time": 9906.75, "timestamp": "02:45:06", "text": "不必付钱"}, {"type": "subtitle", "time": 9909.91, "timestamp": "02:45:09", "text": "自由的。我们是追逐者游戏智能手机"}, {"type": "subtitle", "time": 9912.51, "timestamp": "02:45:12", "text": "这一切都与智能手机有关。"}, {"type": "subtitle", "time": 9914.36, "timestamp": "02:45:14", "text": "呃，我必须"}, {"type": "subtitle", "time": 9916.11, "timestamp": "02:45:16", "text": "[音乐]"}, {"type": "subtitle", "time": 9920.63, "timestamp": "02:45:20", "text": "支付。您可以尽情享受，而我们所有人都……"}, {"type": "subtitle", "time": 9923.03, "timestamp": "02:45:23", "text": "您可以欣赏艺术家的表演"}, {"type": "subtitle", "time": 9926.79, "timestamp": "02:45:26", "text": "持有门票，而其他所有内容均为"}, {"type": "subtitle", "time": 9928.269, "timestamp": "02:45:28", "text": "可供"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "自由的。哦好的。好的。等等，我想我"}, {"type": "subtitle", "time": 9934.51, "timestamp": "02:45:34", "text": "可以证明这一点。嗯，显然"}, {"type": "subtitle", "time": 9937.15, "timestamp": "02:45:37", "text": "嗯，去"}, {"type": "subtitle", "time": 9940.71, "timestamp": "02:45:40", "text": "显然你可以等这个洞……"}, {"type": "subtitle", "time": 9942.83, "timestamp": "02:45:42", "text": "这边。等待，"}, {"type": "subtitle", "time": 9952.389, "timestamp": "02:45:52", "text": "什么？啊，你能看到这个吗？呃，五月"}, {"type": "subtitle", "time": 9959.81, "timestamp": "02:45:59", "text": "什么？我认出其中一些。"}]
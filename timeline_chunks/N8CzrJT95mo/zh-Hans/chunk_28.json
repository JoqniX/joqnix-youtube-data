[{"type": "subtitle", "time": 1685.83, "timestamp": "00:28:05", "text": "好的。我回来了，之前……"}, {"type": "subtitle", "time": 1688.87, "timestamp": "00:28:08", "text": "呃，为什么我还觉得饿？"}, {"type": "subtitle", "time": 1696.19, "timestamp": "00:28:16", "text": "饥饿的。我是一个饥饿的男孩"}, {"type": "subtitle", "time": 1699.07, "timestamp": "00:28:19", "text": "现在。"}, {"type": "subtitle", "time": 1718.07, "timestamp": "00:28:38", "text": "[音乐]"}]
[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "明天我还有音乐课。"}, {"type": "subtitle", "time": 2344.069, "timestamp": "00:39:04", "text": "明天我要参加一个会议。"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "为了与日本的合作。我有VC。"}, {"type": "subtitle", "time": 2348.829, "timestamp": "00:39:08", "text": "会议"}, {"type": "subtitle", "time": 2351.27, "timestamp": "00:39:11", "text": "明天。哦，我希望我能做得好。我"}, {"type": "subtitle", "time": 2353.19, "timestamp": "00:39:13", "text": "我甚至都没练习过日语。圣"}, {"type": "subtitle", "time": 2355.23, "timestamp": "00:39:15", "text": "上帝啊，我该如何说话？"}, {"type": "subtitle", "time": 2358.23, "timestamp": "00:39:18", "text": "明天？我会很挣扎"}, {"type": "subtitle", "time": 2359.31, "timestamp": "00:39:19", "text": "难的，"}, {"type": "subtitle", "time": 2361.91, "timestamp": "00:39:21", "text": "男人。但是，明天我不应该"}, {"type": "subtitle", "time": 2364.349, "timestamp": "00:39:24", "text": "感觉精疲力竭，"}, {"type": "subtitle", "time": 2371.43, "timestamp": "00:39:31", "text": "印象。明天我们将坐下来……"}, {"type": "subtitle", "time": 2373.67, "timestamp": "00:39:33", "text": "和他们谈谈。我会把"}, {"type": "subtitle", "time": 2376.63, "timestamp": "00:39:36", "text": "病房里的溪流。我知道我有课。"}, {"type": "subtitle", "time": 2380.109, "timestamp": "00:39:40", "text": "之后是5点30分之后。"}, {"type": "subtitle", "time": 2382.829, "timestamp": "00:39:42", "text": "和"}, {"type": "subtitle", "time": 2385.27, "timestamp": "00:39:45", "text": "是的，我们就给吧，我就给吧"}, {"type": "subtitle", "time": 2388.67, "timestamp": "00:39:48", "text": "这是我尽力了。"}]
[{"type": "subtitle", "time": 6962.27, "timestamp": "01:56:02", "text": "[音乐]"}, {"type": "subtitle", "time": 6965.709, "timestamp": "01:56:05", "text": "是的。你的折纸作品怎么样？"}, {"type": "subtitle", "time": 6974.47, "timestamp": "01:56:14", "text": "我头疼。我哭了。我"}, {"type": "subtitle", "time": 6980.709, "timestamp": "01:56:20", "text": "哦，那是我们本来打算做的，对吧？"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "我们必须把它切断，用……"}, {"type": "subtitle", "time": 6993.31, "timestamp": "01:56:33", "text": "然后有人说这很容易。"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "简单的。好了，时间不早了。我也很累。"}, {"type": "subtitle", "time": 7006.39, "timestamp": "01:56:46", "text": "我们俩都很累。我当时上课"}, {"type": "subtitle", "time": 7010.47, "timestamp": "01:56:50", "text": "今天我不得不匆匆赶回来。"}, {"type": "subtitle", "time": 7017.75, "timestamp": "01:56:57", "text": "一切都关乎乐趣和"}]
[{"type": "subtitle", "time": 2701.55, "timestamp": "00:45:01", "text": "惩罚。我患有九种疾病。"}, {"type": "subtitle", "time": 2703.67, "timestamp": "00:45:03", "text": "处罚。我的天啊。天哪，我好痛苦"}, {"type": "subtitle", "time": 2705.069, "timestamp": "00:45:05", "text": "九"}, {"type": "subtitle", "time": 2711.47, "timestamp": "00:45:11", "text": "我。但"}, {"type": "subtitle", "time": 2714.91, "timestamp": "00:45:14", "text": "是的，但这是我第一次做这件事。"}, {"type": "subtitle", "time": 2719.309, "timestamp": "00:45:19", "text": "类别：虚拟日期每日"}, {"type": "subtitle", "time": 2723.95, "timestamp": "00:45:23", "text": "呃，类别。所以我希望我不会"}, {"type": "subtitle", "time": 2725.79, "timestamp": "00:45:25", "text": "得到"}, {"type": "subtitle", "time": 2728.349, "timestamp": "00:45:28", "text": "受到惩罚"}, {"type": "subtitle", "time": 2730.589, "timestamp": "00:45:30", "text": "呃，我"}, {"type": "subtitle", "time": 2733.109, "timestamp": "00:45:33", "text": "意思是这是我的荣幸。是的，就是这样。"}, {"type": "subtitle", "time": 2736.15, "timestamp": "00:45:36", "text": "很高兴见到你。我的"}, {"type": "subtitle", "time": 2738.39, "timestamp": "00:45:38", "text": "语言表达不好。没关系。你可以"}, {"type": "subtitle", "time": 2742.27, "timestamp": "00:45:42", "text": "输入“呃”，你可以“呃”，写在……"}, {"type": "subtitle", "time": 2752.27, "timestamp": "00:45:52", "text": "担心。"}, {"type": "subtitle", "time": 2755.75, "timestamp": "00:45:55", "text": "嗯……我刚才在干什么？好吧，就是这个人。不，"}]
[{"type": "subtitle", "time": 7261.27, "timestamp": "02:01:01", "text": "但可惜的是，他们却全身心投入。"}, {"type": "subtitle", "time": 7264.709, "timestamp": "02:01:04", "text": "是的，我可以这么说。你需要"}, {"type": "subtitle", "time": 7268.229, "timestamp": "02:01:08", "text": "直播之外请带我参观一下房间。男人，"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "我至今仍记得乔克曾经意外地……"}, {"type": "subtitle", "time": 7273.589, "timestamp": "02:01:13", "text": "给我打电话并带我参观了房间。"}, {"type": "subtitle", "time": 7277.35, "timestamp": "02:01:17", "text": "我甚至都没要求。哦，是的。"}, {"type": "subtitle", "time": 7280.95, "timestamp": "02:01:20", "text": "很久以前吧？我的天啊。"}, {"type": "subtitle", "time": 7284.95, "timestamp": "02:01:24", "text": "他刚睡醒。"}, {"type": "subtitle", "time": 7302.669, "timestamp": "02:01:42", "text": "是的。我应该带大家参观一下这里。"}, {"type": "subtitle", "time": 7305.91, "timestamp": "02:01:45", "text": "页。到目前为止，还没有人渲染过这个呃"}, {"type": "subtitle", "time": 7310.07, "timestamp": "02:01:50", "text": "另一个房间。嗯，是的。呃"}, {"type": "subtitle", "time": 7312.91, "timestamp": "02:01:52", "text": "顶部区域得到了"}, {"type": "subtitle", "time": 7315.35, "timestamp": "02:01:55", "text": "已翻新。是的，我们正在寻找"}, {"type": "subtitle", "time": 7318.91, "timestamp": "02:01:58", "text": "新的人将来接管办公室"}]
[{"type": "subtitle", "time": 21843.35, "timestamp": "06:04:03", "text": "它該"}, {"type": "subtitle", "time": 21850.868, "timestamp": "06:04:10", "text": "如何實現，你知道，如何讓它持續下去之類的，我不知道，播放清單的問題就在於"}, {"type": "subtitle", "time": 21856.708, "timestamp": "06:04:16", "text": "如何一個一個地創建播放清單。或許我會做一套30首歌"}, {"type": "subtitle", "time": 21859.67, "timestamp": "06:04:19", "text": "或20首[音樂]。我也"}, {"type": "subtitle", "time": 21873.628, "timestamp": "06:04:33", "text": "想問別人這件事"}]
[{"type": "subtitle", "time": 27551.788, "timestamp": "07:39:11", "text": "，有人打電話來了。我得走了。嗨，BB"}, {"type": "subtitle", "time": 27556.11, "timestamp": "07:39:16", "text": "的伙計們"}, {"type": "subtitle", "time": 27564.15, "timestamp": "07:39:24", "text": "。我一會兒就回來。虛空"}, {"type": "subtitle", "time": 27580.868, "timestamp": "07:39:40", "text": "？我的天"}, {"type": "subtitle", "time": 27589.31, "timestamp": "07:39:49", "text": "，我做不到。是啊，我被打得落花流水。沒關係。我不會倒下，我不會放棄。我會繼續盡力。是啊。擊殺。爆頭。他在哪裡？他在哪裡？他在"}, {"type": "subtitle", "time": 27598.03, "timestamp": "07:39:58", "text": "哪裡"}]
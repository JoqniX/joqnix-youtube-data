[{"type": "subtitle", "time": 11003.83, "timestamp": "03:03:23", "text": "哇。然後我就做了那個吸水煙筒的事。太酷了。  然後是星期一。我還加了"}, {"type": "subtitle", "time": 11007.67, "timestamp": "03:03:27", "text": "瞌睡騎師、熱狗和好吃的那個"}, {"type": "subtitle", "time": 11032.23, "timestamp": "03:03:52", "text": "人民。  好的。"}, {"type": "subtitle", "time": 11038.19, "timestamp": "03:03:58", "text": "午安.等待。晚安.週日快樂。"}]
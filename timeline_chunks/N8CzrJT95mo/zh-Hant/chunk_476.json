[{"type": "subtitle", "time": 28565.67, "timestamp": "07:56:05", "text": "。你沒聽到嗎？等等，等等，等等，等等，等等。他在上面嗎"}, {"type": "subtitle", "time": 28601.75, "timestamp": "07:56:41", "text": "。我聽到有人在走路。"}, {"type": "subtitle", "time": 28609.15, "timestamp": "07:56:49", "text": "嘿，你聽到了嗎？誰在敲門？為什麼這個遊戲這麼恐怖？我應該……是"}, {"type": "subtitle", "time": 28618.35, "timestamp": "07:56:58", "text": "誰在幹這個？等等，打開這個。誰？嗯？誰？我好害怕。我的天哪。"}]
[{"type": "subtitle", "time": 30486.07, "timestamp": "08:28:06", "text": "你們就在那邊等著"}, {"type": "subtitle", "time": 30487.99, "timestamp": "08:28:07", "text": "。哦，回來吧。回來。回來。回來。我真的非常抱歉。  我回來了。"}, {"type": "subtitle", "time": 30506.468, "timestamp": "08:28:26", "text": "你好。"}, {"type": "subtitle", "time": 30537.91, "timestamp": "08:28:57", "text": "嗯，我喝了"}]
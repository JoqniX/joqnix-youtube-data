[{"type": "subtitle", "time": 28743.35, "timestamp": "07:59:03", "text": "我看不懂子彈的意思"}, {"type": "subtitle", "time": 28753.43, "timestamp": "07:59:13", "text": "。它來自哪裡？我看見你"}, {"type": "subtitle", "time": 28756.948, "timestamp": "07:59:16", "text": "。我看見你。  我到底有沒有爆頭你？好的，已收到。"}, {"type": "subtitle", "time": 28759.83, "timestamp": "07:59:19", "text": "感謝您在Twitch上的關注。謝謝。  等等，腳步聲、"}, {"type": "subtitle", "time": 28776.788, "timestamp": "07:59:36", "text": "敲門聲又來了。好的，等等。呃，粉紅色。呃，我現在需要那個嗎？呃，不。沒關係。甜美的鈴鐺，對吧？我接受。你知道嗎？"}, {"type": "subtitle", "time": 28782.788, "timestamp": "07:59:42", "text": "你剩下的時間都由我來承擔。謝謝。因為我不需要9。我說得對。我需要一把45 ACP口徑的槍。我不需要那個。哦，我聽到了。"}, {"type": "subtitle", "time": 28792.35, "timestamp": "07:59:52", "text": "你聽到啦啦隊"}, {"type": "subtitle", "time": 28795.43, "timestamp": "07:59:55", "text": "彩球聲了"}]
[{"type": "subtitle", "time": 18201.83, "timestamp": "05:03:21", "text": "Youtube.好的，我回來了。我們必須找到其他方法。"}, {"type": "subtitle", "time": 18203.948, "timestamp": "05:03:23", "text": "所以，我們不能使用頻道上傳"}, {"type": "subtitle", "time": 18222.708, "timestamp": "05:03:42", "text": "播放列表，因為 YouTube 嵌入的頻道上傳播放清單有 200 個播放清單的限制。所以我們"}, {"type": "subtitle", "time": 18225.948, "timestamp": "05:03:45", "text": "不能使用它。所以，我還沒有…所以我們能做的就是創建一個以逗號分隔的"}, {"type": "subtitle", "time": 18232.03, "timestamp": "05:03:52", "text": "影片"}, {"type": "subtitle", "time": 18235.11, "timestamp": "05:03:55", "text": "清單。所以那意思就是「我的天哪」。我該怎麼做呢？我該怎麼做呢？好的。"}]
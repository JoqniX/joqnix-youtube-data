[{"type": "subtitle", "time": 12.43, "timestamp": "00:00:12", "text": "直播了。大家好，歡迎來到 Jakathon 第"}, {"type": "subtitle", "time": 15.829, "timestamp": "00:00:15", "text": "43 天第二部分直播，即夜間直播。"}, {"type": "subtitle", "time": 17.79, "timestamp": "00:00:17", "text": "歡迎"}, {"type": "subtitle", "time": 20.67, "timestamp": "00:00:20", "text": "D。那麼，我們會到"}, {"type": "subtitle", "time": 22.91, "timestamp": "00:00:22", "text": "那裡，會有……"}, {"type": "subtitle", "time": 25.23, "timestamp": "00:00:25", "text": "嗯，該怎麼稱呼"}, {"type": "subtitle", "time": 27.99, "timestamp": "00:00:27", "text": "它呢？夜間直播。我們要嘛拍些"}, {"type": "subtitle", "time": 30.63, "timestamp": "00:00:30", "text": "短片之類的，要嘛吃完晚餐"}, {"type": "subtitle", "time": 33.35, "timestamp": "00:00:33", "text": "後就去唱什麼的"}, {"type": "subtitle", "time": 35.83, "timestamp": "00:00:35", "text": "。我還沒吃晚餐。我知道現在"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "是上午 11 點，晚上 11 點。"}, {"type": "subtitle", "time": 41.549, "timestamp": "00:00:41", "text": "外面正在下雨。我從外面"}, {"type": "subtitle", "time": 44.31, "timestamp": "00:00:44", "text": "進屋的時候一定會全身濕透"}, {"type": "subtitle", "time": 48.95, "timestamp": "00:00:48", "text": "。啊，不過沒關係。"}, {"type": "subtitle", "time": 52.15, "timestamp": "00:00:52", "text": "我想我還是帶把傘上去吧。"}, {"type": "subtitle", "time": 55.11, "timestamp": "00:00:55", "text": "好的。所以，好的，我會把你們的帳號加到V裡。請"}, {"type": "subtitle", "time": 57.59, "timestamp": "00:00:57", "text": "欣賞點播影片。我會回來的。好的。"}, {"type": "subtitle", "time": 59.029, "timestamp": "00:00:59", "text": "對於那些在 Billy Billy 上觀看的觀眾"}]
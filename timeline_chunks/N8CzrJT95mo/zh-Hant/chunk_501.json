[{"type": "subtitle", "time": 30071.23, "timestamp": "08:21:11", "text": "如何？什麼？決不。  什麼？是的。"}, {"type": "subtitle", "time": 30081.91, "timestamp": "08:21:21", "text": "你不是說你有了新妻子嗎？我有一個，或者嗯？"}, {"type": "subtitle", "time": 30083.948, "timestamp": "08:21:23", "text": "我自己都不了解"}, {"type": "subtitle", "time": 30085.05, "timestamp": "08:21:25", "text": "自己。我有一個。  沃塔什·博誇和我在一起。主題。你說的就是我，對吧？  就像咪咪一樣。我？嗯？你覺得"}, {"type": "subtitle", "time": 30104.548, "timestamp": "08:21:44", "text": "我有"}, {"type": "subtitle", "time": 30107.23, "timestamp": "08:21:47", "text": "時間做這件事嗎？你覺得我有時間做這件事嗎？  我有一個無需你也能實現的夢想。我有一個夢想。你有一個夢想。我有一個夢想。 D：所以我不能，但我確實"}]
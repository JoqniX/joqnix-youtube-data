[{"type": "subtitle", "time": 7577.35, "timestamp": "02:06:17", "text": "我改做了一個 Undertale 的串燒。"}, {"type": "subtitle", "time": 7580.55, "timestamp": "02:06:20", "text": "啊，《傳說之下》。"}, {"type": "subtitle", "time": 7582.629, "timestamp": "02:06:22", "text": "我有。我記得你曾經推薦我玩《傳說之下》（Undertale）。真的很好。你應該"}, {"type": "subtitle", "time": 7586.87, "timestamp": "02:06:26", "text": "玩玩。價格很便宜。嗯。  喬克，呃，你"}, {"type": "subtitle", "time": 7589.91, "timestamp": "02:06:29", "text": "知道你現在住在哪裡嗎？在直播中問這個問題可以嗎？  我住在自己"}, {"type": "subtitle", "time": 7594.229, "timestamp": "02:06:34", "text": "的房子裡。不用擔心。我暫時搬出了我剛才說的那個地方。是的。是的。這將會是我的直播間。這就是為什麼我"}, {"type": "subtitle", "time": 7619.75, "timestamp": "02:06:59", "text": "買了張大桌子之類的東西。"}]
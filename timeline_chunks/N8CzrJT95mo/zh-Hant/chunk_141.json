[{"type": "subtitle", "time": 8465.95, "timestamp": "02:21:05", "text": "還要兩個小時。好的，我們可以結束了。"}, {"type": "subtitle", "time": 8477.51, "timestamp": "02:21:17", "text": "不，你可以自己完成你的"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "。哦"}, {"type": "subtitle", "time": 8484.23, "timestamp": "02:21:24", "text": "好的。好的。好的。讓我趕緊跑到附近去。好的。  我得到了它。  耶。我需要一把……是啊，"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "這種剪刀太酷了。你可以把它拆開，然後把它變成一把剪刀。好的。對，這就像一把可折疊的剪刀。"}, {"type": "subtitle", "time": 8506.95, "timestamp": "02:21:46", "text": "看看它。太可愛了。它就像兒童剪刀一樣。是的。狗就像個孩子。  不，"}, {"type": "subtitle", "time": 8508.95, "timestamp": "02:21:48", "text": "我想要的是方便攜帶的東西"}]
[{"type": "subtitle", "time": 10281.71, "timestamp": "02:51:21", "text": "。我們走吧。呃，他在"}, {"type": "subtitle", "time": 10286.75, "timestamp": "02:51:26", "text": "這裡嗎？正確的。好的。  你好。哦"}, {"type": "subtitle", "time": 10294.95, "timestamp": "02:51:34", "text": "，等等。這是什麼"}, {"type": "subtitle", "time": 10296.87, "timestamp": "02:51:36", "text": "？箭頭指向你叔叔"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "。使用。哦，你好凱蒂貓。三層，一層在把手上。加鹽。啊，糟糕。  重複"}, {"type": "subtitle", "time": 10318.23, "timestamp": "02:51:58", "text": "。按下按鈕搖晃袋子。  120分。這"}]
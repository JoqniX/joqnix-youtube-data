[{"type": "subtitle", "time": 1808.549, "timestamp": "00:30:08", "text": "你能行的。不錯。不錯。想得美，亡靈。  我"}, {"type": "subtitle", "time": 1810.95, "timestamp": "00:30:10", "text": "回來了。讓我"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "換一下。讓我開始直播。  難以置信。  好的。我剛吃完飯回來……"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "為什麼我還餓？  我剛吃過東西，但還是餓。我現在餓壞了。  一種飢餓的喜悅。飢餓的。"}, {"type": "subtitle", "time": 1857.95, "timestamp": "00:30:57", "text": "[音樂] 我們正在直播。我們正在直播。讓我先"}]
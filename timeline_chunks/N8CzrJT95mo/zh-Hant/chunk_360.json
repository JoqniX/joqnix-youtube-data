[{"type": "subtitle", "time": 21605.23, "timestamp": "06:00:05", "text": "啊，這音樂真讓人困惑。我的天哪。我的大腦。我的大腦。我的"}, {"type": "subtitle", "time": 21613.75, "timestamp": "06:00:13", "text": "大腦。  一。"}, {"type": "subtitle", "time": 21640.75, "timestamp": "06:00:40", "text": "我運行一下看看。當然，我拉動後就撞車了。碎油漆。呃，我們又重複了一遍。得小心別把[音樂]搞砸了"}]
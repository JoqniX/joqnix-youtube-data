[{"type": "subtitle", "time": 37801.31, "timestamp": "10:30:01", "text": "。我更加懷疑"}, {"type": "subtitle", "time": 37812.31, "timestamp": "10:30:12", "text": "迪奧。嘿，它居然真的有效。  我會打個問號。搞什麼鬼？這不是我想要的"}, {"type": "subtitle", "time": 37816.746, "timestamp": "10:30:16", "text": "。那不是"}, {"type": "subtitle", "time": 37826.99, "timestamp": "10:30:26", "text": "課程變數中的影片。達米，這根本行不通。你這話是什麼"}, {"type": "subtitle", "time": 37835.67, "timestamp": "10:30:35", "text": "意思？我的天啊。你甚至都沒格式化。我的天啊。  呃，不。"}, {"type": "subtitle", "time": 37837.51, "timestamp": "10:30:37", "text": "我不想分享。呃，[音樂]呃，"}, {"type": "subtitle", "time": 37839.71, "timestamp": "10:30:39", "text": "所以再問一個問題，呃，如果你在使用命令，你"}, {"type": "subtitle", "time": 37850.95, "timestamp": "10:30:50", "text": "知道嗎？我打算用克勞德。我受不了那玩意兒。克勞德·索內特"}]
[{"type": "subtitle", "time": 1921.07, "timestamp": "00:32:01", "text": "這東西連不上"}, {"type": "subtitle", "time": 1923.269, "timestamp": "00:32:03", "text": "。"}, {"type": "subtitle", "time": 1933.75, "timestamp": "00:32:13", "text": "為什麼它忽略？"}, {"type": "subtitle", "time": 1936.789, "timestamp": "00:32:16", "text": "你好。你好。  [音樂] [音樂] 夢 [掌聲] [音樂] D. 好了，我們吃完晚餐了。所以，我打算截個圖，把我晚上在"}, {"type": "subtitle", "time": 1944.549, "timestamp": "00:32:24", "text": "做這件事時和 Willy"}, {"type": "subtitle", "time": 1948.23, "timestamp": "00:32:28", "text": "Willy 的聊天記錄截下來。現在有很多聊天記錄，對吧？我截圖，設定好之後我們就"}]
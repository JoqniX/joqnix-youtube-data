[{"type": "subtitle", "time": 309.39, "timestamp": "00:05:09", "text": "。大家最近怎麼樣？"}, {"type": "subtitle", "time": 314.59, "timestamp": "00:05:14", "text": "你好。所以，今天是10月"}, {"type": "subtitle", "time": 317.51, "timestamp": "00:05:17", "text": "18日，老兄。十月已經過半了"}, {"type": "subtitle", "time": 323.23, "timestamp": "00:05:23", "text": "。是啊，"}, {"type": "subtitle", "time": 328.029, "timestamp": "00:05:28", "text": "我的嗓子啞了，因為我"}, {"type": "subtitle", "time": 330.43, "timestamp": "00:05:30", "text": "不小心弄啞了。我去吃飯。好的，請"}, {"type": "subtitle", "time": 334.67, "timestamp": "00:05:34", "text": "享用。因為我"}]
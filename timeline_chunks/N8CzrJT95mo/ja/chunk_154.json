[{"type": "subtitle", "time": 9248.75, "timestamp": "02:34:08", "text": "こんにちは"}, {"type": "subtitle", "time": 9253.349, "timestamp": "02:34:13", "text": "みんな。皆様、こんばんは。えっと"}, {"type": "subtitle", "time": 9256.07, "timestamp": "02:34:16", "text": "1秒間、私のモデルは動いていません。させて"}, {"type": "subtitle", "time": 9259.75, "timestamp": "02:34:19", "text": "ちょっとすぐに直しますね。アームグッド"}, {"type": "subtitle", "time": 9262.389, "timestamp": "02:34:22", "text": "朝。ああ、いや、こんばんは"}, {"type": "subtitle", "time": 9266.31, "timestamp": "02:34:26", "text": "全て。ああ、神様。なぜ私は「おはようございます」と言ったのだろうか？"}, {"type": "subtitle", "time": 9267.67, "timestamp": "02:34:27", "text": "[音楽]"}, {"type": "subtitle", "time": 9270.15, "timestamp": "02:34:30", "text": "ええと、皆さんお元気ですか？願わくば"}, {"type": "subtitle", "time": 9271.79, "timestamp": "02:34:31", "text": "みんなよくやっているよ。"}, {"type": "subtitle", "time": 9281.55, "timestamp": "02:34:41", "text": "こんにちは。だから、私たちは良いものを手に入れました"}, {"type": "subtitle", "time": 9284.23, "timestamp": "02:34:44", "text": "ニュース。ええと、良いニュースがいくつか入ってきました。"}, {"type": "subtitle", "time": 9286.389, "timestamp": "02:34:46", "text": "始める前に、ちょっとお話したいことがあります"}, {"type": "subtitle", "time": 9289.71, "timestamp": "02:34:49", "text": "それについて。全て"}, {"type": "subtitle", "time": 9293.95, "timestamp": "02:34:53", "text": "右。ダイアナさん、こんにちは。"}, {"type": "subtitle", "time": 9297.11, "timestamp": "02:34:57", "text": "それでは、今日の配信を始める前に"}]
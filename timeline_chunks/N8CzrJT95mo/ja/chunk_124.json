[{"type": "subtitle", "time": 7441.43, "timestamp": "02:04:01", "text": "あなたはゲームをしない。あなたはプレイしません"}, {"type": "subtitle", "time": 7449.83, "timestamp": "02:04:09", "text": "私も原神はプレイしません。"}, {"type": "subtitle", "time": 7452.95, "timestamp": "02:04:12", "text": "私はインフィニティニキをプレイしていません"}, {"type": "subtitle", "time": 7456.229, "timestamp": "02:04:16", "text": "どちらか。私はそれに夢中だった。ああ、私"}, {"type": "subtitle", "time": 7458.87, "timestamp": "02:04:18", "text": "あまりにも。農業と物語は親切です"}, {"type": "subtitle", "time": 7464.87, "timestamp": "02:04:24", "text": "でも、着せ替え要素は大好きなんです。わかった。"}, {"type": "subtitle", "time": 7467.02, "timestamp": "02:04:27", "text": "はい。"}, {"type": "subtitle", "time": 7469.51, "timestamp": "02:04:29", "text": "[音楽]"}, {"type": "subtitle", "time": 7472.95, "timestamp": "02:04:32", "text": "故障。書き留めてください。それを得る。書き留める"}, {"type": "subtitle", "time": 7474.189, "timestamp": "02:04:34", "text": "以上"}, {"type": "subtitle", "time": 7477.43, "timestamp": "02:04:37", "text": "それ。あなたが"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "終わり。とても眠いです。上隅"}, {"type": "subtitle", "time": 7485.51, "timestamp": "02:04:45", "text": "下。ええ、私のももうすぐ終わります。"}, {"type": "subtitle", "time": 7491.03, "timestamp": "02:04:51", "text": "私は自分でやってみます"}, {"type": "subtitle", "time": 7493.149, "timestamp": "02:04:53", "text": "心臓"}, {"type": "subtitle", "time": 7497.669, "timestamp": "02:04:57", "text": "弓。うん、やってみるよ。たとえそうでなくても"}]
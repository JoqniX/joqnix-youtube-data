[{"type": "subtitle", "time": 1095.669, "timestamp": "00:18:15", "text": "それ。実際に手に入れるために"}, {"type": "subtitle", "time": 1118.54, "timestamp": "00:18:38", "text": "待って、これが最初の着信音？"}, {"type": "subtitle", "time": 1120.27, "timestamp": "00:18:40", "text": "[音楽]"}, {"type": "subtitle", "time": 1124.59, "timestamp": "00:18:44", "text": "わあ、これが初挑戦だったんだ。によって"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "方法、シールドの数を見てください"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "おお。ショットガンの弾薬が必要だ。私"}]
[{"type": "subtitle", "time": 7740.229, "timestamp": "02:09:00", "text": "あなたは配信をしていますか？なぜあなたはしないのですか"}, {"type": "subtitle", "time": 7743.109, "timestamp": "02:09:03", "text": "お菓子作りの配信だけど、お菓子作りの動画みたいな感じ？"}, {"type": "subtitle", "time": 7746.069, "timestamp": "02:09:06", "text": "今日は、私の"}, {"type": "subtitle", "time": 7749.91, "timestamp": "02:09:09", "text": "兄と私は、えっと、彼に200ドル払った"}, {"type": "subtitle", "time": 7752.75, "timestamp": "02:09:12", "text": "このユニークな味を手に入れるにはルピー"}, {"type": "subtitle", "time": 7757.03, "timestamp": "02:09:17", "text": "オレオ。オレオコーラ。わかった。コカ・コーラだが"}, {"type": "subtitle", "time": 7760.629, "timestamp": "02:09:20", "text": "オレオ味で、驚くほど美味しかった。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "慎重に、しかし同時に"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "コカ・コーラ。良かったよ。"}, {"type": "subtitle", "time": 7769.99, "timestamp": "02:09:29", "text": "だから僕と兄のビクは"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "えっと、ショットを撮っていたんだけど"}, {"type": "subtitle", "time": 7777.51, "timestamp": "02:09:37", "text": "貧乏なASMRのようにひっくり返して飲む"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "アップロードするかもしれません。"}, {"type": "subtitle", "time": 7790.47, "timestamp": "02:09:50", "text": "ああ、録音したの？うん。おお。ニース。"}, {"type": "subtitle", "time": 7795.149, "timestamp": "02:09:55", "text": "もしかしたら、同じようにしてお菓子作りの動画も作ってみるかもしれない。"}]
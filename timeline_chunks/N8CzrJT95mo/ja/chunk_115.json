[{"type": "subtitle", "time": 6912.39, "timestamp": "01:55:12", "text": "次のように完了しました"}, {"type": "subtitle", "time": 6913.55, "timestamp": "01:55:13", "text": "そうそう。私"}, {"type": "subtitle", "time": 6917.589, "timestamp": "01:55:17", "text": "ああ、見せてください。もう遅い時間じゃないですか？はい、"}, {"type": "subtitle", "time": 6920.149, "timestamp": "01:55:20", "text": "遅れている。これが最後になります、"}, {"type": "subtitle", "time": 6923.99, "timestamp": "01:55:23", "text": "推測。いいえ、それはできません。ああ、ただ"}, {"type": "subtitle", "time": 6925.99, "timestamp": "01:55:25", "text": "これをしてください。ああ、わかりました。簡単な方法です。"}, {"type": "subtitle", "time": 6929.51, "timestamp": "01:55:29", "text": "簡単な方法。えっと、折りたたんでください。まっすぐに"}, {"type": "subtitle", "time": 6934.51, "timestamp": "01:55:34", "text": "外。左から右へ"}, {"type": "subtitle", "time": 6943.149, "timestamp": "01:55:43", "text": "私の指導料は支払われるべきです。"}, {"type": "subtitle", "time": 6946.79, "timestamp": "01:55:46", "text": "大丈夫だよ。今すぐ話し合ってみましょう。"}, {"type": "subtitle", "time": 6951.189, "timestamp": "01:55:51", "text": "こんにちは。はい、ただおしゃべりするだけでも構いません。はい、"}, {"type": "subtitle", "time": 6953.75, "timestamp": "01:55:53", "text": "私はあきらめます。ごめんね、ジョー。私には無理です"}, {"type": "subtitle", "time": 6956.39, "timestamp": "01:55:56", "text": "これをしてください。私の脳は心配ない。いいえ"}, {"type": "subtitle", "time": 6959.78, "timestamp": "01:55:59", "text": "心配事。心配ない。"}]
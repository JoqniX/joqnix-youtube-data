[{"type": "subtitle", "time": 3122.15, "timestamp": "00:52:02", "text": "アニメーションおじさん。ダウンロードしたか"}, {"type": "subtitle", "time": 3124.39, "timestamp": "00:52:04", "text": "1つで？ああ、わかりました。わかった。大丈夫。プロジェクト。"}, {"type": "subtitle", "time": 3125.829, "timestamp": "00:52:05", "text": "わかった。わかった。わかった。わかった。コピー"}, {"type": "subtitle", "time": 3135.109, "timestamp": "00:52:15", "text": "アルバム。テキサスについて教えてください。待って、そうじゃない"}, {"type": "subtitle", "time": 3137.549, "timestamp": "00:52:17", "text": "ここ。待って、何？"}, {"type": "subtitle", "time": 3140.23, "timestamp": "00:52:20", "text": "何が起こったのか？本物のTはどうなったのか？"}, {"type": "subtitle", "time": 3146.03, "timestamp": "00:52:26", "text": "待って、何？"}, {"type": "subtitle", "time": 3153.23, "timestamp": "00:52:33", "text": "[音楽]"}, {"type": "subtitle", "time": 3158.63, "timestamp": "00:52:38", "text": "はぁ？もし私がそれを見たら、えっと、私には見えません。"}, {"type": "subtitle", "time": 3163.829, "timestamp": "00:52:43", "text": "何が起こったのか？わかった。ええ、全部です。その"}, {"type": "subtitle", "time": 3171.829, "timestamp": "00:52:51", "text": "プレイリスト？ 1つ。 1 2 3。 1つ、"}, {"type": "subtitle", "time": 3177.549, "timestamp": "00:52:57", "text": "3"}, {"type": "subtitle", "time": 3179.309, "timestamp": "00:52:59", "text": "4"}]
[{"type": "subtitle", "time": 8460.07, "timestamp": "02:21:00", "text": "それはアイデアだった。蝶々をありがとう"}, {"type": "subtitle", "time": 8463.75, "timestamp": "02:21:03", "text": "あれ。皆さん、おやすみなさい。気をつけて。"}, {"type": "subtitle", "time": 8465.95, "timestamp": "02:21:05", "text": "死ぬな。良い"}, {"type": "subtitle", "time": 8474.309, "timestamp": "02:21:14", "text": "あ、待って。私に見せるべきでしょうか？"}, {"type": "subtitle", "time": 8477.51, "timestamp": "02:21:17", "text": "それって配信中なの？いいえ、見ることができます"}, {"type": "subtitle", "time": 8479.75, "timestamp": "02:21:19", "text": "それ。本当に気持ち悪い。どうすればいいのかわからない"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "それは来た。"}, {"type": "subtitle", "time": 8484.23, "timestamp": "02:21:24", "text": "大丈夫。"}, {"type": "subtitle", "time": 8486.429, "timestamp": "02:21:26", "text": "バイバイ。"}, {"type": "subtitle", "time": 8488.71, "timestamp": "02:21:28", "text": "さようなら、おやすみなさい。そして、ありがとう"}, {"type": "subtitle", "time": 8492.07, "timestamp": "02:21:32", "text": "今日はここまで。本当に楽しかった"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "今回のコラボレーションも楽しみです。はい、そうしましょう。"}, {"type": "subtitle", "time": 8501.19, "timestamp": "02:21:41", "text": "私は休むつもりです、なぜなら私は"}, {"type": "subtitle", "time": 8504.07, "timestamp": "02:21:44", "text": "忘れてた。カフシロップを飲むのを忘れてた。"}, {"type": "subtitle", "time": 8506.95, "timestamp": "02:21:46", "text": "飲みます。はい。はい。薬を飲んでください。"}, {"type": "subtitle", "time": 8508.95, "timestamp": "02:21:48", "text": "掃除したいという気持ちすら全くない"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "おやすみ。こんにちは。おやすみ。さよなら。"}]
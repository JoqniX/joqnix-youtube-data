[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "そして明日は音楽の授業がある。"}, {"type": "subtitle", "time": 2344.069, "timestamp": "00:39:04", "text": "明日は会議に出席しなければならない"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "日本とのコラボレーション向け。私はVCを持っています"}, {"type": "subtitle", "time": 2348.829, "timestamp": "00:39:08", "text": "ミーティング"}, {"type": "subtitle", "time": 2351.27, "timestamp": "00:39:11", "text": "明日。ああ、うまくいくといいな。私"}, {"type": "subtitle", "time": 2353.19, "timestamp": "00:39:13", "text": "日本語の練習すらしたことがない。聖なる"}, {"type": "subtitle", "time": 2355.23, "timestamp": "00:39:15", "text": "神様、私はどうやって話せばいいのでしょうか"}, {"type": "subtitle", "time": 2358.23, "timestamp": "00:39:18", "text": "明日？私は苦労するだろう"}, {"type": "subtitle", "time": 2359.31, "timestamp": "00:39:19", "text": "難しい、"}, {"type": "subtitle", "time": 2361.91, "timestamp": "00:39:21", "text": "男。でも、明日はそうすべきではない"}, {"type": "subtitle", "time": 2364.349, "timestamp": "00:39:24", "text": "とても疲れていて"}, {"type": "subtitle", "time": 2371.43, "timestamp": "00:39:31", "text": "印象。明日私たちは座って"}, {"type": "subtitle", "time": 2373.67, "timestamp": "00:39:33", "text": "彼らと話してください。私は"}, {"type": "subtitle", "time": 2376.63, "timestamp": "00:39:36", "text": "病棟でのストリーム配信。授業があるのは分かっています"}, {"type": "subtitle", "time": 2380.109, "timestamp": "00:39:40", "text": "その後は5時半以降。"}, {"type": "subtitle", "time": 2382.829, "timestamp": "00:39:42", "text": "そして"}, {"type": "subtitle", "time": 2385.27, "timestamp": "00:39:45", "text": "うん、ただあげるよ、ただあげるよ"}, {"type": "subtitle", "time": 2388.67, "timestamp": "00:39:48", "text": "それが私のベストです。"}]
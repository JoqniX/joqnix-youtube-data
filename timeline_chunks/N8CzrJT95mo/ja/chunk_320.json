[{"type": "subtitle", "time": 19224.708, "timestamp": "05:20:24", "text": "コメント。君たち、これは必要ないよ。私たちはそうしません"}, {"type": "subtitle", "time": 19225.55, "timestamp": "05:20:25", "text": "必要"}, {"type": "subtitle", "time": 19233.67, "timestamp": "05:20:33", "text": "ランダム。これは必要ない。"}, {"type": "subtitle", "time": 19236.27, "timestamp": "05:20:36", "text": "ファイルワード"}, {"type": "subtitle", "time": 19251.99, "timestamp": "05:20:51", "text": "これ。ええ、私たちはただ、私たち全員が"}, {"type": "subtitle", "time": 19254.31, "timestamp": "05:20:54", "text": "私たちがすべきことは、ああ、あのね？あなた"}, {"type": "subtitle", "time": 19255.55, "timestamp": "05:20:55", "text": "何だと思う？あなたが知っている"}, {"type": "subtitle", "time": 19259.788, "timestamp": "05:20:59", "text": "何？追加はしません。私たちは"}]
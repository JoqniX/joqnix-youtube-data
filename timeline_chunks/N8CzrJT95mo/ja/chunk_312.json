[{"type": "subtitle", "time": 18722.91, "timestamp": "05:12:02", "text": "これから出力しようとしているビデオの出力"}, {"type": "subtitle", "time": 18728.75, "timestamp": "05:12:08", "text": "えっと、あなた"}, {"type": "subtitle", "time": 18740.59, "timestamp": "05:12:20", "text": "どこ"}, {"type": "subtitle", "time": 18756.23, "timestamp": "05:12:36", "text": "残りの部分を指定する必要がないので"}, {"type": "subtitle", "time": 18758.07, "timestamp": "05:12:38", "text": "自動再生とかそういう類のもの。私はしません"}, {"type": "subtitle", "time": 18761.43, "timestamp": "05:12:41", "text": "それを明記する必要がある。えっと、私はただ"}, {"type": "subtitle", "time": 18762.51, "timestamp": "05:12:42", "text": "置く"}]
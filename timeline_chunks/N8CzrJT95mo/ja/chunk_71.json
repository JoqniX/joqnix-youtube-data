[{"type": "subtitle", "time": 4272.229, "timestamp": "01:11:12", "text": "間違い？ああ、それはユタ州の歌だ。わかった。"}, {"type": "subtitle", "time": 4275.43, "timestamp": "01:11:15", "text": "わかった。ユタの歌は「ああ、わかった」です。わかった。私"}, {"type": "subtitle", "time": 4279.669, "timestamp": "01:11:19", "text": "わかったよ。それで、私は実際に2つ"}, {"type": "subtitle", "time": 4281.149, "timestamp": "01:11:21", "text": "同じだが違う"}, {"type": "subtitle", "time": 4283.229, "timestamp": "01:11:23", "text": "カバー。"}, {"type": "subtitle", "time": 4285.07, "timestamp": "01:11:25", "text": "わかった。"}, {"type": "subtitle", "time": 4288.43, "timestamp": "01:11:28", "text": "つまり、どちらも奇妙な違いから始まる"}, {"type": "subtitle", "time": 4291.27, "timestamp": "01:11:31", "text": "時間。そしてこれもまた"}, {"type": "subtitle", "time": 4293.83, "timestamp": "01:11:33", "text": "タイミングが異なる。だから私は"}, {"type": "chat", "time": 4299.637, "timestamp": "01:11:39", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 4301.39, "timestamp": "01:11:41", "text": "ここ。わかりました、私はこれをします"}, {"type": "subtitle", "time": 4311.03, "timestamp": "01:11:51", "text": "二。外部出力。"}, {"type": "subtitle", "time": 4312.87, "timestamp": "01:11:52", "text": "これは３つ半で、これは"}]
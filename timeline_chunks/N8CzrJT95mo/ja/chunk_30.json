[{"type": "subtitle", "time": 1805.23, "timestamp": "00:30:05", "text": "[音楽]"}, {"type": "subtitle", "time": 1808.549, "timestamp": "00:30:08", "text": "D. よし、夕食はこれで終わりだ。だから私は"}, {"type": "subtitle", "time": 1810.95, "timestamp": "00:30:10", "text": "これからやります。スクリーンショットを撮らせてください。"}, {"type": "subtitle", "time": 1814.87, "timestamp": "00:30:14", "text": "ウィリーウィリーチャットは、私が夕方から"}, {"type": "subtitle", "time": 1816.389, "timestamp": "00:30:16", "text": "その作業に取り組んでいた。さあ、そこに"}, {"type": "subtitle", "time": 1819.35, "timestamp": "00:30:19", "text": "たくさんチャットしたよね？私はただ"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "スクリーンショットを撮って、それを設定するから"}, {"type": "subtitle", "time": 1824.43, "timestamp": "00:30:24", "text": "その後"}, {"type": "subtitle", "time": 1828.909, "timestamp": "00:30:28", "text": "歌を歌おう"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "右。夕食は何を食べましたか？えっと"}, {"type": "subtitle", "time": 1855.73, "timestamp": "00:30:55", "text": "魚"}, {"type": "subtitle", "time": 1857.95, "timestamp": "00:30:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 2701.55, "timestamp": "00:45:01", "text": "罰則。私は9つの問題を抱えています"}, {"type": "subtitle", "time": 2703.67, "timestamp": "00:45:03", "text": "罰則。何てことだ。神様、私は苦しんでいます"}, {"type": "subtitle", "time": 2705.069, "timestamp": "00:45:05", "text": "9つ"}, {"type": "subtitle", "time": 2711.47, "timestamp": "00:45:11", "text": "自分。しかし"}, {"type": "subtitle", "time": 2714.91, "timestamp": "00:45:14", "text": "うん、でもこれは初めてなんだ"}, {"type": "subtitle", "time": 2719.309, "timestamp": "00:45:19", "text": "カテゴリ 仮想 日付 毎日"}, {"type": "subtitle", "time": 2723.95, "timestamp": "00:45:23", "text": "えーと、カテゴリー。だから私はそうならないことを願う"}, {"type": "subtitle", "time": 2725.79, "timestamp": "00:45:25", "text": "得る"}, {"type": "subtitle", "time": 2728.349, "timestamp": "00:45:28", "text": "罰せられる"}, {"type": "subtitle", "time": 2730.589, "timestamp": "00:45:30", "text": "えっと、私は"}, {"type": "subtitle", "time": 2733.109, "timestamp": "00:45:33", "text": "喜んで。はい、そうです"}, {"type": "subtitle", "time": 2736.15, "timestamp": "00:45:36", "text": "こちらこそお会いできて光栄です。私の"}, {"type": "subtitle", "time": 2738.39, "timestamp": "00:45:38", "text": "言語が良くない。大丈夫。あなたはできる"}, {"type": "subtitle", "time": 2742.27, "timestamp": "00:45:42", "text": "入力してください。"}, {"type": "subtitle", "time": 2752.27, "timestamp": "00:45:52", "text": "心配。"}, {"type": "subtitle", "time": 2755.75, "timestamp": "00:45:55", "text": "えっと、私は何をしていたんだっけ？よし、この男だ。いいえ、"}]
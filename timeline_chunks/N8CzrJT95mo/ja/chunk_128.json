[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "いちご。待って、あなたは好きですか"}, {"type": "subtitle", "time": 7683.589, "timestamp": "02:08:03", "text": "いちご？私はイチゴが大好きです。私は好きです"}, {"type": "subtitle", "time": 7685.109, "timestamp": "02:08:05", "text": "イチゴ。"}, {"type": "subtitle", "time": 7688.87, "timestamp": "02:08:08", "text": "わーい。イチゴギャング。それは信じられている"}, {"type": "subtitle", "time": 7690.55, "timestamp": "02:08:10", "text": "特にチョコレートでコーティングされたもの"}, {"type": "subtitle", "time": 7695.51, "timestamp": "02:08:15", "text": "[音楽]"}, {"type": "subtitle", "time": 7697.75, "timestamp": "02:08:17", "text": "チョコレートでコーティングされている。ああ、私は持っていません"}, {"type": "subtitle", "time": 7701.91, "timestamp": "02:08:21", "text": "それはまだ。私はただ、とても熱心だから"}, {"type": "subtitle", "time": 7705.51, "timestamp": "02:08:25", "text": "角をイチゴのように飾る。ええ、"}, {"type": "subtitle", "time": 7707.75, "timestamp": "02:08:27", "text": "私はイチゴにとても熱心なので、"}, {"type": "subtitle", "time": 7711.27, "timestamp": "02:08:31", "text": "いちご味のみのタイプのみを入手してください。"}, {"type": "subtitle", "time": 7713.75, "timestamp": "02:08:33", "text": "わからない。あなたはただ手に入れるべきです"}, {"type": "subtitle", "time": 7716.31, "timestamp": "02:08:36", "text": "ヌテラを少し塗って、イチゴを乗せる"}, {"type": "subtitle", "time": 7717.99, "timestamp": "02:08:37", "text": "その中に。"}, {"type": "subtitle", "time": 7720.47, "timestamp": "02:08:40", "text": "私のことを覚えていてくれて、ありがとう。"}, {"type": "subtitle", "time": 7722.709, "timestamp": "02:08:42", "text": "冷蔵庫にヌテラがあります。私は行きます"}, {"type": "subtitle", "time": 7725.31, "timestamp": "02:08:45", "text": "それを食べるために"}, {"type": "subtitle", "time": 7729.189, "timestamp": "02:08:49", "text": "完全に。私はこう感じました、私は"}, {"type": "subtitle", "time": 7731.43, "timestamp": "02:08:51", "text": "何かを忘れている。それは何か"}, {"type": "subtitle", "time": 7735.669, "timestamp": "02:08:55", "text": "私は食べることに慣れています。私は食べるのが大好きです。"}, {"type": "subtitle", "time": 7736.83, "timestamp": "02:08:56", "text": "待って、"}]
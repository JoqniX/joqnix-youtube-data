[{"type": "subtitle", "time": 20641.868, "timestamp": "05:44:01", "text": "動画一覧。"}, {"type": "subtitle", "time": 20645.51, "timestamp": "05:44:05", "text": "右？それは承知しました。わかった。それで今"}, {"type": "subtitle", "time": 20650.628, "timestamp": "05:44:10", "text": "問題は、ソロでどうやって"}, {"type": "subtitle", "time": 20653.948, "timestamp": "05:44:13", "text": "これらの一つ一つを"}, {"type": "subtitle", "time": 20658.35, "timestamp": "05:44:18", "text": "みんな、ビデオに入れるために"}, {"type": "subtitle", "time": 20660.83, "timestamp": "05:44:20", "text": "作成用のID"}, {"type": "subtitle", "time": 20663.83, "timestamp": "05:44:23", "text": "ああ、そうだね、思い出させてくれてありがとう"}, {"type": "subtitle", "time": 20667.948, "timestamp": "05:44:27", "text": "えっと、それを食べなきゃ。"}, {"type": "subtitle", "time": 20682.868, "timestamp": "05:44:42", "text": "これ。一緒にフォーマットしましょう。それから、えーと"}, {"type": "subtitle", "time": 20690.19, "timestamp": "05:44:50", "text": "右？えっと、弦"}, {"type": "subtitle", "time": 20691.81, "timestamp": "05:44:51", "text": "うーん、弦"}, {"type": "subtitle", "time": 20693.15, "timestamp": "05:44:53", "text": "[音楽]"}, {"type": "subtitle", "time": 20696.68, "timestamp": "05:44:56", "text": "弦。いやいやいや"}, {"type": "subtitle", "time": 20698.35, "timestamp": "05:44:58", "text": "[音楽]"}]
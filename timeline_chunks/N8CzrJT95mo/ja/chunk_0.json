[{"type": "subtitle", "time": 12.43, "timestamp": "00:00:12", "text": "ライブ。こんにちは、ジャカソンデーへようこそ"}, {"type": "subtitle", "time": 15.829, "timestamp": "00:00:15", "text": "43 パート2 ストリーム、夜のストリーム。"}, {"type": "subtitle", "time": 17.79, "timestamp": "00:00:17", "text": "いらっしゃいませ"}, {"type": "subtitle", "time": 20.67, "timestamp": "00:00:20", "text": "D. では、"}, {"type": "subtitle", "time": 22.91, "timestamp": "00:00:22", "text": "そこにいるだろう"}, {"type": "subtitle", "time": 25.23, "timestamp": "00:00:25", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 27.99, "timestamp": "00:00:27", "text": "それ？えっと、夜の配信。私たちは"}, {"type": "subtitle", "time": 30.63, "timestamp": "00:00:30", "text": "ショートパンツとかそういうの、もしくは夜だけやるよ"}, {"type": "subtitle", "time": 33.35, "timestamp": "00:00:33", "text": "歌ったり、その他いろいろ"}, {"type": "subtitle", "time": 35.83, "timestamp": "00:00:35", "text": "夕食。私はまだ夕食を食べていません。知っている"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "午前11時、午後11時です。そしてそれは"}, {"type": "subtitle", "time": 41.549, "timestamp": "00:00:41", "text": "外は雨が降っている。完全に手に入れるつもりです"}, {"type": "subtitle", "time": 44.31, "timestamp": "00:00:44", "text": "家の中に入るときにずぶ濡れになった"}, {"type": "subtitle", "time": 45.47, "timestamp": "00:00:45", "text": "から"}, {"type": "subtitle", "time": 48.95, "timestamp": "00:00:48", "text": "外。ああ、でも大丈夫だよ。私は"}, {"type": "subtitle", "time": 52.15, "timestamp": "00:00:52", "text": "傘をさして、上がっていくんだろうな。全て"}, {"type": "subtitle", "time": 55.11, "timestamp": "00:00:55", "text": "右。ええ、じゃあ、Vに君たちを載せるよ。"}, {"type": "subtitle", "time": 57.59, "timestamp": "00:00:57", "text": "VODをお楽しみください。私は戻ってきます。わかった。そして"}, {"type": "subtitle", "time": 59.029, "timestamp": "00:00:59", "text": "ビリーの番組を観ている人へ"}]
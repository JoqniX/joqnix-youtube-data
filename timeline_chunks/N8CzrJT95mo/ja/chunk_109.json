[{"type": "subtitle", "time": 6541.109, "timestamp": "01:49:01", "text": "タ。いつか私はコンテンツクリエイターになりたい"}, {"type": "subtitle", "time": 6544.149, "timestamp": "01:49:04", "text": "クリエイターか何かを手に入れられるように"}, {"type": "subtitle", "time": 6547.709, "timestamp": "01:49:07", "text": "これらのベータキーとアルファキーと"}, {"type": "subtitle", "time": 6572.91, "timestamp": "01:49:32", "text": "これ。昨日"}, {"type": "subtitle", "time": 6594.83, "timestamp": "01:49:54", "text": "そして私はそこにいた、私はそこにいた"}]
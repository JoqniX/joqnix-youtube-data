[{"type": "subtitle", "time": 420.23, "timestamp": "00:07:00", "text": "レヴナントのプレステージスキン。最後に"}, {"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "ラヴィ・チャンはプレステージスキンを持っています。私は誇りに思います"}, {"type": "subtitle", "time": 425.39, "timestamp": "00:07:05", "text": "の"}, {"type": "subtitle", "time": 428.029, "timestamp": "00:07:08", "text": "彼。"}, {"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "そして、今日は"}, {"type": "subtitle", "time": 433.07, "timestamp": "00:07:13", "text": "10月18日は記念日です"}, {"type": "subtitle", "time": 438.27, "timestamp": "00:07:18", "text": "カファン。何てことだ。何てことだ。今日の"}, {"type": "subtitle", "time": 442.469, "timestamp": "00:07:22", "text": "コーヒー。何てことだ。どこかに行って。私はただ"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "とにかく、喉がひどく痛む。"}, {"type": "subtitle", "time": 467.909, "timestamp": "00:07:47", "text": "さあ、ゲームを始めましょう。私はそうしました"}, {"type": "subtitle", "time": 472.43, "timestamp": "00:07:52", "text": "私はまだ開封していません。何？こんにちは、"}, {"type": "subtitle", "time": 476.30899999999997, "timestamp": "00:07:56", "text": "ナニ。かに。何てことだ。では、"}, {"type": "subtitle", "time": 478.749, "timestamp": "00:07:58", "text": "ゲーム。食事も始めるべきです"}]
[{"type": "subtitle", "time": 20402.91, "timestamp": "05:40:02", "text": "ループ。ええ、だから私はそう言ったんです"}, {"type": "subtitle", "time": 20414.15, "timestamp": "05:40:14", "text": "大丈夫。ランダムなコマンド。オーケー、ランダム"}, {"type": "subtitle", "time": 20415.948, "timestamp": "05:40:15", "text": "指示。さあ"}, {"type": "subtitle", "time": 20420.03, "timestamp": "05:40:20", "text": "見る。走る。"}, {"type": "subtitle", "time": 20423.59, "timestamp": "05:40:23", "text": "ランダム。わかった。変数名、最小値"}, {"type": "subtitle", "time": 20426.15, "timestamp": "05:40:26", "text": "許容値、最大許容値。"}, {"type": "subtitle", "time": 20427.83, "timestamp": "05:40:27", "text": "ちょっと待って。資料を見せてください"}, {"type": "subtitle", "time": 20432.59, "timestamp": "05:40:32", "text": "ランダム"}, {"type": "subtitle", "time": 20435.51, "timestamp": "05:40:35", "text": "random は、ランダムな値を持つ変数を返します。"}, {"type": "subtitle", "time": 20437.91, "timestamp": "05:40:37", "text": "最小値と最大値の間の値"}, {"type": "subtitle", "time": 20440.23, "timestamp": "05:40:40", "text": "取りうる値。これは基本です"}, {"type": "subtitle", "time": 20442.948, "timestamp": "05:40:42", "text": "ランダムな動画から音を選択する際に使用します。"}, {"type": "subtitle", "time": 20445.27, "timestamp": "05:40:45", "text": "わかった。わかった。可能な限り最小値、"}, {"type": "subtitle", "time": 20452.23, "timestamp": "05:40:52", "text": "フロートをポーズしました。わかった。待って。見てみましょう。"}, {"type": "subtitle", "time": 20455.59, "timestamp": "05:40:55", "text": "1から10まで。つまり、1から10までのビデオのリストです。"}, {"type": "subtitle", "time": 20459.15, "timestamp": "05:40:59", "text": "10. 動画を再生します。わかった。"}]
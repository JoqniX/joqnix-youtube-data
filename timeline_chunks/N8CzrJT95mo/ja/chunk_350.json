[{"type": "subtitle", "time": 21000.51, "timestamp": "05:50:00", "text": "そうだったのか？どこにいるの？"}, {"type": "subtitle", "time": 21003.03, "timestamp": "05:50:03", "text": "感情表現。うん、１、２、３とできるよ"}, {"type": "subtitle", "time": 21004.35, "timestamp": "05:50:04", "text": "のように"}, {"type": "subtitle", "time": 21009.11, "timestamp": "05:50:09", "text": "これ。ある意味、それは正しいやり方だ。しかし、"}, {"type": "subtitle", "time": 21010.75, "timestamp": "05:50:10", "text": "問題はこれらが"}, {"type": "subtitle", "time": 21014.07, "timestamp": "05:50:14", "text": "オブジェクト。えっと、配列ではありません。となることによって"}, {"type": "subtitle", "time": 21016.628, "timestamp": "05:50:16", "text": "つまり、私はそうしなければならないので、問題は私が"}, {"type": "subtitle", "time": 21020.27, "timestamp": "05:50:20", "text": "それぞれをランダム化している間、"}, {"type": "subtitle", "time": 21023.27, "timestamp": "05:50:23", "text": "すべてシャッフルして、ソロで"}, {"type": "subtitle", "time": 21026.15, "timestamp": "05:50:26", "text": "それを出すには、たくさんの変数を用意する必要がある"}, {"type": "subtitle", "time": 21039.39, "timestamp": "05:50:39", "text": "多くの。うん。"}, {"type": "subtitle", "time": 21042.51, "timestamp": "05:50:42", "text": "とにかく、そういうことです"}, {"type": "subtitle", "time": 21045.708, "timestamp": "05:50:45", "text": "了解。ともかく、"}, {"type": "subtitle", "time": 21054.61, "timestamp": "05:50:54", "text": "外。えっと"}]
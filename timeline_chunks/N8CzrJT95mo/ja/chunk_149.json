[{"type": "subtitle", "time": 8943.87, "timestamp": "02:29:03", "text": "ストリームは良いです。私は携帯電話を使っていました。"}, {"type": "subtitle", "time": 8946.79, "timestamp": "02:29:06", "text": "カメラ 私は携帯電話のカメラを使っていました"}, {"type": "subtitle", "time": 8949.19, "timestamp": "02:29:09", "text": "それが良かったかどうかは関係ない。使用していると思います"}, {"type": "subtitle", "time": 8952.27, "timestamp": "02:29:12", "text": "背面カメラ、2倍"}, {"type": "subtitle", "time": 8955.99, "timestamp": "02:29:15", "text": "1つ。いいえ、いいえ、外向きのカメラです。"}, {"type": "subtitle", "time": 8961.19, "timestamp": "02:29:21", "text": "遠くにあるカメラのせいだろうね。えっと、でも"}, {"type": "subtitle", "time": 8969.429, "timestamp": "02:29:29", "text": "こんにちは。こんにちは。では、最後にまとめます。"}, {"type": "subtitle", "time": 8972.309, "timestamp": "02:29:32", "text": "ここ。皆様、ありがとうございました。そして私も"}, {"type": "subtitle", "time": 8975.51, "timestamp": "02:29:35", "text": "本当に謝罪したいのですが"}, {"type": "subtitle", "time": 8978.469, "timestamp": "02:29:38", "text": "今日チャットした人たちと私がチャットしなかった人たち"}, {"type": "subtitle", "time": 8980.469, "timestamp": "02:29:40", "text": "あなたのチャットを読みましたが、それに気づきました"}, {"type": "subtitle", "time": 8983.75, "timestamp": "02:29:43", "text": "けれど。本日はありがとうございました。そうだった"}, {"type": "subtitle", "time": 8991.67, "timestamp": "02:29:51", "text": "楽しい。うん。そして私は自分自身を感じることができる"}, {"type": "subtitle", "time": 8992.67, "timestamp": "02:29:52", "text": "取得"}, {"type": "subtitle", "time": 8995.75, "timestamp": "02:29:55", "text": "脱水症状。私は水を飲まなければならない。する"}, {"type": "subtitle", "time": 8998.309, "timestamp": "02:29:58", "text": "これが私の水差しだって知ってる？それはあまりにも"}]
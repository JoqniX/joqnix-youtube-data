[{"type": "subtitle", "time": 10443.389, "timestamp": "02:54:03", "text": "私はインドネシアに住んでいます"}, {"type": "subtitle", "time": 10468.55, "timestamp": "02:54:28", "text": "[音楽]"}, {"type": "subtitle", "time": 10471.71, "timestamp": "02:54:31", "text": "待って、私が知っている人は"}, {"type": "subtitle", "time": 10475.63, "timestamp": "02:54:35", "text": "世界？ああ、息子は"}, {"type": "subtitle", "time": 10478.91, "timestamp": "02:54:38", "text": "ここ。私は観ました"}, {"type": "subtitle", "time": 10481.23, "timestamp": "02:54:41", "text": "アニメ。"}, {"type": "subtitle", "time": 10484.309, "timestamp": "02:54:44", "text": "えっと、そのアニメって何でしたっけ？忘れた。"}, {"type": "subtitle", "time": 10487.63, "timestamp": "02:54:47", "text": "えっと、彼は私に、"}]
[{"type": "subtitle", "time": 4081.789, "timestamp": "01:08:01", "text": "あと2人"}, {"type": "subtitle", "time": 4085.95, "timestamp": "01:08:05", "text": "行く。もうその件は終わりました。えっと、それは"}, {"type": "subtitle", "time": 4089.15, "timestamp": "01:08:09", "text": "これ？それは私たちが"}, {"type": "subtitle", "time": 4093.309, "timestamp": "01:08:13", "text": "追加した。オヤシをやらなければならない。これです、"}, {"type": "subtitle", "time": 4095.709, "timestamp": "01:08:15", "text": "右？そしてこれ"}, {"type": "subtitle", "time": 4099.149, "timestamp": "01:08:19", "text": "内気です"}, {"type": "subtitle", "time": 4108.95, "timestamp": "01:08:28", "text": "下。わかった。同時に2曲追加"}, {"type": "subtitle", "time": 4110.91, "timestamp": "01:08:30", "text": "時間。その"}, {"type": "subtitle", "time": 4114.87, "timestamp": "01:08:34", "text": "大丈夫。そうすべきでしょうか？そうすべきでしょうか？わかった。そうではない"}, {"type": "subtitle", "time": 4123.03, "timestamp": "01:08:43", "text": "これは不気味だ。わかった。これです。わかった。これ"}, {"type": "subtitle", "time": 4125.07, "timestamp": "01:08:45", "text": "これがフルバージョンの曲です。行く"}, {"type": "subtitle", "time": 4128.269, "timestamp": "01:08:48", "text": "ここ。動かす"}, {"type": "subtitle", "time": 4131.95, "timestamp": "01:08:51", "text": "上。そして最後の一つは"}]
[{"type": "subtitle", "time": 3541.03, "timestamp": "00:59:01", "text": "歌声。ああ、ただ言ってるだけだよ"}, {"type": "subtitle", "time": 3543.51, "timestamp": "00:59:03", "text": "歌おうとしている。私たちは歌うつもりです"}, {"type": "subtitle", "time": 3547.47, "timestamp": "00:59:07", "text": "少しだけ。私は作ろうとしています、私は作ろうとしています"}, {"type": "subtitle", "time": 3552.03, "timestamp": "00:59:12", "text": "えっと、私は"}, {"type": "subtitle", "time": 3556.43, "timestamp": "00:59:16", "text": "えっと、これをここに置こうとしているんです。する"}, {"type": "subtitle", "time": 3560.75, "timestamp": "00:59:20", "text": "私は歌が上手ではありません。私は苦手です"}, {"type": "subtitle", "time": 3564.36, "timestamp": "00:59:24", "text": "歌うことは好きだけど、歌を習いたい。"}, {"type": "subtitle", "time": 3580.15, "timestamp": "00:59:40", "text": "[音楽]"}, {"type": "subtitle", "time": 3599.36, "timestamp": "00:59:59", "text": "いつになるか"}]
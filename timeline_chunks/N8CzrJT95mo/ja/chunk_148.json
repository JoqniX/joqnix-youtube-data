[{"type": "subtitle", "time": 8882.389, "timestamp": "02:28:02", "text": "解剖学の知識がどんどん深まっている。"}, {"type": "subtitle", "time": 8885.03, "timestamp": "02:28:05", "text": "色彩、陰影、照明。とても"}, {"type": "subtitle", "time": 8886.55, "timestamp": "02:28:06", "text": "多くのことがまさに"}, {"type": "subtitle", "time": 8888.91, "timestamp": "02:28:08", "text": "美術。"}, {"type": "subtitle", "time": 8894.11, "timestamp": "02:28:14", "text": "そうですね、すべてゆっくりと行ってください。"}, {"type": "subtitle", "time": 8896.99, "timestamp": "02:28:16", "text": "ゆっくりと、自由に感じてください"}, {"type": "subtitle", "time": 8900.309, "timestamp": "02:28:20", "text": "あなたが何を投稿するか"}, {"type": "subtitle", "time": 8902.95, "timestamp": "02:28:22", "text": "絵を描いたり何かをしたりしても感じない"}, {"type": "subtitle", "time": 8906.03, "timestamp": "02:28:26", "text": "悪い、完璧ではない、"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "音楽にも同じことが言える"}, {"type": "subtitle", "time": 8912.71, "timestamp": "02:28:32", "text": "プロデューサーは、"}, {"type": "subtitle", "time": 8915.91, "timestamp": "02:28:35", "text": "99%のプロデューサーは"}, {"type": "subtitle", "time": 8917.67, "timestamp": "02:28:37", "text": "ヒット曲をリリースするなど"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "それは、世の中でよく言われることと同じだ"}, {"type": "subtitle", "time": 8925.23, "timestamp": "02:28:45", "text": "他のジャンルでは次のように言うことができます"}, {"type": "subtitle", "time": 8930.03, "timestamp": "02:28:50", "text": "ジャンルのニッチではなく、"}, {"type": "subtitle", "time": 8939.429, "timestamp": "02:28:59", "text": "でも、そう、それは私のストリームだった、それは私の"}]
[{"type": "subtitle", "time": 13442.59, "timestamp": "03:44:02", "text": "それ。ありました"}, {"type": "subtitle", "time": 13445.63, "timestamp": "03:44:05", "text": "何かがあって、私は「ああ、これは"}, {"type": "subtitle", "time": 13448.87, "timestamp": "03:44:08", "text": "いいよ。本当に？私はそうは思わないけど。"}, {"type": "subtitle", "time": 13451.67, "timestamp": "03:44:11", "text": "私はいつでもサミーの夢を見るだろう"}, {"type": "subtitle", "time": 13454.11, "timestamp": "03:44:14", "text": "すぐ。しばらく触ってない"}, {"type": "subtitle", "time": 13456.71, "timestamp": "03:44:16", "text": "これ。えっと、それは"}, {"type": "subtitle", "time": 13458.63, "timestamp": "03:44:18", "text": "別の名前とか、何か別のこと。それは"}, {"type": "subtitle", "time": 13460.389, "timestamp": "03:44:20", "text": "おそらく別の名前で呼ばれているのでしょう。"}, {"type": "subtitle", "time": 13463.75, "timestamp": "03:44:23", "text": "ここにあるのは分かっている。ここにあるのは分かっている。なぜ"}, {"type": "subtitle", "time": 13465.79, "timestamp": "03:44:25", "text": "そうではないですか？"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "ここ？私は本当に夢を見ていたのだろうか？ああ、セット"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "隠し変数。あ、待って。ほら、ほら、私は"}, {"type": "subtitle", "time": 13474.03, "timestamp": "03:44:34", "text": "言ったでしょ"}, {"type": "subtitle", "time": 13478.309, "timestamp": "03:44:38", "text": "みんな。何てことだ。テスト。テスト。うん。見る、"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "ほら、ほら、ほら、ほら。ハッシュ化される"}, {"type": "subtitle", "time": 13483.03, "timestamp": "03:44:43", "text": "あれ。わーい。隠れた変数。これは"}, {"type": "subtitle", "time": 13490.269, "timestamp": "03:44:50", "text": "について。しかし"}, {"type": "subtitle", "time": 13493.349, "timestamp": "03:44:53", "text": "すみません。ごめんなさい。申し訳ありません。"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "でも、変数を開くと"}, {"type": "subtitle", "time": 13498.309, "timestamp": "03:44:58", "text": "窓から何かが漏れてくる"}]
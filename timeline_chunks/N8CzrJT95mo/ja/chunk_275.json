[{"type": "subtitle", "time": 16502.709, "timestamp": "04:35:02", "text": "NCMD。動画はありますか？教えてください"}, {"type": "subtitle", "time": 16504.949, "timestamp": "04:35:04", "text": "動画があります。使えません。わかった、"}, {"type": "subtitle", "time": 16506.429, "timestamp": "04:35:06", "text": "そこには"}, {"type": "subtitle", "time": 16509.629, "timestamp": "04:35:09", "text": "赤。私はしません"}, {"type": "subtitle", "time": 16513.629, "timestamp": "04:35:13", "text": "知る。えっと、タイプ"}, {"type": "subtitle", "time": 16515.31, "timestamp": "04:35:15", "text": "CD。"}, {"type": "subtitle", "time": 16520.59, "timestamp": "04:35:20", "text": "わかった。コピー"}, {"type": "subtitle", "time": 16524.629, "timestamp": "04:35:24", "text": "パス。 CD。これは、"}, {"type": "subtitle", "time": 16534.59, "timestamp": "04:35:34", "text": "えーとCD"}]
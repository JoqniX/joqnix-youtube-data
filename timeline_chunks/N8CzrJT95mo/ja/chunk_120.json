[{"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "父のような人に恋愛のアドバイスをする。ああ、でも"}, {"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "私はそれについてすごく緊張していました。私はしませんでした"}, {"type": "subtitle", "time": 7211.83, "timestamp": "02:00:11", "text": "あなたは"}, {"type": "subtitle", "time": 7216.149, "timestamp": "02:00:16", "text": "私が示しているように、両方の角です。"}, {"type": "subtitle", "time": 7218.709, "timestamp": "02:00:18", "text": "そこで私は代わりにUndertaleの文字列を作りました"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "日。"}, {"type": "subtitle", "time": 7223.189, "timestamp": "02:00:23", "text": "ああ、アンダーテール。持っています。あなたはそうしました"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "Undertaleをプレイすることを勧めてください"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "覚えて。本当に良いです。あなたがすべき"}, {"type": "subtitle", "time": 7230.75, "timestamp": "02:00:30", "text": "プレイしてください。きれいです"}, {"type": "subtitle", "time": 7238.229, "timestamp": "02:00:38", "text": "ジョック、君はどこにいるの？"}, {"type": "subtitle", "time": 7241.91, "timestamp": "02:00:41", "text": "今、ライブ配信中ですか？配信中に質問しても大丈夫ですか？"}, {"type": "subtitle", "time": 7245.109, "timestamp": "02:00:45", "text": "私は自宅に住んでいます。心配しないで。私 私"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "えーと、私が言っていた場所から引っ越しました"}, {"type": "subtitle", "time": 7252.47, "timestamp": "02:00:52", "text": "一時的に。うん。うん。これは私の"}, {"type": "subtitle", "time": 7255.109, "timestamp": "02:00:55", "text": "ストリームルーム。だから私は大きな"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "テーブルとか、そういうもの。"}]
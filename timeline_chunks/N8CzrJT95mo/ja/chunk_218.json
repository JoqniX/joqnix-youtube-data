[{"type": "subtitle", "time": 13080.429, "timestamp": "03:38:00", "text": "これは"}, {"type": "subtitle", "time": 13083.75, "timestamp": "03:38:03", "text": "埋め込み。だから、私たちは調査する必要がある"}, {"type": "subtitle", "time": 13087.269, "timestamp": "03:38:07", "text": "YouTube API、埋め込みAPIなど。"}, {"type": "subtitle", "time": 13090.469, "timestamp": "03:38:10", "text": "うん。あ、待って、シーンが違う。ええ、私たちは"}, {"type": "subtitle", "time": 13093.83, "timestamp": "03:38:13", "text": "YouTube API を使わなければならない"}, {"type": "subtitle", "time": 13096.87, "timestamp": "03:38:16", "text": "ええと、他にもいろいろ。調べなければならない"}, {"type": "subtitle", "time": 13099.59, "timestamp": "03:38:19", "text": "それ。わからない。チャットにはGPTを使用します。私"}, {"type": "subtitle", "time": 13101.469, "timestamp": "03:38:21", "text": "しないで"}, {"type": "subtitle", "time": 13104.469, "timestamp": "03:38:24", "text": "知る。私は何て言ったの？意見 100時間"}, {"type": "subtitle", "time": 13108.309, "timestamp": "03:38:28", "text": "強調すべき点。えっと、星はどこ？"}, {"type": "subtitle", "time": 13110.03, "timestamp": "03:38:30", "text": "あなたが持っている"}, {"type": "subtitle", "time": 13113.83, "timestamp": "03:38:33", "text": "待つ、それは何だったっけ？あなたはできません"}, {"type": "subtitle", "time": 13116.87, "timestamp": "03:38:36", "text": "Twitchにハイライトをアップロードしなくなりました。"}, {"type": "subtitle", "time": 13120.07, "timestamp": "03:38:40", "text": "右？ 100時間に達したら"}, {"type": "subtitle", "time": 13122.229, "timestamp": "03:38:42", "text": "制限があるので、いくつか削除する必要があります"}, {"type": "subtitle", "time": 13125.51, "timestamp": "03:38:45", "text": "昔のハイライト映像ですよね？ええ、そうですね。"}, {"type": "subtitle", "time": 13127.83, "timestamp": "03:38:47", "text": "WSをYouTubeにアップロードする必要があります。"}, {"type": "subtitle", "time": 13129.59, "timestamp": "03:38:49", "text": "彼らは文字通りTwitchは文字通り"}, {"type": "subtitle", "time": 13132.07, "timestamp": "03:38:52", "text": "すべてのTwitchストリーマーに"}, {"type": "subtitle", "time": 13138.19, "timestamp": "03:38:58", "text": "今。"}]
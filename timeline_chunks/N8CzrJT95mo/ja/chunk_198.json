[{"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "なんてこった。これはうまくいかないだろう。あなたはそうしなければならない"}, {"type": "subtitle", "time": 11887.09, "timestamp": "03:18:07", "text": "支配するために生きる"}, {"type": "subtitle", "time": 11893.49, "timestamp": "03:18:13", "text": "オビア。いいえ。"}, {"type": "subtitle", "time": 11897.87, "timestamp": "03:18:17", "text": "[笑い]"}, {"type": "subtitle", "time": 11906.63, "timestamp": "03:18:26", "text": "待って。わかった、いいよ。これは使用しません。"}, {"type": "subtitle", "time": 11909.469, "timestamp": "03:18:29", "text": "大丈夫。私はこう思った"}, {"type": "subtitle", "time": 11915.95, "timestamp": "03:18:35", "text": "[音楽]"}, {"type": "subtitle", "time": 11919.469, "timestamp": "03:18:39", "text": "手。リフレッシュします"}, {"type": "subtitle", "time": 11923.03, "timestamp": "03:18:43", "text": "あなた。よし、うまくいった。わかった。携帯"}, {"type": "subtitle", "time": 11925.99, "timestamp": "03:18:45", "text": "モバイル低モバイル。それは、それがすべてを持っていることを知っています"}, {"type": "subtitle", "time": 11928.75, "timestamp": "03:18:48", "text": "私のシーンですよね？わかった。"}, {"type": "subtitle", "time": 11933.309, "timestamp": "03:18:53", "text": "良い。だから、私が探しているのは私の"}, {"type": "subtitle", "time": 11936.469, "timestamp": "03:18:56", "text": "シーン。しかし、これは限定的なものです。いいえは"}, {"type": "subtitle", "time": 11939.83, "timestamp": "03:18:59", "text": "限定。できません。ああ、待ってください。これはただ"}]
[{"type": "subtitle", "time": 7920.189, "timestamp": "02:12:00", "text": "しかし"}, {"type": "subtitle", "time": 7923.109, "timestamp": "02:12:03", "text": "うん。私にやらせてください。私の手は"}, {"type": "subtitle", "time": 7930.85, "timestamp": "02:12:10", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 7933.91, "timestamp": "02:12:13", "text": "[音楽]"}, {"type": "subtitle", "time": 7938.709, "timestamp": "02:12:18", "text": "ジョブはよくやった。なぜこの穴は"}, {"type": "subtitle", "time": 7946.709, "timestamp": "02:12:26", "text": "私たちはすべての写真を撮るべきです"}, {"type": "subtitle", "time": 7949.43, "timestamp": "02:12:29", "text": "私たちが作った折り紙。それは私のものだけです"}, {"type": "subtitle", "time": 7951.47, "timestamp": "02:12:31", "text": "これ。"}, {"type": "subtitle", "time": 7955.43, "timestamp": "02:12:35", "text": "それから私はこれを残しました"}, {"type": "subtitle", "time": 7962.39, "timestamp": "02:12:42", "text": "それを完了させる必要がある。ああ、それはただ"}, {"type": "subtitle", "time": 7966.31, "timestamp": "02:12:46", "text": "あと20秒くらい残っています。わかった。"}, {"type": "subtitle", "time": 7968.79, "timestamp": "02:12:48", "text": "一つになるよね？いくらですか"}, {"type": "subtitle", "time": 7971.99, "timestamp": "02:12:51", "text": "また時間切れですか？それは、もう"}, {"type": "subtitle", "time": 7973.43, "timestamp": "02:12:53", "text": "ええ、2時間かかる予定です。ええ、私たちは"}, {"type": "subtitle", "time": 7976.069, "timestamp": "02:12:56", "text": "まとめられます。"}, {"type": "subtitle", "time": 7978.109, "timestamp": "02:12:58", "text": "いいえ、完了できます"}]
[{"type": "subtitle", "time": 6962.27, "timestamp": "01:56:02", "text": "[音楽]"}, {"type": "subtitle", "time": 6965.709, "timestamp": "01:56:05", "text": "うん。折り紙はどうでしたか？"}, {"type": "subtitle", "time": 6974.47, "timestamp": "01:56:14", "text": "頭痛がする。泣いています。私"}, {"type": "subtitle", "time": 6980.709, "timestamp": "01:56:20", "text": "ああ、あれは私たちがやろうとしていたものですよね？"}, {"type": "subtitle", "time": 6983.189, "timestamp": "01:56:23", "text": "それを切り落とさなければならない"}, {"type": "subtitle", "time": 6993.31, "timestamp": "01:56:33", "text": "すると誰かが「これは簡単だ」と言った。"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "簡単。はい、もう遅い時間です。私も疲れた。"}, {"type": "subtitle", "time": 7006.39, "timestamp": "01:56:46", "text": "二人とも疲れている。私は授業を受けていた"}, {"type": "subtitle", "time": 7010.47, "timestamp": "01:56:50", "text": "今日は急いで戻ってこなければならなかった"}, {"type": "subtitle", "time": 7017.75, "timestamp": "01:56:57", "text": "すべては楽しさと"}]
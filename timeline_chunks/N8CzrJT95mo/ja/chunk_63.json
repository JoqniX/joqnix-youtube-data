[{"type": "subtitle", "time": 3781.19, "timestamp": "01:03:01", "text": "ええ、やりますよ。やってますよ。私は"}, {"type": "subtitle", "time": 3782.63, "timestamp": "01:03:02", "text": "みんな、やってるよ。心配しないで。しないで"}, {"type": "subtitle", "time": 3784.43, "timestamp": "01:03:04", "text": "心配。しないで"}, {"type": "subtitle", "time": 3807.829, "timestamp": "01:03:27", "text": "ええ、私は日本の歌を演奏できます。はい、JP"}, {"type": "subtitle", "time": 3810.87, "timestamp": "01:03:30", "text": "歌。はい。はい。はい。はい。 3つ追加しました"}, {"type": "subtitle", "time": 3813.67, "timestamp": "01:03:33", "text": "私が歌いたかった新しい歌。だから私は"}, {"type": "subtitle", "time": 3816.43, "timestamp": "01:03:36", "text": "それを行うために"}, {"type": "subtitle", "time": 3818.95, "timestamp": "01:03:38", "text": "今日。ウォーミングアップをしてから、"}, {"type": "subtitle", "time": 3828.75, "timestamp": "01:03:48", "text": "わかった。"}, {"type": "subtitle", "time": 3831.349, "timestamp": "01:03:51", "text": "三つ。わかった。えーと、エイブル10。私は"}, {"type": "subtitle", "time": 3832.91, "timestamp": "01:03:52", "text": "追加"}, {"type": "subtitle", "time": 3834.89, "timestamp": "01:03:54", "text": "それ。追加します"}]
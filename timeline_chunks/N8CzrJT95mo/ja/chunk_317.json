[{"type": "subtitle", "time": 19021.11, "timestamp": "05:17:01", "text": "次の質問はプレイリストのことです"}, {"type": "subtitle", "time": 19023.11, "timestamp": "05:17:03", "text": "ビデオをランダムに入手した後"}, {"type": "subtitle", "time": 19026.628, "timestamp": "05:17:06", "text": "動画をミイジングする。プレイリストはどうですか？"}, {"type": "subtitle", "time": 19028.948, "timestamp": "05:17:08", "text": "プレイリストをランダム化して"}, {"type": "subtitle", "time": 19033.15, "timestamp": "05:17:13", "text": "シャッフルもしたの？それが問題だ。"}, {"type": "subtitle", "time": 19036.788, "timestamp": "05:17:16", "text": "右？自分がバカだってことは分かってる。知っている"}, {"type": "subtitle", "time": 19038.788, "timestamp": "05:17:18", "text": "それは簡単なことだ。私は"}, {"type": "subtitle", "time": 19042.07, "timestamp": "05:17:22", "text": "ここで何をすべきか教えてください。うん、"}, {"type": "subtitle", "time": 19044.788, "timestamp": "05:17:24", "text": "だって、私はこれを使い続けることができるから"}, {"type": "subtitle", "time": 19047.788, "timestamp": "05:17:27", "text": "これを使って乱数を生成する"}, {"type": "subtitle", "time": 19050.948, "timestamp": "05:17:30", "text": "もの。うん。待って、待って、待って。私にさせて"}, {"type": "subtitle", "time": 19053.948, "timestamp": "05:17:33", "text": "ドキュメントを確認してください"}, {"type": "subtitle", "time": 19057.59, "timestamp": "05:17:37", "text": "配列。配列はランダムです。配列はランダムです。配列"}, {"type": "subtitle", "time": 19060.39, "timestamp": "05:17:40", "text": "ランダム。わかった。ランダムな値"}, {"type": "subtitle", "time": 19062.31, "timestamp": "05:17:42", "text": "配列の内部。ディスプレイに便利"}, {"type": "subtitle", "time": 19064.788, "timestamp": "05:17:44", "text": "ランダムな画像やランダムな音、または"}, {"type": "subtitle", "time": 19067.19, "timestamp": "05:17:47", "text": "いくつか使用例を挙げてください。わかった。追加する必要がある"}, {"type": "subtitle", "time": 19070.23, "timestamp": "05:17:50", "text": "重み。同じ配列の2つ目の配列"}, {"type": "subtitle", "time": 19073.67, "timestamp": "05:17:53", "text": "えっと、待って、重さって何？値を追加する"}, {"type": "subtitle", "time": 19075.11, "timestamp": "05:17:55", "text": "体重が変わる。たまたま追加"}, {"type": "subtitle", "time": 19076.788, "timestamp": "05:17:56", "text": "ランダム化。待って、待って、待って。何ですか"}, {"type": "subtitle", "time": 19079.35, "timestamp": "05:17:59", "text": "重さ？ 2番目の配列を作成します"}]
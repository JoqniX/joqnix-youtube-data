[{"type": "subtitle", "time": 7261.27, "timestamp": "02:01:01", "text": "しかし、悲しいことに献身的だった。"}, {"type": "subtitle", "time": 7264.709, "timestamp": "02:01:04", "text": "ええ、そう言ってもいいですよ。必要がある"}, {"type": "subtitle", "time": 7268.229, "timestamp": "02:01:08", "text": "配信外で部屋を案内してください。男、"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "私は今でもジョックのことを偶然覚えている"}, {"type": "subtitle", "time": 7273.589, "timestamp": "02:01:13", "text": "電話がかかってきて、部屋を案内してくれた"}, {"type": "subtitle", "time": 7277.35, "timestamp": "02:01:17", "text": "私が頼んでもいないのに。そうそう、"}, {"type": "subtitle", "time": 7280.95, "timestamp": "02:01:20", "text": "ずいぶん昔のことですよね？何てことだ。"}, {"type": "subtitle", "time": 7284.95, "timestamp": "02:01:24", "text": "彼はちょうど目を覚ましたところだった。"}, {"type": "subtitle", "time": 7302.669, "timestamp": "02:01:42", "text": "うん。ここを案内するべきだ"}, {"type": "subtitle", "time": 7305.91, "timestamp": "02:01:45", "text": "ページ。今のところ、誰もこれをレンダリングしていません。"}, {"type": "subtitle", "time": 7310.07, "timestamp": "02:01:50", "text": "他の部屋。ええ、そうですね。えっと"}, {"type": "subtitle", "time": 7312.91, "timestamp": "02:01:52", "text": "上部エリアは"}, {"type": "subtitle", "time": 7315.35, "timestamp": "02:01:55", "text": "改装済み。そう、私たちは探しています"}, {"type": "subtitle", "time": 7318.91, "timestamp": "02:01:58", "text": "新しい人が来てその職に就く"}]
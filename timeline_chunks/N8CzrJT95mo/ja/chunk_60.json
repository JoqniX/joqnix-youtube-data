[{"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "[音楽]"}, {"type": "subtitle", "time": 3622.39, "timestamp": "01:00:22", "text": "終わり。私はインド人をめったに見かけない。私は"}, {"type": "subtitle", "time": 3625.91, "timestamp": "01:00:25", "text": "このプラットフォームでインド出身は私一人だけ"}, {"type": "subtitle", "time": 3628.39, "timestamp": "01:00:28", "text": "だって、今では本当に珍しいことだから。"}, {"type": "subtitle", "time": 3631.19, "timestamp": "01:00:31", "text": "インドのVTuber側からは誰も望んでいない"}, {"type": "subtitle", "time": 3633.47, "timestamp": "01:00:33", "text": "ビリーのところに来る"}, {"type": "subtitle", "time": 3636.27, "timestamp": "01:00:36", "text": "いじめっ子。しかし私は"}, {"type": "subtitle", "time": 3639.349, "timestamp": "01:00:39", "text": "機会。私はチャンスを与えられ、"}, {"type": "subtitle", "time": 3643.109, "timestamp": "01:00:43", "text": "ここで配信するのはずっと私の夢でした"}, {"type": "subtitle", "time": 3646.87, "timestamp": "01:00:46", "text": "ここで配信できてよかったです。"}, {"type": "subtitle", "time": 3649.3, "timestamp": "01:00:49", "text": "しかし、私はまだ多くのことを学んでいます"}, {"type": "subtitle", "time": 3650.99, "timestamp": "01:00:50", "text": "[音楽]"}, {"type": "subtitle", "time": 3654.67, "timestamp": "01:00:54", "text": "プラットフォーム。私は"}]
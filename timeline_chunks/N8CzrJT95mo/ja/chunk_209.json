[{"type": "subtitle", "time": 12541.11, "timestamp": "03:29:01", "text": "スタジオのやつは、そこに"}, {"type": "subtitle", "time": 12544.63, "timestamp": "03:29:04", "text": "これは、"}, {"type": "subtitle", "time": 12545.71, "timestamp": "03:29:05", "text": "ドア"}, {"type": "subtitle", "time": 12548.429, "timestamp": "03:29:08", "text": "面前。お見せしましょう。"}, {"type": "subtitle", "time": 12551.07, "timestamp": "03:29:11", "text": "えっと、ドアっていうものがあるんだけど"}, {"type": "subtitle", "time": 12554.99, "timestamp": "03:29:14", "text": "面前。えっと、この金持ちにとっては"}, {"type": "subtitle", "time": 12558.63, "timestamp": "03:29:18", "text": "AbletonやFLのような存在感を持つことができます"}, {"type": "subtitle", "time": 12561.91, "timestamp": "03:29:21", "text": "スタジオとかが何であれ現れる"}, {"type": "subtitle", "time": 12564.15, "timestamp": "03:29:24", "text": "あなたが取り組んでいるプロジェクト。それは、"}, {"type": "subtitle", "time": 12567.19, "timestamp": "03:29:27", "text": "あなたはAbleton LiveまたはFL Studioを使用しています"}, {"type": "subtitle", "time": 12568.87, "timestamp": "03:29:28", "text": "この作業に何年間取り組んでいますか"}, {"type": "subtitle", "time": 12571.99, "timestamp": "03:29:31", "text": "時間など、そんな感じです。だから私はリッチ"}, {"type": "subtitle", "time": 12573.469, "timestamp": "03:29:33", "text": "私は"}, {"type": "subtitle", "time": 12577.269, "timestamp": "03:29:37", "text": "これ。つまり、それはむしろ、"}, {"type": "subtitle", "time": 12581.349, "timestamp": "03:29:41", "text": "あのリッチな存在感とFL"}, {"type": "subtitle", "time": 12590.59, "timestamp": "03:29:50", "text": "ファイル。うん。わかった。"}, {"type": "subtitle", "time": 12593.429, "timestamp": "03:29:53", "text": "えっと、神様、それはどこにあるんですか？見つけることすらできない"}, {"type": "subtitle", "time": 12597.95, "timestamp": "03:29:57", "text": "そうだよ、男。えーっと、要約すると"}]
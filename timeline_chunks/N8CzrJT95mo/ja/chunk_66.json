[{"type": "subtitle", "time": 3963.51, "timestamp": "01:06:03", "text": "星。リンって。リンって。"}, {"type": "subtitle", "time": 3967.99, "timestamp": "01:06:07", "text": "トラックの色を割り当てて、1つ承認します"}, {"type": "subtitle", "time": 3970.91, "timestamp": "01:06:10", "text": "あと３人"}, {"type": "subtitle", "time": 3973.87, "timestamp": "01:06:13", "text": "上、これは"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "それは楽器です、それは完全な"}, {"type": "subtitle", "time": 3978.349, "timestamp": "01:06:18", "text": "曲なので、それを入れなければなりません"}, {"type": "subtitle", "time": 3992.87, "timestamp": "01:06:32", "text": "1つ、うん、これ、これ、これ、うん"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "あなたはここにいるでしょう。はい、"}, {"type": "subtitle", "time": 3998.829, "timestamp": "01:06:38", "text": "問題。なぜそれが"}, {"type": "subtitle", "time": 4001.109, "timestamp": "01:06:41", "text": "短い？はい、これは違います。その"}, {"type": "subtitle", "time": 4003.43, "timestamp": "01:06:43", "text": "間違った方です。どうでも。これです。は"}, {"type": "subtitle", "time": 4005.71, "timestamp": "01:06:45", "text": "君こそがその人か？"}, {"type": "subtitle", "time": 4010.43, "timestamp": "01:06:50", "text": "はい。こんにちは。つまり、これら2つは外部を選択する"}, {"type": "subtitle", "time": 4015.789, "timestamp": "01:06:55", "text": "外。最後の曲はスピーカーから流します。 3"}]
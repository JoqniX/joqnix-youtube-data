[{"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "待って、待って、待って、待って、待って。どこ"}, {"type": "subtitle", "time": 3913.63, "timestamp": "01:05:13", "text": "星？"}, {"type": "subtitle", "time": 3916.789, "timestamp": "01:05:16", "text": "待って。オレンジ色の星はどこにありますか？待って。オレンジ"}, {"type": "subtitle", "time": 3919.549, "timestamp": "01:05:19", "text": "星。アリス。ああ、アリス。"}, {"type": "subtitle", "time": 3924.349, "timestamp": "01:05:24", "text": "わかった。これです。わかった。つまり、これは"}, {"type": "subtitle", "time": 3928.589, "timestamp": "01:05:28", "text": "ダブルクリックして外部へ送信"}, {"type": "subtitle", "time": 3931.51, "timestamp": "01:05:31", "text": "外。最初のインストゥルメンタルが送信されます"}, {"type": "subtitle", "time": 3934.549, "timestamp": "01:05:34", "text": "OBSに報告すれば、これは私の責任になります。それで"}, {"type": "subtitle", "time": 3936.51, "timestamp": "01:05:36", "text": "次のようなことが聞こえてくるでしょう"}, {"type": "subtitle", "time": 3939.069, "timestamp": "01:05:39", "text": "これ。正しい。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "右。わかった。動作するはずです。"}, {"type": "subtitle", "time": 3944.109, "timestamp": "01:05:44", "text": "それは"}, {"type": "subtitle", "time": 3950.91, "timestamp": "01:05:50", "text": "それ。そして私は行く"}, {"type": "subtitle", "time": 3954.109, "timestamp": "01:05:54", "text": "置く"}, {"type": "subtitle", "time": 3956.589, "timestamp": "01:05:56", "text": "これを超える"}, {"type": "subtitle", "time": 3958.99, "timestamp": "01:05:58", "text": "ここ。オレンジ"}]
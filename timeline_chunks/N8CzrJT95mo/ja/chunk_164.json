[{"type": "subtitle", "time": 9840.67, "timestamp": "02:44:00", "text": "どれが"}, {"type": "subtitle", "time": 9843.429, "timestamp": "02:44:03", "text": "どれの？指定されたプログラム時間。お願いします"}, {"type": "subtitle", "time": 9846.309, "timestamp": "02:44:06", "text": "公式ウェブサイトで時刻表を確認してください"}, {"type": "subtitle", "time": 9849.07, "timestamp": "02:44:09", "text": "詳細についてはウェブサイトをご覧ください"}, {"type": "subtitle", "time": 9852.71, "timestamp": "02:44:12", "text": "詳細。ああ、まるで本物の"}, {"type": "subtitle", "time": 9855.03, "timestamp": "02:44:15", "text": "トゥモローランド・ウルトラ・ミュージック・フェスティバルのような"}, {"type": "subtitle", "time": 9858.15, "timestamp": "02:44:18", "text": "コンサートの。複数の異なる"}, {"type": "subtitle", "time": 9860.95, "timestamp": "02:44:20", "text": "世界の舞台で、状況に応じて切り替えます"}, {"type": "subtitle", "time": 9863.91, "timestamp": "02:44:23", "text": "あなたが観るのが好きなアーティストと"}, {"type": "subtitle", "time": 9876.59, "timestamp": "02:44:36", "text": "何？私はとても興味があります"}, {"type": "subtitle", "time": 9878.99, "timestamp": "02:44:38", "text": "今。"}, {"type": "subtitle", "time": 9882.63, "timestamp": "02:44:42", "text": "待って、本当に見たい"}, {"type": "subtitle", "time": 9889.19, "timestamp": "02:44:49", "text": "上。サンリオ公式サイト。わかった。サンリオ"}, {"type": "subtitle", "time": 9892.19, "timestamp": "02:44:52", "text": "音楽祭。何てことだ。何が"}, {"type": "subtitle", "time": 9893.71, "timestamp": "02:44:53", "text": "これ？"}, {"type": "subtitle", "time": 9895.79, "timestamp": "02:44:55", "text": "えっと、これは何ですか？"}, {"type": "subtitle", "time": 9898.349, "timestamp": "02:44:58", "text": "ディーゼル。"}]
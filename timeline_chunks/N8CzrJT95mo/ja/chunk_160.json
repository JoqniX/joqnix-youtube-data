[{"type": "subtitle", "time": 9601.19, "timestamp": "02:40:01", "text": "ストリーム。うん。えっと、私はまさにそれです"}, {"type": "subtitle", "time": 9604.469, "timestamp": "02:40:04", "text": "熱が出始めているような感じだが"}, {"type": "subtitle", "time": 9606.79, "timestamp": "02:40:06", "text": "私は薬などを飲んだ"}, {"type": "subtitle", "time": 9609.19, "timestamp": "02:40:09", "text": "昨日。私はちゃんと休んだ。今日の"}, {"type": "subtitle", "time": 9613.349, "timestamp": "02:40:13", "text": "配信はあまりやりすぎないようにします。"}, {"type": "subtitle", "time": 9615.71, "timestamp": "02:40:15", "text": "わかった。こんにちは。こんにちは。さあ"}, {"type": "subtitle", "time": 9618.15, "timestamp": "02:40:18", "text": "スイッチ。新しい変化を気に入っていただけると嬉しいです"}, {"type": "subtitle", "time": 9622.91, "timestamp": "02:40:22", "text": "持っている。うん。"}, {"type": "subtitle", "time": 9625.63, "timestamp": "02:40:25", "text": "チャット。わかりますか？"}, {"type": "subtitle", "time": 9646.349, "timestamp": "02:40:46", "text": "こんにちは。あ、待って。何が"}, {"type": "subtitle", "time": 9650.03, "timestamp": "02:40:50", "text": "これ？矢印は"}, {"type": "subtitle", "time": 9652.03, "timestamp": "02:40:52", "text": "あなたの"}, {"type": "subtitle", "time": 9656.15, "timestamp": "02:40:56", "text": "叔父。使用。ああ、こんにちは、キティちゃん。 3段"}]
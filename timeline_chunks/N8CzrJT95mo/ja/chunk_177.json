[{"type": "subtitle", "time": 10628.63, "timestamp": "02:57:08", "text": "この子に夢中だ。ああ、その話題は"}, {"type": "subtitle", "time": 10631.79, "timestamp": "02:57:11", "text": "みんな、助けて"}, {"type": "subtitle", "time": 10636.07, "timestamp": "02:57:16", "text": "あの、みんな、助けて。私たちにはどんな習慣がありますか？"}, {"type": "subtitle", "time": 10638.99, "timestamp": "02:57:18", "text": "バレンタインデーにインドで"}, {"type": "subtitle", "time": 10641.269, "timestamp": "02:57:21", "text": "日？どのような慣習がありますか？"}, {"type": "subtitle", "time": 10644.15, "timestamp": "02:57:24", "text": "インドのバレンタインデー？やってみます"}, {"type": "subtitle", "time": 10648.07, "timestamp": "02:57:28", "text": "PDに入れて、それについて話す"}, {"type": "subtitle", "time": 10663.91, "timestamp": "02:57:43", "text": "あの、お元気ですか？元気です。えっと、私は"}, {"type": "subtitle", "time": 10666.63, "timestamp": "02:57:46", "text": "喉の痛みが治るような感じ。"}, {"type": "subtitle", "time": 10670.389, "timestamp": "02:57:50", "text": "また、それはある意味、"}, {"type": "subtitle", "time": 10674.67, "timestamp": "02:57:54", "text": "熱があるけど、幸いまだ"}, {"type": "subtitle", "time": 10677.51, "timestamp": "02:57:57", "text": "回復中なので、必ず水分補給をしなければなりません"}, {"type": "subtitle", "time": 10679.63, "timestamp": "02:57:59", "text": "水"}]
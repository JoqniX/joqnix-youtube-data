[{"type": "subtitle", "time": 8285.11, "timestamp": "02:18:05", "text": "ああ、なんてことだ。私もやらせてください。"}, {"type": "subtitle", "time": 8291.15, "timestamp": "02:18:11", "text": "削除させてください"}, {"type": "subtitle", "time": 8298.15, "timestamp": "02:18:18", "text": "こんにちは、マット。次の配信はいつですか？うん。"}, {"type": "subtitle", "time": 8301.03, "timestamp": "02:18:21", "text": "次の配信はいつですか？わかった。"}, {"type": "subtitle", "time": 8304.48, "timestamp": "02:18:24", "text": "えっと、木曜日の私のスケジュールを見てください。"}, {"type": "subtitle", "time": 8306.87, "timestamp": "02:18:26", "text": "[音楽]"}, {"type": "subtitle", "time": 8309.91, "timestamp": "02:18:29", "text": "お弁当に入っていて、"}, {"type": "subtitle", "time": 8312.669, "timestamp": "02:18:32", "text": "パズルフードのような"}, {"type": "subtitle", "time": 8315.509, "timestamp": "02:18:35", "text": "ゲームと"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "ただ雑談しているだけです。さあ行こう。わかった。えっと、君"}]
[{"type": "subtitle", "time": 20898.788, "timestamp": "05:48:18", "text": "はい、戻ってきました。母から電話があった。彼らは"}, {"type": "subtitle", "time": 20908.548, "timestamp": "05:48:28", "text": "わかった。だから、これが私がやらなければならないことだ。えっと、"}, {"type": "subtitle", "time": 20910.548, "timestamp": "05:48:30", "text": "わかった。自動再生を設定し、"}, {"type": "subtitle", "time": 20913.23, "timestamp": "05:48:33", "text": "本物、"}, {"type": "subtitle", "time": 20915.99, "timestamp": "05:48:35", "text": "右？自動再生を有効にするには料金を支払う必要があります"}, {"type": "subtitle", "time": 20918.948, "timestamp": "05:48:38", "text": "本物だ。そして私たちは"}, {"type": "subtitle", "time": 20921.35, "timestamp": "05:48:41", "text": "ビデオID 1、2、3みたいなやつですよね？"}, {"type": "subtitle", "time": 20923.868, "timestamp": "05:48:43", "text": "それもまた然り。"}, {"type": "subtitle", "time": 20926.03, "timestamp": "05:48:46", "text": "それで"}, {"type": "subtitle", "time": 20930.15, "timestamp": "05:48:50", "text": "これを埋め込み、その後"}, {"type": "subtitle", "time": 20932.91, "timestamp": "05:48:52", "text": "質問である"}, {"type": "subtitle", "time": 20937.47, "timestamp": "05:48:57", "text": "プレイリストに疑問符を付ける"}]
[{"type": "subtitle", "time": 8400.389, "timestamp": "02:20:00", "text": "私はただ頭を休ませたいだけです"}, {"type": "subtitle", "time": 8404.27, "timestamp": "02:20:04", "text": "さあ、机に向かいましょう。うん。"}, {"type": "subtitle", "time": 8406.95, "timestamp": "02:20:06", "text": "バイバイ。こんにちは。"}, {"type": "subtitle", "time": 8411.79, "timestamp": "02:20:11", "text": "できる。良い"}, {"type": "subtitle", "time": 8414.79, "timestamp": "02:20:14", "text": "夜。最後に、"}, {"type": "subtitle", "time": 8417.349, "timestamp": "02:20:17", "text": "ありがとう。"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "わかった。ここから立ち去るべきでしょうか？えっと"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "うん。最後に何か言いたいことはありますか？"}, {"type": "subtitle", "time": 8426.07, "timestamp": "02:20:26", "text": "出発前に？私を殺してください。何？"}, {"type": "subtitle", "time": 8435.349, "timestamp": "02:20:35", "text": "うん、スズクを購読してね。私は"}, {"type": "subtitle", "time": 8439.11, "timestamp": "02:20:39", "text": "今週はCRの配信が多かった。はい、"}, {"type": "subtitle", "time": 8441.59, "timestamp": "02:20:41", "text": "購読する。"}, {"type": "subtitle", "time": 8443.67, "timestamp": "02:20:43", "text": "ああ、紙のブレスレットはとても"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "美しい。どれ？"}, {"type": "subtitle", "time": 8455.07, "timestamp": "02:20:55", "text": "そうそう。"}, {"type": "subtitle", "time": 8456.91, "timestamp": "02:20:56", "text": "蝶。それ"}]
[{"type": "subtitle", "time": 8702.59, "timestamp": "02:25:02", "text": "良い経験になるもの、"}, {"type": "subtitle", "time": 8710.63, "timestamp": "02:25:10", "text": "だから、ええと、私は気をつけます"}, {"type": "subtitle", "time": 8715.03, "timestamp": "02:25:15", "text": "次の日本語レビューまたは"}, {"type": "subtitle", "time": 8717.309, "timestamp": "02:25:17", "text": "絶え間なく続く流れのように。良い、"}, {"type": "subtitle", "time": 8719.83, "timestamp": "02:25:19", "text": "ストリーミングで確認するだけです。ええ、私は"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "明日配信してみます。えっと、私は"}, {"type": "subtitle", "time": 8725.55, "timestamp": "02:25:25", "text": "オフライン授業。たぶん、私は"}, {"type": "subtitle", "time": 8730.87, "timestamp": "02:25:30", "text": "正午。午前3時4分、いや午後3時4分。見てみましょう"}, {"type": "subtitle", "time": 8733.63, "timestamp": "02:25:33", "text": "配信できます。うん、できるかどうか見てみよう"}, {"type": "subtitle", "time": 8737.63, "timestamp": "02:25:37", "text": "ストリーム。配信してみたいです。"}, {"type": "subtitle", "time": 8740.349, "timestamp": "02:25:40", "text": "はい。では、"}, {"type": "subtitle", "time": 8749.389, "timestamp": "02:25:49", "text": "今日。机を掃除しなければならなかった。"}, {"type": "subtitle", "time": 8752.23, "timestamp": "02:25:52", "text": "特に机を掃除しなければならなかったので"}, {"type": "subtitle", "time": 8752.69, "timestamp": "02:25:52", "text": "多くの"}, {"type": "subtitle", "time": 8754.11, "timestamp": "02:25:54", "text": "[音楽]"}, {"type": "subtitle", "time": 8756.63, "timestamp": "02:25:56", "text": "今日。もしそれが黒なら"}]
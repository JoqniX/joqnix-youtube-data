[{"type": "subtitle", "time": 12600.349, "timestamp": "03:30:00", "text": "コラボ"}, {"type": "subtitle", "time": 12603.87, "timestamp": "03:30:03", "text": "リスト。このモバイル部隊は違う。"}, {"type": "subtitle", "time": 12606.87, "timestamp": "03:30:06", "text": "ストリームの戻りはありません。それはこの辺りのどこかにある。私"}, {"type": "subtitle", "time": 12608.83, "timestamp": "03:30:08", "text": "見つかりません"}, {"type": "subtitle", "time": 12611.429, "timestamp": "03:30:11", "text": "それ。いや、待って。そこから検索できます"}, {"type": "subtitle", "time": 12614.79, "timestamp": "03:30:14", "text": "アクティブなボタン。いや、いや。誰か"}, {"type": "subtitle", "time": 12617.63, "timestamp": "03:30:17", "text": "タイプ？私が打ち込みます。"}, {"type": "subtitle", "time": 12621.83, "timestamp": "03:30:21", "text": "はぁ？テスト。わかった。わかった。わかった。えっと、アバター"}, {"type": "subtitle", "time": 12624.07, "timestamp": "03:30:24", "text": "ペット。いいえ、チャットオブジェクトです。チャットオブジェクト。"}, {"type": "subtitle", "time": 12629.79, "timestamp": "03:30:29", "text": "歓迎チャットオブジェクト。わかった。チャット"}, {"type": "subtitle", "time": 12631.79, "timestamp": "03:30:31", "text": "物体。"}, {"type": "subtitle", "time": 12638.03, "timestamp": "03:30:38", "text": "えっと、チャット。チャットチャットコントロール。それで、ああ"}, {"type": "subtitle", "time": 12641.309, "timestamp": "03:30:41", "text": "待って。あ、待って。できました"}, {"type": "subtitle", "time": 12649.91, "timestamp": "03:30:49", "text": "[音楽]"}, {"type": "subtitle", "time": 12652.55, "timestamp": "03:30:52", "text": "ペットは実際に効果があるでしょう。えっと、編集"}, {"type": "subtitle", "time": 12654.469, "timestamp": "03:30:54", "text": "コマンド。うん、これは実際"}, {"type": "subtitle", "time": 12657.59, "timestamp": "03:30:57", "text": "仕事。 TwitchやYouTubeがあります。"}]
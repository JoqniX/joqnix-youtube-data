[{"type": "subtitle", "time": 15840.79, "timestamp": "04:24:00", "text": "空白？ねえ、なんで空白なの？すみません。"}, {"type": "subtitle", "time": 15842.189, "timestamp": "04:24:02", "text": "なぜ"}, {"type": "subtitle", "time": 15845.03, "timestamp": "04:24:05", "text": "空白？なぜ空白ではないのですか？待って、なぜ"}, {"type": "subtitle", "time": 15846.269, "timestamp": "04:24:06", "text": "それは"}, {"type": "subtitle", "time": 15867.99, "timestamp": "04:24:27", "text": "けれど？おお。ああ、うまくいった。見る？待って、"}, {"type": "subtitle", "time": 15869.79, "timestamp": "04:24:29", "text": "待って、待って、"}, {"type": "subtitle", "time": 15872.309, "timestamp": "04:24:32", "text": "待って。電話をアップロードします。待って。いや、いや、いや、"}, {"type": "subtitle", "time": 15877.83, "timestamp": "04:24:37", "text": "待って。私はストリームに参加していますが、"}, {"type": "subtitle", "time": 15879.269, "timestamp": "04:24:39", "text": "ここでチャージできる電話アカウント。"}, {"type": "subtitle", "time": 15888.91, "timestamp": "04:24:48", "text": "私たちはこれを解決する必要がある。"}]
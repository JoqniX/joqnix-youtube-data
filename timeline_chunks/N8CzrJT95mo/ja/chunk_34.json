[{"type": "subtitle", "time": 2042.95, "timestamp": "00:34:02", "text": "Twitch、私の配信は1回停止します"}, {"type": "subtitle", "time": 2045.47, "timestamp": "00:34:05", "text": "2番目で、またオンになります"}, {"type": "subtitle", "time": 2048.99, "timestamp": "00:34:08", "text": "また、もう"}, {"type": "subtitle", "time": 2054.03, "timestamp": "00:34:14", "text": "えっと、もう47歳です"}, {"type": "subtitle", "time": 2061.75, "timestamp": "00:34:21", "text": "正しい。ええ、47時間60分です。えっと"}, {"type": "subtitle", "time": 2064.869, "timestamp": "00:34:24", "text": "あっという間に過ぎてしまうだろうし、"}, {"type": "subtitle", "time": 2067.589, "timestamp": "00:34:27", "text": "気づきもしないだろう。だから、私はただ"}, {"type": "subtitle", "time": 2094.95, "timestamp": "00:34:54", "text": "忘れた。それは切断保護機能です。"}, {"type": "subtitle", "time": 2098.069, "timestamp": "00:34:58", "text": "そんなことがあったなんて、すっかり忘れてたよ。何てことだ。"}, {"type": "subtitle", "time": 2099.23, "timestamp": "00:34:59", "text": "わかった、"}]
[{"type": "subtitle", "time": 3721.47, "timestamp": "01:02:01", "text": "に"}, {"type": "subtitle", "time": 3724.069, "timestamp": "01:02:04", "text": "選ぶ。私は選択するのが苦手だ。まるで"}, {"type": "subtitle", "time": 3725.75, "timestamp": "01:02:05", "text": "あなたは「お母さんが好きですか」と言っている"}, {"type": "subtitle", "time": 3733.349, "timestamp": "01:02:13", "text": "\"両方。\"毎回それを受け取る"}, {"type": "subtitle", "time": 3745.25, "timestamp": "01:02:25", "text": "あなたに欲しいものがある"}, {"type": "subtitle", "time": 3756.58, "timestamp": "01:02:36", "text": "決定的。私は「いいえ」と答えた。"}]
[{"type": "subtitle", "time": 18371.55, "timestamp": "05:06:11", "text": "指示。それは"}, {"type": "subtitle", "time": 18382.75, "timestamp": "05:06:22", "text": "こんなに時間がかかるのは普通ですか？"}, {"type": "subtitle", "time": 18385.15, "timestamp": "05:06:25", "text": "多くの"}, {"type": "subtitle", "time": 18388.708, "timestamp": "05:06:28", "text": "時間？もしそうなら、一体どうして私は"}, {"type": "subtitle", "time": 18392.27, "timestamp": "05:06:32", "text": "それを動作させるはず"}, {"type": "subtitle", "time": 18403.67, "timestamp": "05:06:43", "text": "[音楽]"}, {"type": "subtitle", "time": 18405.67, "timestamp": "05:06:45", "text": "もっと良い方法を考えなければならない。"}, {"type": "subtitle", "time": 18407.91, "timestamp": "05:06:47", "text": "実際、みんな、私は考えなければならない"}, {"type": "subtitle", "time": 18411.15, "timestamp": "05:06:51", "text": "もっと良い方法がある。それはうまくいかないだろう"}]
[{"type": "subtitle", "time": 13207.349, "timestamp": "03:40:07", "text": "クロック。ああ、わかった。時間があります。そして"}, {"type": "subtitle", "time": 13213.51, "timestamp": "03:40:13", "text": "これ？えーと、どのポジションか教えてください"}, {"type": "subtitle", "time": 13216.87, "timestamp": "03:40:16", "text": "作品。わかった。下に隠しておいた方がいいですか？"}, {"type": "subtitle", "time": 13220.79, "timestamp": "03:40:20", "text": "そこには？えっと、横に置いておくこともできます。"}, {"type": "subtitle", "time": 13226.95, "timestamp": "03:40:26", "text": "これ。うん、それでいいよ。右。あなたは"}, {"type": "subtitle", "time": 13230.229, "timestamp": "03:40:30", "text": "時間を見てください。少し見えにくいです。"}, {"type": "subtitle", "time": 13241.349, "timestamp": "03:40:41", "text": "時間？えっと、午前2時38分です。ああ、2時38分ですね。"}, {"type": "subtitle", "time": 13244.87, "timestamp": "03:40:44", "text": "午前中、あなたのために。ああ、午後18時だ。"}, {"type": "subtitle", "time": 13246.75, "timestamp": "03:40:46", "text": "のために"}, {"type": "subtitle", "time": 13249.309, "timestamp": "03:40:49", "text": "自分。"}, {"type": "subtitle", "time": 13251.99, "timestamp": "03:40:51", "text": "こんにちは。よし、それではこれから"}, {"type": "subtitle", "time": 13254.55, "timestamp": "03:40:54", "text": "今日やるべきこと。えっと、なぜこれを閉じられないのでしょうか？おお"}]
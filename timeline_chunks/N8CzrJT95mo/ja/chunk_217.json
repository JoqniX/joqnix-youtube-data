[{"type": "subtitle", "time": 13021.429, "timestamp": "03:37:01", "text": "私の昔のWSのガチャとすべて正しい"}, {"type": "subtitle", "time": 13022.269, "timestamp": "03:37:02", "text": "これ"}, {"type": "subtitle", "time": 13026.87, "timestamp": "03:37:06", "text": "1つ。交代させてください。今日私たちが"}, {"type": "subtitle", "time": 13029.03, "timestamp": "03:37:09", "text": "これからやることは、"}, {"type": "subtitle", "time": 13033.59, "timestamp": "03:37:13", "text": "睡眠シーンについても同様です。これ"}, {"type": "subtitle", "time": 13035.67, "timestamp": "03:37:15", "text": "1つ。あ、待って、これまだ動いてる。させて"}, {"type": "subtitle", "time": 13036.59, "timestamp": "03:37:16", "text": "私、一時停止"}, {"type": "subtitle", "time": 13039.75, "timestamp": "03:37:19", "text": "それ。えっと、待って。これを"}, {"type": "subtitle", "time": 13043.429, "timestamp": "03:37:23", "text": "ランダムガチャも。さらに、"}, {"type": "subtitle", "time": 13045.99, "timestamp": "03:37:25", "text": "ストリームが終了しました。"}, {"type": "subtitle", "time": 13048.71, "timestamp": "03:37:28", "text": "プレイリスト内の次のストリーム。だから、もしあなたが"}, {"type": "subtitle", "time": 13051.67, "timestamp": "03:37:31", "text": "ご覧のとおり、これは"}, {"type": "subtitle", "time": 13054.389, "timestamp": "03:37:34", "text": "プレイリストですよね？これはチャンネルです"}, {"type": "subtitle", "time": 13057.19, "timestamp": "03:37:37", "text": "プレイリストですよね？そこにはすべてが揃っている"}, {"type": "subtitle", "time": 13060.15, "timestamp": "03:37:40", "text": "再生リスト内のストリームですよね？だから私は"}, {"type": "subtitle", "time": 13063.83, "timestamp": "03:37:43", "text": "祖母が"}, {"type": "subtitle", "time": 13066.87, "timestamp": "03:37:46", "text": "ビデオは、例えば次のようなビデオのように表示されます。"}, {"type": "subtitle", "time": 13069.429, "timestamp": "03:37:49", "text": "昨年の配信映像が表示されます"}, {"type": "subtitle", "time": 13073.429, "timestamp": "03:37:53", "text": "画面のこちらです。私も"}, {"type": "subtitle", "time": 13076.55, "timestamp": "03:37:56", "text": "同様のストリームを追加するか、残りの"}, {"type": "subtitle", "time": 13078.79, "timestamp": "03:37:58", "text": "ストリームをプレイリストで再生する"}]
[{"type": "subtitle", "time": 5956.229, "timestamp": "01:39:16", "text": "正しい線です。私はそれを作らなければならない"}, {"type": "subtitle", "time": 5962.39, "timestamp": "01:39:22", "text": "ええ、そのスピードアップの部分は"}, {"type": "subtitle", "time": 5969.39, "timestamp": "01:39:29", "text": "では、次は"}, {"type": "subtitle", "time": 5982.27, "timestamp": "01:39:42", "text": "歌。チャンをやりたい"}, {"type": "subtitle", "time": 5984.95, "timestamp": "01:39:44", "text": "歌。カバーし始めて以来"}, {"type": "subtitle", "time": 5988.39, "timestamp": "01:39:48", "text": "カファンの歌、私は止められない。私は私は私は"}, {"type": "subtitle", "time": 5991.03, "timestamp": "01:39:51", "text": "曲が大好きだよ。よし。"}]
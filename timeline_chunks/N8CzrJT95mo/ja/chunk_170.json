[{"type": "subtitle", "time": 10205.95, "timestamp": "02:50:05", "text": "次。そして、眠そうな騎手を追加しました"}, {"type": "subtitle", "time": 10208.75, "timestamp": "02:50:08", "text": "1つとホットドッグ"}, {"type": "subtitle", "time": 10211.95, "timestamp": "02:50:11", "text": "1つとナムノム"}, {"type": "subtitle", "time": 10215.469, "timestamp": "02:50:15", "text": "1つ。うん、追加したよ"}, {"type": "subtitle", "time": 10219.07, "timestamp": "02:50:19", "text": "すべて。見て、それは"}, {"type": "subtitle", "time": 10224.07, "timestamp": "02:50:24", "text": "自分。ああ、こんにちは、お母さん。こんにちは。こんにちは。アワム。"}, {"type": "subtitle", "time": 10226.07, "timestamp": "02:50:26", "text": "良い。こんにちは。待って。良い"}, {"type": "subtitle", "time": 10228.91, "timestamp": "02:50:28", "text": "夕方。ハッピー"}, {"type": "subtitle", "time": 10231.349, "timestamp": "02:50:31", "text": "日曜日。楽しい日曜日を。私たちは"}, {"type": "subtitle", "time": 10233.91, "timestamp": "02:50:33", "text": "ニフンガの世界に参加しよう。私たちは"}, {"type": "subtitle", "time": 10238.91, "timestamp": "02:50:38", "text": "少し後にイベントに参加するのですが、それは"}, {"type": "subtitle", "time": 10243.269, "timestamp": "02:50:43", "text": "1つ。ええ、このイベントに参加します"}, {"type": "subtitle", "time": 10246.63, "timestamp": "02:50:46", "text": "そして、今日のテーマが決まりました。えっと、どこ"}, {"type": "subtitle", "time": 10252.15, "timestamp": "02:50:52", "text": "それ？これですよね？どんなカスタム"}, {"type": "subtitle", "time": 10253.67, "timestamp": "02:50:53", "text": "あなたの国にはどのような習慣がありますか？"}, {"type": "subtitle", "time": 10256.469, "timestamp": "02:50:56", "text": "バレンタインデーに？私は準備する必要がある"}]
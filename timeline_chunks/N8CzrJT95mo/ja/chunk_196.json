[{"type": "subtitle", "time": 11760.79, "timestamp": "03:16:00", "text": "ペップ、いや、違う、ごめん、えっと、何て言ってたっけ"}, {"type": "subtitle", "time": 11763.07, "timestamp": "03:16:03", "text": "そんな風に、私は知らない"}, {"type": "subtitle", "time": 11777.63, "timestamp": "03:16:17", "text": "わかった"}, {"type": "subtitle", "time": 11784.19, "timestamp": "03:16:24", "text": "えっと、そこに"}, {"type": "subtitle", "time": 11797.15, "timestamp": "03:16:37", "text": "えっと、これは誰にも教えないでください。わかった。"}, {"type": "subtitle", "time": 11799.79, "timestamp": "03:16:39", "text": "それで"}, {"type": "subtitle", "time": 11802.71, "timestamp": "03:16:42", "text": "だから、私が何をしようとしているか分かるよね？私"}, {"type": "subtitle", "time": 11805.03, "timestamp": "03:16:45", "text": "できないの？ぼかしたから"}, {"type": "subtitle", "time": 11808.07, "timestamp": "03:16:48", "text": "見せないことが重要だ。したくない"}, {"type": "subtitle", "time": 11813.95, "timestamp": "03:16:53", "text": "私の作戦に関する情報を漏洩する。えっと、できません"}, {"type": "subtitle", "time": 11817.11, "timestamp": "03:16:57", "text": "えーっと、新しいシーンを作らないといけないよね？"}]
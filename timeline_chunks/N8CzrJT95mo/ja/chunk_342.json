[{"type": "subtitle", "time": 20520.628, "timestamp": "05:42:00", "text": "シャッフルしたいし、全部欲しい"}, {"type": "subtitle", "time": 20523.868, "timestamp": "05:42:03", "text": "それらのものをそれぞれhに分けました"}, {"type": "subtitle", "time": 20526.35, "timestamp": "05:42:06", "text": "あれ。どうすればいいですか"}, {"type": "subtitle", "time": 20530.83, "timestamp": "05:42:10", "text": "それ？グローバルローカル対変数"}, {"type": "subtitle", "time": 20538.83, "timestamp": "05:42:18", "text": "私は何ですか"}, {"type": "subtitle", "time": 20559.67, "timestamp": "05:42:39", "text": "知る。だから、文字通り、えーっと、私に"}, {"type": "subtitle", "time": 20567.43, "timestamp": "05:42:47", "text": "条件が以下のいずれかである場合のみ"}, {"type": "subtitle", "time": 20571.31, "timestamp": "05:42:51", "text": "真か偽か。ああ、わかりました。わかった。配列"}, {"type": "subtitle", "time": 20575.75, "timestamp": "05:42:55", "text": "シャッフルサフ。わかった。配列名は"}, {"type": "subtitle", "time": 20579.27, "timestamp": "05:42:59", "text": "この男をシャッフルして"}]
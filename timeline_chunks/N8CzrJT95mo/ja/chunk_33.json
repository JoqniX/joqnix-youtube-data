[{"type": "subtitle", "time": 1990.909, "timestamp": "00:33:10", "text": "はい、これを閉じます。これを最小限に抑えてください。近い"}, {"type": "subtitle", "time": 1994.43, "timestamp": "00:33:14", "text": "それ。私のPCの調子はどうですか？"}, {"type": "subtitle", "time": 2000.149, "timestamp": "00:33:20", "text": "探していますか？ 98%。 92%。聖なる。なぜ？私"}, {"type": "subtitle", "time": 2013.59, "timestamp": "00:33:33", "text": "[音楽]"}, {"type": "subtitle", "time": 2019.31, "timestamp": "00:33:39", "text": "これ。くそ。"}, {"type": "subtitle", "time": 2021.99, "timestamp": "00:33:41", "text": "わかった。ああ、そうだね。そうそう。うん。病気"}, {"type": "subtitle", "time": 2024.63, "timestamp": "00:33:44", "text": "Twitchで配信をやり直すだけです。"}, {"type": "subtitle", "time": 2028.11, "timestamp": "00:33:48", "text": "信じて、だって48時間かかるんだから"}, {"type": "subtitle", "time": 2032.59, "timestamp": "00:33:52", "text": "今。えっと、私はただ"}, {"type": "subtitle", "time": 2036.19, "timestamp": "00:33:56", "text": "リメイク。ほんの1秒"}, {"type": "subtitle", "time": 2039.71, "timestamp": "00:33:59", "text": "あれ。もしあなたが見ているなら"}]
[{"type": "subtitle", "time": 19803.03, "timestamp": "05:30:03", "text": "最初のビデオは、こちらで選ばれました"}, {"type": "subtitle", "time": 19805.67, "timestamp": "05:30:05", "text": "メインのランダムビデオとして選ばれました"}, {"type": "subtitle", "time": 19808.788, "timestamp": "05:30:08", "text": "ガチャプール。わかった。だからみんな"}, {"type": "subtitle", "time": 19810.83, "timestamp": "05:30:10", "text": "これを見ている"}, {"type": "subtitle", "time": 19814.548, "timestamp": "05:30:14", "text": "動画はプレイリストリストの最初のものです"}, {"type": "subtitle", "time": 19816.868, "timestamp": "05:30:16", "text": "動画 ID は文字通りすべて"}, {"type": "subtitle", "time": 19819.91, "timestamp": "05:30:19", "text": "これらは同じもののコピーです"}, {"type": "subtitle", "time": 19823.43, "timestamp": "05:30:23", "text": "私たちが"}, {"type": "subtitle", "time": 19825.43, "timestamp": "05:30:25", "text": "ちゃんと見てるよ、それが大事なんだから"}, {"type": "subtitle", "time": 19827.67, "timestamp": "05:30:27", "text": "そう、そしてそれは今は重要ではない"}, {"type": "subtitle", "time": 19831.27, "timestamp": "05:30:31", "text": "それを削除したので、もしかしたら"}, {"type": "subtitle", "time": 19835.15, "timestamp": "05:30:35", "text": "配列のように配置できます"}, {"type": "subtitle", "time": 19839.51, "timestamp": "05:30:39", "text": "引っ張る、そして配列の引っ張りと言うだけです"}, {"type": "subtitle", "time": 19840.83, "timestamp": "05:30:40", "text": "ポジションは"}, {"type": "subtitle", "time": 19844.11, "timestamp": "05:30:44", "text": "ああ、ポジションがわからない。"}, {"type": "subtitle", "time": 19846.47, "timestamp": "05:30:46", "text": "はぁ？あ、待って。だから私たちは"}, {"type": "subtitle", "time": 19848.47, "timestamp": "05:30:48", "text": "そのポジション。メインポジションを走らせてください。"}, {"type": "subtitle", "time": 19850.31, "timestamp": "05:30:50", "text": "うん。うん。うん。うん。うん。うん。"}, {"type": "subtitle", "time": 19852.43, "timestamp": "05:30:52", "text": "うん。うん。私たちはそのポジションを獲得しました。"}, {"type": "subtitle", "time": 19858.19, "timestamp": "05:30:58", "text": "いいえ。ええ。うん。そこで、私たちは、"}]
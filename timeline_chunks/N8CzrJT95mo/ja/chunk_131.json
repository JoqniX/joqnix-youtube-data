[{"type": "subtitle", "time": 7861.37, "timestamp": "02:11:01", "text": "こちら側"}, {"type": "subtitle", "time": 7876.629, "timestamp": "02:11:16", "text": "[音楽]"}, {"type": "subtitle", "time": 7880.03, "timestamp": "02:11:20", "text": "折り紙が完成しました。折り紙は"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "完了しました。美しい紙製ブレスレット"}, {"type": "subtitle", "time": 7886.75, "timestamp": "02:11:26", "text": "ハート。ああ、それは難しそう"}, {"type": "subtitle", "time": 7896.51, "timestamp": "02:11:36", "text": "お祝い。パーティーを開いて食事を用意してください"}, {"type": "subtitle", "time": 7898.75, "timestamp": "02:11:38", "text": "私たち。"}, {"type": "subtitle", "time": 7901.229, "timestamp": "02:11:41", "text": "おめでとう。その"}, {"type": "subtitle", "time": 7902.8, "timestamp": "02:11:42", "text": "お祝い。"}, {"type": "subtitle", "time": 7904.109, "timestamp": "02:11:44", "text": "[音楽]"}, {"type": "subtitle", "time": 7915.03, "timestamp": "02:11:55", "text": "よし、みんな。私たちはそれをやり遂げました。わーい。"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "それが綺麗かどうかはわからないが、"}]
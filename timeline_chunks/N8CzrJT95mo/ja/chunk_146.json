[{"type": "subtitle", "time": 8760.389, "timestamp": "02:26:00", "text": "大理石のテーブルトップ、埃が見える"}, {"type": "subtitle", "time": 8763.11, "timestamp": "02:26:03", "text": "毎日必ず出てくる。する必要がある"}, {"type": "subtitle", "time": 8767.03, "timestamp": "02:26:07", "text": "これを掃除してください。でもあなたは"}, {"type": "subtitle", "time": 8769.67, "timestamp": "02:26:09", "text": "襲撃する、ああ、そうだ。ああ、そうだね。そうだった"}, {"type": "subtitle", "time": 8771.309, "timestamp": "02:26:11", "text": "BAで使用されています。"}, {"type": "subtitle", "time": 8776.27, "timestamp": "02:26:16", "text": "ああ。ああ、そう言ったのは、いいえ。ええと、それは"}, {"type": "subtitle", "time": 8779.27, "timestamp": "02:26:19", "text": "例えば、私たちが何か創造的なことをするときのように。おお、"}, {"type": "subtitle", "time": 8780.55, "timestamp": "02:26:20", "text": "それが何なのか疑問に思っているなら、それは"}, {"type": "subtitle", "time": 8783.349, "timestamp": "02:26:23", "text": "私のMIDIキーボード。気にしないでください。それは"}, {"type": "subtitle", "time": 8785.23, "timestamp": "02:26:25", "text": "私が作る場所"}, {"type": "subtitle", "time": 8789.19, "timestamp": "02:26:29", "text": "音楽。それで、えーと、私は、それは、"}, {"type": "subtitle", "time": 8791.91, "timestamp": "02:26:31", "text": "私自身も、もし私が"}, {"type": "subtitle", "time": 8794.71, "timestamp": "02:26:34", "text": "もし絵を描くとしたら、"}, {"type": "subtitle", "time": 8797.55, "timestamp": "02:26:37", "text": "自分自身に書いてみよう、私はどう感じるだろうか"}, {"type": "subtitle", "time": 8800.71, "timestamp": "02:26:40", "text": "満足しているだろうか、それとも満足していないだろうか"}, {"type": "subtitle", "time": 8803.03, "timestamp": "02:26:43", "text": "満足？そして、もし間違いがあったら、"}, {"type": "subtitle", "time": 8807.349, "timestamp": "02:26:47", "text": "それを改善できる点はありますか？"}, {"type": "subtitle", "time": 8810.71, "timestamp": "02:26:50", "text": "そんな感じのことです。それからメモを取る"}, {"type": "subtitle", "time": 8813.79, "timestamp": "02:26:53", "text": "改善してより良いものにしようと努める"}, {"type": "subtitle", "time": 8817.11, "timestamp": "02:26:57", "text": "芸術を考慮に入れながら"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "私が改善すべき点。それから"}]
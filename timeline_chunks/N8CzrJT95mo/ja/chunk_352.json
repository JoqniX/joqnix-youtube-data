[{"type": "subtitle", "time": 21123.27, "timestamp": "05:52:03", "text": "待って。それでうまくいかないの？待って、待って、待って"}, {"type": "subtitle", "time": 21125.83, "timestamp": "05:52:05", "text": "上へ、待って。ちょっと待って。待って、待って。"}, {"type": "subtitle", "time": 21128.91, "timestamp": "05:52:08", "text": "アイデアと"}, {"type": "subtitle", "time": 21132.23, "timestamp": "05:52:12", "text": "アイデア。電球が開きました"}, {"type": "subtitle", "time": 21134.628, "timestamp": "05:52:14", "text": "私のライトが点灯しました。待って、待って、待って、"}, {"type": "subtitle", "time": 21138.868, "timestamp": "05:52:18", "text": "待って、待って。配列が"}, {"type": "subtitle", "time": 21141.99, "timestamp": "05:52:21", "text": "位置的には0、1、2、3みたいな感じですよね？何"}, {"type": "subtitle", "time": 21146.59, "timestamp": "05:52:26", "text": "もし私がランダムなものを入れたら、そうですよね？これ"}, {"type": "subtitle", "time": 21150.788, "timestamp": "05:52:30", "text": "それで、私はそれを置いたのですが、私は知ることができません"}, {"type": "subtitle", "time": 21153.99, "timestamp": "05:52:33", "text": "ただし、許可されている最大数までです。おお、"}, {"type": "subtitle", "time": 21156.47, "timestamp": "05:52:36", "text": "待って。サイズは分かります。配列"}, {"type": "subtitle", "time": 21158.43, "timestamp": "05:52:38", "text": "サイズ。サイズを確認してください。"}, {"type": "subtitle", "time": 21161.11, "timestamp": "05:52:41", "text": "待って。配列の要素数を返します"}, {"type": "subtitle", "time": 21162.548, "timestamp": "05:52:42", "text": "それは成り立つ。指定された場所に保存します"}, {"type": "subtitle", "time": 21164.948, "timestamp": "05:52:44", "text": "変数。わかった。わかった。わかった。私たちは"}, {"type": "subtitle", "time": 21167.51, "timestamp": "05:52:47", "text": "サイズは配列の大きさ、個数"}, {"type": "subtitle", "time": 21170.628, "timestamp": "05:52:50", "text": "動画は、その方法に応じて存在します。"}, {"type": "subtitle", "time": 21174.47, "timestamp": "05:52:54", "text": "更新しているとき。右。今のところ、"}]
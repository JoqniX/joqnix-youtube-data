[{"type": "subtitle", "time": 8526.11, "timestamp": "02:22:06", "text": "エンディング。そして彼女は去っていった。"}, {"type": "subtitle", "time": 8529.99, "timestamp": "02:22:09", "text": "わーい。何が良いかは鍵となる。ありがとうございます"}, {"type": "subtitle", "time": 8533.349, "timestamp": "02:22:13", "text": "参加した全員も同様です。待って、私は思う"}, {"type": "subtitle", "time": 8537.07, "timestamp": "02:22:17", "text": "私はまだカメラを見せることができます、"}, {"type": "subtitle", "time": 8540.91, "timestamp": "02:22:20", "text": "推測。ということで、"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "皆さん、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 8548.23, "timestamp": "02:22:28", "text": "ズキと一緒に楽しんでいただけましたか？"}, {"type": "subtitle", "time": 8551.87, "timestamp": "02:22:31", "text": "紙工作を一緒に作りましょう"}, {"type": "subtitle", "time": 8554.349, "timestamp": "02:22:34", "text": "すべて？楽しかったです。"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "右？ズキは最善を尽くした。だから私は"}, {"type": "subtitle", "time": 8566.95, "timestamp": "02:22:46", "text": "最高。次に何かをしたいときは"}, {"type": "subtitle", "time": 8571.51, "timestamp": "02:22:51", "text": "えーと、何をすればいいの？あなたの手でアイデアをください"}]
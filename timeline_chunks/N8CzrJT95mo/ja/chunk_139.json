[{"type": "subtitle", "time": 8341.429, "timestamp": "02:19:01", "text": "それ。待って。私もそうするべきでしょうか？待って。"}, {"type": "subtitle", "time": 8344.389, "timestamp": "02:19:04", "text": "一緒に支えていきたいですか？"}, {"type": "subtitle", "time": 8345.91, "timestamp": "02:19:05", "text": "待って。"}, {"type": "subtitle", "time": 8346.34, "timestamp": "02:19:06", "text": "どのように"}, {"type": "subtitle", "time": 8348.99, "timestamp": "02:19:08", "text": "[音楽]"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "こんなことって本当に可能なの？はい、"}, {"type": "subtitle", "time": 8357.509, "timestamp": "02:19:17", "text": "手と蝶が熱くなる。どうやって"}, {"type": "subtitle", "time": 8359.509, "timestamp": "02:19:19", "text": "スクリーニングされますか？はい、皆さんは"}, {"type": "subtitle", "time": 8362.629, "timestamp": "02:19:22", "text": "スクリーンショットか何か。私たちに送ってください"}, {"type": "subtitle", "time": 8364.19, "timestamp": "02:19:24", "text": "で"}, {"type": "subtitle", "time": 8367.509, "timestamp": "02:19:27", "text": "不和。わーい。それから投稿してください。投稿します"}, {"type": "subtitle", "time": 8379.469, "timestamp": "02:19:39", "text": "はい。午前16時46分"}, {"type": "subtitle", "time": 8390.389, "timestamp": "02:19:50", "text": "ああ、疲れた。頭をぶつける必要はない"}, {"type": "subtitle", "time": 8391.389, "timestamp": "02:19:51", "text": "で"}, {"type": "subtitle", "time": 8397.429, "timestamp": "02:19:57", "text": "壁。なんてこった。つまり、私は"}]
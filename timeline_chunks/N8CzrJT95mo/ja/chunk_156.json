[{"type": "subtitle", "time": 9361.59, "timestamp": "02:36:01", "text": "ニュース。やっと言えるようになった"}, {"type": "subtitle", "time": 9364.15, "timestamp": "02:36:04", "text": "ついにBilly Billyで再び配信開始。"}, {"type": "subtitle", "time": 9368.59, "timestamp": "02:36:08", "text": "さあ行こう。 4～8年後"}, {"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "数ヶ月間ストリーミングできなかったので、"}, {"type": "subtitle", "time": 9375.51, "timestamp": "02:36:15", "text": "ようやくまたそこでストリーミング配信ができるようになりました。こんにちは、"}, {"type": "subtitle", "time": 9377.83, "timestamp": "02:36:17", "text": "どうやら私はまだ理解できていないようです。"}, {"type": "subtitle", "time": 9380.23, "timestamp": "02:36:20", "text": "まだアクセスはできないけど、大丈夫。今日の"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "ストリーム配信したかったのは、えーと"}, {"type": "subtitle", "time": 9386.15, "timestamp": "02:36:26", "text": "ビリーにマルチストリームしたけど、"}, {"type": "subtitle", "time": 9388.23, "timestamp": "02:36:28", "text": "できなかったのは残念だけど、"}, {"type": "subtitle", "time": 9392.429, "timestamp": "02:36:32", "text": "大丈夫です。ええ、全く問題ありません。心配ない。"}, {"type": "subtitle", "time": 9396.79, "timestamp": "02:36:36", "text": "こんにちは。えーと、次は一緒にやろう"}, {"type": "subtitle", "time": 9400.99, "timestamp": "02:36:40", "text": "時間。わかった。そして、うーん、うっかり"}, {"type": "subtitle", "time": 9403.87, "timestamp": "02:36:43", "text": "マルチストリーミングソフトウェアの料金を支払いました"}, {"type": "subtitle", "time": 9407.15, "timestamp": "02:36:47", "text": "今日はバカバカしい"}, {"type": "subtitle", "time": 9409.389, "timestamp": "02:36:49", "text": "多くのことを考慮すると"}, {"type": "subtitle", "time": 9413.75, "timestamp": "02:36:53", "text": "もの。ええ、私は現在テスト中です"}, {"type": "subtitle", "time": 9416.95, "timestamp": "02:36:56", "text": "普段使っているマルチリーマーではなく"}]
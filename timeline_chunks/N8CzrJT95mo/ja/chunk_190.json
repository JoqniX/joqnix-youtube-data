[{"type": "subtitle", "time": 11400.87, "timestamp": "03:10:00", "text": "人生。あなたの人生が"}, {"type": "subtitle", "time": 11405.11, "timestamp": "03:10:05", "text": "ライフスタイル、日常生活は"}, {"type": "subtitle", "time": 11408.309, "timestamp": "03:10:08", "text": "退屈とかそういうのは、"}, {"type": "subtitle", "time": 11411.11, "timestamp": "03:10:11", "text": "今の自分を楽しくしよう"}, {"type": "subtitle", "time": 11413.11, "timestamp": "03:10:13", "text": "そして、あなたが楽しめるように"}, {"type": "subtitle", "time": 11416.309, "timestamp": "03:10:16", "text": "楽しみにできること、そして"}, {"type": "subtitle", "time": 11418.87, "timestamp": "03:10:18", "text": "より面白くて興味深いもの"}, {"type": "subtitle", "time": 11421.91, "timestamp": "03:10:21", "text": "あなたの人生においてそれはむしろ"}, {"type": "subtitle", "time": 11423.83, "timestamp": "03:10:23", "text": "将来を心配するよりも、"}, {"type": "subtitle", "time": 11426.95, "timestamp": "03:10:26", "text": "過去はあなたの最優先事項だと思います"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "焦点は、現在の状況でどのように"}, {"type": "subtitle", "time": 11434.71, "timestamp": "03:10:34", "text": "あなたは今の自分を作り上げる"}, {"type": "subtitle", "time": 11438.19, "timestamp": "03:10:38", "text": "ええと、現在の生活様式は充実していて、"}, {"type": "subtitle", "time": 11440.87, "timestamp": "03:10:40", "text": "面白いですね、続けてください"}, {"type": "subtitle", "time": 11444.95, "timestamp": "03:10:44", "text": "前進する。お酒を手に入れるのは簡単だ。私"}, {"type": "subtitle", "time": 11447.51, "timestamp": "03:10:47", "text": "ノンアルコールについて考えてみてください"}, {"type": "subtitle", "time": 11457.99, "timestamp": "03:10:57", "text": "自分。ええ、でもお湯が必要なんです。忘れた"}, {"type": "subtitle", "time": 11459.83, "timestamp": "03:10:59", "text": "お湯を補充するため。大丈夫。病気"}]
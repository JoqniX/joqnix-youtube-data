[{"type": "subtitle", "time": 15122.03, "timestamp": "04:12:02", "text": "動画を作る"}, {"type": "subtitle", "time": 15125.189, "timestamp": "04:12:05", "text": "プレイリスト？ユーザーがアップロードした動画を読み込んでいます。"}, {"type": "subtitle", "time": 15128.309, "timestamp": "04:12:08", "text": "はい、ユーザーアップセクションのパラメータ一覧"}, {"type": "subtitle", "time": 15137.51, "timestamp": "04:12:17", "text": "じゃあ、これをコピーしたら、"}, {"type": "subtitle", "time": 15141.55, "timestamp": "04:12:21", "text": "新しいタブを開いて"}, {"type": "subtitle", "time": 15152.59, "timestamp": "04:12:32", "text": "仕事？はい、うまくいきません。わかった。えっと、"}, {"type": "subtitle", "time": 15165.67, "timestamp": "04:12:45", "text": "遊ぶ。最後のステップは、えーと、これです"}, {"type": "subtitle", "time": 15177.189, "timestamp": "04:12:57", "text": "ただ、私の脳は思考していない。私の頭"}, {"type": "subtitle", "time": 15179.349, "timestamp": "04:12:59", "text": "とても傷ついている"}]
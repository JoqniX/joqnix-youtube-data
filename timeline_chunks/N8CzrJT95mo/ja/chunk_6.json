[{"type": "subtitle", "time": 361.11, "timestamp": "00:06:01", "text": "7 待機、5～6、7、8、9、10。5時間"}, {"type": "subtitle", "time": 364.51, "timestamp": "00:06:04", "text": "寝る。それだけでは不十分だ。ああ、"}, {"type": "subtitle", "time": 367.99, "timestamp": "00:06:07", "text": "神。ええ、まだ持っていないものもあります"}, {"type": "subtitle", "time": 370.55, "timestamp": "00:06:10", "text": "朝食。私は起きたばかりです。私は"}, {"type": "subtitle", "time": 372.87, "timestamp": "00:06:12", "text": "ストリームを遅延させるはずだった"}, {"type": "subtitle", "time": 373.95, "timestamp": "00:06:13", "text": "1つにつき"}, {"type": "subtitle", "time": 377.87, "timestamp": "00:06:17", "text": "時間。私もピン留めしました"}, {"type": "subtitle", "time": 380.79, "timestamp": "00:06:20", "text": "メッセージ。えーと、でも私は、いや、それは"}, {"type": "subtitle", "time": 383.67, "timestamp": "00:06:23", "text": "大丈夫。朝食を食べます"}, {"type": "subtitle", "time": 386.189, "timestamp": "00:06:26", "text": "あなたと一緒に"}, {"type": "subtitle", "time": 390.11, "timestamp": "00:06:30", "text": "みんな。だから、それでいいんです"}, {"type": "subtitle", "time": 393.07, "timestamp": "00:06:33", "text": "良い。"}, {"type": "subtitle", "time": 395.30899999999997, "timestamp": "00:06:35", "text": "だから私は"}, {"type": "subtitle", "time": 398.30899999999997, "timestamp": "00:06:38", "text": "それ。今日はApexをプレイします"}, {"type": "subtitle", "time": 401.51, "timestamp": "00:06:41", "text": "伝説。どうやら、それが新しい"}, {"type": "subtitle", "time": 407.189, "timestamp": "00:06:47", "text": "ハロウィン、えーと、悪夢ですね"}, {"type": "subtitle", "time": 409.87, "timestamp": "00:06:49", "text": "ハプニング。ウム"}, {"type": "subtitle", "time": 413.909, "timestamp": "00:06:53", "text": "Apexと、また、"}, {"type": "subtitle", "time": 416.629, "timestamp": "00:06:56", "text": "えーと、ドペル・ガンガ・イベントとは、"}]
[{"type": "subtitle", "time": 10142.79, "timestamp": "02:49:02", "text": "少しお話したいのですが。"}, {"type": "subtitle", "time": 10147.75, "timestamp": "02:49:07", "text": "VRチャットでプレミアムVRを手に入れたので"}, {"type": "subtitle", "time": 10148.67, "timestamp": "02:49:08", "text": "チャット"}, {"type": "subtitle", "time": 10152.15, "timestamp": "02:49:12", "text": "それに私は何かをした、私は何かをした"}, {"type": "subtitle", "time": 10156.389, "timestamp": "02:49:16", "text": "それが私が追加した絵文字です"}, {"type": "subtitle", "time": 10158.51, "timestamp": "02:49:18", "text": "私の"}, {"type": "subtitle", "time": 10161.55, "timestamp": "02:49:21", "text": "エモートを追加しました"}, {"type": "subtitle", "time": 10172.469, "timestamp": "02:49:32", "text": "私が絵文字をいくつか追加したので、ああ、"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "見て。快適な環境であれば、それも可能です。"}, {"type": "subtitle", "time": 10177.71, "timestamp": "02:49:37", "text": "誰かの頭を撫でたいときは、"}, {"type": "subtitle", "time": 10180.429, "timestamp": "02:49:40", "text": "ただやるだけ"}, {"type": "subtitle", "time": 10184.11, "timestamp": "02:49:44", "text": "それ。そして私は水筒のようなものを置いた"}, {"type": "subtitle", "time": 10185.87, "timestamp": "02:49:45", "text": "あれ。"}, {"type": "subtitle", "time": 10190.349, "timestamp": "02:49:50", "text": "水分補給をしましょう。それから私は"}, {"type": "subtitle", "time": 10192.03, "timestamp": "02:49:52", "text": "混乱した。"}, {"type": "subtitle", "time": 10196.11, "timestamp": "02:49:56", "text": "おお。それから私はこのボングをしました"}, {"type": "subtitle", "time": 10198.469, "timestamp": "02:49:58", "text": "あれ。すごくかっこいい。"}]
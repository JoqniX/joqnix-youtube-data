[{"type": "subtitle", "time": 10034.73, "timestamp": "02:47:14", "text": "だから私はほとんどの場合"}, {"type": "subtitle", "time": 10053.11, "timestamp": "02:47:33", "text": "ケース、ちょっと待って、ここからは見えないの？ああ、"}, {"type": "subtitle", "time": 10059.55, "timestamp": "02:47:39", "text": "これは何をするものですか？のために"}, {"type": "subtitle", "time": 10068.95, "timestamp": "02:47:48", "text": "いいね。できるよ、できるよ、できるよ"}, {"type": "subtitle", "time": 10073.07, "timestamp": "02:47:53", "text": "サンリオを手に入れよう"}, {"type": "subtitle", "time": 10075.71, "timestamp": "02:47:55", "text": "アバター。"}, {"type": "subtitle", "time": 10079.71, "timestamp": "02:47:59", "text": "おお。ニーナ・サヒムのミニライブイベント。"}]
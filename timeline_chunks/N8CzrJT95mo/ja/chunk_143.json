[{"type": "subtitle", "time": 8582.99, "timestamp": "02:23:02", "text": "手。うん、いいよ。その"}, {"type": "subtitle", "time": 8585.51, "timestamp": "02:23:05", "text": "良い。次にやりたいことは"}, {"type": "subtitle", "time": 8587.83, "timestamp": "02:23:07", "text": "文字通り指ダンスをして、"}, {"type": "subtitle", "time": 8591.19, "timestamp": "02:23:11", "text": "指で乳首をいじったりとか。"}, {"type": "subtitle", "time": 8594.309, "timestamp": "02:23:14", "text": "でも、ええ、実際に費やしたので"}, {"type": "subtitle", "time": 8597.51, "timestamp": "02:23:17", "text": "これらのものにお金をかける、えーとこの2つ"}, {"type": "subtitle", "time": 8601.59, "timestamp": "02:23:21", "text": "スケッチペンや色鉛筆などの小物、"}, {"type": "subtitle", "time": 8603.79, "timestamp": "02:23:23", "text": "私たちは"}, {"type": "subtitle", "time": 8606.71, "timestamp": "02:23:26", "text": "えっと、塗り絵とか。私は自分が"}, {"type": "subtitle", "time": 8609.309, "timestamp": "02:23:29", "text": "着色料を使うべき"}, {"type": "subtitle", "time": 8611.99, "timestamp": "02:23:31", "text": "本を買うべきか、それとも"}, {"type": "subtitle", "time": 8614.309, "timestamp": "02:23:34", "text": "何か撮るべきか、それともプリントアウトするべきでしょうか"}, {"type": "subtitle", "time": 8617.75, "timestamp": "02:23:37", "text": "ウェブから印刷用に出力"}, {"type": "subtitle", "time": 8619.91, "timestamp": "02:23:39", "text": "アニメキャラクターが何かを着色して"}, {"type": "subtitle", "time": 8624.469, "timestamp": "02:23:44", "text": "色を塗ったり、何かをしたり、"}, {"type": "subtitle", "time": 8626.91, "timestamp": "02:23:46", "text": "マンデラ図か何かを着色する。私はしません"}, {"type": "subtitle", "time": 8629.99, "timestamp": "02:23:49", "text": "知る。ご意見があればお聞かせください"}, {"type": "subtitle", "time": 8633.03, "timestamp": "02:23:53", "text": "可能であれば、Discordサーバーに参加してください。それは"}, {"type": "subtitle", "time": 8636.71, "timestamp": "02:23:56", "text": "それはとても大きな意味を持つだろう。こんにちは。そしてまた"}, {"type": "subtitle", "time": 8639.83, "timestamp": "02:23:59", "text": "チャンネル登録とサポートをお忘れなく"}]
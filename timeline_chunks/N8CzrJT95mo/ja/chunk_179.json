[{"type": "subtitle", "time": 10753.19, "timestamp": "02:59:13", "text": "時間。イベントはまもなく開始します。私は"}, {"type": "subtitle", "time": 10764.23, "timestamp": "02:59:24", "text": "今日。わかった。それでは早速始めましょう"}, {"type": "subtitle", "time": 10766.63, "timestamp": "02:59:26", "text": "それに取り組む。本日のテーマをご紹介します。所有"}, {"type": "subtitle", "time": 10768.309, "timestamp": "02:59:28", "text": "の上。どういうわけか、取り出すことができません"}, {"type": "subtitle", "time": 10770.07, "timestamp": "02:59:30", "text": "の"}, {"type": "subtitle", "time": 10778.469, "timestamp": "02:59:38", "text": "孤独な十字架。英語が読めますか？"}, {"type": "subtitle", "time": 10780.79, "timestamp": "02:59:40", "text": "一部を声に出して言っていただけますか？"}, {"type": "subtitle", "time": 10783.59, "timestamp": "02:59:43", "text": "ええ、そうですね。あなたの国の文化はどのようなものですか？"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "バレンタインデーに国は何をしますか？"}]
[{"type": "subtitle", "time": 12480.79, "timestamp": "03:28:00", "text": "散らかっている？ええ、ストリームを統合する必要がありました"}, {"type": "subtitle", "time": 12483.75, "timestamp": "03:28:03", "text": "PCといいえ、これはストリームPCサミーです。私"}, {"type": "subtitle", "time": 12486.229, "timestamp": "03:28:06", "text": "私のゲーム用PC「Sammy」を統合する必要がありました。そうしなければならなかった"}, {"type": "subtitle", "time": 12488.389, "timestamp": "03:28:08", "text": "ゲームPCサミーからすべてのデッキを配置"}, {"type": "subtitle", "time": 12490.309, "timestamp": "03:28:10", "text": "こちらです。つまり、もっと複雑なのです。"}, {"type": "subtitle", "time": 12492.87, "timestamp": "03:28:12", "text": "今。私の脳は理解すらできない"}, {"type": "subtitle", "time": 12498.429, "timestamp": "03:28:18", "text": "自分自身。えっと、人生って何なんだろう？いや、違う"}, {"type": "subtitle", "time": 12501.99, "timestamp": "03:28:21", "text": "それ。うんこはどこにある？うんこはどこにある？"}, {"type": "subtitle", "time": 12505.79, "timestamp": "03:28:25", "text": "うんこはどこにある？うんこはどこにある？ない"}, {"type": "subtitle", "time": 12507.79, "timestamp": "03:28:27", "text": "それ。どこ"}, {"type": "subtitle", "time": 12511.51, "timestamp": "03:28:31", "text": "えっと、チャドパッド？えっと、パッドはどこ？"}, {"type": "subtitle", "time": 12514.09, "timestamp": "03:28:34", "text": "ヘッドパッド。いや、いや、いや。チャド・P。これだ。"}, {"type": "subtitle", "time": 12515.79, "timestamp": "03:28:35", "text": "[音楽]"}, {"type": "subtitle", "time": 12518.78, "timestamp": "03:28:38", "text": "いいえ"}, {"type": "subtitle", "time": 12521.55, "timestamp": "03:28:41", "text": "[音楽]"}, {"type": "subtitle", "time": 12522.99, "timestamp": "03:28:42", "text": "チャット。"}, {"type": "subtitle", "time": 12525.87, "timestamp": "03:28:45", "text": "[音楽]"}, {"type": "subtitle", "time": 12529.63, "timestamp": "03:28:49", "text": "えっと、これは私が以前は使っていたものですが、今は"}, {"type": "subtitle", "time": 12533.75, "timestamp": "03:28:53", "text": "えっと、今は主に勉強しています"}, {"type": "subtitle", "time": 12534.83, "timestamp": "03:28:54", "text": "エイブルトン"}, {"type": "subtitle", "time": 12538.309, "timestamp": "03:28:58", "text": "ライブ。これは「どこにあるの？」という質問でした。このFL"}]
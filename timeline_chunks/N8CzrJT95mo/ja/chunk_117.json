[{"type": "subtitle", "time": 7022.189, "timestamp": "01:57:02", "text": "結局、私たちはその日、たくさんの思い出を作った。"}, {"type": "subtitle", "time": 7024.95, "timestamp": "01:57:04", "text": "はい。しかし、今日では本当にたくさんの情報があります。その"}, {"type": "subtitle", "time": 7033.03, "timestamp": "01:57:13", "text": "うん。では、あなたの計画は何ですか？"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "バレンタインデー？あなたは、あなたは、えっと"}, {"type": "subtitle", "time": 7038.629, "timestamp": "01:57:18", "text": "チョコレートを作っていますか？"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "ケーキを作ろうと思います。おお。"}, {"type": "subtitle", "time": 7045.91, "timestamp": "01:57:25", "text": "待って、去年は何をしていたの？した"}, {"type": "subtitle", "time": 7047.75, "timestamp": "01:57:27", "text": "ケーキを焼いて見せたんじゃないの？"}, {"type": "subtitle", "time": 7050.39, "timestamp": "01:57:30", "text": "ストリームか何か？何を私はしない"}, {"type": "subtitle", "time": 7053.91, "timestamp": "01:57:33", "text": "去年の自分の行動さえ覚えている。私"}, {"type": "subtitle", "time": 7058.35, "timestamp": "01:57:38", "text": "私はそう思っていなかった 何か最後にした"}, {"type": "subtitle", "time": 7061.149, "timestamp": "01:57:41", "text": "年？えっと、"}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "チェック。その前の年のその日"}, {"type": "subtitle", "time": 7067.47, "timestamp": "01:57:47", "text": "チョコレートのサプライズみたいにやった"}, {"type": "subtitle", "time": 7070.12, "timestamp": "01:57:50", "text": "ストリーム。ああ。"}, {"type": "subtitle", "time": 7072.47, "timestamp": "01:57:52", "text": "[音楽]"}, {"type": "subtitle", "time": 7074.709, "timestamp": "01:57:54", "text": "そんなに配信してなかったと思う"}, {"type": "subtitle", "time": 7079.03, "timestamp": "01:57:59", "text": "昔の話だけどね。ひっくり返す。"}]
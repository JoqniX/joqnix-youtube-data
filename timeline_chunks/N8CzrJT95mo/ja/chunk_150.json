[{"type": "subtitle", "time": 9000.83, "timestamp": "02:30:00", "text": "大きい。右。"}, {"type": "subtitle", "time": 9002.51, "timestamp": "02:30:02", "text": "[音楽]"}, {"type": "subtitle", "time": 9017.23, "timestamp": "02:30:17", "text": "こんにちは。わかった。だから、掃除して"}, {"type": "subtitle", "time": 9020.03, "timestamp": "02:30:20", "text": "いろいろなことをして、私たちは最善を尽くしました"}, {"type": "subtitle", "time": 9022.55, "timestamp": "02:30:22", "text": "今日。よし。また会おう"}, {"type": "subtitle", "time": 9024.349, "timestamp": "02:30:24", "text": "次の回で。"}, {"type": "subtitle", "time": 9027.23, "timestamp": "02:30:27", "text": "わかった。それでは、おやすみなさい。良い一日を。"}, {"type": "subtitle", "time": 9030.79, "timestamp": "02:30:30", "text": "1つ。バイバイ。どうすればいいですか、どうすればいいですか"}, {"type": "subtitle", "time": 9032.03, "timestamp": "02:30:32", "text": "このような？"}, {"type": "subtitle", "time": 9034.93, "timestamp": "02:30:34", "text": "いいえ、それは間違いです。"}, {"type": "subtitle", "time": 9036.27, "timestamp": "02:30:36", "text": "[音楽]"}, {"type": "subtitle", "time": 9052.349, "timestamp": "02:30:52", "text": "ベイビー、いいよ"}, {"type": "subtitle", "time": 9055.349, "timestamp": "02:30:55", "text": "おやすみなさい。今日は皆さんありがとうございました。あなた"}, {"type": "subtitle", "time": 9057.27, "timestamp": "02:30:57", "text": "ストリームを終了したら、"}, {"type": "subtitle", "time": 9059.91, "timestamp": "02:30:59", "text": "この手を振るエモな感情"}]
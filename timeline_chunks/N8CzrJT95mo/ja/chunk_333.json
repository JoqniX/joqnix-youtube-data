[{"type": "subtitle", "time": 19993.548, "timestamp": "05:33:13", "text": "ボタン内の配列が無効です。わかった。待って。"}, {"type": "subtitle", "time": 19997.39, "timestamp": "05:33:17", "text": "えっと、これは"}, {"type": "subtitle", "time": 20008.31, "timestamp": "05:33:28", "text": "それ。わかった。三つ。三つ。二。わかった。コピー"}, {"type": "subtitle", "time": 20014.03, "timestamp": "05:33:34", "text": "それ。そしてその位置を引き出す。"}, {"type": "subtitle", "time": 20017.35, "timestamp": "05:33:37", "text": "これは、どうかクラッシュさせないでください。しないでください"}, {"type": "subtitle", "time": 20020.31, "timestamp": "05:33:40", "text": "クラッシュ。墜落させないでください。これは"}, {"type": "subtitle", "time": 20023.31, "timestamp": "05:33:43", "text": "2,00 遅延のため"}, {"type": "subtitle", "time": 20028.75, "timestamp": "05:33:48", "text": "重要だ。それを置いてください。保存。"}, {"type": "subtitle", "time": 20030.91, "timestamp": "05:33:50", "text": "走る。ああ、それは"}, {"type": "subtitle", "time": 20033.75, "timestamp": "05:33:53", "text": "作品。わかった。ランダム"}]
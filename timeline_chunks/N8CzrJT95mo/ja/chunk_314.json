[{"type": "subtitle", "time": 18844.35, "timestamp": "05:14:04", "text": "ビデオ。ランダムなビデオIDを取得する"}, {"type": "subtitle", "time": 18848.788, "timestamp": "05:14:08", "text": "えー、ID。わかった。編集する動画の数"}, {"type": "subtitle", "time": 18855.03, "timestamp": "05:14:15", "text": "5を加える。その方法を教えてください。えっと、脳"}, {"type": "subtitle", "time": 18856.628, "timestamp": "05:14:16", "text": "頭脳を使うことではない。私は見なければならない"}, {"type": "subtitle", "time": 18859.35, "timestamp": "05:14:19", "text": "サミーに関する資料を再度掲載します。忘れた"}, {"type": "subtitle", "time": 18866.39, "timestamp": "05:14:26", "text": "男。以前、動画を見たことがあります。できますか？"}, {"type": "subtitle", "time": 18869.47, "timestamp": "05:14:29", "text": "どうにかしてそれをあなたの動画に変更できますか？どれの"}, {"type": "subtitle", "time": 18889.55, "timestamp": "05:14:49", "text": "ドキュメント"}, {"type": "subtitle", "time": 18894.03, "timestamp": "05:14:54", "text": "サミ。どの動画ですか？そのビデオを教えてください"}, {"type": "subtitle", "time": 18898.11, "timestamp": "05:14:58", "text": "それについては調べてみます。えっと"}]
[{"type": "subtitle", "time": 15005.83, "timestamp": "04:10:05", "text": "ID。コーディングに似ているが、全く同じではない"}, {"type": "subtitle", "time": 15007.55, "timestamp": "04:10:07", "text": "コーディング。わかりません"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "コーディング。おっと、これらは新しいものです。"}, {"type": "subtitle", "time": 15013.55, "timestamp": "04:10:13", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 15017.67, "timestamp": "04:10:17", "text": "ニース。そんなのは見たことがない。わかった。えっと"}, {"type": "subtitle", "time": 15019.77, "timestamp": "04:10:19", "text": "特性。えっと"}, {"type": "subtitle", "time": 15033.67, "timestamp": "04:10:33", "text": "特定のチャンネルの説明。わかりました。"}, {"type": "subtitle", "time": 15041.97, "timestamp": "04:10:41", "text": "何か。私はとても"}, {"type": "subtitle", "time": 15045.309, "timestamp": "04:10:45", "text": "[音楽]"}, {"type": "subtitle", "time": 15047.75, "timestamp": "04:10:47", "text": "混乱した。私たちは何をしようとしているのか？私は"}, {"type": "subtitle", "time": 15049.359, "timestamp": "04:10:49", "text": "待って待って待って待って待って待って待って待って待って 待って"}, {"type": "subtitle", "time": 15055.59, "timestamp": "04:10:55", "text": "待って、私の脳はこれらを脳化していません"}, {"type": "subtitle", "time": 15057.91, "timestamp": "04:10:57", "text": "私が何かをしているとき、毎回"}]
[{"type": "subtitle", "time": 9540.79, "timestamp": "02:39:00", "text": "こんにちは。 VRチャットの話ですが、ええと、私は"}, {"type": "subtitle", "time": 9546.67, "timestamp": "02:39:06", "text": "ええ、私はいくつかやりました。私はいくつか"}, {"type": "subtitle", "time": 9551.07, "timestamp": "02:39:11", "text": "いろいろなものがあって、実際に別のものを作った"}, {"type": "subtitle", "time": 9555.03, "timestamp": "02:39:15", "text": "ああ、これに関しては本当に苦労したよ。私は作った"}, {"type": "subtitle", "time": 9556.59, "timestamp": "02:39:16", "text": "もう一つのブー"}, {"type": "subtitle", "time": 9559.55, "timestamp": "02:39:19", "text": "ブー。私は実際にもう1冊作りました"}, {"type": "subtitle", "time": 9563.59, "timestamp": "02:39:23", "text": "ブー。チャットプレミアム経由で実際に購入しました"}, {"type": "subtitle", "time": 9567.429, "timestamp": "02:39:27", "text": "お気に入りをもう一つ増やせるといいな"}, {"type": "subtitle", "time": 9570.95, "timestamp": "02:39:30", "text": "友達スロットだけど、ああ、騙された。私"}, {"type": "subtitle", "time": 9574.15, "timestamp": "02:39:34", "text": "追加の友達枠は獲得できませんでした。の"}, {"type": "subtitle", "time": 9576.11, "timestamp": "02:39:36", "text": "最大値は"}, {"type": "subtitle", "time": 9580.389, "timestamp": "02:39:40", "text": "３つ。それが私の心を打ち砕いた。私は"}, {"type": "subtitle", "time": 9590.79, "timestamp": "02:39:50", "text": "神。そして、お分かりのように、私は"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "私の声でわかるかどうか知りたいです。"}, {"type": "subtitle", "time": 9597.15, "timestamp": "02:39:57", "text": "えっと、私が先週から喉が痛いんです"}]
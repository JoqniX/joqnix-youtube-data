[{"type": "subtitle", "time": 11340.309, "timestamp": "03:09:00", "text": "スラッシュフラグ。よし、旗だ。私は"}, {"type": "subtitle", "time": 11341.63, "timestamp": "03:09:01", "text": "検索する"}, {"type": "subtitle", "time": 11345.269, "timestamp": "03:09:05", "text": "メモリ。メモリ。メモリ。メモリ。メモリ。"}, {"type": "subtitle", "time": 11347.83, "timestamp": "03:09:07", "text": "クロムはプロファイラを加熱する。メモリ。ゼロ。"}, {"type": "subtitle", "time": 11375.71, "timestamp": "03:09:35", "text": "えーと"}, {"type": "subtitle", "time": 11381.03, "timestamp": "03:09:41", "text": "えっと、切り替えます"}, {"type": "subtitle", "time": 11385.59, "timestamp": "03:09:45", "text": "なぜ？なぜそれがつまらないのか？わからない。 N"}, {"type": "subtitle", "time": 11387.07, "timestamp": "03:09:47", "text": "何"}, {"type": "subtitle", "time": 11389.75, "timestamp": "03:09:49", "text": "起こった。ああ、それは諦めます。いいえ、私は"}, {"type": "subtitle", "time": 11392.03, "timestamp": "03:09:52", "text": "見捨てることはできない。いや、それは"}, {"type": "subtitle", "time": 11395.15, "timestamp": "03:09:55", "text": "人生とは"}, {"type": "subtitle", "time": 11398.07, "timestamp": "03:09:58", "text": "e.どのようにコントロールするかはあなた次第です"}]
[{"type": "subtitle", "time": 7083.589, "timestamp": "01:58:03", "text": "ええ、ストリーミング配信はしていなかったと思います。"}, {"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "彼女は悪夢を見るだろう"}, {"type": "subtitle", "time": 7087.47, "timestamp": "01:58:07", "text": "今日の"}, {"type": "subtitle", "time": 7091.51, "timestamp": "01:58:11", "text": "製作。いいえ、彼女はそうしません。"}, {"type": "subtitle", "time": 7094.149, "timestamp": "01:58:14", "text": "年齢を3つの部分に分けます。彼女"}, {"type": "subtitle", "time": 7097.87, "timestamp": "01:58:17", "text": "その期間中に結婚式に出席した"}, {"type": "subtitle", "time": 7101.79, "timestamp": "01:58:21", "text": "時間。ふむ。いつ"}, {"type": "subtitle", "time": 7107.91, "timestamp": "01:58:27", "text": "えっと、去年のバレンタインデーの頃"}, {"type": "subtitle", "time": 7111.709, "timestamp": "01:58:31", "text": "私がテトリスの配信をした時のこと"}, {"type": "subtitle", "time": 7116.79, "timestamp": "01:58:36", "text": "4月2月14日。それは面白い。"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "おお。ああ、砂のテトリスもあるし"}, {"type": "subtitle", "time": 7121.99, "timestamp": "01:58:41", "text": "今の状況。"}, {"type": "subtitle", "time": 7125.83, "timestamp": "01:58:45", "text": "まだプレイしていません。"}, {"type": "subtitle", "time": 7128.229, "timestamp": "01:58:48", "text": "私の体調は良くありません。だから、私は"}, {"type": "subtitle", "time": 7129.31, "timestamp": "01:58:49", "text": "本当に"}, {"type": "subtitle", "time": 7132.31, "timestamp": "01:58:52", "text": "今日は実際に座った日です"}, {"type": "subtitle", "time": 7133.229, "timestamp": "01:58:53", "text": "私の"}, {"type": "subtitle", "time": 7136.35, "timestamp": "01:58:56", "text": "PC 数日後には、"}, {"type": "subtitle", "time": 7139.91, "timestamp": "01:58:59", "text": "ストリーミング配信をやめることを知っておいてください。私は"}]
[{"type": "subtitle", "time": 18420.31, "timestamp": "05:07:00", "text": "分。この人は何をしている人ですか？それは与える"}, {"type": "subtitle", "time": 18425.03, "timestamp": "05:07:05", "text": "私にビデオIDをください。それはランダム化します"}, {"type": "subtitle", "time": 18426.948, "timestamp": "05:07:06", "text": "では、待ってください。これは何なのか説明します"}, {"type": "subtitle", "time": 18430.23, "timestamp": "05:07:10", "text": "ボタンは今、正常に動作しています。わかった。そこで私たちは"}, {"type": "subtitle", "time": 18433.91, "timestamp": "05:07:13", "text": "ここにあるすべてのビデオリンクと"}, {"type": "subtitle", "time": 18437.55, "timestamp": "05:07:17", "text": "配列をランダム化します。それはランダム化します"}, {"type": "subtitle", "time": 18440.628, "timestamp": "05:07:20", "text": "ビデオ。ええ、ランダム化して"}, {"type": "subtitle", "time": 18443.75, "timestamp": "05:07:23", "text": "たった1本の動画。わかりました、"}, {"type": "subtitle", "time": 18446.708, "timestamp": "05:07:26", "text": "ガチャで何かが起こる。よし、ここで"}, {"type": "subtitle", "time": 18449.23, "timestamp": "05:07:29", "text": "ビデオID、"}, {"type": "subtitle", "time": 18454.23, "timestamp": "05:07:34", "text": "右？そのビデオIDは理解しました。今"}, {"type": "subtitle", "time": 18458.67, "timestamp": "05:07:38", "text": "私がすべきことは"}, {"type": "subtitle", "time": 18461.708, "timestamp": "05:07:41", "text": "残りの"}, {"type": "subtitle", "time": 18464.51, "timestamp": "05:07:44", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 18467.788, "timestamp": "05:07:47", "text": "それ？えっと、私の"}, {"type": "subtitle", "time": 18473.07, "timestamp": "05:07:53", "text": "脳よ、今必要なのは、えっと、どうすれば"}, {"type": "subtitle", "time": 18475.55, "timestamp": "05:07:55", "text": "のように"}, {"type": "subtitle", "time": 18479.948, "timestamp": "05:07:59", "text": "痛み。はい、ビデオでご覧のとおりです"}]
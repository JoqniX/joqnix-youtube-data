[{"type": "subtitle", "time": 5643.189, "timestamp": "01:34:03", "text": "ナナにプロポーズしてもらいたい。の1つ"}, {"type": "subtitle", "time": 5656.669, "timestamp": "01:34:16", "text": "[音楽]"}, {"type": "subtitle", "time": 5658.43, "timestamp": "01:34:18", "text": "ブラザーズ。"}, {"type": "subtitle", "time": 5660.45, "timestamp": "01:34:20", "text": "ナナナナ。"}, {"type": "subtitle", "time": 5677.709, "timestamp": "01:34:37", "text": "えーと、1つ"}, {"type": "subtitle", "time": 5680.629, "timestamp": "01:34:40", "text": "2番。実際に数字を載せました"}, {"type": "subtitle", "time": 5683.59, "timestamp": "01:34:43", "text": "これ。数字を削除する必要があります。その"}, {"type": "subtitle", "time": 5692.189, "timestamp": "01:34:52", "text": "方向感覚を失った。わかった。ラインナナ"}, {"type": "subtitle", "time": 5695.27, "timestamp": "01:34:55", "text": "提案する。最初からやり直しましょう。三つ、"}]
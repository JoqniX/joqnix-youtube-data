[{"type": "subtitle", "time": 10382.95, "timestamp": "02:53:02", "text": "それはもっとカジュアルな言い方だ。"}, {"type": "subtitle", "time": 10390.83, "timestamp": "02:53:10", "text": "何かのようなもの"}, {"type": "subtitle", "time": 10393.67, "timestamp": "02:53:13", "text": "それ。では、私は何と言えばいいのでしょうか？えっと、何とも言えません"}, {"type": "subtitle", "time": 10399.67, "timestamp": "02:53:19", "text": "年。スバの年齢は言えませんが"}, {"type": "subtitle", "time": 10402.389, "timestamp": "02:53:22", "text": "誰かが私のプロフィールを見たら"}, {"type": "subtitle", "time": 10405.03, "timestamp": "02:53:25", "text": "「あぁ、この男は18歳以上だ」"}, {"type": "subtitle", "time": 10407.83, "timestamp": "02:53:27", "text": "年齢確認済み。では、これは"}, {"type": "subtitle", "time": 10410.79, "timestamp": "02:53:30", "text": "それで十分だと思う。そうですね、それなら"}, {"type": "subtitle", "time": 10414.19, "timestamp": "02:53:34", "text": "それで十分でしょう。彼らは私が"}, {"type": "subtitle", "time": 10417.269, "timestamp": "02:53:37", "text": "アダルト。こんにちは。あ、待って。えっと、それは始まります"}, {"type": "subtitle", "time": 10418.79, "timestamp": "02:53:38", "text": "5分で。ええと、私たちも参加する必要があります。"}, {"type": "subtitle", "time": 10420.79, "timestamp": "02:53:40", "text": "ああ、私たちも参加しなくちゃ。わかった。わかった。 15"}, {"type": "subtitle", "time": 10426.75, "timestamp": "02:53:46", "text": "人々があなたのBにいます。えっと、何"}, {"type": "subtitle", "time": 10428.91, "timestamp": "02:53:48", "text": "それ以外？えっと、"}, {"type": "subtitle", "time": 10436.95, "timestamp": "02:53:56", "text": "インドネシア人ですよね？そうなんですか？待って、忘れてた。"}, {"type": "subtitle", "time": 10439.309, "timestamp": "02:53:59", "text": "ええ、でも、ええ、"}]
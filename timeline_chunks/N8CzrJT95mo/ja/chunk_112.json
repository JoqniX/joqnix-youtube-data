[{"type": "subtitle", "time": 6726.709, "timestamp": "01:52:06", "text": "えーと、これは、えーと、あなたです。この2つの端を取る"}, {"type": "subtitle", "time": 6734.95, "timestamp": "01:52:14", "text": "それ。はい。そうすると権利が手に入る"}, {"type": "subtitle", "time": 6738.39, "timestamp": "01:52:18", "text": "左に角度をつけて同じことをする"}, {"type": "subtitle", "time": 6744.87, "timestamp": "01:52:24", "text": "えっと"}, {"type": "subtitle", "time": 6749.47, "timestamp": "01:52:29", "text": "こんな感じで、この２つを"}, {"type": "subtitle", "time": 6752.31, "timestamp": "01:52:32", "text": "内向きに作る"}, {"type": "subtitle", "time": 6754.95, "timestamp": "01:52:34", "text": "もう一度、もう一度。"}, {"type": "subtitle", "time": 6759.35, "timestamp": "01:52:39", "text": "えっと、このように両側をやりました"}, {"type": "subtitle", "time": 6761.43, "timestamp": "01:52:41", "text": "右？"}, {"type": "subtitle", "time": 6764.589, "timestamp": "01:52:44", "text": "うん。だから両方取る"}, {"type": "subtitle", "time": 6766.109, "timestamp": "01:52:46", "text": "側面"}, {"type": "subtitle", "time": 6770.47, "timestamp": "01:52:50", "text": "そしてそれらを繋ぎ合わせる。 2つの端と"}, {"type": "subtitle", "time": 6771.87, "timestamp": "01:52:51", "text": "接続する"}, {"type": "subtitle", "time": 6775.27, "timestamp": "01:52:55", "text": "それ。近づけて置いてください。ええ、そうですね。得る"}, {"type": "subtitle", "time": 6778.39, "timestamp": "01:52:58", "text": "真ん中の内側のもの。手を"}]
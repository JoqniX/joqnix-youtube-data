[{"type": "subtitle", "time": 610.71, "timestamp": "00:10:10", "text": "何？何てことだ。肌がすごくいい感じ。私"}, {"type": "subtitle", "time": 624.31, "timestamp": "00:10:24", "text": "これ。待って、これは何？ええ、これは"}, {"type": "subtitle", "time": 637.99, "timestamp": "00:10:37", "text": "伝説。そう、これが理由です"}, {"type": "subtitle", "time": 642.75, "timestamp": "00:10:42", "text": "なぜ私がこれをやっているのか"}, {"type": "subtitle", "time": 644.99, "timestamp": "00:10:44", "text": "イベントを取得"}, {"type": "subtitle", "time": 651.11, "timestamp": "00:10:51", "text": "このかわいい見た目の宿敵スキン。それで"}, {"type": "subtitle", "time": 653.03, "timestamp": "00:10:53", "text": "かっこいいでしょ？"}, {"type": "subtitle", "time": 657.389, "timestamp": "00:10:57", "text": "ええ、早速取り掛かりましょう。えーと、"}]
[{"type": "subtitle", "time": 8822.03, "timestamp": "02:27:02", "text": "評価は私がやります"}, {"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "自分自身。でもそれはまるで私たち自身"}, {"type": "subtitle", "time": 8830.23, "timestamp": "02:27:10", "text": "自分のことを一番よく知っているのは自分自身だ。"}, {"type": "subtitle", "time": 8832.95, "timestamp": "02:27:12", "text": "右？私たちは自分自身を最もよく知っている。なぜなら"}, {"type": "subtitle", "time": 8835.91, "timestamp": "02:27:15", "text": "私たちは自分自身に慣れている、そうでしょう？だから"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "良い点でも悪い点でも構わない。"}, {"type": "subtitle", "time": 8841.429, "timestamp": "02:27:21", "text": "だから私たちはどんな間違いを犯すのか、そして"}, {"type": "subtitle", "time": 8844.309, "timestamp": "02:27:24", "text": "修正すべきことなどなど、そういうことですよね？"}, {"type": "subtitle", "time": 8847.11, "timestamp": "02:27:27", "text": "同じこと、同じこと"}, {"type": "subtitle", "time": 8851.11, "timestamp": "02:27:31", "text": "あなたの物事に適用するが、"}, {"type": "subtitle", "time": 8855.19, "timestamp": "02:27:35", "text": "あまりネガティブにならないで、いつも"}, {"type": "subtitle", "time": 8857.27, "timestamp": "02:27:37", "text": "あなたがしている良いことを見て"}, {"type": "subtitle", "time": 8860.19, "timestamp": "02:27:40", "text": "良い。"}, {"type": "subtitle", "time": 8864.389, "timestamp": "02:27:44", "text": "うん。それで、それが私の"}, {"type": "subtitle", "time": 8867.95, "timestamp": "02:27:47", "text": "私のアートを評価して、"}, {"type": "subtitle", "time": 8869.63, "timestamp": "02:27:49", "text": "もの。"}, {"type": "subtitle", "time": 8872.309, "timestamp": "02:27:52", "text": "うん。評価は7点くらいかな。私は必要としている"}, {"type": "subtitle", "time": 8875.11, "timestamp": "02:27:55", "text": "もっと描くために。だから、何をすべきかは分かっているはずだ。"}, {"type": "subtitle", "time": 8877.51, "timestamp": "02:27:57", "text": "あなたにはもっと道筋が必要です。続けなければならない"}, {"type": "subtitle", "time": 8879.99, "timestamp": "02:27:59", "text": "描いて、描いて、描いて、"}]
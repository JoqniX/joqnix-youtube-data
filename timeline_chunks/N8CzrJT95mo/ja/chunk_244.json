[{"type": "subtitle", "time": 14640.95, "timestamp": "04:04:00", "text": "日付、この日付ですよね？この日付は"}, {"type": "subtitle", "time": 14643.59, "timestamp": "04:04:03", "text": "私たちに必要なものですよね？サムネイル、"}, {"type": "subtitle", "time": 14646.75, "timestamp": "04:04:06", "text": "サムネイル。えーとローカライズされた、何が"}, {"type": "subtitle", "time": 14650.87, "timestamp": "04:04:10", "text": "これ？うん。だから、私たちは、私たちは"}, {"type": "subtitle", "time": 14656.15, "timestamp": "04:04:16", "text": "公開日ですよね？もし私の考えが正しければ"}, {"type": "subtitle", "time": 14659.9, "timestamp": "04:04:19", "text": "これをどのようにフォーマットするか"}, {"type": "subtitle", "time": 14661.87, "timestamp": "04:04:21", "text": "[音楽]"}, {"type": "subtitle", "time": 14665.189, "timestamp": "04:04:25", "text": "えーと、プレイリストについては後で考えます"}, {"type": "subtitle", "time": 14667.59, "timestamp": "04:04:27", "text": "少し。わかりました、ではその劇について調べてみましょう"}, {"type": "subtitle", "time": 14671.229, "timestamp": "04:04:31", "text": "後でそれをプレイリストにする方法ですが"}, {"type": "subtitle", "time": 14674.63, "timestamp": "04:04:34", "text": "現在、日付を取得する必要があります"}, {"type": "subtitle", "time": 14680.07, "timestamp": "04:04:40", "text": "取得している動画の正しい日付"}, {"type": "subtitle", "time": 14682.75, "timestamp": "04:04:42", "text": "右。それで"}, {"type": "subtitle", "time": 14684.59, "timestamp": "04:04:44", "text": "API は、どのように"}]
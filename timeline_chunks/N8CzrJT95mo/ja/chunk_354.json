[{"type": "subtitle", "time": 21243.91, "timestamp": "05:54:03", "text": "th00と、1,000とランダム化"}, {"type": "subtitle", "time": 21251.83, "timestamp": "05:54:11", "text": "1,500ミリ秒 そして"}, {"type": "subtitle", "time": 21255.11, "timestamp": "05:54:15", "text": "シャッフルは最後に後から行うことができます"}, {"type": "subtitle", "time": 21258.67, "timestamp": "05:54:18", "text": "そして文字列変数は次のようになります"}, {"type": "subtitle", "time": 21261.27, "timestamp": "05:54:21", "text": "これ。待って、今はシャッフルしないで。"}, {"type": "subtitle", "time": 21262.868, "timestamp": "05:54:22", "text": "実は、"}, {"type": "subtitle", "time": 21266.91, "timestamp": "05:54:26", "text": "えっと、これをテストする必要があります。"}, {"type": "subtitle", "time": 21270.27, "timestamp": "05:54:30", "text": "保存して"}, {"type": "subtitle", "time": 21273.91, "timestamp": "05:54:33", "text": "走る。これで配列のサイズがわかります。ええ、私たちは"}, {"type": "subtitle", "time": 21277.27, "timestamp": "05:54:37", "text": "フルサイズ版を入手してください。わかった。だから今私たちは"}, {"type": "subtitle", "time": 21279.99, "timestamp": "05:54:39", "text": "最小値と最大値。"}, {"type": "subtitle", "time": 21283.91, "timestamp": "05:54:43", "text": "では、サイズをこちらに表示します。コピー"}, {"type": "subtitle", "time": 21286.868, "timestamp": "05:54:46", "text": "パス。私たちはそれをここに置きました。最大"}, {"type": "subtitle", "time": 21289.23, "timestamp": "05:54:49", "text": "許可された"}, {"type": "subtitle", "time": 21294.27, "timestamp": "05:54:54", "text": "サイズ。わかった。そして最低限は"}, {"type": "subtitle", "time": 21299.67, "timestamp": "05:54:59", "text": "ゼロ。そして私たちはそれを次のように置きます"}]
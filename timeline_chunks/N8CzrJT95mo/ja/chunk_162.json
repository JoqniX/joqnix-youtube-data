[{"type": "subtitle", "time": 9722.95, "timestamp": "02:42:02", "text": "うん。わかった。まあ、いいでしょう。彼らは作ったのか"}, {"type": "subtitle", "time": 9724.87, "timestamp": "02:42:04", "text": "またそれか？今日ですよね？"}, {"type": "subtitle", "time": 9727.309, "timestamp": "02:42:07", "text": "待って、バーチャルフェスティバルが開催されているよ"}, {"type": "subtitle", "time": 9730.87, "timestamp": "02:42:10", "text": "の上。待って、バーチャルな"}, {"type": "subtitle", "time": 9733.07, "timestamp": "02:42:13", "text": "フェスティバルに行く"}, {"type": "subtitle", "time": 9734.91, "timestamp": "02:42:14", "text": "の上。待って、"}, {"type": "subtitle", "time": 9736.99, "timestamp": "02:42:16", "text": "何？何が"}, {"type": "subtitle", "time": 9739.83, "timestamp": "02:42:19", "text": "これ？音楽コンサートが開催されています。"}, {"type": "subtitle", "time": 9742.23, "timestamp": "02:42:22", "text": "私が知っているVユーチューバーの中には、"}, {"type": "subtitle", "time": 9762.309, "timestamp": "02:42:42", "text": "ああ、なぜ私のこの隅は"}, {"type": "subtitle", "time": 9766.389, "timestamp": "02:42:46", "text": "スクリーンのような感じ"}, {"type": "subtitle", "time": 9769.83, "timestamp": "02:42:49", "text": "えっと、画面の隅がどうしてこんな風になっているの？"}]
[{"type": "subtitle", "time": 14580.83, "timestamp": "04:03:00", "text": "えっと、私たちはそれを"}, {"type": "subtitle", "time": 14583.429, "timestamp": "04:03:03", "text": "パスだよ、わかるだろ。なるがままに。あ、待って。させて"}, {"type": "subtitle", "time": 14585.55, "timestamp": "04:03:05", "text": "そうでしょうね。それで、"}, {"type": "subtitle", "time": 14594.469, "timestamp": "04:03:14", "text": "待って。実際のリクエスト内容を見たい"}, {"type": "subtitle", "time": 14601.349, "timestamp": "04:03:21", "text": "わかった。間隔。期間 2 ドロー"}, {"type": "subtitle", "time": 14605.11, "timestamp": "04:03:25", "text": "秒。 HビデオID。隠しておこう"}, {"type": "subtitle", "time": 14608.469, "timestamp": "04:03:28", "text": "万一に備えて。これはYouTubeのレスポンス機能です。"}, {"type": "subtitle", "time": 14613.229, "timestamp": "04:03:33", "text": "H情報。何もない。アイテムオブジェクトIDスニペット"}, {"type": "subtitle", "time": 14614.83, "timestamp": "04:03:34", "text": "統計"}, {"type": "subtitle", "time": 14618.07, "timestamp": "04:03:38", "text": "スニペットコンテンツの詳細。わかった。わかった。私"}, {"type": "subtitle", "time": 14619.309, "timestamp": "04:03:39", "text": "表示できる"}, {"type": "subtitle", "time": 14622.269, "timestamp": "04:03:42", "text": "これ。だから、私たちが"}, {"type": "subtitle", "time": 14625.269, "timestamp": "04:03:45", "text": "リクエストすると、次のような応答が得られます。"}, {"type": "subtitle", "time": 14627.99, "timestamp": "04:03:47", "text": "アイテム。アイテムはいくつありますか？では"}, {"type": "subtitle", "time": 14631.349, "timestamp": "04:03:51", "text": "アイテム、ビデオIDを取得して、それは"}, {"type": "subtitle", "time": 14634.309, "timestamp": "04:03:54", "text": "動画の一部。私たちはカテゴリーを取得します、"}, {"type": "subtitle", "time": 14637.91, "timestamp": "04:03:57", "text": "チャンネルID、説明、公開"}]
[{"type": "subtitle", "time": 3305.23, "timestamp": "00:55:05", "text": "どこ？待って、3 4 5 はどこ？"}, {"type": "subtitle", "time": 3308.549, "timestamp": "00:55:08", "text": "79？彼はオーです。おお。おお。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 3311.87, "timestamp": "00:55:11", "text": "おお。わかった。わかった。 B評価です。"}, {"type": "subtitle", "time": 3314.829, "timestamp": "00:55:14", "text": "おお。おお。それらは"}, {"type": "subtitle", "time": 3322.349, "timestamp": "00:55:22", "text": "プラットフォーム。くそ、私は"}, {"type": "subtitle", "time": 3326.19, "timestamp": "00:55:26", "text": "知る。つまりそれは"}, {"type": "subtitle", "time": 3329.87, "timestamp": "00:55:29", "text": "ボットか。"}, {"type": "subtitle", "time": 3332.069, "timestamp": "00:55:32", "text": "面白い。はい、続けてください。私は手に入れた"}, {"type": "subtitle", "time": 3334.75, "timestamp": "00:55:34", "text": "話が逸れた。えっと、1つ終わりました"}, {"type": "subtitle", "time": 3337.43, "timestamp": "00:55:37", "text": "歌。 2曲目。私はそうするはずだった"}, {"type": "subtitle", "time": 3345.23, "timestamp": "00:55:45", "text": "えっと"}, {"type": "subtitle", "time": 3347.05, "timestamp": "00:55:47", "text": "ハカシ。わかった。"}, {"type": "subtitle", "time": 3354.75, "timestamp": "00:55:54", "text": "[音楽]"}, {"type": "subtitle", "time": 3356.99, "timestamp": "00:55:56", "text": "ハカシ。私のミスです。"}, {"type": "subtitle", "time": 3359.63, "timestamp": "00:55:59", "text": "おい、違う"}]
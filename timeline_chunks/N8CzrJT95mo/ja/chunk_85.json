[{"type": "subtitle", "time": 5115.31, "timestamp": "01:25:15", "text": "こんにちは、"}, {"type": "subtitle", "time": 5123.43, "timestamp": "01:25:23", "text": "グアナ。私は、私は、私は、私は、"}, {"type": "subtitle", "time": 5126.149, "timestamp": "01:25:26", "text": "少しずつですが、良くなろうと努力しています。"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "私はゆっくりとゆっくりと"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "この曲で表現力豊かに"}, {"type": "subtitle", "time": 5132.99, "timestamp": "01:25:32", "text": "長い間"}, {"type": "subtitle", "time": 5136.75, "timestamp": "01:25:36", "text": "練習する。ゆっくりと、ゆっくりと近づいています。"}]
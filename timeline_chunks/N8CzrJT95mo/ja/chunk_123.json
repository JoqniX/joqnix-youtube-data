[{"type": "subtitle", "time": 7381.669, "timestamp": "02:03:01", "text": "ホラーストリームの時間だから、私は叫びます"}, {"type": "subtitle", "time": 7383.149, "timestamp": "02:03:03", "text": "泣くように"}, {"type": "subtitle", "time": 7387.149, "timestamp": "02:03:07", "text": "死にかけの人、または"}, {"type": "subtitle", "time": 7389.07, "timestamp": "02:03:09", "text": "何か。だから私は"}, {"type": "subtitle", "time": 7391.99, "timestamp": "02:03:11", "text": "痛みのように。"}, {"type": "subtitle", "time": 7406.03, "timestamp": "02:03:26", "text": "[音楽]"}, {"type": "subtitle", "time": 7409.75, "timestamp": "02:03:29", "text": "アメリカでメカコスプレイヤーとして活動していた私たちは"}, {"type": "subtitle", "time": 7413.669, "timestamp": "02:03:33", "text": "そういうわけで、それは典型的な「我々は動く」瞬間だった"}, {"type": "subtitle", "time": 7419.149, "timestamp": "02:03:39", "text": "正直に言うと私たちは"}, {"type": "subtitle", "time": 7423.43, "timestamp": "02:03:43", "text": "ブー、君が驚いていることに気づいてるよ。ええと、ほとんど"}, {"type": "subtitle", "time": 7426.709, "timestamp": "02:03:46", "text": "外で見かける人々のうち、彼らは"}, {"type": "subtitle", "time": 7428.95, "timestamp": "02:03:48", "text": "全員普通の人。彼らはゲームをしない。彼らは"}, {"type": "subtitle", "time": 7432.229, "timestamp": "02:03:52", "text": "アニメを知らない。ごく少数の人しか知らない"}, {"type": "subtitle", "time": 7435.07, "timestamp": "02:03:55", "text": "アニメについて"}, {"type": "subtitle", "time": 7439.75, "timestamp": "02:03:59", "text": "もの。私は自分が好きだということにショックを受けました、ねえ、"}]
[{"type": "subtitle", "time": 7980.79, "timestamp": "02:13:00", "text": "あなたの。ああ、わかりました。わかった。わかった。放してくれ"}, {"type": "subtitle", "time": 8014.589, "timestamp": "02:13:34", "text": "わかった。"}, {"type": "subtitle", "time": 8018.39, "timestamp": "02:13:38", "text": "わーい。こういうハサミが必要なんです"}, {"type": "subtitle", "time": 8021.83, "timestamp": "02:13:41", "text": "すごくかっこいい。分解することもできます"}, {"type": "subtitle", "time": 8025.149, "timestamp": "02:13:45", "text": "そしてそれは"}, {"type": "subtitle", "time": 8028.709, "timestamp": "02:13:48", "text": "ハサミ。わかった。うん、これは"}, {"type": "subtitle", "time": 8030.109, "timestamp": "02:13:50", "text": "折りたたみ式"}, {"type": "subtitle", "time": 8033.35, "timestamp": "02:13:53", "text": "ハサミ。見てごらん。とてもかわいい。まるで"}, {"type": "subtitle", "time": 8036.79, "timestamp": "02:13:56", "text": "子供用のはさみだけどね。うん。犬は"}, {"type": "subtitle", "time": 8038.79, "timestamp": "02:13:58", "text": "子供。"}]
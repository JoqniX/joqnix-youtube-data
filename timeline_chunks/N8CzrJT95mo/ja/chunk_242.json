[{"type": "subtitle", "time": 14523.349, "timestamp": "04:02:03", "text": "待って、私たちは変える必要があると思う"}, {"type": "subtitle", "time": 14527.33, "timestamp": "04:02:07", "text": "それから。"}, {"type": "subtitle", "time": 14529.15, "timestamp": "04:02:09", "text": "[音楽]"}, {"type": "subtitle", "time": 14531.67, "timestamp": "04:02:11", "text": "えっと、待って。リクエストを受け取る必要があります"}, {"type": "subtitle", "time": 14538.03, "timestamp": "04:02:18", "text": "これら。いいえ、"}, {"type": "subtitle", "time": 14540.469, "timestamp": "04:02:20", "text": "待って。これらはプラットフォーム関連のことですよね？"}, {"type": "subtitle", "time": 14554.2, "timestamp": "04:02:34", "text": "全部変える必要がある"}, {"type": "subtitle", "time": 14569.429, "timestamp": "04:02:49", "text": "けれど。はい、電源を切ってください。私は必要ない"}, {"type": "subtitle", "time": 14572.63, "timestamp": "04:02:52", "text": "期間チェック。はい、削除できます"}]
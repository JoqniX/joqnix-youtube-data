[{"type": "subtitle", "time": 4505.27, "timestamp": "01:15:05", "text": "寝る。わかった。同じ曲です。その"}, {"type": "subtitle", "time": 4507.47, "timestamp": "01:15:07", "text": "テンポだけが"}, {"type": "subtitle", "time": 4510.31, "timestamp": "01:15:10", "text": "違う。ビートのテンポとその他"}, {"type": "subtitle", "time": 4512.55, "timestamp": "01:15:12", "text": "少しだけ違うんです。私はそうは思わない"}, {"type": "subtitle", "time": 4516.149, "timestamp": "01:15:16", "text": "ヨキの件にはハヤスを使います。いいえ、"}, {"type": "subtitle", "time": 4519.43, "timestamp": "01:15:19", "text": "私はMC akaをプレイします。えっと、そうは思わない"}, {"type": "subtitle", "time": 4522.55, "timestamp": "01:15:22", "text": "ヨキの分にはハヤスを使いますが、"}, {"type": "subtitle", "time": 4524.79, "timestamp": "01:15:24", "text": "参考として使うだけです"}, {"type": "subtitle", "time": 4527.35, "timestamp": "01:15:27", "text": "インストゥルメンタルはやらない、さもないと"}, {"type": "subtitle", "time": 4529.35, "timestamp": "01:15:29", "text": "これの別バージョンを作成する。その"}, {"type": "subtitle", "time": 4533.27, "timestamp": "01:15:33", "text": "わかった。えっと、1、2、3、4しか入れてないよ。そうだね。私"}, {"type": "subtitle", "time": 4536.03, "timestamp": "01:15:36", "text": "もう1つ入れるのを忘れた"}, {"type": "subtitle", "time": 4538.11, "timestamp": "01:15:38", "text": "から"}, {"type": "subtitle", "time": 4541.51, "timestamp": "01:15:41", "text": "ここ。ミコップを捕まえなければならない。これです"}, {"type": "subtitle", "time": 4542.99, "timestamp": "01:15:42", "text": "正しい"}, {"type": "subtitle", "time": 4546.75, "timestamp": "01:15:46", "text": "私はあなたを"}, {"type": "chat", "time": 4552.961, "timestamp": "01:15:52", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "@Mitsuki Shiori - Waconne Vtuber hii...will u stream tmrw"}, {"type": "subtitle", "time": 4555.47, "timestamp": "01:15:55", "text": "ここに"}, {"type": "subtitle", "time": 4559.47, "timestamp": "01:15:59", "text": "下に行くと、ここに来ます。"}]
[{"type": "subtitle", "time": 7506.149, "timestamp": "02:05:06", "text": "試す。でも、これはちょっとクールだね。"}, {"type": "subtitle", "time": 7510.83, "timestamp": "02:05:10", "text": "紙工作のようなもの。私は決して好きではない"}, {"type": "subtitle", "time": 7514.95, "timestamp": "02:05:14", "text": "熱心に努力を注ぎ込むが、"}, {"type": "subtitle", "time": 7521.189, "timestamp": "02:05:21", "text": "楽しい。それで、それに、私が買ったものも"}, {"type": "subtitle", "time": 7524.47, "timestamp": "02:05:24", "text": "スケッチブックとか、本当にそうするべきなんだけど"}, {"type": "subtitle", "time": 7525.629, "timestamp": "02:05:25", "text": "する"}, {"type": "subtitle", "time": 7530.95, "timestamp": "02:05:30", "text": "どちらかというと、こういうシムのようなものかな。"}, {"type": "subtitle", "time": 7535.03, "timestamp": "02:05:35", "text": "そして、その方法を学びましょう。底を折り曲げる"}, {"type": "subtitle", "time": 7542.47, "timestamp": "02:05:42", "text": "犬。"}, {"type": "subtitle", "time": 7543.62, "timestamp": "02:05:43", "text": "はい。"}, {"type": "subtitle", "time": 7546.47, "timestamp": "02:05:46", "text": "[音楽]"}, {"type": "subtitle", "time": 7548.95, "timestamp": "02:05:48", "text": "どうしてあなたはまだ私の家の近くに住んでいますか"}, {"type": "subtitle", "time": 7553.35, "timestamp": "02:05:53", "text": "なれ？うん。その質問は何ですか？看護師"}, {"type": "subtitle", "time": 7555.669, "timestamp": "02:05:55", "text": "内部。ええ、私も同じ場所にいます"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "私は生まれてきた。"}]
[{"type": "subtitle", "time": 8645.07, "timestamp": "02:24:05", "text": "ズキチャマ。紙を置くのが好きです"}, {"type": "subtitle", "time": 8648.309, "timestamp": "02:24:08", "text": "戻る。そして、2つ使えてよかった"}, {"type": "subtitle", "time": 8651.19, "timestamp": "02:24:11", "text": "私の好きな色。それは紫色です"}, {"type": "subtitle", "time": 8654.19, "timestamp": "02:24:14", "text": "そして光"}, {"type": "subtitle", "time": 8657.429, "timestamp": "02:24:17", "text": "青。ああ、待って。あった"}, {"type": "subtitle", "time": 8660.15, "timestamp": "02:24:20", "text": "ピンク。ピンク色だったらよかったのに。ああ、私は"}, {"type": "subtitle", "time": 8669.15, "timestamp": "02:24:29", "text": "わかった。これで配信を終了します。"}, {"type": "subtitle", "time": 8673.79, "timestamp": "02:24:33", "text": "それで、先ほども言ったように、試験が近づいています。"}, {"type": "subtitle", "time": 8679.63, "timestamp": "02:24:39", "text": "そしておそらく配信を試してみるつもりです"}, {"type": "subtitle", "time": 8683.79, "timestamp": "02:24:43", "text": "明日。つまり、私は"}, {"type": "subtitle", "time": 8687.83, "timestamp": "02:24:47", "text": "実は。つまり、日本語を復習できるということです。"}, {"type": "subtitle", "time": 8691.51, "timestamp": "02:24:51", "text": "だって試験が近いし、やってみてもいいじゃない？多分"}, {"type": "subtitle", "time": 8693.83, "timestamp": "02:24:53", "text": "それは良いことだ。"}, {"type": "subtitle", "time": 8697.91, "timestamp": "02:24:57", "text": "それは良い感じになるでしょう。ああ、これを忘れてた"}, {"type": "subtitle", "time": 8699.23, "timestamp": "02:24:59", "text": "男。これ"}]
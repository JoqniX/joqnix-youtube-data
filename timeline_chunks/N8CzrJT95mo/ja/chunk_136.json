[{"type": "subtitle", "time": 8167.47, "timestamp": "02:16:07", "text": "いいえ、できません"}, {"type": "subtitle", "time": 8172.87, "timestamp": "02:16:12", "text": "えっと、そうですね、あなたに会った後、私は"}, {"type": "subtitle", "time": 8175.35, "timestamp": "02:16:15", "text": "酔って寝ることについてこれを学びました"}, {"type": "subtitle", "time": 8177.35, "timestamp": "02:16:17", "text": "もの。私はそれが何なのか知らなかった。私"}, {"type": "subtitle", "time": 8181.27, "timestamp": "02:16:21", "text": "あの袖の酔っ払いみたいなやつを手に入れたと思う"}, {"type": "subtitle", "time": 8183.75, "timestamp": "02:16:23", "text": "あなたが外を歩いているとき"}, {"type": "subtitle", "time": 8186.39, "timestamp": "02:16:26", "text": "湖。"}, {"type": "subtitle", "time": 8189.91, "timestamp": "02:16:29", "text": "疲れていたし、酔っていたんだと思う。ああ神様、見て"}, {"type": "subtitle", "time": 8193.03, "timestamp": "02:16:33", "text": "私の手によって。チャド、どこにあるのかわからない"}, {"type": "subtitle", "time": 8203.83, "timestamp": "02:16:43", "text": "うわっ。どうすればいいですか？ ああ、それは正しいです。おお、"}, {"type": "subtitle", "time": 8211.07, "timestamp": "02:16:51", "text": "わかった。わかった。わかった。私は"}, {"type": "subtitle", "time": 8218.469, "timestamp": "02:16:58", "text": "来るよ。わかった。まるで"}]
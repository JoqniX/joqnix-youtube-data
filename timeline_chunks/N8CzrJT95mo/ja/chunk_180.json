[{"type": "subtitle", "time": 10810.23, "timestamp": "03:00:10", "text": "おそらく少しの主題のために"}, {"type": "subtitle", "time": 10813.269, "timestamp": "03:00:13", "text": "他の人にとっては悲しいこと？うん。楽しみにしています"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "今日は私一人しかスタッフがいません。"}, {"type": "subtitle", "time": 10831.67, "timestamp": "03:00:31", "text": "私は1号室の物置にいます。だからもし"}, {"type": "subtitle", "time": 10834.15, "timestamp": "03:00:34", "text": "スタッフと一緒に参加したい人はいますか？"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "メンバーの方は、ルーム1にご参加ください。えっと、誰でも"}, {"type": "subtitle", "time": 10843.91, "timestamp": "03:00:43", "text": "参加する人はいますか"}, {"type": "subtitle", "time": 10844.67, "timestamp": "03:00:44", "text": "初め"}, {"type": "subtitle", "time": 10859.269, "timestamp": "03:00:59", "text": "右。わかった。ルームモードに参加しましょう。"}]
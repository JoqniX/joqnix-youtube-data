[{"type": "subtitle", "time": 485.909, "timestamp": "00:08:05", "text": "うん。だから私も同じようなものを持っている"}, {"type": "subtitle", "time": 489.35, "timestamp": "00:08:09", "text": "Call of Duty Warfare 3の配信で"}, {"type": "subtitle", "time": 491.629, "timestamp": "00:08:11", "text": "まるで"}, {"type": "subtitle", "time": 496.189, "timestamp": "00:08:16", "text": "あれ。だから水曜日か"}, {"type": "subtitle", "time": 499.51, "timestamp": "00:08:19", "text": "火曜日。そう、水曜日。実際、私は"}, {"type": "subtitle", "time": 507.749, "timestamp": "00:08:27", "text": "どちらか。まるで私が文句を言っているかのように、"}, {"type": "subtitle", "time": 508.909, "timestamp": "00:08:28", "text": "しかしそれは"}, {"type": "subtitle", "time": 510.83, "timestamp": "00:08:30", "text": "良い。それが"}, {"type": "subtitle", "time": 529.47, "timestamp": "00:08:49", "text": "さあ行こう。みんな聞こえますか"}, {"type": "subtitle", "time": 532.269, "timestamp": "00:08:52", "text": "オーディオ？私たちは"}, {"type": "subtitle", "time": 535.19, "timestamp": "00:08:55", "text": "する。コンパイル"}]
[{"type": "subtitle", "time": 20462.27, "timestamp": "05:41:02", "text": "待って。動画。遊ぶ"}, {"type": "subtitle", "time": 20465.23, "timestamp": "05:41:05", "text": "ビデオ。よし。わかった。待って。では、待ってください。"}, {"type": "subtitle", "time": 20469.868, "timestamp": "05:41:09", "text": "えっと、プレイ。これは動画です。"}, {"type": "subtitle", "time": 20475.548, "timestamp": "05:41:15", "text": "瞑想する"}, {"type": "subtitle", "time": 20478.47, "timestamp": "05:41:18", "text": "ファイル。声を出してみます。声優の仕事がしたい"}, {"type": "subtitle", "time": 20481.43, "timestamp": "05:41:21", "text": "演技。 H."}, {"type": "subtitle", "time": 20483.59, "timestamp": "05:41:23", "text": "2回目もやりたいのですが、"}, {"type": "subtitle", "time": 20500.91, "timestamp": "05:41:40", "text": "それ。ランダム化テスト"}, {"type": "subtitle", "time": 20504.43, "timestamp": "05:41:44", "text": "シャッフルランダム化"}, {"type": "subtitle", "time": 20517.43, "timestamp": "05:41:57", "text": "私は、無作為なものは何も欲しくない。私"}]
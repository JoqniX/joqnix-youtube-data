[{"type": "subtitle", "time": 10266.309, "timestamp": "02:51:06", "text": "でも、聞かれるかもしれない"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "えっと、セルフインタビューを頼まれるかもしれない"}, {"type": "subtitle", "time": 10281.71, "timestamp": "02:51:21", "text": "忘れた。なぜできないのか"}, {"type": "subtitle", "time": 10286.75, "timestamp": "02:51:26", "text": "私？少し下げましょう。所有"}, {"type": "subtitle", "time": 10294.95, "timestamp": "02:51:34", "text": "えっと、待って、自己ってどういう意味？"}, {"type": "subtitle", "time": 10296.87, "timestamp": "02:51:36", "text": "日本語で「はじめに」とはどういう意味ですか？ああ、"}, {"type": "subtitle", "time": 10298.349, "timestamp": "02:51:38", "text": "神よ、私は"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "忘れること。えっと、"}, {"type": "subtitle", "time": 10312.51, "timestamp": "02:51:52", "text": "いいえ、これを置かせてください"}, {"type": "subtitle", "time": 10318.23, "timestamp": "02:51:58", "text": "混乱した。えっと、このステッカーを猫の目で見てください。"}]
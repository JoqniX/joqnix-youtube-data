[{"type": "subtitle", "time": 13742.269, "timestamp": "03:49:02", "text": "えっと、私たちは作ります"}, {"type": "subtitle", "time": 13746.429, "timestamp": "03:49:06", "text": "あー、ショートカットキーを忘れちゃった。わかった。指示"}, {"type": "subtitle", "time": 13748.269, "timestamp": "03:49:08", "text": "ブロック。"}, {"type": "subtitle", "time": 13750.51, "timestamp": "03:49:10", "text": "えっと"}, {"type": "subtitle", "time": 13754.11, "timestamp": "03:49:14", "text": "重要なこと"}, {"type": "subtitle", "time": 13756.429, "timestamp": "03:49:16", "text": "敏感な"}, {"type": "subtitle", "time": 13760.189, "timestamp": "03:49:20", "text": "いや、しないで"}, {"type": "subtitle", "time": 13768.95, "timestamp": "03:49:28", "text": "これら。わかった。だから私たちができることは"}, {"type": "subtitle", "time": 13772.75, "timestamp": "03:49:32", "text": "物体。オブジェクトを作成します。何が"}, {"type": "subtitle", "time": 13776.269, "timestamp": "03:49:36", "text": "オブジェクトを作成します"}, {"type": "subtitle", "time": 13790.39, "timestamp": "03:49:50", "text": "待って。オブジェクトを作成する"}, {"type": "subtitle", "time": 13791.79, "timestamp": "03:49:51", "text": "[音楽]"}, {"type": "subtitle", "time": 13797.87, "timestamp": "03:49:57", "text": "データと"}]
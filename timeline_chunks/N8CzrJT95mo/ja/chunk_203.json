[{"type": "subtitle", "time": 12183.19, "timestamp": "03:23:03", "text": "ああ、とにかく、貼り付けボタン。削除させてください"}, {"type": "subtitle", "time": 12184.99, "timestamp": "03:23:04", "text": "これはそうしないように"}, {"type": "subtitle", "time": 12187.51, "timestamp": "03:23:07", "text": "トリガー。そして私たちはいくつかを変える必要がある"}, {"type": "subtitle", "time": 12191.03, "timestamp": "03:23:11", "text": "もの。これを並べ替えてみましょう。それはあまりにも"}, {"type": "subtitle", "time": 12193.95, "timestamp": "03:23:13", "text": "散らかりすぎている。"}, {"type": "subtitle", "time": 12197.83, "timestamp": "03:23:17", "text": "コメント。私はこれらの人たち全員をチェックして"}, {"type": "subtitle", "time": 12200.429, "timestamp": "03:23:20", "text": "ただ"}, {"type": "subtitle", "time": 12204.95, "timestamp": "03:23:24", "text": "えっと、これらの人たち全員をここに載せてください。隠れる"}, {"type": "subtitle", "time": 12207.269, "timestamp": "03:23:27", "text": "それ。残りのものは必要ない。"}, {"type": "subtitle", "time": 12211.63, "timestamp": "03:23:31", "text": "必要なのはこの３つだけです。"}, {"type": "subtitle", "time": 12215.19, "timestamp": "03:23:35", "text": "さあ、勉強の時間だ。うーん、わからない"}, {"type": "subtitle", "time": 12221.03, "timestamp": "03:23:41", "text": "えーと、ところで、新しいアップデートは"}, {"type": "subtitle", "time": 12223.229, "timestamp": "03:23:43", "text": "ストリーム うーうー"}, {"type": "subtitle", "time": 12225.75, "timestamp": "03:23:45", "text": "ストリームボードのストリームボットの新しいアップデート"}, {"type": "subtitle", "time": 12228.309, "timestamp": "03:23:48", "text": "スイッチケースなど全てが手に入ります"}, {"type": "subtitle", "time": 12231.95, "timestamp": "03:23:51", "text": "私の理解が正しければ。新しいアップデートは届きましたか？"}, {"type": "subtitle", "time": 12235.19, "timestamp": "03:23:55", "text": "また？いいえ、新しいbはベータ版ですよね？"}, {"type": "subtitle", "time": 12237.67, "timestamp": "03:23:57", "text": "ストリーマー３か１か何かか"}, {"type": "subtitle", "time": 12239.63, "timestamp": "03:23:59", "text": "3つか何かのダークモード"}]
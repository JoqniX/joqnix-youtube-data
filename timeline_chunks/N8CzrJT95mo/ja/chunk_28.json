[{"type": "subtitle", "time": 1685.83, "timestamp": "00:28:05", "text": "わかった。私は"}, {"type": "subtitle", "time": 1688.87, "timestamp": "00:28:08", "text": "えっと、なんでまだお腹が空いてるんだろう？"}, {"type": "subtitle", "time": 1696.19, "timestamp": "00:28:16", "text": "お腹がすいた。僕は腹ペコの少年です"}, {"type": "subtitle", "time": 1699.07, "timestamp": "00:28:19", "text": "今。"}, {"type": "subtitle", "time": 1718.07, "timestamp": "00:28:38", "text": "[音楽]"}]
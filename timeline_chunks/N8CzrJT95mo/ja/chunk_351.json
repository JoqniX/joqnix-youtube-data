[{"type": "subtitle", "time": 21063.67, "timestamp": "05:51:03", "text": "えっと、変数を分離するにはどうすればいいですか？"}, {"type": "subtitle", "time": 21067.19, "timestamp": "05:51:07", "text": "弦？そうねぇ。配列を変換して"}, {"type": "subtitle", "time": 21070.15, "timestamp": "05:51:10", "text": "物体。えっと、オブジェクトに渡します。形式"}, {"type": "subtitle", "time": 21072.47, "timestamp": "05:51:12", "text": "文字列に変換します。配列のフォーマットはどのように"}, {"type": "subtitle", "time": 21073.948, "timestamp": "05:51:13", "text": "文字列に"}, {"type": "subtitle", "time": 21077.35, "timestamp": "05:51:17", "text": "効果は？配列の名前。値はどうですか"}, {"type": "subtitle", "time": 21079.47, "timestamp": "05:51:19", "text": "配列の値がどのように"}, {"type": "subtitle", "time": 21082.948, "timestamp": "05:51:22", "text": "分離して文字列を指定するか、待機します"}, {"type": "subtitle", "time": 21086.01, "timestamp": "05:51:26", "text": "それを"}, {"type": "subtitle", "time": 21088.19, "timestamp": "05:51:28", "text": "[音楽]"}, {"type": "subtitle", "time": 21090.27, "timestamp": "05:51:30", "text": "価値"}, {"type": "subtitle", "time": 21094.47, "timestamp": "05:51:34", "text": "いいえ、すべてを評価する方法はありません。ああ、待って"}, {"type": "subtitle", "time": 21097.03, "timestamp": "05:51:37", "text": "それが対象である場合、オブジェクトはどうなりますか？"}, {"type": "subtitle", "time": 21100.15, "timestamp": "05:51:40", "text": "配列オブジェクトオブジェクトを渡す機能も"}, {"type": "subtitle", "time": 21102.19, "timestamp": "05:51:42", "text": "配列オブジェクトを文字列化する"}, {"type": "subtitle", "time": 21105.75, "timestamp": "05:51:45", "text": "いいえ、それは配列からオブジェクトへの瞬間です"}, {"type": "subtitle", "time": 21107.15, "timestamp": "05:51:47", "text": "一瞬。"}, {"type": "subtitle", "time": 21110.31, "timestamp": "05:51:50", "text": "いいえ、別の方法は、ポジションを置くことです"}, {"type": "subtitle", "time": 21113.03, "timestamp": "05:51:53", "text": "配列の番号。これで終わりだ"}]
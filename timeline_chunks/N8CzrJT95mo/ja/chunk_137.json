[{"type": "subtitle", "time": 8220.75, "timestamp": "02:17:00", "text": "蝶。さあ"}, {"type": "subtitle", "time": 8223.709, "timestamp": "02:17:03", "text": "行く。 1"}, {"type": "subtitle", "time": 8227.349, "timestamp": "02:17:07", "text": "午前。火事のようだ。"}, {"type": "subtitle", "time": 8229.07, "timestamp": "02:17:09", "text": "そうなんですか？私はしません"}, {"type": "subtitle", "time": 8232.389, "timestamp": "02:17:12", "text": "知る。このエリア"}, {"type": "subtitle", "time": 8235.27, "timestamp": "02:17:15", "text": "もっと近づけてください。"}, {"type": "subtitle", "time": 8238.99, "timestamp": "02:17:18", "text": "よし、この３つを作った"}, {"type": "subtitle", "time": 8241.469, "timestamp": "02:17:21", "text": "もの。"}, {"type": "subtitle", "time": 8246.349, "timestamp": "02:17:26", "text": "よし、みんな、やったぞ。で"}, {"type": "subtitle", "time": 8255.83, "timestamp": "02:17:35", "text": "私は三目並べしかできなかった。"}, {"type": "subtitle", "time": 8258.709, "timestamp": "02:17:38", "text": "大丈夫。しかし私たちは最善を尽くしました"}, {"type": "subtitle", "time": 8271.309, "timestamp": "02:17:51", "text": "光らせることはできません。光らせることはできません。うん、"}, {"type": "subtitle", "time": 8275.87, "timestamp": "02:17:55", "text": "わーい。初めての折り紙。やったよ。"}, {"type": "subtitle", "time": 8279.91, "timestamp": "02:17:59", "text": "うん。どうやって写真を撮ればいいですか？私はできる"}]
[{"type": "subtitle", "time": 3000.549, "timestamp": "00:50:00", "text": "あなたがここにいるように。 Jokix OST。えっと、やめて"}, {"type": "subtitle", "time": 3002.63, "timestamp": "00:50:02", "text": "私のことは忘れてください。私たちのプロとしての約束は今も変わりません。"}, {"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "OST バージョン2 破れた約束 破れた"}, {"type": "subtitle", "time": 3014.51, "timestamp": "00:50:14", "text": "1つ。どこにある"}, {"type": "subtitle", "time": 3018.15, "timestamp": "00:50:18", "text": "プレイリスト？理解できません。そこで使われた"}, {"type": "subtitle", "time": 3027.71, "timestamp": "00:50:27", "text": "ここ。彼はその曲を非公開にしたのか、それとも"}, {"type": "subtitle", "time": 3033.87, "timestamp": "00:50:33", "text": "これらは"}, {"type": "subtitle", "time": 3034.88, "timestamp": "00:50:34", "text": "彼らの"}, {"type": "subtitle", "time": 3036.99, "timestamp": "00:50:36", "text": "[音楽]"}, {"type": "subtitle", "time": 3045.15, "timestamp": "00:50:45", "text": "再投稿。"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "はぁ。ええ、全部で10曲あります"}, {"type": "subtitle", "time": 3049.79, "timestamp": "00:50:49", "text": "私は"}]
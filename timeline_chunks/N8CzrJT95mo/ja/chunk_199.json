[{"type": "subtitle", "time": 11948.269, "timestamp": "03:19:08", "text": "それ。"}, {"type": "subtitle", "time": 11950.63, "timestamp": "03:19:10", "text": "うん。さあ、あなたの"}, {"type": "subtitle", "time": 11954.469, "timestamp": "03:19:14", "text": "代替。いいえ、大丈夫です。あらら。私の"}, {"type": "subtitle", "time": 11957.75, "timestamp": "03:19:17", "text": "代替案？ああ、大変だ。書かなくてよかった"}, {"type": "subtitle", "time": 11960.229, "timestamp": "03:19:20", "text": "名前。ええ、これらはこれらのシーンでした"}, {"type": "subtitle", "time": 11965.349, "timestamp": "03:19:25", "text": "これらは音楽用のサブアカウント用です。私"}, {"type": "subtitle", "time": 11968.309, "timestamp": "03:19:28", "text": "実際にこのように浄化することは本当に"}, {"type": "subtitle", "time": 11971.99, "timestamp": "03:19:31", "text": "小さなOBSシーン。これは小さい。私は"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "87シーンある。私は持っています 私は以前持っていました"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "複雑な仕組みだ。"}, {"type": "subtitle", "time": 11980.229, "timestamp": "03:19:40", "text": "なぜ要約したのか？これは"}, {"type": "subtitle", "time": 11983.83, "timestamp": "03:19:43", "text": "ストリーミング用PCですが、このPCはスペックが低いです。私は持っている"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "多くのことを制限する。はい、"}, {"type": "subtitle", "time": 11988.11, "timestamp": "03:19:48", "text": "これはしない方がいいと思う。"}, {"type": "subtitle", "time": 11991.269, "timestamp": "03:19:51", "text": "ええと、これはやりません。私にさせてください、"}, {"type": "subtitle", "time": 11992.269, "timestamp": "03:19:52", "text": "私にさせて"}, {"type": "subtitle", "time": 11996.15, "timestamp": "03:19:56", "text": "私：いいえ、ラボの管理は削除します。"}]
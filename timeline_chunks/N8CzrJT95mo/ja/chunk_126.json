[{"type": "subtitle", "time": 7561.75, "timestamp": "02:06:01", "text": "私は文字通りジョックの目の前にいた"}, {"type": "subtitle", "time": 7565.35, "timestamp": "02:06:05", "text": "家。わかった。そして私は泣いていた"}, {"type": "subtitle", "time": 7568.39, "timestamp": "02:06:08", "text": "楽屋にいたのは、文字通り"}, {"type": "subtitle", "time": 7571.189, "timestamp": "02:06:11", "text": "彼の家の前、"}, {"type": "subtitle", "time": 7573.589, "timestamp": "02:06:13", "text": "しかし、私たちには会う方法が全くなかった。そして"}, {"type": "subtitle", "time": 7577.35, "timestamp": "02:06:17", "text": "ジョックは高熱を出していた。ああ、そうだね。私"}, {"type": "subtitle", "time": 7580.55, "timestamp": "02:06:20", "text": "その日は熱があったんですね？"}, {"type": "subtitle", "time": 7582.629, "timestamp": "02:06:22", "text": "雨が降っていたので、"}, {"type": "subtitle", "time": 7586.87, "timestamp": "02:06:26", "text": "ジョックはまさに​​そのために走り去るだろう。あなた"}, {"type": "subtitle", "time": 7589.91, "timestamp": "02:06:29", "text": "ご存知の通り、私たちは既に会っています。"}, {"type": "subtitle", "time": 7594.229, "timestamp": "02:06:34", "text": "ひどい出来だ。そして、私の弟が来る。私たちは"}, {"type": "subtitle", "time": 7597.75, "timestamp": "02:06:37", "text": "再び勝つチャンスがさらに増える。"}, {"type": "subtitle", "time": 7604.51, "timestamp": "02:06:44", "text": "[音楽]"}, {"type": "subtitle", "time": 7615.75, "timestamp": "02:06:55", "text": "何"}, {"type": "subtitle", "time": 7619.75, "timestamp": "02:06:59", "text": "内部？内側の両角を太字にする。"}]
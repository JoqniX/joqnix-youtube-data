[{"type": "subtitle", "time": 1921.07, "timestamp": "00:32:01", "text": "これを歌う"}, {"type": "subtitle", "time": 1923.269, "timestamp": "00:32:03", "text": "クロ。そうそう。私はできなかった"}, {"type": "subtitle", "time": 1933.75, "timestamp": "00:32:13", "text": "あなたは、何がジョークなのか不思議に思っているでしょう。私"}, {"type": "subtitle", "time": 1936.789, "timestamp": "00:32:16", "text": "これを確認してください。ストライキを起こしたんだ"}, {"type": "subtitle", "time": 1941.35, "timestamp": "00:32:21", "text": "YouTubeで私のチャンネルのストライキが終了しました"}, {"type": "subtitle", "time": 1944.549, "timestamp": "00:32:24", "text": "私がやっていた時に"}, {"type": "subtitle", "time": 1948.23, "timestamp": "00:32:28", "text": "日本語学習コースどうやら私は"}, {"type": "subtitle", "time": 1951.59, "timestamp": "00:32:31", "text": "私の教科書は、私は手に入れようとしました"}, {"type": "subtitle", "time": 1953.75, "timestamp": "00:32:33", "text": "PDF版はオンラインで入手可能です。そしてどうやらそれは"}, {"type": "subtitle", "time": 1957.11, "timestamp": "00:32:37", "text": "それは海賊版だったので、警告を受けました。"}, {"type": "subtitle", "time": 1958.509, "timestamp": "00:32:38", "text": "その本から"}, {"type": "subtitle", "time": 1962.99, "timestamp": "00:32:42", "text": "出版社。どういうわけか分からないけど、"}, {"type": "subtitle", "time": 1966.389, "timestamp": "00:32:46", "text": "もの。わかった。スクリーンショットは"}, {"type": "subtitle", "time": 1968.99, "timestamp": "00:32:48", "text": "アップロードしました。それは良い。それは"}, {"type": "subtitle", "time": 1971.669, "timestamp": "00:32:51", "text": "終わり。私たちが追加した歌を歌ってください"}, {"type": "subtitle", "time": 1978.789, "timestamp": "00:32:58", "text": "エイブルトン。追加しておかなければならない。追加する"}]
[{"type": "subtitle", "time": 18183.31, "timestamp": "05:03:03", "text": "ビデオIDなし"}, {"type": "subtitle", "time": 18201.83, "timestamp": "05:03:21", "text": "[音楽]"}, {"type": "subtitle", "time": 18203.948, "timestamp": "05:03:23", "text": "しかしもし"}, {"type": "subtitle", "time": 18208.27, "timestamp": "05:03:28", "text": "テキストをその場で入力すると"}, {"type": "subtitle", "time": 18210.27, "timestamp": "05:03:30", "text": "それ"}, {"type": "subtitle", "time": 18213.23, "timestamp": "05:03:33", "text": "外"}, {"type": "subtitle", "time": 18217.27, "timestamp": "05:03:37", "text": "読みたいと思ったら最高"}, {"type": "subtitle", "time": 18219.23, "timestamp": "05:03:39", "text": "の最後に追加する"}, {"type": "subtitle", "time": 18222.708, "timestamp": "05:03:42", "text": "そのビデオリストをコマンドで指定してください。えっと、私の脳は"}, {"type": "subtitle", "time": 18225.948, "timestamp": "05:03:45", "text": "今は頭が働かない。私はとてもああ"}, {"type": "subtitle", "time": 18229.75, "timestamp": "05:03:49", "text": "神。わかった。待って。ああ、わかった。ビデオ。何が"}, {"type": "subtitle", "time": 18232.03, "timestamp": "05:03:52", "text": "これ？ビデオ"}, {"type": "subtitle", "time": 18235.11, "timestamp": "05:03:55", "text": "ID。えっ、私が今作ったの？"}, {"type": "subtitle", "time": 18238.43, "timestamp": "05:03:58", "text": "ああ、わかりました。おお。おお、"}]
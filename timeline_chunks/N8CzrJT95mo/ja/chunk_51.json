[{"type": "subtitle", "time": 3063.15, "timestamp": "00:51:03", "text": "えっと、"}, {"type": "subtitle", "time": 3067.03, "timestamp": "00:51:07", "text": "英語力が低すぎる。大丈夫。しないで"}, {"type": "subtitle", "time": 3069.309, "timestamp": "00:51:09", "text": "心配。その"}, {"type": "subtitle", "time": 3081.23, "timestamp": "00:51:21", "text": "心配事。そしてこれが最新の事例だ。"}, {"type": "subtitle", "time": 3085.069, "timestamp": "00:51:25", "text": "コンステラ・プロジェニエーター 2ヶ月前"}, {"type": "subtitle", "time": 3089.99, "timestamp": "00:51:29", "text": "前。もっと良くできるはずだ。笑。"}, {"type": "subtitle", "time": 3098.23, "timestamp": "00:51:38", "text": "悲しい。私は、"}, {"type": "subtitle", "time": 3100.63, "timestamp": "00:51:40", "text": "プレイリストに保存しておけるように。なぜ"}, {"type": "subtitle", "time": 3103.19, "timestamp": "00:51:43", "text": "プレイリストが見つからないのですが？私は覚えています"}, {"type": "subtitle", "time": 3105.19, "timestamp": "00:51:45", "text": "ここからダウンロードするんですよね？私にさせて"}, {"type": "subtitle", "time": 3111.5, "timestamp": "00:51:51", "text": "それ。どこですか？黄色が昇る"}, {"type": "subtitle", "time": 3113.71, "timestamp": "00:51:53", "text": "[音楽]"}, {"type": "subtitle", "time": 3118.67, "timestamp": "00:51:58", "text": "星。どこにいるの？私"}]
[{"type": "subtitle", "time": 19082.15, "timestamp": "05:18:02", "text": "同じ名前にアンダースコアの太さを追加する"}, {"type": "subtitle", "time": 19085.03, "timestamp": "05:18:05", "text": "名前に追加して値を追加"}, {"type": "subtitle", "time": 19087.39, "timestamp": "05:18:07", "text": "それは"}, {"type": "subtitle", "time": 19089.47, "timestamp": "05:18:09", "text": "重み。"}, {"type": "subtitle", "time": 19092.91, "timestamp": "05:18:12", "text": "重さ。わかった。待って、これは"}, {"type": "subtitle", "time": 19096.23, "timestamp": "05:18:16", "text": "これ？ランダム配列値を取得する"}, {"type": "subtitle", "time": 19098.47, "timestamp": "05:18:18", "text": "さまざまな可能性で。ランダムなアイテムを取得します"}, {"type": "subtitle", "time": 19100.628, "timestamp": "05:18:20", "text": "動物の体重に基づく動物配列"}, {"type": "subtitle", "time": 19104.47, "timestamp": "05:18:24", "text": "配列。ウサギが出る確率は50％です。 30%"}, {"type": "subtitle", "time": 19107.35, "timestamp": "05:18:27", "text": "犬のチャンス。わかった。動物。わかった。"}, {"type": "subtitle", "time": 19110.15, "timestamp": "05:18:30", "text": "動物、そして新しい動物の体重の配列。"}, {"type": "subtitle", "time": 19114.31, "timestamp": "05:18:34", "text": "動物、猫、犬、ウサギ、動物"}, {"type": "subtitle", "time": 19116.708, "timestamp": "05:18:36", "text": "重さ。ああ、待って、チャンスがあるよ。わかった。"}, {"type": "subtitle", "time": 19117.788, "timestamp": "05:18:37", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 19120.35, "timestamp": "05:18:40", "text": "わかった。そして配列"}, {"type": "subtitle", "time": 19123.11, "timestamp": "05:18:43", "text": "ランダムな動物の値はランダムになります"}, {"type": "subtitle", "time": 19126.628, "timestamp": "05:18:46", "text": "動物。わかった。動物の種類は問いません。あなた"}]
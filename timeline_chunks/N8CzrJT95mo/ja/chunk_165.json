[{"type": "subtitle", "time": 9901.23, "timestamp": "02:45:01", "text": "よし、これが唯一の"}, {"type": "subtitle", "time": 9904.95, "timestamp": "02:45:04", "text": "それは物ですか？チケットがあります。ああ、君"}, {"type": "subtitle", "time": 9906.75, "timestamp": "02:45:06", "text": "支払う必要はありません"}, {"type": "subtitle", "time": 9909.91, "timestamp": "02:45:09", "text": "無料。私たちはゲーミングスマートフォンの追跡者です"}, {"type": "subtitle", "time": 9912.51, "timestamp": "02:45:12", "text": "このスマートフォンのすべて。"}, {"type": "subtitle", "time": 9914.36, "timestamp": "02:45:14", "text": "えっと、私は"}, {"type": "subtitle", "time": 9916.11, "timestamp": "02:45:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9920.63, "timestamp": "02:45:20", "text": "支払う。みんなで楽しむことができます"}, {"type": "subtitle", "time": 9923.03, "timestamp": "02:45:23", "text": "アーティストのパフォーマンスを楽しむことができます"}, {"type": "subtitle", "time": 9926.79, "timestamp": "02:45:26", "text": "チケット付きで、他のコンテンツはすべて"}, {"type": "subtitle", "time": 9928.269, "timestamp": "02:45:28", "text": "利用可能"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "無料。ああ、わかりました。わかった。待って、私は"}, {"type": "subtitle", "time": 9934.51, "timestamp": "02:45:34", "text": "これをお見せできます。ええと、どうやら"}, {"type": "subtitle", "time": 9937.15, "timestamp": "02:45:37", "text": "えっと、行く"}, {"type": "subtitle", "time": 9940.71, "timestamp": "02:45:40", "text": "どうやら、この穴は待っていられるようです"}, {"type": "subtitle", "time": 9942.83, "timestamp": "02:45:42", "text": "こちらです。待って、"}, {"type": "subtitle", "time": 9952.389, "timestamp": "02:45:52", "text": "何？ああ、これが見えますか？えっと、5月"}, {"type": "subtitle", "time": 9959.81, "timestamp": "02:45:59", "text": "何？これらのうちいくつかは見覚えがある"}]
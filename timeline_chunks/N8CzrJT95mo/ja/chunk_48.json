[{"type": "subtitle", "time": 2882.309, "timestamp": "00:48:02", "text": "うん。歌。彼らはあなたのために曲を作ったのです。"}, {"type": "subtitle", "time": 2886.39, "timestamp": "00:48:06", "text": "リアリティ・スタジオ・アイゼンが私のために曲を作ってくれた。"}, {"type": "subtitle", "time": 2889.109, "timestamp": "00:48:09", "text": "昨日、確かに姿を見せましたよね？いいえ、私は"}, {"type": "subtitle", "time": 2892.15, "timestamp": "00:48:12", "text": "そうしなかった。信じられない。なんてこった。それは、"}, {"type": "subtitle", "time": 2895.349, "timestamp": "00:48:15", "text": "実際はSoundCloudです。私が"}, {"type": "subtitle", "time": 2897.15, "timestamp": "00:48:17", "text": "プラットフォーム、外国人が来るかもしれない"}, {"type": "subtitle", "time": 2899.15, "timestamp": "00:48:19", "text": "Webサイト"}, {"type": "subtitle", "time": 2902.63, "timestamp": "00:48:22", "text": "罰則。 Soundcloudにあります。"}, {"type": "subtitle", "time": 2905.51, "timestamp": "00:48:25", "text": "オリジナルの時間。うん、捧げられた歌"}, {"type": "subtitle", "time": 2909.63, "timestamp": "00:48:29", "text": "私にとってそれはファンメイドの曲です。"}, {"type": "subtitle", "time": 2912.75, "timestamp": "00:48:32", "text": "だから"}, {"type": "subtitle", "time": 2915.589, "timestamp": "00:48:35", "text": "ウォッカの制限。大丈夫。入力してください"}, {"type": "subtitle", "time": 2918.39, "timestamp": "00:48:38", "text": "中国語。私の中国語で入力してください。"}, {"type": "subtitle", "time": 2925.349, "timestamp": "00:48:45", "text": "彼が追加したプレイリストを探しています"}, {"type": "subtitle", "time": 2926.91, "timestamp": "00:48:46", "text": "私の歌"}, {"type": "subtitle", "time": 2929.15, "timestamp": "00:48:49", "text": "の上。"}, {"type": "subtitle", "time": 2933.069, "timestamp": "00:48:53", "text": "えっと、それはどこにあるんですか？チョコレート"}, {"type": "subtitle", "time": 2937.27, "timestamp": "00:48:57", "text": "次。うん。ああ、曲を作って"}]
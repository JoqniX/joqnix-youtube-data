[{"type": "subtitle", "time": 62.15, "timestamp": "00:01:02", "text": "ビリー、私はEPに行くよ。 EPではありません。最後に"}, {"type": "subtitle", "time": 65.95, "timestamp": "00:01:05", "text": "配信を中断して、後ほど戻ってきます。それで"}, {"type": "subtitle", "time": 80.63, "timestamp": "00:01:20", "text": "238. 真夜中を過ぎて"}, {"type": "subtitle", "time": 100.99000000000001, "timestamp": "00:01:40", "text": "私はそうしました"}, {"type": "subtitle", "time": 103.55, "timestamp": "00:01:43", "text": "それ。"}, {"type": "subtitle", "time": 105.46000000000001, "timestamp": "00:01:45", "text": "ついに。私を連れて行った"}, {"type": "subtitle", "time": 107.87, "timestamp": "00:01:47", "text": "[音楽]"}, {"type": "subtitle", "time": 110.91, "timestamp": "00:01:50", "text": "永遠に。みんな"}]
[{"type": "subtitle", "time": 6850.709, "timestamp": "01:54:10", "text": "折りたたむことができます。折りたたむと"}, {"type": "subtitle", "time": 6854.99, "timestamp": "01:54:14", "text": "地面に横たわって、それを押してください。"}, {"type": "subtitle", "time": 6857.83, "timestamp": "01:54:17", "text": "そう、それをやった後は、それを乗せる"}, {"type": "subtitle", "time": 6885.91, "timestamp": "01:54:45", "text": "いや、難しい。私はフォローするのが本当に苦手です"}, {"type": "subtitle", "time": 6887.47, "timestamp": "01:54:47", "text": "何でも"}, {"type": "subtitle", "time": 6892.709, "timestamp": "01:54:52", "text": "私にとっては、これは正真正銘のドラマです。大丈夫。正真正銘"}, {"type": "subtitle", "time": 6894.39, "timestamp": "01:54:54", "text": "ドラマ。"}, {"type": "subtitle", "time": 6897.99, "timestamp": "01:54:57", "text": "いいえ、大丈夫です。大丈夫、できるよ。私が案内します"}, {"type": "subtitle", "time": 6898.99, "timestamp": "01:54:58", "text": "あなた。"}]
[{"type": "subtitle", "time": 2522.71, "timestamp": "00:42:02", "text": "インストゥルメンタル。えっと、今日の調子はどうですか？"}, {"type": "subtitle", "time": 2523.95, "timestamp": "00:42:03", "text": "こんにちは、"}, {"type": "subtitle", "time": 2554.39, "timestamp": "00:42:34", "text": "キロ。はい、完了しました。そして完全な"}, {"type": "subtitle", "time": 2556.67, "timestamp": "00:42:36", "text": "曲は"}, {"type": "subtitle", "time": 2560.27, "timestamp": "00:42:40", "text": "これについて説明しましょう。"}, {"type": "subtitle", "time": 2564.63, "timestamp": "00:42:44", "text": "今。インド出身なら、アレンと呼んでください。わかった。"}, {"type": "subtitle", "time": 2569.109, "timestamp": "00:42:49", "text": "えっと、あなたのユーザー名は"}, {"type": "subtitle", "time": 2572.71, "timestamp": "00:42:52", "text": "中国人はそうではないので、私にとっては難しいでしょう"}, {"type": "subtitle", "time": 2576.99, "timestamp": "00:42:56", "text": "でも最善を尽くします"}, {"type": "subtitle", "time": 2579.71, "timestamp": "00:42:59", "text": "覚えて。私は試してみます"}]
[{"type": "subtitle", "time": 17469.868, "timestamp": "04:51:09", "text": "一般的なラジオを作るためにこれを使用します"}, {"type": "subtitle", "time": 17481.19, "timestamp": "04:51:21", "text": "はぁ？動画のリストを入手したら、"}, {"type": "subtitle", "time": 17483.43, "timestamp": "04:51:23", "text": "フィルタリングする必要がある"}, {"type": "subtitle", "time": 17485.83, "timestamp": "04:51:25", "text": "ライブ配信の公開日に基づいて"}, {"type": "subtitle", "time": 17487.59, "timestamp": "04:51:27", "text": "ストリーム。あなたが欲しいのは、"}, {"type": "subtitle", "time": 17491.11, "timestamp": "04:51:31", "text": "その前後両方で出版"}, {"type": "subtitle", "time": 17492.35, "timestamp": "04:51:32", "text": "日付。"}, {"type": "subtitle", "time": 17495.03, "timestamp": "04:51:35", "text": "わかった。動画リストをループ再生する"}, {"type": "subtitle", "time": 17497.03, "timestamp": "04:51:37", "text": "そしてライブストリームと照らし合わせて確認する"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "エリアのビデオのリストを作成する日"}, {"type": "subtitle", "time": 17500.27, "timestamp": "04:51:40", "text": "含めたいアイテム"}, {"type": "subtitle", "time": 17504.43, "timestamp": "04:51:44", "text": "プレイリスト。はぁ？はぁ？"}]
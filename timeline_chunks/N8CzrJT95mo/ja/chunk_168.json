[{"type": "subtitle", "time": 10082.19, "timestamp": "02:48:02", "text": "おお。おお"}, {"type": "subtitle", "time": 10090.469, "timestamp": "02:48:10", "text": "グループは15分後にスタートする"}, {"type": "subtitle", "time": 10093.03, "timestamp": "02:48:13", "text": "分。話題は何でしたっけ？何"}, {"type": "subtitle", "time": 10095.349, "timestamp": "02:48:15", "text": "あなたの国にはどのような習慣がありますか？"}, {"type": "subtitle", "time": 10098.469, "timestamp": "02:48:18", "text": "バレンタインデーに？チャットで誰か"}, {"type": "subtitle", "time": 10101.11, "timestamp": "02:48:21", "text": "インド出身の人が私に教えてくれることは"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "私たちが持つすべての慣習は何ですか？繰り返しますが、私は"}, {"type": "subtitle", "time": 10106.59, "timestamp": "02:48:26", "text": "私たちには特定の習慣があると思います。"}, {"type": "subtitle", "time": 10109.309, "timestamp": "02:48:29", "text": "右？ごく普通のことです。"}, {"type": "subtitle", "time": 10116.79, "timestamp": "02:48:36", "text": "日中は、ごく普通の日常的な出来事です"}, {"type": "subtitle", "time": 10126.269, "timestamp": "02:48:46", "text": "日。"}, {"type": "subtitle", "time": 10128.67, "timestamp": "02:48:48", "text": "えっと、どこにあるんですか？"}, {"type": "subtitle", "time": 10133.07, "timestamp": "02:48:53", "text": "うん。実例。ああ神様、9人が"}, {"type": "subtitle", "time": 10136.15, "timestamp": "02:48:56", "text": "そこには。ありがとう。参加すべきでしょうか"}, {"type": "subtitle", "time": 10138.95, "timestamp": "02:48:58", "text": "最後の瞬間？待機時に参加すべきでしょうか、"}]
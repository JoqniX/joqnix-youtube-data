[{"type": "subtitle", "time": 5371.31, "timestamp": "01:29:31", "text": "こんにちは"}, {"type": "subtitle", "time": 5373.75, "timestamp": "01:29:33", "text": "偽物だ、今すぐ行け。楽しいストリーミングを！わかった。"}, {"type": "subtitle", "time": 5375.59, "timestamp": "01:29:35", "text": "わかった。おやすみ、兄弟。こんにちは。おやすみ。"}, {"type": "subtitle", "time": 5377.47, "timestamp": "01:29:37", "text": "よく眠る。"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "夜。ああ、喉が詰まって"}, {"type": "subtitle", "time": 5393.31, "timestamp": "01:29:53", "text": "で"}]
[{"type": "subtitle", "time": 3841.109, "timestamp": "01:04:01", "text": "ここ。待って、これをビリーに見せられるよ"}, {"type": "subtitle", "time": 3842.95, "timestamp": "01:04:02", "text": "ビリーのことだよね？アカウント停止処分を受けるでしょうか？私はしません"}, {"type": "subtitle", "time": 3845.789, "timestamp": "01:04:05", "text": "そう思う。さあ、やってみよう"}, {"type": "subtitle", "time": 3853.309, "timestamp": "01:04:13", "text": "わかった。まず"}, {"type": "subtitle", "time": 3858.67, "timestamp": "01:04:18", "text": "ワンポストストリームコケ"}, {"type": "subtitle", "time": 3861.47, "timestamp": "01:04:21", "text": "インストゥルメンタル。わかった。私たちは"}, {"type": "subtitle", "time": 3864.15, "timestamp": "01:04:24", "text": "新曲を3曲入れるんですよね？わかった。それで、"}, {"type": "subtitle", "time": 3866.95, "timestamp": "01:04:26", "text": "インストゥルメンタルを"}, {"type": "subtitle", "time": 3869.589, "timestamp": "01:04:29", "text": "ストリームとフルソングを聴きます"}, {"type": "subtitle", "time": 3873.069, "timestamp": "01:04:33", "text": "私のヘッドホン。つまり、これが最初の"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "歌。聞こえるかどうかわかりませんが、"}, {"type": "subtitle", "time": 3877.95, "timestamp": "01:04:37", "text": "まあ、そうですね。これはオレンジ色です"}, {"type": "subtitle", "time": 3879.91, "timestamp": "01:04:39", "text": "星。だから私は"}, {"type": "subtitle", "time": 3881.39, "timestamp": "01:04:41", "text": "インストゥルメンタル"}, {"type": "subtitle", "time": 3892.67, "timestamp": "01:04:52", "text": "歌。それはその曲ではありません。これ"}]
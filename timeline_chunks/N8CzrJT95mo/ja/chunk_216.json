[{"type": "subtitle", "time": 12960.63, "timestamp": "03:36:00", "text": "サミー。自分のDiscordアカウントを公開していることは承知しています。"}, {"type": "subtitle", "time": 12963.19, "timestamp": "03:36:03", "text": "ごめんなさい。えっと、これが私がやっていることです"}, {"type": "subtitle", "time": 12965.349, "timestamp": "03:36:05", "text": "言うのは構わない。サミーはどこにいるの？どこ"}, {"type": "subtitle", "time": 12967.229, "timestamp": "03:36:07", "text": "サミー？わかった。"}, {"type": "subtitle", "time": 12969.71, "timestamp": "03:36:09", "text": "待って。パッチ"}, {"type": "subtitle", "time": 12973.83, "timestamp": "03:36:13", "text": "注記。これを見た記憶がある。こんにちは"}, {"type": "subtitle", "time": 12975.469, "timestamp": "03:36:15", "text": "太陽。"}, {"type": "subtitle", "time": 12980.229, "timestamp": "03:36:20", "text": "いらっしゃいませ。わかった。待って。これを公開してください。"}, {"type": "subtitle", "time": 12982.59, "timestamp": "03:36:22", "text": "うーん"}, {"type": "subtitle", "time": 12988.11, "timestamp": "03:36:28", "text": "センシティブ。わかった。待って、できないよ"}, {"type": "subtitle", "time": 12990.95, "timestamp": "03:36:30", "text": "それ。私たちは技術的なことをしています"}, {"type": "subtitle", "time": 12993.59, "timestamp": "03:36:33", "text": "配信用の素材。だって、作らなきゃいけないんだもん"}, {"type": "subtitle", "time": 12996.87, "timestamp": "03:36:36", "text": "確かに、ジョアソンはスムーズに運営されています。"}, {"type": "subtitle", "time": 13000.15, "timestamp": "03:36:40", "text": "だから私たちは、"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "ストリームに関するヘルプ。それで私たちは"}, {"type": "subtitle", "time": 13007.349, "timestamp": "03:36:47", "text": "ボタン。少し説明しましょう。だから私たちは"}, {"type": "subtitle", "time": 13009.19, "timestamp": "03:36:49", "text": "今日はボタンについて作業します"}, {"type": "subtitle", "time": 13012.63, "timestamp": "03:36:52", "text": "この男性をどこかで見たことがあるかもしれません。"}, {"type": "subtitle", "time": 13013.87, "timestamp": "03:36:53", "text": "これ"}, {"type": "subtitle", "time": 13017.51, "timestamp": "03:36:57", "text": "男。もしかしたら、このランダムなものを見たことがあるかもしれません"}]
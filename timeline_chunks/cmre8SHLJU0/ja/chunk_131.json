[{"type": "subtitle", "time": 7865.975, "timestamp": "02:11:05", "text": "うわあ、"}, {"type": "subtitle", "time": 7867.51, "timestamp": "02:11:07", "text": "[笑い]"}, {"type": "subtitle", "time": 7870.95, "timestamp": "02:11:10", "text": "兄弟。 あれはすごかった。 私はそれ"}, {"type": "subtitle", "time": 7873.83, "timestamp": "02:11:13", "text": "にとても満足しました。  [息を呑む]"}, {"type": "subtitle", "time": 7883.43, "timestamp": "02:11:23", "text": "私は何を持っているの？ わかった。   では、"}, {"type": "subtitle", "time": 7891.109, "timestamp": "02:11:31", "text": "。 うん、うん、うん。 私も"}, {"type": "subtitle", "time": 7894.47, "timestamp": "02:11:34", "text": "このゲームで同じ経験をしました。"}, {"type": "subtitle", "time": 7903.35, "timestamp": "02:11:43", "text": "2回とも敵は死なず、逆に敵に"}, {"type": "subtitle", "time": 7907.669, "timestamp": "02:11:47", "text": "撃たれて私が死んだ。"}]
[{"type": "subtitle", "time": 2364.23, "timestamp": "00:39:24", "text": "おい、今、指をパチッと鳴らしたのか？"}, {"type": "subtitle", "time": 2368.15, "timestamp": "00:39:28", "text": "彼はそれを軽く弾いたんだよね？"}, {"type": "subtitle", "time": 2375.99, "timestamp": "00:39:35", "text": "私が最多キル数です。  2番目に多い"}, {"type": "subtitle", "time": 2391.43, "timestamp": "00:39:51", "text": "確保する。"}]
[{"type": "subtitle", "time": 1980.389, "timestamp": "00:33:00", "text": "この時点では、"}, {"type": "subtitle", "time": 1988.71, "timestamp": "00:33:08", "text": "よし、ステルスゲームをやろう。 私は"}, {"type": "subtitle", "time": 1993.509, "timestamp": "00:33:13", "text": "学校に行く前の朝からそれを続けています。 いいえ、行きませんでした。"}, {"type": "subtitle", "time": 2000.31, "timestamp": "00:33:20", "text": "今日はパートタイムの仕事に遅刻してしまいました。 結局、私はコール オブ"}, {"type": "subtitle", "time": 2002.389, "timestamp": "00:33:22", "text": "デューティをプレイすることになった。"}, {"type": "subtitle", "time": 2005.43, "timestamp": "00:33:25", "text": "私はピストリータレンズを使っていて、文字通り"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "ああ、レベル7に対してレベル6か"}, {"type": "subtitle", "time": 2027.75, "timestamp": "00:33:47", "text": "。"}, {"type": "subtitle", "time": 2030.95, "timestamp": "00:33:50", "text": "ああ、そもそもロック解除すらしていないんです。"}]
[{"type": "subtitle", "time": 1201.35, "timestamp": "00:20:01", "text": "これはインポートのようなものになります。 つまり、"}, {"type": "subtitle", "time": 1204.39, "timestamp": "00:20:04", "text": "マウスを"}, {"type": "subtitle", "time": 1210.95, "timestamp": "00:20:10", "text": "動かすほど徐々に増加していくということです。 これがそのグラフです。 ええと、"}, {"type": "subtitle", "time": 1213.669, "timestamp": "00:20:13", "text": "これは私が持っているグラフの1つです。 ご覧のとおり、私は"}, {"type": "subtitle", "time": 1216.31, "timestamp": "00:20:16", "text": "2020年からこれを使っています"}, {"type": "subtitle", "time": 1217.99, "timestamp": "00:20:17", "text": "。"}, {"type": "subtitle", "time": 1220.15, "timestamp": "00:20:20", "text": "それで、私は"}, {"type": "subtitle", "time": 1222.87, "timestamp": "00:20:22", "text": "これに慣れているのですが、"}, {"type": "subtitle", "time": 1226.23, "timestamp": "00:20:26", "text": "今はマウスのスペースが小さいので、"}, {"type": "subtitle", "time": 1231.51, "timestamp": "00:20:31", "text": "エイムするときは低い DPI で、"}, {"type": "subtitle", "time": 1234.95, "timestamp": "00:20:34", "text": "移動するときは高い感度で操作する方法が欲しかったんです"}, {"type": "subtitle", "time": 1249.43, "timestamp": "00:20:49", "text": "ねずみ。"}, {"type": "subtitle", "time": 1252.07, "timestamp": "00:20:52", "text": "えっと、Discordで連絡ください。"}, {"type": "subtitle", "time": 1255.43, "timestamp": "00:20:55", "text": "しかし、一体なぜ？"}, {"type": "subtitle", "time": 1259.43, "timestamp": "00:20:59", "text": "ええと、私はそういう風に"}]
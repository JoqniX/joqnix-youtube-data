[{"type": "subtitle", "time": 6437.189, "timestamp": "01:47:17", "text": "生の。 ええと、休憩なしで"}, {"type": "subtitle", "time": 6438.95, "timestamp": "01:47:18", "text": "15時間レコーディングセッションをした後、私の声は限界に達しました"}, {"type": "subtitle", "time": 6441.59, "timestamp": "01:47:21", "text": "。 ああ、"}, {"type": "subtitle", "time": 6444.229, "timestamp": "01:47:24", "text": "その気持ち、よくわかるよ。 私もそれを試してみました"}, {"type": "subtitle", "time": 6447.35, "timestamp": "01:47:27", "text": "。 大変だ。 あなたは"}, {"type": "subtitle", "time": 6449.99, "timestamp": "01:47:29", "text": "それをしてはいけないと知っておくべきでしょうか？   そんなことは絶対にしてはいけない。なぜなら、"}, {"type": "subtitle", "time": 6452.31, "timestamp": "01:47:32", "text": "私は"}, {"type": "subtitle", "time": 6454.47, "timestamp": "01:47:34", "text": "自分の声をコントロールする方法を知らないし、"}, {"type": "subtitle", "time": 6459.03, "timestamp": "01:47:39", "text": "何もかも知らないからだ。 えっと、"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "歌の練習とかしてたから"}, {"type": "subtitle", "time": 6464.47, "timestamp": "01:47:44", "text": "。 以前は、12時間ずっと"}, {"type": "subtitle", "time": 6466.31, "timestamp": "01:47:46", "text": "歌い続ける配信をしていて、いつ"}, {"type": "subtitle", "time": 6473.109, "timestamp": "01:47:53", "text": "止めればいいのか、いつ"}]
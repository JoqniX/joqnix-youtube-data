[{"type": "subtitle", "time": 7980.47, "timestamp": "02:13:00", "text": "レベル上限が30まで引き上げられて、"}, {"type": "subtitle", "time": 7982.79, "timestamp": "02:13:02", "text": "みんなが最終的に"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "彼らがそうするべきだと思う。"}, {"type": "subtitle", "time": 7998.229, "timestamp": "02:13:18", "text": "AKは今、最強の武器だ。"}, {"type": "subtitle", "time": 8001.03, "timestamp": "02:13:21", "text": "そして私が使っているSMGには72発の"}, {"type": "subtitle", "time": 8032.87, "timestamp": "02:13:52", "text": "くそ。"}]
[{"type": "subtitle", "time": 9307.19, "timestamp": "02:35:07", "text": "オーケー。 こんにちは。わかりました。ゲームが"}, {"type": "subtitle", "time": 9319.51, "timestamp": "02:35:19", "text": "とにかく、"}, {"type": "subtitle", "time": 9323.11, "timestamp": "02:35:23", "text": "ゲームを開いてロードしてください。わかりました。ええと、そうですね。もしかしたら"}, {"type": "subtitle", "time": 9325.11, "timestamp": "02:35:25", "text": "これは締めくくりのサインかもしれません"}, {"type": "subtitle", "time": 9330.55, "timestamp": "02:35:30", "text": "が、今日はここで締めくくりましょう"}, {"type": "subtitle", "time": 9342.71, "timestamp": "02:35:42", "text": "そして、"}, {"type": "subtitle", "time": 9345.11, "timestamp": "02:35:45", "text": "ええ、明日が最終日、つまり"}, {"type": "subtitle", "time": 9347.51, "timestamp": "02:35:47", "text": "明日です。ええ、明日が"}, {"type": "subtitle", "time": 9354.63, "timestamp": "02:35:54", "text": "このゲームの早期アクセス、早期アクセス、ピューピュー、早期アクセスの最後の機会です。"}, {"type": "subtitle", "time": 9357.11, "timestamp": "02:35:57", "text": "そして来週はオープン"}, {"type": "subtitle", "time": 9359.91, "timestamp": "02:35:59", "text": "ベータです。ですから、世界中の誰もが"}]
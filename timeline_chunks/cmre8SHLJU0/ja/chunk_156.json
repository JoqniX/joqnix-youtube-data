[{"type": "subtitle", "time": 9364.79, "timestamp": "02:36:04", "text": "金曜日と日曜日の3日間だけ無料でプレイできます"}, {"type": "subtitle", "time": 9366.309, "timestamp": "02:36:06", "text": "。"}, {"type": "subtitle", "time": 9367.91, "timestamp": "02:36:07", "text": "ええと、"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "太平洋標準時です。ですから、"}, {"type": "subtitle", "time": 9372.63, "timestamp": "02:36:12", "text": "私にとっては土曜日、"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "日曜日、月曜日、そして月曜日もそうです。"}, {"type": "subtitle", "time": 9379.59, "timestamp": "02:36:19", "text": "ええ、"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "月曜日の午前6時頃までだと思います。"}, {"type": "subtitle", "time": 9385.91, "timestamp": "02:36:25", "text": "ええ。でも、"}, {"type": "subtitle", "time": 9393.429, "timestamp": "02:36:33", "text": "それから、言い忘れていましたが、日曜日は"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "新宿に行くので、おそらく配信はしません。"}, {"type": "subtitle", "time": 9411.03, "timestamp": "02:36:51", "text": "そして、皆さんに感謝します。 来てくれた人たち"}]
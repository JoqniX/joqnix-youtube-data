[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "あなたはプロの試合を観ますか？"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "小さい頃、よく見ていました。"}, {"type": "subtitle", "time": 969.03, "timestamp": "00:16:09", "text": "何？ 何？ 例えば、ランディが10歳以上で、"}, {"type": "subtitle", "time": 972.23, "timestamp": "00:16:12", "text": "それからジョン・シナやザ・ロックなどが昔やっていた"}, {"type": "subtitle", "time": 974.15, "timestamp": "00:16:14", "text": "頃。 いいえ、以前は見ていました"}, {"type": "subtitle", "time": 984.31, "timestamp": "00:16:24", "text": "学校から帰ってくると、いつもそれを見ていました。 確か小学"}, {"type": "chat", "time": 1006.958, "timestamp": "00:16:46", "author": "@GoojiiBot", "avatar": "https://yt4.ggpht.com/mPYgxFLpVlEw3IlqLJvO23Nw3qURJpHaR1vq7WFEWKVvRh1eRhQtoaGuPnjptIVN3y8KNCWkr-4=s64-c-k-c0x00ffffff-no-rj", "message": "The legacy those men left behind is just Hall of Fame worthy"}]
[{"type": "subtitle", "time": 3007.99, "timestamp": "00:50:07", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 3009.99, "timestamp": "00:50:09", "text": "。 それは、コール オブ デューティの"}, {"type": "subtitle", "time": 3012.71, "timestamp": "00:50:12", "text": "プレイヤーがスプリントしながらスライディングして"}, {"type": "subtitle", "time": 3017.829, "timestamp": "00:50:17", "text": "射撃する様子を指す。"}, {"type": "subtitle", "time": 3056.63, "timestamp": "00:50:56", "text": "ええと、よく分かりませんでした。 私のゲームが"}, {"type": "subtitle", "time": 3057.67, "timestamp": "00:50:57", "text": "危険にさらされました。"}]
[{"type": "subtitle", "time": 6739.189, "timestamp": "01:52:19", "text": "ああ、あと少しだったのに"}, {"type": "subtitle", "time": 6743.43, "timestamp": "01:52:23", "text": "。 ああ、でも"}, {"type": "subtitle", "time": 6746.79, "timestamp": "01:52:26", "text": "今は避けるのが難しいんだよ。 問題は、"}, {"type": "subtitle", "time": 6751.83, "timestamp": "01:52:31", "text": "今、私が何を言っていいのか分からないということです。 私はいつも"}, {"type": "subtitle", "time": 6764.79, "timestamp": "01:52:44", "text": "自分の声は良い時もあれば、"}, {"type": "subtitle", "time": 6771.669, "timestamp": "01:52:51", "text": "思います。 私もいつもそう感じています"}, {"type": "subtitle", "time": 6774.95, "timestamp": "01:52:54", "text": "。"}]
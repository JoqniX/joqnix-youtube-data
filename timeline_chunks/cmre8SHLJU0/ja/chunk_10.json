[{"type": "subtitle", "time": 602.07, "timestamp": "00:10:02", "text": "でも正直に言うと、もし私に聞かれたら、"}, {"type": "subtitle", "time": 611.59, "timestamp": "00:10:11", "text": "私が見ている配信者が"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "男性か女性かとか、そんなことはどうでもいいと思う。"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "Vチューブに関しては、"}, {"type": "subtitle", "time": 621.03, "timestamp": "00:10:21", "text": "文字通り自分自身であること"}, {"type": "subtitle", "time": 623.59, "timestamp": "00:10:23", "text": "や番組のキャラクターを演じることを楽しんでいるように感じます。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 626.79, "timestamp": "00:10:26", "text": "彼は本当にそうしたんだ、えっと、それも"}, {"type": "subtitle", "time": 632.389, "timestamp": "00:10:32", "text": "一つのことなんだけど、どう"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "どう言えばいいかな？ むしろ、"}, {"type": "subtitle", "time": 643.75, "timestamp": "00:10:43", "text": "誰かが私を"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "別の性別と間違えて番組に出演しているとき、「ああ、"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "誰が彼に教えてあげるんだろう？」って思うような感じ。"}, {"type": "subtitle", "time": 652.47, "timestamp": "00:10:52", "text": "彼の没入感を損ないたくないんです。だって、彼はスポーツマンですからね。スポーツ"}, {"type": "subtitle", "time": 655.99, "timestamp": "00:10:55", "text": "マンは"}, {"type": "subtitle", "time": 658.63, "timestamp": "00:10:58", "text": "キャラクターなので、それも没入感を損なう可能性があります"}]
[{"type": "subtitle", "time": 6003.59, "timestamp": "01:40:03", "text": "よし、水を汲んでくるよ。"}, {"type": "subtitle", "time": 6007.43, "timestamp": "01:40:07", "text": "行く。 えっと、私の配信はまだライブ配信中ですよね？"}, {"type": "subtitle", "time": 6009.109, "timestamp": "01:40:09", "text": "ええ、まだ生きてますよ。 ニース。 ニース。 ニース。"}, {"type": "subtitle", "time": 6011.36, "timestamp": "01:40:11", "text": "ニース。 ブーム。"}, {"type": "subtitle", "time": 6020.55, "timestamp": "01:40:20", "text": "こんにちは。"}]
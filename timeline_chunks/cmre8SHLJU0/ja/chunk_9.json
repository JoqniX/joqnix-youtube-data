[{"type": "subtitle", "time": 552.55, "timestamp": "00:09:12", "text": "私は何年も前からこれに慣れている。 ああ、"}, {"type": "subtitle", "time": 557.67, "timestamp": "00:09:17", "text": "こんにちは。 ようこそ。ようこそ、ようこそ。"}, {"type": "subtitle", "time": 572.949, "timestamp": "00:09:32", "text": "問題は、"}, {"type": "subtitle", "time": 575.67, "timestamp": "00:09:35", "text": "Google などで私を検索すると、BBC の"}, {"type": "subtitle", "time": 578.07, "timestamp": "00:09:38", "text": "記事が出ているからというわけではなく、文字通り、"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "私が"}, {"type": "subtitle", "time": 586.15, "timestamp": "00:09:46", "text": "彼として扱われていると書いてあるし、"}, {"type": "subtitle", "time": 592.87, "timestamp": "00:09:52", "text": "他の Vicki や"}, {"type": "subtitle", "time": 595.59, "timestamp": "00:09:55", "text": "Vicki キーでも同じように書かれています。"}]
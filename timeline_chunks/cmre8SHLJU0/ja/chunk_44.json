[{"type": "subtitle", "time": 2661.285, "timestamp": "00:44:21", "text": "ああ、勝った。"}, {"type": "subtitle", "time": 2662.23, "timestamp": "00:44:22", "text": "[ため息]"}, {"type": "subtitle", "time": 2665.19, "timestamp": "00:44:25", "text": "私はたくさんの人を殺した。"}, {"type": "subtitle", "time": 2668.63, "timestamp": "00:44:28", "text": "私はたくさんの幽霊を殺しました。"}, {"type": "subtitle", "time": 2671.19, "timestamp": "00:44:31", "text": "行動力のある選手のように。 ああ、私だよ。"}, {"type": "subtitle", "time": 2675.349, "timestamp": "00:44:35", "text": "それは私です。 何てことだ。 何てことだ。 何てことだ"}, {"type": "subtitle", "time": 2679.75, "timestamp": "00:44:39", "text": "。 さあ行こう。 その日の配信で最初のMVP"}, {"type": "subtitle", "time": 2695.349, "timestamp": "00:44:55", "text": "誰かそれを切り取って。   ああ"}, {"type": "subtitle", "time": 2697.829, "timestamp": "00:44:57", "text": "、この武器を"}]
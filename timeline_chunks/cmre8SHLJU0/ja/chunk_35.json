[{"type": "subtitle", "time": 2103.589, "timestamp": "00:35:03", "text": "私のサーフィン。 俺はパルクールゲームが大好きなんだ。"}, {"type": "subtitle", "time": 2106.069, "timestamp": "00:35:06", "text": "とても素敵です。"}, {"type": "subtitle", "time": 2108.23, "timestamp": "00:35:08", "text": "動きでできることはたくさんあるのに、"}, {"type": "subtitle", "time": 2110.79, "timestamp": "00:35:10", "text": "今のコール オブ"}, {"type": "subtitle", "time": 2114.95, "timestamp": "00:35:14", "text": "デューティでは動きが多すぎる。 テクナ、"}, {"type": "subtitle", "time": 2119.109, "timestamp": "00:35:19", "text": "それもまた悲しいし、辛いことだよ。"}, {"type": "subtitle", "time": 2125.109, "timestamp": "00:35:25", "text": "よし、拳銃のみで行くことにしよう。   わかった"}, {"type": "subtitle", "time": 2132.47, "timestamp": "00:35:32", "text": "そして、フィニッシャーもある。 あなたならできます。   だから"}, {"type": "subtitle", "time": 2136.39, "timestamp": "00:35:36", "text": "私は拳銃が好きなんです。"}]
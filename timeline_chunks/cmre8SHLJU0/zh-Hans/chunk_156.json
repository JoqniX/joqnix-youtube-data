[{"type": "subtitle", "time": 9364.79, "timestamp": "02:36:04", "text": "在周五和周日免费玩三天"}, {"type": "subtitle", "time": 9366.309, "timestamp": "02:36:06", "text": "。"}, {"type": "subtitle", "time": 9367.91, "timestamp": "02:36:07", "text": "嗯，"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "这是太平洋标准时间。所以"}, {"type": "subtitle", "time": 9372.63, "timestamp": "02:36:12", "text": "对我来说，就是周六、"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "周日和周一。所以"}, {"type": "subtitle", "time": 9379.59, "timestamp": "02:36:19", "text": "，"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "我想大概到周一早上6点左右。"}, {"type": "subtitle", "time": 9385.91, "timestamp": "02:36:25", "text": "是的。但是，"}, {"type": "subtitle", "time": 9393.429, "timestamp": "02:36:33", "text": "还有，我忘了说，周日我"}, {"type": "subtitle", "time": 9396.71, "timestamp": "02:36:36", "text": "可能不会直播，因为我"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "要去新宿。我可能会在新宿做偶像"}, {"type": "subtitle", "time": 9411.03, "timestamp": "02:36:51", "text": "感谢所有到场的人"}]
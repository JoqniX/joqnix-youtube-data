[{"type": "subtitle", "time": 842.31, "timestamp": "00:14:02", "text": "很少有 YouTuber 会这样做，对吧？"}, {"type": "subtitle", "time": 845.75, "timestamp": "00:14:05", "text": "他们大多数都会露脸什么的，但"}, {"type": "subtitle", "time": 847.59, "timestamp": "00:14:07", "text": "我不会那样做，我只展示后置"}, {"type": "subtitle", "time": 849.59, "timestamp": "00:14:09", "text": "摄像头之类的，"}, {"type": "subtitle", "time": 851.829, "timestamp": "00:14:11", "text": "实际上就是把我的所有位置都暴露出来"}, {"type": "subtitle", "time": 853.59, "timestamp": "00:14:13", "text": "。"}, {"type": "subtitle", "time": 856.79, "timestamp": "00:14:16", "text": "而我现在一旦开口说话，就会滔滔不绝，说个不停，"}, {"type": "subtitle", "time": 859.11, "timestamp": "00:14:19", "text": "以至于给"}, {"type": "subtitle", "time": 863.67, "timestamp": "00:14:23", "text": "自己惹了麻烦，因为"}, {"type": "subtitle", "time": 866.564, "timestamp": "00:14:26", "text": "我话太多了。"}, {"type": "chat", "time": 871.882, "timestamp": "00:14:31", "author": "@GoojiiBot", "avatar": "https://yt4.ggpht.com/mPYgxFLpVlEw3IlqLJvO23Nw3qURJpHaR1vq7WFEWKVvRh1eRhQtoaGuPnjptIVN3y8KNCWkr-4=s64-c-k-c0x00ffffff-no-rj", "message": "They treat face reveals with the same level of horror as a luchador getting forcibly unmasked"}, {"type": "subtitle", "time": 875.03, "timestamp": "00:14:35", "text": "是啊，我觉得我好像没在遵循某种"}, {"type": "subtitle", "time": 878.87, "timestamp": "00:14:38", "text": "角色设定。"}, {"type": "subtitle", "time": 881.189, "timestamp": "00:14:41", "text": "只是把它弄坏了。 我得提醒"}, {"type": "subtitle", "time": 890.389, "timestamp": "00:14:50", "text": "呃呃，它刚才说了什么来着？ 是的，还有"}, {"type": "subtitle", "time": 896.31, "timestamp": "00:14:56", "text": "。 所以，还有这方面的原因。"}]
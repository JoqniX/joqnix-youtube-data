[{"type": "subtitle", "time": 1980.389, "timestamp": "00:33:00", "text": "此时此刻，"}, {"type": "subtitle", "time": 1988.71, "timestamp": "00:33:08", "text": "好，我们来玩潜行游戏吧。 我"}, {"type": "subtitle", "time": 1991.19, "timestamp": "00:33:11", "text": "从上学前就开始做了"}, {"type": "subtitle", "time": 1993.509, "timestamp": "00:33:13", "text": "。 不，我没"}, {"type": "subtitle", "time": 1997.35, "timestamp": "00:33:17", "text": "去，我今天兼职迟到了"}, {"type": "subtitle", "time": 2000.31, "timestamp": "00:33:20", "text": "。 所以，我最后玩了《"}, {"type": "subtitle", "time": 2002.389, "timestamp": "00:33:22", "text": "使命召唤》。"}, {"type": "subtitle", "time": 2005.43, "timestamp": "00:33:25", "text": "我当时在玩手枪镜头，感觉就像是在"}, {"type": "subtitle", "time": 2015.99, "timestamp": "00:33:35", "text": "我想起了"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "哦，六级才能达到"}, {"type": "subtitle", "time": 2027.75, "timestamp": "00:33:47", "text": "七级。"}, {"type": "subtitle", "time": 2030.95, "timestamp": "00:33:50", "text": "哦，我甚至都没解锁。"}]
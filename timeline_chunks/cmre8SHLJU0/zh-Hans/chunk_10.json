[{"type": "subtitle", "time": 602.07, "timestamp": "00:10:02", "text": "但说实话，如果你问"}, {"type": "subtitle", "time": 603.91, "timestamp": "00:10:03", "text": "我，"}, {"type": "subtitle", "time": 611.59, "timestamp": "00:10:11", "text": "比如，我看的直播主"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "是男的还是女的什么的。 我觉得，"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "呃，说到虚拟直播，呃，我们就是"}, {"type": "subtitle", "time": 621.03, "timestamp": "00:10:21", "text": "享受做自己，"}, {"type": "subtitle", "time": 623.59, "timestamp": "00:10:23", "text": "扮演节目中的角色。"}, {"type": "subtitle", "time": 626.79, "timestamp": "00:10:26", "text": "我的天哪，他真的这么做了，他只是……"}, {"type": "subtitle", "time": 632.389, "timestamp": "00:10:32", "text": "嗯，还有一件事，"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "我该怎么说呢？ 更像是"}, {"type": "subtitle", "time": 643.75, "timestamp": "00:10:43", "text": "有人把我误认为是"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "其他性别，然后我就想，"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "啊，谁来告诉他呢？ 我不想"}, {"type": "subtitle", "time": 652.47, "timestamp": "00:10:52", "text": "破坏他的沉浸感，"}, {"type": "subtitle", "time": 655.99, "timestamp": "00:10:55", "text": "因为他毕竟是个运动健将，对吧？运动健将也是一个"}, {"type": "subtitle", "time": 658.63, "timestamp": "00:10:58", "text": "角色，所以……"}]
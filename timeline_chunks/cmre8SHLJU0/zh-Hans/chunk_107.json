[{"type": "subtitle", "time": 6437.189, "timestamp": "01:47:17", "text": "生。 好吧，"}, {"type": "subtitle", "time": 6438.95, "timestamp": "01:47:18", "text": "连续录音15个小时没有"}, {"type": "subtitle", "time": 6441.59, "timestamp": "01:47:21", "text": "休息之后，我的嗓子终于哑了。 啊，"}, {"type": "subtitle", "time": 6444.229, "timestamp": "01:47:24", "text": "我懂那种感觉。 我也尝试过"}, {"type": "subtitle", "time": 6447.35, "timestamp": "01:47:27", "text": "这样做。 很粗糙。 你应该知道"}, {"type": "subtitle", "time": 6449.99, "timestamp": "01:47:29", "text": "自己不应该那样做吗？   绝对"}, {"type": "subtitle", "time": 6452.31, "timestamp": "01:47:32", "text": "不应该那样做，因为，不，我不"}, {"type": "subtitle", "time": 6454.47, "timestamp": "01:47:34", "text": "知道如何控制我的声音"}, {"type": "subtitle", "time": 6459.03, "timestamp": "01:47:39", "text": "等等。 嗯，"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "因为我当时在练习唱歌什么的"}, {"type": "subtitle", "time": 6464.47, "timestamp": "01:47:44", "text": "。 我以前经常连续12个小时"}, {"type": "subtitle", "time": 6466.31, "timestamp": "01:47:46", "text": "唱歌，不停地"}, {"type": "subtitle", "time": 6470.07, "timestamp": "01:47:50", "text": "唱，"}, {"type": "subtitle", "time": 6473.109, "timestamp": "01:47:53", "text": "不知道什么时候该停下来，甚至不知道什么时候该"}]